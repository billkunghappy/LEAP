  intro L _ Y b w w₁ hspec hR
  have key : ∀ (U : Y.Opens) (f : Γ(Y, U)), w₁ ∈ U → w ∈ Y.basicOpen f → w₁ ∈ Y.basicOpen f := by
    intro U f hw₁ hwf
    have hwU : w ∈ U := hspec.mem_open U.isOpen hw₁
    let ψ : L →+* Γ(Y, ⊤) := ((Scheme.ΓSpecIso (.of L)).inv ≫ b.appTop).hom
    let ρ : Γ(Y, ⊤) →+* Γ(Y, U) := (Y.presheaf.map (homOfLE le_top : U ⟶ ⊤).op).hom
    have hgerm : ∀ (x : Y) (hx : x ∈ U) (c : L), (Y.presheaf.germ U x hx).hom (ρ (ψ c)) =
        ((Scheme.ΓSpecIso (.of L)).inv ≫ b.appTop ≫ Y.presheaf.germ ⊤ x trivial).hom c := by
      intro x hx c
      rw [CommRingCat.comp_apply, CommRingCat.comp_apply]
      exact Y.presheaf.germ_res_apply _ _ _ _
    obtain ⟨c, hc⟩ := hR ((Y.presheaf.germ U w hwU).hom f)
    rw [Scheme.mem_basicOpen _ _ _ hwU] at hwf
    rw [Scheme.mem_basicOpen _ _ _ hw₁]
    set g : Γ(Y, U) := f - ρ (ψ c) with hg
    have hgw : (Y.presheaf.germ U w hwU).hom g ∈ IsLocalRing.maximalIdeal (Y.presheaf.stalk w) := by
      rw [hg, map_sub, hgerm]; exact hc
    have hwg : w ∉ Y.basicOpen g := by
      rw [Scheme.mem_basicOpen _ _ _ hwU]
      exact (IsLocalRing.mem_maximalIdeal _).mp hgw
    have hw₁g : w₁ ∉ Y.basicOpen g := fun h => hwg (hspec.mem_open (Y.basicOpen g).isOpen h)
    rw [Scheme.mem_basicOpen _ _ _ hw₁] at hw₁g
    have hgw₁ : (Y.presheaf.germ U w₁ hw₁).hom g ∈ IsLocalRing.maximalIdeal (Y.presheaf.stalk w₁) :=
      (IsLocalRing.mem_maximalIdeal _).mpr hw₁g
    have hc0 : c ≠ 0 := by
      rintro rfl
      rw [map_zero, sub_zero] at hc
      exact (IsLocalRing.mem_maximalIdeal _).mp hc hwf
    have hcu : IsUnit (((Scheme.ΓSpecIso (.of L)).inv ≫ b.appTop ≫ Y.presheaf.germ ⊤ w₁ trivial).hom c) :=
      (Ne.isUnit hc0).map _
    by_contra hnu
    have hf : (Y.presheaf.germ U w₁ hw₁).hom f ∈ IsLocalRing.maximalIdeal (Y.presheaf.stalk w₁) :=
      (IsLocalRing.mem_maximalIdeal _).mpr hnu
    have hsub := Ideal.sub_mem _ hf hgw₁
    rw [hg, map_sub, sub_sub_cancel, hgerm] at hsub
    exact (IsLocalRing.mem_maximalIdeal _).mp hsub hcu
  have hrev : w₁ ⤳ w := by
    rw [specializes_iff_forall_open]
    intro s hs hws
    obtain ⟨U, hU, hw₁U, -⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp
      (Scheme.isBasis_affineOpens Y)) (show w₁ ∈ (⊤ : Y.Opens) from trivial)
    have hwU : w ∈ U := hspec.mem_open U.isOpen hw₁U
    let V : Y.Opens := ⟨s, hs⟩
    obtain ⟨f, hfle, hwf⟩ := IsAffineOpen.exists_basicOpen_le (X := Y) hU (V := V ⊓ U)
      ⟨w, ⟨hws, hwU⟩⟩ hwU
    exact (hfle (key U f hw₁U hwf)).1
  exact (hspec.antisymm hrev).eq

theorem wcpa_dj_lus_cvs_ct_closed_fibre_dim : ∀ (K : Type u) [Field K] (R : ValuationSubring K), IsAlgClosed (IsLocalRing.ResidueField ↥R) → ∀ (Y : Scheme.{u}) (v : Y ⟶ Spec (.of ↥R)), wcpaDjSemistable v → TopologicalSpace.NoetherianSpace ↥(Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R))))) ∧ topologicalKrullDim ↥(Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R))))) ≤ ((1 : ℕ) : WithBot ℕ∞) :=
by
  intro K _ R hκ Y v hss
  classical
  haveI := hκ
  obtain ⟨_hflat, hprop, hfib⟩ := hss
  haveI := hprop
  haveI : IsProper (Limits.pullback.snd v (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R))))) := inferInstance
  haveI : LocallyOfFiniteType (Limits.pullback.snd v (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R))))) := inferInstance
  haveI : QuasiCompact (Limits.pullback.snd v (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R))))) := inferInstance

  have hnoeth : TopologicalSpace.NoetherianSpace ↥(Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R))))) := by
    haveI : IsLocallyNoetherian (Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R))))) :=
      LocallyOfFiniteType.isLocallyNoetherian (Limits.pullback.snd v (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R)))))
    haveI : CompactSpace ↥(Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R))))) :=
      QuasiCompact.compactSpace_of_compactSpace (Limits.pullback.snd v (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R)))))
    haveI : AlgebraicGeometry.IsNoetherian (Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R))))) := {}
    exact IsNoetherian.noetherianSpace

  haveI : JacobsonSpace ↥(Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R))))) :=
    LocallyOfFiniteType.jacobsonSpace (Limits.pullback.snd v (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R)))))

  have hloc : ∀ x : ↥(Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R))))),
      ¬ IsClosed ({x} : Set ↥(Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R)))))) →
      ∃ W : Set ↥(Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R))))),
        IsOpen W ∧ x ∈ W ∧ topologicalKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) := by
    intro x hx
    rcases hfib (IsLocalRing.ResidueField ↥R) (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R)))) x with ⟨W, hW, hWsm⟩ | ⟨e, he⟩
    · haveI := hWsm
      refine ⟨(W : Set _), W.isOpen, hW, ?_⟩
      have h1 := wc_smooth_alg_closed_dim_le (IsLocalRing.ResidueField ↥R) W.toScheme
        (W.ι ≫ Limits.pullback.snd v (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R))))) 1
      exact h1
    · exfalso
      have hres := wcpa_dj_nf_node_residue (IsLocalRing.ResidueField ↥R)
        ((Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R))))).presheaf.stalk x)
        ((Scheme.ΓSpecIso (.of (IsLocalRing.ResidueField ↥R))).inv ≫
          (Limits.pullback.snd v (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R))))).appTop ≫
          (Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R))))).presheaf.germ ⊤ x trivial).hom ⟨e, he⟩
      have hspec : ∀ y, x ⤳ y → x = y := fun y hxy =>
        wcpa_dj_sfi_rational_generization (IsLocalRing.ResidueField ↥R) _
          (Limits.pullback.snd v (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R))))) x y hxy hres
      apply hx
      rw [← closure_subset_iff_isClosed]
      intro y hy
      exact (hspec y (specializes_iff_mem_closure.mpr hy)).symm
  refine ⟨hnoeth, ?_⟩

  have topo : ∀ (X : Type u) [TopologicalSpace X] [QuasiSober X] [T0Space X] [JacobsonSpace X],
      (∀ x : X, ¬ IsClosed ({x} : Set X) → ∃ W : Set X, IsOpen W ∧ x ∈ W ∧
        topologicalKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞)) →
      topologicalKrullDim X ≤ ((1 : ℕ) : WithBot ℕ∞) := by
    intro X _ _ _ _ hloc
    have chain : ∀ (T : Type u) [TopologicalSpace T] [T0Space T],
        topologicalKrullDim T ≤ ((1 : ℕ) : WithBot ℕ∞) →
        ∀ a z b : T, b ⤳ z → z ⤳ a → a ≠ z → b ≠ z → False := by
      intro T _ _ hT a z b hbz hza haz hbz'
      have hT' : Order.krullDim (TopologicalSpace.IrreducibleCloseds T) ≤ 1 := by
        have : topologicalKrullDim T = Order.krullDim (TopologicalSpace.IrreducibleCloseds T) := rfl
        rw [← this]; simpa using hT
      have hmm := Order.krullDim_le_one_iff.mp hT'
      let mk : T → TopologicalSpace.IrreducibleCloseds T := fun p =>
        ⟨closure {p}, isIrreducible_singleton.closure, isClosed_closure⟩
      rcases hmm (mk z) with hmin | hmax
      · have hle : mk a ≤ mk z := by
          show closure {a} ⊆ closure {z}
          exact specializes_iff_closure_subset.mp hza
        have hle' : mk z ≤ mk a := hmin hle
        have haz2 : a ⤳ z := specializes_iff_closure_subset.mpr hle'
        exact haz (haz2.antisymm hza).eq
      · have hle : mk z ≤ mk b := by
          show closure {z} ⊆ closure {b}
          exact specializes_iff_closure_subset.mp hbz
        have hle' : mk b ≤ mk z := hmax hle
        have hzb : z ⤳ b := specializes_iff_closure_subset.mpr hle'
        exact hbz' (hbz.antisymm hzb).eq
    have hX : topologicalKrullDim X = Order.krullDim (TopologicalSpace.IrreducibleCloseds X) := rfl
    rw [hX, Nat.cast_one]
    apply Order.krullDim_le_one_iff.mpr
    intro Z
    by_contra hZ
    push_neg at hZ
    obtain ⟨hnmin, hnmax⟩ := hZ
    obtain ⟨A, hAZ⟩ := not_isMin_iff.mp hnmin
    obtain ⟨B, hZB⟩ := not_isMax_iff.mp hnmax
    have gen : ∀ S : TopologicalSpace.IrreducibleCloseds X,
        closure {S.isIrreducible.genericPoint} = (S : Set X) := by
      intro S
      have h1 := S.isIrreducible.isGenericPoint_genericPoint_closure
      rw [S.isClosed.closure_eq] at h1
      exact h1
    set ζ := Z.isIrreducible.genericPoint with hζ
    set β := B.isIrreducible.genericPoint with hβ
    have hZζ : closure {ζ} = (Z : Set X) := gen Z
    have hBβ : closure {β} = (B : Set X) := gen B
    have hAZs : (A : Set X) ⊆ Z := hAZ.le
    have hZBs : (Z : Set X) ⊆ B := hZB.le
    have hζncl : ¬ IsClosed ({ζ} : Set X) := by
      intro hcl
      have hZs : (Z : Set X) = {ζ} := by rw [← hZζ, hcl.closure_eq]
      obtain ⟨a, ha⟩ := A.isIrreducible.nonempty
      have hAs : (A : Set X) = Z := by
        apply Set.Subset.antisymm hAZs
        rw [hZs]
        intro y hy
        rw [Set.mem_singleton_iff.mp hy]
        have := hAZs ha
        rw [hZs, Set.mem_singleton_iff] at this
        rw [← this]; exact ha
      exact hAZ.ne (TopologicalSpace.IrreducibleCloseds.ext hAs)
    obtain ⟨W, hWo, hζW, hWdim⟩ := hloc ζ hζncl
    have hζmem : ζ ∈ (Z : Set X) := by rw [← hZζ]; exact subset_closure rfl
    have hβζ : β ⤳ ζ := by
      rw [specializes_iff_mem_closure, hBβ]; exact hZBs hζmem
    have hβW : β ∈ W := hβζ.mem_open hWo hζW
    have hβne : β ≠ ζ := by
      intro h
      have hBs : (B : Set X) = Z := by rw [← hBβ, ← hZζ, h]
      exact hZB.ne (TopologicalSpace.IrreducibleCloseds.ext hBs).symm
    have hζ' : ∃ ζ' ∈ W, ζ ⤳ ζ' ∧ ζ' ≠ ζ := by
      by_contra hno
      push_neg at hno
      have heq : W ∩ closure {ζ} = {ζ} := by
        ext y
        constructor
        · rintro ⟨hyW, hycl⟩
          exact Set.mem_singleton_iff.mpr (hno y hyW (specializes_iff_mem_closure.mpr hycl))
        · intro hy
          rw [Set.mem_singleton_iff.mp hy]
          exact ⟨hζW, subset_closure rfl⟩
      have hlc : IsLocallyClosed ({ζ} : Set X) := by
        rw [← heq]
        exact hWo.isLocallyClosed.inter isClosed_closure.isLocallyClosed
      exact hζncl (isClosed_singleton_of_isLocallyClosed_singleton hlc)
    obtain ⟨ζ', hζ'W, hζζ', hζ'ne⟩ := hζ'
    have hind : Topology.IsInducing (Subtype.val : W → X) := Topology.IsInducing.subtypeVal
    apply chain W hWdim ⟨ζ', hζ'W⟩ ⟨ζ, hζW⟩ ⟨β, hβW⟩
    · exact hind.specializes_iff.mp hβζ
    · exact hind.specializes_iff.mp hζζ'
    · intro h; exact hζ'ne (congrArg Subtype.val h)
    · intro h; exact hβne (congrArg Subtype.val h)
  exact topo _ hloc

theorem wcpa_dj_lr1k_imf_fib_reduced : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), W ≠ ⊤ → ∀ (C X : Scheme.{u}) (f : C ⟶ X) [QuasiCompact f] [QuasiSeparated f] (uX : X ⟶ Spec (.of ↥W)) (c : C ⟶ Spec (.of Ω)), f ≫ uX = c ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω)) → AlgebraicGeometry.IsReduced (Limits.pullback (f.fromNormalization ≫ uX) (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) :=
by
  intro Ω _ _ W hWt C X f _ _ uX c hc
  classical

  have s1 : ∀ (A R : Type u) [CommRing A] [CommRing R] [Algebra A R] [Algebra Ω R]
      (ψ : ↥W →+* ↥(integralClosure A R)),
      (∀ w : ↥W, ((ψ w : ↥(integralClosure A R)) : R) = algebraMap Ω R (algebraMap ↥W Ω w)) →
      _root_.IsReduced (↥(integralClosure A R) ⧸ Ideal.map ψ (IsLocalRing.maximalIdeal ↥W)) := by
    intro A R _ _ _ _ ψ hψ

    obtain ⟨a₀, ha₀m, ha₀ne⟩ : ∃ a₀ : ↥W, a₀ ∈ IsLocalRing.maximalIdeal ↥W ∧ a₀ ≠ 0 := by
      obtain ⟨x, hx⟩ : ∃ x : Ω, x ∉ W := by
        by_contra h
        push_neg at h
        exact hWt (eq_top_iff.mpr fun x _ => h x)
      have hx0 : x ≠ 0 := fun h => hx (h ▸ W.zero_mem)
      have hxi : x⁻¹ ∈ W := (W.mem_or_inv_mem x).resolve_left hx
      refine ⟨⟨x⁻¹, hxi⟩, ?_, ?_⟩
      · rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
        rintro ⟨u, hu⟩
        apply hx
        have h1 : ((u⁻¹ : (↥W)ˣ) : ↥W) * ⟨x⁻¹, hxi⟩ = 1 := by rw [← hu]; exact u.inv_mul
        have h3 := (mul_inv_eq_one₀ hx0).mp (congrArg Subtype.val h1)
        rw [← h3]
        exact ((u⁻¹ : (↥W)ˣ) : ↥W).2
      · intro h
        have := congrArg Subtype.val h
        simp only [ZeroMemClass.coe_zero] at this
        exact inv_ne_zero hx0 this

    have hgen : ∀ z ∈ Ideal.map ψ (IsLocalRing.maximalIdeal ↥W),
        ∃ a ∈ IsLocalRing.maximalIdeal ↥W, ∃ b' : ↥(integralClosure A R), z = ψ a * b' := by
      intro z hz
      rw [Ideal.map] at hz
      induction hz using Submodule.span_induction with
      | mem x hx =>
        obtain ⟨a, ha, rfl⟩ := hx
        exact ⟨a, ha, 1, (mul_one _).symm⟩
      | zero => exact ⟨0, Ideal.zero_mem _, 0, (mul_zero _).symm⟩
      | add x y _ _ hx hy =>
        obtain ⟨a₁, ha₁, b₁, rfl⟩ := hx
        obtain ⟨a₂, ha₂, b₂, rfl⟩ := hy
        rcases ValuationRing.dvd_total a₁ a₂ with ⟨t, ht⟩ | ⟨t, ht⟩
        · refine ⟨a₁, ha₁, b₁ + ψ t * b₂, ?_⟩
          rw [ht, map_mul]; ring
        · refine ⟨a₂, ha₂, ψ t * b₁ + b₂, ?_⟩
          rw [ht, map_mul]; ring
      | smul r x _ hx =>
        obtain ⟨a, ha, b', rfl⟩ := hx
        exact ⟨a, ha, r * b', by rw [smul_eq_mul]; ring⟩

    have hkey : ∀ (b : ↥(integralClosure A R)) (n : ℕ), 0 < n →
        b ^ n ∈ Ideal.map ψ (IsLocalRing.maximalIdeal ↥W) →
        b ∈ Ideal.map ψ (IsLocalRing.maximalIdeal ↥W) := by
      intro b n hn hb
      obtain ⟨a, ham, ha0, b', hb'⟩ : ∃ a ∈ IsLocalRing.maximalIdeal ↥W, a ≠ 0 ∧
          ∃ b' : ↥(integralClosure A R), b ^ n = ψ a * b' := by
        obtain ⟨a, ham, b', hb'⟩ := hgen _ hb
        by_cases ha : a = 0
        · refine ⟨a₀, ha₀m, ha₀ne, 0, ?_⟩
          rw [hb', ha, map_zero, zero_mul, mul_zero]
        · exact ⟨a, ham, ha, b', hb'⟩
      have haΩ : (a : Ω) ≠ 0 := fun h => ha0 (Subtype.ext h)
      obtain ⟨α, hα⟩ := IsAlgClosed.exists_pow_nat_eq (a : Ω) hn
      have hα0 : α ≠ 0 := by
        rintro rfl
        exact haΩ (by rw [← hα, zero_pow hn.ne'])
      have hαW : α ∈ W := by
        by_contra hαW
        have hαi : α⁻¹ ∈ W := (W.mem_or_inv_mem α).resolve_left hαW
        have hai : (a : Ω)⁻¹ ∈ W := by
          rw [← hα, ← inv_pow]
          exact W.pow_mem hαi n
        have hu : IsUnit a := by
          refine isUnit_iff_exists_inv.mpr ⟨⟨(a : Ω)⁻¹, hai⟩, ?_⟩
          exact Subtype.ext (by simp [haΩ])
        exact ((IsLocalRing.mem_maximalIdeal _).mp ham) hu
      set α' : ↥W := ⟨α, hαW⟩ with hα'
      have hα'n : α' ^ n = a := Subtype.ext (by simp [α', hα])
      have hα'm : α' ∈ IsLocalRing.maximalIdeal ↥W :=
        (IsLocalRing.maximalIdeal.isMaximal ↥W).isPrime.mem_of_pow_mem n (hα'n ▸ ham)
      set y : R := algebraMap Ω R α⁻¹ * (b : R) with hy
      have hbn : ((b : R)) ^ n = algebraMap Ω R (a : Ω) * (b' : R) := by
        have h := congrArg Subtype.val hb'
        simp only [SubmonoidClass.coe_pow, MulMemClass.coe_mul] at h
        rw [h, hψ]
        rfl
      have hyn : y ^ n = (b' : R) := by
        rw [hy, mul_pow, hbn, ← mul_assoc, ← map_pow, ← map_mul, inv_pow, hα,
          inv_mul_cancel₀ haΩ, map_one, one_mul]
      have hyint : IsIntegral A y := by
        refine IsIntegral.of_pow hn ?_
        rw [hyn]
        exact b'.2
      have hbeq : b = ψ α' * ⟨y, hyint⟩ := by
        apply Subtype.ext
        simp only [MulMemClass.coe_mul]
        rw [hψ, hy, ← mul_assoc, ← map_mul]
        show (b : R) = algebraMap Ω R (α * α⁻¹) * (b : R)
        rw [mul_inv_cancel₀ hα0, map_one, one_mul]
      rw [hbeq]
      exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem ψ hα'm)

    refine ⟨fun x hx => ?_⟩
    obtain ⟨n, hn⟩ := hx
    obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective x
    rcases Nat.eq_zero_or_pos n with rfl | hnpos
    · rw [pow_zero] at hn
      have := subsingleton_of_zero_eq_one hn.symm
      exact Subsingleton.elim _ _
    · rw [← map_pow, Ideal.Quotient.eq_zero_iff_mem] at hn
      exact Ideal.Quotient.eq_zero_iff_mem.mpr (hkey b n hnpos hn)

  have s2 : ∀ (B : Type u) [CommRing B] (ψ : ↥W →+* B),
      _root_.IsReduced (B ⧸ Ideal.map ψ (IsLocalRing.maximalIdeal ↥W)) →
      AlgebraicGeometry.IsReduced (Limits.pullback (Spec.map (CommRingCat.ofHom ψ))
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) := by
    intro B _ ψ h
    letI := ψ.toAlgebra
    let e := Algebra.TensorProduct.quotIdealMapEquivTensorQuot B (IsLocalRing.maximalIdeal ↥W)
    haveI : _root_.IsReduced (TensorProduct ↥W B (IsLocalRing.ResidueField ↥W)) :=
      isReduced_of_injective e.symm.toRingHom e.symm.injective
    exact @isReduced_of_isOpenImmersion _ _
      (pullbackSpecIso ↥W B (IsLocalRing.ResidueField ↥W)).hom _ _

  have s3 : ∀ U : X.Opens,
      (Scheme.ΓSpecIso (.of ↥W)).inv ≫ uX.appTop ≫ X.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op ≫
        f.app U =
      CommRingCat.ofHom (algebraMap ↥W Ω) ≫ (Scheme.ΓSpecIso (.of Ω)).inv ≫ c.appTop ≫
        C.presheaf.map (homOfLE (le_top : f ⁻¹ᵁ U ≤ ⊤)).op := by
    intro U
    have h1 := congrArg Scheme.Hom.appTop hc
    rw [Scheme.Hom.comp_appTop, Scheme.Hom.comp_appTop] at h1
    rw [f.naturality]
    have h2 : CommRingCat.ofHom (algebraMap ↥W Ω) ≫ (Scheme.ΓSpecIso (.of Ω)).inv =
        (Scheme.ΓSpecIso (.of ↥W)).inv ≫
          (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))).appTop := by
      rw [Iso.eq_inv_comp, ← Category.assoc, Iso.comp_inv_eq]
      exact (Scheme.ΓSpecIso_naturality _).symm
    rw [← Category.assoc (CommRingCat.ofHom _), h2, Category.assoc, ← Category.assoc _ c.appTop,
      ← h1]
    rfl

  have s4 : ∀ U : X.affineOpens,
      (Scheme.Hom.normalizationOpenCover f).f U ≫ Scheme.Hom.fromNormalization f ≫ uX =
      Spec.map ((Scheme.ΓSpecIso (.of ↥W)).inv ≫ uX.appTop ≫
        X.presheaf.map (homOfLE (le_top : (U : X.Opens) ≤ ⊤)).op ≫
        (Scheme.Hom.normalizationDiagramMap f).app (Opposite.op (U : X.Opens))) := by
    intro U
    refine (Scheme.Hom.ι_fromNormalization_assoc f U uX).trans ?_
    refine (Category.assoc _ _ _).trans ?_
    have h1 := IsAffineOpen.SpecMap_appLE_fromSpec uX (isAffineOpen_top (Spec (.of ↥W))) U.2
      (fun _ _ => trivial)
    rw [IsAffineOpen.fromSpec_top, Scheme.isoSpec_Spec_inv, ← Spec.map_comp] at h1
    refine (congrArg (fun g => Spec.map ((Scheme.Hom.normalizationDiagramMap f).app
      (Opposite.op (U : X.Opens))) ≫ g) h1.symm).trans ?_
    refine (Spec.map_comp _ _).symm.trans ?_
    rfl

  let 𝒱 := Scheme.Pullback.openCoverOfLeft (Scheme.Hom.normalizationOpenCover f)
    (f.fromNormalization ≫ uX)
    (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))
  have hall : ∀ U : X.affineOpens, AlgebraicGeometry.IsReduced (Limits.pullback
      ((Scheme.Hom.normalizationOpenCover f).f U ≫ f.fromNormalization ≫ uX)
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) := by
    intro U
    letI : Algebra Γ(X, (U : X.Opens)) Γ(C, f ⁻¹ᵁ (U : X.Opens)) := (f.app U).hom.toAlgebra
    letI : Algebra Ω Γ(C, f ⁻¹ᵁ (U : X.Opens)) :=
      ((Scheme.ΓSpecIso (.of Ω)).inv ≫ c.appTop ≫
        C.presheaf.map (homOfLE (le_top : f ⁻¹ᵁ (U : X.Opens) ≤ ⊤)).op).hom.toAlgebra
    let ψU : CommRingCat.of ↥W ⟶
        (Scheme.Hom.normalizationDiagram f).obj (Opposite.op (U : X.Opens)) :=
      (Scheme.ΓSpecIso (.of ↥W)).inv ≫ uX.appTop ≫
        X.presheaf.map (homOfLE (le_top : (U : X.Opens) ≤ ⊤)).op ≫
        (Scheme.Hom.normalizationDiagramMap f).app (Opposite.op (U : X.Opens))
    let ψ : ↥W →+* ↥(integralClosure Γ(X, (U : X.Opens)) Γ(C, f ⁻¹ᵁ (U : X.Opens))) := ψU.hom
    have hψ : ∀ w : ↥W,
        ((ψ w : ↥(integralClosure Γ(X, (U : X.Opens)) Γ(C, f ⁻¹ᵁ (U : X.Opens)))) :
          Γ(C, f ⁻¹ᵁ (U : X.Opens))) =
        algebraMap Ω Γ(C, f ⁻¹ᵁ (U : X.Opens)) (algebraMap ↥W Ω w) := by
      intro w
      exact congrArg (fun φ => φ.hom w) (s3 (U : X.Opens))
    have hred := s1 Γ(X, (U : X.Opens)) Γ(C, f ⁻¹ᵁ (U : X.Opens)) ψ hψ
    have hred2 := s2 _ ψ hred
    let e := Limits.pullback.congrHom (s4 U)
      (rfl : Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))) = _)
    exact @isReduced_of_isOpenImmersion _ _ e.hom _ hred2
  haveI : ∀ U : 𝒱.I₀, AlgebraicGeometry.IsReduced (𝒱.X U) := fun U => hall U
  exact AlgebraicGeometry.IsReduced.of_openCover _ 𝒱

theorem wcpa_dj_lr1k_imfcs_frac_prod : ∀ (D : Type u) [CommRing D] [_root_.IsReduced D] [IsNoetherianRing D], Nonempty (FractionRing D ≃ₐ[D] ((P : {P : PrimeSpectrum D // P.asIdeal ∈ minimalPrimes D}) → Localization.AtPrime P.1.asIdeal)) :=
by
  intro D _ _ _
  classical
  have hprime : ∀ Q ∈ minimalPrimes D, Q.IsPrime := fun Q hQ => hQ.1.1

  have s1 : ∀ (P : Ideal D) [P.IsPrime], P ∈ minimalPrimes D → ∀ a ∈ P,
      algebraMap D (Localization.AtPrime P) a = 0 := by
    intro P _ hP a ha
    haveI : Ring.KrullDimLE 0 (Localization.AtPrime P) :=
      Ring.KrullDimLE.of_isLocalization P hP _
    haveI : _root_.IsReduced (Localization.AtPrime P) :=
      isReduced_localizationPreserves P.primeCompl (Localization.AtPrime P) inferInstance
    have h1 : algebraMap D (Localization.AtPrime P) a ∈
        IsLocalRing.maximalIdeal (Localization.AtPrime P) :=
      (IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime P) P a).mpr ha
    rw [← Ring.KrullDimLE.nilradical_eq_maximalIdeal, nilradical_eq_zero] at h1
    rwa [Ideal.zero_eq_bot, Ideal.mem_bot] at h1

  have s2 : ∀ w : D, (∀ P ∈ minimalPrimes D, w ∈ P) → w = 0 := by
    intro w hw
    have hn : w ∈ nilradical D := by
      rw [nilradical_eq_sInf, Ideal.mem_sInf]
      intro J hJ
      haveI : J.IsPrime := hJ
      obtain ⟨p, hp, hpJ⟩ := Ideal.exists_minimalPrimes_le (bot_le : (⊥ : Ideal D) ≤ J)
      exact hpJ (hw p hp)
    exact (mem_nilradical.mp hn).eq_zero

  have s3 : ∀ P ∈ minimalPrimes D, ∃ e : D, e ∉ P ∧ ∀ Q ∈ minimalPrimes D, Q ≠ P → e ∈ Q := by
    intro P hP
    haveI := hprime P hP
    have hex : ∀ Q ∈ minimalPrimes D, Q ≠ P → ∃ f ∈ Q, f ∉ P := by
      intro Q hQ hQP
      by_contra hcon
      push_neg at hcon
      apply hQP
      exact le_antisymm (fun f hf => hcon f hf) (hP.2 ⟨hprime Q hQ, bot_le⟩ (fun f hf => hcon f hf))
    let g : Ideal D → D := fun Q =>
      if h : Q ∈ minimalPrimes D ∧ Q ≠ P then (hex Q h.1 h.2).choose else 1
    let S := (minimalPrimes.finite_of_isNoetherianRing D).toFinset.erase P
    refine ⟨∏ Q ∈ S, g Q, ?_, ?_⟩
    · intro hmem
      obtain ⟨Q, hQS, hgQ⟩ := Ideal.IsPrime.prod_mem_iff.mp hmem
      have hQ' := Finset.mem_erase.mp hQS
      have hQm : Q ∈ minimalPrimes D := (Set.Finite.mem_toFinset _).mp hQ'.2
      have h : Q ∈ minimalPrimes D ∧ Q ≠ P := ⟨hQm, hQ'.1⟩
      simp only [g, dif_pos h] at hgQ
      exact (hex Q h.1 h.2).choose_spec.2 hgQ
    · intro Q hQ hQP
      have h : Q ∈ minimalPrimes D ∧ Q ≠ P := ⟨hQ, hQP⟩
      have hQS : Q ∈ S := Finset.mem_erase.mpr ⟨hQP, (Set.Finite.mem_toFinset _).mpr hQ⟩
      have hgQ : g Q ∈ Q := by
        simp only [g, dif_pos h]
        exact (hex Q h.1 h.2).choose_spec.1
      exact Ideal.mem_of_dvd _ (Finset.dvd_prod_of_mem g hQS) hgQ

  have s4 : ∀ s : D, (∀ J ∈ minimalPrimes D, s ∉ J) → s ∈ nonZeroDivisors D := by
    intro s hs
    rw [mem_nonZeroDivisors_iff_right]
    intro y hy
    apply s2
    intro J hJ
    haveI := hprime J hJ
    have : y * s ∈ J := by rw [hy]; exact J.zero_mem
    exact (Ideal.IsPrime.mem_or_mem inferInstance this).resolve_right (hs J hJ)

  haveI hfin : Finite {P : PrimeSpectrum D // P.asIdeal ∈ minimalPrimes D} := by
    haveI := (minimalPrimes.finite_of_isNoetherianRing D).to_subtype
    refine Finite.of_injective
      (fun P : {P : PrimeSpectrum D // P.asIdeal ∈ minimalPrimes D} =>
        (⟨P.1.asIdeal, P.2⟩ : minimalPrimes D)) ?_
    intro P Q h
    exact Subtype.ext (PrimeSpectrum.ext (congrArg Subtype.val h))
  haveI : Fintype {P : PrimeSpectrum D // P.asIdeal ∈ minimalPrimes D} := Fintype.ofFinite _
  have hinj : ∀ P Q : {P : PrimeSpectrum D // P.asIdeal ∈ minimalPrimes D},
      P.1.asIdeal = Q.1.asIdeal → P = Q :=
    fun P Q h => Subtype.ext (PrimeSpectrum.ext h)
  choose e he1 he2 using
    fun P : {P : PrimeSpectrum D // P.asIdeal ∈ minimalPrimes D} => s3 P.1.asIdeal P.2
  have heP : ∀ P Q : {P : PrimeSpectrum D // P.asIdeal ∈ minimalPrimes D},
      Q ≠ P → e Q ∈ P.1.asIdeal := fun P Q hQP =>
    he2 Q P.1.asIdeal P.2 (fun h => hQP (hinj P Q h).symm)
  haveI hloc : IsLocalization (nonZeroDivisors D)
      ((P : {P : PrimeSpectrum D // P.asIdeal ∈ minimalPrimes D}) →
        Localization.AtPrime P.1.asIdeal) := by
    rw [isLocalization_iff]
    refine ⟨?_, ?_, ?_⟩
    · intro t
      rw [Pi.isUnit_iff]
      intro P
      rw [Pi.algebraMap_apply]
      exact (IsLocalization.AtPrime.isUnit_to_map_iff _ P.1.asIdeal (t : D)).mpr
        (fun h => Set.disjoint_left.mp
          (Ideal.disjoint_nonZeroDivisors_of_mem_minimalPrimes P.2) h t.2)
    · intro z
      choose xt hxt using
        fun P : {P : PrimeSpectrum D // P.asIdeal ∈ minimalPrimes D} =>
          IsLocalization.surj P.1.asIdeal.primeCompl (z P)
      have hcomp : ∀ (P : {P : PrimeSpectrum D // P.asIdeal ∈ minimalPrimes D})
          (b : {P : PrimeSpectrum D // P.asIdeal ∈ minimalPrimes D} → D),
          algebraMap D (Localization.AtPrime P.1.asIdeal) (∑ Q, e Q * b Q) =
            algebraMap D (Localization.AtPrime P.1.asIdeal) (e P) *
              algebraMap D (Localization.AtPrime P.1.asIdeal) (b P) := by
        intro P b
        rw [map_sum, Finset.sum_eq_single P, map_mul]
        · intro Q _ hQP
          rw [map_mul, s1 P.1.asIdeal P.2 (e Q) (heP P Q hQP), zero_mul]
        · intro h; exact absurd (Finset.mem_univ P) h
      set s : D := ∑ Q, e Q * ((xt Q).2 : D) with hs_def
      set x : D := ∑ Q, e Q * (xt Q).1 with hx_def
      have hs : s ∈ nonZeroDivisors D := by
        apply s4
        intro J hJ hsJ
        haveI := hprime J hJ
        let P₀ : {P : PrimeSpectrum D // P.asIdeal ∈ minimalPrimes D} := ⟨⟨J, hprime J hJ⟩, hJ⟩
        have hsplit := Finset.add_sum_erase Finset.univ
          (fun Q => e Q * ((xt Q).2 : D)) (Finset.mem_univ P₀)
        have htail : ∑ Q ∈ Finset.univ.erase P₀, e Q * ((xt Q).2 : D) ∈ J := by
          apply Ideal.sum_mem
          intro Q hQ
          exact Ideal.mul_mem_right _ _ (heP P₀ Q (Finset.ne_of_mem_erase hQ))
        have h1 : e P₀ * ((xt P₀).2 : D) ∈ J := by
          have : e P₀ * ((xt P₀).2 : D) =
              s - ∑ Q ∈ Finset.univ.erase P₀, e Q * ((xt Q).2 : D) := by
            rw [hs_def, ← hsplit]; ring
          rw [this]; exact Ideal.sub_mem _ hsJ htail
        rcases Ideal.IsPrime.mem_or_mem inferInstance h1 with h | h
        · exact he1 P₀ h
        · exact (xt P₀).2.2 h
      refine ⟨(x, ⟨s, hs⟩), ?_⟩
      funext P
      rw [Pi.mul_apply, Pi.algebraMap_apply, Pi.algebraMap_apply]
      have h1 := hcomp P (fun Q => ((xt Q).2 : D))
      have h2 := hcomp P (fun Q => (xt Q).1)
      beta_reduce at h1 h2
      show z P * algebraMap D (Localization.AtPrime P.1.asIdeal) s =
        algebraMap D (Localization.AtPrime P.1.asIdeal) x
      rw [hs_def, hx_def, h1, h2, ← hxt P]
      ring
    · intro x y hxy
      refine ⟨1, ?_⟩
      have hw : x - y = 0 := by
        apply s2
        intro J hJ
        let P₀ : {P : PrimeSpectrum D // P.asIdeal ∈ minimalPrimes D} := ⟨⟨J, hprime J hJ⟩, hJ⟩
        haveI : P₀.1.asIdeal.IsPrime := P₀.1.isPrime
        have h1 : algebraMap D (Localization.AtPrime P₀.1.asIdeal) (x - y) = 0 := by
          have := congrFun hxy P₀
          rw [Pi.algebraMap_apply, Pi.algebraMap_apply] at this
          rw [map_sub, this, sub_self]
        obtain ⟨m, hm⟩ := (IsLocalization.map_eq_zero_iff P₀.1.asIdeal.primeCompl _ (x - y)).mp h1
        have : (m : D) * (x - y) ∈ P₀.1.asIdeal := by rw [hm]; exact Ideal.zero_mem _
        exact (Ideal.IsPrime.mem_or_mem inferInstance this).resolve_left m.2
      rw [sub_eq_zero] at hw
      rw [hw]
  exact ⟨IsLocalization.algEquiv (nonZeroDivisors D) (FractionRing D) _⟩

theorem wcpa_dj_lr1k_imfc_stalk_norm_finite : ∀ (κ : Type u) [Field κ] [PerfectField κ] (D : Type u) [CommRing D] [Algebra κ D] [Algebra.FiniteType κ D] [_root_.IsReduced D] (𝔭 : Ideal D) [𝔭.IsPrime] (R : Type u) [CommRing R] [Algebra D R] [IsLocalization.AtPrime R 𝔭], Module.Finite R ↥(integralClosure R (FractionRing R)) :=
by
  intro κ _ _ D _ _ _ _ 𝔭 _ R _ _ _

  have s4 : ∀ (A : Type u) [CommRing A] [IsDomain A] (M : Submonoid A), M ≤ nonZeroDivisors A →
      ∀ (S : Type u) [CommRing S] [Algebra A S] [IsLocalization M S],
      Module.Finite A ↥(integralClosure A (FractionRing A)) →
      Module.Finite S ↥(integralClosure S (FractionRing S)) := by
    intro A _ _ M hM S _ _ _ hfin
    letI : Algebra S (FractionRing A) :=
      IsLocalization.localizationAlgebraOfSubmonoidLe S (FractionRing A) M (nonZeroDivisors A) hM
    haveI : IsScalarTower A S (FractionRing A) :=
      IsLocalization.localization_isScalarTower_of_submonoid_le S (FractionRing A) M _ hM
    haveI : IsFractionRing S (FractionRing A) :=
      IsFractionRing.isFractionRing_of_isDomain_of_isLocalization M S (FractionRing A)
    have hK : Module.Finite S (integralClosure S (FractionRing A)) := by
      obtain ⟨n, b, hb⟩ := Module.Finite.exists_fin (R := A) (M := integralClosure A (FractionRing A))
      have hbS : ∀ j, IsIntegral S ((b j : FractionRing A)) :=
        fun j => IsIntegral.tower_top (R := A) (A := S) (b j).2
      let b' : Fin n → integralClosure S (FractionRing A) := fun j => ⟨b j, hbS j⟩
      have hspan : Submodule.span S (Set.range b') = ⊤ := by
        rw [eq_top_iff]
        rintro ⟨x, hx⟩ -
        obtain ⟨m, hmx⟩ := IsIntegral.exists_multiple_integral_of_isLocalization M x hx
        have hmem : (⟨(m : A) • x, hmx⟩ : integralClosure A (FractionRing A)) ∈
            Submodule.span A (Set.range b) := by rw [hb]; trivial
        obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun A).mp hmem
        have hm0 : algebraMap A (FractionRing A) (m : A) ≠ 0 :=
          IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors (hM m.2)
        have hcoef : ∀ j, algebraMap A (FractionRing A) (m : A) *
            algebraMap S (FractionRing A) (IsLocalization.mk' S (c j) m) =
            algebraMap A (FractionRing A) (c j) := by
          intro j
          rw [IsScalarTower.algebraMap_apply A S (FractionRing A) (m : A),
            IsScalarTower.algebraMap_apply A S (FractionRing A) (c j), ← map_mul, mul_comm,
            IsLocalization.mk'_spec]
        have key : (⟨x, hx⟩ : integralClosure S (FractionRing A)) =
            ∑ j, (IsLocalization.mk' S (c j) m) • b' j := by
          apply Subtype.ext
          apply mul_left_cancel₀ hm0
          have hc' := congrArg Subtype.val hc
          rw [AddSubmonoidClass.coe_finset_sum] at hc'
          simp only [SetLike.val_smul, Algebra.smul_def] at hc'
          rw [AddSubmonoidClass.coe_finset_sum, Finset.mul_sum]
          change _ = algebraMap A (FractionRing A) (m : A) * x at hc'
          rw [← hc']
          refine Finset.sum_congr rfl fun j _ => ?_
          change algebraMap A (FractionRing A) (c j) * (b j : FractionRing A) =
            algebraMap A (FractionRing A) (m : A) *
              (algebraMap S (FractionRing A) (IsLocalization.mk' S (c j) m) * (b j : FractionRing A))
          rw [← mul_assoc, hcoef]
        rw [key]
        exact Submodule.sum_mem _ fun j _ => Submodule.smul_mem _ _ (Submodule.subset_span ⟨j, rfl⟩)
      classical
      exact ⟨⟨Finset.univ.image b', by rw [Finset.coe_image, Finset.coe_univ, Set.image_univ]; exact hspan⟩⟩
    let e : FractionRing A ≃ₐ[S] FractionRing S :=
      IsLocalization.algEquiv (nonZeroDivisors S) (FractionRing A) (FractionRing S)
    have h := integralClosure_map_algEquiv e
    exact Module.Finite.equiv
      ((e.subalgebraMap (integralClosure S (FractionRing A))).trans
        (Subalgebra.equivOfEq _ _ h)).toLinearEquiv

  have s5 : ∀ (Q : Ideal R), IsLocalization
      (Submonoid.map (Ideal.Quotient.mk (Q.comap (algebraMap D R))) 𝔭.primeCompl) (R ⧸ Q) := by
    intro Q
    refine IsLocalization.of_surjective 𝔭.primeCompl R (Ideal.Quotient.mk _)
      Ideal.Quotient.mk_surjective (Ideal.Quotient.mk Q) Ideal.Quotient.mk_surjective
      (RingHom.ext fun x => rfl) ?_
    rw [Ideal.mk_ker, Ideal.mk_ker]
    exact (IsLocalization.map_comap 𝔭.primeCompl R Q).ge
  haveI : IsNoetherianRing D := Algebra.FiniteType.isNoetherianRing κ D
  haveI : IsNoetherianRing R := IsLocalization.isNoetherianRing 𝔭.primeCompl R inferInstance
  haveI : _root_.IsReduced R := isReduced_localizationPreserves 𝔭.primeCompl R inferInstance
  refine integralClosure_prod_minimal_finite R (FractionRing R)
    (wcpa_dj_lr1k_imfcs_frac_prod R) ?_
  intro Q hQ
  haveI hQp : Q.IsPrime := hQ.1.1
  set Q₀ := Q.comap (algebraMap D R) with hQ₀
  have hQ₀le : Q₀ ≤ 𝔭 := by
    intro x hx
    by_contra hx𝔭
    have hu : IsUnit (algebraMap D R x) :=
      (IsLocalization.AtPrime.isUnit_to_map_iff R 𝔭 x).mpr hx𝔭
    exact hQp.ne_top (Ideal.eq_top_of_isUnit_mem _ hx hu)
  haveI := s5 Q
  have hM : Submonoid.map (Ideal.Quotient.mk Q₀) 𝔭.primeCompl ≤ nonZeroDivisors (D ⧸ Q₀) := by
    apply le_nonZeroDivisors_of_noZeroDivisors
    rintro ⟨s, hs, hs0⟩
    apply hs
    exact hQ₀le ((Ideal.Quotient.eq_zero_iff_mem).mp hs0)
  have hN := noether_integralClosure_finite κ (D ⧸ Q₀)
  exact s4 (D ⧸ Q₀) _ hM (R ⧸ Q) hN

theorem wcpa_dj_lr1k_imfc_generic_normal : ∀ (κ : Type u) [Field κ] [PerfectField κ] (D : Type u) [CommRing D] [Algebra κ D] [Algebra.FiniteType κ D] [_root_.IsReduced D], ringKrullDim D ≤ ((1 : ℕ) : WithBot ℕ∞) → ∃ T : Set (PrimeSpectrum D), T.Finite ∧ ∀ 𝔭 : PrimeSpectrum D, 𝔭 ∉ T → ∀ (R : Type u) [CommRing R] [Algebra D R] [IsLocalization.AtPrime R 𝔭.asIdeal], Module.length R (↥(integralClosure R (FractionRing R)) ⧸ LinearMap.range (Algebra.linearMap R ↥(integralClosure R (FractionRing R)))) = 0 :=
by
  intro κ _ _ D _ _ _ _ hdim
  classical
  haveI : IsNoetherianRing D := Algebra.FiniteType.isNoetherianRing κ D
  have hfinP : ∀ P ∈ minimalPrimes D,
      Module.Finite (D ⧸ P) (integralClosure (D ⧸ P) (FractionRing (D ⧸ P))) := by
    intro P hP
    haveI : P.IsPrime := Ideal.minimalPrimes_isPrime hP
    exact noether_integralClosure_finite κ (D ⧸ P)
  choose f hfP hB using reduced_noetherian_generic_normal D hfinP
  set S : Set D := {x | ∃ P, ∃ hP : P ∈ minimalPrimes D, x = f P hP} with hSdef
  refine ⟨{𝔭 : PrimeSpectrum D | S ⊆ (𝔭.asIdeal : Set D)}, ?_, ?_⟩
  · have hdim' : Order.krullDim (PrimeSpectrum D) ≤ 1 := by
      have : ringKrullDim D ≤ 1 := by simpa using hdim
      exact this
    have hmax : ∀ q : Ideal D, q.IsPrime → S ⊆ (q : Set D) → q.IsMaximal := by
      intro q hq hSq
      rcases Order.krullDim_le_one_iff.mp hdim' ⟨q, hq⟩ with h | h
      · rw [PrimeSpectrum.isMin_iff] at h
        exact absurd (hSq ⟨q, h, rfl⟩) (hfP q h)
      · rwa [PrimeSpectrum.isMax_iff] at h
    refine Set.Finite.subset
      ((Ideal.finite_minimalPrimes_of_isNoetherianRing D (Ideal.span S)).preimage
        (fun x _ y _ hxy => PrimeSpectrum.ext hxy)) ?_
    intro 𝔭 h𝔭
    simp only [Set.mem_setOf_eq] at h𝔭
    show 𝔭.asIdeal ∈ (Ideal.span S).minimalPrimes
    obtain ⟨q, hq, hq𝔭⟩ := Ideal.exists_minimalPrimes_le (Ideal.span_le.mpr h𝔭)
    have hqp : q.IsPrime ∧ Ideal.span S ≤ q := hq.1
    have hqm : q.IsMaximal := hmax q hqp.1 (fun x hx => hqp.2 (Ideal.subset_span hx))
    have : q = 𝔭.asIdeal := hqm.eq_of_le 𝔭.isPrime.ne_top hq𝔭
    rw [← this]
    exact hq
  · intro 𝔭 h𝔭 R _ _ _
    simp only [Set.mem_setOf_eq, Set.not_subset] at h𝔭
    obtain ⟨x, ⟨P, hP, rfl⟩, hx⟩ := h𝔭
    obtain ⟨hdom, hic⟩ := hB P hP (Localization.Away (f P hP))
    haveI := hdom
    haveI := hic
    have hle : Submonoid.powers (f P hP) ≤ 𝔭.asIdeal.primeCompl :=
      (Submonoid.powers_le).mpr hx
    letI : Algebra (Localization.Away (f P hP)) R :=
      IsLocalization.localizationAlgebraOfSubmonoidLe _ R _ _ hle
    haveI := IsLocalization.localization_isScalarTower_of_submonoid_le
      (Localization.Away (f P hP)) R _ _ hle
    haveI hloc := IsLocalization.isLocalization_of_submonoid_le
      (Localization.Away (f P hP)) R _ _ hle
    have hN : Submonoid.map (algebraMap D (Localization.Away (f P hP))) 𝔭.asIdeal.primeCompl ≤
        nonZeroDivisors (Localization.Away (f P hP)) := by
      apply le_nonZeroDivisors_of_noZeroDivisors
      rintro ⟨s, hs, hs0⟩
      obtain ⟨⟨m, hm⟩, hms⟩ :=
        (IsLocalization.map_eq_zero_iff (Submonoid.powers (f P hP)) _ s).mp hs0
      obtain ⟨k, rfl⟩ := (Submonoid.mem_powers_iff _ _).mp hm
      have h0 : (f P hP) ^ k * s ∈ 𝔭.asIdeal := by
        rw [show (f P hP) ^ k * s = 0 from hms]
        exact 𝔭.asIdeal.zero_mem
      rcases 𝔭.isPrime.mem_or_mem h0 with h | h
      · exact hx (𝔭.isPrime.mem_of_pow_mem k h)
      · exact hs h
    haveI : IsDomain R := IsLocalization.isDomain_of_le_nonZeroDivisors R hN
    haveI : IsIntegrallyClosed R := isIntegrallyClosed_of_isLocalization R _ hN
    have hbot := IsIntegrallyClosed.integralClosure_eq_bot R (FractionRing R)
    have htop : LinearMap.range (Algebra.linearMap R ↥(integralClosure R (FractionRing R))) = ⊤ := by
      rw [Submodule.eq_top_iff']
      intro y
      have hy : (y : FractionRing R) ∈ (⊥ : Subalgebra R (FractionRing R)) := by
        rw [← hbot]; exact y.2
      obtain ⟨r, hr⟩ := Algebra.mem_bot.mp hy
      refine ⟨r, Subtype.ext ?_⟩
      rw [Algebra.linearMap_apply]
      exact hr
    rw [Module.length_eq_zero_iff, Submodule.Quotient.subsingleton_iff]
    exact htop

theorem wcpa_dj_lr1k_imf_curve_delta_finite : ∀ (κ : Type u) [Field κ] [PerfectField κ] (Y : Scheme.{u}) (q : Y ⟶ Spec (.of κ)) [LocallyOfFiniteType q] [CompactSpace ↥Y] [AlgebraicGeometry.IsReduced Y], topologicalKrullDim ↥Y ≤ ((1 : ℕ) : WithBot ℕ∞) → (∀ y : ↥Y, wcpaDjLkDelta (Y.presheaf.stalk y) ≠ ⊤) ∧ {y : ↥Y | wcpaDjLkDelta (Y.presheaf.stalk y) ≠ 0}.Finite :=
by
  intro κ _ _ Y q _ _ _ hY

  have hchart : ∀ (U : Y.Opens), IsAffineOpen U →
      ((Scheme.ΓSpecIso (.of κ)).inv ≫ q.appLE ⊤ U le_top).hom.FiniteType ∧
        ringKrullDim Γ(Y, U) ≤ topologicalKrullDim ↥Y := by
    intro U hU
    constructor
    · have h1 := HasRingHomProperty.appLE @LocallyOfFiniteType (Q := RingHom.FiniteType) q
        inferInstance ⟨⊤, isAffineOpen_top _⟩ ⟨U, hU⟩ le_top
      rw [CommRingCat.hom_comp]
      refine RingHom.FiniteType.comp h1 (RingHom.FiniteType.of_surjective _ ?_)
      intro x
      exact ⟨(Scheme.ΓSpecIso (.of κ)).hom.hom x, by simp⟩
    · have he : Topology.IsEmbedding hU.fromSpec := hU.fromSpec.isOpenEmbedding.isEmbedding
      calc ringKrullDim Γ(Y, U) = topologicalKrullDim (PrimeSpectrum Γ(Y, U)) :=
            (PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim _).symm
        _ = topologicalKrullDim (Set.range hU.fromSpec) :=
            IsHomeomorph.topologicalKrullDim_eq _ he.toHomeomorph.isHomeomorph
        _ ≤ _ := topologicalKrullDim_subspace_le _ _

  have hs3 : ∀ (R : Type u) [CommRing R] [IsNoetherianRing R],
      ringKrullDim R ≤ ((1 : ℕ) : WithBot ℕ∞) →
      Module.Finite R ↥(integralClosure R (FractionRing R)) →
      Module.length R (↥(integralClosure R (FractionRing R)) ⧸
        LinearMap.range (Algebra.linearMap R ↥(integralClosure R (FractionRing R)))) ≠ ⊤ := by
    classical
    intro R _ _ hdim hfin
    obtain ⟨n, g, hg⟩ :=
      Module.Finite.exists_fin (R := R) (M := ↥(integralClosure R (FractionRing R)))
    obtain ⟨⟨d, hd⟩, hdint⟩ := IsLocalization.exist_integer_multiples_of_finset (nonZeroDivisors R)
      (Finset.univ.image
        (fun j => ((g j : ↥(integralClosure R (FractionRing R))) : FractionRing R)))
    have hdg : ∀ j, ∃ r : R, d • g j = algebraMap R ↥(integralClosure R (FractionRing R)) r := by
      intro j
      obtain ⟨r, hr⟩ := hdint _ (Finset.mem_image_of_mem _ (Finset.mem_univ j))
      refine ⟨r, Subtype.ext ?_⟩
      exact hr.symm
    have htors : ∀ y : ↥(integralClosure R (FractionRing R)),
        d • y ∈ LinearMap.range (Algebra.linearMap R ↥(integralClosure R (FractionRing R))) := by
      have hle : Submodule.span R (Set.range g) ≤
          (LinearMap.range (Algebra.linearMap R ↥(integralClosure R (FractionRing R)))).comap
            (LinearMap.lsmul R ↥(integralClosure R (FractionRing R)) d) := by
        rw [Submodule.span_le]
        rintro _ ⟨j, rfl⟩
        obtain ⟨r, hr⟩ := hdg j
        rw [SetLike.mem_coe, Submodule.mem_comap, LinearMap.lsmul_apply, hr]
        exact ⟨r, rfl⟩
      intro y
      have hy : y ∈ Submodule.span R (Set.range g) := by rw [hg]; exact Submodule.mem_top
      have := hle hy
      rwa [Submodule.mem_comap, LinearMap.lsmul_apply] at this
    have htN : Module.IsTorsionBy R (↥(integralClosure R (FractionRing R)) ⧸
        LinearMap.range (Algebra.linearMap R ↥(integralClosure R (FractionRing R)))) d := by
      intro x
      induction x using Submodule.Quotient.induction_on with
      | H y =>
        rw [← Submodule.Quotient.mk_smul]
        exact (Submodule.Quotient.mk_eq_zero _).mpr (htors y)
    have hN : Module.IsTorsionBySet R (↥(integralClosure R (FractionRing R)) ⧸
        LinearMap.range (Algebra.linearMap R ↥(integralClosure R (FractionRing R))))
        (Ideal.span {d} : Set R) :=
      (Module.isTorsionBySet_span_singleton_iff d).mpr htN
    have hdim' : Order.krullDim (PrimeSpectrum R) ≤ 1 := by
      have : ringKrullDim R ≤ 1 := by simpa using hdim
      exact this
    have hmax : ∀ P : Ideal R, P.IsPrime → d ∈ P → P.IsMaximal := by
      intro P hP hdP
      rcases Order.krullDim_le_one_iff.mp hdim' ⟨P, hP⟩ with h | h
      · rw [PrimeSpectrum.isMin_iff] at h
        exact absurd hd
          (Set.disjoint_left.mp (Ideal.disjoint_nonZeroDivisors_of_mem_minimalPrimes h) hdP)
      · rwa [PrimeSpectrum.isMax_iff] at h
    haveI : Ring.KrullDimLE 0 (R ⧸ Ideal.span {d}) := by
      rw [Ring.krullDimLE_zero_iff]
      intro P hP
      have hc : (P.comap (Ideal.Quotient.mk (Ideal.span {d}))).IsMaximal := by
        apply hmax _ (Ideal.comap_isPrime _ _)
        rw [Ideal.mem_comap,
          Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self d)]
        exact P.zero_mem
      have := Ideal.IsMaximal.map_of_surjective_of_ker_le
        (f := Ideal.Quotient.mk (Ideal.span {d}))
        Ideal.Quotient.mk_surjective (m := P.comap (Ideal.Quotient.mk (Ideal.span {d}))) (by
        rw [Ideal.mk_ker]
        intro x hx
        rw [Ideal.mem_comap, Ideal.Quotient.eq_zero_iff_mem.mpr hx]
        exact P.zero_mem)
      rwa [Ideal.map_comap_of_surjective _ Ideal.Quotient.mk_surjective] at this
    haveI : IsArtinianRing (R ⧸ Ideal.span {d}) :=
      IsNoetherianRing.isArtinianRing_of_krullDimLE_zero
    letI := hN.module
    haveI := hN.isScalarTower (S := R)
    haveI : Module.Finite (R ⧸ Ideal.span {d}) (↥(integralClosure R (FractionRing R)) ⧸
        LinearMap.range (Algebra.linearMap R ↥(integralClosure R (FractionRing R)))) :=
      Module.Finite.of_restrictScalars_finite R _ _
    haveI : IsArtinian (R ⧸ Ideal.span {d}) (↥(integralClosure R (FractionRing R)) ⧸
        LinearMap.range (Algebra.linearMap R ↥(integralClosure R (FractionRing R)))) :=
      isArtinian_of_fg_of_artinian'
    haveI : IsArtinian R (↥(integralClosure R (FractionRing R)) ⧸
        LinearMap.range (Algebra.linearMap R ↥(integralClosure R (FractionRing R)))) :=
      isArtinian_of_surjective_algebraMap (S := R) (R := R ⧸ Ideal.span {d})
        Ideal.Quotient.mk_surjective
    haveI : IsNoetherian R (↥(integralClosure R (FractionRing R)) ⧸
        LinearMap.range (Algebra.linearMap R ↥(integralClosure R (FractionRing R)))) :=
      isNoetherian_of_isNoetherianRing_of_finite _ _
    exact Module.length_ne_top_iff.mpr
      (isFiniteLength_iff_isNoetherian_isArtinian.mpr ⟨inferInstance, inferInstance⟩)

  have hcov : ∀ y : Y, ∃ U : Y.Opens, IsAffineOpen U ∧ y ∈ U := fun y => by
    obtain ⟨W, hW, hyW, -⟩ :=
      exists_isAffineOpen_mem_and_subset (U := ⊤) (x := y) (by trivial)
    exact ⟨W, hW, hyW⟩
  refine ⟨fun y => ?_, ?_⟩
  ·
    obtain ⟨U, hU, hyU⟩ := hcov y
    obtain ⟨hft, hdimU⟩ := hchart U hU
    letI : Algebra κ Γ(Y, U) :=
      ((Scheme.ΓSpecIso (.of κ)).inv ≫ q.appLE ⊤ U le_top).hom.toAlgebra
    haveI : Algebra.FiniteType κ Γ(Y, U) := hft
    haveI : IsNoetherianRing Γ(Y, U) := Algebra.FiniteType.isNoetherianRing κ _
    letI : Algebra Γ(Y, U) (Y.presheaf.stalk y) :=
      TopCat.Presheaf.algebra_section_stalk Y.presheaf ⟨y, hyU⟩
    haveI hloc : IsLocalization.AtPrime (Y.presheaf.stalk y) (hU.primeIdealOf ⟨y, hyU⟩).asIdeal :=
      hU.isLocalization_stalk ⟨y, hyU⟩
    have hfin := wcpa_dj_lr1k_imfc_stalk_norm_finite κ Γ(Y, U)
      (hU.primeIdealOf ⟨y, hyU⟩).asIdeal (Y.presheaf.stalk y)
    haveI : IsNoetherianRing (Y.presheaf.stalk y) :=
      IsLocalization.isNoetherianRing (hU.primeIdealOf ⟨y, hyU⟩).asIdeal.primeCompl _
        inferInstance
    have hR : ringKrullDim (Y.presheaf.stalk y) ≤ ((1 : ℕ) : WithBot ℕ∞) := by
      rw [IsLocalization.AtPrime.ringKrullDim_eq_height (hU.primeIdealOf ⟨y, hyU⟩).asIdeal]
      exact (Ideal.height_le_ringKrullDim_of_ne_top (Ideal.IsPrime.ne_top inferInstance)).trans
