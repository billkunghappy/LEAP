theorem wcpa_dj_lr1k_eb_rs_archimedean : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → ∀ (L : Type u) [Field L] [Algebra (RatFunc Ω) L] (O : ValuationSubring (RatFunc Ω)), (∀ a : Ω, O.valuation (algebraMap Ω (RatFunc Ω) a) < 1 ↔ W.valuation a < 1) → ∀ V' : ValuationSubring L, V'.comap (algebraMap (RatFunc Ω) L) = O → (∀ s : L, s ≠ 0 → ∃ c : Ω, c ≠ 0 ∧ V'.valuation (s / algebraMap (RatFunc Ω) L (algebraMap Ω (RatFunc Ω) c)) = 1) → ∀ x y : L, y ≠ 0 → V'.valuation x < 1 → ∃ N : ℕ, V'.valuation x ^ N < V'.valuation y :=
