      HenselianLocalRing (R ⧸ 𝔞) ∧ (∀ a : R, IsUnit (Ideal.Quotient.mk 𝔞 a) ↔ a ∉ q) ∧
      (∀ x : R ⧸ 𝔞, x ∈ Ideal.map (Ideal.Quotient.mk 𝔞) q ↔ ¬ IsUnit x) ∧
      Ideal.map (Ideal.Quotient.mk 𝔞) q ^ n = ⊥ := by
    intro R _ q 𝔞 n hq hn hqn h𝔞
    have hunit : ∀ a : R, IsUnit (Ideal.Quotient.mk 𝔞 a) ↔ a ∉ q := by
      intro a
      constructor
      · rintro ⟨u, hu⟩ ha
        obtain ⟨b, hb⟩ := Ideal.Quotient.mk_surjective ((u⁻¹ : (R ⧸ 𝔞)ˣ) : R ⧸ 𝔞)
        have h1 : Ideal.Quotient.mk 𝔞 (a * b - 1) = 0 := by
          rw [map_sub, map_mul, map_one, hb, ← hu, Units.mul_inv, sub_self]
        rw [Ideal.Quotient.eq_zero_iff_mem] at h1
        have h2 : a * b ∈ q := q.mul_mem_right b ha
        have h3 := q.sub_mem h2 (h𝔞 h1)
        rw [sub_sub_cancel] at h3
        exact hq.ne_top ((Ideal.eq_top_iff_one q).mpr h3)
      · intro ha
        obtain ⟨b, c, hc, hbc⟩ := hq.exists_inv ha
        have hcn : Ideal.Quotient.mk 𝔞 c ^ n = 0 := by
          rw [← map_pow, Ideal.Quotient.eq_zero_iff_mem]
          exact hqn (Ideal.pow_mem_pow hc n)
        have hnil : IsNilpotent (Ideal.Quotient.mk 𝔞 c) := ⟨n, hcn⟩
        have h1 : IsUnit (1 - Ideal.Quotient.mk 𝔞 c) := hnil.isUnit_one_sub
        have hba : b * a = 1 - c := by rw [← hbc]; ring
        have h2 : Ideal.Quotient.mk 𝔞 b * Ideal.Quotient.mk 𝔞 a = 1 - Ideal.Quotient.mk 𝔞 c := by
          rw [← map_mul, hba, map_sub, map_one]
        rw [← h2] at h1
        exact isUnit_of_mul_isUnit_right h1
    have hmem : ∀ x : R ⧸ 𝔞, x ∈ Ideal.map (Ideal.Quotient.mk 𝔞) q ↔ ¬ IsUnit x := by
      intro x
      obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective x
      rw [hunit, not_not]
      constructor
      · intro hx
        rw [Ideal.mem_map_iff_of_surjective _ Ideal.Quotient.mk_surjective] at hx
        obtain ⟨b, hb, hba⟩ := hx
        rw [Ideal.Quotient.eq] at hba
        have h3 := q.sub_mem hb (h𝔞 hba)
        rwa [sub_sub_cancel] at h3
      · intro ha
        exact Ideal.mem_map_of_mem _ ha
    have hnil : Ideal.map (Ideal.Quotient.mk 𝔞) q ^ n = ⊥ := by
      rw [← Ideal.map_pow, eq_bot_iff]
