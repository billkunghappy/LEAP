    intro Ω _ _ W
    have key : ∀ (x : Ω) (R : Polynomial Ω),
        algebraMap (Polynomial Ω) (RatFunc Ω) (Polynomial.C x * R) =
          algebraMap Ω (RatFunc Ω) x * algebraMap (Polynomial Ω) (RatFunc Ω) R := by
      intro x R
      rw [map_mul, Polynomial.C_eq_algebraMap, ← IsScalarTower.algebraMap_apply]
    have alg_inj : Function.Injective (algebraMap (Polynomial Ω) (RatFunc Ω)) :=
      RatFunc.algebraMap_injective Ω
    have g0 : ∀ q : Polynomial ↥W, (∃ i, IsUnit (q.coeff i)) → q.map W.subtype ≠ 0 := by
      rintro q ⟨i, hi⟩ h
      have h1 := congrArg (fun P => P.coeff i) h
      simp only [Polynomial.coeff_map, Polynomial.coeff_zero] at h1
