    · exact ⟨0, 0, not_isUnit_zero, isIntegral_zero, by rw [hw0, mul_zero], fun E _ => E.zero_mem⟩
    · obtain ⟨c, u, v, hwu, huv, hu, hv⟩ := h5 (w : N) hw0 ((hO _).mp w.2)
      have hc0 : algebraMap V N c ≠ 0 := by
        intro h; apply hw0; rw [hwu, h, zero_mul]
      refine ⟨c, u, ?_, hu, hwu, fun E hE => ?_⟩
      · intro hcu
        obtain ⟨c', hc'⟩ := isUnit_iff_exists_inv.mp hcu
        apply (hres0 w).mp hw
        refine (hunitO w).mpr ⟨hw0, ?_⟩
        have e : (w : N)⁻¹ = algebraMap V N c' * v := by
          symm
          apply eq_inv_of_mul_eq_one_right
          rw [hwu]
          calc algebraMap V N c * u * (algebraMap V N c' * v)
              = algebraMap V N (c * c') * (u * v) := by rw [map_mul]; ring
            _ = 1 := by rw [hc', huv, map_one, one_mul]
        rw [e]
        exact isIntegral_algebraMap.mul hv
      · have e : u = (algebraMap K N (algebraMap V K c))⁻¹ * (w : N) := by
          rw [← hVN, hwu, ← mul_assoc, inv_mul_cancel₀ hc0, one_mul]
        rw [e, ← map_inv₀]
        exact E.mul_mem (E.algebraMap_mem _) hE

  obtain ⟨R, hR⟩ : ∃ R : IntermediateField K N → Subfield (IsLocalRing.ResidueField O),
      ∀ (E : IntermediateField K N) (a : IsLocalRing.ResidueField O),
        a ∈ R E ↔ ∃ x : O, (x : N) ∈ E ∧ IsLocalRing.residue O x = a := by
    refine ⟨fun E =>
      { carrier := {a | ∃ x : O, (x : N) ∈ E ∧ IsLocalRing.residue O x = a}
        mul_mem' := by
          rintro a b ⟨x, hx, rfl⟩ ⟨y, hy, rfl⟩
          exact ⟨x * y, E.mul_mem hx hy, map_mul _ _ _⟩
        one_mem' := ⟨1, E.one_mem, map_one _⟩
        add_mem' := by
          rintro a b ⟨x, hx, rfl⟩ ⟨y, hy, rfl⟩
          exact ⟨x + y, E.add_mem hx hy, map_add _ _ _⟩
        zero_mem' := ⟨0, E.zero_mem, map_zero _⟩
        neg_mem' := by
          rintro a ⟨x, hx, rfl⟩
          exact ⟨-x, E.neg_mem hx, map_neg _ _⟩
        inv_mem' := by
          rintro a ⟨x, hx, rfl⟩
          by_cases h0 : IsLocalRing.residue O x = 0
          · rw [h0, inv_zero]; exact ⟨0, E.zero_mem, map_zero _⟩
          · obtain ⟨y, hy⟩ :=
              isUnit_iff_exists_inv.mp ((IsLocalRing.residue_ne_zero_iff_isUnit x).mp h0)
            have hy' : (x : N) * (y : N) = 1 := congrArg Subtype.val hy
            refine ⟨y, ?_, ?_⟩
            · rw [eq_inv_of_mul_eq_one_right hy']; exact E.inv_mem hx
            · apply eq_inv_of_mul_eq_one_right
              rw [← map_mul, hy, map_one] }, fun E a => Iff.rfl⟩
  have hRmono : ∀ E E' : IntermediateField K N, E ≤ E' → R E ≤ R E' := by
    intro E E' h a ha
    obtain ⟨x, hx, rfl⟩ := (hR E a).mp ha
    exact (hR E' _).mpr ⟨x, h hx, rfl⟩

  have hs3 : ∀ E E' : IntermediateField K N, ∀ h : E ≤ E',
      1 ≤ (R E).relfinrank (R E') ∧ (R E).relfinrank (R E') ≤ E.relfinrank E' := by
    intro E E' h
    have hRR := hRmono E E' h
    have hcard : ∀ s : Finset ↥(Subfield.extendScalars hRR),
        LinearIndependent ↥(R E) (fun i : s => (i : ↥(Subfield.extendScalars hRR))) →
        s.card ≤ E.relfinrank E' := by
      intro s hs
      rw [IntermediateField.relfinrank_eq_finrank_of_le h]
      have hlift : ∀ i : s, ∃ x : O, (x : N) ∈ E' ∧ IsLocalRing.residue O x =
          ((i : ↥(Subfield.extendScalars hRR)) : IsLocalRing.ResidueField O) :=
        fun i => (hR E' _).mp ((Subfield.mem_extendScalars hRR).mp
          (i : ↥(Subfield.extendScalars hRR)).2)
      choose a ha using hlift
      let y : s → ↥(IntermediateField.extendScalars h) := fun i =>
        ⟨(a i : N), (IntermediateField.mem_extendScalars h).mpr (ha i).1⟩
      have hli : LinearIndependent ↥E y := by
        rw [Fintype.linearIndependent_iff]
        intro g hg
        by_contra hne
        push_neg at hne
        obtain ⟨i₁, hi₁⟩ := hne
        obtain ⟨i₀, -, hi₀⟩ := Finset.univ.exists_max_image
          (fun i => O.valuation ((g i : ↥E) : N)) ⟨i₁, Finset.mem_univ _⟩
        have hg1 : ((g i₁ : ↥E) : N) ≠ 0 := fun h0 => hi₁ (Subtype.ext h0)
        have hv1 : O.valuation ((g i₁ : ↥E) : N) ≠ 0 := (Valuation.ne_zero_iff _).mpr hg1
        have hv0 : O.valuation ((g i₀ : ↥E) : N) ≠ 0 := by
          intro h0
          have := hi₀ i₁ (Finset.mem_univ _)
          rw [h0] at this
          exact hv1 (le_antisymm this zero_le')
        have hg0 : ((g i₀ : ↥E) : N) ≠ 0 := (Valuation.ne_zero_iff _).mp hv0
        have hcO : ∀ i, ((g i : ↥E) : N) / ((g i₀ : ↥E) : N) ∈ O := by
          intro i
          rw [← ValuationSubring.valuation_le_one_iff, Valuation.map_div]
          exact (div_le_one₀ (zero_lt_iff.mpr hv0)).mpr (hi₀ i (Finset.mem_univ _))
        let c : s → O := fun i => ⟨((g i : ↥E) : N) / ((g i₀ : ↥E) : N), hcO i⟩
        have hcE : ∀ i, ((c i : O) : N) ∈ E := fun i => E.div_mem (g i).2 (g i₀).2
        have hc0 : c i₀ = 1 := Subtype.ext (div_self hg0)
        have hsumN : ∑ i, ((g i : ↥E) : N) * (a i : N) = 0 := by
          have := congrArg Subtype.val hg
          rw [IntermediateField.coe_sum] at this
          exact this
        have hsumO : ∑ i, c i * a i = 0 := by
          apply Subtype.ext
          show O.subtype (∑ i, c i * a i) = 0
          rw [map_sum]
          show ∑ i, ((g i : ↥E) : N) / ((g i₀ : ↥E) : N) * (a i : N) = 0
          simp_rw [div_mul_eq_mul_div]
          rw [← Finset.sum_div, hsumN, zero_div]
        have hres : ∑ i, IsLocalRing.residue O (c i) * IsLocalRing.residue O (a i) = 0 := by
          have := congrArg (IsLocalRing.residue O) hsumO
          rw [map_sum, map_zero] at this
          simpa only [map_mul] using this
        have hcR : ∀ i, IsLocalRing.residue O (c i) ∈ R E := fun i =>
          (hR E _).mpr ⟨c i, hcE i, rfl⟩
        have hP : ∑ i, (⟨IsLocalRing.residue O (c i), hcR i⟩ : ↥(R E)) •
            (i : ↥(Subfield.extendScalars hRR)) = 0 := by
          apply Subtype.ext
          rw [IntermediateField.coe_sum]
          show ∑ i, IsLocalRing.residue O (c i) *
            ((i : ↥(Subfield.extendScalars hRR)) : IsLocalRing.ResidueField O) = 0
          rw [← hres]
          refine Finset.sum_congr rfl fun i _ => ?_
          rw [(ha i).2]
        have h2 := (Fintype.linearIndependent_iff.mp hs) _ hP i₀
        have h1 : IsLocalRing.residue O (c i₀) = 0 := congrArg Subtype.val h2
        rw [hc0, map_one] at h1
        exact one_ne_zero h1
      have := hli.fintype_card_le_finrank
      rwa [Fintype.card_coe] at this
    have hrank : Module.rank ↥(R E) ↥(Subfield.extendScalars hRR) ≤
        ((E.relfinrank E' : ℕ) : Cardinal) := rank_le hcard
    have hle := Module.finrank_le_of_rank_le hrank
    haveI : Module.Finite ↥(R E) ↥(Subfield.extendScalars hRR) :=
      Module.rank_lt_aleph0_iff.mp (lt_of_le_of_lt hrank Cardinal.natCast_lt_aleph0)
    have hpos : 0 < Module.finrank ↥(R E) ↥(Subfield.extendScalars hRR) := Module.finrank_pos
    rw [Subfield.relfinrank_eq_finrank_of_le hRR]
    exact ⟨hpos, hle⟩

  have hs4 : ∀ A M F : IntermediateField K N, A ≤ M → A ≤ F →
      F.relfinrank (M ⊔ F) ≤ A.relfinrank M := by
    intro A M F hAM hAF
    have e1 := IntermediateField.finrank_sup_le (IntermediateField.extendScalars hAM)
      (IntermediateField.extendScalars hAF)
    rw [IntermediateField.extendScalars_sup, ← IntermediateField.relfinrank_eq_finrank_of_le,
      ← IntermediateField.relfinrank_eq_finrank_of_le,
      ← IntermediateField.relfinrank_eq_finrank_of_le] at e1
    have e2 := IntermediateField.relfinrank_mul_relfinrank hAF (le_sup_right : F ≤ M ⊔ F)
    have hpos : 0 < A.relfinrank F := by
      rw [IntermediateField.relfinrank_eq_finrank_of_le hAF]; exact Module.finrank_pos
    refine Nat.le_of_mul_le_mul_left ?_ hpos
    rw [e2, mul_comm]
    exact e1

  have hImm1 : ∀ A B : IntermediateField K N, wcUtImm V K N A B → R B ≤ R A := by
    intro A B hI a ha
    obtain ⟨x, hxB, rfl⟩ := (hR B a).mp ha
    obtain ⟨c, hc, r, z, hr, hz, heq⟩ := hI ⟨x, hxB⟩ ((hintE B _).mpr ((hO _).mp x.2))
    have heq' : (x : N) - (c : N) = algebraMap V N r * (z : N) := heq
    let cO : O := ⟨(c : N), (hO _).mpr ((hintE A c).mp hc)⟩
    have hsub : IsLocalRing.residue O (x - cO) = 0 := by
      rw [hres0]
      intro hu
      obtain ⟨h0, hi⟩ := (hunitO _).mp hu
      change (x : N) - (c : N) ≠ 0 at h0
      change IsIntegral V ((x : N) - (c : N))⁻¹ at hi
      rw [heq'] at h0 hi
      apply hr
      have hr0 : algebraMap V N r ≠ 0 := left_ne_zero_of_mul h0
      have hz0 : (z : N) ≠ 0 := right_ne_zero_of_mul h0
      apply hN1 r hr0
      have e : (algebraMap V N r)⁻¹ = (z : N) * (algebraMap V N r * (z : N))⁻¹ := by
        rw [mul_inv_rev, ← mul_assoc, mul_inv_cancel₀ hz0, one_mul]
      rw [e]
      exact ((hintE B z).mp hz).mul hi
    rw [map_sub, sub_eq_zero] at hsub
    rw [hsub]
    exact (hR A _).mpr ⟨cO, c.2, rfl⟩
  have hImm2 : ∀ A B : IntermediateField K N, A ≤ B → R B ≤ R A → wcUtImm V K N A B := by
    intro A B hAB hle y hy
    have hyO : (y : N) ∈ O := (hO _).mpr ((hintE B y).mp hy)
    obtain ⟨x, hxA, hxres⟩ := (hR A _).mp (hle ((hR B _).mpr ⟨⟨(y : N), hyO⟩, y.2, rfl⟩))
    have hw : IsLocalRing.residue O (⟨(y : N), hyO⟩ - x) = 0 := by
      rw [map_sub, hxres, sub_self]
    obtain ⟨r, u, hr, hu, hwu, hmem⟩ := hN2 _ hw
    have huB : u ∈ B := hmem B (B.sub_mem y.2 (hAB hxA))
    exact ⟨⟨(x : N), hxA⟩, (hintE A _).mpr ((hO _).mp x.2), r, ⟨u, huB⟩, hr,
      (hintE B _).mpr hu, hwu⟩

  have hs6 : ∀ M : IntermediateField K N, wcRfCart V ↥M t →
      Module.finrank K ↥M ≤ (R ⊥).relfinrank (R M) := by
    intro M hMc
    obtain ⟨n, b, hbi, hspan, hUC⟩ := hMc
    have htK : algebraMap V K t ≠ 0 := (map_ne_zero_iff _ hinjK).mpr ht
    have hspanK : Submodule.span K (Set.range b) = ⊤ := by
      rw [eq_top_iff]
      intro x _
      obtain ⟨m, hm⟩ := hspan x
      have h1 : algebraMap V ↥M t ^ m * x ∈ Submodule.span K (Set.range b) :=
        Submodule.span_le_restrictScalars V K (Set.range b) hm
      have e : algebraMap V ↥M t ^ m * x = (algebraMap V K t ^ m) • x := by
        rw [Algebra.smul_def, map_pow, ← IsScalarTower.algebraMap_apply]
      rw [e] at h1
      have := Submodule.smul_mem _ (algebraMap V K t ^ m)⁻¹ h1
      rwa [inv_smul_smul₀ (pow_ne_zero _ htK)] at this
    have hi : Module.finrank K ↥M ≤ n := by
      have := finrank_range_le_card (R := K) b
      rwa [Set.finrank, hspanK, finrank_top, Fintype.card_fin] at this
    have hRR : R ⊥ ≤ R M := hRmono ⊥ M bot_le
    have hβO : ∀ j, ((b j : ↥M) : N) ∈ O := fun j => (hO _).mpr ((hintE M (b j)).mp (hbi j))
    let β : Fin n → O := fun j => ⟨((b j : ↥M) : N), hβO j⟩
    have hfam : ∀ j, IsLocalRing.residue O (β j) ∈ Subfield.extendScalars hRR := fun j =>
      (Subfield.mem_extendScalars hRR).mpr ((hR M _).mpr ⟨β j, (b j).2, rfl⟩)
    let fam : Fin n → ↥(Subfield.extendScalars hRR) := fun j =>
      ⟨IsLocalRing.residue O (β j), hfam j⟩
    have hli : LinearIndependent ↥(R ⊥) fam := by
      rw [Fintype.linearIndependent_iff]
      intro g hg j₀
      by_contra hne
      have hlift : ∀ j, ∃ s : V, IsLocalRing.residue O
          ⟨algebraMap V N s, (hO _).mpr isIntegral_algebraMap⟩ =
          ((g j : ↥(R ⊥)) : IsLocalRing.ResidueField O) := by
        intro j
        obtain ⟨x, hx, hxr⟩ := (hR ⊥ _).mp (g j).2
        obtain ⟨k, hk⟩ := IntermediateField.mem_bot.mp hx
        have hkint : IsIntegral V k :=
          (isIntegral_algHom_iff (IsScalarTower.toAlgHom V K N) (algebraMap K N).injective).mp
            (by show IsIntegral V (algebraMap K N k); rw [hk]; exact (hO _).mp x.2)
        obtain ⟨s, hs⟩ := hic k hkint
        refine ⟨s, ?_⟩
        rw [← hxr]
        congr 1
        apply Subtype.ext
        show algebraMap V N s = (x : N)
        rw [hVN, hs, hk]
      choose s hs using hlift
      let sO : Fin n → O := fun j => ⟨algebraMap V N (s j), (hO _).mpr isIntegral_algebraMap⟩
      have hunit : IsUnit (s j₀) := by
        have h1 : IsLocalRing.residue O (sO j₀) ≠ 0 := by
          intro h0; apply hne; apply Subtype.ext; rw [← hs j₀]; exact h0
        obtain ⟨h0, hinv⟩ := (hunitO _).mp ((IsLocalRing.residue_ne_zero_iff_isUnit _).mp h1)
        exact hN1 _ h0 hinv
      let X : O := ∑ j, sO j * β j
      have hXN : (X : N) = ∑ j, algebraMap V N (s j) * ((b j : ↥M) : N) := by
        show O.subtype (∑ j, sO j * β j) = _
        rw [map_sum]; rfl
      have hXres : IsLocalRing.residue O X = 0 := by
        have h1 : ∑ j, ((g j : ↥(R ⊥)) : IsLocalRing.ResidueField O) *
            IsLocalRing.residue O (β j) = 0 := by
          have := congrArg Subtype.val hg
          rw [IntermediateField.coe_sum] at this
          exact this
        rw [← h1]
        show IsLocalRing.residue O (∑ j, sO j * β j) = _
        rw [map_sum]
        refine Finset.sum_congr rfl fun j _ => ?_
        rw [map_mul]
        exact congrArg (· * IsLocalRing.residue O (β j)) (hs j)
      obtain ⟨r, u, hr, hu, hXu, hmem⟩ := hN2 X hXres
      have hXM : (X : N) ∈ M := by
        rw [hXN]
        exact sum_mem fun j _ => M.mul_mem (by rw [hVN]; exact M.algebraMap_mem _) (b j).2
      have huM : u ∈ M := hmem M hXM
      apply hUC s ⟨j₀, hunit⟩ r ⟨u, huM⟩ hr ((hintE M _).mpr hu)
      apply Subtype.ext
      rw [IntermediateField.coe_sum]
      show ∑ j, algebraMap V N (s j) * ((b j : ↥M) : N) = algebraMap V N r * u
      rw [← hXN, hXu]
    obtain ⟨hpos, -⟩ := hs3 ⊥ M bot_le
    rw [Subfield.relfinrank_eq_finrank_of_le hRR] at hpos ⊢
    haveI : Module.Finite ↥(R ⊥) ↥(Subfield.extendScalars hRR) :=
      @Module.finite_of_finrank_pos ↥(R ⊥) ↥(Subfield.extendScalars hRR) _ _ _
        (Module.Free.of_divisionRing _ _) _ hpos
    have := hli.fintype_card_le_finrank
    rw [Fintype.card_fin] at this
    omega

  have hFC : Ft ≤ M ⊔ Ft := le_sup_right
  have hMC : M ≤ M ⊔ Ft := le_sup_left
  obtain ⟨hx1, hx1D⟩ := hs3 ⊥ A bot_le
  obtain ⟨hx2, hx2D⟩ := hs3 A M hAM
  have hmulR := Subfield.relfinrank_mul_relfinrank (hRmono ⊥ A bot_le) (hRmono A M hAM)
  have hmulD := IntermediateField.relfinrank_mul_relfinrank (bot_le : ⊥ ≤ A) hAM
  rw [IntermediateField.relfinrank_bot_left, IntermediateField.relfinrank_bot_left] at hmulD
  rw [IntermediateField.relfinrank_bot_left] at hx1D
  have h6 := hs6 M hMc
  have hx2eq : (R A).relfinrank (R M) = A.relfinrank M := by
    have h1 : Module.finrank K ↥A * A.relfinrank M ≤
        (R ⊥).relfinrank (R A) * (R A).relfinrank (R M) := by
      rw [hmulD, hmulR]; exact h6
    have h2 : Module.finrank K ↥A * (R A).relfinrank (R M) ≤
        Module.finrank K ↥A * A.relfinrank M := Nat.mul_le_mul_left _ hx2D
    have h3 : (R ⊥).relfinrank (R A) * (R A).relfinrank (R M) ≤
        Module.finrank K ↥A * (R A).relfinrank (R M) := Nat.mul_le_mul_right _ hx1D
    have h4 : Module.finrank K ↥A * (R A).relfinrank (R M) =
        Module.finrank K ↥A * A.relfinrank M := le_antisymm h2 (by linarith)
    exact Nat.eq_of_mul_eq_mul_left (by omega) h4
  have hrdAF : (R A).relfinrank (R Ft) = 1 :=
    Subfield.relfinrank_eq_one_iff.mpr (hImm1 A Ft himm)
  have hRC : R (M ⊔ Ft) ≤ R M := by
    have e1 := Subfield.relfinrank_mul_relfinrank (hRmono A M hAM) (hRmono M _ hMC)
    have e2 := Subfield.relfinrank_mul_relfinrank (hRmono A Ft hAF) (hRmono Ft _ hFC)
    rw [← e1, hrdAF, one_mul] at e2
    obtain ⟨hy, -⟩ := hs3 M _ hMC
    obtain ⟨-, hFCD⟩ := hs3 Ft _ hFC
    have h44 := hs4 A M Ft hAM hAF
    have h5' : (R A).relfinrank (R M) * (R M).relfinrank (R (M ⊔ Ft)) ≤
        (R A).relfinrank (R M) * 1 := by
      rw [mul_one, ← e2, hx2eq]; exact hFCD.trans h44
    have hy1 : (R M).relfinrank (R (M ⊔ Ft)) ≤ 1 := Nat.le_of_mul_le_mul_left h5' (by omega)
    exact Subfield.relfinrank_eq_one_iff.mp (le_antisymm hy1 hy)
  refine ⟨?_, fun E hME hEC => hImm2 M E hME ((hRmono E _ hEC).trans hRC)⟩
  intro hMeq
  have hFM : Ft ≤ M := le_sup_right.trans hMeq.symm.le
  have e1 := Subfield.relfinrank_mul_relfinrank (hRmono A Ft hAF) (hRmono Ft M hFM)
  rw [hrdAF, one_mul] at e1
  obtain ⟨hD3, hFMD⟩ := hs3 Ft M hFM
  obtain ⟨-, hD4'⟩ := hs3 A Ft hAF
  rw [hrdAF] at hD4'
  have e2 := IntermediateField.relfinrank_mul_relfinrank hAF hFM
  have h7 : A.relfinrank Ft * Ft.relfinrank M ≤ 1 * Ft.relfinrank M := by
    rw [e2, one_mul, ← hx2eq, ← e1]; exact hFMD
  have hD4le := Nat.le_of_mul_le_mul_right h7 (by omega)
  have hD4one : A.relfinrank Ft = 1 := le_antisymm hD4le hD4'
  exact hne (le_antisymm hAF (IntermediateField.relfinrank_eq_one_iff.mp hD4one))

theorem wcpa_dj_lr1s_nf_cnf_fmp_gb_cs_rf_ut_galois_pstep : ∀ (K N : Type u) [Field K] [Field N] [Algebra K N] [FiniteDimensional K N] [Normal K N] (p : ℕ) [Fact p.Prime] (I : Subgroup (N ≃ₐ[K] N)) (a : ℕ), Nat.card I = p ^ a → ∀ (L : IntermediateField K N), IntermediateField.fixedField I ⊓ separableClosure K N ≤ L → L ⊓ separableClosure K N ≠ IntermediateField.fixedField I ⊓ separableClosure K N → ∃ E : IntermediateField K N, IntermediateField.fixedField I ⊓ separableClosure K N ≤ E ∧ E ≤ L ∧ Module.finrank K ↥E = p * Module.finrank K ↥(IntermediateField.fixedField I ⊓ separableClosure K N) :=
by
  intro K N _ _ _ _ _ p _ I a hcard L hML hne
  classical

  have gp_chain : ∀ (G : Type u) [Group G] [Finite G] (P H : Subgroup G) (n : ℕ),
      Nat.card P = p ^ n → H ≤ P → H ≠ P →
      ∃ J : Subgroup G, H ≤ J ∧ J ≤ P ∧ Nat.card P = p * Nat.card J := by
    intro G _ _ P H n hP hHP hHne
    have hp : p.Prime := Fact.out
    have hdvd : Nat.card H ∣ p ^ n := hP ▸ Subgroup.card_dvd_of_le hHP
    obtain ⟨b, hb, hHb⟩ := (Nat.dvd_prime_pow hp).mp hdvd
    have hbn : b < n := by
      rcases lt_or_eq_of_le hb with h | h
      · exact h
      · exfalso
        apply hHne
        exact Subgroup.eq_of_le_of_card_ge hHP (by rw [hP, hHb, h])
    obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
    have hmap : (H.subgroupOf P).map P.subtype = H := by
      rw [Subgroup.subgroupOf_map_subtype, inf_eq_left.mpr hHP]
    have hH' : Nat.card (H.subgroupOf P) = p ^ b := by
