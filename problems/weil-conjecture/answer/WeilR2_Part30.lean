          intro h0
          apply hc
          rw [h0, zero_div, map_zero]
          exact zero_lt_one
        have hc'W : β₁ / R.coeff 0 ∈ W := by
          rw [← W.valuation_le_one_iff, ← inv_div, map_inv₀]
          exact inv_le_one_of_one_le₀ hc'
        refine ⟨R.coeff 0, 0, h₁, 1 + ι (β₁ / R.coeff 0) * η ^ (j₁ + 1) * d₁, hR00, hh₁0, hh₁m,
          add_mem (one_mem _) (mul_mem (mul_mem (genW _ ⟨_, hc'W⟩) (pow_mem (genη _) _)) hd₁),
          ?_, ?_⟩
        · rw [add_sub_cancel_left, map_mul, map_mul, hunit d₁ hd₁1, mul_one, map_pow, mul_comm]
          exact mul_lt_one_of_lt_of_le (pow_lt_one₀ zero_le' hC3 (Nat.succ_ne_zero j₁))
            (hC1 ⟨_, hc'W⟩)
        · have hιR : ι (R.coeff 0) ≠ 0 := (map_ne_zero ι).mpr hR00
          rw [E, map_div₀]
          field_simp
          try ring

  have hmono : ∀ (c : Ω) (i j : ℕ), U.valuation (ι c * η ^ i / η ^ j) ≤ 1 →
      ∃ h : ↥W, h ≠ 0 ∧ h ∈ IsLocalRing.maximalIdeal ↥W ∧
        ι c * η ^ i / η ^ j ∈ wcEbEpD W L (h : Ω) η := by
    intro c i j hx
    by_cases hc0 : c = 0
    · refine ⟨π, hπ0, hπm, ?_⟩
      rw [hc0, map_zero, zero_mul, zero_div]
      exact zero_mem _
    have hinv : U.valuation (ι c⁻¹) * U.valuation (ι c) = 1 := by
      rw [← map_mul, ← map_mul, inv_mul_cancel₀ hc0, map_one, map_one]
    by_cases hji : j ≤ i
    · have e : ι c * η ^ i / η ^ j = ι c * η ^ (i - j) := by
        rw [pow_sub₀ η hη0 hji, div_eq_mul_inv, mul_assoc]
      rw [e] at hx ⊢
      by_cases hcW : W.valuation c ≤ 1
      · have hcW' : c ∈ W := (W.valuation_le_one_iff c).mp hcW
        exact ⟨π, hπ0, hπm, mul_mem (genW _ ⟨c, hcW'⟩) (pow_mem (genη _) _)⟩
      · exfalso
        have hcv : 1 < W.valuation c := not_le.mp hcW
        have hgv : W.valuation c⁻¹ < 1 := by
          rw [map_inv₀]; exact inv_lt_one_of_one_lt₀ hcv
        have hgW : c⁻¹ ∈ W := (W.valuation_le_one_iff _).mp hgv.le
        have hg0 : (⟨c⁻¹, hgW⟩ : ↥W) ≠ 0 := fun h => inv_ne_zero hc0 (congrArg Subtype.val h)
        have hgm : (⟨c⁻¹, hgW⟩ : ↥W) ∈ IsLocalRing.maximalIdeal ↥W :=
          (W.valuation_lt_one_iff _).mpr hgv
        have h7 := hF7 _ hg0 hgm (i - j)
        rw [map_mul, map_pow] at hx
        have h8 : U.valuation η ^ (i - j) ≤ U.valuation (ι c⁻¹) :=
          calc U.valuation η ^ (i - j)
              = (U.valuation (ι c⁻¹) * U.valuation (ι c)) * U.valuation η ^ (i - j) := by
                rw [hinv, one_mul]
            _ = U.valuation (ι c⁻¹) * (U.valuation (ι c) * U.valuation η ^ (i - j)) :=
                mul_assoc _ _ _
            _ ≤ U.valuation (ι c⁻¹) * 1 := by gcongr
            _ = U.valuation (ι c⁻¹) := mul_one _
        exact absurd h7 (not_lt.mpr h8)
    · obtain ⟨l, rfl⟩ : ∃ l, j = i + (l + 1) := ⟨j - i - 1, by omega⟩
      have e : ι c * η ^ i / η ^ (i + (l + 1)) = ι c / η ^ (l + 1) := by
        rw [pow_add, mul_comm (ι c) (η ^ i), mul_div_mul_left _ _ (pow_ne_zero i hη0)]
      rw [e] at hx ⊢
      by_cases hcv : W.valuation c < 1
      · obtain ⟨h', hh'0, hh'm, hpow⟩ := hroot c hc0 hcv (l + 1) (Nat.succ_ne_zero l)
        refine ⟨h', hh'0, hh'm, ?_⟩
        rw [← hpow, map_pow, ← div_pow]
        exact pow_mem (genT _) _
      · exfalso
        have hcv' : 1 ≤ W.valuation c := not_lt.mp hcv
        have hgW : c⁻¹ ∈ W := by
          rw [← W.valuation_le_one_iff, map_inv₀]
          exact inv_le_one_of_one_le₀ hcv'
        have hC1' : U.valuation (ι c⁻¹) ≤ 1 := hC1 ⟨c⁻¹, hgW⟩
        have h1 : 1 ≤ U.valuation (ι c) :=
          calc (1 : _) = U.valuation (ι c⁻¹) * U.valuation (ι c) := hinv.symm
            _ ≤ 1 * U.valuation (ι c) := by gcongr
            _ = U.valuation (ι c) := one_mul _
        have hpos : 0 < U.valuation η ^ (l + 1) := pow_pos hηpos _
        rw [map_div₀, map_pow, div_le_one₀ hpos] at hx
        have hlt : U.valuation η ^ (l + 1) < 1 := pow_lt_one₀ zero_le' hC3 (Nat.succ_ne_zero l)
        exact absurd (lt_of_le_of_lt (h1.trans hx) hlt) (lt_irrefl _)

  by_cases hP0 : P.eval₂ ι η = 0
  · refine ⟨π, 0, 1, hπ0, hπm, zero_mem _, one_mem _, ?_, ?_⟩
    · rw [sub_self, map_zero]; exact zero_lt_one
    · rw [hP0, zero_div, zero_mul]
  have hPne : P ≠ 0 := fun h => hP0 (by rw [h, Polynomial.eval₂_zero])
  have hQne : Q ≠ 0 := fun h => hQ (by rw [h, Polynomial.eval₂_zero])
  obtain ⟨α, i₀, hP, dP, hα0, hhP0, hhPm, hdP, hdP1, eP⟩ := hlaur _ P le_rfl hPne
  obtain ⟨β, j₀, hQh, dQ, hβ0, hhQ0, hhQm, hdQ, hdQ1, eQ⟩ := hlaur _ Q le_rfl hQne
  have hdPu := hunit dP hdP1
  have hdQu := hunit dQ hdQ1
  have hdP0 : dP ≠ 0 := fun h => by rw [h, map_zero] at hdPu; exact zero_ne_one hdPu
  have hdQ0 : dQ ≠ 0 := fun h => by rw [h, map_zero] at hdQu; exact zero_ne_one hdQu
  have hιβ : ι β ≠ 0 := (map_ne_zero ι).mpr hβ0
  have hid : P.eval₂ ι η / Q.eval₂ ι η * dQ = ι (α / β) * η ^ i₀ / η ^ j₀ * dP := by
    rw [eP, eQ, map_div₀]
    field_simp
    try ring
  have hm : U.valuation (ι (α / β) * η ^ i₀ / η ^ j₀) ≤ 1 := by
    have h1 := congrArg U.valuation hid
    rw [map_mul, map_mul, hdQu, hdPu, mul_one, mul_one] at h1
    rw [← h1]
    exact (U.valuation_le_one_iff _).mpr hyU
  obtain ⟨h', hh'0, hh'm, hmD⟩ := hmono (α / β) i₀ j₀ hm
  obtain ⟨h₁, hh₁0, hh₁m, hleP, hleQ⟩ := hjoin hP hQh hhP0 hhPm hhQ0 hhQm
  obtain ⟨h₂, hh₂0, hh₂m, hle1, hle'⟩ := hjoin h₁ h' hh₁0 hh₁m hh'0 hh'm
  exact ⟨h₂, ι (α / β) * η ^ i₀ / η ^ j₀ * dP, dQ, hh₂0, hh₂m,
    mul_mem (hle' hmD) (hle1 (hleP hdP)), hle1 (hleQ hdQ), hdQ1, hid⟩

theorem wcpa_dj_lr1k_eb_eg_sbs_ext_separation : ∀ (K L : Type u) [Field K] [Field L]
    [Algebra K L] [FiniteDimensional K L] (R : Subring K) (O : ValuationSubring K),
    O.toSubring = R →
    letI : Algebra ↥R L := ((algebraMap K L).comp R.subtype).toAlgebra
    ∀ V₁ V₂ : ValuationSubring L, V₁.comap (algebraMap K L) = O →
      V₂.comap (algebraMap K L) = O → V₁ ≠ V₂ →
      ∃ w : L, IsIntegral ↥R w ∧
        ((V₁.valuation w < 1 ∧ V₂.valuation w = 1) ∨ (V₂.valuation w < 1 ∧ V₁.valuation w = 1)) :=
by
  intro K L _ _ _ _ R O hOR
  letI : Algebra ↥R L := ((algebraMap K L).comp R.subtype).toAlgebra
  intro V₁ V₂ h₁ h₂ hne
  classical

  have s3 : ∀ w : L, (∀ V : ValuationSubring L, (∀ a : K, a ∈ O → algebraMap K L a ∈ V) →
      w ∈ V) → IsIntegral ↥R w := by
    intro w hw
    let φ : ↥R →+* L := (algebraMap K L).comp R.subtype
    let s : Set L := Set.range φ
    have hcl : IsIntegral (Subring.closure s) w := by
      have hm : w ∈ (integralClosure (↥(Subring.closure s)) L).toSubring := by
        rw [← iInf_valuationSubring_superset, Subring.mem_iInf]
        intro V
        apply hw V.1
        intro a ha
        have hs : s ⊆ ((V.1 : ValuationSubring L) : Set L) := V.2
        apply hs
        have haR : a ∈ R := by rw [← hOR]; exact ha
        exact ⟨⟨a, haR⟩, rfl⟩
      exact hm
    obtain ⟨p, hpm, hp⟩ := hcl
    have hle : Subring.closure s ≤ φ.range := by
      rw [Subring.closure_le]
      rintro _ ⟨r, rfl⟩
      exact ⟨r, rfl⟩
    have hPl : p.map (Subring.closure s).subtype ∈ Polynomial.lifts φ := by
      rw [Polynomial.lifts_iff_coeff_lifts]
      intro n
      rw [Polynomial.coeff_map]
      obtain ⟨r, hr⟩ := hle (p.coeff n).2
      exact ⟨r, hr⟩
    obtain ⟨q, hq, -, hqm⟩ := Polynomial.lifts_and_natDegree_eq_and_monic hPl (hpm.map _)
    refine ⟨q, hqm, ?_⟩
    have : Polynomial.eval₂ φ w q = 0 := by
      rw [Polynomial.eval₂_eq_eval_map, hq, Polynomial.eval_map]
      exact hp
    exact this

  have s8 : ∀ (V : ValuationSubring L), V.comap (algebraMap K L) = O →
      ∀ a : ↥O, (V.valuation (algebraMap K L (a : K)) < 1 ↔
        a ∈ IsLocalRing.maximalIdeal ↥O) := by
    intro V hV a
    have hchar : ∀ {F : Type u} [Field F] (A : ValuationSubring F) (y : F),
        A.valuation y < 1 ↔ y ∈ A ∧ (y = 0 ∨ y⁻¹ ∉ A) := by
      intro F _ A y
      rw [← A.valuation_le_one_iff, ← A.valuation_le_one_iff]
      by_cases hy : y = 0
      · subst hy; simp
      · simp only [hy, false_or, map_inv₀, not_le]
        have h0 : A.valuation y ≠ 0 := by simpa using hy
        constructor
        · intro h
          refine ⟨h.le, ?_⟩
          exact one_lt_inv_iff₀.mpr ⟨zero_lt_iff.mpr h0, h⟩
        · rintro ⟨h1, h2⟩
          exact (one_lt_inv_iff₀.mp h2).2
    have hmem : ∀ x : K, algebraMap K L x ∈ V ↔ x ∈ O := by
      intro x
      rw [← hV, ValuationSubring.mem_comap]
    rw [(ValuationSubring.valuation_lt_one_iff O a), hchar, hchar, ← map_inv₀, hmem, hmem]
    simp
  have hfV : ∀ V : ValuationSubring L, V.comap (algebraMap K L) = O →
      ∀ a : ↥O, algebraMap K L (a : K) ∈ V := by
    intro V hV a
    have : (a : K) ∈ V.comap (algebraMap K L) := by rw [hV]; exact a.2
    exact ValuationSubring.mem_comap.mp this

  have pf : ∀ D : Polynomial K, D ≠ 0 → ∃ (μ : K) (D₁ : Polynomial ↥O), μ ≠ 0 ∧
      (∃ i, IsUnit (D₁.coeff i)) ∧ D = Polynomial.C μ * D₁.map O.subtype := by
    intro D hD0
    have hsupp : D.support.Nonempty := Polynomial.support_nonempty.mpr hD0
    obtain ⟨i₀, hi₀, hmax⟩ :=
      Finset.exists_max_image D.support (fun i => O.valuation (D.coeff i)) hsupp
    set μ := D.coeff i₀ with hμ
    have hμ0 : μ ≠ 0 := Polynomial.mem_support_iff.mp hi₀
    have hcoef : ∀ n, (Polynomial.C μ⁻¹ * D).coeff n ∈ Set.range O.subtype := by
      intro n
      rw [Polynomial.coeff_C_mul]
      refine ⟨⟨μ⁻¹ * D.coeff n, ?_⟩, rfl⟩
      rw [← O.valuation_le_one_iff, map_mul, map_inv₀]
      by_cases hn : n ∈ D.support
      · have hv : O.valuation μ ≠ 0 := by simpa using hμ0
        rw [inv_mul_le_iff₀ (zero_lt_iff.mpr hv), mul_one]
        exact hmax n hn
      · rw [Polynomial.notMem_support_iff.mp hn, map_zero, mul_zero]
        exact zero_le'
    obtain ⟨D₁, hD₁⟩ := (Polynomial.lifts_iff_coeff_lifts _).mpr hcoef
    rw [Polynomial.coe_mapRingHom] at hD₁
    refine ⟨μ, D₁, hμ0, ⟨i₀, ?_⟩, ?_⟩
    · have h1 : (D₁.coeff i₀ : K) = 1 := by
        have := congrArg (fun p => Polynomial.coeff p i₀) hD₁
        simp only [Polynomial.coeff_map, Polynomial.coeff_C_mul] at this
        change (D₁.coeff i₀ : K) = μ⁻¹ * D.coeff i₀ at this
        rw [this, ← hμ, inv_mul_cancel₀ hμ0]
      have h2 : D₁.coeff i₀ = 1 := Subtype.ext h1
      rw [h2]; exact isUnit_one
    · rw [hD₁, ← mul_assoc, ← Polynomial.C_mul, mul_inv_cancel₀ hμ0, Polynomial.C_1, one_mul]

  have s2 : ∀ Va Vb : ValuationSubring L, Va.comap (algebraMap K L) = O →
      Vb.comap (algebraMap K L) = O → ∀ x : L, x ∈ Va → x ∉ Vb →
      ∃ w : L, (∀ V : ValuationSubring L, (∀ a : K, a ∈ O → algebraMap K L a ∈ V) → w ∈ V) ∧
        Va.valuation w < 1 ∧ Vb.valuation w = 1 := by
    intro Va Vb ha hb x hxa hxb
    let f : ↥O →+* L := (algebraMap K L).comp O.subtype
    have hfb : ∀ a, f a ∈ Vb := hfV Vb hb
    have hx0 : x ≠ 0 := fun h => hxb (h ▸ Vb.zero_mem)
    set z := x⁻¹ with hz
    have hxz : x * z = 1 := mul_inv_cancel₀ hx0
    have hzb : Vb.valuation z < 1 := by
      have h1 : 1 < Vb.valuation x := by
        rw [← not_le, Vb.valuation_le_one_iff]; exact hxb
      rw [hz, map_inv₀]
      exact inv_lt_one_of_one_lt₀ h1
    have hxa' : Va.valuation x ≤ 1 := (Va.valuation_le_one_iff _).mpr hxa
    have hzI : IsIntegral K z := Algebra.IsIntegral.isIntegral z
    obtain ⟨μ, D₁, hμ, ⟨i₀, hi₀⟩, hD⟩ :=
      pf (minpoly K z) (minpoly.ne_zero hzI)
    have hD₁ : Polynomial.eval₂ f z D₁ = 0 := by
      have h := minpoly.aeval K z
      rw [hD, map_mul, Polynomial.aeval_C] at h
      have hμ' : algebraMap K L μ ≠ 0 := (map_ne_zero _).mpr hμ
      have h2 := (mul_eq_zero.mp h).resolve_left hμ'
      rw [Polynomial.aeval_def, Polynomial.eval₂_map] at h2
      exact h2
    have hex : ∃ i, IsUnit (D₁.coeff i) := ⟨i₀, hi₀⟩
    set j := Nat.find hex with hj
    have hju : IsUnit (D₁.coeff j) := Nat.find_spec hex
    have hjmin : ∀ i < j, D₁.coeff i ∈ IsLocalRing.maximalIdeal ↥O := fun i hi =>
      (IsLocalRing.mem_maximalIdeal _).mpr (Nat.find_min hex hi)
    set n := D₁.natDegree with hn
    have hjn : j ≤ n := Polynomial.le_natDegree_of_ne_zero hju.ne_zero
    set w : L := ∑ i ∈ Finset.range j, f (D₁.coeff i) * x ^ (j - i) with hw
    set u : L := ∑ i ∈ Finset.Ico (j + 1) (n + 1), f (D₁.coeff i) * z ^ (i - j) with hu
    have hid : w + f (D₁.coeff j) + u = 0 := by
      have h0 : x ^ j * Polynomial.eval₂ f z D₁ = 0 := by rw [hD₁, mul_zero]
      rw [Polynomial.eval₂_eq_sum_range, Finset.mul_sum,
        ← Finset.sum_range_add_sum_Ico _ (show j ≤ n + 1 by omega),
        Finset.sum_eq_sum_Ico_succ_bot (show j < n + 1 by omega)] at h0
      rw [← h0, add_assoc]
      congr 1
      · refine Finset.sum_congr rfl fun i hi => ?_
        have hi' : i < j := Finset.mem_range.mp hi
        have : x ^ j = x ^ (j - i) * x ^ i := by rw [← pow_add]; congr 1; omega
        rw [this, show x ^ (j - i) * x ^ i * (f (D₁.coeff i) * z ^ i) =
          f (D₁.coeff i) * x ^ (j - i) * (x * z) ^ i by rw [mul_pow]; ring, hxz, one_pow,
          mul_one]
      · congr 1
        · rw [show x ^ j * (f (D₁.coeff j) * z ^ j) = f (D₁.coeff j) * (x * z) ^ j by
            rw [mul_pow]; ring, hxz, one_pow, mul_one]
        · refine Finset.sum_congr rfl fun i hi => ?_
          have hi' : j + 1 ≤ i := (Finset.mem_Ico.mp hi).1
          have : z ^ i = z ^ (i - j) * z ^ j := by rw [← pow_add]; congr 1; omega
          rw [this, show x ^ j * (f (D₁.coeff i) * (z ^ (i - j) * z ^ j)) =
            f (D₁.coeff i) * z ^ (i - j) * (x * z) ^ j by rw [mul_pow]; ring, hxz, one_pow,
            mul_one]
    have hwe : w = -(f (D₁.coeff j) + u) := by linear_combination hid
    refine ⟨w, ?_, ?_, ?_⟩
    · intro V hV
      have hfV' : ∀ a : ↥O, f a ∈ V := fun a => hV (a : K) a.2
      rcases V.mem_or_inv_mem x with hxV | hzV
      · rw [hw]
        exact Subring.sum_mem _ fun i _ => V.mul_mem _ _ (hfV' _) (V.pow_mem hxV _)
      · rw [hwe]
        refine V.neg_mem _ (V.add_mem _ _ (hfV' _) ?_)
        rw [hu]
        exact Subring.sum_mem _ fun i _ => V.mul_mem _ _ (hfV' _) (V.pow_mem hzV _)
    · rw [hw]
      refine Valuation.map_sum_lt _ one_ne_zero fun i hi => ?_
      rw [map_mul, map_pow]
      have h1 : Va.valuation (f (D₁.coeff i)) < 1 :=
        (s8 Va ha (D₁.coeff i)).mpr (hjmin i (Finset.mem_range.mp hi))
      exact (mul_le_of_le_one_right' (pow_le_one₀ zero_le' hxa')).trans_lt h1
    · have hu1 : Vb.valuation u < 1 := by
        rw [hu]
        refine Valuation.map_sum_lt _ one_ne_zero fun i hi => ?_
        have hi' : j + 1 ≤ i := (Finset.mem_Ico.mp hi).1
        rw [map_mul, map_pow]
        have h1 : Vb.valuation (f (D₁.coeff i)) ≤ 1 :=
          (Vb.valuation_le_one_iff _).mpr (hfb _)
        have h2 : Vb.valuation z ^ (i - j) < 1 := pow_lt_one₀ zero_le' hzb (by omega)
        exact (mul_le_of_le_one_left' h1).trans_lt h2
      have haj : Vb.valuation (f (D₁.coeff j)) = 1 := by
        have h1 : Vb.valuation (f (D₁.coeff j)) ≤ 1 :=
          (Vb.valuation_le_one_iff _).mpr (hfb _)
        refine le_antisymm h1 (not_lt.mp fun h => ?_)
        have := (s8 Vb hb (D₁.coeff j)).mp h
        exact (IsLocalRing.mem_maximalIdeal _).mp this hju
      rw [hwe, Valuation.map_neg, Valuation.map_add_eq_of_lt_left _ (by rw [haj]; exact hu1),
        haj]

  have hsep : ∃ x : L, (x ∈ V₁ ∧ x ∉ V₂) ∨ (x ∈ V₂ ∧ x ∉ V₁) := by
    by_contra hcon
    push_neg at hcon
    apply hne
    ext x
    exact ⟨fun h => (hcon x).1 h, fun h => (hcon x).2 h⟩
  obtain ⟨x, hx⟩ := hsep
  rcases hx with ⟨hxa, hxb⟩ | ⟨hxa, hxb⟩
  · obtain ⟨w, hwall, hwa, hwb⟩ := s2 V₁ V₂ h₁ h₂ x hxa hxb
    exact ⟨w, s3 w hwall, Or.inl ⟨hwa, hwb⟩⟩
  · obtain ⟨w, hwall, hwa, hwb⟩ := s2 V₂ V₁ h₂ h₁ x hxa hxb
    exact ⟨w, s3 w hwall, Or.inr ⟨hwa, hwb⟩⟩

theorem wcpa_dj_lr1k_eb_eg_sbs_centre_crt : ∀ (K L : Type u) [Field K] [Field L]
    [Algebra K L] (R : Subring K) (O : ValuationSubring K), O.toSubring = R →
    letI : Algebra ↥R L := ((algebraMap K L).comp R.subtype).toAlgebra
    ∀ (n : ℕ) (𝔮 : Fin n → Ideal ↥(integralClosure ↥R L)), (∀ j, (𝔮 j).IsPrime) →
    (∀ j, ∃ V' : ValuationSubring L, V'.comap (algebraMap K L) = O ∧
      ∀ s : ↥(integralClosure ↥R L), s ∈ 𝔮 j ↔ V'.valuation (s : L) < 1) →
    (∀ V' : ValuationSubring L, V'.comap (algebraMap K L) = O →
      ∃ j, ∀ s : ↥(integralClosure ↥R L), s ∈ 𝔮 j ↔ V'.valuation (s : L) < 1) →
    (∀ V₁ V₂ : ValuationSubring L, V₁.comap (algebraMap K L) = O →
      V₂.comap (algebraMap K L) = O → V₁ ≠ V₂ →
      ∃ w : L, IsIntegral ↥R w ∧
        ((V₁.valuation w < 1 ∧ V₂.valuation w = 1) ∨ (V₂.valuation w < 1 ∧ V₁.valuation w = 1))) →
    ∀ U₀ : ValuationSubring L, U₀.comap (algebraMap K L) = O →
    ∃ s₀ : L, IsIntegral ↥R s₀ ∧ U₀.valuation s₀ < 1 ∧
      ∀ U'' : ValuationSubring L, U''.comap (algebraMap K L) = O → U'' ≠ U₀ →
