    let γ0 : (R ⧸ (I₀ ⊔ q ^ n)) →+* (P ⧸ (K ⊔ 𝔪 ^ n)) :=
      Ideal.Quotient.lift (I₀ ⊔ q ^ n) ((Ideal.Quotient.mk (K ⊔ 𝔪 ^ n)).comp g) hfw
    have hγ0 : ∀ a, γ0 (Ideal.Quotient.mk (I₀ ⊔ q ^ n) a) = Ideal.Quotient.mk (K ⊔ 𝔪 ^ n) (g a) :=
