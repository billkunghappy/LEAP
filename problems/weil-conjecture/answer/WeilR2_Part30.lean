      x = Polynomial.eval₂ ((algebraMap (RatFunc Ω) L).comp (algebraMap Ω (RatFunc Ω))) (η b) p /
        Polynomial.eval₂ ((algebraMap (RatFunc Ω) L).comp (algebraMap Ω (RatFunc Ω))) (η b) q := by
    intro x hx
