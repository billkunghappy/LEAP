    rw [Polynomial.eval_sub, Polynomial.eval_C, Polynomial.eval_mul, Polynomial.eval_X, h4,
      Polynomial.coeff_zero_reverse, hPm.leadingCoeff] at h5
    exact isUnit_iff_exists_inv.mpr ⟨-(Q.eval r), by linear_combination h5⟩
  set τ := algebraMap V B t with hτ
  have hKF : ∀ (e : ℕ) (w : B), 1 ≤ e → IsIntegral V w → τ ^ e * w = 1 → False := by
    intro e w he hw h
    rw [hτ, ← map_pow] at h
    have := KF _ w hw h
    exact htnu ((isUnit_pow_iff (by omega)).mp this)
  have hτu : IsUnit τ := hunit
  obtain ⟨u, hu⟩ := hunit
  have hcancel : ∀ (P a : ℕ) (w : B), IsIntegral V w → τ ^ P = τ ^ a * w → a ≤ P := by
    intro P a w hw h
    by_contra hlt
    push_neg at hlt
    obtain ⟨e, rfl⟩ := Nat.exists_eq_add_of_lt hlt
    apply hKF (e + 1) w (by omega) hw
    have h2 : τ ^ P * (τ ^ (e + 1) * w) = τ ^ P * 1 := by
      calc τ ^ P * (τ ^ (e + 1) * w) = τ ^ (P + e + 1) * w := by ring
        _ = τ ^ P := h.symm
        _ = τ ^ P * 1 := (mul_one _).symm
    exact (hτu.pow P).mul_left_cancel h2
  let Q : B → Set ℝ := fun x => {q : ℝ | ∃ (m k n : ℕ) (y : B), 0 < n ∧
    IsIntegral V y ∧ τ ^ k * x ^ n = τ ^ m * y ∧ q = ((m : ℝ) - (k : ℝ)) / (n : ℝ)}

  have pin : ∀ (x : B) (N k j c : ℕ) (y z : B), 1 ≤ N → IsIntegral V y → IsIntegral V z →
      τ ^ k * x ^ N = τ ^ j * y → τ ^ k * x ^ N * z = τ ^ (j + c) →
      ((j : ℝ) - k) / N ≤ sSup (Q x) ∧ sSup (Q x) ≤ ((j : ℝ) + c - k) / N := by
    intro x N k j c y z hN hy hz hlow hup
    have hNpos : (0 : ℝ) < N := by exact_mod_cast hN
    have hub : ∀ q ∈ Q x, q ≤ ((j : ℝ) + c - k) / N := by
      rintro q ⟨m, k₀, n, y₀, hn, hy₀, hw, rfl⟩
      have hle : m * N + k * n ≤ k₀ * N + (j + c) * n := by
        apply hcancel _ _ (y₀ ^ N * z ^ n) ((hy₀.pow N).mul (hz.pow n))
        calc τ ^ (k₀ * N + (j + c) * n) = (τ ^ k₀) ^ N * (τ ^ (j + c)) ^ n := by ring
          _ = (τ ^ k₀) ^ N * (τ ^ k * x ^ N * z) ^ n := by rw [hup]
          _ = (τ ^ k₀ * x ^ n) ^ N * (τ ^ k) ^ n * z ^ n := by ring
          _ = (τ ^ m * y₀) ^ N * (τ ^ k) ^ n * z ^ n := by rw [hw]
          _ = τ ^ (m * N + k * n) * (y₀ ^ N * z ^ n) := by ring
      have hnpos : (0 : ℝ) < n := by exact_mod_cast hn
