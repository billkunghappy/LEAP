      have h1 := minpoly.isIntegrallyClosed_eq_field_fractions' K hm₀
      have h0 : Polynomial.aeval (algebraMap V L (m₀ : V) * α)
          (minpoly K (algebraMap V L (m₀ : V) * α)) = 0 := minpoly.aeval K _
      have h2 := Polynomial.Separable.aeval_derivative_ne_zero hsep h0
      rw [h1, Polynomial.derivative_map, Polynomial.aeval_map_algebraMap,
        Polynomial.aeval_def] at h2
