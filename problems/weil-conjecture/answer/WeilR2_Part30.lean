    Algebra.IsSeparable.of_equiv_equiv e₁ (RingEquiv.refl L) (RingHom.ext fun x => rfl)⟩

theorem wcpa_dj_lr1k_eb_eg_sep_cond_branch : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
