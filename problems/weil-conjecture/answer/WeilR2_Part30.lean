    haveI : IsPrincipalIdealRing (Algebra.adjoin F {t}) :=
      IsPrincipalIdealRing.of_surjective
        (Polynomial.algEquivOfTranscendental F t ht).toRingEquiv.toRingHom
        (Polynomial.algEquivOfTranscendental F t ht).surjective
    haveI : IsDedekindDomain (Algebra.adjoin F {t}) :=
      IsPrincipalIdealRing.isDedekindDomain _
    haveI : IsScalarTower (Algebra.adjoin F {t}) (IntermediateField.adjoin F {t}) K :=
      IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    haveI hD : IsDedekindDomain (integralClosure (Algebra.adjoin F {t}) K) :=
      integralClosure.isDedekindDomain (Algebra.adjoin F {t}) (IntermediateField.adjoin F {t}) K
    haveI hF : IsFractionRing (integralClosure (Algebra.adjoin F {t}) K) K :=
      IsIntegralClosure.isFractionRing_of_finite_extension (Algebra.adjoin F {t})
        (IntermediateField.adjoin F {t}) K (integralClosure (Algebra.adjoin F {t}) K)
    refine ⟨(integralClosure (Algebra.adjoin F {t}) K).restrictScalars E, hD, hF, ?_⟩
    intro y
    rfl

  have s5 : ∀ (F K : Type u) [Field F] [Field K] [Algebra F K] (t c : K), Transcendental F t → c ∈ Algebra.adjoin F {t} → c ∈ Algebra.adjoin F {t⁻¹} → c ∈ Set.range (algebraMap F K) := by
    intro F K _ _ _ t c ht hc1 hc2
    have ht0 : t ≠ 0 := ht.ne_zero
    rw [Algebra.adjoin_singleton_eq_range_aeval] at hc1 hc2
    obtain ⟨P, rfl⟩ := hc1
    obtain ⟨Q, hQ⟩ := hc2
    set m := Q.natDegree
    letI : Invertible t⁻¹ := invertibleOfNonzero (inv_ne_zero ht0)
    have hrefl : Polynomial.eval₂ (algebraMap F K) t (Polynomial.reflect m Q) * t⁻¹ ^ m =
        Polynomial.eval₂ (algebraMap F K) t⁻¹ Q := by
      have := Polynomial.eval₂_reflect_mul_pow (algebraMap F K) t⁻¹ m Q le_rfl
      rwa [invOf_eq_inv, inv_inv] at this
    have hid : Polynomial.aeval t (Polynomial.X ^ m * P - Polynomial.reflect m Q) = 0 := by
      have e1 : (Polynomial.aeval t⁻¹ Q : K) = Polynomial.aeval t P := hQ
      simp only [Polynomial.aeval_def] at e1 ⊢
      rw [Polynomial.eval₂_sub, Polynomial.eval₂_mul, Polynomial.eval₂_X_pow, ← e1, ← hrefl]
      rw [mul_comm (Polynomial.eval₂ _ t _) _, ← mul_assoc, ← mul_pow, mul_inv_cancel₀ ht0, one_pow,
        one_mul, sub_self]
    have hinj := (transcendental_iff_injective).mp ht
    have heq : Polynomial.X ^ m * P = Polynomial.reflect m Q := by
      have : Polynomial.aeval t (Polynomial.X ^ m * P - Polynomial.reflect m Q) =
          Polynomial.aeval t (0 : Polynomial F) := by rw [hid, map_zero]
      exact sub_eq_zero.mp (hinj this)
    by_cases hP : P = 0
    · exact ⟨0, by rw [hP, map_zero, map_zero]⟩
    · have hdeg : (Polynomial.X ^ m * P).natDegree = P.natDegree + m := by
        rw [Polynomial.natDegree_mul (pow_ne_zero _ Polynomial.X_ne_zero) hP,
          Polynomial.natDegree_X_pow, add_comm]
      have hle : (Polynomial.reflect m Q).natDegree ≤ max m Q.natDegree :=
        Polynomial.natDegree_reflect_le
      rw [← heq, hdeg, max_self] at hle
      have hP0 : P.natDegree = 0 := by omega
      refine ⟨P.coeff 0, ?_⟩
      rw [Polynomial.eq_C_of_natDegree_eq_zero hP0]
      simp

  have s6 : ∀ (F K : Type u) [Field F] [Field K] [Algebra F K] (t y : K), Transcendental F t → Transcendental F t⁻¹ → _root_.IsIntegral ↥(Algebra.adjoin F {t}) y → _root_.IsIntegral ↥(Algebra.adjoin F {t⁻¹}) y → ∃ q : Polynomial K, q.Monic ∧ q.eval y = 0 ∧ ∀ k : ℕ, q.coeff k ∈ Algebra.adjoin F {t} ∧ q.coeff k ∈ Algebra.adjoin F {t⁻¹} := by
    intro F K _ _ _ t y ht hti h1 h2
    have gen : ∀ s : K, Transcendental F s → _root_.IsIntegral (Algebra.adjoin F {s}) y →
        (minpoly (IntermediateField.adjoin F {s}) y).map
            (algebraMap (IntermediateField.adjoin F {s}) K) =
          (minpoly (Algebra.adjoin F {s}) y).map (algebraMap (Algebra.adjoin F {s}) K) := by
      intro s hs hy
      letI : Algebra (Algebra.adjoin F {s}) (IntermediateField.adjoin F {s}) :=
        IntermediateField.algebraAdjoinAdjoin.instAlgebraSubtypeMemSubalgebraAdjoinAdjoin F {s}
      haveI : IsFractionRing (Algebra.adjoin F {s}) (IntermediateField.adjoin F {s}) :=
        IntermediateField.algebraAdjoinAdjoin.instIsFractionRingSubtypeMemSubalgebraAdjoinAdjoin F {s}
      haveI : IsIntegrallyClosed (Algebra.adjoin F {s}) :=
        IsIntegrallyClosed.of_equiv (Polynomial.algEquivOfTranscendental F s hs).toRingEquiv
      haveI : IsScalarTower (Algebra.adjoin F {s}) (IntermediateField.adjoin F {s}) K :=
        IsScalarTower.of_algebraMap_eq (fun _ => rfl)
      rw [minpoly.isIntegrallyClosed_eq_field_fractions' (IntermediateField.adjoin F {s}) hy,
        Polynomial.map_map]
      rfl
    have heq : IntermediateField.adjoin F {t⁻¹} = IntermediateField.adjoin F {t} := by
      apply le_antisymm
      · rw [IntermediateField.adjoin_simple_le_iff]
        exact inv_mem (IntermediateField.mem_adjoin_simple_self F t)
      · rw [IntermediateField.adjoin_simple_le_iff]
        have := inv_mem (IntermediateField.mem_adjoin_simple_self F t⁻¹)
        rwa [inv_inv] at this
    have hL : ∀ L₁ L₂ : IntermediateField F K, L₁ = L₂ →
        (minpoly L₁ y).map (algebraMap L₁ K) = (minpoly L₂ y).map (algebraMap L₂ K) := by
      rintro _ _ rfl; rfl
    have hq : (minpoly (Algebra.adjoin F {t}) y).map (algebraMap (Algebra.adjoin F {t}) K) =
        (minpoly (Algebra.adjoin F {t⁻¹}) y).map (algebraMap (Algebra.adjoin F {t⁻¹}) K) := by
      rw [← gen t ht h1, ← gen t⁻¹ hti h2, hL _ _ heq]
    refine ⟨(minpoly (Algebra.adjoin F {t}) y).map (algebraMap (Algebra.adjoin F {t}) K),
      (minpoly.monic h1).map _, ?_, ?_⟩
    · rw [Polynomial.eval_map, ← Polynomial.aeval_def, minpoly.aeval]
    · intro k
      refine ⟨?_, ?_⟩
      · rw [Polynomial.coeff_map]
        exact ((minpoly (Algebra.adjoin F {t}) y).coeff k).2
      · rw [hq, Polynomial.coeff_map]
        exact ((minpoly (Algebra.adjoin F {t⁻¹}) y).coeff k).2

  have s7 : ∀ (E K : Type u) [Field E] [Field K] [Algebra E K] (d : ℕ) (x : Fin d → K), AlgebraicIndependent E x → Algebra.IsAlgebraic ↥(IntermediateField.adjoin E (Set.range x)) K → ∀ y : K, (∀ i : Fin d, IsAlgebraic ↥(IntermediateField.adjoin E (x '' {i}ᶜ)) y) → IsAlgebraic E y := by
    intro E K _ _ _ d x hind halg y hy
    set M := AlgebraicIndependent.matroid E K with hM
    have hcl : ∀ s : Set K, y ∈ M.closure s ↔ IsAlgebraic (Algebra.adjoin E s) y := by
      intro s
      rw [hM, AlgebraicIndependent.matroid_closure_eq]
      exact Subalgebra.mem_algebraicClosure _ _
    have hinj : Function.Injective x := hind.injective
    have hX : M.Indep (Set.range x) := by
      rw [hM, AlgebraicIndependent.matroid_indep_iff]
      exact hind.to_subtype_range
    have key : ∀ T : Finset (Fin d), y ∈ M.closure (x '' ((T : Set (Fin d))ᶜ)) := by
      intro T
      induction T using Finset.induction_on with
      | empty =>
        rw [Finset.coe_empty, Set.compl_empty, Set.image_univ, hcl,
          ← IntermediateField.isAlgebraic_adjoin_iff]
        exact halg.isAlgebraic y
      | insert i T _ ih =>
        have hi : y ∈ M.closure (x '' {i}ᶜ) := by
          rw [hcl, ← IntermediateField.isAlgebraic_adjoin_iff]
          exact hy i
        have hset : x '' ((↑(insert i T) : Set (Fin d))ᶜ) =
            x '' ((T : Set (Fin d))ᶜ) ∩ x '' {i}ᶜ := by
          rw [← Set.image_inter hinj]
          congr 1
          ext j
          simp [not_or, and_comm]
        rw [hset, Matroid.Indep.closure_inter_eq_inter_closure]
        · exact ⟨ih, hi⟩
        · exact hX.subset (Set.union_subset (Set.image_subset_range _ _)
            (Set.image_subset_range _ _))
    have h := key Finset.univ
    rw [Finset.coe_univ, Set.compl_univ, Set.image_empty, hcl, Algebra.adjoin_empty] at h
    exact (Subalgebra.isAlgebraic_bot_iff (algebraMap E K).injective).mp h

  have s8 : ∀ (E K : Type u) [Field E] [Field K] [Algebra E K] (ι : Type) [Fintype ι] (O : ι → Subalgebra E K), (∀ j, IsDedekindDomain ↥(O j)) → (∀ j, IsFractionRing ↥(O j) K) → ∃ N : K → ℕ, (∀ a b : K, N (a + b) ≤ max (N a) (N b)) ∧ (∀ (c : E) (a : K), N (algebraMap E K c * a) ≤ N a) ∧ (∀ (a : K) (n : ℕ), N (a ^ n) = n * N a) ∧ ∀ a : K, N a = 0 → ∀ j, a ∈ O j := by
    intro E K _ _ _ ι _ O hD hF
    let g : WithZero (Multiplicative ℤ) → ℕ := fun x => (WithZero.log x).toNat
    have gmono : ∀ x y, x ≤ y → g x ≤ g y := by
      intro x y hxy
      by_cases hx : x = 0
      · simp [g, hx, WithZero.log_zero]
      · have hy : y ≠ 0 := by
          intro h; rw [h] at hxy; exact hx (le_antisymm hxy zero_le')
        exact Int.toNat_le_toNat ((WithZero.log_le_log hx hy).mpr hxy)
    have gpow : ∀ x (n : ℕ), g (x ^ n) = n * g x := by
      intro x n
      simp only [g, WithZero.log_pow, nsmul_eq_mul]
      generalize WithZero.log x = k
      rcases le_or_gt 0 k with h | h
      · apply Int.ofNat_inj.mp
        rw [Int.toNat_of_nonneg (mul_nonneg (Int.natCast_nonneg n) h)]
        push_cast
        rw [Int.toNat_of_nonneg h]
      · rw [Int.toNat_eq_zero.mpr (mul_nonpos_of_nonneg_of_nonpos (Int.natCast_nonneg n) h.le),
          Int.toNat_eq_zero.mpr h.le, mul_zero]
    let nj : (j : ι) → K → ℕ := fun j a =>
      (IsDedekindDomain.HeightOneSpectrum.Support.finite (O j) a).toFinset.sup
        (fun v => g (IsDedekindDomain.HeightOneSpectrum.valuation K v a))
    have hle : ∀ j a (v : IsDedekindDomain.HeightOneSpectrum (O j)),
        g (IsDedekindDomain.HeightOneSpectrum.valuation K v a) ≤ nj j a := by
      intro j a v
      by_cases hv : v ∈ IsDedekindDomain.HeightOneSpectrum.Support (O j) a
      · exact Finset.le_sup (f := fun v => g (IsDedekindDomain.HeightOneSpectrum.valuation K v a))
          ((Set.Finite.mem_toFinset _).mpr hv)
      · have h1 : IsDedekindDomain.HeightOneSpectrum.valuation K v a ≤ 1 := by
          by_contra h
          exact hv (not_le.mp h)
        have h2 : g (IsDedekindDomain.HeightOneSpectrum.valuation K v a) = 0 := by
          have := gmono _ _ h1
          simp only [g, WithZero.log_one, Int.toNat_zero] at this ⊢
          omega
        omega
    have hnj_le : ∀ j a m, (∀ v : IsDedekindDomain.HeightOneSpectrum (O j),
        g (IsDedekindDomain.HeightOneSpectrum.valuation K v a) ≤ m) → nj j a ≤ m :=
      fun j a m h => Finset.sup_le (fun v _ => h v)
    let N : K → ℕ := fun a => Finset.univ.sup (fun j => nj j a)
    have hNle : ∀ j a (v : IsDedekindDomain.HeightOneSpectrum (O j)),
        g (IsDedekindDomain.HeightOneSpectrum.valuation K v a) ≤ N a :=
      fun j a v => (hle j a v).trans (Finset.le_sup (f := fun j => nj j a) (Finset.mem_univ j))
    have hN_le : ∀ a m, (∀ j (v : IsDedekindDomain.HeightOneSpectrum (O j)),
        g (IsDedekindDomain.HeightOneSpectrum.valuation K v a) ≤ m) → N a ≤ m :=
      fun a m h => Finset.sup_le (fun j _ => hnj_le j a m (h j))
    refine ⟨N, ?_, ?_, ?_, ?_⟩
    · intro a b
      apply hN_le
      intro j v
      calc g (IsDedekindDomain.HeightOneSpectrum.valuation K v (a + b))
          ≤ g (max (IsDedekindDomain.HeightOneSpectrum.valuation K v a)
              (IsDedekindDomain.HeightOneSpectrum.valuation K v b)) :=
            gmono _ _ (Valuation.map_add _ _ _)
        _ ≤ max (N a) (N b) := by
          rcases le_total (IsDedekindDomain.HeightOneSpectrum.valuation K v a)
            (IsDedekindDomain.HeightOneSpectrum.valuation K v b) with h | h
          · rw [max_eq_right h]; exact (hNle j b v).trans (le_max_right _ _)
          · rw [max_eq_left h]; exact (hNle j a v).trans (le_max_left _ _)
    · intro c a
      apply hN_le
      intro j v
      have hc : IsDedekindDomain.HeightOneSpectrum.valuation K v (algebraMap E K c) ≤ 1 :=
        IsDedekindDomain.HeightOneSpectrum.valuation_le_one (K := K) v (algebraMap E (O j) c)
      calc g (IsDedekindDomain.HeightOneSpectrum.valuation K v (algebraMap E K c * a))
          ≤ g (IsDedekindDomain.HeightOneSpectrum.valuation K v a) := by
            apply gmono
            rw [Valuation.map_mul]
            exact mul_le_of_le_one_left' hc
        _ ≤ N a := hNle j a v
    · intro a n
      apply le_antisymm
      · apply hN_le
        intro j v
        rw [Valuation.map_pow, gpow]
        exact Nat.mul_le_mul_left n (hNle j a v)
      · rcases Nat.eq_zero_or_pos n with hn | hn
        · subst hn; simp
        · have h1 : N a ≤ N (a ^ n) / n := by
            apply hN_le
            intro j v
            rw [Nat.le_div_iff_mul_le hn]
            have := hNle j (a ^ n) v
            rw [Valuation.map_pow, gpow] at this
            rw [mul_comm]
            exact this
          calc n * N a ≤ n * (N (a ^ n) / n) := Nat.mul_le_mul_left n h1
            _ ≤ N (a ^ n) := Nat.mul_div_le _ _
    · intro a ha j
      have h1 : ∀ v : IsDedekindDomain.HeightOneSpectrum (O j),
          IsDedekindDomain.HeightOneSpectrum.valuation K v a ≤ 1 := by
        intro v
        by_contra hlt
        rw [not_le] at hlt
        have hne : IsDedekindDomain.HeightOneSpectrum.valuation K v a ≠ 0 :=
          ne_of_gt (lt_trans zero_lt_one hlt)
        have h2 : WithZero.log (1 : WithZero (Multiplicative ℤ)) <
            WithZero.log (IsDedekindDomain.HeightOneSpectrum.valuation K v a) :=
          (WithZero.log_lt_log one_ne_zero hne).mpr hlt
        rw [WithZero.log_one] at h2
        have h3 := hNle j a v
        rw [ha] at h3
        simp only [g] at h3
        omega
      obtain ⟨y, hy⟩ := IsDedekindDomain.HeightOneSpectrum.mem_integers_of_valuation_le_one K a h1
      rw [← hy]
      exact y.2

  have s9 : ∀ (E K : Type u) [Field E] [Field K] [Algebra E K], (ringChar E).Prime → (∀ x : E, ∃ y : E, y ^ ringChar E = x) → ∀ N : K → ℕ, (∀ a b : K, N (a + b) ≤ max (N a) (N b)) → (∀ (c : E) (a : K), N (algebraMap E K c * a) ≤ N a) → (∀ a : K, N (a ^ ringChar E) = ringChar E * N a) → ∃ U : Set K, (∀ (μ : ↥U →₀ E) (y : K), (μ.sum fun j c => algebraMap E K c * (j : K)) = y ^ ringChar E → μ = 0) ∧ ∀ f : K, ∃ f₀ ∈ Submodule.span E U, ∃ g : K, f = f₀ + g ^ ringChar E ∧ ringChar E * N g ≤ N f := by
    intro E K _ _ _ hp hperf N hN1 hN2 hN3
    set p := ringChar E with hpdef
    haveI : Fact p.Prime := ⟨hp⟩
    haveI : CharP E p := ringChar.charP E
    haveI : CharP K p := charP_of_injective_algebraMap (algebraMap E K).injective p
    have hN0 : N 0 = 0 := by
      have h := hN3 0
      rw [zero_pow hp.ne_zero] at h
      have := hp.two_le
      nlinarith
    let Kp : Submodule E K :=
      { carrier := {x | ∃ y : K, y ^ p = x}
        add_mem' := by
          rintro _ _ ⟨a, rfl⟩ ⟨b, rfl⟩
          exact ⟨a + b, add_pow_char a b p⟩
        zero_mem' := ⟨0, zero_pow hp.ne_zero⟩
        smul_mem' := by
          rintro c _ ⟨a, rfl⟩
          obtain ⟨d, hd⟩ := hperf c
          exact ⟨algebraMap E K d * a, by rw [mul_pow, ← map_pow, hd, Algebra.smul_def]⟩ }
    have hKp : ∀ x, x ∈ Kp ↔ ∃ y : K, y ^ p = x := fun x => Iff.rfl
    let W : ℕ → Submodule E K := fun n =>
      { carrier := {f | N f ≤ n}
        add_mem' := fun {a b} ha hb => (hN1 a b).trans (max_le ha hb)
        zero_mem' := by simp [hN0]
        smul_mem' := fun c a ha => by
          show N (c • a) ≤ n
          rw [Algebra.smul_def]
          exact (hN2 c a).trans ha }
    have hW : ∀ n f, f ∈ W n ↔ N f ≤ n := fun n f => Iff.rfl
    have hWmono : ∀ n, (W n : Set K) ⊆ W (n + 1) := fun n f hf => by
      rw [SetLike.mem_coe, hW] at hf ⊢; omega
    let π := Kp.mkQ
    let Pr : ℕ → Set K → Prop := fun n s => s ⊆ W n ∧ LinearIndepOn E π s ∧
      π '' (W n : Set K) ⊆ Submodule.span E (π '' s)
    have step : ∀ n (s : Set K), s ⊆ W n → LinearIndepOn E π s → ∃ b, Pr n b ∧ s ⊆ b := by
      intro n s hs hli
      obtain ⟨b, hbt, hsb, hspan, hbli⟩ := exists_linearIndepOn_extension hli hs
      exact ⟨b, ⟨hbt, hbli, hspan⟩, hsb⟩
    have base : ∃ b, Pr 0 b := by
      obtain ⟨b, hb, -⟩ := step 0 ∅ (Set.empty_subset _) (linearIndepOn_empty E π)
      exact ⟨b, hb⟩
    have succ : ∀ n (s : {s // Pr n s}), ∃ b, Pr (n + 1) b ∧ s.1 ⊆ b := fun n s =>
      step (n + 1) s.1 (s.2.1.trans (hWmono n)) s.2.2.1
    let seq : (n : ℕ) → {s // Pr n s} := fun n =>
      Nat.rec ⟨base.choose, base.choose_spec⟩
        (fun n s => ⟨(succ n s).choose, (succ n s).choose_spec.1⟩) n
    have hseq_succ : ∀ n, (seq n).1 ⊆ (seq (n + 1)).1 := fun n => (succ n (seq n)).choose_spec.2
    have hmono : Monotone (fun n => (seq n).1) := monotone_nat_of_le_succ hseq_succ
    set U := ⋃ n, (seq n).1 with hU
    have hUli : LinearIndepOn E π U := linearIndepOn_iUnion_of_directed hmono.directed_le
      (fun n => (seq n).2.2.1)
    refine ⟨U, ?_, ?_⟩
    · intro μ y hμ
      have hli : LinearIndependent E (fun x : ↥U => π x) := hUli
      rw [linearIndependent_iff] at hli
      apply hli
      rw [Finsupp.linearCombination_apply]
      have : (μ.sum fun i a => a • π (i : K)) =
          π (μ.sum fun j c => algebraMap E K c * (j : K)) := by
        rw [map_finsuppSum]
        refine Finsupp.sum_congr (fun j _ => ?_)
        rw [← Algebra.smul_def, map_smul]
      rw [this, hμ]
      show Submodule.Quotient.mk _ = 0
      rw [Submodule.Quotient.mk_eq_zero, hKp]
      exact ⟨y, rfl⟩
    · intro f
      set n := N f
      have hfW : f ∈ W n := (hW n f).mpr le_rfl
      have h1 : π f ∈ Submodule.span E (π '' (seq n).1) := (seq n).2.2.2 ⟨f, hfW, rfl⟩
      rw [Submodule.span_image, Submodule.mem_map] at h1
      obtain ⟨f₀, hf₀, hπ⟩ := h1
      have hf₀U : f₀ ∈ Submodule.span E U :=
        Submodule.span_mono (Set.subset_iUnion (fun n => (seq n).1) n) hf₀
      have hf₀W : f₀ ∈ W n := by
        have : Submodule.span E (seq n).1 ≤ W n := Submodule.span_le.mpr (seq n).2.1
        exact this hf₀
      have hdiff : f - f₀ ∈ Kp := by
        rw [← Submodule.Quotient.mk_eq_zero, Submodule.Quotient.mk_sub]
        show π f - π f₀ = 0
        rw [hπ, sub_self]
      obtain ⟨g, hg⟩ := (hKp _).mp hdiff
      refine ⟨f₀, hf₀U, g, ?_, ?_⟩
      · rw [hg]; ring
      · rw [← hN3, hg]
        exact (hW n _).mp ((W n).sub_mem hfW hf₀W)

  have s10 : ∀ (E K : Type u) [Field E] [Field K] [Algebra E K], (ringChar E).Prime → ∀ (N : K → ℕ), (∀ a : K, N a = 0 → a ∈ Set.range (algebraMap E K)) → ∀ U : Set K, (∀ f : K, ∃ f₀ ∈ Submodule.span E U, ∃ g : K, f = f₀ + g ^ ringChar E ∧ ringChar E * N g ≤ N f) → Submodule.span E (Set.range (fun o : Option (ℕ × ↥U) => o.elim 1 (fun q => (q.2 : K) ^ (ringChar E ^ q.1)))) = ⊤ := by
    intro E K _ _ _ hp N hN4 U hR
    set p := ringChar E with hpdef
    haveI : Fact p.Prime := ⟨hp⟩
    haveI : CharP E p := ringChar.charP E
    haveI : CharP K p := charP_of_injective_algebraMap (algebraMap E K).injective p
    set T := Submodule.span E (Set.range (fun o : Option (ℕ × ↥U) =>
      o.elim 1 (fun q => (q.2 : K) ^ (p ^ q.1)))) with hT
    have h1 : (1 : K) ∈ T := Submodule.subset_span ⟨none, rfl⟩
    have hU : Submodule.span E U ≤ T := by
      rw [Submodule.span_le]
      intro u hu
      refine Submodule.subset_span ⟨some (0, ⟨u, hu⟩), ?_⟩
      simp
    have hfrob : ∀ z ∈ T, z ^ p ∈ T := by
