  intro Ω _ _ W hdim hW L _ _ _ _ hdef hGS m U e η u hMoBD b t h1 h2 h3
  obtain ⟨ι, hι⟩ : ∃ ι : Ω →+* L, ι = (algebraMap (RatFunc Ω) L).comp (algebraMap Ω (RatFunc Ω)) :=
    ⟨_, rfl⟩
  have hιapp : ∀ w : Ω, ι w = algebraMap (RatFunc Ω) L (algebraMap Ω (RatFunc Ω) w) := by
    intro w; rw [hι]; rfl

  have hval1 : ∀ {K : Type u} [Field K] (R : ValuationSubring K) (x y : K), x ∈ R → y ∈ R →
