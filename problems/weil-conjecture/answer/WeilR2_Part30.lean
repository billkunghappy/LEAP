    haveI : IsScalarTower ↥W Γ(X, U) Γ(Ct, (φ ≫ ι) ⁻¹ᵁ U) :=
      IsScalarTower.of_algebraMap_eq (fun w => (h3 w).symm)
    have hB : _root_.IsReduced Γ(Ct, (φ ≫ ι) ⁻¹ᵁ U) := inferInstance
    have key := wcpa_dj_lr1s_nf_ring_reduction Ω W hW Γ(X, U) Γ(Ct, (φ ≫ ι) ⁻¹ᵁ U) h1 h2 hB
