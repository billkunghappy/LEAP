    simp

  haveI : Module.Finite ↥O.toSubring ↥(integralClosure ↥O.toSubring L) :=
    Module.finite_of_finrank_pos (by rw [hrank]; omega)
  let β := Module.finBasisOfFinrankEq ↥O.toSubring ↥(integralClosure ↥O.toSubring L) hrank
  choose a haO hav using fun t => hspan (β t : L) (fun j => hB j (β t))

  have hnli : ¬ LinearIndependent K (fun t => a t) := by
    intro hli
    have h := hli.fintype_card_le_finrank
