  intro n x y hxy
  cases n with
  | zero => exact @Subsingleton.elim _ hT0 _ _
  | succ k =>
    change ((γ (k + 1)).trans (γ' (k + 1)).symm) (Ideal.Quotient.mk _ x) =
      Ideal.Quotient.mk _ y at hxy
    change ((γ k).trans (γ' k).symm) (Ideal.Quotient.mk _ x) = Ideal.Quotient.mk _ y
    rw [RingEquiv.trans_apply, RingEquiv.symm_apply_eq, hγ, hγ', Ideal.Quotient.eq] at hxy
    rw [RingEquiv.trans_apply, RingEquiv.symm_apply_eq, hγ, hγ', Ideal.Quotient.eq]
