      σ₀ e₀ hσ₀u (c + b₀) (by rw [add_sub_cancel_right]; exact hc)
    have hσx : σ (IsLocalRing.closedPoint ↥W) = wcpaDjLkImg W (γ ≫ ι) uX y₀ := hσs.trans hσ₀x'
    refine ⟨σ, hσu, hσx, ?_⟩
    rw [hτ σ (hthrough σ hσx)]
    exact sub_eq_iff_eq_add.mpr hθ
