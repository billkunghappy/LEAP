      (by
        calc τ ^ (k₁ + k₂) * (x * y) ^ N = (τ ^ k₁ * x ^ N) * (τ ^ k₂ * y ^ N) := by ring
          _ = τ ^ (j₁ + j₂) * (y₁ * y₂) := by rw [hl₁, hl₂]; ring)
      (by
        calc τ ^ (k₁ + k₂) * (x * y) ^ N * (z₁ * z₂)
            = (τ ^ k₁ * x ^ N * z₁) * (τ ^ k₂ * y ^ N * z₂) := by ring
          _ = τ ^ (j₁ + j₂ + 2) := by rw [hu₁, hu₂]; ring)
    have hNpos : (0 : ℝ) < N := by exact_mod_cast hN
    rw [div_le_iff₀ hNpos] at a1 b1 c1
    rw [le_div_iff₀ hNpos] at a2 b2 c2
    push_cast at a1 a2 b1 b2 c1 c2
    rw [show |sSup (Q (x * y)) - sSup (Q x) - sSup (Q y)| * (N : ℝ)
        = |(sSup (Q (x * y)) - sSup (Q x) - sSup (Q y)) * N| by
      rw [abs_mul, abs_of_pos hNpos]]
    exact abs_le.mpr ⟨by linarith, by linarith⟩
  suffices hD : sSup (Q (x * y)) - sSup (Q x) - sSup (Q y) = 0 by linarith
  by_contra hD0
  have hpos : 0 < |sSup (Q (x * y)) - sSup (Q x) - sSup (Q y)| := abs_pos.mpr hD0
  obtain ⟨N, hN⟩ := exists_nat_gt (2 / |sSup (Q (x * y)) - sSup (Q x) - sSup (Q y)|)
