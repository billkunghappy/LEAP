  have s_residue : ∀ (V R D : Type u) [CommRing V] [IsLocalRing V] [IsAlgClosed (IsLocalRing.ResidueField V)] [CommRing R] [CommRing D] [Algebra R D] [Algebra.IsIntegral R D] (j : V →+* R) (𝔮 : Ideal D) [𝔮.IsPrime], (∀ c ∈ IsLocalRing.maximalIdeal V, algebraMap R D (j c) ∈ 𝔮) → (∀ r : R, ∃ c : V, algebraMap R D r - algebraMap R D (j c) ∈ 𝔮) → ∀ z : Localization.AtPrime 𝔮, ∃ c : V, z - algebraMap D (Localization.AtPrime 𝔮) (algebraMap R D (j c)) ∈ IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) := by
