    rw [← hPeq] at hcm
    obtain ⟨k, hk⟩ := (hPmem _).mp hcm
    refine ⟨k + 1, ?_⟩
    calc W.valuation c ^ (k + 1) = W.valuation c ^ k * W.valuation c := pow_succ _ _
