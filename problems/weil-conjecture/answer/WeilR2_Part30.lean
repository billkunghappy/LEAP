          (v' * algebraMap V B c₂) * hxc
      · obtain ⟨z, hxz, hint⟩ := h4a x hx
        exact ⟨0, z, hint.resolve_left hxi, by rw [pow_zero, hxz]⟩
    obtain ⟨M, hM⟩ := ha
    obtain ⟨j₀, e, he, hje⟩ := hb
    have hbound : ∀ j : ℕ, ∀ y : B, IsIntegral V y → τ ^ (M * N) * x ^ N = τ ^ j * y →
        j ≤ M * N + j₀ * N := by
