    intro F₁ F₂ _ _ A f x
    rw [Hlt, Hlt, ValuationSubring.mem_comap, map_inv₀, map_eq_zero]
  have HcomapEq : ∀ (F₁ F₂ : Type u) [Field F₁] [Field F₂] (A : ValuationSubring F₂)
      (f : F₁ →+* F₂) (x : F₁), (A.comap f).valuation x = 1 ↔ A.valuation (f x) = 1 := by
    intro F₁ F₂ _ _ A f x
    rw [Heq, Heq, ValuationSubring.mem_comap, Hcomap]

  obtain ⟨V', hV'⟩ := wcpa_dj_lr1k_grc_valuation_extends (RatFunc Ω) M V
  obtain ⟨s, τ, hcover, hinc, hcount⟩ := wcpa_dj_lr1k_grc_conjugate_reps (RatFunc Ω) M V'
  have h5 := wcpa_dj_lr1k_grc_local_residue_degree_r1 Ω W hW hWt V hV M V' hV'
  obtain ⟨hint, hmax⟩ := wcpa_dj_lr1k_grc_integral_iff_conj (RatFunc Ω) V M V' hV'
  generalize hd : Nat.card {σ : M ≃ₐ[RatFunc Ω] M // ∀ x : M, σ x ∈ V' ↔ x ∈ V'} = d
    at hcount h5
  obtain ⟨y, hyV, hyunit⟩ := h5
  have hmul : ∀ a z : M, a ∈ V' → V'.valuation z < 1 → V'.valuation (a * z) < 1 := by
    intro a z ha hz
    rw [Valuation.map_mul]
    calc V'.valuation a * V'.valuation z ≤ V'.valuation z :=
          mul_le_of_le_one_left' ((V'.valuation_le_one_iff a).2 ha)
      _ < 1 := hz
  have hKV' : ∀ k : RatFunc Ω, k ∈ V → algebraMap (RatFunc Ω) M k ∈ V' := by
    intro k hk
    rw [← hV'] at hk
    exact hk

  let ρ : Fin s → (M →+* M) := fun j => (τ j : M →+* M)
  let U : Fin s → ValuationSubring M := fun j => V'.comap (ρ j)
  have hmemU : ∀ j x, x ∈ U j ↔ τ j x ∈ V' := fun j x => Iff.rfl
  have hltU : ∀ j x, (U j).valuation x < 1 ↔ V'.valuation (τ j x) < 1 := fun j x =>
    Hcomap M M V' (ρ j) x
  have heqU : ∀ j x, (U j).valuation x = 1 ↔ V'.valuation (τ j x) = 1 := fun j x =>
    HcomapEq M M V' (ρ j) x
  have hintU : ∀ x : M, IsIntegral V x ↔ ∀ l, x ∈ U l := by
    intro x
    rw [hint x]
    constructor
    · intro h l; exact (hmemU l x).2 (h (τ l))
    · intro h σ
      obtain ⟨j, hj⟩ := hcover σ
      exact (hj x).2 ((hmemU j x).1 (h j))
  have hincU : ∀ i j, U i ≤ U j → i = j := by
    intro i j h
    apply hinc i j
    intro x hx
    exact (hmemU j x).1 (h ((hmemU i x).2 hx))
  have hRmax : ∀ i (t : M), (∀ l, t ∈ U l) → (U i).valuation t = 1 →
      ∃ r : M, (∀ l, r ∈ U l) ∧ (U i).valuation (r * t - 1) < 1 := by
    intro i t ht hv
    obtain ⟨r, hr, hr1⟩ := hmax (τ i) t ((hintU t).2 ht) ((heqU i t).1 hv)
    refine ⟨r, (hintU r).1 hr, ?_⟩
    rw [hltU, map_sub, map_mul, map_one]
    exact hr1

  have hlift : ∀ q : Fin s × Fin d, ∃ b : M, (∀ l, b ∈ U l) ∧
      (U q.1).valuation (b - (τ q.1).symm (y q.2)) < 1 ∧
      ∀ j, j ≠ q.1 → (U j).valuation b < 1 := fun q =>
    wcpa_dj_lr1k_grc_approx_lift M s U hincU hRmax q.1 _
      (by rw [hmemU, AlgEquiv.apply_symm_apply]; exact hyV q.2)
  choose bb hbbU hbbnear hbbfar using hlift
  have hnear : ∀ q : Fin s × Fin d, V'.valuation (τ q.1 (bb q) - y q.2) < 1 := by
    intro q
    have := (hltU q.1 _).1 (hbbnear q)
    rwa [map_sub, AlgEquiv.apply_symm_apply] at this
  have hfar : ∀ (q : Fin s × Fin d) (j : Fin s), j ≠ q.1 → V'.valuation (τ j (bb q)) < 1 :=
    fun q j hj => (hltU j _).1 (hbbfar q j hj)

  let e : Fin (Module.finrank (RatFunc Ω) M) ≃ Fin s × Fin d :=
    (finCongr hcount.symm).trans finProdFinEquiv.symm
  refine ⟨fun i => bb (e i), fun i => (hintU _).2 (hbbU (e i)), ?_⟩

  have hspan : ∀ x ∈ Submodule.span (integralClosure V M)
      {x : M | ∃ m ∈ IsLocalRing.maximalIdeal V, x = algebraMap V M m},
      ∀ σ : M ≃ₐ[RatFunc Ω] M, V'.valuation (σ x) < 1 := by
    intro x hx σ
    induction hx using Submodule.span_induction with
    | mem z hz =>
      obtain ⟨m, hm, rfl⟩ := hz
      have h1 : algebraMap V M m = algebraMap (RatFunc Ω) M (m : RatFunc Ω) := rfl
      rw [h1, AlgEquiv.commutes]
      have h2 : (V'.comap (algebraMap (RatFunc Ω) M)).valuation (m : RatFunc Ω) < 1 := by
        rw [hV']; exact (ValuationSubring.valuation_lt_one_iff V m).1 hm
      exact (Hcomap _ _ V' _ _).1 h2
    | zero => simp
    | add x z _ _ hx hz => rw [map_add]; exact Valuation.map_add_lt _ hx hz
    | smul a x _ hx =>
      rw [Subalgebra.smul_def, smul_eq_mul, map_mul]
      exact hmul _ _ ((hint (a : M)).1 a.2 σ) hx

  intro c hc i₀
  by_contra hci
  have hcu : V.valuation (c i₀ : RatFunc Ω) = 1 := by
    have h1 : ¬ V.valuation (c i₀ : RatFunc Ω) < 1 := fun h =>
      hci ((ValuationSubring.valuation_lt_one_iff V (c i₀)).2 h)
    exact le_antisymm ((V.valuation_le_one_iff _).2 (c i₀).2) (not_lt.1 h1)
  set p := e i₀ with hp
  let c' : Fin d → RatFunc Ω := fun l => (c (e.symm (p.1, l)) : RatFunc Ω)
  have hc'unit : ∃ l, V.valuation (c' l) = 1 := by
    refine ⟨p.2, ?_⟩
    show V.valuation (c (e.symm (p.1, p.2)) : RatFunc Ω) = 1
    rw [Prod.mk.eta, hp, Equiv.symm_apply_apply]
    exact hcu
  have hX1 := hyunit c' (fun l => (c _).2) hc'unit

  set σ := τ p.1 with hσ
  set x := ∑ i, algebraMap V M (c i) * bb (e i) with hx
  have hσx := hspan x hc σ
  let g : Fin s × Fin d → M := fun q =>
    algebraMap (RatFunc Ω) M (c (e.symm q) : RatFunc Ω) * σ (bb q)
  have hσx' : σ x = ∑ q, g q := by
    rw [hx, map_sum, ← Equiv.sum_comp e g]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    simp only [g, Equiv.symm_apply_apply, map_mul]
    rw [show algebraMap V M (c i) = algebraMap (RatFunc Ω) M (c i : RatFunc Ω) from rfl,
      AlgEquiv.commutes]
  let h : Fin s × Fin d → M := fun q =>
    if q.1 = p.1 then algebraMap (RatFunc Ω) M (c' q.2) * y q.2 else 0
  have hsumh : ∑ q, h q = ∑ l, algebraMap (RatFunc Ω) M (c' l) * y l := by
    rw [Fintype.sum_prod_type]
    simp only [h]
    rw [Finset.sum_eq_single p.1]
    · simp
    · intro j _ hj; simp [hj]
    · intro hp1; exact absurd (Finset.mem_univ _) hp1
  have hT : ∀ q, V'.valuation (g q - h q) < 1 := by
    rintro ⟨j, l⟩
    by_cases hj : j = p.1
    · subst hj
      simp only [g, h, if_pos rfl]
      rw [← mul_sub]
      exact hmul _ _ (hKV' _ (c _).2) (hnear (p.1, l))
    · simp only [g, h, if_neg hj, sub_zero]
      exact hmul _ _ (hKV' _ (c _).2) (hfar (j, l) p.1 (Ne.symm hj))
  have hdiff : ∑ l, algebraMap (RatFunc Ω) M (c' l) * y l = σ x - ∑ q, (g q - h q) := by
    rw [Finset.sum_sub_distrib, hσx', hsumh]; ring
  have hlt : V'.valuation (∑ l, algebraMap (RatFunc Ω) M (c' l) * y l) < 1 := by
    rw [hdiff]
    exact Valuation.map_sub_lt _ hσx (Valuation.map_sum_lt _ one_ne_zero (fun q _ => hT q))
  rw [hX1] at hlt
  exact lt_irrefl 1 hlt

theorem wcpa_dj_lr1k_eb_gauss_defectless_r1 : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω) (hW : ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞)) (hWt : W ≠ ⊤) (L : Type u) [Field L] [Algebra (RatFunc Ω) L]
    [FiniteDimensional (RatFunc Ω) L] [Algebra.IsSeparable (RatFunc Ω) L],
    wcEbDefectless W L :=
by
  intro Ω _ _ W hW hWt L _ _ _ _
  obtain ⟨V, hV, -⟩ := wcpa_dj_lr1k_gd_gauss_valuation Ω W

  haveI : Algebra.IsSeparable (RatFunc Ω) (SeparableClosure L) :=
    Algebra.IsSeparable.trans (RatFunc Ω) L (SeparableClosure L)
  haveI : IsSepClosure (RatFunc Ω) (SeparableClosure L) := ⟨inferInstance, inferInstance⟩
  haveI : IsGalois (RatFunc Ω) (SeparableClosure L) := inferInstance
  let M := IntermediateField.normalClosure (RatFunc Ω) L (SeparableClosure L)
  haveI hMgal : IsGalois (RatFunc Ω) M := inferInstance
  haveI hMfd : FiniteDimensional (RatFunc Ω) M := inferInstance

  have keyM : letI : Algebra V M := ((algebraMap (RatFunc Ω) M).comp V.subtype).toAlgebra
      Module.Finite V (integralClosure V M) := by
    obtain ⟨b, hb, hind⟩ := wcpa_dj_lr1k_gd_galois_residue_count_r1 Ω W hW hWt V hV M
    exact wcpa_dj_lr1k_gd_finite_of_residue_indep (RatFunc Ω) V M b hb hind
  have keyL : letI : Algebra V L := ((algebraMap (RatFunc Ω) L).comp V.subtype).toAlgebra
      Module.Finite V (integralClosure V L) :=
    wcpa_dj_lr1k_gd_finite_descend (RatFunc Ω) V L M keyM

  have gen : ∀ S : Subring (RatFunc Ω), V.toSubring = S →
      (letI : Algebra S L := ((algebraMap (RatFunc Ω) L).comp S.subtype).toAlgebra;
        Module.Finite S (integralClosure S L)) := by
    intro S hS
    subst hS
    exact keyL
  unfold wcEbDefectless
  exact gen _ hV

theorem wcpa_dj_lr1k_eb_an_chart_modelB : ∀ {Ω : Type u} [Field Ω] (W : ValuationSubring Ω)
    (D : Type u) [CommRing D] (w : ↥W →+* D) (𝔮 : Ideal D) [𝔮.IsPrime],
    wcEbChart W w 𝔮 →
    ∀ (P : Type u) [CommRing P] (e : Localization.AtPrime 𝔮 →+* P),
      wcNdIsHens (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮)) P e →
      wcNdModelB W P (e.comp ((algebraMap D (Localization.AtPrime 𝔮)).comp w)) :=
by


  have c1 : ∀ (R E : Type u) [CommRing R] [CommRing E] (ψ : R →+* E) (𝔭 : Ideal R)
      (𝔓 : Ideal E) [𝔓.IsPrime], ψ.Etale → 𝔓.comap ψ = 𝔭 →
      Function.Surjective ((Ideal.Quotient.mk 𝔓).comp ψ) →
      (∀ c : R, IsUnit (algebraMap E (Localization.AtPrime 𝔓) (ψ c)) ↔ c ∉ 𝔭) ∧
        wcLfLLP ((algebraMap E (Localization.AtPrime 𝔓)).comp ψ) 𝔭 := by
    intro R E _ _ ψ 𝔭 𝔓 _ hψ hcomap hsurj
    have K1 : ∀ z : E, ∃ c : R, z - ψ c ∈ 𝔓 := by
      intro z
      obtain ⟨c, hc⟩ := hsurj (Ideal.Quotient.mk 𝔓 z)
      have hc' : Ideal.Quotient.mk 𝔓 (ψ c) = Ideal.Quotient.mk 𝔓 z := hc
      exact ⟨c, Ideal.Quotient.eq.mp hc'.symm⟩
    have K2 : ∀ c : R, ψ c ∈ 𝔓 ↔ c ∈ 𝔭 := fun c => by
      rw [← hcomap, Ideal.mem_comap]
    have K0 : ∀ (z : E) (c : R), z - ψ c ∈ 𝔓 → (z ∈ 𝔓 ↔ c ∈ 𝔭) := by
      intro z c h
      rw [← K2 c]
      constructor
      · intro hz
        have h2 := 𝔓.sub_mem hz h
        rwa [sub_sub_cancel] at h2
      · intro hc
        have h2 := 𝔓.add_mem h hc
        rwa [sub_add_cancel] at h2
    have hu : ∀ c : R, IsUnit (algebraMap E (Localization.AtPrime 𝔓) (ψ c)) ↔ c ∉ 𝔭 :=
      fun c => (IsLocalization.AtPrime.isUnit_to_map_iff (Localization.AtPrime 𝔓) 𝔓 (ψ c)).trans
        (not_congr (K2 c))
    refine ⟨hu, ?_⟩
    intro B _ hB g₀ hg₀
    haveI := hB
    letI : Algebra R B := g₀.toAlgebra
    letI : Algebra R E := ψ.toAlgebra
    haveI : Algebra.Etale R E := hψ
    have hJ : ∀ c ∈ RingHom.ker ((Ideal.Quotient.mk 𝔓).comp ψ),
        ((IsLocalRing.residue B).comp g₀) c = 0 := by
      intro c hc
      rw [RingHom.mem_ker, RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem, K2] at hc
      rw [RingHom.comp_apply, IsLocalRing.residue_eq_zero_iff]
      exact (IsLocalRing.mem_maximalIdeal _).mpr
        (mem_nonunits_iff.mpr (fun hu' => ((hg₀ c).mp hu') hc))
    let Θ := RingHom.quotientKerEquivOfSurjective hsurj
    let gb : R ⧸ RingHom.ker ((Ideal.Quotient.mk 𝔓).comp ψ) →+* IsLocalRing.ResidueField B :=
      Ideal.Quotient.lift _ ((IsLocalRing.residue B).comp g₀) hJ
    let σ : E →+* IsLocalRing.ResidueField B :=
      gb.comp (Θ.symm.toRingHom.comp (Ideal.Quotient.mk 𝔓))
    have K3 : ∀ (z : E) (c : R), z - ψ c ∈ 𝔓 → σ z = IsLocalRing.residue B (g₀ c) := by
      intro z c h
      have h1 : Ideal.Quotient.mk 𝔓 z = Θ (Ideal.Quotient.mk _ c) :=
        (Ideal.Quotient.eq.mpr h).trans (RingHom.quotientKerEquivOfSurjective_apply_mk hsurj c).symm
      show gb (Θ.symm (Ideal.Quotient.mk 𝔓 z)) = _
      rw [h1, RingEquiv.symm_apply_apply]
      exact Ideal.Quotient.lift_mk _ _ _
    have hσ : σ.comp (algebraMap R E) = (IsLocalRing.residue B).comp (algebraMap R B) := by
      apply RingHom.ext
      intro c
      exact K3 (ψ c) c (by rw [sub_self]; exact 𝔓.zero_mem)
    have K4 : ∀ z, σ z ≠ 0 ↔ z ∉ 𝔓 := by
      intro z
      obtain ⟨c, hc⟩ := K1 z
      rw [K3 z c hc, IsLocalRing.residue_ne_zero_iff_isUnit, hg₀ c, K0 z c hc]
    obtain ⟨τ, hτ⟩ := wc_hnas_hs_etale_section_over_base R B
      (fun E'' _ _ _ σ'' => wc_hnas_smooth_section_henselian B E'' σ'') E σ hσ
    have K5 : ∀ z, IsUnit (τ z) ↔ z ∉ 𝔓 := by
      intro z
      rw [← IsLocalRing.residue_ne_zero_iff_isUnit, hτ z, K4 z]
    have hM : ∀ s : 𝔓.primeCompl, IsUnit (τ s) := fun s => (K5 s).mpr s.2
    let h : Localization.AtPrime 𝔓 →+* B :=
      IsLocalization.lift (M := 𝔓.primeCompl) (S := Localization.AtPrime 𝔓)
        (g := (τ : E →+* B)) hM
    have hhα : ∀ z, h (algebraMap E (Localization.AtPrime 𝔓) z) = τ z :=
      fun z => IsLocalization.lift_eq hM z
    have hloc : IsLocalHom h := by
      constructor
      intro l hl
      obtain ⟨⟨z, s⟩, e1⟩ := IsLocalization.surj 𝔓.primeCompl l
      have e1' : l * algebraMap E (Localization.AtPrime 𝔓) s =
          algebraMap E (Localization.AtPrime 𝔓) z := e1
      have e2 : h l * τ s = τ z := by rw [← hhα, ← hhα, ← map_mul, e1']
      have hz : IsUnit (τ z) := by rw [← e2]; exact hl.mul (hM s)
      have hbz : IsUnit (l * algebraMap E (Localization.AtPrime 𝔓) s) := by
        rw [e1']
        exact (IsLocalization.AtPrime.isUnit_to_map_iff _ 𝔓 z).mpr ((K5 z).mp hz)
      exact isUnit_of_mul_isUnit_left hbz
    have hcomp : h.comp ((algebraMap E (Localization.AtPrime 𝔓)).comp ψ) = g₀ := by
      apply RingHom.ext
      intro c
      show h (algebraMap E (Localization.AtPrime 𝔓) (ψ c)) = g₀ c
      rw [hhα]
      exact τ.commutes c
    refine ⟨h, ⟨hcomp, hloc⟩, ?_⟩
    rintro h₁ ⟨hh₁, hl₁⟩
    haveI := hl₁
    let τ₁ : E →ₐ[R] B := ⟨h₁.comp (algebraMap E (Localization.AtPrime 𝔓)), fun c => by
      change h₁ (algebraMap E (Localization.AtPrime 𝔓) (ψ c)) = g₀ c
      exact RingHom.congr_fun hh₁ c⟩
    have hres : ∀ z : E, IsLocalRing.residue B (τ₁ z) = IsLocalRing.residue B (τ z) := by
      intro z
      obtain ⟨c, hc⟩ := K1 z
      rw [hτ z, K3 z c hc]
      have hd : algebraMap E (Localization.AtPrime 𝔓) (z - ψ c) ∈
          IsLocalRing.maximalIdeal (Localization.AtPrime 𝔓) :=
        (IsLocalization.AtPrime.to_map_mem_maximal_iff _ 𝔓 _).mpr hc
      have hd' : h₁ (algebraMap E (Localization.AtPrime 𝔓) (z - ψ c)) ∈
          IsLocalRing.maximalIdeal B := by
        rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
        intro hu'
        exact mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal _).mp hd)
          (isUnit_of_map_unit h₁ _ hu')
      have hd'' := (IsLocalRing.residue_eq_zero_iff _).mpr hd'
      rw [map_sub, map_sub, map_sub] at hd''
      have h3 : IsLocalRing.residue B (h₁ (algebraMap E (Localization.AtPrime 𝔓) (ψ c))) =
          IsLocalRing.residue B (g₀ c) :=
        congrArg (IsLocalRing.residue B) (RingHom.congr_fun hh₁ c)
      change IsLocalRing.residue B (h₁ (algebraMap E (Localization.AtPrime 𝔓) z)) = _
      rw [← h3]
      exact sub_eq_zero.mp hd''
    have heq : τ₁ = τ := wc_hnas_hs_etale_hom_unique_residue R E B τ₁ τ hres
    apply IsLocalization.ringHom_ext 𝔓.primeCompl (S := Localization.AtPrime 𝔓)
    apply RingHom.ext
    intro z
    change h₁ (algebraMap E (Localization.AtPrime 𝔓) z) = h (algebraMap E (Localization.AtPrime 𝔓) z)
    rw [hhα]
    exact congrArg (fun f : E →ₐ[R] B => f z) heq

  have c2 : ∀ (Q L D' P' : Type u) [CommRing Q] [CommRing L] [CommRing D'] [IsLocalRing D']
      [CommRing P'] (q : Q →+* L) (𝔭 : Ideal Q) (φ : L ≃+* D') (e' : D' →+* P'),
      (∀ c, IsUnit (q c) ↔ c ∉ 𝔭) → wcLfLLP q 𝔭 →
      wcNdIsHens (IsLocalRing.maximalIdeal D') P' e' →
      wcNdIsHens 𝔭 P' (e'.comp (φ.toRingHom.comp q)) := by
    intro Q L D' P' _ _ _ _ _ q 𝔭 φ e' hqu hq hP
    unfold wcNdIsHens at hP
    obtain ⟨H1, H2, H3⟩ := hP
    have U1 : ∀ d, IsUnit (e' d) ↔ IsUnit d := fun d => by
      rw [H2 d, IsLocalRing.notMem_maximalIdeal]
    have U2 : ∀ x, IsUnit (φ x) ↔ IsUnit x := fun x =>
      ⟨fun hx => by simpa using hx.map φ.symm, fun hx => hx.map φ⟩
    unfold wcNdIsHens
    refine ⟨H1, fun c => ?_, ?_⟩
    · show IsUnit (e' (φ (q c))) ↔ c ∉ 𝔭
      rw [U1, U2]
      exact hqu c
    · intro B _ hB h₀ hh₀
      obtain ⟨k, ⟨hk, hkl⟩, hku⟩ := hq B hB h₀ hh₀
      haveI := hkl
      haveI := hB
      let k' : D' →+* B := k.comp φ.symm.toRingHom
      have hk' : ∀ d, IsUnit (k' d) ↔ d ∉ IsLocalRing.maximalIdeal D' := fun d => by
        rw [IsLocalRing.notMem_maximalIdeal]
        show IsUnit (k (φ.symm d)) ↔ _
        rw [isUnit_map_iff k, ← U2, RingEquiv.apply_symm_apply]
      obtain ⟨η, ⟨hη, hηl⟩, hηu⟩ := H3 B hB k' hk'
      haveI := hηl
      refine ⟨η, ⟨?_, hηl⟩, ?_⟩
      · apply RingHom.ext
        intro c
        show η (e' (φ (q c))) = h₀ c
        have h1 := RingHom.congr_fun hη (φ (q c))
        rw [RingHom.comp_apply] at h1
        rw [h1]
        show k (φ.symm (φ (q c))) = h₀ c
        rw [RingEquiv.symm_apply_apply]
        exact RingHom.congr_fun hk c
      · rintro η' ⟨hη', hη'l⟩
        haveI := hη'l
        have hloc' : IsLocalHom ((η'.comp e').comp φ.toRingHom) := by
          constructor
          intro l hl
          have hl' : IsUnit (η' (e' (φ l))) := hl
          have h1 : IsUnit (e' (φ l)) := isUnit_of_map_unit η' _ hl'
          exact (U2 l).mp ((U1 _).mp h1)
        have e1 : (η'.comp e').comp φ.toRingHom = k :=
          hku _ ⟨RingHom.ext (fun c => RingHom.congr_fun hη' c), hloc'⟩
        apply hηu η'
        refine ⟨?_, hη'l⟩
        apply RingHom.ext
        intro d
        show η' (e' d) = k (φ.symm d)
        rw [← e1]
        show η' (e' d) = η' (e' (φ (φ.symm d)))
        rw [RingEquiv.apply_symm_apply]

  intro Ω _ W D _ w 𝔮 _ hch P _ e he
  unfold wcEbChart at hch
  obtain ⟨g, hgm, hg0, E, _, ψ, hψ, 𝔓, h𝔓, hcomap, hsurj, φ, hφ⟩ := hch
  haveI := h𝔓
  obtain ⟨hu, hL⟩ := c1 (wcEbNg W g) E ψ (wcEbNgOrigin W g) 𝔓 hψ hcomap hsurj
  have hH := c2 _ _ _ P ((algebraMap E (Localization.AtPrime 𝔓)).comp ψ) (wcEbNgOrigin W g)
    φ e hu hL he
  unfold wcNdModelB
  refine ⟨g, hgm, hg0,
    e.comp (φ.toRingHom.comp ((algebraMap E (Localization.AtPrime 𝔓)).comp ψ)), ?_, hH⟩
  apply RingHom.ext
  intro c
  have h1 := hφ c
  show e (φ (algebraMap E (Localization.AtPrime 𝔓) (ψ (wcEbNgC W g c)))) =
    e (algebraMap D (Localization.AtPrime 𝔮) (w c))
  rw [h1]

theorem wcpa_dj_lr1k_eb_an_node_ring_closed : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω) (a : ↥W), a ≠ 0 → a ∈ IsLocalRing.maximalIdeal ↥W →
    ∀ x : RatFunc Ω, IsIntegral ↥(wcEbRing W a) x → x ∈ wcEbRing W a :=
by
  intro Ω _ _ W a ha0 _ x hx
  classical

  obtain ⟨ψ, hψa⟩ : ∃ ψ : Polynomial W →+* RatFunc Ω,
      ∀ p, ψ p = algebraMap (Polynomial Ω) (RatFunc Ω) (p.map W.subtype) :=
    ⟨(algebraMap (Polynomial Ω) (RatFunc Ω)).comp (Polynomial.mapRingHom W.subtype), fun p => rfl⟩
  have hψX : ψ Polynomial.X = RatFunc.X := by rw [hψa, Polynomial.map_X, RatFunc.algebraMap_X]
  obtain ⟨κ, hκ⟩ : ∃ κ : W →+* RatFunc Ω, ∀ w : W, κ w = algebraMap Ω (RatFunc Ω) (w : Ω) :=
    ⟨(algebraMap Ω (RatFunc Ω)).comp W.subtype, fun w => rfl⟩
  have hψC : ∀ w : W, ψ (Polynomial.C w) = κ w := by
    intro w
    rw [hψa, Polynomial.map_C, RatFunc.algebraMap_C, hκ, RatFunc.algebraMap_eq_C]
    rfl
  have hψinj : Function.Injective ψ := by
    intro p q h
    rw [hψa, hψa] at h
    exact Polynomial.map_injective _ (fun a b h => Subtype.ext h) (RatFunc.algebraMap_injective Ω h)
  have hc : (a : Ω) ≠ 0 := fun h => ha0 (Subtype.ext h)
  have hκa : κ a ≠ 0 := by rw [hκ]; exact (map_ne_zero _).mpr hc
  have hX0 : (RatFunc.X : RatFunc Ω) ≠ 0 := RatFunc.X_ne_zero
  obtain ⟨u, hu⟩ : ∃ u : RatFunc Ω, u = κ a * RatFunc.X⁻¹ := ⟨_, rfl⟩
  have huT : u * RatFunc.X = κ a := by rw [hu, mul_assoc, inv_mul_cancel₀ hX0, mul_one]

  have hXR : RatFunc.X ∈ wcEbRing W a := Subring.subset_closure (Or.inr (Set.mem_insert _ _))
  have huR : u ∈ wcEbRing W a := by
    rw [hu, hκ]; exact Subring.subset_closure (Or.inr (Set.mem_insert_of_mem _ rfl))
  have hκR : ∀ w : W, κ w ∈ wcEbRing W a := fun w => by
    rw [hκ]; exact Subring.subset_closure (Or.inl ⟨w, rfl⟩)
  have hψR : ∀ p : Polynomial W, ψ p ∈ wcEbRing W a := by
    intro p
    refine Polynomial.induction_on p (fun w => ?_) (fun p q hp hq => ?_) (fun n w _ => ?_)
    · rw [hψC]; exact hκR w
    · rw [map_add]; exact add_mem hp hq
    · rw [map_mul, map_pow, hψC, hψX]; exact mul_mem (hκR w) (pow_mem hXR _)

  have T1 : ∀ r ∈ wcEbRing W a, ∃ (k : ℕ) (p : Polynomial W),
      RatFunc.X ^ k * r = algebraMap (Polynomial Ω) (RatFunc Ω) (p.map W.subtype) := by
    intro r hr
    induction hr using Subring.closure_induction with
    | mem x hx =>
      rcases hx with ⟨w, rfl⟩ | hx
      · refine ⟨0, Polynomial.C w, ?_⟩
        rw [pow_zero, one_mul, Polynomial.map_C, RatFunc.algebraMap_C, RatFunc.algebraMap_eq_C]
        rfl
      · rcases hx with rfl | hx
        · exact ⟨0, Polynomial.X, by rw [pow_zero, one_mul, Polynomial.map_X, RatFunc.algebraMap_X]⟩
        · rw [Set.mem_singleton_iff] at hx
          subst hx
          refine ⟨1, Polynomial.C a, ?_⟩
          rw [Polynomial.map_C, RatFunc.algebraMap_C, pow_one, mul_left_comm,
            mul_inv_cancel₀ RatFunc.X_ne_zero, mul_one, RatFunc.algebraMap_eq_C]
          rfl
    | zero => exact ⟨0, 0, by simp⟩
    | one => exact ⟨0, 1, by simp⟩
    | add x y _ _ hx hy =>
      obtain ⟨k, p, hp⟩ := hx
      obtain ⟨k', p', hp'⟩ := hy
      refine ⟨k + k', p * Polynomial.X ^ k' + p' * Polynomial.X ^ k, ?_⟩
      simp only [Polynomial.map_add, Polynomial.map_mul, Polynomial.map_pow, Polynomial.map_X,
        map_add, map_mul, map_pow, RatFunc.algebraMap_X, ← hp, ← hp']
      ring
    | neg x _ hx =>
      obtain ⟨k, p, hp⟩ := hx
      exact ⟨k, -p, by rw [Polynomial.map_neg, map_neg, ← hp, mul_neg]⟩
    | mul x y _ _ hx hy =>
      obtain ⟨k, p, hp⟩ := hx
      obtain ⟨k', p', hp'⟩ := hy
      refine ⟨k + k', p * p', ?_⟩
      rw [Polynomial.map_mul, map_mul, ← hp, ← hp']
      ring

  have T2 : ∀ (S : Subring (RatFunc Ω)), (∀ s ∈ S, ∃ (k : ℕ) (p : Polynomial W),
      RatFunc.X ^ k * s = algebraMap (Polynomial Ω) (RatFunc Ω) (p.map W.subtype)) →
      ∀ (y : RatFunc Ω), _root_.IsIntegral S y →
      ∃ (K : ℕ) (q : Polynomial W),
        RatFunc.X ^ K * y = algebraMap (Polynomial Ω) (RatFunc Ω) (q.map W.subtype) := by
    intro S hS y hy
    obtain ⟨f, hfm, hfx⟩ := hy
    have hc : ∀ i, ∃ (k : ℕ) (p : Polynomial W),
        RatFunc.X ^ k * algebraMap S (RatFunc Ω) (f.coeff i) = ψ p := by
      intro i
      obtain ⟨k, p, hp⟩ := hS _ (f.coeff i).2
      exact ⟨k, p, by rw [hψa]; exact hp⟩
    choose k p hkp using hc
    obtain ⟨K, hkK⟩ : ∃ K, ∀ i < f.natDegree, k i ≤ K :=
      ⟨∑ i ∈ Finset.range f.natDegree, k i, fun i hi =>
        Finset.single_le_sum (f := k) (fun _ _ => Nat.zero_le _) (Finset.mem_range.mpr hi)⟩
    have hFm : (f.map (algebraMap S (RatFunc Ω))).Monic := hfm.map _
    have hFdeg : (f.map (algebraMap S (RatFunc Ω))).natDegree = f.natDegree :=
      hfm.natDegree_map _
    have hgm : ((f.map (algebraMap S (RatFunc Ω))).scaleRoots (RatFunc.X ^ K)).Monic :=
      (Polynomial.monic_scaleRoots_iff _).mpr hFm
    have hgy : Polynomial.eval₂ (RingHom.id _) (RatFunc.X ^ K * y)
        ((f.map (algebraMap S (RatFunc Ω))).scaleRoots (RatFunc.X ^ K)) = 0 := by
      have h0 : Polynomial.eval₂ (RingHom.id _) y (f.map (algebraMap S (RatFunc Ω))) = 0 := by
        rw [Polynomial.eval₂_map, RingHom.id_comp]; exact hfx
      exact Polynomial.scaleRoots_eval₂_eq_zero (RingHom.id _) h0
    have hglift : (f.map (algebraMap S (RatFunc Ω))).scaleRoots (RatFunc.X ^ K) ∈
        Polynomial.lifts ψ := by
      rw [Polynomial.lifts_iff_coeff_lifts]
      intro i
      rw [Polynomial.coeff_scaleRoots, hFdeg, Polynomial.coeff_map]
      rcases lt_trichotomy i f.natDegree with hi | hi | hi
      · refine ⟨Polynomial.X ^ (K * (f.natDegree - i) - k i) * p i, ?_⟩
        rw [map_mul, map_pow, hψX, ← hkp i, ← mul_assoc, ← pow_add, ← pow_mul]
        have : K * (f.natDegree - i) - k i + k i = K * (f.natDegree - i) := by
          have h1 := hkK i hi
          have h2 : K ≤ K * (f.natDegree - i) := Nat.le_mul_of_pos_right K (by omega)
          omega
        rw [this]
        exact mul_comm _ _
      · subst hi
        refine ⟨1, ?_⟩
        rw [map_one, Nat.sub_self, pow_zero, mul_one, hfm.coeff_natDegree, map_one]
      · refine ⟨0, ?_⟩
        rw [map_zero, Polynomial.coeff_eq_zero_of_natDegree_lt hi, map_zero, zero_mul]
    obtain ⟨G, hGmap, -, hGm⟩ := Polynomial.lifts_and_natDegree_eq_and_monic hglift hgm
    have hGy : Polynomial.eval₂ ψ (RatFunc.X ^ K * y) G = 0 := by
      rw [← hgy, ← hGmap, Polynomial.eval₂_map, RingHom.id_comp]
    have hψc : ψ = (algebraMap (Polynomial Ω) (RatFunc Ω)).comp
        (Polynomial.mapRingHom W.subtype) := RingHom.ext fun p => hψa p
    have hyint : _root_.IsIntegral (Polynomial Ω) (RatFunc.X ^ K * y) := by
      refine ⟨G.map (Polynomial.mapRingHom W.subtype), hGm.map _, ?_⟩
      rw [Polynomial.eval₂_map, ← hψc]; exact hGy
    obtain ⟨q₀, hq₀⟩ :=
      (IsIntegrallyClosed.isIntegral_iff (R := Polynomial Ω) (K := RatFunc Ω)).mp hyint
    letI : Algebra (Polynomial W) (Polynomial Ω) := Polynomial.algebra W Ω
    have hq₀int : _root_.IsIntegral (Polynomial W) q₀ := by
      refine ⟨G, hGm, ?_⟩
      apply RatFunc.algebraMap_injective Ω
      rw [Polynomial.hom_eval₂, map_zero, hq₀]
      have : (algebraMap (Polynomial Ω) (RatFunc Ω)).comp
          (algebraMap (Polynomial W) (Polynomial Ω)) = ψ := by rw [hψc]; rfl
      rw [this]
      exact hGy
    have hcoeff := (Polynomial.isIntegral_iff_isIntegral_coeff).mp hq₀int
    have hlift : q₀ ∈ Polynomial.lifts W.subtype := by
      rw [Polynomial.lifts_iff_coeff_lifts]
      intro j
      obtain ⟨w, hw⟩ := (IsIntegrallyClosed.isIntegral_iff (R := W) (K := Ω)).mp (hcoeff j)
      exact ⟨w, hw⟩
    obtain ⟨q, hq⟩ := (Polynomial.mem_lifts q₀).mp hlift
    exact ⟨K, q, by rw [hq]; exact hq₀.symm⟩

  obtain ⟨σ, hσκ, hσX⟩ : ∃ σ : RatFunc Ω →+* RatFunc Ω,
      (∀ w : W, σ (κ w) = κ w) ∧ σ RatFunc.X = u := by
    have htr : Transcendental Ω u := by
      intro halg
      have h1 : IsAlgebraic Ω u⁻¹ := halg.inv
      have h2 : IsAlgebraic Ω ((a : Ω) • u⁻¹) := h1.smul (a : Ω)
      have h3 : (a : Ω) • u⁻¹ = RatFunc.X := by
        rw [Algebra.smul_def, hu, mul_inv, inv_inv, ← mul_assoc]
        have : algebraMap Ω (RatFunc Ω) (a : Ω) = κ a := (hκ a).symm
        rw [this, mul_inv_cancel₀ hκa, one_mul]
      rw [h3] at h2
      exact RatFunc.transcendental_X h2
    have hinj : Function.Injective (Polynomial.aeval (R := Ω) u) :=
      (transcendental_iff_injective).mp htr
    refine ⟨(RatFunc.liftAlgHom (Polynomial.aeval (R := Ω) u)
      (nonZeroDivisors_le_comap_nonZeroDivisors_of_injective _ hinj)).toRingHom,
      fun w => by rw [hκ]; exact AlgHom.commutes _ (w : Ω), ?_⟩
    have : (RatFunc.X : RatFunc Ω) = algebraMap (Polynomial Ω) (RatFunc Ω) Polynomial.X /
        algebraMap (Polynomial Ω) (RatFunc Ω) 1 := by
      rw [map_one, div_one, RatFunc.algebraMap_X]
    rw [AlgHom.toRingHom_eq_coe, RingHom.coe_coe, this, RatFunc.liftAlgHom_apply_div,
      Polynomial.aeval_X, map_one, div_one]
  have hσu : σ u = RatFunc.X := by
    rw [hu, map_mul, map_inv₀, hσκ, hσX, hu, mul_inv, inv_inv, ← mul_assoc,
      mul_inv_cancel₀ hκa, one_mul]
  have hσR : wcEbRing W a ≤ (wcEbRing W a).comap σ := by
    refine (Subring.closure_le (t := (wcEbRing W a).comap σ)).mpr ?_
    rintro y (⟨w, rfl⟩ | hy)
    · show σ (algebraMap Ω (RatFunc Ω) (w : Ω)) ∈ wcEbRing W a
      rw [← hκ, hσκ]; exact hκR w
    · rcases hy with rfl | hy
      · show σ RatFunc.X ∈ wcEbRing W a
        rw [hσX]; exact huR
      · rw [Set.mem_singleton_iff] at hy
        subst hy
        show σ (algebraMap Ω (RatFunc Ω) (a : Ω) * RatFunc.X⁻¹) ∈ wcEbRing W a
        rw [← hκ, ← hu, hσu]; exact hXR

  obtain ⟨K, q, hq⟩ := T2 _ T1 x hx
  have hqψ : RatFunc.X ^ K * x = ψ q := by rw [hψa]; exact hq
  obtain ⟨Qm, hQm⟩ : ∃ Qm : Polynomial W,
      Qm = ∑ i ∈ Finset.range K, Polynomial.C (q.coeff i) * Polynomial.X ^ i := ⟨_, rfl⟩
  have hψQm : ψ Qm = ∑ i ∈ Finset.range K, κ (q.coeff i) * RatFunc.X ^ i := by
    rw [hQm, map_sum]
    exact Finset.sum_congr rfl fun i _ => by rw [map_mul, map_pow, hψC, hψX]
  obtain ⟨Qp, hQp⟩ : (Polynomial.X : Polynomial W) ^ K ∣ q - Qm := by
    refine (Polynomial.X_pow_dvd_iff).mpr (fun d hd => ?_)
    rw [Polynomial.coeff_sub, hQm, Polynomial.finset_sum_coeff]
    simp only [Polynomial.coeff_C_mul_X_pow]
    rw [Finset.sum_ite_eq, if_pos (Finset.mem_range.mpr hd), sub_self]
  have hq2 : q = Qm + Polynomial.X ^ K * Qp := by rw [← hQp]; ring
  obtain ⟨xm, hxm_def⟩ : ∃ xm, xm = x - ψ Qp := ⟨_, rfl⟩
  have hxm : RatFunc.X ^ K * xm = ψ Qm := by
    rw [hxm_def, mul_sub, hqψ, hq2, map_add, map_mul, map_pow, hψX]; ring
  have hxmint : _root_.IsIntegral (wcEbRing W a) xm := by
    have h1 : _root_.IsIntegral (wcEbRing W a) (ψ Qp) :=
      isIntegral_algebraMap (R := wcEbRing W a) (x := ⟨ψ Qp, hψR Qp⟩)
    rw [hxm_def]; exact hx.sub h1
  have hσint : _root_.IsIntegral (wcEbRing W a) (σ xm) :=
    _root_.IsIntegral.map_of_comp_eq (σ.restrict (wcEbRing W a) (wcEbRing W a) (fun y hy => hσR hy)) σ
      (RingHom.ext fun _ => rfl) hxmint
  obtain ⟨m, q', hq'⟩ := T2 _ T1 (σ xm) hσint
  have hq'ψ : RatFunc.X ^ m * σ xm = ψ q' := by rw [hψa]; exact hq'
  have E1 : u ^ K * σ xm = ∑ i ∈ Finset.range K, κ (q.coeff i) * u ^ i := by
    have h := congrArg σ hxm
    rw [map_mul, map_pow, hσX, hψQm, map_sum] at h
    rw [h]
    exact Finset.sum_congr rfl fun i _ => by rw [map_mul, map_pow, hσκ, hσX]
  have E2 : ψ (Polynomial.C (a ^ K) * q') = ψ (∑ i ∈ Finset.range K,
      Polynomial.C (q.coeff i * a ^ i) * Polynomial.X ^ (K - i + m)) := by
    rw [map_mul, hψC, ← hq'ψ, map_sum]
    calc κ (a ^ K) * (RatFunc.X ^ m * σ xm)
        = RatFunc.X ^ (K + m) * (u ^ K * σ xm) := by rw [map_pow, ← huT]; ring
      _ = RatFunc.X ^ (K + m) * ∑ i ∈ Finset.range K, κ (q.coeff i) * u ^ i := by rw [E1]
      _ = _ := by
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl fun i hi => ?_
        have hi' := Finset.mem_range.mp hi
        rw [map_mul, map_pow, hψC, hψX, map_mul, map_pow, ← huT,
          show K + m = i + (K - i + m) by omega, pow_add]
        ring
  have hpoly := hψinj E2
  have hcoef : ∀ i < K, a ^ K * q'.coeff (K - i + m) = q.coeff i * a ^ i := by
    intro i hi
    have h : (Polynomial.C (a ^ K) * q').coeff (K - i + m) = (∑ i ∈ Finset.range K,
        Polynomial.C (q.coeff i * a ^ i) * Polynomial.X ^ (K - i + m)).coeff (K - i + m) := by
      rw [hpoly]
    rw [Polynomial.coeff_C_mul, Polynomial.finset_sum_coeff,
      Finset.sum_eq_single i, Polynomial.coeff_C_mul_X_pow, if_pos rfl] at h
    · exact h
    · intro b hb hbi
      have hb' := Finset.mem_range.mp hb
      rw [Polynomial.coeff_C_mul_X_pow, if_neg (by omega)]
    · intro h'
      exact absurd (Finset.mem_range.mpr hi) h'
  have hw : ∀ i < K, a ^ (K - i) * q'.coeff (K - i + m) = q.coeff i := by
    intro i hi
    have h1 : (a ^ (K - i) * q'.coeff (K - i + m) - q.coeff i) * a ^ i = 0 := by
      rw [sub_mul, mul_right_comm, ← pow_add, Nat.sub_add_cancel hi.le, hcoef i hi, sub_self]
    exact sub_eq_zero.mp ((mul_eq_zero.mp h1).resolve_right (pow_ne_zero _ ha0))
  have hxm_eq : xm = ∑ i ∈ Finset.range K, κ (q'.coeff (K - i + m)) * u ^ (K - i) := by
    apply mul_left_cancel₀ (pow_ne_zero K hX0)
    rw [hxm, hψQm, Finset.mul_sum]
    refine Finset.sum_congr rfl fun i hi => ?_
    have hi' := Finset.mem_range.mp hi
    rw [← hw i hi', map_mul, map_pow, ← huT,
      show (RatFunc.X : RatFunc Ω) ^ K = RatFunc.X ^ (K - i) * RatFunc.X ^ i by
        rw [← pow_add, Nat.sub_add_cancel hi'.le]]
    ring
  have hxmR : xm ∈ wcEbRing W a := by
    rw [hxm_eq]
    exact sum_mem fun i _ => mul_mem (hκR _) (pow_mem huR _)
  have hxx : x = ψ Qp + xm := by rw [hxm_def]; ring
  rw [hxx]
  exact add_mem (hψR Qp) hxmR

theorem wcpa_dj_lr1k_eb_an_exhaustion : ∀ (K L : Type u) [Field K] [Field L] [Algebra K L]
    [FiniteDimensional K L] [Algebra.IsSeparable K L] (R : Subring K),
    (∀ x : K, IsIntegral ↥R x → x ∈ R) →
    ∀ (𝔫 : Ideal ↥R) (V : ValuationSubring K), R ≤ V.toSubring →
    (∀ r ∈ 𝔫, V.valuation (r : K) < 1) →
    letI : Algebra ↥R L := ((algebraMap K L).comp R.subtype).toAlgebra
    ∀ (n : ℕ) (𝔮 : Fin n → Ideal ↥(integralClosure ↥R L)), (∀ j, (𝔮 j).IsPrime) →
    (∀ j, (𝔮 j).comap (algebraMap ↥R ↥(integralClosure ↥R L)) = 𝔫) →
    (∀ V' : ValuationSubring L, V'.comap (algebraMap K L) = V →
      ∃ j, ∀ s : ↥(integralClosure ↥R L), s ∈ 𝔮 j ↔ V'.valuation (s : L) < 1) →
    ∀ 𝔮' : Ideal ↥(integralClosure ↥R L), 𝔮'.IsPrime →
      𝔮'.comap (algebraMap ↥R ↥(integralClosure ↥R L)) = 𝔫 → ∃ j, 𝔮' = 𝔮 j :=
by
  intro K L _ _ _ _ _ R hR 𝔫 V hRV h𝔫 n 𝔮 h𝔮 hcomap hcov 𝔮' h𝔮' hcomap'
  classical

  have hcrux : ∀ (Vb : ValuationSubring K) (t : L), IsIntegral K t →
      (∀ i, (minpoly K t).coeff i ∈ Vb) → Vb.valuation ((minpoly K t).coeff 0) < 1 →
      ∃ V' : ValuationSubring L, V'.comap (algebraMap K L) = Vb ∧ V'.valuation t < 1 := by
    intro Vb t hint hcoef hc0
    set f := minpoly K t with hf
    have hfm : f.Monic := minpoly.monic hint
    have hlift : f ∈ Polynomial.lifts Vb.subtype := by
      rw [Polynomial.lifts_iff_coeff_lifts]
      intro k; exact ⟨⟨_, hcoef k⟩, rfl⟩
    obtain ⟨fV, hfV, -, hfVm⟩ := Polynomial.lifts_and_natDegree_eq_and_monic hlift hfm
    have hc₀ : ((fV.coeff 0 : Vb) : K) = f.coeff 0 := by
      rw [← hfV, Polynomial.coeff_map]; rfl
    have hc₀m : fV.coeff 0 ∈ IsLocalRing.maximalIdeal Vb := by
      rw [ValuationSubring.valuation_lt_one_iff, hc₀]; exact hc0
    set ι : Vb →+* L := (algebraMap K L).comp Vb.subtype with hι
    set ε : Polynomial Vb →+* L := Polynomial.eval₂RingHom ι t with hε
    set χ₀ : Polynomial Vb →+* IsLocalRing.ResidueField Vb :=
      (IsLocalRing.residue Vb).comp Polynomial.constantCoeff with hχ₀
    have hker : RingHom.ker ε.rangeRestrict ≤ RingHom.ker χ₀ := by
      intro p hp
      rw [RingHom.mem_ker] at hp ⊢
      have hp' : ε p = 0 := by
        have := congrArg Subtype.val hp
        simpa using this
      have hdvd : f ∣ p.map Vb.subtype := by
        apply minpoly.dvd
        rw [Polynomial.aeval_def, Polynomial.eval₂_map]
        exact hp'
      have hr : p %ₘ fV = 0 := by
        apply Polynomial.map_injective Vb.subtype Subtype.val_injective
        rw [Polynomial.map_modByMonic _ hfVm, hfV, Polynomial.map_zero]
        exact (Polynomial.modByMonic_eq_zero_iff_dvd hfm).mpr hdvd
      have hpq : p = fV * (p /ₘ fV) := by
        conv_lhs => rw [← Polynomial.modByMonic_add_div p fV]
        rw [hr, zero_add]
      rw [hpq, map_mul]
      have : χ₀ fV = 0 := by
        show IsLocalRing.residue Vb (Polynomial.constantCoeff fV) = 0
        rw [IsLocalRing.residue_eq_zero_iff, Polynomial.constantCoeff_apply]
        exact hc₀m
      rw [this, zero_mul]
    haveI : (RingHom.ker χ₀).IsPrime := RingHom.ker_isPrime χ₀
    haveI hP : ((RingHom.ker χ₀).map ε.rangeRestrict).IsPrime :=
      Ideal.map_isPrime_of_surjective ε.rangeRestrict_surjective hker
    have hmemP : ∀ p, χ₀ p = 0 → ε.rangeRestrict p ∈ (RingHom.ker χ₀).map ε.rangeRestrict :=
      fun p hp => Ideal.mem_map_of_mem _ (RingHom.mem_ker.mpr hp)
    obtain ⟨V', hBV'⟩ := LocalSubring.exists_le_valuationSubring
      (LocalSubring.ofPrime ε.range ((RingHom.ker χ₀).map ε.rangeRestrict))
    obtain ⟨hle, hloc⟩ := LocalSubring.le_def.mp hBV'
    have hAB := LocalSubring.le_ofPrime ε.range ((RingHom.ker χ₀).map ε.rangeRestrict)
    have hAV' : ∀ y ∈ ε.range, y ∈ V' := fun y hy => hle (hAB hy)
    have hkey : ∀ x ∈ (RingHom.ker χ₀).map ε.rangeRestrict, V'.valuation (x : L) < 1 := by
      intro x hx
      have h1 := (IsLocalization.AtPrime.to_map_mem_maximal_iff
        (LocalSubring.ofPrime ε.range ((RingHom.ker χ₀).map ε.rangeRestrict)).toSubring
        ((RingHom.ker χ₀).map ε.rangeRestrict) x).mpr hx
      have hxV' : (x : L) ∈ V' := hAV' x x.2
      rcases lt_or_eq_of_le ((V'.valuation_le_one_iff (x : L)).mpr hxV') with h | h
      · exact h
      · exfalso
        have hx0 : (x : L) ≠ 0 := by
          intro h0; rw [h0, map_zero] at h; exact zero_ne_one h
        have hinv : (x : L)⁻¹ ∈ V' := by
          rw [← V'.valuation_le_one_iff, map_inv₀, h, inv_one]
        have hu : IsUnit (Subring.inclusion hle (algebraMap _ _ x)) := by
          refine IsUnit.of_mul_eq_one (⟨(x : L)⁻¹, hinv⟩ : V'.toLocalSubring.toSubring) ?_
          apply Subtype.ext
          show (x : L) * (x : L)⁻¹ = 1
          exact mul_inv_cancel₀ hx0
        have hu' := hloc.map_nonunit _ hu
        exact (IsLocalRing.mem_maximalIdeal _).mp h1 hu'
    refine ⟨V', ?_, ?_⟩
    · ext x
      rw [ValuationSubring.mem_comap]
      constructor
      · intro hx
        by_contra hxV
        have hx0 : x ≠ 0 := by rintro rfl; exact hxV Vb.zero_mem
        have hgt : 1 < Vb.valuation x := by
          rw [← not_le, Vb.valuation_le_one_iff]; exact hxV
        have hinvV : x⁻¹ ∈ Vb := (Vb.mem_or_inv_mem x).resolve_left hxV
        have hinvm : (⟨x⁻¹, hinvV⟩ : Vb) ∈ IsLocalRing.maximalIdeal Vb := by
          rw [ValuationSubring.valuation_lt_one_iff]
          show Vb.valuation x⁻¹ < 1
          rw [map_inv₀]
          exact inv_lt_one_of_one_lt₀ hgt
        have h2 := hkey _ (hmemP (Polynomial.C ⟨x⁻¹, hinvV⟩) (by
          show IsLocalRing.residue Vb (Polynomial.constantCoeff (Polynomial.C _)) = 0
          rw [IsLocalRing.residue_eq_zero_iff]
          simpa using hinvm))
        have h3 : V'.valuation (algebraMap K L x) ≤ 1 := (V'.valuation_le_one_iff _).mpr hx
        have h2' : V'.valuation (algebraMap K L x⁻¹) < 1 := by
          have : ((ε.rangeRestrict (Polynomial.C ⟨x⁻¹, hinvV⟩) : ε.range) : L) =
              algebraMap K L x⁻¹ := by
            simp [hε, hι]
          rw [this] at h2; exact h2
        have h4 : V'.valuation (algebraMap K L x) * V'.valuation (algebraMap K L x⁻¹) = 1 := by
          rw [← map_mul, ← map_mul, mul_inv_cancel₀ hx0, map_one, map_one]
        have h5 : V'.valuation (algebraMap K L x) * V'.valuation (algebraMap K L x⁻¹) < 1 :=
          lt_of_le_of_lt (mul_le_of_le_one_left' h3) h2'
        rw [h4] at h5
        exact lt_irrefl _ h5
      · intro hx
        apply hAV'
        refine ⟨Polynomial.C ⟨x, hx⟩, ?_⟩
        simp [hε, hι]
    · have h2 := hkey _ (hmemP Polynomial.X (by
        show IsLocalRing.residue Vb (Polynomial.constantCoeff Polynomial.X) = 0
        simp))
      have : ((ε.rangeRestrict Polynomial.X : ε.range) : L) = t := by
        simp [hε]
      rw [this] at h2; exact h2
  letI : Algebra ↥R L := ((algebraMap K L).comp R.subtype).toAlgebra
  haveI : IsScalarTower ↥R K L := IsScalarTower.of_algebraMap_eq' rfl
  by_contra hne
  push_neg at hne

  have hinc : ∀ j, ¬ (𝔮' ≤ 𝔮 j) := by
    intro j hle
    have hlt : 𝔮' < 𝔮 j := lt_of_le_of_ne hle (hne j)
    obtain ⟨x, hxj, hx'⟩ := SetLike.exists_of_lt hlt
    have := Ideal.under_lt_under_of_integral_mem_sdiff (R := ↥R) hle ⟨hxj, hx'⟩
      (Algebra.IsIntegral.isIntegral x)
    rw [Ideal.under_def, Ideal.under_def, hcomap', hcomap j] at this
    exact lt_irrefl _ this
  obtain ⟨s, hs𝔮', hs⟩ : ∃ s ∈ 𝔮', ∀ j, s ∉ 𝔮 j := by
    rcases Nat.eq_zero_or_pos n with hn | hn
    · subst hn
      exact ⟨0, 𝔮'.zero_mem, fun j => Fin.elim0 j⟩
    · have hnot : ¬ ((𝔮' : Set (integralClosure ↥R L)) ⊆
          ⋃ i ∈ ((Finset.univ : Finset (Fin n)) : Set (Fin n)),
            ((𝔮 i : Ideal _) : Set (integralClosure ↥R L))) := by
        rw [Ideal.subset_union_prime ⟨0, hn⟩ ⟨0, hn⟩ (fun i _ _ _ => h𝔮 i)]
        rintro ⟨i, -, hi⟩
        exact hinc i hi
      rw [Set.not_subset] at hnot
      obtain ⟨s, hs1, hs2⟩ := hnot
      refine ⟨s, hs1, fun j hj => hs2 ?_⟩
      simp only [Finset.coe_univ, Set.mem_univ, Set.iUnion_true, Set.mem_iUnion]
      exact ⟨j, hj⟩

  have hsint : IsIntegral ↥R (s : L) := s.2
  have hcoef : ∀ i, (minpoly K (s : L)).coeff i ∈ R := by
    obtain ⟨p, hpm, hp⟩ := hsint
    have hpK : Polynomial.aeval (s : L) (p.map (algebraMap ↥R K)) = 0 := by
      rw [Polynomial.aeval_map_algebraMap, Polynomial.aeval_def]; exact hp
    have hKint : IsIntegral K (s : L) := ⟨_, hpm.map _, by rwa [Polynomial.aeval_def] at hpK⟩
    have hdvd : minpoly K (s : L) ∣ p.map (algebraMap ↥R K) := minpoly.dvd K _ hpK
    intro i
    exact hR _ (Polynomial.isIntegral_coeff_of_dvd p _ hpm (minpoly.monic hKint) hdvd i)

  have hlift : minpoly K (s : L) ∈ Polynomial.lifts R.subtype := by
    rw [Polynomial.lifts_iff_coeff_lifts]
    intro i; exact ⟨⟨_, hcoef i⟩, rfl⟩
  obtain ⟨fR, hfR⟩ := Polynomial.mem_lifts _ |>.mp hlift
  have hc : algebraMap ↥R ↥(integralClosure ↥R L) (fR.coeff 0) ∈ 𝔮' := by
    have h0 : Polynomial.aeval s fR = 0 := by
      apply Subtype.val_injective
      rw [Polynomial.aeval_subalgebra_coe, ZeroMemClass.coe_zero]
      rw [← Polynomial.aeval_map_algebraMap K]
      have : fR.map (algebraMap ↥R K) = minpoly K (s : L) := hfR
      rw [this, minpoly.aeval]
    have hsplit := Polynomial.divX_mul_X_add fR
    have h1 : Polynomial.aeval s (fR.divX * Polynomial.X + Polynomial.C (fR.coeff 0)) = 0 := by
      rw [hsplit]; exact h0
    rw [map_add, map_mul, Polynomial.aeval_X, Polynomial.aeval_C] at h1
    have h2 : algebraMap ↥R ↥(integralClosure ↥R L) (fR.coeff 0) =
        -(Polynomial.aeval s fR.divX * s) := eq_neg_of_add_eq_zero_right h1
    rw [h2]
    exact 𝔮'.neg_mem (𝔮'.mul_mem_left _ hs𝔮')
  have hc𝔫 : fR.coeff 0 ∈ 𝔫 := by
    rw [← hcomap', Ideal.mem_comap]; exact hc
  have hc0 : V.valuation ((minpoly K (s : L)).coeff 0) < 1 := by
    have : ((fR.coeff 0 : ↥R) : K) = (minpoly K (s : L)).coeff 0 := by
      rw [← hfR, Polynomial.coeff_map]; rfl
    rw [← this]; exact h𝔫 _ hc𝔫

  obtain ⟨V', hV', hv⟩ := hcrux V (s : L) (Algebra.IsIntegral.isIntegral _)
    (fun i => hRV (hcoef i)) hc0
  obtain ⟨j, hj⟩ := hcov V' hV'
  exact hs j ((hj s).mpr hv)

theorem wcpa_dj_lr1k_eb_an_monogenic_chart : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω) (L : Type u) [Field L] [Algebra (RatFunc Ω) L]
    [FiniteDimensional (RatFunc Ω) L] [Algebra.IsSeparable (RatFunc Ω) L] (a : ↥W),
    a ≠ 0 → a ∈ IsLocalRing.maximalIdeal ↥W →
    letI : Algebra ↥(wcEbRing W a) L :=
      ((algebraMap (RatFunc Ω) L).comp (wcEbRing W a).subtype).toAlgebra
    ∀ (𝔮 : Ideal ↥(integralClosure ↥(wcEbRing W a) L)) [𝔮.IsPrime],
      𝔮.comap (algebraMap ↥(wcEbRing W a) ↥(integralClosure ↥(wcEbRing W a) L)) = wcEbNode W a →
      wcEbAnMonoData W a L 𝔮 →
      wcEbChart W ((algebraMap ↥(wcEbRing W a) ↥(integralClosure ↥(wcEbRing W a) L)).comp
        (wcEbW W a)) 𝔮 :=
by
  have wcpa_dj_nc_residue_algclosed : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), IsAlgClosed (IsLocalRing.ResidueField ↥W) := by
    intro Ω _ _ W
    classical
    refine IsAlgClosed.of_exists_root _ ?_
    intro pb hmon hirr
    have hdeg : 0 < pb.degree := Polynomial.degree_pos_of_irreducible hirr
    have hlift : pb ∈ Polynomial.lifts (IsLocalRing.residue ↥W) := by
      rw [Polynomial.mem_lifts]
      exact Polynomial.map_surjective _ IsLocalRing.residue_surjective pb
    obtain ⟨p, hpmap, hpdeg, hpmon⟩ := Polynomial.lifts_and_degree_eq_and_monic hlift hmon
    have hPdeg : (p.map (algebraMap ↥W Ω)).degree ≠ 0 := by
      rw [hpmon.degree_map, hpdeg]
      exact ne_of_gt hdeg
    obtain ⟨x, hx⟩ := IsAlgClosed.exists_root _ hPdeg
    have hx' : Polynomial.eval x (p.map (algebraMap ↥W Ω)) = 0 := hx
    have hint : IsIntegral ↥W x := ⟨p, hpmon, by rw [← Polynomial.eval_map]; exact hx'⟩
    obtain ⟨y, hy⟩ := IsIntegrallyClosed.isIntegral_iff.mp hint
    have hpy : p.eval y = 0 := by
      apply IsFractionRing.injective ↥W Ω
      rw [map_zero, ← Polynomial.eval_map_apply, hy]
      exact hx'
    refine ⟨IsLocalRing.residue ↥W y, ?_⟩
    rw [← hpmap, Polynomial.eval_map_apply, hpy, map_zero]
  have wcpa_dj_lus_tbw_node_ring_normal : ∀ (K : Type u) [Field K] (R : ValuationSubring K) (a : ↥R), a ≠ 0 → IsDomain (wcNcRing R a) ∧ IsIntegrallyClosed (wcNcRing R a) := by

    have S1 : ∀ (A N : Type u) [CommRing A] [CommRing N] [Algebra A N] (a : A) (u v : N),
        u * v = algebraMap A N a →
        (∀ r : A, ∃ F G : Polynomial A,
          algebraMap A N r = Polynomial.aeval u F + v * Polynomial.aeval v G) ∧
        (∀ n₁ n₂ : N, (∃ F G : Polynomial A, n₁ = Polynomial.aeval u F + v * Polynomial.aeval v G) →
          (∃ F G : Polynomial A, n₂ = Polynomial.aeval u F + v * Polynomial.aeval v G) →
          ∃ F G : Polynomial A, n₁ + n₂ = Polynomial.aeval u F + v * Polynomial.aeval v G) ∧
        (∀ n : N, (∃ F G : Polynomial A, n = Polynomial.aeval u F + v * Polynomial.aeval v G) →
          ∃ F G : Polynomial A, n * u = Polynomial.aeval u F + v * Polynomial.aeval v G) ∧
        (∀ n : N, (∃ F G : Polynomial A, n = Polynomial.aeval u F + v * Polynomial.aeval v G) →
          ∃ F G : Polynomial A, n * v = Polynomial.aeval u F + v * Polynomial.aeval v G) := by
      intro A N _ _ _ a u v huv
      refine ⟨fun r => ⟨Polynomial.C r, 0, by simp⟩, ?_, ?_, ?_⟩
      · rintro n₁ n₂ ⟨F₁, G₁, rfl⟩ ⟨F₂, G₂, rfl⟩
        exact ⟨F₁ + F₂, G₁ + G₂, by simp only [map_add]; ring⟩
      · rintro n ⟨F, G, rfl⟩
        have hG := congrArg (Polynomial.aeval v) (Polynomial.X_mul_divX_add G)
        simp only [map_add, map_mul, Polynomial.aeval_X, Polynomial.aeval_C] at hG
        refine ⟨Polynomial.X * F + Polynomial.C (a * G.coeff 0), Polynomial.C a * G.divX, ?_⟩
        simp only [map_add, map_mul, Polynomial.aeval_X, Polynomial.aeval_C]
        linear_combination (Polynomial.aeval v G) * huv - (algebraMap A N a) * hG
      · rintro n ⟨F, G, rfl⟩
        have hF := congrArg (Polynomial.aeval u) (Polynomial.X_mul_divX_add F)
        simp only [map_add, map_mul, Polynomial.aeval_X, Polynomial.aeval_C] at hF
        refine ⟨Polynomial.C a * F.divX, Polynomial.C (F.coeff 0) + Polynomial.X * G, ?_⟩
        simp only [map_add, map_mul, Polynomial.aeval_X, Polynomial.aeval_C]
        linear_combination ((Polynomial.aeval u) F.divX) * huv - v * hF

    have S2 : ∀ (K : Type u) [Field K] (R : ValuationSubring K) (a : ↥R) (p q : LaurentPolynomial ↥R),
        p * q = LaurentPolynomial.C a →
        ∃ θ : wcNcRing R a →+* LaurentPolynomial ↥R,
          (∀ r : ↥R, θ (algebraMap (↥R) (wcNcRing R a) r) = LaurentPolynomial.C r) ∧
          θ (Ideal.Quotient.mk (wcNcIdeal R a) (MvPolynomial.X 0)) = p ∧
          θ (Ideal.Quotient.mk (wcNcIdeal R a) (MvPolynomial.X 1)) = q := by
      intro K _ R a p q hpq
      let Φ : MvPolynomial (Fin 2) ↥R →+* LaurentPolynomial ↥R :=
        MvPolynomial.eval₂Hom LaurentPolynomial.C ![p, q]
      have hle : ∀ z ∈ wcNcIdeal R a, Φ z = 0 := by
        intro z hz
        have : wcNcIdeal R a ≤ RingHom.ker Φ := by
          rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker]
          simp [Φ, hpq]
        exact this hz
      refine ⟨Ideal.Quotient.lift _ Φ hle, ?_, ?_, ?_⟩
      · intro r
        rw [← Ideal.Quotient.mk_algebraMap, Ideal.Quotient.lift_mk, MvPolynomial.algebraMap_eq]
        simp [Φ]
      · rw [Ideal.Quotient.lift_mk]; simp [Φ]
      · rw [Ideal.Quotient.lift_mk]; simp [Φ]

    have S3 : ∀ (A : Type u) [CommRing A] [IsDomain A] (F Q : Polynomial A), Q.coeff 0 = 0 →
        Polynomial.toLaurent F + LaurentPolynomial.invert (Polynomial.toLaurent Q) = 0 →
        F = 0 ∧ Q = 0 := by
      intro A _ _ F Q hQ0 h
      have h1 : Polynomial.toLaurent (F * Polynomial.X ^ Q.natDegree + Q.reverse) = 0 := by
        rw [map_add, map_mul, Polynomial.toLaurent_X_pow, LaurentPolynomial.toLaurent_reverse,
          ← add_mul, h, zero_mul]
      have h2 : F * Polynomial.X ^ Q.natDegree + Q.reverse = 0 := by
        apply Polynomial.toLaurent_injective; rw [h1, map_zero]
      have hF : F = 0 := by
        ext j
        have h3 := congrArg (fun p => Polynomial.coeff p (j + Q.natDegree)) h2
        simp only [Polynomial.coeff_add, Polynomial.coeff_mul_X_pow, Polynomial.coeff_zero] at h3
        rw [Polynomial.coeff_zero]
        rcases j with _ | k
        · rw [Polynomial.coeff_reverse, zero_add, Polynomial.revAt_le le_rfl, Nat.sub_self, hQ0,
            add_zero] at h3
          exact h3
        · rw [Polynomial.coeff_eq_zero_of_natDegree_lt (p := Q.reverse), add_zero] at h3
          · exact h3
          · exact lt_of_le_of_lt (Polynomial.reverse_natDegree_le Q) (by omega)
      refine ⟨hF, ?_⟩
      rw [hF, zero_mul, zero_add, Polynomial.reverse_eq_zero] at h2
      exact h2

    have S4 : ∀ (A N : Type u) [CommRing A] [CommRing N] [Algebra A N] (a : A) (x y : N)
        (θ : N →+* LaurentPolynomial A), (∀ r : A, θ (algebraMap A N r) = LaurentPolynomial.C r) →
        θ x = LaurentPolynomial.T 1 → θ y = LaurentPolynomial.C a * LaurentPolynomial.T (-1) →
        ∀ F G : Polynomial A,
        θ (Polynomial.aeval x F + y * Polynomial.aeval y G) = Polynomial.toLaurent F +
          LaurentPolynomial.invert (Polynomial.toLaurent ((Polynomial.X * G).comp
            (Polynomial.C a * Polynomial.X))) := by
      intro A N _ _ _ a x y θ hC hx hy F G
      have e1 : θ.comp (Polynomial.aeval x).toRingHom = Polynomial.toLaurent := by
        apply Polynomial.ringHom_ext
        · intro r; simp [hC]
        · simp [hx]
      have e2 : θ.comp (Polynomial.aeval y).toRingHom =
          ((LaurentPolynomial.invert (R := A)).toRingEquiv.toRingHom).comp
            (Polynomial.toLaurent.comp (Polynomial.compRingHom (Polynomial.C a * Polynomial.X))) := by
        apply Polynomial.ringHom_ext
        · intro r; simp [hC]
        · simp [hy]
      rw [show y * Polynomial.aeval y G = Polynomial.aeval y (Polynomial.X * G) by simp, map_add]
      have h1 := RingHom.congr_fun e1 F
      have h2 := RingHom.congr_fun e2 (Polynomial.X * G)
      simp only [RingHom.comp_apply] at h1 h2
      simp only [AlgHom.toRingHom_eq_coe, RingHom.coe_coe] at h1 h2
      rw [h1, h2]
      simp

    have S5 : ∀ (A N : Type u) [CommRing A] [IsDomain A] [IsIntegrallyClosed A] [CommRing N]
        [Algebra A N] (x : N) (θ : N →+* LaurentPolynomial A),
        (∀ r : A, θ (algebraMap A N r) = LaurentPolynomial.C r) →
        θ x = LaurentPolynomial.T 1 → Function.Injective θ →
        IsIntegrallyClosed (Localization (Submonoid.powers x)) := by
      intro A N _ _ _ _ _ x θ hC hx hinj
      letI : Algebra N (LaurentPolynomial A) := θ.toAlgebra
      have hθ : ∀ f : Polynomial A, θ (Polynomial.aeval x f) = Polynomial.toLaurent f := by
        intro f
        have e : θ.comp (Polynomial.aeval x).toRingHom = Polynomial.toLaurent := by
          apply Polynomial.ringHom_ext
          · intro r; simp [hC]
          · simp [hx]
        have := RingHom.congr_fun e f
        simpa using this
      have : IsLocalization.Away x (LaurentPolynomial A) := by
        apply IsLocalization.Away.mk
        · rw [RingHom.algebraMap_toAlgebra, hx]; exact LaurentPolynomial.isUnit_T 1
        · intro s
          obtain ⟨n, f, hf⟩ := LaurentPolynomial.exists_T_pow s
          refine ⟨n, Polynomial.aeval x f, ?_⟩
          rw [RingHom.algebraMap_toAlgebra, hx, hθ, hf, LaurentPolynomial.T_pow]
          simp
        · intro a b h
          refine ⟨0, ?_⟩
          rw [RingHom.algebraMap_toAlgebra] at h
          rw [hinj h]
      have : IsIntegrallyClosed (LaurentPolynomial A) :=
        isIntegrallyClosed_of_isLocalization (LaurentPolynomial A)
          (Submonoid.powers (Polynomial.X : Polynomial A))
          (powers_le_nonZeroDivisors_of_noZeroDivisors Polynomial.X_ne_zero)
      exact IsIntegrallyClosed.of_equiv (IsLocalization.algEquiv (Submonoid.powers x)
        (LaurentPolynomial A) (Localization (Submonoid.powers x))).toRingEquiv

    have S6 : ∀ (A N : Type u) [CommRing A] [CommRing N] [Algebra A N] (a : A) (x y : N),
        x * y = algebraMap A N a →
        (∀ n : N, ∃ F G : Polynomial A, n = Polynomial.aeval x F + y * Polynomial.aeval y G) →
        (∀ F G : Polynomial A, Polynomial.aeval x F + y * Polynomial.aeval y G = 0 → F = 0 ∧ G = 0) →
        ∀ n n' : N, y * n = x * n' → ∃ m : N, n = x * m := by
      intro A N _ _ _ a x y hxy hnf U n n' h
      obtain ⟨F, G, rfl⟩ := hnf n
      obtain ⟨F', G', rfl⟩ := hnf n'
      have hF := congrArg (Polynomial.aeval x) (Polynomial.X_mul_divX_add F)
      simp only [map_add, map_mul, Polynomial.aeval_X, Polynomial.aeval_C] at hF
      have hG' := congrArg (Polynomial.aeval y) (Polynomial.X_mul_divX_add G')
      simp only [map_add, map_mul, Polynomial.aeval_X, Polynomial.aeval_C] at hG'
      have hNF : Polynomial.aeval x (Polynomial.C a * F.divX - Polynomial.X * F' -
          Polynomial.C (a * G'.coeff 0)) + y * Polynomial.aeval y (Polynomial.C (F.coeff 0) +
          Polynomial.X * G - Polynomial.C a * G'.divX) = 0 := by
        simp only [map_add, map_sub, map_mul, Polynomial.aeval_X, Polynomial.aeval_C]
        linear_combination h + y * hF - x * y * hG' + (algebraMap A N (G'.coeff 0) +
          y * Polynomial.aeval y G'.divX - Polynomial.aeval x F.divX) * hxy
      have hP2 := congrArg (Polynomial.aeval y) (U _ _ hNF).2
      simp only [map_add, map_sub, map_mul, Polynomial.aeval_X, Polynomial.aeval_C, map_zero] at hP2
      refine ⟨Polynomial.aeval x F.divX + y * Polynomial.aeval y G'.divX, ?_⟩
      linear_combination hP2 - hF - Polynomial.aeval y G'.divX * hxy

    have S7 : ∀ (N : Type u) [CommRing N] (x y : N), (∀ n : N, x * n = 0 → n = 0) →
        (∀ n n' : N, y * n = x * n' → ∃ m : N, n = x * m) →
        ∀ (i j : ℕ) (n₁ n₂ : N), y ^ j * n₁ = x ^ i * n₂ → ∃ m : N, n₁ = x ^ i * m := by
      intro N _ x y hnzd hdiv
      have aux : ∀ (j : ℕ) (n n'' : N), y ^ j * n = x * n'' → ∃ m, n = x * m := by
        intro j
        induction j with
        | zero => intro n n'' h; exact ⟨n'', by simpa using h⟩
        | succ j ih =>
          intro n n'' h
          obtain ⟨m₁, hm₁⟩ := hdiv (y ^ j * n) n'' (by rw [← h]; ring)
          exact ih n m₁ hm₁
      intro i
      induction i with
      | zero => intro j n₁ n₂ _; exact ⟨n₁, by simp⟩
      | succ i ih =>
        intro j n₁ n₂ h
        obtain ⟨m₁, hm₁⟩ := aux j n₁ (x ^ i * n₂) (by rw [h]; ring)
        have h2 : y ^ j * m₁ = x ^ i * n₂ := by
          have h3 : x * (y ^ j * m₁ - x ^ i * n₂) = 0 := by
            rw [hm₁] at h
            linear_combination h
          exact sub_eq_zero.mp (hnzd _ h3)
        obtain ⟨m, hm⟩ := ih j m₁ n₂ h2
        exact ⟨m, by rw [hm₁, hm]; ring⟩

    have S8 : ∀ (N : Type u) [CommRing N] [IsDomain N] (x y : N), x ≠ 0 → y ≠ 0 →
        IsIntegrallyClosed (Localization (Submonoid.powers x)) →
        IsIntegrallyClosed (Localization (Submonoid.powers y)) →
        (∀ (i j : ℕ) (n₁ n₂ : N), y ^ j * n₁ = x ^ i * n₂ → ∃ m : N, n₁ = x ^ i * m) →
        IsIntegrallyClosed N := by
      intro N _ _ x y hx hy hLx hLy hcop
      have hS : ∀ i, (![Submonoid.powers x, Submonoid.powers y] : Fin 2 → Submonoid N) i ≤
          nonZeroDivisors N := by
        intro i; fin_cases i
        · exact powers_le_nonZeroDivisors_of_noZeroDivisors hx
        · exact powers_le_nonZeroDivisors_of_noZeroDivisors hy
      refine IsIntegrallyClosed.of_localization_submonoid _ hS ?_ ?_
      · intro i; fin_cases i
        · exact hLx
        · exact hLy
      · apply le_antisymm _ bot_le
        intro z hz
        rw [Algebra.mem_iInf] at hz
        obtain ⟨b, s, hs, hz1⟩ := hz 0
        obtain ⟨c, t, ht, hz2⟩ := hz 1
        simp only [Matrix.cons_val_zero, Matrix.cons_val_one] at hs ht
        obtain ⟨i, rfl⟩ := hs
        obtain ⟨j, rfl⟩ := ht
        rw [hz1, IsLocalization.mk'_eq_iff_eq] at hz2
        have h3 := IsFractionRing.injective N (FractionRing N) hz2
        obtain ⟨m, hm⟩ := hcop i j b c (by simpa using h3)
        rw [Algebra.mem_bot]
        refine ⟨m, ?_⟩
        rw [hz1]
        simp only [hm]
        exact (IsLocalization.mk'_mul_cancel_left m ⟨x ^ i, _⟩).symm

    intro K _ R a ha
    set x : wcNcRing R a := Ideal.Quotient.mk (wcNcIdeal R a) (MvPolynomial.X 0) with hxdef
    set y : wcNcRing R a := Ideal.Quotient.mk (wcNcIdeal R a) (MvPolynomial.X 1) with hydef
    have hxy : x * y = algebraMap ↥R (wcNcRing R a) a := by
      rw [hxdef, hydef, ← map_mul, ← Ideal.Quotient.mk_algebraMap, MvPolynomial.algebraMap_eq,
        Ideal.Quotient.eq]
      exact Ideal.subset_span (Set.mem_singleton _)
    have hyx : y * x = algebraMap ↥R (wcNcRing R a) a := (mul_comm y x).trans hxy
    have hnf : ∀ n : wcNcRing R a,
        (∃ F G : Polynomial ↥R, n = Polynomial.aeval x F + y * Polynomial.aeval y G) ∧
        (∃ F G : Polynomial ↥R, n = Polynomial.aeval y F + x * Polynomial.aeval x G) := by
      obtain ⟨c1, a1, mu1, mv1⟩ := S1 ↥R (wcNcRing R a) a x y hxy
      obtain ⟨c2, a2, mu2, mv2⟩ := S1 ↥R (wcNcRing R a) a y x hyx
      intro n
      obtain ⟨P, rfl⟩ := Ideal.Quotient.mk_surjective n
      refine MvPolynomial.induction_on (motive := fun P =>
        (∃ F G : Polynomial ↥R, Ideal.Quotient.mk (wcNcIdeal R a) P =
          Polynomial.aeval x F + y * Polynomial.aeval y G) ∧
        (∃ F G : Polynomial ↥R, Ideal.Quotient.mk (wcNcIdeal R a) P =
          Polynomial.aeval y F + x * Polynomial.aeval x G)) P ?_ ?_ ?_
      · intro r
        rw [← MvPolynomial.algebraMap_eq, Ideal.Quotient.mk_algebraMap]
        exact ⟨c1 r, c2 r⟩
      · intro p q hp hq
        rw [map_add]
        exact ⟨a1 _ _ hp.1 hq.1, a2 _ _ hp.2 hq.2⟩
      · intro p i hp
        rw [map_mul]
        have hi : i = 0 ∨ i = 1 := by fin_cases i <;> simp
        rcases hi with rfl | rfl
        · exact ⟨mu1 _ hp.1, mv2 _ hp.2⟩
        · exact ⟨mv1 _ hp.1, mu2 _ hp.2⟩
    have hT : LaurentPolynomial.T 1 * (LaurentPolynomial.C a * LaurentPolynomial.T (-1)) =
        (LaurentPolynomial.C a : LaurentPolynomial ↥R) := by
      rw [mul_left_comm, ← LaurentPolynomial.T_add]; simp
    have hT' : LaurentPolynomial.C a * LaurentPolynomial.T (-1) * LaurentPolynomial.T 1 =
        (LaurentPolynomial.C a : LaurentPolynomial ↥R) := by
      rw [mul_comm]; exact hT
    obtain ⟨θx, hθxC, hθxx, hθxy⟩ := S2 K R a _ _ hT
    obtain ⟨θy, hθyC, hθyx, hθyy⟩ := S2 K R a _ _ hT'

    have huniq : ∀ (u v : wcNcRing R a) (θ : wcNcRing R a →+* LaurentPolynomial ↥R),
        (∀ r : ↥R, θ (algebraMap ↥R (wcNcRing R a) r) = LaurentPolynomial.C r) →
        θ u = LaurentPolynomial.T 1 → θ v = LaurentPolynomial.C a * LaurentPolynomial.T (-1) →
        ∀ F G : Polynomial ↥R, θ (Polynomial.aeval u F + v * Polynomial.aeval v G) = 0 →
        F = 0 ∧ G = 0 := by
      intro u v θ hC hu hv F G h
      rw [S4 ↥R (wcNcRing R a) a u v θ hC hu hv F G] at h
      have hQ0 : ((Polynomial.X * G).comp (Polynomial.C a * Polynomial.X)).coeff 0 = 0 := by
        rw [Polynomial.mul_comp, Polynomial.X_comp, mul_assoc, Polynomial.coeff_C_mul,
          Polynomial.coeff_X_mul_zero, mul_zero]
      obtain ⟨hF, hQ⟩ := S3 ↥R F _ hQ0 h
      refine ⟨hF, ?_⟩
      rw [Polynomial.mul_comp, Polynomial.X_comp] at hQ
      have hCX : (Polynomial.C a * Polynomial.X : Polynomial ↥R) ≠ 0 :=
        mul_ne_zero (Polynomial.C_ne_zero.mpr ha) Polynomial.X_ne_zero
      have hGc := (mul_eq_zero.mp hQ).resolve_left hCX
      rcases Polynomial.comp_eq_zero_iff.mp hGc with hG | ⟨_, hG⟩
      · exact hG
      · exfalso
        apply hCX
        rw [hG]
        simp
    have hinj : ∀ (u v : wcNcRing R a) (θ : wcNcRing R a →+* LaurentPolynomial ↥R),
        (∀ r : ↥R, θ (algebraMap ↥R (wcNcRing R a) r) = LaurentPolynomial.C r) →
        θ u = LaurentPolynomial.T 1 → θ v = LaurentPolynomial.C a * LaurentPolynomial.T (-1) →
        (∀ n : wcNcRing R a, ∃ F G : Polynomial ↥R, n = Polynomial.aeval u F + v * Polynomial.aeval v G) →
        Function.Injective θ := by
      intro u v θ hC hu hv hn
      rw [injective_iff_map_eq_zero]
      intro n hn0
      obtain ⟨F, G, rfl⟩ := hn n
      obtain ⟨rfl, rfl⟩ := huniq u v θ hC hu hv F G hn0
      simp
    have hinjx := hinj x y θx hθxC hθxx hθxy (fun n => (hnf n).1)
    have hinjy := hinj y x θy hθyC hθyy hθyx (fun n => (hnf n).2)
    haveI hdom : IsDomain (wcNcRing R a) := Function.Injective.isDomain θx hinjx
    refine ⟨hdom, ?_⟩
    have hx0 : x ≠ 0 := by
      intro h
      have this : θx x = LaurentPolynomial.T 1 := hθxx
      rw [h, map_zero] at this
      exact (LaurentPolynomial.isUnit_T (R := ↥R) 1).ne_zero this.symm
    have hy0 : y ≠ 0 := by
      intro h
      have this : θy y = LaurentPolynomial.T 1 := hθyy
      rw [h, map_zero] at this
      exact (LaurentPolynomial.isUnit_T (R := ↥R) 1).ne_zero this.symm
    have hLx := S5 ↥R (wcNcRing R a) x θx hθxC hθxx hinjx
    have hLy := S5 ↥R (wcNcRing R a) y θy hθyC hθyy hinjy
    have hdiv := S6 ↥R (wcNcRing R a) a x y hxy (fun n => (hnf n).1)
      (fun F G h => huniq x y θx hθxC hθxx hθxy F G (by rw [h, map_zero]))
    have hcop := S7 (wcNcRing R a) x y (fun n h => (mul_eq_zero.mp h).resolve_left hx0) hdiv
    exact S8 (wcNcRing R a) x y hx0 hy0 hLx hLy hcop
  have s_loc_iso : ∀ (E A : Type u) [CommRing E] [CommRing A] [IsLocalRing A] [IsDomain A] (l : E →+* A), Function.Injective l → (∀ z : A, ∃ e₁ e₂ : E, IsUnit (l e₂) ∧ l e₁ = z * l e₂) → ∃ φ : Localization.AtPrime ((IsLocalRing.maximalIdeal A).comap l) ≃+* A, ∀ e : E, φ (algebraMap E (Localization.AtPrime ((IsLocalRing.maximalIdeal A).comap l)) e) = l e := by
    intro E A _ _ _ _ l hl hz
    have hg : ∀ y : ((IsLocalRing.maximalIdeal A).comap l).primeCompl, IsUnit (l y) := fun y =>
      IsLocalRing.notMem_maximalIdeal.mp (fun h => y.2 (Ideal.mem_comap.mpr h))
    let G : Localization.AtPrime ((IsLocalRing.maximalIdeal A).comap l) →+* A :=
      IsLocalization.lift (M := ((IsLocalRing.maximalIdeal A).comap l).primeCompl) hg
    have hinj : Function.Injective G := by
      rw [injective_iff_map_eq_zero]
      intro x hx
      obtain ⟨⟨e, t⟩, rfl⟩ := IsLocalization.mk'_surjective
        ((IsLocalRing.maximalIdeal A).comap l).primeCompl x
      have hx' : G (IsLocalization.mk' _ e t) = 0 := hx
      rw [IsLocalization.lift_mk'_spec, mul_zero, ← map_zero l] at hx'
      show IsLocalization.mk' _ e t = 0
      rw [hl hx', IsLocalization.mk'_zero]
    have hsurj : Function.Surjective G := by
      intro z
      obtain ⟨e₁, e₂, hu, he⟩ := hz z
      have hmem : e₂ ∈ ((IsLocalRing.maximalIdeal A).comap l).primeCompl := fun h =>
        (IsLocalRing.notMem_maximalIdeal.mpr hu) (Ideal.mem_comap.mp h)
      refine ⟨IsLocalization.mk' _ e₁ ⟨e₂, hmem⟩, ?_⟩
      show IsLocalization.lift hg (IsLocalization.mk' _ e₁ ⟨e₂, hmem⟩) = z
      rw [IsLocalization.lift_mk'_spec, he, mul_comm]
    refine ⟨RingEquiv.ofBijective G ⟨hinj, hsurj⟩, fun e => ?_⟩
    show IsLocalization.lift hg _ = l e
    exact IsLocalization.lift_eq hg e
  have s_std_rep : ∀ (R : Type u) [CommRing R] (P : StandardEtalePair R) (e : P.Ring), ∃ (k : ℕ) (q : Polynomial R), e * Polynomial.aeval P.X P.g ^ k = Polynomial.aeval P.X q := by
    intro R _ P e
    let π : Polynomial (Polynomial R) →+* P.Ring :=
      Ideal.Quotient.mk (Ideal.span {Polynomial.C P.f, Polynomial.X * Polynomial.C P.g - 1})
    have hC : ∀ q : Polynomial R, Polynomial.aeval P.X q = π (Polynomial.C q) := by
      intro q
      induction q using Polynomial.induction_on' with
      | add p q hp hq => rw [map_add, hp, hq, Polynomial.C_add, map_add]
      | monomial n r =>
        rw [Polynomial.aeval_monomial, ← Polynomial.C_mul_X_pow_eq_monomial, Polynomial.C_mul,
          Polynomial.C_pow, map_mul, map_pow]
        rfl
    have hGu : IsUnit (Polynomial.aeval P.X P.g) := (StandardEtalePair.hasMap_X : P.HasMap P.X).2
    have hYX : π Polynomial.X = ↑(hGu.unit⁻¹) := (StandardEtalePair.inv_aeval_X_g P).symm
    have hY : π Polynomial.X * Polynomial.aeval P.X P.g = 1 := by
      rw [hYX]
      exact IsUnit.val_inv_mul _
    obtain ⟨Q, rfl⟩ : ∃ Q, π Q = e := Ideal.Quotient.mk_surjective e
    induction Q using Polynomial.induction_on' with
    | add Q₁ Q₂ h₁ h₂ =>
      obtain ⟨k₁, q₁, hq₁⟩ := h₁
      obtain ⟨k₂, q₂, hq₂⟩ := h₂
      refine ⟨k₁ + k₂, q₁ * P.g ^ k₂ + q₂ * P.g ^ k₁, ?_⟩
      rw [map_add, map_add, map_mul, map_mul, map_pow, map_pow, ← hq₁, ← hq₂, pow_add]
      ring
    | monomial j q =>
      refine ⟨j, q, ?_⟩
      rw [← Polynomial.C_mul_X_pow_eq_monomial, map_mul, map_pow, ← hC, mul_assoc, ← mul_pow, hY,
        one_pow, mul_one]
  have s_origin_comap : ∀ {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (g : ↥W) (B : Type u) [CommRing B] [IsLocalRing B] (ψ : wcEbNg W g →+* B), wcEbNgOrigin W g ≤ (IsLocalRing.maximalIdeal B).comap ψ → (IsLocalRing.maximalIdeal B).comap ψ = wcEbNgOrigin W g := by
    intro Ω _ W g B _ _ ψ hO
    refine le_antisymm ?_ hO
    intro n hn
    let π : MvPolynomial (Fin 2) ↥W →+* wcEbNg W g :=
      Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g})
    obtain ⟨Q, rfl⟩ : ∃ Q, π Q = n := Ideal.Quotient.mk_surjective n
    set p₀ := MvPolynomial.constantCoeff Q with hp₀
    have hq : Q - MvPolynomial.C p₀ ∈ Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 2) ↥W),
        MvPolynomial.X 1} := by
      have h1 : Q - MvPolynomial.C p₀ ∈ Ideal.span
          ((MvPolynomial.X : Fin 2 → MvPolynomial (Fin 2) ↥W) '' Set.univ) := by
        rw [MvPolynomial.mem_ideal_span_X_image]
        intro m hm
        have hm0 : m ≠ 0 := by
          rintro rfl
          rw [MvPolynomial.mem_support_iff, MvPolynomial.coeff_sub, MvPolynomial.coeff_C,
            if_pos rfl, ← MvPolynomial.constantCoeff_eq, sub_self] at hm
          exact hm rfl
        obtain ⟨i, hi⟩ := Finsupp.ne_iff.mp hm0
        exact ⟨i, Set.mem_univ _, hi⟩
      refine Ideal.span_le.mpr ?_ h1
      rintro _ ⟨i, -, rfl⟩
      fin_cases i
      · exact Ideal.subset_span (by simp)
      · exact Ideal.subset_span (by simp)
    have hqO : π (Q - MvPolynomial.C p₀) ∈ wcEbNgOrigin W g :=
      Ideal.mem_map_of_mem _ (Ideal.mem_sup_left hq)
    have hp₀m : p₀ ∈ IsLocalRing.maximalIdeal ↥W := by
      by_contra hnm
      have hu : IsUnit (ψ (π (MvPolynomial.C p₀))) :=
        (((IsLocalRing.notMem_maximalIdeal.mp hnm).map
          (MvPolynomial.C (σ := Fin 2) (R := ↥W))).map π).map ψ
      have h2 := hO hqO
      rw [Ideal.mem_comap] at h2 hn
      have h3 : ψ (π (MvPolynomial.C p₀)) ∈ IsLocalRing.maximalIdeal B := by
        have := sub_mem hn h2
        rwa [← map_sub, ← map_sub, sub_sub_cancel] at this
      exact (IsLocalRing.notMem_maximalIdeal.mpr hu) h3
    have hCO : π (MvPolynomial.C p₀) ∈ wcEbNgOrigin W g :=
      Ideal.mem_map_of_mem _ (Ideal.mem_sup_right (Ideal.mem_map_of_mem _ hp₀m))
    have := add_mem hCO hqO
    rwa [← map_add, add_sub_cancel] at this
  have s_node_mod : ∀ {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (a : ↥W) (r : ↥(wcEbRing W a)), ∃ c : ↥W, r - wcEbW W a c ∈ wcEbNode W a := by
    intro Ω _ W a r
    obtain ⟨x, hx⟩ := r
    induction hx using Subring.closure_induction with
    | mem x hx =>
      rcases hx with ⟨w, rfl⟩ | hx
      · refine ⟨w, ?_⟩
        have : (⟨algebraMap Ω (RatFunc Ω) (w : Ω), _⟩ : ↥(wcEbRing W a)) - wcEbW W a w = 0 :=
          sub_eq_zero.mpr (Subtype.ext rfl)
        rw [this]
        exact zero_mem _
      · rcases hx with rfl | rfl
        · refine ⟨0, ?_⟩
          rw [map_zero, sub_zero]
          exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _))
        · refine ⟨0, ?_⟩
          rw [map_zero, sub_zero]
          exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert_of_mem _ rfl))
    | zero =>
      refine ⟨0, ?_⟩
      convert zero_mem (wcEbNode W a) using 1
      apply Subtype.ext
      simp
    | one =>
      refine ⟨1, ?_⟩
      convert zero_mem (wcEbNode W a) using 1
      apply Subtype.ext
      simp
    | add x y hx hy ihx ihy =>
      obtain ⟨c₁, h₁⟩ := ihx
      obtain ⟨c₂, h₂⟩ := ihy
      refine ⟨c₁ + c₂, ?_⟩
      have := add_mem h₁ h₂
      convert this using 1
      apply Subtype.ext
      simp only [map_add, AddSubgroupClass.coe_sub, AddMemClass.coe_add]
      ring
    | neg x hx ih =>
      obtain ⟨c, h⟩ := ih
      refine ⟨-c, ?_⟩
      have := neg_mem h
      convert this using 1
      apply Subtype.ext
      simp only [map_neg, AddSubgroupClass.coe_sub, NegMemClass.coe_neg]
      ring
    | mul x y hx hy ihx ihy =>
      obtain ⟨c₁, h₁⟩ := ihx
      obtain ⟨c₂, h₂⟩ := ihy
      refine ⟨c₁ * c₂, ?_⟩
      have := add_mem (Ideal.mul_mem_right (⟨y, hy⟩ : ↥(wcEbRing W a)) _ h₁)
        (Ideal.mul_mem_left _ (wcEbW W a c₁) h₂)
      convert this using 1
      apply Subtype.ext
      simp only [map_mul, AddSubgroupClass.coe_sub, AddMemClass.coe_add, MulMemClass.coe_mul]
      ring
  have s_scaled_integral : ∀ (R N A : Type u) [CommRing R] [CommRing N] [CommRing A] (α : R →+* A) (ψ : N →+* A) (ζ u : A) (f h : Polynomial N), f.Monic → Polynomial.eval₂ ψ ζ f = 0 → u = Polynomial.eval₂ ψ ζ h → (∀ r : R, ∃ (k : ℕ) (p : Polynomial N), u ^ k * α r = Polynomial.eval₂ ψ ζ p) → ∀ y : A, α.IsIntegralElem y → ∃ K : ℕ, ψ.IsIntegralElem (u ^ K * y) := by
    intro R N A _ _ _ α ψ ζ u f h hfm hfζ hu hR y ⟨Q, hQm, hQ⟩
    rcases subsingleton_or_nontrivial A with hA | hA
    · exact ⟨0, ⟨Polynomial.X, Polynomial.monic_X, Subsingleton.elim _ _⟩⟩
    letI : Algebra N A := ψ.toAlgebra
    set T : Subalgebra N A := Algebra.adjoin N {ζ} with hT
    have hTint : Algebra.IsIntegral N T := by
      apply Algebra.IsIntegral.adjoin
      intro x hx
      rw [Set.mem_singleton_iff] at hx
      subst hx
      exact ⟨f, hfm, hfζ⟩
    have hmemT : ∀ p : Polynomial N, Polynomial.eval₂ ψ ζ p ∈ T := by
      intro p
      rw [hT, Algebra.adjoin_singleton_eq_range_aeval]
      exact ⟨p, rfl⟩
    have huT : u ∈ T := hu ▸ hmemT h
    choose k p hkp using hR
    set K := (Finset.range Q.natDegree).sup (fun i => k (Q.coeff i)) with hK
    have hcoef : ∀ i < Q.natDegree, u ^ K * α (Q.coeff i) ∈ T := by
      intro i hi
      have hle : k (Q.coeff i) ≤ K := Finset.le_sup (f := fun i => k (Q.coeff i))
        (Finset.mem_range.mpr hi)
      have : u ^ K * α (Q.coeff i) = u ^ (K - k (Q.coeff i)) * (u ^ k (Q.coeff i) * α (Q.coeff i)) := by
        rw [← mul_assoc, ← pow_add, Nat.sub_add_cancel hle]
      rw [this, hkp]
      exact T.mul_mem (T.pow_mem huT _) (hmemT _)
    refine ⟨K, ?_⟩
    set Q' : Polynomial A := (Q.map α).scaleRoots (u ^ K) with hQ'
