      letI : Invertible t := invertibleOfNonzero ht0
      have hQs : Polynomial.eval₂ f y Q.reverse = 0 := by
        have h := (Polynomial.eval₂_reverse_eq_zero_iff f t Q).mpr hQt
        rwa [invOf_eq_inv, inv_inv] at h
      have hQ0 : Q.coeff 0 ≠ 0 := hunit.ne_zero
      have htd : Q.natTrailingDegree = 0 :=
