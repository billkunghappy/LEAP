theorem wcpa_dj_lr1s_nf_cnf_fmp_gb_cs_rf_cc_na_abs_ball : ∀ (V B : Type u) [CommRing V] [CommRing B] [IsDomain B] [Algebra V B] (t : V), Function.Injective (algebraMap V B) → IsUnit (algebraMap V B t) → ¬ IsUnit t → (∀ c : V, c ≠ 0 → ∃ N : ℕ, c ∣ t ^ N) → (∀ c : V, ¬ IsUnit c → ∃ (M : ℕ) (y : V), c ^ M = t * y) → (∀ y : B, y ≠ 0 → ∃ z : B, y * z = 1 ∧ (IsIntegral V y ∨ IsIntegral V z)) → (∀ y : B, y ≠ 0 → IsIntegral V y → ∃ (c : V) (u v : B), y = algebraMap V B c * u ∧ u * v = 1 ∧ IsIntegral V u ∧ IsIntegral V v) → (∀ x : B, IsIntegral V x → wcRfAbs V (algebraMap V B t) x ≤ 1) ∧ (∀ x : B, wcRfAbs V (algebraMap V B t) x ≤ 1 → IsIntegral V x) ∧ (∀ (r : V) (z : B), ¬ IsUnit r → IsIntegral V z → wcRfAbs V (algebraMap V B t) (algebraMap V B r * z) < 1) ∧ wcRfAbs V (algebraMap V B t) (algebraMap V B t) = 1 / 2 :=
by
  intro V B _ _ _ _ t hinj hunit htnu hdiv hrad h4a h5
  classical

  have KF : ∀ (r : V) (w : B), IsIntegral V w → algebraMap V B r * w = 1 → IsUnit r := by
    intro r w hw hrw
    obtain ⟨P, hPm, hPw⟩ := hw
    let _ : Invertible w := ⟨algebraMap V B r, hrw, by rw [mul_comm]; exact hrw⟩
    have h1 := Polynomial.eval₂_reverse_mul_pow (algebraMap V B) w P
    rw [hPw] at h1
    have h2 : Polynomial.eval₂ (algebraMap V B) (⅟w) P.reverse = 0 := by
      have hu : IsUnit (w ^ P.natDegree) := (isUnit_of_invertible w).pow _
      exact (hu.mul_left_eq_zero).mp h1
    have h3 : (⅟w : B) = algebraMap V B r := rfl
    rw [h3, Polynomial.eval₂_at_apply] at h2
    have h4 : P.reverse.eval r = 0 := hinj (h2.trans (map_zero _).symm)
    obtain ⟨Q, hQ⟩ := Polynomial.X_dvd_sub_C (p := P.reverse)
    have h5' := congrArg (Polynomial.eval r) hQ
    rw [Polynomial.eval_sub, Polynomial.eval_C, Polynomial.eval_mul, Polynomial.eval_X, h4,
      Polynomial.coeff_zero_reverse, hPm.leadingCoeff] at h5'
    exact isUnit_iff_exists_inv.mpr ⟨-(Q.eval r), by linear_combination h5'⟩
  generalize hτ : algebraMap V B t = τ at hunit ⊢

  have hkf : ∀ (e : ℕ) (w : B), 0 < e → IsIntegral V w → τ ^ e * w = 1 → False := by
    intro e w he hw h
    have h1 : IsUnit (t ^ e) := KF (t ^ e) w hw (by rw [map_pow, hτ]; exact h)
    obtain ⟨e', rfl⟩ : ∃ e', e = e' + 1 := ⟨e - 1, by omega⟩
    rw [pow_succ] at h1
    exact htnu (isUnit_of_mul_isUnit_right h1)

  have hcancel : ∀ (A m : ℕ) (w : B), IsIntegral V w → τ ^ A = τ ^ m * w → m ≤ A := by
    intro A m w hw h
    by_contra hlt
    push_neg at hlt
    obtain ⟨s, rfl⟩ := Nat.exists_eq_add_of_lt hlt
    have h2 : τ ^ A * 1 = τ ^ A * (τ ^ (s + 1) * w) := by
      rw [mul_one, ← mul_assoc, ← pow_add, show A + (s + 1) = A + s + 1 by omega]
      exact h
    exact hkf (s + 1) w (by omega) hw ((hunit.pow A).mul_left_cancel h2).symm

  have hbnd : ∀ x : B, x ≠ 0 → ∃ N₀ : ℕ, ∀ (m k n : ℕ) (y : B), IsIntegral V y →
      τ ^ k * x ^ n = τ ^ m * y → m ≤ k + N₀ * n := by
    intro x hx
    obtain ⟨N₀, e, he, hxe⟩ : ∃ (N₀ : ℕ) (e : B), IsIntegral V e ∧ τ ^ N₀ = x * e := by
      by_cases hxi : IsIntegral V x
      · obtain ⟨c, u, v, hxc, huv, hu, hv⟩ := h5 x hx hxi
        have hc : c ≠ 0 := by
          rintro rfl
          apply hx
          rw [hxc, map_zero, zero_mul]
        obtain ⟨N, c₂, hc₂⟩ := hdiv c hc
        refine ⟨N, v * algebraMap V B c₂, hv.mul isIntegral_algebraMap, ?_⟩
        rw [← hτ, ← map_pow, hc₂, map_mul, hxc]
        linear_combination (-(algebraMap V B c * algebraMap V B c₂)) * huv
      · obtain ⟨z, hxz, hint⟩ := h4a x hx
        exact ⟨0, z, hint.resolve_left hxi, by rw [pow_zero, hxz]⟩
    refine ⟨N₀, fun m k n y hy h => hcancel _ _ _ (hy.mul (he.pow n)) ?_⟩
    calc τ ^ (k + N₀ * n) = τ ^ k * (x * e) ^ n := by rw [← hxe, ← pow_mul, pow_add]
      _ = τ ^ k * x ^ n * e ^ n := by ring
      _ = τ ^ m * (y * e ^ n) := by rw [h, mul_assoc]

  have hni : ∀ x : B, ¬ IsIntegral V x → ∃ M : ℕ, 0 < M ∧
      (∃ (N : ℕ) (y : B), IsIntegral V y ∧ τ ^ N * x = y) ∧
      ∀ (m k n : ℕ) (y : B), IsIntegral V y → τ ^ k * x ^ n = τ ^ m * y → m * M + n ≤ k * M := by
    intro x hxi
    have hx : x ≠ 0 := by
      rintro rfl
      exact hxi isIntegral_zero
    obtain ⟨z, hxz, hint⟩ := h4a x hx
    have hz : IsIntegral V z := hint.resolve_left hxi
    have hz0 : z ≠ 0 := right_ne_zero_of_mul_eq_one hxz
    obtain ⟨c, u, v, hzc, huv, hu, hv⟩ := h5 z hz0 hz
    have hxc : x * algebraMap V B c = v := by
      linear_combination (-(x * algebraMap V B c)) * huv + v * hxz - (v * x) * hzc
    have hcnu : ¬ IsUnit c := by
      intro hcu
      obtain ⟨c', hcc'⟩ := isUnit_iff_exists_inv.mp hcu
      apply hxi
      have h1 : algebraMap V B c * algebraMap V B c' = 1 := by rw [← map_mul, hcc', map_one]
      have e : x = v * algebraMap V B c' := by
        linear_combination (-x) * h1 + (algebraMap V B c') * hxc
      rw [e]
      exact hv.mul isIntegral_algebraMap
    obtain ⟨M, y₁, hcM⟩ := hrad c hcnu
    have hM : 0 < M := by
      rcases Nat.eq_zero_or_pos M with h | h
      · exfalso
        rw [h, pow_zero] at hcM
        exact htnu (isUnit_iff_exists_inv.mpr ⟨y₁, hcM.symm⟩)
      · exact h
    have hc0 : c ≠ 0 := by
      rintro rfl
      apply hz0
      rw [hzc, map_zero, zero_mul]
    obtain ⟨N, e₁, he₁⟩ := hdiv c hc0
    obtain ⟨g₀, hg₀i, hkey⟩ : ∃ g₀ : B, IsIntegral V g₀ ∧ τ * (x ^ M * g₀) = 1 := by
      refine ⟨algebraMap V B y₁ * u ^ M, isIntegral_algebraMap.mul (hu.pow M), ?_⟩
      have h1 : z ^ M = τ * (algebraMap V B y₁ * u ^ M) := by
        rw [hzc, mul_pow, ← map_pow, hcM, map_mul, hτ]
        ring
      calc τ * (x ^ M * (algebraMap V B y₁ * u ^ M))
          = x ^ M * (τ * (algebraMap V B y₁ * u ^ M)) := by ring
        _ = (x * z) ^ M := by rw [← h1, mul_pow]
        _ = 1 := by rw [hxz, one_pow]
    refine ⟨M, hM, ⟨N, algebraMap V B e₁ * v, isIntegral_algebraMap.mul hv, ?_⟩, ?_⟩
    · rw [← hτ, ← map_pow, he₁, map_mul, ← hxc]
      ring
    · intro m k n y hy h
      apply hcancel (k * M) (m * M + n) (y ^ M * g₀ ^ n) ((hy.pow M).mul (hg₀i.pow n))
      calc τ ^ (k * M) = τ ^ (k * M) * (τ * (x ^ M * g₀)) ^ n := by
            rw [hkey, one_pow, mul_one]
        _ = (τ ^ k * x ^ n) ^ M * (τ ^ n * g₀ ^ n) := by ring
        _ = (τ ^ m * y) ^ M * (τ ^ n * g₀ ^ n) := by rw [h]
        _ = τ ^ (m * M + n) * (y ^ M * g₀ ^ n) := by ring

  obtain ⟨S, hSdef⟩ : ∃ S : B → Set ℝ, S = fun x => {q : ℝ | ∃ (m k n : ℕ) (y : B), 0 < n ∧
      IsIntegral V y ∧ τ ^ k * x ^ n = τ ^ m * y ∧ q = ((m : ℝ) - (k : ℝ)) / (n : ℝ)} :=
    ⟨_, rfl⟩
  have hmem : ∀ (x : B) (q : ℝ), q ∈ S x ↔ ∃ (m k n : ℕ) (y : B), 0 < n ∧
      IsIntegral V y ∧ τ ^ k * x ^ n = τ ^ m * y ∧ q = ((m : ℝ) - (k : ℝ)) / (n : ℝ) := by
    intro x q
    rw [hSdef]
    exact Iff.rfl
  have habs : ∀ x : B, x ≠ 0 → wcRfAbs V τ x = (2 : ℝ) ^ (-sSup (S x)) := by
    intro x hx
    rw [hSdef]
    unfold wcRfAbs
    rw [if_neg hx]
  have habs0 : wcRfAbs V τ 0 = 0 := by
    unfold wcRfAbs
    simp
  have hbdd : ∀ x : B, x ≠ 0 → BddAbove (S x) := by
    intro x hx
    obtain ⟨N₀, hN₀⟩ := hbnd x hx
    refine ⟨N₀, fun q hq => ?_⟩
    obtain ⟨m, k, n, y, hn, hy, h, rfl⟩ := (hmem x q).mp hq
    have h1 := hN₀ m k n y hy h
    have hn' : (0 : ℝ) < n := by exact_mod_cast hn
    rw [div_le_iff₀ hn']
    have h2 : (m : ℝ) ≤ k + N₀ * n := by exact_mod_cast h1
    linarith
  refine ⟨?_, ?_, ?_, ?_⟩
  ·
    intro x hx
    by_cases hx0 : x = 0
    · rw [hx0, habs0]
      norm_num
    rw [habs x hx0]
    have h0 : (0 : ℝ) ∈ S x := (hmem x 0).mpr ⟨0, 0, 1, x, one_pos, hx, by simp, by simp⟩
    have h1 := le_csSup (hbdd x hx0) h0
    exact Real.rpow_le_one_of_one_le_of_nonpos (by norm_num) (by linarith)
  ·
    intro x hx
    by_contra hxi
    have hx0 : x ≠ 0 := by
      rintro rfl
      exact hxi isIntegral_zero
    obtain ⟨M, hM, ⟨N, y₀, hy₀, hNx⟩, hineq⟩ := hni x hxi
    have hne : (S x).Nonempty :=
      ⟨_, (hmem x _).mpr ⟨0, N, 1, y₀, one_pos, hy₀,
        by rw [pow_one, pow_zero, one_mul, hNx], rfl⟩⟩
    have hMr : (0 : ℝ) < M := by exact_mod_cast hM
    have hub : sSup (S x) ≤ -(1 / (M : ℝ)) := by
      apply csSup_le hne
      intro q hq
      obtain ⟨m, k, n, y, hn, hy, h, rfl⟩ := (hmem x q).mp hq
      have h1 := hineq m k n y hy h
      have h2 : (m : ℝ) * M + n ≤ k * M := by exact_mod_cast h1
      have hn' : (0 : ℝ) < n := by exact_mod_cast hn
      rw [div_le_iff₀ hn', show -(1 / (M : ℝ)) * n = (-n) / M by ring, le_div_iff₀ hMr]
      linarith
    rw [habs x hx0] at hx
