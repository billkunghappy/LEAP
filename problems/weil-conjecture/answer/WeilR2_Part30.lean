  set K₁ := IntermediateField.adjoin k (Set.range z) with hK₁
  set φ : MvPolynomial (Fin d) k →+* κ := (MvPolynomial.aeval z).toRingHom with hφ
  have hφapp : ∀ a, φ a = MvPolynomial.aeval z a := fun a => rfl

