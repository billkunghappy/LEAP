    intro R _ q g I₀ K 𝔪 n hq hg hI₀ hK h𝔪 hn
    obtain ⟨hHens, hU, hUniv⟩ := hg
    have h𝔪max : 𝔪.IsMaximal := by
      haveI := hHens
      have h1 : 𝔪 = IsLocalRing.maximalIdeal P := by
        ext x
        rw [h𝔪, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      rw [h1]
