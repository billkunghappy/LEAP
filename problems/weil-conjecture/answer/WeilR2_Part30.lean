  have hx' : m (σ₀V (IsLocalRing.closedPoint ↥W)) =
      Spec.map (CommRingCat.ofHom (MvPolynomial.eval (fun _ : Fin 1 => c)))
        (IsLocalRing.closedPoint ↥W) := by
    rw [← hptEq _ _ hmem, ← hG]
    rfl

  obtain ⟨ΔU, hΔU, hΔUs⟩ := wcpa_dj_nc_henselian_section_lift Ω W
    (Spec (.of (MvPolynomial (Fin 1) ↥W))) V.toScheme m
    (Spec.map (CommRingCat.ofHom (MvPolynomial.eval (fun _ : Fin 1 => c))))
