    have wcpa_dj_mscc_cc_chart_at_section : ∀ (R : Type u) [CommRing R] [IsLocalRing R] (Z : Scheme.{u}) (uu : Z ⟶ Spec (.of R)) (Δ : Spec (.of R) ⟶ Z), Δ ≫ uu = 𝟙 _ → ∀ (W₁ : Z.Opens), SmoothOfRelativeDimension 1 (W₁.ι ≫ uu) → Δ (IsLocalRing.closedPoint R) ∈ W₁ → ∃ (V : Z.Opens) (hle : V ≤ uu ⁻¹ᵁ ⊤) (g : MvPolynomial (Fin 1) R →+* Γ(Z, V)), IsAffineOpen V ∧ Δ (IsLocalRing.closedPoint R) ∈ V ∧ g.Etale ∧ g.comp MvPolynomial.C = (uu.appLE ⊤ V hle).hom.comp (Scheme.ΓSpecIso (.of R)).inv.hom ∧ Function.Bijective ((Δ.app V).hom.comp (g.comp MvPolynomial.C)) := by
