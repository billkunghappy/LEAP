  have sp_int_gen : ∀ (V K L : Type u) [CommRing V] [IsDomain V] [IsIntegrallyClosed V] [Field K]
      [Algebra V K] [IsFractionRing V K] [Field L] [Algebra V L] [Algebra K L] [IsScalarTower V K L]
      (α : L), IsSeparable K α → ∃ (m : V) (γ : L) (gm : Polynomial V), m ≠ 0 ∧
