theorem wcpa_dj_lr1s_nf_flat_model_normalization_finite : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → ∀ (C B : Type u) [CommRing C] [CommRing B] [Algebra ↥W C] [Algebra C B] [Algebra Ω B] [Algebra ↥W B] [IsScalarTower ↥W C B] [IsScalarTower ↥W Ω B], Function.Injective (algebraMap C B) → Algebra.FiniteType ↥W C → Algebra.FiniteType Ω B → _root_.IsReduced B → (∀ b : B, ∃ c : ↥W, c ≠ 0 ∧ ∃ a : C, algebraMap ↥W B c * b = algebraMap C B a) → Algebra.FiniteType C (integralClosure C B) :=
by
  intro Ω _ _ W hW C B _ _ _ _ _ _ _ _ hinj hC hB hred hgen
  classical
  by_cases hWt : W = ⊤
  ·
    have hsurj : Function.Surjective (algebraMap C B) := by
      intro b
      obtain ⟨c, hc0, a, ha⟩ := hgen b
      have hcΩ : (c : Ω) ≠ 0 := by
        intro h
        apply hc0
        exact Subtype.ext h
      have hcW : ((c : Ω))⁻¹ ∈ W := by
        have h : ((c : Ω))⁻¹ ∈ (⊤ : ValuationSubring Ω) := trivial
        rw [← hWt] at h
        exact h
      refine ⟨algebraMap W C ⟨(c : Ω)⁻¹, hcW⟩ * a, ?_⟩
      have hinv : (⟨(c : Ω)⁻¹, hcW⟩ : W) * c = 1 := by
        apply Subtype.ext
        show (c : Ω)⁻¹ * (c : Ω) = 1
        exact inv_mul_cancel₀ hcΩ
      rw [map_mul, ← IsScalarTower.algebraMap_apply, ← ha, ← mul_assoc, ← map_mul, hinv,
        map_one, one_mul]
    refine Algebra.FiniteType.of_surjective
      (Algebra.ofId C (integralClosure C B)) ?_
    intro y
    obtain ⟨a, ha⟩ := hsurj (y : B)
    refine ⟨a, ?_⟩
    apply Subtype.ext
    rw [← ha]
    rfl
  ·
    obtain ⟨x, hx⟩ : ∃ x : Ω, x ∉ W := by
      by_contra h
      push_neg at h
      exact hWt (eq_top_iff.mpr fun y _ => h y)
    have hx0 : x ≠ 0 := fun h => hx (h ▸ W.zero_mem)
    have hxinv : x⁻¹ ∈ W := (W.mem_or_inv_mem x).resolve_left hx
    set ϖ : W := ⟨x⁻¹, hxinv⟩ with hϖ
    have hϖΩ : (ϖ : Ω) ≠ 0 := inv_ne_zero hx0
    have hϖ0 : ϖ ≠ 0 := by
      intro h
      apply hϖΩ
      rw [h]
      rfl
    have hϖnu : ¬ IsUnit ϖ := by
      intro hu
      obtain ⟨v, hv⟩ := hu.exists_right_inv
      have h : x⁻¹ * (v : Ω) = 1 := congrArg Subtype.val hv
      have hvx : (v : Ω) = x := by
        calc (v : Ω) = x * (x⁻¹ * v) := by rw [← mul_assoc, mul_inv_cancel₀ hx0, one_mul]
          _ = x := by rw [h, mul_one]
      exact hx (hvx ▸ v.2)
    have hdiv : ∀ c : W, c ≠ 0 → ∃ n : ℕ, c ∣ ϖ ^ n := by
      intro c hc
      haveI : Ring.KrullDimLE 1 ↥W := Ring.krullDimLE_iff.mpr hW
      have hrad : ϖ ∈ (Ideal.span {c}).radical := by
        rw [Ideal.radical_eq_sInf]
        refine Ideal.mem_sInf.mpr ?_
        rintro J ⟨hJc, hJp⟩
        have hJne : J ≠ ⊥ := by
          intro h
          apply hc
          have h1 : c ∈ J := hJc (Ideal.mem_span_singleton_self c)
          rw [h] at h1
          exact Ideal.mem_bot.mp h1
        have hJmax : J.IsMaximal := by
          rcases Ring.krullDimLE_one_iff.mp inferInstance J hJp with h | h
          · exact absurd (le_bot_iff.mp (h.2 ⟨inferInstance, le_refl _⟩ bot_le)) hJne
          · exact h
        rw [IsLocalRing.eq_maximalIdeal hJmax]
        exact (IsLocalRing.mem_maximalIdeal ϖ).mpr hϖnu
      obtain ⟨n, hn⟩ := hrad
      exact ⟨n, Ideal.mem_span_singleton.mp hn⟩

    have hpB : algebraMap C B (algebraMap W C ϖ) = algebraMap Ω B (ϖ : Ω) := by
      rw [← IsScalarTower.algebraMap_apply, IsScalarTower.algebraMap_apply W Ω B]
      rfl
    have hunit : IsUnit (algebraMap C B (algebraMap W C ϖ)) := by
      rw [hpB]
      exact (IsUnit.mk0 _ hϖΩ).map (algebraMap Ω B)
    have hpow : ∀ b : B, ∃ n : ℕ, ∃ a : C, algebraMap W B ϖ ^ n * b = algebraMap C B a := by
      intro b
      obtain ⟨c, hc, a, ha⟩ := hgen b
      obtain ⟨n, w, hw⟩ := hdiv c hc
      refine ⟨n, algebraMap W C w * a, ?_⟩
      rw [← map_pow, hw, map_mul, mul_comm (algebraMap W B c), mul_assoc, ha, map_mul,
        ← IsScalarTower.algebraMap_apply]
    have hpow' : ∀ b : B, ∃ n : ℕ, ∃ a : C,
        algebraMap C B (algebraMap W C ϖ) ^ n * b = algebraMap C B a := by
      intro b
      obtain ⟨n, a, ha⟩ := hpow b
      refine ⟨n, a, ?_⟩
      rw [← IsScalarTower.algebraMap_apply]
      exact ha
    have htf : ∀ y : C, algebraMap W C ϖ * y = 0 → y = 0 := by
      intro y hy
      apply hinj
      have h1 := congrArg (algebraMap C B) hy
      rw [map_mul, map_zero] at h1
      rw [map_zero]
      exact (hunit.mul_right_eq_zero).mp h1
    obtain ⟨ha, hb, hc⟩ := wcpa_dj_lr1s_nf_adic_completion_basics C (algebraMap W C ϖ) htf
    have hredC := wcpa_dj_lr1s_nf_completion_generic_reduced Ω W hW ϖ hϖ0 hϖnu hdiv C B hinj
      hC hB hred hpow
    have hfinC := wcpa_dj_lr1s_nf_completion_normalization_finite Ω W hW ϖ hϖ0 hϖnu hdiv C B
      hinj hC hB hred hpow hredC
    haveI hfin : Module.Finite C ↥(integralClosure C B) :=
      wcpa_dj_lr1s_nf_completion_descent C B
        (AdicCompletion (Ideal.span {algebraMap W C ϖ}) C) (algebraMap W C ϖ) hinj hunit hpow'
        ha hb hc hfinC
    infer_instance

theorem wcpa_dj_lr1s_nf_ring_reduction : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) →
    ∀ (A B : Type u) [CommRing A] [CommRing B] [Algebra ↥W A] [Algebra A B] [Algebra Ω B]
      [Algebra ↥W B] [IsScalarTower ↥W A B] [IsScalarTower ↥W Ω B],
      Algebra.FiniteType ↥W A → Algebra.FiniteType Ω B → _root_.IsReduced B →
      (∀ b : B, ∃ c : ↥W, c ≠ 0 ∧ IsIntegral A (algebraMap ↥W B c * b)) →
      Algebra.FiniteType A (integralClosure A B) :=
by
  intro Ω _ _ W hW A B _ _ _ _ _ _ _ _ hA hB hred hgen
  classical
  obtain ⟨Y, hY⟩ := hB.out
  choose cY hcY0 hcYi using hgen
  have hsint : ∀ x ∈ Y.image (fun y => algebraMap W B (cY y) * y), IsIntegral A x := by
    intro x hx
    obtain ⟨y, -, rfl⟩ := Finset.mem_image.mp hx
    exact hcYi y
  have hWmem : ∀ (w : W) (x : B),
      x ∈ Algebra.adjoin A ((Y.image (fun y => algebraMap W B (cY y) * y) : Finset B) : Set B) →
      algebraMap W B w * x ∈
        Algebra.adjoin A ((Y.image (fun y => algebraMap W B (cY y) * y) : Finset B) : Set B) := by
    intro w x hx
    rw [IsScalarTower.algebraMap_apply W A B]
    exact Subalgebra.mul_mem _ (Subalgebra.algebraMap_mem _ _) hx
  have hP : ∀ b : B, ∃ c : W, c ≠ 0 ∧ algebraMap W B c * b ∈
      Algebra.adjoin A ((Y.image (fun y => algebraMap W B (cY y) * y) : Finset B) : Set B) := by
    intro b
    have hb : b ∈ Algebra.adjoin Ω (Y : Set B) := by rw [hY]; trivial
    induction hb using Algebra.adjoin_induction with
    | mem x hx =>
      refine ⟨cY x, hcY0 x, Algebra.subset_adjoin ?_⟩
      exact Finset.mem_coe.mpr (Finset.mem_image_of_mem _ hx)
    | algebraMap ω =>
      by_cases hω : ω ∈ W
      · refine ⟨1, one_ne_zero, ?_⟩
        rw [map_one, one_mul]
        have e : algebraMap Ω B ω = algebraMap W B ⟨ω, hω⟩ := by
          rw [IsScalarTower.algebraMap_apply W Ω B]; rfl
        rw [e, IsScalarTower.algebraMap_apply W A B]
        exact Subalgebra.algebraMap_mem _ _
      · have hω0 : ω ≠ 0 := fun h => hω (h ▸ W.zero_mem)
        have hinv : ω⁻¹ ∈ W := (W.mem_or_inv_mem ω).resolve_left hω
        refine ⟨⟨ω⁻¹, hinv⟩, ?_, ?_⟩
        · intro h
          have h' := congrArg Subtype.val h
          exact hω0 (inv_eq_zero.mp h')
        · rw [IsScalarTower.algebraMap_apply W Ω B, ← map_mul]
          have e : algebraMap W Ω ⟨ω⁻¹, hinv⟩ * ω = 1 := inv_mul_cancel₀ hω0
          rw [e, map_one]
          exact Subalgebra.one_mem _
    | add x y _ _ hx hy =>
      obtain ⟨c₁, hc₁, h₁⟩ := hx
      obtain ⟨c₂, hc₂, h₂⟩ := hy
      refine ⟨c₁ * c₂, mul_ne_zero hc₁ hc₂, ?_⟩
      have e : algebraMap W B (c₁ * c₂) * (x + y) = algebraMap W B c₂ * (algebraMap W B c₁ * x) +
          algebraMap W B c₁ * (algebraMap W B c₂ * y) := by
        rw [map_mul]; ring
      rw [e]
      exact Subalgebra.add_mem _ (hWmem _ _ h₁) (hWmem _ _ h₂)
    | mul x y _ _ hx hy =>
      obtain ⟨c₁, hc₁, h₁⟩ := hx
      obtain ⟨c₂, hc₂, h₂⟩ := hy
      refine ⟨c₁ * c₂, mul_ne_zero hc₁ hc₂, ?_⟩
      have e : algebraMap W B (c₁ * c₂) * (x * y) =
          (algebraMap W B c₁ * x) * (algebraMap W B c₂ * y) := by
        rw [map_mul]; ring
      rw [e]
      exact Subalgebra.mul_mem _ h₁ h₂
  haveI hfin : Module.Finite A
      (Algebra.adjoin A ((Y.image (fun y => algebraMap W B (cY y) * y) : Finset B) : Set B)) :=
    Algebra.finite_adjoin_of_finite_of_isIntegral (Finset.finite_toSet _) hsint
  haveI : Algebra.FiniteType A
      (Algebra.adjoin A ((Y.image (fun y => algebraMap W B (cY y) * y) : Finset B) : Set B)) :=
    Module.Finite.finiteType _
  haveI : Algebra.IsIntegral A
      (Algebra.adjoin A ((Y.image (fun y => algebraMap W B (cY y) * y) : Finset B) : Set B)) :=
    Algebra.IsIntegral.of_finite _ _
  haveI : Algebra.FiniteType W
      (Algebra.adjoin A ((Y.image (fun y => algebraMap W B (cY y) * y) : Finset B) : Set B)) :=
    Algebra.FiniteType.trans hA inferInstance
  have hcrux := wcpa_dj_lr1s_nf_flat_model_normalization_finite Ω W hW
    (Algebra.adjoin A ((Y.image (fun y => algebraMap W B (cY y) * y) : Finset B) : Set B)) B
    Subtype.val_injective inferInstance hB hred (fun b => by
      obtain ⟨c, hc, hm⟩ := hP b
      exact ⟨c, hc, ⟨_, hm⟩, rfl⟩)
  rw [← Subalgebra.fg_iff_finiteType] at hcrux ⊢
  obtain ⟨t, ht⟩ := hcrux
  refine ⟨Y.image (fun y => algebraMap W B (cY y) * y) ∪ t, ?_⟩
  rw [Finset.coe_union, Algebra.adjoin_union_eq_adjoin_adjoin, ht]
  ext x
  rw [Subalgebra.mem_restrictScalars, mem_integralClosure_iff, mem_integralClosure_iff]
  exact ⟨fun h => isIntegral_trans x h, fun h => h.tower_top⟩

theorem wcpa_dj_lr1s_normalization_finite : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ → ∀ (Ct : Scheme.{u}) (ct : Ct ⟶ Spec (.of Ω)) (φ : Ct ⟶ wcProjK Ω 1), wcpaDjIsProjOver Ω ct → SmoothOfRelativeDimension 1 ct → IrreducibleSpace Ct → IsFinite φ → φ ≫ wcProjKStr Ω 1 = ct → (∃ V : Ct.Opens, Dense (V : Set Ct) ∧ Etale (V.ι ≫ φ)) → ∀ (X : Scheme.{u}) (uX : X ⟶ Spec (.of ↥W)) (ι : wcProjK Ω 1 ⟶ X) [QuasiCompact (φ ≫ ι)] [QuasiSeparated (φ ≫ ι)], wcpaDjSemistable uX → (∃ (N : ℕ) (j : X ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W) MvPolynomial.gradedAlgebra), IsClosedImmersion j ∧ j ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W) MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥W ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W 0))) = uX) → IsPullback ι (wcProjKStr Ω 1) uX (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) → IsFinite (φ ≫ ι).fromNormalization :=
