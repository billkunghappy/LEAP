  have hY : ∀ i (k : Fin (wcEbBdResDeg K (V i))), ∃ Y : L, ∃ hYm : ∀ j, Y ∈ V j,
      IsLocalRing.residue ↥(V i) ⟨Y, hYm i⟩ = ξ i k ∧ ∀ j, j ≠ i → (V j).valuation Y < 1 := by
