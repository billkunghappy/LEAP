    haveI hcΩ : CharP Ω p :=
      RingHom.charP (algebraMap Ω (RatFunc Ω)) (algebraMap Ω (RatFunc Ω)).injective p
    have hdecK := wcpa_dj_lr1k_eb_pd_es_ratfunc_decomp Ω p
    have hdecL := wcpa_dj_lr1k_eb_pd_es_frob_decomp (RatFunc Ω) L p RatFunc.X hdecK
    have hnot : ∀ w : L, w ^ p ≠ η b := by
