  · rw [← Ideal.sum_ramification_inertia S (RatFunc k) F hpbot]
    calc ∑ j, p.ramificationIdx' (v j).asIdeal
        = ∑ j, (fun x : T => p.ramificationIdx' x.1) (E.symm j) := rfl
      _ = ∑ x : T, p.ramificationIdx' x.1 := by
        convert Equiv.sum_comp E.symm (fun x : T => p.ramificationIdx' x.1)
      _ = ∑ P ∈ T, p.ramificationIdx' P := by
        convert Finset.sum_coe_sort T (fun P => p.ramificationIdx' P)
      _ = _ := Finset.sum_congr rfl (fun P hP => by rw [(hT5 P hP).1, mul_one])

theorem wcpa_dj_lr1k_cp_intval_ramification : ∀ (R : Type u) [CommRing R] (S : Type u) [CommRing S] [IsDedekindDomain S] [Algebra R S] (x : R) (v : IsDedekindDomain.HeightOneSpectrum S), algebraMap R S x ≠ 0 → v.intValuation (algebraMap R S x) = WithZero.exp (-((Ideal.span {x}).ramificationIdx' v.asIdeal : ℤ)) :=
by
  intro R _ S _ _ _ x v hy
  have hw0 : v.intValuation (algebraMap R S x) ≠ 0 := v.intValuation_ne_zero _ hy
  have hw1 : v.intValuation (algebraMap R S x) ≤ 1 := v.intValuation_le_one _
  obtain ⟨n, hn⟩ : ∃ n : ℕ, v.intValuation (algebraMap R S x) = WithZero.exp (-(n : ℤ)) := by
    have he := WithZero.exp_log hw0
    have ha : WithZero.log (v.intValuation (algebraMap R S x)) ≤ 0 := by
      rw [← WithZero.exp_le_exp, he, WithZero.exp_zero]
      exact hw1
    refine ⟨(WithZero.log (v.intValuation (algebraMap R S x))).natAbs, ?_⟩
    calc v.intValuation (algebraMap R S x)
        = WithZero.exp (WithZero.log (v.intValuation (algebraMap R S x))) := he.symm
      _ = _ := by rw [← Int.eq_neg_natAbs_of_nonpos ha]
  have hmem : ∀ k : ℕ, algebraMap R S x ∈ v.asIdeal ^ k ↔ k ≤ n := by
    intro k
    rw [← IsDedekindDomain.HeightOneSpectrum.intValuation_le_pow_iff_mem, hn,
      WithZero.exp_le_exp]
    omega
  have hmap : Ideal.map (algebraMap R S) (Ideal.span {x}) = Ideal.span {algebraMap R S x} := by
    rw [Ideal.map_span, Set.image_singleton]
  have hram : (Ideal.span {x}).ramificationIdx' v.asIdeal = n := by
    apply Ideal.ramificationIdx'_spec
    · rw [hmap, Ideal.span_singleton_le_iff_mem, hmem]
    · rw [hmap, Ideal.span_singleton_le_iff_mem, hmem]
      omega
  rw [hram, hn]

theorem wcpa_dj_lr1k_cp_localization_rep : ∀ (S : Type u) [CommRing S] [IsDedekindDomain S] (F : Type u) [Field F] [Algebra S F] [IsFractionRing S F] (v : IsDedekindDomain.HeightOneSpectrum S) (x : F), IsDedekindDomain.HeightOneSpectrum.valuation F v x ≤ 1 → ∃ s t : S, t ∉ v.asIdeal ∧ algebraMap S F t * x = algebraMap S F s :=
by
  intro S _ _ F _ _ _ v x hxle
  obtain ⟨a, b, hb, hx⟩ := IsFractionRing.div_surjective (A := S) x
  have hb0 : b ≠ 0 := nonZeroDivisors.ne_zero hb
  have hιb : algebraMap S F b ≠ 0 := IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors hb
  have hax : algebraMap S F a = x * algebraMap S F b := by
    rw [← hx, div_mul_cancel₀ _ hιb]
  set n : ℕ := (Associates.mk v.asIdeal).count (Associates.mk (Ideal.span {b})).factors with hn_def
  have hn : v.intValuation b = WithZero.exp (-(n : ℤ)) :=
    IsDedekindDomain.HeightOneSpectrum.intValuation_if_neg v hb0
  have hdvd : v.asIdeal ^ n ∣ Ideal.span {b} :=
    (IsDedekindDomain.HeightOneSpectrum.intValuation_le_pow_iff_dvd v b n).mp (le_of_eq hn)
  obtain ⟨J, hJ⟩ := hdvd
  have hJP : ¬ J ≤ v.asIdeal := by
    intro hle
    have hPJ : v.asIdeal ∣ J := Ideal.dvd_iff_le.mpr hle
    have h2 : v.asIdeal ^ (n + 1) ∣ Ideal.span {b} := by
      rw [hJ, pow_succ]
      exact mul_dvd_mul_left _ hPJ
    have h3 := (IsDedekindDomain.HeightOneSpectrum.intValuation_le_pow_iff_dvd v b (n + 1)).mpr h2
    rw [hn, WithZero.exp_le_exp] at h3
    push_cast at h3
    omega
  obtain ⟨t, htJ, ht⟩ := SetLike.not_le_iff_exists.mp hJP
  have hva : v.intValuation a ≤ v.intValuation b := by
    have h1 : IsDedekindDomain.HeightOneSpectrum.valuation F v (algebraMap S F a) =
        IsDedekindDomain.HeightOneSpectrum.valuation F v x *
          IsDedekindDomain.HeightOneSpectrum.valuation F v (algebraMap S F b) := by
      rw [hax, map_mul]
    rw [IsDedekindDomain.HeightOneSpectrum.valuation_of_algebraMap,
      IsDedekindDomain.HeightOneSpectrum.valuation_of_algebraMap] at h1
    rw [h1]
    exact mul_le_of_le_one_left zero_le' hxle
  have ha : a ∈ v.asIdeal ^ n := by
    have := (IsDedekindDomain.HeightOneSpectrum.intValuation_le_pow_iff_dvd v a n).mp
      (hva.trans (le_of_eq hn))
    exact Ideal.dvd_span_singleton.mp this
  have hat : a * t ∈ Ideal.span {b} := by
    rw [hJ]
    exact Ideal.mul_mem_mul ha htJ
  obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp hat
  refine ⟨c, t, ht, ?_⟩
  apply mul_right_cancel₀ hιb
  rw [mul_assoc, ← hax, ← map_mul, ← map_mul, hc, mul_comm]

theorem wcpa_dj_lr1k_cp_overring_classify : ∀ (S : Type u) [CommRing S] [IsDedekindDomain S] (F : Type u) [Field F] [Algebra S F] [IsFractionRing S F], (∀ (v : IsDedekindDomain.HeightOneSpectrum S) (x : F), IsDedekindDomain.HeightOneSpectrum.valuation F v x ≤ 1 → ∃ s t : S, t ∉ v.asIdeal ∧ algebraMap S F t * x = algebraMap S F s) → ∀ A : ValuationSubring F, (∀ s : S, algebraMap S F s ∈ A) → A ≠ ⊤ → ∃ v : IsDedekindDomain.HeightOneSpectrum S, A = (IsDedekindDomain.HeightOneSpectrum.valuation F v).valuationSubring ∧ ∀ s : S, s ∈ v.asIdeal ↔ A.valuation (algebraMap S F s) < 1 :=
by
  intro S _ _ F _ _ _ hloc A hSA hAtop
  classical
  have hLE : ∀ s : S, A.valuation (algebraMap S F s) ≤ 1 :=
    fun s => (A.valuation_le_one_iff _).mpr (hSA s)

  set ψ : S →+* ↥A := (algebraMap S F).codRestrict A hSA with hψ
  set P : Ideal S := Ideal.comap ψ (IsLocalRing.maximalIdeal ↥A) with hPdef
  have hPprime : P.IsPrime := Ideal.IsPrime.comap ψ
  have hPmem : ∀ s : S, s ∈ P ↔ A.valuation (algebraMap S F s) < 1 := by
    intro s
    rw [hPdef, Ideal.mem_comap, ValuationSubring.valuation_lt_one_iff]
    rfl

  obtain ⟨z, hz⟩ : ∃ z : F, z ∉ A := by
    by_contra h
    push_neg at h
    exact hAtop (eq_top_iff.mpr fun x _ => h x)
  have hz0 : z ≠ 0 := fun h => hz (h ▸ A.zero_mem)
  have hνz : 1 < A.valuation z := not_le.mp (fun h => hz ((A.valuation_le_one_iff z).mp h))
  have hνzi : A.valuation z⁻¹ < 1 := by
    rw [map_inv₀]; exact inv_lt_one_of_one_lt₀ hνz
  obtain ⟨a, d, hd, had⟩ := IsFractionRing.div_surjective (A := S) z⁻¹
  have hd0 : algebraMap S F d ≠ 0 := IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors hd
  have ha : algebraMap S F a = z⁻¹ * algebraMap S F d := by
    rw [← had]; field_simp
  have ha0 : a ≠ 0 := by
    intro h
    rw [h, map_zero] at ha
    exact mul_ne_zero (inv_ne_zero hz0) hd0 ha.symm
  have hνa : A.valuation (algebraMap S F a) < 1 := by
    rw [ha, map_mul]
    exact lt_of_le_of_lt (mul_le_of_le_one_right' (hLE d)) hνzi
  have hP0 : P ≠ ⊥ := by
    intro h
    have hm := (hPmem a).mpr hνa
    rw [h, Ideal.mem_bot] at hm
    exact ha0 hm
  let v : IsDedekindDomain.HeightOneSpectrum S := ⟨P, hPprime, hP0⟩
  refine ⟨v, ?_, hPmem⟩
  have hνt : ∀ t : S, t ∉ P → A.valuation (algebraMap S F t) = 1 := fun t ht =>
    le_antisymm (hLE t) (not_lt.mp (fun h => ht ((hPmem t).mpr h)))
  have hvt : ∀ t : S, t ∉ v.asIdeal →
      IsDedekindDomain.HeightOneSpectrum.valuation F v (algebraMap S F t) = 1 := fun t ht =>
    le_antisymm (IsDedekindDomain.HeightOneSpectrum.valuation_le_one v t)
      (not_lt.mp fun h => ht ((IsDedekindDomain.HeightOneSpectrum.valuation_lt_one_iff_mem v t).mp h))
  ext x
  rw [Valuation.mem_valuationSubring_iff]
  constructor
  · intro hx
    by_contra hgt
    push_neg at hgt
    have hx0 : x ≠ 0 := by
      rintro rfl
      simp at hgt
    have hvi' : IsDedekindDomain.HeightOneSpectrum.valuation F v x⁻¹ < 1 := by
      rw [map_inv₀]; exact inv_lt_one_of_one_lt₀ hgt
    obtain ⟨s, t, ht, hts⟩ := hloc v x⁻¹ hvi'.le
    have hs : s ∈ v.asIdeal := by
      have key : IsDedekindDomain.HeightOneSpectrum.valuation F v (algebraMap S F s) < 1 := by
        rw [← hts, map_mul, hvt t ht, one_mul]
        exact hvi'
      exact (IsDedekindDomain.HeightOneSpectrum.valuation_lt_one_iff_mem (K := F) v s).mp key
    have hνs : A.valuation (algebraMap S F s) < 1 := (hPmem s).mp hs
    have hsx : algebraMap S F s * x = algebraMap S F t := by
      rw [← hts, mul_assoc, inv_mul_cancel₀ hx0, mul_one]
    have h1 := hνt t ht
    rw [← hsx, map_mul] at h1
    have h2 : A.valuation (algebraMap S F s) * A.valuation x ≤ A.valuation (algebraMap S F s) :=
      mul_le_of_le_one_right' ((A.valuation_le_one_iff x).mpr hx)
    rw [h1] at h2
    exact lt_irrefl _ (lt_of_le_of_lt h2 hνs)
  · intro hx
    obtain ⟨s, t, ht, hts⟩ := hloc v x hx
    rw [← A.valuation_le_one_iff]
    have h1 := hνt t ht
    calc A.valuation x = A.valuation (algebraMap S F t) * A.valuation x := by rw [h1, one_mul]
      _ = A.valuation (algebraMap S F s) := by rw [← map_mul, hts]
      _ ≤ 1 := hLE s

theorem wcpa_dj_lr1k_cp_place_trace : ∀ (k : Type u) [Field k] (F : Type u) [Field F] [Algebra (RatFunc k) F] [Algebra (Polynomial k) F] [IsScalarTower (Polynomial k) (RatFunc k) F] (S : Type u) [CommRing S] [IsDedekindDomain S] [Algebra S F] [IsFractionRing S F] [Algebra (Polynomial k) S] [IsScalarTower (Polynomial k) S F] (v : IsDedekindDomain.HeightOneSpectrum S), algebraMap (Polynomial k) S Polynomial.X ∈ v.asIdeal → ∀ g : RatFunc k, (algebraMap (RatFunc k) F g ∈ (IsDedekindDomain.HeightOneSpectrum.valuation F v).valuationSubring ↔ ∃ p q : Polynomial k, q.eval 0 ≠ 0 ∧ g * algebraMap (Polynomial k) (RatFunc k) q = algebraMap (Polynomial k) (RatFunc k) p) :=
by
  intro k _ F _ _ _ _ S _ _ _ _ _ _ v hX g
  classical
  have hpoly : ∀ a : Polynomial k,
      IsDedekindDomain.HeightOneSpectrum.valuation F v (algebraMap (Polynomial k) F a) =
        v.intValuation (algebraMap (Polynomial k) S a) := by
    intro a
    rw [IsScalarTower.algebraMap_apply (Polynomial k) S F a]
    exact IsDedekindDomain.HeightOneSpectrum.valuation_of_algebraMap v _
  have hle : ∀ a : Polynomial k,
      IsDedekindDomain.HeightOneSpectrum.valuation F v (algebraMap (Polynomial k) F a) ≤ 1 := by
    intro a
    rw [hpoly]
    exact v.intValuation_le_one _
  have hlt : ∀ a : Polynomial k, a.eval 0 = 0 →
      IsDedekindDomain.HeightOneSpectrum.valuation F v (algebraMap (Polynomial k) F a) < 1 := by
    intro a ha
    rw [hpoly, IsDedekindDomain.HeightOneSpectrum.intValuation_lt_one_iff_mem]
    have hdvd : Polynomial.X ∣ a := by
      rw [Polynomial.X_dvd_iff, Polynomial.coeff_zero_eq_eval_zero]; exact ha
    obtain ⟨r, rfl⟩ := hdvd
    rw [map_mul]
    exact Ideal.mul_mem_right _ _ hX
  have heq1 : ∀ a : Polynomial k, a.eval 0 ≠ 0 →
      IsDedekindDomain.HeightOneSpectrum.valuation F v (algebraMap (Polynomial k) F a) = 1 := by
    intro a ha
    apply le_antisymm (hle a)
    rw [← not_lt, hpoly, IsDedekindDomain.HeightOneSpectrum.intValuation_lt_one_iff_mem]
    intro hmem
    obtain ⟨r, hr⟩ := Polynomial.X_dvd_sub_C (p := a)
    have hc : a.coeff 0 ≠ 0 := by rwa [Polynomial.coeff_zero_eq_eval_zero]
    have hCmem : algebraMap (Polynomial k) S (Polynomial.C (a.coeff 0)) ∈ v.asIdeal := by
      have hCe : Polynomial.C (a.coeff 0) = a - Polynomial.X * r := by rw [← hr]; ring
      rw [hCe, map_sub, map_mul]
      exact Ideal.sub_mem _ hmem (Ideal.mul_mem_right _ _ hX)
    have hu : IsUnit (algebraMap (Polynomial k) S (Polynomial.C (a.coeff 0))) :=
      (Polynomial.isUnit_C.mpr (Ne.isUnit hc)).map _
    exact v.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem _ hCmem hu)
  have htrans : ∀ p q : Polynomial k,
      g * algebraMap (Polynomial k) (RatFunc k) q = algebraMap (Polynomial k) (RatFunc k) p →
      IsDedekindDomain.HeightOneSpectrum.valuation F v (algebraMap (RatFunc k) F g) *
          IsDedekindDomain.HeightOneSpectrum.valuation F v (algebraMap (Polynomial k) F q) =
        IsDedekindDomain.HeightOneSpectrum.valuation F v (algebraMap (Polynomial k) F p) := by
    intro p q h
    rw [← map_mul, IsScalarTower.algebraMap_apply (Polynomial k) (RatFunc k) F q,
      IsScalarTower.algebraMap_apply (Polynomial k) (RatFunc k) F p, ← map_mul, h]
  rw [Valuation.mem_valuationSubring_iff]
  constructor
  · intro hG
    have hd0 : algebraMap (Polynomial k) (RatFunc k) g.denom ≠ 0 :=
      RatFunc.algebraMap_ne_zero (RatFunc.denom_ne_zero g)
    have hident : g * algebraMap (Polynomial k) (RatFunc k) g.denom =
        algebraMap (Polynomial k) (RatFunc k) g.num := by
      calc g * algebraMap (Polynomial k) (RatFunc k) g.denom
          = (algebraMap (Polynomial k) (RatFunc k) g.num /
              algebraMap (Polynomial k) (RatFunc k) g.denom) *
              algebraMap (Polynomial k) (RatFunc k) g.denom := by rw [RatFunc.num_div_denom]
        _ = algebraMap (Polynomial k) (RatFunc k) g.num := div_mul_cancel₀ _ hd0
    refine ⟨g.num, g.denom, ?_, hident⟩
    intro hd
    have hn : g.num.eval 0 ≠ 0 := by
      intro hn
      have h1 : Polynomial.X ∣ g.num := by
        rw [Polynomial.X_dvd_iff, Polynomial.coeff_zero_eq_eval_zero]; exact hn
      have h2 : Polynomial.X ∣ g.denom := by
        rw [Polynomial.X_dvd_iff, Polynomial.coeff_zero_eq_eval_zero]; exact hd
      exact Polynomial.not_isUnit_X ((RatFunc.isCoprime_num_denom g).isUnit_of_dvd' h1 h2)
    have e := htrans g.num g.denom hident
    rw [heq1 g.num hn] at e
    have h3 : IsDedekindDomain.HeightOneSpectrum.valuation F v (algebraMap (RatFunc k) F g) *
        IsDedekindDomain.HeightOneSpectrum.valuation F v (algebraMap (Polynomial k) F g.denom) ≤
        IsDedekindDomain.HeightOneSpectrum.valuation F v (algebraMap (Polynomial k) F g.denom) :=
      mul_le_of_le_one_left' hG
    rw [e] at h3
    exact absurd (lt_of_le_of_lt h3 (hlt g.denom hd)) (lt_irrefl 1)
  · rintro ⟨p, q, hq, h⟩
    have e := htrans p q h
    rw [heq1 q hq, mul_one] at e
    rw [e]
    exact hle p

theorem wcpa_dj_lr1k_cp_trace_forces_over : ∀ (k : Type u) [Field k] (F : Type u) [Field F] [Algebra (RatFunc k) F] [Algebra (Polynomial k) F] [IsScalarTower (Polynomial k) (RatFunc k) F] (S : Type u) [CommRing S] [Algebra S F] [Algebra (Polynomial k) S] [IsScalarTower (Polynomial k) S F] [Algebra.IsIntegral (Polynomial k) S] (A : ValuationSubring F), (∀ g : RatFunc k, algebraMap (RatFunc k) F g ∈ A ↔ ∃ p q : Polynomial k, q.eval 0 ≠ 0 ∧ g * algebraMap (Polynomial k) (RatFunc k) q = algebraMap (Polynomial k) (RatFunc k) p) → (∀ s : S, algebraMap S F s ∈ A) ∧ A ≠ ⊤ ∧ A.valuation (algebraMap (Polynomial k) F Polynomial.X) < 1 :=
by
  intro k _ F _ _ _ _ S _ _ _ _ _ A H
  classical
  have s1 : ∀ c : Polynomial k, algebraMap (Polynomial k) F c ∈ A := by
    intro c
    rw [IsScalarTower.algebraMap_apply (Polynomial k) (RatFunc k) F c]
    exact (H _).mpr ⟨c, 1, by simp, by simp⟩
  have s3 : algebraMap (RatFunc k) F (RatFunc.X⁻¹) ∉ A := by
    intro hA
    obtain ⟨p, q, hq, hpq⟩ := (H _).mp hA
    have h1 : algebraMap (Polynomial k) (RatFunc k) q =
        algebraMap (Polynomial k) (RatFunc k) (Polynomial.X * p) := by
      rw [map_mul, RatFunc.algebraMap_X, ← hpq, ← mul_assoc,
        mul_inv_cancel₀ (RatFunc.X_ne_zero (K := k)), one_mul]
    have h2 := RatFunc.algebraMap_injective k h1
    apply hq
    rw [h2, Polynomial.eval_mul, Polynomial.eval_X, zero_mul]
  refine ⟨?_, ?_, ?_⟩
  · intro s
    let φ : Polynomial k →+* A := (algebraMap (Polynomial k) F).codRestrict A s1
    have hcomp : (algebraMap A F).comp φ =
        (algebraMap S F).comp (algebraMap (Polynomial k) S) :=
      RingHom.ext fun c => IsScalarTower.algebraMap_apply (Polynomial k) S F c
    have hint : IsIntegral A (algebraMap S F s) :=
      IsIntegral.map_of_comp_eq φ (algebraMap S F) hcomp (Algebra.IsIntegral.isIntegral s)
    obtain ⟨y, hy⟩ := IsIntegrallyClosed.isIntegral_iff.mp hint
    rw [← hy]
    exact y.2
  · intro htop
    apply s3
    rw [htop]
    exact ValuationSubring.mem_top _
  · have hx : algebraMap (Polynomial k) F Polynomial.X = algebraMap (RatFunc k) F RatFunc.X := by
      rw [IsScalarTower.algebraMap_apply (Polynomial k) (RatFunc k) F, RatFunc.algebraMap_X]
    have hle : A.valuation (algebraMap (Polynomial k) F Polynomial.X) ≤ 1 :=
      (A.valuation_le_one_iff _).mpr (s1 _)
    refine lt_of_le_of_ne hle ?_
    intro heq
    apply s3
    rw [map_inv₀, ← hx]
    apply (A.valuation_le_one_iff _).mp
    rw [map_inv₀, heq, inv_one]

theorem wcpa_dj_lr1k_cp_crt_uniformizer : ∀ (S : Type u) [CommRing S] [IsDedekindDomain S] (F : Type u) [Field F] [Algebra S F] [IsFractionRing S F] (s : ℕ) (v : Fin s → IsDedekindDomain.HeightOneSpectrum S), Function.Injective v → ∀ j, ∃ π : S, IsDedekindDomain.HeightOneSpectrum.valuation F (v j) (algebraMap S F π) = WithZero.exp (-1) ∧ ∀ j', j' ≠ j → IsDedekindDomain.HeightOneSpectrum.valuation F (v j') (algebraMap S F π) = 1 :=
by
  intro S _ _ F _ _ _ s v hv j
  classical
  obtain ⟨ϖ, hϖ⟩ := IsDedekindDomain.HeightOneSpectrum.intValuation_exists_uniformizer (v j)
  obtain ⟨y, hy⟩ := IsDedekindDomain.exists_forall_sub_mem_ideal (s := (Finset.univ : Finset (Fin s)))
    (fun i => (v i).asIdeal) (fun i => if i = j then 2 else 1)
    (fun i _ => (v i).prime)
    (fun i _ i' _ hii' h => hii' (hv (IsDedekindDomain.HeightOneSpectrum.ext h)))
    (fun i => if i.1 = j then ϖ else 1)
  have hyj : y - ϖ ∈ (v j).asIdeal ^ 2 := by
    simpa using hy j (Finset.mem_univ j)
  have hyj' : ∀ j', j' ≠ j → y - 1 ∈ (v j').asIdeal := by
    intro j' hj'
    simpa [hj'] using hy j' (Finset.mem_univ j')
  refine ⟨y, ?_, ?_⟩
  · rw [IsDedekindDomain.HeightOneSpectrum.valuation_of_algebraMap]
    have h1 : (v j).intValuation (y - ϖ) < (v j).intValuation ϖ := by
      have := ((v j).intValuation_le_pow_iff_mem (y - ϖ) 2).mpr hyj
      rw [hϖ]
      refine lt_of_le_of_lt this ?_
      rw [WithZero.exp_lt_exp]
      norm_num
    have h2 := Valuation.map_add_eq_of_lt_left (v j).intValuation h1
    rw [add_sub_cancel] at h2
    rw [h2, hϖ]
  · intro j' hj'
    rw [IsDedekindDomain.HeightOneSpectrum.valuation_of_algebraMap]
    have h1 : (v j').intValuation (y - 1) < (v j').intValuation 1 := by
      have := ((v j').intValuation_le_pow_iff_mem (y - 1) 1).mpr (by rw [pow_one]; exact hyj' j' hj')
      rw [Valuation.map_one]
      refine lt_of_le_of_lt this ?_
      rw [← WithZero.exp_zero, WithZero.exp_lt_exp]
      norm_num
    have h2 := Valuation.map_add_eq_of_lt_left (v j').intValuation h1
    rw [add_sub_cancel, Valuation.map_one] at h2
    exact h2

theorem wcpa_dj_lr1k_cp_residue_lift : ∀ (k : Type u) [Field k] (S : Type u) [CommRing S] [IsDedekindDomain S] (F : Type u) [Field F] [Algebra S F] [IsFractionRing S F] (ι : k →+* S) (v : IsDedekindDomain.HeightOneSpectrum S), (∀ s : S, ∃ c : k, s - ι c ∈ v.asIdeal) → (∀ x : F, IsDedekindDomain.HeightOneSpectrum.valuation F v x ≤ 1 → ∃ s t : S, t ∉ v.asIdeal ∧ algebraMap S F t * x = algebraMap S F s) → ∀ y : F, IsDedekindDomain.HeightOneSpectrum.valuation F v y ≤ 1 → ∃ c : k, IsDedekindDomain.HeightOneSpectrum.valuation F v (y - algebraMap S F (ι c)) < 1 :=
by
  intro k _ S _ _ F _ _ _ ι v hres hloc y hy
  obtain ⟨s, t, ht, hst⟩ := hloc y hy
  obtain ⟨a, ha⟩ := hres t
  obtain ⟨b, hb⟩ := hres s
  have ha0 : a ≠ 0 := by
    rintro rfl
    apply ht
    simpa using ha
  refine ⟨b * a⁻¹, ?_⟩
  have hιc : ι a * ι (b * a⁻¹) = ι b := by
    rw [← map_mul]
    congr 1
    field_simp
  have hmem : s - t * ι (b * a⁻¹) ∈ v.asIdeal := by
    have hid : s - t * ι (b * a⁻¹) = (s - ι b) - (t - ι a) * ι (b * a⁻¹) := by
      linear_combination (-1 : S) * hιc
    rw [hid]
    exact Ideal.sub_mem _ hb (Ideal.mul_mem_right _ _ ha)
  have h1 : IsDedekindDomain.HeightOneSpectrum.valuation F v
      (algebraMap S F (s - t * ι (b * a⁻¹))) < 1 :=
    (IsDedekindDomain.HeightOneSpectrum.valuation_lt_one_iff_mem v _).mpr hmem
  have h2 : IsDedekindDomain.HeightOneSpectrum.valuation F v (algebraMap S F t) = 1 := by
    rw [IsDedekindDomain.HeightOneSpectrum.valuation_of_algebraMap]
    exact IsDedekindDomain.HeightOneSpectrum.intValuation_eq_one_iff.mpr ht
  have h3 : algebraMap S F (s - t * ι (b * a⁻¹)) =
      algebraMap S F t * (y - algebraMap S F (ι (b * a⁻¹))) := by
    rw [map_sub, map_mul, ← hst]
    ring
  rw [h3, map_mul, h2, one_mul] at h1
  exact h1

theorem wcpa_dj_lr1k_cp_normalize : ∀ (k : Type u) [Field k] [IsAlgClosed k] (F : Type u) [Field F] (ι : k →+* F) (O : ValuationSubring F) (x π₀ : F) (e : ℕ), 0 < e → π₀ ≠ 0 → O.valuation (x / π₀ ^ e) = 1 → (∀ y : F, O.valuation y ≤ 1 → ∃ c : k, O.valuation (y - ι c) < 1) → ∃ β : k, β ≠ 0 ∧ x / (ι β * π₀) ^ e ∈ O ∧ O.valuation (x / (ι β * π₀) ^ e - 1) < 1 :=
by
  intro k _ _ F _ ι O x π₀ e he _hπ hu hlift
  obtain ⟨c, hc⟩ := hlift (x / π₀ ^ e) (le_of_eq hu)
  have hvc : O.valuation (ι c) = 1 := by
    have h1 : O.valuation (x / π₀ ^ e - (x / π₀ ^ e - ι c)) = O.valuation (x / π₀ ^ e) :=
      Valuation.map_sub_eq_of_lt_left _ (by rw [hu]; exact hc)
    rwa [sub_sub_cancel, hu] at h1
  have hιc : ι c ≠ 0 := by
    intro h
    rw [h, map_zero] at hvc
    exact zero_ne_one hvc
  have hc0 : c ≠ 0 := by
    intro h
    apply hιc
    rw [h, map_zero]
  obtain ⟨β, hβ⟩ := IsAlgClosed.exists_pow_nat_eq c he
  have hβ0 : β ≠ 0 := by
    intro h
    apply hc0
    rw [← hβ, h, zero_pow he.ne']
  have key : x / (ι β * π₀) ^ e = x / π₀ ^ e / ι c := by
    rw [mul_pow, ← map_pow, hβ, div_div, mul_comm (ι c)]
  have hval1 : O.valuation (x / π₀ ^ e / ι c) = 1 := by
    rw [Valuation.map_div, hu, hvc, div_one]
  refine ⟨β, hβ0, ?_, ?_⟩
  · rw [key]
    exact (ValuationSubring.valuation_le_one_iff O _).mp (le_of_eq hval1)
  · rw [key, div_sub_one hιc, Valuation.map_div, hvc, div_one]
    exact hc

theorem wcpa_dj_lr1k_cp_zvaluation_facts : ∀ (F : Type u) [Field F] (v : Valuation F (WithZero (Multiplicative ℤ))) (ϖ : F), v ϖ = WithZero.exp (-1) → (∀ z : F, z ≠ 0 → ∃ m : ℤ, v (z / ϖ ^ m) = 1) ∧ ∀ (x : F) (n : ℕ), v x = WithZero.exp (-(n : ℤ)) → v (x / ϖ ^ n) = 1 :=
by
  intro F _ v ϖ hϖ
  refine ⟨?_, ?_⟩
  · intro z hz
    have hvz : v z ≠ 0 := (Valuation.ne_zero_iff v).mpr hz
    refine ⟨-WithZero.log (v z), ?_⟩
    rw [map_div₀, map_zpow₀, hϖ, ← WithZero.exp_zsmul]
    have e : (-WithZero.log (v z)) • (-1 : ℤ) = WithZero.log (v z) := by
      rw [smul_eq_mul]; ring
    rw [e, WithZero.exp_log hvz]
    exact div_self hvz
  · intro x n hx
    rw [map_div₀, map_pow, hϖ, ← WithZero.exp_nsmul, hx]
    have e : n • (-1 : ℤ) = -(n : ℤ) := by
      rw [nsmul_eq_mul]; ring
    rw [e]
    exact div_self WithZero.exp_ne_zero

theorem wcpa_dj_lr1k_eb_bd_lb_curve_places : ∀ (k : Type u) [Field k] [IsAlgClosed k] (F : Type u) [Field F] [Algebra (RatFunc k) F] [FiniteDimensional (RatFunc k) F], ∃ (s : ℕ) (Q : Fin s → ValuationSubring F) (e : Fin s → ℕ) (ϖ w : Fin s → F), (∀ A : ValuationSubring F, (∀ g : RatFunc k, algebraMap (RatFunc k) F g ∈ A ↔ ∃ p q : Polynomial k, q.eval 0 ≠ 0 ∧ g * algebraMap (Polynomial k) (RatFunc k) q = algebraMap (Polynomial k) (RatFunc k) p) ↔ ∃ j, Q j = A) ∧ (∀ j, 1 ≤ e j) ∧ ∑ j, e j = Module.finrank (RatFunc k) F ∧ (∀ j, algebraMap (RatFunc k) F RatFunc.X = ϖ j ^ e j * w j ∧ w j ∈ Q j ∧ (Q j).valuation (w j - 1) < 1) ∧ (∀ j, ϖ j ≠ 0 ∧ (Q j).valuation (ϖ j) < 1 ∧ ∀ j', j' ≠ j → (Q j').valuation (ϖ j) = 1) ∧ (∀ j (z : F), z ≠ 0 → ∃ m : ℤ, (Q j).valuation (z / ϖ j ^ m) = 1) :=
