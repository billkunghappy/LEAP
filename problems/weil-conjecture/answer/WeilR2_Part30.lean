  have sp_fin_dim : ∀ (V K L : Type u) [CommRing V] [IsDomain V] [Field K] [Algebra V K]
      [IsFractionRing V K] [Field L] [Algebra V L] [Algebra K L] [IsScalarTower V K L] (n : ℕ)
      (b : Fin n → L), (∀ x : L, ∃ s : V, s ≠ 0 ∧
