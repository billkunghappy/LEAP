    intro σ a σ' a' hP hP'
    have hσV := hthrough σ hP.2.1
    have hσ'V := hthrough σ' hP'.2.1
    have hL5 := wcpa_dj_lr1k_ll_dp_centre_ideal Ω W X uX σ hP.1 V hV hle (hpre σ hσV) a
    have hL5' := wcpa_dj_lr1k_ll_dp_centre_ideal Ω W X uX σ' hP'.1 V hV hle (hpre σ' hσ'V) a'
    have hτd : τ σ' - τ σ =
