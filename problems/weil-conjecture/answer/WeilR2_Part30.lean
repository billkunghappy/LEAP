      · refine Finset.sum_congr rfl fun k _ => ?_
        have e1 : IsLocalRing.residue ↥(V j) ⟨algebraMap K L (α ⟨j, k⟩ : K), hAmem ⟨j, k⟩⟩ =
            wcEbBdResAlg K (V j) (c j k) := congrArg (wcEbBdResAlg K (V j)) (hα ⟨j, k⟩)
