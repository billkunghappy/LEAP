        have h2 := (IntermediateField.mem_fixedField_iff _ _).mp hx'.1 _ h1
        rw [AlgEquiv.mul_apply, AlgEquiv.mul_apply] at h2
        show g (φ x) = φ x
        rw [← hτφ]
        calc g (τ x) = τ (τ⁻¹ (g (τ x))) := (AlgEquiv.apply_symm_apply τ _).symm
          _ = τ x := by rw [h2]
      · exact separableClosure.map_le_of_algHom φ ⟨x, hx'.2, rfl⟩
    have hsep : Algebra.IsSeparable K ↥(wcTrM V K N) := by
      refine ⟨fun x => ?_⟩
      have := (IntermediateField.mem_inf.mp x.2).2
      exact IsSeparable.of_algHom K (wcTrM V K N).val (mem_separableClosure_iff.mp this)
    exact isGalois_iff.mpr ⟨hsep, hnormal⟩

  have p4 : ∀ (V K N : Type u) [CommRing V] [Field K] [Field N] [Algebra V K] [Algebra K N]
      [Algebra V N] [IsScalarTower V K N] [FiniteDimensional K N] [Normal K N]
      (O : ValuationSubring N), (∀ x : N, x ∈ O ↔ IsIntegral V x) →
      (∀ (x : N) (hx : x ∈ O), ((⟨x, hx⟩ : O) ∈ IsLocalRing.maximalIdeal O ↔
        (x = 0 ∨ ¬ IsIntegral V x⁻¹))) →
      Normal K ↥(wcTrM V K N) →
      ∀ h : ↥(wcTrM V K N) ≃ₐ[K] ↥(wcTrM V K N),
      (∀ x : ↥(wcTrM V K N), IsIntegral V x → h x - x = 0 ∨ ¬ IsIntegral V (h x - x)⁻¹) →
      h = 1 := by
    intro V K N _ _ _ _ _ _ _ _ _ O hO hOm hMn h hh
    haveI := hMn
    set S0 : Set (N ≃ₐ[K] N) := {σ : N ≃ₐ[K] N | ∀ x : N, IsIntegral V x →
      IsIntegral V (σ x - x) ∧ (σ x - x = 0 ∨ ¬ IsIntegral V (σ x - x)⁻¹)} with hS0
    set Pm : N → Prop := fun z => IsIntegral V z ∧ (z = 0 ∨ ¬ IsIntegral V z⁻¹) with hPmdef
    have hprime : (IsLocalRing.maximalIdeal O).IsPrime := Ideal.IsMaximal.isPrime inferInstance
    have hPm : ∀ a : O, Pm (a : N) ↔ a ∈ IsLocalRing.maximalIdeal O := by
      intro a
      constructor
      · intro ha; exact (hOm a a.2).mpr ha.2
      · intro ha; exact ⟨(hO _).mp a.2, (hOm a a.2).mp ha⟩
    have hPm0 : Pm 0 := ⟨isIntegral_zero, Or.inl rfl⟩
    have hPmadd : ∀ z w, Pm z → Pm w → Pm (z + w) := by
      intro z w hz hw
      have h1 := (hPm ⟨z, (hO _).mpr hz.1⟩).mp hz
      have h2 := (hPm ⟨w, (hO _).mpr hw.1⟩).mp hw
      exact (hPm (⟨z, (hO _).mpr hz.1⟩ + ⟨w, (hO _).mpr hw.1⟩)).mpr (Ideal.add_mem _ h1 h2)
    have hPmneg : ∀ z, Pm z → Pm (-z) := by
      intro z hz
      have h1 := (hPm ⟨z, (hO _).mpr hz.1⟩).mp hz
      exact (hPm (-⟨z, (hO _).mpr hz.1⟩)).mpr (neg_mem h1)
    have hPmmul : ∀ w z, IsIntegral V w → Pm z → Pm (w * z) := by
      intro w z hw hz
      have h1 := (hPm ⟨z, (hO _).mpr hz.1⟩).mp hz
      exact (hPm (⟨w, (hO _).mpr hw⟩ * ⟨z, (hO _).mpr hz.1⟩)).mpr (Ideal.mul_mem_left _ _ h1)
    have hPmpow : ∀ z (k : ℕ), IsIntegral V z → Pm (z ^ k) → Pm z := by
      intro z k hz hk
      have h1 := (hPm (⟨z, (hO _).mpr hz⟩ ^ k)).mp hk
      exact (hPm ⟨z, (hO _).mpr hz⟩).mpr (hprime.mem_of_pow_mem k h1)
    have hint : ∀ (τ : N ≃ₐ[K] N) (z : N), IsIntegral V (τ z) ↔ IsIntegral V z := by
      intro τ z
      constructor
      · intro h
        have := IsIntegral.map (R := V) (A := K) τ.symm h
        simpa using this
      · intro h
        exact IsIntegral.map (R := V) (A := K) τ h
    have hIact : ∀ g ∈ Subgroup.closure S0, ∀ x : N, IsIntegral V x → Pm (g x - x) := by
      intro g hg
      induction hg using Subgroup.closure_induction with
      | mem g hg => intro x hx; exact hg x hx
      | one => intro x hx; simp only [AlgEquiv.one_apply, sub_self]; exact hPm0
      | mul g g' _ _ ihg ihg' =>
        intro x hx
        have e : (g * g') x - x = (g (g' x) - g' x) + (g' x - x) := by
          rw [AlgEquiv.mul_apply]; ring
        rw [e]
        exact hPmadd _ _ (ihg _ ((hint g' x).mpr hx)) (ihg' x hx)
      | inv g _ ihg =>
        intro x hx
        have hgg : g (g⁻¹ x) = x := AlgEquiv.apply_symm_apply g x
        have hx' : IsIntegral V (g⁻¹ x) := (hint g (g⁻¹ x)).mp (by rw [hgg]; exact hx)
        have h1 := ihg _ hx'
        rw [hgg] at h1
        have e : g⁻¹ x - x = -(x - g⁻¹ x) := by ring
        rw [e]; exact hPmneg _ h1
    have hsepI : ∀ (τ : N ≃ₐ[K] N) (z : N), z ∈ separableClosure K N →
        τ z ∈ separableClosure K N :=
      fun τ z hz => separableClosure.map_le_of_algHom (τ : N →ₐ[K] N) ⟨z, hz, rfl⟩
    obtain ⟨σ, hσ⟩ := AlgEquiv.restrictNormalHom_surjective (F := K) (K₁ := ↥(wcTrM V K N)) N h
    have hσc : ∀ c : ↥(wcTrM V K N), ((h c : ↥(wcTrM V K N)) : N) = σ (c : N) := by
      intro c
      rw [← hσ]
      exact AlgEquiv.restrictNormal_commutes σ ↥(wcTrM V K N) c
    have he1 : ∀ y : N, IsIntegral V y → y ∈ separableClosure K N → Pm (σ y - y) := by
      intro y hy hys
      let R : Subring N := (integralClosure V N).toSubring ⊓
        (separableClosure K N).toSubalgebra.toSubring
      have hτR : ∀ τ : N ≃ₐ[K] N, τ y ∈ R := fun τ =>
        Subring.mem_inf.mpr ⟨(hint τ y).mpr hy, hsepI τ y hys⟩
      let P : Polynomial N := ∏ τ : ↥(Subgroup.closure S0),
        (Polynomial.X - Polynomial.C ((τ : N ≃ₐ[K] N) y))
      let Q : Polynomial R := ∏ τ : ↥(Subgroup.closure S0),
        (Polynomial.X - Polynomial.C (⟨(τ : N ≃ₐ[K] N) y, hτR τ⟩ : R))
      have hPQ : P = Q.map R.subtype := by
        simp only [P, Q, Polynomial.map_prod, Polynomial.map_sub, Polynomial.map_X,
          Polynomial.map_C]
        rfl
      have hcR : ∀ k, P.coeff k ∈ R := by
        intro k; rw [hPQ, Polynomial.coeff_map]; exact (Q.coeff k).2
      have hcfix : ∀ g ∈ Subgroup.closure S0, ∀ k, g (P.coeff k) = P.coeff k := by
        intro g hg k
        have hmap : P.map (g : N →+* N) = P := by
          simp only [P, Polynomial.map_prod, Polynomial.map_sub, Polynomial.map_X,
            Polynomial.map_C]
          refine Fintype.prod_equiv (Equiv.mulLeft (⟨g, hg⟩ : ↥(Subgroup.closure S0))) _ _
            (fun τ => ?_)
          simp [AlgEquiv.mul_apply]
        have := congrArg (fun p => Polynomial.coeff p k) hmap
        simpa [Polynomial.coeff_map] using this
      have hcM : ∀ k, P.coeff k ∈ wcTrM V K N := fun k =>
        IntermediateField.mem_inf.mpr ⟨(IntermediateField.mem_fixedField_iff _ _).mpr
          (fun g hg => hcfix g hg k), (Subring.mem_inf.mp (hcR k)).2⟩
      have hcint : ∀ k, IsIntegral V (P.coeff k) := fun k => (Subring.mem_inf.mp (hcR k)).1
      have hcPm : ∀ k, Pm (σ (P.coeff k) - P.coeff k) := by
        intro k
        let c' : ↥(wcTrM V K N) := ⟨P.coeff k, hcM k⟩
        have hc'i : IsIntegral V c' :=
          (isIntegral_algHom_iff ((wcTrM V K N).val.restrictScalars V) Subtype.val_injective).mp
            (hcint k)
        have hcoe : ((h c' - c' : ↥(wcTrM V K N)) : N) = σ (P.coeff k) - P.coeff k := by
          show ((h c' : ↥(wcTrM V K N)) : N) - (c' : N) = _
          rw [hσc]
        refine ⟨((hint σ _).mpr (hcint k)).sub (hcint k), ?_⟩
        rcases hh c' hc'i with h0 | hni
        · left; rw [← hcoe, h0]; simp
        · right; intro hi; apply hni
          rw [← (isIntegral_algHom_iff ((wcTrM V K N).val.restrictScalars V)
            Subtype.val_injective)]
          show IsIntegral V (((h c' - c')⁻¹ : ↥(wcTrM V K N)) : N)
          rw [IntermediateField.coe_inv, hcoe]; exact hi
      have hPy : P.eval y = 0 := by
        simp only [P, Polynomial.eval_prod, Polynomial.eval_sub, Polynomial.eval_X,
          Polynomial.eval_C]
        exact Finset.prod_eq_zero (Finset.mem_univ (1 : ↥(Subgroup.closure S0))) (by simp)
      have hmapσ : (P.map (σ : N →+* N)).eval (σ y) = 0 := by
        rw [Polynomial.eval_map, show σ y = (σ : N →+* N) y from rfl, Polynomial.eval₂_at_apply,
          hPy, map_zero]
      have hPσ : Pm (P.eval (σ y)) := by
        have e : P.eval (σ y) = (P - P.map (σ : N →+* N)).eval (σ y) := by
          rw [Polynomial.eval_sub, hmapσ, sub_zero]
        rw [e, Polynomial.eval_eq_sum_range]
        apply Finset.sum_induction _ Pm hPmadd hPm0
        intro i _
        rw [mul_comm]
        apply hPmmul _ _ (((hint σ y).mpr hy).pow i)
        rw [Polynomial.coeff_sub, Polynomial.coeff_map]
        have h1 := hPmneg _ (hcPm i)
        rw [neg_sub] at h1
        exact h1
      have hprodeq : P.eval (σ y) =
          ∏ τ : ↥(Subgroup.closure S0), (σ y - (τ : N ≃ₐ[K] N) y) := by
        simp only [P, Polynomial.eval_prod, Polynomial.eval_sub, Polynomial.eval_X,
          Polynomial.eval_C]
      rw [hprodeq] at hPσ
      have hfi : ∀ τ : ↥(Subgroup.closure S0), σ y - (τ : N ≃ₐ[K] N) y ∈ O := fun τ =>
        (hO _).mpr (((hint σ y).mpr hy).sub ((hint _ y).mpr hy))
      let fO : ↥(Subgroup.closure S0) → O := fun τ => ⟨_, hfi τ⟩
      have hcoeprod : ((∏ τ, fO τ : O) : N) =
          ∏ τ : ↥(Subgroup.closure S0), (σ y - (τ : N ≃ₐ[K] N) y) := by
        show O.subtype (∏ τ, fO τ) = _
        rw [map_prod]; rfl
      have hmem := (hPm (∏ τ, fO τ)).mp (by rw [hcoeprod]; exact hPσ)
      obtain ⟨τ, _, hτ⟩ := (Ideal.IsPrime.prod_mem_iff (hp := hprime)).mp hmem
      have h1 := (hPm (fO τ)).mpr hτ
      have h2 := hIact τ τ.2 y hy
      have e : σ y - y = (σ y - (τ : N ≃ₐ[K] N) y) + ((τ : N ≃ₐ[K] N) y - y) := by ring
      rw [e]; exact hPmadd _ _ h1 h2
    have he2 : ∀ x : N, IsIntegral V x → Pm (σ x - x) := by
      intro x hx
      haveI : ExpChar K (ringExpChar K) := ringExpChar.expChar K
      haveI : ExpChar (separableClosure K N) (ringExpChar K) :=
        expChar_of_injective_algebraMap (algebraMap K (separableClosure K N)).injective
          (ringExpChar K)
      haveI : ExpChar N (ringExpChar K) :=
        expChar_of_injective_algebraMap (algebraMap K N).injective (ringExpChar K)
      haveI := separableClosure.isPurelyInseparable K N
      obtain ⟨n, s, hs⟩ := IsPurelyInseparable.pow_mem (separableClosure K N) (ringExpChar K) x
      have hys : x ^ ringExpChar K ^ n ∈ separableClosure K N := by rw [← hs]; exact s.2
      have h1 := he1 _ (hx.pow _) hys
      rw [map_pow, ← sub_pow_expChar_pow] at h1
      exact hPmpow _ _ (((hint σ x).mpr hx).sub hx) h1
    have hσS : σ ∈ Subgroup.closure S0 := Subgroup.subset_closure (fun x hx => he2 x hx)
    apply AlgEquiv.ext
    intro c
    apply Subtype.ext
    rw [hσc, AlgEquiv.one_apply]
    exact (IntermediateField.mem_fixedField_iff _ _).mp (IntermediateField.mem_inf.mp c.2).1 σ hσS

  have q3 : ∀ (V K M : Type u) [CommRing V] [Field K] [Field M] [Algebra V K] [Algebra K M]
      [Algebra V M] [IsScalarTower V K M] [FiniteDimensional K M] [IsGalois K M]
      (O : ValuationSubring M), (∀ x : M, x ∈ O ↔ IsIntegral V x) →
      (∀ (x : M) (hx : x ∈ O), ((⟨x, hx⟩ : O) ∈ IsLocalRing.maximalIdeal O ↔
        (x = 0 ∨ ¬ IsIntegral V x⁻¹))) →
      (∀ h : M ≃ₐ[K] M, (∀ x : M, IsIntegral V x → h x - x = 0 ∨
        ¬ IsIntegral V (h x - x)⁻¹) → h = 1) →
      ∃ ω : M, IsIntegral V ω ∧
        ∀ h : M ≃ₐ[K] M, h ≠ 1 → h ω - ω ≠ 0 ∧ IsIntegral V (h ω - ω)⁻¹ := by
    intro V K M _ _ _ _ _ _ _ _ _ O hO hOm hfaith
    letI : MulSemiringAction (M ≃ₐ[K] M) O :=
      { smul := fun g x => ⟨g x, (hO _).mpr (IsIntegral.map (R := V) (A := K) g ((hO _).mp x.2))⟩
        one_smul := fun x => Subtype.ext rfl
        mul_smul := fun g h x => Subtype.ext rfl
        smul_zero := fun g => Subtype.ext (map_zero g)
        smul_add := fun g x y => Subtype.ext (map_add g _ _)
        smul_one := fun g => Subtype.ext (map_one g)
        smul_mul := fun g x y => Subtype.ext (map_mul g _ _) }
    set κ := IsLocalRing.ResidueField O
    set res := IsLocalRing.residue O
    haveI : FaithfulSMul (M ≃ₐ[K] M) κ := by
      refine ⟨fun {g₁ g₂} hg => ?_⟩
      have key : g₂⁻¹ * g₁ = 1 := by
        apply hfaith
        intro x hx
        have hxO := (hO x).mpr hx
        have h1 : res ((g₂⁻¹ * g₁) • (⟨x, hxO⟩ : O)) = res ⟨x, hxO⟩ := by
          rw [IsLocalRing.ResidueField.residue_smul, mul_smul, hg, ← mul_smul, inv_mul_cancel,
            one_smul]
        have h2 : (g₂⁻¹ * g₁) • (⟨x, hxO⟩ : O) - ⟨x, hxO⟩ ∈ IsLocalRing.maximalIdeal O := by
          rw [← IsLocalRing.residue_eq_zero_iff, map_sub, h1, sub_self]
        have hmem : (g₂⁻¹ * g₁) x - x ∈ O := ((g₂⁻¹ * g₁) • (⟨x, hxO⟩ : O) - ⟨x, hxO⟩).2
        have e : ((g₂⁻¹ * g₁) • (⟨x, hxO⟩ : O) - ⟨x, hxO⟩ : O) = ⟨(g₂⁻¹ * g₁) x - x, hmem⟩ :=
          Subtype.ext rfl
        rw [e, hOm] at h2
        exact h2
      calc g₁ = g₂ * (g₂⁻¹ * g₁) := by group
        _ = g₂ := by rw [key, mul_one]
    have hfr : Module.finrank (FixedPoints.subfield (M ≃ₐ[K] M) κ) κ =
        Fintype.card (M ≃ₐ[K] M) := FixedPoints.finrank_eq_card _ _
    haveI : FiniteDimensional (FixedPoints.subfield (M ≃ₐ[K] M) κ) κ :=
      Module.finite_of_finrank_pos (by rw [hfr]; exact Fintype.card_pos)
    haveI := FixedPoints.isSeparable (M ≃ₐ[K] M) κ
    obtain ⟨α, hα⟩ := Field.exists_primitive_element (FixedPoints.subfield (M ≃ₐ[K] M) κ) κ
    have hstab : ∀ g : M ≃ₐ[K] M, g • α = α → g = 1 := by
      intro g hg
      let φ : κ →ₐ[FixedPoints.subfield (M ≃ₐ[K] M) κ] κ :=
        { MulSemiringAction.toRingHom _ κ g with commutes' := fun c => c.2 g }
      have hadj : Algebra.adjoin (FixedPoints.subfield (M ≃ₐ[K] M) κ) {α} = ⊤ := by
        rw [← IntermediateField.adjoin_simple_toSubalgebra_of_isAlgebraic
          (Algebra.IsAlgebraic.isAlgebraic α), hα, IntermediateField.top_toSubalgebra]
      have hφ : φ = AlgHom.id _ κ := by
        apply AlgHom.ext_of_adjoin_eq_top hadj
        intro x hx
        rw [Set.mem_singleton_iff.mp hx]
        exact hg
      apply FaithfulSMul.eq_of_smul_eq_smul (α := κ)
      intro a
      rw [one_smul]
      exact DFunLike.congr_fun hφ a
    obtain ⟨ω₀, hω₀⟩ := IsLocalRing.residue_surjective (R := O) α
    refine ⟨(ω₀ : M), (hO _).mp ω₀.2, fun h hne => ?_⟩
    have hres : res (h • ω₀ - ω₀) ≠ 0 := by
      rw [map_sub, IsLocalRing.ResidueField.residue_smul, hω₀, sub_ne_zero]
      exact fun e => hne (hstab h e)
    have hu : IsUnit (h • ω₀ - ω₀) := (IsLocalRing.residue_ne_zero_iff_isUnit _).mp hres
    obtain ⟨w, hw⟩ := hu.exists_right_inv
    have hw' : (h (ω₀ : M) - ω₀) * (w : M) = 1 := congrArg Subtype.val hw
    refine ⟨left_ne_zero_of_mul_eq_one hw', ?_⟩
    rw [← eq_inv_of_mul_eq_one_right hw']
    exact (hO _).mp w.2

  have q4 : ∀ (V K M : Type u) [CommRing V] [IsDomain V] [Field K] [Algebra V K]
      [IsFractionRing V K] [Field M] [Algebra K M] [Algebra V M] [IsScalarTower V K M]
      [FiniteDimensional K M] [IsGalois K M],
      (∀ x y : V, x ∣ y ∨ y ∣ x) → ∀ ω : M, IsIntegral V ω →
      (∀ h : M ≃ₐ[K] M, h ≠ 1 → h ω - ω ≠ 0 ∧ IsIntegral V (h ω - ω)⁻¹) →
      ∃ g : Polynomial V, g.Monic ∧ g.natDegree = Module.finrank K M ∧
        Polynomial.aeval ω g = 0 ∧
        ∃ v : M, IsIntegral V v ∧ Polynomial.aeval ω (Polynomial.derivative g) * v = 1 := by
    intro V K M _ _ _ _ _ _ _ _ _ _ _ htot ω hωi hω
    have hic : ∀ x : K, IsIntegral V x → ∃ s : V, algebraMap V K s = x := by
      intro x hx
      haveI : ValuationRing V := ValuationRing.iff_dvd_total.mpr ⟨fun a b => htot a b⟩
      letI : GCDMonoid V := IsBezout.toGCDDomain V
      exact IsIntegrallyClosed.isIntegral_iff.mp hx
    have hint : ∀ (τ : M ≃ₐ[K] M) (z : M), IsIntegral V z → IsIntegral V (τ z) :=
      fun τ z h => IsIntegral.map (R := V) (A := K) τ h
    let R : Subring M := (integralClosure V M).toSubring
    let P : Polynomial M := ∏ τ : M ≃ₐ[K] M, (Polynomial.X - Polynomial.C (τ ω))
    let Q : Polynomial R := ∏ τ : M ≃ₐ[K] M,
      (Polynomial.X - Polynomial.C (⟨τ ω, hint τ ω hωi⟩ : R))
    have hPQ : P = Q.map R.subtype := by
      simp only [P, Q, Polynomial.map_prod, Polynomial.map_sub, Polynomial.map_X,
        Polynomial.map_C]
      rfl
    have hcint : ∀ k, IsIntegral V (P.coeff k) := by
      intro k; rw [hPQ, Polynomial.coeff_map]; exact (Q.coeff k).2
    have hcfix : ∀ g : M ≃ₐ[K] M, ∀ k, g (P.coeff k) = P.coeff k := by
      intro g k
      have hmap : P.map (g : M →+* M) = P := by
        simp only [P, Polynomial.map_prod, Polynomial.map_sub, Polynomial.map_X,
          Polynomial.map_C]
        refine Fintype.prod_equiv (Equiv.mulLeft g) _ _ (fun τ => ?_)
        simp [AlgEquiv.mul_apply]
      have := congrArg (fun p => Polynomial.coeff p k) hmap
      simpa [Polynomial.coeff_map] using this
    have hcV : ∀ k, P.coeff k ∈ Set.range (algebraMap V M) := by
      intro k
      have hbot : P.coeff k ∈ (⊥ : IntermediateField K M) :=
        (IsGalois.mem_bot_iff_fixed _).mpr (fun f => hcfix f k)
      obtain ⟨a, ha⟩ := IntermediateField.mem_bot.mp hbot
      have haI : IsIntegral V a := by
        rw [← isIntegral_algHom_iff (IsScalarTower.toAlgHom V K M) (algebraMap K M).injective]
        show IsIntegral V (algebraMap K M a)
        rw [ha]; exact hcint k
      obtain ⟨s, hs⟩ := hic a haI
      exact ⟨s, by rw [IsScalarTower.algebraMap_apply V K M, hs, ha]⟩
    have hPm : P.Monic :=
      Polynomial.monic_prod_of_monic _ _ (fun τ _ => Polynomial.monic_X_sub_C _)
    have hPdeg : P.natDegree = Module.finrank K M := by
      rw [Polynomial.natDegree_prod_of_monic _ _ (fun τ _ => Polynomial.monic_X_sub_C _)]
      simp only [Polynomial.natDegree_X_sub_C, Finset.sum_const, Finset.card_univ, smul_eq_mul,
        mul_one]
      rw [← Nat.card_eq_fintype_card, IsGalois.card_aut_eq_finrank]
    obtain ⟨g, hgmap, hgdeg, hgm⟩ :=
      Polynomial.lifts_and_natDegree_eq_and_monic ((Polynomial.lifts_iff_coeff_lifts P).mpr hcV)
        hPm
    have haeval : ∀ q : Polynomial V, Polynomial.aeval ω q = (q.map (algebraMap V M)).eval ω :=
      fun q => (Polynomial.eval_map_algebraMap q ω).symm
    refine ⟨g, hgm, hgdeg.trans hPdeg, ?_, ?_⟩
    · rw [haeval, hgmap]
      simp only [P, Polynomial.eval_prod, Polynomial.eval_sub, Polynomial.eval_X,
        Polynomial.eval_C]
      exact Finset.prod_eq_zero (Finset.mem_univ 1) (by simp)
    · rw [haeval, ← Polynomial.derivative_map, hgmap]
