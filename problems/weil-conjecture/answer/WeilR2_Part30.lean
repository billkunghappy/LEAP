    obtain ⟨D₁, hD₁⟩ := (Polynomial.lifts_iff_coeff_lifts _).mpr hcoef
    rw [Polynomial.coe_mapRingHom] at hD₁
    refine ⟨μ, D₁, hμ0, ⟨i₀, ?_⟩, ?_⟩
    · have h1 : (D₁.coeff i₀ : K) = 1 := by
        have := congrArg (fun p => Polynomial.coeff p i₀) hD₁
        simp only [Polynomial.coeff_map, Polynomial.coeff_C_mul] at this
        change (D₁.coeff i₀ : K) = μ⁻¹ * D.coeff i₀ at this
        rw [this, ← hμ, inv_mul_cancel₀ hμ0]
      have h2 : D₁.coeff i₀ = 1 := Subtype.ext h1
      rw [h2]; exact isUnit_one
    · rw [hD₁, ← mul_assoc, ← Polynomial.C_mul, mul_inv_cancel₀ hμ0, Polynomial.C_1, one_mul]



  have s3 : ∀ Va Vb : ValuationSubring L, Va.comap (algebraMap K L) = V₀ →
      Vb.comap (algebraMap K L) = V₀ → ∀ x : L, x ∈ Va → x ∉ Vb →
      ∃ w : L, (∀ V : ValuationSubring L, V.comap (algebraMap K L) = V₀ → w ∈ V) ∧
        Va.valuation w < 1 ∧ Vb.valuation w = 1 := by
    intro Va Vb ha hb x hxa hxb
    let f : ↥V₀ →+* L := (algebraMap K L).comp V₀.subtype
    have hfV' : ∀ V : ValuationSubring L, V.comap (algebraMap K L) = V₀ → ∀ a, f a ∈ V :=
      hfV
    have hx0 : x ≠ 0 := fun h => hxb (h ▸ Vb.zero_mem)
    set z := x⁻¹ with hz
    have hxz : x * z = 1 := mul_inv_cancel₀ hx0
    have hzb : Vb.valuation z < 1 := by
      have h1 : 1 < Vb.valuation x := by
        rw [← not_le, Vb.valuation_le_one_iff]; exact hxb
      rw [hz, map_inv₀]
      exact inv_lt_one_of_one_lt₀ h1
    have hxa' : Va.valuation x ≤ 1 := (Va.valuation_le_one_iff _).mpr hxa
    have hzI : IsIntegral K z := Algebra.IsIntegral.isIntegral z
    obtain ⟨μ, D₁, hμ, ⟨i₀, hi₀⟩, hD⟩ :=
      pf (minpoly K z) (minpoly.ne_zero hzI)
    have hD₁ : Polynomial.eval₂ f z D₁ = 0 := by
      have h := minpoly.aeval K z
      rw [hD, map_mul, Polynomial.aeval_C] at h
      have hμ' : algebraMap K L μ ≠ 0 := (map_ne_zero _).mpr hμ
      have h2 := (mul_eq_zero.mp h).resolve_left hμ'
      rw [Polynomial.aeval_def, Polynomial.eval₂_map] at h2
      exact h2
    have hex : ∃ i, IsUnit (D₁.coeff i) := ⟨i₀, hi₀⟩
    set j := Nat.find hex with hj
    have hju : IsUnit (D₁.coeff j) := Nat.find_spec hex
    have hjmin : ∀ i < j, D₁.coeff i ∈ IsLocalRing.maximalIdeal ↥V₀ := fun i hi =>
      (IsLocalRing.mem_maximalIdeal _).mpr (Nat.find_min hex hi)
    set n := D₁.natDegree with hn
    have hjn : j ≤ n := Polynomial.le_natDegree_of_ne_zero hju.ne_zero
    set w : L := ∑ i ∈ Finset.range j, f (D₁.coeff i) * x ^ (j - i) with hw
    set u : L := ∑ i ∈ Finset.Ico (j + 1) (n + 1), f (D₁.coeff i) * z ^ (i - j) with hu
    have hid : w + f (D₁.coeff j) + u = 0 := by
      have h0 : x ^ j * Polynomial.eval₂ f z D₁ = 0 := by rw [hD₁, mul_zero]
      rw [Polynomial.eval₂_eq_sum_range, Finset.mul_sum,
        ← Finset.sum_range_add_sum_Ico _ (show j ≤ n + 1 by omega),
        Finset.sum_eq_sum_Ico_succ_bot (show j < n + 1 by omega)] at h0
      rw [← h0, add_assoc]
      congr 1
      · refine Finset.sum_congr rfl fun i hi => ?_
        have hi' : i < j := Finset.mem_range.mp hi
        have : x ^ j = x ^ (j - i) * x ^ i := by rw [← pow_add]; congr 1; omega
        rw [this, show x ^ (j - i) * x ^ i * (f (D₁.coeff i) * z ^ i) =
          f (D₁.coeff i) * x ^ (j - i) * (x * z) ^ i by rw [mul_pow]; ring, hxz, one_pow,
          mul_one]
      · congr 1
        · rw [show x ^ j * (f (D₁.coeff j) * z ^ j) = f (D₁.coeff j) * (x * z) ^ j by
            rw [mul_pow]; ring, hxz, one_pow, mul_one]
        · refine Finset.sum_congr rfl fun i hi => ?_
          have hi' : j + 1 ≤ i := (Finset.mem_Ico.mp hi).1
          have : z ^ i = z ^ (i - j) * z ^ j := by rw [← pow_add]; congr 1; omega
          rw [this, show x ^ j * (f (D₁.coeff i) * (z ^ (i - j) * z ^ j)) =
            f (D₁.coeff i) * z ^ (i - j) * (x * z) ^ j by rw [mul_pow]; ring, hxz, one_pow,
            mul_one]
    have hwe : w = -(f (D₁.coeff j) + u) := by linear_combination hid
    refine ⟨w, ?_, ?_, ?_⟩
    · intro V hV
      rcases V.mem_or_inv_mem x with hxV | hzV
      · rw [hw]
        exact Subring.sum_mem _ fun i _ => V.mul_mem _ _ (hfV' V hV _) (V.pow_mem hxV _)
      · rw [hwe]
        refine V.neg_mem _ (V.add_mem _ _ (hfV' V hV _) ?_)
        rw [hu]
        exact Subring.sum_mem _ fun i _ => V.mul_mem _ _ (hfV' V hV _) (V.pow_mem hzV _)
    · rw [hw]
      refine Valuation.map_sum_lt _ one_ne_zero fun i hi => ?_
      rw [map_mul, map_pow]
      have h1 : Va.valuation (f (D₁.coeff i)) < 1 :=
        (s8 Va ha (D₁.coeff i)).mpr (hjmin i (Finset.mem_range.mp hi))
      exact (mul_le_of_le_one_right' (pow_le_one₀ zero_le' hxa')).trans_lt h1
    · have hu1 : Vb.valuation u < 1 := by
        rw [hu]
        refine Valuation.map_sum_lt _ one_ne_zero fun i hi => ?_
        have hi' : j + 1 ≤ i := (Finset.mem_Ico.mp hi).1
        rw [map_mul, map_pow]
        have h1 : Vb.valuation (f (D₁.coeff i)) ≤ 1 :=
          (Vb.valuation_le_one_iff _).mpr (hfV' Vb hb _)
        have h2 : Vb.valuation z ^ (i - j) < 1 := pow_lt_one₀ zero_le' hzb (by omega)
        exact (mul_le_of_le_one_left' h1).trans_lt h2
      have haj : Vb.valuation (f (D₁.coeff j)) = 1 := by
        have h1 : Vb.valuation (f (D₁.coeff j)) ≤ 1 :=
          (Vb.valuation_le_one_iff _).mpr (hfV' Vb hb _)
        refine le_antisymm h1 (not_lt.mp fun h => ?_)
        have := (s8 Vb hb (D₁.coeff j)).mp h
        exact (IsLocalRing.mem_maximalIdeal _).mp this hju
      rw [hwe, Valuation.map_neg, Valuation.map_add_eq_of_lt_left _ (by rw [haj]; exact hu1),
        haj]



  obtain ⟨e, M₀, heI, hspan, hmat, hchi⟩ : ∃ (e : Fin (Module.finrank K L) → L)
      (M₀ : Matrix (Fin (Module.finrank K L)) (Fin (Module.finrank K L)) ↥V₀),
      (∀ i, IsIntegral ↥V₀ (e i)) ∧
      (∀ y : L, IsIntegral ↥V₀ y → ∃ c : Fin (Module.finrank K L) → ↥V₀,
         y = ∑ i, algebraMap K L (c i : K) * e i) ∧
      (∀ j, s * e j = ∑ i, algebraMap K L (M₀ i j : K) * e i) ∧
      LinearMap.charpoly (Algebra.lmul K L s) = (M₀.charpoly).map V₀.subtype := by
    have hsI0 : IsIntegral ↥V₀ s := s1 s hs
    set N := Module.finrank K L with hN
    have hNpos : 0 < N := Module.finrank_pos
    haveI : Module.Finite ↥V₀ ↥(integralClosure ↥V₀ L) :=
      Module.finite_of_finrank_pos (by rw [hR]; exact hNpos)
    let eB := Module.finBasisOfFinrankEq ↥V₀ ↥(integralClosure ↥V₀ L) hR
    let e : Fin N → L := fun i => (eB i : L)
    have hcoe : ∀ (c : ↥V₀) (y : L), c • y = algebraMap K L (c : K) * y := fun c y => rfl
    have hspan : ∀ y : L, IsIntegral ↥V₀ y → ∃ c : Fin N → ↥V₀,
        y = ∑ i, algebraMap K L (c i : K) * e i := by
      intro y hy
      set yB : ↥(integralClosure ↥V₀ L) := ⟨y, hy⟩ with hyB
      refine ⟨fun i => eB.repr yB i, ?_⟩
      have h := congrArg (fun z : ↥(integralClosure ↥V₀ L) => (z : L)) (eB.sum_repr yB)
      simp only [AddSubmonoidClass.coe_finsetSum, SetLike.val_smul] at h
      have hy' : y = (yB : L) := rfl
      conv_lhs => rw [hy', ← h]
      exact Finset.sum_congr rfl fun i _ => hcoe _ _
    have heI : ∀ i, IsIntegral ↥V₀ (e i) := fun i => (eB i).2
    have hsI : ∀ j, IsIntegral ↥V₀ (s * e j) := fun j => hsI0.mul (heI j)
    choose M hM using fun j => hspan (s * e j) (hsI j)
    let M₀ : Matrix (Fin N) (Fin N) ↥V₀ := fun i j => M j i
    have hmat : ∀ j, s * e j = ∑ i, algebraMap K L (M₀ i j : K) * e i := hM
    have hli : LinearIndependent K e := by
      rw [Fintype.linearIndependent_iff]
      intro g hg
      by_contra hne'
      push_neg at hne'
      obtain ⟨i₁, hi₁⟩ := hne'
      obtain ⟨j, -, hj⟩ := Finset.exists_max_image Finset.univ (fun i => V₀.valuation (g i))
        ⟨i₁, Finset.mem_univ _⟩
      have hgj : g j ≠ 0 := by
        intro h0
        have := hj i₁ (Finset.mem_univ _)
        rw [h0, map_zero, le_zero_iff, Valuation.zero_iff] at this
        exact hi₁ this
      have hmem : ∀ i, g i / g j ∈ V₀ := by
        intro i
        rw [← V₀.valuation_le_one_iff, map_div₀]
        exact div_le_one_of_le₀ (hj i (Finset.mem_univ _)) zero_le'
      let c : Fin N → ↥V₀ := fun i => ⟨g i / g j, hmem i⟩
      have hsum : ∑ i, c i • eB i = 0 := by
        apply Subtype.ext
        simp only [AddSubmonoidClass.coe_finsetSum, SetLike.val_smul, ZeroMemClass.coe_zero]
        have : ∑ i, c i • (eB i : L) = (g j)⁻¹ • ∑ i, g i • e i := by
          rw [Finset.smul_sum]
          refine Finset.sum_congr rfl fun i _ => ?_
          rw [hcoe, smul_smul, Algebra.smul_def]
          simp only [c, e, div_eq_inv_mul]
        rw [this, hg, smul_zero]
      have h0 := (Fintype.linearIndependent_iff.mp eB.linearIndependent) c hsum j
      have : (c j : K) = 1 := by simp [c, div_self hgj]
      rw [h0] at this
      exact zero_ne_one this
    haveI : Nonempty (Fin N) := ⟨⟨0, hNpos⟩⟩
    let fb := basisOfLinearIndependentOfCardEqFinrank hli (by simp [N])
    have hf : ∀ i, fb i = e i := fun i => by
      simp [fb, coe_basisOfLinearIndependentOfCardEqFinrank]
    refine ⟨e, M₀, heI, hspan, hmat, ?_⟩
    have htm : LinearMap.toMatrix fb fb (Algebra.lmul K L s) = M₀.map V₀.subtype := by
      ext i j
      rw [LinearMap.toMatrix_apply, Matrix.map_apply, hf]
      show fb.repr (s * e j) i = _
      rw [hmat j]
      have : ∑ i, algebraMap K L (M₀ i j : K) * e i = ∑ i, (M₀ i j : K) • fb i := by
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [hf, Algebra.smul_def]
      rw [this, fb.repr_sum_self]
      rfl
    rw [← LinearMap.charpoly_toMatrix (Algebra.lmul K L s) fb, htm, Matrix.charpoly_map]



  obtain ⟨c₁, hc₁⟩ := hspan 1 isIntegral_one
  have s6 : ∀ Va Vb : ValuationSubring L, Va.comap (algebraMap K L) = V₀ →
      Vb.comap (algebraMap K L) = V₀ → ∀ (b : L) (c₂ : Fin (Module.finrank K L) → ↥V₀),
      b = ∑ i, algebraMap K L (c₂ i : K) * e i →
      Va.valuation s < 1 → Vb.valuation s < 1 → Va.valuation b < 1 → Vb.valuation b = 1 →
      ∀ α β : IsLocalRing.ResidueField ↥V₀,
        α • (fun i => IsLocalRing.residue ↥V₀ (c₁ i)) +
          β • (fun i => IsLocalRing.residue ↥V₀ (c₂ i)) ∈
          LinearMap.range (Matrix.toLin' (M₀.map (IsLocalRing.residue ↥V₀))) →
        α = 0 ∧ β = 0 := by
    intro V₁ V₂ h₁ h₂ b c₂ hc₂ hs₁ hs₂ hb₁ hb₂ α β hmem
    have he₁ : ∀ i, e i ∈ V₁ := fun i => s7 V₁ h₁ _ (heI i)
    have he₂ : ∀ i, e i ∈ V₂ := fun i => s7 V₂ h₂ _ (heI i)
    obtain ⟨w, hw⟩ := hmem
    rw [Matrix.toLin'_apply] at hw
    obtain ⟨α', rfl⟩ := IsLocalRing.residue_surjective α
    obtain ⟨β', rfl⟩ := IsLocalRing.residue_surjective β
    choose w' hw' using fun j => IsLocalRing.residue_surjective (w j)
    have hwe : w = fun j => IsLocalRing.residue ↥V₀ (w' j) := funext fun j => (hw' j).symm
    subst hwe
    obtain ⟨f, hf⟩ : ∃ f : ↥V₀ →+* L, ∀ a, f a = algebraMap K L (a : K) :=
      ⟨(algebraMap K L).comp V₀.subtype, fun a => rfl⟩
    have hmat' := hmat
    have hc₁' := hc₁
    have s8' := s8
    simp only [← hf] at hmat' hc₁' hc₂ s8'
    set d : Fin (Module.finrank K L) → ↥V₀ :=
      fun i => α' * c₁ i + β' * c₂ i - ∑ j, M₀ i j * w' j with hd_def
    have hd : ∀ i, d i ∈ IsLocalRing.maximalIdeal ↥V₀ := by
      intro i
      rw [← IsLocalRing.residue_eq_zero_iff]
      have := congrFun hw i
      simp only [Matrix.mulVec, dotProduct, Matrix.map_apply, Pi.add_apply, Pi.smul_apply,
        smul_eq_mul] at this
      simp only [hd_def, map_sub, map_add, map_mul, map_sum, this, sub_self]
    set y : L := ∑ j, f (w' j) * e j with hy
    have hsy : s * y = ∑ i, (∑ j, f (M₀ i j) * f (w' j)) * e i := by
      simp only [hy, Finset.mul_sum, Finset.sum_mul]
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [show s * (f (w' j) * e j) = f (w' j) * (s * e j) by ring, hmat' j, Finset.mul_sum]
      exact Finset.sum_congr rfl fun i _ => by ring
    have e1 : ∑ i, f α' * f (c₁ i) * e i = f α' := by
      simp_rw [mul_assoc, ← Finset.mul_sum, ← hc₁', mul_one]
    have e2 : ∑ i, f β' * f (c₂ i) * e i = f β' * b := by
      simp_rw [mul_assoc, ← Finset.mul_sum, ← hc₂]
    set T : L := ∑ i, f (d i) * e i with hT
    have hZ : f α' + f β' * b - s * y = T := by
      rw [hsy, hT, ← e1, ← e2, ← Finset.sum_add_distrib, ← Finset.sum_sub_distrib]
      refine Finset.sum_congr rfl fun i _ => ?_
      simp only [hd_def, map_sub, map_add, map_mul, map_sum]
      ring
    have key : ∀ V : ValuationSubring L, V.comap (algebraMap K L) = V₀ → (∀ i, e i ∈ V) →
        V.valuation s < 1 → V.valuation T < 1 ∧ V.valuation (s * y) < 1 ∧ (∀ a, f a ∈ V) := by
      intro V hV he hsV
      have hfV' : ∀ a, f a ∈ V := fun a => by rw [hf]; exact hfV V hV a
      refine ⟨?_, ?_, hfV'⟩
      · refine Valuation.map_sum_lt _ one_ne_zero fun i _ => ?_
        rw [map_mul]
        have h1 : V.valuation (f (d i)) < 1 := (s8' V hV (d i)).mpr (hd i)
        have h2 : V.valuation (e i) ≤ 1 := (V.valuation_le_one_iff _).mpr (he i)
        exact (mul_le_of_le_one_right' h2).trans_lt h1
      · rw [map_mul]
        have hyV : y ∈ V := by
          rw [hy]
          exact Subring.sum_mem _ fun j _ => V.mul_mem _ _ (hfV' _) (he j)
        have h2 : V.valuation y ≤ 1 := (V.valuation_le_one_iff _).mpr hyV
        exact (mul_le_of_le_one_right' h2).trans_lt hsV
    obtain ⟨hT₁, hsy₁, hf₁⟩ := key V₁ h₁ he₁ hs₁
    obtain ⟨hT₂, hsy₂, hf₂⟩ := key V₂ h₂ he₂ hs₂
    have hα : α' ∈ IsLocalRing.maximalIdeal ↥V₀ := by
      rw [← s8' V₁ h₁]
      have : f α' = T + -(f β' * b) + s * y := by rw [← hZ]; ring
      rw [this]
      refine Valuation.map_add_lt _ (Valuation.map_add_lt _ hT₁ ?_) hsy₁
      rw [Valuation.map_neg, map_mul]
      have h2 : V₁.valuation (f β') ≤ 1 := (V₁.valuation_le_one_iff _).mpr (hf₁ _)
      exact (mul_le_of_le_one_left' h2).trans_lt hb₁
    have hβ : β' ∈ IsLocalRing.maximalIdeal ↥V₀ := by
      rw [← s8' V₂ h₂]
      have : f β' * b = T + -(f α') + s * y := by rw [← hZ]; ring
      have h3 : V₂.valuation (f β' * b) < 1 := by
        rw [this]
        refine Valuation.map_add_lt _ (Valuation.map_add_lt _ hT₂ ?_) hsy₂
        rw [Valuation.map_neg]
        exact (s8' V₂ h₂ α').mpr hα
      rwa [map_mul, hb₂, mul_one] at h3
    exact ⟨(IsLocalRing.residue_eq_zero_iff _).mpr hα,
      (IsLocalRing.residue_eq_zero_iff _).mpr hβ⟩



  have s5 : ∀ (n : ℕ) (M : Matrix (Fin n) (Fin n) (IsLocalRing.ResidueField ↥V₀))
      (v₁ v₂ : Fin n → IsLocalRing.ResidueField ↥V₀),
      (∀ α β : IsLocalRing.ResidueField ↥V₀,
        α • v₁ + β • v₂ ∈ LinearMap.range (Matrix.toLin' M) → α = 0 ∧ β = 0) →
      M.charpoly.coeff 1 = 0 := by
    intro n M v₁ v₂ h
    set R := LinearMap.range (Matrix.toLin' M) with hR'
    set S := Submodule.span (IsLocalRing.ResidueField ↥V₀) (Set.range ![v₁, v₂]) with hS
    have hli : LinearIndependent (IsLocalRing.ResidueField ↥V₀) ![v₁, v₂] := by
      rw [LinearIndependent.pair_iff]
      intro α β hαβ
      exact h α β (by rw [hαβ]; exact R.zero_mem)
    have hSr : Module.finrank (IsLocalRing.ResidueField ↥V₀) S = 2 := by
      rw [hS, finrank_span_eq_card hli]
      simp
    have hRS : R ⊓ S = ⊥ := by
      rw [Submodule.eq_bot_iff]
      intro x hx
      obtain ⟨hxR, hxS⟩ := Submodule.mem_inf.mp hx
      obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun _).mp hxS
      rw [Fin.sum_univ_two] at hc
      simp only [Matrix.cons_val_zero, Matrix.cons_val_one] at hc
      rw [← hc] at hxR
      obtain ⟨h0, h1⟩ := h _ _ hxR
      rw [← hc, h0, h1]
      simp
    have hsum := Submodule.finrank_sup_add_finrank_inf_eq R S
    rw [hRS, finrank_bot, hSr] at hsum
    have hle : Module.finrank (IsLocalRing.ResidueField ↥V₀) ↥(R ⊔ S) ≤ n := by
      have := Submodule.finrank_le (R ⊔ S)
      simpa using this
    have hrn := LinearMap.finrank_range_add_finrank_ker (Matrix.toLin' M)
    rw [Module.finrank_fin_fun] at hrn
    have hker : 2 ≤ Module.finrank (IsLocalRing.ResidueField ↥V₀)
        ↥(LinearMap.ker (Matrix.toLin' M)) := by
      rw [← hR'] at hrn
      omega
    have hmult := LinearMap.finrank_eigenspace_le (Matrix.toLin' M) 0
    rw [Module.End.eigenspace_zero, Matrix.charpoly_toLin'] at hmult
    have hne0 : M.charpoly ≠ 0 := (Matrix.charpoly_monic M).ne_zero
    have hdvd := (Polynomial.le_rootMultiplicity_iff hne0).mp (hker.trans hmult)
    rw [map_zero, sub_zero, Polynomial.X_pow_dvd_iff] at hdvd
    exact hdvd 1 (by norm_num)



  have hsep : ∃ x : L, (x ∈ V₁ ∧ x ∉ V₂) ∨ (x ∈ V₂ ∧ x ∉ V₁) := by
    by_contra hcon
    push_neg at hcon
    apply hne
    ext x
    exact ⟨fun h => (hcon x).1 h, fun h => (hcon x).2 h⟩
  obtain ⟨x, hx⟩ := hsep
  have hind : ∃ c₂ : Fin (Module.finrank K L) → ↥V₀,
      ∀ α β : IsLocalRing.ResidueField ↥V₀,
        α • (fun i => IsLocalRing.residue ↥V₀ (c₁ i)) +
          β • (fun i => IsLocalRing.residue ↥V₀ (c₂ i)) ∈
          LinearMap.range (Matrix.toLin' (M₀.map (IsLocalRing.residue ↥V₀))) →
        α = 0 ∧ β = 0 := by
    rcases hx with ⟨hxa, hxb⟩ | ⟨hxa, hxb⟩
    · obtain ⟨b, hball, hba, hbb⟩ := s3 V₁ V₂ h₁ h₂ x hxa hxb
      obtain ⟨c₂, hc₂⟩ := hspan b (s1 b hball)
      exact ⟨c₂, s6 V₁ V₂ h₁ h₂ b c₂ hc₂ hs₁ hs₂ hba hbb⟩
    · obtain ⟨b, hball, hba, hbb⟩ := s3 V₂ V₁ h₂ h₁ x hxa hxb
      obtain ⟨c₂, hc₂⟩ := hspan b (s1 b hball)
      exact ⟨c₂, s6 V₂ V₁ h₂ h₁ b c₂ hc₂ hs₂ hs₁ hba hbb⟩
  obtain ⟨c₂, hc₂⟩ := hind
  have hc := s5 _ _ _ _ hc₂
  rw [Matrix.charpoly_map, Polynomial.coeff_map, IsLocalRing.residue_eq_zero_iff] at hc
  rw [hchi, Polynomial.coeff_map]
  exact (s8 V₁ h₁ _).mpr hc

theorem wcpa_dj_lr1k_eb_pd_eg_primitive_factor : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (D : Polynomial Ω), D ≠ 0 → ∃ (μ : Ω) (D₁ : Polynomial ↥W), μ ≠ 0 ∧ (∃ i, IsUnit (D₁.coeff i)) ∧ D = Polynomial.C μ * D₁.map W.subtype :=
by
  intro Ω _ W D hD
  classical
  obtain ⟨i₀, hi₀, hmax⟩ := D.support.exists_max_image (fun j => W.valuation (D.coeff j))
    (Polynomial.support_nonempty.mpr hD)
  have hμ : D.coeff i₀ ≠ 0 := Polynomial.mem_support_iff.mp hi₀
  have hmem : ∀ j, (D.coeff i₀)⁻¹ * D.coeff j ∈ W := by
    intro j
    by_cases hj : j ∈ D.support
    · rw [← ValuationSubring.valuation_le_one_iff, Valuation.map_mul, map_inv₀]
      have hv : W.valuation (D.coeff i₀) ≠ 0 := (Valuation.ne_zero_iff _).mpr hμ
      rw [inv_mul_le_iff₀ (zero_lt_iff.mpr hv), mul_one]
      exact hmax j hj
    · rw [Polynomial.notMem_support_iff.mp hj, mul_zero]
      exact W.zero_mem
  obtain ⟨D₁, hD₁⟩ := (Polynomial.mem_lifts _).mp
    ((Polynomial.lifts_iff_coeff_lifts (f := W.subtype)
      (Polynomial.C (D.coeff i₀)⁻¹ * D)).mpr
      (fun n => ⟨⟨_, hmem n⟩, by rw [Polynomial.coeff_C_mul]; rfl⟩))
  refine ⟨D.coeff i₀, D₁, hμ, ⟨i₀, ?_⟩, ?_⟩
  · have h1 : ((D₁.coeff i₀ : W) : Ω) = 1 := by
      have h2 := congrArg (fun p => Polynomial.coeff p i₀) hD₁
      simp only [Polynomial.coeff_map, Polynomial.coeff_C_mul] at h2
      rw [inv_mul_cancel₀ hμ] at h2
      exact h2
    have h3 : D₁.coeff i₀ = 1 := Subtype.ext h1
    rw [h3]
    exact isUnit_one
  · rw [hD₁, ← mul_assoc, ← Polynomial.C_mul, mul_inv_cancel₀ hμ, Polynomial.C_1, one_mul]

theorem wcpa_dj_lr1k_eb_pd_eg_residue_transfer : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (L : Type u) [Field L] (V : ValuationSubring L) (ι : Ω →+* L), (∀ w : Ω, ι w ∈ V ↔ w ∈ W) → ∀ (s t u : L) (d : Ω) (e : ℕ), 1 ≤ e → d * d = 1 → t ^ e * u = ι d * s → V.valuation (u - 1) < 1 → (∀ P : Polynomial ↥W, (∃ i, IsUnit (P.coeff i)) → V.valuation (Polynomial.eval₂ (ι.comp W.subtype) s P) = 1) → ∀ R : Polynomial ↥W, (∃ i, IsUnit (R.coeff i)) → V.valuation (Polynomial.eval₂ (ι.comp W.subtype) t R) = 1 :=
by
  classical
  intro Ω _ W L _ V ι hι s t u d e he hd hrel hu hs R hR

  let j : ↥W →+* ↥V := RingHom.codRestrict (ι.comp W.subtype) V (fun w => (hι w).2 w.2)
  have hj : ∀ w : ↥W, (j w : L) = ι (w : Ω) := fun w => rfl
  haveI hjloc : IsLocalHom j := by
    refine ⟨fun w hw => ?_⟩
    obtain ⟨y, hy⟩ := isUnit_iff_exists_inv.mp hw
    have hy' : ι (w : Ω) * (y : L) = 1 := by
      have h1 := congrArg Subtype.val hy
      rw [MulMemClass.coe_mul, hj] at h1
      exact h1
    have hw0 : (w : Ω) ≠ 0 := by
      intro h
      rw [h, map_zero, zero_mul] at hy'
      exact zero_ne_one hy'
    have hinv : ((w : Ω))⁻¹ ∈ W := by
      rw [← hι, map_inv₀, inv_eq_of_mul_eq_one_right hy']
      exact y.2
    exact isUnit_iff_exists_inv.mpr ⟨⟨_, hinv⟩, Subtype.ext (mul_inv_cancel₀ hw0)⟩
  let φ : IsLocalRing.ResidueField ↥W →+* IsLocalRing.ResidueField ↥V :=
    IsLocalRing.ResidueField.map j
  have hφ : ∀ w : ↥W, φ (IsLocalRing.residue ↥W w) = IsLocalRing.residue ↥V (j w) := fun w =>
    IsLocalRing.ResidueField.map_residue j w
  have hcomp : (IsLocalRing.residue ↥V).comp j = φ.comp (IsLocalRing.residue ↥W) := by
    ext w
    exact (hφ w).symm
  have hsub : V.subtype.comp j = ι.comp W.subtype := RingHom.ext fun w => rfl

  have r2 : ∀ (x : ↥V) (P : Polynomial ↥W),
      (V.valuation (Polynomial.eval₂ (ι.comp W.subtype) (x : L) P) = 1 ↔
        Polynomial.eval₂ φ (IsLocalRing.residue ↥V x) (P.map (IsLocalRing.residue ↥W)) ≠ 0) := by
    intro x P
    have h1 : ((Polynomial.eval₂ j x P : ↥V) : L) =
        Polynomial.eval₂ (ι.comp W.subtype) (x : L) P := by
      have h := Polynomial.hom_eval₂ P j V.subtype x
      rw [hsub] at h
      exact h
    have h2 : IsLocalRing.residue ↥V (Polynomial.eval₂ j x P) =
        Polynomial.eval₂ φ (IsLocalRing.residue ↥V x) (P.map (IsLocalRing.residue ↥W)) := by
      rw [Polynomial.hom_eval₂, hcomp, Polynomial.eval₂_map]
    rw [← h1, ← ValuationSubring.valuation_eq_one_iff, ← h2,
      IsLocalRing.residue_ne_zero_iff_isUnit]

  have r3 : ∀ (σ τ : IsLocalRing.ResidueField ↥V) (δ : IsLocalRing.ResidueField ↥W),
      σ = φ δ * τ ^ e →
      (∀ P : Polynomial (IsLocalRing.ResidueField ↥W), P ≠ 0 → Polynomial.eval₂ φ σ P ≠ 0) →
      ∀ R : Polynomial (IsLocalRing.ResidueField ↥W), R ≠ 0 → Polynomial.eval₂ φ τ R ≠ 0 := by
    intro σ τ δ hσ hP R hR0 hRτ
    letI : Algebra (IsLocalRing.ResidueField ↥W) (IsLocalRing.ResidueField ↥V) := φ.toAlgebra
    have halg : IsAlgebraic (IsLocalRing.ResidueField ↥W) τ :=
      ⟨R, hR0, by rw [Polynomial.aeval_def]; exact hRτ⟩
    have h2 : IsAlgebraic (IsLocalRing.ResidueField ↥W) σ := by
      rw [hσ]
      exact (isAlgebraic_algebraMap δ).mul (halg.pow e)
    obtain ⟨P, hP0, hPσ⟩ := h2
    rw [Polynomial.aeval_def] at hPσ
    exact hP P hP0 hPσ

  have hd0 : d ≠ 0 := by
    rintro rfl
    rw [zero_mul] at hd
    exact zero_ne_one hd
  have hdinv : d⁻¹ = d := inv_eq_of_mul_eq_one_right hd
  have hdW : d ∈ W := by
    rcases W.mem_or_inv_mem d with h | h
    · exact h
    · rwa [hdinv] at h
  have hιdV : ι d ∈ V := (hι d).2 hdW
  have hιd1 : V.valuation (ι d) = 1 := by
    have hunit : IsUnit (⟨ι d, hιdV⟩ : ↥V) :=
      isUnit_iff_exists_inv.mpr ⟨(⟨ι d, hιdV⟩ : ↥V), Subtype.ext (by
        rw [MulMemClass.coe_mul, OneMemClass.coe_one]
        show ι d * ι d = 1
        rw [← map_mul, hd, map_one])⟩
    exact (V.valuation_eq_one_iff _).mp hunit

  have hvu : V.valuation u = 1 := by
    have h := Valuation.map_one_add_of_lt V.valuation hu
    rwa [show (1 : L) + (u - 1) = u by ring] at h

  have hvs : V.valuation s = 1 := by
    have h := hs Polynomial.X ⟨1, by rw [Polynomial.coeff_X_one]; exact isUnit_one⟩
    rwa [Polynomial.eval₂_X] at h

  have hvt : V.valuation t ^ e = 1 := by
    have h := congrArg V.valuation hrel
    rw [Valuation.map_mul, Valuation.map_mul, Valuation.map_pow, hvu, hιd1, hvs, mul_one,
      mul_one] at h
    exact h
  have htV : t ∈ V := by
    apply (V.valuation_le_one_iff _).mp
    exact (pow_le_one_iff (by omega)).mp hvt.le
  have hsV : s ∈ V := (V.valuation_le_one_iff _).mp hvs.le
  have huV : u ∈ V := (V.valuation_le_one_iff _).mp hvu.le

  let tV : ↥V := ⟨t, htV⟩
  let sV : ↥V := ⟨s, hsV⟩
  let uV : ↥V := ⟨u, huV⟩
  let dW : ↥W := ⟨d, hdW⟩
  let δ : IsLocalRing.ResidueField ↥W := IsLocalRing.residue ↥W dW
  have hrelV : tV ^ e * uV = j dW * sV := by
    apply Subtype.ext
    rw [MulMemClass.coe_mul, MulMemClass.coe_mul, SubmonoidClass.coe_pow]
    exact hrel
  have hu1 : IsLocalRing.residue ↥V uV = 1 := by
    have hm : uV - 1 ∈ IsLocalRing.maximalIdeal ↥V := by
      apply (V.valuation_lt_one_iff _).mpr
      rw [AddSubgroupClass.coe_sub, OneMemClass.coe_one]
      exact hu
    have h := (IsLocalRing.residue_eq_zero_iff _).mpr hm
    rwa [map_sub, map_one, sub_eq_zero] at h
  have hδ : φ δ * φ δ = 1 := by
    have hdd : dW * dW = 1 := Subtype.ext hd
    rw [← map_mul, ← map_mul, hdd, map_one, map_one]
  have hrelR : IsLocalRing.residue ↥V tV ^ e = φ δ * IsLocalRing.residue ↥V sV := by
    have h := congrArg (IsLocalRing.residue ↥V) hrelV
    rw [map_mul, map_mul, map_pow, hu1, mul_one, ← hφ] at h
    exact h
  have hsrel : IsLocalRing.residue ↥V sV = φ δ * IsLocalRing.residue ↥V tV ^ e := by
    linear_combination (-(φ δ)) * hrelR - (IsLocalRing.residue ↥V sV) * hδ

  have hσ : ∀ P : Polynomial (IsLocalRing.ResidueField ↥W), P ≠ 0 →
      Polynomial.eval₂ φ (IsLocalRing.residue ↥V sV) P ≠ 0 := by
    intro P hP0
    obtain ⟨Q, rfl⟩ := Polynomial.map_surjective (IsLocalRing.residue ↥W)
      IsLocalRing.residue_surjective P
    have hQ : ∃ i, IsUnit (Q.coeff i) := by
      by_contra hcon
      push_neg at hcon
      apply hP0
      ext i
      rw [Polynomial.coeff_map, Polynomial.coeff_zero]
      by_contra hne
      exact hcon i ((IsLocalRing.residue_ne_zero_iff_isUnit _).mp hne)
    exact (r2 sV Q).mp (hs Q hQ)

  have hτ := r3 _ _ δ hsrel hσ
  obtain ⟨i, hi⟩ := hR
  apply (r2 tV R).mpr
  apply hτ
  intro h0
  have h := congrArg (fun p => Polynomial.coeff p i) h0
  simp only [Polynomial.coeff_map, Polynomial.coeff_zero] at h
  exact (IsLocalRing.residue_ne_zero_iff_isUnit _).mpr hi h

theorem wcpa_dj_lr1k_eb_pd_eg_coeff_criterion : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (L : Type u) [Field L] (V : ValuationSubring L) (ι : Ω →+* L), (∀ w : Ω, ι w ∈ V ↔ w ∈ W) → ∀ t : L, (∀ R : Polynomial ↥W, (∃ i, IsUnit (R.coeff i)) → V.valuation (Polynomial.eval₂ (ι.comp W.subtype) t R) = 1) → ∀ R : Polynomial Ω, (Polynomial.eval₂ ι t R ∈ V ↔ ∀ j, R.coeff j ∈ W) :=
by
  intro Ω _ W L _ V ι hι t H R
  classical

  have hprim : ∀ D : Polynomial Ω, D ≠ 0 → ∃ (μ : Ω) (D₁ : Polynomial ↥W), μ ≠ 0 ∧
      (∃ i, IsUnit (D₁.coeff i)) ∧ D = Polynomial.C μ * D₁.map W.subtype := by
    intro D hD
    obtain ⟨i₀, hi₀, hmax⟩ := D.support.exists_max_image (fun j => W.valuation (D.coeff j))
      (Polynomial.support_nonempty.mpr hD)
    have hμ : D.coeff i₀ ≠ 0 := Polynomial.mem_support_iff.mp hi₀
    have hmem : ∀ j, (D.coeff i₀)⁻¹ * D.coeff j ∈ W := by
      intro j
      by_cases hj : j ∈ D.support
      · rw [← ValuationSubring.valuation_le_one_iff, Valuation.map_mul, map_inv₀]
        have hv : W.valuation (D.coeff i₀) ≠ 0 := (Valuation.ne_zero_iff _).mpr hμ
        rw [inv_mul_le_iff₀ (zero_lt_iff.mpr hv), mul_one]
        exact hmax j hj
      · rw [Polynomial.notMem_support_iff.mp hj, mul_zero]
        exact W.zero_mem
    obtain ⟨D₁, hD₁⟩ := (Polynomial.mem_lifts _).mp
      ((Polynomial.lifts_iff_coeff_lifts (f := W.subtype)
        (Polynomial.C (D.coeff i₀)⁻¹ * D)).mpr
        (fun n => ⟨⟨_, hmem n⟩, by rw [Polynomial.coeff_C_mul]; rfl⟩))
    refine ⟨D.coeff i₀, D₁, hμ, ⟨i₀, ?_⟩, ?_⟩
    · have h1 : ((D₁.coeff i₀ : W) : Ω) = 1 := by
        have h2 := congrArg (fun p => Polynomial.coeff p i₀) hD₁
        simp only [Polynomial.coeff_map, Polynomial.coeff_C_mul] at h2
        rw [inv_mul_cancel₀ hμ] at h2
        exact h2
      have h3 : D₁.coeff i₀ = 1 := Subtype.ext h1
      rw [h3]
      exact isUnit_one
    · rw [hD₁, ← mul_assoc, ← Polynomial.C_mul, mul_inv_cancel₀ hμ, Polynomial.C_1, one_mul]

  have ht : t ∈ V := by
    have h := H Polynomial.X ⟨1, by rw [Polynomial.coeff_X_one]; exact isUnit_one⟩
    rw [Polynomial.eval₂_X] at h
    rw [← ValuationSubring.valuation_le_one_iff, h]
  constructor
  · intro hmem j
    by_cases hR : R = 0
    · rw [hR, Polynomial.coeff_zero]; exact W.zero_mem
    obtain ⟨μ, D₁, _, ⟨i, hi⟩, hRe⟩ := hprim R hR
    have heval : Polynomial.eval₂ ι t R = ι μ * Polynomial.eval₂ (ι.comp W.subtype) t D₁ := by
      rw [hRe, Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_map]
    have hv1 := H D₁ ⟨i, hi⟩
    have hle : V.valuation (Polynomial.eval₂ ι t R) ≤ 1 :=
      (ValuationSubring.valuation_le_one_iff V _).mpr hmem
    rw [heval, Valuation.map_mul, hv1, mul_one] at hle
    have hμW : μ ∈ W := (hι μ).mp ((ValuationSubring.valuation_le_one_iff V _).mp hle)
    rw [hRe, Polynomial.coeff_C_mul, Polynomial.coeff_map]
    exact W.mul_mem _ _ hμW (D₁.coeff j).2
  · intro hc
    rw [Polynomial.eval₂_eq_sum_range]
    refine sum_mem ?_
    intro i _
    exact V.mul_mem _ _ ((hι _).mpr (hc i)) (pow_mem ht i)

theorem wcpa_dj_lr1k_eb_pd_eta_gauss : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (L : Type u) [Field L] [Algebra (RatFunc Ω) L] [FiniteDimensional (RatFunc Ω) L]
      [Algebra.IsSeparable (RatFunc Ω) L],
    ∀ (m : ℕ) (U : Fin m → ValuationSubring L) (e : Fin m → ℕ) (η u : Fin m → L),
    wcEbMoBD W L m U e η u →
    ∀ a : ↥W, a ≠ 0 → a ∈ IsLocalRing.maximalIdeal ↥W →
