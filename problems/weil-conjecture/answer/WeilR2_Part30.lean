  set δ := MvPolynomial.aeval z S₀ with hδ
  have hδmemA : δ ∈ Set.range φ := ⟨S₀, rfl⟩
  have hδp : ∀ i, δ * p.coeff i ∈ Set.range φ := by
    intro i
    refine ⟨h₀.coeff i, ?_⟩
    rw [← Polynomial.coeff_map, hh₀, Polynomial.coeff_C_mul]

  set P := p.scaleRoots δ with hP
  have hPlift : P ∈ Polynomial.lifts φ := by
    rw [Polynomial.lifts_iff_coeff_lifts]
    intro i
    rw [hP, Polynomial.coeff_scaleRoots]
    rcases lt_trichotomy i p.natDegree with hi | hi | hi
    · obtain ⟨a, ha⟩ := hδp i
      obtain ⟨b, hb⟩ := hδmemA
      obtain ⟨m, hm⟩ : ∃ m, p.natDegree - i = m + 1 := ⟨p.natDegree - i - 1, by omega⟩
      refine ⟨a * b ^ m, ?_⟩
      rw [map_mul, map_pow, ha, hb, hm, pow_succ]; ring
    · refine ⟨1, ?_⟩
      rw [hi, Nat.sub_self, pow_zero, mul_one, map_one, hpmon.coeff_natDegree]
    · refine ⟨0, ?_⟩
