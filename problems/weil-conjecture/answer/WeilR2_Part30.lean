  set c : Fin (Module.finrank K L) → K := fun t => g t / g t₀ with hcdef
  have hcO : ∀ t, c t ∈ O := fun t =>
    (O.valuation_le_one_iff _).mp (by
      rw [hcdef, Valuation.map_div]
