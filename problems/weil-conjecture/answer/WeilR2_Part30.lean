        exact k5 _ ⟨d, hd⟩
      have ha : a ^ n ∈ m := by
        have := M_sub _ _ hw1u c2
        rw [sub_sub_cancel, hMp] at this
        obtain ⟨d, _, hd⟩ := this
        exact k5' _ ⟨d, hd⟩
      have ha' := hprime.mem_of_pow_mem n ha
      have hab' := hprime.mem_of_pow_mem n hab
      refine ⟨ha', ?_⟩
      have := m.sub_mem hab' ha'
      rwa [add_sub_cancel_left] at this

    have kD : ∀ z' : FractionRing R, _root_.IsIntegral R z' → ∀ a b : R,
        ι ℓ * z' = ι a + ι b * u → ∃ a' b' : R, z' = ι a' + ι b' * u := by
      intro z' hz' a b hab
      obtain ⟨p, hpm, hp⟩ := hz'
      have hsc := Polynomial.scaleRoots_eval₂_mul (p := p) ι z' ℓ
      rw [hp, mul_zero, hab, Polynomial.eval₂_eq_sum_range, Polynomial.natDegree_scaleRoots,
        Finset.sum_range_succ] at hsc
      have htop : (p.scaleRoots ℓ).coeff p.natDegree = 1 := by
        rw [Polynomial.coeff_scaleRoots, hpm.coeff_natDegree, Nat.sub_self, pow_zero, mul_one]
      rw [htop, map_one, one_mul] at hsc
      have hMsum : Mp (∑ i ∈ Finset.range p.natDegree,
          ι ((p.scaleRoots ℓ).coeff i) * (ι a + ι b * u) ^ i) := by
        apply Finset.sum_induction _ Mp M_add M_0
        intro i hi
        rw [Finset.mem_range] at hi
        obtain ⟨a1, b1, h1⟩ := S_pow a b i
        have hpow : ℓ ^ (p.natDegree - i) = ℓ ^ (p.natDegree - i - 1) * ℓ := by
          rw [← pow_succ]; congr 1; omega
        have e : ι ((p.scaleRoots ℓ).coeff i) * (ι a + ι b * u) ^ i =
            ι (p.coeff i * ℓ ^ (p.natDegree - i - 1)) * (ι ℓ * (ι a1 + ι b1 * u)) := by
          rw [h1, Polynomial.coeff_scaleRoots, hpow]
          simp only [map_mul]
          ring
        rw [e]; exact M_R _ _ (ℓS a1 b1)
      have hWn : Mp ((ι a + ι b * u) ^ p.natDegree) := by
        have e : (ι a + ι b * u) ^ p.natDegree = -(∑ i ∈ Finset.range p.natDegree,
            ι ((p.scaleRoots ℓ).coeff i) * (ι a + ι b * u) ^ i) := by
          linear_combination hsc
        rw [e]; exact M_neg _ hMsum
      obtain ⟨ha, hb⟩ := kC a b _ hWn
      have hW : Mp (ι a + ι b * u) := by
        obtain ⟨d, hd, hd'⟩ := h2 b hb
        rw [mul_comm, hd']
        exact M_add _ _ (M_ι a ha) (M_ι d hd)
      obtain ⟨e, he, he'⟩ := (hMp _).mp hW
      obtain ⟨b1, b2, hb12⟩ := h6 e he
      refine ⟨b1, b2, hℓu.mul_left_cancel ?_⟩
      rw [hab, he', hb12]

    have kE : ∀ (j : ℕ) (z : FractionRing R), _root_.IsIntegral R z →
        (∃ a b : R, ι ℓ ^ j * z = ι a + ι b * u) → ∃ a b : R, z = ι a + ι b * u := by
      intro j
      induction j with
      | zero =>
        intro z _ h
        simpa using h
      | succ j ih =>
        rintro z hz ⟨a, b, h⟩
        have hz' : _root_.IsIntegral R (ι ℓ * z) := (isIntegral_algebraMap).mul hz
        obtain ⟨a', b', h'⟩ := ih (ι ℓ * z) hz' ⟨a, b, by rw [← h]; ring⟩
        exact kD z hz a' b' h'
    intro z
    rw [mem_integralClosure_iff]
    constructor
    · intro hz
      obtain ⟨⟨a, s⟩, hs⟩ := IsLocalization.surj (nonZeroDivisors R) z
      dsimp only at hs
      obtain ⟨N, r, hN⟩ := h7 s s.2
      apply kE N z hz
      refine ⟨r * a, 0, ?_⟩
      have e : ι ℓ ^ N = ι s * ι r := by rw [← map_pow, hN, map_mul]
      rw [e, map_zero, zero_mul, add_zero, map_mul, ← hs]
      ring
    · rintro ⟨a, b, rfl⟩
      have hu : _root_.IsIntegral R u := by
        refine ⟨Polynomial.X ^ 2 - Polynomial.X + Polynomial.C c, by monicity!, ?_⟩
        simp only [Polynomial.eval₂_add, Polynomial.eval₂_sub, Polynomial.eval₂_pow,
          Polynomial.eval₂_X, Polynomial.eval₂_C]
        linear_combination (-1 : FractionRing R) * h3
      exact isIntegral_algebraMap.add (isIntegral_algebraMap.mul hu)



  have unit_of : ∀ a : R, a ∉ m → ∃ s, a * s = 1 := by
    intro a ha
    have hu : IsUnit a := by
      by_contra h
      exact ha (by rw [hm, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]; exact h)
    exact hu.exists_right_inv
  set Rb := integralClosure R (FractionRing R) with hRb
  have humem : u ∈ Rb := (hD u).mpr ⟨0, 1, by simp⟩
  set u' : Rb := ⟨u, humem⟩ with hu'
  have coe_alg : ∀ a : R, ((algebraMap R Rb a : Rb) : FractionRing R) = ι a := fun a => rfl
  constructor
  ·
    let f : R →ₗ[R] (Rb ⧸ LinearMap.range (Algebra.linearMap R Rb)) :=
      (LinearMap.range (Algebra.linearMap R Rb)).mkQ ∘ₗ LinearMap.toSpanSingleton R Rb u'
    have hf : ∀ r, f r = Submodule.Quotient.mk (r • u') := fun r => rfl
    have hfs : Function.Surjective f := by
      intro q
      obtain ⟨⟨z, hz⟩, rfl⟩ := Submodule.mkQ_surjective _ q
      obtain ⟨a, b, hab⟩ := (hD z).mp hz
      refine ⟨b, ?_⟩
      rw [hf]
      show Submodule.Quotient.mk (b • u') = Submodule.Quotient.mk _
      rw [Submodule.Quotient.eq]
      refine ⟨-a, ?_⟩
      apply Subtype.ext
      simp only [Algebra.linearMap_apply, map_neg]
      show -(ι a) = (b • u - z)
      rw [hab, Algebra.smul_def]; ring
    have hker : LinearMap.ker f = m := by
      ext r
      rw [LinearMap.mem_ker, hf, Submodule.Quotient.mk_eq_zero]
      constructor
      · rintro ⟨t, ht⟩
        apply k5 r ⟨t, ?_⟩
        have := congrArg Subtype.val ht
        simp only [Algebra.linearMap_apply] at this
        rw [coe_alg] at this
        rw [this, SetLike.val_smul, Algebra.smul_def]
      · intro hr
        obtain ⟨b, _, hb⟩ := h2 r hr
        refine ⟨b, ?_⟩
        apply Subtype.ext
        simp only [Algebra.linearMap_apply]
        rw [coe_alg]
        show ι b = r • u
        rw [Algebra.smul_def, ← hb, mul_comm]
    have e := LinearMap.quotKerEquivOfSurjective f hfs
    unfold wcpaDjLkDelta
    rw [← e.length_eq, Module.length_eq_one_iff, hker, isSimpleModule_iff_isCoatom]
    exact Ideal.isMaximal_def.mp (IsLocalRing.maximalIdeal.isMaximal R)
  ·
    have Mclosed : ∀ r : Rb, ∀ b ∈ m, ∃ d ∈ m, (r : FractionRing R) * ι b = ι d := by
      intro r b hb
      obtain ⟨a', b', h⟩ := (hD r).mp r.2
      obtain ⟨d, hd, hd'⟩ := h2 b hb
      refine ⟨a' * b + b' * d, m.add_mem (m.mul_mem_left _ hb) (m.mul_mem_left _ hd), ?_⟩
      rw [h, map_add, map_mul, map_mul, ← hd']; ring
    let M1 : Ideal Rb :=
      { carrier := {z | ∃ b ∈ m, (z : FractionRing R) * (1 - u) = ι b}
        add_mem' := by
          rintro z w ⟨b, hb, hz⟩ ⟨b', hb', hw⟩
          refine ⟨b + b', m.add_mem hb hb', ?_⟩
          show ((z : FractionRing R) + w) * (1 - u) = _
          rw [add_mul, hz, hw, map_add]
        zero_mem' := ⟨0, m.zero_mem, by simp⟩
        smul_mem' := by
          rintro r z ⟨b, hb, hz⟩
          obtain ⟨d, hd, hd'⟩ := Mclosed r b hb
          refine ⟨d, hd, ?_⟩
          show ((r : FractionRing R) * z) * (1 - u) = _
          rw [mul_assoc, hz, hd'] }
    let M2 : Ideal Rb :=
      { carrier := {z | ∃ b ∈ m, (z : FractionRing R) * u = ι b}
        add_mem' := by
          rintro z w ⟨b, hb, hz⟩ ⟨b', hb', hw⟩
          refine ⟨b + b', m.add_mem hb hb', ?_⟩
          show ((z : FractionRing R) + w) * u = _
          rw [add_mul, hz, hw, map_add]
        zero_mem' := ⟨0, m.zero_mem, by simp⟩
        smul_mem' := by
          rintro r z ⟨b, hb, hz⟩
          obtain ⟨d, hd, hd'⟩ := Mclosed r b hb
          refine ⟨d, hd, ?_⟩
          show ((r : FractionRing R) * z) * u = _
          rw [mul_assoc, hz, hd'] }
    have memM1 : ∀ (z : Rb) (a b : R), (z : FractionRing R) = ι a + ι b * u →
        (z ∈ M1 ↔ a ∈ m) := by
      intro z a b hz
      show (∃ d ∈ m, (z : FractionRing R) * (1 - u) = ι d) ↔ a ∈ m
      constructor
      · rintro ⟨d, _, hd⟩
        apply k5' a ⟨d - b * c, ?_⟩
        rw [hz] at hd
        simp only [map_sub, map_mul]
        linear_combination hd - ι b * h3
      · intro ha
        obtain ⟨d', hd', hd''⟩ := h2 a ha
        refine ⟨a - d' + b * c, m.add_mem (m.sub_mem ha hd') (m.mul_mem_left _ hcm), ?_⟩
        rw [hz]
        simp only [map_add, map_sub, map_mul]
        linear_combination -hd'' + ι b * h3
    have memM2 : ∀ (z : Rb) (a b : R), (z : FractionRing R) = ι a + ι b * u →
        (z ∈ M2 ↔ a + b ∈ m) := by
      intro z a b hz
      show (∃ d ∈ m, (z : FractionRing R) * u = ι d) ↔ a + b ∈ m
      constructor
      · rintro ⟨d, _, hd⟩
        apply k5 (a + b) ⟨d + b * c, ?_⟩
        rw [hz] at hd
        simp only [map_add, map_mul]
        linear_combination hd + ι b * h3
      · intro ha
        obtain ⟨d', hd', hd''⟩ := h2 (a + b) ha
        refine ⟨d' - b * c, m.sub_mem hd' (m.mul_mem_left _ hcm), ?_⟩
        rw [hz]
        simp only [map_add, map_sub, map_mul] at hd'' ⊢
        linear_combination hd'' - ι b * h3
    have maxl : ∀ (I : Ideal Rb), (∀ a : R, algebraMap R Rb a ∈ I ↔ a ∈ m) →
        (∀ z : Rb, ∃ a : R, z - algebraMap R Rb a ∈ I) → I.IsMaximal := by
      intro I hI hrep
      rw [Ideal.isMaximal_iff]
      constructor
      · intro h1
        have : algebraMap R Rb 1 ∈ I := by rw [map_one]; exact h1
        exact (IsLocalRing.maximalIdeal.isMaximal R).ne_top
          ((Ideal.eq_top_iff_one _).mpr ((hI 1).mp this))
      · intro J x hIJ hx hxJ
        obtain ⟨a, ha⟩ := hrep x
        have ha' : a ∉ m := by
          intro h
          apply hx
          have := I.add_mem ha ((hI a).mpr h)
          rwa [sub_add_cancel] at this
        obtain ⟨s, hs⟩ := unit_of a ha'
        have e : (1 : Rb) = algebraMap R Rb s * (x - (x - algebraMap R Rb a)) := by
          rw [sub_sub_cancel, ← map_mul, mul_comm, hs, map_one]
        rw [e]
        exact J.mul_mem_left _ (J.sub_mem hxJ (hIJ ha))
    have hM1max : M1.IsMaximal := by
      apply maxl
      · intro a; exact memM1 _ a 0 (by rw [coe_alg]; simp)
      · intro z
        obtain ⟨a, b, h⟩ := (hD z).mp z.2
        refine ⟨a, (memM1 _ 0 b ?_).mpr m.zero_mem⟩
        show (z : FractionRing R) - ι a = _
        rw [h, map_zero]; ring
    have hM2max : M2.IsMaximal := by
      apply maxl
      · intro a; rw [memM2 _ a 0 (by rw [coe_alg]; simp), add_zero]
      · intro z
        obtain ⟨a, b, h⟩ := (hD z).mp z.2
        refine ⟨a + b, (memM2 _ (-b) b ?_).mpr (by rw [neg_add_cancel]; exact m.zero_mem)⟩
        show (z : FractionRing R) - ι (a + b) = _
        rw [h, map_add, map_neg]; ring
    have hu1 : u' ∈ M1 := (memM1 u' 0 1 (by show u = _; simp)).mpr m.zero_mem
    have hu2 : u' ∉ M2 := by
      rw [memM2 u' 0 1 (by show u = _; simp), zero_add]
      exact (IsLocalRing.maximalIdeal.isMaximal R).ne_top ∘ (Ideal.eq_top_iff_one _).mpr
    have hne : M1 ≠ M2 := fun h => hu2 (h ▸ hu1)
    have hall : ∀ P : Ideal Rb, P.IsMaximal → P = M1 ∨ P = M2 := by
      intro P hP
      have hcomap := Ideal.isMaximal_comap_of_isIntegral_of_isMaximal (algebraMap R Rb)
        (fun x => integralClosure.isIntegral x) P
      have hceq := IsLocalRing.eq_maximalIdeal hcomap
      have hmP : ∀ a ∈ m, algebraMap R Rb a ∈ P := by
        intro a ha
        rw [← Ideal.mem_comap, hceq]; exact ha
      have hcP : u' * (1 - u') ∈ P := by
        have : u' * (1 - u') = algebraMap R Rb c := Subtype.ext (by
          show u * (1 - u) = ι c
          exact h3)
        rw [this]; exact hmP c hcm
      rcases hP.isPrime.mem_or_mem hcP with h | h
      · left
        symm
        apply hM1max.eq_of_le hP.ne_top
        intro z hz
        obtain ⟨a, b, hab⟩ := (hD z).mp z.2
        have ha := (memM1 z a b hab).mp hz
        have e : z = algebraMap R Rb a + algebraMap R Rb b * u' := Subtype.ext (by
          rw [hab]; rfl)
        rw [e]
        exact P.add_mem (hmP a ha) (P.mul_mem_left _ h)
      · right
        symm
        apply hM2max.eq_of_le hP.ne_top
        intro z hz
        obtain ⟨a, b, hab⟩ := (hD z).mp z.2
        have ha := (memM2 z a b hab).mp hz
        have e : z = algebraMap R Rb (a + b) - algebraMap R Rb b * (1 - u') := Subtype.ext (by
          rw [hab]
          show ι a + ι b * u = ι (a + b) - ι b * (1 - u)
          rw [map_add]; ring)
        rw [e]
        exact P.sub_mem (hmP _ ha) (P.mul_mem_left _ h)
    unfold wcpaDjLkBranches
    have huniv : (Set.univ : Set (MaximalSpectrum Rb)) =
        {⟨M1, hM1max⟩, ⟨M2, hM2max⟩} := by
      ext P
      simp only [Set.mem_univ, Set.mem_insert_iff, Set.mem_singleton_iff, true_iff]
      rcases hall P.asIdeal P.isMaximal with h | h
      · left; exact MaximalSpectrum.ext h
      · right; exact MaximalSpectrum.ext h
    rw [← Set.encard_univ, huniv, Set.encard_pair]
    intro h
    exact hne (congrArg MaximalSpectrum.asIdeal h)

theorem wcpa_dj_lr1k_gn_fibre_dim_le : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ → ∀ (Ct : Scheme.{u}) (φ : Ct ⟶ wcProjK Ω 1), wcpaDjLkCov Ω φ → ∀ (X : Scheme.{u}) (uX : X ⟶ Spec (.of ↥W)) (ι : wcProjK Ω 1 ⟶ X) [QuasiCompact (φ ≫ ι)] [QuasiSeparated (φ ≫ ι)], wcpaDjLkModel W uX ι → ∀ w : ↥(wcpaDjLkFib W (φ ≫ ι) uX), ringKrullDim ((wcpaDjLkFib W (φ ≫ ι) uX).presheaf.stalk w) ≤ ((1 : ℕ) : WithBot ℕ∞) :=
by
  intro Ω _ _ W hW hWt Ct φ hcov X uX ι _ _ hM w
  have hκ : IsAlgClosed (IsLocalRing.ResidueField ↥W) := wcpa_dj_nc_residue_algclosed Ω W
  have hdim := (wcpa_dj_lus_cvs_ct_closed_fibre_dim Ω W hκ X uX hM.1).2
  have s1 : ∀ (A B : Type u) [CommRing A] [CommRing B] [Algebra A B] [Algebra.IsIntegral A B],
      ringKrullDim B ≤ ringKrullDim A := by
    intro A B _ _ _ _
    unfold ringKrullDim
    apply Order.krullDim_le_of_strictMono (PrimeSpectrum.comap (algebraMap A B))
    intro p q hpq
    exact Ideal.IsIntegral.under_lt_under hpq
  have s3 : ∀ {A B : Scheme.{u}} (h : A ⟶ B) [IsIntegralHom h] (a : A),
      ringKrullDim (A.presheaf.stalk a) ≤ topologicalKrullDim B := by
    intro A B h _ a
    obtain ⟨V, hV, haV, -⟩ := exists_isAffineOpen_mem_and_subset (x := h a) (U := ⊤) trivial
    have hU : IsAffineOpen (h ⁻¹ᵁ V) := hV.preimage h
    suffices H : ∀ a' : (h ⁻¹ᵁ V), ringKrullDim (A.presheaf.stalk (a' : A)) ≤
        topologicalKrullDim B from H ⟨a, haV⟩
    intro a'
    haveI := hU.isLocalization_stalk a'
    have e1 : ringKrullDim (A.presheaf.stalk (a' : A)) =
        ((hU.primeIdealOf a').asIdeal.height : WithBot ℕ∞) :=
      IsLocalization.AtPrime.ringKrullDim_eq_height (hU.primeIdealOf a').asIdeal
        (A.presheaf.stalk (a' : A))
    have e2 : ((hU.primeIdealOf a').asIdeal.height : WithBot ℕ∞) ≤
        ringKrullDim Γ(A, h ⁻¹ᵁ V) :=
      Ideal.height_le_ringKrullDim_of_ne_top (hU.primeIdealOf a').2.ne_top
    letI : Algebra Γ(B, V) Γ(A, h ⁻¹ᵁ V) := (h.app V).hom.toAlgebra
    haveI : Algebra.IsIntegral Γ(B, V) Γ(A, h ⁻¹ᵁ V) := ⟨IsIntegralHom.isIntegral_app h V hV⟩
    have e3 : ringKrullDim Γ(A, h ⁻¹ᵁ V) ≤ ringKrullDim Γ(B, V) := s1 _ _
    have e4 : ringKrullDim Γ(B, V) ≤ topologicalKrullDim B :=
      (PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim Γ(B, V)).symm.le.trans
        ((hV.fromSpec.isOpenEmbedding).isInducing.topologicalKrullDim_le)
    rw [e1]
    exact e2.trans (e3.trans e4)
  haveI : IsIntegralHom (Limits.pullback.snd (φ ≫ ι).fromNormalization (Limits.pullback.fst uX
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))))) :=
    MorphismProperty.of_isPullback (IsPullback.of_hasPullback _ _) inferInstance
  haveI hint : IsIntegralHom ((Limits.pullbackRightPullbackFstIso uX
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))
      (φ ≫ ι).fromNormalization).inv ≫
      Limits.pullback.snd (φ ≫ ι).fromNormalization (Limits.pullback.fst uX
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))))) :=
    inferInstance
  exact (s3 ((Limits.pullbackRightPullbackFstIso uX
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))
      (φ ≫ ι).fromNormalization).inv ≫
      Limits.pullback.snd (φ ≫ ι).fromNormalization (Limits.pullback.fst uX
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))))) w).trans hdim

theorem wcpa_dj_lr1k_gn_fibre_reduced : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ → ∀ (Ct : Scheme.{u}) (φ : Ct ⟶ wcProjK Ω 1), wcpaDjLkCov Ω φ → ∀ (X : Scheme.{u}) (uX : X ⟶ Spec (.of ↥W)) (ι : wcProjK Ω 1 ⟶ X) [QuasiCompact (φ ≫ ι)] [QuasiSeparated (φ ≫ ι)], wcpaDjLkModel W uX ι → ∀ w : ↥(wcpaDjLkFib W (φ ≫ ι) uX), _root_.IsReduced ((wcpaDjLkFib W (φ ≫ ι) uX).presheaf.stalk w) :=
by
  intro Ω _ _ W hW hWt Ct φ hcov X uX ι _ _ hM w
  obtain ⟨-, -, hpb⟩ := hM
  have hc : (φ ≫ ι) ≫ uX =
      (φ ≫ wcProjKStr Ω 1) ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω)) := by
    rw [Category.assoc, hpb.w]
    exact (Category.assoc _ _ _).symm
  haveI : AlgebraicGeometry.IsReduced (wcpaDjLkFib W (φ ≫ ι) uX) :=
    wcpa_dj_lr1k_imf_fib_reduced Ω W hWt Ct X (φ ≫ ι) uX (φ ≫ wcProjKStr Ω 1) hc
  exact AlgebraicGeometry.isReduced_stalk_of_isReduced _ w

theorem wcpa_dj_lr1k_nd_model_fibres : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (Ct : Scheme.{u}) (φ : Ct ⟶ wcProjK Ω 1), wcpaDjLkCov Ω φ →
    ∀ (X : Scheme.{u}) (uX : X ⟶ Spec (.of ↥W)) (ι : wcProjK Ω 1 ⟶ X)
      [QuasiCompact (φ ≫ ι)] [QuasiSeparated (φ ≫ ι)],
    wcpaDjLkModel W uX ι → ∀ w : ↥(wcpaDjLkFib W (φ ≫ ι) uX),
    IsClosed ({w} : Set ↥(wcpaDjLkFib W (φ ≫ ι) uX)) →
    ∀ (P : Type u) [CommRing P]
      (e : ↥((φ ≫ ι).normalization.presheaf.stalk (wcNdPt W (φ ≫ ι) uX w)) →+* P),
      wcNdIsHens (IsLocalRing.maximalIdeal
        ↥((φ ≫ ι).normalization.presheaf.stalk (wcNdPt W (φ ≫ ι) uX w))) P e →
      (wcNdModelA W P (e.comp (wcNdSig ((φ ≫ ι).fromNormalization ≫ uX)
          (wcNdPt W (φ ≫ ι) uX w))) ∨
        wcNdModelB W P (e.comp (wcNdSig ((φ ≫ ι).fromNormalization ≫ uX)
          (wcNdPt W (φ ≫ ι) uX w)))) →
      ¬ wcpaDjLkBad ((wcpaDjLkFib W (φ ≫ ι) uX).presheaf.stalk w) :=
by
  intro Ω _ _ W hW hWt Ct φ hcov X uX ι _ _ hM w _hw P _ e he hP

  obtain ⟨hnoeth, hfinimp⟩ :=
    wcpa_dj_lr1k_ndmf_stalk_finiteness Ω W hW hWt Ct φ hcov X uX ι hM w
  have hred := wcpa_dj_lr1k_gn_fibre_reduced Ω W hW hWt Ct φ hcov X uX ι hM w
  have hdim := wcpa_dj_lr1k_gn_fibre_dim_le Ω W hW hWt Ct φ hcov X uX ι hM w
  haveI := hnoeth

  obtain ⟨ρ, hρ⟩ := wcpa_dj_lr1k_ndmf_fibre_stalk_levels Ω W X Ct (φ ≫ ι) uX w

  have key : ∀ {A T : Type u} [CommRing A] [IsLocalRing A] [CommRing T] (sig : ↥W →+* A)
      (eA : A →+* P) (c : ↥W →+* T) (𝔫 : Ideal T) (f : T →+* P),
      wcNdIsHens (IsLocalRing.maximalIdeal A) P eA → 𝔫.IsMaximal →
      Ideal.map c (IsLocalRing.maximalIdeal ↥W) ≤ 𝔫 → wcNdIsHens 𝔫 P f →
      f.comp c = eA.comp sig →
      ∃ θ : ∀ n : ℕ, (A ⧸ (Ideal.map sig (IsLocalRing.maximalIdeal ↥W) ⊔
          IsLocalRing.maximalIdeal A ^ n)) ≃+*
        (T ⧸ (Ideal.map c (IsLocalRing.maximalIdeal ↥W) ⊔ 𝔫 ^ n)),
        ∀ (n : ℕ) (x : A) (y : T), θ (n + 1) (Ideal.Quotient.mk _ x) = Ideal.Quotient.mk _ y →
          θ n (Ideal.Quotient.mk _ x) = Ideal.Quotient.mk _ y := by
    intro A T _ _ _ sig eA c 𝔫 f heA h𝔫 hc hf hfc
    have hI : Ideal.map sig (IsLocalRing.maximalIdeal ↥W) ≤ IsLocalRing.maximalIdeal A := by
      rw [Ideal.map_le_iff_le_comap]
      intro a ha
      rw [Ideal.mem_comap]
      by_contra hna
      have h1 : IsUnit (eA (sig a)) := (heA.2.1 _).mpr hna
      have h2 : IsUnit (f (c a)) := by
        rw [← RingHom.comp_apply, hfc, RingHom.comp_apply]; exact h1
      exact ((hf.2.1 _).mp h2) (hc (Ideal.mem_map_of_mem c ha))
    have hmap : Ideal.map eA (Ideal.map sig (IsLocalRing.maximalIdeal ↥W)) =
        Ideal.map f (Ideal.map c (IsLocalRing.maximalIdeal ↥W)) := by
      rw [Ideal.map_map, Ideal.map_map, hfc]
    exact wcpa_dj_lr1k_ndmf_hens_levels A T P (IsLocalRing.maximalIdeal A) 𝔫 eA f
      inferInstance h𝔫 heA hf _ _ hI hc hmap
  rcases hP with ⟨f, hfc, hf⟩ | ⟨g, hg, _hg0, f, hfc, hf⟩
  ·
    obtain ⟨h𝔫, ψ, -⟩ := wcpa_dj_lr1k_ndmf_modelA_levels Ω W
    obtain ⟨θ, -⟩ := key _ e Polynomial.C _ f he h𝔫 le_sup_right hf hfc
    have hδ := wcpa_dj_lr1k_ndmf_smooth_levels_delta
      ↥((wcpaDjLkFib W (φ ≫ ι) uX).presheaf.stalk w) (IsLocalRing.ResidueField ↥W)
      (fun n => ⟨(ρ n).trans ((θ n).trans (ψ n))⟩)
    intro hbad
    exact hbad (Or.inl hδ)
  ·
    have hker : RingHom.ker (Ideal.Quotient.mk (Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 -
          MvPolynomial.C g : MvPolynomial (Fin 2) ↥W)})) = Ideal.span {(MvPolynomial.X 0 *
          MvPolynomial.X 1 - MvPolynomial.C g : MvPolynomial (Fin 2) ↥W)} := Ideal.mk_ker
    obtain ⟨h𝔫, ψ, hψ⟩ := wcpa_dj_lr1k_ndmf_modelB_levels Ω W g hg
      (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 -
          MvPolynomial.C g : MvPolynomial (Fin 2) ↥W)})
      (Ideal.Quotient.mk (Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 -
          MvPolynomial.C g : MvPolynomial (Fin 2) ↥W)}))
      Ideal.Quotient.mk_surjective hker
    have hc : Ideal.map ((Ideal.Quotient.mk (Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 -
          MvPolynomial.C g : MvPolynomial (Fin 2) ↥W)})).comp MvPolynomial.C)
          (IsLocalRing.maximalIdeal ↥W) ≤
        Ideal.map (Ideal.Quotient.mk (Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 -
            MvPolynomial.C g : MvPolynomial (Fin 2) ↥W)}))
          (Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 2) ↥W), MvPolynomial.X 1} ⊔
            Ideal.map MvPolynomial.C (IsLocalRing.maximalIdeal ↥W)) := by
      rw [← Ideal.map_map]
      exact Ideal.map_mono le_sup_right
    obtain ⟨θ, hθ⟩ := key _ e _ _ f he h𝔫 hc hf hfc
    have hΘ : ∀ (n : ℕ) (x : ↥((wcpaDjLkFib W (φ ≫ ι) uX).presheaf.stalk w))
        (y : MvPolynomial (Fin 2) (IsLocalRing.ResidueField ↥W)),
        ((ρ (n + 1)).trans ((θ (n + 1)).trans (ψ (n + 1)))) (Ideal.Quotient.mk _ x) =
          Ideal.Quotient.mk _ y →
        ((ρ n).trans ((θ n).trans (ψ n))) (Ideal.Quotient.mk _ x) = Ideal.Quotient.mk _ y := by
      intro n x y hxy
      obtain ⟨a, ha⟩ := Ideal.Quotient.mk_surjective (ρ (n + 1) (Ideal.Quotient.mk _ x))
      obtain ⟨t, ht⟩ := Ideal.Quotient.mk_surjective (θ (n + 1) (Ideal.Quotient.mk _ a))
      have ha' := hρ n x a ha.symm
      have ht' := hθ n a t ht.symm
      simp only [RingEquiv.trans_apply] at hxy ⊢
      rw [← ha, ← ht] at hxy
      rw [ha', ht']
      exact hψ n t y hxy
    have hδ := wcpa_dj_lr1k_ndmf_node_levels_delta
      ↥((wcpaDjLkFib W (φ ≫ ι) uX).presheaf.stalk w) (IsLocalRing.ResidueField ↥W)
      (fun n => (ρ n).trans ((θ n).trans (ψ n))) hΘ hred hdim (hfinimp hred)
    intro hbad
    exact hbad (Or.inr hδ)

theorem wcNd_hens_exists : ∀ (A : Type u) [CommRing A] (p : Ideal A), p.IsPrime →
    ∃ (Q : Type u) (_ : CommRing Q) (q : A →+* Q), wcNdIsHens p Q q :=
by
  classical

  have noeth : ∀ (R : Type u) [CommRing R] [IsNoetherianRing R] (p : Ideal R), p.IsPrime →
      ∃ (Q : Type u) (_ : CommRing Q) (q : R →+* Q), wcNdIsHens p Q q := by
    intro R _ _ p hp
    haveI := hp
    haveI : IsNoetherianRing (Localization.AtPrime p) :=
      IsLocalization.isNoetherianRing p.primeCompl (Localization.AtPrime p) inferInstance
    obtain ⟨H, iH, hH, -, ι, hι, -, -, huniv, -⟩ :=
      wc_hnas_henselization_exists (Localization.AtPrime p)
    haveI := hι
    refine ⟨H, iH, ι.comp (algebraMap R (Localization.AtPrime p)), hH, ?_, ?_⟩
    · intro a
      rw [RingHom.comp_apply, isUnit_map_iff ι,
        IsLocalization.AtPrime.isUnit_to_map_iff (Localization.AtPrime p) p a,
        Ideal.mem_primeCompl_iff]
    · intro B _ hB g hg
      have hg' : ∀ y : p.primeCompl, IsUnit (g y) := fun y => (hg y).mpr y.2
      have hg's : ∀ x : R, IsLocalization.lift (S := Localization.AtPrime p) hg'
          (algebraMap R (Localization.AtPrime p) x) = g x := fun x => IsLocalization.lift_eq hg' x
      have hg'e : (IsLocalization.lift (S := Localization.AtPrime p) hg').comp
          (algebraMap R (Localization.AtPrime p)) = g := RingHom.ext hg's
      haveI hloc : IsLocalHom (IsLocalization.lift (S := Localization.AtPrime p) hg') := by
        refine IsLocalHom.mk fun r hr => ?_
        obtain ⟨⟨a, s⟩, hr'⟩ := IsLocalization.mk'_surjective p.primeCompl r
        have hr'' : IsLocalization.mk' (Localization.AtPrime p) a s = r := hr'
        subst hr''
        have hspec := IsLocalization.mk'_spec (Localization.AtPrime p) a s
        have h1 : IsUnit (g a) := by
          rw [← hg's, ← hspec, map_mul]
          exact hr.mul (by rw [hg's]; exact hg' s)
        have h2 : IsUnit (algebraMap R (Localization.AtPrime p) a) :=
          (IsLocalization.AtPrime.isUnit_to_map_iff (Localization.AtPrime p) p a).mpr
            ((Ideal.mem_primeCompl_iff).mpr ((hg a).mp h1))
        rw [← hspec] at h2
        exact isUnit_of_mul_isUnit_left h2
      haveI := hB
      obtain ⟨h, ⟨hl, hh⟩, hu⟩ := huniv B (IsLocalization.lift (S := Localization.AtPrime p) hg') hloc
      refine ⟨h, ⟨?_, hl⟩, ?_⟩
      · rw [← RingHom.comp_assoc, hh, hg'e]
      · rintro h' ⟨hh', hl'⟩
        apply hu h'
        refine ⟨hl', ?_⟩
        apply IsLocalization.ringHom_ext p.primeCompl
        rw [RingHom.comp_assoc, hh', hg'e]

  have dlim_local : ∀ {ι : Type u} [Preorder ι] [IsDirectedOrder ι] [Nonempty ι] (G : ι → Type u)
      [∀ i, CommRing (G i)] [∀ i, IsLocalRing (G i)] (f : ∀ i j, i ≤ j → G i →+* G j)
      [DirectedSystem G (fun i j h => ⇑(f i j h))], (∀ i j (h : i ≤ j), IsLocalHom (f i j h)) →
      IsLocalRing (Ring.DirectLimit G (fun i j h => ⇑(f i j h))) ∧
      (∀ i (x : G i), IsUnit (Ring.DirectLimit.of G (fun i j h => ⇑(f i j h)) i x) ↔ IsUnit x) := by
    intro ι _ _ _ G _ _ f _ hf
    have hof : ∀ i j (h : i ≤ j) (x : G i),
        Ring.DirectLimit.of G (fun i j h => ⇑(f i j h)) j (f i j h x) =
          Ring.DirectLimit.of G (fun i j h => ⇑(f i j h)) i x :=
      fun i j h x => Ring.DirectLimit.of_f h x
    have refl : ∀ i (x : G i), IsUnit (Ring.DirectLimit.of G (fun i j h => ⇑(f i j h)) i x) →
        IsUnit x := by
      rintro i x ⟨u, hu⟩
      obtain ⟨j, y, hy⟩ := Ring.DirectLimit.exists_of (G := G) (f := fun i j h => ⇑(f i j h))
        (↑u⁻¹ : Ring.DirectLimit G (fun i j h => ⇑(f i j h)))
      obtain ⟨k, hik, hjk⟩ := directed_of (· ≤ ·) i j
      have h1 : Ring.DirectLimit.of G (fun i j h => ⇑(f i j h)) k
          (f i k hik x * f j k hjk y - 1) = 0 := by
        rw [map_sub, map_mul, map_one, hof, hof, hy, ← hu, Units.mul_inv, sub_self]
      obtain ⟨l, hkl, h2⟩ := Ring.DirectLimit.of.zero_exact (f' := f) h1
      rw [map_sub, map_mul, map_one, sub_eq_zero] at h2
      have h3 : IsUnit (f k l hkl (f i k hik x)) := isUnit_iff_exists_inv.mpr ⟨_, h2⟩
      exact (hf i k hik).map_nonunit x ((hf k l hkl).map_nonunit _ h3)
    have nt : Nontrivial (Ring.DirectLimit G (fun i j h => ⇑(f i j h))) := by
      refine ⟨⟨0, 1, fun h => ?_⟩⟩
      obtain ⟨i⟩ := ‹Nonempty ι›
      have : IsUnit (Ring.DirectLimit.of G (fun i j h => ⇑(f i j h)) i 0) := by
        rw [map_zero, h]; exact isUnit_one
      exact not_isUnit_zero (refl i 0 this)
    haveI := nt
    have loc : IsLocalRing (Ring.DirectLimit G (fun i j h => ⇑(f i j h))) := by
      refine IsLocalRing.of_isUnit_or_isUnit_one_sub_self fun z => ?_
      obtain ⟨i, x, rfl⟩ := Ring.DirectLimit.exists_of (G := G) (f := fun i j h => ⇑(f i j h)) z
      rcases IsLocalRing.isUnit_or_isUnit_one_sub_self x with h | h
      · exact Or.inl (h.map _)
      · right
        have := h.map (Ring.DirectLimit.of G (fun i j h => ⇑(f i j h)) i)
        rwa [map_sub, map_one] at this
    exact ⟨loc, fun i x => ⟨refl i x, fun h => h.map _⟩⟩

  have dlim_hens : ∀ {ι : Type u} [Preorder ι] [IsDirectedOrder ι] [Nonempty ι] (G : ι → Type u)
      [∀ i, CommRing (G i)] [∀ i, HenselianLocalRing (G i)] (f : ∀ i j, i ≤ j → G i →+* G j)
      [IsLocalRing (Ring.DirectLimit G (fun i j h => ⇑(f i j h)))],
      (∀ i (x : G i), IsUnit (Ring.DirectLimit.of G (fun i j h => ⇑(f i j h)) i x) ↔ IsUnit x) →
      HenselianLocalRing (Ring.DirectLimit G (fun i j h => ⇑(f i j h))) := by
    intro ι _ _ _ G _ _ f _ hrefl
    have hof : ∀ i j (h : i ≤ j) (x : G i),
        Ring.DirectLimit.of G (fun i j h => ⇑(f i j h)) j (f i j h x) =
          Ring.DirectLimit.of G (fun i j h => ⇑(f i j h)) i x :=
      fun i j h x => Ring.DirectLimit.of_f h x
    refine HenselianLocalRing.mk fun F hF a₀ ha₀ hda₀ => ?_
    obtain ⟨i, P, hP⟩ := Ring.DirectLimit.Polynomial.exists_of (f' := f) F
    obtain ⟨j, b₀, hb₀⟩ := Ring.DirectLimit.exists_of (G := G) (f := fun i j h => ⇑(f i j h)) a₀
    obtain ⟨k, hik, hjk⟩ := directed_of (· ≤ ·) i j
    obtain ⟨φ, hφ⟩ : ∃ φ : G k →+* Ring.DirectLimit G (fun i j h => ⇑(f i j h)),
        φ = Ring.DirectLimit.of G (fun i j h => ⇑(f i j h)) k := ⟨_, rfl⟩
    have hφr : ∀ x, IsUnit (φ x) ↔ IsUnit x := fun x => by rw [hφ]; exact hrefl k x
    obtain ⟨Pk, hPk⟩ : ∃ Pk : Polynomial (G k), Pk.map φ = F := by
      refine ⟨P.map (f i k hik), ?_⟩
      rw [Polynomial.map_map, ← hP]
      congr 1
      ext x
      rw [hφ, RingHom.comp_apply, hof]
    obtain ⟨bk, hbk⟩ : ∃ bk : G k, φ bk = a₀ := ⟨f j k hjk b₀, by rw [hφ, hof, hb₀]⟩
    have hev : ∀ (Fp : Polynomial (G k)) (x : G k), (Fp.map φ).eval (φ x) = φ (Fp.eval x) := by
      intro Fp x
      rw [Polynomial.eval_map, Polynomial.eval₂_at_apply]
    obtain ⟨Fk, hFk_def⟩ : ∃ Fk : Polynomial (G k), Fk = Polynomial.X ^ F.natDegree +
        ∑ m ∈ Finset.range F.natDegree, Polynomial.C (Pk.coeff m) * Polynomial.X ^ m := ⟨_, rfl⟩
    have hdeg : (∑ m ∈ Finset.range F.natDegree,
        Polynomial.C (Pk.coeff m) * Polynomial.X ^ m).degree < (F.natDegree : WithBot ℕ) := by
      have h := Polynomial.degree_sum_fin_lt (fun m : Fin F.natDegree => Pk.coeff m)
      rwa [Fin.sum_univ_eq_sum_range (fun m => Polynomial.C (Pk.coeff m) * Polynomial.X ^ m)
        F.natDegree] at h
    have hFk : Fk.Monic := by
      rw [hFk_def]; exact Polynomial.monic_X_pow_add hdeg
    have hmap : Fk.map φ = F := by
      rw [hFk_def, Polynomial.map_add, Polynomial.map_pow, Polynomial.map_X, Polynomial.map_sum]
      conv_rhs => rw [hF.as_sum]
      congr 1
      refine Finset.sum_congr rfl fun m _ => ?_
      rw [Polynomial.map_mul, Polynomial.map_pow, Polynomial.map_X, Polynomial.map_C, ← hPk,
        Polynomial.coeff_map]
    have h1 : Fk.eval bk ∈ IsLocalRing.maximalIdeal (G k) := by
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      intro hu
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, ← hmap, ← hbk, hev] at ha₀
      exact ha₀ (hu.map φ)
    have h2 : IsUnit (Fk.derivative.eval bk) := by
      rw [← hφr, ← hev, ← Polynomial.derivative_map, hmap, hbk]
      exact hda₀
    obtain ⟨a, ha, hab⟩ := HenselianLocalRing.is_henselian Fk hFk bk h1 h2
    refine ⟨φ a, ?_, ?_⟩
    · rw [Polynomial.IsRoot.def, ← hmap, hev, ha.eq_zero, map_zero]
    · rw [← hbk, ← map_sub, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, hφr]
      rwa [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hab

  intro A _ p hp
  let S : Finset A → Subalgebra ℤ A := fun s => Algebra.adjoin ℤ (s : Set A)
  have hSmono : ∀ {s t : Finset A}, s ≤ t → S s ≤ S t := fun h =>
    Algebra.adjoin_mono (Finset.coe_subset.mpr h)
  have hNS : ∀ s, IsNoetherianRing (S s) := fun s =>
    @Algebra.FiniteType.isNoetherianRing ℤ _ _ _ _
      ((Subalgebra.fg_iff_finiteType _).mp (Subalgebra.fg_adjoin_finset s)) _
  have hps : ∀ s, (Ideal.comap (S s).val p).IsPrime := fun s => Ideal.comap_isPrime _ _
  have hex : ∀ s : Finset A, ∃ (H : Type u) (_ : CommRing H) (q : S s →+* H),
      wcNdIsHens (Ideal.comap (S s).val p) H q :=
    fun s => @noeth (S s) _ (hNS s) _ (hps s)
  choose H iH q hq using hex
  haveI hHL : ∀ s, HenselianLocalRing (H s) := fun s => (hq s).1

  have U : ∀ (s : Finset A) (B : Type u) [CommRing B], HenselianLocalRing B →
      ∀ (ψ₁ ψ₂ : H s →+* B), IsLocalHom ψ₁ → IsLocalHom ψ₂ →
      ψ₁.comp (q s) = ψ₂.comp (q s) → ψ₁ = ψ₂ := by
    intro s B _ hB ψ₁ ψ₂ h1 h2 he
    have hu : ∀ a, IsUnit ((ψ₁.comp (q s)) a) ↔ a ∉ Ideal.comap (S s).val p := by
      intro a
      rw [RingHom.comp_apply, isUnit_map_iff ψ₁]
      exact (hq s).2.1 a
    obtain ⟨h, -, hh⟩ := (hq s).2.2 B hB _ hu
    rw [hh ψ₁ ⟨rfl, h1⟩, hh ψ₂ ⟨he.symm, h2⟩]

  have hfex : ∀ s t : Finset A, ∀ hst : s ≤ t, ∃ f : H s →+* H t,
      f.comp (q s) = (q t).comp (Subalgebra.inclusion (hSmono hst) : S s →+* S t) ∧
        IsLocalHom f := by
    intro s t hst
    have hu : ∀ x, IsUnit (((q t).comp (Subalgebra.inclusion (hSmono hst) : S s →+* S t)) x) ↔
        x ∉ Ideal.comap (S s).val p := by
      intro x
      rw [RingHom.comp_apply, (hq t).2.1]
      exact Iff.rfl
    obtain ⟨f, hf, -⟩ := (hq s).2.2 (H t) (hq t).1 _ hu
    exact ⟨f, hf⟩
  choose f hfq hfl using hfex
  haveI hDS : DirectedSystem H (fun s t h => ⇑(f s t h)) := by
    constructor
    · intro s x
      have e : f s s le_rfl = RingHom.id _ :=
        U s (H s) (hq s).1 _ _ (hfl s s le_rfl) inferInstance (by
          rw [hfq, RingHom.id_comp]
          exact RingHom.ext fun y => rfl)
      exact RingHom.congr_fun e x
    · intro u t s hst htu x
      have e : (f t u htu).comp (f s t hst) = f s u (le_trans hst htu) :=
        U s (H u) (hq u).1 _ _ (@RingHom.isLocalHom_comp _ _ _ _ _ _ _ _ (hfl t u htu)
          (hfl s t hst)) (hfl _ _ _) (by
          rw [RingHom.comp_assoc, hfq, ← RingHom.comp_assoc, hfq, RingHom.comp_assoc, hfq]
          exact RingHom.ext fun y => rfl)
      exact RingHom.congr_fun e x

  obtain ⟨hQloc, hQrefl⟩ := dlim_local H f hfl
  haveI := hQloc
  have hQhens := dlim_hens H f hQrefl
  obtain ⟨o, ho⟩ : ∃ o : ∀ s, H s →+* Ring.DirectLimit H (fun s t h => ⇑(f s t h)),
      ∀ s, o s = Ring.DirectLimit.of H (fun s t h => ⇑(f s t h)) s := ⟨_, fun _ => rfl⟩
  have ho_f : ∀ s t (h : s ≤ t) (x : H s), o t (f s t h x) = o s x := by
    intro s t h x
    rw [ho, ho]
    exact Ring.DirectLimit.of_f h x
  have hor : ∀ s (x : H s), IsUnit (o s x) ↔ IsUnit x := by
    intro s x
    rw [ho]
    exact hQrefl s x
  have hol : ∀ s, IsLocalHom (o s) := fun s => ⟨fun x hx => (hor s x).mp hx⟩

  have hKS : ∀ s t (hst : s ≤ t) (x : S s) (y : S t), (x : A) = y →
      o t (q t y) = o s (q s x) := by
    intro s t hst x y hxy
    have hy : y = Subalgebra.inclusion (hSmono hst) x := Subtype.ext hxy.symm
    rw [hy, ← ho_f s t hst, ← RingHom.comp_apply (f s t hst) (q s), hfq s t hst]
    rfl
  have hC : ∀ s t (x : S s) (y : S t), (x : A) = y → o s (q s x) = o t (q t y) := by
    intro s t x y hxy
    have hz : (x : A) ∈ S (s ∪ t) := hSmono Finset.subset_union_left x.2
    rw [← hKS s (s ∪ t) Finset.subset_union_left x ⟨x, hz⟩ rfl,
      ← hKS t (s ∪ t) Finset.subset_union_right y ⟨x, hz⟩ hxy.symm]
  have mem1 : ∀ a : A, a ∈ S {a} := fun a => Algebra.subset_adjoin (by simp)
  have mem2l : ∀ a b : A, a ∈ S {a, b} := fun a b => Algebra.subset_adjoin (by simp)
  have mem2r : ∀ a b : A, b ∈ S {a, b} := fun a b => Algebra.subset_adjoin (by simp)

  let qA : A →+* Ring.DirectLimit H (fun s t h => ⇑(f s t h)) :=
    { toFun := fun a => o {a} (q {a} ⟨a, mem1 a⟩)
      map_one' := by
        rw [hC {1} ∅ ⟨1, mem1 1⟩ 1 rfl, map_one, map_one]
      map_mul' := fun a b => by
        show o {a * b} (q {a * b} ⟨a * b, mem1 _⟩) =
          o {a} (q {a} ⟨a, mem1 a⟩) * o {b} (q {b} ⟨b, mem1 b⟩)
        rw [hC {a} {a, b} ⟨a, mem1 a⟩ ⟨a, mem2l a b⟩ rfl,
          hC {b} {a, b} ⟨b, mem1 b⟩ ⟨b, mem2r a b⟩ rfl, ← map_mul, ← map_mul]
        exact hC _ _ _ _ rfl
      map_zero' := by
        show o {0} (q {0} ⟨0, mem1 _⟩) = 0
        rw [hC {0} ∅ ⟨0, mem1 0⟩ 0 rfl, map_zero, map_zero]
      map_add' := fun a b => by
        show o {a + b} (q {a + b} ⟨a + b, mem1 _⟩) =
          o {a} (q {a} ⟨a, mem1 a⟩) + o {b} (q {b} ⟨b, mem1 b⟩)
        rw [hC {a} {a, b} ⟨a, mem1 a⟩ ⟨a, mem2l a b⟩ rfl,
          hC {b} {a, b} ⟨b, mem1 b⟩ ⟨b, mem2r a b⟩ rfl, ← map_add, ← map_add]
        exact hC _ _ _ _ rfl }
  have hKQ : ∀ s (x : S s), qA x = o s (q s x) := fun s x => hC {(x : A)} s ⟨x, mem1 _⟩ x rfl
  refine ⟨Ring.DirectLimit H (fun s t h => ⇑(f s t h)), inferInstance, qA, hQhens, ?_, ?_⟩
  ·
    intro a
    show IsUnit (o {a} (q {a} ⟨a, mem1 a⟩)) ↔ a ∉ p
    rw [hor, (hq {a}).2.1]
    exact Iff.rfl
  ·
    intro B _ hB g hg
    have hhex : ∀ s, ∃ h : H s →+* B, h.comp (q s) = g.comp ((S s).val : S s →+* A) ∧
        IsLocalHom h := fun s => ((hq s).2.2 B hB _ (fun x => hg x)).exists
    choose hs hsq hsl using hhex
    have hcomp : ∀ s t (h : s ≤ t) (x : H s), hs t (f s t h x) = hs s x := by
      intro s t h x
      have e : (hs t).comp (f s t h) = hs s :=
        U s B hB _ _ (@RingHom.isLocalHom_comp _ _ _ _ _ _ _ _ (hsl t) (hfl s t h)) (hsl s) (by
          rw [RingHom.comp_assoc, hfq, ← RingHom.comp_assoc, hsq, hsq]
          exact RingHom.ext fun y => rfl)
      exact RingHom.congr_fun e x
    let hL := Ring.DirectLimit.lift H (fun s t h => ⇑(f s t h)) B hs hcomp
    have hLo : ∀ s x, hL (o s x) = hs s x := by
      intro s x
      rw [ho]
      exact Ring.DirectLimit.lift_of _ _ _ _ _
    have hLl : IsLocalHom hL := by
      refine IsLocalHom.mk fun z hz => ?_
      obtain ⟨s, x, rfl⟩ := Ring.DirectLimit.exists_of (G := H)
        (f := fun s t h => ⇑(f s t h)) z
      rw [← ho, hLo] at hz
      rw [← ho, hor]
      exact (hsl s).map_nonunit x hz
    have hLq : hL.comp qA = g := by
      refine RingHom.ext fun a => ?_
      show hL (o {a} (q {a} ⟨a, mem1 a⟩)) = g a
      rw [hLo]
      exact RingHom.congr_fun (hsq {a}) _
    refine ⟨hL, ⟨hLq, hLl⟩, ?_⟩
    rintro h' ⟨hh', hl'⟩
    have key : ∀ (k : Ring.DirectLimit H (fun s t h => ⇑(f s t h)) →+* B), IsLocalHom k →
        k.comp qA = g → ∀ s, k.comp (o s) = hs s := by
      intro k hk hkq s
      refine U s B hB _ _ (@RingHom.isLocalHom_comp _ _ _ _ _ _ _ _ hk (hol s)) (hsl s) ?_
      rw [hsq]
      refine RingHom.ext fun x => ?_
      show k (o s (q s x)) = g x
      rw [← hKQ s x]
      exact RingHom.congr_fun hkq x
    refine Ring.DirectLimit.hom_ext B fun s => ?_
    rw [← ho, key h' hl' hh' s, key hL hLl hLq s]

theorem wcpa_dj_lr1k_gd_gauss_valuation : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω),
    ∃ V : ValuationSubring (RatFunc Ω), V.toSubring = wcEbGauss W ∧
      (∀ a : Ω, algebraMap Ω (RatFunc Ω) a ∈ V ↔ a ∈ W) ∧
      (∀ a : Ω, V.valuation (algebraMap Ω (RatFunc Ω) a) < 1 ↔ W.valuation a < 1) ∧
      ∀ f : RatFunc Ω, f ≠ 0 → ∃ a : Ω, a ≠ 0 ∧ ∃ u : Vˣ,
        f = algebraMap Ω (RatFunc Ω) a * ((u : V) : RatFunc Ω) :=
by
  classical
  intro Ω _ _ W

  have key : ∀ (x : Ω) (R : Polynomial Ω),
      algebraMap (Polynomial Ω) (RatFunc Ω) (Polynomial.C x * R) =
        algebraMap Ω (RatFunc Ω) x * algebraMap (Polynomial Ω) (RatFunc Ω) R := by
    intro x R
    rw [map_mul, Polynomial.C_eq_algebraMap, ← IsScalarTower.algebraMap_apply]
  have alg_inj : Function.Injective (algebraMap (Polynomial Ω) (RatFunc Ω)) :=
    RatFunc.algebraMap_injective Ω

  have g0 : ∀ q : Polynomial ↥W, (∃ i, IsUnit (q.coeff i)) → q.map W.subtype ≠ 0 := by
    rintro q ⟨i, hi⟩ h
    have h1 := congrArg (fun P => P.coeff i) h
    simp only [Polynomial.coeff_map, Polynomial.coeff_zero] at h1
    have h2 : q.coeff i = 0 := Subtype.ext h1
    exact hi.ne_zero h2

  have s1 : ∀ P Q : Polynomial ↥W, (∃ i, IsUnit (P.coeff i)) → (∃ j, IsUnit (Q.coeff j)) →
      ∃ k, IsUnit ((P * Q).coeff k) := by
    rintro P Q ⟨i, hi⟩ ⟨j, hj⟩
    have hP : P.map (IsLocalRing.residue ↥W) ≠ 0 := by
      intro h
      have h1 := congrArg (fun R => R.coeff i) h
      simp only [Polynomial.coeff_map, Polynomial.coeff_zero] at h1
      exact (IsLocalRing.residue_ne_zero_iff_isUnit _).mpr hi h1
    have hQ : Q.map (IsLocalRing.residue ↥W) ≠ 0 := by
      intro h
      have h1 := congrArg (fun R => R.coeff j) h
      simp only [Polynomial.coeff_map, Polynomial.coeff_zero] at h1
      exact (IsLocalRing.residue_ne_zero_iff_isUnit _).mpr hj h1
    have hPQ : (P * Q).map (IsLocalRing.residue ↥W) ≠ 0 := by
      rw [Polynomial.map_mul]
      exact mul_ne_zero hP hQ
    obtain ⟨k, hk⟩ := Polynomial.support_nonempty.mpr hPQ
    rw [Polynomial.mem_support_iff, Polynomial.coeff_map] at hk
    exact ⟨k, (IsLocalRing.residue_ne_zero_iff_isUnit _).mp hk⟩

  have s2 : ∀ P : Polynomial Ω, P ≠ 0 → ∃ (a : Ω) (P₀ : Polynomial ↥W), a ≠ 0 ∧
      (∃ i, IsUnit (P₀.coeff i)) ∧ P = Polynomial.C a * P₀.map W.subtype := by
    intro P hP
    obtain ⟨j, hj, hmax⟩ := Finset.exists_max_image P.support
      (fun n => W.valuation (P.coeff n)) (Polynomial.support_nonempty.mpr hP)
    have ha0 : P.coeff j ≠ 0 := Polynomial.mem_support_iff.mp hj
    have hcoef : ∀ n, (P.coeff j)⁻¹ * P.coeff n ∈ W := by
      intro n
      by_cases hn : P.coeff n = 0
      · rw [hn, mul_zero]; exact W.zero_mem
      · rw [← ValuationSubring.valuation_le_one_iff]
        have hle := hmax n (Polynomial.mem_support_iff.mpr hn)
        calc W.valuation ((P.coeff j)⁻¹ * P.coeff n)
            = W.valuation (P.coeff j)⁻¹ * W.valuation (P.coeff n) := Valuation.map_mul _ _ _
          _ ≤ W.valuation (P.coeff j)⁻¹ * W.valuation (P.coeff j) := by gcongr
          _ = W.valuation ((P.coeff j)⁻¹ * P.coeff j) := (Valuation.map_mul _ _ _).symm
          _ = 1 := by rw [inv_mul_cancel₀ ha0, Valuation.map_one]
    have hlift : Polynomial.C (P.coeff j)⁻¹ * P ∈ Polynomial.lifts W.subtype := by
      rw [Polynomial.lifts_iff_coeff_lifts]
      intro n
      rw [Polynomial.coeff_C_mul]
      exact ⟨⟨_, hcoef n⟩, rfl⟩
    obtain ⟨P₀, hP₀⟩ := (Polynomial.mem_lifts _).mp hlift
    refine ⟨P.coeff j, P₀, ha0, ⟨j, ?_⟩, ?_⟩
    · have h1 : ((P₀.coeff j : ↥W) : Ω) = 1 := by
        have h3 := congrArg (fun R => R.coeff j) hP₀
        simp only [Polynomial.coeff_map, Polynomial.coeff_C_mul] at h3
        rw [inv_mul_cancel₀ ha0] at h3
        exact h3
      have h2 : P₀.coeff j = 1 := Subtype.ext h1
      rw [h2]
      exact isUnit_one
    · rw [hP₀, ← mul_assoc, ← Polynomial.C_mul, mul_inv_cancel₀ ha0, Polynomial.C_1, one_mul]

  have s3 : ∀ f : RatFunc Ω, f ≠ 0 → ∃ (a : Ω) (N D : Polynomial ↥W), a ≠ 0 ∧
      (∃ i, IsUnit (N.coeff i)) ∧ (∃ j, IsUnit (D.coeff j)) ∧
      f * algebraMap (Polynomial Ω) (RatFunc Ω) (D.map W.subtype) =
        algebraMap Ω (RatFunc Ω) a * algebraMap (Polynomial Ω) (RatFunc Ω) (N.map W.subtype) := by
    intro f hf
    have hnum : f.num ≠ 0 := RatFunc.num_ne_zero hf
    have hden : f.denom ≠ 0 := RatFunc.denom_ne_zero f
    obtain ⟨a₁, N, ha₁, hN, hNe⟩ := s2 _ hnum
    obtain ⟨b, D, hb, hD, hDe⟩ := s2 _ hden
    refine ⟨a₁ / b, N, D, div_ne_zero ha₁ hb, hN, hD, ?_⟩
    have hd0 : algebraMap (Polynomial Ω) (RatFunc Ω) f.denom ≠ 0 := by
      intro h
      apply hden
      apply alg_inj
      rw [h, map_zero]
    have hf' : f * algebraMap (Polynomial Ω) (RatFunc Ω) f.denom =
        algebraMap (Polynomial Ω) (RatFunc Ω) f.num := by
      have hnd := RatFunc.num_div_denom f
      calc f * algebraMap (Polynomial Ω) (RatFunc Ω) f.denom
          = (algebraMap (Polynomial Ω) (RatFunc Ω) f.num /
              algebraMap (Polynomial Ω) (RatFunc Ω) f.denom) *
              algebraMap (Polynomial Ω) (RatFunc Ω) f.denom := by rw [hnd]
        _ = algebraMap (Polynomial Ω) (RatFunc Ω) f.num := div_mul_cancel₀ _ hd0
    rw [hNe, hDe, key, key] at hf'
    have hcb : algebraMap Ω (RatFunc Ω) b ≠ 0 := (map_ne_zero _).mpr hb
    rw [map_div₀, div_mul_eq_mul_div, eq_div_iff hcb, ← hf']
    ring

  have s4 : ∀ {K : Type u} [Field K] (A : ValuationSubring K) (x : K),
      A.valuation x < 1 ↔ (x = 0 ∨ x⁻¹ ∉ A) := by
    intro K _ A x
    by_cases hx : x = 0
    · subst hx
      simp
    · have hpos : 0 < A.valuation x := (Valuation.pos_iff _).mpr hx
      rw [← ValuationSubring.valuation_le_one_iff, Valuation.map_inv, inv_le_one₀ hpos]
      simp [hx]

  obtain ⟨T, hT⟩ : ∃ T : Subring (RatFunc Ω), ∀ f : RatFunc Ω, f ∈ T ↔
      ∃ p q : Polynomial ↥W, (∃ i, IsUnit (q.coeff i)) ∧ q.map W.subtype ≠ 0 ∧
        f * algebraMap (Polynomial Ω) (RatFunc Ω) (q.map W.subtype) =
          algebraMap (Polynomial Ω) (RatFunc Ω) (p.map W.subtype) := by
    refine ⟨{ carrier := {f | ∃ p q : Polynomial ↥W, (∃ i, IsUnit (q.coeff i)) ∧
                q.map W.subtype ≠ 0 ∧
                f * algebraMap (Polynomial Ω) (RatFunc Ω) (q.map W.subtype) =
                  algebraMap (Polynomial Ω) (RatFunc Ω) (p.map W.subtype)}
              mul_mem' := ?_
              one_mem' := ?_
              add_mem' := ?_
              zero_mem' := ?_
              neg_mem' := ?_ }, fun f => Iff.rfl⟩
    · rintro f g ⟨p₁, q₁, hq₁, -, h₁⟩ ⟨p₂, q₂, hq₂, -, h₂⟩
      have hq := s1 q₁ q₂ hq₁ hq₂
      refine ⟨p₁ * p₂, q₁ * q₂, hq, g0 _ hq, ?_⟩
      rw [Polynomial.map_mul, Polynomial.map_mul, map_mul, map_mul, ← h₁, ← h₂]
      ring
    · exact ⟨1, 1, ⟨0, by simp⟩, by simp, by simp⟩
    · rintro f g ⟨p₁, q₁, hq₁, -, h₁⟩ ⟨p₂, q₂, hq₂, -, h₂⟩
      have hq := s1 q₁ q₂ hq₁ hq₂
      refine ⟨p₁ * q₂ + p₂ * q₁, q₁ * q₂, hq, g0 _ hq, ?_⟩
      rw [Polynomial.map_add, Polynomial.map_mul, Polynomial.map_mul, Polynomial.map_mul, map_add,
        map_mul, map_mul, map_mul, ← h₁, ← h₂]
      ring
    · exact ⟨0, 1, ⟨0, by simp⟩, by simp, by simp⟩
    · rintro f ⟨p, q, hq, hq0, h⟩
      refine ⟨-p, q, hq, hq0, ?_⟩
      rw [Polynomial.map_neg, map_neg, ← h]
      ring

  have hmem : ∀ f : RatFunc Ω, f ∈ T ∨ f⁻¹ ∈ T := by
    intro f
    by_cases hf : f = 0
    · left
      rw [hf]
      exact T.zero_mem
    obtain ⟨a, N, D, ha, hN, hD, he⟩ := s3 f hf
    rcases W.mem_or_inv_mem a with h | h
    · left
      rw [hT]
      refine ⟨Polynomial.C ⟨a, h⟩ * N, D, hD, g0 _ hD, ?_⟩
      rw [Polynomial.map_mul, Polynomial.map_C, key]
      exact he
    · right
      rw [hT]
      refine ⟨Polynomial.C ⟨a⁻¹, h⟩ * D, N, hN, g0 _ hN, ?_⟩
      rw [Polynomial.map_mul, Polynomial.map_C, key]
      have hsub : W.subtype ⟨a⁻¹, h⟩ = a⁻¹ := rfl
      have hca : algebraMap Ω (RatFunc Ω) a ≠ 0 := (map_ne_zero _).mpr ha
      rw [hsub, map_inv₀]
      calc f⁻¹ * algebraMap (Polynomial Ω) (RatFunc Ω) (N.map W.subtype)
          = f⁻¹ * (algebraMap Ω (RatFunc Ω) a)⁻¹ * (algebraMap Ω (RatFunc Ω) a *
              algebraMap (Polynomial Ω) (RatFunc Ω) (N.map W.subtype)) := by
            rw [mul_assoc, inv_mul_cancel_left₀ hca]
        _ = f⁻¹ * (algebraMap Ω (RatFunc Ω) a)⁻¹ *
              (f * algebraMap (Polynomial Ω) (RatFunc Ω) (D.map W.subtype)) := by rw [he]
        _ = (algebraMap Ω (RatFunc Ω) a)⁻¹ *
              algebraMap (Polynomial Ω) (RatFunc Ω) (D.map W.subtype) := by
            rw [mul_comm f⁻¹, mul_assoc, inv_mul_cancel_left₀ hf]
  obtain ⟨V, hVT, hVsub⟩ : ∃ V : ValuationSubring (RatFunc Ω), (∀ f, f ∈ V ↔ f ∈ T) ∧
      V.toSubring = T := ⟨{ T with mem_or_inv_mem' := hmem }, fun f => Iff.rfl, rfl⟩

  have hC2 : ∀ a : Ω, algebraMap Ω (RatFunc Ω) a ∈ V ↔ a ∈ W := by
    intro a
    rw [hVT, hT]
    constructor
    · rintro ⟨p, q, hq, -, h⟩
      rw [← key] at h
      have h2 := alg_inj h
      obtain ⟨i, hi⟩ := hq
      have h3 := congrArg (fun R => R.coeff i) h2
      simp only [Polynomial.coeff_C_mul, Polynomial.coeff_map] at h3
      obtain ⟨w, hw⟩ := hi.exists_left_inv
      have h4 : a = W.subtype (p.coeff i) * W.subtype w := by
        rw [← h3, mul_assoc, ← map_mul, mul_comm (q.coeff i) w, hw, map_one, mul_one]
      rw [h4]
      exact (p.coeff i * w).2
    · intro h
      refine ⟨Polynomial.C ⟨a, h⟩, 1, ⟨0, by simp⟩, by simp, ?_⟩
      rw [Polynomial.map_one, map_one, mul_one, Polynomial.map_C]
      have h5 := key a 1
      rw [mul_one, map_one, mul_one] at h5
      exact h5.symm
  refine ⟨V, ?_, hC2, ?_, ?_⟩
  ·
    rw [hVsub]
    unfold wcEbGauss
    apply le_antisymm
    · intro f hf
      exact Subring.subset_closure ((hT f).mp hf)
    · exact Subring.closure_le.mpr (fun f hf => (hT f).mpr hf)
  ·
    intro a
    rw [s4 V, s4 W, map_eq_zero, ← map_inv₀, hC2]
  ·
    intro f hf
    obtain ⟨a, N, D, ha, hN, hD, he⟩ := s3 f hf
    have hN0 : algebraMap (Polynomial Ω) (RatFunc Ω) (N.map W.subtype) ≠ 0 :=
      fun h => g0 N hN (alg_inj (h.trans (map_zero _).symm))
    have hD0 : algebraMap (Polynomial Ω) (RatFunc Ω) (D.map W.subtype) ≠ 0 :=
      fun h => g0 D hD (alg_inj (h.trans (map_zero _).symm))
    obtain ⟨g, hg⟩ : ∃ g : RatFunc Ω, g = algebraMap (Polynomial Ω) (RatFunc Ω) (N.map W.subtype) /
        algebraMap (Polynomial Ω) (RatFunc Ω) (D.map W.subtype) := ⟨_, rfl⟩
    have hg0 : g ≠ 0 := by rw [hg]; exact div_ne_zero hN0 hD0
    have hgV : g ∈ V := by
      rw [hVT, hT]
      refine ⟨N, D, hD, g0 _ hD, ?_⟩
      rw [hg]
      exact div_mul_cancel₀ _ hD0
    have hgiV : g⁻¹ ∈ V := by
      rw [hVT, hT]
      refine ⟨D, N, hN, g0 _ hN, ?_⟩
      rw [hg, inv_div]
      exact div_mul_cancel₀ _ hN0
    refine ⟨a, ha, ⟨⟨g, hgV⟩, ⟨g⁻¹, hgiV⟩, Subtype.ext (mul_inv_cancel₀ hg0),
      Subtype.ext (inv_mul_cancel₀ hg0)⟩, ?_⟩
    show f = algebraMap Ω (RatFunc Ω) a * g
    rw [hg, mul_div_assoc', eq_div_iff hD0]
    exact he

theorem wcpa_dj_lr1k_gd_finite_of_residue_indep : ∀ (K : Type u) [Field K]
    (O : ValuationSubring K) (L : Type u) [Field L] [Algebra K L] [FiniteDimensional K L],
    letI : Algebra O L := ((algebraMap K L).comp O.subtype).toAlgebra
    ∀ b : Fin (Module.finrank K L) → L, (∀ i, IsIntegral O (b i)) →
      (∀ c : Fin (Module.finrank K L) → O,
        (∑ i, algebraMap O L (c i) * b i) ∈ Submodule.span (integralClosure O L)
          {x : L | ∃ m ∈ IsLocalRing.maximalIdeal O, x = algebraMap O L m} →
        ∀ i, c i ∈ IsLocalRing.maximalIdeal O) →
      Module.Finite O (integralClosure O L) :=
by
  intro K _ O L _ _ _
  letI : Algebra O L := ((algebraMap K L).comp O.subtype).toAlgebra
  intro b hb H
  have haO : ∀ c : O, algebraMap O L c = algebraMap K L (c : K) := fun c => rfl

  have norm : ∀ g : Fin (Module.finrank K L) → K, (∃ i, g i ≠ 0) →
      ∃ j, g j ≠ 0 ∧ (∀ i, g i / g j ∈ O) ∧
        ((∃ i, g i ∉ O) → (g j)⁻¹ ∈ O ∧ O.valuation (g j)⁻¹ < 1) := by
    intro g ⟨i₀, hi₀⟩
    obtain ⟨j, -, hj⟩ := Finset.exists_max_image Finset.univ (fun i => O.valuation (g i))
      ⟨i₀, Finset.mem_univ _⟩
    have hvi₀ : O.valuation (g i₀) ≠ 0 := (Valuation.ne_zero_iff _).mpr hi₀
    have hvj : O.valuation (g j) ≠ 0 := by
      intro h
      have := hj i₀ (Finset.mem_univ _)
      rw [h] at this
      exact hvi₀ (le_antisymm this zero_le')
    have hgj : g j ≠ 0 := (Valuation.ne_zero_iff _).mp hvj
    refine ⟨j, hgj, ?_, ?_⟩
    · intro i
      rw [← ValuationSubring.valuation_le_one_iff, Valuation.map_div]
      exact div_le_one_of_le₀ (hj i (Finset.mem_univ _)) zero_le'
    · rintro ⟨i₁, hi₁⟩
      rw [← ValuationSubring.valuation_le_one_iff, not_le] at hi₁
      have h1 : 1 < O.valuation (g j) := lt_of_lt_of_le hi₁ (hj i₁ (Finset.mem_univ _))
      have h2 : O.valuation (g j)⁻¹ < 1 := by
        rw [Valuation.map_inv]; exact inv_lt_one_of_one_lt₀ h1
      exact ⟨(ValuationSubring.valuation_le_one_iff _ _).mp h2.le, h2⟩
  have hsum : ∀ (g : Fin (Module.finrank K L) → K) (j : Fin (Module.finrank K L))
      (hc : ∀ i, g i / g j ∈ O),
      ∑ i, algebraMap O L ⟨g i / g j, hc i⟩ * b i = algebraMap K L (g j)⁻¹ * ∑ i, g i • b i := by
    intro g j hc
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [haO, Algebra.smul_def, ← mul_assoc, ← map_mul]
    show algebraMap K L (g i / g j) * b i = _
    rw [div_eq_inv_mul]
  have hone : ∀ (g : Fin (Module.finrank K L) → K) (j : Fin (Module.finrank K L)), g j ≠ 0 →
      ∀ (h : g j / g j ∈ O), (⟨g j / g j, h⟩ : O) ∉ IsLocalRing.maximalIdeal O := by
    intro g j hj h
    have : (⟨g j / g j, h⟩ : O) = 1 := Subtype.ext (by simp [hj])
    rw [this]
    exact IsLocalRing.notMem_maximalIdeal.mpr isUnit_one

  have hli : LinearIndependent K b := by
    rw [Fintype.linearIndependent_iff]
    intro g hg
    by_contra hne
    push_neg at hne
    obtain ⟨j, hgj, hc, -⟩ := norm g hne
    have hmem := H (fun i => ⟨g i / g j, hc i⟩) (by
      rw [hsum g j hc, hg, mul_zero]
      exact Submodule.zero_mem _) j
    exact hone g j hgj (hc j) hmem
  haveI : Nonempty (Fin (Module.finrank K L)) := ⟨⟨0, Module.finrank_pos⟩⟩
  let bas := basisOfLinearIndependentOfCardEqFinrank hli (Fintype.card_fin _)
  have hbas : ∀ i, bas i = b i := fun i => by simp [bas]
  have hrepr : ∀ x : L, ∑ i, bas.repr x i • b i = x := by
    intro x
    conv_rhs => rw [← bas.sum_repr x]
    simp only [hbas]

  have hcoord : ∀ x : L, x ∈ integralClosure O L → ∀ i, bas.repr x i ∈ O := by
    intro x hx
    by_contra hne
    push_neg at hne
    obtain ⟨i₁, hi₁⟩ := hne
    have hgi₁ : bas.repr x i₁ ≠ 0 := fun h => hi₁ (by rw [h]; exact O.zero_mem)
    obtain ⟨j, hgj, hc, h3⟩ := norm (fun i => bas.repr x i) ⟨i₁, hgi₁⟩
    obtain ⟨htO, htlt⟩ := h3 ⟨i₁, hi₁⟩
    have htm : (⟨(bas.repr x j)⁻¹, htO⟩ : O) ∈ IsLocalRing.maximalIdeal O :=
      (ValuationSubring.valuation_lt_one_iff O _).mpr htlt
    have hmem := H (fun i => ⟨bas.repr x i / bas.repr x j, hc i⟩) (by
      have e := hsum (fun i => bas.repr x i) j hc
      simp only [hrepr x] at e
      rw [e]
      have h1 : algebraMap O L ⟨(bas.repr x j)⁻¹, htO⟩ ∈ Submodule.span (integralClosure O L)
          {x : L | ∃ m ∈ IsLocalRing.maximalIdeal O, x = algebraMap O L m} :=
        Submodule.subset_span ⟨_, htm, rfl⟩
      have h2 := Submodule.smul_mem _ (⟨x, hx⟩ : integralClosure O L) h1
      rw [Subalgebra.smul_def, smul_eq_mul] at h2
      rw [mul_comm]
      exact h2) j
    exact hone (fun i => bas.repr x i) j hgj (hc j) hmem

  let φ : (Fin (Module.finrank K L) → O) →ₗ[O] integralClosure O L :=
    Fintype.linearCombination O (fun i => (⟨b i, hb i⟩ : integralClosure O L))
  have hsurj : Function.Surjective φ := by
    rintro ⟨x, hx⟩
    refine ⟨fun i => ⟨bas.repr x i, hcoord x hx i⟩, ?_⟩
    apply Subtype.ext
    simp only [φ, Fintype.linearCombination_apply]
    rw [AddSubmonoidClass.coe_finset_sum]
    conv_rhs => rw [← hrepr x]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [Subalgebra.coe_smul, Algebra.smul_def, Algebra.smul_def]
    rfl
  exact Module.Finite.of_surjective φ hsurj

theorem wcpa_dj_lr1k_gd_finite_descend : ∀ (K : Type u) [Field K] (O : ValuationSubring K)
    (L M : Type u) [Field L] [Field M] [Algebra K L] [Algebra K M] [Algebra L M]
    [IsScalarTower K L M] [FiniteDimensional K M],
    (letI : Algebra O M := ((algebraMap K M).comp O.subtype).toAlgebra;
      Module.Finite O (integralClosure O M)) →
    (letI : Algebra O L := ((algebraMap K L).comp O.subtype).toAlgebra;
      Module.Finite O (integralClosure O L)) :=
by
  intro K _ O L M _ _ _ _ _ _ _ hM
  letI iL : Algebra O L := ((algebraMap K L).comp O.subtype).toAlgebra
  letI iM : Algebra O M := ((algebraMap K M).comp O.subtype).toAlgebra
  have hM' : Module.Finite O (integralClosure O M) := hM
  haveI : IsScalarTower O L M := IsScalarTower.of_algebraMap_eq' (by
    ext o
    exact IsScalarTower.algebraMap_apply K L M (o : K))

  have s1 : ∀ (N : Submodule O (integralClosure O M)),
      (∀ c : O, c ≠ 0 → ∀ a : integralClosure O M, c • a ∈ N → a ∈ N) → Module.Finite O N := by
    intro N hsat
    have htor : Submodule.torsion O (integralClosure O M ⧸ N) = ⊥ := by
      rw [eq_bot_iff]
      intro x hx
      obtain ⟨c, hc⟩ := (Submodule.mem_torsion_iff x).mp hx
      obtain ⟨a, rfl⟩ := Submodule.Quotient.mk_surjective N x
      have h1 : (c : O) • a ∈ N := by
        rw [← Submodule.Quotient.mk_eq_zero, Submodule.Quotient.mk_smul]
        exact hc
      have h2 := hsat (c : O) (nonZeroDivisors.coe_ne_zero c) a h1
      rw [Submodule.mem_bot, Submodule.Quotient.mk_eq_zero]
      exact h2
    haveI : Module.Flat O (integralClosure O M ⧸ N) :=
      (Module.Flat.flat_iff_torsion_eq_bot_of_isBezout).mpr htor
    haveI : Module.Free O (integralClosure O M ⧸ N) := Module.free_of_flat_of_isLocalRing
    obtain ⟨g, hg⟩ := LinearMap.exists_rightInverse_of_surjective N.mkQ (Submodule.range_mkQ N)
    let p : integralClosure O M →ₗ[O] integralClosure O M := LinearMap.id - g ∘ₗ N.mkQ
    have hp : ∀ a, p a ∈ N := by
      intro a
      have hga : N.mkQ (g (N.mkQ a)) = N.mkQ a := LinearMap.congr_fun hg (N.mkQ a)
      rw [← Submodule.ker_mkQ N, LinearMap.mem_ker]
      simp only [p, LinearMap.sub_apply, LinearMap.id_apply, LinearMap.comp_apply, map_sub, hga,
        sub_self]
    let p' : integralClosure O M →ₗ[O] N := p.codRestrict N hp
    have hsurj : Function.Surjective p' := by
      intro n
      refine ⟨(n : integralClosure O M), Subtype.ext ?_⟩
      have h0 : N.mkQ (n : integralClosure O M) = 0 := by
        rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
        exact n.2
      show p (n : integralClosure O M) = n
      simp only [p, LinearMap.sub_apply, LinearMap.id_apply, LinearMap.comp_apply, h0, map_zero,
        sub_zero]
    exact Module.Finite.of_surjective p' hsurj

  let f : L →ₐ[O] M := IsScalarTower.toAlgHom O L M
  have hf : Function.Injective f := (algebraMap L M).injective
  let φ : integralClosure O L →ₗ[O] integralClosure O M :=
    { toFun := fun x => ⟨f x,
        ((isIntegral_algHom_iff f hf).mpr x.2)⟩
      map_add' := fun x y => Subtype.ext (map_add f (x : L) (y : L))
      map_smul' := fun c x => Subtype.ext (map_smul f c (x : L)) }
  have hφinj : Function.Injective φ := by
    intro x y hxy
    exact Subtype.ext (hf (congrArg Subtype.val hxy))
  have hsat : ∀ c : O, c ≠ 0 → ∀ a : integralClosure O M,
      c • a ∈ LinearMap.range φ → a ∈ LinearMap.range φ := by
    intro c hc a hca
    obtain ⟨x, hx⟩ := hca
    have hx' : algebraMap L M (x : L) = algebraMap O M c * (a : M) := by
      rw [← Algebra.smul_def]
      exact congrArg Subtype.val hx
    have hcL : algebraMap O L c ≠ 0 := by
      show algebraMap K L (c : K) ≠ 0
      exact (map_ne_zero _).mpr (fun h => hc (Subtype.ext h))
    have hcM : algebraMap O M c = algebraMap L M (algebraMap O L c) :=
      IsScalarTower.algebraMap_apply O L M c
    have hcM0 : algebraMap O M c ≠ 0 := by
      rw [hcM]; exact (map_ne_zero _).mpr hcL
    have hy : algebraMap L M ((x : L) / algebraMap O L c) = (a : M) := by
      rw [map_div₀, hx', ← hcM]
      field_simp
    have hyint : IsIntegral O ((x : L) / algebraMap O L c) := by
      refine (isIntegral_algHom_iff f hf).mp ?_
      show IsIntegral O (algebraMap L M ((x : L) / algebraMap O L c))
      rw [hy]
      exact a.2
    exact ⟨⟨(x : L) / algebraMap O L c, hyint⟩, Subtype.ext hy⟩
  haveI := s1 (LinearMap.range φ) hsat
  exact Module.Finite.equiv (LinearEquiv.ofInjective φ hφinj).symm

theorem wcpa_dj_lr1k_grc_valuation_extends : ∀ (K : Type u) [Field K] (M : Type u) [Field M]
    [Algebra K M] (O : ValuationSubring K),
    ∃ V' : ValuationSubring M, V'.comap (algebraMap K M) = O :=
by
  intro K _ M _ _ O
  have finj : Function.Injective (algebraMap K M) := (algebraMap K M).injective
  obtain ⟨B, hAB⟩ :=
    LocalSubring.exists_le_valuationSubring (LocalSubring.map (algebraMap K M) O.toLocalSubring)
  obtain ⟨hle, hloc⟩ := LocalSubring.le_def.mp hAB
  have := hloc
  have hmemA : ∀ y : M, y ∈ (LocalSubring.map (algebraMap K M) O.toLocalSubring).toSubring ↔
      ∃ x ∈ O.toSubring, algebraMap K M x = y := by
    intro y
    rw [LocalSubring.map_toSubring]
    exact Subring.mem_map
  refine ⟨B, ?_⟩
  ext x
  rw [ValuationSubring.mem_comap]
  constructor
  · intro hx
    rcases O.mem_or_inv_mem x with h | h
    · exact h
    by_cases hx0 : x = 0
    · rw [hx0]; exact O.zero_mem
    let a : (LocalSubring.map (algebraMap K M) O.toLocalSubring).toSubring :=
      ⟨algebraMap K M x⁻¹, (hmemA _).mpr ⟨x⁻¹, h, rfl⟩⟩
    have hunit : IsUnit (Subring.inclusion hle a) := by
      refine IsUnit.of_mul_eq_one (⟨algebraMap K M x, hx⟩ : B.toSubring) ?_
      apply Subtype.ext
      show algebraMap K M x⁻¹ * algebraMap K M x = 1
      rw [← map_mul, inv_mul_cancel₀ hx0, map_one]
    have ha : IsUnit a := isUnit_of_map_unit (Subring.inclusion hle) a hunit
    obtain ⟨c, hc⟩ := isUnit_iff_exists_inv.mp ha
    obtain ⟨z, hz, hzc⟩ := (hmemA c).mp c.2
    have h1 : algebraMap K M x⁻¹ * (c : M) = 1 := congrArg Subtype.val hc
    rw [← hzc, ← map_mul] at h1
    have h2 : x⁻¹ * z = 1 := finj (by rw [h1, map_one])
    have h3 : z = x := by
      calc z = x * (x⁻¹ * z) := by rw [← mul_assoc, mul_inv_cancel₀ hx0, one_mul]
        _ = x := by rw [h2, mul_one]
    rw [← h3]; exact hz
  · intro hx
    exact hle ((hmemA _).mpr ⟨x, hx, rfl⟩)

theorem wcpa_dj_lr1k_grc_integral_iff_conj : ∀ (K : Type u) [Field K] (O : ValuationSubring K)
    (M : Type u) [Field M] [Algebra K M] [FiniteDimensional K M] [IsGalois K M]
    (V' : ValuationSubring M), V'.comap (algebraMap K M) = O →
    letI : Algebra O M := ((algebraMap K M).comp O.subtype).toAlgebra
    (∀ x : M, IsIntegral O x ↔ ∀ σ : M ≃ₐ[K] M, σ x ∈ V') ∧
      ∀ (σ : M ≃ₐ[K] M) (t : M), IsIntegral O t → V'.valuation (σ t) = 1 →
        ∃ r : M, IsIntegral O r ∧ V'.valuation (σ r * σ t - 1) < 1 :=
by
  intro K _ O M _ _ _ _ V' hV'
  letI : Algebra O M := ((algebraMap K M).comp O.subtype).toAlgebra
  classical
  have Hlt : ∀ (F : Type u) [Field F] (A : ValuationSubring F) (x : F),
      A.valuation x < 1 ↔ (x = 0 ∨ x⁻¹ ∉ A) := by
    intro F _ A x
    by_cases hx : x = 0
    · simp [hx]
    · have h1 := A.valuation.one_lt_val_iff (inv_ne_zero hx)
      rw [inv_inv] at h1
      rw [← h1, ← A.valuation_le_one_iff, not_le]
      simp [hx]
  have hmemO : ∀ k : K, algebraMap K M k ∈ V' ↔ k ∈ O := fun k => by
    rw [← hV']; rfl
  have hltO : ∀ k : K, V'.valuation (algebraMap K M k) < 1 ↔ O.valuation k < 1 := by
    intro k
    rw [Hlt, Hlt, ← map_inv₀, hmemO, map_eq_zero]

  have hfwd : ∀ x : M, IsIntegral O x → ∀ σ : M ≃ₐ[K] M, σ x ∈ V' := by
    intro x hx σ
    obtain ⟨p, hpm, hp⟩ := hx
    let f : O →+* V' := RingHom.codRestrict ((algebraMap K M).comp O.subtype) V'
      (fun a => (hmemO a).2 a.2)
    have hint : IsIntegral V' (σ x) := by
      refine ⟨p.map f, hpm.map f, ?_⟩
      rw [Polynomial.eval₂_map]
      have h1 : (algebraMap V' M).comp f = (σ : M →+* M).comp (algebraMap O M) :=
        RingHom.ext fun a => (σ.commutes (a : K)).symm
      rw [h1]
      have h2 := Polynomial.hom_eval₂ p (algebraMap O M) (σ : M →+* M) x
      rw [hp, map_zero] at h2
      exact h2.symm
    obtain ⟨y, hy⟩ := IsIntegrallyClosed.isIntegral_iff.mp hint
    rw [← hy]
    exact y.2

  have hbwd : ∀ x : M, (∀ σ : M ≃ₐ[K] M, σ x ∈ V') → IsIntegral O x := by
    intro x hx
    set P := prodXSubSMul (M ≃ₐ[K] M) M x with hP
    have hcV : ∀ n, P.coeff n ∈ V' := by
      have hl : P ∈ Polynomial.liftsRing (algebraMap V' M) := by
        rw [hP, prodXSubSMul.eq_1]
        refine Subring.prod_mem _ (fun g _ => ?_)
        obtain ⟨σ, hσ⟩ := MulAction.ofQuotientStabilizer_mem_orbit (M ≃ₐ[K] M) x g
        refine sub_mem ((Polynomial.lifts_iff_liftsRing _ _).1 (Polynomial.X_mem_lifts _))
          ((Polynomial.lifts_iff_liftsRing _ _).1 ?_)
        rw [← hσ]
        exact Polynomial.C_mem_lifts (algebraMap V' M) ⟨σ • x, hx σ⟩
      intro n
      obtain ⟨y, hy⟩ :=
        (Polynomial.lifts_iff_coeff_lifts P).1 ((Polynomial.lifts_iff_liftsRing _ _).2 hl) n
      rw [← hy]
      exact y.2
    have hcK : ∀ n, ∃ k : K, k ∈ O ∧ algebraMap K M k = P.coeff n := by
      intro n
      have hfix : P.coeff n ∈ (⊥ : IntermediateField K M) := by
        rw [IsGalois.mem_bot_iff_fixed]
        intro f
        exact prodXSubSMul.coeff (M ≃ₐ[K] M) M x f n
      obtain ⟨k, hk⟩ := IntermediateField.mem_bot.1 hfix
      refine ⟨k, (hmemO k).1 ?_, hk⟩
      rw [hk]
      exact hcV n
    have hlO : P ∈ Polynomial.lifts (algebraMap O M) := by
      rw [Polynomial.lifts_iff_coeff_lifts]
      intro n
      obtain ⟨k, hk, hkc⟩ := hcK n
      exact ⟨⟨k, hk⟩, hkc⟩
    obtain ⟨q, hq, -, hqm⟩ :=
      Polynomial.lifts_and_degree_eq_and_monic hlO (prodXSubSMul.monic _ _ x)
    refine ⟨q, hqm, ?_⟩
    rw [← Polynomial.eval_map, hq]
    exact prodXSubSMul.eval _ _ x
  refine ⟨fun x => ⟨fun hx σ => hfwd x hx σ, hbwd x⟩, ?_⟩

  intro σ t ht hv
  let B := integralClosure O M
  let ψ : B →+* V' := RingHom.codRestrict ((σ : M →+* M).comp (B.val : B →+* M)) V'
    (fun b => hfwd b b.2 σ)
  let 𝔐 : Ideal B := Ideal.comap ψ (IsLocalRing.maximalIdeal V')
  have hmem : ∀ b : B, b ∈ 𝔐 ↔ V'.valuation (σ (b : M)) < 1 := fun b =>
    ValuationSubring.valuation_lt_one_iff V' (ψ b)
  haveI : 𝔐.IsPrime := Ideal.comap_isPrime ψ _
  have hcomap : Ideal.comap (algebraMap O B) 𝔐 = IsLocalRing.maximalIdeal O := by
    ext a
    rw [Ideal.mem_comap, hmem, ValuationSubring.valuation_lt_one_iff]
    show V'.valuation (σ (algebraMap K M (a : K))) < 1 ↔ _
    rw [σ.commutes]
    exact hltO a
  have hmax : 𝔐.IsMaximal :=
    Ideal.isMaximal_of_isIntegral_of_isMaximal_comap (algebraMap O B)
      (algebraMap_isIntegral_iff.mpr inferInstance) 𝔐
      (by rw [hcomap]; exact IsLocalRing.maximalIdeal.isMaximal O)
  have htB : (⟨t, ht⟩ : B) ∉ 𝔐 := by
    rw [hmem]
    show ¬ V'.valuation (σ t) < 1
    rw [hv]
    exact lt_irrefl 1
  obtain ⟨y, i, hi, hyi⟩ := hmax.exists_inv htB
  refine ⟨y, y.2, ?_⟩
  have h1 : (y : M) * t + (i : M) = 1 := by
    have := congrArg (fun z : B => (z : M)) hyi
    simpa using this
  have h2 : σ y * σ t - 1 = -σ i := by
    rw [← map_mul, ← map_one σ, ← h1, map_add]
    ring
  rw [h2, Valuation.map_neg]
  exact (hmem i).1 hi

theorem wcpa_dj_lr1k_grc_conjugate_reps : ∀ (K : Type u) [Field K] (M : Type u) [Field M]
    [Algebra K M] [FiniteDimensional K M] [IsGalois K M] (V' : ValuationSubring M),
    ∃ (s : ℕ) (τ : Fin s → (M ≃ₐ[K] M)),
      (∀ σ : M ≃ₐ[K] M, ∃ j, ∀ x : M, σ x ∈ V' ↔ τ j x ∈ V') ∧
      (∀ j j', (∀ x : M, τ j x ∈ V' → τ j' x ∈ V') → j = j') ∧
      s * Nat.card {σ : M ≃ₐ[K] M // ∀ x : M, σ x ∈ V' ↔ x ∈ V'} = Module.finrank K M :=
by
  intro K _ M _ _ _ _ V'
  classical

  have s1 : ∀ σ τ : M ≃ₐ[K] M, (∀ x : M, σ x ∈ V' → τ x ∈ V') →
      ∀ x : M, σ x ∈ V' ↔ τ x ∈ V' := by
    intro σ τ h
    have hi : ∀ z, (τ * σ⁻¹) z = τ (σ.symm z) := fun z => rfl
    have hii : ∀ x, (τ * σ⁻¹) (σ x) = τ x := fun x => by
      rw [hi, AlgEquiv.symm_apply_apply]
    have ha : ∀ z ∈ V', (τ * σ⁻¹) z ∈ V' := by
      intro z hz
      rw [hi]
      apply h
      rw [AlgEquiv.apply_symm_apply]
      exact hz
    have hb : ∀ k : ℕ, ∀ z ∈ V', ((τ * σ⁻¹) ^ k) z ∈ V' := by
      intro k
      induction k with
      | zero => intro z hz; rw [pow_zero, AlgEquiv.one_apply]; exact hz
      | succ k ih =>
        intro z hz
        rw [pow_succ, AlgEquiv.mul_apply]
        exact ih _ (ha z hz)
    have hm : 0 < orderOf (τ * σ⁻¹) := orderOf_pos _
    have hc : ∀ y, ((τ * σ⁻¹) ^ (orderOf (τ * σ⁻¹) - 1)) ((τ * σ⁻¹) y) = y := by
      intro y
      rw [← AlgEquiv.mul_apply, ← pow_succ, Nat.sub_add_cancel hm, pow_orderOf_eq_one,
        AlgEquiv.one_apply]
    intro x
    refine ⟨h x, fun hx => ?_⟩
    rw [← hc (σ x), hii]
    exact hb _ _ hx

  have s3 : ∀ (G β : Type u) [Finite G] (f : G → β) (d : ℕ),
      (∀ σ, Nat.card {τ : G // f τ = f σ} = d) → Nat.card (Set.range f) * d = Nat.card G := by
    intro G β _ f d hd
    have := Fintype.ofFinite G
    let g : G → Set.range f := fun σ => ⟨f σ, Set.mem_range_self σ⟩
    have hg : ∀ y : Set.range f, Nat.card {σ // g σ = y} = d := by
      rintro ⟨b, σ₀, rfl⟩
      rw [← hd σ₀]
      exact Nat.card_congr (Equiv.subtypeEquivRight fun σ => by simp [g, Subtype.ext_iff])
    rw [← Nat.card_congr (Equiv.sigmaFiberEquiv g), Nat.card_sigma]
    simp only [hg]
    rw [Finset.sum_const, smul_eq_mul, Finset.card_univ, Nat.card_eq_fintype_card]

  let C : (M ≃ₐ[K] M) → Set M := fun σ => {x | σ x ∈ V'}
  have hC : ∀ σ x, x ∈ C σ ↔ σ x ∈ V' := fun σ x => Iff.rfl
  let e := Finite.equivFin (Set.range C)
  have hτ : ∀ j : Fin (Nat.card (Set.range C)), ∃ σ, C σ = (e.symm j : Set M) :=
    fun j => (e.symm j).2
  choose τ hτ using hτ
  refine ⟨Nat.card (Set.range C), τ, ?_, ?_, ?_⟩
  · intro σ
    refine ⟨e ⟨C σ, Set.mem_range_self σ⟩, fun x => ?_⟩
    rw [← hC, ← hC, hτ, Equiv.symm_apply_apply]
  · intro j j' h
    have h1 := s1 (τ j) (τ j') h
    have h2 : C (τ j) = C (τ j') := Set.ext fun x => h1 x
    rw [hτ, hτ] at h2
    exact e.symm.injective (Subtype.ext h2)
  · have hfib : ∀ σ, Nat.card {τ' // C τ' = C σ} =
        Nat.card {π : M ≃ₐ[K] M // ∀ x : M, π x ∈ V' ↔ x ∈ V'} := by
      intro σ
      have e1 : Nat.card {τ' // C τ' = C σ} =
          Nat.card {τ' : M ≃ₐ[K] M // ∀ x, τ' x ∈ V' ↔ σ x ∈ V'} :=
        Nat.card_congr (Equiv.subtypeEquivRight fun τ' => Set.ext_iff)
      rw [e1]
      exact Nat.card_congr
        { toFun := fun t => ⟨t.1 * σ⁻¹, fun z => by
            show t.1 (σ.symm z) ∈ V' ↔ z ∈ V'
            have := t.2 (σ.symm z)
            rwa [AlgEquiv.apply_symm_apply] at this⟩
          invFun := fun p => ⟨p.1 * σ, fun x => by
            show p.1 (σ x) ∈ V' ↔ σ x ∈ V'
            exact p.2 (σ x)⟩
          left_inv := fun t => Subtype.ext (inv_mul_cancel_right _ _)
          right_inv := fun p => Subtype.ext (mul_inv_cancel_right _ _) }
    rw [s3 (M ≃ₐ[K] M) (Set M) C _ hfib]
    exact IsGalois.card_aut_eq_finrank K M

theorem wcpa_dj_lr1k_grc_approx_lift : ∀ (M : Type u) [Field M] (s : ℕ)
    (U : Fin s → ValuationSubring M), (∀ i j, U i ≤ U j → i = j) →
    (∀ i (t : M), (∀ l, t ∈ U l) → (U i).valuation t = 1 →
      ∃ r : M, (∀ l, r ∈ U l) ∧ (U i).valuation (r * t - 1) < 1) →
    ∀ i (y : M), y ∈ U i → ∃ b : M, (∀ l, b ∈ U l) ∧ (U i).valuation (b - y) < 1 ∧
      ∀ j, j ≠ i → (U j).valuation b < 1 :=
by
  intro M _ s U hinc hH i y hy
  classical

  have geom_single : ∀ (V : ValuationSubring M) (x : M), ∃ n : ℕ, 1 ≤ n ∧ ∀ k : ℕ, 1 ≤ k →
      V.valuation (∑ j ∈ Finset.range (n * k + 1), x ^ j) = max 1 (V.valuation x ^ (n * k)) := by
    intro V x
    have hmemle : ∀ z : M, z ∈ V → V.valuation z ≤ 1 := fun z hz => (V.valuation_le_one_iff z).mpr hz
    rcases lt_trichotomy (V.valuation x) 1 with hx | hx | hx
    · refine ⟨1, le_rfl, fun k hk => ?_⟩
      rw [one_mul]
      have hmax : max 1 (V.valuation x ^ k) = 1 := max_eq_left (pow_le_one₀ zero_le' hx.le)
      rw [hmax, Finset.sum_range_succ', pow_zero]
      have h : V.valuation (∑ j ∈ Finset.range k, x ^ (j + 1)) < 1 := by
        apply Valuation.map_sum_lt _ one_ne_zero
        intro j _
        rw [map_pow]
        exact pow_lt_one₀ zero_le' hx (Nat.succ_ne_zero j)
      rw [add_comm]
      exact Valuation.map_one_add_of_lt _ h
    · have hxV : x ∈ V := (V.valuation_le_one_iff x).mp hx.le
      have hmax : ∀ N : ℕ, max 1 (V.valuation x ^ N) = 1 := fun N => by rw [hx, one_pow, max_self]
      by_cases hc : V.valuation (x - 1) < 1
      · have hj : ∀ j : ℕ, V.valuation (x ^ j - 1) < 1 := by
          intro j
          rw [← mul_geom_sum, map_mul]
          have h : V.valuation (∑ i ∈ Finset.range j, x ^ i) ≤ 1 :=
            hmemle _ (sum_mem (fun i _ => pow_mem hxV i))
          calc V.valuation (x - 1) * V.valuation (∑ i ∈ Finset.range j, x ^ i)
              ≤ V.valuation (x - 1) * 1 := mul_le_mul_right h _
            _ < 1 := by rw [mul_one]; exact hc
        have key : ∀ N : ℕ, V.valuation ((N + 1 : ℕ) : M) = 1 →
            V.valuation (∑ j ∈ Finset.range (N + 1), x ^ j) = 1 := by
          intro N hN
          have hs : (∑ j ∈ Finset.range (N + 1), x ^ j) =
              ((N + 1 : ℕ) : M) + ∑ j ∈ Finset.range (N + 1), (x ^ j - 1) := by
            rw [Finset.sum_sub_distrib]
            simp
          rw [hs, Valuation.map_add_eq_of_lt_left _ ?_, hN]
          rw [hN]
          exact Valuation.map_sum_lt _ one_ne_zero (fun j _ => hj j)
        by_cases hm : ∃ m : ℕ, 1 ≤ m ∧ V.valuation (m : M) < 1
        · obtain ⟨m, hm1, hmv⟩ := hm
          refine ⟨m, hm1, fun k hk => ?_⟩
          rw [hmax, key]
          have he : ((m * k + 1 : ℕ) : M) = 1 + (m : M) * (k : M) := by push_cast; ring
          rw [he, Valuation.map_one_add_of_lt]
          rw [map_mul]
          have hk' : V.valuation (k : M) ≤ 1 := hmemle _ (natCast_mem V k)
          calc V.valuation (m : M) * V.valuation (k : M) ≤ V.valuation (m : M) * 1 :=
                mul_le_mul_right hk' _
            _ < 1 := by rw [mul_one]; exact hmv
        · push_neg at hm
          refine ⟨1, le_rfl, fun k hk => ?_⟩
          rw [hmax, key]
          exact le_antisymm (hmemle _ (natCast_mem V _)) (hm _ (by omega))
      · have hc1 : V.valuation (x - 1) = 1 :=
          le_antisymm (hmemle _ (sub_mem hxV (one_mem V))) (not_lt.mp hc)
        have key : ∀ N : ℕ, V.valuation (x ^ (N + 1) - 1) = 1 →
            V.valuation (∑ j ∈ Finset.range (N + 1), x ^ j) = 1 := by
          intro N hN
          have h := congrArg V.valuation (mul_geom_sum x (N + 1))
          rw [map_mul, hc1, one_mul, hN] at h
          exact h
        by_cases hm : ∃ m : ℕ, 1 ≤ m ∧ V.valuation (x ^ m - 1) < 1
        · obtain ⟨m, hm1, hmv⟩ := hm
          refine ⟨m, hm1, fun k hk => ?_⟩
          rw [hmax, key]
          have h1 : V.valuation (x ^ (m * k) - 1) < 1 := by
            rw [pow_mul, ← mul_geom_sum, map_mul]
            have h : V.valuation (∑ i ∈ Finset.range k, (x ^ m) ^ i) ≤ 1 :=
              hmemle _ (sum_mem (fun i _ => pow_mem (pow_mem hxV m) i))
            calc V.valuation (x ^ m - 1) * V.valuation (∑ i ∈ Finset.range k, (x ^ m) ^ i)
                ≤ V.valuation (x ^ m - 1) * 1 := mul_le_mul_right h _
              _ < 1 := by rw [mul_one]; exact hmv
          have h2 : x ^ (m * k + 1) - 1 = x * (x ^ (m * k) - 1) + (x - 1) := by ring
          rw [h2, Valuation.map_add_eq_of_lt_right _ ?_, hc1]
          rw [hc1, map_mul, hx, one_mul]
          exact h1
        · push_neg at hm
          refine ⟨1, le_rfl, fun k hk => ?_⟩
          rw [hmax, key]
          exact le_antisymm (hmemle _ (sub_mem (pow_mem hxV _) (one_mem V))) (hm _ (by omega))
    · refine ⟨1, le_rfl, fun k hk => ?_⟩
      rw [one_mul]
      have hmax : max 1 (V.valuation x ^ k) = V.valuation x ^ k := max_eq_right (one_le_pow₀ hx.le)
      rw [hmax, Finset.sum_range_succ]
      have hx0 : V.valuation x ≠ 0 := (zero_lt_one.trans hx).ne'
      have h : V.valuation (∑ j ∈ Finset.range k, x ^ j) < V.valuation (x ^ k) := by
        rw [map_pow]
        apply Valuation.map_sum_lt _ (pow_ne_zero _ hx0)
        intro j hj
        rw [map_pow]
        exact pow_lt_pow_right₀ hx (Finset.mem_range.mp hj)
      rw [Valuation.map_add_eq_of_lt_right _ h, map_pow]

  have denom : ∀ (V : ValuationSubring M) (x : M) (N : ℕ), 1 ≤ N →
      V.valuation (∑ j ∈ Finset.range (N + 1), x ^ j) = max 1 (V.valuation x ^ N) →
      (∑ j ∈ Finset.range (N + 1), x ^ j)⁻¹ ∈ V ∧
      (∑ j ∈ Finset.range (N + 1), x ^ j)⁻¹ * x ∈ V ∧
      (∑ j ∈ Finset.range (N + 1), x ^ j)⁻¹ * x ^ N ∈ V ∧
      (V.valuation x ≤ 1 → V.valuation (∑ j ∈ Finset.range (N + 1), x ^ j)⁻¹ = 1) ∧
      (1 < V.valuation x → V.valuation ((∑ j ∈ Finset.range (N + 1), x ^ j)⁻¹ * x ^ N) = 1) ∧
      (V.valuation x < 1 → V.valuation ((∑ j ∈ Finset.range (N + 1), x ^ j)⁻¹ * x ^ N) < 1) := by
    intro V x N hN hD
    simp only [← V.valuation_le_one_iff, map_mul, map_inv₀, map_pow, hD]
    rcases le_or_gt (V.valuation x) 1 with ha | ha
    · have hp : V.valuation x ^ N ≤ 1 := pow_le_one₀ zero_le' ha
      rw [max_eq_left hp, inv_one]
      have hN0 : N ≠ 0 := by omega
      refine ⟨by simp, by simpa using ha, by simpa using hp, fun _ => by simp,
        fun h => absurd h (not_lt.mpr ha), fun h => by simpa using pow_lt_one₀ zero_le' h hN0⟩
    · have hp : 1 ≤ V.valuation x ^ N := one_le_pow₀ ha.le
      have hp0 : V.valuation x ^ N ≠ 0 := (zero_lt_one.trans_le hp).ne'
      rw [max_eq_right hp]
      refine ⟨inv_le_one_of_one_le₀ hp, ?_, by rw [inv_mul_cancel₀ hp0],
        fun h => absurd h (not_le.mpr ha), fun _ => inv_mul_cancel₀ hp0,
        fun h => absurd h (not_lt.mpr ha.le)⟩
      calc (V.valuation x ^ N)⁻¹ * V.valuation x
          ≤ (V.valuation x ^ N)⁻¹ * V.valuation x ^ N :=
            mul_le_mul_right (le_self_pow₀ ha.le (by omega)) _
        _ = 1 := inv_mul_cancel₀ hp0

  have DP : ∀ x : M, ∃ c : M, ∃ N : ℕ, 1 ≤ N ∧ ∀ l, c ∈ U l ∧ c * x ∈ U l ∧ c * x ^ N ∈ U l ∧
      ((U l).valuation x ≤ 1 → (U l).valuation c = 1) ∧
      (1 < (U l).valuation x → (U l).valuation (c * x ^ N) = 1) ∧
      ((U l).valuation x < 1 → (U l).valuation (c * x ^ N) < 1) := by
    intro x
    choose n hn1 hn using fun l => geom_single (U l) x
    have hN : ∀ l, (U l).valuation (∑ j ∈ Finset.range ((∏ l, n l) + 1), x ^ j) =
        max 1 ((U l).valuation x ^ (∏ l, n l)) := by
      intro l
      rw [← Finset.mul_prod_erase Finset.univ n (Finset.mem_univ l)]
      apply hn l
      have := Finset.prod_pos (s := Finset.univ.erase l) (f := n)
        (fun l' _ => by have := hn1 l'; omega)
      omega
    have hN1 : 1 ≤ ∏ l, n l := by
      have := Finset.prod_pos (s := Finset.univ) (f := n) (fun l' _ => by have := hn1 l'; omega)
      omega
    exact ⟨_, _, hN1, fun l => denom (U l) x _ hN1 (hN l)⟩

  have sep : ∀ j, j ≠ i → ∃ a : M, (∀ l, a ∈ U l) ∧ (U j).valuation a < 1 ∧
      (U i).valuation a = 1 := by
    intro j hji
    have h1 : ¬ U i ≤ U j := fun h => hji (hinc i j h).symm
    have h2 : ¬ U j ≤ U i := fun h => hji (hinc j i h)
    obtain ⟨z, hzj, hzi⟩ := SetLike.not_le_iff_exists.mp h2
    obtain ⟨w, hwi, hwj⟩ := SetLike.not_le_iff_exists.mp h1
    have hw0 : w ≠ 0 := fun h => hwj (h ▸ (U j).zero_mem)
    obtain ⟨x, hx⟩ : ∃ x : M, x = z * w⁻¹ := ⟨_, rfl⟩
    have hzx : z = x * w := by rw [hx, mul_assoc, inv_mul_cancel₀ hw0, mul_one]
    have hxi : 1 < (U i).valuation x := by
      by_contra hc
      push_neg at hc
      apply hzi
      rw [← (U i).valuation_le_one_iff, hzx, map_mul]
      exact mul_le_one' hc (((U i).valuation_le_one_iff _).mpr hwi)
    have hxj : (U j).valuation x < 1 := by
      by_contra hc
      push_neg at hc
      apply hwj
      rw [← (U j).valuation_le_one_iff]
      have hz : (U j).valuation z ≤ 1 := ((U j).valuation_le_one_iff _).mpr hzj
      rw [hzx, map_mul] at hz
      calc (U j).valuation w = 1 * (U j).valuation w := (one_mul _).symm
        _ ≤ (U j).valuation x * (U j).valuation w := mul_le_mul_left hc _
        _ ≤ 1 := hz
    obtain ⟨c, N, _, hc⟩ := DP x
    exact ⟨c * x ^ N, fun l => (hc l).2.2.1, (hc j).2.2.2.2.2 hxj, (hc i).2.2.2.2.1 hxi⟩

  choose! α hαA hαj hαi using sep
  have he0A : ∀ l, (∏ j ∈ Finset.univ.erase i, α j) ∈ U l := fun l =>
    prod_mem (fun j hj => hαA j (Finset.ne_of_mem_erase hj) l)
  have he0i : (U i).valuation (∏ j ∈ Finset.univ.erase i, α j) = 1 := by
    rw [map_prod]
    exact Finset.prod_eq_one (fun j hj => hαi j (Finset.ne_of_mem_erase hj))
  have he0j : ∀ j, j ≠ i → (U j).valuation (∏ j ∈ Finset.univ.erase i, α j) < 1 := by
    intro j hji
    have hjm : j ∈ Finset.univ.erase i := Finset.mem_erase.mpr ⟨hji, Finset.mem_univ j⟩
    rw [← Finset.mul_prod_erase _ _ hjm, map_mul]
    have h : (U j).valuation (∏ k ∈ (Finset.univ.erase i).erase j, α k) ≤ 1 :=
      ((U j).valuation_le_one_iff _).mpr (prod_mem (fun k hk =>
        hαA k (Finset.ne_of_mem_erase (Finset.mem_of_mem_erase hk)) j))
    calc (U j).valuation (α j) * (U j).valuation (∏ k ∈ (Finset.univ.erase i).erase j, α k)
        ≤ (U j).valuation (α j) * 1 := mul_le_mul_right h _
      _ < 1 := by rw [mul_one]; exact hαj j hji
  obtain ⟨r, hrA, hr⟩ := hH i _ he0A he0i

  obtain ⟨c, N, _, hc⟩ := DP y
  have hyi : (U i).valuation y ≤ 1 := ((U i).valuation_le_one_iff _).mpr hy
  obtain ⟨r', hr'A, hr'⟩ := hH i c (fun l => (hc l).1) ((hc i).2.2.2.1 hyi)

  set e := r * ∏ j ∈ Finset.univ.erase i, α j with he
  have heA : ∀ l, e ∈ U l := fun l => mul_mem (hrA l) (he0A l)
  set a := r' * (c * y) with ha
  have haA : ∀ l, a ∈ U l := fun l => mul_mem (hr'A l) (hc l).2.1
  refine ⟨a * e, fun l => mul_mem (haA l) (heA l), ?_, ?_⟩
  · have hid : a * e - y = a * (e - 1) + y * (r' * c - 1) := by rw [ha]; ring
    rw [hid]
    apply Valuation.map_add_lt
    · rw [map_mul]
      have h : (U i).valuation a ≤ 1 := ((U i).valuation_le_one_iff _).mpr (haA i)
      calc (U i).valuation a * (U i).valuation (e - 1) ≤ 1 * (U i).valuation (e - 1) :=
            mul_le_mul_left h _
        _ < 1 := by rw [one_mul]; exact hr
    · rw [map_mul]
      calc (U i).valuation y * (U i).valuation (r' * c - 1) ≤ 1 * (U i).valuation (r' * c - 1) :=
            mul_le_mul_left hyi _
        _ < 1 := by rw [one_mul]; exact hr'
  · intro j hji
    have h1 : (U j).valuation a ≤ 1 := ((U j).valuation_le_one_iff _).mpr (haA j)
    have h2 : (U j).valuation r ≤ 1 := ((U j).valuation_le_one_iff _).mpr (hrA j)
    rw [map_mul, he, map_mul]
    calc (U j).valuation a * ((U j).valuation r * (U j).valuation (∏ j ∈ Finset.univ.erase i, α j))
        ≤ 1 * (1 * (U j).valuation (∏ j ∈ Finset.univ.erase i, α j)) :=
          mul_le_mul' h1 (mul_le_mul_left h2 _)
      _ < 1 := by rw [one_mul, one_mul]; exact he0j j hji

theorem wcpa_dj_lr1k_lrd_ram_index_one : ∀ (K : Type u) [Field K] (V : ValuationSubring K), (∀ c : K, c ≠ 0 → ∀ k : ℕ, 0 < k → ∃ d : K, d ≠ 0 ∧ ∃ u : Vˣ, c = d ^ k * (u : K)) → ∀ (M : Type u) [Field M] [Algebra K M] [Algebra.IsAlgebraic K M] (V' : ValuationSubring M), V'.comap (algebraMap K M) = V → ∀ x : M, x ≠ 0 → ∃ d : K, d ≠ 0 ∧ ∃ u : V'ˣ, x = algebraMap K M d * (u : M) :=
by
  intro K _ V Hdiv M _ _ _ V' hcomap x hx
  classical

  have s3 : ∀ (y : M) (k : ℕ), 0 < k → V'.valuation y ^ k = 1 → ∃ u : V'ˣ, (u : M) = y := by
    intro y k hk hy
    have h1 : V'.valuation y = 1 := by
      rcases lt_trichotomy (V'.valuation y) 1 with h | h | h
      · exact absurd hy (ne_of_lt (pow_lt_one₀ zero_le' h hk.ne'))
      · exact h
      · exact absurd hy (ne_of_gt (one_lt_pow₀ h hk.ne'))
    have hmem : y ∈ V' := (V'.valuation_le_one_iff y).mp h1.le
    have hu : IsUnit (⟨y, hmem⟩ : V') := (V'.valuation_eq_one_iff ⟨y, hmem⟩).mpr h1
    exact ⟨hu.unit, rfl⟩

  obtain ⟨p, hp0, hpx⟩ := Algebra.IsAlgebraic.isAlgebraic (R := K) x
  obtain ⟨f, hf⟩ : ∃ f : ℕ → M, ∀ i, f i = algebraMap K M (p.coeff i) * x ^ i :=
    ⟨_, fun _ => rfl⟩
  have hsum : ∑ i ∈ Finset.range (p.natDegree + 1), f i = 0 := by
    rw [← hpx, Polynomial.aeval_eq_sum_range]
    exact Finset.sum_congr rfl (fun i _ => by rw [hf, Algebra.smul_def])
  have hdeg : p.natDegree ∈ Finset.range (p.natDegree + 1) := Finset.mem_range.mpr (by omega)
  have hfdeg : f p.natDegree ≠ 0 := by
    rw [hf]
    refine mul_ne_zero ?_ (pow_ne_zero _ hx)
    rw [Polynomial.coeff_natDegree]
    exact (map_ne_zero (algebraMap K M)).mpr (Polynomial.leadingCoeff_ne_zero.mpr hp0)

  obtain ⟨m, hm, hmax⟩ : ∃ m ∈ Finset.range (p.natDegree + 1),
      ∀ i ∈ Finset.range (p.natDegree + 1), V'.valuation (f i) ≤ V'.valuation (f m) :=
    Finset.exists_max_image _ _ ⟨_, hdeg⟩
  have hfm : V'.valuation (f m) ≠ 0 := by
    intro h0
    have h1 := hmax _ hdeg
    rw [h0] at h1
    exact hfdeg ((Valuation.zero_iff _).mp (le_antisymm h1 zero_le'))
  have hex : ∃ l ∈ Finset.range (p.natDegree + 1), l ≠ m ∧ V'.valuation (f l) = V'.valuation (f m) := by
    by_contra hcon
    push_neg at hcon
    have hlt : ∀ i ∈ Finset.range (p.natDegree + 1) \ {m}, V'.valuation (f i) < V'.valuation (f m) := by
      intro i hi
      rw [Finset.mem_sdiff, Finset.mem_singleton] at hi
      exact lt_of_le_of_ne (hmax i hi.1) (hcon i hi.1 hi.2)
    have h1 := Valuation.map_sum_eq_of_lt V'.valuation hm hlt
    rw [hsum, map_zero] at h1
    exact hfm h1.symm
  obtain ⟨l, -, hlm, hwl⟩ := hex
  obtain ⟨i, j, hji, hij, hfj⟩ : ∃ i j : ℕ, j < i ∧ V'.valuation (f i) = V'.valuation (f j) ∧
      V'.valuation (f j) ≠ 0 := by
    rcases Nat.lt_or_gt_of_ne hlm with h | h
    · exact ⟨m, l, h, hwl.symm, hwl ▸ hfm⟩
    · exact ⟨l, m, h, hwl, hfm⟩

  have hfe : ∀ n, V'.valuation (f n) =
      V'.valuation (algebraMap K M (p.coeff n)) * V'.valuation x ^ n := by
    intro n; rw [hf, map_mul, map_pow]
  have hfi : V'.valuation (f i) ≠ 0 := hij ▸ hfj
  have hwa : V'.valuation (algebraMap K M (p.coeff i)) ≠ 0 := by
    rw [hfe] at hfi; exact left_ne_zero_of_mul hfi
  have hwb : V'.valuation (algebraMap K M (p.coeff j)) ≠ 0 := by
    rw [hfe] at hfj; exact left_ne_zero_of_mul hfj
  have ha0 : p.coeff i ≠ 0 := by
    intro h; apply hwa; rw [h, map_zero, map_zero]
  have hb0 : p.coeff j ≠ 0 := by
    intro h; apply hwb; rw [h, map_zero, map_zero]
  have hwx : V'.valuation x ≠ 0 := (Valuation.ne_zero_iff _).mpr hx
  obtain ⟨k, rfl⟩ : ∃ k, i = j + k := ⟨i - j, by omega⟩
  have hk : 0 < k := by omega

  have e1 : V'.valuation (algebraMap K M (p.coeff (j + k))) * V'.valuation x ^ k =
      V'.valuation (algebraMap K M (p.coeff j)) := by
    have h2 : (V'.valuation (algebraMap K M (p.coeff (j + k))) * V'.valuation x ^ k) *
        V'.valuation x ^ j = V'.valuation (algebraMap K M (p.coeff j)) * V'.valuation x ^ j := by
      rw [← hfe j, ← hij, hfe, pow_add]; ac_rfl
    exact mul_right_cancel₀ (pow_ne_zero j hwx) h2

  obtain ⟨d, hd, u₀, hc⟩ := Hdiv (p.coeff j / p.coeff (j + k)) (div_ne_zero hb0 ha0) k hk
  have hmemc : ∀ z : K, z ∈ V → algebraMap K M z ∈ V' := by
    intro z hz; rw [← hcomap] at hz; exact (ValuationSubring.mem_comap).mp hz
  have hu1 : V'.valuation (algebraMap K M ((u₀ : V) : K)) = 1 := by
    have hunit : IsUnit (⟨algebraMap K M ((u₀ : V) : K), hmemc _ (u₀ : V).2⟩ : V') := by
      refine isUnit_iff_exists_inv.mpr
        ⟨⟨algebraMap K M (((u₀⁻¹ : Vˣ) : V) : K), hmemc _ ((u₀⁻¹ : Vˣ) : V).2⟩, ?_⟩
      apply Subtype.ext
      show algebraMap K M ((u₀ : V) : K) * algebraMap K M (((u₀⁻¹ : Vˣ) : V) : K) = 1
      rw [← map_mul, ← map_one (algebraMap K M)]
      congr 1
      exact_mod_cast congrArg Subtype.val u₀.mul_inv
    exact (V'.valuation_eq_one_iff _).mp hunit
  have hbA : algebraMap K M (p.coeff j) = algebraMap K M (p.coeff (j + k)) *
      (algebraMap K M d ^ k * algebraMap K M ((u₀ : V) : K)) := by
    rw [← map_pow, ← map_mul, ← map_mul, ← hc]
    congr 1
    field_simp
  have e2 : V'.valuation x ^ k = V'.valuation (algebraMap K M d) ^ k := by
    rw [hbA, map_mul, map_mul, map_pow, hu1, mul_one] at e1
    exact mul_left_cancel₀ hwa e1

  have hAd : algebraMap K M d ≠ 0 := (map_ne_zero _).mpr hd
  have hwd : V'.valuation (algebraMap K M d) ≠ 0 := (Valuation.ne_zero_iff _).mpr hAd
  obtain ⟨u, hu⟩ := s3 (x / algebraMap K M d) k hk (by
    rw [map_div₀, div_pow, e2, div_self (pow_ne_zero _ hwd)])

  refine ⟨d, hd, u, ?_⟩
  rw [hu]
  field_simp

theorem wcpa_dj_lr1k_lrd_inertia_order : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω) (V : ValuationSubring (RatFunc Ω)), V.toSubring = wcEbGauss W → ∀ (M : Type u) [Field M] [Algebra (RatFunc Ω) M] [FiniteDimensional (RatFunc Ω) M] (V' : ValuationSubring M), V'.comap (algebraMap (RatFunc Ω) M) = V → (∀ x : M, x ≠ 0 → ∃ d : RatFunc Ω, d ≠ 0 ∧ ∃ u : V'ˣ, x = algebraMap (RatFunc Ω) M d * (u : M)) → ∀ τ : M ≃ₐ[RatFunc Ω] M, (∀ x : M, τ x ∈ V' ↔ x ∈ V') → (∀ y ∈ V', V'.valuation (τ y - y) < 1) → ((orderOf τ : ℕ) : IsLocalRing.ResidueField W) ≠ 0 → τ = 1 :=
by
  intro Ω _ _ W V hV M _ _ _ V' hV' hE1 τ hτV hτI hord
  classical
  by_contra hτ1

  obtain ⟨n, hn⟩ : ∃ n, orderOf τ = n := ⟨_, rfl⟩
  rw [hn] at hord
  have hn0 : n ≠ 0 := by
    intro h
    apply hord
    rw [h, Nat.cast_zero]
  have hn1 : n ≠ 1 := fun h => hτ1 (orderOf_eq_one_iff.mp (hn.trans h))
  obtain ⟨ℓ, hℓdef⟩ : ∃ ℓ, ℓ = n.minFac := ⟨_, rfl⟩
  have hℓ : ℓ.Prime := hℓdef ▸ Nat.minFac_prime hn1
  have hℓdvd : ℓ ∣ n := hℓdef ▸ Nat.minFac_dvd n
  have hℓle : ℓ ≤ n := hℓdef ▸ Nat.minFac_le (Nat.pos_of_ne_zero hn0)
  obtain ⟨m, hmdef⟩ : ∃ m, m = n / ℓ := ⟨_, rfl⟩
  have hmdvd : m ∣ orderOf τ := by
    rw [hn, hmdef]; exact Nat.div_dvd_of_dvd hℓdvd
  have hm0 : m ≠ 0 := by
    rw [hmdef]; exact (Nat.div_pos hℓle hℓ.pos).ne'
  obtain ⟨σ, hσdef⟩ : ∃ σ, σ = τ ^ m := ⟨_, rfl⟩
  have hσord : orderOf σ = ℓ := by
    rw [hσdef, orderOf_pow_of_dvd hm0 hmdvd, hn, hmdef, Nat.div_div_self hℓdvd hn0]
  have hℓk : (ℓ : IsLocalRing.ResidueField ↥W) ≠ 0 := by
    intro h
    apply hord
    obtain ⟨c, hc⟩ := hℓdvd
    rw [hc, Nat.cast_mul, h, zero_mul]

  have hu : IsUnit (ℓ : ↥W) := by
    rw [← IsLocalRing.residue_ne_zero_iff_isUnit, map_natCast]
    exact hℓk
  have hΩ : (ℓ : Ω) ≠ 0 := by
    have := hu.map W.subtype
    rw [map_natCast] at this
    exact this.ne_zero
  haveI : NeZero (ℓ : Ω) := ⟨hΩ⟩
  obtain ⟨ζ₀, hζ₀⟩ := HasEnoughRootsOfUnity.exists_primitiveRoot Ω ℓ
  have hmem : ζ₀ ∈ W := by
    rcases W.mem_or_inv_mem ζ₀ with h | h
    · exact h
    · have hz : ζ₀ = (ζ₀⁻¹) ^ (ℓ - 1) := by
        rw [inv_pow]
        have : ζ₀ ^ (ℓ - 1) * ζ₀ = 1 := by
          rw [← pow_succ, Nat.sub_add_cancel hℓ.one_lt.le, hζ₀.pow_eq_one]
        exact eq_inv_of_mul_eq_one_right this
      rw [hz]
      exact W.pow_mem h _
  obtain ⟨ζ, hζdef⟩ : ∃ ζ : ↥W, ζ = ⟨ζ₀, hmem⟩ := ⟨_, rfl⟩
  have hζ : IsPrimitiveRoot ζ ℓ := by
    have hinj : Function.Injective W.subtype := Subtype.val_injective
    rw [hζdef]
    exact IsPrimitiveRoot.of_map_of_injective (f := W.subtype) hζ₀ hinj
  have hζu : ∀ i : ℕ, 0 < i → i < ℓ → IsUnit (1 - ζ ^ i) := by
    intro i hi0 hil
    obtain ⟨k, hk⟩ : ∃ k, ℓ = k + 1 := ⟨ℓ - 1, by omega⟩
    rw [hk] at hζ hu
    have hprod := hζ.prod_one_sub_pow_eq_order
    have hunit : IsUnit (∏ j ∈ Finset.range k, (1 - ζ ^ (j + 1))) := by
      rw [hprod]
      have : ((k + 1 : ℕ) : ↥W) = (k : ↥W) + 1 := by push_cast; ring
      rw [← this]
      exact hu
    have hdvd : (1 - ζ ^ (i - 1 + 1)) ∣ ∏ j ∈ Finset.range k, (1 - ζ ^ (j + 1)) :=
      Finset.dvd_prod_of_mem (fun j => 1 - ζ ^ (j + 1)) (Finset.mem_range.mpr (by omega))
    rw [Nat.sub_add_cancel hi0] at hdvd
    exact isUnit_of_dvd_unit hdvd hunit

  have hmemV : ∀ w : ↥W, algebraMap Ω (RatFunc Ω) (w : Ω) ∈ V := by
    intro w
    have h : algebraMap Ω (RatFunc Ω) (w : Ω) ∈ wcEbGauss W := by
      apply Subring.subset_closure
      refine ⟨Polynomial.C w, 1, ⟨0, by simp⟩, by simp, ?_⟩
      rw [Polynomial.map_one, map_one, mul_one, Polynomial.map_C, RatFunc.algebraMap_C]
      rfl
    rw [← hV] at h
    exact h
  obtain ⟨g, hg⟩ : ∃ g : ↥W →+* M, ∀ w : ↥W,
      g w = algebraMap (RatFunc Ω) M (algebraMap Ω (RatFunc Ω) (w : Ω)) :=
    ⟨(algebraMap (RatFunc Ω) M).comp ((algebraMap Ω (RatFunc Ω)).comp W.subtype), fun w => rfl⟩
  have hgmem : ∀ w : ↥W, g w ∈ V' := by
    intro w
    have h1 : algebraMap Ω (RatFunc Ω) (w : Ω) ∈ V := hmemV w
    rw [← hV'] at h1
    rw [hg]
    exact ValuationSubring.mem_comap.mp h1
  have hgunit : ∀ w : ↥W, IsUnit w → V'.valuation (g w) = 1 := by
    intro w hw
    obtain ⟨w', hw'⟩ := hw.exists_right_inv
    have h1 : g w * g w' = 1 := by rw [← map_mul, hw', map_one]
    let a : V' := ⟨g w, hgmem w⟩
    let b : V' := ⟨g w', hgmem w'⟩
    have hab : a * b = 1 := Subtype.ext h1
    exact V'.valuation_unit (Units.mkOfMulEqOne a b hab)
  have hfixK : ∀ (ρ : M ≃ₐ[RatFunc Ω] M) (w : ↥W), ρ (g w) = g w := by
    intro ρ w
    rw [hg]
    exact ρ.commutes _
  obtain ⟨z, hzdef⟩ : ∃ z : M, z = g ζ := ⟨_, rfl⟩
  have hzσ : σ z = z := by rw [hzdef]; exact hfixK σ ζ
  have hzl : z ^ ℓ = 1 := by rw [hzdef, ← map_pow, hζ.pow_eq_one, map_one]
  have hzv : ∀ i : ℕ, 0 < i → i < ℓ → V'.valuation (z ^ i - 1) = 1 := by
    intro i h0 h1
    have e : z ^ i - 1 = -(g (1 - ζ ^ i)) := by
      rw [hzdef, map_sub, map_one, map_pow]; ring
    rw [e, Valuation.map_neg]
    exact hgunit _ (hζu i h0 h1)
  have hzne : ∀ i : ℕ, 0 < i → i < ℓ → z ^ i ≠ 1 := by
    intro i h0 h1 h
    have := hzv i h0 h1
    rw [h, sub_self, Valuation.map_zero] at this
    exact zero_ne_one this
  have hℓN : (ℓ : M) ≠ 0 := by
    have := hu.map g
    rw [map_natCast] at this
    exact this.ne_zero

  have hpow : ∀ k : ℕ, ∀ y ∈ V', (τ ^ k) y ∈ V' ∧ V'.valuation ((τ ^ k) y - y) < 1 := by
    intro k
    induction k with
    | zero =>
      intro y hy
      rw [pow_zero, AlgEquiv.one_apply, sub_self, Valuation.map_zero]
      exact ⟨hy, zero_lt_one⟩
    | succ k ih =>
      intro y hy
      obtain ⟨h1, h2⟩ := ih y hy
      rw [pow_succ', AlgEquiv.mul_apply]
      refine ⟨(hτV _).2 h1, ?_⟩
      have e : τ ((τ ^ k) y) - y = (τ ((τ ^ k) y) - (τ ^ k) y) + ((τ ^ k) y - y) := by ring
      rw [e]
      exact Valuation.map_add_lt _ (hτI _ h1) h2
  have hσI : ∀ y ∈ V', V'.valuation (σ y - y) < 1 := by
    intro y hy
    rw [hσdef]
    exact (hpow m y hy).2

  have hσl : σ ^ ℓ = 1 := by rw [← hσord]; exact pow_orderOf_eq_one σ
  have hσ1 : σ ≠ 1 := by
    intro h
    rw [h, orderOf_one] at hσord
    exact hℓ.one_lt.ne hσord
  have hℓpos : 0 < ℓ := hℓ.pos
  obtain ⟨k, hk⟩ : ∃ k, ℓ = k + 1 := ⟨ℓ - 1, by omega⟩
  obtain ⟨x, hxm⟩ : ∃ x : M, σ x ≠ x := by
    by_contra hcon
    push_neg at hcon
    apply hσ1
    ext a
    rw [hcon a, AlgEquiv.one_apply]

  obtain ⟨α, hα⟩ : ∃ α : ℕ → M, ∀ j, α j = ∑ i ∈ Finset.range ℓ, z ^ (i * j) * (σ ^ i) x :=
    ⟨_, fun j => rfl⟩

  have heig : ∀ j : ℕ, z ^ j * σ (α j) = α j := by
    intro j
    rw [hα, map_sum, Finset.mul_sum]
    have h1 : ∀ i ∈ Finset.range ℓ, z ^ j * σ (z ^ (i * j) * (σ ^ i) x)
        = z ^ ((i + 1) * j) * (σ ^ (i + 1)) x := by
      intro i _
      rw [map_mul, map_pow, hzσ, pow_succ' σ i, AlgEquiv.mul_apply, ← mul_assoc, ← pow_add]
      congr 2
      ring
    rw [Finset.sum_congr rfl h1]
    have h2 := Finset.sum_range_succ' (fun i => z ^ (i * j) * (σ ^ i) x) ℓ
    have h3 := Finset.sum_range_succ (fun i => z ^ (i * j) * (σ ^ i) x) ℓ
    rw [h2] at h3
    have hl : z ^ (ℓ * j) * (σ ^ ℓ) x = z ^ (0 * j) * (σ ^ 0) x := by
      rw [pow_mul, hzl, hσl, one_pow, zero_mul, pow_zero, pow_zero]
    linear_combination h3 + hl

  have horth : ∑ j ∈ Finset.range ℓ, α j = (ℓ : M) * x := by
    simp only [hα]
    rw [Finset.sum_comm, hk, Finset.sum_range_succ']
    have hzl' : z ^ (k + 1) = 1 := hk ▸ hzl
    have hzero : ∀ i ∈ Finset.range k,
        ∑ j ∈ Finset.range (k + 1), z ^ ((i + 1) * j) * (σ ^ (i + 1)) x = 0 := by
      intro i hi
      rw [← Finset.sum_mul]
      have hgeo : ∑ j ∈ Finset.range (k + 1), z ^ ((i + 1) * j) = 0 := by
        have hw : z ^ (i + 1) ≠ 1 :=
          hzne (i + 1) (by omega) (by rw [Finset.mem_range] at hi; omega)
        have := geom_sum_mul (z ^ (i + 1)) (k + 1)
        simp only [← pow_mul] at this
        rw [mul_comm (i + 1) (k + 1), pow_mul, hzl', one_pow, sub_self] at this
        exact (mul_eq_zero.mp this).resolve_right (sub_ne_zero.mpr hw)
      rw [hgeo, zero_mul]
    rw [Finset.sum_eq_zero hzero, zero_add]
    simp

  obtain ⟨j, hj0, hjl, hαj⟩ : ∃ j, 0 < j ∧ j < ℓ ∧ α j ≠ 0 := by
    by_contra hcon
    push_neg at hcon
    have h0 : α 0 = (ℓ : M) * x := by
      rw [← horth, Finset.sum_eq_single_of_mem 0 (Finset.mem_range.mpr hℓpos)]
      intro b hb hb0
      exact hcon b (Nat.pos_of_ne_zero hb0) (Finset.mem_range.mp hb)
    have h1 := heig 0
    rw [pow_zero, one_mul, h0, map_mul, map_natCast] at h1
    exact hxm (mul_left_cancel₀ hℓN h1)

  obtain ⟨d, hd, u, hαdu⟩ := hE1 (α j) hαj
  have hd0 : algebraMap (RatFunc Ω) M d ≠ 0 := (map_ne_zero _).2 hd
  have hσu : z ^ j * σ (u : M) = (u : M) := by
    have h1 := heig j
    rw [hαdu, map_mul, AlgEquiv.commutes] at h1
    apply mul_left_cancel₀ hd0
    rw [← h1]
    ring
  have hk0 : 0 < ℓ - j := by omega
  have hkl : ℓ - j < ℓ := by omega
  have hσu' : σ (u : M) = z ^ (ℓ - j) * (u : M) := by
    calc σ (u : M) = z ^ (ℓ - j) * (z ^ j * σ (u : M)) := by
          rw [← mul_assoc, ← pow_add, Nat.sub_add_cancel hjl.le, hzl, one_mul]
      _ = z ^ (ℓ - j) * (u : M) := by rw [hσu]
  have hval : V'.valuation (σ (u : M) - (u : M)) = 1 := by
    have e : σ (u : M) - (u : M) = (z ^ (ℓ - j) - 1) * (u : M) := by rw [hσu']; ring
    rw [e, Valuation.map_mul, hzv _ hk0 hkl, one_mul]
    exact V'.valuation_unit u
  have hlt := hσI (u : M) (u : V').2
  rw [hval] at hlt
  exact lt_irrefl _ hlt

theorem wcpa_dj_lr1k_nis_poly_closure_fg : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → ∀ (M : Type u) [Field M] [Algebra (RatFunc Ω) M] [FiniteDimensional (RatFunc Ω) M] [IsGalois (RatFunc Ω) M] (H' : Subgroup (M ≃ₐ[RatFunc Ω] M)), letI : Algebra (Polynomial ↥W) M := ((algebraMap (RatFunc Ω) M).comp ((algebraMap (Polynomial Ω) (RatFunc Ω)).comp (Polynomial.mapRingHom W.subtype))).toAlgebra; ∃ (r : ℕ) (g : Fin r → M), (∀ i, IsIntegral (Polynomial ↥W) (g i) ∧ ∀ τ ∈ H', τ (g i) = g i) ∧ ∀ x : M, IsIntegral (Polynomial ↥W) x → (∀ τ ∈ H', τ x = x) → ∃ q : Fin r → Polynomial ↥W, x = ∑ i, algebraMap (Polynomial ↥W) M (q i) * g i :=
by
  intro Ω _ _ W hW M _ _ _ _ H'
  classical

  have s5 : ∀ (R C B : Type u) [CommRing R] [CommRing C] [CommRing B] [Algebra R C] [Algebra C B]
      [Algebra R B] [IsScalarTower R C B], Module.Finite R C →
      Algebra.FiniteType C (integralClosure C B) → ∃ (r : ℕ) (g : Fin r → B),
        (∀ i, IsIntegral R (g i)) ∧ ∀ x : B, IsIntegral R x →
          ∃ q : Fin r → R, x = ∑ i, algebraMap R B (q i) * g i := by
    intro R C B _ _ _ _ _ _ _ hRC hFT
    have : Module.Finite C (integralClosure C B) := Algebra.IsIntegral.finite
    have : Module.Finite R (integralClosure C B) := Module.Finite.trans C _
    obtain ⟨r, e, he⟩ := Module.Finite.exists_fin (R := R) (M := integralClosure C B)
    have : Algebra.IsIntegral R C := Algebra.IsIntegral.of_finite R C
    refine ⟨r, fun i => (e i : B), fun i => isIntegral_trans _ (e i).2, ?_⟩
    intro x hx
    have hxC : x ∈ integralClosure C B := hx.tower_top
    have hmem : (⟨x, hxC⟩ : integralClosure C B) ∈ Submodule.span R (Set.range e) := by
      rw [he]; trivial
    obtain ⟨q, hq⟩ := (Submodule.mem_span_range_iff_exists_fun R).1 hmem
    refine ⟨q, ?_⟩
    have h2 := congrArg Subtype.val hq
    simp only [AddSubmonoidClass.coe_finsetSum] at h2
    rw [← h2]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [← Algebra.smul_def]
    rfl

  have D1 : ∀ S : Finset Ω, ∃ c : W, c ≠ 0 ∧ ∀ a ∈ S, (c : Ω) * a ∈ W := by
    intro S
    induction S using Finset.induction_on with
    | empty => exact ⟨1, one_ne_zero, fun a ha => absurd ha (Finset.notMem_empty a)⟩
    | insert a S haS ih =>
      obtain ⟨c, hc0, hc⟩ := ih
      by_cases ha : a ∈ W
      · refine ⟨c, hc0, fun x hx => ?_⟩
        rcases Finset.mem_insert.1 hx with h | hx
        · rw [h]; exact mul_mem c.2 ha
        · exact hc x hx
      · have ha0 : a ≠ 0 := fun h => ha (h ▸ W.zero_mem)
        have hai : a⁻¹ ∈ W := (W.mem_or_inv_mem a).resolve_left ha
        refine ⟨c * ⟨a⁻¹, hai⟩, ?_, fun x hx => ?_⟩
        · refine mul_ne_zero hc0 (fun h => inv_ne_zero ha0 ?_)
          exact congrArg Subtype.val h
        · have hcoe : ((c * ⟨a⁻¹, hai⟩ : W) : Ω) = (c : Ω) * a⁻¹ := rfl
          rcases Finset.mem_insert.1 hx with h | hx
          · rw [h, hcoe, mul_assoc, inv_mul_cancel₀ ha0, mul_one]; exact c.2
          · rw [hcoe, mul_right_comm]
            exact mul_mem (hc x hx) hai

  have D2 : ∀ T : Finset (Polynomial Ω), ∃ c : W, c ≠ 0 ∧
      ∀ f ∈ T, Polynomial.C (c : Ω) * f ∈ Polynomial.lifts W.subtype := by
    intro T
    obtain ⟨c, hc0, hc⟩ := D1 (T.biUnion (fun f => f.support.image f.coeff))
    refine ⟨c, hc0, fun f hf => ?_⟩
    rw [Polynomial.lifts_iff_coeff_lifts]
    intro n
    rw [Polynomial.coeff_C_mul]
    by_cases hn : n ∈ f.support
    · have hmem : f.coeff n ∈ T.biUnion (fun f => f.support.image f.coeff) :=
        Finset.mem_biUnion.2 ⟨f, hf, Finset.mem_image.2 ⟨n, hn, rfl⟩⟩
      exact ⟨⟨_, hc _ hmem⟩, rfl⟩
    · rw [Polynomial.notMem_support_iff.1 hn, mul_zero]
      exact ⟨0, map_zero _⟩

  letI algPM : Algebra (Polynomial Ω) M :=
    ((algebraMap (RatFunc Ω) M).comp (algebraMap (Polynomial Ω) (RatFunc Ω))).toAlgebra
  haveI : IsScalarTower (Polynomial Ω) (RatFunc Ω) M :=
    IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  haveI hICfin : Module.Finite (Polynomial Ω) (integralClosure (Polynomial Ω) M) :=
    IsIntegralClosure.finite (Polynomial Ω) (RatFunc Ω) M (integralClosure (Polynomial Ω) M)
  let Bs : Subalgebra (Polynomial Ω) M :=
    { carrier := {x | IsIntegral (Polynomial Ω) x ∧ ∀ τ ∈ H', τ x = x}
      mul_mem' := fun {a b} ha hb =>
        ⟨ha.1.mul hb.1, fun τ hτ => by rw [map_mul, ha.2 τ hτ, hb.2 τ hτ]⟩
      one_mem' := ⟨isIntegral_one, fun τ _ => map_one τ⟩
      add_mem' := fun {a b} ha hb =>
        ⟨ha.1.add hb.1, fun τ hτ => by rw [map_add, ha.2 τ hτ, hb.2 τ hτ]⟩
      zero_mem' := ⟨isIntegral_zero, fun τ _ => map_zero τ⟩
      algebraMap_mem' := fun f =>
        ⟨isIntegral_algebraMap, fun τ _ => τ.commutes (algebraMap (Polynomial Ω) (RatFunc Ω) f)⟩ }
  have hBmem : ∀ x : M, x ∈ Bs ↔ (IsIntegral (Polynomial Ω) x ∧ ∀ τ ∈ H', τ x = x) :=
    fun x => Iff.rfl
  haveI hBsfin : Module.Finite (Polynomial Ω) Bs := by
    haveI : IsNoetherian (Polynomial Ω) (integralClosure (Polynomial Ω) M) :=
      isNoetherian_of_isNoetherianRing_of_finite _ _
    have hle : Bs ≤ integralClosure (Polynomial Ω) M := fun x hx => ((hBmem x).1 hx).1
    exact Module.Finite.of_injective (Subalgebra.inclusion hle).toLinearMap
      (Subalgebra.inclusion_injective hle)

  letI algWB : Algebra (Polynomial W) Bs :=
    ((algebraMap (Polynomial Ω) Bs).comp (Polynomial.mapRingHom W.subtype)).toAlgebra
  have hL : ∀ p : Polynomial Ω, p ∈ Set.range ⇑(Polynomial.mapRingHom W.subtype) ↔
      p ∈ Polynomial.lifts W.subtype := fun p => by
    rw [Polynomial.lifts_iff_set_range, Polynomial.coe_mapRingHom]

  have D3 : ∀ (y : Bs) (P : Polynomial (Polynomial Ω)), P.Monic →
      Polynomial.aeval y P = 0 → ∀ c : W,
      (∀ k < P.natDegree, Polynomial.C (c : Ω) * P.coeff k ∈ Polynomial.lifts W.subtype) →
      IsIntegral (Polynomial W) (algebraMap (Polynomial Ω) Bs (Polynomial.C (c : Ω)) * y) := by
    intro y P hPm hPy c hc
    set s : Polynomial Ω := Polynomial.C (c : Ω) with hs
    have hsL : s ∈ Polynomial.lifts W.subtype :=
      (Polynomial.mem_lifts _).2 ⟨Polynomial.C c, by rw [Polynomial.map_C]; rfl⟩
    have hQL : P.scaleRoots s ∈ Polynomial.lifts (Polynomial.mapRingHom W.subtype) := by
      rw [Polynomial.lifts_iff_coeff_lifts]
      intro n
      rw [hL, Polynomial.coeff_scaleRoots]
      rcases lt_trichotomy n P.natDegree with hn | hn | hn
      · have e : P.natDegree - n = (P.natDegree - n - 1) + 1 := by omega
        rw [e, pow_succ, mul_comm (s ^ _) s, ← mul_assoc, mul_comm (P.coeff n) s]
        exact mul_mem (hc n hn) (pow_mem hsL _)
      · rw [hn, Nat.sub_self, pow_zero, mul_one]
        have : P.coeff P.natDegree = 1 := hPm
        rw [this]; exact one_mem _
      · rw [Polynomial.coeff_eq_zero_of_natDegree_lt hn, zero_mul]; exact zero_mem _
    have hQm : (P.scaleRoots s).Monic := (Polynomial.monic_scaleRoots_iff s).2 hPm
    obtain ⟨Q', hQ'map, _, hQ'm⟩ := Polynomial.lifts_and_natDegree_eq_and_monic hQL hQm
    have hev := Polynomial.scaleRoots_aeval_eq_zero (r := s) hPy
    refine ⟨Q', hQ'm, ?_⟩
    rw [show algebraMap (Polynomial W) Bs =
        (algebraMap (Polynomial Ω) Bs).comp (Polynomial.mapRingHom W.subtype) from rfl,
      ← Polynomial.eval₂_map, hQ'map, ← Polynomial.aeval_def]
    exact hev

  obtain ⟨n₀, b₀, hb₀⟩ := Module.Finite.exists_fin (R := Polynomial Ω) (M := Bs)
  have hb₀int : ∀ j, IsIntegral (Polynomial Ω) (b₀ j) := fun j => IsIntegral.of_finite _ _
  choose P hPm hPev using hb₀int
  obtain ⟨c, hc0, hc⟩ := D2 (Finset.univ.biUnion
    (fun j => (Finset.range (P j).natDegree).image (P j).coeff))
  let b : Fin n₀ → Bs := fun j => algebraMap (Polynomial Ω) Bs (Polynomial.C (c : Ω)) * b₀ j
  have hb_int : ∀ j, IsIntegral (Polynomial W) (b j) := by
    intro j
    refine D3 (b₀ j) (P j) (hPm j) (by rw [Polynomial.aeval_def]; exact hPev j) c ?_
    intro k hk
    exact hc _ (Finset.mem_biUnion.2 ⟨j, Finset.mem_univ _,
      Finset.mem_image.2 ⟨k, Finset.mem_range.2 hk, rfl⟩⟩)
  have hb_gen : ∀ y : Bs, ∃ c' : W, c' ≠ 0 ∧
      algebraMap (Polynomial Ω) Bs (Polynomial.C (c' : Ω)) * y ∈
        Algebra.adjoin (Polynomial W) (Set.range b) := by
    intro y
    have hy : y ∈ Submodule.span (Polynomial Ω) (Set.range b₀) := by rw [hb₀]; trivial
    obtain ⟨f, hf⟩ := (Submodule.mem_span_range_iff_exists_fun (Polynomial Ω)).1 hy
    obtain ⟨d, hd0, hd⟩ := D2 (Finset.univ.image f)
    have hq : ∀ j, ∃ q : Polynomial W, Polynomial.map W.subtype q = Polynomial.C (d : Ω) * f j :=
      fun j => (Polynomial.mem_lifts _).1 (hd _ (Finset.mem_image.2 ⟨j, Finset.mem_univ _, rfl⟩))
    choose q hq using hq
    refine ⟨d * c, mul_ne_zero hd0 hc0, ?_⟩
    have heq : algebraMap (Polynomial Ω) Bs (Polynomial.C ((d * c : W) : Ω)) * y =
        ∑ j, algebraMap (Polynomial W) Bs (q j) * b j := by
      have e1 : ∀ j, algebraMap (Polynomial W) Bs (q j) =
          algebraMap (Polynomial Ω) Bs (Polynomial.C (d : Ω) * f j) := by
        intro j
        rw [← hq j]; rfl
      simp only [e1]
      rw [← hf, Finset.mul_sum]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      have hcoe : ((d * c : W) : Ω) = (d : Ω) * (c : Ω) := rfl
      simp only [b, hcoe, map_mul, Algebra.smul_def]
      ring
    rw [heq]
    refine Subalgebra.sum_mem _ (fun j _ => Subalgebra.mul_mem _ (Subalgebra.algebraMap_mem _ _) ?_)
    exact Algebra.subset_adjoin ⟨j, rfl⟩

  let Cs : Subalgebra (Polynomial W) Bs := Algebra.adjoin (Polynomial W) (Set.range b)
  have hCfin : Module.Finite (Polynomial W) Cs :=
    Algebra.finite_adjoin_of_finite_of_isIntegral (Set.finite_range b)
      (by rintro _ ⟨j, rfl⟩; exact hb_int j)
  letI algΩB : Algebra Ω Bs := ((algebraMap (Polynomial Ω) Bs).comp Polynomial.C).toAlgebra
  letI algWB' : Algebra W Bs := ((algebraMap (Polynomial W) Bs).comp Polynomial.C).toAlgebra
  letI algWC : Algebra W Cs := ((algebraMap (Polynomial W) Cs).comp Polynomial.C).toAlgebra
  haveI tWCB : IsScalarTower W Cs Bs := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  haveI tWΩB : IsScalarTower W Ω Bs := IsScalarTower.of_algebraMap_eq (fun x => by
    show algebraMap (Polynomial Ω) Bs (Polynomial.map W.subtype (Polynomial.C x)) =
      algebraMap (Polynomial Ω) Bs (Polynomial.C (algebraMap W Ω x))
    rw [Polynomial.map_C]; rfl)
  haveI tWWC : IsScalarTower W (Polynomial W) Cs := IsScalarTower.of_algebraMap_eq (fun x => by
    rw [Polynomial.algebraMap_eq]; rfl)
  haveI tΩΩB : IsScalarTower Ω (Polynomial Ω) Bs := IsScalarTower.of_algebraMap_eq (fun x => by
    rw [Polynomial.algebraMap_eq]; rfl)
  have h1 : Function.Injective (algebraMap Cs Bs) := Subtype.val_injective
  have h2 : Algebra.FiniteType W Cs := by
    haveI := hCfin
    exact Algebra.FiniteType.trans (S := Polynomial W) inferInstance (Module.Finite.finiteType Cs)
  have h3 : Algebra.FiniteType Ω Bs :=
    Algebra.FiniteType.trans (S := Polynomial Ω) inferInstance (Module.Finite.finiteType Bs)
  have h4 : _root_.IsReduced Bs := isReduced_of_injective Bs.val Subtype.val_injective
  have h5 : ∀ y : Bs, ∃ c : W, c ≠ 0 ∧ ∃ a : Cs, algebraMap W Bs c * y = algebraMap Cs Bs a := by
    intro y
    obtain ⟨c', hc'0, hmem⟩ := hb_gen y
    refine ⟨c', hc'0, ⟨_, hmem⟩, ?_⟩
    show algebraMap (Polynomial Ω) Bs (Polynomial.map W.subtype (Polynomial.C c')) * y = _
    rw [Polynomial.map_C]; rfl
  have hFT : Algebra.FiniteType Cs (integralClosure Cs Bs) :=
    wcpa_dj_lr1s_nf_flat_model_normalization_finite Ω W hW Cs Bs h1 h2 h3 h4 h5
  obtain ⟨r, e, he_int, he_rep⟩ := s5 (Polynomial W) Cs Bs hCfin hFT

  letI algWM : Algebra (Polynomial W) M := ((algebraMap (RatFunc Ω) M).comp
    ((algebraMap (Polynomial Ω) (RatFunc Ω)).comp (Polynomial.mapRingHom W.subtype))).toAlgebra
  let Φ : Bs →ₐ[Polynomial W] M :=
    { toRingHom := Bs.val.toRingHom
      commutes' := fun _ => rfl }
  have hΦ : Function.Injective Φ := Subtype.val_injective
  refine ⟨r, fun i => (e i : M), fun i => ⟨(isIntegral_algHom_iff Φ hΦ).2 (he_int i),
    ((hBmem _).1 (e i).2).2⟩, ?_⟩
  intro x hx hfix
  have hxΩ : IsIntegral (Polynomial Ω) x :=
    IsIntegral.map_of_comp_eq (Polynomial.mapRingHom W.subtype) (RingHom.id M)
      (RingHom.ext fun _ => rfl) hx
  let xB : Bs := ⟨x, (hBmem x).2 ⟨hxΩ, hfix⟩⟩
  have hxB : IsIntegral (Polynomial W) xB := (isIntegral_algHom_iff Φ hΦ).1 hx
  obtain ⟨q, hq⟩ := he_rep xB hxB
  refine ⟨q, ?_⟩
  have h := congrArg Φ hq
  rw [map_sum] at h
  simp only [map_mul, AlgHom.commutes] at h
  exact h

theorem wcpa_dj_lr1k_nis_localize_to_gauss : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (V : ValuationSubring (RatFunc Ω)), V.toSubring = wcEbGauss W → ∀ (M : Type u) [Field M] [Algebra (RatFunc Ω) M] (P : M → Prop), (∀ (f : RatFunc Ω) (x : M), P x → P (algebraMap (RatFunc Ω) M f * x)) → letI : Algebra (Polynomial ↥W) M := ((algebraMap (RatFunc Ω) M).comp ((algebraMap (Polynomial Ω) (RatFunc Ω)).comp (Polynomial.mapRingHom W.subtype))).toAlgebra; letI : Algebra V M := ((algebraMap (RatFunc Ω) M).comp V.subtype).toAlgebra; ∀ (r : ℕ) (g : Fin r → M), (∀ i, IsIntegral (Polynomial ↥W) (g i)) → (∀ x : M, IsIntegral (Polynomial ↥W) x → P x → ∃ q : Fin r → Polynomial ↥W, x = ∑ i, algebraMap (Polynomial ↥W) M (q i) * g i) → (∀ i, IsIntegral V (g i)) ∧ ∀ x : M, IsIntegral V x → P x → ∃ c : Fin r → V, x = ∑ i, algebraMap (RatFunc Ω) M (c i : RatFunc Ω) * g i :=
by
  intro Ω _ W V hV M _ _ P hP
  letI : Algebra (Polynomial ↥W) M := ((algebraMap (RatFunc Ω) M).comp ((algebraMap (Polynomial Ω) (RatFunc Ω)).comp (Polynomial.mapRingHom W.subtype))).toAlgebra
  letI : Algebra V M := ((algebraMap (RatFunc Ω) M).comp V.subtype).toAlgebra
  intro r g hg hrep
  classical
  obtain ⟨ι, hι⟩ : ∃ ι : Polynomial ↥W →+* RatFunc Ω,
      ι = (algebraMap (Polynomial Ω) (RatFunc Ω)).comp (Polynomial.mapRingHom W.subtype) :=
    ⟨_, rfl⟩
  have hιapp : ∀ q : Polynomial ↥W,
      ι q = algebraMap (Polynomial Ω) (RatFunc Ω) (q.map W.subtype) := by
    intro q; rw [hι]; rfl
  have halgc : algebraMap (Polynomial ↥W) M = (algebraMap (RatFunc Ω) M).comp ι := by
    rw [hι]; rfl
  have halg : ∀ q : Polynomial ↥W, algebraMap (Polynomial ↥W) M q = algebraMap (RatFunc Ω) M (ι q) := by
    intro q; rw [halgc]; rfl

  have unit_iff : ∀ h : Polynomial ↥W,
      (∃ i, IsUnit (h.coeff i)) ↔ h.map (IsLocalRing.residue ↥W) ≠ 0 := by
    intro h
    constructor
    · rintro ⟨i, hi⟩ h0
      have := congrArg (fun p => p.coeff i) h0
      simp only [Polynomial.coeff_map, Polynomial.coeff_zero] at this
      exact (IsLocalRing.residue_ne_zero_iff_isUnit _).mpr hi this
    · intro h0
      by_contra hcon
      push_neg at hcon
      apply h0
      ext i
      simp only [Polynomial.coeff_map, Polynomial.coeff_zero]
      by_contra hne
      exact hcon i ((IsLocalRing.residue_ne_zero_iff_isUnit _).mp hne)
  have gauss : ∀ p q : Polynomial ↥W, (∃ i, IsUnit (p.coeff i)) → (∃ j, IsUnit (q.coeff j)) →
      ∃ k, IsUnit ((p * q).coeff k) := by
    intro p q hp hq
    rw [unit_iff] at hp hq ⊢
    rw [Polynomial.map_mul]
    exact mul_ne_zero hp hq
  have hT1 : ∃ i, IsUnit ((1 : Polynomial ↥W).coeff i) := ⟨0, by simp⟩

  have hA : ∀ q : Polynomial ↥W, (∃ i, IsUnit (q.coeff i)) → q.map W.subtype ≠ 0 := by
    rintro q ⟨i, hi⟩ h0
    have := congrArg (fun p => p.coeff i) h0
    simp only [Polynomial.coeff_map, Polynomial.coeff_zero] at this
    exact hi.ne_zero (Subtype.ext (by simpa using this))

  have hmemV : ∀ f, f ∈ V ↔ f ∈ wcEbGauss W := by
    intro f; rw [← hV]; exact Iff.rfl
  have mem_iff : ∀ f : RatFunc Ω, f ∈ V ↔
      ∃ p q : Polynomial ↥W, (∃ i, IsUnit (q.coeff i)) ∧ f * ι q = ι p := by
    intro f
    rw [hmemV]
    constructor
    · intro hf
      unfold wcEbGauss at hf
      induction hf using Subring.closure_induction with
      | mem x hx =>
        obtain ⟨p, q, hq, _, h⟩ := hx
        exact ⟨p, q, hq, by rw [hιapp, hιapp]; exact h⟩
      | zero => exact ⟨0, 1, hT1, by simp⟩
      | one => exact ⟨1, 1, hT1, by simp⟩
      | neg x _ ih =>
        obtain ⟨p, q, hq, h⟩ := ih
        exact ⟨-p, q, hq, by rw [map_neg, neg_mul, h]⟩
      | add x y _ _ ihx ihy =>
        obtain ⟨p1, q1, hq1, h1⟩ := ihx
        obtain ⟨p2, q2, hq2, h2⟩ := ihy
        refine ⟨p1 * q2 + p2 * q1, q1 * q2, gauss q1 q2 hq1 hq2, ?_⟩
        rw [map_add, map_mul, map_mul, map_mul, ← h1, ← h2]; ring
      | mul x y _ _ ihx ihy =>
        obtain ⟨p1, q1, hq1, h1⟩ := ihx
        obtain ⟨p2, q2, hq2, h2⟩ := ihy
        refine ⟨p1 * p2, q1 * q2, gauss q1 q2 hq1 hq2, ?_⟩
        rw [map_mul, map_mul, ← h1, ← h2]; ring
    · rintro ⟨p, q, hq, h⟩
      exact Subring.subset_closure ⟨p, q, hq, hA q hq, by rw [← hιapp, ← hιapp]; exact h⟩
  have hιV : ∀ q, ι q ∈ V := fun q => (mem_iff _).mpr ⟨q, 1, hT1, by simp⟩
  refine ⟨?_, ?_⟩
  ·
    intro i
    let φ : Polynomial ↥W →+* V := ι.codRestrict V hιV
    have hcomp : (algebraMap V M).comp φ = (RingHom.id M).comp (algebraMap (Polynomial ↥W) M) := by
      apply RingHom.ext
      intro q
      rw [RingHom.comp_apply, RingHom.comp_apply, RingHom.id_apply, halg]
      rfl
    exact IsIntegral.map_of_comp_eq φ (RingHom.id M) hcomp (hg i)
  ·
    intro x hx hPx
    obtain ⟨Pm, hmon, heval⟩ := hx
    have hc : ∀ k, ∃ p q : Polynomial ↥W, (∃ i, IsUnit (q.coeff i)) ∧
        ((Pm.coeff k : V) : RatFunc Ω) * ι q = ι p := fun k => (mem_iff _).mp (Pm.coeff k).2
    choose pk qk hqk hpk using hc
    obtain ⟨n, hn⟩ : ∃ n, n = Pm.natDegree := ⟨_, rfl⟩
    obtain ⟨Q, hQ⟩ : ∃ Q, Q = ∏ k ∈ Finset.range n, qk k := ⟨_, rfl⟩
    have hQT : ∃ i, IsUnit (Q.coeff i) := by
      rw [hQ]
      exact Finset.prod_induction _ (fun q : Polynomial ↥W => ∃ i, IsUnit (q.coeff i)) gauss hT1
        (fun k _ => hqk k)
    have hs : ι Q ≠ 0 := by
      rw [hιapp]; exact RatFunc.algebraMap_ne_zero (hA Q hQT)
    set PK : Polynomial (RatFunc Ω) := Pm.map V.subtype with hPK
    have hPKmon : PK.Monic := hmon.map V.subtype
    have hPKdeg : PK.natDegree = n := by rw [hn]; exact hmon.natDegree_map V.subtype
    have hPKcoeff : ∀ k, PK.coeff k = ((Pm.coeff k : V) : RatFunc Ω) := by
      intro k; rw [hPK, Polynomial.coeff_map]; rfl
    have hPKeval : Polynomial.eval₂ (algebraMap (RatFunc Ω) M) x PK = 0 := by
      rw [hPK, Polynomial.eval₂_map]; exact heval
    have hSeval := Polynomial.scaleRoots_eval₂_eq_zero (algebraMap (RatFunc Ω) M) (s := ι Q) hPKeval
    have hSmon : (PK.scaleRoots (ι Q)).Monic := (Polynomial.monic_scaleRoots_iff (ι Q)).mpr hPKmon
    have hlifts : PK.scaleRoots (ι Q) ∈ Polynomial.lifts ι := by
      rw [Polynomial.lifts_iff_coeff_lifts]
      intro i
      rw [Polynomial.coeff_scaleRoots, hPKdeg, hPKcoeff]
      rcases lt_trichotomy i n with hi | hi | hi
      · obtain ⟨m, e1⟩ : ∃ m, n - i = m + 1 := ⟨n - i - 1, by omega⟩
        refine ⟨pk i * (∏ j ∈ (Finset.range n).erase i, qk j) * Q ^ m, ?_⟩
        have e2 : ι Q = ι (qk i) * ι (∏ j ∈ (Finset.range n).erase i, qk j) := by
          rw [← map_mul, Finset.mul_prod_erase _ _ (Finset.mem_range.mpr hi), hQ]
        rw [map_mul, map_mul, map_pow, ← hpk i, e1, pow_succ, e2]
        ring
      · refine ⟨1, ?_⟩
        subst hi
        have h1 : Pm.coeff Pm.natDegree = 1 := hmon.coeff_natDegree
        rw [hn, h1]
        simp
      · refine ⟨0, ?_⟩
        have h0 : Pm.coeff i = 0 := Polynomial.coeff_eq_zero_of_natDegree_lt (by omega)
        rw [h0]
        simp
    obtain ⟨R, hRmap, _, hRmon⟩ := Polynomial.lifts_and_natDegree_eq_and_monic hlifts hSmon
    have hyint : IsIntegral (Polynomial ↥W) (algebraMap (RatFunc Ω) M (ι Q) * x) := by
      refine ⟨R, hRmon, ?_⟩
      rw [halgc, ← Polynomial.eval₂_map, hRmap]
      exact hSeval
    obtain ⟨h, hy⟩ := hrep _ hyint (hP (ι Q) x hPx)
    have hcmem : ∀ i, ι (h i) / ι Q ∈ V := fun i =>
      (mem_iff _).mpr ⟨h i, Q, hQT, div_mul_cancel₀ _ hs⟩
    refine ⟨fun i => ⟨ι (h i) / ι Q, hcmem i⟩, ?_⟩
    have has : algebraMap (RatFunc Ω) M (ι Q) ≠ 0 := (map_ne_zero _).mpr hs
    apply mul_left_cancel₀ has
    rw [hy, Finset.mul_sum]
    refine Finset.sum_congr rfl fun i _ => ?_
    have e : ι Q * (ι (h i) / ι Q) = ι (h i) := mul_div_cancel₀ _ hs
    rw [halg, ← mul_assoc, ← map_mul]
    show _ = algebraMap (RatFunc Ω) M (ι Q * (ι (h i) / ι Q)) * g i
    rw [e]

theorem wcpa_dj_lr1k_nis_unit_at_center : ∀ (K : Type u) [Field K] (O : ValuationSubring K) (M : Type u) [Field M] [Algebra K M] [FiniteDimensional K M] [IsGalois K M] (V' : ValuationSubring M), V'.comap (algebraMap K M) = O → letI : Algebra O M := ((algebraMap K M).comp O.subtype).toAlgebra; ∃ b : M, IsIntegral O b ∧ V'.valuation (b - 1) < 1 ∧ ∀ σ : M ≃ₐ[K] M, (∀ x : M, σ x ∈ V' ↔ x ∈ V') ∨ V'.valuation (σ b) < 1 :=
by
  intro K _ O M _ _ _ _ V' hV'
  letI algO : Algebra O M := ((algebraMap K M).comp O.subtype).toAlgebra
  classical
  have F2 : ∀ (A : ValuationSubring M) (x : M), A.valuation x < 1 ↔ (x = 0 ∨ x⁻¹ ∉ A) := by
    intro A x
    by_cases hx : x = 0
    · simp [hx]
    · have h1 := A.valuation.one_lt_val_iff (inv_ne_zero hx)
      rw [inv_inv] at h1
      rw [← h1, ← A.valuation_le_one_iff, not_le]
      simp [hx]
  have F3 : ∀ (A : ValuationSubring M) (x : M),
      A.valuation x = 1 ↔ (x ∈ A ∧ ¬ A.valuation x < 1) := by
    intro A x
    constructor
    · intro h
      refine ⟨(A.valuation_le_one_iff x).1 h.le, ?_⟩
      rw [h]; exact lt_irrefl 1
    · rintro ⟨h1, h2⟩
      exact le_antisymm ((A.valuation_le_one_iff x).2 h1) (not_lt.1 h2)
  obtain ⟨s, τ, hcov, hinc, -⟩ := wcpa_dj_lr1k_grc_conjugate_reps K M V'
  obtain ⟨hconj, hinv⟩ := wcpa_dj_lr1k_grc_integral_iff_conj K O M V' hV'
  obtain ⟨U, hmemU⟩ : ∃ U : Fin s → ValuationSubring M, ∀ j x, x ∈ U j ↔ τ j x ∈ V' :=
    ⟨fun j => V'.comap ((τ j : M ≃ₐ[K] M) : M →+* M), fun j x => Iff.rfl⟩
  have tlt : ∀ j x, (U j).valuation x < 1 ↔ V'.valuation (τ j x) < 1 := by
    intro j x
    rw [F2, F2, hmemU, map_inv₀, map_eq_zero]
  have teq : ∀ j x, (U j).valuation x = 1 ↔ V'.valuation (τ j x) = 1 := by
    intro j x
    rw [F3, F3, hmemU, tlt]
  have hintU : ∀ x, IsIntegral O x ↔ ∀ l, x ∈ U l := by
    intro x
    rw [hconj]
    constructor
    · intro h l; exact (hmemU l x).2 (h (τ l))
    · intro h σ
      obtain ⟨j, hj⟩ := hcov σ
      exact (hj x).2 ((hmemU j x).1 (h j))
  have hU_inc : ∀ i j, U i ≤ U j → i = j := by
    intro i j hij
    apply hinc i j
    intro x hx
    exact (hmemU j x).1 (hij ((hmemU i x).2 hx))
  have hU_inv : ∀ i (t : M), (∀ l, t ∈ U l) → (U i).valuation t = 1 →
      ∃ r : M, (∀ l, r ∈ U l) ∧ (U i).valuation (r * t - 1) < 1 := by
    intro i t ht hti
    have htint : IsIntegral O t := (hintU t).2 ht
    obtain ⟨r, hr, hrv⟩ := hinv (τ i) t htint ((teq i t).1 hti)
    refine ⟨r, (hintU r).1 hr, ?_⟩
    rw [tlt, map_sub, map_mul, map_one]
    exact hrv
  obtain ⟨j0, hj0⟩ := hcov 1
  have hUj0 : U j0 = V' := by
    ext x
    rw [hmemU, ← hj0 x, AlgEquiv.one_apply]
  obtain ⟨b, hbU, hb1, hbj⟩ :=
    wcpa_dj_lr1k_grc_approx_lift M s U hU_inc hU_inv j0 1 (one_mem _)
  refine ⟨b, (hintU b).2 hbU, ?_, ?_⟩
  · rw [hUj0] at hb1
    exact hb1
  · intro σ
    obtain ⟨j, hj⟩ := hcov σ
    by_cases hjj : j = j0
    · subst hjj
      left
      intro x
      rw [hj x, ← hmemU, hUj0]
    · right
