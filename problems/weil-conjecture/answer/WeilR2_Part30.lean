      have hlc : Q.reverse.leadingCoeff = Q.coeff 0 := by
        rw [Polynomial.reverse_leadingCoeff, Polynomial.trailingCoeff, htd]
      refine ⟨Polynomial.C (↑hunit.unit⁻¹ : ↥V₀) * Q.reverse,
