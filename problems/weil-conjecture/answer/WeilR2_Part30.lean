      by_cases hp : Polynomial.eval₂ ((algebraMap (RatFunc Ω) L).comp
          (algebraMap Ω (RatFunc Ω))) (η b) p = 0
      · refine ⟨0, 1, by simp, ?_⟩
        rw [e1, hp, zero_div, inv_zero]
