  intro a ha0 ham hθa
  letI : Algebra ↥(wcEbRing W a) L :=
    ((algebraMap (RatFunc Ω) L).comp (wcEbRing W a).subtype).toAlgebra
  intro c hc O hO V' hV' 𝔮 _ h𝔮 b hb1 hb2 hb3
  have ha0' : (a : Ω) ≠ 0 := fun h => ha0 (Subtype.ext h)
  have hav : W.valuation (a : Ω) < 1 := (ValuationSubring.valuation_lt_one_iff W a).mp ham
