  have s_euler : ∀ (N B : Type u) [CommRing N] [IsDomain N] [IsIntegrallyClosed N] [CommRing B] [IsDomain B] (ψ : N →+* B), Function.Injective ψ → ∀ (ζ : B) (f : Polynomial N), f.Monic → Polynomial.eval₂ ψ ζ f = 0 → (∀ p : Polynomial N, Polynomial.eval₂ ψ ζ p = 0 → f ∣ p) → (∀ z : B, ∃ (p : Polynomial N) (d : N), d ≠ 0 ∧ ψ d * z = Polynomial.eval₂ ψ ζ p) → Polynomial.eval₂ ψ ζ (Polynomial.derivative f) ≠ 0 → ∀ z : B, ψ.IsIntegralElem z → ∃ p : Polynomial N, Polynomial.eval₂ ψ ζ (Polynomial.derivative f) * z = Polynomial.eval₂ ψ ζ p := by
