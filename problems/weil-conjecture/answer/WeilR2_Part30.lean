        (Scheme.ΓSpecIso (.of ↥W)).hom.hom ((σ.appLE V ⊤ e).hom z) := fun _ _ _ => rfl
  have hpre : ∀ (σ : Spec (.of ↥W) ⟶ X), σ (IsLocalRing.closedPoint ↥W) ∈ V →
