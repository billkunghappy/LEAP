  have wcpa_dj_mscc_cc_normalized_section_algebra : ∀ {R A B : Type u} [CommRing R] [CommRing A] [CommRing B] (g : MvPolynomial (Fin 1) R →+* A) (θ : A →+* B), g.Etale → Function.Bijective (θ.comp (g.comp MvPolynomial.C)) → (RingHom.ker θ).FG → ∃ (g' : MvPolynomial (Fin 1) R →+* A) (r : A), g'.Etale ∧ g'.comp MvPolynomial.C = g.comp MvPolynomial.C ∧ θ (g' (MvPolynomial.X 0)) = 0 ∧ θ r = 1 ∧ ∀ x ∈ RingHom.ker θ, ∃ y : A, r * x = y * g' (MvPolynomial.X 0) := by
