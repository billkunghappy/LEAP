        rwa [hf₀, Polynomial.eval₂_C] at this



  have pf : ∀ D : Polynomial K, D ≠ 0 → ∃ (μ : K) (D₁ : Polynomial ↥V₀), μ ≠ 0 ∧
      (∃ i, IsUnit (D₁.coeff i)) ∧ D = Polynomial.C μ * D₁.map V₀.subtype := by
    intro D hD0
    have hsupp : D.support.Nonempty := Polynomial.support_nonempty.mpr hD0
    obtain ⟨i₀, hi₀, hmax⟩ :=
      Finset.exists_max_image D.support (fun i => V₀.valuation (D.coeff i)) hsupp
    set μ := D.coeff i₀ with hμ
    have hμ0 : μ ≠ 0 := Polynomial.mem_support_iff.mp hi₀
    have hcoef : ∀ n, (Polynomial.C μ⁻¹ * D).coeff n ∈ Set.range V₀.subtype := by
      intro n
      rw [Polynomial.coeff_C_mul]
      refine ⟨⟨μ⁻¹ * D.coeff n, ?_⟩, rfl⟩
      rw [← V₀.valuation_le_one_iff, map_mul, map_inv₀]
      by_cases hn : n ∈ D.support
