    exact (V'.valuation_eq_one_iff _).mp hu

  obtain ⟨d, hd⟩ : ∃ d : Ω, d = c / γ ^ e b := ⟨_, rfl⟩
  have hdd : d * d = 1 := by
    have h1 : γ ^ e b * γ ^ e b = (a : Ω) := by rw [← mul_pow, hγγ, hge]
    rw [hd, div_mul_div_comm, hc, h1, div_self ha0']
  have hXL : algebraMap (RatFunc Ω) L RatFunc.X = η b ^ e b * u b := hMoBD.2.2.2.2.1 b
  have hs' : s = algebraMap (RatFunc Ω) L RatFunc.X * ι c⁻¹ := by
    rw [hs, map_mul]; rfl
  have htw : t ^ e b * u b = ι d * s := by
    rw [hs', hXL, ht, hd, map_div₀, map_pow, map_inv₀, div_pow]
    have hγe : ι γ ^ e b ≠ 0 := pow_ne_zero _ hιγ
    field_simp
    try ring

  have ht5 := wcpa_dj_lr1k_eb_pd_eg_residue_transfer Ω W L V' ι hG2 s t (u b) d (e b)
    (hMoBD.2.2.1 b) hdd htw hb1 hG3
  have hcrit := wcpa_dj_lr1k_eb_pd_eg_coeff_criterion Ω W L V' ι hG2 t ht5

  apply le_antisymm
  · intro f hf
    have hf' : f ∈ V'.comap ψ := hf
    rw [ValuationSubring.mem_comap] at hf'
    have hD0 : f.denom ≠ 0 := f.denom_ne_zero
    obtain ⟨μ, D₁, hμ0, hD₁u, hD⟩ := wcpa_dj_lr1k_eb_pd_eg_primitive_factor Ω W f.denom hD0
    have hA0 : algebraMap (Polynomial Ω) (RatFunc Ω) f.denom ≠ 0 :=
      (map_ne_zero_iff _ (RatFunc.algebraMap_injective Ω)).mpr hD0
    have hfeq : f * algebraMap (Polynomial Ω) (RatFunc Ω) f.denom =
        algebraMap (Polynomial Ω) (RatFunc Ω) f.num :=
      ((div_eq_iff hA0).mp (RatFunc.num_div_denom f)).symm
    have hC : algebraMap (Polynomial Ω) (RatFunc Ω) (Polynomial.C μ⁻¹) *
        algebraMap (Polynomial Ω) (RatFunc Ω) (Polynomial.C μ) = 1 := by
      rw [← map_mul, ← Polynomial.C_mul, inv_mul_cancel₀ hμ0, Polynomial.C_1, map_one]
    have hfeq1 : f * algebraMap (Polynomial Ω) (RatFunc Ω) (D₁.map W.subtype) =
        algebraMap (Polynomial Ω) (RatFunc Ω) (Polynomial.C μ⁻¹ * f.num) := by
      rw [map_mul, ← hfeq, hD, map_mul]
      linear_combination
        (-(f * algebraMap (Polynomial Ω) (RatFunc Ω) (Polynomial.map W.subtype D₁))) * hC
    have h1 := congrArg ψ hfeq1
    rw [map_mul, hG1, hG1] at h1
    have hD1V : Polynomial.eval₂ ι t (D₁.map W.subtype) ∈ V' :=
      (hcrit _).mpr (fun j => by rw [Polynomial.coeff_map]; exact (D₁.coeff j).2)
    have hNV : Polynomial.eval₂ ι t (Polynomial.C μ⁻¹ * f.num) ∈ V' := by
      rw [← h1]; exact mul_mem hf' hD1V
    have hN := (hcrit _).mp hNV
    obtain ⟨p, hp⟩ := (Polynomial.mem_lifts _).mp
      ((Polynomial.lifts_iff_coeff_lifts (f := W.subtype) _).mpr (fun n => ⟨⟨_, hN n⟩, rfl⟩))
    have hD₁0 : D₁.map W.subtype ≠ 0 := fun h => hD0 (by rw [hD, h, mul_zero])
    unfold wcEbGauss
    apply Subring.subset_closure
    exact ⟨p, D₁, hD₁u, hD₁0, by rw [hp]; exact hfeq1⟩
  · unfold wcEbGauss
    rw [Subring.closure_le]
    rintro f ⟨p, q, hqu, hq0, hfpq⟩
    show f ∈ V'.comap ψ
    rw [ValuationSubring.mem_comap]
    have h1 := congrArg ψ hfpq
    rw [map_mul, hG1, hG1, Polynomial.eval₂_map, Polynomial.eval₂_map] at h1
    have hQ := ht5 q hqu
    have hP : Polynomial.eval₂ (ι.comp W.subtype) t p ∈ V' := by
      have h2 := (hcrit (p.map W.subtype)).mpr
        (fun j => by rw [Polynomial.coeff_map]; exact (p.coeff j).2)
      rwa [Polynomial.eval₂_map] at h2
    rw [← h1] at hP
    have hv := (V'.valuation_le_one_iff _).mpr hP
    rw [Valuation.map_mul, hQ, mul_one] at hv
    exact (V'.valuation_le_one_iff _).mp hv

theorem wcpa_dj_lr1k_eb_eg_sep_zeta_free : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (L : Type u) [Field L] [Algebra (RatFunc Ω) L] [FiniteDimensional (RatFunc Ω) L]
      [Algebra.IsSeparable (RatFunc Ω) L],
    wcEbDefectless W L → wcEbAnGaussStr W L →
    ∀ (m : ℕ) (U : Fin m → ValuationSubring L) (e : Fin m → ℕ) (η u : Fin m → L),
    wcEbMoBD W L m U e η u →
    ∀ a : ↥W, a ≠ 0 → a ∈ IsLocalRing.maximalIdeal ↥W →
      ∀ c : Ω, c * c = (a : Ω) →
      ∀ O : ValuationSubring (RatFunc Ω), (∀ f : RatFunc Ω, f ∈ O ↔ wcEbAnInOc W c f) →
      ∀ V' : ValuationSubring L, V'.comap (algebraMap (RatFunc Ω) L) = O →
      ∀ b : Fin m, V'.valuation (u b - 1) < 1 →
        V'.valuation (η b) ^ e b = V'.valuation (algebraMap (RatFunc Ω) L RatFunc.X) →
        (∀ b', b' ≠ b → V'.valuation (η b') = 1) →
      ∀ g : ↥W, g ∈ IsLocalRing.maximalIdeal ↥W → g ≠ 0 → (g : Ω) ^ e b = (a : Ω) →
        (∀ p : Polynomial Ω, Polynomial.eval₂
          ((algebraMap (RatFunc Ω) L).comp (algebraMap Ω (RatFunc Ω))) (η b) p = 0 → p = 0) →
      ∀ [FiniteDimensional ↥(wcEgKp Ω L (η b)) L] [Algebra.IsSeparable ↥(wcEgKp Ω L (η b)) L],
      letI : Algebra ↥(V'.comap (algebraMap ↥(wcEgKp Ω L (η b)) L)) L :=
        ((algebraMap ↥(wcEgKp Ω L (η b)) L).comp
          (V'.comap (algebraMap ↥(wcEgKp Ω L (η b)) L)).subtype).toAlgebra
      Module.Free ↥(V'.comap (algebraMap ↥(wcEgKp Ω L (η b)) L))
          ↥(integralClosure ↥(V'.comap (algebraMap ↥(wcEgKp Ω L (η b)) L)) L) ∧
        Module.finrank ↥(V'.comap (algebraMap ↥(wcEgKp Ω L (η b)) L))
          ↥(integralClosure ↥(V'.comap (algebraMap ↥(wcEgKp Ω L (η b)) L)) L) =
          Module.finrank ↥(wcEgKp Ω L (η b)) L :=
by
  classical
  intro Ω _ _ W hdim hW L _ _ _ _ hdef hGS m U e η u hMoBD a ha0 ham c hc O hO V' hV' b hb1 hb2
    hb3 g hgm hg0 hge htr _ _

  have htrans : ∀ (A B : Type u) [CommRing A] [CommRing B] [Algebra A L] [Algebra B L]
      (f : A ≃+* B), (∀ a, algebraMap B L (f a) = algebraMap A L a) →
      Module.Free A (integralClosure A L) → Module.Free B (integralClosure B L) ∧
        Module.finrank B (integralClosure B L) = Module.finrank A (integralClosure A L) := by
    intro A B _ _ _ _ f hf hfree
    have hf' : ∀ b, algebraMap A L (f.symm b) = algebraMap B L b := fun b => by
      rw [← hf, f.apply_symm_apply]
    have hiff : ∀ z : L, IsIntegral A z ↔ IsIntegral B z := by
      intro z
      constructor
      · intro h
        exact IsIntegral.map_of_comp_eq (f : A →+* B) (RingHom.id L)
          (RingHom.ext fun a => by simp [hf]) h
      · intro h
        exact IsIntegral.map_of_comp_eq (f.symm : B →+* A) (RingHom.id L)
          (RingHom.ext fun b => by simp [hf']) h
    let j : integralClosure A L ≃+ integralClosure B L :=
      { toFun := fun m => ⟨(m : L), (hiff m).1 m.2⟩
        invFun := fun n => ⟨(n : L), (hiff n).2 n.2⟩
        left_inv := fun m => rfl
        right_inv := fun n => rfl
        map_add' := fun m n => rfl }
    have hj : ∀ (r : A) (m : integralClosure A L), j (r • m) = f r • j m := by
      intro r m
      apply Subtype.ext
      show r • (m : L) = f r • (m : L)
      rw [Algebra.smul_def, Algebra.smul_def, hf]
    have hjs : ∀ (c : B) (n : integralClosure B L), j.symm (c • n) = f.symm c • j.symm n := by
      intro c n
      apply j.injective
      rw [hj, AddEquiv.apply_symm_apply, AddEquiv.apply_symm_apply, RingEquiv.apply_symm_apply]
    have hrank : Module.rank A (integralClosure A L) = Module.rank B (integralClosure B L) :=
      rank_eq_of_equiv_equiv f j f.bijective hj
    refine ⟨?_, ?_⟩
    · let bs := Module.Free.chooseBasis A (integralClosure A L)
      let e0 : integralClosure B L ≃+
          (Module.Free.ChooseBasisIndex A (integralClosure A L) →₀ B) :=
        j.symm.trans (bs.repr.toAddEquiv.trans (Finsupp.mapRange.addEquiv f.toAddEquiv))
      have he0 : ∀ (c : B) (n : integralClosure B L), e0 (c • n) = c • e0 n := by
        intro c n
        ext i
        simp only [e0, AddEquiv.trans_apply, hjs, LinearEquiv.coe_toAddEquiv,
          Finsupp.mapRange.addEquiv_apply, Finsupp.mapRange_apply, Finsupp.smul_apply, smul_eq_mul,
          RingEquiv.toAddEquiv_eq_coe, RingEquiv.coe_toAddEquiv]
        have h1 : bs.repr (f.symm c • j.symm n) = f.symm c • bs.repr (j.symm n) :=
          map_smul bs.repr _ _
        change f (bs.repr (f.symm c • j.symm n) i) = c * f (bs.repr (j.symm n) i)
        rw [h1, Finsupp.smul_apply, smul_eq_mul, map_mul, RingEquiv.apply_symm_apply]
      exact Module.Free.of_basis (Module.Basis.ofRepr (e0.toLinearEquiv he0))
    · unfold Module.finrank
      rw [hrank]

  obtain ⟨γ, hγ⟩ := IsAlgClosed.exists_pow_nat_eq (g : Ω) two_pos
  have hγγ : γ * γ = (g : Ω) := by rw [← hγ]; ring
  have hg0' : (g : Ω) ≠ 0 := fun h => hg0 (Subtype.ext h)
  have hγ0 : γ ≠ 0 := by
    rintro rfl
    apply hg0'
    rw [← hγγ, zero_mul]
  let ι : Ω →+* L := (algebraMap (RatFunc Ω) L).comp (algebraMap Ω (RatFunc Ω))
  have hιγ : ι γ ≠ 0 := (map_ne_zero ι).mpr hγ0
  let φ : Polynomial Ω →+* L := Polynomial.eval₂RingHom ι (η b / ι γ)
  have hφeval : ∀ p : Polynomial Ω,
      φ p = Polynomial.eval₂ ι (η b) (p.comp (Polynomial.C γ⁻¹ * Polynomial.X)) := by
    intro p
    show Polynomial.eval₂ ι (η b / ι γ) p = _
    rw [Polynomial.eval₂_comp, Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_X,
      map_inv₀, div_eq_inv_mul]
  have hcompinv : ∀ p : Polynomial Ω,
      (p.comp (Polynomial.C γ⁻¹ * Polynomial.X)).comp (Polynomial.C γ * Polynomial.X) = p := by
    intro p
    rw [Polynomial.comp_assoc, Polynomial.mul_comp, Polynomial.C_comp, Polynomial.X_comp,
      ← mul_assoc, ← Polynomial.C_mul, inv_mul_cancel₀ hγ0, Polynomial.C_1, one_mul,
      Polynomial.comp_X]
  have hφinj : ∀ p : Polynomial Ω, φ p = 0 → p = 0 := by
    intro p hp
    rw [hφeval] at hp
    have h0 := htr _ hp
    rw [← hcompinv p, h0, Polynomial.zero_comp]
  have hφ : nonZeroDivisors (Polynomial Ω) ≤ (nonZeroDivisors L).comap φ := by
    intro p hp
    rw [Submonoid.mem_comap, mem_nonZeroDivisors_iff_ne_zero]
    intro h0
    exact (mem_nonZeroDivisors_iff_ne_zero.mp hp) (hφinj p h0)
  let ψ : RatFunc Ω →+* L := RatFunc.liftRingHom φ hφ
  have hψpoly : ∀ p : Polynomial Ω, ψ (algebraMap (Polynomial Ω) (RatFunc Ω) p) = φ p := by
    intro p
    have h1 := RatFunc.liftRingHom_apply_div φ hφ p 1
    rw [map_one, div_one, map_one, div_one] at h1
    exact h1
  have hψw : ∀ w : Ω, ψ (algebraMap Ω (RatFunc Ω) w) =
      algebraMap (RatFunc Ω) L (algebraMap Ω (RatFunc Ω) w) := by
    intro w
    have h1 : algebraMap Ω (RatFunc Ω) w =
        algebraMap (Polynomial Ω) (RatFunc Ω) (Polynomial.C w) := by
      rw [RatFunc.algebraMap_C, RatFunc.algebraMap_eq_C]
    rw [h1, hψpoly]
    show Polynomial.eval₂ ι (η b / ι γ) (Polynomial.C w) = _
    rw [Polynomial.eval₂_C]
    rfl
  have hψX : ψ RatFunc.X = η b / algebraMap (RatFunc Ω) L (algebraMap Ω (RatFunc Ω) γ) := by
    rw [← RatFunc.algebraMap_X, hψpoly]
    show Polynomial.eval₂ ι (η b / ι γ) Polynomial.X = _
    rw [Polynomial.eval₂_X]
    rfl

  have hG := wcpa_dj_lr1k_eb_pd_eta_gauss Ω W hdim hW L m U e η u hMoBD a ha0 ham c hc O hO V'
    hV' b hb1 hb2 g hgm hg0 hge htr γ hγγ ψ hψw hψX
  have hS := wcpa_dj_lr1k_eb_pd_eta_separable Ω W hdim hW L m U e η u hMoBD b htr γ hγ0 ψ hψw hψX
  have hGV : ∀ x : RatFunc Ω, x ∈ wcEbGauss W ↔ ψ x ∈ V' := fun x => by
    rw [← hG]; exact Iff.rfl

  have hιK : ∀ w : Ω, ι w ∈ wcEgKp Ω L (η b) := fun w =>
    Subfield.subset_closure (Or.inl ⟨w, rfl⟩)
  have hηK : η b ∈ wcEgKp Ω L (η b) := Subfield.subset_closure (Or.inr rfl)
  have hpolyK : ∀ p : Polynomial Ω, φ p ∈ wcEgKp Ω L (η b) := by
    intro p
    show Polynomial.eval₂ ι (η b / ι γ) p ∈ wcEgKp Ω L (η b)
    rw [Polynomial.eval₂_eq_sum_range]
    exact sum_mem (fun i _ => mul_mem (hιK _) (pow_mem (div_mem hηK (hιK γ)) _))
  have hmem : ∀ x : RatFunc Ω, ψ x ∈ wcEgKp Ω L (η b) := by
    intro x
    induction x using RatFunc.induction_on with
    | f p q hq =>
      rw [map_div₀, hψpoly, hψpoly]
      exact div_mem (hpolyK p) (hpolyK q)
  have hle : wcEgKp Ω L (η b) ≤ ψ.fieldRange := by
    unfold wcEgKp
    rw [Subfield.closure_le]
    rintro y (⟨w, rfl⟩ | hy)
    · exact RingHom.mem_fieldRange.mpr ⟨algebraMap Ω (RatFunc Ω) w, hψw w⟩
    · rw [Set.mem_singleton_iff] at hy
      subst hy
      refine RingHom.mem_fieldRange.mpr ⟨algebraMap Ω (RatFunc Ω) γ * RatFunc.X, ?_⟩
      rw [map_mul, hψw, hψX]
      exact mul_div_cancel₀ _ hιγ
  have hsurj : ∀ y : L, y ∈ wcEgKp Ω L (η b) → ∃ x : RatFunc Ω, ψ x = y := fun y hy =>
    RingHom.mem_fieldRange.mp (hle hy)
  set K' := wcEgKp Ω L (η b) with hK'

  let eK : RatFunc Ω ≃+* ↥K' := RingEquiv.ofBijective (ψ.codRestrict K' hmem)
    ⟨fun x y h => ψ.injective (congrArg Subtype.val h), fun y => by
      obtain ⟨x, hx⟩ := hsurj y y.2
      exact ⟨x, Subtype.ext hx⟩⟩
  have hψe : ∀ x, ((eK x : K') : L) = ψ x := fun x => rfl
  have hback : ∀ y : K', ψ (eK.symm y) = (y : L) := fun y => by
    rw [← hψe, eK.apply_symm_apply]

  let eG : ↥(wcEbGauss W) ≃+* ↥(V'.comap (algebraMap ↥K' L)) :=
    { toFun := fun x => ⟨eK x, (hGV x).mp x.2⟩
      invFun := fun y => ⟨eK.symm y, (hGV _).mpr (by rw [hback]; exact y.2)⟩
      left_inv := fun x => Subtype.ext (eK.symm_apply_apply (x : RatFunc Ω))
      right_inv := fun y => Subtype.ext (eK.apply_symm_apply (y : K'))
      map_mul' := fun x y => Subtype.ext (map_mul eK (x : RatFunc Ω) y)
      map_add' := fun x y => Subtype.ext (map_add eK (x : RatFunc Ω) y) }
  letI instV0 : Algebra ↥(V'.comap (algebraMap ↥K' L)) L :=
    ((algebraMap ↥K' L).comp (V'.comap (algebraMap ↥K' L)).subtype).toAlgebra

  letI : Algebra (RatFunc Ω) L := ψ.toAlgebra
  obtain ⟨hFD, hSep⟩ := hS
  haveI := hFD
  haveI := hSep
  have hdef' : wcEbDefectless W L := wcpa_dj_lr1k_eb_gauss_defectless_r1 Ω W hdim hW L
  have hGS' : wcEbAnGaussStr W L := wcpa_dj_lr1k_eb_an_gauss_structure Ω W hdim hW L hdef'
  unfold wcEbAnGaussStr at hGS'
  obtain ⟨hfree, hrank, -, -⟩ := hGS'
  have hfin : Module.finrank (RatFunc Ω) L = Module.finrank ↥K' L :=
    Algebra.finrank_eq_of_equiv_equiv eK (RingEquiv.refl L) (RingHom.ext fun x => rfl)
  have hf : ∀ x : ↥(wcEbGauss W),
      algebraMap ↥(V'.comap (algebraMap ↥K' L)) L (eG x) = algebraMap ↥(wcEbGauss W) L x :=
    fun x => rfl
  obtain ⟨h1, h2⟩ := htrans ↥(wcEbGauss W) ↥(V'.comap (algebraMap ↥K' L)) eG hf hfree
  exact ⟨h1, h2.trans (hrank.trans hfin)⟩

