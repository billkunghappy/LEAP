      by_cases hxi : IsIntegral V x
      · obtain ⟨c, u', v', hxc, huv, hu', hv'⟩ := h5 x hx hxi
        have hc0 : c ≠ 0 := by
          rintro rfl
          apply hx
          rw [hxc, map_zero, zero_mul]
        obtain ⟨j₀, c₂, hc₂⟩ := hdiv c hc0
        refine ⟨j₀, v' * algebraMap V B c₂, hv'.mul isIntegral_algebraMap, ?_⟩
