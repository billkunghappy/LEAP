        have hφP : φ P ∈ 𝔐 := Ideal.mem_map_of_mem φ hP
        have hr := (IsLocalization.AtPrime.to_map_mem_maximal_iff R.toSubring 𝔐 (φ P)).mpr hφP
        have hnu := (IsLocalRing.mem_maximalIdeal _).mp hr
