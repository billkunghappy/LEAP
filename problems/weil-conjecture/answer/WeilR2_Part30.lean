    · exact mem_separableClosure_iff.mp B.gen.2
    · intro i
      refine ⟨fun k => B.basis.repr (s i ^ (q ^ (e - n i))) k, ?_⟩
      rw [hw i]
      conv_lhs => rw [← B.basis.sum_repr (s i ^ (q ^ (e - n i)))]
      rw [IntermediateField.coe_sum]
