theorem wcpa_dj_lr1k_eb_pd_eg_inoc_facts : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (c : Ω), c ≠ 0 → (∀ w : Ω, wcEbAnInOc W c (algebraMap Ω (RatFunc Ω) w) ↔ w ∈ W) ∧ ∀ P : Polynomial ↥W, wcEbAnInOc W c (Polynomial.eval₂ ((algebraMap Ω (RatFunc Ω)).comp W.subtype) (RatFunc.X * algebraMap Ω (RatFunc Ω) c⁻¹) P) ∧ ((∃ i, IsUnit (P.coeff i)) → Polynomial.eval₂ ((algebraMap Ω (RatFunc Ω)).comp W.subtype) (RatFunc.X * algebraMap Ω (RatFunc Ω) c⁻¹) P ≠ 0 ∧ wcEbAnInOc W c (Polynomial.eval₂ ((algebraMap Ω (RatFunc Ω)).comp W.subtype) (RatFunc.X * algebraMap Ω (RatFunc Ω) c⁻¹) P)⁻¹) :=
