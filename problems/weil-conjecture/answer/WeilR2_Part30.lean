    have key : ∀ k : ℕ, ∃ y : AdicCompletion (Ideal.span {t}) V,
        (1 + algebraMap V (AdicCompletion (Ideal.span {t}) V) t * z) * L - 1 =
          algebraMap V (AdicCompletion (Ideal.span {t}) V) t ^ k * y := by
      intro k
      obtain ⟨y, hy⟩ := hL k
      refine ⟨(1 + algebraMap V (AdicCompletion (Ideal.span {t}) V) t * z) * y - (-z) ^ k, ?_⟩
      have hg := mul_neg_geom_sum (-(algebraMap V (AdicCompletion (Ideal.span {t}) V) t * z)) k
      have e : (-(algebraMap V (AdicCompletion (Ideal.span {t}) V) t * z)) ^ k =
          algebraMap V (AdicCompletion (Ideal.span {t}) V) t ^ k * (-z) ^ k := by
        rw [neg_mul_eq_mul_neg, mul_pow]
      linear_combination (1 + algebraMap V (AdicCompletion (Ideal.span {t}) V) t * z) * hy + hg - e
    have h0 := S2 _ key
    exact isUnit_iff_exists_inv.mpr ⟨L, sub_eq_zero.mp h0⟩

  have NF : ∀ x : AdicCompletion (Ideal.span {t}) V, x ≠ 0 → ∃ (c : V) (k : ℕ)
      (μ : AdicCompletion (Ideal.span {t}) V), c ≠ 0 ∧ c ∣ t ^ k ∧ IsUnit μ ∧
        x = algebraMap V (AdicCompletion (Ideal.span {t}) V) c * μ := by
    intro x hx
    have hex : ∃ k : ℕ, ¬ ∃ y : AdicCompletion (Ideal.span {t}) V,
        x = algebraMap V (AdicCompletion (Ideal.span {t}) V) t ^ k * y := by
      by_contra h
      push_neg at h
      exact hx (S2 x h)
    obtain ⟨k, hk⟩ := hex
    obtain ⟨c, y', hcy⟩ := B3 (k + 1) x
    have hnd : ¬ t ^ k ∣ c := by
      rintro ⟨c', rfl⟩
      apply hk
      refine ⟨algebraMap V (AdicCompletion (Ideal.span {t}) V) c' +
        algebraMap V (AdicCompletion (Ideal.span {t}) V) t * y', ?_⟩
      rw [hcy, map_mul, map_pow]
      ring
    have hc0 : c ≠ 0 := by
      rintro rfl
      exact hnd (dvd_zero _)
    have hcd : c ∣ t ^ k := (htot c (t ^ k)).resolve_right hnd
    obtain ⟨w, hw⟩ := hcd
    refine ⟨c, k, 1 + algebraMap V (AdicCompletion (Ideal.span {t}) V) t *
      (algebraMap V (AdicCompletion (Ideal.span {t}) V) w * y'), hc0, ⟨w, hw⟩, hunit _, ?_⟩
    have e : algebraMap V (AdicCompletion (Ideal.span {t}) V) t ^ k =
        algebraMap V (AdicCompletion (Ideal.span {t}) V) c *
          algebraMap V (AdicCompletion (Ideal.span {t}) V) w := by
      rw [← map_pow, hw, map_mul]
    rw [hcy]
    linear_combination (algebraMap V (AdicCompletion (Ideal.span {t}) V) t * y') * e

  haveI hnt : Nontrivial (AdicCompletion (Ideal.span {t}) V) := ⟨⟨0, 1, fun h => by
    have h' : algebraMap V (AdicCompletion (Ideal.span {t}) V) 0 =
        algebraMap V (AdicCompletion (Ideal.span {t}) V) 1 := by
      rw [map_zero, map_one]; exact h
    exact zero_ne_one (inj h')⟩⟩
  haveI hnzd : NoZeroDivisors (AdicCompletion (Ideal.span {t}) V) := ⟨fun {x y} hxy => by
    by_contra h
    push_neg at h
    obtain ⟨hx, hy⟩ := h
    obtain ⟨c, k, μ, hc0, -, hμ, hxe⟩ := NF x hx
    obtain ⟨c', k', μ', hc0', -, hμ', hye⟩ := NF y hy
    have h1 : algebraMap V (AdicCompletion (Ideal.span {t}) V) (c * c') * (μ * μ') = 0 := by
      rw [map_mul, ← hxy, hxe, hye]; ring
    have h2 : algebraMap V (AdicCompletion (Ideal.span {t}) V) (c * c') = 0 :=
      (hμ.mul hμ').mul_left_eq_zero.mp h1
    exact mul_ne_zero hc0 hc0' (inj (h2.trans (map_zero _).symm))⟩
  haveI hdom : IsDomain (AdicCompletion (Ideal.span {t}) V) := NoZeroDivisors.to_isDomain _

  have hB : ∀ x y : AdicCompletion (Ideal.span {t}) V, x ∣ y ∨ y ∣ x := by
    intro x y
    by_cases hx : x = 0
    · right; rw [hx]; exact dvd_zero y
    by_cases hy : y = 0
    · left; rw [hy]; exact dvd_zero x
    obtain ⟨c, k, μ, -, -, hμ, hxe⟩ := NF x hx
    obtain ⟨c', k', μ', -, -, hμ', hye⟩ := NF y hy
    rw [hxe, hye]
    rcases htot c c' with h | h
    · left
      exact hμ.mul_right_dvd.mpr (dvd_mul_of_dvd_left (map_dvd _ h) _)
    · right
      exact hμ'.mul_right_dvd.mpr (dvd_mul_of_dvd_left (map_dvd _ h) _)

  have hC : ∀ x : AdicCompletion (Ideal.span {t}) V, x ≠ 0 →
      ∃ k : ℕ, x ∣ algebraMap V (AdicCompletion (Ideal.span {t}) V) t ^ k := by
    intro x hx
    obtain ⟨c, k, μ, -, hck, hμ, hxe⟩ := NF x hx
    refine ⟨k, ?_⟩
    rw [hxe]
    refine hμ.mul_right_dvd.mpr ?_
    rw [← map_pow]
    exact map_dvd _ hck

  haveI : ValuationRing V := ValuationRing.iff_dvd_total.mpr ⟨fun a b => htot a b⟩
  have hD : Module.Flat V (AdicCompletion (Ideal.span {t}) V) := by
    rw [Module.Flat.flat_iff_torsion_eq_bot_of_isBezout, Submodule.eq_bot_iff]
    intro x hx
    obtain ⟨a, ha⟩ := (Submodule.mem_torsion_iff x).mp hx
    rw [Submonoid.smul_def, Algebra.smul_def] at ha
    have ha0 : algebraMap V (AdicCompletion (Ideal.span {t}) V) (a : V) ≠ 0 := fun h =>
      nonZeroDivisors.coe_ne_zero a (inj (h.trans (map_zero _).symm))
    exact (mul_eq_zero.mp ha).resolve_left ha0
  exact ⟨hdom, hB, hC, hD⟩

theorem wcpa_dj_lr1s_nf_cnf_fmp_gb_dc_completion_map : ∀ (T : Type u) [CommRing T] (P : Ideal T) [P.IsPrime] (t : T), (∀ x : Localization.AtPrime P, algebraMap T (Localization.AtPrime P) t * x = 0 → x = 0) → Module.Flat (Localization.AtPrime P) (AdicCompletion (Ideal.span {algebraMap T (Localization.AtPrime P) t}) (Localization.AtPrime P)) → (∀ s : T, s ∉ P → IsUnit (algebraMap T (AdicCompletion (Ideal.span {algebraMap T (Localization.AtPrime P) t}) (Localization.AtPrime P)) s)) ∧ (∀ (c : ℕ) (x : AdicCompletion (Ideal.span {algebraMap T (Localization.AtPrime P) t}) (Localization.AtPrime P)), ∃ (p s : T) (x' : AdicCompletion (Ideal.span {algebraMap T (Localization.AtPrime P) t}) (Localization.AtPrime P)), s ∉ P ∧ algebraMap T (AdicCompletion (Ideal.span {algebraMap T (Localization.AtPrime P) t}) (Localization.AtPrime P)) s * x = algebraMap T (AdicCompletion (Ideal.span {algebraMap T (Localization.AtPrime P) t}) (Localization.AtPrime P)) p + algebraMap T (AdicCompletion (Ideal.span {algebraMap T (Localization.AtPrime P) t}) (Localization.AtPrime P)) t ^ c * x') ∧ (∀ (τ : T) (k : ℕ) (y : AdicCompletion (Ideal.span {algebraMap T (Localization.AtPrime P) t}) (Localization.AtPrime P)), algebraMap T (AdicCompletion (Ideal.span {algebraMap T (Localization.AtPrime P) t}) (Localization.AtPrime P)) τ = algebraMap T (AdicCompletion (Ideal.span {algebraMap T (Localization.AtPrime P) t}) (Localization.AtPrime P)) t ^ k * y → ∃ (σ r : T), σ ∉ P ∧ σ * τ = t ^ k * r) ∧ Module.Flat T (AdicCompletion (Ideal.span {algebraMap T (Localization.AtPrime P) t}) (Localization.AtPrime P)) :=
by
  intro T _ P _ t htf hflat
  classical
  have basics : ∀ (C : Type u) [CommRing C] (p : C), (∀ x : C, p * x = 0 → x = 0) → (∀ y : AdicCompletion (Ideal.span {p}) C, algebraMap C (AdicCompletion (Ideal.span {p}) C) p * y = 0 → y = 0) ∧ (∀ (n : ℕ) (c : C) (y : AdicCompletion (Ideal.span {p}) C), algebraMap C (AdicCompletion (Ideal.span {p}) C) c = algebraMap C (AdicCompletion (Ideal.span {p}) C) p ^ n * y → ∃ c' : C, c = p ^ n * c') ∧ (∀ (n : ℕ) (y : AdicCompletion (Ideal.span {p}) C), ∃ (c : C) (y' : AdicCompletion (Ideal.span {p}) C), y = algebraMap C (AdicCompletion (Ideal.span {p}) C) c + algebraMap C (AdicCompletion (Ideal.span {p}) C) p ^ n * y') := by
    intro C _ p hp
    have hev : ∀ (k : ℕ) (c : C), AdicCompletion.evalₐ (Ideal.span {p}) k
        (algebraMap C (AdicCompletion (Ideal.span {p}) C) c) =
        Ideal.Quotient.mk (Ideal.span {p} ^ k) c := by
      intro k c
      rw [AlgHom.commutes]
      rfl
    have hmem : ∀ (k : ℕ) (x : C), Ideal.Quotient.mk (Ideal.span {p} ^ k) x = 0 ↔ p ^ k ∣ x := by
      intro k x
      rw [Ideal.Quotient.eq_zero_iff_mem, Ideal.span_singleton_pow, Ideal.mem_span_singleton]
    have hD : ∀ (a : AdicCompletion.AdicCauchySequence (Ideal.span {p}) C) (m k : ℕ), m ≤ k →
        p ^ m ∣ a k - a m := by
      intro a m k hmk
      rw [← hmem, map_sub, sub_eq_zero]
      exact AdicCompletion.Ideal.mk_eq_mk (Ideal.span {p}) hmk a
    have hN : ∀ (n : ℕ) (x : C), p ^ n * x = 0 → x = 0 := by
      intro n
      induction n with
      | zero => intro x h; simpa using h
      | succ n ih =>
        intro x h
        apply ih
        apply hp
        rw [← mul_assoc, ← pow_succ']
        exact h
    have hNc : ∀ (n : ℕ) (u v : C), p ^ n * u = p ^ n * v → u = v := by
      intro n u v h
      rw [← sub_eq_zero]
      apply hN n
      rw [mul_sub, h, sub_self]
    refine ⟨?_, ?_, ?_⟩
    · intro y hy
      obtain ⟨a, rfl⟩ := AdicCompletion.mk_surjective (Ideal.span {p}) C y
      apply AdicCompletion.ext_evalₐ
      intro k
      rw [map_zero, AdicCompletion.evalₐ_mk, hmem]
      have h1 := congrArg (AdicCompletion.evalₐ (Ideal.span {p}) (k + 1)) hy
      rw [map_mul, map_zero, hev, AdicCompletion.evalₐ_mk, ← map_mul, hmem] at h1
      obtain ⟨t, ht⟩ := h1
      have h2 : a (k + 1) = p ^ k * t := by
        apply hNc 1
        rw [pow_one, ht]
        ring
      obtain ⟨s, hs⟩ := hD a k (k + 1) (by omega)
      exact ⟨t - s, by linear_combination h2 - hs⟩
    · intro n c y h
      obtain ⟨a, rfl⟩ := AdicCompletion.mk_surjective (Ideal.span {p}) C y
      have h1 := congrArg (AdicCompletion.evalₐ (Ideal.span {p}) n) h
      rw [map_mul, map_pow, hev, hev, AdicCompletion.evalₐ_mk, ← map_pow, ← map_mul,
        ← sub_eq_zero, ← map_sub, hmem] at h1
      obtain ⟨t, ht⟩ := h1
      exact ⟨a n + t, by linear_combination ht⟩
    · intro n y
      obtain ⟨a, rfl⟩ := AdicCompletion.mk_surjective (Ideal.span {p}) C y
      have hex : ∀ k : ℕ, ∃ b : C, a (k + n) - a n = p ^ n * b :=
        fun k => hD a n (k + n) (by omega)
      choose b hb using hex
      have hB : ∀ k : ℕ, b k ≡ b (k + 1) [SMOD (Ideal.span {p} ^ k • ⊤ : Submodule C C)] := by
        intro k
        rw [SModEq.sub_mem]
        obtain ⟨s, hs⟩ := hD a (k + n) (k + 1 + n) (by omega)
        have e : b k - b (k + 1) = p ^ k * (-s) := by
          apply hNc n
          linear_combination (-1 : C) * hb k + hb (k + 1) - hs
        rw [e]
        exact Submodule.smul_mem_smul (Ideal.pow_mem_pow (Ideal.mem_span_singleton_self p) k)
          Submodule.mem_top
      let B : AdicCompletion.AdicCauchySequence (Ideal.span {p}) C :=
        AdicCompletion.AdicCauchySequence.mk (Ideal.span {p}) C b hB
      have hBk : ∀ k, B k = b k := fun k => rfl
      refine ⟨a n, AdicCompletion.mk (Ideal.span {p}) C B, ?_⟩
      apply AdicCompletion.ext_evalₐ
      intro k
      rw [map_add, map_mul, map_pow, hev, hev, AdicCompletion.evalₐ_mk, AdicCompletion.evalₐ_mk,
        ← map_pow, ← map_mul, ← map_add, ← sub_eq_zero, ← map_sub, hmem, hBk]
      obtain ⟨s, hs⟩ := hD a k (k + n) (by omega)
      exact ⟨-s, by linear_combination hb k - hs⟩
  obtain ⟨_, hii, hiii⟩ := basics (Localization.AtPrime P)
    (algebraMap T (Localization.AtPrime P) t) htf
  have tower : ∀ x : T, algebraMap T (AdicCompletion (Ideal.span
      {algebraMap T (Localization.AtPrime P) t}) (Localization.AtPrime P)) x =
      algebraMap (Localization.AtPrime P) (AdicCompletion (Ideal.span
        {algebraMap T (Localization.AtPrime P) t}) (Localization.AtPrime P))
        (algebraMap T (Localization.AtPrime P) x) :=
    fun x => IsScalarTower.algebraMap_apply T (Localization.AtPrime P) _ x
  refine ⟨?_, ?_, ?_, ?_⟩
  · intro s hs
    rw [tower]
    exact (IsLocalization.map_units (Localization.AtPrime P) (⟨s, hs⟩ : P.primeCompl)).map _
  · intro c x
    obtain ⟨y₀, x'', hx⟩ := hiii c x
    obtain ⟨⟨p, s⟩, hps⟩ := IsLocalization.mk'_surjective P.primeCompl y₀
    refine ⟨p, s, algebraMap T _ (s : T) * x'', s.2, ?_⟩
    have hspec := IsLocalization.mk'_spec (Localization.AtPrime P) p s
    have hps' : IsLocalization.mk' (Localization.AtPrime P) p s = y₀ := hps
    rw [hps'] at hspec
    rw [hx]
    simp only [tower]
    rw [← hspec]
    simp only [map_mul]
    ring
  · intro τ k y hτ
    simp only [tower] at hτ
    obtain ⟨c', hc'⟩ := hii k (algebraMap T (Localization.AtPrime P) τ) y hτ
    obtain ⟨⟨r, σ₀⟩, hrσ⟩ := IsLocalization.mk'_surjective P.primeCompl c'
    have hspec := IsLocalization.mk'_spec (Localization.AtPrime P) r σ₀
    have hrσ' : IsLocalization.mk' (Localization.AtPrime P) r σ₀ = c' := hrσ
    rw [hrσ'] at hspec
    have heq : algebraMap T (Localization.AtPrime P) ((σ₀ : T) * τ) =
        algebraMap T (Localization.AtPrime P) (t ^ k * r) := by
      simp only [map_mul, map_pow]
      rw [hc', ← hspec]
      ring
    obtain ⟨c₁, hc₁⟩ := (IsLocalization.eq_iff_exists P.primeCompl (Localization.AtPrime P)).mp heq
    refine ⟨(c₁ : T) * σ₀, c₁ * r, P.primeCompl.mul_mem c₁.2 σ₀.2, ?_⟩
    linear_combination hc₁
  · haveI : Module.Flat (Localization.AtPrime P) (AdicCompletion (Ideal.span
        {algebraMap T (Localization.AtPrime P) t}) (Localization.AtPrime P)) := hflat
    exact Module.Flat.trans T (Localization.AtPrime P) _

theorem wcpa_dj_lr1s_nf_cnf_fmp_gb_dc_closure_finite : ∀ (T Vh A : Type u) [CommRing T] [CommRing Vh] [IsDomain Vh] [CommRing A] [Algebra T Vh] [Algebra T A] (t : T), (∀ x y : Vh, x ∣ y ∨ y ∣ x) → (∀ x : Vh, x ≠ 0 → ∃ k : ℕ, x ∣ algebraMap T Vh t ^ k) → IsUnit (algebraMap T A t) → (∃ G : Finset A, ∀ a : A, ∃ n : ℕ, algebraMap T A t ^ n * a ∈ Submodule.span T (G : Set A)) → _root_.IsReduced (TensorProduct T Vh A) → (∀ (B : Type u) [CommRing B] [IsDomain B] [Algebra Vh B], Function.Injective (algebraMap Vh B) → IsUnit (algebraMap Vh B (algebraMap T Vh t)) → (∃ G : Finset B, ∀ x : B, ∃ n : ℕ, algebraMap Vh B (algebraMap T Vh t) ^ n * x ∈ Submodule.span Vh (G : Set B)) → Module.Finite Vh ↥(integralClosure Vh B)) → Module.Finite Vh ↥(integralClosure Vh (TensorProduct T Vh A)) :=
by
  intro T Vh A _ _ _ _ _ _ t hdvd hpow hu hG hred hstab
  classical

  have hglue : ∀ (T A : Type u) [CommRing T] [CommRing A] [Algebra T A] (t : T),
      IsUnit (algebraMap T A t) → _root_.IsReduced A → IsNoetherianRing A →
      (∀ (M : Type u) [AddCommGroup M] [Module T M], Module.Finite T M →
        (∀ m : M, t • m = 0 → m = 0) → Module.FinitePresentation T M) →
      (∀ p ∈ minimalPrimes A, Module.Finite T ↥(integralClosure T (A ⧸ p))) →
      Module.Finite T ↥(integralClosure T A) := by
    intro T A _ _ _ t hu hred hnoeth hfp hc
    have hzero : ∀ x : A, (∀ p ∈ minimalPrimes A, x ∈ p) → x = 0 := by
      intro x hx
      have hmem : x ∈ sInf (minimalPrimes A) := Ideal.mem_sInf.mpr (fun p hp => hx p hp)
      have h2 : sInf (minimalPrimes A) = (⊥ : Ideal A).radical := Ideal.sInf_minimalPrimes
      rw [h2] at hmem
      obtain ⟨n, hn⟩ := hmem
      exact IsNilpotent.eq_zero ⟨n, Ideal.mem_bot.mp hn⟩
    have hfin : (minimalPrimes A).Finite := minimalPrimes.finite_of_isNoetherianRing A
    haveI : Finite ↥(minimalPrimes A) := hfin.to_subtype
    haveI : Fintype ↥(minimalPrimes A) := Fintype.ofFinite _
    have hdetect : ∀ a : A, (∀ i : ↥(minimalPrimes A),
        _root_.IsIntegral T (Ideal.Quotient.mk i.1 a)) → _root_.IsIntegral T a := by
      intro a ha
      choose g hgm hga using ha
      refine ⟨∏ i, g i, Polynomial.monic_prod_of_monic _ _ (fun i _ => hgm i), ?_⟩
      apply hzero
      intro p hp
      rw [← Ideal.Quotient.eq_zero_iff_mem]
      have e : Ideal.Quotient.mk p (Polynomial.eval₂ (algebraMap T A) a (∏ i, g i)) =
          Polynomial.aeval (Ideal.Quotient.mk p a) (∏ i, g i) := by
        rw [← Ideal.Quotient.mkₐ_eq_mk T, ← Polynomial.aeval_def, Polynomial.aeval_algHom_apply]
      rw [e, map_prod]
      refine Finset.prod_eq_zero (Finset.mem_univ ⟨p, hp⟩) ?_
      rw [Polynomial.aeval_def]
      exact hga ⟨p, hp⟩
    have hker : ∀ (N Q : Type u) [AddCommGroup N] [Module T N] [AddCommGroup Q] [Module T Q],
        Module.Finite T N → ∀ (f : N →ₗ[T] Q) (R : Submodule T Q),
        (∀ x : Q, t • x ∈ R → x ∈ R) → (Submodule.comap f R).FG := by
      intro N Q _ _ _ _ hN f R hR
      let g := R.mkQ ∘ₗ f
      haveI : Module.Finite T (LinearMap.range g) := Module.Finite.range g
      have htf : ∀ m : LinearMap.range g, t • m = 0 → m = 0 := by
        intro m hm
        obtain ⟨x, hx⟩ := Submodule.Quotient.mk_surjective R (m : Q ⧸ R)
        have h1 : t • (m : Q ⧸ R) = 0 := by
          have := congrArg (fun z : LinearMap.range g => (z : Q ⧸ R)) hm
          simpa using this
        rw [← hx, ← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero] at h1
        apply Subtype.ext
        rw [← hx, (Submodule.Quotient.mk_eq_zero R).mpr (hR x h1)]
        rfl
      haveI := hfp (LinearMap.range g) inferInstance htf
      have := Module.FinitePresentation.fg_ker g.rangeRestrict (LinearMap.surjective_rangeRestrict g)
      rwa [LinearMap.ker_rangeRestrict, LinearMap.ker_comp, Submodule.ker_mkQ] at this
    haveI hcf : ∀ i : ↥(minimalPrimes A), Module.Finite T (integralClosure T (A ⧸ i.1)) :=
      fun i => hc i.1 i.2
    let f : (∀ i : ↥(minimalPrimes A), integralClosure T (A ⧸ i.1)) →ₗ[T]
        (∀ i : ↥(minimalPrimes A), A ⧸ i.1) :=
      LinearMap.pi (fun i => (integralClosure T (A ⧸ i.1)).val.toLinearMap ∘ₗ LinearMap.proj i)
    let πL : A →ₗ[T] (∀ i : ↥(minimalPrimes A), A ⧸ i.1) :=
      LinearMap.pi (fun i => (Ideal.Quotient.mkₐ T i.1).toLinearMap)
    have hsat : ∀ x : (∀ i : ↥(minimalPrimes A), A ⧸ i.1), t • x ∈ LinearMap.range πL →
        x ∈ LinearMap.range πL := by
      intro x hx
      obtain ⟨a, ha⟩ := LinearMap.mem_range.mp hx
      obtain ⟨w, hw⟩ := hu.exists_left_inv
      refine LinearMap.mem_range.mpr ⟨w * a, ?_⟩
      funext i
      have hai : Ideal.Quotient.mk i.1 a = Ideal.Quotient.mk i.1 (algebraMap T A t) * x i := by
        have h := congrFun ha i
        change Ideal.Quotient.mkₐ T i.1 a = t • x i at h
        rw [Algebra.smul_def, ← (Ideal.Quotient.mkₐ T i.1).commutes t,
          Ideal.Quotient.mkₐ_eq_mk] at h
        exact h
      show Ideal.Quotient.mkₐ T i.1 (w * a) = x i
      rw [Ideal.Quotient.mkₐ_eq_mk, map_mul, hai, ← mul_assoc, ← map_mul, hw, map_one, one_mul]
    have hK : (Submodule.comap f (LinearMap.range πL)).FG :=
      hker _ _ inferInstance f (LinearMap.range πL) hsat
    let φ : integralClosure T A →ₗ[T] (∀ i : ↥(minimalPrimes A), integralClosure T (A ⧸ i.1)) :=
      { toFun := fun x i => ⟨Ideal.Quotient.mkₐ T i.1 (x : A),
          _root_.IsIntegral.map (Ideal.Quotient.mkₐ T i.1) x.2⟩
        map_add' := by
          intro x y
          funext i
          apply Subtype.ext
          exact map_add (Ideal.Quotient.mkₐ T i.1) (x : A) (y : A)
        map_smul' := by
          intro c x
          funext i
          apply Subtype.ext
          exact map_smul (Ideal.Quotient.mkₐ T i.1) c (x : A) }
    have hinj : Function.Injective φ := by
      rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
      intro x hx
      have hx0 : (x : A) = 0 := by
        apply hzero
        intro p hp
        have h := congrArg (fun e => ((e ⟨p, hp⟩ : integralClosure T (A ⧸ p)) : A ⧸ p)) hx
        change Ideal.Quotient.mkₐ T p (x : A) = 0 at h
        rw [Ideal.Quotient.mkₐ_eq_mk] at h
        exact Ideal.Quotient.eq_zero_iff_mem.mp h
      exact Subtype.ext hx0
    have hrange : LinearMap.range φ = Submodule.comap f (LinearMap.range πL) := by
      ext e
      constructor
      · rintro ⟨x, rfl⟩
        exact LinearMap.mem_range.mpr ⟨(x : A), rfl⟩
      · intro he
        obtain ⟨a, ha⟩ := LinearMap.mem_range.mp (Submodule.mem_comap.mp he)
        have hcomp : ∀ i : ↥(minimalPrimes A),
            Ideal.Quotient.mk i.1 a = ((e i : integralClosure T (A ⧸ i.1)) : A ⧸ i.1) :=
          fun i => congrFun ha i
        have hint : _root_.IsIntegral T a := hdetect a (fun i => by rw [hcomp i]; exact (e i).2)
        refine ⟨⟨a, hint⟩, ?_⟩
        funext i
        apply Subtype.ext
        exact hcomp i
    haveI hKfin : Module.Finite T (Submodule.comap f (LinearMap.range πL)) :=
      Module.Finite.iff_fg.mpr hK
    exact Module.Finite.equiv
      ((LinearEquiv.ofInjective φ hinj).trans (LinearEquiv.ofEq _ _ hrange)).symm

  set τ : Vh := algebraMap T Vh t with hτ
  let ι : A →ₐ[T] TensorProduct T Vh A := Algebra.TensorProduct.includeRight
  have hτR : algebraMap Vh (TensorProduct T Vh A) τ = ι (algebraMap T A t) := by
    rw [hτ, ← IsScalarTower.algebraMap_apply, AlgHom.commutes]
  have hunitR : IsUnit (algebraMap Vh (TensorProduct T Vh A) τ) := by
    rw [hτR]; exact hu.map ι
  obtain ⟨G, hG⟩ := hG
  have hFGR : ∀ x : TensorProduct T Vh A, ∃ n : ℕ,
      algebraMap Vh (TensorProduct T Vh A) τ ^ n * x ∈
        Submodule.span Vh ((G.image ι : Finset _) : Set (TensorProduct T Vh A)) := by
    intro x
    induction x using TensorProduct.induction_on with
    | zero => exact ⟨0, by simp⟩
    | tmul v a =>
      obtain ⟨n, hn⟩ := hG a
      refine ⟨n, ?_⟩
      have h1 : ι (algebraMap T A t ^ n * a) ∈
          Submodule.span T ((G.image ι : Finset _) : Set (TensorProduct T Vh A)) := by
        have := Submodule.mem_map_of_mem (f := ι.toLinearMap) hn
        rw [Submodule.map_span] at this
        have e : ((G.image ι : Finset _) : Set (TensorProduct T Vh A)) =
            ι.toLinearMap '' (G : Set A) := by
          ext y; simp
        rw [e]
        exact this
      have h2 : ι (algebraMap T A t ^ n * a) ∈
          Submodule.span Vh ((G.image ι : Finset _) : Set (TensorProduct T Vh A)) :=
        Submodule.span_le_restrictScalars T Vh _ h1
      have e : algebraMap Vh (TensorProduct T Vh A) τ ^ n * (v ⊗ₜ[T] a) =
          v • ι (algebraMap T A t ^ n * a) := by
        rw [map_mul, map_pow, ← hτR, ← mul_smul_comm]
        congr 1
        show v ⊗ₜ[T] a = v • ((1 : Vh) ⊗ₜ[T] a)
        rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
      rw [e]
      exact Submodule.smul_mem _ v h2
    | add x y hx hy =>
      obtain ⟨n, hn⟩ := hx
      obtain ⟨m, hm⟩ := hy
      refine ⟨n + m, ?_⟩
      have e : algebraMap Vh (TensorProduct T Vh A) τ ^ (n + m) * (x + y) =
          τ ^ m • (algebraMap Vh (TensorProduct T Vh A) τ ^ n * x) +
            τ ^ n • (algebraMap Vh (TensorProduct T Vh A) τ ^ m * y) := by
        rw [Algebra.smul_def, Algebra.smul_def, map_pow, map_pow]
        ring
      rw [e]
      exact Submodule.add_mem _ (Submodule.smul_mem _ _ hn) (Submodule.smul_mem _ _ hm)

  haveI hFnoeth : IsNoetherianRing (Localization.Away τ) := by
    have hfield : ∀ z : Localization.Away τ, z ≠ 0 → IsUnit z := by
      intro z hz
      obtain ⟨n, a, ha⟩ := IsLocalization.Away.surj τ z
      have hτu : IsUnit (algebraMap Vh (Localization.Away τ) τ) :=
        IsLocalization.Away.algebraMap_isUnit τ
      have ha0 : a ≠ 0 := by
        rintro rfl
        rw [map_zero] at ha
        exact hz ((hτu.pow n).mul_left_eq_zero.mp ha)
      obtain ⟨k, b, hb⟩ := hpow a ha0
      have hau : IsUnit (algebraMap Vh (Localization.Away τ) a) := by
        have h0 : IsUnit (algebraMap Vh (Localization.Away τ) (τ ^ k)) := by
          rw [map_pow]; exact hτu.pow k
        rw [hb, map_mul] at h0
        exact isUnit_of_mul_isUnit_left h0
      rw [← ha] at hau
      exact isUnit_of_mul_isUnit_left hau
    rw [isNoetherianRing_iff, isNoetherian_def]
    intro I
    by_cases hI : I = ⊥
    · rw [hI]; exact Submodule.fg_bot
    · obtain ⟨z, hzI, hz0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hI
      rw [Ideal.eq_top_of_isUnit_mem I hzI (hfield z hz0)]
      exact ⟨{1}, by rw [Finset.coe_singleton]; exact Ideal.span_singleton_one⟩
  letI : Algebra (Localization.Away τ) (TensorProduct T Vh A) :=
    (IsLocalization.Away.lift τ hunitR).toAlgebra
  haveI : IsScalarTower Vh (Localization.Away τ) (TensorProduct T Vh A) :=
    IsScalarTower.of_algebraMap_eq (fun x => by
      rw [RingHom.algebraMap_toAlgebra]
      exact (IsLocalization.Away.lift_eq τ hunitR x).symm)
  have hinv : algebraMap (Localization.Away τ) (TensorProduct T Vh A)
      (IsLocalization.Away.invSelf τ : Localization.Away τ) *
      algebraMap Vh (TensorProduct T Vh A) τ = 1 := by
    rw [IsScalarTower.algebraMap_apply Vh (Localization.Away τ) (TensorProduct T Vh A) τ,
      ← map_mul, mul_comm, IsLocalization.Away.mul_invSelf, map_one]
  haveI : Module.Finite (Localization.Away τ) (TensorProduct T Vh A) := by
    refine ⟨⟨G.image ι, ?_⟩⟩
    rw [eq_top_iff]
    intro a _
    obtain ⟨n, hn⟩ := hFGR a
    have h1 := Submodule.span_le_restrictScalars Vh (Localization.Away τ) _ hn
    have h2 := Submodule.smul_mem _
      ((IsLocalization.Away.invSelf τ : Localization.Away τ) ^ n) h1
    rw [Algebra.smul_def, map_pow, ← mul_assoc, ← mul_pow, hinv, one_pow, one_mul] at h2
    exact h2
  haveI hRN : IsNoetherianRing (TensorProduct T Vh A) :=
    isNoetherian_of_tower (Localization.Away τ) inferInstance

  have hfp : ∀ (M : Type u) [AddCommGroup M] [Module Vh M], Module.Finite Vh M →
      (∀ m : M, τ • m = 0 → m = 0) → Module.FinitePresentation Vh M := by
    intro M _ _ hMf htf
    haveI : ValuationRing Vh := ValuationRing.iff_dvd_total.mpr ⟨fun x y => hdvd x y⟩
    have hpowtf : ∀ (k : ℕ) (m : M), τ ^ k • m = 0 → m = 0 := by
      intro k
      induction k with
      | zero => intro m hm; simpa using hm
      | succ k ih =>
        intro m hm
        rw [pow_succ, mul_smul] at hm
        exact htf m (ih _ hm)
    haveI : Module.Flat Vh M := by
      rw [Module.Flat.flat_iff_torsion_eq_bot_of_isBezout, eq_bot_iff]
      intro m hm
      obtain ⟨⟨a, ha⟩, ham⟩ := (Submodule.mem_torsion_iff m).mp hm
      have ham' : a • m = 0 := ham
      have ha0 : a ≠ 0 := nonZeroDivisors.ne_zero ha
      obtain ⟨k, c, hc⟩ := hpow a ha0
      have hk : τ ^ k • m = 0 := by
        rw [hc, mul_comm, mul_smul, ham', smul_zero]
      exact (Submodule.mem_bot Vh).mpr (hpowtf k m hk)
    haveI : Module.Free Vh M := Module.free_of_flat_of_isLocalRing
    exact Module.finitePresentation_of_projective Vh M

  have hcomp : ∀ p ∈ minimalPrimes (TensorProduct T Vh A),
      Module.Finite Vh ↥(integralClosure Vh (TensorProduct T Vh A ⧸ p)) := by
    intro p hp
    haveI : p.IsPrime := hp.1.1
    haveI : IsDomain (TensorProduct T Vh A ⧸ p) := Ideal.Quotient.isDomain p
    have hmap : ∀ x : Vh, algebraMap Vh (TensorProduct T Vh A ⧸ p) x =
        Ideal.Quotient.mk p (algebraMap Vh (TensorProduct T Vh A) x) := fun x => by
      rw [← Ideal.Quotient.mkₐ_eq_mk Vh, AlgHom.commutes]
    have hunitQ : IsUnit (algebraMap Vh (TensorProduct T Vh A ⧸ p) τ) := by
      rw [hmap]; exact hunitR.map _
    have hinjQ : Function.Injective (algebraMap Vh (TensorProduct T Vh A ⧸ p)) := by
      rw [injective_iff_map_eq_zero]
      intro x hx
      by_contra hx0
      obtain ⟨k, c, hc⟩ := hpow x hx0
      have h1 : IsUnit (algebraMap Vh (TensorProduct T Vh A ⧸ p) (τ ^ k)) := by
        rw [map_pow]; exact hunitQ.pow k
      rw [hc, map_mul, hx, zero_mul] at h1
      exact not_isUnit_zero h1
    have hFGQ : ∃ G' : Finset (TensorProduct T Vh A ⧸ p), ∀ x : TensorProduct T Vh A ⧸ p,
        ∃ n : ℕ, algebraMap Vh (TensorProduct T Vh A ⧸ p) τ ^ n * x ∈
          Submodule.span Vh (G' : Set (TensorProduct T Vh A ⧸ p)) := by
      refine ⟨(G.image ι).image (Ideal.Quotient.mk p), fun a => ?_⟩
      obtain ⟨a', rfl⟩ := Ideal.Quotient.mk_surjective a
      obtain ⟨n, hn⟩ := hFGR a'
      refine ⟨n, ?_⟩
      have := Submodule.mem_map_of_mem (f := (Ideal.Quotient.mkₐ Vh p).toLinearMap) hn
      rw [Submodule.map_span] at this
      have e : (((G.image ι).image (Ideal.Quotient.mk p) : Finset _) :
          Set (TensorProduct T Vh A ⧸ p)) =
          (Ideal.Quotient.mkₐ Vh p).toLinearMap ''
            ((G.image ι : Finset _) : Set (TensorProduct T Vh A)) := by
        ext y; simp
      rw [e]
      convert this using 1
      rw [AlgHom.toLinearMap_apply, map_mul, map_pow, AlgHom.commutes, Ideal.Quotient.mkₐ_eq_mk]
    exact hstab _ hinjQ hunitQ hFGQ
  exact hglue Vh (TensorProduct T Vh A) τ hunitR hred hRN hfp hcomp

theorem wcpa_dj_lr1s_nf_cnf_fmp_gb_dc_basis_choice : ∀ (T A : Type u) [CommRing T] [CommRing A] [IsDomain A] [Algebra T A] (P : Ideal T), P.IsPrime → Function.Injective (algebraMap T A) → ∀ t : T, IsUnit (algebraMap T A t) → (∀ c : T, c ≠ 0 → ∃ (f : T) (k : ℕ) (w : T), f ∉ P ∧ t ^ k * f = c * w) → (∃ G : Finset A, ∀ a : A, ∃ n : ℕ, algebraMap T A t ^ n * a ∈ Submodule.span T (G : Set A)) → ∃ (n : ℕ) (e : Fin n → A), (∀ i, IsIntegral T (e i)) ∧ LinearIndependent T e ∧ ∀ a : A, ∃ (k : ℕ) (f : T), f ∉ P ∧ algebraMap T A (t ^ k * f) * a ∈ Submodule.span T (Set.range e) :=
by
  intro T A _ _ _ _ P hP hinj t hu hP0 hG
  classical

  have s7 : ∀ a : A, ∃ k : ℕ, IsIntegral T (algebraMap T A t ^ k * a) := by
    obtain ⟨G, hG'⟩ := hG
    intro a
    have hn : ∀ γ ∈ G, ∃ m : ℕ, algebraMap T A t ^ m * (a * γ) ∈
        Submodule.span T (G : Set A) := fun γ _ => hG' (a * γ)
    choose! nf hnf using hn
    have hle : Submodule.span T (G : Set A) ≤ (Submodule.span T (G : Set A)).comap
        (LinearMap.mulLeft T (algebraMap T A t ^ G.sup nf * a)) := by
      rw [Submodule.span_le]
      intro γ hγ
      rw [SetLike.mem_coe, Submodule.mem_comap, LinearMap.mulLeft_apply]
      have hle' : nf γ ≤ G.sup nf := Finset.le_sup hγ
      have e : algebraMap T A t ^ G.sup nf * a * γ =
          t ^ (G.sup nf - nf γ) • (algebraMap T A t ^ nf γ * (a * γ)) := by
        rw [Algebra.smul_def, map_pow, ← mul_assoc, ← pow_add, Nat.sub_add_cancel hle', mul_assoc]
      rw [e]
      exact Submodule.smul_mem _ _ (hnf γ hγ)
    refine ⟨G.sup nf, isIntegral_of_smul_mem_submodule (M := A)
      (Submodule.span T (G : Set A)) ?_ (Submodule.fg_span G.finite_toSet) _ ?_⟩
    · intro hbot
      obtain ⟨m, hm⟩ := hG' 1
      rw [hbot, mul_one, Submodule.mem_bot] at hm
      exact (hu.pow m).ne_zero hm
    · intro x hx
      have := hle hx
      rw [Submodule.mem_comap, LinearMap.mulLeft_apply] at this
      exact this
  obtain ⟨G, hG'⟩ := hG

  let v : G → A := fun i => i.1
  obtain ⟨s, hs, hmax⟩ := exists_maximal_linearIndepOn T v
  have hper : ∀ i : G, ∃ (k : ℕ) (f : T), f ∉ P ∧
      (t ^ k * f) • v i ∈ Submodule.span T (v '' s) := by
    intro i
    by_cases hi : i ∈ s
    · refine ⟨0, 1, (Ideal.ne_top_iff_one P).mp hP.ne_top, ?_⟩
      rw [pow_zero, mul_one, one_smul]
      exact Submodule.subset_span ⟨i, hi, rfl⟩
    · obtain ⟨c, hc0, hc⟩ := hmax i hi
      obtain ⟨f, k, w, hf, hfk⟩ := hP0 c hc0
      refine ⟨k, f, hf, ?_⟩
      rw [hfk, mul_comm, mul_smul]
      exact Submodule.smul_mem _ _ hc
  choose kf ff hff hkf using hper
  obtain ⟨K, hKdef⟩ : ∃ K, K = Finset.univ.sup kf := ⟨_, rfl⟩
  obtain ⟨Φ, hΦdef⟩ : ∃ Φ, Φ = ∏ i, ff i := ⟨_, rfl⟩
  have hΦ : Φ ∉ P := by
    intro h
    rw [hΦdef] at h
    obtain ⟨i, _, hi⟩ := hP.prod_mem_iff.mp h
    exact hff i hi
  have hKΦ : ∀ i : G, (t ^ K * Φ) • v i ∈ Submodule.span T (v '' s) := by
    intro i
    obtain ⟨d, hd⟩ := Nat.exists_eq_add_of_le
      (hKdef ▸ (Finset.le_sup (f := kf) (Finset.mem_univ i)) : kf i ≤ K)
    have e1 : t ^ K * Φ = (t ^ d * ∏ j ∈ Finset.univ.erase i, ff j) * (t ^ kf i * ff i) := by
      rw [hΦdef, ← Finset.mul_prod_erase Finset.univ ff (Finset.mem_univ i), hd, pow_add]
      ring
    rw [e1, mul_smul]
    exact Submodule.smul_mem _ _ (hkf i)

  haveI : Fintype s := Fintype.ofFinite s
  let eqv : s ≃ Fin (Fintype.card s) := Fintype.equivFin s
  let b : Fin (Fintype.card s) → A := fun j => v (eqv.symm j)
  have hb : LinearIndependent T b := hs.linearIndependent.comp eqv.symm eqv.symm.injective
  have hrange : Set.range b = v '' s := by
    ext y
    constructor
    · rintro ⟨j, rfl⟩
      exact ⟨_, (eqv.symm j).2, rfl⟩
    · rintro ⟨x, hx, rfl⟩
      exact ⟨eqv ⟨x, hx⟩, by simp [b]⟩

  choose m hm using fun j => s7 (b j)
  let e : Fin (Fintype.card s) → A := fun j => algebraMap T A t ^ m j * b j
  have heli : LinearIndependent T e := by
    rw [linearIndependent_iff']
    intro s' g hsum i hi
    have h1 : ∑ i ∈ s', (g i * t ^ m i) • b i = 0 := by
      rw [← hsum]
      refine Finset.sum_congr rfl ?_
      intro j _
      simp only [e]
      rw [Algebra.smul_def, Algebra.smul_def, map_mul, map_pow, mul_assoc]
    have h2 := linearIndependent_iff'.mp hb s' _ h1 i hi
    have h3 : algebraMap T A (g i) * algebraMap T A t ^ m i = 0 := by
      rw [← map_pow, ← map_mul, h2, map_zero]
    have h4 : algebraMap T A (g i) = 0 := (hu.pow (m i)).mul_left_eq_zero.mp h3
    exact (map_eq_zero_iff _ hinj).mp h4
  obtain ⟨M, hMdef⟩ : ∃ M, M = Finset.univ.sup m := ⟨_, rfl⟩
  have hesp : ∀ j, algebraMap T A (t ^ M) * b j ∈ Submodule.span T (Set.range e) := by
    intro j
    obtain ⟨d, hd⟩ := Nat.exists_eq_add_of_le
      (hMdef ▸ (Finset.le_sup (f := m) (Finset.mem_univ j)) : m j ≤ M)
    have : algebraMap T A (t ^ M) * b j = t ^ d • e j := by
      simp only [e]
      rw [hd, Algebra.smul_def, map_pow, map_pow, pow_add]
      ring
    rw [this]
    exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨j, rfl⟩)

  refine ⟨Fintype.card s, e, hm, heli, ?_⟩
  intro a
  obtain ⟨N, hN⟩ := hG' a
  have h1 : ∀ x ∈ Submodule.span T (G : Set A),
      algebraMap T A (t ^ K * Φ) * x ∈ Submodule.span T (Set.range b) := by
    intro x hx
    induction hx using Submodule.span_induction with
    | mem y hy =>
      have := hKΦ ⟨y, Finset.mem_coe.mp hy⟩
      rw [Algebra.smul_def] at this
      rw [hrange]
      exact this
    | zero => rw [mul_zero]; exact Submodule.zero_mem _
    | add y z _ _ hy hz => rw [mul_add]; exact add_mem hy hz
    | smul c y _ hy => rw [mul_smul_comm]; exact Submodule.smul_mem _ c hy
  have h2 : ∀ x ∈ Submodule.span T (Set.range b),
      algebraMap T A (t ^ M) * x ∈ Submodule.span T (Set.range e) := by
    intro x hx
    induction hx using Submodule.span_induction with
    | mem y hy =>
      obtain ⟨j, rfl⟩ := hy
      exact hesp j
    | zero => rw [mul_zero]; exact Submodule.zero_mem _
    | add y z _ _ hy hz => rw [mul_add]; exact add_mem hy hz
    | smul c y _ hy => rw [mul_smul_comm]; exact Submodule.smul_mem _ c hy
  refine ⟨N + K + M, Φ, hΦ, ?_⟩
  have hid : algebraMap T A (t ^ (N + K + M) * Φ) * a =
      algebraMap T A (t ^ M) * (algebraMap T A (t ^ K * Φ) * (algebraMap T A t ^ N * a)) := by
    simp only [map_mul, map_pow]
    ring
  rw [hid]
  exact h2 _ (h1 _ hN)

theorem wcpa_dj_lr1s_nf_cnf_fmp_gb_dc_coeff_descent : ∀ (T Vh A : Type u) [CommRing T] [CommRing Vh] [CommRing A] [IsDomain A] [Algebra T Vh] [Algebra T A] [Module.Flat T Vh] (P : Ideal T), P.IsPrime → ∀ t : T, IsUnit (algebraMap T A t) → (∀ s : T, s ∉ P → IsUnit (algebraMap T Vh s)) → (∀ (τ : T) (k : ℕ) (y : Vh), algebraMap T Vh τ = algebraMap T Vh t ^ k * y → ∃ (σ r : T), σ ∉ P ∧ σ * τ = t ^ k * r) → ∀ (n : ℕ) (e : Fin n → A), LinearIndependent T e → (∀ a : A, ∃ (k : ℕ) (f : T), f ∉ P ∧ algebraMap T A (t ^ k * f) * a ∈ Submodule.span T (Set.range e)) → ∀ a : A, TensorProduct.tmul T (1 : Vh) a ∈ Submodule.span Vh (Set.range fun i => TensorProduct.tmul T (1 : Vh) (e i)) → ∃ g : T, g ∉ P ∧ algebraMap T A g * a ∈ Submodule.span T (Set.range e) :=
by
  intro T Vh A _ _ _ _ _ _ _ P hP t hu _hP1 hP3 n e he hgen a ha
  classical
  have := hP
  obtain ⟨k, f, hfP, hf⟩ := hgen a
  obtain ⟨τ, hτ⟩ := (Submodule.mem_span_range_iff_exists_fun T).mp hf
  obtain ⟨x, hx⟩ := (Submodule.mem_span_range_iff_exists_fun Vh).mp ha
  have hli : LinearIndependent Vh (fun i => TensorProduct.tmul T (1 : Vh) (e i)) :=
    Module.Flat.linearIndependent_one_tmul he
  have hTr : ∀ (c : T) (b : A), TensorProduct.tmul T (1 : Vh) (c • b) =
      (algebraMap T Vh c) • TensorProduct.tmul T (1 : Vh) b := by
    intro c b
    rw [← TensorProduct.smul_tmul, TensorProduct.smul_tmul', smul_eq_mul, mul_one,
      Algebra.algebraMap_eq_smul_one]
  have h1 : ∑ i, algebraMap T Vh (τ i) • TensorProduct.tmul T (1 : Vh) (e i) =
      ∑ i, (algebraMap T Vh (t ^ k * f) * x i) • TensorProduct.tmul T (1 : Vh) (e i) := by
    have h2 : TensorProduct.tmul T (1 : Vh) (∑ i, τ i • e i) =
        TensorProduct.tmul T (1 : Vh) (algebraMap T A (t ^ k * f) * a) := by rw [hτ]
    simp only [TensorProduct.tmul_sum, hTr] at h2
    rw [← Algebra.smul_def, hTr, ← hx, Finset.smul_sum] at h2
    simp only [smul_smul] at h2
    exact h2
  have hE4 : ∀ i, algebraMap T Vh (τ i) = algebraMap T Vh t ^ k * (algebraMap T Vh f * x i) := by
    intro i
    have h3 := Fintype.linearIndependent_iff.mp hli
      (fun i => algebraMap T Vh (τ i) - algebraMap T Vh (t ^ k * f) * x i)
      (by simp only [sub_smul, Finset.sum_sub_distrib, h1, sub_self]) i
    rw [sub_eq_zero] at h3
    rw [h3, map_mul, map_pow, mul_assoc]
  choose σ r hσP hσ using fun i => hP3 (τ i) k _ (hE4 i)
  have hSP : (∏ i, σ i) ∉ P := by
    intro h
    obtain ⟨i, -, hi⟩ := (Ideal.IsPrime.prod_mem_iff (p := P)).mp h
    exact hσP i hi
  have hρ : ∀ i, σ i * ∏ j ∈ Finset.univ.erase i, σ j = ∏ i, σ i := fun i =>
    Finset.mul_prod_erase _ _ (Finset.mem_univ i)
  refine ⟨f * ∏ i, σ i, fun h => ?_, ?_⟩
  · rcases hP.mem_or_mem h with h | h
    · exact hfP h
    · exact hSP h
  · rw [Submodule.mem_span_range_iff_exists_fun]
    refine ⟨fun i => (∏ j ∈ Finset.univ.erase i, σ j) * r i, ?_⟩
    apply (hu.pow k).mul_left_cancel
    have key : algebraMap T A (t ^ k) * ∑ i, ((∏ j ∈ Finset.univ.erase i, σ j) * r i) • e i =
        algebraMap T A (∏ i, σ i) * ∑ i, τ i • e i := by
      rw [Finset.mul_sum, Finset.mul_sum]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [← Algebra.smul_def, ← Algebra.smul_def, smul_smul, smul_smul, ← hρ i]
      congr 1
      linear_combination (-(∏ j ∈ Finset.univ.erase i, σ j)) * hσ i
    rw [← map_pow, key, hτ]
    simp only [map_mul, map_pow]
    ring

theorem wcpa_dj_lr1s_nf_cnf_fmp_gb_dc_span_descent : ∀ (T Vh A : Type u) [CommRing T] [CommRing Vh] [CommRing A] [Algebra T Vh] [Algebra T A] (P : Ideal T), P.IsPrime → ∀ t : T, IsUnit (algebraMap T A t) → (∀ s : T, s ∉ P → IsUnit (algebraMap T Vh s)) → (∀ (c : ℕ) (x : Vh), ∃ (p s : T) (x' : Vh), s ∉ P ∧ algebraMap T Vh s * x = algebraMap T Vh p + algebraMap T Vh t ^ c * x') → ∀ (n : ℕ) (e : Fin n → A), (∀ i, IsIntegral T (e i)) → (∀ a : A, ∃ (k : ℕ) (f : T), f ∉ P ∧ algebraMap T A (t ^ k * f) * a ∈ Submodule.span T (Set.range e)) → (∀ a : A, TensorProduct.tmul T (1 : Vh) a ∈ Submodule.span Vh (Set.range fun i => TensorProduct.tmul T (1 : Vh) (e i)) → ∃ g : T, g ∉ P ∧ algebraMap T A g * a ∈ Submodule.span T (Set.range e)) → Module.Finite Vh ↥(integralClosure Vh (TensorProduct T Vh A)) → ∃ E : Finset A, (∀ x ∈ E, TensorProduct.tmul T (1 : Vh) x ∈ integralClosure Vh (TensorProduct T Vh A)) ∧ ∀ a : A, TensorProduct.tmul T (1 : Vh) a ∈ integralClosure Vh (TensorProduct T Vh A) → ∃ g : T, g ∉ P ∧ algebraMap T A g * a ∈ Submodule.span T (E : Set A) :=
by
  intro T Vh A _ _ _ _ _ P hP t hu hunit happrox n e hei hgen hcd hMfin
  classical
  set N : Submodule Vh (TensorProduct T Vh A) :=
    Submodule.span Vh (Set.range fun i => TensorProduct.tmul T (1 : Vh) (e i)) with hN
  set M := integralClosure Vh (TensorProduct T Vh A) with hM
  have h1P : (1 : T) ∉ P := (Ideal.ne_top_iff_one P).mp hP.ne_top

  have dag : ∀ (r : T) (a : A), TensorProduct.tmul T (1 : Vh) (r • a) =
      algebraMap T Vh r • TensorProduct.tmul T (1 : Vh) a := by
    intro r a
    rw [algebraMap_smul, TensorProduct.tmul_smul]

  have hstar : ∀ y ∈ Submodule.span T (Set.range e), TensorProduct.tmul T (1 : Vh) y ∈ N := by
    intro y hy
    induction hy using Submodule.span_induction with
    | mem x hx => obtain ⟨i, rfl⟩ := hx; exact Submodule.subset_span ⟨i, rfl⟩
    | zero => rw [TensorProduct.tmul_zero]; exact N.zero_mem
    | add x y _ _ hx hy => rw [TensorProduct.tmul_add]; exact N.add_mem hx hy
    | smul r x _ hx => rw [dag]; exact N.smul_mem _ hx

  have s1 : ∀ r : TensorProduct T Vh A, ∃ k : ℕ, algebraMap T Vh t ^ k • r ∈ N := by
    intro r
    induction r using TensorProduct.induction_on with
    | zero => exact ⟨0, by rw [smul_zero]; exact N.zero_mem⟩
    | tmul v a =>
      obtain ⟨k, f, hf, hy⟩ := hgen a
      obtain ⟨w, hw⟩ := (hunit f hf).exists_left_inv
      refine ⟨k, ?_⟩
      have hva : TensorProduct.tmul T v a = v • TensorProduct.tmul T (1 : Vh) a := by
        rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
      have h1 : (algebraMap T Vh f * algebraMap T Vh t ^ k) • TensorProduct.tmul T v a =
          v • TensorProduct.tmul T (1 : Vh) (algebraMap T A (t ^ k * f) * a) := by
        rw [← Algebra.smul_def (t ^ k * f) a, dag, hva, smul_smul, smul_smul, map_mul, map_pow]
        congr 1
        ring
      have h2 : (algebraMap T Vh f * algebraMap T Vh t ^ k) • TensorProduct.tmul T v a ∈ N := by
        rw [h1]; exact N.smul_mem _ (hstar _ hy)
      have h3 : algebraMap T Vh t ^ k • TensorProduct.tmul T v a =
          w • ((algebraMap T Vh f * algebraMap T Vh t ^ k) • TensorProduct.tmul T v a) := by
        rw [smul_smul, ← mul_assoc, hw, one_mul]
      rw [h3]; exact N.smul_mem _ h2
    | add x y hx hy =>
      obtain ⟨k₁, hk₁⟩ := hx
      obtain ⟨k₂, hk₂⟩ := hy
      refine ⟨k₁ + k₂, ?_⟩
      rw [smul_add]
      refine N.add_mem ?_ ?_
      · rw [pow_add, mul_comm, mul_smul]; exact N.smul_mem _ hk₁
      · rw [pow_add, mul_smul]; exact N.smul_mem _ hk₂

  obtain ⟨S₀, hS₀⟩ := hMfin.fg_top
  choose kf hkf using s1
  set G : Finset (TensorProduct T Vh A) := S₀.image Subtype.val with hG
  set c := G.sup kf with hc
  have hGM : ∀ x ∈ G, x ∈ M := by
    intro x hx
    obtain ⟨y, -, rfl⟩ := Finset.mem_image.mp hx
    exact y.2
  have hGN : ∀ x ∈ G, algebraMap T Vh t ^ c • x ∈ N := by
    intro x hx
    have hle : kf x ≤ c := Finset.le_sup hx
    have hpow : algebraMap T Vh t ^ c =
        algebraMap T Vh t ^ (c - kf x) * algebraMap T Vh t ^ kf x := by
      rw [← pow_add, Nat.sub_add_cancel hle]
    rw [hpow, mul_smul]
    exact N.smul_mem _ (hkf x)
  have hMG : ∀ y ∈ M, y ∈ Submodule.span Vh (G : Set (TensorProduct T Vh A)) := by
    intro y hy
    have hx : (⟨y, hy⟩ : M) ∈ Submodule.span Vh (S₀ : Set M) := hS₀ ▸ Submodule.mem_top
    have := Submodule.mem_map_of_mem (f := M.val.toLinearMap) hx
    rw [Submodule.map_span] at this
    have e' : ((S₀.image Subtype.val : Finset _) : Set (TensorProduct T Vh A)) =
        M.val.toLinearMap '' (S₀ : Set _) := by
      ext y; simp
    rw [hG, e']; exact this

  obtain ⟨ui, hui⟩ := hu.exists_left_inv
  have hUunit : IsUnit (algebraMap T (TensorProduct T Vh A) t) := by
    have : algebraMap T (TensorProduct T Vh A) t =
        Algebra.TensorProduct.includeRight (algebraMap T A t) :=
      (Algebra.TensorProduct.includeRight.commutes t).symm
    rw [this]; exact hu.map _
  have hτR : ∀ (k : ℕ) (w : TensorProduct T Vh A),
      algebraMap T Vh t ^ k • w = algebraMap T (TensorProduct T Vh A) t ^ k * w := by
    intro k w
    rw [← map_pow, algebraMap_smul, Algebra.smul_def, map_pow]
  have s4 : ∀ (x n' : TensorProduct T Vh A) (s : Vh) (α : A),
      s • (algebraMap T Vh t ^ c • x) - TensorProduct.tmul T (1 : Vh) α =
        algebraMap T Vh t ^ c • n' →
      ∃ β : A, s • x - TensorProduct.tmul T (1 : Vh) β = n' := by
    intro x n' s α h
    refine ⟨ui ^ c * α, ?_⟩
    have h3 : algebraMap T Vh t ^ c • TensorProduct.tmul T (1 : Vh) (ui ^ c * α) =
        TensorProduct.tmul T (1 : Vh) α := by
      rw [← map_pow, ← dag, Algebra.smul_def, map_pow, ← mul_assoc, ← mul_pow,
        mul_comm (algebraMap T A t), hui, one_pow, one_mul]
    have h4 : algebraMap T Vh t ^ c • (s • x - TensorProduct.tmul T (1 : Vh) (ui ^ c * α) - n') = 0 := by
      rw [smul_sub, smul_sub, h3, smul_comm (algebraMap T Vh t ^ c) s x, ← h, sub_self]
    rw [hτR] at h4
    have := (hUunit.pow c).mul_right_eq_zero.mp h4
    exact sub_eq_zero.mp this

  have s3 : ∀ (X : Set (TensorProduct T Vh A)) (D : Submodule T A)
      (Q : Submodule Vh (TensorProduct T Vh A)),
      (∀ x ∈ X, algebraMap T Vh t ^ c • x ∈ Q) →
      (∀ x ∈ X, ∃ σ : T, σ ∉ P ∧ ∃ a ∈ D,
        algebraMap T Vh σ • x - TensorProduct.tmul T (1 : Vh) a ∈ Q) →
      ∀ y ∈ Submodule.span Vh X, algebraMap T Vh t ^ c • y ∈ Q ∧ ∃ σ : T, σ ∉ P ∧ ∃ a ∈ D,
        algebraMap T Vh σ • y - TensorProduct.tmul T (1 : Vh) a ∈ Q := by
    intro X D Q hXQ hXa y hy
    induction hy using Submodule.span_induction with
    | mem x hx => exact ⟨hXQ x hx, hXa x hx⟩
    | zero =>
      refine ⟨by rw [smul_zero]; exact Q.zero_mem, 1, h1P, 0, D.zero_mem, ?_⟩
      rw [smul_zero, TensorProduct.tmul_zero, sub_zero]; exact Q.zero_mem
    | add y₁ y₂ _ _ h₁ h₂ =>
      obtain ⟨hq₁, σ₁, hσ₁, a₁, ha₁, hd₁⟩ := h₁
      obtain ⟨hq₂, σ₂, hσ₂, a₂, ha₂, hd₂⟩ := h₂
      refine ⟨by rw [smul_add]; exact Q.add_mem hq₁ hq₂, σ₁ * σ₂, hP.mul_notMem hσ₁ hσ₂,
        σ₂ • a₁ + σ₁ • a₂, D.add_mem (D.smul_mem _ ha₁) (D.smul_mem _ ha₂), ?_⟩
      have : algebraMap T Vh (σ₁ * σ₂) • (y₁ + y₂) -
          TensorProduct.tmul T (1 : Vh) (σ₂ • a₁ + σ₁ • a₂) =
          algebraMap T Vh σ₂ • (algebraMap T Vh σ₁ • y₁ - TensorProduct.tmul T (1 : Vh) a₁) +
          algebraMap T Vh σ₁ • (algebraMap T Vh σ₂ • y₂ - TensorProduct.tmul T (1 : Vh) a₂) := by
        rw [TensorProduct.tmul_add, dag, dag, map_mul]
        module
      rw [this]; exact Q.add_mem (Q.smul_mem _ hd₁) (Q.smul_mem _ hd₂)
    | smul v y _ h =>
      obtain ⟨hq, σ, hσ, a, ha, hd⟩ := h
      obtain ⟨p, s, v', hs, hv⟩ := happrox c v
      refine ⟨?_, s * σ, hP.mul_notMem hs hσ, p • a, D.smul_mem _ ha, ?_⟩
      · rw [smul_comm]; exact Q.smul_mem _ hq
      · have e1 : algebraMap T Vh (s * σ) • (v • y) =
            (algebraMap T Vh σ * (algebraMap T Vh s * v)) • y := by
          rw [smul_smul, map_mul]; congr 1; ring
        have : algebraMap T Vh (s * σ) • (v • y) - TensorProduct.tmul T (1 : Vh) (p • a) =
            algebraMap T Vh p • (algebraMap T Vh σ • y - TensorProduct.tmul T (1 : Vh) a) +
            (v' * algebraMap T Vh σ) • (algebraMap T Vh t ^ c • y) := by
          rw [dag, e1, hv]
          module
        rw [this]; exact Q.add_mem (Q.smul_mem _ hd) (Q.smul_mem _ hq)

  have heM : ∀ i, TensorProduct.tmul T (1 : Vh) (e i) ∈ M := by
    intro i
    exact ((hei i).map (Algebra.TensorProduct.includeRight :
      A →ₐ[T] TensorProduct T Vh A)).tower_top
  have hNM : ∀ z ∈ N, z ∈ M := by
    intro z hz
    have hle : N ≤ Subalgebra.toSubmodule M := by
      rw [hN, Submodule.span_le]
      rintro _ ⟨i, rfl⟩
      exact heM i
    exact hle hz

  set Q₁ : Submodule Vh (TensorProduct T Vh A) :=
    N.map (LinearMap.lsmul Vh (TensorProduct T Vh A) (algebraMap T Vh t ^ c)) with hQ₁
  have hQ₁mem : ∀ w ∈ N, algebraMap T Vh t ^ c • w ∈ Q₁ := fun w hw =>
    Submodule.mem_map.mpr ⟨w, hw, by simp⟩
  have hc1 := s3 (Set.range fun i => TensorProduct.tmul T (1 : Vh) (e i))
    (Submodule.span T (Set.range e)) Q₁
    (by rintro _ ⟨i, rfl⟩; exact hQ₁mem _ (Submodule.subset_span ⟨i, rfl⟩))
    (by
      rintro _ ⟨i, rfl⟩
      refine ⟨1, h1P, e i, Submodule.subset_span ⟨i, rfl⟩, ?_⟩
      rw [map_one, one_smul, sub_self]; exact Q₁.zero_mem)

  have hlift : ∀ x ∈ G, ∃ σ : T, σ ∉ P ∧ ∃ β : A,
      algebraMap T Vh σ • x - TensorProduct.tmul T (1 : Vh) β ∈ N := by
    intro x hx
    obtain ⟨-, σ, hσ, α, -, hα⟩ := hc1 _ (hGN x hx)
    obtain ⟨w, hw, hweq⟩ := Submodule.mem_map.mp hα
    rw [LinearMap.lsmul_apply] at hweq
    obtain ⟨β, hβ⟩ := s4 x w (algebraMap T Vh σ) α hweq.symm
    exact ⟨σ, hσ, β, by rw [hβ]; exact hw⟩
  choose! σf hσf βf hβf using hlift

  set E : Finset A := Finset.univ.image e ∪ G.image βf with hE
  have heE : Set.range e ⊆ (E : Set A) := by
    rintro _ ⟨i, rfl⟩
    exact Finset.mem_coe.mpr (Finset.mem_union_left _ (Finset.mem_image_of_mem e (Finset.mem_univ i)))
  refine ⟨E, ?_, ?_⟩
  · intro x hx
    rcases Finset.mem_union.mp hx with h | h
    · obtain ⟨i, -, rfl⟩ := Finset.mem_image.mp h
      exact heM i
    · obtain ⟨y, hy, rfl⟩ := Finset.mem_image.mp h
      have h1 : TensorProduct.tmul T (1 : Vh) (βf y) = algebraMap T Vh (σf y) • y -
          (algebraMap T Vh (σf y) • y - TensorProduct.tmul T (1 : Vh) (βf y)) := by
        rw [sub_sub_cancel]
      rw [h1]
      exact M.sub_mem (M.smul_mem (hGM y hy) _) (hNM _ (hβf y hy))
  ·
    intro a ha
    have hc2 := s3 (G : Set (TensorProduct T Vh A)) (Submodule.span T (E : Set A)) N
      (fun x hx => hGN x (Finset.mem_coe.mp hx))
      (fun x hx => ⟨σf x, hσf x (Finset.mem_coe.mp hx), βf x,
        Submodule.subset_span (Finset.mem_coe.mpr
          (Finset.mem_union_right _ (Finset.mem_image_of_mem βf (Finset.mem_coe.mp hx)))),
        hβf x (Finset.mem_coe.mp hx)⟩)
    obtain ⟨-, σ, hσ, b, hb, hd⟩ := hc2 _ (hMG _ ha)
    have h1 : TensorProduct.tmul T (1 : Vh) (algebraMap T A σ * a - b) ∈ N := by
      rw [TensorProduct.tmul_sub, ← Algebra.smul_def, dag]; exact hd
    obtain ⟨g, hg, hgΛ⟩ := hcd _ h1
    refine ⟨g * σ, hP.mul_notMem hg hσ, ?_⟩
    have h2 : algebraMap T A (g * σ) * a =
        algebraMap T A g * (algebraMap T A σ * a - b) + g • b := by
      rw [Algebra.smul_def, map_mul]; ring
    rw [h2]
    exact Submodule.add_mem _ (Submodule.span_mono heE hgΛ) (Submodule.smul_mem _ g hb)

theorem wcpa_dj_lr1s_nf_cnf_fmp_gb_dc_integral_generators : ∀ (T A R : Type u) [CommRing T] [CommRing A] [IsDomain A] [CommRing R] [Algebra T A] [Algebra T R] (P : Ideal T), P.IsPrime → Function.Injective (algebraMap T A) → ∀ (ι : A →ₐ[T] R) (M : Subalgebra T R) (E : Finset A), (∀ x ∈ E, ι x ∈ M) → (∀ a : A, ι a ∈ M → ∃ g : T, g ∉ P ∧ algebraMap T A g * a ∈ Submodule.span T (E : Set A)) → (∀ a : A, IsIntegral T a → ι a ∈ M) → ∃ S : Finset A, (∀ s ∈ S, IsIntegral T s) ∧ ∀ a : A, IsIntegral T a → ∃ g : T, g ∉ P ∧ algebraMap T A g * a ∈ Submodule.span T (S : Set A) :=
by
  intro T A R _ _ _ _ _ _ P hP hinj ι M E hE hden hint
  classical
  have hcd : ∀ F : Finset A, (∀ z ∈ F, ∃ g : T, g ∉ P ∧
      algebraMap T A g * z ∈ Submodule.span T (E : Set A)) →
      ∃ s : T, s ∉ P ∧ ∀ z ∈ F, algebraMap T A s * z ∈ Submodule.span T (E : Set A) := by
    intro F
    induction F using Finset.induction_on with
    | empty =>
      intro _
      exact ⟨1, fun h => hP.ne_top ((Ideal.eq_top_iff_one P).mpr h), fun z hz => by simp at hz⟩
    | insert z F' hz ih =>
      intro H
      obtain ⟨s', hs', hs'F⟩ := ih (fun w hw => H w (Finset.mem_insert_of_mem hw))
      obtain ⟨g, hg, hgz⟩ := H z (Finset.mem_insert_self z F')
      refine ⟨s' * g, hP.mul_notMem hs' hg, fun w hw => ?_⟩
      rcases Finset.mem_insert.mp hw with rfl | hw
      · have := Submodule.smul_mem _ s' hgz
        rw [Algebra.smul_def, ← mul_assoc, ← map_mul] at this
        exact this
      · have := Submodule.smul_mem _ g (hs'F w hw)
        rw [Algebra.smul_def, ← mul_assoc, ← map_mul, mul_comm g s'] at this
        exact this
  obtain ⟨s, hsP, hsF⟩ := hcd (insert 1 ((E ×ˢ E).image (fun p : A × A => p.1 * p.2))) (by
    intro z hz
    rcases Finset.mem_insert.mp hz with rfl | hz
    · exact hden 1 (hint 1 isIntegral_one)
    · obtain ⟨⟨x, y⟩, hxy, rfl⟩ := Finset.mem_image.mp hz
      obtain ⟨hx, hy⟩ := Finset.mem_product.mp hxy
      apply hden
      rw [map_mul]
      exact M.mul_mem (hE x hx) (hE y hy))
  have h1 : algebraMap T A s * 1 ∈ Submodule.span T (E : Set A) :=
    hsF 1 (Finset.mem_insert_self _ _)
  have hxy : ∀ x ∈ E, ∀ y ∈ E, algebraMap T A s * (x * y) ∈ Submodule.span T (E : Set A) :=
    fun x hx y hy => hsF (x * y) (Finset.mem_insert_of_mem
      (Finset.mem_image.mpr ⟨(x, y), Finset.mem_product.mpr ⟨hx, hy⟩, rfl⟩))
  have hs0 : algebraMap T A s ≠ 0 := by
    intro h
    apply hsP
    have : s = 0 := hinj (by rw [h, map_zero])
    rw [this]; exact P.zero_mem
  have hne : Submodule.span T (E : Set A) ≠ ⊥ := by
    intro hbot
    rw [hbot, mul_one, Submodule.mem_bot] at h1
    exact hs0 h1
  have hintE : ∀ x ∈ E, IsIntegral T (algebraMap T A s * x) := by
    intro x hx
    refine isIntegral_of_smul_mem_submodule (M := A) (Submodule.span T (E : Set A)) hne
      (Submodule.fg_span E.finite_toSet) _ ?_
    intro n hn
    have hle : Submodule.span T (E : Set A) ≤ (Submodule.span T (E : Set A)).comap
        (LinearMap.mulLeft T (algebraMap T A s * x)) := by
      rw [Submodule.span_le]
      intro y hy
      rw [SetLike.mem_coe, Submodule.mem_comap, LinearMap.mulLeft_apply, mul_assoc]
      exact hxy x hx y hy
    have := hle hn
    rw [Submodule.mem_comap, LinearMap.mulLeft_apply] at this
    exact this
  refine ⟨E.image (fun x => algebraMap T A s * x), ?_, ?_⟩
  · intro t ht
    obtain ⟨x, hx, rfl⟩ := Finset.mem_image.mp ht
    exact hintE x hx
  · have hle : Submodule.span T (E : Set A) ≤ (Submodule.span T
        ((E.image (fun x => algebraMap T A s * x) : Finset A) : Set A)).comap
        (LinearMap.mulLeft T (algebraMap T A s)) := by
      rw [Submodule.span_le]
      intro y hy
      rw [SetLike.mem_coe, Submodule.mem_comap, LinearMap.mulLeft_apply]
      exact Submodule.subset_span (Finset.mem_coe.mpr (Finset.mem_image_of_mem _ hy))
    intro a ha
    obtain ⟨g, hg, hga⟩ := hden a (hint a ha)
    refine ⟨s * g, hP.mul_notMem hsP hg, ?_⟩
    have := hle hga
    rw [Submodule.mem_comap, LinearMap.mulLeft_apply] at this
    rw [map_mul, mul_assoc]
