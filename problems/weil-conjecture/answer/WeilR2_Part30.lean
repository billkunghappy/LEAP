  intro V B _ _ _ _ t hinj hunit htnu hdiv h4a h5 x y
  classical

  have KF : ∀ (r : V) (w : B), IsIntegral V w → algebraMap V B r * w = 1 → IsUnit r := by
    intro r w hw hrw
    obtain ⟨P, hPm, hPw⟩ := hw
    let _ : Invertible w := ⟨algebraMap V B r, hrw, by rw [mul_comm]; exact hrw⟩
    have h1 := Polynomial.eval₂_reverse_mul_pow (algebraMap V B) w P
