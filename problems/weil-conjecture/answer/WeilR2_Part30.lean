theorem wcpa_dj_lr1k_ndmf_hens_levels : ∀ (A T P : Type u) [CommRing A] [CommRing T] [CommRing P]
    (p : Ideal A) (𝔫 : Ideal T) (e : A →+* P) (f : T →+* P), p.IsMaximal → 𝔫.IsMaximal →
    wcNdIsHens p P e → wcNdIsHens 𝔫 P f → ∀ (I : Ideal A) (J : Ideal T), I ≤ p → J ≤ 𝔫 →
    Ideal.map e I = Ideal.map f J →
    ∃ θ : ∀ n : ℕ, (A ⧸ (I ⊔ p ^ n)) ≃+* (T ⧸ (J ⊔ 𝔫 ^ n)),
      ∀ (n : ℕ) (x : A) (y : T), θ (n + 1) (Ideal.Quotient.mk _ x) = Ideal.Quotient.mk _ y →
        θ n (Ideal.Quotient.mk _ x) = Ideal.Quotient.mk _ y :=
by
  intro A T P _ _ _ p 𝔫 e f hp h𝔫 he hf I J hI hJ hIJ

  have s1 : ∀ (R : Type u) [CommRing R] (q 𝔞 : Ideal R) (n : ℕ), q.IsMaximal → n ≠ 0 →
