          Ideal.Quotient.eq_zero_iff_mem]
        exact Ideal.mem_sup_left hi
      have h2 : 𝔪 ^ n ≤ RingHom.ker α := by
        rw [← Ideal.map_eq_bot_iff_le_ker, Ideal.map_pow, eq_bot_iff, ← hnilR]
        apply Ideal.pow_right_mono
        rw [Ideal.map_le_iff_le_comap]
