  have wcpa_dj_lr1k_eb_bd_lb_iru_residue_poly : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (V : ValuationSubring (RatFunc Ω)) (θ : RatFunc (IsLocalRing.ResidueField ↥W) ≃+* IsLocalRing.ResidueField ↥V), (∀ w : ↥W, algebraMap Ω (RatFunc Ω) (w : Ω) ∈ V) → (RatFunc.X : RatFunc Ω) ∈ V → (∀ h : (RatFunc.X : RatFunc Ω) ∈ V, θ RatFunc.X = IsLocalRing.residue ↥V ⟨RatFunc.X, h⟩) → (∀ (w : ↥W) (h : algebraMap Ω (RatFunc Ω) (w : Ω) ∈ V), θ (algebraMap (IsLocalRing.ResidueField ↥W) (RatFunc (IsLocalRing.ResidueField ↥W)) (IsLocalRing.residue ↥W w)) = IsLocalRing.residue ↥V ⟨algebraMap Ω (RatFunc Ω) (w : Ω), h⟩) → ∀ P : Polynomial ↥W, ∃ h : algebraMap (Polynomial Ω) (RatFunc Ω) (P.map W.subtype) ∈ V, IsLocalRing.residue ↥V ⟨algebraMap (Polynomial Ω) (RatFunc Ω) (P.map W.subtype), h⟩ = θ (algebraMap (Polynomial (IsLocalRing.ResidueField ↥W)) (RatFunc (IsLocalRing.ResidueField ↥W)) (P.map (IsLocalRing.residue ↥W))) := by
