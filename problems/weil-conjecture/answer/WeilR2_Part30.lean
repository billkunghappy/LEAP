  obtain ⟨σ₀V, hσ₀V⟩ : ∃ σ₀V : Spec (.of ↥W) ⟶ V.toScheme, σ₀V ≫ V.ι = σ₀ :=
    ⟨IsOpenImmersion.lift V.ι σ₀ hrange, IsOpenImmersion.lift_fac _ _ _⟩

