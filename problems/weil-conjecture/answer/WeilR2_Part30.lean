    intro w
    rw [RatFunc.algebraMap_C, RatFunc.algebraMap_eq_C]
  have h1b : (1 : Polynomial Ω).coeff 0 * c ^ 0 ≠ 0 := by simp
  have h1a : ∀ j, (1 : Polynomial Ω).coeff j * c ^ j / ((1 : Polynomial Ω).coeff 0 * c ^ 0) ∈ W := by
    intro j
    rw [Polynomial.coeff_one_zero, pow_zero, mul_one, div_one, Polynomial.coeff_one]
    split_ifs with h
    · subst h
      rw [pow_zero, mul_one]
      exact W.one_mem
    · rw [zero_mul]
      exact W.zero_mem
  refine ⟨fun w => ⟨?_, ?_⟩, fun P => ?_⟩
  ·
    rintro ⟨p, q, i, hne, heq, -, hp⟩
