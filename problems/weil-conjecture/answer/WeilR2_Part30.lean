      rw [Polynomial.lifts_iff_coeff_lifts]
      intro n
      rw [Polynomial.coeff_C_mul]
      by_cases hn : n ∈ Finset.range (p.natDegree + 1)
      · refine ⟨r n * ∏ j ∈ (Finset.range (p.natDegree + 1)).erase n, s j, ?_⟩
        simp only [hφapp, map_mul, map_prod]
        rw [← Finset.mul_prod_erase (Finset.range (p.natDegree + 1))
          (fun j => MvPolynomial.aeval z (s j)) hn, ← hsr n]
        ring
      · refine ⟨0, ?_⟩
        have hn' : p.natDegree < n := by
          rw [Finset.mem_range] at hn; omega
