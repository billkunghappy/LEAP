    · set 𝔐 := Ideal.map φ 𝔫 with h𝔐
      haveI : 𝔐.IsPrime := hmax.isPrime
      let R := LocalSubring.ofPrime A 𝔐
      obtain ⟨V, hRV⟩ := R.exists_le_valuationSubring
      obtain ⟨hle, hloc⟩ := LocalSubring.le_def.mp hRV
      have hAR : A ≤ R.toSubring := LocalSubring.le_ofPrime A 𝔐
      have hinV : ∀ P, f₀ P ∈ V := fun P => hle (hAR (RingHom.mem_range_self f₀ P))
      have hlt : ∀ P ∈ 𝔫, V.valuation (f₀ P) < 1 := by
