    obtain ⟨w, hw⟩ := hu.exists_left_inv
    refine LinearMap.mem_range.mpr ⟨w * a, ?_⟩
    funext i
    have hai : Ideal.Quotient.mk i.1 a = Ideal.Quotient.mk i.1 (algebraMap T A t) * x i := by
      have h := congrFun ha i
      change Ideal.Quotient.mkₐ T i.1 a = t • x i at h
      rw [Algebra.smul_def, ← (Ideal.Quotient.mkₐ T i.1).commutes t,
        Ideal.Quotient.mkₐ_eq_mk] at h
      exact h
    show Ideal.Quotient.mkₐ T i.1 (w * a) = x i
    rw [Ideal.Quotient.mkₐ_eq_mk, map_mul, hai, ← mul_assoc, ← map_mul, hw, map_one, one_mul]
  have hK : (Submodule.comap f (LinearMap.range πL)).FG :=
    hker _ _ inferInstance f (LinearMap.range πL) hsat
  let φ : integralClosure T A →ₗ[T] (∀ i : ↥(minimalPrimes A), integralClosure T (A ⧸ i.1)) :=
    { toFun := fun x i => ⟨Ideal.Quotient.mkₐ T i.1 (x : A),
        _root_.IsIntegral.map (Ideal.Quotient.mkₐ T i.1) x.2⟩
      map_add' := by
        intro x y
        funext i
        apply Subtype.ext
        exact map_add (Ideal.Quotient.mkₐ T i.1) (x : A) (y : A)
      map_smul' := by
        intro c x
        funext i
        apply Subtype.ext
        exact map_smul (Ideal.Quotient.mkₐ T i.1) c (x : A) }
  have hinj : Function.Injective φ := by
    rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
    intro x hx
    have hx0 : (x : A) = 0 := by
      apply hzero
      intro p hp
      have h := congrArg (fun e => ((e ⟨p, hp⟩ : integralClosure T (A ⧸ p)) : A ⧸ p)) hx
      change Ideal.Quotient.mkₐ T p (x : A) = 0 at h
      rw [Ideal.Quotient.mkₐ_eq_mk] at h
      exact Ideal.Quotient.eq_zero_iff_mem.mp h
    exact Subtype.ext hx0
  have hrange : LinearMap.range φ = Submodule.comap f (LinearMap.range πL) := by
    ext e
    constructor
    · rintro ⟨x, rfl⟩
      exact LinearMap.mem_range.mpr ⟨(x : A), rfl⟩
    · intro he
      obtain ⟨a, ha⟩ := LinearMap.mem_range.mp (Submodule.mem_comap.mp he)
      have hcomp : ∀ i : ↥(minimalPrimes A),
          Ideal.Quotient.mk i.1 a = ((e i : integralClosure T (A ⧸ i.1)) : A ⧸ i.1) :=
        fun i => congrFun ha i
      have hint : _root_.IsIntegral T a := hdetect a (fun i => by rw [hcomp i]; exact (e i).2)
      refine ⟨⟨a, hint⟩, ?_⟩
      funext i
      apply Subtype.ext
      exact hcomp i
  haveI hKfin : Module.Finite T (Submodule.comap f (LinearMap.range πL)) :=
    Module.Finite.iff_fg.mpr hK
  exact Module.Finite.equiv
    ((LinearEquiv.ofInjective φ hinj).trans (LinearEquiv.ofEq _ _ hrange)).symm

theorem wcpa_dj_lr1s_nf_cnf_fmp_closure_base_change : ∀ (T₀ T A : Type u) [CommRing T₀] [CommRing T] [CommRing A] [Algebra T₀ T] [Algebra T A] [Algebra T₀ A] [IsScalarTower T₀ T A], (∃ H : Finset A, (↑H : Set A) ⊆ Set.range (algebraMap T A) ∧ ∀ x : T, algebraMap T A x ∈ Submodule.span T₀ (H : Set A)) → Module.Finite T₀ ↥(integralClosure T₀ A) → Module.Finite T ↥(integralClosure T A) :=
