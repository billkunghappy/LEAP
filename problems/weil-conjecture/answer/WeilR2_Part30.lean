  have hrange : Set.range σ₀.base ⊆ Set.range V.ι.base := by
    rintro _ ⟨p, rfl⟩
    have hp : p ∈ σ₀ ⁻¹ᵁ V := e₀ (show p ∈ (⊤ : (Spec (.of ↥W)).Opens) from trivial)
