    obtain ⟨x, hx⟩ := IsLocalRing.residue_surjective (ξ i k)
    obtain ⟨Y, h1, h2⟩ := hRA i x x.2
    have hYi : Y ∈ V i := by
      have e : Y = (Y - x) + x := by ring
      rw [e]
      exact add_mem (((V i).valuation_le_one_iff _).mp h1.le) x.2
    have hYj : ∀ j, Y ∈ V j := by
      intro j
      by_cases hj : j = i
      · subst hj; exact hYi
      · exact ((V j).valuation_le_one_iff _).mp (h2 j hj).le
    refine ⟨Y, hYj, ?_, h2⟩
    rw [← hx, ← sub_eq_zero, ← map_sub, IsLocalRing.residue_eq_zero_iff,
      ValuationSubring.valuation_lt_one_iff]
    exact h1
  choose Y hYmem hYres hYsmall using hY

  have hspan : ∀ z : L, (∀ j, z ∈ V j) → ∃ a : (Σ i, Fin (wcEbBdResDeg K (V i))) → K,
      (∀ p, a p ∈ O) ∧ ∀ j, (V j).valuation (z - ∑ p, algebraMap K L (a p) * Y p.1 p.2) < 1 := by
    intro z hz
    choose c hc using fun i => hξ i (IsLocalRing.residue ↥(V i) ⟨z, hz i⟩)
    choose α hα using fun (p : Σ i, Fin (wcEbBdResDeg K (V i))) =>
      IsLocalRing.residue_surjective (c p.1 p.2)
    refine ⟨fun p => (α p : K), fun p => ?_, fun j => ?_⟩
    · rw [← hcomap p.1]; exact (α p).2
    have hAmem : ∀ p, algebraMap K L (α p : K) ∈ V j := fun p => by
      have h2 : (α p : K) ∈ (V j).comap (algebraMap K L) := by
        rw [hcomap j, ← hcomap p.1]; exact (α p).2
      exact h2
    have key : IsLocalRing.residue ↥(V j) ((⟨z, hz j⟩ : ↥(V j)) - ∑ p,
        (⟨algebraMap K L (α p : K), hAmem p⟩ : ↥(V j)) * ⟨Y p.1 p.2, hYmem p.1 p.2 j⟩) = 0 := by
      rw [map_sub, map_sum]
      simp_rw [map_mul]
