theorem wcpa_dj_lr1s_nf_completion_normalization_finite : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → ∀ (ϖ : ↥W), ϖ ≠ 0 → ¬ IsUnit ϖ → (∀ c : ↥W, c ≠ 0 → ∃ n : ℕ, c ∣ ϖ ^ n) → ∀ (C B : Type u) [CommRing C] [CommRing B] [Algebra ↥W C] [Algebra C B] [Algebra Ω B] [Algebra ↥W B] [IsScalarTower ↥W C B] [IsScalarTower ↥W Ω B], Function.Injective (algebraMap C B) → Algebra.FiniteType ↥W C → Algebra.FiniteType Ω B → _root_.IsReduced B → (∀ b : B, ∃ n : ℕ, ∃ a : C, algebraMap ↥W B ϖ ^ n * b = algebraMap C B a) → _root_.IsReduced (Localization.Away (algebraMap C (AdicCompletion (Ideal.span {algebraMap (↥W) C ϖ}) C) (algebraMap (↥W) C ϖ))) → Module.Finite (AdicCompletion (Ideal.span {algebraMap (↥W) C ϖ}) C) ↥(integralClosure (AdicCompletion (Ideal.span {algebraMap (↥W) C ϖ}) C) (Localization.Away (algebraMap C (AdicCompletion (Ideal.span {algebraMap (↥W) C ϖ}) C) (algebraMap (↥W) C ϖ)))) :=
