        _ = τ ^ j * (y * e ^ N) := by rw [h]; ring
    let S : ℕ → Prop := fun j => ∃ y : B, IsIntegral V y ∧ τ ^ (M * N) * x ^ N = τ ^ j * y
    have hS0 : S 0 := ⟨(τ ^ M * x) ^ N, hM.pow N, by ring⟩
    have hSb : ∀ j, S j → j ≤ M * N + j₀ * N := fun j ⟨y, hy, h⟩ => hbound j y hy h
    have hspec : S (Nat.findGreatest S (M * N + j₀ * N)) :=
      Nat.findGreatest_spec (Nat.zero_le _) hS0
    have hnot : ¬ S (Nat.findGreatest S (M * N + j₀ * N) + 1) := by
      intro hS
      have h1 := hSb _ hS
      have h2 := Nat.le_findGreatest h1 hS
      omega
    obtain ⟨y₁, hy₁, h₁⟩ := hspec
