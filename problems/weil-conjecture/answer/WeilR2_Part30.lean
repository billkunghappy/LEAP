    have h0 : u' (hV.fromSpec 𝔭) = IsLocalRing.closedPoint ↥W' := by rw [h𝔭x, hux]
    have h1 : (hV.fromSpec ≫ u') 𝔭 = IsLocalRing.closedPoint ↥W' :=
      (Scheme.Hom.comp_apply hV.fromSpec u' 𝔭).trans h0
    rw [← hθ] at h1
    have h2 : PrimeSpectrum.comap θ.hom 𝔭 = IsLocalRing.closedPoint ↥W' :=
      (Spec.map_apply θ 𝔭).symm.trans h1
    exact congrArg PrimeSpectrum.asIdeal h2

  have hres : ∃ σb : D →ₐ[↥W'] IsLocalRing.ResidueField ↥W',
      ∀ d : D, σb d = 0 ↔ d ∈ 𝔭.asIdeal := by
    haveI := h𝔭max
    letI : Field (D ⧸ 𝔭.asIdeal) := Ideal.Quotient.field 𝔭.asIdeal
    let f : ↥W' →+* D ⧸ 𝔭.asIdeal := (Ideal.Quotient.mk 𝔭.asIdeal).comp (algebraMap ↥W' D)
    have hf0 : ∀ a, f a = 0 ↔ a ∈ IsLocalRing.maximalIdeal ↥W' := by
      intro a
      rw [← h𝔭comap, Ideal.mem_comap]
      exact Ideal.Quotient.eq_zero_iff_mem
    haveI : IsLocalHom f := by
      constructor
      intro a ha
      by_contra hna
      have : a ∈ IsLocalRing.maximalIdeal ↥W' := (IsLocalRing.mem_maximalIdeal a).mpr hna
      exact ha.ne_zero ((hf0 a).mpr this)
    let ι : IsLocalRing.ResidueField ↥W' →+* D ⧸ 𝔭.asIdeal := IsLocalRing.ResidueField.lift f
    have hιcomp : ι.comp (IsLocalRing.residue ↥W') = f := by
      ext a; exact IsLocalRing.ResidueField.lift_residue_apply f a
    have hfft : f.FiniteType := by
      have h1 : (algebraMap ↥W' D).FiniteType := RingHom.finiteType_algebraMap.mpr inferInstance
      exact h1.comp_surjective Ideal.Quotient.mk_surjective
    have hιft : ι.FiniteType := by
      rw [← hιcomp] at hfft
      exact RingHom.FiniteType.of_comp_finiteType hfft
    letI : Algebra (IsLocalRing.ResidueField ↥W') (D ⧸ 𝔭.asIdeal) := ι.toAlgebra
    haveI : Algebra.FiniteType (IsLocalRing.ResidueField ↥W') (D ⧸ 𝔭.asIdeal) := hιft
    haveI : Module.Finite (IsLocalRing.ResidueField ↥W') (D ⧸ 𝔭.asIdeal) :=
      finite_of_finite_type_of_isJacobsonRing _ _
    haveI : Algebra.IsIntegral (IsLocalRing.ResidueField ↥W') (D ⧸ 𝔭.asIdeal) :=
      Algebra.IsIntegral.of_finite _ _
    have hbij : Function.Bijective ι := IsAlgClosed.algebraMap_bijective_of_isIntegral
    let e := RingEquiv.ofBijective ι hbij
    refine ⟨AlgHom.mk (e.symm.toRingHom.comp (Ideal.Quotient.mk 𝔭.asIdeal)) ?_, ?_⟩
    · intro a
      show e.symm (Ideal.Quotient.mk 𝔭.asIdeal (algebraMap ↥W' D a)) =
        algebraMap ↥W' (IsLocalRing.ResidueField ↥W') a
      rw [IsLocalRing.ResidueField.algebraMap_eq]
      apply e.injective
      rw [RingEquiv.apply_symm_apply]
      show f a = ι (IsLocalRing.residue ↥W' a)
      exact (IsLocalRing.ResidueField.lift_residue_apply f a).symm
    · intro d
      show e.symm (Ideal.Quotient.mk 𝔭.asIdeal d) = 0 ↔ d ∈ 𝔭.asIdeal
      rw [map_eq_zero_iff _ e.symm.injective]
      exact Ideal.Quotient.eq_zero_iff_mem

  obtain ⟨σb, hσb⟩ := hres
  obtain ⟨τ, hτ⟩ := wc_hnas_smooth_section_henselian ↥W' D σb

  let τc : Γ(Z', V) ⟶ CommRingCat.of ↥W' := CommRingCat.ofHom τ.toRingHom
  have hθτ : θ ≫ τc = 𝟙 _ := by
    apply CommRingCat.hom_ext
    apply RingHom.ext
    intro w
    exact τ.commutes w
  refine ⟨Spec.map τc ≫ hV.fromSpec, ?_, ?_, ?_⟩
  · rw [Category.assoc, ← hθ, ← Spec.map_comp, hθτ, Spec.map_id]
  · have hcp : PrimeSpectrum.comap τc.hom (IsLocalRing.closedPoint ↥W') = 𝔭 := by
      refine PrimeSpectrum.ext (Ideal.ext fun d => ?_)
      rw [PrimeSpectrum.comap_asIdeal, Ideal.mem_comap]
      show τ d ∈ IsLocalRing.maximalIdeal ↥W' ↔ d ∈ 𝔭.asIdeal
      rw [← IsLocalRing.residue_eq_zero_iff, hτ d, hσb d]
    exact (Scheme.Hom.comp_apply _ _ _).trans
      ((congrArg hV.fromSpec ((Spec.map_apply τc _).trans hcp)).trans h𝔭x)
  · intro p
    have hpV : (Spec.map τc ≫ hV.fromSpec) p ∈ (V : Set Z') := by
      rw [← hV.range_fromSpec]
      exact ⟨Spec.map τc p, (Scheme.Hom.comp_apply _ _ _).symm⟩
    exact ⟨O', hVO hpV, hO'sm⟩

theorem wcpa_dj_lr1k_ll_dp_delta_zero : ∀ (R : Type u) [CommRing R] [IsLocalRing R],
    ringKrullDim R ≤ 0 → wcpaDjLkDelta R = 0 :=
by
  intro R _ _ h
  classical
  haveI : Ring.KrullDimLE 0 R := Ring.krullDimLE_iff.mpr (by simpa using h)
  have hM : nonZeroDivisors R ≤ IsUnit.submonoid R := by
    intro x hx
    show IsUnit x
    by_contra hu
    have hnil : IsNilpotent x :=
      (Ring.KrullDimLE.isNilpotent_iff_mem_nonunits).mpr (mem_nonunits_iff.mpr hu)
    obtain ⟨n, hn⟩ := hnil
    have h0 : x ^ n ∈ nonZeroDivisors R := pow_mem hx n
    rw [hn] at h0
    exact zero_notMem_nonZeroDivisors h0
  let e := IsLocalization.atUnits R (nonZeroDivisors R) (S := FractionRing R) hM
  have hsurj : Function.Surjective (algebraMap R (FractionRing R)) := by
    intro k
    refine ⟨e.symm k, ?_⟩
    rw [← e.commutes, Algebra.algebraMap_self, RingHom.id_apply, AlgEquiv.apply_symm_apply]
  have hrange : LinearMap.range
      (Algebra.linearMap R ↥(integralClosure R (FractionRing R))) = ⊤ := by
    rw [LinearMap.range_eq_top]
    intro z
    obtain ⟨r, hr⟩ := hsurj (z : FractionRing R)
    refine ⟨r, ?_⟩
    apply Subtype.ext
    rw [Algebra.linearMap_apply]
    exact hr
  unfold wcpaDjLkDelta
  exact Module.length_eq_zero_iff.mpr (Submodule.Quotient.subsingleton_iff.mpr hrange)

theorem wcpa_dj_lr1k_ll_dp_closed_point : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω) (C X : Scheme.{u}) (f : C ⟶ X) [QuasiCompact f] [QuasiSeparated f]
    (uX : X ⟶ Spec (.of ↥W)), wcpaDjSemistable uX →
    ∀ y : ↥(wcpaDjLkFib W f uX),
      ¬ ringKrullDim ((wcpaDjLkFib W f uX).presheaf.stalk y) ≤ 0 →
      IsClosed ({wcpaDjLkPi W f uX y} : Set ↥(Limits.pullback uX
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))))) :=
by

  have s1 : ∀ (T : Type u) [TopologicalSpace T] [T0Space T],
      topologicalKrullDim T ≤ ((1 : ℕ) : WithBot ℕ∞) →
      ∀ (x y' : T), y' ⤳ x → y' ≠ x → IsClosed ({x} : Set T) := by
    intro T _ _ hdim x y' hy hne
    rw [← closure_subset_iff_isClosed]
    intro z hz
    rw [Set.mem_singleton_iff]
    by_contra hzx
    have hxz : x ⤳ z := specializes_iff_mem_closure.mpr hz
    let Z : T → TopologicalSpace.IrreducibleCloseds T := fun a =>
      ⟨closure {a}, isIrreducible_singleton.closure, isClosed_closure⟩
    have hlt : ∀ a b : T, a ⤳ b → a ≠ b → Z b < Z a := by
      intro a b hab hne'
      refine lt_of_le_of_ne (show (Z b : Set T) ⊆ Z a from specializes_iff_closure_subset.mp hab) ?_
      intro heq
      apply hne'
      have hc : closure ({b} : Set T) = closure {a} :=
        congrArg (fun S : TopologicalSpace.IrreducibleCloseds T => (S : Set T)) heq
      exact (inseparable_iff_closure_eq.mpr hc.symm).eq
    have h1 : Z z < Z x := hlt x z hxz (fun h => hzx h.symm)
    have h2 : Z x < Z y' := hlt y' x hy hne
    let s : LTSeries (TopologicalSpace.IrreducibleCloseds T) :=
      LTSeries.mk 2 ![Z z, Z x, Z y'] (by
        rw [Fin.strictMono_iff_lt_succ]
        intro i
        fin_cases i
        · exact h1
        · exact h2)
    have hs := Order.LTSeries.length_le_krullDim s
    have h3 : ((2 : ℕ) : WithBot ℕ∞) ≤ ((1 : ℕ) : WithBot ℕ∞) := le_trans hs hdim
    exact absurd (by exact_mod_cast h3 : (2 : ℕ) ≤ 1) (by norm_num)

  have s2 : ∀ (Y : Scheme.{u}) (y : ↥Y), ¬ ringKrullDim (Y.presheaf.stalk y) ≤ 0 →
      ∃ y' : ↥Y, y' ⤳ y ∧ y' ≠ y := by
    intro Y y hy
    have hnot : ¬ Ring.KrullDimLE 0 (Y.presheaf.stalk y) := fun h =>
      hy (by exact_mod_cast Ring.krullDimLE_iff.mp h)
    have hex : ∃ I : Ideal (Y.presheaf.stalk y), I.IsPrime ∧ ¬ I.IsMaximal := by
      by_contra hc
      push_neg at hc
      exact hnot (Ring.KrullDimLE.mk₀ hc)
    obtain ⟨I, hI, hIm⟩ := hex
    let q : PrimeSpectrum (Y.presheaf.stalk y) := ⟨I, hI⟩
    refine ⟨Y.fromSpecStalk y q, ?_, ?_⟩
    · have hr : Y.fromSpecStalk y q ∈ Set.range (Y.fromSpecStalk y) := ⟨q, rfl⟩
      rw [Scheme.range_fromSpecStalk] at hr
      exact hr
    · intro h
      have h2 := h.trans Scheme.fromSpecStalk_closedPoint.symm
      have h3 := Scheme.Hom.injective (Y.fromSpecStalk y) h2
      have h4 : I = (IsLocalRing.closedPoint (Y.presheaf.stalk y)).asIdeal :=
        congrArg PrimeSpectrum.asIdeal h3
      apply hIm
      rw [h4]
      exact IsLocalRing.maximalIdeal.isMaximal _

  have s3 : ∀ {F Y : Scheme.{u}} (p : F ⟶ Y) [IsIntegralHom p] (y y' : ↥F),
      y' ⤳ y → y' ≠ y → p y' ≠ p y := by
    intro F Y p _ y y' hsp hne heq
    obtain ⟨U', hU', hyU', -⟩ :=
      exists_isAffineOpen_mem_and_subset (x := p y) (U := ⊤) (show p y ∈ (⊤ : Y.Opens) from trivial)
    have hV : IsAffineOpen (p ⁻¹ᵁ U') := hU'.preimage p
    have hy : y ∈ p ⁻¹ᵁ U' := hyU'
    have hy' : y' ∈ p ⁻¹ᵁ U' := hsp.mem_open (p ⁻¹ᵁ U').isOpen hy
    obtain ⟨Q, hQ⟩ : ∃ Q : ↥(Spec Γ(F, p ⁻¹ᵁ U')), hV.fromSpec Q = y :=
      ⟨_, hV.fromSpec_primeIdealOf ⟨y, hy⟩⟩
    obtain ⟨Q', hQ'⟩ : ∃ Q' : ↥(Spec Γ(F, p ⁻¹ᵁ U')), hV.fromSpec Q' = y' :=
      ⟨_, hV.fromSpec_primeIdealOf ⟨y', hy'⟩⟩
    haveI := hV.isOpenImmersion_fromSpec
    have hemb := (hV.fromSpec).isOpenEmbedding
    have hsp' : Q' ⤳ Q := by
      rw [← hemb.isInducing.specializes_iff, hQ, hQ']
      exact hsp
    have hle : Q'.asIdeal ≤ Q.asIdeal := (PrimeSpectrum.le_iff_specializes Q' Q).mpr hsp'
    have hneQ : Q' ≠ Q := by
      intro h
      apply hne
      rw [← hQ, ← hQ', h]
    have hlt : Q'.asIdeal < Q.asIdeal := lt_of_le_of_ne hle (fun h => hneQ (PrimeSpectrum.ext h))
    obtain ⟨t, htQ, htQ'⟩ := SetLike.exists_of_lt hlt
    letI := (p.app U').hom.toAlgebra
    have hint : IsIntegral Γ(Y, U') t := IsIntegralHom.isIntegral_app p U' hU' t
    have hunder := Ideal.under_lt_under_of_integral_mem_sdiff (R := Γ(Y, U'))
      (hI := Q'.isPrime) hle ⟨htQ, htQ'⟩ hint
    have hcomm := IsAffineOpen.SpecMap_appLE_fromSpec p hU' hV le_rfl
    rw [Scheme.Hom.appLE_eq_app] at hcomm
    have e1 : p y = hU'.fromSpec (Spec.map (p.app U') Q) := by
      calc p y = (hV.fromSpec ≫ p) Q := by rw [Scheme.Hom.comp_apply, hQ]
        _ = (Spec.map (p.app U') ≫ hU'.fromSpec) Q := by rw [hcomm]
        _ = hU'.fromSpec (Spec.map (p.app U') Q) := Scheme.Hom.comp_apply _ _ _
    have e2 : p y' = hU'.fromSpec (Spec.map (p.app U') Q') := by
      calc p y' = (hV.fromSpec ≫ p) Q' := by rw [Scheme.Hom.comp_apply, hQ']
        _ = (Spec.map (p.app U') ≫ hU'.fromSpec) Q' := by rw [hcomm]
        _ = hU'.fromSpec (Spec.map (p.app U') Q') := Scheme.Hom.comp_apply _ _ _
    haveI := hU'.isOpenImmersion_fromSpec
    have hinj := Scheme.Hom.injective hU'.fromSpec (e2.symm.trans (heq.trans e1))
    have h4 : Ideal.under Γ(Y, U') Q'.asIdeal = Ideal.under Γ(Y, U') Q.asIdeal :=
      congrArg PrimeSpectrum.asIdeal hinj
    exact hunder.ne h4
  intro Ω _ _ W C X f _ _ uX hss y hdim
  obtain ⟨y', hy'sp, hy'ne⟩ := s2 _ y hdim
  let P := Limits.pullback.map (f.fromNormalization ≫ uX)
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) uX
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))
      f.fromNormalization (𝟙 _) (𝟙 _) (by simp) (by simp)
  haveI hP : IsIntegralHom P :=
    MorphismProperty.pullbackMap (P := @IsIntegralHom) inferInstance inferInstance rfl
      (Category.id_comp _).symm
  have hne : P y' ≠ P y := s3 P y y' hy'sp hy'ne
  have hsp : P y' ⤳ P y := hy'sp.map P.continuous
  have halg := wcpa_dj_nc_residue_algclosed Ω W
  have hd := (wcpa_dj_lus_cvs_ct_closed_fibre_dim Ω W halg X uX hss).2
  exact s1 _ hd _ _ hsp hne

theorem wcpa_dj_lcfse_smooth_etale_chart_open : ∀ {Z S : Scheme.{u}} (uu : Z ⟶ S) (W : Z.Opens), SmoothOfRelativeDimension 1 (W.ι ≫ uu) → ∀ z ∈ W, ∃ (U : S.Opens) (V : Z.Opens) (hle : V ≤ uu ⁻¹ᵁ U) (g : MvPolynomial (Fin 1) Γ(S, U) →+* Γ(Z, V)), IsAffineOpen U ∧ IsAffineOpen V ∧ z ∈ V ∧ g.Etale ∧ g.comp MvPolynomial.C = (uu.appLE U V hle).hom :=
by
  intro Z S uu W hsm z hz
  have := hsm
  obtain ⟨U₀, hU₀, V₀, hV₀, hzV₀, e, hstd⟩ :=
    SmoothOfRelativeDimension.exists_isStandardSmoothOfRelativeDimension (n := 1) (f := W.ι ≫ uu)
      (⟨z, hz⟩ : W.toScheme)
  obtain ⟨g₀, hg₀C, hg₀⟩ := hstd.exists_etale_mvPolynomial
  have hle : W.ι ''ᵁ V₀ ≤ uu ⁻¹ᵁ U₀ := by
    intro y hy
    have hy' : y ∈ (W.ι ''ᵁ V₀ : Set Z) := hy
    rw [Scheme.Hom.coe_image] at hy'
    obtain ⟨x, hx, rfl⟩ := hy'
    have h1 : x ∈ (W.ι ≫ uu) ⁻¹ᵁ U₀ := e hx
    rw [Scheme.Hom.mem_preimage, Scheme.Hom.comp_apply] at h1
    exact h1
  have key : (W.ι ≫ uu).appLE U₀ V₀ e = uu.appLE U₀ (W.ι ''ᵁ V₀) hle := by
    rw [Scheme.Hom.comp_appLE]
    have h := Scheme.Opens.ι_appLE W (uu ⁻¹ᵁ U₀) V₀ (by exact e)
    rw [h, Scheme.Hom.appLE]
    rfl
  refine ⟨U₀, W.ι ''ᵁ V₀, hle, g₀, hU₀, hV₀.image_of_isOpenImmersion W.ι, ?_, hg₀, ?_⟩
  · have h2 := (Scheme.Hom.apply_mem_image_iff W.ι).mpr hzV₀
    simpa using h2
  · exact hg₀C.trans (congrArg CommRingCat.Hom.hom key)

theorem wcpa_dj_lr1k_ll_dp_chart : ∀ (R : Type u) [CommRing R] [IsLocalRing R] (X : Scheme.{u})
    (uX : X ⟶ Spec (.of R)) (W₁ : X.Opens), SmoothOfRelativeDimension 1 (W₁.ι ≫ uX) →
    ∀ x ∈ W₁, uX x = IsLocalRing.closedPoint R →
    ∃ (V : X.Opens) (hle : V ≤ uX ⁻¹ᵁ ⊤) (g : MvPolynomial (Fin 1) R →+* Γ(X, V)),
      IsAffineOpen V ∧ x ∈ V ∧ g.Etale ∧
      g.comp MvPolynomial.C = (uX.appLE ⊤ V hle).hom.comp (Scheme.ΓSpecIso (.of R)).inv.hom :=
by
  intro R _ _ X uX W₁ hsm x hx hxc
  obtain ⟨U, V, hle, g, _hU, hV, hxV, hg, hgC⟩ :=
    wcpa_dj_lcfse_smooth_etale_chart_open uX W₁ hsm x hx
  have hcU : IsLocalRing.closedPoint R ∈ U := by
    rw [← hxc]; exact hle hxV
  have hUtop : U = ⊤ := by
    rw [eq_top_iff]
    intro p _
    exact (IsLocalRing.specializes_closedPoint (R := R) p).mem_open U.isOpen hcU
  subst hUtop
  let ι : R →+* Γ(Spec (.of R), ⊤) := (Scheme.ΓSpecIso (.of R)).inv.hom
  let κ : Γ(Spec (.of R), ⊤) →+* R := (Scheme.ΓSpecIso (.of R)).hom.hom
  have hκι : κ.comp ι = RingHom.id R := by
    show ((Scheme.ΓSpecIso (.of R)).inv ≫ (Scheme.ΓSpecIso (.of R)).hom).hom = _
    rw [Iso.inv_hom_id]; rfl
  have hικ : ι.comp κ = RingHom.id _ := by
    show ((Scheme.ΓSpecIso (.of R)).hom ≫ (Scheme.ΓSpecIso (.of R)).inv).hom = _
    rw [Iso.hom_inv_id]; rfl
  have hbij : Function.Bijective (MvPolynomial.map (σ := Fin 1) ι) := by
    refine Function.bijective_iff_has_inverse.mpr ⟨MvPolynomial.map κ, ?_, ?_⟩
    · intro p; rw [MvPolynomial.map_map, hκι, MvPolynomial.map_id]
    · intro p; rw [MvPolynomial.map_map, hικ, MvPolynomial.map_id]
  have hmapEt : (MvPolynomial.map (σ := Fin 1) ι).Etale := RingHom.Etale.of_bijective hbij
  refine ⟨V, hle, g.comp (MvPolynomial.map ι), hV, hxV,
    RingHom.Etale.stableUnderComposition _ _ hmapEt hg, ?_⟩
  rw [RingHom.comp_assoc, MvPolynomial.map_comp_C, ← RingHom.comp_assoc, hgC]

theorem wcpa_dj_lr1k_ll_dp_section_algebra : ∀ {R A B : Type u} [CommRing R] [CommRing A]
    [CommRing B] (g : MvPolynomial (Fin 1) R →+* A) (θ : A →+* B), g.Etale →
    Function.Bijective (θ.comp (g.comp MvPolynomial.C)) →
    ∀ a : R, θ (g (MvPolynomial.C a)) = θ (g (MvPolynomial.X 0)) →
    ∃ r : A, θ r = 1 ∧ ∀ j ∈ RingHom.ker θ, ∃ y : A,
      r * j = y * (g (MvPolynomial.X 0) - g (MvPolynomial.C a)) :=
by
  intro R A B _ _ _ g θ hg hbij a ha
  classical
  let e : R ≃+* B := RingEquiv.ofBijective (θ.comp (g.comp MvPolynomial.C)) hbij
  let σ : A →+* R := (e.symm : B →+* R).comp θ
  have hσψ : ∀ b, σ (g (MvPolynomial.C b)) = b := by
    intro b
    exact e.symm_apply_apply b
  have hker : RingHom.ker σ = RingHom.ker θ :=
    RingHom.ker_comp_of_injective θ e.symm.injective
  have hσX : σ (g (MvPolynomial.X 0)) = a := by
    show e.symm (θ (g (MvPolynomial.X 0))) = a
    rw [← ha]
    exact e.symm_apply_apply a
  have hdiff : ∀ x, x - g (MvPolynomial.C (σ x)) ∈ RingHom.ker σ := by
    intro x
    rw [RingHom.mem_ker, map_sub, hσψ, sub_self]

  have hfg : (RingHom.ker σ).FG := by
    letI : Algebra R A := (g.comp MvPolynomial.C).toAlgebra
    have hgfp : g.FinitePresentation := by
      letI := g.toAlgebra
      haveI : Algebra.Etale (MvPolynomial (Fin 1) R) A := hg
      exact Algebra.Etale.finitePresentation
    have hCfp : (MvPolynomial.C : R →+* MvPolynomial (Fin 1) R).FinitePresentation := by
      rw [← MvPolynomial.algebraMap_eq]
      exact RingHom.finitePresentation_algebraMap.mpr inferInstance
    haveI : Algebra.FinitePresentation R A := hgfp.comp hCfp
    let σa : A →ₐ[R] R := { σ with commutes' := fun b => hσψ b }
    exact Algebra.FinitePresentation.ker_fG_of_surjective σa
      (fun b => ⟨g (MvPolynomial.C b), hσψ b⟩)

  have hcot : RingHom.ker σ ≤ RingHom.ker σ ^ 2 ⊔
      Ideal.span {g (MvPolynomial.X 0) - g (MvPolynomial.C a)} := by
    letI : Algebra (MvPolynomial (Fin 1) R) A := g.toAlgebra
    haveI : Algebra.FormallyUnramified (MvPolynomial (Fin 1) R) A :=
      RingHom.Etale.formallyUnramified g hg
    let I : Ideal A := RingHom.ker σ ^ 2 ⊔
      Ideal.span {g (MvPolynomial.X 0) - g (MvPolynomial.C a)}
    let π : A →+* A ⧸ I := Ideal.Quotient.mk I
    have htI : π (g (MvPolynomial.X 0)) = π (g (MvPolynomial.C a)) := by
      rw [← sub_eq_zero, ← map_sub]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr
        (Ideal.mem_sup_right (Ideal.mem_span_singleton_self _))
    have hcomm : (π.comp ((g.comp MvPolynomial.C).comp σ)).comp g = π.comp g := by
      apply MvPolynomial.ringHom_ext
      · intro b
        simp only [RingHom.comp_apply]
        rw [hσψ]
      · intro i
        rw [Fin.fin_one_eq_zero i]
        simp only [RingHom.comp_apply]
        rw [hσX, htI]
    let F₁ : A →ₐ[MvPolynomial (Fin 1) R] A ⧸ I := Ideal.Quotient.mkₐ _ I
    let F₂ : A →ₐ[MvPolynomial (Fin 1) R] A ⧸ I :=
      { toRingHom := π.comp ((g.comp MvPolynomial.C).comp σ)
        commutes' := by
          intro p
          exact congrArg (fun f => f p) hcomm }
    have hN : (Ideal.map π (RingHom.ker σ)) ^ 2 = ⊥ := by
      rw [← Ideal.map_pow]
      exact le_bot_iff.mp ((Ideal.map_mono le_sup_left).trans (Ideal.map_quotient_self I).le)
    have hF : F₁ = F₂ := by
      refine Algebra.FormallyUnramified.ext (Ideal.map π (RingHom.ker σ)) ⟨2, hN⟩ ?_
      intro x
      rw [Ideal.Quotient.eq]
      show π x - π (g (MvPolynomial.C (σ x))) ∈ _
      rw [← map_sub]
      exact Ideal.mem_map_of_mem _ (hdiff x)
    intro x hx
    have h1 : F₁ x = F₂ x := by rw [hF]
    have h2 : F₂ x = 0 := by
      show π (g (MvPolynomial.C (σ x))) = 0
      rw [RingHom.mem_ker.mp hx, map_zero, map_zero, map_zero]
    exact Ideal.Quotient.eq_zero_iff_mem.mp (h1.trans h2)

  obtain ⟨r, hr1, hr⟩ := Submodule.exists_sub_one_mem_and_smul_le_of_fg_of_le_sup
    (I := RingHom.ker σ) (N := Ideal.span {g (MvPolynomial.X 0) - g (MvPolynomial.C a)})
    (N' := RingHom.ker σ) (P := RingHom.ker σ) hfg le_rfl (by
      rw [Ideal.smul_eq_mul, ← sq, sup_comm]
      exact hcot)
  refine ⟨r, ?_, ?_⟩
  · have h : r - 1 ∈ RingHom.ker θ := hker ▸ hr1
    rw [RingHom.mem_ker, map_sub, map_one, sub_eq_zero] at h
    exact h
  · intro j hj
    have hjK : j ∈ RingHom.ker σ := hker.symm ▸ hj
    have h2 := hr (Submodule.smul_mem_pointwise_smul j r (RingHom.ker σ) hjK)
    rw [smul_eq_mul, Ideal.mem_span_singleton'] at h2
    obtain ⟨y, hy⟩ := h2
    exact ⟨y, hy.symm⟩

theorem wcpa_dj_lr1k_ll_dp_theta_phi : ∀ (R : Type u) [CommRing R] (X : Scheme.{u})
    (uX : X ⟶ Spec (.of R)) (σ : Spec (.of R) ⟶ X), σ ≫ uX = 𝟙 _ →
    ∀ (V : X.Opens) (hle : V ≤ uX ⁻¹ᵁ ⊤) (e : ⊤ ≤ σ ⁻¹ᵁ V) (b : R),
      (Scheme.ΓSpecIso (.of R)).hom.hom ((σ.appLE V ⊤ e).hom ((uX.appLE ⊤ V hle).hom
        ((Scheme.ΓSpecIso (.of R)).inv.hom b))) = b :=
by
  intro R _ X uX σ hσ V hle e b
  have key : ∀ (Y : Scheme.{u}) (f : Y ⟶ Y), f = 𝟙 Y → ∀ h : (⊤ : Y.Opens) ≤ f ⁻¹ᵁ ⊤,
      f.appLE ⊤ ⊤ h = 𝟙 _ := by
    intro Y f hf h
    subst hf
    exact (Scheme.Hom.appLE_eq_app (𝟙 Y) (U := ⊤)).trans (Scheme.Hom.id_app (X := Y) ⊤)
  have h2 : uX.appLE ⊤ V hle ≫ σ.appLE V ⊤ e = 𝟙 _ := by
    rw [Scheme.Hom.appLE_comp_appLE]
    exact key _ _ hσ _
  have h3 := congrArg (fun φ => φ.hom ((Scheme.ΓSpecIso (.of R)).inv.hom b)) h2
  simp only [CommRingCat.hom_comp, CommRingCat.hom_id, RingHom.comp_apply, RingHom.id_apply] at h3
  rw [h3]
  exact (Scheme.ΓSpecIso (.of R)).inv_hom_id_apply b

theorem wcpa_dj_lr1k_ll_dp_centre_ideal : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω)
    (X : Scheme.{u}) (uX : X ⟶ Spec (.of ↥W)) [QuasiSeparated uX] (σ : Spec (.of ↥W) ⟶ X),
    σ ≫ uX = 𝟙 _ → ∀ (V : X.Opens) (hV : IsAffineOpen V) (hle : V ≤ uX ⁻¹ᵁ ⊤)
    (e : ⊤ ≤ σ ⁻¹ᵁ V) (a : ↥W),
    (σ.ker ⊔ wcNcPrincipal (.of ↥W) X uX a).ideal ⟨V, hV⟩ =
      Ideal.comap (((Scheme.ΓSpecIso (.of ↥W)).hom.hom).comp (σ.appLE V ⊤ e).hom)
        (Ideal.span {a}) :=
by
  intro Ω _ W X uX _ σ hσ V hV hle e a
  haveI : QuasiCompact (σ ≫ uX) := by rw [hσ]; infer_instance
  haveI : QuasiCompact σ := QuasiCompact.of_comp σ uX
  set θ : Γ(X, V) →+* ↥W :=
    ((Scheme.ΓSpecIso (.of ↥W)).hom.hom).comp (σ.appLE V ⊤ e).hom with hθ
  set φ : ↥W →+* Γ(X, V) :=
    (uX.appLE ⊤ V hle).hom.comp (Scheme.ΓSpecIso (.of ↥W)).inv.hom with hφ
  have hθφ : ∀ b, θ (φ b) = b := by
    intro b
    have key : ∀ (Y : Scheme.{u}) (f : Y ⟶ Y), f = 𝟙 Y → ∀ h : (⊤ : Y.Opens) ≤ f ⁻¹ᵁ ⊤,
        f.appLE ⊤ ⊤ h = 𝟙 _ := by
      intro Y f hf h
      subst hf
      exact (Scheme.Hom.appLE_eq_app (𝟙 Y) (U := ⊤)).trans (Scheme.Hom.id_app (X := Y) ⊤)
    have h2 : uX.appLE ⊤ V hle ≫ σ.appLE V ⊤ e = 𝟙 _ := by
      rw [Scheme.Hom.appLE_comp_appLE]
      exact key _ _ hσ _
    have h3 := congrArg (fun ψ => ψ.hom ((Scheme.ΓSpecIso (.of ↥W)).inv.hom b)) h2
    simp only [CommRingCat.hom_comp, CommRingCat.hom_id, RingHom.comp_apply,
      RingHom.id_apply] at h3
    show (Scheme.ΓSpecIso (.of ↥W)).hom.hom ((σ.appLE V ⊤ e).hom ((uX.appLE ⊤ V hle).hom
        ((Scheme.ΓSpecIso (.of ↥W)).inv.hom b))) = b
    rw [h3]
    exact (Scheme.ΓSpecIso (.of ↥W)).inv_hom_id_apply b

  have hker : σ.ker.ideal ⟨V, hV⟩ = RingHom.ker θ := by
    rw [Scheme.Hom.ker_apply]
    have hρ : Function.Injective ((Spec (.of ↥W)).presheaf.map (homOfLE e).op).hom := by
      apply Function.LeftInverse.injective
        (g := ((Spec (.of ↥W)).presheaf.map (homOfLE (le_top : σ ⁻¹ᵁ V ≤ ⊤)).op).hom)
      intro y
      rw [← CommRingCat.comp_apply, ← CategoryTheory.Functor.map_comp]
      have hid : (homOfLE e).op ≫ (homOfLE (le_top : σ ⁻¹ᵁ V ≤ ⊤)).op = 𝟙 _ :=
        Quiver.Hom.unop_inj (Subsingleton.elim _ _)
      rw [hid, CategoryTheory.Functor.map_id]
      rfl
    have hh : Function.Injective (Scheme.ΓSpecIso (.of ↥W)).hom.hom :=
      Function.LeftInverse.injective (g := (Scheme.ΓSpecIso (.of ↥W)).inv.hom)
        (fun y => Iso.hom_inv_id_apply _ _)
    have hθ' : θ = (Scheme.ΓSpecIso (.of ↥W)).hom.hom.comp
        (((Spec (.of ↥W)).presheaf.map (homOfLE e).op).hom.comp (σ.app V).hom) := rfl
    rw [hθ', RingHom.ker_comp_of_injective _ hh, RingHom.ker_comp_of_injective _ hρ]

  have hprin : (wcNcPrincipal (.of ↥W) X uX a).ideal ⟨V, hV⟩ = Ideal.span {φ a} := by
    unfold wcNcPrincipal
    rw [Scheme.IdealSheafData.ofIdealTop_ideal, Ideal.map_span, Set.image_singleton]
    rfl
  rw [Scheme.IdealSheafData.ideal_sup, Pi.sup_apply, hker, hprin]
  apply le_antisymm
  · refine sup_le ?_ ?_
    · intro x hx
      rw [Ideal.mem_comap, RingHom.mem_ker.mp hx]
      exact Ideal.zero_mem _
    · rw [Ideal.span_singleton_le_iff_mem, Ideal.mem_comap, hθφ]
      exact Ideal.mem_span_singleton_self a
  · intro x hx
    rw [Ideal.mem_comap, Ideal.mem_span_singleton'] at hx
    obtain ⟨c, hc⟩ := hx
    have h1 : x - φ c * φ a ∈ RingHom.ker θ := by
      rw [RingHom.mem_ker, map_sub, map_mul, hθφ, hθφ, hc, sub_self]
    have h2 : φ c * φ a ∈ Ideal.span {φ a} :=
      Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _)
    have h3 := Ideal.add_mem _ (Ideal.mem_sup_left h1) (Ideal.mem_sup_right h2)
    rwa [sub_add_cancel] at h3

theorem wcpa_dj_lr1k_ll_dp_basicOpen_section : ∀ (R : Type u) [CommRing R] [IsLocalRing R]
    (X : Scheme.{u}) (σ : Spec (.of R) ⟶ X) (V : X.Opens) (e : ⊤ ≤ σ ⁻¹ᵁ V) (h : Γ(X, V)),
    σ (IsLocalRing.closedPoint R) ∈ X.basicOpen h ↔
      IsUnit ((Scheme.ΓSpecIso (.of R)).hom.hom ((σ.appLE V ⊤ e).hom h)) :=
by
  intro R _ _ X σ V e h
  have key := Scheme.basicOpen_appLE σ ⊤ V e h
  rw [top_inf_eq] at key
  have H : ∀ x : Spec (.of R), σ x ∈ X.basicOpen h ↔
      x ∈ (Spec (.of R)).basicOpen ((σ.appLE V ⊤ e).hom h) := by
    intro x
    rw [key, Scheme.Hom.mem_preimage]
  refine (H (IsLocalRing.closedPoint R)).trans ?_
  rw [basicOpen_eq_of_affine']
  exact (PrimeSpectrum.mem_basicOpen _ _).trans IsLocalRing.notMem_maximalIdeal

theorem wcpa_dj_lr1k_ll_dp_local_le : ∀ (X : Scheme.{u}) (I J : X.IdealSheafData) (x : ↥X)
    (V : X.Opens) (hV : IsAffineOpen V), x ∈ V → (∀ z ∈ (J.support : Set ↥X), z = x) →
    (∀ i ∈ I.ideal ⟨V, hV⟩, ∃ s : Γ(X, V), x ∈ X.basicOpen s ∧ s * i ∈ J.ideal ⟨V, hV⟩) →
    I ≤ J :=
by
  intro X I J x V hV hxV hSupp hLoc

  have hA : ∀ (U : X.Opens) (hU : IsAffineOpen U) (K : Ideal Γ(X, U)) (i : Γ(X, U)),
      (∀ z ∈ U, ∃ b : Γ(X, U), z ∈ X.basicOpen b ∧ b * i ∈ K) → i ∈ K := by
    intro U hU K i h
    by_contra hi
    have hC : K.colon {i} ≠ ⊤ := by
      intro hC
      apply hi
      have h1 : (1 : Γ(X, U)) ∈ K.colon {i} := hC ▸ Submodule.mem_top
      rw [Submodule.mem_colon_singleton, smul_eq_mul, one_mul] at h1
      exact h1
    obtain ⟨M, hM, hCM⟩ := Ideal.exists_le_maximal _ hC
    let p : PrimeSpectrum Γ(X, U) := ⟨M, hM.isPrime⟩
    have hz : hU.fromSpec p ∈ U := hU.range_fromSpec.subset ⟨p, rfl⟩
    obtain ⟨b, hb, hbi⟩ := h _ hz
    have hbC : b ∈ K.colon {i} := by
      rw [Submodule.mem_colon_singleton, smul_eq_mul]; exact hbi
    have hp : p ∈ hU.fromSpec ⁻¹ᵁ X.basicOpen b := hb
    rw [hU.fromSpec_preimage_basicOpen] at hp
    exact (PrimeSpectrum.mem_basicOpen _ _).mp hp (hCM hbC)

  have hpow : ∀ (O : X.Opens) (t : Γ(X, O)) (n : ℕ), x ∈ X.basicOpen t →
      x ∈ X.basicOpen (t ^ n) := by
    intro O t n ht
    rcases Nat.eq_zero_or_pos n with rfl | hn
    · rw [pow_zero, Scheme.basicOpen_one]; exact X.basicOpen_le t ht
    · rw [Scheme.basicOpen_pow _ _ hn]; exact ht
  rw [Scheme.IdealSheafData.le_def]
  intro U i hi
  apply hA U U.2 (J.ideal U) i
  intro z hzU
  by_cases hzx : z = x
  · rw [hzx] at hzU ⊢
    obtain ⟨f, g, hfg, hxf⟩ := exists_basicOpen_le_affine_inter U.2 hV x ⟨hzU, hxV⟩
    obtain ⟨DA, hDAcoe, hDV⟩ : ∃ DA : X.affineOpens, (DA : X.Opens) = X.basicOpen f ∧
        DA ≤ (⟨V, hV⟩ : X.affineOpens) :=
      ⟨X.affineBasicOpen (U := ⟨V, hV⟩) g, by rw [Scheme.affineBasicOpen_coe]; exact hfg.symm,
        by show (X.affineBasicOpen (U := ⟨V, hV⟩) g : X.Opens) ≤ V
           rw [Scheme.affineBasicOpen_coe]; exact X.basicOpen_le g⟩
    have hDU : DA ≤ U := by
      show (DA : X.Opens) ≤ U
      rw [hDAcoe]; exact X.basicOpen_le f
    have hxD : x ∈ (DA : X.Opens) := by rw [hDAcoe]; exact hxf

    have hB : ∀ y ∈ I.ideal DA, ∃ s : Γ(X, DA), x ∈ X.basicOpen s ∧ s * y ∈ J.ideal DA := by
      intro y hy
      rw [← I.map_ideal hDV] at hy
      change y ∈ Submodule.span _ _ at hy
      induction hy using Submodule.span_induction with
      | mem y hy' =>
        obtain ⟨i', hi', rfl⟩ := hy'
        obtain ⟨s₀, hs₀, hs₀i⟩ := hLoc i' hi'
        refine ⟨(X.presheaf.map (homOfLE hDV).op).hom s₀, ?_, ?_⟩
        · have e : X.basicOpen ((X.presheaf.map (homOfLE hDV).op).hom s₀) =
              (DA : X.Opens) ⊓ X.basicOpen s₀ := X.basicOpen_res s₀ (homOfLE hDV).op
          have h3 : x ∈ (DA : X.Opens) ⊓ X.basicOpen s₀ := ⟨hxD, hs₀⟩
          rw [← e] at h3
          exact h3
        · rw [← J.map_ideal hDV]
          convert Ideal.mem_map_of_mem _ hs₀i using 1
          exact (map_mul _ _ _).symm
      | zero =>
        exact ⟨1, by rw [Scheme.basicOpen_one]; exact hxD, by rw [mul_zero]; exact zero_mem _⟩
      | add y₁ y₂ _ _ h₁ h₂ =>
        obtain ⟨s₁, hs₁, hy₁⟩ := h₁
        obtain ⟨s₂, hs₂, hy₂⟩ := h₂
        refine ⟨s₁ * s₂, by rw [Scheme.basicOpen_mul]; exact ⟨hs₁, hs₂⟩, ?_⟩
        have e : s₁ * s₂ * (y₁ + y₂) = s₂ * (s₁ * y₁) + s₁ * (s₂ * y₂) := by ring
        rw [e]; exact add_mem (Ideal.mul_mem_left _ _ hy₁) (Ideal.mul_mem_left _ _ hy₂)
      | smul c y _ h =>
        obtain ⟨s, hs, hy⟩ := h
        refine ⟨s, hs, ?_⟩
        rw [smul_eq_mul, mul_left_comm]; exact Ideal.mul_mem_left _ _ hy
    obtain ⟨s, hs, hsi⟩ := hB _ (by
      rw [← I.map_ideal hDU]; exact Ideal.mem_map_of_mem _ hi)

    letI : Algebra Γ(X, U) Γ(X, DA) := (X.presheaf.map (homOfLE hDU).op).hom.toAlgebra
    haveI : IsLocalization.Away f Γ(X, DA) :=
      U.2.isLocalization_of_eq_basicOpen f (homOfLE hDU) hDAcoe
    obtain ⟨n, a, ha⟩ := IsLocalization.Away.surj f s
    have eJ : Ideal.map (algebraMap Γ(X, U) Γ(X, DA)) (J.ideal U) = J.ideal DA :=
      J.map_ideal hDU
    have hsi' : s * algebraMap Γ(X, U) Γ(X, DA) i ∈ J.ideal DA := hsi
    have hai : algebraMap Γ(X, U) Γ(X, DA) (a * i) ∈
        Ideal.map (algebraMap Γ(X, U) Γ(X, DA)) (J.ideal U) := by
      rw [eJ, map_mul, ← ha]
      have e : s * algebraMap Γ(X, U) Γ(X, DA) f ^ n * algebraMap Γ(X, U) Γ(X, DA) i =
          (s * algebraMap Γ(X, U) Γ(X, DA) i) * algebraMap Γ(X, U) Γ(X, DA) f ^ n := by ring
      rw [e]; exact Ideal.mul_mem_right _ _ hsi'
    obtain ⟨m, hm, hmai⟩ := (IsLocalization.algebraMap_mem_map_algebraMap_iff
      (Submonoid.powers f) Γ(X, DA) (J.ideal U) (a * i)).mp hai
    obtain ⟨k, rfl⟩ := hm
    have hresf : X.basicOpen (algebraMap Γ(X, U) Γ(X, DA) f) =
        (DA : X.Opens) ⊓ X.basicOpen f := X.basicOpen_res f (homOfLE hDU).op
    have hresa : X.basicOpen (algebraMap Γ(X, U) Γ(X, DA) a) =
        (DA : X.Opens) ⊓ X.basicOpen a := X.basicOpen_res a (homOfLE hDU).op
    have hxa : x ∈ X.basicOpen a := by
      have h1 : x ∈ X.basicOpen (algebraMap Γ(X, U) Γ(X, DA) a) := by
        rw [← ha, Scheme.basicOpen_mul]
        refine ⟨hs, hpow _ _ n ?_⟩
        rw [hresf]; exact ⟨hxD, hxf⟩
      rw [hresa] at h1
      exact h1.2
    refine ⟨f ^ k * a, ?_, by rw [mul_assoc]; exact hmai⟩
    rw [Scheme.basicOpen_mul]
    exact ⟨hpow _ _ k hxf, hxa⟩
  · have hz : z ∉ (J.support : Set ↥X) := fun h => hzx (hSupp z h)
    have h2 := (Scheme.IdealSheafData.mem_support_iff_of_mem (I := J) hzU).not.mp hz
    rw [Scheme.zeroLocus_def] at h2
    simp only [Set.mem_iInter, not_forall] at h2
    obtain ⟨j, hj, hzj⟩ := h2
    exact ⟨j, not_not.mp hzj, Ideal.mul_mem_right _ _ hj⟩

theorem wcpa_dj_lr1k_ll_dp_section_lift : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω) (X : Scheme.{u}) (uX : X ⟶ Spec (.of ↥W)) (V : X.Opens)
    (hV : IsAffineOpen V) (hle : V ≤ uX ⁻¹ᵁ ⊤) (g : MvPolynomial (Fin 1) ↥W →+* Γ(X, V)),
    g.Etale →
    g.comp MvPolynomial.C = (uX.appLE ⊤ V hle).hom.comp (Scheme.ΓSpecIso (.of ↥W)).inv.hom →
    ∀ (σ₀ : Spec (.of ↥W) ⟶ X) (e₀ : ⊤ ≤ σ₀ ⁻¹ᵁ V), σ₀ ≫ uX = 𝟙 _ →
    ∀ c : ↥W, c - (Scheme.ΓSpecIso (.of ↥W)).hom.hom ((σ₀.appLE V ⊤ e₀).hom (g (MvPolynomial.X 0)))
        ∈ IsLocalRing.maximalIdeal ↥W →
    ∃ (σ : Spec (.of ↥W) ⟶ X) (e : ⊤ ≤ σ ⁻¹ᵁ V), σ ≫ uX = 𝟙 _ ∧
      σ (IsLocalRing.closedPoint ↥W) = σ₀ (IsLocalRing.closedPoint ↥W) ∧
      (Scheme.ΓSpecIso (.of ↥W)).hom.hom ((σ.appLE V ⊤ e).hom (g (MvPolynomial.X 0))) = c :=
by
  classical
  intro Ω _ _ W X uX V hV hle g hg hgC σ₀ e₀ hσ₀ c hc

  obtain ⟨m, hm, hmπ, hEx⟩ : ∃ m : V.toScheme ⟶ Spec (.of (MvPolynomial (Fin 1) ↥W)),
      Etale m ∧
      m ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W)) =
        V.ι ≫ uX ∧
      ∀ P, m.appTop.hom ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom P) =
        V.topIso.inv.hom (g P) := by
    have hSpec : Etale (Spec.map (CommRingCat.ofHom g)) :=
      (HasRingHomProperty.Spec_iff (P := @Etale)).mpr hg
    have hE : (Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv ≫
        (hV.isoSpec.hom ≫ Spec.map (CommRingCat.ofHom g)).appTop =
        CommRingCat.ofHom g ≫ V.topIso.inv := by
      rw [Scheme.Hom.comp_appTop, ← Category.assoc,
        ← Scheme.ΓSpecIso_inv_naturality, IsAffineOpen.isoSpec_hom, Category.assoc,
        Scheme.Opens.toSpecΓ_appTop]
      simp only [Iso.inv_hom_id_assoc]
    have hEx : ∀ P, (hV.isoSpec.hom ≫ Spec.map (CommRingCat.ofHom g)).appTop.hom
        ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom P) =
        V.topIso.inv.hom (g P) := by
      intro P
      have := congrArg (fun f => f.hom P) hE
      exact this
    refine ⟨hV.isoSpec.hom ≫ Spec.map (CommRingCat.ofHom g), inferInstance, ?_, hEx⟩
    apply ext_of_isAffine
    have hC : (Scheme.ΓSpecIso (.of ↥W)).inv ≫
        (Spec.map (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W))).appTop =
        CommRingCat.ofHom MvPolynomial.C ≫ (Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv :=
      (Scheme.ΓSpecIso_inv_naturality _).symm
    rw [← cancel_epi (Scheme.ΓSpecIso (.of ↥W)).inv]
    ext a
    rw [Scheme.Hom.comp_appTop, Scheme.Hom.comp_appTop, ← Category.assoc, hC, Category.assoc]
    change (hV.isoSpec.hom ≫ Spec.map (CommRingCat.ofHom g)).appTop.hom
        ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.C a)) = _
    rw [hEx]
    have hga : g (MvPolynomial.C a) =
        (uX.appLE ⊤ V hle).hom ((Scheme.ΓSpecIso (.of ↥W)).inv.hom a) := by
      have := congrArg (fun f => f a) hgC
      exact this
    rw [hga]
    change ((uX.appLE ⊤ V hle ≫ V.topIso.inv).hom ((Scheme.ΓSpecIso (.of ↥W)).inv.hom a)) =
      ((uX.appTop ≫ V.ι.appTop).hom ((Scheme.ΓSpecIso (.of ↥W)).inv.hom a))
    congr 2
    rw [Scheme.Opens.ι_appTop, Scheme.Opens.topIso_inv, Scheme.Hom.appLE, Scheme.Hom.appTop]
    erw [Category.assoc]
    congr 1
    erw [← Functor.map_comp]
    rfl

  have hliftM : ∀ (σV : Spec (.of ↥W) ⟶ V.toScheme) (e : ⊤ ≤ (σV ≫ V.ι) ⁻¹ᵁ V),
      (σV ≫ V.ι).appLE V ⊤ e = V.topIso.inv ≫ σV.appTop := by
    intro σV e
    rw [Scheme.Hom.comp_appLE]
    have hpre : (⊤ : V.toScheme.Opens) ≤ V.ι ⁻¹ᵁ V := (Scheme.Opens.ι_preimage_self V).ge
    have h2 := Scheme.Hom.map_appLE σV (le_refl (⊤ : (Spec (.of ↥W)).Opens)) (homOfLE hpre).op
    rw [← h2, ← Category.assoc]
    congr 1
    rw [Scheme.Opens.topIso_inv, Scheme.Opens.ι_app_self]
    erw [← Functor.map_comp]
    congr 1
  have hlift : ∀ (σ : Spec (.of ↥W) ⟶ X) (σV : Spec (.of ↥W) ⟶ V.toScheme), σV ≫ V.ι = σ →
      ∀ (e : ⊤ ≤ σ ⁻¹ᵁ V) (h : Γ(X, V)),
      (σ.appLE V ⊤ e).hom h = σV.appTop.hom (V.topIso.inv.hom h) := by
    intro σ σV hσV e h
    subst hσV
    rw [hliftM σV e]
    rfl

  have hsecEval : ∀ (σ : Spec (.of ↥W) ⟶ Spec (.of (MvPolynomial (Fin 1) ↥W))),
      σ ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W)) = 𝟙 _ →
      σ = Spec.map (CommRingCat.ofHom (MvPolynomial.eval (fun _ : Fin 1 =>
        (Scheme.ΓSpecIso (.of ↥W)).hom.hom (σ.appTop.hom
          ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.X 0)))))) := by
    intro σ hσ
    obtain ⟨φ, rfl⟩ : ∃ φ, Spec.map φ = σ := ⟨Spec.preimage σ, Spec.map_preimage σ⟩
    have hC : CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W) ≫ φ = 𝟙 _ := by
      apply Spec.map_injective
      rw [Spec.map_comp, hσ, Spec.map_id]
    have hnat := Scheme.ΓSpecIso_naturality φ
    have key : (Scheme.ΓSpecIso (.of ↥W)).hom.hom ((Spec.map φ).appTop.hom
        ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.X 0))) =
        φ.hom (MvPolynomial.X 0) := by
      have := congrArg (fun f => f.hom ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom
        (MvPolynomial.X 0))) hnat
      simp only [CommRingCat.hom_comp, RingHom.comp_apply] at this
      rw [this]
      congr 1
      exact CategoryTheory.Iso.inv_hom_id_apply (Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))) _
    rw [key]
    congr 1
    ext1
    apply MvPolynomial.ringHom_ext
    · intro r
      have := congrArg (fun f => f.hom r) hC
      simpa using this
    · intro i
      rw [Subsingleton.elim i 0]
      simp

  have hptEq : ∀ a b : ↥W, a - b ∈ IsLocalRing.maximalIdeal ↥W →
      Spec.map (CommRingCat.ofHom (MvPolynomial.eval (fun _ : Fin 1 => a)))
        (IsLocalRing.closedPoint ↥W) =
      Spec.map (CommRingCat.ofHom (MvPolynomial.eval (fun _ : Fin 1 => b)))
        (IsLocalRing.closedPoint ↥W) := by
    intro a b hab
    have hres : (IsLocalRing.residue ↥W).comp (MvPolynomial.eval (fun _ : Fin 1 => a)) =
        (IsLocalRing.residue ↥W).comp (MvPolynomial.eval (fun _ : Fin 1 => b)) := by
      apply MvPolynomial.ringHom_ext
      · intro r
        simp
      · intro i
        simp only [RingHom.comp_apply, MvPolynomial.eval_X]
        rw [← sub_eq_zero, ← map_sub, IsLocalRing.residue_eq_zero_iff]
        exact hab
    apply PrimeSpectrum.ext
    ext P
    show MvPolynomial.eval (fun _ : Fin 1 => a) P ∈ IsLocalRing.maximalIdeal ↥W ↔
      MvPolynomial.eval (fun _ : Fin 1 => b) P ∈ IsLocalRing.maximalIdeal ↥W
    rw [← IsLocalRing.residue_eq_zero_iff, ← IsLocalRing.residue_eq_zero_iff]
    have := congrArg (fun f => f P) hres
    simp only [RingHom.comp_apply] at this
    rw [this]

  have hεsec : ∀ a : ↥W,
      Spec.map (CommRingCat.ofHom (MvPolynomial.eval (fun _ : Fin 1 => a))) ≫
        Spec.map (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W)) = 𝟙 _ := by
    intro a
    rw [← Spec.map_comp, ← Spec.map_id]
    congr 1
    ext r
    simp
  have hεval : ∀ a : ↥W, (Scheme.ΓSpecIso (.of ↥W)).hom.hom
      ((Spec.map (CommRingCat.ofHom (MvPolynomial.eval (fun _ : Fin 1 => a)))).appTop.hom
        ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.X 0))) = a := by
    intro a
    have hnat := Scheme.ΓSpecIso_naturality
      (CommRingCat.ofHom (MvPolynomial.eval (fun _ : Fin 1 => a)))
    have := congrArg (fun f => f.hom ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom
      (MvPolynomial.X 0))) hnat
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at this
    rw [this]
    rw [CategoryTheory.Iso.inv_hom_id_apply (Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W)))]
    simp
  have hcompTop : ∀ (τ : Spec (.of ↥W) ⟶ V.toScheme) (x : Γ(Spec (.of (MvPolynomial (Fin 1) ↥W)), ⊤)),
