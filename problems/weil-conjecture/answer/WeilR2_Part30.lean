    rw [Submodule.Quotient.mk_eq_zero]
    rw [hNn, Submodule.mem_comap, LinearMap.mem_range] at hq ⊢
    obtain ⟨y, hy⟩ := hq
    have hy' : algebraMap T A h * y = algebraMap T A t * (x : A) := by
      rw [LinearMap.mulLeft_apply] at hy
