    have hπg : ∀ a, IsUnit (((Ideal.Quotient.mk (K ⊔ 𝔪 ^ n)).comp g) a) ↔ a ∉ q := by
      intro a
      rw [RingHom.comp_apply, hQunit, hU]
    have hπloc : IsLocalHom (Ideal.Quotient.mk (K ⊔ 𝔪 ^ n)) :=
