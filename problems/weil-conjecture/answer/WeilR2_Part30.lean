  have GEN : ∀ (p : ℕ), p.Prime → ∀ (N : F' → ℝ) (K : F' → Prop),
      N 0 = 0 → (∀ x, 0 ≤ N x) → N 1 = 1 → (∀ x y, N (x * y) = N x * N y) →
      (∀ x y, N (x + y) ≤ max (N x) (N y)) → (∀ x, N (-x) = N x) →
      (∀ k : ℕ, N (k : F') ≤ 1) → N (p : F') < 1 → (∀ j, N (u j) ≤ 1) →
      K 0 → K 1 → (∀ x y, K x → K y → K (x + y)) →
      (∀ x y, K x → K y → K (x * y)) → (∀ x, K x → K (-x)) →
      (∀ e c : F', (e = 0 ∨ e = 1) → K c → ∃ c' : F', K c' ∧ c' ^ p - e * c' + c = 0) →
      (∀ (l₀ : F') (l : ℕ × ι₀ →₀ F'), K l₀ → (∀ q, K (l q)) →
        N l₀ ≤ N (wcUaExp p u l₀ l) ∧ ∀ q, N (l q) ≤ N (wcUaExp p u l₀ l)) →
      (∀ (x : F') (ε : ℝ), 0 < ε → ∃ (l₀ : F') (l : ℕ × ι₀ →₀ F'), K l₀ ∧
        (∀ q, K (l q)) ∧ N (x - wcUaExp p u l₀ l) < ε) →
      (∀ (μ : ι₀ →₀ F'), (∀ j, K (μ j)) → ∀ y : F',
        N (μ.sum fun j c => c * u j) ≤ N ((μ.sum fun j c => c * u j) + y ^ p)) →
      ∀ (a b : F') (s : ℝ), (a = 0 ∨ a = 1) → 0 < s → (a = 1 → s = 1) →
      N ((p : F') * b) < s →
      (∀ ε : ℝ, 0 < ε → ∃ c : F', N ((p : F') * c ^ p) < s ∧ N (c ^ p - a * c + b) < s + ε) →
      ∃ c : F', N ((p : F') * c ^ p) < s ∧ N (c ^ p - a * c + b) ≤ s := by
    intro p hp N K hN0 hnn h1 hmul hult hneg hnat hNp hu hK0 hK1 hKadd hKmul hKneg hKroot hO hD hP
      a b s ha hs has hpb happ
    classical
    have hpow : ∀ (z : F') (n : ℕ), N (z ^ n) = N z ^ n := by
      intro z n
      induction n with
      | zero => rw [pow_zero, pow_zero, h1]
      | succ n ih => rw [pow_succ, hmul, ih, pow_succ]
    have hsub : ∀ x y, N (x - y) ≤ max (N x) (N y) := fun x y => by
      rw [sub_eq_add_neg, ← hneg y]; exact hult _ _

    have hbin : ∀ x y : F', N ((x + y) ^ p - x ^ p - y ^ p) ≤ N (p : F') * max (N x) (N y) ^ p := by
      intro x y
      have hM : 0 ≤ max (N x) (N y) := le_max_of_le_left (hnn x)
      obtain ⟨q, hq⟩ : ∃ q, p = q + 1 := ⟨p - 1, (Nat.sub_add_cancel hp.one_lt.le).symm⟩
      have key : (x + y) ^ (q + 1) - x ^ (q + 1) - y ^ (q + 1) = ∑ i ∈ Finset.range q,
          x ^ (i + 1) * y ^ (q + 1 - (i + 1)) * ((q + 1).choose (i + 1) : F') := by
        rw [add_pow, Finset.sum_range_succ, Finset.sum_range_succ']
        simp only [pow_zero, Nat.sub_self, Nat.choose_self, Nat.choose_zero_right, Nat.cast_one,
          mul_one, one_mul, Nat.sub_zero]
        ring
      rw [hq, key]
      refine Finset.sum_induction _ (fun z => N z ≤ N ((q + 1 : ℕ) : F') * max (N x) (N y) ^ (q + 1))
        (fun a b ha hb => (hult a b).trans (max_le ha hb))
        (by rw [hN0]; exact mul_nonneg (hnn _) (pow_nonneg hM _)) ?_
      intro i hi
      have hi' : i + 1 < q + 1 := by rw [Finset.mem_range] at hi; omega
      obtain ⟨k, hk⟩ := (hq ▸ hp).dvd_choose_self (Nat.succ_ne_zero i) hi'
      rw [hk, Nat.cast_mul, hmul, hmul, hmul, hpow, hpow]
      have e1 : N x ^ (i + 1) ≤ max (N x) (N y) ^ (i + 1) :=
        pow_le_pow_left₀ (hnn x) (le_max_left _ _) _
      have e2 : N y ^ (q + 1 - (i + 1)) ≤ max (N x) (N y) ^ (q + 1 - (i + 1)) :=
        pow_le_pow_left₀ (hnn y) (le_max_right _ _) _
      have e3 : max (N x) (N y) ^ (i + 1) * max (N x) (N y) ^ (q + 1 - (i + 1)) =
          max (N x) (N y) ^ (q + 1) := by
        rw [← pow_add]; congr 1; omega
      calc N x ^ (i + 1) * N y ^ (q + 1 - (i + 1)) * (N ((q + 1 : ℕ) : F') * N (k : F'))
          ≤ max (N x) (N y) ^ (i + 1) * max (N x) (N y) ^ (q + 1 - (i + 1)) *
            (N ((q + 1 : ℕ) : F') * 1) :=
            mul_le_mul (mul_le_mul e1 e2 (pow_nonneg (hnn y) _) (pow_nonneg hM _))
              (mul_le_mul_of_nonneg_left (hnat k) (hnn _)) (mul_nonneg (hnn _) (hnn _))
              (mul_nonneg (pow_nonneg hM _) (pow_nonneg hM _))
        _ = N ((q + 1 : ℕ) : F') * max (N x) (N y) ^ (q + 1) := by rw [e3]; ring

    have shift : ∀ (b b' C D : F'), b' = b + C ^ p - a * C + D → N ((p : F') * C ^ p) < s → N D < s →
        ((N ((p : F') * b) < s ∧ ∀ ε : ℝ, 0 < ε → ∃ c : F', N ((p : F') * c ^ p) < s ∧
            N (c ^ p - a * c + b) < s + ε) →
          (N ((p : F') * b') < s ∧ ∀ ε : ℝ, 0 < ε → ∃ c : F', N ((p : F') * c ^ p) < s ∧
            N (c ^ p - a * c + b') < s + ε)) ∧
        ((∃ c : F', N ((p : F') * c ^ p) < s ∧ N (c ^ p - a * c + b') ≤ s) →
          ∃ c : F', N ((p : F') * c ^ p) < s ∧ N (c ^ p - a * c + b) ≤ s) := by
      intro b b' C D hb' hC hD
      have h3 : ∀ x y z, N (x + y + z) ≤ max (max (N x) (N y)) (N z) := fun x y z =>
        (hult _ _).trans (max_le_max (hult _ _) le_rfl)
      have hA1 : ∀ x y, N ((p : F') * x ^ p) < s → N ((p : F') * y ^ p) < s →
          N ((x + y) ^ p - x ^ p - y ^ p) < s := by
        intro x y hx hy
        refine lt_of_le_of_lt (hbin x y) ?_
        rw [hmul, hpow] at hx hy
        rcases le_total (N x) (N y) with h | h
        · rw [max_eq_right h]; exact hy
        · rw [max_eq_left h]; exact hx
      have hA2 : ∀ x y, N ((p : F') * x ^ p) < s → N ((p : F') * y ^ p) < s →
          N ((p : F') * (x + y) ^ p) < s := by
        intro x y hx hy
        have e : (p : F') * (x + y) ^ p = (p : F') * x ^ p + (p : F') * y ^ p +
            (p : F') * ((x + y) ^ p - x ^ p - y ^ p) := by ring
        rw [e]
        refine lt_of_le_of_lt (h3 _ _ _) (max_lt (max_lt hx hy) ?_)
        rw [hmul]
        calc N (p : F') * N ((x + y) ^ p - x ^ p - y ^ p)
            ≤ 1 * N ((x + y) ^ p - x ^ p - y ^ p) := mul_le_mul_of_nonneg_right hNp.le (hnn _)
          _ < s := by rw [one_mul]; exact hA1 x y hx hy
      have hSneg : ∀ x, N ((p : F') * x ^ p) < s → N ((p : F') * (-x) ^ p) < s := by
        intro x hx
        rcases Nat.even_or_odd p with he | ho
        · rw [he.neg_pow]; exact hx
        · rw [ho.neg_pow, mul_neg, hneg]; exact hx
      refine ⟨?_, ?_⟩
      · rintro ⟨hpb, happ⟩
        refine ⟨?_, ?_⟩
        · have e : (p : F') * b' = (p : F') * b + (p : F') * C ^ p + (-(a * ((p : F') * C))) +
              (p : F') * D := by rw [hb']; ring
          rw [e]
          have haC : N (-(a * ((p : F') * C))) < s := by
            rw [hneg]
            rcases ha with ha0 | ha1
            · rw [ha0, zero_mul, hN0]; exact hs
            · have hs1 := has ha1
              rw [ha1, one_mul, hs1]
              rcases le_or_gt (N C) 1 with hc | hc
              · rw [hmul]
                calc N (p : F') * N C ≤ N (p : F') * 1 := mul_le_mul_of_nonneg_left hc (hnn _)
                  _ < 1 := by rw [mul_one]; exact hNp
              · have hle : N C ≤ N C ^ p := le_self_pow₀ hc.le hp.ne_zero
                have hC' := hC
                rw [hmul, hpow, hs1] at hC'
                rw [hmul]
                calc N (p : F') * N C ≤ N (p : F') * N C ^ p := mul_le_mul_of_nonneg_left hle (hnn _)
                  _ < 1 := hC'
          have hpD : N ((p : F') * D) < s := by
            rw [hmul]
            calc N (p : F') * N D ≤ 1 * N D := mul_le_mul_of_nonneg_right hNp.le (hnn _)
              _ < s := by rw [one_mul]; exact hD
          exact lt_of_le_of_lt (hult _ _)
            (max_lt (lt_of_le_of_lt (h3 _ _ _) (max_lt (max_lt hpb hC) haC)) hpD)
        · intro ε hε
          obtain ⟨c, hc1, hc2⟩ := happ ε hε
          obtain ⟨c₁, rfl⟩ : ∃ c₁, c = c₁ + C := ⟨c - C, by ring⟩
          have hs1 := hA2 _ _ hc1 (hSneg _ hC)
          rw [show c₁ + C + -C = c₁ by ring] at hs1
          refine ⟨c₁, hs1, ?_⟩
          have hE := hA1 c₁ C hs1 hC
          have e : c₁ ^ p - a * c₁ + b' = ((c₁ + C) ^ p - a * (c₁ + C) + b) -
              ((c₁ + C) ^ p - c₁ ^ p - C ^ p) + D := by rw [hb']; ring
          rw [e]
          refine lt_of_le_of_lt (hult _ _) (max_lt (lt_of_le_of_lt (hsub _ _) (max_lt hc2 ?_)) ?_)
          · linarith
          · linarith
      · rintro ⟨c', hc1, hc2⟩
        refine ⟨c' + C, hA2 _ _ hc1 hC, ?_⟩
        have hE := hA1 c' C hc1 hC
        have e : (c' + C) ^ p - a * (c' + C) + b = (c' ^ p - a * c' + b') +
            ((c' + C) ^ p - c' ^ p - C ^ p) - D := by rw [hb']; ring
        rw [e]
        exact (hsub _ _).trans (max_le ((hult _ _).trans (max_le hc2 hE.le)) hD.le)

    have reduce : ∀ (l₀ : F') (l : ℕ × ι₀ →₀ F'), K l₀ → (∀ q, K (l q)) → ∀ q ∈ l.support,
        1 ≤ q.1 → ∃ (C : F') (l' : ℕ × ι₀ →₀ F'), (∀ q', K (l' q')) ∧
          (l'.support.sum fun q' => q'.1) < (l.support.sum fun q' => q'.1) ∧
          N ((p : F') * C ^ p) ≤ N (p : F') * N (wcUaExp p u l₀ l) ∧
          wcUaExp p u l₀ l + C ^ p - a * C = wcUaExp p u l₀ l' := by
      intro l₀ l hl₀ hl q hq hq1
      obtain ⟨k', j⟩ := q
      simp only at hq1
      obtain ⟨k, rfl⟩ : ∃ k, k' = k + 1 := ⟨k' - 1, by omega⟩
      obtain ⟨μ, hKμ, hμ⟩ := hKroot 0 (l (k + 1, j)) (Or.inl rfl) (hl _)
      have hμp : μ ^ p = -(l (k + 1, j)) := by linear_combination hμ
      have hCp : (μ * u j ^ (p ^ k)) ^ p = -(l (k + 1, j)) * u j ^ (p ^ (k + 1)) := by
        rw [mul_pow, hμp, ← pow_mul, ← pow_succ]
      refine ⟨μ * u j ^ (p ^ k), Finsupp.erase (k + 1, j) l + Finsupp.single (k, j) (-(a * μ)),
        ?_, ?_, ?_, ?_⟩
      · intro q'
        rw [Finsupp.add_apply]
        apply hKadd
        · by_cases h : q' = (k + 1, j)
          · rw [h, Finsupp.erase_same]; exact hK0
          · rw [Finsupp.erase_ne h]; exact hl q'
        · rw [Finsupp.single_apply]
          split_ifs
          · apply hKneg
            apply hKmul _ _ _ hKμ
            rcases ha with h | h
            · rw [h]; exact hK0
            · rw [h]; exact hK1
          · exact hK0
      · have hsub' : (Finsupp.erase (k + 1, j) l + Finsupp.single (k, j) (-(a * μ))).support ⊆
            (l.support.erase (k + 1, j)) ∪ {(k, j)} := by
          refine Finsupp.support_add.trans (Finset.union_subset_union ?_ Finsupp.support_single_subset)
          rw [Finsupp.support_erase]
        have h1' := Finset.sum_le_sum_of_subset (f := fun q' : ℕ × ι₀ => q'.1) hsub'
        have h2' := Finset.sum_union_inter (s₁ := l.support.erase (k + 1, j)) (s₂ := {(k, j)})
          (f := fun q' : ℕ × ι₀ => q'.1)
        have h3' := Finset.add_sum_erase l.support (fun q' : ℕ × ι₀ => q'.1) hq
        rw [Finset.sum_singleton] at h2'
        simp only at h1' h2' h3'
        omega
      · rw [hCp, hmul, hmul, hneg, hpow]
        have hO2 := (hO l₀ l hl₀ hl).2 (k + 1, j)
        have hun : N (u j) ^ (p ^ (k + 1)) ≤ 1 := pow_le_one₀ (hnn _) (hu j)
        apply mul_le_mul_of_nonneg_left _ (hnn _)
        calc N (l (k + 1, j)) * N (u j) ^ (p ^ (k + 1)) ≤ N (l (k + 1, j)) * 1 :=
              mul_le_mul_of_nonneg_left hun (hnn _)
          _ ≤ _ := by rw [mul_one]; exact hO2
      · unfold wcUaExp
        have hsplit := Finsupp.add_sum_erase l (k + 1, j) (fun q c => c * u q.2 ^ (p ^ q.1)) hq
        simp only at hsplit
        rw [Finsupp.sum_add_index' (fun _ => zero_mul _) (fun _ _ _ => add_mul _ _ _),
          Finsupp.sum_single_index (zero_mul _), ← hsplit, hCp]
        ring

    have level0 : ∀ (l₀ : F') (l : ℕ × ι₀ →₀ F'), K l₀ → (∀ q, K (l q)) →
        N ((p : F') * wcUaExp p u l₀ l) < s →
        ∃ C : F', N ((p : F') * C ^ p) < s ∧ wcUaExp p u l₀ l + C ^ p - a * C = wcUaExp p u 0 l := by
      intro l₀ l hl₀ hl hpX
      obtain ⟨ω, -, hω⟩ := hKroot a l₀ ha hl₀
      refine ⟨ω, ?_, ?_⟩
      · have hO1 := (hO l₀ l hl₀ hl).1
        have hX : N (p : F') * N (wcUaExp p u l₀ l) < s := by rw [← hmul]; exact hpX
        rcases ha with ha0 | ha1
        · have e : ω ^ p = -l₀ := by rw [ha0] at hω; linear_combination hω
          rw [hmul, e, hneg]
          calc N (p : F') * N l₀ ≤ N (p : F') * N (wcUaExp p u l₀ l) :=
                mul_le_mul_of_nonneg_left hO1 (hnn _)
            _ < s := hX
        · have hs1 := has ha1
          rw [hs1] at hX ⊢
          rw [hmul, hpow]
          rcases le_or_gt (N ω) 1 with h | h
          · calc N (p : F') * N ω ^ p ≤ N (p : F') * 1 :=
                  mul_le_mul_of_nonneg_left (pow_le_one₀ (hnn _) h) (hnn _)
              _ < 1 := by rw [mul_one]; exact hNp
          · have hlt : N ω < N ω ^ p := lt_self_pow₀ h hp.one_lt
            have e : ω ^ p = ω + -l₀ := by rw [ha1] at hω; linear_combination hω
            have hle : N ω ^ p ≤ max (N ω) (N l₀) := by
              rw [← hpow, e, ← hneg l₀]; exact hult _ _
            have hle2 : N ω ^ p ≤ N l₀ := by
              rcases le_total (N ω) (N l₀) with h' | h'
              · rw [max_eq_right h'] at hle; exact hle
              · rw [max_eq_left h'] at hle; linarith
            calc N (p : F') * N ω ^ p ≤ N (p : F') * N l₀ := mul_le_mul_of_nonneg_left hle2 (hnn _)
              _ ≤ N (p : F') * N (wcUaExp p u l₀ l) := mul_le_mul_of_nonneg_left hO1 (hnn _)
              _ < 1 := hX
      · unfold wcUaExp; linear_combination hω

    have close : ∀ l : ℕ × ι₀ →₀ F', (∀ q, K (l q)) → (∀ q ∈ l.support, q.1 = 0) →
        (∀ ε : ℝ, 0 < ε → ∃ c : F', N ((p : F') * c ^ p) < s ∧
          N (c ^ p - a * c + wcUaExp p u 0 l) < s + ε) → N (wcUaExp p u 0 l) ≤ s := by
      intro l hl hl0 happ'
      have hβ : wcUaExp p u 0 l = (Finsupp.mapDomain Prod.snd l).sum (fun j c => c * u j) := by
        rw [Finsupp.sum_mapDomain_index (fun _ => zero_mul _) (fun _ _ _ => add_mul _ _ _)]
        unfold wcUaExp
        rw [zero_add]
        unfold Finsupp.sum
        refine Finset.sum_congr rfl (fun q hq => ?_)
        show l q * u q.2 ^ p ^ q.1 = l q * u q.2
        rw [hl0 q hq, pow_zero, pow_one]
      have hKμ : ∀ j, K ((Finsupp.mapDomain Prod.snd l) j) := by
        intro j
        rw [Finsupp.mapDomain, Finsupp.sum_apply]
        unfold Finsupp.sum
        refine Finset.sum_induction _ K hKadd hK0 (fun q _ => ?_)
        show K ((Finsupp.single q.2 (l q)) j)
        rw [Finsupp.single_apply]
        split_ifs
        · exact hl q
        · exact hK0
      have hP' := hP (Finsupp.mapDomain Prod.snd l) hKμ
      rw [← hβ] at hP'
      generalize wcUaExp p u 0 l = β at happ' hP' ⊢
      by_contra hcon
      push_neg at hcon
      obtain ⟨c, -, hc2⟩ := happ' (N β - s) (by linarith)
      have hc2' : N (c ^ p - a * c + β) < N β := by linarith
      have key : N (β + c ^ p) < N β := by
        rcases ha with ha0 | ha1
        · have e : β + c ^ p = c ^ p - a * c + β := by rw [ha0]; ring
          rw [e]; exact hc2'
        · have hs1 := has ha1
          rw [hs1] at hcon
          rw [ha1] at hc2'
          have hNc : 1 < N c := by
            by_contra h
            push_neg at h
            have h1' : N (c ^ p - 1 * c) ≤ 1 := (hsub _ _).trans
              (max_le (by rw [hpow]; exact pow_le_one₀ (hnn _) h) (by rw [one_mul]; exact h))
            have h2' : N β ≤ max (N (c ^ p - 1 * c + β)) (N (c ^ p - 1 * c)) := by
              calc N β = N ((c ^ p - 1 * c + β) - (c ^ p - 1 * c)) := by congr 1; ring
                _ ≤ _ := hsub _ _
            have := max_le hc2'.le (h1'.trans hcon.le)
            rcases le_total (N (c ^ p - 1 * c + β)) (N (c ^ p - 1 * c)) with h4 | h4
            · rw [max_eq_right h4] at h2'; linarith
            · rw [max_eq_left h4] at h2'; linarith
          have hlt : N c < N c ^ p := lt_self_pow₀ hNc hp.one_lt
          have hA : N c ^ p ≤ N (c ^ p - 1 * c) := by
            have h5 : N c ^ p ≤ max (N (c ^ p - 1 * c)) (N c) := by
              rw [← hpow]
              calc N (c ^ p) = N ((c ^ p - 1 * c) + c) := by congr 1; ring
                _ ≤ _ := hult _ _
            rcases le_total (N (c ^ p - 1 * c)) (N c) with h4 | h4
            · rw [max_eq_right h4] at h5; linarith
            · rw [max_eq_left h4] at h5; exact h5
          have hB : N (c ^ p - 1 * c) ≤ N β := by
            calc N (c ^ p - 1 * c) = N ((c ^ p - 1 * c + β) + -β) := by congr 1; ring
              _ ≤ max _ _ := hult _ _
              _ ≤ N β := max_le hc2'.le (by rw [hneg])
          have hcβ : N c < N β := by linarith
          calc N (β + c ^ p) = N ((c ^ p - 1 * c + β) + c) := by congr 1; ring
            _ ≤ max _ _ := hult _ _
            _ < N β := max_lt hc2' hcβ
      have := hP' c
      linarith

    have main : ∀ n : ℕ, ∀ (l₀ : F') (l : ℕ × ι₀ →₀ F'), K l₀ → (∀ q, K (l q)) →
        (l.support.sum fun q => q.1) = n →
        (N ((p : F') * wcUaExp p u l₀ l) < s ∧ ∀ ε : ℝ, 0 < ε → ∃ c : F', N ((p : F') * c ^ p) < s ∧
            N (c ^ p - a * c + wcUaExp p u l₀ l) < s + ε) →
        ∃ c : F', N ((p : F') * c ^ p) < s ∧ N (c ^ p - a * c + wcUaExp p u l₀ l) ≤ s := by
      intro n
      induction n using Nat.strong_induction_on with
      | _ n ih =>
      intro l₀ l hl₀ hl hn hcrit
      by_cases hex : ∃ q ∈ l.support, 1 ≤ q.1
      · obtain ⟨q, hq, hq1⟩ := hex
        obtain ⟨C, l', hl', hlt, hCb, heq⟩ := reduce l₀ l hl₀ hl q hq hq1
        have hb' : wcUaExp p u l₀ l' = wcUaExp p u l₀ l + C ^ p - a * C + 0 := by
          rw [add_zero, heq]
        have hC : N ((p : F') * C ^ p) < s := lt_of_le_of_lt hCb (by rw [← hmul]; exact hcrit.1)
        have hsh := shift _ _ C 0 hb' hC (by rw [hN0]; exact hs)
        exact hsh.2 (ih _ (hn ▸ hlt) l₀ l' hl₀ hl' rfl (hsh.1 hcrit))
      · push_neg at hex
        have hl0 : ∀ q ∈ l.support, q.1 = 0 := fun q hq => by have := hex q hq; omega
        obtain ⟨C, hC, heq⟩ := level0 l₀ l hl₀ hl hcrit.1
        have hb' : wcUaExp p u 0 l = wcUaExp p u l₀ l + C ^ p - a * C + 0 := by
          rw [add_zero, heq]
        have hsh := shift _ _ C 0 hb' hC (by rw [hN0]; exact hs)
        have hcrit' := hsh.1 hcrit
