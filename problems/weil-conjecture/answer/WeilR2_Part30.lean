  obtain ⟨hFree, hRank⟩ := wcpa_dj_lr1k_eb_eg_sep_bc_free Ω W hdim hW L hdef hGS m U e η u
    hMoBD b htr

  have hpow_ne : ∀ k : ℤ, k ≠ 0 → (U b).valuation (η b) ^ k ≠ 1 := by
    intro k hk h
