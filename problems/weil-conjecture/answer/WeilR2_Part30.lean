      hzTB.isAlgebraic_field
    have : Algebra.EssFiniteType (IntermediateField.adjoin k (Set.range z)) κ :=
      Algebra.EssFiniteType.of_comp k _ κ
    exact Algebra.finite_of_essFiniteType_of_isAlgebraic
  · rw [hz]; exact hsep

theorem wcpa_dj_lr1s_nf_cnf_fmp_gb_cs_rf_ca_gauss_recoord_rc_prim_coords (k κ : Type u) [Field k] [Field κ] [Algebra k κ] (d : ℕ) (z : Fin d → κ) (hfd : FiniteDimensional ↥(IntermediateField.adjoin k (Set.range z)) κ) (hsep : Algebra.IsSeparable ↥(IntermediateField.adjoin k (Set.range z)) κ) : ∃ (g : Polynomial (MvPolynomial (Fin d) k)) (θ : κ), g.Monic ∧ (g.map (MvPolynomial.aeval z).toRingHom).eval θ = 0 ∧ (g.map (MvPolynomial.aeval z).toRingHom).derivative.eval θ ≠ 0 ∧ ∀ y : κ, ∃ (h : Polynomial (MvPolynomial (Fin d) k)) (q : MvPolynomial (Fin d) k), MvPolynomial.aeval z q ≠ 0 ∧ MvPolynomial.aeval z q * y = (h.map (MvPolynomial.aeval z).toRingHom).eval θ :=
