  let b : ↥(integralClosure ↥O.toSubring L) := ∑ t, cR t • β t
  have hbcoe : ((b : _) : L) = ∑ t, algebraMap K L (c t) * (β t : L) := by
    show ((∑ t, cR t • β t : ↥(integralClosure ↥O.toSubring L)) : L) = _
