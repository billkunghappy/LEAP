theorem wcpa_dj_lr1k_cp_integral_model : ∀ (k : Type u) [Field k] (F : Type u) [Field F] [Algebra (RatFunc k) F] [FiniteDimensional (RatFunc k) F] [Algebra (Polynomial k) F] [IsScalarTower (Polynomial k) (RatFunc k) F], ∃ D : Subalgebra (Polynomial k) F, Module.Finite (Polynomial k) D ∧ IsFractionRing D F :=
