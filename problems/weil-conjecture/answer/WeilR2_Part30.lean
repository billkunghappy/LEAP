    have hleft : αb.comp γ0 = RingHom.id _ := by
      apply Ideal.Quotient.ringHom_ext
      apply RingHom.ext
      intro a
      simp only [RingHom.comp_apply, RingHom.id_apply, hγ0, hαb]
      rw [← RingHom.comp_apply α g, hαg]
    have hγ0loc : IsLocalHom γ0 := by
