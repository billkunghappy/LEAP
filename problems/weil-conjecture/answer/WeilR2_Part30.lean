theorem wcpa_dj_lr1k_eb_eg_sep_count_bound : ∀ (K L : Type u) [Field K] [Field L]
    [Algebra K L] [FiniteDimensional K L] (V₀ : ValuationSubring K),
    letI : Algebra ↥V₀ L := ((algebraMap K L).comp V₀.subtype).toAlgebra
    Module.Free ↥V₀ ↥(integralClosure ↥V₀ L) →
    Module.finrank ↥V₀ ↥(integralClosure ↥V₀ L) = Module.finrank K L →
    ∀ s : L, (∀ V : ValuationSubring L, V.comap (algebraMap K L) = V₀ → s ∈ V) →
    ∀ V₁ V₂ : ValuationSubring L, V₁.comap (algebraMap K L) = V₀ →
      V₂.comap (algebraMap K L) = V₀ → V₁ ≠ V₂ →
      V₁.valuation s < 1 → V₂.valuation s < 1 →
      V₁.valuation (algebraMap K L ((LinearMap.charpoly (Algebra.lmul K L s)).coeff 1)) < 1 :=
by
  intro K L _ _ _ _ V₀
  letI : Algebra ↥V₀ L := ((algebraMap K L).comp V₀.subtype).toAlgebra
  intro hF hR s hs V₁ V₂ h₁ h₂ hne hs₁ hs₂
  classical



  have s8 : ∀ (V : ValuationSubring L), V.comap (algebraMap K L) = V₀ →
      ∀ a : ↥V₀, (V.valuation (algebraMap K L (a : K)) < 1 ↔
        a ∈ IsLocalRing.maximalIdeal ↥V₀) := by
    intro V hV a
    have hchar : ∀ {F : Type u} [Field F] (A : ValuationSubring F) (y : F),
        A.valuation y < 1 ↔ y ∈ A ∧ (y = 0 ∨ y⁻¹ ∉ A) := by
      intro F _ A y
      rw [← A.valuation_le_one_iff, ← A.valuation_le_one_iff]
      by_cases hy : y = 0
      · subst hy; simp
      · simp only [hy, false_or, map_inv₀, not_le]
        have h0 : A.valuation y ≠ 0 := by simpa using hy
