    rw [← hrepr_b, ← hdq, map_smul, Finsupp.smul_apply, smul_eq_mul]
  have h2 : (1 : K) = d * ((β.repr qB t₀ : ↥O.toSubring) : K) := congrArg Subtype.val h1
  have h3 : O.valuation ((β.repr qB t₀ : ↥O.toSubring) : K) ≤ 1 :=
    (O.valuation_le_one_iff _).mpr (β.repr qB t₀).2
  have h4 := congrArg O.valuation h2
  rw [Valuation.map_one, Valuation.map_mul] at h4
  have h5 : O.valuation d * O.valuation ((β.repr qB t₀ : ↥O.toSubring) : K) < 1 :=
    lt_of_le_of_lt (mul_le_of_le_one_right' h3) hdv
  rw [← h4] at h5
  exact lt_irrefl _ h5

