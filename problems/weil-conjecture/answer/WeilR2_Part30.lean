      refine IsIntegral.sum _ (fun j _ => ?_)
      rw [Algebra.smul_def]
      exact (isIntegral_algebraMap).mul (hbi j)

  have hμinj : Function.Injective (LinearMap.mulLeft T (algebraMap T A h)) := by
    intro x y hxy
    exact mul_left_cancel₀ (hne h hh0) hxy
  have hF₀fg : F₀.FG := by
    rw [hF₀]; exact Submodule.fg_span (Set.finite_range b)
  haveI : Module.Finite T F₀ := Module.Finite.iff_fg.mpr hF₀fg
  obtain ⟨Nn, hNn⟩ : ∃ Nn : Submodule T F₀,
