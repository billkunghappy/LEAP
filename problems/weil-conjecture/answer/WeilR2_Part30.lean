theorem wcpa_dj_lr1s_nf_cnf_fmp_gb_cs_rf_cc_na_abs_mul : ∀ (V B : Type u) [CommRing V] [CommRing B] [IsDomain B] [Algebra V B] (t : V), Function.Injective (algebraMap V B) → IsUnit (algebraMap V B t) → ¬ IsUnit t → (∀ c : V, c ≠ 0 → ∃ N : ℕ, c ∣ t ^ N) → (∀ y : B, y ≠ 0 → ∃ z : B, y * z = 1 ∧ (IsIntegral V y ∨ IsIntegral V z)) → (∀ y : B, y ≠ 0 → IsIntegral V y → ∃ (c : V) (u v : B), y = algebraMap V B c * u ∧ u * v = 1 ∧ IsIntegral V u ∧ IsIntegral V v) → ∀ x y : B, wcRfAbs V (algebraMap V B t) (x * y) = wcRfAbs V (algebraMap V B t) x * wcRfAbs V (algebraMap V B t) y :=
