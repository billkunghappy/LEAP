        V.valuation (algebraMap Ω (RatFunc Ω) (R.coeff j))) →
    (∀ (c : Ω), c ≠ 0 → ∀ (f : RatFunc Ω) (p q : Polynomial Ω), q ≠ 0 →
      f * algebraMap (Polynomial Ω) (RatFunc Ω) q = algebraMap (Polynomial Ω) (RatFunc Ω) p →
      (wcEbAnInOc W c f ↔
        V.valuation (algebraMap (Polynomial Ω) (RatFunc Ω)
            (p.comp (Polynomial.C c * Polynomial.X))) ≤
