      obtain ⟨w, hw⟩ := (Submodule.mem_span_range_iff_exists_fun T).mp hN
      have hsum : ∑ j, (g' * w j - t ^ N * (h * c' j)) • b j = 0 := by
        simp only [sub_smul, Finset.sum_sub_distrib]
        rw [sub_eq_zero]
        calc ∑ j, (g' * w j) • b j = algebraMap T A g' * ∑ j, w j • b j := by
              rw [Finset.mul_sum]
              refine Finset.sum_congr rfl (fun j _ => ?_)
              rw [Algebra.smul_def, Algebra.smul_def, map_mul, mul_assoc]
          _ = algebraMap T A (t ^ N * h) * (algebraMap T A g' * a) := by
              rw [hw, map_mul, map_pow]; ring
          _ = ∑ j, (t ^ N * (h * c' j)) • b j := by
              rw [hc', Finset.mul_sum]
              refine Finset.sum_congr rfl (fun j _ => ?_)
              rw [Algebra.smul_def]
              simp only [map_mul, map_pow]
