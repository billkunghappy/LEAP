        rw [hE, pow_zero, mul_one, add_sub_cancel_right]
        have e : Polynomial.eval₂ ((algebraMap (RatFunc Ω) L).comp (algebraMap Ω (RatFunc Ω)))
            (η b) p = (Polynomial.eval₂ ((algebraMap (RatFunc Ω) L).comp
              (algebraMap Ω (RatFunc Ω))) (η b) p -
              algebraMap (RatFunc Ω) L (algebraMap Ω (RatFunc Ω) a') * η b ^ j) +
