  have hle : κ σ ≤ ∑ τ, κ τ :=
    Finset.single_le_sum (fun _ _ => Nat.zero_le _) (Finset.mem_univ σ)
  rw [map_mul, map_pow, ← Nat.sub_add_cancel hle, pow_add, mul_assoc]
