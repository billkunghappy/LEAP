by
  intro Ω _ _ W V h1 h2 hGF hIO f hf
  classical

  have hcoef : ∀ (R : Polynomial Ω) (c : Ω) (j : ℕ),
      V.valuation (algebraMap Ω (RatFunc Ω) ((R.comp (Polynomial.C c * Polynomial.X)).coeff j)) =
        V.valuation (algebraMap Ω (RatFunc Ω) (R.coeff j)) *
          V.valuation (algebraMap Ω (RatFunc Ω) c) ^ j := by
    intro R c j
    rw [Polynomial.comp_C_mul_X_coeff, map_mul, map_pow, Valuation.map_mul, Valuation.map_pow]
