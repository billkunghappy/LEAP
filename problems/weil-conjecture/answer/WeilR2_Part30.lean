    rw [gen2 _ _ hpt, map_zero] at h3
    rw [← Ideal.Quotient.eq_zero_iff_mem]
    exact E1s.symm.trans h3

  have s1 : ∀ (A R : Type u) [CommRing A] [IsLocalRing A] [CommRing R] [IsLocalRing R]
      (s : A →+* R) (K : Ideal A), Function.Surjective s → RingHom.ker s = K →
      ∃ ρ : ∀ n : ℕ, (R ⧸ IsLocalRing.maximalIdeal R ^ n) ≃+*
        (A ⧸ (K ⊔ IsLocalRing.maximalIdeal A ^ n)),
        ∀ (n : ℕ) (x : R) (y : A), ρ (n + 1) (Ideal.Quotient.mk _ x) = Ideal.Quotient.mk _ y →
          ρ n (Ideal.Quotient.mk _ x) = Ideal.Quotient.mk _ y := by
    intro A R _ _ _ _ s K hs hK
    have hΦs : ∀ n : ℕ,
        Function.Surjective ((Ideal.Quotient.mk (IsLocalRing.maximalIdeal R ^ n)).comp s) :=
      fun n => Ideal.Quotient.mk_surjective.comp hs
    have hΦk : ∀ n : ℕ, RingHom.ker ((Ideal.Quotient.mk (IsLocalRing.maximalIdeal R ^ n)).comp s) =
        K ⊔ IsLocalRing.maximalIdeal A ^ n := by
      intro n
      rw [← RingHom.comap_ker, Ideal.mk_ker, ← IsLocalRing.map_maximalIdeal_of_surjective s hs,
        ← Ideal.map_pow, Ideal.comap_map_of_surjective' s hs, hK, sup_comm]
    let ρ : ∀ n : ℕ, (R ⧸ IsLocalRing.maximalIdeal R ^ n) ≃+*
        (A ⧸ (K ⊔ IsLocalRing.maximalIdeal A ^ n)) :=
      fun n => (RingHom.quotientKerEquivOfSurjective (hΦs n)).symm.trans
        (Ideal.quotEquivOfEq (hΦk n))
    have hρ : ∀ (n : ℕ) (a : A), ρ n (Ideal.Quotient.mk _ (s a)) = Ideal.Quotient.mk _ a := by
      intro n a
      have h1 : (RingHom.quotientKerEquivOfSurjective (hΦs n)).symm
          (((Ideal.Quotient.mk (IsLocalRing.maximalIdeal R ^ n)).comp s) a) =
            Ideal.Quotient.mk _ a := by
        rw [RingEquiv.symm_apply_eq]; rfl
      show (Ideal.quotEquivOfEq (hΦk n)) ((RingHom.quotientKerEquivOfSurjective (hΦs n)).symm
        (((Ideal.Quotient.mk (IsLocalRing.maximalIdeal R ^ n)).comp s) a)) = _
      rw [h1, Ideal.quotEquivOfEq_mk]
    refine ⟨ρ, fun n x y hxy => ?_⟩
    obtain ⟨a, rfl⟩ := hs x
    rw [hρ] at hxy ⊢
    rw [Ideal.Quotient.eq] at hxy ⊢
    have hle : K ⊔ IsLocalRing.maximalIdeal A ^ (n + 1) ≤ K ⊔ IsLocalRing.maximalIdeal A ^ n :=
      sup_le_sup_left (Ideal.pow_le_pow_right (Nat.le_succ n)) K
    exact hle hxy

  have s2 : ∀ (t : ↥(Spec (.of (IsLocalRing.ResidueField ↥W)))),
      RingHom.ker ((Spec.map (CommRingCat.ofHom
        (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))).stalkMap t).hom =
      Ideal.map (((Spec (.of ↥W)).presheaf.germ ⊤ ((Spec.map (CommRingCat.ofHom
        (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) t) trivial).hom.comp
          (Scheme.ΓSpecIso (.of ↥W)).inv.hom) (IsLocalRing.maximalIdeal ↥W) := by
    intro t
    have ha : ((Spec.map (CommRingCat.ofHom
        (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))).stalkMap t).hom.comp
          (((Spec (.of ↥W)).presheaf.germ ⊤ ((Spec.map (CommRingCat.ofHom
            (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) t) trivial).hom.comp
              (Scheme.ΓSpecIso (.of ↥W)).inv.hom) =
        (((Spec (.of (IsLocalRing.ResidueField ↥W))).presheaf.germ ⊤ t trivial).hom.comp
          (Scheme.ΓSpecIso (.of (IsLocalRing.ResidueField ↥W))).inv.hom).comp
            (algebraMap ↥W (IsLocalRing.ResidueField ↥W)) := by
      ext a
      simp only [RingHom.comp_apply]
      have hn := congrArg (fun g => g.hom a) (Scheme.ΓSpecIso_inv_naturality
        (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))
      simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at hn
      refine (Scheme.Hom.germ_stalkMap_apply (Spec.map (CommRingCat.ofHom
        (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) ⊤ t trivial _).trans ?_
      exact congrArg (fun s => ((Spec (.of (IsLocalRing.ResidueField ↥W))).presheaf.germ ⊤ t
        trivial).hom s) hn.symm
    have hinj : Function.Injective (((Spec (.of (IsLocalRing.ResidueField ↥W))).presheaf.germ ⊤ t
        trivial).hom.comp (Scheme.ΓSpecIso (.of (IsLocalRing.ResidueField ↥W))).inv.hom) :=
      RingHom.injective _
    have hcker : RingHom.ker (((Spec.map (CommRingCat.ofHom
        (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))).stalkMap t).hom.comp
          (((Spec (.of ↥W)).presheaf.germ ⊤ ((Spec.map (CommRingCat.ofHom
            (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) t) trivial).hom.comp
              (Scheme.ΓSpecIso (.of ↥W)).inv.hom)) = IsLocalRing.maximalIdeal ↥W := by
      rw [ha, RingHom.ker_comp_of_injective _ hinj, IsLocalRing.ResidueField.algebraMap_eq,
        IsLocalRing.ker_residue]
    have hpt : (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) t =
        IsLocalRing.closedPoint ↥W := by
      have : IsLocalHom (CommRingCat.ofHom
          (algebraMap ↥W (IsLocalRing.ResidueField ↥W))).hom := by
        rw [CommRingCat.hom_ofHom, IsLocalRing.ResidueField.algebraMap_eq]; infer_instance
      have ht : t = IsLocalRing.closedPoint (IsLocalRing.ResidueField ↥W) :=
        @Subsingleton.elim (PrimeSpectrum (IsLocalRing.ResidueField ↥W)) _ t _
      rw [ht]
      exact Spec_closedPoint
    have hgen : ∀ (y' : ↥(Spec (.of ↥W))) (hy : y' = IsLocalRing.closedPoint ↥W),
        Function.Surjective (((Spec (.of ↥W)).presheaf.germ ⊤ y' trivial).hom.comp
          (Scheme.ΓSpecIso (.of ↥W)).inv.hom) := by
      rintro _ rfl
      have hiso : (Scheme.ΓSpecIso (.of ↥W)).inv ≫
          (Spec (.of ↥W)).presheaf.germ ⊤ (IsLocalRing.closedPoint ↥W) trivial =
            (stalkClosedPointIso (.of ↥W)).inv := by
        rw [← ΓSpecIso_hom_stalkClosedPointIso_inv, Iso.inv_hom_id_assoc]
      intro u
      refine ⟨(stalkClosedPointIso (.of ↥W)).hom.hom u, ?_⟩
      have h2 := congrArg (fun g => g.hom ((stalkClosedPointIso (.of ↥W)).hom.hom u)) hiso
      simp only [CommRingCat.hom_comp, RingHom.comp_apply] at h2
      refine (RingHom.comp_apply _ _ _).trans (h2.trans ?_)
      show ((stalkClosedPointIso (.of ↥W)).hom ≫ (stalkClosedPointIso (.of ↥W)).inv).hom u = u
      rw [Iso.hom_inv_id]
      rfl
    have hcs := hgen _ hpt
    have hm := Ideal.map_comap_of_surjective _ hcs (RingHom.ker ((Spec.map (CommRingCat.ofHom
        (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))).stalkMap t).hom)
    rw [RingHom.comap_ker, hcker] at hm
    exact hm.symm

  have s3 : ∀ (Z : Scheme.{u}) (h : Z ⟶ Spec (.of ↥W)) (z : Z) (y : ↥(Spec (.of ↥W)))
      (e : h z = y), (wcLdnmTvRho h z y e).comp (((Spec (.of ↥W)).presheaf.germ ⊤ y trivial).hom.comp
        (Scheme.ΓSpecIso (.of ↥W)).inv.hom) = wcNdSig h z := by
    intro Z h z y e
    subst e
    ext b
    simp only [wcLdnmTvRho, wcNdSig, wcCnSigma, RingHom.comp_apply,
      TopCat.Presheaf.stalkSpecializes_refl, CommRingCat.hom_id, RingHom.id_apply]
    refine (Scheme.Hom.germ_stalkMap_apply h ⊤ z trivial _).trans ?_
    exact (TopCat.Presheaf.germ_res_apply Z.presheaf (homOfLE (le_top : (⊤ : Z.Opens) ≤ ⊤))
      z trivial _).symm

  have hpb : IsPullback
      (Limits.pullback.fst (f.fromNormalization ≫ uX)
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))))
      (Limits.pullback.snd (f.fromNormalization ≫ uX)
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))))
      (f.fromNormalization ≫ uX)
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) :=
    IsPullback.of_hasPullback _ _
  have hlam : IsClosedImmersion
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) := by
    apply IsClosedImmersion.spec_of_surjective
    show Function.Surjective (algebraMap ↥W (IsLocalRing.ResidueField ↥W))
    rw [IsLocalRing.ResidueField.algebraMap_eq]
    exact IsLocalRing.residue_surjective
  have e : (f.fromNormalization ≫ uX) (Limits.pullback.fst (f.fromNormalization ≫ uX)
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) w) =
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))
        (Limits.pullback.snd (f.fromNormalization ≫ uX)
          (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) w) := by
    rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, Limits.pullback.condition]
  obtain ⟨hsurj, hker⟩ := pbs _ _ _ _ hpb hlam w _ rfl e
  rw [s2, Ideal.map_map, s3] at hker
  obtain ⟨ρ, hρ⟩ := s1 _ _ _ _ hsurj hker
  exact ⟨ρ, hρ⟩

theorem wcpa_dj_lr1k_ndmf_modelA_levels : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω),
    (Ideal.span {Polynomial.X} ⊔ Ideal.map Polynomial.C (IsLocalRing.maximalIdeal ↥W) :
      Ideal (Polynomial ↥W)).IsMaximal ∧
    ∃ ψ : ∀ n : ℕ, (Polynomial ↥W ⧸ (Ideal.map Polynomial.C (IsLocalRing.maximalIdeal ↥W) ⊔
        (Ideal.span {Polynomial.X} ⊔ Ideal.map Polynomial.C (IsLocalRing.maximalIdeal ↥W) :
          Ideal (Polynomial ↥W)) ^ n)) ≃+*
      (Polynomial (IsLocalRing.ResidueField ↥W) ⧸
        Ideal.span {(Polynomial.X ^ n : Polynomial (IsLocalRing.ResidueField ↥W))}),
      ∀ (n : ℕ) (x : Polynomial ↥W) (y : Polynomial (IsLocalRing.ResidueField ↥W)),
        ψ (n + 1) (Ideal.Quotient.mk _ x) = Ideal.Quotient.mk _ y →
          ψ n (Ideal.Quotient.mk _ x) = Ideal.Quotient.mk _ y :=
by
  intro Ω _ W
  classical
  let Φ : Polynomial ↥W →+* Polynomial (IsLocalRing.ResidueField ↥W) :=
    Polynomial.mapRingHom (IsLocalRing.residue ↥W)
  have hΦ : Function.Surjective Φ :=
    Polynomial.map_surjective _ IsLocalRing.residue_surjective
  have hker : RingHom.ker Φ = Ideal.map Polynomial.C (IsLocalRing.maximalIdeal ↥W) := by
    show RingHom.ker (Polynomial.mapRingHom (IsLocalRing.residue ↥W)) = _
    rw [Polynomial.ker_mapRingHom, IsLocalRing.ker_residue]
  have hI : Ideal.map Φ (Ideal.map Polynomial.C (IsLocalRing.maximalIdeal ↥W)) = ⊥ := by
    rw [Ideal.map_eq_bot_iff_le_ker, hker]
  have hX : Ideal.map Φ (Ideal.span {(Polynomial.X : Polynomial ↥W)}) =
      Ideal.span {(Polynomial.X : Polynomial (IsLocalRing.ResidueField ↥W))} := by
    rw [Ideal.map_span, Set.image_singleton]
    simp [Φ]
  have hM : Ideal.map Φ (Ideal.span {Polynomial.X} ⊔
      Ideal.map Polynomial.C (IsLocalRing.maximalIdeal ↥W) : Ideal (Polynomial ↥W)) =
      Ideal.span {(Polynomial.X : Polynomial (IsLocalRing.ResidueField ↥W))} := by
    rw [Ideal.map_sup, hX, hI, sup_bot_eq]
  have hJ : ∀ n : ℕ, (Ideal.map Polynomial.C (IsLocalRing.maximalIdeal ↥W) ⊔
        (Ideal.span {Polynomial.X} ⊔ Ideal.map Polynomial.C (IsLocalRing.maximalIdeal ↥W) :
          Ideal (Polynomial ↥W)) ^ n) =
      Ideal.comap Φ
        (Ideal.span {(Polynomial.X ^ n : Polynomial (IsLocalRing.ResidueField ↥W))}) := by
    intro n
    have h1 : Ideal.map Φ (Ideal.map Polynomial.C (IsLocalRing.maximalIdeal ↥W) ⊔
        (Ideal.span {Polynomial.X} ⊔ Ideal.map Polynomial.C (IsLocalRing.maximalIdeal ↥W) :
          Ideal (Polynomial ↥W)) ^ n) =
        Ideal.span {(Polynomial.X ^ n : Polynomial (IsLocalRing.ResidueField ↥W))} := by
      rw [Ideal.map_sup, Ideal.map_pow, hM, hI, bot_sup_eq, Ideal.span_singleton_pow]
    rw [← h1, Ideal.comap_map_of_surjective' Φ hΦ, hker]
    exact (sup_eq_left.mpr le_sup_left).symm
  have hMc : (Ideal.span {Polynomial.X} ⊔
      Ideal.map Polynomial.C (IsLocalRing.maximalIdeal ↥W) : Ideal (Polynomial ↥W)) =
      Ideal.comap Φ (Ideal.span {(Polynomial.X : Polynomial (IsLocalRing.ResidueField ↥W))}) := by
    rw [← hM, Ideal.comap_map_of_surjective' Φ hΦ, hker]
    exact (sup_eq_left.mpr le_sup_right).symm
  have hXmax : (Ideal.span {(Polynomial.X : Polynomial (IsLocalRing.ResidueField ↥W))}).IsMaximal := by
    rw [← Polynomial.ker_constantCoeff]
    exact RingHom.ker_isMaximal_of_surjective _
      (fun a => ⟨Polynomial.C a, Polynomial.coeff_C_zero⟩)
  refine ⟨?_, ?_⟩
  · rw [hMc]
    exact Ideal.comap_isMaximal_of_surjective Φ hΦ
  · let g : ∀ n : ℕ, Polynomial ↥W →+* (Polynomial (IsLocalRing.ResidueField ↥W) ⧸
        Ideal.span {(Polynomial.X ^ n : Polynomial (IsLocalRing.ResidueField ↥W))}) :=
      fun n => (Ideal.Quotient.mk _).comp Φ
    have hg : ∀ n, Function.Surjective (g n) := fun n => Ideal.Quotient.mk_surjective.comp hΦ
    have hgk : ∀ n : ℕ, (Ideal.map Polynomial.C (IsLocalRing.maximalIdeal ↥W) ⊔
        (Ideal.span {Polynomial.X} ⊔ Ideal.map Polynomial.C (IsLocalRing.maximalIdeal ↥W) :
          Ideal (Polynomial ↥W)) ^ n) = RingHom.ker (g n) := by
      intro n
      rw [hJ n]
      show _ = RingHom.ker ((Ideal.Quotient.mk _).comp Φ)
      rw [← RingHom.comap_ker, Ideal.mk_ker]
    refine ⟨fun n => (Ideal.quotEquivOfEq (hgk n)).trans
      (RingHom.quotientKerEquivOfSurjective (hg n)), ?_⟩
    intro n x y hxy
    simp only [RingEquiv.trans_apply, Ideal.quotEquivOfEq_mk,
      RingHom.quotientKerEquivOfSurjective_apply_mk] at hxy ⊢
    change (Ideal.Quotient.mk _) (Φ x) = _ at hxy
    change (Ideal.Quotient.mk _) (Φ x) = _
    rw [Ideal.Quotient.eq] at hxy ⊢
    exact Ideal.span_singleton_le_span_singleton.mpr (pow_dvd_pow _ (Nat.le_succ n)) hxy

theorem wcpa_dj_lr1k_ndmf_modelB_levels : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω)
    (g : ↥W), g ∈ IsLocalRing.maximalIdeal ↥W →
    ∀ (T : Type u) [CommRing T] (q : MvPolynomial (Fin 2) ↥W →+* T), Function.Surjective q →
    RingHom.ker q = Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 -
        MvPolynomial.C g : MvPolynomial (Fin 2) ↥W)} →
    (Ideal.map q
      (Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 2) ↥W), MvPolynomial.X 1} ⊔
        Ideal.map MvPolynomial.C (IsLocalRing.maximalIdeal ↥W))).IsMaximal ∧
    ∃ ψ : ∀ n : ℕ, (T ⧸ (Ideal.map (q.comp MvPolynomial.C) (IsLocalRing.maximalIdeal ↥W) ⊔
          Ideal.map q
            (Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 2) ↥W), MvPolynomial.X 1} ⊔
              Ideal.map MvPolynomial.C (IsLocalRing.maximalIdeal ↥W)) ^ n)) ≃+*
      (MvPolynomial (Fin 2) (IsLocalRing.ResidueField ↥W) ⧸
        (Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 :
            MvPolynomial (Fin 2) (IsLocalRing.ResidueField ↥W))} ⊔
          Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 2) (IsLocalRing.ResidueField ↥W)),
            MvPolynomial.X 1} ^ n)),
      ∀ (n : ℕ) (x : T) (y : MvPolynomial (Fin 2) (IsLocalRing.ResidueField ↥W)),
        ψ (n + 1) (Ideal.Quotient.mk _ x) = Ideal.Quotient.mk _ y →
          ψ n (Ideal.Quotient.mk _ x) = Ideal.Quotient.mk _ y :=
by
  intro Ω _ W g hg T _ q hq hkq
  classical
  set I : Ideal (MvPolynomial (Fin 2) ↥W) :=
    Ideal.map MvPolynomial.C (IsLocalRing.maximalIdeal ↥W) with hIdef
  set N : Ideal (MvPolynomial (Fin 2) ↥W) :=
    Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 2) ↥W), MvPolynomial.X 1} ⊔ I with hNdef
  set S : Ideal (MvPolynomial (Fin 2) (IsLocalRing.ResidueField ↥W)) :=
    Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 2) (IsLocalRing.ResidueField ↥W)),
      MvPolynomial.X 1} with hSdef
  set P : MvPolynomial (Fin 2) ↥W := MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g
    with hPdef
  set Q : MvPolynomial (Fin 2) (IsLocalRing.ResidueField ↥W) :=
    MvPolynomial.X 0 * MvPolynomial.X 1 with hQdef
  let Φ : MvPolynomial (Fin 2) ↥W →+* MvPolynomial (Fin 2) (IsLocalRing.ResidueField ↥W) :=
    MvPolynomial.map (IsLocalRing.residue ↥W)
  have hΦ : Function.Surjective Φ :=
    MvPolynomial.map_surjective _ IsLocalRing.residue_surjective
  have hker : RingHom.ker Φ = I := by
    show RingHom.ker (MvPolynomial.map (IsLocalRing.residue ↥W)) = _
    rw [MvPolynomial.ker_map, IsLocalRing.ker_residue]
  have hg0 : IsLocalRing.residue ↥W g = 0 := (IsLocalRing.residue_eq_zero_iff g).mpr hg
  have hI : Ideal.map Φ I = ⊥ := by
    rw [Ideal.map_eq_bot_iff_le_ker, hker]
  have hX : Ideal.map Φ
      (Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 2) ↥W), MvPolynomial.X 1}) = S := by
    rw [Ideal.map_span, Set.image_pair]
    simp [Φ, S]
  have hN : Ideal.map Φ N = S := by
    rw [hNdef, Ideal.map_sup, hX, hI, sup_bot_eq]
  have hP : Φ P = Q := by
    simp [Φ, P, Q, hg0]
  have hPs : Ideal.map Φ (Ideal.span {P}) = Ideal.span {Q} := by
    rw [Ideal.map_span, Set.image_singleton, hP]

  have hJ : ∀ n : ℕ, Ideal.comap Φ (Ideal.span {Q} ⊔ S ^ n) = (I ⊔ N ^ n) ⊔ Ideal.span {P} := by
    intro n
    have h1 : Ideal.map Φ ((I ⊔ N ^ n) ⊔ Ideal.span {P}) = Ideal.span {Q} ⊔ S ^ n := by
      rw [Ideal.map_sup, Ideal.map_sup, Ideal.map_pow, hN, hI, hPs, bot_sup_eq, sup_comm]
    rw [← h1, Ideal.comap_map_of_surjective' Φ hΦ, hker]
    exact sup_eq_left.mpr (le_sup_left.trans le_sup_left)

  have hSmax : S.IsMaximal := by
    have hle : RingHom.ker (MvPolynomial.constantCoeff :
        MvPolynomial (Fin 2) (IsLocalRing.ResidueField ↥W) →+* _) ≤ S := by
      have aux : ∀ p : MvPolynomial (Fin 2) (IsLocalRing.ResidueField ↥W),
          p - MvPolynomial.C (MvPolynomial.constantCoeff p) ∈ S := by
        intro p
        induction p using MvPolynomial.induction_on with
        | C a => simp
        | add p p' hp hp' =>
          have e : (p + p') - MvPolynomial.C (MvPolynomial.constantCoeff (p + p')) =
              (p - MvPolynomial.C (MvPolynomial.constantCoeff p)) +
                (p' - MvPolynomial.C (MvPolynomial.constantCoeff p')) := by
            simp only [map_add]; ring
          rw [e]
          exact S.add_mem hp hp'
        | mul_X p i hp =>
          have e : p * MvPolynomial.X i -
              MvPolynomial.C (MvPolynomial.constantCoeff (p * MvPolynomial.X i)) =
              p * MvPolynomial.X i := by
            simp
          rw [e]
          apply S.mul_mem_left
          apply Ideal.subset_span
          fin_cases i <;> simp
      intro p hp
      rw [RingHom.mem_ker] at hp
      have := aux p
      rwa [hp, map_zero, sub_zero] at this
    have hge : S ≤ RingHom.ker (MvPolynomial.constantCoeff :
        MvPolynomial (Fin 2) (IsLocalRing.ResidueField ↥W) →+* _) := by
      rw [hSdef, Ideal.span_le]
      intro p hp
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hp
      rcases hp with rfl | rfl <;> simp
    have heq : S = RingHom.ker (MvPolynomial.constantCoeff :
        MvPolynomial (Fin 2) (IsLocalRing.ResidueField ↥W) →+* _) := le_antisymm hge hle
    rw [heq]
    exact RingHom.ker_isMaximal_of_surjective _
      (fun a => ⟨MvPolynomial.C a, MvPolynomial.constantCoeff_C _ _⟩)
  have hNc : N = Ideal.comap Φ S := by
    rw [← hN, Ideal.comap_map_of_surjective' Φ hΦ, hker]
    exact (sup_eq_left.mpr le_sup_right).symm
  have hNmax : N.IsMaximal := by
    rw [hNc]
    exact Ideal.comap_isMaximal_of_surjective Φ hΦ
  have hkqN : RingHom.ker q ≤ N := by
    rw [hkq, Ideal.span_singleton_le_iff_mem, hPdef]
    apply N.sub_mem
    · apply Ideal.mem_sup_left
      exact Ideal.mul_mem_right _ _ (Ideal.subset_span (Set.mem_insert _ _))
    · apply Ideal.mem_sup_right
      exact Ideal.mem_map_of_mem _ hg
  have hmax : (Ideal.map q N).IsMaximal := by
    rcases Ideal.map_eq_top_or_isMaximal_of_surjective q hq hNmax with h | h
    · exfalso
      apply hNmax.ne_top
      have h2 := Ideal.comap_map_of_surjective' q hq N
      rw [h, Ideal.comap_top, sup_eq_left.mpr hkqN] at h2
      exact h2.symm
    · exact h

  let e : (MvPolynomial (Fin 2) ↥W ⧸ RingHom.ker q) ≃+* T :=
    RingHom.quotientKerEquivOfSurjective hq
  have hvan : ∀ n : ℕ, ∀ a ∈ RingHom.ker q,
      ((Ideal.Quotient.mk (Ideal.span {Q} ⊔ S ^ n)).comp Φ) a = 0 := by
    intro n a ha
    rw [hkq] at ha
    rw [RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem]
    have h1 : Φ a ∈ Ideal.map Φ (Ideal.span {P}) := Ideal.mem_map_of_mem Φ ha
    rw [hPs] at h1
    exact Ideal.mem_sup_left h1
  let lam : ∀ n : ℕ, T →+* (MvPolynomial (Fin 2) (IsLocalRing.ResidueField ↥W) ⧸
      (Ideal.span {Q} ⊔ S ^ n)) := fun n =>
    (Ideal.Quotient.lift (RingHom.ker q) ((Ideal.Quotient.mk (Ideal.span {Q} ⊔ S ^ n)).comp Φ)
      (hvan n)).comp (e.symm : T →+* (MvPolynomial (Fin 2) ↥W ⧸ RingHom.ker q))
  have hlam : ∀ (n : ℕ) (a : MvPolynomial (Fin 2) ↥W),
      lam n (q a) = Ideal.Quotient.mk (Ideal.span {Q} ⊔ S ^ n) (Φ a) := by
    intro n a
    have h1 : q a = e (Ideal.Quotient.mk _ a) :=
      (RingHom.quotientKerEquivOfSurjective_apply_mk hq a).symm
    change (Ideal.Quotient.lift (RingHom.ker q)
      ((Ideal.Quotient.mk (Ideal.span {Q} ⊔ S ^ n)).comp Φ) (hvan n)) (e.symm (q a)) = _
    rw [h1, RingEquiv.symm_apply_apply, Ideal.Quotient.lift_mk]
    rfl
  have hlams : ∀ n : ℕ, Function.Surjective (lam n) := by
    intro n z
    obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective z
    obtain ⟨a, rfl⟩ := hΦ b
    exact ⟨q a, hlam n a⟩
  have hlamker : ∀ n : ℕ, RingHom.ker (lam n) = Ideal.map (q.comp MvPolynomial.C)
      (IsLocalRing.maximalIdeal ↥W) ⊔ Ideal.map q N ^ n := by
    intro n
    have hc : (lam n).comp q = (Ideal.Quotient.mk (Ideal.span {Q} ⊔ S ^ n)).comp Φ :=
      RingHom.ext (fun a => hlam n a)
    have hbot : Ideal.map q (RingHom.ker q) = ⊥ := by
      rw [Ideal.map_eq_bot_iff_le_ker]
    rw [← Ideal.map_comap_of_surjective q hq (RingHom.ker (lam n)), RingHom.comap_ker, hc,
      ← RingHom.comap_ker, Ideal.mk_ker, hJ n, Ideal.map_sup, Ideal.map_sup, Ideal.map_pow,
      ← hkq, hbot, sup_bot_eq, hIdef, Ideal.map_map]
  refine ⟨hmax, fun n => (Ideal.quotEquivOfEq (hlamker n).symm).trans
    (RingHom.quotientKerEquivOfSurjective (hlams n)), ?_⟩
  intro n x y hxy
  obtain ⟨a, rfl⟩ := hq x
  simp only [RingEquiv.trans_apply, Ideal.quotEquivOfEq_mk,
    RingHom.quotientKerEquivOfSurjective_apply_mk, hlam] at hxy ⊢
  rw [Ideal.Quotient.eq] at hxy ⊢
  have hle : Ideal.span {Q} ⊔ S ^ (n + 1) ≤ Ideal.span {Q} ⊔ S ^ n :=
    sup_le_sup_left (Ideal.pow_le_pow_right (Nat.le_succ n)) _
  exact hle hxy

theorem wcpa_dj_lr1k_ndmf_stalk_finiteness : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (Ct : Scheme.{u}) (φ : Ct ⟶ wcProjK Ω 1), wcpaDjLkCov Ω φ →
    ∀ (X : Scheme.{u}) (uX : X ⟶ Spec (.of ↥W)) (ι : wcProjK Ω 1 ⟶ X)
      [QuasiCompact (φ ≫ ι)] [QuasiSeparated (φ ≫ ι)],
    wcpaDjLkModel W uX ι → ∀ w : ↥(wcpaDjLkFib W (φ ≫ ι) uX),
      IsNoetherianRing ↥((wcpaDjLkFib W (φ ≫ ι) uX).presheaf.stalk w) ∧
      (_root_.IsReduced ↥((wcpaDjLkFib W (φ ≫ ι) uX).presheaf.stalk w) →
        Module.Finite ↥((wcpaDjLkFib W (φ ≫ ι) uX).presheaf.stalk w)
          ↥(integralClosure ↥((wcpaDjLkFib W (φ ≫ ι) uX).presheaf.stalk w)
            (FractionRing ↥((wcpaDjLkFib W (φ ≫ ι) uX).presheaf.stalk w)))) :=
by
  intro Ω _ _ W hW hWt Ct φ hcov X uX ι _ _ hM w
  obtain ⟨hproj, hsm, hirr, hfinφ, hgen⟩ := hcov
  obtain ⟨hss, hXp, hpb⟩ := hM
  haveI : IsFinite φ := hfinφ

  haveI hνfin : IsFinite (φ ≫ ι).fromNormalization :=
    wcpa_dj_lr1s_normalization_finite Ω W hW hWt Ct (φ ≫ wcProjKStr Ω 1) φ hproj hsm hirr
      hfinφ rfl hgen X uX ι hss hXp hpb

  haveI : IsProper uX := hss.2.1
  haveI : LocallyOfFiniteType (Limits.pullback.snd ((φ ≫ ι).fromNormalization ≫ uX)
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) :=
    MorphismProperty.of_isPullback (P := @LocallyOfFiniteType) (IsPullback.of_hasPullback _ _)
      inferInstance

  have hc : (φ ≫ ι) ≫ uX =
      (φ ≫ wcProjKStr Ω 1) ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω)) := by
    rw [Category.assoc, hpb.w]; exact (Category.assoc _ _ _).symm
  haveI hred : AlgebraicGeometry.IsReduced (Limits.pullback ((φ ≫ ι).fromNormalization ≫ uX)
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) :=
    wcpa_dj_lr1k_imf_fib_reduced Ω W hWt Ct X (φ ≫ ι) uX (φ ≫ wcProjKStr Ω 1) hc

  haveI : IsAlgClosed (IsLocalRing.ResidueField ↥W) := wcpa_dj_nc_residue_algclosed Ω W
  haveI : PerfectField (IsLocalRing.ResidueField ↥W) := IsAlgClosed.perfectField _

  set Y := Limits.pullback ((φ ≫ ι).fromNormalization ≫ uX)
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) with hY
  set q := Limits.pullback.snd ((φ ≫ ι).fromNormalization ≫ uX)
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) with hq
  obtain ⟨U, hU, hwU, -⟩ := exists_isAffineOpen_mem_and_subset (U := ⊤) (x := w) (by trivial)
  have hft : ((Scheme.ΓSpecIso (.of (IsLocalRing.ResidueField ↥W))).inv ≫
      q.appLE ⊤ U le_top).hom.FiniteType := by
    have h1 := HasRingHomProperty.appLE @LocallyOfFiniteType (Q := RingHom.FiniteType) q
      inferInstance ⟨⊤, isAffineOpen_top _⟩ ⟨U, hU⟩ le_top
    rw [CommRingCat.hom_comp]
    refine RingHom.FiniteType.comp h1 (RingHom.FiniteType.of_surjective _ ?_)
    intro x
    exact ⟨(Scheme.ΓSpecIso (.of (IsLocalRing.ResidueField ↥W))).hom.hom x, by simp⟩
  letI : Algebra (IsLocalRing.ResidueField ↥W) Γ(Y, U) :=
    ((Scheme.ΓSpecIso (.of (IsLocalRing.ResidueField ↥W))).inv ≫ q.appLE ⊤ U le_top).hom.toAlgebra
  haveI : Algebra.FiniteType (IsLocalRing.ResidueField ↥W) Γ(Y, U) := hft
  haveI : IsNoetherianRing Γ(Y, U) :=
    Algebra.FiniteType.isNoetherianRing (IsLocalRing.ResidueField ↥W) _

  letI : Algebra Γ(Y, U) (Y.presheaf.stalk w) :=
    TopCat.Presheaf.algebra_section_stalk Y.presheaf ⟨w, hwU⟩
  haveI hloc : IsLocalization.AtPrime (Y.presheaf.stalk w) (hU.primeIdealOf ⟨w, hwU⟩).asIdeal :=
    hU.isLocalization_stalk ⟨w, hwU⟩

  have hnoeth : IsNoetherianRing (Y.presheaf.stalk w) :=
    IsLocalization.isNoetherianRing (hU.primeIdealOf ⟨w, hwU⟩).asIdeal.primeCompl _ inferInstance

  have hfin := wcpa_dj_lr1k_imfc_stalk_norm_finite (IsLocalRing.ResidueField ↥W) Γ(Y, U)
    (hU.primeIdealOf ⟨w, hwU⟩).asIdeal (Y.presheaf.stalk w)
  exact ⟨hnoeth, fun _ => hfin⟩

theorem wcpa_dj_lr1k_ndmf_smooth_levels_delta : ∀ (R k : Type u) [CommRing R] [IsLocalRing R]
    [IsNoetherianRing R] [Field k],
    (∀ n : ℕ, Nonempty ((R ⧸ IsLocalRing.maximalIdeal R ^ n) ≃+*
      (Polynomial k ⧸ Ideal.span {(Polynomial.X ^ n : Polynomial k)}))) →
    wcpaDjLkDelta R = 0 :=
by
  intro R k _ _ _ _ hlev
  classical
  set m := IsLocalRing.maximalIdeal R with hm
  have hmprime : m.IsPrime := (IsLocalRing.maximalIdeal.isMaximal R).isPrime

  have F2 : ∀ (n : ℕ), 1 ≤ n → ∀ (θ : (R ⧸ m ^ n) ≃+*
      (Polynomial k ⧸ Ideal.span {(Polynomial.X ^ n : Polynomial k)})) (a : R) (p : Polynomial k),
      θ (Ideal.Quotient.mk _ a) = Ideal.Quotient.mk _ p → Polynomial.X ∣ p → a ∈ m := by
    intro n hn θ a p h hdvd
    obtain ⟨q, rfl⟩ := hdvd
    have h1 : θ (Ideal.Quotient.mk _ (a ^ n)) =
        Ideal.Quotient.mk _ ((Polynomial.X * q) ^ n) := by
      simp only [map_pow, h]
    have h1' : Ideal.Quotient.mk (Ideal.span {(Polynomial.X ^ n : Polynomial k)})
        ((Polynomial.X * q) ^ n) = 0 := by
      rw [Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton, mul_pow]
      exact dvd_mul_right _ _
    have h2 : a ^ n ∈ m ^ n := by
      rw [← Ideal.Quotient.eq_zero_iff_mem]
      exact θ.injective ((h1.trans h1').trans (map_zero θ).symm)
    exact hmprime.mem_of_pow_mem n (Ideal.pow_le_self (by omega) h2)

  have F3 : ∀ (n : ℕ), 1 ≤ n → ∀ (θ : (R ⧸ m ^ n) ≃+*
      (Polynomial k ⧸ Ideal.span {(Polynomial.X ^ n : Polynomial k)})) (a : R) (p : Polynomial k),
      a ∈ m → θ (Ideal.Quotient.mk _ a) = Ideal.Quotient.mk _ p → Polynomial.X ∣ p := by
    intro n hn θ a p ha h
    have h1 : Ideal.Quotient.mk (m ^ n) (a ^ n) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.pow_mem_pow ha n)
    have h2 : Ideal.Quotient.mk (Ideal.span {(Polynomial.X ^ n : Polynomial k)}) (p ^ n) = 0 := by
      have := congrArg θ h1
      simp only [map_pow, h, map_zero] at this
      simpa only [map_pow] using this
    rw [Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton] at h2
    have h3 : Polynomial.X ∣ p ^ n := (dvd_pow_self Polynomial.X (by omega)).trans h2
    exact Polynomial.prime_X.dvd_of_dvd_pow h3

  obtain ⟨θ⟩ := hlev 2
  obtain ⟨t, ht⟩ := Ideal.Quotient.mk_surjective (θ.symm (Ideal.Quotient.mk _ Polynomial.X))
  have htθ : θ (Ideal.Quotient.mk _ t) = Ideal.Quotient.mk _ Polynomial.X := by
    rw [ht, RingEquiv.apply_symm_apply]
  have htm : t ∈ m := F2 2 (by norm_num) θ t _ htθ dvd_rfl
  have hle : m ≤ Ideal.span {t} ⊔ m • m := by
    intro a ha
    obtain ⟨p, hp⟩ := Ideal.Quotient.mk_surjective (θ (Ideal.Quotient.mk _ a))
    obtain ⟨q, hq⟩ := F3 2 (by norm_num) θ a p ha hp.symm
    obtain ⟨s, hs⟩ := Ideal.Quotient.mk_surjective (θ.symm (Ideal.Quotient.mk _ q))
    have h1 : θ (Ideal.Quotient.mk _ (t * s)) = θ (Ideal.Quotient.mk _ a) := by
      rw [map_mul, map_mul, hs, RingEquiv.apply_symm_apply, htθ, ← hp, hq, map_mul]
    have h2 : a - t * s ∈ m ^ 2 := Ideal.Quotient.eq.mp (θ.injective h1).symm
    have e : a = t * s + (a - t * s) := by ring
    rw [e]
    refine Submodule.add_mem_sup (Ideal.mul_mem_right s _ (Ideal.mem_span_singleton_self t)) ?_
    rw [Ideal.smul_eq_mul, ← pow_two]
    exact h2

  have hmt : m = Ideal.span {t} :=
    le_antisymm
      (Submodule.le_of_le_smul_of_le_jacobson_bot (IsNoetherian.noetherian m)
        (IsLocalRing.maximalIdeal_le_jacobson ⊥) hle)
      ((Ideal.span_singleton_le_iff_mem _).mpr htm)

  have htn : ∀ n : ℕ, t ^ n ≠ 0 := by
    intro n h0
    have hmn : m ^ n = ⊥ := by
      rw [hmt, Ideal.span_singleton_pow, h0, Ideal.span_singleton_eq_bot]
    obtain ⟨θ'⟩ := hlev (n + 1)
    obtain ⟨y, hy⟩ := Ideal.Quotient.mk_surjective (θ'.symm (Ideal.Quotient.mk _ Polynomial.X))
    have hyθ : θ' (Ideal.Quotient.mk _ y) = Ideal.Quotient.mk _ Polynomial.X := by
      rw [hy, RingEquiv.apply_symm_apply]
    have hym : y ∈ m := F2 (n + 1) (by omega) θ' y _ hyθ dvd_rfl
    have hyn : y ^ n = 0 := by
      have := Ideal.pow_mem_pow hym n
      rw [hmn] at this
      exact Ideal.mem_bot.mp this
    have h1 : Ideal.Quotient.mk (Ideal.span {(Polynomial.X ^ (n + 1) : Polynomial k)})
        (Polynomial.X ^ n) = 0 := by
      have := congrArg θ' (congrArg (Ideal.Quotient.mk (m ^ (n + 1))) hyn)
      simp only [map_pow, map_zero, hyθ] at this
      simpa only [map_pow] using this
    rw [Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton] at h1
    have := (pow_dvd_pow_iff Polynomial.X_ne_zero Polynomial.not_isUnit_X).mp h1
    omega

  have hkrull : ⨅ i : ℕ, m ^ i = ⊥ :=
    Ideal.iInf_pow_eq_bot_of_isLocalRing m (IsLocalRing.maximalIdeal.isMaximal R).ne_top
  have hnf : ∀ x : R, x ≠ 0 → ∃ (j : ℕ) (u : R), IsUnit u ∧ x = t ^ j * u := by
    intro x hx
    have hex : ∃ i, x ∉ m ^ i := by
      by_contra hcon
      push_neg at hcon
      apply hx
      have hmem : x ∈ ⨅ i : ℕ, m ^ i := Submodule.mem_iInf _ |>.mpr hcon
      rw [hkrull] at hmem
      exact Ideal.mem_bot.mp hmem
    obtain ⟨N, hN, hmin⟩ : ∃ N, x ∉ m ^ N ∧ ∀ i < N, x ∈ m ^ i :=
      ⟨Nat.find hex, Nat.find_spec hex, fun i hi => by simpa using Nat.find_min hex hi⟩
    have hN0 : N ≠ 0 := by
      intro h
      apply hN
      rw [h, pow_zero, Ideal.one_eq_top]
      exact Submodule.mem_top
    obtain ⟨j, rfl⟩ : ∃ j, N = j + 1 := ⟨N - 1, by omega⟩
    have hxj : x ∈ m ^ j := hmin j (by omega)
    rw [hmt, Ideal.span_singleton_pow, Ideal.mem_span_singleton] at hxj
    obtain ⟨u, hu⟩ := hxj
    refine ⟨j, u, ?_, hu⟩
    by_contra hu'
    have hum : u ∈ m := (IsLocalRing.mem_maximalIdeal u).mpr (mem_nonunits_iff.mpr hu')
    rw [hmt, Ideal.mem_span_singleton] at hum
    obtain ⟨v, hv⟩ := hum
    apply hN
    rw [hmt, Ideal.span_singleton_pow, Ideal.mem_span_singleton]
    exact ⟨v, by rw [hu, hv, pow_succ, mul_assoc]⟩

  have hdom : IsDomain R := by
    have : NoZeroDivisors R := ⟨fun {x y} hxy => by
      by_contra hc
      push_neg at hc
      obtain ⟨i, u, hu, rfl⟩ := hnf x hc.1
      obtain ⟨j, v, hv, rfl⟩ := hnf y hc.2
      apply htn (i + j)
      have e : t ^ (i + j) * (u * v) = 0 := by rw [← hxy]; ring
      exact (hu.mul hv).mul_left_eq_zero.mp e⟩
    exact NoZeroDivisors.to_isDomain R
  haveI := hdom
  have hnfield : ¬ IsField R := by
    rw [IsLocalRing.isField_iff_maximalIdeal_eq]
    intro h
    have h' : m = ⊥ := h
    rw [hmt, Ideal.span_singleton_eq_bot] at h'
    exact htn 1 (by rw [pow_one]; exact h')

  have hprinc : Submodule.IsPrincipal (IsLocalRing.maximalIdeal R) := ⟨⟨t, hmt⟩⟩
  have hdvr : IsDiscreteValuationRing R :=
    ((IsDiscreteValuationRing.TFAE R hnfield).out 1 5).mpr hprinc
  haveI := hdvr

  have hbot := IsIntegrallyClosed.integralClosure_eq_bot R (FractionRing R)
  have hrange : LinearMap.range
      (Algebra.linearMap R ↥(integralClosure R (FractionRing R))) = ⊤ := by
    rw [eq_top_iff]
    rintro z -
    have hz : (z : FractionRing R) ∈ (⊥ : Subalgebra R (FractionRing R)) := by
      rw [← hbot]; exact z.2
    obtain ⟨r, hr⟩ := Algebra.mem_bot.mp hz
    exact ⟨r, Subtype.ext hr⟩
  unfold wcpaDjLkDelta
  rw [hrange]
  exact Module.length_eq_zero

theorem wcpa_dj_lr1k_ndmf_node_levels_delta : ∀ (R k : Type u) [CommRing R] [IsLocalRing R]
    [IsNoetherianRing R] [Field k]
    (θ : ∀ n : ℕ, (R ⧸ IsLocalRing.maximalIdeal R ^ n) ≃+*
      (MvPolynomial (Fin 2) k ⧸ (Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 :
          MvPolynomial (Fin 2) k)} ⊔
        Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 2) k), MvPolynomial.X 1} ^ n))),
    (∀ (n : ℕ) (x : R) (y : MvPolynomial (Fin 2) k),
      θ (n + 1) (Ideal.Quotient.mk _ x) = Ideal.Quotient.mk _ y →
        θ n (Ideal.Quotient.mk _ x) = Ideal.Quotient.mk _ y) →
    _root_.IsReduced R → ringKrullDim R ≤ ((1 : ℕ) : WithBot ℕ∞) →
    Module.Finite R ↥(integralClosure R (FractionRing R)) →
    wcpaDjLkDelta R = 1 ∧ wcpaDjLkBranches R = 2 :=
by
  intro R k _ _ _ _ θ _ hred hdim _
  classical
  set m := IsLocalRing.maximalIdeal R with hm
  set ι := algebraMap R (FractionRing R) with hι
  have hprime : m.IsPrime := (IsLocalRing.maximalIdeal.isMaximal R).isPrime



  have s1 : ∃ x y : R, x ∈ m ∧ y ∈ m ∧ m = Ideal.span {x, y} ∧ x * y ∈ m ^ 3 ∧
      ∀ r : R, (1 - r) * x ≠ r * y := by
    set φ := θ 3 with hφ
    set S := Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 2) k), MvPolynomial.X 1} with hS
    set 𝔟 := Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin 2) k)} ⊔ S ^ 3
      with h𝔟
    have hcX : ∀ i : Fin 2,
        MvPolynomial.constantCoeff (MvPolynomial.X i : MvPolynomial (Fin 2) k) = 0 :=
      fun i => by simp
    obtain ⟨L, hL⟩ : ∃ L : Fin 2 → MvPolynomial (Fin 2) k → k,
        ∀ i p, L i p = MvPolynomial.constantCoeff (MvPolynomial.pderiv i p) :=
      ⟨_, fun _ _ => rfl⟩
    have hLmul : ∀ i p q, L i (p * q) =
        L i p * MvPolynomial.constantCoeff q + MvPolynomial.constantCoeff p * L i q := by
      intro i p q
      simp only [hL, MvPolynomial.pderiv_mul, map_add, map_mul]
    have hLadd : ∀ i p q, L i (p + q) = L i p + L i q := by
      intro i p q; simp only [hL, map_add]
    have hLsub : ∀ i p q, L i (p - q) = L i p - L i q := by
      intro i p q; simp only [hL, map_sub]
    have hL00 : L 0 (MvPolynomial.X 0) = 1 := by
      rw [hL, MvPolynomial.pderiv_X]; simp
    have hL01 : L 0 (MvPolynomial.X 1) = 0 := by
      rw [hL, MvPolynomial.pderiv_X]; simp
    have hL10 : L 1 (MvPolynomial.X 0) = 0 := by
      rw [hL, MvPolynomial.pderiv_X]; simp
    have hL11 : L 1 (MvPolynomial.X 1) = 1 := by
      rw [hL, MvPolynomial.pderiv_X]; simp
    let J : Ideal (MvPolynomial (Fin 2) k) :=
      { carrier := {p | MvPolynomial.constantCoeff p = 0 ∧ L 0 p = 0 ∧ L 1 p = 0}
        add_mem' := by
          rintro a b ⟨ha1, ha2, ha3⟩ ⟨hb1, hb2, hb3⟩
          exact ⟨by rw [map_add, ha1, hb1, add_zero], by rw [hLadd, ha2, hb2, add_zero],
            by rw [hLadd, ha3, hb3, add_zero]⟩
        zero_mem' := by
          refine ⟨map_zero _, ?_, ?_⟩ <;> simp [hL]
        smul_mem' := by
          rintro r p ⟨h1, h2, h3⟩
          refine ⟨by rw [smul_eq_mul, map_mul, h1, mul_zero], ?_, ?_⟩
          · rw [smul_eq_mul, hLmul, h1, h2]; ring
          · rw [smul_eq_mul, hLmul, h1, h3]; ring }
    have hJ : ∀ p, p ∈ J ↔ (MvPolynomial.constantCoeff p = 0 ∧ L 0 p = 0 ∧ L 1 p = 0) :=
      fun p => Iff.rfl
    have hprod : ∀ a b : MvPolynomial (Fin 2) k, MvPolynomial.constantCoeff a = 0 →
        MvPolynomial.constantCoeff b = 0 → a * b ∈ J := by
      intro a b ha hb
      rw [hJ, hLmul, hLmul, map_mul, ha, hb]
      refine ⟨by ring, by ring, by ring⟩
    have hSc : ∀ p ∈ S, MvPolynomial.constantCoeff p = 0 := by
