  refine ⟨inferInstance, ?_⟩
  haveI hloc : IsZariskiLocalAtSource @LocallyOfFiniteType :=
    HasRingHomProperty.instIsZariskiLocalAtSource
  refine (IsZariskiLocalAtSource.iff_of_openCover (P := @LocallyOfFiniteType)
    (φ ≫ ι).normalizationOpenCover).mpr ?_
  intro (U : X.affineOpens)
  have e : (φ ≫ ι).normalizationOpenCover.f U ≫ (φ ≫ ι).fromNormalization = _ :=
