theorem wc_et_module_push_stalk_vanish_of_milnor_deg : ∀ (A : Type u) [CommRing A] (Y : Scheme.{u}) (f : Y ⟶ Spec (.of A)) (m : ℕ), 0 < m → ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (z : Spec (.of Ω) ⟶ Spec (.of A)) (D : wcEtPullData (Limits.pullback.fst f z) m) (I : InjectiveResolution (SheafOfModules.unit (wcEtZModRing (Limits.pullback f z) m))) (x : Y) (q : ℕ), (∀ (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt Y x)) (Scheme.Etale.forget Y)) (φ : ∀ l, Spec (.of B) ⟶ (W'.obj l).right.left) (a : Spec (.of B) ⟶ Y), wcHalShData x B Λ W' φ a → Subsingleton (wcEtCoh (Limits.pullback (a ≫ f) z) m q)) → letI : (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange (Limits.pullback.fst f z)) _ _ D.cont D.φ).Additive := @Adjunction.right_adjoint_additive _ _ _ _ _ _ _ _ D.adj D.additive; Subsingleton ((wcEtStalk Y x).obj ((SheafOfModules.toSheaf (wcEtZModRing Y m)).obj ((((@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange (Limits.pullback.fst f z)) _ _ D.cont D.φ).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q))) :=
by
  classical


  have L3 : ∀ {T Q : Scheme.{u}} (r : Q ⟶ T) (ℓ : ℕ), 0 < ℓ → ∀ (D : wcEtPullData r ℓ) (I : InjectiveResolution (SheafOfModules.unit (wcEtZModRing Q ℓ))) (J : InjectiveResolution ((constantSheaf (Scheme.smallEtaleTopology Q) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))))) (n : ℕ), letI : (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange r) _ _ D.cont D.φ).Additive := @Adjunction.right_adjoint_additive _ _ _ _ _ _ _ _ D.adj D.additive; Nonempty ((SheafOfModules.toSheaf (wcEtZModRing T ℓ)).obj ((((@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange r) _ _ D.cont D.φ).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology n) ≅ (((wcEtPush r).mapHomologicalComplex (ComplexShape.up ℕ)).obj J.cocomplex).homology n) := by
    intro T Q r ℓ hn D I J n
