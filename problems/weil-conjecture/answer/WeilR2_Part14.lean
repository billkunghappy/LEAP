  have hP : ((m : ℕ) : ℤ) • 𝟙 F.obj = 0 := by
    have h2 := congrArg (fun φ => (sheafToPresheaf (Scheme.smallEtaleTopology B)
      AddCommGrpCat.{u+1}).map φ) hT
    simp only [CategoryTheory.Functor.map_zsmul, CategoryTheory.Functor.map_id,
      CategoryTheory.Functor.map_zero] at h2
    exact h2
  have hS : ((m : ℕ) : ℤ) • 𝟙 (Limits.colimit ((StructuredArrow.proj (Over.mk (wcEtGeomPt B b))
      (Scheme.Etale.forget B)).op ⋙ F.obj)) = 0 := by
    apply Limits.colimit.hom_ext
    intro j
    rw [Preadditive.comp_zsmul, Category.comp_id, Limits.comp_zero]
    have h1 : ((m : ℕ) : ℤ) • 𝟙 (F.obj.obj (Opposite.op j.unop.right)) = 0 := by
      have h3 := congrArg (fun φ => NatTrans.app φ (Opposite.op j.unop.right)) hP
      simpa using h3
    have h5 : ((m : ℕ) : ℤ) • 𝟙 (((StructuredArrow.proj (Over.mk (wcEtGeomPt B b))
        (Scheme.Etale.forget B)).op ⋙ F.obj).obj j) = 0 := h1
    rw [← Category.id_comp (Limits.colimit.ι _ j), ← Preadditive.zsmul_comp, h5, Limits.zero_comp]
  intro z
  have hz := congrArg (fun φ => AddCommGrpCat.Hom.hom φ z) hS
  simp only [AddCommGrpCat.hom_zsmul, AddCommGrpCat.hom_id, AddCommGrpCat.hom_zero,
    AddMonoidHom.zsmul_apply, AddMonoidHom.id_apply, AddMonoidHom.zero_apply] at hz
  rw [← natCast_zsmul]
  first
    | exact hz
    | simpa using hz
    | (rw [AddCommGrpCat.id_apply] at hz; exact hz)

theorem wc_finite_ell_torsion_pi_zmod : ∀ (G : Type v) [AddCommGroup G] [Finite G] (ℓ k : ℕ), ℓ.Prime → (∀ z : G, (ℓ ^ k) • z = 0) → ∃ (b : ℕ) (e : Fin b → ℕ), Nonempty (G ≃+ ((i : Fin b) → ZMod (ℓ ^ e i))) :=
by
  intro G _ _ ℓ k hℓ htor
  haveI : Module.Finite ℤ G := Module.Finite.of_finite
  have hp : Irreducible (ℓ : ℤ) := (Nat.prime_iff_prime_int.mp hℓ).irreducible
  have htor' : Module.IsTorsion' G (Submonoid.powers (ℓ : ℤ)) := by
    intro x
    refine ⟨⟨(ℓ : ℤ) ^ k, k, rfl⟩, ?_⟩
    show ((ℓ : ℤ) ^ k) • x = 0
    have h1 : ((ℓ : ℤ) ^ k) = ((ℓ ^ k : ℕ) : ℤ) := (Nat.cast_pow ℓ k).symm
    rw [h1, natCast_zsmul]
    exact htor x
  obtain ⟨d, k', ⟨φ⟩⟩ := Module.torsion_by_prime_power_decomposition hp htor'
  let ψ := DirectSum.linearEquivFunOnFintype ℤ (Fin d)
    (fun i => ℤ ⧸ Submodule.span ℤ {(ℓ : ℤ) ^ k' i})
  have hi : ∀ i : Fin d, Submodule.span ℤ {(ℓ : ℤ) ^ k' i} =
      Ideal.span {((ℓ ^ k' i : ℕ) : ℤ)} := by
    intro i
    rw [Nat.cast_pow]
    try rfl
  let χ : ∀ i : Fin d, (ℤ ⧸ Submodule.span ℤ {(ℓ : ℤ) ^ k' i}) ≃+ ZMod (ℓ ^ k' i) := fun i =>
    (Submodule.quotEquivOfEq _ _ (hi i)).toAddEquiv.trans
      (Int.quotientSpanNatEquivZMod (ℓ ^ k' i)).toAddEquiv
  exact ⟨d, k', ⟨φ.toAddEquiv.trans (ψ.toAddEquiv.trans (AddEquiv.piCongrRight χ))⟩⟩

theorem wc_et_stalk_hom_realize : ∀ (B : Scheme.{u}) (F : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}) (x : B), IsCofiltered (StructuredArrow (Over.mk (wcEtGeomPt B x)) (Scheme.Etale.forget B)) → ∀ (b : ℕ) (n : Fin b → ℕ) (α : ((i : Fin b) → ZMod (n i)) →+ (wcEtStalk B x).obj F), ∃ (V : B.Etale) (t : Spec (.of (AlgebraicClosure (B.residueField x))) ⟶ V.left) (ht : t ≫ V.hom = wcEtGeomPt B x) (h : ((i : Fin b) → ZMod (n i)) →+ F.obj.obj (Opposite.op V)), ∀ a, (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt B x)) (Scheme.Etale.forget B)).op ⋙ F.obj) (Opposite.op (StructuredArrow.mk (Over.homMk t ht : Over.mk (wcEtGeomPt B x) ⟶ (Scheme.Etale.forget B).obj V)))).hom (h a) = α a :=
by
  intro B F x hcof b n α
  classical
  haveI := hcof
  haveI : IsFiltered (StructuredArrow (Over.mk (wcEtGeomPt B x)) (Scheme.Etale.forget B))ᵒᵖ :=
    isFiltered_op_of_isCofiltered _
  haveI := Limits.preservesFilteredColimitsOfSize_shrink.{u+1, u+1, u, u+1} (forget AddCommGrpCat.{u+1})
  set Φ := (StructuredArrow.proj (Over.mk (wcEtGeomPt B x)) (Scheme.Etale.forget B)).op ⋙ F.obj
    with hΦ

  have hw : ∀ {j j' : (StructuredArrow (Over.mk (wcEtGeomPt B x)) (Scheme.Etale.forget B))ᵒᵖ}
      (f : j ⟶ j') (v : Φ.obj j),
      (Limits.colimit.ι Φ j').hom ((Φ.map f).hom v) = (Limits.colimit.ι Φ j).hom v := by
    intro j j' f v
    show (Φ.map f ≫ Limits.colimit.ι Φ j').hom v = _
    rw [Limits.colimit.w]

  have hz : ∀ i, n i • α (Pi.single i 1) = 0 := by
    intro i
    have h1 : n i • (Pi.single i (1 : ZMod (n i)) : (j : Fin b) → ZMod (n j)) = 0 := by
      ext j
      by_cases hj : j = i
      · subst hj
        simp
      · simp [Pi.single_eq_of_ne hj]
    rw [← map_nsmul, h1, map_zero]

  have hrep : ∀ i, ∃ (k : (StructuredArrow (Over.mk (wcEtGeomPt B x)) (Scheme.Etale.forget B))ᵒᵖ)
      (y : Φ.obj k), n i • y = 0 ∧ (Limits.colimit.ι Φ k).hom y = α (Pi.single i 1) := by
    intro i
    obtain ⟨j, y, hy⟩ := Limits.Concrete.colimit_exists_rep Φ (α (Pi.single i 1))
    have hy' : (Limits.colimit.ι Φ j).hom y = α (Pi.single i 1) := hy
    have h2 : (Limits.colimit.ι Φ j).hom (n i • y) = (Limits.colimit.ι Φ j).hom 0 := by
      rw [map_nsmul, hy', map_zero, hz i]
    obtain ⟨k, f, g, hk⟩ :=
      (Limits.Concrete.colimit_rep_eq_iff_exists Φ (i := j) (j := j) (n i • y) 0).mp h2
    have hk' : (Φ.map f).hom (n i • y) = (Φ.map g).hom 0 := hk
    refine ⟨k, (Φ.map f).hom y, ?_, ?_⟩
    · rw [← map_nsmul, hk', map_zero]
    · rw [hw, hy']
  choose k y hy0 hyz using hrep

  obtain ⟨K, hK⟩ := IsFiltered.sup_objs_exists (Finset.univ.image k)
  have c : ∀ i, k i ⟶ Opposite.op K.unop := fun i =>
    (hK (Finset.mem_image_of_mem k (Finset.mem_univ i))).some

  have hψw : (Over.homMk K.unop.hom.left (Over.w K.unop.hom) :
      Over.mk (wcEtGeomPt B x) ⟶ (Scheme.Etale.forget B).obj K.unop.right) ≫
      (Scheme.Etale.forget B).map (𝟙 K.unop.right) = K.unop.hom := by
    rw [CategoryTheory.Functor.map_id, Category.comp_id]
    apply Over.OverMorphism.ext
    first
      | rfl
      | simp
  have ψ : StructuredArrow.mk (Over.homMk K.unop.hom.left (Over.w K.unop.hom) :
      Over.mk (wcEtGeomPt B x) ⟶ (Scheme.Etale.forget B).obj K.unop.right) ⟶ K.unop :=
    StructuredArrow.homMk (𝟙 K.unop.right) hψw
  obtain ⟨r, hr0, hgerm⟩ : ∃ r : Fin b → F.obj.obj (Opposite.op K.unop.right),
      (∀ i, n i • r i = 0) ∧ ∀ i, (Limits.colimit.ι Φ (Opposite.op (StructuredArrow.mk
        (Over.homMk K.unop.hom.left (Over.w K.unop.hom) :
          Over.mk (wcEtGeomPt B x) ⟶ (Scheme.Etale.forget B).obj K.unop.right)))).hom (r i) =
        α (Pi.single i 1) := by
    refine ⟨fun i => (Φ.map ψ.op).hom ((Φ.map (c i)).hom (y i)), fun i => ?_, fun i => ?_⟩
    · show n i • (Φ.map ψ.op).hom ((Φ.map (c i)).hom (y i)) = 0
      rw [← map_nsmul, ← map_nsmul, hy0 i, map_zero, map_zero]
    · show (Limits.colimit.ι Φ _).hom ((Φ.map ψ.op).hom ((Φ.map (c i)).hom (y i))) = _
      rw [hw, hw, hyz i]

  have hlift : ∀ i, ∃ hi : ZMod (n i) →+ F.obj.obj (Opposite.op K.unop.right),
      ∀ m : ℤ, hi (m : ZMod (n i)) = m • r i := by
    intro i
    refine ⟨ZMod.lift (n i) ⟨zmultiplesHom _ (r i), ?_⟩, fun m => ?_⟩
    · rw [zmultiplesHom_apply, natCast_zsmul, hr0 i]
    · rw [ZMod.lift_coe]
      first
        | rfl
        | simp [zmultiplesHom_apply]
  choose hh hhm using hlift
  let h : ((i : Fin b) → ZMod (n i)) →+ F.obj.obj (Opposite.op K.unop.right) :=
    ∑ i, (hh i).comp (Pi.evalAddMonoidHom (fun i => ZMod (n i)) i)
  have hsingle : ∀ i (c : ZMod (n i)), h (Pi.single i c) = hh i c := by
    intro i c
    show (∑ j, (hh j).comp (Pi.evalAddMonoidHom (fun i => ZMod (n i)) j)) (Pi.single i c) = hh i c
    rw [AddMonoidHom.finsetSum_apply, Finset.sum_eq_single i]
    · show hh i ((Pi.single i c : (j : Fin b) → ZMod (n j)) i) = hh i c
      rw [Pi.single_eq_same]
    · intro j _ hj
      show hh j ((Pi.single i c : (j : Fin b) → ZMod (n j)) j) = 0
      rw [Pi.single_eq_of_ne hj, map_zero]
    · intro hi
      exact absurd (Finset.mem_univ i) hi
  have key : (Limits.colimit.ι Φ (Opposite.op (StructuredArrow.mk
        (Over.homMk K.unop.hom.left (Over.w K.unop.hom) :
          Over.mk (wcEtGeomPt B x) ⟶ (Scheme.Etale.forget B).obj K.unop.right)))).hom.comp h =
      α := by
    apply AddMonoidHom.functions_ext
    intro i c
    obtain ⟨m, rfl⟩ := ZMod.intCast_surjective c
    have e : (Pi.single i ((m : ℤ) : ZMod (n i)) : (j : Fin b) → ZMod (n j)) =
        m • Pi.single i 1 := by
      ext j
      by_cases hj : j = i
      · subst hj
        simp
      · simp [Pi.single_eq_of_ne hj]
    rw [AddMonoidHom.comp_apply, hsingle, hhm, map_zsmul, hgerm i, e, map_zsmul]
  exact ⟨K.unop.right, K.unop.hom.left, Over.w K.unop.hom, h, fun a => DFunLike.congr_fun key a⟩

theorem wc_et_irreducible_nbhd_shrink : ∀ (B : Scheme.{u}) (F : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}) (W : B.Opens) (y : B) (V₀ : B.Etale) (t₀ : Spec (.of (AlgebraicClosure (B.residueField y))) ⟶ V₀.left) (ht₀ : t₀ ≫ V₀.hom = wcEtGeomPt B y), (∀ (V : B.Etale) (v : V.left), ∃ N : V.left.Opens, v ∈ N ∧ IsIrreducible (N : Set V.left)) → y ∈ W → ∃ (U : B.Etale) (c : U ⟶ V₀) (t₁ : Spec (.of (AlgebraicClosure (B.residueField y))) ⟶ U.left) (ht₁ : t₁ ≫ U.hom = wcEtGeomPt B y), IrreducibleSpace U.left ∧ (∀ w : U.left, U.hom w ∈ W) ∧ ∀ s : F.obj.obj (Opposite.op V₀), (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt B y)) (Scheme.Etale.forget B)).op ⋙ F.obj) (Opposite.op (StructuredArrow.mk (Over.homMk t₁ ht₁ : Over.mk (wcEtGeomPt B y) ⟶ (Scheme.Etale.forget B).obj U)))).hom ((F.obj.map c.op).hom s) = (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt B y)) (Scheme.Etale.forget B)).op ⋙ F.obj) (Opposite.op (StructuredArrow.mk (Over.homMk t₀ ht₀ : Over.mk (wcEtGeomPt B y) ⟶ (Scheme.Etale.forget B).obj V₀)))).hom s :=
by
  intro B F W y V₀ t₀ ht₀ H hy
  haveI : Etale V₀.hom := V₀.prop
  have hgp : (wcEtGeomPt B y) (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField y))) = y :=
    (Scheme.Hom.comp_apply _ _ _).trans (Scheme.fromSpecResidueField_apply _ _)
  have hv : V₀.hom (t₀ (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField y)))) = y :=
    (Scheme.Hom.comp_apply t₀ V₀.hom _).symm.trans
      ((congrArg (fun f : Spec (.of (AlgebraicClosure (B.residueField y))) ⟶ B =>
        f (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField y)))) ht₀).trans hgp)
  obtain ⟨N, hvN, hN⟩ := H V₀ (t₀ (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField y))))
  obtain ⟨O, hO1⟩ : ∃ O : V₀.left.Opens, O = N ⊓ V₀.hom ⁻¹ᵁ W := ⟨_, rfl⟩
  have hON : O ≤ N := hO1 ▸ inf_le_left
  have hOW : O ≤ V₀.hom ⁻¹ᵁ W := hO1 ▸ inf_le_right
  have hvO : t₀ (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField y))) ∈ O := by
    rw [hO1]
    refine ⟨hvN, ?_⟩
    show V₀.hom _ ∈ W
    rw [hv]
    exact hy
  have hO : IsIrreducible (O : Set V₀.left) :=
    ⟨⟨_, hvO⟩, hN.isPreirreducible.open_subset O.isOpen hON⟩
  have hrO : Set.range O.ι = (O : Set V₀.left) := Scheme.Opens.range_ι O
  have hsub : Set.range t₀ ⊆ Set.range O.ι := by
    rintro _ ⟨q, rfl⟩
    rw [hrO, Subsingleton.elim q (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField y)))]
    exact hvO
  obtain ⟨t₁, hfac⟩ : ∃ t₁ : Spec (.of (AlgebraicClosure (B.residueField y))) ⟶ O.toScheme,
      t₁ ≫ O.ι = t₀ := ⟨_, IsOpenImmersion.lift_fac _ _ hsub⟩
  have ht₁ : t₁ ≫ (Scheme.Etale.mk (O.ι ≫ V₀.hom)).hom = wcEtGeomPt B y :=
    (Category.assoc _ _ _).symm.trans ((congrArg (fun k => k ≫ V₀.hom) hfac).trans ht₀)
  let c : Scheme.Etale.mk (O.ι ≫ V₀.hom) ⟶ V₀ :=
    MorphismProperty.Over.homMk (A := Scheme.Etale.mk (O.ι ≫ V₀.hom)) (B := V₀) O.ι rfl trivial
  refine ⟨Scheme.Etale.mk (O.ι ≫ V₀.hom), c, t₁, ht₁, ?_, ?_, ?_⟩
  · show IrreducibleSpace O.toScheme
    exact Subtype.irreducibleSpace hO
  · intro w
    have hmem : O.ι w ∈ O := by
      rw [← SetLike.mem_coe, ← hrO]
      exact ⟨w, rfl⟩
    have hm2 : V₀.hom (O.ι w) ∈ W := hOW hmem
    have e : (O.ι ≫ V₀.hom) w = V₀.hom (O.ι w) := Scheme.Hom.comp_apply _ _ _
    have h3 : (O.ι ≫ V₀.hom) w ∈ W := by rw [e]; exact hm2
    exact h3
  · intro s
    let φ : StructuredArrow.mk (Over.homMk t₁ ht₁ :
          Over.mk (wcEtGeomPt B y) ⟶ (Scheme.Etale.forget B).obj (Scheme.Etale.mk (O.ι ≫ V₀.hom))) ⟶
        StructuredArrow.mk (Over.homMk t₀ ht₀ :
          Over.mk (wcEtGeomPt B y) ⟶ (Scheme.Etale.forget B).obj V₀) :=
      StructuredArrow.homMk c (by ext; exact hfac)
    exact Limits.colimit.w_apply ((StructuredArrow.proj (Over.mk (wcEtGeomPt B y))
      (Scheme.Etale.forget B)).op ⋙ F.obj) φ.op s

theorem wc_et_irreducible_etale_generic_specializes : ∀ (B : Scheme.{u}) (U : B.Etale) (η : B), (∀ z : B, η ⤳ z) → IrreducibleSpace U.left → ∀ u' : U.left, U.hom u' = η → ∀ w : U.left, u' ⤳ w :=
by
  intro B U η hη hirr u' hu' w
  have hiso : ∀ {V B : Scheme.{u}} (φ : V ⟶ B) [Etale φ] (v : V),
      ∃ U : V.Opens, v ∈ U ∧ ∀ w ∈ U, φ w = φ v → w = v := by
    intro V B φ _ v
    haveI hlqf : LocallyQuasiFinite φ := by
      rw [HasRingHomProperty.iff_appLE (P := @LocallyQuasiFinite)]
      intro U W e
      have h := HasRingHomProperty.appLE @Etale φ ‹Etale φ› U W e
      letI := (φ.appLE U W e).hom.toAlgebra
      haveI : Algebra.Etale _ _ := RingHom.Etale.toAlgebra h
      exact RingHom.quasiFinite_algebraMap.mpr inferInstance
    haveI hd : DiscreteTopology ↑(φ ⁻¹' {φ v}) := (φ.fiberHomeo (φ v)).discreteTopology
    have hv : φ v ∈ ({φ v} : Set B) := Set.mem_singleton _
    have hopen : IsOpen ({⟨v, hv⟩} : Set ↑(φ ⁻¹' {φ v})) := isOpen_discrete _
    obtain ⟨t, ht, hteq⟩ := isOpen_induced_iff.mp hopen
    refine ⟨⟨t, ht⟩, ?_, ?_⟩
    · have : (⟨v, hv⟩ : ↑(φ ⁻¹' {φ v})) ∈ Subtype.val ⁻¹' t := by
        rw [hteq]; exact Set.mem_singleton _
      exact this
    · intro w hwU hw
      have hw' : w ∈ φ ⁻¹' {φ v} := by
        simp only [Set.mem_preimage, Set.mem_singleton_iff]; exact hw
      have : (⟨w, hw'⟩ : ↑(φ ⁻¹' {φ v})) ∈ Subtype.val ⁻¹' t := hwU
      rw [hteq, Set.mem_singleton_iff] at this
      exact congrArg Subtype.val this
  have hζ : ∀ v : U.left, genericPoint U.left ⤳ v :=
    fun v => (genericPoint_spec U.left).specializes (Set.mem_univ v)
  have h1 : U.hom (genericPoint U.left) ⤳ η := by
    rw [← hu']
    exact (hζ u').map U.hom.continuous
  have h2 : U.hom (genericPoint U.left) = η := (h1.antisymm (hη _)).eq
  haveI : Etale U.hom := U.prop
  obtain ⟨O, hu'O, hinj⟩ := hiso U.hom u'
  have hζO : genericPoint U.left ∈ O := (hζ u').mem_open O.isOpen hu'O
  have h3 : genericPoint U.left = u' := hinj _ hζO (h2.trans hu'.symm)
  rw [← h3]
  exact hζ w

theorem wc_et_germ_bij_propagate : ∀ (B : Scheme.{u}) (F : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}) (η y : B) (U : B.Etale) (M : Type v) [AddCommGroup M] [Finite M] (h : M →+ F.obj.obj (Opposite.op U)) (t₁ : Spec (.of (AlgebraicClosure (B.residueField y))) ⟶ U.left) (ht₁ : t₁ ≫ U.hom = wcEtGeomPt B y), (∀ b : B, IsCofiltered (StructuredArrow (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B))) → (∀ u' : U.left, U.hom u' = η → ∀ w : U.left, u' ⤳ w) → Function.Bijective (fun a : M => (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt B y)) (Scheme.Etale.forget B)).op ⋙ F.obj) (Opposite.op (StructuredArrow.mk (Over.homMk t₁ ht₁ : Over.mk (wcEtGeomPt B y) ⟶ (Scheme.Etale.forget B).obj U)))).hom (h a)) → (∀ x : B, (∃ w : U.left, U.hom w = x) → ∃ sp : (wcEtStalk B x).obj F ≃+ (wcEtStalk B η).obj F, ∀ (V : B.Etale) (t : Spec (.of (AlgebraicClosure (B.residueField x))) ⟶ V.left) (ht : t ≫ V.hom = wcEtGeomPt B x), ∃ (τ : Spec (.of (AlgebraicClosure (B.residueField η))) ⟶ V.left) (hτ : τ ≫ V.hom = wcEtGeomPt B η), ∀ s : F.obj.obj (Opposite.op V), sp ((Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt B x)) (Scheme.Etale.forget B)).op ⋙ F.obj) (Opposite.op (StructuredArrow.mk (Over.homMk t ht : Over.mk (wcEtGeomPt B x) ⟶ (Scheme.Etale.forget B).obj V)))).hom s) = (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt B η)) (Scheme.Etale.forget B)).op ⋙ F.obj) (Opposite.op (StructuredArrow.mk (Over.homMk τ hτ : Over.mk (wcEtGeomPt B η) ⟶ (Scheme.Etale.forget B).obj V)))).hom s) → ∀ (x : B) (t : Spec (.of (AlgebraicClosure (B.residueField x))) ⟶ U.left) (ht : t ≫ U.hom = wcEtGeomPt B x), Function.Bijective (fun a : M => (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt B x)) (Scheme.Etale.forget B)).op ⋙ F.obj) (Opposite.op (StructuredArrow.mk (Over.homMk t ht : Over.mk (wcEtGeomPt B x) ⟶ (Scheme.Etale.forget B).obj U)))).hom (h a)) :=
by
  intro B F η y U M _ _ h t₁ ht₁ hcof hspec hbij hcosp x t ht

  have hpt : ∀ (V : B.Etale) (b : B)
      (t : Spec (.of (AlgebraicClosure (B.residueField b))) ⟶ V.left),
      t ≫ V.hom = wcEtGeomPt B b →
      V.hom (t (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField b)))) = b := by
    intro V b t ht
    show (t ≫ V.hom) _ = b
    rw [ht]
    show (B.fromSpecResidueField b)
      ((Spec.map (CommRingCat.ofHom (algebraMap (B.residueField b)
        (AlgebraicClosure (B.residueField b)))))
        (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField b)))) = b
    first
      | exact Scheme.fromSpecResidueField_apply _ _
      | simp [Scheme.fromSpecResidueField_apply]

  have s1 : ∀ {Sx Sy Se : Type (u+1)} [AddCommGroup Sx] [AddCommGroup Sy] [AddCommGroup Se]
      (φx : M →+ Sx) (φy : M →+ Sy) (spx : Sx ≃+ Se) (spy : Sy ≃+ Se),
      Function.Bijective φy → (∀ a : M, spx (φx a) = 0 → spy (φy a) = 0) →
      Function.Bijective φx := by
    intro Sx Sy Se _ _ _ φx φy spx spy hφy hker
    have hinj : Function.Injective φx := by
      rw [injective_iff_map_eq_zero]
      intro a ha
      have h1 : spy (φy a) = 0 := hker a (by rw [ha, map_zero])
      have h2 : φy a = 0 := by
        have := congrArg spy.symm h1
        simpa using this
      exact hφy.1 (h2.trans (map_zero φy).symm)
    let e : Sx ≃ M :=
      ((spx.toEquiv).trans spy.toEquiv.symm).trans (Equiv.ofBijective φy hφy).symm
    haveI : Finite Sx := Finite.of_equiv M e.symm
    exact hinj.bijective_of_nat_card_le (Nat.card_congr e).le

  obtain ⟨spx, Cx⟩ := hcosp x ⟨_, hpt U x t ht⟩
  obtain ⟨spy, Cy⟩ := hcosp y ⟨_, hpt U y t₁ ht₁⟩
  obtain ⟨τx, hτx, Cx'⟩ := Cx U t ht
  obtain ⟨τy, hτy, Cy'⟩ := Cy U t₁ ht₁
  have hsp := hspec _ (hpt U η τy hτy)
    (τx (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField η))))
  have hlift : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] {V U : Scheme.{u}} (g : V ⟶ U) [Etale g]
      (s : Spec (.of Ω) ⟶ U) (v : V), g v = s (IsLocalRing.closedPoint Ω) →
      ∃ t : Spec (.of Ω) ⟶ V, t ≫ g = s ∧ t (IsLocalRing.closedPoint Ω) = v := by
    intro Ω _ _ V U g _ s v hv
    exact wc_etale_lift_alg_closed_point Ω g s v hv
  have KT := fun s => (wc_et_germ_transfer_specialize B F hcof hlift U η η τy hτy τx hτx hsp s).1
  exact s1 (((Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt B x))
      (Scheme.Etale.forget B)).op ⋙ F.obj) (Opposite.op (StructuredArrow.mk
      (Over.homMk t ht : Over.mk (wcEtGeomPt B x) ⟶ (Scheme.Etale.forget B).obj U)))).hom).comp h)
    (((Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt B y))
      (Scheme.Etale.forget B)).op ⋙ F.obj) (Opposite.op (StructuredArrow.mk
      (Over.homMk t₁ ht₁ : Over.mk (wcEtGeomPt B y) ⟶ (Scheme.Etale.forget B).obj U)))).hom).comp h)
    spx spy hbij (fun a ha => (Cy' (h a)).trans (KT (h a) ((Cx' (h a)).symm.trans ha)))

theorem wc_et_const_over_iso_of_germ_bij : ∀ (B : Scheme.{u}) (F : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}) (U : B.Etale) (M : AddCommGrpCat.{u+1}) (h : M →+ F.obj.obj (Opposite.op U)), (∀ b : B, IsCofiltered (StructuredArrow (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B))) → (∀ (x : B) (t : Spec (.of (AlgebraicClosure (B.residueField x))) ⟶ U.left) (ht : t ≫ U.hom = wcEtGeomPt B x), Function.Bijective (fun a : M => (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt B x)) (Scheme.Etale.forget B)).op ⋙ F.obj) (Opposite.op (StructuredArrow.mk (Over.homMk t ht : Over.mk (wcEtGeomPt B x) ⟶ (Scheme.Etale.forget B).obj U)))).hom (h a))) → Nonempty (((constantSheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}).obj M).over U ≅ F.over U) :=
by
  intro B F U M h hcof hbij
  classical

  have hmap : ∀ {A A' C : B.Etale} (f : A ⟶ A') (g : A' ⟶ C) (s : F.obj.obj (Opposite.op C)),
      (F.obj.map (f ≫ g).op).hom s = (F.obj.map f.op).hom ((F.obj.map g.op).hom s) := by
    intro A A' C f g s
    rw [op_comp, Functor.map_comp]
    rfl

  have hT : ∀ (x : B) (V V₂ : B.Etale) (c : V₂ ⟶ V)
      (t : Spec (.of (AlgebraicClosure (B.residueField x))) ⟶ V₂.left)
      (ht : t ≫ V₂.hom = wcEtGeomPt B x) (ht2 : (t ≫ c.left) ≫ V.hom = wcEtGeomPt B x)
      (s : F.obj.obj (Opposite.op V)),
      (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt B x))
        (Scheme.Etale.forget B)).op ⋙ F.obj) (Opposite.op (StructuredArrow.mk (Over.homMk t ht :
          Over.mk (wcEtGeomPt B x) ⟶ (Scheme.Etale.forget B).obj V₂)))).hom
        ((F.obj.map c.op).hom s) =
      (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt B x))
        (Scheme.Etale.forget B)).op ⋙ F.obj) (Opposite.op (StructuredArrow.mk
          (Over.homMk (t ≫ c.left) ht2 :
          Over.mk (wcEtGeomPt B x) ⟶ (Scheme.Etale.forget B).obj V)))).hom s := by
    intro x V V₂ c t ht ht2 s
    have hm : (Over.homMk t ht : Over.mk (wcEtGeomPt B x) ⟶ (Scheme.Etale.forget B).obj V₂) ≫
        (Scheme.Etale.forget B).map c =
        (Over.homMk (t ≫ c.left) ht2 :
          Over.mk (wcEtGeomPt B x) ⟶ (Scheme.Etale.forget B).obj V) := by
      apply Over.OverMorphism.ext <;> rfl
    let m : StructuredArrow.mk (Over.homMk t ht :
        Over.mk (wcEtGeomPt B x) ⟶ (Scheme.Etale.forget B).obj V₂) ⟶
        StructuredArrow.mk (Over.homMk (t ≫ c.left) ht2 :
          Over.mk (wcEtGeomPt B x) ⟶ (Scheme.Etale.forget B).obj V) := StructuredArrow.homMk c hm
    exact Limits.colimit.w_apply ((StructuredArrow.proj (Over.mk (wcEtGeomPt B x))
      (Scheme.Etale.forget B)).op ⋙ F.obj) m.op s

  have hgp : ∀ (x : B) (p : Spec (.of (AlgebraicClosure (B.residueField x)))),
      (wcEtGeomPt B x) p = x := by
    intro x p
    simp only [wcEtGeomPt, Scheme.Hom.comp_apply]
    exact Scheme.fromSpecResidueField_apply x _

  have hlift : ∀ (V : B.Etale) (v : V.left),
      ∃ t : Spec (.of (AlgebraicClosure (B.residueField (V.hom v)))) ⟶ V.left,
        t ≫ V.hom = wcEtGeomPt B (V.hom v) ∧
        t (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField (V.hom v)))) = v := by
    intro V v
    haveI : Etale V.hom := V.prop
    exact wc_etale_lift_alg_closed_point (AlgebraicClosure (B.residueField (V.hom v))) V.hom
      (wcEtGeomPt B (V.hom v)) v (hgp _ _).symm

  let ρ : (Over.forget U).op ⋙ (Functor.const (B.Etale)ᵒᵖ).obj M ⟶ (F.over U).obj :=
    { app := fun T => AddCommGrpCat.ofHom ((F.obj.map T.unop.hom.op).hom.comp h)
      naturality := by
        intro T T' g
        ext a
        change (F.obj.map T'.unop.hom.op).hom (h a) =
          (F.obj.map g.unop.left.op).hom ((F.obj.map T.unop.hom.op).hom (h a))
        rw [← hmap, Over.w g.unop] }

  have hρi : Presheaf.IsLocallyInjective ((Scheme.smallEtaleTopology B).over U) ρ := by
    apply Presheaf.IsLocallyInjective.mk
    intro T x y hxy
    have hxy' : (F.obj.map T.unop.hom.op).hom (h x) = (F.obj.map T.unop.hom.op).hom (h y) := hxy
    rw [GrothendieckTopology.mem_over_iff]
    apply wc_etale_jointly_surjective_covers
    intro v
    obtain ⟨t, ht, -⟩ := hlift T.unop.left v
    have ht2 : (t ≫ T.unop.hom.left) ≫ U.hom = wcEtGeomPt B (T.unop.left.hom v) := by
      rw [Category.assoc, MorphismProperty.Over.w T.unop.hom, ht]
    have e1 := hT _ _ _ T.unop.hom t ht ht2 (h x)
    have e2 := hT _ _ _ T.unop.hom t ht ht2 (h y)
    have e3 := congrArg (fun z => (Limits.colimit.ι ((StructuredArrow.proj
        (Over.mk (wcEtGeomPt B (T.unop.left.hom v))) (Scheme.Etale.forget B)).op ⋙ F.obj)
        (Opposite.op (StructuredArrow.mk (Over.homMk t ht :
          Over.mk (wcEtGeomPt B (T.unop.left.hom v)) ⟶
            (Scheme.Etale.forget B).obj T.unop.left)))).hom z) hxy'
    have hxyeq : x = y := (hbij _ _ ht2).1 (e1.symm.trans (e3.trans e2))
    subst hxyeq
    refine ⟨T.unop.left, 𝟙 _, ?_, ?_⟩
    · rw [Sieve.overEquiv_iff]
      exact rfl
    · first
        | exact ⟨v, rfl⟩
        | simp
        | exact ⟨v, Scheme.Hom.id_apply _ _⟩

  have hρs : Presheaf.IsLocallySurjective ((Scheme.smallEtaleTopology B).over U) ρ := by
    apply Presheaf.IsLocallySurjective.mk
    intro T s
    change ↑(F.obj.obj (Opposite.op T.left)) at s
    rw [GrothendieckTopology.mem_over_iff]
    apply wc_etale_jointly_surjective_covers
    intro v
    obtain ⟨t, ht, htv⟩ := hlift T.left v
    have ht2 : (t ≫ T.hom.left) ≫ U.hom = wcEtGeomPt B (T.left.hom v) := by
      rw [Category.assoc, MorphismProperty.Over.w T.hom, ht]
    obtain ⟨a, ha⟩ := (hbij _ _ ht2).2 ((Limits.colimit.ι ((StructuredArrow.proj
        (Over.mk (wcEtGeomPt B (T.left.hom v))) (Scheme.Etale.forget B)).op ⋙ F.obj)
        (Opposite.op (StructuredArrow.mk (Over.homMk t ht :
          Over.mk (wcEtGeomPt B (T.left.hom v)) ⟶
            (Scheme.Etale.forget B).obj T.left)))).hom s)
    have hg := (hT _ _ _ T.hom t ht ht2 (h a)).trans ha
    have hz : (Limits.colimit.ι ((StructuredArrow.proj
        (Over.mk (wcEtGeomPt B (T.left.hom v))) (Scheme.Etale.forget B)).op ⋙ F.obj)
        (Opposite.op (StructuredArrow.mk (Over.homMk t ht :
          Over.mk (wcEtGeomPt B (T.left.hom v)) ⟶
            (Scheme.Etale.forget B).obj T.left)))).hom ((F.obj.map T.hom.op).hom (h a) - s) =
        (Limits.colimit.ι ((StructuredArrow.proj
        (Over.mk (wcEtGeomPt B (T.left.hom v))) (Scheme.Etale.forget B)).op ⋙ F.obj)
        (Opposite.op (StructuredArrow.mk (Over.homMk t ht :
          Over.mk (wcEtGeomPt B (T.left.hom v)) ⟶
            (Scheme.Etale.forget B).obj T.left)))).hom 0 := by
      rw [map_sub, map_zero, hg, sub_self]
    obtain ⟨A'', g₁, g₂, hgg⟩ := (wc_et_stalk_germ_facts B (T.left.hom v) (hcof _) F).2.1
      (StructuredArrow.mk (Over.homMk t ht :
          Over.mk (wcEtGeomPt B (T.left.hom v)) ⟶ (Scheme.Etale.forget B).obj T.left))
      (StructuredArrow.mk (Over.homMk t ht :
          Over.mk (wcEtGeomPt B (T.left.hom v)) ⟶ (Scheme.Etale.forget B).obj T.left))
      ((F.obj.map T.hom.op).hom (h a) - s) 0 hz
    rw [map_zero, map_sub, sub_eq_zero] at hgg
    refine ⟨A''.right, g₁.right, ?_, ?_⟩
    · rw [Sieve.overEquiv_iff]
      first
        | refine ⟨a, ?_⟩
        | refine (Presheaf.imageSieve_apply _ _ _).2 ⟨a, ?_⟩
        | (show ∃ _, _ ; exact ⟨a, ?_⟩)
      change (F.obj.map (g₁.right ≫ T.hom).op).hom (h a) = (F.obj.map g₁.right.op).hom s
      rw [hmap]
      exact hgg
    · have hw' := congrArg (fun φ => φ.left) (StructuredArrow.w g₁)
      have hcomp : A''.hom.left ≫ g₁.right.left = t := hw'
      refine ⟨A''.hom.left (IsLocalRing.closedPoint (AlgebraicClosure
        (B.residueField (T.left.hom v)))), ?_⟩
      exact (Scheme.Hom.comp_apply A''.hom.left g₁.right.left _).symm.trans
        ((congrArg (fun g => g (IsLocalRing.closedPoint (AlgebraicClosure
          (B.residueField (T.left.hom v))))) hcomp).trans htv)

  have key : ∀ (P : (Over U)ᵒᵖ ⥤ AddCommGrpCat.{u+1})
      (Q : Sheaf ((Scheme.smallEtaleTopology B).over U) AddCommGrpCat.{u+1}) (f : P ⟶ Q.obj),
      Presheaf.IsLocallyInjective ((Scheme.smallEtaleTopology B).over U) f →
      Presheaf.IsLocallySurjective ((Scheme.smallEtaleTopology B).over U) f →
      ∃ Λ : (presheafToSheaf ((Scheme.smallEtaleTopology B).over U) AddCommGrpCat.{u+1}).obj P ⟶ Q,
        IsIso Λ := by
    intro P Q f hfi hfs
    haveI := hfi
    haveI := hfs
    have h1 : Presheaf.IsLocallySurjective ((Scheme.smallEtaleTopology B).over U)
        (sheafifyLift ((Scheme.smallEtaleTopology B).over U) f Q.property) :=
      Presheaf.isLocallySurjective_of_isLocallySurjective_fac ((Scheme.smallEtaleTopology B).over U)
        (toSheafify_sheafifyLift ((Scheme.smallEtaleTopology B).over U) f Q.property)
    haveI : Presheaf.IsLocallySurjective ((Scheme.smallEtaleTopology B).over U)
        (toSheafify ((Scheme.smallEtaleTopology B).over U) P) :=
      Presheaf.isLocallySurjective_toSheafify' _ P
    have h2 : Presheaf.IsLocallyInjective ((Scheme.smallEtaleTopology B).over U)
        (sheafifyLift ((Scheme.smallEtaleTopology B).over U) f Q.property) :=
      Presheaf.isLocallyInjective_of_isLocallyInjective_of_isLocallySurjective_fac
        ((Scheme.smallEtaleTopology B).over U) f
        (toSheafify_sheafifyLift ((Scheme.smallEtaleTopology B).over U) f Q.property)
    exact ⟨ObjectProperty.homMk (sheafifyLift ((Scheme.smallEtaleTopology B).over U) f Q.property),
      (Sheaf.isLocallyBijective_iff_isIso
        (ObjectProperty.homMk (sheafifyLift ((Scheme.smallEtaleTopology B).over U) f Q.property) :
          (presheafToSheaf ((Scheme.smallEtaleTopology B).over U) AddCommGrpCat.{u+1}).obj P ⟶ Q)).mp
        ⟨h2, h1⟩⟩

  let θ : (Over.forget U).op ⋙ (Functor.const (B.Etale)ᵒᵖ).obj M ⟶
      (((constantSheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}).obj M).over U).obj :=
    Functor.whiskerLeft (Over.forget U).op
      (toSheafify (Scheme.smallEtaleTopology B) ((Functor.const (B.Etale)ᵒᵖ).obj M))
  have hθs : Presheaf.IsLocallySurjective ((Scheme.smallEtaleTopology B).over U) θ :=
    @Presheaf.isLocallySurjective_whisker _ _ _ _ _ _ ((Scheme.smallEtaleTopology B).over U)
      (Scheme.smallEtaleTopology B)
      (Over.forget U) _ _ (toSheafify (Scheme.smallEtaleTopology B)
        ((Functor.const (B.Etale)ᵒᵖ).obj M)) _ _ _ _ inferInstance
      (Presheaf.isLocallySurjective_toSheafify' (Scheme.smallEtaleTopology B)
        ((Functor.const (B.Etale)ᵒᵖ).obj M))
  have hθi : Presheaf.IsLocallyInjective ((Scheme.smallEtaleTopology B).over U) θ :=
    @Presheaf.isLocallyInjective_whisker _ _ _ _ _ _ ((Scheme.smallEtaleTopology B).over U)
      (Scheme.smallEtaleTopology B)
      (Over.forget U) _ _ (toSheafify (Scheme.smallEtaleTopology B)
        ((Functor.const (B.Etale)ᵒᵖ).obj M)) _ _ _ _ inferInstance
      (Presheaf.isLocallyInjective_toSheafify' (Scheme.smallEtaleTopology B)
        ((Functor.const (B.Etale)ᵒᵖ).obj M))
  obtain ⟨Λθ, hΛθ⟩ := key _ _ θ hθi hθs
  obtain ⟨Λρ, hΛρ⟩ := key _ _ ρ hρi hρs
  exact ⟨(@asIso _ _ _ _ Λθ hΛθ).symm ≪≫ @asIso _ _ _ _ Λρ hΛρ⟩

theorem wc_et_P1_smooth_proper_Rq_locally_const : ∀ (K : Type u) [Field K] (X : Scheme.{u}) (g : X ⟶ (wcP1Over K).left) [IsProper g]
    (W : (wcP1Over K).left.Opens),
    (∀ x : X, g x ∈ W → ∃ U' : X.Opens, x ∈ U' ∧ Smooth (U'.ι ≫ g)) →
    ∀ (ℓ : ℕ), ℓ.Prime → (ℓ : K) ≠ 0 → ∀ (k : ℕ)
    (I : InjectiveResolution ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} (ZMod (ℓ ^ k)))))) (q : ℕ) (y : (wcP1Over K).left), y ∈ W →
    ∃ (U : (wcP1Over K).left.Etale) (t : U.left), U.hom t = y ∧
      ∃ (b : ℕ) (e : Fin b → ℕ),
        Nonempty (((((wcEtPush g).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q).over U ≅
          ((constantSheaf (Scheme.smallEtaleTopology (wcP1Over K).left) AddCommGrpCat.{u+1}).obj
            (AddCommGrpCat.of (ULift.{u+1} ((i : Fin b) → ZMod (ℓ ^ e i))))).over U) :=
by
  classical
  intro K _ X g _ W hloc ℓ hℓ hℓK k I q y hy

  haveI : IrreducibleSpace (wcP1Over K).left := wc_proj_space_irreducible K 1
  have hη : ∀ z : (wcP1Over K).left, genericPoint (wcP1Over K).left ⤳ z :=
    fun z => (genericPoint_spec (wcP1Over K).left).specializes (Set.mem_univ z)

  have hcof : ∀ b : (wcP1Over K).left, IsCofiltered (StructuredArrow
      (Over.mk (wcEtGeomPt (wcP1Over K).left b)) (Scheme.Etale.forget (wcP1Over K).left)) := by
    intro b
    apply wc_et_geomstalk_cofiltered
    intro P E S e _ a₁ a₂ h Ω _ π hπ
    exact wc_etale_maps_agree_near_geom_point e a₁ a₂ h Ω π hπ

  have hsm : Smooth (g ∣_ W) := wc_smooth_restrict_of_local_smooth g W hloc
  have hmK : ((ℓ ^ k : ℕ) : K) ≠ 0 := by
    rw [Nat.cast_pow]
    exact pow_ne_zero k hℓK

  haveI hfin := wc_et_P1_push_homology_stalk_finite K X g (ℓ ^ k) hmK I y q
  have htor := wc_et_push_homology_stalk_torsion g (ℓ ^ k) I q y (hcof y)
  obtain ⟨b, e, ⟨ε⟩⟩ := wc_finite_ell_torsion_pi_zmod _ ℓ k hℓ htor

  obtain ⟨V₀, t₀, ht₀, h₀, hh₀⟩ := wc_et_stalk_hom_realize _
    ((((wcEtPush g).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q)
    y (hcof y) b (fun i => ℓ ^ e i) ε.symm.toAddMonoidHom

  obtain ⟨U, c, t₁, ht₁, hirr, hUW, hgerm⟩ := wc_et_irreducible_nbhd_shrink _
    ((((wcEtPush g).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q)
    W y V₀ t₀ ht₀ (fun V v => wc_et_over_proj_locally_irreducible K 1 V v) hy
  haveI : Finite ((i : Fin b) → ZMod (ℓ ^ e i)) := Finite.of_equiv _ ε.toEquiv
  haveI : Finite (ULift.{u+1} ((i : Fin b) → ZMod (ℓ ^ e i))) := Finite.of_equiv _ Equiv.ulift.symm
  let h : ULift.{u+1} ((i : Fin b) → ZMod (ℓ ^ e i)) →+
      ((((wcEtPush g).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q).obj.obj
        (Opposite.op U) :=
    ((((((wcEtPush g).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q).obj.map
      c.op).hom.comp h₀).comp AddEquiv.ulift.toAddMonoidHom
  have e1 : ∀ a : ULift.{u+1} ((i : Fin b) → ZMod (ℓ ^ e i)),
      (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt (wcP1Over K).left y))
        (Scheme.Etale.forget (wcP1Over K).left)).op ⋙
        ((((wcEtPush g).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q).obj)
        (Opposite.op (StructuredArrow.mk (Over.homMk t₁ ht₁ : Over.mk (wcEtGeomPt (wcP1Over K).left y) ⟶
          (Scheme.Etale.forget (wcP1Over K).left).obj U)))).hom (h a) = ε.symm a.down :=
    fun a => (hgerm (h₀ a.down)).trans (hh₀ a.down)
  have hbij : Function.Bijective (fun a : ULift.{u+1} ((i : Fin b) → ZMod (ℓ ^ e i)) =>
      (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt (wcP1Over K).left y))
        (Scheme.Etale.forget (wcP1Over K).left)).op ⋙
        ((((wcEtPush g).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q).obj)
        (Opposite.op (StructuredArrow.mk (Over.homMk t₁ ht₁ : Over.mk (wcEtGeomPt (wcP1Over K).left y) ⟶
          (Scheme.Etale.forget (wcP1Over K).left).obj U)))).hom (h a)) := by
    convert ε.symm.bijective.comp Equiv.ulift.bijective using 1
    funext a
    exact e1 a

  have hspec := wc_et_irreducible_etale_generic_specializes _ U _ hη hirr

  have hall := wc_et_germ_bij_propagate _
    ((((wcEtPush g).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q)
    _ y U _ h t₁ ht₁ hcof hspec hbij (fun x hx => by
      obtain ⟨w, rfl⟩ := hx
      exact wc_et_P1_push_homology_cospec_iso K X g W hsm (ℓ ^ k) hmK I q _ _ hη (hUW w))

  obtain ⟨ψ⟩ := wc_et_const_over_iso_of_germ_bij _
    ((((wcEtPush g).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q)
    U (AddCommGrpCat.of (ULift.{u+1} ((i : Fin b) → ZMod (ℓ ^ e i)))) h hcof hall
  refine ⟨U, t₁ (IsLocalRing.closedPoint (AlgebraicClosure ((wcP1Over K).left.residueField y))),
    ?_, b, e, ⟨ψ.symm⟩⟩
  show (t₁ ≫ U.hom) _ = y
  rw [ht₁]
  show ((wcP1Over K).left.fromSpecResidueField y)
    ((Spec.map (CommRingCat.ofHom (algebraMap ((wcP1Over K).left.residueField y)
      (AlgebraicClosure ((wcP1Over K).left.residueField y)))))
      (IsLocalRing.closedPoint (AlgebraicClosure ((wcP1Over K).left.residueField y)))) = y
  first
    | exact Scheme.fromSpecResidueField_apply _ _
    | simp [Scheme.fromSpecResidueField_apply]

theorem wc_epsInv_over_iso_of_etale_local_iso : ∀ (B : Scheme.{u}) (G H : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}) (U : B.Etale),
    Nonempty (G.over U ≅ H.over U) →
    Nonempty (((wcEpsInv B).obj G).over ((wcEtToProEt B).obj U) ≅
      ((wcEpsInv B).obj H).over ((wcEtToProEt B).obj U)) :=
by
  intro B G H U hβ
  obtain ⟨β⟩ := hβ
  haveI : Limits.PreservesFiniteLimits (wcEtToProEt B) := (wc_etToProEt_flat_cont B).1
  haveI hge : (TwoSquare.overPost (wcEtToProEt B) U).GuitartExact := inferInstance
  haveI hgeop : (TwoSquare.overPost (wcEtToProEt B) U).op.GuitartExact := inferInstance
  have bc : ∀ Q : (B.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1},
      (Over.post (X := U) (wcEtToProEt B)).op.lan.obj ((Over.forget U).op ⋙ Q) ≅
        (Over.forget ((wcEtToProEt B).obj U)).op ⋙ (wcEtToProEt B).op.lan.obj Q := fun Q =>
    asIso ((TwoSquare.lanBaseChange (D := AddCommGrpCat.{u+1})
      (TwoSquare.overPost (wcEtToProEt B) U).op).app Q)
  let sc := Functor.pushforwardContinuousSheafificationCompatibility
    (Over.forget ((wcEtToProEt B).obj U)) AddCommGrpCat.{u+1}
    ((Scheme.ProEt.topology B).over ((wcEtToProEt B).obj U)) (Scheme.ProEt.topology B)
  let aP := presheafToSheaf ((Scheme.ProEt.topology B).over ((wcEtToProEt B).obj U))
    AddCommGrpCat.{u+1}
  have θ : ∀ X : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1},
      ((wcEpsInv B).obj X).over ((wcEtToProEt B).obj U) ≅
        aP.obj ((Over.post (X := U) (wcEtToProEt B)).op.lan.obj ((X.over U).obj)) := fun X =>
    (sc.app ((wcEtToProEt B).op.lan.obj X.obj)).symm ≪≫ aP.mapIso (bc X.obj).symm
  exact ⟨θ G ≪≫ aP.mapIso ((Over.post (X := U) (wcEtToProEt B)).op.lan.mapIso
    ((sheafToPresheaf _ _).mapIso β)) ≪≫ (θ H).symm⟩

theorem wc_pencil_Rq_torsion_etale_locally_const (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (D : wcLefschetzDatum F' F'' Y n)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (Ub : (wcGeomPoint F'' (wcP1Over F'') hP).left.Opens)
    (hUb : ∀ p : (wcGeomPoint F'' (wcP1Over F'') hP).left, p ∈ Ub ↔
        ∀ i : Fin D.m, (wcGeomPoint F'' (wcP1Over F'') hP).hom p ≠ D.S i (IsLocalRing.closedPoint F''))
    (q k : ℕ) :
    ∃ (N : ℕ) (V : Fin N → Scheme.{u}) (v : ∀ j, V j ⟶ Ub.toScheme),
      (∀ j, Etale (v j)) ∧ (∀ x : Ub.toScheme, ∃ j, x ∈ Set.range (v j)) ∧
      ∃ hV : ∀ j, WeaklyEtale (v j ≫ Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom),
      ∃ (b : Fin N → ℕ) (e : ∀ j, Fin (b j) → ℕ), ∀ j,
        Nonempty ((((wcProEtPush D.f).rightDerived q).obj (wcContSheaf D.Yt.left (ZMod (ℓ ^ k)))).over
            (MorphismProperty.Over.mk ⊤ (v j ≫ Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom) (hV j)) ≅
          (wcContSheaf (wcP1Over F'').left ((i : Fin (b j)) → ZMod (ℓ ^ e j i))).over
            (MorphismProperty.Over.mk ⊤ (v j ≫ Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom) (hV j))) :=
by
  classical
  haveI hPw : WeaklyEtale (wcGeomPoint F'' (wcP1Over F'') hP).hom := hP
  haveI := D.proper
  haveI hProp1 : IsProper (wcP1Over F'').hom := wc_proj_space_isProper F'' 1
  haveI hsep : IsSeparated (wcP1Over F'').hom := (inferInstance : IsSeparated (wcProjKStr F'' 1))
  haveI hcomp : IsProper (D.f ≫ (wcP1Over F'').hom) := by rw [D.hf]; exact D.proper
  haveI hfp : IsProper D.f := IsProper.of_comp D.f (wcP1Over F'').hom

  have hℓK : (ℓ : F'') ≠ 0 := by
    intro h0
    haveI := Fintype.ofFinite F''
    have hp : (ringChar F'').Prime := CharP.char_is_prime F'' (ringChar F'')
    have h1 : ringChar F'' ∣ ℓ := ringChar.dvd h0
    have h2 : ringChar F'' = ℓ := (Nat.prime_dvd_prime_iff_eq hp (Fact.out)).mp h1
    have h3 : ((Fintype.card F'' : ℕ) : F'') = 0 := FiniteField.cast_card_eq_zero F''
    have h4 : ringChar F'' ∣ Fintype.card F'' := ringChar.dvd h3
    apply hℓ
    rw [← h2, Nat.card_eq_fintype_card]
    exact h4

  have hS_ci : ∀ i, IsClosedImmersion (D.S i) := fun i =>
    isClosedImmersion_of_comp_eq_id (wcP1Over F'').hom (D.S i) (D.hS i)
  have hrange : ∀ (i : Fin D.m) (z : (wcP1Over F'').left),
      z ∈ Set.range (D.S i) ↔ z = D.S i (IsLocalRing.closedPoint F'') := by
    intro i z
    constructor
    · rintro ⟨w, rfl⟩
      rw [Subsingleton.elim w (IsLocalRing.closedPoint F'')]
    · rintro rfl
      exact ⟨_, rfl⟩
  have hWopen : IsOpen {z : (wcP1Over F'').left | ∀ i, z ≠ D.S i (IsLocalRing.closedPoint F'')} := by
    have he : {z : (wcP1Over F'').left | ∀ i, z ≠ D.S i (IsLocalRing.closedPoint F'')} =
        (⋃ i, Set.range (D.S i))ᶜ := by
      ext z
      simp only [Set.mem_setOf_eq, Set.mem_compl_iff, Set.mem_iUnion, not_exists, hrange]
    rw [he]
    exact (isClosed_iUnion_of_finite fun i => by
      haveI := hS_ci i
      exact (D.S i).isClosedEmbedding.isClosed_range).isOpen_compl
  let W : (wcP1Over F'').left.Opens := ⟨_, hWopen⟩
  have hsm : ∀ x : D.Yt.left, D.f x ∈ W → ∃ U' : D.Yt.left.Opens, x ∈ U' ∧ Smooth (U'.ι ≫ D.f) := by
    intro x hx
    apply D.smooth_off x
    intro i hxi
    apply (show ∀ i : Fin D.m, D.f x ≠ D.S i (IsLocalRing.closedPoint F'') from hx) i
    rw [hxi, ← D.hxs i]
    first
      | rfl
      | exact (Scheme.Hom.comp_apply _ _ _).symm

  haveI := wc_et_enough_injectives D.Yt.left
  let I := injectiveResolution ((constantSheaf (Scheme.smallEtaleTopology D.Yt.left)
    AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod (ℓ ^ k)))))
  obtain ⟨α⟩ := wc_proet_rightDerived_push_epsInv F'' D.Yt.left (wcP1Over F'').left
    (wcP1Over F'').hom D.f (ℓ ^ k) I q

  have hloc := fun (y : (wcP1Over F'').left) (hy : y ∈ W) =>
    wc_et_P1_smooth_proper_Rq_locally_const F'' D.Yt.left D.f W hsm ℓ (Fact.out) hℓK k I q y hy
  choose U t ht b e β using hloc
  haveI := (wc_etToProEt_flat_cont (wcP1Over F'').left).2

  have hγ : ∀ (y : (wcP1Over F'').left) (hy : y ∈ W),
      Nonempty ((((wcProEtPush D.f).rightDerived q).obj (wcContSheaf D.Yt.left (ZMod (ℓ ^ k)))).over
          ((wcEtToProEt (wcP1Over F'').left).obj (U y hy)) ≅
        (wcContSheaf (wcP1Over F'').left ((i : Fin (b y hy)) → ZMod (ℓ ^ e y hy i))).over
          ((wcEtToProEt (wcP1Over F'').left).obj (U y hy))) := by
    intro y hy
    obtain ⟨β'⟩ := β y hy
    obtain ⟨s3⟩ := wc_epsInv_over_iso_of_etale_local_iso (wcP1Over F'').left _ _ (U y hy) ⟨β'⟩
    obtain ⟨c6⟩ := wc_epsInv_const (wcP1Over F'').left
      (AddCommGrpCat.of (ULift.{u+1} ((i : Fin (b y hy)) → ZMod (ℓ ^ e y hy i))))
    obtain ⟨c5⟩ := wc_contSheaf_discrete_const (wcP1Over F'').left
      ((i : Fin (b y hy)) → ZMod (ℓ ^ e y hy i))
    exact ⟨((Scheme.ProEt.topology (wcP1Over F'').left).overPullback AddCommGrpCat.{u+1}
        ((wcEtToProEt (wcP1Over F'').left).obj (U y hy))).mapIso α ≪≫ s3 ≪≫
      ((Scheme.ProEt.topology (wcP1Over F'').left).overPullback AddCommGrpCat.{u+1}
        ((wcEtToProEt (wcP1Over F'').left).obj (U y hy))).mapIso c6 ≪≫
      ((Scheme.ProEt.topology (wcP1Over F'').left).overPullback AddCommGrpCat.{u+1}
        ((wcEtToProEt (wcP1Over F'').left).obj (U y hy))).mapIso c5.symm⟩

  obtain ⟨Ub', hUb', -, hcpt, -, -⟩ := wc_P1bar_smooth_locus F'' hP D.m D.S D.hS
  have hUbeq : Ub = Ub' :=
    TopologicalSpace.Opens.ext (Set.ext fun p => (hUb p).trans (hUb' p).symm)
  haveI : CompactSpace Ub.toScheme := by rw [hUbeq]; exact hcpt
  have hyW : ∀ x : Ub.toScheme, (Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom) x ∈ W := by
    intro x
    show ∀ i : Fin D.m, _ ≠ _
    intro i
    have hx : Ub.ι x ∈ (Ub : Set _) := by
      rw [← Scheme.Opens.range_ι]
      exact ⟨x, rfl⟩
    rw [Scheme.Hom.comp_apply]
    exact (hUb (Ub.ι x)).1 hx i
  have hEt : ∀ x : Ub.toScheme, Etale (Limits.pullback.snd (U _ (hyW x)).hom
      (Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom)) := by
    intro x
    haveI : Etale (U _ (hyW x)).hom := (U _ (hyW x)).prop
    infer_instance
  have hopen : ∀ x : Ub.toScheme, IsOpen (Set.range (Limits.pullback.snd (U _ (hyW x)).hom
      (Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom))) := by
    intro x
    haveI := hEt x
    exact (Limits.pullback.snd (U _ (hyW x)).hom
      (Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom)).isOpenMap.isOpen_range
  have hmem : ∀ x : Ub.toScheme, x ∈ Set.range (Limits.pullback.snd (U _ (hyW x)).hom
      (Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom)) := by
    intro x
    obtain ⟨z, -, hz⟩ := Scheme.Pullback.exists_preimage_pullback (f := (U _ (hyW x)).hom)
      (g := Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom) (t _ (hyW x)) x (ht _ (hyW x))
    exact ⟨z, hz⟩
  obtain ⟨T, hT⟩ := isCompact_univ.elim_finite_subcover
    (fun x : Ub.toScheme => Set.range (Limits.pullback.snd (U _ (hyW x)).hom
      (Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom)))
    hopen (fun x _ => Set.mem_iUnion.2 ⟨x, hmem x⟩)
  have hVall : ∀ j : Fin T.card, WeaklyEtale (Limits.pullback.snd
      (U _ (hyW (T.equivFin.symm j).1)).hom (Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom) ≫
      Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom) := by
    intro j
    haveI : Etale (U _ (hyW (T.equivFin.symm j).1)).hom := (U _ (hyW (T.equivFin.symm j).1)).prop
    infer_instance
  refine ⟨T.card, fun j => Limits.pullback (U _ (hyW (T.equivFin.symm j).1)).hom
      (Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom),
    fun j => Limits.pullback.snd _ _, fun j => hEt _, ?_, hVall,
    fun j => b _ (hyW (T.equivFin.symm j).1), fun j => e _ (hyW (T.equivFin.symm j).1), ?_⟩
  · intro x'
    have h1 := hT (Set.mem_univ x')
    rw [Set.mem_iUnion₂] at h1
    obtain ⟨i, hiT, hi⟩ := h1
    obtain ⟨j, hj⟩ : ∃ j, T.equivFin.symm j = ⟨i, hiT⟩ := ⟨_, Equiv.symm_apply_apply _ _⟩
    refine ⟨j, ?_⟩
    show x' ∈ Set.range (Limits.pullback.snd (U _ (hyW (T.equivFin.symm j).1)).hom
      (Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom))
    rw [hj]
    exact hi
  · intro j
    obtain ⟨γ⟩ := hγ _ (hyW (T.equivFin.symm j).1)
    let Q : (wcP1Over F'').left.ProEt :=
      MorphismProperty.Over.mk ⊤ (Limits.pullback.snd (U _ (hyW (T.equivFin.symm j).1)).hom
            (Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom) ≫
            Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom) (hVall j)
    let P : (wcP1Over F'').left.ProEt :=
      (wcEtToProEt (wcP1Over F'').left).obj (U _ (hyW (T.equivFin.symm j).1))
    let c : Q ⟶ P := MorphismProperty.Over.homMk
        (Limits.pullback.fst (U _ (hyW (T.equivFin.symm j).1)).hom
          (Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom))
        Limits.pullback.condition trivial
    exact ⟨((Scheme.ProEt.topology (wcP1Over F'').left).overMapPullback AddCommGrpCat.{u+1}
      c).mapIso γ⟩

theorem wc_proet_loc_const_fibre_iso : ∀ (S : Scheme.{u}) (H : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
    (A B : Type) [AddCommGroup A] [TopologicalSpace A] [DiscreteTopology A]
    [IsTopologicalAddGroup A] [AddCommGroup B] [TopologicalSpace B] [DiscreteTopology B]
    [IsTopologicalAddGroup B] (Y₁ Y₂ : S.ProEt),
    (H.over Y₁ ≅ (wcContSheaf S A).over Y₁) → (H.over Y₂ ≅ (wcContSheaf S B).over Y₂) →
    ∀ (y₁ : Y₁.left) (y₂ : Y₂.left), Y₁.hom y₁ = Y₂.hom y₂ → Nonempty (A ≃+ B) :=
by
  intro S H A B _ _ _ _ _ _ _ _ Y₁ Y₂ φ₁ φ₂ y₁ y₂ h
  classical

  have ev : ∀ (X : Type u) [TopologicalSpace X] [ConnectedSpace X]
      (M : Type) [AddCommGroup M] [TopologicalSpace M] [DiscreteTopology M]
      [IsTopologicalAddGroup M], Nonempty (C(X, M) ≃+ M) := by
    intro X _ _ M _ _ _ _
    obtain ⟨x₀⟩ := (inferInstance : Nonempty X)
    let e : C(X, M) →+ M :=
      { toFun := fun f => f x₀
        map_zero' := rfl
        map_add' := fun f g => rfl }
    refine ⟨AddEquiv.ofBijective e ⟨?_, ?_⟩⟩
    · intro f g hfg
      ext x
      have h1 : f x = f x₀ := PreconnectedSpace.constant inferInstance f.continuous
      have h2 : g x = g x₀ := PreconnectedSpace.constant inferInstance g.continuous
      rw [h1, h2]
      exact hfg
    · intro c
      exact ⟨ContinuousMap.const X c, rfl⟩

  have sec : ∀ (M : Type) [AddCommGroup M] [TopologicalSpace M] [IsTopologicalAddGroup M]
      (Y T : S.ProEt), (T ⟶ Y) → (H.over Y ≅ (wcContSheaf S M).over Y) →
      Nonempty (H.obj.obj (Opposite.op T) ≃+ C(↥T.left, M)) := by
    intro M _ _ _ Y T a φ
    let φP := ((sheafToPresheaf _ _).mapIso φ).app (Opposite.op (Over.mk a))
    exact ⟨(φP.addCommGroupIsoToAddEquiv).trans (AddEquiv.ulift (α := C(↥T.left, M)))⟩

  obtain ⟨z₀, -, -⟩ := Scheme.Pullback.exists_preimage_pullback y₁ y₂ h
  set P := Limits.pullback Y₁.hom Y₂.hom with hPdef
  have hσ : WeaklyEtale (P.fromSpecStalk z₀) := by
    refine ⟨?_, inferInstance⟩
    obtain ⟨_, ⟨U, hU, rfl⟩, hx, -⟩ :=
      P.isBasis_affineOpens.exists_subset_of_mem_open (Set.mem_univ z₀) isOpen_univ
    replace hU : IsAffineOpen U := hU
    rw [← hU.fromSpecStalk_eq_fromSpecStalk hx]
    show Flat (Spec.map (P.presheaf.germ U z₀ hx) ≫ hU.fromSpec)
    have : Flat (Spec.map (P.presheaf.germ U z₀ hx)) := by
      rw [HasRingHomProperty.Spec_iff (P := @Flat)]
      letI : Algebra Γ(P, U) (P.presheaf.stalk z₀) := (P.presheaf.germ U z₀ hx).hom.toAlgebra
      haveI := hU.isLocalization_stalk ⟨z₀, hx⟩
      exact RingHom.flat_algebraMap_iff.mpr
        (IsLocalization.flat _ (hU.primeIdealOf ⟨z₀, hx⟩).asIdeal.primeCompl)
    have hoi : IsOpenImmersion hU.fromSpec := hU.isOpenImmersion_fromSpec
    have hfs : Flat hU.fromSpec := Flat.instOfIsOpenImmersion _
    exact MorphismProperty.comp_mem @Flat _ _ this hfs
  have hconn : ConnectedSpace (Spec (P.presheaf.stalk z₀)) := by
    rw [connectedSpace_iff_clopen]
    refine ⟨⟨IsLocalRing.closedPoint (P.presheaf.stalk z₀)⟩, fun s hs => ?_⟩
    by_cases hne : s.Nonempty
    · obtain ⟨x, hx⟩ := hne
      right
      have hm : IsLocalRing.closedPoint (P.presheaf.stalk z₀) ∈ s :=
        (IsLocalRing.specializes_closedPoint x).mem_closed hs.1 hx
      ext y
      simp only [Set.mem_univ, iff_true]
      exact (IsLocalRing.specializes_closedPoint y).mem_open hs.2 hm
    · left
      exact Set.not_nonempty_iff_eq_empty.mp hne
  haveI := hσ
  haveI : WeaklyEtale Y₁.hom := Y₁.prop
  haveI : WeaklyEtale Y₂.hom := Y₂.prop
  have hT : WeaklyEtale (P.fromSpecStalk z₀ ≫ Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom) :=
    inferInstance
  let T : S.ProEt := MorphismProperty.Over.mk ⊤
    (P.fromSpecStalk z₀ ≫ Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom) hT
  let a : T ⟶ Y₁ := MorphismProperty.Over.homMk
    (P.fromSpecStalk z₀ ≫ Limits.pullback.fst Y₁.hom Y₂.hom) (Category.assoc _ _ _) trivial
  let b : T ⟶ Y₂ := MorphismProperty.Over.homMk
    (P.fromSpecStalk z₀ ≫ Limits.pullback.snd Y₁.hom Y₂.hom)
    (by
      show (P.fromSpecStalk z₀ ≫ Limits.pullback.snd Y₁.hom Y₂.hom) ≫ Y₂.hom =
        P.fromSpecStalk z₀ ≫ Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom
      rw [Category.assoc, ← Limits.pullback.condition]) trivial
  haveI : ConnectedSpace T.left := hconn

  obtain ⟨e₁⟩ := sec A Y₁ T a φ₁
  obtain ⟨e₂⟩ := sec B Y₂ T b φ₂
  obtain ⟨c₁⟩ := ev (↥T.left) A
  obtain ⟨c₂⟩ := ev (↥T.left) B
  exact ⟨c₁.symm.trans (e₁.symm.trans (e₂.trans c₂))⟩

theorem wc_connected_open_cover_one_class : ∀ (U : Scheme.{u}), ConnectedSpace U → ∀ (ι : Type) (V : ι → Scheme.{u}) (v : ∀ j, V j ⟶ U),
    (∀ j, IsOpenMap (v j)) → (∀ x : U, ∃ j, x ∈ Set.range (v j)) →
    ∀ (R : ι → ι → Prop), Equivalence R →
    (∀ (j k : ι) (x : U), x ∈ Set.range (v j) → x ∈ Set.range (v k) → R j k) →
    ∃ j₀ : ι, ∀ j, Nonempty (V j) → R j j₀ :=
by
  intro U hU ι V v hopen hcov R hR hrel
  obtain ⟨x0⟩ := (inferInstance : Nonempty U)
  obtain ⟨j0, hx0⟩ := hcov x0
  let W : Set U := ⋃ k, ⋃ (_ : R k j0), Set.range (v k)
  have hWo : IsOpen W := isOpen_iUnion fun k => isOpen_iUnion fun _ => (hopen k).isOpen_range
  have hWc : Wᶜ = ⋃ k, ⋃ (_ : ¬ R k j0), Set.range (v k) := by
    ext x
    simp only [W, Set.mem_compl_iff, Set.mem_iUnion, not_exists]
    constructor
    · intro h
      obtain ⟨k, hk⟩ := hcov x
      exact ⟨k, fun hRk => h k hRk hk, hk⟩
    · rintro ⟨k, hnR, hk⟩ k' hR' hk'
      exact hnR (hR.trans (hrel k k' x hk hk') hR')
  have hWcl : IsClosed W := by
    rw [← isOpen_compl_iff, hWc]
    exact isOpen_iUnion fun k => isOpen_iUnion fun _ => (hopen k).isOpen_range
  have hWne : W.Nonempty := ⟨x0, Set.mem_iUnion.mpr ⟨j0, Set.mem_iUnion.mpr ⟨hR.refl j0, hx0⟩⟩⟩
  have hWu : W = Set.univ := IsClopen.eq_univ ⟨hWcl, hWo⟩ hWne
  refine ⟨j0, fun j hj => ?_⟩
  obtain ⟨y⟩ := hj
  have hy : v j y ∈ W := by rw [hWu]; trivial
  simp only [W, Set.mem_iUnion] at hy
  obtain ⟨k, hk, hyk⟩ := hy
  exact hR.trans (hrel j k _ ⟨y, rfl⟩ hyk) hk

theorem wc_contSheaf_iso_of_addEquiv : ∀ (S : Scheme.{u}) (A B : Type) [AddCommGroup A] [TopologicalSpace A] [DiscreteTopology A]
    [IsTopologicalAddGroup A] [AddCommGroup B] [TopologicalSpace B] [DiscreteTopology B]
    [IsTopologicalAddGroup B] (σ : A ≃+ B),
    ∃ θ : wcContSheaf S A ≅ wcContSheaf S B, ∀ (T : S.ProEt)
      (x : (wcContSheaf S A).obj.obj (Opposite.op T)) (z : T.left),
      (show C(↥T.left, B) from ((θ.hom.hom.app (Opposite.op T)).hom x).down) z =
        σ ((show C(↥T.left, A) from x.down) z) :=
by
  intro S A B _ _ _ _ _ _ _ _ σ
  let h : wcContSheaf S A ⟶ wcContSheaf S B :=
    wcContSheafMap S σ.toAddMonoidHom continuous_of_discreteTopology
  let k : wcContSheaf S B ⟶ wcContSheaf S A :=
    wcContSheafMap S σ.symm.toAddMonoidHom continuous_of_discreteTopology
  have hk : h ≫ k = 𝟙 _ := by
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext T
    apply AddCommGrpCat.ext
    intro x
    apply ULift.ext
    apply ContinuousMap.ext
    intro z
    exact σ.symm_apply_apply ((show C(↥(Opposite.unop T).left, A) from x.down) z)
  have kh : k ≫ h = 𝟙 _ := by
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext T
    apply AddCommGrpCat.ext
    intro x
    apply ULift.ext
    apply ContinuousMap.ext
    intro z
    exact σ.apply_symm_apply ((show C(↥(Opposite.unop T).left, B) from x.down) z)
  exact ⟨⟨h, k, hk, kh⟩, fun T x z => rfl⟩

theorem wc_contSheaf_over_hom_pointwise : ∀ (S : Scheme.{u}) (A B : Type) [AddCommGroup A] [TopologicalSpace A] [DiscreteTopology A]
    [IsTopologicalAddGroup A] [Finite A] [AddCommGroup B] [TopologicalSpace B] [DiscreteTopology B]
    [IsTopologicalAddGroup B] (P : S.ProEt)
    (α : (wcContSheaf S A).over P ⟶ (wcContSheaf S B).over P),
    ∃ g : P.left → (A →+ B), IsLocallyConstant g ∧
      ∀ (T : Over P) (f : (wcContSheaf S A).obj.obj (Opposite.op T.left)) (t : T.left.left),
        (show C(↥T.left.left, B) from ((α.hom.app (Opposite.op T)).hom f).down) t =
          g (T.hom.left t) ((show C(↥T.left.left, A) from f.down) t) :=
by
  intro S A B _ _ _ _ _ _ _ _ _ P α
  classical
  let T1 : Over P := Over.mk (𝟙 P)
  let κ : A → (wcContSheaf S A).obj.obj (Opposite.op P) := fun a =>
    (show (wcContSheaf S A).obj.obj (Opposite.op P) from ULift.up (ContinuousMap.const ↥P.left a))
  let β : A → C(↥P.left, B) := fun a =>
    (show C(↥P.left, B) from ((α.hom.app (Opposite.op T1)).hom (κ a)).down)

  have hadd : ∀ (p : P.left) (a a' : A), β (a + a') p = β a p + β a' p := by
    intro p a a'
    have h1 : (α.hom.app (Opposite.op T1)).hom (κ (a + a')) =
        (α.hom.app (Opposite.op T1)).hom (κ a) + (α.hom.app (Opposite.op T1)).hom (κ a') := by
      calc _ = (α.hom.app (Opposite.op T1)).hom (κ a + κ a') := rfl
        _ = _ := map_add _ _ _
    exact congrArg (fun x : ULift.{u+1} C(↥P.left, B) => x.down p) h1
  let g : P.left → (A →+ B) := fun p => AddMonoidHom.mk' (fun a => β a p) (hadd p)
  have hg : ∀ p a, g p a = β a p := fun _ _ => rfl
  refine ⟨g, ?_, ?_⟩
  ·
    rw [IsLocallyConstant.iff_isOpen_fiber]
    intro h
    have hfib : g ⁻¹' {h} = ⋂ a : A, (fun p => β a p) ⁻¹' {h a} := by
      ext p
      simp only [Set.mem_preimage, Set.mem_singleton_iff, Set.mem_iInter]
      constructor
      · intro hp a
        rw [← hp, hg]
      · intro H
        ext a
        rw [hg]
        exact H a
    rw [hfib]
    exact isOpen_iInter_of_finite fun a => (isOpen_discrete _).preimage (β a).continuous
  · intro T f t
    obtain ⟨a, ha⟩ : ∃ a, (show C(↥T.left.left, A) from f.down) t = a := ⟨_, rfl⟩
    let O : T.left.left.Opens :=
      ⟨(show C(↥T.left.left, A) from f.down) ⁻¹' {a},
        (isOpen_discrete _).preimage (ContinuousMap.continuous _)⟩
    have hWE : WeaklyEtale (O.ι ≫ T.left.hom) := by
      have := T.left.prop
      infer_instance
    let TO : S.ProEt := Scheme.ProEt.mk (O.ι ≫ T.left.hom)
    let i : TO ⟶ T.left := MorphismProperty.Over.homMk O.ι rfl trivial
    let T' : Over P := Over.mk (i ≫ T.hom)
    let j : T' ⟶ T := Over.homMk i rfl
    let k : T' ⟶ T1 := Over.homMk T'.hom (Category.comp_id _)
    have hmem : t ∈ Set.range O.ι := by
      rw [Scheme.Opens.range_ι]
      exact ha
    obtain ⟨t', rfl⟩ := hmem

    have h3 : (((wcContSheaf S A).over P).obj.map j.op).hom f =
        (((wcContSheaf S A).over P).obj.map k.op).hom (κ a) := by
      have h4 : (show ULift.{u+1} C(↥T'.left.left, A) from
            (((wcContSheaf S A).over P).obj.map j.op).hom f) =
          (show ULift.{u+1} C(↥T'.left.left, A) from
            (((wcContSheaf S A).over P).obj.map k.op).hom (κ a)) := by
        apply ULift.ext
        apply ContinuousMap.ext
        intro t''
        show (show C(↥T.left.left, A) from f.down) (O.ι t'') = a
        have hm : O.ι t'' ∈ Set.range O.ι := ⟨t'', rfl⟩
        rw [Scheme.Opens.range_ι] at hm
        exact hm
      exact h4

    have e1 : (show C(↥T'.left.left, B) from ((α.hom.app (Opposite.op T')).hom
          ((((wcContSheaf S A).over P).obj.map j.op).hom f)).down) t' =
        (show C(↥T.left.left, B) from ((α.hom.app (Opposite.op T)).hom f).down) (O.ι t') := by
      have h := congrArg (fun φ => AddCommGrpCat.Hom.hom φ f) (α.hom.naturality j.op)
      exact congrArg (fun x : ULift.{u+1} C(↥T'.left.left, B) => x.down t') h

    have e2 : (show C(↥T'.left.left, B) from ((α.hom.app (Opposite.op T')).hom
          ((((wcContSheaf S A).over P).obj.map k.op).hom (κ a))).down) t' =
        β a (T.hom.left (O.ι t')) := by
      have h := congrArg (fun φ => AddCommGrpCat.Hom.hom φ (κ a)) (α.hom.naturality k.op)
      exact congrArg (fun x : ULift.{u+1} C(↥T'.left.left, B) => x.down t') h
    have e3 := congrArg (fun x => (show C(↥T'.left.left, B) from
      ((α.hom.app (Opposite.op T')).hom x).down) t') h3
    calc (show C(↥T.left.left, B) from ((α.hom.app (Opposite.op T)).hom f).down) (O.ι t')
        = β a (T.hom.left (O.ι t')) := e1.symm.trans (e3.trans e2)
      _ = g (T.hom.left (O.ι t')) ((show C(↥T.left.left, A) from f.down) (O.ι t')) := by
        rw [ha, hg]

theorem wc_proet_constSheaf_trivialization_cocycle : ∀ (S : Scheme.{u}) (H : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
    (M : Type) [AddCommGroup M] [TopologicalSpace M] [DiscreteTopology M] [IsTopologicalAddGroup M]
    [Finite M],
    (∀ (P : S.ProEt) (α : (wcContSheaf S M).over P ⟶ (wcContSheaf S M).over P),
      ∃ g : P.left → (M →+ M), IsLocallyConstant g ∧
        ∀ (T : Over P) (f : (wcContSheaf S M).obj.obj (Opposite.op T.left)) (t : T.left.left),
          (show C(↥T.left.left, M) from ((α.hom.app (Opposite.op T)).hom f).down) t =
            g (T.hom.left t) ((show C(↥T.left.left, M) from f.down) t)) →
    ∀ (ι : Type) (Y : ι → S.ProEt) (φ : ∀ j, H.over (Y j) ≅ (wcContSheaf S M).over (Y j)),
    ∃ g : ∀ i j, ↥(Limits.pullback (Y i).hom (Y j).hom) → Multiplicative (AddAut M),
      (∀ i j, IsLocallyConstant (g i j)) ∧
      (∀ (i j k : ι) (Z : S.ProEt) (a : Z ⟶ Y i) (b : Z ⟶ Y j) (c : Z ⟶ Y k) (z : Z.left),
        g i k (Limits.pullback.lift a.left c.left
            ((MorphismProperty.Over.w a).trans (MorphismProperty.Over.w c).symm) z) =
          g i j (Limits.pullback.lift a.left b.left
            ((MorphismProperty.Over.w a).trans (MorphismProperty.Over.w b).symm) z) *
          g j k (Limits.pullback.lift b.left c.left
            ((MorphismProperty.Over.w b).trans (MorphismProperty.Over.w c).symm) z)) ∧
      ∀ (i j : ι) (Z : S.ProEt) (a : Z ⟶ Y i) (b : Z ⟶ Y j)
        (x : H.obj.obj (Opposite.op Z)) (z : Z.left),
        (show C(↥Z.left, M) from (((φ i).hom.hom.app (Opposite.op (Over.mk a))).hom x).down) z =
          Multiplicative.toAdd (g i j (Limits.pullback.lift a.left b.left
            ((MorphismProperty.Over.w a).trans (MorphismProperty.Over.w b).symm) z))
            ((show C(↥Z.left, M) from (((φ j).hom.hom.app (Opposite.op (Over.mk b))).hom x).down) z) :=
by
  intro S H M _ _ _ _ _ hpw ι Y φ
  classical

  have hIH : ∀ (Q : S.ProEt) (F G : Sheaf ((Scheme.ProEt.topology S).over Q) AddCommGrpCat.{u+1})
      (θ : F ≅ G) (T : (Over Q)ᵒᵖ) (y : G.obj.obj T),
      (θ.hom.hom.app T).hom ((θ.inv.hom.app T).hom y) = y := by
    intro Q F G θ T y
    exact congrArg (fun t : G ⟶ G => (t.hom.app T).hom y) θ.inv_hom_id
  have hHI : ∀ (Q : S.ProEt) (F G : Sheaf ((Scheme.ProEt.topology S).over Q) AddCommGrpCat.{u+1})
      (θ : F ≅ G) (T : (Over Q)ᵒᵖ) (y : F.obj.obj T),
      (θ.inv.hom.app T).hom ((θ.hom.hom.app T).hom y) = y := by
    intro Q F G θ T y
    exact congrArg (fun t : F ⟶ F => (t.hom.app T).hom y) θ.hom_inv_id

  have hAut : ∀ (P : S.ProEt) (α : (wcContSheaf S M).over P ≅ (wcContSheaf S M).over P),
      ∃ e : P.left → Multiplicative (AddAut M), IsLocallyConstant e ∧
        ∀ (T : Over P) (f : (wcContSheaf S M).obj.obj (Opposite.op T.left)) (t : T.left.left),
          (show C(↥T.left.left, M) from ((α.hom.hom.app (Opposite.op T)).hom f).down) t =
            Multiplicative.toAdd (e (T.hom.left t)) ((show C(↥T.left.left, M) from f.down) t) := by
    intro P α
    obtain ⟨g, hgl, hg⟩ := hpw P α.hom
    obtain ⟨h, -, hh⟩ := hpw P α.inv
    have key1 : ∀ (p : P.left) (m : M), g p (h p m) = m := by
      intro p m
      let f₀ : (wcContSheaf S M).obj.obj (Opposite.op (Over.mk (𝟙 P)).left) :=
        (ULift.up (ContinuousMap.const (↥P.left) m) : ULift.{u+1} C(↥P.left, M))
      have e1 := hIH P _ _ α (Opposite.op (Over.mk (𝟙 P))) f₀
      have e2 := hg (Over.mk (𝟙 P)) ((α.inv.hom.app (Opposite.op (Over.mk (𝟙 P)))).hom f₀) p
      have e3 := hh (Over.mk (𝟙 P)) f₀ p
      rw [e1, e3] at e2
      exact e2.symm
    have key2 : ∀ (p : P.left) (m : M), h p (g p m) = m := by
      intro p m
      let f₀ : (wcContSheaf S M).obj.obj (Opposite.op (Over.mk (𝟙 P)).left) :=
        (ULift.up (ContinuousMap.const (↥P.left) m) : ULift.{u+1} C(↥P.left, M))
      have e1 := hHI P _ _ α (Opposite.op (Over.mk (𝟙 P))) f₀
      have e2 := hh (Over.mk (𝟙 P)) ((α.hom.hom.app (Opposite.op (Over.mk (𝟙 P)))).hom f₀) p
      have e3 := hg (Over.mk (𝟙 P)) f₀ p
      rw [e1, e3] at e2
      exact e2.symm
    let e : P.left → Multiplicative (AddAut M) := fun p => Multiplicative.ofAdd
      { toFun := g p, invFun := h p, left_inv := fun m => key2 p m,
        right_inv := fun m => key1 p m, map_add' := (g p).map_add }
    let ρ : Multiplicative (AddAut M) → (M →+ M) := fun γ => (Multiplicative.toAdd γ).toAddMonoidHom
    have hρ : Function.Injective ρ := by
      intro γ δ hγδ
      apply Multiplicative.toAdd.injective
      apply AddEquiv.ext
      intro y
      exact DFunLike.congr_fun hγδ y
    have hρe : ρ ∘ e = g := by
      funext p
      apply AddMonoidHom.ext
      intro m
      rfl
    refine ⟨e, IsLocallyConstant.desc e ρ (by rw [hρe]; exact hgl) hρ, ?_⟩
    intro T f t
    exact hg T f t

  have hPw : ∀ i j, WeaklyEtale (Limits.pullback.fst (Y i).hom (Y j).hom ≫ (Y i).hom) := by
    intro i j
    haveI := (Y i).prop
    haveI := (Y j).prop
    infer_instance
  let P : ι → ι → S.ProEt := fun i j =>
    MorphismProperty.Over.mk ⊤ (Limits.pullback.fst (Y i).hom (Y j).hom ≫ (Y i).hom) (hPw i j)
  let pp : ∀ i j, P i j ⟶ Y i := fun i j =>
    MorphismProperty.Over.homMk (Limits.pullback.fst (Y i).hom (Y j).hom) rfl trivial
  let qq : ∀ i j, P i j ⟶ Y j := fun i j =>
    MorphismProperty.Over.homMk (Limits.pullback.snd (Y i).hom (Y j).hom)
      Limits.pullback.condition.symm trivial

  have hT : ∀ i j, ∃ e : (P i j).left → Multiplicative (AddAut M), IsLocallyConstant e ∧
      ∀ (Z : S.ProEt) (c : Z ⟶ P i j) (x : H.obj.obj (Opposite.op Z)) (z : Z.left),
        (show C(↥Z.left, M) from
            (((φ i).hom.hom.app (Opposite.op (Over.mk (c ≫ pp i j)))).hom x).down) z =
          Multiplicative.toAdd (e (c.left z))
            ((show C(↥Z.left, M) from
              (((φ j).hom.hom.app (Opposite.op (Over.mk (c ≫ qq i j)))).hom x).down) z) := by
    intro i j
    let α : (wcContSheaf S M).over (P i j) ≅ (wcContSheaf S M).over (P i j) :=
      (((Scheme.ProEt.topology S).overMapPullback AddCommGrpCat.{u+1} (qq i j)).mapIso
          (φ j)).symm ≪≫
        ((Scheme.ProEt.topology S).overMapPullback AddCommGrpCat.{u+1} (pp i j)).mapIso (φ i)
    obtain ⟨e, he, hf⟩ := hAut (P i j) α
    refine ⟨e, he, ?_⟩
    intro Z c x z
    have h1 := hf (Over.mk c) (((φ j).hom.hom.app (Opposite.op (Over.mk (c ≫ qq i j)))).hom x) z
    have h2 : (α.hom.hom.app (Opposite.op (Over.mk c))).hom
          (((φ j).hom.hom.app (Opposite.op (Over.mk (c ≫ qq i j)))).hom x) =
        ((φ i).hom.hom.app (Opposite.op (Over.mk (c ≫ pp i j)))).hom x := by
      show ((φ i).hom.hom.app (Opposite.op (Over.mk (c ≫ pp i j)))).hom
          (((φ j).inv.hom.app (Opposite.op (Over.mk (c ≫ qq i j)))).hom
            (((φ j).hom.hom.app (Opposite.op (Over.mk (c ≫ qq i j)))).hom x)) = _
      rw [hHI (Y j) _ _ (φ j) (Opposite.op (Over.mk (c ≫ qq i j))) x]
    rw [h2] at h1
    exact h1
  choose e he hf using hT

  have htrans : ∀ (i j : ι) (Z : S.ProEt) (a : Z ⟶ Y i) (b : Z ⟶ Y j)
      (x : H.obj.obj (Opposite.op Z)) (z : Z.left),
      (show C(↥Z.left, M) from (((φ i).hom.hom.app (Opposite.op (Over.mk a))).hom x).down) z =
        Multiplicative.toAdd (e i j (Limits.pullback.lift a.left b.left
          ((MorphismProperty.Over.w a).trans (MorphismProperty.Over.w b).symm) z))
          ((show C(↥Z.left, M) from (((φ j).hom.hom.app (Opposite.op (Over.mk b))).hom x).down) z) := by
    intro i j Z a b x z
    let cZ : Z ⟶ P i j := MorphismProperty.Over.homMk (Limits.pullback.lift a.left b.left
        ((MorphismProperty.Over.w a).trans (MorphismProperty.Over.w b).symm))
      (by
        show Limits.pullback.lift a.left b.left
            ((MorphismProperty.Over.w a).trans (MorphismProperty.Over.w b).symm) ≫
            Limits.pullback.fst (Y i).hom (Y j).hom ≫ (Y i).hom = Z.hom
        rw [Limits.pullback.lift_fst_assoc]
        exact MorphismProperty.Over.w a) trivial
    have hca : cZ ≫ pp i j = a := MorphismProperty.Over.Hom.ext (Limits.pullback.lift_fst _ _ _)
    have hcb : cZ ≫ qq i j = b := MorphismProperty.Over.Hom.ext (Limits.pullback.lift_snd _ _ _)
    have h := hf i j Z cZ x z
    rw [hca, hcb] at h
    exact h
  refine ⟨e, he, ?_, htrans⟩

  intro i j k Z a b c z
  apply Multiplicative.toAdd.injective
  apply AddEquiv.ext
  intro m
  let κ : (wcContSheaf S M).obj.obj (Opposite.op Z) :=
    (ULift.up (ContinuousMap.const (↥Z.left) m) : ULift.{u+1} C(↥Z.left, M))
  let x : H.obj.obj (Opposite.op Z) := ((φ k).inv.hom.app (Opposite.op (Over.mk c))).hom κ
  have hx : ((φ k).hom.hom.app (Opposite.op (Over.mk c))).hom x = κ :=
    hIH (Y k) _ _ (φ k) (Opposite.op (Over.mk c)) κ
  have h1 := htrans i k Z a c x z
  have h2 := htrans i j Z a b x z
  have h3 := htrans j k Z b c x z
  rw [hx] at h1 h3
  exact h1.symm.trans (h2.trans (congrArg _ h3))

theorem wc_gtor_ring_descent : wcGTorDescHyp.{u} :=
by
  unfold wcGTorDescHyp
  intro R R' _ _ _ _ Γ _ _ e he
  classical
  obtain ⟨hidem, horth, hsum, hcoc⟩ := he
  let p12 : TensorProduct R R' R' →ₐ[R] TensorProduct R R' (TensorProduct R R' R') :=
    Algebra.TensorProduct.map (AlgHom.id R R') Algebra.TensorProduct.includeLeft
  let p13 : TensorProduct R R' R' →ₐ[R] TensorProduct R R' (TensorProduct R R' R') :=
    Algebra.TensorProduct.map (AlgHom.id R R') Algebra.TensorProduct.includeRight
  let p23 : TensorProduct R R' R' →ₐ[R] TensorProduct R R' (TensorProduct R R' R') :=
    Algebra.TensorProduct.includeRight
  let μ : TensorProduct R R' R' →ₐ[R] R' := Algebra.TensorProduct.lmul' R
  let ψ : TensorProduct R R' (TensorProduct R R' R') →ₐ[R] TensorProduct R R' R' :=
    Algebra.TensorProduct.map (AlgHom.id R R') μ
  have hcoc' : ∀ c, p13 (e c) = ∑ a, p12 (e a) * p23 (e (a⁻¹ * c)) := hcoc
  have hμt : ∀ a b : R', μ (a ⊗ₜ[R] b) = a * b := fun a b =>
    Algebra.TensorProduct.lmul'_apply_tmul a b

  have hψ13 : ∀ z, ψ (p13 z) = z := by
    intro z
    induction z using TensorProduct.induction_on with
    | zero => simp only [map_zero]
    | tmul a b =>
      simp only [ψ, p13, Algebra.TensorProduct.map_tmul, AlgHom.id_apply,
        Algebra.TensorProduct.includeRight_apply, hμt, one_mul]
    | add x y hx hy => rw [map_add, map_add, hx, hy]
  have hψ12 : ∀ z, ψ (p12 z) = z := by
    intro z
    induction z using TensorProduct.induction_on with
    | zero => simp only [map_zero]
    | tmul a b =>
      simp only [ψ, p12, Algebra.TensorProduct.map_tmul, AlgHom.id_apply,
        Algebra.TensorProduct.includeLeft_apply, hμt, mul_one]
    | add x y hx hy => rw [map_add, map_add, hx, hy]
  have hψ23 : ∀ z, ψ (p23 z) = (1 : R') ⊗ₜ[R] μ z := by
    intro z
    simp only [ψ, p23, Algebra.TensorProduct.includeRight_apply, Algebra.TensorProduct.map_tmul,
      AlgHom.id_apply]
  have hf : ∀ c, μ (e c) = μ (e c) * μ (e 1) := by
    intro c
    have h1 : e c = ∑ a, e a * ((1 : R') ⊗ₜ[R] μ (e (a⁻¹ * c))) := by
      have := congrArg ψ (hcoc' c)
      rw [hψ13, map_sum] at this
      simpa only [map_mul, hψ12, hψ23] using this
    have h2 : e c = e c * ((1 : R') ⊗ₜ[R] μ (e 1)) := by
      calc e c = e c * e c := (hidem c).eq.symm
        _ = e c * ∑ a, e a * ((1 : R') ⊗ₜ[R] μ (e (a⁻¹ * c))) := by rw [← h1]
        _ = ∑ a, e c * (e a * ((1 : R') ⊗ₜ[R] μ (e (a⁻¹ * c)))) := Finset.mul_sum _ _ _
        _ = e c * (e c * ((1 : R') ⊗ₜ[R] μ (e (c⁻¹ * c)))) := by
          refine Finset.sum_eq_single c (fun b _ hb => ?_) (fun hc => absurd (Finset.mem_univ c) hc)
          rw [← mul_assoc, horth c b (Ne.symm hb), zero_mul]
        _ = e c * ((1 : R') ⊗ₜ[R] μ (e 1)) := by rw [inv_mul_cancel, ← mul_assoc, (hidem c).eq]
    have h3 := congrArg μ h2
    rwa [map_mul, hμt, one_mul] at h3
  have hne : ∀ c, c ≠ 1 → μ (e c) = 0 := by
    intro c hc
    rw [hf c, ← map_mul, horth c 1 hc, map_zero]
  have h0 : μ (e 1) = 1 := by
    have := congrArg μ hsum
    rw [map_sum, map_one, Finset.sum_eq_single (1 : Γ) (fun b _ hb => hne b hb)
      (fun h => absurd (Finset.mem_univ _) h)] at this
    exact this

  obtain ⟨S, hS⟩ : ∃ S : Subalgebra R (Γ → R'), ∀ v, v ∈ S ↔ wcGTorDescCond R R' Γ e v := by
    have hmul : ∀ v w : Γ → R', wcGTorDescCond R R' Γ e v → wcGTorDescCond R R' Γ e w →
        wcGTorDescCond R R' Γ e (v * w) := by
      intro v w hv hw h
      have h1 : (1 : R') ⊗ₜ[R] (v h * w h) = ((1 : R') ⊗ₜ[R] v h) * ((1 : R') ⊗ₜ[R] w h) := by
        rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul]
      simp only [Pi.mul_apply]
      rw [h1, hv h, hw h, Finset.sum_mul_sum]
      refine Finset.sum_congr rfl (fun c _ => ?_)
      rw [Finset.sum_eq_single c]
      · rw [mul_mul_mul_comm, (hidem c).eq, Algebra.TensorProduct.tmul_mul_tmul, mul_one]
      · intro d _ hdc
        rw [mul_mul_mul_comm, horth c d (Ne.symm hdc), zero_mul]
      · intro hc; exact absurd (Finset.mem_univ c) hc
    have hadd : ∀ v w : Γ → R', wcGTorDescCond R R' Γ e v → wcGTorDescCond R R' Γ e w →
        wcGTorDescCond R R' Γ e (v + w) := by
      intro v w hv hw h
      simp only [Pi.add_apply, TensorProduct.tmul_add, TensorProduct.add_tmul, mul_add,
        Finset.sum_add_distrib]
      rw [hv h, hw h]
    have hzero : wcGTorDescCond R R' Γ e 0 := by
      intro h
      simp only [Pi.zero_apply, TensorProduct.tmul_zero, TensorProduct.zero_tmul, mul_zero,
        Finset.sum_const_zero]
    have halg : ∀ r : R, wcGTorDescCond R R' Γ e (algebraMap R (Γ → R') r) := by
      intro r h
      simp only [Pi.algebraMap_apply]
      rw [← Finset.sum_mul, hsum, one_mul, Algebra.algebraMap_eq_smul_one, TensorProduct.smul_tmul]
    have hone : wcGTorDescCond R R' Γ e 1 := by
      have := halg 1
      rwa [map_one] at this
    let S0 : Subalgebra R (Γ → R') :=
      { carrier := {v | wcGTorDescCond R R' Γ e v}
        mul_mem' := fun {v w} hv hw => hmul v w hv hw
        add_mem' := fun {v w} hv hw => hadd v w hv hw
        zero_mem' := hzero
        one_mem' := hone
        algebraMap_mem' := halg }
    exact ⟨S0, fun v => Iff.rfl⟩

  haveI : Module.Flat R R' := inferInstance
  obtain ⟨Φ, hΦ⟩ : ∃ Φ : (Γ → R') →ₗ[R] (Γ → TensorProduct R R' R'),
      ∀ v h, Φ v h = (1 : R') ⊗ₜ[R] v h - ∑ c, e c * (v (h * c⁻¹) ⊗ₜ[R] (1 : R')) := by
    refine ⟨{ toFun := fun v h => (1 : R') ⊗ₜ[R] v h - ∑ c, e c * (v (h * c⁻¹) ⊗ₜ[R] (1 : R'))
              map_add' := ?_
              map_smul' := ?_ }, fun v h => rfl⟩
    · intro v w
      funext h
      simp only [Pi.add_apply, TensorProduct.tmul_add, TensorProduct.add_tmul, mul_add,
        Finset.sum_add_distrib]
      abel
    · intro r v
      funext h
      simp only [Pi.smul_apply, RingHom.id_apply, smul_sub, Finset.smul_sum,
        TensorProduct.tmul_smul, ← TensorProduct.smul_tmul', mul_smul_comm]
  have hexact : Function.Exact S.val.toLinearMap Φ := by
    intro v
    rw [Set.mem_range]
    constructor
    · intro hv
      refine ⟨⟨v, (hS v).2 (fun h => ?_)⟩, rfl⟩
      have := congrFun hv h
      rw [hΦ, Pi.zero_apply, sub_eq_zero] at this
      exact this
    · rintro ⟨b, rfl⟩
      funext h
      rw [hΦ, Pi.zero_apply, sub_eq_zero]
      exact (hS _).1 b.2 h
  let P₁ := TensorProduct.piRight R R R' (fun _ : Γ => R')
  let P₂ := TensorProduct.piRight R R R' (fun _ : Γ => TensorProduct R R' R')
  have hP₁ : ∀ (r : R') (v : Γ → R') h, P₁ (r ⊗ₜ[R] v) h = r ⊗ₜ[R] v h := by
    intro r v h
    simp only [P₁, TensorProduct.piRight_apply, TensorProduct.piRightHom_tmul]
  have hP₂ : ∀ (r : R') (v : Γ → TensorProduct R R' R') h,
      P₂ (r ⊗ₜ[R] v) h = r ⊗ₜ[R] v h := by
    intro r v h
    simp only [P₂, TensorProduct.piRight_apply, TensorProduct.piRightHom_tmul]
  have hlt := Module.Flat.lTensor_exact R' hexact
  have hli := Module.Flat.lTensor_preserves_injective_linearMap (M := R') S.val.toLinearMap
    Subtype.val_injective
  have hPhi2 : ∀ y h, P₂ (LinearMap.lTensor R' Φ y) h =
      p13 (P₁ y h) - ∑ c, p23 (e c) * p12 (P₁ y (h * c⁻¹)) := by
    intro y h
    induction y using TensorProduct.induction_on with
    | zero =>
      simp only [map_zero, Pi.zero_apply, mul_zero, Finset.sum_const_zero, sub_zero]
    | tmul r v =>
      simp only [LinearMap.lTensor_tmul, hP₂, hP₁, hΦ, p13, p12, p23,
        Algebra.TensorProduct.map_tmul, AlgHom.id_apply,
        Algebra.TensorProduct.includeRight_apply, Algebra.TensorProduct.includeLeft_apply,
        Algebra.TensorProduct.tmul_mul_tmul, one_mul, TensorProduct.tmul_sub,
        TensorProduct.tmul_sum]
    | add x y hx hy =>
      simp only [map_add, Pi.add_apply, hx, hy, mul_add, Finset.sum_add_distrib]
      abel
  have hJrange0 : ∀ x : Γ → TensorProduct R R' R',
      (∀ h, p13 (x h) = ∑ c, p23 (e c) * p12 (x (h * c⁻¹))) →
      ∃ z, P₁ (LinearMap.lTensor R' S.val.toLinearMap z) = x := by
    intro x hx
    have h1 : LinearMap.lTensor R' Φ (P₁.symm x) = 0 := by
      apply P₂.injective
      rw [map_zero]
      funext h
      rw [hPhi2, LinearEquiv.apply_symm_apply, Pi.zero_apply, hx h, sub_self]
    obtain ⟨z, hz⟩ := (hlt (P₁.symm x)).1 h1
    exact ⟨z, by rw [hz, LinearEquiv.apply_symm_apply]⟩
  obtain ⟨J, hJdef⟩ : ∃ J : TensorProduct R R' ↥S →ₗ[R] (Γ → TensorProduct R R' R'),
      J = P₁.toLinearMap ∘ₗ LinearMap.lTensor R' S.val.toLinearMap := ⟨_, rfl⟩
  have hJt : ∀ (r : R') (b : ↥S) h, J (r ⊗ₜ[R] b) h = r ⊗ₜ[R] (b : Γ → R') h := by
    intro r b h
    rw [hJdef]
    show P₁ (LinearMap.lTensor R' S.val.toLinearMap (r ⊗ₜ[R] b)) h = _
    rw [LinearMap.lTensor_tmul]
    exact hP₁ r _ h
  have hJinj : Function.Injective J := by
    rw [hJdef]
    exact P₁.injective.comp hli
  have hJrange : ∀ x : Γ → TensorProduct R R' R',
      (∀ h, p13 (x h) = ∑ c, p23 (e c) * p12 (x (h * c⁻¹))) → ∃ z, J z = x := by
    intro x hx
    obtain ⟨z, hz⟩ := hJrange0 x hx
    exact ⟨z, by rw [hJdef]; exact hz⟩

  have hF1 : ∀ z h, wcGTorDescL R R' Γ (↥S) S.val z h = μ (J z h) := by
    intro z h
    induction z using TensorProduct.induction_on with
    | zero => simp only [map_zero, Pi.zero_apply]
    | tmul r b =>
      rw [hJt, hμt]
      simp [wcGTorDescL, Algebra.TensorProduct.lift_tmul]
    | add x y hx hy => simp only [map_add, Pi.add_apply, hx, hy]
  have hF2 : ∀ z h, J z h = ∑ c, e c * (μ (J z (h * c⁻¹)) ⊗ₜ[R] (1 : R')) := by
    intro z
    induction z using TensorProduct.induction_on with
    | zero =>
      intro h
      simp only [map_zero, Pi.zero_apply, TensorProduct.zero_tmul, mul_zero,
        Finset.sum_const_zero]
    | tmul r b =>
      intro h
      simp only [hJt, hμt]
      have hb : (1 : R') ⊗ₜ[R] (b : Γ → R') h =
          ∑ c, e c * ((b : Γ → R') (h * c⁻¹) ⊗ₜ[R] (1 : R')) := (hS _).1 b.2 h
      calc r ⊗ₜ[R] (b : Γ → R') h
          = (r ⊗ₜ[R] (1 : R')) * ((1 : R') ⊗ₜ[R] (b : Γ → R') h) := by
            rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
        _ = (r ⊗ₜ[R] (1 : R')) * ∑ c, e c * ((b : Γ → R') (h * c⁻¹) ⊗ₜ[R] (1 : R')) := by
            rw [hb]
        _ = ∑ c, e c * ((r * (b : Γ → R') (h * c⁻¹)) ⊗ₜ[R] (1 : R')) := by
            rw [Finset.mul_sum]
            refine Finset.sum_congr rfl (fun c _ => ?_)
            rw [mul_left_comm, Algebra.TensorProduct.tmul_mul_tmul, mul_one]
    | add x y hx hy =>
      intro h
      simp only [map_add, Pi.add_apply, TensorProduct.add_tmul, mul_add, Finset.sum_add_distrib]
      rw [← hx, ← hy]

  have hreidx : ∀ (A B V : Γ → TensorProduct R R' (TensorProduct R R' R')) (h : Γ),
      ∑ k, (∑ a, A a * B (a⁻¹ * k)) * V (h * k⁻¹) =
        ∑ c, B c * ∑ d, A d * V (h * c⁻¹ * d⁻¹) := by
    intro A B V h
    simp only [Finset.sum_mul, Finset.mul_sum]
    rw [Finset.sum_comm]
    conv_rhs => rw [Finset.sum_comm]
    refine Finset.sum_congr rfl (fun a _ => ?_)
    refine Fintype.sum_equiv (Equiv.mulLeft a⁻¹) _ _ (fun k => ?_)
    show A a * B (a⁻¹ * k) * V (h * k⁻¹) = B (a⁻¹ * k) * (A a * V (h * (a⁻¹ * k)⁻¹ * a⁻¹))
    rw [show h * (a⁻¹ * k)⁻¹ * a⁻¹ = h * k⁻¹ by group]
    ring
  have hU12 : ∀ a : R', p12 (a ⊗ₜ[R] (1 : R')) = a ⊗ₜ[R] (1 : TensorProduct R R' R') := by
    intro a
    simp only [p12, Algebra.TensorProduct.map_tmul, AlgHom.id_apply, map_one]
  have hU13 : ∀ a : R', p13 (a ⊗ₜ[R] (1 : R')) = a ⊗ₜ[R] (1 : TensorProduct R R' R') := by
    intro a
    simp only [p13, Algebra.TensorProduct.map_tmul, AlgHom.id_apply, map_one]
  have hL : Function.Bijective (wcGTorDescL R R' Γ (↥S) S.val) := by
    constructor
    · intro z z' hzz
      apply hJinj
      funext h
      rw [hF2 z h, hF2 z' h]
      refine Finset.sum_congr rfl (fun c _ => ?_)
      rw [← hF1, ← hF1, hzz]
    · intro u
      obtain ⟨z, hz⟩ := hJrange (fun h => ∑ c, e c * (u (h * c⁻¹) ⊗ₜ[R] (1 : R'))) (by
        intro h
        simp only [map_sum, map_mul, hU12, hU13, hcoc']
        exact hreidx (fun a => p12 (e a)) (fun a => p23 (e a))
          (fun k => u k ⊗ₜ[R] (1 : TensorProduct R R' R')) h)
      refine ⟨z, funext fun h => ?_⟩
      rw [hF1, hz]
      show μ (∑ c, e c * (u (h * c⁻¹) ⊗ₜ[R] (1 : R'))) = u h
      rw [map_sum, Finset.sum_eq_single (1 : Γ)]
      · simp only [map_mul, hμt, h0, inv_one, mul_one, one_mul]
      · intro b _ hb
        rw [map_mul, hne b hb, zero_mul]
      · intro hc; exact absurd (Finset.mem_univ _) hc

  have hsurj : Function.Surjective (PrimeSpectrum.comap (algebraMap R ↥S)) := by
    intro p
    obtain ⟨q, hq⟩ := PrimeSpectrum.comap_surjective_of_faithfullyFlat (A := R) (B := R') p
    let ψS : ↥S →ₐ[R] R' := (Pi.evalAlgHom R (fun _ : Γ => R') 1).comp S.val
    have hψS : (ψS : ↥S →+* R').comp (algebraMap R ↥S) = algebraMap R R' := ψS.comp_algebraMap
    refine ⟨PrimeSpectrum.comap (ψS : ↥S →+* R') q, ?_⟩
    rw [← hq]
    ext1
    simp only [PrimeSpectrum.comap_asIdeal, Ideal.comap_comap, hψS]
  let eL := AlgEquiv.ofBijective (wcGTorDescL R R' Γ (↥S) S.val) hL
  have hffR : (algebraMap R R').FaithfullyFlat :=
    RingHom.faithfullyFlat_algebraMap_iff.mpr inferInstance
  haveI : Algebra.Etale R' (TensorProduct R R' ↥S) := Algebra.Etale.of_equiv eL.symm
  haveI : Module.Finite R' (TensorProduct R R' ↥S) := Module.Finite.equiv eL.symm.toLinearEquiv
  have het : Algebra.Etale R ↥S := RingHom.etale_algebraMap.mp
    (RingHom.CodescendsAlong.algebraMap_tensorProduct _ R R' ↥S
      RingHom.Etale.codescendsAlong_faithfullyFlat hffR
      (RingHom.etale_algebraMap.mpr inferInstance))
  have hfin : Module.Finite R ↥S := RingHom.finite_algebraMap.mp
    (RingHom.CodescendsAlong.algebraMap_tensorProduct _ R R' ↥S
      RingHom.Finite.codescendsAlong_faithfullyFlat hffR
      (RingHom.finite_algebraMap.mpr inferInstance))
  refine ⟨↥S, inferInstance, inferInstance, S.val, Subtype.val_injective, fun x => ⟨?_, ?_⟩,
    hL, het, hfin, hsurj⟩
  · rintro ⟨b, rfl⟩
    exact (hS _).1 b.2
  · intro hx
    exact ⟨⟨x, (hS x).2 hx⟩, rfl⟩

theorem wc_gas_affine_cover : ∀ (U : Scheme.{u}) (ι : Type) (V : ι → Scheme.{u}) (v : ∀ j, V j ⟶ U), (∀ j, Etale (v j)) → ∀ (O : U.Opens) (hO : IsAffineOpen O), (∀ x : U, x ∈ O → ∃ j, x ∈ Set.range (v j)) → ∃ (n : ℕ) (W : Fin n → Scheme.{u}) (k : Fin n → ι) (w : ∀ m, W m ⟶ V (k m)) (φ : ∀ m, W m ⟶ Spec (.of Γ(U, O))), (∀ m, IsAffine (W m)) ∧ (∀ m, IsOpenImmersion (w m)) ∧ (∀ m, Etale (φ m)) ∧ (∀ m, φ m ≫ hO.fromSpec = w m ≫ v (k m)) ∧ (∀ x : Spec (.of Γ(U, O)), ∃ m y, φ m y = x) ∧ (∀ x : U, x ∈ O → ∃ m y, (w m ≫ v (k m)) y = x) :=
by
  intro U ι V v het O hO hcov
  classical
  have hpick : ∀ x : O, ∃ (j : ι) (A : (V j).Opens), IsAffineOpen A ∧
      (∀ y : V j, y ∈ A → v j y ∈ O) ∧ ∃ y : V j, y ∈ A ∧ v j y = x := by
    intro x
    obtain ⟨j, y, hy⟩ := hcov x x.2
    have hyO : y ∈ v j ⁻¹ᵁ O := by
      show v j y ∈ O
      rw [hy]
      exact x.2
    obtain ⟨A, hA, hyA, hAle⟩ := exists_isAffineOpen_mem_and_subset (x := y) (U := v j ⁻¹ᵁ O) hyO
    exact ⟨j, A, hA, fun y' hy' => hAle hy', y, hyA, hy⟩
  choose j A hA hAO hxA using hpick
  have hAO' : ∀ (x : O) (y : ((A x : (V (j x)).Opens) : Scheme.{u})),
      ((A x).ι ≫ v (j x)) y ∈ O := by
    intro x y
    have h1 : (A x).ι y = y.1 := by
      first
        | exact Scheme.Opens.ι_apply _ _
        | rfl
        | simp
    rw [Scheme.Hom.comp_apply, h1]
    exact hAO x y.1 y.2
  let T : O → Set U := fun x => Set.range ((A x).ι ≫ v (j x))
  have hTopen : ∀ x, IsOpen (T x) := by
    intro x
    haveI := het (j x)
    exact ((A x).ι ≫ v (j x)).isOpenMap.isOpen_range
  have hpt : ∀ (x : O) (p : ((A x : (V (j x)).Opens) : Scheme.{u})),
      ((A x).ι ≫ v (j x)) p = v (j x) p.1 := by
    intro x p
    have h1 : (A x).ι p = p.1 := by
      first
        | exact Scheme.Opens.ι_apply _ _
        | rfl
        | simp
    rw [Scheme.Hom.comp_apply, h1]
  have hTsub : (O : Set U) ⊆ ⋃ x, T x := by
    intro z hz
    obtain ⟨y, hyA, hy⟩ := hxA ⟨z, hz⟩
    let p : ((A ⟨z, hz⟩ : (V (j ⟨z, hz⟩)).Opens) : Scheme.{u}) := ⟨y, hyA⟩
    refine Set.mem_iUnion.mpr ⟨⟨z, hz⟩, ⟨p, ?_⟩⟩
    rw [hpt ⟨z, hz⟩ p]
    exact hy
  obtain ⟨t, ht⟩ := hO.isCompact.elim_finite_subcover T hTopen hTsub
  let idx : Fin t.card → O := fun m => (t.equivFin.symm m).1
  have hrange : ∀ m, Set.range ((A (idx m)).ι ≫ v (j (idx m))) ⊆ Set.range O.ι := by
    intro m
    rintro _ ⟨y, rfl⟩
    rw [Scheme.Opens.range_ι]
    exact hAO' (idx m) y
  let f : ∀ m, ((A (idx m) : (V (j (idx m))).Opens) : Scheme.{u}) ⟶ (O : Scheme.{u}) := fun m =>
    IsOpenImmersion.lift O.ι ((A (idx m)).ι ≫ v (j (idx m))) (hrange m)
  have hf : ∀ m, f m ≫ O.ι = (A (idx m)).ι ≫ v (j (idx m)) := fun m =>
    IsOpenImmersion.lift_fac _ _ _
  have hcov' : ∀ z : U, z ∈ O → ∃ m y, ((A (idx m)).ι ≫ v (j (idx m))) y = z := by
    intro z hz
    have := ht hz
    obtain ⟨x, hxt, hzx⟩ := Set.mem_iUnion₂.mp this
    obtain ⟨y, hy⟩ := hzx
    have key : ∀ x' : t, x' = ⟨x, hxt⟩ →
        ∃ y : ((A x'.1 : (V (j x'.1)).Opens) : Scheme.{u}), ((A x'.1).ι ≫ v (j x'.1)) y = z := by
      rintro _ rfl
      exact ⟨y, hy⟩
    refine ⟨t.equivFin ⟨x, hxt⟩, ?_⟩
    exact key _ (Equiv.symm_apply_apply _ _)
  refine ⟨t.card, fun m => (A (idx m) : Scheme.{u}), fun m => j (idx m), fun m => (A (idx m)).ι,
    fun m => f m ≫ hO.isoSpec.hom, fun m => hA (idx m), fun m => inferInstance, ?_, ?_, ?_, hcov'⟩
  · intro m
    haveI := het (j (idx m))
    have h1 : Etale (f m ≫ O.ι) := by rw [hf m]; infer_instance
    have h2 : Etale (f m) := MorphismProperty.of_postcomp (W := @Etale) (W' := @Etale) _ O.ι
      inferInstance h1
    infer_instance
  · intro m
    show (f m ≫ hO.isoSpec.hom) ≫ hO.fromSpec = (A (idx m)).ι ≫ v (j (idx m))
    rw [← hO.isoSpec_inv_ι, Category.assoc, Iso.hom_inv_id_assoc, hf m]
  · intro x
    let o : (O : Scheme.{u}) := hO.isoSpec.inv x
    obtain ⟨m, y, hy⟩ := hcov' (O.ι o) (by
      have : O.ι o ∈ Set.range O.ι := ⟨o, rfl⟩
      rwa [Scheme.Opens.range_ι] at this)
    refine ⟨m, y, ?_⟩
    have h1 : O.ι (f m y) = O.ι o := by
      rw [← Scheme.Hom.comp_apply, hf m, hy]
    have h2 : f m y = o := O.ι.isOpenEmbedding.injective h1
    show (f m ≫ hO.isoSpec.hom) y = x
    rw [Scheme.Hom.comp_apply, h2]
    show (hO.isoSpec.inv ≫ hO.isoSpec.hom) x = x
    rw [Iso.inv_hom_id]
    rfl

theorem wc_gas_pi_chart : ∀ (R : Type u) [CommRing R] (n : ℕ) (W : Fin n → Scheme.{u}) (φ : ∀ m, W m ⟶ Spec (.of R)), (∀ m, IsAffine (W m)) → (∀ m, Etale (φ m)) → (∀ x : Spec (.of R), ∃ m y, φ m y = x) → ∃ (R' : Type u) (_ : CommRing R') (_ : Algebra R R') (_ : Algebra.Etale R R') (j : ∀ m, W m ⟶ Spec (.of R')), Function.Surjective (PrimeSpectrum.comap (algebraMap R R')) ∧ (∀ m, IsOpenImmersion (j m)) ∧ (∀ (m m' : Fin n) (y : W m) (y' : W m'), j m y = j m' y' → m = m') ∧ (∀ x : Spec (.of R'), ∃ m y, j m y = x) ∧ (∀ m, j m ≫ Spec.map (CommRingCat.ofHom (algebraMap R R')) = φ m) :=
by
  intro R _ n W φ haff het hcov
  classical
  let A : Fin n → Type u := fun i => Γ(W i, ⊤)
  letI hAring : ∀ i, CommRing (A i) := fun i => inferInstanceAs (CommRing Γ(W i, ⊤))
  let ρ : ∀ i, R →+* A i := fun i =>
    ((Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫ Scheme.Hom.appTop (φ i)).hom
  have hρ : ∀ i, (ρ i).Etale := by
    intro i
    haveI := haff i
    have h1 : RingHom.Etale (Scheme.Hom.appTop (φ i)).hom :=
      HasRingHomProperty.appTop @Etale (φ i) (het i)
    have h2 : RingHom.Etale (Scheme.ΓSpecIso (CommRingCat.of R)).inv.hom :=
      RingHom.Etale.of_bijective (ConcreteCategory.bijective_of_isIso _)
    change RingHom.Etale ((Scheme.Hom.appTop (φ i)).hom.comp
      (Scheme.ΓSpecIso (CommRingCat.of R)).inv.hom)
    exact RingHom.Etale.stableUnderComposition _ _ h2 h1
  letI hAalg : ∀ i, Algebra R (A i) := fun i => (ρ i).toAlgebra
  haveI hAet : ∀ i, Algebra.Etale R (A i) := fun i => RingHom.etale_algebraMap.mp (hρ i)
  haveI hR'et : Algebra.Etale R (∀ i, A i) := inferInstance
  have hring : ∀ i, CommRingCat.ofHom (algebraMap R (∀ i, A i)) ≫
      CommRingCat.ofHom (Pi.evalRingHom A i) =
      (Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫ Scheme.Hom.appTop (φ i) := by
    intro i
    ext a
    rfl
  let j : ∀ i, W i ⟶ Spec (CommRingCat.of (∀ i, A i)) := fun i =>
    (@Scheme.isoSpec (W i) (haff i)).hom ≫ Spec.map (CommRingCat.ofHom (Pi.evalRingHom A i))
  have hkey : ∀ i, j i ≫ Spec.map (CommRingCat.ofHom (algebraMap R (∀ i, A i))) = φ i := by
    intro i
    have e1 : Spec.map (CommRingCat.ofHom (Pi.evalRingHom A i)) ≫
        Spec.map (CommRingCat.ofHom (algebraMap R (∀ i, A i))) =
        Spec.map (Scheme.Hom.appTop (φ i)) ≫
          Spec.map (Scheme.ΓSpecIso (CommRingCat.of R)).inv := by
      rw [← Spec.map_comp, hring i, Spec.map_comp]
      try rfl
    have hn : (W i).toSpecΓ ≫ Spec.map (Scheme.Hom.appTop (φ i)) =
        φ i ≫ (Spec (CommRingCat.of R)).toSpecΓ :=
      (Scheme.toSpecΓ_naturality (φ i)).symm
    have hiso : (@Scheme.isoSpec (W i) (haff i)).hom = (W i).toSpecΓ :=
      @Scheme.isoSpec_hom (W i) (haff i)
    change ((@Scheme.isoSpec (W i) (haff i)).hom ≫
      Spec.map (CommRingCat.ofHom (Pi.evalRingHom A i))) ≫
      Spec.map (CommRingCat.ofHom (algebraMap R (∀ i, A i))) = φ i
    rw [Category.assoc, e1, ← Category.assoc, hiso, hn]
    exact (Category.assoc _ _ _).trans ((congrArg (fun z => φ i ≫ z)
      (toSpecΓ_SpecMap_ΓSpecIso_inv (CommRingCat.of R))).trans (Category.comp_id _))
  have hopen : ∀ i, IsOpenImmersion (j i) := by
    intro i
    haveI := haff i
    show IsOpenImmersion ((W i).isoSpec.hom ≫ Spec.map (CommRingCat.ofHom (Pi.evalRingHom A i)))
    infer_instance
  have hdisj : ∀ (i i' : Fin n) (a : W i) (b : W i'), j i a = j i' b → i = i' := by
    intro i i' a b hab
    by_contra hii'
    haveI := haff i
    haveI := haff i'
    have h1 : (Pi.single i (1 : A i) : ∀ l, A l) ∉
        @PrimeSpectrum.asIdeal (∀ l, A l) _ (j i a) := by
      intro h
      change (Pi.single i (1 : A i) : ∀ l, A l) i ∈
        @PrimeSpectrum.asIdeal (A i) _ ((W i).isoSpec.hom a) at h
      rw [Pi.single_eq_same] at h
      exact (PrimeSpectrum.isPrime _).ne_top ((Ideal.eq_top_iff_one _).mpr h)
    have h2 : (Pi.single i (1 : A i) : ∀ l, A l) ∈
        @PrimeSpectrum.asIdeal (∀ l, A l) _ (j i' b) := by
      change (Pi.single i (1 : A i) : ∀ l, A l) i' ∈
        @PrimeSpectrum.asIdeal (A i') _ ((W i').isoSpec.hom b)
      rw [Pi.single_eq_of_ne (Ne.symm hii')]
      exact Ideal.zero_mem _
    rw [← hab] at h2
    exact h1 h2
  have hcov' : ∀ x : Spec (CommRingCat.of (∀ i, A i)), ∃ i y, j i y = x := by
    intro x
    obtain ⟨⟨i, p⟩, hp⟩ := (PrimeSpectrum.sigmaToPi_bijective A).2
      (show PrimeSpectrum (∀ l, A l) from x)
    haveI := haff i
    refine ⟨i, (W i).isoSpec.inv p, ?_⟩
    have e1 := Scheme.Hom.comp_apply (W i).isoSpec.inv (W i).isoSpec.hom p
    rw [Iso.inv_hom_id] at e1
    change Spec.map (CommRingCat.ofHom (Pi.evalRingHom A i))
      ((W i).isoSpec.hom ((W i).isoSpec.inv p)) = x
    rw [← e1, ← hp, PrimeSpectrum.sigmaToPi_apply]
    rfl
  have hsurj : Function.Surjective (PrimeSpectrum.comap (algebraMap R (∀ i, A i))) := by
    intro P
    obtain ⟨i, v, hv⟩ := hcov P
    refine ⟨j i v, ?_⟩
    rw [← hv, ← hkey i, Scheme.Hom.comp_apply]
    rfl
  exact ⟨∀ i, A i, inferInstance, inferInstance, inferInstance, j, hsurj, hopen, hdisj, hcov', hkey⟩

theorem wc_gas_lc_glue : ∀ (S : Scheme.{u}) (K : Type) (Y : K → Scheme.{u}) (ε : ∀ k, Y k ⟶ S), (∀ k, IsOpenImmersion (ε k)) → (∀ (k k' : K) (y : Y k) (y' : Y k'), ε k y = ε k' y' → k = k') → (∀ s : S, ∃ k y, ε k y = s) → ∀ (T : Type) (f : ∀ k, Y k → T), (∀ k, IsLocallyConstant (f k)) → ∃ F : S → T, IsLocallyConstant F ∧ ∀ k (y : Y k), F (ε k y) = f k y :=
by
  intro S K Y ε hopen hdisj hcov T f hf
  haveI : ∀ k, IsOpenImmersion (ε k) := hopen
  choose κ y hy using hcov
  have key : ∀ k₁ (y₁ : Y k₁) k (y' : Y k), ε k₁ y₁ = ε k y' → f k₁ y₁ = f k y' := by
    intro k₁ y₁ k y' h
    obtain rfl := hdisj k₁ k y₁ y' h
    have h2 : y₁ = y' := (ε _).isOpenEmbedding.injective h
    rw [h2]
  refine ⟨fun s => f (κ s) (y s), ?_, fun k y' => key _ _ _ _ (hy _)⟩
  rw [IsLocallyConstant.iff_exists_open]
  intro s
  obtain ⟨N, hN, hpN, hNc⟩ := (hf (κ s)).exists_open (y s)
  refine ⟨ε (κ s) '' N, (ε (κ s)).isOpenEmbedding.isOpenMap N hN, ⟨y s, hpN, hy s⟩, ?_⟩
  rintro s' ⟨q, hq, rfl⟩
  show f (κ _) (y _) = f (κ s) (y s)
  rw [key _ _ _ _ (hy _), hNc q hq]

theorem wc_gas_lc_link : (∀ (S : Scheme.{u}) (K : Type) (Y : K → Scheme.{u}) (ε : ∀ k, Y k ⟶ S), (∀ k, IsOpenImmersion (ε k)) → (∀ (k k' : K) (y : Y k) (y' : Y k'), ε k y = ε k' y' → k = k') → (∀ s : S, ∃ k y, ε k y = s) → ∀ (T : Type) (f : ∀ k, Y k → T), (∀ k, IsLocallyConstant (f k)) → ∃ F : S → T, IsLocallyConstant F ∧ ∀ k (y : Y k), F (ε k y) = f k y) → ∀ (U : Scheme.{u}) (G : Type) (ι : Type) (V : ι → Scheme.{u}) (v : ∀ j, V j ⟶ U) (g : ∀ i j, ↥(Limits.pullback (v i) (v j)) → G), (∀ i j, IsLocallyConstant (g i j)) → ∀ (R R' : Type u) [CommRing R] [CommRing R'] [Algebra R R'] (t : Spec (.of R) ⟶ U), Mono t → ∀ (n : ℕ) (W : Fin n → Scheme.{u}) (k : Fin n → ι) (w : ∀ m, W m ⟶ V (k m)) (j : ∀ m, W m ⟶ Spec (.of R')), (∀ m, IsOpenImmersion (j m)) → (∀ (m m' : Fin n) (y : W m) (y' : W m'), j m y = j m' y' → m = m') → (∀ x : Spec (.of R'), ∃ m y, j m y = x) → (∀ m, j m ≫ Spec.map (CommRingCat.ofHom (algebraMap R R')) ≫ t = w m ≫ v (k m)) → ∃ lc : LocallyConstant (PrimeSpectrum (TensorProduct R R' R')) G, wcGLcLink v g R R' w j lc :=
by
  intro hglue U G ι V v g hgloc R R' _ _ _ t ht n W k w j hjopen hjdisj hjcov hj
  classical
  let α : Spec (.of R') ⟶ Spec (.of R) := Spec.map (CommRingCat.ofHom (algebraMap R R'))
  let ϕ : ∀ m, W m ⟶ Spec (.of R) := fun m => j m ≫ α
  let Iso := pullbackSpecIso R R' R'
  let K := Fin n × Fin n
  let Y : K → Scheme.{u} := fun p => Limits.pullback (ϕ p.1) (ϕ p.2)
  let PM : ∀ p : K, Y p ⟶ Limits.pullback α α := fun p =>
    Limits.pullback.map (ϕ p.1) (ϕ p.2) α α (j p.1) (j p.2) (𝟙 _) (by simp [ϕ]) (by simp [ϕ])
  let ε : ∀ p : K, Y p ⟶ Spec (.of (TensorProduct R R' R')) := fun p => PM p ≫ Iso.hom
  have hPMfst : ∀ p : K, PM p ≫ Limits.pullback.fst α α = Limits.pullback.fst _ _ ≫ j p.1 :=
    fun p => Limits.pullback.lift_fst _ _ _
  have hPMsnd : ∀ p : K, PM p ≫ Limits.pullback.snd α α = Limits.pullback.snd _ _ ≫ j p.2 :=
    fun p => Limits.pullback.lift_snd _ _ _
  have hεopen : ∀ p, IsOpenImmersion (ε p) := by
    intro p
    have := hjopen p.1
    have := hjopen p.2
    have : IsOpenImmersion (PM p) := Scheme.pullback_map_isOpenImmersion _ _ _ _ _ _ _ _ _
    infer_instance
  have hIsoinj : Function.Injective Iso.hom := by
    intro x y hxy
    have h1 := congrArg Iso.inv hxy
    rwa [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, Iso.hom_inv_id] at h1
  have hεdisj : ∀ (p p' : K) (y : Y p) (y' : Y p'), ε p y = ε p' y' → p = p' := by
    intro p p' y y' h
    have h0 : PM p y = PM p' y' := hIsoinj h
    have h1 := congrArg (⇑(Limits.pullback.fst α α)) h0
    have h2 := congrArg (⇑(Limits.pullback.snd α α)) h0
    rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, hPMfst, hPMfst,
      Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at h1
    rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, hPMsnd, hPMsnd,
      Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at h2
    exact Prod.ext (hjdisj _ _ _ _ h1) (hjdisj _ _ _ _ h2)
  have hεcov : ∀ s : Spec (.of (TensorProduct R R' R')), ∃ p y, ε p y = s := by
    intro s
    let x := Iso.inv s
    obtain ⟨m1, y1, hy1⟩ := hjcov (Limits.pullback.fst α α x)
    obtain ⟨m2, y2, hy2⟩ := hjcov (Limits.pullback.snd α α x)
    have hx : x ∈ Set.range (PM (m1, m2)) := by
      rw [Scheme.Pullback.range_map]
      exact ⟨⟨y1, hy1⟩, ⟨y2, hy2⟩⟩
    obtain ⟨y, hy⟩ := hx
    refine ⟨(m1, m2), y, ?_⟩
    show Iso.hom (PM (m1, m2) y) = s
    rw [hy]
    show (Iso.inv ≫ Iso.hom) s = s
    rw [Iso.inv_hom_id]
    rfl
  have e₁ : ∀ m, ϕ m ≫ t = w m ≫ v (k m) := fun m => by
    simp only [ϕ, α, Category.assoc]; exact hj m
  let Ψ : ∀ p : K, Y p ⟶ Limits.pullback (v (k p.1)) (v (k p.2)) := fun p =>
    Limits.pullback.map (ϕ p.1) (ϕ p.2) (v (k p.1)) (v (k p.2)) (w p.1) (w p.2) t (e₁ p.1) (e₁ p.2)
  let f : ∀ p : K, Y p → G := fun p y => g (k p.1) (k p.2) (Ψ p y)
  have hf : ∀ p, IsLocallyConstant (f p) := fun p =>
    (hgloc _ _).comp_continuous (Ψ p).continuous
  obtain ⟨F, hF, hFε⟩ := hglue _ K Y ε hεopen hεdisj hεcov G f hf
  refine ⟨⟨F, hF⟩, ?_⟩
  intro m m' Z a b hab wz hw1 hw2 ζ
  have hab' : a ≫ ϕ m = b ≫ ϕ m' := by
    apply (cancel_mono t).1
    simp only [Category.assoc]
    rw [e₁ m, e₁ m']
    simpa only [Category.assoc] using hab
  let lP : Z ⟶ Y (m, m') := Limits.pullback.lift a b hab'
  have hIfst : Iso.inv ≫ Limits.pullback.fst α α = Spec.map (CommRingCat.ofHom
      (Algebra.TensorProduct.includeLeftRingHom : R' →+* TensorProduct R R' R')) := by
    rw [Iso.inv_comp_eq]
    exact (pullbackSpecIso_hom_fst R R' R').symm
  have hIsnd : Iso.inv ≫ Limits.pullback.snd α α = Spec.map (CommRingCat.ofHom
      (Algebra.TensorProduct.includeRight : R' →ₐ[R] TensorProduct R R' R').toRingHom) := by
    rw [Iso.inv_comp_eq]
    exact (pullbackSpecIso_hom_snd R R' R').symm
  have hP1 : PM (m, m') ≫ Limits.pullback.fst α α = Limits.pullback.fst (ϕ m) (ϕ m') ≫ j m :=
    hPMfst (m, m')
  have hP2 : PM (m, m') ≫ Limits.pullback.snd α α = Limits.pullback.snd (ϕ m) (ϕ m') ≫ j m' :=
    hPMsnd (m, m')
  have hwz : wz = lP ≫ ε (m, m') := by
    rw [← cancel_mono Iso.inv]
    apply Limits.pullback.hom_ext
    · calc (wz ≫ Iso.inv) ≫ Limits.pullback.fst α α = a ≫ j m := by
            rw [Category.assoc, hIfst, hw1]
        _ = lP ≫ Limits.pullback.fst (ϕ m) (ϕ m') ≫ j m := by
            simp only [lP, Limits.pullback.lift_fst_assoc]
        _ = ((lP ≫ ε (m, m')) ≫ Iso.inv) ≫ Limits.pullback.fst α α := by
            simp only [ε, Category.assoc, Iso.hom_inv_id_assoc, hP1]
    · calc (wz ≫ Iso.inv) ≫ Limits.pullback.snd α α = b ≫ j m' := by
            rw [Category.assoc, hIsnd, hw2]
        _ = lP ≫ Limits.pullback.snd (ϕ m) (ϕ m') ≫ j m' := by
            simp only [lP, Limits.pullback.lift_snd_assoc]
        _ = ((lP ≫ ε (m, m')) ≫ Iso.inv) ≫ Limits.pullback.snd α α := by
            simp only [ε, Category.assoc, Iso.hom_inv_id_assoc, hP2]
  have hΨ' : Ψ (m, m') = Limits.pullback.map (ϕ m) (ϕ m') (v (k m)) (v (k m')) (w m) (w m') t
      (e₁ m) (e₁ m') := rfl
  have hlΨ : lP ≫ Ψ (m, m') = Limits.pullback.lift (a ≫ w m) (b ≫ w m') hab := by
    rw [hΨ']
    have hm1 : Limits.pullback.map (ϕ m) (ϕ m') (v (k m)) (v (k m')) (w m) (w m') t
        (e₁ m) (e₁ m') ≫ Limits.pullback.fst (v (k m)) (v (k m')) =
        Limits.pullback.fst (ϕ m) (ϕ m') ≫ w m := Limits.pullback.lift_fst _ _ _
    have hm2 : Limits.pullback.map (ϕ m) (ϕ m') (v (k m)) (v (k m')) (w m) (w m') t
        (e₁ m) (e₁ m') ≫ Limits.pullback.snd (v (k m)) (v (k m')) =
        Limits.pullback.snd (ϕ m) (ϕ m') ≫ w m' := Limits.pullback.lift_snd _ _ _
    have hl1 : lP ≫ Limits.pullback.fst (ϕ m) (ϕ m') = a := Limits.pullback.lift_fst _ _ _
    have hl2 : lP ≫ Limits.pullback.snd (ϕ m) (ϕ m') = b := Limits.pullback.lift_snd _ _ _
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, hm1, ← Category.assoc, hl1, Limits.pullback.lift_fst]
    · rw [Category.assoc, hm2, ← Category.assoc, hl2, Limits.pullback.lift_snd]
  show F (wz ζ) = _
  rw [hwz, Scheme.Hom.comp_apply, hFε]
  show g (k m) (k m') (Ψ (m, m') (lP ζ)) = _
  rw [← Scheme.Hom.comp_apply, hlΨ]

theorem wc_gas_lc_cocycle : ∀ (U : Scheme.{u}) (G : Type) [Group G] (ι : Type) (V : ι → Scheme.{u}) (v : ∀ j, V j ⟶ U) (g : ∀ i j, ↥(Limits.pullback (v i) (v j)) → G), wcGCocycle v g → ∀ (R R' : Type u) [CommRing R] [CommRing R'] [Algebra R R'] (t : Spec (.of R) ⟶ U) (n : ℕ) (W : Fin n → Scheme.{u}) (k : Fin n → ι) (w : ∀ m, W m ⟶ V (k m)) (j : ∀ m, W m ⟶ Spec (.of R')), (∀ m, IsOpenImmersion (j m)) → (∀ x : Spec (.of R'), ∃ m y, j m y = x) → (∀ m, j m ≫ Spec.map (CommRingCat.ofHom (algebraMap R R')) ≫ t = w m ≫ v (k m)) → ∀ lc : LocallyConstant (PrimeSpectrum (TensorProduct R R' R')) G, wcGLcLink v g R R' w j lc → wcGLcCoc R R' G lc :=
by
  intro U G _ ι V v g hG R R' _ _ _ t n W k w j hjopen hjcov hj lc hlink P
  classical
  set p12 : TensorProduct R R' R' →+* TensorProduct R R' (TensorProduct R R' R') :=
    (Algebra.TensorProduct.map (AlgHom.id R R')
      (Algebra.TensorProduct.includeLeft : R' →ₐ[R] TensorProduct R R' R')).toRingHom with hp12
  set p13 : TensorProduct R R' R' →+* TensorProduct R R' (TensorProduct R R' R') :=
    (Algebra.TensorProduct.map (AlgHom.id R R')
      (Algebra.TensorProduct.includeRight : R' →ₐ[R] TensorProduct R R' R')).toRingHom with hp13
  set p23 : TensorProduct R R' R' →+* TensorProduct R R' (TensorProduct R R' R') :=
    (Algebra.TensorProduct.includeRight :
      TensorProduct R R' R' →ₐ[R] TensorProduct R R' (TensorProduct R R' R')).toRingHom with hp23
  let q1a : R' →ₐ[R] TensorProduct R R' (TensorProduct R R' R') :=
    Algebra.TensorProduct.includeLeft
  let q2a : R' →ₐ[R] TensorProduct R R' (TensorProduct R R' R') :=
    (Algebra.TensorProduct.includeRight :
      TensorProduct R R' R' →ₐ[R] TensorProduct R R' (TensorProduct R R' R')).comp
      Algebra.TensorProduct.includeLeft
  let q3a : R' →ₐ[R] TensorProduct R R' (TensorProduct R R' R') :=
    (Algebra.TensorProduct.includeRight :
      TensorProduct R R' R' →ₐ[R] TensorProduct R R' (TensorProduct R R' R')).comp
      Algebra.TensorProduct.includeRight
  have r12L : p12.comp (Algebra.TensorProduct.includeLeftRingHom : R' →+* TensorProduct R R' R') =
      q1a.toRingHom := by
    ext x; simp [hp12, q1a]
  have r12R : p12.comp (Algebra.TensorProduct.includeRight :
      R' →ₐ[R] TensorProduct R R' R').toRingHom = q2a.toRingHom := by
    ext x; simp [hp12, q2a]
  have r13L : p13.comp (Algebra.TensorProduct.includeLeftRingHom : R' →+* TensorProduct R R' R') =
      q1a.toRingHom := by
    ext x; simp [hp13, q1a]
  have r13R : p13.comp (Algebra.TensorProduct.includeRight :
      R' →ₐ[R] TensorProduct R R' R').toRingHom = q3a.toRingHom := by
    ext x; simp [hp13, q3a]
  have r23L : p23.comp (Algebra.TensorProduct.includeLeftRingHom : R' →+* TensorProduct R R' R') =
      q2a.toRingHom := by
    ext x; simp [hp23, q2a]
  have r23R : p23.comp (Algebra.TensorProduct.includeRight :
      R' →ₐ[R] TensorProduct R R' R').toRingHom = q3a.toRingHom := by
    ext x; simp [hp23, q3a]
  have hS : ∀ {A B C : Type u} [CommRing A] [CommRing B] [CommRing C] (f : A →+* B)
      (g : B →+* C), Spec.map (CommRingCat.ofHom g) ≫ Spec.map (CommRingCat.ofHom f) =
        Spec.map (CommRingCat.ofHom (g.comp f)) := by
    intro A B C _ _ _ f g
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
  have hq : ∀ qa : R' →ₐ[R] TensorProduct R R' (TensorProduct R R' R'),
      Spec.map (CommRingCat.ofHom qa.toRingHom) ≫ Spec.map (CommRingCat.ofHom (algebraMap R R')) =
        Spec.map (CommRingCat.ofHom (algebraMap R (TensorProduct R R' (TensorProduct R R' R')))) := by
    intro qa
    rw [hS, AlgHom.toRingHom_eq_coe, AlgHom.comp_algebraMap]
  obtain ⟨m1, y1, hy1⟩ := hjcov (Spec.map (CommRingCat.ofHom q1a.toRingHom) P)
  obtain ⟨m2, y2, hy2⟩ := hjcov (Spec.map (CommRingCat.ofHom q2a.toRingHom) P)
  obtain ⟨m3, y3, hy3⟩ := hjcov (Spec.map (CommRingCat.ofHom q3a.toRingHom) P)
  haveI := hjopen m1
  haveI := hjopen m2
  haveI := hjopen m3
  let Uo : (Spec (.of (TensorProduct R R' (TensorProduct R R' R')))).Opens :=
    Spec.map (CommRingCat.ofHom q1a.toRingHom) ⁻¹ᵁ (j m1).opensRange ⊓
      Spec.map (CommRingCat.ofHom q2a.toRingHom) ⁻¹ᵁ (j m2).opensRange ⊓
      Spec.map (CommRingCat.ofHom q3a.toRingHom) ⁻¹ᵁ (j m3).opensRange
  have hUo : ∀ x, x ∈ Uo →
      (Spec.map (CommRingCat.ofHom q1a.toRingHom) x ∈ Set.range (j m1) ∧
        Spec.map (CommRingCat.ofHom q2a.toRingHom) x ∈ Set.range (j m2)) ∧
      Spec.map (CommRingCat.ofHom q3a.toRingHom) x ∈ Set.range (j m3) := fun x hx => hx
  have hP : (P : Spec (.of (TensorProduct R R' (TensorProduct R R' R')))) ∈ Uo :=
    show (Spec.map (CommRingCat.ofHom q1a.toRingHom) P ∈ Set.range (j m1) ∧
        Spec.map (CommRingCat.ofHom q2a.toRingHom) P ∈ Set.range (j m2)) ∧
      Spec.map (CommRingCat.ofHom q3a.toRingHom) P ∈ Set.range (j m3) from
      ⟨⟨⟨y1, hy1⟩, ⟨y2, hy2⟩⟩, ⟨y3, hy3⟩⟩
  have hr : ∀ (q : Spec (.of (TensorProduct R R' (TensorProduct R R' R'))) ⟶ Spec (.of R'))
      (m : Fin n), (∀ x, x ∈ Uo → q x ∈ Set.range (j m)) →
      Set.range (Uo.ι ≫ q) ⊆ Set.range (j m) := by
    intro q m h
    rintro _ ⟨z, rfl⟩
    rw [Scheme.Hom.comp_apply]
    exact h _ z.2
  let a1 := IsOpenImmersion.lift (j m1) (Uo.ι ≫ Spec.map (CommRingCat.ofHom q1a.toRingHom))
    (hr _ m1 (fun x hx => (hUo x hx).1.1))
  let a2 := IsOpenImmersion.lift (j m2) (Uo.ι ≫ Spec.map (CommRingCat.ofHom q2a.toRingHom))
    (hr _ m2 (fun x hx => (hUo x hx).1.2))
  let a3 := IsOpenImmersion.lift (j m3) (Uo.ι ≫ Spec.map (CommRingCat.ofHom q3a.toRingHom))
    (hr _ m3 (fun x hx => (hUo x hx).2))
  have ha1 : a1 ≫ j m1 = Uo.ι ≫ Spec.map (CommRingCat.ofHom q1a.toRingHom) :=
    IsOpenImmersion.lift_fac _ _ _
  have ha2 : a2 ≫ j m2 = Uo.ι ≫ Spec.map (CommRingCat.ofHom q2a.toRingHom) :=
    IsOpenImmersion.lift_fac _ _ _
  have ha3 : a3 ≫ j m3 = Uo.ι ≫ Spec.map (CommRingCat.ofHom q3a.toRingHom) :=
    IsOpenImmersion.lift_fac _ _ _
  have hD : ∀ (m : Fin n) (a : (Uo : Scheme.{u}) ⟶ W m)
      (qa : R' →ₐ[R] TensorProduct R R' (TensorProduct R R' R')),
      a ≫ j m = Uo.ι ≫ Spec.map (CommRingCat.ofHom qa.toRingHom) →
      (a ≫ w m) ≫ v (k m) = Uo.ι ≫ Spec.map (CommRingCat.ofHom
        (algebraMap R (TensorProduct R R' (TensorProduct R R' R')))) ≫ t := by
    intro m a qa ha
    rw [Category.assoc, ← hj m, ← Category.assoc, ha]
    simp only [Category.assoc]
    rw [reassoc_of% (hq qa)]
  have hab12 := (hD m1 a1 q1a ha1).trans (hD m2 a2 q2a ha2).symm
  have hab13 := (hD m1 a1 q1a ha1).trans (hD m3 a3 q3a ha3).symm
  have hab23 := (hD m2 a2 q2a ha2).trans (hD m3 a3 q3a ha3).symm
  let ζ : (Uo : Scheme.{u}) := ⟨P, hP⟩
  have hev : ∀ f : TensorProduct R R' R' →+* TensorProduct R R' (TensorProduct R R' R'),
      (Uo.ι ≫ Spec.map (CommRingCat.ofHom f)) ζ = PrimeSpectrum.comap f P := by
    intro f
    rw [Scheme.Hom.comp_apply, Spec.map_apply]
    rfl
  have hL12 := hlink m1 m2 Uo a1 a2 hab12 (Uo.ι ≫ Spec.map (CommRingCat.ofHom p12))
    (by rw [Category.assoc, hS, r12L, ha1]) (by rw [Category.assoc, hS, r12R, ha2]) ζ
  have hL13 := hlink m1 m3 Uo a1 a3 hab13 (Uo.ι ≫ Spec.map (CommRingCat.ofHom p13))
    (by rw [Category.assoc, hS, r13L, ha1]) (by rw [Category.assoc, hS, r13R, ha3]) ζ
  have hL23 := hlink m2 m3 Uo a2 a3 hab23 (Uo.ι ≫ Spec.map (CommRingCat.ofHom p23))
    (by rw [Category.assoc, hS, r23L, ha2]) (by rw [Category.assoc, hS, r23R, ha3]) ζ
  have c := hG (k m1) (k m2) (k m3) Uo (a1 ≫ w m1) (a2 ≫ w m2) (a3 ≫ w m3) hab12 hab23 hab13 ζ
  rw [hev] at hL12 hL13 hL23
  rw [hL12, hL13, hL23]
  exact c

theorem wc_gas_idem_cocycle : ∀ (R R' : Type u) [CommRing R] [CommRing R'] [Algebra R R'] (G : Type) [Group G] [Fintype G] (lc : LocallyConstant (PrimeSpectrum (TensorProduct R R' R')) G), wcGLcCoc R R' G lc → ∃ e : G → TensorProduct R R' R', wcGTorDescCocyc R R' G e ∧ ∀ (c : G) (P : PrimeSpectrum (TensorProduct R R' R')), e c ∉ P.asIdeal ↔ lc P = c :=
by
  intro R R' _ _ _ G _ _ lc hcoc
  classical

  have s1 : ∀ (A : Type u) [CommRing A] (x y : A), IsIdempotentElem x → IsIdempotentElem y →
      (∀ P : PrimeSpectrum A, x ∉ P.asIdeal ↔ y ∉ P.asIdeal) → x = y := by
    intro A _ x y hx hy H
    have key : ∀ x y : A, IsIdempotentElem x → IsIdempotentElem y →
        (∀ P : PrimeSpectrum A, x ∉ P.asIdeal → y ∉ P.asIdeal) → x * (1 - y) = 0 := by
      intro x y hx hy H
      apply IsIdempotentElem.eq_zero_of_isNilpotent (hx.mul hy.one_sub)
      rw [nilpotent_iff_mem_prime]
      intro J hJ
      by_cases hxJ : x ∈ J
      · exact J.mul_mem_right _ hxJ
      · have hyJ : y ∉ J := H ⟨J, hJ⟩ hxJ
        have h0 : y * (1 - y) ∈ J := by
          rw [mul_sub, mul_one, hy.eq, sub_self]; exact J.zero_mem
        rcases hJ.mem_or_mem h0 with h | h
        · exact absurd h hyJ
        · exact J.mul_mem_left _ h
    have h1 := key x y hx hy (fun P => (H P).1)
    have h2 := key y x hy hx (fun P => (H P).2)
    have e1 : x = x * y := by rw [mul_sub, mul_one, sub_eq_zero] at h1; exact h1
    have e2 : y = y * x := by rw [mul_sub, mul_one, sub_eq_zero] at h2; exact h2
    calc x = x * y := e1
      _ = y * x := mul_comm _ _
      _ = y := e2.symm

  have s2 : ∀ (A : Type u) [CommRing A] (x : G → A),
      (∀ a b, a ≠ b → x a * x b = 0) → ∀ P : PrimeSpectrum A,
      ((∑ a, x a) ∉ P.asIdeal ↔ ∃ a, x a ∉ P.asIdeal) := by
    intro A _ x hx P
    constructor
    · intro h
      by_contra hc
      push_neg at hc
      exact h (Ideal.sum_mem _ (fun a _ => hc a))
    · rintro ⟨a0, ha0⟩ hs
      apply ha0
      have h1 : x a0 * ∑ a, x a = x a0 * x a0 := by
        rw [Finset.mul_sum, Fintype.sum_eq_single a0]
        intro a ha
        exact hx a0 a (Ne.symm ha)
      have h2 : x a0 * x a0 ∈ P.asIdeal := by
        rw [← h1]; exact P.asIdeal.mul_mem_left _ hs
      rcases P.isPrime.mem_or_mem h2 with h | h <;> exact h

  have s4 : ∀ (A : Type u) [CommRing A] (x : G → A), (∀ a, IsIdempotentElem (x a)) →
      (∀ a b, a ≠ b → x a * x b = 0) → IsIdempotentElem (∑ a, x a) := by
    intro A _ x hi ho
    exact (OrthogonalIdempotents.mk hi (fun a b hab => ho a b hab)).isIdempotentElem_sum

  have s3 : ∀ c : G, ∃ x : TensorProduct R R' R', IsIdempotentElem x ∧
      ∀ P : PrimeSpectrum (TensorProduct R R' R'), x ∉ P.asIdeal ↔ lc P = c := by
    intro c
    have hS : IsClopen {P | lc P = c} := lc.isLocallyConstant.isClopen_fiber c
    let C : TopologicalSpace.Clopens (PrimeSpectrum (TensorProduct R R' R')) := ⟨_, hS⟩
    let E := PrimeSpectrum.isIdempotentElemEquivClopens.symm C
    refine ⟨E.1, E.2, fun P => ?_⟩
    have h1 : (PrimeSpectrum.isIdempotentElemEquivClopens E).toOpens =
        PrimeSpectrum.basicOpen E.1 :=
      PrimeSpectrum.isIdempotentElemEquivClopens_apply_toOpens E
    have h2 : PrimeSpectrum.isIdempotentElemEquivClopens E = C := OrderIso.apply_symm_apply _ _
    rw [h2] at h1
    have h3 : P ∈ C.toOpens ↔ P ∈ PrimeSpectrum.basicOpen E.1 := by rw [h1]
    rw [PrimeSpectrum.mem_basicOpen] at h3
    exact h3.symm
  choose e he hmem using s3

  have hortho : ∀ c c', c ≠ c' → e c * e c' = 0 := by
    intro c c' hcc'
    apply s1 _ _ _ ((he c).mul (he c')) IsIdempotentElem.zero
    intro P
    constructor
    · intro h
      exfalso
      have hc : e c ∉ P.asIdeal := fun h' => h (P.asIdeal.mul_mem_right _ h')
      have hc' : e c' ∉ P.asIdeal := fun h' => h (P.asIdeal.mul_mem_left _ h')
      exact hcc' (((hmem c P).1 hc).symm.trans ((hmem c' P).1 hc'))
    · intro h
      exact absurd P.asIdeal.zero_mem h

  have hsum : ∑ c, e c = 1 := by
    apply s1 _ _ _ (s4 _ e he hortho) IsIdempotentElem.one
    intro P
    constructor
    · intro _ h
      exact P.isPrime.ne_top ((Ideal.eq_top_iff_one _).2 h)
    · intro _
      exact (s2 _ e hortho P).2 ⟨lc P, (hmem (lc P) P).2 rfl⟩

  have gen : ∀ (φ13 φ12 φ23 : TensorProduct R R' R' →ₐ[R] TensorProduct R R' (TensorProduct R R' R')),
      (∀ P : PrimeSpectrum (TensorProduct R R' (TensorProduct R R' R')),
        lc (PrimeSpectrum.comap φ13.toRingHom P) =
          lc (PrimeSpectrum.comap φ12.toRingHom P) * lc (PrimeSpectrum.comap φ23.toRingHom P)) →
      ∀ c, φ13 (e c) = ∑ a, φ12 (e a) * φ23 (e (a⁻¹ * c)) := by
    intro φ13 φ12 φ23 H c
    have ht_idem : ∀ a, IsIdempotentElem (φ12 (e a) * φ23 (e (a⁻¹ * c))) :=
      fun a => ((he a).map φ12).mul ((he (a⁻¹ * c)).map φ23)
    have ht_orth : ∀ a b, a ≠ b →
        (φ12 (e a) * φ23 (e (a⁻¹ * c))) * (φ12 (e b) * φ23 (e (b⁻¹ * c))) = 0 := by
      intro a b hab
      rw [mul_mul_mul_comm, ← map_mul, hortho a b hab, map_zero, zero_mul]
    apply s1 _ _ _ ((he c).map φ13)
      (s4 _ (fun a => φ12 (e a) * φ23 (e (a⁻¹ * c))) ht_idem ht_orth)
    intro P
    have hprod : ∀ a, φ12 (e a) * φ23 (e (a⁻¹ * c)) ∉ P.asIdeal ↔
        (lc (PrimeSpectrum.comap φ12.toRingHom P) = a ∧
          lc (PrimeSpectrum.comap φ23.toRingHom P) = a⁻¹ * c) := by
      intro a
      constructor
      · intro h
        exact ⟨(hmem a (PrimeSpectrum.comap φ12.toRingHom P)).1
            (fun h' => h (P.asIdeal.mul_mem_right _ h')),
          (hmem (a⁻¹ * c) (PrimeSpectrum.comap φ23.toRingHom P)).1
            (fun h' => h (P.asIdeal.mul_mem_left _ h'))⟩
      · rintro ⟨h1, h2⟩ h
        have g1 : φ12 (e a) ∉ P.asIdeal := (hmem a (PrimeSpectrum.comap φ12.toRingHom P)).2 h1
        have g2 : φ23 (e (a⁻¹ * c)) ∉ P.asIdeal :=
          (hmem (a⁻¹ * c) (PrimeSpectrum.comap φ23.toRingHom P)).2 h2
        rcases P.isPrime.mem_or_mem h with h' | h'
        · exact g1 h'
        · exact g2 h'
    refine Iff.trans ?_ (s2 _ (fun a => φ12 (e a) * φ23 (e (a⁻¹ * c))) ht_orth P).symm
    refine Iff.trans (hmem c (PrimeSpectrum.comap φ13.toRingHom P)) ?_
    rw [H P]
    constructor
    · intro h
      exact ⟨lc (PrimeSpectrum.comap φ12.toRingHom P), (hprod _).2 ⟨rfl, eq_inv_mul_of_mul_eq h⟩⟩
    · rintro ⟨a, ha⟩
      obtain ⟨h1, h2⟩ := (hprod a).1 ha
      rw [h1, h2]
      exact mul_inv_cancel_left a c
  exact ⟨e, ⟨he, hortho, hsum, fun c => gen _ _ _ hcoc c⟩, hmem⟩

theorem wc_gas_copies_cover : ∀ (R R' B : Type u) [CommRing R] [CommRing R'] [CommRing B] [Algebra R R'] [Algebra R B] (G : Type) [Finite G] (ι : B →ₐ[R] (G → R')), Function.Surjective (PrimeSpectrum.comap (algebraMap R R')) → Function.Bijective (wcGTorDescL R R' G B ι) → ∀ P : Spec (.of B), ∃ (γ : G) (Q : Spec (.of R')), Spec.map (CommRingCat.ofHom ((Pi.evalRingHom (fun _ : G => R') γ).comp ι.toRingHom)) Q = P :=
by
  intro R R' B _ _ _ _ _ G _ ι hsurj hbij P
  classical
  obtain ⟨x₀, hx⟩ := hsurj (PrimeSpectrum.comap (algebraMap R B) P)
  let x : Spec (.of R') := x₀
  have hx' : (Spec.map (CommRingCat.ofHom (algebraMap R R'))) x =
      (Spec.map (CommRingCat.ofHom (algebraMap R B))) P := by
    rw [Spec.map_apply, Spec.map_apply]
    exact hx
  obtain ⟨z, -, hz⟩ := Scheme.Pullback.exists_preimage_pullback x P hx'
  let Q' : Spec (.of (TensorProduct R R' B)) := (pullbackSpecIso R R' B).hom z
  have hE1 : (Spec.map (CommRingCat.ofHom
      (Algebra.TensorProduct.includeRight : B →ₐ[R] TensorProduct R R' B).toRingHom)) Q' = P := by
    rw [← hz, ← pullbackSpecIso_hom_snd R R' B, Scheme.Hom.comp_apply]
    rfl
  have hP : ∀ b : B, b ∈ P.asIdeal ↔ ((1 : R') ⊗ₜ[R] b) ∈ Q'.asIdeal := by
    intro b
    rw [← hE1, Spec.map_apply]
    rfl
  let e := RingEquiv.ofBijective (wcGTorDescL R R' G B ι) hbij
  have hL : ∀ b : B, wcGTorDescL R R' G B ι ((1 : R') ⊗ₜ[R] b) = ι b := by
    intro b
    simp only [wcGTorDescL, Algebra.TensorProduct.lift_tmul, map_one, one_mul]
  have he : ∀ b : B, e.symm (ι b) = (1 : R') ⊗ₜ[R] b := by
    intro b
    rw [RingEquiv.symm_apply_eq]
    exact (hL b).symm
  obtain ⟨γ, Q, hQ⟩ := PrimeSpectrum.exists_comap_evalRingHom_eq (R := fun _ : G => R')
    (PrimeSpectrum.comap (e.symm : (G → R') →+* TensorProduct R R' B) Q')
  let Q₁ : Spec (.of R') := Q
  refine ⟨γ, Q₁, ?_⟩
  rw [Spec.map_apply]
  apply PrimeSpectrum.ext
  ext b
  rw [hP b, ← he b]
  have key : (ι b) ∈ (PrimeSpectrum.comap (e.symm : (G → R') →+* TensorProduct R R' B)
      Q').asIdeal ↔ ι b γ ∈ Q.asIdeal := by
    rw [← hQ]
    rfl
  exact key.symm

theorem wc_gas_overlap_unit : ∀ (R R' B : Type u) [CommRing R] [CommRing R'] [CommRing B] [Algebra R R'] [Algebra R B] (G : Type) [Group G] [Fintype G] (e : G → TensorProduct R R' R') (ι : B →ₐ[R] (G → R')), (∀ b, wcGTorDescCond R R' G e (ι b)) → Function.Surjective (wcGTorDescL R R' G B ι) → ∀ (Z : Scheme.{u}) (z1 z2 : Z ⟶ Spec (.of R')) (wz : Z ⟶ Spec (.of (TensorProduct R R' R'))), wz ≫ Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom : R' →+* TensorProduct R R' R')) = z1 → wz ≫ Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeRight : R' →ₐ[R] TensorProduct R R' R').toRingHom) = z2 → ∀ γ γ' : G, z1 ≫ Spec.map (CommRingCat.ofHom ((Pi.evalRingHom (fun _ : G => R') γ).comp ι.toRingHom)) = z2 ≫ Spec.map (CommRingCat.ofHom ((Pi.evalRingHom (fun _ : G => R') γ').comp ι.toRingHom)) → ∀ ζ : Z, e (γ⁻¹ * γ') ∉ @PrimeSpectrum.asIdeal (TensorProduct R R' R') _ (wz ζ) :=
by
  intro R R' B _ _ _ _ _ G _ _ e ι hDC hL Z z1 z2 wz hw1 hw2 γ γ' hz
  classical

  have hN : ∀ {C D : CommRingCat.{u}} (f : C ⟶ D) (v : Z ⟶ Spec D),
      (Scheme.ΓSpecIso C).inv ≫ (v ≫ Spec.map f).appTop =
        f ≫ (Scheme.ΓSpecIso D).inv ≫ v.appTop := by
    intro C D f v
    rw [Scheme.Hom.comp_appTop, ← Category.assoc, ← Scheme.ΓSpecIso_inv_naturality,
      Category.assoc]

  let φ : TensorProduct R R' R' →+* Γ(Z, ⊤) :=
    ((Scheme.ΓSpecIso (.of (TensorProduct R R' R'))).inv ≫ wz.appTop).hom
  let ψ1 : R' →+* Γ(Z, ⊤) := ((Scheme.ΓSpecIso (.of R')).inv ≫ z1.appTop).hom
  let ψ2 : R' →+* Γ(Z, ⊤) := ((Scheme.ΓSpecIso (.of R')).inv ≫ z2.appTop).hom
  have hψ1 : ∀ x : R', φ (x ⊗ₜ[R] 1) = ψ1 x := by
    intro x
    have e0 := hN (CommRingCat.ofHom
      (Algebra.TensorProduct.includeLeftRingHom : R' →+* TensorProduct R R' R')) wz
    rw [hw1] at e0
    exact (congrArg (fun k => k.hom x) e0).symm
  have hψ2 : ∀ y : R', φ ((1 : R') ⊗ₜ[R] y) = ψ2 y := by
    intro y
    have e0 := hN (CommRingCat.ofHom
      (Algebra.TensorProduct.includeRight : R' →ₐ[R] TensorProduct R R' R').toRingHom) wz
    rw [hw2] at e0
    exact (congrArg (fun k => k.hom y) e0).symm
  have hφ : ∀ x y : R', φ (x ⊗ₜ[R] y) = ψ1 x * ψ2 y := by
    intro x y
    have : x ⊗ₜ[R] y = (x ⊗ₜ[R] (1 : R')) * ((1 : R') ⊗ₜ[R] y) := by
      rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
    rw [this, map_mul, hψ1, hψ2]
  have hψ : ∀ b : B, ψ1 (ι b γ) = ψ2 (ι b γ') := by
    intro b
    have e1 := hN (CommRingCat.ofHom
      ((Pi.evalRingHom (fun _ : G => R') γ).comp ι.toRingHom)) z1
    have e2 := hN (CommRingCat.ofHom
      ((Pi.evalRingHom (fun _ : G => R') γ').comp ι.toRingHom)) z2
    rw [hz, e2] at e1
    exact (congrArg (fun k => k.hom b) e1).symm

  have hLt : ∀ (r : R') (b : B) (h : G), wcGTorDescL R R' G B ι (r ⊗ₜ[R] b) h = r * ι b h := by
    intro r b h
    simp [wcGTorDescL, Algebra.TensorProduct.lift_tmul, Algebra.ofId_apply]
  have hK : ∀ y : TensorProduct R R' B,
      φ (∑ d, e d * ((wcGTorDescL R R' G B ι y) (γ' * d⁻¹) ⊗ₜ[R] (1 : R'))) =
        ψ1 ((wcGTorDescL R R' G B ι y) γ) := by
    intro y
    induction y using TensorProduct.induction_on with
    | zero => simp
    | tmul r b =>
      simp only [hLt]
      have e0 : ∑ d, e d * ((r * ι b (γ' * d⁻¹)) ⊗ₜ[R] (1 : R')) =
          (r ⊗ₜ[R] (1 : R')) * ∑ d, e d * (ι b (γ' * d⁻¹) ⊗ₜ[R] (1 : R')) := by
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl fun d _ => ?_
        rw [show (r * ι b (γ' * d⁻¹)) ⊗ₜ[R] (1 : R') =
            (r ⊗ₜ[R] (1 : R')) * (ι b (γ' * d⁻¹) ⊗ₜ[R] (1 : R')) by
          rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul]]
        ring
      rw [e0, ← hDC b γ', Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul, hφ, ← hψ,
        map_mul]
    | add y1 y2 ih1 ih2 =>
      simp only [map_add, Pi.add_apply, TensorProduct.add_tmul, mul_add,
        Finset.sum_add_distrib]
      rw [ih1, ih2]

  have hone : φ (e (γ⁻¹ * γ')) = 1 := by
    obtain ⟨y, hy⟩ := hL (Pi.single γ 1)
    have e0 := hK y
    rw [hy, Pi.single_eq_same, map_one] at e0
    rw [← e0]
    congr 1
    rw [Finset.sum_eq_single (γ⁻¹ * γ')]
    · have hγ : γ' * (γ⁻¹ * γ')⁻¹ = γ := by group
      rw [hγ, Pi.single_eq_same, ← Algebra.TensorProduct.one_def, mul_one]
    · intro d _ hd
      have hne : γ' * d⁻¹ ≠ γ := by
        intro hc
        apply hd
        rw [← hc]
        group
      rw [Pi.single_eq_of_ne hne, TensorProduct.zero_tmul, mul_zero]
    · intro hc
      exact absurd (Finset.mem_univ _) hc
  have hunit : IsUnit ((Scheme.Hom.app wz ⊤) ((Scheme.ΓSpecIso (.of (TensorProduct R R' R'))).inv
      (e (γ⁻¹ * γ')))) := by
    have : (Scheme.Hom.app wz ⊤) ((Scheme.ΓSpecIso (.of (TensorProduct R R' R'))).inv
        (e (γ⁻¹ * γ'))) = φ (e (γ⁻¹ * γ')) := rfl
    rw [this, hone]
    exact isUnit_one

  intro ζ
  have hpre := Scheme.Hom.preimage_basicOpen wz (U := ⊤)
    ((Scheme.ΓSpecIso (.of (TensorProduct R R' R'))).inv (e (γ⁻¹ * γ')))
  have hmem : ζ ∈ wz ⁻¹ᵁ (Spec (.of (TensorProduct R R' R'))).basicOpen
      ((Scheme.ΓSpecIso (.of (TensorProduct R R' R'))).inv (e (γ⁻¹ * γ'))) := by
    rw [hpre, Scheme.basicOpen_of_isUnit _ hunit]
    trivial
  rw [Scheme.Hom.mem_preimage, basicOpen_eq_of_affine] at hmem
  exact (PrimeSpectrum.mem_basicOpen _ _).mp hmem

theorem wc_gas_copies_agree : ∀ (R R' B : Type u) [CommRing R] [CommRing R'] [CommRing B] [Algebra R R'] [Algebra R B] (G : Type) [Group G] [Fintype G] (e : G → TensorProduct R R' R') (ι : B →ₐ[R] (G → R')), (∀ c, IsIdempotentElem (e c)) → (∀ c c', c ≠ c' → e c * e c' = 0) → (∀ b, wcGTorDescCond R R' G e (ι b)) → ∀ (Z : Scheme.{u}) (z1 z2 : Z ⟶ Spec (.of R')) (wz : Z ⟶ Spec (.of (TensorProduct R R' R'))), wz ≫ Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom : R' →+* TensorProduct R R' R')) = z1 → wz ≫ Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeRight : R' →ₐ[R] TensorProduct R R' R').toRingHom) = z2 → ∀ γ γ' : G, (∀ ζ : Z, e (γ⁻¹ * γ') ∉ @PrimeSpectrum.asIdeal (TensorProduct R R' R') _ (wz ζ)) → z1 ≫ Spec.map (CommRingCat.ofHom ((Pi.evalRingHom (fun _ : G => R') γ).comp ι.toRingHom)) = z2 ≫ Spec.map (CommRingCat.ofHom ((Pi.evalRingHom (fun _ : G => R') γ').comp ι.toRingHom)) :=
by
  intro R R' B _ _ _ _ _ G _ _ e ι hidem horth hDC Z z1 z2 wz hw1 hw2 γ γ' havoid
  classical
  have hN : ∀ {C D : CommRingCat.{u}} (f : C ⟶ D) (v : Z ⟶ Spec D),
      (Scheme.ΓSpecIso C).inv ≫ (v ≫ Spec.map f).appTop =
        f ≫ (Scheme.ΓSpecIso D).inv ≫ v.appTop := by
    intro C D f v
    rw [Scheme.Hom.comp_appTop, ← Category.assoc, ← Scheme.ΓSpecIso_inv_naturality,
      Category.assoc]
  let φ : TensorProduct R R' R' →+* Γ(Z, ⊤) :=
    ((Scheme.ΓSpecIso (.of (TensorProduct R R' R'))).inv ≫ wz.appTop).hom
  let ψ1 : R' →+* Γ(Z, ⊤) := ((Scheme.ΓSpecIso (.of R')).inv ≫ z1.appTop).hom
  let ψ2 : R' →+* Γ(Z, ⊤) := ((Scheme.ΓSpecIso (.of R')).inv ≫ z2.appTop).hom
  have hψ1 : ∀ x : R', φ (x ⊗ₜ[R] 1) = ψ1 x := by
    intro x
    have e' := hN (CommRingCat.ofHom
      (Algebra.TensorProduct.includeLeftRingHom : R' →+* TensorProduct R R' R')) wz
    rw [hw1] at e'
    exact (congrArg (fun k => k.hom x) e').symm
  have hψ2 : ∀ y : R', φ ((1 : R') ⊗ₜ[R] y) = ψ2 y := by
    intro y
    have e' := hN (CommRingCat.ofHom
      (Algebra.TensorProduct.includeRight : R' →ₐ[R] TensorProduct R R' R').toRingHom) wz
    rw [hw2] at e'
    exact (congrArg (fun k => k.hom y) e').symm
  set c₀ := γ⁻¹ * γ' with hc₀

  have hunit : IsUnit (φ (e c₀)) := by
    have hrw : φ (e c₀) = (Scheme.Hom.app wz ⊤) ((Scheme.ΓSpecIso (.of (TensorProduct R R' R'))).inv
        (e c₀)) := rfl
    rw [hrw]
    apply RingedSpace.isUnit_of_isUnit_germ Z.toRingedSpace
    intro x _
    have hpre := Scheme.Hom.preimage_basicOpen wz (U := ⊤)
      ((Scheme.ΓSpecIso (.of (TensorProduct R R' R'))).inv (e c₀))
    have hmem : x ∈ wz ⁻¹ᵁ (Spec (.of (TensorProduct R R' R'))).basicOpen
        ((Scheme.ΓSpecIso (.of (TensorProduct R R' R'))).inv (e c₀)) := by
      rw [Scheme.Hom.mem_preimage, basicOpen_eq_of_affine]
      exact (PrimeSpectrum.mem_basicOpen _ _).mpr (havoid x)
    rw [hpre] at hmem
    exact (Scheme.mem_basicOpen_top Z _ x).mp hmem

  have hone : φ (e c₀) = 1 := (IsIdempotentElem.iff_eq_one_of_isUnit hunit).mp ((hidem c₀).map φ)

  have hzero : ∀ c, c ≠ c₀ → φ (e c) = 0 := by
    intro c hc
    rw [← mul_one (φ (e c)), ← hone, ← map_mul, horth c c₀ hc, map_zero]

  have hh : γ' * c₀⁻¹ = γ := by rw [hc₀]; group
  have hring : ∀ b : B, ψ1 (ι b γ) = ψ2 (ι b γ') := by
    intro b
    have e1 := congrArg φ (hDC b γ')
    rw [hψ2, map_sum, Finset.sum_eq_single c₀] at e1
    · rw [e1, map_mul, hone, one_mul, hh, hψ1]
    · intro c _ hc
      rw [map_mul, hzero c hc, zero_mul]
    · intro hc
      exact absurd (Finset.mem_univ _) hc

  apply ext_of_isAffine
  rw [← cancel_epi (Scheme.ΓSpecIso (.of B)).inv, hN, hN]
  ext b
  have := hring b
  exact this

theorem wc_gtor_affine_sheeted : ∀ (U : Scheme.{u}) (Γ : Type) [Group Γ] [Finite Γ] (ι : Type) [Finite ι] (V : ι → Scheme.{u}) (v : ∀ j, V j ⟶ U), (∀ j, Etale (v j)) → ∀ (g : ∀ i j, ↥(Limits.pullback (v i) (v j)) → Γ), (∀ i j, IsLocallyConstant (g i j)) → wcGCocycle v g → wcGTorDescHyp.{u} → ∀ (O : U.Opens), IsAffineOpen O → (∀ x : U, x ∈ O → ∃ j, x ∈ Set.range (v j)) → ∃ (n : ℕ) (W : Fin n → Scheme.{u}) (k : Fin n → ι) (w : ∀ m, W m ⟶ V (k m)) (E : Scheme.{u}) (π : E ⟶ (O : Scheme.{u})) (σ : ∀ m, Γ → (W m ⟶ E)), IsFinite π ∧ Etale π ∧ (∀ m, IsAffine (W m)) ∧ (∀ m, IsOpenImmersion (w m)) ∧ (∀ m γ, σ m γ ≫ π ≫ O.ι = w m ≫ v (k m)) ∧ (∀ x : U, x ∈ O → ∃ m y, (w m ≫ v (k m)) y = x) ∧ (∀ y : E, ∃ m γ x, σ m γ x = y) ∧ ∀ (m m' : Fin n) (γ γ' : Γ) (Z : Scheme.{u}) (a : Z ⟶ W m) (b : Z ⟶ W m') (hab : (a ≫ w m) ≫ v (k m) = (b ≫ w m') ≫ v (k m')), (a ≫ σ m γ = b ≫ σ m' γ' ↔ ∀ z : Z, γ' = γ * g (k m) (k m') (Limits.pullback.lift (a ≫ w m) (b ≫ w m') hab z)) :=
by
  intro U G _ _ ι _ V v het g hgloc hG hD O hO hcovO
  classical
  letI : Fintype G := Fintype.ofFinite G

  obtain ⟨n, W, k, w, φ, hWaff, hwopen, hφet, hφw, hφsurj, hOcov⟩ :=
    wc_gas_affine_cover U ι V v het O hO hcovO

  obtain ⟨R', _, _, _, j, hsurj, hjopen, hjdisj, hjcov, hjφ⟩ :=
    wc_gas_pi_chart Γ(U, O) n W φ hWaff hφet hφsurj

  have hj : ∀ m, j m ≫ Spec.map (CommRingCat.ofHom (algebraMap Γ(U, O) R')) ≫ hO.fromSpec =
      w m ≫ v (k m) := by
    intro m
    rw [← Category.assoc, hjφ m, hφw m]
  haveI hmono : Mono hO.fromSpec := by
    rw [← hO.isoSpec_inv_ι]
    infer_instance

  haveI : Module.FaithfullyFlat Γ(U, O) R' := Module.FaithfullyFlat.of_comap_surjective hsurj

  obtain ⟨lc, hlink⟩ := wc_gas_lc_link wc_gas_lc_glue U G ι V v g hgloc Γ(U, O) R' hO.fromSpec
    hmono n W k w j hjopen hjdisj hjcov hj

  have hcoc := wc_gas_lc_cocycle U G ι V v g hG Γ(U, O) R' hO.fromSpec n W k w j hjopen hjcov hj
    lc hlink

  obtain ⟨e, hecoc, hemem⟩ := wc_gas_idem_cocycle Γ(U, O) R' G lc hcoc

  obtain ⟨B, _, _, ιB, -, hDCiff, hLbij, hBet, hBfin, -⟩ := hD Γ(U, O) R' G e hecoc
  have hDC : ∀ b, wcGTorDescCond Γ(U, O) R' G e (ιB b) := fun b => (hDCiff (ιB b)).1 ⟨b, rfl⟩
  have hιalg : ∀ γ : G, ((Pi.evalRingHom (fun _ : G => R') γ).comp ιB.toRingHom).comp
      (algebraMap Γ(U, O) B) = algebraMap Γ(U, O) R' := by
    intro γ
    ext r
    change ιB (algebraMap Γ(U, O) B r) γ = algebraMap Γ(U, O) R' r
    rw [ιB.commutes]
    rfl
  have hSpec : ∀ γ : G, Spec.map (CommRingCat.ofHom
      ((Pi.evalRingHom (fun _ : G => R') γ).comp ιB.toRingHom)) ≫
      Spec.map (CommRingCat.ofHom (algebraMap Γ(U, O) B)) =
      Spec.map (CommRingCat.ofHom (algebraMap Γ(U, O) R')) := by
    intro γ
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, hιalg γ]
  haveI hfinB : IsFinite (Spec.map (CommRingCat.ofHom (algebraMap Γ(U, O) B))) :=
    (IsFinite.SpecMap_iff _).mpr (RingHom.finite_algebraMap.mpr hBfin)
  haveI hetB : Etale (Spec.map (CommRingCat.ofHom (algebraMap Γ(U, O) B))) := by
    rw [HasRingHomProperty.Spec_iff (P := @Etale)]
    exact RingHom.etale_algebraMap.mpr hBet

  refine ⟨n, W, k, w, Spec (.of B),
    Spec.map (CommRingCat.ofHom (algebraMap Γ(U, O) B)) ≫ hO.isoSpec.inv,
    fun m γ => j m ≫ Spec.map (CommRingCat.ofHom
      ((Pi.evalRingHom (fun _ : G => R') γ).comp ιB.toRingHom)),
    inferInstance, inferInstance, hWaff, hwopen, ?_, hOcov, ?_, ?_⟩
  ·
    intro m γ
    simp only [Category.assoc]
    rw [IsAffineOpen.isoSpec_inv_ι, reassoc_of% (hSpec γ)]
    exact hj m
  ·
    intro y
    obtain ⟨γ, Q, hQ⟩ := wc_gas_copies_cover Γ(U, O) R' B G ιB hsurj hLbij y
    obtain ⟨m, x, hx⟩ := hjcov Q
    refine ⟨m, γ, x, ?_⟩
    show (j m ≫ Spec.map (CommRingCat.ofHom
      ((Pi.evalRingHom (fun _ : G => R') γ).comp ιB.toRingHom))) x = y
    rw [Scheme.Hom.comp_apply, hx, hQ]
  ·
    intro m m' γ γ' Z a b hab
    have hz : (a ≫ j m) ≫ Spec.map (CommRingCat.ofHom (algebraMap Γ(U, O) R')) =
        (b ≫ j m') ≫ Spec.map (CommRingCat.ofHom (algebraMap Γ(U, O) R')) := by
      apply (cancel_mono hO.fromSpec).1
      simp only [Category.assoc]
      rw [hj m, hj m']
      simpa only [Category.assoc] using hab
    let wz : Z ⟶ Spec (.of (TensorProduct Γ(U, O) R' R')) :=
      Limits.pullback.lift (a ≫ j m) (b ≫ j m') hz ≫ (pullbackSpecIso Γ(U, O) R' R').hom
    have hw1 : wz ≫ Spec.map (CommRingCat.ofHom
        (Algebra.TensorProduct.includeLeftRingHom : R' →+* TensorProduct Γ(U, O) R' R')) =
        a ≫ j m := by
      simp only [wz, Category.assoc, pullbackSpecIso_hom_fst, Limits.pullback.lift_fst]
    have hw2 : wz ≫ Spec.map (CommRingCat.ofHom
        (Algebra.TensorProduct.includeRight :
          R' →ₐ[Γ(U, O)] TensorProduct Γ(U, O) R' R').toRingHom) = b ≫ j m' := by
      have this : (pullbackSpecIso Γ(U, O) R' R').hom ≫ Spec.map
          (CommRingCat.ofHom (Algebra.TensorProduct.includeRight :
            R' →ₐ[Γ(U, O)] TensorProduct Γ(U, O) R' R').toRingHom) =
          Limits.pullback.snd (Spec.map (CommRingCat.ofHom (algebraMap Γ(U, O) R')))
            (Spec.map (CommRingCat.ofHom (algebraMap Γ(U, O) R'))) :=
        pullbackSpecIso_hom_snd Γ(U, O) R' R'
      change Limits.pullback.lift (a ≫ j m) (b ≫ j m') hz ≫ ((pullbackSpecIso Γ(U, O) R' R').hom ≫
        Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeRight :
          R' →ₐ[Γ(U, O)] TensorProduct Γ(U, O) R' R').toRingHom)) = b ≫ j m'
      rw [this, Limits.pullback.lift_snd]
    have hL := hlink m m' Z a b hab wz hw1 hw2
    show a ≫ (j m ≫ Spec.map (CommRingCat.ofHom
        ((Pi.evalRingHom (fun _ : G => R') γ).comp ιB.toRingHom))) =
      b ≫ (j m' ≫ Spec.map (CommRingCat.ofHom
        ((Pi.evalRingHom (fun _ : G => R') γ').comp ιB.toRingHom))) ↔ _
    rw [← Category.assoc, ← Category.assoc]
    constructor
    · intro heq ζ
      have h1 := wc_gas_overlap_unit Γ(U, O) R' B G e ιB hDC hLbij.2 Z (a ≫ j m) (b ≫ j m') wz
        hw1 hw2 γ γ' heq ζ
      have h2 : lc (wz ζ) = γ⁻¹ * γ' := (hemem _ _).1 h1
      rw [hL ζ] at h2
      rw [h2, mul_inv_cancel_left]
    · intro hall
      apply wc_gas_copies_agree Γ(U, O) R' B G e ιB hecoc.1 hecoc.2.1 hDC Z _ _ wz hw1 hw2 γ γ'
      intro ζ
      apply (hemem _ _).2
      rw [hL ζ, hall ζ, inv_mul_cancel_left]

theorem wc_gtor_sheet_lambda : ∀ (U : Scheme.{u}) (Γ : Type) [Group Γ] (ι : Type) (V : ι → Scheme.{u}) (v : ∀ j, V j ⟶ U) (g : ∀ i j, ↥(Limits.pullback (v i) (v j)) → Γ), (∀ i j, IsLocallyConstant (g i j)) → wcGCocycle v g → ∀ (n : ℕ) (W : Fin n → Scheme.{u}) (k : Fin n → ι) (w : ∀ m, W m ⟶ V (k m)) (E : Scheme.{u}) (p : E ⟶ U) (σ : ∀ m, Γ → (W m ⟶ E)), (∀ m γ, Etale (σ m γ)) → (∀ m γ, σ m γ ≫ p = w m ≫ v (k m)) → (∀ y : E, ∃ m γ x, σ m γ x = y) → (∀ (m m' : Fin n) (γ γ' : Γ) (Z : Scheme.{u}) (a : Z ⟶ W m) (b : Z ⟶ W m') (hab : (a ≫ w m) ≫ v (k m) = (b ≫ w m') ≫ v (k m')), a ≫ σ m γ = b ≫ σ m' γ' → ∀ z : Z, γ' = γ * g (k m) (k m') (Limits.pullback.lift (a ≫ w m) (b ≫ w m') hab z)) → ∃ Λ : ∀ l, ↥(Limits.pullback p (v l)) → Γ, (∀ l, IsLocallyConstant (Λ l)) ∧ ∀ (l : ι) (m : Fin n) (γ : Γ) (Z : Scheme.{u}) (a : Z ⟶ W m) (q : Z ⟶ Limits.pullback p (v l)) (h : a ≫ σ m γ = q ≫ Limits.pullback.fst p (v l)) (hq : (a ≫ w m) ≫ v (k m) = (q ≫ Limits.pullback.snd p (v l)) ≫ v l) (z : Z), Λ l (q z) = γ * g (k m) l (Limits.pullback.lift (a ≫ w m) (q ≫ Limits.pullback.snd p (v l)) hq z) :=
by
  intro U Γ _ ι V v g hgloc hG n W k w E p σ hσet hσ hσcov hMI
  classical

  have wd : ∀ (l : ι) (m₁ m₂ : Fin n) (γ₁ γ₂ : Γ) (Z₁ Z₂ : Scheme.{u}) (a₁ : Z₁ ⟶ W m₁)
      (a₂ : Z₂ ⟶ W m₂) (q₁ : Z₁ ⟶ Limits.pullback p (v l)) (q₂ : Z₂ ⟶ Limits.pullback p (v l)),
      a₁ ≫ σ m₁ γ₁ = q₁ ≫ Limits.pullback.fst p (v l) →
      a₂ ≫ σ m₂ γ₂ = q₂ ≫ Limits.pullback.fst p (v l) →
      ∀ (hq₁ : (a₁ ≫ w m₁) ≫ v (k m₁) = (q₁ ≫ Limits.pullback.snd p (v l)) ≫ v l)
        (hq₂ : (a₂ ≫ w m₂) ≫ v (k m₂) = (q₂ ≫ Limits.pullback.snd p (v l)) ≫ v l)
        (z₁ : Z₁) (z₂ : Z₂), q₁ z₁ = q₂ z₂ →
        γ₁ * g (k m₁) l (Limits.pullback.lift (a₁ ≫ w m₁) (q₁ ≫ Limits.pullback.snd p (v l)) hq₁ z₁)
          = γ₂ * g (k m₂) l
            (Limits.pullback.lift (a₂ ≫ w m₂) (q₂ ≫ Limits.pullback.snd p (v l)) hq₂ z₂) := by
    intro l m₁ m₂ γ₁ γ₂ Z₁ Z₂ a₁ a₂ q₁ q₂ h₁ h₂ hq₁ hq₂ z₁ z₂ hz
    obtain ⟨ζ, hζ1, hζ2⟩ := Scheme.Pullback.exists_preimage_pullback (f := q₁) (g := q₂) z₁ z₂ hz
    have hζ1' : Limits.pullback.fst q₁ q₂ ζ = z₁ := hζ1
    have hζ2' : Limits.pullback.snd q₁ q₂ ζ = z₂ := hζ2
    have hC : Limits.pullback.fst q₁ q₂ ≫ q₁ = Limits.pullback.snd q₁ q₂ ≫ q₂ :=
      Limits.pullback.condition
    have eqS : (Limits.pullback.fst q₁ q₂ ≫ a₁) ≫ σ m₁ γ₁ =
        (Limits.pullback.snd q₁ q₂ ≫ a₂) ≫ σ m₂ γ₂ := by
      rw [Category.assoc, Category.assoc, h₁, h₂, ← Category.assoc, hC, Category.assoc]
    have hbc : ((Limits.pullback.snd q₁ q₂ ≫ a₂) ≫ w m₂) ≫ v (k m₂) =
        (Limits.pullback.snd q₁ q₂ ≫ q₂ ≫ Limits.pullback.snd p (v l)) ≫ v l := by
      have := hq₂
      simp only [Category.assoc] at this ⊢
      rw [this]
    have hac : ((Limits.pullback.fst q₁ q₂ ≫ a₁) ≫ w m₁) ≫ v (k m₁) =
        (Limits.pullback.snd q₁ q₂ ≫ q₂ ≫ Limits.pullback.snd p (v l)) ≫ v l := by
      have := hq₁
      simp only [Category.assoc] at this ⊢
      rw [this]
      exact Limits.pullback.condition_assoc _
    have hab := hac.trans hbc.symm
    have hMIz := hMI m₁ m₂ γ₁ γ₂ _ (Limits.pullback.fst q₁ q₂ ≫ a₁)
      (Limits.pullback.snd q₁ q₂ ≫ a₂) hab eqS ζ
    have hcoc := hG (k m₁) (k m₂) l _ ((Limits.pullback.fst q₁ q₂ ≫ a₁) ≫ w m₁)
      ((Limits.pullback.snd q₁ q₂ ≫ a₂) ≫ w m₂)
      (Limits.pullback.snd q₁ q₂ ≫ q₂ ≫ Limits.pullback.snd p (v l)) hab hbc hac ζ
    have E1 : Limits.pullback.lift ((Limits.pullback.fst q₁ q₂ ≫ a₁) ≫ w m₁)
        (Limits.pullback.snd q₁ q₂ ≫ q₂ ≫ Limits.pullback.snd p (v l)) hac =
        Limits.pullback.fst q₁ q₂ ≫
          Limits.pullback.lift (a₁ ≫ w m₁) (q₁ ≫ Limits.pullback.snd p (v l)) hq₁ := by
      apply Limits.pullback.hom_ext
      · rw [Limits.pullback.lift_fst, Category.assoc (Limits.pullback.fst q₁ q₂)
          (Limits.pullback.lift (a₁ ≫ w m₁) (q₁ ≫ Limits.pullback.snd p (v l)) hq₁),
          Limits.pullback.lift_fst, Category.assoc]
      · rw [Limits.pullback.lift_snd, Category.assoc (Limits.pullback.fst q₁ q₂)
          (Limits.pullback.lift (a₁ ≫ w m₁) (q₁ ≫ Limits.pullback.snd p (v l)) hq₁),
          Limits.pullback.lift_snd]
        exact (Limits.pullback.condition_assoc _).symm
    have E2 : Limits.pullback.lift ((Limits.pullback.snd q₁ q₂ ≫ a₂) ≫ w m₂)
        (Limits.pullback.snd q₁ q₂ ≫ q₂ ≫ Limits.pullback.snd p (v l)) hbc =
        Limits.pullback.snd q₁ q₂ ≫
          Limits.pullback.lift (a₂ ≫ w m₂) (q₂ ≫ Limits.pullback.snd p (v l)) hq₂ := by
      apply Limits.pullback.hom_ext
      · rw [Limits.pullback.lift_fst, Category.assoc (Limits.pullback.snd q₁ q₂)
          (Limits.pullback.lift (a₂ ≫ w m₂) (q₂ ≫ Limits.pullback.snd p (v l)) hq₂),
          Limits.pullback.lift_fst, Category.assoc]
      · rw [Limits.pullback.lift_snd, Category.assoc (Limits.pullback.snd q₁ q₂)
          (Limits.pullback.lift (a₂ ≫ w m₂) (q₂ ≫ Limits.pullback.snd p (v l)) hq₂),
          Limits.pullback.lift_snd]
    rw [E1, E2, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply, hζ1', hζ2'] at hcoc
    rw [hMIz, hcoc, mul_assoc]

  have hx : ∀ (l : ι) (x : ↥(Limits.pullback p (v l))), ∃ (m : Fin n) (γ : Γ)
      (r : ↥(Limits.pullback (σ m γ) (Limits.pullback.fst p (v l)))),
      Limits.pullback.snd (σ m γ) (Limits.pullback.fst p (v l)) r = x := by
    intro l x
    obtain ⟨m, γ, x₀, h0⟩ := hσcov (Limits.pullback.fst p (v l) x)
    obtain ⟨r, -, hr⟩ := Scheme.Pullback.exists_preimage_pullback
      (f := σ m γ) (g := Limits.pullback.fst p (v l)) x₀ x h0
    exact ⟨m, γ, r, hr⟩
  choose M Gm R hR using hx
  have hqQ : ∀ (m : Fin n) (γ : Γ) (l : ι),
      (Limits.pullback.fst (σ m γ) (Limits.pullback.fst p (v l)) ≫ w m) ≫ v (k m) =
      (Limits.pullback.snd (σ m γ) (Limits.pullback.fst p (v l)) ≫ Limits.pullback.snd p (v l))
        ≫ v l := by
    intro m γ l
    simp only [Category.assoc]
    rw [← hσ m γ, Limits.pullback.condition_assoc, Limits.pullback.condition]
  let Λ : ∀ l, ↥(Limits.pullback p (v l)) → Γ := fun l x =>
    Gm l x * g (k (M l x)) l (Limits.pullback.lift _ _ (hqQ (M l x) (Gm l x) l) (R l x))

  have hEval : ∀ (l : ι) (m : Fin n) (γ : Γ) (Z : Scheme.{u}) (a : Z ⟶ W m)
      (q : Z ⟶ Limits.pullback p (v l)) (h : a ≫ σ m γ = q ≫ Limits.pullback.fst p (v l))
      (hq : (a ≫ w m) ≫ v (k m) = (q ≫ Limits.pullback.snd p (v l)) ≫ v l) (z : Z),
      Λ l (q z) = γ * g (k m) l
        (Limits.pullback.lift (a ≫ w m) (q ≫ Limits.pullback.snd p (v l)) hq z) := by
    intro l m γ Z a q h hq z
    exact wd l (M l (q z)) m (Gm l (q z)) γ _ Z
      (Limits.pullback.fst (σ (M l (q z)) (Gm l (q z))) (Limits.pullback.fst p (v l))) a
      (Limits.pullback.snd (σ (M l (q z)) (Gm l (q z))) (Limits.pullback.fst p (v l))) q
      Limits.pullback.condition h (hqQ _ _ l) hq (R l (q z)) z (hR l (q z))

  have hLC : ∀ l, IsLocallyConstant (Λ l) := by
    intro l
    rw [IsLocallyConstant.iff_exists_open]
    intro x
    obtain ⟨m, γ, x₀, h0⟩ := hσcov (Limits.pullback.fst p (v l) x)
    obtain ⟨r, -, hr⟩ := Scheme.Pullback.exists_preimage_pullback
      (f := σ m γ) (g := Limits.pullback.fst p (v l)) x₀ x h0
    have hr' : Limits.pullback.snd (σ m γ) (Limits.pullback.fst p (v l)) r = x := hr
    have hgl : IsLocallyConstant (g (k m) l ∘
        (Limits.pullback.lift _ _ (hqQ m γ l) : _ ⟶ Limits.pullback (v (k m)) (v l))) :=
      (hgloc (k m) l).comp_continuous (Limits.pullback.lift _ _ (hqQ m γ l)).continuous
    obtain ⟨N₀, hN₀, hrN₀, hconst⟩ := (IsLocallyConstant.iff_exists_open _).mp hgl r
    have hsnd : Etale (Limits.pullback.snd (σ m γ) (Limits.pullback.fst p (v l))) := by
      first
        | exact MorphismProperty.of_isPullback (P := @Etale) (IsPullback.of_hasPullback _ _).flip
            (hσet m γ)
        | exact MorphismProperty.of_isPullback (P := @Etale) (IsPullback.of_hasPullback _ _)
            (hσet m γ)
        | (haveI := hσet m γ; infer_instance)
    have hopen : IsOpenMap (Limits.pullback.snd (σ m γ) (Limits.pullback.fst p (v l))) := by
      haveI := hsnd
      exact (Limits.pullback.snd (σ m γ) (Limits.pullback.fst p (v l))).isOpenMap
    refine ⟨Limits.pullback.snd (σ m γ) (Limits.pullback.fst p (v l)) '' N₀, hopen N₀ hN₀,
      ⟨r, hrN₀, hr'⟩, ?_⟩
    rintro x' ⟨r', hr'N, rfl⟩
    rw [← hr']
    rw [hEval l m γ _ _ _ Limits.pullback.condition (hqQ m γ l) r',
      hEval l m γ _ _ _ Limits.pullback.condition (hqQ m γ l) r]
    congr 1
    exact hconst r' hr'N
  exact ⟨Λ, hLC, hEval⟩

theorem wc_gtor_sheet_rep_unique : wcEtFamDescHyp.{u} → ∀ (U : Scheme.{u}) (Γ : Type) [Group Γ] (ι : Type) (V : ι → Scheme.{u}) (v : ∀ j, V j ⟶ U) (g : ∀ i j, ↥(Limits.pullback (v i) (v j)) → Γ), wcGCocycle v g → ∀ (n : ℕ) (W : Fin n → Scheme.{u}) (k : Fin n → ι) (w : ∀ m, W m ⟶ V (k m)) (E : Scheme.{u}) (p : E ⟶ U) (σ : ∀ m, Γ → (W m ⟶ E)), (∀ m γ, Etale (σ m γ)) → (∀ m γ, σ m γ ≫ p = w m ≫ v (k m)) → (∀ y : E, ∃ m γ x, σ m γ x = y) → (∀ (m m' : Fin n) (γ γ' : Γ) (Z : Scheme.{u}) (a : Z ⟶ W m) (b : Z ⟶ W m') (hab : (a ≫ w m) ≫ v (k m) = (b ≫ w m') ≫ v (k m')), (∀ z : Z, γ' = γ * g (k m) (k m') (Limits.pullback.lift (a ≫ w m) (b ≫ w m') hab z)) → a ≫ σ m γ = b ≫ σ m' γ') → ∀ (Λ : ∀ l, ↥(Limits.pullback p (v l)) → Γ), (∀ (l : ι) (m : Fin n) (γ : Γ) (Z : Scheme.{u}) (a : Z ⟶ W m) (q : Z ⟶ Limits.pullback p (v l)) (h : a ≫ σ m γ = q ≫ Limits.pullback.fst p (v l)) (hq : (a ≫ w m) ≫ v (k m) = (q ≫ Limits.pullback.snd p (v l)) ≫ v l) (z : Z), Λ l (q z) = γ * g (k m) l (Limits.pullback.lift (a ≫ w m) (q ≫ Limits.pullback.snd p (v l)) hq z)) → ∀ (T : Scheme.{u}) (t : T ⟶ U) (lam : ∀ l, ↥(Limits.pullback t (v l)) → Γ) (φ₁ φ₂ : T ⟶ E) (h₁ : φ₁ ≫ p = t) (h₂ : φ₂ ≫ p = t), (∀ (l : ι) (x : ↥(Limits.pullback t (v l))), lam l x = Λ l (Limits.pullback.map t (v l) p (v l) φ₁ (𝟙 _) (𝟙 _) (by rw [Category.comp_id, h₁]) (by simp) x)) → (∀ (l : ι) (x : ↥(Limits.pullback t (v l))), lam l x = Λ l (Limits.pullback.map t (v l) p (v l) φ₂ (𝟙 _) (𝟙 _) (by rw [Category.comp_id, h₂]) (by simp) x)) → φ₁ = φ₂ :=
by
  intro hD U Γ _ ι V v g hG n W k w E p σ hσet hσ hσcov MIb Λ hEval T t lam φ₁ φ₂ h₁ h₂ rep₁ rep₂

  have ext : ∀ (Z : Scheme.{u}) (α β : Z ⟶ E),
      (∀ m γ, Limits.pullback.fst α (σ m γ) ≫ β = Limits.pullback.fst α (σ m γ) ≫ α) →
      α = β := by
    intro Z α β H
    have hf : ∀ i : Fin n × Γ, Etale (Limits.pullback.fst α (σ i.1 i.2)) := fun i =>
      MorphismProperty.of_isPullback (P := @Etale)
        (IsPullback.of_hasPullback α (σ i.1 i.2)).flip (hσet i.1 i.2)
    have hcov : ∀ x : Z, ∃ i : Fin n × Γ, x ∈ Set.range (Limits.pullback.fst α (σ i.1 i.2)) := by
      intro x
      obtain ⟨m, γ, x₀, hx₀⟩ := hσcov (α x)
      obtain ⟨ζ, hζ, -⟩ :=
        Scheme.Pullback.exists_preimage_pullback (f := α) (g := σ m γ) x x₀ hx₀.symm
      exact ⟨(m, γ), ζ, hζ⟩
    obtain ⟨φ0, -, hu⟩ := hD Z E (Fin n × Γ) (fun i => Limits.pullback α (σ i.1 i.2))
      (fun i => Limits.pullback.fst α (σ i.1 i.2)) hf hcov
      (fun i => Limits.pullback.fst α (σ i.1 i.2) ≫ α)
      (fun i j Z' a b hab => by
        have hab' : a ≫ Limits.pullback.fst α (σ i.1 i.2) =
            b ≫ Limits.pullback.fst α (σ j.1 j.2) := hab
        show a ≫ (Limits.pullback.fst α (σ i.1 i.2) ≫ α) =
          b ≫ (Limits.pullback.fst α (σ j.1 j.2) ≫ α)
        rw [← Category.assoc, hab', Category.assoc])
    have e1 : α = φ0 := hu α (fun i => rfl)
    have e2 : β = φ0 := hu β (fun i => H i.1 i.2)
    rw [e1, e2]

  have hcongr : ∀ {A B C D : Scheme.{u}} {f1 : B ⟶ D} {f2 : C ⟶ D} (x x' : A ⟶ B)
      (y y' : A ⟶ C) (hx : x = x') (hy : y = y') (h1 : x ≫ f1 = y ≫ f2)
      (h2 : x' ≫ f1 = y' ≫ f2), Limits.pullback.lift x y h1 = Limits.pullback.lift x' y' h2 := by
    intro A B C D f1 f2 x x' y y' hx hy h1 h2
    subst hx
    subst hy
    rfl
  have diag : ∀ (j : ι) (Z : Scheme.{u}) (b : Z ⟶ V j) (hb : b ≫ v j = b ≫ v j) (z : Z),
      g j j (Limits.pullback.lift b b hb z) = 1 := by
    intro j Z b hb z
    have h := hG j j j Z b b b hb hb hb z
    exact mul_left_cancel (h.symm.trans (mul_one _).symm)

  have s1 : ∀ (φ : T ⟶ E) (h : φ ≫ p = t),
      (∀ (l : ι) (x : ↥(Limits.pullback t (v l))), lam l x = Λ l (Limits.pullback.map t (v l) p (v l) φ (𝟙 _) (𝟙 _) (by rw [Category.comp_id, h]) (by simp) x)) →
      ∀ (m : Fin n) (γ : Γ) (Z : Scheme.{u}) (c : Z ⟶ T) (a : Z ⟶ W m)
        (hc : c ≫ t = (a ≫ w m) ≫ v (k m)), c ≫ φ = a ≫ σ m γ →
        ∀ z : Z, lam (k m) (Limits.pullback.lift c (a ≫ w m) hc z) = γ := by
    intro φ h rep m γ Z c a hc hca z
    obtain ⟨q, hqdef⟩ : ∃ q, q = Limits.pullback.lift c (a ≫ w m) hc ≫
        Limits.pullback.map t (v (k m)) p (v (k m)) φ (𝟙 _) (𝟙 _)
          (by rw [Category.comp_id, h]) (by simp) := ⟨_, rfl⟩
    have hq1 : q ≫ Limits.pullback.fst p (v (k m)) = c ≫ φ := by
      have m1 : Limits.pullback.map t (v (k m)) p (v (k m)) φ (𝟙 _) (𝟙 _)
          (by rw [Category.comp_id, h]) (by simp) ≫ Limits.pullback.fst p (v (k m)) =
          Limits.pullback.fst t (v (k m)) ≫ φ := Limits.pullback.lift_fst _ _ _
      subst hqdef
      first
      | (rw [Category.assoc, m1, ← Category.assoc, Limits.pullback.lift_fst])
      | (rw [Category.assoc, Limits.pullback.lift_fst, ← Category.assoc,
          Limits.pullback.lift_fst])
      | (rw [Category.assoc, Limits.pullback.map, Limits.pullback.lift_fst, ← Category.assoc,
          Limits.pullback.lift_fst])
      | (erw [Category.assoc, Limits.pullback.lift_fst, ← Category.assoc,
          Limits.pullback.lift_fst])
      | simp
    have hq2 : q ≫ Limits.pullback.snd p (v (k m)) = a ≫ w m := by
      have m2 : Limits.pullback.map t (v (k m)) p (v (k m)) φ (𝟙 _) (𝟙 _)
          (by rw [Category.comp_id, h]) (by simp) ≫ Limits.pullback.snd p (v (k m)) =
          Limits.pullback.snd t (v (k m)) ≫ 𝟙 _ := Limits.pullback.lift_snd _ _ _
      subst hqdef
      first
      | (rw [Category.assoc, m2, Category.comp_id, Limits.pullback.lift_snd])
      | (rw [Category.assoc, Limits.pullback.lift_snd, ← Category.assoc,
          Limits.pullback.lift_snd, Category.comp_id])
      | (rw [Category.assoc, Limits.pullback.map, Limits.pullback.lift_snd, ← Category.assoc,
          Limits.pullback.lift_snd, Category.comp_id])
      | (erw [Category.assoc, Limits.pullback.lift_snd, ← Category.assoc,
          Limits.pullback.lift_snd, Category.comp_id])
      | simp
    have hA : a ≫ σ m γ = q ≫ Limits.pullback.fst p (v (k m)) := by rw [hq1, hca]
    have hB : (a ≫ w m) ≫ v (k m) = (q ≫ Limits.pullback.snd p (v (k m))) ≫ v (k m) := by
      rw [hq2]
    have E1 := hEval (k m) m γ Z a q hA hB z
    rw [hcongr (a ≫ w m) (a ≫ w m) _ _ rfl hq2 hB rfl, diag, mul_one] at E1
    rw [hqdef, Scheme.Hom.comp_apply] at E1
    rw [rep (k m)]
    exact E1

  have s2 : ∀ (φ : T ⟶ E) (h : φ ≫ p = t),
      (∀ (l : ι) (x : ↥(Limits.pullback t (v l))), lam l x = Λ l (Limits.pullback.map t (v l) p (v l) φ (𝟙 _) (𝟙 _) (by rw [Category.comp_id, h]) (by simp) x)) →
      ∀ (m m' : Fin n) (γ γ' : Γ) (Z : Scheme.{u}) (c : Z ⟶ T) (a : Z ⟶ W m) (b : Z ⟶ W m')
        (hc : c ≫ t = (a ≫ w m) ≫ v (k m)), c ≫ φ = b ≫ σ m' γ' →
        (∀ z : Z, lam (k m) (Limits.pullback.lift c (a ≫ w m) hc z) = γ) →
        c ≫ φ = a ≫ σ m γ := by
    intro φ h rep m m' γ γ' Z c a b hc hb hlab
    have hab : (b ≫ w m') ≫ v (k m') = (a ≫ w m) ≫ v (k m) := by
      calc (b ≫ w m') ≫ v (k m') = b ≫ (σ m' γ' ≫ p) := by rw [Category.assoc, hσ]
        _ = (c ≫ φ) ≫ p := by rw [hb, Category.assoc]
        _ = c ≫ t := by rw [Category.assoc, h]
        _ = (a ≫ w m) ≫ v (k m) := hc
    obtain ⟨q, hqdef⟩ : ∃ q, q = Limits.pullback.lift c (a ≫ w m) hc ≫
        Limits.pullback.map t (v (k m)) p (v (k m)) φ (𝟙 _) (𝟙 _)
          (by rw [Category.comp_id, h]) (by simp) := ⟨_, rfl⟩
    have hq1 : q ≫ Limits.pullback.fst p (v (k m)) = c ≫ φ := by
      have m1 : Limits.pullback.map t (v (k m)) p (v (k m)) φ (𝟙 _) (𝟙 _)
          (by rw [Category.comp_id, h]) (by simp) ≫ Limits.pullback.fst p (v (k m)) =
          Limits.pullback.fst t (v (k m)) ≫ φ := Limits.pullback.lift_fst _ _ _
      subst hqdef
      first
      | (rw [Category.assoc, m1, ← Category.assoc, Limits.pullback.lift_fst])
      | (rw [Category.assoc, Limits.pullback.lift_fst, ← Category.assoc,
          Limits.pullback.lift_fst])
      | (rw [Category.assoc, Limits.pullback.map, Limits.pullback.lift_fst, ← Category.assoc,
          Limits.pullback.lift_fst])
      | (erw [Category.assoc, Limits.pullback.lift_fst, ← Category.assoc,
          Limits.pullback.lift_fst])
      | simp
    have hq2 : q ≫ Limits.pullback.snd p (v (k m)) = a ≫ w m := by
      have m2 : Limits.pullback.map t (v (k m)) p (v (k m)) φ (𝟙 _) (𝟙 _)
          (by rw [Category.comp_id, h]) (by simp) ≫ Limits.pullback.snd p (v (k m)) =
          Limits.pullback.snd t (v (k m)) ≫ 𝟙 _ := Limits.pullback.lift_snd _ _ _
      subst hqdef
      first
      | (rw [Category.assoc, m2, Category.comp_id, Limits.pullback.lift_snd])
      | (rw [Category.assoc, Limits.pullback.lift_snd, ← Category.assoc,
          Limits.pullback.lift_snd, Category.comp_id])
      | (rw [Category.assoc, Limits.pullback.map, Limits.pullback.lift_snd, ← Category.assoc,
          Limits.pullback.lift_snd, Category.comp_id])
      | (erw [Category.assoc, Limits.pullback.lift_snd, ← Category.assoc,
          Limits.pullback.lift_snd, Category.comp_id])
      | simp
    have hA : b ≫ σ m' γ' = q ≫ Limits.pullback.fst p (v (k m)) := by rw [hq1, hb]
    have hB : (b ≫ w m') ≫ v (k m') = (q ≫ Limits.pullback.snd p (v (k m))) ≫ v (k m) := by
      rw [hq2]; exact hab
    have key : ∀ z : Z,
        γ = γ' * g (k m') (k m) (Limits.pullback.lift (b ≫ w m') (a ≫ w m) hab z) := by
      intro z
      have e1 := hEval (k m) m' γ' Z b q hA hB z
      rw [hcongr (b ≫ w m') (b ≫ w m') _ _ rfl hq2 hB hab] at e1
      have e2 : Λ (k m) (q z) = lam (k m) (Limits.pullback.lift c (a ≫ w m) hc z) := by
        rw [rep (k m), hqdef, Scheme.Hom.comp_apply]
      rw [← hlab z, ← e2]
      exact e1
    exact hb.trans (MIb m' m γ' γ Z b a hab key)

  apply ext T φ₁ φ₂
  intro m γ
  have inner : ∀ (X : Scheme.{u}) (F : X ⟶ T) (Sn : X ⟶ W m),
      F ≫ φ₁ = Sn ≫ σ m γ → F ≫ φ₂ = Sn ≫ σ m γ := by
    intro X F Sn hF
    apply ext X (F ≫ φ₂) (Sn ≫ σ m γ)
    intro m' γ'
    have generic : ∀ (Y : Scheme.{u}) (F' : Y ⟶ X) (Sn' : Y ⟶ W m'),
        F' ≫ F ≫ φ₂ = Sn' ≫ σ m' γ' → F' ≫ Sn ≫ σ m γ = F' ≫ F ≫ φ₂ := by
      intro Y F' Sn' hF'
      have hc : (F' ≫ F) ≫ t = ((F' ≫ Sn) ≫ w m) ≫ v (k m) := by
        rw [← h₁]
        simp only [Category.assoc]
        rw [reassoc_of% hF, hσ]
      have hca : (F' ≫ F) ≫ φ₁ = (F' ≫ Sn) ≫ σ m γ := by
        rw [Category.assoc, hF, Category.assoc]
      have hlab := s1 φ₁ h₁ rep₁ m γ Y (F' ≫ F) (F' ≫ Sn) hc hca
      have hb : (F' ≫ F) ≫ φ₂ = Sn' ≫ σ m' γ' := by
        rw [Category.assoc]; exact hF'
      have res := s2 φ₂ h₂ rep₂ m m' γ γ' Y (F' ≫ F) (F' ≫ Sn) Sn' hc hb hlab
      simp only [Category.assoc] at res
      exact res.symm
    exact generic (Limits.pullback (F ≫ φ₂) (σ m' γ')) (Limits.pullback.fst _ _)
      (Limits.pullback.snd _ _) Limits.pullback.condition
  exact (inner (Limits.pullback φ₁ (σ m γ)) (Limits.pullback.fst _ _) (Limits.pullback.snd _ _)
    Limits.pullback.condition).trans Limits.pullback.condition.symm

theorem wc_gtor_sheet_rep_exists : wcEtFamDescHyp.{u} → ∀ (U : Scheme.{u}) (Γ : Type) [Group Γ] (ι : Type) (V : ι → Scheme.{u}) (v : ∀ j, V j ⟶ U) (g : ∀ i j, ↥(Limits.pullback (v i) (v j)) → Γ) (n : ℕ) (W : Fin n → Scheme.{u}) (k : Fin n → ι) (w : ∀ m, W m ⟶ V (k m)) (E : Scheme.{u}) (p : E ⟶ U) (σ : ∀ m, Γ → (W m ⟶ E)), (∀ m, Etale (w m ≫ v (k m))) → (∀ m γ, σ m γ ≫ p = w m ≫ v (k m)) → (∀ (m m' : Fin n) (γ γ' : Γ) (Z : Scheme.{u}) (a : Z ⟶ W m) (b : Z ⟶ W m') (hab : (a ≫ w m) ≫ v (k m) = (b ≫ w m') ≫ v (k m')), (∀ z : Z, γ' = γ * g (k m) (k m') (Limits.pullback.lift (a ≫ w m) (b ≫ w m') hab z)) → a ≫ σ m γ = b ≫ σ m' γ') → ∀ (Λ : ∀ l, ↥(Limits.pullback p (v l)) → Γ), (∀ (l : ι) (m : Fin n) (γ : Γ) (Z : Scheme.{u}) (a : Z ⟶ W m) (q : Z ⟶ Limits.pullback p (v l)) (h : a ≫ σ m γ = q ≫ Limits.pullback.fst p (v l)) (hq : (a ≫ w m) ≫ v (k m) = (q ≫ Limits.pullback.snd p (v l)) ≫ v l) (z : Z), Λ l (q z) = γ * g (k m) l (Limits.pullback.lift (a ≫ w m) (q ≫ Limits.pullback.snd p (v l)) hq z)) → ∀ (T : Scheme.{u}) (t : T ⟶ U), (∀ τ : T, ∃ m y, (w m ≫ v (k m)) y = t τ) → ∀ (lam : ∀ l, ↥(Limits.pullback t (v l)) → Γ), wcGFam v g t lam → ∃ φ : T ⟶ E, ∃ h : φ ≫ p = t, ∀ (l : ι) (x : ↥(Limits.pullback t (v l))), lam l x = Λ l (Limits.pullback.map t (v l) p (v l) φ (𝟙 _) (𝟙 _) (by rw [Category.comp_id, h]) (by simp) x) :=
by
  intro hD U Γ _ ι V v g n W k w E p σ hwet hσ MIb Λ hEval T t hcovT lam hlam

  obtain ⟨X, f, r, hfr, hfet, hfcov, hlab⟩ : ∃ (X : Fin n × Γ → Scheme.{u}) (f : ∀ i, X i ⟶ T)
      (r : ∀ i, X i ⟶ W i.1) (hfr : ∀ i, f i ≫ t = (r i ≫ w i.1) ≫ v (k i.1)),
      (∀ i, Etale (f i)) ∧ (∀ τ : T, ∃ i, τ ∈ Set.range (f i)) ∧
      ∀ i (x : ↥(X i)), lam (k i.1) (Limits.pullback.lift (f i) (r i ≫ w i.1) (hfr i) x) = i.2 := by
    have hm : ∀ m, Limits.pullback.fst t (w m ≫ v (k m)) ≫ t =
        (Limits.pullback.snd t (w m ≫ v (k m)) ≫ w m) ≫ v (k m) := fun m => by
      rw [Category.assoc]; exact Limits.pullback.condition
    obtain ⟨μ, hμlc, hμdef⟩ : ∃ μ : ∀ m, ↥(Limits.pullback t (w m ≫ v (k m))) → Γ,
        (∀ m, IsLocallyConstant (μ m)) ∧ ∀ m x, μ m x = lam (k m)
          (Limits.pullback.lift (Limits.pullback.fst t (w m ≫ v (k m)))
            (Limits.pullback.snd t (w m ≫ v (k m)) ≫ w m) (hm m) x) :=
      ⟨fun m x => lam (k m) (Limits.pullback.lift (Limits.pullback.fst t (w m ≫ v (k m)))
            (Limits.pullback.snd t (w m ≫ v (k m)) ≫ w m) (hm m) x),
        fun m => (hlam.1 (k m)).comp_continuous (Limits.pullback.lift _ _ (hm m)).continuous,
        fun _ _ => rfl⟩
    obtain ⟨O, hO⟩ : ∃ O : ∀ i : Fin n × Γ, (Limits.pullback t (w i.1 ≫ v (k i.1))).Opens,
        ∀ i x, x ∈ O i ↔ μ i.1 x = i.2 :=
      ⟨fun i => ⟨{x | μ i.1 x = i.2}, (hμlc i.1).isOpen_fiber i.2⟩, fun _ _ => Iff.rfl⟩
    have hfr0 : ∀ i : Fin n × Γ, ((O i).ι ≫ Limits.pullback.fst t (w i.1 ≫ v (k i.1))) ≫ t =
        (((O i).ι ≫ Limits.pullback.snd t (w i.1 ≫ v (k i.1))) ≫ w i.1) ≫ v (k i.1) := by
      intro i
      rw [Category.assoc, hm i.1]
      simp only [Category.assoc]
    refine ⟨fun i => (O i : Scheme.{u}), fun i => (O i).ι ≫ Limits.pullback.fst t (w i.1 ≫ v (k i.1)),
      fun i => (O i).ι ≫ Limits.pullback.snd t (w i.1 ≫ v (k i.1)), hfr0, ?_, ?_, ?_⟩
    · intro i
      haveI := hwet i.1
      haveI e1 : Etale (Limits.pullback.fst t (w i.1 ≫ v (k i.1))) := by
        first
          | infer_instance
          | exact MorphismProperty.pullback_fst (P := @Etale) _ _ (hwet i.1)
          | exact (MorphismProperty.of_isPullback (P := @Etale)
              (IsPullback.of_hasPullback t (w i.1 ≫ v (k i.1))).flip (hwet i.1))
      first
        | infer_instance
        | exact MorphismProperty.comp_mem (W := @Etale) _ _ inferInstance e1
    · intro τ
      obtain ⟨m, y, hy⟩ := hcovT τ
      obtain ⟨x, hx1, -⟩ :=
        Scheme.Pullback.exists_preimage_pullback (f := t) (g := w m ≫ v (k m)) τ y hy.symm
      have hx1' : Limits.pullback.fst t (w m ≫ v (k m)) x = τ := hx1
      have hxO : x ∈ Set.range (O (m, μ m x)).ι := by
        rw [Scheme.Opens.range_ι]
        exact (hO (m, μ m x) x).mpr rfl
      obtain ⟨x', hx'⟩ := hxO
      refine ⟨(m, μ m x), x', ?_⟩
      show ((O (m, μ m x)).ι ≫ Limits.pullback.fst t (w m ≫ v (k m))) x' = τ
      rw [Scheme.Hom.comp_apply, hx', hx1']
    · intro i x
      have e : Limits.pullback.lift ((O i).ι ≫ Limits.pullback.fst t (w i.1 ≫ v (k i.1)))
          (((O i).ι ≫ Limits.pullback.snd t (w i.1 ≫ v (k i.1))) ≫ w i.1) (hfr0 i) =
          (O i).ι ≫ Limits.pullback.lift (Limits.pullback.fst t (w i.1 ≫ v (k i.1)))
            (Limits.pullback.snd t (w i.1 ≫ v (k i.1)) ≫ w i.1) (hm i.1) := by
        apply Limits.pullback.hom_ext
        · rw [Limits.pullback.lift_fst, Category.assoc, Limits.pullback.lift_fst]
        · simp only [Limits.pullback.lift_snd, Category.assoc]
      have hxO : (O i).ι x ∈ O i := by
        have : (O i).ι x ∈ Set.range (O i).ι := ⟨x, rfl⟩
        rw [Scheme.Opens.range_ι] at this
        exact this
      show lam (k i.1) (Limits.pullback.lift ((O i).ι ≫ Limits.pullback.fst t (w i.1 ≫ v (k i.1)))
          (((O i).ι ≫ Limits.pullback.snd t (w i.1 ≫ v (k i.1))) ≫ w i.1) (hfr0 i) x) = i.2
      rw [e, Scheme.Hom.comp_apply, ← hμdef]
      exact (hO i _).mp hxO

  have hcomp : ∀ (i j : Fin n × Γ) (Z : Scheme.{u}) (a : Z ⟶ X i) (b : Z ⟶ X j),
      a ≫ f i = b ≫ f j → a ≫ (r i ≫ σ i.1 i.2) = b ≫ (r j ≫ σ j.1 j.2) := by
    intro i j Z a b e
    have h1 : (a ≫ f i) ≫ t = ((a ≫ r i) ≫ w i.1) ≫ v (k i.1) := by
      rw [Category.assoc, hfr i]; simp only [Category.assoc]
    have h2 : (a ≫ f i) ≫ t = ((b ≫ r j) ≫ w j.1) ≫ v (k j.1) := by
      rw [e, Category.assoc, hfr j]; simp only [Category.assoc]
    have hab : ((a ≫ r i) ≫ w i.1) ≫ v (k i.1) = ((b ≫ r j) ≫ w j.1) ≫ v (k j.1) :=
      h1.symm.trans h2
    have L1 : Limits.pullback.lift (a ≫ f i) ((a ≫ r i) ≫ w i.1) h1 =
        a ≫ Limits.pullback.lift (f i) (r i ≫ w i.1) (hfr i) := by
      apply Limits.pullback.hom_ext
      · rw [Limits.pullback.lift_fst, Category.assoc, Limits.pullback.lift_fst]
      · simp only [Limits.pullback.lift_snd, Category.assoc]
    have L2 : Limits.pullback.lift (a ≫ f i) ((b ≫ r j) ≫ w j.1) h2 =
        b ≫ Limits.pullback.lift (f j) (r j ≫ w j.1) (hfr j) := by
      apply Limits.pullback.hom_ext
      · rw [Limits.pullback.lift_fst, Category.assoc, Limits.pullback.lift_fst, e]
      · simp only [Limits.pullback.lift_snd, Category.assoc]
    have key := MIb i.1 j.1 i.2 j.2 Z (a ≫ r i) (b ≫ r j) hab (fun z => by
      have H := hlam.2 (k i.1) (k j.1) Z (a ≫ f i) ((a ≫ r i) ≫ w i.1) ((b ≫ r j) ≫ w j.1)
        h1 h2 hab z
      rw [L1, L2, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply, hlab, hlab] at H
      exact H)
    simpa only [Category.assoc] using key

  obtain ⟨φ, hφ, -⟩ := hD T E (Fin n × Γ) X f hfet hfcov (fun i => r i ≫ σ i.1 i.2) hcomp
  have hφ' : ∀ i, f i ≫ φ = r i ≫ σ i.1 i.2 := hφ
  have hU := hD T U (Fin n × Γ) X f hfet hfcov (fun i => f i ≫ t) (fun i j Z a b e => by
    show a ≫ f i ≫ t = b ≫ f j ≫ t
    rw [← Category.assoc, e, Category.assoc])
  have h : φ ≫ p = t := by
    refine hU.unique (fun i => ?_) (fun i => rfl)
    show f i ≫ φ ≫ p = f i ≫ t
    rw [← Category.assoc, hφ' i, Category.assoc, hσ, hfr i, Category.assoc]
  refine ⟨φ, h, ?_⟩

  intro l x
  obtain ⟨M, hM1, hM2, hMx⟩ : ∃ M : Limits.pullback t (v l) ⟶ Limits.pullback p (v l),
      M ≫ Limits.pullback.fst p (v l) = Limits.pullback.fst t (v l) ≫ φ ∧
      M ≫ Limits.pullback.snd p (v l) = Limits.pullback.snd t (v l) ∧
      Λ l (Limits.pullback.map t (v l) p (v l) φ (𝟙 _) (𝟙 _) (by rw [Category.comp_id, h])
        (by simp) x) = Λ l (M x) :=
    ⟨Limits.pullback.map t (v l) p (v l) φ (𝟙 _) (𝟙 _) (by rw [Category.comp_id, h]) (by simp),
      by first
        | exact Limits.pullback.lift_fst _ _ _
        | simp,
      by first
        | exact (Limits.pullback.lift_snd _ _ _).trans (Category.comp_id _)
        | simp,
      rfl⟩
  rw [hMx]
  obtain ⟨i, x', hx'⟩ := hfcov (Limits.pullback.fst t (v l) x)
  obtain ⟨ζ, hζ1, hζ2⟩ := Scheme.Pullback.exists_preimage_pullback
    (f := f i) (g := Limits.pullback.fst t (v l)) x' x hx'
  have hζ1' : Limits.pullback.fst (f i) (Limits.pullback.fst t (v l)) ζ = x' := hζ1
  have hζ2' : Limits.pullback.snd (f i) (Limits.pullback.fst t (v l)) ζ = x := hζ2
  have cZ : Limits.pullback.fst (f i) (Limits.pullback.fst t (v l)) ≫ f i =
      Limits.pullback.snd (f i) (Limits.pullback.fst t (v l)) ≫ Limits.pullback.fst t (v l) :=
    Limits.pullback.condition
  have hE : (Limits.pullback.fst (f i) (Limits.pullback.fst t (v l)) ≫ r i) ≫ σ i.1 i.2 =
      (Limits.pullback.snd (f i) (Limits.pullback.fst t (v l)) ≫ M) ≫
        Limits.pullback.fst p (v l) := by
    rw [Category.assoc, Category.assoc, hM1, ← Category.assoc _ (Limits.pullback.fst t (v l)),
      ← cZ, Category.assoc, hφ' i]
  have hA : (Limits.pullback.snd (f i) (Limits.pullback.fst t (v l)) ≫
      Limits.pullback.fst t (v l)) ≫ t =
      ((Limits.pullback.fst (f i) (Limits.pullback.fst t (v l)) ≫ r i) ≫ w i.1) ≫ v (k i.1) := by
    rw [← cZ, Category.assoc, hfr i]; simp only [Category.assoc]
  have hB : (Limits.pullback.snd (f i) (Limits.pullback.fst t (v l)) ≫
      Limits.pullback.fst t (v l)) ≫ t =
      ((Limits.pullback.snd (f i) (Limits.pullback.fst t (v l)) ≫ M) ≫
        Limits.pullback.snd p (v l)) ≫ v l := by
    rw [Category.assoc, Limits.pullback.condition, Category.assoc
      (Limits.pullback.snd (f i) (Limits.pullback.fst t (v l))) M, hM2, Category.assoc]
  have hq := hA.symm.trans hB
  have E1 := hEval l i.1 i.2 _ (Limits.pullback.fst (f i) (Limits.pullback.fst t (v l)) ≫ r i)
    (Limits.pullback.snd (f i) (Limits.pullback.fst t (v l)) ≫ M) hE hq ζ
  have hqζ : (Limits.pullback.snd (f i) (Limits.pullback.fst t (v l)) ≫ M) ζ = M x := by
    rw [Scheme.Hom.comp_apply, hζ2']
  rw [hqζ] at E1
  have H := hlam.2 (k i.1) l _
    (Limits.pullback.snd (f i) (Limits.pullback.fst t (v l)) ≫ Limits.pullback.fst t (v l))
    ((Limits.pullback.fst (f i) (Limits.pullback.fst t (v l)) ≫ r i) ≫ w i.1)
    ((Limits.pullback.snd (f i) (Limits.pullback.fst t (v l)) ≫ M) ≫ Limits.pullback.snd p (v l))
    hA hB hq ζ
  have L3 : Limits.pullback.lift
      (Limits.pullback.snd (f i) (Limits.pullback.fst t (v l)) ≫ Limits.pullback.fst t (v l))
      ((Limits.pullback.snd (f i) (Limits.pullback.fst t (v l)) ≫ M) ≫
        Limits.pullback.snd p (v l)) hB =
      Limits.pullback.snd (f i) (Limits.pullback.fst t (v l)) := by
    apply Limits.pullback.hom_ext
    · rw [Limits.pullback.lift_fst]
    · rw [Limits.pullback.lift_snd, Category.assoc, hM2]
  have L4 : Limits.pullback.lift
      (Limits.pullback.snd (f i) (Limits.pullback.fst t (v l)) ≫ Limits.pullback.fst t (v l))
      ((Limits.pullback.fst (f i) (Limits.pullback.fst t (v l)) ≫ r i) ≫ w i.1) hA =
      Limits.pullback.fst (f i) (Limits.pullback.fst t (v l)) ≫
        Limits.pullback.lift (f i) (r i ≫ w i.1) (hfr i) := by
    apply Limits.pullback.hom_ext
    · rw [Limits.pullback.lift_fst, Category.assoc, Limits.pullback.lift_fst, cZ]
    · simp only [Limits.pullback.lift_snd, Category.assoc]
  rw [L3, L4, Scheme.Hom.comp_apply, hζ2', hζ1', hlab] at H
  exact H.trans E1.symm

theorem wc_gtor_rep_of_sheets : ∀ (U : Scheme.{u}) (Γ : Type) [Group Γ] (ι : Type) (V : ι → Scheme.{u}) (v : ∀ j, V j ⟶ U) (g : ∀ i j, ↥(Limits.pullback (v i) (v j)) → Γ), (∀ i j, IsLocallyConstant (g i j)) → wcGCocycle v g → ∀ (O : U.Opens), IsAffineOpen O → ∀ (n : ℕ) (W : Fin n → Scheme.{u}) (k : Fin n → ι) (w : ∀ m, W m ⟶ V (k m)) (E : Scheme.{u}) (π : E ⟶ (O : Scheme.{u})) (σ : ∀ m, Γ → (W m ⟶ E)), IsFinite π → Etale π → (∀ m, IsAffine (W m)) → (∀ m, Etale (w m ≫ v (k m))) → (∀ m γ, σ m γ ≫ π ≫ O.ι = w m ≫ v (k m)) → (∀ x : U, x ∈ O → ∃ m y, (w m ≫ v (k m)) y = x) → (∀ y : E, ∃ m γ x, σ m γ x = y) → (∀ (m m' : Fin n) (γ γ' : Γ) (Z : Scheme.{u}) (a : Z ⟶ W m) (b : Z ⟶ W m') (hab : (a ≫ w m) ≫ v (k m) = (b ≫ w m') ≫ v (k m')), (a ≫ σ m γ = b ≫ σ m' γ' ↔ ∀ z : Z, γ' = γ * g (k m) (k m') (Limits.pullback.lift (a ≫ w m) (b ≫ w m') hab z))) → ∃ Λ : ∀ l, ↥(Limits.pullback (π ≫ O.ι) (v l)) → Γ, wcGRep v g O (π ≫ O.ι) Λ :=
by
  intro U Γ _ ι V v g hgloc hG O hO n W k w E π σ hfin hetπ hWaff hwet hσ hWcov hσcov hmeet

  have hD : wcEtFamDescHyp.{u} := by
    intro T Y I X f hf hcov s hs
    have hsh : Presieve.IsSheaf Scheme.fpqcTopology (yoneda.obj Y) :=
      GrothendieckTopology.Subcanonical.isSheaf_of_isRepresentable _
    have hcov' : Sieve.generate (Presieve.ofArrows X f) ∈ Scheme.fpqcTopology T := by
      apply Precoverage.generate_mem_toGrothendieck
      refine ⟨?_, ?_⟩
      · have hqc : QuasiCompactCover (PreZeroHypercover.mk I X f) := by
          rw [quasiCompactCover_iff]
          intro V' hV'
          refine IsCompactOpenCovered.of_isOpenMap (fun i => (f i).continuous)
            (fun i => (haveI := hf i; (f i).isOpenMap)) ?_ V'.isOpen hV'.isCompact
          intro x _
          exact hcov x
        exact (Scheme.presieve₀_mem_qcPrecoverage_iff (E := PreZeroHypercover.mk I X f)).mpr hqc
      · exact (Scheme.ofArrows_mem_precoverage_iff (P := @Flat)).2
          ⟨hcov, fun i => by haveI := hf i; infer_instance⟩
    exact (Presieve.isSheafFor_arrows_iff (yoneda.obj Y) f).mp (hsh.isSheafFor _ hcov') s
      (fun i j Z a b hab => hs i j Z a b hab)

  haveI := hetπ
  have hσet : ∀ m γ, Etale (σ m γ) := by
    intro m γ
    haveI : Etale (σ m γ ≫ π ≫ O.ι) := by rw [hσ m γ]; exact hwet m
    exact Etale.of_comp (σ m γ) (π ≫ O.ι)
  have MIf : ∀ (m m' : Fin n) (γ γ' : Γ) (Z : Scheme.{u}) (a : Z ⟶ W m) (b : Z ⟶ W m')
      (hab : (a ≫ w m) ≫ v (k m) = (b ≫ w m') ≫ v (k m')), a ≫ σ m γ = b ≫ σ m' γ' →
      ∀ z : Z, γ' = γ * g (k m) (k m') (Limits.pullback.lift (a ≫ w m) (b ≫ w m') hab z) :=
    fun m m' γ γ' Z a b hab => (hmeet m m' γ γ' Z a b hab).mp
  have MIb : ∀ (m m' : Fin n) (γ γ' : Γ) (Z : Scheme.{u}) (a : Z ⟶ W m) (b : Z ⟶ W m')
      (hab : (a ≫ w m) ≫ v (k m) = (b ≫ w m') ≫ v (k m')),
      (∀ z : Z, γ' = γ * g (k m) (k m') (Limits.pullback.lift (a ≫ w m) (b ≫ w m') hab z)) →
      a ≫ σ m γ = b ≫ σ m' γ' :=
    fun m m' γ γ' Z a b hab => (hmeet m m' γ γ' Z a b hab).mpr
  have hR1 : Set.range (π ≫ O.ι) ⊆ (O : Set U) := by
    rintro _ ⟨e, rfl⟩
    have h1 : O.ι (π e) ∈ Set.range O.ι := ⟨_, rfl⟩
    rw [Scheme.Opens.range_ι] at h1
    rw [Scheme.Hom.comp_apply]
    exact h1

  obtain ⟨Λ, hΛloc, hEval⟩ := wc_gtor_sheet_lambda U Γ ι V v g hgloc hG n W k w E (π ≫ O.ι) σ
    hσet hσ hσcov MIf

  have hnat : ∀ {A A' B C D : Scheme.{u}} {f1 : B ⟶ D} {f2 : C ⟶ D} (c : A' ⟶ A) (x : A ⟶ B)
      (y : A ⟶ C) (h1 : x ≫ f1 = y ≫ f2) (h2 : (c ≫ x) ≫ f1 = (c ≫ y) ≫ f2) (z' : A'),
      Limits.pullback.lift (c ≫ x) (c ≫ y) h2 z' = Limits.pullback.lift x y h1 (c z') := by
    intro A A' B C D f1 f2 c x y h1 h2 z'
    have e : Limits.pullback.lift (c ≫ x) (c ≫ y) h2 = c ≫ Limits.pullback.lift x y h1 := by
      apply Limits.pullback.hom_ext
      · rw [Limits.pullback.lift_fst, Category.assoc, Limits.pullback.lift_fst]
      · rw [Limits.pullback.lift_snd, Category.assoc, Limits.pullback.lift_snd]
    rw [e, Scheme.Hom.comp_apply]
  have hcongr : ∀ {A B C D : Scheme.{u}} {f1 : B ⟶ D} {f2 : C ⟶ D} (x x' : A ⟶ B)
      (y y' : A ⟶ C) (hx : x = x') (hy : y = y') (h1 : x ≫ f1 = y ≫ f2)
      (h2 : x' ≫ f1 = y' ≫ f2), Limits.pullback.lift x y h1 = Limits.pullback.lift x' y' h2 := by
    intro A B C D f1 f2 x x' y y' hx hy h1 h2
    subst hx
    subst hy
    rfl

  have hfam : wcGFam v g (π ≫ O.ι) Λ := by
    refine ⟨hΛloc, ?_⟩
    intro l l' Z a b b' h h' h'' z
    obtain ⟨m, γ, x₀, hx₀⟩ := hσcov (a z)
    obtain ⟨ζ, hζ1, -⟩ :=
      Scheme.Pullback.exists_preimage_pullback (f := a) (g := σ m γ) z x₀ hx₀.symm
    have hζ1' : Limits.pullback.fst a (σ m γ) ζ = z := hζ1
    have hcond : Limits.pullback.fst a (σ m γ) ≫ a =
        Limits.pullback.snd a (σ m γ) ≫ σ m γ := Limits.pullback.condition
    have key : ∀ (l₀ : ι) (b₀ : Z ⟶ V l₀) (h₀ : a ≫ π ≫ O.ι = b₀ ≫ v l₀)
        (hab₀ : (Limits.pullback.snd a (σ m γ) ≫ w m) ≫ v (k m) =
          (Limits.pullback.fst a (σ m γ) ≫ b₀) ≫ v l₀),
        Λ l₀ (Limits.pullback.lift a b₀ h₀ z) =
          γ * g (k m) l₀ (Limits.pullback.lift (Limits.pullback.snd a (σ m γ) ≫ w m)
            (Limits.pullback.fst a (σ m γ) ≫ b₀) hab₀ ζ) := by
      intro l₀ b₀ h₀ hab₀
      have hA : Limits.pullback.snd a (σ m γ) ≫ σ m γ =
          (Limits.pullback.fst a (σ m γ) ≫ Limits.pullback.lift a b₀ h₀) ≫
            Limits.pullback.fst (π ≫ O.ι) (v l₀) := by
        rw [Category.assoc, Limits.pullback.lift_fst, hcond]
      have hs : (Limits.pullback.fst a (σ m γ) ≫ Limits.pullback.lift a b₀ h₀) ≫
          Limits.pullback.snd (π ≫ O.ι) (v l₀) = Limits.pullback.fst a (σ m γ) ≫ b₀ := by
        rw [Category.assoc, Limits.pullback.lift_snd]
      have hq : (Limits.pullback.snd a (σ m γ) ≫ w m) ≫ v (k m) =
          ((Limits.pullback.fst a (σ m γ) ≫ Limits.pullback.lift a b₀ h₀) ≫
            Limits.pullback.snd (π ≫ O.ι) (v l₀)) ≫ v l₀ := by
        rw [hs]; exact hab₀
      have E1 := hEval l₀ m γ _ (Limits.pullback.snd a (σ m γ))
        (Limits.pullback.fst a (σ m γ) ≫ Limits.pullback.lift a b₀ h₀) hA hq ζ
      rw [Scheme.Hom.comp_apply, hζ1'] at E1
      rw [E1, hcongr (Limits.pullback.snd a (σ m γ) ≫ w m)
        (Limits.pullback.snd a (σ m γ) ≫ w m) _ _ rfl hs hq hab₀]
    have hab₁ : (Limits.pullback.snd a (σ m γ) ≫ w m) ≫ v (k m) =
        (Limits.pullback.fst a (σ m γ) ≫ b) ≫ v l := by
      simp only [Category.assoc]
      rw [← hσ m γ, ← Limits.pullback.condition_assoc, h]
    have hab₂ : (Limits.pullback.snd a (σ m γ) ≫ w m) ≫ v (k m) =
        (Limits.pullback.fst a (σ m γ) ≫ b') ≫ v l' := by
      simp only [Category.assoc]
      rw [← hσ m γ, ← Limits.pullback.condition_assoc, h']
    have hbb : (Limits.pullback.fst a (σ m γ) ≫ b) ≫ v l =
        (Limits.pullback.fst a (σ m γ) ≫ b') ≫ v l' := by
      rw [Category.assoc, Category.assoc, h'']
    rw [key l b h hab₁, key l' b' h' hab₂,
      hG (k m) l l' _ (Limits.pullback.snd a (σ m γ) ≫ w m)
        (Limits.pullback.fst a (σ m γ) ≫ b) (Limits.pullback.fst a (σ m γ) ≫ b') hab₁ hbb hab₂ ζ,
      hnat (Limits.pullback.fst a (σ m γ)) b b' h'' hbb ζ, hζ1', mul_assoc]
  refine ⟨Λ, hR1, hfam, ?_⟩

  intro T t ht lam hlam
  have hcovT : ∀ τ : T, ∃ m y, (w m ≫ v (k m)) y = t τ := fun τ => hWcov (t τ) (ht ⟨τ, rfl⟩)
  obtain ⟨φ, h, hrep⟩ := wc_gtor_sheet_rep_exists hD U Γ ι V v g n W k w E (π ≫ O.ι) σ hwet hσ
    MIb Λ hEval T t hcovT lam hlam
  refine ⟨φ, ⟨h, hrep⟩, ?_⟩
  rintro φ' ⟨h', hrep'⟩
  exact wc_gtor_sheet_rep_unique hD U Γ ι V v g hG n W k w E (π ≫ O.ι) σ hσet hσ hσcov MIb Λ
    hEval T t lam φ' φ h' h hrep' hrep

theorem wc_gtor_glue_transitions : ∀ (U : Scheme.{u}) (Γ : Type) [Group Γ] (ι : Type) (V : ι → Scheme.{u}) (v : ∀ j, V j ⟶ U) (g : ∀ i j, ↥(Limits.pullback (v i) (v j)) → Γ) (J : Type u) (O : J → U.Opens) (E : J → Scheme.{u}) (q : ∀ i, E i ⟶ U) (Λ : ∀ i l, ↥(Limits.pullback (q i) (v l)) → Γ), (∀ i, wcGRep v g (O i) (q i) (Λ i)) → ∃ τ : ∀ i j, ((q i ⁻¹ᵁ O j : (E i).Opens) : Scheme.{u}) ⟶ E j, (∀ i j, τ i j ≫ q j = (q i ⁻¹ᵁ O j).ι ≫ q i) ∧ (∀ i (T : Scheme.{u}) (h : T ⟶ ((q i ⁻¹ᵁ O i : (E i).Opens) : Scheme.{u})), h ≫ τ i i = h ≫ (q i ⁻¹ᵁ O i).ι) ∧ (∀ i j k (T : Scheme.{u}) (h₁ : T ⟶ ((q i ⁻¹ᵁ O j : (E i).Opens) : Scheme.{u})) (h₂ : T ⟶ ((q j ⁻¹ᵁ O k : (E j).Opens) : Scheme.{u})) (h₃ : T ⟶ ((q i ⁻¹ᵁ O k : (E i).Opens) : Scheme.{u})), h₂ ≫ (q j ⁻¹ᵁ O k).ι = h₁ ≫ τ i j → h₃ ≫ (q i ⁻¹ᵁ O k).ι = h₁ ≫ (q i ⁻¹ᵁ O j).ι → h₂ ≫ τ j k = h₃ ≫ τ i k) ∧ (∀ i j (l : ι) (Z : Scheme.{u}) (a : Z ⟶ ((q i ⁻¹ᵁ O j : (E i).Opens) : Scheme.{u})) (c : Z ⟶ V l) (h₁ : (a ≫ (q i ⁻¹ᵁ O j).ι) ≫ q i = c ≫ v l) (h₂ : (a ≫ τ i j) ≫ q j = c ≫ v l) (z : Z), Λ i l (Limits.pullback.lift (a ≫ (q i ⁻¹ᵁ O j).ι) c h₁ z) = Λ j l (Limits.pullback.lift (a ≫ τ i j) c h₂ z)) :=
by
  intro U Γ _ ι V v g J O E q Λ hrep

  have hm' : ∀ {T E' : Scheme.{u}} (t : T ⟶ U) (q' : E' ⟶ U) (φ : T ⟶ E') (h : φ ≫ q' = t)
      (l : ι) (Z : Scheme.{u}) (a : Z ⟶ T) (c : Z ⟶ V l) (ha : a ≫ t = c ≫ v l)
      (ha' : (a ≫ φ) ≫ q' = c ≫ v l),
      Limits.pullback.lift a c ha ≫ Limits.pullback.map t (v l) q' (v l) φ (𝟙 _) (𝟙 _)
        (by rw [Category.comp_id, h]) (by simp) = Limits.pullback.lift (a ≫ φ) c ha' := by
    intro T E' t q' φ h l Z a c ha ha'
    apply Limits.pullback.hom_ext
    · calc (Limits.pullback.lift a c ha ≫ Limits.pullback.map t (v l) q' (v l) φ (𝟙 _) (𝟙 _)
            (by rw [Category.comp_id, h]) (by simp)) ≫ Limits.pullback.fst q' (v l)
          = Limits.pullback.lift a c ha ≫ (Limits.pullback.fst t (v l) ≫ φ) := by
            rw [Category.assoc]; congr 1; exact Limits.pullback.lift_fst _ _ _
        _ = a ≫ φ := by rw [← Category.assoc, Limits.pullback.lift_fst]
        _ = _ := (Limits.pullback.lift_fst _ _ _).symm
    · calc (Limits.pullback.lift a c ha ≫ Limits.pullback.map t (v l) q' (v l) φ (𝟙 _) (𝟙 _)
            (by rw [Category.comp_id, h]) (by simp)) ≫ Limits.pullback.snd q' (v l)
          = Limits.pullback.lift a c ha ≫ (Limits.pullback.snd t (v l) ≫ 𝟙 _) := by
            rw [Category.assoc]; congr 1; exact Limits.pullback.lift_snd _ _ _
        _ = c := by rw [Category.comp_id, Limits.pullback.lift_snd]
        _ = _ := (Limits.pullback.lift_snd _ _ _).symm

  have hMz : ∀ {T E' : Scheme.{u}} (t : T ⟶ U) (q' : E' ⟶ U) (φ : T ⟶ E') (h : φ ≫ q' = t)
      (l : ι) (Z : Scheme.{u}) (a : Z ⟶ T) (c : Z ⟶ V l) (ha : a ≫ t = c ≫ v l)
      (ha' : (a ≫ φ) ≫ q' = c ≫ v l) (z : Z),
      Limits.pullback.map t (v l) q' (v l) φ (𝟙 _) (𝟙 _) (by rw [Category.comp_id, h]) (by simp)
        (Limits.pullback.lift a c ha z) = Limits.pullback.lift (a ≫ φ) c ha' z := by
    intro T E' t q' φ h l Z a c ha ha' z
    rw [← hm' t q' φ h l Z a c ha ha', Scheme.Hom.comp_apply]

  have hM0 : ∀ {T E' : Scheme.{u}} (t : T ⟶ U) (q' : E' ⟶ U) (φ : T ⟶ E') (h : φ ≫ q' = t)
      (l : ι),
      Limits.pullback.map t (v l) q' (v l) φ (𝟙 _) (𝟙 _) (by rw [Category.comp_id, h]) (by simp) =
        Limits.pullback.lift (Limits.pullback.fst t (v l) ≫ φ) (Limits.pullback.snd t (v l))
          (by rw [Category.assoc, h, Limits.pullback.condition]) := by
    intro T E' t q' φ h l
    have e := hm' t q' φ h l _ (Limits.pullback.fst t (v l)) (Limits.pullback.snd t (v l))
      Limits.pullback.condition (by rw [Category.assoc, h, Limits.pullback.condition])
    rw [Limits.pullback.lift_fst_snd, Category.id_comp] at e
    exact e

  have LC : ∀ {A : Scheme.{u}} (q' : A ⟶ U) (l : ι) (Z : Scheme.{u}) (x y : Z ⟶ A)
      (c : Z ⟶ V l) (hx : x ≫ q' = c ≫ v l) (hy : y ≫ q' = c ≫ v l), x = y →
      Limits.pullback.lift x c hx = Limits.pullback.lift y c hy := by
    intro A q' l Z x y c hx hy hxy
    subst hxy
    rfl

  have hpull : ∀ {T T' : Scheme.{u}} (t : T ⟶ U) (t' : T' ⟶ U) (f : T' ⟶ T) (hf : f ≫ t = t')
      (lam : ∀ l, ↥(Limits.pullback t (v l)) → Γ), wcGFam v g t lam →
      wcGFam v g t' (fun l w => lam l (Limits.pullback.map t' (v l) t (v l) f (𝟙 _) (𝟙 _)
        (by rw [Category.comp_id, hf]) (by simp) w)) := by
    intro T T' t t' f hf lam hlam
    refine ⟨fun l => (hlam.1 l).comp_continuous
      (Limits.pullback.map t' (v l) t (v l) f (𝟙 _) (𝟙 _)
        (by rw [Category.comp_id, hf]) (by simp)).continuous, ?_⟩
    intro l l' Z a b b' h h' h'' z
    have hA : (a ≫ f) ≫ t = b ≫ v l := by rw [Category.assoc, hf, h]
    have hA' : (a ≫ f) ≫ t = b' ≫ v l' := by rw [Category.assoc, hf, h']
    have e1 := hMz t' t f hf l Z a b h hA z
    have e2 := hMz t' t f hf l' Z a b' h' hA' z
    have e3 := hlam.2 l l' Z (a ≫ f) b b' hA hA' h'' z
    show lam l' _ = lam l _ * _
    rw [e1, e2]
    exact e3

  have hrange : ∀ {E' : Scheme.{u}} (q' : E' ⟶ U) (O' : U.Opens),
      Set.range ((q' ⁻¹ᵁ O').ι ≫ q') ⊆ (O' : Set U) := by
    rintro E' q' O' _ ⟨y, rfl⟩
    rw [Scheme.Hom.comp_apply]
    exact (Scheme.Opens.range_ι (q' ⁻¹ᵁ O')).subset ⟨y, rfl⟩

  have hrig : ∀ (O' : U.Opens) (E' : Scheme.{u}) (q' : E' ⟶ U)
      (Λ' : ∀ l, ↥(Limits.pullback q' (v l)) → Γ),
      wcGRep v g O' q' Λ' → ∀ (T : Scheme.{u}) (t : T ⟶ U), Set.range t ⊆ (O' : Set U) →
      ∀ (φ₁ φ₂ : T ⟶ E'), φ₁ ≫ q' = t → φ₂ ≫ q' = t →
      (∀ (l : ι) (Z : Scheme.{u}) (a : Z ⟶ T) (c : Z ⟶ V l) (h₁ : (a ≫ φ₁) ≫ q' = c ≫ v l)
        (h₂ : (a ≫ φ₂) ≫ q' = c ≫ v l) (z : Z),
        Λ' l (Limits.pullback.lift (a ≫ φ₁) c h₁ z) =
          Λ' l (Limits.pullback.lift (a ≫ φ₂) c h₂ z)) →
      φ₁ = φ₂ := by
    intro O' E' q' Λ' hR T t ht φ₁ φ₂ hφ₁ hφ₂ H
    have hfam := hpull q' t φ₁ hφ₁ Λ' hR.2.1
    obtain ⟨φ, -, huniq⟩ := hR.2.2 T t ht _ hfam
    have e1 := huniq φ₁ ⟨hφ₁, fun l w => rfl⟩
    have hw2 : ∀ (l : ι) (w : ↥(Limits.pullback t (v l))),
        Λ' l (Limits.pullback.map t (v l) q' (v l) φ₁ (𝟙 _) (𝟙 _)
          (by rw [Category.comp_id, hφ₁]) (by simp) w) =
        Λ' l (Limits.pullback.map t (v l) q' (v l) φ₂ (𝟙 _) (𝟙 _)
          (by rw [Category.comp_id, hφ₂]) (by simp) w) := by
      intro l w
      rw [hM0 t q' φ₁ hφ₁ l, hM0 t q' φ₂ hφ₂ l]
      exact H l _ _ _ _ _ w
    have e2 := huniq φ₂ ⟨hφ₂, hw2⟩
    exact e1.trans e2.symm

  have hp : ∀ i j, ∃ τ : ((q i ⁻¹ᵁ O j : (E i).Opens) : Scheme.{u}) ⟶ E j,
      τ ≫ q j = (q i ⁻¹ᵁ O j).ι ≫ q i ∧
      ∀ (l : ι) (Z : Scheme.{u}) (a : Z ⟶ ((q i ⁻¹ᵁ O j : (E i).Opens) : Scheme.{u}))
        (c : Z ⟶ V l) (h₁ : (a ≫ (q i ⁻¹ᵁ O j).ι) ≫ q i = c ≫ v l)
        (h₂ : (a ≫ τ) ≫ q j = c ≫ v l) (z : Z),
        Λ i l (Limits.pullback.lift (a ≫ (q i ⁻¹ᵁ O j).ι) c h₁ z) =
          Λ j l (Limits.pullback.lift (a ≫ τ) c h₂ z) := by
    intro i j
    have hfam := hpull (q i) ((q i ⁻¹ᵁ O j).ι ≫ q i) (q i ⁻¹ᵁ O j).ι rfl (Λ i) (hrep i).2.1
    obtain ⟨τ, ⟨hτq, hτrep⟩, -⟩ := (hrep j).2.2 _ _ (hrange (q i) (O j)) _ hfam
    refine ⟨τ, hτq, ?_⟩
    intro l Z a c h₁ h₂ z
    have ha : a ≫ ((q i ⁻¹ᵁ O j).ι ≫ q i) = c ≫ v l := (Category.assoc _ _ _).symm.trans h₁
    have e1 := hτrep l (Limits.pullback.lift a c ha z)
    have e2 := hMz ((q i ⁻¹ᵁ O j).ι ≫ q i) (q i) (q i ⁻¹ᵁ O j).ι rfl l Z a c ha h₁ z
    have e3 := hMz _ (q j) τ hτq l Z a c ha h₂ z
    exact (congrArg (Λ i l) e2).symm.trans (e1.trans (congrArg (Λ j l) e3))
  choose τ hτq hτ using hp
  refine ⟨τ, hτq, ?_, ?_, hτ⟩
  ·
    intro i T h
    have hid : τ i i = (q i ⁻¹ᵁ O i).ι :=
      hrig (O i) (E i) (q i) (Λ i) (hrep i) _ ((q i ⁻¹ᵁ O i).ι ≫ q i) (hrange (q i) (O i))
        (τ i i) (q i ⁻¹ᵁ O i).ι (hτq i i) rfl
        (fun l Z a c h₁ h₂ z => (hτ i i l Z a c h₂ h₁ z).symm)
    rw [hid]
  ·
    intro i j k T h₁ h₂ h₃ H2 H3
    have ht : Set.range (h₃ ≫ (q i ⁻¹ᵁ O k).ι ≫ q i) ⊆ (O k : Set U) := by
      rintro _ ⟨x, rfl⟩
      rw [Scheme.Hom.comp_apply]
      exact hrange (q i) (O k) ⟨h₃ x, rfl⟩
    have hφ₂ : (h₃ ≫ τ i k) ≫ q k = h₃ ≫ (q i ⁻¹ᵁ O k).ι ≫ q i := by
      rw [Category.assoc, hτq i k]
    have hφ₁ : (h₂ ≫ τ j k) ≫ q k = h₃ ≫ (q i ⁻¹ᵁ O k).ι ≫ q i :=
      calc (h₂ ≫ τ j k) ≫ q k = h₂ ≫ (q j ⁻¹ᵁ O k).ι ≫ q j := by rw [Category.assoc, hτq j k]
        _ = (h₂ ≫ (q j ⁻¹ᵁ O k).ι) ≫ q j := (Category.assoc _ _ _).symm
        _ = (h₁ ≫ τ i j) ≫ q j := by rw [H2]
        _ = h₁ ≫ (q i ⁻¹ᵁ O j).ι ≫ q i := by rw [Category.assoc, hτq i j]
        _ = (h₁ ≫ (q i ⁻¹ᵁ O j).ι) ≫ q i := (Category.assoc _ _ _).symm
        _ = (h₃ ≫ (q i ⁻¹ᵁ O k).ι) ≫ q i := by rw [H3]
        _ = h₃ ≫ (q i ⁻¹ᵁ O k).ι ≫ q i := Category.assoc _ _ _
    refine hrig (O k) (E k) (q k) (Λ k) (hrep k) T (h₃ ≫ (q i ⁻¹ᵁ O k).ι ≫ q i) ht
      (h₂ ≫ τ j k) (h₃ ≫ τ i k) hφ₁ hφ₂ ?_
    intro l Z a c e₁ e₂ z
    have m3 : (a ≫ h₂) ≫ (q j ⁻¹ᵁ O k).ι = (a ≫ h₁) ≫ τ i j := by
      simp only [Category.assoc, H2]
    have m5 : (a ≫ h₁) ≫ (q i ⁻¹ᵁ O j).ι = (a ≫ h₃) ≫ (q i ⁻¹ᵁ O k).ι := by
      simp only [Category.assoc, H3]
    have p1 : ((a ≫ h₂) ≫ τ j k) ≫ q k = c ≫ v l := by
      simpa only [Category.assoc] using e₁
    have p2 : ((a ≫ h₂) ≫ (q j ⁻¹ᵁ O k).ι) ≫ q j = c ≫ v l := by
      simpa only [Category.assoc, hτq j k] using e₁
    have p3 : ((a ≫ h₁) ≫ τ i j) ≫ q j = c ≫ v l := by
      rw [← m3]; exact p2
    have p4 : ((a ≫ h₁) ≫ (q i ⁻¹ᵁ O j).ι) ≫ q i = c ≫ v l := by
      simpa only [Category.assoc, hτq i j] using p3
    have p5 : ((a ≫ h₃) ≫ (q i ⁻¹ᵁ O k).ι) ≫ q i = c ≫ v l := by
      rw [← m5]; exact p4
    have p6 : ((a ≫ h₃) ≫ τ i k) ≫ q k = c ≫ v l := by
      simpa only [Category.assoc] using e₂
    calc Λ k l (Limits.pullback.lift (a ≫ h₂ ≫ τ j k) c e₁ z)
        = Λ k l (Limits.pullback.lift ((a ≫ h₂) ≫ τ j k) c p1 z) := by
          rw [LC (q k) l Z _ _ c e₁ p1 (Category.assoc _ _ _).symm]
      _ = Λ j l (Limits.pullback.lift ((a ≫ h₂) ≫ (q j ⁻¹ᵁ O k).ι) c p2 z) :=
          (hτ j k l Z (a ≫ h₂) c p2 p1 z).symm
      _ = Λ j l (Limits.pullback.lift ((a ≫ h₁) ≫ τ i j) c p3 z) := by
          rw [LC (q j) l Z _ _ c p2 p3 m3]
      _ = Λ i l (Limits.pullback.lift ((a ≫ h₁) ≫ (q i ⁻¹ᵁ O j).ι) c p4 z) :=
          (hτ i j l Z (a ≫ h₁) c p4 p3 z).symm
      _ = Λ i l (Limits.pullback.lift ((a ≫ h₃) ≫ (q i ⁻¹ᵁ O k).ι) c p5 z) := by
          rw [LC (q i) l Z _ _ c p4 p5 m5]
      _ = Λ k l (Limits.pullback.lift ((a ≫ h₃) ≫ τ i k) c p6 z) :=
          hτ i k l Z (a ≫ h₃) c p5 p6 z
      _ = Λ k l (Limits.pullback.lift (a ≫ h₃ ≫ τ i k) c e₂ z) := by
          rw [LC (q k) l Z _ _ c p6 e₂ (Category.assoc _ _ _)]

theorem wc_gtor_glue_fin_etale : ∀ (U : Scheme.{u}) (J : Type u) (O : J → U.Opens) (E : J → Scheme.{u}) (π : ∀ i, E i ⟶ (O i : Scheme.{u})) (W : Scheme.{u}) (p : W ⟶ U) (κ : ∀ i, E i ⟶ W), (∀ x : U, ∃ i, x ∈ O i) → (∀ i, IsOpenImmersion (κ i)) → (∀ i, κ i ≫ p = π i ≫ (O i).ι) → (∀ i, Set.range (κ i) = p ⁻¹' (O i : Set U)) → (∀ i, IsFinite (π i)) → (∀ i, Etale (π i)) → IsFinite p ∧ Etale p :=
by
  intro U J O E π W p κ Hcov Hopen Hcomm Hrange Hfin Het
  have hsup : iSup O = ⊤ := by
    rw [eq_top_iff]
    intro x _
    rw [TopologicalSpace.Opens.mem_iSup]
    exact Hcov x
  have hres : ∀ i, ∃ e : E i ≅ ((p ⁻¹ᵁ O i : W.Opens) : Scheme.{u}), p ∣_ O i = e.inv ≫ π i := by
    intro i
    have := Hopen i
    have hr : Set.range (κ i) = Set.range (p ⁻¹ᵁ O i).ι := by
      rw [Scheme.Opens.range_ι, Scheme.Hom.coe_preimage, Hrange i]
    refine ⟨IsOpenImmersion.isoOfRangeEq (κ i) (p ⁻¹ᵁ O i).ι hr, ?_⟩
    rw [Iso.eq_inv_comp, ← cancel_mono (O i).ι, Category.assoc, morphismRestrict_ι,
      ← Category.assoc, IsOpenImmersion.isoOfRangeEq_hom_fac, Hcomm]
  have hfin : IsFinite p := by
    refine @IsZariskiLocalAtTarget.of_iSup_eq_top @IsFinite
      (@HasAffineProperty.instIsZariskiLocalAtTarget @IsFinite
        (fun X _ f _ => IsAffine X ∧ f.appTop.hom.Finite)
        IsFinite.instHasAffinePropertyAndIsAffineFiniteCarrierObjOppositeOpensCarrierCarrierCommRingCatPresheafOpOpensTopHomAppTop)
      W U p J O hsup ?_
    intro i
    obtain ⟨e, he⟩ := hres i
    have := Hfin i
    rw [he]
    infer_instance
  have het : Etale p := by
    refine @IsZariskiLocalAtTarget.of_iSup_eq_top @Etale
      (HasRingHomProperty.instIsZariskiLocalAtTarget (P := @Etale)) W U p J O hsup ?_
    intro i
    obtain ⟨e, he⟩ := hres i
    have := Het i
    rw [he]
    infer_instance
  exact ⟨hfin, het⟩

theorem wc_gtor_glue_family : ∀ (U : Scheme.{u}) (Γ : Type) [Group Γ] (ι : Type) (V : ι → Scheme.{u}) (v : ∀ j, V j ⟶ U) (g : ∀ i j, ↥(Limits.pullback (v i) (v j)) → Γ) (J : Type u) (O : J → U.Opens) (E : J → Scheme.{u}) (q : ∀ i, E i ⟶ U) (Λ : ∀ i l, ↥(Limits.pullback (q i) (v l)) → Γ), (∀ i, wcGFam v g (q i) (Λ i)) → ∀ (τ : ∀ i j, ((q i ⁻¹ᵁ O j : (E i).Opens) : Scheme.{u}) ⟶ E j), (∀ i j (l : ι) (Z : Scheme.{u}) (a : Z ⟶ ((q i ⁻¹ᵁ O j : (E i).Opens) : Scheme.{u})) (c : Z ⟶ V l) (h₁ : (a ≫ (q i ⁻¹ᵁ O j).ι) ≫ q i = c ≫ v l) (h₂ : (a ≫ τ i j) ≫ q j = c ≫ v l) (z : Z), Λ i l (Limits.pullback.lift (a ≫ (q i ⁻¹ᵁ O j).ι) c h₁ z) = Λ j l (Limits.pullback.lift (a ≫ τ i j) c h₂ z)) → ∀ (W : Scheme.{u}) (p : W ⟶ U) (κ : ∀ i, E i ⟶ W), (∀ i, IsOpenImmersion (κ i)) → (∀ i, κ i ≫ p = q i) → (∀ w : W, ∃ i y, κ i y = w) → (∀ i j (T : Scheme.{u}) (h₁ : T ⟶ E i) (h₂ : T ⟶ E j), h₁ ≫ κ i = h₂ ≫ κ j → ∃ h' : T ⟶ ((q i ⁻¹ᵁ O j : (E i).Opens) : Scheme.{u}), h' ≫ (q i ⁻¹ᵁ O j).ι = h₁ ∧ h' ≫ τ i j = h₂) → ∃ Λg : ∀ l, ↥(Limits.pullback p (v l)) → Γ, wcGFam v g p Λg ∧ ∀ i (l : ι) (Z : Scheme.{u}) (a : Z ⟶ E i) (c : Z ⟶ V l) (h₁ : a ≫ q i = c ≫ v l) (h₂ : (a ≫ κ i) ≫ p = c ≫ v l) (z : Z), Λ i l (Limits.pullback.lift a c h₁ z) = Λg l (Limits.pullback.lift (a ≫ κ i) c h₂ z) :=
by
  classical
  intro U Γ _ ι V v g J O E q Λ hfam τ hτ W p κ hopen hκp hsurj hfact

  obtain ⟨m, hmfst, hmsnd, hmopen, hmcov⟩ : ∃ m : ∀ (l : ι) (i : J),
      Limits.pullback (q i) (v l) ⟶ Limits.pullback p (v l),
      (∀ l i, m l i ≫ Limits.pullback.fst p (v l) = Limits.pullback.fst (q i) (v l) ≫ κ i) ∧
      (∀ l i, m l i ≫ Limits.pullback.snd p (v l) = Limits.pullback.snd (q i) (v l)) ∧
      (∀ l i, IsOpenMap (m l i)) ∧
      (∀ l (w : ↥(Limits.pullback p (v l))), ∃ i, ∃ w' : ↥(Limits.pullback (q i) (v l)),
        m l i w' = w) := by
    refine ⟨fun l i => Limits.pullback.map (q i) (v l) p (v l) (κ i) (𝟙 _) (𝟙 _)
        (by rw [Category.comp_id, hκp i]) (by simp),
      fun l i => Limits.pullback.lift_fst _ _ _,
      fun l i => (Limits.pullback.lift_snd _ _ _).trans (Category.comp_id _),
      fun l i => ?_, fun l w => ?_⟩
    · haveI := hopen i
      exact (Limits.pullback.map (q i) (v l) p (v l) (κ i) (𝟙 _) (𝟙 _)
        (by rw [Category.comp_id, hκp i]) (by simp)).isOpenEmbedding.isOpenMap
    · obtain ⟨i, y, hy⟩ := hsurj (Limits.pullback.fst p (v l) w)
      have hr := Scheme.Pullback.range_map (q i) (v l) p (v l) (κ i) (𝟙 _) (𝟙 _)
        (by rw [Category.comp_id, hκp i]) (by simp)
      have hw : w ∈ Set.range (Limits.pullback.map (q i) (v l) p (v l) (κ i) (𝟙 _) (𝟙 _)
          (by rw [Category.comp_id, hκp i]) (by simp)) := by
        rw [hr]
        exact ⟨⟨y, hy⟩, ⟨Limits.pullback.snd p (v l) w, by first | rfl | simp⟩⟩
      obtain ⟨w', hw'⟩ := hw
      exact ⟨i, w', hw'⟩

  have hov : ∀ (l : ι) (i j : J) (w₁ : ↥(Limits.pullback (q i) (v l)))
      (w₂ : ↥(Limits.pullback (q j) (v l))), m l i w₁ = m l j w₂ → Λ i l w₁ = Λ j l w₂ := by
    intro l i j w₁ w₂ heq
    obtain ⟨r, hr1, hr2⟩ :=
      Scheme.Pullback.exists_preimage_pullback (f := m l i) (g := m l j) w₁ w₂ heq
    set F := Limits.pullback.fst (m l i) (m l j) with hF
    set S := Limits.pullback.snd (m l i) (m l j) with hS
    have hc : F ≫ m l i = S ≫ m l j := Limits.pullback.condition
    have hK : (F ≫ Limits.pullback.fst (q i) (v l)) ≫ κ i =
        (S ≫ Limits.pullback.fst (q j) (v l)) ≫ κ j := by
      simp only [Category.assoc]
      rw [← hmfst l i, ← hmfst l j, ← Category.assoc, hc, Category.assoc]
    have hC : F ≫ Limits.pullback.snd (q i) (v l) = S ≫ Limits.pullback.snd (q j) (v l) := by
      rw [← hmsnd l i, ← hmsnd l j, ← Category.assoc, hc, Category.assoc]
    obtain ⟨h', hh1, hh2⟩ := hfact i j _ _ _ hK
    have e1 : (h' ≫ (q i ⁻¹ᵁ O j).ι) ≫ q i = (F ≫ Limits.pullback.snd (q i) (v l)) ≫ v l := by
      rw [hh1]
      simp only [Category.assoc]
      rw [Limits.pullback.condition]
    have e2 : (h' ≫ τ i j) ≫ q j = (F ≫ Limits.pullback.snd (q i) (v l)) ≫ v l := by
      rw [hh2, hC]
      simp only [Category.assoc]
      rw [Limits.pullback.condition]
    have key := hτ i j l _ h' (F ≫ Limits.pullback.snd (q i) (v l)) e1 e2 r
    have L1 : Limits.pullback.lift (h' ≫ (q i ⁻¹ᵁ O j).ι)
        (F ≫ Limits.pullback.snd (q i) (v l)) e1 = F := by
      apply Limits.pullback.hom_ext
      · rw [Limits.pullback.lift_fst, hh1]
      · rw [Limits.pullback.lift_snd]
    have L2 : Limits.pullback.lift (h' ≫ τ i j) (F ≫ Limits.pullback.snd (q i) (v l)) e2 = S := by
      apply Limits.pullback.hom_ext
      · rw [Limits.pullback.lift_fst, hh2]
      · rw [Limits.pullback.lift_snd, hC]
    rw [L1, L2, hr1, hr2] at key
    exact key

  choose iw ww hww using hmcov
  obtain ⟨Λg, hΛgdef⟩ : ∃ Λg : ∀ l, ↥(Limits.pullback p (v l)) → Γ,
      ∀ l w, Λg l w = Λ (iw l w) l (ww l w) := ⟨_, fun _ _ => rfl⟩
  have hΛg : ∀ (l : ι) (i : J) (y : ↥(Limits.pullback (q i) (v l))), Λg l (m l i y) = Λ i l y :=
    fun l i y => (hΛgdef l _).trans (hov l _ _ _ _ (hww l _))
  have hloc : ∀ l, IsLocallyConstant (Λg l) := by
    intro l
    rw [IsLocallyConstant.iff_isOpen_fiber]
    intro γ
    have hset : Λg l ⁻¹' {γ} = ⋃ i, m l i '' (Λ i l ⁻¹' {γ}) := by
      ext w
      simp only [Set.mem_preimage, Set.mem_singleton_iff, Set.mem_iUnion, Set.mem_image]
      constructor
      · intro hw
        exact ⟨iw l w, ww l w, (hΛgdef l w).symm.trans hw, hww l w⟩
      · rintro ⟨i, y, hy, rfl⟩
        rw [hΛg]
        exact hy
    rw [hset]
    exact isOpen_iUnion (fun i => hmopen l i _
      (IsLocallyConstant.iff_isOpen_fiber.mp ((hfam i).1 l) γ))

  have hG : ∀ i (l : ι) (Z : Scheme.{u}) (a : Z ⟶ E i) (c : Z ⟶ V l) (h₁ : a ≫ q i = c ≫ v l)
      (h₂ : (a ≫ κ i) ≫ p = c ≫ v l) (z : Z),
      Λ i l (Limits.pullback.lift a c h₁ z) = Λg l (Limits.pullback.lift (a ≫ κ i) c h₂ z) := by
    intro i l Z a c h₁ h₂ z
    have hc : Limits.pullback.lift a c h₁ ≫ m l i = Limits.pullback.lift (a ≫ κ i) c h₂ := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, hmfst, Limits.pullback.lift_fst_assoc, Limits.pullback.lift_fst]
      · rw [Category.assoc, hmsnd, Limits.pullback.lift_snd, Limits.pullback.lift_snd]
    rw [← hc, Scheme.Hom.comp_apply, hΛg]

  have hcompat : ∀ (l l' : ι) (Z : Scheme.{u}) (a : Z ⟶ W) (b : Z ⟶ V l) (b' : Z ⟶ V l')
      (h : a ≫ p = b ≫ v l) (h' : a ≫ p = b' ≫ v l') (h'' : b ≫ v l = b' ≫ v l') (z : Z),
      Λg l' (Limits.pullback.lift a b' h' z) =
        Λg l (Limits.pullback.lift a b h z) * g l l' (Limits.pullback.lift b b' h'' z) := by
    intro l l' Z a b b' h h' h'' z
    obtain ⟨i, y, hy⟩ := hsurj (a z)
    obtain ⟨ζ, hζ1, hζ2⟩ :=
      Scheme.Pullback.exists_preimage_pullback (f := a) (g := κ i) z y hy.symm
    set π₁ := Limits.pullback.fst a (κ i) with hπ₁
    set ai := Limits.pullback.snd a (κ i) with hai
    have hsq : π₁ ≫ a = ai ≫ κ i := Limits.pullback.condition
    have hl : ai ≫ q i = (π₁ ≫ b) ≫ v l := by
      calc ai ≫ q i = (ai ≫ κ i) ≫ p := by rw [Category.assoc, hκp i]
        _ = (π₁ ≫ a) ≫ p := by rw [hsq]
        _ = (π₁ ≫ b) ≫ v l := by simp only [Category.assoc, h]
    have hl' : ai ≫ q i = (π₁ ≫ b') ≫ v l' := by
      calc ai ≫ q i = (ai ≫ κ i) ≫ p := by rw [Category.assoc, hκp i]
        _ = (π₁ ≫ a) ≫ p := by rw [hsq]
        _ = (π₁ ≫ b') ≫ v l' := by simp only [Category.assoc, h']
    have hl'' : (π₁ ≫ b) ≫ v l = (π₁ ≫ b') ≫ v l' := by
      simp only [Category.assoc, h'']
    have key := (hfam i).2 l l' _ ai (π₁ ≫ b) (π₁ ≫ b') hl hl' hl'' ζ
    have k2 : (ai ≫ κ i) ≫ p = (π₁ ≫ b) ≫ v l := by rw [Category.assoc, hκp i]; exact hl
    have k2' : (ai ≫ κ i) ≫ p = (π₁ ≫ b') ≫ v l' := by rw [Category.assoc, hκp i]; exact hl'
    rw [hG i l _ ai (π₁ ≫ b) hl k2, hG i l' _ ai (π₁ ≫ b') hl' k2'] at key
    have P1 : Limits.pullback.lift (ai ≫ κ i) (π₁ ≫ b) k2 = π₁ ≫ Limits.pullback.lift a b h := by
      apply Limits.pullback.hom_ext
      · rw [Limits.pullback.lift_fst, Category.assoc, Limits.pullback.lift_fst, hsq]
      · rw [Limits.pullback.lift_snd, Category.assoc, Limits.pullback.lift_snd]
    have P2 : Limits.pullback.lift (ai ≫ κ i) (π₁ ≫ b') k2' =
        π₁ ≫ Limits.pullback.lift a b' h' := by
      apply Limits.pullback.hom_ext
      · rw [Limits.pullback.lift_fst, Category.assoc, Limits.pullback.lift_fst, hsq]
      · rw [Limits.pullback.lift_snd, Category.assoc, Limits.pullback.lift_snd]
    have P3 : Limits.pullback.lift (π₁ ≫ b) (π₁ ≫ b') hl'' =
        π₁ ≫ Limits.pullback.lift b b' h'' := by
      apply Limits.pullback.hom_ext
      · rw [Limits.pullback.lift_fst, Category.assoc, Limits.pullback.lift_fst]
      · rw [Limits.pullback.lift_snd, Category.assoc, Limits.pullback.lift_snd]
    rw [P1, P2, P3] at key
    simp only [Scheme.Hom.comp_apply] at key
    rw [hζ1] at key
    exact key
  refine ⟨Λg, ?_, hG⟩
  unfold wcGFam
  exact ⟨hloc, hcompat⟩

theorem wc_gtor_glue_univ : ∀ (U : Scheme.{u}) (Γ : Type) [Group Γ] (ι : Type) (V : ι → Scheme.{u}) (v : ∀ j, V j ⟶ U) (g : ∀ i j, ↥(Limits.pullback (v i) (v j)) → Γ) (J : Type u) (O : J → U.Opens) (E : J → Scheme.{u}) (q : ∀ i, E i ⟶ U) (Λ : ∀ i l, ↥(Limits.pullback (q i) (v l)) → Γ), (∀ i, wcGRep v g (O i) (q i) (Λ i)) → (∀ x : U, ∃ i, x ∈ O i) → ∀ (W : Scheme.{u}) (p : W ⟶ U) (κ : ∀ i, E i ⟶ W), (∀ i, IsOpenImmersion (κ i)) → (∀ i, κ i ≫ p = q i) → (∀ i, Set.range (κ i) = p ⁻¹' (O i : Set U)) → ∀ (Λg : ∀ l, ↥(Limits.pullback p (v l)) → Γ), (∀ i (l : ι) (Z : Scheme.{u}) (a : Z ⟶ E i) (c : Z ⟶ V l) (h₁ : a ≫ q i = c ≫ v l) (h₂ : (a ≫ κ i) ≫ p = c ≫ v l) (z : Z), Λ i l (Limits.pullback.lift a c h₁ z) = Λg l (Limits.pullback.lift (a ≫ κ i) c h₂ z)) → ∀ (T : Scheme.{u}) (t : T ⟶ U) (lam : ∀ l, ↥(Limits.pullback t (v l)) → Γ), wcGFam v g t lam → ∃! φ : T ⟶ W, ∃ h : φ ≫ p = t, ∀ (l : ι) (w : ↥(Limits.pullback t (v l))), lam l w = Λg l (Limits.pullback.map t (v l) p (v l) φ (𝟙 _) (𝟙 _) (by rw [Category.comp_id, h]) (by simp) w) :=
by
  intro U Γ _ ι V v g J O E q Λ hrep hcov W p κ hopen hκp hrange Λg hG T t lam hlam

  have evEq : ∀ {X Y B Z : Scheme.{u}} {f : X ⟶ B} {g' : Y ⟶ B}
      (F : ↥(Limits.pullback f g') → Γ) (A A' : Z ⟶ X) (c : Z ⟶ Y)
      (h : A ≫ f = c ≫ g') (h' : A' ≫ f = c ≫ g') (z : Z), A = A' →
      F (Limits.pullback.lift A c h z) = F (Limits.pullback.lift A' c h' z) := by
    intro X Y B Z f g' F A A' c h h' z e
    subst e
    rfl

  have liftComp : ∀ {X Y B Z Z' : Scheme.{u}} {f : X ⟶ B} {g' : Y ⟶ B} (x : Z' ⟶ Z)
      (A : Z ⟶ X) (c : Z ⟶ Y) (h : A ≫ f = c ≫ g') (A' : Z' ⟶ X) (c' : Z' ⟶ Y)
      (h' : A' ≫ f = c' ≫ g'), A' = x ≫ A → c' = x ≫ c → ∀ z : Z',
      Limits.pullback.lift A' c' h' z = Limits.pullback.lift A c h (x z) := by
    intro X Y B Z Z' f g' x A c h A' c' h' eA ec z
    subst eA ec
    have m : Limits.pullback.lift (x ≫ A) (x ≫ c) h' = x ≫ Limits.pullback.lift A c h := by
      apply Limits.pullback.hom_ext
      · exact (Limits.pullback.lift_fst _ _ _).trans ((congrArg (fun m => x ≫ m)
          (Limits.pullback.lift_fst A c h)).symm.trans (Category.assoc _ _ _).symm)
      · exact (Limits.pullback.lift_snd _ _ _).trans ((congrArg (fun m => x ≫ m)
          (Limits.pullback.lift_snd A c h)).symm.trans (Category.assoc _ _ _).symm)
    rw [m, Scheme.Hom.comp_apply]

  have mapLift : ∀ {T₀ T' : Scheme.{u}} (t₀ : T₀ ⟶ U) (t' : T' ⟶ U) (f : T' ⟶ T₀) (l : ι)
      (e1 : t' ≫ 𝟙 U = f ≫ t₀) (e2 : v l ≫ 𝟙 U = 𝟙 (V l) ≫ v l) {Z : Scheme.{u}}
      (a : Z ⟶ T') (b : Z ⟶ V l) (h : a ≫ t' = b ≫ v l) (h' : (a ≫ f) ≫ t₀ = b ≫ v l) (z : Z),
      Limits.pullback.map t' (v l) t₀ (v l) f (𝟙 _) (𝟙 _) e1 e2 (Limits.pullback.lift a b h z) =
        Limits.pullback.lift (a ≫ f) b h' z := by
    intro T₀ T' t₀ t' f l e1 e2 Z a b h h' z
    have m1 : Limits.pullback.map t' (v l) t₀ (v l) f (𝟙 _) (𝟙 _) e1 e2 ≫ Limits.pullback.fst t₀ (v l) =
        Limits.pullback.fst t' (v l) ≫ f := Limits.pullback.lift_fst _ _ _
    have m2 : Limits.pullback.map t' (v l) t₀ (v l) f (𝟙 _) (𝟙 _) e1 e2 ≫ Limits.pullback.snd t₀ (v l) =
        Limits.pullback.snd t' (v l) ≫ 𝟙 _ := Limits.pullback.lift_snd _ _ _
    have m : Limits.pullback.lift a b h ≫ Limits.pullback.map t' (v l) t₀ (v l) f (𝟙 _) (𝟙 _) e1 e2 =
        Limits.pullback.lift (a ≫ f) b h' := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, m1]
        exact (Category.assoc _ _ _).symm.trans ((congrArg (fun m => m ≫ f)
          (Limits.pullback.lift_fst a b h)).trans (Limits.pullback.lift_fst _ _ _).symm)
      · rw [Category.assoc, m2, Category.comp_id]
        exact (Limits.pullback.lift_snd a b h).trans (Limits.pullback.lift_snd _ _ _).symm
    rw [← m, Scheme.Hom.comp_apply]

  have s1 : ∀ (T₀ E₀ : Scheme.{u}) (t₀ : T₀ ⟶ U) (q₀ : E₀ ⟶ U) (φ : T₀ ⟶ E₀) (h : φ ≫ q₀ = t₀)
      (lam₀ : ∀ l, ↥(Limits.pullback t₀ (v l)) → Γ) (Λ₀ : ∀ l, ↥(Limits.pullback q₀ (v l)) → Γ),
      (∀ (l : ι) (w : ↥(Limits.pullback t₀ (v l))), lam₀ l w = Λ₀ l (Limits.pullback.map t₀ (v l) q₀ (v l) φ (𝟙 _) (𝟙 _) (by rw [Category.comp_id, h]) (by simp) w)) ↔
      (∀ (l : ι) (Z : Scheme.{u}) (a : Z ⟶ T₀) (c : Z ⟶ V l) (ha : a ≫ t₀ = c ≫ v l) (ha' : (a ≫ φ) ≫ q₀ = c ≫ v l) (z : Z), lam₀ l (Limits.pullback.lift a c ha z) = Λ₀ l (Limits.pullback.lift (a ≫ φ) c ha' z)) := by
    intro T₀ E₀ t₀ q₀ φ h lam₀ Λ₀
    constructor
    · intro H l Z a c ha ha' z
      exact (H l _).trans (congrArg (Λ₀ l) (mapLift q₀ t₀ φ l _ _ a c ha ha' z))
    · intro H l w
      have e1 := H l _ (Limits.pullback.fst t₀ (v l)) (Limits.pullback.snd t₀ (v l))
        Limits.pullback.condition (by rw [Category.assoc, h]; exact Limits.pullback.condition) w
      have e2 : Limits.pullback.lift (Limits.pullback.fst t₀ (v l)) (Limits.pullback.snd t₀ (v l))
          Limits.pullback.condition = 𝟙 _ := Limits.pullback.lift_fst_snd _ _
      have e3 : Limits.pullback.lift (Limits.pullback.fst t₀ (v l) ≫ φ) (Limits.pullback.snd t₀ (v l))
          (by rw [Category.assoc, h]; exact Limits.pullback.condition) =
          Limits.pullback.map t₀ (v l) q₀ (v l) φ (𝟙 _) (𝟙 _) (by rw [Category.comp_id, h]) (by simp) := by
        apply Limits.pullback.hom_ext
        · exact (Limits.pullback.lift_fst _ _ _).trans (Limits.pullback.lift_fst _ _ _).symm
        · exact (Limits.pullback.lift_snd _ _ _).trans ((Limits.pullback.lift_snd _ _ _).trans
            (Category.comp_id _)).symm
      rw [e2, e3] at e1
      exact e1

  have d1 : ∀ (T₀ T' : Scheme.{u}) (t₀ : T₀ ⟶ U) (t' : T' ⟶ U) (f : T' ⟶ T₀) (hf : f ≫ t₀ = t')
      (lam₀ : ∀ l, ↥(Limits.pullback t₀ (v l)) → Γ), wcGFam v g t₀ lam₀ →
      wcGFam v g t' (fun l w => lam₀ l (Limits.pullback.map t' (v l) t₀ (v l) f (𝟙 _) (𝟙 _)
        (by rw [Category.comp_id, hf]) (by simp) w)) := by
    intro T₀ T' t₀ t' f hf lam₀ hlam₀
    refine ⟨fun l => (hlam₀.1 l).comp_continuous (Limits.pullback.map t' (v l) t₀ (v l) f (𝟙 _) (𝟙 _)
        (by rw [Category.comp_id, hf]) (by simp)).continuous, ?_⟩
    intro l l' Z a b b' h h' h'' z
    have e := hlam₀.2 l l' Z (a ≫ f) b b' (by rw [Category.assoc, hf]; exact h)
      (by rw [Category.assoc, hf]; exact h') h'' z
    rw [← mapLift t₀ t' f l' (by rw [Category.comp_id, hf]) (by simp) a b' h',
      ← mapLift t₀ t' f l (by rw [Category.comp_id, hf]) (by simp) a b h] at e
    exact e

  have d2 : ∀ (i : J) (T' : Scheme.{u}) (t' : T' ⟶ U), Set.range t' ⊆ (O i : Set U) →
      ∀ (β₁ β₂ : T' ⟶ E i), β₁ ≫ q i = t' → β₂ ≫ q i = t' →
      (∀ (l : ι) (Z : Scheme.{u}) (a : Z ⟶ T') (c : Z ⟶ V l) (h₁ : (a ≫ β₁) ≫ q i = c ≫ v l)
        (h₂ : (a ≫ β₂) ≫ q i = c ≫ v l) (z : Z),
        Λ i l (Limits.pullback.lift (a ≫ β₁) c h₁ z) = Λ i l (Limits.pullback.lift (a ≫ β₂) c h₂ z)) →
      β₁ = β₂ := by
    intro i T' t' hT' β₁ β₂ hb₁ hb₂ H
    have hfam := d1 (E i) T' (q i) t' β₁ hb₁ (Λ i) (hrep i).2.1
    have hu := (hrep i).2.2 T' t' hT' _ hfam
    refine hu.unique ⟨hb₁, fun l w => rfl⟩ ⟨hb₂, ?_⟩
    refine (s1 T' (E i) t' (q i) β₂ hb₂ (fun l w => Λ i l (Limits.pullback.map t' (v l) (q i) (v l) β₁
        (𝟙 _) (𝟙 _) (by rw [Category.comp_id, hb₁]) (by simp) w)) (Λ i)).mpr ?_
    intro l Z a c ha ha' z
    have e1 := (s1 T' (E i) t' (q i) β₁ hb₁ (fun l w => Λ i l (Limits.pullback.map t' (v l) (q i) (v l) β₁
        (𝟙 _) (𝟙 _) (by rw [Category.comp_id, hb₁]) (by simp) w)) (Λ i)).mp (fun l w => rfl) l Z a c ha
        (by rw [Category.assoc, hb₁]; exact ha) z
    exact e1.trans (H l Z a c _ ha' z)

  have s4 : ∀ (T' : Scheme.{u}) (φ₁ φ₂ : T' ⟶ W), φ₁ ≫ p = φ₂ ≫ p →
      (∀ (l : ι) (Z : Scheme.{u}) (a : Z ⟶ T') (c : Z ⟶ V l) (h₁ : (a ≫ φ₁) ≫ p = c ≫ v l)
        (h₂ : (a ≫ φ₂) ≫ p = c ≫ v l) (z : Z),
        Λg l (Limits.pullback.lift (a ≫ φ₁) c h₁ z) = Λg l (Limits.pullback.lift (a ≫ φ₂) c h₂ z)) →
      φ₁ = φ₂ := by
    intro T' φ₁ φ₂ hp H
    have hcovT : ∀ x : T', ∃ i y, ((φ₁ ≫ p) ⁻¹ᵁ O i).ι y = x := by
      intro x
      obtain ⟨i, hi⟩ := hcov ((φ₁ ≫ p) x)
      have hx : x ∈ Set.range ((φ₁ ≫ p) ⁻¹ᵁ O i).ι := by
        rw [Scheme.Opens.range_ι]; exact hi
      obtain ⟨y, hy⟩ := hx
      exact ⟨i, y, hy⟩
    have key : ∀ i : J, ((φ₁ ≫ p) ⁻¹ᵁ O i).ι ≫ φ₁ = ((φ₁ ≫ p) ⁻¹ᵁ O i).ι ≫ φ₂ := by
      intro i
      have hjO : ∀ y, (φ₁ ≫ p) (((φ₁ ≫ p) ⁻¹ᵁ O i).ι y) ∈ (O i : Set U) := by
        intro y
        have hy : ((φ₁ ≫ p) ⁻¹ᵁ O i).ι y ∈ Set.range ((φ₁ ≫ p) ⁻¹ᵁ O i).ι := ⟨y, rfl⟩
        rw [Scheme.Opens.range_ι] at hy
        exact hy
      generalize ((φ₁ ≫ p) ⁻¹ᵁ O i).ι = j at hjO ⊢
      have hr1 : Set.range (j ≫ φ₁) ⊆ Set.range (κ i) := by
        rintro _ ⟨y, rfl⟩
        have e : p ((j ≫ φ₁) y) = (φ₁ ≫ p) (j y) :=
          (congrArg p (Scheme.Hom.comp_apply j φ₁ y)).trans (Scheme.Hom.comp_apply φ₁ p (j y)).symm
        rw [hrange i, Set.mem_preimage, e]
        exact hjO y
      have hr2 : Set.range (j ≫ φ₂) ⊆ Set.range (κ i) := by
        rintro _ ⟨y, rfl⟩
        have e0 : (φ₂ ≫ p) (j y) = (φ₁ ≫ p) (j y) := congrArg (fun f : T' ⟶ U => f (j y)) hp.symm
        have e : p ((j ≫ φ₂) y) = (φ₁ ≫ p) (j y) :=
          (congrArg p (Scheme.Hom.comp_apply j φ₂ y)).trans
            ((Scheme.Hom.comp_apply φ₂ p (j y)).symm.trans e0)
        rw [hrange i, Set.mem_preimage, e]
        exact hjO y
      have := hopen i
      obtain ⟨β₁, hβ₁⟩ : ∃ β, β ≫ κ i = j ≫ φ₁ := ⟨_, IsOpenImmersion.lift_fac _ _ hr1⟩
      obtain ⟨β₂, hβ₂⟩ : ∃ β, β ≫ κ i = j ≫ φ₂ := ⟨_, IsOpenImmersion.lift_fac _ _ hr2⟩
      have hb₁ : β₁ ≫ q i = j ≫ φ₁ ≫ p := by
        rw [← hκp i, ← Category.assoc, hβ₁, Category.assoc]
      have hb₂ : β₂ ≫ q i = j ≫ φ₁ ≫ p := by
        rw [← hκp i, ← Category.assoc, hβ₂, Category.assoc]
        exact congrArg (fun f => j ≫ f) hp.symm
      have hT' : Set.range (j ≫ φ₁ ≫ p) ⊆ (O i : Set U) := by
        rintro _ ⟨y, rfl⟩
        rw [Scheme.Hom.comp_apply]
        exact hjO y
      have hβ : β₁ = β₂ := d2 i _ (j ≫ φ₁ ≫ p) hT' β₁ β₂ hb₁ hb₂ (by
        intro l Z a c h₁ h₂ z
        have e1 := hG i l Z (a ≫ β₁) c h₁ (by rw [Category.assoc, hκp i]; exact h₁) z
        have e2 := hG i l Z (a ≫ β₂) c h₂ (by rw [Category.assoc, hκp i]; exact h₂) z
        rw [e1, e2]
        have f1 : (a ≫ β₁) ≫ κ i = (a ≫ j) ≫ φ₁ := by rw [Category.assoc, hβ₁, Category.assoc]
        have f2 : (a ≫ β₂) ≫ κ i = (a ≫ j) ≫ φ₂ := by rw [Category.assoc, hβ₂, Category.assoc]
        rw [evEq (Λg l) _ _ c _ (by rw [← f1, Category.assoc, hκp i]; exact h₁) z f1,
          evEq (Λg l) _ _ c _ (by rw [← f2, Category.assoc, hκp i]; exact h₂) z f2]
        exact H l Z (a ≫ j) c _ _ z)
      rw [← hβ₁, ← hβ₂, hβ]
    exact Scheme.Cover.hom_ext (Scheme.Cover.mkOfCovers (P := @IsOpenImmersion) J
      (fun i => (((φ₁ ≫ p) ⁻¹ᵁ O i : T'.Opens) : Scheme.{u})) (fun i => ((φ₁ ≫ p) ⁻¹ᵁ O i).ι) hcovT)
      φ₁ φ₂ key

  have s3 : ∀ (i : J) (Y : Scheme.{u}) (j : Y ⟶ T), Set.range (j ≫ t) ⊆ (O i : Set U) →
      ∃ ψ : Y ⟶ W, ψ ≫ p = j ≫ t ∧ ∀ (l : ι) (Z : Scheme.{u}) (a : Z ⟶ Y) (c : Z ⟶ V l)
        (h₁ : (a ≫ j) ≫ t = c ≫ v l) (h₂ : (a ≫ ψ) ≫ p = c ≫ v l) (z : Z),
        lam l (Limits.pullback.lift (a ≫ j) c h₁ z) = Λg l (Limits.pullback.lift (a ≫ ψ) c h₂ z) := by
    intro i Y j hS
    have hfam := d1 T Y t (j ≫ t) j rfl lam hlam
    obtain ⟨ψ', ⟨hψ', rep'⟩, -⟩ := (hrep i).2.2 Y (j ≫ t) hS _ hfam
    refine ⟨ψ' ≫ κ i, by rw [Category.assoc, hκp i, hψ'], ?_⟩
    intro l Z a c h₁ h₂ z
    have ha : a ≫ j ≫ t = c ≫ v l := by rw [← Category.assoc]; exact h₁
    have ha' : (a ≫ ψ') ≫ q i = c ≫ v l := by rw [Category.assoc, hψ']; exact ha
    have e1 := (s1 Y T (j ≫ t) t j rfl (fun l w => lam l (Limits.pullback.map (j ≫ t) (v l) t (v l) j
        (𝟙 _) (𝟙 _) (by simp) (by simp) w)) lam).mp (fun l w => rfl) l Z a c ha h₁ z
    have e2 := (s1 Y (E i) (j ≫ t) (q i) ψ' hψ' (fun l w => lam l (Limits.pullback.map (j ≫ t) (v l) t (v l) j
        (𝟙 _) (𝟙 _) (by simp) (by simp) w)) (Λ i)).mp rep' l Z a c ha ha' z
    have e3 := hG i l Z (a ≫ ψ') c ha' (by rw [Category.assoc, hκp i]; exact ha') z
    exact e1.symm.trans (e2.trans (e3.trans (evEq (Λg l) _ _ c _ h₂ z (Category.assoc _ _ _))))

  have hcovT : ∀ x : T, ∃ i y, (t ⁻¹ᵁ O i).ι y = x := by
    intro x
    obtain ⟨i, hi⟩ := hcov (t x)
    have hx : x ∈ Set.range (t ⁻¹ᵁ O i).ι := by rw [Scheme.Opens.range_ι]; exact hi
    obtain ⟨y, hy⟩ := hx
    exact ⟨i, y, hy⟩
  have hS : ∀ i, Set.range ((t ⁻¹ᵁ O i).ι ≫ t) ⊆ (O i : Set U) := by
    intro i
    rintro _ ⟨y, rfl⟩
    have hy : (t ⁻¹ᵁ O i).ι y ∈ Set.range (t ⁻¹ᵁ O i).ι := ⟨y, rfl⟩
    rw [Scheme.Opens.range_ι] at hy
    rw [Scheme.Hom.comp_apply]
    exact hy
  choose ψ hψp hψrep using fun i => s3 i _ (t ⁻¹ᵁ O i).ι (hS i)

  have hagree : ∀ i k : J, Limits.pullback.fst (t ⁻¹ᵁ O i).ι (t ⁻¹ᵁ O k).ι ≫ ψ i =
      Limits.pullback.snd (t ⁻¹ᵁ O i).ι (t ⁻¹ᵁ O k).ι ≫ ψ k := by
    intro i k
    have hc := Limits.pullback.condition (f := (t ⁻¹ᵁ O i).ι) (g := (t ⁻¹ᵁ O k).ι)
    generalize Limits.pullback.fst (t ⁻¹ᵁ O i).ι (t ⁻¹ᵁ O k).ι = F at hc ⊢
    generalize Limits.pullback.snd (t ⁻¹ᵁ O i).ι (t ⁻¹ᵁ O k).ι = S at hc ⊢
    apply s4
    · rw [Category.assoc, hψp i, ← Category.assoc, hc, Category.assoc, Category.assoc, hψp k]
    · intro l Z a c h₁ h₂ z
      have k1 : ((a ≫ F) ≫ (t ⁻¹ᵁ O i).ι) ≫ t = c ≫ v l := by
        simp only [Category.assoc] at h₁ ⊢
        rw [← hψp i]; exact h₁
      have k2 : ((a ≫ S) ≫ (t ⁻¹ᵁ O k).ι) ≫ t = c ≫ v l := by
        simp only [Category.assoc] at h₂ ⊢
        rw [← hψp k]; exact h₂
      calc Λg l (Limits.pullback.lift (a ≫ F ≫ ψ i) c h₁ z)
          = Λg l (Limits.pullback.lift ((a ≫ F) ≫ ψ i) c (by rw [Category.assoc]; exact h₁) z) :=
            evEq _ _ _ c _ _ z (Category.assoc _ _ _).symm
        _ = lam l (Limits.pullback.lift ((a ≫ F) ≫ (t ⁻¹ᵁ O i).ι) c k1 z) :=
            (hψrep i l Z (a ≫ F) c k1 _ z).symm
        _ = lam l (Limits.pullback.lift ((a ≫ S) ≫ (t ⁻¹ᵁ O k).ι) c k2 z) :=
            evEq _ _ _ c _ _ z (by rw [Category.assoc, hc, Category.assoc])
        _ = Λg l (Limits.pullback.lift ((a ≫ S) ≫ ψ k) c (by rw [Category.assoc]; exact h₂) z) :=
            hψrep k l Z (a ≫ S) c k2 _ z
        _ = Λg l (Limits.pullback.lift (a ≫ S ≫ ψ k) c h₂ z) :=
            evEq _ _ _ c _ _ z (Category.assoc _ _ _)

  obtain ⟨φ, hφi⟩ : ∃ φ : T ⟶ W, ∀ i : J, (t ⁻¹ᵁ O i).ι ≫ φ = ψ i :=
    ⟨(Scheme.Cover.mkOfCovers (P := @IsOpenImmersion) J
      (fun i => ((t ⁻¹ᵁ O i : T.Opens) : Scheme.{u})) (fun i => (t ⁻¹ᵁ O i).ι) hcovT).glueMorphisms
        (fun i => ψ i) hagree,
     fun i => Scheme.Cover.ι_glueMorphisms (Scheme.Cover.mkOfCovers (P := @IsOpenImmersion) J
      (fun i => ((t ⁻¹ᵁ O i : T.Opens) : Scheme.{u})) (fun i => (t ⁻¹ᵁ O i).ι) hcovT)
        (fun i => ψ i) hagree i⟩
  have hφp : φ ≫ p = t := by
    have key : ∀ i : J, (t ⁻¹ᵁ O i).ι ≫ φ ≫ p = (t ⁻¹ᵁ O i).ι ≫ t := by
      intro i
      rw [← Category.assoc, hφi, hψp]
    exact Scheme.Cover.hom_ext (Scheme.Cover.mkOfCovers (P := @IsOpenImmersion) J
      (fun i => ((t ⁻¹ᵁ O i : T.Opens) : Scheme.{u})) (fun i => (t ⁻¹ᵁ O i).ι) hcovT) _ _ key

  have hev : ∀ (l : ι) (Z : Scheme.{u}) (a : Z ⟶ T) (c : Z ⟶ V l) (h₁ : a ≫ t = c ≫ v l)
      (h₂ : (a ≫ φ) ≫ p = c ≫ v l) (z : Z),
      lam l (Limits.pullback.lift a c h₁ z) = Λg l (Limits.pullback.lift (a ≫ φ) c h₂ z) := by
    intro l Z a c h₁ h₂ z
    obtain ⟨k, y, hy⟩ := hcovT (a z)
    obtain ⟨ζ, hζ1, hζ2⟩ := Scheme.Pullback.exists_preimage_pullback (f := a) (g := (t ⁻¹ᵁ O k).ι)
      z y hy.symm
    have hc := Limits.pullback.condition (f := a) (g := (t ⁻¹ᵁ O k).ι)
    have k1 : (Limits.pullback.snd a (t ⁻¹ᵁ O k).ι ≫ (t ⁻¹ᵁ O k).ι) ≫ t =
        (Limits.pullback.fst a (t ⁻¹ᵁ O k).ι ≫ c) ≫ v l := by
      rw [← hc, Category.assoc, Category.assoc, h₁]
    have k2 : (Limits.pullback.snd a (t ⁻¹ᵁ O k).ι ≫ ψ k) ≫ p =
        (Limits.pullback.fst a (t ⁻¹ᵁ O k).ι ≫ c) ≫ v l := by
      rw [Category.assoc, hψp k, ← Category.assoc]; exact k1
    have e := hψrep k l _ (Limits.pullback.snd a (t ⁻¹ᵁ O k).ι)
      (Limits.pullback.fst a (t ⁻¹ᵁ O k).ι ≫ c) k1 k2 ζ
    have L := liftComp (Limits.pullback.fst a (t ⁻¹ᵁ O k).ι) a c h₁
      (Limits.pullback.snd a (t ⁻¹ᵁ O k).ι ≫ (t ⁻¹ᵁ O k).ι)
      (Limits.pullback.fst a (t ⁻¹ᵁ O k).ι ≫ c) k1 hc.symm rfl ζ
    have R := liftComp (Limits.pullback.fst a (t ⁻¹ᵁ O k).ι) (a ≫ φ) c h₂
      (Limits.pullback.snd a (t ⁻¹ᵁ O k).ι ≫ ψ k)
      (Limits.pullback.fst a (t ⁻¹ᵁ O k).ι ≫ c) k2
      (by rw [← hφi k, ← Category.assoc, ← hc, Category.assoc]) rfl ζ
    rw [hζ1] at L R
    rw [← L, ← R]
    exact e

  refine ⟨φ, ⟨hφp, (s1 T W t p φ hφp lam Λg).mpr hev⟩, ?_⟩
  rintro φ' ⟨h', rep'⟩
  apply s4 T φ' φ (h'.trans hφp.symm)
  intro l Z a c h₁ h₂ z
  have ha : a ≫ t = c ≫ v l := by rw [← h', ← Category.assoc]; exact h₁
  exact ((s1 T W t p φ' h' lam Λg).mp rep' l Z a c ha h₁ z).symm.trans (hev l Z a c ha h₂ z)

theorem wc_gtor_rep_zariski_glue : ∀ (U : Scheme.{u}) (Γ : Type) [Group Γ] (ι : Type) (V : ι → Scheme.{u}) (v : ∀ j, V j ⟶ U) (g : ∀ i j, ↥(Limits.pullback (v i) (v j)) → Γ), (∀ x : U, ∃ O : U.Opens, x ∈ O ∧ ∃ (E : Scheme.{u}) (π : E ⟶ (O : Scheme.{u})) (Λ : ∀ l, ↥(Limits.pullback (π ≫ O.ι) (v l)) → Γ), IsFinite π ∧ Etale π ∧ wcGRep v g O (π ≫ O.ι) Λ) → ∃ (E : Scheme.{u}) (π : E ⟶ U) (Λ : ∀ l, ↥(Limits.pullback π (v l)) → Γ), IsFinite π ∧ Etale π ∧ wcGRep v g ⊤ π Λ :=
by
  intro U Γ _ ι V v g hloc
  choose O hxO E π Λl hfin het hrep using hloc
  obtain ⟨τ, hτq, hid, hcoc, hτ⟩ := wc_gtor_glue_transitions U Γ ι V v g (↥U) O E
    (fun x => π x ≫ (O x).ι) Λl hrep
  obtain ⟨W, p, κ, hopen, hκp, hrange, hsurj, -, hfact⟩ := wc_sch_rel_glue U (↥U) O E
    (fun x => π x ≫ (O x).ι) (fun x => (hrep x).1) τ hτq hid hcoc
  obtain ⟨hfinW, hetW⟩ := wc_gtor_glue_fin_etale U (↥U) O E π W p κ (fun x => ⟨x, hxO x⟩)
    hopen hκp hrange hfin het
  obtain ⟨Λg, hfamg, hG⟩ := wc_gtor_glue_family U Γ ι V v g (↥U) O E
    (fun x => π x ≫ (O x).ι) Λl (fun x => (hrep x).2.1) τ hτ W p κ hopen hκp hsurj hfact
  refine ⟨W, p, Λg, hfinW, hetW, fun _ _ => trivial, hfamg, ?_⟩
  intro T t _ lam hlam
  exact wc_gtor_glue_univ U Γ ι V v g (↥U) O E (fun x => π x ≫ (O x).ι) Λl hrep
    (fun x => ⟨x, hxO x⟩) W p κ hopen hκp hrange Λg hG T t lam hlam

theorem wc_gtor_sheets_of_rep : ∀ (U : Scheme.{u}) (Γ : Type) [Group Γ] (ι : Type) (V : ι → Scheme.{u}) (v : ∀ j, V j ⟶ U), (∀ j, Etale (v j)) → (∀ x : U, ∃ j, x ∈ Set.range (v j)) → ∀ (g : ∀ i j, ↥(Limits.pullback (v i) (v j)) → Γ), (∀ i j, IsLocallyConstant (g i j)) → wcGCocycle v g → ∀ (E : Scheme.{u}) (πE : E ⟶ U) (Λ : ∀ l, ↥(Limits.pullback πE (v l)) → Γ), Etale πE → wcGRep v g ⊤ πE Λ → Surjective πE ∧ ∃ s : ∀ j, Γ → (V j ⟶ E), (∀ j γ, s j γ ≫ πE = v j) ∧ (∀ j γ, IsOpenMap (s j γ)) ∧ (∀ y : E, ∃ j γ x, s j γ x = y) ∧ ∀ (i j : ι) (γ γ' : Γ) (Z : Scheme.{u}) (a : Z ⟶ V i) (b : Z ⟶ V j) (hab : a ≫ v i = b ≫ v j), a ≫ s i γ = b ≫ s j γ' → ∀ z : Z, γ' = γ * g i j (Limits.pullback.lift a b hab z) :=
by
  intro U Γ _ ι V v het hcov g hgloc hG E πE Λ hetE hrep

  have hopen : ∀ (j : ι) (σ : V j ⟶ E), σ ≫ πE = v j → IsOpenMap σ := by
    intro j σ hσ
    haveI := hetE
    haveI : Etale (σ ≫ πE) := by rw [hσ]; exact het j
    haveI : Etale σ := MorphismProperty.of_postcomp (W := @Etale) (W' := @Etale)
      σ πE hetE this
    exact σ.isOpenMap
  clear het hetE
  classical

  have hdiag : ∀ (j : ι) (Z : Scheme.{u}) (b : Z ⟶ V j) (h : b ≫ v j = b ≫ v j) (z : Z),
      g j j (Limits.pullback.lift b b h z) = 1 := by
    intro j Z b h z
    have h0 := hG j j j Z b b b h h h z
    have h2 : g j j (Limits.pullback.lift b b h z) * g j j (Limits.pullback.lift b b h z) =
        g j j (Limits.pullback.lift b b h z) * 1 := by
      rw [mul_one]; exact h0.symm
    exact mul_left_cancel h2

  have hex : ∀ (j : ι) (γ : Γ), ∃ s : V j ⟶ E, ∃ h : s ≫ πE = v j,
      ∀ (l : ι) (w : ↥(Limits.pullback (v j) (v l))),
        γ * g j l w = Λ l (Limits.pullback.map (v j) (v l) πE (v l) s (𝟙 _) (𝟙 _)
          (by rw [Category.comp_id, h]) (by simp) w) := by
    intro j γ
    have hfam : wcGFam v g (v j) (fun l w => γ * g j l w) := by
      refine ⟨fun l => (hgloc j l).comp (fun x => γ * x), ?_⟩
      intro l l' Z a b b' h h' h'' z
      show γ * g j l' (Limits.pullback.lift a b' h' z) =
        γ * g j l (Limits.pullback.lift a b h z) * g l l' (Limits.pullback.lift b b' h'' z)
      rw [hG j l l' Z a b b' h h'' h' z, mul_assoc]
    exact (hrep.2.2 (V j) (v j) (by simp) _ hfam).exists
  choose s hs hsrep using hex
  refine ⟨⟨fun u => ?_⟩, s, hs, ?_, ?_, ?_⟩
  ·
    obtain ⟨j, x, hx⟩ := hcov u
    refine ⟨s j 1 x, ?_⟩
    have e := congrArg (fun k => k x) (hs j 1)
    simp only [Scheme.Hom.comp_apply] at e
    exact e.trans hx
  ·
    intro j γ
    exact hopen j (s j γ) (hs j γ)
  ·
    intro y
    obtain ⟨j, x, hx⟩ := hcov (πE y)
    obtain ⟨p, hp1, hp2⟩ := Scheme.Pullback.exists_preimage_pullback y x hx.symm
    set γ := Λ j p with hγ
    let O : (Limits.pullback πE (v j)).Opens :=
      ⟨{q | Λ j q = γ}, (hrep.2.1.1 j).isOpen_fiber γ⟩
    have hpO : p ∈ O := hγ.symm
    obtain ⟨p', hp'⟩ : p ∈ Set.range O.ι := by rw [Scheme.Opens.range_ι]; exact hpO
    have hK : ∀ q : O.toScheme, Λ j (O.ι q) = γ := by
      intro q
      have hq : O.ι q ∈ Set.range O.ι := ⟨q, rfl⟩
      rw [Scheme.Opens.range_ι] at hq
      exact hq
    let f : O.toScheme ⟶ V j := O.ι ≫ Limits.pullback.snd πE (v j)
    let t : O.toScheme ⟶ U := f ≫ v j
    let φ₁ : O.toScheme ⟶ E := O.ι ≫ Limits.pullback.fst πE (v j)
    let φ₂ : O.toScheme ⟶ E := f ≫ s j γ
    have h1 : φ₁ ≫ πE = t := by
      simp only [φ₁, t, f, Category.assoc, Limits.pullback.condition]
    have h2 : φ₂ ≫ πE = t := by
      simp only [φ₂, t, Category.assoc, hs j γ]
    let N : ∀ l, Limits.pullback t (v l) ⟶ Limits.pullback (v j) (v l) := fun l =>
      Limits.pullback.map t (v l) (v j) (v l) f (𝟙 _) (𝟙 _) (by simp [t]) (by simp)
    let lam : ∀ l, ↥(Limits.pullback t (v l)) → Γ := fun l w => γ * g j l (N l w)
    have hfam : wcGFam v g t lam := by
      refine ⟨fun l => ((hgloc j l).comp_continuous (N l).continuous).comp (fun x => γ * x), ?_⟩
      intro l l' Z a b b' h h' h'' z
      have hc : (a ≫ f) ≫ v j = b ≫ v l := by rw [Category.assoc]; exact h
      have hc' : (a ≫ f) ≫ v j = b' ≫ v l' := by rw [Category.assoc]; exact h'
      have e1 : Limits.pullback.lift a b h ≫ N l = Limits.pullback.lift (a ≫ f) b hc := by
        apply Limits.pullback.hom_ext <;>
          simp only [N, Category.assoc, Limits.pullback.map, Limits.pullback.lift_fst,
            Limits.pullback.lift_snd, Limits.pullback.lift_fst_assoc,
            Limits.pullback.lift_snd_assoc, Category.comp_id]
      have e2 : Limits.pullback.lift a b' h' ≫ N l' = Limits.pullback.lift (a ≫ f) b' hc' := by
        apply Limits.pullback.hom_ext <;>
          simp only [N, Category.assoc, Limits.pullback.map, Limits.pullback.lift_fst,
            Limits.pullback.lift_snd, Limits.pullback.lift_fst_assoc,
            Limits.pullback.lift_snd_assoc, Category.comp_id]
      have e1' : N l (Limits.pullback.lift a b h z) = Limits.pullback.lift (a ≫ f) b hc z := by
        rw [← e1, Scheme.Hom.comp_apply]
      have e2' : N l' (Limits.pullback.lift a b' h' z) =
          Limits.pullback.lift (a ≫ f) b' hc' z := by
        rw [← e2, Scheme.Hom.comp_apply]
      show γ * g j l' (N l' (Limits.pullback.lift a b' h' z)) =
        γ * g j l (N l (Limits.pullback.lift a b h z)) * g l l' (Limits.pullback.lift b b' h'' z)
      rw [e1', e2', hG j l l' Z (a ≫ f) b b' hc h'' hc' z, mul_assoc]
    have hrep2 : ∀ (l : ι) (w : ↥(Limits.pullback t (v l))), lam l w =
        Λ l (Limits.pullback.map t (v l) πE (v l) φ₂ (𝟙 _) (𝟙 _)
          (by rw [Category.comp_id, h2]) (by simp) w) := by
      intro l w
      have e : Limits.pullback.map t (v l) πE (v l) φ₂ (𝟙 _) (𝟙 _)
          (by rw [Category.comp_id, h2]) (by simp) =
          N l ≫ Limits.pullback.map (v j) (v l) πE (v l) (s j γ) (𝟙 _) (𝟙 _)
            (by rw [Category.comp_id, hs j γ]) (by simp) := by
        apply Limits.pullback.hom_ext <;>
          simp only [N, φ₂, Category.assoc, Limits.pullback.map, Limits.pullback.lift_fst,
            Limits.pullback.lift_snd, Limits.pullback.lift_fst_assoc,
            Limits.pullback.lift_snd_assoc, Category.comp_id]
      rw [e, Scheme.Hom.comp_apply]
      exact hsrep j γ l (N l w)
    have hrep1 : ∀ (l : ι) (w : ↥(Limits.pullback t (v l))), lam l w =
        Λ l (Limits.pullback.map t (v l) πE (v l) φ₁ (𝟙 _) (𝟙 _)
          (by rw [Category.comp_id, h1]) (by simp) w) := by
      intro l w
      have hQ : Limits.pullback.fst t (v l) ≫ t = Limits.pullback.snd t (v l) ≫ v l :=
        Limits.pullback.condition
      have ha : (Limits.pullback.fst t (v l) ≫ φ₁) ≫ πE =
          (Limits.pullback.fst t (v l) ≫ f) ≫ v j := by
        simp only [Category.assoc]; rw [h1]
      have ha' : (Limits.pullback.fst t (v l) ≫ φ₁) ≫ πE = Limits.pullback.snd t (v l) ≫ v l := by
        simp only [Category.assoc]; rw [h1]; exact hQ
      have ha'' : (Limits.pullback.fst t (v l) ≫ f) ≫ v j = Limits.pullback.snd t (v l) ≫ v l := by
        simp only [Category.assoc]; exact hQ
      have hc := hrep.2.1.2 j l _ (Limits.pullback.fst t (v l) ≫ φ₁)
        (Limits.pullback.fst t (v l) ≫ f) (Limits.pullback.snd t (v l)) ha ha' ha'' w
      have e1 : Limits.pullback.lift (Limits.pullback.fst t (v l) ≫ φ₁)
          (Limits.pullback.snd t (v l)) ha' =
          Limits.pullback.map t (v l) πE (v l) φ₁ (𝟙 _) (𝟙 _)
            (by rw [Category.comp_id, h1]) (by simp) := by
        apply Limits.pullback.hom_ext <;>
          simp only [Category.assoc, Limits.pullback.map, Limits.pullback.lift_fst,
            Limits.pullback.lift_snd, Limits.pullback.lift_fst_assoc,
            Limits.pullback.lift_snd_assoc, Category.comp_id]
      have e2 : Limits.pullback.lift (Limits.pullback.fst t (v l) ≫ φ₁)
          (Limits.pullback.fst t (v l) ≫ f) ha = Limits.pullback.fst t (v l) ≫ O.ι := by
        apply Limits.pullback.hom_ext <;>
          simp only [φ₁, f, Category.assoc, Limits.pullback.lift_fst,
            Limits.pullback.lift_snd]
      have e3 : Limits.pullback.lift (Limits.pullback.fst t (v l) ≫ f)
          (Limits.pullback.snd t (v l)) ha'' = N l := by
        apply Limits.pullback.hom_ext <;>
          simp only [N, Category.assoc, Limits.pullback.map, Limits.pullback.lift_fst,
            Limits.pullback.lift_snd, Category.comp_id]
      rw [e1, e2, e3, Scheme.Hom.comp_apply, hK] at hc
      exact hc.symm
    have huniq : φ₁ = φ₂ :=
      (hrep.2.2 O.toScheme t (by simp) lam hfam).unique ⟨h1, hrep1⟩ ⟨h2, hrep2⟩
    refine ⟨j, γ, x, ?_⟩
    have e := congrArg (fun k : O.toScheme ⟶ E => k p') huniq
    simp only [φ₁, φ₂, f, Scheme.Hom.comp_apply, hp'] at e
    rw [hp1, hp2] at e
    exact e.symm
  ·
    intro i j γ γ' Z a b hab heq z
    have e : Limits.pullback.lift a b hab ≫ Limits.pullback.map (v i) (v j) πE (v j) (s i γ)
        (𝟙 _) (𝟙 _) (by rw [Category.comp_id, hs i γ]) (by simp) =
        Limits.pullback.lift b b rfl ≫ Limits.pullback.map (v j) (v j) πE (v j) (s j γ')
        (𝟙 _) (𝟙 _) (by rw [Category.comp_id, hs j γ']) (by simp) := by
      apply Limits.pullback.hom_ext
      · simp only [Category.assoc, Limits.pullback.map, Limits.pullback.lift_fst,
          Limits.pullback.lift_fst_assoc]
        exact heq
      · simp only [Category.assoc, Limits.pullback.map, Limits.pullback.lift_snd,
          Limits.pullback.lift_snd_assoc]
    have ez := congrArg (fun k => k z) e
    simp only [Scheme.Hom.comp_apply] at ez
    have e1 := hsrep i γ j (Limits.pullback.lift a b hab z)
    have e2 := hsrep j γ' j (Limits.pullback.lift b b rfl z)
    rw [hdiag, mul_one] at e2
    exact e2.trans ((congrArg (Λ j) ez).symm.trans e1.symm)

theorem wc_fet_torsor_of_etale_cocycle : ∀ (U : Scheme.{u}), CompactSpace U → QuasiSeparatedSpace U →
    ∀ (Γ : Type) [Group Γ] [Finite Γ] (ι : Type) [Finite ι] (V : ι → Scheme.{u}) (v : ∀ j, V j ⟶ U),
    (∀ j, Etale (v j)) → (∀ x : U, ∃ j, x ∈ Set.range (v j)) →
    ∀ (g : ∀ i j, ↥(Limits.pullback (v i) (v j)) → Γ), (∀ i j, IsLocallyConstant (g i j)) →
    (∀ (i j k : ι) (Z : Scheme.{u}) (a : Z ⟶ V i) (b : Z ⟶ V j) (c : Z ⟶ V k)
      (hab : a ≫ v i = b ≫ v j) (hbc : b ≫ v j = c ≫ v k) (hac : a ≫ v i = c ≫ v k),
      Etale (a ≫ v i) → ∀ z : Z,
      g i k (Limits.pullback.lift a c hac z) =
        g i j (Limits.pullback.lift a b hab z) * g j k (Limits.pullback.lift b c hbc z)) →
    ∃ (E : Scheme.{u}) (πE : E ⟶ U), IsFinite πE ∧ Etale πE ∧ Surjective πE ∧
      ∃ s : ∀ j, Γ → (V j ⟶ E), (∀ j γ, s j γ ≫ πE = v j) ∧ (∀ j γ, IsOpenMap (s j γ)) ∧
        (∀ y : E, ∃ j γ x, s j γ x = y) ∧
        ∀ (i j : ι) (γ γ' : Γ) (Z : Scheme.{u}) (a : Z ⟶ V i) (b : Z ⟶ V j)
          (hab : a ≫ v i = b ≫ v j), a ≫ s i γ = b ≫ s j γ' →
          ∀ z : Z, γ' = γ * g i j (Limits.pullback.lift a b hab z) :=
by
  intro U _ _ Γ _ _ ι _ V v het hcov g hgloc hcoc

  have hG : wcGCocycle v g := by
    intro i j k Z a b c hab hbc hac z
    haveI := het i
    haveI := het j
    haveI := het k
    let P := Limits.pullback (v i) (v j)
    let p1 : P ⟶ V i := Limits.pullback.fst (v i) (v j)
    let p2 : P ⟶ V j := Limits.pullback.snd (v i) (v j)
    let q1 : Limits.pullback (p2 ≫ v j) (v k) ⟶ P := Limits.pullback.fst (p2 ≫ v j) (v k)
    let q2 : Limits.pullback (p2 ≫ v j) (v k) ⟶ V k := Limits.pullback.snd (p2 ≫ v j) (v k)
    have hP : p1 ≫ v i = p2 ≫ v j := Limits.pullback.condition
    have hQ : q1 ≫ p2 ≫ v j = q2 ≫ v k := Limits.pullback.condition
    have h1 : (q1 ≫ p1) ≫ v i = (q1 ≫ p2) ≫ v j := by
      rw [Category.assoc, Category.assoc, hP]
    have h2 : (q1 ≫ p2) ≫ v j = q2 ≫ v k := by
      rw [Category.assoc, hQ]
    have h3 : (q1 ≫ p1) ≫ v i = q2 ≫ v k := h1.trans h2
    have hEt : Etale ((q1 ≫ p1) ≫ v i) := by
      rw [h3]
      first
        | infer_instance
        | (have e1 : Etale (Limits.pullback.snd (v i) (v j)) :=
              MorphismProperty.pullback_snd (P := @Etale) _ _ (het i)
           have e2 : Etale (Limits.pullback.snd (v i) (v j) ≫ v j) :=
              MorphismProperty.comp_mem (W := @Etale) _ _ e1 (het j)
           have e3 : Etale (Limits.pullback.snd (Limits.pullback.snd (v i) (v j) ≫ v j) (v k)) :=
              MorphismProperty.pullback_snd (P := @Etale) _ _ e2
           exact MorphismProperty.comp_mem (W := @Etale) _ _ e3 (het k))
    have hm : Limits.pullback.lift a b hab ≫ p2 ≫ v j = c ≫ v k := by
      rw [← Category.assoc, Limits.pullback.lift_snd]
      exact hbc
    let m : Z ⟶ Limits.pullback (p2 ≫ v j) (v k) :=
      Limits.pullback.lift (Limits.pullback.lift a b hab) c hm
    have hm1 : m ≫ q1 = Limits.pullback.lift a b hab := Limits.pullback.lift_fst _ _ _
    have hm2 : m ≫ q2 = c := Limits.pullback.lift_snd _ _ _
    have hma : m ≫ q1 ≫ p1 = a := by
      rw [← Category.assoc, hm1]; exact Limits.pullback.lift_fst _ _ _
    have hmb : m ≫ q1 ≫ p2 = b := by
      rw [← Category.assoc, hm1]; exact Limits.pullback.lift_snd _ _ _
    have eac : Limits.pullback.lift a c hac =
        m ≫ Limits.pullback.lift (q1 ≫ p1) q2 h3 := by
      apply Limits.pullback.hom_ext
      · rw [Limits.pullback.lift_fst, Category.assoc, Limits.pullback.lift_fst, hma]
      · rw [Limits.pullback.lift_snd, Category.assoc, Limits.pullback.lift_snd, hm2]
    have eab : Limits.pullback.lift a b hab =
        m ≫ Limits.pullback.lift (q1 ≫ p1) (q1 ≫ p2) h1 := by
      apply Limits.pullback.hom_ext
      · rw [Limits.pullback.lift_fst, Category.assoc, Limits.pullback.lift_fst, hma]
      · rw [Limits.pullback.lift_snd, Category.assoc, Limits.pullback.lift_snd, hmb]
    have ebc : Limits.pullback.lift b c hbc =
        m ≫ Limits.pullback.lift (q1 ≫ p2) q2 h2 := by
      apply Limits.pullback.hom_ext
      · rw [Limits.pullback.lift_fst, Category.assoc, Limits.pullback.lift_fst, hmb]
      · rw [Limits.pullback.lift_snd, Category.assoc, Limits.pullback.lift_snd, hm2]
    have key := hcoc i j k _ (q1 ≫ p1) (q1 ≫ p2) q2 h1 h2 h3 hEt (m z)
    rw [eac, eab, ebc, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply]
    exact key

  have hD : wcGTorDescHyp.{u} := wc_gtor_ring_descent

  have hloc : ∀ x : U, ∃ O : U.Opens, x ∈ O ∧ ∃ (E : Scheme.{u}) (π : E ⟶ (O : Scheme.{u}))
      (Λ : ∀ l, ↥(Limits.pullback (π ≫ O.ι) (v l)) → Γ),
      IsFinite π ∧ Etale π ∧ wcGRep v g O (π ≫ O.ι) Λ := by
    intro x
    obtain ⟨O, hO, hxO, -⟩ :=
      exists_isAffineOpen_mem_and_subset (X := U) (x := x) (U := ⊤) trivial
    obtain ⟨n, W, k, w, E, π, σ, hfin, hetπ, hWaff, hwopen, hσ, hWcov, hσcov, hmeet⟩ :=
      wc_gtor_affine_sheeted U Γ ι V v het g hgloc hG hD O hO (fun y _ => hcov y)
    have hwet : ∀ m, Etale (w m ≫ v (k m)) := by
      intro m
      haveI := hwopen m
      haveI := het (k m)
      infer_instance
    obtain ⟨Λ, hΛ⟩ := wc_gtor_rep_of_sheets U Γ ι V v g hgloc hG O hO n W k w E π σ hfin hetπ
      hWaff hwet hσ hWcov hσcov hmeet
    exact ⟨O, hxO, E, π, Λ, hfin, hetπ, hΛ⟩

  obtain ⟨E, πE, Λ, hfin, hetE, hrep⟩ := wc_gtor_rep_zariski_glue U Γ ι V v g hloc

  obtain ⟨hsurj, s, h1, h2, h3, h4⟩ :=
    wc_gtor_sheets_of_rep U Γ ι V v het hcov g hgloc hG E πE Λ hetE hrep
  exact ⟨E, πE, hfin, hetE, hsurj, s, h1, h2, h3, h4⟩

theorem wc_proet_sheaf_iso_glue : ∀ (S : Scheme.{u}) (F G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (X : S.ProEt)
    (K : Type) (Y : K → S.ProEt) (f : ∀ k, Y k ⟶ X),
    Sieve.generate (Presieve.ofArrows Y f) ∈ Scheme.ProEt.topology S X →
    ∀ (φ : ∀ k, F.over (Y k) ≅ G.over (Y k)),
    (∀ (k l : K) (Z : S.ProEt) (a : Z ⟶ Y k) (b : Z ⟶ Y l), a ≫ f k = b ≫ f l →
      ∀ x : F.obj.obj (Opposite.op Z),
        ((φ k).hom.hom.app (Opposite.op (Over.mk a))).hom x =
          ((φ l).hom.hom.app (Opposite.op (Over.mk b))).hom x) →
    Nonempty (F.over X ≅ G.over X) :=
by
  intro S F G X K Y f hcov φ hφ

  have hP : ∀ (A B : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}),
      Presieve.IsSheafFor (presheafHom A.obj B.obj) (Presieve.ofArrows Y f) := fun A B =>
    ((isSheaf_iff_isSheaf_of_type _ _).mp
      (Presheaf.IsSheaf.hom A.obj B.obj B.property)).isSheafFor _ hcov

  have glue : ∀ (A B : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
      (ψ : ∀ k, A.over (Y k) ⟶ B.over (Y k)),
      (∀ (k l : K) (Z : S.ProEt) (a : Z ⟶ Y k) (b : Z ⟶ Y l), a ≫ f k = b ≫ f l →
        ∀ x : A.obj.obj (Opposite.op Z),
          ((ψ k).hom.app (Opposite.op (Over.mk a))).hom x =
            ((ψ l).hom.app (Opposite.op (Over.mk b))).hom x) →
      ∃ α : A.over X ⟶ B.over X, ∀ (k : K) (Z : S.ProEt) (a : Z ⟶ Y k)
        (x : A.obj.obj (Opposite.op Z)),
        (α.hom.app (Opposite.op (Over.mk (a ≫ f k)))).hom x =
          ((ψ k).hom.app (Opposite.op (Over.mk a))).hom x := by
    intro A B ψ hψ
    obtain ⟨t, ht, -⟩ := (Presieve.isSheafFor_arrows_iff _ f).mp (hP A B)
      (fun k => (ψ k).hom) (by
        intro i j W gi gj h
        apply NatTrans.ext
        funext T
        obtain ⟨T⟩ := T
        change ((ConcreteCategory.hom ((presheafHom A.obj B.obj).map gi.op)) (ψ i).hom).app
            (Opposite.op (Over.mk T.hom)) =
          ((ConcreteCategory.hom ((presheafHom A.obj B.obj).map gj.op)) (ψ j).hom).app
            (Opposite.op (Over.mk T.hom))
        refine (presheafHom_map_app T.hom gi _ rfl (ψ i).hom).trans
          (Eq.trans ?_ (presheafHom_map_app T.hom gj _ rfl (ψ j).hom).symm)
        ext s
        exact hψ i j T.left (T.hom ≫ gi) (T.hom ≫ gj)
          (by rw [Category.assoc, Category.assoc, h]) s)
    refine ⟨ObjectProperty.homMk t, fun k Z a x => ?_⟩
    have e1 := (presheafHom_map_app a (f k) _ rfl t).symm.trans
      (congrArg (fun m : (presheafHom A.obj B.obj).obj (Opposite.op (Y k)) =>
        m.app (Opposite.op (Over.mk a))) (ht k))
    exact congrArg (fun m => AddCommGrpCat.Hom.hom m x) e1

  have uniq : ∀ (A B : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
      (α β : A.over X ⟶ B.over X),
      (∀ (k : K) (Z : S.ProEt) (a : Z ⟶ Y k) (x : A.obj.obj (Opposite.op Z)),
        (α.hom.app (Opposite.op (Over.mk (a ≫ f k)))).hom x =
          (β.hom.app (Opposite.op (Over.mk (a ≫ f k)))).hom x) →
      α = β := by
    intro A B α β h
    apply Sheaf.hom_ext
    refine (hP A B).isSeparatedFor.ext (t₁ := α.hom) (t₂ := β.hom) ?_
    rintro _ _ ⟨k⟩
    apply NatTrans.ext
    funext T
    obtain ⟨T⟩ := T
    change ((ConcreteCategory.hom ((presheafHom A.obj B.obj).map (f k).op)) α.hom).app
        (Opposite.op (Over.mk T.hom)) =
      ((ConcreteCategory.hom ((presheafHom A.obj B.obj).map (f k).op)) β.hom).app
        (Opposite.op (Over.mk T.hom))
    refine (presheafHom_map_app T.hom (f k) _ rfl α.hom).trans
      (Eq.trans ?_ (presheafHom_map_app T.hom (f k) _ rfl β.hom).symm)
    ext s
    exact h k T.left T.hom s

  have hinv1 : ∀ (k : K) (Z : S.ProEt) (a : Z ⟶ Y k) (x : F.obj.obj (Opposite.op Z)),
      ((φ k).inv.hom.app (Opposite.op (Over.mk a))).hom
        (((φ k).hom.hom.app (Opposite.op (Over.mk a))).hom x) = x := fun k Z a x =>
    congrArg (fun m : F.over (Y k) ⟶ F.over (Y k) =>
      (m.hom.app (Opposite.op (Over.mk a))).hom x) (φ k).hom_inv_id
  have hinv2 : ∀ (k : K) (Z : S.ProEt) (a : Z ⟶ Y k) (x : G.obj.obj (Opposite.op Z)),
      ((φ k).hom.hom.app (Opposite.op (Over.mk a))).hom
        (((φ k).inv.hom.app (Opposite.op (Over.mk a))).hom x) = x := fun k Z a x =>
    congrArg (fun m : G.over (Y k) ⟶ G.over (Y k) =>
      (m.hom.app (Opposite.op (Over.mk a))).hom x) (φ k).inv_hom_id

  have hφinv : ∀ (k l : K) (Z : S.ProEt) (a : Z ⟶ Y k) (b : Z ⟶ Y l), a ≫ f k = b ≫ f l →
      ∀ x : G.obj.obj (Opposite.op Z),
        ((φ k).inv.hom.app (Opposite.op (Over.mk a))).hom x =
          ((φ l).inv.hom.app (Opposite.op (Over.mk b))).hom x := by
    intro k l Z a b hab x
    have h1 := (hφ k l Z a b hab (((φ l).inv.hom.app (Opposite.op (Over.mk b))).hom x)).trans
      (hinv2 l Z b x)
    exact (congrArg (fun z => ((φ k).inv.hom.app (Opposite.op (Over.mk a))).hom z) h1).symm.trans
      (hinv1 k Z a _)
  obtain ⟨α, hα⟩ := glue F G (fun k => (φ k).hom) hφ
  obtain ⟨β, hβ⟩ := glue G F (fun k => (φ k).inv) hφinv
  refine ⟨{ hom := α, inv := β, hom_inv_id := ?_, inv_hom_id := ?_ }⟩
  · apply uniq F F
    intro k Z a x
    change (β.hom.app (Opposite.op (Over.mk (a ≫ f k)))).hom
        ((α.hom.app (Opposite.op (Over.mk (a ≫ f k)))).hom x) = x
    exact (congrArg (fun z => (β.hom.app (Opposite.op (Over.mk (a ≫ f k)))).hom z)
      (hα k Z a x)).trans ((hβ k Z a _).trans (hinv1 k Z a x))
  · apply uniq G G
    intro k Z a x
    change (α.hom.app (Opposite.op (Over.mk (a ≫ f k)))).hom
        ((β.hom.app (Opposite.op (Over.mk (a ≫ f k)))).hom x) = x
    exact (congrArg (fun z => (α.hom.app (Opposite.op (Over.mk (a ≫ f k)))).hom z)
      (hβ k Z a x)).trans ((hα k Z a _).trans (hinv2 k Z a x))

theorem wc_proet_loc_const_finite_fet_trivial : ∀ (S : Scheme.{u})
    (H : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (ℓ : ℕ)
    [Fact (Nat.Prime ℓ)] (U : Scheme.{u}) (u : U ⟶ S), WeaklyEtale u →
    ConnectedSpace U → CompactSpace U → QuasiSeparatedSpace U →
    ∀ (N : ℕ) (V : Fin N → Scheme.{u}) (v : ∀ j, V j ⟶ U), (∀ j, Etale (v j)) →
    (∀ x : U, ∃ j, x ∈ Set.range (v j)) →
    ∀ (hV : ∀ j, WeaklyEtale (v j ≫ u)) (b : Fin N → ℕ) (e : ∀ j, Fin (b j) → ℕ),
    (∀ j, Nonempty (H.over (MorphismProperty.Over.mk ⊤ (v j ≫ u) (hV j)) ≅
      (wcContSheaf S ((i : Fin (b j)) → ZMod (ℓ ^ e j i))).over
        (MorphismProperty.Over.mk ⊤ (v j ≫ u) (hV j)))) →
    ∃ (E : Scheme.{u}) (πE : E ⟶ U), IsFinite πE ∧ Etale πE ∧ Surjective πE ∧
      ∃ hE : WeaklyEtale (πE ≫ u), ∃ (b' : ℕ) (e' : Fin b' → ℕ),
        Nonempty (H.over (MorphismProperty.Over.mk ⊤ (πE ≫ u) hE) ≅
          (wcContSheaf S ((i : Fin b') → ZMod (ℓ ^ e' i))).over
            (MorphismProperty.Over.mk ⊤ (πE ≫ u) hE)) :=
by
  intro S H ℓ _ U u hu hconn hcpt hqs N V v het hcov hV b e hiso
  classical
  haveI := hu

  have main : ∀ (M : Type) [AddCommGroup M] [TopologicalSpace M] [DiscreteTopology M]
      [IsTopologicalAddGroup M] [Finite M] (ι : Type) [Finite ι] (κ : ι → Fin N),
      (∀ x : U, ∃ j, x ∈ Set.range (v (κ j))) →
      (∀ j, H.over (MorphismProperty.Over.mk ⊤ (v (κ j) ≫ u) (hV (κ j))) ≅
        (wcContSheaf S M).over (MorphismProperty.Over.mk ⊤ (v (κ j) ≫ u) (hV (κ j)))) →
      ∃ (E : Scheme.{u}) (πE : E ⟶ U), IsFinite πE ∧ Etale πE ∧ Surjective πE ∧
        ∃ hE : WeaklyEtale (πE ≫ u),
          Nonempty (H.over (MorphismProperty.Over.mk ⊤ (πE ≫ u) hE) ≅
            (wcContSheaf S M).over (MorphismProperty.Over.mk ⊤ (πE ≫ u) hE)) := by
    intro M _ _ _ _ _ ι _ κ hcovκ φ0
    let Y : ι → S.ProEt := fun j => MorphismProperty.Over.mk ⊤ (v (κ j) ≫ u) (hV (κ j))
    let φ : ∀ j, H.over (Y j) ≅ (wcContSheaf S M).over (Y j) := φ0

    obtain ⟨g, hgloc, hgcoc, hgφ⟩ := wc_proet_constSheaf_trivialization_cocycle S H M
      (wc_contSheaf_over_hom_pointwise S M M) ι Y φ

    obtain ⟨m, hm1, hm2⟩ : ∃ m : ∀ i j, Limits.pullback (v (κ i)) (v (κ j)) ⟶
        Limits.pullback (Y i).hom (Y j).hom,
        (∀ i j, m i j ≫ Limits.pullback.fst _ _ = Limits.pullback.fst _ _) ∧
        (∀ i j, m i j ≫ Limits.pullback.snd _ _ = Limits.pullback.snd _ _) :=
      ⟨fun i j => Limits.pullback.lift (Limits.pullback.fst _ _) (Limits.pullback.snd _ _)
        (by
          show Limits.pullback.fst _ _ ≫ v (κ i) ≫ u = Limits.pullback.snd _ _ ≫ v (κ j) ≫ u
          exact Limits.pullback.condition_assoc u),
        fun i j => Limits.pullback.lift_fst _ _ _, fun i j => Limits.pullback.lift_snd _ _ _⟩
    let g' : ∀ i j, ↥(Limits.pullback (v (κ i)) (v (κ j))) → Multiplicative (AddAut M) :=
      fun i j p => g i j (m i j p)
    have hg'loc : ∀ i j, IsLocallyConstant (g' i j) := fun i j =>
      (hgloc i j).comp_continuous (m i j).continuous
    have hpt : ∀ (i j : ι) (Z : Scheme.{u}) (p : Z ⟶ V (κ i)) (q : Z ⟶ V (κ j))
        (h : p ≫ v (κ i) = q ≫ v (κ j)) (h' : p ≫ (Y i).hom = q ≫ (Y j).hom) (z : Z),
        g' i j (Limits.pullback.lift p q h z) = g i j (Limits.pullback.lift p q h' z) := by
      intro i j Z p q h h' z
      have hc : Limits.pullback.lift p q h ≫ m i j = Limits.pullback.lift p q h' := by
        apply Limits.pullback.hom_ext
        · exact (Category.assoc _ _ _).trans
            ((congrArg (fun t => Limits.pullback.lift p q h ≫ t) (hm1 i j)).trans
              ((Limits.pullback.lift_fst p q h).trans (Limits.pullback.lift_fst p q h').symm))
        · exact (Category.assoc _ _ _).trans
            ((congrArg (fun t => Limits.pullback.lift p q h ≫ t) (hm2 i j)).trans
              ((Limits.pullback.lift_snd p q h).trans (Limits.pullback.lift_snd p q h').symm))
      have hz : m i j (Limits.pullback.lift p q h z) = Limits.pullback.lift p q h' z :=
        (Scheme.Hom.comp_apply _ _ z).symm.trans (congrArg (fun t => t z) hc)
      exact congrArg (g i j) hz

    have hcoc' : ∀ (i j k : ι) (Z : Scheme.{u}) (a : Z ⟶ V (κ i)) (b : Z ⟶ V (κ j))
        (c : Z ⟶ V (κ k)) (hab : a ≫ v (κ i) = b ≫ v (κ j)) (hbc : b ≫ v (κ j) = c ≫ v (κ k))
        (hac : a ≫ v (κ i) = c ≫ v (κ k)), Etale (a ≫ v (κ i)) → ∀ z : Z,
        g' i k (Limits.pullback.lift a c hac z) =
          g' i j (Limits.pullback.lift a b hab z) * g' j k (Limits.pullback.lift b c hbc z) := by
      intro i j k Z a b c hab hbc hac haet z
      haveI := haet
      let Z' : S.ProEt := MorphismProperty.Over.mk ⊤ ((a ≫ v (κ i)) ≫ u) inferInstance
      let a' : Z' ⟶ Y i := MorphismProperty.Over.homMk a
        (by show a ≫ v (κ i) ≫ u = (a ≫ v (κ i)) ≫ u; rw [Category.assoc]) trivial
      let b' : Z' ⟶ Y j := MorphismProperty.Over.homMk b
        (by show b ≫ v (κ j) ≫ u = (a ≫ v (κ i)) ≫ u; rw [hab, Category.assoc]) trivial
      let c' : Z' ⟶ Y k := MorphismProperty.Over.homMk c
        (by show c ≫ v (κ k) ≫ u = (a ≫ v (κ i)) ≫ u; rw [hac, Category.assoc]) trivial
      have e1 := hpt i k Z a c hac
        ((MorphismProperty.Over.w a').trans (MorphismProperty.Over.w c').symm) z
      have e2 := hpt i j Z a b hab
        ((MorphismProperty.Over.w a').trans (MorphismProperty.Over.w b').symm) z
      have e3 := hpt j k Z b c hbc
        ((MorphismProperty.Over.w b').trans (MorphismProperty.Over.w c').symm) z
      rw [e1, e2, e3]
      exact hgcoc i j k Z' a' b' c' z

    obtain ⟨E, πE, hfin, hetE, hsurj, s, hsπ, hsopen, hscov, hsmeet⟩ :=
      wc_fet_torsor_of_etale_cocycle U hcpt hqs (Multiplicative (AddAut M)) ι
        (fun j => V (κ j)) (fun j => v (κ j)) (fun j => het (κ j)) hcovκ g' hg'loc hcoc'
    have hsπ' : ∀ j γ, s j γ ≫ πE = v (κ j) := hsπ
    haveI := hetE
    have hE : WeaklyEtale (πE ≫ u) := inferInstance
    refine ⟨E, πE, hfin, hetE, hsurj, hE, ?_⟩
    let ES : S.ProEt := MorphismProperty.Over.mk ⊤ (πE ≫ u) hE
    let K := ι × Multiplicative (AddAut M)
    let Yk : K → S.ProEt := fun k => Y k.1
    let f : ∀ k, Yk k ⟶ ES := fun k => MorphismProperty.Over.homMk (s k.1 k.2)
      (by show s k.1 k.2 ≫ πE ≫ u = v (κ k.1) ≫ u; rw [← Category.assoc, hsπ']) trivial

    have hcovES : Sieve.generate (Presieve.ofArrows Yk f) ∈ Scheme.ProEt.topology S ES := by
      let eqv := Finite.equivFin K
      have h8 := wc_proet_open_family_covers S ES (Nat.card K) (fun i => Yk (eqv.symm i))
        (fun i => f (eqv.symm i)) (fun i => hsopen _ _) (by
          intro x
          obtain ⟨j, γ, y, hy⟩ := hscov x
          refine ⟨eqv (j, γ), ?_⟩
          show x ∈ Set.range (f (eqv.symm (eqv (j, γ)))).left
          rw [Equiv.symm_apply_apply]
          exact ⟨y, hy⟩)
      refine GrothendieckTopology.superset_covering _ ?_ h8
      rw [Sieve.generate_le_iff]
      rintro _ _ ⟨i⟩
      apply Sieve.le_generate
      exact Presieve.ofArrows.mk (eqv.symm i)

    choose θ hθ using fun γ : Multiplicative (AddAut M) =>
      wc_contSheaf_iso_of_addEquiv S M M (Multiplicative.toAdd γ)
    let ψ : ∀ k, H.over (Yk k) ≅ (wcContSheaf S M).over (Yk k) := fun k =>
      φ k.1 ≪≫ ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} (Yk k)).mapIso (θ k.2)

    refine wc_proet_sheaf_iso_glue S H (wcContSheaf S M) ES K Yk f hcovES ψ ?_
    rintro ⟨i, γ⟩ ⟨j, γ'⟩ Z a b hab x
    have hleft : a.left ≫ s i γ = b.left ≫ s j γ' := by
      have h := congrArg (fun t => t.left) hab
      exact h
    have hab' : a.left ≫ v (κ i) = b.left ≫ v (κ j) :=
      (congrArg (fun t => a.left ≫ t) (hsπ' i γ)).symm.trans ((Category.assoc _ _ _).symm.trans
        ((congrArg (fun t => t ≫ πE) hleft).trans ((Category.assoc _ _ _).trans
          (congrArg (fun t => b.left ≫ t) (hsπ' j γ')))))
    have e1 : ((ψ (i, γ)).hom.hom.app (Opposite.op (Over.mk a))).hom x =
        ((θ γ).hom.hom.app (Opposite.op Z)).hom
          (((φ i).hom.hom.app (Opposite.op (Over.mk a))).hom x) := rfl
    have e2 : ((ψ (j, γ')).hom.hom.app (Opposite.op (Over.mk b))).hom x =
        ((θ γ').hom.hom.app (Opposite.op Z)).hom
          (((φ j).hom.hom.app (Opposite.op (Over.mk b))).hom x) := rfl
    rw [e1, e2]
    have key : (show ULift.{u+1} C(Z.left, M) from ((θ γ).hom.hom.app (Opposite.op Z)).hom
          (((φ i).hom.hom.app (Opposite.op (Over.mk a))).hom x)) =
        (show ULift.{u+1} C(Z.left, M) from ((θ γ').hom.hom.app (Opposite.op Z)).hom
          (((φ j).hom.hom.app (Opposite.op (Over.mk b))).hom x)) := by
      apply ULift.ext
      apply ContinuousMap.ext
      intro z
      have h1 := hθ γ Z (((φ i).hom.hom.app (Opposite.op (Over.mk a))).hom x) z
      have h2 := hθ γ' Z (((φ j).hom.hom.app (Opposite.op (Over.mk b))).hom x) z
      have h3 := hgφ i j Z a b x z
      have h4 := hsmeet i j γ γ' Z.left a.left b.left hab' hleft z
      have h5 := hpt i j Z.left a.left b.left hab'
        ((MorphismProperty.Over.w a).trans (MorphismProperty.Over.w b).symm) z
      have h7 : γ' = γ * g i j (Limits.pullback.lift a.left b.left
          ((MorphismProperty.Over.w a).trans (MorphismProperty.Over.w b).symm) z) :=
        h4.trans (congrArg (fun δ => γ * δ) h5)
      have h6 : ∀ y : M, Multiplicative.toAdd γ' y = Multiplicative.toAdd γ
          (Multiplicative.toAdd (g i j (Limits.pullback.lift a.left b.left
            ((MorphismProperty.Over.w a).trans (MorphismProperty.Over.w b).symm) z)) y) := by
        intro y
        exact congrArg (fun δ : Multiplicative (AddAut M) => Multiplicative.toAdd δ y) h7
      refine (h1.trans ?_).trans h2.symm
      exact (congrArg (fun y => Multiplicative.toAdd γ y) h3).trans (h6 _).symm
    exact key

  have φ0 := fun j => (hiso j).some
  let R : Fin N → Fin N → Prop := fun j k =>
    Nonempty (((i : Fin (b j)) → ZMod (ℓ ^ e j i)) ≃+ ((i : Fin (b k)) → ZMod (ℓ ^ e k i)))
  have hR : Equivalence R :=
    ⟨fun j => ⟨AddEquiv.refl _⟩, fun ⟨σ⟩ => ⟨σ.symm⟩, fun ⟨σ⟩ ⟨τ⟩ => ⟨σ.trans τ⟩⟩
  have hrel : ∀ (j k : Fin N) (x : U), x ∈ Set.range (v j) → x ∈ Set.range (v k) → R j k := by
    rintro j k x ⟨y, rfl⟩ ⟨y', hy'⟩
    exact wc_proet_loc_const_fibre_iso S H _ _
      (MorphismProperty.Over.mk ⊤ (v j ≫ u) (hV j) : S.ProEt)
      (MorphismProperty.Over.mk ⊤ (v k ≫ u) (hV k) : S.ProEt) (φ0 j) (φ0 k) y y'
      (by
        show (v j ≫ u) y = (v k ≫ u) y'
        rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply, hy'])
  have hopen : ∀ j, IsOpenMap (v j) := fun j => by
    haveI := het j
    exact (v j).isOpenMap
  obtain ⟨j₀, hj₀⟩ := wc_connected_open_cover_one_class U hconn (Fin N) V v hopen hcov R hR hrel
  let ι := {j : Fin N // Nonempty (V j)}
  have hcovι : ∀ x : U, ∃ j : ι, x ∈ Set.range (v j.1) := by
    intro x
    obtain ⟨j, y, hy⟩ := hcov x
    exact ⟨⟨j, ⟨y⟩⟩, y, hy⟩
  let σ : ∀ j : ι, ((i : Fin (b j.1)) → ZMod (ℓ ^ e j.1 i)) ≃+
      ((i : Fin (b j₀)) → ZMod (ℓ ^ e j₀ i)) := fun j => (hj₀ j.1 j.2).some
  choose θ _ using fun j : ι => wc_contSheaf_iso_of_addEquiv S _ _ (σ j)
  let φ' : ∀ j : ι, H.over (MorphismProperty.Over.mk ⊤ (v j.1 ≫ u) (hV j.1)) ≅
      (wcContSheaf S ((i : Fin (b j₀)) → ZMod (ℓ ^ e j₀ i))).over
        (MorphismProperty.Over.mk ⊤ (v j.1 ≫ u) (hV j.1)) := fun j =>
    φ0 j.1 ≪≫ ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1}
      (MorphismProperty.Over.mk ⊤ (v j.1 ≫ u) (hV j.1) : S.ProEt)).mapIso (θ j)
  obtain ⟨E, πE, hfin, hetE, hsurj, hE, hiso'⟩ :=
    main ((i : Fin (b j₀)) → ZMod (ℓ ^ e j₀ i)) ι Subtype.val hcovι φ'
  exact ⟨E, πE, hfin, hetE, hsurj, hE, b j₀, e j₀, hiso'⟩

theorem wc_proet_over_contSheaf_discrete_hom : ∀ (S : Scheme.{u}) (V : S.ProEt), ConnectedSpace V.left →
    ∀ {M M' : Type} [AddCommGroup M] [TopologicalSpace M] [DiscreteTopology M] [IsTopologicalAddGroup M]
      [AddCommGroup M'] [TopologicalSpace M'] [DiscreteTopology M'] [IsTopologicalAddGroup M']
      (φ : (wcContSheaf S M).over V ⟶ (wcContSheaf S M').over V),
    ∃ ρ : M →+ M', φ = ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} V).map
      (wcContSheafMap S ρ continuous_of_discreteTopology) :=
by
  intro S V hV M M' _ _ _ _ _ _ _ _ φ
  classical
  let one : Over V := Over.mk (𝟙 V)

  let g : M → C(V.left, M') := fun m =>
    (show ULift.{u+1} C(V.left, M') from
      (φ.hom.app (Opposite.op one)).hom
        (show ((wcContSheaf S M).over V).obj.obj (Opposite.op one) from
          ULift.up (ContinuousMap.const V.left m))).down
  obtain ⟨v₀⟩ := hV.toNonempty
  have hconst : ∀ (m : M) (v : V.left), g m v = g m v₀ := fun m v =>
    (isPreconnected_range (g m).continuous).subsingleton ⟨v, rfl⟩ ⟨v₀, rfl⟩
  have hadd : ∀ m m' : M, g (m + m') v₀ = g m v₀ + g m' v₀ := by
    intro m m'
    let A : ((wcContSheaf S M).over V).obj.obj (Opposite.op one) :=
      ULift.up (ContinuousMap.const V.left m)
    let B : ((wcContSheaf S M).over V).obj.obj (Opposite.op one) :=
      ULift.up (ContinuousMap.const V.left m')
    have hsum : (show ((wcContSheaf S M).over V).obj.obj (Opposite.op one) from
          ULift.up (ContinuousMap.const V.left (m + m'))) = A + B := rfl
    have h3 : (φ.hom.app (Opposite.op one)).hom (A + B) =
        (φ.hom.app (Opposite.op one)).hom A + (φ.hom.app (Opposite.op one)).hom B :=
      map_add _ A B
    have h4 := congrArg (fun z : ((wcContSheaf S M').over V).obj.obj (Opposite.op one) =>
      (show ULift.{u+1} C(V.left, M') from z).down v₀) h3
    have h5 := congrArg (fun z => (show ULift.{u+1} C(V.left, M') from
      (φ.hom.app (Opposite.op one)).hom z).down v₀) hsum
    exact h5.trans h4
  let ρ : M →+ M' := AddMonoidHom.mk' (fun m => g m v₀) hadd

  have hpt : ∀ (X : Over V) (f : C(X.left.left, M)) (t : X.left.left),
      (show ULift.{u+1} C(X.left.left, M') from
        (φ.hom.app (Opposite.op X)).hom
          (show ((wcContSheaf S M).over V).obj.obj (Opposite.op X) from ULift.up f)).down t =
        g (f t) (X.hom.left t) := by
    intro X f t
    let P : S.ProEt := X.left
    have hU : IsOpen (f ⁻¹' {f t}) := (isOpen_discrete _).preimage f.continuous
    let U : P.left.Opens := ⟨f ⁻¹' {f t}, hU⟩
    have hYw : WeaklyEtale (U.ι ≫ P.hom) := by
      have := P.prop
      infer_instance
    let Y : S.ProEt := Scheme.ProEt.mk (U.ι ≫ P.hom)
    let i : Y ⟶ P := MorphismProperty.Over.homMk U.ι rfl trivial
    let Y' : Over V := Over.mk (i ≫ X.hom)
    let a : Y' ⟶ X := Over.homMk i rfl
    let b : Y' ⟶ one := Over.homMk (i ≫ X.hom) (Category.comp_id _)
    let x : ((wcContSheaf S M).over V).obj.obj (Opposite.op X) := ULift.up f
    let c : ((wcContSheaf S M).over V).obj.obj (Opposite.op one) :=
      ULift.up (ContinuousMap.const V.left (f t))
    have hy : ∀ y : U, f (U.ι y) = f t := fun y => by
      rw [Scheme.Opens.ι_apply]
      exact y.2
    have hres : (((wcContSheaf S M).over V).obj.map a.op).hom x =
        (((wcContSheaf S M).over V).obj.map b.op).hom c := by
      change (ULift.up (f.comp a.left.left.base.hom) : ULift.{u+1} C(Y'.left.left, M)) =
        ULift.up ((ContinuousMap.const V.left (f t)).comp b.left.left.base.hom)
      congr 1
      ext y
      exact hy y
    have e1 : (φ.hom.app (Opposite.op Y')).hom
          ((((wcContSheaf S M).over V).obj.map a.op).hom x) =
        (((wcContSheaf S M').over V).obj.map a.op).hom ((φ.hom.app (Opposite.op X)).hom x) :=
      congrArg (fun h => AddCommGrpCat.Hom.hom h x) (φ.hom.naturality a.op)
    have e2 : (φ.hom.app (Opposite.op Y')).hom
          ((((wcContSheaf S M).over V).obj.map b.op).hom c) =
        (((wcContSheaf S M').over V).obj.map b.op).hom ((φ.hom.app (Opposite.op one)).hom c) :=
      congrArg (fun h => AddCommGrpCat.Hom.hom h c) (φ.hom.naturality b.op)
    have e3 : (((wcContSheaf S M').over V).obj.map a.op).hom ((φ.hom.app (Opposite.op X)).hom x) =
        (((wcContSheaf S M').over V).obj.map b.op).hom ((φ.hom.app (Opposite.op one)).hom c) := by
      rw [← e1, ← e2, hres]
    let t' : U := ⟨t, Set.mem_singleton (f t)⟩
    have e4 : (show ULift.{u+1} C(X.left.left, M') from
          (φ.hom.app (Opposite.op X)).hom x).down (U.ι t') =
        g (f t) (X.hom.left (U.ι t')) :=
      congrArg (fun z : ULift.{u+1} C(Y'.left.left, M') => z.down t') e3
    have hι : U.ι t' = t := Scheme.Opens.ι_apply U t'
    rw [hι] at e4
    exact e4
  refine ⟨ρ, ?_⟩
  apply Sheaf.hom_ext
  apply NatTrans.ext
  funext Xop
  obtain ⟨X⟩ := Xop
  apply AddCommGrpCat.ext
  intro x
  change ULift.{u+1} C(X.left.left, M) at x
  obtain ⟨f⟩ := x
  refine ULift.ext _ _ (ContinuousMap.ext fun t => ?_)
  exact (hpt X f t).trans (hconst _ _)

theorem wc_rightDerived_preserves_nat_products : ∀ {C D : Type*} [Category C] [Category D] [Abelian C] [Abelian D] [HasInjectiveResolutions C] [EnoughInjectives C] [Limits.HasLimitsOfShape (Discrete ℕ) C] [HasExactLimitsOfShape (Discrete ℕ) C] [Limits.HasLimitsOfShape (Discrete ℕ) D] [HasExactLimitsOfShape (Discrete ℕ) D] (R : C ⥤ D) [R.Additive] [Limits.PreservesLimitsOfShape (Discrete ℕ) R] (Y : C) (B : ℕ → C) (pr : ∀ n, Y ⟶ B n), Limits.IsLimit (Limits.Fan.mk Y pr) → ∀ q : ℕ, Nonempty (Limits.IsLimit (Limits.Fan.mk ((R.rightDerived q).obj Y) (fun n => (R.rightDerived q).map (pr n)))) :=
by
  intro C D _ _ _ _ _ _ _ _ _ _ R _ _ Y B pr hY q
  have s4_C : ∀ {A A' : C} {B B' : ℕ → C} (a : ∀ n, A ⟶ B n) (a' : ∀ n, A' ⟶ B' n)
      (eA : A' ≅ A) (e : ∀ n, B' n ≅ B n), (∀ n, a' n ≫ (e n).hom = eA.hom ≫ a n) →
      Limits.IsLimit (Limits.Fan.mk A a) → Limits.IsLimit (Limits.Fan.mk A' a') := by
    intro A A' B B' a a' eA e hc h
    refine Limits.Fan.IsLimit.mk _
      (fun t => Limits.Fan.IsLimit.lift h (fun n => t.proj n ≫ (e n).hom) ≫ eA.inv) ?_ ?_
    · intro t n
      have h1 : a' n = eA.hom ≫ a n ≫ (e n).inv := by
        rw [← Category.assoc, ← hc n, Category.assoc, Iso.hom_inv_id, Category.comp_id]
      have h2 : Limits.Fan.IsLimit.lift h (fun n => t.proj n ≫ (e n).hom) ≫ a n =
          t.proj n ≫ (e n).hom := Limits.Fan.IsLimit.fac h _ n
      show _ ≫ a' n = _
      rw [h1, Category.assoc, Iso.inv_hom_id_assoc, ← Category.assoc, h2, Category.assoc,
        Iso.hom_inv_id, Category.comp_id]
    · intro t m hm
      rw [Iso.eq_comp_inv]
      apply Limits.Fan.IsLimit.hom_ext h
      intro n
      have h2 : Limits.Fan.IsLimit.lift h (fun n => t.proj n ≫ (e n).hom) ≫ a n =
          t.proj n ≫ (e n).hom := Limits.Fan.IsLimit.fac h _ n
      have h3 : m ≫ a' n = t.proj n := hm n
      show (m ≫ eA.hom) ≫ a n = Limits.Fan.IsLimit.lift h (fun n => t.proj n ≫ (e n).hom) ≫ a n
      rw [h2, Category.assoc, ← hc n, ← Category.assoc, h3]
  have s1_C : ∀ (S : ShortComplex C) (T : ℕ → ShortComplex C) (φ : ∀ n, S ⟶ T n),
      Limits.IsLimit (Limits.Fan.mk S.X₂ (fun n => (φ n).τ₂)) →
      Limits.IsLimit (Limits.Fan.mk S.X₃ (fun n => (φ n).τ₃)) →
      Limits.IsLimit (Limits.Fan.mk S.cycles (fun n => ShortComplex.cyclesMap (φ n))) := by
    intro S T φ h₂ h₃
    have hk : ∀ (t : Limits.Fan (fun n => (T n).cycles)),
        Limits.Fan.IsLimit.lift h₂ (fun n => t.proj n ≫ (T n).iCycles) ≫ S.g = 0 := by
      intro t
      apply Limits.Fan.IsLimit.hom_ext h₃
      intro n
      have e1 : Limits.Fan.IsLimit.lift h₂ (fun n => t.proj n ≫ (T n).iCycles) ≫ (φ n).τ₂ =
          t.proj n ≫ (T n).iCycles := Limits.Fan.IsLimit.fac h₂ _ n
      show (Limits.Fan.IsLimit.lift h₂ (fun n => t.proj n ≫ (T n).iCycles) ≫ S.g) ≫ (φ n).τ₃ =
        0 ≫ (φ n).τ₃
      rw [Category.assoc, ← (φ n).comm₂₃, ← Category.assoc, e1, Category.assoc,
        ShortComplex.iCycles_g, Limits.comp_zero, Limits.zero_comp]
    refine Limits.Fan.IsLimit.mk _ (fun t => S.liftCycles _ (hk t)) ?_ ?_
    · intro t n
      rw [← cancel_mono (T n).iCycles]
      have e1 : Limits.Fan.IsLimit.lift h₂ (fun n => t.proj n ≫ (T n).iCycles) ≫ (φ n).τ₂ =
          t.proj n ≫ (T n).iCycles := Limits.Fan.IsLimit.fac h₂ _ n
      show (S.liftCycles _ (hk t) ≫ ShortComplex.cyclesMap (φ n)) ≫ (T n).iCycles = _
      rw [Category.assoc, ShortComplex.cyclesMap_i, ← Category.assoc, ShortComplex.liftCycles_i, e1]
    · intro t m hm
      rw [← cancel_mono S.iCycles, ShortComplex.liftCycles_i]
      apply Limits.Fan.IsLimit.hom_ext h₂
      intro n
      have e1 : Limits.Fan.IsLimit.lift h₂ (fun n => t.proj n ≫ (T n).iCycles) ≫ (φ n).τ₂ =
          t.proj n ≫ (T n).iCycles := Limits.Fan.IsLimit.fac h₂ _ n
      have h3 : m ≫ ShortComplex.cyclesMap (φ n) = t.proj n := hm n
      show (m ≫ S.iCycles) ≫ (φ n).τ₂ =
        Limits.Fan.IsLimit.lift h₂ (fun n => t.proj n ≫ (T n).iCycles) ≫ (φ n).τ₂
      rw [e1, Category.assoc, ← ShortComplex.cyclesMap_i, ← Category.assoc, h3]
  have s2_C : ∀ (X Z Q : C) (Xn Zn Qn : ℕ → C)
      (x : ∀ n, X ⟶ Xn n) (z : ∀ n, Z ⟶ Zn n) (c : X ⟶ Z) (cn : ∀ n, Xn n ⟶ Zn n)
      (_ : ∀ n, c ≫ z n = x n ≫ cn n) (p : Z ⟶ Q) (hp : c ≫ p = 0) (pn : ∀ n, Zn n ⟶ Qn n)
      (hpn : ∀ n, cn n ≫ pn n = 0) (_ : Limits.IsColimit (Limits.CokernelCofork.ofπ p hp))
      (_ : ∀ n, Limits.IsColimit (Limits.CokernelCofork.ofπ (pn n) (hpn n)))
      (q : ∀ n, Q ⟶ Qn n) (_ : ∀ n, p ≫ q n = z n ≫ pn n)
      (_ : Limits.IsLimit (Limits.Fan.mk X x)) (_ : Limits.IsLimit (Limits.Fan.mk Z z)),
      Limits.IsLimit (Limits.Fan.mk Q q) := by
    intro X Z Q Xn Zn Qn x z c cn hc p hp pn hpn hQ hQn q hq hX hZ
    let α : Discrete.functor Xn ⟶ Discrete.functor Zn := Discrete.natTrans (fun j => cn j.as)
    let β : Discrete.functor Zn ⟶ Discrete.functor Qn := Discrete.natTrans (fun j => pn j.as)
    have hαβ : α ≫ β = 0 := by
      ext j
      simp only [NatTrans.comp_app, NatTrans.app_zero]
      exact hpn j.as
    have hcok : Limits.IsColimit (Limits.CokernelCofork.ofπ β hαβ) := by
      refine Limits.CokernelCofork.IsColimit.ofπ _ _
        (fun {G} g' hg' => Discrete.natTrans (fun j =>
          (Limits.CokernelCofork.IsColimit.desc' (hQn j.as) (g'.app j) (by
            have h1 := NatTrans.congr_app hg' j
            simp only [NatTrans.comp_app, NatTrans.app_zero] at h1
            exact h1)).1)) ?_ ?_
      · intro G g' hg'
        ext j
        simp only [NatTrans.comp_app]
        exact (Limits.CokernelCofork.IsColimit.desc' (hQn j.as) (g'.app j) _).2
      · intro G g' hg' m hm
        ext j
        apply Limits.Cofork.IsColimit.hom_ext (hQn j.as)
        have h1 := NatTrans.congr_app hm j
        simp only [NatTrans.comp_app] at h1
        refine h1.trans ?_
        exact (Limits.CokernelCofork.IsColimit.desc' (hQn j.as) (g'.app j) _).2.symm
    have hL := Limits.CokernelCofork.mapIsColimit _ hcok (Limits.lim : (Discrete ℕ ⥤ C) ⥤ C)
    let eX : X ≅ Limits.limit (Discrete.functor Xn) :=
      hX.conePointUniqueUpToIso (Limits.limit.isLimit _)
    let eZ : Z ≅ Limits.limit (Discrete.functor Zn) :=
      hZ.conePointUniqueUpToIso (Limits.limit.isLimit _)
    have hXπ : ∀ j, eX.hom ≫ Limits.limit.π (Discrete.functor Xn) j = x j.as := fun j =>
      Limits.IsLimit.conePointUniqueUpToIso_hom_comp hX (Limits.limit.isLimit _) j
    have hZπ : ∀ j, eZ.hom ≫ Limits.limit.π (Discrete.functor Zn) j = z j.as := fun j =>
      Limits.IsLimit.conePointUniqueUpToIso_hom_comp hZ (Limits.limit.isLimit _) j
    have key : c ≫ eZ.hom = eX.hom ≫ Limits.lim.map α := by
      apply Limits.limit.hom_ext
      intro j
      rw [Limits.lim_map, Category.assoc, Category.assoc, Limits.limMap_π, hZπ,
        ← Category.assoc, hXπ]
      exact hc j.as
    let φ : Arrow.mk c ≅ Arrow.mk (Limits.lim.map α) := Arrow.isoMk eX eZ key.symm
    let eQ : Q ≅ ((Limits.CokernelCofork.ofπ β hαβ).map Limits.lim).pt :=
      Limits.CokernelCofork.mapIsoOfIsColimit hQ hL φ
    have hpe : p ≫ eQ.hom = eZ.hom ≫ Limits.lim.map β :=
      Limits.CokernelCofork.π_mapOfIsColimit hQ
        ((Limits.CokernelCofork.ofπ β hαβ).map Limits.lim) φ.hom
    have hQπ : ∀ j, eQ.hom ≫ Limits.limit.π (Discrete.functor Qn) j = q j.as := by
      intro j
      apply Limits.Cofork.IsColimit.hom_ext hQ
      show p ≫ eQ.hom ≫ Limits.limit.π (Discrete.functor Qn) j = p ≫ q j.as
      have hβπ : Limits.lim.map β ≫ Limits.limit.π (Discrete.functor Qn) j =
          Limits.limit.π (Discrete.functor Zn) j ≫ pn j.as := by
        rw [Limits.lim_map, Limits.limMap_π]; rfl
      rw [← Category.assoc, hpe, Category.assoc, hβπ, ← Category.assoc, hZπ, hq]
    refine Limits.IsLimit.ofIsoLimit (Limits.limit.isLimit (Discrete.functor Qn))
      (Limits.Cone.ext eQ.symm ?_)
    intro j
    show Limits.limit.π (Discrete.functor Qn) j = eQ.inv ≫ q j.as
    rw [← hQπ j, Iso.inv_hom_id_assoc]
  have hH_C : ∀ (S : ShortComplex C) (T : ℕ → ShortComplex C) (φ : ∀ n, S ⟶ T n),
      Limits.IsLimit (Limits.Fan.mk S.X₁ (fun n => (φ n).τ₁)) →
      Limits.IsLimit (Limits.Fan.mk S.X₂ (fun n => (φ n).τ₂)) →
      Limits.IsLimit (Limits.Fan.mk S.X₃ (fun n => (φ n).τ₃)) →
      Limits.IsLimit (Limits.Fan.mk S.homology (fun n => ShortComplex.homologyMap (φ n))) := by
    intro S T φ h₁ h₂ h₃
    exact s2_C S.X₁ S.cycles S.homology (fun n => (T n).X₁) (fun n => (T n).cycles)
      (fun n => (T n).homology) (fun n => (φ n).τ₁) (fun n => ShortComplex.cyclesMap (φ n))
      S.toCycles (fun n => (T n).toCycles) (fun n => ShortComplex.toCycles_naturality (φ n))
      S.homologyπ S.toCycles_comp_homologyπ (fun n => (T n).homologyπ)
      (fun n => (T n).toCycles_comp_homologyπ) S.homologyIsCokernel
      (fun n => (T n).homologyIsCokernel) (fun n => ShortComplex.homologyMap (φ n))
      (fun n => ShortComplex.homologyπ_naturality (φ n)) h₁ (s1_C S T φ h₂ h₃)
  have s4_D : ∀ {A A' : D} {B B' : ℕ → D} (a : ∀ n, A ⟶ B n) (a' : ∀ n, A' ⟶ B' n)
      (eA : A' ≅ A) (e : ∀ n, B' n ≅ B n), (∀ n, a' n ≫ (e n).hom = eA.hom ≫ a n) →
      Limits.IsLimit (Limits.Fan.mk A a) → Limits.IsLimit (Limits.Fan.mk A' a') := by
    intro A A' B B' a a' eA e hc h
    refine Limits.Fan.IsLimit.mk _
      (fun t => Limits.Fan.IsLimit.lift h (fun n => t.proj n ≫ (e n).hom) ≫ eA.inv) ?_ ?_
    · intro t n
      have h1 : a' n = eA.hom ≫ a n ≫ (e n).inv := by
        rw [← Category.assoc, ← hc n, Category.assoc, Iso.hom_inv_id, Category.comp_id]
      have h2 : Limits.Fan.IsLimit.lift h (fun n => t.proj n ≫ (e n).hom) ≫ a n =
          t.proj n ≫ (e n).hom := Limits.Fan.IsLimit.fac h _ n
      show _ ≫ a' n = _
      rw [h1, Category.assoc, Iso.inv_hom_id_assoc, ← Category.assoc, h2, Category.assoc,
        Iso.hom_inv_id, Category.comp_id]
    · intro t m hm
      rw [Iso.eq_comp_inv]
      apply Limits.Fan.IsLimit.hom_ext h
      intro n
      have h2 : Limits.Fan.IsLimit.lift h (fun n => t.proj n ≫ (e n).hom) ≫ a n =
          t.proj n ≫ (e n).hom := Limits.Fan.IsLimit.fac h _ n
      have h3 : m ≫ a' n = t.proj n := hm n
      show (m ≫ eA.hom) ≫ a n = Limits.Fan.IsLimit.lift h (fun n => t.proj n ≫ (e n).hom) ≫ a n
      rw [h2, Category.assoc, ← hc n, ← Category.assoc, h3]
  have s1_D : ∀ (S : ShortComplex D) (T : ℕ → ShortComplex D) (φ : ∀ n, S ⟶ T n),
      Limits.IsLimit (Limits.Fan.mk S.X₂ (fun n => (φ n).τ₂)) →
      Limits.IsLimit (Limits.Fan.mk S.X₃ (fun n => (φ n).τ₃)) →
      Limits.IsLimit (Limits.Fan.mk S.cycles (fun n => ShortComplex.cyclesMap (φ n))) := by
    intro S T φ h₂ h₃
    have hk : ∀ (t : Limits.Fan (fun n => (T n).cycles)),
        Limits.Fan.IsLimit.lift h₂ (fun n => t.proj n ≫ (T n).iCycles) ≫ S.g = 0 := by
      intro t
      apply Limits.Fan.IsLimit.hom_ext h₃
      intro n
      have e1 : Limits.Fan.IsLimit.lift h₂ (fun n => t.proj n ≫ (T n).iCycles) ≫ (φ n).τ₂ =
          t.proj n ≫ (T n).iCycles := Limits.Fan.IsLimit.fac h₂ _ n
      show (Limits.Fan.IsLimit.lift h₂ (fun n => t.proj n ≫ (T n).iCycles) ≫ S.g) ≫ (φ n).τ₃ =
        0 ≫ (φ n).τ₃
      rw [Category.assoc, ← (φ n).comm₂₃, ← Category.assoc, e1, Category.assoc,
        ShortComplex.iCycles_g, Limits.comp_zero, Limits.zero_comp]
    refine Limits.Fan.IsLimit.mk _ (fun t => S.liftCycles _ (hk t)) ?_ ?_
    · intro t n
      rw [← cancel_mono (T n).iCycles]
      have e1 : Limits.Fan.IsLimit.lift h₂ (fun n => t.proj n ≫ (T n).iCycles) ≫ (φ n).τ₂ =
          t.proj n ≫ (T n).iCycles := Limits.Fan.IsLimit.fac h₂ _ n
      show (S.liftCycles _ (hk t) ≫ ShortComplex.cyclesMap (φ n)) ≫ (T n).iCycles = _
      rw [Category.assoc, ShortComplex.cyclesMap_i, ← Category.assoc, ShortComplex.liftCycles_i, e1]
    · intro t m hm
      rw [← cancel_mono S.iCycles, ShortComplex.liftCycles_i]
      apply Limits.Fan.IsLimit.hom_ext h₂
      intro n
      have e1 : Limits.Fan.IsLimit.lift h₂ (fun n => t.proj n ≫ (T n).iCycles) ≫ (φ n).τ₂ =
          t.proj n ≫ (T n).iCycles := Limits.Fan.IsLimit.fac h₂ _ n
      have h3 : m ≫ ShortComplex.cyclesMap (φ n) = t.proj n := hm n
      show (m ≫ S.iCycles) ≫ (φ n).τ₂ =
        Limits.Fan.IsLimit.lift h₂ (fun n => t.proj n ≫ (T n).iCycles) ≫ (φ n).τ₂
      rw [e1, Category.assoc, ← ShortComplex.cyclesMap_i, ← Category.assoc, h3]
  have s2_D : ∀ (X Z Q : D) (Xn Zn Qn : ℕ → D)
      (x : ∀ n, X ⟶ Xn n) (z : ∀ n, Z ⟶ Zn n) (c : X ⟶ Z) (cn : ∀ n, Xn n ⟶ Zn n)
      (_ : ∀ n, c ≫ z n = x n ≫ cn n) (p : Z ⟶ Q) (hp : c ≫ p = 0) (pn : ∀ n, Zn n ⟶ Qn n)
      (hpn : ∀ n, cn n ≫ pn n = 0) (_ : Limits.IsColimit (Limits.CokernelCofork.ofπ p hp))
      (_ : ∀ n, Limits.IsColimit (Limits.CokernelCofork.ofπ (pn n) (hpn n)))
      (q : ∀ n, Q ⟶ Qn n) (_ : ∀ n, p ≫ q n = z n ≫ pn n)
      (_ : Limits.IsLimit (Limits.Fan.mk X x)) (_ : Limits.IsLimit (Limits.Fan.mk Z z)),
      Limits.IsLimit (Limits.Fan.mk Q q) := by
    intro X Z Q Xn Zn Qn x z c cn hc p hp pn hpn hQ hQn q hq hX hZ
    let α : Discrete.functor Xn ⟶ Discrete.functor Zn := Discrete.natTrans (fun j => cn j.as)
    let β : Discrete.functor Zn ⟶ Discrete.functor Qn := Discrete.natTrans (fun j => pn j.as)
    have hαβ : α ≫ β = 0 := by
      ext j
      simp only [NatTrans.comp_app, NatTrans.app_zero]
      exact hpn j.as
    have hcok : Limits.IsColimit (Limits.CokernelCofork.ofπ β hαβ) := by
      refine Limits.CokernelCofork.IsColimit.ofπ _ _
        (fun {G} g' hg' => Discrete.natTrans (fun j =>
          (Limits.CokernelCofork.IsColimit.desc' (hQn j.as) (g'.app j) (by
            have h1 := NatTrans.congr_app hg' j
            simp only [NatTrans.comp_app, NatTrans.app_zero] at h1
            exact h1)).1)) ?_ ?_
      · intro G g' hg'
        ext j
        simp only [NatTrans.comp_app]
        exact (Limits.CokernelCofork.IsColimit.desc' (hQn j.as) (g'.app j) _).2
      · intro G g' hg' m hm
        ext j
        apply Limits.Cofork.IsColimit.hom_ext (hQn j.as)
        have h1 := NatTrans.congr_app hm j
        simp only [NatTrans.comp_app] at h1
        refine h1.trans ?_
        exact (Limits.CokernelCofork.IsColimit.desc' (hQn j.as) (g'.app j) _).2.symm
    have hL := Limits.CokernelCofork.mapIsColimit _ hcok (Limits.lim : (Discrete ℕ ⥤ D) ⥤ D)
    let eX : X ≅ Limits.limit (Discrete.functor Xn) :=
      hX.conePointUniqueUpToIso (Limits.limit.isLimit _)
    let eZ : Z ≅ Limits.limit (Discrete.functor Zn) :=
      hZ.conePointUniqueUpToIso (Limits.limit.isLimit _)
    have hXπ : ∀ j, eX.hom ≫ Limits.limit.π (Discrete.functor Xn) j = x j.as := fun j =>
      Limits.IsLimit.conePointUniqueUpToIso_hom_comp hX (Limits.limit.isLimit _) j
    have hZπ : ∀ j, eZ.hom ≫ Limits.limit.π (Discrete.functor Zn) j = z j.as := fun j =>
      Limits.IsLimit.conePointUniqueUpToIso_hom_comp hZ (Limits.limit.isLimit _) j
    have key : c ≫ eZ.hom = eX.hom ≫ Limits.lim.map α := by
      apply Limits.limit.hom_ext
      intro j
      rw [Limits.lim_map, Category.assoc, Category.assoc, Limits.limMap_π, hZπ,
        ← Category.assoc, hXπ]
      exact hc j.as
    let φ : Arrow.mk c ≅ Arrow.mk (Limits.lim.map α) := Arrow.isoMk eX eZ key.symm
    let eQ : Q ≅ ((Limits.CokernelCofork.ofπ β hαβ).map Limits.lim).pt :=
      Limits.CokernelCofork.mapIsoOfIsColimit hQ hL φ
    have hpe : p ≫ eQ.hom = eZ.hom ≫ Limits.lim.map β :=
      Limits.CokernelCofork.π_mapOfIsColimit hQ
        ((Limits.CokernelCofork.ofπ β hαβ).map Limits.lim) φ.hom
    have hQπ : ∀ j, eQ.hom ≫ Limits.limit.π (Discrete.functor Qn) j = q j.as := by
      intro j
      apply Limits.Cofork.IsColimit.hom_ext hQ
      show p ≫ eQ.hom ≫ Limits.limit.π (Discrete.functor Qn) j = p ≫ q j.as
      have hβπ : Limits.lim.map β ≫ Limits.limit.π (Discrete.functor Qn) j =
          Limits.limit.π (Discrete.functor Zn) j ≫ pn j.as := by
        rw [Limits.lim_map, Limits.limMap_π]; rfl
      rw [← Category.assoc, hpe, Category.assoc, hβπ, ← Category.assoc, hZπ, hq]
    refine Limits.IsLimit.ofIsoLimit (Limits.limit.isLimit (Discrete.functor Qn))
      (Limits.Cone.ext eQ.symm ?_)
    intro j
    show Limits.limit.π (Discrete.functor Qn) j = eQ.inv ≫ q j.as
    rw [← hQπ j, Iso.inv_hom_id_assoc]
  have hH_D : ∀ (S : ShortComplex D) (T : ℕ → ShortComplex D) (φ : ∀ n, S ⟶ T n),
      Limits.IsLimit (Limits.Fan.mk S.X₁ (fun n => (φ n).τ₁)) →
      Limits.IsLimit (Limits.Fan.mk S.X₂ (fun n => (φ n).τ₂)) →
      Limits.IsLimit (Limits.Fan.mk S.X₃ (fun n => (φ n).τ₃)) →
      Limits.IsLimit (Limits.Fan.mk S.homology (fun n => ShortComplex.homologyMap (φ n))) := by
    intro S T φ h₁ h₂ h₃
    exact s2_D S.X₁ S.cycles S.homology (fun n => (T n).X₁) (fun n => (T n).cycles)
      (fun n => (T n).homology) (fun n => (φ n).τ₁) (fun n => ShortComplex.cyclesMap (φ n))
      S.toCycles (fun n => (T n).toCycles) (fun n => ShortComplex.toCycles_naturality (φ n))
      S.homologyπ S.toCycles_comp_homologyπ (fun n => (T n).homologyπ)
      (fun n => (T n).toCycles_comp_homologyπ) S.homologyIsCokernel
      (fun n => (T n).homologyIsCokernel) (fun n => ShortComplex.homologyMap (φ n))
      (fun n => ShortComplex.homologyπ_naturality (φ n)) h₁ (s1_D S T φ h₂ h₃)
  have hs5 : ∀ (I : ∀ n, InjectiveResolution (B n)),
      ∃ (J : InjectiveResolution Y) (φ : ∀ n, J.cocomplex ⟶ (I n).cocomplex),
      (∀ n, J.ι.f 0 ≫ (φ n).f 0 = pr n ≫ (I n).ι.f 0) ∧
      ∀ k : ℕ, Nonempty (Limits.IsLimit (Limits.Fan.mk (J.cocomplex.X k) (fun n => (φ n).f k))) := by
    intro I
    let K : ℕ → CochainComplex C ℕ := fun n => (I n).cocomplex
    let P : CochainComplex C ℕ := Limits.piObj K
    let π : ∀ n, P ⟶ K n := fun n => Limits.Pi.π K n
    have hdeg : ∀ k, Limits.IsLimit (Limits.Fan.mk (P.X k) (fun n => (π n).f k)) := fun k =>
      Limits.isLimitFanMkObjOfIsLimit (HomologicalComplex.eval C (ComplexShape.up ℕ) k) _ _
        (Limits.productIsProduct K)
    have hinj : ∀ k, Injective (P.X k) := by
      intro k
      haveI : ∀ n, Injective ((K n).X k) := fun n => (I n).injective k
      exact Injective.of_iso ((hdeg k).conePointUniqueUpToIso
        (Limits.productIsProduct (fun n => (K n).X k))).symm
        (inferInstance : Injective (Limits.piObj (fun n => (K n).X k)))
    let φ0 : Y ⟶ P.X 0 := Limits.Fan.IsLimit.lift (hdeg 0) (fun n => pr n ≫ (I n).ι.f 0)
    have hφ0 : ∀ n, φ0 ≫ (π n).f 0 = pr n ≫ (I n).ι.f 0 := fun n =>
      Limits.Fan.IsLimit.fac (hdeg 0) _ n
    have hd : φ0 ≫ P.d 0 1 = 0 := by
      apply Limits.Fan.IsLimit.hom_ext (hdeg 1)
      intro n
      show (φ0 ≫ P.d 0 1) ≫ (π n).f 1 = 0 ≫ (π n).f 1
      rw [Limits.zero_comp, Category.assoc, ← (π n).comm 0 1, ← Category.assoc, hφ0]
      exact (Category.assoc _ _ _).trans
        ((congrArg (pr n ≫ ·) (I n).ι_f_zero_comp_complex_d).trans Limits.comp_zero)
    let ι : (CochainComplex.single₀ C).obj Y ⟶ P := (P.fromSingle₀Equiv Y).symm ⟨φ0, hd⟩
    have hι0 : ι.f 0 = φ0 := CochainComplex.fromSingle₀Equiv_symm_apply_f_zero φ0 hd
    have hιπ : ∀ n, ι ≫ π n = (CochainComplex.single₀ C).map (pr n) ≫ (I n).ι := by
      intro n
      apply HomologicalComplex.from_single_hom_ext
      rw [HomologicalComplex.comp_f, HomologicalComplex.comp_f, hι0]
      exact (hφ0 n).trans (congrArg (fun g => g ≫ (I n).ι.f 0)
        (CochainComplex.single₀_map_f_zero (pr n)).symm)
    have hIiso : ∀ n i, IsIso (HomologicalComplex.homologyMap (I n).ι i) := fun n i =>
      (quasiIsoAt_iff_isIso_homologyMap _ _).mp ((quasiIso_iff _).mp (I n).quasiIso i)
    have hHi : ∀ i, Limits.IsLimit (Limits.Fan.mk (P.homology i)
        (fun n => HomologicalComplex.homologyMap (π n) i)) := fun i =>
      hH_C (P.sc i) (fun n => (K n).sc i)
        (fun n => (HomologicalComplex.shortComplexFunctor C (ComplexShape.up ℕ) i).map (π n))
        (hdeg _) (hdeg i) (hdeg _)
    have hqi : QuasiIso ι := by
      rw [quasiIso_iff]
      intro i
      rw [quasiIsoAt_iff_isIso_homologyMap]
      rcases Nat.eq_zero_or_pos i with rfl | hi
      · let sY := HomologicalComplex.singleObjHomologySelfIso (ComplexShape.up ℕ) 0 Y
        let e : ∀ n, (K n).homology 0 ≅ B n := fun n =>
          (asIso (HomologicalComplex.homologyMap (I n).ι 0)).symm ≪≫
            HomologicalComplex.singleObjHomologySelfIso (ComplexShape.up ℕ) 0 (B n)
        have L1 : Limits.IsLimit (Limits.Fan.mk (((CochainComplex.single₀ C).obj Y).homology 0)
            (fun n => HomologicalComplex.homologyMap (ι ≫ π n) 0)) := by
          refine s4_C pr _ sY e ?_ hY
          intro n
          rw [hιπ n, HomologicalComplex.homologyMap_comp]
          simp only [e, Iso.trans_hom, Iso.symm_hom, asIso_inv, Category.assoc,
            IsIso.hom_inv_id_assoc]
          exact HomologicalComplex.singleObjHomologySelfIso_hom_naturality _ _ (pr n)
        have heq : HomologicalComplex.homologyMap ι 0 =
            (L1.conePointUniqueUpToIso (hHi 0)).hom := by
          apply Limits.Fan.IsLimit.hom_ext (hHi 0)
          intro n
          have := Limits.IsLimit.conePointUniqueUpToIso_hom_comp L1 (hHi 0) ⟨n⟩
          refine Eq.trans ?_ this.symm
          show HomologicalComplex.homologyMap ι 0 ≫ HomologicalComplex.homologyMap (π n) 0 =
            HomologicalComplex.homologyMap (ι ≫ π n) 0
          rw [HomologicalComplex.homologyMap_comp]
        rw [heq]
        infer_instance
      · have hz : Limits.IsZero (P.homology i) := by
          refine Limits.IsLimit.isZero_pt (hHi i) (Functor.isZero _ (fun j => ?_))
          haveI := hIiso j.as i
          exact Limits.IsZero.of_iso
            (HomologicalComplex.isZero_single_obj_homology _ _ _ _ (by omega))
            (asIso (HomologicalComplex.homologyMap (I j.as).ι i)).symm
        exact Limits.IsZero.isIso
          (HomologicalComplex.isZero_single_obj_homology _ _ _ _ (by omega)) hz _
    exact ⟨InjectiveResolution.mk P hinj ι hqi, π, fun n => by
      show ι.f 0 ≫ (π n).f 0 = _
      rw [hι0]; exact hφ0 n, fun k => ⟨hdeg k⟩⟩
  let I : ∀ n, InjectiveResolution (B n) := fun n => injectiveResolution (B n)
  obtain ⟨J, φ, heq, hdeg⟩ := hs5 I
  let G := R.mapHomologicalComplex (ComplexShape.up ℕ)
  let eY : (R.rightDerived q).obj Y ≅ (G.obj J.cocomplex).homology q := J.isoRightDerivedObj R q
  let e : ∀ n, (R.rightDerived q).obj (B n) ≅ (G.obj (I n).cocomplex).homology q := fun n =>
    (I n).isoRightDerivedObj R q
  have hnat : ∀ n, (R.rightDerived q).map (pr n) ≫ (e n).hom =
      eY.hom ≫ HomologicalComplex.homologyMap (G.map (φ n)) q := fun n =>
    InjectiveResolution.isoRightDerivedObj_hom_naturality (pr n) J (I n) (φ n) (heq n) R q
  have hX : ∀ k, Limits.IsLimit (Limits.Fan.mk ((G.obj J.cocomplex).X k)
      (fun n => (G.map (φ n)).f k)) := fun k =>
    Limits.isLimitFanMkObjOfIsLimit R (fun n => (I n).cocomplex.X k) (fun n => (φ n).f k)
      (hdeg k).some
  have hlimD : Limits.IsLimit (Limits.Fan.mk ((G.obj J.cocomplex).homology q)
      (fun n => HomologicalComplex.homologyMap (G.map (φ n)) q)) :=
    hH_D ((G.obj J.cocomplex).sc q) (fun n => (G.obj (I n).cocomplex).sc q)
      (fun n => (HomologicalComplex.shortComplexFunctor D (ComplexShape.up ℕ) q).map (G.map (φ n)))
      (hX _) (hX q) (hX _)
  exact ⟨s4_D _ _ eY e hnat hlimD⟩

theorem wc_proet_push_left_adjoint_free_nat {X B : Scheme.{u}} (g : X ⟶ B) :
    ∃ (L : Sheaf (Scheme.ProEt.topology B) AddCommGrpCat.{u+1} ⥤
        Sheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}) (_ : L ⊣ wcProEtPush g),
      Limits.PreservesFiniteLimits L ∧
      ∃ θ : ∀ V : B.ProEt, L.obj (wcFreeSheaf B V) ≅ wcFreeSheaf X ((wcProEtPullback g).obj V),
        ∀ {V V' : B.ProEt} (a : V ⟶ V'),
          L.map (wcFreeSheafMap B a) ≫ (θ V').hom =
            (θ V).hom ≫ wcFreeSheafMap X ((wcProEtPullback g).map a) :=
by
  haveI hcont := (wc_proet_pullback_continuous_flat g).1
  haveI hflat := (wc_proet_pullback_continuous_flat g).2
  let L := (wcProEtPullback g).sheafPullback AddCommGrpCat.{u+1}
    (Scheme.ProEt.topology B) (Scheme.ProEt.topology X)
  let adj₀ : L ⊣ (wcProEtPullback g).sheafPushforwardContinuous AddCommGrpCat.{u+1}
      (Scheme.ProEt.topology B) (Scheme.ProEt.topology X) :=
    (wcProEtPullback g).sheafAdjunctionContinuous AddCommGrpCat.{u+1}
      (Scheme.ProEt.topology B) (Scheme.ProEt.topology X)
  let ι : (wcProEtPullback g).sheafPushforwardContinuous AddCommGrpCat.{u+1}
      (Scheme.ProEt.topology B) (Scheme.ProEt.topology X) ≅ wcProEtPush g :=
    (Functor.rightUnitor _).symm ≪≫
      Functor.isoWhiskerLeft _ (sheafificationNatIso (Scheme.ProEt.topology B)
        AddCommGrpCat.{u+1}) ≪≫
      (Functor.associator _ _ _).symm ≪≫
      Functor.isoWhiskerRight ((wcProEtPullback g).sheafPushforwardContinuousCompSheafToPresheafIso
        AddCommGrpCat.{u+1} (Scheme.ProEt.topology B) (Scheme.ProEt.topology X))
        (presheafToSheaf (Scheme.ProEt.topology B) AddCommGrpCat.{u+1}) ≪≫
      Functor.associator _ _ _
  obtain ⟨θ₀, hθ₀⟩ := wc_sheafPullback_free_natIso (Scheme.ProEt.topology B)
    (Scheme.ProEt.topology X) (wcProEtPullback g) L adj₀
  exact ⟨L, adj₀.ofNatIsoRight ι,
    wc_sheafPullback_preservesFiniteLimits_of_flat (Scheme.ProEt.topology B)
      (Scheme.ProEt.topology X) (wcProEtPullback g),
    θ₀, fun a => hθ₀ a⟩

theorem wc_proet_Rq_tower_prod_transport : ∀ {X B : Scheme.{u}} (g : X ⟶ B) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (V : B.ProEt) (j : ℕ)
    (M : ℕ → Type) [∀ k, AddCommGroup (M k)] [∀ k, TopologicalSpace (M k)]
    [∀ k, IsTopologicalAddGroup (M k)]
    (θ : ∀ k, (((wcProEtPush g).rightDerived j).obj (wcContSheaf X (ZMod (ℓ ^ k)))).over V ≅
      (wcContSheaf B (M k)).over V)
    (ρ : ∀ k, M (k + 1) →+ M k) (hρ : ∀ k, Continuous (ρ k)),
    (∀ k, ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map
        (((wcProEtPush g).rightDerived j).map
          (wcContSheafMap X (wcTowerCast ℓ k) continuous_of_discreteTopology)) ≫ (θ k).hom =
      (θ (k + 1)).hom ≫ ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map
        (wcContSheafMap B (ρ k) (hρ k))) →
    ∀ (sh : ((k : ℕ) → M k) →+ ((k : ℕ) → M k)) (hsh : Continuous sh),
    (∀ x k, sh x k = x k - ρ k (x (k + 1))) →
    ∀ (hT : Continuous (wcTowerShift ℓ)),
    ∃ Ξ : (((wcProEtPush g).rightDerived j).obj (wcContSheaf X ((n : ℕ) → ZMod (ℓ ^ n)))).over V ≅
        (wcContSheaf B ((k : ℕ) → M k)).over V,
      (∀ k, Ξ.hom ≫ ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map
          (wcContSheafMap B (Pi.evalAddMonoidHom M k) (continuous_apply k)) =
        ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map
          (((wcProEtPush g).rightDerived j).map
            (wcContSheafMap X (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) k) (continuous_apply k))) ≫
          (θ k).hom) ∧
      ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map
          (((wcProEtPush g).rightDerived j).map (wcContSheafMap X (wcTowerShift ℓ) hT)) ≫ Ξ.hom =
        Ξ.hom ≫ ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map
          (wcContSheafMap B sh hsh) :=
by
  intro X B g ℓ _ V j M _ _ _ θ ρ hρ hsq sh hsh hshf hT
  classical

  have abstr : ∀ (Pt Qt : Sheaf ((Scheme.ProEt.topology B).over V) AddCommGrpCat.{u+1})
      (P Q : ℕ → Sheaf ((Scheme.ProEt.topology B).over V) AddCommGrpCat.{u+1})
      (pP : ∀ k, Pt ⟶ P k) (pQ : ∀ k, Qt ⟶ Q k),
      Limits.IsLimit (Limits.Fan.mk Pt pP) → Limits.IsLimit (Limits.Fan.mk Qt pQ) →
      ∀ (θ : ∀ k, P k ≅ Q k) (a : ∀ k, P (k + 1) ⟶ P k) (b : ∀ k, Q (k + 1) ⟶ Q k),
      (∀ k, a k ≫ (θ k).hom = (θ (k + 1)).hom ≫ b k) →
      ∀ (S : Pt ⟶ Pt) (T : Qt ⟶ Qt),
      (∀ k, S ≫ pP k = pP k - pP (k + 1) ≫ a k) →
      (∀ k, T ≫ pQ k = pQ k - pQ (k + 1) ≫ b k) →
      ∃ Ξ : Pt ≅ Qt, (∀ k, Ξ.hom ≫ pQ k = pP k ≫ (θ k).hom) ∧ S ≫ Ξ.hom = Ξ.hom ≫ T := by
    intro Pt Qt P Q pP pQ hP hQ θ a b hab S T hS hTT
    have fP : ∀ {A} (f : ∀ k, A ⟶ P k) k, hP.lift (Limits.Fan.mk A f) ≫ pP k = f k :=
      fun f k => hP.fac (Limits.Fan.mk _ f) ⟨k⟩
    have fQ : ∀ {A} (f : ∀ k, A ⟶ Q k) k, hQ.lift (Limits.Fan.mk A f) ≫ pQ k = f k :=
      fun f k => hQ.fac (Limits.Fan.mk _ f) ⟨k⟩
    have eP : ∀ {A} (x y : A ⟶ Pt), (∀ k, x ≫ pP k = y ≫ pP k) → x = y :=
      fun x y h => hP.hom_ext (fun j => h j.as)
    have eQ : ∀ {A} (x y : A ⟶ Qt), (∀ k, x ≫ pQ k = y ≫ pQ k) → x = y :=
      fun x y h => hQ.hom_ext (fun j => h j.as)
    let Ξ : Pt ≅ Qt :=
      { hom := hQ.lift (Limits.Fan.mk Pt (fun k => pP k ≫ (θ k).hom))
        inv := hP.lift (Limits.Fan.mk Qt (fun k => pQ k ≫ (θ k).inv))
        hom_inv_id := eP _ _ (fun k => by
          rw [Category.assoc, fP, ← Category.assoc, fQ, Category.assoc, Iso.hom_inv_id,
            Category.comp_id, Category.id_comp])
        inv_hom_id := eQ _ _ (fun k => by
          rw [Category.assoc, fQ, ← Category.assoc, fP, Category.assoc, Iso.inv_hom_id,
            Category.comp_id, Category.id_comp]) }
    have hΞ : ∀ k, Ξ.hom ≫ pQ k = pP k ≫ (θ k).hom := fun k => fQ _ k
    refine ⟨Ξ, hΞ, eQ _ _ (fun k => ?_)⟩
    have L : (S ≫ Ξ.hom) ≫ pQ k = pP k ≫ (θ k).hom - pP (k + 1) ≫ ((θ (k + 1)).hom ≫ b k) := by
      rw [Category.assoc, hΞ k, ← Category.assoc S (pP k) (θ k).hom, hS k, Preadditive.sub_comp,
        Category.assoc, hab k]
    have Rr : (Ξ.hom ≫ T) ≫ pQ k = pP k ≫ (θ k).hom - pP (k + 1) ≫ ((θ (k + 1)).hom ≫ b k) := by
      rw [Category.assoc, hTT k, Preadditive.comp_sub, hΞ k,
        ← Category.assoc Ξ.hom (pQ (k + 1)) (b k), hΞ (k + 1), Category.assoc]
    rw [L, Rr]

  obtain ⟨L, adj, -⟩ := wc_proet_push_left_adjoint_free_nat g
  haveI := adj.rightAdjoint_preservesLimits
  haveI : Limits.PreservesLimitsOfShape (Discrete ℕ) (wcProEtPush g) := inferInstance
  haveI : Limits.PreservesFiniteLimits (wcProEtPush g) := inferInstance
  haveI := wc_proet_products_exact X
  haveI := wc_proet_products_exact B
  haveI hOadd : ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).Additive :=
    (sheafPushforward_additive_finiteColimits ((Scheme.ProEt.topology B).over V)
      (Scheme.ProEt.topology B) (Over.forget V)).1
  haveI hRadd : ((wcProEtPush g).rightDerived j).Additive := by
    obtain ⟨Z, hZ⟩ := (Limits.HasZeroObject.zero :
      ∃ Z : Sheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}, Limits.IsZero Z)
    have hS : (ShortComplex.mk (0 : Z ⟶ Z) (𝟙 Z) (by simp)).ShortExact :=
      { exact := ShortComplex.exact_of_isZero_X₂ _ hZ
        mono_f := ⟨fun a b _ => hZ.eq_of_tgt a b⟩
        epi_g := (inferInstance : Epi (𝟙 Z)) }
    have hsub : ∀ {P Q : Sheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}} (a b : P ⟶ Q),
        ((wcProEtPush g).rightDerived j).map (a - b) =
          ((wcProEtPush g).rightDerived j).map a - ((wcProEtPush g).rightDerived j).map b :=
      fun a b => (wc_rightDerived_les_package (wcProEtPush g) _ hS).1 j a b
    have h0 : ∀ {P Q : Sheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}},
        ((wcProEtPush g).rightDerived j).map (0 : P ⟶ Q) = 0 := by
      intro P Q
      have := hsub (0 : P ⟶ Q) 0
      rw [sub_zero, sub_self] at this
      exact this
    constructor
    intro P Q a b
    have hneg : ((wcProEtPush g).rightDerived j).map (-b) =
        -((wcProEtPush g).rightDerived j).map b := by
      have := hsub (0 : P ⟶ Q) b
      rw [zero_sub, h0, zero_sub] at this
      exact this
    have := hsub a (-b)
    rw [sub_neg_eq_add, hneg, sub_neg_eq_add] at this
    exact this

  have hP := Limits.isLimitFanMkObjOfIsLimit
    ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V)
    (fun n => ((wcProEtPush g).rightDerived j).obj (wcContSheaf X (ZMod (ℓ ^ n)))) _
    (wc_rightDerived_preserves_nat_products (wcProEtPush g)
      (wcContSheaf X ((n : ℕ) → ZMod (ℓ ^ n)))
      (fun n => wcContSheaf X (ZMod (ℓ ^ n)))
      (fun n => wcContSheafMap X (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) n) (continuous_apply n))
      (wc_contSheaf_pi_isLimit X (fun n => ZMod (ℓ ^ n))).some j).some
  have hQ := Limits.isLimitFanMkObjOfIsLimit
    ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V)
    (fun k => wcContSheaf B (M k)) _ (wc_contSheaf_pi_isLimit B M).some

  have e2 : ∀ k, wcContSheafMap X (wcTowerShift ℓ) hT ≫
      wcContSheafMap X (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) k) (continuous_apply k) =
      wcContSheafMap X (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) k) (continuous_apply k) -
      wcContSheafMap X (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) (k + 1))
        (continuous_apply (k + 1)) ≫
        wcContSheafMap X (wcTowerCast ℓ k) continuous_of_discreteTopology := by
    intro k
    rw [← (wc_contSheafMap_comp_sub X (wcTowerShift ℓ) (wcTowerShift ℓ) hT hT
        (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) k) (continuous_apply k)).1,
      ← (wc_contSheafMap_comp_sub X (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) (k + 1))
        (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) (k + 1)) (continuous_apply (k + 1))
        (continuous_apply (k + 1)) (wcTowerCast ℓ k) continuous_of_discreteTopology).1,
      ← (wc_contSheafMap_comp_sub X (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) k)
        ((wcTowerCast ℓ k).comp (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) (k + 1)))
        (continuous_apply k)
        ((continuous_of_discreteTopology (f := wcTowerCast ℓ k)).comp
            (continuous_apply (k + 1)))
        (AddMonoidHom.id _) continuous_id).2]
    congr 1
    all_goals exact AddMonoidHom.ext fun x => rfl
  have e2' : ∀ k, wcContSheafMap B sh hsh ≫
      wcContSheafMap B (Pi.evalAddMonoidHom M k) (continuous_apply k) =
      wcContSheafMap B (Pi.evalAddMonoidHom M k) (continuous_apply k) -
      wcContSheafMap B (Pi.evalAddMonoidHom M (k + 1)) (continuous_apply (k + 1)) ≫
        wcContSheafMap B (ρ k) (hρ k) := by
    intro k
    rw [← (wc_contSheafMap_comp_sub B sh sh hsh hsh (Pi.evalAddMonoidHom M k)
        (continuous_apply k)).1,
      ← (wc_contSheafMap_comp_sub B (Pi.evalAddMonoidHom M (k + 1)) (Pi.evalAddMonoidHom M (k + 1))
        (continuous_apply (k + 1)) (continuous_apply (k + 1)) (ρ k) (hρ k)).1,
      ← (wc_contSheafMap_comp_sub B (Pi.evalAddMonoidHom M k)
        ((ρ k).comp (Pi.evalAddMonoidHom M (k + 1))) (continuous_apply k)
        ((hρ k).comp (continuous_apply (k + 1)))
        (AddMonoidHom.id _) continuous_id).2]
    congr 1
    all_goals exact AddMonoidHom.ext fun x => hshf x k
  obtain ⟨Ξ, h1, h2⟩ := abstr _ _ _ _ _ _ hP hQ θ
    (fun k => ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map
      (((wcProEtPush g).rightDerived j).map
        (wcContSheafMap X (wcTowerCast ℓ k) continuous_of_discreteTopology)))
    (fun k => ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map
        (wcContSheafMap B (ρ k) (hρ k))) hsq
    (((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map
      (((wcProEtPush g).rightDerived j).map (wcContSheafMap X (wcTowerShift ℓ) hT)))
    (((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map (wcContSheafMap B sh hsh))
    (fun k => by
      have h := congrArg (fun f => ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map
        (((wcProEtPush g).rightDerived j).map f)) (e2 k)
      simp only [Functor.map_comp, Functor.map_sub] at h
      exact h)
    (fun k => by
      have h := congrArg (fun f => ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map
        f) (e2' k)
      simp only [Functor.map_comp, Functor.map_sub] at h
      exact h)
  exact ⟨Ξ, h1, h2⟩

theorem wc_finite_tower_shift_section : ∀ (M : ℕ → Type) [∀ k, AddCommGroup (M k)] [∀ k, TopologicalSpace (M k)]
    [∀ k, DiscreteTopology (M k)] [∀ k, Finite (M k)] (ρ : ∀ k, M (k + 1) →+ M k)
    (sh : ((k : ℕ) → M k) →+ ((k : ℕ) → M k)),
    (∀ x k, sh x k = x k - ρ k (x (k + 1))) →
    ∃ σ : ((k : ℕ) → M k) → ((k : ℕ) → M k), Continuous σ ∧ ∀ y, sh (σ y) = y :=
by
  intro M _ _ _ _ ρ sh hsh
  classical

  have hadd : ∀ (k : ℕ) (f g : ((j : ℕ) → M j) → M k), Continuous f → Continuous g →
      Continuous (fun y => f y + g y) := by
    intro k f g hf hg
    have h : Continuous (fun p : M k × M k => p.1 + p.2) := continuous_of_discreteTopology
    exact h.comp (hf.prodMk hg)
  have hsub : ∀ (k : ℕ) (f g : ((j : ℕ) → M j) → M k), Continuous f → Continuous g →
      Continuous (fun y => f y - g y) := by
    intro k f g hf hg
    have h : Continuous (fun p : M k × M k => p.1 - p.2) := continuous_of_discreteTopology
    exact h.comp (hf.prodMk hg)

  let I : ℕ → (k : ℕ) → AddSubgroup (M k) := fun n =>
    Nat.rec (motive := fun _ => (k : ℕ) → AddSubgroup (M k)) (fun _ => ⊤)
      (fun _ In k => (In (k + 1)).map (ρ k)) n
  have hI0 : ∀ k, I 0 k = ⊤ := fun _ => rfl
  have hIs : ∀ n k, I (n + 1) k = (I n (k + 1)).map (ρ k) := fun _ _ => rfl
  clear_value I
  have hanti1 : ∀ n k, I (n + 1) k ≤ I n k := by
    intro n
    induction n with
    | zero => intro k; rw [hI0]; exact le_top
    | succ n ih => intro k; rw [hIs (n + 1) k, hIs n k]; exact AddSubgroup.map_mono (ih (k + 1))
  have hanti : ∀ k m n, m ≤ n → I n k ≤ I m k := by
    intro k m n hmn
    induction hmn with
    | refl => exact le_rfl
    | step _ ih => exact (hanti1 _ k).trans ih
  have hN0 : ∀ k, ∃ n0, ∀ n, n0 ≤ n → I n k = I n0 k := by
    intro k
    obtain ⟨n0, -, hmin⟩ := (InvImage.wf (fun n => Nat.card (I n k)) wellFounded_lt).has_min
      Set.univ ⟨0, Set.mem_univ _⟩
    refine ⟨n0, fun n hn => ?_⟩
    have hle := hanti k n0 n hn
    have hc : Nat.card (I n0 k) ≤ Nat.card (I n k) := by
      have h : ¬ Nat.card (I n k) < Nat.card (I n0 k) := hmin n (Set.mem_univ _)
      omega
    exact AddSubgroup.eq_of_le_of_card_ge hle hc
  choose N0 hN0 using hN0
  let N : ℕ → ℕ := fun k => ∑ j ∈ Finset.range (k + 1), N0 j
  have hNmono : Monotone N := by
    apply monotone_nat_of_le_succ
    intro k
    show ∑ j ∈ Finset.range (k + 1), N0 j ≤ ∑ j ∈ Finset.range (k + 1 + 1), N0 j
    rw [Finset.sum_range_succ _ (k + 1)]
    omega
  have hN0N : ∀ k, N0 k ≤ N k := fun k =>
    Finset.single_le_sum (f := N0) (fun j _ => Nat.zero_le _) (Finset.self_mem_range_succ k)
  have hstab : ∀ k n, N k ≤ n → I n k = I (N k) k := by
    intro k n hn
    rw [hN0 k n ((hN0N k).trans hn), hN0 k (N k) (hN0N k)]
  clear_value N
  have hNle : ∀ k, N k ≤ N (k + 1) + 1 := fun k => (hNmono (Nat.le_succ k)).trans (Nat.le_succ _)

  let J : (k : ℕ) → AddSubgroup (M k) := fun k => I (N k) k
  have hJsurj : ∀ k, ∀ a ∈ J k, ∃ b ∈ J (k + 1), ρ k b = a := by
    intro k a ha
    have h1 : J k = (J (k + 1)).map (ρ k) := by
      show I (N k) k = (I (N (k + 1)) (k + 1)).map (ρ k)
      rw [← hIs]
      exact (hstab k _ (hNle k)).symm
    rw [h1] at ha
    exact AddSubgroup.mem_map.mp ha

  let S : ((j : ℕ) → M j) → ℕ → (k : ℕ) → M k := fun y n =>
    Nat.rec (motive := fun _ => (k : ℕ) → M k) (fun _ => 0)
      (fun _ Sn k => y k + ρ k (Sn (k + 1))) n
  have hS0 : ∀ y k, S y 0 k = 0 := fun _ _ => rfl
  have hSs : ∀ y n k, S y (n + 1) k = y k + ρ k (S y n (k + 1)) := fun _ _ _ => rfl
  clear_value S
  have hScont : ∀ n k, Continuous (fun y => S y n k) := by
    intro n
    induction n with
    | zero => intro k; simp only [hS0]; exact continuous_const
    | succ n ih =>
      intro k
      simp only [hSs]
      exact hadd k _ _ (continuous_apply k)
        ((continuous_of_discreteTopology (f := ⇑(ρ k))).comp (ih (k + 1)))
  have htele : ∀ y m n k, m ≤ n → S y n k - S y m k ∈ I m k := by
    intro y m
    induction m with
    | zero => intro n k _; rw [hI0]; exact AddSubgroup.mem_top _
    | succ m ih =>
      intro n k hmn
      obtain ⟨n', rfl⟩ : ∃ n', n = n' + 1 := ⟨n - 1, by omega⟩
      rw [hSs, hSs, hIs]
      have h : y k + ρ k (S y n' (k + 1)) - (y k + ρ k (S y m (k + 1))) =
          ρ k (S y n' (k + 1) - S y m (k + 1)) := by
        rw [map_sub]; abel
      rw [h]
      exact AddSubgroup.mem_map_of_mem _ (ih n' (k + 1) (by omega))

  let P : ((j : ℕ) → M j) → (k : ℕ) → M k := fun y k => S y (N k + 1) k
  have hPc : ∀ k, Continuous (fun y => P y k) := fun k => hScont (N k + 1) k
  let e : ((j : ℕ) → M j) → (k : ℕ) → M k := fun y k => P y k - ρ k (P y (k + 1)) - y k
  have hec : Continuous e := by
    refine continuous_pi fun k => ?_
    show Continuous fun y => P y k - ρ k (P y (k + 1)) - y k
    exact hsub k _ _ (hsub k _ _ (hPc k)
      ((continuous_of_discreteTopology (f := ⇑(ρ k))).comp (hPc (k + 1)))) (continuous_apply k)
  have heJ : ∀ y k, e y k ∈ J k := by
    intro y k
    have h1 : e y k = -(ρ k (S y (N (k + 1) + 1) (k + 1) - S y (N k) (k + 1))) := by
      show S y (N k + 1) k - ρ k (S y (N (k + 1) + 1) (k + 1)) - y k = _
      rw [hSs y (N k) k, map_sub]; abel
    rw [h1]
    refine neg_mem ?_
    have h2 := htele y (N k) (N (k + 1) + 1) (k + 1) (hNle k)
    have h3 : ρ k (S y (N (k + 1) + 1) (k + 1) - S y (N k) (k + 1)) ∈ I (N k + 1) k := by
      rw [hIs]; exact AddSubgroup.mem_map_of_mem _ h2
    show _ ∈ I (N k) k
    rwa [hstab k (N k + 1) (Nat.le_succ _)] at h3

  let t : (k : ℕ) → M k → M (k + 1) := fun k a =>
    if h : a ∈ J k then Classical.choose (hJsurj k a h) else 0
  have ht : ∀ k a, a ∈ J k → t k a ∈ J (k + 1) ∧ ρ k (t k a) = a := by
    intro k a ha
    have htdef : t k a = Classical.choose (hJsurj k a ha) := dif_pos ha
    rw [htdef]
    exact Classical.choose_spec (hJsurj k a ha)
  let z : ((j : ℕ) → M j) → (k : ℕ) → M k := fun y k =>
    Nat.rec (motive := fun k => M k) 0 (fun k zk => t k (zk + e y k)) k
  have hz0 : ∀ y, z y 0 = 0 := fun _ => rfl
  have hzs : ∀ y k, z y (k + 1) = t k (z y k + e y k) := fun _ _ => rfl
  clear_value z
  have hzJ : ∀ y k, z y k ∈ J k := by
    intro y k
    induction k with
    | zero => rw [hz0]; exact zero_mem _
    | succ k ih => rw [hzs]; exact (ht k _ (add_mem ih (heJ y k))).1
  have hzeq : ∀ y k, ρ k (z y (k + 1)) = z y k + e y k := by
    intro y k; rw [hzs]; exact (ht k _ (add_mem (hzJ y k) (heJ y k))).2
  have hzc : ∀ k, Continuous (fun y => z y k) := by
    intro k
    induction k with
    | zero => simp only [hz0]; exact continuous_const
    | succ k ih =>
      simp only [hzs]
      exact (continuous_of_discreteTopology (f := t k)).comp
        (hadd k _ _ ih ((continuous_apply k).comp hec))

  refine ⟨fun y k => P y k + z y k, ?_, ?_⟩
  · exact continuous_pi fun k => hadd k _ _ (hPc k) (hzc k)
  · intro y
    funext k
    rw [hsh]
    show P y k + z y k - ρ k (P y (k + 1) + z y (k + 1)) = y k
    rw [map_add, hzeq]
    show P y k + z y k - (ρ k (P y (k + 1)) + (z y k + (P y k - ρ k (P y (k + 1)) - y k))) = y k
    abel

theorem wc_proet_Rq_int_over_kernel : ∀ {X B : Scheme.{u}} (g : X ⟶ B) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (V : B.ProEt)
    (hI : Continuous (wcTowerIncl ℓ)) (hT : Continuous (wcTowerShift ℓ))
    (P : ℕ → Type) [∀ j, AddCommGroup (P j)] [∀ j, TopologicalSpace (P j)]
    [∀ j, IsTopologicalAddGroup (P j)] (sh : ∀ j, P j →+ P j) (hsh : ∀ j, Continuous (sh j)),
    (∀ j, ∃ σ : P j → P j, Continuous σ ∧ ∀ y, sh j (σ y) = y) →
    ∀ (Ξ : ∀ j, (((wcProEtPush g).rightDerived j).obj (wcContSheaf X ((n : ℕ) → ZMod (ℓ ^ n)))).over V ≅
        (wcContSheaf B (P j)).over V),
    (∀ j, ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map
          (((wcProEtPush g).rightDerived j).map (wcContSheafMap X (wcTowerShift ℓ) hT)) ≫ (Ξ j).hom =
        (Ξ j).hom ≫ ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map
          (wcContSheafMap B (sh j) (hsh j))) →
    ∀ q : ℕ, ∃ ψ : (((wcProEtPush g).rightDerived q).obj (wcContSheaf X ℤ_[ℓ])).over V ≅
        (wcContSheaf B ↥(sh q).ker).over V,
      ψ.hom ≫ ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map
          (wcContSheafMap B (sh q).ker.subtype continuous_subtype_val) =
        ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map
          (((wcProEtPush g).rightDerived q).map (wcContSheafMap X (wcTowerIncl ℓ) hI)) ≫ (Ξ q).hom :=
by
  intro X B g ℓ _ V hI hT P _ _ _ sh hsh hsec Ξ hΞ q

  have hO := sheafPushforward_additive_finiteColimits ((Scheme.ProEt.topology B).over V)
    (Scheme.ProEt.topology B) (Over.forget V)
  haveI : ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).Additive := hO.1
  haveI : Limits.PreservesFiniteColimits
      ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V) := hO.2
  haveI : ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).PreservesHomology :=
    Functor.preservesHomologyOfExact _
  have hexO : ∀ {A₁ A₂ A₃ : Sheaf (Scheme.ProEt.topology B) AddCommGrpCat.{u+1}}
      (f : A₁ ⟶ A₂) (f' : A₂ ⟶ A₃) (h : f ≫ f' = 0), (ShortComplex.mk f f' h).Exact →
      ∃ h' : ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map f ≫
          ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map f' = 0,
        (ShortComplex.mk _ _ h').Exact := by
    intro A₁ A₂ A₃ f f' h hE
    exact ⟨by rw [← Functor.map_comp, h, Functor.map_zero],
      hE.map ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V)⟩

  obtain ⟨-, hemb, -, hker, hsecT⟩ := wc_padic_tower_facts ℓ
  obtain ⟨hz, hSE⟩ := wc_contSheaf_shortExact X (wcTowerIncl ℓ) hI (wcTowerShift ℓ) hT hemb hker hsecT
  obtain ⟨-, hmono0, hles⟩ := wc_rightDerived_les_package (wcProEtPush g) _ hSE

  have hsecSE : ∀ j, ∃ hz : ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map
          (wcContSheafMap B (sh j).ker.subtype continuous_subtype_val) ≫
        ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map
          (wcContSheafMap B (sh j) (hsh j)) = 0,
      (ShortComplex.mk _ _ hz).ShortExact := by
    intro j
    have hembj : Topology.IsEmbedding ⇑(sh j).ker.subtype := by
      first
        | exact Topology.IsEmbedding.subtypeVal
        | (rw [AddSubgroup.coe_subtype]; exact Topology.IsEmbedding.subtypeVal)
    have hkerj : ∀ b : P j, sh j b = 0 ↔ ∃ a : ↥(sh j).ker, (sh j).ker.subtype a = b := by
      intro b
      constructor
      · intro h
        exact ⟨⟨b, (AddMonoidHom.mem_ker).2 h⟩, rfl⟩
      · rintro ⟨a, rfl⟩
        exact (AddMonoidHom.mem_ker).1 a.2
    obtain ⟨hz, hSE⟩ := wc_contSheaf_shortExact B (sh j).ker.subtype continuous_subtype_val
      (sh j) (hsh j) hembj hkerj (hsec j)
    exact ⟨by rw [← Functor.map_comp, hz, Functor.map_zero],
      hSE.map_of_exact ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V)⟩

  have hepi : ∀ j, Epi (((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map
      (((wcProEtPush g).rightDerived j).map (wcContSheafMap X (wcTowerShift ℓ) hT))) := by
    intro j
    obtain ⟨_, hSEj⟩ := hsecSE j
    have e : ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map
        (((wcProEtPush g).rightDerived j).map (wcContSheafMap X (wcTowerShift ℓ) hT)) =
        (Ξ j).hom ≫ ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map
          (wcContSheafMap B (sh j) (hsh j)) ≫ (Ξ j).inv := by
      rw [← Category.assoc, ← hΞ j, Category.assoc, Iso.hom_inv_id, Category.comp_id]
    rw [e]
    haveI : Epi (((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map
        (wcContSheafMap B (sh j) (hsh j))) := hSEj.epi_g
    infer_instance

  have hmono : ∀ p, Mono (((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map
      (((wcProEtPush g).rightDerived p).map (wcContSheafMap X (wcTowerIncl ℓ) hI))) := by
    intro p
    cases p with
    | zero =>
      haveI : Mono (((wcProEtPush g).rightDerived 0).map (wcContSheafMap X (wcTowerIncl ℓ) hI)) :=
        hmono0
      exact Functor.map_mono _ _
    | succ p =>
      obtain ⟨-, δ, h1, h2, hex1, hex2⟩ := hles p
      obtain ⟨_, hex1'⟩ := hexO _ _ h1 hex1
      obtain ⟨_, hex2'⟩ := hexO _ _ h2 hex2
      have hδ : ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map δ = 0 :=
        hex1'.epi_f_iff.1 (hepi p)
      exact hex2'.mono_g hδ

  obtain ⟨h0, hex0⟩ := (hles q).1
  obtain ⟨h0', hex0'⟩ := hexO _ _ h0 hex0
  obtain ⟨hzq, hSEq⟩ := hsecSE q
  have hF := @ShortComplex.Exact.fIsKernel _ _ _ _ _ hex0' (hmono q)
  have hK := hSEq.fIsKernel
  have e1 : (((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map
        (((wcProEtPush g).rightDerived q).map (wcContSheafMap X (wcTowerIncl ℓ) hI)) ≫ (Ξ q).hom) ≫
      ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map
        (wcContSheafMap B (sh q) (hsh q)) = 0 := by
    rw [Category.assoc, ← hΞ q, ← Category.assoc, h0', Limits.zero_comp]
  have e2' : (Ξ q).inv ≫ ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map
        (((wcProEtPush g).rightDerived q).map (wcContSheafMap X (wcTowerShift ℓ) hT)) =
      ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map
        (wcContSheafMap B (sh q) (hsh q)) ≫ (Ξ q).inv := by
    rw [Iso.inv_comp_eq, ← Category.assoc, ← hΞ q, Category.assoc, Iso.hom_inv_id,
      Category.comp_id]
  have e2 : (((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map
        (wcContSheafMap B (sh q).ker.subtype continuous_subtype_val) ≫ (Ξ q).inv) ≫
      ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map
        (((wcProEtPush g).rightDerived q).map (wcContSheafMap X (wcTowerShift ℓ) hT)) = 0 := by
    rw [Category.assoc, e2', ← Category.assoc, hzq, Limits.zero_comp]
  obtain ⟨a, ha⟩ := Limits.KernelFork.IsLimit.lift' hK _ e1
  obtain ⟨b, hb⟩ := Limits.KernelFork.IsLimit.lift' hF _ e2
  have ha' : a ≫ ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map
        (wcContSheafMap B (sh q).ker.subtype continuous_subtype_val) =
      ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map
        (((wcProEtPush g).rightDerived q).map (wcContSheafMap X (wcTowerIncl ℓ) hI)) ≫ (Ξ q).hom :=
    ha
  have hb' : b ≫ ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map
        (((wcProEtPush g).rightDerived q).map (wcContSheafMap X (wcTowerIncl ℓ) hI)) =
      ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map
        (wcContSheafMap B (sh q).ker.subtype continuous_subtype_val) ≫ (Ξ q).inv :=
    hb
  haveI := hmono q
  refine ⟨{ hom := a, inv := b, hom_inv_id := ?_, inv_hom_id := ?_ }, ha'⟩
  · apply (cancel_mono (((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map
      (((wcProEtPush g).rightDerived q).map (wcContSheafMap X (wcTowerIncl ℓ) hI)))).1
    simp only [Category.assoc, hb', reassoc_of% ha', Iso.hom_inv_id, Category.comp_id,
      Category.id_comp]
  · apply Limits.Fork.IsLimit.hom_ext hK
    show (b ≫ a) ≫ ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map
        (wcContSheafMap B (sh q).ker.subtype continuous_subtype_val) =
      𝟙 _ ≫ ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map
        (wcContSheafMap B (sh q).ker.subtype continuous_subtype_val)
    simp only [Category.assoc, ha', reassoc_of% hb', Iso.inv_hom_id, Category.comp_id,
      Category.id_comp]

theorem wc_proet_Rq_int_lim_ell_div : ∀ {X B : Scheme.{u}} (g : X ⟶ B) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (V : B.ProEt),
    ConnectedSpace V.left → ∀ (q : ℕ) (hI : Continuous (wcTowerIncl ℓ))
    (P : Type) [AddCommGroup P] [TopologicalSpace P] [IsTopologicalAddGroup P] (sh : P →+ P)
    (Ξ : (((wcProEtPush g).rightDerived q).obj (wcContSheaf X ((n : ℕ) → ZMod (ℓ ^ n)))).over V ≅
      (wcContSheaf B P).over V)
    (ψ : (((wcProEtPush g).rightDerived q).obj (wcContSheaf X ℤ_[ℓ])).over V ≅
      (wcContSheaf B ↥sh.ker).over V)
    (M : Type) [AddCommGroup M] [TopologicalSpace M] [IsTopologicalAddGroup M]
    (θ : (((wcProEtPush g).rightDerived q).obj (wcContSheaf X (ZMod (ℓ ^ 1)))).over V ≅
      (wcContSheaf B M).over V)
    (π : P →+ M) (hπ : Continuous π),
    ψ.hom ≫ ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map
        (wcContSheafMap B sh.ker.subtype continuous_subtype_val) =
      ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map
        (((wcProEtPush g).rightDerived q).map (wcContSheafMap X (wcTowerIncl ℓ) hI)) ≫ Ξ.hom →
    Ξ.hom ≫ ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map (wcContSheafMap B π hπ) =
      ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map
        (((wcProEtPush g).rightDerived q).map
          (wcContSheafMap X (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) 1) (continuous_apply 1))) ≫
        θ.hom →
    ∀ x : P, sh x = 0 → π x = 0 → ∃ y : P, sh y = 0 ∧ x = ℓ • y :=
by
  intro X B g ℓ _ V hconn q hI P _ _ _ sh Ξ ψ M _ _ _ θ π hπ H1 H2 x hx hπx

  let red : ℤ_[ℓ] →+ ZMod (ℓ ^ 1) :=
    (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) 1).comp (wcTowerIncl ℓ)
  have hred : Continuous red := (continuous_apply 1).comp hI
  have hredf : ∀ b, red b = PadicInt.toZModPow 1 b := fun b => rfl
  let mℓ : ℤ_[ℓ] →+ ℤ_[ℓ] := ℓ • AddMonoidHom.id ℤ_[ℓ]
  have hmℓf : ∀ a, mℓ a = (ℓ : ℤ_[ℓ]) * a := fun a => by
    show (ℓ • AddMonoidHom.id ℤ_[ℓ]) a = _
    rw [AddMonoidHom.nsmul_apply, AddMonoidHom.id_apply, nsmul_eq_mul]
  have hm : Continuous mℓ := (continuous_id.nsmul ℓ).congr fun a =>
    (AddMonoidHom.nsmul_apply (AddMonoidHom.id ℤ_[ℓ]) ℓ a).symm
  have hinj : Function.Injective mℓ := by
    intro a b hab
    rw [hmℓf, hmℓf] at hab
    have hne : (ℓ : ℤ_[ℓ]) ≠ 0 := Nat.cast_ne_zero.mpr (Fact.out : Nat.Prime ℓ).ne_zero
    exact mul_left_cancel₀ hne hab
  have hemb : Topology.IsEmbedding mℓ := (hm.isClosedEmbedding hinj).isEmbedding
  have hker : ∀ b : ℤ_[ℓ], red b = 0 ↔ ∃ a : ℤ_[ℓ], mℓ a = b := by
    intro b
    rw [hredf, ← RingHom.mem_ker, PadicInt.ker_toZModPow, pow_one, Ideal.mem_span_singleton']
    constructor
    · rintro ⟨a, ha⟩
      exact ⟨a, by rw [hmℓf, mul_comm]; exact ha⟩
    · rintro ⟨a, ha⟩
      exact ⟨a, by rw [mul_comm, ← hmℓf]; exact ha⟩
  have hsec : ∃ σ : ZMod (ℓ ^ 1) → ℤ_[ℓ], Continuous σ ∧ ∀ c, red (σ c) = c := by
    haveI : NeZero (ℓ ^ 1) := ⟨pow_ne_zero 1 (Fact.out : Nat.Prime ℓ).ne_zero⟩
    refine ⟨fun c => ((c.val : ℕ) : ℤ_[ℓ]), continuous_of_discreteTopology, fun c => ?_⟩
    show PadicInt.toZModPow 1 ((c.val : ℕ) : ℤ_[ℓ]) = c
    rw [map_natCast, ZMod.natCast_zmod_val]

  obtain ⟨hz₁, hSE⟩ := wc_contSheaf_shortExact X mℓ hm red hred hemb hker hsec
  obtain ⟨hsub, -, hles⟩ := wc_rightDerived_les_package (wcProEtPush g) _ hSE
  obtain ⟨⟨h0, hex0⟩, -⟩ := hles q
  have h0' : ((wcProEtPush g).rightDerived q).map (wcContSheafMap X mℓ hm) ≫
      ((wcProEtPush g).rightDerived q).map (wcContSheafMap X red hred) = 0 := h0
  haveI hOadd : ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).Additive :=
    (sheafPushforward_additive_finiteColimits ((Scheme.ProEt.topology B).over V)
      (Scheme.ProEt.topology B) (Over.forget V)).1
  haveI hOcol : Limits.PreservesFiniteColimits
      ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V) :=
    (sheafPushforward_additive_finiteColimits ((Scheme.ProEt.topology B).over V)
      (Scheme.ProEt.topology B) (Over.forget V)).2
  haveI := Functor.preservesHomologyOfExact
    ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V)
  have w₁ : ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map
        (((wcProEtPush g).rightDerived q).map (wcContSheafMap X mℓ hm)) ≫
      ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map
        (((wcProEtPush g).rightDerived q).map (wcContSheafMap X red hred)) = 0 := by
    rw [← Functor.map_comp, h0', Functor.map_zero]
  have hex₁ : (ShortComplex.mk _ _ w₁).Exact :=
    hex0.map ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V)

  have hR0 : ∀ {Y Z : Sheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}},
      ((wcProEtPush g).rightDerived q).map (0 : Y ⟶ Z) = 0 := by
    intro Y Z
    have h := hsub q (0 : Y ⟶ Z) 0
    rw [sub_zero, sub_self] at h
    exact h
  haveI hRadd : ((wcProEtPush g).rightDerived q).Additive :=
    ⟨fun {Y Z f f'} => by
      have h1 := hsub q f (-f')
      have h2 := hsub q 0 f'
      rw [zero_sub, hR0, zero_sub] at h2
      rw [sub_neg_eq_add, h2, sub_neg_eq_add] at h1
      exact h1⟩

  let mL : sh.ker →+ sh.ker := ℓ • AddMonoidHom.id sh.ker
  have hmL : Continuous mL := (continuous_id.nsmul ℓ).congr fun a =>
    (AddMonoidHom.nsmul_apply (AddMonoidHom.id sh.ker) ℓ a).symm
  let gL : sh.ker →+ M := π.comp sh.ker.subtype
  have hgL : Continuous gL := hπ.comp continuous_subtype_val

  have hCmL : wcContSheafMap B mL hmL = ℓ • 𝟙 (wcContSheaf B sh.ker) :=
    Sheaf.hom_ext (NatTrans.ext (funext fun T => AddCommGrpCat.ext fun t => rfl))
  have hCmℓ : wcContSheafMap X mℓ hm = ℓ • 𝟙 (wcContSheaf X ℤ_[ℓ]) :=
    Sheaf.hom_ext (NatTrans.ext (funext fun T => AddCommGrpCat.ext fun t => rfl))
  have Q1 : ψ.hom ≫ ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map
        (wcContSheafMap B mL hmL) =
      ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map
        (((wcProEtPush g).rightDerived q).map (wcContSheafMap X mℓ hm)) ≫ ψ.hom := by
    have eO : ∀ (H : Sheaf (Scheme.ProEt.topology B) AddCommGrpCat.{u+1}) (n : ℕ),
        ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map (n • 𝟙 H) =
          n • 𝟙 _ := fun H n => by
      rw [CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id]
    have eR : ∀ (G : Sheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}) (n : ℕ),
        ((wcProEtPush g).rightDerived q).map (n • 𝟙 G) = n • 𝟙 _ := fun G n => by
      rw [CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id]
    rw [hCmL, hCmℓ, eO, eR, eO, Preadditive.comp_nsmul, Preadditive.nsmul_comp,
      Category.comp_id, Category.id_comp]
  have hgLc : wcContSheafMap B gL hgL =
      wcContSheafMap B sh.ker.subtype continuous_subtype_val ≫ wcContSheafMap B π hπ :=
    (wc_contSheafMap_comp_sub B sh.ker.subtype sh.ker.subtype continuous_subtype_val
      continuous_subtype_val π hπ).1
  have hredc : wcContSheafMap X red hred = wcContSheafMap X (wcTowerIncl ℓ) hI ≫
      wcContSheafMap X (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) 1) (continuous_apply 1) :=
    (wc_contSheafMap_comp_sub X (wcTowerIncl ℓ) (wcTowerIncl ℓ) hI hI
      (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) 1) (continuous_apply 1)).1
  have H1' := eq_whisker H1
    (((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map (wcContSheafMap B π hπ))
  have Q2 : ψ.hom ≫ ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map
        (wcContSheafMap B gL hgL) =
      ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map
        (((wcProEtPush g).rightDerived q).map (wcContSheafMap X red hred)) ≫ θ.hom := by
    rw [hgLc, hredc]
    simp only [Functor.map_comp, Category.assoc] at H1' ⊢
    rw [H1', H2]
  have w₂ : ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map
        (wcContSheafMap B mL hmL) ≫
      ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map
        (wcContSheafMap B gL hgL) = 0 := by
    rw [← cancel_epi ψ.hom, ← Category.assoc, Q1, Category.assoc, Q2, ← Category.assoc, w₁,
      Limits.zero_comp, Limits.comp_zero]
  have hex₂ : (ShortComplex.mk _ _ w₂).Exact :=
    (ShortComplex.exact_iff_of_iso (ShortComplex.isoMk (S₁ := ShortComplex.mk _ _ w₁)
      (S₂ := ShortComplex.mk _ _ w₂) ψ ψ θ Q1 Q2)).mp hex₁

  have hloc : ∀ (U : Over V)
      (b : (((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).obj
        (wcContSheaf B sh.ker)).obj.obj (Opposite.op U)),
      ((((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map
        (wcContSheafMap B gL hgL)).hom.app (Opposite.op U)).hom b = 0 →
      Presheaf.imageSieve (((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map
        (wcContSheafMap B mL hmL)).hom b ∈ ((Scheme.ProEt.topology B).over V) U := by
    intro U b hb
    obtain ⟨κ, hκι, hκ⟩ : ∃ κ : ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).obj
          (wcContSheaf B sh.ker) ⟶ Limits.kernel
            (((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map
              (wcContSheafMap B gL hgL)),
        κ ≫ Limits.kernel.ι _ = ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map
          (wcContSheafMap B mL hmL) ∧ Epi κ :=
      ⟨_, Limits.kernel.lift_ι _ _ w₂, (ShortComplex.mk _ _ w₂).exact_iff_epi_kernel_lift.mp hex₂⟩
    have hl : Presheaf.IsLocallySurjective ((Scheme.ProEt.topology B).over V) κ.hom :=
      (Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u+1} κ).mpr hκ
    let E := sheafToPresheaf ((Scheme.ProEt.topology B).over V) AddCommGrpCat.{u+1} ⋙
      (evaluation _ _).obj (Opposite.op U)
    let y := (AddCommGrpCat.kernelIsoKer ((((Scheme.ProEt.topology B).overPullback
      AddCommGrpCat.{u+1} V).map (wcContSheafMap B gL hgL)).hom.app (Opposite.op U))).inv.hom ⟨b, hb⟩
    let s : (Limits.kernel (((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map
        (wcContSheafMap B gL hgL))).obj.obj (Opposite.op U) :=
      (Limits.PreservesKernel.iso E (((Scheme.ProEt.topology B).overPullback
        AddCommGrpCat.{u+1} V).map (wcContSheafMap B gL hgL))).inv.hom y
    have hs : ((Limits.kernel.ι (((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map
        (wcContSheafMap B gL hgL))).hom.app (Opposite.op U)).hom s = b := by
      have e1 := ConcreteCategory.congr_hom
        (Limits.PreservesKernel.iso_inv_ι E (((Scheme.ProEt.topology B).overPullback
          AddCommGrpCat.{u+1} V).map (wcContSheafMap B gL hgL))) y
      have e2 := ConcreteCategory.congr_hom
        (AddCommGrpCat.kernelIsoKer_inv_comp_ι ((((Scheme.ProEt.topology B).overPullback
          AddCommGrpCat.{u+1} V).map (wcContSheafMap B gL hgL)).hom.app (Opposite.op U)))
        (⟨b, hb⟩ : ((((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map
          (wcContSheafMap B gL hgL)).hom.app (Opposite.op U)).hom.ker)
      exact e1.trans e2
    refine ((Scheme.ProEt.topology B).over V).superset_covering ?_ (hl.imageSieve_mem s)
    intro W i hi
    rw [Presheaf.imageSieve_apply] at hi ⊢
    obtain ⟨t, ht⟩ := hi
    refine ⟨t, ?_⟩
    rw [← hκι, ObjectProperty.FullSubcategory.comp_hom, NatTrans.comp_app,
      ConcreteCategory.comp_apply, ht, NatTrans.naturality_apply, hs]

  have hxk : x ∈ sh.ker := (AddMonoidHom.mem_ker).mpr hx
  let U₀ : Over V := Over.mk (𝟙 V)
  let b : (((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).obj
      (wcContSheaf B sh.ker)).obj.obj (Opposite.op U₀) :=
    (ULift.up (ContinuousMap.const (↥V.left) (⟨x, hxk⟩ : sh.ker)) :
      ULift.{u+1} C(↥V.left, sh.ker))
  have hb : ((((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map
      (wcContSheafMap B gL hgL)).hom.app (Opposite.op U₀)).hom b = 0 := by
    apply ULift.ext
    apply ContinuousMap.ext
    intro p
    exact hπx
  have hcov := hloc U₀ b hb
  have hcov' := (GrothendieckTopology.mem_over_iff (Scheme.ProEt.topology B) _).mp hcov
  obtain ⟨τ⟩ := @ConnectedSpace.toNonempty _ _ hconn
  obtain ⟨W, φ, hφR, w, hw⟩ := (wc_proet_cover_surj_quotient B V _ hcov').1 τ
  have hφ' := (Sieve.overEquiv_iff (Y := U₀) (Presheaf.imageSieve
    (((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map
      (wcContSheafMap B mL hmL)).hom b) φ).mp hφR
  rw [Presheaf.imageSieve_apply] at hφ'
  obtain ⟨t, ht⟩ := hφ'
  let a : sh.ker := (show ULift.{u+1} C(↥W.left, sh.ker) from t).down w
  have e' : mL a = ⟨x, hxk⟩ := by
    have := congrArg (fun z : ULift.{u+1} C(↥W.left, sh.ker) => z.down w) ht
    exact this
  have e2 : ((mL a : sh.ker) : P) = x := congrArg Subtype.val e'
  have e3 : ((mL a : sh.ker) : P) = ℓ • (a : P) := by
    show ((ℓ • AddMonoidHom.id sh.ker) a : P) = ℓ • (a : P)
    rw [AddMonoidHom.nsmul_apply, AddMonoidHom.id_apply, AddSubgroup.coe_nsmul]
  exact ⟨(a : P), (AddMonoidHom.mem_ker).mp a.2, e2.symm.trans e3⟩

theorem wc_padic_tower_lim_fg : ∀ (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (b : ℕ → ℕ) (e : ∀ k, Fin (b k) → ℕ)
    (ρ : ∀ k, ((i : Fin (b (k + 1))) → ZMod (ℓ ^ e (k + 1) i)) →+ ((i : Fin (b k)) → ZMod (ℓ ^ e k i)))
    (sh : ((k : ℕ) → (i : Fin (b k)) → ZMod (ℓ ^ e k i)) →+
      ((k : ℕ) → (i : Fin (b k)) → ZMod (ℓ ^ e k i))),
    (∀ x k, sh x k = x k - ρ k (x (k + 1))) →
    (∀ x, sh x = 0 → x 1 = 0 → ∃ y, sh y = 0 ∧ x = ℓ • y) →
    ∃ _ : Module ℤ_[ℓ] ↥sh.ker, Module.Finite ℤ_[ℓ] ↥sh.ker :=
by
  classical
  intro ℓ _ b e ρ sh hshf hdiv

  have crit : ∀ (M : Type) [AddCommGroup M] [Module ℤ_[ℓ] M],
      (∃ T : Finset M, ∀ m : M, ∃ t ∈ T, ∃ m' : M, m = t + (ℓ : ℤ_[ℓ]) • m') →
      (∀ w : ℕ → M, (∀ n, w n = (ℓ : ℤ_[ℓ]) • w (n + 1)) → w 0 = 0) →
      Module.Finite ℤ_[ℓ] M := by
    intro M _ _ hT hD
    obtain ⟨T, hT⟩ := hT
    have hℓ1 : (1 : ℝ) < (ℓ : ℝ) := by exact_mod_cast (Fact.out : Nat.Prime ℓ).one_lt
    have hsum : ∀ c : ℕ → ℤ_[ℓ], Summable (fun j => (ℓ : ℤ_[ℓ]) ^ j * c j) := by
      intro c
      refine Summable.of_norm_bounded (g := fun j : ℕ => ((ℓ : ℝ)⁻¹) ^ j)
        (summable_geometric_of_lt_one (by positivity) (inv_lt_one_of_one_lt₀ hℓ1)) ?_
      intro j
      calc ‖(ℓ : ℤ_[ℓ]) ^ j * c j‖ ≤ ‖(ℓ : ℤ_[ℓ]) ^ j‖ * ‖c j‖ := norm_mul_le _ _
        _ ≤ ‖(ℓ : ℤ_[ℓ]) ^ j‖ * 1 :=
            mul_le_mul_of_nonneg_left (PadicInt.norm_le_one _) (norm_nonneg _)
        _ = ((ℓ : ℝ)⁻¹) ^ j := by rw [mul_one, norm_pow, PadicInt.norm_p]
    obtain ⟨A, hA⟩ : ∃ A : (ℕ → ℤ_[ℓ]) → ℤ_[ℓ], ∀ c : ℕ → ℤ_[ℓ],
        A c = c 0 + (ℓ : ℤ_[ℓ]) * A (fun j => c (j + 1)) := by
      refine ⟨fun c => ∑' j, (ℓ : ℤ_[ℓ]) ^ j * c j, fun c => ?_⟩
      show ∑' j, (ℓ : ℤ_[ℓ]) ^ j * c j = c 0 + (ℓ : ℤ_[ℓ]) * ∑' j, (ℓ : ℤ_[ℓ]) ^ j * c (j + 1)
      rw [(hsum c).tsum_eq_zero_add, pow_zero, one_mul,
        ← (hsum (fun j => c (j + 1))).tsum_mul_left]
      congr 1
      apply tsum_congr
      intro j
      ring
    choose dig hdigT nxt hnxt using hT
    rw [Module.finite_def]
    refine ⟨T, ?_⟩
    rw [eq_top_iff]
    intro m _
    obtain ⟨μ, hμ0, hμ⟩ : ∃ μ : ℕ → M, μ 0 = m ∧ ∀ n, μ (n + 1) = nxt (μ n) :=
      ⟨fun n => nxt^[n] m, rfl, fun n => Function.iterate_succ_apply' nxt n m⟩
    obtain ⟨κ, hκ⟩ : ∃ κ : ℕ → M → ℤ_[ℓ], ∀ n s,
        κ n s = (if dig (μ n) = s then (1 : ℤ_[ℓ]) else 0) + (ℓ : ℤ_[ℓ]) * κ (n + 1) s := by
      refine ⟨fun n s => A (fun j => if dig (μ (n + j)) = s then (1 : ℤ_[ℓ]) else 0),
        fun n s => ?_⟩
      have h1 := hA (fun j => if dig (μ (n + j)) = s then (1 : ℤ_[ℓ]) else 0)
      have e : (fun j => if dig (μ (n + (j + 1))) = s then (1 : ℤ_[ℓ]) else 0) =
          (fun j => if dig (μ (n + 1 + j)) = s then (1 : ℤ_[ℓ]) else 0) := by
        funext j
        rw [show n + (j + 1) = n + 1 + j by omega]
      beta_reduce at h1
      rw [add_zero, e] at h1
      exact h1
    have hsplit : ∀ n, ∑ s ∈ T, κ n s • s =
        dig (μ n) + (ℓ : ℤ_[ℓ]) • ∑ s ∈ T, κ (n + 1) s • s := by
      intro n
      have h3 : ∑ s ∈ T, (if dig (μ n) = s then (1 : ℤ_[ℓ]) else 0) • s = dig (μ n) := by
        simp only [ite_smul, one_smul, zero_smul]
        rw [Finset.sum_ite_eq, if_pos (hdigT (μ n))]
      rw [Finset.sum_congr rfl (fun s _ => by rw [hκ n s]), Finset.smul_sum]
      simp only [add_smul, mul_smul, Finset.sum_add_distrib, h3]
    have hw : ∀ n, μ n - ∑ s ∈ T, κ n s • s =
        (ℓ : ℤ_[ℓ]) • (μ (n + 1) - ∑ s ∈ T, κ (n + 1) s • s) := by
      intro n
      have h2 : μ n = dig (μ n) + (ℓ : ℤ_[ℓ]) • μ (n + 1) := by rw [hμ n]; exact hnxt (μ n)
      rw [hsplit n, smul_sub]
      generalize dig (μ n) = d at h2 ⊢
      rw [h2]
      abel
    have h0 : μ 0 - ∑ s ∈ T, κ 0 s • s = 0 := hD (fun n => μ n - ∑ s ∈ T, κ n s • s) hw
    rw [hμ0, sub_eq_zero] at h0
    rw [h0]
    exact Submodule.sum_smul_mem _ _ (fun s hs => Submodule.subset_span hs)

  have s1 : ∀ (m n : ℕ) (f : Fin m → ℕ) (g : Fin n → ℕ)
      (φ : ((i : Fin m) → ZMod (ℓ ^ f i)) →+ ((j : Fin n) → ZMod (ℓ ^ g j)))
      (a : ℤ_[ℓ]) (y : (i : Fin m) → ZMod (ℓ ^ f i)),
      φ (fun i => PadicInt.toZModPow (f i) a * y i) =
        fun j => PadicInt.toZModPow (g j) a * φ y j := by
    intro m n f g φ a y
    have hf : ∀ i, f i ≤ (∑ i, f i) + (∑ j, g j) := fun i =>
      le_trans (Finset.single_le_sum (fun _ _ => Nat.zero_le _) (Finset.mem_univ i))
        (Nat.le_add_right _ _)
    have hg : ∀ j, g j ≤ (∑ i, f i) + (∑ j, g j) := fun j =>
      le_trans (Finset.single_le_sum (fun _ _ => Nat.zero_le _) (Finset.mem_univ j))
        (Nat.le_add_left _ _)
    generalize (∑ i, f i) + (∑ j, g j) = N at hf hg
    haveI : NeZero (ℓ ^ N) := ⟨pow_ne_zero _ (Fact.out : ℓ.Prime).ne_zero⟩
    have K : ∀ r, r ≤ N → PadicInt.toZModPow r a =
        (((PadicInt.toZModPow N a).val : ℕ) : ZMod (ℓ ^ r)) := by
      intro r hr
      rw [← PadicInt.cast_toZModPow r N hr a, ZMod.cast_eq_val]
    have h1 : (fun i => PadicInt.toZModPow (f i) a * y i) =
        (PadicInt.toZModPow N a).val • y := by
      funext i
      rw [Pi.smul_apply, nsmul_eq_mul, K (f i) (hf i)]
    rw [h1, map_nsmul]
    funext j
    rw [Pi.smul_apply, nsmul_eq_mul, K (g j) (hg j)]

  letI instZ : ∀ r : ℕ, Module ℤ_[ℓ] (ZMod (ℓ ^ r)) := fun r =>
    Module.compHom (ZMod (ℓ ^ r)) (PadicInt.toZModPow r)
  have L1 : ∀ (a : ℤ_[ℓ]) (x : (k : ℕ) → (i : Fin (b k)) → ZMod (ℓ ^ e k i)),
      sh (a • x) = a • sh x := by
    intro a x
    funext k i
    have h2 := s1 _ _ (e (k + 1)) (e k) (ρ k) a (x (k + 1))
    rw [hshf]
    change PadicInt.toZModPow (e k i) a * x k i -
        ρ k (fun i => PadicInt.toZModPow (e (k + 1) i) a * x (k + 1) i) i =
      PadicInt.toZModPow (e k i) a * sh x k i
    rw [h2, hshf, Pi.sub_apply, mul_sub]
  letI : SMul ℤ_[ℓ] ↥sh.ker := ⟨fun a x => ⟨a • x.1, by
    rw [AddMonoidHom.mem_ker, L1, AddMonoidHom.mem_ker.mp x.2, smul_zero]⟩⟩
  letI inst : Module ℤ_[ℓ] ↥sh.ker :=
    Function.Injective.module ℤ_[ℓ] sh.ker.subtype Subtype.val_injective (fun a x => rfl)
  refine ⟨inst, crit _ ?_ ?_⟩
  ·
    haveI : ∀ r : ℕ, NeZero (ℓ ^ r) := fun r => ⟨pow_ne_zero _ (Fact.out : ℓ.Prime).ne_zero⟩
    let R : Set ((i : Fin (b 1)) → ZMod (ℓ ^ e 1 i)) := {z | ∃ x, sh x = 0 ∧ x 1 = z}
    have hR : R.Finite := Set.toFinite R
    let χ : ((i : Fin (b 1)) → ZMod (ℓ ^ e 1 i)) → ↥sh.ker := fun z =>
      if h : z ∈ R then ⟨Classical.choose h, (Classical.choose_spec h).1⟩ else 0
    have hχ : ∀ z ∈ R, (χ z).1 1 = z := by
      intro z hz
      simp only [χ, dif_pos hz]
      exact (Classical.choose_spec hz).2
    refine ⟨hR.toFinset.image χ, fun m => ?_⟩
    have hm : m.1 1 ∈ R := ⟨m.1, AddMonoidHom.mem_ker.mp m.2, rfl⟩
    refine ⟨χ (m.1 1), Finset.mem_image_of_mem _ (hR.mem_toFinset.mpr hm), ?_⟩
    obtain ⟨y, hy, hxy⟩ := hdiv (m.1 - (χ (m.1 1)).1)
      (by rw [map_sub, AddMonoidHom.mem_ker.mp m.2, AddMonoidHom.mem_ker.mp (χ _).2, sub_self])
      (by rw [Pi.sub_apply, hχ _ hm, sub_self])
    refine ⟨⟨y, hy⟩, ?_⟩
    rw [Nat.cast_smul_eq_nsmul]
    apply Subtype.ext
    rw [AddSubgroup.coe_add, AddSubgroup.coe_nsmul]
    show m.1 = (χ (m.1 1)).1 + ℓ • y
    rw [← hxy]
    abel
  ·
    intro w hw
    have hv : ∀ n, (w n).1 = ℓ • (w (n + 1)).1 := by
      intro n
      rw [hw n, Nat.cast_smul_eq_nsmul, AddSubgroup.coe_nsmul]
    have hpow : ∀ n, (w 0).1 = ℓ ^ n • (w n).1 := by
      intro n
      induction n with
      | zero => rw [pow_zero, one_smul]
      | succ n ih => rw [ih, hv n, smul_smul, ← pow_succ]
    have h0 : (w 0).1 = 0 := by
      funext k i
      have hz : ((ℓ ^ e k i : ℕ) : ZMod (ℓ ^ e k i)) = 0 := ZMod.natCast_self _
      rw [hpow (e k i), Pi.smul_apply, Pi.smul_apply, nsmul_eq_mul, hz, zero_mul]
      rfl
    exact Subtype.ext h0

theorem wc_padic_fg_structure_addEquiv : ∀ (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (M : Type) [AddCommGroup M] [Module ℤ_[ℓ] M]
    [Module.Finite ℤ_[ℓ] M],
    ∃ (a b' : ℕ) (e' : Fin b' → ℕ),
      Nonempty (M ≃+ ((Fin a → ℤ_[ℓ]) × ((j : Fin b') → ZMod (ℓ ^ e' j)))) :=
by
  intro ℓ _ M _ _ _
  classical
  obtain ⟨n, ι, hι, p, hp, e, ⟨f⟩⟩ := Module.equiv_free_prod_directSum ℤ_[ℓ] M
  have hQ : ∀ i, Nonempty ((ℤ_[ℓ] ⧸ Submodule.span ℤ_[ℓ] {p i ^ e i}) ≃+ ZMod (ℓ ^ e i)) := by
    intro i
    have hassoc : Associated (p i) (ℓ : ℤ_[ℓ]) :=
      IsDiscreteValuationRing.associated_of_irreducible ℤ_[ℓ] (hp i) PadicInt.irreducible_p
    have h1 : Submodule.span ℤ_[ℓ] {p i ^ e i} =
        RingHom.ker (PadicInt.toZModPow (p := ℓ) (e i)) := by
      rw [PadicInt.ker_toZModPow]
      exact Ideal.span_singleton_eq_span_singleton.mpr (hassoc.pow_pow)
    have hsurj : Function.Surjective (PadicInt.toZModPow (p := ℓ) (e i)) :=
      ZMod.ringHom_surjective _
    exact ⟨(Submodule.quotEquivOfEq _ _ h1).toAddEquiv.trans
      (RingHom.quotientKerEquivOfSurjective hsurj).toAddEquiv⟩
  let σ := Fintype.equivFin ι
  let φ := fun i => (hQ i).some
  refine ⟨n, Fintype.card ι, fun j => e (σ.symm j), ⟨?_⟩⟩
  refine f.toAddEquiv.trans (AddEquiv.prodCongr
    (Finsupp.linearEquivFunOnFinite ℤ_[ℓ] ℤ_[ℓ] (Fin n)).toAddEquiv ?_)
  refine (DirectSum.addEquivProd _).trans ((AddEquiv.piCongrRight φ).trans ?_)
  exact { Equiv.piCongrLeft' (fun i => ZMod (ℓ ^ e i)) σ with map_add' := fun x y => rfl }

theorem wc_padic_fg_compact_addEquiv_continuous : ∀ (L : Type) [AddCommGroup L] [TopologicalSpace L] [IsTopologicalAddGroup L] [CompactSpace L]
    [T2Space L] (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (a b' : ℕ) (e' : Fin b' → ℕ)
    (Φ : L ≃+ ((Fin a → ℤ_[ℓ]) × ((j : Fin b') → ZMod (ℓ ^ e' j)))),
    Continuous Φ ∧ Continuous Φ.symm :=
by
  intro L _ _ _ _ _ ℓ _ a b' e' Φ
  have hℓ : Nat.Prime ℓ := Fact.out

  have s1 : ∀ U ∈ nhds (0 : (Fin a → ℤ_[ℓ]) × ((j : Fin b') → ZMod (ℓ ^ e' j))),
      ∃ N : ℕ, ∀ m : (Fin a → ℤ_[ℓ]) × ((j : Fin b') → ZMod (ℓ ^ e' j)), (ℓ ^ N) • m ∈ U := by
    intro U hU
    rw [Prod.zero_eq_mk, nhds_prod_eq, Filter.mem_prod_iff] at hU
    obtain ⟨U₁, hU₁, U₂, hU₂, hsub⟩ := hU
    obtain ⟨ε, hε, hball⟩ := Metric.mem_nhds_iff.mp hU₁
    have hℓ1 : (1 : ℝ) < ℓ := by exact_mod_cast hℓ.one_lt
    have hinv : (ℓ : ℝ)⁻¹ < 1 := inv_lt_one_of_one_lt₀ hℓ1
    obtain ⟨N₀, hN₀⟩ := exists_pow_lt_of_lt_one hε hinv
    refine ⟨N₀ + ∑ j, e' j, fun m => hsub ⟨?_, ?_⟩⟩
    · apply hball
      rw [Metric.mem_ball, dist_zero_right]
      refine (pi_norm_lt_iff hε).mpr fun i => ?_
      show ‖(ℓ ^ (N₀ + ∑ j, e' j)) • m.1 i‖ < ε
      rw [nsmul_eq_mul, Nat.cast_pow]
      calc ‖(ℓ : ℤ_[ℓ]) ^ (N₀ + ∑ j, e' j) * m.1 i‖
          ≤ ‖(ℓ : ℤ_[ℓ]) ^ (N₀ + ∑ j, e' j)‖ * ‖m.1 i‖ := norm_mul_le _ _
        _ = (ℓ : ℝ) ^ (-((N₀ + ∑ j, e' j : ℕ) : ℤ)) * ‖m.1 i‖ := by rw [PadicInt.norm_p_pow]
        _ ≤ (ℓ : ℝ) ^ (-((N₀ + ∑ j, e' j : ℕ) : ℤ)) * 1 := by
            gcongr; exact PadicInt.norm_le_one _
        _ = ((ℓ : ℝ)⁻¹) ^ (N₀ + ∑ j, e' j) := by rw [mul_one, zpow_neg, zpow_natCast, inv_pow]
        _ ≤ ((ℓ : ℝ)⁻¹) ^ N₀ := pow_le_pow_of_le_one (by positivity) hinv.le (by omega)
        _ < ε := hN₀
    · have hz : (ℓ ^ (N₀ + ∑ j, e' j)) • m.2 = 0 := by
        funext j
        show (ℓ ^ (N₀ + ∑ j, e' j)) • m.2 j = 0
        rw [nsmul_eq_mul]
        have hle : e' j ≤ ∑ j, e' j :=
          Finset.single_le_sum (f := e') (fun _ _ => Nat.zero_le _) (Finset.mem_univ j)
        have hdvd : ℓ ^ e' j ∣ ℓ ^ (N₀ + ∑ j, e' j) := pow_dvd_pow ℓ (by omega)
        rw [(ZMod.natCast_eq_zero_iff _ _).mpr hdvd, zero_mul]
      show (ℓ ^ (N₀ + ∑ j, e' j)) • m.2 ∈ U₂
      rw [hz]
      exact mem_of_mem_nhds hU₂

  have s2 : ∀ N : ℕ, ((nsmulAddMonoidHom (ℓ ^ N) : L →+ L).range).FiniteIndex := by
    intro N
    haveI : NeZero (ℓ ^ N) := ⟨pow_ne_zero _ hℓ.ne_zero⟩
    haveI : ∀ j, NeZero (ℓ ^ e' j) := fun j => ⟨pow_ne_zero _ hℓ.ne_zero⟩
    let π : ((Fin a → ℤ_[ℓ]) × ((j : Fin b') → ZMod (ℓ ^ e' j))) →+
        ((Fin a → ZMod (ℓ ^ N)) × ((j : Fin b') → ZMod (ℓ ^ e' j))) :=
      AddMonoidHom.prodMap ((PadicInt.toZModPow N : ℤ_[ℓ] →+* ZMod (ℓ ^ N)).toAddMonoidHom.compLeft
        (Fin a)) (AddMonoidHom.id _)
    let κ := π.comp Φ.toAddMonoidHom
    haveI : κ.ker.FiniteIndex := AddSubgroup.finiteIndex_ker κ
    apply AddSubgroup.finiteIndex_of_le (H := κ.ker)
    intro x hx
    rw [AddMonoidHom.mem_ker] at hx
    have h2 : (Φ x).2 = 0 := congrArg Prod.snd hx
    have h1 : ∀ i, (PadicInt.toZModPow N : ℤ_[ℓ] →+* ZMod (ℓ ^ N)) ((Φ x).1 i) = 0 :=
      fun i => congrFun (congrArg Prod.fst hx) i
    have hw : ∀ i, ∃ w : ℤ_[ℓ], w * (ℓ : ℤ_[ℓ]) ^ N = (Φ x).1 i := by
      intro i
      have hk : (Φ x).1 i ∈ RingHom.ker (PadicInt.toZModPow N : ℤ_[ℓ] →+* ZMod (ℓ ^ N)) := h1 i
      rw [PadicInt.ker_toZModPow] at hk
      exact Ideal.mem_span_singleton'.mp hk
    choose w hw using hw
    rw [AddMonoidHom.mem_range]
    refine ⟨Φ.symm (w, 0), ?_⟩
    show (ℓ ^ N) • Φ.symm (w, 0) = x
    apply Φ.injective
    rw [map_nsmul, AddEquiv.apply_symm_apply]
    refine Prod.ext ?_ ?_
    · funext i
      show (ℓ ^ N) • w i = (Φ x).1 i
      rw [nsmul_eq_mul, Nat.cast_pow, mul_comm, hw i]
    · show (ℓ ^ N) • (0 : (j : Fin b') → ZMod (ℓ ^ e' j)) = (Φ x).2
      rw [smul_zero, h2]

  have hopen : ∀ N : ℕ, IsOpen (((nsmulAddMonoidHom (ℓ ^ N) : L →+ L).range : Set L)) := by
    intro N
    haveI := s2 N
    apply AddSubgroup.isOpen_of_isClosed_of_finiteIndex
    have hr : (((nsmulAddMonoidHom (ℓ ^ N) : L →+ L).range : Set L)) =
        Set.range (fun x : L => (ℓ ^ N) • x) := by
      ext y
      simp
    rw [hr]
    exact (isCompact_range (continuous_nsmul _)).isClosed

  have hc : Continuous Φ := by
    apply continuous_of_continuousAt_zero Φ
    rw [ContinuousAt, map_zero]
    intro U hU
    obtain ⟨N, hN⟩ := s1 U hU
    apply Filter.mem_of_superset ((hopen N).mem_nhds (zero_mem _))
    rintro x ⟨y, rfl⟩
    show Φ ((ℓ ^ N) • y) ∈ U
    rw [map_nsmul]
    exact hN _

  exact ⟨hc, Continuous.continuous_symm_of_equiv_compact_to_t2 (f := Φ.toEquiv) hc⟩

theorem wc_contSheaf_iso_of_homeo : ∀ (S : Scheme.{u}) {A A' : Type} [AddCommGroup A] [TopologicalSpace A] [IsTopologicalAddGroup A]
    [AddCommGroup A'] [TopologicalSpace A'] [IsTopologicalAddGroup A'] (Φ : A ≃+ A'),
    Continuous Φ → Continuous Φ.symm → Nonempty (wcContSheaf S A ≅ wcContSheaf S A') :=
by
  intro S A A' _ _ _ _ _ _ Φ hΦ hΦ'
  have key : ∀ {A B : Type} [AddCommGroup A] [TopologicalSpace A] [IsTopologicalAddGroup A]
      [AddCommGroup B] [TopologicalSpace B] [IsTopologicalAddGroup B]
      (φ : A →+ B) (hφ : Continuous φ) (U : (S.ProEt)ᵒᵖ)
      (x : ((wcContSheaf S A).obj.obj U : Type (u+1))),
      (wcContSheafMap S φ hφ).hom.app U x =
        (ULift.up (AddMonoidHom.compLeftContinuous
          (↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop U))) φ hφ
          (ULift.down x : C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop U)), A))) : _) := by
    intro A B _ _ _ _ _ _ φ hφ U x
    rfl
  have h1 : Continuous (Φ.toAddMonoidHom : A →+ A') := hΦ
  have h2 : Continuous (Φ.symm.toAddMonoidHom : A' →+ A) := hΦ'
  refine ⟨⟨wcContSheafMap S Φ.toAddMonoidHom h1, wcContSheafMap S Φ.symm.toAddMonoidHom h2,
    ?_, ?_⟩⟩
  · apply Sheaf.hom_ext
    apply NatTrans.ext
    funext U
    apply AddCommGrpCat.ext
    intro x
    rw [ObjectProperty.FullSubcategory.comp_hom, NatTrans.comp_app, CategoryTheory.comp_apply,
      key, key]
    apply ULift.ext
    apply ContinuousMap.ext
    intro a
    exact Φ.symm_apply_apply _
  · apply Sheaf.hom_ext
    apply NatTrans.ext
    funext U
    apply AddCommGrpCat.ext
    intro x
    rw [ObjectProperty.FullSubcategory.comp_hom, NatTrans.comp_app, CategoryTheory.comp_apply,
      key, key]
    apply ULift.ext
    apply ContinuousMap.ext
    intro a
    exact Φ.apply_symm_apply _

theorem wc_proet_Rq_int_const_of_torsion_const : ∀ {X B : Scheme.{u}} (g : X ⟶ B) [QuasiCompact g]
    [QuasiSeparated g] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (V : B.ProEt), ConnectedSpace V.left → CompactSpace V.left → QuasiSeparatedSpace V.left →
    (∀ q k : ℕ, ∃ (b : ℕ) (e : Fin b → ℕ),
      Nonempty ((((wcProEtPush g).rightDerived q).obj (wcContSheaf X (ZMod (ℓ ^ k)))).over V ≅
        (wcContSheaf B ((j : Fin b) → ZMod (ℓ ^ e j))).over V)) →
    ∀ q : ℕ, ∃ (a b : ℕ) (e : Fin b → ℕ),
      Nonempty ((((wcProEtPush g).rightDerived q).obj (wcContSheaf X ℤ_[ℓ])).over V ≅
        (wcContSheaf B ((Fin a → ℤ_[ℓ]) × ((j : Fin b) → ZMod (ℓ ^ e j)))).over V) :=
by
  intro X B g _ _ ℓ _ V hconn _ _ H q
  classical

  choose b e hθ using H
  let θ : ∀ j k, (((wcProEtPush g).rightDerived j).obj (wcContSheaf X (ZMod (ℓ ^ k)))).over V ≅
      (wcContSheaf B ((i : Fin (b j k)) → ZMod (ℓ ^ e j k i))).over V := fun j k => (hθ j k).some

  have hρex : ∀ j k, ∃ ρ : ((i : Fin (b j (k + 1))) → ZMod (ℓ ^ e j (k + 1) i)) →+
      ((i : Fin (b j k)) → ZMod (ℓ ^ e j k i)),
      (θ j (k + 1)).inv ≫ ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map
        (((wcProEtPush g).rightDerived j).map
          (wcContSheafMap X (wcTowerCast ℓ k) continuous_of_discreteTopology)) ≫ (θ j k).hom =
      ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map
        (wcContSheafMap B ρ continuous_of_discreteTopology) := fun j k =>
    wc_proet_over_contSheaf_discrete_hom B V hconn _
  choose ρ hρ using hρex
  have hsq : ∀ j k, ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map
        (((wcProEtPush g).rightDerived j).map
          (wcContSheafMap X (wcTowerCast ℓ k) continuous_of_discreteTopology)) ≫ (θ j k).hom =
      (θ j (k + 1)).hom ≫ ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map
        (wcContSheafMap B (ρ j k) continuous_of_discreteTopology) := by
    intro j k
    rw [← hρ j k, Iso.hom_inv_id_assoc]

  let sh : ∀ j, ((k : ℕ) → (i : Fin (b j k)) → ZMod (ℓ ^ e j k i)) →+
      ((k : ℕ) → (i : Fin (b j k)) → ZMod (ℓ ^ e j k i)) := fun j =>
    AddMonoidHom.pi (fun k => Pi.evalAddMonoidHom (fun m => (i : Fin (b j m)) → ZMod (ℓ ^ e j m i)) k -
      (ρ j k).comp (Pi.evalAddMonoidHom (fun m => (i : Fin (b j m)) → ZMod (ℓ ^ e j m i)) (k + 1)))
  have hshf : ∀ j x k, sh j x k = x k - ρ j k (x (k + 1)) := fun j x k => rfl
  have hsh : ∀ j, Continuous (sh j) := by
    intro j
    refine continuous_pi fun k => ?_
    show Continuous fun x : ((m : ℕ) → (i : Fin (b j m)) → ZMod (ℓ ^ e j m i)) =>
      x k - ρ j k (x (k + 1))
    exact (continuous_apply k).sub
      ((continuous_of_discreteTopology (f := ρ j k)).comp (continuous_apply (k + 1)))

  have hT : Continuous (wcTowerShift ℓ) := by
    refine continuous_pi fun n => ?_
    show Continuous fun x : ((m : ℕ) → ZMod (ℓ ^ m)) => x n - wcTowerCast ℓ n (x (n + 1))
    exact (continuous_apply n).sub
      ((continuous_of_discreteTopology (f := wcTowerCast ℓ n)).comp (continuous_apply (n + 1)))
  have hI : Continuous (wcTowerIncl ℓ) := by
    refine continuous_pi fun n => ?_
    show Continuous ((PadicInt.toZModPow n).toAddMonoidHom : ℤ_[ℓ] →+ ZMod (ℓ ^ n))
    apply continuous_of_continuousAt_zero
    rw [ContinuousAt, map_zero, nhds_discrete (ZMod (ℓ ^ n)), Filter.tendsto_pure]
    have hr : (0 : ℝ) < (ℓ : ℝ) ^ (-(n : ℤ)) :=
      zpow_pos (by exact_mod_cast (Fact.out : Nat.Prime ℓ).pos) _
    filter_upwards [Metric.ball_mem_nhds (0 : ℤ_[ℓ]) hr] with x hx
    rw [Metric.mem_ball, dist_zero_right] at hx
    have hmem : x ∈ RingHom.ker (PadicInt.toZModPow n : ℤ_[ℓ] →+* ZMod (ℓ ^ n)) := by
      rw [PadicInt.ker_toZModPow]
      exact (PadicInt.norm_le_pow_iff_mem_span_pow x n).mp hx.le
    exact (RingHom.mem_ker (f := (PadicInt.toZModPow n : ℤ_[ℓ] →+* ZMod (ℓ ^ n)))).mp hmem

  have hΞex := fun j => wc_proet_Rq_tower_prod_transport g ℓ V j
    (fun m => (i : Fin (b j m)) → ZMod (ℓ ^ e j m i)) (θ j) (ρ j)
    (fun _ => continuous_of_discreteTopology) (hsq j) (sh j) (hsh j) (hshf j) hT
  choose Ξ hΞ1 hΞ2 using hΞex

  have hsec : ∀ j, ∃ σ : ((k : ℕ) → (i : Fin (b j k)) → ZMod (ℓ ^ e j k i)) →
      ((k : ℕ) → (i : Fin (b j k)) → ZMod (ℓ ^ e j k i)), Continuous σ ∧ ∀ y, sh j (σ y) = y :=
    fun j => wc_finite_tower_shift_section (fun m => (i : Fin (b j m)) → ZMod (ℓ ^ e j m i))
      (ρ j) (sh j) (hshf j)

  obtain ⟨ψ, hψ⟩ := wc_proet_Rq_int_over_kernel g ℓ V hI hT
    (fun j => (k : ℕ) → (i : Fin (b j k)) → ZMod (ℓ ^ e j k i)) sh hsh hsec Ξ hΞ2 q

  have hstar := wc_proet_Rq_int_lim_ell_div g ℓ V hconn q hI
    ((k : ℕ) → (i : Fin (b q k)) → ZMod (ℓ ^ e q k i)) (sh q) (Ξ q) ψ
    ((i : Fin (b q 1)) → ZMod (ℓ ^ e q 1 i)) (θ q 1)
    (Pi.evalAddMonoidHom (fun m => (i : Fin (b q m)) → ZMod (ℓ ^ e q m i)) 1) (continuous_apply 1)
    hψ (hΞ1 q 1)

  obtain ⟨inst, hfin⟩ := wc_padic_tower_lim_fg ℓ (b q) (e q) (ρ q) (sh q) (hshf q)
    (fun x h1 h2 => hstar x h1 h2)
  obtain ⟨a, b', e', ⟨Φ⟩⟩ := @wc_padic_fg_structure_addEquiv ℓ _ (↥(sh q).ker) _ inst hfin

  have hcl : IsClosed (((sh q).ker : AddSubgroup ((k : ℕ) → (i : Fin (b q k)) → ZMod (ℓ ^ e q k i))) :
      Set ((k : ℕ) → (i : Fin (b q k)) → ZMod (ℓ ^ e q k i))) :=
    isClosed_eq (hsh q) continuous_const
  haveI : CompactSpace ↥(sh q).ker := isCompact_iff_compactSpace.mp hcl.isCompact
  obtain ⟨hc1, hc2⟩ := wc_padic_fg_compact_addEquiv_continuous (↥(sh q).ker) ℓ a b' e' Φ

  obtain ⟨iso⟩ := wc_contSheaf_iso_of_homeo B Φ hc1 hc2
  exact ⟨a, b', e', ⟨ψ ≪≫ ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).mapIso iso⟩⟩

theorem wc_intScalar_natCast_eq_nsmul : ∀ (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (n : ℕ), wcIntScalar S ℓ (n : ℤ_[ℓ]) = n • 𝟙 (wcIntSheaf S ℓ) :=
by
  intro S ℓ _ n
  have keyZ : ∀ (c : ℤ_[ℓ]) (U : (S.ProEt)ᵒᵖ) (x : ((wcIntSheaf S ℓ).obj.obj U : Type (u+1))),
      (wcIntScalar S ℓ c).hom.app U x =
        (ULift.up (c • (ULift.down x : C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj
          (Opposite.unop U)), ℤ_[ℓ]))) : _) := by
    intro c U x
    rfl
  have hadd : ∀ a b : ℤ_[ℓ],
      wcIntScalar S ℓ (a + b) = wcIntScalar S ℓ a + wcIntScalar S ℓ b := by
    intro a b
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext U
    apply AddCommGrpCat.ext
    intro x
    rw [Sheaf.Hom.add_app, AddCommGrpCat.hom_add_apply, keyZ, keyZ, keyZ]
    apply ULift.ext
    exact add_smul a b (ULift.down x : C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj
      (Opposite.unop U)), ℤ_[ℓ]))
  have h1 : wcIntScalar S ℓ 1 = 𝟙 _ := by
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext U
    apply AddCommGrpCat.ext
    intro x
    rw [keyZ]
    apply ULift.ext
    exact one_smul _ _
  have h0 : wcIntScalar S ℓ 0 = 0 := by
    have e := hadd 0 0
    rw [add_zero] at e
    calc wcIntScalar S ℓ 0 = (wcIntScalar S ℓ 0 + wcIntScalar S ℓ 0) - wcIntScalar S ℓ 0 := by
          rw [add_sub_cancel_right]
      _ = wcIntScalar S ℓ 0 - wcIntScalar S ℓ 0 := by rw [← e]
      _ = 0 := sub_self _
  induction n with
  | zero => rw [Nat.cast_zero, h0, zero_nsmul]
  | succ k ih => rw [Nat.cast_succ, hadd, ih, h1, succ_nsmul]

theorem wc_rightDerived_map_nsmul_id : ∀ {C D : Type*} [Category C] [Category D] [Abelian C] [Abelian D] [HasInjectiveResolutions C] (F : C ⥤ D) [F.Additive] (q n : ℕ) (X : C), (F.rightDerived q).map (n • 𝟙 X) = n • 𝟙 ((F.rightDerived q).obj X) :=
by
  intro C D _ _ _ _ _ F _ q n X
  let I : InjectiveResolution X := injectiveResolution X
  have hside : I.ι ≫ (n • 𝟙 I.cocomplex) =
      (CochainComplex.single₀ C).map (n • 𝟙 X) ≫ I.ι := by
    first
    | (rw [Preadditive.comp_nsmul, Category.comp_id, Functor.map_nsmul, Functor.map_id,
        Preadditive.nsmul_comp, Category.id_comp])
    | (simp [Preadditive.comp_nsmul, Preadditive.nsmul_comp, Functor.map_nsmul])
  have h2 : (F.mapHomologicalComplex (ComplexShape.up ℕ) ⋙
      HomologicalComplex.homologyFunctor D (ComplexShape.up ℕ) q).map (n • 𝟙 I.cocomplex) =
      n • 𝟙 _ := by
    first
    | (rw [CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id])
    | (clear hside
       induction n with
       | zero => rw [zero_nsmul, zero_nsmul, CategoryTheory.Functor.map_zero]
       | succ k ih => rw [succ_nsmul, succ_nsmul, CategoryTheory.Functor.map_add, ih,
           CategoryTheory.Functor.map_id])
  have key : ∀ {A B : D} (e : A ≅ B) (k : ℕ), e.hom ≫ (k • 𝟙 B) ≫ e.inv = k • 𝟙 A := by
    intro A B e k
    rw [Preadditive.nsmul_comp, Category.id_comp, Preadditive.comp_nsmul, Iso.hom_inv_id]
  have hmap := F.rightDerived_map_eq q (n • 𝟙 X) (P := I) (Q := I) (n • 𝟙 I.cocomplex) hside
  rw [hmap, h2]
  first
  | exact key (I.isoRightDerivedObj F q) n
  | (erw [Preadditive.nsmul_comp, Category.id_comp, Preadditive.comp_nsmul, Iso.hom_inv_id])

theorem wc_rdsc_quasiIso_single0_iff : ∀ {C : Type*} [Category C] [Abelian C] (M : C) (K : CochainComplex C ℕ) (e : (CochainComplex.single₀ C).obj M ⟶ K), QuasiIso e ↔ (Mono (e.f 0) ∧ (∃ hz : e.f 0 ≫ K.d 0 1 = 0, (ShortComplex.mk (e.f 0) (K.d 0 1) hz).Exact) ∧ ∀ k, K.ExactAt (k + 1)) :=
by
  intro C _ _ M K e
  have hz0 : e.f 0 ≫ K.d 0 1 = 0 := by
    rw [e.comm 0 1, HomologicalComplex.single_obj_d, Limits.zero_comp]
  have hdeg : ∀ k : ℕ, QuasiIsoAt e (k + 1) ↔ K.ExactAt (k + 1) := fun k =>
    quasiIsoAt_iff_exactAt e (k + 1) (CochainComplex.exactAt_succ_single_obj M k)
  have hf1 : ((CochainComplex.single₀ C).obj M).d 0 0 = 0 :=
    HomologicalComplex.single_obj_d (ComplexShape.up ℕ) 0 M 0 0
  have hg1 : ((CochainComplex.single₀ C).obj M).d 0 1 = 0 :=
    HomologicalComplex.single_obj_d (ComplexShape.up ℕ) 0 M 0 1
  have h0 : QuasiIsoAt e 0 ↔
      (ShortComplex.mk (e.f 0) (K.d 0 1) hz0).Exact ∧ Mono (e.f 0) := by
    rw [CochainComplex.quasiIsoAt₀_iff]
    exact ShortComplex.quasiIso_iff_of_zeros _ hf1 hg1 (K.shape 0 0 (by simp))
  rw [quasiIso_iff]
  constructor
  · intro h
    obtain ⟨hex, hm⟩ := h0.1 (h 0)
    exact ⟨hm, ⟨hz0, hex⟩, fun k => (hdeg k).1 (h (k + 1))⟩
  · rintro ⟨hm, ⟨hz, hex⟩, hK⟩ i
    cases i with
    | zero => exact h0.2 ⟨hex, hm⟩
    | succ k => exact (hdeg k).2 (hK k)

theorem wc_rdsc_injective_tower_resolution_data : ∀ {C : Type*} [Category C] [Abelian C] [EnoughInjectives C] (G : ℕ ⥤ C), ∃ (I : ℕ → (ℕ ⥤ C)) (β : G ⟶ I 0) (d : ∀ k, I k ⟶ I (k + 1)), (∀ k n, Injective ((I k).obj n)) ∧ Mono β ∧ (∃ hz : β ≫ d 0 = 0, (ShortComplex.mk β (d 0) hz).Exact) ∧ ∀ k, ∃ hz : d k ≫ d (k + 1) = 0, (ShortComplex.mk (d k) (d (k + 1)) hz).Exact :=
by
  intro C _ _ _ G
  have s1 : ∀ {W Y Z V : ℕ ⥤ C} (p : W ⟶ Y) (α : Y ⟶ Z) (γ : Limits.cokernel α ⟶ V)
      (f : W ⟶ Z), p ≫ α = f → Epi p → Mono γ →
      ∃ hz : f ≫ (Limits.cokernel.π α ≫ γ) = 0,
        (ShortComplex.mk f (Limits.cokernel.π α ≫ γ) hz).Exact := by
    intro W Y Z V p α γ f hpf hp hγ
    subst hpf
    have hmid : (p ≫ α) ≫ Limits.cokernel.π α = 0 := by
      rw [Category.assoc, Limits.cokernel.condition, Limits.comp_zero]
    have hz : (p ≫ α) ≫ (Limits.cokernel.π α ≫ γ) = 0 := by
      rw [← Category.assoc, hmid, Limits.zero_comp]
    refine ⟨hz, ?_⟩
    have hS1 : (ShortComplex.mk α (Limits.cokernel.π α) (Limits.cokernel.condition α)).Exact :=
      ShortComplex.exact_cokernel α
    let φA : ShortComplex.mk (p ≫ α) (Limits.cokernel.π α) hmid ⟶
        ShortComplex.mk α (Limits.cokernel.π α) (Limits.cokernel.condition α) :=
      ShortComplex.homMk p (𝟙 _) (𝟙 _) (by simp) (by simp)
    have : Epi φA.τ₁ := hp
    have : IsIso φA.τ₂ := (inferInstance : IsIso (𝟙 Z))
    have : Mono φA.τ₃ := (inferInstance : Mono (𝟙 (Limits.cokernel α)))
    have hmidE := (ShortComplex.exact_iff_of_epi_of_isIso_of_mono φA).2 hS1
    let φB : ShortComplex.mk (p ≫ α) (Limits.cokernel.π α) hmid ⟶
        ShortComplex.mk (p ≫ α) (Limits.cokernel.π α ≫ γ) hz :=
      ShortComplex.homMk (𝟙 _) (𝟙 _) γ (by simp) (by simp)
    have : Epi φB.τ₁ := (inferInstance : Epi (𝟙 W))
    have : IsIso φB.τ₂ := (inferInstance : IsIso (𝟙 Z))
    have : Mono φB.τ₃ := hγ
    exact (ShortComplex.exact_iff_of_epi_of_isIso_of_mono φB).1 hmidE
  have hTower : ∀ G : ℕ ⥤ C, ∃ (I : ℕ ⥤ C) (α : G ⟶ I), Mono α ∧ ∀ n, Injective (I.obj n) := by
    intro G
    let t : (n : ℕ) → Injective.under (G.obj n) ⟶ Injective.under (G.obj (n + 1)) := fun n =>
      Injective.factorThru (G.map (homOfLE (Nat.le_succ n)) ≫ Injective.ι (G.obj (n + 1)))
        (Injective.ι (G.obj n))
    let I : ℕ ⥤ C := Functor.ofSequence t
    have hnat : ∀ n : ℕ, G.map (homOfLE (Nat.le_succ n)) ≫ Injective.ι (G.obj (n + 1)) =
        Injective.ι (G.obj n) ≫ I.map (homOfLE (Nat.le_succ n)) := by
      intro n
      rw [Functor.ofSequence_map_homOfLE_succ]
      exact (Injective.comp_factorThru _ _).symm
    let α : G ⟶ I := NatTrans.ofSequence (F := G) (G := I)
      (fun n => Injective.ι (G.obj n)) hnat
    refine ⟨I, α, ?_, fun n => Injective.injective_under (G.obj n)⟩
    haveI : ∀ n, Mono (α.app n) := by
      intro n
      exact (Injective.ι_mono (G.obj n) : Mono (Injective.ι (G.obj n)))
    exact NatTrans.mono_of_mono_app α
  choose Inj emb hmono hinj using hTower
  let A : ℕ → (ℕ ⥤ C) := fun k =>
    Nat.rec (motive := fun _ => ℕ ⥤ C) G (fun _ B => Limits.cokernel (emb B)) k
  refine ⟨fun k => Inj (A k), emb G,
    fun k => (Limits.cokernel.π (emb (A k)) : Inj (A k) ⟶ A (k + 1)) ≫ emb (A (k + 1)),
    fun k n => hinj (A k) n, hmono G, ?_, ?_⟩
  · exact s1 (𝟙 G) (emb G) (emb (A 1)) (emb G) (Category.id_comp _) inferInstance (hmono (A 1))
  · intro k
    exact s1 (Limits.cokernel.π (emb (A k))) (emb (A (k + 1))) (emb (A (k + 2)))
      _ rfl inferInstance (hmono (A (k + 2)))

theorem wc_rdsc_tower_to_functor_resolution : ∀ {C : Type*} [Category C] [Abelian C] (G : ℕ ⥤ C) (I : ℕ → (ℕ ⥤ C)) (β : G ⟶ I 0) (d : ∀ k, I k ⟶ I (k + 1)), (∀ k n, Injective ((I k).obj n)) → Mono β → (∃ hz : β ≫ d 0 = 0, (ShortComplex.mk β (d 0) hz).Exact) → (∀ k, ∃ hz : d k ≫ d (k + 1) = 0, (ShortComplex.mk (d k) (d (k + 1)) hz).Exact) → ∃ (X : ℕ ⥤ CochainComplex C ℕ) (ε : G ⋙ CochainComplex.single₀ C ⟶ X), (∀ n k, Injective ((X.obj n).X k)) ∧ ∀ n, Mono ((ε.app n).f 0) ∧ (∃ hz : (ε.app n).f 0 ≫ (X.obj n).d 0 1 = 0, (ShortComplex.mk ((ε.app n).f 0) ((X.obj n).d 0 1) hz).Exact) ∧ ∀ k, (X.obj n).ExactAt (k + 1) :=
by
  intro C _ _ G I β d hIinj hβ h0 hd
  have sq : ∀ n k, (d k).app n ≫ (d (k + 1)).app n = 0 := fun n k => by
    obtain ⟨h, -⟩ := hd k
    rw [← NatTrans.comp_app, h, NatTrans.app_zero]
  obtain ⟨hz0, hex0⟩ := h0
  have hz0n : ∀ n, β.app n ≫ (d 0).app n = 0 := fun n => by
    rw [← NatTrans.comp_app, hz0, NatTrans.app_zero]
  let Xo : ℕ → CochainComplex C ℕ := fun n =>
    CochainComplex.of (fun k => (I k).obj n) (fun k => (d k).app n) (sq n)
  have hXd : ∀ n k, (Xo n).d k (k + 1) = (d k).app n := fun n k =>
    CochainComplex.of_d (fun k => (I k).obj n) (fun k => (d k).app n) k
  have hXd0 : ∀ n, (Xo n).d 0 1 = (d 0).app n := fun n => hXd n 0
  let Xm : ∀ {n m : ℕ}, (n ⟶ m) → (Xo n ⟶ Xo m) := fun {n m} f =>
    CochainComplex.ofHom (X := Xo n) (Y := Xo m) (fun k => (I k).map f) (fun k => by
      rw [hXd, hXd]
      exact (d k).naturality f)
  have hXm : ∀ {n m : ℕ} (f : n ⟶ m) (k : ℕ), (Xm f).f k = (I k).map f := fun f k => rfl
  let X : ℕ ⥤ CochainComplex C ℕ :=
    { obj := Xo
      map := fun f => Xm f
      map_id := fun n => by
        ext k
        rw [hXm, HomologicalComplex.id_f]
        exact (I k).map_id n
      map_comp := fun f g => by
        ext k
        rw [HomologicalComplex.comp_f, hXm, hXm, hXm]
        exact (I k).map_comp f g }
  have hb : ∀ n, β.app n ≫ (Xo n).d 0 1 = 0 := fun n => by
    rw [hXd0]
    exact hz0n n
  let εa : ∀ n, (G ⋙ CochainComplex.single₀ C).obj n ⟶ Xo n := fun n =>
    ((Xo n).fromSingle₀Equiv (G.obj n)).symm ⟨β.app n, hb n⟩
  have hεa : ∀ n, (εa n).f 0 = β.app n := fun n =>
    CochainComplex.fromSingle₀Equiv_symm_apply_f_zero _ _
  have hnat : ∀ {n m : ℕ} (f : n ⟶ m),
      (G ⋙ CochainComplex.single₀ C).map f ≫ εa m = εa n ≫ Xm f := by
    intro n m f
    apply HomologicalComplex.from_single_hom_ext
    rw [HomologicalComplex.comp_f, HomologicalComplex.comp_f, Functor.comp_map,
      CochainComplex.single₀_map_f_zero, hεa, hεa, hXm]
    exact β.naturality f
  let ε : G ⋙ CochainComplex.single₀ C ⟶ X :=
    { app := εa
      naturality := fun n m f => hnat f }
  have hz : ∀ n, (ε.app n).f 0 ≫ (X.obj n).d 0 1 = 0 := fun n => by
    show (εa n).f 0 ≫ (Xo n).d 0 1 = 0
    rw [hεa]
    exact hb n
  refine ⟨X, ε, fun n k => hIinj k n, fun n => ⟨?_, ⟨hz n, ?_⟩, fun k => ?_⟩⟩
  · show Mono ((εa n).f 0)
    rw [hεa]
    exact (NatTrans.mono_iff_mono_app β).mp hβ n
  · let S1 := ShortComplex.mk (β.app n) ((d 0).app n) (hz0n n)
    have e : S1.Exact := hex0.map ((evaluation ℕ C).obj n)
    refine ShortComplex.exact_of_iso (ShortComplex.isoMk (S₁ := S1)
      (Iso.refl (G.obj n)) (Iso.refl ((I 0).obj n)) (Iso.refl ((I 1).obj n)) ?_ ?_) e
    · show 𝟙 _ ≫ (εa n).f 0 = β.app n ≫ 𝟙 _
      exact (Category.id_comp _).trans ((hεa n).trans (Category.comp_id _).symm)
    · show 𝟙 _ ≫ (Xo n).d 0 1 = (d 0).app n ≫ 𝟙 _
      rw [hXd0, Category.id_comp, Category.comp_id]
  · rw [HomologicalComplex.exactAt_iff' (X.obj n) k (k + 1) (k + 1 + 1)
      (CochainComplex.prev_nat_succ k) (CochainComplex.next ℕ (k + 1))]
    obtain ⟨hzk, hexk⟩ := hd k
    let S1 := ShortComplex.mk ((d k).app n) ((d (k + 1)).app n) (sq n k)
    have e : S1.Exact := hexk.map ((evaluation ℕ C).obj n)
    refine ShortComplex.exact_of_iso (ShortComplex.isoMk (S₁ := S1)
      (Iso.refl ((I k).obj n)) (Iso.refl ((I (k + 1)).obj n))
      (Iso.refl ((I (k + 1 + 1)).obj n)) ?_ ?_) e
    · show 𝟙 _ ≫ (Xo n).d k (k + 1) = (d k).app n ≫ 𝟙 _
      rw [hXd, Category.id_comp, Category.comp_id]
    · show 𝟙 _ ≫ (Xo n).d (k + 1) (k + 1 + 1) = (d (k + 1)).app n ≫ 𝟙 _
      rw [hXd, Category.id_comp, Category.comp_id]

theorem wc_rdsc_homology_seq_colimit : ∀ {D : Type*} [Category D] [Abelian D] [Limits.HasColimitsOfShape ℕ D] [HasExactColimitsOfShape ℕ D] (Y : ℕ ⥤ CochainComplex D ℕ) (t : Limits.Cocone Y), (∀ k, Limits.IsColimit ((HomologicalComplex.eval D (ComplexShape.up ℕ) k).mapCocone t)) → ∀ q, Nonempty (Limits.IsColimit ((HomologicalComplex.homologyFunctor D (ComplexShape.up ℕ) q).mapCocone t)) :=
by
  intro D _ _ _ _ Y t H q

  have hu : Limits.IsColimit
      ((HomologicalComplex.shortComplexFunctor D (ComplexShape.up ℕ) q).mapCocone t) := by
    apply ShortComplex.isColimitOfIsColimitπ
    · exact (H ((ComplexShape.up ℕ).prev q)).ofIsoColimit
        (Limits.Cocones.ext (Iso.refl _) (fun j => Category.comp_id _))
    · exact (H q).ofIsoColimit (Limits.Cocones.ext (Iso.refl _) (fun j => Category.comp_id _))
    · exact (H ((ComplexShape.up ℕ).next q)).ofIsoColimit
        (Limits.Cocones.ext (Iso.refl _) (fun j => Category.comp_id _))

  have s2 : ∀ (S : ShortComplex (ℕ ⥤ D)), (∀ j : ℕ, (S.map ((evaluation ℕ D).obj j)).Exact) →
      S.Exact := by
    intro S hS
    rw [ShortComplex.exact_iff_isZero_homology]
    apply Functor.isZero
    intro j
    exact ((ShortComplex.exact_iff_isZero_homology _).1 (hS j)).of_iso
      (S.mapHomologyIso ((evaluation ℕ D).obj j)).symm

  have s3 : ∀ (F : ℕ ⥤ ShortComplex D) (u : Limits.Cocone F), Limits.IsColimit u →
      Limits.IsColimit ((ShortComplex.cyclesFunctor D).mapCocone u) := by
    intro F u hu
    let S : ShortComplex (ℕ ⥤ D) := ShortComplex.mk
      (Functor.whiskerLeft F (ShortComplex.iCyclesNatTrans D))
      (Functor.whiskerLeft F ShortComplex.π₂Toπ₃) (by ext j; exact (F.obj j).iCycles_g)
    have hS : S.Exact := s2 S (fun j => ShortComplex.exact_of_f_is_kernel _ (F.obj j).cyclesIsKernel)
    haveI : ∀ j, Mono (S.f.app j) := fun j => by
      change Mono (F.obj j).iCycles
      infer_instance
    haveI : Mono S.f := NatTrans.mono_of_mono_app _
    have hc₂ := Limits.isColimitOfPreserves ShortComplex.π₂ hu
    have hc₃ := Limits.isColimitOfPreserves ShortComplex.π₃ hu
    have hc₁ := Limits.colimit.isColimit S.X₁
    let φ : Limits.colimit S.X₁ ⟶ u.pt.cycles := hc₁.desc ((ShortComplex.cyclesFunctor D).mapCocone u)
    have hφ : ∀ j, (Limits.colimit.cocone S.X₁).ι.app j ≫ φ =
          ShortComplex.cyclesMap (u.ι.app j) := fun j => hc₁.fac _ j
    have hf : ∀ j, (Limits.colimit.cocone S.X₁).ι.app j ≫ (φ ≫ u.pt.iCycles) =
          S.f.app j ≫ (ShortComplex.π₂.mapCocone u).ι.app j := by
      intro j
      rw [← Category.assoc, hφ j]
      exact ShortComplex.cyclesMap_i (u.ι.app j)
    have hg : ∀ j, (ShortComplex.π₂.mapCocone u).ι.app j ≫ u.pt.g =
        S.g.app j ≫ (ShortComplex.π₃.mapCocone u).ι.app j := fun j => (u.ι.app j).comm₂₃
    let T : ShortComplex D := Limits.colim.mapShortComplex S hc₁ (ShortComplex.π₂.mapCocone u)
      (ShortComplex.π₃.mapCocone u) (φ ≫ u.pt.iCycles) u.pt.g hf hg
    have E : T.Exact :=
      Limits.colim.exact_mapShortComplex hS hc₁ hc₂ hc₃ (φ ≫ u.pt.iCycles) u.pt.g hf hg
    haveI hm : Mono (φ ≫ u.pt.iCycles) := Limits.colim.map_mono' S.f hc₁ hc₂ _ hf
    haveI : Mono φ := mono_of_mono φ u.pt.iCycles
    have hTf : T.f = φ ≫ u.pt.iCycles := Limits.colim.mapShortComplex_f _ _ _ _ _ _ _ _
    have hTg : T.g = u.pt.g := Limits.colim.mapShortComplex_g _ _ _ _ _ _ _ _
    haveI : Mono T.f := by rw [hTf]; exact hm
    have hk : u.pt.iCycles ≫ T.g = 0 := by rw [hTg]; exact u.pt.iCycles_g
    have hl := E.lift_f u.pt.iCycles hk
    rw [hTf] at hl
    let ℓ : u.pt.cycles ⟶ Limits.colimit S.X₁ := E.lift u.pt.iCycles hk
    have hl' : ℓ ≫ φ ≫ u.pt.iCycles = u.pt.iCycles := hl
    haveI : IsSplitEpi φ :=
      IsSplitEpi.mk' ⟨ℓ, by
        apply (cancel_mono u.pt.iCycles).1
        rw [Category.assoc, hl', Category.id_comp]⟩
    haveI : IsIso φ := isIso_of_mono_of_epi _
    haveI : IsIso (hc₁.desc ((ShortComplex.cyclesFunctor D).mapCocone u)) := by
      change IsIso φ; infer_instance
    exact Limits.IsColimit.ofPointIso hc₁

  have s4 : ∀ (F : ℕ ⥤ ShortComplex D) (u : Limits.Cocone F),
      Limits.IsColimit (ShortComplex.π₁.mapCocone u) →
      Limits.IsColimit ((ShortComplex.cyclesFunctor D).mapCocone u) →
      Limits.IsColimit ((ShortComplex.homologyFunctor D).mapCocone u) := by
    intro F u h₁ hZ
    let ι' : ∀ k, F.obj k ⟶ u.pt := fun k => u.ι.app k
    let σ : ∀ (s : Limits.Cocone (F ⋙ ShortComplex.homologyFunctor D)) (k : ℕ),
        (F.obj k).homology ⟶ s.pt := fun s k => s.ι.app k
    have hσ : ∀ (s : Limits.Cocone (F ⋙ ShortComplex.homologyFunctor D)) {i j : ℕ} (f : i ⟶ j),
        ShortComplex.homologyMap (F.map f) ≫ σ s j = σ s i := fun s i j f => s.w f
    let a : ∀ s : Limits.Cocone (F ⋙ ShortComplex.homologyFunctor D),
        Limits.Cocone (F ⋙ ShortComplex.cyclesFunctor D) := fun s =>
      { pt := s.pt
        ι := { app := fun j => (F.obj j).homologyπ ≫ σ s j
               naturality := by
                 intro i j f
                 have hn : ShortComplex.cyclesMap (F.map f) ≫ (F.obj j).homologyπ =
                     (F.obj i).homologyπ ≫ ShortComplex.homologyMap (F.map f) :=
                   (ShortComplex.homologyπ_naturality (F.map f)).symm
                 change ShortComplex.cyclesMap (F.map f) ≫ (F.obj j).homologyπ ≫ σ s j =
                   ((F.obj i).homologyπ ≫ σ s i) ≫ 𝟙 s.pt
                 rw [Category.comp_id, ← Category.assoc, hn, Category.assoc, hσ] } }
    let A : ∀ s : Limits.Cocone (F ⋙ ShortComplex.homologyFunctor D), u.pt.cycles ⟶ s.pt :=
      fun s => hZ.desc (a s)
    have hA : ∀ s j, ShortComplex.cyclesMap (ι' j) ≫ A s =
        (F.obj j).homologyπ ≫ σ s j := fun s j => hZ.fac (a s) j
    have hzero : ∀ s, u.pt.toCycles ≫ A s = 0 := by
      intro s
      apply h₁.hom_ext
      intro j
      change (ι' j).τ₁ ≫ u.pt.toCycles ≫ A s = (ι' j).τ₁ ≫ 0
      have hn : (F.obj j).toCycles ≫ ShortComplex.cyclesMap (ι' j) =
          (ι' j).τ₁ ≫ u.pt.toCycles := ShortComplex.toCycles_naturality (ι' j)
      rw [Limits.comp_zero, ← Category.assoc, ← hn, Category.assoc, hA, ← Category.assoc,
        ShortComplex.toCycles_comp_homologyπ, Limits.zero_comp]
    refine Limits.IsColimit.mk (fun s => u.pt.descHomology (A s) (hzero s)) ?_ ?_
    · intro s j
      change ShortComplex.homologyMap (ι' j) ≫ u.pt.descHomology (A s) (hzero s) = σ s j
      apply (cancel_epi (F.obj j).homologyπ).1
      rw [ShortComplex.homologyπ_naturality_assoc, ShortComplex.π_descHomology, hA]
    · intro s m hm
      let m' : u.pt.homology ⟶ s.pt := m
      have hm' : ∀ j, ShortComplex.homologyMap (ι' j) ≫ m' = σ s j := fun j => hm j
      change m' = u.pt.descHomology (A s) (hzero s)
      apply (cancel_epi u.pt.homologyπ).1
      rw [ShortComplex.π_descHomology]
      apply hZ.hom_ext
      intro j
      change ShortComplex.cyclesMap (ι' j) ≫ u.pt.homologyπ ≫ m' =
        ShortComplex.cyclesMap (ι' j) ≫ A s
      rw [hA, ← ShortComplex.homologyπ_naturality_assoc, hm']

  have h₁ := Limits.isColimitOfPreserves ShortComplex.π₁ hu
  have hH := s4 _ _ h₁ (s3 _ _ hu)
  have hH' : Limits.IsColimit ((HomologicalComplex.shortComplexFunctor D (ComplexShape.up ℕ) q ⋙
      ShortComplex.homologyFunctor D).mapCocone t) :=
    hH.ofIsoColimit (Functor.mapCoconeMapCocone t)
  exact ⟨Limits.IsColimit.mapCoconeEquiv
    (HomologicalComplex.homologyFunctorIso D (ComplexShape.up ℕ) q).symm hH'⟩

theorem wc_rdsc_colimit_resolution : ∀ {C : Type*} [Category C] [Abelian C] [Limits.HasColimitsOfShape ℕ C], (∀ (Y : ℕ ⥤ CochainComplex C ℕ) (t : Limits.Cocone Y), (∀ k, Limits.IsColimit ((HomologicalComplex.eval C (ComplexShape.up ℕ) k).mapCocone t)) → ∀ q, Nonempty (Limits.IsColimit ((HomologicalComplex.homologyFunctor C (ComplexShape.up ℕ) q).mapCocone t))) → ∀ (G : ℕ ⥤ C) (X : ℕ ⥤ CochainComplex C ℕ) (ε : G ⋙ CochainComplex.single₀ C ⟶ X), (∀ n, QuasiIso (ε.app n)) → ∀ (c : Limits.Cocone G), Limits.IsColimit c → ∀ (s : Limits.Cocone X), (∀ k, Limits.IsColimit ((HomologicalComplex.eval C (ComplexShape.up ℕ) k).mapCocone s)) → ∃ ε' : (CochainComplex.single₀ C).obj c.pt ⟶ s.pt, QuasiIso ε' ∧ ∀ n, ε.app n ≫ s.ι.app n = (CochainComplex.single₀ C).map (c.ι.app n) ≫ ε' :=
by
  intro C _ _ _ Hhom G X ε hε c hc s hs
  let hc' : Limits.IsColimit ((CochainComplex.single₀ C).mapCocone c) :=
    Limits.isColimitOfPreserves (CochainComplex.single₀ C) hc
  have hleg : ∀ n, (CochainComplex.single₀ C).map (c.ι.app n) ≫ hc'.map s ε = ε.app n ≫ s.ι.app n :=
    fun n => by simpa using hc'.ι_map s ε n
  refine ⟨hc'.map s ε, ?_, fun n => (hleg n).symm⟩
  rw [quasiIso_iff]
  intro q
  rw [quasiIsoAt_iff_isIso_homologyMap, ← HomologicalComplex.homologyFunctor_map]
  have hc'k : ∀ k, Limits.IsColimit ((HomologicalComplex.eval C (ComplexShape.up ℕ) k).mapCocone
      ((CochainComplex.single₀ C).mapCocone c)) :=
    fun k => Limits.isColimitOfPreserves _ hc'
  have P := (Hhom _ _ hc'k q).some
  have Q := (Hhom X s hs q).some
  have hα : ∀ n, IsIso ((Functor.whiskerRight ε
      (HomologicalComplex.homologyFunctor C (ComplexShape.up ℕ) q)).app n) := fun n => by
    have h1 := hε n
    rw [quasiIso_iff] at h1
    have h2 := (quasiIsoAt_iff_isIso_homologyMap _ q).1 (h1 q)
    rw [Functor.whiskerRight_app, HomologicalComplex.homologyFunctor_map]
    exact h2
  have : IsIso (Functor.whiskerRight ε
      (HomologicalComplex.homologyFunctor C (ComplexShape.up ℕ) q)) :=
    NatIso.isIso_of_isIso_app _
  have key : (HomologicalComplex.homologyFunctor C (ComplexShape.up ℕ) q).map (hc'.map s ε) =
      (P.coconePointsIsoOfNatIso Q (asIso (Functor.whiskerRight ε
        (HomologicalComplex.homologyFunctor C (ComplexShape.up ℕ) q)))).hom := by
    rw [Limits.IsColimit.coconePointsIsoOfNatIso_hom]
    apply P.hom_ext
    intro n
    rw [Limits.IsColimit.ι_map]
    simp only [Functor.mapCocone_ι_app, asIso_hom, Functor.whiskerRight_app]
    rw [← Functor.map_comp, ← Functor.map_comp, hleg n]
  rw [key]
  exact Iso.isIso_hom _

theorem wc_rdsc_lift_to_injective_resolution : ∀ {C : Type*} [Category C] [Abelian C] (M : C) (K : CochainComplex C ℕ) (e : (CochainComplex.single₀ C).obj M ⟶ K), Mono (e.f 0) → (∃ hz : e.f 0 ≫ K.d 0 1 = 0, (ShortComplex.mk (e.f 0) (K.d 0 1) hz).Exact) → (∀ k, K.ExactAt (k + 1)) → ∀ (J : InjectiveResolution M), ∃ χ : K ⟶ J.cocomplex, e ≫ χ = J.ι :=
by
  intro C _ _ M K e hmono hex hK J
  obtain ⟨hz, hS0⟩ := hex
  haveI := hmono
  haveI : ∀ n, Injective (J.cocomplex.X n) := J.injective
  let χ0 : K.X 0 ⟶ J.cocomplex.X 0 := Injective.factorThru (J.ι.f 0) (e.f 0)
  have F0 : e.f 0 ≫ χ0 = J.ι.f 0 := Injective.comp_factorThru _ _
  have hc0 : (ShortComplex.mk (e.f 0) (K.d 0 1) hz).f ≫ (χ0 ≫ J.cocomplex.d 0 1) = 0 := by
    show e.f 0 ≫ (χ0 ≫ J.cocomplex.d 0 1) = 0
    rw [← Category.assoc, F0, J.ι_f_zero_comp_complex_d]
  let χ1 : K.X 1 ⟶ J.cocomplex.X 1 := hS0.descToInjective (χ0 ≫ J.cocomplex.d 0 1) hc0
  have F1 : K.d 0 1 ≫ χ1 = χ0 ≫ J.cocomplex.d 0 1 :=
    hS0.comp_descToInjective (χ0 ≫ J.cocomplex.d 0 1) hc0
  refine ⟨CochainComplex.mkHom K J.cocomplex χ0 χ1 F1.symm (fun n p => ?_), ?_⟩
  · have hSn : (K.sc' n (n + 1) (n + 2)).Exact :=
      (K.exactAt_iff' n (n + 1) (n + 2) (CochainComplex.prev_nat_succ n)
        (CochainComplex.next ℕ (n + 1))).1 (hK n)
    have hc : (K.sc' n (n + 1) (n + 2)).f ≫ (p.2.1 ≫ J.cocomplex.d (n + 1) (n + 2)) = 0 := by
      show K.d n (n + 1) ≫ (p.2.1 ≫ J.cocomplex.d (n + 1) (n + 2)) = 0
      rw [← Category.assoc, ← p.2.2, Category.assoc, J.complex_d_comp, Limits.comp_zero]
    exact ⟨hSn.descToInjective (p.2.1 ≫ J.cocomplex.d (n + 1) (n + 2)) hc,
      (hSn.comp_descToInjective (p.2.1 ≫ J.cocomplex.d (n + 1) (n + 2)) hc).symm⟩
  · apply HomologicalComplex.from_single_hom_ext
    rw [HomologicalComplex.comp_f, CochainComplex.mkHom_f_0]
    exact F0

theorem wc_rdsc_mono_replacement : ∀ {C : Type*} [Category C] [Abelian C] [EnoughInjectives C] (M : C) (K : CochainComplex C ℕ) (e : (CochainComplex.single₀ C).obj M ⟶ K), Mono (e.f 0) → (∃ hz : e.f 0 ≫ K.d 0 1 = 0, (ShortComplex.mk (e.f 0) (K.d 0 1) hz).Exact) → ∀ (J : InjectiveResolution M) (χ : K ⟶ J.cocomplex), e ≫ χ = J.ι → ∃ (J' : InjectiveResolution M) (χ' : K ⟶ J'.cocomplex), e ≫ χ' = J'.ι ∧ ∀ k, Mono (χ'.f k) :=
by
  intro C _ _ _ M K e he hex J χ hχ
  obtain ⟨hz, hS⟩ := hex

  obtain ⟨Q, b, hQ0, hQinj, hbm⟩ : ∃ (Q : ℕ → C) (b : ∀ n, K.X n ⟶ Q n),
      Limits.IsZero (Q 0) ∧ (∀ n, Injective (Q n)) ∧ ∀ n, Mono (b (n + 1)) := by
    obtain ⟨Z, hZ⟩ := (inferInstance : Limits.HasZeroObject C).zero
    refine ⟨fun n => Nat.rec (motive := fun _ => C) Z
        (fun k _ => Injective.under (K.X (k + 1))) n,
      fun n => Nat.rec (motive := fun n => K.X n ⟶ Nat.rec (motive := fun _ => C) Z
        (fun k _ => Injective.under (K.X (k + 1))) n) 0
        (fun k _ => Injective.ι (K.X (k + 1))) n, ?_, ?_, ?_⟩
    · exact hZ
    · intro n
      cases n with
      | zero => exact hZ.injective
      | succ k => exact Injective.injective_under (K.X (k + 1))
    · intro n
      exact (inferInstance : Mono (Injective.ι (K.X (n + 1))))

  let E : CochainComplex C ℕ := CochainComplex.of (fun n => Q (n + 1) ⊞ Q n)
    (fun n => (Limits.biprod.fst : Q (n + 1) ⊞ Q n ⟶ Q (n + 1)) ≫
      (Limits.biprod.inr : Q (n + 1) ⟶ Q (n + 1 + 1) ⊞ Q (n + 1)))
    (fun n => by simp)
  have hEd : ∀ n, E.d n (n + 1) = (Limits.biprod.fst : Q (n + 1) ⊞ Q n ⟶ Q (n + 1)) ≫
      (Limits.biprod.inr : Q (n + 1) ⟶ Q (n + 1 + 1) ⊞ Q (n + 1)) := by
    intro n
    exact CochainComplex.of_d (fun n => Q (n + 1) ⊞ Q n)
      (fun n => (Limits.biprod.fst : Q (n + 1) ⊞ Q n ⟶ Q (n + 1)) ≫
        (Limits.biprod.inr : Q (n + 1) ⟶ Q (n + 1 + 1) ⊞ Q (n + 1))) n
  have hEd0 : E.d 0 1 = (Limits.biprod.fst : Q 1 ⊞ Q 0 ⟶ Q 1) ≫
      (Limits.biprod.inr : Q 1 ⟶ Q (1 + 1) ⊞ Q 1) := hEd 0
  have hEinj : ∀ n, Injective (E.X n) := fun n => by
    haveI := hQinj (n + 1)
    haveI := hQinj n
    exact (inferInstance : Injective (Q (n + 1) ⊞ Q n))

  have key0 : ∀ {A : C} (y : A ⟶ Q 1 ⊞ Q 0),
      y ≫ ((Limits.biprod.fst : Q 1 ⊞ Q 0 ⟶ Q 1) ≫
        (Limits.biprod.inr : Q 1 ⟶ Q (1 + 1) ⊞ Q 1)) = 0 → y = 0 := by
    intro A y hy
    apply Limits.biprod.hom_ext
    · have := hy =≫ (Limits.biprod.snd : Q (1 + 1) ⊞ Q 1 ⟶ Q 1)
      simpa using this
    · exact hQ0.eq_of_tgt _ _
  have keyS : ∀ (n : ℕ) {A : C} (y : A ⟶ Q (n + 1 + 1) ⊞ Q (n + 1)),
      y ≫ ((Limits.biprod.fst : Q (n + 1 + 1) ⊞ Q (n + 1) ⟶ Q (n + 1 + 1)) ≫
        (Limits.biprod.inr : Q (n + 1 + 1) ⟶ Q (n + 1 + 1 + 1) ⊞ Q (n + 1 + 1))) = 0 →
      y = (y ≫ (Limits.biprod.snd : Q (n + 1 + 1) ⊞ Q (n + 1) ⟶ Q (n + 1)) ≫
        (Limits.biprod.inl : Q (n + 1) ⟶ Q (n + 1) ⊞ Q n)) ≫
        ((Limits.biprod.fst : Q (n + 1) ⊞ Q n ⟶ Q (n + 1)) ≫
          (Limits.biprod.inr : Q (n + 1) ⟶ Q (n + 1 + 1) ⊞ Q (n + 1))) := by
    intro n A y hy
    have h1 : y ≫ (Limits.biprod.fst : Q (n + 1 + 1) ⊞ Q (n + 1) ⟶ Q (n + 1 + 1)) = 0 := by
      have := hy =≫ (Limits.biprod.snd : Q (n + 1 + 1 + 1) ⊞ Q (n + 1 + 1) ⟶ Q (n + 1 + 1))
      simpa using this
    apply Limits.biprod.hom_ext
    · rw [h1]; simp
    · simp
  have hEex : ∀ n, E.ExactAt n := by
    intro n
    cases n with
    | zero =>
      rw [HomologicalComplex.exactAt_iff' E 0 0 1 CochainComplex.prev_nat_zero
        (CochainComplex.next ℕ 0), ShortComplex.exact_iff_exact_up_to_refinements]
      intro A x hx
      refine ⟨A, 𝟙 A, inferInstance, 0, ?_⟩
      change x ≫ E.d 0 1 = 0 at hx
      rw [hEd0] at hx
      rw [Category.id_comp, Limits.zero_comp]
      exact key0 x hx
    | succ n =>
      rw [HomologicalComplex.exactAt_iff' E n (n + 1) (n + 1 + 1) (CochainComplex.prev_nat_succ n)
        (CochainComplex.next ℕ (n + 1)), ShortComplex.exact_iff_exact_up_to_refinements]
      intro A x hx
      change x ≫ E.d (n + 1) (n + 1 + 1) = 0 at hx
      rw [hEd (n + 1)] at hx
      refine ⟨A, 𝟙 A, inferInstance,
        x ≫ (Limits.biprod.snd : Q (n + 1 + 1) ⊞ Q (n + 1) ⟶ Q (n + 1)) ≫
          (Limits.biprod.inl : Q (n + 1) ⟶ Q (n + 1) ⊞ Q n), ?_⟩
      change 𝟙 A ≫ x = _ ≫ E.d n (n + 1)
      rw [hEd n, Category.id_comp]
      exact keyS n x hx
  have hEz : ∀ n, Limits.IsZero (E.homology n) :=
    fun n => (E.exactAt_iff_isZero_homology n).1 (hEex n)

  have hqi : QuasiIso (Limits.biprod.inl : J.cocomplex ⟶ J.cocomplex ⊞ E) := by
    rw [quasiIso_iff]
    intro n
    rw [quasiIsoAt_iff_isIso_homologyMap]
    refine ⟨⟨HomologicalComplex.homologyMap
      (Limits.biprod.fst : J.cocomplex ⊞ E ⟶ J.cocomplex) n, ?_, ?_⟩⟩
    · rw [← HomologicalComplex.homologyMap_comp, Limits.biprod.inl_fst,
        HomologicalComplex.homologyMap_id]
    · have htot : (Limits.biprod.fst : J.cocomplex ⊞ E ⟶ J.cocomplex) ≫ Limits.biprod.inl =
          𝟙 _ - Limits.biprod.snd ≫ Limits.biprod.inr :=
        eq_sub_of_add_eq Limits.biprod.total
      rw [← HomologicalComplex.homologyMap_comp, htot, HomologicalComplex.homologyMap_sub,
        HomologicalComplex.homologyMap_id, HomologicalComplex.homologyMap_comp,
        (hEz n).eq_of_tgt (HomologicalComplex.homologyMap
          (Limits.biprod.snd : J.cocomplex ⊞ E ⟶ E) n) 0, Limits.zero_comp, sub_zero]
  have hqi' : QuasiIso (J.ι ≫ (Limits.biprod.inl : J.cocomplex ⟶ J.cocomplex ⊞ E)) := by
    haveI := hqi
    haveI := J.quasiIso
    infer_instance
  have hinj : ∀ n, Injective ((J.cocomplex ⊞ E).X n) := fun n => by
    haveI := J.injective n
    haveI := hEinj n
    exact Injective.of_iso (HomologicalComplex.biprodXIso J.cocomplex E n).symm inferInstance

  let φ : K ⟶ E := ({
      f := fun n => Limits.biprod.lift (K.d n (n + 1) ≫ b (n + 1)) (b n)
      comm' := by
        rintro i j (rfl : i + 1 = j)
        show Limits.biprod.lift (K.d i (i + 1) ≫ b (i + 1)) (b i) ≫ E.d i (i + 1) =
          K.d i (i + 1) ≫ Limits.biprod.lift (K.d (i + 1) (i + 1 + 1) ≫ b (i + 1 + 1)) (b (i + 1))
        rw [hEd i]
        apply Limits.biprod.hom_ext <;> simp } : HomologicalComplex.Hom K E)
  have hφfst : ∀ n, φ.f n ≫ (Limits.biprod.fst : Q (n + 1) ⊞ Q n ⟶ Q (n + 1)) =
      K.d n (n + 1) ≫ b (n + 1) := fun n => Limits.biprod.lift_fst _ _
  have hφsnd : ∀ n, φ.f n ≫ (Limits.biprod.snd : Q (n + 1) ⊞ Q n ⟶ Q n) = b n :=
    fun n => Limits.biprod.lift_snd _ _
  have hφm : ∀ n, Mono (φ.f (n + 1)) := fun n => by
    haveI := hbm n
    exact mono_of_mono_fac (hφsnd (n + 1))
  have heφ : e ≫ φ = 0 := by
    apply HomologicalComplex.from_single_hom_ext
    rw [HomologicalComplex.comp_f, HomologicalComplex.zero_f_apply]
    refine Limits.biprod.hom_ext (X := Q (0 + 1)) (Y := Q 0) _ _ ?_ ?_
    · have hz' : e.f 0 ≫ K.d 0 (0 + 1) = 0 := hz
      rw [Category.assoc, hφfst 0, ← Category.assoc, hz', Limits.zero_comp, Limits.zero_comp]
    · exact hQ0.eq_of_tgt _ _
  refine ⟨InjectiveResolution.mk (Z := M) (cocomplex := J.cocomplex ⊞ E) (injective := hinj)
      (ι := J.ι ≫ Limits.biprod.inl) (quasiIso := hqi'), Limits.biprod.lift χ φ, ?_, ?_⟩
  · show e ≫ Limits.biprod.lift χ φ = J.ι ≫ Limits.biprod.inl
    apply Limits.biprod.hom_ext
    · rw [Category.assoc, Limits.biprod.lift_fst, hχ, Category.assoc, Limits.biprod.inl_fst,
        Category.comp_id]
    · rw [Category.assoc, Limits.biprod.lift_snd, heφ, Category.assoc, Limits.biprod.inl_snd,
        Limits.comp_zero]
  · intro k
    show Mono ((Limits.biprod.lift χ φ : K ⟶ J.cocomplex ⊞ E).f k)
    apply Preadditive.mono_of_cancel_zero
    intro W g hg
    have h1 : g ≫ χ.f k = 0 := by
      have := hg =≫ (Limits.biprod.fst : J.cocomplex ⊞ E ⟶ J.cocomplex).f k
      rwa [Limits.zero_comp, Category.assoc, ← HomologicalComplex.comp_f,
        Limits.biprod.lift_fst] at this
    have h2 : g ≫ φ.f k = 0 := by
      have := hg =≫ (Limits.biprod.snd : J.cocomplex ⊞ E ⟶ E).f k
      rwa [Limits.zero_comp, Category.assoc, ← HomologicalComplex.comp_f,
        Limits.biprod.lift_snd] at this
    cases k with
    | zero =>
      have h3 : g ≫ K.d 0 1 = 0 := by
        haveI := hbm 0
        apply Limits.zero_of_comp_mono (b (0 + 1))
        have := h2 =≫ (Limits.biprod.fst : Q (0 + 1) ⊞ Q 0 ⟶ Q (0 + 1))
        rwa [Limits.zero_comp, Category.assoc, hφfst 0, ← Category.assoc] at this
      haveI : Mono (ShortComplex.mk (e.f 0) (K.d 0 1) hz).f := he
      obtain ⟨g', hlift⟩ : ∃ g' : W ⟶ ((CochainComplex.single₀ C).obj M).X 0, g' ≫ e.f 0 = g :=
        ⟨hS.lift g h3, hS.lift_f g h3⟩
      have h4 : g' ≫ J.ι.f 0 = 0 := by
        rw [← hχ, HomologicalComplex.comp_f, ← Category.assoc, hlift, h1]
      have h5 : g' = 0 := Limits.zero_of_comp_mono _ h4
      rw [← hlift, h5, Limits.zero_comp]
    | succ n =>
      haveI := hφm n
      exact Limits.zero_of_comp_mono _ h2

theorem wc_rdsc_cokernel_exact_of_mono_quasiIso : ∀ {C : Type*} [Category C] [Abelian C] (K L : CochainComplex C ℕ) (χ : K ⟶ L), (∀ k, Mono (χ.f k)) → QuasiIso χ → ∀ k, (Limits.cokernel χ).ExactAt k :=
by
  intro C _ _ K L χ hmono hq k
  have hS : (ShortComplex.mk χ (Limits.cokernel.π χ) (Limits.cokernel.condition χ)).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel χ)
      (HomologicalComplex.mono_of_mono_f χ hmono) inferInstance
  have hiso : ∀ i, IsIso (HomologicalComplex.homologyMap χ i) :=
    fun i => (quasiIsoAt_iff_isIso_homologyMap χ i).1 (hq.quasiIsoAt i)
  have h3 := (hS.homology_exact₂ k).epi_f_iff.1 (by have := hiso k; exact inferInstance)
  have h4 := (hS.homology_exact₁ k (k+1) rfl).mono_g_iff.1
    (by have := hiso (k+1); exact inferInstance)
  exact (HomologicalComplex.exactAt_iff_isZero_homology _ k).2
    ((hS.homology_exact₃ k (k+1) rfl).isZero_X₂ h3 h4)

theorem wc_rdsc_acyclic_exact_map : ∀ {C D : Type*} [Category C] [Category D] [Abelian C] [Abelian D] [HasInjectiveResolutions C] (R : C ⥤ D) [R.Additive] [Limits.PreservesFiniteLimits R], (∀ (S : ShortComplex C), S.ShortExact → (∀ (q : ℕ) {X Y : C} (a b : X ⟶ Y), (R.rightDerived q).map (a - b) = (R.rightDerived q).map a - (R.rightDerived q).map b) ∧ Mono ((R.rightDerived 0).map S.f) ∧ ∀ q : ℕ, (∃ h0 : (R.rightDerived q).map S.f ≫ (R.rightDerived q).map S.g = 0, (ShortComplex.mk _ _ h0).Exact) ∧ ∃ (δ : (R.rightDerived q).obj S.X₃ ⟶ (R.rightDerived (q + 1)).obj S.X₁) (h1 : (R.rightDerived q).map S.g ≫ δ = 0) (h2 : δ ≫ (R.rightDerived (q + 1)).map S.f = 0), (ShortComplex.mk _ _ h1).Exact ∧ (ShortComplex.mk _ _ h2).Exact) → ∀ (L : CochainComplex C ℕ), (∀ k, L.ExactAt k) → (∀ k i, Limits.IsZero ((R.rightDerived (i + 1)).obj (L.X k))) → ∀ k, ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj L).ExactAt k :=
by
  intro C D _ _ _ _ _ R _ _ H L hex hacyc

  have hmono0 : Mono (L.d 0 1) := by
    have h := (HomologicalComplex.exactAt_iff' L 0 0 1 (by simp) (by simp)).1 (hex 0)
    exact (ShortComplex.exact_iff_mono _ (L.shape 0 0 (by simp))).1 h

  have hexs : ∀ k, (L.sc' k (k + 1) (k + 1 + 1)).Exact := fun k =>
    (HomologicalComplex.exactAt_iff' L k (k + 1) (k + 1 + 1) (by simp) (by simp)).1 (hex (k + 1))

  have hses : ∀ k, ∃ hz : Limits.kernel.ι (L.d k (k + 1)) ≫
      Limits.kernel.lift (L.d (k + 1) (k + 1 + 1)) (L.d k (k + 1)) (L.d_comp_d _ _ _) = 0,
      (ShortComplex.mk _ _ hz).ShortExact := by
    intro k
    have hz : Limits.kernel.ι (L.d k (k + 1)) ≫
        Limits.kernel.lift (L.d (k + 1) (k + 1 + 1)) (L.d k (k + 1)) (L.d_comp_d _ _ _) = 0 := by
      rw [← cancel_mono (Limits.kernel.ι (L.d (k + 1) (k + 1 + 1)))]
      simp
    refine ⟨hz, ShortComplex.ShortExact.mk' ?_ inferInstance ((hexs k).epi_kernelLift)⟩
    let φ : ShortComplex.mk _ _ hz ⟶ ShortComplex.mk (Limits.kernel.ι (L.d k (k + 1)))
        (L.d k (k + 1)) (Limits.kernel.condition _) :=
      { τ₁ := 𝟙 _
        τ₂ := 𝟙 _
        τ₃ := Limits.kernel.ι (L.d (k + 1) (k + 1 + 1))
        comm₁₂ := by simp
        comm₂₃ := by simp }
    have : Mono φ.τ₃ := by dsimp [φ]; infer_instance
    have : IsIso φ.τ₂ := by dsimp [φ]; infer_instance
    have : Epi φ.τ₁ := by dsimp [φ]; infer_instance
    exact (ShortComplex.exact_iff_of_epi_of_isIso_of_mono φ).2 (ShortComplex.exact_kernel _)

  have hZ : ∀ k i, Limits.IsZero ((R.rightDerived (i + 1)).obj (Limits.kernel (L.d k (k + 1)))) := by
    intro k
    induction k with
    | zero =>
      intro i
      have : Mono (L.d 0 (0 + 1)) := hmono0
      have : Injective (Limits.kernel (L.d 0 (0 + 1))) :=
        (Limits.isZero_kernel_of_mono (L.d 0 (0 + 1))).injective
      exact R.isZero_rightDerived_obj_injective_succ i _
    | succ k ih =>
      intro i
      obtain ⟨hz, hS⟩ := hses k
      obtain ⟨-, -, hq⟩ := H _ hS
      obtain ⟨-, δ, h1, -, hE, -⟩ := hq (i + 1)
      exact hE.isZero_X₂ ((hacyc k i).eq_of_src _ _) ((ih (i + 1)).eq_of_tgt _ _)

  have epi_transport : ∀ {X Y : C} (g : X ⟶ Y), Epi ((R.rightDerived 0).map g) → Epi (R.map g) := by
    intro X Y g hg
    have key : R.map g = (R.rightDerivedZeroIsoSelf.app X).inv ≫ (R.rightDerived 0).map g ≫
        (R.rightDerivedZeroIsoSelf.app Y).hom := by simp
    rw [key]
    infer_instance
  have hepi : ∀ k, Epi (R.map (Limits.kernel.lift (L.d (k + 1) (k + 1 + 1)) (L.d k (k + 1))
      (L.d_comp_d _ _ _))) := by
    intro k
    obtain ⟨hz, hS⟩ := hses k
    obtain ⟨-, -, hq⟩ := H _ hS
    obtain ⟨-, δ, h1, -, hE, -⟩ := hq 0
    exact epi_transport _ (hE.epi_f ((hZ k 0).eq_of_tgt _ _))

  intro k
  cases k with
  | zero =>
    rw [HomologicalComplex.exactAt_iff' _ 0 0 1 (by simp) (by simp)]
    refine (ShortComplex.exact_iff_mono _
      (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj L).shape 0 0 (by simp))).2 ?_
    change Mono (R.map (L.d 0 1))
    infer_instance
  | succ k =>
    rw [HomologicalComplex.exactAt_iff' _ k (k + 1) (k + 1 + 1) (by simp) (by simp)]
    have hS2 := (ShortComplex.exact_kernel (L.d (k + 1) (k + 1 + 1))).map_of_mono_of_preservesKernel R
      (by dsimp only; infer_instance) (by dsimp only; infer_instance)
    let φ : ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj L).sc' k (k + 1) (k + 1 + 1) ⟶
        (ShortComplex.mk (Limits.kernel.ι (L.d (k + 1) (k + 1 + 1))) (L.d (k + 1) (k + 1 + 1))
          (Limits.kernel.condition _)).map R :=
      { τ₁ := R.map (Limits.kernel.lift (L.d (k + 1) (k + 1 + 1)) (L.d k (k + 1)) (L.d_comp_d _ _ _))
        τ₂ := 𝟙 _
        τ₃ := 𝟙 _
        comm₁₂ := by
          show R.map _ ≫ R.map _ = R.map _ ≫ 𝟙 _
          rw [← R.map_comp, Limits.kernel.lift_ι, Category.comp_id]
        comm₂₃ := by
          show 𝟙 _ ≫ R.map _ = R.map _ ≫ 𝟙 _
          simp }
    have : Epi φ.τ₁ := hepi k
    have : IsIso φ.τ₂ := by change IsIso (𝟙 (R.obj (L.X (k + 1)))); infer_instance
    have : Mono φ.τ₃ := by change Mono (𝟙 (R.obj (L.X (k + 1 + 1)))); infer_instance
    exact (ShortComplex.exact_iff_of_epi_of_isIso_of_mono φ).2 hS2

theorem wc_rdsc_quasiIso_map_of_acyclic : ∀ {C D : Type*} [Category C] [Category D] [Abelian C] [Abelian D] [HasInjectiveResolutions C] (R : C ⥤ D) [R.Additive] [Limits.PreservesFiniteLimits R], (∀ (S : ShortComplex C), S.ShortExact → (∀ (q : ℕ) {X Y : C} (a b : X ⟶ Y), (R.rightDerived q).map (a - b) = (R.rightDerived q).map a - (R.rightDerived q).map b) ∧ Mono ((R.rightDerived 0).map S.f) ∧ ∀ q : ℕ, (∃ h0 : (R.rightDerived q).map S.f ≫ (R.rightDerived q).map S.g = 0, (ShortComplex.mk _ _ h0).Exact) ∧ ∃ (δ : (R.rightDerived q).obj S.X₃ ⟶ (R.rightDerived (q + 1)).obj S.X₁) (h1 : (R.rightDerived q).map S.g ≫ δ = 0) (h2 : δ ≫ (R.rightDerived (q + 1)).map S.f = 0), (ShortComplex.mk _ _ h1).Exact ∧ (ShortComplex.mk _ _ h2).Exact) → (∀ (L : CochainComplex C ℕ), (∀ k, L.ExactAt k) → (∀ k i, Limits.IsZero ((R.rightDerived (i + 1)).obj (L.X k))) → ∀ k, ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj L).ExactAt k) → (∀ (K L : CochainComplex C ℕ) (χ : K ⟶ L), (∀ k, Mono (χ.f k)) → QuasiIso χ → ∀ k, (Limits.cokernel χ).ExactAt k) → ∀ (M : C) (K : CochainComplex C ℕ) (e : (CochainComplex.single₀ C).obj M ⟶ K), QuasiIso e → (∀ k i, Limits.IsZero ((R.rightDerived (i + 1)).obj (K.X k))) → ∀ (J : InjectiveResolution M) (χ : K ⟶ J.cocomplex), e ≫ χ = J.ι → (∀ k, Mono (χ.f k)) → ∀ q, IsIso (HomologicalComplex.homologyMap ((R.mapHomologicalComplex (ComplexShape.up ℕ)).map χ) q) :=
by
  intro C D _ _ _ _ _ R _ _ hLES hEx hCok M K e he hK J χ hχ hmono q

  have c1 : ∀ (S : ShortComplex (CochainComplex D ℕ)), S.ShortExact → (∀ k, S.X₃.ExactAt k) →
      ∀ q, IsIso (HomologicalComplex.homologyMap S.f q) := by
    intro S hS h3 q
    have hepi : Epi (HomologicalComplex.homologyMap S.f q) := by
      apply (hS.homology_exact₂ q).epi_f
      exact ((HomologicalComplex.exactAt_iff_isZero_homology _ q).1 (h3 q)).eq_of_tgt _ _
    have hmo : Mono (HomologicalComplex.homologyMap S.f q) := by
      cases q with
      | zero =>
        haveI : Mono S.f := hS.mono_f
        apply HomologicalComplex.mono_homologyMap_of_mono_of_not_rel
        intro i h
        simp at h
      | succ p =>
        apply (hS.homology_exact₁ p (p + 1) rfl).mono_g
        exact ((HomologicalComplex.exactAt_iff_isZero_homology _ p).1 (h3 p)).eq_of_src _ _
    exact isIso_of_mono_of_epi _

  have c2 : ∀ (S : ShortComplex C), S.ShortExact →
      (∀ i, Limits.IsZero ((R.rightDerived (i + 1)).obj S.X₁)) →
      (∀ i, Limits.IsZero ((R.rightDerived (i + 1)).obj S.X₂)) →
      ∀ i, Limits.IsZero ((R.rightDerived (i + 1)).obj S.X₃) := by
    intro S hS h1 h2 i
    obtain ⟨-, -, hq⟩ := hLES S hS
    obtain ⟨-, δ, hδ1, hδ2, hex1, -⟩ := hq (i + 1)
    exact hex1.isZero_X₂ ((h2 i).eq_of_src _ _) ((h1 (i + 1)).eq_of_tgt _ _)

  have c3 : ∀ (S : ShortComplex C), S.ShortExact → Limits.IsZero ((R.rightDerived 1).obj S.X₁) →
      (S.map R).ShortExact := by
    intro S hS h1
    haveI := hS.mono_f
    have hexR : (S.map R).Exact := hS.exact.map_of_mono_of_preservesKernel R hS.mono_f inferInstance
    obtain ⟨-, -, hq⟩ := hLES S hS
    obtain ⟨-, δ, hδ1, hδ2, hex1, -⟩ := hq 0
    have hepi0 : Epi ((R.rightDerived 0).map S.g) := hex1.epi_f (h1.eq_of_tgt _ _)
    have hnat := R.rightDerivedZeroIsoSelf.hom.naturality S.g
    have hep : Epi (R.rightDerivedZeroIsoSelf.hom.app S.X₂ ≫ R.map S.g) := by
      rw [← hnat]; infer_instance
    haveI : Epi (R.map S.g) := epi_of_epi (R.rightDerivedZeroIsoSelf.hom.app S.X₂) (R.map S.g)
    exact ShortComplex.ShortExact.mk' hexR (show Mono (R.map S.f) from inferInstance)
      (show Epi (R.map S.g) from inferInstance)

  have c4 : ∀ (S : ShortComplex (CochainComplex C ℕ)),
      (∀ k, ((S.map (HomologicalComplex.eval C (ComplexShape.up ℕ) k)).map R).ShortExact) →
      (S.map (R.mapHomologicalComplex (ComplexShape.up ℕ))).ShortExact := by
    intro S h
    apply HomologicalComplex.shortExact_of_degreewise_shortExact
    intro k
    exact h k

  haveI := he
  have hχq : QuasiIso χ := by
    have h1 : QuasiIso (e ≫ χ) := by rw [hχ]; exact J.quasiIso
    exact (quasiIso_iff_comp_left e χ).1 h1
  haveI : Mono χ := HomologicalComplex.mono_of_mono_f χ hmono
  let S : ShortComplex (CochainComplex C ℕ) :=
    ShortComplex.mk χ (Limits.cokernel.π χ) (Limits.cokernel.condition χ)
  have hS : S.ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel χ) inferInstance inferInstance
  have hSk : ∀ k, (S.map (HomologicalComplex.eval C (ComplexShape.up ℕ) k)).ShortExact :=
    fun k => (HomologicalComplex.shortExact_iff_degreewise_shortExact S).1 hS k
  have hQex := hCok K J.cocomplex χ hmono hχq
  have hQac : ∀ k i, Limits.IsZero ((R.rightDerived (i + 1)).obj ((Limits.cokernel χ).X k)) := by
    intro k
    haveI := J.injective k
    exact c2 _ (hSk k) (fun i => hK k i)
      (fun i => Functor.isZero_rightDerived_obj_injective_succ R i (J.cocomplex.X k))
  have hRQ := hEx _ hQex hQac
  have hRS : (S.map (R.mapHomologicalComplex (ComplexShape.up ℕ))).ShortExact :=
    c4 S (fun k => c3 _ (hSk k) (hK k 0))
  exact c1 _ hRS hRQ q

theorem wc_rdsc_rightDerived_cocone_of_comparison : ∀ {C D : Type*} [Category C] [Category D] [Abelian C] [Abelian D] [HasInjectiveResolutions C] (R : C ⥤ D) [R.Additive] (G : ℕ ⥤ C) (c : Limits.Cocone G) (X : ℕ ⥤ CochainComplex C ℕ) (ε : G ⋙ CochainComplex.single₀ C ⟶ X), (∀ n k, Injective ((X.obj n).X k)) → (∀ n, QuasiIso (ε.app n)) → ∀ (s : Limits.Cocone X) (ε' : (CochainComplex.single₀ C).obj c.pt ⟶ s.pt), (∀ n, ε.app n ≫ s.ι.app n = (CochainComplex.single₀ C).map (c.ι.app n) ≫ ε') → ∀ (J : InjectiveResolution c.pt) (χ : s.pt ⟶ J.cocomplex), ε' ≫ χ = J.ι → ∀ q : ℕ, IsIso (HomologicalComplex.homologyMap ((R.mapHomologicalComplex (ComplexShape.up ℕ)).map χ) q) → Limits.IsColimit ((HomologicalComplex.homologyFunctor D (ComplexShape.up ℕ) q).mapCocone ((R.mapHomologicalComplex (ComplexShape.up ℕ)).mapCocone s)) → Nonempty (Limits.IsColimit ((R.rightDerived q).mapCocone c)) :=
by
  intro C D _ _ _ _ _ R _ G c X ε hX hε s ε' hleg J χ hχ q hiso hcol
  let P : ∀ n, InjectiveResolution (G.obj n) := fun n =>
    { cocomplex := X.obj n, ι := ε.app n, injective := hX n, quasiIso := hε n }
  have hnat : ∀ (n m : ℕ) (u : n ⟶ m),
      (R.rightDerived q).map (G.map u) ≫ ((P m).isoRightDerivedObj R q).hom =
        ((P n).isoRightDerivedObj R q).hom ≫
          (R.mapHomologicalComplex (ComplexShape.up ℕ) ⋙
            HomologicalComplex.homologyFunctor D (ComplexShape.up ℕ) q).map (X.map u) := by
    intro n m u
    apply InjectiveResolution.isoRightDerivedObj_hom_naturality
    have h := congrArg (fun h => HomologicalComplex.Hom.f h 0) (ε.naturality u)
    simp only [HomologicalComplex.comp_f, Functor.comp_map] at h
    rw [CochainComplex.single₀_map_f_zero] at h
    exact h.symm
  let α : G ⋙ R.rightDerived q ≅ (X ⋙ R.mapHomologicalComplex (ComplexShape.up ℕ)) ⋙
      HomologicalComplex.homologyFunctor D (ComplexShape.up ℕ) q :=
    NatIso.ofComponents (fun n => (P n).isoRightDerivedObj R q) (fun {n m} u => hnat n m u)
  let φ : (HomologicalComplex.homologyFunctor D (ComplexShape.up ℕ) q).obj
      ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj s.pt) ≅ (R.rightDerived q).obj c.pt :=
    @asIso _ _ _ _ (HomologicalComplex.homologyMap
      ((R.mapHomologicalComplex (ComplexShape.up ℕ)).map χ) q) hiso ≪≫
      (J.isoRightDerivedObj R q).symm
  have hleg' : ∀ n, (R.rightDerived q).map (c.ι.app n) =
      ((P n).isoRightDerivedObj R q).hom ≫
        (R.mapHomologicalComplex (ComplexShape.up ℕ) ⋙
          HomologicalComplex.homologyFunctor D (ComplexShape.up ℕ) q).map (s.ι.app n ≫ χ) ≫
        (J.isoRightDerivedObj R q).inv := by
    intro n
    apply Functor.rightDerived_map_eq
    show ε.app n ≫ s.ι.app n ≫ χ = _
    rw [← Category.assoc, hleg n, Category.assoc, hχ]
  have key : ∀ n, (((P n).isoRightDerivedObj R q).hom ≫
      HomologicalComplex.homologyMap ((R.mapHomologicalComplex (ComplexShape.up ℕ)).map (s.ι.app n)) q) ≫
      (HomologicalComplex.homologyMap ((R.mapHomologicalComplex (ComplexShape.up ℕ)).map χ) q ≫
        (J.isoRightDerivedObj R q).inv) = (R.rightDerived q).map (c.ι.app n) := by
    intro n
    rw [hleg' n]
    simp only [Functor.comp_map, Functor.map_comp, HomologicalComplex.homologyFunctor_map,
      HomologicalComplex.homologyMap_comp]
    exact (Category.assoc _ _ _).trans (congrArg (_ ≫ ·) (Category.assoc _ _ _).symm)
  let e : (Limits.Cocone.precompose α.symm.inv).obj
      ((HomologicalComplex.homologyFunctor D (ComplexShape.up ℕ) q).mapCocone
        ((R.mapHomologicalComplex (ComplexShape.up ℕ)).mapCocone s)) ≅
      (R.rightDerived q).mapCocone c :=
    Limits.Cocone.ext φ (fun n => key n)
  exact ⟨(Limits.IsColimit.equivOfNatIsoOfIso α.symm _ _ e) hcol⟩

theorem wc_rightDerived_preserves_seq_colimit : ∀ {C D : Type*} [Category C] [Category D] [Abelian C] [Abelian D] [EnoughInjectives C] [Limits.HasColimitsOfShape ℕ C] [HasExactColimitsOfShape ℕ C] [Limits.HasColimitsOfShape ℕ D] [HasExactColimitsOfShape ℕ D] (R : C ⥤ D) [R.Additive] [Limits.PreservesFiniteLimits R], (∀ (G : ℕ ⥤ C) (c : Limits.Cocone G), Limits.IsColimit c → Nonempty (Limits.IsColimit (R.mapCocone c))) → (∀ (I : ℕ ⥤ C), (∀ n, Injective (I.obj n)) → ∀ (c : Limits.Cocone I), Limits.IsColimit c → ∀ k : ℕ, Limits.IsZero ((R.rightDerived (k + 1)).obj c.pt)) → ∀ (G : ℕ ⥤ C) (c : Limits.Cocone G), Limits.IsColimit c → ∀ q : ℕ, Nonempty (Limits.IsColimit ((R.rightDerived q).mapCocone c)) :=
by
  intro C D _ _ _ _ _ _ _ _ _ R _ _ H1 H2 G c hc q
  haveI : HasInjectiveResolutions C := inferInstance
  have LES := fun (S : ShortComplex C) (hS : S.ShortExact) => wc_rightDerived_les_package R S hS
  obtain ⟨I, β, d, hIinj, hβ, h0, hd⟩ := wc_rdsc_injective_tower_resolution_data G
  obtain ⟨X, ε, hXinj, hpt⟩ := wc_rdsc_tower_to_functor_resolution G I β d hIinj hβ h0 hd
  have hεq : ∀ n, QuasiIso (ε.app n) := fun n =>
    (wc_rdsc_quasiIso_single0_iff (G.obj n) (X.obj n) (ε.app n)).2 (hpt n)
  let s := Limits.colimit.cocone X
  have hs : ∀ k, Limits.IsColimit ((HomologicalComplex.eval C (ComplexShape.up ℕ) k).mapCocone s) :=
    fun k => Limits.isColimitOfPreserves _ (Limits.colimit.isColimit X)
  obtain ⟨ε', hε'q, hleg⟩ := wc_rdsc_colimit_resolution
    (fun Y t ht q => wc_rdsc_homology_seq_colimit Y t ht q) G X ε hεq c hc s hs
  obtain ⟨hm0, hex0, hexs⟩ := (wc_rdsc_quasiIso_single0_iff c.pt s.pt ε').1 hε'q
  obtain ⟨χ₀, hχ₀⟩ := wc_rdsc_lift_to_injective_resolution c.pt s.pt ε' hm0 hex0 hexs
    (injectiveResolution c.pt)
  obtain ⟨J, χ, hχ, hmono⟩ := wc_rdsc_mono_replacement c.pt s.pt ε' hm0 hex0 _ χ₀ hχ₀
  have hacyc : ∀ k i, Limits.IsZero ((R.rightDerived (i + 1)).obj (s.pt.X k)) := fun k i =>
    H2 (X ⋙ HomologicalComplex.eval C (ComplexShape.up ℕ) k) (fun n => hXinj n k) _ (hs k) i
  have hiso := wc_rdsc_quasiIso_map_of_acyclic R LES (wc_rdsc_acyclic_exact_map R LES)
    (fun K L χ h1 h2 => wc_rdsc_cokernel_exact_of_mono_quasiIso K L χ h1 h2)
    c.pt s.pt ε' hε'q hacyc J χ hχ hmono q

  have hRs : ∀ k, Limits.IsColimit ((HomologicalComplex.eval D (ComplexShape.up ℕ) k).mapCocone
      ((R.mapHomologicalComplex (ComplexShape.up ℕ)).mapCocone s)) := fun k =>
    (H1 _ _ (hs k)).some.ofIsoColimit (Limits.Cocones.ext (Iso.refl _) (fun n => by simp))
  have hD := wc_rdsc_homology_seq_colimit (X ⋙ R.mapHomologicalComplex (ComplexShape.up ℕ))
    ((R.mapHomologicalComplex (ComplexShape.up ℕ)).mapCocone s) hRs q
  exact wc_rdsc_rightDerived_cocone_of_comparison R G c X ε hXinj hεq s ε' hleg J χ hχ q hiso hD.some

theorem wc_proet_push_preserves_seq_colimit : ∀ {X B : Scheme.{u}} (g : X ⟶ B) [QuasiCompact g] [QuasiSeparated g] (G : ℕ ⥤ Sheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}) (c : Limits.Cocone G), Limits.IsColimit c → Nonempty (Limits.IsColimit ((wcProEtPush g).mapCocone c)) :=
by
  intro X B g _ _ G c hc

  have hcov : ∀ (V : B.ProEt) (R : Sieve V),
      (∀ (W : B.ProEt) (h : W ⟶ V), IsAffine W.left → R.arrows h) →
      R ∈ Scheme.ProEt.topology B V := by
    intro V R hR
    classical
    haveI : WeaklyEtale V.hom := V.prop
    have h0 : Presieve.ofArrows V.left.affineCover.X V.left.affineCover.f ∈
        Scheme.proetalePrecoverage.coverings V.left :=
      ⟨Scheme.zariskiPrecoverage_le_qcPrecoverage V.left V.left.affineCover.mem₀,
       (Scheme.ofArrows_mem_precoverage_iff _).2
         ⟨fun x => ⟨_, V.left.affineCover.covers x⟩, fun i => inferInstance⟩⟩
    let W : V.left.affineCover.I₀ → B.ProEt := fun i =>
      Scheme.ProEt.mk (V.left.affineCover.f i ≫ V.hom)
    let a : ∀ i, W i ⟶ V := fun i =>
      MorphismProperty.Over.homMk (A := W i) (B := V) (V.left.affineCover.f i) rfl trivial
    have hmem' : Presieve.ofArrows W a ∈
        (Scheme.proetalePrecoverage.comap (Scheme.ProEt.forget B ⋙ Over.forget B)).coverings V := by
      rw [Precoverage.mem_comap_iff, Presieve.map_ofArrows]
      exact h0
    have hmem : Presieve.ofArrows W a ∈ (Scheme.ProEt.precoverage B).coverings V := hmem'
    refine GrothendieckTopology.superset_covering _ ?_
      (Precoverage.generate_mem_toGrothendieck hmem)
    rw [Sieve.generate_le_iff]
    rintro _ _ ⟨i⟩
    exact hR _ _ (inferInstanceAs (IsAffine (V.left.affineCover.X i)))

  have hbc : ∀ V : B.ProEt, IsAffine V.left →
      CompactSpace ((wcProEtBaseChange g).obj V).left ∧
        QuasiSeparatedSpace ((wcProEtBaseChange g).obj V).left := by
    intro V hV
    have aux : ∀ (Y : Scheme.{u}) (f : Y ⟶ B) [IsAffine Y],
        CompactSpace ↥(Limits.pullback (C := Scheme.{u}) f g) ∧
          QuasiSeparatedSpace ↥(Limits.pullback (C := Scheme.{u}) f g) := by
      intro Y f _
      haveI : QuasiSeparatedSpace Y := quasiSeparatedSpace_of_isAffine Y
      exact ⟨QuasiCompact.compactSpace_of_compactSpace (Limits.pullback.fst f g),
        quasiSeparatedSpace_of_quasiSeparated (Limits.pullback.fst f g)⟩
    haveI : IsAffine V.left := hV
    exact aux V.left V.hom

  have hsec : ∀ (U : X.ProEt) [CompactSpace U.left] [QuasiSeparatedSpace U.left],
      (∀ s : c.pt.obj.obj (Opposite.op U), ∃ (n : ℕ) (t : (G.obj n).obj.obj (Opposite.op U)),
        (c.ι.app n).hom.app (Opposite.op U) t = s) ∧
      (∀ (n : ℕ) (t : (G.obj n).obj.obj (Opposite.op U)),
        (c.ι.app n).hom.app (Opposite.op U) t = 0 →
        ∃ (m : ℕ) (hnm : n ≤ m), (G.map (homOfLE hnm)).hom.app (Opposite.op U) t = 0) := by
    intro U _ _
    have hequiv : ∃ e : ∀ F : Sheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1},
        (wcFreeSheaf X U ⟶ F) ≃ F.obj.obj (Opposite.op U),
        (∀ (F F' : Sheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}) (φ : F ⟶ F')
          (g : wcFreeSheaf X U ⟶ F), e F' (g ≫ φ) = φ.hom.app (Opposite.op U) (e F g)) ∧
        (∀ F : Sheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}, e F 0 = 0) := by
      let e2 : ∀ G : X.ProEtᵒᵖ ⥤ AddCommGrpCat.{u+1},
          (yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free ⟶ G) ≃
            G.obj (Opposite.op U) :=
        fun G => ((Adjunction.whiskerRight X.ProEtᵒᵖ AddCommGrpCat.adj.{u+1}).homEquiv
            (yoneda.obj U ⋙ uliftFunctor.{u+1, u}) G).trans
            (uliftYonedaEquiv.{u+1} (X := U) (F := G ⋙ forget AddCommGrpCat.{u+1}))
      have hnat2 : ∀ (G G' : X.ProEtᵒᵖ ⥤ AddCommGrpCat.{u+1}) (ψ : G ⟶ G')
          (h : yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free ⟶ G),
          e2 G' (h ≫ ψ) = ψ.app (Opposite.op U) (e2 G h) := by
        intro G G' ψ h
        have hW := (Adjunction.whiskerRight X.ProEtᵒᵖ
          AddCommGrpCat.adj.{u+1}).homEquiv_naturality_right
          (X := yoneda.obj U ⋙ uliftFunctor.{u+1, u}) h ψ
        have hY := uliftYonedaEquiv_comp.{u+1}
          ((Adjunction.whiskerRight X.ProEtᵒᵖ AddCommGrpCat.adj.{u+1}).homEquiv
            (yoneda.obj U ⋙ uliftFunctor.{u+1, u}) G h)
          (((Functor.whiskeringRight X.ProEtᵒᵖ AddCommGrpCat.{u+1} (Type (u+1))).obj
              (forget AddCommGrpCat.{u+1})).map ψ)
        exact (congrArg (uliftYonedaEquiv.{u+1} (X := U)
          (F := G' ⋙ forget AddCommGrpCat.{u+1})) hW).trans hY
      let e : ∀ F : Sheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1},
          (wcFreeSheaf X U ⟶ F) ≃ F.obj.obj (Opposite.op U) := fun F =>
        ((sheafificationAdjunction (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}).homEquiv
            (yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) F).trans (e2 F.obj)
      have hnat : ∀ (F F' : Sheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}) (φ : F ⟶ F')
          (g : wcFreeSheaf X U ⟶ F), e F' (g ≫ φ) = φ.hom.app (Opposite.op U) (e F g) := by
        intro F F' φ g
        have hA := (sheafificationAdjunction (Scheme.ProEt.topology X)
          AddCommGrpCat.{u+1}).homEquiv_naturality_right
          (X := yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) g φ
        exact (congrArg (e2 F'.obj) hA).trans (hnat2 F.obj F'.obj φ.hom _)
      refine ⟨e, hnat, fun F => ?_⟩
      have h1 := hnat F F 0 0
      rw [Limits.zero_comp] at h1
      rw [h1]
      have h0 : (0 : F ⟶ F).hom = 0 :=
        (sheafToPresheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}).map_zero F F
      rw [h0, NatTrans.app_zero]
      rfl
    obtain ⟨e, he_nat, he_zero⟩ := hequiv
    obtain ⟨H0, H1⟩ := proet_free_hom_seq_colimit X U G c hc
    constructor
    · intro s
      obtain ⟨n, g', hg⟩ := H0 ((e c.pt).symm s)
      refine ⟨n, e (G.obj n) g', ?_⟩
      refine (he_nat (G.obj n) c.pt (c.ι.app n) g').symm.trans ?_
      rw [← hg]
      exact Equiv.apply_symm_apply _ _
    · intro n t ht
      obtain ⟨m, hnm, hm⟩ := H1 n ((e (G.obj n)).symm t) (by
        apply (e c.pt).injective
        rw [he_nat, Equiv.apply_symm_apply, ht, he_zero])
      refine ⟨m, hnm, ?_⟩
      have h2 := he_nat _ _ (G.map (homOfLE hnm)) ((e (G.obj n)).symm t)
      rw [hm, he_zero, Equiv.apply_symm_apply] at h2
      exact h2.symm

  have hs3 : ∀ (L : ℕ ⥤ ((B.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1})) (c : Limits.Cocone L),
      (∀ (V : B.ProEt), IsAffine V.left →
        (∀ s : c.pt.obj (Opposite.op V), ∃ (j : ℕ) (t : (L.obj j).obj (Opposite.op V)),
          ((c.ι.app j).app (Opposite.op V)).hom t = s) ∧
        (∀ (j : ℕ) (t : (L.obj j).obj (Opposite.op V)),
          ((c.ι.app j).app (Opposite.op V)).hom t = 0 →
          ∃ (k : ℕ) (f : j ⟶ k), ((L.map f).app (Opposite.op V)).hom t = 0)) →
      Nonempty (Limits.IsColimit
        ((presheafToSheaf (Scheme.ProEt.topology B) AddCommGrpCat.{u+1}).mapCocone c)) := by
    intro L c hyp
    have key : ∀ (j : ℕ) (X : (B.ProEt)ᵒᵖ) (y : (L.obj j).obj X),
        ((Limits.colimit.desc L c).app X).hom (((Limits.colimit.ι L j).app X).hom y) =
          ((c.ι.app j).app X).hom y := by
      intro j X y
      show ((Limits.colimit.ι L j ≫ Limits.colimit.desc L c).app X).hom y = _
      rw [Limits.colimit.ι_desc]
    have trans : ∀ (j k : ℕ) (f : j ⟶ k) (X : (B.ProEt)ᵒᵖ) (y : (L.obj j).obj X),
        ((Limits.colimit.ι L k).app X).hom (((L.map f).app X).hom y) =
          ((Limits.colimit.ι L j).app X).hom y := by
      intro j k f X y
      show ((L.map f ≫ Limits.colimit.ι L k).app X).hom y = _
      rw [Limits.colimit.w]
    letI : Limits.PreservesFilteredColimitsOfSize.{0, 0} (forget AddCommGrpCat.{u+1}) :=
      Limits.preservesFilteredColimitsOfSize_shrink.{0, u+1, 0, u+1} (forget AddCommGrpCat.{u+1})
    have rep : ∀ (X : (B.ProEt)ᵒᵖ) (x : (Limits.colimit L).obj X),
        ∃ (j : ℕ) (y : (L.obj j).obj X), ((Limits.colimit.ι L j).app X).hom y = x := by
      intro X x
      have hX := Limits.isColimitOfPreserves ((evaluation (B.ProEt)ᵒᵖ AddCommGrpCat.{u+1}).obj X)
        (Limits.colimit.isColimit L)
      obtain ⟨j, y, hy⟩ := Limits.Concrete.isColimit_exists_rep _ hX x
      exact ⟨j, y, hy⟩
    have bij : ∀ V : B.ProEt, IsAffine V.left →
        Function.Bijective ((Limits.colimit.desc L c).app (Opposite.op V)).hom := by
      intro V hV
      obtain ⟨ha, hb⟩ := hyp V hV
      constructor
      · rw [injective_iff_map_eq_zero]
        intro x hx
        obtain ⟨j, y, rfl⟩ := rep _ x
        rw [key] at hx
        obtain ⟨k, f, hf⟩ := hb j y hx
        rw [← trans j k f, hf, map_zero]
      · intro s
        obtain ⟨j, t, rfl⟩ := ha s
        exact ⟨_, key j _ t⟩
    have hiso : IsIso ((presheafToSheaf (Scheme.ProEt.topology B) AddCommGrpCat.{u+1}).map
        (Limits.colimit.desc L c)) := by
      rw [← GrothendieckTopology.W_iff, GrothendieckTopology.W_iff_isLocallyBijective]
      constructor
      · apply Presheaf.IsLocallyInjective.mk
        intro X x y hxy
        apply hcov
        intro V' h hV'
        rw [Presheaf.equalizerSieve_apply]
        apply (bij V' hV').1
        have e1 := NatTrans.naturality_apply (Limits.colimit.desc L c) h.op x
        have e2 := NatTrans.naturality_apply (Limits.colimit.desc L c) h.op y
        exact e1.trans ((congrArg _ hxy).trans e2.symm)
      · refine Presheaf.IsLocallySurjective.mk ?_
        intro U s
        apply hcov
        intro V' h hV'
        rw [Presheaf.imageSieve_apply]
        exact (bij V' hV').2 _
    have hC := Limits.isColimitOfPreserves
      (presheafToSheaf (Scheme.ProEt.topology B) AddCommGrpCat.{u+1})
      (Limits.colimit.isColimit L)
    have hE := Limits.IsColimit.extendIso
      ((presheafToSheaf (Scheme.ProEt.topology B) AddCommGrpCat.{u+1}).map
        (Limits.colimit.desc L c)) hC
    refine ⟨hE.ofIsoColimit (Limits.Cocone.ext (Iso.refl _) ?_)⟩
    intro j
    simp only [Limits.Cocone.extend_ι, NatTrans.comp_app, Functor.const_map_app,
      Functor.mapCocone_ι_app, Limits.colimit.cocone_ι, Iso.refl_hom, Category.comp_id,
      ← Functor.map_comp, Limits.colimit.ι_desc]

  obtain ⟨hE⟩ := hs3
    (G ⋙ (sheafToPresheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1} ⋙
      (Functor.whiskeringLeft (B.ProEt)ᵒᵖ (X.ProEt)ᵒᵖ AddCommGrpCat.{u+1}).obj
        (wcProEtBaseChange g).op))
    ((sheafToPresheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1} ⋙
      (Functor.whiskeringLeft (B.ProEt)ᵒᵖ (X.ProEt)ᵒᵖ AddCommGrpCat.{u+1}).obj
        (wcProEtBaseChange g).op).mapCocone c)
    (fun V hV => by
      obtain ⟨h1, h2⟩ := hbc V hV
      haveI := h1
      haveI := h2
      obtain ⟨S1, S2⟩ := hsec ((wcProEtBaseChange g).obj V)
      refine ⟨fun s => S1 s, fun j t ht => ?_⟩
      obtain ⟨m, hnm, hm⟩ := S2 j t ht
      exact ⟨m, homOfLE hnm, hm⟩)
  exact ⟨hE.ofIsoColimit (Functor.mapCoconeMapCocone c)⟩

theorem wc_proet_push_colim_injective_acyclic : ∀ {X B : Scheme.{u}} (g : X ⟶ B) [QuasiCompact g] [QuasiSeparated g] (I : ℕ ⥤ Sheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}), (∀ n, Injective (I.obj n)) → ∀ (c : Limits.Cocone I), Limits.IsColimit c → ∀ k : ℕ, Limits.IsZero (((wcProEtPush g).rightDerived (k + 1)).obj c.pt) :=
by
  intro X B g _ _ I hI c hc k

  have hS3 : ∀ (H : (B.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1}),
      (∀ V : B.ProEt, IsAffine V.left → ∀ x : H.obj (Opposite.op V), x = 0) →
      Limits.IsZero ((presheafToSheaf (Scheme.ProEt.topology B) AddCommGrpCat.{u+1}).obj H) := by
    intro H hH
    have hAff : ∀ W : B.ProEt, Sieve.generate (fun (W' : B.ProEt) (_ : W' ⟶ W) =>
        IsAffine W'.left ∧ True) ∈ Scheme.ProEt.topology B W :=
      fun W => wc_proet_cover_of_affine_local (fun _ => True)
        (fun V hV => ⟨V, 𝟙 V, hV, inferInstance, inferInstance, trivial⟩) W
    have hsec : ∀ (V : B.ProEt)
        (s : ((presheafToSheaf (Scheme.ProEt.topology B) AddCommGrpCat.{u+1}).obj H).obj.obj
          (Opposite.op V)), s = 0 := by
      intro V s
      let P := ((presheafToSheaf (Scheme.ProEt.topology B) AddCommGrpCat.{u+1}).obj H).obj
      have hsep : Presheaf.IsSeparated (Scheme.ProEt.topology B) P :=
        Presheaf.IsSheaf.isSeparated
          ((presheafToSheaf (Scheme.ProEt.topology B) AddCommGrpCat.{u+1}).obj H).property
      let T : Sieve V :=
        { arrows := fun W f => P.map f.op s = 0
          downward_closed := fun {W W'} f hf h => by
            change P.map (h ≫ f).op s = 0
            rw [op_comp, Functor.map_comp, ConcreteCategory.comp_apply]
            change P.map h.op (P.map f.op s) = 0
            rw [hf, map_zero] }
      have hT : T ∈ Scheme.ProEt.topology B V := by
        refine (Scheme.ProEt.topology B).transitive
          (Presheaf.imageSieve_mem (Scheme.ProEt.topology B)
            (toSheafify (Scheme.ProEt.topology B) H) (U := Opposite.op V) s) T ?_
        intro W f hf
        obtain ⟨t, ht⟩ := hf
        refine (Scheme.ProEt.topology B).superset_covering ?_ (hAff W)
        rw [Sieve.generate_le_iff]
        intro W'' h hh
        change P.map (h ≫ f).op s = 0
        rw [op_comp, Functor.map_comp, ConcreteCategory.comp_apply]
        change P.map h.op (P.map f.op s) = 0
        rw [← ht]
        rw [← NatTrans.naturality_apply (toSheafify (Scheme.ProEt.topology B) H) h.op t]
        rw [hH W'' hh.1 (H.map h.op t), map_zero]
      exact hsep V T hT s 0 (fun W f hf => by rw [map_zero]; exact hf)
    rw [Limits.IsZero.iff_id_eq_zero]
    apply Sheaf.hom_ext
    ext V s
    rw [hsec V.unop s, map_zero, map_zero]

  have hU : ∀ V : B.ProEt, IsAffine V.left →
      CompactSpace ((wcProEtBaseChange g).obj V).left ∧
        QuasiSeparatedSpace ((wcProEtBaseChange g).obj V).left := by
    intro V hV
    have := hV
    let f0 : V.left ⟶ B := @id (V.left ⟶ B) V.hom
    have h1 : QuasiCompact (Limits.pullback.fst f0 g) := inferInstance
    have h2 : QuasiSeparated (Limits.pullback.fst f0 g) := inferInstance
    have h3 : CompactSpace ↥(Limits.pullback f0 g : Scheme.{u}) :=
      @QuasiCompact.compactSpace_of_compactSpace _ _ (Limits.pullback.fst f0 g) h1 inferInstance
    have h4 : QuasiSeparatedSpace ↥(Limits.pullback f0 g : Scheme.{u}) :=
      @quasiSeparatedSpace_of_quasiSeparated _ _ (Limits.pullback.fst f0 g) inferInstance h2
    exact ⟨h3, h4⟩

  let J := injectiveResolution c.pt
  let PS := presheafToSheaf (Scheme.ProEt.topology B) AddCommGrpCat.{u+1}
  let Φ := sheafToPresheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1} ⋙
    (Functor.whiskeringLeft (B.ProEt)ᵒᵖ (X.ProEt)ᵒᵖ AddCommGrpCat.{u+1}).obj
      (wcProEtBaseChange g).op
  let K := (Φ.mapHomologicalComplex (ComplexShape.up ℕ)).obj J.cocomplex
  let S := K.sc' k (k + 1) (k + 2)
  refine Limits.IsZero.of_iso ?_ (J.isoRightDerivedObj (wcProEtPush g) (k + 1))
  change Limits.IsZero (((PS.mapHomologicalComplex (ComplexShape.up ℕ)).obj K).homology (k + 1))
  refine Limits.IsZero.of_iso ?_ (((PS.mapHomologicalComplex (ComplexShape.up ℕ)).obj K).homologyIsoSc'
    k (k + 1) (k + 2) (CochainComplex.prev_nat_succ k) (CochainComplex.next ℕ (k + 1)))
  change Limits.IsZero (S.map PS).homology
  refine Limits.IsZero.of_iso ?_ (S.mapHomologyIso PS)
  apply hS3
  intro V hV z
  let ev := (evaluation (B.ProEt)ᵒᵖ AddCommGrpCat.{u+1}).obj (Opposite.op V)
  have hz : Limits.IsZero (S.map ev).homology := by
    rw [← ShortComplex.exact_iff_isZero_homology, ShortComplex.ab_exact_iff]
    intro x hx
    obtain ⟨hc1, hc2⟩ := hU V hV
    obtain ⟨e, hnat, h0⟩ := proet_free_sheaf_hom_equiv X ((wcProEtBaseChange g).obj V)
    have hx' : ((J.cocomplex.d (k + 1) (k + 2)).hom.app
        (Opposite.op ((wcProEtBaseChange g).obj V))) x = 0 := hx
    let a := (e (J.cocomplex.X (k + 1))).symm x
    have hea : e (J.cocomplex.X (k + 1)) a = x := Equiv.apply_symm_apply _ _
    have ha : a ≫ J.cocomplex.d (k + 1) (k + 2) = 0 := by
      apply (e _).injective
      rw [hnat, h0, hea]
      exact hx'
    obtain ⟨b, hb⟩ := (J.extMk_eq_zero_iff a (k + 2) rfl ha k rfl).mp
      (proet_ext_colimit_injectives_vanish X ((wcProEtBaseChange g).obj V) I hI c hc k _)
    refine ⟨e (J.cocomplex.X k) b, ?_⟩
    change ((J.cocomplex.d k (k + 1)).hom.app (Opposite.op ((wcProEtBaseChange g).obj V)))
      (e _ b) = x
    rw [← hnat, hb, hea]
  have hz' : Limits.IsZero (ev.obj S.homology) := hz.of_iso (S.mapHomologyIso ev).symm
  exact @Subsingleton.elim _ (AddCommGrpCat.isZero_iff_subsingleton.mp hz') z 0

theorem wc_contSheaf_ladic_pi_tower_colimit_legs : ∀ (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (a : ℕ) (ψ : ℕ → ((Fin a → ℤ_[ℓ]) →+ (Fin a → ℚ_[ℓ]))) (hψc : ∀ n, Continuous (ψ n)), (∀ n v i, ψ n v i = ((ℓ : ℚ_[ℓ]) ^ n)⁻¹ * ((v i : ℤ_[ℓ]) : ℚ_[ℓ])) → ∃ κ : Functor.ofSequence (X := fun _ : ℕ => wcContSheaf S (Fin a → ℤ_[ℓ])) (fun _ => ℓ • 𝟙 _) ⟶ (Functor.const ℕ).obj (wcContSheaf S (Fin a → ℚ_[ℓ])), Nonempty (Limits.IsColimit (Limits.Cocone.mk _ κ)) ∧ ∀ n : ℕ, κ.app n = wcContSheafMap S (ψ n) (hψc n) :=
by
  intro S ℓ _ a ψ hψc hψ
  classical
  haveI hex : HasExactColimitsOfShape ℕ (Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) :=
    @Sheaf.hasExactColimitsOfShape _ AddCommGrpCat.{u+1} ℕ _ _ _ (Scheme.ProEt.topology S) _ _ _
      (@HasExactColimitsOfShape.of_domain_equivalence AddCommGrpCat.{u+1} _ _ _ _ _
        (ULiftHomULiftCategory.equiv.{u+1, u+1} ℕ).symm _ (AB5OfSize.ofShape _))
  have hℓ0 : (ℓ : ℚ_[ℓ]) ≠ 0 := Nat.cast_ne_zero.mpr (Fact.out : Nat.Prime ℓ).ne_zero

  have hns : ∀ (m : ℕ) (U : (S.ProEt)ᵒᵖ)
      (x : ((wcContSheaf S (Fin a → ℤ_[ℓ])).obj.obj U : Type (u+1))),
      (m • 𝟙 (wcContSheaf S (Fin a → ℤ_[ℓ]))).hom.app U x = m • x := by
    intro m U x
    induction m with
    | zero => rw [zero_nsmul, zero_nsmul]; rfl
    | succ m ih =>
      rw [succ_nsmul, Sheaf.Hom.add_app, AddCommGrpCat.hom_add_apply, ih, succ_nsmul]
      rfl

  have crit : ∀ (T : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
      (G : ℕ ⥤ Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
      (κ : G ⟶ (Functor.const ℕ).obj T), (∀ n, Mono (κ.app n)) →
      Epi (Limits.colimit.desc G (Limits.Cocone.mk T κ)) →
      Nonempty (Limits.IsColimit (Limits.Cocone.mk T κ)) := by
    intro T G κ hmono hepi
    haveI : Mono κ := NatTrans.mono_of_mono_app κ
    haveI : Mono (Limits.colimMap κ) := Functor.map_mono Limits.colim κ
    let e : Limits.colimit ((Functor.const ℕ).obj T) ≅ T :=
      (Limits.colimit.isColimit ((Functor.const ℕ).obj T)).coconePointUniqueUpToIso
        (Limits.isColimitConstCocone ℕ T)
    have he : ∀ n, Limits.colimit.ι ((Functor.const ℕ).obj T) n ≫ e.hom = 𝟙 T := fun n =>
      (Limits.colimit.isColimit ((Functor.const ℕ).obj T)).comp_coconePointUniqueUpToIso_hom
        (Limits.isColimitConstCocone ℕ T) n
    have hD : Limits.colimit.desc G (Limits.Cocone.mk T κ) = Limits.colimMap κ ≫ e.hom := by
      apply Limits.colimit.hom_ext
      intro n
      rw [Limits.colimit.ι_desc, Limits.ι_colimMap_assoc, he]
      exact (Category.comp_id (κ.app n)).symm
    haveI : Mono (Limits.colimMap κ ≫ e.hom) := mono_comp _ _
    haveI : Mono (Limits.colimit.desc G (Limits.Cocone.mk T κ)) := by
      rw [hD]; infer_instance
    haveI : IsIso (Limits.colimit.desc G (Limits.Cocone.mk T κ)) := isIso_of_mono_of_epi _
    haveI : IsIso ((Limits.colimit.isColimit G).desc (Limits.Cocone.mk T κ)) := by
      rw [Limits.colimit.isColimit_desc]; infer_instance
    exact ⟨Limits.IsColimit.ofPointIso (Limits.colimit.isColimit G)⟩

  have affine_sieve : ∀ (V : S.ProEt) (R : Sieve V),
      (∀ (W : S.ProEt) (f : W ⟶ V), IsAffine W.left → R.arrows f) →
      R ∈ Scheme.ProEt.topology S V := by
    intro V R hR
    have hV : WeaklyEtale V.hom := V.prop
    let W : V.left.affineCover.I₀ → S.ProEt := fun i =>
      MorphismProperty.Over.mk ⊤ (V.left.affineCover.f i ≫ V.hom) inferInstance
    let g : ∀ i, W i ⟶ V := fun i => MorphismProperty.Over.homMk (V.left.affineCover.f i) rfl trivial
    have hP : Presieve.ofArrows W g ∈ (Scheme.ProEt.precoverage S).coverings V := by
      show _ ∈ (Precoverage.comap (Scheme.ProEt.forget S ⋙ Over.forget S)
        Scheme.proetalePrecoverage).coverings V
      rw [Precoverage.mem_comap_iff, Presieve.map_ofArrows]
      change V.left.affineCover.presieve₀ ∈ Scheme.proetalePrecoverage.coverings V.left
      exact ⟨Scheme.zariskiPrecoverage_le_qcPrecoverage V.left V.left.affineCover.mem₀,
        V.left.affineCover.mem₀.1,
        MorphismProperty.ofArrows_mem_precoverage.mpr (fun i => inferInstance)⟩
    refine GrothendieckTopology.superset_covering _ ?_
      (Precoverage.generate_mem_toGrothendieck hP)
    rw [Sieve.generate_le_iff]
    rintro _ _ ⟨i⟩
    exact hR (W i) (g i) (show IsAffine (V.left.affineCover.X i) by infer_instance)

  obtain ⟨κ, hκ⟩ : ∃ κ : Functor.ofSequence (X := fun _ : ℕ => wcContSheaf S (Fin a → ℤ_[ℓ]))
      (fun _ => ℓ • 𝟙 _) ⟶ (Functor.const ℕ).obj (wcContSheaf S (Fin a → ℚ_[ℓ])),
      ∀ n, κ.app n = wcContSheafMap S (ψ n) (hψc n) := by
    refine ⟨NatTrans.ofSequence (fun n => wcContSheafMap S (ψ n) (hψc n)) (fun n => ?_),
      fun n => NatTrans.ofSequence_app _ _ n⟩
    have e : ((ℓ : ℚ_[ℓ]) ^ (n + 1))⁻¹ * (ℓ : ℚ_[ℓ]) = ((ℓ : ℚ_[ℓ]) ^ n)⁻¹ := by
      rw [pow_succ, mul_inv, mul_assoc, inv_mul_cancel₀ hℓ0, mul_one]
    have key : (ℓ • 𝟙 (wcContSheaf S (Fin a → ℤ_[ℓ]))) ≫ wcContSheafMap S (ψ (n + 1)) (hψc (n + 1)) =
        wcContSheafMap S (ψ n) (hψc n) := by
      apply Sheaf.hom_ext
      apply NatTrans.ext
      funext U
      apply AddCommGrpCat.ext
      intro x
      rw [ObjectProperty.FullSubcategory.comp_hom, NatTrans.comp_app, CategoryTheory.comp_apply, hns]
      apply ULift.ext
      apply ContinuousMap.ext
      intro t
      funext i
      change ψ (n + 1) ((ℓ • (ULift.down x : C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj
          (Opposite.unop U)), Fin a → ℤ_[ℓ]))) t) i =
        ψ n ((ULift.down x : C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj
          (Opposite.unop U)), Fin a → ℤ_[ℓ])) t) i
      rw [hψ, hψ, ContinuousMap.coe_nsmul, Pi.smul_apply, Pi.smul_apply, nsmul_eq_mul,
        PadicInt.coe_mul, PadicInt.coe_natCast, ← mul_assoc, e]
    rw [Functor.ofSequence_map_homOfLE_succ, Functor.const_obj_map]
    exact key.trans (Category.comp_id _).symm

  have hmono : ∀ n, Mono (κ.app n) := by
    intro n
    have hm : Mono (wcContSheafMap S (ψ n) (hψc n)) := by
      haveI : ∀ U, Mono ((wcContSheafMap S (ψ n) (hψc n)).hom.app U) := fun U =>
        (AddCommGrpCat.mono_iff_injective _).mpr (by
          intro x x' hxx
          apply ULift.ext
          apply ContinuousMap.ext
          intro t
          funext i
          have h := congrArg (fun z => (ULift.down z :
            C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop U)),
              Fin a → ℚ_[ℓ])) t i) hxx
          have h' : ψ n ((ULift.down x : C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj
                (Opposite.unop U)), Fin a → ℤ_[ℓ])) t) i =
              ψ n ((ULift.down x' : C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj
                (Opposite.unop U)), Fin a → ℤ_[ℓ])) t) i := h
          rw [hψ, hψ] at h'
          exact PadicInt.ext (mul_left_cancel₀ (inv_ne_zero (pow_ne_zero n hℓ0)) h'))
      haveI : Mono (wcContSheafMap S (ψ n) (hψc n)).hom := NatTrans.mono_of_mono_app _
      exact Sheaf.Hom.mono_of_presheaf_mono _ _ _
    rw [hκ n]
    exact hm

  have hepi : Epi (Limits.colimit.desc (Functor.ofSequence
      (X := fun _ : ℕ => wcContSheaf S (Fin a → ℤ_[ℓ])) (fun _ => ℓ • 𝟙 _))
      (Limits.Cocone.mk _ κ)) := by
    have hls : Presheaf.IsLocallySurjective (Scheme.ProEt.topology S)
        (Limits.colimit.desc (Functor.ofSequence
          (X := fun _ : ℕ => wcContSheaf S (Fin a → ℤ_[ℓ])) (fun _ => ℓ • 𝟙 _))
          (Limits.Cocone.mk _ κ)).hom := by
      refine ⟨fun {V} s => ?_⟩
      apply affine_sieve V
      intro W f hW
      haveI : CompactSpace ↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj W) :=
        (inferInstance : CompactSpace W.left)
      let g : C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj W), Fin a → ℚ_[ℓ]) :=
        ((wcContSheaf S (Fin a → ℚ_[ℓ])).obj.map f.op s).down
      obtain ⟨C, hC⟩ := isCompact_univ.exists_bound_of_continuousOn g.continuous.continuousOn
      have hℓ1 : (1 : ℝ) < (ℓ : ℝ) := Nat.one_lt_cast.mpr (Fact.out : Nat.Prime ℓ).one_lt
      obtain ⟨n, hn⟩ := pow_unbounded_of_one_lt C hℓ1
      have hpos : (0 : ℝ) < (ℓ : ℝ) ^ n := pow_pos (by linarith) n
      have hbd : ∀ x i, ‖(ℓ : ℚ_[ℓ]) ^ n * g x i‖ ≤ 1 := by
        intro x i
        have h1 := hC x (Set.mem_univ x)
        have h2 := norm_le_pi_norm (g x) i
        rw [norm_mul, Padic.norm_p_pow, zpow_neg, zpow_natCast, inv_mul_le_iff₀ hpos, mul_one]
        linarith
      let f0 : C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj W), Fin a → ℤ_[ℓ]) :=
        ⟨fun x i => ⟨(ℓ : ℚ_[ℓ]) ^ n * g x i, hbd x i⟩,
          continuous_pi (fun i =>
            (continuous_const.mul ((continuous_apply i).comp g.continuous)).subtype_mk _)⟩
      let t0 : (wcContSheaf S (Fin a → ℤ_[ℓ])).obj.obj (Opposite.op W) := ULift.up f0
      refine ⟨(Limits.colimit.ι (Functor.ofSequence
        (X := fun _ : ℕ => wcContSheaf S (Fin a → ℤ_[ℓ])) (fun _ => ℓ • 𝟙 _)) n).hom.app
          (Opposite.op W) t0, ?_⟩
      change (Limits.colimit.ι (Functor.ofSequence
        (X := fun _ : ℕ => wcContSheaf S (Fin a → ℤ_[ℓ])) (fun _ => ℓ • 𝟙 _)) n ≫
          Limits.colimit.desc (Functor.ofSequence
            (X := fun _ : ℕ => wcContSheaf S (Fin a → ℤ_[ℓ])) (fun _ => ℓ • 𝟙 _))
            (Limits.Cocone.mk _ κ)).hom.app (Opposite.op W) t0 = _
      rw [Limits.colimit.ι_desc]
      change (κ.app n).hom.app (Opposite.op W) t0 = _
      rw [hκ n]
      apply ULift.ext
      apply ContinuousMap.ext
      intro x
      funext i
      change ψ n (f0 x) i = g x i
      rw [hψ]
      change ((ℓ : ℚ_[ℓ]) ^ n)⁻¹ * ((ℓ : ℚ_[ℓ]) ^ n * g x i) = g x i
      rw [inv_mul_cancel_left₀ (pow_ne_zero n hℓ0)]
    exact (Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u+1} _).mp hls
  exact ⟨κ, crit _ _ κ hmono hepi, hκ⟩

theorem wc_contSheaf_split_torsion_retract_explicit : ∀ (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (a b : ℕ) (e : Fin b → ℕ) (hi : Continuous (AddMonoidHom.inl (Fin a → ℤ_[ℓ]) ((j : Fin b) → ZMod (ℓ ^ e j)))) (hp : Continuous (AddMonoidHom.fst (Fin a → ℤ_[ℓ]) ((j : Fin b) → ZMod (ℓ ^ e j)))), wcContSheafMap S (AddMonoidHom.inl (Fin a → ℤ_[ℓ]) ((j : Fin b) → ZMod (ℓ ^ e j))) hi ≫ wcContSheafMap S (AddMonoidHom.fst (Fin a → ℤ_[ℓ]) ((j : Fin b) → ZMod (ℓ ^ e j))) hp = 𝟙 _ ∧ ∃ N : ℕ, (ℓ ^ N) • (𝟙 _ - wcContSheafMap S (AddMonoidHom.fst (Fin a → ℤ_[ℓ]) ((j : Fin b) → ZMod (ℓ ^ e j))) hp ≫ wcContSheafMap S (AddMonoidHom.inl (Fin a → ℤ_[ℓ]) ((j : Fin b) → ZMod (ℓ ^ e j))) hi) = 0 :=
by
  intro S ℓ _ a b e hi hp
  have key : ∀ {A B : Type} [AddCommGroup A] [TopologicalSpace A] [IsTopologicalAddGroup A]
      [AddCommGroup B] [TopologicalSpace B] [IsTopologicalAddGroup B]
      (φ : A →+ B) (hφ : Continuous φ) (U : (S.ProEt)ᵒᵖ)
      (x : ((wcContSheaf S A).obj.obj U : Type (u+1))),
      (wcContSheafMap S φ hφ).hom.app U x =
        (ULift.up (AddMonoidHom.compLeftContinuous
          (↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop U))) φ hφ
          (ULift.down x : C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop U)), A))) : _) := by
    intro A B _ _ _ _ _ _ φ hφ U x
    rfl
  have hns : ∀ {F G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} (f : F ⟶ G) (n : ℕ)
      (U : (S.ProEt)ᵒᵖ) (x : (F.obj.obj U : Type (u+1))),
      (n • f).hom.app U x = n • f.hom.app U x := by
    intro F G f n U x
    induction n with
    | zero => rw [zero_nsmul, zero_nsmul]; rfl
    | succ n ih => rw [succ_nsmul, succ_nsmul, Sheaf.Hom.add_app, AddCommGrpCat.hom_add_apply, ih]
  have hkill : ∀ w : ((j : Fin b) → ZMod (ℓ ^ e j)), (ℓ ^ (∑ j, e j)) • w = 0 := by
    intro w
    funext j
    rw [Pi.smul_apply, Pi.zero_apply, nsmul_eq_mul]
    have h0 : ((ℓ ^ (∑ j, e j) : ℕ) : ZMod (ℓ ^ e j)) = 0 := by
      rw [ZMod.natCast_eq_zero_iff]
      exact pow_dvd_pow ℓ (Finset.single_le_sum (fun j' _ => Nat.zero_le (e j')) (Finset.mem_univ j))
    rw [h0, zero_mul]
  refine ⟨?_, ∑ j, e j, ?_⟩
  · apply Sheaf.hom_ext
    apply NatTrans.ext
    funext U
    apply AddCommGrpCat.ext
    intro x
    rw [ObjectProperty.FullSubcategory.comp_hom, NatTrans.comp_app, CategoryTheory.comp_apply,
      key, key]
    rfl
  · rw [smul_sub, sub_eq_zero]
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext U
    apply AddCommGrpCat.ext
    intro x
    rw [hns, hns, ObjectProperty.FullSubcategory.comp_hom, NatTrans.comp_app,
      CategoryTheory.comp_apply, key, key]
    apply ULift.ext
    apply ContinuousMap.ext
    intro t
    change (ℓ ^ (∑ j, e j)) • ((ULift.down x : C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj
        (Opposite.unop U)), (Fin a → ℤ_[ℓ]) × ((j : Fin b) → ZMod (ℓ ^ e j)))) t) =
      (ℓ ^ (∑ j, e j)) • (((ULift.down x : C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj
        (Opposite.unop U)), (Fin a → ℤ_[ℓ]) × ((j : Fin b) → ZMod (ℓ ^ e j)))) t).1,
        (0 : (j : Fin b) → ZMod (ℓ ^ e j)))
    apply Prod.ext
    · rfl
    · rw [Prod.smul_snd, Prod.smul_snd, hkill, smul_zero]

theorem wc_contSheaf_over_hom_ladic_separated : ∀ (S : Scheme.{u}) (V : S.ProEt) (A : Type) [AddCommGroup A] [TopologicalSpace A] [IsTopologicalAddGroup A] (ℓ : ℕ), (∀ x : A, (∀ m : ℕ, ∃ y : A, x = (ℓ ^ m) • y) → x = 0) → ∀ (Y : Sheaf ((Scheme.ProEt.topology S).over V) AddCommGrpCat.{u+1}) (Δ : Y ⟶ (wcContSheaf S A).over V), (∀ m : ℕ, ∃ Δ' : Y ⟶ (wcContSheaf S A).over V, Δ = (ℓ ^ m) • Δ') → Δ = 0 :=
by
  intro S V A _ _ _ ℓ hA Y Δ hΔ
  have hns : ∀ {F G : Sheaf ((Scheme.ProEt.topology S).over V) AddCommGrpCat.{u+1}} (f : F ⟶ G)
      (n : ℕ) (U : (Over V)ᵒᵖ) (x : (F.obj.obj U : Type (u+1))),
      (n • f).hom.app U x = n • f.hom.app U x := by
    intro F G f n U x
    induction n with
    | zero => rw [zero_nsmul, zero_nsmul]; rfl
    | succ n ih => rw [succ_nsmul, succ_nsmul, Sheaf.Hom.add_app, AddCommGrpCat.hom_add_apply, ih]
  apply Sheaf.hom_ext
  apply NatTrans.ext
  funext W
  apply AddCommGrpCat.ext
  intro y
  change Δ.hom.app W y = 0
  apply ULift.ext
  apply ContinuousMap.ext
  intro t
  change (ULift.down (Δ.hom.app W y) : C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj
    ((Over.forget V).obj W.unop)), A)) t = 0
  apply hA
  intro m
  obtain ⟨Δ', hΔ'⟩ := hΔ m
  refine ⟨(ULift.down (Δ'.hom.app W y) : C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj
    ((Over.forget V).obj W.unop)), A)) t, ?_⟩
  rw [hΔ', hns]
  rfl

theorem wc_contSheafMap_scalar_facts : ∀ (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (a : ℕ),
    (∀ x y : ℤ_[ℓ], wcContSheafMap S (DistribSMul.toAddMonoidHom (Fin a → ℤ_[ℓ]) (x + y)) (continuous_const_smul (x + y)) =
      wcContSheafMap S (DistribSMul.toAddMonoidHom (Fin a → ℤ_[ℓ]) x) (continuous_const_smul x) +
      wcContSheafMap S (DistribSMul.toAddMonoidHom (Fin a → ℤ_[ℓ]) y) (continuous_const_smul y)) ∧
    (∀ n : ℕ, wcContSheafMap S (DistribSMul.toAddMonoidHom (Fin a → ℤ_[ℓ]) (n : ℤ_[ℓ])) (continuous_const_smul (n : ℤ_[ℓ])) =
      n • 𝟙 (wcContSheaf S (Fin a → ℤ_[ℓ]))) ∧
    (∀ x y : ℤ_[ℓ], wcContSheafMap S (DistribSMul.toAddMonoidHom (Fin a → ℤ_[ℓ]) (x * y)) (continuous_const_smul (x * y)) =
      wcContSheafMap S (DistribSMul.toAddMonoidHom (Fin a → ℤ_[ℓ]) y) (continuous_const_smul y) ≫
      wcContSheafMap S (DistribSMul.toAddMonoidHom (Fin a → ℤ_[ℓ]) x) (continuous_const_smul x)) ∧
    (∀ x y : ℚ_[ℓ], wcContSheafMap S (DistribSMul.toAddMonoidHom (Fin a → ℚ_[ℓ]) (x * y)) (continuous_const_smul (x * y)) =
      wcContSheafMap S (DistribSMul.toAddMonoidHom (Fin a → ℚ_[ℓ]) y) (continuous_const_smul y) ≫
      wcContSheafMap S (DistribSMul.toAddMonoidHom (Fin a → ℚ_[ℓ]) x) (continuous_const_smul x)) ∧
    (∀ (ψ : (Fin a → ℤ_[ℓ]) →+ (Fin a → ℚ_[ℓ])) (hψ : Continuous ψ) (r : ℚ_[ℓ]),
      (∀ v i, ψ v i = r * ((v i : ℤ_[ℓ]) : ℚ_[ℓ])) → ∀ x : ℤ_[ℓ],
        wcContSheafMap S (DistribSMul.toAddMonoidHom (Fin a → ℤ_[ℓ]) x) (continuous_const_smul x) ≫
          wcContSheafMap S ψ hψ =
        wcContSheafMap S ψ hψ ≫
          wcContSheafMap S (DistribSMul.toAddMonoidHom (Fin a → ℚ_[ℓ]) (x : ℚ_[ℓ])) (continuous_const_smul (x : ℚ_[ℓ]))) :=
by
  intro S ℓ _ a
  have hext : ∀ {A B : Type} [AddCommGroup A] [TopologicalSpace A] [IsTopologicalAddGroup A]
      [AddCommGroup B] [TopologicalSpace B] [IsTopologicalAddGroup B]
      (f g : wcContSheaf S A ⟶ wcContSheaf S B),
      (∀ (U : (S.ProEt)ᵒᵖ) (s : ((wcContSheaf S A).obj.obj U : Type (u+1))),
        f.hom.app U s = g.hom.app U s) → f = g := by
    intro A B _ _ _ _ _ _ f g h
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext U
    apply AddCommGrpCat.ext
    intro s
    exact h U s
  have hns : ∀ {F G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} (f : F ⟶ G) (n : ℕ)
      (U : (S.ProEt)ᵒᵖ) (x : (F.obj.obj U : Type (u+1))),
      (n • f).hom.app U x = n • f.hom.app U x := by
    intro F G f n U x
    induction n with
    | zero => rw [zero_nsmul, zero_nsmul]; rfl
    | succ n ih => rw [succ_nsmul, succ_nsmul, Sheaf.Hom.add_app, AddCommGrpCat.hom_add_apply, ih]
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · intro x y
    apply hext
    intro U s
    rw [Sheaf.Hom.add_app, AddCommGrpCat.hom_add_apply]
    apply ULift.ext
    apply ContinuousMap.ext
    intro t
    exact add_smul x y ((ULift.down s : C(_, Fin a → ℤ_[ℓ])) t)
  · intro n
    apply hext
    intro U s
    rw [hns]
    apply ULift.ext
    apply ContinuousMap.ext
    intro t
    exact Nat.cast_smul_eq_nsmul ℤ_[ℓ] n ((ULift.down s : C(_, Fin a → ℤ_[ℓ])) t)
  · intro x y
    apply hext
    intro U s
    rw [ObjectProperty.FullSubcategory.comp_hom, NatTrans.comp_app, CategoryTheory.comp_apply]
    apply ULift.ext
    apply ContinuousMap.ext
    intro t
    exact mul_smul x y ((ULift.down s : C(_, Fin a → ℤ_[ℓ])) t)
  · intro x y
    apply hext
    intro U s
    rw [ObjectProperty.FullSubcategory.comp_hom, NatTrans.comp_app, CategoryTheory.comp_apply]
    apply ULift.ext
    apply ContinuousMap.ext
    intro t
    exact mul_smul x y ((ULift.down s : C(_, Fin a → ℚ_[ℓ])) t)
  · intro ψ hψ r hψv x
    have hpt : ∀ w : Fin a → ℤ_[ℓ], ψ (x • w) = (x : ℚ_[ℓ]) • ψ w := by
      intro w
      funext i
      have h1 := hψv (x • w) i
      have h2 := hψv w i
      have h3 : (((x • w) i : ℤ_[ℓ]) : ℚ_[ℓ]) = (x : ℚ_[ℓ]) * ((w i : ℤ_[ℓ]) : ℚ_[ℓ]) :=
        PadicInt.coe_mul x (w i)
      show ψ (x • w) i = (x : ℚ_[ℓ]) * ψ w i
      rw [h1, h3, h2]
      ring
    apply hext
    intro U s
    rw [ObjectProperty.FullSubcategory.comp_hom, NatTrans.comp_app, CategoryTheory.comp_apply,
      ObjectProperty.FullSubcategory.comp_hom, NatTrans.comp_app, CategoryTheory.comp_apply]
    apply ULift.ext
    apply ContinuousMap.ext
    intro t
    exact hpt ((ULift.down s : C(_, Fin a → ℤ_[ℓ])) t)

theorem wc_seq_colimit_iso_legs : ∀ {𝒜 𝒜' ℬ : Type*} [Category 𝒜] [Category 𝒜'] [Category ℬ] (F : 𝒜 ⥤ ℬ) (F' : 𝒜' ⥤ ℬ) (Y L : 𝒜) (s : Y ⟶ Y) (κ : Functor.ofSequence (X := fun _ : ℕ => Y) (fun _ => s) ⟶ (Functor.const ℕ).obj L), Nonempty (Limits.IsColimit (F.mapCocone (Limits.Cocone.mk L κ))) → ∀ (Y' L' : 𝒜') (s' : Y' ⟶ Y') (κ' : Functor.ofSequence (X := fun _ : ℕ => Y') (fun _ => s') ⟶ (Functor.const ℕ).obj L'), Nonempty (Limits.IsColimit (F'.mapCocone (Limits.Cocone.mk L' κ'))) → ∀ (θ : F.obj Y ≅ F'.obj Y'), F.map s ≫ θ.hom = θ.hom ≫ F'.map s' → ∃ τ : F.obj L ≅ F'.obj L', ∀ n : ℕ, F.map (κ.app n) ≫ τ.hom = θ.hom ≫ F'.map (κ'.app n) :=
by
  intro 𝒜 𝒜' ℬ _ _ _ F F' Y L s κ hP Y' L' s' κ' hQ θ hθ
  obtain ⟨P⟩ := hP
  obtain ⟨Q⟩ := hQ
  let α : (Functor.ofSequence (X := fun _ : ℕ => Y) (fun _ => s) ⋙ F) ⟶
      (Functor.ofSequence (X := fun _ : ℕ => Y') (fun _ => s') ⋙ F') :=
    NatTrans.ofSequence (fun _ => θ.hom) (fun n => by
      simp only [Functor.comp_map, Functor.ofSequence_map_homOfLE_succ]
      exact hθ)
  let w : (Functor.ofSequence (X := fun _ : ℕ => Y) (fun _ => s) ⋙ F) ≅
      (Functor.ofSequence (X := fun _ : ℕ => Y') (fun _ => s') ⋙ F') :=
    NatIso.ofComponents (fun _ => θ) (fun {i j} f => α.naturality f)
  refine ⟨P.coconePointsIsoOfNatIso Q w, fun n => ?_⟩
  exact P.comp_coconePointsIsoOfNatIso_hom Q w n

theorem wc_seq_colimit_torsion_retract_legs : ∀ {𝒜 : Type*} [Category 𝒜] [Preadditive 𝒜] (m N : ℕ) (Y P : 𝒜) (i : P ⟶ Y) (p : Y ⟶ P), i ≫ p = 𝟙 P → (m ^ N) • (𝟙 Y - p ≫ i) = 0 → ∀ (L : 𝒜) (κ : Functor.ofSequence (X := fun _ : ℕ => P) (fun _ => m • 𝟙 P) ⟶ (Functor.const ℕ).obj L), Nonempty (Limits.IsColimit (Limits.Cocone.mk L κ)) → ∃ κ' : Functor.ofSequence (X := fun _ : ℕ => Y) (fun _ => m • 𝟙 Y) ⟶ (Functor.const ℕ).obj L, Nonempty (Limits.IsColimit (Limits.Cocone.mk L κ')) ∧ ∀ n : ℕ, κ'.app n = p ≫ κ.app n :=
by
  intro 𝒜 _ _ m N Y P i p hip htor L κ hne
  obtain ⟨h⟩ := hne

  have div : ∀ (W : 𝒜) (f : ℕ → (Y ⟶ W)), (∀ n, m • f (n + 1) = f n) →
      ∀ n k, f n = (m ^ k) • f (n + k) := by
    intro W f hf n k
    induction k with
    | zero => simp
    | succ k ih =>
      rw [ih, ← hf (n + k), smul_smul, ← pow_succ, Nat.add_assoc]
  have kill : ∀ (W : 𝒜) (f : ℕ → (Y ⟶ W)), (∀ n, m • f (n + 1) = f n) →
      ∀ n, p ≫ i ≫ f n = f n := by
    intro W f hf n
    have h1 : (𝟙 Y - p ≫ i) ≫ f n = 0 := by
      rw [div W f hf n N, Preadditive.comp_nsmul, ← Preadditive.nsmul_comp, htor,
        Limits.zero_comp]
    rw [Preadditive.sub_comp, Category.id_comp, Category.assoc, sub_eq_zero] at h1
    exact h1.symm
  have natg : ∀ (A B W : 𝒜) (q : A ⟶ B) (g : ℕ → (B ⟶ W)), (∀ n, m • g (n + 1) = g n) →
      ∀ n, (m • 𝟙 A) ≫ q ≫ g (n + 1) = (q ≫ g n) ≫ 𝟙 W := by
    intro A B W q g hg n
    rw [Preadditive.nsmul_comp, Category.id_comp, ← Preadditive.comp_nsmul, hg n,
      Category.comp_id]
  have step : ∀ (Q W : 𝒜)
      (τ : Functor.ofSequence (X := fun _ : ℕ => Q) (fun _ => m • 𝟙 Q) ⟶ (Functor.const ℕ).obj W),
      ∀ n, m • (τ.app : ℕ → (Q ⟶ W)) (n + 1) = (τ.app : ℕ → (Q ⟶ W)) n := by
    intro Q W τ n
    have h0 := τ.naturality (homOfLE (Nat.le_succ n))
    rw [Functor.ofSequence_map_homOfLE_succ] at h0
    have e1 : ∀ g : Q ⟶ W, (m • 𝟙 Q) ≫ g = m • g := fun g => by
      rw [Preadditive.nsmul_comp, Category.id_comp]
    exact (e1 _).symm.trans (h0.trans (Category.comp_id _))
  let κ' : Functor.ofSequence (X := fun _ : ℕ => Y) (fun _ => m • 𝟙 Y) ⟶ (Functor.const ℕ).obj L :=
    NatTrans.ofSequence (fun n => p ≫ κ.app n) (fun n => by
      rw [Functor.ofSequence_map_homOfLE_succ]
      exact natg Y P L p κ.app (step P L κ) n)
  have hκ' : ∀ n, κ'.app n = p ≫ κ.app n := fun n => NatTrans.ofSequence_app _ _ n
  let t : Limits.Cocone (Functor.ofSequence (X := fun _ : ℕ => Y) (fun _ => m • 𝟙 Y)) →
      Limits.Cocone (Functor.ofSequence (X := fun _ : ℕ => P) (fun _ => m • 𝟙 P)) := fun s =>
    Limits.Cocone.mk s.pt (NatTrans.ofSequence (fun n => i ≫ s.ι.app n) (fun n => by
      rw [Functor.ofSequence_map_homOfLE_succ]
      exact natg P Y s.pt i s.ι.app (step Y s.pt s.ι) n))
  have ht : ∀ s n, (t s).ι.app n = i ≫ s.ι.app n := by
    intro s n
    rfl
  refine ⟨κ', ⟨Limits.IsColimit.mk (fun s => h.desc (t s)) ?_ ?_⟩, hκ'⟩
  · intro s n
    change κ'.app n ≫ h.desc (t s) = s.ι.app n
    have e : κ.app n ≫ h.desc (t s) = (t s).ι.app n := h.fac (t s) n
    exact ((congrArg (fun x => x ≫ h.desc (t s)) (hκ' n)).trans (Category.assoc _ _ _)).trans
      ((congrArg (fun x => p ≫ x) (e.trans (ht s n))).trans (kill s.pt s.ι.app (step Y s.pt s.ι) n))
  · intro s u hu
    apply h.uniq (t s) u
    intro n
    change κ.app n ≫ u = (t s).ι.app n
    have hu' : κ'.app n ≫ u = s.ι.app n := hu n
    exact (Category.id_comp _).symm.trans
      ((congrArg (fun x => x ≫ (κ.app n ≫ u)) hip.symm).trans
      ((Category.assoc _ _ _).trans
      ((congrArg (fun x => i ≫ x) (Category.assoc _ _ _).symm).trans
      ((congrArg (fun x => i ≫ (x ≫ u)) (hκ' n).symm).trans
      ((congrArg (fun x => i ≫ x) hu').trans (ht s n).symm)))))

theorem wc_padic_intertwine_of_separated : ∀ {𝒞 : Type*} [Category 𝒞] [Preadditive 𝒞] (ℓ : ℕ) [Fact (Nat.Prime ℓ)] {Y T : 𝒞} (E : ℤ_[ℓ] → (Y ⟶ Y)) (S : ℤ_[ℓ] → (T ⟶ T)) (P : Y ⟶ T), (∀ a b : ℤ_[ℓ], E (a + b) = E a + E b) → (∀ n : ℕ, E (n : ℤ_[ℓ]) = n • 𝟙 Y) → (∀ a b : ℤ_[ℓ], E (a * b) = E b ≫ E a) → (∀ a b : ℤ_[ℓ], S (a + b) = S a + S b) → (∀ n : ℕ, S (n : ℤ_[ℓ]) = n • 𝟙 T) → (∀ a b : ℤ_[ℓ], S (a * b) = S b ≫ S a) → (∀ Δ : Y ⟶ T, (∀ m : ℕ, ∃ Δ' : Y ⟶ T, Δ = (ℓ ^ m) • Δ') → Δ = 0) → ∀ c : ℤ_[ℓ], E c ≫ P = P ≫ S c :=
by
  intro 𝒞 _ _ ℓ _ Y T E S P hEadd hEnat hEmul hSadd hSnat hSmul hsep c
  apply sub_eq_zero.mp
  apply hsep
  intro m
  obtain ⟨t, ht⟩ := Ideal.mem_span_singleton'.mp (PadicInt.appr_spec m c)
  generalize c.appr m = a at ht
  have hc : c = ((a : ℕ) : ℤ_[ℓ]) + t * ((ℓ ^ m : ℕ) : ℤ_[ℓ]) := by
    rw [Nat.cast_pow, ht]; ring
  refine ⟨E t ≫ P - P ≫ S t, ?_⟩
  have hE : E c = a • 𝟙 Y + (ℓ ^ m) • E t := by
    rw [hc, hEadd, hEmul, hEnat, hEnat, Preadditive.nsmul_comp, Category.id_comp]
  have hS : S c = a • 𝟙 T + (ℓ ^ m) • S t := by
    rw [hc, hSadd, hSmul, hSnat, hSnat, Preadditive.nsmul_comp, Category.id_comp]
  rw [hE, hS]
  simp only [Preadditive.add_comp, Preadditive.comp_add, Preadditive.nsmul_comp,
    Preadditive.comp_nsmul, Category.id_comp, Category.comp_id, smul_sub]
  abel

theorem wc_padic_pi_int_separated : ∀ (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (a : ℕ) (x : Fin a → ℤ_[ℓ]), (∀ m : ℕ, ∃ y : Fin a → ℤ_[ℓ], x = (ℓ ^ m) • y) → x = 0 :=
by
  intro ℓ _ a x hx
  funext i
  have hℓ : (1 : ℝ) < (ℓ : ℝ) := by exact_mod_cast (Fact.out : ℓ.Prime).one_lt
  have H : ∀ m : ℕ, ‖x i‖ ≤ ((ℓ : ℝ)⁻¹) ^ m := by
    intro m
    obtain ⟨y, hy⟩ := hx m
    have h := congrFun hy i
    rw [Pi.smul_apply, nsmul_eq_mul, Nat.cast_pow] at h
    rw [h, norm_mul, norm_pow, PadicInt.norm_p]
    exact mul_le_of_le_one_right (pow_nonneg (inv_nonneg.mpr (Nat.cast_nonneg _)) m)
      (PadicInt.norm_le_one _)
  by_contra hne
  have hpos : 0 < ‖x i‖ := norm_pos_iff.mpr hne
  obtain ⟨n, hn⟩ := exists_pow_lt_of_lt_one hpos (inv_lt_one_of_one_lt₀ hℓ)
  exact absurd (H n) (not_le.mpr hn)

theorem wc_rightDerived_map_add : ∀ {C D : Type*} [Category C] [Category D] [Abelian C] [Abelian D] [HasInjectiveResolutions C] (F : C ⥤ D) [F.Additive] (q : ℕ) (X : C) (f g : X ⟶ X), (F.rightDerived q).map (f + g) = (F.rightDerived q).map f + (F.rightDerived q).map g :=
by
  intro C D _ _ _ _ _ F _ q X f g
  let I : InjectiveResolution X := injectiveResolution X
  let φ := InjectiveResolution.desc f I I
  let ψ := InjectiveResolution.desc g I I
  have hf : I.ι ≫ φ = (CochainComplex.single₀ C).map f ≫ I.ι :=
    InjectiveResolution.desc_commutes f I I
  have hg : I.ι ≫ ψ = (CochainComplex.single₀ C).map g ≫ I.ι :=
    InjectiveResolution.desc_commutes g I I
  have hfg : I.ι ≫ (φ + ψ) = (CochainComplex.single₀ C).map (f + g) ≫ I.ι := by
    rw [Preadditive.comp_add, hf, hg, CategoryTheory.Functor.map_add, Preadditive.add_comp]
  rw [F.rightDerived_map_eq q (f + g) (P := I) (Q := I) (φ + ψ) hfg,
    F.rightDerived_map_eq q f (P := I) (Q := I) φ hf,
    F.rightDerived_map_eq q g (P := I) (Q := I) ψ hg,
    CategoryTheory.Functor.map_add, Preadditive.add_comp, Preadditive.comp_add]

theorem wc_rat_intertwine_of_int : ∀ {𝒞 : Type*} [Category 𝒞] (ℓ : ℕ) [Fact (Nat.Prime ℓ)] {P Q : 𝒞} (σ : ℚ_[ℓ] → (P ⟶ P)) (ρ : ℚ_[ℓ] → (Q ⟶ Q)) (τ : P ⟶ Q), σ 1 = 𝟙 P → (∀ a b : ℚ_[ℓ], σ (a * b) = σ b ≫ σ a) → (∀ a b : ℚ_[ℓ], ρ (a * b) = ρ b ≫ ρ a) → (∀ c : ℤ_[ℓ], σ (c : ℚ_[ℓ]) ≫ τ = τ ≫ ρ (c : ℚ_[ℓ])) → ∀ c : ℚ_[ℓ], σ c ≫ τ = τ ≫ ρ c :=
by
  intro 𝒞 _ ℓ _ P Q σ ρ τ h1 hσ hρ hint c
  by_cases hc : ‖c‖ ≤ 1
  · exact hint ⟨c, hc⟩
  · have hc1 : 1 < ‖c‖ := not_le.mp hc
    have hc0 : c ≠ 0 := by
      intro h
      rw [h, norm_zero] at hc1
      linarith
    have hd : ‖c⁻¹‖ ≤ 1 := by
      rw [norm_inv]
      exact inv_le_one_of_one_le₀ hc1.le
    have s1 : τ ≫ ρ 1 = τ := by
      have h := hint 1
      rw [PadicInt.coe_one, h1, Category.id_comp] at h
      exact h.symm
    have hC : σ c⁻¹ ≫ τ = τ ≫ ρ c⁻¹ := hint ⟨c⁻¹, hd⟩
    have hA : τ ≫ ρ c⁻¹ ≫ ρ c = τ := by
      rw [← hρ, mul_inv_cancel₀ hc0, s1]
    have hB : σ c ≫ σ c⁻¹ = 𝟙 P := by
      rw [← hσ, inv_mul_cancel₀ hc0, h1]
    calc σ c ≫ τ = σ c ≫ (τ ≫ ρ c⁻¹ ≫ ρ c) := by rw [hA]
      _ = (σ c ≫ σ c⁻¹) ≫ τ ≫ ρ c := by
        rw [← Category.assoc τ, ← hC]
        simp only [Category.assoc]
      _ = τ ≫ ρ c := by rw [hB, Category.id_comp]

theorem wc_proet_Rq_rat_linear_triv : ∀ {X B : Scheme.{u}} (g : X ⟶ B) [QuasiCompact g]
    [QuasiSeparated g] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (V : B.ProEt), ConnectedSpace V.left → CompactSpace V.left → QuasiSeparatedSpace V.left →
    ∀ (q a b : ℕ) (e : Fin b → ℕ),
    Nonempty ((((wcProEtPush g).rightDerived q).obj (wcContSheaf X ℤ_[ℓ])).over V ≅
        (wcContSheaf B ((Fin a → ℤ_[ℓ]) × ((j : Fin b) → ZMod (ℓ ^ e j)))).over V) →
    ∃ τ : (wcRq g ℓ q).over V ≅ (wcContSheaf B (Fin a → ℚ_[ℓ])).over V,
      ∀ c : ℚ_[ℓ],
        ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map (wcRqScalar g ℓ q c) ≫ τ.hom =
          τ.hom ≫ ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map
            (wcContSheafMap B (DistribSMul.toAddMonoidHom (Fin a → ℚ_[ℓ]) c) (continuous_const_smul c)) :=
