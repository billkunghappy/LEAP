      · exact wc_fntame_etale_over_generic A₀ X f P p hP.finite hP.etale hfin hpb x
          (by rw [hx]; rfl)
      · exact wc_fntame_etale_codim_one_of_unit ℓ hℓ A₀ hℓu ζ hζ X f σ hσ hconn P p α hP hr hnorm hfin hpb x
          (by rw [hx]; rfl)
      · apply wc_fntame_etale_codim_ge_two_kfree ℓ hℓ A₀ X f σ hσ hconn P p α hP hr hnorm hfin
