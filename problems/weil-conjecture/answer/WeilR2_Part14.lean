theorem wc_et_pull_bij_geom_fibre_transport : ∀ {X B S T : Scheme.{u}} (g : X ⟶ B) (a : S ⟶ B) (ξ : T ⟶ S) (γ : T ⟶ B) (hξ : ξ ≫ a = γ) (m : ℕ), (∀ (D : wcEtPullData (Limits.pullback.fst (Limits.pullback.snd g a) ξ) m) (q : ℕ), Function.Bijective (wcEtPull D q)) → ∀ (D : wcEtPullData (Limits.pullback.lift (Limits.pullback.fst g γ) (Limits.pullback.snd g γ ≫ ξ) (Limits.pullback.condition.trans ((congrArg (fun k => Limits.pullback.snd g γ ≫ k) hξ).symm.trans (Category.assoc _ _ _).symm))) m) (q : ℕ), Function.Bijective (wcEtPull D q) :=
