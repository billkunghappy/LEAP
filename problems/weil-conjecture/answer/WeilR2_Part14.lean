    (((wc_et_push_id_comp_iso ψ.inv (Limits.pullback.fst g z)).2.some).app _).symm
  haveI : IsIso (wcEtCanConst ψ.inv (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) :=
    (wc_et_push_iso_exact_can ψ.inv).2.2.2.1 _
  have i₃ := (wcEtPush (Limits.pullback.fst g z)).mapIso
    (asIso (wcEtCanConst ψ.inv (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))).symm
  exact ⟨i₁ ≪≫ i₂ ≪≫ i₃⟩

theorem wc_cpt_th_poly_noetherian_reduction : ∀ (ℓ q : ℕ), (∀ (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)] [IsNoetherianRing B], IsUnit ((ℓ : ℕ) : B) → Subsingleton (wcEtCoh (Spec (.of (Polynomial B))) ℓ q)) → ∀ (C : Type u) [CommRing C] [HenselianLocalRing C] [IsSepClosed (IsLocalRing.ResidueField C)], IsUnit ((ℓ : ℕ) : C) → Subsingleton (wcEtCoh (Spec (.of (Polynomial C))) ℓ q) :=
by
  intro ℓ q hN C _ _ _ hunit
  classical
  refine wc_et_coh_subring_approx_vanishing (Polynomial C) ℓ q (fun F => ?_)
  haveI hNoeth : IsNoetherianRing (ULift.{u} ℤ) :=
    isNoetherianRing_of_ringEquiv ℤ ULift.ringEquiv.symm
  obtain ⟨B, hSB, -, hH, hsep, hnoeth, hloc⟩ :=
    wc_shens_noetherian_subring_local (ULift.{u} ℤ) C
      ((Int.castRingHom C).comp ULift.ringEquiv.toRingHom) (F.biUnion (fun p => p.coeffs))
  haveI := hH
  haveI := hsep
  haveI := hnoeth
  haveI := hloc
  have hB : IsUnit ((ℓ : ℕ) : ↥B) :=
    isUnit_of_map_unit B.subtype ((ℓ : ℕ) : ↥B) (by rw [map_natCast]; exact hunit)
  refine ⟨Polynomial ↥B, inferInstance, Polynomial.mapRingHom B.subtype, ?_, ?_, hN ↥B hB⟩
  · rw [Polynomial.coe_mapRingHom]
    exact Polynomial.map_injective B.subtype B.subtype_injective
  · intro x hx
    rw [RingHom.mem_range]
    have hl : x ∈ Polynomial.lifts B.subtype := by
      rw [Polynomial.lifts_iff_coeff_lifts]
      intro n
      by_cases h0 : x.coeff n = 0
      · exact ⟨0, by rw [h0, map_zero]⟩
      · have hm : x.coeff n ∈ F.biUnion (fun p => p.coeffs) :=
          Finset.mem_biUnion.mpr ⟨x, hx, Polynomial.coeff_mem_coeffs h0⟩
        exact ⟨⟨x.coeff n, hSB _ hm⟩, rfl⟩
    obtain ⟨y, hy⟩ := (Polynomial.mem_lifts x).mp hl
    exact ⟨y, by rw [Polynomial.coe_mapRingHom]; exact hy⟩

theorem wc_cpt_th_A1_acyclic : ∀ (C : Type u) [CommRing C] [HenselianLocalRing C] [IsSepClosed (IsLocalRing.ResidueField C)] (ℓ : ℕ), ℓ.Prime → IsUnit ((ℓ : ℕ) : C) → ∀ q : ℕ, 1 ≤ q → Subsingleton (wcEtCoh (Spec (.of (Polynomial C))) ℓ q) :=
by
  intro C _ _ _ ℓ hℓ hunit q hq
  classical

  have FT : (∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)], IsUnit (ℓ : A) → ∀ (x : Spec (.of (Polynomial A))), IsClosed ({x} : Set (Spec (.of (Polynomial A)))) → Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A))) x = IsLocalRing.closedPoint A → ∀ (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (Polynomial A))) x)) (Scheme.Etale.forget (Spec (.of (Polynomial A))))) (φ : ∀ l, Spec (.of B) ⟶ (W'.obj l).right.left) (a : Spec (.of B) ⟶ Spec (.of (Polynomial A))), wcHalShData x B Λ W' φ a → ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (z : Spec (.of Ω) ⟶ Spec (.of A)), Nat.card (wcEtCoh (Limits.pullback (a ≫ Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) z) ℓ 0) = ℓ ∧ ∀ q : ℕ, 1 ≤ q → Subsingleton (wcEtCoh (Limits.pullback (a ≫ Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) z) ℓ q)) := by
    intro A _ _ _ hA x hxc hx B _ _ _ Λ _ _ W' φ a hd Ω _ _ z
    refine ⟨wc_affine_line_milnor_fibre_h0_card ℓ hℓ A x hx B Λ W' φ a hd Ω z, fun q' hq' => ?_⟩
    rcases Nat.lt_or_ge q' 2 with h | h
    · obtain rfl : q' = 1 := by omega
      exact wc_affine_line_milnor_fibre_h1_vanishing_of_unit ℓ hℓ A hA x hxc hx B Λ W' φ a hd Ω z
    · exact wc_affine_line_milnor_fibre_cd_one_of_unit ℓ hℓ A hA x B Λ W' φ a hd Ω z q' h

  have hN : ∀ (B₀ : Type u) [CommRing B₀] [HenselianLocalRing B₀] [IsSepClosed (IsLocalRing.ResidueField B₀)] [IsNoetherianRing B₀], IsUnit ((ℓ : ℕ) : B₀) → ∀ q₀ : ℕ, 1 ≤ q₀ → Subsingleton (wcEtCoh (Spec (.of (Polynomial B₀))) ℓ q₀) := by
    intro B₀ _ _ _ _ hB₀ q₀ hq₀
    have key := wc_shens_tube_acyclic_of_geom_fibres ℓ hℓ (Spec (.of (Polynomial B₀))) (Spec (.of B₀))
      (Spec.map (CommRingCat.ofHom (algebraMap B₀ (Polynomial B₀)))) B₀ (𝟙 _) (by
        intro C' _ _ _ φc hφc Ω _ _ z
        have hu' : IsUnit ((ℓ : ℕ) : C') := by simpa using hB₀.map φc
        obtain ⟨θ, hθ⟩ := wc_cpt_th_poly_base_change_iso B₀ C' φc
          (Spec.map (CommRingCat.ofHom φc) ≫ 𝟙 _) (by simp)
        refine ⟨?_, ?_, ?_⟩
        ·
          let γ : B₀ →+* Ω :=
            (Spec.preimage (z ≫ Spec.map (CommRingCat.ofHom φc) ≫ 𝟙 (Spec (.of B₀)))).hom
          obtain ⟨θΩ, -⟩ := wc_cpt_th_poly_base_change_iso B₀ Ω γ
            (z ≫ Spec.map (CommRingCat.ofHom φc) ≫ 𝟙 (Spec (.of B₀)))
            (by simp only [γ, CommRingCat.ofHom_hom, Spec.map_preimage])
          have hℓΩ : (ℓ : Ω) ≠ 0 := by
            have := hB₀.map γ
            rw [map_natCast] at this
            exact this.ne_zero
          obtain ⟨h0, hpos⟩ := wc_et_algclosed_affine_line_acyclic Ω ℓ hℓ hℓΩ
          have E : ∀ q', Nonempty (wcEtCoh (Spec (.of (Polynomial Ω))) ℓ q' ≃
              wcEtCoh (Limits.pullback (Limits.pullback.snd
                (Spec.map (CommRingCat.ofHom (algebraMap B₀ (Polynomial B₀))))
                (Spec.map (CommRingCat.ofHom φc) ≫ 𝟙 (Spec (.of B₀)))) z) ℓ q') := fun q' =>
            wc_et_coh_iso_invariance ((Limits.pullbackLeftPullbackSndIso
              (Spec.map (CommRingCat.ofHom (algebraMap B₀ (Polynomial B₀))))
              (Spec.map (CommRingCat.ofHom φc) ≫ 𝟙 (Spec (.of B₀))) z) ≪≫ θΩ).hom ℓ q'
          refine ⟨?_, fun q' hq' => ?_⟩
          · obtain ⟨e0⟩ := E 0
            exact (Nat.card_congr e0).symm.trans h0
          · obtain ⟨e⟩ := E q'
            haveI := hpos q' hq'
            exact e.symm.subsingleton
        ·
          intro I n hn
          exact wc_cpt_th_iso_bc_higher_vanish ℓ C' Ω z
            (wc_poly_shens_milnor_fibre_higher_vanish_all_points ℓ C' Ω z
              (wc_poly_milnor_tube_acyclic_of_field_test ℓ hℓ FT C' hu' Ω z)) _ _ θ hθ I n hn
        ·
          intro L hL
          exact wc_cpt_th_iso_bc_push_transport θ _ _ hθ z ℓ
            (fun L' hL' => wc_poly_geom_push_base_change_of_field_test ℓ hℓ FT C' hu' L' hL' Ω z) L hL)
    obtain ⟨e⟩ := wc_et_coh_iso_invariance (Limits.pullback.fst
      (Spec.map (CommRingCat.ofHom (algebraMap B₀ (Polynomial B₀)))) (𝟙 (Spec (.of B₀)))) ℓ q₀
    haveI := key.2 q₀ hq₀
    exact e.subsingleton
  exact wc_cpt_th_poly_noetherian_reduction ℓ q (fun B₀ _ _ _ _ hB₀ => hN B₀ hB₀ q hq) C hunit

theorem wc_cpt_th_leray_column_vanish : ∀ {C : Type*} {D : Type*} [Category C] [Category D] [Abelian C] [Abelian D] [EnoughInjectives D] (L : D ⥤ C) (R : C ⥤ D) [R.Additive] (adj : L ⊣ R) [Limits.PreservesFiniteLimits L] (P : D) (A : C) (I : InjectiveResolution A) (N : ℕ), letI := HasExt.standard C; letI := HasExt.standard D; (∀ p q : ℕ, 1 ≤ p → 1 ≤ q → Subsingleton (Abelian.Ext P (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q) p)) → (∀ m : ℕ, N + 1 ≤ m → Subsingleton (Abelian.Ext P (R.obj A) m)) → (∀ n : ℕ, N ≤ n → Subsingleton (Abelian.Ext (L.obj P) A n)) → ∀ q : ℕ, N ≤ q → Subsingleton (Abelian.Ext P (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q) 0) :=
by
  intro C D _ _ _ _ _ L R _ adj _ P A I N
