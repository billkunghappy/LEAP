    have hβφ : (adj.homEquiv G G') φ = β := Equiv.apply_symm_apply _ _
    have hK : α G ≫ Functor.whiskerLeft B.op φ.hom = α' := by
      have h1 : (α G ≫ Functor.whiskerLeft B.op φ.hom) ≫ (e G').hom = α' ≫ (e G').hom := by
        rw [Category.assoc, ← hhom G G' φ, hβφ]
        rfl
      exact (cancel_mono (e G').hom).mp h1
    refine ⟨φ, ?_, ?_⟩
    · intro V O h hh x
      have hm : (α G).app (Opposite.op V) ≫ (L.obj G).obj.map (u V O h hh).op ≫
            φ.hom.app (Opposite.op O) =
          α'.app (Opposite.op V) ≫ G'.obj.map (u V O h hh).op := by
        rw [φ.hom.naturality, ← Category.assoc, ← NatTrans.congr_app hK (Opposite.op V)]
        rfl
      rw [star G G' T' V O h hh x]
      exact congrArg (fun f => f.hom x) hm
    · intro ψ hψ
      have hK' : α G ≫ Functor.whiskerLeft B.op ψ.hom = α' := by
        ext V x
        have := hψ V.unop (B.obj V.unop) (Limits.pullback.fst V.unop.hom g)
          Limits.pullback.condition x
        rw [hT] at this
        exact this
      apply (adj.homEquiv G G').injective
      apply ObjectProperty.hom_ext
      rw [hhom, hhom, reassoc_of% hK', reassoc_of% hK]
  · intro G V x
    rw [hT]
    have hid : (adj.unit.app G).hom ≫ (e (L.obj G)).inv ≫ (e (L.obj G)).hom =
        (adj.unit.app G).hom := by rw [Iso.inv_hom_id, Category.comp_id]
    exact (congrArg (fun f => (f.app (Opposite.op V)).hom x) hid).symm

theorem wc_et_transport_unit_stalk_injective : ∀ {Z B : Scheme.{u}} (g : Z ⟶ B) (L : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1} ⥤ Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) (adj : L ⊣ wcEtPush g) (F : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}) (ρ : wcEtTransport g F (L.obj F)), wcEtTransportUniv ρ → (∀ (V : B.Etale) (x : F.obj.obj (Opposite.op V)), ((adj.unit.app F).hom.app (Opposite.op V)).hom x = ((toSheafify (Scheme.smallEtaleTopology B) ((wcEtBaseChange g).op ⋙ (L.obj F).obj)).app (Opposite.op V)).hom (ρ.ρ V ((wcEtBaseChange g).obj V) (Limits.pullback.fst V.hom g) Limits.pullback.condition x)) → ∀ z : Z, Function.Injective ((wcEtStalk B (g z)).map (adj.unit.app F)).hom :=
by
  intro Z B g L adj F ρ hρ hu z
  classical
  haveI := wc_et_basechange_isContinuous g
  have hcof := wc_et_geomstalk_cofiltered B (g z) wc_etale_maps_agree_near_geom_point
  obtain ⟨G1, -, -⟩ := wc_et_stalk_germ_facts B (g z) hcof F
  obtain ⟨-, G2P, G3⟩ := wc_et_stalk_germ_facts B (g z) hcof ((wcEtPush g).obj (L.obj F))

  haveI hiso : IsIso (toSheafify (Scheme.smallEtaleTopology B)
      ((wcEtBaseChange g).op ⋙ (L.obj F).obj)) :=
    isIso_toSheafify _ (Functor.op_comp_isSheaf (wcEtBaseChange g) (Scheme.smallEtaleTopology B)
      (Scheme.smallEtaleTopology Z) (L.obj F))
  have hθ : ∀ V : B.Etale, Function.Injective ((toSheafify (Scheme.smallEtaleTopology B)
      ((wcEtBaseChange g).op ⋙ (L.obj F).obj)).app (Opposite.op V)).hom := by
    intro V
    haveI := NatIso.isIso_app_of_isIso (toSheafify (Scheme.smallEtaleTopology B)
      ((wcEtBaseChange g).op ⋙ (L.obj F).obj)) (Opposite.op V)
    exact (ConcreteCategory.bijective_of_isIso ((toSheafify (Scheme.smallEtaleTopology B)
      ((wcEtBaseChange g).op ⋙ (L.obj F).obj)).app (Opposite.op V))).1
  rw [injective_iff_map_eq_zero]
  intro ξ hξ
  obtain ⟨A, s, rfl⟩ := G1 ξ
  have hξ' := (G3 F (adj.unit.app F) A s).symm.trans hξ
  obtain ⟨A'', f, f', hff⟩ := G2P A A _ 0 (hξ'.trans (map_zero _).symm)
  rw [map_zero] at hff

  let s'' : F.obj.obj (Opposite.op A''.right) := (F.obj.map f.right.op).hom s
  have hus : ((adj.unit.app F).hom.app (Opposite.op A''.right)).hom s'' = 0 :=
    (NatTrans.naturality_apply (adj.unit.app F).hom f.right.op s).trans hff
  have hr : ρ.ρ A''.right ((wcEtBaseChange g).obj A''.right) (Limits.pullback.fst A''.right.hom g)
      Limits.pullback.condition s'' = 0 :=
    hθ _ (((hu A''.right s'').symm.trans hus).trans (map_zero _).symm)

  have hw : A''.hom.left ≫ A''.right.hom = wcEtGeomPt B (g z) := Over.w A''.hom
  have hb : A''.right.hom (A''.hom.left
      (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField (g z))))) = g z := by
    have h1 := Scheme.Hom.comp_apply A''.hom.left A''.right.hom
      (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField (g z))))
    have hgp : (wcEtGeomPt B (g z))
        (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField (g z)))) = g z := by
      exact (Scheme.Hom.comp_apply (Spec.map (CommRingCat.ofHom (algebraMap (B.residueField (g z))
        (AlgebraicClosure (B.residueField (g z)))))) (B.fromSpecResidueField (g z))
        (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField (g z))))).trans
        (Scheme.fromSpecResidueField_apply _ _)
    exact h1.symm.trans ((congrArg (fun k : Spec (.of (AlgebraicClosure (B.residueField (g z)))) ⟶ B =>
      k (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField (g z))))) hw).trans hgp)
  obtain ⟨o, ho, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := A''.right.hom) (g := g) _ z hb
  obtain ⟨V', c, v', hcv, hzero⟩ := wc_et_univ_transport_locally_injective g F (L.obj F) ρ hρ
    A''.right ((wcEtBaseChange g).obj A''.right) (Limits.pullback.fst A''.right.hom g)
    Limits.pullback.condition s'' o hr

  haveI : Etale c.left := MorphismProperty.of_postcomp @Etale (W' := @Etale) c.left A''.right.hom
    A''.right.prop (by rw [MorphismProperty.Over.w c]; exact V'.prop)
  obtain ⟨t', ht', -⟩ := wc_etale_lift_alg_closed_point (AlgebraicClosure (B.residueField (g z)))
    c.left A''.hom.left v' (hcv.trans ho)
  have ht'V : t' ≫ ((Scheme.Etale.forget B).obj V').hom = (Over.mk (wcEtGeomPt B (g z))).hom := by
    show t' ≫ V'.hom = wcEtGeomPt B (g z)
    rw [← MorphismProperty.Over.w c, ← Category.assoc, ht']
    exact hw
  let A' : StructuredArrow (Over.mk (wcEtGeomPt B (g z))) (Scheme.Etale.forget B) :=
    StructuredArrow.mk (Y := V') (Over.homMk t' ht'V)
  let φ : A' ⟶ A'' := StructuredArrow.homMk c (by
    apply Over.OverMorphism.ext
    exact ht')
  let D := (StructuredArrow.proj (Over.mk (wcEtGeomPt B (g z))) (Scheme.Etale.forget B)).op ⋙ F.obj
  have e1 := Limits.colimit.w_apply D φ.op s''
  have e2 := Limits.colimit.w_apply D f.op s
  calc (Limits.colimit.ι D (Opposite.op A)).hom s
      = (Limits.colimit.ι D (Opposite.op A'')).hom s'' := e2.symm
    _ = (Limits.colimit.ι D (Opposite.op A')).hom ((F.obj.map c.op).hom s'') := e1.symm
    _ = 0 := (congrArg (Limits.colimit.ι D (Opposite.op A')).hom hzero).trans (map_zero _)

theorem wc_et_closed_transport_unit_stalk_surjective : ∀ {Z B : Scheme.{u}} (i : Z ⟶ B) [IsClosedImmersion i] (L : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1} ⥤ Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) (adj : L ⊣ wcEtPush i) (F : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}) (ρ : wcEtTransport i F (L.obj F)), wcEtTransportUniv ρ → (∀ (V : B.Etale) (x : F.obj.obj (Opposite.op V)), ((adj.unit.app F).hom.app (Opposite.op V)).hom x = ((toSheafify (Scheme.smallEtaleTopology B) ((wcEtBaseChange i).op ⋙ (L.obj F).obj)).app (Opposite.op V)).hom (ρ.ρ V ((wcEtBaseChange i).obj V) (Limits.pullback.fst V.hom i) Limits.pullback.condition x)) → ∀ z : Z, Function.Surjective ((wcEtStalk B (i z)).map (adj.unit.app F)).hom :=
by
  intro Z B i _ L adj F ρ hρ hu z
  classical

  have hcof := wc_et_geomstalk_cofiltered B (i z) wc_etale_maps_agree_near_geom_point
  obtain ⟨hP1, -, hP3⟩ := wc_et_stalk_germ_facts B (i z) hcof ((wcEtPush i).obj (L.obj F))
  intro η
  obtain ⟨A, w, rfl⟩ := hP1 η

  haveI := wc_et_basechange_isContinuous i
  have hsh : Presheaf.IsSheaf (Scheme.smallEtaleTopology B)
      ((wcEtBaseChange i).op ⋙ (L.obj F).obj) :=
    Functor.op_comp_isSheaf (wcEtBaseChange i) (Scheme.smallEtaleTopology B)
      (Scheme.smallEtaleTopology Z) (L.obj F)
  haveI := isIso_toSheafify (Scheme.smallEtaleTopology B) hsh
  have hθbij : ∀ V : B.Etale, Function.Bijective
      ((toSheafify (Scheme.smallEtaleTopology B)
        ((wcEtBaseChange i).op ⋙ (L.obj F).obj)).app (Opposite.op V)).hom := fun V =>
    ConcreteCategory.bijective_of_isIso _
  obtain ⟨w₀, hw₀⟩ := (hθbij A.right).2 w

  have hgA : A.hom.left ≫ A.right.hom = wcEtGeomPt B (i z) := Over.w A.hom
  have hpt : A.right.hom (A.hom.left (IsLocalRing.closedPoint
      (AlgebraicClosure (B.residueField (i z))))) = i z := by
    have h1 := congrArg (fun g : Spec (.of (AlgebraicClosure (B.residueField (i z)))) ⟶ B =>
      g (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField (i z))))) hgA
    refine (Scheme.Hom.comp_apply A.hom.left A.right.hom _).symm.trans (h1.trans ?_)
    exact (Scheme.Hom.comp_apply _ _ _).trans (Scheme.fromSpecResidueField_apply (i z) _)
  obtain ⟨z₀, hz₀, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := A.right.hom) (g := i)
    _ z hpt

  obtain ⟨T', c, x', y, hc1, hc2⟩ := wc_et_closed_transport_lift i F (L.obj F) ρ
    (wc_et_univ_transport_locally_surjective i F (L.obj F) ρ hρ)
    (wc_etale_lift_closed_immersion wc_etale_lift_quotient_alg)
    (wc_et_closed_section_extend i wc_etale_maps_agree_near_geom_point)
    A.right w₀ z₀

  have hcw : c.left ≫ A.right.hom = T'.hom := MorphismProperty.Over.w c
  have hcomp : Etale (c.left ≫ A.right.hom) := by
    first
    | exact hcw ▸ T'.prop
    | (rw [hcw]; exact T'.prop)
    | simpa only [hcw] using T'.prop
  haveI : Etale c.left :=
    MorphismProperty.of_postcomp @Etale (W' := @Etale) c.left A.right.hom A.right.prop hcomp
  obtain ⟨t', ht'1, -⟩ := wc_etale_lift_alg_closed_point
    (AlgebraicClosure (B.residueField (i z))) c.left A.hom.left x' (hc1.trans hz₀)
  have h₁ : t' ≫ T'.hom = wcEtGeomPt B (i z) :=
    (congrArg (fun g => t' ≫ g) hcw).symm.trans ((Category.assoc _ _ _).symm.trans
      ((congrArg (fun g => g ≫ A.right.hom) ht'1).trans hgA))
  let A' : StructuredArrow (Over.mk (wcEtGeomPt B (i z))) (Scheme.Etale.forget B) :=
    StructuredArrow.mk (Y := T')
      (Over.homMk t' h₁ : Over.mk (wcEtGeomPt B (i z)) ⟶ (Scheme.Etale.forget B).obj T')
  let f : A' ⟶ A := StructuredArrow.homMk c (by
    apply Over.OverMorphism.ext
    exact ht'1)

  have key : ((adj.unit.app F).hom.app (Opposite.op T')).hom y =
      (((wcEtPush i).obj (L.obj F)).obj.map c.op).hom w := by
    rw [hu T' y, ← hc2, ← hw₀]
    exact NatTrans.naturality_apply (toSheafify (Scheme.smallEtaleTopology B)
      ((wcEtBaseChange i).op ⋙ (L.obj F).obj)) c.op w₀
  refine ⟨(Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt B (i z)))
    (Scheme.Etale.forget B)).op ⋙ F.obj) (Opposite.op A')).hom y, ?_⟩
  refine (hP3 F (adj.unit.app F) A' y).trans ?_
  have hw := Limits.colimit.w_apply ((StructuredArrow.proj (Over.mk (wcEtGeomPt B (i z)))
    (Scheme.Etale.forget B)).op ⋙ ((wcEtPush i).obj (L.obj F)).obj) f.op w
  refine Eq.trans ?_ hw
  first
  | exact congrArg _ key
  | exact congrArg (fun x => (Limits.colimit.ι ((StructuredArrow.proj
      (Over.mk (wcEtGeomPt B (i z))) (Scheme.Etale.forget B)).op ⋙
        ((wcEtPush i).obj (L.obj F)).obj) (Opposite.op A')).hom x) key
  | (rw [key]; rfl)

theorem wc_et_closed_unit_stalk_iso {Z B : Scheme.{u}} (i : Z ⟶ B) [IsClosedImmersion i]
    (L : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1} ⥤
      Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1})
    (adj : L ⊣ wcEtPush i) (F : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}) (z : Z) :
    Function.Bijective ((wcEtStalk B (i z)).map (adj.unit.app F)).hom :=
by
  obtain ⟨ρ, hρ, hu⟩ := wc_et_unit_univ_transport i L adj
  exact ⟨wc_et_transport_unit_stalk_injective i L adj F (ρ F) (hρ F) (hu F) z,
    wc_et_closed_transport_unit_stalk_surjective i L adj F (ρ F) (hρ F) (hu F) z⟩

theorem wc_et_ab_ext_vanish_of_closed_fibre_stalks (A : Type u) [CommRing A] [HenselianLocalRing A]
    [IsSepClosed (IsLocalRing.ResidueField A)] (Y : Scheme.{u}) (f : Y ⟶ Spec (.of A)) [IsProper f]
    (n : ℕ) (hn : 0 < n) (N : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})
    (hN : n • 𝟙 N = 0)
    (hst : ∀ y : Y, f y = IsLocalRing.closedPoint A → Subsingleton ((wcEtStalk Y y).obj N)) :
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
    ∀ p : ℕ, Subsingleton (Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y)
      AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) N p) :=
by
  intro p
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
  obtain ⟨α, hα1, hα2, -⟩ := wc_et_zmod_ring_locbij Y n
  obtain ⟨-, hess⟩ := sheafOfModules_toSheaf_torsion_equiv (Scheme.smallEtaleTopology Y)
    (wcEtZModRing Y n) n α hα1 hα2
  obtain ⟨N', ⟨e⟩⟩ := hess N hN
  have hst' : ∀ x : Y, f x = IsLocalRing.closedPoint A →
      Subsingleton ((wcEtStalk Y x).obj ((SheafOfModules.toSheaf (wcEtZModRing Y n)).obj N')) := by
    intro x hx
    haveI := hst x hx
    exact ((wcEtStalk Y x).mapIso e).addCommGroupIsoToAddEquiv.toEquiv.subsingleton
  have h1 := wc_et_module_ext_vanish_of_closed_fibre_stalks A Y f n hn N' hst' p
  obtain ⟨E⟩ := wc_et_zmod_modext_toSheaf_equiv Y n hn N' p
  haveI := h1
  haveI hT := E.symm.subsingleton
  refine ⟨fun y₁ y₂ => ?_⟩
  have key : ∀ y : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y)
      AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) N p,
      (y.comp (Abelian.Ext.mk₀ e.inv) (add_zero p)).comp (Abelian.Ext.mk₀ e.hom) (add_zero p) = y := by
    intro y
    rw [Abelian.Ext.comp_assoc_of_second_deg_zero, Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id,
      Abelian.Ext.comp_mk₀_id]
  rw [← key y₁, ← key y₂, Subsingleton.elim (y₁.comp (Abelian.Ext.mk₀ e.inv) (add_zero p))
    (y₂.comp (Abelian.Ext.mk₀ e.inv) (add_zero p))]

theorem wc_derived_single_hom_vanish_of_isGE {C : Type*} [Category C] [Abelian C]
    [HasDerivedCategory C] (X : C) (Y : DerivedCategory C) (a : ℤ) (hY : Y.IsGE a)
    (h : ∀ (j : ℤ) (p : ℕ), Subsingleton ((DerivedCategory.singleFunctor C 0).obj X ⟶
      (shiftFunctor (DerivedCategory C) (p : ℤ)).obj ((DerivedCategory.singleFunctor C 0).obj
        ((DerivedCategory.homologyFunctor C j).obj Y)))) :
    ∀ q : ℤ, Subsingleton ((DerivedCategory.singleFunctor C 0).obj X ⟶
      (shiftFunctor (DerivedCategory C) q).obj Y) :=
by
  classical

  have two3 : ∀ (T : Pretriangulated.Triangle (DerivedCategory C)),
      T ∈ Pretriangulated.distinguishedTriangles → ∀ (W : DerivedCategory C) (q : ℤ),
      Subsingleton (W ⟶ (shiftFunctor (DerivedCategory C) q).obj T.obj₁) →
      Subsingleton (W ⟶ (shiftFunctor (DerivedCategory C) q).obj T.obj₃) →
      Subsingleton (W ⟶ (shiftFunctor (DerivedCategory C) q).obj T.obj₂) := by
    intro T hT W q h1 h3
    have hT' := Pretriangulated.Triangle.shift_distinguished T hT q
    rw [Pretriangulated.Triangle.shiftFunctor_eq] at hT'
    have key : ∀ f : W ⟶ (shiftFunctor (DerivedCategory C) q).obj T.obj₂, f = 0 := by
      intro f
      obtain ⟨g, hg⟩ := Pretriangulated.Triangle.coyoneda_exact₂ _ hT' (X := W) f
        (@Subsingleton.elim _ h3 _ _)
      have h1' : Subsingleton (W ⟶
          ((Pretriangulated.Triangle.shiftFunctor (DerivedCategory C) q).obj T).obj₁) := h1
      rw [hg, Subsingleton.elim g 0, Limits.zero_comp]
      rfl
    exact ⟨fun f g => (key f).trans (key g).symm⟩

  have low : ∀ (Z : DerivedCategory C) (b q : ℤ), Z.IsGE b → q < b →
      Subsingleton ((DerivedCategory.singleFunctor C 0).obj X ⟶
        (shiftFunctor (DerivedCategory C) q).obj Z) := by
    intro Z b q hZ hqb
    haveI := hZ
    haveI : DerivedCategory.TStructure.t.IsGE ((shiftFunctor (DerivedCategory C) q).obj Z) (b - q) :=
      DerivedCategory.TStructure.t.isGE_shift Z b q (b - q) (by omega)
    refine ⟨fun f g => ?_⟩
    rw [DerivedCategory.TStructure.t.zero_of_isLE_of_isGE f 0 (b - q) (by omega) inferInstance
        inferInstance,
      DerivedCategory.TStructure.t.zero_of_isLE_of_isGE g 0 (b - q) (by omega) inferInstance
        inferInstance]

  have tr : ∀ (U V : C), (U ≅ V) → ∀ p : ℕ,
      Subsingleton ((DerivedCategory.singleFunctor C 0).obj X ⟶
        (shiftFunctor (DerivedCategory C) (p : ℤ)).obj ((DerivedCategory.singleFunctor C 0).obj V)) →
      Subsingleton ((DerivedCategory.singleFunctor C 0).obj X ⟶
        (shiftFunctor (DerivedCategory C) (p : ℤ)).obj ((DerivedCategory.singleFunctor C 0).obj U)) :=
    fun U V e p hV => @Equiv.subsingleton _ _ (Iso.homCongr (Iso.refl _)
      ((shiftFunctor (DerivedCategory C) (p : ℤ)).mapIso
        ((DerivedCategory.singleFunctor C 0).mapIso e))) hV
  have zr : ∀ (U : C), Limits.IsZero U → ∀ p : ℕ,
      Subsingleton ((DerivedCategory.singleFunctor C 0).obj X ⟶
        (shiftFunctor (DerivedCategory C) (p : ℤ)).obj ((DerivedCategory.singleFunctor C 0).obj U)) :=
    fun U hU p => ⟨fun f g => (Functor.map_isZero _ (Functor.map_isZero _ hU)).eq_of_tgt f g⟩

  have single : ∀ (Z : DerivedCategory C) (b q : ℤ), Z.IsGE b → Z.IsLE b → b ≤ q →
      (∀ p : ℕ, Subsingleton ((DerivedCategory.singleFunctor C 0).obj X ⟶
        (shiftFunctor (DerivedCategory C) (p : ℤ)).obj ((DerivedCategory.singleFunctor C 0).obj
          ((DerivedCategory.homologyFunctor C b).obj Z)))) →
      Subsingleton ((DerivedCategory.singleFunctor C 0).obj X ⟶
        (shiftFunctor (DerivedCategory C) q).obj Z) := by
    intro Z b q hGE hLE hbq hZ
    haveI := hGE
    haveI := hLE
    obtain ⟨M, ⟨e⟩⟩ := DerivedCategory.exists_iso_singleFunctor_obj_of_isGE_of_isLE Z b
    obtain ⟨p, hp⟩ : ∃ p : ℕ, (p : ℤ) = q - b := ⟨(q - b).toNat, Int.toNat_of_nonneg (by omega)⟩
    let eM : M ≅ (DerivedCategory.homologyFunctor C b).obj Z :=
      ((DerivedCategory.singleFunctorCompHomologyFunctorIso C b).app M).symm ≪≫
        ((DerivedCategory.homologyFunctor C b).mapIso e).symm
    let φ : (shiftFunctor (DerivedCategory C) q).obj Z ≅
        (shiftFunctor (DerivedCategory C) (p : ℤ)).obj ((DerivedCategory.singleFunctor C 0).obj
          ((DerivedCategory.homologyFunctor C b).obj Z)) :=
      (shiftFunctor (DerivedCategory C) q).mapIso e ≪≫
        ((DerivedCategory.singleFunctors C).shiftIso q (-(p : ℤ)) b (by omega)).app M ≪≫
        (((DerivedCategory.singleFunctors C).shiftIso (p : ℤ) (-(p : ℤ)) 0 (by omega)).app M).symm ≪≫
        (shiftFunctor (DerivedCategory C) (p : ℤ)).mapIso
          ((DerivedCategory.singleFunctor C 0).mapIso eM)
    exact @Equiv.subsingleton _ _ (Iso.homCongr (Iso.refl _) φ) (hZ p)

  have main : ∀ (N : ℕ) (Z : DerivedCategory C) (b q : ℤ), Z.IsGE b → q - b < (N : ℤ) →
      (∀ (j : ℤ) (p : ℕ), Subsingleton ((DerivedCategory.singleFunctor C 0).obj X ⟶
        (shiftFunctor (DerivedCategory C) (p : ℤ)).obj ((DerivedCategory.singleFunctor C 0).obj
          ((DerivedCategory.homologyFunctor C j).obj Z)))) →
      Subsingleton ((DerivedCategory.singleFunctor C 0).obj X ⟶
        (shiftFunctor (DerivedCategory C) q).obj Z) := by
    intro N
    induction N with
    | zero =>
      intro Z b q hZ hqb _
      exact low Z b q hZ (by omega)
    | succ N ih =>
      intro Z b q hZ hqb hZh
      by_cases hq : q < b
      · exact low Z b q hZ hq
      push_neg at hq
      obtain ⟨T, hTeq⟩ : ∃ T, T = (DerivedCategory.TStructure.t.triangleLTGE (b + 1)).obj Z :=
        ⟨_, rfl⟩
      have hT : T ∈ Pretriangulated.distinguishedTriangles := by
        rw [hTeq]; exact DerivedCategory.TStructure.t.triangleLTGE_distinguished (b + 1) Z
      have h2 : T.obj₂ = Z := by
        rw [hTeq, Triangulated.TStructure.triangleLTGE_obj_obj₂]
      haveI h1 : DerivedCategory.TStructure.t.IsLE T.obj₁ b := by
        rw [hTeq, Triangulated.TStructure.triangleLTGE_obj_obj₁]
        exact DerivedCategory.TStructure.t.isLE_of_le _ (b + 1 - 1) b (by omega)
      haveI h3 : DerivedCategory.TStructure.t.IsGE T.obj₃ (b + 1) := by
        rw [hTeq, Triangulated.TStructure.triangleLTGE_obj_obj₃]
        infer_instance
      haveI h2GE : T.obj₂.IsGE b := by rw [h2]; exact hZ
      have hZh2 : ∀ (j : ℤ) (p : ℕ), Subsingleton ((DerivedCategory.singleFunctor C 0).obj X ⟶
          (shiftFunctor (DerivedCategory C) (p : ℤ)).obj ((DerivedCategory.singleFunctor C 0).obj
            ((DerivedCategory.homologyFunctor C j).obj T.obj₂))) := by
        rw [h2]; exact hZh
      have iso1 : ∀ j : ℤ, j < b + 1 →
          IsIso ((DerivedCategory.homologyFunctor C j).map T.mor₁) := by
        intro j hj
        have hm : Mono ((DerivedCategory.homologyFunctor C j).map T.mor₁) :=
          (DerivedCategory.HomologySequence.exact₁ T hT (j - 1) j (by omega)).mono_g
            ((DerivedCategory.isZero_of_isGE T.obj₃ (b + 1) (j - 1) (by omega)).eq_of_src _ _)
        have he : Epi ((DerivedCategory.homologyFunctor C j).map T.mor₁) :=
          (DerivedCategory.HomologySequence.exact₂ T hT j).epi_f
            ((DerivedCategory.isZero_of_isGE T.obj₃ (b + 1) j (by omega)).eq_of_tgt _ _)
        exact isIso_of_mono_of_epi _
      have iso2 : ∀ j : ℤ, b + 1 ≤ j →
          IsIso ((DerivedCategory.homologyFunctor C j).map T.mor₂) := by
        intro j hj
        have hm : Mono ((DerivedCategory.homologyFunctor C j).map T.mor₂) :=
          (DerivedCategory.HomologySequence.exact₂ T hT j).mono_g
            ((DerivedCategory.isZero_of_isLE T.obj₁ b j (by omega)).eq_of_src _ _)
        have he : Epi ((DerivedCategory.homologyFunctor C j).map T.mor₂) :=
          (DerivedCategory.HomologySequence.exact₃ T hT j (j + 1) rfl).epi_f
            ((DerivedCategory.isZero_of_isLE T.obj₁ b (j + 1) (by omega)).eq_of_tgt _ _)
        exact isIso_of_mono_of_epi _
      have h1GE : T.obj₁.IsGE b := by
        rw [DerivedCategory.isGE_iff]
        intro i hi
        haveI := iso1 i (by omega)
        exact (DerivedCategory.isZero_of_isGE T.obj₂ b i hi).of_iso
          (asIso ((DerivedCategory.homologyFunctor C i).map T.mor₁))
      have hA : Subsingleton ((DerivedCategory.singleFunctor C 0).obj X ⟶
          (shiftFunctor (DerivedCategory C) q).obj T.obj₁) := by
        haveI := iso1 b (by omega)
        exact single T.obj₁ b q h1GE h1 hq (fun p => tr _ _
          (asIso ((DerivedCategory.homologyFunctor C b).map T.mor₁)) p (hZh2 b p))
      have hB : Subsingleton ((DerivedCategory.singleFunctor C 0).obj X ⟶
          (shiftFunctor (DerivedCategory C) q).obj T.obj₃) := by
        refine ih T.obj₃ (b + 1) q h3 (by omega) (fun j p => ?_)
        by_cases hj : j < b + 1
        · exact zr _ (DerivedCategory.isZero_of_isGE T.obj₃ (b + 1) j hj) p
        · haveI := iso2 j (by omega)
          exact tr _ _ (asIso ((DerivedCategory.homologyFunctor C j).map T.mor₂)).symm p (hZh2 j p)
      rw [← h2]
      exact two3 T hT _ q hA hB
  intro q
  exact main ((q - a).natAbs + 1) Y a q hY (by omega) h

theorem wc_derived_hom_exact_adjoint_transfer {C D : Type*} [Category C] [Category D] [Abelian C]
    [Abelian D] [HasDerivedCategory C] [HasDerivedCategory D] (F : C ⥤ D) (R : D ⥤ C) (adj : F ⊣ R)
    [F.Additive] [R.Additive] [Limits.PreservesFiniteLimits F] [Limits.PreservesFiniteColimits F]
    [Limits.PreservesFiniteLimits R] [Limits.PreservesFiniteColimits R] (X : C)
    (Kc : CochainComplex D ℤ) (n : ℤ) :
    Nonempty (((DerivedCategory.singleFunctor D 0).obj (F.obj X) ⟶
        (shiftFunctor (DerivedCategory D) n).obj (DerivedCategory.Q.obj Kc)) ≃
      ((DerivedCategory.singleFunctor C 0).obj X ⟶ (shiftFunctor (DerivedCategory C) n).obj
        (DerivedCategory.Q.obj ((R.mapHomologicalComplex (ComplexShape.up ℤ)).obj Kc)))) :=
by
  let adjC : F.mapHomologicalComplex (ComplexShape.up ℤ) ⊣
      R.mapHomologicalComplex (ComplexShape.up ℤ) :=
    Adjunction.mkOfUnitCounit
      { unit :=
          { app := fun K =>
              { f := fun i => adj.unit.app (K.X i)
                comm' := by
                  intro i j _
                  simp only [Functor.mapHomologicalComplex_obj_X, Functor.id_obj,
                    Functor.comp_obj, Functor.mapHomologicalComplex_obj_d]
                  exact (adj.unit.naturality (K.d i j)).symm }
            naturality := by
              intro K L φ
              ext i
              simp only [Functor.id_obj, Functor.comp_obj, Functor.id_map,
                HomologicalComplex.comp_f, Functor.comp_map,
                Functor.mapHomologicalComplex_map_f]
              exact adj.unit.naturality (φ.f i) }
        counit :=
          { app := fun L =>
              { f := fun i => adj.counit.app (L.X i)
                comm' := by
                  intro i j _
                  simp only [Functor.mapHomologicalComplex_obj_X, Functor.id_obj,
                    Functor.comp_obj, Functor.mapHomologicalComplex_obj_d]
                  exact (adj.counit.naturality (L.d i j)).symm }
            naturality := by
              intro K L φ
              ext i
              simp only [Functor.id_obj, Functor.comp_obj, Functor.id_map,
                HomologicalComplex.comp_f, Functor.comp_map,
                Functor.mapHomologicalComplex_map_f]
              exact adj.counit.naturality (φ.f i) }
        left_triangle := by
          ext K i
          simp
        right_triangle := by
          ext L i
          simp }
  letI : CatCommSq (F.mapHomologicalComplex (ComplexShape.up ℤ)) DerivedCategory.Q
      DerivedCategory.Q F.mapDerivedCategory := ⟨F.mapDerivedCategoryFactors.symm⟩
  letI : CatCommSq (R.mapHomologicalComplex (ComplexShape.up ℤ)) DerivedCategory.Q
      DerivedCategory.Q R.mapDerivedCategory := ⟨R.mapDerivedCategoryFactors.symm⟩
  let adjD := adjC.localization DerivedCategory.Q
    (HomologicalComplex.quasiIso C (ComplexShape.up ℤ)) DerivedCategory.Q
    (HomologicalComplex.quasiIso D (ComplexShape.up ℤ)) F.mapDerivedCategory R.mapDerivedCategory
  let e1 : F.mapDerivedCategory.obj ((DerivedCategory.singleFunctor C 0).obj X) ≅
      (DerivedCategory.singleFunctor D 0).obj (F.obj X) :=
    (F.mapDerivedCategorySingleFunctor 0).app X
  let e2 := (R.mapDerivedCategory.commShiftIso n).app (DerivedCategory.Q.obj Kc)
  let e3 := R.mapDerivedCategoryFactors.app Kc
  exact ⟨(Iso.homCongr e1 (Iso.refl _)).symm.trans ((adjD.homEquiv _ _).trans
    (Iso.homCongr (Iso.refl _) (e2 ≪≫ (shiftFunctor _ n).mapIso e3)))⟩

theorem wc_pretri_postcomp_bij_of_cone_hom_vanish {D : Type*} [Category D] [Limits.HasZeroObject D]
    [HasShift D ℤ] [Preadditive D] [∀ n : ℤ, (shiftFunctor D n).Additive] [Pretriangulated D]
    (T : Pretriangulated.Triangle D) (hT : T ∈ Pretriangulated.distinguishedTriangles) (S : D)
    (h : ∀ q : ℤ, Subsingleton (S ⟶ (shiftFunctor D q).obj T.obj₃)) (q : ℤ) :
    Function.Bijective (fun f : S ⟶ (shiftFunctor D q).obj T.obj₁ =>
      f ≫ (shiftFunctor D q).map T.mor₁) :=
by
  have hT₁ : (Pretriangulated.Triangle.shiftFunctor D q).obj T ∈
      Pretriangulated.distinguishedTriangles := by
    have := Pretriangulated.Triangle.shift_distinguished T hT q
    rwa [Pretriangulated.Triangle.shiftFunctor_eq] at this
  have hT₂ := Pretriangulated.inv_rot_of_distTriang _ hT₁
  constructor
  · intro φ₁ φ₂ hφ
    simp only at hφ
    have hd : (φ₁ - φ₂) ≫ (shiftFunctor D q).map T.mor₁ = 0 := by
      rw [Preadditive.sub_comp, hφ, sub_self]
    obtain ⟨k, hk⟩ := Pretriangulated.Triangle.coyoneda_exact₂ _ hT₂ (φ₁ - φ₂) (by
      show (φ₁ - φ₂) ≫ (q.negOnePow • (shiftFunctor D q).map T.mor₁) = 0
      rw [Linear.comp_units_smul, hd, smul_zero])
    have hsub : Subsingleton (S ⟶
        ((Pretriangulated.Triangle.shiftFunctor D q).obj T).invRotate.obj₁) := by
      have := h (q - 1)
      have e : (shiftFunctor D (q - 1)).obj T.obj₃ ≅
          ((Pretriangulated.Triangle.shiftFunctor D q).obj T).invRotate.obj₁ :=
        (shiftFunctorAdd' D q (-1) (q - 1) (by omega)).app T.obj₃
      exact (Iso.homCongr (Iso.refl S) e).symm.subsingleton
    have hk0 : k = 0 := Subsingleton.elim _ _
    rw [hk0, Limits.zero_comp] at hk
    exact sub_eq_zero.mp hk
  · intro g
    obtain ⟨f', hf'⟩ := Pretriangulated.Triangle.coyoneda_exact₂ _ hT₁ g
      (@Subsingleton.elim _ (h q) _ _)
    let f'' : S ⟶ (shiftFunctor D q).obj T.obj₁ := f'
    have hf2 : g = f'' ≫ (q.negOnePow • (shiftFunctor D q).map T.mor₁) := hf'
    refine ⟨q.negOnePow • f'', ?_⟩
    show (q.negOnePow • f'') ≫ (shiftFunctor D q).map T.mor₁ = g
    rw [Linear.units_smul_comp, hf2, Linear.comp_units_smul]

theorem wc_mappingCone_homology_torsion_sq {C : Type*} [Category C] [Abelian C]
    {K L : CochainComplex C ℤ} (φ : K ⟶ L) (m : ℕ) (hK : Homotopy (m • 𝟙 K) 0)
    (hL : Homotopy (m • 𝟙 L) 0) :
    ∀ j : ℤ, (m * m) • 𝟙 ((CochainComplex.mappingCone φ).homology j) = 0 :=
by
  intro j
  have hK' : m • 𝟙 ((HomotopyCategory.quotient C (ComplexShape.up ℤ)).obj K) = 0 := by
    rw [← CategoryTheory.Functor.map_id, ← CategoryTheory.Functor.map_nsmul,
      HomotopyCategory.eq_of_homotopy _ _ hK, CategoryTheory.Functor.map_zero]
  have hL' : m • 𝟙 ((HomotopyCategory.quotient C (ComplexShape.up ℤ)).obj L) = 0 := by
    rw [← CategoryTheory.Functor.map_id, ← CategoryTheory.Functor.map_nsmul,
      HomotopyCategory.eq_of_homotopy _ _ hL, CategoryTheory.Functor.map_zero]
  have hT : CochainComplex.mappingCone.triangleh φ ∈
      distTriang (HomotopyCategory C (ComplexShape.up ℤ)) :=
    HomotopyCategory.mappingCone_triangleh_distinguished φ
  have hK1 : m • 𝟙 ((shiftFunctor (HomotopyCategory C (ComplexShape.up ℤ)) (1 : ℤ)).obj
      (CochainComplex.mappingCone.triangleh φ).obj₁) = 0 := by
    rw [← CategoryTheory.Functor.map_id, ← CategoryTheory.Functor.map_nsmul]
    change (shiftFunctor (HomotopyCategory C (ComplexShape.up ℤ)) (1 : ℤ)).map
      (m • 𝟙 ((HomotopyCategory.quotient C (ComplexShape.up ℤ)).obj K)) = 0
    rw [hK', CategoryTheory.Functor.map_zero]
  have h3 : (m • 𝟙 (CochainComplex.mappingCone.triangleh φ).obj₃) ≫
      (CochainComplex.mappingCone.triangleh φ).mor₃ = 0 := by
    have e : m • (CochainComplex.mappingCone.triangleh φ).mor₃ =
        (CochainComplex.mappingCone.triangleh φ).mor₃ ≫ (m • 𝟙 _) := by
      rw [Preadditive.comp_nsmul, Category.comp_id]
    rw [Preadditive.nsmul_comp, Category.id_comp, e, hK1, Limits.comp_zero]
  obtain ⟨g, hg⟩ := Pretriangulated.Triangle.coyoneda_exact₃ _ hT
    (m • 𝟙 (CochainComplex.mappingCone.triangleh φ).obj₃) h3
  have h5 : (m * m) • 𝟙 (CochainComplex.mappingCone.triangleh φ).obj₃ = 0 := by
    have hL2 : m • 𝟙 (CochainComplex.mappingCone.triangleh φ).obj₂ = 0 := hL'
    have e : m • (CochainComplex.mappingCone.triangleh φ).mor₂ =
        (m • 𝟙 (CochainComplex.mappingCone.triangleh φ).obj₂) ≫
          (CochainComplex.mappingCone.triangleh φ).mor₂ := by
      rw [Preadditive.nsmul_comp, Category.id_comp]
    rw [mul_smul, hg, ← Preadditive.comp_nsmul, e, hL2, Limits.zero_comp, Limits.comp_zero]
  have hC : Homotopy ((m * m) • 𝟙 (CochainComplex.mappingCone φ)) 0 := by
    apply HomotopyCategory.homotopyOfEq
    rw [CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id,
      CategoryTheory.Functor.map_zero]
    exact h5
  have hh := hC.homologyMap_eq j
  rw [HomologicalComplex.homologyMap_zero] at hh
  have e : (HomologicalComplex.homologyFunctor C (ComplexShape.up ℤ) j).map
      ((m * m) • 𝟙 (CochainComplex.mappingCone φ)) =
      (m * m) • (HomologicalComplex.homologyFunctor C (ComplexShape.up ℤ) j).map
        (𝟙 (CochainComplex.mappingCone φ)) :=
    CategoryTheory.Functor.map_nsmul _
  rw [CategoryTheory.Functor.map_id] at e
  exact e.symm.trans hh

theorem wc_et_cone_stalk_zero {B : Scheme.{u}}
    {K L : CochainComplex (Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}) ℤ}
    (φ : K ⟶ L) (b : B)
    (h : ∀ n : ℤ, Function.Bijective ((wcEtStalk B b).map (φ.f n)).hom) :
    ∀ j : ℤ, Subsingleton ((wcEtStalk B b).obj ((CochainComplex.mappingCone φ).homology j)) :=
by
  intro j
  have hexact : Limits.PreservesFiniteLimits (wcEtStalk B b) ∧
      Limits.PreservesFiniteColimits (wcEtStalk B b) := by
    haveI : AB5OfSize.{u, u} AddCommGrpCat.{u+1} :=
      AB5OfSize_shrink.{u, u, u+1, u+1} AddCommGrpCat.{u+1}
    let Φ := Scheme.pointSmallEtale (wcEtGeomPt B b)
    let E : StructuredArrow (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B) ⥤
        Φ.fiber.Elements :=
      { obj := fun A => Φ.fiber.elementsMk A.right A.hom
        map := fun {A A'} g => ⟨g.right, StructuredArrow.w g⟩
        map_id := fun A => rfl
        map_comp := fun f g => rfl }
    let Einv : Φ.fiber.Elements ⥤
        StructuredArrow (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B) :=
      { obj := fun x => StructuredArrow.mk (T := Scheme.Etale.forget B) (Y := x.1) x.2
        map := fun {x y} φ => StructuredArrow.homMk φ.1 φ.2
        map_id := fun x => rfl
        map_comp := fun f g => rfl }
    let eqv : StructuredArrow (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B) ≌
        Φ.fiber.Elements :=
      CategoryTheory.Equivalence.mk E Einv
        (NatIso.ofComponents (fun A => Iso.refl _) (by intros; rfl))
        (NatIso.ofComponents (fun x => Iso.refl _) (by intros; rfl))
    haveI : E.IsEquivalence := eqv.isEquivalence_functor
    haveI : E.IsLeftAdjoint := Functor.isLeftAdjoint_of_isEquivalence
    haveI : E.Initial := Functor.initial_of_isLeftAdjoint E
    haveI : E.op.Final := Functor.final_op_of_initial E
    let i0 := Functor.Final.colimIso (E := AddCommGrpCat.{u+1}) E.op
    let i1 : (Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj
        (StructuredArrow.proj (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B)).op ⋙
          Limits.colim ≅
        (Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj (Functor.Elements.π Φ.fiber).op ⋙
          Limits.colim :=
      Functor.isoWhiskerLeft ((Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj
        (Functor.Elements.π Φ.fiber).op) i0
    let j : Φ.sheafFiber (A := AddCommGrpCat.{u+1}) ≅ wcEtStalk B b :=
      Functor.isoWhiskerLeft (sheafToPresheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1})
        i1.symm
    exact ⟨Limits.preservesFiniteLimits_of_natIso j, Limits.preservesFiniteColimits_of_natIso j⟩
  obtain ⟨hlim, hcolim⟩ := hexact
  haveI := hlim
  haveI := hcolim
  haveI : (wcEtStalk B b).PreservesZeroMorphisms :=
    Functor.preservesZeroMorphisms_of_preserves_terminal_object
  haveI : (wcEtStalk B b).Additive := Functor.additive_of_preserves_binary_products _
  let ψ := ((wcEtStalk B b).mapHomologicalComplex (ComplexShape.up ℤ)).map φ
  haveI hψn : ∀ n, IsIso (ψ.f n) := fun n => by
    have e : ψ.f n = (wcEtStalk B b).map (φ.f n) := rfl
    rw [e]
    exact (ConcreteCategory.isIso_iff_bijective _).2 (h n)
  haveI : IsIso ψ := HomologicalComplex.Hom.isIso_of_components ψ
  have hT : Limits.IsZero (CochainComplex.mappingCone.triangleh ψ).obj₃ :=
    (Pretriangulated.Triangle.isZero₃_iff_isIso₁ _
      (HomotopyCategory.mappingCone_triangleh_distinguished ψ)).2
      (Functor.map_isIso (HomotopyCategory.quotient _ (ComplexShape.up ℤ)) ψ)
  obtain ⟨H⟩ := (HomotopyCategory.isZero_quotient_obj_iff (CochainComplex.mappingCone ψ)).1 hT
  have hz : Limits.IsZero ((CochainComplex.mappingCone ψ).homology j) := by
    rw [Limits.IsZero.iff_id_eq_zero]
    have e := H.homologyMap_eq j
    rw [HomologicalComplex.homologyMap_id, HomologicalComplex.homologyMap_zero] at e
    exact e
  let e₁ := CochainComplex.mappingCone.mapHomologicalComplexIso φ (wcEtStalk B b)
  let e₂ := HomologicalComplex.homologyMapIso e₁ j
  let e₀ : (wcEtStalk B b).obj ((CochainComplex.mappingCone φ).homology j) ≅
      (((wcEtStalk B b).mapHomologicalComplex (ComplexShape.up ℤ)).obj
        (CochainComplex.mappingCone φ)).homology j :=
    (((CochainComplex.mappingCone φ).sc j).mapHomologyIso (wcEtStalk B b)).symm
  exact AddCommGrpCat.isZero_iff_subsingleton.1 (hz.of_iso (e₀ ≪≫ e₂))

theorem wc_mapHC_extend_iso {C D : Type*} [Category C] [Category D] [Limits.HasZeroMorphisms C]
    [Limits.HasZeroMorphisms D] [Limits.HasZeroObject C] [Limits.HasZeroObject D] (F : C ⥤ D)
    [F.PreservesZeroMorphisms] (K : CochainComplex C ℕ) :
    Nonempty ((F.mapHomologicalComplex (ComplexShape.up ℤ)).obj (K.extend ComplexShape.embeddingUpNat) ≅
      ((F.mapHomologicalComplex (ComplexShape.up ℕ)).obj K).extend ComplexShape.embeddingUpNat) :=
by
  let K' := (F.mapHomologicalComplex (ComplexShape.up ℕ)).obj K
  let φ : (o : Option ℕ) → (F.obj (HomologicalComplex.extend.X K o) ≅ HomologicalComplex.extend.X K' o) :=
    fun o => match o with
      | some a => Iso.refl (F.obj (K.X a))
      | none => Limits.IsZero.iso (F.map_isZero (Limits.isZero_zero C)) (Limits.isZero_zero D)
  have s2 : ∀ o o' : Option ℕ, (φ o).hom ≫ HomologicalComplex.extend.d K' o o' =
      F.map (HomologicalComplex.extend.d K o o') ≫ (φ o').hom := by
    intro o o'
    cases o with
    | none => exact (F.map_isZero (Limits.isZero_zero C)).eq_of_src _ _
    | some a =>
      cases o' with
      | none => exact (Limits.isZero_zero D).eq_of_tgt _ _
      | some b =>
        show 𝟙 _ ≫ F.map (K.d a b) = F.map (K.d a b) ≫ 𝟙 _
        rw [Category.id_comp, Category.comp_id]
  exact ⟨HomologicalComplex.Hom.isoOfComponents
    (fun n => φ (ComplexShape.embeddingUpNat.r n)) (fun n m _ => s2 _ _)⟩

theorem wc_qm_pbc_hyper : ∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (Y M : Scheme.{u}) (p : Y ⟶ Spec (.of A)) [IsProper p] (G : M ⟶ Y) (m : ℕ), m ≠ 0 → ∀ (I : InjectiveResolution ((constantSheaf (Scheme.smallEtaleTopology M) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))) (q : ℕ), Nonempty (wcQmHyp Y (((wcEtPush G).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex) q ≃ wcQmHyp (Limits.pullback p (wcQmSp A)) (wcQmCx G (Limits.pullback.fst p (wcQmSp A)) I.cocomplex) q) :=
by
  intro A _ _ _ Y M p _ G m hm I q
  classical

  suffices H : ∀ (Z : Scheme.{u}) (i : Z ⟶ Y), IsClosedImmersion i →
      (∀ y : Y, p y = IsLocalRing.closedPoint A → ∃ z : Z, i z = y) →
      Nonempty (wcQmHyp Y (((wcEtPush G).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex) q ≃
        wcQmHyp Z (wcQmCx G i I.cocomplex) q) by
    haveI hσ : IsClosedImmersion (wcQmSp A) :=
      IsClosedImmersion.spec_of_surjective _ IsLocalRing.residue_surjective
    have hσpt : (wcQmSp A) (IsLocalRing.closedPoint (IsLocalRing.ResidueField A)) =
        IsLocalRing.closedPoint A :=
      IsLocalRing.comap_closedPoint (IsLocalRing.residue A)
    refine H _ _ inferInstance (fun y hy => ?_)
    obtain ⟨z, hz, -⟩ := Scheme.Pullback.exists_preimage_pullback y _ (hy.trans hσpt.symm)
    exact ⟨z, hz⟩
  intro Z i hi hsurj

  obtain ⟨⟨adj⟩, hFlim, ⟨eZ⟩⟩ := wc_qm_inv_adjunction i
  obtain ⟨⟨adjG⟩, -, -⟩ := wc_qm_inv_adjunction G
  haveI : (wcEtPush i).Additive := by
    haveI := adj.isRightAdjoint
    exact Functor.additive_of_preserves_binary_products _
  haveI : (wcEtPush G).Additive := by
    haveI := adjG.isRightAdjoint
    exact Functor.additive_of_preserves_binary_products _
  haveI : (wcQmInv i).Additive := adj.left_adjoint_additive
  haveI : Limits.PreservesFiniteLimits (wcQmInv i) := hFlim
  haveI : Limits.PreservesFiniteColimits (wcQmInv i) := by
    haveI := adj.isLeftAdjoint
    infer_instance
  haveI : Limits.PreservesFiniteLimits (wcEtPush i) := by
    haveI := adj.isRightAdjoint
    infer_instance
  haveI : Limits.PreservesFiniteColimits (wcEtPush i) := wc_et_finite_push_exact i
  letI := HasDerivedCategory.standard (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})
  letI := HasDerivedCategory.standard (Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1})
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _

  let Kn := ((wcEtPush G).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex
  let Kz := Kn.extend ComplexShape.embeddingUpNat
  let η : Kz ⟶ ((wcEtPush i).mapHomologicalComplex (ComplexShape.up ℤ)).obj
      (((wcQmInv i).mapHomologicalComplex (ComplexShape.up ℤ)).obj Kz) :=
    { f := fun n => adj.unit.app (Kz.X n)
      comm' := by
        intro a b _
        exact (adj.unit.naturality (Kz.d a b)).symm }

  have hX0 : m • 𝟙 ((constantSheaf (Scheme.smallEtaleTopology M) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) = 0 := wc_et_const_zmod_nsmul_zero M m
  have hI : Homotopy (m • 𝟙 I.cocomplex) 0 := by
    refine InjectiveResolution.descHomotopyZero (I := I) (J := I) (m • 𝟙 I.cocomplex) ?_
    rw [Preadditive.comp_nsmul, Category.comp_id]
    have h1 : m • I.ι = (CochainComplex.single₀ _).map (m • 𝟙 _) ≫ I.ι := by
      rw [CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id, Preadditive.nsmul_comp,
        Category.id_comp]
    rw [h1, hX0, CategoryTheory.Functor.map_zero, Limits.zero_comp]
  have hKn : Homotopy (m • 𝟙 Kn) 0 := by
    have h := (wcEtPush G).mapHomotopy hI
    simp only [CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id,
      CategoryTheory.Functor.map_zero] at h
    exact h
  have hextn : ∀ k : ℕ, HomologicalComplex.extendMap (k • 𝟙 Kn) ComplexShape.embeddingUpNat =
      k • 𝟙 Kz := by
    intro k
    induction k with
    | zero => rw [zero_nsmul, zero_nsmul]; exact HomologicalComplex.extendMap_zero _ _ _
    | succ k ih =>
      rw [succ_nsmul, succ_nsmul, HomologicalComplex.extendMap_add, ih,
        HomologicalComplex.extendMap_id]
  have hKz : Homotopy (m • 𝟙 Kz) 0 := by
    have h := hKn.extend ComplexShape.embeddingUpNat
    rw [hextn m, HomologicalComplex.extendMap_zero] at h
    exact h
  have hRF : Homotopy (m • 𝟙 (((wcEtPush i).mapHomologicalComplex (ComplexShape.up ℤ)).obj
      (((wcQmInv i).mapHomologicalComplex (ComplexShape.up ℤ)).obj Kz))) 0 := by
    have h := (wcEtPush i).mapHomotopy ((wcQmInv i).mapHomotopy hKz)
    simp only [CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id,
      CategoryTheory.Functor.map_zero] at h
    exact h

  have hcone_tors : ∀ j : ℤ, (m * m) • 𝟙 ((CochainComplex.mappingCone η).homology j) = 0 :=
    wc_mappingCone_homology_torsion_sq η m hKz hRF
  have hcone_stalk : ∀ (y : Y), p y = IsLocalRing.closedPoint A → ∀ j : ℤ,
      Subsingleton ((wcEtStalk Y y).obj ((CochainComplex.mappingCone η).homology j)) := by
    intro y hy j
    obtain ⟨z, rfl⟩ := hsurj y hy
    exact wc_et_cone_stalk_zero η (i z)
      (fun n => wc_et_closed_unit_stalk_iso i (wcQmInv i) adj (Kz.X n) z) j
  have hm2 : 0 < m * m := Nat.mul_pos (Nat.pos_of_ne_zero hm) (Nat.pos_of_ne_zero hm)
  have hhom : ∀ (j : ℤ) (p' : ℕ), Subsingleton
      ((DerivedCategory.singleFunctor (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) 0).obj
        ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} ℤ))) ⟶
      (shiftFunctor (DerivedCategory (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}))
        (p' : ℤ)).obj
        ((DerivedCategory.singleFunctor (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) 0).obj
          ((DerivedCategory.homologyFunctor (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})
            j).obj (DerivedCategory.Q.obj (CochainComplex.mappingCone η))))) := by
    intro j p'
    haveI := wc_et_ab_ext_vanish_of_closed_fibre_stalks A Y p (m * m) hm2 _ (hcone_tors j)
      (fun y hy => hcone_stalk y hy j) p'
    have h1 : Subsingleton
        ((DerivedCategory.singleFunctor (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) 0).obj
          ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
            (AddCommGrpCat.of (ULift.{u+1} ℤ))) ⟶
        (shiftFunctor (DerivedCategory (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}))
          (p' : ℤ)).obj
          ((DerivedCategory.singleFunctor (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) 0).obj
            ((CochainComplex.mappingCone η).homology j))) :=
      (Abelian.Ext.homEquiv (n := p')).symm.subsingleton
    let eH := (DerivedCategory.homologyFunctorFactors
      (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) j).app (CochainComplex.mappingCone η)
    exact @Equiv.subsingleton _ _ (Iso.homCongr (Iso.refl _)
      ((shiftFunctor _ (p' : ℤ)).mapIso ((DerivedCategory.singleFunctor _ 0).mapIso eH))) h1
  have hGE : (DerivedCategory.Q.obj (CochainComplex.mappingCone η)).IsGE (-1) := by
    rw [DerivedCategory.isGE_Q_obj_iff, CochainComplex.isGE_iff]
    intro k hk
    have hz : Limits.IsZero ((CochainComplex.mappingCone η).X k) := by
      rw [CochainComplex.mappingCone.isZero_X_iff]
      refine ⟨HomologicalComplex.isZero_extend_X _ _ _ (fun n hn => ?_),
        (wcEtPush i).map_isZero ((wcQmInv i).map_isZero
          (HomologicalComplex.isZero_extend_X _ _ _ (fun n hn => ?_)))⟩
      · rw [ComplexShape.embeddingUpNat_f] at hn; omega
      · rw [ComplexShape.embeddingUpNat_f] at hn; omega
    exact ShortComplex.exact_of_isZero_X₂ _ hz
  have hvan := wc_derived_single_hom_vanish_of_isGE
    ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} ℤ))) _ (-1) hGE hhom

  have hbij := wc_pretri_postcomp_bij_of_cone_hom_vanish _
    (DerivedCategory.mappingCone_triangle_distinguished η)
    ((DerivedCategory.singleFunctor (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) 0).obj
      ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ)))) hvan (q : ℤ)
  obtain ⟨E2⟩ := wc_derived_hom_exact_adjoint_transfer (wcQmInv i) (wcEtPush i) adj
    ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} ℤ)))
    (((wcQmInv i).mapHomologicalComplex (ComplexShape.up ℤ)).obj Kz) (q : ℤ)
  obtain ⟨c9⟩ := wc_mapHC_extend_iso (wcQmInv i) Kn
  exact ⟨(Equiv.ofBijective _ hbij).trans (E2.symm.trans
    ((Iso.homCongr ((DerivedCategory.singleFunctor _ 0).mapIso eZ) (Iso.refl _)).trans
      (Iso.homCongr (Iso.refl _) ((shiftFunctor _ (q : ℤ)).mapIso (DerivedCategory.Q.mapIso c9)))))⟩

theorem wc_qm_inv_push_adj : ∀ {X B : Scheme.{u}} (g : X ⟶ B), Nonempty (wcQmInv g ⊣ wcEtPush g) :=
by
  have hcont : ∀ {X B : Scheme.{u}} (g : X ⟶ B), (wcEtBaseChange g).IsContinuous
      (Scheme.smallEtaleTopology B) (Scheme.smallEtaleTopology X) := by
    have hjs : ∀ (Y : Scheme.{u}) (V : Y.Etale) (S : Sieve V), (∀ v : V.left, ∃ (V₁ : Y.Etale)
        (c : V₁ ⟶ V), S.arrows c ∧ v ∈ Set.range c.left) → S ∈ Scheme.smallEtaleTopology Y V := by
      intro Y V S hS
      change S ∈ Scheme.smallGrothendieckTopology @Etale Y V
      rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
      apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
      intro x
      obtain ⟨V₁, c, hc, y, hy⟩ := hS x
      have hw : c.left ≫ V.hom = V₁.hom := MorphismProperty.Over.w c
      have hEt : Etale c.left := by
        have h1 : Etale V.hom := V.prop
        have h2 : Etale (c.left ≫ V.hom) := by rw [hw]; exact V₁.prop
        exact Etale.of_comp c.left V.hom
      exact ⟨V₁, c, y, hc, hEt, hy⟩
    have hcov : ∀ {X B : Scheme.{u}} (g : X ⟶ B), CoverPreserving (Scheme.smallEtaleTopology B)
        (Scheme.smallEtaleTopology X) (wcEtBaseChange g) := by
      intro X B g
      constructor
      intro V S hS
      change S ∈ Scheme.smallGrothendieckTopology @Etale B V at hS
      rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale B
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hS
      have hS' := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale B
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mp hS
      apply hjs
      intro v
      obtain ⟨W, a, w, ha, -, hw⟩ := hS' (Limits.pullback.fst V.hom g v)
      refine ⟨(wcEtBaseChange g).obj W, (wcEtBaseChange g).map a,
        Sieve.image_mem_functorPushforward (wcEtBaseChange g) S ha, ?_⟩
      have h0 : (Limits.pullback.fst W.hom g ≫ a.left) ≫ V.hom =
          Limits.pullback.snd W.hom g ≫ g := by
        rw [Category.assoc, MorphismProperty.Over.w a]
        exact Limits.pullback.condition
      let m : Limits.pullback W.hom g ⟶ Limits.pullback V.hom g :=
        Limits.pullback.lift (Limits.pullback.fst W.hom g ≫ a.left) (Limits.pullback.snd W.hom g) h0
      have hmap : ((wcEtBaseChange g).map a).left = m := rfl
      have h1 : Limits.pullback.fst a.left (Limits.pullback.fst V.hom g) ≫ W.hom =
          (Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) ≫
            Limits.pullback.snd V.hom g) ≫ g := by
        rw [← MorphismProperty.Over.w a, ← Category.assoc, Limits.pullback.condition,
          Category.assoc, Limits.pullback.condition, Category.assoc]
      let ψ : Limits.pullback a.left (Limits.pullback.fst V.hom g) ⟶ Limits.pullback W.hom g :=
        Limits.pullback.lift (Limits.pullback.fst a.left (Limits.pullback.fst V.hom g))
          (Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) ≫
            Limits.pullback.snd V.hom g) h1
      have hψ : ψ ≫ m = Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) := by
        apply Limits.pullback.hom_ext
        · rw [Category.assoc, Limits.pullback.lift_fst, ← Category.assoc,
            Limits.pullback.lift_fst, Limits.pullback.condition]
        · rw [Category.assoc, Limits.pullback.lift_snd, Limits.pullback.lift_snd]
      obtain ⟨z, hz⟩ : ∃ z, Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) z = v := by
        have hv : (v : ↥(Limits.pullback V.hom g)) ∈
            Set.range (Limits.pullback.snd a.left (Limits.pullback.fst V.hom g)) := by
          rw [Scheme.Pullback.range_snd]
          exact ⟨w, hw⟩
        exact hv
      rw [hmap]
      exact ⟨ψ z, (Scheme.Hom.comp_apply ψ m z).symm.trans (by rw [hψ]; exact hz)⟩
    intro X B g
    let Φ := wcEtBaseChange g
    haveI h1 : Limits.PreservesFiniteLimits Φ := ⟨fun J _ _ =>
      haveI : Limits.PreservesLimitsOfShape J (wcEtBaseChange g ⋙ Scheme.Etale.forget X) :=
        Limits.preservesLimitsOfShape_of_natIso
          (NatIso.ofComponents (fun _ => Iso.refl _) (fun _ => rfl) :
            Scheme.Etale.forget B ⋙ Over.pullback g ≅ wcEtBaseChange g ⋙ Scheme.Etale.forget X)
      Limits.preservesLimitsOfShape_of_reflects_of_preserves (wcEtBaseChange g)
        (Scheme.Etale.forget X)⟩
    haveI := flat_of_preservesFiniteLimits Φ
    exact Functor.isContinuous_of_coverPreserving (compatiblePreservingOfFlat _ _) (hcov g)
  intro X B g
  haveI : (wcEtBaseChange g).IsContinuous (Scheme.smallEtaleTopology B)
      (Scheme.smallEtaleTopology X) := hcont g
  let adj₀ := Functor.sheafPullbackConstruction.sheafAdjunctionContinuous (wcEtBaseChange g)
    AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology B) (Scheme.smallEtaleTopology X)
  let e : (wcEtBaseChange g).sheafPushforwardContinuous AddCommGrpCat.{u+1}
      (Scheme.smallEtaleTopology B) (Scheme.smallEtaleTopology X) ≅ wcEtPush g :=
    (Functor.rightUnitor _).symm ≪≫
      Functor.isoWhiskerLeft _ (sheafificationNatIso _ _) ≪≫
      (Functor.associator _ _ _).symm ≪≫
      Functor.isoWhiskerRight
        ((wcEtBaseChange g).sheafPushforwardContinuousCompSheafToPresheafIso _ _ _) _ ≪≫
      Functor.associator _ _ _
  exact ⟨adj₀.ofNatIsoRight e⟩

theorem wc_qm_inv_stalk : ∀ {X B : Scheme.{u}} (g : X ⟶ B) (x : X), Nonempty (wcQmInv g ⋙ wcEtStalk X x ≅ wcEtStalk B (g x)) :=
by
  intro X B g x
  classical

  have pA : ∀ {C E : Type (u+1)} [Category.{u} C] [Category.{u} E] (Fo : C ⥤ E) (T : E),
      Nonempty ((Functor.whiskeringLeft (StructuredArrow T Fo)ᵒᵖ Cᵒᵖ AddCommGrpCat.{u+1}).obj
        (StructuredArrow.proj T Fo).op ⋙ Limits.colim ≅
        Fo.op.lan ⋙ (evaluation Eᵒᵖ AddCommGrpCat.{u+1}).obj (Opposite.op T)) := by
    intro C E _ _ Fo T
    let e := structuredArrowOpEquivalence Fo T
    let i1 : (Functor.whiskeringLeft (StructuredArrow T Fo)ᵒᵖ Cᵒᵖ AddCommGrpCat.{u+1}).obj
        (StructuredArrow.proj T Fo).op ⋙ Limits.colim ≅
        (Functor.whiskeringLeft _ Cᵒᵖ AddCommGrpCat.{u+1}).obj
          (CostructuredArrow.proj Fo.op (Opposite.op T)) ⋙ Limits.colim :=
      Functor.isoWhiskerRight (Functor.whiskeringLeftObjCompIso (E := AddCommGrpCat.{u+1}) e.functor
          (CostructuredArrow.proj Fo.op (Opposite.op T))) Limits.colim ≪≫
        Functor.associator _ _ _ ≪≫
        Functor.isoWhiskerLeft _ (Functor.Final.colimIso e.functor (E := AddCommGrpCat.{u+1}))
    refine ⟨i1 ≪≫ NatIso.ofComponents
      (fun R => (Fo.op.leftKanExtensionObjIsoColimit R (Opposite.op T)).symm) ?_⟩
    intro R R' α
    apply Limits.colimit.hom_ext
    intro j
    have h := congr_app (Fo.op.lanUnit.naturality α) j.left
    simp only [Functor.id_obj, Functor.comp_obj, Functor.whiskeringLeft_obj_obj, Functor.id_map,
      NatTrans.comp_app, Functor.comp_map, Functor.whiskeringLeft_obj_map,
      Functor.whiskerLeft_app] at h
    have h2 := (Fo.op.lan.map α).naturality j.hom
    simp only [Functor.comp_map, Functor.whiskeringLeft_obj_map, Limits.colim_map,
      evaluation_obj_map, Iso.symm_hom]
    erw [Limits.ι_colimMap_assoc, Functor.ι_leftKanExtensionObjIsoColimit_inv,
      Functor.ι_leftKanExtensionObjIsoColimit_inv_assoc]
    erw [h2]
    exact (congrArg (· ≫ (Fo.op.lan.obj R').map j.hom) h).trans (Category.assoc _ _ _)
  have pB : ∀ {C D E : Type (u+1)} [Category.{u} C] [Category.{u} D] [Category.{u} E]
      (L : C ⥤ D) (FD : D ⥤ E),
      Nonempty ((L.op.lan ⋙ FD.op.lan : (Cᵒᵖ ⥤ AddCommGrpCat.{u+1}) ⥤ _) ≅ (L ⋙ FD).op.lan) :=
    fun L FD =>
    ⟨((L.op.lanAdjunction AddCommGrpCat.{u+1}).comp
        (FD.op.lanAdjunction AddCommGrpCat.{u+1})).leftAdjointUniq
      (((L ⋙ FD).op.lanAdjunction AddCommGrpCat.{u+1}).ofNatIsoRight
        (Functor.whiskeringLeftObjCompIso L.op FD.op))⟩
  have pG : ∀ {A A' C : Type (u+1)} [Category.{u} A] [Category.{u} A'] [Category.{u} C]
      (Ψ : A ⥤ A') [Ψ.IsEquivalence] (p : A' ⥤ C),
      Nonempty ((Functor.whiskeringLeft Aᵒᵖ Cᵒᵖ AddCommGrpCat.{u+1}).obj (Ψ ⋙ p).op ⋙ Limits.colim ≅
        (Functor.whiskeringLeft A'ᵒᵖ Cᵒᵖ AddCommGrpCat.{u+1}).obj p.op ⋙ Limits.colim) :=
    fun Ψ _ p =>
    ⟨Functor.isoWhiskerRight (Functor.whiskeringLeftObjCompIso (E := AddCommGrpCat.{u+1}) Ψ.op p.op)
        Limits.colim ≪≫ Functor.associator _ _ _ ≪≫
      Functor.isoWhiskerLeft _ (Functor.Final.colimIso Ψ.op (E := AddCommGrpCat.{u+1}))⟩
  have pT : ∀ {C E E' : Type (u+1)} [Category.{u} C] [Category.{u} E] [Category.{u} E']
      (FD : C ⥤ E) (FC : C ⥤ E') (T : E) (T' : E')
      (θ : FD ⋙ coyoneda.obj (Opposite.op T) ≅ FC ⋙ coyoneda.obj (Opposite.op T')),
      Nonempty ((Functor.whiskeringLeft (StructuredArrow T FD)ᵒᵖ Cᵒᵖ AddCommGrpCat.{u+1}).obj
        (StructuredArrow.proj T FD).op ⋙ Limits.colim ≅
        (Functor.whiskeringLeft (StructuredArrow T' FC)ᵒᵖ Cᵒᵖ AddCommGrpCat.{u+1}).obj
        (StructuredArrow.proj T' FC).op ⋙ Limits.colim) := by
    intro C E E' _ _ _ FD FC T T' θ
    have hinv : ∀ {c₁ c₂ : C} (k : c₁ ⟶ c₂) (s : T' ⟶ FC.obj c₁),
        θ.inv.app c₂ (s ≫ FC.map k) = θ.inv.app c₁ s ≫ FD.map k := by
      intro c₁ c₂ k s
      first
      | exact congrFun (θ.inv.naturality k) s
      | exact NatTrans.naturality_apply θ.inv k s
    have hhom : ∀ {c₁ c₂ : C} (k : c₁ ⟶ c₂) (s : T ⟶ FD.obj c₁),
        θ.hom.app c₂ (s ≫ FD.map k) = θ.hom.app c₁ s ≫ FC.map k := by
      intro c₁ c₂ k s
      first
      | exact congrFun (θ.hom.naturality k) s
      | exact NatTrans.naturality_apply θ.hom k s
    have hhi : ∀ (c : C) (s : T' ⟶ FC.obj c), θ.hom.app c (θ.inv.app c s) = s := by
      intro c s
      first
      | exact (θ.app c).inv_hom_id_apply s
      | exact congrFun (congr_app θ.inv_hom_id c) s
      | simp
    have hih : ∀ (c : C) (s : T ⟶ FD.obj c), θ.inv.app c (θ.hom.app c s) = s := by
      intro c s
      first
      | exact (θ.app c).hom_inv_id_apply s
      | exact congrFun (congr_app θ.hom_inv_id c) s
      | simp
    let Ψ : StructuredArrow T' FC ⥤ StructuredArrow T FD :=
      { obj := fun A => StructuredArrow.mk (Y := A.right) (θ.inv.app A.right A.hom)
        map := fun {A A'} k => StructuredArrow.homMk k.right (by
          show θ.inv.app A.right A.hom ≫ FD.map k.right = θ.inv.app A'.right A'.hom
          rw [← hinv, StructuredArrow.w k])
        map_id := by intros; rfl
        map_comp := by intros; rfl }
    haveI : Ψ.Faithful := ⟨fun {A A'} φ ψ h => StructuredArrow.hom_ext φ ψ (by
      have h' := congrArg CommaMorphism.right h
      exact h')⟩
    haveI : Ψ.Full := ⟨fun {A A'} f => ⟨StructuredArrow.homMk f.right (by
      have h1 := StructuredArrow.w f
      change θ.inv.app A.right A.hom ≫ FD.map f.right = θ.inv.app A'.right A'.hom at h1
      have h2 := congrArg (θ.hom.app A'.right) h1
      rw [hhom, hhi, hhi] at h2
      exact h2), rfl⟩⟩
    haveI : Ψ.EssSurj := ⟨fun Y => ⟨StructuredArrow.mk (Y := Y.right) (θ.hom.app Y.right Y.hom),
      ⟨StructuredArrow.isoMk (Iso.refl _) (by
        show θ.inv.app Y.right (θ.hom.app Y.right Y.hom) ≫ FD.map (𝟙 _) = Y.hom
        rw [hih, FD.map_id, Category.comp_id])⟩⟩⟩
    haveI : Ψ.IsEquivalence := { }
    obtain ⟨i⟩ := pG Ψ (StructuredArrow.proj T FD)
    exact ⟨i.symm⟩
  have pM : ∀ {C E : Type (u+1)} [Category.{u} C] [Category.{u} E] (Fo : C ⥤ E) (T T' : E)
      (ε : T ⟶ T'), (∀ (U : C) (s : T ⟶ Fo.obj U), ∃! t : T' ⟶ Fo.obj U, ε ≫ t = s) →
      Nonempty ((Functor.whiskeringLeft (StructuredArrow T Fo)ᵒᵖ Cᵒᵖ AddCommGrpCat.{u+1}).obj
        (StructuredArrow.proj T Fo).op ⋙ Limits.colim ≅
        (Functor.whiskeringLeft (StructuredArrow T' Fo)ᵒᵖ Cᵒᵖ AddCommGrpCat.{u+1}).obj
        (StructuredArrow.proj T' Fo).op ⋙ Limits.colim) := by
    intro C E _ _ Fo T T' ε hε
    let Ψ : StructuredArrow T' Fo ⥤ StructuredArrow T Fo := StructuredArrow.map ε
    haveI : Ψ.Faithful := ⟨fun {A A'} φ ψ h => StructuredArrow.hom_ext φ ψ (by
      have h' := congrArg CommaMorphism.right h
      exact h')⟩
    haveI : Ψ.Full := ⟨fun {A A'} f => ⟨StructuredArrow.homMk f.right (by
      have h1 := StructuredArrow.w f
      change (ε ≫ A.hom) ≫ Fo.map f.right = ε ≫ A'.hom at h1
      obtain ⟨t, _, ht⟩ := hε A'.right (ε ≫ A'.hom)
      have e1 : A.hom ≫ Fo.map f.right = t := ht _ (by
        show ε ≫ (A.hom ≫ Fo.map f.right) = ε ≫ A'.hom
        rw [← Category.assoc]; exact h1)
      have e2 : A'.hom = t := ht _ rfl
      exact e1.trans e2.symm), rfl⟩⟩
    haveI : Ψ.EssSurj := ⟨fun Y => by
      obtain ⟨t, ht, _⟩ := hε Y.right Y.hom
      exact ⟨StructuredArrow.mk (Y := Y.right) t,
        ⟨StructuredArrow.isoMk (Iso.refl _) (by
          show (ε ≫ t) ≫ Fo.map (𝟙 _) = Y.hom
          rw [Fo.map_id, Category.comp_id, ht])⟩⟩⟩
    haveI : Ψ.IsEquivalence := { }
    obtain ⟨i⟩ := pG Ψ (StructuredArrow.proj T Fo)
    exact ⟨i.symm⟩

  have hdec : ∀ (K : Type u) [Field K] (Y : Scheme.{u}) (f : Spec (.of K) ⟶ Y),
      ∃ (y : Y) (φ : Y.residueField y ⟶ CommRingCat.of K), f = Spec.map φ ≫ Y.fromSpecResidueField y := by
    intro K _ Y f
    refine ⟨(Scheme.SpecToEquivOfField K Y f).1, (Scheme.SpecToEquivOfField K Y f).2, ?_⟩
    rw [← Scheme.SpecToEquivOfField_symm_apply, Equiv.symm_apply_apply]
  have hinj : ∀ (K : Type u) [Field K] (Y : Scheme.{u}) (y₁ y₂ : Y)
      (φ₁ : Y.residueField y₁ ⟶ CommRingCat.of K) (φ₂ : Y.residueField y₂ ⟶ CommRingCat.of K),
      Spec.map φ₁ ≫ Y.fromSpecResidueField y₁ = Spec.map φ₂ ≫ Y.fromSpecResidueField y₂ →
      y₁ = y₂ ∧ HEq φ₁ φ₂ := by
    intro K _ Y y₁ y₂ φ₁ φ₂ h
    have h' : (Scheme.SpecToEquivOfField K Y).symm ⟨y₁, φ₁⟩ =
        (Scheme.SpecToEquivOfField K Y).symm ⟨y₂, φ₂⟩ := by
      rw [Scheme.SpecToEquivOfField_symm_apply, Scheme.SpecToEquivOfField_symm_apply]
      exact h
    exact Sigma.mk.inj_iff.mp ((Scheme.SpecToEquivOfField K Y).symm.injective h')

  have s6 : ∃ e : AlgebraicClosure (B.residueField (g x)) →+* AlgebraicClosure (X.residueField x),
      Spec.map (CommRingCat.ofHom e) ≫ wcEtGeomPt B (g x) = wcEtGeomPt X x ≫ g := by
    let r := g.residueFieldMap x
    letI : Algebra (B.residueField (g x)) (AlgebraicClosure (X.residueField x)) :=
      ((algebraMap (X.residueField x) (AlgebraicClosure (X.residueField x))).comp r.hom).toAlgebra
    let e₀ : AlgebraicClosure (B.residueField (g x)) →ₐ[B.residueField (g x)]
        AlgebraicClosure (X.residueField x) :=
      IsAlgClosed.lift (R := B.residueField (g x)) (S := AlgebraicClosure (B.residueField (g x)))
        (M := AlgebraicClosure (X.residueField x))
    refine ⟨e₀.toRingHom, ?_⟩
    have hc : CommRingCat.ofHom (algebraMap (B.residueField (g x))
          (AlgebraicClosure (B.residueField (g x)))) ≫ CommRingCat.ofHom e₀.toRingHom =
        r ≫ CommRingCat.ofHom (algebraMap (X.residueField x) (AlgebraicClosure (X.residueField x))) := by
      ext z
      exact e₀.commutes z
    have hR := g.SpecMap_residueFieldMap_fromSpecResidueField x
    show Spec.map (CommRingCat.ofHom e₀.toRingHom) ≫ (Spec.map (CommRingCat.ofHom (algebraMap
        (B.residueField (g x)) (AlgebraicClosure (B.residueField (g x))))) ≫
        B.fromSpecResidueField (g x)) =
      (Spec.map (CommRingCat.ofHom (algebraMap (X.residueField x)
        (AlgebraicClosure (X.residueField x)))) ≫ X.fromSpecResidueField x) ≫ g
    exact (Category.assoc _ _ _).symm.trans <|
      (congrArg (fun q => q ≫ B.fromSpecResidueField (g x))
        ((Spec.map_comp (CommRingCat.ofHom (algebraMap (B.residueField (g x))
            (AlgebraicClosure (B.residueField (g x))))) (CommRingCat.ofHom e₀.toRingHom)).symm.trans
          ((congrArg Spec.map hc).trans (Spec.map_comp r (CommRingCat.ofHom
            (algebraMap (X.residueField x) (AlgebraicClosure (X.residueField x)))))))).trans <|
      (Category.assoc _ _ _).trans <|
      (congrArg (fun q => Spec.map (CommRingCat.ofHom (algebraMap (X.residueField x)
        (AlgebraicClosure (X.residueField x)))) ≫ q) hR).trans
      (Category.assoc _ _ _).symm

  have s5g : ∀ {V : Scheme.{u}} (f : V ⟶ B) [Etale f] (b : B) (M : Type u) [Field M]
      (e : AlgebraicClosure (B.residueField b) →+* M) (sl : Spec (.of M) ⟶ V),
      sl ≫ f = Spec.map (CommRingCat.ofHom e) ≫ wcEtGeomPt B b →
      ∃! tl : Spec (.of (AlgebraicClosure (B.residueField b))) ⟶ V,
        tl ≫ f = wcEtGeomPt B b ∧ Spec.map (CommRingCat.ofHom e) ≫ tl = sl := by
    intro V f _ b M _ e sl hsl
    have heinj : Function.Injective e := e.injective
    obtain ⟨u, φ, hs⟩ := hdec M V sl
    have heq : Spec.map (f.residueFieldMap u ≫ φ) ≫ B.fromSpecResidueField (f u) =
        Spec.map (CommRingCat.ofHom (algebraMap (B.residueField b)
          (AlgebraicClosure (B.residueField b))) ≫ CommRingCat.ofHom e) ≫
          B.fromSpecResidueField b := by
      calc Spec.map (f.residueFieldMap u ≫ φ) ≫ B.fromSpecResidueField (f u)
          = (Spec.map φ ≫ Spec.map (f.residueFieldMap u)) ≫ B.fromSpecResidueField (f u) :=
            congrArg (fun q => q ≫ B.fromSpecResidueField (f u)) (Spec.map_comp _ _)
        _ = Spec.map φ ≫ (Spec.map (f.residueFieldMap u) ≫ B.fromSpecResidueField (f u)) :=
            Category.assoc _ _ _
        _ = Spec.map φ ≫ (V.fromSpecResidueField u ≫ f) :=
            congrArg (fun q => Spec.map φ ≫ q) (f.SpecMap_residueFieldMap_fromSpecResidueField u)
        _ = (Spec.map φ ≫ V.fromSpecResidueField u) ≫ f := (Category.assoc _ _ _).symm
        _ = sl ≫ f := congrArg (fun q => q ≫ f) hs.symm
        _ = Spec.map (CommRingCat.ofHom e) ≫ (Spec.map (CommRingCat.ofHom (algebraMap
              (B.residueField b) (AlgebraicClosure (B.residueField b)))) ≫
              B.fromSpecResidueField b) := hsl
        _ = (Spec.map (CommRingCat.ofHom e) ≫ Spec.map (CommRingCat.ofHom (algebraMap
              (B.residueField b) (AlgebraicClosure (B.residueField b))))) ≫
              B.fromSpecResidueField b := (Category.assoc _ _ _).symm
        _ = _ := congrArg (fun q => q ≫ B.fromSpecResidueField b) (Spec.map_comp _ _).symm
    obtain ⟨hb, hφ⟩ := hinj M B _ _ _ _ heq
    subst hb
    have hφ' := eq_of_heq hφ

    letI : Algebra (B.residueField (f u)) (V.residueField u) :=
      (f.residueFieldMap u).hom.toAlgebra
    haveI : Algebra.IsSeparable (B.residueField (f u)) (V.residueField u) := inferInstance
    haveI : Algebra.IsAlgebraic (B.residueField (f u)) (V.residueField u) :=
      Algebra.IsSeparable.isAlgebraic _ _
    have hcomp : φ.hom.comp (algebraMap (B.residueField (f u)) (V.residueField u)) =
        e.comp (algebraMap (B.residueField (f u)) (AlgebraicClosure (B.residueField (f u)))) :=
      congrArg CommRingCat.Hom.hom hφ'
    have hrange : ∀ z : V.residueField u, φ.hom z ∈ e.range := by
      intro z
      have hpz : minpoly (B.residueField (f u)) z ≠ 0 :=
        minpoly.ne_zero (Algebra.IsIntegral.isIntegral z)
      have h0 := minpoly.aeval (B.residueField (f u)) z
      rw [Polynomial.aeval_def] at h0
      have h1 := congrArg φ.hom h0
      rw [Polynomial.hom_eval₂, map_zero, hcomp] at h1
      have hs' := IsAlgClosed.splits ((minpoly (B.residueField (f u)) z).map
        (algebraMap (B.residueField (f u)) (AlgebraicClosure (B.residueField (f u)))))
      have h2 : (((minpoly (B.residueField (f u)) z).map
          (algebraMap (B.residueField (f u)) (AlgebraicClosure (B.residueField (f u))))).map e).IsRoot
          (φ.hom z) := by
        rw [Polynomial.map_map, Polynomial.IsRoot.def, Polynomial.eval_map]
        exact h1
      exact Polynomial.Splits.mem_range_of_isRoot hs' (Polynomial.map_ne_zero hpz) h2
    let Eq := RingEquiv.ofBijective e.rangeRestrict ⟨fun a b h => heinj (congrArg Subtype.val h),
      e.rangeRestrict_surjective⟩
    let ψ : V.residueField u →+* AlgebraicClosure (B.residueField (f u)) :=
      Eq.symm.toRingHom.comp (φ.hom.codRestrict e.range hrange)
    have heψ : ∀ z, e (ψ z) = φ.hom z := by
      intro z
      have := congrArg Subtype.val (Eq.apply_symm_apply (φ.hom.codRestrict e.range hrange z))
      exact this
    have hψφ : CommRingCat.ofHom ψ ≫ CommRingCat.ofHom e = φ := by
      ext z
      exact heψ z
    have hψr : f.residueFieldMap u ≫ CommRingCat.ofHom ψ =
        CommRingCat.ofHom (algebraMap (B.residueField (f u))
          (AlgebraicClosure (B.residueField (f u)))) := by
      ext z
      apply heinj
      have h3 := congrArg (fun q => q.hom z) hφ'
      exact (heψ _).trans h3
    have htl : (Spec.map (CommRingCat.ofHom ψ) ≫ V.fromSpecResidueField u) ≫ f =
        wcEtGeomPt B (f u) := by
      calc (Spec.map (CommRingCat.ofHom ψ) ≫ V.fromSpecResidueField u) ≫ f
          = Spec.map (CommRingCat.ofHom ψ) ≫ (V.fromSpecResidueField u ≫ f) := Category.assoc _ _ _
        _ = Spec.map (CommRingCat.ofHom ψ) ≫ (Spec.map (f.residueFieldMap u) ≫
              B.fromSpecResidueField (f u)) :=
            congrArg (fun q => Spec.map (CommRingCat.ofHom ψ) ≫ q)
              (f.SpecMap_residueFieldMap_fromSpecResidueField u).symm
        _ = (Spec.map (CommRingCat.ofHom ψ) ≫ Spec.map (f.residueFieldMap u)) ≫
              B.fromSpecResidueField (f u) := (Category.assoc _ _ _).symm
        _ = Spec.map (f.residueFieldMap u ≫ CommRingCat.ofHom ψ) ≫ B.fromSpecResidueField (f u) :=
            congrArg (fun q => q ≫ B.fromSpecResidueField (f u)) (Spec.map_comp _ _).symm
        _ = Spec.map (CommRingCat.ofHom (algebraMap (B.residueField (f u))
              (AlgebraicClosure (B.residueField (f u))))) ≫ B.fromSpecResidueField (f u) :=
            congrArg (fun q => Spec.map q ≫ B.fromSpecResidueField (f u)) hψr
    have hex : Spec.map (CommRingCat.ofHom e) ≫
        (Spec.map (CommRingCat.ofHom ψ) ≫ V.fromSpecResidueField u) = sl := by
      calc Spec.map (CommRingCat.ofHom e) ≫
            (Spec.map (CommRingCat.ofHom ψ) ≫ V.fromSpecResidueField u)
          = (Spec.map (CommRingCat.ofHom e) ≫ Spec.map (CommRingCat.ofHom ψ)) ≫
              V.fromSpecResidueField u := (Category.assoc _ _ _).symm
        _ = Spec.map (CommRingCat.ofHom ψ ≫ CommRingCat.ofHom e) ≫ V.fromSpecResidueField u :=
            congrArg (fun q => q ≫ V.fromSpecResidueField u) (Spec.map_comp _ _).symm
        _ = Spec.map φ ≫ V.fromSpecResidueField u :=
            congrArg (fun q => Spec.map q ≫ V.fromSpecResidueField u) hψφ
        _ = sl := hs.symm
    refine ⟨Spec.map (CommRingCat.ofHom ψ) ≫ V.fromSpecResidueField u, ⟨htl, hex⟩, ?_⟩
    intro t' ht'
    obtain ⟨u₁, ψ₁, h₁⟩ := hdec _ V t'
    have hh : Spec.map (ψ₁ ≫ CommRingCat.ofHom e) ≫ V.fromSpecResidueField u₁ =
        Spec.map φ ≫ V.fromSpecResidueField u := by
      calc Spec.map (ψ₁ ≫ CommRingCat.ofHom e) ≫ V.fromSpecResidueField u₁
          = (Spec.map (CommRingCat.ofHom e) ≫ Spec.map ψ₁) ≫ V.fromSpecResidueField u₁ :=
            congrArg (fun q => q ≫ V.fromSpecResidueField u₁) (Spec.map_comp _ _)
        _ = Spec.map (CommRingCat.ofHom e) ≫ (Spec.map ψ₁ ≫ V.fromSpecResidueField u₁) :=
            Category.assoc _ _ _
        _ = Spec.map (CommRingCat.ofHom e) ≫ t' :=
            congrArg (fun q => Spec.map (CommRingCat.ofHom e) ≫ q) h₁.symm
        _ = sl := ht'.2
        _ = Spec.map φ ≫ V.fromSpecResidueField u := hs
    obtain ⟨hu, hψ⟩ := hinj M V _ _ _ _ hh
    subst hu
    have hψ' := eq_of_heq hψ
    have hψeq : ψ₁ = CommRingCat.ofHom ψ := by
      ext z
      apply heinj
      exact (congrArg (fun q => q.hom z) hψ').trans (heψ z).symm
    exact h₁.trans (congrArg (fun q => Spec.map q ≫ V.fromSpecResidueField u₁) hψeq)

  have s5 : ∀ (b : B) (M : Type u) [Field M] (e : AlgebraicClosure (B.residueField b) →+* M)
      (y' : Spec (.of M) ⟶ B) (hy : Spec.map (CommRingCat.ofHom e) ≫ wcEtGeomPt B b = y')
      (U : B.Etale) (s : Over.mk y' ⟶ (Scheme.Etale.forget B).obj U),
      ∃! t : Over.mk (wcEtGeomPt B b) ⟶ (Scheme.Etale.forget B).obj U,
        Over.homMk (U := Over.mk y') (V := Over.mk (wcEtGeomPt B b))
