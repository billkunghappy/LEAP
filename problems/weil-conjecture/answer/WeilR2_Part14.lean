    Limits.pullback.lift _ _ we
  have he1 : e ≫ Limits.pullback.fst g γ =
      Limits.pullback.fst (Limits.pullback.snd g a) ξ ≫ Limits.pullback.fst g a :=
    Limits.pullback.lift_fst _ _ _
  have he2 : e ≫ Limits.pullback.snd g γ = Limits.pullback.snd (Limits.pullback.snd g a) ξ :=
    Limits.pullback.lift_snd _ _ _
  let ξ' : Limits.pullback g γ ⟶ Limits.pullback g a :=
    Limits.pullback.lift (Limits.pullback.fst g γ) (Limits.pullback.snd g γ ≫ ξ)
      (Limits.pullback.condition.trans ((congrArg (fun k => Limits.pullback.snd g γ ≫ k)
        hξ).symm.trans (Category.assoc _ _ _).symm))
  have hx1 : ξ' ≫ Limits.pullback.fst g a = Limits.pullback.fst g γ :=
    Limits.pullback.lift_fst _ _ _
  have hx2 : ξ' ≫ Limits.pullback.snd g a = Limits.pullback.snd g γ ≫ ξ :=
    Limits.pullback.lift_snd _ _ _
  let e' : Limits.pullback g γ ⟶ Limits.pullback (Limits.pullback.snd g a) ξ :=
    Limits.pullback.lift ξ' (Limits.pullback.snd g γ) hx2
  have he'1 : e' ≫ Limits.pullback.fst (Limits.pullback.snd g a) ξ = ξ' :=
    Limits.pullback.lift_fst _ _ _
  have he'2 : e' ≫ Limits.pullback.snd (Limits.pullback.snd g a) ξ = Limits.pullback.snd g γ :=
    Limits.pullback.lift_snd _ _ _
  have hii : e' ≫ e = 𝟙 _ := by
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, he1, ← Category.assoc, he'1, hx1, Category.id_comp]
    · rw [Category.assoc, he2, he'2, Category.id_comp]
  have hexi : e ≫ ξ' = Limits.pullback.fst (Limits.pullback.snd g a) ξ := by
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, hx1, he1]
    · rw [Category.assoc, hx2, ← Category.assoc, he2, Limits.pullback.condition]
  have hiii : e ≫ e' = 𝟙 _ := by
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, he'1, hexi, Category.id_comp]
    · rw [Category.assoc, he'2, he2, Category.id_comp]
  obtain ⟨De⟩ := wc_et_zmod_pull_data_exists e m
  obtain ⟨De'⟩ := wc_et_zmod_pull_data_exists e' m
  obtain ⟨Dι⟩ := wc_et_zmod_pull_data_exists (Limits.pullback.fst (Limits.pullback.snd g a) ξ) m
