    exact @Function.Injective.subsingleton _ _ _ (e1.trans e2).injective hfib

  have leray : ∀ {U P : Scheme.{u}} (j : U ⟶ P),
      (∀ (I : InjectiveResolution ((constantSheaf (Scheme.smallEtaleTopology U)
          AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))))) (p q' : ℕ),
