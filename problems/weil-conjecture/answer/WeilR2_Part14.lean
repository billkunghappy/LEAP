    exact m.2.2 hg₀Q

theorem wc_fet_ext_noetherian_tame_of_unit : ∀ (ℓ : ℕ), ℓ.Prime → ∀ (A₀ : Type u) [CommRing A₀] [IsDomain A₀] [IsIntegrallyClosed A₀] [IsNoetherianRing A₀], IsUnit (ℓ : A₀) → ∀ (ζ : A₀), IsPrimitiveRoot ζ ℓ → ∀ (X : Scheme.{u}) [CompactSpace X] [QuasiSeparatedSpace X] (f : X ⟶ Spec (.of A₀)) [Smooth f] (σ : Spec (.of A₀) ⟶ X) (hσ : σ ≫ f = 𝟙 _), (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (z : Spec (.of Ω) ⟶ Spec (.of A₀)), ConnectedSpace ↥(Limits.pullback f z)) → ∀ (P : Scheme.{u}) (p : P ⟶ Limits.pullback f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) (α : ZMod ℓ → (P ⟶ P)), wcFetTorsor p ℓ α → (∃ r : Spec (.of (FractionRing A₀)) ⟶ P, r ≫ p = Limits.pullback.lift (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))) ≫ σ) (𝟙 _) (by rw [Category.assoc, hσ, Category.comp_id, Category.id_comp])) → ∃ (Y : Scheme.{u}) (q : Y ⟶ X) (β : ZMod ℓ → (Y ⟶ Y)) (i : P ⟶ Y), wcFetTorsor q ℓ β ∧ IsPullback i p q (Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) :=
by
  intro ℓ hℓ A₀ _ _ _ _ hℓu ζ hζ X _ _ f _ σ hσ hconn P p α hP hr
