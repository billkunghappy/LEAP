  have s2 : ∀ (Ω : Type u) [Field Ω] (d : ℕ), ∃ (σ : MvPolynomial (Option (Fin d)) Ω →+* MvPolynomial (Fin d) Ω), IsClosedImmersion (Spec.map (CommRingCat.ofHom σ)) ∧ SmoothOfRelativeDimension d (Spec.map (CommRingCat.ofHom σ) ≫ Spec.map (CommRingCat.ofHom (algebraMap Ω (MvPolynomial (Option (Fin d)) Ω)))) ∧ ∀ p : Spec (.of (MvPolynomial (Option (Fin d)) Ω)), (p ∈ Set.range (Spec.map (CommRingCat.ofHom σ)) ↔ (MvPolynomial.X none : MvPolynomial (Option (Fin d)) Ω) ∈ p.asIdeal) := by
