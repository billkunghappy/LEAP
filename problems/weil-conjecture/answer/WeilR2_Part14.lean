    haveI : Etale t := MorphismProperty.of_isPullback (P := @Etale) hB ‹Etale e›
    obtain ⟨R, _, _, _, hT, ψ, hψ, hEt⟩ := s3 _ (Limits.pullback.snd (e ≫ Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) zb) t ht2
    have hS2 : IsPullback (Limits.pullback.lift (Limits.pullback.fst (e ≫ Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) (Spec.map (CommRingCat.ofHom (algebraMap L Ω)) ≫ zb)) (Limits.pullback.snd (e ≫ Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) (Spec.map (CommRingCat.ofHom (algebraMap L Ω)) ≫ zb) ≫ Spec.map (CommRingCat.ofHom (algebraMap L Ω))) (by rw [Limits.pullback.condition, Category.assoc]))
        (Limits.pullback.snd (e ≫ Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) (Spec.map (CommRingCat.ofHom (algebraMap L Ω)) ≫ zb))
        (Limits.pullback.snd (e ≫ Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) zb) (Spec.map (CommRingCat.ofHom (algebraMap L Ω))) := by
      refine IsPullback.of_right ?_ (Limits.pullback.lift_snd _ _ _)
        (IsPullback.of_hasPullback (e ≫ Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) zb)
      rw [Limits.pullback.lift_fst]
      exact IsPullback.of_hasPullback _ _
    obtain ⟨Θ, hΘ⟩ := s4 R _ _ _ _ _ ψ hψ hS2
    exact ⟨R, _, _, _, hT, ψ, Θ, hEt, hΘ⟩
  obtain ⟨R, _, _, _, _, ψ, Θ, hRet, hΘ⟩ := pres
  haveI := hRet
  haveI : NeZero ℓ := ⟨hℓ.ne_zero⟩
  have core : ∀ (P' : Scheme.{u}) (p' : P' ⟶ Spec (.of (TensorProduct L R Ω)))
      (α' : ZMod ℓ → (P' ⟶ P')), wcFetTorsor p' ℓ α' →
      ∃ (Q : Scheme.{u}) (q : Q ⟶ Spec (.of R)) (β : ZMod ℓ → (Q ⟶ Q)) (j : P' ⟶ Q),
        wcFetTorsor q ℓ β ∧
        IsPullback j p' q (Spec.map (CommRingCat.ofHom (algebraMap R (TensorProduct L R Ω)))) := by
    intro P' p' α' hP'
    obtain ⟨B, _, _, σ, φ, hφ, hσ0, hσadd, hBet, hBfin, hBsurj, hBmu⟩ :=
      wc_fet_torsor_affine_ring_data (TensorProduct L R Ω) P' p' ℓ α' hP'
    letI : Algebra L B := ((algebraMap (TensorProduct L R Ω) B).comp
      (algebraMap L (TensorProduct L R Ω))).toAlgebra
    letI : Algebra R B := ((algebraMap (TensorProduct L R Ω) B).comp
      (algebraMap R (TensorProduct L R Ω))).toAlgebra
    haveI : IsScalarTower L (TensorProduct L R Ω) B := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    haveI : IsScalarTower R (TensorProduct L R Ω) B := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    let M : Submodule (TensorProduct L R Ω) B :=
      { carrier := {b | σ 1 b = algebraMap L B ζ * b}
        add_mem' := fun {a b} ha hb => by
          simp only [Set.mem_setOf_eq] at ha hb ⊢
