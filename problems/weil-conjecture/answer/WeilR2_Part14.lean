        rw [← hQ]
        ext c
        rw [Ideal.mem_map_of_equiv, Ideal.mem_comap]
        constructor
        · rintro ⟨z, hz, rfl⟩
          rw [← hsymm, RingEquiv.symm_apply_apply]
          exact hz
        · intro hc
          exact ⟨MvPolynomial.C c, hc, by rw [← hsymm, RingEquiv.apply_symm_apply]⟩
      obtain ⟨Φ⟩ := H2 _ _ (MvPolynomial.isEmptyAlgEquiv C (Fin 0)).toRingEquiv Q p hmap.symm
      haveI := hreg
      exact IsRegularLocalRing.of_ringEquiv Φ.symm
    | succ n ih =>
      intro C _ _ p _ hreg Q _ hQ
      haveI hQ' : (Q.map (MvPolynomial.finSuccEquiv C n).toRingEquiv).IsPrime :=
        Ideal.map_isPrime_of_equiv _
      haveI : ((Q.map (MvPolynomial.finSuccEquiv C n).toRingEquiv).comap Polynomial.C).IsPrime :=
        Ideal.comap_isPrime _ _
      have hEC : ∀ c : C, (MvPolynomial.finSuccEquiv C n).toRingEquiv (MvPolynomial.C c) =
          Polynomial.C (MvPolynomial.C c) := by
        intro c
        show MvPolynomial.finSuccEquiv C n (MvPolynomial.C c) = _
        rw [MvPolynomial.finSuccEquiv_apply, MvPolynomial.eval₂Hom_C]
        rfl
      have hmemE : ∀ z, (MvPolynomial.finSuccEquiv C n).toRingEquiv z ∈
          Q.map (MvPolynomial.finSuccEquiv C n).toRingEquiv ↔ z ∈ Q := by
        intro z
        rw [Ideal.mem_map_of_equiv]
        constructor
        · rintro ⟨w, hw, h⟩
          rw [(MvPolynomial.finSuccEquiv C n).toRingEquiv.injective h] at hw
          exact hw
        · intro hz
          exact ⟨z, hz, rfl⟩
      have hQ₀ : ((Q.map (MvPolynomial.finSuccEquiv C n).toRingEquiv).comap Polynomial.C).comap
          (MvPolynomial.C : C →+* MvPolynomial (Fin n) C) = p := by
        rw [← hQ]
        ext c
        rw [Ideal.mem_comap, Ideal.mem_comap, Ideal.mem_comap, ← hEC, hmemE]
      have h0 := ih C p hreg _ hQ₀
      haveI := H1 (MvPolynomial (Fin n) C) _ h0
        (Q.map (MvPolynomial.finSuccEquiv C n).toRingEquiv) rfl
      obtain ⟨Φ⟩ := H2 _ _ (MvPolynomial.finSuccEquiv C n).toRingEquiv Q
        (Q.map (MvPolynomial.finSuccEquiv C n).toRingEquiv) rfl
      exact IsRegularLocalRing.of_ringEquiv Φ.symm
  have sEt : (∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A] (B : Type u)
      [CommRing B] [IsLocalRing B] [IsNoetherianRing B] [Algebra A B] [IsLocalHom (algebraMap A B)]
      [Module.Flat A B], IsRegularLocalRing A →
      IsRegularLocalRing (B ⧸ Ideal.map (algebraMap A B) (IsLocalRing.maximalIdeal A)) →
      IsRegularLocalRing B) →
      ∀ (P : Type u) [CommRing P] [IsNoetherianRing P] (T : Type u) [CommRing T] [Algebra P T]
      [Algebra.Etale P T] (q : Ideal T) [q.IsPrime],
      IsRegularLocalRing (Localization.AtPrime (q.comap (algebraMap P T))) →
      IsRegularLocalRing (Localization.AtPrime q) := by
    intro R1 P _ _ T _ _ _ q _ hreg
    haveI : IsNoetherianRing T := Algebra.FiniteType.isNoetherianRing P T
    haveI : IsNoetherianRing (Localization.AtPrime (q.comap (algebraMap P T))) :=
      IsLocalization.isNoetherianRing (q.comap (algebraMap P T)).primeCompl _ ‹_›
    haveI : IsNoetherianRing (Localization.AtPrime q) :=
      IsLocalization.isNoetherianRing q.primeCompl _ ‹_›
    letI : Algebra (Localization.AtPrime (q.comap (algebraMap P T))) (Localization.AtPrime q) :=
      (Localization.localRingHom (q.comap (algebraMap P T)) q (algebraMap P T) rfl).toAlgebra
    haveI : IsLocalHom (algebraMap (Localization.AtPrime (q.comap (algebraMap P T)))
        (Localization.AtPrime q)) :=
      Localization.isLocalHom_localRingHom (q.comap (algebraMap P T)) q _ rfl
    haveI : Module.Flat (Localization.AtPrime (q.comap (algebraMap P T)))
        (Localization.AtPrime q) := by
      rw [← RingHom.flat_algebraMap_iff]
      exact RingHom.Flat.localRingHom (RingHom.flat_algebraMap_iff.mpr inferInstance) q _ rfl
    haveI : IsScalarTower P (Localization.AtPrime (q.comap (algebraMap P T)))
        (Localization.AtPrime q) := IsScalarTower.of_algebraMap_eq (fun x => by
      rw [RingHom.algebraMap_toAlgebra, Localization.localRingHom_to_map,
        IsScalarTower.algebraMap_apply P T (Localization.AtPrime q)])
    haveI : Algebra.FormallyUnramified P (Localization.AtPrime q) :=
      Algebra.FormallyUnramified.comp P T _
    haveI : Algebra.FormallyUnramified (Localization.AtPrime (q.comap (algebraMap P T)))
        (Localization.AtPrime q) := Algebra.FormallyUnramified.of_restrictScalars P _ _
    haveI : Algebra.EssFiniteType P (Localization.AtPrime q) := Algebra.EssFiniteType.comp P T _
    haveI : Algebra.EssFiniteType (Localization.AtPrime (q.comap (algebraMap P T)))
        (Localization.AtPrime q) := Algebra.EssFiniteType.of_comp P _ _
    have hm : Ideal.map (algebraMap (Localization.AtPrime (q.comap (algebraMap P T)))
        (Localization.AtPrime q))
        (IsLocalRing.maximalIdeal (Localization.AtPrime (q.comap (algebraMap P T))))
        = IsLocalRing.maximalIdeal (Localization.AtPrime q) :=
      Algebra.FormallyUnramified.map_maximalIdeal
    have hres : IsRegularLocalRing (IsLocalRing.ResidueField (Localization.AtPrime q)) :=
      @hF _ (IsLocalRing.ResidueField.field _)
    let E : IsLocalRing.ResidueField (Localization.AtPrime q) ≃+* (Localization.AtPrime q ⧸
        Ideal.map (algebraMap (Localization.AtPrime (q.comap (algebraMap P T)))
          (Localization.AtPrime q))
        (IsLocalRing.maximalIdeal (Localization.AtPrime (q.comap (algebraMap P T))))) :=
      Ideal.quotEquivOfEq hm.symm
    have hfib : IsRegularLocalRing (Localization.AtPrime q ⧸ Ideal.map
        (algebraMap (Localization.AtPrime (q.comap (algebraMap P T))) (Localization.AtPrime q))
        (IsLocalRing.maximalIdeal (Localization.AtPrime (q.comap (algebraMap P T))))) :=
      IsRegularLocalRing.of_ringEquiv E
    exact R1 _ _ hreg hfib

  have primeCrit : ∀ (S₀ R₀ : Type u) [CommRing S₀] [CommRing R₀] [IsLocalRing R₀] (σ₀ : S₀ →+* R₀),
      wcIndEtale σ₀ → ∀ (s : S₀), IsDomain (S₀ ⧸ Ideal.span {s}) →
      IsIntegrallyClosed (S₀ ⧸ Ideal.span {s}) → ¬ IsUnit (σ₀ s) →
      ∀ a₁ b₁ : R₀, σ₀ s ∣ a₁ * b₁ → σ₀ s ∣ a₁ ∨ σ₀ s ∣ b₁ := by
    intro S₀ R₀ _ _ _ σ₀ hσ₀ s hSd hSi hnu a₁ b₁ hab
    obtain ⟨c, hc⟩ := hab
    letI : Algebra S₀ R₀ := σ₀.toAlgebra
    haveI := hSd
    haveI := hSi
    let I : Ideal (MvPolynomial (Fin 3) S₀) :=
      Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C s * MvPolynomial.X 2}
    haveI hfp : Algebra.FinitePresentation S₀ (MvPolynomial (Fin 3) S₀ ⧸ I) :=
      Algebra.FinitePresentation.quotient (Submodule.fg_span_singleton _)
    let f0 : MvPolynomial (Fin 3) S₀ →ₐ[S₀] R₀ := MvPolynomial.aeval ![a₁, b₁, c]
    have hgen : f0 (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C s * MvPolynomial.X 2) = 0 := by
      simp only [f0, map_sub, map_mul, MvPolynomial.aeval_X, MvPolynomial.aeval_C]
      simp [hc, RingHom.algebraMap_toAlgebra]
    have hf0 : ∀ x ∈ I, f0 x = 0 := by
      intro x hx
      obtain ⟨t, rfl⟩ := Ideal.mem_span_singleton'.mp hx
      rw [map_mul, hgen, mul_zero]
    obtain ⟨E, _, _, hEt, α, β₀, hβα⟩ := hσ₀ _ (Ideal.Quotient.liftₐ I f0 hf0)
    haveI := hEt
    have hval : ∀ i, β₀ (α (Ideal.Quotient.mk I (MvPolynomial.X i))) = ![a₁, b₁, c] i := by
      intro i
      rw [← AlgHom.comp_apply, hβα]
      first
      | (change f0 (MvPolynomial.X i) = _; simp [f0])
      | (rw [Ideal.Quotient.liftₐ_apply]; exact (Ideal.Quotient.lift_mk I (f0 : MvPolynomial (Fin 3) S₀ →+* R₀) hf0).trans (by simp [f0]))
    have hrel : α (Ideal.Quotient.mk I (MvPolynomial.X 0)) * α (Ideal.Quotient.mk I (MvPolynomial.X 1)) =
        algebraMap S₀ E s * α (Ideal.Quotient.mk I (MvPolynomial.X 2)) := by
      have h1 : Ideal.Quotient.mk I (MvPolynomial.X 0 * MvPolynomial.X 1) =
          Ideal.Quotient.mk I (MvPolynomial.C s * MvPolynomial.X 2) :=
        Ideal.Quotient.eq.mpr (Ideal.mem_span_singleton_self _)
      rw [← map_mul, ← map_mul, h1, map_mul, map_mul, ← MvPolynomial.algebraMap_eq,
        Ideal.Quotient.mk_algebraMap, AlgHom.commutes]
    have hs0 : algebraMap S₀ (R₀ ⧸ Ideal.span {σ₀ s}) s = 0 := by
      rw [← Ideal.Quotient.mk_algebraMap]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _)
    have hJ : ∀ x ∈ Ideal.span {s}, (Algebra.ofId S₀ (R₀ ⧸ Ideal.span {σ₀ s})) x = 0 := by
      intro x hx
      obtain ⟨t, rfl⟩ := Ideal.mem_span_singleton'.mp hx
      rw [map_mul, show (Algebra.ofId S₀ (R₀ ⧸ Ideal.span {σ₀ s})) s = 0 from
        (Algebra.ofId_apply _ s).trans hs0, mul_zero]
    let g2 : (S₀ ⧸ Ideal.span {s}) →ₐ[S₀] (R₀ ⧸ Ideal.span {σ₀ s}) :=
      Ideal.Quotient.liftₐ _ (Algebra.ofId _ _) hJ
    let g1 : E →ₐ[S₀] (R₀ ⧸ Ideal.span {σ₀ s}) := (Ideal.Quotient.mkₐ S₀ _).comp β₀
    let βb := Algebra.TensorProduct.productMap g2 g1
    haveI : Nontrivial (R₀ ⧸ Ideal.span {σ₀ s}) :=
      Ideal.Quotient.nontrivial_iff.mpr (fun h => hnu (Ideal.span_singleton_eq_top.mp h))
    haveI : IsLocalRing (R₀ ⧸ Ideal.span {σ₀ s}) :=
      IsLocalRing.of_surjective' (Ideal.Quotient.mk _) Ideal.Quotient.mk_surjective
    let q : Ideal (TensorProduct S₀ (S₀ ⧸ Ideal.span {s}) E) :=
      Ideal.comap βb.toRingHom (IsLocalRing.maximalIdeal (R₀ ⧸ Ideal.span {σ₀ s}))
    haveI : q.IsPrime := Ideal.comap_isPrime _ _
    haveI hLd : IsDomain (Localization.AtPrime q) :=
      wc_ring_etale_localization_isDomain (S₀ ⧸ Ideal.span {s}) _ q
    have hunit : ∀ t : q.primeCompl,
        IsUnit (βb.toRingHom (t : TensorProduct S₀ (S₀ ⧸ Ideal.span {s}) E)) := by
      intro t
      exact IsLocalRing.notMem_maximalIdeal.mp
        (fun hm => (Ideal.mem_primeCompl_iff.mp t.2) (Ideal.mem_comap.mpr hm))
    have hβb : ∀ e : E, βb ((1 : S₀ ⧸ Ideal.span {s}) ⊗ₜ[S₀] e) =
        Ideal.Quotient.mk (Ideal.span {σ₀ s}) (β₀ e) := by
      intro e
      simp only [βb, Algebra.TensorProduct.productMap_apply_tmul, map_one, one_mul]
      rfl
    have hs1 : s • (1 : S₀ ⧸ Ideal.span {s}) = 0 := by
      rw [Algebra.smul_def, mul_one, Ideal.Quotient.algebraMap_eq]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _)
    have hprod : ((1 : S₀ ⧸ Ideal.span {s}) ⊗ₜ[S₀] α (Ideal.Quotient.mk I (MvPolynomial.X 0))) *
        ((1 : S₀ ⧸ Ideal.span {s}) ⊗ₜ[S₀] α (Ideal.Quotient.mk I (MvPolynomial.X 1))) = 0 := by
      rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul, hrel, ← Algebra.smul_def,
        TensorProduct.tmul_smul, TensorProduct.smul_tmul', hs1, TensorProduct.zero_tmul]
    have key : ∀ i, algebraMap (TensorProduct S₀ (S₀ ⧸ Ideal.span {s}) E) (Localization.AtPrime q)
        ((1 : S₀ ⧸ Ideal.span {s}) ⊗ₜ[S₀] α (Ideal.Quotient.mk I (MvPolynomial.X i))) = 0 →
        σ₀ s ∣ ![a₁, b₁, c] i := by
      intro i hi
      have h3 := congrArg (IsLocalization.lift (M := q.primeCompl) (S := Localization.AtPrime q) hunit) hi
      rw [IsLocalization.lift_eq, map_zero] at h3
      have h4 : βb ((1 : S₀ ⧸ Ideal.span {s}) ⊗ₜ[S₀] α (Ideal.Quotient.mk I (MvPolynomial.X i))) = 0 := h3
      rw [hβb, hval] at h4
      exact Ideal.mem_span_singleton.mp (Ideal.Quotient.eq_zero_iff_mem.mp h4)
    have hz : algebraMap (TensorProduct S₀ (S₀ ⧸ Ideal.span {s}) E) (Localization.AtPrime q)
          ((1 : S₀ ⧸ Ideal.span {s}) ⊗ₜ[S₀] α (Ideal.Quotient.mk I (MvPolynomial.X 0))) *
        algebraMap (TensorProduct S₀ (S₀ ⧸ Ideal.span {s}) E) (Localization.AtPrime q)
          ((1 : S₀ ⧸ Ideal.span {s}) ⊗ₜ[S₀] α (Ideal.Quotient.mk I (MvPolynomial.X 1))) = 0 := by
      rw [← map_mul, hprod, map_zero]
    rcases mul_eq_zero.mp hz with h | h
    · left; simpa using key 0 h
    · right; simpa using key 1 h

  have hquot : ∀ (A : Type u) [CommRing A] [IsDomain A] [UniqueFactorizationMonoid A] (d : ℕ),
      IsDomain (MvPolynomial (Option (Fin d)) A ⧸
        Ideal.span {(MvPolynomial.X none : MvPolynomial (Option (Fin d)) A)}) ∧
      IsIntegrallyClosed (MvPolynomial (Option (Fin d)) A ⧸
        Ideal.span {(MvPolynomial.X none : MvPolynomial (Option (Fin d)) A)}) := by
    intro A _ _ _ d
    let e₁ : MvPolynomial (Option (Fin d)) A ≃+* Polynomial (MvPolynomial (Fin d) A) :=
      (MvPolynomial.optionEquivLeft A (Fin d)).toRingEquiv
    have hX : e₁ (MvPolynomial.X none) = Polynomial.X := MvPolynomial.optionEquivLeft_X_none A (Fin d)
    have hJ : Ideal.span {(Polynomial.X : Polynomial (MvPolynomial (Fin d) A))} =
        Ideal.map (e₁ : MvPolynomial (Option (Fin d)) A →+* Polynomial (MvPolynomial (Fin d) A))
          (Ideal.span {MvPolynomial.X none}) := by
      rw [Ideal.map_span, Set.image_singleton]
      congr 2
      exact hX.symm
    have hJ2 : Ideal.span {(Polynomial.X : Polynomial (MvPolynomial (Fin d) A))} =
        Ideal.span {Polynomial.X - Polynomial.C 0} := by
      rw [Polynomial.C_0, sub_zero]
    let E1 : MvPolynomial (Option (Fin d)) A ⧸
        Ideal.span {(MvPolynomial.X none : MvPolynomial (Option (Fin d)) A)} ≃+*
        MvPolynomial (Fin d) A :=
      ((Ideal.quotientEquiv _ _ e₁ hJ).trans (Ideal.quotEquivOfEq hJ2)).trans
        (Polynomial.quotientSpanXSubCAlgEquiv (0 : MvPolynomial (Fin d) A)).toRingEquiv
    haveI hd := MulEquiv.isDomain (MvPolynomial (Fin d) A) E1.toMulEquiv
    haveI hu := MulEquiv.uniqueFactorizationMonoid E1.symm.toMulEquiv inferInstance
    exact ⟨hd, inferInstance⟩
  have comp_ap : ∀ {X Y Z : Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ Z) (x : X), (f ≫ g) x = g (f x) := by
    intro X Y Z f g x
    first
    | rfl
    | simp

  intro A _ _ _ _ _ d y hy hy0 B _ _ _ Λ _ _ W' φ a ha β hβ
  haveI hBloc : IsLocalRing B := inferInstance
  have hAreg : IsRegularLocalRing A := inferInstance
  haveI hAnt : Nontrivial A := inferInstance
  haveI hAloc : IsLocalRing A := inferInstance
  haveI hAnoeth : IsNoetherianRing A := inferInstance
  haveI hAufd : UniqueFactorizationMonoid A := inferInstance

  have hWa := wc_shdata_weaklyEtale y B Λ W' φ a ha
  rw [← hβ] at hWa
  have hWE := wc_lpkt_specMap_weaklyEtale_ring _ B β hWa
  letI : Algebra (MvPolynomial (Option (Fin d)) A) B := β.toAlgebra

  have hsep : IsSepClosed (IsLocalRing.ResidueField B) := inferInstance
  obtain ⟨R', _, σ, ρ, _, hρσ, hRh, hRsep, hρloc, hσ⟩ :=
    wc_strict_hull (MvPolynomial (Option (Fin d)) A) B hsep
  letI : Algebra (MvPolynomial (Option (Fin d)) A) R' := σ.toAlgebra
  letI : Algebra R' B := ρ.toAlgebra
  haveI : IsScalarTower (MvPolynomial (Option (Fin d)) A) R' B :=
    IsScalarTower.of_algebraMap_eq' hρσ.symm
  haveI hWE_CR : Algebra.WeaklyEtale (MvPolynomial (Option (Fin d)) A) R' :=
    wc_indEtale_weaklyEtale σ hσ
  have hWE_RB : Algebra.WeaklyEtale R' B := wc_weaklyEtale_cancel _ _ _ hWE_CR hWE
  have hbij : Function.Bijective ρ := wc_olivier R' B hRh hRsep hρloc hWE_RB
  let Φ : R' ≃+* B := RingEquiv.ofBijective ρ hbij
  have hΦ : ∀ x, Φ (σ x) = β x := fun x => congrArg (fun f => f x) hρσ

  have R1 := wc_hnas_pfc_regular_flat_ascent
  have H1 := r3 (wc_pfc_pc_poly_localization_regular R1)
  have Hmv := sMv H1 s9
  have hRreg : ∀ (Q : Ideal (MvPolynomial (Option (Fin d)) A)) [Q.IsPrime],
      IsRegularLocalRing (Localization.AtPrime Q) := by
    intro Q _
    let e : MvPolynomial (Fin (d + 1)) A ≃+* MvPolynomial (Option (Fin d)) A :=
      (MvPolynomial.renameEquiv A (finSuccEquiv d)).toRingEquiv
    haveI hQ1 : (Q.comap e).IsPrime := Ideal.comap_isPrime _ _
    haveI hp : ((Q.comap e).comap (MvPolynomial.C : A →+* MvPolynomial (Fin (d + 1)) A)).IsPrime :=
      Ideal.comap_isPrime _ _
    have hAp := wc_hnas_pfc_regular_localization A hAreg
      ((Q.comap e).comap (MvPolynomial.C : A →+* MvPolynomial (Fin (d + 1)) A))
    have h1 := Hmv (d + 1) A _ hAp (Q.comap e) rfl
    obtain ⟨Ψ⟩ := s9 _ _ e (Q.comap e) Q (Ideal.map_comap_of_surjective e e.surjective Q).symm
    haveI := h1
    exact IsRegularLocalRing.of_ringEquiv Ψ

  have H : ∀ (E : Type u) [CommRing E] [Algebra (MvPolynomial (Option (Fin d)) A) E],
      Algebra.Etale (MvPolynomial (Option (Fin d)) A) E → ∀ (q : Ideal E) [q.IsPrime],
