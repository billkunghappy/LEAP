theorem wc_cpt_th_iso_bc_push_transport : ∀ {X Y S Z : Scheme.{u}} (θ : X ≅ Y) (g : X ⟶ S) (ρ : Y ⟶ S), θ.hom ≫ ρ = g → ∀ (z : Z ⟶ S) (m : ℕ), (∀ (L' : Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1} ⥤ Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}), Nonempty (L' ⊣ wcEtPush ρ) → Nonempty (L'.obj ((wcEtPush z).obj ((constantSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))) ≅ (wcEtPush (Limits.pullback.fst ρ z)).obj ((constantSheaf (Scheme.smallEtaleTopology (Limits.pullback ρ z)) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))))) → ∀ (L : Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1} ⥤ Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}), Nonempty (L ⊣ wcEtPush g) → Nonempty (L.obj ((wcEtPush z).obj ((constantSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))) ≅ (wcEtPush (Limits.pullback.fst g z)).obj ((constantSheaf (Scheme.smallEtaleTopology (Limits.pullback g z)) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))) :=
by
  intro X Y S Z θ g ρ hθ z m H L hL
  have P1X := (wc_et_push_id_comp_iso (𝟙 X) (𝟙 X)).1.some
  have P1Y := (wc_et_push_id_comp_iso (𝟙 Y) (𝟙 Y)).1.some
  have η : 𝟭 (Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) ≅
      wcEtPush θ.hom ⋙ wcEtPush θ.inv :=
    P1X.symm ≪≫ eqToIso (congrArg (fun k => wcEtPush k) θ.hom_inv_id).symm ≪≫
      ((wc_et_push_id_comp_iso θ.hom θ.inv).2.some).symm
  have ε : wcEtPush θ.inv ⋙ wcEtPush θ.hom ≅
      𝟭 (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) :=
    (wc_et_push_id_comp_iso θ.inv θ.hom).2.some ≪≫
      eqToIso (congrArg (fun k => wcEtPush k) θ.inv_hom_id) ≪≫ P1Y
  let Eθ := CategoryTheory.Equivalence.mk (wcEtPush θ.hom) (wcEtPush θ.inv) η ε
  have adjE : wcEtPush θ.hom ⊣ wcEtPush θ.inv := Eθ.toAdjunction
  have adj₀ := hL.some.comp adjE
  have hρ : θ.inv ≫ g = ρ := by rw [← hθ, Iso.inv_hom_id_assoc]
  have e₁ : wcEtPush θ.inv ⋙ wcEtPush g ≅ wcEtPush ρ :=
    (wc_et_push_id_comp_iso θ.inv g).2.some ≪≫ eqToIso (congrArg (fun k => wcEtPush k) hρ)
  have adj₁ := adj₀.ofNatIsoRight e₁
  have κ := (H (L ⋙ wcEtPush θ.hom) ⟨adj₁⟩).some
  have i₁ := η.app (L.obj ((wcEtPush z).obj ((constantSheaf (Scheme.smallEtaleTopology Z)
      AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))))) ≪≫
    (wcEtPush θ.inv).mapIso κ ≪≫
    ((wc_et_push_id_comp_iso (Limits.pullback.fst ρ z) θ.inv).2.some).app _
  have e1 : g ≫ 𝟙 S = θ.hom ≫ ρ := by rw [Category.comp_id, hθ]
  have e2 : z ≫ 𝟙 S = 𝟙 Z ≫ z := by simp
