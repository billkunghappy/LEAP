    have h1 := hK q
    have hq' : (MvPolynomial.aeval (fun o : Option (Fin d) => Option.elim o (0 : MvPolynomial (Fin d) A) MvPolynomial.X) : MvPolynomial (Option (Fin d)) A →ₐ[A] MvPolynomial (Fin d) A) q = 0 := hq
    rw [hq', map_zero, sub_zero] at h1
    exact hspan h1
  have hprime : (Ideal.map (MvPolynomial.aeval (fun o : Option (Fin d) => Option.elim o (0 : MvPolynomial (Fin d) A) MvPolynomial.X) : MvPolynomial (Option (Fin d)) A →ₐ[A] MvPolynomial (Fin d) A).toRingHom y.asIdeal).IsPrime := by
    haveI := y.isPrime
    exact Ideal.map_isPrime_of_surjective hsurj hker
  let y₀ : Spec (.of (MvPolynomial (Fin d) A)) :=
    ⟨Ideal.map (MvPolynomial.aeval (fun o : Option (Fin d) => Option.elim o (0 : MvPolynomial (Fin d) A) MvPolynomial.X) : MvPolynomial (Option (Fin d)) A →ₐ[A] MvPolynomial (Fin d) A).toRingHom y.asIdeal, hprime⟩
  have hy₀ : Spec.map (CommRingCat.ofHom (MvPolynomial.aeval (fun o : Option (Fin d) => Option.elim o (0 : MvPolynomial (Fin d) A) MvPolynomial.X) : MvPolynomial (Option (Fin d)) A →ₐ[A] MvPolynomial (Fin d) A).toRingHom) y₀ = y := by
    apply PrimeSpectrum.ext
    change Ideal.comap (MvPolynomial.aeval (fun o : Option (Fin d) => Option.elim o (0 : MvPolynomial (Fin d) A) MvPolynomial.X) : MvPolynomial (Option (Fin d)) A →ₐ[A] MvPolynomial (Fin d) A).toRingHom (Ideal.map (MvPolynomial.aeval (fun o : Option (Fin d) => Option.elim o (0 : MvPolynomial (Fin d) A) MvPolynomial.X) : MvPolynomial (Option (Fin d)) A →ₐ[A] MvPolynomial (Fin d) A).toRingHom y.asIdeal) = y.asIdeal
    rw [Ideal.comap_map_of_surjective _ hsurj]
    exact sup_eq_left.mpr hker
  have hf0 : Spec.map (CommRingCat.ofHom (algebraMap A (MvPolynomial (Fin d) A))) =
      Spec.map (CommRingCat.ofHom (MvPolynomial.aeval (fun o : Option (Fin d) => Option.elim o (0 : MvPolynomial (Fin d) A) MvPolynomial.X) : MvPolynomial (Option (Fin d)) A →ₐ[A] MvPolynomial (Fin d) A).toRingHom) ≫
        Spec.map (CommRingCat.ofHom (algebraMap A (MvPolynomial (Option (Fin d)) A))) := by
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
    congr 2
    exact (AlgHom.comp_algebraMap (MvPolynomial.aeval (fun o : Option (Fin d) => Option.elim o (0 : MvPolynomial (Fin d) A) MvPolynomial.X) : MvPolynomial (Option (Fin d)) A →ₐ[A] MvPolynomial (Fin d) A)).symm
  have hfy0 : Spec.map (CommRingCat.ofHom (algebraMap A (MvPolynomial (Fin d) A))) y₀ =
      IsLocalRing.closedPoint A := by
    rw [hf0, Scheme.Hom.comp_apply, hy₀]
