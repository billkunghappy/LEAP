        B₀ →ₐ[R] TensorProduct R (TensorProduct L R Ω) B₀).toRingHom)), hQ, ?_⟩
    refine IsPullback.of_iso hsq φ.symm (Iso.refl _) (Iso.refl _) (Iso.refl _) ?_ ?_ ?_ ?_
    · simp
    · simp [← hφ]
    · simp
    · simp
  exact wc_fet_descent_iso_transport _ _ ψ Θ hΘ ℓ core P p α hP

theorem wc_affine_line_etale_section_through_closed_point : ∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsAlgClosed (IsLocalRing.ResidueField A)] (W : Scheme.{u}) (e : W ⟶ Spec (.of (Polynomial A))) [Etale e] (w : W), IsClosed ({e w} : Set (Spec (.of (Polynomial A)))) → Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A))) (e w) = IsLocalRing.closedPoint A → ∃ σ : Spec (.of A) ⟶ W, σ ≫ e ≫ Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A))) = 𝟙 _ ∧ σ (IsLocalRing.closedPoint A) = w :=
by
  intro A _ _ _ W e _ w hx hxc
  classical
  haveI : Algebra.Smooth A (Polynomial A) := ⟨inferInstance, inferInstance⟩
  haveI : Smooth (Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) := by
    rw [HasRingHomProperty.Spec_iff (P := @Smooth)]
    exact RingHom.smooth_algebraMap.mpr inferInstance
  haveI : Smooth (e ≫ Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) := inferInstance
  let res : Spec (.of (IsLocalRing.ResidueField A)) ⟶ Spec (.of A) :=
    Spec.map (CommRingCat.ofHom (IsLocalRing.residue A))
  have hres : ∀ q, res q = IsLocalRing.closedPoint A := fun q =>
    IsLocalRing.PrimeSpectrum.comap_residue A q
  haveI : IsClosedImmersion res :=
    IsClosedImmersion.spec_of_surjective _ IsLocalRing.residue_surjective
  haveI : IsClosedImmersion (Limits.pullback.fst
      (Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) res) :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion)
      (IsPullback.of_hasPullback (Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) res).flip
      inferInstance
  haveI : LocallyOfFiniteType (Limits.pullback.snd
      (Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) res) :=
    MorphismProperty.of_isPullback (P := @LocallyOfFiniteType)
      (IsPullback.of_hasPullback (Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) res)
      inferInstance
  obtain ⟨y, hy1, -⟩ := Scheme.Pullback.exists_preimage_pullback
    (f := Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) (g := res)
    (e w) (IsLocalRing.closedPoint _) (hxc.trans (hres _).symm)
  have hyc : IsClosed ({y} : Set ↥(Limits.pullback
      (Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) res : Scheme.{u})) := by
    have hinj := (Scheme.Hom.isClosedEmbedding (Limits.pullback.fst
      (Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) res)).isEmbedding.injective
    have hset : ({y} : Set ↥(Limits.pullback
        (Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) res : Scheme.{u})) =
        (Limits.pullback.fst (Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) res) ⁻¹'
