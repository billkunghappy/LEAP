      (∀ m : ℕ, 3 ≤ m → Subsingleton (wcEtExt P ((wcEtPush j).obj
          ((constantSheaf (Scheme.smallEtaleTopology U) AddCommGrpCat.{u+1}).obj
            (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))))) m)) →
      (∀ n : ℕ, 2 ≤ n → Subsingleton (wcEtCoh U ℓ n)) →
