theorem wc_shdata_weaklyEtale : ∀ {Y : Scheme.{u}} (y : Y) (B : Type u) [CommRing B] [IsLocalRing B] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt Y y)) (Scheme.Etale.forget Y)) (φ : ∀ l, Spec (.of B) ⟶ (W'.obj l).right.left) (a : Spec (.of B) ⟶ Y), wcHalShData y B Λ W' φ a → WeaklyEtale a :=
by
  classical

  have L2a : ∀ (R B : Type u) [CommRing R] [CommRing B] (β : R →+* B) (I : Type u)
      [SmallCategory I] [IsFiltered I] (F : I ⥤ CommRingCat.{u}) (p : ∀ i, R →+* F.obj i)
      (ι : ∀ i, F.obj i →+* B), (∀ i, (p i).Etale) →
      (∀ {i j : I} (f : i ⟶ j), (F.map f).hom.comp (p i) = p j) →
      (∀ {i j : I} (f : i ⟶ j), (ι j).comp (F.map f).hom = ι i) →
      (∀ i, (ι i).comp (p i) = β) → (∀ b : B, ∃ (i : I) (t : F.obj i), ι i t = b) →
      (∀ (i : I) (t : F.obj i), ι i t = 0 → ∃ (j : I) (f : i ⟶ j), (F.map f).hom t = 0) →
      wcIndEtale β := by
    intro R B _ _ β I _ _ F p ι hp hFp hιF hιp hsurj hker

    have hlift : ∀ (n : ℕ) (t : Fin n → B), ∃ (j : I) (x : Fin n → F.obj j),
        ∀ k, ι j (x k) = t k := by
      intro n
      induction n with
      | zero => intro t; exact ⟨IsFiltered.nonempty.some, Fin.elim0, fun k => Fin.elim0 k⟩
      | succ n ih =>
        intro t
        obtain ⟨j, x, hx⟩ := ih (fun k => t k.castSucc)
        obtain ⟨i, s, hs⟩ := hsurj (t (Fin.last n))
        refine ⟨IsFiltered.max j i, Fin.lastCases ((F.map (IsFiltered.rightToMax j i)).hom s)
          (fun k => (F.map (IsFiltered.leftToMax j i)).hom (x k)), ?_⟩
        intro k
        rcases Fin.eq_castSucc_or_eq_last k with ⟨k', rfl⟩ | rfl
        · simp only [Fin.lastCases_castSucc]
          exact (RingHom.congr_fun (hιF _) (x k')).trans (hx k')
        · simp only [Fin.lastCases_last]
          exact (RingHom.congr_fun (hιF _) s).trans hs

    have hkill : ∀ (j₀ : I) (r : ℕ) (g : Fin r → F.obj j₀), (∀ m, ι j₀ (g m) = 0) →
        ∃ (j₁ : I) (u : j₀ ⟶ j₁), ∀ m, (F.map u).hom (g m) = 0 := by
      intro j₀ r
      induction r with
      | zero => intro g _; exact ⟨j₀, 𝟙 j₀, fun m => Fin.elim0 m⟩
      | succ r ih =>
        intro g hg
        obtain ⟨j, u, hu⟩ := ih (fun m => g m.castSucc) (fun m => hg _)
        have h1 : ι j ((F.map u).hom (g (Fin.last r))) = 0 :=
          (RingHom.congr_fun (hιF u) _).trans (hg _)
        obtain ⟨j', f, hf⟩ := hker j _ h1
        refine ⟨j', u ≫ f, fun m => ?_⟩
        rw [Functor.map_comp, CommRingCat.hom_comp, RingHom.comp_apply]
