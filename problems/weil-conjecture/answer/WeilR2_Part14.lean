      (a ≫ Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) c
      (a' ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥A0 (Polynomial ↥A0))))
      (Spec.map (CommRingCat.ofHom γ0)) u (Spec.map (CommRingCat.ofHom C0.subtype))
      (Spec.map (CommRingCat.ofHom A0.subtype)) h₁ h₂).appTop.hom t hlift hrel

