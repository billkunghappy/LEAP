    fun H => isIso_toSheafify τ (Functor.op_comp_isSheaf B τ (Scheme.smallEtaleTopology Z) H)
  let e : ∀ H : Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1},
