  have hlaur : (Polynomial.eval₂RingHom (algebraMap K (LaurentPolynomial K))
      (LaurentPolynomial.T 1 + LaurentPolynomial.T (-1))).Finite := by
    have gen : ∀ {B : Type u} [CommRing B] (ψ : Polynomial K →+* B) (t s : B),
        ψ Polynomial.X = t + s → t * s = 1 →
        (∀ N : Set B, (∀ x y, x ∈ N → y ∈ N → x + y ∈ N) →
          (∀ (n : ℕ) (a : K), ψ (Polynomial.C a) * t ^ n ∈ N) →
          (∀ (n : ℕ) (a : K), ψ (Polynomial.C a) * s ^ n ∈ N) → ∀ b, b ∈ N) →
        ψ.Finite := by
      intro B _ ψ t s hX hts hgen
      letI : Algebra (Polynomial K) B := ψ.toAlgebra
      have hsm : ∀ (g : Polynomial K) (f : B), g • f = ψ g * f := fun g f => Algebra.smul_def g f
      let M : Submodule (Polynomial K) B := Submodule.span (Polynomial K) ({1, t} : Set B)
      have hmemX : ∀ f ∈ M, (t + s) * f ∈ M := by
        intro f hf
