      wc_et_pull_comp (𝟙 Y) (𝟙 Y) (𝟙 Y) (Category.comp_id _) Did Did Did q x
    have h2 : wcEtPull Did q (wcEtPull Did q x - x) = 0 := by
      rw [map_sub, ← h1, sub_self]
    exact sub_eq_zero.mp (wc_et_pull_id_injective Did q _ h2)

  have we : (Limits.pullback.fst (Limits.pullback.snd g a) ξ ≫ Limits.pullback.fst g a) ≫ g =
      Limits.pullback.snd (Limits.pullback.snd g a) ξ ≫ γ := by
    rw [Category.assoc, Limits.pullback.condition, ← Category.assoc, Limits.pullback.condition,
