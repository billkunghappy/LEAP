        rw [AlgEquiv.apply_symm_apply]
        rfl
      show α₀ ((Ideal.quotientKerAlgEquivOfSurjective hfs).symm (f z)) = ψ₁ z
      rw [e]
      rfl
    let β' : (F.obj j₁ : Type u) →ₐ[R] B :=
      { toRingHom := ι j₁, commutes' := fun c => RingHom.congr_fun (hιp j₁) c }
    refine ⟨(F.obj j₁ : Type u), inferInstance, (p j₁).toAlgebra,
      RingHom.etale_algebraMap.mp (hp j₁), α, β', ?_⟩
    apply AlgHom.ext
    intro y
    obtain ⟨z, rfl⟩ := hfs y
    show ι j₁ (α (f z)) = h (f z)
    rw [hα, hψ₁, ← hψ₀]
    exact RingHom.congr_fun (hιF u) _

  have L2b : ∀ {Y : Scheme.{u}} (U : Y.Opens) (y : (U : Scheme.{u})),
      ∃ ι : Spec (.of (AlgebraicClosure ((U : Scheme.{u}).residueField y))) ≅
        Spec (.of (AlgebraicClosure (Y.residueField (U.ι y)))),
        ι.hom ≫ wcEtGeomPt Y (U.ι y) = wcEtGeomPt U y ≫ U.ι := by
    intro Y U y
    let σ : Y.residueField (U.ι y) ≃+* (U : Scheme.{u}).residueField y :=
      (asIso (U.ι.residueFieldMap y)).commRingCatIsoToRingEquiv
    let Φ : AlgebraicClosure ((U : Scheme.{u}).residueField y) ≃+*
        AlgebraicClosure (Y.residueField (U.ι y)) :=
      IsAlgClosure.equivOfEquiv _ _ σ.symm
    have hΦ : ∀ s : Y.residueField (U.ι y),
        Φ.symm (algebraMap (Y.residueField (U.ι y))
          (AlgebraicClosure (Y.residueField (U.ι y))) s) =
        algebraMap ((U : Scheme.{u}).residueField y)
          (AlgebraicClosure ((U : Scheme.{u}).residueField y)) (U.ι.residueFieldMap y s) := by
      intro s
      rw [IsAlgClosure.equivOfEquiv_symm_algebraMap, RingEquiv.symm_symm]
      rfl
    haveI hiso : IsIso (Spec.map (CommRingCat.ofHom (Φ.symm :
        AlgebraicClosure (Y.residueField (U.ι y)) →+*
          AlgebraicClosure ((U : Scheme.{u}).residueField y)))) := by
      have hh : CommRingCat.ofHom (Φ.symm : AlgebraicClosure (Y.residueField (U.ι y)) →+*
          AlgebraicClosure ((U : Scheme.{u}).residueField y)) = Φ.symm.toCommRingCatIso.hom := rfl
      rw [hh]
      infer_instance
    refine ⟨asIso (Spec.map (CommRingCat.ofHom (Φ.symm :
        AlgebraicClosure (Y.residueField (U.ι y)) →+*
          AlgebraicClosure ((U : Scheme.{u}).residueField y)))), ?_⟩
    have hring : U.ι.residueFieldMap y ≫
        CommRingCat.ofHom (algebraMap ((U : Scheme.{u}).residueField y)
          (AlgebraicClosure ((U : Scheme.{u}).residueField y))) =
        CommRingCat.ofHom (algebraMap (Y.residueField (U.ι y))
          (AlgebraicClosure (Y.residueField (U.ι y)))) ≫
        CommRingCat.ofHom (Φ.symm : AlgebraicClosure (Y.residueField (U.ι y)) →+*
          AlgebraicClosure ((U : Scheme.{u}).residueField y)) := by
      ext s
      exact (hΦ s).symm
    show Spec.map (CommRingCat.ofHom (Φ.symm : AlgebraicClosure (Y.residueField (U.ι y)) →+*
          AlgebraicClosure ((U : Scheme.{u}).residueField y))) ≫
        (Spec.map (CommRingCat.ofHom (algebraMap (Y.residueField (U.ι y))
          (AlgebraicClosure (Y.residueField (U.ι y))))) ≫ Y.fromSpecResidueField (U.ι y)) =
      (Spec.map (CommRingCat.ofHom (algebraMap ((U : Scheme.{u}).residueField y)
          (AlgebraicClosure ((U : Scheme.{u}).residueField y)))) ≫
        (U : Scheme.{u}).fromSpecResidueField y) ≫ U.ι
    rw [Category.assoc, ← Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField]
    simp only [← Category.assoc, ← Spec.map_comp]
    exact congrArg (fun g => Spec.map g ≫ Y.fromSpecResidueField (U.ι y)) hring.symm

  intro Y y B _ _ Λ _ _ W' φ a hd
  obtain ⟨U, hU, hyU, -⟩ :=
    exists_isAffineOpen_mem_and_subset (U := ⊤) (TopologicalSpace.Opens.mem_top y)
  obtain ⟨y', rfl⟩ : ∃ y' : (U : Scheme.{u}), U.ι y' = y := ⟨⟨y, hyU⟩, rfl⟩
  obtain ⟨BU, _, _, _, ΛU, _, _, WU, φU, aU, eU, hI, haff, hcomp, hφa, hlim, hint, heq⟩ :=
    wc_et_geom_strict_henselization (B := (U : Scheme.{u})) y'
  have hdU : wcHalShData y' BU ΛU WU φU aU := by
    unfold wcHalShData
    exact ⟨hI, haff, hcomp, hφa, hlim, eU, hint, heq⟩
  obtain ⟨β, hβ, I, _, _, F, p, ι, hp, hFp, hιF, hιp, hsurj, hker⟩ :=
    wc_shdata_filtered_etale_presentation y' BU ΛU WU φU aU hdU (Γ(Y, U) : Type u) hU.isoSpec
  have hInd := L2a _ BU β I F p ι hp hFp hιF hιp hsurj hker
  have hW := wc_indEtale_weaklyEtale β hInd
  letI : Algebra (Γ(Y, U) : Type u) BU := β.toAlgebra
  haveI hS : WeaklyEtale (Spec.map (CommRingCat.ofHom β)) := wc_lfi_specMap_weaklyEtale _ _ hW
  have haU : aU = Spec.map (CommRingCat.ofHom β) ≫ hU.isoSpec.inv := by
    rw [hβ, Category.assoc]
    simp
  haveI : WeaklyEtale aU := by rw [haU]; infer_instance
  obtain ⟨ιg, hιg⟩ := L2b U y'
  obtain ⟨θ, hθ⟩ := wc_shdata_etale_iso U.ι y' (U.ι y') ιg hιg BU ΛU WU φU aU hdU B Λ W' φ a hd
  have ha : a = θ.inv ≫ aU ≫ U.ι := by rw [← hθ, Iso.inv_hom_id_assoc]
  rw [ha]
  infer_instance

theorem wc_cpt_shens_coord_ring_facts : ∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] [IsDomain A] [IsDiscreteValuationRing A] (d : ℕ) (y : Spec (.of (MvPolynomial (Option (Fin d)) A))), Spec.map (CommRingCat.ofHom (algebraMap A (MvPolynomial (Option (Fin d)) A))) y = IsLocalRing.closedPoint A → (MvPolynomial.X none : MvPolynomial (Option (Fin d)) A) ∈ y.asIdeal → ∀ (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (MvPolynomial (Option (Fin d)) A))) y)) (Scheme.Etale.forget (Spec (.of (MvPolynomial (Option (Fin d)) A))))) (φ : ∀ l, Spec (.of B) ⟶ (W'.obj l).right.left) (a : Spec (.of B) ⟶ Spec (.of (MvPolynomial (Option (Fin d)) A))), wcHalShData y B Λ W' φ a → ∀ (β : MvPolynomial (Option (Fin d)) A →+* B), Spec.map (CommRingCat.ofHom β) = a → IsDomain B ∧ (∀ a₁ b₁ : B, ∃ l : B, ∀ z : B, (a₁ ∣ z ∧ b₁ ∣ z ↔ l ∣ z)) ∧ Prime (β (MvPolynomial.X none)) :=
by
  classical

  have lcm3 : ∀ (S R : Type u) [CommRing S] [CommRing R] [IsLocalRing R] (σ : S →+* R),
      wcIndEtale σ →
      (∀ (E : Type u) [CommRing E] [Algebra S E], Algebra.Etale S E → ∀ (q : Ideal E) [q.IsPrime],
        IsDomain (Localization.AtPrime q) ∧ UniqueFactorizationMonoid (Localization.AtPrime q)) →
      IsDomain R ∧ ∀ a b : R, ∃ l : R, ∀ z : R, (a ∣ z ∧ b ∣ z ↔ l ∣ z) := by
    intro S R _ _ _ σ hσ H
    classical
    letI : Algebra S R := σ.toAlgebra
    have hWE : Algebra.WeaklyEtale S R := wc_indEtale_weaklyEtale σ hσ
    have F : ∀ a b : R, ∃ (E : Type u) (_ : CommRing E) (_ : Algebra S E) (_ : Algebra.Etale S E)
        (β : E →ₐ[S] R) (e₀ e₁ : E), β e₀ = a ∧ β e₁ = b := by
      intro a b
      obtain ⟨E, _, _, hEt, α, β, hβα⟩ := hσ (MvPolynomial (Fin 2) S) (MvPolynomial.aeval ![a, b])
      refine ⟨E, _, _, hEt, β, α (MvPolynomial.X 0), α (MvPolynomial.X 1), ?_, ?_⟩
      · rw [← AlgHom.comp_apply, hβα]; simp
      · rw [← AlgHom.comp_apply, hβα]; simp
    have K : ∀ (E : Type u) [CommRing E] [Algebra S E] [Algebra.Etale S E] (β : E →ₐ[S] R),
        ∃ (L : Type u) (_ : CommRing L) (_ : IsDomain L) (_ : UniqueFactorizationMonoid L)
          (ι : E →+* L) (β' : L →+* R), (∀ e, β' (ι e) = β e) ∧
          ∀ (n : ℕ) (f : Fin n → E) (x : Fin n → R), ∑ i, β (f i) * x i = 0 →
            ∃ (k : ℕ) (A : Fin n → Fin k → E) (y : Fin k → R),
              (∀ i, x i = ∑ j, β (A i j) * y j) ∧ ∀ j, ∑ i, f i * A i j = 0 := by
      intro E _ _ _ β
      letI : Algebra E R := (β : E →+* R).toAlgebra
      haveI : IsScalarTower S E R := IsScalarTower.of_algebraMap_eq' β.comp_algebraMap.symm
      haveI hER : Algebra.WeaklyEtale E R := wc_weaklyEtale_cancel S E R inferInstance hWE
      haveI : Module.Flat E R := inferInstance
      let q : Ideal E := Ideal.comap (β : E →+* R) (IsLocalRing.maximalIdeal R)
      haveI : q.IsPrime := Ideal.comap_isPrime _ _
      obtain ⟨hLd, hLu⟩ := H E inferInstance q
      have hunit : ∀ s : q.primeCompl, IsUnit ((β : E →+* R) (s : E)) := by
        intro s
        exact IsLocalRing.notMem_maximalIdeal.mp
          (fun hm => (Ideal.mem_primeCompl_iff.mp s.2) (Ideal.mem_comap.mpr hm))
      refine ⟨Localization.AtPrime q, inferInstance, hLd, hLu, algebraMap E _,
        IsLocalization.lift (M := q.primeCompl) (S := Localization.AtPrime q) hunit,
        fun e => IsLocalization.lift_eq hunit e, ?_⟩
      intro n f x hfx
      have h0 : ∑ i, f i • x i = 0 := hfx
      have h3 : Module.IsTrivialRelation f x :=
        @Module.Flat.isTrivialRelation_of_sum_smul_eq_zero E R _ _ _ inferInstance (Fin n) _ f x h0
      unfold Module.IsTrivialRelation at h3
      obtain ⟨k, A, y, h1, h2⟩ := h3
      exact ⟨k, A, y, fun i => (h1 i).trans (Finset.sum_congr rfl (fun j _ => Algebra.smul_def _ _)), h2⟩
    have hnzd : NoZeroDivisors R := by
      refine ⟨fun {a b} hab => ?_⟩
      obtain ⟨E, _, _, _, β, e₀, e₁, he₀, he₁⟩ := F a b
      obtain ⟨L, _, _, _, ι, β', hβ', hflat⟩ := K E β
      obtain ⟨k, A, y, h1, h2⟩ := hflat 1 ![e₀] ![b] (by simp [he₀, hab])
      by_cases h : ι e₀ = 0
      · left; rw [← he₀, ← hβ', h, map_zero]
      · right
        have hb := h1 0
        simp only [Matrix.cons_val_zero] at hb
        rw [hb]
        apply Finset.sum_eq_zero
        intro j _
        have hj := h2 j
        simp only [Finset.univ_unique, Fin.default_eq_zero, Finset.sum_singleton,
          Matrix.cons_val_zero] at hj
        have hj' : ι e₀ * ι (A 0 j) = 0 := by rw [← map_mul, hj, map_zero]
        have hA : ι (A 0 j) = 0 := (mul_eq_zero.mp hj').resolve_left h
        rw [← hβ', hA, map_zero, zero_mul]
    refine ⟨NoZeroDivisors.to_isDomain R, fun a b => ?_⟩
    obtain ⟨E, _, _, _, β, e₀, e₁, he₀, he₁⟩ := F a b
    obtain ⟨L, _, _, _, ι, β', hβ', hflat⟩ := K E β
    letI : GCDMonoid L := UniqueFactorizationMonoid.toGCDMonoid L
    refine ⟨β' (lcm (ι e₀) (ι e₁)), fun z => ⟨?_, ?_⟩⟩
    · rintro ⟨⟨r₁, hr₁⟩, ⟨r₂, hr₂⟩⟩
      obtain ⟨k, A, y, h1, h2⟩ := hflat 2 ![e₀, -e₁] ![r₁, r₂] (by
        simp only [Fin.sum_univ_two, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons,
          map_neg, he₀, he₁]
        rw [← hr₁, neg_mul, ← hr₂, add_neg_cancel])
      have hr := h1 0
      simp only [Matrix.cons_val_zero] at hr
      rw [hr₁, hr, Finset.mul_sum]
      apply Finset.dvd_sum
      intro j _
      have hj := h2 j
      simp only [Fin.sum_univ_two, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons,
        neg_mul] at hj
      have hj' : e₀ * A 0 j = e₁ * A 1 j := by rw [← sub_eq_zero, sub_eq_add_neg]; exact hj
      have hd : lcm (ι e₀) (ι e₁) ∣ ι (e₀ * A 0 j) := by
        rw [lcm_dvd_iff]
        constructor
        · rw [map_mul]; exact dvd_mul_right _ _
        · rw [hj', map_mul]; exact dvd_mul_right _ _
      have hd' := map_dvd β' hd
      rw [hβ', map_mul, he₀] at hd'
      rw [← mul_assoc]
      exact dvd_mul_of_dvd_left hd' _
    · intro h
      constructor
      · refine dvd_trans ?_ h
        rw [← he₀, ← hβ']
        exact map_dvd β' (dvd_lcm_left _ _)
      · refine dvd_trans ?_ h
        rw [← he₁, ← hβ']
        exact map_dvd β' (dvd_lcm_right _ _)
  have hF : ∀ (K : Type u) [Field K], IsRegularLocalRing K := fun _ _ => inferInstance
  have s9 : ∀ (R S : Type u) [CommRing R] [CommRing S] (e : R ≃+* S) (Q : Ideal R) [Q.IsPrime]
      (Q' : Ideal S) [Q'.IsPrime], Q' = Q.map e →
      Nonempty (Localization.AtPrime Q ≃+* Localization.AtPrime Q') := by
    intro R S _ _ e Q _ Q' _ hQ
    refine ⟨IsLocalization.ringEquivOfRingEquiv (M := Q.primeCompl) (T := Q'.primeCompl)
      (Localization.AtPrime Q) (Localization.AtPrime Q') e ?_⟩
    subst hQ
    ext s
    rw [Submonoid.mem_map]
    constructor
    · rintro ⟨t, ht, hts⟩
      refine Ideal.mem_primeCompl_iff.mpr (fun hmem => ?_)
      rw [Ideal.mem_map_of_equiv] at hmem
      obtain ⟨t', ht', h⟩ := hmem
      have htt : t' = t := e.injective (h.trans hts.symm)
      exact (Ideal.mem_primeCompl_iff.mp ht) (htt ▸ ht')
    · intro hs
      refine ⟨e.symm s, Ideal.mem_primeCompl_iff.mpr (fun h => ?_), ?_⟩
      · apply Ideal.mem_primeCompl_iff.mp hs
        rw [Ideal.mem_map_of_equiv]
        exact ⟨e.symm s, h, by simp⟩
      · show e (e.symm s) = s
        simp
  have r3 : (∀ (C₀ : Type u) [CommRing C₀] [IsLocalRing C₀] [IsNoetherianRing C₀],
      IsRegularLocalRing C₀ → ∀ (𝔮 : Ideal (Polynomial C₀)) [𝔮.IsPrime],
      𝔮.comap Polynomial.C = IsLocalRing.maximalIdeal C₀ →
      IsRegularLocalRing (Localization.AtPrime 𝔮)) →
      ∀ (C : Type u) [CommRing C] [IsNoetherianRing C] (p : Ideal C) [p.IsPrime],
      IsRegularLocalRing (Localization.AtPrime p) → ∀ (Q : Ideal (Polynomial C)) [Q.IsPrime],
      Q.comap Polynomial.C = p → IsRegularLocalRing (Localization.AtPrime Q) := by
    intro H C _ _ p _ hreg Q _ hQ
    letI : Algebra (Polynomial C) (Polynomial (Localization.AtPrime p)) :=
      (Polynomial.mapRingHom (algebraMap C (Localization.AtPrime p))).toAlgebra
    haveI hML : IsLocalization (Submonoid.map Polynomial.C p.primeCompl)
        (Polynomial (Localization.AtPrime p)) :=
      Polynomial.isLocalization p.primeCompl (Localization.AtPrime p)
    have hdisj : Disjoint ((Submonoid.map Polynomial.C p.primeCompl : Submonoid (Polynomial C)) :
        Set (Polynomial C)) (Q : Set (Polynomial C)) := by
      refine Set.disjoint_left.mpr ?_
      rintro _ ⟨s, hs, rfl⟩ hsQ
      apply hs
      rw [← hQ]
      exact hsQ
    haveI h𝔮 : (Q.map (algebraMap (Polynomial C) (Polynomial (Localization.AtPrime p)))).IsPrime :=
      IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.map Polynomial.C p.primeCompl) _ Q ‹_›
        hdisj
    have h𝔮Q : (Q.map (algebraMap (Polynomial C) (Polynomial (Localization.AtPrime p)))).comap
        (algebraMap (Polynomial C) (Polynomial (Localization.AtPrime p))) = Q :=
      IsLocalization.under_map_of_isPrime_disjoint (Submonoid.map Polynomial.C p.primeCompl) _ ‹_›
        hdisj
    haveI : IsNoetherianRing (Localization.AtPrime p) :=
      IsLocalization.isNoetherianRing p.primeCompl _ ‹_›
    have hc : (Q.map (algebraMap (Polynomial C) (Polynomial (Localization.AtPrime p)))).comap
        Polynomial.C = IsLocalRing.maximalIdeal (Localization.AtPrime p) := by
      apply le_antisymm
      · exact IsLocalRing.le_maximalIdeal (Ideal.comap_isPrime Polynomial.C _).ne_top
      · rw [← Localization.AtPrime.map_eq_maximalIdeal, Ideal.map_le_iff_le_comap]
        intro c hc
        rw [Ideal.mem_comap, Ideal.mem_comap]
        have : Polynomial.C (algebraMap C (Localization.AtPrime p) c) =
            algebraMap (Polynomial C) (Polynomial (Localization.AtPrime p)) (Polynomial.C c) := by
          show _ = Polynomial.map (algebraMap C (Localization.AtPrime p)) (Polynomial.C c)
          rw [Polynomial.map_C]
        rw [this]
        apply Ideal.mem_map_of_mem
        rw [← hQ] at hc
        exact hc
    haveI hR𝔮 := H (Localization.AtPrime p) hreg _ hc
    have hgen : ∀ (P : Ideal (Polynomial C)) [P.IsPrime],
        P = (Q.map (algebraMap (Polynomial C) (Polynomial (Localization.AtPrime p)))).comap
          (algebraMap (Polynomial C) (Polynomial (Localization.AtPrime p))) →
        IsLocalization.AtPrime (Localization.AtPrime
          (Q.map (algebraMap (Polynomial C) (Polynomial (Localization.AtPrime p))))) P := by
      intro P _ hP
      subst hP
      exact IsLocalization.isLocalization_isLocalization_atPrime_isLocalization
        (Submonoid.map Polynomial.C p.primeCompl) _ _
    haveI := hgen Q h𝔮Q.symm
    let E : Localization.AtPrime
        (Q.map (algebraMap (Polynomial C) (Polynomial (Localization.AtPrime p))))
        ≃+* Localization.AtPrime Q := (IsLocalization.algEquiv Q.primeCompl
      (Localization.AtPrime (Q.map (algebraMap (Polynomial C) (Polynomial (Localization.AtPrime p)))))
      (Localization.AtPrime Q)).toRingEquiv
    exact @IsRegularLocalRing.of_ringEquiv _ _ hR𝔮 _ _ E
  have sMv : (∀ (C : Type u) [CommRing C] [IsNoetherianRing C] (p : Ideal C) [p.IsPrime],
      IsRegularLocalRing (Localization.AtPrime p) → ∀ (Q : Ideal (Polynomial C)) [Q.IsPrime],
      Q.comap Polynomial.C = p → IsRegularLocalRing (Localization.AtPrime Q)) →
      (∀ (R S : Type u) [CommRing R] [CommRing S] (e : R ≃+* S) (Q : Ideal R) [Q.IsPrime]
        (Q' : Ideal S) [Q'.IsPrime], Q' = Q.map e →
        Nonempty (Localization.AtPrime Q ≃+* Localization.AtPrime Q')) →
      ∀ (n : ℕ) (C : Type u) [CommRing C] [IsNoetherianRing C] (p : Ideal C) [p.IsPrime],
      IsRegularLocalRing (Localization.AtPrime p) →
      ∀ (Q : Ideal (MvPolynomial (Fin n) C)) [Q.IsPrime],
      Q.comap (MvPolynomial.C : C →+* MvPolynomial (Fin n) C) = p →
      IsRegularLocalRing (Localization.AtPrime Q) := by
    intro H1 H2 n
    induction n with
    | zero =>
      intro C _ _ p _ hreg Q _ hQ
      have hsymm : ∀ c : C, (MvPolynomial.isEmptyAlgEquiv C (Fin 0)).toRingEquiv.symm c =
          MvPolynomial.C c := by
        intro c
        have h := (MvPolynomial.isEmptyAlgEquiv C (Fin 0)).symm.commutes c
        rw [Algebra.algebraMap_self, RingHom.id_apply, MvPolynomial.algebraMap_eq] at h
        exact h
