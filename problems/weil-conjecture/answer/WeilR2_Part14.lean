theorem wc_et_unit_univ_transport : ∀ {S Z : Scheme.{u}} (g : Z ⟶ S) (L : Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1} ⥤ Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) (adj : L ⊣ wcEtPush g), ∃ ρ : ∀ G : Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}, wcEtTransport g G (L.obj G), (∀ G, wcEtTransportUniv (ρ G)) ∧ ∀ (G : Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}) (V : S.Etale) (x : G.obj.obj (Opposite.op V)), ((adj.unit.app G).hom.app (Opposite.op V)).hom x = ((toSheafify (Scheme.smallEtaleTopology S) ((wcEtBaseChange g).op ⋙ (L.obj G).obj)).app (Opposite.op V)).hom ((ρ G).ρ V ((wcEtBaseChange g).obj V) (Limits.pullback.fst V.hom g) Limits.pullback.condition x) :=
