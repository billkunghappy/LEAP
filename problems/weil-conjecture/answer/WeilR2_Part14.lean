          ((constantSheaf (Scheme.smallEtaleTopology U) AddCommGrpCat.{u+1}).obj
            (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))) n) := h3 n hn
      have e : ∀ w : Abelian.Ext (Lg.obj
          ((constantSheaf (Scheme.smallEtaleTopology P) AddCommGrpCat.{u+1}).obj
            (AddCommGrpCat.of (ULift.{u+1} ℤ))))
          ((constantSheaf (Scheme.smallEtaleTopology U) AddCommGrpCat.{u+1}).obj
            (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))) n,
          (Abelian.Ext.mk₀ eg.hom).comp ((Abelian.Ext.mk₀ eg.inv).comp w (zero_add n))
            (zero_add n) = w := by
        intro w
