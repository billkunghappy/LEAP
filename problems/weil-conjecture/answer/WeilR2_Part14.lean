          have e : (t + s) * s ^ (k + 1) - s ^ k = s ^ (k + 1 + 1) := by
            have : (t + s) * s ^ (k + 1) = s ^ (k + 1 + 1) + (t * s) * s ^ k := by ring
            rw [this, hts, one_mul, add_sub_cancel_right]
