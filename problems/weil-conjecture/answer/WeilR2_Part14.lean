    intro p
    rw [hqB]
    exact hpt_gen B _ eB p
  have hqBa : qB ≫ a = wcEtGeomPt (Spec (.of (MvPolynomial (Fin (d + 1)) A))) x :=
    hnorm_a x B Λ W' φ a hd qB hqBφ
  have haB : a (IsLocalRing.closedPoint B) = x := by
    have h1 := happ _ _ hqBa (IsLocalRing.closedPoint
      (AlgebraicClosure ((Spec (.of (MvPolynomial (Fin (d + 1)) A))).residueField x)))
    have h2 := (Scheme.Hom.comp_apply qB a _).symm.trans (h1.trans (hgeom_pt _ _))
    exact (congrArg a (hqBpt _)).symm.trans h2
  obtain ⟨ιy, hιy⟩ := wc_geomPt_down_comparison (Spec.map (CommRingCat.ofHom (MvPolynomial.rename Fin.succ : MvPolynomial (Fin d) A →ₐ[A] MvPolynomial (Fin (d + 1)) A).toRingHom)) x
  obtain ⟨β, hβa, hβq⟩ := wc_cmp (Spec.map (CommRingCat.ofHom (MvPolynomial.rename Fin.succ : MvPolynomial (Fin d) A →ₐ[A] MvPolynomial (Fin (d + 1)) A).toRingHom)) _ x ιy hιy
    B' Λ' W'' φ' a' hd' e₁ he₁ B Λ W' φ a hd eB heB
  have hβpt : β (IsLocalRing.closedPoint B) = IsLocalRing.closedPoint B' := by
    have e1 : qB ≫ β = ιy ≫ Spec.map (CommRingCat.ofHom e₁) ≫
        Spec.map (CommRingCat.ofHom (IsLocalRing.residue B')) := by
      rw [hqB, Category.assoc, hβq]
    have h1 := happ _ _ e1 (IsLocalRing.closedPoint
      (AlgebraicClosure ((Spec (.of (MvPolynomial (Fin (d + 1)) A))).residueField x)))
    have h2 := (Scheme.Hom.comp_apply qB β _).symm.trans (h1.trans
      ((Scheme.Hom.comp_apply _ _ _).trans (Scheme.Hom.comp_apply _ _ _)))
    exact ((congrArg β (hqBpt _)).symm.trans h2).trans (hres_pt B' _)
  obtain ⟨ã, hãρ, hãpr⟩ := hex B β a hβa
  have hprx : pr (ã (IsLocalRing.closedPoint B)) = x := by
    have h1 := happ _ _ hãpr (IsLocalRing.closedPoint B)
    exact ((Scheme.Hom.comp_apply ã pr _).symm.trans h1).trans haB
  have hρx : Spec.map (CommRingCat.ofHom (algebraMap B' (Polynomial B')))
      (ã (IsLocalRing.closedPoint B)) = IsLocalRing.closedPoint B' := by
    have h1 := happ _ _ hãρ (IsLocalRing.closedPoint B)
    exact ((Scheme.Hom.comp_apply ã _ _).symm.trans h1).trans hβpt
  have htpt : (qB ≫ ã) (IsLocalRing.closedPoint
      (AlgebraicClosure ((Spec (.of (MvPolynomial (Fin (d + 1)) A))).residueField x))) =
      ã (IsLocalRing.closedPoint B) :=
    (Scheme.Hom.comp_apply qB ã _).trans (congrArg ã (hqBpt _))
  have htpr : (qB ≫ ã) ≫ pr = wcEtGeomPt (Spec (.of (MvPolynomial (Fin (d + 1)) A))) x := by
    rw [Category.assoc, hãpr, hqBa]
  obtain ⟨j, hj⟩ := wc_geomPt_rebase_lift pr x (ã (IsLocalRing.closedPoint B)) hprx (qB ≫ ã) htpt htpr
  have hjgeom : j ≫ wcEtGeomPt (Spec (.of (MvPolynomial (Fin (d + 1)) A))) x =
      wcEtGeomPt (Spec (.of (Polynomial B'))) (ã (IsLocalRing.closedPoint B)) ≫ pr := by
    rw [← hj, ← hqBa, ← hãpr]
    simp only [Category.assoc]
  have hqpt : (j ≫ qB) (IsLocalRing.closedPoint
      (AlgebraicClosure ((Spec (.of (Polynomial B'))).residueField (ã (IsLocalRing.closedPoint B))))) =
      IsLocalRing.closedPoint B :=
    (Scheme.Hom.comp_apply j qB _).trans (hqBpt _)
  have hqã : (j ≫ qB) ≫ ã = wcEtGeomPt (Spec (.of (Polynomial B'))) (ã (IsLocalRing.closedPoint B)) := by
    rw [Category.assoc]
    exact hj
  refine ⟨ã, ?_, hρx, ?_, ?_⟩
  · rw [← Category.assoc, hãρ, ← Category.assoc, hβa, Category.assoc, hρ]
  · intro η₀ β₀ hη hβ₀
    have h1 : Spec.map (CommRingCat.ofHom β₀) = Spec.map (CommRingCat.ofHom (η₀.comp Pm)) := by
      rw [hβ₀, ← hãpr, ← hη, hprdef, CommRingCat.ofHom_comp, Spec.map_comp]
    have h2 : CommRingCat.ofHom β₀ = CommRingCat.ofHom (η₀.comp Pm) := Spec.map_injective h1
    have h3 : β₀ = η₀.comp Pm := by
      have h4 := congrArg CommRingCat.Hom.hom h2
      rwa [CommRingCat.hom_ofHom, CommRingCat.hom_ofHom] at h4
    rw [h3, RingHom.comp_apply, hPm0]
  intro B₂ _ _ _ Λ₂ _ _ W₂ φ₂ a₂ hd₂
  obtain ⟨e₂, he₂⟩ := wc_norm (ã (IsLocalRing.closedPoint B)) B₂ Λ₂ W₂ φ₂ a₂ hd₂
  obtain ⟨q₂, hq₂⟩ : ∃ q₂ : Spec (.of (AlgebraicClosure
      ((Spec (.of (Polynomial B'))).residueField (ã (IsLocalRing.closedPoint B))))) ⟶ Spec (.of B₂),
      q₂ = Spec.map (CommRingCat.ofHom e₂) ≫
        Spec.map (CommRingCat.ofHom (IsLocalRing.residue B₂)) := ⟨_, rfl⟩
  have hq₂φ : ∀ l, q₂ ≫ φ₂ l = (W₂.obj l).hom.left := by
    intro l
    rw [hq₂, Category.assoc]
    exact he₂ l
  have hq₂pt : q₂ (IsLocalRing.closedPoint
      (AlgebraicClosure ((Spec (.of (Polynomial B'))).residueField (ã (IsLocalRing.closedPoint B))))) =
      IsLocalRing.closedPoint B₂ := by
    rw [hq₂]
    exact hpt_gen B₂ _ e₂ _
  have hq₂a : q₂ ≫ a₂ = wcEtGeomPt (Spec (.of (Polynomial B'))) (ã (IsLocalRing.closedPoint B)) :=
    hnorm_a (ã (IsLocalRing.closedPoint B)) B₂ Λ₂ W₂ φ₂ a₂ hd₂ q₂ hq₂φ
  obtain ⟨δ, hδa, hδφ⟩ := wc_lift (ã (IsLocalRing.closedPoint B))
    B₂ Λ₂ W₂ φ₂ a₂ hd₂ B ã (j ≫ qB) hqpt hqã
  obtain ⟨ε, hεa, hεq⟩ := wc_cmp pr x (ã (IsLocalRing.closedPoint B)) j hjgeom
    B Λ W' φ a hd eB (by rw [← Category.assoc, ← hqB]; exact hqBa) B₂ Λ₂ W₂ φ₂ a₂ hd₂ e₂ he₂
  have hq₂ε : q₂ ≫ ε = j ≫ qB := by
    rw [hq₂, Category.assoc, hεq, hqB]
  have hqδ : (j ≫ qB) ≫ δ = q₂ := by
    obtain ⟨-, -, -, -, hlim₂, -⟩ := id hd₂
    have hcompat₂ : ∀ {l l' : Λ₂} (t : l ⟶ l'),
        (W₂.obj l).hom.left ≫ (W₂.map t).right.left = (W₂.obj l').hom.left := fun t =>
      congrArg (fun f => f.left) (StructuredArrow.w (W₂.map t))
    exact (hlim₂ _ (fun l => (W₂.obj l).hom.left) hcompat₂).unique
      (fun l => by simpa only [Category.assoc] using hδφ l) hq₂φ
  have hδε : δ ≫ ε = 𝟙 _ := by
    apply wc_hom_ext x B Λ W' φ a hd B (δ ≫ ε) (𝟙 _) _ (j ≫ qB) hqpt
    · rw [Category.assoc, hεa, ← Category.assoc, hδa, hãpr, Category.id_comp]
    · rw [← Category.assoc, hqδ, hq₂ε, Category.comp_id]
  have hεβ : ε ≫ β = a₂ ≫ Spec.map (CommRingCat.ofHom (algebraMap B' (Polynomial B'))) := by
    apply wc_hom_ext _ B' Λ' W'' φ' a' hd' B₂ (ε ≫ β)
      (a₂ ≫ Spec.map (CommRingCat.ofHom (algebraMap B' (Polynomial B')))) _ q₂ hq₂pt
    · simp only [Category.assoc]
      rw [hβa, ← Category.assoc ε, hεa, Category.assoc, hpr]
    · have h1 : (q₂ ≫ ε) ≫ β = (q₂ ≫ a₂) ≫
          Spec.map (CommRingCat.ofHom (algebraMap B' (Polynomial B'))) := by
        rw [hq₂ε, hq₂a, ← hãρ, ← hqã]
        simp only [Category.assoc]
      simpa only [Category.assoc] using h1
  have hεã : ε ≫ ã = a₂ :=
    huniq B₂ (ε ≫ ã) a₂ (by rw [Category.assoc, hãρ, hεβ]) (by rw [Category.assoc, hãpr, hεa])
  have hεδ : ε ≫ δ = 𝟙 _ := by
    apply wc_hom_ext (ã (IsLocalRing.closedPoint B)) B₂ Λ₂ W₂ φ₂ a₂ hd₂ B₂ (ε ≫ δ)
      (𝟙 _) _ q₂ hq₂pt
    · rw [Category.assoc, hδa, hεã, Category.id_comp]
    · rw [← Category.assoc, hq₂ε, hqδ, Category.comp_id]
  refine ⟨⟨δ, ε, hδε, hεδ⟩, ?_⟩
  show δ ≫ a₂ = ã
  exact hδa

theorem wc_cpt_th_reduce_one_var : ∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (ℓ : ℕ), IsUnit ((ℓ : ℕ) : A) → (∀ (C : Type u) [CommRing C] [HenselianLocalRing C] [IsSepClosed (IsLocalRing.ResidueField C)], IsUnit ((ℓ : ℕ) : C) → ∀ (x : Spec (.of (Polynomial C))), Spec.map (CommRingCat.ofHom (algebraMap C (Polynomial C))) x = IsLocalRing.closedPoint C → (Polynomial.X : Polynomial C) ∈ x.asIdeal → ∀ (E : Type u) [CommRing E] [HenselianLocalRing E] [IsSepClosed (IsLocalRing.ResidueField E)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (Polynomial C))) x)) (Scheme.Etale.forget (Spec (.of (Polynomial C))))) (φ : ∀ l, Spec (.of E) ⟶ (W'.obj l).right.left) (a : Spec (.of E) ⟶ Spec (.of (Polynomial C))), wcHalShData x E Λ W' φ a → ∀ (ε : Polynomial C →+* E), Spec.map (CommRingCat.ofHom ε) = a → ∀ q : ℕ, 2 ≤ q → Subsingleton (wcEtCoh (Spec (.of (Localization.Away (ε Polynomial.X)))) ℓ q)) → ∀ (d : ℕ) (y : Spec (.of (MvPolynomial (Option (Fin d)) A))), Spec.map (CommRingCat.ofHom (algebraMap A (MvPolynomial (Option (Fin d)) A))) y = IsLocalRing.closedPoint A → (MvPolynomial.X none : MvPolynomial (Option (Fin d)) A) ∈ y.asIdeal → ∀ (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (MvPolynomial (Option (Fin d)) A))) y)) (Scheme.Etale.forget (Spec (.of (MvPolynomial (Option (Fin d)) A))))) (φ : ∀ l, Spec (.of B) ⟶ (W'.obj l).right.left) (a : Spec (.of B) ⟶ Spec (.of (MvPolynomial (Option (Fin d)) A))), wcHalShData y B Λ W' φ a → ∀ (β : MvPolynomial (Option (Fin d)) A →+* B), Spec.map (CommRingCat.ofHom β) = a → ∀ q : ℕ, 2 ≤ q → Subsingleton (wcEtCoh (Spec (.of (Localization.Away (β (MvPolynomial.X none))))) ℓ q) :=
by
  intro A _ _ _ ℓ hunit OV d y hy hy0 B _ _ _ Λ _ _ W' φ a hB β hβ q hq
  classical

  have memPre : ∀ {S T : Type u} [CommRing S] [CommRing T] (f : Spec (.of S) ⟶ Spec (.of T))
      (p : Spec (.of S)) (t : T), t ∈ (f p).asIdeal ↔ (Spec.preimage f).hom t ∈ p.asIdeal := by
    intro S T _ _ f p t
    have e1 := Spec.map_apply (Spec.preimage f) p
    rw [Spec.map_preimage] at e1
    rw [e1]
    exact Iff.rfl
  have preComp : ∀ {R S T : Type u} [CommRing R] [CommRing S] [CommRing T]
      (f : Spec (.of R) ⟶ Spec (.of S)) (g : Spec (.of S) ⟶ Spec (.of T)) (t : T),
      (Spec.preimage (f ≫ g)).hom t = (Spec.preimage f).hom ((Spec.preimage g).hom t) := by
    intro R S T _ _ _ f g t
    have : Spec.preimage (f ≫ g) = Spec.preimage g ≫ Spec.preimage f := by
      apply Spec.map_injective
      rw [Spec.map_comp, Spec.map_preimage, Spec.map_preimage, Spec.map_preimage]
    rw [this]
    rfl
  have shpt : ∀ {Y : Scheme.{u}} (y : Y) (B0 : Type u) [CommRing B0] [IsLocalRing B0] (Λ0 : Type u)
      [SmallCategory Λ0] [IsCofiltered Λ0]
      (W0 : Λ0 ⥤ StructuredArrow (Over.mk (wcEtGeomPt Y y)) (Scheme.Etale.forget Y))
      (φ0 : ∀ l, Spec (.of B0) ⟶ (W0.obj l).right.left) (a0 : Spec (.of B0) ⟶ Y),
      wcHalShData y B0 Λ0 W0 φ0 a0 → a0 (IsLocalRing.closedPoint B0) = y := by
    intro Y y B0 _ _ Λ0 _ _ W0 φ0 a0 hd
    obtain ⟨-, -, -, -, -, e, -, he⟩ := hd
    have hgeom : ∀ z, wcEtGeomPt Y y z = y := by
      intro z
      rw [wcEtGeomPt, Scheme.Hom.comp_apply]
      exact Scheme.fromSpecResidueField_apply y _
    have hres : ∀ z, (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B0))) z =
        IsLocalRing.closedPoint B0 :=
      fun z => IsLocalRing.PrimeSpectrum.comap_residue B0 z
    have h1 := congrArg (fun f => f (IsLocalRing.closedPoint (AlgebraicClosure (Y.residueField y)))) he
    have h1' := (Scheme.Hom.comp_apply _ _ _).symm.trans
      ((Scheme.Hom.comp_apply _ _ _).symm.trans (h1.trans (hgeom _)))
    rw [hres] at h1'
    exact h1'
  have transport : ∀ (S S₂ : Type u) [CommRing S] [CommRing S₂] (Θ : Spec (.of S) ≅ Spec (.of S₂))
      (u₂ : S₂) (u₀ : S), (Spec.preimage Θ.hom).hom u₂ = u₀ → ∀ (m k : ℕ),
      Subsingleton (wcEtCoh (Spec (.of (Localization.Away u₂))) m k) →
      Subsingleton (wcEtCoh (Spec (.of (Localization.Away u₀))) m k) := by
    intro S S₂ _ _ Θ u₂ u₀ hu m k h
    let f : S₂ →+* S := (Spec.preimage Θ.hom).hom
    let g : S →+* S₂ := (Spec.preimage Θ.inv).hom
    have hfg : f.comp g = RingHom.id S := by
      have : Spec.preimage Θ.inv ≫ Spec.preimage Θ.hom = 𝟙 _ := by
        apply Spec.map_injective
        rw [Spec.map_comp, Spec.map_preimage, Spec.map_preimage, Iso.hom_inv_id, Spec.map_id]
      exact congrArg CommRingCat.Hom.hom this
    have hgf : g.comp f = RingHom.id S₂ := by
      have : Spec.preimage Θ.hom ≫ Spec.preimage Θ.inv = 𝟙 _ := by
        apply Spec.map_injective
        rw [Spec.map_comp, Spec.map_preimage, Spec.map_preimage, Iso.inv_hom_id, Spec.map_id]
      exact congrArg CommRingCat.Hom.hom this
    let ψ : S₂ ≃+* S := RingEquiv.ofRingHom f g hfg hgf
    have hM : Submonoid.map ψ.toMonoidHom (Submonoid.powers u₂) = Submonoid.powers u₀ := by
      rw [Submonoid.map_powers]
      congr 1
    let eL : Localization.Away u₂ ≃+* Localization.Away u₀ :=
      IsLocalization.ringEquivOfRingEquiv (Localization.Away u₂) (Localization.Away u₀) ψ hM
    haveI : IsIso (Spec.map eL.toCommRingCatIso.hom) := inferInstance
    obtain ⟨E⟩ := wc_et_coh_iso_invariance (Spec.map eL.toCommRingCatIso.hom) m k
    exact @Equiv.subsingleton _ _ E.symm h

  obtain ⟨ρ, hρX, hρA⟩ : ∃ ρ : MvPolynomial (Fin (d + 1)) A ≃+* MvPolynomial (Option (Fin d)) A,
      ρ (MvPolynomial.X 0) = MvPolynomial.X none ∧
      ∀ r : A, ρ (algebraMap A (MvPolynomial (Fin (d + 1)) A) r) =
        algebraMap A (MvPolynomial (Option (Fin d)) A) r :=
    ⟨(MvPolynomial.renameEquiv A (finSuccEquiv d)).toRingEquiv,
      by
        show MvPolynomial.renameEquiv A (finSuccEquiv d) (MvPolynomial.X 0) = MvPolynomial.X none
        rw [MvPolynomial.renameEquiv_apply, MvPolynomial.rename_X, finSuccEquiv_zero],
      fun r => (MvPolynomial.renameEquiv A (finSuccEquiv d)).commutes r⟩
  obtain ⟨σ, hσdef⟩ : ∃ σ : Spec (.of (MvPolynomial (Option (Fin d)) A)) ⟶
      Spec (.of (MvPolynomial (Fin (d + 1)) A)), σ = Spec.map ρ.toCommRingCatIso.hom := ⟨_, rfl⟩
  haveI : IsIso σ := by rw [hσdef]; infer_instance
  haveI : Etale σ := inferInstance
  have hσA : σ ≫ Spec.map (CommRingCat.ofHom (algebraMap A (MvPolynomial (Fin (d + 1)) A))) =
      Spec.map (CommRingCat.ofHom (algebraMap A (MvPolynomial (Option (Fin d)) A))) := by
    rw [hσdef, ← Spec.map_comp]
    congr 1
    apply CommRingCat.hom_ext
    apply RingHom.ext
    intro r
    exact hρA r
  have hσX : (Spec.preimage σ).hom (MvPolynomial.X 0) = MvPolynomial.X none := by
    rw [hσdef, Spec.preimage_map]
    exact hρX
  obtain ⟨y₁, hy₁def⟩ : ∃ y₁, y₁ = σ y := ⟨_, rfl⟩
  have hy₁ : Spec.map (CommRingCat.ofHom (algebraMap A (MvPolynomial (Fin (d + 1)) A))) y₁ =
      IsLocalRing.closedPoint A := by
    rw [hy₁def]
    exact (Scheme.Hom.comp_apply σ _ y).symm.trans ((congrArg (fun f => f y) hσA).trans hy)
  have hX0 : (MvPolynomial.X 0 : MvPolynomial (Fin (d + 1)) A) ∈ y₁.asIdeal := by
    rw [hy₁def]
    apply (memPre σ y _).mpr
    rw [hσX]
    exact hy0

  obtain ⟨B₁, _, _, _, Λ₁, _, _, W₁, φ₁, a₁, e₁, hI₁, hA₁, hc₁, ha₁, hl₁, he₁, heq₁⟩ :=
    wc_et_geom_strict_henselization y₁
  have hB₁ : wcHalShData y₁ B₁ Λ₁ W₁ φ₁ a₁ := ⟨hI₁, hA₁, hc₁, ha₁, hl₁, e₁, he₁, heq₁⟩
  obtain ⟨ι, hι⟩ := wc_etale_geom_point_residue_iso σ y y₁ hy₁def.symm
  obtain ⟨θ₁, hθ₁⟩ := wc_shdata_etale_iso σ y y₁ ι hι B Λ W' φ a hB B₁ Λ₁ W₁ φ₁ a₁ hB₁
  have h₁pt : a₁ (IsLocalRing.closedPoint B₁) = y₁ := shpt y₁ B₁ Λ₁ W₁ φ₁ a₁ hB₁

  obtain ⟨B', _, _, _, Λ', _, _, W'', φ', a', e', hI', hA', hc', ha', hl', he', heq'⟩ :=
    wc_et_geom_strict_henselization (Spec.map (CommRingCat.ofHom (MvPolynomial.rename Fin.succ :
      MvPolynomial (Fin d) A →ₐ[A] MvPolynomial (Fin (d + 1)) A).toRingHom) y₁)
  have hB' : wcHalShData (Spec.map (CommRingCat.ofHom (MvPolynomial.rename Fin.succ :
      MvPolynomial (Fin d) A →ₐ[A] MvPolynomial (Fin (d + 1)) A).toRingHom) y₁) B' Λ' W'' φ' a' :=
    ⟨hI', hA', hc', ha', hl', e', he', heq'⟩
  obtain ⟨ã, -, h2, hcoord, h3⟩ :=
    wc_cpt_th_tower_coord A d y₁ hy₁ B₁ Λ₁ W₁ φ₁ a₁ hB₁ B' Λ' W'' φ' a' hB'
  obtain ⟨B₂, _, _, _, Λ₂, _, _, W₂, φ₂, a₂, e₂, hI₂, hA₂, hc₂, ha₂, hl₂, he₂, heq₂⟩ :=
    wc_et_geom_strict_henselization (ã (IsLocalRing.closedPoint B₁))
  have hB₂ : wcHalShData (ã (IsLocalRing.closedPoint B₁)) B₂ Λ₂ W₂ φ₂ a₂ :=
    ⟨hI₂, hA₂, hc₂, ha₂, hl₂, e₂, he₂, heq₂⟩
  obtain ⟨θ₂, hθ₂⟩ := h3 B₂ Λ₂ W₂ φ₂ a₂ hB₂

  have hunitB' : IsUnit ((ℓ : ℕ) : B') := by
    have := hunit.map (Spec.preimage (a' ≫ Spec.map (CommRingCat.ofHom
      (algebraMap A (MvPolynomial (Fin d) A))))).hom
    rwa [map_natCast] at this
  have hcoord' : (Spec.preimage ã).hom Polynomial.X = (Spec.preimage a₁).hom (MvPolynomial.X 0) :=
    hcoord _ _ (by rw [CommRingCat.ofHom_hom, Spec.map_preimage])
      (by rw [CommRingCat.ofHom_hom, Spec.map_preimage])
  have hX : (Polynomial.X : Polynomial B') ∈ (ã (IsLocalRing.closedPoint B₁)).asIdeal := by
    apply (memPre ã _ _).mpr
    rw [hcoord']
    apply (memPre a₁ _ _).mp
    rw [h₁pt]
    exact hX0
  have hOV := OV B' hunitB' (ã (IsLocalRing.closedPoint B₁)) h2 hX B₂ Λ₂ W₂ φ₂ a₂ hB₂
    (Spec.preimage a₂).hom (by rw [CommRingCat.ofHom_hom, Spec.map_preimage]) q hq

  have hkey : (Spec.preimage (θ₁ ≪≫ θ₂).hom).hom ((Spec.preimage a₂).hom Polynomial.X) =
      β (MvPolynomial.X none) := by
    have e1 : (θ₁ ≪≫ θ₂).hom ≫ a₂ = θ₁.hom ≫ ã := by
      rw [Iso.trans_hom, Category.assoc, hθ₂]
    have e3 : ∀ p, (Spec.preimage a).hom p = β p := by
      intro p
      rw [← hβ, Spec.preimage_map, CommRingCat.hom_ofHom]
    calc (Spec.preimage (θ₁ ≪≫ θ₂).hom).hom ((Spec.preimage a₂).hom Polynomial.X)
        = (Spec.preimage ((θ₁ ≪≫ θ₂).hom ≫ a₂)).hom Polynomial.X := (preComp _ _ _).symm
      _ = (Spec.preimage (θ₁.hom ≫ ã)).hom Polynomial.X := by rw [e1]
      _ = (Spec.preimage θ₁.hom).hom ((Spec.preimage ã).hom Polynomial.X) := preComp _ _ _
      _ = (Spec.preimage θ₁.hom).hom ((Spec.preimage a₁).hom (MvPolynomial.X 0)) := by
          rw [hcoord']
      _ = (Spec.preimage (θ₁.hom ≫ a₁)).hom (MvPolynomial.X 0) := (preComp _ _ _).symm
      _ = (Spec.preimage (a ≫ σ)).hom (MvPolynomial.X 0) := by rw [hθ₁]
      _ = (Spec.preimage a).hom ((Spec.preimage σ).hom (MvPolynomial.X 0)) := preComp _ _ _
      _ = β (MvPolynomial.X none) := by rw [hσX, e3]

  exact transport B B₂ (θ₁ ≪≫ θ₂) _ _ hkey ℓ q hOV

