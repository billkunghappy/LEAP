      rw [ZMod.intCast_zmod_eq_zero_iff_dvd]
      have hp' : (p : ℤ) ≠ 0 := by exact_mod_cast hp
      push_cast at hx
      rw [mul_comm z] at hx
      exact (mul_dvd_mul_iff_left hp').mp hx
    have hβsurj : Function.Surjective β := by
      intro y
      obtain ⟨z, rfl⟩ := ZMod.intCast_surjective y
      exact ⟨(z : ZMod (p * k)), hβ z⟩
    have hβα : ∀ x, β (α x) = 0 := by
      intro x
      obtain ⟨z, rfl⟩ := ZMod.intCast_surjective x
      rw [hα, hβ]
      push_cast
      rw [ZMod.natCast_self, mul_zero]
    have hker : ∀ y, β y = 0 → ∃ x, α x = y := by
      intro y hy
      obtain ⟨z, rfl⟩ := ZMod.intCast_surjective y
      rw [hβ, ZMod.intCast_zmod_eq_zero_iff_dvd] at hy
      obtain ⟨t, rfl⟩ := hy
      refine ⟨(t : ZMod k), ?_⟩
      rw [hα]
      congr 1
      ring
    let f : AddCommGrpCat.of (ULift.{u+1} (ZMod k)) ⟶ AddCommGrpCat.of (ULift.{u+1} (ZMod (p * k))) :=
      AddCommGrpCat.ofHom ((AddEquiv.ulift.symm.toAddMonoidHom.comp α).comp
        AddEquiv.ulift.toAddMonoidHom)
    let g : AddCommGrpCat.of (ULift.{u+1} (ZMod (p * k))) ⟶ AddCommGrpCat.of (ULift.{u+1} (ZMod p)) :=
      AddCommGrpCat.ofHom ((AddEquiv.ulift.symm.toAddMonoidHom.comp β).comp
        AddEquiv.ulift.toAddMonoidHom)
    have hw : f ≫ g = 0 := by
      ext x
      exact hβα x.down
    refine ⟨f, g, hw, ShortComplex.ShortExact.mk' ?_ ?_ ?_⟩
    · rw [ShortComplex.ab_exact_iff]
      intro x₂ hx₂
      obtain ⟨x₁, hx₁⟩ := hker x₂.down (congrArg ULift.down hx₂)
      exact ⟨ULift.up x₁, congrArg ULift.up hx₁⟩
    · rw [AddCommGrpCat.mono_iff_injective]
      intro a b hab
      exact ULift.ext _ _ (hαinj (congrArg ULift.down hab))
    · rw [AddCommGrpCat.epi_iff_surjective]
      intro y
      obtain ⟨x, hx⟩ := hβsurj y.down
      exact ⟨ULift.up x, congrArg ULift.up hx⟩

  haveI : Limits.PreservesFiniteLimits
      (constantSheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1}) :=
    Limits.comp_preservesFiniteLimits (Functor.const (Scheme.Etale T)ᵒᵖ)
      (presheafToSheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1})

  intro m
  refine Nat.strong_induction_on m ?_
  intro m IH hm0 hP
  rcases eq_or_ne m 1 with rfl | hm1
  · have hz : Limits.IsZero ((constantSheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod 1)))) :=
      Functor.map_isZero _ (AddCommGrpCat.isZero_of_subsingleton _)
    exact ⟨(hzero _ _ hz).2, fun q _ => (hzero _ _ hz).1 q⟩
  · obtain ⟨p, hp, k, rfl⟩ : ∃ p, p.Prime ∧ ∃ k, m = p * k := by
      obtain ⟨p, hp, hpm⟩ := Nat.exists_prime_and_dvd hm1
      exact ⟨p, hp, hpm⟩
    have hk : k ≠ 0 := by
      rintro rfl
      exact hm0 (mul_zero p)
    have hlt : k < p * k := (Nat.lt_mul_iff_one_lt_left (Nat.pos_of_ne_zero hk)).mpr hp.one_lt
    obtain ⟨hK0, hKq⟩ := IH k hlt hk (fun q hq hqk => hP q hq (dvd_mul_of_dvd_right hqk p))
    obtain ⟨hP0, hPq⟩ := hP p hp (dvd_mul_right p k)
    obtain ⟨f, g, hw, hS₀⟩ := hses p k hp.ne_zero
    have hS := hS₀.map_of_exact (constantSheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1})
    obtain ⟨hhi, hcard⟩ := hmid _ _ hS hKq hPq
    refine ⟨?_, hhi⟩
    calc Nat.card (wcEtCoh T (p * k) 0)
        = Nat.card (wcEtCoh T p 0) * Nat.card (wcEtCoh T k 0) := hcard
      _ = p * k := by rw [hP0, hK0]

theorem wc_smooth_shens_milnor_fibre_acyclic : ∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (Y : Scheme.{u}) (f : Y ⟶ Spec (.of A)), Smooth f → ∀ (m : ℕ), IsUnit (m : A) → ∀ (x : Y), f x = IsLocalRing.closedPoint A → ∀ (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt Y x)) (Scheme.Etale.forget Y)) (φ : ∀ l, Spec (.of B) ⟶ (W'.obj l).right.left) (a : Spec (.of B) ⟶ Y), wcHalShData x B Λ W' φ a → ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (z : Spec (.of Ω) ⟶ Spec (.of A)), Nat.card (wcEtCoh (Limits.pullback (a ≫ f) z) m 0) = m ∧ ∀ q : ℕ, 1 ≤ q → Subsingleton (wcEtCoh (Limits.pullback (a ≫ f) z) m q) :=
by
  classical
  intro A _ _ _ Y f hsm m hmu x hx B _ _ _ Λ _ _ W' φ a hsh Ω _ _ z

  have hm0 : m ≠ 0 := by
    rintro rfl
    rw [Nat.cast_zero] at hmu
    exact not_isUnit_zero hmu

  have hpu : ∀ p : ℕ, p ∣ m → IsUnit (p : A) := by
    intro p hpm
    obtain ⟨c, hc⟩ := hpm
    rw [hc, Nat.cast_mul] at hmu
    exact isUnit_of_mul_isUnit_left hmu

  obtain ⟨d, x', B', _, _, _, Λ', _, _, W'', φ', a', hd', hx', θ, hθ⟩ :=
    wc_smooth_shens_affine_space_model A Y f hsm x hx B Λ W' φ a hsh

  have hmodel : ∀ p : ℕ, p.Prime → p ∣ m →
      Nat.card (wcEtCoh (Limits.pullback (a' ≫
        Spec.map (CommRingCat.ofHom (algebraMap A (MvPolynomial (Fin d) A)))) z) p 0) = p ∧
      ∀ q : ℕ, 1 ≤ q → Subsingleton (wcEtCoh (Limits.pullback (a' ≫
        Spec.map (CommRingCat.ofHom (algebraMap A (MvPolynomial (Fin d) A)))) z) p q) := by
    intro p hp hpm
    by_cases hEC : ∀ r : ℕ, r.Prime → (r : IsLocalRing.ResidueField A) = 0 → (r : A) = 0
    · obtain ⟨K, _, _, ⟨σ⟩⟩ := wc_shens_equal_char_alg_closed_subfield A hEC
      have hpK : (p : K) ≠ 0 := by
        intro h
        have h1 : (p : A) = 0 := by
          rw [← map_natCast σ p, h, map_zero]
        have h2 := hpu p hpm
        rw [h1] at h2
        exact not_isUnit_zero h2
      exact wc_affine_space_milnor_fibre_acyclic K p hp hpK A (Spec.map (CommRingCat.ofHom σ))
        d x' hx' B' Λ' W'' φ' a' hd' Ω z
    · push_neg at hEC
      exact wc_affine_space_milnor_fibre_acyclic_mixed_char p hp A (hpu p hpm) hEC
        d x' hx' B' Λ' W'' φ' a' hd' Ω z

  apply wc_et_coh_const_prime_devissage _ m hm0
  intro p hp hpm
  obtain ⟨h0, hq⟩ := hmodel p hp hpm

  have eq1 : (a ≫ f) ≫ 𝟙 (Spec (.of A)) = θ.hom ≫ (a' ≫
      Spec.map (CommRingCat.ofHom (algebraMap A (MvPolynomial (Fin d) A)))) := by
    rw [Category.comp_id, hθ]
  have eq2 : z ≫ 𝟙 (Spec (.of A)) = 𝟙 (Spec (.of Ω)) ≫ z := by
    rw [Category.comp_id, Category.id_comp]
  have E : ∀ q : ℕ, Nonempty (wcEtCoh (Limits.pullback (a' ≫
      Spec.map (CommRingCat.ofHom (algebraMap A (MvPolynomial (Fin d) A)))) z) p q ≃
      wcEtCoh (Limits.pullback (a ≫ f) z) p q) := fun q =>
    wc_et_coh_iso_invariance (Limits.pullback.map (a ≫ f) z (a' ≫
      Spec.map (CommRingCat.ofHom (algebraMap A (MvPolynomial (Fin d) A)))) z θ.hom
      (𝟙 _) (𝟙 _) eq1 eq2) p q
  refine ⟨?_, fun q hq1 => ?_⟩
  · obtain ⟨E0⟩ := E 0
    rw [← Nat.card_congr E0]
    exact h0
  · obtain ⟨Eq⟩ := E q
    haveI := hq q hq1
    exact Eq.symm.subsingleton

theorem wc_smooth_proper_shens_pull_bij : ∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (Y : Scheme.{u}) (f : Y ⟶ Spec (.of A)) [IsProper f], Smooth f → ∀ (m : ℕ), IsUnit (m : A) → ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (z : Spec (.of Ω) ⟶ Spec (.of A)) (D : wcEtPullData (Limits.pullback.fst f z) m) (q : ℕ), Function.Bijective (wcEtPull D q) :=
by
  intro A _ _ _ Y f _ hsm m hmu Ω _ _ z D q

  have hm0 : 0 < m := by
    rcases Nat.eq_zero_or_pos m with h | h
    · subst h
      rw [Nat.cast_zero] at hmu
      exact absurd hmu not_isUnit_zero
    · exact h
  haveI := D.additive
  haveI := D.presLim
  haveI := D.presColim
  letI hPadd : (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange (Limits.pullback.fst f z)) _ _
      D.cont D.φ).Additive :=
    @Adjunction.right_adjoint_additive _ _ _ _ _ _ _ _ D.adj D.additive
  haveI := sheafOfModules_enoughInjectives (Scheme.smallEtaleTopology (Limits.pullback f z))
    (wcEtZModRing (Limits.pullback f z) m)
  let I := InjectiveResolution.of (SheafOfModules.unit (wcEtZModRing (Limits.pullback f z) m))

  have hker : ∀ n : ℕ, Subsingleton (@Abelian.Ext (SheafOfModules.{u+1} (wcEtZModRing Y m)) _ _
      (HasExt.standard _) (SheafOfModules.unit (wcEtZModRing Y m))
      (Limits.kernel (wcEtSuppUnitMap D)) n) := by
    refine wc_et_module_ext_vanish_of_closed_fibre_stalks A Y f m hm0 _ ?_
    intro x hx
    refine (wc_et_supp_unit_ker_coker_stalks_of_milnor_h0 A Y f m hm0 Ω z D x ?_).1
    intro B _ _ _ Λ _ _ W' φ a hsh
    exact (wc_smooth_shens_milnor_fibre_acyclic A Y f hsm m hmu x hx B Λ W' φ a hsh Ω z).1

  have hcoker : ∀ n : ℕ, Subsingleton (@Abelian.Ext (SheafOfModules.{u+1} (wcEtZModRing Y m)) _ _
      (HasExt.standard _) (SheafOfModules.unit (wcEtZModRing Y m))
      (Limits.cokernel (wcEtSuppUnitMap D)) n) := by
    refine wc_et_module_ext_vanish_of_closed_fibre_stalks A Y f m hm0 _ ?_
    intro x hx
    refine (wc_et_supp_unit_ker_coker_stalks_of_milnor_h0 A Y f m hm0 Ω z D x ?_).2
    intro B _ _ _ Λ _ _ W' φ a hsh
    exact (wc_smooth_shens_milnor_fibre_acyclic A Y f hsm m hmu x hx B Λ W' φ a hsh Ω z).1

  have H1 := @wc_ext_postcomp_bij_of_ker_coker_acyclic _ _ _ (HasExt.standard _)
    (SheafOfModules.unit (wcEtZModRing Y m)) (SheafOfModules.unit (wcEtZModRing Y m)) _
    (wcEtSuppUnitMap D) hker hcoker

  have H2 : ∀ q' : ℕ, 1 ≤ q' → ∀ p : ℕ, Subsingleton (@Abelian.Ext
      (SheafOfModules.{u+1} (wcEtZModRing Y m)) _ _ (HasExt.standard _)
      (SheafOfModules.unit (wcEtZModRing Y m))
      ((((@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange (Limits.pullback.fst f z)) _ _
        D.cont D.φ).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q') p) := by
    intro q' hq'
    refine wc_et_module_ext_vanish_of_closed_fibre_stalks A Y f m hm0 _ ?_
    intro x hx
    refine wc_et_module_push_higher_stalk_vanish_of_milnor A Y f m hm0 Ω z D I x ?_ q' hq'
    intro B _ _ _ Λ _ _ W' φ a hsh
    exact (wc_smooth_shens_milnor_fibre_acyclic A Y f hsm m hmu x hx B Λ W' φ a hsh Ω z).2

  exact wc_ext_pull_bij_of_post_bij_ext_acyclic D.Φ _ D.adj (SheafOfModules.unit _)
    (SheafOfModules.unit _) D.μ H1 I H2 q

theorem wc_et_cospec_germ_assembly : ∀ (B : Scheme.{u}) (b η : B) (F : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}) (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B)), W'.Initial → IsCofiltered (StructuredArrow (Over.mk (wcEtGeomPt B η)) (Scheme.Etale.forget B)) → ∀ (lift : ∀ l, Spec (.of (AlgebraicClosure (B.residueField η))) ⟶ (W'.obj l).right.left) (hlift : ∀ l, lift l ≫ (W'.obj l).right.hom = wcEtGeomPt B η), (∀ {l l' : Λ} (t : l ⟶ l'), lift l ≫ (W'.map t).right.left = lift l') → ∀ (H : B.Etale → Type*) [∀ V, AddCommGroup (H V)] (ψ : ∀ V : B.Etale, H V →+ F.obj.obj (Opposite.op V)) (res : ∀ {V V' : B.Etale}, (V' ⟶ V) → (H V →+ H V')) (EA Eη : Type*) [AddCommGroup EA] [AddCommGroup Eη] (π : ∀ l : Λ, H (W'.obj l).right →+ EA) (p : EA →+ Eη) (θ : ∀ N : StructuredArrow (Over.mk (wcEtGeomPt B η)) (Scheme.Etale.forget B), H N.right →+ Eη), (∀ {V V' : B.Etale} (f : V' ⟶ V) (x : H V), (F.obj.map f.op).hom (ψ V x) = ψ V' (res f x)) → (∀ {V V' V'' : B.Etale} (f : V' ⟶ V) (f' : V'' ⟶ V') (x : H V), res (f' ≫ f) x = res f' (res f x)) → (∀ (A : StructuredArrow (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B)) (s : F.obj.obj (Opposite.op A.right)), ∃ (A' : StructuredArrow (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B)) (f : A' ⟶ A) (x : H A'.right), (F.obj.map f.right.op).hom s = ψ A'.right x) → (∀ (N : StructuredArrow (Over.mk (wcEtGeomPt B η)) (Scheme.Etale.forget B)) (s : F.obj.obj (Opposite.op N.right)), ∃ (N' : StructuredArrow (Over.mk (wcEtGeomPt B η)) (Scheme.Etale.forget B)) (f : N' ⟶ N) (x : H N'.right), (F.obj.map f.right.op).hom s = ψ N'.right x) → (∀ (N : StructuredArrow (Over.mk (wcEtGeomPt B η)) (Scheme.Etale.forget B)) (x : H N.right), ψ N.right x = 0 → ∃ (N' : StructuredArrow (Over.mk (wcEtGeomPt B η)) (Scheme.Etale.forget B)) (f : N' ⟶ N), res f.right x = 0) → (∀ (N N' : StructuredArrow (Over.mk (wcEtGeomPt B η)) (Scheme.Etale.forget B)) (f : N' ⟶ N) (x : H N.right), θ N x = θ N' (res f.right x)) → (∀ (N : StructuredArrow (Over.mk (wcEtGeomPt B η)) (Scheme.Etale.forget B)) (x : H N.right), θ N x = 0 → ∃ (N' : StructuredArrow (Over.mk (wcEtGeomPt B η)) (Scheme.Etale.forget B)) (f : N' ⟶ N), res f.right x = 0) → (∀ y : EA, ∃ (l : Λ) (x : H (W'.obj l).right), π l x = y) → (∀ (l : Λ) (x : H (W'.obj l).right), π l x = 0 → ∃ (l' : Λ) (t : l' ⟶ l), res (W'.map t).right x = 0) → Function.Bijective p → (∀ (l : Λ) (x : H (W'.obj l).right), θ (StructuredArrow.mk (Over.homMk (lift l) (hlift l) : Over.mk (wcEtGeomPt B η) ⟶ (Scheme.Etale.forget B).obj (W'.obj l).right)) x = p (π l x)) → (∀ y : (wcEtStalk B η).obj F, ∃ (l : Λ) (s : F.obj.obj (Opposite.op (W'.obj l).right)), (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt B η)) (Scheme.Etale.forget B)).op ⋙ F.obj) (Opposite.op (StructuredArrow.mk (Over.homMk (lift l) (hlift l) : Over.mk (wcEtGeomPt B η) ⟶ (Scheme.Etale.forget B).obj (W'.obj l).right)))).hom s = y) ∧ (∀ (l : Λ) (s : F.obj.obj (Opposite.op (W'.obj l).right)), (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt B η)) (Scheme.Etale.forget B)).op ⋙ F.obj) (Opposite.op (StructuredArrow.mk (Over.homMk (lift l) (hlift l) : Over.mk (wcEtGeomPt B η) ⟶ (Scheme.Etale.forget B).obj (W'.obj l).right)))).hom s = 0 → (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B)).op ⋙ F.obj) (Opposite.op (W'.obj l))).hom s = 0) :=
by
  intro B b η F Λ _ _ W' hinit hcofη lift hlift hcompat H _ ψ res EA Eη _ _ π p θ h1 h2 hSb hSη
    hKη hθ hθK hπS hπK hp hcomp
  classical
  haveI := hinit

  have P1 : ∀ (c : B) (N N' : StructuredArrow (Over.mk (wcEtGeomPt B c)) (Scheme.Etale.forget B))
      (f : N' ⟶ N) (s : F.obj.obj (Opposite.op N.right)),
      (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt B c))
        (Scheme.Etale.forget B)).op ⋙ F.obj) (Opposite.op N)).hom s =
      (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt B c))
        (Scheme.Etale.forget B)).op ⋙ F.obj) (Opposite.op N')).hom
          ((F.obj.map f.right.op).hom s) := by
    intro c N N' f s
    have hw := Limits.colimit.w ((StructuredArrow.proj (Over.mk (wcEtGeomPt B c))
      (Scheme.Etale.forget B)).op ⋙ F.obj) f.op
    exact (congrArg (fun k => k.hom s) hw).symm

  have P2 : ∀ {V V' V'' : B.Etale} (h : V' ⟶ V) (h' : V'' ⟶ V') (s : F.obj.obj (Opposite.op V)),
      (F.obj.map (h' ≫ h).op).hom s = (F.obj.map h'.op).hom ((F.obj.map h.op).hom s) := by
    intro V V' V'' h h' s
    rw [op_comp, Functor.map_comp]
    rfl

  have hrep : ∀ (l : Λ) (s : F.obj.obj (Opposite.op (W'.obj l).right)), ∃ (l' : Λ) (t : l' ⟶ l)
      (x : H (W'.obj l').right), (F.obj.map (W'.map t).right.op).hom s = ψ (W'.obj l').right x := by
    intro l s
    obtain ⟨A', f, x, hx⟩ := hSb (W'.obj l) s
    obtain ⟨l₁, ⟨h⟩⟩ := ((Functor.initial_iff_of_isCofiltered W').mp hinit).1 A'
    obtain ⟨l', t₃, ht₃⟩ := Functor.Initial.exists_eq W'
      (W'.map (IsCofiltered.minToLeft l₁ l) ≫ h ≫ f) (W'.map (IsCofiltered.minToRight l₁ l))
    refine ⟨l', t₃ ≫ IsCofiltered.minToRight l₁ l,
      res (W'.map t₃ ≫ W'.map (IsCofiltered.minToLeft l₁ l) ≫ h).right x, ?_⟩
    have hWt : W'.map (t₃ ≫ IsCofiltered.minToRight l₁ l) =
        (W'.map t₃ ≫ W'.map (IsCofiltered.minToLeft l₁ l) ≫ h) ≫ f := by
      rw [Functor.map_comp, ← ht₃]
      simp only [Category.assoc]
    have hWt' : (W'.map (t₃ ≫ IsCofiltered.minToRight l₁ l)).right =
        (W'.map t₃ ≫ W'.map (IsCofiltered.minToLeft l₁ l) ≫ h).right ≫ f.right := by
      rw [hWt]
      rfl
    rw [hWt', P2, hx, h1]
  haveI := hcofη
  haveI : IsFiltered (StructuredArrow (Over.mk (wcEtGeomPt B η)) (Scheme.Etale.forget B))ᵒᵖ :=
    isFiltered_op_of_isCofiltered _
  haveI := Limits.preservesFilteredColimitsOfSize_shrink.{u+1, u+1, u, u+1}
    (forget AddCommGrpCat.{u+1})
  have GF1 : ∀ x : (wcEtStalk B η).obj F, ∃ (A : StructuredArrow (Over.mk (wcEtGeomPt B η))
      (Scheme.Etale.forget B)) (s : F.obj.obj (Opposite.op A.right)),
      (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt B η))
        (Scheme.Etale.forget B)).op ⋙ F.obj) (Opposite.op A)).hom s = x := by
    intro x
    obtain ⟨j, y, hy⟩ := Limits.Concrete.colimit_exists_rep
      ((StructuredArrow.proj (Over.mk (wcEtGeomPt B η)) (Scheme.Etale.forget B)).op ⋙ F.obj) x
    exact ⟨j.unop, y, hy⟩
  have GF2 : ∀ (A A' : StructuredArrow (Over.mk (wcEtGeomPt B η)) (Scheme.Etale.forget B))
      (s : F.obj.obj (Opposite.op A.right)) (s' : F.obj.obj (Opposite.op A'.right)),
      (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt B η))
        (Scheme.Etale.forget B)).op ⋙ F.obj) (Opposite.op A)).hom s =
      (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt B η))
        (Scheme.Etale.forget B)).op ⋙ F.obj) (Opposite.op A')).hom s' →
      ∃ (A'' : StructuredArrow (Over.mk (wcEtGeomPt B η)) (Scheme.Etale.forget B)) (f : A'' ⟶ A)
        (f' : A'' ⟶ A'), (F.obj.map f.right.op).hom s = (F.obj.map f'.right.op).hom s' := by
    intro A A' s s' h
    obtain ⟨k, f, g, hk⟩ := (Limits.Concrete.colimit_rep_eq_iff_exists
      ((StructuredArrow.proj (Over.mk (wcEtGeomPt B η)) (Scheme.Etale.forget B)).op ⋙ F.obj)
      (i := Opposite.op A) (j := Opposite.op A') s s').mp h
    exact ⟨k.unop, f.unop, g.unop, hk⟩
  refine ⟨fun y => ?_, fun l s hs => ?_⟩
  ·
    obtain ⟨N, s, rfl⟩ := GF1 y
    obtain ⟨N', f, x, hx⟩ := hSη N s
    obtain ⟨w, hw⟩ := hp.2 (θ N' x)
    obtain ⟨l, x₀, hx₀⟩ := hπS w
    let Nl : StructuredArrow (Over.mk (wcEtGeomPt B η)) (Scheme.Etale.forget B) :=
      StructuredArrow.mk (Over.homMk (lift l) (hlift l) :
        Over.mk (wcEtGeomPt B η) ⟶ (Scheme.Etale.forget B).obj (W'.obj l).right)
    have e1 : θ Nl x₀ = θ N' x := by
      rw [← hw, ← hx₀]
      exact hcomp l x₀
    have e2 : θ (IsCofiltered.min Nl N') (res (IsCofiltered.minToLeft Nl N').right x₀ -
        res (IsCofiltered.minToRight Nl N').right x) = 0 := by
      rw [map_sub, ← hθ Nl _ (IsCofiltered.minToLeft Nl N') x₀,
        ← hθ N' _ (IsCofiltered.minToRight Nl N') x, e1, sub_self]
    obtain ⟨N₃, c, hc⟩ := hθK _ _ e2
    have e3 : res (c ≫ IsCofiltered.minToLeft Nl N').right x₀ =
        res (c ≫ IsCofiltered.minToRight Nl N').right x := by
      rw [map_sub, sub_eq_zero] at hc
      show res (c.right ≫ (IsCofiltered.minToLeft Nl N').right) x₀ =
        res (c.right ≫ (IsCofiltered.minToRight Nl N').right) x
      rw [h2, h2, hc]
    have q1 := P1 η Nl N₃ (c ≫ IsCofiltered.minToLeft Nl N') (ψ Nl.right x₀)
    have q2 := P1 η N N' f s
    have q3 := P1 η N' N₃ (c ≫ IsCofiltered.minToRight Nl N') (ψ N'.right x)
    refine ⟨l, ψ Nl.right x₀, q1.trans ?_⟩
    rw [q2, hx, q3, h1, h1, e3]
  ·
    obtain ⟨l', u, x', hx'⟩ := hrep l s
    let Nl : StructuredArrow (Over.mk (wcEtGeomPt B η)) (Scheme.Etale.forget B) :=
      StructuredArrow.mk (Over.homMk (lift l) (hlift l) :
        Over.mk (wcEtGeomPt B η) ⟶ (Scheme.Etale.forget B).obj (W'.obj l).right)
    let Nl' : StructuredArrow (Over.mk (wcEtGeomPt B η)) (Scheme.Etale.forget B) :=
      StructuredArrow.mk (Over.homMk (lift l') (hlift l') :
        Over.mk (wcEtGeomPt B η) ⟶ (Scheme.Etale.forget B).obj (W'.obj l').right)
    have wu : Nl'.hom ≫ (Scheme.Etale.forget B).map (W'.map u).right = Nl.hom :=
      Over.OverMorphism.ext (hcompat u)
    let nu : Nl' ⟶ Nl := StructuredArrow.homMk (W'.map u).right wu
    have q1 := P1 η Nl Nl' nu s
    have hz : (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt B η))
