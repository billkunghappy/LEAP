  obtain ⟨B₀, _, _, _, Λ₀, _, _, W₀, φ₀, a₀, e₀, hInit, hAff, hcomp, ha', hlim, he, heq⟩ :=
    wc_et_geom_strict_henselization y₀
  have hB₀ : wcHalShData y₀ B₀ Λ₀ W₀ φ₀ a₀ := ⟨hInit, hAff, hcomp, ha', hlim, e₀, he, heq⟩

  obtain ⟨θ, hθ⟩ := wc_cgth_divisor_shens_quotient_iso wc_quot_strictly_henselian_of_ne_top
    wc_shdata_lift_geom_point wc_local_etale_hom_ext wc_shdata_normalized_residue
    wc_closed_immersion_geomPt_compat A d hK y₀ y hy₀ B Λ W' φ a ha β hβ B₀ Λ₀ W₀ φ₀ a₀ hB₀

  haveI : Smooth (Spec.map (CommRingCat.ofHom (algebraMap A (MvPolynomial (Fin d) A)))) :=
    (HasRingHomProperty.Spec_iff (P := @Smooth)).mpr (RingHom.smooth_algebraMap.mpr inferInstance)
  have hsm : Smooth ((⊤ : (Spec (.of (MvPolynomial (Fin d) A))).Opens).ι ≫
      Spec.map (CommRingCat.ofHom (algebraMap A (MvPolynomial (Fin d) A)))) := inferInstance
  have hM := (wc_smooth_open_shens_milnor_fibre_acyclic A (Spec (.of (MvPolynomial (Fin d) A)))
    (Spec.map (CommRingCat.ofHom (algebraMap A (MvPolynomial (Fin d) A)))) ⊤ hsm ℓ hunit y₀ trivial
    hfy0 B₀ Λ₀ W₀ φ₀ a₀ hB₀ Ω ξ).2 p hp

  have h₁ : (a₀ ≫ Spec.map (CommRingCat.ofHom (algebraMap A (MvPolynomial (Fin d) A)))) ≫ 𝟙 _ =
      θ.hom ≫ (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {β (MvPolynomial.X none)}))) ≫
        Spec.map (CommRingCat.ofHom (β.comp (algebraMap A (MvPolynomial (Option (Fin d)) A))))) := by
    rw [Category.comp_id]
