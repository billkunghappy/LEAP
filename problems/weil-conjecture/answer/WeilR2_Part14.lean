    refine ⟨fun p => ∑ c, algebraMap L C (χ (-c)) * σC c p.1,
      fun p => ∑ d, algebraMap L C (((uℓ⁻¹ : Lˣ) : L) * χ d) * σC d p.2, ?_, ?_, ?_⟩
    · intro p
      have e1 : σC 1 (∑ c, algebraMap L C (χ (-c)) * σC c p.1) =
          ∑ c, algebraMap L C (χ (-c)) * σC (1 + c) p.1 := by
        rw [map_sum]
        refine Finset.sum_congr rfl (fun c _ => ?_)
        rw [hσL, hσnat]
      rw [e1, Finset.mul_sum, ← Equiv.sum_comp (Equiv.addLeft (1 : ZMod ℓ))
        (fun c => algebraMap L C ω * (algebraMap L C (χ (-c)) * σC c p.1))]
      refine Finset.sum_congr rfl (fun c _ => ?_)
      simp only [Equiv.coe_addLeft]
      rw [← mul_assoc, ← map_mul (algebraMap L C), hstep]
    · intro p
      have e1 : σC 1 (∑ d, algebraMap L C (((uℓ⁻¹ : Lˣ) : L) * χ d) * σC d p.2) =
          ∑ d, algebraMap L C (((uℓ⁻¹ : Lˣ) : L) * χ d) * σC (1 + d) p.2 := by
        rw [map_sum]
        refine Finset.sum_congr rfl (fun d _ => ?_)
        rw [hσL, hσnat]
      rw [e1, Finset.mul_sum, ← Equiv.sum_comp (Equiv.addLeft (1 : ZMod ℓ))
        (fun d => algebraMap L C (ω ^ (ℓ - 1)) *
          (algebraMap L C (((uℓ⁻¹ : Lˣ) : L) * χ d) * σC d p.2))]
      refine Finset.sum_congr rfl (fun d _ => ?_)
      simp only [Equiv.coe_addLeft]
      rw [← mul_assoc, ← map_mul (algebraMap L C), hχadd, hχ1]
      congr 2
      linear_combination (-(((uℓ⁻¹ : Lˣ) : L) * χ d)) * hωω
    · beta_reduce
      calc ∑ p ∈ P, (∑ c, algebraMap L C (χ (-c)) * σC c p.1) *
            (∑ d, algebraMap L C (((uℓ⁻¹ : Lˣ) : L) * χ d) * σC d p.2)
          = ∑ p ∈ P, ∑ c, ∑ d, algebraMap L C (χ (-c) * (((uℓ⁻¹ : Lˣ) : L) * χ d)) *
              (σC c p.1 * σC d p.2) := by
            refine Finset.sum_congr rfl (fun p _ => ?_)
            rw [Finset.sum_mul]
            refine Finset.sum_congr rfl (fun c _ => ?_)
            rw [Finset.mul_sum]
            refine Finset.sum_congr rfl (fun d _ => ?_)
            simp only [map_mul]
            ring
        _ = ∑ c, ∑ p ∈ P, ∑ d, algebraMap L C (χ (-c) * (((uℓ⁻¹ : Lˣ) : L) * χ d)) *
              (σC c p.1 * σC d p.2) := Finset.sum_comm
        _ = ∑ c, ∑ d, ∑ p ∈ P, algebraMap L C (χ (-c) * (((uℓ⁻¹ : Lˣ) : L) * χ d)) *
              (σC c p.1 * σC d p.2) :=
            Finset.sum_congr rfl (fun c _ => Finset.sum_comm)
        _ = ∑ c, ∑ d, algebraMap L C (χ (-c) * (((uℓ⁻¹ : Lˣ) : L) * χ d)) *
              ∑ p ∈ P, σC c p.1 * σC d p.2 := by
            simp only [Finset.mul_sum]
        _ = ∑ c : ZMod ℓ, algebraMap L C ((uℓ⁻¹ : Lˣ) : L) := by
            refine Finset.sum_congr rfl (fun c _ => ?_)
            simp only [hcd, mul_ite, mul_one, mul_zero, Finset.sum_ite_eq,
              Finset.mem_univ, if_true]
            rw [mul_left_comm, hχneg c, mul_one]
        _ = 1 := by
            rw [Finset.sum_const, Finset.card_univ, ZMod.card, nsmul_eq_mul,
              ← map_natCast (algebraMap L C), ← map_mul, hℓbar, map_one]
  have hkey : ∀ c d : L, c ^ ℓ = 1 → ∃ e : TensorProduct S (wcKummerEigDom (σC 1) c)
      (wcKummerEigDom (σC 1) d) ≃ₗ[S] wcKummerEigDom (σC 1) (c * d),
      ∀ u v, (e (u ⊗ₜ[S] v) : C) = (u : C) * v := by
    intro c d hc
    have hκ : c ^ (ℓ - 1) * c = 1 := by
      rw [← pow_succ, Nat.sub_add_cancel hℓ.one_le, hc]
    obtain ⟨x, y, hx, hy, hxy⟩ := hpart c hc
    have hyz : ∀ p (z : C), z ∈ wcKummerEigDom (σC 1) (c * d) →
        y p * z ∈ wcKummerEigDom (σC 1) d := by
      intro p z hz
      have h := hmul _ _ _ _ (hy p) hz
      rw [show c ^ (ℓ - 1) * (c * d) = d by rw [← mul_assoc, hκ, one_mul]] at h
      exact h
    have hyu : ∀ p (u : C), u ∈ wcKummerEigDom (σC 1) c →
        y p * u ∈ wcKummerEigDom (σC 1) (1 : L) := by
      intro p u hu
      have h := hmul _ _ _ _ (hy p) hu
      rw [hκ] at h
      exact h
    have hle : ∀ w, Submodule.mulMap (wcKummerEigDom (σC 1) c) (wcKummerEigDom (σC 1) d) w ∈
        wcKummerEigDom (σC 1) (c * d) := by
      intro w
      have hw : Submodule.mulMap (wcKummerEigDom (σC 1) c) (wcKummerEigDom (σC 1) d) w ∈
          wcKummerEigDom (σC 1) c * wcKummerEigDom (σC 1) d := by
        rw [← Submodule.mulMap_range]
        exact LinearMap.mem_range_self _ w
      refine Submodule.mul_le.mpr ?_ hw
