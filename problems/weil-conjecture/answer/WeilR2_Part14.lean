      rw [map_zero, ← hcomp l' x']
      exact ht)
    obtain ⟨l'', t, ht'⟩ := hπK l' x' hπ
    have q2 := P1 b (W'.obj l) (W'.obj l'') (W'.map (t ≫ u)) s
    have hcomp' : (W'.map (t ≫ u)).right = (W'.map t).right ≫ (W'.map u).right := by
      rw [Functor.map_comp]
