    let ψ : wcKummerEigDom (σC 1) (c * d) →ₗ[S]
        TensorProduct S (wcKummerEigDom (σC 1) c) (wcKummerEigDom (σC 1) d) :=
      { toFun := fun z => ∑ p ∈ P, x' p ⊗ₜ[S]
          (⟨y p * z, hyz p z z.2⟩ : wcKummerEigDom (σC 1) d)
        map_add' := by
          intro z z'
