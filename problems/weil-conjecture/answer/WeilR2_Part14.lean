    exact (wc_fcg_kummer_ramified_absurd (X.presheaf.stalk x) _ hprime _ C hinj t k ℓ u hkpos hk
      htℓ (hT.2 hE)).elim

theorem wc_fntame_etale_codim_one_of_unit : ∀ (ℓ : ℕ), ℓ.Prime → ∀ (A₀ : Type u) [CommRing A₀] [IsDomain A₀] [IsIntegrallyClosed A₀] [IsNoetherianRing A₀], IsUnit (ℓ : A₀) → ∀ (ζ : A₀), IsPrimitiveRoot ζ ℓ → ∀ (X : Scheme.{u}) [CompactSpace X] [QuasiSeparatedSpace X] (f : X ⟶ Spec (.of A₀)) [Smooth f] (σ : Spec (.of A₀) ⟶ X) (hσ : σ ≫ f = 𝟙 _), (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (z : Spec (.of Ω) ⟶ Spec (.of A₀)), ConnectedSpace ↥(Limits.pullback f z)) → ∀ (P : Scheme.{u}) (p : P ⟶ Limits.pullback f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) (α : ZMod ℓ → (P ⟶ P)), wcFetTorsor p ℓ α → (∃ r : Spec (.of (FractionRing A₀)) ⟶ P, r ≫ p = Limits.pullback.lift (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))) ≫ σ) (𝟙 _) (by rw [Category.assoc, hσ, Category.comp_id, Category.id_comp])) → ∀ [QuasiCompact (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))))] [QuasiSeparated (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))))], (∀ x : X, IsDomain (X.presheaf.stalk x) ∧ IsIntegrallyClosed (X.presheaf.stalk x)) → IsFinite (Scheme.Hom.fromNormalization (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))))) → IsPullback (Scheme.Hom.toNormalization (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))))) p (Scheme.Hom.fromNormalization (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))))) (Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) → ∀ x : X, (f x).asIdeal.height = 1 → ∃ W : X.Opens, x ∈ W ∧ Etale (Scheme.Hom.fromNormalization (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) ∣_ W) :=
by
  intro ℓ hℓ A₀ _ _ _ _ hℓu ζ hζ X _ _ f _ σ hσ hconn P p α hP hr _ _ hnorm hfin hpb x hx
  haveI : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian f
  have hreg : ∀ y : X, (f y).asIdeal.height = 1 →
