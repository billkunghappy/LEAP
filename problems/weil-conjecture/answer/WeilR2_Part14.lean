        (fun x hx => (mul_eq_zero.mp hx).resolve_left (MvPolynomial.X_ne_zero _))
    haveI := conn _ _ B B' (MvPolynomial.map (Spec.preimage ξ).hom) β (MvPolynomial.X none) hreg
      (Limits.pullback.fst (Spec.map (CommRingCat.ofHom (β.comp (algebraMap A (MvPolynomial (Option (Fin d)) A))))) ξ)
      h hh a' (by haveI := hc; exact WeaklyEtale.flat)
    exact wc_et_coh_zero_connected_card _ ℓ hℓ0
  · intro q hq
    haveI : Smooth (Spec.map (CommRingCat.ofHom (algebraMap A (MvPolynomial (Option (Fin d)) A)))) :=
      (HasRingHomProperty.Spec_iff (P := @Smooth)).mpr (RingHom.smooth_algebraMap.mpr inferInstance)
    have h1 := (wc_smooth_open_shens_milnor_fibre_acyclic A (Spec (.of (MvPolynomial (Option (Fin d)) A)))
      (Spec.map (CommRingCat.ofHom (algebraMap A (MvPolynomial (Option (Fin d)) A)))) ⊤ inferInstance
      ℓ hunit y (by simp) hy B Λ W' φ a ha Ω ξ).2 q hq
    have hcomp : a ≫ Spec.map (CommRingCat.ofHom (algebraMap A (MvPolynomial (Option (Fin d)) A))) =
        Spec.map (CommRingCat.ofHom (β.comp (algebraMap A (MvPolynomial (Option (Fin d)) A)))) := by
      rw [← hβ, ← Spec.map_comp, ← CommRingCat.ofHom_comp]
    obtain ⟨e4⟩ := wc_et_coh_iso_invariance (Limits.pullback.congrHom hcomp rfl).hom ℓ q
    exact @Equiv.subsingleton _ _ e4 h1

theorem wc_shdata_lift_geom_point : ∀ {Y : Scheme.{u}} (y : Y) (B : Type u) [CommRing B] [IsLocalRing B] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt Y y)) (Scheme.Etale.forget Y)) (φ : ∀ l, Spec (.of B) ⟶ (W'.obj l).right.left) (a : Spec (.of B) ⟶ Y), wcHalShData y B Λ W' φ a → ∀ (R : Type u) [CommRing R] [HenselianLocalRing R] [IsSepClosed (IsLocalRing.ResidueField R)] (c : Spec (.of R) ⟶ Y) (q : Spec (.of (AlgebraicClosure (Y.residueField y))) ⟶ Spec (.of R)), q (IsLocalRing.closedPoint (AlgebraicClosure (Y.residueField y))) = IsLocalRing.closedPoint R → q ≫ c = wcEtGeomPt Y y → ∃ δ : Spec (.of R) ⟶ Spec (.of B), δ ≫ a = c ∧ ∀ l, q ≫ δ ≫ φ l = (W'.obj l).hom.left :=
by
  classical
  have happ : ∀ {X Y : Scheme.{u}} (f g : X ⟶ Y), f = g → ∀ p : X, f p = g p := by
    intro X Y f g h p
    subst h
    rfl
  have s0 : ∀ {P E S : Scheme.{u}} (ee : E ⟶ S) [Etale ee] (aa bb : P ⟶ E), aa ≫ ee = bb ≫ ee →
      ∀ (Ω : Type u) [Field Ω] (pp : Spec (.of Ω) ⟶ P), pp ≫ aa = pp ≫ bb →
      ∃ U : P.Opens, pp (IsLocalRing.closedPoint Ω) ∈ U ∧ U.ι ≫ aa = U.ι ≫ bb := by
    intro P E S ee _ aa bb hab Ω _ pp hπ
    let c : P ⟶ Limits.pullback ee ee := Limits.pullback.lift aa bb hab
    have hcf : c ≫ Limits.pullback.fst ee ee = aa := Limits.pullback.lift_fst _ _ _
    have hcs : c ≫ Limits.pullback.snd ee ee = bb := Limits.pullback.lift_snd _ _ _
    have hkey : pp ≫ c = (pp ≫ aa) ≫ Limits.pullback.diagonal ee := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, hcf, Category.assoc, Limits.pullback.diagonal_fst, Category.comp_id]
      · rw [Category.assoc, hcs, Category.assoc, Limits.pullback.diagonal_snd, Category.comp_id,
          hπ]
    have hpt : ∀ w : Spec (.of Ω), c (pp w) = Limits.pullback.diagonal ee (aa (pp w)) := by
      intro w
      rw [← Scheme.Hom.comp_apply, hkey, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply]
    refine ⟨c ⁻¹ᵁ (Limits.pullback.diagonal ee).opensRange, ?_, ?_⟩
    · show c (pp (IsLocalRing.closedPoint Ω)) ∈ (Limits.pullback.diagonal ee).opensRange
      rw [← SetLike.mem_coe, Scheme.Hom.coe_opensRange]
      exact ⟨_, (hpt _).symm⟩
    · set U := c ⁻¹ᵁ (Limits.pullback.diagonal ee).opensRange with hU
      have hrange : Set.range (U.ι ≫ c) ⊆ Set.range (Limits.pullback.diagonal ee) := by
        rintro _ ⟨x, rfl⟩
        have hx0 : U.ι x ∈ Set.range U.ι := ⟨x, rfl⟩
        rw [Scheme.Opens.range_ι] at hx0
        have hx' : c (U.ι x) ∈ (Limits.pullback.diagonal ee).opensRange := hx0
        rw [← SetLike.mem_coe, Scheme.Hom.coe_opensRange] at hx'
        rw [Scheme.Hom.comp_apply]
        exact hx'
      obtain ⟨t, ht⟩ : ∃ t, t ≫ Limits.pullback.diagonal ee = U.ι ≫ c :=
        ⟨_, IsOpenImmersion.lift_fac (Limits.pullback.diagonal ee) (U.ι ≫ c) hrange⟩
      have h1 : U.ι ≫ aa = t := by
        calc U.ι ≫ aa = (U.ι ≫ c) ≫ Limits.pullback.fst ee ee := by rw [Category.assoc, hcf]
          _ = (t ≫ Limits.pullback.diagonal ee) ≫ Limits.pullback.fst ee ee := by rw [ht]
          _ = t := by rw [Category.assoc, Limits.pullback.diagonal_fst, Category.comp_id]
      have h2 : U.ι ≫ bb = t := by
        calc U.ι ≫ bb = (U.ι ≫ c) ≫ Limits.pullback.snd ee ee := by rw [Category.assoc, hcs]
          _ = (t ≫ Limits.pullback.diagonal ee) ≫ Limits.pullback.snd ee ee := by rw [ht]
          _ = t := by rw [Category.assoc, Limits.pullback.diagonal_snd, Category.comp_id]
      rw [h1, h2]
  have rigid : ∀ (R : Type u) [CommRing R] [IsLocalRing R] (Ω : Type u) [Field Ω]
      (π : Spec (.of Ω) ⟶ Spec (.of R)), π (IsLocalRing.closedPoint Ω) = IsLocalRing.closedPoint R →
      ∀ {Z V : Scheme.{u}} (h : V ⟶ Z) [Etale h] (g₁ g₂ : Spec (.of R) ⟶ V),
      g₁ ≫ h = g₂ ≫ h → π ≫ g₁ = π ≫ g₂ → g₁ = g₂ := by
    intro R _ _ Ω _ π hπ Z V h _ g₁ g₂ hh hg
    obtain ⟨U, hU, hUeq⟩ := s0 h g₁ g₂ hh _ π hg
    have hU' : IsLocalRing.closedPoint R ∈ U := by
      rw [← hπ]
      exact hU
    have hsub : Set.range ⇑(𝟙 (Spec (.of R))) ⊆ Set.range ⇑U.ι := by
      intro x _
      rw [Scheme.Opens.range_ι]
      exact (IsLocalRing.specializes_closedPoint (R := R) x).mem_open U.isOpen hU'
    have hk := IsOpenImmersion.lift_fac U.ι (𝟙 _) hsub
    calc g₁ = (IsOpenImmersion.lift U.ι (𝟙 _) hsub ≫ U.ι) ≫ g₁ := by
          rw [hk, Category.id_comp]
      _ = (IsOpenImmersion.lift U.ι (𝟙 _) hsub ≫ U.ι) ≫ g₂ := by
          simp only [Category.assoc, hUeq]
      _ = g₂ := by rw [hk, Category.id_comp]
  have wc_sec : ∀ (R : Type u) [CommRing R] [HenselianLocalRing R] [IsSepClosed (IsLocalRing.ResidueField R)] {V Z : Scheme.{u}} (h : V ⟶ Z) [Etale h] (c : Spec (.of R) ⟶ Z) (Ω : Type u) [Field Ω] (q : Spec (.of Ω) ⟶ Spec (.of R)) (v : Spec (.of Ω) ⟶ V), q (IsLocalRing.closedPoint Ω) = IsLocalRing.closedPoint R → v ≫ h = q ≫ c → ∃ d : Spec (.of R) ⟶ V, d ≫ h = c ∧ q ≫ d = v := by
    intro R _ _ _ V Z h _ c Ω _ q v hq hv
    have hetale : ∀ (E : Type u) [CommRing E] [Algebra R E] [Algebra.Etale R E]
        (σ : E →ₐ[R] IsLocalRing.ResidueField R), ∃ τ : E →ₐ[R] R,
          ∀ x : E, IsLocalRing.residue R (τ x) = σ x := by
      intro E _ _ _ σ
      haveI hq : (RingHom.ker σ).IsPrime := RingHom.ker_isPrime σ
      haveI : Algebra.FormallyEtale E (Localization.AtPrime (RingHom.ker σ)) :=
        Algebra.FormallyEtale.of_isLocalization (RingHom.ker σ).primeCompl
      haveI : Algebra.IsEtaleAt R (RingHom.ker σ) :=
        Algebra.FormallyEtale.comp R E (Localization.AtPrime (RingHom.ker σ))
      obtain ⟨g, hg, hstd⟩ := Algebra.IsEtaleAt.exists_isStandardEtale (R := R) (RingHom.ker σ)
      have hσg : IsUnit (σ g) := isUnit_iff_ne_zero.mpr (fun h => hg (RingHom.mem_ker.mpr h))
      let σg : Localization.Away g →ₐ[R] IsLocalRing.ResidueField R :=
        IsLocalization.Away.liftAlgHom g hσg
      have hσg_apply : ∀ y : E, σg (algebraMap E (Localization.Away g) y) = σ y := by
        intro y
        rw [IsLocalization.Away.liftAlgHom_apply, IsLocalization.Away.lift_eq]
        rfl
      obtain ⟨Q⟩ := hstd.nonempty_standardEtalePresentation
      let e : Q.Ring ≃ₐ[R] Localization.Away g :=
        AlgEquiv.ofBijective (Q.lift Q.x Q.hasMap) Q.lift_bijective
      have heX : e Q.X = Q.x := by
        rw [AlgEquiv.ofBijective_apply]
        exact Q.lift_X _ _
      set a₀ := σg Q.x with ha₀
      have hf0 : Polynomial.aeval a₀ Q.f = 0 := by
        rw [ha₀, Polynomial.aeval_algHom_apply, Q.hasMap.1, map_zero]
      have hf' : Polynomial.aeval a₀ (Polynomial.derivative Q.f) ≠ 0 := by
        rw [ha₀, Polynomial.aeval_algHom_apply]
        exact ((StandardEtalePair.HasMap.isUnit_derivative_f Q.P Q.hasMap).map σg).ne_zero
      have hg0 : Polynomial.aeval a₀ Q.g ≠ 0 := by
        rw [ha₀, Polynomial.aeval_algHom_apply]
        exact (Q.hasMap.2.map σg).ne_zero
      have hHen := ((HenselianLocalRing.TFAE R).out 1 2).mp (inferInstance : HenselianLocalRing R)
      obtain ⟨a, hroot, hres⟩ := hHen Q.f Q.monic_f a₀ hf0 hf'
      have hres' : ∀ p : Polynomial R,
          IsLocalRing.residue R (Polynomial.aeval a p) = Polynomial.aeval a₀ p := by
        intro p
        rw [← hres, ← IsLocalRing.ResidueField.algebraMap_eq, ← Algebra.ofId_apply,
          ← Algebra.ofId_apply, ← Polynomial.aeval_algHom_apply]
      have hHas : Q.HasMap a := by
        refine ⟨?_, ?_⟩
        · rw [Polynomial.coe_aeval_eq_eval]
          exact hroot
        · rw [← IsLocalRing.residue_ne_zero_iff_isUnit, hres']
          exact hg0
      have hcomp : (Algebra.ofId R (IsLocalRing.ResidueField R)).comp (Q.lift a hHas) =
          σg.comp (e : Q.Ring →ₐ[R] Localization.Away g) := by
        apply StandardEtalePair.hom_ext
        rw [AlgHom.comp_apply, AlgHom.comp_apply, Q.lift_X, AlgEquiv.coe_toAlgHom, heX,
          Algebra.ofId_apply, IsLocalRing.ResidueField.algebraMap_eq, hres]
      refine ⟨((Q.lift a hHas).comp (e.symm : Localization.Away g →ₐ[R] Q.Ring)).comp
        (IsScalarTower.toAlgHom R E (Localization.Away g)), fun y => ?_⟩
      have h1 := congrArg (fun φ => φ (e.symm (algebraMap E (Localization.Away g) y))) hcomp
      simp only [AlgHom.comp_apply, AlgEquiv.coe_toAlgHom, AlgEquiv.apply_symm_apply,
        Algebra.ofId_apply, IsLocalRing.ResidueField.algebraMap_eq] at h1
      rw [AlgHom.comp_apply, AlgHom.comp_apply, IsScalarTower.coe_toAlgHom',
        AlgEquiv.coe_toAlgHom, h1, hσg_apply]
    have hres : ∀ (S : Type u) [CommRing S] [Algebra R S], Algebra.Etale R S →
        ∀ (P : Ideal S) [P.IsPrime], P.comap (algebraMap R S) = IsLocalRing.maximalIdeal R →
        ∃ φ₀ : S →ₐ[R] IsLocalRing.ResidueField R, ∀ x, φ₀ x = 0 ↔ x ∈ P := by
      intro S _ _ hE P _ hP
      have hker : RingHom.ker (algebraMap R P.ResidueField) = IsLocalRing.maximalIdeal R := by
        rw [IsScalarTower.algebraMap_eq R S P.ResidueField, ← RingHom.comap_ker,
          Ideal.ker_algebraMap_residueField, hP]
      have : IsLocalHom (algebraMap R P.ResidueField) := by
        constructor
        intro a ha
        by_contra hna
        have hm : a ∈ IsLocalRing.maximalIdeal R := hna
        rw [← hker, RingHom.mem_ker] at hm
        exact ha.ne_zero hm
      let j : IsLocalRing.ResidueField R →+* P.ResidueField :=
        IsLocalRing.ResidueField.lift (algebraMap R P.ResidueField)
      letI : Algebra (IsLocalRing.ResidueField R) P.ResidueField := j.toAlgebra
      have : IsScalarTower R (IsLocalRing.ResidueField R) P.ResidueField :=
        IsScalarTower.of_algebraMap_eq (fun r => by
          rw [RingHom.algebraMap_toAlgebra, IsLocalRing.ResidueField.algebraMap_eq,
            IsLocalRing.ResidueField.lift_residue_apply])
      have : Algebra.FormallyUnramified S (Localization.AtPrime P) :=
        Algebra.FormallyUnramified.of_isLocalization P.primeCompl
      have : Algebra.FormallyUnramified S P.ResidueField :=
        Algebra.FormallyUnramified.comp S (Localization.AtPrime P) P.ResidueField
      have : Algebra.FormallyUnramified R P.ResidueField :=
        Algebra.FormallyUnramified.comp R S P.ResidueField
      have : Algebra.EssFiniteType R P.ResidueField := Algebra.EssFiniteType.comp R S P.ResidueField
      have : Algebra.FormallyUnramified (IsLocalRing.ResidueField R) P.ResidueField :=
        Algebra.FormallyUnramified.of_restrictScalars R _ P.ResidueField
      have : Algebra.EssFiniteType (IsLocalRing.ResidueField R) P.ResidueField :=
        Algebra.EssFiniteType.of_comp R _ P.ResidueField
      have : Algebra.IsSeparable (IsLocalRing.ResidueField R) P.ResidueField :=
        Algebra.FormallyUnramified.isSeparable _ P.ResidueField
      have hsurj := IsSepClosed.algebraMap_surjective (IsLocalRing.ResidueField R) P.ResidueField
      let eq : IsLocalRing.ResidueField R ≃ₐ[R] P.ResidueField :=
        AlgEquiv.ofBijective (IsScalarTower.toAlgHom R (IsLocalRing.ResidueField R) P.ResidueField)
          ⟨(algebraMap (IsLocalRing.ResidueField R) P.ResidueField).injective, hsurj⟩
      refine ⟨eq.symm.toAlgHom.comp (IsScalarTower.toAlgHom R S P.ResidueField), fun x => ?_⟩
      show eq.symm (algebraMap S P.ResidueField x) = 0 ↔ x ∈ P
      rw [EmbeddingLike.map_eq_zero_iff, ← RingHom.mem_ker, Ideal.ker_algebraMap_residueField]
    obtain ⟨s₀, hs1, hs2⟩ : ∃ s₀ : Spec (.of Ω) ⟶ Limits.pullback h c,
        s₀ ≫ Limits.pullback.fst h c = v ∧ s₀ ≫ Limits.pullback.snd h c = q :=
      ⟨Limits.pullback.lift v q hv, Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
    obtain ⟨z, hz⟩ : ∃ z, s₀ (IsLocalRing.closedPoint Ω) = z := ⟨_, rfl⟩
    obtain ⟨E, ι, hι, hzι, -⟩ :=
      Scheme.exists_affine_mem_range_and_range_subset
        (U := (⊤ : (Limits.pullback h c).Opens)) (x := z) trivial
    obtain ⟨w, hw⟩ := hzι
    haveI := hι
    obtain ⟨φ, hφ⟩ : ∃ φ : CommRingCat.of R ⟶ E, Spec.map φ = ι ≫ Limits.pullback.snd h c :=
      ⟨_, Spec.map_preimage _⟩
    have hEt : (CommRingCat.Hom.hom φ).Etale := by
      have : Etale (Spec.map φ) := by rw [hφ]; infer_instance
      exact (HasRingHomProperty.Spec_iff (P := @Etale)).mp this
    letI : Algebra R E := (CommRingCat.Hom.hom φ).toAlgebra
    have hAE : Algebra.Etale R E := RingHom.Etale.toAlgebra hEt
    haveI := hAE
    have hzR : Limits.pullback.snd h c z = IsLocalRing.closedPoint R := by
      rw [← hz]
      exact (Scheme.Hom.comp_apply s₀ (Limits.pullback.snd h c) _).symm.trans
        ((happ _ _ hs2 _).trans hq)
    have hqw : (w.asIdeal).comap (algebraMap R E) = IsLocalRing.maximalIdeal R := by
      have h1 : (Spec.map φ) w = IsLocalRing.closedPoint R := by
        rw [hφ]
        exact (Scheme.Hom.comp_apply ι (Limits.pullback.snd h c) w).trans
          ((congrArg (Limits.pullback.snd h c) hw).trans hzR)
      have h2 := congrArg PrimeSpectrum.asIdeal h1
      exact h2
    haveI hwP : w.asIdeal.IsPrime := PrimeSpectrum.isPrime (show PrimeSpectrum E from w)
    obtain ⟨φ₀, hφ₀⟩ := hres E hAE w.asIdeal hqw
    obtain ⟨τ, hτ⟩ := hetale E φ₀
    let τ' : E ⟶ CommRingCat.of R := CommRingCat.ofHom (τ : E →+* R)
    have hret : φ ≫ τ' = 𝟙 _ := by
      ext r
      exact τ.commutes r
    have hr : Set.range s₀ ⊆ Set.range ι := by
      rintro _ ⟨p, rfl⟩
      have hp : p = IsLocalRing.closedPoint Ω := Subsingleton.elim (α := PrimeSpectrum Ω) _ _
      rw [hp, hz]
      exact ⟨w, hw⟩
    obtain ⟨s₀', hs₀'⟩ : ∃ s₀', s₀' ≫ ι = s₀ := ⟨_, IsOpenImmersion.lift_fac ι s₀ hr⟩
    obtain ⟨χ, hχ⟩ : ∃ χ : E ⟶ CommRingCat.of Ω, Spec.map χ = s₀' := ⟨_, Spec.map_preimage _⟩
    obtain ⟨ψ, hψq⟩ : ∃ ψ : CommRingCat.of R ⟶ CommRingCat.of Ω, Spec.map ψ = q :=
      ⟨_, Spec.map_preimage _⟩
    have hχφ : φ ≫ χ = ψ := by
      apply Spec.map_injective
      rw [Spec.map_comp, hχ, hφ, hψq, ← Category.assoc, hs₀', hs2]
    have hs₀'pt : s₀' (IsLocalRing.closedPoint Ω) = w :=
      ι.isOpenEmbedding.injective ((Scheme.Hom.comp_apply s₀' ι _).symm.trans
        ((happ _ _ hs₀' _).trans (hz.trans hw.symm)))
    have hker : ∀ e ∈ w.asIdeal, χ.hom e = 0 := by
      intro e he
      have h1 : (Spec.map χ) (IsLocalRing.closedPoint Ω) = w := by rw [hχ]; exact hs₀'pt
      have h1' : PrimeSpectrum.comap χ.hom (IsLocalRing.closedPoint Ω) = w :=
        (Spec.map_apply χ _).symm.trans h1
      have h2' : e ∈ (PrimeSpectrum.comap χ.hom (IsLocalRing.closedPoint Ω)).asIdeal := by
        rw [h1']; exact he
      have h2 : χ.hom e ∈ (IsLocalRing.closedPoint Ω).asIdeal := h2'
      rw [Ideal.eq_bot_of_prime (IsLocalRing.closedPoint Ω).asIdeal] at h2
      exact Ideal.mem_bot.mp h2
    have hψker : ∀ r ∈ IsLocalRing.maximalIdeal R, ψ.hom r = 0 := by
      intro r hr
      have h1 : (Spec.map ψ) (IsLocalRing.closedPoint Ω) = IsLocalRing.closedPoint R := by
        rw [hψq]; exact hq
      have h1' : PrimeSpectrum.comap ψ.hom (IsLocalRing.closedPoint Ω) = IsLocalRing.closedPoint R :=
        (Spec.map_apply ψ _).symm.trans h1
      have h2 : r ∈ (PrimeSpectrum.comap ψ.hom (IsLocalRing.closedPoint Ω)).asIdeal := by
        rw [h1']; exact hr
      have h3 : ψ.hom r ∈ (IsLocalRing.closedPoint Ω).asIdeal := h2
      rw [Ideal.eq_bot_of_prime (IsLocalRing.closedPoint Ω).asIdeal] at h3
      exact Ideal.mem_bot.mp h3
    have hringe : ∀ e : E, ψ.hom (τ e) = χ.hom e := by
      intro e
      obtain ⟨r, hr⟩ := IsLocalRing.residue_surjective (φ₀ e)
      have hφ₀φ : φ₀ (φ.hom r) = IsLocalRing.residue R r := by
        have h0 := φ₀.commutes r
        rw [IsLocalRing.ResidueField.algebraMap_eq] at h0
        exact h0
      have hmem : e - φ.hom r ∈ w.asIdeal := by
        rw [← hφ₀, map_sub, hφ₀φ, hr, sub_self]
      have hτm : τ (e - φ.hom r) ∈ IsLocalRing.maximalIdeal R := by
        rw [← IsLocalRing.residue_eq_zero_iff, hτ, (hφ₀ _).mpr hmem]
      have hχφr : χ.hom (φ.hom r) = ψ.hom r := by
        rw [← hχφ, CommRingCat.hom_comp, RingHom.comp_apply]
      have hτφ : τ (φ.hom r) = r := τ.commutes r
      have hsplit : φ.hom r + (e - φ.hom r) = e := by ring
      calc ψ.hom (τ e) = ψ.hom (τ (φ.hom r + (e - φ.hom r))) := by rw [hsplit]
        _ = ψ.hom r := by rw [map_add, map_add, hτφ, hψker _ hτm, add_zero]
        _ = χ.hom (φ.hom r + (e - φ.hom r)) := by rw [map_add, hχφr, hker _ hmem, add_zero]
        _ = χ.hom e := by rw [hsplit]
    have hring : τ' ≫ ψ = χ := by
      ext e
      exact hringe e
    have hqσ : q ≫ Spec.map τ' = s₀' := by
      rw [← hψq, ← Spec.map_comp, hring, hχ]
    refine ⟨Spec.map τ' ≫ ι ≫ Limits.pullback.fst h c, ?_, ?_⟩
    · rw [Category.assoc, Category.assoc, Limits.pullback.condition, ← Category.assoc ι,
        ← hφ, ← Category.assoc, ← Spec.map_comp, hret, Spec.map_id, Category.id_comp]
    · rw [← Category.assoc, hqσ, ← Category.assoc, hs₀', hs1]
  intro Y y B _ _ Λ _ _ W' φ a hd R _ _ _ c q hq hqc
  obtain ⟨-, -, hcomp, hφa, hlim, -⟩ := hd
  have hleg : ∀ l, ∃ d : Spec (.of R) ⟶ (W'.obj l).right.left,
      d ≫ (W'.obj l).right.hom = c ∧ q ≫ d = (W'.obj l).hom.left := by
    intro l
    haveI : Etale (W'.obj l).right.hom := (W'.obj l).right.prop
    have hpt_l : (W'.obj l).hom.left ≫ (W'.obj l).right.hom = wcEtGeomPt Y y :=
      Over.w (W'.obj l).hom
    exact wc_sec R (W'.obj l).right.hom c _ q (W'.obj l).hom.left hq (hpt_l.trans hqc.symm)
  choose d hd1 hd3 using hleg
  have hdc : ∀ {l l₁ : Λ} (t : l ⟶ l₁), d l ≫ (W'.map t).right.left = d l₁ := by
    intro l l₁ t
    haveI : Etale (W'.obj l₁).right.hom := (W'.obj l₁).right.prop
    apply rigid R (AlgebraicClosure (Y.residueField y)) q hq (W'.obj l₁).right.hom
    · rw [Category.assoc, MorphismProperty.Over.w (W'.map t).right, hd1, hd1]
    · rw [← Category.assoc, hd3, hd3]
      exact congrArg (fun f => f.left) (StructuredArrow.w (W'.map t))
  obtain ⟨δ, hδ, -⟩ := hlim (Spec (.of R)) d hdc
  obtain ⟨l₀⟩ := IsCofiltered.nonempty (C := Λ)
  refine ⟨δ, ?_, fun l => ?_⟩
  · rw [← hφa l₀, ← Category.assoc, hδ l₀, hd1]
  · rw [hδ l, hd3]

theorem wc_cgth_divisor_shens_quotient_iso : (∀ (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)] (I : Ideal B), I ≠ ⊤ → ∃ (h : HenselianLocalRing (B ⧸ I)), IsSepClosed (@IsLocalRing.ResidueField (B ⧸ I) _ h.toIsLocalRing)) → (∀ {Y : Scheme.{u}} (y : Y) (B : Type u) [CommRing B] [IsLocalRing B] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt Y y)) (Scheme.Etale.forget Y)) (φ : ∀ l, Spec (.of B) ⟶ (W'.obj l).right.left) (a : Spec (.of B) ⟶ Y), wcHalShData y B Λ W' φ a → ∀ (R : Type u) [CommRing R] [HenselianLocalRing R] [IsSepClosed (IsLocalRing.ResidueField R)] (c : Spec (.of R) ⟶ Y) (q : Spec (.of (AlgebraicClosure (Y.residueField y))) ⟶ Spec (.of R)), q (IsLocalRing.closedPoint (AlgebraicClosure (Y.residueField y))) = IsLocalRing.closedPoint R → q ≫ c = wcEtGeomPt Y y → ∃ δ : Spec (.of R) ⟶ Spec (.of B), δ ≫ a = c ∧ ∀ l, q ≫ δ ≫ φ l = (W'.obj l).hom.left) → (∀ (R : Type u) [CommRing R] [IsLocalRing R] {E S : Scheme.{u}} (e : E ⟶ S) [Etale e] (α β : Spec (.of R) ⟶ E), α ≫ e = β ≫ e → ∀ (Ω' : Type u) [Field Ω'] (π : Spec (.of Ω') ⟶ Spec (.of R)), π (IsLocalRing.closedPoint Ω') = IsLocalRing.closedPoint R → π ≫ α = π ≫ β → α = β) → (∀ {Y : Scheme.{u}} (y : Y) (B0 : Type u) [CommRing B0] [IsLocalRing B0] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt Y y)) (Scheme.Etale.forget Y)) (φ : ∀ l, Spec (.of B0) ⟶ (W'.obj l).right.left) (a0 : Spec (.of B0) ⟶ Y), wcHalShData y B0 Λ W' φ a0 → ∃ e' : IsLocalRing.ResidueField B0 →+* AlgebraicClosure (Y.residueField y), ∀ l, Spec.map (CommRingCat.ofHom e') ≫ Spec.map (CommRingCat.ofHom (IsLocalRing.residue B0)) ≫ φ l = (W'.obj l).hom.left) → (∀ (R₀ B₀ : Scheme.{u}) (i : R₀ ⟶ B₀) [IsClosedImmersion i] (y : R₀), ∃ e : Spec (.of (AlgebraicClosure (B₀.residueField (i y)))) ⟶ Spec (.of (AlgebraicClosure (R₀.residueField y))), IsIso e ∧ e ≫ wcEtGeomPt R₀ y ≫ i = wcEtGeomPt B₀ (i y)) → ∀ (A : Type u) [CommRing A] (d : ℕ), (∀ p : MvPolynomial (Option (Fin d)) A, p - MvPolynomial.rename (some : Fin d → Option (Fin d)) ((MvPolynomial.aeval (fun o : Option (Fin d) => Option.elim o (0 : MvPolynomial (Fin d) A) MvPolynomial.X) : MvPolynomial (Option (Fin d)) A →ₐ[A] MvPolynomial (Fin d) A) p) ∈ Ideal.span {(MvPolynomial.X none : MvPolynomial (Option (Fin d)) A)}) → ∀ (y₀ : Spec (.of (MvPolynomial (Fin d) A))) (y : Spec (.of (MvPolynomial (Option (Fin d)) A))), Spec.map (CommRingCat.ofHom (MvPolynomial.aeval (fun o : Option (Fin d) => Option.elim o (0 : MvPolynomial (Fin d) A) MvPolynomial.X) : MvPolynomial (Option (Fin d)) A →ₐ[A] MvPolynomial (Fin d) A).toRingHom) y₀ = y → ∀ (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (MvPolynomial (Option (Fin d)) A))) y)) (Scheme.Etale.forget (Spec (.of (MvPolynomial (Option (Fin d)) A))))) (φ : ∀ l, Spec (.of B) ⟶ (W'.obj l).right.left) (a : Spec (.of B) ⟶ Spec (.of (MvPolynomial (Option (Fin d)) A))), wcHalShData y B Λ W' φ a → ∀ (β : MvPolynomial (Option (Fin d)) A →+* B), Spec.map (CommRingCat.ofHom β) = a → ∀ (B₀ : Type u) [CommRing B₀] [HenselianLocalRing B₀] [IsSepClosed (IsLocalRing.ResidueField B₀)] (Λ₀ : Type u) [SmallCategory Λ₀] [IsCofiltered Λ₀] (W₀ : Λ₀ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (MvPolynomial (Fin d) A))) y₀)) (Scheme.Etale.forget (Spec (.of (MvPolynomial (Fin d) A))))) (φ₀ : ∀ l, Spec (.of B₀) ⟶ (W₀.obj l).right.left) (a₀ : Spec (.of B₀) ⟶ Spec (.of (MvPolynomial (Fin d) A))), wcHalShData y₀ B₀ Λ₀ W₀ φ₀ a₀ → ∃ θ : Spec (.of B₀) ≅ Spec (.of (B ⧸ Ideal.span {β (MvPolynomial.X none)})), θ.hom ≫ Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {β (MvPolynomial.X none)}))) ≫ Spec.map (CommRingCat.ofHom (β.comp (algebraMap A (MvPolynomial (Option (Fin d)) A)))) = a₀ ≫ Spec.map (CommRingCat.ofHom (algebraMap A (MvPolynomial (Fin d) A))) :=
by
  intro H1 H2 H3 H4 H5 A _ d hK y₀ y hy₀ B _ _ _ Λ _ _ W' φ a ha β hβ B₀ _ _ _ Λ₀ _ _ W₀ φ₀ a₀ hB₀
  classical
  subst hy₀

  have C1 : ∀ {Y : Scheme.{u}} (y : Y) (B : Type u) [CommRing B] [IsLocalRing B] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt Y y)) (Scheme.Etale.forget Y)) (φ : ∀ l, Spec (.of B) ⟶ (W'.obj l).right.left) (a : Spec (.of B) ⟶ Y), wcHalShData y B Λ W' φ a → a (IsLocalRing.closedPoint B) = y := by
    intro Y y B _ _ Λ _ _ W' φ a hd
    obtain ⟨-, -, -, -, -, e, -, heq⟩ := hd
    obtain ⟨x⟩ : Nonempty (Spec (.of (AlgebraicClosure (Y.residueField y)))) :=
      ⟨IsLocalRing.closedPoint (AlgebraicClosure (Y.residueField y))⟩
    have h1 : (Spec.map (CommRingCat.ofHom e) ≫ Spec.map (CommRingCat.ofHom (IsLocalRing.residue B)) ≫ a) x = wcEtGeomPt Y y x := by
      rw [heq]
    have hl : (Spec.map (CommRingCat.ofHom e) ≫ Spec.map (CommRingCat.ofHom (IsLocalRing.residue B)) ≫ a) x = a (IsLocalRing.closedPoint B) := by
      rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply]
      congr 1
      exact IsLocalRing.PrimeSpectrum.comap_residue B _
    have hr : wcEtGeomPt Y y x = y := by
      first
      | exact Scheme.fromSpecResidueField_apply y _
      | (unfold wcEtGeomPt; rw [Scheme.Hom.comp_apply]; exact Scheme.fromSpecResidueField_apply y _)
      | (simp [wcEtGeomPt])
    exact hl.symm.trans (h1.trans hr)

  have C2 : ∀ {Y : Scheme.{u}} (y : Y) (B0 : Type u) [CommRing B0] [IsLocalRing B0] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt Y y)) (Scheme.Etale.forget Y)) (φ : ∀ l, Spec (.of B0) ⟶ (W'.obj l).right.left) (a0 : Spec (.of B0) ⟶ Y), wcHalShData y B0 Λ W' φ a0 → ∀ (R : Type u) [CommRing R] [IsLocalRing R] (δ₁ δ₂ : Spec (.of R) ⟶ Spec (.of B0)) (Ω' : Type u) [Field Ω'] (π : Spec (.of Ω') ⟶ Spec (.of R)), π (IsLocalRing.closedPoint Ω') = IsLocalRing.closedPoint R → δ₁ ≫ a0 = δ₂ ≫ a0 → π ≫ δ₁ = π ≫ δ₂ → δ₁ = δ₂ := by
    intro Y y B0 _ _ Λ _ _ W' φ a0 hd R _ _ δ₁ δ₂ Ω' _ π hπ hδa hδπ
    obtain ⟨-, -, hcomp, hφa, hlim, -⟩ := hd
    have hl : ∀ l, δ₁ ≫ φ l = δ₂ ≫ φ l := by
      intro l
      haveI : Etale (W'.obj l).right.hom := (W'.obj l).right.prop
      exact H3 R (W'.obj l).right.hom _ _ (by simp only [Category.assoc, hφa]; exact hδa) Ω' π hπ
        (by rw [← Category.assoc, hδπ, Category.assoc])
    have hz : ∀ {l l' : Λ} (t : l ⟶ l'), (δ₁ ≫ φ l) ≫ (W'.map t).right.left = δ₁ ≫ φ l' := by
      intro l l' t
      rw [Category.assoc, hcomp]
    exact (hlim (Spec (.of R)) (fun l => δ₁ ≫ φ l) hz).unique (fun l => rfl) (fun l => (hl l).symm)

  have C5 : ∀ {Y Y₀ : Scheme.{u}} (ι : Y₀ ⟶ Y) [Mono ι] (y₀ : Y₀) (B : Type u) [CommRing B] [IsLocalRing B] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt Y (ι y₀))) (Scheme.Etale.forget Y)) (φ : ∀ l, Spec (.of B) ⟶ (W'.obj l).right.left) (a : Spec (.of B) ⟶ Y), wcHalShData (ι y₀) B Λ W' φ a → ∀ (B₀ : Type u) [CommRing B₀] [HenselianLocalRing B₀] [IsSepClosed (IsLocalRing.ResidueField B₀)] (Λ₀ : Type u) [SmallCategory Λ₀] [IsCofiltered Λ₀] (W₀ : Λ₀ ⥤ StructuredArrow (Over.mk (wcEtGeomPt Y₀ y₀)) (Scheme.Etale.forget Y₀)) (φ₀ : ∀ l, Spec (.of B₀) ⟶ (W₀.obj l).right.left) (a₀ : Spec (.of B₀) ⟶ Y₀), wcHalShData y₀ B₀ Λ₀ W₀ φ₀ a₀ → ∀ (Q : Type u) [CommRing Q] [HenselianLocalRing Q] [IsSepClosed (IsLocalRing.ResidueField Q)] (eQ : Spec (.of Q) ⟶ Spec (.of B)) [Mono eQ] (c : Spec (.of Q) ⟶ Y₀), c ≫ ι = eQ ≫ a → ∀ (e : Spec (.of (AlgebraicClosure (Y.residueField (ι y₀)))) ⟶ Spec (.of (AlgebraicClosure (Y₀.residueField y₀)))) [IsIso e], e ≫ wcEtGeomPt Y₀ y₀ ≫ ι = wcEtGeomPt Y (ι y₀) → ∀ (q' : Spec (.of (AlgebraicClosure (Y.residueField (ι y₀)))) ⟶ Spec (.of Q)), (∀ x, q' x = IsLocalRing.closedPoint Q) → (∀ l, q' ≫ eQ ≫ φ l = (W'.obj l).hom.left) → (∀ g : Spec (.of B₀) ⟶ Spec (.of B), g ≫ a = a₀ ≫ ι → ∃ ε : Spec (.of B₀) ⟶ Spec (.of Q), ε ≫ eQ = g) → ∃ θ : Spec (.of B₀) ≅ Spec (.of Q), θ.hom ≫ eQ ≫ a = a₀ ≫ ι := by
    intro Y Y₀ ι _ y₀ B _ _ Λ _ _ W' φ a hB B₀ _ _ _ Λ₀ _ _ W₀ φ₀ a₀ hB₀ Q _ _ _ eQ _ c hc e _ he q' hq'pt hq'φ hfac
    have hB' := hB
    have hB₀' := hB₀
    obtain ⟨-, -, -, hφa, hlim, -⟩ := hB'
    obtain ⟨-, -, -, hφa₀, hlim₀, -⟩ := hB₀'
    obtain ⟨l₁⟩ := IsCofiltered.nonempty (C := Λ)
    obtain ⟨l₀'⟩ := IsCofiltered.nonempty (C := Λ₀)

    have hv : ∀ l, (W'.obj l).hom.left ≫ (W'.obj l).right.hom = wcEtGeomPt Y (ι y₀) :=
      fun l => Over.w (W'.obj l).hom
    have hv₀ : ∀ l, (W₀.obj l).hom.left ≫ (W₀.obj l).right.hom = wcEtGeomPt Y₀ y₀ :=
      fun l => Over.w (W₀.obj l).hom
    have hvc : ∀ {l l' : Λ} (t : l ⟶ l'), (W'.obj l).hom.left ≫ (W'.map t).right.left = (W'.obj l').hom.left :=
      fun t => congrArg (fun f => f.left) (StructuredArrow.w (W'.map t))
    have hvc₀ : ∀ {l l' : Λ₀} (t : l ⟶ l'), (W₀.obj l).hom.left ≫ (W₀.map t).right.left = (W₀.obj l').hom.left :=
      fun t => congrArg (fun f => f.left) (StructuredArrow.w (W₀.map t))

    have hK2 : q' ≫ eQ ≫ a = wcEtGeomPt Y (ι y₀) := by
      calc q' ≫ eQ ≫ a = (q' ≫ eQ ≫ φ l₁) ≫ (W'.obj l₁).right.hom := by
            rw [← hφa l₁]; simp only [Category.assoc]
        _ = wcEtGeomPt Y (ι y₀) := by rw [hq'φ l₁]; exact hv l₁

    obtain ⟨e₀', he₀'⟩ := H4 y₀ B₀ Λ₀ W₀ φ₀ a₀ hB₀
    obtain ⟨qB₀, hqB₀⟩ : ∃ f : Spec (.of (AlgebraicClosure (Y₀.residueField y₀))) ⟶ Spec (.of B₀),
        f = Spec.map (CommRingCat.ofHom e₀') ≫ Spec.map (CommRingCat.ofHom (IsLocalRing.residue B₀)) :=
      ⟨_, rfl⟩
    have hqB₀φ : ∀ l, qB₀ ≫ φ₀ l = (W₀.obj l).hom.left := by
      intro l; rw [hqB₀, Category.assoc]; exact he₀' l
    have hqB₀pt : ∀ x, qB₀ x = IsLocalRing.closedPoint B₀ := by
      intro x; rw [hqB₀, Scheme.Hom.comp_apply]; exact IsLocalRing.PrimeSpectrum.comap_residue B₀ _
    have hqB₀a : qB₀ ≫ a₀ = wcEtGeomPt Y₀ y₀ := by
      rw [← hφa₀ l₀', ← Category.assoc, hqB₀φ l₀']; exact hv₀ l₀'

    obtain ⟨q, hq⟩ : ∃ f : Spec (.of (AlgebraicClosure (Y₀.residueField y₀))) ⟶ Spec (.of Q),
        f = inv e ≫ q' := ⟨_, rfl⟩
    have hqpt : q (IsLocalRing.closedPoint (AlgebraicClosure (Y₀.residueField y₀))) = IsLocalRing.closedPoint Q := by
      rw [hq]; exact (Scheme.Hom.comp_apply _ _ _).trans (hq'pt _)
    have hqc : q ≫ c = wcEtGeomPt Y₀ y₀ := by
      rw [← cancel_mono ι, hq]
      simp only [Category.assoc]
      rw [hc, hK2, ← he, IsIso.inv_hom_id_assoc]
      rfl

    obtain ⟨δ, hδa, hδφ⟩ := H2 y₀ B₀ Λ₀ W₀ φ₀ a₀ hB₀ Q c q hqpt hqc

    obtain ⟨q₀, hq₀⟩ : ∃ f : Spec (.of (AlgebraicClosure (Y.residueField (ι y₀)))) ⟶ Spec (.of B₀),
        f = e ≫ qB₀ := ⟨_, rfl⟩
    have hq₀pt : q₀ (IsLocalRing.closedPoint (AlgebraicClosure (Y.residueField (ι y₀)))) = IsLocalRing.closedPoint B₀ := by
      rw [hq₀]; exact (Scheme.Hom.comp_apply _ _ _).trans (hqB₀pt _)
    have hq₀c : q₀ ≫ a₀ ≫ ι = wcEtGeomPt Y (ι y₀) := by
      rw [hq₀, Category.assoc, ← Category.assoc qB₀, hqB₀a]; exact he
    obtain ⟨g, hga, hgφ⟩ := H2 (ι y₀) B Λ W' φ a hB B₀ (a₀ ≫ ι) q₀ hq₀pt hq₀c

    obtain ⟨ε, hε⟩ := hfac g hga
    have hεc : ε ≫ c = a₀ := by
      rw [← cancel_mono ι, Category.assoc, hc, ← Category.assoc, hε, hga]

    have hK8 : q₀ ≫ g = q' ≫ eQ :=
      (hlim _ (fun l => (W'.obj l).hom.left) hvc).unique
        (fun l => by rw [Category.assoc]; exact hgφ l)
        (fun l => by rw [Category.assoc]; exact hq'φ l)

    have hK9a : qB₀ ≫ g = q ≫ eQ := by
      rw [← cancel_epi e, ← Category.assoc, ← hq₀, hK8, hq, Category.assoc, IsIso.hom_inv_id_assoc]
    have hK9 : qB₀ ≫ ε = q := by
      rw [← cancel_mono eQ, Category.assoc, hε, hK9a]

    have hK10 : q ≫ δ = qB₀ :=
      (hlim₀ _ (fun l => (W₀.obj l).hom.left) hvc₀).unique
        (fun l => by rw [Category.assoc]; exact hδφ l)
        (fun l => hqB₀φ l)

    have hK11 : ε ≫ δ = 𝟙 _ :=
      C2 y₀ B₀ Λ₀ W₀ φ₀ a₀ hB₀ B₀ (ε ≫ δ) (𝟙 _) _ qB₀ (hqB₀pt _)
        (by rw [Category.assoc, hδa, hεc, Category.id_comp])
        (by rw [← Category.assoc, hK9, hK10, Category.comp_id])

    have hq'e : q' = e ≫ q := by rw [hq, IsIso.hom_inv_id_assoc]
    have hK12 : δ ≫ ε = 𝟙 _ := by
      rw [← cancel_mono eQ, Category.assoc, hε, Category.id_comp]
      exact C2 (ι y₀) B Λ W' φ a hB Q (δ ≫ g) eQ _ q' (hq'pt _)
        (by rw [Category.assoc, hga, ← Category.assoc, hδa, hc])
        (by rw [hq'e, Category.assoc, ← Category.assoc q δ, hK10, ← Category.assoc, ← hq₀, hK8, ← hq'e])

    refine ⟨⟨ε, δ, hK11, hK12⟩, ?_⟩
    show ε ≫ eQ ≫ a = a₀ ≫ ι
    rw [← Category.assoc, hε, hga]

  let I0 : MvPolynomial (Option (Fin d)) A →ₐ[A] MvPolynomial (Fin d) A :=
    MvPolynomial.aeval (fun o : Option (Fin d) => Option.elim o (0 : MvPolynomial (Fin d) A) MvPolynomial.X)
  have hI0 : I0 = MvPolynomial.aeval (fun o : Option (Fin d) => Option.elim o (0 : MvPolynomial (Fin d) A) MvPolynomial.X) := rfl

  have hsec : ∀ q : MvPolynomial (Fin d) A, I0 (MvPolynomial.rename some q) = q := by
    have hc : I0.comp (MvPolynomial.rename (some : Fin d → Option (Fin d))) = AlgHom.id A _ := by
      apply MvPolynomial.algHom_ext
      intro j
      simp [hI0, MvPolynomial.rename_X]
    intro q
    exact AlgHom.congr_fun hc q
  have hsurj : Function.Surjective I0.toRingHom := fun q => ⟨_, hsec q⟩
  haveI : IsClosedImmersion (Spec.map (CommRingCat.ofHom I0.toRingHom)) :=
    IsClosedImmersion.spec_of_surjective _ hsurj
  have hX0 : I0 (MvPolynomial.X none) = 0 := by
    rw [hI0, MvPolynomial.aeval_X]; rfl

  have hya : a (IsLocalRing.closedPoint B) = Spec.map (CommRingCat.ofHom I0.toRingHom) y₀ :=
    C1 _ B Λ W' φ a ha
  have hu : β (MvPolynomial.X none) ∈ IsLocalRing.maximalIdeal B := by
    have h1 : (Spec.map (CommRingCat.ofHom β)) (IsLocalRing.closedPoint B) =
        Spec.map (CommRingCat.ofHom I0.toRingHom) y₀ := by rw [hβ, hya]
    have h4 : PrimeSpectrum.comap (CommRingCat.ofHom β).hom (IsLocalRing.closedPoint B) =
        PrimeSpectrum.comap (CommRingCat.ofHom I0.toRingHom).hom y₀ :=
      (Spec.map_apply _ _).symm.trans (h1.trans (Spec.map_apply _ _))
    have h3 : MvPolynomial.X none ∈ (PrimeSpectrum.comap (CommRingCat.ofHom I0.toRingHom).hom y₀).asIdeal := by
      show (CommRingCat.ofHom I0.toRingHom).hom (MvPolynomial.X none) ∈ y₀.asIdeal
      have h0 : (CommRingCat.ofHom I0.toRingHom).hom (MvPolynomial.X none) = 0 := hX0
      rw [h0]; exact y₀.asIdeal.zero_mem
    have h5 : MvPolynomial.X none ∈ (PrimeSpectrum.comap (CommRingCat.ofHom β).hom (IsLocalRing.closedPoint B)).asIdeal := by
      rw [h4]; exact h3
    exact h5

  have hne : Ideal.span {β (MvPolynomial.X none)} ≠ ⊤ := by
    rw [Ne, Ideal.span_singleton_eq_top]
    exact mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal _).mp hu)
  obtain ⟨hQ, hQs⟩ := H1 B (Ideal.span {β (MvPolynomial.X none)}) hne
  haveI := hQ
  haveI := hQs

  haveI : IsClosedImmersion (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {β (MvPolynomial.X none)})))) :=
    IsClosedImmersion.spec_of_surjective _ Ideal.Quotient.mk_surjective

  have C6 : (Ideal.Quotient.mk (Ideal.span {β (MvPolynomial.X none)})).comp β = ((Ideal.Quotient.mk (Ideal.span {β (MvPolynomial.X none)})).comp (β.comp (MvPolynomial.rename (some : Fin d → Option (Fin d)) : MvPolynomial (Fin d) A →ₐ[A] MvPolynomial (Option (Fin d)) A).toRingHom)).comp I0.toRingHom := by
    apply RingHom.ext
    intro p
    show Ideal.Quotient.mk (Ideal.span {β (MvPolynomial.X none)}) (β p) =
      Ideal.Quotient.mk (Ideal.span {β (MvPolynomial.X none)}) (β (MvPolynomial.rename some (I0 p)))
    rw [Ideal.Quotient.eq]
    obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp (hK p)
    exact Ideal.mem_span_singleton'.mpr ⟨β c, by rw [← map_mul, hc, map_sub]⟩
  have hc : Spec.map (CommRingCat.ofHom ((Ideal.Quotient.mk (Ideal.span {β (MvPolynomial.X none)})).comp (β.comp (MvPolynomial.rename (some : Fin d → Option (Fin d)) : MvPolynomial (Fin d) A →ₐ[A] MvPolynomial (Option (Fin d)) A).toRingHom))) ≫ Spec.map (CommRingCat.ofHom I0.toRingHom) = Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {β (MvPolynomial.X none)}))) ≫ a := by
    rw [← hβ, ← Spec.map_comp, ← Spec.map_comp, ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp, C6]

  obtain ⟨e, he_iso, he⟩ := H5 _ _ (Spec.map (CommRingCat.ofHom I0.toRingHom)) y₀
  haveI := he_iso

  obtain ⟨eB', heB'⟩ := H4 _ B Λ W' φ a ha
  obtain ⟨τ, hτ⟩ : ∃ τ : B →+* AlgebraicClosure ((Spec (.of (MvPolynomial (Option (Fin d)) A))).residueField (Spec.map (CommRingCat.ofHom I0.toRingHom) y₀)),
      τ = eB'.comp (IsLocalRing.residue B) := ⟨_, rfl⟩
  have hkill : ∀ b ∈ IsLocalRing.maximalIdeal B, τ b = 0 := by
    intro b hb
    rw [hτ, RingHom.comp_apply, (IsLocalRing.residue_eq_zero_iff b).mpr hb, map_zero]
  have hτI : ∀ x ∈ Ideal.span {β (MvPolynomial.X none)}, τ x = 0 := by
    intro x hx
    obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp hx
    rw [map_mul, hkill _ hu, mul_zero]
  obtain ⟨τ', hτ'⟩ : ∃ τ' : B ⧸ Ideal.span {β (MvPolynomial.X none)} →+* AlgebraicClosure ((Spec (.of (MvPolynomial (Option (Fin d)) A))).residueField (Spec.map (CommRingCat.ofHom I0.toRingHom) y₀)),
      τ'.comp (Ideal.Quotient.mk _) = τ :=
    ⟨Ideal.Quotient.lift _ τ hτI, Ideal.Quotient.lift_comp_mk _ _ _⟩
  have hq'pt : ∀ x, Spec.map (CommRingCat.ofHom τ') x = IsLocalRing.closedPoint (B ⧸ Ideal.span {β (MvPolynomial.X none)}) := by
    intro x
    rw [Spec.map_apply]
    apply PrimeSpectrum.ext
    show Ideal.comap τ' x.asIdeal = IsLocalRing.maximalIdeal _
    haveI : x.asIdeal.IsPrime := x.isPrime
    rw [Ideal.eq_bot_of_prime x.asIdeal]
    symm
    apply Ideal.IsMaximal.eq_of_le (IsLocalRing.maximalIdeal.isMaximal _)
    · intro htop
      have h1 : (1 : B ⧸ Ideal.span {β (MvPolynomial.X none)}) ∈ Ideal.comap τ' (⊥ : Ideal _) := by
        rw [htop]; exact Submodule.mem_top
      rw [Ideal.mem_comap, map_one, Ideal.mem_bot] at h1
      exact one_ne_zero h1
    · intro z hz
      obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective z
      rw [Ideal.mem_comap, Ideal.mem_bot]
      by_cases hb : b ∈ IsLocalRing.maximalIdeal B
      · exact (RingHom.congr_fun hτ' b).trans (hkill b hb)
      · exfalso
        have hbu : IsUnit b := by
          by_contra h
