theorem wc_poly_tube_lift_point_closed : ∀ (A : Type u) [CommRing A] (A' : Type u) [CommRing A'] [IsLocalRing A'] (β : A →+* A') (x : Spec (.of (Polynomial A))), (∀ x' : Spec (.of (Polynomial A)), Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A))) x' = Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A))) x → x ⤳ x' → x' = x) → ∀ x'' : Spec (.of (Polynomial A')), Spec.map (CommRingCat.ofHom (Polynomial.mapRingHom β)) x'' = x → Spec.map (CommRingCat.ofHom (algebraMap A' (Polynomial A'))) x'' = IsLocalRing.closedPoint A' → IsClosed ({x''} : Set (Spec (.of (Polynomial A')))) :=
by
  intro A _ A' _ _ β x hx x'' hlift hcl
  classical
  have hm : Ideal.comap Polynomial.C x''.asIdeal = IsLocalRing.maximalIdeal A' := by
    have h := congrArg PrimeSpectrum.asIdeal hcl
    exact h
  have hx1 : x.asIdeal = Ideal.comap (Polynomial.mapRingHom β) x''.asIdeal := by
    rw [← hlift]
    rfl
  have hprime : x''.asIdeal.IsPrime := x''.isPrime
  set π' : Polynomial A' →+* Polynomial (IsLocalRing.ResidueField A') :=
    Polynomial.mapRingHom (IsLocalRing.residue A') with hπ'
  have hsurj : Function.Surjective π' :=
    Polynomial.map_surjective _ IsLocalRing.residue_surjective
  have hker : RingHom.ker π' = Ideal.map Polynomial.C (IsLocalRing.maximalIdeal A') := by
    rw [hπ', Polynomial.ker_mapRingHom, IsLocalRing.ker_residue]
  have hkle : RingHom.ker π' ≤ x''.asIdeal := by
    rw [hker, Ideal.map_le_iff_le_comap, hm]
  haveI hPbar : (Ideal.map π' x''.asIdeal).IsPrime := Ideal.map_isPrime_of_surjective hsurj hkle
  have hcomap : Ideal.comap π' (Ideal.map π' x''.asIdeal) = x''.asIdeal := by
    rw [Ideal.comap_map_of_surjective' π' hsurj, sup_eq_left.mpr hkle]
  by_cases hbot : Ideal.map π' x''.asIdeal = ⊥
  · exfalso
    have hle : x''.asIdeal ≤ RingHom.ker π' := (Ideal.map_eq_bot_iff_le_ker π').mp hbot
    have heq : x''.asIdeal = Ideal.map Polynomial.C (IsLocalRing.maximalIdeal A') := by
      rw [← hker]; exact le_antisymm hle hkle
    set p : Ideal A := Ideal.comap β (IsLocalRing.maximalIdeal A') with hp
    have hxP : x.asIdeal = Ideal.map Polynomial.C p := by
      rw [hx1, heq]
      ext f
      simp only [Ideal.mem_comap, Ideal.mem_map_C_iff, Polynomial.coe_mapRingHom,
        Polynomial.coeff_map, hp]
    haveI hpp : p.IsPrime := Ideal.IsPrime.comap β
    set Q : Ideal (Polynomial A) := Ideal.comap (Polynomial.constantCoeff (R := A)) p with hQ
    haveI hQp : Q.IsPrime := Ideal.IsPrime.comap _
    let x' : Spec (.of (Polynomial A)) := ⟨Q, hQp⟩
    have hCQ : Ideal.comap (algebraMap A (Polynomial A)) Q = p := by
      ext r
      simp only [hQ, Ideal.mem_comap, Polynomial.algebraMap_eq, Polynomial.constantCoeff_apply,
        Polynomial.coeff_C_zero]
    have hCP : Ideal.comap (algebraMap A (Polynomial A)) (Ideal.map Polynomial.C p) = p := by
      ext r
      simp only [Ideal.mem_comap, Polynomial.algebraMap_eq, Ideal.mem_map_C_iff, Polynomial.coeff_C]
      constructor
      · intro h; simpa using h 0
      · intro h n
        by_cases hn : n = 0
        · simp [hn, h]
        · simp [hn]
    have hfib : Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A))) x' =
        Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A))) x := by
      apply PrimeSpectrum.ext
      show Ideal.comap (algebraMap A (Polynomial A)) Q =
        Ideal.comap (algebraMap A (Polynomial A)) x.asIdeal
      rw [hxP, hCQ, hCP]
    have hle0 : x.asIdeal ≤ Q := by
      rw [hxP]
      intro f hf
      rw [Ideal.mem_map_C_iff] at hf
      simp only [hQ, Ideal.mem_comap, Polynomial.constantCoeff_apply]
      exact hf 0
    have hsp : x ⤳ x' := (PrimeSpectrum.le_iff_specializes x x').mp (by
      first
        | exact hle0
        | exact PrimeSpectrum.asIdeal_le_asIdeal.mp hle0)
    have hxx := hx x' hfib hsp
    have hQx : Q = x.asIdeal := congrArg PrimeSpectrum.asIdeal hxx
    have hXQ : (Polynomial.X : Polynomial A) ∈ Q := by
      simp only [hQ, Ideal.mem_comap, Polynomial.constantCoeff_apply, Polynomial.coeff_X_zero]
      exact p.zero_mem
    rw [hQx, hxP, Ideal.mem_map_C_iff] at hXQ
    have h1 := hXQ 1
    rw [Polynomial.coeff_X_one] at h1
    exact hpp.ne_top ((Ideal.eq_top_iff_one p).mpr h1)
  · have hmax : (Ideal.map π' x''.asIdeal).IsMaximal := by
      first
        | exact Ideal.IsPrime.isMaximal hPbar hbot
        | exact IsPrime.to_maximal_ideal hbot
    have hmax' : x''.asIdeal.IsMaximal := by
      rw [← hcomap]
      exact Ideal.comap_isMaximal_of_surjective π' hsurj
    exact (PrimeSpectrum.isClosed_singleton_iff_isMaximal x'').mpr hmax'

theorem wc_poly_closed_point_residue_sepclosed : ∀ (A' : Type u) [CommRing A'] [IsLocalRing A'] [IsSepClosed (IsLocalRing.ResidueField A')] (x'' : Spec (.of (Polynomial A'))), IsClosed ({x''} : Set (Spec (.of (Polynomial A')))) → Spec.map (CommRingCat.ofHom (algebraMap A' (Polynomial A'))) x'' = IsLocalRing.closedPoint A' → IsSepClosed ((Spec (.of (Polynomial A'))).residueField x'') :=
by
  intro A' _ _ hsc x'' hcl hx
  have s1 : ∀ (k K : Type u) [Field k] [Field K] [IsSepClosed k] (F : Polynomial k →+* K),
      Function.Surjective F → IsSepClosed K := by
    intro k K _ _ _ F hF
    let _ : Algebra k K := (F.comp Polynomial.C).toAlgebra
    let F' : Polynomial k →ₐ[k] K :=
      { F with commutes' := fun a => by rw [Polynomial.algebraMap_eq]; rfl }
    haveI : Algebra.FiniteType k K := Algebra.FiniteType.of_surjective F' hF
    haveI : Module.Finite k K := finite_of_finite_type_of_isJacobsonRing k K
    haveI : Algebra.IsAlgebraic k K := Algebra.IsAlgebraic.of_finite k K
    exact Algebra.IsAlgebraic.isSepClosed (F := k)
  set P : Ideal (Polynomial A') := x''.asIdeal with hP
  have hmax : P.IsMaximal := (PrimeSpectrum.isClosed_singleton_iff_isMaximal x'').mp hcl
  have hcomap : Ideal.comap (Polynomial.C : A' →+* Polynomial A') P =
      IsLocalRing.maximalIdeal A' := by
    have h := congrArg PrimeSpectrum.asIdeal hx
    rw [Spec.map_apply] at h
    rw [← Polynomial.algebraMap_eq]
    first
      | exact h
      | simpa [PrimeSpectrum.comap_asIdeal] using h
  let q := Ideal.Quotient.mk P
  have hg : ∀ a ∈ IsLocalRing.maximalIdeal A', (q.comp Polynomial.C) a = 0 := by
    intro a ha
    rw [RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem]
    rw [← hcomap] at ha
    exact ha
  let ψ : IsLocalRing.ResidueField A' →+* Polynomial A' ⧸ P :=
    Ideal.Quotient.lift _ (q.comp Polynomial.C) hg
  let f : Polynomial (IsLocalRing.ResidueField A') →+* Polynomial A' ⧸ P :=
    Polynomial.eval₂RingHom ψ (q Polynomial.X)
  have hψ : ψ.comp (IsLocalRing.residue A') = q.comp Polynomial.C :=
    RingHom.ext fun a => by
      first
        | exact (Ideal.Quotient.lift_mk (IsLocalRing.maximalIdeal A') (q.comp Polynomial.C) hg :
            Ideal.Quotient.lift _ _ hg (Ideal.Quotient.mk _ a) = _)
        | rfl
        | simp [ψ, IsLocalRing.residue]
  have hf : Function.Surjective f := by
    intro y
    obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective y
    refine ⟨p.map (IsLocalRing.residue A'), ?_⟩
    show Polynomial.eval₂ ψ (q Polynomial.X) (p.map (IsLocalRing.residue A')) = q p
    rw [Polynomial.eval₂_map, hψ, ← Polynomial.hom_eval₂, Polynomial.eval₂_C_X]
  let σ := (Spec.stalkIso (.of (Polynomial A')) x'').commRingCatIsoToRingEquiv
  let τ := RingEquiv.ofBijective (algebraMap (Polynomial A' ⧸ P) P.ResidueField)
    (Ideal.bijective_algebraMap_quotient_residueField P)
  let e : Polynomial A' ⧸ P ≃+* (Spec (.of (Polynomial A'))).residueField x'' :=
    τ.trans (IsLocalRing.ResidueField.mapEquiv σ).symm
  exact @s1 (IsLocalRing.ResidueField A') _ inferInstance inferInstance hsc
    ((e : Polynomial A' ⧸ P →+* _).comp f) (e.surjective.comp hf)

