    exact ⟨inferInstance, (wc_fco_regular_local_ufd _).2⟩
  have hσx : f (σ (f x)) = f x := by rw [← Scheme.Hom.comp_apply, hσ]; rfl
  obtain ⟨ξ, hξf, hξx, hξs⟩ :=
    wc_fco_fibre_common_generization A₀ X f hconn x (σ (f x)) hσx.symm
  have hA := wc_fco_etale_stalk_at_section_of_unit ℓ hℓ A₀ hℓu ζ hζ X f σ hσ P p α hP hr hreg
    hnorm hfin hpb (f x) hx
  obtain ⟨W₀, hW₀, hW₀e⟩ := wc_fco_etale_nbhd_of_stalk X _ _ hfin (σ (f x)) hA
  have hξW : ξ ∈ W₀ := hξs.mem_open W₀.isOpen hW₀
  have hB := wc_fco_etale_stalk_of_generization_of_unit ℓ hℓ A₀ hℓu ζ hζ X f P p α hP hreg hnorm
    hfin hpb x ξ hx hξx hξf W₀ hξW hW₀e
  exact wc_fco_etale_nbhd_of_stalk X _ _ hfin x hB

theorem wc_fntame_etale_codim_ge_two_kfree : ∀ (ℓ : ℕ), ℓ.Prime → ∀ (A₀ : Type u) [CommRing A₀] [IsDomain A₀] [IsIntegrallyClosed A₀] [IsNoetherianRing A₀] (X : Scheme.{u}) [CompactSpace X] [QuasiSeparatedSpace X] (f : X ⟶ Spec (.of A₀)) [Smooth f] (σ : Spec (.of A₀) ⟶ X) (hσ : σ ≫ f = 𝟙 _), (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (z : Spec (.of Ω) ⟶ Spec (.of A₀)), ConnectedSpace ↥(Limits.pullback f z)) → ∀ (P : Scheme.{u}) (p : P ⟶ Limits.pullback f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) (α : ZMod ℓ → (P ⟶ P)), wcFetTorsor p ℓ α → (∃ r : Spec (.of (FractionRing A₀)) ⟶ P, r ≫ p = Limits.pullback.lift (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))) ≫ σ) (𝟙 _) (by rw [Category.assoc, hσ, Category.comp_id, Category.id_comp])) → ∀ [QuasiCompact (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))))] [QuasiSeparated (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))))], (∀ x : X, IsDomain (X.presheaf.stalk x) ∧ IsIntegrallyClosed (X.presheaf.stalk x)) → IsFinite (Scheme.Hom.fromNormalization (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))))) → IsPullback (Scheme.Hom.toNormalization (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))))) p (Scheme.Hom.fromNormalization (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))))) (Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) → ∀ x : X, 2 ≤ (f x).asIdeal.height → (∀ x' : X, (f x').asIdeal.height < (f x).asIdeal.height → ∃ W : X.Opens, x' ∈ W ∧ Etale (Scheme.Hom.fromNormalization (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) ∣_ W)) → ∃ W : X.Opens, x ∈ W ∧ Etale (Scheme.Hom.fromNormalization (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) ∣_ W) :=
by
  intro ℓ hℓ A₀ _ _ _ _ X _ _ f _ σ hσ hconn P p α hP hr _ _ hnorm hfin hpb x hx IH
  classical

  have H_lt : ∀ x' : X, (f x').asIdeal < (f x).asIdeal → ∃ W : X.Opens, x' ∈ W ∧
      Etale (Scheme.Hom.fromNormalization (p ≫ Limits.pullback.fst f
        (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) ∣_ W) := by
    intro x' h
    haveI : (f x').asIdeal.IsPrime := (f x').isPrime
    exact IH x' (Ideal.height_strict_mono_of_isPrime h)

  have hW0 : ∃ W : X.Opens, σ (f x) ∈ W ∧ Etale (Scheme.Hom.fromNormalization (p ≫
      Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) ∣_ W) := by
    obtain ⟨r, hr⟩ := hr
    obtain ⟨U, hU, hyU, hUn, A, _, _, _, _, _, B, _, _, _, _, _, s, L, _, _, _, _, h2, hL1, hL2, hL3,
      hFin, hE, hPtT, hEt⟩ := wc_cg2_affine_ring_data A₀ X f σ hσ P p hP.finite hP.etale hnorm hfin
        hpb x hx H_lt
    have hZ := wc_cg2_torsor_point_fibre p ℓ α hP hℓ.ne_zero (FractionRing A₀) _ r hr
    have hcore := wc_cg2_ring_core A h2 B s L hL1 hL2 hL3 hFin hE (hPtT hZ)
    haveI := hfin
    exact wc_cg2_open_of_stalk_etale _ U hU hUn (σ (f x)) hyU (hEt hcore)

  have hfσ : f (σ (f x)) = f x := by
    rw [← Scheme.Hom.comp_apply, hσ]
    rfl

  have hpur : ∀ z : X, 2 ≤ (f z).asIdeal.height →
      (∀ x' : X, x' ⤳ z → x' ≠ z → ∃ W : X.Opens, x' ∈ W ∧ Etale (Scheme.Hom.fromNormalization
        (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) ∣_ W)) →
      (∃ ξ : X, ξ ⤳ z ∧ ξ ≠ z ∧ f ξ = f z) →
      ∃ W : X.Opens, z ∈ W ∧ Etale (Scheme.Hom.fromNormalization
        (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) ∣_ W) := by
    intro x hx Hgen Hfib
    suffices H : ∀ {N : Scheme.{u}} (ν : N ⟶ X) [IsFinite ν],
        (∀ x' : X, x' ⤳ x → x' ≠ x → ∃ W : X.Opens, x' ∈ W ∧ Etale (ν ∣_ W)) →
        (∀ (U : X.Opens) (hU : IsAffineOpen U) (hx : x ∈ U), ∃ a b : A₀,
          @wcPlpRegA A₀ _ (f x).asIdeal (f x).isPrime a b ∧
            wcPlpRegC (wcPlpChartMap f hU) (Scheme.Hom.app ν U).hom
              (hU.primeIdealOf ⟨x, hx⟩).asIdeal a b) →
        ∃ W : X.Opens, x ∈ W ∧ Etale (ν ∣_ W) by
      exact @H _ _ hfin Hgen
        (wc_plp_depth_pair A₀ X f P p hP.finite hP.etale hnorm hfin hpb x hx)
    intro N ν _ Hgen' hdp
    haveI : IsAffineHom ν := inferInstance
    haveI : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian f
    obtain ⟨U, hU, hxU, -⟩ := exists_isAffineOpen_mem_and_subset (x := x) (U := ⊤) trivial
    haveI : IsNoetherianRing Γ(X, U) := IsLocallyNoetherian.component_noetherian ⟨U, hU⟩
    have hψ : (wcPlpChartMap f hU).Smooth := by
      have h : Smooth (Spec.map (Spec.preimage (hU.fromSpec ≫ f))) := by
        rw [Spec.map_preimage]; infer_instance
      rw [HasRingHomProperty.Spec_iff (P := @Smooth)] at h
      exact h
    have hcomap : ∀ (y : X) (hy : y ∈ U),
        (hU.primeIdealOf ⟨y, hy⟩).asIdeal.comap (wcPlpChartMap f hU) = (f y).asIdeal := by
      intro y hy
      let q : Spec Γ(X, U) := hU.primeIdealOf ⟨y, hy⟩
      have h1 : hU.fromSpec q = y := hU.fromSpec_primeIdealOf ⟨y, hy⟩
      have h2 : (hU.fromSpec ≫ f) q = f y := by
        rw [Scheme.Hom.comp_apply, h1]
      have h3 : (Spec.map (Spec.preimage (hU.fromSpec ≫ f))) q = f y := by
        rw [Spec.map_preimage]; exact h2
      rw [← h3]
      rfl
    have hle : ∀ (y z : X) (hy : y ∈ U) (hz : z ∈ U),
        (hU.primeIdealOf ⟨y, hy⟩).asIdeal ≤ (hU.primeIdealOf ⟨z, hz⟩).asIdeal ↔ y ⤳ z := by
      intro y z hy hz
      let qy : Spec Γ(X, U) := hU.primeIdealOf ⟨y, hy⟩
      let qz : Spec Γ(X, U) := hU.primeIdealOf ⟨z, hz⟩
      have h1 : hU.fromSpec qy = y := hU.fromSpec_primeIdealOf ⟨y, hy⟩
      have h2 : hU.fromSpec qz = z := hU.fromSpec_primeIdealOf ⟨z, hz⟩
      have e1 : (hU.primeIdealOf ⟨y, hy⟩).asIdeal ≤ (hU.primeIdealOf ⟨z, hz⟩).asIdeal ↔ qy ⤳ qz :=
        PrimeSpectrum.le_iff_specializes (hU.primeIdealOf ⟨y, hy⟩) (hU.primeIdealOf ⟨z, hz⟩)
      have e2 : hU.fromSpec qy ⤳ hU.fromSpec qz ↔ qy ⤳ qz :=
        hU.fromSpec.isOpenEmbedding.isInducing.specializes_iff
      rw [e1, ← e2, h1, h2]
    have hsurj : ∀ (Q : Ideal Γ(X, U)) (hQ : Q.IsPrime),
        ∃ (y : X) (hy : y ∈ U), (hU.primeIdealOf ⟨y, hy⟩).asIdeal = Q := by
      intro Q hQ
      let q : Spec Γ(X, U) := (⟨Q, hQ⟩ : PrimeSpectrum Γ(X, U))
      have hmem : hU.fromSpec q ∈ U := by
        have : hU.fromSpec q ∈ Set.range hU.fromSpec := ⟨q, rfl⟩
        rw [hU.range_fromSpec] at this
        exact this
      refine ⟨_, hmem, ?_⟩
      have h1 : hU.fromSpec (hU.primeIdealOf ⟨_, hmem⟩ : Spec Γ(X, U)) = hU.fromSpec q :=
        hU.fromSpec_primeIdealOf ⟨_, hmem⟩
      have h2 := hU.fromSpec.isOpenEmbedding.injective h1
      exact congrArg (fun t : Spec Γ(X, U) => t.asIdeal) h2
    have hbasic : ∀ (r : Γ(X, U)), r ∉ (hU.primeIdealOf ⟨x, hxU⟩).asIdeal → x ∈ X.basicOpen r := by
      intro r hr
      let q : Spec Γ(X, U) := hU.primeIdealOf ⟨x, hxU⟩
      have h1 : hU.fromSpec q = x := hU.fromSpec_primeIdealOf ⟨x, hxU⟩
      have h2 : q ∈ hU.fromSpec ⁻¹ᵁ X.basicOpen r := by
        rw [hU.fromSpec_preimage_basicOpen]
        exact hr
      rw [← h1]
      exact h2
    have hφfin : (Scheme.Hom.app ν U).hom.Finite := IsFinite.finite_app ν U hU
    have hφfp : (Scheme.Hom.app ν U).hom.FinitePresentation :=
      RingHom.FinitePresentation.of_finiteType.mp hφfin.finiteType
    obtain ⟨a, b, hA, hC⟩ := hdp U hU hxU
    haveI : (f x).asIdeal.IsPrime := (f x).isPrime
    have hEt : wcCg2LocEtale (Scheme.Hom.app ν U).hom
        (hU.primeIdealOf ⟨x, hxU⟩).asIdeal.primeCompl := by
      refine wc_plp_transcendence_reduction wc_plp_closed_point_purity A₀ Γ(X, U)
        Γ(N, ν ⁻¹ᵁ U) (wcPlpChartMap f hU) (Scheme.Hom.app ν U).hom hψ hφfin (f x).asIdeal
        (hU.primeIdealOf ⟨x, hxU⟩).asIdeal (hcomap x hxU) ⟨a, b, hA, hC⟩ ?_ ?_
      · intro Q _ hQle hQne
        obtain ⟨y, hy, hyQ⟩ := hsurj Q ‹_›
        subst hyQ
        have hyx : y ⤳ x := (hle y x hy hxU).mp hQle
        have hne : y ≠ x := by
          rintro rfl
          exact hQne rfl
        obtain ⟨W, hyW, hW⟩ := Hgen' y hyx hne
        exact wc_plp_loc_etale_of_etale_nbhd ν U hU y hy W hyW hW
      · obtain ⟨ξ, hξx, hξne, hfξ⟩ := Hfib
        have hξU : ξ ∈ U := hξx.mem_open U.isOpen hxU
        refine ⟨(hU.primeIdealOf ⟨ξ, hξU⟩).asIdeal, inferInstance,
          (hle ξ x hξU hxU).mpr hξx, ?_, ?_⟩
        · intro h
          have h2 : x ⤳ ξ := (hle x ξ hxU hξU).mp h.ge
          exact hξne (hξx.antisymm h2).eq
        · rw [hcomap ξ hξU, hfξ]
    obtain ⟨r, hr, hrEt⟩ := wc_fnteg_spread_etale (Scheme.Hom.app ν U).hom hφfin hφfp
      (hU.primeIdealOf ⟨x, hxU⟩).asIdeal.primeCompl hEt (hU.primeIdealOf ⟨x, hxU⟩).asIdeal
      (by
        rw [Set.disjoint_left]
        intro s hs hs'
        exact hs hs')
    exact ⟨X.basicOpen r, hbasic r hr, wc_fnteg_basicOpen_etale ν U hU r hrEt⟩

  have hirr := wc_pff_fibre_preirreducible A₀ X f hconn (f x)
  let Q : X → Prop := fun z => ∃ W : X.Opens, z ∈ W ∧ Etale (Scheme.Hom.fromNormalization
    (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) ∣_ W)
  have hpur' : ∀ z : X, 2 ≤ (f z).asIdeal.height → (∀ x' : X, x' ⤳ z → x' ≠ z → Q x') →
      (∃ ξ : X, ξ ⤳ z ∧ ξ ≠ z ∧ f ξ = f z) → Q z := hpur
  have H_lt' : ∀ x' : X, (f x').asIdeal < (f x).asIdeal → Q x' := H_lt
  obtain ⟨y, hyf, hyQ⟩ : ∃ y : X, f y = f x ∧ Q y := ⟨σ (f x), hfσ, hW0⟩
  show Q x
  have hQgen : ∀ z z' : X, z' ⤳ z → Q z → Q z' := by
    rintro z z' h ⟨W, hzW, hW⟩
    exact ⟨W, h.mem_open W.isOpen hzW, hW⟩
  have hfeq : ∀ (S : Set X) (z : X), z ∈ closure S → (∀ s ∈ S, f s = f x) →
      ∀ s ∈ S, z ⤳ s → f z = f x := by
    intro S z hz hS s hs hzs
    have h1 : f z ⤳ f x := by rw [← hS s hs]; exact hzs.map f.continuous
    have h2 : f x ⤳ f z := by
      rw [specializes_iff_mem_closure]
      have h4 : f '' closure S ⊆ closure (f '' S) := image_closure_subset_closure_image f.continuous
      have h3 : f '' S ⊆ {f x} := by
        rintro _ ⟨s', hs', rfl⟩
        exact hS s' hs'
      exact closure_mono h3 (h4 ⟨z, hz, rfl⟩)
    exact (h1.antisymm h2).eq
  have hFirr : IsIrreducible (f ⁻¹' {f x}) := ⟨⟨x, rfl⟩, hirr⟩
  obtain ⟨g₀, hg₀gen⟩ : ∃ g, IsGenericPoint g (closure (f ⁻¹' {f x})) :=
    ⟨_, hFirr.isGenericPoint_genericPoint_closure⟩
  have hg₀sp : ∀ z ∈ f ⁻¹' {f x}, g₀ ⤳ z := fun z hz => hg₀gen.specializes (subset_closure hz)
  have hg₀f : f g₀ = f x :=
    hfeq _ g₀ hg₀gen.mem (fun s hs => hs) x (show f x = f x from rfl)
      (hg₀sp x (show f x = f x from rfl))
  have hg₀Q : Q g₀ := hQgen y g₀ (hg₀sp y hyf) hyQ
  by_contra hxQ
  have hchain : ∀ c : Set {z : X // f z = f x ∧ ¬ Q z},
      IsChain (fun a b : {z : X // f z = f x ∧ ¬ Q z} => b.1 ⤳ a.1) c →
      ∃ ub : {z : X // f z = f x ∧ ¬ Q z}, ∀ a ∈ c, ub.1 ⤳ a.1 := by
    intro c hc
    by_cases hce : c.Nonempty
    · obtain ⟨a₀, ha₀⟩ := hce
      have hSpre : IsPreirreducible (Subtype.val '' c) := by
        rintro u v hu hv ⟨_, ⟨a, ha, rfl⟩, hau⟩ ⟨_, ⟨b, hb, rfl⟩, hbv⟩
        by_cases hab : a = b
        · subst hab
          exact ⟨a.1, ⟨a, ha, rfl⟩, hau, hbv⟩
        · rcases hc ha hb hab with h | h
          · exact ⟨b.1, ⟨b, hb, rfl⟩, h.mem_open hu hau, hbv⟩
          · exact ⟨a.1, ⟨a, ha, rfl⟩, hau, h.mem_open hv hbv⟩
      have hSirr : IsIrreducible (Subtype.val '' c) := ⟨⟨a₀.1, a₀, ha₀, rfl⟩, hSpre⟩
      have hgen := hSirr.isGenericPoint_genericPoint_closure
      have hsp : ∀ a ∈ c, hSirr.genericPoint ⤳ a.1 := fun a ha =>
        hgen.specializes (subset_closure ⟨a, ha, rfl⟩)
      have hf : f hSirr.genericPoint = f x :=
        hfeq _ _ hgen.mem (by rintro _ ⟨a, -, rfl⟩; exact a.2.1) a₀.1 ⟨a₀, ha₀, rfl⟩ (hsp a₀ ha₀)
      have hnQ : ¬ Q hSirr.genericPoint := by
        rintro ⟨W, hW, hWe⟩
        obtain ⟨_, haW, ⟨a, ha, rfl⟩⟩ := mem_closure_iff.mp hgen.mem W W.isOpen hW
        exact a.2.2 ⟨W, haW, hWe⟩
      exact ⟨⟨_, hf, hnQ⟩, fun a ha => hsp a ha⟩
    · exact ⟨⟨x, rfl, hxQ⟩, fun a ha => absurd ⟨a, ha⟩ hce⟩
  have htrans : ∀ {a b c : {z : X // f z = f x ∧ ¬ Q z}}, b.1 ⤳ a.1 → c.1 ⤳ b.1 → c.1 ⤳ a.1 :=
    fun hab hbc => hbc.trans hab
  obtain ⟨m, hm⟩ := exists_maximal_of_chains_bounded
    (r := fun a b : {z : X // f z = f x ∧ ¬ Q z} => b.1 ⤳ a.1) hchain htrans
  apply m.2.2
  apply hpur' m.1 (by rw [m.2.1]; exact hx)
  · intro x' hx'm hne
