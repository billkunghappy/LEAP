    have hsw : s.left ≫ U.hom = Spec.map (CommRingCat.ofHom e) ≫ wcEtGeomPt B b :=
      (Over.w s).trans hy.symm
    obtain ⟨tl, ⟨htl1, htl2⟩, huniq⟩ := s5g U.hom b M e s.left hsw
    refine ⟨Over.homMk (U := Over.mk (wcEtGeomPt B b)) (V := (Scheme.Etale.forget B).obj U)
      tl htl1, ?_, ?_⟩
    · exact Over.OverMorphism.ext htl2
    · intro t ht
      apply Over.OverMorphism.ext
      exact huniq t.left ⟨Over.w t, congrArg CommaMorphism.left ht⟩

  have s3 : ∀ {T : Scheme.{u}} (t : T ⟶ X),
      Nonempty (wcEtBaseChange g ⋙ Scheme.Etale.forget X ⋙ coyoneda.obj (Opposite.op (Over.mk t)) ≅
        Scheme.Etale.forget B ⋙ coyoneda.obj (Opposite.op (Over.mk (t ≫ g)))) := by
    intro T t
    have fwdw : ∀ (V : B.Etale) (h : Over.mk t ⟶ (Scheme.Etale.forget X).obj ((wcEtBaseChange g).obj V)),
        (h.left ≫ Limits.pullback.fst V.hom g) ≫ V.hom = t ≫ g := by
      intro V h
      have hw : h.left ≫ Limits.pullback.snd V.hom g = t := Over.w h
      calc (h.left ≫ Limits.pullback.fst V.hom g) ≫ V.hom
          = h.left ≫ (Limits.pullback.fst V.hom g ≫ V.hom) := Category.assoc _ _ _
        _ = h.left ≫ (Limits.pullback.snd V.hom g ≫ g) :=
            congrArg (fun q => h.left ≫ q) Limits.pullback.condition
        _ = (h.left ≫ Limits.pullback.snd V.hom g) ≫ g := (Category.assoc _ _ _).symm
        _ = t ≫ g := congrArg (fun q => q ≫ g) hw
    refine ⟨NatIso.ofComponents (fun V => Equiv.toIso
      { toFun := fun h => Over.homMk (U := Over.mk (t ≫ g)) (V := (Scheme.Etale.forget B).obj V)
          (h.left ≫ Limits.pullback.fst V.hom g) (fwdw V h)
        invFun := fun s => Over.homMk (U := Over.mk t)
          (V := (Scheme.Etale.forget X).obj ((wcEtBaseChange g).obj V))
          (Limits.pullback.lift s.left t (Over.w s)) (Limits.pullback.lift_snd _ _ _)
        left_inv := fun h => by
          apply Over.OverMorphism.ext
          show Limits.pullback.lift (h.left ≫ Limits.pullback.fst V.hom g) t (fwdw V h) = h.left
          apply Limits.pullback.hom_ext
          · exact Limits.pullback.lift_fst _ _ _
          · exact (Limits.pullback.lift_snd _ _ _).trans (Over.w h).symm
        right_inv := fun s => by
          apply Over.OverMorphism.ext
          show Limits.pullback.lift s.left t (Over.w s) ≫ Limits.pullback.fst V.hom g = s.left
          exact Limits.pullback.lift_fst _ _ _ }) ?_⟩
    intro V V' φ
    ext : 2
    funext h
    apply Over.OverMorphism.ext
    show (h.left ≫ ((wcEtBaseChange g).map φ).left) ≫ Limits.pullback.fst V'.hom g =
      (h.left ≫ Limits.pullback.fst V.hom g) ≫ φ.left
    have hn : ((wcEtBaseChange g).map φ).left ≫ Limits.pullback.fst V'.hom g =
        Limits.pullback.fst V.hom g ≫ φ.left := (wcEtBaseChangeFst g).naturality φ
    exact (Category.assoc _ _ _).trans ((congrArg (fun q => h.left ≫ q) hn).trans
      (Category.assoc _ _ _).symm)

  have s1 : Nonempty (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1} ⋙
      wcEtStalk X x ≅ (Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj
        (StructuredArrow.proj (Over.mk (wcEtGeomPt X x)) (Scheme.Etale.forget X)).op ⋙
        Limits.colim) := by
    have hliftgen : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] {V U : Scheme.{u}} (e : V ⟶ U)
        [Etale e] (s : Spec (.of Ω) ⟶ U) (v : V), e v = s (IsLocalRing.closedPoint Ω) →
        ∃ t : Spec (.of Ω) ⟶ V, t ≫ e = s := by
      intro Ω _ _ V U e _ s v hv
      have hs : s = Spec.map (Scheme.SpecToEquivOfField Ω U s).2 ≫
          U.fromSpecResidueField (Scheme.SpecToEquivOfField Ω U s).1 := by
        rw [← Scheme.SpecToEquivOfField_symm_apply, Equiv.symm_apply_apply]
      have h1 : (Scheme.SpecToEquivOfField Ω U s).1 = s (IsLocalRing.closedPoint Ω) := rfl
      generalize Scheme.SpecToEquivOfField Ω U s = p at hs h1
      obtain ⟨w, φ⟩ := p
      simp only at hs h1
      rw [← h1] at hv
      subst hv
      letI : Algebra (U.residueField (e v)) (V.residueField v) := (e.residueFieldMap v).hom.toAlgebra
      haveI : Algebra.IsSeparable (U.residueField (e v)) (V.residueField v) := inferInstance
      haveI : Algebra.IsAlgebraic (U.residueField (e v)) (V.residueField v) :=
        Algebra.IsSeparable.isAlgebraic _ _
      letI : Algebra (U.residueField (e v)) Ω := φ.hom.toAlgebra
      let χ₀ : V.residueField v →ₐ[U.residueField (e v)] Ω :=
        IsAlgClosed.lift (R := U.residueField (e v)) (S := V.residueField v) (M := Ω)
      let χ : V.residueField v ⟶ CommRingCat.of Ω := CommRingCat.ofHom χ₀.toRingHom
      have hχ : e.residueFieldMap v ≫ χ = φ := by
        ext r
        exact χ₀.commutes r
      refine ⟨Spec.map χ ≫ V.fromSpecResidueField v, ?_⟩
      rw [Category.assoc, ← Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField,
        ← Category.assoc, ← Spec.map_comp, hχ, hs]
    let X₀ : Over X := Over.mk (wcEtGeomPt X x)
    let F : X.Etale ⥤ Type (u+1) :=
      Scheme.Etale.forget X ⋙ coyoneda.obj (Opposite.op X₀) ⋙ uliftFunctor.{u+1}
    let G : StructuredArrow X₀ (Scheme.Etale.forget X) ⥤ F.Elements :=
      { obj := fun A => Functor.elementsMk F A.right (ULift.up A.hom)
        map := fun {A A'} φ => Functor.Elements.homMk φ.right
          (congrArg ULift.up (StructuredArrow.w φ))
        map_id := by intros; rfl
        map_comp := by intros; rfl }
    haveI : G.Faithful := ⟨fun {A A'} φ ψ h => StructuredArrow.hom_ext φ ψ (by
      have h' := congrArg Functor.Elements.Hom.hom h
      exact h')⟩
    haveI : G.Full := ⟨fun {A A'} f =>
      ⟨StructuredArrow.homMk f.hom (congrArg ULift.down f.map_val), rfl⟩⟩
    haveI : G.EssSurj := ⟨fun Y => ⟨StructuredArrow.mk (Y := Y.obj) Y.val.down, ⟨Iso.refl _⟩⟩⟩
    haveI : G.IsEquivalence := { }
    haveI : IsCofiltered (StructuredArrow X₀ (Scheme.Etale.forget X)) :=
      IsCofiltered.of_hasFiniteLimits _
    haveI : IsCofiltered F.Elements := IsCofiltered.of_equivalence G.asEquivalence
    haveI : InitiallySmall.{u+1} F.Elements := initiallySmall_of_essentiallySmall.{u+1} F.Elements
    have hjs : ∀ {V : X.Etale} (R : Sieve V), R ∈ Scheme.smallEtaleTopology X V →
        ∀ y : F.obj V, ∃ (Y : X.Etale) (f : Y ⟶ V) (_ : R.arrows f) (z : F.obj Y), F.map f z = y := by
      intro V R hR y
      have e := @Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology (@Etale) (@Etale)
          X MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl
      have hR' := (@Scheme.mem_toGrothendieck_smallPretopology (@Etale) (@Etale) X
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ V R).mp
          (by rw [← e]; exact hR)
      obtain ⟨Y, f, z, hRf, hEt, hz⟩ :=
        hR' (y.down.left (IsLocalRing.closedPoint (AlgebraicClosure (X.residueField x))))
      haveI : Etale f.left := hEt
      obtain ⟨t', ht'⟩ := hliftgen (AlgebraicClosure (X.residueField x)) f.left y.down.left z hz
      have hw : t' ≫ Y.hom = wcEtGeomPt X x := by
        rw [← MorphismProperty.Over.w f, ← Category.assoc, ht']
        exact Over.w y.down
      refine ⟨Y, f, hRf, ULift.up (Over.homMk (U := X₀) (V := (Scheme.Etale.forget X).obj Y) t' hw), ?_⟩
      apply ULift.ext
      apply Over.OverMorphism.ext
      exact ht'
    let Φ : (Scheme.smallEtaleTopology X).Point.{u+1} :=
      { fiber := F
        jointly_surjective := hjs }
    haveI : G.op.Final := inferInstance
    let α : (Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj
        (StructuredArrow.proj (Over.mk (wcEtGeomPt X x)) (Scheme.Etale.forget X)).op ⋙ Limits.colim ≅
        Φ.presheafFiber (A := AddCommGrpCat.{u+1}) :=
      Functor.isoWhiskerRight (Functor.whiskeringLeftObjCompIso (E := AddCommGrpCat.{u+1}) G.op
          (Functor.Elements.π F).op) Limits.colim ≪≫
        Functor.associator _ _ _ ≪≫
        Functor.isoWhiskerLeft _ (Functor.Final.colimIso G.op (E := AddCommGrpCat.{u+1}))
    exact ⟨Functor.isoWhiskerLeft (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1} ⋙
        sheafToPresheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) α ≪≫
      Functor.isoWhiskerLeft (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1})
        (Φ.sheafToPresheafCompPresheafFiberIso (A := AddCommGrpCat.{u+1})) ≪≫
      Φ.presheafToSheafCompSheafFiberIso AddCommGrpCat.{u+1} ≪≫ α.symm⟩

  obtain ⟨σ1⟩ := s1
  obtain ⟨σA1⟩ := pA (Scheme.Etale.forget X) (Over.mk (wcEtGeomPt X x))
  obtain ⟨σB⟩ := pB (wcEtBaseChange g) (Scheme.Etale.forget X)
  obtain ⟨σA2⟩ := pA (wcEtBaseChange g ⋙ Scheme.Etale.forget X) (Over.mk (wcEtGeomPt X x))
  obtain ⟨θ⟩ := s3 (wcEtGeomPt X x)
  obtain ⟨σT⟩ := pT (wcEtBaseChange g ⋙ Scheme.Etale.forget X) (Scheme.Etale.forget B)
    (Over.mk (wcEtGeomPt X x)) (Over.mk (wcEtGeomPt X x ≫ g)) θ
  obtain ⟨e, he⟩ := s6
  obtain ⟨σM⟩ := pM (Scheme.Etale.forget B) (Over.mk (wcEtGeomPt X x ≫ g))
    (Over.mk (wcEtGeomPt B (g x)))
    (Over.homMk (U := Over.mk (wcEtGeomPt X x ≫ g)) (V := Over.mk (wcEtGeomPt B (g x)))
      (Spec.map (CommRingCat.ofHom e)) he)
    (fun U s => s5 (g x) (AlgebraicClosure (X.residueField x)) e (wcEtGeomPt X x ≫ g) he U s)
  let PB := sheafToPresheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}
  let LL := (wcEtBaseChange g).op.lan (H := AddCommGrpCat.{u+1})
  exact ⟨Functor.isoWhiskerLeft (PB ⋙ LL) σ1 ≪≫
    Functor.isoWhiskerLeft (PB ⋙ LL) σA1 ≪≫
    Functor.isoWhiskerLeft PB (Functor.isoWhiskerRight σB _) ≪≫
    Functor.isoWhiskerLeft PB σA2.symm ≪≫
    Functor.isoWhiskerLeft PB σT ≪≫
    Functor.isoWhiskerLeft PB σM⟩

theorem wc_et_open_imm_push_counit_isIso : ∀ {W U : Scheme.{u}} (j' : W ⟶ U) [IsOpenImmersion j'] (adj : wcQmInv j' ⊣ wcEtPush j'), IsIso adj.counit :=
by
  intro W U j' _ adj

  have hSurj : ∀ (Y : Scheme.{u}) (V : Y.Etale) (R : Sieve V), R ∈ Scheme.smallEtaleTopology Y V →
      ∀ y : V.left, ∃ (V₁ : Y.Etale) (c : V₁ ⟶ V) (w : V₁.left), R.arrows c ∧ c.left w = y := by
    intro Y V R hR y
    change R ∈ Scheme.smallGrothendieckTopology @Etale Y V at hR
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hR
    obtain ⟨V₁, c, w, hc, -, hw⟩ := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ V R).mp hR y
    exact ⟨V₁, c, w, hc, hw⟩
  have hCov : ∀ (Y : Scheme.{u}) (V : Y.Etale) (R : Sieve V), (∀ v : V.left, ∃ (V₁ : Y.Etale)
      (c : V₁ ⟶ V), R.arrows c ∧ v ∈ Set.range c.left) → R ∈ Scheme.smallEtaleTopology Y V := by
    intro Y V R hR
    change R ∈ Scheme.smallGrothendieckTopology @Etale Y V
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
    apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
    intro x
    obtain ⟨V₁, c, hc, y, hy⟩ := hR x
    have hw : c.left ≫ V.hom = V₁.hom := MorphismProperty.Over.w c
    have hEt : Etale c.left := by
      have h1 : Etale V.hom := V.prop
      have h2 : Etale (c.left ≫ V.hom) := by rw [hw]; exact V₁.prop
      exact Etale.of_comp c.left V.hom
    exact ⟨V₁, c, y, hc, hEt, hy⟩

  have hcontB : ∀ {X B : Scheme.{u}} (g : X ⟶ B), (wcEtBaseChange g).IsContinuous
      (Scheme.smallEtaleTopology B) (Scheme.smallEtaleTopology X) := by
    have hcov : ∀ {X B : Scheme.{u}} (g : X ⟶ B), CoverPreserving (Scheme.smallEtaleTopology B)
        (Scheme.smallEtaleTopology X) (wcEtBaseChange g) := by
      intro X B g
      constructor
      intro V S hS
      change S ∈ Scheme.smallGrothendieckTopology @Etale B V at hS
      rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale B
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hS
      have hS' := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale B
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mp hS
      apply hCov
      intro v
      obtain ⟨W, a, w, ha, -, hw⟩ := hS' (Limits.pullback.fst V.hom g v)
      refine ⟨(wcEtBaseChange g).obj W, (wcEtBaseChange g).map a,
        Sieve.image_mem_functorPushforward (wcEtBaseChange g) S ha, ?_⟩
      have h0 : (Limits.pullback.fst W.hom g ≫ a.left) ≫ V.hom =
          Limits.pullback.snd W.hom g ≫ g := by
        rw [Category.assoc, MorphismProperty.Over.w a]
        exact Limits.pullback.condition
      let m : Limits.pullback W.hom g ⟶ Limits.pullback V.hom g :=
        Limits.pullback.lift (Limits.pullback.fst W.hom g ≫ a.left) (Limits.pullback.snd W.hom g) h0
      have hmap : ((wcEtBaseChange g).map a).left = m := rfl
      have h1 : Limits.pullback.fst a.left (Limits.pullback.fst V.hom g) ≫ W.hom =
          (Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) ≫
            Limits.pullback.snd V.hom g) ≫ g := by
        rw [← MorphismProperty.Over.w a, ← Category.assoc, Limits.pullback.condition,
          Category.assoc, Limits.pullback.condition, Category.assoc]
      let ψ : Limits.pullback a.left (Limits.pullback.fst V.hom g) ⟶ Limits.pullback W.hom g :=
        Limits.pullback.lift (Limits.pullback.fst a.left (Limits.pullback.fst V.hom g))
          (Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) ≫
            Limits.pullback.snd V.hom g) h1
      have hψ : ψ ≫ m = Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) := by
        apply Limits.pullback.hom_ext
        · rw [Category.assoc, Limits.pullback.lift_fst, ← Category.assoc,
            Limits.pullback.lift_fst, Limits.pullback.condition]
        · rw [Category.assoc, Limits.pullback.lift_snd, Limits.pullback.lift_snd]
      obtain ⟨z, hz⟩ : ∃ z, Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) z = v := by
        have hv : (v : ↥(Limits.pullback V.hom g)) ∈
            Set.range (Limits.pullback.snd a.left (Limits.pullback.fst V.hom g)) := by
          rw [Scheme.Pullback.range_snd]
          exact ⟨w, hw⟩
        exact hv
      rw [hmap]
      exact ⟨ψ z, (Scheme.Hom.comp_apply ψ m z).symm.trans (by rw [hψ]; exact hz)⟩
    intro X B g
    let Φ := wcEtBaseChange g
    haveI h1 : Limits.PreservesFiniteLimits Φ := ⟨fun J _ _ =>
      haveI : Limits.PreservesLimitsOfShape J (wcEtBaseChange g ⋙ Scheme.Etale.forget X) :=
        Limits.preservesLimitsOfShape_of_natIso
          (NatIso.ofComponents (fun _ => Iso.refl _) (fun _ => rfl) :
            Scheme.Etale.forget B ⋙ Over.pullback g ≅ wcEtBaseChange g ⋙ Scheme.Etale.forget X)
      Limits.preservesLimitsOfShape_of_reflects_of_preserves (wcEtBaseChange g)
        (Scheme.Etale.forget X)⟩
    haveI := flat_of_preservesFiniteLimits Φ
    exact Functor.isContinuous_of_coverPreserving (compatiblePreservingOfFlat _ _) (hcov g)

  let T : U.Etale := MorphismProperty.Over.mk ⊤ j' (inferInstance : Etale j')
  haveI hT : Etale T.hom := T.prop
  haveI hTm : Mono T.hom := (inferInstance : Mono j')

  have hcovS : CoverPreserving (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology U)
      (wcEtSlice T) := by
    refine CoverPreserving.mk (fun {V} {R} hR => ?_)
    apply hCov
    intro v
    obtain ⟨V₁, c, w, hc, hw⟩ := hSurj T.left V R hR v
    exact ⟨(wcEtSlice T).obj V₁, (wcEtSlice T).map c, ⟨V₁, c, 𝟙 _, hc, (Category.id_comp _).symm⟩,
      ⟨w, hw⟩⟩
  have hcompS : CompatiblePreserving.{u+1} (Scheme.smallEtaleTopology U) (wcEtSlice T) := by
    apply CompatiblePreserving.mk
    intro ℱ Z T' x hx Y₁ Y₂ X f₁ f₂ g₁ g₂ hg₁ hg₂ hfg
    have hw : (f₁.left ≫ Y₁.hom) ≫ T.hom = X.hom :=
      (Category.assoc _ _ _).trans (MorphismProperty.Over.w f₁)
    haveI : Etale ((f₁.left ≫ Y₁.hom) ≫ T.hom) := hw ▸ X.prop
    haveI : Etale (f₁.left ≫ Y₁.hom) := Etale.of_comp _ T.hom
    let X' : T.left.Etale := MorphismProperty.Over.mk ⊤ (f₁.left ≫ Y₁.hom) ‹_›
    have hleft : f₁.left ≫ g₁.left = f₂.left ≫ g₂.left :=
      congrArg (fun k => k.left) hfg
    have h2 : f₂.left ≫ Y₂.hom = f₁.left ≫ Y₁.hom := by
      have e1 : Y₁.hom = g₁.left ≫ Z.hom := (MorphismProperty.Over.w g₁).symm
      have e2 : Y₂.hom = g₂.left ≫ Z.hom := (MorphismProperty.Over.w g₂).symm
      calc f₂.left ≫ Y₂.hom = (f₂.left ≫ g₂.left) ≫ Z.hom :=
            (congrArg (f₂.left ≫ ·) e2).trans (Category.assoc _ _ _).symm
        _ = (f₁.left ≫ g₁.left) ≫ Z.hom := congrArg (· ≫ Z.hom) hleft.symm
        _ = f₁.left ≫ Y₁.hom :=
            (Category.assoc _ _ _).trans (congrArg (f₁.left ≫ ·) e1.symm)
    let f₁' : X' ⟶ Y₁ := MorphismProperty.Over.homMk f₁.left rfl trivial
    let f₂' : X' ⟶ Y₂ := MorphismProperty.Over.homMk f₂.left h2 trivial
    let e : X ⟶ (wcEtSlice T).obj X' :=
      MorphismProperty.Over.homMk (𝟙 _) ((Category.id_comp _).trans hw) trivial
    have hf₁ : f₁ = e ≫ (wcEtSlice T).map f₁' := by
      apply MorphismProperty.Over.Hom.ext
      exact (Category.id_comp _).symm
    have hf₂ : f₂ = e ≫ (wcEtSlice T).map f₂' := by
      apply MorphismProperty.Over.Hom.ext
      exact (Category.id_comp _).symm
    have hsq : f₁' ≫ g₁ = f₂' ≫ g₂ := by
      apply MorphismProperty.Over.Hom.ext
      exact hleft
    have hc := hx f₁' f₂' hg₁ hg₂ hsq
    rw [hf₁, hf₂]
    simp only [Functor.map_comp, op_comp]
    rw [ConcreteCategory.comp_apply, ConcreteCategory.comp_apply]
    exact congrArg _ hc
  haveI hc : (wcEtSlice T).IsContinuous (Scheme.smallEtaleTopology T.left)
      (Scheme.smallEtaleTopology U) :=
    Functor.isContinuous_of_coverPreserving hcompS hcovS
  haveI hb : (wcEtBaseChange T.hom).IsContinuous (Scheme.smallEtaleTopology U)
      (Scheme.smallEtaleTopology T.left) := hcontB T.hom

  have adjS : wcEtSlice T ⊣ wcEtBaseChange T.hom := by
    letI : MorphismProperty.HasPullbacksAlong (@Etale : MorphismProperty Scheme.{u}) T.hom :=
      ⟨fun _ _ => inferInstance⟩
    letI : MorphismProperty.IsStableUnderBaseChangeAlong (@Etale : MorphismProperty Scheme.{u})
        T.hom :=
      (fun (P : MorphismProperty Scheme.{u}) [P.IsStableUnderBaseChange] =>
        (inferInstance : P.IsStableUnderBaseChangeAlong T.hom)) (@Etale : MorphismProperty Scheme.{u})
    exact @MorphismProperty.Over.mapPullbackAdj Scheme.{u} _ @Etale ⊤ _ _ _
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ T.hom _ _ _ T.prop trivial

  have θ : wcEtSlice T ⋙ wcEtBaseChange T.hom ≅ 𝟭 T.left.Etale := by
    refine NatIso.ofComponents (fun V => MorphismProperty.Over.isoMk
      (@asIso _ _ _ _ (Limits.pullback.fst (V.hom ≫ T.hom) T.hom)
        (Limits.pullback_snd_iso_of_left_factors_mono V.hom T.hom)) ?_) ?_
    · show Limits.pullback.fst (V.hom ≫ T.hom) T.hom ≫ V.hom =
        Limits.pullback.snd (V.hom ≫ T.hom) T.hom
      rw [← cancel_mono T.hom, Category.assoc]
      exact Limits.pullback.condition
    · intro V₁ V₂ a
      apply MorphismProperty.Over.Hom.ext
      show Limits.pullback.lift (Limits.pullback.fst (V₁.hom ≫ T.hom) T.hom ≫ a.left)
          (Limits.pullback.snd (V₁.hom ≫ T.hom) T.hom) _ ≫
          Limits.pullback.fst (V₂.hom ≫ T.hom) T.hom =
        Limits.pullback.fst (V₁.hom ≫ T.hom) T.hom ≫ a.left
      exact Limits.pullback.lift_fst _ _ _

  haveI hcomp : (wcEtSlice T ⋙ wcEtBaseChange T.hom).IsContinuous
      (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology T.left) :=
    Functor.isContinuous_comp _ _ _ (Scheme.smallEtaleTopology U) _
  haveI hid : (𝟭 T.left.Etale).IsContinuous (Scheme.smallEtaleTopology T.left)
      (Scheme.smallEtaleTopology T.left) := Functor.isContinuous_id _
  let adjSh := adjS.sheafPushforwardContinuous (E := AddCommGrpCat.{u+1})
    (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology U)
  let ι : (wcEtBaseChange T.hom).sheafPushforwardContinuous AddCommGrpCat.{u+1}
        (Scheme.smallEtaleTopology U) (Scheme.smallEtaleTopology T.left) ⋙
      (wcEtSlice T).sheafPushforwardContinuous AddCommGrpCat.{u+1}
        (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology U) ≅ 𝟭 _ :=
    Functor.sheafPushforwardContinuousComp _ _ _ _ _ _ ≪≫
      Functor.sheafPushforwardContinuousIso θ _ _ _ ≪≫
      Functor.sheafPushforwardContinuousId _ _
  let hff := adjSh.fullyFaithfulROfCompIsoId ι
  let e : (wcEtBaseChange T.hom).sheafPushforwardContinuous AddCommGrpCat.{u+1}
      (Scheme.smallEtaleTopology U) (Scheme.smallEtaleTopology T.left) ≅ wcEtPush T.hom :=
    (Functor.rightUnitor _).symm ≪≫
      Functor.isoWhiskerLeft _ (sheafificationNatIso _ _) ≪≫
      (Functor.associator _ _ _).symm ≪≫
      Functor.isoWhiskerRight
        ((wcEtBaseChange T.hom).sheafPushforwardContinuousCompSheafToPresheafIso _ _ _) _ ≪≫
      Functor.associator _ _ _
  let hff' : (wcEtPush j').FullyFaithful := hff.ofIso e
  exact @Adjunction.counit_isIso_of_R_fully_faithful _ _ _ _ _ _ adj hff'.full hff'.faithful

theorem wc_qm_open_imm_transpose_stalk_bij : ∀ {W U : Scheme.{u}} (j' : W ⟶ U) [IsOpenImmersion j'] (adj : wcQmInv j' ⊣ wcEtPush j') (K : CochainComplex (Sheaf (Scheme.smallEtaleTopology U) AddCommGrpCat.{u+1}) ℕ) (L : CochainComplex (Sheaf (Scheme.smallEtaleTopology W) AddCommGrpCat.{u+1}) ℕ) (χ : ((wcQmInv j').mapHomologicalComplex (ComplexShape.up ℕ)).obj K ⟶ L), QuasiIso χ → ∀ (φ : K ⟶ ((wcEtPush j').mapHomologicalComplex (ComplexShape.up ℕ)).obj L), (∀ k, φ.f k = (adj.homEquiv _ _) (χ.f k)) → ∀ (w : W) (q : ℕ), Function.Bijective ((wcEtStalk U (j' w)).map (HomologicalComplex.homologyMap φ q)).hom :=
by
  intro W U j' _ adj K L χ hχ φ hφ w q
  obtain ⟨α₀⟩ := wc_qm_inv_stalk j' w
  obtain ⟨hSl₀, hSc₀⟩ := wc_et_stalk_exact U (j' w)
  obtain ⟨hTl₀, hTc₀⟩ := wc_et_stalk_exact W w
  have hε : IsIso adj.counit := wc_et_open_imm_push_counit_isIso j' adj

  have key : ∀ (S : Sheaf (Scheme.smallEtaleTopology U) AddCommGrpCat.{u+1} ⥤ AddCommGrpCat.{u+1})
      (T : Sheaf (Scheme.smallEtaleTopology W) AddCommGrpCat.{u+1} ⥤ AddCommGrpCat.{u+1}),
      Limits.PreservesFiniteLimits S → Limits.PreservesFiniteColimits S →
      Limits.PreservesFiniteLimits T → Limits.PreservesFiniteColimits T →
      (wcQmInv j' ⋙ T ≅ S) → IsIso (S.map (HomologicalComplex.homologyMap φ q)) := by
    intro S T hSl hSc hTl hTc α
    have : S.PreservesZeroMorphisms :=
      Functor.preservesZeroMorphisms_of_preserves_terminal_object
    have : T.PreservesZeroMorphisms :=
      Functor.preservesZeroMorphisms_of_preserves_terminal_object
    have : S.PreservesHomology := Functor.preservesHomologyOfExact S
    have : T.PreservesHomology := Functor.preservesHomologyOfExact T
    have : T.Additive := Functor.additive_of_preserves_binary_products T

    let uK : K ⟶ ((wcEtPush j').mapHomologicalComplex (ComplexShape.up ℕ)).obj
        (((wcQmInv j').mapHomologicalComplex (ComplexShape.up ℕ)).obj K) :=
      { f := fun k => adj.unit.app (K.X k)
        comm' := fun i k _ => by
          first
          | exact adj.unit_naturality (K.d i k)
          | (simp only [Functor.mapHomologicalComplex_obj_d]; exact adj.unit_naturality (K.d i k)) }

    have hfac : φ = uK ≫ ((wcEtPush j').mapHomologicalComplex (ComplexShape.up ℕ)).map χ := by
      apply HomologicalComplex.hom_ext
      intro k
      rw [hφ k, Adjunction.homEquiv_unit]
      rfl

    have hSη : ∀ M, IsIso (S.map (adj.unit.app M)) := by
      intro M
      have h1 : IsIso ((wcQmInv j').map (adj.unit.app M)) := by
        have htri := adj.left_triangle_components M
        have : IsIso ((wcQmInv j').map (adj.unit.app M) ≫ adj.counit.app ((wcQmInv j').obj M)) := by
          rw [htri]; exact IsIso.id _
        exact IsIso.of_isIso_comp_right _ (adj.counit.app ((wcQmInv j').obj M))
      have h3 : α.hom.app M ≫ S.map (adj.unit.app M) =
          T.map ((wcQmInv j').map (adj.unit.app M)) ≫ α.hom.app _ :=
        (α.hom.naturality (adj.unit.app M)).symm
      have : IsIso (T.map ((wcQmInv j').map (adj.unit.app M))) := Functor.map_isIso T _
      have : IsIso (α.hom.app M ≫ S.map (adj.unit.app M)) := by
        rw [h3]
        infer_instance
      exact IsIso.of_isIso_comp_left (α.hom.app M) _
    have : ∀ n, IsIso (((S.mapHomologicalComplex (ComplexShape.up ℕ)).map uK).f n) :=
      fun n => hSη (K.X n)
    have : IsIso ((S.mapHomologicalComplex (ComplexShape.up ℕ)).map uK) :=
      HomologicalComplex.Hom.isIso_of_components _

    let β : wcEtPush j' ⋙ S ≅ T :=
      Functor.isoWhiskerLeft (wcEtPush j') α.symm ≪≫ (Functor.associator _ _ _).symm ≪≫
        Functor.isoWhiskerRight (asIso adj.counit) T ≪≫ Functor.leftUnitor T
    let e₂ : ∀ X : CochainComplex (Sheaf (Scheme.smallEtaleTopology W) AddCommGrpCat.{u+1}) ℕ,
        (S.mapHomologicalComplex (ComplexShape.up ℕ)).obj
          (((wcEtPush j').mapHomologicalComplex (ComplexShape.up ℕ)).obj X) ≅
        (T.mapHomologicalComplex (ComplexShape.up ℕ)).obj X := fun X =>
      HomologicalComplex.Hom.isoOfComponents (fun k => β.app (X.X k))
        (by intro i j _; exact (β.hom.naturality (X.d i j)).symm)

    have he : (S.mapHomologicalComplex (ComplexShape.up ℕ)).map
        (((wcEtPush j').mapHomologicalComplex (ComplexShape.up ℕ)).map χ) =
        (e₂ _).hom ≫ (T.mapHomologicalComplex (ComplexShape.up ℕ)).map χ ≫ (e₂ L).inv := by
      apply HomologicalComplex.hom_ext
      intro k
      rw [HomologicalComplex.comp_f, HomologicalComplex.comp_f]
      exact (NatIso.naturality_2 β (χ.f k)).symm
    have : QuasiIso ((T.mapHomologicalComplex (ComplexShape.up ℕ)).map χ) :=
      HomologicalComplex.quasiIso_map_of_preservesHomology χ T
    have : QuasiIso ((S.mapHomologicalComplex (ComplexShape.up ℕ)).map
        (((wcEtPush j').mapHomologicalComplex (ComplexShape.up ℕ)).map χ)) := by
      rw [he]; infer_instance

    have hQ : QuasiIso ((S.mapHomologicalComplex (ComplexShape.up ℕ)).map φ) := by
      rw [hfac, Functor.map_comp]; infer_instance
    have h1 : IsIso (HomologicalComplex.homologyMap
        ((S.mapHomologicalComplex (ComplexShape.up ℕ)).map φ) q) := by
      rw [← quasiIsoAt_iff_isIso_homologyMap]
      exact (quasiIso_iff _).mp hQ q

    have hnat : HomologicalComplex.homologyMap
          ((S.mapHomologicalComplex (ComplexShape.up ℕ)).map φ) q ≫
