  have HF : ∀ (x : Spec (.of (Polynomial C))), (∀ x' : Spec (.of (Polynomial C)), Spec.map (CommRingCat.ofHom (algebraMap C (Polynomial C))) x' = Spec.map (CommRingCat.ofHom (algebraMap C (Polynomial C))) x → x ⤳ x' → x' = x) → ∀ (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (Polynomial C))) x)) (Scheme.Etale.forget (Spec (.of (Polynomial C))))) (φ : ∀ l, Spec (.of B) ⟶ (W'.obj l).right.left) (a : Spec (.of B) ⟶ Spec (.of (Polynomial C))), wcHalShData x B Λ W' φ a → ∀ (A' : Type u) [CommRing A'] [HenselianLocalRing A'] [IsSepClosed (IsLocalRing.ResidueField A')] (Λy : Type u) [SmallCategory Λy] [IsCofiltered Λy] (Wy : Λy ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of C)) (Spec.map (CommRingCat.ofHom (algebraMap C (Polynomial C))) x))) (Scheme.Etale.forget (Spec (.of C)))) (φy : ∀ l, Spec (.of A') ⟶ (Wy.obj l).right.left) (b : Spec (.of A') ⟶ Spec (.of C)), wcHalShData (Spec.map (CommRingCat.ofHom (algebraMap C (Polynomial C))) x) A' Λy Wy φy b → ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (z : Spec (.of Ω) ⟶ Spec (.of C)), ∃ c₀ : Spec (.of B) ⟶ Spec (.of A'), c₀ ≫ b = a ≫ Spec.map (CommRingCat.ofHom (algebraMap C (Polynomial C))) ∧ ∀ (τ : Limits.pullback a (Limits.pullback.fst (Spec.map (CommRingCat.ofHom (algebraMap C (Polynomial C)))) z) ⟶ Limits.pullback b z), τ ≫ Limits.pullback.fst b z = Limits.pullback.fst a (Limits.pullback.fst (Spec.map (CommRingCat.ofHom (algebraMap C (Polynomial C)))) z) ≫ c₀ → τ ≫ Limits.pullback.snd b z = Limits.pullback.snd a (Limits.pullback.fst (Spec.map (CommRingCat.ofHom (algebraMap C (Polynomial C)))) z) ≫ Limits.pullback.snd (Spec.map (CommRingCat.ofHom (algebraMap C (Polynomial C)))) z → ∀ p : ↥(Limits.pullback b z), Nat.card (wcEtCoh (Limits.pullback τ ((Limits.pullback b z).fromSpecResidueField p)) ℓ 0) = ℓ := by
