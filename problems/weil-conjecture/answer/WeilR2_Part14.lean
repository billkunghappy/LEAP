        exact mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal _).mp hz) (hbu.map _)
  have hq'eQ : Spec.map (CommRingCat.ofHom τ') ≫ Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {β (MvPolynomial.X none)}))) = Spec.map (CommRingCat.ofHom eB') ≫ Spec.map (CommRingCat.ofHom (IsLocalRing.residue B)) := by
    rw [← Spec.map_comp, ← Spec.map_comp, ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp, hτ', hτ]
  have hq'φ : ∀ l, Spec.map (CommRingCat.ofHom τ') ≫ Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {β (MvPolynomial.X none)}))) ≫ φ l = (W'.obj l).hom.left := by
    intro l
    rw [← Category.assoc, hq'eQ, Category.assoc]
    exact heB' l

  have hfac : ∀ g : Spec (.of B₀) ⟶ Spec (.of B), g ≫ a = a₀ ≫ Spec.map (CommRingCat.ofHom I0.toRingHom) → ∃ ε : Spec (.of B₀) ⟶ Spec (.of (B ⧸ Ideal.span {β (MvPolynomial.X none)})), ε ≫ Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {β (MvPolynomial.X none)}))) = g := by
    intro g hg
    rw [← hβ] at hg
    obtain ⟨gs, hgs⟩ : ∃ gs, Spec.map gs = g := ⟨_, Spec.map_preimage g⟩
    obtain ⟨hs, hhs⟩ : ∃ hs, Spec.map hs = a₀ := ⟨_, Spec.map_preimage a₀⟩
    have hring : CommRingCat.ofHom β ≫ gs = CommRingCat.ofHom I0.toRingHom ≫ hs := by
      apply Spec.map_injective
      rw [Spec.map_comp, Spec.map_comp, hgs, hhs]
      exact hg
    have hzero : gs.hom (β (MvPolynomial.X none)) = 0 := by
      have h2 : gs.hom (β (MvPolynomial.X none)) = hs.hom (I0.toRingHom (MvPolynomial.X none)) :=
        congrArg (fun f => f.hom (MvPolynomial.X none)) hring
      rw [h2]
      exact (congrArg hs.hom hX0).trans (map_zero hs.hom)
    have hker : ∀ x ∈ Ideal.span {β (MvPolynomial.X none)}, gs.hom x = 0 := by
      intro x hx
      obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp hx
      rw [map_mul, hzero, mul_zero]
    refine ⟨Spec.map (CommRingCat.ofHom (Ideal.Quotient.lift _ gs.hom hker)), ?_⟩
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, Ideal.Quotient.lift_comp_mk, CommRingCat.ofHom_hom, hgs]

  obtain ⟨θ, hθ⟩ := C5 (Spec.map (CommRingCat.ofHom I0.toRingHom)) y₀ B Λ W' φ a ha B₀ Λ₀ W₀ φ₀ a₀ hB₀
    (B ⧸ Ideal.span {β (MvPolynomial.X none)})
    (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {β (MvPolynomial.X none)}))))
    _ hc e he (Spec.map (CommRingCat.ofHom τ')) hq'pt hq'φ hfac

  refine ⟨θ, ?_⟩
  have hf1 : Spec.map (CommRingCat.ofHom (β.comp (algebraMap A (MvPolynomial (Option (Fin d)) A)))) =
      a ≫ Spec.map (CommRingCat.ofHom (algebraMap A (MvPolynomial (Option (Fin d)) A))) := by
    rw [← hβ, ← Spec.map_comp, ← CommRingCat.ofHom_comp]
  have hf0 : Spec.map (CommRingCat.ofHom (algebraMap A (MvPolynomial (Fin d) A))) =
      Spec.map (CommRingCat.ofHom I0.toRingHom) ≫
        Spec.map (CommRingCat.ofHom (algebraMap A (MvPolynomial (Option (Fin d)) A))) := by
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
    congr 2
    exact (AlgHom.comp_algebraMap I0).symm
  rw [hf1, hf0, ← Category.assoc a₀, ← hθ]
  simp only [Category.assoc]

theorem wc_cgth_divisor_milnor_acyclic : ∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] [IsDomain A] [IsDiscreteValuationRing A] (ℓ : ℕ), ℓ.Prime → IsUnit ((ℓ : ℕ) : A) → ∀ (d : ℕ) (y : Spec (.of (MvPolynomial (Option (Fin d)) A))), Spec.map (CommRingCat.ofHom (algebraMap A (MvPolynomial (Option (Fin d)) A))) y = IsLocalRing.closedPoint A → (MvPolynomial.X none : MvPolynomial (Option (Fin d)) A) ∈ y.asIdeal → ∀ (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (MvPolynomial (Option (Fin d)) A))) y)) (Scheme.Etale.forget (Spec (.of (MvPolynomial (Option (Fin d)) A))))) (φ : ∀ l, Spec (.of B) ⟶ (W'.obj l).right.left) (a : Spec (.of B) ⟶ Spec (.of (MvPolynomial (Option (Fin d)) A))), wcHalShData y B Λ W' φ a → ∀ (β : MvPolynomial (Option (Fin d)) A →+* B), Spec.map (CommRingCat.ofHom β) = a → ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (ξ : Spec (.of Ω) ⟶ Spec (.of A)), ∀ p : ℕ, 1 ≤ p → Subsingleton (wcEtCoh (Limits.pullback (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {β (MvPolynomial.X none)})))) (Limits.pullback.fst (Spec.map (CommRingCat.ofHom (β.comp (algebraMap A (MvPolynomial (Option (Fin d)) A))))) ξ)) ℓ p) :=
by
  intro A _ _ _ _ _ ℓ hℓ hunit d y hy hy0 B _ _ _ Λ _ _ W' φ a ha β hβ Ω _ _ ξ p hp
  classical

  have hK : ∀ p : MvPolynomial (Option (Fin d)) A, p - MvPolynomial.rename (some : Fin d → Option (Fin d)) ((MvPolynomial.aeval (fun o : Option (Fin d) => Option.elim o (0 : MvPolynomial (Fin d) A) MvPolynomial.X) : MvPolynomial (Option (Fin d)) A →ₐ[A] MvPolynomial (Fin d) A) p) ∈ Ideal.span {(MvPolynomial.X none : MvPolynomial (Option (Fin d)) A)} := by
    intro q
    induction q using MvPolynomial.induction_on with
    | C c =>
      simp only [MvPolynomial.aeval_C, MvPolynomial.algebraMap_eq, MvPolynomial.rename_C, sub_self]
      exact Ideal.zero_mem _
    | add p q hp hq =>
      rw [map_add, map_add, add_sub_add_comm]
      exact Ideal.add_mem _ hp hq
    | mul_X p n hp =>
      cases n with
      | none =>
        simp only [map_mul, MvPolynomial.aeval_X, Option.elim_none, mul_zero, map_zero, sub_zero]
        exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _)
      | some j =>
        have e : p * MvPolynomial.X (some j) - MvPolynomial.rename (some : Fin d → Option (Fin d)) ((MvPolynomial.aeval (fun o : Option (Fin d) => Option.elim o (0 : MvPolynomial (Fin d) A) MvPolynomial.X) : MvPolynomial (Option (Fin d)) A →ₐ[A] MvPolynomial (Fin d) A) (p * MvPolynomial.X (some j))) = (p - MvPolynomial.rename (some : Fin d → Option (Fin d)) ((MvPolynomial.aeval (fun o : Option (Fin d) => Option.elim o (0 : MvPolynomial (Fin d) A) MvPolynomial.X) : MvPolynomial (Option (Fin d)) A →ₐ[A] MvPolynomial (Fin d) A) p)) * MvPolynomial.X (some j) := by
          simp only [map_mul, MvPolynomial.aeval_X, Option.elim_some, MvPolynomial.rename_X, sub_mul]
        rw [e]
        exact Ideal.mul_mem_right _ _ hp

  have hsec : ∀ q : MvPolynomial (Fin d) A, (MvPolynomial.aeval (fun o : Option (Fin d) => Option.elim o (0 : MvPolynomial (Fin d) A) MvPolynomial.X) : MvPolynomial (Option (Fin d)) A →ₐ[A] MvPolynomial (Fin d) A) (MvPolynomial.rename some q) = q := by
    have hc : (MvPolynomial.aeval (fun o : Option (Fin d) => Option.elim o (0 : MvPolynomial (Fin d) A) MvPolynomial.X) : MvPolynomial (Option (Fin d)) A →ₐ[A] MvPolynomial (Fin d) A).comp (MvPolynomial.rename (some : Fin d → Option (Fin d))) = AlgHom.id A _ := by
      apply MvPolynomial.algHom_ext
      intro j
      simp [MvPolynomial.rename_X]
    intro q
    exact AlgHom.congr_fun hc q
  have hsurj : Function.Surjective (MvPolynomial.aeval (fun o : Option (Fin d) => Option.elim o (0 : MvPolynomial (Fin d) A) MvPolynomial.X) : MvPolynomial (Option (Fin d)) A →ₐ[A] MvPolynomial (Fin d) A).toRingHom :=
    fun q => ⟨_, hsec q⟩
  have hspan : Ideal.span {(MvPolynomial.X none : MvPolynomial (Option (Fin d)) A)} ≤ y.asIdeal :=
    (Ideal.span_singleton_le_iff_mem _).mpr hy0
  have hker : RingHom.ker (MvPolynomial.aeval (fun o : Option (Fin d) => Option.elim o (0 : MvPolynomial (Fin d) A) MvPolynomial.X) : MvPolynomial (Option (Fin d)) A →ₐ[A] MvPolynomial (Fin d) A).toRingHom ≤ y.asIdeal := by
    intro q hq
