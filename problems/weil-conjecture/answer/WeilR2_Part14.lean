    (Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A))))
    (Spec.map (CommRingCat.ofHom (algebraMap A' (Polynomial A'))))
    (Spec.map (CommRingCat.ofHom (Polynomial.mapRingHom f))) hpb x hx hxc
  have hsep : IsSepClosed ((Spec (.of (Polynomial A'))).residueField x') := by
    have crux : ∀ (Q : Ideal (Polynomial A')) [Q.IsMaximal],
        Q.comap Polynomial.C = IsLocalRing.maximalIdeal A' → IsSepClosed Q.ResidueField := by
      intro Q _ hQ
      let π : Polynomial A' →+* Q.ResidueField := algebraMap (Polynomial A') Q.ResidueField
      let ψ : A' →+* Q.ResidueField := π.comp Polynomial.C
      have hloc : IsLocalHom ψ := by
