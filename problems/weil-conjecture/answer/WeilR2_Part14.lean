  intro h1 h2 h3 q hq
  letI instC : HasExt C := HasExt.standard C
  letI instD : HasExt D := HasExt.standard D
  haveI : L.PreservesMonomorphisms := inferInstance
  haveI : Limits.PreservesFiniteLimits R := by
    haveI : Limits.PreservesLimitsOfSize.{0, 0} R := adj.rightAdjoint_preservesLimits
    infer_instance

  have sesC : ∀ (M : CochainComplex C ℕ) (n : ℕ), ∃ (Bo : C) (t : M.X n ⟶ Bo)
      (ι : Bo ⟶ M.cycles (n+1)) (hw1 : M.iCycles n ≫ t = 0) (hw2 : ι ≫ M.homologyπ (n+1) = 0),
      (ShortComplex.mk _ _ hw1).ShortExact ∧ (ShortComplex.mk _ _ hw2).ShortExact ∧
        t ≫ ι = M.toCycles n (n+1) := by
    intro M n
    have hn : (ComplexShape.up ℕ).next n = n + 1 := by simp
    have hp : (ComplexShape.up ℕ).prev (n + 1) = n := by simp
    have hdπ : M.toCycles n (n+1) ≫ M.homologyπ (n+1) = 0 := M.toCycles_comp_homologyπ n (n+1)
    have heι : Limits.kernel.lift (M.homologyπ (n+1)) (M.toCycles n (n+1)) hdπ ≫
        Limits.kernel.ι (M.homologyπ (n+1)) = M.toCycles n (n+1) := Limits.kernel.lift_ι _ _ _
    have hie : M.iCycles n ≫ Limits.kernel.lift (M.homologyπ (n+1)) (M.toCycles n (n+1)) hdπ = 0 := by
      rw [← cancel_mono (Limits.kernel.ι (M.homologyπ (n+1)) ≫ M.iCycles (n+1)), Limits.zero_comp,
        Category.assoc, reassoc_of% heι, HomologicalComplex.toCycles_i, HomologicalComplex.iCycles_d]
    have hex' : (ShortComplex.mk _ _ hdπ).Exact :=
      ShortComplex.exact_of_g_is_cokernel _ (M.homologyIsCokernel n (n+1) hp)
    haveI hepi : Epi (Limits.kernel.lift (M.homologyπ (n+1)) (M.toCycles n (n+1)) hdπ) :=
      hex'.epi_kernelLift
    have hlim1 : Limits.IsLimit (Limits.KernelFork.ofι (M.iCycles n) hie) :=
      Limits.isKernelOfComp (f := Limits.kernel.lift (M.homologyπ (n+1)) (M.toCycles n (n+1)) hdπ)
        (Limits.kernel.ι (M.homologyπ (n+1)) ≫ M.iCycles (n+1)) (M.d n (n+1))
        (M.cyclesIsKernel n (n+1) hn) hie
        (by rw [reassoc_of% heι, HomologicalComplex.toCycles_i])
    have hS₁ : (ShortComplex.mk _ _ hie).ShortExact :=
      ShortComplex.ShortExact.mk' (ShortComplex.exact_of_f_is_kernel _ hlim1)
        (by infer_instance) (by infer_instance)
    have hS₂ : (ShortComplex.mk _ _ (Limits.kernel.condition (M.homologyπ (n+1)))).ShortExact :=
      ShortComplex.ShortExact.mk' (ShortComplex.exact_of_f_is_kernel _ (Limits.kernelIsKernel _))
        (by infer_instance) (by infer_instance)
    exact ⟨_, _, _, hie, Limits.kernel.condition _, hS₁, hS₂, heι⟩

  have sesD : ∀ (M : CochainComplex D ℕ) (n : ℕ), ∃ (Bo : D) (t : M.X n ⟶ Bo)
      (ι : Bo ⟶ M.cycles (n+1)) (hw1 : M.iCycles n ≫ t = 0) (hw2 : ι ≫ M.homologyπ (n+1) = 0),
      (ShortComplex.mk _ _ hw1).ShortExact ∧ (ShortComplex.mk _ _ hw2).ShortExact ∧
        t ≫ ι = M.toCycles n (n+1) := by
    intro M n
    have hn : (ComplexShape.up ℕ).next n = n + 1 := by simp
    have hp : (ComplexShape.up ℕ).prev (n + 1) = n := by simp
    have hdπ : M.toCycles n (n+1) ≫ M.homologyπ (n+1) = 0 := M.toCycles_comp_homologyπ n (n+1)
    have heι : Limits.kernel.lift (M.homologyπ (n+1)) (M.toCycles n (n+1)) hdπ ≫
        Limits.kernel.ι (M.homologyπ (n+1)) = M.toCycles n (n+1) := Limits.kernel.lift_ι _ _ _
    have hie : M.iCycles n ≫ Limits.kernel.lift (M.homologyπ (n+1)) (M.toCycles n (n+1)) hdπ = 0 := by
      rw [← cancel_mono (Limits.kernel.ι (M.homologyπ (n+1)) ≫ M.iCycles (n+1)), Limits.zero_comp,
        Category.assoc, reassoc_of% heι, HomologicalComplex.toCycles_i, HomologicalComplex.iCycles_d]
    have hex' : (ShortComplex.mk _ _ hdπ).Exact :=
      ShortComplex.exact_of_g_is_cokernel _ (M.homologyIsCokernel n (n+1) hp)
    haveI hepi : Epi (Limits.kernel.lift (M.homologyπ (n+1)) (M.toCycles n (n+1)) hdπ) :=
      hex'.epi_kernelLift
    have hlim1 : Limits.IsLimit (Limits.KernelFork.ofι (M.iCycles n) hie) :=
      Limits.isKernelOfComp (f := Limits.kernel.lift (M.homologyπ (n+1)) (M.toCycles n (n+1)) hdπ)
        (Limits.kernel.ι (M.homologyπ (n+1)) ≫ M.iCycles (n+1)) (M.d n (n+1))
        (M.cyclesIsKernel n (n+1) hn) hie
        (by rw [reassoc_of% heι, HomologicalComplex.toCycles_i])
    have hS₁ : (ShortComplex.mk _ _ hie).ShortExact :=
      ShortComplex.ShortExact.mk' (ShortComplex.exact_of_f_is_kernel _ hlim1)
        (by infer_instance) (by infer_instance)
    have hS₂ : (ShortComplex.mk _ _ (Limits.kernel.condition (M.homologyπ (n+1)))).ShortExact :=
      ShortComplex.ShortExact.mk' (ShortComplex.exact_of_f_is_kernel _ (Limits.kernelIsKernel _))
        (by infer_instance) (by infer_instance)
    exact ⟨_, _, _, hie, Limits.kernel.condition _, hS₁, hS₂, heι⟩

  have stepC : ∀ (M : CochainComplex C ℕ) (X : C) (n k : ℕ), Injective (M.X n) →
      Subsingleton (Abelian.Ext X (M.cycles n) (k + 1 + 1)) →
      Subsingleton (Abelian.Ext X (M.homology (n+1)) (k + 1)) →
      Subsingleton (Abelian.Ext X (M.cycles (n+1)) (k + 1)) := by
    intro M X n k hJ hZ hH
    obtain ⟨Bo, t, ι, hw1, hw2, hS₁, hS₂, -⟩ := sesC M n
    have h0 : ∀ e : Abelian.Ext X (M.cycles (n+1)) (k + 1), e = 0 := by
      intro e
      obtain ⟨e₁, he₁⟩ := Abelian.Ext.covariant_sequence_exact₂ X hS₂ e (Subsingleton.elim _ _)
      obtain ⟨x₂, hx₂⟩ := Abelian.Ext.covariant_sequence_exact₃ X hS₁ e₁
        (show k + 1 + 1 = k + 1 + 1 from rfl) (Subsingleton.elim _ _)
      rw [← he₁, ← hx₂, @Abelian.Ext.eq_zero_of_injective _ _ _ _ _ _ _ hJ x₂,
        Abelian.Ext.zero_comp, Abelian.Ext.zero_comp]
    exact ⟨fun a b => (h0 a).trans (h0 b).symm⟩

  have stepD : ∀ (M : CochainComplex D ℕ) (X : D) (n k : ℕ), Injective (M.X n) →
      Subsingleton (Abelian.Ext X (M.cycles n) (k + 1 + 1)) →
      Subsingleton (Abelian.Ext X (M.homology (n+1)) (k + 1)) →
      Subsingleton (Abelian.Ext X (M.cycles (n+1)) (k + 1)) := by
    intro M X n k hJ hZ hH
    obtain ⟨Bo, t, ι, hw1, hw2, hS₁, hS₂, -⟩ := sesD M n
    have h0 : ∀ e : Abelian.Ext X (M.cycles (n+1)) (k + 1), e = 0 := by
      intro e
      obtain ⟨e₁, he₁⟩ := Abelian.Ext.covariant_sequence_exact₂ X hS₂ e (Subsingleton.elim _ _)
      obtain ⟨x₂, hx₂⟩ := Abelian.Ext.covariant_sequence_exact₃ X hS₁ e₁
        (show k + 1 + 1 = k + 1 + 1 from rfl) (Subsingleton.elim _ _)
      rw [← he₁, ← hx₂, @Abelian.Ext.eq_zero_of_injective _ _ _ _ _ _ _ hJ x₂,
        Abelian.Ext.zero_comp, Abelian.Ext.zero_comp]
    exact ⟨fun a b => (h0 a).trans (h0 b).symm⟩

  have shiftC : ∀ (M : CochainComplex C ℕ) (X : C), (∀ i, Injective (M.X i)) →
      ∀ j k : ℕ, (∀ s p : ℕ, 1 ≤ s → s ≤ j → 1 ≤ p → Subsingleton (Abelian.Ext X (M.homology s) p)) →
        Subsingleton (Abelian.Ext X (M.cycles 0) (k + 1 + j)) →
        Subsingleton (Abelian.Ext X (M.cycles j) (k + 1)) := by
    intro M X hJ j
    induction j with
    | zero => intro k _ h; exact h
    | succ j ih =>
      intro k hH h
      have h' : Subsingleton (Abelian.Ext X (M.cycles 0) (k + 1 + 1 + j)) := by
        have e : k + 1 + 1 + j = k + 1 + (j + 1) := by omega
        rw [e]; exact h
      have hj := ih (k + 1) (fun s p hs hsj hp => hH s p hs (by omega) hp) h'
      exact stepC M X j k (hJ j) hj (hH (j + 1) (k + 1) (by omega) le_rfl (by omega))

  have shiftD : ∀ (M : CochainComplex D ℕ) (X : D), (∀ i, Injective (M.X i)) →
      ∀ j k : ℕ, (∀ s p : ℕ, 1 ≤ s → s ≤ j → 1 ≤ p → Subsingleton (Abelian.Ext X (M.homology s) p)) →
        Subsingleton (Abelian.Ext X (M.cycles 0) (k + 1 + j)) →
        Subsingleton (Abelian.Ext X (M.cycles j) (k + 1)) := by
    intro M X hJ j
    induction j with
    | zero => intro k _ h; exact h
    | succ j ih =>
      intro k hH h
      have h' : Subsingleton (Abelian.Ext X (M.cycles 0) (k + 1 + 1 + j)) := by
        have e : k + 1 + 1 + j = k + 1 + (j + 1) := by omega
        rw [e]; exact h
      have hj := ih (k + 1) (fun s p hs hsj hp => hH s p hs (by omega) hp) h'
      exact stepD M X j k (hJ j) hj (hH (j + 1) (k + 1) (by omega) le_rfl (by omega))

  have liftD : ∀ (M : CochainComplex D ℕ) (X : D) (n : ℕ), Injective (M.X n) →
      Subsingleton (Abelian.Ext X (M.cycles n) (1 + 1)) →
      ∀ x : X ⟶ M.homology (n+1), ∃ y : X ⟶ M.cycles (n+1), y ≫ M.homologyπ (n+1) = x := by
    intro M X n hJ hZ x
    obtain ⟨Bo, t, ι, hw1, hw2, hS₁, hS₂, -⟩ := sesD M n
    have hB : ∀ z : Abelian.Ext X Bo 1, z = 0 := by
      intro z
      obtain ⟨x₂, hx₂⟩ := Abelian.Ext.covariant_sequence_exact₃ X hS₁ z
        (show 1 + 1 = 1 + 1 from rfl) (Subsingleton.elim _ _)
      rw [← hx₂, @Abelian.Ext.eq_zero_of_injective _ _ _ _ _ _ _ hJ x₂, Abelian.Ext.zero_comp]
    obtain ⟨x₂, hx₂⟩ := Abelian.Ext.covariant_sequence_exact₃ X hS₂ (Abelian.Ext.mk₀ x)
      (zero_add 1) (hB _)
    refine ⟨Abelian.Ext.homEquiv₀ x₂, ?_⟩
    apply Abelian.Ext.homEquiv₀.symm.injective
    rw [Abelian.Ext.homEquiv₀_symm_apply, Abelian.Ext.homEquiv₀_symm_apply,
      ← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_homEquiv₀_apply]
    exact hx₂

  have factorC : ∀ (M : CochainComplex C ℕ) (X : C) (n : ℕ),
      Subsingleton (Abelian.Ext X (M.cycles n) (0 + 1)) →
      ∀ y : X ⟶ M.cycles (n+1), y ≫ M.homologyπ (n+1) = 0 →
        ∃ w : X ⟶ M.X n, w ≫ M.toCycles n (n+1) = y := by
    intro M X n hZ y hy
    obtain ⟨Bo, t, ι, hw1, hw2, hS₁, hS₂, htι⟩ := sesC M n
    haveI := hS₂.mono_f
    obtain ⟨y₀, hy₀⟩ : ∃ y₀ : X ⟶ Bo, y₀ ≫ ι = y := ⟨hS₂.exact.lift y hy, hS₂.exact.lift_f y hy⟩
    obtain ⟨x₂, hx₂⟩ := Abelian.Ext.covariant_sequence_exact₃ X hS₁ (Abelian.Ext.mk₀ y₀)
      (zero_add 1) (Subsingleton.elim _ _)
    refine ⟨Abelian.Ext.homEquiv₀ x₂, ?_⟩
    have ht : Abelian.Ext.homEquiv₀ x₂ ≫ t = y₀ := by
      apply Abelian.Ext.homEquiv₀.symm.injective
      rw [Abelian.Ext.homEquiv₀_symm_apply, Abelian.Ext.homEquiv₀_symm_apply,
        ← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_homEquiv₀_apply]
      exact hx₂
    rw [← htι, ← Category.assoc, ht, hy₀]

  have extZeroC : ∀ (X Y : C), Limits.IsZero Y → ∀ p : ℕ, Subsingleton (Abelian.Ext X Y p) := by
    intro X Y hY p
    refine ⟨fun a b => ?_⟩
    have h0 : ∀ e : Abelian.Ext X Y p, e = 0 := by
      intro e
      rw [← Abelian.Ext.comp_mk₀_id e, hY.eq_of_src (𝟙 Y) 0, Abelian.Ext.mk₀_zero,
        Abelian.Ext.comp_zero]
    rw [h0 a, h0 b]

  have transC : ∀ (X : C) {Y Y' : C} (_ : Y ≅ Y') (p : ℕ),
      Subsingleton (Abelian.Ext X Y p) → Subsingleton (Abelian.Ext X Y' p) := by
    intro X Y Y' e p hs
    let E : Abelian.Ext X Y p ≃ Abelian.Ext X Y' p :=
      { toFun := fun x => x.comp (Abelian.Ext.mk₀ e.hom) (add_zero p)
        invFun := fun y => y.comp (Abelian.Ext.mk₀ e.inv) (add_zero p)
        left_inv := fun x => by
          simp only
          rw [Abelian.Ext.comp_assoc _ _ _ (add_zero p) (add_zero 0) (by omega),
            Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
        right_inv := fun y => by
          simp only
          rw [Abelian.Ext.comp_assoc _ _ _ (add_zero p) (add_zero 0) (by omega),
            Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.comp_mk₀_id] }
    exact E.symm.subsingleton
  have transD : ∀ (X : D) {Y Y' : D} (_ : Y ≅ Y') (p : ℕ),
      Subsingleton (Abelian.Ext X Y p) → Subsingleton (Abelian.Ext X Y' p) := by
    intro X Y Y' e p hs
    let E : Abelian.Ext X Y p ≃ Abelian.Ext X Y' p :=
      { toFun := fun x => x.comp (Abelian.Ext.mk₀ e.hom) (add_zero p)
        invFun := fun y => y.comp (Abelian.Ext.mk₀ e.inv) (add_zero p)
        left_inv := fun x => by
          simp only
          rw [Abelian.Ext.comp_assoc _ _ _ (add_zero p) (add_zero 0) (by omega),
            Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
        right_inv := fun y => by
          simp only
          rw [Abelian.Ext.comp_assoc _ _ _ (add_zero p) (add_zero 0) (by omega),
            Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.comp_mk₀_id] }
    exact E.symm.subsingleton

  set K := (R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex with hK
  have hKinj : ∀ n, Injective (K.X n) := fun n => adj.map_injective (I.cocomplex.X n) (I.injective n)

  have hφ0 : Nonempty (R.obj (I.cocomplex.cycles 0) ≅ K.cycles 0) := by
    have hn : (ComplexShape.up ℕ).next 0 = 0 + 1 := by simp
    have e1 := Limits.KernelFork.mapIsLimit _ (I.cocomplex.cyclesIsKernel 0 (0+1) hn) R
    have e2 := K.cyclesIsKernel 0 (0+1) hn
    exact ⟨Limits.IsLimit.conePointUniqueUpToIso e1 e2⟩
  obtain ⟨φ0⟩ := hφ0
  have hα : Nonempty (A ≅ I.cocomplex.cycles 0) :=
    ⟨(HomologicalComplex.singleObjXSelf (ComplexShape.up ℕ) 0 A).symm ≪≫
      Limits.IsLimit.conePointUniqueUpToIso I.isLimitKernelFork
        (I.cocomplex.cyclesIsKernel 0 1 (by simp))⟩
  obtain ⟨eA⟩ := hα
  let eRA : R.obj A ≅ K.cycles 0 := R.mapIso eA ≪≫ φ0
  have hΦ0 : ∀ (X : D) (Y : C), adj.homEquiv X Y 0 = 0 := by
    intro X Y
    rw [Adjunction.homEquiv_apply, Functor.map_zero, Limits.comp_zero]

  have key : ∀ x : P ⟶ K.homology q, x = 0 := by
    intro x
    cases q with
    | zero =>
      haveI : Subsingleton (Abelian.Ext (L.obj P) A 0) := h3 0 (by omega)
      haveI hsub : Subsingleton (P ⟶ K.cycles 0) :=
        (((Iso.refl P).homCongr eRA.symm).trans
          ((adj.homEquiv P A).symm.trans Abelian.Ext.homEquiv₀.symm)).subsingleton
      haveI : IsIso (K.homologyπ 0) :=
        HomologicalComplex.isIso_homologyπ K 0 0 CochainComplex.prev_nat_zero (K.shape 0 0 (by simp))
      have hx : x = (x ≫ inv (K.homologyπ 0)) ≫ K.homologyπ 0 := by simp
      rw [hx, Subsingleton.elim (x ≫ inv (K.homologyπ 0)) 0, Limits.zero_comp]
    | succ n =>

      have hZ0K : Subsingleton (Abelian.Ext P (K.cycles 0) (1 + 1 + n)) := by
        have e : 1 + 1 + n = n + 2 := by omega
        rw [e]
        exact transD P eRA (n + 2) (h2 (n + 2) (by omega))
      have hZnK := shiftD K P hKinj n 1 (fun s p hs _ hp => h1 p s hp hs) hZ0K
      obtain ⟨y, hy⟩ := liftD K P n (hKinj n) hZnK x

      obtain ⟨g, hgdef⟩ : ∃ g : L.obj P ⟶ I.cocomplex.X (n + 1),
          adj.homEquiv _ _ g = y ≫ K.iCycles (n + 1) := ⟨_, Equiv.apply_symm_apply _ _⟩
      have hg : g ≫ I.cocomplex.d (n + 1) (n + 1 + 1) = 0 := by
        apply (adj.homEquiv _ _).injective
        rw [Adjunction.homEquiv_naturality_right, hΦ0, hgdef, Category.assoc]
        show y ≫ (K.iCycles (n + 1) ≫ K.d (n + 1) (n + 1 + 1)) = 0
        rw [HomologicalComplex.iCycles_d, Limits.comp_zero]
      let y' : L.obj P ⟶ I.cocomplex.cycles (n + 1) :=
        I.cocomplex.liftCycles g (n + 1 + 1) (by simp) hg
      have hy'π : y' ≫ I.cocomplex.homologyπ (n + 1) = 0 :=
        (I.cocomplex_exactAt_succ n).isZero_homology.eq_of_tgt _ _

      have hZ0C : Subsingleton (Abelian.Ext (L.obj P) (I.cocomplex.cycles 0) (0 + 1 + n)) := by
        have e : 0 + 1 + n = n + 1 := by omega
        rw [e]
        exact transC (L.obj P) eA (n + 1) (h3 (n + 1) (by omega))
      have hZnC := shiftC I.cocomplex (L.obj P) I.injective n 0
        (fun s p hs _ _ => by
          obtain ⟨s', rfl⟩ : ∃ s', s = s' + 1 := ⟨s - 1, by omega⟩
          exact extZeroC _ _ (I.cocomplex_exactAt_succ s').isZero_homology p) hZ0C
      obtain ⟨w, hw⟩ := factorC I.cocomplex (L.obj P) n hZnC y' hy'π

      have hv : adj.homEquiv _ _ w ≫ K.toCycles n (n + 1) = y := by
        rw [← cancel_mono (K.iCycles (n + 1)), Category.assoc, HomologicalComplex.toCycles_i,
          ← hgdef]
        show adj.homEquiv _ _ w ≫ R.map (I.cocomplex.d n (n + 1)) = _
        rw [← Adjunction.homEquiv_naturality_right]
        congr 1
        rw [← I.cocomplex.toCycles_i n (n + 1), ← Category.assoc, hw]
        exact I.cocomplex.liftCycles_i g (n + 1 + 1) (by simp) hg
      rw [← hy, ← hv, Category.assoc, HomologicalComplex.toCycles_comp_homologyπ, Limits.comp_zero]
  haveI : Subsingleton (P ⟶ K.homology q) := ⟨fun a b => (key a).trans (key b).symm⟩
  exact Abelian.Ext.homEquiv₀.subsingleton

theorem wc_et_geom_pt_nbhd_cofiltered : ∀ (B : Scheme.{u}) (b : B), IsCofiltered (StructuredArrow (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B)) :=
by
  intro B b
  let Φ := Scheme.pointSmallEtale (wcEtGeomPt B b)
  haveI : IsCofiltered Φ.fiber.Elements := Φ.isCofiltered
  let E : StructuredArrow (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B) ⥤ Φ.fiber.Elements :=
    { obj := fun A => Φ.fiber.elementsMk A.right A.hom
      map := fun {A A'} g => ⟨g.right, StructuredArrow.w g⟩
      map_id := fun A => rfl
      map_comp := fun f g => rfl }
  let Einv : Φ.fiber.Elements ⥤ StructuredArrow (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B) :=
    { obj := fun x => StructuredArrow.mk (T := Scheme.Etale.forget B) (Y := x.1) x.2
      map := fun {x y} φ => StructuredArrow.homMk φ.1 φ.2
      map_id := fun x => rfl
      map_comp := fun f g => rfl }
  let eqv : StructuredArrow (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B) ≌ Φ.fiber.Elements :=
    CategoryTheory.Equivalence.mk E Einv (NatIso.ofComponents (fun A => Iso.refl _) (by intros; rfl))
      (NatIso.ofComponents (fun x => Iso.refl _) (by intros; rfl))
  exact IsCofiltered.of_equivalence eqv.symm

theorem wc_et_const_int_hom_of_global_section : ∀ (Y : Scheme.{u}) (M : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (s : M.obj.obj (Opposite.op (Scheme.Etale.mk (𝟙 Y)))), ∃ h : (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)) ⟶ M, (h.hom.app (Opposite.op (Scheme.Etale.mk (𝟙 Y)))).hom (((toSheafify (Scheme.smallEtaleTopology Y) ((Functor.const (Scheme.Etale Y)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)))).app (Opposite.op (Scheme.Etale.mk (𝟙 Y)))).hom (ULift.up 1)) = s :=
by
  intro Y M s
  let t : ∀ U : Y.Etale, U ⟶ Scheme.Etale.mk (𝟙 Y) := fun U => MorphismProperty.Over.homMk U.hom
  have ht : ∀ (U : Y.Etale) (f : U ⟶ Scheme.Etale.mk (𝟙 Y)), f = t U := by
    intro U f
    apply MorphismProperty.Over.Hom.ext
    have h1 := MorphismProperty.Over.w f
    exact (Category.comp_id f.left).symm.trans h1
  have hop : ∀ (U V : (Scheme.Etale Y)ᵒᵖ) (f : U ⟶ V), (t U.unop).op ≫ f = (t V.unop).op := by
    intro U V f
    apply Quiver.Hom.unop_inj
    rw [unop_comp, Quiver.Hom.unop_op, Quiver.Hom.unop_op]
    exact ht _ _
  let η : (Functor.const (Scheme.Etale Y)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)) ⟶ M.obj :=
    { app := fun U => AddCommGrpCat.ofHom ((zmultiplesHom (M.obj.obj U)
          ((M.obj.map (t U.unop).op).hom s)).comp AddEquiv.ulift.toAddMonoidHom)
      naturality := by
        intro U V f
        ext x
        change (x.down) • (M.obj.map (t V.unop).op).hom s =
          (M.obj.map f).hom (x.down • (M.obj.map (t U.unop).op).hom s)
        rw [← hop U V f]
        simp only [Functor.map_comp, AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply, map_zsmul] }
  let g : ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} ℤ))).obj ⟶ M.obj := sheafifyLift _ η M.property
  refine ⟨ObjectProperty.homMk g, ?_⟩
  have h1 := toSheafify_sheafifyLift (Scheme.smallEtaleTopology Y) η M.property
  have h2 := congrArg (fun φ => (φ.app (Opposite.op (Scheme.Etale.mk (𝟙 Y)))).hom (ULift.up 1)) h1
  simp only [NatTrans.comp_app, AddCommGrpCat.comp_apply] at h2
  have ht0 : t (Scheme.Etale.mk (𝟙 Y)) = 𝟙 _ := (ht _ _).symm
  have h3 : (η.app (Opposite.op (Scheme.Etale.mk (𝟙 Y)))).hom (ULift.up 1) = s := by
    change (1 : ℤ) • (M.obj.map (t (Scheme.Etale.mk (𝟙 Y))).op).hom s = s
    rw [one_zsmul, ht0, op_id, CategoryTheory.Functor.map_id]
    rfl
  exact h2.trans h3

theorem wc_cpt_th_strict_closed_etale_tube : ∀ (C : Type u) [CommRing C] [HenselianLocalRing C] [IsSepClosed (IsLocalRing.ResidueField C)] {X : Scheme.{u}} (i : Spec (.of C) ⟶ X) [IsClosedImmersion i] (V : X.Etale) (v : V.left), V.hom v = i (IsLocalRing.closedPoint C) → ∃ (V₁ : X.Etale) (c₁ : V₁ ⟶ V) (v₁ : V₁.left) (e : Spec (.of C) ⟶ V₁.left), c₁.left v₁ = v ∧ IsOpenImmersion c₁.left ∧ IsPullback (𝟙 (Spec (.of C))) e i V₁.hom :=
by
  classical
  intro C _ _ _ X i _
  have key : ∀ (Vl : Scheme.{u}) (f : Vl ⟶ X) [Etale f] (v : Vl),
      f v = i (IsLocalRing.closedPoint C) →
      ∃ (T : Scheme.{u}) (g : T ⟶ Vl) (_ : IsOpenImmersion g) (t : T)
        (e : Spec (.of C) ⟶ T), g t = v ∧ IsPullback (𝟙 (Spec (.of C))) e i (g ≫ f) := by
    intro Vl f _ v hv
    obtain ⟨U, hvU, hiso⟩ := wc_etale_fibre_point_isolated f v
    obtain ⟨h, hh⟩ : ∃ h : U.toScheme ⟶ X, h = U.ι ≫ f := ⟨_, rfl⟩
    haveI : Etale h := by rw [hh]; infer_instance
    have hhw : ∀ w : U.toScheme, h w = f (U.ι w) := by
      intro w; rw [hh]; exact Scheme.Hom.comp_apply _ _ _
    have hUmem : ∀ w : U.toScheme, U.ι w ∈ U := by
      intro w
      have hr : U.ι w ∈ Set.range U.ι := ⟨w, rfl⟩
      rw [Scheme.Opens.range_ι] at hr
      exact hr
    have hvr : v ∈ Set.range U.ι := by rw [Scheme.Opens.range_ι]; exact hvU
    obtain ⟨v', hv'⟩ := hvr
    have hv'h : h v' = i (IsLocalRing.closedPoint C) := by
      rw [hhw, hv']
      exact hv
    have hisoU : ∀ w : U.toScheme, h w = h v' → w = v' := by
      intro w hw
      rw [hhw, hhw, hv'] at hw
      have h1 := hiso (U.ι w) (hUmem w) hw
      exact (Scheme.Hom.isOpenEmbedding U.ι).injective (h1.trans hv'.symm)

    have hfinj : Function.Injective (Limits.pullback.fst h i) :=
      (Scheme.Hom.isClosedEmbedding (Limits.pullback.fst h i)).injective
    obtain ⟨y₀, hy₀1, hy₀2⟩ := Scheme.Pullback.exists_preimage_pullback (f := h) (g := i) v'
      (IsLocalRing.closedPoint C) hv'h
    obtain ⟨σ, hσ⟩ := wc_strictHensel_etale_point_lift C (𝟙 (Spec (.of C)))
      (Limits.pullback.snd h i) y₀ (by rw [hy₀2]; rfl)
    haveI hσo : IsOpenImmersion σ :=
      wc_etale_section_isOpenImmersion (Limits.pullback.snd h i) (𝟙 _) σ hσ
    have hσq : ∀ q, Limits.pullback.fst h i q = v' → q ∈ Set.range σ := by
      intro q hq
      have e1 := Scheme.Hom.comp_apply (Limits.pullback.fst h i) h (σ (IsLocalRing.closedPoint C))
      have e2 := Scheme.Hom.comp_apply (Limits.pullback.snd h i) i (σ (IsLocalRing.closedPoint C))
      rw [Limits.pullback.condition] at e1
      have e3 := Scheme.Hom.comp_apply σ (Limits.pullback.snd h i) (IsLocalRing.closedPoint C)
      rw [hσ] at e3
      have hs : Limits.pullback.snd h i (σ (IsLocalRing.closedPoint C)) =
          IsLocalRing.closedPoint C := e3.symm
      have h1 : Limits.pullback.fst h i (σ (IsLocalRing.closedPoint C)) = v' := by
        apply hisoU
        rw [← e1, e2, hs, hv'h]
      exact ⟨IsLocalRing.closedPoint C, hfinj (h1.trans hq.symm)⟩

    have hRo : IsOpen (Set.range σ) := IsOpenImmersion.isOpen_range σ
    have hK : IsClosed ((Limits.pullback.fst h i) '' (Set.range σ)ᶜ) :=
      (Scheme.Hom.isClosedEmbedding (Limits.pullback.fst h i)).isClosedMap _ hRo.isClosed_compl
    let W : U.toScheme.Opens := ⟨((Limits.pullback.fst h i) '' (Set.range σ)ᶜ)ᶜ, hK.isOpen_compl⟩
    have hWmem : ∀ x : U.toScheme, x ∈ W → x ∉ (Limits.pullback.fst h i) '' (Set.range σ)ᶜ :=
      fun x hx => hx
    have hWmem' : ∀ x : U.toScheme, x ∉ (Limits.pullback.fst h i) '' (Set.range σ)ᶜ → x ∈ W :=
      fun x hx => hx
    have hv'W : v' ∈ W := by
      apply hWmem'
      rintro ⟨q, hq, hqv⟩
      exact hq (hσq q hqv)
    have hsub : Set.range (σ ≫ Limits.pullback.fst h i) ⊆ Set.range W.ι := by
      rw [Scheme.Opens.range_ι]
      rintro _ ⟨z, rfl⟩
      apply hWmem'
      rw [Scheme.Hom.comp_apply]
      rintro ⟨q, hq, hqe⟩
      exact hq ⟨z, (hfinj hqe).symm⟩
    let e := IsOpenImmersion.lift W.ι (σ ≫ Limits.pullback.fst h i) hsub
    have he : e ≫ W.ι = σ ≫ Limits.pullback.fst h i := IsOpenImmersion.lift_fac _ _ _
    have hsq : CommSq (𝟙 (Spec (.of C))) e i (W.ι ≫ h) := ⟨by
      rw [Category.id_comp, ← Category.assoc, he, Category.assoc, Limits.pullback.condition,
        ← Category.assoc, hσ, Category.id_comp]⟩
    have hpb : IsPullback (𝟙 (Spec (.of C))) e i (W.ι ≫ h) := by
      refine IsPullback.of_isLimit' hsq (Limits.PullbackCone.IsLimit.mk hsq.w (fun t => t.fst)
        (fun t => Category.comp_id _) (fun t => ?_)
        (fun t m hm1 _ => (Category.comp_id m).symm.trans hm1))
      have hcond : (t.snd ≫ W.ι) ≫ h = t.fst ≫ i := by
        rw [Category.assoc]; exact t.condition.symm
      let y' := Limits.pullback.lift (t.snd ≫ W.ι) t.fst hcond
      have hy1 : y' ≫ Limits.pullback.fst h i = t.snd ≫ W.ι := Limits.pullback.lift_fst _ _ _
      have hy2 : y' ≫ Limits.pullback.snd h i = t.fst := Limits.pullback.lift_snd _ _ _
      have hrange : Set.range y' ⊆ Set.range σ := by
        rintro _ ⟨p, rfl⟩
        by_contra hp
        have e1 := Scheme.Hom.comp_apply y' (Limits.pullback.fst h i) p
        rw [hy1, Scheme.Hom.comp_apply] at e1
        have hW : W.ι (t.snd p) ∈ W := by
          have hr : W.ι (t.snd p) ∈ Set.range W.ι := ⟨t.snd p, rfl⟩
          rw [Scheme.Opens.range_ι] at hr
          exact hr
        rw [e1] at hW
        exact hWmem _ hW ⟨y' p, hp, rfl⟩
      let l := IsOpenImmersion.lift σ y' hrange
      have hl : l ≫ σ = y' := IsOpenImmersion.lift_fac _ _ _
      have hlt : l = t.fst := by
        calc l = l ≫ σ ≫ Limits.pullback.snd h i := by rw [hσ, Category.comp_id]
          _ = t.fst := by rw [← Category.assoc, hl, hy2]
      apply (cancel_mono W.ι).mp
      rw [Category.assoc, he, ← hy1, ← hl, hlt, Category.assoc]
    have hvr2 : v' ∈ Set.range W.ι := by rw [Scheme.Opens.range_ι]; exact hv'W
    obtain ⟨v₁, hv₁⟩ := hvr2
    refine ⟨W.toScheme, W.ι ≫ U.ι, inferInstance, v₁, e, ?_, ?_⟩
    · rw [Scheme.Hom.comp_apply, hv₁, hv']
    · rw [Category.assoc, ← hh]; exact hpb
  intro V v hv
  haveI : Etale V.hom := V.prop
  obtain ⟨T, g, hg, t, e, hgt, hpb⟩ := key V.left V.hom v hv
  haveI := hg
  haveI : Etale (g ≫ V.hom) := inferInstance
  exact ⟨MorphismProperty.Over.mk ⊤ (g ≫ V.hom) inferInstance,
    MorphismProperty.Over.homMk g rfl trivial, t, e, hgt, hg, hpb⟩

theorem wc_cpt_th_closed_tube_section_extend : ∀ {X Z : Scheme.{u}} (i : Z ⟶ X) [IsClosedImmersion i] (T : X.Etale) (e : Z ⟶ T.left), IsPullback (𝟙 Z) e i T.hom → ∀ (F : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}), (∀ x : X, x ∉ Set.range i → Subsingleton ((wcEtStalk X x).obj F)) → ∀ g : F.obj.obj (Opposite.op T), ∃ s : F.obj.obj (Opposite.op (Scheme.Etale.mk (𝟙 X))), ∀ d : T ⟶ Scheme.Etale.mk (𝟙 X), F.obj.map d.op s = g :=
by
  intro X Z i _ T e hpb F hF g
  have hw0 : e ≫ T.hom = i := (hpb.toCommSq.w).symm.trans (Category.id_comp i)
  have hleft : ∀ {W : X.Etale} (a : W ⟶ Scheme.Etale.mk (𝟙 X)), a.left = W.hom :=
    fun a => (Category.comp_id a.left).symm.trans (MorphismProperty.Over.w a)
  have hterm : ∀ {W : X.Etale} (a b : W ⟶ Scheme.Etale.mk (𝟙 X)), a = b :=
    fun a b => MorphismProperty.Over.Hom.ext ((hleft a).trans (hleft b).symm)
  let P := F.obj ⋙ forget AddCommGrpCat.{u+1}
  have hP : Presieve.IsSheaf (Scheme.smallEtaleTopology X) P :=
    (isSheaf_iff_isSheaf_of_type _ _).mp
      (GrothendieckTopology.HasSheafCompose.isSheaf (F := forget AddCommGrpCat.{u+1}) F.obj F.property)

  have hvan : ∀ (W : X.Etale), (∀ w : W.left, W.hom w ∉ Set.range i) →
      ∀ h : F.obj.obj (Opposite.op W), h = 0 := by
    intro W hmiss h
    let S : Sieve W :=
      { arrows := fun W' f => F.obj.map f.op h = 0
        downward_closed := by
          intro W' W'' f hf k
          show F.obj.map (k ≫ f).op h = 0
          rw [op_comp, CategoryTheory.Functor.map_comp, AddCommGrpCat.comp_apply]
          rw [show F.obj.map f.op h = 0 from hf, map_zero] }
    have hS : S ∈ Scheme.smallEtaleTopology X W := by
      apply wc_etale_jointly_surjective_covers X W S
      intro w
      obtain ⟨V₁, c, hw, hc0⟩ := wc_et_vanish_off_of_stalks F W h w (hF _ (hmiss w))
      exact ⟨V₁, c, hc0, hw⟩
    have hsep := (hP.isSheafFor S.arrows (by rwa [Sieve.generate_sieve])).isSeparatedFor
    apply hsep.ext
    intro W' f hf
    change F.obj.map f.op h = F.obj.map f.op 0
    rw [map_zero]
    exact hf

  have hagree : ∀ (W : X.Etale) (a c : W ⟶ T), F.obj.map a.op g = F.obj.map c.op g := by
    intro W a c
    obtain ⟨S, hS, hSp⟩ := wc_et_closed_lifts_agree_locally T i e hpb W a.left c.left
      (MorphismProperty.Over.w a) (MorphismProperty.Over.w c)
    have hsep := (hP.isSheafFor S.arrows (by rwa [Sieve.generate_sieve])).isSeparatedFor
    apply hsep.ext
    intro W' f hf
    change F.obj.map f.op (F.obj.map a.op g) = F.obj.map f.op (F.obj.map c.op g)
    rcases hSp f hf with h1 | h1
    · have hfa : f ≫ a = f ≫ c := MorphismProperty.Over.Hom.ext h1
      have h2 := congrArg (fun k : W' ⟶ T => F.obj.map k.op g) hfa
      simp only [op_comp, CategoryTheory.Functor.map_comp, AddCommGrpCat.comp_apply] at h2
      exact h2
    · exact (hvan W' h1 _).trans (hvan W' h1 _).symm

  have hZ : IsClosed (Set.range i) := i.isClosedEmbedding.isClosed_range
  let U₀ : X.Opens := ⟨(Set.range i)ᶜ, hZ.isOpen_compl⟩
  let O : X.Etale := Scheme.Etale.mk U₀.ι
  let Y' : Bool → X.Etale := fun b => Bool.rec (motive := fun _ => X.Etale) O T b
  let π : ∀ b, Y' b ⟶ Scheme.Etale.mk (𝟙 X) :=
    fun b => MorphismProperty.Over.homMk (Y' b).hom (Category.comp_id _) trivial
  let σ : ∀ b, P.obj (Opposite.op (Y' b)) := fun b =>
    Bool.rec (motive := fun b => P.obj (Opposite.op (Y' b))) (0 : F.obj.obj (Opposite.op O)) g b
  have hmem : ∀ b, (Sieve.generate (Presieve.ofArrows Y' π)).arrows (π b) :=
    fun b => ⟨Y' b, 𝟙 (Y' b), π b, Presieve.ofArrows.mk b, Category.id_comp _⟩
  have hcov : Sieve.generate (Presieve.ofArrows Y' π) ∈
      Scheme.smallEtaleTopology X (Scheme.Etale.mk (𝟙 X)) := by
    change _ ∈ Scheme.smallGrothendieckTopology @Etale X _
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale X
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
    apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale X
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
    intro x
    by_cases hx : x ∈ Set.range i
    · obtain ⟨z, rfl⟩ := hx
      have hEt : Etale (π true).left := by
        rw [hleft (π true)]
        exact T.prop
      have hv : (π true).left (e z) = i z := by
        rw [hleft (π true)]
        show T.hom (e z) = i z
        rw [← Scheme.Hom.comp_apply, hw0]
      exact ⟨Y' true, π true, e z, hmem true, hEt, hv⟩
    · have hEt : Etale (π false).left := by
        rw [hleft (π false)]
        exact O.prop
      let y : (Y' false).left := (show U₀ from ⟨x, hx⟩)
      have hv : (π false).left y = x := by
        rw [hleft (π false)]
        exact Scheme.Opens.ι_apply U₀ ⟨x, hx⟩
      exact ⟨Y' false, π false, y, hmem false, hEt, hv⟩

  have hmissO : ∀ (W : X.Etale) (a : W ⟶ O), ∀ w : W.left, W.hom w ∉ Set.range i := by
    intro W a w
    rw [← MorphismProperty.Over.w a, Scheme.Hom.comp_apply]
    show U₀.ι (a.left w) ∉ Set.range i
    intro hm
    have hm' : U₀.ι (show U₀ from a.left w) ∈ Set.range i := hm
    have h1 : U₀.ι (show U₀ from a.left w) = (show U₀ from a.left w).1 :=
      Scheme.Opens.ι_apply U₀ _
    have h2 : (show U₀ from a.left w).1 ∈ (Set.range i)ᶜ := (show U₀ from a.left w).2
    rw [h1] at hm'
    exact h2 hm'
  have hcompat : Presieve.Arrows.Compatible P π σ := by
    intro b₁ b₂ W a c _
    cases b₁ <;> cases b₂
    · exact (hvan W (hmissO W a) _).trans (hvan W (hmissO W a) _).symm
    · exact (hvan W (hmissO W a) _).trans (hvan W (hmissO W a) _).symm
    · exact (hvan W (hmissO W c) _).trans (hvan W (hmissO W c) _).symm
    · exact hagree W a c
  obtain ⟨t, ht, -⟩ := (Presieve.isSheafFor_arrows_iff P π).mp (hP.isSheafFor _ hcov) σ hcompat
  refine ⟨t, fun d => ?_⟩
  rw [hterm d (π true)]
  exact ht true

theorem wc_cpt_th_supported_stalk_of_gamma : ∀ (C : Type u) [CommRing C] [HenselianLocalRing C] [IsSepClosed (IsLocalRing.ResidueField C)] (j c : Spec (.of (Polynomial C)) ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) C) MvPolynomial.gradedAlgebra), IsOpenImmersion j → IsOpenImmersion c → (∀ x, x ∈ Set.range j ∨ x ∈ Set.range c) → IsPullback (Spec.map (CommRingCat.ofHom (Polynomial.eval₂RingHom (algebraMap C (LaurentPolynomial C)) (LaurentPolynomial.T (-1))))) (Spec.map (CommRingCat.ofHom (Polynomial.toLaurent : Polynomial C →+* LaurentPolynomial C))) j c → ∀ (F : Sheaf (Scheme.smallEtaleTopology (@Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) C) MvPolynomial.gradedAlgebra)) AddCommGrpCat.{u+1}), (∀ y ∈ Set.range j, Subsingleton ((wcEtStalk _ y).obj F)) → Subsingleton (wcEtExt (@Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) C) MvPolynomial.gradedAlgebra) F 0) → ∀ x : Spec (.of (Polynomial C)), Spec.map (CommRingCat.ofHom (algebraMap C (Polynomial C))) x = IsLocalRing.closedPoint C → (Polynomial.X : Polynomial C) ∈ x.asIdeal → Subsingleton ((wcEtStalk _ (c x)).obj F) :=
by
  classical
  intro C _ _ _ j c hj hc hcov hpb F hF hΓ x hx hX

  have hsurj : Function.Surjective (Polynomial.evalRingHom (0 : C)) :=
    fun a => ⟨Polynomial.C a, by simp⟩
  have hr0 : ∀ z : Spec (.of (Polynomial C)),
      z ∈ Set.range (Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom (0 : C)))) ↔
        Polynomial.X ∈ z.asIdeal := by
    intro z
    have h1 := range_comap_of_surjective _ _ hsurj
    rw [Polynomial.ker_evalRingHom, map_zero, sub_zero] at h1
    constructor
    · rintro ⟨w, rfl⟩
      show Polynomial.evalRingHom (0 : C) Polynomial.X ∈ w.asIdeal
      rw [Polynomial.coe_evalRingHom, Polynomial.eval_X]
      exact w.asIdeal.zero_mem
    · intro hz
      have key : ∀ y : PrimeSpectrum (Polynomial C), Polynomial.X ∈ y.asIdeal →
          y ∈ Set.range (PrimeSpectrum.comap (Polynomial.evalRingHom (0 : C))) := by
        intro y hy
        rw [h1, PrimeSpectrum.mem_zeroLocus]
        exact (Ideal.span_singleton_le_iff_mem _).mpr hy
      obtain ⟨w, hw⟩ := key z hz
      exact ⟨w, hw⟩
  have hal : algebraMap (Polynomial C) (LaurentPolynomial C) = Polynomial.toLaurent :=
    RingHom.ext LaurentPolynomial.algebraMap_eq_toLaurent
  have hrs : ∀ z : Spec (.of (Polynomial C)),
      z ∈ Set.range (Spec.map (CommRingCat.ofHom
        (Polynomial.toLaurent : Polynomial C →+* LaurentPolynomial C))) ↔
        Polynomial.X ∉ z.asIdeal := by
    intro z
    have h1 := PrimeSpectrum.localization_away_comap_range (LaurentPolynomial C)
      (Polynomial.X : Polynomial C)
    rw [hal] at h1
    constructor
    · rintro ⟨w, rfl⟩
      have hm : PrimeSpectrum.comap (Polynomial.toLaurent : Polynomial C →+* LaurentPolynomial C) w ∈
          (PrimeSpectrum.basicOpen (Polynomial.X : Polynomial C) : Set (PrimeSpectrum (Polynomial C))) := by
        rw [← h1]
        exact ⟨w, rfl⟩
      exact hm
    · intro hz
      have key : ∀ y : PrimeSpectrum (Polynomial C), Polynomial.X ∉ y.asIdeal →
          y ∈ Set.range (PrimeSpectrum.comap
            (Polynomial.toLaurent : Polynomial C →+* LaurentPolynomial C)) := by
        intro y hy
        rw [h1]
        exact hy
      obtain ⟨w, hw⟩ := key z hz
      exact ⟨w, hw⟩
  have hstar : ∀ z : Spec (.of (Polynomial C)), c z ∈ Set.range j ↔ Polynomial.X ∉ z.asIdeal := by
    intro z
    rw [← hrs z]
    have hinv : hpb.isoPullback.inv ≫ Spec.map (CommRingCat.ofHom
        (Polynomial.toLaurent : Polynomial C →+* LaurentPolynomial C)) = Limits.pullback.snd j c := by
      rw [Iso.inv_comp_eq]
      exact hpb.isoPullback_hom_snd.symm
    have h2 : Set.range (Spec.map (CommRingCat.ofHom
        (Polynomial.toLaurent : Polynomial C →+* LaurentPolynomial C))) =
        Set.range (Limits.pullback.snd j c) := by
      ext w
      constructor
      · rintro ⟨v, rfl⟩
        exact ⟨hpb.isoPullback.hom v, by rw [← Scheme.Hom.comp_apply, hpb.isoPullback_hom_snd]⟩
      · rintro ⟨v, rfl⟩
        exact ⟨hpb.isoPullback.inv v, by rw [← Scheme.Hom.comp_apply, hinv]⟩
    rw [h2, Scheme.Pullback.range_snd]
    rfl
  have hrange : Set.range (Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom (0 : C))) ≫ c) =
      (Set.range j)ᶜ := by
    ext x
    constructor
    · rintro ⟨w, rfl⟩
      rw [Scheme.Hom.comp_apply]
      intro hx
      exact ((hstar _).mp hx) ((hr0 _).mp ⟨w, rfl⟩)
    · intro hx
      rcases hcov x with h | ⟨z, rfl⟩
      · exact (hx h).elim
      · have hz : Polynomial.X ∈ z.asIdeal := by
          by_contra hn
          exact hx ((hstar z).mpr hn)
        obtain ⟨w, rfl⟩ := (hr0 z).mpr hz
        exact ⟨w, by rw [Scheme.Hom.comp_apply]⟩
  haveI : IsClosedImmersion (Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom (0 : C)))) :=
    IsClosedImmersion.spec_of_surjective _ hsurj
  haveI := hc
  haveI hi : IsClosedImmersion (Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom (0 : C))) ≫ c) := by
    apply IsClosedImmersion.of_isPreimmersion
    rw [hrange]
    exact (IsOpenImmersion.isOpen_range j).isClosed_compl

  have he0 : Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom (0 : C)))
      (IsLocalRing.closedPoint C) = x := by
    have h1 : (Spec.map (CommRingCat.ofHom (algebraMap C (Polynomial C))) x).asIdeal =
        IsLocalRing.maximalIdeal C := by rw [hx]; rfl
    have hxC : ∀ a : C, Polynomial.C a ∈ x.asIdeal ↔ a ∈ IsLocalRing.maximalIdeal C := by
      intro a
      rw [← h1]
      show Polynomial.C a ∈ x.asIdeal ↔ algebraMap C (Polynomial C) a ∈ x.asIdeal
      rw [Polynomial.algebraMap_eq]
    have hM : (Ideal.comap (Polynomial.evalRingHom (0 : C)) (IsLocalRing.maximalIdeal C)).IsMaximal :=
      Ideal.comap_isMaximal_of_surjective _ hsurj
    have hle : Ideal.comap (Polynomial.evalRingHom (0 : C)) (IsLocalRing.maximalIdeal C) ≤
        x.asIdeal := by
      intro f hf
      rw [Ideal.mem_comap, Polynomial.coe_evalRingHom] at hf
      have h1 : f - Polynomial.C (f.coeff 0) ∈ x.asIdeal := by
        have hd : Polynomial.X ∣ f - Polynomial.C (f.coeff 0) := by
          rw [Polynomial.X_dvd_iff, Polynomial.coeff_sub, Polynomial.coeff_C_zero, sub_self]
        obtain ⟨q, hq⟩ := hd
        rw [hq]
        exact x.asIdeal.mul_mem_right q hX
      have h2 : Polynomial.C (f.coeff 0) ∈ x.asIdeal := by
        rw [hxC, Polynomial.coeff_zero_eq_eval_zero]; exact hf
      have h3 := x.asIdeal.add_mem h1 h2
      rwa [sub_add_cancel] at h3
    apply PrimeSpectrum.ext
    exact hM.eq_of_le x.isPrime.ne_top hle
  have hb : (Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom (0 : C))) ≫ c)
      (IsLocalRing.closedPoint C) = c x :=
    (Scheme.Hom.comp_apply _ c _).trans (congrArg c he0)

  have hF' : ∀ y, y ∉ Set.range (Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom (0 : C))) ≫ c) →
      Subsingleton ((wcEtStalk _ y).obj F) := by
    intro y hy
    rw [hrange, Set.mem_compl_iff, not_not] at hy
    exact hF y hy

  have Γ0 : ∀ t : F.obj.obj (Opposite.op (Scheme.Etale.mk (𝟙 _))), t = 0 := by
    intro t
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology (@Proj _ _ _ _ _
      (MvPolynomial.homogeneousSubmodule (Fin 2) C) MvPolynomial.gradedAlgebra))
        AddCommGrpCat.{u+1}) := HasExt.standard _
    obtain ⟨h, hh⟩ := wc_et_const_int_hom_of_global_section _ F t
    have hs : ∀ a b : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology (@Proj _ _ _ _ _
        (MvPolynomial.homogeneousSubmodule (Fin 2) C) MvPolynomial.gradedAlgebra))
          AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) F 0, a = b :=
      fun a b => @Subsingleton.elim _ hΓ a b
    have h0 : h = 0 := Abelian.Ext.homEquiv₀.symm.injective (hs _ _)
    rw [← hh, h0]
    rfl

  suffices H : ∀ γ : (wcEtStalk _ (c x)).obj F, γ = 0 from
    ⟨fun a b => (H a).trans (H b).symm⟩
  intro γ
  obtain ⟨A, g, rfl⟩ :=
    (wc_et_stalk_germ_facts _ (c x) (wc_et_geom_pt_nbhd_cofiltered _ (c x)) F).1 γ
  have hw : A.hom.left ≫ A.right.hom = wcEtGeomPt _ (c x) := Over.w A.hom
  let pt : ↥(Spec (.of (AlgebraicClosure (Scheme.residueField _ (c x))))) := default
  have hpt : ∀ p : ↥(Spec (.of (AlgebraicClosure (Scheme.residueField _ (c x))))), p = pt :=
    fun p => Subsingleton.elim p pt
  have hv : A.right.hom (A.hom.left pt) = c x := by
    have h1 : (A.hom.left ≫ A.right.hom) pt = A.right.hom (A.hom.left pt) :=
      Scheme.Hom.comp_apply _ _ _
    have h2 : (A.hom.left ≫ A.right.hom) pt = (wcEtGeomPt _ (c x)) pt :=
      by rw [hw]
    have h3 : (wcEtGeomPt _ (c x)) pt = c x :=
      (Scheme.Hom.comp_apply _ _ pt).trans (Scheme.fromSpecResidueField_apply _ _)
    exact h1.symm.trans (h2.trans h3)

  obtain ⟨V₁, c₁, v₁, e, hv₁, hc₁, hpb₁⟩ := wc_cpt_th_strict_closed_etale_tube C
    (Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom (0 : C))) ≫ c) A.right (A.hom.left pt)
    (hv.trans hb.symm)

  obtain ⟨σ, hσ⟩ := wc_cpt_th_closed_tube_section_extend
    (Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom (0 : C))) ≫ c) V₁ e hpb₁ F hF'
    ((F.obj.map c₁.op).hom g)
  have hzero : (F.obj.map c₁.op).hom g = 0 := by
    have h1 := hσ (MorphismProperty.Over.homMk V₁.hom (Category.comp_id _) trivial)
    rw [Γ0 σ] at h1
    exact h1.symm.trans (map_zero _)

  haveI := hc₁
  have hrng : Set.range A.hom.left ⊆ Set.range c₁.left := by
    rintro _ ⟨p, rfl⟩
    exact ⟨v₁, by rw [hv₁, hpt p]⟩
  let t₁ := IsOpenImmersion.lift c₁.left A.hom.left hrng
  have ht₁ : t₁ ≫ c₁.left = A.hom.left := IsOpenImmersion.lift_fac _ _ _
  have ht₁w : t₁ ≫ V₁.hom = wcEtGeomPt _ (c x) := by
    rw [← MorphismProperty.Over.w c₁, ← Category.assoc, ht₁]
    exact hw
  let A₁ : StructuredArrow (Over.mk (wcEtGeomPt _ (c x))) (Scheme.Etale.forget _) :=
    StructuredArrow.mk (Over.homMk t₁ ht₁w :
      Over.mk (wcEtGeomPt _ (c x)) ⟶ (Scheme.Etale.forget _).obj V₁)
  let φ : A₁ ⟶ A := StructuredArrow.homMk c₁ (Over.OverMorphism.ext (by
    rw [Over.comp_left]
    exact ht₁))
  have hw2 := Limits.colimit.w ((StructuredArrow.proj (Over.mk (wcEtGeomPt _ (c x)))
    (Scheme.Etale.forget _)).op ⋙ F.obj) φ.op
  rw [← hw2]
  have h3 : (((StructuredArrow.proj (Over.mk (wcEtGeomPt _ (c x)))
    (Scheme.Etale.forget _)).op ⋙ F.obj).map φ.op).hom g = 0 := hzero
  simp only [AddCommGrpCat.hom_comp, AddMonoidHom.coe_comp, Function.comp_apply]
  rw [h3, map_zero]

theorem wc_et_open_imm_shens_transport : ∀ {X Xb : Scheme.{u}} (j : X ⟶ Xb) [IsOpenImmersion j] (x₀ : X) (Λ₀ : Type u) [SmallCategory Λ₀] [IsCofiltered Λ₀] (W₀ : Λ₀ ⥤ StructuredArrow (Over.mk (wcEtGeomPt X x₀)) (Scheme.Etale.forget X)), W₀.Initial → ∃ W₀' : Λ₀ ⥤ StructuredArrow (Over.mk (wcEtGeomPt Xb (j x₀))) (Scheme.Etale.forget Xb), W₀'.Initial ∧ Nonempty (W₀' ⋙ StructuredArrow.proj (Over.mk (wcEtGeomPt Xb (j x₀))) (Scheme.Etale.forget Xb) ≅ W₀ ⋙ StructuredArrow.proj (Over.mk (wcEtGeomPt X x₀)) (Scheme.Etale.forget X) ⋙ wcEtSliceOf X j inferInstance) :=
by
  intro X Xb j _ x₀ Λ₀ _ _ W₀ hinit

  have s1 : ∃ e : Spec (.of (AlgebraicClosure (Xb.residueField (j x₀)))) ⟶
      Spec (.of (AlgebraicClosure (X.residueField x₀))),
      IsIso e ∧ e ≫ wcEtGeomPt X x₀ ≫ j = wcEtGeomPt Xb (j x₀) := by
    have hb : Function.Bijective (j.residueFieldMap x₀).hom :=
      ConcreteCategory.bijective_of_isIso (j.residueFieldMap x₀)
    let ψ : Xb.residueField (j x₀) ≃+* X.residueField x₀ :=
      RingEquiv.ofBijective (j.residueFieldMap x₀).hom hb
    let Φ : AlgebraicClosure (Xb.residueField (j x₀)) ≃+* AlgebraicClosure (X.residueField x₀) :=
      IsAlgClosure.equivOfEquiv (AlgebraicClosure (Xb.residueField (j x₀)))
        (AlgebraicClosure (X.residueField x₀)) ψ
    have hΦ : ∀ s : Xb.residueField (j x₀),
        Φ.symm (algebraMap (X.residueField x₀) (AlgebraicClosure (X.residueField x₀))
          ((j.residueFieldMap x₀).hom s)) =
        algebraMap (Xb.residueField (j x₀)) (AlgebraicClosure (Xb.residueField (j x₀))) s := by
      intro s
      have h1 := IsAlgClosure.equivOfEquiv_symm_algebraMap
        (AlgebraicClosure (Xb.residueField (j x₀))) (AlgebraicClosure (X.residueField x₀)) ψ (ψ s)
      rw [RingEquiv.symm_apply_apply] at h1
      exact h1
    haveI hiso : IsIso (CommRingCat.ofHom (Φ.symm : AlgebraicClosure (X.residueField x₀) →+*
        AlgebraicClosure (Xb.residueField (j x₀)))) :=
      (RingEquiv.toCommRingCatIso Φ.symm).isIso_hom
    refine ⟨Spec.map (CommRingCat.ofHom (Φ.symm : AlgebraicClosure (X.residueField x₀) →+*
        AlgebraicClosure (Xb.residueField (j x₀)))), inferInstance, ?_⟩
    have hring : j.residueFieldMap x₀ ≫
        CommRingCat.ofHom (algebraMap (X.residueField x₀) (AlgebraicClosure (X.residueField x₀))) ≫
        CommRingCat.ofHom (Φ.symm : AlgebraicClosure (X.residueField x₀) →+*
          AlgebraicClosure (Xb.residueField (j x₀))) =
        CommRingCat.ofHom (algebraMap (Xb.residueField (j x₀))
          (AlgebraicClosure (Xb.residueField (j x₀)))) := by
      ext s
      exact hΦ s
    have Lspec : ∀ {R S T U : CommRingCat.{u}} (a : R ⟶ S) (b : S ⟶ T) (c : T ⟶ U) (d : R ⟶ U),
        a ≫ b ≫ c = d → Spec.map d = Spec.map c ≫ Spec.map b ≫ Spec.map a := by
      intro R S T U a b c d h
      subst h
      simp only [Spec.map_comp, Category.assoc]
    have key := Lspec _ _ _ _ hring
    show _ ≫ (Spec.map _ ≫ X.fromSpecResidueField x₀) ≫ j =
      Spec.map _ ≫ Xb.fromSpecResidueField (j x₀)
    simp only [Category.assoc]
    rw [← Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField, key]
    simp only [Category.assoc]
    rfl

  have s2 : ∀ {P Q : Scheme.{u}} (xb : P ⟶ X) (y : Q ⟶ Xb) (e : Q ⟶ P), IsIso e →
      e ≫ xb ≫ j = y →
      ∃ J : StructuredArrow (Over.mk xb) (Scheme.Etale.forget X) ⥤
          StructuredArrow (Over.mk y) (Scheme.Etale.forget Xb),
        J.Initial ∧ Nonempty (J ⋙ StructuredArrow.proj (Over.mk y) (Scheme.Etale.forget Xb) ≅
          StructuredArrow.proj (Over.mk xb) (Scheme.Etale.forget X) ⋙
            wcEtSliceOf X j inferInstance) := by
    intro P Q xb y e he hey
    let Sl := wcEtSliceOf X j inferInstance

    have L1 : ∀ {A B C D E : Scheme.{u}} (a : A ⟶ B) (b : B ⟶ C) (c : C ⟶ D) (d : D ⟶ E)
        (x : B ⟶ D) (z : A ⟶ E), b ≫ c = x → a ≫ x ≫ d = z → (a ≫ b) ≫ c ≫ d = z := by
      intro A B C D E a b c d x z h1 h2
      subst h1; subst h2; simp only [Category.assoc]
    have L2 : ∀ {A B C D : Scheme.{u}} (a : A ⟶ B) (b : B ⟶ C) (c : C ⟶ D) (d : B ⟶ D),
        b ≫ c = d → (a ≫ b) ≫ c = a ≫ d := by
      intro A B C D a b c d h1
      subst h1; simp only [Category.assoc]
    have L3 : ∀ {A B C D E : Scheme.{u}} (a : A ⟶ B) [IsIso a] (s : A ⟶ C) (v : C ⟶ E)
        (x : B ⟶ D) (w : D ⟶ E) (z : A ⟶ E), s ≫ v = z → a ≫ x ≫ w = z →
        (inv a ≫ s) ≫ v = x ≫ w := by
      intro A B C D E a _ s v x w z h1 h2
      rw [Category.assoc, h1, ← h2, IsIso.inv_hom_id_assoc]
    have L4 : ∀ {A B C D : Scheme.{u}} (a : A ⟶ B) [IsIso a] (σ : B ⟶ C) (p : C ⟶ D)
        (s : A ⟶ D), σ ≫ p = inv a ≫ s → (a ≫ σ) ≫ p = s := by
      intro A B C D a _ σ p s h1
      rw [Category.assoc, h1, IsIso.hom_inv_id_assoc]
    have L5 : ∀ {A B C D : Scheme.{u}} (t : A ⟶ B) (κ : B ⟶ C) (σ : A ⟶ C) (p : C ⟶ D)
        (h : B ⟶ D), κ ≫ p = h → t ≫ h = σ ≫ p → (t ≫ κ) ≫ p = σ ≫ p := by
      intro A B C D t κ σ p h h1 h2
      rw [Category.assoc, h1, h2]
    have L6 : ∀ {A B C D : Scheme.{u}} (a : A ⟶ B) [IsIso a] (t : B ⟶ C) (h : C ⟶ D)
        (s : A ⟶ D) (w : B ⟶ D), (a ≫ t) ≫ h = s → w = inv a ≫ s → t ≫ h = w := by
      intro A B C D a _ t h s w h1 h2
      rw [h2, IsIso.eq_inv_comp, ← Category.assoc, h1]
    have hobj : ∀ c : StructuredArrow (Over.mk xb) (Scheme.Etale.forget X),
        (e ≫ c.hom.left) ≫ c.right.hom ≫ j = y := fun c =>
      L1 e c.hom.left c.right.hom j xb y (Over.w c.hom) hey
    let J : StructuredArrow (Over.mk xb) (Scheme.Etale.forget X) ⥤
        StructuredArrow (Over.mk y) (Scheme.Etale.forget Xb) :=
      { obj := fun c => StructuredArrow.mk (Y := Sl.obj c.right)
          (Over.homMk (U := Over.mk y) (V := (Scheme.Etale.forget Xb).obj (Sl.obj c.right))
            (e ≫ c.hom.left) (hobj c))
        map := fun {c c'} f => StructuredArrow.homMk (Sl.map f.right) (by
          have hf : c.hom.left ≫ f.right.left = c'.hom.left :=
            congrArg (fun z => z.left) (StructuredArrow.w f)
          apply Over.OverMorphism.ext
          exact L2 e c.hom.left f.right.left c'.hom.left hf)
        map_id := fun c => StructuredArrow.hom_ext _ _ (MorphismProperty.Over.Hom.ext rfl)
        map_comp := fun f g => StructuredArrow.hom_ext _ _ (MorphismProperty.Over.Hom.ext rfl) }
    refine ⟨J, ?_, ⟨NatIso.ofComponents (fun c => Iso.refl _) ?_⟩⟩
    · constructor
      intro d
      haveI : Etale d.right.hom := d.right.prop
      have hs : d.hom.left ≫ d.right.hom = y := Over.w d.hom
      let Vt : X.Etale := MorphismProperty.Over.mk ⊤ (Limits.pullback.snd d.right.hom j) inferInstance
      obtain ⟨σ, hσf, hσs⟩ : ∃ σ : P ⟶ Limits.pullback d.right.hom j,
          σ ≫ Limits.pullback.fst d.right.hom j = inv e ≫ d.hom.left ∧
          σ ≫ Limits.pullback.snd d.right.hom j = xb :=
        ⟨Limits.pullback.lift (inv e ≫ d.hom.left) xb
          (L3 e d.hom.left d.right.hom xb j y hs hey),
          Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
      let R : StructuredArrow (Over.mk xb) (Scheme.Etale.forget X) :=
        StructuredArrow.mk (Y := Vt) (Over.homMk (U := Over.mk xb)
          (V := (Scheme.Etale.forget X).obj Vt) σ hσs)
      let g : Sl.obj Vt ⟶ d.right :=
        MorphismProperty.Over.homMk (Limits.pullback.fst d.right.hom j)
          Limits.pullback.condition trivial
      let ε : J.obj R ⟶ d := StructuredArrow.homMk g (by
        apply Over.OverMorphism.ext
        exact L4 e σ (Limits.pullback.fst d.right.hom j) d.hom.left hσf)
      obtain ⟨κ, hκf, hκs⟩ : ∃ κ : ∀ a : CostructuredArrow J d,
          a.left.right.left ⟶ Limits.pullback d.right.hom j,
          (∀ a, κ a ≫ Limits.pullback.fst d.right.hom j = a.hom.right.left) ∧
          (∀ a, κ a ≫ Limits.pullback.snd d.right.hom j = a.left.right.hom) :=
        ⟨fun a => Limits.pullback.lift a.hom.right.left a.left.right.hom
            (MorphismProperty.Over.w a.hom.right),
          fun a => Limits.pullback.lift_fst _ _ _, fun a => Limits.pullback.lift_snd _ _ _⟩
      let kr : ∀ a : CostructuredArrow J d, a.left.right ⟶ Vt := fun a =>
        MorphismProperty.Over.homMk (κ a) (hκs a) trivial
      let k : ∀ a : CostructuredArrow J d, a.left ⟶ R := fun a =>
        StructuredArrow.homMk (kr a) (by
          apply Over.OverMorphism.ext
          show a.left.hom.left ≫ κ a = σ
          have hw : (e ≫ a.left.hom.left) ≫ a.hom.right.left = d.hom.left :=
            congrArg (fun z => z.left) (StructuredArrow.w a.hom)
          apply Limits.pullback.hom_ext
          · exact L5 a.left.hom.left (κ a) σ (Limits.pullback.fst d.right.hom j)
              a.hom.right.left (hκf a)
              ((L6 e a.left.hom.left a.hom.right.left d.hom.left _ hw hσf))
          · exact L5 a.left.hom.left (κ a) σ (Limits.pullback.snd d.right.hom j)
              a.left.right.hom (hκs a) ((Over.w a.left.hom).trans hσs.symm))
      let hom : ∀ a : CostructuredArrow J d, a ⟶ CostructuredArrow.mk ε := fun a =>
        CostructuredArrow.homMk (k a) (StructuredArrow.hom_ext _ _
          (MorphismProperty.Over.Hom.ext (hκf a)))
      refine isConnected_of_isTerminal _ (Limits.IsTerminal.ofUniqueHom hom ?_)
      intro a m
      refine CostructuredArrow.hom_ext _ _ (StructuredArrow.hom_ext _ _
        (MorphismProperty.Over.Hom.ext ?_))
      show m.left.right.left = κ a
      apply Limits.pullback.hom_ext
      · exact (congrArg (fun z => z.right.left) (CostructuredArrow.w m)).trans (hκf a).symm
      · exact (MorphismProperty.Over.w m.left.right).trans (hκs a).symm
    · intro c c' f
      simp only [Iso.refl_hom, Category.comp_id, Category.id_comp]
      rfl

  obtain ⟨e, he, hcomm⟩ := s1
  obtain ⟨J, hJ, ⟨θ⟩⟩ := s2 (wcEtGeomPt X x₀) (wcEtGeomPt Xb (j x₀)) e he hcomm
  haveI := hinit
  haveI := hJ
  exact ⟨W₀ ⋙ J, Functor.initial_comp W₀ J,
    ⟨Functor.associator W₀ J _ ≪≫ Functor.isoWhiskerLeft W₀ θ⟩⟩

theorem wc_cpt_th_tube_stalk_iso : ∀ (C : Type u) [CommRing C] (j c : Spec (.of (Polynomial C)) ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) C) MvPolynomial.gradedAlgebra), IsOpenImmersion j → IsOpenImmersion c → IsAffineHom j → IsPullback (Spec.map (CommRingCat.ofHom (Polynomial.eval₂RingHom (algebraMap C (LaurentPolynomial C)) (LaurentPolynomial.T (-1))))) (Spec.map (CommRingCat.ofHom (Polynomial.toLaurent : Polynomial C →+* LaurentPolynomial C))) j c → ∀ (m : ℕ) (I : InjectiveResolution ((constantSheaf (Scheme.smallEtaleTopology (Spec (.of (Polynomial C)))) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))) (x : Spec (.of (Polynomial C))) (E : Type u) [CommRing E] [HenselianLocalRing E] [IsSepClosed (IsLocalRing.ResidueField E)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (Polynomial C))) x)) (Scheme.Etale.forget (Spec (.of (Polynomial C))))) (φ : ∀ l, Spec (.of E) ⟶ (W'.obj l).right.left) (a : Spec (.of E) ⟶ Spec (.of (Polynomial C))), wcHalShData x E Λ W' φ a → ∀ (ε : Polynomial C →+* E), Spec.map (CommRingCat.ofHom ε) = a → ∀ q : ℕ, Nonempty ((wcEtStalk _ (c x)).obj ((((wcEtPush j).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q) ≃ wcEtCoh (Spec (.of (Localization.Away (ε Polynomial.X)))) m q) :=
by
  intro C _ j c hj hc hja hsq m I x E _ _ _ Λ _ _ W' φ a hE ε hε q
  haveI := hc
  haveI := hja
  obtain ⟨hInit, hAff, hcomp, hcone, hlim, -⟩ := hE

  obtain ⟨W₀', hW₀', ⟨θ⟩⟩ := wc_et_open_imm_shens_transport c x Λ W' hInit

  obtain ⟨e1⟩ := wc_et_stalk_push_homology j (c x) Λ W₀' hW₀' I.cocomplex q

  let α := Functor.isoWhiskerLeft
    (sheafToPresheaf (Scheme.smallEtaleTopology (Spec (.of (Polynomial C)))) AddCommGrpCat.{u+1})
    (Functor.isoWhiskerLeft
      ((Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj
        (@Functor.op _ _ _ _ (wcEtBaseChange j)))
      (Functor.isoWhiskerRight
        ((Functor.whiskeringLeft Λᵒᵖ _ AddCommGrpCat.{u+1}).mapIso (NatIso.op θ))
        Limits.colim))
  let e2 := (HomologicalComplex.homologyMapIso
    ((NatIso.mapHomologicalComplex α (ComplexShape.up ℕ)).app I.cocomplex) q).addCommGroupIsoToAddEquiv.toEquiv

  obtain ⟨e3⟩ := wc_et_limit_push_homology_affine j E Λ
    (W' ⋙ StructuredArrow.proj (Over.mk (wcEtGeomPt (Spec (.of (Polynomial C))) x))
      (Scheme.Etale.forget (Spec (.of (Polynomial C)))) ⋙
      wcEtSliceOf (Spec (.of (Polynomial C))) c inferInstance)
    φ (a ≫ c) (fun l => hAff l) (fun t => hcomp t)
    (fun l => by
      show φ l ≫ ((W'.obj l).right.hom ≫ c) = a ≫ c
      rw [← Category.assoc, hcone l])
    (fun T z hz => hlim T z hz) m I q

  have hy : Submonoid.powers (Polynomial.X : Polynomial C) ≤
      Submonoid.comap ε (Submonoid.powers (ε Polynomial.X)) := by
    rw [Submonoid.powers_le]; exact Submonoid.mem_powers _
  haveI : IsLocalization (Submonoid.map ε (Submonoid.powers (Polynomial.X : Polynomial C)))
      (Localization.Away (ε Polynomial.X)) := by
    rw [Submonoid.map_powers]; exact Localization.isLocalization
  have hmc := IsLocalization.map_comp (S := LaurentPolynomial C)
    (Q := Localization.Away (ε Polynomial.X)) hy
  have hpo := CommRingCat.isPushout_of_isLocalization ε
    (IsLocalization.map (Localization.Away (ε Polynomial.X)) ε hy : LaurentPolynomial C →+* _) hmc
    (Submonoid.powers (Polynomial.X : Polynomial C))
  have hpb := isPullback_SpecMap_of_isPushout _ _ _ _ hpo.flip
  have hal : algebraMap (Polynomial C) (LaurentPolynomial C) =
      (Polynomial.toLaurent : Polynomial C →+* LaurentPolynomial C) :=
    RingHom.ext fun f => LaurentPolynomial.algebraMap_eq_toLaurent f
  rw [hal, hε] at hpb

  have hP := hpb.paste_horiz hsq
  obtain ⟨e4⟩ := wc_et_coh_iso_invariance hP.isoPullback.hom m q
  exact ⟨e1.trans (e2.symm.trans (e3.trans e4))⟩

theorem wc_cpt_tube_high : ∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] [IsDomain A] [IsDiscreteValuationRing A] (ℓ : ℕ), ℓ.Prime → IsUnit ((ℓ : ℕ) : A) → ∀ (d : ℕ) (y : Spec (.of (MvPolynomial (Option (Fin d)) A))), Spec.map (CommRingCat.ofHom (algebraMap A (MvPolynomial (Option (Fin d)) A))) y = IsLocalRing.closedPoint A → (MvPolynomial.X none : MvPolynomial (Option (Fin d)) A) ∈ y.asIdeal → ∀ (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (MvPolynomial (Option (Fin d)) A))) y)) (Scheme.Etale.forget (Spec (.of (MvPolynomial (Option (Fin d)) A))))) (φ : ∀ l, Spec (.of B) ⟶ (W'.obj l).right.left) (a : Spec (.of B) ⟶ Spec (.of (MvPolynomial (Option (Fin d)) A))), wcHalShData y B Λ W' φ a → ∀ (β : MvPolynomial (Option (Fin d)) A →+* B), Spec.map (CommRingCat.ofHom β) = a → ∀ q : ℕ, 2 ≤ q → Subsingleton (wcEtCoh (Spec (.of (Localization.Away (β (MvPolynomial.X none))))) ℓ q) :=
by
  intro A _ _ _ _ _ ℓ hℓ hunit d y hy hy0 B _ _ _ Λ _ _ W' φ a ha β hβ q hq
  classical

  have s4 : ∀ {U P : Scheme.{u}} (j : U ⟶ P) [IsOpenImmersion j] [IsAffineHom j]
      (I : InjectiveResolution ((constantSheaf (Scheme.smallEtaleTopology U)
