      rw [Category.assoc]; exact Limits.pullback.condition
    obtain ⟨t, ht1, ht2⟩ : ∃ t : Limits.pullback (e ≫ Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) zb ⟶ Spec (.of (Polynomial L)),
