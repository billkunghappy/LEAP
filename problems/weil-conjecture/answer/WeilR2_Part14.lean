            (F.map u).hom (MvPolynomial.aeval x (MvPolynomial.X k))
          rw [MvPolynomial.aeval_X, MvPolynomial.aeval_X]
      intro z
      exact RingHom.congr_fun e z
    have hkerle : ∀ a ∈ RingHom.ker f, ψ₁ a = 0 := by
      intro a ha
      have ha' : a ∈ Submodule.span (MvPolynomial (Fin N) R) (Set.range K) := by
        rw [hK]; exact ha
      have hle : Submodule.span (MvPolynomial (Fin N) R) (Set.range K) ≤ RingHom.ker ψ₁ := by
        rw [Submodule.span_le]
