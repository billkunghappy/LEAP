  have hwN : (W'.obj l₁).hom.left ≫ (W'.obj l₁).right.hom =
      wcEtGeomPt (Spec (.of (MvPolynomial (Option (Fin d)) A))) y := Over.w (W'.obj l₁).hom
  have hγ : ∀ x, wcEtGeomPt (Spec (.of (MvPolynomial (Option (Fin d)) A))) y x = y := by
    intro x
    first
    | exact Scheme.fromSpecResidueField_apply y _
    | (unfold wcEtGeomPt; rw [comp_ap]; exact Scheme.fromSpecResidueField_apply y _)
    | (simp only [wcEtGeomPt, comp_ap, Scheme.fromSpecResidueField_apply])
    | simp [wcEtGeomPt]
  have hkey : ∀ x, (W'.obj l₁).right.hom ((W'.obj l₁).hom.left x) = y := fun x =>
    (comp_ap (W'.obj l₁).hom.left (W'.obj l₁).right.hom x).symm.trans
      ((congrArg (fun g => g x) hwN).trans (hγ x))
  have hcp : a (IsLocalRing.closedPoint B) = y := by
    calc a (IsLocalRing.closedPoint B)
        = (φ l₁ ≫ (W'.obj l₁).right.hom) (IsLocalRing.closedPoint B) := by rw [hφa]
      _ = (W'.obj l₁).right.hom (φ l₁ (IsLocalRing.closedPoint B)) := comp_ap _ _ _
      _ = y := by
          rw [hcl]
          exact hkey _
  have hu_m : β (MvPolynomial.X none) ∈ IsLocalRing.maximalIdeal B := by
    have h1 : Spec.map (CommRingCat.ofHom β) (IsLocalRing.closedPoint B) = y := by
      rw [hβ]; exact hcp
    have h2 : (MvPolynomial.X none : MvPolynomial (Option (Fin d)) A) ∈
        (Spec.map (CommRingCat.ofHom β) (IsLocalRing.closedPoint B)).asIdeal := by
      rw [h1]; exact hy0
    first
    | (rw [Spec.map_apply, PrimeSpectrum.comap_asIdeal] at h2; exact h2)
    | exact h2
  have hu'nu : ¬ IsUnit (σ (MvPolynomial.X none)) := by
    intro h
    have h2 := h.map Φ
    rw [hΦ] at h2
    exact mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal _).mp hu_m) h2

  have hreg0 : IsSMulRegular (MvPolynomial (Option (Fin d)) A)
      (MvPolynomial.X none : MvPolynomial (Option (Fin d)) A) := by
    rw [isSMulRegular_iff_right_eq_zero_of_smul]
    intro m hm
    rw [smul_eq_mul] at hm
    exact (mul_eq_zero.mp hm).resolve_left (MvPolynomial.X_ne_zero _)
  have hreg1 := IsSMulRegular.of_flat (S := R') hreg0
  have hu'0 : σ (MvPolynomial.X none) ≠ 0 := by
    intro h0
    have h2 : (algebraMap (MvPolynomial (Option (Fin d)) A) R' (MvPolynomial.X none)) • (1 : R') =
        (algebraMap (MvPolynomial (Option (Fin d)) A) R' (MvPolynomial.X none)) • (0 : R') := by
      show σ (MvPolynomial.X none) • (1 : R') = σ (MvPolynomial.X none) • (0 : R')
      rw [h0, zero_smul, zero_smul]
    exact one_ne_zero (hreg1 h2)

  obtain ⟨hTd, hTu⟩ := hquot A d
  have hu' : Prime (σ (MvPolynomial.X none)) :=
    ⟨hu'0, hu'nu, fun a₁ b₁ h => primeCrit _ R' σ hσ _ hTd hTu hu'nu a₁ b₁ h⟩
  have hu : Prime (β (MvPolynomial.X none)) := by
    rw [← hΦ (MvPolynomial.X none)]
    exact (MulEquiv.prime_iff Φ).mpr hu'
  exact ⟨hBd, hBl, hu⟩

theorem wc_cpt_ring_kummer_h1_card : ∀ (C : Type u) [CommRing C] (ℓ : ℕ), ℓ.Prime → IsUnit ((ℓ : ℕ) : C) → ∀ (ζ : C), IsPrimitiveRoot ζ ℓ → (∀ i : ℕ, 0 < i → i < ℓ → IsUnit (1 - ζ ^ i)) → Nat.card (wcEtCoh (Spec (.of C)) ℓ 1) = Nat.card {x : CommRing.Pic C // x ^ ℓ = 1} * Nat.card (Cˣ ⧸ (powMonoidHom ℓ : Cˣ →* Cˣ).range) :=
by
  intro C _ ℓ hℓ hunit ζ hζ h1u
  classical
  have hℓ0 : ℓ ≠ 0 := hℓ.ne_zero
  have hℓpos : 0 < ℓ := hℓ.pos

  have hprimMap : ∀ (R : Type u) [CommRing R] [Nontrivial R] (g : C →+* R),
      IsPrimitiveRoot (g ζ) ℓ := by
    intro R _ _ g
    refine IsPrimitiveRoot.mk_of_lt _ hℓpos ?_ ?_
    · rw [← map_pow, hζ.pow_eq_one, map_one]
    · intro l hl0 hlℓ h1
      have := (h1u l hl0 hlℓ).map g
      rw [map_sub, map_one, map_pow, h1, sub_self] at this
      exact not_isUnit_zero this

  have hkappa : ∀ (X : Scheme.{u}) (θ : C →+* Γ(X, ⊤)), ∃ κ : (Functor.const (Scheme.Etale X)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))) ⟶ wcEtGmPre X, κ ≫ (ℓ • 𝟙 (wcEtGmPre X)) = 0 ∧ Presheaf.IsLocallyInjective (Scheme.smallEtaleTopology X) κ ∧ ∀ (U : Scheme.Etale X) (s : ToType ((wcEtGmPre X).obj (Opposite.op U))), (ℓ • 𝟙 (wcEtGmPre X)).app (Opposite.op U) s = 0 → Presheaf.imageSieve κ s ∈ Scheme.smallEtaleTopology X U := by
    intro X θ
    haveI : NeZero ℓ := ⟨hℓ0⟩
    have s2 : ∀ (O : Type u) [CommRing O] [IsLocalRing O] (φ : C →+* O) (v : O),
        v ^ ℓ = 1 → ∃ k : ℕ, v = φ ζ ^ k := by
      intro O _ _ φ v hv
      let π := IsLocalRing.residue O
      have hprim : IsPrimitiveRoot ((π.comp φ) ζ) ℓ := hprimMap _ (π.comp φ)
      have hπv : π v ^ ℓ = 1 := by rw [← map_pow, hv, map_one]
      obtain ⟨i, -, hiv⟩ := hprim.eq_pow_of_pow_eq_one hπv
      refine ⟨i, ?_⟩
      have hw : (φ ζ ^ i) ^ ℓ = 1 := by
        rw [← pow_mul, mul_comm, pow_mul, ← map_pow, hζ.pow_eq_one, map_one, one_pow]
      have hπw : π (φ ζ ^ i) = π v := by rw [map_pow]; exact hiv
      have hS : (∑ j ∈ Finset.range ℓ, v ^ j * (φ ζ ^ i) ^ (ℓ - 1 - j)) * (v - φ ζ ^ i) = 0 := by
        rw [geom_sum₂_mul, hv, hw, sub_self]
      have hSu : IsUnit (∑ j ∈ Finset.range ℓ, v ^ j * (φ ζ ^ i) ^ (ℓ - 1 - j)) := by
        rw [← IsLocalRing.residue_ne_zero_iff_isUnit]
        have e : π (∑ j ∈ Finset.range ℓ, v ^ j * (φ ζ ^ i) ^ (ℓ - 1 - j)) =
            (ℓ : IsLocalRing.ResidueField O) * π v ^ (ℓ - 1) := by
          rw [map_sum, ← geom_sum₂_self]
          refine Finset.sum_congr rfl (fun j _ => ?_)
          rw [map_mul, map_pow, map_pow, hπw]
        rw [e]
        refine mul_ne_zero ?_ (pow_ne_zero _ ?_)
        · have h1 : (ℓ : IsLocalRing.ResidueField O) = (π.comp φ) (ℓ : C) := by rw [map_natCast]
          rw [h1]
          exact (hunit.map (π.comp φ)).ne_zero
        · intro h0
          rw [h0, zero_pow hℓ0] at hπv
          exact zero_ne_one hπv
      exact sub_eq_zero.mp (hSu.mul_right_eq_zero.mp hS)
    have s3 : ∀ (Y : Scheme.{u}) (y : Y) (a b : Γ(Y, ⊤)),
        (Y.presheaf.germ ⊤ y trivial).hom a = (Y.presheaf.germ ⊤ y trivial).hom b →
        ∃ W : Y.Opens, y ∈ W ∧ W.ι.appTop.hom a = W.ι.appTop.hom b := by
      intro Y y a b h
      obtain ⟨W, hyW, iU, iV, e⟩ :=
        TopCat.Presheaf.germ_eq (U := ⊤) (V := ⊤) Y.presheaf y trivial trivial a b h
      refine ⟨W, hyW, ?_⟩
      obtain rfl : iV = iU := Subsingleton.elim _ _
      have e' : (Y.presheaf.map iV.op).hom a = (Y.presheaf.map iV.op).hom b := e
      have gen : ∀ (V : Y.Opens) (j : V ⟶ ⊤), V ≤ W →
          (Y.presheaf.map j.op).hom a = (Y.presheaf.map j.op).hom b := by
        intro V j hVW
        obtain rfl : j = homOfLE hVW ≫ iV := Subsingleton.elim _ _
        rw [op_comp, Functor.map_comp, CommRingCat.comp_apply, CommRingCat.comp_apply, e']
      rw [Scheme.Opens.ι_appTop]
      exact gen _ _ (by simp)
    have hcov : ∀ (V : X.Etale) (S : Sieve V), (∀ v : V.left, ∃ (V₁ : X.Etale) (c : V₁ ⟶ V),
        S.arrows c ∧ v ∈ Set.range c.left) → S ∈ Scheme.smallEtaleTopology X V := by
      intro V S hS
      change S ∈ Scheme.smallGrothendieckTopology @Etale X V
      rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale X
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
      apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale X
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
      intro x
      obtain ⟨V₁, c, hc, y, hy⟩ := hS x
      have hw : c.left ≫ V.hom = V₁.hom := MorphismProperty.Over.w c
      have hEt : Etale c.left := by
        have h1 : Etale V.hom := V.prop
        have h2 : Etale (c.left ≫ V.hom) := by rw [hw]; exact V₁.prop
        exact Etale.of_comp c.left V.hom
      exact ⟨V₁, c, y, hc, hEt, hy⟩
    have hG3 : ∀ (U : X.Etale) (a b : ToType ((wcEtGmPre X).obj (Opposite.op U))),
        ((Additive.toMul a.down : (Γ(U.left, ⊤))ˣ) : Γ(U.left, ⊤)) =
          ((Additive.toMul b.down : (Γ(U.left, ⊤))ˣ) : Γ(U.left, ⊤)) → a = b :=
      fun U a b h => ULift.ext _ _ (Additive.toMul.injective (Units.ext h))
    let ψ : ∀ U : X.Etale, C →+* Γ(U.left, ⊤) := fun U => U.hom.appTop.hom.comp θ
    have hψnat : ∀ (U V : X.Etale) (f : V ⟶ U) (a : C), f.left.appTop.hom (ψ U a) = ψ V a := by
      intro U V f a
      have hw : f.left ≫ U.hom = V.hom := MorphismProperty.Over.w f
      simp only [ψ, RingHom.comp_apply]
      rw [← hw, Scheme.Hom.comp_appTop]
      rfl
    have hζmod : ∀ (m : ℕ), ζ ^ m = ζ ^ (m % ℓ) := fun m => by
      conv_lhs => rw [← Nat.div_add_mod m ℓ, pow_add, pow_mul, hζ.pow_eq_one, one_pow, one_mul]
    have hζu : IsUnit ζ := hζ.isUnit hℓ0
    let zU : ∀ U : X.Etale, (Γ(U.left, ⊤))ˣ := fun U => Units.map (ψ U).toMonoidHom hζu.unit
    have hzU : ∀ U : X.Etale, ((zU U : (Γ(U.left, ⊤))ˣ) : Γ(U.left, ⊤)) = ψ U ζ := fun U => by
      simp [zU]
    have hzpow : ∀ (U : X.Etale) (m : ℕ), ((zU U ^ m : (Γ(U.left, ⊤))ˣ) : Γ(U.left, ⊤)) = ψ U ζ ^ m :=
      fun U m => by rw [Units.val_pow_eq_pow_val, hzU]
    have hψmod : ∀ (U : X.Etale) (m : ℕ), ψ U ζ ^ m = ψ U ζ ^ (m % ℓ) := fun U m => by
      rw [← map_pow, ← map_pow, ← hζmod]
    have hzmod : ∀ (U : X.Etale) (m : ℕ), zU U ^ m = zU U ^ (m % ℓ) := fun U m => by
      ext
      rw [hzpow, hzpow, ← hψmod]
    let κf : ∀ U : X.Etale, ULift.{u+1} (ZMod ℓ) →+ ULift.{u+1} (Additive (Γ(U.left, ⊤))ˣ) :=
      fun U => AddMonoidHom.mk' (fun x => ULift.up (Additive.ofMul (zU U ^ x.down.val))) (by
        intro a b
        apply ULift.ext
        apply Additive.toMul.injective
        change zU U ^ (a.down + b.down).val = zU U ^ a.down.val * zU U ^ b.down.val
        rw [ZMod.val_add, ← hzmod, pow_add])
    let κ : (Functor.const (Scheme.Etale X)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))) ⟶
        wcEtGmPre X :=
      { app := fun U => AddCommGrpCat.ofHom (κf U.unop)
        naturality := by
          intro U V f
          ext x
          apply hG3 V.unop
          change ((zU V.unop ^ x.down.val : (Γ(V.unop.left, ⊤))ˣ) : Γ(V.unop.left, ⊤)) =
            f.unop.left.appTop.hom ((zU U.unop ^ x.down.val : (Γ(U.unop.left, ⊤))ˣ) : Γ(U.unop.left, ⊤))
          rw [hzpow, hzpow, map_pow, hψnat] }
    have hκv : ∀ (U : X.Etale) (x : ULift.{u+1} (ZMod ℓ)),
        ((Additive.toMul (κ.app (Opposite.op U) x).down : (Γ(U.left, ⊤))ˣ) : Γ(U.left, ⊤)) =
          ψ U ζ ^ x.down.val := fun U x => hzpow U x.down.val
    refine ⟨κ, ?_, ?_, ?_⟩
    · rw [Preadditive.comp_nsmul, Category.comp_id]
      ext U x
      simp only [NatTrans.app_nsmul, NatTrans.app_zero, AddCommGrpCat.hom_nsmul,
        AddCommGrpCat.hom_zero, AddMonoidHom.nsmul_apply, AddMonoidHom.zero_apply]
      apply ULift.ext
      apply Additive.toMul.injective
      change (zU U.unop ^ x.down.val) ^ ℓ = 1
      rw [← pow_mul, mul_comm, pow_mul, hzmod U.unop ℓ, Nat.mod_self, pow_zero, one_pow]
    · refine ⟨fun {U'} x y hxy => ?_⟩
      obtain ⟨U⟩ := U'
      rcases isEmpty_or_nonempty U.left with hE | ⟨⟨y₀⟩⟩
      · exact hcov _ _ (fun v => isEmptyElim v)
      · haveI : Nontrivial Γ(U.left, ⊤) := @Scheme.component_nontrivial U.left ⊤ ⟨⟨y₀, trivial⟩⟩
        have hprim := hprimMap _ (ψ U)
        have h1 : ψ U ζ ^ x.down.val = ψ U ζ ^ y.down.val := by
          rw [← hκv U x, ← hκv U y]
          exact congrArg (fun t : ToType ((wcEtGmPre X).obj (Opposite.op U)) =>
            ((Additive.toMul t.down : (Γ(U.left, ⊤))ˣ) : Γ(U.left, ⊤))) hxy
        have hval := hprim.pow_inj (ZMod.val_lt _) (ZMod.val_lt _) h1
        have hxy' : x = y := ULift.ext _ _ (ZMod.val_injective _ hval)
        subst hxy'
        rw [Presheaf.equalizerSieve_self_eq_top]
        exact (Scheme.smallEtaleTopology X).top_mem _
    · intro U s hs
      have hs' : ℓ • s = 0 := by
        first
          | exact hs
          | simpa using hs
      have hv : ((Additive.toMul s.down : (Γ(U.left, ⊤))ˣ) : Γ(U.left, ⊤)) ^ ℓ = 1 :=
        congrArg (fun t : ToType ((wcEtGmPre X).obj (Opposite.op U)) =>
            ((Additive.toMul t.down : (Γ(U.left, ⊤))ˣ) : Γ(U.left, ⊤))) hs'
      refine hcov U _ (fun y => ?_)
      obtain ⟨k, hk⟩ := s2 (U.left.presheaf.stalk y)
        ((U.left.presheaf.germ ⊤ y trivial).hom.comp (ψ U))
        ((U.left.presheaf.germ ⊤ y trivial).hom
          ((Additive.toMul s.down : (Γ(U.left, ⊤))ˣ) : Γ(U.left, ⊤)))
        (by rw [← map_pow, hv, map_one])
      rw [RingHom.comp_apply, ← map_pow] at hk
      obtain ⟨W, hyW, hW⟩ := s3 U.left y _ _ hk
      let V₁ : X.Etale := MorphismProperty.Over.mk ⊤ (W.ι ≫ U.hom) inferInstance
      let c : V₁ ⟶ U := MorphismProperty.Over.homMk W.ι rfl trivial
      refine ⟨V₁, c, ⟨ULift.up (k : ZMod ℓ), ?_⟩, ?_⟩
      · apply hG3 V₁
        rw [hκv]
        change _ = W.ι.appTop.hom ((Additive.toMul s.down : (Γ(U.left, ⊤))ˣ) : Γ(U.left, ⊤))
        rw [hW, map_pow, show W.ι.appTop.hom (ψ U ζ) = ψ V₁ ζ from hψnat U V₁ c ζ,
          ZMod.val_natCast]
        exact (hψmod V₁ k).symm
      · exact ⟨⟨y, hyW⟩, rfl⟩

  have hsurjM : ∀ (X : Scheme.{u}) (θ : C →+* Γ(X, ⊤)),
      Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology X) (ℓ • 𝟙 (wcEtGmPre X)) := by
    intro X θ
    have s2 : ∀ (R : Type u) [CommRing R], IsUnit (ℓ : R) → ∀ a : R, IsUnit a →
        ∃ (B : Type u) (_ : CommRing B) (_ : Algebra R B), Algebra.Etale R B ∧
          Function.Surjective (PrimeSpectrum.comap (algebraMap R B)) ∧
          ∃ t : B, t ^ ℓ = algebraMap R B a := by
      intro R _ hMR a ha
      set f : Polynomial R := Polynomial.X ^ ℓ - Polynomial.C a with hf
      have hfm : f.Monic := Polynomial.monic_X_pow_sub_C a hℓ0
      obtain ⟨u, hu⟩ := (hMR.mul ha).exists_left_inv
      have hcert : ∃ (p₁ p₂ : Polynomial R) (n : ℕ),
          Polynomial.derivative f * p₁ + f * p₂ = (1 : Polynomial R) ^ n := by
        refine ⟨Polynomial.C u * Polynomial.X, -(Polynomial.C u * Polynomial.C (ℓ : R)), 1, ?_⟩
        have hd : Polynomial.derivative f = Polynomial.C (ℓ : R) * Polynomial.X ^ (ℓ - 1) := by
          rw [hf, Polynomial.derivative_sub, Polynomial.derivative_X_pow, Polynomial.derivative_C,
            sub_zero]
        have hX : Polynomial.X ^ (ℓ - 1) * Polynomial.X = (Polynomial.X : Polynomial R) ^ ℓ :=
          pow_sub_one_mul hℓ0 Polynomial.X
        have hu' : Polynomial.C u * (Polynomial.C (ℓ : R) * Polynomial.C a) = 1 := by
          rw [← map_mul, ← map_mul, hu, map_one]
        rw [hd, hf, pow_one]
        linear_combination hu' + (Polynomial.C u * Polynomial.C (ℓ : R)) * hX
      let P : StandardEtalePair R := ⟨f, hfm, 1, hcert⟩
      have e₂ : AdjoinRoot f ≃ₐ[R] Localization.Away ((AdjoinRoot.mk f) 1) :=
        (IsLocalization.atUnit (AdjoinRoot f) (Localization.Away ((AdjoinRoot.mk f) 1))
          ((AdjoinRoot.mk f) 1) (by simp)).restrictScalars R
      have e : P.Ring ≃ₐ[R] AdjoinRoot f := P.equivAwayAdjoinRoot.trans e₂.symm
      have het : Algebra.Etale R (AdjoinRoot f) := Algebra.Etale.of_equiv e
      refine ⟨AdjoinRoot f, inferInstance, inferInstance, het, ?_, AdjoinRoot.root f, ?_⟩
      · rcases subsingleton_or_nontrivial R with hR | hR
        · have : IsEmpty (PrimeSpectrum R) := PrimeSpectrum.isEmpty_iff_subsingleton.mpr hR
          intro x
          exact isEmptyElim x
        · have : Module.Free R (AdjoinRoot f) := hfm.free_adjoinRoot
          let pb := AdjoinRoot.powerBasis' hfm
          have hdim : 0 < pb.dim := by
            rw [AdjoinRoot.powerBasis'_dim, hf, Polynomial.natDegree_X_pow_sub_C]
            exact Nat.pos_of_ne_zero hℓ0
          have : Nontrivial (AdjoinRoot f) := nontrivial_of_ne _ _ (pb.basis.ne_zero ⟨0, hdim⟩)
          exact PrimeSpectrum.comap_surjective_of_faithfullyFlat
      · have h1 : Polynomial.aeval (AdjoinRoot.root f) f = 0 := by
          rw [AdjoinRoot.aeval_eq, AdjoinRoot.mk_self]
        rw [hf, map_sub, Polynomial.aeval_X_pow, Polynomial.aeval_C] at h1
        exact sub_eq_zero.mp h1
    have s3 : ∀ (Y : Scheme.{u}) (B : Type u) [CommRing B] [Algebra Γ(Y, ⊤) B],
        Algebra.Etale Γ(Y, ⊤) B → Function.Surjective (PrimeSpectrum.comap (algebraMap Γ(Y, ⊤) B)) →
        ∃ (V : Scheme.{u}) (p : V ⟶ Y) (ψ : B →+* Γ(V, ⊤)), Etale p ∧ Function.Surjective p ∧
          ∀ r : Γ(Y, ⊤), ψ (algebraMap Γ(Y, ⊤) B r) = p.appTop.hom r := by
      intro Y B _ _ hB hsurj
      let φ : CommRingCat.of Γ(Y, ⊤) ⟶ CommRingCat.of B := CommRingCat.ofHom (algebraMap Γ(Y, ⊤) B)
      let g : Spec (CommRingCat.of B) ⟶ Spec (CommRingCat.of Γ(Y, ⊤)) := Spec.map φ
      have hg : Etale g := by
        apply (HasRingHomProperty.Spec_iff (P := @Etale)).mpr
        rw [CommRingCat.hom_ofHom]
        exact RingHom.etale_algebraMap.mpr hB
      have hgs : Surjective g := by
        constructor
        exact hsurj
      let p := Limits.pullback.fst Y.toSpecΓ g
      let q := Limits.pullback.snd Y.toSpecΓ g
      refine ⟨Limits.pullback Y.toSpecΓ g, p,
        ((Scheme.ΓSpecIso (CommRingCat.of B)).inv ≫ q.appTop).hom,
        inferInstance, p.surjective, fun r => ?_⟩
      have hc : Y.toSpecΓ.appTop ≫ p.appTop = g.appTop ≫ q.appTop := by
        rw [← Scheme.Hom.comp_appTop, ← Scheme.Hom.comp_appTop, Limits.pullback.condition]
      have hn := Scheme.ΓSpecIso_inv_naturality φ
      have key : φ ≫ (Scheme.ΓSpecIso (CommRingCat.of B)).inv ≫ q.appTop = p.appTop := by
        rw [← Category.assoc, hn, Category.assoc, ← hc, Scheme.toSpecΓ_appTop]
        exact Iso.inv_hom_id_assoc _ _
      exact congrArg (fun h => h.hom r) key
    have hcov : ∀ (V : X.Etale) (S : Sieve V), (∀ v : V.left, ∃ (V₁ : X.Etale) (c : V₁ ⟶ V),
        S.arrows c ∧ v ∈ Set.range c.left) → S ∈ Scheme.smallEtaleTopology X V := by
      intro V S hS
      change S ∈ Scheme.smallGrothendieckTopology @Etale X V
      rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale X
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
      apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale X
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
      intro x
      obtain ⟨V₁, c, hc, y, hy⟩ := hS x
      have hw : c.left ≫ V.hom = V₁.hom := MorphismProperty.Over.w c
      have hEt : Etale c.left := by
        have h1 : Etale V.hom := V.prop
        have h2 : Etale (c.left ≫ V.hom) := by rw [hw]; exact V₁.prop
        exact Etale.of_comp c.left V.hom
      exact ⟨V₁, c, y, hc, hEt, hy⟩
    refine Presheaf.IsLocallySurjective.mk (fun {U} s => ?_)
    let aU : (Γ(U.left, ⊤))ˣ := Additive.toMul s.down
    have hMR : IsUnit (ℓ : Γ(U.left, ⊤)) := by
      rw [← map_natCast (U.hom.appTop.hom.comp θ)]
      exact hunit.map _
    obtain ⟨B, _, _, hBet, hBsurj, t, ht⟩ := s2 Γ(U.left, ⊤) hMR (aU : Γ(U.left, ⊤)) aU.isUnit
    obtain ⟨V, p, ψ, hpet, hpsurj, hψ⟩ := s3 U.left B hBet hBsurj
    have hT : ψ t ^ ℓ = p.appTop.hom (aU : Γ(U.left, ⊤)) := by rw [← map_pow, ht, hψ]
    have hTu : IsUnit (ψ t) := by
      have h1 : IsUnit (ψ t ^ ℓ) := by rw [hT]; exact aU.isUnit.map _
      exact (isUnit_pow_iff hℓ0).mp h1
    haveI := hpet
    let V₁ : X.Etale := MorphismProperty.Over.mk ⊤ (p ≫ U.hom) inferInstance
    let c : V₁ ⟶ U := MorphismProperty.Over.homMk p rfl trivial
    have hc : (Presheaf.imageSieve (ℓ • 𝟙 (wcEtGmPre X)) s).arrows c := by
      refine ⟨ULift.up (Additive.ofMul hTu.unit), ?_⟩
      simp only [NatTrans.app_nsmul, NatTrans.id_app, AddCommGrpCat.hom_nsmul,
        AddMonoidHom.nsmul_apply, AddCommGrpCat.hom_id, AddMonoidHom.id_apply]
      apply ULift.ext
      apply Additive.toMul.injective
      apply Units.ext
      change ((hTu.unit ^ ℓ : (Γ(V, ⊤))ˣ) : Γ(V, ⊤)) = p.appTop.hom (aU : Γ(U.left, ⊤))
      rw [Units.val_pow_eq_pow_val, IsUnit.unit_spec, hT]
    exact hcov U _ (fun v => ⟨V₁, c, hc, hpsurj v⟩)

  have hA : ∀ (X : Scheme.{u}) (P₁ P₂ P₃ : (Scheme.Etale X)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) (f : P₁ ⟶ P₂) (g : P₂ ⟶ P₃),
      f ≫ g = 0 → Presheaf.IsLocallyInjective (Scheme.smallEtaleTopology X) f →
      (∀ (U : Scheme.Etale X) (s : ToType (P₂.obj (Opposite.op U))),
        g.app (Opposite.op U) s = 0 → Presheaf.imageSieve f s ∈ Scheme.smallEtaleTopology X U) →
      Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology X) g →
      ∀ (g' : (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj P₂ ⟶
          (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj P₃),
        (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map g = g' →
        ∃ h : (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map f ≫ g' = 0,
          (ShortComplex.mk ((presheafToSheaf (Scheme.smallEtaleTopology X)
            AddCommGrpCat.{u+1}).map f) g' h).ShortExact := by
    intro X P₁ P₂ P₃ f g hfg hinj hex hsurj g' hg'
    subst hg'
    have h : (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map f ≫
        (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map g = 0 := by
      rw [← Functor.map_comp, hfg, Functor.map_zero]
    refine ⟨h, ?_⟩
    have hmono : Mono ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map f) := by
      haveI : Sheaf.IsLocallyInjective
          ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map f) :=
        (Presheaf.isLocallyInjective_presheafToSheaf_map_iff _ f).mpr hinj
      exact Sheaf.mono_of_isLocallyInjective _
    have hepi : Epi ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map g) := by
      rw [← Sheaf.isLocallySurjective_iff_epi']
      exact (Presheaf.isLocallySurjective_presheafToSheaf_map_iff _ g).mpr hsurj
    refine ShortComplex.ShortExact.mk' ?_ hmono hepi
    rw [ShortComplex.exact_iff_epi_kernel_lift]
    have hk : Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology X)
        (Limits.kernel.lift g f hfg) := by
      refine Presheaf.IsLocallySurjective.mk (fun {U} s => ?_)
      have ht : g.app (Opposite.op U) ((Limits.kernel.ι g).app (Opposite.op U) s) = 0 := by
        rw [← ConcreteCategory.comp_apply, ← NatTrans.comp_app, Limits.kernel.condition]
        rfl
      refine GrothendieckTopology.superset_covering _ ?_ (hex U _ ht)
      intro V φ hφ
      obtain ⟨r, hr⟩ := hφ
      refine ⟨r, ?_⟩
      have hm : Mono ((Limits.kernel.ι g).app (Opposite.op V)) :=
        (NatTrans.mono_iff_mono_app _).mp inferInstance _
      apply (AddCommGrpCat.mono_iff_injective _).mp hm
      rw [← ConcreteCategory.comp_apply, ← NatTrans.comp_app, Limits.kernel.lift_ι, hr,
        ← ConcreteCategory.comp_apply, ← ConcreteCategory.comp_apply, NatTrans.naturality]
    have hkF : Epi ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map
        (Limits.kernel.lift g f hfg)) := by
      rw [← Sheaf.isLocallySurjective_iff_epi']
      exact (Presheaf.isLocallySurjective_presheafToSheaf_map_iff _ _).mpr hk
    have heq : Limits.kernel.lift
        ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map g)
        ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map f) h =
        (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map
          (Limits.kernel.lift g f hfg) ≫
        (Limits.PreservesKernel.iso
          (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) g).hom := by
      rw [Limits.PreservesKernel.iso_hom, Limits.map_lift_kernelComparison]
    change Epi (Limits.kernel.lift
        ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map g)
        ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map f) h)
    rw [heq]
    exact epi_comp _ _

  have key : ∀ (M1 M0 : Type u) [CommGroup M1] [CommGroup M0]
      {𝒞 : Type (u+2)} [Category.{u+1} 𝒞] [Abelian 𝒞] [HasExt.{u+2} 𝒞] (P L G : 𝒞)
      (ι : L ⟶ G) (h : ι ≫ (ℓ • 𝟙 G) = 0) (hS : (ShortComplex.mk ι (ℓ • 𝟙 G) h).ShortExact),
      (Abelian.Ext P G 1 ≃+ Additive M1) → (Abelian.Ext P G 0 ≃+ Additive M0) →
      Nat.card (Abelian.Ext P L 1) = Nat.card {x : M1 // x ^ ℓ = 1} *
        Nat.card (M0 ⧸ (powMonoidHom ℓ : M0 →* M0).range) := by
    intro M1 M0 _ _ 𝒞 _ _ _ P L G ι h hS ePic eU
    have hmk : ∀ (T : 𝒞) (m : ℕ),
        (Abelian.Ext.mk₀ (m • 𝟙 T) : Abelian.Ext T T 0) = m • Abelian.Ext.mk₀ (𝟙 T) := by
      intro T m
      induction m with
      | zero => rw [zero_nsmul, zero_nsmul, Abelian.Ext.mk₀_zero]
      | succ m ih => rw [succ_nsmul, Abelian.Ext.mk₀_add, ih, succ_nsmul]
    have hns : ∀ {X T : 𝒞} {k' : ℕ} (α : Abelian.Ext X T k') (m : ℕ),
        α.comp (Abelian.Ext.mk₀ (m • 𝟙 T)) (add_zero k') = m • α := by
      intro X T k' α m
      have hlin := map_nsmul (Abelian.Ext.bilinearComp X T T k' 0 k' (add_zero k') α) m
        (Abelian.Ext.mk₀ (𝟙 T))
      simp only [Abelian.Ext.bilinearComp_apply_apply] at hlin
      rw [Abelian.Ext.comp_mk₀_id] at hlin
      rw [hmk, hlin]
    have hE1 : hS.extClass.comp (Abelian.Ext.mk₀ ι) (add_zero 1) = 0 := hS.extClass_comp
    have hE2 : (Abelian.Ext.mk₀ (ℓ • 𝟙 G)).comp hS.extClass (zero_add 1) = 0 := hS.comp_extClass
    let δ : Abelian.Ext P G 0 →+ Abelian.Ext P L 1 :=
      AddMonoidHom.mk' (fun y => y.comp hS.extClass (zero_add 1))
        (fun a b => Abelian.Ext.add_comp a b _ _)
    let φ : Abelian.Ext P L 1 →+ Abelian.Ext P G 1 :=
      AddMonoidHom.mk' (fun x => x.comp (Abelian.Ext.mk₀ ι) (add_zero 1))
        (fun a b => Abelian.Ext.add_comp a b _ _)
    have hδ : ∀ y, δ y = y.comp hS.extClass (zero_add 1) := fun _ => rfl
    have hφ : ∀ x, φ x = x.comp (Abelian.Ext.mk₀ ι) (add_zero 1) := fun _ => rfl
    have hi : ∀ x : Abelian.Ext P L 1, φ x = 0 ↔ ∃ y, δ y = x := by
      intro x
      constructor
      · intro hx
        rw [hφ] at hx
        obtain ⟨y, hy⟩ := Abelian.Ext.covariant_sequence_exact₁ P hS x hx (zero_add 1)
        exact ⟨y, (hδ y).trans hy⟩
      · rintro ⟨y, rfl⟩
        rw [hφ, hδ, Abelian.Ext.comp_assoc_of_third_deg_zero, hE1, Abelian.Ext.comp_zero]
    have hii : ∀ z : Abelian.Ext P G 1, (∃ x, φ x = z) ↔ ℓ • z = 0 := by
      intro z
      constructor
      · rintro ⟨x, rfl⟩
        rw [hφ, ← hns (x.comp (Abelian.Ext.mk₀ ι) (add_zero 1)) ℓ,
          Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, h,
          Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
      · intro hz
        have h2 : z.comp (Abelian.Ext.mk₀ (ℓ • 𝟙 G)) (add_zero 1) = 0 := by
          rw [hns]; exact hz
        obtain ⟨x, hx⟩ := Abelian.Ext.covariant_sequence_exact₂ P hS z h2
        exact ⟨x, (hφ x).trans hx⟩
    have hiii : ∀ y : Abelian.Ext P G 0, δ y = 0 ↔ ∃ w, ℓ • w = y := by
      intro y
      constructor
      · intro hy
        rw [hδ] at hy
        obtain ⟨w, hw⟩ := Abelian.Ext.covariant_sequence_exact₃ P hS y (zero_add 1) hy
        exact ⟨w, by rw [← hns w ℓ]; exact hw⟩
      · rintro ⟨w, rfl⟩
        rw [hδ, ← hns w ℓ, Abelian.Ext.comp_assoc_of_second_deg_zero, hE2, Abelian.Ext.comp_zero]
    let e₁ : (Abelian.Ext P L 1 ⧸ φ.ker) ≃+ φ.range := QuotientAddGroup.quotientKerEquivRange φ
    let eT : φ.range ≃ {z : Abelian.Ext P G 1 // ℓ • z = 0} :=
      Equiv.subtypeEquivRight (fun z => by rw [AddMonoidHom.mem_range]; exact hii z)
    let e₃ : φ.ker ≃ δ.range :=
      Equiv.subtypeEquivRight (fun x => by
        rw [AddMonoidHom.mem_ker, AddMonoidHom.mem_range]; exact hi x)
    have hkerδ : δ.ker = (nsmulAddMonoidHom ℓ : Abelian.Ext P G 0 →+ _).range := by
      ext y
      rw [AddMonoidHom.mem_ker, AddMonoidHom.mem_range]
      simp only [nsmulAddMonoidHom_apply]
      exact hiii y
    let e₂ : (Abelian.Ext P G 0 ⧸ (nsmulAddMonoidHom ℓ : Abelian.Ext P G 0 →+ _).range) ≃+
        δ.range :=
      (QuotientAddGroup.quotientAddEquivOfEq hkerδ).symm.trans
        (QuotientAddGroup.quotientKerEquivRange δ)
    let τ : {z : Abelian.Ext P G 1 // ℓ • z = 0} ≃ {x : M1 // x ^ ℓ = 1} :=
      (ePic.toEquiv.trans Additive.toMul).subtypeEquiv (fun z => by
        have e : (ePic.toEquiv.trans Additive.toMul) z = Additive.toMul (ePic z) := rfl
        rw [e, ← toMul_nsmul, ← map_nsmul ePic ℓ z, toMul_eq_one, AddEquiv.map_eq_zero_iff])
    let RM : Subgroup M0 := (powMonoidHom ℓ : M0 →* M0).range
    let ψ : Abelian.Ext P G 0 →+ Additive (M0 ⧸ RM) :=
      (MonoidHom.toAdditive (QuotientGroup.mk' RM)).comp eU.toAddMonoidHom
    have hψ : ∀ z, ψ z = Additive.ofMul (QuotientGroup.mk' RM (Additive.toMul (eU z))) :=
      fun _ => rfl
    have hψsurj : Function.Surjective ψ := by
      intro q
      obtain ⟨m, hm⟩ := QuotientGroup.mk'_surjective RM (Additive.toMul q)
      refine ⟨eU.symm (Additive.ofMul m), ?_⟩
      rw [hψ, AddEquiv.apply_symm_apply, toMul_ofMul, hm, ofMul_toMul]
    have hkerψ : ψ.ker = (nsmulAddMonoidHom ℓ : Abelian.Ext P G 0 →+ _).range := by
      ext z
      rw [AddMonoidHom.mem_ker, AddMonoidHom.mem_range, hψ, ofMul_eq_zero, QuotientGroup.mk'_apply,
        QuotientGroup.eq_one_iff, MonoidHom.mem_range]
      constructor
      · rintro ⟨w, hw⟩
        refine ⟨eU.symm (Additive.ofMul w), ?_⟩
        apply eU.injective
        rw [powMonoidHom_apply] at hw
        rw [nsmulAddMonoidHom_apply, map_nsmul, AddEquiv.apply_symm_apply, ← ofMul_pow, hw,
          ofMul_toMul]
      · rintro ⟨v, hv⟩
        refine ⟨Additive.toMul (eU v), ?_⟩
        rw [powMonoidHom_apply, ← toMul_nsmul, ← map_nsmul eU ℓ v, ← hv, nsmulAddMonoidHom_apply]
    let κ : (Abelian.Ext P G 0 ⧸ (nsmulAddMonoidHom ℓ : Abelian.Ext P G 0 →+ _).range) ≃
        (M0 ⧸ RM) :=
      ((QuotientAddGroup.quotientAddEquivOfEq hkerψ.symm).trans
        (QuotientAddGroup.quotientKerEquivOfSurjective ψ hψsurj)).toEquiv.trans Additive.toMul
    rw [AddSubgroup.card_eq_card_quotient_mul_card_addSubgroup φ.ker,
      Nat.card_congr ((e₁.toEquiv.trans eT).trans τ), Nat.card_congr e₃,
      Nat.card_congr (e₂.symm.toEquiv.trans κ)]

  obtain ⟨κ, h0, hinj, hex⟩ := hkappa (Spec (.of C)) (Scheme.ΓSpecIso (CommRingCat.of C)).inv.hom
  have hmap : (presheafToSheaf (Scheme.smallEtaleTopology (Spec (.of C))) AddCommGrpCat.{u+1}).map
      (ℓ • 𝟙 (wcEtGmPre (Spec (.of C)))) = ℓ • 𝟙 (wcEtGm (Spec (.of C))) := by
    rw [Functor.map_nsmul, CategoryTheory.Functor.map_id]
    rfl
  obtain ⟨h, hS⟩ := hA _ _ _ _ κ (ℓ • 𝟙 (wcEtGmPre (Spec (.of C)))) h0 hinj hex
    (hsurjM _ (Scheme.ΓSpecIso (CommRingCat.of C)).inv.hom) (ℓ • 𝟙 (wcEtGm (Spec (.of C)))) hmap
  obtain ⟨ePic⟩ := wc_et_gm_h1_affine_pic C
  obtain ⟨eU0⟩ := wc_et_gm_h0_units (Spec (.of C))
  exact @key (CommRing.Pic C) Cˣ _ _ _ _ _ (HasExt.standard _) _
    ((constantSheaf (Scheme.smallEtaleTopology (Spec (.of C))) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))))
    (wcEtGm (Spec (.of C)))
    ((presheafToSheaf (Scheme.smallEtaleTopology (Spec (.of C))) AddCommGrpCat.{u+1}).map κ) h hS
    ePic
    (eU0.trans (MulEquiv.toAdditive
      (Units.mapEquiv (Scheme.ΓSpecIso (CommRingCat.of C)).commRingCatIsoToRingEquiv.toMulEquiv)))

theorem wc_henselian_sepClosed_primitive_root (R : Type*) [CommRing R] [HenselianLocalRing R]
    [IsSepClosed (IsLocalRing.ResidueField R)] (m : ℕ) (hm : IsUnit ((m : ℕ) : R)) :
    ∃ ω : R, IsPrimitiveRoot ω m :=
by
  rcases Nat.eq_zero_or_pos m with h0 | hpos
  · subst h0
    exact ⟨0, IsPrimitiveRoot.zero⟩
  have hm0 : m ≠ 0 := hpos.ne'
  have hk : ((m : ℕ) : IsLocalRing.ResidueField R) ≠ 0 := by
    rw [← map_natCast (IsLocalRing.residue R) m]
    exact (IsLocalRing.residue_ne_zero_iff_isUnit _).mpr hm
  haveI : NeZero ((m : ℕ) : IsLocalRing.ResidueField R) := ⟨hk⟩
  obtain ⟨ζ, hζ⟩ := HasEnoughRootsOfUnity.exists_primitiveRoot (IsLocalRing.ResidueField R) m
  have hζ0 : ζ ≠ 0 := hζ.ne_zero hm0
  obtain ⟨a₀, ha₀⟩ := IsLocalRing.residue_surjective ζ
  have ha₀u : IsUnit a₀ :=
    (IsLocalRing.residue_ne_zero_iff_isUnit a₀).mp (by rw [ha₀]; exact hζ0)
  have hmon : (Polynomial.X ^ m - Polynomial.C (1 : R)).Monic :=
    Polynomial.monic_X_pow_sub_C (1 : R) hm0
  have hev : Polynomial.eval a₀ (Polynomial.X ^ m - Polynomial.C (1 : R)) ∈
      IsLocalRing.maximalIdeal R := by
    rw [← IsLocalRing.residue_eq_zero_iff]
    simp only [Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X, Polynomial.eval_C,
      Polynomial.eval_one, map_sub, map_pow, map_one, ha₀, hζ.pow_eq_one, sub_self]
  have hder : IsUnit (Polynomial.eval a₀
      (Polynomial.derivative (Polynomial.X ^ m - Polynomial.C (1 : R)))) := by
    simp only [Polynomial.derivative_sub, Polynomial.derivative_X_pow, Polynomial.derivative_C,
      sub_zero, Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_pow, Polynomial.eval_X,
      Polynomial.eval_natCast]
    exact hm.mul (ha₀u.pow _)
  obtain ⟨ω, hroot, hω⟩ := HenselianLocalRing.is_henselian _ hmon a₀ hev hder
  have hωm : ω ^ m = 1 := by
    have := hroot.eq_zero
    simp only [Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X,
      Polynomial.eval_C] at this
    exact sub_eq_zero.mp this
  have hπ : IsLocalRing.residue R ω = ζ := by
    rw [← IsLocalRing.residue_eq_zero_iff, map_sub, sub_eq_zero] at hω
    rw [hω, ha₀]
  refine ⟨ω, IsPrimitiveRoot.mk_of_lt ω hpos hωm ?_⟩
  intro l hl0 hlm hl
  apply hζ.pow_ne_one_of_pos_of_lt hl0.ne' hlm
  rw [← hπ, ← map_pow, hl, map_one]

theorem wc_cpt_tube_low : ∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] [IsDomain A] [IsDiscreteValuationRing A] (ℓ : ℕ), ℓ.Prime → IsUnit ((ℓ : ℕ) : A) → ∀ (d : ℕ) (y : Spec (.of (MvPolynomial (Option (Fin d)) A))), Spec.map (CommRingCat.ofHom (algebraMap A (MvPolynomial (Option (Fin d)) A))) y = IsLocalRing.closedPoint A → (MvPolynomial.X none : MvPolynomial (Option (Fin d)) A) ∈ y.asIdeal → ∀ (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (MvPolynomial (Option (Fin d)) A))) y)) (Scheme.Etale.forget (Spec (.of (MvPolynomial (Option (Fin d)) A))))) (φ : ∀ l, Spec (.of B) ⟶ (W'.obj l).right.left) (a : Spec (.of B) ⟶ Spec (.of (MvPolynomial (Option (Fin d)) A))), wcHalShData y B Λ W' φ a → ∀ (β : MvPolynomial (Option (Fin d)) A →+* B), Spec.map (CommRingCat.ofHom β) = a → Nat.card (wcEtCoh (Spec (.of (Localization.Away (β (MvPolynomial.X none))))) ℓ 0) = ℓ ∧ Nat.card (wcEtCoh (Spec (.of (Localization.Away (β (MvPolynomial.X none))))) ℓ 1) = ℓ :=
by
  intro A _ _ _ _ _ ℓ hℓ hunit d y hy hy0 B _ _ _ Λ _ _ W' φ a ha β hβ
  classical
  have s2 : ∀ (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)]
      (ℓ : ℕ), 0 < ℓ → IsUnit ((ℓ : ℕ) : B) → ∀ v : Bˣ, ∃ w : Bˣ, w ^ ℓ = v := by
    intro B _ _ _ ℓ hℓ0 hℓB
    intro v
    set f : Polynomial B := Polynomial.X ^ ℓ - Polynomial.C (v : B) with hf
    have hmon : f.Monic := Polynomial.monic_X_pow_sub_C _ hℓ0.ne'
    have hv0 : IsLocalRing.residue B (v : B) ≠ 0 :=
      (IsLocalRing.residue_ne_zero_iff_isUnit _).mpr v.isUnit
    have hℓκ : ((ℓ : ℕ) : IsLocalRing.ResidueField B) ≠ 0 := by
      have := (IsLocalRing.residue_ne_zero_iff_isUnit _).mpr hℓB
      rwa [map_natCast] at this
    obtain ⟨ab, hab⟩ := IsSepClosed.exists_root
      (Polynomial.X ^ ℓ - Polynomial.C (IsLocalRing.residue B (v : B)))
      (by rw [Polynomial.degree_X_pow_sub_C hℓ0]; exact_mod_cast hℓ0.ne')
      (Polynomial.separable_X_pow_sub_C _ hℓκ hv0)
    have hab' : ab ^ ℓ = IsLocalRing.residue B (v : B) := by
      simpa [Polynomial.IsRoot, sub_eq_zero] using hab
    obtain ⟨a₀, ha₀⟩ := IsLocalRing.residue_surjective ab
    have ha₀u : IsUnit a₀ := by
      rw [← IsLocalRing.residue_ne_zero_iff_isUnit, ha₀]
      intro h
      rw [h, zero_pow hℓ0.ne'] at hab'
      exact hv0 hab'.symm
    have hev : Polynomial.eval a₀ f ∈ IsLocalRing.maximalIdeal B := by
      rw [← IsLocalRing.residue_eq_zero_iff]
      simp [hf, ha₀, hab']
    have hder : IsUnit (Polynomial.eval a₀ (Polynomial.derivative f)) := by
      simp only [hf, Polynomial.derivative_sub, Polynomial.derivative_X_pow, Polynomial.derivative_C,
        sub_zero, Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_pow, Polynomial.eval_X]
      exact hℓB.mul (ha₀u.pow _)
    obtain ⟨r, hr, -⟩ := HenselianLocalRing.is_henselian f hmon a₀ hev hder
    have hr' : r ^ ℓ = (v : B) := by
      simpa [Polynomial.IsRoot, hf, sub_eq_zero] using hr
    have hru : IsUnit r := (isUnit_pow_iff hℓ0.ne').mp (hr' ▸ v.isUnit)
    refine ⟨hru.unit, Units.ext ?_⟩
    rw [Units.val_pow_eq_pow_val, IsUnit.unit_spec, hr']
  have s3 : ∀ (B : Type u) [CommRing B] [IsDomain B] (u : B), Prime u → ∀ (ℓ : ℕ), 0 < ℓ →
      (∀ v : Bˣ, ∃ w : Bˣ, w ^ ℓ = v) →
      Nat.card ((Localization.Away u)ˣ ⧸ (powMonoidHom ℓ : (Localization.Away u)ˣ →* (Localization.Away u)ˣ).range) = ℓ := by
    intro B _ _ u hu ℓ hℓ0 hdiv
    classical
    set C := Localization.Away u
    set ι : B →+* C := algebraMap B C with hι
    have hle : Submonoid.powers u ≤ nonZeroDivisors B := powers_le_nonZeroDivisors_of_noZeroDivisors hu.ne_zero
    have hinj : Function.Injective ι := IsLocalization.injective C hle
    set û : Cˣ := (IsLocalization.Away.algebraMap_isUnit u : IsUnit (ι u)).unit with hûdef
    have hû : (û : C) = ι u := IsUnit.unit_spec _
    set j : Bˣ →* Cˣ := Units.map ι.toMonoidHom with hj
    have hjv : ∀ v : Bˣ, ((j v : Cˣ) : C) = ι v := fun v => rfl

    have divl : ∀ N : ℕ, ∀ b b' : B, b * b' = u ^ N → ∃ (k : ℕ) (v : Bˣ), b = v * u ^ k := by
      intro N
      induction N with
      | zero =>
        intro b b' h
        rw [pow_zero] at h
        exact ⟨0, (isUnit_iff_exists_inv.mpr ⟨b', h⟩).unit, by simp⟩
      | succ N ih =>
        intro b b' h
        have hd : u ∣ b * b' := ⟨u ^ N, by rw [h, pow_succ']⟩
        rcases hu.dvd_or_dvd hd with ⟨b₁, rfl⟩ | ⟨b₁, rfl⟩
        · have h' : b₁ * b' = u ^ N := by
            apply mul_left_cancel₀ hu.ne_zero
            rw [← mul_assoc, h, pow_succ']
          obtain ⟨k, v, hv⟩ := ih b₁ b' h'
          exact ⟨k + 1, v, by rw [hv, pow_succ']; ring⟩
        · have h' : b * b₁ = u ^ N := by
            apply mul_left_cancel₀ hu.ne_zero
            rw [pow_succ'] at h
            rw [← h]; ring
          exact ih b b₁ h'

    have unitsC : ∀ c : Cˣ, ∃ (v : Bˣ) (k : ℤ), c = j v * û ^ k := by
      intro c
      obtain ⟨m, b, hb⟩ := IsLocalization.Away.surj u (c : C)
      obtain ⟨m', b', hb'⟩ := IsLocalization.Away.surj u ((c⁻¹ : Cˣ) : C)
      have hbb : b * b' = u ^ (m + m') := by
        apply hinj
        rw [map_mul, ← hb, ← hb', map_pow, pow_add]
        have : (c : C) * ((c⁻¹ : Cˣ) : C) = 1 := by simp
        linear_combination (ι u ^ m * ι u ^ m') * this
      obtain ⟨k, v, hv⟩ := divl _ b b' hbb
      refine ⟨v, (k : ℤ) - m, ?_⟩
      apply Units.ext
      have e1 : (c : C) * (û : C) ^ m = ((j v : Cˣ) : C) * (û : C) ^ k := by
        rw [hjv, hû, hb, hv, map_mul, map_pow]
      have e2 : ((û ^ ((k : ℤ) - m) : Cˣ) : C) * (û : C) ^ m = (û : C) ^ k := by
        rw [← Units.val_pow_eq_pow_val, ← Units.val_pow_eq_pow_val, ← Units.val_mul, ← zpow_natCast,
          ← zpow_natCast, ← zpow_add]
        congr 2; ring
      have hum : IsUnit ((û : C) ^ m) := (û.isUnit).pow m
      apply hum.mul_left_injective
      simp only [Units.val_mul]
      rw [e1, mul_assoc, e2]

    have rigid : ∀ (w : Bˣ) (m : ℤ), j w = û ^ m → m = 0 := by
      intro w m h
      obtain ⟨t, ht | ht⟩ := Int.eq_nat_or_neg m
      · subst ht
        have h1 : ι (w : B) = ι (u ^ t) := by
          rw [← hjv, h, zpow_natCast, Units.val_pow_eq_pow_val, hû, map_pow]
        have h2 := hinj h1
        by_contra hne
        have ht0 : t ≠ 0 := by exact_mod_cast hne
        exact hu.not_isUnit ((isUnit_pow_iff ht0).mp (h2 ▸ w.isUnit))
      · subst ht
        have h1 : ι ((w : B) * u ^ t) = ι 1 := by
          rw [map_mul, ← hjv, h, map_pow, ← hû, map_one, ← Units.val_pow_eq_pow_val, ← Units.val_mul,
            zpow_neg, zpow_natCast, inv_mul_cancel, Units.val_one]
        have h2 := hinj h1
        by_contra hne
        have ht0 : t ≠ 0 := by intro h0; apply hne; rw [h0]; simp
        have : IsUnit (u ^ t) := isUnit_iff_exists_inv'.mpr ⟨_, h2⟩
        exact hu.not_isUnit ((isUnit_pow_iff ht0).mp this)
    set H := (powMonoidHom ℓ : Cˣ →* Cˣ).range with hH

    have kerl : ∀ n : ℤ, û ^ n ∈ H → (ℓ : ℤ) ∣ n := by
      intro n hn
      obtain ⟨d, hd⟩ := hn
      rw [powMonoidHom_apply] at hd
      obtain ⟨v, k, rfl⟩ := unitsC d
      refine ⟨k, ?_⟩
      have h1 : j (v ^ ℓ) = û ^ (n - ℓ * k) := by
        rw [map_pow, zpow_sub, ← hd, mul_pow, zpow_mul, zpow_natCast]
        group
      have := rigid _ _ h1
      linarith
    have memH : ∀ n : ℤ, (ℓ : ℤ) ∣ n → û ^ n ∈ H := by
      rintro n ⟨t, rfl⟩
      exact ⟨û ^ t, by rw [powMonoidHom_apply, ← zpow_natCast, ← zpow_mul, mul_comm]⟩
    let f : Fin ℓ → Cˣ ⧸ H := fun i => QuotientGroup.mk (û ^ ((i : ℕ) : ℤ))
    have hfinj : Function.Injective f := by
      intro a b hab
      have h1 := QuotientGroup.eq.mp hab
      rw [← zpow_neg, ← zpow_add] at h1
      have h2 := kerl _ h1
      have h3 := Int.eq_zero_of_abs_lt_dvd h2 (by
        have := a.isLt; have := b.isLt
        rw [abs_lt]; constructor <;> omega)
      ext; omega
    have hfsurj : Function.Surjective f := by
      intro q
      obtain ⟨c, rfl⟩ := QuotientGroup.mk_surjective q
      obtain ⟨v, k, rfl⟩ := unitsC c
      obtain ⟨w, rfl⟩ := hdiv v
      have hℓz : (0 : ℤ) < ℓ := by exact_mod_cast hℓ0
      refine ⟨⟨(k % ℓ).toNat, by have := Int.emod_lt_of_pos k hℓz; have := Int.emod_nonneg k hℓz.ne'; omega⟩, ?_⟩
      apply QuotientGroup.eq.mpr
      have hr : (((k % ℓ).toNat : ℕ) : ℤ) = k % ℓ := Int.toNat_of_nonneg (Int.emod_nonneg k hℓz.ne')
      simp only [hr]
      refine ⟨j w * û ^ (k / ℓ), ?_⟩
      rw [powMonoidHom_apply, mul_pow, ← map_pow, ← zpow_natCast (û ^ (k / ℓ)), ← zpow_mul]
      have hk : û ^ k = û ^ ((ℓ : ℤ) * (k / ℓ)) * û ^ (k % ℓ) := by
        rw [← zpow_add]; congr 1; rw [Int.emod_def]; ring
      rw [hk, mul_comm (k / ℓ) (ℓ : ℤ), mul_comm (û ^ ((ℓ : ℤ) * (k / ℓ))) (û ^ (k % ℓ)),
        mul_left_comm _ (û ^ (k % ℓ)), inv_mul_cancel_left]
    rw [← Nat.card_congr (Equiv.ofBijective f ⟨hfinj, hfsurj⟩), Nat.card_eq_fintype_card, Fintype.card_fin]
  have s4 : ∀ (D : Type u) [CommRing D] [IsDomain D],
      (∀ a b : D, ∃ l : D, ∀ z : D, (a ∣ z ∧ b ∣ z ↔ l ∣ z)) → Subsingleton (CommRing.Pic D) := by
    intro D _ _ hl
    classical

    have hinj : Function.Injective (algebraMap D (FractionRing D)) := IsFractionRing.injective D (FractionRing D)

    have memS : ∀ (w x : (FractionRing D)), w ∈ (Submodule.span D {x} : Submodule D (FractionRing D)) ↔
        ∃ d : D, algebraMap D (FractionRing D) d * x = w := by
      intro w x
      rw [Submodule.mem_span_singleton]
      simp only [Algebra.smul_def]

    have pair : ∀ x y : (FractionRing D), x ≠ 0 → y ≠ 0 → ∃ z : (FractionRing D), z ≠ 0 ∧ ∀ w : (FractionRing D),
        (w ∈ (Submodule.span D {x} : Submodule D (FractionRing D)) ∧ w ∈ (Submodule.span D {y} : Submodule D (FractionRing D))) ↔
          w ∈ (Submodule.span D {z} : Submodule D (FractionRing D)) := by
      intro x y hx hy
      obtain ⟨p, q, hq, rfl⟩ := IsFractionRing.div_surjective (A := D) x
      obtain ⟨r, t, ht, rfl⟩ := IsFractionRing.div_surjective (A := D) y
      have hq0 : q ≠ 0 := nonZeroDivisors.ne_zero hq
      have ht0 : t ≠ 0 := nonZeroDivisors.ne_zero ht
      have hqK : algebraMap D (FractionRing D) q ≠ 0 := by
        intro h; apply hq0; apply hinj; rw [h, map_zero]
      have htK : algebraMap D (FractionRing D) t ≠ 0 := by
        intro h; apply ht0; apply hinj; rw [h, map_zero]
      have hp0 : p ≠ 0 := by
        rintro rfl; apply hx; rw [map_zero, zero_div]
      have hr0 : r ≠ 0 := by
        rintro rfl; apply hy; rw [map_zero, zero_div]
      obtain ⟨l, hlz⟩ := hl (p * t) (r * q)
      have hl0 : l ≠ 0 := by
        rintro rfl
        have h := (hlz (p * t * (r * q))).mp ⟨dvd_mul_right _ _, dvd_mul_left _ _⟩
        rw [zero_dvd_iff] at h
        exact mul_ne_zero (mul_ne_zero hp0 ht0) (mul_ne_zero hr0 hq0) h
      have hlK : algebraMap D (FractionRing D) l ≠ 0 := by
        intro h; apply hl0; apply hinj; rw [h, map_zero]
      obtain ⟨n₁, hn₁⟩ := ((hlz l).mpr dvd_rfl).1
      obtain ⟨n₂, hn₂⟩ := ((hlz l).mpr dvd_rfl).2
      refine ⟨algebraMap D (FractionRing D) l / (algebraMap D (FractionRing D) q * algebraMap D (FractionRing D) t),
        div_ne_zero hlK (mul_ne_zero hqK htK), fun w => ?_⟩
      rw [memS, memS, memS]
      constructor
      · rintro ⟨⟨d₁, hd₁⟩, ⟨d₂, hd₂⟩⟩
        have he : d₁ * (p * t) = d₂ * (r * q) := by
          apply hinj
          have e1 : algebraMap D (FractionRing D) (d₁ * (p * t)) = w * (algebraMap D (FractionRing D) q * algebraMap D (FractionRing D) t) := by
            rw [← hd₁]; simp only [map_mul]; field_simp
          have e2 : algebraMap D (FractionRing D) (d₂ * (r * q)) = w * (algebraMap D (FractionRing D) q * algebraMap D (FractionRing D) t) := by
            rw [← hd₂]; simp only [map_mul]; field_simp
          rw [e1, e2]
        obtain ⟨m, hm⟩ := (hlz (d₁ * (p * t))).mp ⟨dvd_mul_left _ _, he ▸ dvd_mul_left _ _⟩
        refine ⟨m, ?_⟩
        rw [← hd₁]
        have e3 : algebraMap D (FractionRing D) (d₁ * (p * t)) = algebraMap D (FractionRing D) (l * m) := by rw [hm]
        simp only [map_mul] at e3
        field_simp
        linear_combination -e3
      · rintro ⟨m, hm⟩
        refine ⟨⟨m * n₁, ?_⟩, ⟨m * n₂, ?_⟩⟩
        · rw [← hm]
          have e3 : algebraMap D (FractionRing D) l = algebraMap D (FractionRing D) (p * t * n₁) := by rw [← hn₁]
          simp only [map_mul] at e3 ⊢
          rw [e3]
          field_simp
        · rw [← hm]
          have e3 : algebraMap D (FractionRing D) l = algebraMap D (FractionRing D) (r * q * n₂) := by rw [← hn₂]
          simp only [map_mul] at e3 ⊢
          rw [e3]
          field_simp

    have fin : ∀ T : Finset (FractionRing D), (∀ s ∈ T, s ≠ 0) → T.Nonempty →
        ∃ z : FractionRing D, z ≠ 0 ∧ ∀ w : FractionRing D,
          (∀ s ∈ T, w ∈ (Submodule.span D {s⁻¹} : Submodule D (FractionRing D))) ↔
            w ∈ (Submodule.span D {z} : Submodule D (FractionRing D)) := by
      intro T
      induction T using Finset.induction_on with
      | empty => intro _ h; exact absurd h Finset.not_nonempty_empty
      | insert a T' haT ih =>
        intro h0 _
        have ha : a ≠ 0 := h0 a (Finset.mem_insert_self a T')
        rcases T'.eq_empty_or_nonempty with hT' | hT'
        · subst hT'
          refine ⟨a⁻¹, inv_ne_zero ha, fun w => ?_⟩
          simp
        · obtain ⟨z', hz', hw'⟩ := ih (fun s hs => h0 s (Finset.mem_insert_of_mem hs)) hT'
          obtain ⟨z, hz, hw⟩ := pair a⁻¹ z' (inv_ne_zero ha) hz'
          refine ⟨z, hz, fun w => ?_⟩
          rw [← hw, ← hw', Finset.forall_mem_insert]

    have unitP : ∀ I : (Submodule D (FractionRing D))ˣ,
        I ∈ (Units.map (Submodule.spanSingleton D : FractionRing D →*₀ Submodule D (FractionRing D)).toMonoidHom).range := by
      intro I
      have hIJ : (I : Submodule D (FractionRing D)) * ↑I⁻¹ = 1 := I.mul_inv
      have hJI : (↑I⁻¹ : Submodule D (FractionRing D)) * ↑I = 1 := I.inv_mul
      obtain ⟨S, hS⟩ := Submodule.fg_of_isUnit I.isUnit
      let T := S.filter (· ≠ 0)
      have hT : Submodule.span D (T : Set (FractionRing D)) = I := by
        rw [← hS]
        apply le_antisymm
        · apply Submodule.span_mono
          intro s hs
          exact (Finset.mem_filter.mp hs).1
        · rw [Submodule.span_le]
          intro s hs
          by_cases h : s = 0
          · rw [h]; exact Submodule.zero_mem _
          · exact Submodule.subset_span (Finset.mem_filter.mpr ⟨hs, h⟩)
      have hT0 : ∀ s ∈ T, s ≠ 0 := fun s hs => (Finset.mem_filter.mp hs).2
      have hTne : T.Nonempty := by
        rcases T.eq_empty_or_nonempty with h | h
        · exfalso
          rw [h, Finset.coe_empty, Submodule.span_empty] at hT
          rw [← hT, Submodule.bot_mul] at hIJ
          have h1 : (1 : FractionRing D) ∈ (1 : Submodule D (FractionRing D)) := Submodule.mem_one.mpr ⟨1, map_one _⟩
          rw [← hIJ, Submodule.mem_bot] at h1
          exact one_ne_zero h1
        · exact h
      obtain ⟨z, hz, hzw⟩ := fin T hT0 hTne
      have hJ : (↑I⁻¹ : Submodule D (FractionRing D)) = Submodule.span D {z} := by
        ext w
        rw [← hzw]
        constructor
        · intro hw s hs
          have h1 : w * s ∈ (1 : Submodule D (FractionRing D)) := by
            rw [← hJI]
            refine Submodule.mul_mem_mul hw ?_
            rw [← hT]
            exact Submodule.subset_span hs
          obtain ⟨d, hd⟩ := Submodule.mem_one.mp h1
          rw [memS]
          refine ⟨d, ?_⟩
          rw [hd, mul_assoc, mul_inv_cancel₀ (hT0 s hs), mul_one]
        · intro hw
          have h2 : ∀ v ∈ (I : Submodule D (FractionRing D)), w * v ∈ (1 : Submodule D (FractionRing D)) := by
            intro v hv
            rw [← hT] at hv
            induction hv using Submodule.span_induction with
            | mem v hv =>
              obtain ⟨d, hd⟩ := (memS w _).mp (hw v hv)
              rw [← hd, mul_assoc, inv_mul_cancel₀ (hT0 v hv), mul_one]
              exact Submodule.mem_one.mpr ⟨d, rfl⟩
            | zero => rw [mul_zero]; exact Submodule.zero_mem _
            | add v₁ v₂ _ _ h₁ h₂ => rw [mul_add]; exact Submodule.add_mem _ h₁ h₂
            | smul d v _ h => rw [mul_smul_comm]; exact Submodule.smul_mem _ d h
          have h1 : (1 : FractionRing D) ∈ (I : Submodule D (FractionRing D)) * ↑I⁻¹ := by
            rw [hIJ]; exact Submodule.mem_one.mpr ⟨1, map_one _⟩
          have h3 : w * 1 ∈ (↑I⁻¹ : Submodule D (FractionRing D)) := by
            refine Submodule.mul_induction_on (C := fun r => w * r ∈ (↑I⁻¹ : Submodule D (FractionRing D))) h1 ?_ ?_
            · intro m hm n hn
              obtain ⟨d, hd⟩ := Submodule.mem_one.mp (h2 m hm)
              rw [← mul_assoc, ← hd, ← Algebra.smul_def]
              exact Submodule.smul_mem _ d hn
            · intro a b ha hb
              rw [mul_add]; exact Submodule.add_mem _ ha hb
          rwa [mul_one] at h3
      refine ⟨Units.mk0 z⁻¹ (inv_ne_zero hz), ?_⟩
      apply Units.ext
      rw [Units.coe_map]
      show Submodule.spanSingleton D z⁻¹ = (I : Submodule D (FractionRing D))
      have e1 : Submodule.spanSingleton D z * Submodule.spanSingleton D z⁻¹ =
          (1 : Submodule D (FractionRing D)) := by
        rw [← map_mul, mul_inv_cancel₀ hz, map_one]
      have e2 : (I : Submodule D (FractionRing D)) * Submodule.spanSingleton D z = 1 := by
        rw [Submodule.spanSingleton_apply, ← hJ, hIJ]
      calc Submodule.spanSingleton D z⁻¹ = 1 * Submodule.spanSingleton D z⁻¹ := (one_mul _).symm
        _ = (I : Submodule D (FractionRing D)) * Submodule.spanSingleton D z * Submodule.spanSingleton D z⁻¹ := by rw [e2]
        _ = I := by rw [mul_assoc, e1, mul_one]

    have hall : ∀ P : CommRing.Pic D, P = 1 := by
      intro P
      have hP : P ∈ CommRing.relPic D (FractionRing D) := by
        rw [CommRing.relPic_eq_top]; trivial
      rw [← Submodule.range_unitsToPic] at hP
      obtain ⟨I, rfl⟩ := hP
      have hk : I ∈ (Submodule.unitsToPic D (FractionRing D)).ker := by
        rw [Submodule.ker_unitsToPic]; exact unitP I
      exact hk
    exact ⟨fun a b => (hall a).trans (hall b).symm⟩
  have s5 : ∀ (D : Type u) [CommRing D] [IsDomain D],
      (∀ a b : D, ∃ l : D, ∀ z : D, (a ∣ z ∧ b ∣ z ↔ l ∣ z)) → ∀ (s : D), s ≠ 0 →
      IsDomain (Localization.Away s) ∧ ∀ a b : Localization.Away s, ∃ l : Localization.Away s,
        ∀ z : Localization.Away s, (a ∣ z ∧ b ∣ z ↔ l ∣ z) := by
    intro D _ _ hl s hs
    have hle : Submonoid.powers s ≤ nonZeroDivisors D := powers_le_nonZeroDivisors_of_noZeroDivisors hs
    have hinj : Function.Injective (algebraMap D (Localization.Away s)) :=
      IsLocalization.injective (Localization.Away s) hle
    have hu : IsUnit (algebraMap D (Localization.Away s) s) := IsLocalization.Away.algebraMap_isUnit s
    refine ⟨IsLocalization.isDomain_of_le_nonZeroDivisors (Localization.Away s) hle, fun a b => ?_⟩
    obtain ⟨n, a₀, ha₀⟩ := IsLocalization.Away.surj s a
    obtain ⟨m, b₀, hb₀⟩ := IsLocalization.Away.surj s b
    obtain ⟨l₀, hl₀⟩ := hl a₀ b₀
    refine ⟨algebraMap D (Localization.Away s) l₀, fun z => ?_⟩
    have hA : Associated a (algebraMap D (Localization.Away s) a₀) := by
      rw [← ha₀]; exact associated_mul_unit_right a _ (hu.pow n)
    have hB : Associated b (algebraMap D (Localization.Away s) b₀) := by
      rw [← hb₀]; exact associated_mul_unit_right b _ (hu.pow m)
    rw [hA.dvd_iff_dvd_left, hB.dvd_iff_dvd_left]
    constructor
    · rintro ⟨⟨w₁, hw₁⟩, ⟨w₂, hw₂⟩⟩
      obtain ⟨n₁, c₁, hc₁⟩ := IsLocalization.Away.surj s w₁
      obtain ⟨n₂, c₂, hc₂⟩ := IsLocalization.Away.surj s w₂
      have he : a₀ * c₁ * s ^ n₂ = b₀ * c₂ * s ^ n₁ := by
        apply hinj
        simp only [map_mul, map_pow]
        rw [← hc₁, ← hc₂]
        calc algebraMap D (Localization.Away s) a₀ * (w₁ * algebraMap D (Localization.Away s) s ^ n₁) *
              algebraMap D (Localization.Away s) s ^ n₂
            = (algebraMap D (Localization.Away s) a₀ * w₁) * (algebraMap D (Localization.Away s) s ^ n₁ *
              algebraMap D (Localization.Away s) s ^ n₂) := by ring
          _ = (algebraMap D (Localization.Away s) b₀ * w₂) * (algebraMap D (Localization.Away s) s ^ n₁ *
              algebraMap D (Localization.Away s) s ^ n₂) := by rw [← hw₁, ← hw₂]
          _ = _ := by ring
      have hdvd : l₀ ∣ a₀ * c₁ * s ^ n₂ :=
        (hl₀ _).mp ⟨by rw [mul_assoc]; exact dvd_mul_right _ _, by rw [he, mul_assoc]; exact dvd_mul_right _ _⟩
      have h2 := map_dvd (algebraMap D (Localization.Away s)) hdvd
      have h3 : algebraMap D (Localization.Away s) (a₀ * c₁ * s ^ n₂) =
          z * algebraMap D (Localization.Away s) (s ^ (n₁ + n₂)) := by
        simp only [map_mul, map_pow]
        rw [← hc₁, hw₁]
        ring
      rw [h3] at h2
      exact (IsUnit.dvd_mul_right (by rw [map_pow]; exact hu.pow _)).mp h2
    · intro h
      have h1 := (hl₀ l₀).mpr dvd_rfl
      exact ⟨(map_dvd _ h1.1).trans h, (map_dvd _ h1.2).trans h⟩
  obtain ⟨hBd, hBl, hu⟩ := wc_cpt_shens_coord_ring_facts A d y hy hy0 B Λ W' φ a ha β hβ
  haveI := hBd
  obtain ⟨hCd, hCl⟩ := s5 B hBl (β (MvPolynomial.X none)) hu.ne_zero
  haveI := hCd
  haveI hPic : Subsingleton (CommRing.Pic (Localization.Away (β (MvPolynomial.X none)))) :=
    s4 _ hCl

  have h0 : Nat.card (wcEtCoh (Spec (.of (Localization.Away (β (MvPolynomial.X none))))) ℓ 0) = ℓ :=
    wc_et_coh_zero_connected_card _ ℓ hℓ.ne_zero
  refine ⟨h0, ?_⟩

  obtain ⟨ω, hω⟩ := wc_henselian_sepClosed_primitive_root A ℓ hunit
  have hωu : ∀ i : ℕ, 0 < i → i < ℓ → IsUnit (1 - ω ^ i) := by
    intro i hi0 hiℓ
    obtain ⟨n, hn⟩ : ∃ n, ℓ = n + 1 := ⟨ℓ - 1, by have := hℓ.pos; omega⟩
    have hω' : IsPrimitiveRoot ω (n + 1) := hn ▸ hω
    have hprod := hω'.prod_one_sub_pow_eq_order
    have hpu : IsUnit (∏ k ∈ Finset.range n, (1 - ω ^ (k + 1))) := by
      rw [hprod]
      have : ((n : A) + 1) = ((ℓ : ℕ) : A) := by rw [hn]; push_cast; ring
      rw [this]; exact hunit
    have hmem : i - 1 ∈ Finset.range n := Finset.mem_range.mpr (by omega)
    have hdvd := Finset.dvd_prod_of_mem (fun k => 1 - ω ^ (k + 1)) hmem
    have hi : i - 1 + 1 = i := by omega
    simp only [hi] at hdvd
    exact isUnit_of_dvd_unit hdvd hpu
  set g : A →+* Localization.Away (β (MvPolynomial.X none)) :=
    (algebraMap B (Localization.Away (β (MvPolynomial.X none)))).comp
      (β.comp (algebraMap A (MvPolynomial (Option (Fin d)) A))) with hg
  have hζu : ∀ i : ℕ, 0 < i → i < ℓ → IsUnit (1 - (g ω) ^ i) := by
    intro i hi0 hiℓ
    have := (hωu i hi0 hiℓ).map g
    rwa [map_sub, map_one, map_pow] at this
  have hζ : IsPrimitiveRoot (g ω) ℓ := by
    refine IsPrimitiveRoot.mk_of_lt _ hℓ.pos ?_ ?_
    · rw [← map_pow, hω.pow_eq_one, map_one]
    · intro i hi0 hiℓ h1
      have := hζu i hi0 hiℓ
      rw [h1, sub_self] at this
      exact not_isUnit_zero this
  have hℓC : IsUnit ((ℓ : ℕ) : Localization.Away (β (MvPolynomial.X none))) := by
    have := hunit.map g
    rwa [map_natCast] at this
  have hℓB : IsUnit ((ℓ : ℕ) : B) := by
    have := hunit.map (β.comp (algebraMap A (MvPolynomial (Option (Fin d)) A)))
    rwa [map_natCast] at this
  rw [wc_cpt_ring_kummer_h1_card _ ℓ hℓ hℓC (g ω) hζ hζu]
  have hP1 : Nat.card {x : CommRing.Pic (Localization.Away (β (MvPolynomial.X none))) // x ^ ℓ = 1} = 1 :=
    Nat.card_eq_one_iff_unique.mpr ⟨inferInstance, ⟨⟨1, one_pow ℓ⟩⟩⟩
  rw [hP1, one_mul]
  exact s3 B (β (MvPolynomial.X none)) hu ℓ hℓ.pos (s2 B ℓ hℓ.pos hℓB)

theorem wc_P1_ring_charts : ∀ (A : Type u) [CommRing A], ∃ (j c : Spec (.of (Polynomial A)) ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) A) MvPolynomial.gradedAlgebra), IsOpenImmersion j ∧ IsOpenImmersion c ∧ IsAffineHom j ∧ (∀ x, x ∈ Set.range j ∨ x ∈ Set.range c) ∧ IsPullback (Spec.map (CommRingCat.ofHom (Polynomial.eval₂RingHom (algebraMap A (LaurentPolynomial A)) (LaurentPolynomial.T (-1))))) (Spec.map (CommRingCat.ofHom (Polynomial.toLaurent : Polynomial A →+* LaurentPolynomial A))) j c :=
by
  intro A _
  let 𝒜 : ℕ → Submodule A (MvPolynomial (Fin 2) A) := MvPolynomial.homogeneousSubmodule (Fin 2) A
  let _inst𝒜 : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra

  have fin2 : ∀ a b c : Fin 2, a ≠ b → c ≠ a → c = b := by decide
  have hX : ∀ i : Fin 2, (MvPolynomial.X i : MvPolynomial (Fin 2) A) ∈ 𝒜 1 := fun i =>
    (MvPolynomial.mem_homogeneousSubmodule 1 _).2 (MvPolynomial.isHomogeneous_X A i)
  have h11 : ∀ k : Fin 2, (MvPolynomial.X k : MvPolynomial (Fin 2) A) ∈ 𝒜 (1 • 1) := fun k => by
    rw [smul_eq_mul, mul_one]; exact hX k

  have s1 : ∀ {T : Type u} [CommRing T] (f : A →+* T) (g : Fin 2 → T) (c : T)
      (φ : MvPolynomial (Fin 2) A) (n : ℕ), φ.IsHomogeneous n →
      MvPolynomial.eval₂ f (fun i => c * g i) φ = c ^ n * MvPolynomial.eval₂ f g φ := by
    intro T _ f g c φ n hφ
    conv_lhs => rw [φ.as_sum]
    conv_rhs => rw [φ.as_sum]
    rw [MvPolynomial.eval₂_sum, MvPolynomial.eval₂_sum, Finset.mul_sum]
    refine Finset.sum_congr rfl (fun d hd => ?_)
    rw [MvPolynomial.eval₂_monomial, MvPolynomial.eval₂_monomial]
    have hdeg : ∑ i ∈ d.support, d i = n := by
      have := hφ (MvPolynomial.mem_support_iff.mp hd)
      simpa [Finsupp.weight_apply, Finsupp.sum] using this
    simp only [Finsupp.prod, mul_pow, Finset.prod_mul_distrib, Finset.prod_pow_eq_pow_sum, hdeg]
    ring

  have hval0 : ∀ (f : MvPolynomial (Fin 2) A) (a : ↥(𝒜 0)),
      (HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers f) a).val =
        algebraMap (MvPolynomial (Fin 2) A) (Localization.Away f) (a : MvPolynomial (Fin 2) A) := by
    intro f a
    rfl
  have hcoe0 : ∀ r : A, ((algebraMap A (𝒜 0) r : ↥(𝒜 0)) : MvPolynomial (Fin 2) A) = MvPolynomial.C r := by
    intro r
    rw [SetLike.GradeZero.coe_algebraMap, MvPolynomial.algebraMap_eq]

  have chart : ∀ i k : Fin 2, i ≠ k → ∃ e : Polynomial A ≃+* HomogeneousLocalization.Away 𝒜 (MvPolynomial.X i),
      (∀ r : A, e (Polynomial.C r) = HomogeneousLocalization.fromZeroRingHom 𝒜
        (Submonoid.powers (MvPolynomial.X i)) (algebraMap A (𝒜 0) r)) ∧
      e Polynomial.X = HomogeneousLocalization.Away.mk 𝒜 (hX i) 1 (MvPolynomial.X k) (h11 k) := by
    intro i k hik
    obtain ⟨κ, hκ⟩ : ∃ κ : A →+* HomogeneousLocalization.Away 𝒜 (MvPolynomial.X i),
        κ = (HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers (MvPolynomial.X i))).comp
          (algebraMap A (𝒜 0)) := ⟨_, rfl⟩
    obtain ⟨α, hα⟩ : ∃ α : Polynomial A →+* HomogeneousLocalization.Away 𝒜 (MvPolynomial.X i),
        α = Polynomial.eval₂RingHom κ
          (HomogeneousLocalization.Away.mk 𝒜 (hX i) 1 (MvPolynomial.X k) (h11 k)) := ⟨_, rfl⟩
    obtain ⟨ψ, hψ⟩ : ∃ ψ : MvPolynomial (Fin 2) A →+* Polynomial A,
        ψ = MvPolynomial.eval₂Hom Polynomial.C (fun j => if j = i then 1 else Polynomial.X) := ⟨_, rfl⟩
    have hψi : ψ (MvPolynomial.X i) = 1 := by rw [hψ, MvPolynomial.eval₂Hom_X', if_pos rfl]
    have hψk : ψ (MvPolynomial.X k) = Polynomial.X := by
      rw [hψ, MvPolynomial.eval₂Hom_X', if_neg (Ne.symm hik)]
    have hψC : ∀ r, ψ (MvPolynomial.C r) = Polynomial.C r := by
      intro r; rw [hψ, MvPolynomial.eval₂Hom_C]
    have hψv : ψ (MvPolynomial.X i) * 1 = 1 := by rw [hψi, mul_one]
    have hu : IsUnit (ψ (MvPolynomial.X i)) := by rw [hψi]; exact isUnit_one
    obtain ⟨χ, hχ⟩ : ∃ χ : HomogeneousLocalization.Away 𝒜 (MvPolynomial.X i) →+* Polynomial A,
        χ = (Localization.awayLift ψ (MvPolynomial.X i) hu).comp
          (algebraMap (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X i))
            (Localization.Away (MvPolynomial.X i : MvPolynomial (Fin 2) A))) := ⟨_, rfl⟩
    have hχmk : ∀ (n : ℕ) (a : MvPolynomial (Fin 2) A) (ha : a ∈ 𝒜 (n • 1)),
        χ (HomogeneousLocalization.Away.mk 𝒜 (hX i) n a ha) = ψ a := by
      intro n a ha
      rw [hχ, RingHom.comp_apply, HomogeneousLocalization.algebraMap_apply,
        HomogeneousLocalization.Away.val_mk, Localization.awayLift_mk ψ (MvPolynomial.X i) a 1 hψv n,
        one_pow, mul_one]
    have hκv : ∀ r, (κ r).val = algebraMap (MvPolynomial (Fin 2) A)
        (Localization.Away (MvPolynomial.X i : MvPolynomial (Fin 2) A)) (MvPolynomial.C r) := by
      intro r
      rw [hκ, RingHom.comp_apply, hval0, hcoe0]
    have h1 : χ.comp α = RingHom.id _ := by
      apply Polynomial.ringHom_ext
      · intro r
        rw [RingHom.comp_apply, hα, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C, hχ,
          RingHom.comp_apply, HomogeneousLocalization.algebraMap_apply, hκv]
        first
          | rw [IsLocalization.lift_eq]
          | erw [IsLocalization.lift_eq]
        rw [hψC, RingHom.id_apply]
      · rw [RingHom.comp_apply, hα, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X, hχmk, hψk,
          RingHom.id_apply]
    have h2 : α.comp χ = RingHom.id _ := by
      refine RingHom.ext fun w => ?_
      obtain ⟨n, a, ha, rfl⟩ := HomogeneousLocalization.Away.mk_surjective 𝒜 (hX i) w
      rw [RingHom.comp_apply, hχmk, RingHom.id_apply]
      apply HomogeneousLocalization.val_injective
      rw [HomogeneousLocalization.Away.val_mk]
      have ha' : a.IsHomogeneous n := by
        have := (MvPolynomial.mem_homogeneousSubmodule _ a).1 ha
        simpa using this
      obtain ⟨μ, hμdef⟩ : ∃ μ : Localization.Away (MvPolynomial.X i : MvPolynomial (Fin 2) A),
          μ = IsLocalization.mk' (Localization.Away (MvPolynomial.X i : MvPolynomial (Fin 2) A))
            (1 : MvPolynomial (Fin 2) A) ⟨MvPolynomial.X i, Submonoid.mem_powers _⟩ := ⟨_, rfl⟩
      have hμ : μ * algebraMap (MvPolynomial (Fin 2) A)
          (Localization.Away (MvPolynomial.X i : MvPolynomial (Fin 2) A)) (MvPolynomial.X i) = 1 := by
        have := IsLocalization.mk'_spec (Localization.Away (MvPolynomial.X i : MvPolynomial (Fin 2) A))
          (1 : MvPolynomial (Fin 2) A) ⟨MvPolynomial.X i, Submonoid.mem_powers _⟩
        rw [map_one] at this
        rw [hμdef]; exact this
      have hρ : (algebraMap (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X i))
            (Localization.Away (MvPolynomial.X i : MvPolynomial (Fin 2) A))).comp (α.comp ψ) =
          MvPolynomial.eval₂Hom ((algebraMap (MvPolynomial (Fin 2) A)
            (Localization.Away (MvPolynomial.X i : MvPolynomial (Fin 2) A))).comp MvPolynomial.C)
            (fun j => μ * algebraMap (MvPolynomial (Fin 2) A)
              (Localization.Away (MvPolynomial.X i : MvPolynomial (Fin 2) A)) (MvPolynomial.X j)) := by
        apply MvPolynomial.ringHom_ext
        · intro r
          simp only [MvPolynomial.eval₂Hom_C, RingHom.comp_apply]
          rw [hψC, hα, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C,
            HomogeneousLocalization.algebraMap_apply, hκv]
        · intro j
          simp only [MvPolynomial.eval₂Hom_X', RingHom.comp_apply]
          by_cases hj : j = i
          · subst hj
            rw [hψi, map_one, map_one, hμ]
          · have hjk : j = k := fin2 i k j hik hj
            subst hjk
            rw [hψk, hα, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X,
              HomogeneousLocalization.algebraMap_apply, HomogeneousLocalization.Away.val_mk,
              Localization.mk_eq_mk'_apply, IsLocalization.mk'_eq_iff_eq_mul]
            show _ = μ * _ * algebraMap (MvPolynomial (Fin 2) A)
              (Localization.Away (MvPolynomial.X i : MvPolynomial (Fin 2) A)) (MvPolynomial.X i ^ 1)
            rw [pow_one, mul_comm μ, mul_assoc, hμ, mul_one]
      have hσ : MvPolynomial.eval₂Hom ((algebraMap (MvPolynomial (Fin 2) A)
            (Localization.Away (MvPolynomial.X i : MvPolynomial (Fin 2) A))).comp MvPolynomial.C)
            (fun j => algebraMap (MvPolynomial (Fin 2) A)
              (Localization.Away (MvPolynomial.X i : MvPolynomial (Fin 2) A)) (MvPolynomial.X j)) =
          algebraMap (MvPolynomial (Fin 2) A)
            (Localization.Away (MvPolynomial.X i : MvPolynomial (Fin 2) A)) := by
        apply MvPolynomial.ringHom_ext
        · intro r; simp only [MvPolynomial.eval₂Hom_C, RingHom.comp_apply]
        · intro j; simp only [MvPolynomial.eval₂Hom_X']
      have hval : (α (ψ a)).val = ((algebraMap (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X i))
            (Localization.Away (MvPolynomial.X i : MvPolynomial (Fin 2) A))).comp (α.comp ψ)) a := by
        rw [RingHom.comp_apply, RingHom.comp_apply, HomogeneousLocalization.algebraMap_apply]
      rw [hval, hρ, MvPolynomial.coe_eval₂Hom, s1 _ (fun j => algebraMap (MvPolynomial (Fin 2) A)
          (Localization.Away (MvPolynomial.X i : MvPolynomial (Fin 2) A)) (MvPolynomial.X j)) μ a n ha',
        ← MvPolynomial.coe_eval₂Hom, hσ, Localization.mk_eq_mk'_apply, eq_comm,
        IsLocalization.mk'_eq_iff_eq_mul]
      show _ = μ ^ n * _ * algebraMap (MvPolynomial (Fin 2) A)
        (Localization.Away (MvPolynomial.X i : MvPolynomial (Fin 2) A)) (MvPolynomial.X i ^ n)
      rw [map_pow, mul_comm (μ ^ n), mul_assoc, ← mul_pow, hμ, one_pow, mul_one]
    refine ⟨RingEquiv.ofRingHom α χ h2 h1, ?_, ?_⟩
    · intro r
      show α (Polynomial.C r) = _
      rw [hα, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C, hκ, RingHom.comp_apply]
    · show α Polynomial.X = _
      rw [hα, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X]

  have specIso : ∀ {R R' : Type u} [CommRing R] [CommRing R'] (e : R ≃+* R'),
      ∃ E : Spec (CommRingCat.of R') ≅ Spec (CommRingCat.of R),
        E.hom = Spec.map (CommRingCat.ofHom e.toRingHom) := by
    intro R R' _ _ e
    refine ⟨⟨Spec.map (CommRingCat.ofHom e.toRingHom), Spec.map (CommRingCat.ofHom e.symm.toRingHom),
      ?_, ?_⟩, rfl⟩
    · rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, RingEquiv.toRingHom_comp_symm_toRingHom,
        CommRingCat.ofHom_id, Spec.map_id]
    · rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, RingEquiv.symm_toRingHom_comp_toRingHom,
        CommRingCat.ofHom_id, Spec.map_id]
  obtain ⟨e0, he0C, he0X⟩ := chart 0 1 (by decide)
  obtain ⟨e1, he1C, he1X⟩ := chart 1 0 (by decide)

  have hx' : (MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin 2) A) =
      MvPolynomial.X 1 * MvPolynomial.X 0 := mul_comm _ _
  letI alg : Algebra (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X 1))
      (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X 0 * MvPolynomial.X 1)) :=
    (HomogeneousLocalization.awayMap 𝒜 (hX 0) hx').toAlgebra
  haveI hloc : IsLocalization.Away (HomogeneousLocalization.Away.isLocalizationElem (hX 1) (hX 0))
      (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X 0 * MvPolynomial.X 1)) :=
    HomogeneousLocalization.Away.isLocalization_mul (hX 1) (hX 0) hx' one_ne_zero
  have helem : e1 Polynomial.X = HomogeneousLocalization.Away.isLocalizationElem (hX 1) (hX 0) := by
    rw [he1X]
    apply HomogeneousLocalization.val_injective
    simp only [HomogeneousLocalization.Away.isLocalizationElem, HomogeneousLocalization.Away.val_mk,
      pow_one]
  have H : Submonoid.map e1.toMonoidHom (Submonoid.powers (Polynomial.X : Polynomial A)) =
      Submonoid.powers (HomogeneousLocalization.Away.isLocalizationElem (hX 1) (hX 0)) := by
    rw [Submonoid.map_powers]
    exact congrArg Submonoid.powers helem
  obtain ⟨e01, he01⟩ : ∃ e01 : LaurentPolynomial A ≃+*
      HomogeneousLocalization.Away 𝒜 (MvPolynomial.X 0 * MvPolynomial.X 1),
      e01 = IsLocalization.ringEquivOfRingEquiv (LaurentPolynomial A)
        (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X 0 * MvPolynomial.X 1)) e1 H := ⟨_, rfl⟩
  have Sq2 : e01.toRingHom.comp (Polynomial.toLaurent : Polynomial A →+* LaurentPolynomial A) =
      (HomogeneousLocalization.awayMap 𝒜 (hX 0) hx').comp e1.toRingHom := by
    refine RingHom.ext fun p => ?_
    show e01 (Polynomial.toLaurent p) = HomogeneousLocalization.awayMap 𝒜 (hX 0) hx' (e1 p)
    rw [← LaurentPolynomial.algebraMap_eq_toLaurent, he01, IsLocalization.ringEquivOfRingEquiv_eq]
    rfl
  have hS2' : ∀ p : Polynomial A, e01 (Polynomial.toLaurent p) =
      HomogeneousLocalization.awayMap 𝒜 (hX 0) hx' (e1 p) := fun p => by
    have := congrArg (fun φ => φ p) Sq2
    exact this
  have hCL : ∀ r : A, Polynomial.eval₂RingHom (algebraMap A (LaurentPolynomial A))
      (LaurentPolynomial.T (-1)) (Polynomial.C r) = Polynomial.toLaurent (Polynomial.C r) := by
    intro r
    rw [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
    first
      | rfl
      | simp [Polynomial.toLaurent_C, LaurentPolynomial.algebraMap_apply]
  have Sq1 : e01.toRingHom.comp (Polynomial.eval₂RingHom (algebraMap A (LaurentPolynomial A))
        (LaurentPolynomial.T (-1))) =
      (HomogeneousLocalization.awayMap 𝒜 (hX 1)
        (rfl : (MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin 2) A) =
          MvPolynomial.X 0 * MvPolynomial.X 1)).comp e0.toRingHom := by
    apply Polynomial.ringHom_ext
    · intro r
      show e01 (Polynomial.eval₂RingHom (algebraMap A (LaurentPolynomial A))
        (LaurentPolynomial.T (-1)) (Polynomial.C r)) = HomogeneousLocalization.awayMap 𝒜 (hX 1)
        (rfl : (MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin 2) A) =
          MvPolynomial.X 0 * MvPolynomial.X 1) (e0 (Polynomial.C r))
      rw [hCL, hS2', he0C, he1C, HomogeneousLocalization.awayMap_fromZeroRingHom,
        HomogeneousLocalization.awayMap_fromZeroRingHom]
    · show e01 (Polynomial.eval₂RingHom (algebraMap A (LaurentPolynomial A))
        (LaurentPolynomial.T (-1)) Polynomial.X) = HomogeneousLocalization.awayMap 𝒜 (hX 1)
        (rfl : (MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin 2) A) =
          MvPolynomial.X 0 * MvPolynomial.X 1) (e0 Polynomial.X)
      have hT1 : e01 (LaurentPolynomial.T 1) =
          HomogeneousLocalization.awayMap 𝒜 (hX 0) hx' (e1 Polynomial.X) := by
        rw [← Polynomial.toLaurent_X]; exact hS2' _
      have hK : HomogeneousLocalization.awayMap 𝒜 (hX 1)
            (rfl : (MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin 2) A) =
              MvPolynomial.X 0 * MvPolynomial.X 1) (e0 Polynomial.X) *
          HomogeneousLocalization.awayMap 𝒜 (hX 0) hx' (e1 Polynomial.X) = 1 := by
        rw [he0X, he1X, HomogeneousLocalization.awayMap_mk, HomogeneousLocalization.awayMap_mk]
        apply HomogeneousLocalization.val_injective
        rw [HomogeneousLocalization.val_mul, HomogeneousLocalization.val_one,
          HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.Away.val_mk, Localization.mk_mul,
          ← Localization.mk_one, Localization.mk_eq_mk_iff, Localization.r_iff_exists]
        refine ⟨1, ?_⟩
        simp only [Submonoid.coe_mul, OneMemClass.coe_one, one_mul, mul_one, pow_one]
        ring
      have hb : e01 (LaurentPolynomial.T (-1)) * e01 (LaurentPolynomial.T 1) = 1 := by
        rw [← map_mul, ← LaurentPolynomial.T_add, show (-1 : ℤ) + 1 = 0 by norm_num,
          LaurentPolynomial.T_zero, map_one]
      rw [hT1] at hb
      rw [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X]
      calc e01 (LaurentPolynomial.T (-1))
          = e01 (LaurentPolynomial.T (-1)) * (HomogeneousLocalization.awayMap 𝒜 (hX 1)
            (rfl : (MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin 2) A) =
              MvPolynomial.X 0 * MvPolynomial.X 1) (e0 Polynomial.X) *
            HomogeneousLocalization.awayMap 𝒜 (hX 0) hx' (e1 Polynomial.X)) := by rw [hK, mul_one]
        _ = HomogeneousLocalization.awayMap 𝒜 (hX 1)
            (rfl : (MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin 2) A) =
              MvPolynomial.X 0 * MvPolynomial.X 1) (e0 Polynomial.X) *
            (e01 (LaurentPolynomial.T (-1)) *
              HomogeneousLocalization.awayMap 𝒜 (hX 0) hx' (e1 Polynomial.X)) := by ring
        _ = _ := by rw [hb, mul_one]

  obtain ⟨E0, hE0⟩ := specIso e0
  obtain ⟨E1, hE1⟩ := specIso e1
  obtain ⟨E01, hE01⟩ := specIso e01
  obtain ⟨j, hj⟩ : ∃ j : Spec (CommRingCat.of (Polynomial A)) ⟶ Proj 𝒜,
      j = E0.inv ≫ Proj.awayι 𝒜 (MvPolynomial.X 0) (hX 0) one_pos := ⟨_, rfl⟩
  obtain ⟨c, hc⟩ : ∃ c : Spec (CommRingCat.of (Polynomial A)) ⟶ Proj 𝒜,
      c = E1.inv ≫ Proj.awayι 𝒜 (MvPolynomial.X 1) (hX 1) one_pos := ⟨_, rfl⟩
  have hj0 : E0.hom ≫ j = Proj.awayι 𝒜 (MvPolynomial.X 0) (hX 0) one_pos := by
    rw [hj, Iso.hom_inv_id_assoc]
  have hc0 : E1.hom ≫ c = Proj.awayι 𝒜 (MvPolynomial.X 1) (hX 1) one_pos := by
    rw [hc, Iso.hom_inv_id_assoc]

  have hirr : (HomogeneousIdeal.irrelevant 𝒜).toIdeal ≤
      Ideal.span (Set.range (MvPolynomial.X : Fin 2 → MvPolynomial (Fin 2) A)) := by
    intro a ha
    have h0 : GradedRing.proj 𝒜 0 a = 0 := (HomogeneousIdeal.mem_irrelevant_iff 𝒜 a).1 ha
    have hc : a.coeff 0 = 0 := by
      have h1 : GradedRing.proj 𝒜 0 a = MvPolynomial.homogeneousComponent 0 a :=
        MvPolynomial.decomposition.decompose'_apply a 0
      rw [h1, MvPolynomial.homogeneousComponent_zero] at h0
      exact MvPolynomial.C_injective (Fin 2) A (h0.trans (map_zero _).symm)
    rw [← Set.image_univ, MvPolynomial.mem_ideal_span_X_image]
    intro m hm
    have hm0 : m ≠ 0 := by
      rintro rfl
      exact (MvPolynomial.mem_support_iff.1 hm) hc
    obtain ⟨i, hi⟩ := Finsupp.ne_iff.1 hm0
    exact ⟨i, Set.mem_univ _, hi⟩
  have htop := Proj.iSup_basicOpen_eq_top 𝒜 (MvPolynomial.X : Fin 2 → MvPolynomial (Fin 2) A) hirr
  refine ⟨j, c, ?_, ?_, ?_, ?_, ?_⟩
  · rw [hj]; infer_instance
  · rw [hc]; infer_instance
  · have : IsAffineHom (j ≫ Proj.toSpecZero 𝒜) := isAffineHom_of_isAffine _
    have := Proj.isSeparated 𝒜
    exact IsAffineHom.of_comp j (Proj.toSpecZero 𝒜)
  · intro p
    have hp : p ∈ (⊤ : (Proj 𝒜).Opens) := trivial
    rw [← htop, TopologicalSpace.Opens.mem_iSup] at hp
    obtain ⟨i, hi⟩ := hp
    have hi' : p ∈ Set.range (Proj.awayι 𝒜 (MvPolynomial.X i) (hX i) one_pos) := by
      rw [← Scheme.Hom.coe_opensRange, Proj.opensRange_awayι]; exact hi
    obtain ⟨y, hy⟩ := hi'
    have hi2 : i = 0 ∨ i = 1 := by fin_cases i <;> simp
    rcases hi2 with rfl | rfl
    · refine Or.inl ⟨E0.hom y, ?_⟩
      rw [← hy, ← hj0]
      rfl
    · refine Or.inr ⟨E1.hom y, ?_⟩
      rw [← hy, ← hc0]
      rfl
  · refine IsPullback.of_iso (IsPullback.of_hasPullback
      (Proj.awayι 𝒜 (MvPolynomial.X 0) (hX 0) one_pos) (Proj.awayι 𝒜 (MvPolynomial.X 1) (hX 1) one_pos))
      (Proj.pullbackAwayιIso 𝒜 (hX 0) one_pos (hX 1) one_pos rfl ≪≫ E01) E0 E1 (Iso.refl _)
      ?_ ?_ ?_ ?_
    · rw [Iso.trans_hom, hE0, hE01, Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp, Sq1,
        CommRingCat.ofHom_comp, Spec.map_comp, ← Category.assoc,
        Proj.pullbackAwayιIso_hom_SpecMap_awayMap_left]
    · rw [Iso.trans_hom, hE1, hE01, Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp, Sq2,
        CommRingCat.ofHom_comp, Spec.map_comp, ← Category.assoc,
        Proj.pullbackAwayιIso_hom_SpecMap_awayMap_right]
    · rw [Iso.refl_hom, Category.comp_id, hj0]
    · rw [Iso.refl_hom, Category.comp_id, hc0]

theorem wc_P1_closed_fibre_embedding : ∀ (A : Type u) [CommRing A] [IsLocalRing A] (φ : Spec (.of ((MvPolynomial.homogeneousSubmodule (Fin 2) A) 0)) ≅ Spec (.of A)), ∃ i : @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) (IsLocalRing.ResidueField A)) MvPolynomial.gradedAlgebra ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) A) MvPolynomial.gradedAlgebra, IsClosedImmersion i ∧ ∀ x, x ∈ Set.range i ↔ (wcP1 A ≫ φ.hom) x = IsLocalRing.closedPoint A :=
by
  intro A _ _ φ
  have ih : ∀ {X Y : Scheme.{u}} (e : X ≅ Y) (w : Y), e.hom (e.inv w) = w := by
    intro X Y e w
    rw [← Scheme.Hom.comp_apply, e.inv_hom_id]
    try rfl
  have hi : ∀ {X Y : Scheme.{u}} (e : X ≅ Y) (w : X), e.inv (e.hom w) = w := by
    intro X Y e w
    rw [← Scheme.Hom.comp_apply, e.hom_inv_id]
    try rfl
  obtain ⟨e1A, e2A, heA⟩ := wc_pd_P1_base_iso A
  obtain ⟨e1k, _, _⟩ := wc_pd_P1_base_iso (IsLocalRing.ResidueField A)
  let r : Spec (.of (IsLocalRing.ResidueField A)) ⟶ Spec (.of A) :=
    Spec.map (CommRingCat.ofHom (IsLocalRing.residue A))
  haveI hr : IsClosedImmersion r :=
    IsClosedImmersion.spec_of_surjective _ IsLocalRing.residue_surjective
  have sq := IsPullback.of_prod_fst_with_id r wcPdP1Z.{u}
  haveI hm : IsClosedImmersion (Limits.prod.map r (𝟙 wcPdP1Z.{u})) :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion) sq hr
  have hrm : Set.range (Limits.prod.map r (𝟙 wcPdP1Z.{u})) =
      (Limits.prod.fst : Spec (.of A) ⨯ wcPdP1Z.{u} ⟶ _) ⁻¹' Set.range r := by
    rw [← Scheme.Pullback.range_snd]
    have key : sq.isoPullback.inv ≫ Limits.prod.map r (𝟙 wcPdP1Z.{u}) =
        Limits.pullback.snd r Limits.prod.fst := by
      rw [Iso.inv_comp_eq]
      exact sq.isoPullback_hom_snd.symm
    ext z
    constructor
    · rintro ⟨w, rfl⟩
      exact ⟨sq.isoPullback.hom w, by rw [← Scheme.Hom.comp_apply, sq.isoPullback_hom_snd]⟩
    · rintro ⟨w, rfl⟩
      exact ⟨sq.isoPullback.inv w, by rw [← Scheme.Hom.comp_apply, key]⟩
  have hk : ∀ y : Spec (.of (IsLocalRing.ResidueField A)), r y = IsLocalRing.closedPoint A := by
    intro y
    have hy : y = IsLocalRing.closedPoint (IsLocalRing.ResidueField A) := by
      first
        | exact Subsingleton.elim _ _
        | (apply PrimeSpectrum.ext
           show y.asIdeal = IsLocalRing.maximalIdeal _
           rw [IsLocalRing.maximalIdeal_eq_bot]
           exact Ideal.eq_bot_of_prime _)
    rw [hy]
    first
      | exact IsLocalRing.comap_closedPoint (IsLocalRing.residue A)
      | (rw [Spec.map_apply]; exact IsLocalRing.comap_closedPoint (IsLocalRing.residue A))
      | (simp only [r, Spec.map_apply, CommRingCat.hom_ofHom]
         exact IsLocalRing.comap_closedPoint (IsLocalRing.residue A))
  have hrr : ∀ x : Spec (.of A), x ∈ Set.range r ↔ x = IsLocalRing.closedPoint A := by
    intro x
    constructor
    · rintro ⟨y, rfl⟩; exact hk y
    · rintro rfl; exact ⟨IsLocalRing.closedPoint _, hk _⟩
  have fix : ∀ g : Spec (.of A) ≅ Spec (.of A),
      g.hom (IsLocalRing.closedPoint A) = IsLocalRing.closedPoint A := by
    intro g
    have h0 : g.hom (IsLocalRing.closedPoint A) ⤳ IsLocalRing.closedPoint A :=
      IsLocalRing.specializes_closedPoint (R := A) _
    obtain ⟨q, hq⟩ : ∃ q : Spec (.of A), g.hom q = IsLocalRing.closedPoint A :=
      ⟨g.inv (IsLocalRing.closedPoint A), ih g _⟩
    have h1 := (IsLocalRing.specializes_closedPoint (R := A) q).map g.hom.continuous
    have h1' : IsLocalRing.closedPoint A ⤳ g.hom (IsLocalRing.closedPoint A) := by
      first
        | (rw [hq] at h1; exact h1)
        | simpa only [hq] using h1
        | exact hq ▸ h1
    first
      | exact (h0.antisymm h1').eq
      | exact h0.antisymm h1'
      | exact (Specializes.antisymm h0 h1')
  have hswap : ∀ y, φ.hom y = IsLocalRing.closedPoint A ↔
      e2A.hom y = IsLocalRing.closedPoint A := by
    intro y
    constructor
    · intro h
      have key : (φ.symm ≪≫ e2A).hom (φ.hom y) = e2A.hom y := by
        show (φ.inv ≫ e2A.hom) (φ.hom y) = _
        rw [Scheme.Hom.comp_apply, hi]
      rw [← key, h]
      exact fix _
    · intro h
      have key : (e2A.symm ≪≫ φ).hom (e2A.hom y) = φ.hom y := by
        show (e2A.inv ≫ φ.hom) (e2A.hom y) = _
        rw [Scheme.Hom.comp_apply, hi]
      rw [← key, h]
      exact fix _
  refine ⟨e1k.hom ≫ Limits.prod.map r (𝟙 wcPdP1Z.{u}) ≫ e1A.inv, inferInstance, ?_⟩
  intro x
  have hfst : (Limits.prod.fst : Spec (.of A) ⨯ wcPdP1Z.{u} ⟶ _) (e1A.hom x) =
      e2A.hom (wcP1 A x) := by
    rw [← Scheme.Hom.comp_apply, heA, Scheme.Hom.comp_apply]
  have key : x ∈ Set.range (e1k.hom ≫ Limits.prod.map r (𝟙 wcPdP1Z.{u}) ≫ e1A.inv) ↔
      e1A.hom x ∈ Set.range (Limits.prod.map r (𝟙 wcPdP1Z.{u})) := by
    constructor
    · rintro ⟨z, rfl⟩
      refine ⟨e1k.hom z, ?_⟩
      rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply, ih]
    · rintro ⟨w, hw⟩
      refine ⟨e1k.inv w, ?_⟩
      rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply, ih, hw, hi]
  rw [key, hrm, Set.mem_preimage, hrr, hfst, Scheme.Hom.comp_apply, hswap]

theorem wc_et_maxsupp_coker_vanish_off : ∀ (Y : Scheme.{u}) (W : Set Y), IsOpen W → ∀ (F J' : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (ι : J' ⟶ F), Mono ι → wcSuppIn Y W J' → (∀ (G : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (φ : G ⟶ F), wcSuppIn Y W G → ∃ φ' : G ⟶ J', φ' ≫ ι = φ) → ∀ (V : Y.Etale) (g : (Limits.cokernel ι).obj.obj (Opposite.op V)) (v : V.left), V.hom v ∈ W → ∃ (V₁ : Y.Etale) (c : V₁ ⟶ V), v ∈ Set.range c.left ∧ (Limits.cokernel ι).obj.map c.op g = 0 :=
by
  intro Y W hW F J' ι hmono hsupp huniv V g v hv
  classical
  let O : V.left.Opens := V.hom ⁻¹ᵁ (⟨W, hW⟩ : Y.Opens)
  refine ⟨wcEtOpen Y V O, wcEtOpenι Y V O, ?_, ?_⟩
  · have hvO : v ∈ O := hv
    show v ∈ Set.range O.ι
    rw [Scheme.Opens.range_ι]
    exact hvO
  · have hV₁ : ∀ y : (wcEtOpen Y V O).left, (wcEtOpen Y V O).hom y ∈ W := by
      intro y
      show V.hom (O.ι y) ∈ W
      have h : O.ι y ∈ Set.range O.ι := Set.mem_range_self y
      rw [Scheme.Opens.range_ι] at h
      exact h
    have hV₂ : ∀ (V₂ : Y.Etale) (h : V₂ ⟶ wcEtOpen Y V O) (x : V₂.left), V₂.hom x ∈ W := by
      intro V₂ h x
      rw [← MorphismProperty.Over.w h, Scheme.Hom.comp_apply]
      exact hV₁ _
    have hS := wc_sheaf_epi_locallySurjective (Scheme.smallEtaleTopology Y)
      (Limits.cokernel.π ι) (wcEtOpen Y V O)
      ((Limits.cokernel ι).obj.map (wcEtOpenι Y V O).op g)
    refine (Limits.cokernel ι).isSeparated _ _ hS _ _ (fun V₂ h hh => ?_)
    obtain ⟨b, hb⟩ := hh
    have hsupp_b : wcSuppSec Y W F V₂ b := by
      have h1 : (Sieve.generate (fun (V' : Y.Etale) (g' : V' ⟶ V₂) =>
          F.obj.map g'.op b = 0 ∨ ∀ x, V'.hom x ∈ W)).arrows (𝟙 V₂) :=
        Sieve.le_generate _ V₂ (𝟙 V₂) (Or.inr (hV₂ V₂ h))
      unfold wcSuppSec
      rw [Sieve.id_mem_iff_eq_top.mp h1]
      exact (Scheme.smallEtaleTopology Y).top_mem V₂
    have h0 := (wc_et_quot_kernel_iff_supp Y W F J' ι hmono hsupp huniv V₂ b).mpr hsupp_b
    rw [map_zero, ← hb]
    exact h0

theorem wc_et_sepclosed_field_line_cd_one : ∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)], IsField A → ∀ (ℓ : ℕ), ℓ.Prime → IsUnit (ℓ : A) → ∀ (G : Sheaf (Scheme.smallEtaleTopology (Spec (.of (Polynomial A)))) AddCommGrpCat.{u+1}), ℓ • 𝟙 G = 0 → ∀ q : ℕ, 2 ≤ q → Subsingleton (wcEtExt (Spec (.of (Polynomial A))) G q) :=
by
  classical

  have hintG : ∀ (k : Type u) [Field k], (algebraMap k (AlgebraicClosure k)).IsIntegral := by
    intro k _
    first
    | exact algebraMap_isIntegral_iff.mpr inferInstance
    | exact fun x => Algebra.IsIntegral.isIntegral x

  have s1 : ∀ (k K : Type u) [Field k] [Field K] [Algebra k K] [IsSepClosed k],
      (algebraMap k K).IsIntegral → ∀ (T : Scheme.{u}) (h : T ⟶ Spec (.of k)),
      IsHomeomorph (Limits.pullback.fst h (Spec.map (CommRingCat.ofHom (algebraMap k K)))) := by
    intro k K _ _ _ _ hint T h
    haveI : Algebra.IsIntegral k K := ⟨hint⟩
    haveI : Algebra.IsAlgebraic k K := Algebra.IsIntegral.isAlgebraic
    haveI : IsPurelyInseparable k K := Algebra.IsAlgebraic.isPurelyInseparable_of_isSepClosed
    haveI hsint : IsIntegralHom (Spec.map (CommRingCat.ofHom (algebraMap k K))) :=
      IsIntegralHom.SpecMap_iff.mpr hint
    have hsinj : UniversallyInjective (Spec.map (CommRingCat.ofHom (algebraMap k K))) := by
      rw [universallyInjective_eq_diagonal]
      change Surjective (Limits.pullback.diagonal (Spec.map (CommRingCat.ofHom (algebraMap k K))))
      have h1 : Subsingleton (PrimeSpectrum (TensorProduct k K K)) :=
        (PrimeSpectrum.isHomeomorph_comap_of_isPurelyInseparable k K K).injective.subsingleton
      haveI : Subsingleton ↥(Spec (CommRingCat.of (TensorProduct k K K))) := h1
      haveI : Subsingleton ↥(Limits.pullback (Spec.map (CommRingCat.ofHom (algebraMap k K)))
          (Spec.map (CommRingCat.ofHom (algebraMap k K)))) :=
        (Scheme.homeoOfIso (pullbackSpecIso k K K)).injective.subsingleton
      obtain ⟨x⟩ : Nonempty (PrimeSpectrum K) := inferInstance
      exact ⟨fun z => ⟨x, Subsingleton.elim _ _⟩⟩
    haveI : UniversallyInjective (Limits.pullback.fst h
        (Spec.map (CommRingCat.ofHom (algebraMap k K)))) :=
      MorphismProperty.of_isPullback (P := @UniversallyInjective)
        (IsPullback.of_hasPullback h _).flip hsinj
    rw [isHomeomorph_iff_continuous_isClosedMap_bijective]
    exact ⟨Scheme.Hom.continuous _, Scheme.Hom.isClosedMap _,
      Scheme.Hom.injective _, Scheme.Hom.surjective _⟩

  have s2 : ∀ (k : Type u) [Field k] [IsSepClosed k] (Y : Scheme.{u}) (f : Y ⟶ Spec (.of k))
      (d : ℕ) [SmoothOfRelativeDimension d f], topologicalKrullDim Y ≤ (d : WithBot ℕ∞) := by
    intro k _ _ Y f d _
    haveI := smoothOfRelativeDimension_isStableUnderBaseChange d
    haveI hS : SmoothOfRelativeDimension d (Limits.pullback.snd f
        (Spec.map (CommRingCat.ofHom (algebraMap k (AlgebraicClosure k))))) :=
      MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension d)
        (IsPullback.of_hasPullback f _) (inferInstance : SmoothOfRelativeDimension d f)
    have h1 := wc_smooth_alg_closed_dim_le (AlgebraicClosure k) _ (Limits.pullback.snd f
        (Spec.map (CommRingCat.ofHom (algebraMap k (AlgebraicClosure k))))) d
    have h2 := (s1 k (AlgebraicClosure k) (hintG k) Y f).topologicalKrullDim_eq
    first
    | (rw [← h2]; exact h1)
    | (rw [h2]; exact h1)

  have s3 : ∀ (Ω : Type u) [Field Ω] [IsSepClosed Ω] (m : ℕ), m ≠ 0 → ∀ (W : Scheme.{u})
      (fW : W ⟶ Spec (.of Ω)) [IsProper fW], topologicalKrullDim W ≤ ((0 : ℕ) : WithBot ℕ∞) →
      ∀ (V : Scheme.{u}) (ι : V ⟶ W) [IsOpenImmersion ι], ∀ q : ℕ, 1 ≤ q →
      Subsingleton (wcEtCoh V m q) := by
    intro Ω _ _ m hm W fW _ hW V ι _ q hq
    have hint := hintG Ω
    haveI hP : IsProper (Limits.pullback.snd fW
        (Spec.map (CommRingCat.ofHom (algebraMap Ω (AlgebraicClosure Ω))))) :=
      MorphismProperty.of_isPullback (P := @IsProper) (IsPullback.of_hasPullback fW _)
        (inferInstance : IsProper fW)
    have hdimK : topologicalKrullDim ↥(Limits.pullback fW
        (Spec.map (CommRingCat.ofHom (algebraMap Ω (AlgebraicClosure Ω))))) ≤
        ((0 : ℕ) : WithBot ℕ∞) := by
      rw [(s1 Ω (AlgebraicClosure Ω) hint W fW).topologicalKrullDim_eq]
      exact hW
    haveI h1 : IsOpenImmersion (Limits.pullback.snd ι (Limits.pullback.fst fW
        (Spec.map (CommRingCat.ofHom (algebraMap Ω (AlgebraicClosure Ω)))))) := by
      first
      | infer_instance
      | exact MorphismProperty.of_isPullback (P := @IsOpenImmersion)
          (IsPullback.of_hasPullback ι _) (inferInstance : IsOpenImmersion ι)
    haveI h2 : IsOpenImmersion ((Limits.pullbackRightPullbackFstIso fW
        (Spec.map (CommRingCat.ofHom (algebraMap Ω (AlgebraicClosure Ω)))) ι).inv ≫
        Limits.pullback.snd ι (Limits.pullback.fst fW
          (Spec.map (CommRingCat.ofHom (algebraMap Ω (AlgebraicClosure Ω)))))) := inferInstance
    haveI := wc_et_zero_dim_open_vanishing (AlgebraicClosure Ω) _ (Limits.pullback.snd fW
        (Spec.map (CommRingCat.ofHom (algebraMap Ω (AlgebraicClosure Ω))))) hdimK _
      ((Limits.pullbackRightPullbackFstIso fW
        (Spec.map (CommRingCat.ofHom (algebraMap Ω (AlgebraicClosure Ω)))) ι).inv ≫
        Limits.pullback.snd ι (Limits.pullback.fst fW
          (Spec.map (CommRingCat.ofHom (algebraMap Ω (AlgebraicClosure Ω)))))) m hm q hq
    obtain ⟨E⟩ := wc_et_coh_purely_inseparable_invariance Ω (AlgebraicClosure Ω) hint V
      (ι ≫ fW) m q
    exact E.symm.injective.subsingleton

  have s4 : ∀ (Ω : Type u) [Field Ω] [IsSepClosed Ω] (ℓ : ℕ), ℓ.Prime → (ℓ : Ω) ≠ 0 →
      ∀ (W : Scheme.{u}) (fW : W ⟶ Spec (.of Ω)) [IsProper fW],
      topologicalKrullDim W ≤ ((1 : ℕ) : WithBot ℕ∞) → ∀ (V : Scheme.{u}) (ι : V ⟶ W)
      [IsOpenImmersion ι] [IsAffine V], ∀ q : ℕ, 2 ≤ q → Subsingleton (wcEtCoh V ℓ q) := by
    intro Ω _ _ ℓ hℓ hℓΩ W fW _ hW V ι _ _ q hq
    have hint := hintG Ω
    have hℓK : (ℓ : AlgebraicClosure Ω) ≠ 0 := by
      rw [← map_natCast (algebraMap Ω (AlgebraicClosure Ω))]
      exact (map_ne_zero _).mpr hℓΩ
    have HZ : ∀ (W : Scheme.{u}) (fW : W ⟶ Spec (.of (AlgebraicClosure Ω))) [IsProper fW],
        topologicalKrullDim W ≤ ((0 : ℕ) : WithBot ℕ∞) → ∀ (V : Scheme.{u}) (ι : V ⟶ W)
        [IsOpenImmersion ι], ∀ q : ℕ, 1 ≤ q → Subsingleton (wcEtCoh V ℓ q) := by
      intro W' fW' _ hW' V' ι' _ q' hq'
      exact wc_et_zero_dim_open_vanishing (AlgebraicClosure Ω) W' fW' hW' V' ι' ℓ hℓ.ne_zero q' hq'
    have HN : ∀ (X : Scheme.{u}) (fX : X ⟶ Spec (.of (AlgebraicClosure Ω))) [IsProper fX],
        IrreducibleSpace X →
        (∀ x : X, IsDomain (X.presheaf.stalk x) ∧ IsIntegrallyClosed (X.presheaf.stalk x)) →
        topologicalKrullDim X = ((1 : ℕ) : WithBot ℕ∞) → ∀ (V : Scheme.{u}) (ι : V ⟶ X)
        [IsOpenImmersion ι] [IsAffine V], ∀ q : ℕ, 2 ≤ q → Subsingleton (wcEtCoh V ℓ q) := by
      intro X fX' _ hirr hnorm hdimX V' ι' _ _ q' hq'
      exact wc_et_normal_affine_curve_const_vanishing (AlgebraicClosure Ω) X fX' hirr hnorm hdimX
        V' ι' ℓ hℓ hℓK q' hq'
    have HC := wc_et_affine_open_curve_reduction (AlgebraicClosure Ω) ℓ hℓ hℓK HN HZ
    haveI hP : IsProper (Limits.pullback.snd fW
        (Spec.map (CommRingCat.ofHom (algebraMap Ω (AlgebraicClosure Ω))))) :=
      MorphismProperty.of_isPullback (P := @IsProper) (IsPullback.of_hasPullback fW _)
        (inferInstance : IsProper fW)
    have hdimK : topologicalKrullDim ↥(Limits.pullback fW
        (Spec.map (CommRingCat.ofHom (algebraMap Ω (AlgebraicClosure Ω))))) ≤
        ((1 : ℕ) : WithBot ℕ∞) := by
      rw [(s1 Ω (AlgebraicClosure Ω) hint W fW).topologicalKrullDim_eq]
      exact hW
    haveI h1 : IsOpenImmersion (Limits.pullback.snd ι (Limits.pullback.fst fW
        (Spec.map (CommRingCat.ofHom (algebraMap Ω (AlgebraicClosure Ω)))))) := by
      first
      | infer_instance
      | exact MorphismProperty.of_isPullback (P := @IsOpenImmersion)
          (IsPullback.of_hasPullback ι _) (inferInstance : IsOpenImmersion ι)
    haveI h2 : IsOpenImmersion ((Limits.pullbackRightPullbackFstIso fW
        (Spec.map (CommRingCat.ofHom (algebraMap Ω (AlgebraicClosure Ω)))) ι).inv ≫
        Limits.pullback.snd ι (Limits.pullback.fst fW
          (Spec.map (CommRingCat.ofHom (algebraMap Ω (AlgebraicClosure Ω)))))) := inferInstance
    haveI hfA : IsAffineHom (Limits.pullback.fst (ι ≫ fW)
        (Spec.map (CommRingCat.ofHom (algebraMap Ω (AlgebraicClosure Ω))))) :=
      MorphismProperty.of_isPullback (P := @IsAffineHom)
        (IsPullback.of_hasPullback (ι ≫ fW) _).flip
        (inferInstance : IsAffineHom
          (Spec.map (CommRingCat.ofHom (algebraMap Ω (AlgebraicClosure Ω)))))
    haveI hA : IsAffine (Limits.pullback (ι ≫ fW)
        (Spec.map (CommRingCat.ofHom (algebraMap Ω (AlgebraicClosure Ω))))) := by
      first
      | exact isAffine_of_isAffineHom (Limits.pullback.fst (ι ≫ fW)
          (Spec.map (CommRingCat.ofHom (algebraMap Ω (AlgebraicClosure Ω)))))
      | exact isAffine_of_isAffineHom
      | infer_instance
    haveI := HC _ (Limits.pullback.snd fW
        (Spec.map (CommRingCat.ofHom (algebraMap Ω (AlgebraicClosure Ω))))) hdimK _
      ((Limits.pullbackRightPullbackFstIso fW
        (Spec.map (CommRingCat.ofHom (algebraMap Ω (AlgebraicClosure Ω)))) ι).inv ≫
        Limits.pullback.snd ι (Limits.pullback.fst fW
          (Spec.map (CommRingCat.ofHom (algebraMap Ω (AlgebraicClosure Ω)))))) q hq
    obtain ⟨E⟩ := wc_et_coh_purely_inseparable_invariance Ω (AlgebraicClosure Ω) hint V
      (ι ≫ fW) ℓ q
    exact E.symm.injective.subsingleton

  have s6 : ∀ (K : Type u) [Field K] [IsSepClosed K] (ℓ : ℕ), ℓ.Prime → (ℓ : K) ≠ 0 →
      ∀ (H : Sheaf (Scheme.smallEtaleTopology (Spec (.of (Polynomial K)))) AddCommGrpCat.{u+1}),
      ℓ • 𝟙 H = 0 → ∀ q : ℕ, 2 ≤ q → Subsingleton (wcEtExt (Spec (.of (Polynomial K))) H q) := by
    intro K _ _ ℓ hℓ hℓK H hH q hq
    obtain ⟨Xb, fX, j, hP, hS, hj⟩ := wc_affine_line_open_in_smooth_proper_curve K
    haveI := hP
    haveI := hS
    haveI := hj
    have hdim : topologicalKrullDim Xb ≤ ((1 : ℕ) : WithBot ℕ∞) := s2 K Xb fX 1
