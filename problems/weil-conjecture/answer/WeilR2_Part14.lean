      show ∑ p ∈ P, x' p ⊗ₜ[S] (⟨y p * (m (u ⊗ₜ[S] v) : C), hyz p _ (m (u ⊗ₜ[S] v)).2⟩ :
        wcKummerEigDom (σC 1) d) = u ⊗ₜ[S] v
      conv_rhs => rw [← hsum]
      rw [TensorProduct.sum_tmul]
      refine Finset.sum_congr rfl (fun p _ => ?_)
      rw [TensorProduct.smul_tmul]
      congr 1
      apply Subtype.ext
      show y p * (m (u ⊗ₜ[S] v) : C) = ((r p • v : wcKummerEigDom (σC 1) d) : C)
      rw [hm, Submodule.coe_smul, Algebra.smul_def, hr]
