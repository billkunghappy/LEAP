theorem wc_affine_line_shdata_integral_base_change : ∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (x : Spec (.of (Polynomial A))), IsClosed ({x} : Set (Spec (.of (Polynomial A)))) → Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A))) x = IsLocalRing.closedPoint A → ∀ (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (Polynomial A))) x)) (Scheme.Etale.forget (Spec (.of (Polynomial A))))) (φ : ∀ l, Spec (.of B) ⟶ (W'.obj l).right.left) (a : Spec (.of B) ⟶ Spec (.of (Polynomial A))), wcHalShData x B Λ W' φ a → ∀ (A' : Type u) [CommRing A'] [HenselianLocalRing A'] [IsSepClosed (IsLocalRing.ResidueField A')] (f : A →+* A'), f.IsIntegral → ∃ (x' : Spec (.of (Polynomial A'))), IsClosed ({x'} : Set (Spec (.of (Polynomial A')))) ∧ Spec.map (CommRingCat.ofHom (algebraMap A' (Polynomial A'))) x' = IsLocalRing.closedPoint A' ∧ ∃ (B' : Type u) (_ : CommRing B') (_ : HenselianLocalRing B') (_ : IsSepClosed (IsLocalRing.ResidueField B')) (Λ' : Type u) (_ : SmallCategory Λ') (_ : IsCofiltered Λ') (W'' : Λ' ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (Polynomial A'))) x')) (Scheme.Etale.forget (Spec (.of (Polynomial A'))))) (φ' : ∀ l, Spec (.of B') ⟶ (W''.obj l).right.left) (a' : Spec (.of B') ⟶ Spec (.of (Polynomial A'))) (β : Spec (.of B') ⟶ Spec (.of B)), wcHalShData x' B' Λ' W'' φ' a' ∧ IsPullback β (a' ≫ Spec.map (CommRingCat.ofHom (algebraMap A' (Polynomial A')))) (a ≫ Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) (Spec.map (CommRingCat.ofHom f)) :=
by
  intro A _ _ _ x hx hxc B _ _ _ Λ _ _ W' φ a hd A' _ _ _ f hf
  obtain ⟨-, -, -, -, -, e, -, he⟩ := id hd
  have hpb : IsPullback (Spec.map (CommRingCat.ofHom (Polynomial.mapRingHom f)))
      (Spec.map (CommRingCat.ofHom (algebraMap A' (Polynomial A'))))
      (Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A))))
      (Spec.map (CommRingCat.ofHom f)) := by
    letI : Algebra A A' := f.toAlgebra
    letI : Algebra (Polynomial A) (Polynomial A') := Polynomial.algebra A A'
    have Q := isPullback_SpecMap_of_isPushout _ _ _ _
      (CommRingCat.isPushout_of_isPushout A A' (Polynomial A) (Polynomial A'))
