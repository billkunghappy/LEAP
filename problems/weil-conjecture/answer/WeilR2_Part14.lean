    θ.hom (𝟙 _) (𝟙 _) h₁ h₂) ℓ p
  have hP := @Equiv.subsingleton _ _ e2 hM

  obtain ⟨e1⟩ := wc_et_coh_iso_invariance (Limits.pullbackRightPullbackFstIso
    (Spec.map (CommRingCat.ofHom (β.comp (algebraMap A (MvPolynomial (Option (Fin d)) A))))) ξ
    (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {β (MvPolynomial.X none)}))))).hom ℓ p
  exact @Equiv.subsingleton _ _ e1.symm hP

theorem wc_cpt_geom_tube_high : ∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] [IsDomain A] [IsDiscreteValuationRing A] (ℓ : ℕ), ℓ.Prime → IsUnit ((ℓ : ℕ) : A) → ∀ (d : ℕ) (y : Spec (.of (MvPolynomial (Option (Fin d)) A))), Spec.map (CommRingCat.ofHom (algebraMap A (MvPolynomial (Option (Fin d)) A))) y = IsLocalRing.closedPoint A → (MvPolynomial.X none : MvPolynomial (Option (Fin d)) A) ∈ y.asIdeal → ∀ (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (MvPolynomial (Option (Fin d)) A))) y)) (Scheme.Etale.forget (Spec (.of (MvPolynomial (Option (Fin d)) A))))) (φ : ∀ l, Spec (.of B) ⟶ (W'.obj l).right.left) (a : Spec (.of B) ⟶ Spec (.of (MvPolynomial (Option (Fin d)) A))), wcHalShData y B Λ W' φ a → ∀ (β : MvPolynomial (Option (Fin d)) A →+* B), Spec.map (CommRingCat.ofHom β) = a → ∀ (K : Type u) [Field K] [IsSepClosed K] (ζ : Spec (.of K) ⟶ Spec (.of A)), ∀ q : ℕ, 2 ≤ q → Subsingleton (wcEtCoh (Limits.pullback (Spec.map (CommRingCat.ofHom ((algebraMap B (Localization.Away (β (MvPolynomial.X none)))).comp (β.comp (algebraMap A (MvPolynomial (Option (Fin d)) A)))))) ζ) ℓ q) :=
by
  intro A _ _ _ _ _ ℓ hℓ hunit d y hy hy0 B _ _ _ Λ _ _ W' φ a ha β hβ K _ _ ζ q hq
  classical

  have leray : ∀ {T Y : Scheme.{u}} (j : T ⟶ Y) [IsAffineHom j],
      (∀ (y' : ↥Y) (B' : Type u) [CommRing B'] [HenselianLocalRing B']
        [IsSepClosed (IsLocalRing.ResidueField B')] (Λ' : Type u) [SmallCategory Λ']
        [IsCofiltered Λ'] (W'' : Λ' ⥤ StructuredArrow (Over.mk (wcEtGeomPt Y y'))
          (Scheme.Etale.forget Y)) (φ' : ∀ l, Spec (.of B') ⟶ (W''.obj l).right.left)
        (a' : Spec (.of B') ⟶ Y), wcHalShData y' B' Λ' W'' φ' a' →
        ∀ s : ℕ, 2 ≤ s → Subsingleton (wcEtCoh (Limits.pullback j a') ℓ s)) →
      (∀ (I : InjectiveResolution ((constantSheaf (Scheme.smallEtaleTopology T)
          AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))))) (p : ℕ), 1 ≤ p →
        Subsingleton (wcEtExt Y ((((wcEtPush j).mapHomologicalComplex (ComplexShape.up ℕ)).obj
          I.cocomplex).homology 1) p)) →
      (∀ (I : InjectiveResolution ((constantSheaf (Scheme.smallEtaleTopology T)
          AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))))) (p : ℕ), 1 ≤ p →
        Subsingleton (wcEtExt Y ((((wcEtPush j).mapHomologicalComplex (ComplexShape.up ℕ)).obj
          I.cocomplex).homology 0) p)) →
      ∀ k : ℕ, 2 ≤ k → Subsingleton (wcEtCoh T ℓ k) := by
    intro T Y j _ h3 h4 h5 k hk
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1}) := HasExt.standard _
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
    haveI : EnoughInjectives (Sheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1}) :=
      wc_et_enough_injectives _
    haveI : EnoughInjectives (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) :=
      wc_et_enough_injectives _
    obtain ⟨Lg, ⟨adjg⟩, hLg, ⟨eg⟩⟩ := wc_et_push_left_adjoint j
    haveI := hLg
    haveI : Lg.IsLeftAdjoint := adjg.isLeftAdjoint
    haveI : Lg.PreservesZeroMorphisms := Functor.preservesZeroMorphisms_of_isLeftAdjoint _
    haveI : Lg.Additive := Functor.additive_of_preserves_binary_products _
    haveI : (wcEtPush j).Additive := Adjunction.right_adjoint_additive adjg
    let I := injectiveResolution ((constantSheaf (Scheme.smallEtaleTopology T)
      AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))))
    have hR2 : ∀ s : ℕ, 2 ≤ s → Limits.IsZero
        ((((wcEtPush j).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology s) := by
      intro s hs
      apply wc_et_stalks_zero
      intro x
      obtain ⟨B', _, _, _, Λ', _, _, W'', φ', a', e, hInit, hAff, hcomp, ha', hlim, he, heq⟩ :=
        wc_et_geom_strict_henselization x
      have hsh : wcHalShData x B' Λ' W'' φ' a' := ⟨hInit, hAff, hcomp, ha', hlim, e, he, heq⟩
      obtain ⟨e1⟩ := wc_et_stalk_push_homology j x Λ' W'' hInit I.cocomplex s
      obtain ⟨e2⟩ := wc_et_limit_push_homology_affine j B' Λ'
        (W'' ⋙ StructuredArrow.proj _ _) φ' a' hAff hcomp ha' hlim ℓ I s
      have hfib := h3 x B' Λ' W'' φ' a' hsh s hs
      exact @Function.Injective.subsingleton _ _ _ (e1.trans e2).injective hfib
    have hLer := wc_leray_ext_vanishing Lg (wcEtPush j) adjg
      ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ))) _ I 1 (by
        intro p s hps x
        by_cases hs2 : 2 ≤ s
        · have hz := hR2 s hs2
          calc x = x.comp (Abelian.Ext.mk₀ (𝟙 _)) (add_zero p) := (Abelian.Ext.comp_mk₀_id x).symm
            _ = x.comp (Abelian.Ext.mk₀ 0) (add_zero p) := by rw [hz.eq_of_tgt (𝟙 _) 0]
            _ = 0 := by rw [Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
        · by_cases hs0 : s = 0
          · subst hs0
            have hs := h5 I p (by omega)
            exact @Subsingleton.elim _ hs x (0 : type_of% x)
          · obtain rfl : s = 1 := by omega
            have hs := h4 I p (by omega)
            exact @Subsingleton.elim _ hs x (0 : type_of% x))
    have hw : ∀ w : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology T)
        AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)))
        ((constantSheaf (Scheme.smallEtaleTopology T)
          AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))) k, w = 0 := by
      intro w
      have hq0 : (Abelian.Ext.mk₀ eg.hom).comp w (zero_add k) = 0 := hLer k (by omega) _
      calc w = (Abelian.Ext.mk₀ (𝟙 _)).comp w (zero_add k) := (Abelian.Ext.mk₀_id_comp w).symm
        _ = ((Abelian.Ext.mk₀ eg.inv).comp (Abelian.Ext.mk₀ eg.hom) (add_zero 0)).comp w
              (zero_add k) := by rw [Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id]
        _ = (Abelian.Ext.mk₀ eg.inv).comp ((Abelian.Ext.mk₀ eg.hom).comp w (zero_add k))
              (zero_add k) := Abelian.Ext.comp_assoc _ _ _ (add_zero 0) (zero_add k) (by omega)
        _ = 0 := by rw [hq0, Abelian.Ext.comp_zero]
    exact ⟨fun w₁ w₂ => (hw w₁).trans (hw w₂).symm⟩

  have main : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (ξ : Spec (.of Ω) ⟶ Spec (.of A)),
      ∀ k : ℕ, 2 ≤ k → Subsingleton (wcEtCoh (Limits.pullback (Spec.map (CommRingCat.ofHom (algebraMap B (Localization.Away (β (MvPolynomial.X none)))))) (Limits.pullback.fst (Spec.map (CommRingCat.ofHom (β.comp (algebraMap A (MvPolynomial (Option (Fin d)) A))))) ξ)) ℓ k) := by
    intro Ω _ _ ξ k hk
    haveI : IsAffineHom (Spec.map (CommRingCat.ofHom (algebraMap B (Localization.Away (β (MvPolynomial.X none)))))) := isAffineHom_of_isAffine _
    haveI : IsAffineHom (Limits.pullback.snd (Spec.map (CommRingCat.ofHom (algebraMap B (Localization.Away (β (MvPolynomial.X none)))))) (Limits.pullback.fst (Spec.map (CommRingCat.ofHom (β.comp (algebraMap A (MvPolynomial (Option (Fin d)) A))))) ξ)) := inferInstance
    exact leray (Limits.pullback.snd (Spec.map (CommRingCat.ofHom (algebraMap B (Localization.Away (β (MvPolynomial.X none)))))) (Limits.pullback.fst (Spec.map (CommRingCat.ofHom (β.comp (algebraMap A (MvPolynomial (Option (Fin d)) A))))) ξ))
      (wc_cgth_strict_tube_high_vanish A ℓ hℓ hunit d y hy hy0 B Λ W' φ a ha β hβ Ω ξ)
      (wc_cgth_R1_ext_vanish A ℓ hℓ hunit d y hy hy0 B Λ W' φ a ha β hβ Ω ξ ·
        (wc_cgth_divisor_milnor_acyclic A ℓ hℓ hunit d y hy hy0 B Λ W' φ a ha β hβ Ω ξ))
      (wc_cgth_R0_ext_vanish A ℓ hℓ hunit d y hy hy0 B Λ W' φ a ha β hβ Ω ξ) k hk

  have hint : (algebraMap K (AlgebraicClosure K)).IsIntegral := fun x =>
    Algebra.IsIntegral.isIntegral x
  have hcomp : (Spec.map (CommRingCat.ofHom (algebraMap B (Localization.Away (β (MvPolynomial.X none)))))) ≫ (Spec.map (CommRingCat.ofHom (β.comp (algebraMap A (MvPolynomial (Option (Fin d)) A))))) = Spec.map (CommRingCat.ofHom ((algebraMap B (Localization.Away (β (MvPolynomial.X none)))).comp (β.comp (algebraMap A (MvPolynomial (Option (Fin d)) A))))) := by
    rw [← Spec.map_comp]
    rfl
  obtain ⟨e1⟩ := wc_et_coh_purely_inseparable_invariance K (AlgebraicClosure K) hint _
    (Limits.pullback.snd (Spec.map (CommRingCat.ofHom ((algebraMap B (Localization.Away (β (MvPolynomial.X none)))).comp (β.comp (algebraMap A (MvPolynomial (Option (Fin d)) A)))))) ζ) ℓ q
  obtain ⟨e2⟩ := wc_et_coh_iso_invariance (Limits.pullbackLeftPullbackSndIso
    (Spec.map (CommRingCat.ofHom ((algebraMap B (Localization.Away (β (MvPolynomial.X none)))).comp (β.comp (algebraMap A (MvPolynomial (Option (Fin d)) A)))))) ζ
    (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))).hom ℓ q
  obtain ⟨e3⟩ := wc_et_coh_iso_invariance (Limits.pullbackRightPullbackFstIso (Spec.map (CommRingCat.ofHom (β.comp (algebraMap A (MvPolynomial (Option (Fin d)) A)))))
    (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))) ≫ ζ) (Spec.map (CommRingCat.ofHom (algebraMap B (Localization.Away (β (MvPolynomial.X none))))))).hom ℓ q
  have h := main (AlgebraicClosure K)
    (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))) ≫ ζ) q hq
  obtain ⟨e4⟩ := wc_et_coh_iso_invariance (Limits.pullback.congrHom hcomp
    (rfl : Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))) ≫ ζ =
      Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))) ≫ ζ)).hom ℓ q
  have h' := @Equiv.subsingleton _ _ e3 h
  have h'2 := @Equiv.subsingleton _ _ e4 h'
  have h'' := @Equiv.subsingleton _ _ e2.symm h'2
  exact @Equiv.subsingleton _ _ e1.symm h''

theorem wc_cpt_kummer_ring_torsor : ∀ (C : Type u) [CommRing C] (ℓ : ℕ), ℓ.Prime → IsUnit ((ℓ : ℕ) : C) → ∀ (ω : C), ω ^ ℓ = 1 → (∀ i : ℕ, 0 < i → i < ℓ → IsUnit (1 - ω ^ i)) → ∀ (s : C), IsUnit s → ∃ a : ZMod ℓ → (Spec (.of (AdjoinRoot (Polynomial.X ^ ℓ - Polynomial.C s))) ⟶ Spec (.of (AdjoinRoot (Polynomial.X ^ ℓ - Polynomial.C s)))), wcFetTorsor (Spec.map (CommRingCat.ofHom (algebraMap C (AdjoinRoot (Polynomial.X ^ ℓ - Polynomial.C s))))) ℓ a :=
by
  intro C _ ℓ hℓ hunit ω hω hunits s hs
  classical


  have hfet : ∀ (R B : Type u) [CommRing R] [CommRing B] [Algebra R B] (m : ℕ)
      [NeZero m] (σ : ZMod m → (B →ₐ[R] B)), Algebra.Etale R B → Module.Finite R B →
      Function.Surjective (PrimeSpectrum.comap (algebraMap R B)) → σ 0 = AlgHom.id R B →
      (∀ c c', σ (c + c') = (σ c).comp (σ c')) → Function.Bijective (wcTorDescMu R B m σ) →
      wcFetTorsor (Spec.map (CommRingCat.ofHom (algebraMap R B))) m
        (fun c => Spec.map (CommRingCat.ofHom (σ c).toRingHom)) := by
    intro R B _ _ _ m _ σ het hfin hsurj h0 hadd hmu
    have hact : ∀ c, Spec.map (CommRingCat.ofHom (σ c).toRingHom) ≫
        Spec.map (CommRingCat.ofHom (algebraMap R B)) =
        Spec.map (CommRingCat.ofHom (algebraMap R B)) := by
      intro c
      rw [← Spec.map_comp]
      congr 1
      ext x
      exact (σ c).commutes x
    let e : TensorProduct R B B ≃+* (ZMod m → B) := RingEquiv.ofBijective (wcTorDescMu R B m σ) hmu
    haveI hMiso : IsIso (CommRingCat.ofHom (wcTorDescMu R B m σ).toRingHom) :=
      ⟨⟨CommRingCat.ofHom e.symm.toRingHom,
        by apply CommRingCat.hom_ext; apply RingHom.ext; intro x; exact e.symm_apply_apply x,
        by apply CommRingCat.hom_ext; apply RingHom.ext; intro y; exact e.apply_symm_apply y⟩⟩
    let ρ : (ZMod m → B) ≃+* (ULift.{u} (ZMod m) → B) :=
      { toFun := fun f i => f i.down
        invFun := fun g c => g ⟨c⟩
        left_inv := fun _ => rfl
        right_inv := fun _ => rfl
        map_mul' := fun _ _ => rfl
        map_add' := fun _ _ => rfl }
    haveI hρiso : IsIso (CommRingCat.ofHom ρ.toRingHom) :=
      ⟨⟨CommRingCat.ofHom ρ.symm.toRingHom,
        by apply CommRingCat.hom_ext; apply RingHom.ext; intro x; exact ρ.symm_apply_apply x,
        by apply CommRingCat.hom_ext; apply RingHom.ext; intro y; exact ρ.apply_symm_apply y⟩⟩
    have hjfac : ∀ c : ZMod m,
        Spec.map (CommRingCat.ofHom (Pi.evalRingHom (fun _ : ZMod m => B) c)) =
        Limits.Sigma.ι (fun _ : ULift.{u} (ZMod m) => Spec (CommRingCat.of B)) (ULift.up c) ≫
          sigmaSpec (fun _ : ULift.{u} (ZMod m) => CommRingCat.of B) ≫
          Spec.map (CommRingCat.ofHom ρ.toRingHom) := by
      intro c
      rw [← Category.assoc, ι_sigmaSpec, ← Spec.map_comp]
      rfl
    have hgraph0 : ∀ c (h : Spec.map (CommRingCat.ofHom (σ c).toRingHom) ≫
        Spec.map (CommRingCat.ofHom (algebraMap R B)) =
        𝟙 (Spec (CommRingCat.of B)) ≫ Spec.map (CommRingCat.ofHom (algebraMap R B))),
        Limits.pullback.lift (Spec.map (CommRingCat.ofHom (σ c).toRingHom))
          (𝟙 (Spec (CommRingCat.of B))) h =
        Spec.map (CommRingCat.ofHom (Pi.evalRingHom (fun _ : ZMod m => B) c)) ≫
          (Spec.map (CommRingCat.ofHom (wcTorDescMu R B m σ).toRingHom) ≫
            (pullbackSpecIso R B B).inv) := by
      intro c h
      apply Limits.pullback.hom_ext
      · rw [Limits.pullback.lift_fst, Category.assoc, Category.assoc, pullbackSpecIso_inv_fst,
          ← Spec.map_comp, ← Spec.map_comp]
        congr 1
        ext x
        simp [wcTorDescMu]
      · rw [Limits.pullback.lift_snd, Category.assoc, Category.assoc, pullbackSpecIso_inv_snd,
          ← Spec.map_comp, ← Spec.map_comp, ← Spec.map_id (CommRingCat.of B)]
        congr 1
        ext x
        simp [wcTorDescMu]
    obtain ⟨j, hjdef⟩ : ∃ j : ZMod m → (Spec (CommRingCat.of B) ⟶
        Spec (CommRingCat.of (ZMod m → B))),
        ∀ c, j c = Spec.map (CommRingCat.ofHom (Pi.evalRingHom (fun _ : ZMod m => B) c)) :=
      ⟨_, fun _ => rfl⟩
    obtain ⟨Φ, hΦdef⟩ : ∃ Φ : Spec (CommRingCat.of (ZMod m → B)) ⟶
        Limits.pullback (Spec.map (CommRingCat.ofHom (algebraMap R B)))
          (Spec.map (CommRingCat.ofHom (algebraMap R B))),
        Φ = Spec.map (CommRingCat.ofHom (wcTorDescMu R B m σ).toRingHom) ≫
          (pullbackSpecIso R B B).inv := ⟨_, rfl⟩
    have hgraph : ∀ c (h : Spec.map (CommRingCat.ofHom (σ c).toRingHom) ≫
        Spec.map (CommRingCat.ofHom (algebraMap R B)) =
        𝟙 (Spec (CommRingCat.of B)) ≫ Spec.map (CommRingCat.ofHom (algebraMap R B))),
        Limits.pullback.lift (Spec.map (CommRingCat.ofHom (σ c).toRingHom))
          (𝟙 (Spec (CommRingCat.of B))) h = j c ≫ Φ := by
      intro c h
      rw [hjdef, hΦdef]
      exact hgraph0 c h
    haveI hΦiso : IsIso Φ := by rw [hΦdef]; infer_instance
    have hjopen : ∀ c, IsOpenImmersion (j c) := by
      intro c
      rw [hjdef, hjfac c]
      infer_instance
    have hjpt : ∀ c x, j c x = PrimeSpectrum.sigmaToPi (fun _ : ZMod m => B) ⟨c, x⟩ := by
      intro c x
      rw [hjdef]
      rfl
    have hΦinj : Function.Injective Φ := by
      intro a b hab
      apply (Scheme.Hom.homeomorph Φ).injective
      rw [Scheme.Hom.homeomorph_apply, Scheme.Hom.homeomorph_apply]
      exact hab
    have hΦsurj : Function.Surjective Φ := by
      intro z
      obtain ⟨w, hw⟩ := (Scheme.Hom.homeomorph Φ).surjective z
      exact ⟨w, by rw [← Scheme.Hom.homeomorph_apply]; exact hw⟩
    have hbij := PrimeSpectrum.sigmaToPi_bijective (fun _ : ZMod m => B)
    refine ⟨?_, ?_, ?_, hact, ?_, ?_, ?_, ?_, ?_⟩
    · rw [IsFinite.SpecMap_iff]
      exact RingHom.finite_algebraMap.mpr hfin
    · rw [HasRingHomProperty.Spec_iff (P := @Etale)]
      exact RingHom.etale_algebraMap.mpr het
    · exact Set.range_eq_univ.mpr fun x => hsurj x
    · show Spec.map (CommRingCat.ofHom (σ 0).toRingHom) = 𝟙 _
      rw [h0]
      exact Spec.map_id _
    · intro c c'
      show Spec.map (CommRingCat.ofHom (σ (c + c')).toRingHom) =
        Spec.map (CommRingCat.ofHom (σ c').toRingHom) ≫ Spec.map (CommRingCat.ofHom (σ c).toRingHom)
      rw [← Spec.map_comp, add_comm, hadd]
      rfl
    · intro c
      rw [hgraph]
      haveI := hjopen c
      infer_instance
    · intro c c' hcc'
      show Disjoint _ _
      rw [hgraph, hgraph, Set.disjoint_left]
      rintro _ ⟨x, rfl⟩ ⟨y, hy⟩
      rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at hy
      have h1 := hΦinj hy
      rw [hjpt, hjpt] at h1
      have h2 := congrArg Sigma.fst (hbij.1 h1)
      exact hcc' h2.symm
    · rw [Set.eq_univ_iff_forall]
      intro z
      obtain ⟨w, rfl⟩ := hΦsurj z
      obtain ⟨⟨c, x⟩, hx⟩ := hbij.2 w
      refine Set.mem_iUnion.mpr ⟨c, x, ?_⟩
      rw [hgraph]
      show Φ (j c x) = Φ w
      exact congrArg Φ ((hjpt c x).trans hx)
  generalize hf : Polynomial.X ^ ℓ - Polynomial.C s = f
  have hℓ0 : ℓ ≠ 0 := hℓ.ne_zero
  haveI : NeZero ℓ := ⟨hℓ0⟩
  have hfm : f.Monic := by rw [← hf]; exact Polynomial.monic_X_pow_sub_C s hℓ0

  have het : Algebra.Etale C (AdjoinRoot f) := by
    obtain ⟨u, hu⟩ := (hunit.mul hs).exists_left_inv
    have hcert : ∃ (p₁ p₂ : Polynomial C) (n : ℕ),
        Polynomial.derivative f * p₁ + f * p₂ = (1 : Polynomial C) ^ n := by
      refine ⟨Polynomial.C u * Polynomial.X, -(Polynomial.C u * Polynomial.C (ℓ : C)), 1, ?_⟩
      have hd : Polynomial.derivative f = Polynomial.C (ℓ : C) * Polynomial.X ^ (ℓ - 1) := by
        rw [← hf, Polynomial.derivative_sub, Polynomial.derivative_X_pow, Polynomial.derivative_C,
          sub_zero]
      have hX : Polynomial.X ^ (ℓ - 1) * Polynomial.X = (Polynomial.X : Polynomial C) ^ ℓ :=
        pow_sub_one_mul hℓ0 Polynomial.X
      have hu' : Polynomial.C u * (Polynomial.C (ℓ : C) * Polynomial.C s) = 1 := by
        rw [← map_mul, ← map_mul, hu, map_one]
      rw [hd, ← hf, pow_one]
      linear_combination hu' + (Polynomial.C u * Polynomial.C (ℓ : C)) * hX
    let P : StandardEtalePair C := ⟨f, hfm, 1, hcert⟩
    have e₂ : AdjoinRoot f ≃ₐ[C] Localization.Away ((AdjoinRoot.mk f) 1) :=
      (IsLocalization.atUnit (AdjoinRoot f) (Localization.Away ((AdjoinRoot.mk f) 1))
        ((AdjoinRoot.mk f) 1) (by simp)).restrictScalars C
    have e : P.Ring ≃ₐ[C] AdjoinRoot f := P.equivAwayAdjoinRoot.trans e₂.symm
    exact Algebra.Etale.of_equiv e
  have hfin : Module.Finite C (AdjoinRoot f) := (AdjoinRoot.powerBasis' hfm).finite
  have hsurj : Function.Surjective (PrimeSpectrum.comap (algebraMap C (AdjoinRoot f))) := by
    rcases subsingleton_or_nontrivial C with hC | hC
    · have : IsEmpty (PrimeSpectrum C) := PrimeSpectrum.isEmpty_iff_subsingleton.mpr hC
      intro x
      exact isEmptyElim x
    · have : Module.Free C (AdjoinRoot f) := hfm.free_adjoinRoot
      have hdim : 0 < (AdjoinRoot.powerBasis' hfm).dim := by
        rw [AdjoinRoot.powerBasis'_dim, ← hf, Polynomial.natDegree_X_pow_sub_C]
        exact Nat.pos_of_ne_zero hℓ0
      have : Nontrivial (AdjoinRoot f) :=
        nontrivial_of_ne _ _ ((AdjoinRoot.powerBasis' hfm).basis.ne_zero ⟨0, hdim⟩)
      exact PrimeSpectrum.comap_surjective_of_faithfullyFlat

  obtain ⟨a, ha_def⟩ : ∃ a : AdjoinRoot f, a = algebraMap C (AdjoinRoot f) ω := ⟨_, rfl⟩
  have ha : a ^ ℓ = 1 := by rw [ha_def, ← map_pow, hω, map_one]
  have haunits : ∀ i : ℕ, 0 < i → i < ℓ → IsUnit (1 - a ^ i) := by
    intro i h0 h1
    have := (hunits i h0 h1).map (algebraMap C (AdjoinRoot f))
    rw [map_sub, map_one, map_pow, ← ha_def] at this
    exact this
  have hR0 : (AdjoinRoot.root f) ^ ℓ = algebraMap C (AdjoinRoot f) s := by
    have h1 : Polynomial.aeval (AdjoinRoot.root f) f = 0 := by
      rw [AdjoinRoot.aeval_eq, AdjoinRoot.mk_self]
    have h2 : Polynomial.aeval (AdjoinRoot.root f) (Polynomial.X ^ ℓ - Polynomial.C s) = 0 := by
      rw [hf]; exact h1
    rw [map_sub, Polynomial.aeval_X_pow, Polynomial.aeval_C] at h2
    exact sub_eq_zero.mp h2
  have hev : ∀ x : AdjoinRoot f, x ^ ℓ = algebraMap C (AdjoinRoot f) s →
      Polynomial.eval₂ (algebraMap C (AdjoinRoot f)) x f = 0 := by
    intro x hx
    have key : Polynomial.eval₂ (algebraMap C (AdjoinRoot f)) x
        (Polynomial.X ^ ℓ - Polynomial.C s) = 0 := by
      rw [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C, hx, sub_self]
    rwa [hf] at key
  have hxc : ∀ c : ZMod ℓ, (a ^ c.val * AdjoinRoot.root f) ^ ℓ = algebraMap C (AdjoinRoot f) s := by
    intro c
    rw [mul_pow, ← pow_mul, mul_comm c.val ℓ, pow_mul, ha, one_pow, one_mul, hR0]

  let σ : ZMod ℓ → (AdjoinRoot f →ₐ[C] AdjoinRoot f) := fun c =>
    AdjoinRoot.liftAlgHom f (Algebra.ofId C (AdjoinRoot f)) (a ^ c.val * AdjoinRoot.root f)
      (hev _ (hxc c))
  have hσw : ∀ c, σ c (AdjoinRoot.root f) = a ^ c.val * AdjoinRoot.root f := by
    intro c
    exact AdjoinRoot.liftAlgHom_root f _ _ _
  have hσa : ∀ c, σ c a = a := by
    intro c
    rw [ha_def]
    exact (σ c).commutes ω
  have hσ0 : σ 0 = AlgHom.id C _ := by
    apply AdjoinRoot.algHom_ext
    rw [hσw, ZMod.val_zero, pow_zero, one_mul, AlgHom.id_apply]
  have hσadd : ∀ c c', σ (c + c') = (σ c).comp (σ c') := by
    intro c c'
    apply AdjoinRoot.algHom_ext
    rw [AlgHom.comp_apply, hσw, hσw, map_mul, map_pow, hσa, hσw, ZMod.val_add,
      ← pow_eq_pow_mod _ ha]
    ring

  obtain ⟨L, hL⟩ : ∃ L : AdjoinRoot f, L * ((ℓ : ℕ) : AdjoinRoot f) = 1 := by
    have := hunit.map (algebraMap C (AdjoinRoot f))
    rw [map_natCast] at this
    exact this.exists_left_inv
  obtain ⟨w', hw'⟩ : ∃ w' : AdjoinRoot f, AdjoinRoot.root f * w' = 1 := by
    have h1 : IsUnit ((AdjoinRoot.root f) ^ ℓ) := by rw [hR0]; exact hs.map _
    exact ((isUnit_pow_iff hℓ0).mp h1).exists_right_inv
  have hww : ∀ i : ℕ, (AdjoinRoot.root f) ^ i * w' ^ i = 1 := fun i => by
    rw [← mul_pow, hw', one_pow]

  have hG1 : ∀ K : ℕ, ∑ j ∈ Finset.range ℓ, (a ^ K) ^ j =
      if ℓ ∣ K then ((ℓ : ℕ) : AdjoinRoot f) else 0 := by
    intro K
    split_ifs with hK
    · obtain ⟨t, rfl⟩ := hK
      rw [pow_mul, ha, one_pow]
      simp
    · have hr0 : 0 < K % ℓ := Nat.pos_of_ne_zero (fun h => hK (Nat.dvd_of_mod_eq_zero h))
      have hr1 : K % ℓ < ℓ := Nat.mod_lt _ (Nat.pos_of_ne_zero hℓ0)
      have hu : IsUnit (a ^ K - 1) := by
        have := (haunits _ hr0 hr1).neg
        rw [neg_sub, ← pow_eq_pow_mod _ ha] at this
        exact this
      have h2 : (∑ j ∈ Finset.range ℓ, (a ^ K) ^ j) * (a ^ K - 1) = 0 := by
        rw [geom_sum_mul, ← pow_mul, mul_comm K ℓ, pow_mul, ha, one_pow, sub_self]
      exact (hu.mul_left_eq_zero).mp h2
  have hG2 : ∀ K : ℕ, ∑ c : ZMod ℓ, (a ^ K) ^ c.val =
      if ℓ ∣ K then ((ℓ : ℕ) : AdjoinRoot f) else 0 := by
    intro K
    rw [← hG1 K]
    apply Finset.sum_nbij' (fun c : ZMod ℓ => c.val) (fun j : ℕ => (j : ZMod ℓ))
    · intro c _; exact Finset.mem_range.mpr (ZMod.val_lt c)
    · intro j _; exact Finset.mem_univ _
    · intro c _; exact ZMod.natCast_zmod_val c
    · intro j hj; exact ZMod.val_natCast_of_lt (Finset.mem_range.mp hj)
    · intro c _; rfl

  obtain ⟨m, hm⟩ : ∃ m : ℕ, m + 1 = ℓ := ⟨ℓ - 1, Nat.sub_add_cancel (Nat.pos_of_ne_zero hℓ0)⟩
  have hm1 : ((m : ℕ) : ZMod ℓ) = -1 := by
    have h : ((m + 1 : ℕ) : ZMod ℓ) = 0 := by rw [hm]; exact ZMod.natCast_self ℓ
    push_cast at h
    linear_combination h
  have hdiv : ∀ x y : ℕ, ℓ ∣ x + m * y ↔ (x : ZMod ℓ) = (y : ZMod ℓ) := by
    intro x y
    rw [← ZMod.natCast_eq_zero_iff]
    push_cast
    rw [hm1]
    constructor <;> intro h <;> linear_combination h
  have hcast : ∀ x y : ℕ, x < ℓ → y < ℓ → ((x : ZMod ℓ) = (y : ZMod ℓ) ↔ x = y) := by
    intro x y hx hy
    constructor
    · intro h
      have := congrArg ZMod.val h
      rwa [ZMod.val_natCast_of_lt hx, ZMod.val_natCast_of_lt hy] at this
    · rintro rfl; rfl

  have hrepr : ∀ x : AdjoinRoot f, ∃ b : ℕ → C,
      x = ∑ k ∈ Finset.range ℓ, b k • (AdjoinRoot.root f) ^ k := by
    intro x
    have hd : (AdjoinRoot.powerBasis' hfm).dim ≤ ℓ := by
      rw [AdjoinRoot.powerBasis'_dim, ← hf]
      exact (Polynomial.natDegree_sub_le _ _).trans (max_le (Polynomial.natDegree_X_pow_le _)
        (by rw [Polynomial.natDegree_C]; exact Nat.zero_le _))
    refine ⟨fun k => if h : k < (AdjoinRoot.powerBasis' hfm).dim then
      (AdjoinRoot.powerBasis' hfm).basis.repr x ⟨k, h⟩ else 0, ?_⟩
    calc x = ∑ i : Fin (AdjoinRoot.powerBasis' hfm).dim,
          (AdjoinRoot.powerBasis' hfm).basis.repr x i • (AdjoinRoot.root f) ^ (i : ℕ) := by
          conv_lhs => rw [← (AdjoinRoot.powerBasis' hfm).basis.sum_repr x]
          refine Finset.sum_congr rfl (fun i _ => ?_)
          rw [PowerBasis.coe_basis, AdjoinRoot.powerBasis'_gen]
      _ = ∑ k ∈ Finset.range (AdjoinRoot.powerBasis' hfm).dim,
          (if h : k < (AdjoinRoot.powerBasis' hfm).dim then
            (AdjoinRoot.powerBasis' hfm).basis.repr x ⟨k, h⟩ else 0) • (AdjoinRoot.root f) ^ k := by
          rw [← Fin.sum_univ_eq_sum_range]
          refine Finset.sum_congr rfl (fun i _ => ?_)
          simp only [dif_pos i.isLt, Fin.eta]
      _ = _ := by
          apply Finset.sum_subset
          · intro k hk
            exact Finset.mem_range.mpr (lt_of_lt_of_le (Finset.mem_range.mp hk) hd)
          · intro k _ hk
            rw [dif_neg (fun h => hk (Finset.mem_range.mpr h)), zero_smul]
  have hspan : ∀ z : TensorProduct C (AdjoinRoot f) (AdjoinRoot f), ∃ y : ℕ → AdjoinRoot f,
      z = ∑ k ∈ Finset.range ℓ, ((AdjoinRoot.root f) ^ k) ⊗ₜ[C] y k := by
    intro z
    induction z using TensorProduct.induction_on with
    | zero => exact ⟨0, by simp⟩
    | tmul x y0 =>
      obtain ⟨b, hb⟩ := hrepr x
      refine ⟨fun k => b k • y0, ?_⟩
      rw [hb, TensorProduct.sum_tmul]
      exact Finset.sum_congr rfl (fun k _ => TensorProduct.smul_tmul _ _ _)
    | add z1 z2 h1 h2 =>
      obtain ⟨y1, rfl⟩ := h1
      obtain ⟨y2, rfl⟩ := h2
      refine ⟨y1 + y2, ?_⟩
      rw [← Finset.sum_add_distrib]
      exact Finset.sum_congr rfl (fun k _ => (TensorProduct.tmul_add _ _ _).symm)

  have hμ : ∀ (y : ℕ → AdjoinRoot f) (c : ZMod ℓ),
      wcTorDescMu C (AdjoinRoot f) ℓ σ (∑ k ∈ Finset.range ℓ, ((AdjoinRoot.root f) ^ k) ⊗ₜ[C] y k) c =
        ∑ k ∈ Finset.range ℓ, (a ^ c.val) ^ k * (AdjoinRoot.root f) ^ k * y k := by
    intro y c
    rw [map_sum, Finset.sum_apply]
    refine Finset.sum_congr rfl (fun k _ => ?_)
    simp only [wcTorDescMu, AlgHom.pi_apply, Algebra.TensorProduct.lift_tmul, AlgHom.id_apply,
      map_pow, hσw, mul_pow]
  let ν : (ZMod ℓ → AdjoinRoot f) → TensorProduct C (AdjoinRoot f) (AdjoinRoot f) := fun F =>
    ∑ i ∈ Finset.range ℓ, ((AdjoinRoot.root f) ^ i) ⊗ₜ[C]
      (L * w' ^ i * ∑ c' : ZMod ℓ, a ^ (m * c'.val * i) * F c')
  have hright : ∀ F, wcTorDescMu C (AdjoinRoot f) ℓ σ (ν F) = F := by
    intro F
    funext c
    refine (hμ _ c).trans ?_
    have hA : ∀ k : ℕ, (a ^ c.val) ^ k * (AdjoinRoot.root f) ^ k *
        (L * w' ^ k * ∑ c' : ZMod ℓ, a ^ (m * c'.val * k) * F c') =
        ∑ c' : ZMod ℓ, L * F c' * (a ^ (c.val + m * c'.val)) ^ k := by
      intro k
      rw [Finset.mul_sum, Finset.mul_sum]
      refine Finset.sum_congr rfl (fun c' _ => ?_)
      have e : (a ^ c.val) ^ k * (AdjoinRoot.root f) ^ k * (L * w' ^ k * (a ^ (m * c'.val * k) * F c'))
          = ((AdjoinRoot.root f) ^ k * w' ^ k) * (L * F c' * (a ^ (c.val + m * c'.val)) ^ k) := by
        ring
      rw [e, hww, one_mul]
    simp only [hA]
    rw [Finset.sum_comm]
    have hB : ∀ c' : ZMod ℓ, ∑ k ∈ Finset.range ℓ, L * F c' * (a ^ (c.val + m * c'.val)) ^ k =
        if c = c' then F c' else 0 := by
      intro c'
      rw [← Finset.mul_sum, hG1]
      by_cases h : c = c'
      · subst h
        rw [if_pos ((hdiv _ _).mpr rfl), if_pos rfl]
        linear_combination F c * hL
      · rw [if_neg (fun hd => h (by
            have := (hdiv _ _).mp hd
            rwa [ZMod.natCast_zmod_val, ZMod.natCast_zmod_val] at this)), if_neg h, mul_zero]
    simp only [hB, Finset.sum_ite_eq, Finset.mem_univ, if_true]
  have hleft : ∀ z, ν (wcTorDescMu C (AdjoinRoot f) ℓ σ z) = z := by
    intro z
    obtain ⟨y, rfl⟩ := hspan z
    show ∑ i ∈ Finset.range ℓ, ((AdjoinRoot.root f) ^ i) ⊗ₜ[C]
      (L * w' ^ i * ∑ c' : ZMod ℓ, a ^ (m * c'.val * i) *
        wcTorDescMu C (AdjoinRoot f) ℓ σ
          (∑ k ∈ Finset.range ℓ, ((AdjoinRoot.root f) ^ k) ⊗ₜ[C] y k) c') = _
    refine Finset.sum_congr rfl (fun i hi => ?_)
    have hi' := Finset.mem_range.mp hi
    congr 1
    simp only [hμ]
    have hC : ∀ c' : ZMod ℓ, a ^ (m * c'.val * i) *
        ∑ k ∈ Finset.range ℓ, (a ^ c'.val) ^ k * (AdjoinRoot.root f) ^ k * y k =
        ∑ k ∈ Finset.range ℓ, (a ^ (k + m * i)) ^ c'.val * ((AdjoinRoot.root f) ^ k * y k) := by
      intro c'
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl (fun k _ => ?_)
      ring
    simp only [hC]
    rw [Finset.sum_comm]
    have hD : ∀ k ∈ Finset.range ℓ, ∑ c' : ZMod ℓ, (a ^ (k + m * i)) ^ c'.val *
        ((AdjoinRoot.root f) ^ k * y k) =
        if i = k then ((ℓ : ℕ) : AdjoinRoot f) * ((AdjoinRoot.root f) ^ k * y k) else 0 := by
      intro k hk
      rw [← Finset.sum_mul, hG2]
      by_cases h : i = k
      · subst h
        rw [if_pos ((hdiv _ _).mpr rfl), if_pos rfl]
      · rw [if_neg (fun hd => h ((hcast k i (Finset.mem_range.mp hk) hi').mp
          ((hdiv _ _).mp hd)).symm), if_neg h, zero_mul]
    rw [Finset.sum_congr rfl hD, Finset.sum_ite_eq, if_pos hi]
    linear_combination ((AdjoinRoot.root f) ^ i * w' ^ i * y i) * hL + y i * hww i
  have hbij : Function.Bijective (wcTorDescMu C (AdjoinRoot f) ℓ σ) :=
    Function.bijective_iff_has_inverse.mpr ⟨ν, hleft, hright⟩

  exact ⟨fun c => Spec.map (CommRingCat.ofHom (σ c).toRingHom),
    hfet C (AdjoinRoot f) ℓ σ het hfin hsurj hσ0 hσadd hbij⟩

theorem wc_tae_diff_fn : ∀ {X P : Scheme.{u}} (pr : P ⟶ X) (ℓ : ℕ) (a : ZMod ℓ → (P ⟶ P)), wcFetTorsor pr ℓ a → ∃ D : LocallyConstant ↥(Limits.pullback pr pr) (ZMod ℓ), (∀ (c : ZMod ℓ) (m : Limits.pullback pr pr ⟶ Limits.pullback pr pr), m ≫ Limits.pullback.fst pr pr = Limits.pullback.fst pr pr ≫ a c → m ≫ Limits.pullback.snd pr pr = Limits.pullback.snd pr pr → ∀ z, D (m z) = D z + c) ∧ (∀ (c : ZMod ℓ) (m : Limits.pullback pr pr ⟶ Limits.pullback pr pr), m ≫ Limits.pullback.fst pr pr = Limits.pullback.fst pr pr → m ≫ Limits.pullback.snd pr pr = Limits.pullback.snd pr pr ≫ a c → ∀ z, D (m z) = D z - c) :=
by
  intro X P pr ℓ a ht
  classical
  have hcov : ∀ z : ↥(Limits.pullback pr pr), ∃ c, z ∈ Set.range
      (Limits.pullback.lift (a c) (𝟙 P) ((ht.act_p c).trans (Category.id_comp pr).symm)) := by
    intro z
    have hz : z ∈ ⋃ c, Set.range
        (Limits.pullback.lift (a c) (𝟙 P) ((ht.act_p c).trans (Category.id_comp pr).symm)) := by
      rw [ht.graph_cover]; exact Set.mem_univ z
    exact Set.mem_iUnion.mp hz
  have huniq : ∀ (z : ↥(Limits.pullback pr pr)) (c c' : ZMod ℓ),
      z ∈ Set.range
        (Limits.pullback.lift (a c) (𝟙 P) ((ht.act_p c).trans (Category.id_comp pr).symm)) →
      z ∈ Set.range
        (Limits.pullback.lift (a c') (𝟙 P) ((ht.act_p c').trans (Category.id_comp pr).symm)) →
      c = c' := by
    intro z c c' h h'
    by_contra hcc'
    exact Set.disjoint_left.mp (ht.graph_disj hcc') h h'
  choose Dfun hspec using hcov
  have hchar : ∀ z c, z ∈ Set.range
      (Limits.pullback.lift (a c) (𝟙 P) ((ht.act_p c).trans (Category.id_comp pr).symm)) →
      Dfun z = c := fun z c h => huniq z _ _ (hspec z) h
  have hlc : IsLocallyConstant Dfun := by
    rw [IsLocallyConstant.iff_isOpen_fiber]
    intro c
    have hfib : Dfun ⁻¹' {c} = Set.range
        (Limits.pullback.lift (a c) (𝟙 P) ((ht.act_p c).trans (Category.id_comp pr).symm)) := by
      ext z
      constructor
      · intro hz
        have hz' : Dfun z = c := hz
        have h1 := hspec z
        rw [hz'] at h1
        exact h1
      · intro hz
        exact hchar z c hz
    rw [hfib]
    haveI := ht.graph_open c
    exact IsOpenImmersion.isOpen_range _
  refine ⟨⟨Dfun, hlc⟩, ?_, ?_⟩
  · intro c m hm1 hm2 z
    show Dfun (m z) = Dfun z + c
    obtain ⟨p, hp⟩ := hspec z
    have key : Limits.pullback.lift (a (Dfun z)) (𝟙 P)
          ((ht.act_p (Dfun z)).trans (Category.id_comp pr).symm) ≫ m =
        Limits.pullback.lift (a (c + Dfun z)) (𝟙 P)
          ((ht.act_p (c + Dfun z)).trans (Category.id_comp pr).symm) := by
      apply Limits.pullback.hom_ext
      · simp only [Category.assoc, hm1, Limits.pullback.lift_fst, Limits.pullback.lift_fst_assoc]
        rw [ht.act_add]
      · simp only [Category.assoc, hm2, Limits.pullback.lift_snd]
    have hmz : m z = Limits.pullback.lift (a (c + Dfun z)) (𝟙 P)
          ((ht.act_p (c + Dfun z)).trans (Category.id_comp pr).symm) p := by
      rw [← key, Scheme.Hom.comp_apply, hp]
    rw [hchar (m z) (c + Dfun z) ⟨p, hmz.symm⟩, add_comm]
  · intro c m hm1 hm2 z
    show Dfun (m z) = Dfun z - c
    obtain ⟨p, hp⟩ := hspec z
    have key : Limits.pullback.lift (a (Dfun z)) (𝟙 P)
          ((ht.act_p (Dfun z)).trans (Category.id_comp pr).symm) ≫ m =
        a c ≫ Limits.pullback.lift (a (Dfun z - c)) (𝟙 P)
          ((ht.act_p (Dfun z - c)).trans (Category.id_comp pr).symm) := by
      apply Limits.pullback.hom_ext
      · simp only [Category.assoc, hm1, Limits.pullback.lift_fst]
        rw [← ht.act_add, sub_add_cancel]
      · simp only [Category.assoc, hm2, Limits.pullback.lift_snd, Limits.pullback.lift_snd_assoc,
          Category.id_comp, Category.comp_id]
    have hcomp : (a c ≫ Limits.pullback.lift (a (Dfun z - c)) (𝟙 P)
          ((ht.act_p (Dfun z - c)).trans (Category.id_comp pr).symm)) p =
        Limits.pullback.lift (a (Dfun z - c)) (𝟙 P)
          ((ht.act_p (Dfun z - c)).trans (Category.id_comp pr).symm) (a c p) := by
      rw [Scheme.Hom.comp_apply]
    have hmz : m z = Limits.pullback.lift (a (Dfun z - c)) (𝟙 P)
          ((ht.act_p (Dfun z - c)).trans (Category.id_comp pr).symm) (a c p) := by
      rw [← hcomp, ← key, Scheme.Hom.comp_apply, hp]
    exact hchar (m z) (Dfun z - c) ⟨a c p, hmz.symm⟩

theorem wc_tae_base_torsor : ∀ {X P : Scheme.{u}} (pr : P ⟶ X) (ℓ : ℕ) (a : ZMod ℓ → (P ⟶ P)) (ht : wcFetTorsor pr ℓ a) (W : X.Etale), wcFetTorsor (Limits.pullback.fst W.hom pr) ℓ (fun c => Limits.pullback.lift (Limits.pullback.fst W.hom pr) (Limits.pullback.snd W.hom pr ≫ a c) (by rw [Category.assoc, ht.act_p c]; exact Limits.pullback.condition)) :=
by
  intro X P pr ℓ a ht W
  haveI := ht.finite
  haveI := ht.etale
  let q := Limits.pullback.fst W.hom pr
  let f := Limits.pullback.snd W.hom pr
  have hC : q ≫ W.hom = f ≫ pr := Limits.pullback.condition
  let a' : ZMod ℓ → (Limits.pullback W.hom pr ⟶ Limits.pullback W.hom pr) := fun c =>
    Limits.pullback.lift (Limits.pullback.fst W.hom pr) (Limits.pullback.snd W.hom pr ≫ a c)
      (by rw [Category.assoc, ht.act_p c]; exact Limits.pullback.condition)
  show wcFetTorsor (Limits.pullback.fst W.hom pr) ℓ a'
  haveI hqe : Etale q := inferInstanceAs (Etale (Limits.pullback.fst W.hom pr))
  have A1 : ∀ c, a' c ≫ f = f ≫ a c := fun c => Limits.pullback.lift_snd _ _ _
  have A2 : ∀ c, a' c ≫ q = q := fun c => Limits.pullback.lift_fst _ _ _
  have act_zero : a' 0 = 𝟙 _ := by
    apply Limits.pullback.hom_ext
    · change a' 0 ≫ q = 𝟙 _ ≫ q
      rw [A2, Category.id_comp]
    · change a' 0 ≫ f = 𝟙 _ ≫ f
      rw [A1, ht.act_zero, Category.comp_id, Category.id_comp]
  have act_add : ∀ c c', a' (c + c') = a' c' ≫ a' c := by
    intro c c'
    apply Limits.pullback.hom_ext
    · change a' (c + c') ≫ q = a' c' ≫ a' c ≫ q
      rw [A2, A2, A2]
    · have A1' : ∀ (d : ZMod ℓ) {Z : Scheme.{u}} (k : P ⟶ Z), a' d ≫ f ≫ k = f ≫ a d ≫ k := by
        intro d Z k
        rw [← Category.assoc, A1, Category.assoc]
      change a' (c + c') ≫ f = a' c' ≫ a' c ≫ f
      rw [A1 (c + c'), ht.act_add]
      simp only [Category.assoc, A1, A1']
  have hsurj : Set.range (Limits.pullback.fst W.hom pr) = Set.univ := by
    rw [Scheme.Pullback.range_fst, ht.surj, Set.preimage_univ]
  let G' : ZMod ℓ → (Limits.pullback W.hom pr ⟶ Limits.pullback q q) := fun c =>
    Limits.pullback.lift (a' c) (𝟙 _) ((A2 c).trans (Category.id_comp _).symm)
  have G'1 : ∀ c, G' c ≫ Limits.pullback.fst q q = a' c := fun c => Limits.pullback.lift_fst _ _ _
  have G'2 : ∀ c, G' c ≫ Limits.pullback.snd q q = 𝟙 _ := fun c => Limits.pullback.lift_snd _ _ _
  let G : ZMod ℓ → (P ⟶ Limits.pullback pr pr) := fun c =>
    Limits.pullback.lift (a c) (𝟙 P) ((ht.act_p c).trans (Category.id_comp pr).symm)
  have G1 : ∀ c, G c ≫ Limits.pullback.fst pr pr = a c := fun c => Limits.pullback.lift_fst _ _ _
  have G2 : ∀ c, G c ≫ Limits.pullback.snd pr pr = 𝟙 P := fun c => Limits.pullback.lift_snd _ _ _
  have hopen : ∀ c, IsOpenImmersion (G' c) := by
    intro c
    haveI : Mono (G' c) := mono_of_mono_fac (G'2 c)
    haveI : Etale (G' c) := by
      apply MorphismProperty.of_postcomp (W := @Etale) (W' := @Etale) _
        (Limits.pullback.snd q q) inferInstance
      rw [G'2 c]; infer_instance
    exact IsOpenImmersion.of_flat_of_mono _
  let κ := Limits.pullback.map q q pr pr f f W.hom hC hC
  have κ1 : κ ≫ Limits.pullback.fst pr pr = Limits.pullback.fst q q ≫ f :=
    Limits.pullback.lift_fst _ _ _
  have κ2 : κ ≫ Limits.pullback.snd pr pr = Limits.pullback.snd q q ≫ f :=
    Limits.pullback.lift_snd _ _ _
  have K : ∀ c, G' c ≫ κ = f ≫ G c := by
    intro c
    apply Limits.pullback.hom_ext
    · simp only [Category.assoc]
      rw [κ1, ← Category.assoc, G'1, A1, G1]
    · simp only [Category.assoc]
      rw [κ2, ← Category.assoc, G'2, Category.id_comp, G2, Category.comp_id]
  have L : ∀ c {T : Scheme.{u}} (t₁ : T ⟶ P) (t₂ : T ⟶ Limits.pullback q q),
      t₁ ≫ G c = t₂ ≫ κ → (t₂ ≫ Limits.pullback.snd q q) ≫ G' c = t₂ := by
    intro c T t₁ t₂ ht₁
    have e1 : t₂ ≫ Limits.pullback.fst q q ≫ f = t₁ ≫ a c := by
      rw [← κ1, ← Category.assoc, ← ht₁, Category.assoc, G1]
    have e2 : t₂ ≫ Limits.pullback.snd q q ≫ f = t₁ := by
      rw [← κ2, ← Category.assoc, ← ht₁, Category.assoc, G2, Category.comp_id]
    apply Limits.pullback.hom_ext
    · simp only [Category.assoc, G'1]
      apply Limits.pullback.hom_ext
      · change t₂ ≫ Limits.pullback.snd q q ≫ a' c ≫ q = t₂ ≫ Limits.pullback.fst q q ≫ q
        rw [A2, Limits.pullback.condition]
      · change t₂ ≫ Limits.pullback.snd q q ≫ a' c ≫ f = t₂ ≫ Limits.pullback.fst q q ≫ f
        rw [A1 c, reassoc_of% e2, e1]
    · simp only [Category.assoc, G'2, Category.comp_id]
  have hR : ∀ c, Set.range (G' c) ⊆ κ ⁻¹' Set.range (G c) := by
    rintro c _ ⟨v, rfl⟩
    refine ⟨f v, ?_⟩
    have := Scheme.Hom.comp_apply (G' c) κ v
    rw [K c, Scheme.Hom.comp_apply] at this
    exact this
  have hdisj : Pairwise fun c c' => Disjoint (Set.range (G' c)) (Set.range (G' c')) := by
    intro c c' hcc'
    have hd : Disjoint (Set.range (G c)) (Set.range (G c')) := ht.graph_disj hcc'
    exact Disjoint.mono (hR c) (hR c') (hd.preimage (⇑κ))
  have hcov : ⋃ c, Set.range (G c) = Set.univ := ht.graph_cover
  have hcover : ⋃ c, Set.range (G' c) = Set.univ := by
    apply Set.eq_univ_of_forall
    intro z
    have hz : κ z ∈ ⋃ c, Set.range (G c) := by
      rw [hcov]; exact Set.mem_univ _
    obtain ⟨c, hc⟩ := Set.mem_iUnion.mp hz
    have hzT : z ∈ Set.range (Limits.pullback.snd (G c) κ) := by
      rw [Scheme.Pullback.range_snd]; exact hc
    obtain ⟨w, rfl⟩ := hzT
    have hL := L c (Limits.pullback.fst (G c) κ) (Limits.pullback.snd (G c) κ)
      Limits.pullback.condition
    refine Set.mem_iUnion.mpr ⟨c, (Limits.pullback.snd (G c) κ ≫ Limits.pullback.snd q q) w, ?_⟩
    have := Scheme.Hom.comp_apply (Limits.pullback.snd (G c) κ ≫ Limits.pullback.snd q q) (G' c) w
    rw [hL] at this
    exact this.symm
  exact ⟨inferInstance, inferInstance, hsurj, A2, act_zero, act_add, hopen, hdisj, hcover⟩

theorem wc_tae_invariant_descend : ∀ {Z Q : Scheme.{u}} (p : Q ⟶ Z) (m : ℕ) (b : ZMod m → (Q ⟶ Q)), wcFetTorsor p m b → ∀ {N : Type (u+1)} (h : LocallyConstant Q N), (∀ (c : ZMod m) (y : Q), h (b c y) = h y) → ∃ μ : LocallyConstant Z N, ∀ y, h y = μ (p y) :=
by
  intro Z Q p m b ht N h hinv
  have hsurj : Function.Surjective p := Set.range_eq_univ.mp ht.surj
  have hfib : ∀ y y' : Q, p y = p y' → h y = h y' := by
    intro y y' hyy'
    obtain ⟨z, hz1, hz2⟩ := Scheme.Pullback.exists_preimage_pullback y y' hyy'
    have hz : z ∈ ⋃ c, Set.range (Limits.pullback.lift (b c) (𝟙 Q)
        ((ht.act_p c).trans (Category.id_comp p).symm)) := by
      rw [ht.graph_cover]; exact Set.mem_univ _
    obtain ⟨c, w, hw⟩ := Set.mem_iUnion.mp hz
    have e1 : y = b c w := by
      rw [← hz1, ← hw, ← Scheme.Hom.comp_apply, Limits.pullback.lift_fst]
    have e2 : y' = w := by
      rw [← hz2, ← hw, ← Scheme.Hom.comp_apply, Limits.pullback.lift_snd]
      rfl
    rw [e1, e2, hinv]
  let μf : Z → N := fun x => h (Function.surjInv hsurj x)
  have hμ : ∀ y, h y = μf (p y) := by
    intro y
    exact (hfib _ y (Function.surjInv_eq hsurj (p y))).symm
  have hfiber : ∀ v : N, μf ⁻¹' {v} = p '' (h ⁻¹' {v}) := by
    intro v
    ext x
    constructor
    · intro hx
      exact ⟨Function.surjInv hsurj x, hx, Function.surjInv_eq hsurj x⟩
    · rintro ⟨y, hy, rfl⟩
      show μf (p y) = v
      rw [← hμ y]
      exact hy
  haveI := ht.etale
  have hlc : IsLocallyConstant μf := by
    rw [IsLocallyConstant.iff_isOpen_fiber]
    intro v
    rw [hfiber v]
    exact p.isOpenMap _ (IsLocallyConstant.iff_isOpen_fiber.mp h.isLocallyConstant v)
  exact ⟨⟨μf, hlc⟩, hμ⟩

theorem wc_tae_local_lift : ∀ {X P : Scheme.{u}} (pr : P ⟶ X) (ℓ : ℕ) (a : ZMod ℓ → (P ⟶ P)) (hact : ∀ c, a c ≫ pr = pr), Etale pr → Set.range pr = Set.univ → ∀ (D : LocallyConstant ↥(Limits.pullback pr pr) (ZMod ℓ)), (∀ (c : ZMod ℓ) (m : Limits.pullback pr pr ⟶ Limits.pullback pr pr), m ≫ Limits.pullback.fst pr pr = Limits.pullback.fst pr pr → m ≫ Limits.pullback.snd pr pr = Limits.pullback.snd pr pr ≫ a c → ∀ z, D (m z) = D z - c) → ∀ (W : X.Etale) (lam : LocallyConstant W.left (ULift.{u+1} (ZMod ℓ))), ∃ (W₁ : X.Etale) (k : W₁ ⟶ W) (h : LocallyConstant ((wcEtBaseChange pr).obj W₁).left (ULift.{u+1} (ZMod ℓ))), Function.Surjective k.left ∧ ∀ (c : ZMod ℓ) (y : ((wcEtBaseChange pr).obj W₁).left), h (wcPbρ pr pr (a c) (hact c) W₁ y) = h y + ULift.up c * lam (k.left (Limits.pullback.fst W₁.hom pr y)) :=
by
  intro X P pr ℓ a hact hpr hsurj D hD W lam
  haveI : Etale pr := hpr
  haveI : Etale W.hom := W.prop
  let W₁ : X.Etale := MorphismProperty.Over.mk ⊤ (Limits.pullback.fst W.hom pr ≫ W.hom)
    (inferInstance : Etale (Limits.pullback.fst W.hom pr ≫ W.hom))
  let k : W₁ ⟶ W := MorphismProperty.Over.homMk (Limits.pullback.fst W.hom pr) rfl trivial
  have hk : Function.Surjective k.left := by
    have h1 := Scheme.Pullback.range_fst W.hom pr
    rw [hsurj, Set.preimage_univ] at h1
    exact Set.range_eq_univ.mp h1
  have hj : (Limits.pullback.fst W₁.hom pr ≫ Limits.pullback.snd W.hom pr) ≫ pr =
      Limits.pullback.snd W₁.hom pr ≫ pr :=
    calc (Limits.pullback.fst W₁.hom pr ≫ Limits.pullback.snd W.hom pr) ≫ pr
        = Limits.pullback.fst W₁.hom pr ≫ (Limits.pullback.snd W.hom pr ≫ pr) :=
          Category.assoc _ _ _
      _ = Limits.pullback.fst W₁.hom pr ≫ (Limits.pullback.fst W.hom pr ≫ W.hom) :=
          congrArg (fun t => Limits.pullback.fst W₁.hom pr ≫ t)
            (Limits.pullback.condition (f := W.hom) (g := pr)).symm
      _ = Limits.pullback.fst W₁.hom pr ≫ W₁.hom := rfl
      _ = Limits.pullback.snd W₁.hom pr ≫ pr := Limits.pullback.condition
  let j : Limits.pullback W₁.hom pr ⟶ Limits.pullback pr pr :=
    Limits.pullback.lift (Limits.pullback.fst W₁.hom pr ≫ Limits.pullback.snd W.hom pr)
      (Limits.pullback.snd W₁.hom pr) hj
  have hlc1 : IsLocallyConstant (fun y : ((wcEtBaseChange pr).obj W₁).left =>
      lam (k.left (Limits.pullback.fst W₁.hom pr y))) :=
    lam.isLocallyConstant.comp_continuous
      (k.left.continuous.comp (Limits.pullback.fst W₁.hom pr).continuous)
  have hlc2 : IsLocallyConstant (fun y : ((wcEtBaseChange pr).obj W₁).left =>
      (ULift.up (-(D (j y))) : ULift.{u+1} (ZMod ℓ))) :=
    (D.isLocallyConstant.comp_continuous j.continuous).comp (fun z => ULift.up (-z))
  let h : LocallyConstant ((wcEtBaseChange pr).obj W₁).left (ULift.{u+1} (ZMod ℓ)) :=
    ⟨fun y => lam (k.left (Limits.pullback.fst W₁.hom pr y)) * ULift.up (-(D (j y))),
      hlc1.mul hlc2⟩
  refine ⟨W₁, k, h, hk, fun c y => ?_⟩
  have hm : Limits.pullback.fst pr pr ≫ pr = (Limits.pullback.snd pr pr ≫ a c) ≫ pr := by
    rw [Category.assoc, hact c]; exact Limits.pullback.condition
  let mc : Limits.pullback pr pr ⟶ Limits.pullback pr pr :=
    Limits.pullback.lift (Limits.pullback.fst pr pr) (Limits.pullback.snd pr pr ≫ a c) hm
  have hτ1 : wcPbρ pr pr (a c) (hact c) W₁ ≫ Limits.pullback.fst W₁.hom pr =
      Limits.pullback.fst W₁.hom pr := by
    unfold wcPbρ
    exact Limits.pullback.lift_fst _ _ _
  have hτ2 : wcPbρ pr pr (a c) (hact c) W₁ ≫ Limits.pullback.snd W₁.hom pr =
      Limits.pullback.snd W₁.hom pr ≫ a c := by
    unfold wcPbρ
    exact Limits.pullback.lift_snd _ _ _
  have hjf : j ≫ Limits.pullback.fst pr pr =
      Limits.pullback.fst W₁.hom pr ≫ Limits.pullback.snd W.hom pr :=
    Limits.pullback.lift_fst _ _ _
  have hjs : j ≫ Limits.pullback.snd pr pr = Limits.pullback.snd W₁.hom pr :=
    Limits.pullback.lift_snd _ _ _
  have hmf : mc ≫ Limits.pullback.fst pr pr = Limits.pullback.fst pr pr :=
    Limits.pullback.lift_fst _ _ _
  have hms : mc ≫ Limits.pullback.snd pr pr = Limits.pullback.snd pr pr ≫ a c :=
    Limits.pullback.lift_snd _ _ _
  have hcomm : wcPbρ pr pr (a c) (hact c) W₁ ≫ j = j ≫ mc := by
    apply Limits.pullback.hom_ext
    · exact (Category.assoc _ _ _).trans
        ((congrArg (fun t => wcPbρ pr pr (a c) (hact c) W₁ ≫ t) hjf).trans
        ((Category.assoc _ _ _).symm.trans
        ((congrArg (fun t => t ≫ Limits.pullback.snd W.hom pr) hτ1).trans
        (hjf.symm.trans
        ((congrArg (fun t => j ≫ t) hmf.symm).trans (Category.assoc _ _ _).symm)))))
    · exact (Category.assoc _ _ _).trans
        ((congrArg (fun t => wcPbρ pr pr (a c) (hact c) W₁ ≫ t) hjs).trans
        (hτ2.trans
        ((congrArg (fun t => t ≫ a c) hjs.symm).trans
        ((Category.assoc _ _ _).trans
        ((congrArg (fun t => j ≫ t) hms.symm).trans (Category.assoc _ _ _).symm)))))
  have e1 : Limits.pullback.fst W₁.hom pr (wcPbρ pr pr (a c) (hact c) W₁ y) =
      Limits.pullback.fst W₁.hom pr y :=
    (Scheme.Hom.comp_apply (wcPbρ pr pr (a c) (hact c) W₁) (Limits.pullback.fst W₁.hom pr) y).symm.trans
      (congrArg (fun f : Limits.pullback W₁.hom pr ⟶ W₁.left => f y) hτ1)
  have h4 : j (wcPbρ pr pr (a c) (hact c) W₁ y) = mc (j y) :=
    (Scheme.Hom.comp_apply (wcPbρ pr pr (a c) (hact c) W₁) j y).symm.trans
      ((congrArg (fun f : Limits.pullback W₁.hom pr ⟶ Limits.pullback pr pr => f y) hcomm).trans
        (Scheme.Hom.comp_apply j mc y))
  have e2 : D (j (wcPbρ pr pr (a c) (hact c) W₁ y)) = D (j y) - c :=
    (congrArg D h4).trans (hD c mc hmf hms (j y))
  have key : ∀ (L : ULift.{u+1} (ZMod ℓ)) (d : ZMod ℓ),
      L * (ULift.up (-(d - c)) : ULift.{u+1} (ZMod ℓ)) =
        L * (ULift.up (-d) : ULift.{u+1} (ZMod ℓ)) + ULift.up c * L := by
    intro L d
    apply ULift.ext
    simp only [ULift.mul_down, ULift.add_down]
    ring
  exact (congrArg₂ (fun (p : W₁.left) (b : ZMod ℓ) =>
      lam (k.left p) * (ULift.up (-b) : ULift.{u+1} (ZMod ℓ))) e1 e2).trans (key _ _)

theorem wc_tae_aff_sheaf : ∀ {X P : Scheme.{u}} (pr : P ⟶ X) (ℓ : ℕ) (a : ZMod ℓ → (P ⟶ P)) (hact : ∀ c, a c ≫ pr = pr), ∃ (A : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) (κ : ∀ W : X.Etale, A.obj.obj (Opposite.op W) →+ (LocallyConstant ((wcEtBaseChange pr).obj W).left (ULift.{u+1} (ZMod ℓ)) × LocallyConstant W.left (ULift.{u+1} (ZMod ℓ)))), (∀ W : X.Etale, Function.Injective (κ W)) ∧ (∀ (W : X.Etale) (x : LocallyConstant ((wcEtBaseChange pr).obj W).left (ULift.{u+1} (ZMod ℓ)) × LocallyConstant W.left (ULift.{u+1} (ZMod ℓ))), (∃ s, κ W s = x) ↔ ∀ (c : ZMod ℓ) (y : ((wcEtBaseChange pr).obj W).left), x.1 (wcPbρ pr pr (a c) (hact c) W y) = x.1 y + ULift.up c * x.2 (Limits.pullback.fst W.hom pr y)) ∧ ∀ (W W' : X.Etale) (k : W' ⟶ W) (s : A.obj.obj (Opposite.op W)), (κ W' ((A.obj.map k.op).hom s)).1 = LocallyConstant.comap ⟨((wcEtBaseChange pr).map k).left, ((wcEtBaseChange pr).map k).left.continuous⟩ (κ W s).1 ∧ (κ W' ((A.obj.map k.op).hom s)).2 = LocallyConstant.comap ⟨k.left, k.left.continuous⟩ (κ W s).2 :=
by

  have hLC : ∀ (X : Scheme.{u}) (A : Type (u+1)) [AddCommGroup A],
      Presheaf.IsSheaf (Scheme.smallEtaleTopology X) (wcEtLC X A) := by
    intro X A _
    have s2 : ∀ {Z : Type u} [TopologicalSpace Z] {ι : Type (u+1)} {V : ι → Type u}
        [∀ i, TopologicalSpace (V i)] (f : ∀ i, V i → Z), (∀ i, IsOpenMap (f i)) →
        (∀ z : Z, ∃ (i : ι) (v : V i), f i v = z) → ∀ (g : ∀ i, LocallyConstant (V i) A),
        (∀ (i j : ι) (v : V i) (w : V j), f i v = f j w → g i v = g j w) →
        ∃ G : LocallyConstant Z A, ∀ (i : ι) (v : V i), G (f i v) = g i v := by
      intro Z _ ι V _ f hopen hsurj g hcompat
      choose iz vz hz using hsurj
      let G₀ : Z → A := fun z => g (iz z) (vz z)
      have hK : ∀ j w, G₀ (f j w) = g j w := fun j w => hcompat _ _ _ _ (hz _)
      have hlc : IsLocallyConstant G₀ := by
        rw [IsLocallyConstant.iff_isOpen_fiber]
        intro a
        rw [isOpen_iff_forall_mem_open]
        intro z hzA
        refine ⟨f (iz z) '' {v' | g (iz z) v' = g (iz z) (vz z)}, ?_,
          hopen _ _ (IsLocallyConstant.isOpen_fiber (g (iz z)).isLocallyConstant _),
          ⟨vz z, rfl, hz z⟩⟩
        rintro _ ⟨v', hv', rfl⟩
        change G₀ (f (iz z) v') = a
        rw [hK, hv']
        exact hzA
      exact ⟨⟨G₀, hlc⟩, hK⟩
    have s3 : ∀ (U : X.Etale) (S : Sieve U), S ∈ Scheme.smallEtaleTopology X U →
        ∀ z : U.left, ∃ (V : X.Etale) (f : V ⟶ U) (y : V.left), S.arrows f ∧ f.left y = z := by
      intro U S hS z
      change S ∈ Scheme.smallGrothendieckTopology @Etale X U at hS
      rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale X
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hS
      obtain ⟨V, f, y, hf, -, hy⟩ := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale X
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ U S).mp hS z
      exact ⟨V, f, y, hf, hy⟩
    have s4e : ∀ {V U : X.Etale} (c : V ⟶ U), Etale c.left := by
      intro V U c
      haveI : Etale U.hom := U.prop
      haveI : Etale (c.left ≫ U.hom) := by rw [MorphismProperty.Over.w c]; exact V.prop
      exact Etale.of_comp c.left U.hom
    have s4 : ∀ {V U : X.Etale} (c : V ⟶ U), IsOpenMap c.left := by
      intro V U c
      haveI := s4e c
      exact c.left.isOpenMap
    have s5 : ∀ {U V₁ V₂ : X.Etale} (f₁ : V₁ ⟶ U) (f₂ : V₂ ⟶ U) (y₁ : V₁.left) (y₂ : V₂.left),
        f₁.left y₁ = f₂.left y₂ → ∃ (D : X.Etale) (π₁ : D ⟶ V₁) (π₂ : D ⟶ V₂) (z : D.left),
          π₁ ≫ f₁ = π₂ ≫ f₂ ∧ π₁.left z = y₁ ∧ π₂.left z = y₂ := by
      intro U V₁ V₂ f₁ f₂ y₁ y₂ h
      haveI := s4e f₂
      haveI hEt : Etale (Limits.pullback.fst f₁.left f₂.left ≫ V₁.hom) := by
        haveI : Etale V₁.hom := V₁.prop
        infer_instance
      let D : X.Etale :=
        MorphismProperty.Over.mk ⊤ (Limits.pullback.fst f₁.left f₂.left ≫ V₁.hom) hEt
      have hw : Limits.pullback.snd f₁.left f₂.left ≫ V₂.hom =
          Limits.pullback.fst f₁.left f₂.left ≫ V₁.hom := by
        rw [← MorphismProperty.Over.w f₁, ← MorphismProperty.Over.w f₂, ← Category.assoc,
          ← Category.assoc, Limits.pullback.condition]
      let p₁ : D ⟶ V₁ :=
        MorphismProperty.Over.homMk (Limits.pullback.fst f₁.left f₂.left) rfl trivial
      let p₂ : D ⟶ V₂ :=
        MorphismProperty.Over.homMk (Limits.pullback.snd f₁.left f₂.left) hw trivial
      have hcomm : p₁ ≫ f₁ = p₂ ≫ f₂ := by
        apply MorphismProperty.Over.Hom.ext
        change Limits.pullback.fst f₁.left f₂.left ≫ f₁.left =
          Limits.pullback.snd f₁.left f₂.left ≫ f₂.left
        exact Limits.pullback.condition
      obtain ⟨z, hz1, hz2⟩ := Scheme.Pullback.exists_preimage_pullback y₁ y₂ h
      exact ⟨D, p₁, p₂, z, hcomm, hz1, hz2⟩
    rw [Presheaf.isSheaf_iff_isSheaf_forget (Scheme.smallEtaleTopology X) (wcEtLC X A)
      (forget AddCommGrpCat.{u+1}), isSheaf_iff_isSheaf_of_type]
    intro U S hS x hx
    let ι := Σ (V : X.Etale), {f : V ⟶ U // S.arrows f}
    obtain ⟨G, hG⟩ := s2 (Z := U.left) (ι := ι) (V := fun i => ↥(i.1.left))
      (fun i v => i.2.1.left v) (fun i => s4 i.2.1)
      (fun z => by
        obtain ⟨V, f, y, hf, hy⟩ := s3 U S hS z
        exact ⟨⟨V, f, hf⟩, y, hy⟩)
      (fun i => show LocallyConstant i.1.left A from x i.2.1 i.2.2)
      (by
        rintro ⟨V₁, f₁, h₁⟩ ⟨V₂, f₂, h₂⟩ v w hvw
        obtain ⟨D, π₁, π₂, z, hcomm, hz1, hz2⟩ := s5 f₁ f₂ v w hvw
        have hc := hx π₁ π₂ h₁ h₂ hcomm
        have h := congrArg (fun k => (show LocallyConstant D.left A from k) z) hc
        change (show LocallyConstant V₁.left A from x f₁ h₁) v =
          (show LocallyConstant V₂.left A from x f₂ h₂) w
        rw [← hz1, ← hz2]
        exact h)
    refine ⟨G, fun V f hf => ?_, fun t ht => ?_⟩
    · change @Eq (LocallyConstant V.left A) _ _
      exact LocallyConstant.ext (fun y => hG ⟨V, f, hf⟩ y)
    · change @Eq (LocallyConstant U.left A) _ _
      refine LocallyConstant.ext (fun z => ?_)
      obtain ⟨V, f, y, hf, rfl⟩ := s3 U S hS z
      have h1 := congrArg (fun k => (show LocallyConstant V.left A from k) y) (ht f hf)
      exact h1.trans (hG ⟨V, f, hf⟩ y).symm


  have hcont : ∀ {X B : Scheme.{u}} (g : X ⟶ B),
      (wcEtBaseChange g).IsContinuous (Scheme.smallEtaleTopology B)
        (Scheme.smallEtaleTopology X) := by
    have hjs : ∀ (Y : Scheme.{u}) (V : Y.Etale) (S : Sieve V), (∀ v : V.left, ∃ (V₁ : Y.Etale)
        (c : V₁ ⟶ V), S.arrows c ∧ v ∈ Set.range c.left) → S ∈ Scheme.smallEtaleTopology Y V := by
      intro Y V S hS
      change S ∈ Scheme.smallGrothendieckTopology @Etale Y V
      rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
      apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
      intro x
      obtain ⟨V₁, c, hc, y, hy⟩ := hS x
      have hw : c.left ≫ V.hom = V₁.hom := MorphismProperty.Over.w c
      have hEt : Etale c.left := by
        have h1 : Etale V.hom := V.prop
        have h2 : Etale (c.left ≫ V.hom) := by rw [hw]; exact V₁.prop
        exact Etale.of_comp c.left V.hom
      exact ⟨V₁, c, y, hc, hEt, hy⟩
    have hcov : ∀ {X B : Scheme.{u}} (g : X ⟶ B), CoverPreserving (Scheme.smallEtaleTopology B)
        (Scheme.smallEtaleTopology X) (wcEtBaseChange g) := by
      intro X B g
      constructor
      intro V S hS
      change S ∈ Scheme.smallGrothendieckTopology @Etale B V at hS
      rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale B
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hS
      have hS' := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale B
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mp hS
      apply hjs
      intro v
      obtain ⟨W, a, w, ha, -, hw⟩ := hS' (Limits.pullback.fst V.hom g v)
      refine ⟨(wcEtBaseChange g).obj W, (wcEtBaseChange g).map a,
        Sieve.image_mem_functorPushforward (wcEtBaseChange g) S ha, ?_⟩
      have h0 : (Limits.pullback.fst W.hom g ≫ a.left) ≫ V.hom =
          Limits.pullback.snd W.hom g ≫ g := by
        rw [Category.assoc, MorphismProperty.Over.w a]
        exact Limits.pullback.condition
      let m : Limits.pullback W.hom g ⟶ Limits.pullback V.hom g :=
        Limits.pullback.lift (Limits.pullback.fst W.hom g ≫ a.left) (Limits.pullback.snd W.hom g) h0
      have hmap : ((wcEtBaseChange g).map a).left = m := rfl
      have h1 : Limits.pullback.fst a.left (Limits.pullback.fst V.hom g) ≫ W.hom =
          (Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) ≫
            Limits.pullback.snd V.hom g) ≫ g := by
        rw [← MorphismProperty.Over.w a, ← Category.assoc, Limits.pullback.condition,
          Category.assoc, Limits.pullback.condition, Category.assoc]
      let ψ : Limits.pullback a.left (Limits.pullback.fst V.hom g) ⟶ Limits.pullback W.hom g :=
        Limits.pullback.lift (Limits.pullback.fst a.left (Limits.pullback.fst V.hom g))
          (Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) ≫
            Limits.pullback.snd V.hom g) h1
      have hψ : ψ ≫ m = Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) := by
        apply Limits.pullback.hom_ext
        · rw [Category.assoc, Limits.pullback.lift_fst, ← Category.assoc,
            Limits.pullback.lift_fst, Limits.pullback.condition]
        · rw [Category.assoc, Limits.pullback.lift_snd, Limits.pullback.lift_snd]
      obtain ⟨z, hz⟩ : ∃ z, Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) z = v := by
        have hv : (v : ↥(Limits.pullback V.hom g)) ∈
            Set.range (Limits.pullback.snd a.left (Limits.pullback.fst V.hom g)) := by
          rw [Scheme.Pullback.range_snd]
          exact ⟨w, hw⟩
        exact hv
      rw [hmap]
      exact ⟨ψ z, (Scheme.Hom.comp_apply ψ m z).symm.trans (by rw [hψ]; exact hz)⟩
    intro X B g
    let Φ := wcEtBaseChange g
    haveI h1 : Limits.PreservesFiniteLimits Φ := ⟨fun J _ _ =>
      haveI : Limits.PreservesLimitsOfShape J (wcEtBaseChange g ⋙ Scheme.Etale.forget X) :=
        Limits.preservesLimitsOfShape_of_natIso
          (NatIso.ofComponents (fun _ => Iso.refl _) (fun _ => rfl) :
            Scheme.Etale.forget B ⋙ Over.pullback g ≅ wcEtBaseChange g ⋙ Scheme.Etale.forget X)
      Limits.preservesLimitsOfShape_of_reflects_of_preserves (wcEtBaseChange g)
        (Scheme.Etale.forget X)⟩
    haveI := flat_of_preservesFiniteLimits Φ
