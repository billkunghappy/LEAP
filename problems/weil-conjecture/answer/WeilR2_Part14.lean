    refine gen _ (LaurentPolynomial.T 1) (LaurentPolynomial.T (-1)) ?_ ?_ ?_
    · rw [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X]
    · rw [← LaurentPolynomial.T_add]
      norm_num
    · intro N hadd hpos hneg b
      refine LaurentPolynomial.induction_on' (motive := fun f => f ∈ N) b
        (fun p q hp hq => hadd p q hp hq) (fun n a => ?_)
      have hC : (Polynomial.eval₂RingHom (algebraMap K (LaurentPolynomial K))
