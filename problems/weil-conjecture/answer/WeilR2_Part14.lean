          (ULiftHom.{u+1} (CostructuredArrow G.op Y)) (CostructuredArrow G.op Y) _ _
          (ULiftHom.equiv (C := CostructuredArrow G.op Y)).symm _ _
      exact Limits.preservesLimitsOfShape_of_natIso θ.symm
    have hjs : ∀ (Y : Scheme.{u}) (V : Y.Etale) (S : Sieve V), (∀ v : V.left, ∃ (V₁ : Y.Etale)
