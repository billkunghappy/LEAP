    obtain ⟨j₀, x, hx⟩ := hlift N (fun k => h (f (MvPolynomial.X k)))
    letI : Algebra R (F.obj j₀) := (p j₀).toAlgebra
    let ψ₀ : MvPolynomial (Fin N) R →ₐ[R] F.obj j₀ := MvPolynomial.aeval x
    have hψ₀ : ∀ z, ι j₀ (ψ₀ z) = h (f z) := by
