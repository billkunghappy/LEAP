ommRingCat.ofHom (algebraMap A (Polynomial A)))) c)) → Nonempty (L.obj ((wcEtPush z).obj ((constantSheaf (Scheme.smallEtaleTopology (Spec (.of Ω))) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))))) ≅ (wcEtPush (Limits.pullback.fst (Limits.pullback.snd (a ≫ Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) c) z)).obj ((constantSheaf (Scheme.smallEtaleTopology (Limits.pullback (Limits.pullback.snd (a ≫ Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) c) z)) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))))) :=
