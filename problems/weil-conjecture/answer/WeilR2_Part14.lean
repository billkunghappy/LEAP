  obtain ⟨θ', hθ'⟩ := wc_shdata_etale_iso θ.hom x x' ι hι B Λ W' φ a hd B' Λ' W'' φ' a' hd'
  have key : (a ≫ g) ≫ 𝟙 _ = θ'.hom ≫
