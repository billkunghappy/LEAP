    rw [hfun]
    exact hpost.comp h1
  refine ⟨fun q W => AddEquiv.ofBijective (Θ₀ q W) (hΘbij q W), ?_, ?_⟩
  · intro q W c β
    rw [AddEquiv.ofBijective_apply, AddEquiv.ofBijective_apply, hΘ₀, hΘ₀]
    have hs := wc_slice_unit_const_comm S ℓ W c
    have hs' : (wcSliceRes S ℓ W).map (wcHMConst S ℓ c) ≫ inv (wcSliceUnit S ℓ W) =
        inv (wcSliceUnit S ℓ W) ≫ wcHMConst W.left ℓ c := by
