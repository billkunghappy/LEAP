theorem wc_P1_sepclosed_field_cd_two : ∀ (K : Type u) [Field K] [IsSepClosed K] (ℓ : ℕ), ℓ.Prime → (ℓ : K) ≠ 0 → ∀ (E : Sheaf (Scheme.smallEtaleTopology (@Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K) MvPolynomial.gradedAlgebra)) AddCommGrpCat.{u+1}), ℓ • 𝟙 E = 0 → ∀ p : ℕ, 3 ≤ p → Subsingleton (wcEtExt (@Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K) MvPolynomial.gradedAlgebra) E p) :=
