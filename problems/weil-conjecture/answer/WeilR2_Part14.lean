    exact ⟨LinearEquiv.ofLinear m ψ h1 h2, fun u v => hm u v⟩
  have hpow : ∀ k : ℕ, ∃ g : TensorPower S k (wcKummerEigDom (σC 1) ζ) ≃ₗ[S]
      wcKummerEigDom (σC 1) (ζ ^ k), ∀ x : Fin k → wcKummerEigDom (σC 1) ζ,
      (g (PiTensorProduct.tprod S x) : C) = ∏ i, (x i : C) := by
    intro k
    induction k with
    | zero =>
      refine ⟨(PiTensorProduct.isEmptyEquiv (Fin 0) :
        TensorPower S 0 (wcKummerEigDom (σC 1) ζ) ≃ₗ[S] S).trans
        (j.trans (LinearEquiv.ofEq _ _ (by rw [pow_zero]))), ?_⟩
      intro x
      rw [LinearEquiv.trans_apply, LinearEquiv.trans_apply, LinearEquiv.coe_ofEq_apply, hj,
        PiTensorProduct.isEmptyEquiv_apply_tprod, map_one, Finset.univ_eq_empty, Finset.prod_empty]
    | succ k ih =>
