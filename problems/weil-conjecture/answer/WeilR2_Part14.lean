  let I := injectiveResolution ((constantSheaf (Scheme.smallEtaleTopology
    (Spec (.of (Polynomial C)))) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))))
