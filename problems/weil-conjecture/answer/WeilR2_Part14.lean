        exact S.exact_of_f_is_kernel (Limits.kernelIsKernel (ℓ • 𝟙 E))
      obtain ⟨_, _, hles⟩ := wc_rightDerived_les_package (wcEtPush r) S hS
      obtain ⟨_, δ, h1, h2, _, hex⟩ := hles q
      have hf : ((wcEtPush r).rightDerived (q + 1)).map S.f = 0 :=
        (Functor.isZero_rightDerived_obj_injective_succ (wcEtPush r) q E).eq_of_tgt _ _
      have hδ : δ = 0 := by
        cases q with
        | zero =>
          have hRe' : Epi ((wcEtPush r).map S.g) := hRe
          have hepi : Epi (((wcEtPush r).rightDerived 0).map S.g) := by
            rw [← NatIso.naturality_2 (wcEtPush r).rightDerivedZeroIsoSelf S.g]
            infer_instance
          exact (cancel_epi _).1 (h1.trans Limits.comp_zero.symm)
        | succ m =>
          exact (Functor.isZero_rightDerived_obj_injective_succ (wcEtPush r) m E).eq_of_src _ _
      exact hex.isZero_X₂ hδ hf
    obtain ⟨α₀, hinj₀, hsurj₀, hR⟩ := wc_et_zmod_ring_locbij Q ℓ
    obtain ⟨hfull, hess⟩ := sheafOfModules_toSheaf_torsion_equiv (Scheme.smallEtaleTopology Q)
      (wcEtZModRing Q ℓ) ℓ α₀ hinj₀ hsurj₀
    haveI := hfull
    have hacyc : ∀ (I : SheafOfModules.{u+1} (wcEtZModRing Q ℓ)) [Injective I] (k : ℕ),
        Limits.IsZero (((wcEtPush r).rightDerived (k + 1)).obj
          ((SheafOfModules.toSheaf (wcEtZModRing Q ℓ)).obj I)) := by
      intro I _ k
      let Φ := SheafOfModules.toSheaf.{u+1} (wcEtZModRing Q ℓ)
      have hI0 : ℓ • 𝟙 (Φ.obj I) = 0 := by
        apply (sheafToPresheaf (Scheme.smallEtaleTopology Q) AddCommGrpCat.{u+1}).map_injective
        rw [CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id,
          CategoryTheory.Functor.map_zero]
        ext X m
        have key : ∀ m' : (I.val.obj X : Type _), ℓ • m' = 0 := fun m' => by
          rw [← Nat.cast_smul_eq_nsmul ((wcEtZModRing Q ℓ).obj.obj X) ℓ m', hR X, zero_smul]
        simp only [NatTrans.app_nsmul, NatTrans.id_app, NatTrans.app_zero, AddCommGrpCat.hom_nsmul,
          AddCommGrpCat.hom_id, AddCommGrpCat.hom_zero, AddMonoidHom.nsmul_apply,
          AddMonoidHom.id_apply, AddMonoidHom.zero_apply]
        exact key m
      let E := Injective.under (Φ.obj I)
      let ι := Injective.ι (Φ.obj I)
      have hιn : ι ≫ (ℓ • 𝟙 E) = 0 := by
        have h1 : ℓ • ι = (ℓ • 𝟙 (Φ.obj I)) ≫ ι := by
          rw [Preadditive.nsmul_comp, Category.id_comp]
        rw [Preadditive.comp_nsmul, Category.comp_id, h1, hI0, Limits.zero_comp]
      let j := Limits.kernel.lift (ℓ • 𝟙 E) ι hιn
      have hj : j ≫ Limits.kernel.ι (ℓ • 𝟙 E) = ι := Limits.kernel.lift_ι _ _ _
      have : Mono j := mono_of_mono_fac hj
      have hK0 : ℓ • 𝟙 (Limits.kernel (ℓ • 𝟙 E)) = 0 := by
        apply (cancel_mono (Limits.kernel.ι (ℓ • 𝟙 E))).1
        have h1 : Limits.kernel.ι (ℓ • 𝟙 E) ≫ (ℓ • 𝟙 E) = ℓ • Limits.kernel.ι (ℓ • 𝟙 E) := by
          rw [Preadditive.comp_nsmul, Category.comp_id]
        rw [Preadditive.nsmul_comp, Category.id_comp, ← h1, Limits.kernel.condition, Limits.zero_comp]
      obtain ⟨M', ⟨β⟩⟩ := hess _ hK0
      let g := Φ.preimage (j ≫ β.inv)
      have hg : Φ.map g = j ≫ β.inv := Φ.map_preimage _
      have : Mono g := Φ.mono_of_mono_map (by rw [hg]; infer_instance)
      let rr := Injective.factorThru (𝟙 I) g
      have hr : g ≫ rr = 𝟙 I := Injective.comp_factorThru _ _
      let ρ := β.inv ≫ Φ.map rr
      have hjρ : j ≫ ρ = 𝟙 _ := by
        calc j ≫ ρ = (j ≫ β.inv) ≫ Φ.map rr := by simp only [ρ, Category.assoc]
          _ = Φ.map (g ≫ rr) := by rw [Φ.map_comp, hg]
          _ = 𝟙 _ := by rw [hr, Φ.map_id]
      have hEinj : Injective ((wcEtPush r).obj E) := by
        obtain ⟨L, ⟨adj⟩, hL, _⟩ := wc_et_push_left_adjoint r
        haveI := hL
        exact adj.map_injective E inferInstance
      haveI := hEinj
      have hepi : Epi ((wcEtPush r).map (ℓ • 𝟙 E)) := by
        rw [CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id]
        exact s1 T _
      have hK := hker E hepi k
      rw [Limits.IsZero.iff_id_eq_zero]
      calc 𝟙 _ = ((wcEtPush r).rightDerived (k + 1)).map (𝟙 (Φ.obj I)) :=
            (CategoryTheory.Functor.map_id _ _).symm
        _ = ((wcEtPush r).rightDerived (k + 1)).map j ≫
              ((wcEtPush r).rightDerived (k + 1)).map ρ := by
            rw [← hjρ, CategoryTheory.Functor.map_comp]
        _ = 0 := by
            rw [hK.eq_of_tgt (((wcEtPush r).rightDerived (k + 1)).map j) 0, Limits.zero_comp]
    obtain ⟨βc⟩ := wc_et_toSheaf_pushforward_iso r ℓ D
    have hiso := wc_rightDerived_exact_conj_iso
      (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange r) _ _ D.cont D.φ) (wcEtPush r)
      (SheafOfModules.toSheaf (wcEtZModRing Q ℓ)) (SheafOfModules.toSheaf (wcEtZModRing T ℓ))
      ⟨βc⟩ hacyc
    obtain ⟨Θ⟩ := hiso (SheafOfModules.unit (wcEtZModRing Q ℓ)) n
    obtain ⟨e⟩ := wc_et_zmod_unit_toSheaf_iso Q ℓ
    exact ⟨(SheafOfModules.toSheaf (wcEtZModRing T ℓ)).mapIso
        (I.isoRightDerivedObj
          (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange r) _ _ D.cont D.φ) n).symm ≪≫
      Θ.symm ≪≫ ((wcEtPush r).rightDerived n).mapIso e ≪≫ J.isoRightDerivedObj (wcEtPush r) n⟩

  intro A _ Y f m hm Ω _ _ z D I x q hM
  haveI : EnoughInjectives (Sheaf (Scheme.smallEtaleTopology (Limits.pullback f z)) AddCommGrpCat.{u+1}) :=
    wc_et_enough_injectives (Limits.pullback f z)
  let J := InjectiveResolution.of ((constantSheaf (Scheme.smallEtaleTopology (Limits.pullback f z))
    AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))
  obtain ⟨θ⟩ := L3 (Limits.pullback.fst f z) m hm D I J q

  haveI hhaff : IsAffineHom (Limits.pullback.fst f z) :=
    MorphismProperty.of_isPullback (P := @IsAffineHom)
      (IsPullback.of_hasPullback f z).flip inferInstance
  obtain ⟨B, _, _, _, Λ, _, _, W', φ, a, e, hinit, haff, hφ, hφa, hlim, he, hcomp⟩ :=
    wc_et_geom_strict_henselization x
  have hd : wcHalShData x B Λ W' φ a := ⟨hinit, haff, hφ, hφa, hlim, e, he, hcomp⟩
  obtain ⟨E₁⟩ := wc_et_stalk_push_homology (Limits.pullback.fst f z) x Λ W' hinit J.cocomplex q
  obtain ⟨E₂⟩ := wc_et_limit_push_homology_affine (Limits.pullback.fst f z) B Λ
    (W' ⋙ StructuredArrow.proj (Over.mk (wcEtGeomPt Y x)) (Scheme.Etale.forget Y))
    φ a haff hφ hφa hlim m J q
  obtain ⟨E₃⟩ := wc_et_coh_iso_invariance
    ((Limits.pullbackSymmetry (Limits.pullback.fst f z) a).hom ≫
      (Limits.pullbackRightPullbackFstIso f z a).hom) m q
  haveI := hM B Λ W' φ a hd
  haveI hS : Subsingleton ((wcEtStalk Y x).obj ((((wcEtPush (Limits.pullback.fst f z)).mapHomologicalComplex
      (ComplexShape.up ℕ)).obj J.cocomplex).homology q)) :=
    (E₁.trans (E₂.trans E₃.symm)).subsingleton

  let ψ := (wcEtStalk Y x).mapIso θ
  exact (Equiv.ofBijective (⇑ψ.hom) (ConcreteCategory.bijective_of_isIso ψ.hom)).subsingleton

theorem wc_smooth_open_shens_milnor_fibre_acyclic : ∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (Y : Scheme.{u}) (f : Y ⟶ Spec (.of A)) (U : Y.Opens), Smooth (U.ι ≫ f) → ∀ (m : ℕ), IsUnit (m : A) → ∀ (x : Y), x ∈ U → f x = IsLocalRing.closedPoint A → ∀ (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt Y x)) (Scheme.Etale.forget Y)) (φ : ∀ l, Spec (.of B) ⟶ (W'.obj l).right.left) (a : Spec (.of B) ⟶ Y), wcHalShData x B Λ W' φ a → ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (z : Spec (.of Ω) ⟶ Spec (.of A)), Nat.card (wcEtCoh (Limits.pullback (a ≫ f) z) m 0) = m ∧ ∀ q : ℕ, 1 ≤ q → Subsingleton (wcEtCoh (Limits.pullback (a ≫ f) z) m q) :=
by
  intro A _ _ _ Y f U hsm m hmu x hxU hx B _ _ _ Λ _ _ W' φ a hB Ω _ _ z
  let x' : U.toScheme := ⟨x, hxU⟩
  have hx'1 : U.ι x' = x := by
    first
    | rfl
    | exact Scheme.Opens.ι_apply U x'
    | simp [x']
  have hx'cl : (U.ι ≫ f) x' = IsLocalRing.closedPoint A := by
    rw [Scheme.Hom.comp_apply, hx'1, hx]
  obtain ⟨B₁, _, _, _, Λ₁, _, _, W₁, φ₁, a₁, e₁, hinit, haff, hφ, hφa, hlim, heint, hpt⟩ :=
    wc_et_geom_strict_henselization x'
  have hB₁ : wcHalShData x' B₁ Λ₁ W₁ φ₁ a₁ := by
    first
    | exact ⟨hinit, haff, hφ, hφa, hlim, e₁, heint, hpt⟩
    | exact ⟨hinit, haff, hφ, hφa, hlim, ⟨e₁, heint, hpt⟩⟩
    | exact ⟨hinit, haff, @hφ, hφa, hlim, e₁, heint, hpt⟩
  have hU := wc_smooth_shens_milnor_fibre_acyclic A U.toScheme (U.ι ≫ f) hsm m hmu x' hx'cl
    B₁ Λ₁ W₁ φ₁ a₁ hB₁ Ω z
  obtain ⟨ι, hι⟩ := wc_etale_geom_point_residue_iso U.ι x' x hx'1
  obtain ⟨θ, hθ⟩ := wc_shdata_etale_iso U.ι x' x ι hι B₁ Λ₁ W₁ φ₁ a₁ hB₁ B Λ W' φ a hB
  have eq₁ : (a₁ ≫ U.ι ≫ f) ≫ 𝟙 _ = θ.hom ≫ a ≫ f := by
    rw [Category.comp_id, ← Category.assoc θ.hom, hθ, Category.assoc]
  have eq₂ : z ≫ 𝟙 _ = 𝟙 _ ≫ z := by simp
  haveI hc : IsIso (Limits.pullback.map (a₁ ≫ U.ι ≫ f) z (a ≫ f) z θ.hom (𝟙 _) (𝟙 _) eq₁ eq₂) :=
    Limits.pullback.map_isIso _ _ _ _ _ _ _ eq₁ eq₂
  have E : ∀ q : ℕ, Nonempty (wcEtCoh (Limits.pullback (a ≫ f) z) m q ≃
      wcEtCoh (Limits.pullback (a₁ ≫ U.ι ≫ f) z) m q) := fun q =>
    wc_et_coh_iso_invariance
      (Limits.pullback.map (a₁ ≫ U.ι ≫ f) z (a ≫ f) z θ.hom (𝟙 _) (𝟙 _) eq₁ eq₂) m q
  refine ⟨?_, ?_⟩
  · obtain ⟨E0⟩ := E 0
    exact (Nat.card_congr E0).trans hU.1
  · intro q hq
    obtain ⟨Eq⟩ := E q
    haveI := hU.2 q hq
    exact Eq.subsingleton

theorem wc_morse_p1_rational_chart : ∀ (K : Type u) [Field K] (s : Spec (.of K) ⟶ (wcP1Over K).left), s ≫ (wcP1Over K).hom = 𝟙 _ → ∃ (j : Spec (.of (Polynomial K)) ⟶ (wcP1Over K).left) (β : K), IsOpenImmersion j ∧ j ≫ (wcP1Over K).hom = Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))) ∧ Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom β)) ≫ j = s :=
by
  intro K _ s hs
  classical
  letI : GradedRing (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) :=
    MvPolynomial.gradedAlgebra

  have scaling : ∀ (T : Type u) [CommRing T] (ν ι : MvPolynomial (Fin (1 + 1)) K →+* T) (t : T),
      (∀ c : K, ν (MvPolynomial.C c) = ι (MvPolynomial.C c)) →
      (∀ k, ν (MvPolynomial.X k) * t = ι (MvPolynomial.X k)) →
      ∀ (n : ℕ) (a : MvPolynomial (Fin (1 + 1)) K), a.IsHomogeneous n → ν a * t ^ n = ι a := by
    intro T _ ν ι t hC hXk n a ha
    conv_rhs => rw [a.as_sum]
    conv_lhs => rw [a.as_sum]
    rw [map_sum, map_sum, Finset.sum_mul]
    refine Finset.sum_congr rfl (fun m hm => ?_)
    have hdeg : ∑ k ∈ m.support, m k = n := by
      have := ha (MvPolynomial.mem_support_iff.mp hm)
      simpa [Finsupp.weight_apply, Finsupp.sum] using this
    rw [MvPolynomial.monomial_eq, map_mul, map_mul, Finsupp.prod, map_prod, map_prod, ← hdeg,
      ← Finset.prod_pow_eq_pow_sum, mul_assoc, ← Finset.prod_mul_distrib, hC]
    congr 1
    refine Finset.prod_congr rfl (fun k _ => ?_)
    rw [map_pow, map_pow, ← mul_pow, hXk]
  have hX : ∀ k : Fin (1 + 1), (MvPolynomial.X k : MvPolynomial (Fin (1 + 1)) K) ∈
      MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K 1 :=
    fun k => (MvPolynomial.mem_homogeneousSubmodule _ _).mpr (MvPolynomial.isHomogeneous_X K k)

  have chart : ∀ i : Fin (1 + 1), ∃ e : MvPolynomial (Fin 1) K ≃+* HomogeneousLocalization.Away
        (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) (MvPolynomial.X i),
      ∀ c : K, e (MvPolynomial.C c) =
        HomogeneousLocalization.fromZeroRingHom (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K)
          (Submonoid.powers (MvPolynomial.X i))
          (algebraMap K (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K 0) c) := by
    intro i
    let κ := (HomogeneousLocalization.fromZeroRingHom
      (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) (Submonoid.powers (MvPolynomial.X i))).comp
        (algebraMap K (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K 0))
    have h1 : ∀ j : Fin 1, (MvPolynomial.X (i.succAbove j) : MvPolynomial (Fin (1 + 1)) K) ∈
        MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K (1 • 1) := fun j => by
      rw [smul_eq_mul, mul_one]; exact hX _
    let y : Fin 1 → HomogeneousLocalization.Away
        (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) (MvPolynomial.X i) := fun j =>
      HomogeneousLocalization.Away.mk _ (hX i) 1 (MvPolynomial.X (i.succAbove j)) (h1 j)
    let φ := MvPolynomial.eval₂Hom κ y
    let δ : MvPolynomial (Fin (1 + 1)) K →ₐ[K] MvPolynomial (Fin 1) K :=
      MvPolynomial.aeval (Fin.insertNth i (1 : MvPolynomial (Fin 1) K) MvPolynomial.X)
    have hδi : δ (MvPolynomial.X i) = 1 := by
      simp only [δ, MvPolynomial.aeval_X, Fin.insertNth_apply_same]
    have hδs : ∀ j, δ (MvPolynomial.X (i.succAbove j)) = MvPolynomial.X j := by
      intro j; simp only [δ, MvPolynomial.aeval_X, Fin.insertNth_apply_succAbove]
    have hδC : ∀ c, δ (MvPolynomial.C c) = MvPolynomial.C c := by
      intro c; simp only [δ, MvPolynomial.aeval_C, MvPolynomial.algebraMap_eq]
    let L := Localization (Submonoid.powers (MvPolynomial.X i : MvPolynomial (Fin (1 + 1)) K))
    have hu : IsUnit (δ.toRingHom (MvPolynomial.X i)) := by
      show IsUnit (δ (MvPolynomial.X i))
      rw [hδi]; exact isUnit_one
    let Λ : L →+* MvPolynomial (Fin 1) K := IsLocalization.Away.lift (MvPolynomial.X i) hu
    have hΛ : ∀ a, Λ (algebraMap _ L a) = δ a := fun a => IsLocalization.Away.lift_eq _ hu a
    let ψ : HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K)
        (MvPolynomial.X i) →+* MvPolynomial (Fin 1) K := Λ.comp (algebraMap _ L)
    have hF : ∀ (n : ℕ) (a : MvPolynomial (Fin (1 + 1)) K)
        (ha : a ∈ MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K (n • 1)),
        ψ (HomogeneousLocalization.Away.mk _ (hX i) n a ha) = δ a := by
      intro n a ha
      have hs := IsLocalization.mk'_spec L a
        (⟨MvPolynomial.X i ^ n, n, rfl⟩ : Submonoid.powers (MvPolynomial.X i))
      have h2 := congrArg Λ hs
      rw [map_mul, hΛ, hΛ] at h2
      change Λ _ * δ (MvPolynomial.X i ^ n) = δ a at h2
      rw [map_pow, hδi, one_pow, mul_one] at h2
      show Λ (algebraMap _ L _) = _
      rw [HomogeneousLocalization.algebraMap_apply, HomogeneousLocalization.Away.val_mk,
        Localization.mk_eq_mk'_apply]
      exact h2
    have hC0 : ∀ c : K, (MvPolynomial.C c : MvPolynomial (Fin (1 + 1)) K) ∈
        MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K (0 • 1) := fun c => by
      rw [zero_smul]
      exact (MvPolynomial.mem_homogeneousSubmodule _ _).mpr (MvPolynomial.isHomogeneous_C _ c)
    have hκ : ∀ c, κ c = HomogeneousLocalization.Away.mk _ (hX i) 0 (MvPolynomial.C c) (hC0 c) := by
      intro c
      apply HomogeneousLocalization.val_injective
      rw [HomogeneousLocalization.Away.val_mk]
      change (HomogeneousLocalization.mk
          ⟨0, algebraMap K _ c, 1, by rw [SetLike.GradeZero.coe_one]; exact Submonoid.one_mem _⟩ :
            HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K)
              (MvPolynomial.X i)).val = _
      rw [HomogeneousLocalization.val_mk]
      congr 1
    have hψφ : ψ.comp φ = RingHom.id _ := by
      apply MvPolynomial.ringHom_ext
      · intro c
        rw [RingHom.comp_apply, RingHom.id_apply]
        show ψ (MvPolynomial.eval₂Hom κ y (MvPolynomial.C c)) = _
        rw [MvPolynomial.eval₂Hom_C, hκ, hF, hδC]
      · intro j
        rw [RingHom.comp_apply, RingHom.id_apply]
        show ψ (MvPolynomial.eval₂Hom κ y (MvPolynomial.X j)) = _
        rw [MvPolynomial.eval₂Hom_X', hF, hδs]
    have hφψ : φ.comp ψ = RingHom.id _ := by
      refine RingHom.ext fun x => ?_
      obtain ⟨n, a, ha, rfl⟩ := HomogeneousLocalization.Away.mk_surjective _ (hX i) x
      rw [RingHom.comp_apply, RingHom.id_apply, hF]
      apply HomogeneousLocalization.val_injective
      rw [HomogeneousLocalization.Away.val_mk, Localization.mk_eq_mk'_apply, eq_comm,
        IsLocalization.mk'_eq_iff_eq_mul]
      have hahom : a.IsHomogeneous n := by
        rw [smul_eq_mul, mul_one] at ha
        exact (MvPolynomial.mem_homogeneousSubmodule _ _).mp ha
      have key := scaling L
        ((algebraMap (HomogeneousLocalization.Away
          (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) (MvPolynomial.X i)) L).comp
            (φ.comp δ.toRingHom))
        (algebraMap (MvPolynomial (Fin (1 + 1)) K) L)
        (algebraMap (MvPolynomial (Fin (1 + 1)) K) L (MvPolynomial.X i)) ?_ ?_ n a hahom
      · rw [← key, RingHom.comp_apply, RingHom.comp_apply, HomogeneousLocalization.algebraMap_apply]
        congr 1
        exact (map_pow _ _ _).symm
      · intro c
        show algebraMap _ L (φ (δ (MvPolynomial.C c))) = _
        rw [hδC]
        show algebraMap _ L (MvPolynomial.eval₂Hom κ y (MvPolynomial.C c)) = _
        rw [MvPolynomial.eval₂Hom_C, hκ, HomogeneousLocalization.algebraMap_apply,
          HomogeneousLocalization.Away.val_mk, Localization.mk_eq_mk'_apply,
          IsLocalization.mk'_eq_iff_eq_mul]
        show _ = _ * algebraMap (MvPolynomial (Fin (1 + 1)) K) L (MvPolynomial.X i ^ 0)
        rw [pow_zero, map_one, mul_one]
      · intro k
        obtain h | ⟨j, h⟩ := Fin.eq_self_or_eq_succAbove i k
        · rw [h]
          show algebraMap _ L (φ (δ (MvPolynomial.X i))) * _ = _
          rw [hδi, map_one, map_one, one_mul]
        · rw [h]
          show algebraMap _ L (φ (δ (MvPolynomial.X (i.succAbove j)))) * _ = _
          rw [hδs]
          show algebraMap _ L (MvPolynomial.eval₂Hom κ y (MvPolynomial.X j)) * _ = _
          rw [MvPolynomial.eval₂Hom_X', HomogeneousLocalization.algebraMap_apply,
            HomogeneousLocalization.Away.val_mk, Localization.mk_eq_mk'_apply]
          have hs := IsLocalization.mk'_spec L
            (MvPolynomial.X (i.succAbove j) : MvPolynomial (Fin (1 + 1)) K)
            (⟨MvPolynomial.X i ^ 1, 1, rfl⟩ : Submonoid.powers (MvPolynomial.X i))
          rw [← hs]
          congr 1
          show _ = algebraMap (MvPolynomial (Fin (1 + 1)) K) L (MvPolynomial.X i ^ 1)
          rw [pow_one]
    exact ⟨RingEquiv.ofRingHom φ ψ hφψ hψφ, fun c => MvPolynomial.eval₂Hom_C _ _ _⟩

  have hcover : ∀ x : (wcP1Over K).left, ∃ i : Fin (1 + 1),
      x ∈ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) (MvPolynomial.X i) := by
    intro x
    have htop := Proj.iSup_basicOpen_eq_top (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K)
      (fun i : Fin (1 + 1) => (MvPolynomial.X i : MvPolynomial (Fin (1 + 1)) K)) ?_
    · have hx : x ∈ (⊤ : (Proj (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K)).Opens) :=
        trivial
      rw [← htop] at hx
      exact TopologicalSpace.Opens.mem_iSup.mp hx
    · intro a ha
      have ha' := (HomogeneousIdeal.mem_irrelevant_iff _ a).mp ha
      rw [GradedRing.proj_apply] at ha'
      have h3 : MvPolynomial.homogeneousComponent 0 a = 0 := by
        rw [← MvPolynomial.decomposition.decompose'_apply]; exact ha'
      rw [MvPolynomial.homogeneousComponent_zero, MvPolynomial.C_eq_zero] at h3
      rw [← Set.image_univ, MvPolynomial.mem_ideal_span_X_image]
      intro m hm
      have hm0 : m ≠ 0 := by
        rintro rfl
        exact (MvPolynomial.mem_support_iff.mp hm) h3
      obtain ⟨k, hk⟩ := Finsupp.ne_iff.mp hm0
      exact ⟨k, Set.mem_univ _, hk⟩

  have chartj : ∃ j : Spec (.of (Polynomial K)) ⟶ (wcP1Over K).left, IsOpenImmersion j ∧
      j ≫ (wcP1Over K).hom = Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))) ∧
      s (IsLocalRing.closedPoint K) ∈ Set.range j := by
    obtain ⟨i, hi⟩ := hcover (s (IsLocalRing.closedPoint K))
    obtain ⟨e, he⟩ := chart i
    let e' : HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K)
        (MvPolynomial.X i) ≃+* Polynomial K :=
      e.symm.trans (MvPolynomial.uniqueAlgEquiv K (Fin 1)).toRingEquiv
    refine ⟨Spec.map e'.toCommRingCatIso.hom ≫
      Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) (MvPolynomial.X i) (hX i)
        one_pos, inferInstance, ?_, ?_⟩
    · change (Spec.map e'.toCommRingCatIso.hom ≫
        Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) (MvPolynomial.X i) (hX i)
          one_pos) ≫ (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) ≫
          Spec.map (CommRingCat.ofHom
            (algebraMap K (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K 0)))) = _
      rw [Category.assoc, ← Category.assoc (Proj.awayι _ _ _ _), Proj.awayι_toSpecZero,
        ← Spec.map_comp, ← Spec.map_comp]
      congr 1
      apply CommRingCat.hom_ext
      apply RingHom.ext
      intro c
      show e' (HomogeneousLocalization.fromZeroRingHom _ _ (algebraMap K _ c)) =
        algebraMap K (Polynomial K) c
      rw [← he c]
      show (MvPolynomial.uniqueAlgEquiv K (Fin 1)) (e.symm (e (MvPolynomial.C c))) = _
      rw [e.symm_apply_apply, ← MvPolynomial.algebraMap_eq, AlgEquiv.commutes]
    · rw [← Scheme.Hom.coe_opensRange, Scheme.Hom.opensRange_comp_of_isIso,
        Proj.opensRange_awayι]
      exact hi
  obtain ⟨j, hj, hjK, hjr⟩ := chartj
  haveI := hj
  have hsub : Set.range s ⊆ Set.range j := by
    rintro _ ⟨p, rfl⟩
    rw [Subsingleton.elim p (IsLocalRing.closedPoint K)]
    exact hjr
  obtain ⟨s', hs'⟩ : ∃ s' : Spec (.of K) ⟶ Spec (.of (Polynomial K)), s' ≫ j = s :=
    ⟨_, IsOpenImmersion.lift_fac j s hsub⟩
  obtain ⟨ψ, hψ⟩ : ∃ ψ : CommRingCat.of (Polynomial K) ⟶ CommRingCat.of K, Spec.map ψ = s' :=
    ⟨_, Spec.map_preimage s'⟩
  have hψC : CommRingCat.ofHom (algebraMap K (Polynomial K)) ≫ ψ = 𝟙 _ := by
    apply Spec.map_injective
    rw [Spec.map_comp, hψ, Spec.map_id, ← hjK, ← Category.assoc, hs', hs]
  have hψC' : ∀ c : K, ψ.hom (Polynomial.C c) = c := by
    intro c
    have h1 := congrArg (fun f => f.hom c) hψC
    simpa [Polynomial.algebraMap_eq] using h1
  have hψe : ψ = CommRingCat.ofHom (Polynomial.evalRingHom (ψ.hom Polynomial.X)) := by
    apply CommRingCat.hom_ext
    apply Polynomial.ringHom_ext
    · intro c
      rw [hψC' c]
      simp
    · simp
  refine ⟨j, ψ.hom Polynomial.X, hj, hjK, ?_⟩
  rw [← hψe, hψ, hs']

theorem wc_morse_chart_closed_point_comap : ∀ (K : Type u) [Field K] (j : Spec (.of (Polynomial K)) ⟶ (wcP1Over K).left) (β : K), IsOpenImmersion j → ∀ (y : (wcP1Over K).left), y = j (Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom β)) (IsLocalRing.closedPoint K)) → ∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (wcP1Over K).left y)) (Scheme.Etale.forget (wcP1Over K).left)) (φ : ∀ l, Spec (.of A) ⟶ (W'.obj l).right.left) (a : Spec (.of A) ⟶ (wcP1Over K).left), wcHalShData y A Λ W' φ a → ∀ (aV : Spec (.of A) ⟶ Spec (.of (Polynomial K))), aV ≫ j = a → Ideal.comap (Spec.preimage aV).hom (IsLocalRing.maximalIdeal A) = Ideal.span {Polynomial.X - Polynomial.C β} :=
by
  intro K _ j β hj y hy A _ _ _ Λ _ _ W' φ a hA aV haV
  haveI := hj
  have comp_ap : ∀ {X Y Z : Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ Z) (x : X), (f ≫ g) x = g (f x) :=
    fun _ _ _ => rfl
  have hγ : ∀ (x : Spec (.of (AlgebraicClosure ((wcP1Over K).left.residueField y)))),
      wcEtGeomPt (wcP1Over K).left y x = y := by
    intro x
    first
    | exact Scheme.fromSpecResidueField_apply y _
    | (unfold wcEtGeomPt; rw [comp_ap]; exact Scheme.fromSpecResidueField_apply y _)
    | (simp only [wcEtGeomPt, comp_ap, Scheme.fromSpecResidueField_apply])
    | (simp [wcEtGeomPt])
  obtain ⟨-, -, -, -, -, e, -, he⟩ := hA
  have hres : ∀ z, (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A))) z =
      IsLocalRing.closedPoint A :=
    fun z => IsLocalRing.PrimeSpectrum.comap_residue A z
  have ha_cl : a (IsLocalRing.closedPoint A) = y := by
    have h1 := congrArg (fun f => f (IsLocalRing.closedPoint
      (AlgebraicClosure ((wcP1Over K).left.residueField y)))) he
    have h1' := (Scheme.Hom.comp_apply _ _ _).symm.trans
      ((Scheme.Hom.comp_apply _ _ _).symm.trans (h1.trans (hγ _)))
    rw [hres] at h1'
    exact h1'
  obtain ⟨ρ₀, rfl⟩ : ∃ ρ₀ : CommRingCat.of (Polynomial K) ⟶ CommRingCat.of A,
      Spec.map ρ₀ = aV := ⟨_, Spec.map_preimage aV⟩
  have hj_eq : j (Spec.map ρ₀ (IsLocalRing.closedPoint A)) =
      j (Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom β)) (IsLocalRing.closedPoint K)) := by
    calc j (Spec.map ρ₀ (IsLocalRing.closedPoint A))
        = (Spec.map ρ₀ ≫ j) (IsLocalRing.closedPoint A) := rfl
      _ = a (IsLocalRing.closedPoint A) := by rw [haV]
      _ = y := ha_cl
      _ = j (Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom β))
            (IsLocalRing.closedPoint K)) := hy
  have hinj := j.isOpenEmbedding.injective hj_eq
  rw [Spec.preimage_map]
  have h1 : Ideal.comap ρ₀.hom (IsLocalRing.maximalIdeal A) =
      (Spec.map ρ₀ (IsLocalRing.closedPoint A)).asIdeal := rfl
  have h2 : (Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom β))
      (IsLocalRing.closedPoint K)).asIdeal =
      Ideal.comap (Polynomial.evalRingHom β) (IsLocalRing.maximalIdeal K) := rfl
  rw [h1, hinj, h2, IsLocalRing.maximalIdeal_eq_bot, ← RingHom.ker_eq_comap_bot,
    Polynomial.ker_evalRingHom]

theorem wc_morse_chart_shdata_presentation : ∀ {Z : Scheme.{u}} (P : Type u) [CommRing P] (j : Spec (.of P) ⟶ Z), IsOpenImmersion j → ∀ (v : Spec (.of P)) (z : Z), j v = z → ∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt Z z)) (Scheme.Etale.forget Z)) (φ : ∀ l, Spec (.of A) ⟶ (W'.obj l).right.left) (a : Spec (.of A) ⟶ Z), wcHalShData z A Λ W' φ a → ∀ (aV : Spec (.of A) ⟶ Spec (.of P)), aV ≫ j = a → ∃ (I : Type u) (_ : SmallCategory I) (F : I ⥤ CommRingCat.{u}) (p : ∀ i, P →+* F.obj i) (ι : ∀ i, F.obj i →+* A), (∀ i, (p i).Etale) ∧ (∀ {i i' : I} (f : i ⟶ i'), (F.map f).hom.comp (p i) = p i') ∧ (∀ i, (ι i).comp (p i) = (Spec.preimage aV).hom) ∧ (∀ b : A, ∃ (i : I) (t : F.obj i), ι i t = b) ∧ (∀ (i : I) (t : F.obj i), ι i t = 0 → ∃ (i' : I) (f : i ⟶ i'), (F.map f).hom t = 0) :=
by
  intro Z P _ j hj v z hv A _ _ _ Λ _ _ W' φ a hA aV haV
  haveI := hj
  obtain ⟨A₁, _, _, _, Λ₁, _, _, W₁, φ₁, a₁, e₁, h1, h2, h3, h4, h5, h6, h7⟩ :=
    wc_et_geom_strict_henselization v
  have hB₁ : wcHalShData v A₁ Λ₁ W₁ φ₁ a₁ := ⟨h1, h2, h3, h4, h5, e₁, h6, h7⟩
  obtain ⟨ι₀, hι₀⟩ := wc_etale_geom_point_residue_iso j v z hv
  obtain ⟨θ, hθ⟩ := wc_shdata_etale_iso j v z ι₀ hι₀ A₁ Λ₁ W₁ φ₁ a₁ hB₁ A Λ W' φ a hA
  have hθV : θ.hom ≫ aV = a₁ := by
    rw [← cancel_mono j, Category.assoc, haV, hθ]
  obtain ⟨β₁, hβ₁, I, _, _, F, p, ι₁, hpet, hp, _, hι₁, hsurj₁, hker₁⟩ :=
    wc_shdata_filtered_etale_presentation v A₁ Λ₁ W₁ φ₁ a₁ hB₁ P (Iso.refl _)
  have hβ₁' : Spec.map (CommRingCat.ofHom β₁) = a₁ := by
    rw [hβ₁, Iso.refl_hom, Category.comp_id]
  set τ := Spec.preimage θ.hom with hτ
  set τ' := Spec.preimage θ.inv with hτ'
  have hττ' : τ ≫ τ' = 𝟙 _ := by
    apply Spec.map_injective
    rw [Spec.map_comp, hτ, hτ', Spec.map_preimage, Spec.map_preimage, Iso.inv_hom_id,
      Spec.map_id]
  have hτ'τ : τ' ≫ τ = 𝟙 _ := by
    apply Spec.map_injective
    rw [Spec.map_comp, hτ, hτ', Spec.map_preimage, Spec.map_preimage, Iso.hom_inv_id,
      Spec.map_id]
  have e1 : ∀ b : A, τ'.hom (τ.hom b) = b := by
    intro b
    have := congrArg (fun g => g.hom b) hττ'
    simpa using this
  have e2 : ∀ c : A₁, τ.hom (τ'.hom c) = c := by
    intro c
    have := congrArg (fun g => g.hom c) hτ'τ
    simpa using this
  have hτρ : τ.hom.comp (Spec.preimage aV).hom = β₁ := by
    have h : Spec.preimage aV ≫ τ = CommRingCat.ofHom β₁ := by
      apply Spec.map_injective
      rw [Spec.map_comp, hτ, Spec.map_preimage, Spec.map_preimage, hθV, hβ₁']
    have h' := congrArg CommRingCat.Hom.hom h
    rw [CommRingCat.hom_comp, CommRingCat.hom_ofHom] at h'
    exact h'
  refine ⟨I, inferInstance, F, p, fun i => τ'.hom.comp (ι₁ i), hpet, hp, ?_, ?_, ?_⟩
  · intro i
    ext x
    have hx := congrArg (fun g => g x) (hι₁ i)
    have hx' := congrArg (fun g => g x) hτρ
    simp only [RingHom.comp_apply] at hx hx' ⊢
    rw [hx, ← hx', e1]
  · intro b
    obtain ⟨i, t, ht⟩ := hsurj₁ (τ.hom b)
    refine ⟨i, t, ?_⟩
    simp only [RingHom.comp_apply]
    rw [ht, e1]
  · intro i t ht
    apply hker₁ i t
    simp only [RingHom.comp_apply] at ht
    rw [← e2 (ι₁ i t), ht, map_zero]

theorem wc_etale_poly_prime_unit_mul_pow : ∀ (K : Type u) [Field K] (β : K) (R : Type u) [CommRing R] (p : Polynomial K →+* R), p.Etale → ∀ (q : Ideal R), q.IsPrime → Ideal.comap p q = Ideal.span {Polynomial.X - Polynomial.C β} → (∀ t : R, (∃ s : R, s ∉ q ∧ s * t = 0) ∨ ∃ (s w : R) (k : ℕ), s ∉ q ∧ w ∉ q ∧ s * t = w * p (Polynomial.X - Polynomial.C β) ^ k) ∧ ∀ s : R, s ∉ q → ∀ N : ℕ, s * p (Polynomial.X - Polynomial.C β) ^ N ≠ 0 :=
by
  intro K _ β R _ p hp q hq hcomap
  haveI := hq
  letI := p.toAlgebra
  haveI : Algebra.Etale (Polynomial K) R := hp
  haveI : IsNoetherianRing R := Algebra.FiniteType.isNoetherianRing (Polynomial K) R

  have hmax : IsLocalRing.maximalIdeal (Localization.AtPrime q) =
      Ideal.span {algebraMap R (Localization.AtPrime q) (p (Polynomial.X - Polynomial.C β))} := by
    have h : Ideal.comap (algebraMap (Polynomial K) R) q =
        Ideal.span {Polynomial.X - Polynomial.C β} := hcomap
    haveI : (Ideal.span {Polynomial.X - Polynomial.C β}).IsPrime := h ▸ Ideal.comap_isPrime _ q
    haveI : q.LiesOver (Ideal.span {Polynomial.X - Polynomial.C β}) := ⟨h.symm⟩
    letI := Localization.AtPrime.algebraOfLiesOver (Ideal.span {Polynomial.X - Polynomial.C β}) q
    have e := ((Algebra.isUnramifiedAt_iff_map_eq (Polynomial K)
      (Ideal.span {Polynomial.X - Polynomial.C β}) q).mp inferInstance).2
    rw [← e, Ideal.map_span, Set.image_singleton,
      IsScalarTower.algebraMap_apply (Polynomial K) R (Localization.AtPrime q)]
    rfl

  have hpow : ∀ n : ℕ,
      algebraMap R (Localization.AtPrime q) (p (Polynomial.X - Polynomial.C β)) ^ n ≠ 0 := by
    intro n h0
    haveI : Module.Flat (Polynomial K) (Localization.AtPrime q) :=
      Module.Flat.trans (Polynomial K) R (Localization.AtPrime q)
    have hγn : (Polynomial.X - Polynomial.C β) ^ n ≠ 0 :=
      pow_ne_zero n (Polynomial.X_sub_C_ne_zero β)
    have hreg : IsSMulRegular (Localization.AtPrime q) ((Polynomial.X - Polynomial.C β) ^ n) :=
      Module.Flat.isSMulRegular_of_nonZeroDivisors (mem_nonZeroDivisors_of_ne_zero hγn)
    have e : algebraMap R (Localization.AtPrime q) (p (Polynomial.X - Polynomial.C β)) ^ n =
        ((Polynomial.X - Polynomial.C β) ^ n) • (1 : Localization.AtPrime q) := by
      rw [← Algebra.algebraMap_eq_smul_one,
        IsScalarTower.algebraMap_apply (Polynomial K) R (Localization.AtPrime q), map_pow, map_pow]
      rfl
    rw [e] at h0
    exact one_ne_zero (hreg.right_eq_zero_of_smul h0)

  have s3 : ∀ b : Localization.AtPrime q, b ≠ 0 → ∃ (n : ℕ) (w : Localization.AtPrime q),
      IsUnit w ∧ b = w * algebraMap R (Localization.AtPrime q)
        (p (Polynomial.X - Polynomial.C β)) ^ n := by
    intro b hb
    have hex : ∃ k, b ∉ (IsLocalRing.maximalIdeal (Localization.AtPrime q)) ^ k := by
      by_contra hcon
      push_neg at hcon
      have hmem : b ∈ ⨅ i, (IsLocalRing.maximalIdeal (Localization.AtPrime q)) ^ i :=
        (Submodule.mem_iInf _).mpr hcon
      rw [Ideal.iInf_pow_eq_bot_of_isLocalRing _
        (IsLocalRing.maximalIdeal.isMaximal (Localization.AtPrime q)).ne_top] at hmem
      exact hb ((Submodule.mem_bot _).mp hmem)
    classical
    obtain ⟨k₀, hk₀, hmin⟩ : ∃ k₀, b ∉ (IsLocalRing.maximalIdeal (Localization.AtPrime q)) ^ k₀ ∧
        ∀ m < k₀, b ∈ (IsLocalRing.maximalIdeal (Localization.AtPrime q)) ^ m :=
      ⟨Nat.find hex, Nat.find_spec hex, fun m hm => not_not.mp (Nat.find_min hex hm)⟩
    have hk0 : k₀ ≠ 0 := by
      intro h
      apply hk₀
      rw [h, pow_zero, Ideal.one_eq_top]
      exact Submodule.mem_top
    obtain ⟨n, hn⟩ : ∃ n, k₀ = n + 1 := ⟨k₀ - 1, by omega⟩
    have hbn := hmin n (by omega)
    rw [hmax, Ideal.span_singleton_pow, Ideal.mem_span_singleton'] at hbn
    obtain ⟨c, hc⟩ := hbn
    refine ⟨n, c, ?_, hc.symm⟩
    by_contra hcu
    have hcm : c ∈ IsLocalRing.maximalIdeal (Localization.AtPrime q) :=
      (IsLocalRing.mem_maximalIdeal c).mpr hcu
    rw [hmax, Ideal.mem_span_singleton'] at hcm
    obtain ⟨d, hd⟩ := hcm
    apply hk₀
    rw [hn, hmax, Ideal.span_singleton_pow, Ideal.mem_span_singleton']
    exact ⟨d, by rw [← hc, ← hd, pow_succ]; ring⟩
  refine ⟨fun t => ?_, fun s hs N h0 => ?_⟩
  · by_cases hb : algebraMap R (Localization.AtPrime q) t = 0
    · left
      obtain ⟨m, hm⟩ := (IsLocalization.map_eq_zero_iff q.primeCompl (Localization.AtPrime q) t).mp hb
      exact ⟨m, m.2, hm⟩
    · right
      obtain ⟨n, w, hw, hbw⟩ := s3 _ hb
      obtain ⟨⟨w₀, s₀⟩, hws⟩ := IsLocalization.mk'_surjective q.primeCompl w
      simp only at hws
      have hw₀ : w₀ ∈ q.primeCompl :=
        (IsLocalization.AtPrime.isUnit_mk'_iff (Localization.AtPrime q) q w₀ s₀).mp (hws ▸ hw)
      have e1 : algebraMap R (Localization.AtPrime q) (s₀ * t) =
          algebraMap R (Localization.AtPrime q) (w₀ * p (Polynomial.X - Polynomial.C β) ^ n) := by
        rw [map_mul, map_mul, map_pow, hbw, ← hws, ← mul_assoc, IsLocalization.mk'_spec']
      obtain ⟨c, hc⟩ := (IsLocalization.eq_iff_exists q.primeCompl (Localization.AtPrime q)).mp e1
      refine ⟨c * s₀, c * w₀, n, hq.mul_notMem c.2 s₀.2, hq.mul_notMem c.2 hw₀, ?_⟩
      calc ((c : R) * s₀) * t = c * (s₀ * t) := by ring
        _ = c * (w₀ * p (Polynomial.X - Polynomial.C β) ^ n) := hc
        _ = _ := by ring
  · have h1 : algebraMap R (Localization.AtPrime q) s *
        algebraMap R (Localization.AtPrime q) (p (Polynomial.X - Polynomial.C β)) ^ N = 0 := by
      rw [← map_pow, ← map_mul, h0, map_zero]
    have hu : IsUnit (algebraMap R (Localization.AtPrime q) s) :=
      IsLocalization.map_units (Localization.AtPrime q) (⟨s, hs⟩ : q.primeCompl)
    exact hpow N (hu.mul_right_eq_zero.mp h1)

theorem wc_filtered_unit_mul_pow_dvr : ∀ (K : Type u) [Field K] (β : K) (B : Type u) [CommRing B] [IsLocalRing B] (ρ : Polynomial K →+* B), Ideal.comap ρ (IsLocalRing.maximalIdeal B) = Ideal.span {Polynomial.X - Polynomial.C β} → ∀ (I : Type u) [SmallCategory I] (F : I ⥤ CommRingCat.{u}) (p : ∀ i, Polynomial K →+* F.obj i) (ι : ∀ i, F.obj i →+* B), (∀ (i : I) (q : Ideal (F.obj i)), q.IsPrime → Ideal.comap (p i) q = Ideal.span {Polynomial.X - Polynomial.C β} → (∀ t : F.obj i, (∃ s : F.obj i, s ∉ q ∧ s * t = 0) ∨ ∃ (s w : F.obj i) (k : ℕ), s ∉ q ∧ w ∉ q ∧ s * t = w * p i (Polynomial.X - Polynomial.C β) ^ k) ∧ ∀ s : F.obj i, s ∉ q → ∀ N : ℕ, s * p i (Polynomial.X - Polynomial.C β) ^ N ≠ 0) → (∀ {i i' : I} (f : i ⟶ i'), (F.map f).hom.comp (p i) = p i') → (∀ i, (ι i).comp (p i) = ρ) → (∀ b : B, ∃ (i : I) (t : F.obj i), ι i t = b) → (∀ (i : I) (t : F.obj i), ι i t = 0 → ∃ (i' : I) (f : i ⟶ i'), (F.map f).hom t = 0) → ∃ (_ : IsDomain B), IsDiscreteValuationRing B ∧ IsLocalRing.maximalIdeal B = Ideal.span {ρ (Polynomial.X - Polynomial.C β)} :=
by
  intro K _ β B _ _ ρ hm I _ F p ι hloc hp hι hsurj hker
  set γ : Polynomial K := Polynomial.X - Polynomial.C β with hγ
  set π : B := ρ γ with hπdef
  have hq : ∀ i, (Ideal.comap (ι i) (IsLocalRing.maximalIdeal B)).IsPrime :=
    fun i => Ideal.comap_isPrime _ _
  have hqc : ∀ i, Ideal.comap (p i) (Ideal.comap (ι i) (IsLocalRing.maximalIdeal B)) =
      Ideal.span {γ} := by
    intro i
    rw [Ideal.comap_comap, hι i, hm]
  have hunit : ∀ i (s : F.obj i), s ∉ Ideal.comap (ι i) (IsLocalRing.maximalIdeal B) →
      IsUnit (ι i s) := by
    intro i s hs
    rw [Ideal.mem_comap] at hs
    exact IsLocalRing.notMem_maximalIdeal.mp hs
  have hpi : ∀ i, ι i (p i γ) = π := by
    intro i
    have h := RingHom.congr_fun (hι i) γ
    rwa [RingHom.comp_apply] at h
  have hπm : π ∈ IsLocalRing.maximalIdeal B := by
    have h : γ ∈ Ideal.comap ρ (IsLocalRing.maximalIdeal B) := by
      rw [hm]; exact Ideal.mem_span_singleton_self γ
    exact Ideal.mem_comap.mp h
  have hfac : ∀ b : B, b = 0 ∨ ∃ (u : Bˣ) (k : ℕ), b = ↑u * π ^ k := by
    intro b
    obtain ⟨i, t, rfl⟩ := hsurj b
    rcases (hloc i _ (hq i) (hqc i)).1 t with ⟨s, hs, hst⟩ | ⟨s, w, k, hs, hw, hst⟩
    · left
      have h1 : ι i s * ι i t = 0 := by rw [← map_mul, hst, map_zero]
      exact (hunit i s hs).mul_right_eq_zero.mp h1
    · right
      have h1 : ι i s * ι i t = ι i w * π ^ k := by
        rw [← map_mul, hst, map_mul, map_pow, hpi]
      obtain ⟨us, hus⟩ := hunit i s hs
      obtain ⟨uw, huw⟩ := hunit i w hw
      refine ⟨us⁻¹ * uw, k, ?_⟩
      rw [← hus, ← huw] at h1
      calc ι i t = ↑us⁻¹ * (↑us * ι i t) := by rw [← mul_assoc, Units.inv_mul, one_mul]
        _ = _ := by rw [h1, Units.val_mul]; ring
  have hnil : ∀ N : ℕ, π ^ N ≠ 0 := by
    intro N hN
    obtain ⟨i₀, _, _⟩ := hsurj 1
    have h1 : ι i₀ ((p i₀ γ) ^ N) = 0 := by rw [map_pow, hpi, hN]
    obtain ⟨i', f, hf⟩ := hker i₀ _ h1
    have hpf := RingHom.congr_fun (hp f) γ
    rw [RingHom.comp_apply] at hpf
    have h2 : (p i' γ) ^ N = 0 := by
      rw [map_pow, hpf] at hf
      exact hf
    have h3 : (1 : F.obj i') ∉ Ideal.comap (ι i') (IsLocalRing.maximalIdeal B) := by
      intro h
      exact (hq i').ne_top ((Ideal.eq_top_iff_one _).mpr h)
    exact (hloc i' _ (hq i') (hqc i')).2 1 h3 N (by rw [one_mul, h2])
  have hπ0 : π ≠ 0 := by
    have h := hnil 1
    rwa [pow_one] at h
  have hπnu : ¬ IsUnit π := mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal π).mp hπm)
  haveI : NoZeroDivisors B := ⟨fun {x y} hxy => by
    rcases hfac x with hx | ⟨u, k, rfl⟩
    · exact Or.inl hx
    rcases hfac y with hy | ⟨v, l, rfl⟩
    · exact Or.inr hy
    exfalso
    have h : (↑(u * v) : B) * π ^ (k + l) = 0 := by
      rw [← hxy, Units.val_mul, pow_add]; ring
    exact hnil (k + l) ((Units.isUnit _).mul_right_eq_zero.mp h)⟩
  haveI hdom : IsDomain B := NoZeroDivisors.to_isDomain B
  have hirr : Irreducible π := by
    refine Irreducible.mk hπnu ?_
    intro a b hab
    have ha : a ≠ 0 := by rintro rfl; exact hπ0 (by rw [hab, zero_mul])
    have hb : b ≠ 0 := by rintro rfl; exact hπ0 (by rw [hab, mul_zero])
    obtain ⟨u, k, rfl⟩ := (hfac a).resolve_left ha
    obtain ⟨v, l, rfl⟩ := (hfac b).resolve_left hb
    rcases k with _ | k
    · left; simp
    rcases l with _ | l
    · right; simp
    exfalso
    have hcm : (↑u * ↑v * π ^ (k + l + 1) : B) ∈ IsLocalRing.maximalIdeal B :=
      Ideal.mul_mem_left _ _ (Ideal.pow_mem_of_mem _ hπm _ (Nat.succ_pos _))
    have h1c : IsUnit (1 - (↑u * ↑v * π ^ (k + l + 1) : B)) :=
      IsLocalRing.isUnit_one_sub_self_of_mem_nonunits _ ((IsLocalRing.mem_maximalIdeal _).mp hcm)
    have hpc : π * (1 - (↑u * ↑v * π ^ (k + l + 1) : B)) = 0 := by
      have e : π = π * (↑u * ↑v * π ^ (k + l + 1) : B) := by
        calc π = ↑u * π ^ (k + 1) * (↑v * π ^ (l + 1)) := hab
          _ = π * (↑u * ↑v * π ^ (k + l + 1) : B) := by ring
      rw [mul_sub, mul_one, ← e, sub_self]
    exact hπ0 (h1c.mul_left_eq_zero.mp hpc)
  have hdvr : IsDiscreteValuationRing B := by
    apply IsDiscreteValuationRing.ofHasUnitMulPowIrreducibleFactorization
    refine ⟨π, hirr, fun {x} hx => ?_⟩
    obtain ⟨u, n, rfl⟩ := (hfac x).resolve_left hx
    exact ⟨n, u, mul_comm _ _⟩
  exact ⟨hdom, hdvr, (IsDiscreteValuationRing.irreducible_iff_uniformizer π).mp hirr⟩

theorem wc_morse_shens_chart_dvr : ∀ (K : Type u) [Field K] (j : Spec (.of (Polynomial K)) ⟶ (wcP1Over K).left) (β : K), IsOpenImmersion j → ∀ (y : (wcP1Over K).left), y = j (Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom β)) (IsLocalRing.closedPoint K)) → ∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (wcP1Over K).left y)) (Scheme.Etale.forget (wcP1Over K).left)) (φ : ∀ l, Spec (.of A) ⟶ (W'.obj l).right.left) (a : Spec (.of A) ⟶ (wcP1Over K).left), wcHalShData y A Λ W' φ a → ∀ (aV : Spec (.of A) ⟶ Spec (.of (Polynomial K))), aV ≫ j = a → ∃ (_ : IsDomain A), IsDiscreteValuationRing A ∧ IsLocalRing.maximalIdeal A = Ideal.span {(Spec.preimage aV).hom (Polynomial.X - Polynomial.C β)} :=
by
  intro K _ j β hj y hy A _ _ _ Λ _ _ W' φ a hA aV haV
  have hm := wc_morse_chart_closed_point_comap K j β hj y hy A Λ W' φ a hA aV haV
  obtain ⟨I, _, F, p, ι, hpet, hp, hι, hsurj, hker⟩ :=
    wc_morse_chart_shdata_presentation (Polynomial K) j hj
      (Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom β)) (IsLocalRing.closedPoint K)) y
      hy.symm A Λ W' φ a hA aV haV
  exact wc_filtered_unit_mul_pow_dvr K β A (Spec.preimage aV).hom hm I F p ι
    (fun i q hq hc => wc_etale_poly_prime_unit_mul_pow K β (F.obj i) (p i) (hpet i) q hq hc)
    hp hι hsurj hker

theorem wc_morse_chart_stalk_uniformizer : ∀ (K : Type u) [Field K] {X P : Scheme.{u}} (j : Spec (.of (Polynomial K)) ⟶ P) [IsOpenImmersion j] (β : K) (f : X ⟶ P) (x : X), f x = j (Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom β)) (IsLocalRing.closedPoint K)) → ∀ (W : X.Opens) (hW : IsAffineOpen W) (hx : x ∈ W) (ρ : Polynomial K →+* Γ(X, W)), Spec.map (CommRingCat.ofHom ρ) ≫ j = hW.fromSpec ≫ f → ∀ τ : P.presheaf.stalk (f x), IsLocalRing.maximalIdeal (P.presheaf.stalk (f x)) = Ideal.span {τ} → ∃ w : X.presheaf.stalk x, IsUnit w ∧ (X.presheaf.germ W x hx).hom (ρ (Polynomial.X - Polynomial.C β)) = w * (f.stalkMap x).hom τ :=
by

  have L1 : ∀ (O : Type u) [CommRing O] [IsLocalRing O] (γ τ : O),
      Ideal.span {γ} = Ideal.span {τ} → ∃ v : O, IsUnit v ∧ γ = v * τ := by
    intro O _ _ γ τ h
    have hγ : γ ∈ Ideal.span {τ} := h ▸ Ideal.mem_span_singleton_self γ
    have hτ : τ ∈ Ideal.span {γ} := h.symm ▸ Ideal.mem_span_singleton_self τ
    obtain ⟨a, ha⟩ := Ideal.mem_span_singleton'.mp hγ
    obtain ⟨b, hb⟩ := Ideal.mem_span_singleton'.mp hτ
    by_cases hu : IsUnit a
    · exact ⟨a, hu, ha.symm⟩
    · have hba : b * a ∈ nonunits O := fun h' => hu (isUnit_of_mul_isUnit_right h')
      have h1 := IsLocalRing.isUnit_one_sub_self_of_mem_nonunits _ hba
      have hτ0 : τ = 0 := by
        have : (1 - b * a) * τ = 0 := by
          rw [sub_mul, one_mul, mul_assoc, ha, hb, sub_self]
        exact h1.mul_right_eq_zero.mp this
      refine ⟨1, isUnit_one, ?_⟩
      rw [← ha, hτ0, mul_zero, mul_zero]

  have L2 : ∀ (A B : Type u) [CommRing A] [IsLocalRing A] [CommRing B] [IsLocalRing B]
      (φ : A →+* B), Function.Bijective φ → ∀ a : A,
      IsLocalRing.maximalIdeal B = Ideal.span {φ a} →
        IsLocalRing.maximalIdeal A = Ideal.span {a} := by
    intro A B _ _ _ _ φ hφ a h
    have hmax : (Ideal.comap φ (IsLocalRing.maximalIdeal B)).IsMaximal :=
      Ideal.comap_isMaximal_of_surjective φ hφ.2
    have e1 := IsLocalRing.eq_maximalIdeal hmax
    rw [← e1, h, ← Set.image_singleton, ← Ideal.map_span, Ideal.comap_map_of_bijective φ hφ]

  have L4 : ∀ (K : Type u) [Field K] (β : K),
      (Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom β)) (IsLocalRing.closedPoint K)).asIdeal
        = Ideal.span {Polynomial.X - Polynomial.C β} := by
    intro K _ β
    show Ideal.comap (Polynomial.evalRingHom β) (IsLocalRing.maximalIdeal K) = _
    rw [IsLocalRing.maximalIdeal_eq_bot, ← RingHom.ker_eq_comap_bot, Polynomial.ker_evalRingHom]

  have L3 : ∀ (R : Type u) [CommRing R] (a : R) (z : Spec (.of R)), z.asIdeal = Ideal.span {a} →
      IsLocalRing.maximalIdeal ((Spec (.of R)).presheaf.stalk z) =
        Ideal.span {((Spec (.of R)).presheaf.germ ⊤ z trivial).hom
          ((Scheme.ΓSpecIso (.of R)).inv.hom a)} := by
    intro R _ a z hz
    haveI : z.asIdeal.IsPrime := z.isPrime
    haveI : IsLocalRing ((Spec.structureSheaf R).presheaf.stalk z) :=
      inferInstanceAs (IsLocalRing ((Spec (.of R)).presheaf.stalk z))
    letI : Algebra R ((Spec.structureSheaf R).presheaf.stalk z) := StructureSheaf.stalkAlgebra R z
    haveI : IsLocalization.AtPrime ((Spec.structureSheaf R).presheaf.stalk z) z.asIdeal :=
      StructureSheaf.IsLocalization.to_stalk R z
    have h1 := IsLocalization.AtPrime.map_eq_maximalIdeal z.asIdeal
      ((Spec.structureSheaf R).presheaf.stalk z)
    rw [hz, Ideal.map_span, Set.image_singleton] at h1
    exact h1.symm

  have L5 : ∀ {X P : Scheme.{u}} (f : X ⟶ P) (V : P.Opens) (W : X.Opens) (hle : W ≤ f ⁻¹ᵁ V)
      (x : X) (hx : x ∈ W) (hy : f x ∈ V) (t : Γ(P, V)),
      (f.stalkMap x).hom ((P.presheaf.germ V (f x) hy).hom t) =
        (X.presheaf.germ W x hx).hom ((f.appLE V W hle).hom t) := by
    intro X P f V W hle x hx hy t
    have : P.presheaf.germ V (f x) hy ≫ f.stalkMap x =
        f.appLE V W hle ≫ X.presheaf.germ W x hx := by
      rw [Scheme.Hom.germ_stalkMap, Scheme.Hom.appLE, Category.assoc, TopCat.Presheaf.germ_res]
    exact congrArg (fun φ => φ.hom t) this

  have L6 : ∀ (A : Type u) [CommRing A] {X P : Scheme.{u}} (j : Spec (.of A) ⟶ P)
      [IsOpenImmersion j] (f : X ⟶ P) (W : X.Opens) (hW : IsAffineOpen W) (ρ : A →+* Γ(X, W)),
      Spec.map (CommRingCat.ofHom ρ) ≫ j = hW.fromSpec ≫ f →
      ∃ hle : W ≤ f ⁻¹ᵁ (j ''ᵁ ⊤), ∀ r : A, (f.appLE (j ''ᵁ ⊤) W hle).hom
        ((j.appIso ⊤).inv.hom ((Scheme.ΓSpecIso (.of A)).inv.hom r)) = ρ r := by
    intro A _ X P j _ f W hW ρ hρ
    have hle : W ≤ f ⁻¹ᵁ (j ''ᵁ ⊤) := by
      intro w hw
      obtain ⟨p, rfl⟩ : w ∈ Set.range hW.fromSpec := by rw [hW.range_fromSpec]; exact hw
      show f (hW.fromSpec p) ∈ ((j ''ᵁ ⊤ : P.Opens) : Set P)
      rw [← Scheme.Hom.comp_apply, ← hρ, Scheme.Hom.comp_apply, Scheme.Hom.coe_image]
      exact ⟨_, trivial, rfl⟩
    refine ⟨hle, fun r => ?_⟩
    have e2 : (⊤ : (Spec Γ(X, W)).Opens) ≤ hW.fromSpec ⁻¹ᵁ W := hW.fromSpec_preimage_self.ge
    have e1 : (⊤ : (Spec (.of A)).Opens) ≤ j ⁻¹ᵁ (j ''ᵁ ⊤) := (j.preimage_image_eq ⊤).ge
    have e3 : (⊤ : (Spec Γ(X, W)).Opens) ≤ (Spec.map (CommRingCat.ofHom ρ)) ⁻¹ᵁ ⊤ := le_top
    have hgen : ∀ (g₁ g₂ : Spec Γ(X, W) ⟶ P), g₁ = g₂ →
        ∀ (e : (⊤ : (Spec Γ(X, W)).Opens) ≤ g₁ ⁻¹ᵁ (j ''ᵁ ⊤))
          (e' : (⊤ : (Spec Γ(X, W)).Opens) ≤ g₂ ⁻¹ᵁ (j ''ᵁ ⊤)),
          g₁.appLE (j ''ᵁ ⊤) ⊤ e = g₂.appLE (j ''ᵁ ⊤) ⊤ e' := by
      intro g₁ g₂ h e e'
      subst h
      rfl
    have hcomp : f.appLE (j ''ᵁ ⊤) W hle ≫ hW.fromSpec.appLE W ⊤ e2 =
        j.appLE (j ''ᵁ ⊤) ⊤ e1 ≫ (Spec.map (CommRingCat.ofHom ρ)).appLE ⊤ ⊤ e3 := by
      rw [Scheme.Hom.appLE_comp_appLE, Scheme.Hom.appLE_comp_appLE]
      exact hgen _ _ hρ.symm _ _
    have hfside : hW.fromSpec.appLE W ⊤ e2 = (Scheme.ΓSpecIso Γ(X, W)).inv := by
      rw [Scheme.Hom.appLE, hW.fromSpec_app_self, Category.assoc,
        ← CategoryTheory.Functor.map_comp]
      have hid : ((eqToHom hW.fromSpec_preimage_self).op ≫ (homOfLE e2).op :
          Opposite.op (⊤ : (Spec Γ(X, W)).Opens) ⟶ Opposite.op ⊤) = 𝟙 _ := by
        apply Quiver.Hom.unop_inj
        exact Subsingleton.elim _ _
      rw [hid, CategoryTheory.Functor.map_id, Category.comp_id]
    have hjside : j.appLE (j ''ᵁ ⊤) ⊤ e1 = (j.appIso ⊤).hom := (Scheme.Hom.appIso_hom' j ⊤).symm
    have hspec : (Spec.map (CommRingCat.ofHom ρ)).appLE ⊤ ⊤ e3 =
        (Spec.map (CommRingCat.ofHom ρ)).appTop := rfl
    rw [hfside, hjside, hspec] at hcomp
    have hnat := Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom ρ)
    have h1 := congrArg (fun φ => φ.hom
      ((j.appIso ⊤).inv.hom ((Scheme.ΓSpecIso (.of A)).inv.hom r))) hcomp
    have h2 := congrArg (fun φ => φ.hom r) hnat
    simp only [CommRingCat.comp_apply, Iso.inv_hom_id_apply] at h1 h2
    have h3 := congrArg (Scheme.ΓSpecIso Γ(X, W)).hom.hom (h1.trans h2.symm)
    simp only [Iso.inv_hom_id_apply] at h3
    refine h3.trans ?_
    exact Iso.inv_hom_id_apply (Scheme.ΓSpecIso Γ(X, W)) (ρ r)

  intro K _ X P j _ β f x hfx W hW hx ρ hρ τ hτ
  have hm0 := L3 (Polynomial K) (Polynomial.X - Polynomial.C β) _ (L4 K β)
  have claim : ∀ (y : P), y = j (Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom β))
      (IsLocalRing.closedPoint K)) → ∀ (hyV' : y ∈ j ''ᵁ ⊤),
      IsLocalRing.maximalIdeal (P.presheaf.stalk y) = Ideal.span {(P.presheaf.germ (j ''ᵁ ⊤) y hyV').hom
        ((j.appIso ⊤).inv.hom ((Scheme.ΓSpecIso (.of (Polynomial K))).inv.hom
          (Polynomial.X - Polynomial.C β)))} := by
    intro y hy hyV'
    subst hy
    have hbij := ConcreteCategory.bijective_of_isIso (j.stalkMap
      (Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom β)) (IsLocalRing.closedPoint K)))
    apply L2 _ _ _ hbij
    rw [L5 j (j ''ᵁ ⊤) ⊤ (j.preimage_image_eq ⊤).ge _ trivial hyV']
    have hj : j.appLE (j ''ᵁ ⊤) ⊤ (j.preimage_image_eq ⊤).ge = (j.appIso ⊤).hom :=
      (Scheme.Hom.appIso_hom' j ⊤).symm
    rw [hj, Iso.inv_hom_id_apply]
    exact hm0
  have hyV : f x ∈ j ''ᵁ ⊤ := by
    have : j (Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom β))
        (IsLocalRing.closedPoint K)) ∈ ((j ''ᵁ ⊤ : P.Opens) : Set P) := by
      rw [Scheme.Hom.coe_image]; exact ⟨_, trivial, rfl⟩
    rw [hfx]; exact this
  have hm := claim (f x) hfx hyV
  obtain ⟨v, hv, hgv⟩ := L1 _ _ _ (hm.symm.trans hτ)
  obtain ⟨hle, hval⟩ := L6 (Polynomial K) j f W hW ρ hρ
  refine ⟨(f.stalkMap x).hom v, hv.map _, ?_⟩
  rw [← hval (Polynomial.X - Polynomial.C β), ← L5 f (j ''ᵁ ⊤) W hle x hx hyV, hgv, map_mul]

theorem wc_morse_chart_spread_localization : ∀ (K R O : Type u) [Field K] [CommRing R] [Algebra K R] [IsNoetherianRing R] [CommRing O] [IsLocalRing O] [Algebra R O] (q : Ideal R) [q.IsPrime] [IsLocalization.AtPrime O q] (e : R →+* K), e.comp (algebraMap K R) = RingHom.id K → RingHom.ker e = q → ∀ (n : ℕ) (t : Fin n → O) (c : Matrix (Fin n) (Fin n) K) (h : Matrix (Fin n) (Fin n) O) (g : R), IsLocalRing.maximalIdeal O = Ideal.span (Set.range t) → (∀ p r, h p r ∈ IsLocalRing.maximalIdeal O) → algebraMap R O g = ∑ p, ∑ r, (algebraMap R O (algebraMap K R (c p r)) + h p r) * t p * t r → ∃ (s : R) (hs : e s ≠ 0) (t₀ : Fin n → Localization.Away s) (H₀ : Matrix (Fin n) (Fin n) (Localization.Away s)), (∀ p, IsLocalization.Away.lift (g := e) s (isUnit_iff_ne_zero.mpr hs) (t₀ p) = 0) ∧ (∀ p r, IsLocalization.Away.lift (g := e) s (isUnit_iff_ne_zero.mpr hs) (H₀ p r) = 0) ∧ (∀ x : Localization.Away s, IsLocalization.Away.lift (g := e) s (isUnit_iff_ne_zero.mpr hs) x = 0 → ∃ w : Localization.Away s, IsLocalization.Away.lift (g := e) s (isUnit_iff_ne_zero.mpr hs) w ≠ 0 ∧ w * x ∈ Ideal.span (Set.range t₀)) ∧ algebraMap R (Localization.Away s) g = ∑ p, ∑ r, (algebraMap R (Localization.Away s) (algebraMap K R (c p r)) + H₀ p r) * t₀ p * t₀ r :=
by
  intro K R O _ _ _ _ _ _ _ q _ _ e _he hker n t c h g hm hhm hg
  classical
  have memq : ∀ x : R, x ∈ q ↔ e x = 0 := fun x => by rw [← hker, RingHom.mem_ker]

  obtain ⟨b, hb⟩ := IsLocalization.exist_integer_multiples_of_finite q.primeCompl
    (Sum.elim t (fun pr : Fin n × Fin n => h pr.1 pr.2))
  have hb1 : ∀ p, ∃ a : R, algebraMap R O a = algebraMap R O (b : R) * t p := by
    intro p
    obtain ⟨a, ha⟩ := hb (Sum.inl p)
    exact ⟨a, by rw [ha, Algebra.smul_def]; rfl⟩
  have hb2 : ∀ p r, ∃ a : R, algebraMap R O a = algebraMap R O (b : R) * h p r := by
    intro p r
    obtain ⟨a, ha⟩ := hb (Sum.inr (p, r))
    exact ⟨a, by rw [ha, Algebra.smul_def]; rfl⟩
  choose tt htt using hb1
  choose hh hhh using hb2
  have hs₁ : (b : R) ∉ q := Ideal.mem_primeCompl_iff.mp b.2
  generalize (b : R) = s₁ at htt hhh hs₁

  have hm_t : ∀ p, t p ∈ IsLocalRing.maximalIdeal O := fun p => by
    rw [hm]; exact Ideal.subset_span ⟨p, rfl⟩
  have htt_q : ∀ p, tt p ∈ q := fun p =>
    (IsLocalization.AtPrime.to_map_mem_maximal_iff O q (tt p)).mp
      (by rw [htt]; exact Ideal.mul_mem_left _ _ (hm_t p))
  have hhh_q : ∀ p r, hh p r ∈ q := fun p r =>
    (IsLocalization.AtPrime.to_map_mem_maximal_iff O q (hh p r)).mp
      (by rw [hhh]; exact Ideal.mul_mem_left _ _ (hhm p r))

  have hO : algebraMap R O (s₁ ^ 3 * g) = algebraMap R O
      (∑ p, ∑ r, (s₁ * algebraMap K R (c p r) + hh p r) * tt p * tt r) := by
    simp only [map_mul, map_pow, map_sum, map_add, htt, hhh, hg, Finset.mul_sum]
    refine Finset.sum_congr rfl (fun p _ => Finset.sum_congr rfl (fun r _ => ?_))
    ring

  obtain ⟨c₂, hs₂eq⟩ := IsLocalization.exists_of_eq (M := q.primeCompl) hO
  have hs₂ : (c₂ : R) ∉ q := Ideal.mem_primeCompl_iff.mp c₂.2
  generalize (c₂ : R) = s₂ at hs₂eq hs₂

  have hgen : ∀ y : R, e y = 0 → ∃ w : R, e w ≠ 0 ∧ w * y ∈ Ideal.span (Set.range tt) := by
    intro y hy
    have hyq : y ∈ q := (memq y).mpr hy
    have hLy : algebraMap R O y ∈ Ideal.span (Set.range t) := by
      rw [← hm]; exact (IsLocalization.AtPrime.to_map_mem_maximal_iff O q y).mpr hyq
    obtain ⟨a, ha⟩ := Ideal.mem_span_range_iff_exists_fun.mp hLy
    obtain ⟨b', hb'⟩ := IsLocalization.exist_integer_multiples_of_finite q.primeCompl a
    have hb'1 : ∀ p, ∃ z : R, algebraMap R O z = algebraMap R O (b' : R) * a p := by
      intro p
      obtain ⟨z, hz⟩ := hb' p
      exact ⟨z, by rw [hz, Algebra.smul_def]⟩
    choose bb hbb using hb'1
    have hb'q : (b' : R) ∉ q := Ideal.mem_primeCompl_iff.mp b'.2
    generalize (b' : R) = β at hbb hb'q
    have hO2 : algebraMap R O (β * s₁ * y) = algebraMap R O (∑ p, bb p * tt p) := by
      rw [map_mul, map_mul, ← ha, map_sum, Finset.mul_sum]
      refine Finset.sum_congr rfl (fun p _ => ?_)
      rw [map_mul, hbb, htt]; ring
    obtain ⟨c₀, hc₀⟩ := IsLocalization.exists_of_eq (M := q.primeCompl) hO2
    have hc₀q : (c₀ : R) ∉ q := Ideal.mem_primeCompl_iff.mp c₀.2
    generalize (c₀ : R) = γ at hc₀ hc₀q
    refine ⟨γ * β * s₁, ?_, ?_⟩
    · have h1 : e γ ≠ 0 := fun h0 => hc₀q ((memq γ).mpr h0)
      have h2 : e β ≠ 0 := fun h0 => hb'q ((memq β).mpr h0)
      have h3 : e s₁ ≠ 0 := fun h0 => hs₁ ((memq s₁).mpr h0)
      rw [map_mul, map_mul]
      exact mul_ne_zero (mul_ne_zero h1 h2) h3
    · rw [Ideal.mem_span_range_iff_exists_fun]
      refine ⟨fun p => γ * bb p, ?_⟩
      rw [show γ * β * s₁ * y = γ * (β * s₁ * y) by ring, hc₀, Finset.mul_sum]
      refine Finset.sum_congr rfl (fun p _ => ?_)
      ring

  have he₁ : e s₁ ≠ 0 := fun h0 => hs₁ ((memq _).mpr h0)
  have he₂ : e s₂ ≠ 0 := fun h0 => hs₂ ((memq _).mpr h0)
  have hett : ∀ p, e (tt p) = 0 := fun p => (memq _).mp (htt_q p)
  have hehh : ∀ p r, e (hh p r) = 0 := fun p r => (memq _).mp (hhh_q p r)
  obtain ⟨s, hsdef⟩ : ∃ s, s = s₁ * s₂ := ⟨_, rfl⟩
  have hs : e s ≠ 0 := by rw [hsdef, map_mul]; exact mul_ne_zero he₁ he₂
  refine ⟨s, hs, ?_⟩
  have hu : IsUnit (algebraMap R (Localization.Away s) s₁ * algebraMap R (Localization.Away s) s₂) := by
    rw [← map_mul, ← hsdef]
    exact IsLocalization.Away.algebraMap_isUnit s
  have u₁ := isUnit_of_mul_isUnit_left hu
  have u₂ := isUnit_of_mul_isUnit_right hu
  obtain ⟨v₁, hv₁⟩ := u₁.exists_left_inv
  have hlift : ∀ a : R, (IsLocalization.Away.lift (g := e) s (isUnit_iff_ne_zero.mpr hs) :
      Localization.Away s →+* K) (algebraMap R (Localization.Away s) a) = e a :=
    fun a => IsLocalization.Away.lift_eq s (isUnit_iff_ne_zero.mpr hs) a
  refine ⟨fun p => v₁ * algebraMap R (Localization.Away s) (tt p), fun p r => v₁ * algebraMap R (Localization.Away s) (hh p r),
    ?_, ?_, ?_, ?_⟩
  · intro p
    simp only [map_mul, hlift, hett, mul_zero]
  · intro p r
    simp only [map_mul, hlift, hehh, mul_zero]
  · intro x hx
    obtain ⟨k, a, hxa⟩ := IsLocalization.Away.surj s x
    have hea : e a = 0 := by
      have h0 := congrArg (IsLocalization.Away.lift (g := e) s (isUnit_iff_ne_zero.mpr hs) :
        Localization.Away s →+* K) hxa
      rw [map_mul, hx, zero_mul, hlift] at h0
      exact h0.symm
    obtain ⟨w₀, hw₀, hw₀mem⟩ := hgen a hea
    obtain ⟨bb, hbb⟩ := Ideal.mem_span_range_iff_exists_fun.mp hw₀mem
    refine ⟨algebraMap R (Localization.Away s) w₀ * algebraMap R (Localization.Away s) s ^ k, ?_, ?_⟩
    · rw [map_mul, map_pow, hlift, hlift]
      exact mul_ne_zero hw₀ (pow_ne_zero _ hs)
    · rw [Ideal.mem_span_range_iff_exists_fun]
      refine ⟨fun p => algebraMap R (Localization.Away s) (bb p) * algebraMap R (Localization.Away s) s₁, ?_⟩
      rw [show algebraMap R (Localization.Away s) w₀ * algebraMap R (Localization.Away s) s ^ k * x =
          algebraMap R (Localization.Away s) w₀ * (x * algebraMap R (Localization.Away s) s ^ k) by ring, hxa, ← map_mul, ← hbb, map_sum]
      refine Finset.sum_congr rfl (fun p _ => ?_)
      rw [map_mul]
      linear_combination (algebraMap R (Localization.Away s) (bb p) *
        algebraMap R (Localization.Away s) (tt p)) * hv₁
  · have h1 := congrArg (algebraMap R (Localization.Away s)) hs₂eq
    simp only [map_mul, map_pow, map_sum, map_add] at h1
    have h2 := u₂.mul_left_cancel h1
    have h3 : algebraMap R (Localization.Away s) g = v₁ ^ 3 *
        (algebraMap R (Localization.Away s) s₁ ^ 3 * algebraMap R (Localization.Away s) g) := by
      linear_combination (-(algebraMap R (Localization.Away s) g) *
        ((v₁ * algebraMap R (Localization.Away s) s₁) ^ 2 +
          v₁ * algebraMap R (Localization.Away s) s₁ + 1)) * hv₁
    rw [h3, h2, Finset.mul_sum]
    refine Finset.sum_congr rfl (fun p _ => ?_)
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl (fun r _ => ?_)
    linear_combination (v₁ ^ 2 * algebraMap R (Localization.Away s) (algebraMap K R (c p r)) *
      algebraMap R (Localization.Away s) (tt p) * algebraMap R (Localization.Away s) (tt r)) * hv₁

theorem wc_morse_quadric_hensel_standard_etale : ∀ (K R : Type u) [Field K] [CommRing R] [Algebra K R] (n : ℕ) (𝒦 : Matrix (Fin n) (Fin n) K) (e : R →+* K) (H : Matrix (Fin n) (Fin n) R), (∀ p r, e (H p r) = 0) → ∃ (S : Type u) (_ : CommRing S) (_ : Algebra R S) (e' : S →+* K) (U : Matrix (Fin n) (Fin n) S), RingHom.IsStandardSmoothOfRelativeDimension 0 (algebraMap R S) ∧ e'.comp (algebraMap R S) = e ∧ (∀ p r, e' (U p r) = 0) ∧ U + U * 𝒦.map ((algebraMap R S).comp (algebraMap K R)) * U.transpose = H.map (algebraMap R S) :=
by

  have s1 : ∀ (R : Type u) [CommRing R] (ι : Type) [Fintype ι] [DecidableEq ι] (F₀ : ι → MvPolynomial ι R), Algebra.IsStandardSmoothOfRelativeDimension 0 R (MvPolynomial (ι ⊕ Unit) R ⧸ Ideal.span (Set.range (Sum.elim (fun b => MvPolynomial.rename Sum.inl (F₀ b)) (fun _ : Unit => MvPolynomial.X (Sum.inr ()) * MvPolynomial.rename Sum.inl (Matrix.of (fun a b => MvPolynomial.pderiv a (F₀ b))).det - 1)))) := by
    intro R _ ι _ _ F₀
    classical
    set Δ := (Matrix.of (fun a b => MvPolynomial.pderiv a (F₀ b))).det with hΔ
    set v : ι ⊕ Unit → MvPolynomial (ι ⊕ Unit) R := Sum.elim (fun b => MvPolynomial.rename Sum.inl (F₀ b)) (fun _ : Unit => MvPolynomial.X (Sum.inr ()) * MvPolynomial.rename Sum.inl Δ - 1) with hv
    let P : Algebra.PreSubmersivePresentation R (MvPolynomial (ι ⊕ Unit) R ⧸ Ideal.span (Set.range v)) (ι ⊕ Unit) (ι ⊕ Unit) :=
      Algebra.PreSubmersivePresentation.naive id Function.injective_id
    have hrel : ∀ j, P.relation j = v j := fun j => by
      rw [show P.relation = v from Algebra.Presentation.naive_relation _ _]
    have hmap : ∀ i, P.map i = i := fun i => rfl
    have halg : ∀ p, algebraMap P.Ring (MvPolynomial (ι ⊕ Unit) R ⧸ Ideal.span (Set.range v)) p =
        Ideal.Quotient.mk _ p := by
      intro p
      rw [Algebra.Generators.algebraMap_apply]
      have : (MvPolynomial.aeval P.val : MvPolynomial (ι ⊕ Unit) R →ₐ[R] _) =
          Ideal.Quotient.mkₐ R (Ideal.span (Set.range v)) := by
        apply MvPolynomial.algHom_ext
        intro i
        rw [MvPolynomial.aeval_X, Ideal.Quotient.mkₐ_eq_mk]
        rfl
      rw [this, Ideal.Quotient.mkₐ_eq_mk]
    have hzero : ∀ q : MvPolynomial ι R,
        MvPolynomial.pderiv (Sum.inr () : ι ⊕ Unit) (MvPolynomial.rename Sum.inl q) = 0 := by
      intro q
      induction q using MvPolynomial.induction_on with
      | C a => simp
      | add p q hp hq => simp [hp, hq]
      | mul_X p i hp => simp [hp, MvPolynomial.pderiv_X]
    have hJ : P.jacobiMatrix = Matrix.fromBlocks
        ((Matrix.of fun a b => MvPolynomial.pderiv a (F₀ b)).map (MvPolynomial.rename Sum.inl))
        (Matrix.of fun a (_ : Unit) => MvPolynomial.pderiv (Sum.inl a) (v (Sum.inr ())))
        0 (Matrix.of fun (_ : Unit) (_ : Unit) => MvPolynomial.rename Sum.inl Δ) := by
      ext i j
      rw [Algebra.PreSubmersivePresentation.jacobiMatrix_apply, hrel, hmap]
      rcases i with a | _ <;> rcases j with b | _
      · simp [v, MvPolynomial.pderiv_rename Sum.inl_injective]
      · simp
      · simp [v, hzero]
      · simp [v, hzero]
    have h11 : ((Matrix.of fun a b => MvPolynomial.pderiv a (F₀ b)).map
        (MvPolynomial.rename (R := R) (Sum.inl : ι → ι ⊕ Unit))).det
        = MvPolynomial.rename Sum.inl Δ := (AlgHom.map_det _ _).symm
    have hdet : P.jacobiMatrix.det = MvPolynomial.rename Sum.inl Δ * MvPolynomial.rename Sum.inl Δ := by
      rw [hJ, Matrix.det_fromBlocks_zero₂₁,
        Matrix.det_unique (Matrix.of fun (_ : Unit) (_ : Unit) => MvPolynomial.rename Sum.inl Δ), h11,
        Matrix.of_apply]
    have hunitΔ : IsUnit (Ideal.Quotient.mk (Ideal.span (Set.range v)) (MvPolynomial.rename Sum.inl Δ)) := by
      have h1 : Ideal.Quotient.mk (Ideal.span (Set.range v)) (v (Sum.inr ())) = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨_, rfl⟩)
      simp only [v, Sum.elim_inr, map_sub, map_mul, map_one] at h1
      have h2 := sub_eq_zero.mp h1
      have h3 : Ideal.Quotient.mk (Ideal.span (Set.range v)) (MvPolynomial.rename Sum.inl Δ) *
          Ideal.Quotient.mk (Ideal.span (Set.range v)) (MvPolynomial.X (Sum.inr ())) = 1 := by
        rw [mul_comm]; exact h2
      exact ⟨⟨_, _, h3, by rw [mul_comm]; exact h3⟩, rfl⟩
    have hunit : IsUnit P.jacobian := by
      rw [Algebra.PreSubmersivePresentation.jacobian_eq_jacobiMatrix_det, hdet, halg, map_mul]
      exact hunitΔ.mul hunitΔ
    exact Algebra.IsStandardSmoothOfRelativeDimension.mk
      ⟨ι ⊕ Unit, ι ⊕ Unit, inferInstance, inferInstance, ⟨P, hunit⟩, Nat.sub_self _⟩

  have s2 : ∀ (R K : Type u) [CommRing R] [CommRing K] (n : ℕ) (A H : Matrix (Fin n) (Fin n) R) (e : R →+* K), MvPolynomial.eval₂ e (fun _ => (0 : K)) (Matrix.of (fun a b : Fin n × Fin n => MvPolynomial.pderiv a (MvPolynomial.X b + ∑ k, ∑ l, MvPolynomial.X (b.1, k) * MvPolynomial.C (A k l) * MvPolynomial.X (b.2, l) - MvPolynomial.C (H b.1 b.2)))).det = 1 := by
    intro R K _ _ n A H e
    classical
    rw [← MvPolynomial.coe_eval₂Hom, RingHom.map_det]
    refine (congrArg Matrix.det ?_).trans Matrix.det_one
    ext a b
    simp only [RingHom.mapMatrix_apply, Matrix.map_apply, Matrix.of_apply, map_sub, map_add, map_sum,
      MvPolynomial.pderiv_mul, MvPolynomial.pderiv_C, MvPolynomial.pderiv_X, map_mul,
      MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_C, mul_zero, zero_mul,
      add_zero, Finset.sum_const_zero, sub_zero]
    rw [Matrix.one_apply, Pi.single_apply]
    split_ifs with h1 h2 h2
    · simp
    · exact absurd h1.symm h2
    · exact absurd h2.symm h1
    · simp

  have s3 : ∀ (S : Type u) [CommRing S] (n : ℕ) (U A H : Matrix (Fin n) (Fin n) S), (∀ p r, U p r + ∑ k, ∑ l, U p k * A k l * U r l - H p r = 0) → U + U * A * U.transpose = H := by
    intro S _ n U A H h
    ext p r
    have := h p r
    rw [sub_eq_zero] at this
    rw [← this, Matrix.add_apply, Matrix.mul_apply]
    simp only [Matrix.mul_apply, Matrix.transpose_apply, Finset.sum_mul]
    rw [Finset.sum_comm]

  intro K R _ _ _ n 𝒦 e H hH
  classical
  set A : Matrix (Fin n) (Fin n) R := 𝒦.map (algebraMap K R) with hA
  set F₀ : Fin n × Fin n → MvPolynomial (Fin n × Fin n) R := fun b =>
    MvPolynomial.X b + ∑ k, ∑ l, MvPolynomial.X (b.1, k) * MvPolynomial.C (A k l) * MvPolynomial.X (b.2, l) - MvPolynomial.C (H b.1 b.2) with hF₀
  set v : (Fin n × Fin n) ⊕ Unit → MvPolynomial ((Fin n × Fin n) ⊕ Unit) R :=
    Sum.elim (fun b => MvPolynomial.rename Sum.inl (F₀ b)) (fun _ : Unit => MvPolynomial.X (Sum.inr ()) * MvPolynomial.rename Sum.inl (Matrix.of (fun a b => MvPolynomial.pderiv a (F₀ b))).det - 1) with hv
  set I := Ideal.span (Set.range v) with hI
  let g : (Fin n × Fin n) ⊕ Unit → K := Sum.elim (fun _ => 0) (fun _ => 1)
  let ev : MvPolynomial ((Fin n × Fin n) ⊕ Unit) R →+* K := MvPolynomial.eval₂Hom e g
  have hg : g ∘ Sum.inl = fun _ => 0 := rfl
  have hF0 : ∀ b, MvPolynomial.eval₂ e (fun _ => (0 : K)) (F₀ b) = 0 := by
    intro b
    simp [F₀, hH]
  have hvI : ∀ j, ev (v j) = 0 := by
    intro j
    rcases j with b | _
    · simp only [v, Sum.elim_inl, ev, MvPolynomial.coe_eval₂Hom, MvPolynomial.eval₂_rename, hg]
      exact hF0 b
    · simp only [v, Sum.elim_inr, ev, map_sub, map_mul, map_one, MvPolynomial.coe_eval₂Hom,
        MvPolynomial.eval₂_rename, MvPolynomial.eval₂_X, hg]
      rw [s2 R K n A H e]
      simp [g]
  have hker : ∀ x ∈ I, ev x = 0 := by
    intro x hx
    have : I ≤ RingHom.ker ev := by
      rw [hI, Ideal.span_le]
      rintro _ ⟨j, rfl⟩
      exact hvI j
    exact this hx
  let e' : MvPolynomial ((Fin n × Fin n) ⊕ Unit) R ⧸ I →+* K := Ideal.Quotient.lift I ev hker
  have he'mk : ∀ x, e' (Ideal.Quotient.mk I x) = ev x := fun x => Ideal.Quotient.lift_mk _ _ _
  let U : Matrix (Fin n) (Fin n) (MvPolynomial ((Fin n × Fin n) ⊕ Unit) R ⧸ I) :=
    Matrix.of fun p r => Ideal.Quotient.mk I (MvPolynomial.X (Sum.inl (p, r)))
  have halg : ∀ x : R, algebraMap R (MvPolynomial ((Fin n × Fin n) ⊕ Unit) R ⧸ I) x =
      Ideal.Quotient.mk I (MvPolynomial.C x) := fun x => rfl
  refine ⟨MvPolynomial ((Fin n × Fin n) ⊕ Unit) R ⧸ I, inferInstance, inferInstance, e', U,
    (RingHom.isStandardSmoothOfRelativeDimension_algebraMap 0).mpr (s1 R (Fin n × Fin n) F₀),
    ?_, ?_, ?_⟩
  · ext x
    rw [RingHom.comp_apply, halg, he'mk]
    simp [ev]
  · intro p r
    simp [U, he'mk, ev, g]
  · apply s3
    intro p r
    have h0 : Ideal.Quotient.mk I (v (Sum.inl (p, r))) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨_, rfl⟩)
    simp only [v, Sum.elim_inl, F₀, map_sub, map_add, map_sum, map_mul, MvPolynomial.rename_X,
      MvPolynomial.rename_C] at h0
    rw [← h0]
    simp only [U, Matrix.of_apply, Matrix.map_apply, RingHom.comp_apply, halg, A]

theorem wc_morse_quadric_coords_jacobian_etale : ∀ (K R : Type u) [Field K] [CommRing R] [Algebra K R] (n : ℕ), RingHom.IsStandardSmoothOfRelativeDimension n (algebraMap K R) → ∀ (e : R →+* K), e.comp (algebraMap K R) = RingHom.id K → ∀ (t : Fin n → R), (∀ p, e (t p) = 0) → (∀ x : R, e x = 0 → ∃ w : R, e w ≠ 0 ∧ w * x ∈ Ideal.span (Set.range t)) → ∀ (S : Type u) [CommRing S] [Algebra R S], RingHom.IsStandardSmoothOfRelativeDimension 0 (algebraMap R S) → ∀ (e' : S →+* K), e'.comp (algebraMap R S) = e → ∀ (N : Matrix (Fin n) (Fin n) S), (∀ p r, e' (N p r) = 0) → ∃ s : S, e' s ≠ 0 ∧ ∀ (S' : Type u) [CommRing S'] [Algebra S S'] [IsLocalization.Away s S'], RingHom.Etale ((algebraMap S S').comp (MvPolynomial.eval₂Hom ((algebraMap R S).comp (algebraMap K R)) ((1 + N).mulVec (fun k => algebraMap R S (t k))))) :=
by
  intro K R _ _ _ n hR e he t ht hgen S _ _ hS0 e' he' N hN
  classical
  letI : Algebra K S := ((algebraMap R S).comp (algebraMap K R)).toAlgebra
  haveI : IsScalarTower K R S := IsScalarTower.of_algebraMap_eq (fun x => rfl)
  haveI : Algebra.IsStandardSmoothOfRelativeDimension 0 R S :=
    (RingHom.isStandardSmoothOfRelativeDimension_algebraMap 0).mp hS0
  have hKS : RingHom.IsStandardSmoothOfRelativeDimension n (algebraMap K S) := by
    have := hS0.comp hR
    rwa [zero_add] at this
  obtain ⟨Q, hQ⟩ : ∃ Q : Ideal S, Q = RingHom.ker e' := ⟨_, rfl⟩
  haveI : Q.IsPrime := hQ ▸ RingHom.ker_isPrime e'
  have he'x : ∀ r, e' (algebraMap R S r) = e r := fun r => RingHom.congr_fun he' r
  have heι : ∀ k, e (algebraMap K R k) = k := fun k => RingHom.congr_fun he k
  have hres : ∀ s : S, algebraMap S Q.ResidueField s = 0 ↔ e' s = 0 := fun s => by
    rw [Ideal.algebraMap_residueField_eq_zero, hQ, RingHom.mem_ker]
  have hB : ∀ (s : S) (m : Ω[S⁄K]), (1 : Q.ResidueField) ⊗ₜ[S] (s • m) =
      algebraMap S Q.ResidueField s • ((1 : Q.ResidueField) ⊗ₜ[S] m) := by
    intro s m
    rw [← TensorProduct.smul_tmul, TensorProduct.smul_tmul', Algebra.smul_def, smul_eq_mul]
  have ht0 : ∀ p, algebraMap S Q.ResidueField (algebraMap R S (t p)) = 0 :=
    fun p => (hres _).mpr (by rw [he'x, ht])
  have hN0 : ∀ p r, algebraMap S Q.ResidueField (N p r) = 0 := fun p r => (hres _).mpr (hN p r)

  have hW : ∀ ω : Ω[S⁄K], ω ∈ Submodule.span S
      (Set.range (fun x : R => KaehlerDifferential.D K S (algebraMap R S x))) := by
    intro ω
    haveI : Subsingleton Ω[S⁄R] := Algebra.FormallyUnramified.subsingleton_kaehlerDifferential
    obtain ⟨y, rfl⟩ := (KaehlerDifferential.exact_mapBaseChange_map K R S ω).mp
      (Subsingleton.elim _ _)
    induction y using TensorProduct.induction_on with
    | zero => rw [map_zero]; exact Submodule.zero_mem _
    | tmul s η =>
      rw [KaehlerDifferential.mapBaseChange_tmul]
      apply Submodule.smul_mem
      have hη : η ∈ Submodule.span R (Set.range (KaehlerDifferential.D K R)) := by
        rw [KaehlerDifferential.span_range_derivation]; trivial
      induction hη using Submodule.span_induction with
      | mem x hx =>
        obtain ⟨r, rfl⟩ := hx
        rw [KaehlerDifferential.map_D]
        exact Submodule.subset_span ⟨r, rfl⟩
      | zero => rw [map_zero]; exact Submodule.zero_mem _
      | add x y _ _ hx hy => rw [map_add]; exact Submodule.add_mem _ hx hy
      | smul r x _ hx => rw [map_smul]; exact Submodule.smul_of_tower_mem _ r hx
    | add x y hx hy => rw [map_add]; exact Submodule.add_mem _ hx hy

  obtain ⟨V₀, hV₀⟩ : ∃ V : Submodule Q.ResidueField (TensorProduct S Q.ResidueField (Ω[S⁄K])),
      V = Submodule.span Q.ResidueField (Set.range (fun p =>
        (1 : Q.ResidueField) ⊗ₜ[S] KaehlerDifferential.D K S (algebraMap R S (t p)))) := ⟨_, rfl⟩
  have hL2 : ∀ x : R, (1 : Q.ResidueField) ⊗ₜ[S] KaehlerDifferential.D K S (algebraMap R S x) ∈ V₀ := by
    intro x
    obtain ⟨x₀, hx₀⟩ : ∃ y : R, y = x - algebraMap K R (e x) := ⟨_, rfl⟩
    have hex₀ : e x₀ = 0 := by
      rw [hx₀, map_sub, heι, sub_self]
    have hDx : KaehlerDifferential.D K S (algebraMap R S x₀) =
        KaehlerDifferential.D K S (algebraMap R S x) := by
      rw [hx₀, map_sub, map_sub, ← IsScalarTower.algebraMap_apply K R S,
        Derivation.map_algebraMap, sub_zero]
    obtain ⟨w, hw, hwx⟩ := hgen x₀ hex₀
    obtain ⟨b, hb⟩ := Ideal.mem_span_range_iff_exists_fun.mp hwx
    have hrel : algebraMap R S w • KaehlerDifferential.D K S (algebraMap R S x₀) +
        algebraMap R S x₀ • KaehlerDifferential.D K S (algebraMap R S w) =
        ∑ p, (algebraMap R S (b p) • KaehlerDifferential.D K S (algebraMap R S (t p)) +
          algebraMap R S (t p) • KaehlerDifferential.D K S (algebraMap R S (b p))) := by
      rw [add_comm, ← Derivation.leibniz, ← map_mul, mul_comm, ← hb, map_sum, map_sum]
      refine Finset.sum_congr rfl (fun p _ => ?_)
      rw [map_mul, Derivation.leibniz]
    have hrel2 := congrArg (fun m => (1 : Q.ResidueField) ⊗ₜ[S] m) hrel
    simp only [TensorProduct.tmul_add, TensorProduct.tmul_sum, hB] at hrel2
    have h1 : algebraMap S Q.ResidueField (algebraMap R S x₀) = 0 :=
      (hres _).mpr (by rw [he'x, hex₀])
    simp only [h1, ht0, zero_smul, add_zero] at hrel2
    have hw' : algebraMap S Q.ResidueField (algebraMap R S w) ≠ 0 := fun h =>
      hw (by rw [← he'x]; exact (hres _).mp h)
    have hmem : algebraMap S Q.ResidueField (algebraMap R S w) •
        ((1 : Q.ResidueField) ⊗ₜ[S] KaehlerDifferential.D K S (algebraMap R S x)) ∈ V₀ := by
      rw [← hDx, hrel2, hV₀]
      exact Submodule.sum_mem _ (fun p _ => Submodule.smul_mem _ _ (Submodule.subset_span ⟨p, rfl⟩))
    have := Submodule.smul_mem V₀ (algebraMap S Q.ResidueField (algebraMap R S w))⁻¹ hmem
    rwa [inv_smul_smul₀ hw'] at this

  have hV₀top : V₀ = ⊤ := by
    have h1 : ∀ ω : Ω[S⁄K], (1 : Q.ResidueField) ⊗ₜ[S] ω ∈ V₀ := by
      intro ω
      have hω := hW ω
      induction hω using Submodule.span_induction with
      | mem x hx => obtain ⟨r, rfl⟩ := hx; exact hL2 r
      | zero => rw [TensorProduct.tmul_zero]; exact V₀.zero_mem
      | add x y _ _ hx hy => rw [TensorProduct.tmul_add]; exact V₀.add_mem hx hy
      | smul s x _ hx => rw [hB]; exact V₀.smul_mem _ hx
    rw [eq_top_iff]
    intro z _hz
    clear _hz
    induction z using TensorProduct.induction_on with
    | zero => exact V₀.zero_mem
    | tmul a ω =>
      have : a ⊗ₜ[S] ω = a • ((1 : Q.ResidueField) ⊗ₜ[S] ω) := by
        rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
      rw [this]; exact V₀.smul_mem a (h1 ω)
    | add x y hx hy => exact V₀.add_mem hx hy

  have hL3 : ∀ p, (1 : Q.ResidueField) ⊗ₜ[S] KaehlerDifferential.D K S
      ((1 + N).mulVec (fun k => algebraMap R S (t k)) p) =
      (1 : Q.ResidueField) ⊗ₜ[S] KaehlerDifferential.D K S (algebraMap R S (t p)) := by
    intro p
    rw [Matrix.add_mulVec, Matrix.one_mulVec, Pi.add_apply, map_add, TensorProduct.tmul_add]
    simp only [Matrix.mulVec, dotProduct, map_sum, Derivation.leibniz, TensorProduct.tmul_sum,
      TensorProduct.tmul_add, hB, hN0, ht0, zero_smul, add_zero, Finset.sum_const_zero]
  have hspan : Submodule.span Q.ResidueField (Set.range (fun j => (1 : Q.ResidueField) ⊗ₜ[S]
      KaehlerDifferential.D K S (((1 + N).mulVec (fun k => algebraMap R S (t k))) j))) = ⊤ := by
    have hfun : (fun j => (1 : Q.ResidueField) ⊗ₜ[S]
        KaehlerDifferential.D K S (((1 + N).mulVec (fun k => algebraMap R S (t k))) j)) =
        (fun p => (1 : Q.ResidueField) ⊗ₜ[S] KaehlerDifferential.D K S (algebraMap R S (t p))) :=
      funext hL3
    rw [hfun, ← hV₀, hV₀top]
  obtain ⟨s, hsQ, hs⟩ := wc_tube_jacobian_etale K S n (Fin n) _ hKS (Fintype.card_fin n) Q hspan
  refine ⟨s, fun h => hsQ (by rw [hQ, RingHom.mem_ker]; exact h), ?_⟩
  intro S' _ _ _
  exact hs S'

theorem wc_morse_odp_etale_chart : ∀ (F' F'' : Type u) [Field F'] [Field F''] [Finite F''] [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ), 2 ≤ n → ∀ (D : wcLefschetzDatum F' F'' Y n) (i : Fin D.m) (j : Spec (.of (Polynomial F'')) ⟶ (wcP1Over F'').left) (β : F''), IsOpenImmersion j → j ≫ (wcP1Over F'').hom = Spec.map (CommRingCat.ofHom (algebraMap F'' (Polynomial F''))) → Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom β)) ≫ j = D.S i → ∃ (U : Scheme.{u}) (u : U ⟶ D.Yt.left) (φ : U ⟶ Spec (.of (MvPolynomial (Fin n) F''))) (c : Matrix (Fin n) (Fin n) F'') (σ : Spec (.of F'') ⟶ U), Etale u ∧ Etale φ ∧ (c + c.transpose).det ≠ 0 ∧ u ≫ D.f = φ ≫ Spec.map (CommRingCat.ofHom (Polynomial.eval₂RingHom MvPolynomial.C (MvPolynomial.C β + ∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q))) ≫ j ∧ σ ≫ u = D.xs i ∧ ∀ p, (MvPolynomial.X p : MvPolynomial (Fin n) F'') ∈ (φ (σ (IsLocalRing.closedPoint F''))).asIdeal :=
by

  have ringHom_eq_of_spec : ∀ {R S : Type u} [CommRing R] [CommRing S] (f g : R →+* S),
      Spec.map (CommRingCat.ofHom f) = Spec.map (CommRingCat.ofHom g) → f = g := by
    intro R S _ _ f g h
    have := congrArg CommRingCat.Hom.hom (Spec.map_injective h)
    simpa using this
  have specK_kappa : ∀ (K : Type u) [Field K] {X : Scheme.{u}} (h : X ⟶ Spec (.of K)) (W : X.Opens)
      (hW : IsAffineOpen W), Spec.map (CommRingCat.ofHom ((h.appLE ⊤ W le_top).hom.comp
        (Scheme.ΓSpecIso (.of K)).inv.hom)) = hW.fromSpec ≫ h := by
    intro K _ X h W hW
    rw [CommRingCat.ofHom_comp, Spec.map_comp, CommRingCat.ofHom_hom, CommRingCat.ofHom_hom,
      ← Scheme.isoSpec_Spec_inv, ← IsAffineOpen.fromSpec_top]
    exact IsAffineOpen.SpecMap_appLE_fromSpec h (isAffineOpen_top (Spec (.of K))) hW le_top

  have c1 : ∀ (K : Type u) [Field K] {X : Scheme.{u}} (h : X ⟶ Spec (.of K)) (n : ℕ) [SmoothOfRelativeDimension n h] (x : X) (O : X.Opens), x ∈ O → ∃ (W : X.Opens) (_ : IsAffineOpen W), x ∈ W ∧ W ≤ O ∧ IsNoetherianRing Γ(X, W) ∧ RingHom.IsStandardSmoothOfRelativeDimension n ((h.appLE ⊤ W le_top).hom.comp (Scheme.ΓSpecIso (.of K)).inv.hom) := by
    intro K _ X h n _ x O hxO
    obtain ⟨U, hU, V, hV, hxV, e, hstd⟩ :=
      SmoothOfRelativeDimension.exists_isStandardSmoothOfRelativeDimension (n := n) (f := h) x
    have hUtop : U = ⊤ := by
      rw [eq_top_iff]
      intro y _
      have : h x ∈ U := e hxV
      rwa [Subsingleton.elim y (h x)]
    subst hUtop
    obtain ⟨f, hfle, hxf⟩ := hV.exists_basicOpen_le (V := V ⊓ O) ⟨x, ⟨hxV, hxO⟩⟩ hxV
    have hfV : X.basicOpen f ≤ V := X.basicOpen_le f
    refine ⟨X.basicOpen f, hV.basicOpen f, hxf, hfle.trans inf_le_right, ?_⟩
    have hiso : RingHom.IsStandardSmoothOfRelativeDimension 0 (Scheme.ΓSpecIso (.of K)).inv.hom := by
      letI : Algebra K Γ(Spec (.of K), ⊤) := (Scheme.ΓSpecIso (.of K)).inv.hom.toAlgebra
      haveI : IsLocalization.Away (1 : K) Γ(Spec (.of K), ⊤) :=
        IsLocalization.away_of_isUnit_of_bijective _ isUnit_one
          (Scheme.ΓSpecIso (.of K)).symm.commRingCatIsoToRingEquiv.bijective
      exact RingHom.IsStandardSmoothOfRelativeDimension.algebraMap_isLocalizationAway (1 : K)
    have hloc : RingHom.IsStandardSmoothOfRelativeDimension 0
        (X.presheaf.map (homOfLE hfV).op).hom := by
      haveI := hV.isLocalization_basicOpen f
      exact RingHom.IsStandardSmoothOfRelativeDimension.algebraMap_isLocalizationAway f
    have hSm : RingHom.IsStandardSmoothOfRelativeDimension n
        ((h.appLE ⊤ (X.basicOpen f) le_top).hom.comp (Scheme.ΓSpecIso (.of K)).inv.hom) := by
      rw [← Scheme.Hom.appLE_map h e (homOfLE hfV).op, CommRingCat.hom_comp, RingHom.comp_assoc]
      have := hloc.comp (hstd.comp hiso)
      simpa using this
    refine ⟨?_, hSm⟩
    letI : Algebra K Γ(X, X.basicOpen f) :=
      ((h.appLE ⊤ (X.basicOpen f) le_top).hom.comp (Scheme.ΓSpecIso (.of K)).inv.hom).toAlgebra
    haveI : Algebra.IsStandardSmoothOfRelativeDimension n K Γ(X, X.basicOpen f) := hSm.toAlgebra
    haveI : Algebra.IsStandardSmooth K Γ(X, X.basicOpen f) :=
      Algebra.IsStandardSmoothOfRelativeDimension.isStandardSmooth n
    haveI : Algebra.FinitePresentation K Γ(X, X.basicOpen f) := inferInstance
    exact Algebra.FiniteType.isNoetherianRing K Γ(X, X.basicOpen f)

  have c2 : ∀ (K : Type u) [Field K] {X : Scheme.{u}} (h : X ⟶ Spec (.of K)) (s : Spec (.of K) ⟶ X), s ≫ h = 𝟙 _ → ∀ (W : X.Opens) (hW : IsAffineOpen W) (hx : s (IsLocalRing.closedPoint K) ∈ W), ∃ e : Γ(X, W) →+* K, Spec.map (CommRingCat.ofHom e) ≫ hW.fromSpec = s ∧ e.comp ((h.appLE ⊤ W le_top).hom.comp (Scheme.ΓSpecIso (.of K)).inv.hom) = RingHom.id K ∧ RingHom.ker e = (hW.primeIdealOf ⟨s (IsLocalRing.closedPoint K), hx⟩).asIdeal := by
    intro K _ X h s hs W hW hx
    have hr : Set.range s ⊆ Set.range hW.fromSpec := by
      rintro _ ⟨y, rfl⟩
      rw [Subsingleton.elim y (IsLocalRing.closedPoint K), hW.range_fromSpec]
      exact hx
    set e := (Spec.preimage (IsOpenImmersion.lift hW.fromSpec s hr)).hom with he
    have he1 : Spec.map (CommRingCat.ofHom e) ≫ hW.fromSpec = s := by
      rw [he, CommRingCat.ofHom_hom, Spec.map_preimage, IsOpenImmersion.lift_fac]
    refine ⟨e, he1, ?_, ?_⟩
    · apply ringHom_eq_of_spec
      rw [CommRingCat.ofHom_comp, Spec.map_comp, specK_kappa K h W hW, ← Category.assoc, he1, hs,
        CommRingCat.ofHom_id, Spec.map_id]
    · have hpt : Spec.map (CommRingCat.ofHom e) (IsLocalRing.closedPoint K) =
          hW.primeIdealOf ⟨s (IsLocalRing.closedPoint K), hx⟩ := by
        apply hW.fromSpec.isOpenEmbedding.injective
        rw [hW.fromSpec_primeIdealOf]
        exact congrArg (fun g => g (IsLocalRing.closedPoint K)) he1
      rw [← hpt]
      ext r
      rw [RingHom.mem_ker]
      show e r = 0 ↔ e r ∈ IsLocalRing.maximalIdeal K
      rw [IsLocalRing.maximalIdeal_eq_bot, Ideal.mem_bot]

  have c3 : ∀ (K : Type u) [Field K] {X P : Scheme.{u}} (j : Spec (.of (Polynomial K)) ⟶ P) [IsOpenImmersion j] (hP : P ⟶ Spec (.of K)), j ≫ hP = Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))) → ∀ (hX : X ⟶ Spec (.of K)) (f : X ⟶ P), f ≫ hP = hX → ∀ (W : X.Opens) (hW : IsAffineOpen W), W ≤ f ⁻¹ᵁ j.opensRange → ∃ ρ : Polynomial K →+* Γ(X, W), Spec.map (CommRingCat.ofHom ρ) ≫ j = hW.fromSpec ≫ f ∧ ρ.comp Polynomial.C = (hX.appLE ⊤ W le_top).hom.comp (Scheme.ΓSpecIso (.of K)).inv.hom := by
    intro K _ X P j _ hP hjK hX f hf W hW hWO
    have hr : Set.range (hW.fromSpec ≫ f) ⊆ Set.range j := by
      rintro _ ⟨y, rfl⟩
      have h1 : hW.fromSpec y ∈ W := by
        rw [← SetLike.mem_coe, ← hW.range_fromSpec]; exact ⟨y, rfl⟩
      have h2 := hWO h1
      have h3 : f (hW.fromSpec y) ∈ (j.opensRange : Set P) := h2
      rw [Scheme.Hom.coe_opensRange] at h3
      exact h3
    refine ⟨(Spec.preimage (IsOpenImmersion.lift j _ hr)).hom, ?_, ?_⟩
    · rw [CommRingCat.ofHom_hom, Spec.map_preimage, IsOpenImmersion.lift_fac]
    · apply ringHom_eq_of_spec
      rw [specK_kappa K hX W hW]
      rw [← Polynomial.algebraMap_eq, CommRingCat.ofHom_comp, Spec.map_comp, CommRingCat.ofHom_hom,
        Spec.map_preimage, ← hjK, ← Category.assoc, IsOpenImmersion.lift_fac, Category.assoc, hf]

  have c6 : ∀ (K R O : Type u) [Field K] [CommRing R] [Algebra K R] [CommRing O] [IsLocalRing O] [Algebra R O] (q : Ideal R) [q.IsPrime] [IsLocalization.AtPrime O q] (e : R →+* K), e.comp (algebraMap K R) = RingHom.id K → RingHom.ker e = q → ∀ (n : ℕ) (t : Fin n → O) (A : Matrix (Fin n) (Fin n) O) (g₀ g₁ w : O), IsUnit (A + A.transpose).det → IsLocalRing.maximalIdeal O = Ideal.span (Set.range t) → g₀ - ∑ p, ∑ r, A p r * t p * t r ∈ IsLocalRing.maximalIdeal O ^ 3 → IsUnit w → g₁ = w * g₀ → ∃ (c : Matrix (Fin n) (Fin n) K) (h : Matrix (Fin n) (Fin n) O), (c + c.transpose).det ≠ 0 ∧ (∀ p r, h p r ∈ IsLocalRing.maximalIdeal O) ∧ g₁ = ∑ p, ∑ r, (algebraMap R O (algebraMap K R (c p r)) + h p r) * t p * t r := by
    intro K R O _ _ _ _ _ _ q _ _ e he3 he4 n t A g₀ g₁ w hdet hm hcub hw hg
    classical
    set m := IsLocalRing.maximalIdeal O with hmdef
    have hunit : ∀ y : q.primeCompl, IsUnit (e y) := by
      intro y
      apply isUnit_iff_ne_zero.mpr
      intro h0
      apply y.2
      have : (y : R) ∈ RingHom.ker e := h0
      rwa [he4] at this
    set eb : O →+* K := IsLocalization.lift (M := q.primeCompl) hunit with heb
    have hebR : eb.comp (algebraMap R O) = e := IsLocalization.lift_comp _
    have hebR' : ∀ r, eb (algebraMap R O r) = e r := fun r => RingHom.congr_fun hebR r
    have hebι : ∀ k, eb (algebraMap R O (algebraMap K R k)) = k := by
      intro k; rw [hebR']; exact RingHom.congr_fun he3 k
    have hmq : Ideal.map (algebraMap R O) q = m :=
      IsLocalization.AtPrime.map_eq_maximalIdeal q O
    have hker : ∀ x, x ∈ m → eb x = 0 := by
      intro x hx
      rw [← hmq] at hx
      have : Ideal.map (algebraMap R O) q ≤ RingHom.ker eb := by
        rw [Ideal.map_le_iff_le_comap]
        intro r hr
        show eb (algebraMap R O r) = 0
        rw [hebR', ← RingHom.mem_ker, he4]; exact hr
      exact this hx
    have hdec : ∀ (I : Ideal O), ∀ x ∈ I • Ideal.span (Set.range t),
        ∃ a : Fin n → O, (∀ i, a i ∈ I) ∧ x = ∑ i, a i * t i := by
      intro I x hx
      obtain ⟨a, ha, hsum⟩ := (Submodule.mem_ideal_smul_span_iff_exists_sum _ _ _).mp hx
      refine ⟨a, ha, ?_⟩
      rw [← hsum, Finsupp.sum_fintype]
      · simp [smul_eq_mul]
      · intro i; simp
    have hm2 : m ^ 2 = m • Ideal.span (Set.range t) := by
      rw [pow_two, smul_eq_mul, ← hm]
    have hm3 : m ^ 3 = m ^ 2 • Ideal.span (Set.range t) := by
      rw [pow_succ, smul_eq_mul, ← hm]
    obtain ⟨b, hb, hbsum⟩ : ∃ b : Matrix (Fin n) (Fin n) O, (∀ p r, b p r ∈ m) ∧
        g₀ - ∑ p, ∑ r, A p r * t p * t r = ∑ p, ∑ r, b p r * t p * t r := by
      rw [hm3] at hcub
      obtain ⟨a, ha, hx⟩ := hdec _ _ hcub
      have hai : ∀ r, ∃ br : Fin n → O, (∀ p, br p ∈ m) ∧ a r = ∑ p, br p * t p := by
        intro r
        apply hdec
        rw [← hm2]
        exact ha r
      choose br hbr1 hbr2 using hai
      refine ⟨fun p r => br r p, fun p r => hbr1 r p, ?_⟩
      rw [hx, Finset.sum_comm]
      refine Finset.sum_congr rfl (fun r _ => ?_)
      rw [hbr2 r, Finset.sum_mul]
    set w₀ := eb w with hw₀
    have hw₀ne : w₀ ≠ 0 := (hw.map eb).ne_zero
    set c : Matrix (Fin n) (Fin n) K := w₀ • A.map eb with hc
    refine ⟨c, fun p r => w * (A p r + b p r) - algebraMap R O (algebraMap K R (c p r)), ?_, ?_, ?_⟩
    · have h1 : c + c.transpose = w₀ • (eb.mapMatrix (A + A.transpose)) := by
        ext p r
        simp [hc, Matrix.add_apply, Matrix.transpose_apply, mul_add]
      rw [h1, Matrix.det_smul, ← RingHom.map_det]
      exact mul_ne_zero (pow_ne_zero _ hw₀ne) (hdet.map eb).ne_zero
    · intro p r
      by_contra hcon
      have hu : IsUnit (w * (A p r + b p r) - algebraMap R O (algebraMap K R (c p r))) := by
        by_contra hnu
        exact hcon ((IsLocalRing.mem_maximalIdeal _).mpr hnu)
      have h2 := hu.map eb
      rw [map_sub, map_mul, map_add, hker _ (hb p r), hebι, add_zero] at h2
      simp [hc, hw₀] at h2
    · have hg0 : g₀ = ∑ p, ∑ r, (A p r + b p r) * t p * t r := by
        have := eq_add_of_sub_eq hbsum
        rw [this, ← Finset.sum_add_distrib]
        refine Finset.sum_congr rfl (fun p _ => ?_)
        rw [← Finset.sum_add_distrib]
        refine Finset.sum_congr rfl (fun r _ => ?_)
        ring
      rw [hg, hg0, Finset.mul_sum]
      refine Finset.sum_congr rfl (fun p _ => ?_)
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl (fun r _ => ?_)
      ring

  have g1a : ∀ (S : Type u) [CommRing S] (n : ℕ) (c Mi U : Matrix (Fin n) (Fin n) S) (t : Fin n → S), (c + c.transpose) * Mi = 1 → ∑ p, ∑ r, c p r * ((1 + Mi * U.transpose).mulVec t) p * ((1 + Mi * U.transpose).mulVec t) r = ∑ p, ∑ r, (c + U + U * (Mi.transpose * c * Mi) * U.transpose) p r * t p * t r := by
    intro S _ n c Mi U t hM
    have key : ∀ (B : Matrix (Fin n) (Fin n) S) (v : Fin n → S),
        ∑ p, ∑ r, B p r * v p * v r = dotProduct v (B.mulVec v) := by
      intro B v
      simp only [dotProduct, Matrix.mulVec, Finset.mul_sum]
      refine Finset.sum_congr rfl (fun p _ => Finset.sum_congr rfl (fun r _ => ?_))
      ring
    have symm : ∀ (B : Matrix (Fin n) (Fin n) S),
        dotProduct t (B.transpose.mulVec t) = dotProduct t (B.mulVec t) := by
      intro B
      rw [Matrix.mulVec_transpose, dotProduct_comm, ← Matrix.dotProduct_mulVec]
    have trans : ∀ (B T : Matrix (Fin n) (Fin n) S),
        dotProduct (T.mulVec t) (B.mulVec (T.mulVec t)) =
          dotProduct t ((T.transpose * B * T).mulVec t) := by
      intro B T
      rw [Matrix.mulVec_mulVec, ← Matrix.vecMul_transpose, ← Matrix.dotProduct_mulVec,
        Matrix.mulVec_mulVec, Matrix.mul_assoc]
    rw [key, key, trans]
    have hT : (1 + Mi * U.transpose).transpose * c * (1 + Mi * U.transpose) =
        c + c * Mi * U.transpose + U * Mi.transpose * c + U * (Mi.transpose * c * Mi) * U.transpose := by
      rw [Matrix.transpose_add, Matrix.transpose_one, Matrix.transpose_mul, Matrix.transpose_transpose]
      simp only [add_mul, mul_add, one_mul, mul_one, Matrix.mul_assoc]
      abel
    have hmid : dotProduct t ((U * Mi.transpose * c).mulVec t) =
        dotProduct t ((c.transpose * Mi * U.transpose).mulVec t) := by
      rw [← symm (c.transpose * Mi * U.transpose)]
      congr 2
      rw [Matrix.transpose_mul, Matrix.transpose_mul, Matrix.transpose_transpose,
        Matrix.transpose_transpose, Matrix.mul_assoc]
    have hU : dotProduct t ((c * Mi * U.transpose).mulVec t) +
        dotProduct t ((c.transpose * Mi * U.transpose).mulVec t) = dotProduct t (U.mulVec t) := by
      rw [← dotProduct_add, ← Matrix.add_mulVec, ← add_mul, ← add_mul, hM, one_mul, symm]
    rw [hT]
    simp only [Matrix.add_mulVec, dotProduct_add]
    rw [hmid, ← hU]
    ring

  have glue : ∀ (K : Type u) [Field K] (X P : Scheme.{u}) (h : X ⟶ Spec (.of K)) (n : ℕ) [SmoothOfRelativeDimension n h] (hP : P ⟶ Spec (.of K)) (f : X ⟶ P), f ≫ hP = h → ∀ (xs : Spec (.of K) ⟶ X) (Si : Spec (.of K) ⟶ P), xs ≫ f = Si → Si ≫ hP = 𝟙 _ →
      ∀ (t : Fin n → X.presheaf.stalk (xs (IsLocalRing.closedPoint K))) (τ : P.presheaf.stalk (f (xs (IsLocalRing.closedPoint K)))) (A : Matrix (Fin n) (Fin n) (X.presheaf.stalk (xs (IsLocalRing.closedPoint K)))),
      IsLocalRing.maximalIdeal (X.presheaf.stalk (xs (IsLocalRing.closedPoint K))) = Ideal.span (Set.range t) →
      IsLocalRing.maximalIdeal (P.presheaf.stalk (f (xs (IsLocalRing.closedPoint K)))) = Ideal.span {τ} →
      (f.stalkMap (xs (IsLocalRing.closedPoint K))).hom τ - ∑ a, ∑ c, A a c * t a * t c ∈ IsLocalRing.maximalIdeal (X.presheaf.stalk (xs (IsLocalRing.closedPoint K))) ^ 3 →
      IsUnit (A + A.transpose).det →
      ∀ (j : Spec (.of (Polynomial K)) ⟶ P) (β : K), IsOpenImmersion j →
      j ≫ hP = Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))) →
      Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom β)) ≫ j = Si →
      ∃ (U : Scheme.{u}) (u : U ⟶ X) (φ : U ⟶ Spec (.of (MvPolynomial (Fin n) K))) (c : Matrix (Fin n) (Fin n) K) (σ : Spec (.of K) ⟶ U), Etale u ∧ Etale φ ∧ (c + c.transpose).det ≠ 0 ∧ u ≫ f = φ ≫ Spec.map (CommRingCat.ofHom (Polynomial.eval₂RingHom MvPolynomial.C (MvPolynomial.C β + ∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q))) ≫ j ∧ σ ≫ u = xs ∧ ∀ p, (MvPolynomial.X p : MvPolynomial (Fin n) K) ∈ (φ (σ (IsLocalRing.closedPoint K))).asIdeal := by
    intro K _ X P h n _ hP f hf xs Si hxs hS t τ A hm hτ hcub hdet j β hj hjK hjb
    classical
    haveI := hj

    have hx0 : f (xs (IsLocalRing.closedPoint K)) = j (Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom β)) (IsLocalRing.closedPoint K)) := by
      change (xs ≫ f) (IsLocalRing.closedPoint K) = (Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom β)) ≫ j) (IsLocalRing.closedPoint K)
      rw [hxs, hjb]
    have hsec : xs ≫ h = 𝟙 _ := by rw [← hf, ← Category.assoc, hxs, hS]
    have hxO : xs (IsLocalRing.closedPoint K) ∈ f ⁻¹ᵁ j.opensRange := by
      show f (xs (IsLocalRing.closedPoint K)) ∈ (j.opensRange : Set P)
      rw [Scheme.Hom.coe_opensRange, hx0]
      exact Set.mem_range_self _

    obtain ⟨W, hW, hxW, hWO, hNoeth, hSm⟩ := c1 K h n (xs (IsLocalRing.closedPoint K)) _ hxO
    letI : Algebra K Γ(X, W) :=
      ((h.appLE ⊤ W le_top).hom.comp (Scheme.ΓSpecIso (.of K)).inv.hom).toAlgebra
    haveI := hNoeth

    obtain ⟨e, he1, he3, he4⟩ := c2 K h xs hsec W hW hxW

    obtain ⟨ρ, hρ1, hρ2⟩ := c3 K j hP hjK h f hf W hW hWO

    letI : Algebra Γ(X, W) (X.presheaf.stalk (xs (IsLocalRing.closedPoint K))) :=
      TopCat.Presheaf.algebra_section_stalk X.presheaf ⟨xs (IsLocalRing.closedPoint K), hxW⟩
    haveI : IsLocalization.AtPrime (X.presheaf.stalk (xs (IsLocalRing.closedPoint K)))
        (hW.primeIdealOf ⟨xs (IsLocalRing.closedPoint K), hxW⟩).asIdeal :=
      hW.isLocalization_stalk ⟨xs (IsLocalRing.closedPoint K), hxW⟩
    obtain ⟨w, hw, hgerm⟩ := wc_morse_chart_stalk_uniformizer K j β f
      (xs (IsLocalRing.closedPoint K)) hx0 W hW hxW ρ hρ1 τ hτ
    obtain ⟨c, H, hc, hH, hg⟩ := c6 K Γ(X, W)
      (X.presheaf.stalk (xs (IsLocalRing.closedPoint K))) _ e he3 he4 n t A _ _ w hdet hm hcub hw hgerm

    obtain ⟨s, hs, t₀, H₀, hvt, hvH, hgen, hid⟩ := wc_morse_chart_spread_localization K Γ(X, W)
      (X.presheaf.stalk (xs (IsLocalRing.closedPoint K))) _ e he3 he4 n t c H
      (ρ (Polynomial.X - Polynomial.C β)) hm hH hg
    set e₁ : Localization.Away s →+* K :=
      IsLocalization.Away.lift (g := e) s (isUnit_iff_ne_zero.mpr hs) with he₁def
    have he₁R : e₁.comp (algebraMap Γ(X, W) (Localization.Away s)) = e :=
      IsLocalization.Away.lift_comp _ _
    have he₁K : e₁.comp (algebraMap K (Localization.Away s)) = RingHom.id K := by
      rw [IsScalarTower.algebraMap_eq K Γ(X, W) (Localization.Away s), ← RingHom.comp_assoc, he₁R]
      exact he3
    have hSm₁ : RingHom.IsStandardSmoothOfRelativeDimension n
        (algebraMap K (Localization.Away s)) := by
      rw [IsScalarTower.algebraMap_eq K Γ(X, W) (Localization.Away s)]
      have := (RingHom.IsStandardSmoothOfRelativeDimension.algebraMap_isLocalizationAway
        (Rᵣ := Localization.Away s) s).comp hSm
      rw [zero_add] at this
      exact this

    have hMu : IsUnit (c + c.transpose).det := isUnit_iff_ne_zero.mpr hc
    obtain ⟨Mi, hMMi⟩ : ∃ Mi : Matrix (Fin n) (Fin n) K, (c + c.transpose) * Mi = 1 :=
      ⟨_, Matrix.mul_nonsing_inv _ hMu⟩
    obtain ⟨S, _, _, e', U, hS0, he', hU0, hHens⟩ := wc_morse_quadric_hensel_standard_etale K
      (Localization.Away s) n (Mi.transpose * c * Mi) e₁ H₀ hvH
    set ιS : K →+* S := (algebraMap (Localization.Away s) S).comp
      (algebraMap K (Localization.Away s)) with hιS

    have hN0 : ∀ p r, e' ((Mi.map ιS * U.transpose) p r) = 0 := by
      intro p r
      simp only [Matrix.mul_apply, Matrix.transpose_apply, map_sum, map_mul, hU0, mul_zero,
        Finset.sum_const_zero]
    have hinv : (c.map ιS + (c.map ιS).transpose) * Mi.map ιS = 1 := by
      have h1 := congrArg ιS.mapMatrix hMMi
      rw [map_mul, map_one, map_add] at h1
      simpa only [RingHom.mapMatrix_apply, Matrix.transpose_map] using h1
    have he'R : ∀ x, e' (algebraMap (Localization.Away s) S x) = e₁ x :=
      fun x => RingHom.congr_fun he' x
    have hstar : ∑ p, ∑ r, ιS (c p r) *
        ((1 + Mi.map ιS * U.transpose).mulVec (fun k => algebraMap (Localization.Away s) S (t₀ k))) p *
        ((1 + Mi.map ιS * U.transpose).mulVec (fun k => algebraMap (Localization.Away s) S (t₀ k))) r =
        algebraMap (Localization.Away s) S (algebraMap Γ(X, W) (Localization.Away s)
          (ρ (Polynomial.X - Polynomial.C β))) := by
      have h1 := g1a S n (c.map ιS) (Mi.map ιS) U
        (fun k => algebraMap (Localization.Away s) S (t₀ k)) hinv
      have h2 : (Mi.map ιS).transpose * c.map ιS * Mi.map ιS = (Mi.transpose * c * Mi).map ιS := by
        simp only [Matrix.map_mul, Matrix.transpose_map]
      rw [h2, add_assoc, hHens] at h1
      simp only [Matrix.map_apply, Matrix.add_apply] at h1
      rw [h1, hid]
      simp only [map_sum, map_mul, map_add, hιS, RingHom.comp_apply,
        IsScalarTower.algebraMap_apply K Γ(X, W) (Localization.Away s)]

    obtain ⟨s', hs', hEt⟩ := wc_morse_quadric_coords_jacobian_etale K (Localization.Away s) n hSm₁
      e₁ he₁K t₀ hvt hgen S hS0 e' he' (Mi.map ιS * U.transpose) hN0
    have hΦ := hEt (Localization.Away s')

    have hθs : RingHom.IsStandardSmoothOfRelativeDimension 0
        ((algebraMap S (Localization.Away s')).comp ((algebraMap (Localization.Away s) S).comp
          (algebraMap Γ(X, W) (Localization.Away s)))) := by
      have := (RingHom.IsStandardSmoothOfRelativeDimension.algebraMap_isLocalizationAway
        (Rᵣ := Localization.Away s') s').comp (hS0.comp
          (RingHom.IsStandardSmoothOfRelativeDimension.algebraMap_isLocalizationAway
            (Rᵣ := Localization.Away s) s))
      exact this
    have hθE : ((algebraMap S (Localization.Away s')).comp ((algebraMap (Localization.Away s) S).comp
          (algebraMap Γ(X, W) (Localization.Away s)))).Etale := by
      letI := ((algebraMap S (Localization.Away s')).comp ((algebraMap (Localization.Away s) S).comp
          (algebraMap Γ(X, W) (Localization.Away s)))).toAlgebra
      haveI : Algebra.IsStandardSmoothOfRelativeDimension 0 Γ(X, W) (Localization.Away s') :=
        hθs.toAlgebra
      exact RingHom.etale_algebraMap.mpr inferInstance
    haveI : Etale (Spec.map (CommRingCat.ofHom ((algebraMap S (Localization.Away s')).comp
        ((algebraMap (Localization.Away s) S).comp (algebraMap Γ(X, W) (Localization.Away s)))))) :=
      (HasRingHomProperty.Spec_iff (P := @Etale)).mpr hθE
    have hφ : Etale (Spec.map (CommRingCat.ofHom ((algebraMap S (Localization.Away s')).comp
        (MvPolynomial.eval₂Hom ((algebraMap (Localization.Away s) S).comp
          (algebraMap K (Localization.Away s))) ((1 + Mi.map ιS * U.transpose).mulVec
            (fun k => algebraMap (Localization.Away s) S (t₀ k))))))) :=
      (HasRingHomProperty.Spec_iff (P := @Etale)).mpr hΦ
    have hρC : ρ (Polynomial.C β) = algebraMap K Γ(X, W) β := RingHom.congr_fun hρ2 β
    have hρX : ρ Polynomial.X = ρ (Polynomial.X - Polynomial.C β) + algebraMap K Γ(X, W) β := by
      rw [map_sub, hρC]; ring
    have hring : ((algebraMap S (Localization.Away s')).comp ((algebraMap (Localization.Away s) S).comp
          (algebraMap Γ(X, W) (Localization.Away s)))).comp ρ =
        ((algebraMap S (Localization.Away s')).comp
          (MvPolynomial.eval₂Hom ((algebraMap (Localization.Away s) S).comp
            (algebraMap K (Localization.Away s))) ((1 + Mi.map ιS * U.transpose).mulVec
              (fun k => algebraMap (Localization.Away s) S (t₀ k))))).comp
        (Polynomial.eval₂RingHom MvPolynomial.C (MvPolynomial.C β + ∑ p, ∑ q,
          MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q)) := by
      apply Polynomial.ringHom_ext
      · intro a
        have h1 : ρ (Polynomial.C a) = algebraMap K Γ(X, W) a := RingHom.congr_fun hρ2 a
        simp only [RingHom.comp_apply, h1, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C,
          MvPolynomial.eval₂Hom_C, IsScalarTower.algebraMap_apply K Γ(X, W) (Localization.Away s)]
      · have e1 : MvPolynomial.eval₂Hom ((algebraMap (Localization.Away s) S).comp
            (algebraMap K (Localization.Away s))) ((1 + Mi.map ιS * U.transpose).mulVec
              (fun k => algebraMap (Localization.Away s) S (t₀ k)))
            (MvPolynomial.C β + ∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p *
              MvPolynomial.X q) = ιS β + ∑ p, ∑ r, ιS (c p r) *
              ((1 + Mi.map ιS * U.transpose).mulVec
                (fun k => algebraMap (Localization.Away s) S (t₀ k))) p *
              ((1 + Mi.map ιS * U.transpose).mulVec
                (fun k => algebraMap (Localization.Away s) S (t₀ k))) r := by
          simp only [map_add, map_sum, map_mul, MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_X']
          rfl
        simp only [RingHom.comp_apply, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X]
        rw [e1, hstar, hρX]
        simp only [RingHom.comp_apply, map_add, hιS,
          IsScalarTower.algebraMap_apply K Γ(X, W) (Localization.Away s)]
        ring
    obtain ⟨e'', he''⟩ : ∃ e'' : Localization.Away s' →+* K,
        e''.comp (algebraMap S (Localization.Away s')) = e' :=
      ⟨_, IsLocalization.Away.lift_comp (g := e') s' (isUnit_iff_ne_zero.mpr hs')⟩
    have he''θ : e''.comp ((algebraMap S (Localization.Away s')).comp
        ((algebraMap (Localization.Away s) S).comp (algebraMap Γ(X, W) (Localization.Away s)))) = e := by
      rw [← RingHom.comp_assoc, he'', ← RingHom.comp_assoc, he', he₁R]
    refine ⟨Spec (.of (Localization.Away s')), Spec.map (CommRingCat.ofHom
        ((algebraMap S (Localization.Away s')).comp ((algebraMap (Localization.Away s) S).comp
          (algebraMap Γ(X, W) (Localization.Away s))))) ≫ hW.fromSpec, _, c,
        Spec.map (CommRingCat.ofHom e''), inferInstance, hφ, hc, ?_, ?_, ?_⟩
    · rw [Category.assoc, ← hρ1, ← Category.assoc, ← Category.assoc, ← Spec.map_comp, ← Spec.map_comp,
        ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp, hring]
    · rw [← Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp, he''θ, he1]
    · intro p
      show e'' (((algebraMap S (Localization.Away s')).comp
        (MvPolynomial.eval₂Hom ((algebraMap (Localization.Away s) S).comp
          (algebraMap K (Localization.Away s))) ((1 + Mi.map ιS * U.transpose).mulVec
            (fun k => algebraMap (Localization.Away s) S (t₀ k))))) (MvPolynomial.X p)) ∈
        (IsLocalRing.closedPoint K).asIdeal
      have h0 : e'' (((algebraMap S (Localization.Away s')).comp
        (MvPolynomial.eval₂Hom ((algebraMap (Localization.Away s) S).comp
          (algebraMap K (Localization.Away s))) ((1 + Mi.map ιS * U.transpose).mulVec
            (fun k => algebraMap (Localization.Away s) S (t₀ k))))) (MvPolynomial.X p)) = 0 := by
        rw [RingHom.comp_apply, ← RingHom.comp_apply e'', he'', MvPolynomial.eval₂Hom_X']
        simp only [Matrix.mulVec, dotProduct, map_sum, map_mul, he'R, hvt, mul_zero,
          Finset.sum_const_zero]
      rw [h0]
      exact Ideal.zero_mem _

  intro F' F'' _ _ _ _ Y n _hn2 D i j β hj hjK hjb
  obtain ⟨t, τ, A, hm, hτ, hcub, hdet⟩ := D.odp i
  haveI := D.smooth
  exact glue F'' D.Yt.left (wcP1Over F'').left D.Yt.hom n (wcP1Over F'').hom D.f D.hf (D.xs i)
    (D.S i) (D.hxs i) (D.hS i) t τ A hm hτ hcub hdet j β hj hjK hjb

theorem wc_morse_quad_model_isPullback : ∀ (K A : Type u) [Field K] [CommRing A] (n : ℕ) (β : K) (c : Matrix (Fin n) (Fin n) K) (ρ : Polynomial K →+* A), IsPullback (Spec.map (CommRingCat.ofHom ((Ideal.Quotient.mk (wcQuadModelIdeal A n (ρ (Polynomial.X - Polynomial.C β)) (c.map (ρ.comp Polynomial.C)))).comp (MvPolynomial.map (ρ.comp Polynomial.C))))) (wcQuadModelStr A n (ρ (Polynomial.X - Polynomial.C β)) (c.map (ρ.comp Polynomial.C))) (Spec.map (CommRingCat.ofHom (Polynomial.eval₂RingHom MvPolynomial.C (MvPolynomial.C β + ∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q)))) (Spec.map (CommRingCat.ofHom ρ)) :=
by
  intro K A _ _ n β c ρ
  classical

  have hgenmem : (∑ p, ∑ q, MvPolynomial.C ((c.map (ρ.comp Polynomial.C)) p q) *
      MvPolynomial.X p * MvPolynomial.X q - MvPolynomial.C (ρ (Polynomial.X - Polynomial.C β)) :
        MvPolynomial (Fin n) A) ∈
      wcQuadModelIdeal A n (ρ (Polynomial.X - Polynomial.C β)) (c.map (ρ.comp Polynomial.C)) :=
    Ideal.mem_span_singleton_self _

  have hmapS : MvPolynomial.map (ρ.comp Polynomial.C)
      (∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q :
        MvPolynomial (Fin n) K) =
      ∑ p, ∑ q, MvPolynomial.C ((c.map (ρ.comp Polynomial.C)) p q) *
        MvPolynomial.X p * MvPolynomial.X q := by
    simp only [map_sum, map_mul, MvPolynomial.map_C, MvPolynomial.map_X, Matrix.map_apply]
  have hι : ∀ a : A, algebraMap A (MvPolynomial (Fin n) A ⧸
      wcQuadModelIdeal A n (ρ (Polynomial.X - Polynomial.C β)) (c.map (ρ.comp Polynomial.C))) a =
      Ideal.Quotient.mk _ (MvPolynomial.C a) := by
    intro a
    rw [← Ideal.Quotient.mk_algebraMap, MvPolynomial.algebraMap_eq]

  have hcomm : ((Ideal.Quotient.mk (wcQuadModelIdeal A n (ρ (Polynomial.X - Polynomial.C β))
      (c.map (ρ.comp Polynomial.C)))).comp (MvPolynomial.map (ρ.comp Polynomial.C))).comp
      (Polynomial.eval₂RingHom MvPolynomial.C (MvPolynomial.C β + ∑ p, ∑ q,
        MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q)) =
      (algebraMap A (MvPolynomial (Fin n) A ⧸
        wcQuadModelIdeal A n (ρ (Polynomial.X - Polynomial.C β)) (c.map (ρ.comp Polynomial.C)))).comp ρ := by
    apply Polynomial.ringHom_ext
    · intro k
      rw [RingHom.comp_apply, RingHom.comp_apply, RingHom.comp_apply, hι,
        Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C, MvPolynomial.map_C, RingHom.comp_apply]
    · rw [RingHom.comp_apply, RingHom.comp_apply, RingHom.comp_apply, hι,
        Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X, map_add, hmapS, MvPolynomial.map_C,
        Ideal.Quotient.eq]
      have e : MvPolynomial.C ((ρ.comp Polynomial.C) β) + ∑ p, ∑ q,
          MvPolynomial.C ((c.map (ρ.comp Polynomial.C)) p q) * MvPolynomial.X p * MvPolynomial.X q
          - MvPolynomial.C (ρ Polynomial.X) =
          ∑ p, ∑ q, MvPolynomial.C ((c.map (ρ.comp Polynomial.C)) p q) *
            MvPolynomial.X p * MvPolynomial.X q - MvPolynomial.C (ρ (Polynomial.X - Polynomial.C β)) := by
        rw [map_sub, map_sub, RingHom.comp_apply]
        ring
      rw [e]
      exact hgenmem
  have w : CommRingCat.ofHom (Polynomial.eval₂RingHom MvPolynomial.C (MvPolynomial.C β + ∑ p, ∑ q,
        MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q)) ≫
      CommRingCat.ofHom ((Ideal.Quotient.mk (wcQuadModelIdeal A n (ρ (Polynomial.X - Polynomial.C β))
        (c.map (ρ.comp Polynomial.C)))).comp (MvPolynomial.map (ρ.comp Polynomial.C))) =
      CommRingCat.ofHom ρ ≫ CommRingCat.ofHom (algebraMap A (MvPolynomial (Fin n) A ⧸
        wcQuadModelIdeal A n (ρ (Polynomial.X - Polynomial.C β)) (c.map (ρ.comp Polynomial.C)))) := by
    rw [← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp, hcomm]

  have hC : ∀ (S : Type u) [CommRing S] (ℓ : MvPolynomial (Fin n) K →+* S) (r : A →+* S),
      ℓ.comp (Polynomial.eval₂RingHom MvPolynomial.C (MvPolynomial.C β + ∑ p, ∑ q,
        MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q)) = r.comp ρ →
      ∀ k : K, ℓ (MvPolynomial.C k) = r (ρ (Polynomial.C k)) := by
    intro S _ ℓ r h k
    have := RingHom.congr_fun h (Polynomial.C k)
    rw [RingHom.comp_apply, RingHom.comp_apply, Polynomial.coe_eval₂RingHom,
      Polynomial.eval₂_C] at this
    exact this
  have key : ∀ (S : Type u) [CommRing S] (ℓ : MvPolynomial (Fin n) K →+* S) (r : A →+* S),
      ℓ.comp (Polynomial.eval₂RingHom MvPolynomial.C (MvPolynomial.C β + ∑ p, ∑ q,
        MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q)) = r.comp ρ →
      ∀ a ∈ wcQuadModelIdeal A n (ρ (Polynomial.X - Polynomial.C β)) (c.map (ρ.comp Polynomial.C)),
        MvPolynomial.eval₂Hom r (fun p => ℓ (MvPolynomial.X p)) a = 0 := by
    intro S _ ℓ r h a ha
    have h1 := hC S ℓ r h
    have hX := RingHom.congr_fun h Polynomial.X
    rw [RingHom.comp_apply, RingHom.comp_apply, Polynomial.coe_eval₂RingHom,
      Polynomial.eval₂_X, map_add, h1] at hX
    have hG : MvPolynomial.eval₂Hom r (fun p => ℓ (MvPolynomial.X p))
        (∑ p, ∑ q, MvPolynomial.C ((c.map (ρ.comp Polynomial.C)) p q) *
          MvPolynomial.X p * MvPolynomial.X q) =
        ℓ (∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q) := by
      simp only [map_sum, map_mul, MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_X',
        Matrix.map_apply, RingHom.comp_apply, h1]
    have hgen0 : MvPolynomial.eval₂Hom r (fun p => ℓ (MvPolynomial.X p))
        (∑ p, ∑ q, MvPolynomial.C ((c.map (ρ.comp Polynomial.C)) p q) *
          MvPolynomial.X p * MvPolynomial.X q - MvPolynomial.C (ρ (Polynomial.X - Polynomial.C β))) = 0 := by
      rw [map_sub, hG, MvPolynomial.eval₂Hom_C, map_sub, map_sub, ← hX]
      ring
    obtain ⟨b, hb⟩ := Ideal.mem_span_singleton'.mp ha
    rw [← hb, map_mul]
    exact mul_eq_zero_of_right _ hgen0
  have cond : ∀ s : Limits.PushoutCocone (CommRingCat.ofHom (Polynomial.eval₂RingHom
      MvPolynomial.C (MvPolynomial.C β + ∑ p, ∑ q,
        MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q))) (CommRingCat.ofHom ρ),
      s.inl.hom.comp (Polynomial.eval₂RingHom MvPolynomial.C (MvPolynomial.C β + ∑ p, ∑ q,
        MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q)) = s.inr.hom.comp ρ := by
    intro s
    have := congrArg CommRingCat.Hom.hom s.condition
    rw [CommRingCat.hom_comp, CommRingCat.hom_comp, CommRingCat.hom_ofHom,
      CommRingCat.hom_ofHom] at this
    exact this
  have hPO : IsPushout (CommRingCat.ofHom (Polynomial.eval₂RingHom MvPolynomial.C
      (MvPolynomial.C β + ∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q)))
      (CommRingCat.ofHom ρ)
      (CommRingCat.ofHom ((Ideal.Quotient.mk (wcQuadModelIdeal A n (ρ (Polynomial.X - Polynomial.C β))
        (c.map (ρ.comp Polynomial.C)))).comp (MvPolynomial.map (ρ.comp Polynomial.C))))
      (CommRingCat.ofHom (algebraMap A (MvPolynomial (Fin n) A ⧸
        wcQuadModelIdeal A n (ρ (Polynomial.X - Polynomial.C β)) (c.map (ρ.comp Polynomial.C))))) := by
    refine IsPushout.of_isColimit (c := Limits.PushoutCocone.mk _ _ w)
      (Limits.PushoutCocone.IsColimit.mk w
        (fun s => CommRingCat.ofHom (Ideal.Quotient.lift _
          (MvPolynomial.eval₂Hom s.inr.hom (fun p => s.inl.hom (MvPolynomial.X p)))
          (key s.pt s.inl.hom s.inr.hom (cond s)))) ?_ ?_ ?_)
    · intro s
      apply CommRingCat.hom_ext
      rw [CommRingCat.hom_comp, CommRingCat.hom_ofHom, CommRingCat.hom_ofHom]
      apply MvPolynomial.ringHom_ext
      · intro k
        try simp only [RingHom.comp_apply]
        rw [MvPolynomial.map_C, Ideal.Quotient.lift_mk, MvPolynomial.eval₂Hom_C, RingHom.comp_apply,
          hC s.pt s.inl.hom s.inr.hom (cond s) k]
      · intro p
        try simp only [RingHom.comp_apply]
        rw [MvPolynomial.map_X, Ideal.Quotient.lift_mk, MvPolynomial.eval₂Hom_X']
    · intro s
      apply CommRingCat.hom_ext
      rw [CommRingCat.hom_comp, CommRingCat.hom_ofHom, CommRingCat.hom_ofHom]
      apply RingHom.ext
      intro a
      rw [RingHom.comp_apply, hι, Ideal.Quotient.lift_mk, MvPolynomial.eval₂Hom_C]
    · intro s m hm1 hm2
      apply CommRingCat.hom_ext
      rw [CommRingCat.hom_ofHom]
      apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext
      · intro a
        have := RingHom.congr_fun (congrArg CommRingCat.Hom.hom hm2) a
        rw [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply, hι] at this
        rw [RingHom.comp_apply, RingHom.comp_apply, Ideal.Quotient.lift_mk,
          MvPolynomial.eval₂Hom_C, this]
      · intro p
        have := RingHom.congr_fun (congrArg CommRingCat.Hom.hom hm1) (MvPolynomial.X p)
        rw [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply, RingHom.comp_apply,
          MvPolynomial.map_X] at this
        rw [RingHom.comp_apply, RingHom.comp_apply, Ideal.Quotient.lift_mk,
          MvPolynomial.eval₂Hom_X', this]
  exact AlgebraicGeometry.isPullback_SpecMap_of_isPushout _ _ _ _ hPO

theorem wc_pencil_odp_shens_morse_model : ∀ (F' F'' : Type u) [Field F'] [Field F''] [Finite F''] [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ), Even n → 2 ≤ n → ∀ (D : wcLefschetzDatum F' F'' Y n) (i : Fin D.m) (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (wcP1Over F'').left (D.S i (IsLocalRing.closedPoint F'')))) (Scheme.Etale.forget (wcP1Over F'').left)) (φ : ∀ l, Spec (.of A) ⟶ (W'.obj l).right.left) (a : Spec (.of A) ⟶ (wcP1Over F'').left), wcHalShData (D.S i (IsLocalRing.closedPoint F'')) A Λ W' φ a → ∀ (x : ↥(Limits.pullback D.f a)), Limits.pullback.fst D.f a x = D.xs i (IsLocalRing.closedPoint F'') → ∀ (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)] (Λ' : Type u) [SmallCategory Λ'] [IsCofiltered Λ'] (W'' : Λ' ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Limits.pullback D.f a) x)) (Scheme.Etale.forget (Limits.pullback D.f a))) (φ' : ∀ l, Spec (.of B) ⟶ (W''.obj l).right.left) (a' : Spec (.of B) ⟶ Limits.pullback D.f a), wcHalShData x B Λ' W'' φ' a' → ∃ (_ : IsDomain A), IsDiscreteValuationRing A ∧ ∃ (π : A) (c : Matrix (Fin n) (Fin n) A), IsLocalRing.maximalIdeal A = Ideal.span {π} ∧ IsUnit (c + c.transpose).det ∧ ∃ (x₀ : Spec (.of (wcQuadModelRing A n π c))), (∀ p, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈ PrimeSpectrum.asIdeal x₀) ∧ wcQuadModelStr A n π c x₀ = IsLocalRing.closedPoint A ∧ ∃ (B₀ : Type u) (_ : CommRing B₀) (_ : HenselianLocalRing B₀) (_ : IsSepClosed (IsLocalRing.ResidueField B₀)) (Λ₀ : Type u) (_ : SmallCategory Λ₀) (_ : IsCofiltered Λ₀) (W₀ : Λ₀ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (wcQuadModelRing A n π c))) x₀)) (Scheme.Etale.forget (Spec (.of (wcQuadModelRing A n π c))))) (φ₀ : ∀ l, Spec (.of B₀) ⟶ (W₀.obj l).right.left) (a₀ : Spec (.of B₀) ⟶ Spec (.of (wcQuadModelRing A n π c))), wcHalShData x₀ B₀ Λ₀ W₀ φ₀ a₀ ∧ ∃ θ : Spec (.of B) ≅ Spec (.of B₀), θ.hom ≫ a₀ ≫ wcQuadModelStr A n π c = a' ≫ Limits.pullback.snd D.f a :=
by
  intro F' F'' _ _ _ _ Y n hn hn2 D i A _ _ _ Λ _ _ W' φ a hA x hx B _ _ _ Λ' _ _ W'' φ' a' hB
  classical
  have comp_ap : ∀ {X Y Z : Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ Z) (x : X), (f ≫ g) x = g (f x) :=
    fun _ _ _ => rfl

  have hγ : ∀ (c : (wcP1Over F'').left)
      (x : Spec (.of (AlgebraicClosure ((wcP1Over F'').left.residueField c)))),
      wcEtGeomPt (wcP1Over F'').left c x = c := by
    intro c x
    first
    | exact Scheme.fromSpecResidueField_apply c _
    | (unfold wcEtGeomPt; rw [comp_ap]; exact Scheme.fromSpecResidueField_apply c _)
    | (simp only [wcEtGeomPt, comp_ap, Scheme.fromSpecResidueField_apply])
    | (simp [wcEtGeomPt])
  have hwN : ∀ (c : (wcP1Over F'').left)
      (N : StructuredArrow (Over.mk (wcEtGeomPt (wcP1Over F'').left c))
        (Scheme.Etale.forget (wcP1Over F'').left)),
      N.hom.left ≫ N.right.hom = wcEtGeomPt (wcP1Over F'').left c := fun c N => Over.w N.hom
  obtain ⟨l₁⟩ : Nonempty Λ := IsCofiltered.nonempty
  have hφa : ∀ l, φ l ≫ (W'.obj l).right.hom = a := hA.2.2.2.1
  have hcl := wc_shdata_closed_point_compat _ A Λ W' φ a hA l₁
  have ha_cl : a (IsLocalRing.closedPoint A) = D.S i (IsLocalRing.closedPoint F'') := by
    calc a (IsLocalRing.closedPoint A)
        = (φ l₁ ≫ (W'.obj l₁).right.hom) (IsLocalRing.closedPoint A) := by rw [hφa l₁]
      _ = (W'.obj l₁).right.hom (φ l₁ (IsLocalRing.closedPoint A)) := comp_ap _ _ _
      _ = (W'.obj l₁).right.hom ((W'.obj l₁).hom.left (IsLocalRing.closedPoint
            (AlgebraicClosure ((wcP1Over F'').left.residueField
              (D.S i (IsLocalRing.closedPoint F'')))))) := by rw [hcl]
      _ = ((W'.obj l₁).hom.left ≫ (W'.obj l₁).right.hom) (IsLocalRing.closedPoint
            (AlgebraicClosure ((wcP1Over F'').left.residueField
              (D.S i (IsLocalRing.closedPoint F''))))) := (comp_ap _ _ _).symm
      _ = D.S i (IsLocalRing.closedPoint F'') := by rw [hwN _ (W'.obj l₁)]; exact hγ _ _

  obtain ⟨j, β, hj, hjK, hjb⟩ := wc_morse_p1_rational_chart F'' (D.S i) (D.hS i)
  haveI := hj
  have hb : D.S i (IsLocalRing.closedPoint F'') =
      j (Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom β)) (IsLocalRing.closedPoint F'')) := by
    exact (congrArg (fun g => g (IsLocalRing.closedPoint F'')) hjb).symm

  have hrange : Set.range a ⊆ Set.range j := by
    rintro _ ⟨p, rfl⟩
    have h1 : a p ⤳ a (IsLocalRing.closedPoint A) :=
      (IsLocalRing.specializes_closedPoint p).map a.continuous
    rw [ha_cl, hb] at h1
    exact h1.mem_open (IsOpenImmersion.isOpen_range j) ⟨_, rfl⟩
  obtain ⟨aV, haV⟩ : ∃ aV : Spec (.of A) ⟶ Spec (.of (Polynomial F'')), aV ≫ j = a :=
    ⟨_, IsOpenImmersion.lift_fac j a hrange⟩

  obtain ⟨hdom, hdvr, hmax⟩ := wc_morse_shens_chart_dvr F'' j β hj _ hb A Λ W' φ a hA aV haV
  obtain ⟨ρ, rfl⟩ : ∃ ρ : Polynomial F'' →+* A, Spec.map (CommRingCat.ofHom ρ) = aV :=
    ⟨_, Spec.map_preimage aV⟩
  rw [Spec.preimage_map, CommRingCat.hom_ofHom] at hmax

  obtain ⟨U, u, φU, c, σ, hu, hφU, hc, hcomm, hσ, hT⟩ :=
    wc_morse_odp_etale_chart F' F'' Y n hn2 D i j β hj hjK hjb
  haveI : Etale u := hu
  haveI : Etale φU := hφU

  have hM := wc_morse_quad_model_isPullback F'' A n β c ρ
  have Lbc : ∀ {U Y P S M T V : Scheme.{u}} (u : U ⟶ Y) (f : Y ⟶ P) (a : S ⟶ P) (φ : U ⟶ T)
      (m1 : M ⟶ T) (m2 : M ⟶ S) (q : T ⟶ V) (aV : S ⟶ V) (j : V ⟶ P), u ≫ f = φ ≫ q ≫ j →
      aV ≫ j = a → IsPullback m1 m2 q aV →
      ∀ ψ : Limits.pullback u (Limits.pullback.fst f a) ⟶ M,
      ψ ≫ m1 = Limits.pullback.fst u (Limits.pullback.fst f a) ≫ φ →
      ψ ≫ m2 = Limits.pullback.snd u (Limits.pullback.fst f a) ≫ Limits.pullback.snd f a →
      IsPullback (Limits.pullback.fst u (Limits.pullback.fst f a)) ψ φ m1 := by
    intro U Y P S M T V u f a φ m1 m2 q aV j hc haV hM ψ h1 h2
    have hw : ∀ s : Limits.PullbackCone φ m1, (s.fst ≫ u) ≫ f = (s.snd ≫ m2) ≫ a := by
      intro s
      calc (s.fst ≫ u) ≫ f = s.fst ≫ φ ≫ q ≫ j := by rw [Category.assoc, hc]
        _ = (s.fst ≫ φ) ≫ q ≫ j := by rw [Category.assoc]
        _ = (s.snd ≫ m1) ≫ q ≫ j := by rw [s.condition]
        _ = s.snd ≫ (m1 ≫ q) ≫ j := by simp only [Category.assoc]
        _ = s.snd ≫ (m2 ≫ aV) ≫ j := by rw [hM.w]
        _ = (s.snd ≫ m2) ≫ aV ≫ j := by simp only [Category.assoc]
        _ = (s.snd ≫ m2) ≫ a := by rw [haV]
    refine IsPullback.of_isLimit (Limits.PullbackCone.IsLimit.mk h1.symm
      (fun s => Limits.pullback.lift s.fst
        (Limits.pullback.lift (s.fst ≫ u) (s.snd ≫ m2) (hw s))
        (Limits.pullback.lift_fst _ _ _).symm) ?_ ?_ ?_)
    · intro s
      exact Limits.pullback.lift_fst _ _ _
    · intro s
      try dsimp only
      apply hM.hom_ext
      · rw [Category.assoc, h1, ← Category.assoc, Limits.pullback.lift_fst, s.condition]
      · rw [Category.assoc, h2, ← Category.assoc, Limits.pullback.lift_snd,
          Limits.pullback.lift_snd]
    · intro s m' hm1 hm2
      try dsimp only
      apply Limits.pullback.hom_ext
      · rw [hm1, Limits.pullback.lift_fst]
      · rw [Limits.pullback.lift_snd]
        apply Limits.pullback.hom_ext
        · rw [Limits.pullback.lift_fst, Category.assoc, ← Limits.pullback.condition,
            ← Category.assoc, hm1]
        · rw [Limits.pullback.lift_snd, Category.assoc, ← h2, ← Category.assoc, hm2]
  have hw' : (Limits.pullback.fst u (Limits.pullback.fst D.f a) ≫ φU) ≫
      Spec.map (CommRingCat.ofHom (Polynomial.eval₂RingHom MvPolynomial.C (MvPolynomial.C β +
        ∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q))) =
      (Limits.pullback.snd u (Limits.pullback.fst D.f a) ≫ Limits.pullback.snd D.f a) ≫
        Spec.map (CommRingCat.ofHom ρ) := by
    rw [← cancel_mono j]
    simp only [Category.assoc]
    rw [haV, ← hcomm, Limits.pullback.condition_assoc, Limits.pullback.condition]
  obtain ⟨ψ, hψ1, hψ2⟩ : ∃ ψ : Limits.pullback u (Limits.pullback.fst D.f a) ⟶
      Spec (.of (wcQuadModelRing A n (ρ (Polynomial.X - Polynomial.C β))
        (c.map (ρ.comp Polynomial.C)))),
      ψ ≫ Spec.map (CommRingCat.ofHom ((Ideal.Quotient.mk (wcQuadModelIdeal A n
          (ρ (Polynomial.X - Polynomial.C β)) (c.map (ρ.comp Polynomial.C)))).comp
          (MvPolynomial.map (ρ.comp Polynomial.C)))) =
        Limits.pullback.fst u (Limits.pullback.fst D.f a) ≫ φU ∧
      ψ ≫ wcQuadModelStr A n (ρ (Polynomial.X - Polynomial.C β)) (c.map (ρ.comp Polynomial.C)) =
        Limits.pullback.snd u (Limits.pullback.fst D.f a) ≫ Limits.pullback.snd D.f a :=
    ⟨hM.lift _ _ hw', hM.lift_fst _ _ _, hM.lift_snd _ _ _⟩
  have hP := Lbc u D.f a φU _ _ _ _ j hcomm haV hM ψ hψ1 hψ2
  haveI : Etale ψ := MorphismProperty.of_isPullback (P := @Etale) hP hφU

  have hux : u (σ (IsLocalRing.closedPoint F'')) = Limits.pullback.fst D.f a x := by
    rw [hx]
    exact congrArg (fun g => g (IsLocalRing.closedPoint F'')) hσ
  obtain ⟨x', hx'1, hx'2⟩ :=
    Scheme.Pullback.exists_preimage_pullback (σ (IsLocalRing.closedPoint F'')) x hux
  have hm1x : (Spec.map (CommRingCat.ofHom ((Ideal.Quotient.mk (wcQuadModelIdeal A n
      (ρ (Polynomial.X - Polynomial.C β)) (c.map (ρ.comp Polynomial.C)))).comp
      (MvPolynomial.map (ρ.comp Polynomial.C))))) (ψ x') =
      φU (σ (IsLocalRing.closedPoint F'')) := by
    rw [← hx'1]
    exact congrArg (fun g => g x') hψ1
  have hTp : ∀ p, Ideal.Quotient.mk (wcQuadModelIdeal A n (ρ (Polynomial.X - Polynomial.C β))
      (c.map (ρ.comp Polynomial.C))) (MvPolynomial.X p) ∈ PrimeSpectrum.asIdeal (ψ x') := by
    intro p
    have h1 := hT p
    rw [← hm1x] at h1
    have h2 : Ideal.Quotient.mk (wcQuadModelIdeal A n (ρ (Polynomial.X - Polynomial.C β))
        (c.map (ρ.comp Polynomial.C))) (MvPolynomial.map (ρ.comp Polynomial.C)
          (MvPolynomial.X p)) ∈ PrimeSpectrum.asIdeal (ψ x') := h1
    rwa [MvPolynomial.map_X] at h2
  have hM2x : wcQuadModelStr A n (ρ (Polynomial.X - Polynomial.C β))
      (c.map (ρ.comp Polynomial.C)) (ψ x') = Limits.pullback.snd D.f a x := by
    rw [← hx'2]
    exact congrArg (fun g => g x') hψ2
  have hj_eq : j (Spec.map (CommRingCat.ofHom ρ) (Limits.pullback.snd D.f a x)) =
      j (Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom β)) (IsLocalRing.closedPoint F'')) := by
    calc j (Spec.map (CommRingCat.ofHom ρ) (Limits.pullback.snd D.f a x))
        = (Spec.map (CommRingCat.ofHom ρ) ≫ j) (Limits.pullback.snd D.f a x) := rfl
      _ = a (Limits.pullback.snd D.f a x) := by rw [haV]
      _ = (Limits.pullback.snd D.f a ≫ a) x := rfl
      _ = (Limits.pullback.fst D.f a ≫ D.f) x := by rw [Limits.pullback.condition]
      _ = D.f (D.xs i (IsLocalRing.closedPoint F'')) := by rw [comp_ap, hx]
      _ = (D.xs i ≫ D.f) (IsLocalRing.closedPoint F'') := rfl
      _ = D.S i (IsLocalRing.closedPoint F'') := by rw [D.hxs i]
      _ = j (Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom β))
            (IsLocalRing.closedPoint F'')) := hb
  have hinj := j.isOpenEmbedding.injective hj_eq
  have hπmem : ρ (Polynomial.X - Polynomial.C β) ∈ (Limits.pullback.snd D.f a x).asIdeal := by
    have h1 : (Polynomial.X - Polynomial.C β) ∈
        (Spec.map (CommRingCat.ofHom ρ) (Limits.pullback.snd D.f a x)).asIdeal := by
      rw [hinj]
      show Polynomial.evalRingHom β (Polynomial.X - Polynomial.C β) ∈
        (IsLocalRing.closedPoint F'').asIdeal
      simp
    exact h1
  have hfAx : Limits.pullback.snd D.f a x = IsLocalRing.closedPoint A := by
    apply PrimeSpectrum.ext
    apply le_antisymm
    · exact IsLocalRing.le_maximalIdeal (Ideal.IsPrime.ne_top (PrimeSpectrum.isPrime _))
    · show IsLocalRing.maximalIdeal A ≤ _
      rw [hmax, Ideal.span_le, Set.singleton_subset_iff]
      exact hπmem

  obtain ⟨B₀, _, _, _, Λ₀, _, _, W₀, φ₀, a₀, e₀, h01, h02, h03, h04, h05, h06, h07⟩ :=
    wc_et_geom_strict_henselization (ψ x')
  have hB₀ : wcHalShData (ψ x') B₀ Λ₀ W₀ φ₀ a₀ := ⟨h01, h02, h03, h04, h05, e₀, h06, h07⟩
  obtain ⟨B₁, _, _, _, Λ₁, _, _, W₁, φ₁, a₁, e₁, h11, h12, h13, h14, h15, h16, h17⟩ :=
    wc_et_geom_strict_henselization x'
  have hB₁ : wcHalShData x' B₁ Λ₁ W₁ φ₁ a₁ := ⟨h11, h12, h13, h14, h15, e₁, h16, h17⟩

  obtain ⟨ι₁, hι₁⟩ := wc_etale_geom_point_residue_iso
    (Limits.pullback.snd u (Limits.pullback.fst D.f a)) x' x hx'2
  obtain ⟨θ₁, hθ₁⟩ := wc_shdata_etale_iso (Limits.pullback.snd u (Limits.pullback.fst D.f a))
    x' x ι₁ hι₁ B₁ Λ₁ W₁ φ₁ a₁ hB₁ B Λ' W'' φ' a' hB
  obtain ⟨ι₂, hι₂⟩ := wc_etale_geom_point_residue_iso ψ x' (ψ x') rfl
  obtain ⟨θ₂, hθ₂⟩ := wc_shdata_etale_iso ψ x' (ψ x') ι₂ hι₂ B₁ Λ₁ W₁ φ₁ a₁ hB₁
    B₀ Λ₀ W₀ φ₀ a₀ hB₀

  have hc' : IsUnit ((c.map (ρ.comp Polynomial.C)) +
      (c.map (ρ.comp Polynomial.C)).transpose).det := by
    have h1 : (c.map (ρ.comp Polynomial.C)) + (c.map (ρ.comp Polynomial.C)).transpose =
        (ρ.comp Polynomial.C).mapMatrix (c + c.transpose) := by
      ext p q
      simp
    rw [h1, ← RingHom.map_det]
    exact (isUnit_iff_ne_zero.mpr hc).map _
  refine ⟨hdom, hdvr, ρ (Polynomial.X - Polynomial.C β), c.map (ρ.comp Polynomial.C), hmax, hc',
    ψ x', hTp, hM2x.trans hfAx, B₀, inferInstance, inferInstance, inferInstance, Λ₀,
    inferInstance, inferInstance, W₀, φ₀, a₀, hB₀, θ₁.symm ≪≫ θ₂, ?_⟩
  simp only [Iso.trans_hom, Iso.symm_hom, Category.assoc]
  rw [reassoc_of% hθ₂, hψ2, ← Category.assoc a₁, ← hθ₁]
  simp only [Category.assoc, Iso.inv_hom_id_assoc]

theorem wc_qm_quotient_gradedAlgebra : ∀ (A R : Type u) [CommRing A] [CommRing R] [Algebra A R] (𝒜 : ℕ → Submodule A R) [GradedAlgebra 𝒜] (I : Ideal R), I.IsHomogeneous 𝒜 → ∀ (ℬ : ℕ → Submodule A (R ⧸ I)), (∀ i, ℬ i = Submodule.map (Ideal.Quotient.mkₐ A I).toLinearMap (𝒜 i)) → Nonempty (GradedAlgebra ℬ) :=
by
  intro A R _ _ _ 𝒜 _ I hI ℬ hℬ
  obtain rfl : ℬ = fun i => Submodule.map (Ideal.Quotient.mkₐ A I).toLinearMap (𝒜 i) := funext hℬ
  have : SetLike.GradedMonoid (fun i => Submodule.map (Ideal.Quotient.mkₐ A I).toLinearMap (𝒜 i)) :=
    { one_mem := Submodule.mem_map.mpr ⟨1, SetLike.one_mem_graded 𝒜, by simp⟩
      mul_mem := fun i j a b ha hb => by
        obtain ⟨x, hx, rfl⟩ := Submodule.mem_map.mp ha
        obtain ⟨y, hy, rfl⟩ := Submodule.mem_map.mp hb
        exact Submodule.mem_map.mpr ⟨x * y, SetLike.mul_mem_graded hx hy, by simp⟩ }
  let Q : ∀ i, 𝒜 i →+ Submodule.map (Ideal.Quotient.mkₐ A I).toLinearMap (𝒜 i) := fun i =>
    ((Ideal.Quotient.mkₐ A I).toLinearMap.submoduleMap (𝒜 i)).toAddMonoidHom
  have hQ : ∀ i (x : 𝒜 i), ((Q i x : Submodule.map (Ideal.Quotient.mkₐ A I).toLinearMap (𝒜 i)) : R ⧸ I)
      = Ideal.Quotient.mk I (x : R) := fun i x => rfl
  have hcomm : ∀ w : DirectSum ℕ (fun i => 𝒜 i),
      DirectSum.coeAddMonoidHom (fun i => Submodule.map (Ideal.Quotient.mkₐ A I).toLinearMap (𝒜 i))
        (DirectSum.map Q w) = Ideal.Quotient.mk I (DirectSum.coeAddMonoidHom 𝒜 w) := by
    intro w
    induction w using DirectSum.induction_on with
    | zero => simp
    | of i x => rw [DirectSum.map_of, DirectSum.coeAddMonoidHom_of, DirectSum.coeAddMonoidHom_of, hQ]
    | add x y hx hy => rw [map_add, map_add, hx, hy, map_add, map_add]
  refine ⟨DirectSum.IsInternal.gradedAlgebra ⟨?_, ?_⟩⟩
  · rw [injective_iff_map_eq_zero]
    intro v hv
    obtain ⟨w, rfl⟩ := (DirectSum.map_surjective Q).mpr (fun i y => by
      obtain ⟨x, hx, hxy⟩ := Submodule.mem_map.mp y.2
      exact ⟨⟨x, hx⟩, Subtype.ext hxy⟩) v
    rw [hcomm, Ideal.Quotient.eq_zero_iff_mem] at hv
    have hdec : DirectSum.decompose 𝒜 (DirectSum.coeAddMonoidHom 𝒜 w) = w :=
      DirectSum.Decomposition.right_inv w
    have hmem := (Ideal.IsHomogeneous.mem_iff 𝒜 hI).mp hv
    rw [hdec] at hmem
    ext i
    rw [DirectSum.map_apply, DirectSum.zero_apply]
    rw [hQ, Submodule.coe_zero, Ideal.Quotient.eq_zero_iff_mem]
    exact hmem i
  · intro z
    obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective z
    refine ⟨DirectSum.map Q (DirectSum.decompose 𝒜 x), ?_⟩
    rw [hcomm]
    congr 1
    exact DirectSum.Decomposition.left_inv x

theorem wc_qm_away_deg_one_equiv : ∀ (R : Type u) {σ : Type u} [CommRing R] [SetLike σ R] [AddSubgroupClass σ R] (𝒜 : ℕ → σ) [GradedRing 𝒜] (f : R) (hf : f ∈ 𝒜 1), ∃ e : HomogeneousLocalization.Away 𝒜 f ≃+* R ⧸ Ideal.span {f - 1}, ∀ (m : ℕ) (a : R) (ha : a ∈ 𝒜 (m • 1)), e (HomogeneousLocalization.Away.mk 𝒜 hf m a ha) = Ideal.Quotient.mk (Ideal.span {f - 1}) a :=
by
  intro R σ _ _ _ 𝒜 _ f hf
  classical

  have hκf : Ideal.Quotient.mk (Ideal.span {f - 1}) f = 1 := by
    rw [← map_one (Ideal.Quotient.mk (Ideal.span {f - 1}))]
    exact (Ideal.Quotient.mk_eq_mk_iff_sub_mem f 1).mpr (Ideal.mem_span_singleton_self _)
  have hv : Ideal.Quotient.mk (Ideal.span {f - 1}) f * 1 = 1 := by rw [hκf, mul_one]
  let Φ : HomogeneousLocalization.Away 𝒜 f →+* R ⧸ Ideal.span {f - 1} :=
    (Localization.awayLift (Ideal.Quotient.mk (Ideal.span {f - 1})) f
      (IsUnit.of_mul_eq_one (1 : R ⧸ Ideal.span {f - 1}) hv)).comp
      (algebraMap (HomogeneousLocalization.Away 𝒜 f) (Localization.Away f))
  have hΦ : ∀ (m : ℕ) (a : R) (ha : a ∈ 𝒜 (m • 1)),
      Φ (HomogeneousLocalization.Away.mk 𝒜 hf m a ha) = Ideal.Quotient.mk (Ideal.span {f - 1}) a := by
    intro m a ha
    simp only [Φ, RingHom.comp_apply, HomogeneousLocalization.algebraMap_apply,
      HomogeneousLocalization.Away.val_mk]
    rw [Localization.awayLift_mk (Ideal.Quotient.mk (Ideal.span {f - 1})) f a 1 hv m, one_pow,
      mul_one]

  let g : ∀ i : ℕ, ↥(𝒜 i) →+ HomogeneousLocalization.Away 𝒜 f := fun i =>
    AddMonoidHom.mk' (fun x => HomogeneousLocalization.Away.mk 𝒜 hf i (x : R)
      (by rw [smul_eq_mul, mul_one]; exact x.2)) (by
      intro x y
      apply HomogeneousLocalization.val_injective
      simp only [HomogeneousLocalization.val_add, HomogeneousLocalization.Away.val_mk,
        AddMemClass.coe_add]
      rw [Localization.add_mk_self])
  have hg : ∀ (i : ℕ) (x : ↥(𝒜 i)), g i x = HomogeneousLocalization.Away.mk 𝒜 hf i (x : R)
      (by rw [smul_eq_mul, mul_one]; exact x.2) := fun i x => rfl
  have hone : g 0 (GradedMonoid.GOne.one (A := fun k => ↥(𝒜 k))) = 1 := by
    rw [hg]
    apply HomogeneousLocalization.val_injective
    rw [HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.val_one, SetLike.coe_gOne]
    convert Localization.mk_self (⟨f ^ 0, 0, rfl⟩ : Submonoid.powers f) using 2
    simp
  have hmul : ∀ {i j : ℕ} (x : ↥(𝒜 i)) (y : ↥(𝒜 j)),
      g (i + j) (GradedMonoid.GMul.mul (A := fun k => ↥(𝒜 k)) x y) = g i x * g j y := by
    intro i j x y
    rw [hg, hg, hg]
    apply HomogeneousLocalization.val_injective
    rw [HomogeneousLocalization.val_mul, HomogeneousLocalization.Away.val_mk,
      HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.Away.val_mk,
      SetLike.coe_gMul, Localization.mk_mul]
    congr 1
    exact Subtype.ext (pow_add f i j)
  let μ : R →+* HomogeneousLocalization.Away 𝒜 f :=
    (DirectSum.toSemiring g hone hmul).comp (DirectSum.decomposeRingEquiv 𝒜).toRingHom
  have hμ : ∀ (m : ℕ) (a : R) (ha : a ∈ 𝒜 (m • 1)),
      μ a = HomogeneousLocalization.Away.mk 𝒜 hf m a ha := by
    intro m a ha
    have ha' : a ∈ 𝒜 m := by rwa [smul_eq_mul, mul_one] at ha
    show DirectSum.toSemiring g hone hmul (DirectSum.decompose 𝒜 a) = _
    rw [DirectSum.decompose_of_mem 𝒜 ha', DirectSum.toSemiring_of]
    rfl

  have hμf : μ f = 1 := by
    rw [hμ 1 f (by rw [smul_eq_mul, mul_one]; exact hf)]
    apply HomogeneousLocalization.val_injective
    rw [HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.val_one]
    convert Localization.mk_self (⟨f ^ 1, 1, rfl⟩ : Submonoid.powers f) using 2
    simp
  have hker : ∀ x ∈ Ideal.span {f - 1}, μ x = 0 := by
    intro x hx
    obtain ⟨t, rfl⟩ := Ideal.mem_span_singleton'.mp hx
    rw [map_mul, map_sub, map_one, hμf, sub_self, mul_zero]
  let Ψ : R ⧸ Ideal.span {f - 1} →+* HomogeneousLocalization.Away 𝒜 f :=
    Ideal.Quotient.lift (Ideal.span {f - 1}) μ hker
  have hΨ : ∀ x : R, Ψ (Ideal.Quotient.mk (Ideal.span {f - 1}) x) = μ x := fun x =>
    Ideal.Quotient.lift_mk _ _ _
  have h1 : Ψ.comp Φ = RingHom.id _ := by
    apply RingHom.ext
    intro z
    obtain ⟨n, a, ha, rfl⟩ := HomogeneousLocalization.Away.mk_surjective 𝒜 hf z
    rw [RingHom.comp_apply, hΦ, hΨ, hμ, RingHom.id_apply]
  have hΦμ : ∀ x : R, Φ (μ x) = Ideal.Quotient.mk (Ideal.span {f - 1}) x := by
    intro x
    induction x using DirectSum.Decomposition.inductionOn 𝒜 with
    | zero => simp
    | @homogeneous i m =>
      have hm : (m : R) ∈ 𝒜 (i • 1) := by rw [smul_eq_mul, mul_one]; exact m.2
      rw [hμ i _ hm, hΦ]
    | add x y hx hy => rw [map_add, map_add, hx, hy, map_add]
  have h2 : Φ.comp Ψ = RingHom.id _ := by
    apply Ideal.Quotient.ringHom_ext
    apply RingHom.ext
    intro x
    rw [RingHom.comp_apply, RingHom.comp_apply, hΨ, hΦμ, RingHom.comp_apply, RingHom.id_apply]
  exact ⟨RingEquiv.ofRingHom Φ Ψ h2 h1, fun m a ha => hΦ m a ha⟩

theorem wc_qm_mvpoly_dehomog_equiv : ∀ (A : Type u) [CommRing A] {ι κ : Type} (G : MvPolynomial ι A) (a : ι) (s : ι → MvPolynomial κ A) (t : κ → ι), s a = 1 → (∀ k, s (t k) = MvPolynomial.X k) → (∀ i, i ≠ a → ∃ k, t k = i) → ∃ e : ((MvPolynomial ι A ⧸ Ideal.span {G}) ⧸ (Ideal.span {Ideal.Quotient.mk (Ideal.span {G}) (MvPolynomial.X a) - 1} : Ideal (MvPolynomial ι A ⧸ Ideal.span {G}))) ≃ₐ[A] MvPolynomial κ A ⧸ Ideal.span {MvPolynomial.aeval s G}, ∀ x : MvPolynomial ι A, e (Ideal.Quotient.mk _ (Ideal.Quotient.mk (Ideal.span {G}) x)) = Ideal.Quotient.mk (Ideal.span {MvPolynomial.aeval s G}) (MvPolynomial.aeval s x) :=
by
  intro A _ ι κ G a s t h1 h2 h3
  let I : Ideal (MvPolynomial ι A) := Ideal.span {G}
  let J : Ideal (MvPolynomial ι A ⧸ I) :=
    Ideal.span {Ideal.Quotient.mk I (MvPolynomial.X a) - 1}
  let K : Ideal (MvPolynomial κ A) := Ideal.span {MvPolynomial.aeval s G}
  let π : MvPolynomial ι A →ₐ[A] (MvPolynomial ι A ⧸ I) ⧸ J :=
    (Ideal.Quotient.mkₐ A J).comp (Ideal.Quotient.mkₐ A I)
  have hπ : ∀ x, π x = Ideal.Quotient.mk J (Ideal.Quotient.mk I x) := fun x => rfl
  have hπa : π (MvPolynomial.X a) = 1 := by
    rw [hπ, ← map_one (Ideal.Quotient.mk J), Ideal.Quotient.eq]
    exact Ideal.subset_span rfl

  let φ₀ : MvPolynomial ι A →ₐ[A] MvPolynomial κ A ⧸ K :=
    (Ideal.Quotient.mkₐ A K).comp (MvPolynomial.aeval s)
  have hφ₀ : ∀ x ∈ I, φ₀ x = 0 := by
    intro x hx
    obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp hx
    have hG : φ₀ G = 0 := by
      show Ideal.Quotient.mk K (MvPolynomial.aeval s G) = 0
      exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
    rw [map_mul, hG, mul_zero]
  let φ₁ : (MvPolynomial ι A ⧸ I) →ₐ[A] MvPolynomial κ A ⧸ K := Ideal.Quotient.liftₐ I φ₀ hφ₀
  have hφ₁ : ∀ x, φ₁ (Ideal.Quotient.mk I x) =
      Ideal.Quotient.mk K (MvPolynomial.aeval s x) := fun x => rfl
  have hφ₁J : ∀ x ∈ J, φ₁ x = 0 := by
    intro x hx
    obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp hx
    rw [map_mul, map_sub, map_one, hφ₁, MvPolynomial.aeval_X, h1, map_one, sub_self, mul_zero]
  let φ : ((MvPolynomial ι A ⧸ I) ⧸ J) →ₐ[A] MvPolynomial κ A ⧸ K :=
    Ideal.Quotient.liftₐ J φ₁ hφ₁J
  have hφ : ∀ x, φ (π x) = Ideal.Quotient.mk K (MvPolynomial.aeval s x) := fun x => rfl

  let ψ₀ : MvPolynomial κ A →ₐ[A] (MvPolynomial ι A ⧸ I) ⧸ J :=
    MvPolynomial.aeval (fun k => π (MvPolynomial.X (t k)))
  have hψX : ∀ k, ψ₀ (MvPolynomial.X k) = π (MvPolynomial.X (t k)) :=
    fun k => MvPolynomial.aeval_X _ k
  have hkey : ψ₀.comp (MvPolynomial.aeval s) = π := by
    apply MvPolynomial.algHom_ext
    intro i
    rw [AlgHom.comp_apply, MvPolynomial.aeval_X]
    by_cases hi : i = a
    · subst hi
      rw [h1, map_one, hπa]
    · obtain ⟨k, rfl⟩ := h3 i hi
      rw [h2, hψX]
  have hψ₀ : ∀ x ∈ K, ψ₀ x = 0 := by
    intro x hx
    obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp hx
    have hG : ψ₀ (MvPolynomial.aeval s G) = 0 := by
      rw [← AlgHom.comp_apply, hkey, hπ,
        Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl : G ∈ I), map_zero]
    rw [map_mul, hG]
    exact mul_zero (ψ₀ c)
  let ψ : (MvPolynomial κ A ⧸ K) →ₐ[A] (MvPolynomial ι A ⧸ I) ⧸ J :=
    Ideal.Quotient.liftₐ K ψ₀ hψ₀
  have hψ : ∀ y, ψ (Ideal.Quotient.mk K y) = ψ₀ y := fun y => rfl
  have h6 : φ.comp ψ = AlgHom.id A _ := by
    apply Ideal.Quotient.algHom_ext A
    apply MvPolynomial.algHom_ext
    intro k
    simp only [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk, AlgHom.id_apply]
    rw [hψ, hψX, hφ, MvPolynomial.aeval_X, h2]
  have h7 : ψ.comp φ = AlgHom.id A _ := by
    apply Ideal.Quotient.algHom_ext A
    apply Ideal.Quotient.algHom_ext A
    apply AlgHom.ext
    intro x
    show ψ (φ (π x)) = π x
    rw [hφ, hψ, ← AlgHom.comp_apply, hkey]
  exact ⟨AlgEquiv.ofAlgHom φ ψ h6 h7, fun x => rfl⟩

theorem wc_qm_proj_deg_one_chart : ∀ (A S R' : Type u) [CommRing A] [CommRing S] [Algebra A S] [CommRing R'] [Algebra A R'] (ℬ : ℕ → Submodule A S) [GradedAlgebra ℬ] (f : S) (hf : f ∈ ℬ 1) (ε : HomogeneousLocalization.Away ℬ f ≃+* R') (φ : S →+* R'), (∀ (m : ℕ) (x : S) (hx : x ∈ ℬ (m • 1)), ε (HomogeneousLocalization.Away.mk ℬ hf m x hx) = φ x) → (∀ a : A, φ (algebraMap A S a) = algebraMap A R' a) → IsOpenImmersion (Spec.map (CommRingCat.ofHom (ε : HomogeneousLocalization.Away ℬ f →+* R')) ≫ Proj.awayι ℬ f hf one_pos) ∧ (Spec.map (CommRingCat.ofHom (ε : HomogeneousLocalization.Away ℬ f →+* R')) ≫ Proj.awayι ℬ f hf one_pos) ≫ (Proj.toSpecZero ℬ ≫ Spec.map (CommRingCat.ofHom (algebraMap A ↥(ℬ 0)))) = Spec.map (CommRingCat.ofHom (algebraMap A R')) ∧ Set.range (Spec.map (CommRingCat.ofHom (ε : HomogeneousLocalization.Away ℬ f →+* R')) ≫ Proj.awayι ℬ f hf one_pos) = (Proj.basicOpen ℬ f : Set (Proj ℬ)) ∧ ∀ g : S, g ∈ ℬ 1 → ∀ x' : Spec (.of R'), ((Spec.map (CommRingCat.ofHom (ε : HomogeneousLocalization.Away ℬ f →+* R')) ≫ Proj.awayι ℬ f hf one_pos) x' ∈ Proj.basicOpen ℬ g ↔ φ g ∉ x'.asIdeal) :=
by
  intro A S R' _ _ _ _ _ ℬ _ f hf ε φ hε hφ
  have hE : IsIso (Spec.map (CommRingCat.ofHom (ε : HomogeneousLocalization.Away ℬ f →+* R'))) := by
    change IsIso (Spec.map ε.toCommRingCatIso.hom)
    infer_instance
  have hJ : IsOpenImmersion (Spec.map (CommRingCat.ofHom (ε : HomogeneousLocalization.Away ℬ f →+* R')) ≫ Proj.awayι ℬ f hf one_pos) := inferInstance
  refine ⟨hJ, ?_, ?_, ?_⟩
  · rw [Category.assoc, ← Category.assoc (Proj.awayι ℬ f hf one_pos), Proj.awayι_toSpecZero,
      ← Spec.map_comp, ← Spec.map_comp]
    congr 1
    ext a
    simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.coe_comp, Function.comp_apply,
      RingHom.coe_coe]
    have h0 : algebraMap A S a ∈ ℬ (0 • 1) := by
      rw [zero_smul]; exact SetLike.algebraMap_mem_graded ℬ a
    have key : HomogeneousLocalization.fromZeroRingHom ℬ (Submonoid.powers f)
        (algebraMap A ↥(ℬ 0) a) = HomogeneousLocalization.Away.mk ℬ hf 0 (algebraMap A S a) h0 := by
      apply HomogeneousLocalization.val_injective
      rw [HomogeneousLocalization.Away.val_mk]
      first
        | rfl
        | (erw [HomogeneousLocalization.val_mk]; simp)
    rw [key, hε, hφ]
  · ext y
    constructor
    · rintro ⟨x, rfl⟩
      rw [← Proj.opensRange_awayι ℬ f hf one_pos, Scheme.Hom.comp_apply]
      exact ⟨_, rfl⟩
    · intro hy
      rw [← Proj.opensRange_awayι ℬ f hf one_pos] at hy
      obtain ⟨z, rfl⟩ := hy
      obtain ⟨x, hx⟩ := (ConcreteCategory.bijective_of_isIso
        (Spec.map (CommRingCat.ofHom (ε : HomogeneousLocalization.Away ℬ f →+* R'))).base).2 z
      exact ⟨x, by rw [Scheme.Hom.comp_apply]; exact congrArg _ hx⟩
  · intro g hg x'
    rw [Scheme.Hom.comp_apply, ← Scheme.Hom.mem_preimage,
      Proj.awayι_preimage_basicOpen ℬ hf one_pos hg one_pos]
    refine (PrimeSpectrum.mem_basicOpen _ _).trans ?_
    rw [Spec.map_apply]
    have : ε (HomogeneousLocalization.Away.isLocalizationElem hf hg) = φ g := by
      rw [HomogeneousLocalization.Away.isLocalizationElem, hε, pow_one]
    change ¬ ((ε : HomogeneousLocalization.Away ℬ f →+* R')
      (HomogeneousLocalization.Away.isLocalizationElem hf hg) ∈ x'.asIdeal) ↔ _
    rw [RingHom.coe_coe, this]

theorem wc_qm_proj_quotient_mvpoly_proper : ∀ (A : Type u) [CommRing A] (σ : Type) [Finite σ] (I : Ideal (MvPolynomial σ A)) (ℬ : ℕ → Submodule A (MvPolynomial σ A ⧸ I)), (∀ i, ℬ i = Submodule.map (Ideal.Quotient.mkₐ A I).toLinearMap (MvPolynomial.homogeneousSubmodule σ A i)) → ∀ [GradedAlgebra ℬ], IsProper (Proj.toSpecZero ℬ ≫ Spec.map (CommRingCat.ofHom (algebraMap A ↥(ℬ 0)))) :=
by
  intro A _ σ _ I ℬ hℬ _
  haveI : IsScalarTower A (ℬ 0) (MvPolynomial σ A ⧸ I) :=
    IsScalarTower.of_algebraMap_eq (S := ℬ 0) (fun x => (SetLike.GradeZero.coe_algebraMap ℬ x).symm)
  haveI : Algebra.FiniteType (ℬ 0) (MvPolynomial σ A ⧸ I) :=
    Algebra.FiniteType.of_restrictScalars_finiteType A (ℬ 0) _
  have hsurj : Function.Surjective (algebraMap A (ℬ 0)) := by
    intro y
    have hy : (y : MvPolynomial σ A ⧸ I) ∈ Submodule.map (Ideal.Quotient.mkₐ A I).toLinearMap
        (MvPolynomial.homogeneousSubmodule σ A 0) := by
      rw [← hℬ 0]; exact y.2
    obtain ⟨p, hp, hpy⟩ := Submodule.mem_map.mp hy
    have hp0 : p = MvPolynomial.C (p.coeff 0) := by
      rw [← MvPolynomial.homogeneousComponent_zero p,
        MvPolynomial.homogeneousComponent_of_mem hp, if_pos rfl]
    refine ⟨p.coeff 0, Subtype.ext ?_⟩
    rw [SetLike.GradeZero.coe_algebraMap, ← hpy, hp0]
    simp [MvPolynomial.algebraMap_eq]
  haveI : IsClosedImmersion (Spec.map (CommRingCat.ofHom (algebraMap A (ℬ 0)))) :=
    IsClosedImmersion.spec_of_surjective _ (by simpa using hsurj)
  infer_instance

theorem wc_qm_affine_partial_nonvanishing : ∀ (A : Type u) [CommRing A] [IsLocalRing A] (n : ℕ) (π : A) (c : Matrix (Fin n) (Fin n) A), IsLocalRing.maximalIdeal A = Ideal.span {π} → IsUnit (c + c.transpose).det → ∀ (x₀ x : Spec (.of (wcQuadModelRing A n π c))), (∀ p, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈ PrimeSpectrum.asIdeal x₀) → x ≠ x₀ → ∃ r : Fin n, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.pderiv r (∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q - MvPolynomial.C π)) ∉ PrimeSpectrum.asIdeal x :=
by
  intro A _ _ n π c hπ hc x₀ x hx₀ hne
  classical
  by_contra H
  push_neg at H
  set G : MvPolynomial (Fin n) A := ∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p *
    MvPolynomial.X q - MvPolynomial.C π with hGdef
  set mk := Ideal.Quotient.mk (wcQuadModelIdeal A n π c) with hmk

  have term : ∀ (r p q : Fin n), MvPolynomial.pderiv r
      (MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q : MvPolynomial (Fin n) A) =
      (if p = r then MvPolynomial.C (c p q) * MvPolynomial.X q else 0) +
      (if q = r then MvPolynomial.C (c p q) * MvPolynomial.X p else 0) := by
    intro r p q
    rw [Derivation.leibniz, Derivation.leibniz, MvPolynomial.pderiv_C, MvPolynomial.pderiv_X,
      MvPolynomial.pderiv_X]
    simp only [Pi.single_apply, smul_eq_mul, smul_zero, add_zero]
    split_ifs <;> ring
  have s1 : ∀ r : Fin n, MvPolynomial.pderiv r G =
      ∑ j, MvPolynomial.C ((c + c.transpose) r j) * MvPolynomial.X j := by
    intro r
    rw [hGdef, map_sub, MvPolynomial.pderiv_C, sub_zero, map_sum]
    simp only [map_sum, term, Finset.sum_add_distrib]
    rw [Finset.sum_comm (f := fun p q => if p = r then MvPolynomial.C (c p q) * MvPolynomial.X q
      else 0)]
    simp only [Finset.sum_ite_eq', Finset.mem_univ, ite_true, Matrix.add_apply,
      Matrix.transpose_apply, map_add, add_mul]
    rw [← Finset.sum_add_distrib]

  have hXa : ∀ a, mk (MvPolynomial.X a) ∈ x.asIdeal := by
    intro a
    set M := c + c.transpose with hM
    have e : MvPolynomial.C M.det * MvPolynomial.X a =
        ∑ r, MvPolynomial.C (M.adjugate a r) * MvPolynomial.pderiv r G := by
      simp_rw [s1, Finset.mul_sum, ← mul_assoc, ← map_mul]
      rw [Finset.sum_comm]
      simp_rw [← Finset.sum_mul, ← map_sum, ← Matrix.mul_apply, Matrix.adjugate_mul,
        Matrix.smul_apply, Matrix.one_apply, smul_eq_mul, mul_ite, mul_one, mul_zero]
      rw [Finset.sum_eq_single a]
      · simp
      · intro b _ hb
        simp [Ne.symm hb]
      · simp
    have hmem : mk (MvPolynomial.C M.det) * mk (MvPolynomial.X a) ∈ x.asIdeal := by
      rw [← map_mul, e, map_sum]
      exact Ideal.sum_mem _ fun r _ => by rw [map_mul]; exact Ideal.mul_mem_left _ _ (H r)
    rcases x.isPrime.mem_or_mem hmem with h | h
    · exact absurd (Ideal.eq_top_of_isUnit_mem _ h ((hc.map MvPolynomial.C).map mk))
        x.isPrime.ne_top
    · exact h

  have key : ∀ P : Ideal (wcQuadModelRing A n π c), P.IsPrime →
      (∀ i, mk (MvPolynomial.X i) ∈ P) → ∀ p, mk p ∈ P ↔
        MvPolynomial.constantCoeff p ∈ IsLocalRing.maximalIdeal A := by
    intro P hP hX
    have ha : ∀ p, mk p - mk (MvPolynomial.C (MvPolynomial.constantCoeff p)) ∈ P := by
      intro p
      induction p using MvPolynomial.induction_on with
      | C a => simp
      | add p q hp hq =>
        have := P.add_mem hp hq
        convert this using 1
        simp only [map_add]
        ring
      | mul_X p i hp =>
        simp only [map_mul, MvPolynomial.constantCoeff_X, mul_zero, map_zero, sub_zero]
        exact P.mul_mem_left _ (hX i)
    have hπP : mk (MvPolynomial.C π) ∈ P := by
      have hG : mk G = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
      rw [hGdef, map_sub, sub_eq_zero] at hG
      rw [← hG, map_sum]
      refine P.sum_mem fun p _ => ?_
      rw [map_sum]
      refine P.sum_mem fun q _ => ?_
      rw [map_mul]
      exact P.mul_mem_left _ (hX q)
    have hC : ∀ a : A, mk (MvPolynomial.C a) ∈ P ↔ a ∈ IsLocalRing.maximalIdeal A := by
      intro a
      constructor
      · intro h
        by_contra ha'
        have hu : IsUnit a := by
          rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, not_not] at ha'
          exact ha'
        exact hP.ne_top (Ideal.eq_top_of_isUnit_mem _ h ((hu.map MvPolynomial.C).map mk))
      · intro h
        rw [hπ, Ideal.mem_span_singleton'] at h
        obtain ⟨t, rfl⟩ := h
        rw [map_mul, map_mul]
        exact P.mul_mem_left _ hπP
    intro p
    rw [← hC]
    constructor
    · intro h
      have := P.sub_mem h (ha p)
      simpa using this
    · intro h
      have := P.add_mem (ha p) h
      simpa using this
  apply hne
  apply PrimeSpectrum.ext
  ext r
  obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective r
  rw [key _ x.isPrime hXa, key _ x₀.isPrime hx₀]

theorem wc_qm_hypersurface_smooth_of_partial : ∀ (A : Type u) [CommRing A] (n : ℕ) (G : MvPolynomial (Fin n) A) (x : Spec (.of (MvPolynomial (Fin n) A ⧸ Ideal.span {G}))) (r : Fin n), Ideal.Quotient.mk (Ideal.span {G}) (MvPolynomial.pderiv r G) ∉ PrimeSpectrum.asIdeal x → ∃ U : (Spec (.of (MvPolynomial (Fin n) A ⧸ Ideal.span {G}))).Opens, x ∈ U ∧ Smooth (U.ι ≫ Spec.map (CommRingCat.ofHom (algebraMap A (MvPolynomial (Fin n) A ⧸ Ideal.span {G})))) :=
by
  intro A _ n G x r hr
  classical

  have jac : ∀ (m : ℕ) (F : Fin m → MvPolynomial (Fin n) A) (ι : Fin m → Fin n),
      Function.Injective ι → ∀ e : MvPolynomial (Fin n) A ⧸ Ideal.span (Set.range F),
      IsUnit (algebraMap (MvPolynomial (Fin n) A ⧸ Ideal.span (Set.range F)) (Localization.Away e)
        (Ideal.Quotient.mk (Ideal.span (Set.range F))
          (Matrix.of fun i j : Fin m => MvPolynomial.pderiv (ι i) (F j)).det)) →
      Algebra.Smooth A (Localization.Away e) := by
    intro m F ι hι e h
    let P : Algebra.PreSubmersivePresentation A (MvPolynomial (Fin n) A ⧸ Ideal.span (Set.range F))
        (Fin n) (Fin m) :=
      Algebra.PreSubmersivePresentation.mk (Algebra.Presentation.naive (v := F)) ι hι
    have hval : ∀ y : MvPolynomial (Fin n) A,
        algebraMap P.Ring (MvPolynomial (Fin n) A ⧸ Ideal.span (Set.range F)) y =
          Ideal.Quotient.mk (Ideal.span (Set.range F)) y := by
      intro y
      rw [Algebra.Generators.algebraMap_apply]
      have hh : MvPolynomial.aeval P.val = Ideal.Quotient.mkₐ A (Ideal.span (Set.range F)) := by
        apply MvPolynomial.algHom_ext
        intro i
        rw [MvPolynomial.aeval_X, Ideal.Quotient.mkₐ_eq_mk]
        rfl
      exact congrArg (fun f => f y) hh
    have hPj : P.jacobian = Ideal.Quotient.mk (Ideal.span (Set.range F))
        (Matrix.of fun i j : Fin m => MvPolynomial.pderiv (ι i) (F j)).det := by
      rw [Algebra.PreSubmersivePresentation.jacobian_eq_jacobiMatrix_det]
      have hmat : P.jacobiMatrix = Matrix.of fun i j : Fin m => MvPolynomial.pderiv (ι i) (F j) := by
        ext i j
        rw [Algebra.PreSubmersivePresentation.jacobiMatrix_apply]
        rfl
      rw [hmat]
      exact hval _
    let Q := Algebra.PreSubmersivePresentation.localizationAway (Localization.Away e) e
    let C := Q.comp P
    have hC : C.jacobian = algebraMap _ (Localization.Away e) P.jacobian *
        algebraMap _ (Localization.Away e) e := by
      rw [Algebra.PreSubmersivePresentation.comp_jacobian_eq_jacobian_smul_jacobian, Algebra.smul_def,
        Algebra.PreSubmersivePresentation.localizationAway_jacobian]
    have hunit : IsUnit C.jacobian := by
      rw [hC, hPj]
      exact h.mul (IsLocalization.Away.algebraMap_isUnit e)
    have : Algebra.IsStandardSmooth A (Localization.Away e) :=
      (Algebra.SubmersivePresentation.mk C hunit).isStandardSmooth
    infer_instance

  have hS : Set.range ![G] = {G} := by
    rw [Matrix.range_cons, Matrix.range_empty, Set.union_empty]
  have key := jac 1 ![G] ![r] (Function.injective_of_subsingleton _)
  rw [hS] at key
  set R := MvPolynomial (Fin n) A ⧸ Ideal.span {G} with hR
  set e : R := Ideal.Quotient.mk (Ideal.span {G}) (MvPolynomial.pderiv r G) with he
  have hsm : Algebra.Smooth A (Localization.Away e) := by
    apply key e
    have hd : (Matrix.of fun i j : Fin 1 => MvPolynomial.pderiv (![r] i) (![G] j)).det =
        MvPolynomial.pderiv r G := by
      rw [Matrix.det_fin_one]; rfl
    rw [hd]
    exact IsLocalization.Away.algebraMap_isUnit e

  let S := Localization.Away e
  let U : (Spec (.of R)).Opens := PrimeSpectrum.basicOpen e
  let ι₁ : Spec (.of S) ⟶ Spec (.of R) := Spec.map (CommRingCat.ofHom (algebraMap R S))
  have : IsOpenImmersion ι₁ := IsOpenImmersion.of_isLocalization e
  have hrange : Set.range U.ι = Set.range ι₁ := by
    rw [Scheme.Opens.range_ι]
    have h1 : Set.range ι₁ = Set.range (PrimeSpectrum.comap (algebraMap R S)) := rfl
    rw [h1, PrimeSpectrum.localization_away_comap_range S e]
    rfl
  let θ := IsOpenImmersion.isoOfRangeEq U.ι ι₁ hrange
  have hθ : θ.hom ≫ ι₁ = U.ι := IsOpenImmersion.isoOfRangeEq_hom_fac U.ι ι₁ hrange
  refine ⟨U, hr, ?_⟩
  have hmor : U.ι ≫ Spec.map (CommRingCat.ofHom (algebraMap A R)) =
      θ.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap A S)) := by
    rw [← hθ, Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp,
      ← IsScalarTower.algebraMap_eq A R S]
  rw [hmor]
  have : Smooth (Spec.map (CommRingCat.ofHom (algebraMap A S))) := by
    rw [HasRingHomProperty.Spec_iff (P := @Smooth)]
    exact RingHom.smooth_algebraMap.mpr hsm
  infer_instance

theorem wc_qm_quotient_irrelevant_le_span_X : ∀ (A : Type u) [CommRing A] (σ : Type) (I : Ideal (MvPolynomial σ A)) (ℬ : ℕ → Submodule A (MvPolynomial σ A ⧸ I)), (∀ i, ℬ i = Submodule.map (Ideal.Quotient.mkₐ A I).toLinearMap (MvPolynomial.homogeneousSubmodule σ A i)) → ∀ [GradedAlgebra ℬ], (HomogeneousIdeal.irrelevant ℬ).toIdeal ≤ Ideal.span (Set.range fun i : σ => Ideal.Quotient.mk I (MvPolynomial.X i)) :=
by
  intro A _ σ I ℬ hℬ _
  classical
  have hhom : ∀ (d : ℕ), d ≠ 0 → ∀ p : MvPolynomial σ A, p.IsHomogeneous d →
      Ideal.Quotient.mk I p ∈
        Ideal.span (Set.range fun i : σ => Ideal.Quotient.mk I (MvPolynomial.X i)) := by
    intro d hd p hp
    have hp' : p ∈ Ideal.span (MvPolynomial.X '' (Set.univ : Set σ)) := by
      rw [MvPolynomial.mem_ideal_span_X_image]
      intro m hm
      have hm0 : m ≠ 0 := by
        rintro rfl
        have hc := hp.coeff_eq_zero (d := 0) (by simpa using Ne.symm hd)
        exact (MvPolynomial.mem_support_iff.mp hm) hc
      obtain ⟨i, hi⟩ := Finsupp.ne_iff.mp hm0
      exact ⟨i, Set.mem_univ i, by simpa using hi⟩
    have hle : Ideal.span (MvPolynomial.X '' (Set.univ : Set σ)) ≤
        Ideal.comap (Ideal.Quotient.mk I)
          (Ideal.span (Set.range fun i : σ => Ideal.Quotient.mk I (MvPolynomial.X i))) := by
      rw [Ideal.span_le]
      rintro _ ⟨i, -, rfl⟩
      exact Ideal.mem_comap.mpr (Ideal.subset_span ⟨i, rfl⟩)
    exact Ideal.mem_comap.mp (hle hp')
  have hpos : ∀ d : ℕ, d ≠ 0 → ∀ y ∈ ℬ d,
      y ∈ Ideal.span (Set.range fun i : σ => Ideal.Quotient.mk I (MvPolynomial.X i)) := by
    intro d hd y hy
    rw [hℬ d, Submodule.mem_map] at hy
    obtain ⟨p, hp, rfl⟩ := hy
    exact hhom d hd p ((MvPolynomial.mem_homogeneousSubmodule d p).mp hp)
  intro x hx
  have h0 : ((DirectSum.decompose ℬ x 0 : ℬ 0) : MvPolynomial σ A ⧸ I) = 0 := by
    rw [HomogeneousIdeal.mem_iff, HomogeneousIdeal.mem_irrelevant_iff,
      GradedRing.proj_apply] at hx
    exact hx
  rw [← DirectSum.sum_support_decompose ℬ x]
  apply Ideal.sum_mem
  intro i _
  by_cases hi : i = 0
  · subst hi
    rw [h0]
    exact Ideal.zero_mem _
  · exact hpos i hi _ (SetLike.coe_mem _)

theorem wc_qm_boundary_partial_nonvanishing : ∀ (A : Type u) [CommRing A] (n : ℕ) (π : A) (c : Matrix (Fin n) (Fin n) A), IsUnit (c + c.transpose).det → ∀ (a : Fin n) (P : Ideal ((MvPolynomial (Option (Fin n)) A ⧸ Ideal.span {∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X (some p) * MvPolynomial.X (some q) - MvPolynomial.C π * MvPolynomial.X none ^ 2}) ⧸ Ideal.span {Ideal.Quotient.mk (Ideal.span {∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X (some p) * MvPolynomial.X (some q) - MvPolynomial.C π * MvPolynomial.X none ^ 2}) (MvPolynomial.X (some a)) - 1})), P.IsPrime → Ideal.Quotient.mk _ (Ideal.Quotient.mk (Ideal.span {∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X (some p) * MvPolynomial.X (some q) - MvPolynomial.C π * MvPolynomial.X none ^ 2}) (MvPolynomial.X none)) ∈ P → ∃ r : Fin n, r ≠ a ∧ Ideal.Quotient.mk _ (Ideal.Quotient.mk (Ideal.span {∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X (some p) * MvPolynomial.X (some q) - MvPolynomial.C π * MvPolynomial.X none ^ 2}) (MvPolynomial.pderiv (some r) (∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X (some p) * MvPolynomial.X (some q) - MvPolynomial.C π * MvPolynomial.X none ^ 2))) ∉ P :=
by
  intro A _ n π c hM a P hP hZ
  by_contra hcon
  push_neg at hcon

  have hD : ∀ r : Fin n, MvPolynomial.pderiv (some r) (∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X (some p) * MvPolynomial.X (some q) - MvPolynomial.C π * MvPolynomial.X none ^ 2 : MvPolynomial (Option (Fin n)) A) = ∑ j, MvPolynomial.C ((c + c.transpose) r j) * MvPolynomial.X (some j) := by
    intro r
    simp only [map_sub, map_sum, Derivation.leibniz, Derivation.leibniz_pow, MvPolynomial.pderiv_C,
      MvPolynomial.pderiv_X, Pi.single_apply, Option.some.injEq, smul_eq_mul, mul_zero,
      add_zero, mul_one, mul_ite, reduceCtorEq, ite_false, sub_zero, smul_zero,
      Finset.sum_add_distrib, Finset.sum_ite_eq', Finset.mem_univ, ite_true]
    simp only [Finset.sum_ite_irrel, Finset.sum_const_zero, Finset.sum_ite_eq', Finset.mem_univ,
      ite_true, Matrix.add_apply, Matrix.transpose_apply, map_add,
      add_mul, Finset.sum_add_distrib]
    rw [← Finset.sum_add_distrib, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    ring
  have hE : ∑ r, (MvPolynomial.X (some r) : MvPolynomial (Option (Fin n)) A) * ∑ j, MvPolynomial.C ((c + c.transpose) r j) * MvPolynomial.X (some j) = 2 * ∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X (some p) * MvPolynomial.X (some q) := by
    have h1 : ∀ r j, (MvPolynomial.X (some r) : MvPolynomial (Option (Fin n)) A) * (MvPolynomial.C ((c + c.transpose) r j) * MvPolynomial.X (some j)) = MvPolynomial.C (c r j) * MvPolynomial.X (some r) * MvPolynomial.X (some j) + MvPolynomial.C (c j r) * MvPolynomial.X (some j) * MvPolynomial.X (some r) := by
      intro r j
      rw [Matrix.add_apply, Matrix.transpose_apply, map_add]
      ring
    rw [two_mul]
    simp only [Finset.mul_sum, h1, Finset.sum_add_distrib]
    congr 1
    exact Finset.sum_comm
  have hAdj : ∑ r, MvPolynomial.C ((c + c.transpose).adjugate a r) * ∑ j, MvPolynomial.C ((c + c.transpose) r j) * (MvPolynomial.X (some j) : MvPolynomial (Option (Fin n)) A) = MvPolynomial.C (c + c.transpose).det * MvPolynomial.X (some a) := by
    calc ∑ r, MvPolynomial.C ((c + c.transpose).adjugate a r) * ∑ j, MvPolynomial.C ((c + c.transpose) r j) * (MvPolynomial.X (some j) : MvPolynomial (Option (Fin n)) A)
        = ∑ j, MvPolynomial.C (((c + c.transpose).adjugate * (c + c.transpose)) a j) * (MvPolynomial.X (some j) : MvPolynomial (Option (Fin n)) A) := by
          simp only [Finset.mul_sum, Matrix.mul_apply, map_sum, Finset.sum_mul, ← mul_assoc, map_mul]
          exact Finset.sum_comm
      _ = MvPolynomial.C (c + c.transpose).det * MvPolynomial.X (some a) := by
          rw [Matrix.adjugate_mul]
          simp only [Matrix.smul_apply, Matrix.one_apply, smul_eq_mul, mul_ite, mul_one, mul_zero,
            apply_ite MvPolynomial.C, map_zero, ite_mul, zero_mul, Finset.sum_ite_eq,
            Finset.mem_univ, ite_true]

  have key : ∀ (B : Type u) [CommRing B] (κ : MvPolynomial (Option (Fin n)) A →+* B) (Q : Ideal B),
      Q.IsPrime →
      κ (∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X (some p) * MvPolynomial.X (some q) - MvPolynomial.C π * MvPolynomial.X none ^ 2) = 0 →
      κ (MvPolynomial.X (some a)) = 1 → κ (MvPolynomial.X none) ∈ Q →
      (∀ r, r ≠ a → κ (∑ j, MvPolynomial.C ((c + c.transpose) r j) * MvPolynomial.X (some j)) ∈ Q) →
      False := by
    intro B _ κ Q hQp hG0 hTa hZ' hL
    have hQ : κ (∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X (some p) * MvPolynomial.X (some q)) ∈ Q := by
      have h1 : κ (∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X (some p) * MvPolynomial.X (some q)) = κ (MvPolynomial.C π) * κ (MvPolynomial.X none) ^ 2 := by
        have h := hG0
        rw [map_sub, map_mul, map_pow, sub_eq_zero] at h
        exact h
      rw [h1]
      exact Q.mul_mem_left _ (Ideal.pow_mem_of_mem Q hZ' 2 two_pos)
    have hsum : ∑ r, κ (MvPolynomial.X (some r)) * κ (∑ j, MvPolynomial.C ((c + c.transpose) r j) * MvPolynomial.X (some j)) ∈ Q := by
      have h := congrArg κ hE
      rw [map_sum, map_mul] at h
      simp only [map_mul] at h
      rw [h]
      exact Q.mul_mem_left _ hQ
    rw [← Finset.add_sum_erase _ _ (Finset.mem_univ a), hTa, one_mul] at hsum
    have hrest : ∑ r ∈ Finset.univ.erase a, κ (MvPolynomial.X (some r)) * κ (∑ j, MvPolynomial.C ((c + c.transpose) r j) * MvPolynomial.X (some j)) ∈ Q :=
      Ideal.sum_mem _ (fun r hr => Q.mul_mem_left _ (hL r (Finset.ne_of_mem_erase hr)))
    have hLa := (Ideal.add_mem_iff_left Q hrest).mp hsum
    have hall : ∀ r, κ (∑ j, MvPolynomial.C ((c + c.transpose) r j) * MvPolynomial.X (some j)) ∈ Q := by
      intro r
      by_cases hr : r = a
      · subst hr; exact hLa
      · exact hL r hr
    have hdet : κ (MvPolynomial.C (c + c.transpose).det) ∈ Q := by
      have h := congrArg κ hAdj
      rw [map_sum] at h
      simp only [map_mul] at h
      rw [hTa, mul_one] at h
      rw [← h]
      exact Ideal.sum_mem _ (fun r _ => Q.mul_mem_left _ (hall r))
    have hunit : IsUnit (κ (MvPolynomial.C (c + c.transpose).det)) := (hM.map MvPolynomial.C).map κ
    exact hQp.ne_top (Ideal.eq_top_of_isUnit_mem Q hdet hunit)
  refine key ((MvPolynomial (Option (Fin n)) A ⧸ Ideal.span {∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X (some p) * MvPolynomial.X (some q) - MvPolynomial.C π * MvPolynomial.X none ^ 2}) ⧸ Ideal.span {Ideal.Quotient.mk (Ideal.span {∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X (some p) * MvPolynomial.X (some q) - MvPolynomial.C π * MvPolynomial.X none ^ 2}) (MvPolynomial.X (some a)) - 1})
    ((Ideal.Quotient.mk _).comp (Ideal.Quotient.mk _)) P hP ?_ ?_ ?_ ?_
  · rw [RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _),
      map_zero]
  · rw [RingHom.comp_apply]
    have h := Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self
      (Ideal.Quotient.mk (Ideal.span {(∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X (some p) * MvPolynomial.X (some q) - MvPolynomial.C π * MvPolynomial.X none ^ 2 : MvPolynomial (Option (Fin n)) A)}) (MvPolynomial.X (some a)) - 1))
    rw [map_sub, map_one, sub_eq_zero] at h
    exact h
  · exact hZ
  · intro r hr
    have h := hcon r hr
    rw [hD r] at h
    exact h

theorem wc_qm_chart_partial_etale : ∀ (A : Type u) [CommRing A] (n : ℕ) (G : MvPolynomial (Option (Fin n)) A) (a r : Fin n), a ≠ r → ∀ (β : Fin (n - 2) → Fin n), Function.Injective β → (∀ i, β i ≠ a ∧ β i ≠ r) → (∀ b, b ≠ a → b ≠ r → ∃ i, β i = b) → RingHom.Etale ((algebraMap ((MvPolynomial (Option (Fin n)) A ⧸ Ideal.span {G}) ⧸ Ideal.span {Ideal.Quotient.mk (Ideal.span {G}) (MvPolynomial.X (some a)) - 1}) (Localization.Away (Ideal.Quotient.mk (Ideal.span {Ideal.Quotient.mk (Ideal.span {G}) (MvPolynomial.X (some a)) - 1}) (Ideal.Quotient.mk (Ideal.span {G}) (MvPolynomial.pderiv (some r) G))))).comp (MvPolynomial.aeval (R := A) (fun o : Option (Fin (n - 2)) => Option.elim o (Ideal.Quotient.mk (Ideal.span {Ideal.Quotient.mk (Ideal.span {G}) (MvPolynomial.X (some a)) - 1}) (Ideal.Quotient.mk (Ideal.span {G}) (MvPolynomial.X none))) (fun i => Ideal.Quotient.mk (Ideal.span {Ideal.Quotient.mk (Ideal.span {G}) (MvPolynomial.X (some a)) - 1}) (Ideal.Quotient.mk (Ideal.span {G}) (MvPolynomial.X (some (β i))))))).toRingHom) :=
by
  set_option maxSynthPendingDepth 3 in
  set_option synthInstance.maxHeartbeats 400000 in
  intro A _ n G a r har β hβinj hβne hβsurj
  classical

  have std : ∀ (R : Type u) [CommRing R] {ι σ : Type} [Fintype ι] [Fintype σ] [DecidableEq σ]
      (mp : σ → ι), Function.Bijective mp → ∀ (f : σ → MvPolynomial ι R) (g : MvPolynomial ι R),
      g * (Matrix.of fun i j => MvPolynomial.pderiv (mp i) (f j)).det - 1 ∈ Ideal.span (Set.range f) →
      Algebra.Etale R (MvPolynomial ι R ⧸ Ideal.span (Set.range f)) := by
    intro R _ ι σ _ _ _ mp hbij f g hg
    let P : Algebra.PreSubmersivePresentation R (MvPolynomial ι R ⧸ Ideal.span (Set.range f)) ι σ :=
      { Algebra.Presentation.naive (v := f) with map := mp, map_inj := hbij.1 }
    have hJ : P.jacobiMatrix = Matrix.of fun i j => MvPolynomial.pderiv (mp i) (f j) := by
      ext i j
      rw [Algebra.PreSubmersivePresentation.jacobiMatrix_apply]
      rfl
    have halg : ∀ x : MvPolynomial ι R,
        algebraMap P.Ring (MvPolynomial ι R ⧸ Ideal.span (Set.range f)) x =
          Ideal.Quotient.mk (Ideal.span (Set.range f)) x := fun x => rfl
    have hunit : IsUnit P.jacobian := by
      rw [Algebra.PreSubmersivePresentation.jacobian_eq_jacobiMatrix_det, hJ, halg]
      have h1 : Ideal.Quotient.mk (Ideal.span (Set.range f))
          (g * (Matrix.of fun i j => MvPolynomial.pderiv (mp i) (f j)).det) = 1 := by
        rw [← map_one (Ideal.Quotient.mk (Ideal.span (Set.range f))), Ideal.Quotient.eq]
        exact hg
      rw [map_mul, mul_comm] at h1
      exact IsUnit.of_mul_eq_one _ h1
    let Q : Algebra.SubmersivePresentation R (MvPolynomial ι R ⧸ Ideal.span (Set.range f)) ι σ :=
      { P with jacobian_isUnit := hunit }
    have hdim : Q.dimension = 0 := by
      show Nat.card ι - Nat.card σ = 0
      rw [Nat.card_eq_of_bijective mp hbij, Nat.sub_self]
    haveI := Q.isStandardSmoothOfRelativeDimension hdim
    infer_instance

  have chain : ∀ (P : Type u) [CommRing P] [Algebra A P] {σ κ : Type}
      (s : σ → MvPolynomial κ P) (k : κ) (D : Derivation A (MvPolynomial σ A) (MvPolynomial σ A)),
      (∀ v, MvPolynomial.pderiv k (s v) = MvPolynomial.aeval s (D (MvPolynomial.X v))) →
      ∀ H : MvPolynomial σ A,
        MvPolynomial.pderiv k (MvPolynomial.aeval s H) = MvPolynomial.aeval s (D H) := by
    intro P _ _ σ κ s k D hD H
    induction H using MvPolynomial.induction_on with
    | C x =>
      have h1 : D (MvPolynomial.C x) = 0 := D.map_algebraMap x
      rw [h1, map_zero, MvPolynomial.aeval_C, MvPolynomial.algebraMap_apply, MvPolynomial.pderiv_C]
    | add p q hp hq =>
      rw [map_add, map_add, map_add, map_add, hp, hq]
    | mul_X p v hp =>
      simp only [map_mul, map_add, MvPolynomial.aeval_X, Derivation.leibniz, smul_eq_mul]
      rw [hp, hD v]
      try ring

  let I : Ideal (MvPolynomial (Option (Fin n)) A) := Ideal.span {G}
  let I2 : Ideal (MvPolynomial (Option (Fin n)) A ⧸ I) :=
    Ideal.span {Ideal.Quotient.mk I (MvPolynomial.X (some a)) - 1}
  let δ : ((MvPolynomial (Option (Fin n)) A ⧸ I) ⧸ I2) := Ideal.Quotient.mk I2 (Ideal.Quotient.mk I (MvPolynomial.pderiv (some r) G))
  let alg := algebraMap ((MvPolynomial (Option (Fin n)) A ⧸ I) ⧸ I2) (Localization.Away δ)
  let γ := MvPolynomial.eval₂Hom (σ := Option (Fin (n - 2))) (algebraMap A ((MvPolynomial (Option (Fin n)) A ⧸ I) ⧸ I2)) (fun o : Option (Fin (n - 2)) =>
    Option.elim o (Ideal.Quotient.mk I2 (Ideal.Quotient.mk I (MvPolynomial.X none)))
      (fun i => Ideal.Quotient.mk I2 (Ideal.Quotient.mk I (MvPolynomial.X (some (β i))))))
  have hγC : ∀ x : A, γ (MvPolynomial.C x) = algebraMap A ((MvPolynomial (Option (Fin n)) A ⧸ I) ⧸ I2) x := fun x => MvPolynomial.eval₂Hom_C _ _ _
  have hγZ : γ (MvPolynomial.X none) =
      Ideal.Quotient.mk I2 (Ideal.Quotient.mk I (MvPolynomial.X none)) := MvPolynomial.eval₂Hom_X' _ _ _
  have hγX : ∀ i, γ (MvPolynomial.X (some i)) =
      Ideal.Quotient.mk I2 (Ideal.Quotient.mk I (MvPolynomial.X (some (β i)))) :=
    fun i => MvPolynomial.eval₂Hom_X' _ _ _
  have hκC : ∀ x : A, γ (MvPolynomial.C x) =
      Ideal.Quotient.mk I2 (Ideal.Quotient.mk I (MvPolynomial.C x)) := by
    intro x
    rw [hγC, ← MvPolynomial.algebraMap_eq, Ideal.Quotient.mk_algebraMap,
      Ideal.Quotient.mk_algebraMap]
  have hκa : Ideal.Quotient.mk I2 (Ideal.Quotient.mk I (MvPolynomial.X (some a))) = 1 := by
    rw [← map_one (Ideal.Quotient.mk I2), Ideal.Quotient.eq]
    exact Ideal.mem_span_singleton_self _
  have hκG : Ideal.Quotient.mk I2 (Ideal.Quotient.mk I G) = 0 := by
    have hG : Ideal.Quotient.mk I G = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self G)
    rw [hG, map_zero]
  have hcases : ∀ b, b = a ∨ b = r ∨ ∃ i, β i = b := by
    intro b
    by_cases hba : b = a
    · exact Or.inl hba
    by_cases hbr : b = r
    · exact Or.inr (Or.inl hbr)
    exact Or.inr (Or.inr (hβsurj b hba hbr))

  let s : Option (Fin n) → MvPolynomial (Fin 2) (MvPolynomial (Option (Fin (n - 2))) A) := fun o => Option.elim o
    (MvPolynomial.C (MvPolynomial.X none))
    (fun b => if b = a then 1 else if b = r then MvPolynomial.X 0 else
      if hb : ∃ i, β i = b then MvPolynomial.C (MvPolynomial.X (some (Classical.choose hb))) else 0)
  have hs_none : s none = MvPolynomial.C (MvPolynomial.X none) := rfl
  have hs_a : s (some a) = 1 := by
    show (if a = a then (1 : MvPolynomial (Fin 2) (MvPolynomial (Option (Fin (n - 2))) A)) else _) = 1
    rw [if_pos rfl]
  have hs_r : s (some r) = MvPolynomial.X 0 := by
    show (if r = a then (1 : MvPolynomial (Fin 2) (MvPolynomial (Option (Fin (n - 2))) A)) else
      if r = r then MvPolynomial.X 0 else _) = _
    rw [if_neg (Ne.symm har), if_pos rfl]
  have hchoose : ∀ i (hb : ∃ j, β j = β i), Classical.choose hb = i :=
    fun i hb => hβinj (Classical.choose_spec hb)
  have hs_β : ∀ i, s (some (β i)) = MvPolynomial.C (MvPolynomial.X (some i)) := by
    intro i
    show (if β i = a then (1 : MvPolynomial (Fin 2) (MvPolynomial (Option (Fin (n - 2))) A)) else if β i = r then MvPolynomial.X 0 else
      if hb : ∃ j, β j = β i then MvPolynomial.C (MvPolynomial.X (some (Classical.choose hb)))
      else 0) = _
    rw [if_neg (hβne i).1, if_neg (hβne i).2, dif_pos ⟨i, rfl⟩, hchoose]

  have hD0 : ∀ v, MvPolynomial.pderiv (0 : Fin 2) (s v) =
      MvPolynomial.aeval s (MvPolynomial.pderiv (some r)
        (MvPolynomial.X v : MvPolynomial (Option (Fin n)) A)) := by
    intro v
    rw [MvPolynomial.pderiv_X]
    cases v with
    | none => rw [hs_none]; simp [Pi.single_apply]
    | some b =>
      rcases hcases b with hb | hb | ⟨i, hi⟩
      · rw [hb, hs_a]; simp [Pi.single_apply, har]
      · rw [hb, hs_r]; simp [Pi.single_apply, MvPolynomial.pderiv_X]
      · rw [← hi, hs_β]; simp [Pi.single_apply, (hβne i).2]
  have hD1 : ∀ v, MvPolynomial.pderiv (1 : Fin 2) (s v) = MvPolynomial.aeval s
      ((0 : Derivation A (MvPolynomial (Option (Fin n)) A) (MvPolynomial (Option (Fin n)) A))
        (MvPolynomial.X v)) := by
    intro v
    rw [Derivation.zero_apply, map_zero]
    cases v with
    | none => rw [hs_none, MvPolynomial.pderiv_C]
    | some b =>
      rcases hcases b with hb | hb | ⟨i, hi⟩
      · rw [hb, hs_a, Derivation.map_one_eq_zero]
      · rw [hb, hs_r]; simp [Pi.single_apply, MvPolynomial.pderiv_X]
      · rw [← hi, hs_β, MvPolynomial.pderiv_C]
  let h : MvPolynomial (Fin 2) (MvPolynomial (Option (Fin (n - 2))) A) := MvPolynomial.aeval s G
  let d : MvPolynomial (Fin 2) (MvPolynomial (Option (Fin (n - 2))) A) := MvPolynomial.aeval s (MvPolynomial.pderiv (some r) G)
  have hd0 : MvPolynomial.pderiv 0 h = d := chain (MvPolynomial (Option (Fin (n - 2))) A) s 0 (MvPolynomial.pderiv (some r)) hD0 G
  have hd1 : MvPolynomial.pderiv 1 h = 0 := by
    have := chain (MvPolynomial (Option (Fin (n - 2))) A) s 1 0 hD1 G
    rw [Derivation.zero_apply, map_zero] at this
    exact this
  have hdd : MvPolynomial.pderiv 1 d = 0 := by
    have := chain (MvPolynomial (Option (Fin (n - 2))) A) s 1 0 hD1 (MvPolynomial.pderiv (some r) G)
    rw [Derivation.zero_apply, map_zero] at this
    exact this

  let J : Ideal (MvPolynomial (Fin 2) (MvPolynomial (Option (Fin (n - 2))) A)) := Ideal.span (Set.range ![h, d * MvPolynomial.X 1 - 1])
  have hJ0 : h ∈ J := Ideal.subset_span ⟨0, rfl⟩
  have hJ1 : d * MvPolynomial.X 1 - 1 ∈ J := Ideal.subset_span ⟨1, rfl⟩
  have hEet : Algebra.Etale (MvPolynomial (Option (Fin (n - 2))) A) (MvPolynomial (Fin 2) (MvPolynomial (Option (Fin (n - 2))) A) ⧸ J) := by
    refine std (MvPolynomial (Option (Fin (n - 2))) A) id Function.bijective_id ![h, d * MvPolynomial.X 1 - 1] (MvPolynomial.X 1 ^ 2) ?_
    have hdet : (Matrix.of fun i j => MvPolynomial.pderiv (id i)
        (![h, d * MvPolynomial.X 1 - 1] j)).det = d * d := by
      rw [Matrix.det_fin_two]
      simp only [Matrix.of_apply, id_eq, Matrix.cons_val_zero, Matrix.cons_val_one,
        Matrix.head_cons]
      rw [hd0, hd1]
      simp [Derivation.leibniz, hdd, MvPolynomial.pderiv_X, Pi.single_apply]
    rw [hdet]
    have := J.mul_mem_left (d * MvPolynomial.X 1 + 1) hJ1
    convert this using 1
    ring
  let σs : MvPolynomial (Option (Fin n)) A →+* MvPolynomial (Fin 2) (MvPolynomial (Option (Fin (n - 2))) A) :=
    MvPolynomial.eval₂Hom (algebraMap A _) s
  have hσs : ∀ x, σs x = MvPolynomial.aeval s x := fun x => rfl

  let y0 : (Localization.Away δ) := alg (Ideal.Quotient.mk I2 (Ideal.Quotient.mk I (MvPolynomial.X (some r))))
  let y1 : (Localization.Away δ) := IsLocalization.Away.invSelf δ
  let Φ := MvPolynomial.eval₂Hom (σ := Fin 2) ((alg).comp γ) ![y0, y1]
  have hΦC : ∀ p, Φ (MvPolynomial.C p) = alg (γ p) := fun p => MvPolynomial.eval₂Hom_C _ _ _
  have hΦX0 : Φ (MvPolynomial.X 0) =
      alg (Ideal.Quotient.mk I2 (Ideal.Quotient.mk I (MvPolynomial.X (some r)))) :=
    MvPolynomial.eval₂Hom_X' _ _ _
  have hΦX1 : Φ (MvPolynomial.X 1) = (IsLocalization.Away.invSelf δ : (Localization.Away δ)) :=
    MvPolynomial.eval₂Hom_X' _ _ _
  have K1 : Φ.comp σs =
      (alg).comp ((Ideal.Quotient.mk I2).comp (Ideal.Quotient.mk I)) := by
    apply MvPolynomial.ringHom_ext
    · intro x
      simp only [RingHom.comp_apply]
      rw [hσs, MvPolynomial.aeval_C, MvPolynomial.algebraMap_apply, hΦC]
      exact congrArg (alg) (hκC x)
    · intro v
      simp only [RingHom.comp_apply]
      rw [hσs, MvPolynomial.aeval_X]
      cases v with
      | none => rw [hs_none, hΦC, hγZ]
      | some b =>
        rcases hcases b with hb | hb | ⟨i, hi⟩
        · rw [hb, hs_a, map_one, hκa, map_one]
        · rw [hb, hs_r, hΦX0]
        · rw [← hi, hs_β, hΦC, hγX]
  have K1' : ∀ x, Φ (MvPolynomial.aeval s x) =
      alg (Ideal.Quotient.mk I2 (Ideal.Quotient.mk I x)) :=
    fun x => RingHom.congr_fun K1 x
  have hJker : J ≤ RingHom.ker Φ := by
    apply Ideal.span_le.mpr
    rintro _ ⟨j, rfl⟩
    rw [SetLike.mem_coe, RingHom.mem_ker]
    fin_cases j
    · show Φ (MvPolynomial.aeval s G) = 0
      rw [K1', hκG, map_zero]
    · show Φ (MvPolynomial.aeval s (MvPolynomial.pderiv (some r) G) * MvPolynomial.X 1 - 1) = 0
      rw [map_sub, map_mul, map_one, K1', hΦX1]
      exact sub_eq_zero.mpr (IsLocalization.Away.mul_invSelf δ)
  let Φb : (MvPolynomial (Fin 2) (MvPolynomial (Option (Fin (n - 2))) A) ⧸ J) →+* (Localization.Away δ) := Ideal.Quotient.lift J Φ (fun x hx => RingHom.mem_ker.mp (hJker hx))
  have hΦb : ∀ x, Φb (Ideal.Quotient.mk J x) = Φ x := fun x => rfl

  have hJh : Ideal.Quotient.mk J (MvPolynomial.aeval s G) = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.mpr hJ0
  have hJd : Ideal.Quotient.mk J (MvPolynomial.aeval s (MvPolynomial.pderiv (some r) G)) *
      Ideal.Quotient.mk J (MvPolynomial.X 1) = 1 := by
    rw [← map_mul, ← sub_eq_zero, ← map_one (Ideal.Quotient.mk J), ← map_sub]
    exact Ideal.Quotient.eq_zero_iff_mem.mpr hJ1
  let Ψ0 : MvPolynomial (Option (Fin n)) A →+* (MvPolynomial (Fin 2) (MvPolynomial (Option (Fin (n - 2))) A) ⧸ J) :=
    (Ideal.Quotient.mk J).comp σs
  have hΨ0 : ∀ x, Ψ0 x = Ideal.Quotient.mk J (MvPolynomial.aeval s x) := fun x => rfl
  let Ψ1' : (MvPolynomial (Option (Fin n)) A ⧸ I) →+* (MvPolynomial (Fin 2) (MvPolynomial (Option (Fin (n - 2))) A) ⧸ J) := Ideal.Quotient.lift I Ψ0 (by
    intro x hx
    obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp hx
    rw [map_mul, hΨ0 G, hJh, mul_zero])
  have hΨ1' : ∀ x, Ψ1' (Ideal.Quotient.mk I x) = Ideal.Quotient.mk J (MvPolynomial.aeval s x) :=
    fun x => rfl
  let Ψ1 : ((MvPolynomial (Option (Fin n)) A ⧸ I) ⧸ I2) →+* (MvPolynomial (Fin 2) (MvPolynomial (Option (Fin (n - 2))) A) ⧸ J) := Ideal.Quotient.lift I2 Ψ1' (by
    intro x hx
    obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp hx
    rw [map_mul, map_sub, map_one, hΨ1', MvPolynomial.aeval_X, hs_a, map_one, sub_self, mul_zero])
  have hΨ1 : ∀ x, Ψ1 (Ideal.Quotient.mk I2 (Ideal.Quotient.mk I x)) =
      Ideal.Quotient.mk J (MvPolynomial.aeval s x) := fun x => rfl
  have hΨδ : Ψ1 δ = Ideal.Quotient.mk J (MvPolynomial.aeval s (MvPolynomial.pderiv (some r) G)) :=
    hΨ1 (MvPolynomial.pderiv (some r) G)
  have hunit : IsUnit (Ψ1 δ) := by
    rw [hΨδ]
    exact IsUnit.of_mul_eq_one _ hJd
  let Ψ : (Localization.Away δ) →+* (MvPolynomial (Fin 2) (MvPolynomial (Option (Fin (n - 2))) A) ⧸ J) := IsLocalization.Away.lift δ hunit
  have hΨalg : ∀ b, Ψ (alg b) = Ψ1 b := fun b => IsLocalization.Away.lift_eq δ hunit b

  have hγΨ : Ψ1.comp γ = (Ideal.Quotient.mk J).comp MvPolynomial.C := by
    apply MvPolynomial.ringHom_ext
    · intro x
      simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, AlgHom.coe_toRingHom]
      rw [hκC, hΨ1, MvPolynomial.aeval_C, MvPolynomial.algebraMap_apply]
      rfl
    · intro o
      simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, AlgHom.coe_toRingHom]
      cases o with
      | none => rw [hγZ, hΨ1, MvPolynomial.aeval_X, hs_none]
      | some i => rw [hγX, hΨ1, MvPolynomial.aeval_X, hs_β]
  have hcomp1 : Ψ.comp Φb = RingHom.id (MvPolynomial (Fin 2) (MvPolynomial (Option (Fin (n - 2))) A) ⧸ J) := by
    apply Ideal.Quotient.ringHom_ext
    apply MvPolynomial.ringHom_ext
    · intro p
      simp only [RingHom.comp_apply, RingHom.id_apply]
      rw [hΦb, hΦC, hΨalg]
      exact RingHom.congr_fun hγΨ p
    · intro j
      simp only [RingHom.comp_apply, RingHom.id_apply]
      rw [hΦb]
      fin_cases j
      · show Ψ (Φ (MvPolynomial.X 0)) = Ideal.Quotient.mk J (MvPolynomial.X 0)
        rw [hΦX0, hΨalg, hΨ1, MvPolynomial.aeval_X, hs_r]
      · show Ψ (Φ (MvPolynomial.X 1)) = Ideal.Quotient.mk J (MvPolynomial.X 1)
        rw [hΦX1]
        have hΨδ' : Ψ (alg δ) =
            Ideal.Quotient.mk J (MvPolynomial.aeval s (MvPolynomial.pderiv (some r) G)) :=
          (hΨalg δ).trans hΨδ
        have hu : Ideal.Quotient.mk J (MvPolynomial.aeval s (MvPolynomial.pderiv (some r) G)) *
            Ψ (IsLocalization.Away.invSelf δ) = 1 := by
          rw [← hΨδ', ← map_mul, IsLocalization.Away.mul_invSelf δ, map_one]
        calc Ψ (IsLocalization.Away.invSelf δ)
            = Ψ (IsLocalization.Away.invSelf δ) *
                (Ideal.Quotient.mk J (MvPolynomial.aeval s (MvPolynomial.pderiv (some r) G)) *
                  Ideal.Quotient.mk J (MvPolynomial.X 1)) := by rw [hJd, mul_one]
          _ = (Ideal.Quotient.mk J (MvPolynomial.aeval s (MvPolynomial.pderiv (some r) G)) *
                Ψ (IsLocalization.Away.invSelf δ)) * Ideal.Quotient.mk J (MvPolynomial.X 1) := by
              ring
          _ = Ideal.Quotient.mk J (MvPolynomial.X 1) := by rw [hu, one_mul]
  have hcomp2 : Φb.comp Ψ = RingHom.id (Localization.Away δ) := by
    apply IsLocalization.ringHom_ext (Submonoid.powers δ)
    apply Ideal.Quotient.ringHom_ext
    apply Ideal.Quotient.ringHom_ext
    apply RingHom.ext
    intro x
    simp only [RingHom.comp_apply, RingHom.id_apply]
    rw [hΨalg, hΨ1, hΦb, K1']

  let Θ : (MvPolynomial (Fin 2) (MvPolynomial (Option (Fin (n - 2))) A) ⧸ J) ≃+* (Localization.Away δ) := RingEquiv.ofRingHom Φb Ψ hcomp2 hcomp1
  have hEt : (algebraMap (MvPolynomial (Option (Fin (n - 2))) A) (MvPolynomial (Fin 2) (MvPolynomial (Option (Fin (n - 2))) A) ⧸ J)).Etale := RingHom.etale_algebraMap.mpr hEet
  have h2 := RingHom.Etale.respectsIso.1 (algebraMap (MvPolynomial (Option (Fin (n - 2))) A) (MvPolynomial (Fin 2) (MvPolynomial (Option (Fin (n - 2))) A) ⧸ J)) Θ hEt
  have hp : ∀ p : (MvPolynomial (Option (Fin (n - 2))) A), algebraMap (MvPolynomial (Option (Fin (n - 2))) A) (MvPolynomial (Fin 2) (MvPolynomial (Option (Fin (n - 2))) A) ⧸ J) p = Ideal.Quotient.mk J (MvPolynomial.C p) := fun p => rfl
  have heq : Θ.toRingHom.comp (algebraMap (MvPolynomial (Option (Fin (n - 2))) A) (MvPolynomial (Fin 2) (MvPolynomial (Option (Fin (n - 2))) A) ⧸ J)) =
      (alg).comp (MvPolynomial.aeval (R := A) (fun o : Option (Fin (n - 2)) =>
        Option.elim o (Ideal.Quotient.mk I2 (Ideal.Quotient.mk I (MvPolynomial.X none)))
          (fun i => Ideal.Quotient.mk I2
            (Ideal.Quotient.mk I (MvPolynomial.X (some (β i))))))).toRingHom := by
    apply RingHom.ext
    intro p
    show Φb (algebraMap (MvPolynomial (Option (Fin (n - 2))) A) (MvPolynomial (Fin 2) (MvPolynomial (Option (Fin (n - 2))) A) ⧸ J) p) = alg (γ p)
    rw [hp, hΦb, hΦC]
  rw [heq] at h2
  exact h2

theorem wc_qm_bdchart_of_local_chart : ∀ (A : Type u) [CommRing A] (Xb : Scheme.{u}) (pb : Xb ⟶ Spec (.of A)) (R' : Type u) [CommRing R'] [Algebra A R'] (ι : Spec (.of R') ⟶ Xb) [IsOpenImmersion ι], ι ≫ pb = Spec.map (CommRingCat.ofHom (algebraMap A R')) → ∀ (P : Type u) [CommRing P] [Algebra A P] (δ : R') (ψ : P →+* Localization.Away δ), RingHom.Etale ψ → ψ.comp (algebraMap A P) = (algebraMap R' (Localization.Away δ)).comp (algebraMap A R') → ∀ w₀ : Spec (.of R'), δ ∉ w₀.asIdeal → ∃ (V : Xb.Opens) (e : (V : Scheme.{u}) ⟶ Spec (.of P)), ι w₀ ∈ V ∧ Etale e ∧ e ≫ Spec.map (CommRingCat.ofHom (algebraMap A P)) = V.ι ≫ pb ∧ ∀ v : (V : Scheme.{u}), ∃ w : Spec (.of R'), V.ι v = ι w ∧ ∀ (p : P) (q : R'), ψ p = algebraMap R' (Localization.Away δ) q → (p ∈ (e v).asIdeal ↔ q ∈ w.asIdeal) :=
by
  intro A _ Xb pb R' _ _ ι _ hι P _ _ δ ψ hψ hcomp w₀ hw₀
  let ι₁ : Spec (.of (Localization.Away δ)) ⟶ Spec (.of R') :=
    Spec.map (CommRingCat.ofHom (algebraMap R' (Localization.Away δ)))
  have : IsOpenImmersion ι₁ := IsOpenImmersion.of_isLocalization δ
  let V : Xb.Opens := (ι₁ ≫ ι).opensRange
  have hV : Set.range V.ι = Set.range (ι₁ ≫ ι) := by
    rw [Scheme.Opens.range_ι, Scheme.Hom.coe_opensRange]
  let θ := IsOpenImmersion.isoOfRangeEq V.ι (ι₁ ≫ ι) hV
  have hθ : θ.hom ≫ ι₁ ≫ ι = V.ι := IsOpenImmersion.isoOfRangeEq_hom_fac _ _ _
  let e : (V : Scheme.{u}) ⟶ Spec (.of P) := θ.hom ≫ Spec.map (CommRingCat.ofHom ψ)
  have hι₁ : ∀ x, ι₁ x = PrimeSpectrum.comap (algebraMap R' (Localization.Away δ)) x :=
    fun x => rfl
  refine ⟨V, e, ?_, ?_, ?_, ?_⟩
  · have hmem : w₀ ∈ Set.range ι₁ := by
      have h := PrimeSpectrum.localization_away_comap_range (Localization.Away δ) δ
      have h2 : w₀ ∈ (PrimeSpectrum.basicOpen δ : Set (PrimeSpectrum R')) := hw₀
      rw [← h] at h2
      obtain ⟨x, hx⟩ := h2
      exact ⟨x, (hι₁ x).trans hx⟩
    obtain ⟨x, hx⟩ := hmem
    exact Scheme.Hom.mem_opensRange.mpr ⟨x, by rw [Scheme.Hom.comp_apply, hx]⟩
  · have : Etale (Spec.map (CommRingCat.ofHom ψ)) := HasRingHomProperty.Spec_iff.mpr hψ
    infer_instance
  · have h1 : Spec.map (CommRingCat.ofHom ψ) ≫ Spec.map (CommRingCat.ofHom (algebraMap A P)) =
        ι₁ ≫ ι ≫ pb := by
      rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, hcomp, CommRingCat.ofHom_comp, Spec.map_comp,
        hι]
    calc e ≫ Spec.map (CommRingCat.ofHom (algebraMap A P)) = θ.hom ≫ ι₁ ≫ ι ≫ pb := by
          simp only [e, Category.assoc, h1]
      _ = V.ι ≫ pb := by rw [← hθ]; simp only [Category.assoc]
  · intro v
    refine ⟨ι₁ (θ.hom v), ?_, ?_⟩
    · have h2 : V.ι v = (θ.hom ≫ ι₁ ≫ ι) v := by rw [hθ]
      rw [h2, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply]
    · intro p q hpq
      show ψ p ∈ (θ.hom v).asIdeal ↔ algebraMap R' _ q ∈ (θ.hom v).asIdeal
      rw [hpq]

theorem wc_qm_boundary_charts : ∀ (A : Type u) [CommRing A] [IsLocalRing A] (n : ℕ), 2 ≤ n → ∀ (π : A) (c : Matrix (Fin n) (Fin n) A), IsUnit (c + c.transpose).det → ∀ (ℬ : ℕ → Submodule A (MvPolynomial (Option (Fin n)) A ⧸ Ideal.span {∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X (some p) * MvPolynomial.X (some q) - MvPolynomial.C π * MvPolynomial.X none ^ 2})), (∀ i, ℬ i = Submodule.map (Ideal.Quotient.mkₐ A (Ideal.span {∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X (some p) * MvPolynomial.X (some q) - MvPolynomial.C π * MvPolynomial.X none ^ 2})).toLinearMap (MvPolynomial.homogeneousSubmodule (Option (Fin n)) A i)) → ∀ [GradedAlgebra ℬ] (X : Scheme.{u}) (j : X ⟶ Proj ℬ), Set.range j = (Proj.basicOpen ℬ (Ideal.Quotient.mk (Ideal.span {∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X (some p) * MvPolynomial.X (some q) - MvPolynomial.C π * MvPolynomial.X none ^ 2}) (MvPolynomial.X none)) : Set (Proj ℬ)) → (∀ y : Proj ℬ, (Proj.toSpecZero ℬ ≫ Spec.map (CommRingCat.ofHom (algebraMap A ↥(ℬ 0)))) y = IsLocalRing.closedPoint A → y ∉ Set.range j → ∃ (V : (Proj ℬ).Opens) (e : (V : Scheme.{u}) ⟶ Spec (.of (MvPolynomial (Option (Fin (n - 2))) A))), y ∈ V ∧ Etale e ∧ e ≫ Spec.map (CommRingCat.ofHom (algebraMap A (MvPolynomial (Option (Fin (n - 2))) A))) = V.ι ≫ (Proj.toSpecZero ℬ ≫ Spec.map (CommRingCat.ofHom (algebraMap A ↥(ℬ 0)))) ∧ ∀ v : (V : Scheme.{u}), (V.ι v ∉ Set.range j ↔ (MvPolynomial.X none : MvPolynomial (Option (Fin (n - 2))) A) ∈ (e v).asIdeal)) :=
by
  intro A _ _ n hn π c hc ℬ hℬ _ X j hj y _ hy
  classical
  let Gh : MvPolynomial (Option (Fin n)) A := ∑ p, ∑ q, MvPolynomial.C (c p q) *
    MvPolynomial.X (some p) * MvPolynomial.X (some q) - MvPolynomial.C π * MvPolynomial.X none ^ 2

  have hdeg1 : ∀ i : Option (Fin n),
      Ideal.Quotient.mk (Ideal.span {Gh}) (MvPolynomial.X i) ∈ ℬ 1 := by
    intro i
    rw [hℬ 1]
    exact Submodule.mem_map_of_mem
      ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X A i))

  have hcov := Proj.iSup_basicOpen_eq_top ℬ
    (fun i : Option (Fin n) => Ideal.Quotient.mk (Ideal.span {Gh}) (MvPolynomial.X i))
    (wc_qm_quotient_irrelevant_le_span_X A (Option (Fin n)) (Ideal.span {Gh}) ℬ hℬ)
  have hy' : y ∈ (⨆ i : Option (Fin n),
      Proj.basicOpen ℬ (Ideal.Quotient.mk (Ideal.span {Gh}) (MvPolynomial.X i))) := by
    rw [hcov]; trivial
  obtain ⟨i, hi⟩ := TopologicalSpace.Opens.mem_iSup.mp hy'
  cases i with
  | none => exact (hy (by rw [hj]; exact hi)).elim
  | some a =>

    obtain ⟨ε, hε⟩ := wc_qm_away_deg_one_equiv (MvPolynomial (Option (Fin n)) A ⧸ Ideal.span {Gh})
      ℬ (Ideal.Quotient.mk (Ideal.span {Gh}) (MvPolynomial.X (some a))) (hdeg1 (some a))
    obtain ⟨hJopen, hJstr, hJrange, hJmem⟩ := wc_qm_proj_deg_one_chart A
      (MvPolynomial (Option (Fin n)) A ⧸ Ideal.span {Gh})
      ((MvPolynomial (Option (Fin n)) A ⧸ Ideal.span {Gh}) ⧸
        Ideal.span {Ideal.Quotient.mk (Ideal.span {Gh}) (MvPolynomial.X (some a)) - 1})
      ℬ (Ideal.Quotient.mk (Ideal.span {Gh}) (MvPolynomial.X (some a))) (hdeg1 (some a)) ε
      (Ideal.Quotient.mk
        (Ideal.span {Ideal.Quotient.mk (Ideal.span {Gh}) (MvPolynomial.X (some a)) - 1}))
      hε (fun x => Ideal.Quotient.mk_algebraMap A _ x)
    haveI := hJopen
    have hyJ := hi
    rw [← SetLike.mem_coe, ← hJrange] at hyJ
    obtain ⟨w₀, hw₀⟩ := hyJ

    have hZw₀ : Ideal.Quotient.mk
        (Ideal.span {Ideal.Quotient.mk (Ideal.span {Gh}) (MvPolynomial.X (some a)) - 1})
        (Ideal.Quotient.mk (Ideal.span {Gh}) (MvPolynomial.X none)) ∈ w₀.asIdeal := by
      by_contra hcon
      apply hy
      rw [hj, ← hw₀]
      exact (hJmem _ (hdeg1 none) w₀).mpr hcon

    obtain ⟨r, hra, hδ⟩ :=
      wc_qm_boundary_partial_nonvanishing A n π c hc a w₀.asIdeal w₀.isPrime hZw₀
    have hcard : (({a, r} : Finset (Fin n))ᶜ).card = n - 2 := by
      rw [Finset.card_compl, Fintype.card_fin, Finset.card_pair hra.symm]
    let β := (({a, r} : Finset (Fin n))ᶜ).orderEmbOfFin hcard
    have hβinj : Function.Injective β := β.injective
    have hβne : ∀ i, β i ≠ a ∧ β i ≠ r := by
      intro i
      have h := Finset.orderEmbOfFin_mem _ hcard i
      simp only [Finset.mem_compl, Finset.mem_insert, Finset.mem_singleton, not_or] at h
      exact h
    have hβsurj : ∀ b, b ≠ a → b ≠ r → ∃ i, β i = b := by
      intro b hba hbr
      have hb : b ∈ ((({a, r} : Finset (Fin n))ᶜ : Finset (Fin n)) : Set (Fin n)) := by
        simp [hba, hbr]
      rw [← Finset.range_orderEmbOfFin _ hcard] at hb
      exact hb
    have hEt := wc_qm_chart_partial_etale A n Gh a r hra.symm β hβinj hβne hβsurj

    have key := wc_qm_bdchart_of_local_chart A (Proj ℬ)
      (Proj.toSpecZero ℬ ≫ Spec.map (CommRingCat.ofHom (algebraMap A ↥(ℬ 0)))) _ _ hJstr
      (MvPolynomial (Option (Fin (n - 2))) A) _ _ hEt
    obtain ⟨V, e, hyV, he, hestr, hpts⟩ := key (by
      refine RingHom.ext fun x => ?_
      first
      | simp [RingHom.comp_apply, MvPolynomial.algebraMap_eq, MvPolynomial.aeval_C]
      | (simp only [RingHom.comp_apply]
         congr 1
         exact (MvPolynomial.aeval _).commutes x)) w₀ hδ
    refine ⟨V, e, ?_, he, hestr, ?_⟩
    · rw [← hw₀]; exact hyV
    ·
      intro v
      obtain ⟨w, hvw, hw⟩ := hpts v
      have h1 := hw (MvPolynomial.X none)
        (Ideal.Quotient.mk
          (Ideal.span {Ideal.Quotient.mk (Ideal.span {Gh}) (MvPolynomial.X (some a)) - 1})
          (Ideal.Quotient.mk (Ideal.span {Gh}) (MvPolynomial.X none)))
        (by simp [MvPolynomial.aeval_X])
      rw [h1, hvw, hj]
      have h2 := hJmem _ (hdeg1 none) w
      constructor
      · intro hn
        by_contra hq
        exact hn (h2.mpr hq)
      · intro hq hm
        exact (h2.mp hm) hq

theorem wc_qm_projective_closure_geometry : ∀ (A : Type u) [CommRing A] [IsLocalRing A] (n : ℕ), Even n → 2 ≤ n → ∀ (π : A) (c : Matrix (Fin n) (Fin n) A), IsLocalRing.maximalIdeal A = Ideal.span {π} → IsUnit (c + c.transpose).det → ∀ (x₀ : Spec (.of (wcQuadModelRing A n π c))), (∀ p, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈ PrimeSpectrum.asIdeal x₀) → ∃ (Xb : Scheme.{u}) (pb : Xb ⟶ Spec (.of A)) (j : Spec (.of (wcQuadModelRing A n π c)) ⟶ Xb), IsProper pb ∧ IsOpenImmersion j ∧ j ≫ pb = wcQuadModelStr A n π c ∧ (∀ x, wcQuadModelStr A n π c x = IsLocalRing.closedPoint A → x ≠ x₀ → ∃ U : (Spec (.of (wcQuadModelRing A n π c))).Opens, x ∈ U ∧ Smooth (U.ι ≫ wcQuadModelStr A n π c)) ∧ wcQmBdChart A pb j (n - 2) :=
by
  intro A _ _ n _ hn2 π c hπ hc x₀ hx₀
  classical
  let Gh : MvPolynomial (Option (Fin n)) A := ∑ p, ∑ q, MvPolynomial.C (c p q) *
    MvPolynomial.X (some p) * MvPolynomial.X (some q) - MvPolynomial.C π * MvPolynomial.X none ^ 2
  let I : Ideal (MvPolynomial (Option (Fin n)) A) := Ideal.span {Gh}
  let ℬ : ℕ → Submodule A (MvPolynomial (Option (Fin n)) A ⧸ I) := fun i =>
    Submodule.map (Ideal.Quotient.mkₐ A I).toLinearMap
      (MvPolynomial.homogeneousSubmodule (Option (Fin n)) A i)
  have hℬ : ∀ i, ℬ i = Submodule.map (Ideal.Quotient.mkₐ A I).toLinearMap
      (MvPolynomial.homogeneousSubmodule (Option (Fin n)) A i) := fun i => rfl

  have hGh : Gh.IsHomogeneous 2 := by
    apply MvPolynomial.IsHomogeneous.sub
    · apply MvPolynomial.IsHomogeneous.sum
      intro p _
      apply MvPolynomial.IsHomogeneous.sum
      intro q _
      exact (MvPolynomial.isHomogeneous_C_mul_X (c p q) (some p)).mul
        (MvPolynomial.isHomogeneous_X A (some q))
    · exact (MvPolynomial.isHomogeneous_C _ π).mul ((MvPolynomial.isHomogeneous_X A none).pow 2)
  have hI : I.IsHomogeneous (MvPolynomial.homogeneousSubmodule (Option (Fin n)) A) := by
    apply Ideal.homogeneous_span
    intro x hx
    rw [Set.mem_singleton_iff] at hx
    rw [hx]
    exact ⟨2, (MvPolynomial.mem_homogeneousSubmodule 2 _).mpr hGh⟩
  obtain ⟨inst⟩ := wc_qm_quotient_gradedAlgebra A _
    (MvPolynomial.homogeneousSubmodule (Option (Fin n)) A) I hI ℬ hℬ
  letI : GradedAlgebra ℬ := inst

  let fZ : MvPolynomial (Option (Fin n)) A ⧸ I := Ideal.Quotient.mk I (MvPolynomial.X none)
  have hfZ : fZ ∈ ℬ 1 := Submodule.mem_map_of_mem
    ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X A none))
  obtain ⟨e₁, he₁⟩ := wc_qm_away_deg_one_equiv _ ℬ fZ hfZ
  obtain ⟨e₂, -⟩ := wc_qm_mvpoly_dehomog_equiv A Gh none
    (fun o : Option (Fin n) => Option.elim o 1 MvPolynomial.X) some rfl (fun k => rfl)
    (by
      intro i hi
      cases i with
      | none => exact absurd rfl hi
      | some k => exact ⟨k, rfl⟩)
  have hs : MvPolynomial.aeval (fun o : Option (Fin n) => Option.elim o 1 MvPolynomial.X) Gh =
      ∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q -
        MvPolynomial.C π := by
    simp [Gh, map_sum, MvPolynomial.aeval_X, MvPolynomial.aeval_C, MvPolynomial.algebraMap_eq]
  let e₃ := Ideal.quotientEquivAlgOfEq A
    (show Ideal.span {MvPolynomial.aeval (fun o : Option (Fin n) => Option.elim o 1 MvPolynomial.X)
      Gh} = wcQuadModelIdeal A n π c by rw [hs])
  let E := e₂.trans e₃
  let ε : HomogeneousLocalization.Away ℬ fZ ≃+* wcQuadModelRing A n π c :=
    e₁.trans E.toRingEquiv
  let φ : (MvPolynomial (Option (Fin n)) A ⧸ I) →+* wcQuadModelRing A n π c :=
    (E : _ →+* _).comp (Ideal.Quotient.mk (Ideal.span {fZ - 1}))
  have hε : ∀ (m : ℕ) (x : MvPolynomial (Option (Fin n)) A ⧸ I) (hx : x ∈ ℬ (m • 1)),
      ε (HomogeneousLocalization.Away.mk ℬ hfZ m x hx) = φ x := by
    intro m x hx
    simp only [ε, φ, RingEquiv.trans_apply, he₁ m x hx]
    rfl
  have hφ : ∀ a : A, φ (algebraMap A _ a) = algebraMap A (wcQuadModelRing A n π c) a := by
    intro a
    simp only [φ, RingHom.comp_apply, Ideal.Quotient.mk_algebraMap]
    exact E.commutes a
  obtain ⟨hJopen, hJstr, hJrange, -⟩ :=
    wc_qm_proj_deg_one_chart A _ (wcQuadModelRing A n π c) ℬ fZ hfZ ε φ hε hφ

  haveI hprop := wc_qm_proj_quotient_mvpoly_proper A (Option (Fin n)) I ℬ hℬ
  refine ⟨Proj ℬ, Proj.toSpecZero ℬ ≫ Spec.map (CommRingCat.ofHom (algebraMap A ↥(ℬ 0))),
    Spec.map (CommRingCat.ofHom (ε : HomogeneousLocalization.Away ℬ fZ →+* wcQuadModelRing A n π c))
      ≫ Proj.awayι ℬ fZ hfZ one_pos, hprop, hJopen, hJstr, ?_, ?_⟩
  ·
    intro x _ hx
    obtain ⟨r, hr⟩ := wc_qm_affine_partial_nonvanishing A n π c hπ hc x₀ x hx₀ hx
    exact wc_qm_hypersurface_smooth_of_partial A n
      (∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q - MvPolynomial.C π)
      x r hr
  ·
    unfold wcQmBdChart
    intro y hy hyj
    exact wc_qm_boundary_charts A n hn2 π c hc ℬ hℬ _ _ hJrange y hy hyj

theorem wc_qm_leray_hyper : ∀ (M Y : Scheme.{u}) (G : M ⟶ Y) (m : ℕ) (I : InjectiveResolution ((constantSheaf (Scheme.smallEtaleTopology M) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))) (q : ℕ), Nonempty (wcEtCoh M m q ≃ wcQmHyp Y (((wcEtPush G).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex) q) :=
by


  have hadj : ∀ {X B : Scheme.{u}} (g : X ⟶ B), ∃ (L : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1} ⥤ Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}), Nonempty (L ⊣ wcEtPush g) ∧ Limits.PreservesFiniteLimits L ∧ Nonempty (L.obj ((constantSheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) ≅ (constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) := by
    have hlan : ∀ {C D : Type (u+1)} [Category.{u} C] [Category.{u} D] [Limits.HasFiniteLimits C]
        (G : C ⥤ D) [Limits.PreservesFiniteLimits G],
        Limits.PreservesFiniteLimits (G.op.lan : (Cᵒᵖ ⥤ AddCommGrpCat.{u+1}) ⥤ (Dᵒᵖ ⥤ AddCommGrpCat.{u+1})) := by
      intro C D _ _ _ G _
      have wc_lan_eval_iso : ∀ {C D : Type (u+1)} [Category.{u} C] [Category.{u} D] (L : C ⥤ D)
          [∀ F : C ⥤ AddCommGrpCat.{u+1}, L.HasPointwiseLeftKanExtension F]
          [∀ F : C ⥤ AddCommGrpCat.{u+1}, L.HasLeftKanExtension F] (Y : D),
          Nonempty ((L.lan : (C ⥤ AddCommGrpCat.{u+1}) ⥤ (D ⥤ AddCommGrpCat.{u+1})) ⋙
              (evaluation D AddCommGrpCat.{u+1}).obj Y ≅
            (Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj (CostructuredArrow.proj L Y) ⋙
              Limits.colim) := by
        intro C D _ _ L _ _ Y
        refine ⟨NatIso.ofComponents (fun F => L.leftKanExtensionObjIsoColimit F Y) ?_⟩
        intro F₁ F₂ φ
        have hnat : ∀ j : CostructuredArrow L Y,
            (L.leftKanExtension F₁).map j.hom ≫ (L.lan.map φ).app Y =
            (L.lan.map φ).app (L.obj j.left) ≫ (L.leftKanExtension F₂).map j.hom :=
          fun j => (L.lan.map φ).naturality j.hom
        have hfac : ∀ j : CostructuredArrow L Y,
            (L.leftKanExtensionUnit F₁).app j.left ≫ (L.lan.map φ).app (L.obj j.left) =
            φ.app j.left ≫ (L.leftKanExtensionUnit F₂).app j.left := fun j =>
          Functor.descOfIsLeftKanExtension_fac_app (L.leftKanExtension F₁)
            (L.leftKanExtensionUnit F₁) (L.leftKanExtension F₂) (φ ≫ L.leftKanExtensionUnit F₂) j.left
        refine (Iso.inv_comp_eq _).1 ?_
        apply Limits.colimit.hom_ext
        intro j
        have key : (L.leftKanExtensionUnit F₁).app j.left ≫ (L.leftKanExtension F₁).map j.hom ≫
            (L.lan.map φ).app Y ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom =
            φ.app j.left ≫ Limits.colimit.ι (CostructuredArrow.proj L Y ⋙ F₂) j :=
          calc (L.leftKanExtensionUnit F₁).app j.left ≫ (L.leftKanExtension F₁).map j.hom ≫
                (L.lan.map φ).app Y ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom
              = (L.leftKanExtensionUnit F₁).app j.left ≫ ((L.leftKanExtension F₁).map j.hom ≫
                (L.lan.map φ).app Y) ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom :=
                congrArg ((L.leftKanExtensionUnit F₁).app j.left ≫ ·) (Category.assoc _ _ _).symm
            _ = (L.leftKanExtensionUnit F₁).app j.left ≫ ((L.lan.map φ).app (L.obj j.left) ≫
                (L.leftKanExtension F₂).map j.hom) ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom :=
                congrArg (fun k => (L.leftKanExtensionUnit F₁).app j.left ≫ k ≫
                  (L.leftKanExtensionObjIsoColimit F₂ Y).hom) (hnat j)
            _ = ((L.leftKanExtensionUnit F₁).app j.left ≫ (L.lan.map φ).app (L.obj j.left)) ≫
                (L.leftKanExtension F₂).map j.hom ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom :=
                (congrArg ((L.leftKanExtensionUnit F₁).app j.left ≫ ·) (Category.assoc _ _ _)).trans
                  (Category.assoc _ _ _).symm
            _ = (φ.app j.left ≫ (L.leftKanExtensionUnit F₂).app j.left) ≫
                (L.leftKanExtension F₂).map j.hom ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom :=
                congrArg (· ≫ (L.leftKanExtension F₂).map j.hom ≫
                  (L.leftKanExtensionObjIsoColimit F₂ Y).hom) (hfac j)
            _ = φ.app j.left ≫ ((L.leftKanExtensionUnit F₂).app j.left ≫
                (L.leftKanExtension F₂).map j.hom ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom) :=
                Category.assoc _ _ _
            _ = φ.app j.left ≫ Limits.colimit.ι (CostructuredArrow.proj L Y ⋙ F₂) j :=
                congrArg (φ.app j.left ≫ ·) (Functor.ι_leftKanExtensionObjIsoColimit_hom L F₂ Y j)
        erw [Functor.ι_leftKanExtensionObjIsoColimit_inv_assoc, Limits.ι_colimMap]
        exact key
      constructor
      intro J _ _
      apply Limits.preservesLimitsOfShape_of_evaluation
      intro Y
      obtain ⟨θ⟩ := wc_lan_eval_iso G.op Y
      haveI := (flat_of_preservesFiniteLimits G).cofiltered Y.unop
      haveI : IsFiltered (CostructuredArrow G.op Y) :=
