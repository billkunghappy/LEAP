  obtain ⟨DidP⟩ := wc_et_zmod_pull_data_exists (𝟙 (Limits.pullback (Limits.pullback.snd g a) ξ)) m
  have C1 : ∀ x, wcEtPull De' q (wcEtPull De q x) = x := fun x =>
    ((wc_et_pull_comp e e' _ hii De De' DidX q x).symm).trans (hid DidX x)
  have C2 : ∀ y, wcEtPull De q (wcEtPull De' q y) = y := fun y =>
    ((wc_et_pull_comp e' e _ hiii De' De DidP q y).symm).trans (hid DidP y)
  have C3 : ∀ z, wcEtPull D q z = wcEtPull De' q (wcEtPull Dι q z) := fun z =>
    wc_et_pull_comp _ e' _ he'1 Dι De' D q z
  have hbe' : Function.Bijective (wcEtPull De' q) :=
    Function.bijective_iff_has_inverse.mpr ⟨wcEtPull De q, C2, C1⟩
  have hfun : (⇑(wcEtPull D q)) = (⇑(wcEtPull De' q)) ∘ (⇑(wcEtPull Dι q)) := funext C3
  rw [hfun]
  exact hbe'.comp (H Dι q)

