  obtain ⟨hRd, hRl⟩ := lcm3 _ R' σ hσ H
  haveI hBd : IsDomain B := MulEquiv.isDomain R' Φ.symm.toMulEquiv
  have hBl : ∀ a₁ b₁ : B, ∃ l : B, ∀ z : B, (a₁ ∣ z ∧ b₁ ∣ z ↔ l ∣ z) := by
    intro a₁ b₁
    obtain ⟨l, hl⟩ := hRl (Φ.symm a₁) (Φ.symm b₁)
