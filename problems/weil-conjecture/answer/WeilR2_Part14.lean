  have t_s5 : ∀ (A : Type u) [CommRing A] (d : ℕ) (B : Type u) [CommRing B] (β : MvPolynomial (Option (Fin d)) A →+* B) (hβ : WeaklyEtale (Spec.map (CommRingCat.ofHom β))) (Ω : Type u) [CommRing Ω] (ξ : Spec (.of Ω) ⟶ Spec (.of A)), ∃ h : Limits.pullback (Spec.map (CommRingCat.ofHom (β.comp (algebraMap A (MvPolynomial (Option (Fin d)) A))))) ξ ⟶ Spec (.of (MvPolynomial (Option (Fin d)) Ω)), WeaklyEtale h ∧ h ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.map (Spec.preimage ξ).hom)) = Limits.pullback.fst (Spec.map (CommRingCat.ofHom (β.comp (algebraMap A (MvPolynomial (Option (Fin d)) A))))) ξ ≫ Spec.map (CommRingCat.ofHom β) := by
