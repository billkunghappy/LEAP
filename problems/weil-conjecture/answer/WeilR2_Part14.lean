          ((constantSheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}).obj
            (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))) b
          (wcConstSec S (ULift.{u+1} (ZMod ℓ)) (Scheme.Etale.mk (𝟙 S)) (ULift.up 1))) := by
    have key := Limits.colimit.ι_map
      (Functor.whiskerLeft (StructuredArrow.proj (Over.mk (wcEtGeomPt S b))
        (Scheme.Etale.forget S)).op ψ.hom)
      (Opposite.op (StructuredArrow.mk (Y := Scheme.Etale.mk (𝟙 S))
        (Over.homMk (wcEtGeomPt S b) (by simp))))
    have key2 := congrArg (fun f => AddCommGrpCat.Hom.hom f
      (wcConstSec S (ULift.{u+1} (ZMod ℓ)) (Scheme.Etale.mk (𝟙 S)) (ULift.up 1))) key
    simp only [AddCommGrpCat.hom_comp, AddMonoidHom.coe_comp, Function.comp_apply] at key2
    exact key2.symm
  have h1 : wcEtGlobalGerm ((((wcEtPush g).mapHomologicalComplex (ComplexShape.up ℕ)).obj
        I.cocomplex).homology 1) b ((ψ.hom.app (Opposite.op (Scheme.Etale.mk (𝟙 S)))).hom
          (wcConstSec S (ULift.{u+1} (ZMod ℓ)) (Scheme.Etale.mk (𝟙 S)) (ULift.up 1))) = 0 := by
    rw [hnat, hb, AddCommGrpCat.hom_zero, AddMonoidHom.zero_apply]
  obtain ⟨W₁, r, w₁, hw₁, hV⟩ := wc_et_germ_zero_local S b _ _ h1
  rw [hψ] at hV

  obtain ⟨W, h, w, y, hhw, hy⟩ := wc_et_push_cycle_local_boundary g I.cocomplex 1
    (Scheme.Etale.mk (𝟙 S)) W₁ r κ _ hV hκ1 w₁
  have hp : (ComplexShape.up ℕ).prev 1 = 0 := CochainComplex.prev_nat_succ 0
  revert y
  rw [hp]
  intro y hy

  have hc : ((I.cocomplex.X 1).obj.map ((wcEtBaseChange g).map (h ≫ r)).op).hom
      ((ζ.hom.app (Opposite.op ((wcEtBaseChange g).obj (Scheme.Etale.mk (𝟙 S))))).hom
        (wcConstSec X (ULift.{u+1} ℤ) ((wcEtBaseChange g).obj (Scheme.Etale.mk (𝟙 S)))
          (ULift.up 1))) =
      (ζ.hom.app (Opposite.op ((wcEtBaseChange g).obj W))).hom
        (wcConstSec X (ULift.{u+1} ℤ) ((wcEtBaseChange g).obj W) (ULift.up 1)) := by
    have e1 := congrArg (fun f => AddCommGrpCat.Hom.hom f
      (wcConstSec X (ULift.{u+1} ℤ) ((wcEtBaseChange g).obj (Scheme.Etale.mk (𝟙 S)))
        (ULift.up 1)))
      (ζ.hom.naturality ((wcEtBaseChange g).map (h ≫ r)).op)
    have e2 := congrArg (fun f => AddCommGrpCat.Hom.hom f (ULift.up 1 : ULift.{u+1} ℤ))
      ((toSheafify (Scheme.smallEtaleTopology X)
        ((Functor.const _).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)))).naturality
        ((wcEtBaseChange g).map (h ≫ r)).op)
    simp only [AddCommGrpCat.hom_comp, AddMonoidHom.coe_comp, Function.comp_apply] at e1 e2
    rw [← e1]
    congr 1
    exact e2.symm
  have hnat2 := hy.trans hc

  obtain ⟨v, hv⟩ := hroot _ y hnat2

  have hW : W.hom w = b := by
    have e := congrArg (fun f => f w) (MorphismProperty.Over.w h)
    simp only [Scheme.Hom.comp_apply] at e
    rw [← e, hhw, hw₁]
  exact ⟨W, w, (show Γ(Limits.pullback W.hom g, ⊤) from v.1), hW, by
    first
    | exact hv
    | (rw [Scheme.Hom.comp_appTop]; exact hv)⟩

theorem wc_cgth_closed_support_const_iso : ∀ {Y Z : Scheme.{u}} (i : Z ⟶ Y) [IsClosedImmersion i] (m : ℕ) (F : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}), (∀ y : Y, y ∉ Set.range i → Subsingleton ((wcEtStalk Y y).obj F)) → ∀ ψ : (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))) ⟶ F, (∀ z : Z, Function.Bijective ((wcEtStalk Y (i z)).map ψ).hom) → Nonempty (F ≅ (wcEtPush i).obj ((constantSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))) :=
by
  intro Y Z i _ m F hoff ψ hbij

  have s1 : ∀ (H : Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) (y : Y),
      y ∉ Set.range i → Subsingleton ((wcEtStalk Y y).obj ((wcEtPush i).obj H)) := by
    intro H y hy
    let X₀ : Over Y := Over.mk (wcEtGeomPt Y y)
    let G := (StructuredArrow.proj X₀ (Scheme.Etale.forget Y)).op ⋙ ((wcEtPush i).obj H).obj
    haveI : IsCofiltered (StructuredArrow X₀ (Scheme.Etale.forget Y)) :=
      IsCofiltered.of_hasFiniteLimits _
    haveI : Limits.PreservesFilteredColimitsOfSize.{u, u+1} (forget AddCommGrpCat.{u+1}) :=
      Limits.preservesFilteredColimitsOfSize_shrink.{u+1, u+1, u, u+1} (forget AddCommGrpCat.{u+1})
    have hx : ∀ x : (wcEtStalk Y y).obj ((wcEtPush i).obj H), x = 0 := by
      intro x
      obtain ⟨j, s, hs⟩ := Limits.Concrete.colimit_exists_rep G x
      have hw : j.unop.hom.left ≫ j.unop.right.hom = wcEtGeomPt Y y := Over.w j.unop.hom
      have hb : j.unop.right.hom (j.unop.hom.left
          (IsLocalRing.closedPoint (AlgebraicClosure (Y.residueField y)))) = y := by
        have e0 := Scheme.Hom.comp_apply j.unop.hom.left j.unop.right.hom
          (IsLocalRing.closedPoint (AlgebraicClosure (Y.residueField y)))
        have e3 : (j.unop.hom.left ≫ j.unop.right.hom)
            (IsLocalRing.closedPoint (AlgebraicClosure (Y.residueField y))) =
            (wcEtGeomPt Y y) (IsLocalRing.closedPoint (AlgebraicClosure (Y.residueField y))) := by
          first
            | rw [hw]
            | simp only [hw]
            | exact congrArg (fun φ => φ (IsLocalRing.closedPoint _)) hw
        refine e0.symm.trans (e3.trans ?_)
        have e1 := Scheme.Hom.comp_apply (Spec.map (CommRingCat.ofHom (algebraMap
          (Y.residueField y) (AlgebraicClosure (Y.residueField y)))))
          (Y.fromSpecResidueField y)
          (IsLocalRing.closedPoint (AlgebraicClosure (Y.residueField y)))
        refine e1.trans ?_
        first
          | exact Scheme.fromSpecResidueField_apply _ _
          | exact Scheme.fromSpecResidueField_apply _ _ _
          | simp only [Scheme.fromSpecResidueField_apply]
      have hnot : j.unop.right.hom (j.unop.hom.left
          (IsLocalRing.closedPoint (AlgebraicClosure (Y.residueField y)))) ∉ Set.range i := by
        rw [hb]; exact hy
      obtain ⟨V₁, c, ⟨v₁, hv₁⟩, hzero⟩ := wc_et_push_vanish_off_range i H
        i.isClosedEmbedding.isClosed_range j.unop.right s _ hnot
      haveI : Etale j.unop.right.hom := j.unop.right.prop
      haveI : Etale (c.left ≫ j.unop.right.hom) := by
        rw [MorphismProperty.Over.w c]; exact V₁.prop
      haveI : Etale c.left := Etale.of_comp c.left j.unop.right.hom
      obtain ⟨t, ht, -⟩ := wc_etale_lift_alg_closed_point (AlgebraicClosure (Y.residueField y))
        c.left j.unop.hom.left v₁ hv₁
      have ht' : t ≫ V₁.hom = wcEtGeomPt Y y := by
        rw [← MorphismProperty.Over.w c, ← Category.assoc, ht]; exact hw
      let A' : StructuredArrow X₀ (Scheme.Etale.forget Y) :=
        StructuredArrow.mk (Y := V₁)
          (Over.homMk (U := X₀) (V := (Scheme.Etale.forget Y).obj V₁) t ht')
      let f : A' ⟶ j.unop := StructuredArrow.homMk c (by
        apply Over.OverMorphism.ext
        exact ht)
      have hw2 := Limits.colimit.w_apply G f.op s
      rw [← hs, ← hw2]
      have h0 : (ConcreteCategory.hom (G.map f.op)) s = 0 := hzero
      rw [h0, map_zero]
    exact ⟨fun a b => (hx a).trans (hx b).symm⟩

  obtain ⟨L, ⟨adj⟩, hL, ⟨eℤ⟩⟩ := wc_et_push_left_adjoint i
  haveI := hL
  haveI : L.IsLeftAdjoint := adj.isLeftAdjoint
  haveI : L.PreservesZeroMorphisms := Functor.preservesZeroMorphisms_of_isLeftAdjoint _
  haveI : L.Additive := Functor.additive_of_preserves_binary_products _
  haveI : Limits.PreservesFiniteColimits L := by
    first
      | exact inferInstance
      | (haveI : Limits.PreservesColimitsOfSize.{0, 0} L := adj.leftAdjoint_preservesColimits
         exact Limits.PreservesColimitsOfSize.preservesFiniteColimits L)
  obtain ⟨eL⟩ := wc_et_left_adjoint_const_zmod L ⟨eℤ⟩ m
  haveI hηF : IsIso (adj.unit.app F) := wc_et_closed_unit_iso_of_vanish_off i L adj F
    (fun V g v hv => wc_et_vanish_off_of_stalks F V g v (hoff (V.hom v) hv))
  have hnat := adj.unit_naturality ψ
  have hθ : ∀ b : Y, Function.Bijective ((wcEtStalk Y b).map ((wcEtPush i).map (L.map ψ))).hom := by
    intro b
    by_cases hb : b ∈ Set.range i
    · obtain ⟨z, rfl⟩ := hb
      have h1 := wc_et_closed_unit_stalk_iso i L adj
        ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) z
      have h2 := wc_et_closed_unit_stalk_iso i L adj F z
      have hcomp : ((wcEtStalk Y (i z)).map ((wcEtPush i).map (L.map ψ))).hom ∘
          ((wcEtStalk Y (i z)).map (adj.unit.app ((constantSheaf (Scheme.smallEtaleTopology Y)
            AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))))).hom =
          ((wcEtStalk Y (i z)).map (adj.unit.app F)).hom ∘ ((wcEtStalk Y (i z)).map ψ).hom := by
        funext x
        have := congrArg (fun φ => ((wcEtStalk Y (i z)).map φ).hom x) hnat
        simp only [Functor.map_comp, AddCommGrpCat.hom_comp, AddMonoidHom.coe_comp,
          Function.comp_apply] at this
        exact this
      have h3 := h2.comp (hbij z)
      rw [← hcomp] at h3
      exact (Function.Bijective.of_comp_iff _ h1).mp h3
    · haveI := s1 (L.obj ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))) b hb
      haveI := s1 (L.obj F) b hb
      exact ⟨fun x y _ => Subsingleton.elim x y, fun w => ⟨0, Subsingleton.elim _ _⟩⟩
  haveI : IsIso ((wcEtPush i).map (L.map ψ)) := wc_et_isIso_of_geom_stalks_bijective Y _ hθ
  exact ⟨asIso (adj.unit.app F) ≪≫ (asIso ((wcEtPush i).map (L.map ψ))).symm ≪≫
    (wcEtPush i).mapIso eL⟩

theorem wc_quot_strictly_henselian_of_ne_top : ∀ (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)] (I : Ideal B), I ≠ ⊤ → ∃ (h : HenselianLocalRing (B ⧸ I)), IsSepClosed (@IsLocalRing.ResidueField (B ⧸ I) _ h.toIsLocalRing) :=
by
  intro B _ hBH hBS I hI
  have hensT : ∀ (R S : Type u) [CommRing R] [CommRing S] [HenselianLocalRing R] [Nontrivial S]
      (f : R →+* S), Function.Surjective f → HenselianLocalRing S := by
    intro R S _ _ _ _ f hf
    let L : IsLocalRing S := IsLocalRing.of_surjective' f hf
    have : IsLocalHom f := IsLocalHom.of_surjective f hf
    refine @HenselianLocalRing.mk S _ L ?_
    intro g hg a₀ h1 h2
    obtain ⟨G₀, hG₀⟩ := Polynomial.map_surjective f hf g
    have hlift : g ∈ Polynomial.lifts f := (Polynomial.mem_lifts g).mpr ⟨G₀, hG₀⟩
    obtain ⟨G, hGmap, -, hGmonic⟩ := Polynomial.lifts_and_degree_eq_and_monic hlift hg
    obtain ⟨b₀, rfl⟩ := hf a₀
    have e1 : f (G.eval b₀) = g.eval (f b₀) := by
      rw [← hGmap, Polynomial.eval_map, Polynomial.eval₂_at_apply]
    have e2 : f ((Polynomial.derivative G).eval b₀) = (Polynomial.derivative g).eval (f b₀) := by
      rw [← hGmap, Polynomial.derivative_map, Polynomial.eval_map, Polynomial.eval₂_at_apply]
    have h1' : G.eval b₀ ∈ IsLocalRing.maximalIdeal R := by
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      intro hu
      have hu' := hu.map f
      rw [e1] at hu'
      exact (mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal _).mp h1)) hu'
    have h2' : IsUnit ((Polynomial.derivative G).eval b₀) := by
      rw [← isUnit_map_iff f, e2]
      exact h2
    obtain ⟨b, hb, hbb⟩ := HenselianLocalRing.is_henselian G hGmonic b₀ h1' h2'
    refine ⟨f b, ?_, ?_⟩
    · rw [← hGmap]
      exact Polynomial.IsRoot.map hb
    · rw [← map_sub, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, isUnit_map_iff]
      exact mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal _).mp hbb)
  have sepT : ∀ (k k' : Type u) [Field k] [Field k'] [IsSepClosed k], (k ≃+* k') →
      IsSepClosed k' := by
    intro k k' _ _ _ e
    apply IsSepClosed.of_exists_root
    intro p _ hirr hsep
    have hdeg : (p.map (e.symm : k' →+* k)).degree ≠ 0 := by
      rw [Polynomial.degree_map_eq_of_injective e.symm.injective]
      exact (Polynomial.degree_pos_of_irreducible hirr).ne'
    obtain ⟨x, hx⟩ := IsSepClosed.exists_root (p.map (e.symm : k' →+* k)) hdeg
      (hsep.map)
    refine ⟨e x, ?_⟩
    have hpp : (p.map (e.symm : k' →+* k)).map (e : k →+* k') = p := by
      rw [Polynomial.map_map]
      ext n
      simp
    have hx' : e ((p.map (e.symm : k' →+* k)).eval x) = 0 := by
      rw [show (p.map (e.symm : k' →+* k)).eval x = 0 from hx, map_zero]
    rw [← hpp, Polynomial.eval_map]
    have := Polynomial.eval₂_at_apply (e : k →+* k') x (p := p.map (e.symm : k' →+* k))
    rw [RingHom.coe_coe] at this
    rw [this]
    exact hx'
  have resT : ∀ (R S : Type u) [CommRing R] [CommRing S] [IsLocalRing R] [IsLocalRing S]
      (f : R →+* S) [IsLocalHom f], Function.Surjective f →
      Nonempty (IsLocalRing.ResidueField R ≃+* IsLocalRing.ResidueField S) := by
    intro R S _ _ _ _ f _ hf
    have hinj : Function.Injective (IsLocalRing.ResidueField.map f) :=
      @RingHom.injective _ _ _ (DivisionRing.isSimpleRing (IsLocalRing.ResidueField R)) _
        (@DivisionRing.toNontrivial (IsLocalRing.ResidueField S) _) _
    have hsurj : Function.Surjective (IsLocalRing.ResidueField.map f) := by
      intro z
      obtain ⟨y, rfl⟩ := IsLocalRing.residue_surjective z
      obtain ⟨b, rfl⟩ := hf y
      exact ⟨IsLocalRing.residue R b, IsLocalRing.ResidueField.map_residue _ _⟩
    exact ⟨RingEquiv.ofBijective _ ⟨hinj, hsurj⟩⟩
  have hNT : Nontrivial (B ⧸ I) := Ideal.Quotient.nontrivial_iff.mpr hI
  let hH : HenselianLocalRing (B ⧸ I) :=
    @hensT B (B ⧸ I) _ _ hBH hNT (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective
  refine ⟨hH, ?_⟩
  have hLH : IsLocalHom (Ideal.Quotient.mk I) :=
    @IsLocalHom.of_surjective B (B ⧸ I) _ _ hNT hBH.toIsLocalRing (Ideal.Quotient.mk I)
      Ideal.Quotient.mk_surjective
  obtain ⟨ε⟩ := @resT B (B ⧸ I) _ _ hBH.toIsLocalRing hH.toIsLocalRing (Ideal.Quotient.mk I) hLH
    Ideal.Quotient.mk_surjective
  exact @sepT _ _ _ _ hBS ε

theorem wc_cgth_divisor_tube_no_kummer_root : ∀ (A : Type u) [CommRing A] (d ℓ : ℕ), 2 ≤ ℓ → ∀ (B : Type u) [CommRing B] (β : MvPolynomial (Option (Fin d)) A →+* B), WeaklyEtale (Spec.map (CommRingCat.ofHom β)) → ∀ (Ω : Type u) [Field Ω] (ξ : Spec (.of Ω) ⟶ Spec (.of A)) (W : (Limits.pullback (Spec.map (CommRingCat.ofHom (β.comp (algebraMap A (MvPolynomial (Option (Fin d)) A))))) ξ).Etale) (w : W.left), β (MvPolynomial.X none) ∈ ((Limits.pullback.fst (Spec.map (CommRingCat.ofHom (β.comp (algebraMap A (MvPolynomial (Option (Fin d)) A))))) ξ) (W.hom w)).asIdeal → ∀ x : Γ(Limits.pullback W.hom (Limits.pullback.snd (Spec.map (CommRingCat.ofHom (algebraMap B (Localization.Away (β (MvPolynomial.X none)))))) (Limits.pullback.fst (Spec.map (CommRingCat.ofHom (β.comp (algebraMap A (MvPolynomial (Option (Fin d)) A))))) ξ)), ⊤), x ^ ℓ ≠ (Limits.pullback.snd W.hom (Limits.pullback.snd (Spec.map (CommRingCat.ofHom (algebraMap B (Localization.Away (β (MvPolynomial.X none)))))) (Limits.pullback.fst (Spec.map (CommRingCat.ofHom (β.comp (algebraMap A (MvPolynomial (Option (Fin d)) A))))) ξ))).appTop.hom ((Limits.pullback.fst (Spec.map (CommRingCat.ofHom (algebraMap B (Localization.Away (β (MvPolynomial.X none)))))) (Limits.pullback.fst (Spec.map (CommRingCat.ofHom (β.comp (algebraMap A (MvPolynomial (Option (Fin d)) A))))) ξ)).appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of (Localization.Away (β (MvPolynomial.X none))))).inv.hom (algebraMap B (Localization.Away (β (MvPolynomial.X none))) (β (MvPolynomial.X none))))) :=
by
  intro A _ d ℓ hℓ B _ β hβ Ω _ ξ W w hmem x hx
  have t_s1 : ∀ (D : Type u) [CommRing D] [IsDomain D] (t : D), Prime t → ∀ (ℓ : ℕ), 2 ≤ ℓ → ∀ v : Localization.Away t, v ^ ℓ ≠ algebraMap D (Localization.Away t) t := by
    intro D _ _ t ht ℓ hℓ v hv
    obtain ⟨⟨s, m⟩, rfl⟩ := IsLocalization.mk'_surjective (Submonoid.powers t) v
    obtain ⟨n, hn⟩ := (Submonoid.mem_powers_iff _ _).mp m.2
    have ht0 : t ≠ 0 := ht.ne_zero
    have hinj := IsLocalization.injective (Localization.Away t)
      (powers_le_nonZeroDivisors_of_noZeroDivisors ht0)
    simp only at hv
    rw [← IsLocalization.mk'_pow, ← IsLocalization.mk'_one (M := Submonoid.powers t)
      (Localization.Away t) t, IsLocalization.mk'_eq_iff_eq] at hv
    have h1 := hinj hv
    simp only [OneMemClass.coe_one, one_mul, SubmonoidClass.coe_pow, ← hn] at h1
    have key : ∀ n : ℕ, ∀ s : D, s ^ ℓ ≠ (t ^ n) ^ ℓ * t := by
      intro n
      induction n with
      | zero =>
        intro s hs
        rw [pow_zero, one_pow, one_mul] at hs
        have hd' : t ∣ s ^ ℓ := by rw [hs]
        obtain ⟨s₁, rfl⟩ := ht.dvd_of_dvd_pow hd'
        obtain ⟨k, rfl⟩ : ∃ k, ℓ = k + 2 := ⟨ℓ - 2, by omega⟩
        have h3 : t * (t ^ (k + 1) * s₁ ^ (k + 2)) = t * 1 := by
          calc t * (t ^ (k + 1) * s₁ ^ (k + 2)) = (t * s₁) ^ (k + 2) := by ring
            _ = t := hs
            _ = t * 1 := (mul_one t).symm
        have h2 := mul_left_cancel₀ ht0 h3
        exact ht.not_unit (IsUnit.of_mul_eq_one (t ^ k * s₁ ^ (k + 2)) (by rw [← h2]; ring))
      | succ n ih =>
        intro s hs
        have hd' : t ∣ s ^ ℓ := by rw [hs]; exact dvd_mul_left t _
        obtain ⟨s₁, rfl⟩ := ht.dvd_of_dvd_pow hd'
        apply ih s₁
        have h3 : t ^ ℓ * s₁ ^ ℓ = t ^ ℓ * ((t ^ n) ^ ℓ * t) := by
          rw [← mul_pow, hs]; ring
        exact mul_left_cancel₀ (pow_ne_zero _ ht0) h3
    exact key n s h1
  have t_s2 : ∀ (P R' Q : Type u) [CommRing P] [CommRing R'] [CommRing Q] (θ : P →+* R') (σ : P →+* Q) (g : P), Function.Surjective σ → RingHom.ker σ = Ideal.span {g} → WeaklyEtale (Spec.map (CommRingCat.ofHom θ)) → ∃ k : Spec (.of (R' ⧸ Ideal.span {θ g})) ⟶ Spec (.of Q), WeaklyEtale k := by
    intro P R' Q _ _ _ θ σ g hsurj hker hθ
    letI : Algebra P R' := θ.toAlgebra
    haveI : Algebra.WeaklyEtale P R' := wc_lpkt_specMap_weaklyEtale_ring P R' θ hθ
    have hT : WeaklyEtale (Spec.map (CommRingCat.ofHom
        (algebraMap (P ⧸ Ideal.span {g}) (TensorProduct P (P ⧸ Ideal.span {g}) R')))) :=
      wc_lfi_specMap_weaklyEtale (P ⧸ Ideal.span {g}) (TensorProduct P (P ⧸ Ideal.span {g}) R')
        inferInstance
    have hI : Ideal.span {θ g} = Ideal.map (algebraMap P R') (Ideal.span {g}) := by
      rw [Ideal.map_span, Set.image_singleton]
      try rfl
    let e₁ : (R' ⧸ Ideal.span {θ g}) ≃+* TensorProduct P (P ⧸ Ideal.span {g}) R' :=
      ((Ideal.quotEquivOfEq hI).trans
        (Algebra.TensorProduct.quotIdealMapEquivTensorQuot R' (Ideal.span {g})).toRingEquiv).trans
        (Algebra.TensorProduct.comm P R' (P ⧸ Ideal.span {g})).toRingEquiv
    let e₂ : (P ⧸ Ideal.span {g}) ≃+* Q :=
      (Ideal.quotEquivOfEq hker.symm).trans (RingHom.quotientKerEquivOfSurjective hsurj)
    haveI : IsIso (CommRingCat.ofHom (e₁.symm : TensorProduct P (P ⧸ Ideal.span {g}) R' →+*
        R' ⧸ Ideal.span {θ g})) := e₁.symm.toCommRingCatIso.isIso_hom
