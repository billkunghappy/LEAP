  have t_s4 : ∀ (B : Type u) [CommRing B] (u : B) {Y V : Scheme.{u}} (pY : Y ⟶ Spec (.of B)) (p : V ⟶ Y) (R' : Type u) [CommRing R'] (σ : Spec (.of R') ⟶ V) (ℓ : ℕ) (x : Γ(Limits.pullback p (Limits.pullback.snd (Spec.map (CommRingCat.ofHom (algebraMap B (Localization.Away u)))) pY), ⊤)), x ^ ℓ = (Limits.pullback.snd p (Limits.pullback.snd (Spec.map (CommRingCat.ofHom (algebraMap B (Localization.Away u)))) pY)).appTop.hom ((Limits.pullback.fst (Spec.map (CommRingCat.ofHom (algebraMap B (Localization.Away u)))) pY).appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of (Localization.Away u))).inv.hom (algebraMap B (Localization.Away u) u))) → ∃ v : Localization.Away ((Spec.preimage (σ ≫ p ≫ pY)).hom u), v ^ ℓ = algebraMap R' (Localization.Away ((Spec.preimage (σ ≫ p ≫ pY)).hom u)) ((Spec.preimage (σ ≫ p ≫ pY)).hom u) := by
