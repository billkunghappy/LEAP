theorem wc_cpt_th_iso_bc_higher_vanish : ∀ (ℓ : ℕ) (C' : Type u) [CommRing C'] (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (z : Spec (.of Ω) ⟶ Spec (.of C')), (∀ (x : Spec (.of (Polynomial C'))) (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (Polynomial C'))) x)) (Scheme.Etale.forget (Spec (.of (Polynomial C'))))) (φ : ∀ l, Spec (.of B) ⟶ (W'.obj l).right.left) (a : Spec (.of B) ⟶ Spec (.of (Polynomial C'))), wcHalShData x B Λ W' φ a → ∀ q : ℕ, 1 ≤ q → Subsingleton (wcEtCoh (Limits.pullback (a ≫ Spec.map (CommRingCat.ofHom (algebraMap C' (Polynomial C')))) z) ℓ q)) → ∀ (X : Scheme.{u}) (g : X ⟶ Spec (.of C')) (θ : X ≅ Spec (.of (Polynomial C'))), θ.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap C' (Polynomial C'))) = g → ∀ (I : InjectiveResolution ((constantSheaf (Scheme.smallEtaleTopology (Limits.pullback g z)) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))))) (n : ℕ), 1 ≤ n → Limits.IsZero ((((wcEtPush (Limits.pullback.fst g z)).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology n) :=
