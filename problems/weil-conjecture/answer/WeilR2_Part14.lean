    change Subsingleton (Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y)
      AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) F (n + 2))
    exact ⟨fun x y => (hx x).trans (hx y).symm⟩

  obtain ⟨j, c, hj, hc, -, hcov, hpb⟩ := wc_P1_ring_charts K
  haveI := hj
  haveI := hc
  have htop : j.opensRange ⊔ c.opensRange = ⊤ := by
    apply TopologicalSpace.Opens.ext
    rw [TopologicalSpace.Opens.coe_sup, TopologicalSpace.Opens.coe_top, Scheme.Hom.coe_opensRange,
      Scheme.Hom.coe_opensRange]
    ext x
    simp only [Set.mem_union, Set.mem_univ, iff_true]
    exact hcov x

  have hov : Nonempty ((↑(j.opensRange ⊓ c.opensRange) : Scheme.{u}) ≅
      Spec (.of (LaurentPolynomial K))) := by
    have hr : Set.range (j.opensRange ⊓ c.opensRange).ι =
        Set.range (Limits.pullback.fst j c ≫ j) := by
      rw [Scheme.Opens.range_ι, IsOpenImmersion.range_pullback_to_base_of_left,
        TopologicalSpace.Opens.coe_inf, Scheme.Hom.coe_opensRange, Scheme.Hom.coe_opensRange]
    exact ⟨IsOpenImmersion.isoOfRangeEq _ _ hr ≪≫ hpb.isoPullback.symm⟩
  obtain ⟨e⟩ := hov
  obtain ⟨n, rfl⟩ : ∃ n, p = n + 2 := ⟨p - 2, by omega⟩
  exact mvgen _ j.opensRange c.opensRange htop
    (fun G hG q hq => cdfin j.isoOpensRange.inv 1 hA1 G hG q (by omega))
    (fun G hG q hq => cdfin c.isoOpensRange.inv 1 hA1 G hG q (by omega))
    (fun G hG q hq => cdfin e.hom 1 hGm G hG q (by omega)) E hE n (by omega)

theorem wc_P1_ring_strictly_henselian_cd_two : ∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (ℓ : ℕ), ℓ.Prime → IsUnit (ℓ : A) → ∀ (F : Sheaf (Scheme.smallEtaleTopology (@Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) A) MvPolynomial.gradedAlgebra)) AddCommGrpCat.{u+1}), ℓ • 𝟙 F = 0 → ∀ p : ℕ, 3 ≤ p → Subsingleton (wcEtExt (@Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) A) MvPolynomial.gradedAlgebra) F p) :=
by
  intro A _ _ _ ℓ hℓ hℓA F hF p hp

  have transport : ∀ {X : Scheme.{u}} {G H : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}}
      (w : G ⟶ H), IsIso w → ∀ q : ℕ, Subsingleton (wcEtExt X H q) →
      Subsingleton (wcEtExt X G q) := by
    intro X G H w hw q hH
    haveI := hw
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) := HasExt.standard _
    change Subsingleton (Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology X)
      AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) H q) at hH
    change Subsingleton (Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology X)
      AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) G q)
    refine ⟨fun x y => ?_⟩
    have key : ∀ z : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology X)
        AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) G q,
        z = (z.comp (Abelian.Ext.mk₀ w) (add_zero q)).comp (Abelian.Ext.mk₀ (inv w))
          (add_zero q) := by
      intro z
      rw [Abelian.Ext.comp_assoc _ _ _ (add_zero q) (add_zero 0) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, IsIso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
    rw [key x, key y, @Subsingleton.elim _ hH (x.comp (Abelian.Ext.mk₀ w) (add_zero q))
      (y.comp (Abelian.Ext.mk₀ w) (add_zero q))]

  have ses : ∀ {X : Scheme.{u}} {J₁ J₂ : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}}
      (κ : J₁ ⟶ J₂), Mono κ → ∀ q : ℕ, Subsingleton (wcEtExt X J₁ q) →
      Subsingleton (wcEtExt X (Limits.cokernel κ) q) → Subsingleton (wcEtExt X J₂ q) := by
    intro X J₁ J₂ κ hκ q h1 h3
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) := HasExt.standard _
    change Subsingleton (Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology X)
      AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) J₁ q) at h1
    change Subsingleton (Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology X)
      AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) (Limits.cokernel κ) q) at h3
    change Subsingleton (Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology X)
      AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) J₂ q)
    have hS : (ShortComplex.mk κ (Limits.cokernel.π κ) (Limits.cokernel.condition κ)).ShortExact :=
      ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel κ) hκ inferInstance
    have hx : ∀ x : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology X)
        AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) J₂ q, x = 0 := by
      intro x
      have h0 : x.comp (Abelian.Ext.mk₀ (Limits.cokernel.π κ)) (add_zero q) = 0 :=
        @Subsingleton.elim _ h3 _ _
      obtain ⟨x₁, hx₁⟩ := Abelian.Ext.covariant_sequence_exact₂ _ hS x h0
      rw [← hx₁, @Subsingleton.elim _ h1 x₁ 0, Abelian.Ext.zero_comp]
    exact ⟨fun a b => (hx a).trans (hx b).symm⟩

  have hℓ0 : ℓ ≠ 0 := hℓ.ne_zero
  have hℓκ : (ℓ : IsLocalRing.ResidueField A) ≠ 0 := by
    have h := hℓA.map (IsLocalRing.residue A)
    rw [map_natCast] at h
    exact h.ne_zero

  obtain ⟨e₁, e₂, he⟩ := wc_pd_P1_base_iso A

  have hsq : IsPullback (𝟙 _) (wcP1 A ≫ e₂.hom) (wcP1 A) e₂.inv :=
    IsPullback.of_horiz_isIso ⟨by simp⟩
  have hW : IsOpen {x | (wcP1 A ≫ e₂.hom) x ≠ IsLocalRing.closedPoint A} :=
    ((IsLocalRing.isClosed_singleton_closedPoint A).preimage
      (wcP1 A ≫ e₂.hom).continuous).isOpen_compl

  obtain ⟨J', ι, hmono, hsupp, huniv⟩ := wc_et_max_supported_subsheaf _
    {x | (wcP1 A ≫ e₂.hom) x ≠ IsLocalRing.closedPoint A} F
  haveI := hmono

  have hJ'tor : ℓ • 𝟙 J' = 0 := by
    rw [← cancel_mono ι]
    have e : (ℓ • 𝟙 J') ≫ ι = ι ≫ (ℓ • 𝟙 F) := by
      simp only [Preadditive.comp_nsmul, Preadditive.nsmul_comp, Category.comp_id,
        Category.id_comp]
    rw [e, hF, Limits.comp_zero, Limits.zero_comp]

  have hpbc : wcPBCV (wcP1 A) := wc_pbc_P1 A
  have hJ'acyc : ∀ q : ℕ, Subsingleton (wcEtExt _ J' q) :=
    hpbc A e₂.inv _ (wcP1 A ≫ e₂.hom) (𝟙 _) hsq ℓ hℓ0 J' hsupp hJ'tor

  have hQtor : ℓ • 𝟙 (Limits.cokernel ι) = 0 := by
    rw [← cancel_epi (Limits.cokernel.π ι)]
    have e : Limits.cokernel.π ι ≫ (ℓ • 𝟙 (Limits.cokernel ι)) =
        (ℓ • 𝟙 F) ≫ Limits.cokernel.π ι := by
      simp only [Preadditive.comp_nsmul, Preadditive.nsmul_comp, Category.comp_id,
        Category.id_comp]
    rw [e, hF, Limits.zero_comp, Limits.comp_zero]

  obtain ⟨i, hi, hrange⟩ := wc_P1_closed_fibre_embedding A e₂
  haveI := hi

  obtain ⟨L, ⟨adj⟩, hL, _⟩ := wc_et_push_left_adjoint i
  have hunit : IsIso (adj.unit.app (Limits.cokernel ι)) := by
    apply wc_et_closed_unit_iso_of_vanish_off i L adj
    intro V g v hv
    refine wc_et_maxsupp_coker_vanish_off _ _ hW F J' ι hmono hsupp huniv V g v ?_
    show (wcP1 A ≫ e₂.hom) (V.hom v) ≠ IsLocalRing.closedPoint A
    intro h
    exact hv ((hrange _).mpr h)

  haveI : L.IsLeftAdjoint := adj.isLeftAdjoint
  haveI : L.PreservesZeroMorphisms := Functor.preservesZeroMorphisms_of_isLeftAdjoint _
  haveI : L.Additive := Functor.additive_of_preserves_binary_products _
  have hLQ : ℓ • 𝟙 (L.obj (Limits.cokernel ι)) = 0 := by
    rw [← L.map_id, ← Functor.map_nsmul, hQtor, Functor.map_zero]
  haveI hκ := wc_P1_sepclosed_field_cd_two (IsLocalRing.ResidueField A) ℓ hℓ hℓκ
    (L.obj (Limits.cokernel ι)) hLQ p hp
  obtain ⟨E⟩ := wc_et_finite_push_ext_equiv i (L.obj (Limits.cokernel ι)) p
  have hpush : Subsingleton (wcEtExt _ ((wcEtPush i).obj (L.obj (Limits.cokernel ι))) p) :=
    E.injective.subsingleton
  have hQ : Subsingleton (wcEtExt _ (Limits.cokernel ι) p) :=
    transport (adj.unit.app (Limits.cokernel ι)) hunit p hpush

  exact ses ι hmono p (hJ'acyc p) hQ

theorem wc_P1_ring_section_supported_acyclic : ∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (j c : Spec (.of (Polynomial A)) ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) A) MvPolynomial.gradedAlgebra), IsOpenImmersion j → IsOpenImmersion c → (∀ x, x ∈ Set.range j ∨ x ∈ Set.range c) → IsPullback (Spec.map (CommRingCat.ofHom (Polynomial.eval₂RingHom (algebraMap A (LaurentPolynomial A)) (LaurentPolynomial.T (-1))))) (Spec.map (CommRingCat.ofHom (Polynomial.toLaurent : Polynomial A →+* LaurentPolynomial A))) j c → ∀ (F : Sheaf (Scheme.smallEtaleTopology (@Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) A) MvPolynomial.gradedAlgebra)) AddCommGrpCat.{u+1}), (∀ x ∈ Set.range j, Subsingleton ((wcEtStalk _ x).obj F)) → ∀ p : ℕ, Subsingleton (wcEtExt (@Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) A) MvPolynomial.gradedAlgebra) F (p + 1)) :=
by
  classical
  intro A _ _ _ j c hj hc hcov hpb F hF p

  have transport : ∀ {X : Scheme.{u}} (F₁ G₁ : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1})
      (e : F₁ ≅ G₁) (n : ℕ), Subsingleton (wcEtExt X G₁ n) → Subsingleton (wcEtExt X F₁ n) := by
    intro X F₁ G₁ e n hsub
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) := HasExt.standard _
    have hw : ∀ w : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ))) F₁ n, w = 0 := by
      intro w
      have h0 : w.comp (Abelian.Ext.mk₀ e.hom) (add_zero n) = 0 :=
        @Subsingleton.elim _ hsub _ _
      calc w = w.comp (Abelian.Ext.mk₀ (e.hom ≫ e.inv)) (add_zero n) := by
            rw [e.hom_inv_id, Abelian.Ext.comp_mk₀_id]
        _ = (w.comp (Abelian.Ext.mk₀ e.hom) (add_zero n)).comp (Abelian.Ext.mk₀ e.inv)
              (add_zero n) := by
            rw [← Abelian.Ext.mk₀_comp_mk₀, ← Abelian.Ext.comp_assoc_of_third_deg_zero]
        _ = 0 := by rw [h0, Abelian.Ext.zero_comp]
    exact ⟨fun a b => (hw a).trans (hw b).symm⟩

  have hsurj : Function.Surjective (Polynomial.evalRingHom (0 : A)) :=
    fun a => ⟨Polynomial.C a, by simp⟩
  have hr0 : ∀ z : Spec (.of (Polynomial A)),
      z ∈ Set.range (Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom (0 : A)))) ↔
        Polynomial.X ∈ z.asIdeal := by
    intro z
    have h1 := range_comap_of_surjective _ _ hsurj
    rw [Polynomial.ker_evalRingHom, map_zero, sub_zero] at h1
    constructor
    · rintro ⟨w, rfl⟩
      show Polynomial.evalRingHom (0 : A) Polynomial.X ∈ w.asIdeal
      rw [Polynomial.coe_evalRingHom, Polynomial.eval_X]
      exact w.asIdeal.zero_mem
    · intro hz
      have key : ∀ y : PrimeSpectrum (Polynomial A), Polynomial.X ∈ y.asIdeal →
          y ∈ Set.range (PrimeSpectrum.comap (Polynomial.evalRingHom (0 : A))) := by
        intro y hy
        rw [h1, PrimeSpectrum.mem_zeroLocus]
        exact (Ideal.span_singleton_le_iff_mem _).mpr hy
      obtain ⟨w, hw⟩ := key z hz
      exact ⟨w, hw⟩
  have hal : algebraMap (Polynomial A) (LaurentPolynomial A) = Polynomial.toLaurent :=
    RingHom.ext LaurentPolynomial.algebraMap_eq_toLaurent
  have hrs : ∀ z : Spec (.of (Polynomial A)),
      z ∈ Set.range (Spec.map (CommRingCat.ofHom
        (Polynomial.toLaurent : Polynomial A →+* LaurentPolynomial A))) ↔
        Polynomial.X ∉ z.asIdeal := by
    intro z
    have h1 := PrimeSpectrum.localization_away_comap_range (LaurentPolynomial A)
      (Polynomial.X : Polynomial A)
    rw [hal] at h1
    constructor
    · rintro ⟨w, rfl⟩
      have hm : PrimeSpectrum.comap (Polynomial.toLaurent : Polynomial A →+* LaurentPolynomial A) w ∈
          (PrimeSpectrum.basicOpen (Polynomial.X : Polynomial A) : Set (PrimeSpectrum (Polynomial A))) := by
        rw [← h1]
        exact ⟨w, rfl⟩
      exact hm
    · intro hz
      have key : ∀ y : PrimeSpectrum (Polynomial A), Polynomial.X ∉ y.asIdeal →
          y ∈ Set.range (PrimeSpectrum.comap
            (Polynomial.toLaurent : Polynomial A →+* LaurentPolynomial A)) := by
        intro y hy
        rw [h1]
        exact hy
      obtain ⟨w, hw⟩ := key z hz
      exact ⟨w, hw⟩
  have hstar : ∀ z : Spec (.of (Polynomial A)), c z ∈ Set.range j ↔ Polynomial.X ∉ z.asIdeal := by
    intro z
    rw [← hrs z]
    have hinv : hpb.isoPullback.inv ≫ Spec.map (CommRingCat.ofHom
        (Polynomial.toLaurent : Polynomial A →+* LaurentPolynomial A)) = Limits.pullback.snd j c := by
      rw [Iso.inv_comp_eq]
      exact hpb.isoPullback_hom_snd.symm
    have h2 : Set.range (Spec.map (CommRingCat.ofHom
        (Polynomial.toLaurent : Polynomial A →+* LaurentPolynomial A))) =
        Set.range (Limits.pullback.snd j c) := by
      ext w
      constructor
      · rintro ⟨v, rfl⟩
        exact ⟨hpb.isoPullback.hom v, by rw [← Scheme.Hom.comp_apply, hpb.isoPullback_hom_snd]⟩
      · rintro ⟨v, rfl⟩
        exact ⟨hpb.isoPullback.inv v, by rw [← Scheme.Hom.comp_apply, hinv]⟩
    rw [h2, Scheme.Pullback.range_snd]
    rfl
  have hrange : Set.range (Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom (0 : A))) ≫ c) =
      (Set.range j)ᶜ := by
    ext x
    constructor
    · rintro ⟨w, rfl⟩
      rw [Scheme.Hom.comp_apply]
      intro hx
      exact ((hstar _).mp hx) ((hr0 _).mp ⟨w, rfl⟩)
    · intro hx
      rcases hcov x with h | ⟨z, rfl⟩
      · exact (hx h).elim
      · have hz : Polynomial.X ∈ z.asIdeal := by
          by_contra hn
          exact hx ((hstar z).mpr hn)
        obtain ⟨w, rfl⟩ := (hr0 z).mpr hz
        exact ⟨w, by rw [Scheme.Hom.comp_apply]⟩
  haveI : IsClosedImmersion (Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom (0 : A)))) :=
    IsClosedImmersion.spec_of_surjective _ hsurj
  haveI := hc
  haveI hi : IsClosedImmersion (Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom (0 : A))) ≫ c) := by
    apply IsClosedImmersion.of_isPreimmersion
    rw [hrange]
    exact (IsOpenImmersion.isOpen_range j).isClosed_compl

  obtain ⟨L, ⟨adj⟩, _, _⟩ := wc_et_push_left_adjoint
    (Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom (0 : A))) ≫ c)
  haveI hiso : IsIso (adj.unit.app F) := by
    refine wc_et_closed_unit_iso_of_vanish_off _ L adj F ?_
    intro V g v hv
    rw [hrange, Set.mem_compl_iff, not_not] at hv
    exact wc_et_vanish_off_of_stalks F V g v (hF _ hv)

  obtain ⟨E'⟩ := wc_et_finite_push_ext_equiv
    (Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom (0 : A))) ≫ c) (L.obj F) (p + 1)
  haveI := wc_et_strictly_local_ext_vanishing A (L.obj F) p
  have hsub := E'.injective.subsingleton
  exact transport F _ (asIso (adj.unit.app F)) (p + 1) hsub

theorem wc_et_open_imm_shens_pullback_acyclic : ∀ {U P : Scheme.{u}} (j : U ⟶ P) [IsOpenImmersion j] (x : P), x ∈ Set.range j → ∀ (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt P x)) (Scheme.Etale.forget P)) (φ : ∀ l, Spec (.of B) ⟶ (W'.obj l).right.left) (ax : Spec (.of B) ⟶ P), wcHalShData x B Λ W' φ ax → ∀ (G : Sheaf (Scheme.smallEtaleTopology (Limits.pullback j ax)) AddCommGrpCat.{u+1}) (s : ℕ), Subsingleton (wcEtExt (Limits.pullback j ax) G (s + 1)) :=
by
  intro U P j _ x hx B _ _ _ Λ _ _ W' φ ax hsh G s
  obtain ⟨_, _, _, _, _, e, _, heq⟩ := hsh
  have h1 : ax (IsLocalRing.closedPoint B) = x := by
    have key : ∀ {T : Scheme.{u}} (a b : T ⟶ P), a = b → ∀ t, a t = b t := by
      intro T a b hab t; rw [hab]
    let t : ↥(Spec (.of (AlgebraicClosure (P.residueField x)))) :=
      IsLocalRing.closedPoint (AlgebraicClosure (P.residueField x))
    have h := key _ _ heq t
    simp only [Scheme.Hom.comp_apply, wcEtGeomPt, Scheme.fromSpecResidueField_apply] at h
    have hc : ∀ q : ↥(Spec (.of (IsLocalRing.ResidueField B))),
        (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B))) q =
        IsLocalRing.closedPoint B := by
      intro q
      have hq : q = (IsLocalRing.closedPoint (IsLocalRing.ResidueField B) :
          ↥(Spec (.of (IsLocalRing.ResidueField B)))) := Subsingleton.elim _ _
      rw [hq]
      haveI : IsLocalHom (CommRingCat.Hom.hom (CommRingCat.ofHom (IsLocalRing.residue B))) := by
        rw [CommRingCat.hom_ofHom]
        first
          | infer_instance
          | exact IsLocalHom.of_surjective _ IsLocalRing.residue_surjective
      exact Spec_closedPoint
    rw [hc] at h
    first
      | exact h.trans (Scheme.fromSpecResidueField_apply _ _)
      | exact h.trans (Scheme.fromSpecResidueField_apply _)
      | exact h.trans (by simp [Scheme.fromSpecResidueField_apply])
  have h2 : Set.range ax ⊆ Set.range j := by
    rintro _ ⟨p, rfl⟩
    have hxj : ax (IsLocalRing.closedPoint B) ∈ Set.range j := by rw [h1]; exact hx
    exact ((IsLocalRing.specializes_closedPoint p).map ax.continuous).mem_open
      j.isOpenEmbedding.isOpen_range hxj
  have hfac : IsOpenImmersion.lift j ax h2 ≫ j = ax := IsOpenImmersion.lift_fac _ _ _
  haveI : IsIso (Limits.pullback.snd j ax) := by
    refine ⟨⟨Limits.pullback.lift (IsOpenImmersion.lift j ax h2) (𝟙 _)
      (by rw [hfac, Category.id_comp]), ?_, ?_⟩⟩
    · apply Limits.pullback.hom_ext
      · rw [Category.assoc, Limits.pullback.lift_fst, Category.id_comp, ← cancel_mono j,
          Category.assoc, hfac, Limits.pullback.condition]
      · rw [Category.assoc, Limits.pullback.lift_snd, Category.comp_id, Category.id_comp]
    · exact Limits.pullback.lift_snd _ _ _
  obtain ⟨E⟩ := wc_et_finite_push_ext_equiv (Limits.pullback.snd j ax) G (s + 1)
  haveI := wc_et_strictly_local_ext_vanishing B ((wcEtPush (Limits.pullback.snd j ax)).obj G) s
  exact E.symm.injective.subsingleton

