  exact ⟨x', hx', hxc', B', iB1, iB2, iB3, Λ', iL1, iL2, W'', φ', a', β, hd', hfin⟩

theorem wc_affine_line_etale_torsor_algclosed_descent : ∀ (A : Type u) [CommRing A] (W : Scheme.{u}) [IsAffine W] (e : W ⟶ Spec (.of (Polynomial A))) [Etale e] (L : Type u) [Field L] [IsAlgClosed L] (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (zb : Spec (.of L) ⟶ Spec (.of A)) (ι : L →+* Ω) (ℓ : ℕ), ℓ.Prime → (ℓ : L) ≠ 0 → ∀ (P : Scheme.{u}) (p : P ⟶ Limits.pullback (e ≫ Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) (Spec.map (CommRingCat.ofHom ι) ≫ zb)) (α : ZMod ℓ → (P ⟶ P)), wcFetTorsor p ℓ α → ∃ (Q : Scheme.{u}) (q : Q ⟶ Limits.pullback (e ≫ Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) zb) (β : ZMod ℓ → (Q ⟶ Q)) (j : P ⟶ Q), wcFetTorsor q ℓ β ∧ IsPullback j p q (Limits.pullback.lift (Limits.pullback.fst (e ≫ Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) (Spec.map (CommRingCat.ofHom ι) ≫ zb)) (Limits.pullback.snd (e ≫ Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) (Spec.map (CommRingCat.ofHom ι) ≫ zb) ≫ Spec.map (CommRingCat.ofHom ι)) (by rw [Limits.pullback.condition, Category.assoc])) :=
by
  intro A _ W _ e _ L _ _ Ω _ _ zb ι ℓ hℓ hℓL P p α hP
  classical
  haveI : NeZero (ℓ : L) := ⟨hℓL⟩
  obtain ⟨ζ, hζ⟩ := IsAlgClosed.exists_root (Polynomial.cyclotomic ℓ L) (by
    rw [Polynomial.degree_cyclotomic]
    exact_mod_cast (Nat.totient_pos.mpr hℓ.pos).ne')
  have hprim : IsPrimitiveRoot ζ ℓ := (Polynomial.isRoot_cyclotomic_iff).mp hζ
  letI : Algebra L Ω := ι.toAlgebra

  have pres : ∃ (R : Type u) (_ : CommRing R) (_ : Algebra L R) (_ : Algebra (Polynomial L) R) (_ : IsScalarTower L (Polynomial L) R) (ψ : Limits.pullback (e ≫ Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) zb ≅ Spec (.of R)) (Θ : Limits.pullback (e ≫ Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) (Spec.map (CommRingCat.ofHom (algebraMap L Ω)) ≫ zb) ≅ Spec (.of (TensorProduct L R Ω))), Algebra.Etale (Polynomial L) R ∧ Θ.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap R (TensorProduct L R Ω))) = Limits.pullback.lift (Limits.pullback.fst (e ≫ Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) (Spec.map (CommRingCat.ofHom (algebraMap L Ω)) ≫ zb)) (Limits.pullback.snd (e ≫ Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) (Spec.map (CommRingCat.ofHom (algebraMap L Ω)) ≫ zb) ≫ Spec.map (CommRingCat.ofHom (algebraMap L Ω))) (by rw [Limits.pullback.condition, Category.assoc]) ≫ ψ.hom := by
    have s2 : ∃ h : Spec (.of (Polynomial L)) ⟶ Spec (.of (Polynomial A)),
