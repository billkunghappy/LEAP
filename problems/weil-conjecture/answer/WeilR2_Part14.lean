    have hM : ∀ b : B, b ∈ M ↔ σ 1 b = algebraMap L B ζ * b := fun b => Iff.rfl
    obtain ⟨hMinv, μ, hμ⟩ := wc_kummer_eigen_line L ℓ hℓ ζ hprim (TensorProduct L R Ω) B σ hσ0
      hσadd hBet hBfin hBsurj hBmu M hM
    obtain ⟨N₀, _, _, hN₀inv, ⟨μ₀⟩, ⟨φ₀⟩⟩ :=
      wc_curve_pic_ell_torsion_descent L Ω R ℓ hℓ hℓL M hMinv ⟨μ⟩
    have hunits := wc_curve_units_descent L Ω R ℓ hℓ.pos
    obtain ⟨N, hNbij, hNval⟩ :=
      wc_kummer_line_adjust R (TensorProduct L R Ω) M N₀ ℓ hℓ.pos μ μ₀ φ₀ hunits
    have hprod : ∀ x : Fin ℓ → N, ∏ i, ((x i : M) : B) ∈ Set.range (algebraMap R B) := by
      intro x
