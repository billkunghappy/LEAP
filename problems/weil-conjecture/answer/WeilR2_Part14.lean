  refine @Equiv.subsingleton _ _ E₂.symm ?_
  have hC : ((((sheafToPresheaf (Scheme.smallEtaleTopology (Limits.pullback ρ z))
      AddCommGrpCat.{u+1} ⋙
      (Functor.whiskeringLeft ((Spec (.of (Polynomial A))).Etale)ᵒᵖ
