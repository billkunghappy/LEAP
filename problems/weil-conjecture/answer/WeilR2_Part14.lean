theorem wc_cgt_milnor_divisor_prime : ∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)] [Algebra A B] [IsLocalHom (algebraMap A B)] (d : ℕ) (β : MvPolynomial (Option (Fin d)) A →+* B), β.comp MvPolynomial.C = algebraMap A B → β (MvPolynomial.X none) ∈ IsLocalRing.maximalIdeal B → (∃ (I : Type u) (_ : SmallCategory I) (_ : IsFiltered I) (F : I ⥤ CommRingCat.{u}) (p : ∀ i, MvPolynomial (Option (Fin d)) A →+* F.obj i) (ι : ∀ i, F.obj i →+* B), (∀ i, (p i).Etale) ∧ (∀ {i j : I} (f : i ⟶ j), (F.map f).hom.comp (p i) = p j) ∧ (∀ {i j : I} (f : i ⟶ j), (ι j).comp (F.map f).hom = ι i) ∧ (∀ i, (ι i).comp (p i) = β) ∧ (∀ b : B, ∃ (i : I) (t : F.obj i), ι i t = b) ∧ (∀ (i : I) (t : F.obj i), ι i t = 0 → ∃ (j : I) (f : i ⟶ j), (F.map f).hom t = 0)) → ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] [Algebra A Ω], Prime (TensorProduct.tmul A (β (MvPolynomial.X none)) (1 : Ω)) :=
by
  intro A _ _ _ B _ _ _ _ _ d β hβC hum hFEP Ω _ _ _
  classical

  have s1 : Function.Bijective ((Ideal.Quotient.mk (Ideal.span {(MvPolynomial.X none : MvPolynomial (Option (Fin d)) A)})).comp (MvPolynomial.rename (R := A) (Option.some : Fin d → Option (Fin d))).toRingHom) := by
    set J := Ideal.span {(MvPolynomial.X none : MvPolynomial (Option (Fin d)) A)} with hJ
    let e : MvPolynomial (Option (Fin d)) A →ₐ[A] MvPolynomial (Fin d) A :=
      MvPolynomial.aeval (fun o => Option.elim o 0 MvPolynomial.X)
    have he : ∀ a ∈ J, e a = 0 := by
      intro a ha
      obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp ha
      simp [e]
    let ψ : MvPolynomial (Option (Fin d)) A ⧸ J →+* MvPolynomial (Fin d) A :=
      Ideal.Quotient.lift J e.toRingHom he
    refine Function.bijective_iff_has_inverse.mpr ⟨ψ, ?_, ?_⟩
    · intro y
      have h1 : e.comp (MvPolynomial.rename (R := A) (Option.some : Fin d → Option (Fin d))) = AlgHom.id A _ := by
        apply MvPolynomial.algHom_ext; intro i; simp [e]
      have h2 := congrArg (fun φ => φ y) h1
      simpa [ψ] using h2
    · intro z
      obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective z
      have h1 : (Ideal.Quotient.mkₐ A J).comp ((MvPolynomial.rename (R := A) (Option.some : Fin d → Option (Fin d))).comp e) = Ideal.Quotient.mkₐ A J := by
        apply MvPolynomial.algHom_ext
        intro o
        cases o with
        | none =>
          simp only [AlgHom.comp_apply, e, MvPolynomial.aeval_X, Option.elim_none, map_zero]
          exact (Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _)).symm
        | some i => simp [e]
      have h2 := congrArg (fun φ => φ y) h1
      simpa [ψ] using h2

  have s2 : ∀ (R S : Type u) [CommRing R] [CommRing S] (p : R →+* S), p.Etale → ∀ (x : R)
      (h : Ideal.span {x} ≤ Ideal.comap p (Ideal.span {p x})),
      (Ideal.quotientMap (Ideal.span {p x}) p h).Etale := by
    intro R S _ _ p hp x h
    letI : Algebra R S := p.toAlgebra
    haveI : Algebra.Etale R S := RingHom.etale_algebraMap.mp hp
    set I : Ideal R := Ideal.span {x} with hI
    have hmap : Ideal.span {p x} = I.map (algebraMap R S) := by
      rw [hI, Ideal.map_span, Set.image_singleton]; rfl
    let ε : (S ⧸ Ideal.span {p x}) ≃+* TensorProduct R (R ⧸ I) S :=
      (Ideal.quotEquivOfEq hmap).trans
        ((Algebra.TensorProduct.quotIdealMapEquivTensorQuot S I).toRingEquiv.trans
          (Algebra.TensorProduct.comm R S (R ⧸ I)).toRingEquiv)
    have hkey : (ε.toRingHom).comp (Ideal.quotientMap (Ideal.span {p x}) p h) =
        algebraMap (R ⧸ I) (TensorProduct R (R ⧸ I) S) := by
      apply Ideal.Quotient.ringHom_ext
      ext r
      simp only [RingHom.comp_apply, Ideal.quotientMap_mk, RingEquiv.toRingHom_eq_coe,
        RingEquiv.coe_toRingHom]
      simp only [ε, RingEquiv.trans_apply, Ideal.quotEquivOfEq_mk,
        AlgEquiv.coe_ringEquiv, Algebra.TensorProduct.quotIdealMapEquivTensorQuot_mk,
        Algebra.TensorProduct.comm_tmul, Algebra.TensorProduct.algebraMap_apply]
      have : p r = r • (1 : S) := by rw [Algebra.smul_def, mul_one]; rfl
      rw [this, TensorProduct.tmul_smul, TensorProduct.smul_tmul', Algebra.smul_def, mul_one]
      rfl
    have heq : Ideal.quotientMap (Ideal.span {p x}) p h =
        (ε.symm.toRingHom).comp (algebraMap (R ⧸ I) (TensorProduct R (R ⧸ I) S)) := by
      rw [← hkey, ← RingHom.comp_assoc]
      ext t
      simp
    rw [heq]
    apply RingHom.Etale.stableUnderComposition
    · exact RingHom.etale_algebraMap.mpr (Algebra.Etale.baseChange R S (R ⧸ I))
    · exact RingHom.Etale.of_bijective ε.symm.bijective

  have s5 : ∀ (v : B), RingHom.ker (Algebra.TensorProduct.map (Ideal.Quotient.mkₐ A (Ideal.span {v})) (AlgHom.id A Ω)) = Ideal.span {TensorProduct.tmul A v (1 : Ω)} := by
    intro v
    have hk : RingHom.ker (Ideal.Quotient.mkₐ A (Ideal.span {v})) = Ideal.span {v} := by
      ext y
      simp [RingHom.mem_ker, Ideal.Quotient.eq_zero_iff_mem]
    rw [Algebra.TensorProduct.rTensor_ker _ (Ideal.Quotient.mkₐ_surjective A _), hk,
      Ideal.map_span, Set.image_singleton]
    rfl

  have s4 : ∀ (σ : Type) (β : MvPolynomial σ A →+* B), β.comp MvPolynomial.C = algebraMap A B → β.Flat →
      ∀ (s : σ) (z : TensorProduct A B Ω), (TensorProduct.tmul A (β (MvPolynomial.X s)) (1 : Ω)) * z = 0 → z = 0 := by
    intro σ β hβC hflat s z hz
    letI : Algebra (MvPolynomial σ A) B := β.toAlgebra
    haveI : Module.Flat (MvPolynomial σ A) B := hflat
    haveI : IsScalarTower A (MvPolynomial σ A) B := IsScalarTower.of_algebraMap_eq (fun a => by
      rw [RingHom.algebraMap_toAlgebra, MvPolynomial.algebraMap_eq, ← RingHom.comp_apply, hβC])
    let c := Algebra.TensorProduct.cancelBaseChange A (MvPolynomial σ A) B B Ω
    let y0 : TensorProduct A (MvPolynomial σ A) Ω := MvPolynomial.X s ⊗ₜ[A] (1 : Ω)
    let μ := LinearMap.mulLeft (MvPolynomial σ A) y0
    have hμ : Function.Injective μ := by
      let θ := (Algebra.TensorProduct.comm A (MvPolynomial σ A) Ω).toRingEquiv.trans
        (MvPolynomial.algebraTensorAlgEquiv A Ω (σ := σ)).toRingEquiv
      have hθ : θ y0 = MvPolynomial.X s := by
        simp [θ, y0, MvPolynomial.algebraTensorAlgEquiv_tmul]
      rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
      intro y hy
      have h1 : θ (y0 * y) = 0 := by rw [show y0 * y = μ y from rfl, hy, map_zero]
      rw [map_mul, hθ] at h1
      have h2 : θ y = 0 := (MvPolynomial.isRegular_X (n := s)).left (show MvPolynomial.X s * θ y = MvPolynomial.X s * 0 by rw [h1, mul_zero])
      exact θ.injective (by rw [h2, map_zero])
    have hinj := Module.Flat.lTensor_preserves_injective_linearMap (M := B) μ hμ
    have hl : ∀ v, c (LinearMap.lTensor B μ v) =
        TensorProduct.tmul A (β (MvPolynomial.X s)) (1 : Ω) * c v := by
      intro v
      induction v using TensorProduct.induction_on with
      | zero => simp
      | tmul b m =>
        induction m using TensorProduct.induction_on with
        | zero => simp
        | tmul r ω =>
          simp only [LinearMap.lTensor_tmul, μ, LinearMap.mulLeft_apply, y0,
            Algebra.TensorProduct.tmul_mul_tmul, one_mul, c,
            Algebra.TensorProduct.cancelBaseChange_tmul, Algebra.smul_def,
            RingHom.algebraMap_toAlgebra, map_mul, mul_assoc]
        | add m₁ m₂ h₁ h₂ => simp only [TensorProduct.tmul_add, map_add, h₁, h₂, mul_add]
      | add v₁ v₂ h₁ h₂ => simp only [map_add, h₁, h₂, mul_add]
    have hv : LinearMap.lTensor B μ (c.symm z) = 0 := by
      apply c.injective
      rw [hl, AlgEquiv.apply_symm_apply, hz, map_zero]
    have hv0 : c.symm z = 0 := hinj (by rw [hv, map_zero])
    rw [← c.apply_symm_apply z, hv0, map_zero]

  obtain ⟨I, instI, instF, F, p, ι, hE, hCp, hCι, hTr, hSu, hIn⟩ := hFEP
  set x : MvPolynomial (Option (Fin d)) A := MvPolynomial.X none with hx
  set L : Ideal B := Ideal.span {β x} with hLdef
  let φ : MvPolynomial (Fin d) A →+* MvPolynomial (Option (Fin d)) A :=
    (MvPolynomial.rename (R := A) (Option.some : Fin d → Option (Fin d))).toRingHom
  let K : ∀ i, Ideal (F.obj i) := fun i => Ideal.span {p i x}
  have k1 : ∀ {i j : I} (f : i ⟶ j), K i ≤ (K j).comap (F.map f).hom := by
    intro i j f
    rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, Ideal.mem_comap,
      ← RingHom.comp_apply, hCp f]
    exact Ideal.mem_span_singleton_self _
  have k2 : ∀ i, K i ≤ L.comap (ι i) := by
    intro i
    rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, Ideal.mem_comap,
      ← RingHom.comp_apply, hTr i]
    exact Ideal.mem_span_singleton_self _
  have k3 : ∀ i, Ideal.span {x} ≤ (K i).comap (p i) := by
    intro i
    rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, Ideal.mem_comap]
    exact Ideal.mem_span_singleton_self _
  let F' : I ⥤ CommRingCat.{u} :=
    { obj := fun i => CommRingCat.of (F.obj i ⧸ K i)
      map := fun {i j} f => CommRingCat.ofHom (Ideal.quotientMap (K j) (F.map f).hom (k1 f))
      map_id := by
        intro i
        ext t
        simp [Ideal.quotientMap_mk]
      map_comp := by
        intro i j k f g
        ext t
        simp [Ideal.quotientMap_mk] }
  let p' : ∀ i, MvPolynomial (Fin d) A →+* F'.obj i := fun i =>
    (Ideal.quotientMap (K i) (p i) (k3 i)).comp ((Ideal.Quotient.mk (Ideal.span {x})).comp φ)
  let ι' : ∀ i, F'.obj i →+* B ⧸ L := fun i => Ideal.quotientMap L (ι i) (k2 i)
  have hF'map : ∀ {i j : I} (f : i ⟶ j) (t : F.obj i),
      (F'.map f).hom (Ideal.Quotient.mk (K i) t) = Ideal.Quotient.mk (K j) ((F.map f).hom t) :=
    fun f t => rfl
  have hp' : ∀ i y, p' i y = Ideal.Quotient.mk (K i) (p i (φ y)) := fun _ _ => rfl
  have hι' : ∀ i (t : F.obj i), ι' i (Ideal.Quotient.mk (K i) t) = Ideal.Quotient.mk L (ι i t) :=
    fun _ _ => rfl
  have hE' : ∀ i, (p' i).Etale := by
    intro i
    apply RingHom.Etale.stableUnderComposition
    · exact RingHom.Etale.of_bijective s1
    · exact s2 _ _ (p i) (hE i) x (k3 i)
  have hCp' : ∀ {i j : I} (f : i ⟶ j), (F'.map f).hom.comp (p' i) = p' j := by
    intro i j f
    refine RingHom.ext fun y => ?_
    rw [RingHom.comp_apply, hp', hp', hF'map, ← RingHom.comp_apply (F.map f).hom, hCp f]
  have hCι' : ∀ {i j : I} (f : i ⟶ j), (ι' j).comp (F'.map f).hom = ι' i := by
    intro i j f
    refine RingHom.ext fun t' => ?_
    obtain ⟨t, rfl⟩ := Ideal.Quotient.mk_surjective (I := K i) t'
    rw [RingHom.comp_apply, hF'map, hι', hι', ← RingHom.comp_apply (ι j), hCι f]
  have hTr' : ∀ i, (ι' i).comp (p' i) = (Ideal.Quotient.mk L).comp (β.comp φ) := by
    intro i
    refine RingHom.ext fun y => ?_
    rw [RingHom.comp_apply, hp', hι', ← RingHom.comp_apply (ι i), hTr i]
    rfl
  have hSu' : ∀ b : B ⧸ L, ∃ (i : I) (t : F'.obj i), ι' i t = b := by
    intro b'
    obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective b'
    obtain ⟨i, t, rfl⟩ := hSu b
    exact ⟨i, Ideal.Quotient.mk (K i) t, hι' i t⟩
  have hIn' : ∀ (i : I) (t : F'.obj i), ι' i t = 0 → ∃ (j : I) (f : i ⟶ j), (F'.map f).hom t = 0 := by
    intro i t' ht'
    obtain ⟨t, rfl⟩ := Ideal.Quotient.mk_surjective (I := K i) t'
    rw [hι', Ideal.Quotient.eq_zero_iff_mem, hLdef, Ideal.mem_span_singleton'] at ht'
    obtain ⟨c, hc⟩ := ht'
    obtain ⟨k, s, rfl⟩ := hSu c
    have hτ : ι (IsFiltered.max i k) ((F.map (IsFiltered.leftToMax i k)).hom t -
        (F.map (IsFiltered.rightToMax i k)).hom s * p (IsFiltered.max i k) x) = 0 := by
      rw [map_sub, map_mul, ← RingHom.comp_apply, hCι, ← RingHom.comp_apply (ι _), hCι,
        ← RingHom.comp_apply (ι _), hTr, hc, sub_self]
    obtain ⟨j, g, hg⟩ := hIn _ _ hτ
    refine ⟨j, IsFiltered.leftToMax i k ≫ g, ?_⟩
    rw [hF'map, Ideal.Quotient.eq_zero_iff_mem, Functor.map_comp, CommRingCat.hom_comp,
      RingHom.comp_apply]
    rw [map_sub, map_mul, sub_eq_zero, ← RingHom.comp_apply (F.map g).hom (p _), hCp g] at hg
    rw [hg]
    exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _)

  have hL : L ≤ IsLocalRing.maximalIdeal B := (Ideal.span_singleton_le_iff_mem _).mpr hum
  have hLtop : L ≠ ⊤ := fun h => (IsLocalRing.maximalIdeal.isMaximal B).ne_top (top_le_iff.mp (h ▸ hL))
  haveI : Nontrivial (B ⧸ L) := Ideal.Quotient.nontrivial_iff.mpr hLtop
  haveI : IsLocalRing (B ⧸ L) := IsLocalRing.of_surjective' (Ideal.Quotient.mk L) Ideal.Quotient.mk_surjective
  haveI : IsLocalHom (Ideal.Quotient.mk L) := isLocalHom_of_le_jacobson_bot L (by
    rw [IsLocalRing.jacobson_eq_maximalIdeal ⊥ bot_ne_top]; exact hL)
  haveI : IsLocalHom (algebraMap A (B ⧸ L)) := by
    rw [IsScalarTower.algebraMap_eq A B (B ⧸ L), Ideal.Quotient.algebraMap_eq]
    exact RingHom.isLocalHom_comp _ _
  have hβ'C : ((Ideal.Quotient.mk L).comp (β.comp φ)).comp MvPolynomial.C = algebraMap A (B ⧸ L) := by
    refine RingHom.ext fun a => ?_
    show Ideal.Quotient.mk L (β (MvPolynomial.rename (R := A) Option.some (MvPolynomial.C a))) = algebraMap A (B ⧸ L) a
    rw [MvPolynomial.rename_C, ← RingHom.comp_apply β, hβC]
    rfl
  haveI hdom : IsDomain (TensorProduct A (B ⧸ L) Ω) :=
    wc_ring_milnor_fibre_isDomain_mv A (B ⧸ L) Ω (Fin d) ((Ideal.Quotient.mk L).comp (β.comp φ)) hβ'C
      ⟨I, instI, instF, F', p', ι', hE', hCp', hCι', hTr', hSu', hIn'⟩

  have hprime : (Ideal.span {TensorProduct.tmul A (β x) (1 : Ω)}).IsPrime := by
    rw [← s5 (β x)]
    exact RingHom.ker_isPrime _

  haveI : Nontrivial (TensorProduct A B Ω) :=
    RingHom.domain_nontrivial (Algebra.TensorProduct.map (Ideal.Quotient.mkₐ A L) (AlgHom.id A Ω)).toRingHom
  have hflat : β.Flat := by
    letI : Algebra (MvPolynomial (Option (Fin d)) A) B := β.toAlgebra
    exact (wc_ring_fep_flat_and_base_change (MvPolynomial (Option (Fin d)) A) B
      (MvPolynomial (Option (Fin d)) A) I F p ι hE hCp hCι
      (fun i => by rw [RingHom.algebraMap_toAlgebra]; exact hTr i) hSu hIn).1
  have hw0 : TensorProduct.tmul A (β x) (1 : Ω) ≠ 0 := by
    intro h0
    have h1 := s4 (Option (Fin d)) β hβC hflat none 1 (by rw [← hx, h0, zero_mul])
    exact one_ne_zero h1
  exact (Ideal.span_singleton_prime hw0).mp hprime

theorem wc_cmt_fep_indEtale : ∀ (P B : Type u) [CommRing P] [CommRing B] (β : P →+* B), (∃ (I : Type u) (_ : SmallCategory I) (_ : IsFiltered I) (F : I ⥤ CommRingCat.{u}) (p : ∀ i, P →+* F.obj i) (ι : ∀ i, F.obj i →+* B), (∀ i, (p i).Etale) ∧ (∀ {i j : I} (f : i ⟶ j), (F.map f).hom.comp (p i) = p j) ∧ (∀ {i j : I} (f : i ⟶ j), (ι j).comp (F.map f).hom = ι i) ∧ (∀ i, (ι i).comp (p i) = β) ∧ (∀ b : B, ∃ (i : I) (t : F.obj i), ι i t = b) ∧ (∀ (i : I) (t : F.obj i), ι i t = 0 → ∃ (j : I) (f : i ⟶ j), (F.map f).hom t = 0)) → wcIndEtale β :=
by
  intro P B _ _ β ⟨I, _, _, F, p, ι, hEt, hp, hι, hβ, hsurj, hker⟩

  have lift : ∀ (n : ℕ) (b : Fin n → B), ∃ (i : I) (s : Fin n → F.obj i), ∀ t, ι i (s t) = b t := by
    intro n
    induction n with
    | zero =>
      intro b
      obtain ⟨i₀⟩ := IsFiltered.nonempty (C := I)
      exact ⟨i₀, fun t => t.elim0, fun t => t.elim0⟩
    | succ n ih =>
      intro b
      obtain ⟨i, s, hs⟩ := ih (fun t => b t.castSucc)
      obtain ⟨i', t', ht'⟩ := hsurj (b (Fin.last n))
      refine ⟨IsFiltered.max i i', Fin.lastCases ((F.map (IsFiltered.rightToMax i i')).hom t')
        (fun t => (F.map (IsFiltered.leftToMax i i')).hom (s t)), ?_⟩
      intro t
      refine Fin.lastCases ?_ (fun t₀ => ?_) t
      · dsimp only
        rw [Fin.lastCases_last]
        exact (RingHom.congr_fun (hι (IsFiltered.rightToMax i i')) t').trans ht'
      · dsimp only
        rw [Fin.lastCases_castSucc]
        exact (RingHom.congr_fun (hι (IsFiltered.leftToMax i i')) (s t₀)).trans (hs t₀)

  have kill : ∀ (i : I) (r : ℕ) (y : Fin r → F.obj i),
      (∀ k, ∃ (j : I) (f : i ⟶ j), (F.map f).hom (y k) = 0) →
      ∃ (j : I) (g : i ⟶ j), ∀ k, (F.map g).hom (y k) = 0 := by
    intro i r
    induction r with
    | zero => intro y _; exact ⟨i, 𝟙 i, fun k => k.elim0⟩
    | succ r ih =>
      intro y hy
      obtain ⟨j, g, hg⟩ := ih (fun k => y k.castSucc) (fun k => hy k.castSucc)
      obtain ⟨j', f, hf⟩ := hy (Fin.last r)
      have hc : (g ≫ IsFiltered.leftToMax j j') ≫
            IsFiltered.coeqHom (g ≫ IsFiltered.leftToMax j j') (f ≫ IsFiltered.rightToMax j j') =
          (f ≫ IsFiltered.rightToMax j j') ≫
            IsFiltered.coeqHom (g ≫ IsFiltered.leftToMax j j') (f ≫ IsFiltered.rightToMax j j') :=
        IsFiltered.coeq_condition _ _
      refine ⟨_, (g ≫ IsFiltered.leftToMax j j') ≫
        IsFiltered.coeqHom (g ≫ IsFiltered.leftToMax j j') (f ≫ IsFiltered.rightToMax j j'), ?_⟩
      intro k
      refine Fin.lastCases ?_ (fun k₀ => ?_) k
      · rw [hc]
        simp only [Functor.map_comp, CommRingCat.hom_comp, RingHom.comp_apply, hf, map_zero]
      · have hgk : (F.map g).hom (y k₀.castSucc) = 0 := hg k₀
        simp only [Functor.map_comp, CommRingCat.hom_comp, RingHom.comp_apply, hgk, map_zero]

  unfold wcIndEtale
  letI : Algebra P B := β.toAlgebra
  intro Q _ _ _ h

  obtain ⟨n, fQ, hfQ, hfg⟩ := Algebra.FinitePresentation.out (R := P) (A := Q)
  obtain ⟨r, K, hK⟩ := Submodule.fg_iff_exists_fin_generating_family.mp hfg
  have hK' : Ideal.span (Set.range K) = RingHom.ker fQ.toRingHom := hK

  set b : Fin n → B := fun t => h (fQ (MvPolynomial.X t)) with hb
  have hcomp : ∀ x, h (fQ x) = MvPolynomial.eval₂ β b x := by
    intro x
    have e : h.comp fQ = MvPolynomial.aeval b :=
      MvPolynomial.algHom_ext (fun t => by rw [MvPolynomial.aeval_X, AlgHom.comp_apply])
    rw [← AlgHom.comp_apply, e, MvPolynomial.aeval_def]
    rfl
  have hK0 : ∀ k, MvPolynomial.eval₂ β b (K k) = 0 := by
    intro k
    rw [← hcomp]
    have hmem : K k ∈ RingHom.ker fQ.toRingHom := hK' ▸ Ideal.subset_span ⟨k, rfl⟩
    rw [RingHom.mem_ker] at hmem
    have hz : fQ (K k) = 0 := hmem
    rw [hz, map_zero]

  obtain ⟨i, s, hs⟩ := lift n b
  have hy : ∀ k, ι i (MvPolynomial.eval₂ (p i) s (K k)) = 0 := by
    intro k
    rw [MvPolynomial.hom_eval₂, hβ i]
    have e : (fun t => ι i (s t)) = b := funext hs
    rw [e, hK0]

  obtain ⟨j, g, hg⟩ := kill i r (fun k => MvPolynomial.eval₂ (p i) s (K k))
    (fun k => hker i _ (hy k))
  have hs'K : ∀ k, MvPolynomial.eval₂ (p j) (fun t => (F.map g).hom (s t)) (K k) = 0 := by
    intro k
    have e : (F.map g).hom (MvPolynomial.eval₂ (p i) s (K k)) = 0 := hg k
    rw [MvPolynomial.hom_eval₂, hp g] at e
    exact e

  letI : Algebra P (F.obj j) := (p j).toAlgebra
  haveI hEj : Algebra.Etale P (F.obj j) := hEt j
  let G : MvPolynomial (Fin n) P →ₐ[P] F.obj j := MvPolynomial.aeval (fun t => (F.map g).hom (s t))
  have hle : RingHom.ker fQ.toRingHom ≤ RingHom.ker G.toRingHom := by
    rw [← hK', Ideal.span_le]
    rintro _ ⟨k, rfl⟩
    rw [SetLike.mem_coe, RingHom.mem_ker]
    exact hs'K k
  let γ : F.obj j →ₐ[P] B :=
    { ι j with commutes' := fun c => RingHom.congr_fun (hβ j) c }
  refine ⟨F.obj j, inferInstance, inferInstance, hEj, fQ.liftOfSurjective hfQ G hle, γ, ?_⟩

  apply AlgHom.ext
  intro q
  obtain ⟨x, rfl⟩ := hfQ q
  rw [AlgHom.comp_apply, AlgHom.liftOfSurjective_apply, hcomp]
  show ι j (MvPolynomial.eval₂ (p j) (fun t => (F.map g).hom (s t)) x) = _
  rw [MvPolynomial.hom_eval₂, hβ j]
  congr 1
  funext t
  exact (RingHom.congr_fun (hι g) (s t)).trans (hs t)

theorem wc_cmt_tensor_indEtale : ∀ (A : Type u) [CommRing A] (B : Type u) [CommRing B] (d : ℕ) (β : MvPolynomial (Option (Fin d)) A →+* B) (Ω : Type u) [CommRing Ω] [Algebra A B] [Algebra A Ω], β.comp MvPolynomial.C = algebraMap A B → wcIndEtale β → wcIndEtale (MvPolynomial.eval₂Hom (Algebra.TensorProduct.includeRight : Ω →ₐ[A] TensorProduct A B Ω).toRingHom (fun i => TensorProduct.tmul A (β (MvPolynomial.X i)) (1 : Ω))) :=
by
  intro A _ B _ d β Ω _ _ _ hβC hβ
  classical

  have L1 : ∀ {S T : Type u} [CommRing S] [CommRing T] (e : S ≃+* T), wcIndEtale (e : S →+* T) := by
    intro S T _ _ e
    unfold wcIndEtale
    letI : Algebra S T := (e : S →+* T).toAlgebra
    intro P _ _ _ h
    refine ⟨T, inferInstance, inferInstance, ?_, h, AlgHom.id S T, AlgHom.id_comp h⟩
    exact Algebra.Etale.of_equiv (R := S) (A := S) (B := T)
      (AlgEquiv.ofRingEquiv (f := e) (fun x => rfl))
  set θ := MvPolynomial.eval₂Hom (Algebra.TensorProduct.includeRight : Ω →ₐ[A] TensorProduct A B Ω).toRingHom
    (fun i => TensorProduct.tmul A (β (MvPolynomial.X i)) (1 : Ω)) with hθ
  have hθC : ∀ ω : Ω, θ (MvPolynomial.C ω) = TensorProduct.tmul A (1 : B) ω := fun ω =>
    MvPolynomial.eval₂Hom_C _ _ ω
  have hθX : ∀ i, θ (MvPolynomial.X i) = TensorProduct.tmul A (β (MvPolynomial.X i)) (1 : Ω) :=
    fun i => MvPolynomial.eval₂Hom_X' _ _ i
  letI iB : Algebra (MvPolynomial (Option (Fin d)) A) B := β.toAlgebra
  letI iQ : Algebra (MvPolynomial (Option (Fin d)) A) (MvPolynomial (Option (Fin d)) Ω) :=
    (MvPolynomial.map (algebraMap A Ω)).toAlgebra
  have h1 : wcIndEtale (Algebra.TensorProduct.includeLeftRingHom :
      MvPolynomial (Option (Fin d)) Ω →+*
        TensorProduct (MvPolynomial (Option (Fin d)) A) (MvPolynomial (Option (Fin d)) Ω) B) :=
    wc_indEtale_baseChange _ B _ hβ

  have hcompat : (Algebra.TensorProduct.includeLeftRingHom : B →+* TensorProduct A B Ω).comp β =
      θ.comp (MvPolynomial.map (algebraMap A Ω)) := by
    apply MvPolynomial.ringHom_ext
    · intro a
      have hCa : β (MvPolynomial.C a) = algebraMap A B a := RingHom.congr_fun hβC a
      rw [RingHom.comp_apply, RingHom.comp_apply, MvPolynomial.map_C, hθC,
        Algebra.TensorProduct.includeLeftRingHom_apply, hCa]
      exact Algebra.TensorProduct.tmul_one_eq_one_tmul a
    · intro i
      rw [RingHom.comp_apply, RingHom.comp_apply, MvPolynomial.map_X, hθX,
        Algebra.TensorProduct.includeLeftRingHom_apply]

  letI iD : Algebra (MvPolynomial (Option (Fin d)) A) (TensorProduct A B Ω) :=
    (θ.comp (MvPolynomial.map (algebraMap A Ω))).toAlgebra
  let f : MvPolynomial (Option (Fin d)) Ω →ₐ[MvPolynomial (Option (Fin d)) A] TensorProduct A B Ω :=
    { θ with commutes' := fun r => rfl }
  let g : B →ₐ[MvPolynomial (Option (Fin d)) A] TensorProduct A B Ω :=
    { (Algebra.TensorProduct.includeLeftRingHom : B →+* TensorProduct A B Ω) with
      commutes' := fun r => RingHom.congr_fun hcompat r }
  haveI tD : @IsScalarTower (MvPolynomial (Option (Fin d)) A) (MvPolynomial (Option (Fin d)) A)
      (TensorProduct A B Ω) (Algebra.id _).toSMul iD.toSMul iD.toSMul :=
    @IsScalarTower.of_algebraMap_eq _ _ _ _ _ _ (Algebra.id _) iD iD (fun _ => rfl)
  let e₀ := (Algebra.TensorProduct.lift f g (fun _ _ => Commute.all _ _)).toRingHom
  have he₀ : ∀ (q : MvPolynomial (Option (Fin d)) Ω) (b : B),
      e₀ (TensorProduct.tmul (MvPolynomial (Option (Fin d)) A) q b) =
        θ q * TensorProduct.tmul A b (1 : Ω) := fun q b =>
    Algebra.TensorProduct.lift_tmul f g _ q b

  letI iA : Algebra A
      (TensorProduct (MvPolynomial (Option (Fin d)) A) (MvPolynomial (Option (Fin d)) Ω) B) :=
    ((Algebra.TensorProduct.includeLeftRingHom : MvPolynomial (Option (Fin d)) Ω →+*
        TensorProduct (MvPolynomial (Option (Fin d)) A) (MvPolynomial (Option (Fin d)) Ω) B).comp
      (MvPolynomial.C.comp (algebraMap A Ω))).toAlgebra
  let f' : B →ₐ[A]
      TensorProduct (MvPolynomial (Option (Fin d)) A) (MvPolynomial (Option (Fin d)) Ω) B :=
    { (Algebra.TensorProduct.includeRight : B →ₐ[MvPolynomial (Option (Fin d)) A]
        TensorProduct (MvPolynomial (Option (Fin d)) A) (MvPolynomial (Option (Fin d)) Ω) B).toRingHom with
      commutes' := fun a => by
        show TensorProduct.tmul (MvPolynomial (Option (Fin d)) A)
            (1 : MvPolynomial (Option (Fin d)) Ω) (algebraMap A B a) =
          TensorProduct.tmul (MvPolynomial (Option (Fin d)) A)
            (MvPolynomial.C (algebraMap A Ω a) : MvPolynomial (Option (Fin d)) Ω) (1 : B)
        have e1 : algebraMap A B a =
            algebraMap (MvPolynomial (Option (Fin d)) A) B (MvPolynomial.C a) :=
          (RingHom.congr_fun hβC a).symm
        have e2 : (MvPolynomial.C (algebraMap A Ω a) : MvPolynomial (Option (Fin d)) Ω) =
            algebraMap (MvPolynomial (Option (Fin d)) A) (MvPolynomial (Option (Fin d)) Ω)
              (MvPolynomial.C a) :=
          (MvPolynomial.map_C _ _).symm
        rw [e1, e2]
        exact (Algebra.TensorProduct.tmul_one_eq_one_tmul _).symm }
  let g' : Ω →ₐ[A]
      TensorProduct (MvPolynomial (Option (Fin d)) A) (MvPolynomial (Option (Fin d)) Ω) B :=
    { (Algebra.TensorProduct.includeLeftRingHom : MvPolynomial (Option (Fin d)) Ω →+*
        TensorProduct (MvPolynomial (Option (Fin d)) A) (MvPolynomial (Option (Fin d)) Ω) B).comp
        MvPolynomial.C with
      commutes' := fun a => rfl }
  haveI tQ : @IsScalarTower A A
      (TensorProduct (MvPolynomial (Option (Fin d)) A) (MvPolynomial (Option (Fin d)) Ω) B)
      (Algebra.id _).toSMul iA.toSMul iA.toSMul :=
    @IsScalarTower.of_algebraMap_eq _ _ _ _ _ _ (Algebra.id _) iA iA (fun _ => rfl)
  let e₁ := (Algebra.TensorProduct.lift f' g' (fun _ _ => Commute.all _ _)).toRingHom
  have he₁ : ∀ (b : B) (ω : Ω), e₁ (TensorProduct.tmul A b ω) =
      TensorProduct.tmul (MvPolynomial (Option (Fin d)) A)
        (MvPolynomial.C ω : MvPolynomial (Option (Fin d)) Ω) b := by
    intro b ω
    have h := Algebra.TensorProduct.lift_tmul f' g' (fun _ _ => Commute.all _ _) b ω
    refine h.trans ?_
    show TensorProduct.tmul (MvPolynomial (Option (Fin d)) A)
        (1 : MvPolynomial (Option (Fin d)) Ω) b *
      TensorProduct.tmul (MvPolynomial (Option (Fin d)) A)
        (MvPolynomial.C ω : MvPolynomial (Option (Fin d)) Ω) (1 : B) = _
    rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul, mul_one]
  have hinv1 : e₀.comp e₁ = RingHom.id _ := by
    apply Algebra.TensorProduct.ringHom_ext
    · refine RingHom.ext fun b => ?_
      show e₀ (e₁ (TensorProduct.tmul A b (1 : Ω))) = TensorProduct.tmul A b (1 : Ω)
      rw [he₁, he₀, MvPolynomial.C_1, map_one, one_mul]
    · refine RingHom.ext fun ω => ?_
      show e₀ (e₁ (TensorProduct.tmul A (1 : B) ω)) = TensorProduct.tmul A (1 : B) ω
      rw [he₁, he₀, hθC, Algebra.TensorProduct.tmul_mul_tmul, one_mul, mul_one]
  have hinv2 : e₁.comp e₀ = RingHom.id _ := by
    apply Algebra.TensorProduct.ringHom_ext
    · apply MvPolynomial.ringHom_ext
      · intro ω
        show e₁ (e₀ (TensorProduct.tmul (MvPolynomial (Option (Fin d)) A)
            (MvPolynomial.C ω : MvPolynomial (Option (Fin d)) Ω) (1 : B))) =
          TensorProduct.tmul (MvPolynomial (Option (Fin d)) A)
            (MvPolynomial.C ω : MvPolynomial (Option (Fin d)) Ω) (1 : B)
        rw [he₀, hθC, Algebra.TensorProduct.tmul_mul_tmul, one_mul, mul_one, he₁]
      · intro i
        show e₁ (e₀ (TensorProduct.tmul (MvPolynomial (Option (Fin d)) A)
            (MvPolynomial.X i : MvPolynomial (Option (Fin d)) Ω) (1 : B))) =
          TensorProduct.tmul (MvPolynomial (Option (Fin d)) A)
            (MvPolynomial.X i : MvPolynomial (Option (Fin d)) Ω) (1 : B)
        rw [he₀, hθX, Algebra.TensorProduct.tmul_mul_tmul, mul_one, mul_one, he₁, MvPolynomial.C_1]
        have e1 : (MvPolynomial.X i : MvPolynomial (Option (Fin d)) Ω) =
            algebraMap (MvPolynomial (Option (Fin d)) A) (MvPolynomial (Option (Fin d)) Ω)
              (MvPolynomial.X i) :=
          (MvPolynomial.map_X _ _).symm
        rw [e1]
        exact (Algebra.TensorProduct.tmul_one_eq_one_tmul (MvPolynomial.X i)).symm
    · refine RingHom.ext fun b => ?_
      show e₁ (e₀ (TensorProduct.tmul (MvPolynomial (Option (Fin d)) A)
          (1 : MvPolynomial (Option (Fin d)) Ω) b)) =
        TensorProduct.tmul (MvPolynomial (Option (Fin d)) A)
          (1 : MvPolynomial (Option (Fin d)) Ω) b
      rw [he₀, map_one, one_mul, he₁, MvPolynomial.C_1]
  let e := RingEquiv.ofRingHom e₀ e₁ hinv1 hinv2
  have heq : (e : TensorProduct (MvPolynomial (Option (Fin d)) A) (MvPolynomial (Option (Fin d)) Ω) B
      →+* TensorProduct A B Ω).comp (Algebra.TensorProduct.includeLeftRingHom :
      MvPolynomial (Option (Fin d)) Ω →+*
        TensorProduct (MvPolynomial (Option (Fin d)) A) (MvPolynomial (Option (Fin d)) Ω) B) = θ := by
    refine RingHom.ext fun q => ?_
    show e₀ (TensorProduct.tmul (MvPolynomial (Option (Fin d)) A) q (1 : B)) = θ q
    rw [he₀, ← Algebra.TensorProduct.one_def, mul_one]
  rw [← heq]
  exact wc_indEtale_comp _ _ h1 (L1 e)

theorem wc_cmt_etale_mvpoly_field_local_ufd : ∀ (k : Type u) [Field k] (σ : Type) [Finite σ] (E : Type u) [CommRing E] [Algebra (MvPolynomial σ k) E], Algebra.Etale (MvPolynomial σ k) E → ∀ (q : Ideal E) [q.IsPrime], IsNoetherianRing (Localization.AtPrime q) ∧ IsDomain (Localization.AtPrime q) ∧ UniqueFactorizationMonoid (Localization.AtPrime q) :=
by
  intro k _ σ _ E _ _ hE q _
  haveI := hE
  classical
  have hF : ∀ (K : Type u) [Field K], IsRegularLocalRing K := fun _ _ => inferInstance
  have s9 : ∀ (R S : Type u) [CommRing R] [CommRing S] (e : R ≃+* S) (Q : Ideal R) [Q.IsPrime]
      (Q' : Ideal S) [Q'.IsPrime], Q' = Q.map e →
      Nonempty (Localization.AtPrime Q ≃+* Localization.AtPrime Q') := by
    intro R S _ _ e Q _ Q' _ hQ
    refine ⟨IsLocalization.ringEquivOfRingEquiv (M := Q.primeCompl) (T := Q'.primeCompl)
      (Localization.AtPrime Q) (Localization.AtPrime Q') e ?_⟩
    subst hQ
    ext s
    rw [Submonoid.mem_map]
    constructor
    · rintro ⟨t, ht, hts⟩
      refine Ideal.mem_primeCompl_iff.mpr (fun hmem => ?_)
      rw [Ideal.mem_map_of_equiv] at hmem
      obtain ⟨t', ht', h⟩ := hmem
      have htt : t' = t := e.injective (h.trans hts.symm)
      exact (Ideal.mem_primeCompl_iff.mp ht) (htt ▸ ht')
    · intro hs
      refine ⟨e.symm s, Ideal.mem_primeCompl_iff.mpr (fun h => ?_), ?_⟩
      · apply Ideal.mem_primeCompl_iff.mp hs
        rw [Ideal.mem_map_of_equiv]
        exact ⟨e.symm s, h, by simp⟩
      · show e (e.symm s) = s
        simp
  have r3 : (∀ (C₀ : Type u) [CommRing C₀] [IsLocalRing C₀] [IsNoetherianRing C₀],
      IsRegularLocalRing C₀ → ∀ (𝔮 : Ideal (Polynomial C₀)) [𝔮.IsPrime],
      𝔮.comap Polynomial.C = IsLocalRing.maximalIdeal C₀ →
      IsRegularLocalRing (Localization.AtPrime 𝔮)) →
      ∀ (C : Type u) [CommRing C] [IsNoetherianRing C] (p : Ideal C) [p.IsPrime],
      IsRegularLocalRing (Localization.AtPrime p) → ∀ (Q : Ideal (Polynomial C)) [Q.IsPrime],
      Q.comap Polynomial.C = p → IsRegularLocalRing (Localization.AtPrime Q) := by
    intro H C _ _ p _ hreg Q _ hQ
    letI : Algebra (Polynomial C) (Polynomial (Localization.AtPrime p)) :=
      (Polynomial.mapRingHom (algebraMap C (Localization.AtPrime p))).toAlgebra
    haveI hML : IsLocalization (Submonoid.map Polynomial.C p.primeCompl)
        (Polynomial (Localization.AtPrime p)) :=
      Polynomial.isLocalization p.primeCompl (Localization.AtPrime p)
    have hdisj : Disjoint ((Submonoid.map Polynomial.C p.primeCompl : Submonoid (Polynomial C)) :
        Set (Polynomial C)) (Q : Set (Polynomial C)) := by
      refine Set.disjoint_left.mpr ?_
      rintro _ ⟨s, hs, rfl⟩ hsQ
      apply hs
      rw [← hQ]
      exact hsQ
    haveI h𝔮 : (Q.map (algebraMap (Polynomial C) (Polynomial (Localization.AtPrime p)))).IsPrime :=
      IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.map Polynomial.C p.primeCompl) _ Q ‹_›
        hdisj
    have h𝔮Q : (Q.map (algebraMap (Polynomial C) (Polynomial (Localization.AtPrime p)))).comap
        (algebraMap (Polynomial C) (Polynomial (Localization.AtPrime p))) = Q :=
      IsLocalization.under_map_of_isPrime_disjoint (Submonoid.map Polynomial.C p.primeCompl) _ ‹_›
        hdisj
    haveI : IsNoetherianRing (Localization.AtPrime p) :=
      IsLocalization.isNoetherianRing p.primeCompl _ ‹_›
    have hc : (Q.map (algebraMap (Polynomial C) (Polynomial (Localization.AtPrime p)))).comap
        Polynomial.C = IsLocalRing.maximalIdeal (Localization.AtPrime p) := by
      apply le_antisymm
      · exact IsLocalRing.le_maximalIdeal (Ideal.comap_isPrime Polynomial.C _).ne_top
      · rw [← Localization.AtPrime.map_eq_maximalIdeal, Ideal.map_le_iff_le_comap]
        intro c hc
        rw [Ideal.mem_comap, Ideal.mem_comap]
        have : Polynomial.C (algebraMap C (Localization.AtPrime p) c) =
            algebraMap (Polynomial C) (Polynomial (Localization.AtPrime p)) (Polynomial.C c) := by
          show _ = Polynomial.map (algebraMap C (Localization.AtPrime p)) (Polynomial.C c)
          rw [Polynomial.map_C]
        rw [this]
        apply Ideal.mem_map_of_mem
        rw [← hQ] at hc
        exact hc
    haveI hR𝔮 := H (Localization.AtPrime p) hreg _ hc
    have hgen : ∀ (P : Ideal (Polynomial C)) [P.IsPrime],
        P = (Q.map (algebraMap (Polynomial C) (Polynomial (Localization.AtPrime p)))).comap
          (algebraMap (Polynomial C) (Polynomial (Localization.AtPrime p))) →
        IsLocalization.AtPrime (Localization.AtPrime
          (Q.map (algebraMap (Polynomial C) (Polynomial (Localization.AtPrime p))))) P := by
      intro P _ hP
      subst hP
      exact IsLocalization.isLocalization_isLocalization_atPrime_isLocalization
        (Submonoid.map Polynomial.C p.primeCompl) _ _
    haveI := hgen Q h𝔮Q.symm
    let E' : Localization.AtPrime
        (Q.map (algebraMap (Polynomial C) (Polynomial (Localization.AtPrime p))))
        ≃+* Localization.AtPrime Q := (IsLocalization.algEquiv Q.primeCompl
      (Localization.AtPrime (Q.map (algebraMap (Polynomial C) (Polynomial (Localization.AtPrime p)))))
      (Localization.AtPrime Q)).toRingEquiv
    exact @IsRegularLocalRing.of_ringEquiv _ _ hR𝔮 _ _ E'
  have s4 : (∀ (C : Type u) [CommRing C] [IsNoetherianRing C] (p : Ideal C) [p.IsPrime],
      IsRegularLocalRing (Localization.AtPrime p) → ∀ (Q : Ideal (Polynomial C)) [Q.IsPrime],
      Q.comap Polynomial.C = p → IsRegularLocalRing (Localization.AtPrime Q)) →
      ∀ (n : ℕ) (C : Type u) [CommRing C] [IsNoetherianRing C] (p : Ideal C) [p.IsPrime],
      IsRegularLocalRing (Localization.AtPrime p) →
      ∀ (Q : Ideal (MvPolynomial (Fin n) C)) [Q.IsPrime],
      Q.comap (MvPolynomial.C : C →+* MvPolynomial (Fin n) C) = p →
      IsRegularLocalRing (Localization.AtPrime Q) := by
    intro H1 n
    induction n with
    | zero =>
      intro C _ _ p _ hreg Q _ hQ
      have hsymm : ∀ c : C, (MvPolynomial.isEmptyAlgEquiv C (Fin 0)).toRingEquiv.symm c =
          MvPolynomial.C c := by
        intro c
        have h := (MvPolynomial.isEmptyAlgEquiv C (Fin 0)).symm.commutes c
        rw [Algebra.algebraMap_self, RingHom.id_apply, MvPolynomial.algebraMap_eq] at h
        exact h
      have hmap : Q.map (MvPolynomial.isEmptyAlgEquiv C (Fin 0)).toRingEquiv = p := by
        rw [← hQ]
        ext c
        rw [Ideal.mem_map_of_equiv, Ideal.mem_comap]
        constructor
        · rintro ⟨z, hz, rfl⟩
          rw [← hsymm, RingEquiv.symm_apply_apply]
          exact hz
        · intro hc
          exact ⟨MvPolynomial.C c, hc, by rw [← hsymm, RingEquiv.apply_symm_apply]⟩
      obtain ⟨Φ⟩ := s9 _ _ (MvPolynomial.isEmptyAlgEquiv C (Fin 0)).toRingEquiv Q p hmap.symm
      haveI := hreg
      exact IsRegularLocalRing.of_ringEquiv Φ.symm
    | succ n ih =>
      intro C _ _ p _ hreg Q _ hQ
      haveI hQ' : (Q.map (MvPolynomial.finSuccEquiv C n).toRingEquiv).IsPrime :=
        Ideal.map_isPrime_of_equiv _
      haveI : ((Q.map (MvPolynomial.finSuccEquiv C n).toRingEquiv).comap Polynomial.C).IsPrime :=
        Ideal.comap_isPrime _ _
      have hEC : ∀ c : C, (MvPolynomial.finSuccEquiv C n).toRingEquiv (MvPolynomial.C c) =
          Polynomial.C (MvPolynomial.C c) := by
        intro c
        show MvPolynomial.finSuccEquiv C n (MvPolynomial.C c) = _
        rw [MvPolynomial.finSuccEquiv_apply, MvPolynomial.eval₂Hom_C]
        rfl
      have hmemE : ∀ z, (MvPolynomial.finSuccEquiv C n).toRingEquiv z ∈
          Q.map (MvPolynomial.finSuccEquiv C n).toRingEquiv ↔ z ∈ Q := by
        intro z
        rw [Ideal.mem_map_of_equiv]
        constructor
        · rintro ⟨w, hw, h⟩
          rw [(MvPolynomial.finSuccEquiv C n).toRingEquiv.injective h] at hw
          exact hw
        · intro hz
          exact ⟨z, hz, rfl⟩
      have hQ₀ : ((Q.map (MvPolynomial.finSuccEquiv C n).toRingEquiv).comap Polynomial.C).comap
          (MvPolynomial.C : C →+* MvPolynomial (Fin n) C) = p := by
        rw [← hQ]
        ext c
        rw [Ideal.mem_comap, Ideal.mem_comap, Ideal.mem_comap, ← hEC, hmemE]
      have h0 := ih C p hreg _ hQ₀
      haveI := H1 (MvPolynomial (Fin n) C) _ h0
        (Q.map (MvPolynomial.finSuccEquiv C n).toRingEquiv) rfl
      obtain ⟨Φ⟩ := s9 _ _ (MvPolynomial.finSuccEquiv C n).toRingEquiv Q
        (Q.map (MvPolynomial.finSuccEquiv C n).toRingEquiv) rfl
      exact IsRegularLocalRing.of_ringEquiv Φ.symm
  have s5 : ∀ (P : Type u) [CommRing P] [IsNoetherianRing P] (T : Type u) [CommRing T] [Algebra P T]
      [Algebra.Etale P T] (q : Ideal T) [q.IsPrime],
      IsRegularLocalRing (Localization.AtPrime (q.comap (algebraMap P T))) →
      IsRegularLocalRing (Localization.AtPrime q) := by
    intro P _ _ T _ _ _ q _ hreg
    haveI : IsNoetherianRing T := Algebra.FiniteType.isNoetherianRing P T
    haveI : IsNoetherianRing (Localization.AtPrime (q.comap (algebraMap P T))) :=
      IsLocalization.isNoetherianRing (q.comap (algebraMap P T)).primeCompl _ ‹_›
    haveI : IsNoetherianRing (Localization.AtPrime q) :=
      IsLocalization.isNoetherianRing q.primeCompl _ ‹_›
    letI : Algebra (Localization.AtPrime (q.comap (algebraMap P T))) (Localization.AtPrime q) :=
      (Localization.localRingHom (q.comap (algebraMap P T)) q (algebraMap P T) rfl).toAlgebra
    haveI : IsLocalHom (algebraMap (Localization.AtPrime (q.comap (algebraMap P T)))
        (Localization.AtPrime q)) :=
      Localization.isLocalHom_localRingHom (q.comap (algebraMap P T)) q _ rfl
    haveI : Module.Flat (Localization.AtPrime (q.comap (algebraMap P T)))
        (Localization.AtPrime q) := by
      rw [← RingHom.flat_algebraMap_iff]
      exact RingHom.Flat.localRingHom (RingHom.flat_algebraMap_iff.mpr inferInstance) q _ rfl
    haveI : IsScalarTower P (Localization.AtPrime (q.comap (algebraMap P T)))
        (Localization.AtPrime q) := IsScalarTower.of_algebraMap_eq (fun x => by
      rw [RingHom.algebraMap_toAlgebra, Localization.localRingHom_to_map,
        IsScalarTower.algebraMap_apply P T (Localization.AtPrime q)])
    haveI : Algebra.FormallyUnramified P (Localization.AtPrime q) :=
      Algebra.FormallyUnramified.comp P T _
    haveI : Algebra.FormallyUnramified (Localization.AtPrime (q.comap (algebraMap P T)))
        (Localization.AtPrime q) := Algebra.FormallyUnramified.of_restrictScalars P _ _
    haveI : Algebra.EssFiniteType P (Localization.AtPrime q) := Algebra.EssFiniteType.comp P T _
    haveI : Algebra.EssFiniteType (Localization.AtPrime (q.comap (algebraMap P T)))
        (Localization.AtPrime q) := Algebra.EssFiniteType.of_comp P _ _
    have hm : Ideal.map (algebraMap (Localization.AtPrime (q.comap (algebraMap P T)))
        (Localization.AtPrime q))
        (IsLocalRing.maximalIdeal (Localization.AtPrime (q.comap (algebraMap P T))))
        = IsLocalRing.maximalIdeal (Localization.AtPrime q) :=
      Algebra.FormallyUnramified.map_maximalIdeal
    have hres : IsRegularLocalRing (IsLocalRing.ResidueField (Localization.AtPrime q)) :=
      @hF _ (IsLocalRing.ResidueField.field _)
    let E' : IsLocalRing.ResidueField (Localization.AtPrime q) ≃+* (Localization.AtPrime q ⧸
        Ideal.map (algebraMap (Localization.AtPrime (q.comap (algebraMap P T)))
          (Localization.AtPrime q))
        (IsLocalRing.maximalIdeal (Localization.AtPrime (q.comap (algebraMap P T))))) :=
      Ideal.quotEquivOfEq hm.symm
    have hfib : IsRegularLocalRing (Localization.AtPrime q ⧸ Ideal.map
        (algebraMap (Localization.AtPrime (q.comap (algebraMap P T))) (Localization.AtPrime q))
        (IsLocalRing.maximalIdeal (Localization.AtPrime (q.comap (algebraMap P T))))) :=
      IsRegularLocalRing.of_ringEquiv E'
    exact wc_hnas_pfc_regular_flat_ascent _ _ hreg hfib
  have H1 := r3 (wc_pfc_pc_poly_localization_regular wc_hnas_pfc_regular_flat_ascent)
  have Hmv := s4 H1
  have hk : ∀ (n : ℕ) (Q : Ideal (MvPolynomial (Fin n) k)) [Q.IsPrime],
      IsRegularLocalRing (Localization.AtPrime Q) := by
    intro n Q _
    haveI hbot : (⊥ : Ideal k).IsPrime := Ideal.bot_isMaximal.isPrime
    have hQc : Q.comap (MvPolynomial.C : k →+* MvPolynomial (Fin n) k) = ⊥ := by
      rcases Ideal.eq_bot_or_top (Q.comap (MvPolynomial.C : k →+* MvPolynomial (Fin n) k)) with h | h
      · exact h
      · exact absurd h (Ideal.comap_isPrime _ Q).ne_top
    have hreg : IsRegularLocalRing (Localization.AtPrime (⊥ : Ideal k)) := by
      have hu : (⊥ : Ideal k).primeCompl ≤ IsUnit.submonoid k := by
        intro a ha
        exact (isUnit_iff_ne_zero.mpr (fun h => ha (by rw [h]; exact Ideal.zero_mem _)))
      haveI := hF k
      exact IsRegularLocalRing.of_ringEquiv
        (IsLocalization.atUnits k (⊥ : Ideal k).primeCompl hu (S := Localization.AtPrime (⊥ : Ideal k))).toRingEquiv
    exact Hmv n k ⊥ hreg Q hQc

  have hσ : ∀ (Q : Ideal (MvPolynomial σ k)) [Q.IsPrime],
      IsRegularLocalRing (Localization.AtPrime Q) := by
    intro Q _
    obtain ⟨n, ⟨eσ⟩⟩ := Finite.exists_equiv_fin σ
    haveI hQ' : (Q.map (MvPolynomial.renameEquiv k eσ).toRingEquiv).IsPrime :=
      Ideal.map_isPrime_of_equiv _
    obtain ⟨Φ⟩ := s9 _ _ (MvPolynomial.renameEquiv k eσ).toRingEquiv Q
      (Q.map (MvPolynomial.renameEquiv k eσ).toRingEquiv) rfl
    haveI := hk n (Q.map (MvPolynomial.renameEquiv k eσ).toRingEquiv)
    exact IsRegularLocalRing.of_ringEquiv Φ.symm
  haveI : IsNoetherianRing E := Algebra.FiniteType.isNoetherianRing (MvPolynomial σ k) E
  have hN : IsNoetherianRing (Localization.AtPrime q) :=
    IsLocalization.isNoetherianRing q.primeCompl _ ‹_›
  haveI : (q.comap (algebraMap (MvPolynomial σ k) E)).IsPrime := Ideal.comap_isPrime _ _
  haveI hR : IsRegularLocalRing (Localization.AtPrime q) :=
    s5 (MvPolynomial σ k) E q (hσ _)
  have h3 := wc_fco_regular_local_ufd (Localization.AtPrime q)
  exact ⟨hN, h3.1, h3.2⟩

theorem wc_cmt_indEtale_local_lcm_finite_order : ∀ (S R : Type u) [CommRing S] [CommRing R] [IsLocalRing R] (σ : S →+* R), wcIndEtale σ → (∀ (E : Type u) [CommRing E] [Algebra S E], Algebra.Etale S E → ∀ (q : Ideal E) [q.IsPrime], IsNoetherianRing (Localization.AtPrime q) ∧ IsDomain (Localization.AtPrime q) ∧ UniqueFactorizationMonoid (Localization.AtPrime q)) → IsDomain R ∧ (∀ a b : R, ∃ l : R, ∀ z : R, (a ∣ z ∧ b ∣ z ↔ l ∣ z)) ∧ ∀ y w : R, w ∈ IsLocalRing.maximalIdeal R → y ≠ 0 → ∃ n : ℕ, ¬ w ^ n ∣ y :=
by
  intro S R _ _ _ σ hσ H0
  classical
  have H : ∀ (E : Type u) [CommRing E] [Algebra S E], Algebra.Etale S E → ∀ (q : Ideal E) [q.IsPrime],
      IsDomain (Localization.AtPrime q) ∧ UniqueFactorizationMonoid (Localization.AtPrime q) :=
    fun E _ _ hE q _ => (H0 E hE q).2
  letI : Algebra S R := σ.toAlgebra
  have hWE : Algebra.WeaklyEtale S R := wc_indEtale_weaklyEtale σ hσ

  have F : ∀ a b : R, ∃ (E : Type u) (_ : CommRing E) (_ : Algebra S E) (_ : Algebra.Etale S E)
      (β : E →ₐ[S] R) (e₀ e₁ : E), β e₀ = a ∧ β e₁ = b := by
    intro a b
    obtain ⟨E, _, _, hEt, α, β, hβα⟩ := hσ (MvPolynomial (Fin 2) S) (MvPolynomial.aeval ![a, b])
    refine ⟨E, _, _, hEt, β, α (MvPolynomial.X 0), α (MvPolynomial.X 1), ?_, ?_⟩
    · rw [← AlgHom.comp_apply, hβα]; simp
    · rw [← AlgHom.comp_apply, hβα]; simp

  have K : ∀ (E : Type u) [CommRing E] [Algebra S E] [Algebra.Etale S E] (β : E →ₐ[S] R),
      ∃ (L : Type u) (_ : CommRing L) (_ : IsDomain L) (_ : UniqueFactorizationMonoid L)
        (ι : E →+* L) (β' : L →+* R), (∀ e, β' (ι e) = β e) ∧
        (∀ e, IsUnit (β e) → IsUnit (ι e)) ∧
        ∀ (n : ℕ) (f : Fin n → E) (x : Fin n → R), ∑ i, β (f i) * x i = 0 →
          ∃ (k : ℕ) (A : Fin n → Fin k → E) (y : Fin k → R),
            (∀ i, x i = ∑ j, β (A i j) * y j) ∧ ∀ j, ∑ i, f i * A i j = 0 := by
    intro E _ _ _ β
    letI : Algebra E R := (β : E →+* R).toAlgebra
    haveI : IsScalarTower S E R := IsScalarTower.of_algebraMap_eq' β.comp_algebraMap.symm
    haveI hER : Algebra.WeaklyEtale E R := wc_weaklyEtale_cancel S E R inferInstance hWE
    haveI : Module.Flat E R := inferInstance
    let q : Ideal E := Ideal.comap (β : E →+* R) (IsLocalRing.maximalIdeal R)
    haveI : q.IsPrime := Ideal.comap_isPrime _ _
    obtain ⟨hLd, hLu⟩ := H E inferInstance q
    have hunit : ∀ s : q.primeCompl, IsUnit ((β : E →+* R) (s : E)) := by
      intro s
      exact IsLocalRing.notMem_maximalIdeal.mp
        (fun hm => (Ideal.mem_primeCompl_iff.mp s.2) (Ideal.mem_comap.mpr hm))
    refine ⟨Localization.AtPrime q, inferInstance, hLd, hLu, algebraMap E _,
      IsLocalization.lift (M := q.primeCompl) (S := Localization.AtPrime q) hunit,
      fun e => IsLocalization.lift_eq hunit e, ?_, ?_⟩
    · intro e he
      have hq : e ∈ q.primeCompl := by
        intro hm
        exact IsLocalRing.notMem_maximalIdeal.mpr he (Ideal.mem_comap.mp hm)
      exact IsLocalization.map_units (Localization.AtPrime q) (⟨e, hq⟩ : q.primeCompl)
    intro n f x hfx
    have h0 : ∑ i, f i • x i = 0 := hfx
    have h3 : Module.IsTrivialRelation f x :=
      @Module.Flat.isTrivialRelation_of_sum_smul_eq_zero E R _ _ _ inferInstance (Fin n) _ f x h0
    unfold Module.IsTrivialRelation at h3
    obtain ⟨k, A, y, h1, h2⟩ := h3
    exact ⟨k, A, y, fun i => (h1 i).trans (Finset.sum_congr rfl (fun j _ => Algebra.smul_def _ _)), h2⟩

  have hnzd : NoZeroDivisors R := by
    refine ⟨fun {a b} hab => ?_⟩
    obtain ⟨E, _, _, _, β, e₀, e₁, he₀, he₁⟩ := F a b
    obtain ⟨L, _, _, _, ι, β', hβ', -, hflat⟩ := K E β
    obtain ⟨k, A, y, h1, h2⟩ := hflat 1 ![e₀] ![b] (by simp [he₀, hab])
    by_cases h : ι e₀ = 0
    · left; rw [← he₀, ← hβ', h, map_zero]
    · right
      have hb := h1 0
      simp only [Matrix.cons_val_zero] at hb
      rw [hb]
      apply Finset.sum_eq_zero
      intro j _
      have hj := h2 j
      simp only [Finset.univ_unique, Fin.default_eq_zero, Finset.sum_singleton,
        Matrix.cons_val_zero] at hj
      have hj' : ι e₀ * ι (A 0 j) = 0 := by rw [← map_mul, hj, map_zero]
      have hA : ι (A 0 j) = 0 := (mul_eq_zero.mp hj').resolve_left h
      rw [← hβ', hA, map_zero, zero_mul]
  have hlcm : ∀ a b : R, ∃ l : R, ∀ z : R, (a ∣ z ∧ b ∣ z ↔ l ∣ z) := by
    intro a b
    obtain ⟨E, _, _, _, β, e₀, e₁, he₀, he₁⟩ := F a b
    obtain ⟨L, _, _, _, ι, β', hβ', -, hflat⟩ := K E β
    letI : GCDMonoid L := UniqueFactorizationMonoid.toGCDMonoid L
    refine ⟨β' (lcm (ι e₀) (ι e₁)), fun z => ⟨?_, ?_⟩⟩
    · rintro ⟨⟨r₁, hr₁⟩, ⟨r₂, hr₂⟩⟩
      obtain ⟨k, A, y, h1, h2⟩ := hflat 2 ![e₀, -e₁] ![r₁, r₂] (by
        simp only [Fin.sum_univ_two, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons,
          map_neg, he₀, he₁]
        rw [← hr₁, neg_mul, ← hr₂, add_neg_cancel])
      have hr := h1 0
      simp only [Matrix.cons_val_zero] at hr
      rw [hr₁, hr, Finset.mul_sum]
      apply Finset.dvd_sum
      intro j _
      have hj := h2 j
      simp only [Fin.sum_univ_two, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons,
        neg_mul] at hj
      have hj' : e₀ * A 0 j = e₁ * A 1 j := by rw [← sub_eq_zero, sub_eq_add_neg]; exact hj
      have hd : lcm (ι e₀) (ι e₁) ∣ ι (e₀ * A 0 j) := by
        rw [lcm_dvd_iff]
        constructor
        · rw [map_mul]; exact dvd_mul_right _ _
        · rw [hj', map_mul]; exact dvd_mul_right _ _
      have hd' := map_dvd β' hd
      rw [hβ', map_mul, he₀] at hd'
      rw [← mul_assoc]
      exact dvd_mul_of_dvd_left hd' _
    · intro h
      constructor
      · refine dvd_trans ?_ h
        rw [← he₀, ← hβ']
        exact map_dvd β' (dvd_lcm_left _ _)
      · refine dvd_trans ?_ h
        rw [← he₁, ← hβ']
        exact map_dvd β' (dvd_lcm_right _ _)
  have hfin : ∀ y w : R, w ∈ IsLocalRing.maximalIdeal R → y ≠ 0 → ∃ n : ℕ, ¬ w ^ n ∣ y := by
    intro y w hw hy
    by_contra hall
    push_neg at hall
    obtain ⟨E, _, _, _, β, e₀, e₁, he₀, he₁⟩ := F y w
    obtain ⟨L, _, _, _, ι, β', hβ', hloc, hflat⟩ := K E β
    have hnu : ¬ IsUnit (ι e₁) := by
      intro h
      have h' := h.map β'
      rw [hβ', he₁] at h'
      exact (IsLocalRing.mem_maximalIdeal w).mp hw h'
    have hne : ι e₀ ≠ 0 := by
      intro h
      apply hy
      rw [← he₀, ← hβ', h, map_zero]
    obtain ⟨n, hn⟩ := FiniteMultiplicity.of_not_isUnit hnu hne
    obtain ⟨r, hr⟩ := hall (n + 1)
    obtain ⟨k, A, y', h1, h2⟩ := hflat 2 ![e₁ ^ (n + 1), -e₀] ![r, 1] (by
      simp only [Fin.sum_univ_two, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons,
        map_neg, map_pow, he₀, he₁]
      rw [hr]; ring)
    have h11 := h1 1
    simp only [Matrix.cons_val_one, Matrix.head_cons] at h11
    have hj₀ : ∃ j, IsUnit (β (A 1 j)) := by
      by_contra hc
      push_neg at hc
      have hmem : (∑ j, β (A 1 j) * y' j) ∈ IsLocalRing.maximalIdeal R :=
        Ideal.sum_mem _ (fun j _ =>
          Ideal.mul_mem_right _ _ ((IsLocalRing.mem_maximalIdeal _).mpr (hc j)))
      rw [← h11] at hmem
      exact (IsLocalRing.mem_maximalIdeal 1).mp hmem isUnit_one
    obtain ⟨j₀, hj₀⟩ := hj₀
    have hu : IsUnit (ι (A 1 j₀)) := hloc _ hj₀
    have hj := h2 j₀
    simp only [Fin.sum_univ_two, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons,
      neg_mul] at hj
    have hj' : e₀ * A 1 j₀ = e₁ ^ (n + 1) * A 0 j₀ := by
      linear_combination -hj
    have hL : ι e₀ * ι (A 1 j₀) = (ι e₁) ^ (n + 1) * ι (A 0 j₀) := by
      rw [← map_mul, hj', map_mul, map_pow]
    have hd : (ι e₁) ^ (n + 1) ∣ ι e₀ * ι (A 1 j₀) := ⟨ι (A 0 j₀), hL⟩
    exact hn ((IsUnit.dvd_mul_right hu).mp hd)
  exact ⟨NoZeroDivisors.to_isDomain R, hlcm, hfin⟩

theorem wc_cmt_pic_away_prime_injective : ∀ (D : Type u) [CommRing D] [IsDomain D] (w : D), Prime w → Function.Injective (CommRing.Pic.mapAlgebra D (Localization.Away w)) :=
by

  have L2 : ∀ (D : Type u) [CommRing D] [IsDomain D] (w : D), Prime w →
      ∀ (j : ℕ) (a c : Ideal D), a * c = Ideal.span {w ^ j} → ∃ k : ℕ, a = Ideal.span {w ^ k} := by
    intro D _ _ w hw
    have hp : (Ideal.span {w}).IsPrime := (Ideal.span_singleton_prime hw.ne_zero).mpr hw
    have Q : ∀ b : Ideal D, b ≤ Ideal.span {w} →
        ∃ b₁ : Ideal D, b = Ideal.span {w} * b₁ := by
      intro b hb
      refine ⟨Submodule.comap (LinearMap.mulLeft D w) b, le_antisymm ?_ ?_⟩
      · intro y hy
        obtain ⟨x, rfl⟩ := Ideal.mem_span_singleton'.mp (hb hy)
        rw [Ideal.mem_span_singleton_mul]
        refine ⟨x, ?_, mul_comm w x⟩
        rw [Submodule.mem_comap, LinearMap.mulLeft_apply, mul_comm]
        exact hy
      · intro y hy
        obtain ⟨z, hz, rfl⟩ := Ideal.mem_span_singleton_mul.mp hy
        exact hz
    have hcancel : ∀ x y : Ideal D, Ideal.span {w} * x = Ideal.span {w} * y → x = y :=
      fun x y h => (Ideal.span_singleton_mul_right_inj hw.ne_zero).mp h
    intro j
    induction j with
    | zero =>
      intro a c h
      refine ⟨0, ?_⟩
      rw [pow_zero, Ideal.span_singleton_one] at h ⊢
      have h2 : a * c ≤ a := Ideal.mul_le_left
      rw [h] at h2
      exact top_le_iff.mp h2
    | succ j ih =>
      intro a c h
      have hsucc : Ideal.span {w ^ (j + 1)} = Ideal.span {w} * Ideal.span {w ^ j} := by
        rw [Ideal.span_singleton_mul_span_singleton, pow_succ']
      have hle : a * c ≤ Ideal.span {w} := by
        rw [h, Ideal.span_singleton_le_span_singleton]
        exact dvd_pow_self w (Nat.succ_ne_zero j)
      rcases (hp.mul_le).mp hle with ha | hc
      · obtain ⟨a₁, ha'⟩ := Q a ha
        have h1 : a₁ * c = Ideal.span {w ^ j} := by
          apply hcancel
          rw [← mul_assoc, ← ha', h, hsucc]
        obtain ⟨k, hk⟩ := ih a₁ c h1
        refine ⟨k + 1, ?_⟩
        rw [ha', hk, Ideal.span_singleton_mul_span_singleton, pow_succ']
      · obtain ⟨c₁, hc'⟩ := Q c hc
        have h1 : a * c₁ = Ideal.span {w ^ j} := by
          apply hcancel
          rw [mul_left_comm, ← hc', h, hsucc]
        exact ih a c₁ h1

  have L4 : ∀ (D E K : Type u) [CommRing D] [CommRing E] [CommRing K] [Algebra D E] [Algebra D K]
      [Algebra E K] [IsScalarTower D E K] (w : D) [IsLocalization.Away w E] (I : Submodule D K),
      I.FG → Submodule.span E (I : Set K) = 1 →
      (∃ N : ℕ, algebraMap D K (w ^ N) ∈ I) ∧
        ∃ n : ℕ, ∀ x ∈ I, algebraMap D K (w ^ n) * x ∈ (1 : Submodule D K) := by
    intro D E K _ _ _ _ _ _ _ w _ I hfg hI
    constructor
    · have key : ∀ y ∈ Submodule.span E (I : Set K), ∃ N : ℕ, algebraMap D K (w ^ N) * y ∈ I := by
        intro y hy
        induction hy using Submodule.span_induction with
        | mem x hx => exact ⟨0, by simpa using hx⟩
        | zero => exact ⟨0, by simp⟩
        | add x y _ _ hx hy =>
          obtain ⟨N₁, h₁⟩ := hx
          obtain ⟨N₂, h₂⟩ := hy
          refine ⟨N₁ + N₂, ?_⟩
          have e : algebraMap D K (w ^ (N₁ + N₂)) * (x + y) =
              w ^ N₂ • (algebraMap D K (w ^ N₁) * x) + w ^ N₁ • (algebraMap D K (w ^ N₂) * y) := by
            simp only [Algebra.smul_def, map_mul, map_pow, pow_add]; ring
          rw [e]
          exact I.add_mem (I.smul_mem _ h₁) (I.smul_mem _ h₂)
        | smul e x _ hx =>
          obtain ⟨N, hN⟩ := hx
          obtain ⟨n, a, hna⟩ := IsLocalization.Away.surj w e
          refine ⟨n + N, ?_⟩
          have e1 : algebraMap D K (w ^ (n + N)) * (e • x) = a • (algebraMap D K (w ^ N) * x) := by
            rw [Algebra.smul_def, Algebra.smul_def, IsScalarTower.algebraMap_apply D E K a, ← hna]
            simp only [map_mul, map_pow, pow_add, IsScalarTower.algebraMap_apply D E K w]
            ring
          rw [e1]
          exact I.smul_mem _ hN
      have h1 : (1 : K) ∈ Submodule.span E (I : Set K) := by
        rw [hI]; exact Submodule.mem_one.mpr ⟨1, map_one _⟩
      obtain ⟨N, hN⟩ := key 1 h1
      exact ⟨N, by simpa using hN⟩
    · have single : ∀ x ∈ I, ∃ n : ℕ, algebraMap D K (w ^ n) * x ∈ (1 : Submodule D K) := by
        intro x hx
        have hx1 : x ∈ (1 : Submodule E K) := by rw [← hI]; exact Submodule.subset_span hx
        obtain ⟨e, rfl⟩ := Submodule.mem_one.mp hx1
        obtain ⟨n, a, hna⟩ := IsLocalization.Away.surj w e
        refine ⟨n, Submodule.mem_one.mpr ⟨a, ?_⟩⟩
        rw [IsScalarTower.algebraMap_apply D E K a, ← hna]
        simp only [map_mul, map_pow, IsScalarTower.algebraMap_apply D E K w]
        ring
      have mono : ∀ (x : K) (n m : ℕ), n ≤ m →
          algebraMap D K (w ^ n) * x ∈ (1 : Submodule D K) →
          algebraMap D K (w ^ m) * x ∈ (1 : Submodule D K) := by
        intro x n m hnm h
        have e : algebraMap D K (w ^ m) * x = w ^ (m - n) • (algebraMap D K (w ^ n) * x) := by
          rw [Algebra.smul_def, ← mul_assoc, ← map_mul, ← pow_add, Nat.sub_add_cancel hnm]
        rw [e]
        exact Submodule.smul_mem _ _ h
      have fin : ∀ T : Finset K, (↑T : Set K) ⊆ I →
          ∃ n : ℕ, ∀ s ∈ T, algebraMap D K (w ^ n) * s ∈ (1 : Submodule D K) := by
        classical
        intro T
        induction T using Finset.induction_on with
        | empty => intro _; exact ⟨0, by simp⟩
        | insert a T haT ih =>
          intro hT
          rw [Finset.coe_insert, Set.insert_subset_iff] at hT
          obtain ⟨n₁, h₁⟩ := ih hT.2
          obtain ⟨n₂, h₂⟩ := single a hT.1
          refine ⟨max n₁ n₂, ?_⟩
          intro s hs
          rcases Finset.mem_insert.mp hs with rfl | hs
          · exact mono _ _ _ (le_max_right _ _) h₂
          · exact mono _ _ _ (le_max_left _ _) (h₁ s hs)
      obtain ⟨S, hS⟩ := hfg
      have hSI : (↑S : Set K) ⊆ I := by rw [← hS]; exact Submodule.subset_span
      obtain ⟨n, hn⟩ := fin S hSI
      refine ⟨n, ?_⟩
      intro x hx
      rw [← hS] at hx
      induction hx using Submodule.span_induction with
      | mem x hx => exact hn x hx
      | zero => simp
      | add x y _ _ hx hy => rw [mul_add]; exact add_mem hx hy
      | smul d x _ hx => rw [mul_smul_comm]; exact Submodule.smul_mem _ d hx

  have L3 : ∀ (D K : Type u) [CommRing D] [IsDomain D] [Field K] [Algebra D K] [FaithfulSMul D K]
      (w : D), Prime w → ∀ (I : (Submodule D K)ˣ),
      (∃ N : ℕ, algebraMap D K (w ^ N) ∈ (I : Submodule D K)) →
      (∃ n : ℕ, ∀ x ∈ (I : Submodule D K), algebraMap D K (w ^ n) * x ∈ (1 : Submodule D K)) →
      Submodule.unitsToPic D K I = 1 := by
    intro D K _ _ _ _ _ w hw I hN hn
    obtain ⟨N, hN⟩ := hN
    obtain ⟨n, hn⟩ := hn
    have hinj : Function.Injective (algebraMap D K) := FaithfulSMul.algebraMap_injective D K
    have hc0 : algebraMap D K w ≠ 0 := by
      intro h; apply hw.ne_zero; apply hinj; rw [h, map_zero]
    have hmapinj : Function.Injective (Submodule.map (Algebra.linearMap D K)) :=
      Submodule.map_injective_of_injective hinj
    have hA1 : Submodule.span D {algebraMap D K w ^ n} * (I : Submodule D K) ≤ 1 := by
      intro x hx
      obtain ⟨z, hz, rfl⟩ := Submodule.mem_span_singleton_mul.mp hx
      have := hn z hz
      rwa [map_pow] at this
    have hB1 : Submodule.span D {algebraMap D K w ^ N} *
        ((I⁻¹ : (Submodule D K)ˣ) : Submodule D K) ≤ 1 := by
      intro x hx
      obtain ⟨z, hz, rfl⟩ := Submodule.mem_span_singleton_mul.mp hx
      have h1 : algebraMap D K w ^ N * z ∈
          (I : Submodule D K) * ((I⁻¹ : (Submodule D K)ˣ) : Submodule D K) :=
        Submodule.mul_mem_mul (by rw [← map_pow]; exact hN) hz
      rwa [← Units.val_mul, mul_inv_cancel, Units.val_one] at h1
    have hmapA : Submodule.map (Algebra.linearMap D K) (Submodule.comap (Algebra.linearMap D K)
        (Submodule.span D {algebraMap D K w ^ n} * (I : Submodule D K))) =
        Submodule.span D {algebraMap D K w ^ n} * (I : Submodule D K) := by
      rw [Submodule.map_comap_eq, ← Submodule.one_eq_range]; exact inf_eq_right.mpr hA1
    have hmapB : Submodule.map (Algebra.linearMap D K) (Submodule.comap (Algebra.linearMap D K)
        (Submodule.span D {algebraMap D K w ^ N} * ((I⁻¹ : (Submodule D K)ˣ) : Submodule D K))) =
        Submodule.span D {algebraMap D K w ^ N} * ((I⁻¹ : (Submodule D K)ˣ) : Submodule D K) := by
      rw [Submodule.map_comap_eq, ← Submodule.one_eq_range]; exact inf_eq_right.mpr hB1
    have hprod : (Submodule.span D {algebraMap D K w ^ n} * (I : Submodule D K)) *
        (Submodule.span D {algebraMap D K w ^ N} * ((I⁻¹ : (Submodule D K)ˣ) : Submodule D K)) =
        Submodule.span D {algebraMap D K w ^ (n + N)} := by
      rw [mul_mul_mul_comm, ← Units.val_mul, mul_inv_cancel, Units.val_one, mul_one,
        Submodule.span_mul_span, Set.singleton_mul_singleton, pow_add]
    have hideal : Submodule.comap (Algebra.linearMap D K)
        (Submodule.span D {algebraMap D K w ^ n} * (I : Submodule D K)) *
        Submodule.comap (Algebra.linearMap D K)
        (Submodule.span D {algebraMap D K w ^ N} * ((I⁻¹ : (Submodule D K)ˣ) : Submodule D K)) =
        Ideal.span {w ^ (n + N)} := by
      apply hmapinj
      change IsLocalization.coeSubmodule K _ = IsLocalization.coeSubmodule K _
      rw [IsLocalization.coeSubmodule_mul, IsLocalization.coeSubmodule_span_singleton,
        IsLocalization.coeSubmodule.eq_1, IsLocalization.coeSubmodule.eq_1, hmapA, hmapB, hprod,
        map_pow]
    obtain ⟨k, hk⟩ := L2 D w hw (n + N) _ _ hideal
    have hAk : Submodule.span D {algebraMap D K w ^ n} * (I : Submodule D K) =
        Submodule.span D {algebraMap D K w ^ k} := by
      rw [← hmapA, hk]
      change IsLocalization.coeSubmodule K _ = _
      rw [IsLocalization.coeSubmodule_span_singleton, map_pow]
    have hIeq : (I : Submodule D K) =
        Submodule.span D {(algebraMap D K w ^ n)⁻¹ * algebraMap D K w ^ k} := by
      have e : (I : Submodule D K) = Submodule.span D {(algebraMap D K w ^ n)⁻¹} *
          (Submodule.span D {algebraMap D K w ^ n} * (I : Submodule D K)) := by
        rw [← mul_assoc, Submodule.span_mul_span, Set.singleton_mul_singleton,
          inv_mul_cancel₀ (pow_ne_zero _ hc0), ← Submodule.one_eq_span, one_mul]
      rw [e, hAk, Submodule.span_mul_span, Set.singleton_mul_singleton]
    have hz : (algebraMap D K w ^ n)⁻¹ * algebraMap D K w ^ k ≠ 0 :=
      mul_ne_zero (inv_ne_zero (pow_ne_zero _ hc0)) (pow_ne_zero _ hc0)
    rw [← MonoidHom.mem_ker, Submodule.ker_unitsToPic]
    refine ⟨Units.mk0 _ hz, ?_⟩
    apply Units.ext
    rw [Units.coe_map, hIeq]
    try simp only [Units.val_mk0]
    exact Submodule.spanSingleton_apply _

  have L1 : ∀ (D E K : Type u) [CommRing D] [CommRing E] [Field K] [Algebra D E] [Algebra D K]
      [Algebra E K] [IsScalarTower D E K] (M : Submonoid D) [IsLocalization M E] [FaithfulSMul D K]
      [FaithfulSMul E K] (I : (Submodule D K)ˣ) (J : (Submodule E K)ˣ),
      (J : Submodule E K) = Submodule.span E ((I : Submodule D K) : Set K) →
      CommRing.Pic.mapAlgebra D E (Submodule.unitsToPic D K I) = Submodule.unitsToPic E K J := by
    intro D E K _ _ _ _ _ _ _ M _ _ _ I J hJ
    have hsub : ∀ x ∈ (I : Submodule D K), x ∈ (J : Submodule E K) := fun x hx => by
      rw [hJ]; exact Submodule.subset_span hx
    let ν : (I : Submodule D K) →ₗ[D] (J : Submodule E K) :=
      { toFun := fun x => ⟨x.1, hsub x.1 x.2⟩
        map_add' := fun _ _ => rfl
        map_smul' := fun _ _ => rfl }
    have hloc : IsLocalizedModule M ν := by
      refine IsLocalizedModule.mk ?_ ?_ ?_
      · intro m
        rw [Module.End.isUnit_iff]
        have hu : IsUnit (algebraMap D E m) := IsLocalization.map_units E m
        constructor
        · intro y₁ y₂ h
          have h' : (m : D) • y₁ = (m : D) • y₂ := h
          rw [← algebraMap_smul E (m : D) y₁, ← algebraMap_smul E (m : D) y₂] at h'
          exact hu.smul_left_cancel.mp h'
        · intro y
          refine ⟨((hu.unit⁻¹ : Eˣ) : E) • y, ?_⟩
          show (m : D) • (((hu.unit⁻¹ : Eˣ) : E) • y) = y
          rw [← algebraMap_smul E (m : D), smul_smul, IsUnit.mul_val_inv, one_smul]
      · rintro ⟨y, hy⟩
        have key : ∀ z ∈ Submodule.span E ((I : Submodule D K) : Set K),
            ∃ m : M, (m : D) • z ∈ (I : Submodule D K) := by
          intro z hz
          induction hz using Submodule.span_induction with
          | mem x hx => exact ⟨1, by simpa using hx⟩
          | zero => exact ⟨1, by simp⟩
          | add x y _ _ hx hy =>
            obtain ⟨m₁, h₁⟩ := hx
            obtain ⟨m₂, h₂⟩ := hy
            refine ⟨m₁ * m₂, ?_⟩
            have e : ((m₁ * m₂ : M) : D) • (x + y) = (m₂ : D) • ((m₁ : D) • x) + (m₁ : D) • ((m₂ : D) • y) := by
              simp only [Submonoid.coe_mul, Algebra.smul_def, map_mul]; ring
            rw [e]
            exact add_mem (Submodule.smul_mem _ _ h₁) (Submodule.smul_mem _ _ h₂)
          | smul e x _ hx =>
            obtain ⟨m, hm⟩ := hx
            obtain ⟨⟨a, s⟩, hes⟩ := IsLocalization.surj M e
            have hes' : e * algebraMap D E (s : D) = algebraMap D E a := hes
            refine ⟨s * m, ?_⟩
            have e1 : ((s * m : M) : D) • (e • x) = a • ((m : D) • x) := by
              simp only [Algebra.smul_def, Submonoid.coe_mul, map_mul, IsScalarTower.algebraMap_apply D E K]
              rw [← hes']
              simp only [map_mul]
              ring
            rw [e1]
            exact Submodule.smul_mem _ _ hm
        obtain ⟨m, hm⟩ := key y (by rw [← hJ]; exact hy)
        exact ⟨(⟨(m : D) • y, hm⟩, m), rfl⟩
      · intro x₁ x₂ h
        refine ⟨1, ?_⟩
        have h' : (ν x₁ : K) = (ν x₂ : K) := congrArg Subtype.val h
        have : x₁ = x₂ := Subtype.ext h'
        rw [this]
    have hbc : IsBaseChange E ν := IsLocalizedModule.isBaseChange M E ν
    rw [CommRing.Pic.mapAlgebra_apply, Submodule.unitsToPic_apply E K J, CommRing.Pic.mk_eq_mk_iff]
    exact ⟨(LinearEquiv.baseChange D E _ _ (Submodule.unitsToPicEquiv I)).trans hbc.equiv⟩

  intro D _ _ w hw
  haveI : IsDomain (Localization.Away w) :=
    IsLocalization.isDomain_of_le_nonZeroDivisors (Localization.Away w)
      (powers_le_nonZeroDivisors_of_noZeroDivisors hw.ne_zero)
  rw [injective_iff_map_eq_one]
  intro P hP
  have hPmem : P ∈ (Submodule.unitsToPic D (FractionRing (Localization.Away w))).range := by
    rw [Submodule.range_unitsToPic, CommRing.relPic_eq_top]; trivial
  obtain ⟨I, rfl⟩ := hPmem
  have g0mul : ∀ P Q : Submodule D (FractionRing (Localization.Away w)),
      Submodule.span (Localization.Away w) ((P * Q : Submodule D _) : Set (FractionRing (Localization.Away w))) =
      Submodule.span (Localization.Away w) (P : Set (FractionRing (Localization.Away w))) *
      Submodule.span (Localization.Away w) (Q : Set (FractionRing (Localization.Away w))) := by
    intro P Q
    rw [Submodule.mul_eq_span_mul_set P Q, Submodule.span_span_of_tower, Submodule.span_mul_span]
  have g0one : Submodule.span (Localization.Away w)
      ((1 : Submodule D (FractionRing (Localization.Away w))) : Set (FractionRing (Localization.Away w))) = 1 := by
    rw [Submodule.one_eq_span (R := D) (A := FractionRing (Localization.Away w)),
      Submodule.span_span_of_tower]
    exact Submodule.one_eq_span.symm
  let J : (Submodule (Localization.Away w) (FractionRing (Localization.Away w)))ˣ :=
    { val := Submodule.span (Localization.Away w) ((I : Submodule D (FractionRing (Localization.Away w))) : Set (FractionRing (Localization.Away w)))
      inv := Submodule.span (Localization.Away w) (((I⁻¹ : (Submodule D (FractionRing (Localization.Away w)))ˣ) : Submodule D (FractionRing (Localization.Away w))) : Set (FractionRing (Localization.Away w)))
      val_inv := by rw [← g0mul, ← Units.val_mul, mul_inv_cancel, Units.val_one, g0one]
      inv_val := by rw [← g0mul, ← Units.val_mul, inv_mul_cancel, Units.val_one, g0one] }
  have hJ := L1 D (Localization.Away w) (FractionRing (Localization.Away w)) (Submonoid.powers w) I J rfl
  rw [hJ] at hP
  have hJker : J ∈ (Submodule.unitsToPic (Localization.Away w) (FractionRing (Localization.Away w))).ker := hP
  rw [Submodule.ker_unitsToPic] at hJker
  obtain ⟨u, hu⟩ := hJker
  have hu' : Submodule.span (Localization.Away w) {(u : FractionRing (Localization.Away w))} =
      Submodule.span (Localization.Away w) ((I : Submodule D (FractionRing (Localization.Away w))) : Set (FractionRing (Localization.Away w))) := by
    rw [← Submodule.spanSingleton_apply]; exact congrArg Units.val hu
  set I' : (Submodule D (FractionRing (Localization.Away w)))ˣ :=
    I * Units.map (↑(Submodule.spanSingleton D (A := FractionRing (Localization.Away w))) : FractionRing (Localization.Away w) →* Submodule D (FractionRing (Localization.Away w))) u⁻¹ with hI'def
  have hI'pic : Submodule.unitsToPic D (FractionRing (Localization.Away w)) I' = Submodule.unitsToPic D (FractionRing (Localization.Away w)) I := by
    have hk : Units.map (↑(Submodule.spanSingleton D (A := FractionRing (Localization.Away w))) : FractionRing (Localization.Away w) →* Submodule D (FractionRing (Localization.Away w))) u⁻¹ ∈
        (Submodule.unitsToPic D (FractionRing (Localization.Away w))).ker := by
      rw [Submodule.ker_unitsToPic]; exact ⟨u⁻¹, rfl⟩
    rw [hI'def, map_mul, MonoidHom.mem_ker.mp hk, mul_one]
  have hI'span : Submodule.span (Localization.Away w)
      ((I' : Submodule D (FractionRing (Localization.Away w))) : Set (FractionRing (Localization.Away w))) = 1 := by
    show Submodule.span (Localization.Away w) (((I : Submodule D (FractionRing (Localization.Away w))) *
      Submodule.spanSingleton D ((u⁻¹ : (FractionRing (Localization.Away w))ˣ) : FractionRing (Localization.Away w)) : Submodule D (FractionRing (Localization.Away w))) : Set (FractionRing (Localization.Away w))) = 1
    rw [g0mul, Submodule.spanSingleton_apply, Submodule.span_span_of_tower, ← hu',
      Submodule.span_mul_span, Set.singleton_mul_singleton, Units.mul_inv, ← Submodule.one_eq_span]
  have hfg : (I' : Submodule D (FractionRing (Localization.Away w))).FG := Submodule.fg_of_isUnit I'.isUnit
  obtain ⟨hN, hn⟩ := L4 D (Localization.Away w) (FractionRing (Localization.Away w)) w
    (I' : Submodule D (FractionRing (Localization.Away w))) hfg hI'span
  rw [← hI'pic]
  exact L3 D (FractionRing (Localization.Away w)) w hw I' hN hn

theorem wc_cmt_pic_away_prime_surjective : ∀ (D : Type u) [CommRing D] [IsDomain D] (w : D), Prime w → (∀ y : D, y ≠ 0 → ∃ n : ℕ, ¬ w ^ n ∣ y) → (∀ (m : Ideal D) [m.IsMaximal], w ∈ m → (∀ a b : Localization.AtPrime m, ∃ l : Localization.AtPrime m, ∀ z : Localization.AtPrime m, (a ∣ z ∧ b ∣ z ↔ l ∣ z)) ∧ ∀ y : Localization.AtPrime m, y ≠ 0 → ∃ n : ℕ, ¬ (algebraMap D (Localization.AtPrime m) w) ^ n ∣ y) → Function.Surjective (CommRing.Pic.mapAlgebra D (Localization.Away w)) :=
by

  have L1 : ∀ (D E K : Type u) [CommRing D] [CommRing E] [Field K] [Algebra D E] [Algebra D K]
      [Algebra E K] [IsScalarTower D E K] (M : Submonoid D) [IsLocalization M E] [FaithfulSMul D K]
      [FaithfulSMul E K] (I : (Submodule D K)ˣ) (J : (Submodule E K)ˣ),
      (J : Submodule E K) = Submodule.span E ((I : Submodule D K) : Set K) →
      CommRing.Pic.mapAlgebra D E (Submodule.unitsToPic D K I) = Submodule.unitsToPic E K J := by
    intro D E K _ _ _ _ _ _ _ M _ _ _ I J hJ
    have hsub : ∀ x ∈ (I : Submodule D K), x ∈ (J : Submodule E K) := fun x hx => by
      rw [hJ]; exact Submodule.subset_span hx
    let ν : (I : Submodule D K) →ₗ[D] (J : Submodule E K) :=
      { toFun := fun x => ⟨x.1, hsub x.1 x.2⟩
        map_add' := fun _ _ => rfl
        map_smul' := fun _ _ => rfl }
    have hloc : IsLocalizedModule M ν := by
      refine IsLocalizedModule.mk ?_ ?_ ?_
      · intro m
        rw [Module.End.isUnit_iff]
        have hu : IsUnit (algebraMap D E m) := IsLocalization.map_units E m
        constructor
        · intro y₁ y₂ h
          have h' : (m : D) • y₁ = (m : D) • y₂ := h
          rw [← algebraMap_smul E (m : D) y₁, ← algebraMap_smul E (m : D) y₂] at h'
          exact hu.smul_left_cancel.mp h'
        · intro y
          refine ⟨((hu.unit⁻¹ : Eˣ) : E) • y, ?_⟩
          show (m : D) • (((hu.unit⁻¹ : Eˣ) : E) • y) = y
          rw [← algebraMap_smul E (m : D), smul_smul, IsUnit.mul_val_inv, one_smul]
      · rintro ⟨y, hy⟩
        have key : ∀ z ∈ Submodule.span E ((I : Submodule D K) : Set K),
            ∃ m : M, (m : D) • z ∈ (I : Submodule D K) := by
          intro z hz
          induction hz using Submodule.span_induction with
          | mem x hx => exact ⟨1, by simpa using hx⟩
          | zero => exact ⟨1, by simp⟩
          | add x y _ _ hx hy =>
            obtain ⟨m₁, h₁⟩ := hx
            obtain ⟨m₂, h₂⟩ := hy
            refine ⟨m₁ * m₂, ?_⟩
            have e : ((m₁ * m₂ : M) : D) • (x + y) = (m₂ : D) • ((m₁ : D) • x) + (m₁ : D) • ((m₂ : D) • y) := by
              simp only [Submonoid.coe_mul, Algebra.smul_def, map_mul]; ring
            rw [e]
            exact add_mem (Submodule.smul_mem _ _ h₁) (Submodule.smul_mem _ _ h₂)
          | smul e x _ hx =>
            obtain ⟨m, hm⟩ := hx
            obtain ⟨⟨a, s⟩, hes⟩ := IsLocalization.surj M e
            have hes' : e * algebraMap D E (s : D) = algebraMap D E a := hes
            refine ⟨s * m, ?_⟩
            have e1 : ((s * m : M) : D) • (e • x) = a • ((m : D) • x) := by
              simp only [Algebra.smul_def, Submonoid.coe_mul, map_mul, IsScalarTower.algebraMap_apply D E K]
              rw [← hes']
              simp only [map_mul]
              ring
            rw [e1]
            exact Submodule.smul_mem _ _ hm
        obtain ⟨m, hm⟩ := key y (by rw [← hJ]; exact hy)
        exact ⟨(⟨(m : D) • y, hm⟩, m), rfl⟩
      · intro x₁ x₂ h
        refine ⟨1, ?_⟩
        have h' : (ν x₁ : K) = (ν x₂ : K) := congrArg Subtype.val h
        have : x₁ = x₂ := Subtype.ext h'
        rw [this]
    have hbc : IsBaseChange E ν := IsLocalizedModule.isBaseChange M E ν
    rw [CommRing.Pic.mapAlgebra_apply, Submodule.unitsToPic_apply E K J, CommRing.Pic.mk_eq_mk_iff]
    exact ⟨(LinearEquiv.baseChange D E _ _ (Submodule.unitsToPicEquiv I)).trans hbc.equiv⟩
  intro D _ _ w hw hfin hloc
  classical
  have hw0 : w ≠ 0 := hw.ne_zero

  have wfree : ∀ (n : ℕ) (x : D), ¬ w ^ n ∣ x → ∃ (k : ℕ) (d : D), x = w ^ k * d ∧ ¬ w ∣ d := by
    intro n
    induction n with
    | zero => intro x hx; exact (hx (by simp)).elim
    | succ n ih =>
      intro x hx
      by_cases hwx : w ∣ x
      · obtain ⟨x', rfl⟩ := hwx
        have hx' : ¬ w ^ n ∣ x' := fun h => hx (by rw [pow_succ']; exact mul_dvd_mul_left w h)
        obtain ⟨k, d, hd, hwd⟩ := ih x' hx'
        exact ⟨k + 1, d, by rw [hd, pow_succ']; ring, hwd⟩
      · exact ⟨0, x, by rw [pow_zero, one_mul], hwx⟩
  have main : ∀ (E K : Type u) [CommRing E] [IsDomain E] [Field K] [Algebra D E] [Algebra D K]
      [Algebra E K] [IsScalarTower D E K] [IsLocalization.Away w E] [IsFractionRing E K]
      [FaithfulSMul D K] [FaithfulSMul E K] (J : (Submodule E K)ˣ),
      ∃ (I : (Submodule D K)ˣ) (J₂ : (Submodule E K)ˣ),
        (J₂ : Submodule E K) = Submodule.span E ((I : Submodule D K) : Set K) ∧
        Submodule.unitsToPic E K J₂ = Submodule.unitsToPic E K J := by
    intro E K _ _ _ _ _ _ _ _ _ _ _ J
    have hι : Function.Injective (algebraMap D K) := FaithfulSMul.algebraMap_injective D K
    have hwE : IsUnit (algebraMap D E w) := IsLocalization.Away.algebraMap_isUnit w

    have clear : ∀ (n : ℕ) (y : Fin n → K), ∃ (v : D) (h : Fin n → D), v ≠ 0 ∧
        ∀ s, algebraMap D K (h s) = algebraMap D K v * y s := by
      intro n y
      obtain ⟨b, hb⟩ := IsLocalization.exist_integer_multiples (nonZeroDivisors E) Finset.univ y
      have hb' : ∀ i, ∃ e : E, algebraMap E K e = (b : E) • y i :=
        fun i => RingHom.mem_rangeS.mp (hb i (Finset.mem_univ i))
      choose e he using hb'
      obtain ⟨c, hc⟩ := IsLocalization.exist_integer_multiples (Submonoid.powers w) Finset.univ e
      have hc' : ∀ i, ∃ h : D, algebraMap D E h = (c : D) • e i :=
        fun i => RingHom.mem_rangeS.mp (hc i (Finset.mem_univ i))
      choose h hh using hc'
      obtain ⟨n₁, r, hr⟩ := IsLocalization.Away.surj w (b : E)
      obtain ⟨k, hk⟩ := (Submonoid.mem_powers_iff _ _).mp c.2
      refine ⟨r * c, fun i => w ^ n₁ * h i, ?_, ?_⟩
      · refine mul_ne_zero ?_ ?_
        · intro hr0
          rw [hr0, map_zero] at hr
          have hb0 : (b : E) ≠ 0 := nonZeroDivisors.ne_zero b.2
          exact hb0 ((hwE.pow n₁).mul_left_eq_zero.mp hr)
        · rw [← hk]; exact pow_ne_zero _ hw0
      · intro i
        have e1 : algebraMap D K (h i) = algebraMap D K (c : D) * algebraMap E K (e i) := by
          rw [IsScalarTower.algebraMap_apply D E K (h i), hh i, Algebra.smul_def, map_mul,
            ← IsScalarTower.algebraMap_apply D E K (c : D)]
        have e2 : algebraMap E K (e i) = algebraMap E K (b : E) * y i := by
          rw [he i, Algebra.smul_def]
        have e3 : algebraMap D K r = algebraMap E K (b : E) * algebraMap D K w ^ n₁ := by
          rw [IsScalarTower.algebraMap_apply D E K r, ← hr, map_mul, map_pow,
            ← IsScalarTower.algebraMap_apply D E K w]
        simp only [map_mul, map_pow]
        linear_combination (algebraMap D K w) ^ n₁ * e1 +
          (algebraMap D K w) ^ n₁ * algebraMap D K (c : D) * e2 - algebraMap D K (c : D) * y i * e3

    obtain ⟨p, y, hy⟩ :=
      Submodule.fg_iff_exists_fin_generating_family.mp (Submodule.fg_of_isUnit J.isUnit)
    obtain ⟨q, z, hz⟩ :=
      Submodule.fg_iff_exists_fin_generating_family.mp (Submodule.fg_of_isUnit J⁻¹.isUnit)
    have hJJ : (J : Submodule E K) * ((J⁻¹ : (Submodule E K)ˣ) : Submodule E K) = 1 := by
      rw [← Units.val_mul, mul_inv_cancel, Units.val_one]
    have hyz : ∀ s t, ∃ f : E, algebraMap E K f = y s * z t := by
      intro s t
      have hm : y s * z t ∈ (J : Submodule E K) * ((J⁻¹ : (Submodule E K)ˣ) : Submodule E K) :=
        Submodule.mul_mem_mul (by rw [← hy]; exact Submodule.subset_span ⟨s, rfl⟩)
          (by rw [← hz]; exact Submodule.subset_span ⟨t, rfl⟩)
      rw [hJJ] at hm
      exact Submodule.mem_one.mp hm
    choose f hf using hyz
    have h1mem : (1 : K) ∈
        Submodule.span E (Set.range (fun st : Fin p × Fin q => y st.1 * z st.2)) := by
      have h0 : (1 : K) ∈ (J : Submodule E K) * ((J⁻¹ : (Submodule E K)ˣ) : Submodule E K) := by
        rw [hJJ]; exact Submodule.mem_one.mpr ⟨1, map_one _⟩
      rw [← hy, ← hz, Submodule.span_mul_span] at h0
      refine Submodule.span_mono ?_ h0
      rintro _ ⟨_, ⟨s, rfl⟩, _, ⟨t, rfl⟩, rfl⟩
      exact ⟨(s, t), rfl⟩
    obtain ⟨e, he⟩ := (Submodule.mem_span_range_iff_exists_fun E).mp h1mem
    have he' : ∑ st : Fin p × Fin q, e st • (y st.1 * z st.2) = 1 := he
    obtain ⟨v, g, hv, hg⟩ := clear p y
    obtain ⟨v', a, hv', ha⟩ := clear q z
    have hga : ∀ s t, algebraMap D K (g s) * algebraMap D K (a t) =
        algebraMap D K v * algebraMap D K v' * (y s * z t) := by
      intro s t; rw [hg, ha]; ring
    obtain ⟨n₀, hn₀⟩ := hfin (v * v') (mul_ne_zero hv hv')
    obtain ⟨k₀, δ, hδ₀eq, hwδ⟩ := wfree n₀ (v * v') hn₀
    have hδ : δ ≠ 0 := fun h => hwδ (h ▸ dvd_zero w)

    have H1 : ∀ s t, δ ∣ g s * a t := by
      intro s t
      obtain ⟨k, c, hkc⟩ := IsLocalization.Away.surj w (f s t)
      have e1 : algebraMap D K c = (y s * z t) * algebraMap D K w ^ k := by
        rw [IsScalarTower.algebraMap_apply D E K c, ← hkc, map_mul, hf s t, map_pow,
          ← IsScalarTower.algebraMap_apply D E K w]
      have hK : algebraMap D K (g s * a t * w ^ k) = algebraMap D K (v * v' * c) := by
        simp only [map_mul, map_pow]
        linear_combination (algebraMap D K w) ^ k * hga s t -
          algebraMap D K v * algebraMap D K v' * e1
      have hD := hι hK
      rw [hδ₀eq] at hD
      have hdvd : w ^ k ∣ δ * (w ^ k₀ * c) := ⟨g s * a t, by linear_combination -hD⟩
      obtain ⟨c', hc'⟩ := hw.pow_dvd_of_dvd_mul_left k hwδ hdvd
      refine ⟨c', ?_⟩
      have h3 : g s * a t * w ^ k = δ * c' * w ^ k := by linear_combination hD + δ * hc'
      exact mul_right_cancel₀ (pow_ne_zero k hw0) h3

    obtain ⟨M, c, H2⟩ : ∃ (M : ℕ) (c : Fin p × Fin q → D),
        w ^ M * δ = ∑ st, c st * (g st.1 * a st.2) := by
      obtain ⟨c₀, hc₀⟩ := IsLocalization.exist_integer_multiples (Submonoid.powers w) Finset.univ e
      have hc₀' : ∀ st, ∃ c : D, algebraMap D E c = (c₀ : D) • e st :=
        fun st => RingHom.mem_rangeS.mp (hc₀ st (Finset.mem_univ st))
      choose c hc using hc₀'
      obtain ⟨M₀, hM₀⟩ := (Submonoid.mem_powers_iff _ _).mp c₀.2
      refine ⟨M₀ + k₀, c, ?_⟩
      apply hι
      have key : ∀ st : Fin p × Fin q, algebraMap D K (c st * (g st.1 * a st.2)) =
          algebraMap D K ((c₀ : D) * (v * v')) * (e st • (y st.1 * z st.2)) := by
        intro st
        have e1 : algebraMap D K (c st) = algebraMap D K (c₀ : D) * algebraMap E K (e st) := by
          rw [IsScalarTower.algebraMap_apply D E K (c st), hc st, Algebra.smul_def, map_mul,
            ← IsScalarTower.algebraMap_apply D E K (c₀ : D)]
        have e2 := hga st.1 st.2
        rw [Algebra.smul_def]
        simp only [map_mul]
        linear_combination (algebraMap D K (g st.1) * algebraMap D K (a st.2)) * e1 +
          algebraMap D K (c₀ : D) * algebraMap E K (e st) * e2
      have hsum : algebraMap D K (∑ st, c st * (g st.1 * a st.2)) =
          algebraMap D K ((c₀ : D) * (v * v')) := by
        rw [map_sum]
        simp only [key]
        rw [← Finset.mul_sum, he', mul_one]
      rw [hsum, ← hM₀, hδ₀eq]
      congr 1
      ring

    obtain ⟨𝔞, h𝔞⟩ : ∃ 𝔞 : Ideal D, 𝔞 = ⨅ t, Submodule.colon (Ideal.span {δ}) {a t} := ⟨_, rfl⟩
    obtain ⟨𝔞', h𝔞'⟩ : ∃ 𝔞' : Ideal D, 𝔞' = ⨅ s, Submodule.colon (Ideal.span {δ}) {g s} :=
      ⟨_, rfl⟩
    have mem𝔞 : ∀ x, x ∈ 𝔞 ↔ ∀ t, δ ∣ x * a t := by
      intro x
      rw [h𝔞]
      simp only [Submodule.mem_iInf, Submodule.mem_colon_singleton, smul_eq_mul,
        Ideal.mem_span_singleton]
    have mem𝔞' : ∀ x, x ∈ 𝔞' ↔ ∀ s, δ ∣ x * g s := by
      intro x
      rw [h𝔞']
      simp only [Submodule.mem_iInf, Submodule.mem_colon_singleton, smul_eq_mul,
        Ideal.mem_span_singleton]
    have hg𝔞 : ∀ s, g s ∈ 𝔞 := fun s => (mem𝔞 _).mpr (fun t => H1 s t)
    have ha𝔞' : ∀ t, a t ∈ 𝔞' := fun t => (mem𝔞' _).mpr (fun s => by rw [mul_comm]; exact H1 s t)
    have hsum_mem : w ^ M * δ ∈ 𝔞 * 𝔞' := by
      rw [H2]
      exact Ideal.sum_mem _ (fun st _ => Ideal.mul_mem_left _ _ (Ideal.mul_mem_mul (hg𝔞 _) (ha𝔞' _)))

    have LW : ∀ (m : Ideal D) [m.IsMaximal], w ∈ m → ∃ r ∉ m, r * δ ∈ 𝔞 * 𝔞' := by
      intro m _ hwm
      obtain ⟨hl, -⟩ := hloc m hwm
      letI : GCDMonoid (Localization.AtPrime m) :=
        gcdMonoidOfLCM (fun x y => Classical.choose (hl x y))
          (fun x y => ((Classical.choose_spec (hl x y) _).mpr dvd_rfl).1)
          (fun x y => ((Classical.choose_spec (hl x y) _).mpr dvd_rfl).2)
          (fun {x y z} h1 h2 => (Classical.choose_spec (hl z y) x).mp ⟨h1, h2⟩)
      have Γ : ∀ (n : ℕ) (F : Fin n → Localization.AtPrime m), ∃ γ, (∀ i, γ ∣ F i) ∧
          ∀ c d : Localization.AtPrime m, (∀ i, d ∣ c * F i) → d ∣ c * γ := by
        intro n
        induction n with
        | zero =>
          intro F
          exact ⟨0, fun i => i.elim0, fun c d _ => by rw [mul_zero]; exact dvd_zero d⟩
        | succ n ih =>
          intro F
          obtain ⟨γ₀, h1, h2⟩ := ih (fun i => F i.succ)
          refine ⟨gcd (F 0) γ₀, fun i => ?_, fun c d hd => ?_⟩
          · rcases Fin.eq_zero_or_eq_succ i with rfl | ⟨j, rfl⟩
            · exact gcd_dvd_left _ _
            · exact (gcd_dvd_right _ _).trans (h1 j)
          · have hd0 : d ∣ c * F 0 := hd 0
            have hd1 : d ∣ c * γ₀ := h2 c d (fun j => hd j.succ)
            exact (dvd_gcd hd0 hd1).trans (gcd_mul_left' c (F 0) γ₀).dvd
      obtain ⟨γ, hγ, hγ'⟩ := Γ p (fun s => algebraMap D (Localization.AtPrime m) (g s))
      obtain ⟨γ', hγ1, hγ1'⟩ := Γ q (fun t => algebraMap D (Localization.AtPrime m) (a t))
      have hδga : ∀ s t, algebraMap D (Localization.AtPrime m) δ ∣
          algebraMap D (Localization.AtPrime m) (g s) * algebraMap D (Localization.AtPrime m) (a t) :=
        fun s t => by rw [← map_mul]; exact map_dvd _ (H1 s t)
      have hδγ : algebraMap D (Localization.AtPrime m) δ ∣ γ * γ' := by
        have hs : ∀ s, algebraMap D (Localization.AtPrime m) δ ∣
            γ' * algebraMap D (Localization.AtPrime m) (g s) := fun s => by
          rw [mul_comm]; exact hγ1' _ _ (fun t => hδga s t)
        rw [mul_comm]; exact hγ' _ _ hs
      obtain ⟨φ, φ', hφ, hφ', hδφ⟩ := exists_dvd_and_dvd_of_dvd_mul hδγ
      have hφg : ∀ s, φ ∣ algebraMap D (Localization.AtPrime m) (g s) := fun s => hφ.trans (hγ s)
      have hφa : ∀ t, φ' ∣ algebraMap D (Localization.AtPrime m) (a t) :=
        fun t => hφ'.trans (hγ1 t)
      have T1 : ∀ (d y₀ : D), algebraMap D (Localization.AtPrime m) d ∣
          algebraMap D (Localization.AtPrime m) y₀ → ∃ σ ∈ m.primeCompl, d ∣ σ * y₀ := by
        intro d y₀ hdy
        obtain ⟨ℓ, hℓ⟩ := hdy
        obtain ⟨⟨n, τ⟩, hnτ⟩ := IsLocalization.surj m.primeCompl ℓ
        dsimp only at hnτ
        have h1 : algebraMap D (Localization.AtPrime m) (y₀ * τ) =
            algebraMap D (Localization.AtPrime m) (d * n) := by
          rw [map_mul, map_mul, hℓ, ← hnτ]; ring
        obtain ⟨ρ, hρ⟩ := IsLocalization.exists_of_eq (M := m.primeCompl) h1
        exact ⟨ρ * τ, mul_mem ρ.2 τ.2, ⟨ρ * n, by linear_combination hρ⟩⟩
      have T1n : ∀ (d : D) (n : ℕ) (yy : Fin n → D),
          (∀ t, algebraMap D (Localization.AtPrime m) d ∣ algebraMap D (Localization.AtPrime m) (yy t)) →
          ∃ σ ∈ m.primeCompl, ∀ t, d ∣ σ * yy t := by
        intro d n yy hyy
        choose σ hσ hσd using fun t => T1 d (yy t) (hyy t)
        refine ⟨∏ t, σ t, prod_mem (fun t _ => hσ t), fun t => ?_⟩
        exact (hσd t).trans (mul_dvd_mul_right (Finset.dvd_prod_of_mem σ (Finset.mem_univ t)) _)
      obtain ⟨⟨x, σ₀⟩, hx⟩ := IsLocalization.surj m.primeCompl φ
      obtain ⟨⟨x', σ₀'⟩, hx'⟩ := IsLocalization.surj m.primeCompl φ'
      dsimp only at hx hx'
      obtain ⟨σ₁, hσ₁, h𝔞x⟩ := T1n δ q (fun t => x * a t) (fun t => by
        obtain ⟨k, hk⟩ := hφa t
        refine ⟨algebraMap D (Localization.AtPrime m) σ₀ * k, ?_⟩
        show algebraMap D (Localization.AtPrime m) (x * a t) = _
        rw [map_mul, ← hx, hk, hδφ]; ring)
      obtain ⟨σ₂, hσ₂, h𝔞x'⟩ := T1n δ p (fun s => x' * g s) (fun s => by
        obtain ⟨k, hk⟩ := hφg s
        refine ⟨algebraMap D (Localization.AtPrime m) σ₀' * k, ?_⟩
        show algebraMap D (Localization.AtPrime m) (x' * g s) = _
        rw [map_mul, ← hx', hk, hδφ]; ring)
      have hxx : algebraMap D (Localization.AtPrime m) (x * x') =
          algebraMap D (Localization.AtPrime m) (δ * σ₀ * σ₀') := by
        rw [map_mul, map_mul, map_mul, ← hx, ← hx', hδφ]; ring
      obtain ⟨ρ, hρ⟩ := IsLocalization.exists_of_eq (M := m.primeCompl) hxx
      refine ⟨(ρ : D) * σ₀ * σ₀' * σ₁ * σ₂, ?_, ?_⟩
      · have hmem : (ρ : D) * σ₀ * σ₀' * σ₁ * σ₂ ∈ m.primeCompl :=
          mul_mem (mul_mem (mul_mem (mul_mem ρ.2 σ₀.2) σ₀'.2) hσ₁) hσ₂
        exact hmem
      · have hm1 : σ₁ * x ∈ 𝔞 := (mem𝔞 _).mpr (fun t => by rw [mul_assoc]; exact h𝔞x t)
        have hm2 : σ₂ * x' ∈ 𝔞' := (mem𝔞' _).mpr (fun s => by rw [mul_assoc]; exact h𝔞x' s)
        have heq : (ρ : D) * σ₀ * σ₀' * σ₁ * σ₂ * δ = (ρ : D) * ((σ₁ * x) * (σ₂ * x')) := by
          linear_combination (-(σ₁ * σ₂)) * hρ
        rw [heq]
        exact Ideal.mul_mem_left _ _ (Ideal.mul_mem_mul hm1 hm2)

    have AG : 𝔞 * 𝔞' = Ideal.span {δ} := by
      apply le_antisymm
      · rw [Ideal.mul_le]
        intro x hx y' hy'
        choose u hu using (mem𝔞 x).mp hx
        choose u' hu' using (mem𝔞' y').mp hy'
        rw [Ideal.mem_span_singleton]
        have h1 : δ * (w ^ M * (x * y')) = δ * (δ * ∑ st, c st * (u st.2 * u' st.1)) := by
          calc δ * (w ^ M * (x * y')) = w ^ M * δ * (x * y') := by ring
            _ = ∑ st, c st * (g st.1 * a st.2) * (x * y') := by rw [H2, Finset.sum_mul]
            _ = ∑ st, δ * (δ * (c st * (u st.2 * u' st.1))) := Finset.sum_congr rfl (fun st _ => by
                  calc c st * (g st.1 * a st.2) * (x * y')
                      = c st * (x * a st.2) * (y' * g st.1) := by ring
                    _ = _ := by rw [hu, hu']; ring)
            _ = _ := by rw [← Finset.mul_sum, ← Finset.mul_sum]
        have h2 := mul_left_cancel₀ hδ h1
        have h3 : w ^ M ∣ δ * ∑ st, c st * (u st.2 * u' st.1) := ⟨x * y', h2.symm⟩
        obtain ⟨k', hk'⟩ := hw.pow_dvd_of_dvd_mul_left M hwδ h3
        refine ⟨k', ?_⟩
        apply mul_left_cancel₀ (pow_ne_zero M hw0)
        rw [h2, hk']; ring
      · rw [Ideal.span_singleton_le_iff_mem]
        by_contra hnot
        have hC : Submodule.colon (𝔞 * 𝔞') {δ} ≠ ⊤ := by
          intro h
          apply hnot
          have h1 : (1 : D) ∈ Submodule.colon (𝔞 * 𝔞') {δ} := by rw [h]; exact Submodule.mem_top
          rw [Submodule.mem_colon_singleton, one_smul] at h1
          exact h1
        obtain ⟨m, hm, hCm⟩ := Ideal.exists_le_maximal _ hC
        have memC : ∀ r, r * δ ∈ 𝔞 * 𝔞' → r ∈ m := fun r hr =>
          hCm (Submodule.mem_colon_singleton.mpr (by rw [smul_eq_mul]; exact hr))
        by_cases hwm : w ∈ m
        · haveI := hm
          obtain ⟨r, hrm, hr⟩ := LW m hwm
          exact hrm (memC r hr)
        · exact hwm (hm.isPrime.mem_of_pow_mem M (memC _ hsum_mem))

    have hιδ : algebraMap D K δ ≠ 0 := fun h => hδ (hι (h.trans (map_zero _).symm))
    let I : (Submodule D K)ˣ :=
      { val := IsLocalization.coeSubmodule K 𝔞
        inv := Submodule.span D {(algebraMap D K δ)⁻¹} * IsLocalization.coeSubmodule K 𝔞'
        val_inv := by
          rw [mul_left_comm, ← IsLocalization.coeSubmodule_mul, AG,
            IsLocalization.coeSubmodule_span_singleton, Submodule.span_mul_span,
            Set.singleton_mul_singleton, inv_mul_cancel₀ hιδ, ← Submodule.one_eq_span]
        inv_val := by
          rw [mul_assoc, ← IsLocalization.coeSubmodule_mul, mul_comm 𝔞' 𝔞, AG,
            IsLocalization.coeSubmodule_span_singleton, Submodule.span_mul_span,
            Set.singleton_mul_singleton, inv_mul_cancel₀ hιδ, ← Submodule.one_eq_span] }

    have Bspan : Submodule.span E ((IsLocalization.coeSubmodule K 𝔞 : Submodule D K) : Set K) =
        Submodule.span E (Set.range fun s => algebraMap D K (g s)) := by
      apply le_antisymm
      · rw [Submodule.span_le]
        intro z hz
        obtain ⟨x, hx, rfl⟩ := (IsLocalization.mem_coeSubmodule K 𝔞).mp hz
        choose u hu using (mem𝔞 x).mp hx
        have h1 : δ * (w ^ M * x) = δ * ∑ st : Fin p × Fin q, c st * u st.2 * g st.1 := by
          calc δ * (w ^ M * x) = w ^ M * δ * x := by ring
            _ = ∑ st, c st * (g st.1 * a st.2) * x := by rw [H2, Finset.sum_mul]
            _ = ∑ st, δ * (c st * u st.2 * g st.1) := Finset.sum_congr rfl (fun st _ => by
                  calc c st * (g st.1 * a st.2) * x = c st * g st.1 * (x * a st.2) := by ring
                    _ = _ := by rw [hu]; ring)
            _ = _ := by rw [Finset.mul_sum]
        have h2 := mul_left_cancel₀ hδ h1
        have hz' : algebraMap D K (w ^ M) * algebraMap D K x ∈
            Submodule.span E (Set.range fun s => algebraMap D K (g s)) := by
          rw [← map_mul, h2, map_sum]
          refine Submodule.sum_mem _ (fun st _ => ?_)
          rw [map_mul, ← Algebra.smul_def]
          exact Submodule.smul_of_tower_mem _ _ (Submodule.subset_span ⟨st.1, rfl⟩)
        obtain ⟨ε, hε⟩ := hwE.pow M
        have hxe : algebraMap D K x =
            ((ε⁻¹ : Eˣ) : E) • (algebraMap D K (w ^ M) * algebraMap D K x) := by
          rw [Algebra.smul_def, ← mul_assoc, IsScalarTower.algebraMap_apply D E K (w ^ M), map_pow,
            ← hε, ← map_mul, Units.inv_mul, map_one, one_mul]
        show algebraMap D K x ∈ _
        rw [hxe]
        exact Submodule.smul_mem _ _ hz'
      · rw [Submodule.span_le]
        rintro _ ⟨s, rfl⟩
        exact Submodule.subset_span ((IsLocalization.mem_coeSubmodule K 𝔞).mpr ⟨g s, hg𝔞 s, rfl⟩)

    have hvK : algebraMap D K v ≠ 0 := fun h => hv (hι (h.trans (map_zero _).symm))
    refine ⟨I, J * Units.map (↑(Submodule.spanSingleton E (A := K)) : K →* Submodule E K)
      (Units.mk0 _ hvK), ?_, ?_⟩
    · show (J : Submodule E K) * Submodule.spanSingleton E (algebraMap D K v) =
        Submodule.span E ((IsLocalization.coeSubmodule K 𝔞 : Submodule D K) : Set K)
      rw [Submodule.spanSingleton_apply, Bspan, ← hy, Submodule.span_mul_span]
      congr 1
      ext x'
      constructor
      · rintro ⟨_, ⟨s, rfl⟩, _, rfl, rfl⟩
        exact ⟨s, by beta_reduce; rw [hg s, mul_comm]⟩
      · rintro ⟨s, rfl⟩
        exact ⟨_, ⟨s, rfl⟩, _, rfl, by beta_reduce; rw [hg s, mul_comm]⟩
    · rw [map_mul]
      have hk : Units.map (↑(Submodule.spanSingleton E (A := K)) : K →* Submodule E K)
          (Units.mk0 _ hvK) ∈ (Submodule.unitsToPic E K).ker := by
        rw [Submodule.ker_unitsToPic]; exact ⟨_, rfl⟩
      rw [MonoidHom.mem_ker.mp hk, mul_one]

  haveI : IsDomain (Localization.Away w) :=
    IsLocalization.isDomain_of_le_nonZeroDivisors (Localization.Away w)
      (powers_le_nonZeroDivisors_of_noZeroDivisors hw0)
  intro x
  have hx : x ∈ (Submodule.unitsToPic (Localization.Away w)
      (FractionRing (Localization.Away w))).range := by
    rw [Submodule.range_unitsToPic, CommRing.relPic_eq_top]; trivial
  obtain ⟨J, rfl⟩ := hx
  obtain ⟨I, J₂, hJ₂, hcl⟩ := main (Localization.Away w) (FractionRing (Localization.Away w)) J
  exact ⟨Submodule.unitsToPic D _ I,
    (L1 D (Localization.Away w) (FractionRing (Localization.Away w)) (Submonoid.powers w) I J₂
      hJ₂).trans hcl⟩

theorem wc_cgt_milnor_tube_pic_torsion : ∀ (A : Type u) [CommRing A] (B : Type u) [CommRing B] (d : ℕ) (β : MvPolynomial (Option (Fin d)) A →+* B) (Ω : Type u) [Field Ω] [IsAlgClosed Ω] [Algebra A B] [Algebra A Ω], β.comp MvPolynomial.C = algebraMap A B → (∃ (I : Type u) (_ : SmallCategory I) (_ : IsFiltered I) (F : I ⥤ CommRingCat.{u}) (p : ∀ i, MvPolynomial (Option (Fin d)) A →+* F.obj i) (ι : ∀ i, F.obj i →+* B), (∀ i, (p i).Etale) ∧ (∀ {i j : I} (f : i ⟶ j), (F.map f).hom.comp (p i) = p j) ∧ (∀ {i j : I} (f : i ⟶ j), (ι j).comp (F.map f).hom = ι i) ∧ (∀ i, (ι i).comp (p i) = β) ∧ (∀ b : B, ∃ (i : I) (t : F.obj i), ι i t = b) ∧ (∀ (i : I) (t : F.obj i), ι i t = 0 → ∃ (j : I) (f : i ⟶ j), (F.map f).hom t = 0)) → IsDomain (TensorProduct A B Ω) → Prime (TensorProduct.tmul A (β (MvPolynomial.X none)) (1 : Ω)) → ∀ (ℓ : ℕ), Subsingleton {x : CommRing.Pic (TensorProduct A B Ω) // x ^ ℓ = 1} → Subsingleton {x : CommRing.Pic (Localization.Away (TensorProduct.tmul A (β (MvPolynomial.X none)) (1 : Ω))) // x ^ ℓ = 1} :=
by
  intro A _ B _ d β Ω _ _ _ _ hβC hFEP hD hw ℓ hP
  classical

  have hβ : wcIndEtale β := wc_cmt_fep_indEtale _ B β hFEP
  have hθ := wc_cmt_tensor_indEtale A B d β Ω hβC hβ

  have H : ∀ (E : Type u) [CommRing E] [Algebra (MvPolynomial (Option (Fin d)) Ω) E],
      Algebra.Etale (MvPolynomial (Option (Fin d)) Ω) E → ∀ (q : Ideal E) [q.IsPrime],
      IsNoetherianRing (Localization.AtPrime q) ∧ IsDomain (Localization.AtPrime q) ∧
        UniqueFactorizationMonoid (Localization.AtPrime q) :=
    fun E _ _ hE q _ => wc_cmt_etale_mvpoly_field_local_ufd Ω (Option (Fin d)) E hE q
  have loc : ∀ (m : Ideal (TensorProduct A B Ω)) [m.IsMaximal],
      IsDomain (Localization.AtPrime m) ∧
      (∀ a b : Localization.AtPrime m, ∃ l : Localization.AtPrime m,
        ∀ z : Localization.AtPrime m, (a ∣ z ∧ b ∣ z ↔ l ∣ z)) ∧
      ∀ y w : Localization.AtPrime m, w ∈ IsLocalRing.maximalIdeal (Localization.AtPrime m) →
        y ≠ 0 → ∃ n : ℕ, ¬ w ^ n ∣ y := by
    intro m _
    have hθm := wc_indEtale_comp _ (algebraMap (TensorProduct A B Ω) (Localization.AtPrime m)) hθ
      (wc_sh_localization_indEtale (TensorProduct A B Ω) (Localization.AtPrime m) m.primeCompl)
    exact wc_cmt_indEtale_local_lcm_finite_order _ (Localization.AtPrime m) _ hθm H

  have hfo : ∀ y : TensorProduct A B Ω, y ≠ 0 →
      ∃ n : ℕ, ¬ (TensorProduct.tmul A (β (MvPolynomial.X none)) (1 : Ω)) ^ n ∣ y := by
    intro y hy
    obtain ⟨m, hm, hwm⟩ := Ideal.exists_le_maximal
      (Ideal.span {TensorProduct.tmul A (β (MvPolynomial.X none)) (1 : Ω)})
      (by rw [Ne, Ideal.span_singleton_eq_top]; exact hw.not_unit)
    have hwm' : TensorProduct.tmul A (β (MvPolynomial.X none)) (1 : Ω) ∈ m :=
      hwm (Ideal.mem_span_singleton_self _)
    obtain ⟨_, _, hfin⟩ := loc m
    have hy' : algebraMap (TensorProduct A B Ω) (Localization.AtPrime m) y ≠ 0 := by
      intro h
      apply hy
      exact (map_eq_zero_iff _ (IsLocalization.injective (Localization.AtPrime m)
        (Ideal.primeCompl_le_nonZeroDivisors m))).mp h
    have hwmax := (IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime m) m
      (TensorProduct.tmul A (β (MvPolynomial.X none)) (1 : Ω))).mpr hwm'
    obtain ⟨n, hn⟩ := hfin _ _ hwmax hy'
    refine ⟨n, fun hdvd => hn ?_⟩
    rw [← map_pow]
    exact map_dvd _ hdvd
  have hloc : ∀ (m : Ideal (TensorProduct A B Ω)) [m.IsMaximal],
      TensorProduct.tmul A (β (MvPolynomial.X none)) (1 : Ω) ∈ m →
      (∀ a b : Localization.AtPrime m, ∃ l : Localization.AtPrime m,
        ∀ z : Localization.AtPrime m, (a ∣ z ∧ b ∣ z ↔ l ∣ z)) ∧
      ∀ y : Localization.AtPrime m, y ≠ 0 → ∃ n : ℕ,
        ¬ (algebraMap (TensorProduct A B Ω) (Localization.AtPrime m)
          (TensorProduct.tmul A (β (MvPolynomial.X none)) (1 : Ω))) ^ n ∣ y := by
    intro m _ hwm
    obtain ⟨_, hl, hfin⟩ := loc m
    exact ⟨hl, fun y hy => hfin y _ ((IsLocalization.AtPrime.to_map_mem_maximal_iff
      (Localization.AtPrime m) m _).mpr hwm) hy⟩

  have hS := wc_cmt_pic_away_prime_surjective _ _ hw hfo hloc
  have hI := wc_cmt_pic_away_prime_injective _ _ hw

  have key : ∀ z : {x : CommRing.Pic (Localization.Away
      (TensorProduct.tmul A (β (MvPolynomial.X none)) (1 : Ω))) // x ^ ℓ = 1},
      z = ⟨1, one_pow ℓ⟩ := by
    rintro ⟨x, hx⟩
    obtain ⟨y, rfl⟩ := hS x
    have hy : y ^ ℓ = 1 := hI (by rw [map_pow, hx, map_one])
    have h1 : (⟨y, hy⟩ : {x : CommRing.Pic (TensorProduct A B Ω) // x ^ ℓ = 1}) =
        ⟨1, one_pow ℓ⟩ := @Subsingleton.elim _ hP _ _
    have hy1 : y = 1 := congrArg Subtype.val h1
    subst hy1
    exact Subtype.ext (map_one _)
  exact ⟨fun x x' => (key x).trans (key x').symm⟩

theorem wc_cpt_geom_tube_low : ∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] [IsDomain A] [IsDiscreteValuationRing A] (ℓ : ℕ), ℓ.Prime → IsUnit ((ℓ : ℕ) : A) → ∀ (d : ℕ) (y : Spec (.of (MvPolynomial (Option (Fin d)) A))), Spec.map (CommRingCat.ofHom (algebraMap A (MvPolynomial (Option (Fin d)) A))) y = IsLocalRing.closedPoint A → (MvPolynomial.X none : MvPolynomial (Option (Fin d)) A) ∈ y.asIdeal → ∀ (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (MvPolynomial (Option (Fin d)) A))) y)) (Scheme.Etale.forget (Spec (.of (MvPolynomial (Option (Fin d)) A))))) (φ : ∀ l, Spec (.of B) ⟶ (W'.obj l).right.left) (a : Spec (.of B) ⟶ Spec (.of (MvPolynomial (Option (Fin d)) A))), wcHalShData y B Λ W' φ a → ∀ (β : MvPolynomial (Option (Fin d)) A →+* B), Spec.map (CommRingCat.ofHom β) = a → ∀ (K : Type u) [Field K] [IsSepClosed K] (ζ : Spec (.of K) ⟶ Spec (.of A)), Nat.card (wcEtCoh (Limits.pullback (Spec.map (CommRingCat.ofHom ((algebraMap B (Localization.Away (β (MvPolynomial.X none)))).comp (β.comp (algebraMap A (MvPolynomial (Option (Fin d)) A)))))) ζ) ℓ 0) = ℓ ∧ Nat.card (wcEtCoh (Limits.pullback (Spec.map (CommRingCat.ofHom ((algebraMap B (Localization.Away (β (MvPolynomial.X none)))).comp (β.comp (algebraMap A (MvPolynomial (Option (Fin d)) A)))))) ζ) ℓ 1) = ℓ :=
by
  intro A _ _ _ _ _ ℓ hℓ hunit d y hy hy0 B _ _ _ Λ _ _ W' φ a ha β hβ K _ _ ζ
  classical
  subst hβ

  have s6 : ∀ (B : Type u) [CommRing B] [IsDomain B] (u : B), Prime u → ∀ (ℓ : ℕ), 0 < ℓ →
      (∀ v : Bˣ, ∃ w : Bˣ, w ^ ℓ = v) →
      Nat.card ((Localization.Away u)ˣ ⧸ (powMonoidHom ℓ : (Localization.Away u)ˣ →* (Localization.Away u)ˣ).range) = ℓ := by
    intro B _ _ u hu ℓ hℓ0 hdiv
    classical
    set C := Localization.Away u
    set ι : B →+* C := algebraMap B C with hι
    have hle : Submonoid.powers u ≤ nonZeroDivisors B := powers_le_nonZeroDivisors_of_noZeroDivisors hu.ne_zero
    have hinj : Function.Injective ι := IsLocalization.injective C hle
    set û : Cˣ := (IsLocalization.Away.algebraMap_isUnit u : IsUnit (ι u)).unit with hûdef
    have hû : (û : C) = ι u := IsUnit.unit_spec _
    set j : Bˣ →* Cˣ := Units.map ι.toMonoidHom with hj
    have hjv : ∀ v : Bˣ, ((j v : Cˣ) : C) = ι v := fun v => rfl
    have divl : ∀ N : ℕ, ∀ b b' : B, b * b' = u ^ N → ∃ (k : ℕ) (v : Bˣ), b = v * u ^ k := by
      intro N
      induction N with
      | zero =>
        intro b b' h
        rw [pow_zero] at h
        exact ⟨0, (isUnit_iff_exists_inv.mpr ⟨b', h⟩).unit, by simp⟩
      | succ N ih =>
        intro b b' h
        have hd : u ∣ b * b' := ⟨u ^ N, by rw [h, pow_succ']⟩
        rcases hu.dvd_or_dvd hd with ⟨b₁, rfl⟩ | ⟨b₁, rfl⟩
        · have h' : b₁ * b' = u ^ N := by
            apply mul_left_cancel₀ hu.ne_zero
            rw [← mul_assoc, h, pow_succ']
          obtain ⟨k, v, hv⟩ := ih b₁ b' h'
          exact ⟨k + 1, v, by rw [hv, pow_succ']; ring⟩
        · have h' : b * b₁ = u ^ N := by
            apply mul_left_cancel₀ hu.ne_zero
            rw [pow_succ'] at h
            rw [← h]; ring
          exact ih b b₁ h'
    have unitsC : ∀ c : Cˣ, ∃ (v : Bˣ) (k : ℤ), c = j v * û ^ k := by
      intro c
      obtain ⟨m, b, hb⟩ := IsLocalization.Away.surj u (c : C)
      obtain ⟨m', b', hb'⟩ := IsLocalization.Away.surj u ((c⁻¹ : Cˣ) : C)
      have hbb : b * b' = u ^ (m + m') := by
        apply hinj
        rw [map_mul, ← hb, ← hb', map_pow, pow_add]
        have : (c : C) * ((c⁻¹ : Cˣ) : C) = 1 := by simp
        linear_combination (ι u ^ m * ι u ^ m') * this
      obtain ⟨k, v, hv⟩ := divl _ b b' hbb
      refine ⟨v, (k : ℤ) - m, ?_⟩
      apply Units.ext
      have e1 : (c : C) * (û : C) ^ m = ((j v : Cˣ) : C) * (û : C) ^ k := by
        rw [hjv, hû, hb, hv, map_mul, map_pow]
      have e2 : ((û ^ ((k : ℤ) - m) : Cˣ) : C) * (û : C) ^ m = (û : C) ^ k := by
        rw [← Units.val_pow_eq_pow_val, ← Units.val_pow_eq_pow_val, ← Units.val_mul, ← zpow_natCast,
          ← zpow_natCast, ← zpow_add]
        congr 2; ring
      have hum : IsUnit ((û : C) ^ m) := (û.isUnit).pow m
      apply hum.mul_left_injective
      simp only [Units.val_mul]
      rw [e1, mul_assoc, e2]
    have rigid : ∀ (w : Bˣ) (m : ℤ), j w = û ^ m → m = 0 := by
      intro w m h
      obtain ⟨t, ht | ht⟩ := Int.eq_nat_or_neg m
      · subst ht
        have h1 : ι (w : B) = ι (u ^ t) := by
          rw [← hjv, h, zpow_natCast, Units.val_pow_eq_pow_val, hû, map_pow]
        have h2 := hinj h1
        by_contra hne
        have ht0 : t ≠ 0 := by exact_mod_cast hne
        exact hu.not_isUnit ((isUnit_pow_iff ht0).mp (h2 ▸ w.isUnit))
      · subst ht
        have h1 : ι ((w : B) * u ^ t) = ι 1 := by
          rw [map_mul, ← hjv, h, map_pow, ← hû, map_one, ← Units.val_pow_eq_pow_val, ← Units.val_mul,
            zpow_neg, zpow_natCast, inv_mul_cancel, Units.val_one]
        have h2 := hinj h1
        by_contra hne
        have ht0 : t ≠ 0 := by intro h0; apply hne; rw [h0]; simp
        have : IsUnit (u ^ t) := isUnit_iff_exists_inv'.mpr ⟨_, h2⟩
        exact hu.not_isUnit ((isUnit_pow_iff ht0).mp this)
    set H := (powMonoidHom ℓ : Cˣ →* Cˣ).range with hH
    have kerl : ∀ n : ℤ, û ^ n ∈ H → (ℓ : ℤ) ∣ n := by
      intro n hn
      obtain ⟨d, hd⟩ := hn
      rw [powMonoidHom_apply] at hd
      obtain ⟨v, k, rfl⟩ := unitsC d
      refine ⟨k, ?_⟩
      have h1 : j (v ^ ℓ) = û ^ (n - ℓ * k) := by
        rw [map_pow, zpow_sub, ← hd, mul_pow, zpow_mul, zpow_natCast]
        group
      have := rigid _ _ h1
      linarith
    have memH : ∀ n : ℤ, (ℓ : ℤ) ∣ n → û ^ n ∈ H := by
      rintro n ⟨t, rfl⟩
      exact ⟨û ^ t, by rw [powMonoidHom_apply, ← zpow_natCast, ← zpow_mul, mul_comm]⟩
    let f : Fin ℓ → Cˣ ⧸ H := fun i => QuotientGroup.mk (û ^ ((i : ℕ) : ℤ))
    have hfinj : Function.Injective f := by
      intro a b hab
      have h1 := QuotientGroup.eq.mp hab
      rw [← zpow_neg, ← zpow_add] at h1
      have h2 := kerl _ h1
      have h3 := Int.eq_zero_of_abs_lt_dvd h2 (by
        have := a.isLt; have := b.isLt
        rw [abs_lt]; constructor <;> omega)
      ext; omega
    have hfsurj : Function.Surjective f := by
      intro q
      obtain ⟨c, rfl⟩ := QuotientGroup.mk_surjective q
      obtain ⟨v, k, rfl⟩ := unitsC c
      obtain ⟨w, rfl⟩ := hdiv v
      have hℓz : (0 : ℤ) < ℓ := by exact_mod_cast hℓ0
      refine ⟨⟨(k % ℓ).toNat, by have := Int.emod_lt_of_pos k hℓz; have := Int.emod_nonneg k hℓz.ne'; omega⟩, ?_⟩
      apply QuotientGroup.eq.mpr
      have hr : (((k % ℓ).toNat : ℕ) : ℤ) = k % ℓ := Int.toNat_of_nonneg (Int.emod_nonneg k hℓz.ne')
      simp only [hr]
      refine ⟨j w * û ^ (k / ℓ), ?_⟩
      rw [powMonoidHom_apply, mul_pow, ← map_pow, ← zpow_natCast (û ^ (k / ℓ)), ← zpow_mul]
      have hk : û ^ k = û ^ ((ℓ : ℤ) * (k / ℓ)) * û ^ (k % ℓ) := by
        rw [← zpow_add]; congr 1; rw [Int.emod_def]; ring
      rw [hk, mul_comm (k / ℓ) (ℓ : ℤ), mul_comm (û ^ ((ℓ : ℤ) * (k / ℓ))) (û ^ (k % ℓ)),
        mul_left_comm _ (û ^ (k % ℓ)), inv_mul_cancel_left]
    rw [← Nat.card_congr (Equiv.ofBijective f ⟨hfinj, hfsurj⟩), Nat.card_eq_fintype_card, Fintype.card_fin]

  obtain ⟨β₁, hβ₁, hFEP⟩ := wc_shdata_filtered_etale_presentation y B Λ W' φ _ ha
    (MvPolynomial (Option (Fin d)) A) (Iso.refl _)
  have hββ : β₁ = β := by
    have h1 : Spec.map (CommRingCat.ofHom β₁) = Spec.map (CommRingCat.ofHom β) := by
      rw [hβ₁, Iso.refl_hom, Category.comp_id]
    exact congrArg CommRingCat.Hom.hom (Spec.map_injective h1)
  rw [hββ] at hFEP

  have hpt : ∀ x : Spec (.of (IsLocalRing.ResidueField B)),
      Spec.map (CommRingCat.ofHom (IsLocalRing.residue B)) x = IsLocalRing.closedPoint B := by
    intro x
    rw [Subsingleton.elim x (IsLocalRing.closedPoint _)]
    exact IsLocalRing.comap_closedPoint (IsLocalRing.residue B)
  obtain ⟨e, -, he⟩ := ha.2.2.2.2.2
  have hay : Spec.map (CommRingCat.ofHom β) (IsLocalRing.closedPoint B) = y := by
    have key : ∀ p : ↥(Spec (.of (AlgebraicClosure
        ((Spec (.of (MvPolynomial (Option (Fin d)) A))).residueField y)))),
        Spec.map (CommRingCat.ofHom β) (IsLocalRing.closedPoint B) = y := by
      intro p
      have h1 : (Spec.map (CommRingCat.ofHom e) ≫ Spec.map (CommRingCat.ofHom (IsLocalRing.residue B)) ≫
          Spec.map (CommRingCat.ofHom β)) p =
          (wcEtGeomPt (Spec (.of (MvPolynomial (Option (Fin d)) A))) y) p := by
        rw [he]
      rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply, hpt] at h1
      dsimp only [wcEtGeomPt] at h1
      rw [Scheme.Hom.comp_apply, Scheme.fromSpecResidueField_apply] at h1
      exact h1
    exact key (IsLocalRing.closedPoint _)
  have hyB : (Spec.map (CommRingCat.ofHom β) (IsLocalRing.closedPoint B)).asIdeal = y.asIdeal := by
    rw [hay]
  have hum : β (MvPolynomial.X none) ∈ IsLocalRing.maximalIdeal B := by
    have h3 : (MvPolynomial.X none : MvPolynomial (Option (Fin d)) A) ∈
        (Spec.map (CommRingCat.ofHom β) (IsLocalRing.closedPoint B)).asIdeal := by
      rw [hyB]; exact hy0
    exact h3
  have hlocal : ∀ x : A, x ∈ IsLocalRing.maximalIdeal A →
      β (algebraMap A (MvPolynomial (Option (Fin d)) A) x) ∈ IsLocalRing.maximalIdeal B := by
    intro x hx
    have h1 : x ∈ (Spec.map (CommRingCat.ofHom (algebraMap A (MvPolynomial (Option (Fin d)) A))) y).asIdeal := by
      rw [hy]; exact hx
    have h2 : algebraMap A (MvPolynomial (Option (Fin d)) A) x ∈
        (Spec.map (CommRingCat.ofHom β) (IsLocalRing.closedPoint B)).asIdeal := by
      rw [hyB]; exact h1
    exact h2
  letI : Algebra A B := (β.comp (algebraMap A (MvPolynomial (Option (Fin d)) A))).toAlgebra
  haveI : IsLocalHom (algebraMap A B) := by
    constructor
    intro x hx
    by_contra hnx
    have hxm : x ∈ IsLocalRing.maximalIdeal A := by
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]; exact hnx
    have h := hlocal x hxm
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at h
    exact h hx
  have hβC : β.comp MvPolynomial.C = algebraMap A B := by
    show β.comp MvPolynomial.C = β.comp (algebraMap A (MvPolynomial (Option (Fin d)) A))
    rw [MvPolynomial.algebraMap_eq]

  have hint : (algebraMap K (AlgebraicClosure K)).IsIntegral := fun x => Algebra.IsIntegral.isIntegral x
  obtain ⟨θ, hθ⟩ : ∃ θ : A →+* AlgebraicClosure K, Spec.map (CommRingCat.ofHom θ) =
      Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))) ≫ ζ :=
    ⟨(Spec.preimage (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))) ≫ ζ)).hom, by
      simp only [CommRingCat.ofHom_hom, Spec.map_preimage]⟩
  letI : Algebra A (AlgebraicClosure K) := θ.toAlgebra
  have hℓΩ : ((ℓ : ℕ) : AlgebraicClosure K) ≠ 0 := by
    have h1 := hunit.map θ
    rw [map_natCast] at h1
    exact h1.ne_zero
  have red : ∀ q : ℕ, Nonempty (wcEtCoh (Limits.pullback (Spec.map (CommRingCat.ofHom ((algebraMap B (Localization.Away (β (MvPolynomial.X none)))).comp (β.comp (algebraMap A (MvPolynomial (Option (Fin d)) A)))))) ζ) ℓ q ≃
      wcEtCoh (Limits.pullback (Spec.map (CommRingCat.ofHom ((algebraMap B (Localization.Away (β (MvPolynomial.X none)))).comp (β.comp (algebraMap A (MvPolynomial (Option (Fin d)) A)))))) (Spec.map (CommRingCat.ofHom θ))) ℓ q) := by
    intro q
    obtain ⟨e1⟩ := wc_et_coh_purely_inseparable_invariance K (AlgebraicClosure K) hint
      (Limits.pullback (Spec.map (CommRingCat.ofHom ((algebraMap B (Localization.Away (β (MvPolynomial.X none)))).comp (β.comp (algebraMap A (MvPolynomial (Option (Fin d)) A)))))) ζ)
      (Limits.pullback.snd _ _) ℓ q
    obtain ⟨e2⟩ := wc_et_coh_iso_invariance
      ((Limits.pullbackLeftPullbackSndIso (Spec.map (CommRingCat.ofHom ((algebraMap B (Localization.Away (β (MvPolynomial.X none)))).comp (β.comp (algebraMap A (MvPolynomial (Option (Fin d)) A)))))) ζ
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))) ≪≫
        Limits.pullback.congrHom rfl hθ.symm).hom ℓ q
    exact ⟨e1.symm.trans e2.symm⟩

  have s2E : ∀ q : ℕ, Nonempty (wcEtCoh (Limits.pullback (Spec.map (CommRingCat.ofHom ((algebraMap B (Localization.Away (β (MvPolynomial.X none)))).comp (β.comp (algebraMap A (MvPolynomial (Option (Fin d)) A)))))) (Spec.map (CommRingCat.ofHom θ))) ℓ q ≃
      wcEtCoh (Spec (.of (Localization.Away (TensorProduct.tmul A (β (MvPolynomial.X none)) (1 : AlgebraicClosure K))))) ℓ q) := by
    intro q
    have hg : CommRingCat.ofHom ((algebraMap B (Localization.Away (β (MvPolynomial.X none)))).comp (β.comp (algebraMap A (MvPolynomial (Option (Fin d)) A)))) =
        CommRingCat.ofHom (algebraMap A (Localization.Away (β (MvPolynomial.X none)))) := by
      rw [IsScalarTower.algebraMap_eq A B (Localization.Away (β (MvPolynomial.X none)))]
    haveI : IsLocalization.Away (TensorProduct.tmul A (β (MvPolynomial.X none)) (1 : AlgebraicClosure K))
        (TensorProduct B (TensorProduct A B (AlgebraicClosure K)) (Localization.Away (β (MvPolynomial.X none)))) :=
      IsLocalization.Away.tensor (S := TensorProduct A B (AlgebraicClosure K)) (β (MvPolynomial.X none))
        (Localization.Away (β (MvPolynomial.X none)))
    let eL : Localization.Away (TensorProduct.tmul A (β (MvPolynomial.X none)) (1 : AlgebraicClosure K)) ≃+*
        TensorProduct A (Localization.Away (β (MvPolynomial.X none))) (AlgebraicClosure K) :=
      (((IsLocalization.algEquiv (Submonoid.powers (TensorProduct.tmul A (β (MvPolynomial.X none)) (1 : AlgebraicClosure K)))
        (Localization.Away (TensorProduct.tmul A (β (MvPolynomial.X none)) (1 : AlgebraicClosure K)))
        (TensorProduct B (TensorProduct A B (AlgebraicClosure K)) (Localization.Away (β (MvPolynomial.X none))))).toRingEquiv.trans
        (Algebra.TensorProduct.comm B (TensorProduct A B (AlgebraicClosure K)) (Localization.Away (β (MvPolynomial.X none)))).toRingEquiv).trans
        (Algebra.TensorProduct.cancelBaseChange A B (Localization.Away (β (MvPolynomial.X none)))
          (Localization.Away (β (MvPolynomial.X none))) (AlgebraicClosure K)).toRingEquiv)
    obtain ⟨e1⟩ := wc_et_coh_iso_invariance (Spec.map eL.toCommRingCatIso.hom) ℓ q
    obtain ⟨e2⟩ := wc_et_coh_iso_invariance
      (Limits.pullback.congrHom (congrArg Spec.map hg)
        (rfl : Spec.map (CommRingCat.ofHom θ) = Spec.map (CommRingCat.ofHom (algebraMap A (AlgebraicClosure K)))) ≪≫
        pullbackSpecIso A (Localization.Away (β (MvPolynomial.X none))) (AlgebraicClosure K)).hom ℓ q
    exact ⟨e2.symm.trans e1.symm⟩
  have s2D : ∀ q : ℕ, Nonempty (wcEtCoh (Limits.pullback (Spec.map (CommRingCat.ofHom β) ≫ Spec.map (CommRingCat.ofHom (algebraMap A (MvPolynomial (Option (Fin d)) A)))) (Spec.map (CommRingCat.ofHom θ))) ℓ q ≃
      wcEtCoh (Spec (.of (TensorProduct A B (AlgebraicClosure K)))) ℓ q) := by
    intro q
    have hgB : Spec.map (CommRingCat.ofHom β) ≫ Spec.map (CommRingCat.ofHom (algebraMap A (MvPolynomial (Option (Fin d)) A))) =
        Spec.map (CommRingCat.ofHom (algebraMap A B)) := by
      rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
    obtain ⟨e2⟩ := wc_et_coh_iso_invariance
      (Limits.pullback.congrHom hgB
        (rfl : Spec.map (CommRingCat.ofHom θ) = Spec.map (CommRingCat.ofHom (algebraMap A (AlgebraicClosure K)))) ≪≫
        pullbackSpecIso A B (AlgebraicClosure K)).hom ℓ q
    exact ⟨e2.symm⟩

  haveI hD : IsDomain (TensorProduct A B (AlgebraicClosure K)) :=
    wc_ring_milnor_fibre_isDomain_mv A B (AlgebraicClosure K) (Option (Fin d)) β hβC hFEP
  have hw : Prime (TensorProduct.tmul A (β (MvPolynomial.X none)) (1 : AlgebraicClosure K)) :=
    wc_cgt_milnor_divisor_prime A B d β hβC hum hFEP (AlgebraicClosure K)
  have hleE : Submonoid.powers (TensorProduct.tmul A (β (MvPolynomial.X none)) (1 : AlgebraicClosure K)) ≤
      nonZeroDivisors (TensorProduct A B (AlgebraicClosure K)) :=
    powers_le_nonZeroDivisors_of_noZeroDivisors hw.ne_zero
