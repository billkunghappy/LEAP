theorem wc_pencil_Rq_hm_comparison (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (D : wcLefschetzDatum F' F'' Y n)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] :
    ∃ Φ : ∀ (q : ℕ) (V : (wcP1Over F'').left.ProEt),
        Projective (wcFreeSheaf (wcP1Over F'').left V) →
        ((wcRq D.f ℓ q).obj.obj (Opposite.op V) ≃+ wcHM ((wcProEtPullback D.f).obj V).left ℓ q),
      (∀ (q : ℕ) (V : (wcP1Over F'').left.ProEt) (hV : Projective (wcFreeSheaf (wcP1Over F'').left V))
          (c : ℚ_[ℓ]) (y : (wcRq D.f ℓ q).obj.obj (Opposite.op V)),
        Φ q V hV (((wcRqScalar D.f ℓ q c).hom.app (Opposite.op V)).hom y) =
          wcHMScalar ((wcProEtPullback D.f).obj V).left ℓ q c (Φ q V hV y)) ∧
      (∀ (q : ℕ) (V V' : (wcP1Over F'').left.ProEt)
          (hV : Projective (wcFreeSheaf (wcP1Over F'').left V))
          (hV' : Projective (wcFreeSheaf (wcP1Over F'').left V')) (a : V' ⟶ V)
          (Da : wcHMPullData ((wcProEtPullback D.f).map a).left ℓ), wcHMPullCanonical Da →
          ∀ y : (wcRq D.f ℓ q).obj.obj (Opposite.op V),
        Φ q V' hV' (((wcRq D.f ℓ q).obj.map a.op).hom y) = wcHMPull Da q (Φ q V hV y)) :=
by
  classical
  obtain ⟨ev0, hev0post, hev0pre⟩ := wc_free_ext0_eval (wcP1Over F'').left
  obtain ⟨L, adj, -, θ, hθ⟩ := wc_proet_push_left_adjoint_free_nat D.f
  choose ed hedbij hedτ hedσ using fun q : ℕ =>
    ext_rightDerived_adj_edge L (wcProEtPush D.f) adj (wcLadicSheaf D.Yt.left ℓ) q
  obtain ⟨PP, Pm, evM, Tq, hnat, hpre, hTs, hTn⟩ :=
    wc_proet_ladic_free_ext_module_natural D.Yt.left ℓ
  obtain ⟨Θ, hΘs, hΘn⟩ := wc_proet_free_module_ext_hm_natural D.Yt.left ℓ PP Pm evM hnat hpre

  have hb : ∀ (q : ℕ) (V : (wcP1Over F'').left.ProEt),
      Projective (wcFreeSheaf (wcP1Over F'').left V) →
      Function.Bijective (ed q (wcFreeSheaf (wcP1Over F'').left V)) := by
    intro q V hV
    haveI := hV
    exact hedbij q _
  obtain ⟨E2, hE2a, hE2b⟩ : ∃ E2 : ∀ (q : ℕ) (V : (wcP1Over F'').left.ProEt),
      Projective (wcFreeSheaf (wcP1Over F'').left V) →
      (Abelian.Ext (wcFreeSheaf (wcP1Over F'').left V) (wcRq D.f ℓ q) 0 ≃+
        Abelian.Ext (L.obj (wcFreeSheaf (wcP1Over F'').left V)) (wcLadicSheaf D.Yt.left ℓ) q),
      (∀ q V hV x, ed q _ (E2 q V hV x) = x) ∧ (∀ q V hV z, E2 q V hV (ed q _ z) = z) :=
    ⟨fun q V hV => (AddEquiv.ofBijective (ed q _) (hb q V hV)).symm,
      fun q V hV x => (AddEquiv.ofBijective (ed q _) (hb q V hV)).apply_symm_apply x,
      fun q V hV z => (AddEquiv.ofBijective (ed q _) (hb q V hV)).symm_apply_apply z⟩

  obtain ⟨E3, hE3⟩ : ∃ E3 : ∀ (q : ℕ) (V : (wcP1Over F'').left.ProEt),
      Abelian.Ext (L.obj (wcFreeSheaf (wcP1Over F'').left V)) (wcLadicSheaf D.Yt.left ℓ) q ≃+
        Abelian.Ext (wcFreeSheaf D.Yt.left ((wcProEtPullback D.f).obj V))
          (wcLadicSheaf D.Yt.left ℓ) q,
      ∀ q V z, E3 q V z = (Abelian.Ext.mk₀ (θ V).inv).comp z (zero_add q) :=
    ⟨fun q V =>
      { toFun := fun z => (Abelian.Ext.mk₀ (θ V).inv).comp z (zero_add q)
        invFun := fun z => (Abelian.Ext.mk₀ (θ V).hom).comp z (zero_add q)
        left_inv := fun z => by
          simp only [Abelian.Ext.mk₀_comp_mk₀_assoc, Iso.hom_inv_id, Abelian.Ext.mk₀_id_comp]
        right_inv := fun z => by
          simp only [Abelian.Ext.mk₀_comp_mk₀_assoc, Iso.inv_hom_id, Abelian.Ext.mk₀_id_comp]
        map_add' := fun z z' => Abelian.Ext.comp_add _ z z' _ }, fun q V z => rfl⟩
  refine ⟨fun q V hV => (ev0 V (wcRq D.f ℓ q)).symm.trans ((E2 q V hV).trans ((E3 q V).trans
      ((Tq q ((wcProEtPullback D.f).obj V)).trans (Θ q ((wcProEtPullback D.f).obj V))))), ?_, ?_⟩
  ·
    intro q V hV c y
    simp only [AddEquiv.trans_apply]
    have h1 : (ev0 V (wcRq D.f ℓ q)).symm (((wcRqScalar D.f ℓ q c).hom.app (Opposite.op V)).hom y) =
        ((ev0 V (wcRq D.f ℓ q)).symm y).comp (Abelian.Ext.mk₀ (wcRqScalar D.f ℓ q c))
          (add_zero 0) := by
      rw [AddEquiv.symm_apply_eq]
      have h := hev0post V _ _ (wcRqScalar D.f ℓ q c) ((ev0 V (wcRq D.f ℓ q)).symm y)
      rw [AddEquiv.apply_symm_apply] at h
      exact h.symm
    have h2 : ∀ w : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left V) (wcRq D.f ℓ q) 0,
        E2 q V hV (w.comp (Abelian.Ext.mk₀ (wcRqScalar D.f ℓ q c)) (add_zero 0)) =
          (E2 q V hV w).comp (Abelian.Ext.mk₀ (wcLadicScalar D.Yt.left ℓ c)) (add_zero q) := by
      intro w
      have h := hedσ q (wcFreeSheaf (wcP1Over F'').left V) (wcLadicScalar D.Yt.left ℓ c)
        (E2 q V hV w)
      rw [hE2a] at h
      have h' := congrArg (E2 q V hV) h
      rw [hE2b] at h'
      exact h'.symm
    have h3 : ∀ z : Abelian.Ext (L.obj (wcFreeSheaf (wcP1Over F'').left V))
        (wcLadicSheaf D.Yt.left ℓ) q,
        E3 q V (z.comp (Abelian.Ext.mk₀ (wcLadicScalar D.Yt.left ℓ c)) (add_zero q)) =
          (E3 q V z).comp (Abelian.Ext.mk₀ (wcLadicScalar D.Yt.left ℓ c)) (add_zero q) := by
      intro z
      rw [hE3, hE3]
      exact (Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ _).symm
    rw [h1, h2, h3, hTs, hΘs]
  ·
    intro q V V' hV hV' a Da hDa y
    simp only [AddEquiv.trans_apply]
    have h1 : (ev0 V' (wcRq D.f ℓ q)).symm (((wcRq D.f ℓ q).obj.map a.op).hom y) =
        (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left a)).comp
          ((ev0 V (wcRq D.f ℓ q)).symm y) (zero_add 0) := by
      rw [AddEquiv.symm_apply_eq]
      have h := hev0pre V V' a (wcRq D.f ℓ q) ((ev0 V (wcRq D.f ℓ q)).symm y)
      rw [AddEquiv.apply_symm_apply] at h
      exact h.symm
    have h2 : ∀ w : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left V) (wcRq D.f ℓ q) 0,
        E2 q V' hV' ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left a)).comp w
          (zero_add 0)) =
          (Abelian.Ext.mk₀ (L.map (wcFreeSheafMap (wcP1Over F'').left a))).comp (E2 q V hV w)
            (zero_add q) := by
      intro w
      have h := hedτ q (wcFreeSheafMap (wcP1Over F'').left a) (E2 q V hV w)
      rw [hE2a] at h
      have h' := congrArg (E2 q V' hV') h
      rw [hE2b] at h'
      exact h'.symm
    have hθ' : (θ V').inv ≫ L.map (wcFreeSheafMap (wcP1Over F'').left a) =
        wcFreeSheafMap D.Yt.left ((wcProEtPullback D.f).map a) ≫ (θ V).inv := by
      rw [Iso.inv_comp_eq, ← Category.assoc, ← hθ a, Category.assoc, Iso.hom_inv_id,
        Category.comp_id]
    have h3 : ∀ z : Abelian.Ext (L.obj (wcFreeSheaf (wcP1Over F'').left V))
        (wcLadicSheaf D.Yt.left ℓ) q,
        E3 q V' ((Abelian.Ext.mk₀ (L.map (wcFreeSheafMap (wcP1Over F'').left a))).comp z
          (zero_add q)) =
          (Abelian.Ext.mk₀ (wcFreeSheafMap D.Yt.left ((wcProEtPullback D.f).map a))).comp
            (E3 q V z) (zero_add q) := by
      intro z
      rw [hE3, hE3, Abelian.Ext.mk₀_comp_mk₀_assoc, Abelian.Ext.mk₀_comp_mk₀_assoc, hθ']
    rw [h1, h2, h3, hTn, hΘn q _ _ _ Da hDa]

theorem wc_pencil_nbhd_qcqs (F' F'' : Type u) [Field F'] [Field F''] [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (D : wcLefschetzDatum F' F'' Y n)
    (V₀ : (wcP1Over F'').left.ProEt)
    (A : Type u) [CommRing A] (e : V₀.left ≅ Spec (.of A)) :
    CompactSpace ((wcProEtPullback D.f).obj V₀).left ∧
      QuasiSeparatedSpace ((wcProEtPullback D.f).obj V₀).left ∧
      CompactSpace ((wcProEtPullback (Limits.pullback.fst D.f D.u0)).obj
        ((wcProEtPullback D.f).obj V₀)).left ∧
      QuasiSeparatedSpace ((wcProEtPullback (Limits.pullback.fst D.f D.u0)).obj
        ((wcProEtPullback D.f).obj V₀)).left :=
by
  haveI := D.proper
  haveI hpsep : IsSeparated (wcP1Over F'').hom := by
    show IsSeparated (Proj.toSpecZero _ ≫ Spec.map _)
    infer_instance
  haveI : QuasiCompact (D.f ≫ (wcP1Over F'').hom) := by rw [D.hf]; infer_instance
  haveI : QuasiSeparated (D.f ≫ (wcP1Over F'').hom) := by rw [D.hf]; infer_instance
  haveI : QuasiCompact D.f := QuasiCompact.of_comp D.f (wcP1Over F'').hom
  haveI : QuasiSeparated D.f := QuasiSeparated.of_comp D.f (wcP1Over F'').hom
  haveI : QuasiCompact (D.u0 ≫ (wcP1Over F'').hom) := by rw [D.hu0]; infer_instance
  haveI : QuasiSeparated (D.u0 ≫ (wcP1Over F'').hom) := by rw [D.hu0]; infer_instance
  haveI : QuasiCompact D.u0 := QuasiCompact.of_comp D.u0 (wcP1Over F'').hom
  haveI : QuasiSeparated D.u0 := QuasiSeparated.of_comp D.u0 (wcP1Over F'').hom
  haveI hV1 : CompactSpace V₀.left := QuasiCompact.compactSpace_of_compactSpace e.hom
  haveI hV2 : QuasiSeparatedSpace V₀.left := quasiSeparatedSpace_of_quasiSeparated e.hom
  haveI : CompactSpace ((𝟭 Scheme).obj V₀.left) := hV1
  haveI : QuasiSeparatedSpace ((𝟭 Scheme).obj V₀.left) := hV2
  haveI hiqc : QuasiCompact (Limits.pullback.fst D.f D.u0) := by
    first
    | infer_instance
    | exact MorphismProperty.pullback_fst (P := @QuasiCompact) _ _ (inferInstanceAs (QuasiCompact D.u0))
  haveI hiqs : QuasiSeparated (Limits.pullback.fst D.f D.u0) := by
    first
    | infer_instance
    | exact MorphismProperty.pullback_fst (P := @QuasiSeparated) _ _
        (inferInstanceAs (QuasiSeparated D.u0))
  haveI hfst1 : QuasiCompact (Limits.pullback.fst V₀.hom D.f) := by
    first
    | exact MorphismProperty.pullback_fst (P := @QuasiCompact) _ _ (inferInstanceAs (QuasiCompact D.f))
    | exact MorphismProperty.IsStableUnderBaseChange.fst _ _ (inferInstanceAs (QuasiCompact D.f))
    | infer_instance
  haveI hfst2 : QuasiSeparated (Limits.pullback.fst V₀.hom D.f) := by
    first
    | exact MorphismProperty.pullback_fst (P := @QuasiSeparated) _ _
        (inferInstanceAs (QuasiSeparated D.f))
    | exact MorphismProperty.IsStableUnderBaseChange.fst _ _ (inferInstanceAs (QuasiSeparated D.f))
    | infer_instance
  have key : ∀ {X Y : Scheme.{u}} (g : X ⟶ Y), QuasiCompact g → QuasiSeparated g →
      CompactSpace Y → QuasiSeparatedSpace Y → CompactSpace X ∧ QuasiSeparatedSpace X :=
    fun g _ _ _ _ => ⟨QuasiCompact.compactSpace_of_compactSpace g,
      quasiSeparatedSpace_of_quasiSeparated g⟩
  obtain ⟨h1, h2⟩ := key (Limits.pullback.fst V₀.hom D.f) hfst1 hfst2 hV1 hV2
  have h1' : CompactSpace ((wcProEtPullback D.f).obj V₀).left := h1
  have h2' : QuasiSeparatedSpace ((wcProEtPullback D.f).obj V₀).left := h2
  have hfst3 : QuasiCompact
      (Limits.pullback.fst ((wcProEtPullback D.f).obj V₀).hom (Limits.pullback.fst D.f D.u0)) := by
    first
    | exact MorphismProperty.pullback_fst (P := @QuasiCompact) _ _ hiqc
    | exact MorphismProperty.IsStableUnderBaseChange.fst _ _ hiqc
    | infer_instance
  have hfst4 : QuasiSeparated
      (Limits.pullback.fst ((wcProEtPullback D.f).obj V₀).hom (Limits.pullback.fst D.f D.u0)) := by
    first
    | exact MorphismProperty.pullback_fst (P := @QuasiSeparated) _ _ hiqs
    | exact MorphismProperty.IsStableUnderBaseChange.fst _ _ hiqs
    | infer_instance
  obtain ⟨h3, h4⟩ := key
    (Limits.pullback.fst ((wcProEtPullback D.f).obj V₀).hom (Limits.pullback.fst D.f D.u0))
    hfst3 hfst4 h1' h2'
  exact ⟨h1', h2', h3, h4⟩

theorem wc_pencil_PL_sp_zmod_finite (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (D : wcLefschetzDatum F' F'' Y n)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'') (V₀ : (wcP1Over F'').left.ProEt)
    (A₀ : Type u) [CommRing A₀] [HenselianLocalRing A₀]
    [IsSepClosed (IsLocalRing.ResidueField A₀)] (e₀ : V₀.left ≅ Spec (.of A₀))
    (E : (wcP1Over F'').left.ProEt) (L : Type u) [Field L] [IsSepClosed L]
    (eE : E.left ≅ Spec (.of L)) (k j : ℕ) (hk : 1 ≤ k) :
    Finite (wcZModProEtExt ((wcProEtPullback D.f).obj V₀).left (ℓ ^ k) j) ∧
      Finite (wcZModProEtExt ((wcProEtPullback D.f).obj E).left (ℓ ^ k) j) :=
by
  classical
  haveI := D.proper
  haveI hpsep : IsSeparated (wcP1Over F'').hom := by
    show IsSeparated (Proj.toSpecZero _ ≫ Spec.map _)
    infer_instance
  haveI : IsProper (D.f ≫ (wcP1Over F'').hom) := by rw [D.hf]; infer_instance
  haveI hfp : IsProper D.f := IsProper.of_comp D.f (wcP1Over F'').hom

  have s1 : ∀ (K : Type u) [Field K] [IsSepClosed K] (Z : Scheme.{u})
      (f : Z ⟶ Spec (.of K)) [IsProper f] (m : ℕ), (m : K) ≠ 0 →
      ∀ i : ℕ, Finite (wcEtCoh Z m i) := by
    intro K _ _ Z f _ m hm i
    let e : K →+* AlgebraicClosure K := algebraMap K (AlgebraicClosure K)
    have hm' : (m : AlgebraicClosure K) ≠ 0 := by
      intro h0
      apply hm
      apply e.injective
      rw [map_natCast, map_zero]
      exact h0
    obtain ⟨Dp⟩ := wc_et_zmod_pull_data_exists
      (Limits.pullback.fst f (Spec.map (CommRingCat.ofHom e))) m
    have hb := wc_et_sepclosed_field_ext_proper_pull_bij K (AlgebraicClosure K) e Z f _
      (Limits.pullback.fst f (Spec.map (CommRingCat.ofHom e)))
      (Limits.pullback.snd f (Spec.map (CommRingCat.ofHom e)))
      (IsPullback.of_hasPullback _ _) m hm Dp i
    have hP := wc_etale_proper_finite (AlgebraicClosure K) _
      (Limits.pullback.snd f (Spec.map (CommRingCat.ofHom e))) m hm' i
    obtain ⟨eP⟩ := wc_et_zmodext_coh_equiv
      (Limits.pullback f (Spec.map (CommRingCat.ofHom e))) m i
    haveI : Finite (wcEtZModExt (Limits.pullback f (Spec.map (CommRingCat.ofHom e))) m i) :=
      Finite.of_equiv _ eP.symm
    haveI : Finite (wcEtZModExt Z m i) := Finite.of_injective _ hb.1
    obtain ⟨eY⟩ := wc_et_zmodext_coh_equiv Z m i
    exact Finite.of_equiv _ eY

  have s3 : ∀ (X : Scheme.{u}) [CompactSpace X] [QuasiSeparatedSpace X] (m i : ℕ),
      Finite (wcEtCoh X m i) → Finite (wcZModProEtExt X m i) := by
    intro X _ _ m i hX
    obtain ⟨Θ, hΘ, -⟩ := wc_zmod_et_proet_natural_comparison_all.{u} m i
    obtain ⟨eX⟩ := wc_et_zmodext_coh_equiv X m i
    haveI : Finite (wcEtZModExt X m i) := Finite.of_equiv _ eX.symm
    exact Finite.of_surjective (Θ X) (hΘ X inferInstance inferInstance).2

  have hmF : ((ℓ ^ k : ℕ) : F'') ≠ 0 := by
    intro h0
    haveI := Fintype.ofFinite F''
    obtain ⟨p, hp⟩ := CharP.exists F''
    haveI := hp
    have hpp : p.Prime := CharP.char_is_prime F'' p
    have h1 : p ∣ ℓ ^ k := (CharP.cast_eq_zero_iff F'' p _).mp h0
    have h2 : p ∣ ℓ := hpp.dvd_of_dvd_pow h1
    have h3 : p = ℓ := (Nat.prime_dvd_prime_iff_eq hpp Fact.out).mp h2
    have h4 : p ∣ Fintype.card F'' :=
      (CharP.cast_eq_zero_iff F'' p _).mp (FiniteField.cast_card_eq_zero F'')
    apply hℓ
    rw [← h3, Nat.card_eq_fintype_card]
    exact h4
  have s2 : ∀ (K : Type u) [Field K] (c : Spec (.of K) ⟶ Spec (.of F'')),
      ((ℓ ^ k : ℕ) : K) ≠ 0 := by
    intro K _ c h0
    apply hmF
    apply (Spec.preimage c).hom.injective
    rw [map_natCast, map_zero]
    exact h0
  have hm0 : ℓ ^ k ≠ 0 := pow_ne_zero _ (Fact.out : ℓ.Prime).ne_zero
  obtain ⟨g₀, hg₀⟩ : ∃ g : ((wcProEtPullback D.f).obj V₀).left ⟶ Spec (.of A₀), IsProper g :=
    ⟨_, (inferInstance : IsProper (Limits.pullback.fst V₀.hom D.f ≫ e₀.hom))⟩
  obtain ⟨gE, hgE⟩ : ∃ g : ((wcProEtPullback D.f).obj E).left ⟶ Spec (.of L), IsProper g :=
    ⟨_, (inferInstance : IsProper (Limits.pullback.fst E.hom D.f ≫ eE.hom))⟩
  haveI := hg₀
  haveI := hgE
  obtain ⟨hc1, hq1, -, -⟩ := wc_pencil_nbhd_qcqs F' F'' Y n D V₀ A₀ e₀
  obtain ⟨hc2, hq2, -, -⟩ := wc_pencil_nbhd_qcqs F' F'' Y n D E L eE
  haveI := hc1
  haveI := hq1
  haveI := hc2
  haveI := hq2
  have hκ := s2 (IsLocalRing.ResidueField A₀)
    (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A₀)) ≫ e₀.inv ≫ V₀.hom ≫
      (wcP1Over F'').hom)
  have hL := s2 L (eE.inv ≫ E.hom ≫ (wcP1Over F'').hom)
  refine ⟨?_, ?_⟩
  · have hWs := s1 (IsLocalRing.ResidueField A₀) _
      (Limits.pullback.snd g₀ (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A₀))))
      (ℓ ^ k) hκ j
    obtain ⟨E₁⟩ := wc_et_henselian_closed_fibre_coh A₀ _ g₀ (ℓ ^ k) hm0
      wc_et_henselian_proper_vanishing j
    haveI := hWs
    exact s3 _ (ℓ ^ k) j (Finite.of_equiv _ E₁.symm)
  · exact s3 _ (ℓ ^ k) j (s1 L _ gE (ℓ ^ k) hL j)

theorem wc_P1_strict_local_geomPoint_map (K : Type u) [Field K] [Finite K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (V : (wcP1Over K).left.ProEt) (A : Type u) [CommRing A] [HenselianLocalRing A]
    [IsSepClosed (IsLocalRing.ResidueField A)] (e : V.left ≅ Spec (.of A)) :
    Nonempty (V ⟶ wcGeomPoint K (wcP1Over K) hP) :=
by
  classical

  haveI hsub : Subsingleton ↥(Spec (CommRingCat.of K)) :=
    inferInstanceAs (Subsingleton (PrimeSpectrum K))
  have hπ : (wcP1Over K).hom (V.hom (e.inv (IsLocalRing.closedPoint A))) =
      (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))
        (IsLocalRing.closedPoint (AlgebraicClosure K)) := Subsingleton.elim _ _
  obtain ⟨p, hp1, -⟩ := Scheme.Pullback.exists_preimage_pullback _ _ hπ
  have hp : (wcGeomPoint K (wcP1Over K) hP).hom p = V.hom (e.inv (IsLocalRing.closedPoint A)) :=
    hp1

  obtain ⟨t, ht1, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := V.hom)
    (g := (wcGeomPoint K (wcP1Over K) hP).hom) (e.inv (IsLocalRing.closedPoint A)) p hp.symm
  have hq : WeaklyEtale (Limits.pullback.fst V.hom (wcGeomPoint K (wcP1Over K) hP).hom) :=
    MorphismProperty.of_isPullback (P := @WeaklyEtale)
      (IsPullback.of_hasPullback V.hom (wcGeomPoint K (wcP1Over K) hP).hom).flip
      (wcGeomPoint K (wcP1Over K) hP).prop

  haveI : WeaklyEtale (Limits.pullback.fst V.hom (wcGeomPoint K (wcP1Over K) hP).hom) := hq
  haveI : WeaklyEtale ((Limits.pullback V.hom (wcGeomPoint K (wcP1Over K) hP).hom).fromSpecStalk t) :=
    wc_fromSpecStalk_weaklyEtale _ t
  obtain ⟨k, hkdef⟩ : ∃ k, k =
      (Limits.pullback V.hom (wcGeomPoint K (wcP1Over K) hP).hom).fromSpecStalk t ≫
      Limits.pullback.fst V.hom (wcGeomPoint K (wcP1Over K) hP).hom ≫ e.hom := ⟨_, rfl⟩
  have hk : WeaklyEtale k := by rw [hkdef]; infer_instance
  have hφ : Spec.map (Spec.preimage k) = k := Spec.map_preimage k
  have hk' : WeaklyEtale (Spec.map (CommRingCat.ofHom (Spec.preimage k).hom)) := by
    change WeaklyEtale (Spec.map (Spec.preimage k))
    rw [hφ]; exact hk
  letI := (Spec.preimage k).hom.toAlgebra
  have hWE := wc_lpkt_specMap_weaklyEtale_ring _ _ (Spec.preimage k).hom hk'
  have hk_pt : k (IsLocalRing.closedPoint
      ((Limits.pullback V.hom (wcGeomPoint K (wcP1Over K) hP).hom).presheaf.stalk t)) =
      IsLocalRing.closedPoint A := by
    have h1 : k (IsLocalRing.closedPoint
        ((Limits.pullback V.hom (wcGeomPoint K (wcP1Over K) hP).hom).presheaf.stalk t)) =
        e.hom ((Limits.pullback.fst V.hom (wcGeomPoint K (wcP1Over K) hP).hom)
          ((Limits.pullback V.hom (wcGeomPoint K (wcP1Over K) hP).hom).fromSpecStalk t
          (IsLocalRing.closedPoint
            ((Limits.pullback V.hom (wcGeomPoint K (wcP1Over K) hP).hom).presheaf.stalk t)))) := by
      subst hkdef
      first | rfl | simp [Scheme.Hom.comp_apply]
    have h2 : ∀ y : Spec (CommRingCat.of A), e.hom (e.inv y) = y := by
      intro y
      first
        | simp
        | (rw [← Scheme.Hom.comp_apply, e.inv_hom_id]; rfl)
        | exact congrArg (fun f : Spec (CommRingCat.of A) ⟶ Spec (CommRingCat.of A) => f y) e.inv_hom_id
    rw [h1, Scheme.fromSpecStalk_closedPoint, ht1]
    first
      | exact h2 _
      | simp
      | exact congrArg (fun f : Spec (CommRingCat.of A) ⟶ Spec (CommRingCat.of A) => f _) e.inv_hom_id
  have hcomap : PrimeSpectrum.comap (Spec.preimage k).hom
      (IsLocalRing.closedPoint
        ((Limits.pullback V.hom (wcGeomPoint K (wcP1Over K) hP).hom).presheaf.stalk t)) =
      IsLocalRing.closedPoint A := by
    have h5 : (Spec.map (Spec.preimage k))
        (IsLocalRing.closedPoint
          ((Limits.pullback V.hom (wcGeomPoint K (wcP1Over K) hP).hom).presheaf.stalk t)) =
        PrimeSpectrum.comap (Spec.preimage k).hom
          (IsLocalRing.closedPoint
            ((Limits.pullback V.hom (wcGeomPoint K (wcP1Over K) hP).hom).presheaf.stalk t)) := by
      first | rfl | simp [Spec.map_base]
    rw [← h5, hφ]
    exact hk_pt
  have hloc : IsLocalHom (Spec.preimage k).hom :=
    (IsLocalRing.isLocalHom_iff_comap_closedPoint (Spec.preimage k).hom).mpr hcomap
  have hbij : Function.Bijective (Spec.preimage k).hom :=
    wc_olivier _ _ inferInstance inferInstance hloc hWE
  haveI : IsIso (Spec.preimage k) := (ConcreteCategory.isIso_iff_bijective _).mpr hbij
  haveI hkiso : IsIso k := by
    rw [← hφ]; infer_instance

  have hcq : (Limits.pullback V.hom (wcGeomPoint K (wcP1Over K) hP).hom).fromSpecStalk t ≫
      Limits.pullback.fst V.hom (wcGeomPoint K (wcP1Over K) hP).hom = k ≫ e.inv := by
    rw [hkdef]; simp
  obtain ⟨s, hs⟩ : ∃ s : V.left ⟶ Limits.pullback V.hom (wcGeomPoint K (wcP1Over K) hP).hom,
      s ≫ Limits.pullback.fst V.hom (wcGeomPoint K (wcP1Over K) hP).hom = 𝟙 _ :=
    ⟨e.hom ≫ inv k ≫ (Limits.pullback V.hom (wcGeomPoint K (wcP1Over K) hP).hom).fromSpecStalk t, by
      rw [Category.assoc, Category.assoc, hcq, IsIso.inv_hom_id_assoc, Iso.hom_inv_id]⟩
  have hh : (s ≫ Limits.pullback.snd V.hom (wcGeomPoint K (wcP1Over K) hP).hom) ≫
      (wcGeomPoint K (wcP1Over K) hP).hom = V.hom := by
    rw [Category.assoc, ← Limits.pullback.condition, ← Category.assoc, hs, Category.id_comp]
  exact ⟨MorphismProperty.Over.homMk
    (s ≫ Limits.pullback.snd V.hom (wcGeomPoint K (wcP1Over K) hP).hom) hh trivial⟩

theorem wc_ext_pull_inj_of_post_bij_ext_acyclic_trunc : ∀ {C : Type*} {D : Type*} [Category C] [Category D] [Abelian C] [Abelian D] (L : D ⥤ C) (R : C ⥤ D) [L.Additive] [Limits.PreservesFiniteLimits L] [Limits.PreservesFiniteColimits L] [R.Additive] (adj : L ⊣ R) (A : D) (B : C) (μ : L.obj A ≅ B), letI := HasExt.standard C; letI := HasExt.standard D; (∀ k : ℕ, Function.Bijective (fun x : Abelian.Ext A A k => x.comp (Abelian.Ext.mk₀ (adj.unit.app A ≫ R.map μ.hom)) (add_zero k))) → ∀ (I : InjectiveResolution B) (N : ℕ), (∀ q : ℕ, 1 ≤ q → q + 1 ≤ N → ∀ p : ℕ, Subsingleton (Abelian.Ext A (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q) p)) → Function.Injective (((Abelian.Ext.mk₀ μ.inv).precomp _ (zero_add N)).comp (((Abelian.Ext.mk₀ μ.hom).postcomp _ (add_zero N)).comp (L.mapExtAddHom A A N))) :=
by
  intro C D _ _ _ _ L R _ _ _ _ adj A B μ H1 I N H2
  letI instC : HasExt C := HasExt.standard C
  letI instD : HasExt D := HasExt.standard D
  haveI := adj.rightAdjoint_preservesLimits
  haveI : L.PreservesMonomorphisms := inferInstance

  have c1 : ∀ (X : D) (S : ShortComplex D), S.ShortExact → ∀ p : ℕ,
      (∀ p' : ℕ, p = p' + 1 → Subsingleton (Abelian.Ext X S.X₃ p')) →
      Function.Injective (fun x : Abelian.Ext X S.X₁ p =>
        x.comp (Abelian.Ext.mk₀ S.f) (add_zero p)) := by
    intro X S hS p h3
    haveI := hS.mono_f
    have hb : Function.Injective ((Abelian.Ext.mk₀ S.f).postcomp X (add_zero p)) := by
      rw [injective_iff_map_eq_zero]
      intro x hx
      cases p with
      | zero =>
        obtain ⟨a, rfl⟩ := (Abelian.Ext.mk₀_bijective X S.X₁).2 x
        have h0 : a ≫ S.f = 0 := by
          apply (Abelian.Ext.mk₀_bijective X S.X₂).1
          rw [Abelian.Ext.mk₀_zero, ← Abelian.Ext.mk₀_comp_mk₀]
          exact hx
        have ha : a = 0 := by
          rw [← cancel_mono S.f, h0, Limits.zero_comp]
        rw [ha, Abelian.Ext.mk₀_zero]
      | succ k =>
        haveI := h3 k rfl
        obtain ⟨x₃, hx₃⟩ := Abelian.Ext.covariant_sequence_exact₁ X hS x hx rfl
        rw [← hx₃, Subsingleton.elim x₃ 0, Abelian.Ext.zero_comp]
    exact hb

  have c2 : ∀ n : ℕ, Nonempty (Limits.cokernel (R.map (Limits.kernel.lift
      (I.cocomplex.d (n + 1) (n + 2)) (I.cocomplex.d n (n + 1))
      (I.cocomplex.d_comp_d n (n + 1) (n + 2)))) ≅
      ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology (n + 1)) := by
    intro n
    let ψ₁ : R.obj (Limits.kernel (I.cocomplex.d (n + 1) (n + 2))) ≅
        Limits.kernel (R.map (I.cocomplex.d (n + 1) (n + 2))) :=
      Limits.PreservesKernel.iso R _
    have hψ₁ : ψ₁.hom ≫ Limits.kernel.ι (R.map (I.cocomplex.d (n + 1) (n + 2))) =
        R.map (Limits.kernel.ι (I.cocomplex.d (n + 1) (n + 2))) := by
      simp only [ψ₁, Limits.PreservesKernel.iso_hom, Limits.kernelComparison_comp_ι]
    let ψ₂ :=
      Limits.IsLimit.conePointUniqueUpToIso
        (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).cyclesIsKernel
          (n + 1) (n + 2) (by simp))
        (Limits.kernelIsKernel (R.map (I.cocomplex.d (n + 1) (n + 2))))
    have hψ₂ : ψ₂.inv ≫ ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).iCycles
        (n + 1) = Limits.kernel.ι (R.map (I.cocomplex.d (n + 1) (n + 2))) :=
      Limits.IsLimit.conePointUniqueUpToIso_inv_comp
        (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).cyclesIsKernel
          (n + 1) (n + 2) (by simp))
        (Limits.kernelIsKernel (R.map (I.cocomplex.d (n + 1) (n + 2))))
        Limits.WalkingParallelPair.zero
    have hφ : (ψ₁ ≪≫ ψ₂.symm).hom ≫
        ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).iCycles (n + 1) =
        R.map (Limits.kernel.ι (I.cocomplex.d (n + 1) (n + 2))) := by
      rw [Iso.trans_hom, Iso.symm_hom, Category.assoc, hψ₂, hψ₁]
    have claim : R.map (Limits.kernel.lift (I.cocomplex.d (n + 1) (n + 2)) (I.cocomplex.d n (n + 1))
        (I.cocomplex.d_comp_d n (n + 1) (n + 2))) ≫ (ψ₁ ≪≫ ψ₂.symm).hom =
        ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).toCycles n (n + 1) := by
      rw [← cancel_mono (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).iCycles
        (n + 1)), Category.assoc, hφ, ← R.map_comp, Limits.kernel.lift_ι,
        HomologicalComplex.toCycles_i]
      all_goals rfl
    exact ⟨(Limits.cokernelCompIsIso _ (ψ₁ ≪≫ ψ₂.symm).hom).symm ≪≫ Limits.cokernelIsoOfEq claim ≪≫
      Limits.IsColimit.coconePointUniqueUpToIso (Limits.cokernelIsCokernel _)
        (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homologyIsCokernel
          n (n + 1) (by simp))⟩

  have c3 : ∀ {T : ShortComplex D} (hT : T.ShortExact) {S : ShortComplex C} (hS : S.ShortExact)
      (φ : T.map L ⟶ S) {X : D} (m : ℕ) (z : Abelian.Ext X T.X₃ m),
      (Abelian.Ext.mapExactFunctor L (z.comp hT.extClass rfl)).comp (Abelian.Ext.mk₀ φ.τ₁)
        (add_zero (m + 1)) =
      ((Abelian.Ext.mapExactFunctor L z).comp (Abelian.Ext.mk₀ φ.τ₃) (add_zero m)).comp
        hS.extClass rfl := by
    intro T hT S hS φ X m z
    have h₁ : (T.map L).ShortExact := hT.map_of_exact L
    have hnat : h₁.extClass.comp (Abelian.Ext.mk₀ φ.τ₁) (add_zero 1) =
        (Abelian.Ext.mk₀ φ.τ₃).comp hS.extClass (zero_add 1) :=
      h₁.extClass_naturality hS φ
    rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_extClass,
      Abelian.Ext.comp_assoc _ _ _ rfl (add_zero 1) (by omega),
      Abelian.Ext.comp_assoc _ _ _ (add_zero m) (zero_add 1) (by omega), hnat]

  let τ : ∀ (Y : C) (m : ℕ), Abelian.Ext A (R.obj Y) m →+ Abelian.Ext (L.obj A) Y m :=
    fun Y m => AddMonoidHom.mk'
      (fun α => (Abelian.Ext.mapExactFunctor L α).comp (Abelian.Ext.mk₀ (adj.counit.app Y))
        (add_zero m))
      (fun a b => by rw [Abelian.Ext.mapExactFunctor_add, Abelian.Ext.add_comp])
  have hτ : ∀ (Y : C) (m : ℕ) (α : Abelian.Ext A (R.obj Y) m),
      τ Y m α = (Abelian.Ext.mapExactFunctor L α).comp (Abelian.Ext.mk₀ (adj.counit.app Y))
        (add_zero m) := fun _ _ _ => rfl

  have s1a : ∀ {Y Y' : C} (g : Y ⟶ Y') (m : ℕ) (v : Abelian.Ext A (R.obj Y) m),
      τ Y' m (v.comp (Abelian.Ext.mk₀ (R.map g)) (add_zero m)) =
        (τ Y m v).comp (Abelian.Ext.mk₀ g) (add_zero m) := by
    intro Y Y' g m v
    have e1 : L.map (R.map g) ≫ adj.counit.app Y' = adj.counit.app Y ≫ g :=
      adj.counit_naturality g
    rw [hτ, hτ, Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
      Abelian.Ext.comp_assoc _ _ _ (add_zero m) (zero_add 0) (by omega),
      Abelian.Ext.mk₀_comp_mk₀, e1,
      Abelian.Ext.comp_assoc _ _ _ (add_zero m) (zero_add 0) (by omega),
      Abelian.Ext.mk₀_comp_mk₀]

  have base : ∀ Y : C, Function.Bijective (τ Y 0) := by
    intro Y
    have e : ⇑(τ Y 0) = fun x =>
        Abelian.Ext.mk₀ ((adj.homEquiv A Y).symm (Abelian.Ext.homEquiv₀ x)) := by
      funext x
      conv_lhs => rw [← Abelian.Ext.mk₀_homEquiv₀_apply x]
      rw [hτ, Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mk₀_comp_mk₀,
        Adjunction.homEquiv_counit]
    rw [e]
    exact (Abelian.Ext.mk₀_bijective _ _).comp
      ((adj.homEquiv A Y).symm.bijective.comp Abelian.Ext.homEquiv₀.bijective)

  have postD : ∀ {X Y Y' : D} (ψ : Y ≅ Y') (n : ℕ),
      Function.Bijective (fun x : Abelian.Ext X Y n => x.comp (Abelian.Ext.mk₀ ψ.hom) (add_zero n)) := by
    intro X Y Y' ψ n
    rw [Function.bijective_iff_has_inverse]
    refine ⟨fun x => x.comp (Abelian.Ext.mk₀ ψ.inv) (add_zero n), fun x => ?_, fun x => ?_⟩
    · dsimp only
      rw [Abelian.Ext.comp_assoc _ _ _ (add_zero n) (zero_add 0) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
    · dsimp only
      rw [Abelian.Ext.comp_assoc _ _ _ (add_zero n) (zero_add 0) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.comp_mk₀_id]
  have preC : ∀ {X X' Y : C} (φ : X' ≅ X) (n : ℕ),
      Function.Bijective (fun x : Abelian.Ext X Y n => (Abelian.Ext.mk₀ φ.hom).comp x (zero_add n)) := by
    intro X X' Y φ n
    rw [Function.bijective_iff_has_inverse]
    refine ⟨fun x => (Abelian.Ext.mk₀ φ.inv).comp x (zero_add n), fun x => ?_, fun x => ?_⟩
    · dsimp only
      rw [← Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add n) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.mk₀_id_comp]
    · dsimp only
      rw [← Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add n) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.mk₀_id_comp]

  obtain ⟨Y, f, g, w, hS, hRSex, hRf, hQ, ⟨e⟩⟩ : ∃ (Y : ℕ → C) (f : ∀ n, Y n ⟶ I.cocomplex.X n)
      (g : ∀ n, I.cocomplex.X n ⟶ Y (n + 1)) (w : ∀ n, f n ≫ g n = 0),
      (∀ n, (ShortComplex.mk (f n) (g n) (w n)).ShortExact) ∧
      (∀ n, ((ShortComplex.mk (f n) (g n) (w n)).map R).Exact) ∧
      (∀ n, Mono (R.map (f n))) ∧
      (∀ n p, n + 2 ≤ N → Subsingleton (Abelian.Ext A (Limits.cokernel (R.map (g n))) p)) ∧
      Nonempty (B ≅ Y 0) := by
    have hw : ∀ n, Limits.kernel.ι (I.cocomplex.d n (n + 1)) ≫
        Limits.kernel.lift (I.cocomplex.d (n + 1) (n + 2)) (I.cocomplex.d n (n + 1))
          (I.cocomplex.d_comp_d n (n + 1) (n + 2)) = 0 := by
      intro n
      rw [← cancel_mono (Limits.kernel.ι (I.cocomplex.d (n + 1) (n + 2))), Category.assoc,
        Limits.kernel.lift_ι, Limits.zero_comp]
      exact Limits.kernel.condition _
    have hSE : ∀ n, (ShortComplex.mk (Limits.kernel.ι (I.cocomplex.d n (n + 1)))
        (Limits.kernel.lift (I.cocomplex.d (n + 1) (n + 2)) (I.cocomplex.d n (n + 1))
