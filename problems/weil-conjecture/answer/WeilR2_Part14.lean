      Spec.map (CommRingCat.ofHom (Subring.inclusion (hΛ hT))) := by
    rw [← Category.assoc, hπUf, hπ.w, Category.assoc, hsub]
  obtain ⟨ρ, hρ1, hρ2⟩ : ∃ ρ : X ⟶ Limits.pullback (U₀.ι ≫ f')
        (Spec.map (CommRingCat.ofHom (Subring.inclusion (hΛ hT)))),
      ρ ≫ Limits.pullback.fst _ _ = πU ∧
      ρ ≫ Limits.pullback.snd _ _ = f ≫ Spec.map (CommRingCat.ofHom (Λ T).subtype) :=
    ⟨Limits.pullback.lift _ _ hρw, Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
  have hjφ : Spec.map (CommRingCat.ofHom j) ≫ Spec.map (CommRingCat.ofHom (Λ T).subtype) =
      Spec.map (CommRingCat.ofHom φ) ≫
        Spec.map (CommRingCat.ofHom (algebraMap ↥(Λ T) (FractionRing ↥(Λ T)))) := by
    rw [← Spec.map_comp, ← Spec.map_comp, ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp, hφ]
  have hnw : (Limits.pullback.fst f (Spec.map (CommRingCat.ofHom j)) ≫ ρ) ≫
      Limits.pullback.snd (U₀.ι ≫ f') (Spec.map (CommRingCat.ofHom (Subring.inclusion (hΛ hT)))) =
      (Limits.pullback.snd f (Spec.map (CommRingCat.ofHom j)) ≫ Spec.map (CommRingCat.ofHom φ)) ≫
        Spec.map (CommRingCat.ofHom (algebraMap ↥(Λ T) (FractionRing ↥(Λ T)))) := by
    simp only [Category.assoc]
    rw [hρ2, Limits.pullback.condition_assoc, hjφ]
  obtain ⟨n, hn1, hn2⟩ : ∃ n : Limits.pullback f (Spec.map (CommRingCat.ofHom j)) ⟶
      Limits.pullback (Limits.pullback.snd (U₀.ι ≫ f')
        (Spec.map (CommRingCat.ofHom (Subring.inclusion (hΛ hT)))))
        (Spec.map (CommRingCat.ofHom (algebraMap ↥(Λ T) (FractionRing ↥(Λ T))))),
      n ≫ Limits.pullback.fst _ _ = Limits.pullback.fst f (Spec.map (CommRingCat.ofHom j)) ≫ ρ ∧
      n ≫ Limits.pullback.snd _ _ =
        Limits.pullback.snd f (Spec.map (CommRingCat.ofHom j)) ≫ Spec.map (CommRingCat.ofHom φ) :=
    ⟨Limits.pullback.lift _ _ hnw, Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
  have hnr : n ≫ rr = mT := by
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, hrr1, reassoc_of% hn1, reassoc_of% hρ1, hπUf, hm1]
    · rw [Category.assoc, hrr2, hn2, hm2]
  obtain ⟨i, hi⟩ := wc_fnr_torsor_pullback_paste p pT jP mT hjP rr n hnr qW
    (Limits.pullback.fst _ _) iW hiW (Limits.pullback.fst f (Spec.map (CommRingCat.ofHom j))) ρ
    hn1.symm
  obtain ⟨β', hβ'⟩ := wc_fet_torsor_base_change qW ρ ℓ β hY
  exact ⟨Limits.pullback qW ρ, Limits.pullback.snd qW ρ, β', i, hβ', hi⟩

theorem wc_int_module_finite_of_local_span : ∀ (D : Type u) [CommRing D] (M : Type u) [AddCommGroup M] [Module D M], (∀ m : Ideal D, m.IsMaximal → ∃ r ∉ m, ∃ S : Finset M, ∀ z : M, ∃ N : ℕ, r ^ N • z ∈ Submodule.span D (S : Set M)) → Module.Finite D M :=
by
  classical
  intro D _ M _ _ H
  set R0 : Set D := {r | ∃ S : Finset M, ∀ z : M, ∃ N : ℕ,
    r ^ N • z ∈ Submodule.span D (S : Set M)} with hR0
  have hspan : Ideal.span R0 = ⊤ := by
    by_contra h
    obtain ⟨m, hm, hle⟩ := Ideal.exists_le_maximal _ h
    obtain ⟨r, hr, S, hS⟩ := H m hm
    exact hr (hle (Ideal.subset_span ⟨S, hS⟩))
  obtain ⟨s', hs'sub, hs'span⟩ := (Ideal.span_eq_top_iff_finite R0).mp hspan
  have hw : ∀ r ∈ s', ∃ S : Finset M, ∀ z : M, ∃ N : ℕ,
      r ^ N • z ∈ Submodule.span D (S : Set M) :=
    fun r hr => hs'sub hr
  choose f hf using hw
  let T : Finset M := s'.attach.biUnion (fun r => f r.1 r.2)
  have hsub : ∀ (r : D) (hr : r ∈ s'), ((f r hr : Finset M) : Set M) ⊆ (T : Set M) := by
    intro r hr x hx
    have hx' : x ∈ f r hr := hx
    show x ∈ T
    exact Finset.mem_biUnion.mpr ⟨⟨r, hr⟩, Finset.mem_attach _ _, hx'⟩
  have hT : Submodule.span D (T : Set M) = ⊤ := by
    rw [Submodule.eq_top_iff']
    intro z
    apply Submodule.mem_of_span_eq_top_of_smul_pow_mem _ (s' : Set D) hs'span z
    intro r
    have hr : r.1 ∈ s' := r.2
    obtain ⟨N, hN⟩ := hf r.1 hr z
    exact ⟨N, Submodule.span_mono (hsub r.1 hr) hN⟩
  exact Module.finite_def.mpr ⟨T, hT⟩

theorem wc_int_ft_maximal_contains_prime : ∀ (D : Type u) [CommRing D] [Algebra.FiniteType ℤ D] (m : Ideal D), m.IsMaximal → ∃ p : ℕ, p.Prime ∧ (p : D) ∈ m :=
by
  intro D _ _ m hm
  haveI hJ : IsJacobsonRing ℤ := by
    rw [isJacobsonRing_iff_prime_eq]
    intro P hP
    rcases (Ideal.isPrime_int_iff.mp hP) with h | ⟨p, hp, h⟩
    · subst h
      apply le_antisymm _ Ideal.le_jacobson
      intro x hx
      have hu := (Ideal.mem_jacobson_bot.mp hx) x
      rw [Int.isUnit_iff] at hu
      rw [Ideal.mem_bot]
      rcases hu with h1 | h1
      · have : x * x = 0 := by linarith
        exact mul_self_eq_zero.mp this
      · nlinarith [mul_self_nonneg x]
    · subst h
      haveI : Fact p.Prime := ⟨hp⟩
      exact Ideal.jacobson_eq_self_of_isMaximal
  letI : Field (D ⧸ m) := Ideal.Quotient.field m
  haveI : Algebra.FiniteType ℤ (D ⧸ m) :=
    Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ ℤ m) (Ideal.Quotient.mkₐ_surjective ℤ m)
  haveI : Module.Finite ℤ (D ⧸ m) := finite_of_finite_type_of_isJacobsonRing ℤ (D ⧸ m)
  haveI : Algebra.IsIntegral ℤ (D ⧸ m) := Algebra.IsIntegral.of_finite ℤ (D ⧸ m)
  haveI : (⊥ : Ideal (D ⧸ m)).IsMaximal := Ideal.bot_isMaximal
  have hM : (Ideal.under ℤ (⊥ : Ideal (D ⧸ m))).IsMaximal := Ideal.IsMaximal.under ℤ ⊥
  rcases Ideal.isPrime_int_iff.mp hM.isPrime with h | ⟨p, hp, h⟩
  · exact absurd h (Ring.ne_bot_of_isMaximal_of_not_isField hM Int.not_isField)
  · refine ⟨p, hp, ?_⟩
    have h1 : ((p : ℕ) : ℤ) ∈ Ideal.under ℤ (⊥ : Ideal (D ⧸ m)) := by
      rw [h]; exact Ideal.mem_span_singleton_self _
    rw [Ideal.under_def, Ideal.mem_comap, Ideal.mem_bot, map_natCast] at h1
    rw [← Ideal.Quotient.eq_zero_iff_mem, map_natCast]
    exact h1

theorem wc_int_fibre_noether_normalization : ∀ (D : Type u) [CommRing D] [Algebra.FiniteType ℤ D] (p : ℕ), p.Prime → Ideal.span {(p : D)} ≠ ⊤ → ∃ (e : ℕ) (y : Fin e → D), (∀ f : MvPolynomial (Fin e) ℤ, MvPolynomial.aeval y f ∈ Ideal.span {(p : D)} → MvPolynomial.map (Int.castRingHom (ZMod p)) f = 0) ∧ (letI := (MvPolynomial.aeval (R := ℤ) y).toRingHom.toAlgebra; Module.Finite (MvPolynomial (Fin e) ℤ) (D ⧸ Ideal.span {(p : D)})) :=
by
  intro D _ _ p hp hne
  classical
  haveI : Fact p.Prime := ⟨hp⟩
  haveI : Nontrivial (D ⧸ Ideal.span {(p : D)}) := Ideal.Quotient.nontrivial_iff.mpr hne
  have h0 : ((p : ℕ) : D ⧸ Ideal.span {(p : D)}) = 0 := by
    rw [← map_natCast (Ideal.Quotient.mk (Ideal.span {(p : D)})) p]
    exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _)
  haveI : CharP (D ⧸ Ideal.span {(p : D)}) p := (CharP.charP_iff_prime_eq_zero hp).mpr h0
  letI : Algebra (ZMod p) (D ⧸ Ideal.span {(p : D)}) := ZMod.algebra (D ⧸ Ideal.span {(p : D)}) p
  haveI : Algebra.FiniteType ℤ (D ⧸ Ideal.span {(p : D)}) := inferInstance
  haveI : IsScalarTower ℤ (ZMod p) (D ⧸ Ideal.span {(p : D)}) := AddCommGroup.intIsScalarTower
  haveI : Algebra.FiniteType (ZMod p) (D ⧸ Ideal.span {(p : D)}) :=
    Algebra.FiniteType.of_restrictScalars_finiteType ℤ (ZMod p) (D ⧸ Ideal.span {(p : D)})
  obtain ⟨e, g, hginj, hgfin⟩ := exists_finite_inj_algHom_of_fg (ZMod p) (D ⧸ Ideal.span {(p : D)})
  choose y hy using fun i : Fin e => Ideal.Quotient.mk_surjective (g (MvPolynomial.X i))
  have hkey : (Ideal.Quotient.mk (Ideal.span {(p : D)})).comp
      (MvPolynomial.aeval (R := ℤ) y).toRingHom =
      (g.toRingHom).comp (MvPolynomial.map (σ := Fin e) (Int.castRingHom (ZMod p))) := by
    apply MvPolynomial.ringHom_ext
    · intro r
      exact RingHom.congr_fun (RingHom.ext_int
        (((Ideal.Quotient.mk (Ideal.span {(p : D)})).comp
          (MvPolynomial.aeval (R := ℤ) y).toRingHom).comp MvPolynomial.C)
        (((g.toRingHom).comp (MvPolynomial.map (σ := Fin e) (Int.castRingHom (ZMod p)))).comp
          MvPolynomial.C)) r
    · intro i
      simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
        MvPolynomial.aeval_X, MvPolynomial.map_X]
      exact hy i
  have hkey' : ∀ f, Ideal.Quotient.mk (Ideal.span {(p : D)}) (MvPolynomial.aeval y f) =
      g (MvPolynomial.map (Int.castRingHom (ZMod p)) f) := fun f => RingHom.congr_fun hkey f
  refine ⟨e, y, ?_, ?_⟩
  · intro f hf
    apply hginj
    rw [map_zero, ← hkey' f]
    exact Ideal.Quotient.eq_zero_iff_mem.mpr hf
  · letI := (MvPolynomial.aeval (R := ℤ) y).toRingHom.toAlgebra
    rw [← RingHom.finite_algebraMap]
    have hA : algebraMap (MvPolynomial (Fin e) ℤ) (D ⧸ Ideal.span {(p : D)}) =
        (Ideal.Quotient.mk (Ideal.span {(p : D)})).comp (MvPolynomial.aeval (R := ℤ) y).toRingHom := by
      rw [← Ideal.Quotient.mk_comp_algebraMap]
      rfl
    rw [hA, hkey]
    exact RingHom.Finite.comp hgfin (RingHom.Finite.of_surjective _
      (MvPolynomial.map_surjective _ (ZMod.ringHom_surjective _)))

theorem wc_int_fibre_lift_injective : ∀ (D : Type u) [CommRing D] [IsDomain D] (p : ℕ), p.Prime → (p : D) ≠ 0 → ∀ (e : ℕ) (y : Fin e → D), (∀ f : MvPolynomial (Fin e) ℤ, MvPolynomial.aeval y f ∈ Ideal.span {(p : D)} → MvPolynomial.map (Int.castRingHom (ZMod p)) f = 0) → Function.Injective (MvPolynomial.aeval y : MvPolynomial (Fin e) ℤ →ₐ[ℤ] D) :=
by
  intro D _ _ p hp hp0 e y H
  haveI : NeZero p := ⟨hp.ne_zero⟩
  rw [injective_iff_map_eq_zero]
  have step : ∀ f : MvPolynomial (Fin e) ℤ, MvPolynomial.aeval y f = 0 →
      ∃ g, f = MvPolynomial.C (p : ℤ) * g ∧ MvPolynomial.aeval y g = 0 := by
    intro f hf
    have h1 := H f (by rw [hf]; exact Ideal.zero_mem _)
    have hdvd : MvPolynomial.C (p : ℤ) ∣ f := by
      rw [MvPolynomial.C_dvd_iff_dvd_coeff]
      intro m
      have h2 : ((MvPolynomial.map (Int.castRingHom (ZMod p))) f).coeff m = 0 := by
        rw [h1]; simp
      rw [MvPolynomial.coeff_map] at h2
      exact (ZMod.intCast_zmod_eq_zero_iff_dvd _ p).mp (by simpa using h2)
    obtain ⟨g, hg⟩ := hdvd
    refine ⟨g, hg, ?_⟩
    rw [hg, map_mul, MvPolynomial.aeval_C] at hf
    have h3 : algebraMap ℤ D (p : ℤ) = (p : D) := by simp
    rw [h3] at hf
    exact (mul_eq_zero.mp hf).resolve_left hp0
  have allk : ∀ k : ℕ, ∀ f : MvPolynomial (Fin e) ℤ, MvPolynomial.aeval y f = 0 →
      MvPolynomial.C ((p : ℤ) ^ k) ∣ f := by
    intro k
    induction k with
    | zero => intro f _; simp
    | succ k ih =>
      intro f hf
      obtain ⟨g, hg, hg0⟩ := step f hf
      rw [hg, pow_succ', map_mul]
      exact mul_dvd_mul_left _ (ih g hg0)
  intro f hf
  by_contra hne
  obtain ⟨m, hm⟩ := MvPolynomial.ne_zero_iff.mp hne
  have hd := (MvPolynomial.C_dvd_iff_dvd_coeff _ _).mp (allk (f.coeff m).natAbs f hf) m
  apply hm
  apply Int.eq_zero_of_dvd_of_natAbs_lt_natAbs hd
  rw [Int.natAbs_pow, Int.natAbs_natCast]
  exact Nat.lt_pow_self hp.one_lt

theorem wc_int_quasiFiniteAt_of_finite_mod_ideal : ∀ (R : Type) (S : Type u) [CommRing R] [CommRing S] [Algebra R S] [Algebra.FiniteType R S] (I : Ideal R), Module.Finite R (S ⧸ I.map (algebraMap R S)) → ∀ (q : Ideal S) [q.IsPrime], I.map (algebraMap R S) ≤ q → Algebra.QuasiFiniteAt R q :=
by
  intro R S _ _ _ _ I hfin q _ hJq
  have s1 : I ≤ q.under R :=
    (Ideal.le_comap_map (f := algebraMap R S)).trans (Ideal.comap_mono hJq)
  have s2 : I.map (algebraMap R S) ≤ (q.under R).map (algebraMap R S) := Ideal.map_mono s1
  haveI s3 : Module.Finite R (S ⧸ (q.under R).map (algebraMap R S)) :=
    Module.Finite.of_surjective (Ideal.Quotient.factorₐ R s2).toLinearMap
      (Ideal.Quotient.factor_surjective s2)
  haveI s4 : Algebra.QuasiFinite R (S ⧸ (q.under R).map (algebraMap R S)) := inferInstance
  haveI s6 : Algebra.WeaklyQuasiFiniteAt R q := by
    show Algebra.QuasiFinite R (Localization.AtPrime
      (q.map (Ideal.Quotient.mk ((q.under R).map (algebraMap R S)))))
    infer_instance
  exact Algebra.QuasiFiniteAt.of_weaklyQuasiFiniteAt q

theorem wc_int_normalization_finite_on_zmt_chart : ∀ (R : Type) [CommRing R] [IsDomain R] [IsNoetherianRing R] [IsIntegrallyClosed R] (D : Type u) [CommRing D] [IsDomain D] [CharZero D] [Algebra R D] [Algebra.FiniteType R D], Function.Injective (algebraMap R D) → ∀ r : D, r ≠ 0 → IsIntegral R r → (∀ x : D, ∃ m : ℕ, IsIntegral R (r ^ m * x)) → ∃ S : Finset (integralClosure D (FractionRing D)), ∀ z : integralClosure D (FractionRing D), ∃ N : ℕ, r ^ N • z ∈ Submodule.span D (S : Set (integralClosure D (FractionRing D))) :=
by
  intro R _ _ _ _ D _ _ _ _ _ hinj r hr0 hrint hrx
  classical

  have halg : ∀ x : D, IsAlgebraic R x := by
    intro x
    obtain ⟨m, hm⟩ := hrx x
    exact IsAlgebraic.of_mul (mem_nonZeroDivisors_of_ne_zero (pow_ne_zero m hr0))
      (hrint.pow m).isAlgebraic hm.isAlgebraic

  have hfinA : Module.Finite R (integralClosure R (FractionRing D)) := by
    have : FaithfulSMul R (FractionRing D) := by
      rw [faithfulSMul_iff_algebraMap_injective, IsScalarTower.algebraMap_eq R D (FractionRing D)]
      exact (IsFractionRing.injective D (FractionRing D)).comp hinj
    letI : Algebra (FractionRing R) (FractionRing D) := FractionRing.liftAlgebra R (FractionRing D)
    have : IsScalarTower R (FractionRing R) (FractionRing D) :=
      FractionRing.isScalarTower_liftAlgebra R (FractionRing D)
    have : CharZero R := RingHom.charZero (algebraMap R D)
    have : CharZero (FractionRing R) :=
      charZero_of_injective_algebraMap (IsFractionRing.injective R (FractionRing R))
    have hint : ∀ x : D, IsIntegral (FractionRing R) (algebraMap D (FractionRing D) x) := by
      intro x
      have h1 : IsAlgebraic R (algebraMap D (FractionRing D) x) := (halg x).algebraMap
      exact ((IsFractionRing.isAlgebraic_iff R (FractionRing R) (FractionRing D)).mp h1).isIntegral
    obtain ⟨t, ht⟩ := Algebra.FiniteType.out (R := R) (A := D)
    have hTfin : FiniteDimensional (FractionRing R)
        (IntermediateField.adjoin (FractionRing R) (algebraMap D (FractionRing D) '' (t : Set D))) := by
      have : Finite (algebraMap D (FractionRing D) '' (t : Set D)) :=
        (t.finite_toSet.image _).to_subtype
      apply IntermediateField.finiteDimensional_adjoin
      rintro _ ⟨x, -, rfl⟩
      exact hint x
    have hD : ∀ x : D, algebraMap D (FractionRing D) x ∈
        IntermediateField.adjoin (FractionRing R) (algebraMap D (FractionRing D) '' (t : Set D)) := by
      intro x
      have hx : x ∈ Algebra.adjoin R (t : Set D) := by rw [ht]; trivial
      induction hx using Algebra.adjoin_induction with
      | mem x hx => exact IntermediateField.subset_adjoin _ _ ⟨x, hx, rfl⟩
      | algebraMap a =>
        rw [← IsScalarTower.algebraMap_apply R D (FractionRing D),
          IsScalarTower.algebraMap_apply R (FractionRing R) (FractionRing D)]
        exact IntermediateField.algebraMap_mem _ _
      | add x y _ _ hx hy => rw [map_add]; exact add_mem hx hy
      | mul x y _ _ hx hy => rw [map_mul]; exact mul_mem hx hy
    have htop : IntermediateField.adjoin (FractionRing R)
        (algebraMap D (FractionRing D) '' (t : Set D)) = ⊤ := by
      rw [eq_top_iff]
      intro y _
      obtain ⟨a, b, _, rfl⟩ := IsFractionRing.div_surjective (A := D) y
      exact div_mem (hD a) (hD b)
    have : FiniteDimensional (FractionRing R) (FractionRing D) := by
      have h : FiniteDimensional (FractionRing R)
          (⊤ : IntermediateField (FractionRing R) (FractionRing D)) := htop ▸ hTfin
      exact IntermediateField.topEquiv.toLinearEquiv.finiteDimensional
    have : Algebra.IsSeparable (FractionRing R) (FractionRing D) :=
      Algebra.IsSeparable.of_integral (FractionRing R) (FractionRing D)
    exact IsIntegralClosure.finite R (FractionRing R) (FractionRing D)
      (integralClosure R (FractionRing D))

  have hresc : ∀ z : FractionRing D, IsIntegral D z →
      ∃ N : ℕ, IsIntegral R (algebraMap D (FractionRing D) (r ^ N) * z) := by
    intro z hz
    obtain ⟨p, hpm, hpz⟩ := hz
    choose m hm using hrx
    have hn0 : p.natDegree ≠ 0 := by
      intro h
      have h1 : p = 1 := (Polynomial.Monic.natDegree_eq_zero hpm).mp h
      rw [h1, Polynomial.eval₂_one] at hpz
      exact one_ne_zero hpz
    obtain ⟨k, hk⟩ : ∃ k, k = (Finset.range p.natDegree).sup (fun i => m (p.coeff i)) := ⟨_, rfl⟩
    have hqm : (p.scaleRoots (r ^ k)).Monic := (Polynomial.monic_scaleRoots_iff (r ^ k)).mpr hpm
    have hqn : (p.scaleRoots (r ^ k)).natDegree = p.natDegree :=
      Polynomial.natDegree_scaleRoots p (r ^ k)
    have hqroot : Polynomial.aeval (algebraMap D (FractionRing D) (r ^ k) * z)
        (p.scaleRoots (r ^ k)) = 0 :=
      Polynomial.scaleRoots_aeval_eq_zero (by rw [Polynomial.aeval_def]; exact hpz)
    have hcoeff : ∀ i, IsIntegral R ((p.scaleRoots (r ^ k)).coeff i) := by
      intro i
      rw [Polynomial.coeff_scaleRoots]
      rcases lt_trichotomy i p.natDegree with h | h | h
      · have hle : m (p.coeff i) ≤ k := by
          rw [hk]
          exact Finset.le_sup (f := fun i => m (p.coeff i)) (Finset.mem_range.mpr h)
        obtain ⟨b, hb⟩ : ∃ b, k = m (p.coeff i) + b := ⟨k - m (p.coeff i), by omega⟩
        obtain ⟨j, hj⟩ : ∃ j, p.natDegree - i = j + 1 := ⟨p.natDegree - i - 1, by omega⟩
        rw [hj, hb]
        have e : p.coeff i * (r ^ (m (p.coeff i) + b)) ^ (j + 1) =
            (r ^ m (p.coeff i) * p.coeff i) * (r ^ b * (r ^ (m (p.coeff i) + b)) ^ j) := by ring
        rw [e]
        exact (hm _).mul ((hrint.pow _).mul ((hrint.pow _).pow _))
      · subst h
        rw [hpm.coeff_natDegree, Nat.sub_self, pow_zero, mul_one]
        exact isIntegral_one
      · rw [Polynomial.coeff_eq_zero_of_natDegree_lt h, zero_mul]
        exact isIntegral_zero
    refine ⟨k, ?_⟩
    have hq'm : ((p.scaleRoots (r ^ k)).map (algebraMap D (FractionRing D))).Monic := hqm.map _
    have hq'n : ((p.scaleRoots (r ^ k)).map (algebraMap D (FractionRing D))).natDegree ≠ 0 := by
      rw [hqm.natDegree_map, hqn]; exact hn0
    apply IsIntegral.of_aeval_monic_of_isIntegral_coeff hq'm hq'n
    · rw [Polynomial.eval_map, ← Polynomial.aeval_def, hqroot]; exact isIntegral_zero
    · intro i
      rw [Polynomial.coeff_map]
      exact (hcoeff i).algebraMap

  obtain ⟨n, s, hs⟩ := Module.Finite.exists_fin (R := R) (M := integralClosure R (FractionRing D))
  have hsD : ∀ i, IsIntegral D ((s i : FractionRing D)) := fun i => (s i).2.tower_top
  let t : Fin n → integralClosure D (FractionRing D) := fun i => ⟨(s i : FractionRing D), hsD i⟩
  refine ⟨Finset.univ.image t, fun z => ?_⟩
  obtain ⟨N, hN⟩ := hresc (z : FractionRing D) z.2
  refine ⟨N, ?_⟩
  let y : integralClosure R (FractionRing D) := ⟨_, hN⟩
  have hy : y ∈ Submodule.span R (Set.range s) := by rw [hs]; trivial
  obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun R).mp hy
  have heq : r ^ N • z = ∑ i, (algebraMap R D (c i)) • t i := by
    apply Subtype.ext
    have hc' := congrArg (fun w : integralClosure R (FractionRing D) => (w : FractionRing D)) hc
    simp only [AddSubmonoidClass.coe_finsetSum, Algebra.smul_def,
      ← IsScalarTower.algebraMap_apply] at hc' ⊢
    exact hc'.symm
  rw [heq]
  refine Submodule.sum_mem _ (fun i _ => Submodule.smul_mem _ _ (Submodule.subset_span ?_))
  exact Finset.mem_coe.mpr (Finset.mem_image_of_mem t (Finset.mem_univ i))

theorem wc_int_finite_type_domain_integralClosure_finite : ∀ (D : Type u) [CommRing D] [IsDomain D] [Algebra.FiniteType ℤ D], Module.Finite D (integralClosure D (FractionRing D)) :=
by
  intro D _ _ _
  by_cases hp : ∃ p : ℕ, p.Prime ∧ (p : D) = 0
  · obtain ⟨p, hpp, hp0⟩ := hp
    haveI : Fact p.Prime := ⟨hpp⟩
    haveI : CharP D p := (CharP.charP_iff_prime_eq_zero hpp).mpr hp0
    letI : Algebra (ULift.{u} (ZMod p)) D :=
      ((ZMod.castHom dvd_rfl D).comp ULift.ringEquiv.toRingHom).toAlgebra
    haveI : IsScalarTower ℤ (ULift.{u} (ZMod p)) D := AddCommGroup.intIsScalarTower
    haveI : Algebra.FiniteType (ULift.{u} (ZMod p)) D :=
      Algebra.FiniteType.of_restrictScalars_finiteType ℤ _ D
    haveI : PerfectField (ULift.{u} (ZMod p)) := PerfectField.ofFinite
    exact noether_integralClosure_finite (ULift.{u} (ZMod p)) D
  push_neg at hp
  haveI : CharZero D := by
    rcases CharP.char_is_prime_or_zero D (ringChar D) with h | h
    · exact absurd ringChar.Nat.cast_ringChar (hp _ h)
    · have : CharP D 0 := h ▸ ringChar.charP D
      exact (CharP.charP_zero_iff_charZero D).mp this
  apply wc_int_module_finite_of_local_span
  intro m hm
  obtain ⟨p, hpp, hpm⟩ := wc_int_ft_maximal_contains_prime D m hm
  have hspan_le : Ideal.span {(p : D)} ≤ m := (Ideal.span_singleton_le_iff_mem m).mpr hpm
  have hne : Ideal.span {(p : D)} ≠ ⊤ := fun h => hm.ne_top (top_le_iff.mp (h ▸ hspan_le))
  have hp0 : (p : D) ≠ 0 := hp p hpp
  obtain ⟨e, y, hker, hfin⟩ := wc_int_fibre_noether_normalization D p hpp hne
  have hinj := wc_int_fibre_lift_injective D p hpp hp0 e y hker
  letI : Algebra (MvPolynomial (Fin e) ℤ) D := (MvPolynomial.aeval (R := ℤ) y).toRingHom.toAlgebra
  haveI : IsScalarTower ℤ (MvPolynomial (Fin e) ℤ) D := AddCommGroup.intIsScalarTower
  haveI : Algebra.FiniteType (MvPolynomial (Fin e) ℤ) D :=
    Algebra.FiniteType.of_restrictScalars_finiteType ℤ _ D
  have hmap : (Ideal.span {(p : MvPolynomial (Fin e) ℤ)}).map
      (algebraMap (MvPolynomial (Fin e) ℤ) D) = Ideal.span {(p : D)} := by
    rw [Ideal.map_span, Set.image_singleton, map_natCast]
  haveI := hm.isPrime
  have hfin' : Module.Finite (MvPolynomial (Fin e) ℤ)
      (D ⧸ (Ideal.span {(p : MvPolynomial (Fin e) ℤ)}).map
        (algebraMap (MvPolynomial (Fin e) ℤ) D)) := by
    rw [hmap]; exact hfin
  have hle : (Ideal.span {(p : MvPolynomial (Fin e) ℤ)}).map
      (algebraMap (MvPolynomial (Fin e) ℤ) D) ≤ m := by
    rw [hmap]; exact hspan_le
  have hqf := wc_int_quasiFiniteAt_of_finite_mod_ideal (MvPolynomial (Fin e) ℤ) D
    (Ideal.span {(p : MvPolynomial (Fin e) ℤ)}) hfin' m hle
  obtain ⟨r, hrm, hrint, hrx⟩ := Algebra.zariskisMainProperty_iff.mp
    (Algebra.ZariskisMainProperty.of_finiteType (R := MvPolynomial (Fin e) ℤ) m)
  have hr0 : r ≠ 0 := fun h => hrm (h ▸ m.zero_mem)
  obtain ⟨S, hS⟩ := wc_int_normalization_finite_on_zmt_chart (MvPolynomial (Fin e) ℤ) D hinj r hr0
    hrint hrx
  exact ⟨r, hrm, S, hS⟩

theorem wc_normal_noetherian_exhaustion_of_int_nagata : (∀ (D : Type u) [CommRing D] [IsDomain D] [Algebra.FiniteType ℤ D], Module.Finite D (integralClosure D (FractionRing D))) → ∀ (A : Type u) [CommRing A] [IsDomain A] [IsIntegrallyClosed A], ∃ Λ : Finset A → Subring A, Monotone Λ ∧ (∀ S, ∀ a ∈ S, a ∈ Λ S) ∧ (∀ S, IsNoetherianRing ↥(Λ S)) ∧ (∀ S, IsIntegrallyClosed ↥(Λ S)) :=
by
  intro H A _ _ _
  classical
  have s2 : ∀ (B : Type u) [CommRing B] [IsDomain B] (j : B →+* A), Function.Injective j →
      ∃ T : Subring A, (∀ a : A, a ∈ T ↔ (∃ f : Polynomial B, f.Monic ∧ f.eval₂ j a = 0) ∧
        ∃ b₁ b₂ : B, b₁ ≠ 0 ∧ j b₁ * a = j b₂) ∧
        Nonempty (↥T ≃+* ↥(integralClosure B (FractionRing B))) := by
    intro B _ _ j hj
    have hAinj : Function.Injective (algebraMap A (FractionRing A)) :=
      IsFractionRing.injective A (FractionRing A)
    have hgi : Function.Injective ((algebraMap A (FractionRing A)).comp j) := hAinj.comp hj
    let ι : FractionRing B →+* FractionRing A := IsFractionRing.lift hgi
    have hι : ∀ b : B, ι (algebraMap B (FractionRing B) b) = algebraMap A (FractionRing A) (j b) :=
      fun b => IsFractionRing.lift_algebraMap hgi b
    have hcomp : ι.comp (algebraMap B (FractionRing B)) = (algebraMap A (FractionRing A)).comp j :=
      RingHom.ext fun b => hι b
    have hev : ∀ (f : Polynomial B) (y : FractionRing B),
        ι (f.eval₂ (algebraMap B (FractionRing B)) y) =
          f.eval₂ ((algebraMap A (FractionRing A)).comp j) (ι y) := by
      intro f y
      rw [Polynomial.hom_eval₂, hcomp]
    have hevA : ∀ (f : Polynomial B) (a : A),
        algebraMap A (FractionRing A) (f.eval₂ j a) =
          f.eval₂ ((algebraMap A (FractionRing A)).comp j) (algebraMap A (FractionRing A) a) :=
      fun f a => Polynomial.hom_eval₂ f j _ a
    have hrange : ∀ y : integralClosure B (FractionRing B),
        ι (y : FractionRing B) ∈ (algebraMap A (FractionRing A)).range := by
      intro y
      have hy : _root_.IsIntegral B (y : FractionRing B) := y.2
      obtain ⟨f, hfm, hf⟩ := hy
      have hi : _root_.IsIntegral A (ι (y : FractionRing B)) :=
        ⟨f.map j, hfm.map j, by rw [Polynomial.eval₂_map, ← hev, hf, map_zero]⟩
      obtain ⟨a, ha⟩ := IsIntegrallyClosed.isIntegral_iff.mp hi
      exact ⟨a, ha⟩
    let eA : A ≃+* (algebraMap A (FractionRing A)).range :=
      RingEquiv.ofBijective (algebraMap A (FractionRing A)).rangeRestrict
        ⟨fun x y h => hAinj (congrArg Subtype.val h),
          (algebraMap A (FractionRing A)).rangeRestrict_surjective⟩
    let ψ1 : integralClosure B (FractionRing B) →+* (algebraMap A (FractionRing A)).range :=
      (ι.comp (integralClosure B (FractionRing B)).val.toRingHom).codRestrict _ hrange
    let ψ : integralClosure B (FractionRing B) →+* A := eA.symm.toRingHom.comp ψ1
    have hψ : ∀ y, algebraMap A (FractionRing A) (ψ y) = ι (y : FractionRing B) := by
      intro y
      have h1 : eA (ψ y) = ψ1 y := eA.apply_symm_apply _
      exact congrArg Subtype.val h1
    have hψinj : Function.Injective ψ := by
      intro y y' h
      apply Subtype.ext
      apply ι.injective
      rw [← hψ, ← hψ, h]
    have hmemψ : ∀ a : A, a ∈ ψ.range ↔ (∃ f : Polynomial B, f.Monic ∧ f.eval₂ j a = 0) ∧
        ∃ b₁ b₂ : B, b₁ ≠ 0 ∧ j b₁ * a = j b₂ := by
      intro a
      rw [RingHom.mem_range]
      constructor
      · rintro ⟨y, rfl⟩
        have hy : _root_.IsIntegral B (y : FractionRing B) := y.2
        obtain ⟨f, hfm, hf⟩ := hy
        refine ⟨⟨f, hfm, ?_⟩, ?_⟩
        · apply hAinj
          rw [hevA, hψ, ← hev, hf, map_zero, map_zero]
        · obtain ⟨b₂, b₁, hb₁, hyb⟩ := IsFractionRing.div_surjective B (y : FractionRing B)
          have hb₁0 : b₁ ≠ 0 := nonZeroDivisors.ne_zero hb₁
          have hb₁f : algebraMap B (FractionRing B) b₁ ≠ 0 := fun h0 =>
            hb₁0 (IsFractionRing.injective B (FractionRing B) (h0.trans (map_zero _).symm))
          refine ⟨b₁, b₂, hb₁0, ?_⟩
          apply hAinj
          rw [map_mul, hψ, ← hι, ← hι, ← map_mul, ← hyb]
          congr 1
          field_simp
      · rintro ⟨⟨f, hfm, hf⟩, b₁, b₂, hb₁, hab⟩
        have hjb₁ : algebraMap A (FractionRing A) (j b₁) ≠ 0 := by
          intro h0
          apply hb₁
          apply hj
          apply hAinj
          rw [h0, map_zero, map_zero]
        have hιy0 : ι (algebraMap B (FractionRing B) b₂ / algebraMap B (FractionRing B) b₁) =
            algebraMap A (FractionRing A) a := by
          rw [map_div₀, hι, hι, ← hab, map_mul]
          field_simp
        have hy0int : _root_.IsIntegral B
            (algebraMap B (FractionRing B) b₂ / algebraMap B (FractionRing B) b₁) := by
          refine ⟨f, hfm, ?_⟩
          apply ι.injective
          rw [hev, hιy0, ← hevA, hf, map_zero, map_zero]
        refine ⟨⟨_, hy0int⟩, ?_⟩
        apply hAinj
        rw [hψ]
        exact hιy0
    exact ⟨ψ.range, hmemψ, ⟨(RingEquiv.ofBijective ψ.rangeRestrict
      ⟨fun x y h => hψinj (congrArg Subtype.val h), ψ.rangeRestrict_surjective⟩).symm⟩⟩
  have s6 : ∀ S : Finset A, IsNoetherianRing ↥(integralClosure (Algebra.adjoin ℤ (S : Set A))
      (FractionRing (Algebra.adjoin ℤ (S : Set A)))) := by
    intro S
    have h1 : Algebra.FiniteType ℤ (Algebra.adjoin ℤ (S : Set A)) :=
      Algebra.FiniteType.adjoin_of_finite S.finite_toSet
    haveI : IsNoetherianRing (Algebra.adjoin ℤ (S : Set A)) :=
      Algebra.FiniteType.isNoetherianRing ℤ _
    haveI := @H (Algebra.adjoin ℤ (S : Set A)) _ _ (by
      first
        | exact h1
        | (convert h1 using 1; exact Subsingleton.elim _ _)
        | convert h1)
    exact IsNoetherianRing.of_finite (Algebra.adjoin ℤ (S : Set A)) _
  have hT : ∀ S : Finset A, ∃ T : Subring A, (∀ a : A, a ∈ T ↔
      (∃ f : Polynomial (Algebra.adjoin ℤ (S : Set A)),
        f.Monic ∧ f.eval₂ (Algebra.adjoin ℤ (S : Set A)).val.toRingHom a = 0) ∧
      ∃ b₁ b₂ : Algebra.adjoin ℤ (S : Set A), b₁ ≠ 0 ∧
        (Algebra.adjoin ℤ (S : Set A)).val.toRingHom b₁ * a =
          (Algebra.adjoin ℤ (S : Set A)).val.toRingHom b₂) ∧
      Nonempty (↥T ≃+* ↥(integralClosure (Algebra.adjoin ℤ (S : Set A))
        (FractionRing (Algebra.adjoin ℤ (S : Set A))))) :=
    fun S => s2 _ (Algebra.adjoin ℤ (S : Set A)).val.toRingHom Subtype.val_injective
  choose Λ hmem he using hT
  refine ⟨Λ, ?_, ?_, ?_, ?_⟩
  · intro S S' hSS' a ha
    rw [hmem] at ha ⊢
    obtain ⟨⟨f, hfm, hf⟩, b₁, b₂, hb₁, hb⟩ := ha
    have h : Algebra.adjoin ℤ (S : Set A) ≤ Algebra.adjoin ℤ (S' : Set A) :=
      Algebra.adjoin_mono (Finset.coe_subset.mpr hSS')
    have hc : (Algebra.adjoin ℤ (S' : Set A)).val.toRingHom.comp
        (Subalgebra.inclusion h).toRingHom = (Algebra.adjoin ℤ (S : Set A)).val.toRingHom :=
      RingHom.ext fun _ => rfl
    refine ⟨⟨f.map (Subalgebra.inclusion h).toRingHom, hfm.map _, ?_⟩,
      Subalgebra.inclusion h b₁, Subalgebra.inclusion h b₂, ?_, ?_⟩
    · rw [Polynomial.eval₂_map, hc]
      exact hf
    · intro h0
      apply hb₁
      apply Subalgebra.inclusion_injective h
      rw [h0, map_zero]
    · exact hb
  · intro S a ha
    rw [hmem]
    refine ⟨⟨Polynomial.X - Polynomial.C ⟨a, Algebra.subset_adjoin ha⟩,
      Polynomial.monic_X_sub_C _, ?_⟩, 1, ⟨a, Algebra.subset_adjoin ha⟩, one_ne_zero, ?_⟩
    · rw [Polynomial.eval₂_sub, Polynomial.eval₂_X, Polynomial.eval₂_C]
      exact sub_self a
    · rw [map_one, one_mul]
      rfl
  · intro S
    obtain ⟨e⟩ := he S
    haveI := s6 S
    exact isNoetherianRing_of_ringEquiv _ e.symm
  · intro S
    obtain ⟨e⟩ := he S
    haveI : IsIntegrallyClosed (integralClosure (Algebra.adjoin ℤ (S : Set A))
        (FractionRing (Algebra.adjoin ℤ (S : Set A)))) :=
      integralClosure.isIntegrallyClosedOfFiniteExtension (R := Algebra.adjoin ℤ (S : Set A))
        (FractionRing (Algebra.adjoin ℤ (S : Set A))) (L := FractionRing (Algebra.adjoin ℤ (S : Set A)))
    exact IsIntegrallyClosed.of_equiv e.symm

theorem wc_affine_line_torsor_normal_generic_of_unit : ∀ (ℓ : ℕ), ℓ.Prime → ∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] [IsDomain A] [IsIntegrallyClosed A], IsUnit (ℓ : A) → ∀ (x : Spec (.of (Polynomial A))), IsClosed ({x} : Set (Spec (.of (Polynomial A)))) → Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A))) x = IsLocalRing.closedPoint A → ∀ (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (Polynomial A))) x)) (Scheme.Etale.forget (Spec (.of (Polynomial A))))) (φ : ∀ l, Spec (.of B) ⟶ (W'.obj l).right.left) (a : Spec (.of B) ⟶ Spec (.of (Polynomial A))), wcHalShData x B Λ W' φ a → ∀ (L : Type u) [Field L] [IsAlgClosed L] (j : A →+* L), Function.Injective j → (∀ y : L, ∃ a₁ b₁ : A, j b₁ ≠ 0 ∧ y * j b₁ = j a₁) → ∀ (P : Scheme.{u}) (p : P ⟶ Limits.pullback (a ≫ Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) (Spec.map (CommRingCat.ofHom j))) (α : ZMod ℓ → (P ⟶ P)), wcFetTorsor p ℓ α → ∃ σ : Limits.pullback (a ≫ Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) (Spec.map (CommRingCat.ofHom j)) ⟶ P, σ ≫ p = 𝟙 _ :=
by
  intro ℓ hℓ A _ _ _ _ _ hℓA x hx hxc B _ _ _ Λ _ _ W' φ a hd L _ _ j hj hfrac P p α hP
  classical

  have hax : a (IsLocalRing.closedPoint B) = x := by
    obtain ⟨-, -, -, -, -, e0, -, he0⟩ := hd
    have pt : Spec (.of (AlgebraicClosure ((Spec (.of (Polynomial A))).residueField x))) :=
      IsLocalRing.closedPoint _
    have h1 := congrArg (fun g : Spec (.of (AlgebraicClosure ((Spec (.of (Polynomial A))).residueField x))) ⟶
      Spec (.of (Polynomial A)) => g pt) he0
    simp only [wcEtGeomPt, Scheme.Hom.comp_apply, Scheme.fromSpecResidueField_apply] at h1
    have h2 : ∀ q, (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B))) q =
        IsLocalRing.closedPoint B := fun q => IsLocalRing.PrimeSpectrum.comap_residue B q
    exact (congrArg (fun y => a y) (h2 _)).symm.trans
      (h1.trans (Scheme.fromSpecResidueField_apply x _))

  obtain ⟨hkA, ζ₀, hζ₀⟩ : IsAlgClosed (IsLocalRing.ResidueField A) ∧
      ∃ ζ₀ : A, IsPrimitiveRoot ζ₀ ℓ := by
    letI : Algebra A L := j.toAlgebra
    haveI : IsFractionRing A L := by
      refine ⟨?_, ?_, ?_⟩
      · intro b
        have hb : (b : A) ≠ 0 := nonZeroDivisors.ne_zero b.2
        exact IsUnit.mk0 _ (fun h => hb (hj (by rw [map_zero]; exact h)))
      · intro y
        obtain ⟨a₁, b₁, hb, hy⟩ := hfrac y
        have hb' : b₁ ∈ nonZeroDivisors A :=
          mem_nonZeroDivisors_of_ne_zero (fun h => hb (by rw [h, map_zero]))
        exact ⟨⟨a₁, ⟨b₁, hb'⟩⟩, hy⟩
      · intro x y hxy
        exact ⟨1, by rw [hj hxy]⟩
    refine ⟨?_, ?_⟩
    · apply IsAlgClosed.of_exists_root
      intro p hmon hirr
      obtain ⟨f, hf, hdeg, hfm⟩ := Polynomial.lifts_and_natDegree_eq_and_monic
        ((Polynomial.mem_lifts p).2 (Polynomial.map_surjective (IsLocalRing.residue A)
          IsLocalRing.residue_surjective p)) hmon
      have hpdeg : 0 < p.natDegree :=
        Polynomial.natDegree_pos_iff_degree_pos.mpr (Polynomial.degree_pos_of_irreducible hirr)
      obtain ⟨y, hy⟩ := IsAlgClosed.exists_root (f.map j)
        (Polynomial.natDegree_pos_iff_degree_pos.mp
          (by rw [Polynomial.natDegree_map_eq_of_injective hj, hdeg]; exact hpdeg)).ne'
      have hyint : IsIntegral A y :=
        ⟨f, hfm, by change Polynomial.eval₂ j y f = 0; rw [← Polynomial.eval_map]; exact hy⟩
      obtain ⟨a0, ha0⟩ := IsIntegrallyClosed.isIntegral_iff.mp hyint
      have ha0' : j a0 = y := ha0
      refine ⟨IsLocalRing.residue A a0, ?_⟩
      have h1 : j (f.eval a0) = 0 := by
        rw [← Polynomial.eval₂_hom, ← Polynomial.eval_map, ha0']
        exact hy
      have h2 : f.eval a0 = 0 := hj (by rw [h1, map_zero])
      rw [← hf, Polynomial.eval_map, Polynomial.eval₂_hom, h2, map_zero]
    · have hc : (Polynomial.cyclotomic ℓ A).Monic := Polynomial.cyclotomic.monic ℓ A
      have hpdeg : 0 < (Polynomial.cyclotomic ℓ A).natDegree :=
        Polynomial.natDegree_pos_iff_degree_pos.mpr (Polynomial.degree_cyclotomic_pos ℓ A hℓ.pos)
      obtain ⟨y, hy⟩ := IsAlgClosed.exists_root ((Polynomial.cyclotomic ℓ A).map j)
        (Polynomial.natDegree_pos_iff_degree_pos.mp
          (by rw [Polynomial.natDegree_map_eq_of_injective hj]; exact hpdeg)).ne'
      have hyint : IsIntegral A y :=
        ⟨Polynomial.cyclotomic ℓ A, hc, by
          change Polynomial.eval₂ j y (Polynomial.cyclotomic ℓ A) = 0
          rw [← Polynomial.eval_map]; exact hy⟩
      obtain ⟨z0, hz0⟩ := IsIntegrallyClosed.isIntegral_iff.mp hyint
      have hz0' : j z0 = y := hz0
      have h1 : j ((Polynomial.cyclotomic ℓ A).eval z0) = 0 := by
        rw [← Polynomial.eval₂_hom, ← Polynomial.eval_map, hz0']
        exact hy
      have h2 : (Polynomial.cyclotomic ℓ A).eval z0 = 0 := hj (by rw [h1, map_zero])
      haveI : NeZero (ℓ : A) := ⟨hℓA.ne_zero⟩
      exact ⟨z0, Polynomial.isRoot_cyclotomic_iff.mp h2⟩
  haveI := hkA

  obtain ⟨v, hv⟩ := id hℓA
  have hu : (ℓ : A) * ((v⁻¹ : Aˣ) : A) = 1 := by rw [← hv]; exact v.mul_inv

  obtain ⟨Λe, hmono, hS, hnoeth, hic⟩ := wc_normal_noetherian_exhaustion_of_int_nagata
    wc_int_finite_type_domain_integralClosure_finite A
  obtain ⟨Λe', hΛe'⟩ : ∃ Λe' : Finset A → Subring A,
      ∀ S, Λe' S = Λe (S ∪ {((v⁻¹ : Aˣ) : A), ζ₀}) := ⟨_, fun S => rfl⟩
  have hmono' : Monotone Λe' := by
    intro S S' h
    rw [hΛe', hΛe']
    exact hmono (Finset.union_subset_union h (Finset.Subset.refl _))
  have hS' : ∀ S, ∀ a ∈ S, a ∈ Λe' S := by
    intro S a ha
    rw [hΛe']
    exact hS _ a (Finset.mem_union_left _ ha)
  have hnoeth' : ∀ S, IsNoetherianRing ↥(Λe' S) := by
    intro S
    rw [hΛe']
    exact hnoeth _
  have hic' : ∀ S, IsIntegrallyClosed ↥(Λe' S) := by
    intro S
    rw [hΛe']
    exact hic _
  have hu_mem : ∀ S, ((v⁻¹ : Aˣ) : A) ∈ Λe' S := by
    intro S
    rw [hΛe']
    exact hS _ _ (Finset.mem_union_right _ (Finset.mem_insert_self _ _))
  have hζ_mem : ∀ S, ζ₀ ∈ Λe' S := by
    intro S
    rw [hΛe']
    exact hS _ _ (Finset.mem_union_right _
      (Finset.mem_insert_of_mem (Finset.mem_singleton_self _)))
  have hunit' : ∀ S, IsUnit (ℓ : ↥(Λe' S)) := by
    intro S
    have h1 : (ℓ : ↥(Λe' S)) * ⟨_, hu_mem S⟩ = 1 := by
      apply Subtype.ext
      first
        | simpa using hu
        | (push_cast; exact hu)
