          _ = w := by rw [Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.mk₀_id_comp]
      have hinj : Function.Injective (fun w : Abelian.Ext (Lg.obj
          ((constantSheaf (Scheme.smallEtaleTopology P) AddCommGrpCat.{u+1}).obj
            (AddCommGrpCat.of (ULift.{u+1} ℤ))))
          ((constantSheaf (Scheme.smallEtaleTopology U) AddCommGrpCat.{u+1}).obj
            (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))) n =>
          (Abelian.Ext.mk₀ eg.inv).comp w (zero_add n)) := by
        intro w₁ w₂ h
        have h' := congrArg (fun z => (Abelian.Ext.mk₀ eg.hom).comp z (zero_add n)) h
        simp only [e] at h'
        exact h'
      exact hinj.subsingleton
    exact wc_cpt_th_leray_column_vanish Lg (wcEtPush j) adjg
      ((constantSheaf (Scheme.smallEtaleTopology P) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ))) _ I 2
      (fun p q'' hp hq'' => h1 I p q'' hp hq'') (fun m hm => h2 m (by omega)) hiii q' hq'

  refine wc_cpt_th_reduce_one_var A ℓ hunit ?_ d y hy hy0 B Λ W' φ a ha β hβ q hq
  intro C _ _ _ hC x hx hX E _ _ _ Λ₁ _ _ W₁ φ₁ a₁ hE ε hε q₁ hq₁
