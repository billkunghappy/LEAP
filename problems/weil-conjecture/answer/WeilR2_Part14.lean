theorem wc_seq_colim_localization_away : ∀ (G H : ℕ → Type u) [∀ k, CommRing (G k)] [∀ k, CommRing (H k)] (T T' : Type u)
    [CommRing T] [CommRing T'] (ι : ∀ k, G k →+* T) (ι' : ∀ k, H k →+* T') (lam : ∀ k, G k →+* H k)
    (Λ : T →+* T') (θ : ∀ j k, j ≤ k → (G j →+* G k)) (θ' : ∀ j k, j ≤ k → (H j →+* H k))
    (f : ∀ k, G k),
    (∀ j k (h : j ≤ k), (ι k).comp (θ j k h) = ι j) →
    (∀ j k (h : j ≤ k), (ι' k).comp (θ' j k h) = ι' j) →
    (∀ k, Λ.comp (ι k) = (ι' k).comp (lam k)) →
    (∀ j k (h : j ≤ k), (lam k).comp (θ j k h) = (θ' j k h).comp (lam j)) →
    (∀ j k (h : j ≤ k), θ j k h (f j) = f k) →
    (∀ k, @IsLocalization.Away (G k) _ (f k) (H k) _ (lam k).toAlgebra) →
    (∀ x : T, ∃ (k : ℕ) (y : G k), ι k y = x) →
    (∀ x : T', ∃ (k : ℕ) (y : H k), ι' k y = x) →
    (∀ (k : ℕ) (y : H k), ι' k y = 0 → ∃ (k' : ℕ) (h : k ≤ k'), θ' k k' h y = 0) →
    @IsLocalization.Away T _ (ι 0 (f 0)) T' _ Λ.toAlgebra :=
by
  intro G H _ _ T T' _ _ ι ι' lam Λ θ θ' f h1 _h2 h3 h4 h5 h6 h7 h8 h9
  have e1 : ∀ j k (h : j ≤ k) (g : G j), ι k (θ j k h g) = ι j g := fun j k h g => by
    rw [← RingHom.comp_apply, h1]
  have e3 : ∀ k (g : G k), Λ (ι k g) = ι' k (lam k g) := fun k g => by
    rw [← RingHom.comp_apply, h3, RingHom.comp_apply]
  have e4 : ∀ j k (h : j ≤ k) (g : G j), lam k (θ j k h g) = θ' j k h (lam j g) :=
    fun j k h g => by rw [← RingHom.comp_apply, h4, RingHom.comp_apply]
  have s1 : ∀ k, ι k (f k) = ι 0 (f 0) := by
    intro k
    rw [← h5 0 k (Nat.zero_le k), e1]
  letI : Algebra T T' := Λ.toAlgebra
  have hA : algebraMap T T' = Λ := rfl
  refine IsLocalization.Away.mk (ι 0 (f 0)) ?_ ?_ ?_
  · rw [hA, e3]
    have hu : IsUnit (lam 0 (f 0)) :=
      @IsLocalization.Away.algebraMap_isUnit (G 0) _ (H 0) _ (lam 0).toAlgebra (f 0) (h6 0)
    exact hu.map (ι' 0)
  · intro z
    obtain ⟨k, w, rfl⟩ := h8 z
    obtain ⟨n, a, ha⟩ :=
      @IsLocalization.Away.surj (G k) _ (H k) _ (lam k).toAlgebra (f k) (h6 k) w
    have ha' : w * lam k (f k) ^ n = lam k a := ha
    refine ⟨n, ι k a, ?_⟩
    rw [hA, ← s1 k, e3, e3, ← ha', map_mul, map_pow]
  · intro x y hxy
    have hd : Λ (x - y) = 0 := by rw [map_sub, sub_eq_zero]; exact hxy
    obtain ⟨k, g, hg⟩ := h7 (x - y)
    have h0 : ι' k (lam k g) = 0 := by rw [← e3, hg, hd]
    obtain ⟨k', hk, hθ⟩ := h9 k (lam k g) h0
    have h4' : lam k' (θ k k' hk g) = lam k' 0 := by
      rw [map_zero, ← hθ, e4]
    obtain ⟨n, hn⟩ :=
      @IsLocalization.Away.exists_of_eq (G k') _ (H k') _ (lam k').toAlgebra (f k') (h6 k') _ _ h4'
    refine ⟨n, ?_⟩
    have h' := congrArg (ι k') hn
    rw [mul_zero, map_zero, map_mul, map_pow, s1 k', e1, hg] at h'
    rw [← sub_eq_zero, ← mul_sub]
    exact h'

theorem wc_affine_seq_limit_exists : (∀ (G H : ℕ → Type u) [∀ k, CommRing (G k)] [∀ k, CommRing (H k)] (T T' : Type u)
    [CommRing T] [CommRing T'] (ι : ∀ k, G k →+* T) (ι' : ∀ k, H k →+* T') (lam : ∀ k, G k →+* H k)
    (Λ : T →+* T') (θ : ∀ j k, j ≤ k → (G j →+* G k)) (θ' : ∀ j k, j ≤ k → (H j →+* H k))
    (f : ∀ k, G k),
    (∀ j k (h : j ≤ k), (ι k).comp (θ j k h) = ι j) →
    (∀ j k (h : j ≤ k), (ι' k).comp (θ' j k h) = ι' j) →
    (∀ k, Λ.comp (ι k) = (ι' k).comp (lam k)) →
    (∀ j k (h : j ≤ k), (lam k).comp (θ j k h) = (θ' j k h).comp (lam j)) →
    (∀ j k (h : j ≤ k), θ j k h (f j) = f k) →
    (∀ k, @IsLocalization.Away (G k) _ (f k) (H k) _ (lam k).toAlgebra) →
    (∀ x : T, ∃ (k : ℕ) (y : G k), ι k y = x) →
    (∀ x : T', ∃ (k : ℕ) (y : H k), ι' k y = x) →
    (∀ (k : ℕ) (y : H k), ι' k y = 0 → ∃ (k' : ℕ) (h : k ≤ k'), θ' k k' h y = 0) →
    @IsLocalization.Away T _ (ι 0 (f 0)) T' _ Λ.toAlgebra) →
    ∀ (U : Scheme.{u}) (D : ℕᵒᵖ ⥤ Scheme.{u}) (π : ∀ j, D.obj (Opposite.op j) ⟶ U),
    (∀ j, IsAffineHom (π j)) →
    ∀ (hπ : ∀ j k (h : j ≤ k), D.map (homOfLE h).op ≫ π j = π k),
    ∃ (W₀ : Scheme.{u}) (p : W₀ ⟶ U) (t : ∀ j, W₀ ⟶ D.obj (Opposite.op j))
      (ht : ∀ j, t j ≫ π j = p),
      IsAffineHom p ∧ (∀ j k (h : j ≤ k), t k ≫ D.map (homOfLE h).op = t j) ∧
      (∀ V : U.Opens, IsAffineOpen V → ∀ (n : ℕ) (s : Fin n → Γ(W₀, p ⁻¹ᵁ V)),
        ∃ (j : ℕ) (r : Fin n → Γ(D.obj (Opposite.op j), π j ⁻¹ᵁ V)), ∀ i,
          ((t j).appLE (π j ⁻¹ᵁ V) (p ⁻¹ᵁ V) (by rw [← ht j]; exact le_rfl)).hom (r i) = s i) ∧
      (∀ V : U.Opens, IsAffineOpen V → ∀ (j n : ℕ)
        (r : Fin n → Γ(D.obj (Opposite.op j), π j ⁻¹ᵁ V)),
        (∀ i, ((t j).appLE (π j ⁻¹ᵁ V) (p ⁻¹ᵁ V) (by rw [← ht j]; exact le_rfl)).hom (r i) = 0) →
        ∃ (k : ℕ) (h : j ≤ k), ∀ i,
          ((D.map (homOfLE h).op).appLE (π j ⁻¹ᵁ V) (π k ⁻¹ᵁ V)
            (by rw [← hπ j k h]; exact le_rfl)).hom (r i) = 0) :=
by
  intro H3a U D π hπaff hπ
  classical

  have hcongr : ∀ {X Y : Scheme.{u}} (f g : X ⟶ Y) (e : f = g) (A : Y.Opens) (B : X.Opens)
      (h₁ : B ≤ f ⁻¹ᵁ A), f.appLE A B h₁ = g.appLE A B (e ▸ h₁) := by
    intro X Y f g e A B h₁; subst e; rfl
  have hA : ∀ k (V : U.Opens), IsAffineOpen V → IsAffineOpen (π k ⁻¹ᵁ V) :=
    fun k V hV => haveI := hπaff k; hV.preimage (π k)
  have hle : ∀ (j k : ℕ) (h : j ≤ k) (V : U.Opens),
      π k ⁻¹ᵁ V ≤ D.map (homOfLE h).op ⁻¹ᵁ (π j ⁻¹ᵁ V) := by
    intro j k h V; rw [← hπ j k h]; exact le_rfl
  let θ : ∀ (j k : ℕ) (h : j ≤ k) (V : U.Opens),
      Γ(D.obj (Opposite.op j), π j ⁻¹ᵁ V) ⟶ Γ(D.obj (Opposite.op k), π k ⁻¹ᵁ V) :=
    fun j k h V => (D.map (homOfLE h).op).appLE (π j ⁻¹ᵁ V) (π k ⁻¹ᵁ V) (hle j k h V)

  have θid : ∀ j (h : j ≤ j) V, θ j j h V = 𝟙 _ := by
    intro j h V
    have e : D.map (homOfLE h).op = 𝟙 _ := by
      rw [show (homOfLE h) = 𝟙 j from rfl, op_id, D.map_id]
    simp only [θ]
    rw [hcongr _ _ e]
    simp only [Scheme.Hom.appLE]
    have hmap : ∀ (W : (D.obj (Opposite.op j)).Opens) (g : Opposite.op W ⟶ Opposite.op W),
        (D.obj (Opposite.op j)).presheaf.map g = 𝟙 _ := by
      intro W g
      rw [show g = 𝟙 _ from Quiver.Hom.unop_inj (Subsingleton.elim _ _), CategoryTheory.Functor.map_id]
    first
    | (simp; done)
    | (simp only [Scheme.id_app]; erw [Category.id_comp]; exact hmap _ _)
    | (erw [Scheme.id_app, Category.id_comp]; exact hmap _ _)
    | (simp; erw [Category.id_comp]; exact hmap _ _)
  have θcomp : ∀ i j k (h1 : i ≤ j) (h2 : j ≤ k) V,
      θ i j h1 V ≫ θ j k h2 V = θ i k (h1.trans h2) V := by
    intro i j k h1 h2 V
    simp only [θ]
    rw [Scheme.Hom.appLE_comp_appLE]
    have e : D.map (homOfLE h2).op ≫ D.map (homOfLE h1).op = D.map (homOfLE (h1.trans h2)).op := by
      rw [← D.map_comp]; rfl
    exact hcongr _ _ e _ _ _
  have θπ : ∀ i j (h : i ≤ j) V, (π i).app V ≫ θ i j h V = (π j).app V := by
    intro i j h V
    simp only [θ]
    rw [Scheme.Hom.app_eq_appLE, Scheme.Hom.appLE_comp_appLE, Scheme.Hom.app_eq_appLE]
    exact hcongr _ _ (hπ i j h) _ _ _
  have θnat : ∀ j k (h : j ≤ k) (V V' : U.Opens) (hV : V' ≤ V),
      θ j k h V ≫ (D.obj (Opposite.op k)).presheaf.map (homOfLE ((π k).preimage_mono hV)).op =
      (D.obj (Opposite.op j)).presheaf.map (homOfLE ((π j).preimage_mono hV)).op ≫ θ j k h V' := by
    intro j k h V V' hV
    simp only [θ]
    rw [Scheme.Hom.appLE_map, Scheme.Hom.map_appLE]

  let G : ℕ ⥤ (U.Opensᵒᵖ ⥤ CommRingCat.{u}) :=
    { obj := fun j => (TopologicalSpace.Opens.map (π j).base).op ⋙ (D.obj (Opposite.op j)).presheaf
      map := fun {j k} f =>
        { app := fun V => θ j k (leOfHom f) V.unop
          naturality := by
            intro V V' i
            exact (θnat j k (leOfHom f) V.unop V'.unop (leOfHom i.unop)).symm }
      map_id := by
        intro j
        apply NatTrans.ext
        funext V
        exact θid j _ V.unop
      map_comp := by
        intro i j k f g
        apply NatTrans.ext
        funext V
        exact (θcomp i j k _ _ V.unop).symm }
  haveI : Limits.PreservesFilteredColimitsOfSize.{0, 0} (forget CommRingCat.{u}) :=
    Limits.preservesFilteredColimitsOfSize_shrink (forget CommRingCat.{u})
  haveI : Limits.HasColimitsOfShape ℕ CommRingCat.{u} := inferInstance
  let Fc : U.Opensᵒᵖ ⥤ CommRingCat.{u} := Limits.colimit G
  let ιc : ∀ (j : ℕ) (V : U.Opens), Γ(D.obj (Opposite.op j), π j ⁻¹ᵁ V) ⟶ Fc.obj (Opposite.op V) :=
    fun j V => (Limits.colimit.ι G j).app (Opposite.op V)
  have hcoc : ∀ j k (h : j ≤ k) V, θ j k h V ≫ ιc k V = ιc j V := by
    intro j k h V
    exact congrArg (fun φ => φ.app (Opposite.op V)) (Limits.colimit.w G (homOfLE h))
  have hnat : ∀ j (V V' : U.Opens) (h : V' ≤ V), ιc j V ≫ Fc.map (homOfLE h).op =
      (D.obj (Opposite.op j)).presheaf.map (homOfLE ((π j).preimage_mono h)).op ≫ ιc j V' := by
    intro j V V' h
    exact ((Limits.colimit.ι G j).naturality (homOfLE h).op).symm
  have hcV : ∀ V : U.Opens, Limits.IsColimit
      (((evaluation _ CommRingCat.{u}).obj (Opposite.op V)).mapCocone (Limits.colimit.cocone G)) :=
    fun V => Limits.isColimitOfPreserves _ (Limits.colimit.isColimit G)
  have hrep : ∀ (V : U.Opens) (x : Fc.obj (Opposite.op V)),
      ∃ (j : ℕ) (y : Γ(D.obj (Opposite.op j), π j ⁻¹ᵁ V)), (ιc j V).hom y = x := by
    intro V x
    obtain ⟨j, y, hy⟩ := Limits.Concrete.isColimit_exists_rep _ (hcV V) x
    exact ⟨j, y, hy⟩
  have hzero : ∀ (V : U.Opens) (j : ℕ) (y : Γ(D.obj (Opposite.op j), π j ⁻¹ᵁ V)),
      (ιc j V).hom y = 0 → ∃ (k : ℕ) (h : j ≤ k), (θ j k h V).hom y = 0 := by
    intro V j y hy
    have h0 : (ConcreteCategory.hom ((((evaluation _ CommRingCat.{u}).obj (Opposite.op V)).mapCocone
        (Limits.colimit.cocone G)).ι.app j)) y =
        (ConcreteCategory.hom ((((evaluation _ CommRingCat.{u}).obj (Opposite.op V)).mapCocone
        (Limits.colimit.cocone G)).ι.app j)) 0 := by
      rw [map_zero]; exact hy
    obtain ⟨k, f, g, hfg⟩ := (Limits.Concrete.isColimit_rep_eq_iff_exists _ (hcV V) y 0).mp h0
    refine ⟨k, leOfHom f, ?_⟩
    have e1 : (θ j k (leOfHom f) V).hom y =
        (ConcreteCategory.hom ((G ⋙ (evaluation _ CommRingCat.{u}).obj (Opposite.op V)).map f)) y := rfl
    rw [e1, hfg, map_zero]

  let F' : U.AffineZariskiSiteᵒᵖ ⥤ CommRingCat.{u} :=
    (Scheme.AffineZariskiSite.toOpensFunctor U).op ⋙ Fc
  let α : (Scheme.AffineZariskiSite.toOpensFunctor U).op ⋙ U.presheaf ⟶ F' :=
    { app := fun V => (π 0).app V.unop.1 ≫ ιc 0 V.unop.1
      naturality := by
        intro V V' i
        have h1 := (π 0).naturality ((Scheme.AffineZariskiSite.toOpensFunctor U).op.map i)
        have h2 := hnat 0 V.unop.1 V'.unop.1
          (leOfHom ((Scheme.AffineZariskiSite.toOpensFunctor U).map i.unop))
        have key := congrArg (· ≫ ιc 0 _) h1
        simp only [Category.assoc] at key
        refine key.trans ?_
        exact (congrArg ((π 0).app _ ≫ ·) h2.symm).trans (Category.assoc _ _ _).symm }
  have hcoeq : α.Coequifibered := by
    rw [Scheme.AffineZariskiSite.coequifibered_iff_forall_isLocalizationAway]
    intro V g
    have hVg : (V.basicOpen g).1 ≤ V.1 := Scheme.AffineZariskiSite.toOpens_mono (V.basicOpen_le g)
    have hlocal : ∀ k, @IsLocalization.Away Γ(D.obj (Opposite.op k), π k ⁻¹ᵁ V.1) _
        (((π k).app V.1).hom g) Γ(D.obj (Opposite.op k), π k ⁻¹ᵁ (V.basicOpen g).1) _
        ((D.obj (Opposite.op k)).presheaf.map (homOfLE ((π k).preimage_mono hVg)).op).hom.toAlgebra := by
      intro k
      haveI := hπaff k
      exact (V.2.preimage (π k)).isLocalization_of_eq_basicOpen _
        (homOfLE ((π k).preimage_mono hVg)) (Scheme.preimage_basicOpen (π k) g)
    exact H3a (fun k => Γ(D.obj (Opposite.op k), π k ⁻¹ᵁ V.1))
      (fun k => Γ(D.obj (Opposite.op k), π k ⁻¹ᵁ (V.basicOpen g).1))
      (Fc.obj (Opposite.op V.1)) (Fc.obj (Opposite.op (V.basicOpen g).1))
      (fun k => (ιc k V.1).hom) (fun k => (ιc k (V.basicOpen g).1).hom)
      (fun k => ((D.obj (Opposite.op k)).presheaf.map (homOfLE ((π k).preimage_mono hVg)).op).hom)
      (Fc.map (homOfLE hVg).op).hom
      (fun j k h => (θ j k h V.1).hom) (fun j k h => (θ j k h (V.basicOpen g).1).hom)
      (fun k => ((π k).app V.1).hom g)
      (fun j k h => congrArg CommRingCat.Hom.hom (hcoc j k h V.1))
      (fun j k h => congrArg CommRingCat.Hom.hom (hcoc j k h _))
      (fun k => congrArg CommRingCat.Hom.hom (hnat k V.1 _ hVg))
      (fun j k h => congrArg CommRingCat.Hom.hom (θnat j k h V.1 _ hVg))
      (fun j k h => congrArg (fun φ => φ.hom g) (θπ j k h V.1))
      hlocal
      (fun x => hrep V.1 x) (fun x => hrep _ x) (fun k y hy => hzero _ k y hy)

  let d := Scheme.AffineZariskiSite.relativeGluingData hcoeq
  haveI : (d.functor ⋙ Scheme.forget).IsLocallyDirected :=
    Scheme.Cover.RelativeGluingData.instIsLocallyDirectedI₀CompFunctorForgetOfIsThin ..
  let jV : ∀ V : U.AffineZariskiSite, Spec (F'.obj (Opposite.op V)) ⟶ d.glued :=
    fun V => Limits.colimit.ι d.functor V
  have hjo : ∀ V, IsOpenImmersion (jV V) := fun V =>
    MorphismProperty.of_isPullback (P := @IsOpenImmersion) (d.isPullback_natTrans_ι_toBase V)
      (inferInstanceAs (IsOpenImmersion V.1.ι))
  haveI hjo' : ∀ V, IsOpenImmersion (jV V) := hjo
  have hjp : ∀ V : U.AffineZariskiSite,
      jV V ≫ d.toBase = Spec.map (α.app (Opposite.op V)) ≫ V.2.fromSpec := by
    intro V
    have h1 : jV V ≫ d.toBase = d.natTrans.app V ≫ V.1.ι := d.ι_toBase V
    refine h1.trans ?_
    exact (Category.assoc (Spec.map (α.app (Opposite.op V))) V.2.isoSpec.inv V.1.ι).trans
      (congrArg (Spec.map (α.app (Opposite.op V)) ≫ ·) (IsAffineOpen.isoSpec_inv_ι V.2))
  have hpre : ∀ V : U.AffineZariskiSite, d.toBase ⁻¹ᵁ V.1 = (jV V).opensRange := by
    intro V
    have h := d.toBase_preimage_eq_opensRange_ι V
    have e : ((Scheme.AffineZariskiSite.directedCover U).f V).opensRange = V.1 :=
      Scheme.Opens.opensRange_ι V.1
    rw [e] at h
    exact h
  have hpaff : IsAffineHom d.toBase := by
    refine ⟨fun V hV => ?_⟩
    rw [hpre ⟨V, hV⟩]
    haveI := hjo ⟨V, hV⟩
    exact isAffineOpen_opensRange (jV ⟨V, hV⟩)

  have hnatk : ∀ k (V V' : U.AffineZariskiSite) (i : V ⟶ V'),
      Spec.map (F'.map i.op) ≫ Spec.map (ιc k V'.1) ≫ (hA k V'.1 V'.2).fromSpec =
        Spec.map (ιc k V.1) ≫ (hA k V.1 V.2).fromSpec := by
    intro k V V' i
    have h' : ιc k V'.1 ≫ F'.map i.op = (D.obj (Opposite.op k)).presheaf.map
        (homOfLE ((π k).preimage_mono (Scheme.AffineZariskiSite.toOpens_mono i.le))).op ≫ ιc k V.1 :=
      hnat k V'.1 V.1 (Scheme.AffineZariskiSite.toOpens_mono i.le)
    exact (Category.assoc _ _ _).symm.trans <|
      (congrArg (· ≫ (hA k V'.1 V'.2).fromSpec) (Spec.map_comp _ _).symm).trans <|
      (congrArg (fun φ => Spec.map φ ≫ (hA k V'.1 V'.2).fromSpec) h').trans <|
      (congrArg (· ≫ (hA k V'.1 V'.2).fromSpec) (Spec.map_comp _ _)).trans <|
      (Category.assoc _ _ _).trans <|
      congrArg (Spec.map (ιc k V.1) ≫ ·) (IsAffineOpen.map_fromSpec (hA k V'.1 V'.2) (hA k V.1 V.2) _)
  have tk : ∀ k, ∃ t : d.glued ⟶ D.obj (Opposite.op k), ∀ V : U.AffineZariskiSite,
      jV V ≫ t = Spec.map (ιc k V.1) ≫ (hA k V.1 V.2).fromSpec := by
    intro k
    refine ⟨Limits.colimit.desc d.functor
      { pt := D.obj (Opposite.op k)
        ι := { app := fun V => Spec.map (ιc k V.1) ≫ (hA k V.1 V.2).fromSpec
               naturality := ?_ } }, fun V => Limits.colimit.ι_desc _ _⟩
    intro V V' i
    exact (hnatk k V V' i).trans (Category.comp_id _).symm
  choose t ht' using tk
  have hαk : ∀ k (V : U.Opens), (π k).app V ≫ ιc k V = (π 0).app V ≫ ιc 0 V := by
    intro k V
    rw [← θπ 0 k (Nat.zero_le k) V, Category.assoc, hcoc]
  have ht_chart : ∀ k (V : U.AffineZariskiSite), jV V ≫ t k ≫ π k = jV V ≫ d.toBase := by
    intro k V
    have e : (π k).appLE V.1 (π k ⁻¹ᵁ V.1) le_rfl ≫ ιc k V.1 = α.app (Opposite.op V) :=
      (congrArg (· ≫ ιc k V.1) (Scheme.Hom.appLE_eq_app (π k))).trans (hαk k V.1)
    exact (Category.assoc _ _ _).symm.trans <|
      (congrArg (· ≫ π k) (ht' k V)).trans <|
      (Category.assoc _ _ _).trans <|
      (congrArg (Spec.map (ιc k V.1) ≫ ·)
        (IsAffineOpen.SpecMap_appLE_fromSpec (π k) V.2 (hA k V.1 V.2) le_rfl).symm).trans <|
      (Category.assoc _ _ _).symm.trans <|
      (congrArg (· ≫ V.2.fromSpec) (Spec.map_comp _ _).symm).trans <|
      (congrArg (fun φ => Spec.map φ ≫ V.2.fromSpec) e).trans (hjp V).symm
  have ht : ∀ k, t k ≫ π k = d.toBase := by
    intro k
    apply Limits.colimit.hom_ext
    intro V
    exact ht_chart k V
  have hc_chart : ∀ j k (h : j ≤ k) (V : U.AffineZariskiSite),
      jV V ≫ t k ≫ D.map (homOfLE h).op = jV V ≫ t j := by
    intro j k h V
    exact (Category.assoc _ _ _).symm.trans <|
      (congrArg (· ≫ D.map (homOfLE h).op) (ht' k V)).trans <|
      (Category.assoc _ _ _).trans <|
      (congrArg (Spec.map (ιc k V.1) ≫ ·)
        (IsAffineOpen.SpecMap_appLE_fromSpec (D.map (homOfLE h).op) (hA j V.1 V.2) (hA k V.1 V.2)
          (hle j k h V.1)).symm).trans <|
      (Category.assoc _ _ _).symm.trans <|
      (congrArg (· ≫ (hA j V.1 V.2).fromSpec) (Spec.map_comp _ _).symm).trans <|
      (congrArg (fun φ => Spec.map φ ≫ (hA j V.1 V.2).fromSpec) (hcoc j k h V.1)).trans (ht' j V).symm
  have hcompat : ∀ j k (h : j ≤ k), t k ≫ D.map (homOfLE h).op = t j := by
    intro j k h
    apply Limits.colimit.hom_ext
    intro V
    exact hc_chart j k h V

  have s7 : ∀ (R : CommRingCat.{u}) (jj : Spec R ⟶ d.glued) [IsOpenImmersion jj],
      ∃ e : R ⟶ Γ(d.glued, jj.opensRange), IsIso e ∧
        ∀ (X : Scheme.{u}) (tt : d.glued ⟶ X) (A : X.Opens) (hA' : IsAffineOpen A)
          (β : Γ(X, A) ⟶ R) (hle' : jj.opensRange ≤ tt ⁻¹ᵁ A),
          jj ≫ tt = Spec.map β ≫ hA'.fromSpec → tt.appLE A jj.opensRange hle' = β ≫ e := by
    intro R jj _
    have htop : (⊤ : (Spec R).Opens) ≤ jj ⁻¹ᵁ jj.opensRange := by
      rw [Scheme.Hom.preimage_opensRange]
    have hiso : IsIso (jj.appLE jj.opensRange ⊤ htop) := by
      haveI := Scheme.Hom.isIso_app jj jj.opensRange le_rfl
      have : homOfLE htop = eqToHom (Scheme.Hom.preimage_opensRange jj).symm :=
        Subsingleton.elim _ _
      simp only [Scheme.Hom.appLE, this]
      infer_instance
    refine ⟨(Scheme.ΓSpecIso R).inv ≫ inv (jj.appLE jj.opensRange ⊤ htop), inferInstance, ?_⟩
    intro X tt A hA' β hle' hch
    have e1 : (⊤ : (Spec Γ(X, A)).Opens) ≤ hA'.fromSpec ⁻¹ᵁ A := hA'.fromSpec_preimage_self.ge
    have hf : hA'.fromSpec.appLE A ⊤ e1 = (Scheme.ΓSpecIso Γ(X, A)).inv := by
      have hid : ∀ (g : (Opposite.op (⊤ : (Spec Γ(X, A)).Opens)) ⟶ Opposite.op ⊤),
          (Spec Γ(X, A)).presheaf.map g = 𝟙 _ := by
        intro g
        rw [show g = 𝟙 _ from Quiver.Hom.unop_inj (Subsingleton.elim _ _), CategoryTheory.Functor.map_id]
      simp only [Scheme.Hom.appLE, IsAffineOpen.fromSpec_app_self, Category.assoc]
      rw [← Functor.map_comp, hid, Category.comp_id]
    have hT : (Spec.map β).appLE ⊤ ⊤ (le_of_eq rfl) = (Spec.map β).appTop :=
      (Scheme.Hom.app_eq_appLE _).symm
    have hs : (Spec.map β).appLE ⊤ ⊤ (le_of_eq rfl) =
        (Scheme.ΓSpecIso Γ(X, A)).hom ≫ β ≫ (Scheme.ΓSpecIso R).inv := by
      rw [hT, ← Category.assoc, ← Scheme.ΓSpecIso_naturality, Category.assoc, Iso.hom_inv_id,
        Category.comp_id]
    rw [← cancel_mono (jj.appLE jj.opensRange ⊤ htop)]
    simp only [Category.assoc, IsIso.inv_hom_id, Category.comp_id]
    rw [Scheme.Hom.appLE_comp_appLE, hcongr _ _ hch,
      ← Scheme.Hom.appLE_comp_appLE (Spec.map β) hA'.fromSpec A ⊤ ⊤ e1 (le_of_eq rfl), hf, hs,
      Iso.inv_hom_id_assoc]

  have main : ∀ (V : U.Opens) (hV : IsAffineOpen V) (O : d.glued.Opens),
      O = @Scheme.Hom.opensRange _ _ (jV ⟨V, hV⟩) (hjo _) →
      (∀ (n : ℕ) (s : Fin n → Γ(d.glued, O)), ∃ (j : ℕ) (r : Fin n → Γ(D.obj (Opposite.op j), π j ⁻¹ᵁ V)),
        ∀ i, ∀ (hh : O ≤ t j ⁻¹ᵁ (π j ⁻¹ᵁ V)), ((t j).appLE (π j ⁻¹ᵁ V) O hh).hom (r i) = s i) ∧
      (∀ (j n : ℕ) (r : Fin n → Γ(D.obj (Opposite.op j), π j ⁻¹ᵁ V))
        (hh : O ≤ t j ⁻¹ᵁ (π j ⁻¹ᵁ V)),
        (∀ i, ((t j).appLE (π j ⁻¹ᵁ V) O hh).hom (r i) = 0) →
        ∃ (k : ℕ) (h : j ≤ k), ∀ i, (θ j k h V).hom (r i) = 0) := by
    intro V hV O hO
    subst hO
    obtain ⟨e, he_iso, he⟩ := @s7 _ (jV ⟨V, hV⟩) (hjo _)
    have hk : ∀ k (hh : @Scheme.Hom.opensRange _ _ (jV ⟨V, hV⟩) (hjo _) ≤ t k ⁻¹ᵁ (π k ⁻¹ᵁ V)),
        (t k).appLE (π k ⁻¹ᵁ V) _ hh = ιc k V ≫ e :=
      fun k hh => he _ (t k) (π k ⁻¹ᵁ V) (hA k V hV) (ιc k V) hh (ht' k ⟨V, hV⟩)
    have hb := ConcreteCategory.bijective_of_isIso e
    refine ⟨fun n s => ?_, fun j n r hh hr => ?_⟩
    · choose x hx using fun i => hb.2 (s i)
      have hx' : ∀ i, e.hom (x i) = s i := hx
      choose kk yy hyy using fun i => hrep V (x i)
      refine ⟨Finset.univ.sup kk, fun i => (θ (kk i) (Finset.univ.sup kk)
        (Finset.le_sup (Finset.mem_univ i)) V).hom (yy i), fun i hh => ?_⟩
      rw [hk _ hh]
      have h1 : (θ (kk i) (Finset.univ.sup kk) (Finset.le_sup (Finset.mem_univ i)) V ≫
          ιc (Finset.univ.sup kk) V).hom (yy i) = (ιc (kk i) V).hom (yy i) := by rw [hcoc]
      show e.hom ((ιc (Finset.univ.sup kk) V).hom ((θ (kk i) (Finset.univ.sup kk)
        (Finset.le_sup (Finset.mem_univ i)) V).hom (yy i))) = s i
      rw [show (ιc (Finset.univ.sup kk) V).hom ((θ (kk i) (Finset.univ.sup kk)
        (Finset.le_sup (Finset.mem_univ i)) V).hom (yy i)) = (θ (kk i) (Finset.univ.sup kk)
          (Finset.le_sup (Finset.mem_univ i)) V ≫ ιc (Finset.univ.sup kk) V).hom (yy i) from rfl,
        h1, hyy i, hx' i]
    · have hr' : ∀ i, (ιc j V).hom (r i) = 0 := by
        intro i
        have h2 := hr i
        rw [hk j hh] at h2
        apply hb.1
        exact h2.trans (map_zero (ConcreteCategory.hom e)).symm
      choose kk hkk hz using fun i => hzero V j (r i) (hr' i)
      refine ⟨max j (Finset.univ.sup kk), le_max_left _ _, fun i => ?_⟩
      have hKi : kk i ≤ max j (Finset.univ.sup kk) :=
        le_trans (Finset.le_sup (Finset.mem_univ i)) (le_max_right _ _)
      rw [← θcomp j (kk i) _ (hkk i) hKi V]
      show (θ (kk i) _ hKi V).hom ((θ j (kk i) (hkk i) V).hom (r i)) = 0
      rw [hz i, map_zero]

  refine ⟨d.glued, d.toBase, t, ht, hpaff, hcompat, ?_, ?_⟩
  · intro V hV n s
    obtain ⟨j, r, hr⟩ := (main V hV _ (hpre ⟨V, hV⟩)).1 n s
    exact ⟨j, r, fun i => hr i _⟩
  · intro V hV j n r hr
    exact (main V hV _ (hpre ⟨V, hV⟩)).2 j n r _ hr

theorem wc_affine_seq_limit_weaklyEtale : (∀ (R T : Type u) [CommRing R] [CommRing T] (σ : R →+* T) (G : ℕ → Type u)
    [∀ k, CommRing (G k)] (Φ : ∀ k, R →+* G k) (ι : ∀ k, G k →+* T),
    (∀ k, (ι k).comp (Φ k) = σ) → (∀ k, (Φ k).Etale) →
    (∀ (n : ℕ) (t : Fin n → T), ∃ (k : ℕ) (x : Fin n → G k), ∀ i, ι k (x i) = t i) →
    (∀ (k n : ℕ) (x : Fin n → G k), (∀ i, ι k (x i) = 0) → ∃ (j : ℕ) (θ : G k →+* G j),
      (ι j).comp θ = ι k ∧ θ.comp (Φ k) = Φ j ∧ ∀ i, θ (x i) = 0) →
    @Algebra.WeaklyEtale R T _ _ σ.toAlgebra) →
    (∀ (R S : Type u) [CommRing R] [CommRing S] [Algebra R S], Algebra.WeaklyEtale R S → WeaklyEtale (Spec.map (CommRingCat.ofHom (algebraMap R S)))) →
    ∀ (U : Scheme.{u}) (D : ℕᵒᵖ ⥤ Scheme.{u}) (π : ∀ j, D.obj (Opposite.op j) ⟶ U)
    (hπ : ∀ j k (h : j ≤ k), D.map (homOfLE h).op ≫ π j = π k)
    (W₀ : Scheme.{u}) (p : W₀ ⟶ U) (t : ∀ j, W₀ ⟶ D.obj (Opposite.op j))
    (ht : ∀ j, t j ≫ π j = p),
    (∀ j k (h : j ≤ k), t k ≫ D.map (homOfLE h).op = t j) →
    IsAffineHom p → (∀ j, IsAffineHom (π j)) → (∀ j, Etale (π j)) →
    (∀ V : U.Opens, IsAffineOpen V → ∀ (n : ℕ) (s : Fin n → Γ(W₀, p ⁻¹ᵁ V)),
      ∃ (j : ℕ) (r : Fin n → Γ(D.obj (Opposite.op j), π j ⁻¹ᵁ V)), ∀ i,
        ((t j).appLE (π j ⁻¹ᵁ V) (p ⁻¹ᵁ V) (by rw [← ht j]; exact le_rfl)).hom (r i) = s i) →
    (∀ V : U.Opens, IsAffineOpen V → ∀ (j n : ℕ)
      (r : Fin n → Γ(D.obj (Opposite.op j), π j ⁻¹ᵁ V)),
      (∀ i, ((t j).appLE (π j ⁻¹ᵁ V) (p ⁻¹ᵁ V) (by rw [← ht j]; exact le_rfl)).hom (r i) = 0) →
      ∃ (k : ℕ) (h : j ≤ k), ∀ i,
        ((D.map (homOfLE h).op).appLE (π j ⁻¹ᵁ V) (π k ⁻¹ᵁ V)
          (by rw [← hπ j k h]; exact le_rfl)).hom (r i) = 0) →
    WeaklyEtale p :=
by
  intro RWE SPEC U D π hπ W₀ p t ht hcompat hpaff hπaff hπet hREP hZERO
  haveI := hpaff
  have appLE_eq : ∀ {X Y : Scheme.{u}} (f g : X ⟶ Y) (h : f = g) (A : Y.Opens) (B : X.Opens)
      (e : B ≤ f ⁻¹ᵁ A), f.appLE A B e = g.appLE A B (h ▸ e) := by
    intro X Y f g h A B e
    subst h
    rfl

  have hring : ∀ V : U.Opens, IsAffineOpen V →
      @Algebra.WeaklyEtale Γ(U, V) Γ(W₀, p ⁻¹ᵁ V) _ _
        (p.appLE V (p ⁻¹ᵁ V) le_rfl).hom.toAlgebra := by
    intro V hV
    refine RWE Γ(U, V) Γ(W₀, p ⁻¹ᵁ V) (p.appLE V (p ⁻¹ᵁ V) le_rfl).hom
      (fun k => Γ(D.obj (Opposite.op k), π k ⁻¹ᵁ V))
      (fun k => ((π k).appLE V (π k ⁻¹ᵁ V) le_rfl).hom)
      (fun k => ((t k).appLE (π k ⁻¹ᵁ V) (p ⁻¹ᵁ V) (by rw [← ht k]; exact le_rfl)).hom)
      ?_ ?_ (hREP V hV) ?_
    · intro k
      show ((t k).appLE (π k ⁻¹ᵁ V) (p ⁻¹ᵁ V) _).hom.comp
          ((π k).appLE V (π k ⁻¹ᵁ V) le_rfl).hom = (p.appLE V (p ⁻¹ᵁ V) le_rfl).hom
      rw [← CommRingCat.hom_comp, Scheme.Hom.appLE_comp_appLE, appLE_eq _ _ (ht k)]
    · intro k
      haveI := hπaff k
      exact HasRingHomProperty.appLE @Etale (π k) (hπet k) ⟨V, hV⟩
        ⟨π k ⁻¹ᵁ V, hV.preimage (π k)⟩ le_rfl
    · intro k n x hx
      obtain ⟨k', hkk', hθ⟩ := hZERO V hV k n x hx
      refine ⟨k', ((D.map (homOfLE hkk').op).appLE (π k ⁻¹ᵁ V) (π k' ⁻¹ᵁ V)
        (by rw [← hπ k k' hkk']; exact le_rfl)).hom, ?_, ?_, hθ⟩
      · show ((t k').appLE (π k' ⁻¹ᵁ V) (p ⁻¹ᵁ V) _).hom.comp
            ((D.map (homOfLE hkk').op).appLE (π k ⁻¹ᵁ V) (π k' ⁻¹ᵁ V) _).hom =
          ((t k).appLE (π k ⁻¹ᵁ V) (p ⁻¹ᵁ V) _).hom
        rw [← CommRingCat.hom_comp, Scheme.Hom.appLE_comp_appLE,
          appLE_eq _ _ (hcompat k k' hkk')]
      · show ((D.map (homOfLE hkk').op).appLE (π k ⁻¹ᵁ V) (π k' ⁻¹ᵁ V) _).hom.comp
            ((π k).appLE V (π k ⁻¹ᵁ V) le_rfl).hom = ((π k').appLE V (π k' ⁻¹ᵁ V) le_rfl).hom
        rw [← CommRingCat.hom_comp, Scheme.Hom.appLE_comp_appLE, appLE_eq _ _ (hπ k k' hkk')]

  refine IsZariskiLocalAtTarget.of_iSup_eq_top (P := @WeaklyEtale)
    (fun i : U.affineOpens => (i : U.Opens)) (iSup_affineOpens_eq_top U) ?_
  rintro ⟨V, hV⟩
  show WeaklyEtale (p ∣_ V)
  haveI : IsAffine V := hV
  haveI : IsAffine (p ⁻¹ᵁ V) := hV.preimage p
  refine (MorphismProperty.arrow_mk_iso_iff @WeaklyEtale (arrowIsoSpecΓOfIsAffine (p ∣_ V))).mpr ?_
  show WeaklyEtale (Spec.map (p ∣_ V).appTop)
  rw [Scheme.Hom.appTop, Scheme.Hom.app_eq_appLE, morphismRestrict_appLE]
  refine (Scheme.Hom.appLE_congr p _ (Scheme.Opens.ι_image_top _)
    (by rw [Scheme.Hom.preimage_top, Scheme.Opens.ι_image_top])
    (fun φ => WeaklyEtale (Spec.map φ))).mpr ?_
  exact @SPEC Γ(U, V) Γ(W₀, p ⁻¹ᵁ V) _ _ (p.appLE V (p ⁻¹ᵁ V) le_rfl).hom.toAlgebra (hring V hV)

theorem wc_seq_colim_comap_surjective : ∀ (T : Type u) [CommRing T] (G : ℕ → Type u) [∀ k, CommRing (G k)] (ι : ∀ k, G k →+* T)
    (θ : ∀ j k, j ≤ k → (G j →+* G k)) (l : ℕ),
    (∀ j k (h : j ≤ k), (ι k).comp (θ j k h) = ι j) →
    (∀ i j k (h₁ : i ≤ j) (h₂ : j ≤ k), (θ j k h₂).comp (θ i j h₁) = θ i k (h₁.trans h₂)) →
    (∀ k (h : l ≤ k), Function.Surjective (PrimeSpectrum.comap (θ l k h))) →
    (∀ x : T, ∃ (k : ℕ) (y : G k), ι k y = x) →
    (∀ (k : ℕ) (y : G k), ι k y = 0 → ∃ (k' : ℕ) (h : k ≤ k'), θ k k' h y = 0) →
    Function.Surjective (PrimeSpectrum.comap (ι l)) :=
by
  intro T _ G _ ι θ l H1 H2 H3 H4 H5
  have hι : ∀ j k (h : j ≤ k) (y : G j), ι k (θ j k h y) = ι j y := fun j k h y => by
    rw [← RingHom.comp_apply, H1]
  have hθ : ∀ i j k (h₁ : i ≤ j) (h₂ : j ≤ k) (y : G i),
      θ j k h₂ (θ i j h₁ y) = θ i k (h₁.trans h₂) y := fun i j k h₁ h₂ y => by
    rw [← RingHom.comp_apply, H2]
  intro P
  have hP : ∀ j k (h₁ : l ≤ j) (h₂ : j ≤ k) (y : G j), y ∈ Ideal.map (θ l j h₁) P.asIdeal →
      θ j k h₂ y ∈ Ideal.map (θ l k (h₁.trans h₂)) P.asIdeal := by
    intro j k h₁ h₂ y hy
    have := Ideal.mem_map_of_mem (θ j k h₂) hy
    rwa [Ideal.map_map, H2] at this
  let J : Ideal T :=
    { carrier := {s | ∃ (K : ℕ) (h : l ≤ K) (y : G K), y ∈ Ideal.map (θ l K h) P.asIdeal ∧ ι K y = s}
      add_mem' := by
        rintro s₁ s₂ ⟨K₁, h₁, y₁, hy₁, rfl⟩ ⟨K₂, h₂, y₂, hy₂, rfl⟩
        refine ⟨max K₁ K₂, h₁.trans (le_max_left _ _),
          θ K₁ (max K₁ K₂) (le_max_left _ _) y₁ + θ K₂ (max K₁ K₂) (le_max_right _ _) y₂, ?_, ?_⟩
        · exact Ideal.add_mem _ (hP _ _ h₁ _ y₁ hy₁) (hP _ _ h₂ _ y₂ hy₂)
        · rw [map_add, hι, hι]
      zero_mem' := ⟨l, le_refl l, 0, Ideal.zero_mem _, map_zero _⟩
      smul_mem' := by
        rintro t s ⟨K, h, y, hy, rfl⟩
        obtain ⟨k, z, rfl⟩ := H4 t
        refine ⟨max k K, h.trans (le_max_right _ _),
          θ k (max k K) (le_max_left _ _) z * θ K (max k K) (le_max_right _ _) y, ?_, ?_⟩
        · exact Ideal.mul_mem_left _ _ (hP _ _ h _ y hy)
        · rw [map_mul, hι, hι, smul_eq_mul] }
  have hmapJ : Ideal.map (ι l) P.asIdeal ≤ J := by
    rw [Ideal.map_le_iff_le_comap]
    intro a ha
    exact ⟨l, le_refl l, θ l l (le_refl l) a, Ideal.mem_map_of_mem _ ha, hι _ _ _ a⟩
  have key : Ideal.comap (ι l) (Ideal.map (ι l) P.asIdeal) = P.asIdeal := by
    refine le_antisymm ?_ Ideal.le_comap_map
    intro x hx
    rw [Ideal.mem_comap] at hx
    obtain ⟨K, h, y, hy, hyx⟩ := hmapJ hx
    have h0 : ι K (θ l K h x - y) = 0 := by rw [map_sub, hι, hyx, sub_self]
    obtain ⟨K', h', hK'⟩ := H5 K _ h0
    rw [map_sub, sub_eq_zero, hθ] at hK'
    have hmem : θ l K' (h.trans h') x ∈ Ideal.map (θ l K' (h.trans h')) P.asIdeal := by
      rw [hK']; exact hP _ _ h h' y hy
    have hc := (PrimeSpectrum.mem_range_comap_iff (θ l K' (h.trans h'))).mp (H3 K' (h.trans h') P)
    rw [← hc, Ideal.mem_comap]
    exact hmem
  exact (PrimeSpectrum.mem_range_comap_iff (ι l)).mpr key

theorem wc_affine_seq_limit_proj_surjective : (∀ (T : Type u) [CommRing T] (G : ℕ → Type u) [∀ k, CommRing (G k)] (ι : ∀ k, G k →+* T)
    (θ : ∀ j k, j ≤ k → (G j →+* G k)) (l : ℕ),
    (∀ j k (h : j ≤ k), (ι k).comp (θ j k h) = ι j) →
    (∀ i j k (h₁ : i ≤ j) (h₂ : j ≤ k), (θ j k h₂).comp (θ i j h₁) = θ i k (h₁.trans h₂)) →
    (∀ k (h : l ≤ k), Function.Surjective (PrimeSpectrum.comap (θ l k h))) →
    (∀ x : T, ∃ (k : ℕ) (y : G k), ι k y = x) →
    (∀ (k : ℕ) (y : G k), ι k y = 0 → ∃ (k' : ℕ) (h : k ≤ k'), θ k k' h y = 0) →
    Function.Surjective (PrimeSpectrum.comap (ι l))) →
    ∀ (U : Scheme.{u}) (D : ℕᵒᵖ ⥤ Scheme.{u}) (π : ∀ j, D.obj (Opposite.op j) ⟶ U)
    (hπ : ∀ j k (h : j ≤ k), D.map (homOfLE h).op ≫ π j = π k)
    (W₀ : Scheme.{u}) (p : W₀ ⟶ U) (t : ∀ j, W₀ ⟶ D.obj (Opposite.op j))
    (ht : ∀ j, t j ≫ π j = p),
    (∀ j k (h : j ≤ k), t k ≫ D.map (homOfLE h).op = t j) →
    IsAffineHom p → (∀ j, IsAffineHom (π j)) →
    (∀ j k (h : j ≤ k), Surjective (D.map (homOfLE h).op)) →
    (∀ V : U.Opens, IsAffineOpen V → ∀ (n : ℕ) (s : Fin n → Γ(W₀, p ⁻¹ᵁ V)),
      ∃ (j : ℕ) (r : Fin n → Γ(D.obj (Opposite.op j), π j ⁻¹ᵁ V)), ∀ i,
        ((t j).appLE (π j ⁻¹ᵁ V) (p ⁻¹ᵁ V) (by rw [← ht j]; exact le_rfl)).hom (r i) = s i) →
    (∀ V : U.Opens, IsAffineOpen V → ∀ (j n : ℕ)
      (r : Fin n → Γ(D.obj (Opposite.op j), π j ⁻¹ᵁ V)),
      (∀ i, ((t j).appLE (π j ⁻¹ᵁ V) (p ⁻¹ᵁ V) (by rw [← ht j]; exact le_rfl)).hom (r i) = 0) →
      ∃ (k : ℕ) (h : j ≤ k), ∀ i,
        ((D.map (homOfLE h).op).appLE (π j ⁻¹ᵁ V) (π k ⁻¹ᵁ V)
          (by rw [← hπ j k h]; exact le_rfl)).hom (r i) = 0) →
    ∀ l, Surjective (t l) :=
by
  intro H U D π hπ W₀ p t ht hcompat hpaff hπaff hDsurj hREP hZERO l

  have sq : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y) (V : Y.Opens) (W : X.Opens) (hV : IsAffineOpen V)
      (hW : IsAffineOpen W) (e : W ≤ f ⁻¹ᵁ V) (Q : Spec Γ(X, W)),
      f (hW.fromSpec Q) = hV.fromSpec (Spec.map (f.appLE V W e) Q) := by
    intro X Y f V W hV hW e Q
    have hsq : Spec.map (f.appLE V W e) ≫ hV.fromSpec = hW.fromSpec ≫ f := by
      first
        | exact IsAffineOpen.SpecMap_appLE_fromSpec f hV hW e
        | exact IsAffineOpen.Spec_map_appLE_fromSpec f hV hW e
    rw [← Scheme.Hom.comp_apply, ← hsq, Scheme.Hom.comp_apply]

  have L3 : ∀ {X Y Z : Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ Z) (h : X ⟶ Z), f ≫ g = h →
      ∀ (U : Z.Opens) (V : Y.Opens) (W : X.Opens) (e₁ : V ≤ g ⁻¹ᵁ U) (e₂ : W ≤ f ⁻¹ᵁ V)
        (e₃ : W ≤ h ⁻¹ᵁ U),
      (f.appLE V W e₂).hom.comp (g.appLE U V e₁).hom = (h.appLE U W e₃).hom := by
    intro X Y Z f g h hfg U V W e₁ e₂ e₃
    subst hfg
    rw [← CommRingCat.hom_comp, Scheme.Hom.appLE_comp_appLE]

  have mem_range : ∀ {X : Scheme.{u}} (V : X.Opens) (hV : IsAffineOpen V) (y : X), y ∈ V →
      ∃ P : Spec Γ(X, V), hV.fromSpec P = y := by
    intro X V hV y hy
    have hy' : y ∈ Set.range hV.fromSpec := by rw [hV.range_fromSpec]; exact hy
    obtain ⟨P, hP⟩ := hy'
    exact ⟨P, hP⟩
  have fromSpec_mem : ∀ {X : Scheme.{u}} (V : X.Opens) (hV : IsAffineOpen V)
      (P : Spec Γ(X, V)), hV.fromSpec P ∈ V := by
    intro X V hV P
    have h : hV.fromSpec P ∈ Set.range hV.fromSpec := ⟨P, rfl⟩
    rw [hV.range_fromSpec] at h
    exact h
  constructor
  intro x
  obtain ⟨V, hV, hxV, -⟩ := exists_isAffineOpen_mem_and_subset (U := ⊤) (x := π l x) trivial
  have hA : ∀ k, IsAffineOpen (π k ⁻¹ᵁ V) := fun k => by
    have := hπaff k
    exact hV.preimage (π k)
  have hB : IsAffineOpen (p ⁻¹ᵁ V) := by
    have := hpaff
    exact hV.preimage p
  have hc : ∀ k (h : l ≤ k), Function.Surjective (PrimeSpectrum.comap
      ((D.map (homOfLE h).op).appLE (π l ⁻¹ᵁ V) (π k ⁻¹ᵁ V)
        (by rw [← hπ l k h]; exact le_rfl)).hom) := by
    intro k h P
    have hy := fromSpec_mem _ (hA l) P
    obtain ⟨z, hz⟩ := (hDsurj l k h).surj ((hA l).fromSpec P)
    have hzV : z ∈ π k ⁻¹ᵁ V := by
      show π k z ∈ V
      rw [← hπ l k h, Scheme.Hom.comp_apply]
      have hz' : (D.map (homOfLE h).op) z = (hA l).fromSpec P := hz
      rw [hz']
      exact hy
    obtain ⟨Q, hQ⟩ := mem_range _ (hA k) z hzV
    refine ⟨Q, ?_⟩
    have e1 := sq (D.map (homOfLE h).op) _ _ (hA l) (hA k)
      (by rw [← hπ l k h]; exact le_rfl) Q
    rw [hQ] at e1
    have hz' : (D.map (homOfLE h).op) z = (hA l).fromSpec P := hz
    rw [hz'] at e1
    have e3 := ((hA l).fromSpec.isOpenEmbedding.injective e1).symm
    first
      | exact e3
      | exact (Spec.map_apply _ _).symm.trans e3
      | (rw [Spec.map_apply] at e3; exact e3)
  have hH := H Γ(W₀, p ⁻¹ᵁ V) (fun k => Γ(D.obj (Opposite.op k), π k ⁻¹ᵁ V))
    (fun k => ((t k).appLE (π k ⁻¹ᵁ V) (p ⁻¹ᵁ V) (by rw [← ht k]; exact le_rfl)).hom)
    (fun j k h => ((D.map (homOfLE h).op).appLE (π j ⁻¹ᵁ V) (π k ⁻¹ᵁ V)
      (by rw [← hπ j k h]; exact le_rfl)).hom) l
    (fun j k h => L3 (t k) (D.map (homOfLE h).op) (t j) (hcompat j k h) _ _ _ _ _ _)
    (fun i j k h₁ h₂ => L3 _ _ _ (by rw [← D.map_comp]; rfl) _ _ _ _ _ _)
    hc
    (fun y => by
      obtain ⟨j, r, hr⟩ := hREP V hV 1 (fun _ => y)
      exact ⟨j, r 0, hr 0⟩)
    (fun k y hy => by
      obtain ⟨k', h, hk⟩ := hZERO V hV k 1 (fun _ => y) (fun _ => hy)
      exact ⟨k', h, hk 0⟩)
  obtain ⟨P, hP⟩ := mem_range _ (hA l) x hxV
  obtain ⟨Q, hQ⟩ := hH P
  refine ⟨hB.fromSpec Q, ?_⟩
  have e1 := sq (t l) _ _ (hA l) hB (by rw [← ht l]; exact le_rfl) Q
  rw [e1, ← hP]
  congr 1
  all_goals first
    | exact hQ
    | exact (Spec.map_apply _ _).trans hQ
    | (rw [Spec.map_apply]; exact hQ)

theorem wc_affine_seq_limit_connected : ∀ (U : Scheme.{u}) (D : ℕᵒᵖ ⥤ Scheme.{u}) (π : ∀ j, D.obj (Opposite.op j) ⟶ U)
    (hπ : ∀ j k (h : j ≤ k), D.map (homOfLE h).op ≫ π j = π k)
    (W₀ : Scheme.{u}) (p : W₀ ⟶ U) (t : ∀ j, W₀ ⟶ D.obj (Opposite.op j))
    (ht : ∀ j, t j ≫ π j = p),
    (∀ j k (h : j ≤ k), t k ≫ D.map (homOfLE h).op = t j) →
    CompactSpace U → QuasiSeparatedSpace U → IsAffineHom p → (∀ j, IsAffineHom (π j)) →
    (∀ j, ConnectedSpace (D.obj (Opposite.op j))) → (∀ j, Surjective (t j)) →
    (∀ V : U.Opens, IsAffineOpen V → ∀ (n : ℕ) (s : Fin n → Γ(W₀, p ⁻¹ᵁ V)),
      ∃ (j : ℕ) (r : Fin n → Γ(D.obj (Opposite.op j), π j ⁻¹ᵁ V)), ∀ i,
        ((t j).appLE (π j ⁻¹ᵁ V) (p ⁻¹ᵁ V) (by rw [← ht j]; exact le_rfl)).hom (r i) = s i) →
    (∀ V : U.Opens, IsAffineOpen V → ∀ (j n : ℕ)
      (r : Fin n → Γ(D.obj (Opposite.op j), π j ⁻¹ᵁ V)),
      (∀ i, ((t j).appLE (π j ⁻¹ᵁ V) (p ⁻¹ᵁ V) (by rw [← ht j]; exact le_rfl)).hom (r i) = 0) →
      ∃ (k : ℕ) (h : j ≤ k), ∀ i,
        ((D.map (homOfLE h).op).appLE (π j ⁻¹ᵁ V) (π k ⁻¹ᵁ V)
          (by rw [← hπ j k h]; exact le_rfl)).hom (r i) = 0) →
    ConnectedSpace W₀ :=
by
  intro U D π hπ W₀ p t ht hcompat hcpt hqs hpaff hπaff hDconn htsurj hREP hZERO

  have s1 : ∃ (m : ℕ) (V : Fin m → U.Opens), (∀ a, IsAffineOpen (V a)) ∧
      ∀ x : U, ∃ a, x ∈ V a := by
    have hW : ∀ x : U, ∃ W : U.Opens, IsAffineOpen W ∧ x ∈ W := by
      intro x
      obtain ⟨W, hW, hxW, -⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp
        (Scheme.isBasis_affineOpens U)) (show x ∈ (⊤ : U.Opens) from trivial)
      exact ⟨W, hW, hxW⟩
    choose W hWaff hWmem using hW
    obtain ⟨s, hs⟩ := isCompact_univ.elim_finite_subcover (fun x => (W x : Set U))
      (fun x => (W x).isOpen) (fun y _ => Set.mem_iUnion.mpr ⟨y, hWmem y⟩)
    refine ⟨s.card, fun a => W (s.equivFin.symm a).1, fun a => hWaff _, ?_⟩
    intro x
    have hx := hs (Set.mem_univ x)
    simp only [Set.mem_iUnion] at hx
    obtain ⟨y, hy, hxy⟩ := hx
    refine ⟨s.equivFin ⟨y, hy⟩, ?_⟩
    simp only [Equiv.symm_apply_apply]
    exact hxy

  have s2 : ∀ (B : W₀.Opens), IsAffineOpen B → ∀ (A : Set W₀), IsClopen A →
      ∃ e : Γ(W₀, B), (W₀.basicOpen e : Set W₀) = A ∩ (B : Set W₀) := by
    intro B hB A hA
    obtain ⟨e, -, he⟩ := @PrimeSpectrum.exists_idempotent_basicOpen_eq_of_isClopen Γ(W₀, B) _
      (hB.fromSpec ⁻¹' A) (hA.preimage hB.fromSpec.continuous)
    refine ⟨e, ?_⟩
    have h1 : hB.fromSpec ⁻¹' (W₀.basicOpen e : Set W₀) = hB.fromSpec ⁻¹' A := by
      have h0 := congrArg SetLike.coe (hB.fromSpec_preimage_basicOpen e)
      first
        | exact h0.trans he.symm
        | exact Eq.trans h0 (Eq.symm he)
        | (convert h0 using 1; exact he)
    have h2 : ∀ Z : Set W₀, hB.fromSpec '' (hB.fromSpec ⁻¹' Z) = Z ∩ B := by
      intro Z
      rw [Set.image_preimage_eq_inter_range, hB.range_fromSpec]
    have h3 : (W₀.basicOpen e : Set W₀) ⊆ B := Scheme.basicOpen_le W₀ e
    rw [← h2 A, ← h1, h2, Set.inter_eq_left.mpr h3]

  have s3 : ∀ (V : U.Opens), IsAffineOpen V → ∀ (e : Γ(W₀, p ⁻¹ᵁ V)), ∃ k₀ : ℕ, ∀ k, k₀ ≤ k →
      ∃ O : (D.obj (Opposite.op k)).Opens, t k ⁻¹ᵁ O = W₀.basicOpen e := by
    intro V hV e
    obtain ⟨j, r, hr⟩ := hREP V hV 1 (fun _ => e)
    have hstar : W₀.basicOpen e = t j ⁻¹ᵁ (D.obj (Opposite.op j)).basicOpen (r 0) := by
      have h1 := Scheme.basicOpen_appLE (t j) (p ⁻¹ᵁ V) (π j ⁻¹ᵁ V)
        (by rw [← ht j]; exact le_rfl) (r 0)
      rw [hr 0] at h1
      refine h1.trans ?_
      apply inf_eq_right.mpr
      intro x hx
      have hx' : t j x ∈ π j ⁻¹ᵁ V :=
        SetLike.le_def.mp (Scheme.basicOpen_le _ (r 0)) hx
      show p x ∈ V
      rw [← ht j, Scheme.Hom.comp_apply]
      exact hx'
    refine ⟨j, fun k hk => ⟨D.map (homOfLE hk).op ⁻¹ᵁ (D.obj (Opposite.op j)).basicOpen (r 0), ?_⟩⟩
    rw [← Scheme.Hom.comp_preimage, hcompat j k hk, hstar]

  have hne : Nonempty W₀ := by
    have := hDconn 0
    obtain ⟨y⟩ : Nonempty (D.obj (Opposite.op 0)) := inferInstance
    obtain ⟨w, -⟩ := (htsurj 0).surj y
    exact ⟨w⟩
  have hpre : ∀ A : Set W₀, IsClopen A → A = ∅ ∨ A = Set.univ := by
    intro A hA
    obtain ⟨m, V, hVaff, hVcov⟩ := s1
    have hB : ∀ a, IsAffineOpen (p ⁻¹ᵁ V a) := fun a => (hVaff a).preimage p
    choose e he using fun a => s2 _ (hB a) A hA
    choose e' he' using fun a => s2 _ (hB a) Aᶜ hA.compl
    choose κ hκ using fun a => s3 (V a) (hVaff a) (e a)
    choose κ' hκ' using fun a => s3 (V a) (hVaff a) (e' a)
    obtain ⟨k, hk⟩ : ∃ k, k = Finset.univ.sup (fun a : Fin m => max (κ a) (κ' a)) := ⟨_, rfl⟩
    have hkk : ∀ a, κ a ≤ k ∧ κ' a ≤ k := fun a => by
      have := Finset.le_sup (f := fun a : Fin m => max (κ a) (κ' a)) (Finset.mem_univ a)
      rw [← hk] at this
      exact ⟨le_trans (le_max_left _ _) this, le_trans (le_max_right _ _) this⟩
    choose O hO using fun a => hκ a k (hkk a).1
    choose P hP using fun a => hκ' a k (hkk a).2
    have := hDconn k
    obtain ⟨O', hO'⟩ : ∃ S : Set (D.obj (Opposite.op k)), S = ⋃ a, (O a : Set _) := ⟨_, rfl⟩
    obtain ⟨P', hP'⟩ : ∃ S : Set (D.obj (Opposite.op k)), S = ⋃ a, (P a : Set _) := ⟨_, rfl⟩
    have hOA : ∀ w, t k w ∈ O' ↔ w ∈ A := by
      intro w
      rw [hO', Set.mem_iUnion]
      constructor
      · rintro ⟨a, ha⟩
        have h1 : w ∈ (W₀.basicOpen (e a) : Set W₀) := by rw [← hO a]; exact ha
        rw [he a] at h1
        exact h1.1
      · intro hw
        obtain ⟨a, ha⟩ := hVcov (p w)
        refine ⟨a, ?_⟩
        have h1 : w ∈ (W₀.basicOpen (e a) : Set W₀) := by rw [he a]; exact ⟨hw, ha⟩
        rw [← hO a] at h1
        exact h1
    have hPA : ∀ w, t k w ∈ P' ↔ w ∉ A := by
      intro w
      rw [hP', Set.mem_iUnion]
      constructor
      · rintro ⟨a, ha⟩
        have h1 : w ∈ (W₀.basicOpen (e' a) : Set W₀) := by rw [← hP a]; exact ha
        rw [he' a] at h1
        exact h1.1
      · intro hw
        obtain ⟨a, ha⟩ := hVcov (p w)
        refine ⟨a, ?_⟩
        have h1 : w ∈ (W₀.basicOpen (e' a) : Set W₀) := by rw [he' a]; exact ⟨hw, ha⟩
        rw [← hP a] at h1
        exact h1
    have hOopen : IsOpen O' := by rw [hO']; exact isOpen_iUnion fun a => (O a).isOpen
    have hPopen : IsOpen P' := by rw [hP']; exact isOpen_iUnion fun a => (P a).isOpen
    have hc : O'ᶜ = P' := by
      ext y
      obtain ⟨w, rfl⟩ := (htsurj k).surj y
      rw [Set.mem_compl_iff, hOA, hPA]
    have hOclopen : IsClopen O' := ⟨by rw [← isOpen_compl_iff, hc]; exact hPopen, hOopen⟩
    rcases isClopen_iff.mp hOclopen with h | h
    · left
      ext w
      rw [← hOA w, h]
      simp
    · right
      ext w
      rw [← hOA w, h]
      simp
  exact { toPreconnectedSpace := preconnectedSpace_iff_clopen.mpr hpre, toNonempty := hne }

theorem wc_hom_ext_affine_open_appLE : ∀ (T X : Scheme.{u}) (A : X.Opens), IsAffineOpen A →
    ∀ (f g : T ⟶ X) (hf : ⊤ ≤ f ⁻¹ᵁ A) (hg : ⊤ ≤ g ⁻¹ᵁ A), f.appLE A ⊤ hf = g.appLE A ⊤ hg → f = g :=
by
  intro T X A hA f g hf hg heq
  have : IsAffine (A : Scheme) := hA
  have hrf : Set.range f ⊆ Set.range A.ι := by
    rintro _ ⟨x, rfl⟩
    rw [Scheme.Opens.range_ι]
    exact (Scheme.Hom.mem_preimage f).mp (hf (Set.mem_univ x))
  have hrg : Set.range g ⊆ Set.range A.ι := by
    rintro _ ⟨x, rfl⟩
    rw [Scheme.Opens.range_ι]
    exact (Scheme.Hom.mem_preimage g).mp (hg (Set.mem_univ x))
  obtain ⟨f', rfl⟩ : ∃ f', f' ≫ A.ι = f := ⟨_, IsOpenImmersion.lift_fac _ _ hrf⟩
  obtain ⟨g', rfl⟩ : ∃ g', g' ≫ A.ι = g := ⟨_, IsOpenImmersion.lift_fac _ _ hrg⟩
  have e1 : (⊤ : (A : Scheme).Opens) ≤ A.ι ⁻¹ᵁ A := (Scheme.Opens.ι_preimage_self A).ge
  rw [← Scheme.Hom.appLE_comp_appLE f' A.ι A ⊤ ⊤ e1 le_top,
    ← Scheme.Hom.appLE_comp_appLE g' A.ι A ⊤ ⊤ e1 le_top] at heq
  rw [cancel_epi] at heq
  have h2 : f'.appTop = g'.appTop := by
    simpa [Scheme.Hom.appTop, Scheme.Hom.app_eq_appLE] using heq
  rw [ext_of_isAffine h2]

theorem wc_fin_alg_hom_card_bound : ∀ (A B : Type u) [CommRing A] [CommRing B] [Algebra A B]
    [Module.Finite A B], ∃ N : ℕ, ∀ (K : Type u) [Field K] (φ : A →+* K) (k : ℕ)
    (ψ : Fin k → (B →+* K)), (∀ i, (ψ i).comp (algebraMap A B) = φ) → Function.Injective ψ → k ≤ N :=
by
  intro A B _ _ _ _
  obtain ⟨n, s, hs⟩ := Module.Finite.exists_fin (R := A) (M := B)
  refine ⟨n, ?_⟩
  intro K _ φ k ψ hcomp hinj
  have hsmul : ∀ i (a : A) (b : B), ψ i (a • b) = φ a * ψ i b := by
    intro i a b
    rw [Algebra.smul_def, map_mul, ← RingHom.comp_apply, hcomp i]
  have hLI0 := linearIndependent_monoidHom B K
  have hτ : Function.Injective (fun i : Fin k => (ψ i : B →* K)) := by
    intro i i' h
    apply hinj
    ext x
    exact DFunLike.congr_fun h x
  have hLI : LinearIndependent K (fun i : Fin k => (⇑(ψ i) : B → K)) := hLI0.comp _ hτ
  have hv : LinearIndependent K (fun i : Fin k => fun j : Fin n => ψ i (s j)) := by
    rw [Fintype.linearIndependent_iff] at hLI ⊢
    intro g hg
    apply hLI g
    funext b
    have hstar : ∀ j, ∑ i, g i * ψ i (s j) = 0 := by
      intro j
      have := congrFun hg j
      simpa [Finset.sum_apply, Pi.smul_apply, smul_eq_mul] using this
    have hb : b ∈ Submodule.span A (Set.range s) := by rw [hs]; trivial
    obtain ⟨a, rfl⟩ := (Submodule.mem_span_range_iff_exists_fun A).mp hb
    simp only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul, Pi.zero_apply, map_sum, hsmul]
    calc ∑ i, g i * ∑ j, φ (a j) * ψ i (s j) = ∑ j, φ (a j) * ∑ i, g i * ψ i (s j) := by
          simp only [Finset.mul_sum]
          rw [Finset.sum_comm]
          exact Finset.sum_congr rfl (fun _ _ => Finset.sum_congr rfl (fun _ _ => by ring))
      _ = 0 := by simp [hstar]
  have := hv.fintype_card_le_finrank
  simpa using this

theorem wc_fet_field_point_section_bound : (∀ (T X : Scheme.{u}) (A : X.Opens), IsAffineOpen A →
      ∀ (f g : T ⟶ X) (hf : ⊤ ≤ f ⁻¹ᵁ A) (hg : ⊤ ≤ g ⁻¹ᵁ A),
      f.appLE A ⊤ hf = g.appLE A ⊤ hg → f = g) →
    (∀ (A B : Type u) [CommRing A] [CommRing B] [Algebra A B]
      [Module.Finite A B], ∃ N : ℕ, ∀ (K : Type u) [Field K] (φ : A →+* K) (k : ℕ)
      (ψ : Fin k → (B →+* K)), (∀ i, (ψ i).comp (algebraMap A B) = φ) → Function.Injective ψ →
      k ≤ N) →
    ∀ (U F : Scheme.{u}) (f : F ⟶ U), IsFinite f → ∀ u₀ : U, ∃ N : ℕ,
      ∀ (K : Type u) [Field K] (y : Spec (.of K) ⟶ U), y (IsLocalRing.closedPoint K) = u₀ →
      ∀ (k : ℕ) (s : Fin k → (Spec (.of K) ⟶ F)), (∀ i, s i ≫ f = y) → Function.Injective s → k ≤ N :=
by
  intro hL0 hL2 U F f hf u₀
  haveI := hf
  obtain ⟨V, hV, hu₀, -⟩ := exists_isAffineOpen_mem_and_subset (x := u₀) (U := ⊤) trivial
  have hV' : IsAffineOpen (f ⁻¹ᵁ V) := hV.preimage f
  letI : Algebra Γ(U, V) Γ(F, f ⁻¹ᵁ V) := (f.app V).hom.toAlgebra
  haveI : Module.Finite Γ(U, V) Γ(F, f ⁻¹ᵁ V) := IsFinite.finite_app f V hV
  obtain ⟨N, hN⟩ := hL2 Γ(U, V) Γ(F, f ⁻¹ᵁ V)
  refine ⟨N, ?_⟩
  intro K _ y hy k s hs hinj
  have hyV : ⊤ ≤ y ⁻¹ᵁ V := by
    intro x _
    have hx : y x = u₀ := by
      rw [← hy]
      exact congrArg _ (Subsingleton.elim _ _)
    rw [Scheme.Hom.mem_preimage, hx]
    exact hu₀
  have hsV : ∀ i, ⊤ ≤ s i ⁻¹ᵁ (f ⁻¹ᵁ V) := by
    intro i
    have h := hyV
    rw [← hs i] at h
    exact h
  have hcongr : ∀ {X Y : Scheme.{u}} (g g' : X ⟶ Y), g = g' → ∀ (W : Y.Opens) (W' : X.Opens)
      (e : W' ≤ g ⁻¹ᵁ W) (e' : W' ≤ g' ⁻¹ᵁ W), g.appLE W W' e = g'.appLE W W' e' := by
    intro X Y g g' h W W' e e'
    subst h
    rfl
  refine hN K ((y.appLE V ⊤ hyV ≫ (Scheme.ΓSpecIso (CommRingCat.of K)).hom).hom) k
    (fun i => ((s i).appLE (f ⁻¹ᵁ V) ⊤ (hsV i) ≫ (Scheme.ΓSpecIso (CommRingCat.of K)).hom).hom)
    ?_ ?_
  · intro i
    have h1 : f.app V ≫ (s i).appLE (f ⁻¹ᵁ V) ⊤ (hsV i) = y.appLE V ⊤ hyV :=
      (Scheme.Hom.comp_appLE (s i) f V ⊤ (hsV i)).symm.trans (hcongr _ _ (hs i) _ _ _ _)
    exact congrArg (fun m => (m ≫ (Scheme.ΓSpecIso (CommRingCat.of K)).hom).hom) h1
  · intro i j hij
    apply hinj
    apply hL0 (Spec (.of K)) F (f ⁻¹ᵁ V) hV' (s i) (s j) (hsV i) (hsV j)
    have h2 : (s i).appLE (f ⁻¹ᵁ V) ⊤ (hsV i) ≫ (Scheme.ΓSpecIso (CommRingCat.of K)).hom =
        (s j).appLE (f ⁻¹ᵁ V) ⊤ (hsV j) ≫ (Scheme.ΓSpecIso (CommRingCat.of K)).hom :=
      CommRingCat.hom_ext hij
    exact (Iso.cancel_iso_hom_right _ _ _).mp h2

theorem wc_fet_frame_component_galois : (∀ (U E T : Scheme.{u}) (e : E ⟶ U), Etale e → IsSeparated e →
      ∀ (f f' : T ⟶ E) (h : f ≫ e = f' ≫ e), ConnectedSpace T →
      (∃ x : T, (Limits.pullback.lift f f' h) x ∈ Set.range (Limits.pullback.diagonal e)) →
      f = f') →
    ∀ (U F : Scheme.{u}) (f : F ⟶ U), Etale f → IsSeparated f → ∀ (k : ℕ)
      (C : ((Limits.widePullback U (fun _ : Fin k => F) (fun _ => f) : Scheme.{u})).Opens),
      IsClosed (C : Set ((Limits.widePullback U (fun _ : Fin k => F) (fun _ => f) : Scheme.{u}))) →
      _root_.IsPreconnected (C : Set ((Limits.widePullback U (fun _ : Fin k => F) (fun _ => f) : Scheme.{u}))) →
      (∀ z ∈ C, ∀ i j : Fin k, i ≠ j →
        (Limits.pullback.lift (Limits.WidePullback.π (fun _ : Fin k => f) i)
          (Limits.WidePullback.π (fun _ : Fin k => f) j)
          ((Limits.WidePullback.π_arrow (fun _ : Fin k => f) i).trans
            (Limits.WidePullback.π_arrow (fun _ : Fin k => f) j).symm)) z ∉
          Set.range (Limits.pullback.diagonal f)) →
      (∀ z : (Limits.widePullback U (fun _ : Fin (k + 1) => F) (fun _ => f) : Scheme.{u}),
        ∃ i j : Fin (k + 1), i ≠ j ∧
        (Limits.pullback.lift (Limits.WidePullback.π (fun _ : Fin (k + 1) => f) i)
          (Limits.WidePullback.π (fun _ : Fin (k + 1) => f) j)
          ((Limits.WidePullback.π_arrow (fun _ : Fin (k + 1) => f) i).trans
            (Limits.WidePullback.π_arrow (fun _ : Fin (k + 1) => f) j).symm)) z ∈
          Set.range (Limits.pullback.diagonal f)) →
      ∀ (V : Scheme.{u}) (a b : V ⟶ C.toScheme), ConnectedSpace V →
        a ≫ C.ι ≫ Limits.WidePullback.base (fun _ : Fin k => f) =
          b ≫ C.ι ≫ Limits.WidePullback.base (fun _ : Fin k => f) →
        ∃ γ : C.toScheme ⟶ C.toScheme,
          γ ≫ C.ι ≫ Limits.WidePullback.base (fun _ : Fin k => f) =
            C.ι ≫ Limits.WidePullback.base (fun _ : Fin k => f) ∧ b = a ≫ γ :=
by
  intro RIG U F f hfet hfsep k C hCcl hCpre hINJ hMAX V a b hV hab
  classical
  obtain ⟨v₀⟩ := (inferInstance : Nonempty V)

  have hmemι : ∀ w : C.toScheme, C.ι w ∈ C := by
    intro w
    have h1 : C.ι w ∈ Set.range C.ι := ⟨w, rfl⟩
    rwa [Scheme.Opens.range_ι] at h1
  have hxC : ∀ v : V, (a ≫ C.ι) v ∈ C := fun v => by
    rw [Scheme.Hom.comp_apply]; exact hmemι (a v)
  have hyC : ∀ v : V, (b ≫ C.ι) v ∈ C := fun v => by
    rw [Scheme.Hom.comp_apply]; exact hmemι (b v)

  have hmatch : ∀ i : Fin k, ∃ m : Fin k,
      (a ≫ C.ι) ≫ Limits.WidePullback.π (fun _ : Fin k => f) m =
        (b ≫ C.ι) ≫ Limits.WidePullback.π (fun _ : Fin k => f) i := by
    intro i
    obtain ⟨c, hcl, hcc⟩ : ∃ c : Fin (k + 1) → (V ⟶ F),
        c (Fin.last k) = (b ≫ C.ι) ≫ Limits.WidePullback.π (fun _ : Fin k => f) i ∧
        ∀ m : Fin k, c m.castSucc = (a ≫ C.ι) ≫ Limits.WidePullback.π (fun _ : Fin k => f) m :=
      ⟨Fin.lastCases (motive := fun _ => V ⟶ F)
          ((b ≫ C.ι) ≫ Limits.WidePullback.π (fun _ : Fin k => f) i)
          (fun m => (a ≫ C.ι) ≫ Limits.WidePullback.π (fun _ : Fin k => f) m),
        by rw [Fin.lastCases_last], fun m => by rw [Fin.lastCases_castSucc]⟩
    have hw : ∀ j, c j ≫ f = (a ≫ C.ι) ≫ Limits.WidePullback.base (fun _ : Fin k => f) := by
      intro j
      refine Fin.lastCases ?_ (fun m => ?_) j
      · rw [hcl]
        simp only [Category.assoc, Limits.WidePullback.π_arrow]
        exact hab.symm
      · rw [hcc]
        simp only [Category.assoc, Limits.WidePullback.π_arrow]
    obtain ⟨z, hzπ⟩ : ∃ z : V ⟶ (Limits.widePullback U (fun _ : Fin (k + 1) => F) (fun _ => f) : Scheme.{u}),
        ∀ j, z ≫ Limits.WidePullback.π (fun _ : Fin (k + 1) => f) j = c j :=
      ⟨Limits.WidePullback.lift ((a ≫ C.ι) ≫ Limits.WidePullback.base (fun _ : Fin k => f)) c hw,
        fun j => Limits.WidePullback.lift_π _ _ _ _ _⟩
    obtain ⟨i', j', hne, hmem⟩ := hMAX (z v₀)
    have hcij : c i' ≫ f = c j' ≫ f := (hw i').trans (hw j').symm
    have key : z ≫ Limits.pullback.lift (Limits.WidePullback.π (fun _ : Fin (k + 1) => f) i')
          (Limits.WidePullback.π (fun _ : Fin (k + 1) => f) j')
          ((Limits.WidePullback.π_arrow (fun _ : Fin (k + 1) => f) i').trans
            (Limits.WidePullback.π_arrow (fun _ : Fin (k + 1) => f) j').symm) =
        Limits.pullback.lift (c i') (c j') hcij := by
      apply Limits.pullback.hom_ext
      · simp only [Category.assoc, Limits.pullback.lift_fst, hzπ]
      · simp only [Category.assoc, Limits.pullback.lift_snd, hzπ]
    have hmem' : (Limits.pullback.lift (c i') (c j') hcij) v₀ ∈
        Set.range (Limits.pullback.diagonal f) := by
      rw [← key, Scheme.Hom.comp_apply]
      exact hmem
    rcases Fin.eq_castSucc_or_eq_last i' with ⟨p, rfl⟩ | rfl <;>
      rcases Fin.eq_castSucc_or_eq_last j' with ⟨q, rfl⟩ | rfl
    ·
      exfalso
      have hpq : p ≠ q := fun h => hne (by rw [h])
      have key2 : (a ≫ C.ι) ≫ Limits.pullback.lift (Limits.WidePullback.π (fun _ : Fin k => f) p)
            (Limits.WidePullback.π (fun _ : Fin k => f) q)
            ((Limits.WidePullback.π_arrow (fun _ : Fin k => f) p).trans
              (Limits.WidePullback.π_arrow (fun _ : Fin k => f) q).symm) =
          Limits.pullback.lift (c p.castSucc) (c q.castSucc) hcij := by
        apply Limits.pullback.hom_ext
        · simp only [Category.assoc, Limits.pullback.lift_fst, hcc]
        · simp only [Category.assoc, Limits.pullback.lift_snd, hcc]
      apply hINJ _ (hxC v₀) p q hpq
      rw [← Scheme.Hom.comp_apply, key2]
      exact hmem'
    · refine ⟨p, ?_⟩
      have := RIG U F V f hfet hfsep _ _ hcij hV ⟨v₀, hmem'⟩
      rw [hcc, hcl] at this
      exact this
    · refine ⟨q, ?_⟩
      have := RIG U F V f hfet hfsep _ _ hcij hV ⟨v₀, hmem'⟩
      rw [hcc, hcl] at this
      exact this.symm
    · exact absurd rfl hne

  choose σ hσ using hmatch
  obtain ⟨γt, hγπ, hγb⟩ : ∃ γt : (Limits.widePullback U (fun _ : Fin k => F) (fun _ => f) : Scheme.{u}) ⟶
      (Limits.widePullback U (fun _ : Fin k => F) (fun _ => f) : Scheme.{u}),
      (∀ i, γt ≫ Limits.WidePullback.π (fun _ : Fin k => f) i =
        Limits.WidePullback.π (fun _ : Fin k => f) (σ i)) ∧
      γt ≫ Limits.WidePullback.base (fun _ : Fin k => f) =
        Limits.WidePullback.base (fun _ : Fin k => f) :=
    ⟨Limits.WidePullback.lift (Limits.WidePullback.base (fun _ : Fin k => f))
        (fun i => Limits.WidePullback.π (fun _ : Fin k => f) (σ i))
        (fun i => Limits.WidePullback.π_arrow (fun _ : Fin k => f) (σ i)),
      fun i => Limits.WidePullback.lift_π _ _ _ _ _, Limits.WidePullback.lift_base _ _ _ _⟩
  have hcomp : a ≫ C.ι ≫ γt = b ≫ C.ι := by
    apply Limits.WidePullback.hom_ext (fun _ : Fin k => f)
    · intro j
      simp only [Category.assoc, hγπ]
      simpa only [Category.assoc] using hσ j
    · simp only [Category.assoc, hγb]
      exact hab
  have hS : IsClopen (γt ⁻¹' (C : Set (Limits.widePullback U (fun _ : Fin k => F) (fun _ => f) : Scheme.{u}))) :=
    ⟨hCcl.preimage γt.continuous, C.isOpen.preimage γt.continuous⟩
  have hx0 : γt ((a ≫ C.ι) v₀) ∈ C := by
    rw [← Scheme.Hom.comp_apply, Category.assoc, hcomp]
    exact hyC v₀
  have hsub := hCpre.subset_isClopen hS ⟨_, hxC v₀, hx0⟩
  have hrange : Set.range (C.ι ≫ γt) ⊆ Set.range C.ι := by
    rintro _ ⟨w, rfl⟩
    rw [Scheme.Opens.range_ι, Scheme.Hom.comp_apply]
    exact hsub (hmemι w)
  refine ⟨IsOpenImmersion.lift C.ι (C.ι ≫ γt) hrange, ?_, ?_⟩
  · rw [← Category.assoc, IsOpenImmersion.lift_fac, Category.assoc, hγb]
  · rw [← cancel_mono C.ι, Category.assoc, IsOpenImmersion.lift_fac, hcomp]

theorem wc_fet_galois_closure : (∀ {B Z : Scheme.{u}} (p : Z ⟶ B) [Etale p] (N : ℕ),
      Etale (Limits.WidePullback.base (fun _ : Fin N => p))) →
    (∀ (U F : Scheme.{u}) (f : F ⟶ U), IsFinite f → ∀ u₀ : U, ∃ N : ℕ,
      ∀ (K : Type u) [Field K] (y : Spec (.of K) ⟶ U), y (IsLocalRing.closedPoint K) = u₀ →
      ∀ (k : ℕ) (s : Fin k → (Spec (.of K) ⟶ F)), (∀ i, s i ≫ f = y) → Function.Injective s →
      k ≤ N) →
    (∀ (U F : Scheme.{u}) (f : F ⟶ U), Etale f → IsSeparated f → ∀ (k : ℕ)
      (C : ((Limits.widePullback U (fun _ : Fin k => F) (fun _ => f) : Scheme.{u})).Opens),
      IsClosed (C : Set ((Limits.widePullback U (fun _ : Fin k => F) (fun _ => f) : Scheme.{u}))) →
      _root_.IsPreconnected (C : Set ((Limits.widePullback U (fun _ : Fin k => F) (fun _ => f) : Scheme.{u}))) →
      (∀ z ∈ C, ∀ i j : Fin k, i ≠ j →
        (Limits.pullback.lift (Limits.WidePullback.π (fun _ : Fin k => f) i)
          (Limits.WidePullback.π (fun _ : Fin k => f) j)
          ((Limits.WidePullback.π_arrow (fun _ : Fin k => f) i).trans
            (Limits.WidePullback.π_arrow (fun _ : Fin k => f) j).symm)) z ∉
          Set.range (Limits.pullback.diagonal f)) →
      (∀ z : (Limits.widePullback U (fun _ : Fin (k + 1) => F) (fun _ => f) : Scheme.{u}),
        ∃ i j : Fin (k + 1), i ≠ j ∧
        (Limits.pullback.lift (Limits.WidePullback.π (fun _ : Fin (k + 1) => f) i)
          (Limits.WidePullback.π (fun _ : Fin (k + 1) => f) j)
          ((Limits.WidePullback.π_arrow (fun _ : Fin (k + 1) => f) i).trans
            (Limits.WidePullback.π_arrow (fun _ : Fin (k + 1) => f) j).symm)) z ∈
          Set.range (Limits.pullback.diagonal f)) →
      ∀ (V : Scheme.{u}) (a b : V ⟶ C.toScheme), ConnectedSpace V →
        a ≫ C.ι ≫ Limits.WidePullback.base (fun _ : Fin k => f) =
          b ≫ C.ι ≫ Limits.WidePullback.base (fun _ : Fin k => f) →
        ∃ γ : C.toScheme ⟶ C.toScheme,
          γ ≫ C.ι ≫ Limits.WidePullback.base (fun _ : Fin k => f) =
            C.ι ≫ Limits.WidePullback.base (fun _ : Fin k => f) ∧ b = a ≫ γ) →
    (∀ (X Y : Type u) [TopologicalSpace X] [TopologicalSpace Y]
      [ConnectedSpace Y] (p : X → Y), IsOpenMap p → IsClosedMap p → (∀ y : Y, (p ⁻¹' {y}).Finite) →
      ∀ A : Set X, IsClopen A → A.Nonempty →
        ∃ C : Set X, C ⊆ A ∧ IsClopen C ∧ C.Nonempty ∧ _root_.IsPreconnected C) →
    (∀ {B Z : Scheme.{u}} (p : Z ⟶ B) [IsFinite p] (N : ℕ),
      IsFinite (Limits.WidePullback.base (fun _ : Fin N => p))) →
    ∀ (U F : Scheme.{u}) (f : F ⟶ U), IsFinite f → Etale f → Surjective f → ConnectedSpace U →
      ∃ (G : Scheme.{u}) (g : G ⟶ U) (h : G ⟶ F), IsFinite g ∧ Etale g ∧ Surjective g ∧
        ConnectedSpace G ∧ h ≫ f = g ∧
        ∀ (V : Scheme.{u}) (a b : V ⟶ G), ConnectedSpace V → a ≫ g = b ≫ g →
          ∃ γ : G ⟶ G, γ ≫ g = g ∧ b = a ≫ γ :=
by
  intro H3 H4 H5 H6 H10 U F f hfin het hsurj hU
  classical
  haveI := hfin
  haveI := het
  haveI := hsurj
  haveI := hU

  let Fr : ∀ k : ℕ, Set (Limits.widePullback U (fun _ : Fin k => F) (fun _ => f) : Scheme.{u}) :=
    fun k => {z | ∀ i j : Fin k, i ≠ j →
      (Limits.pullback.lift (Limits.WidePullback.π (fun _ : Fin k => f) i)
        (Limits.WidePullback.π (fun _ : Fin k => f) j)
        ((Limits.WidePullback.π_arrow (fun _ : Fin k => f) i).trans
          (Limits.WidePullback.π_arrow (fun _ : Fin k => f) j).symm)) z ∉
        Set.range (Limits.pullback.diagonal f)}

  have hR : IsClopen (Set.range (Limits.pullback.diagonal f)) := by
    haveI : IsClosedImmersion (Limits.pullback.diagonal f) :=
      IsSeparated.isClosedImmersion_diagonal
    exact ⟨(Limits.pullback.diagonal f).isClosedEmbedding.isClosed_range,
      IsOpenImmersion.isOpen_range _⟩

  have s1 : ∀ k, IsClopen (Fr k) := by
    intro k
    have hEq : Fr k = ⋂ i : Fin k, ⋂ j : Fin k, {z | i ≠ j →
        (Limits.pullback.lift (Limits.WidePullback.π (fun _ : Fin k => f) i)
          (Limits.WidePullback.π (fun _ : Fin k => f) j)
          ((Limits.WidePullback.π_arrow (fun _ : Fin k => f) i).trans
            (Limits.WidePullback.π_arrow (fun _ : Fin k => f) j).symm)) z ∉
          Set.range (Limits.pullback.diagonal f)} := by
      ext z
      simp only [Fr, Set.mem_iInter, Set.mem_setOf_eq]
    rw [hEq]
    refine isClopen_iInter_of_finite fun i => isClopen_iInter_of_finite fun j => ?_
    by_cases hij : i = j
    · subst hij
      simp only [ne_eq, not_true_eq_false, false_implies, Set.setOf_true]
      exact isClopen_univ
    · simp only [ne_eq, hij, not_false_eq_true, true_implies]
      exact hR.compl.preimage (Scheme.Hom.continuous _)

  obtain ⟨u₀⟩ : Nonempty U := inferInstance
  obtain ⟨N, hN⟩ := H4 U F f hfin u₀

  have hbound : ∀ k, (Fr k).Nonempty → k ≤ N := by
    intro k hne
    haveI := H3 f k
    haveI := H10 f k
    have himg : (Limits.WidePullback.base (fun _ : Fin k => f)) '' Fr k = Set.univ := by
      obtain ⟨z, hz⟩ := hne
      exact IsClopen.eq_univ
        ⟨(Limits.WidePullback.base (fun _ : Fin k => f)).isClosedMap _ (s1 k).isClosed,
          (Limits.WidePullback.base (fun _ : Fin k => f)).isOpenMap _ (s1 k).isOpen⟩
        ⟨_, z, hz, rfl⟩
    obtain ⟨z', hz', hbz'⟩ : u₀ ∈ (Limits.WidePullback.base (fun _ : Fin k => f)) '' Fr k := by
      rw [himg]; trivial
    let X : Scheme.{u} := Limits.widePullback U (fun _ : Fin k => F) (fun _ => f)
    let x : Spec (CommRingCat.of (X.residueField z')) ⟶ X := X.fromSpecResidueField z'
    have hx : ∀ t, x t = z' := fun t => Scheme.fromSpecResidueField_apply z' t
    refine hN (X.residueField z') (x ≫ Limits.WidePullback.base (fun _ : Fin k => f)) ?_ k
      (fun i => x ≫ Limits.WidePullback.π (fun _ : Fin k => f) i) ?_ ?_
    · have e : ∀ t, (x ≫ Limits.WidePullback.base (fun _ : Fin k => f)) t = u₀ := by
        intro t
        rw [Scheme.Hom.comp_apply, hx]
        exact hbz'
      exact e _
    · intro i
      rw [Category.assoc, Limits.WidePullback.π_arrow]
    · intro i j hij
      by_contra hne
      apply hz' i j hne
      have key : x ≫ Limits.pullback.lift (Limits.WidePullback.π (fun _ : Fin k => f) i)
          (Limits.WidePullback.π (fun _ : Fin k => f) j)
          ((Limits.WidePullback.π_arrow (fun _ : Fin k => f) i).trans
            (Limits.WidePullback.π_arrow (fun _ : Fin k => f) j).symm) =
          (x ≫ Limits.WidePullback.π (fun _ : Fin k => f) i) ≫ Limits.pullback.diagonal f := by
        apply Limits.pullback.hom_ext
        · simp only [Category.assoc, Limits.pullback.lift_fst, Limits.pullback.diagonal_fst,
            Category.comp_id]
        · simp only [Category.assoc, Limits.pullback.lift_snd, Limits.pullback.diagonal_snd,
            Category.comp_id]
          exact hij.symm
      have hpt : ∀ t : ↥(Spec (CommRingCat.of ↑(X.residueField z'))),
          (Limits.pullback.lift (Limits.WidePullback.π (fun _ : Fin k => f) i)
          (Limits.WidePullback.π (fun _ : Fin k => f) j)
          ((Limits.WidePullback.π_arrow (fun _ : Fin k => f) i).trans
            (Limits.WidePullback.π_arrow (fun _ : Fin k => f) j).symm)) z' ∈
          Set.range (Limits.pullback.diagonal f) := by
        intro t
        have h1 := congrArg (fun m => m t) key
        simp only [Scheme.Hom.comp_apply] at h1
        rw [hx] at h1
        exact ⟨_, h1.symm⟩
      exact hpt (IsLocalRing.closedPoint _)

  have hP1 : (Fr 1).Nonempty := by
    obtain ⟨w, -⟩ := hsurj.surj u₀
    refine ⟨(Limits.WidePullback.lift f (fun _ : Fin 1 => 𝟙 F) (fun _ => Category.id_comp f)) w, ?_⟩
    intro i j hij
    exact absurd (Subsingleton.elim i j) hij

  have h1N : 1 ≤ N := hbound 1 hP1
  obtain ⟨m, hm1, hPm, hPm1⟩ : ∃ m, 1 ≤ m ∧ (Fr m).Nonempty ∧ ¬ (Fr (m + 1)).Nonempty :=
    ⟨Nat.findGreatest (fun k => (Fr k).Nonempty) N,
      Nat.le_findGreatest (P := fun k => (Fr k).Nonempty) h1N hP1,
      Nat.findGreatest_spec (P := fun k => (Fr k).Nonempty) h1N hP1,
      fun h => Nat.findGreatest_is_greatest (P := fun k => (Fr k).Nonempty)
        (Nat.lt_succ_self _) (hbound _ h) h⟩

  haveI := H3 f m
  haveI := H10 f m
  obtain ⟨C, hCA, hC, hCne, hCpre⟩ :=
    H6 (Limits.widePullback U (fun _ : Fin m => F) (fun _ => f) : Scheme.{u}) U
      (Limits.WidePullback.base (fun _ : Fin m => f))
      (Limits.WidePullback.base (fun _ : Fin m => f)).isOpenMap
      (Limits.WidePullback.base (fun _ : Fin m => f)).isClosedMap
      (fun y => (Limits.WidePullback.base (fun _ : Fin m => f)).finite_preimage_singleton y)
      (Fr m) (s1 m) hPm
  let C' : (Limits.widePullback U (fun _ : Fin m => F) (fun _ => f) : Scheme.{u}).Opens :=
    ⟨C, hC.isOpen⟩
  haveI : IsClosedImmersion C'.ι :=
    IsClosedImmersion.of_isPreimmersion _ (by rw [Scheme.Opens.range_ι]; exact hC.isClosed)
  refine ⟨C'.toScheme, C'.ι ≫ Limits.WidePullback.base (fun _ : Fin m => f),
    C'.ι ≫ Limits.WidePullback.π (fun _ : Fin m => f) ⟨0, hm1⟩,
    inferInstance, inferInstance, ?_, ?_, ?_, ?_⟩
  ·
    refine ⟨fun u => ?_⟩
    have himg : (Limits.WidePullback.base (fun _ : Fin m => f)) '' C = Set.univ :=
      IsClopen.eq_univ
        ⟨(Limits.WidePullback.base (fun _ : Fin m => f)).isClosedMap _ hC.isClosed,
          (Limits.WidePullback.base (fun _ : Fin m => f)).isOpenMap _ hC.isOpen⟩
        (hCne.image _)
    obtain ⟨c, hc, hcu⟩ : u ∈ (Limits.WidePullback.base (fun _ : Fin m => f)) '' C := by
      rw [himg]; trivial
    obtain ⟨t, ht⟩ : c ∈ Set.range C'.ι := by rw [Scheme.Opens.range_ι]; exact hc
    refine ⟨t, ?_⟩
    rw [Scheme.Hom.comp_apply, ht]
    exact hcu
  ·
    exact isConnected_iff_connectedSpace.mp ⟨hCne, hCpre⟩
  · rw [Category.assoc, Limits.WidePullback.π_arrow]
  ·
    intro V a b hV hab
    refine H5 U F f het inferInstance m C' hC.isClosed hCpre (fun z hz => hCA hz) ?_ V a b hV hab
    intro z
    by_contra hcon
    exact hPm1 ⟨z, fun i j hij hmem => hcon ⟨i, j, hij, hmem⟩⟩

theorem wc_fet_galois_tower_build : (∀ (U F : Scheme.{u}) (f : F ⟶ U), IsFinite f → Etale f → Surjective f → ConnectedSpace U →
      ∃ (G : Scheme.{u}) (g : G ⟶ U) (h : G ⟶ F), IsFinite g ∧ Etale g ∧ Surjective g ∧
        ConnectedSpace G ∧ h ≫ f = g ∧
        ∀ (V : Scheme.{u}) (a b : V ⟶ G), ConnectedSpace V → a ≫ g = b ≫ g →
          ∃ γ : G ⟶ G, γ ≫ g = g ∧ b = a ≫ γ) →
    ∀ (U : Scheme.{u}), ConnectedSpace U →
    ∀ (E : ℕ → Scheme.{u}) (πE : ∀ j, E j ⟶ U), (∀ j, IsFinite (πE j)) → (∀ j, Etale (πE j)) →
    (∀ j, Surjective (πE j)) →
    ∃ (D : ℕᵒᵖ ⥤ Scheme.{u}) (π : ∀ j, D.obj (Opposite.op j) ⟶ U)
      (s : ∀ j, D.obj (Opposite.op j) ⟶ E j),
      (∀ j, IsFinite (π j)) ∧ (∀ j, Etale (π j)) ∧ (∀ j, Surjective (π j)) ∧
      (∀ j, ConnectedSpace (D.obj (Opposite.op j))) ∧
      (∀ j k (h : j ≤ k), D.map (homOfLE h).op ≫ π j = π k) ∧
      (∀ j k (h : j ≤ k), Surjective (D.map (homOfLE h).op)) ∧
      (∀ j, s j ≫ πE j = π j) ∧
      (∀ j (V : Scheme.{u}) (a b : V ⟶ D.obj (Opposite.op j)), ConnectedSpace V →
        a ≫ π j = b ≫ π j →
        ∃ γ : D.obj (Opposite.op j) ⟶ D.obj (Opposite.op j), γ ≫ π j = π j ∧ b = a ≫ γ) :=
by
  intro H1 U hconn E πE hfin het hsurj

  have cancel : ∀ {X Y Z : Scheme.{u}} (e : X ⟶ Y) (π : Y ⟶ Z), IsFinite (e ≫ π) →
      Etale (e ≫ π) → IsFinite π → Etale π → Nonempty X → ConnectedSpace Y → Surjective e := by
    intro X Y Z e π h1 h2 h3 h4 hX hY
    haveI := h1; haveI := h2; haveI := h3; haveI := h4
    haveI : IsFinite e := IsFinite.of_comp e π
    haveI : Etale e := Etale.of_comp e π
    have hO : IsOpen (Set.range e) := e.isOpenMap.isOpen_range
    have hC : IsClosed (Set.range e) := e.isClosedMap.isClosed_range
    obtain ⟨x⟩ := hX
    have hu : Set.range e = Set.univ := IsClopen.eq_univ ⟨hC, hO⟩ ⟨e x, x, rfl⟩
    exact ⟨Set.range_eq_univ.mp hu⟩
  let St := Σ' (G : Scheme.{u}) (π : G ⟶ U),
    IsFinite π ∧ Etale π ∧ Surjective π ∧ ConnectedSpace G ∧
      ∀ (V : Scheme.{u}) (a b : V ⟶ G), ConnectedSpace V → a ≫ π = b ≫ π →
        ∃ γ : G ⟶ G, γ ≫ π = π ∧ b = a ≫ γ
  have step : ∀ (n : ℕ) (t : St), ∃ (G' : Scheme.{u}) (e : G' ⟶ t.1) (s : G' ⟶ E (n + 1)),
      IsFinite (e ≫ t.2.1) ∧ Etale (e ≫ t.2.1) ∧ Surjective (e ≫ t.2.1) ∧
      ConnectedSpace G' ∧ Surjective e ∧ s ≫ πE (n + 1) = e ≫ t.2.1 ∧
      ∀ (V : Scheme.{u}) (a b : V ⟶ G'), ConnectedSpace V → a ≫ e ≫ t.2.1 = b ≫ e ≫ t.2.1 →
        ∃ γ : G' ⟶ G', γ ≫ e ≫ t.2.1 = e ≫ t.2.1 ∧ b = a ≫ γ := by
    intro n t
    obtain ⟨h1, h2, h3, h4, -⟩ := t.2.2
    haveI := h1; haveI := h2; haveI := h3
    haveI := hfin (n + 1); haveI := het (n + 1); haveI := hsurj (n + 1)
    obtain ⟨G', g', h', m1, m2, m3, m4, hhf, hgal⟩ := H1 U (Limits.pullback t.2.1 (πE (n + 1)))
      (Limits.pullback.fst t.2.1 (πE (n + 1)) ≫ t.2.1) inferInstance inferInstance inferInstance
      hconn
    have hg : (h' ≫ Limits.pullback.fst t.2.1 (πE (n + 1))) ≫ t.2.1 = g' := by
      rw [Category.assoc]; exact hhf
    refine ⟨G', h' ≫ Limits.pullback.fst t.2.1 (πE (n + 1)),
      h' ≫ Limits.pullback.snd t.2.1 (πE (n + 1)), ?_, ?_, ?_, m4, ?_, ?_, ?_⟩
    · rw [hg]; exact m1
    · rw [hg]; exact m2
    · rw [hg]; exact m3
    · haveI := m4
      exact cancel _ t.2.1 (by rw [hg]; exact m1) (by rw [hg]; exact m2) h1 h2 inferInstance h4
    · rw [Category.assoc, Category.assoc, Limits.pullback.condition]
    · intro V a b hV hab
      rw [hg] at hab
      obtain ⟨γ, hγ, hb⟩ := hgal V a b hV hab
      exact ⟨γ, by rw [hg]; exact hγ, hb⟩
  choose G' e' s' hF hE hS hC hSe hs hGal using step
  obtain ⟨G₀, g₀, h₀, b1, b2, b3, b4, b5, b6⟩ :=
    H1 U (E 0) (πE 0) (hfin 0) (het 0) (hsurj 0) hconn
  let T : ℕ → St := fun n => Nat.rec (motive := fun _ => St)
    (⟨G₀, g₀, b1, b2, b3, b4, b6⟩ : St)
    (fun m t => (⟨G' m t, e' m t ≫ t.2.1, hF m t, hE m t, hS m t, hC m t, hGal m t⟩ : St)) n
  let X : ℕ → Scheme.{u} := fun n => (T n).1
  let e : ∀ n, X (n + 1) ⟶ X n := fun n => e' n (T n)
  let π : ∀ n, X n ⟶ U := fun n => (T n).2.1
  let s : ∀ n, X n ⟶ E n := fun n =>
    Nat.casesOn (motive := fun n => X n ⟶ E n) n h₀ (fun m => s' m (T m))
  have p1 : ∀ n, IsFinite (π n) := fun n => (T n).2.2.1
  have p2 : ∀ n, Etale (π n) := fun n => (T n).2.2.2.1
  have p3 : ∀ n, Surjective (π n) := fun n => (T n).2.2.2.2.1
  have p4 : ∀ n, ConnectedSpace (X n) := fun n => (T n).2.2.2.2.2.1
  have p5 : ∀ n, e n ≫ π n = π (n + 1) := fun n => rfl
  have p6 : ∀ n, Surjective (e n) := fun n => hSe n (T n)
  have p7 : ∀ n, s n ≫ πE n = π n := by
    intro n
    cases n with
    | zero => exact b5
    | succ m => exact hs m (T m)
  have p8 : ∀ n (V : Scheme.{u}) (a b : V ⟶ X n), ConnectedSpace V → a ≫ π n = b ≫ π n →
      ∃ γ : X n ⟶ X n, γ ≫ π n = π n ∧ b = a ≫ γ := fun n => (T n).2.2.2.2.2.2
  have gen : ∀ (D : ℕᵒᵖ ⥤ Scheme.{u}) (πD : ∀ n, D.obj (Opposite.op n) ⟶ U),
      (∀ n, D.map (homOfLE (Nat.le_succ n)).op ≫ πD n = πD (n + 1)) →
      (∀ n, Surjective (D.map (homOfLE (Nat.le_succ n)).op)) →
      ∀ j k (h : j ≤ k), D.map (homOfLE h).op ≫ πD j = πD k ∧
        Surjective (D.map (homOfLE h).op) := by
    intro D πD h5 h6 j k h
    obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le h
    induction d with
    | zero =>
      have hid : D.map (homOfLE h).op = 𝟙 (D.obj (Opposite.op (j + 0))) :=
        (congrArg D.map (Subsingleton.elim _ _)).trans (D.map_id _)
      rw [hid]
      exact ⟨Category.id_comp _, inferInstance⟩
    | succ d ih =>
      have h' : j ≤ j + d := Nat.le_add_right j d
      have hcomp : D.map (homOfLE h).op =
          D.map (homOfLE (Nat.le_succ (j + d))).op ≫ D.map (homOfLE h').op :=
        (congrArg D.map (Subsingleton.elim _ _)).trans (D.map_comp _ _)
      obtain ⟨ih1, ih2⟩ := ih h'
      rw [hcomp]
      refine ⟨?_, ?_⟩
      · rw [Category.assoc, ih1]
        exact h5 (j + d)
      · haveI := ih2
        haveI := h6 (j + d)
        infer_instance
  have key := gen (Functor.ofOpSequence e) π
    (fun n => (congrArg (· ≫ π n) (Functor.ofOpSequence_map_homOfLE_succ e n)).trans (p5 n))
    (fun n => (Functor.ofOpSequence_map_homOfLE_succ e n) ▸ p6 n)
  exact ⟨Functor.ofOpSequence e, π, s, p1, p2, p3, p4, fun j k h => (key j k h).1,
    fun j k h => (key j k h).2, p7, p8⟩

theorem wc_affine_seq_limit_hom_ext : (∀ (T X : Scheme.{u}) (A : X.Opens), IsAffineOpen A →
      ∀ (f g : T ⟶ X) (hf : ⊤ ≤ f ⁻¹ᵁ A) (hg : ⊤ ≤ g ⁻¹ᵁ A),
      f.appLE A ⊤ hf = g.appLE A ⊤ hg → f = g) →
    ∀ (U : Scheme.{u}) (D : ℕᵒᵖ ⥤ Scheme.{u})
    (π : ∀ j, D.obj (Opposite.op j) ⟶ U)
    (W₀ : Scheme.{u}) (p : W₀ ⟶ U) (t : ∀ j, W₀ ⟶ D.obj (Opposite.op j))
    (ht : ∀ j, t j ≫ π j = p),
    IsAffineHom p →
    (∀ V : U.Opens, IsAffineOpen V → ∀ (n : ℕ) (s : Fin n → Γ(W₀, p ⁻¹ᵁ V)),
      ∃ (j : ℕ) (r : Fin n → Γ(D.obj (Opposite.op j), π j ⁻¹ᵁ V)), ∀ i,
        ((t j).appLE (π j ⁻¹ᵁ V) (p ⁻¹ᵁ V) (by rw [← ht j]; exact le_rfl)).hom (r i) = s i) →
    ∀ (T : Scheme.{u}) (x x' : T ⟶ W₀), (∀ j, x ≫ t j = x' ≫ t j) → x = x' :=
by
  intro H0 U D π W₀ p t ht hpaff hREP T x x' hxx'
  have := hpaff
  have hp : x ≫ p = x' ≫ p := by
    rw [← ht 0, ← Category.assoc, hxx' 0, Category.assoc]
  apply Scheme.hom_ext_of_forall
  intro τ
  obtain ⟨V, hV, hτV, -⟩ :=
    exists_isAffineOpen_mem_and_subset (x := (x ≫ p) τ) (U := (⊤ : U.Opens)) trivial
  refine ⟨(x ≫ p) ⁻¹ᵁ V, hτV, ?_⟩
  have hA : IsAffineOpen (p ⁻¹ᵁ V) := hV.preimage p
  have hf' : (((x ≫ p) ⁻¹ᵁ V).ι ≫ x) ⁻¹ᵁ (p ⁻¹ᵁ V) = ⊤ := by
    rw [← Scheme.Hom.comp_preimage, Category.assoc, Scheme.Hom.comp_preimage _ (x ≫ p),
      Scheme.Opens.ι_preimage_self]
  have hg' : (((x ≫ p) ⁻¹ᵁ V).ι ≫ x') ⁻¹ᵁ (p ⁻¹ᵁ V) = ⊤ := by
    rw [← Scheme.Hom.comp_preimage, Category.assoc, ← hp, Scheme.Hom.comp_preimage _ (x ≫ p),
      Scheme.Opens.ι_preimage_self]
  apply H0 _ W₀ (p ⁻¹ᵁ V) hA _ _ hf'.symm.le hg'.symm.le
  ext s
  obtain ⟨j, r, hr⟩ := hREP V hV 1 (fun _ => s)
  have key : ∀ (φ ψ : ((x ≫ p) ⁻¹ᵁ V).toScheme ⟶ D.obj (Opposite.op j)) (h : φ = ψ)
      (e : ⊤ ≤ φ ⁻¹ᵁ (π j ⁻¹ᵁ V)) (e' : ⊤ ≤ ψ ⁻¹ᵁ (π j ⁻¹ᵁ V)),
      φ.appLE (π j ⁻¹ᵁ V) ⊤ e = ψ.appLE (π j ⁻¹ᵁ V) ⊤ e' := by
    intro φ ψ h e e'
    subst h
    rfl
  rw [show s = _ from (hr 0).symm]
  rw [← CommRingCat.comp_apply, ← CommRingCat.comp_apply, Scheme.Hom.appLE_comp_appLE,
    Scheme.Hom.appLE_comp_appLE]
  have hfg : (((x ≫ p) ⁻¹ᵁ V).ι ≫ x) ≫ t j = (((x ≫ p) ⁻¹ᵁ V).ι ≫ x') ≫ t j := by
    rw [Category.assoc, Category.assoc, hxx' j]
  rw [key _ _ hfg]

theorem wc_affine_seq_limit_local_lift : (∀ (T X : Scheme.{u}) (A : X.Opens), IsAffineOpen A →
      ∀ (f g : T ⟶ X) (hf : ⊤ ≤ f ⁻¹ᵁ A) (hg : ⊤ ≤ g ⁻¹ᵁ A),
      f.appLE A ⊤ hf = g.appLE A ⊤ hg → f = g) →
    ∀ (U : Scheme.{u}) (D : ℕᵒᵖ ⥤ Scheme.{u})
    (π : ∀ j, D.obj (Opposite.op j) ⟶ U)
    (hπ : ∀ j k (h : j ≤ k), D.map (homOfLE h).op ≫ π j = π k)
    (W₀ : Scheme.{u}) (p : W₀ ⟶ U) (t : ∀ j, W₀ ⟶ D.obj (Opposite.op j))
    (ht : ∀ j, t j ≫ π j = p),
    (∀ j k (h : j ≤ k), t k ≫ D.map (homOfLE h).op = t j) →
    IsAffineHom p → (∀ j, IsAffineHom (π j)) →
    (∀ V : U.Opens, IsAffineOpen V → ∀ (n : ℕ) (s : Fin n → Γ(W₀, p ⁻¹ᵁ V)),
      ∃ (j : ℕ) (r : Fin n → Γ(D.obj (Opposite.op j), π j ⁻¹ᵁ V)), ∀ i,
        ((t j).appLE (π j ⁻¹ᵁ V) (p ⁻¹ᵁ V) (by rw [← ht j]; exact le_rfl)).hom (r i) = s i) →
    (∀ V : U.Opens, IsAffineOpen V → ∀ (j n : ℕ)
      (r : Fin n → Γ(D.obj (Opposite.op j), π j ⁻¹ᵁ V)),
      (∀ i, ((t j).appLE (π j ⁻¹ᵁ V) (p ⁻¹ᵁ V) (by rw [← ht j]; exact le_rfl)).hom (r i) = 0) →
      ∃ (k : ℕ) (h : j ≤ k), ∀ i,
        ((D.map (homOfLE h).op).appLE (π j ⁻¹ᵁ V) (π k ⁻¹ᵁ V)
          (by rw [← hπ j k h]; exact le_rfl)).hom (r i) = 0) →
    ∀ (V : U.Opens), IsAffineOpen V →
    ∀ (T : Scheme.{u}) (z : ∀ j, T ⟶ D.obj (Opposite.op j)),
      (∀ j k (h : j ≤ k), z k ≫ D.map (homOfLE h).op = z j) →
      (∀ x : T, (z 0 ≫ π 0) x ∈ V) →
      ∃ y : T ⟶ W₀, ∀ j, y ≫ t j = z j :=
by
  intro H0 U D π hπ W₀ p t ht hcompat hpaff hπaff hREP hZERO V hV T z hz hzV
  classical

  have desc : ∀ (S R : Type u) [CommRing S] [CommRing R] (G : ℕ → Type u)
      [∀ k, CommRing (G k)] (ι : ∀ k, G k →+* S) (θ : ∀ j k, j ≤ k → (G j →+* G k))
      (ζ : ∀ k, G k →+* R),
      (∀ j k (h : j ≤ k) (a : G j), ι k (θ j k h a) = ι j a) →
      (∀ j k (h : j ≤ k) (a : G j), ζ k (θ j k h a) = ζ j a) →
      (∀ i j k (h₁ : i ≤ j) (h₂ : j ≤ k) (a : G i),
        θ j k h₂ (θ i j h₁ a) = θ i k (h₁.trans h₂) a) →
      (∀ x : S, ∃ (k : ℕ) (y : G k), ι k y = x) →
      (∀ (k : ℕ) (y : G k), ι k y = 0 → ∃ (k' : ℕ) (h : k ≤ k'), θ k k' h y = 0) →
      ∃ Φ : S →+* R, ∀ k (a : G k), Φ (ι k a) = ζ k a := by
    intro S R _ _ G _ ι θ ζ hι hζ hθ hrep hzero
    have WD : ∀ j k (a : G j) (b : G k), ι j a = ι k b → ζ j a = ζ k b := by
      intro j k a b hab
      have hjm : j ≤ max j k := le_max_left _ _
      have hkm : k ≤ max j k := le_max_right _ _
      obtain ⟨m', hmm', hd⟩ := hzero (max j k) (θ j _ hjm a - θ k _ hkm b) (by
        rw [map_sub, hι, hι, hab, sub_self])
      rw [map_sub, sub_eq_zero, hθ, hθ] at hd
      rw [← hζ j m' (hjm.trans hmm') a, hd, hζ]
    choose kk yy hyy using hrep
    have key : ∀ k (a : G k), ζ (kk (ι k a)) (yy (ι k a)) = ζ k a :=
      fun k a => WD _ _ _ _ (hyy _)
    have lift2 : ∀ x x' : S, ∃ (m : ℕ) (a b : G m), ι m a = x ∧ ι m b = x' := by
      intro x x'
      refine ⟨max (kk x) (kk x'), θ _ _ (le_max_left _ _) (yy x),
        θ _ _ (le_max_right _ _) (yy x'), ?_, ?_⟩
      · rw [hι, hyy]
      · rw [hι, hyy]
    let Φ : S →+* R :=
      { toFun := fun x => ζ (kk x) (yy x)
        map_one' := (WD _ 0 _ 1 (by rw [hyy, map_one])).trans (map_one _)
        map_mul' := by
          intro x x'
          obtain ⟨m, a, b, rfl, rfl⟩ := lift2 x x'
          show ζ (kk _) (yy _) = ζ (kk _) (yy _) * ζ (kk _) (yy _)
          rw [← map_mul (ι m), key m (a * b), key m a, key m b, map_mul]
        map_zero' := (WD _ 0 _ 0 (by rw [hyy, map_zero])).trans (map_zero _)
        map_add' := by
          intro x x'
          obtain ⟨m, a, b, rfl, rfl⟩ := lift2 x x'
          show ζ (kk _) (yy _) = ζ (kk _) (yy _) + ζ (kk _) (yy _)
          rw [← map_add (ι m), key m (a + b), key m a, key m b, map_add] }
    exact ⟨Φ, fun k a => key k a⟩

  have realize : ∀ (X : Scheme.{u}) (A : X.Opens) (hA : IsAffineOpen A) (φ : Γ(X, A) ⟶ Γ(T, ⊤)),
      ∃ (y : T ⟶ X) (hy : ⊤ ≤ y ⁻¹ᵁ A), y.appLE A ⊤ hy = φ := by
    intro X A hA φ
    have e1 : ⊤ ≤ hA.fromSpec ⁻¹ᵁ A := hA.fromSpec_preimage_self.ge
    have e2 : (⊤ : T.Opens) ≤ (T.toSpecΓ ≫ Spec.map φ) ⁻¹ᵁ ⊤ :=
      (Scheme.Hom.preimage_top _).ge
    have e3 : (⊤ : (Spec Γ(T, ⊤)).Opens) ≤ (Spec.map φ) ⁻¹ᵁ ⊤ :=
      (Scheme.Hom.preimage_top _).ge
    have e4 : (⊤ : T.Opens) ≤ T.toSpecΓ ⁻¹ᵁ ⊤ := (Scheme.Hom.preimage_top _).ge
    have hy : ⊤ ≤ ((T.toSpecΓ ≫ Spec.map φ) ≫ hA.fromSpec) ⁻¹ᵁ A :=
      e2.trans (Scheme.Hom.preimage_mono _ e1)
    refine ⟨(T.toSpecΓ ≫ Spec.map φ) ≫ hA.fromSpec, hy, ?_⟩
    have hf : hA.fromSpec.appLE A ⊤ e1 = (Scheme.ΓSpecIso Γ(X, A)).inv := by
      rw [Scheme.Hom.appLE, IsAffineOpen.fromSpec_app_self, Category.assoc, ← Functor.map_comp]
      have hid : ∀ (g : (Opposite.op (⊤ : (Spec Γ(X, A)).Opens)) ⟶ Opposite.op ⊤),
          (Spec Γ(X, A)).presheaf.map g = 𝟙 _ := fun g => by
        rw [show g = 𝟙 _ from Quiver.Hom.unop_inj (Subsingleton.elim _ _),
          CategoryTheory.Functor.map_id]
      rw [hid, Category.comp_id]
    have hT1 : (Spec.map φ).appLE ⊤ ⊤ e3 = (Spec.map φ).appTop :=
      (Scheme.Hom.app_eq_appLE _).symm
    have hT2 : T.toSpecΓ.appLE ⊤ ⊤ e4 = T.toSpecΓ.appTop :=
      (Scheme.Hom.app_eq_appLE _).symm
    rw [← Scheme.Hom.appLE_comp_appLE (T.toSpecΓ ≫ Spec.map φ) hA.fromSpec A ⊤ ⊤ e1 e2, hf,
      ← Scheme.Hom.appLE_comp_appLE T.toSpecΓ (Spec.map φ) ⊤ ⊤ ⊤ e3 e4, hT1, hT2,
      Scheme.toSpecΓ_appTop, Scheme.ΓSpecIso_naturality, Iso.inv_hom_id_assoc]

  haveI := hpaff
  have hA : IsAffineOpen (p ⁻¹ᵁ V) := hV.preimage p
  have hB : ∀ j, IsAffineOpen (π j ⁻¹ᵁ V) := fun j => by
    haveI := hπaff j
    exact hV.preimage (π j)
  have e : ∀ j, p ⁻¹ᵁ V ≤ t j ⁻¹ᵁ (π j ⁻¹ᵁ V) := fun j => by rw [← ht j]; exact le_rfl
  have hle : ∀ j k (h : j ≤ k), π k ⁻¹ᵁ V ≤ D.map (homOfLE h).op ⁻¹ᵁ (π j ⁻¹ᵁ V) :=
    fun j k h => by rw [← hπ j k h]; exact le_rfl
  have hzπ : ∀ j, z j ≫ π j = z 0 ≫ π 0 := fun j => by
    rw [← hz 0 j (Nat.zero_le j), Category.assoc, hπ 0 j (Nat.zero_le j)]
  have hzt : ∀ j, ⊤ ≤ z j ⁻¹ᵁ (π j ⁻¹ᵁ V) := fun j => by
    intro x _
    rw [Scheme.Hom.mem_preimage, Scheme.Hom.mem_preimage, ← Scheme.Hom.comp_apply, hzπ j]
    exact hzV x
  have hcongr : ∀ {X Y : Scheme.{u}} (f g : X ⟶ Y) (hfg : f = g) (A : Y.Opens) (B : X.Opens)
      (h : B ≤ f ⁻¹ᵁ A), f.appLE A B h = g.appLE A B (hfg ▸ h) := by
    intro X Y f g hfg A B h
    subst hfg
    rfl

  obtain ⟨Φ, hΦ⟩ : ∃ Φ : Γ(W₀, p ⁻¹ᵁ V) →+* Γ(T, ⊤), ∀ k (a : Γ(D.obj (Opposite.op k), π k ⁻¹ᵁ V)),
      Φ (((t k).appLE (π k ⁻¹ᵁ V) (p ⁻¹ᵁ V) (e k)).hom a) =
        ((z k).appLE (π k ⁻¹ᵁ V) ⊤ (hzt k)).hom a := by
    refine desc Γ(W₀, p ⁻¹ᵁ V) Γ(T, ⊤) (fun k => Γ(D.obj (Opposite.op k), π k ⁻¹ᵁ V))
      (fun k => ((t k).appLE (π k ⁻¹ᵁ V) (p ⁻¹ᵁ V) (e k)).hom)
      (fun j k h => ((D.map (homOfLE h).op).appLE (π j ⁻¹ᵁ V) (π k ⁻¹ᵁ V) (hle j k h)).hom)
      (fun k => ((z k).appLE (π k ⁻¹ᵁ V) ⊤ (hzt k)).hom) ?_ ?_ ?_ ?_ ?_
    · intro j k h a
      exact congrArg (fun φ => CommRingCat.Hom.hom φ a)
        ((Scheme.Hom.appLE_comp_appLE (t k) (D.map (homOfLE h).op) (π j ⁻¹ᵁ V) (π k ⁻¹ᵁ V)
          (p ⁻¹ᵁ V) (hle j k h) (e k)).trans (hcongr _ _ (hcompat j k h) _ _ _))
    · intro j k h a
      exact congrArg (fun φ => CommRingCat.Hom.hom φ a)
        ((Scheme.Hom.appLE_comp_appLE (z k) (D.map (homOfLE h).op) (π j ⁻¹ᵁ V) (π k ⁻¹ᵁ V)
          ⊤ (hle j k h) (hzt k)).trans (hcongr _ _ (hz j k h) _ _ _))
    · intro i j k h₁ h₂ a
      have hmap : D.map (homOfLE h₂).op ≫ D.map (homOfLE h₁).op =
          D.map (homOfLE (h₁.trans h₂)).op := by
        rw [← Functor.map_comp]
        rfl
      exact congrArg (fun φ => CommRingCat.Hom.hom φ a)
        ((Scheme.Hom.appLE_comp_appLE (D.map (homOfLE h₂).op) (D.map (homOfLE h₁).op)
          (π i ⁻¹ᵁ V) (π j ⁻¹ᵁ V) (π k ⁻¹ᵁ V) (hle i j h₁) (hle j k h₂)).trans
          (hcongr _ _ hmap _ _ _))
    · intro x
      obtain ⟨j, r, hr⟩ := hREP V hV 1 (fun _ => x)
      exact ⟨j, r 0, hr 0⟩
    · intro k y hy
      obtain ⟨k', h, hk⟩ := hZERO V hV k 1 (fun _ => y) (fun _ => hy)
      exact ⟨k', h, hk 0⟩

  obtain ⟨y, hy, hyΦ⟩ := realize W₀ (p ⁻¹ᵁ V) hA (CommRingCat.ofHom Φ)
  refine ⟨y, fun j => ?_⟩

  have hfj : ⊤ ≤ (y ≫ t j) ⁻¹ᵁ (π j ⁻¹ᵁ V) := hy.trans (Scheme.Hom.preimage_mono y (e j))
  refine H0 T _ _ (hB j) (y ≫ t j) (z j) hfj (hzt j) ?_
  rw [← Scheme.Hom.appLE_comp_appLE y (t j) (π j ⁻¹ᵁ V) (p ⁻¹ᵁ V) ⊤ (e j) hy, hyΦ]
  apply CommRingCat.hom_ext
  exact RingHom.ext fun a => hΦ j a

theorem wc_affine_seq_limit_lift : (∀ (U : Scheme.{u}) (D : ℕᵒᵖ ⥤ Scheme.{u})
      (π : ∀ j, D.obj (Opposite.op j) ⟶ U)
      (hπ : ∀ j k (h : j ≤ k), D.map (homOfLE h).op ≫ π j = π k)
      (W₀ : Scheme.{u}) (p : W₀ ⟶ U) (t : ∀ j, W₀ ⟶ D.obj (Opposite.op j))
      (ht : ∀ j, t j ≫ π j = p),
      (∀ j k (h : j ≤ k), t k ≫ D.map (homOfLE h).op = t j) →
      IsAffineHom p → (∀ j, IsAffineHom (π j)) →
      (∀ V : U.Opens, IsAffineOpen V → ∀ (n : ℕ) (s : Fin n → Γ(W₀, p ⁻¹ᵁ V)),
        ∃ (j : ℕ) (r : Fin n → Γ(D.obj (Opposite.op j), π j ⁻¹ᵁ V)), ∀ i,
          ((t j).appLE (π j ⁻¹ᵁ V) (p ⁻¹ᵁ V) (by rw [← ht j]; exact le_rfl)).hom (r i) = s i) →
      (∀ V : U.Opens, IsAffineOpen V → ∀ (j n : ℕ)
        (r : Fin n → Γ(D.obj (Opposite.op j), π j ⁻¹ᵁ V)),
        (∀ i, ((t j).appLE (π j ⁻¹ᵁ V) (p ⁻¹ᵁ V) (by rw [← ht j]; exact le_rfl)).hom (r i) = 0) →
        ∃ (k : ℕ) (h : j ≤ k), ∀ i,
          ((D.map (homOfLE h).op).appLE (π j ⁻¹ᵁ V) (π k ⁻¹ᵁ V)
            (by rw [← hπ j k h]; exact le_rfl)).hom (r i) = 0) →
      ∀ (V : U.Opens), IsAffineOpen V →
      ∀ (T : Scheme.{u}) (z : ∀ j, T ⟶ D.obj (Opposite.op j)),
        (∀ j k (h : j ≤ k), z k ≫ D.map (homOfLE h).op = z j) →
        (∀ x : T, (z 0 ≫ π 0) x ∈ V) →
        ∃ y : T ⟶ W₀, ∀ j, y ≫ t j = z j) →
    (∀ (U : Scheme.{u}) (D : ℕᵒᵖ ⥤ Scheme.{u})
      (π : ∀ j, D.obj (Opposite.op j) ⟶ U)
      (W₀ : Scheme.{u}) (p : W₀ ⟶ U) (t : ∀ j, W₀ ⟶ D.obj (Opposite.op j))
      (ht : ∀ j, t j ≫ π j = p),
      IsAffineHom p →
      (∀ V : U.Opens, IsAffineOpen V → ∀ (n : ℕ) (s : Fin n → Γ(W₀, p ⁻¹ᵁ V)),
        ∃ (j : ℕ) (r : Fin n → Γ(D.obj (Opposite.op j), π j ⁻¹ᵁ V)), ∀ i,
          ((t j).appLE (π j ⁻¹ᵁ V) (p ⁻¹ᵁ V) (by rw [← ht j]; exact le_rfl)).hom (r i) = s i) →
      ∀ (T : Scheme.{u}) (x x' : T ⟶ W₀), (∀ j, x ≫ t j = x' ≫ t j) → x = x') →
    ∀ (U : Scheme.{u}) (D : ℕᵒᵖ ⥤ Scheme.{u})
    (π : ∀ j, D.obj (Opposite.op j) ⟶ U)
    (hπ : ∀ j k (h : j ≤ k), D.map (homOfLE h).op ≫ π j = π k)
    (W₀ : Scheme.{u}) (p : W₀ ⟶ U) (t : ∀ j, W₀ ⟶ D.obj (Opposite.op j))
    (ht : ∀ j, t j ≫ π j = p),
    (∀ j k (h : j ≤ k), t k ≫ D.map (homOfLE h).op = t j) →
    IsAffineHom p → (∀ j, IsAffineHom (π j)) →
    (∀ V : U.Opens, IsAffineOpen V → ∀ (n : ℕ) (s : Fin n → Γ(W₀, p ⁻¹ᵁ V)),
      ∃ (j : ℕ) (r : Fin n → Γ(D.obj (Opposite.op j), π j ⁻¹ᵁ V)), ∀ i,
        ((t j).appLE (π j ⁻¹ᵁ V) (p ⁻¹ᵁ V) (by rw [← ht j]; exact le_rfl)).hom (r i) = s i) →
    (∀ V : U.Opens, IsAffineOpen V → ∀ (j n : ℕ)
      (r : Fin n → Γ(D.obj (Opposite.op j), π j ⁻¹ᵁ V)),
      (∀ i, ((t j).appLE (π j ⁻¹ᵁ V) (p ⁻¹ᵁ V) (by rw [← ht j]; exact le_rfl)).hom (r i) = 0) →
      ∃ (k : ℕ) (h : j ≤ k), ∀ i,
        ((D.map (homOfLE h).op).appLE (π j ⁻¹ᵁ V) (π k ⁻¹ᵁ V)
          (by rw [← hπ j k h]; exact le_rfl)).hom (r i) = 0) →
    ∀ (T : Scheme.{u}) (z : ∀ j, T ⟶ D.obj (Opposite.op j)),
      (∀ j k (h : j ≤ k), z k ≫ D.map (homOfLE h).op = z j) →
      ∃ y : T ⟶ W₀, ∀ j, y ≫ t j = z j :=
by
  intro LOCAL HOMEXT U D π hπ W₀ p t ht hcompat hpaff hπaff hREP hZERO T z hz
  classical
  let q : T ⟶ U := z 0 ≫ π 0
  let O : U.affineOpens → T.Opens := fun V => q ⁻¹ᵁ V.1
  have hcov : ⨆ V, O V = ⊤ := by
    rw [eq_top_iff]
    intro x _
    obtain ⟨W, hW, hxW, -⟩ :=
      exists_isAffineOpen_mem_and_subset (X := U) (U := ⊤) (x := q x) trivial
    rw [TopologicalSpace.Opens.mem_iSup]
    exact ⟨⟨W, hW⟩, hxW⟩
  let 𝒰 : T.OpenCover := T.openCoverOfIsOpenCover O (TopologicalSpace.IsOpenCover.mk hcov)
  have hloc : ∀ V : U.affineOpens, ∃ y : (O V).toScheme ⟶ W₀,
      ∀ j, y ≫ t j = (O V).ι ≫ z j := by
    intro V
    refine LOCAL U D π hπ W₀ p t ht hcompat hpaff hπaff hREP hZERO V.1 V.2 (O V)
      (fun j => (O V).ι ≫ z j) ?_ ?_
    · intro j k h
      simp only [Category.assoc, hz j k h]
    · intro x
      have h1 : (O V).ι x ∈ O V := by
        first
          | (rw [Scheme.Opens.ι_apply]; exact x.2)
          | (rw [← Scheme.Opens.range_ι (O V)]; exact ⟨x, rfl⟩)
          | exact x.2
      have h2 : q ((O V).ι x) ∈ V.1 := h1
      rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply]
      first
        | exact h2
        | (rw [Scheme.Hom.comp_apply] at h2; exact h2)
  choose yV hyV using hloc
  have hglue : ∀ a b : U.affineOpens, Limits.pullback.fst (O a).ι (O b).ι ≫ yV a =
      Limits.pullback.snd (O a).ι (O b).ι ≫ yV b := by
    intro a b
    apply HOMEXT U D π W₀ p t ht hpaff hREP
    intro j
    simp only [Category.assoc, hyV]
    rw [← Category.assoc, Limits.pullback.condition, Category.assoc]
  refine ⟨𝒰.glueMorphisms yV hglue, fun j => ?_⟩
  apply 𝒰.hom_ext
  intro a
  exact (Category.assoc _ _ _).symm.trans
    ((congrArg (· ≫ t j) (𝒰.ι_glueMorphisms yV hglue a)).trans (hyV a j))

theorem wc_fet_galois_tower_connected_limit : ∀ (U : Scheme.{u}), ConnectedSpace U → CompactSpace U →
    QuasiSeparatedSpace U →
    ∀ (E : ℕ → Scheme.{u}) (πE : ∀ j, E j ⟶ U), (∀ j, IsFinite (πE j)) → (∀ j, Etale (πE j)) →
    (∀ j, Surjective (πE j)) →
    ∃ (W₀ : Scheme.{u}) (p : W₀ ⟶ U), WeaklyEtale p ∧ QuasiCompact p ∧ Surjective p ∧
      ConnectedSpace W₀ ∧ CompactSpace W₀ ∧ QuasiSeparatedSpace W₀ ∧
      (∀ j, ∃ t : W₀ ⟶ E j, t ≫ πE j = p) ∧
      ∀ (V : Scheme.{u}) (a b : V ⟶ W₀), ConnectedSpace V → a ≫ p = b ≫ p →
        ∃ γ : W₀ ⟶ W₀, γ ≫ p = p ∧ b = a ≫ γ :=
by
  intro U hconn hcpt hqs E πE hfin het hsurj

  have L1 : ∀ (U E T : Scheme.{u}) (e : E ⟶ U), Etale e → IsSeparated e →
      ∀ (f f' : T ⟶ E) (h : f ≫ e = f' ≫ e), ConnectedSpace T →
      (∃ x : T, (Limits.pullback.lift f f' h) x ∈ Set.range (Limits.pullback.diagonal e)) →
      f = f' := by
    intro U E T e he hs f f' h hT hx
    obtain ⟨x, hx⟩ := hx
    haveI := he
    haveI := hs
    haveI : IsClosedImmersion (Limits.pullback.diagonal e) := IsSeparated.isClosedImmersion_diagonal
    have hopen : IsOpen (Set.range (Limits.pullback.diagonal e)) :=
      IsOpenImmersion.isOpen_range _
    have hclosed : IsClosed (Set.range (Limits.pullback.diagonal e)) :=
      (Limits.pullback.diagonal e).isClosedEmbedding.isClosed_range
    have hclo : IsClopen ((Limits.pullback.lift f f' h) ⁻¹' Set.range (Limits.pullback.diagonal e)) :=
      ⟨hclosed.preimage (Limits.pullback.lift f f' h).continuous,
        hopen.preimage (Limits.pullback.lift f f' h).continuous⟩
    have huniv := hclo.eq_univ ⟨x, hx⟩
    have hsub : Set.range (Limits.pullback.lift f f' h) ⊆ Set.range (Limits.pullback.diagonal e) := by
      rintro _ ⟨y, rfl⟩
      have hy : y ∈ (Limits.pullback.lift f f' h) ⁻¹' Set.range (Limits.pullback.diagonal e) := by
        rw [huniv]; trivial
      exact hy
    have hl := IsOpenImmersion.lift_fac (Limits.pullback.diagonal e) (Limits.pullback.lift f f' h) hsub
    have e1 : f = IsOpenImmersion.lift (Limits.pullback.diagonal e) (Limits.pullback.lift f f' h) hsub := by
      have h1 := congrArg (· ≫ Limits.pullback.fst e e) hl
      simp only [Category.assoc, Limits.pullback.diagonal_fst, Category.comp_id,
        Limits.pullback.lift_fst] at h1
      exact h1.symm
    have e2 : f' = IsOpenImmersion.lift (Limits.pullback.diagonal e) (Limits.pullback.lift f f' h) hsub := by
      have h1 := congrArg (· ≫ Limits.pullback.snd e e) hl
      simp only [Category.assoc, Limits.pullback.diagonal_snd, Category.comp_id,
        Limits.pullback.lift_snd] at h1
      exact h1.symm
    exact e1.trans e2.symm

  have L3 : ∀ {B Z : Scheme.{u}} (p : Z ⟶ B) [Etale p] (N : ℕ),
      Etale (Limits.WidePullback.base (fun _ : Fin N => p)) := by
    intro B Z p _ N
    induction N with
    | zero =>
      have hiso : IsIso (Limits.WidePullback.base (fun _ : Fin 0 => p)) := by
        refine ⟨⟨Limits.WidePullback.lift (𝟙 B) (fun j => j.elim0) (fun j => j.elim0), ?_, ?_⟩⟩
        · apply Limits.WidePullback.hom_ext (fun _ : Fin 0 => p)
          · intro j
            exact j.elim0
          · rw [Category.assoc, Limits.WidePullback.lift_base, Category.comp_id, Category.id_comp]
        · exact Limits.WidePullback.lift_base _ _ _ _
      infer_instance
    | succ N ih =>
      obtain ⟨g, hgπ, hgb⟩ : ∃ g : Limits.widePullback B (fun _ : Fin (N + 1) => Z) (fun _ => p) ⟶
          Limits.widePullback B (fun _ : Fin N => Z) (fun _ => p),
          (∀ i : Fin N, g ≫ Limits.WidePullback.π (fun _ : Fin N => p) i =
            Limits.WidePullback.π (fun _ : Fin (N + 1) => p) i.castSucc) ∧
          g ≫ Limits.WidePullback.base (fun _ : Fin N => p) =
            Limits.WidePullback.base (fun _ : Fin (N + 1) => p) :=
        ⟨Limits.WidePullback.lift (Limits.WidePullback.base (fun _ : Fin (N + 1) => p))
          (fun i : Fin N => Limits.WidePullback.π (fun _ : Fin (N + 1) => p) i.castSucc)
          (fun i => Limits.WidePullback.π_arrow (fun _ : Fin (N + 1) => p) i.castSucc),
          fun i => Limits.WidePullback.lift_π _ _ _ _ _, Limits.WidePullback.lift_base _ _ _ _⟩
      have comm : g ≫ Limits.WidePullback.base (fun _ : Fin N => p) =
          Limits.WidePullback.π (fun _ : Fin (N + 1) => p) (Fin.last N) ≫ p := by
        rw [hgb, Limits.WidePullback.π_arrow]
      have hw : ∀ (s : Limits.PullbackCone (Limits.WidePullback.base (fun _ : Fin N => p)) p)
          (j : Fin (N + 1)),
          Fin.lastCases (motive := fun _ => s.pt ⟶ Z) s.snd
            (fun i => s.fst ≫ Limits.WidePullback.π (fun _ : Fin N => p) i) j ≫ p = s.snd ≫ p := by
        intro s j
        refine Fin.lastCases ?_ (fun i => ?_) j
        · rw [Fin.lastCases_last]
        · rw [Fin.lastCases_castSucc, Category.assoc, Limits.WidePullback.π_arrow, s.condition]
      have hpb : IsPullback g (Limits.WidePullback.π (fun _ : Fin (N + 1) => p) (Fin.last N))
          (Limits.WidePullback.base (fun _ : Fin N => p)) p := by
        refine IsPullback.of_isLimit' ⟨comm⟩ ?_
        refine Limits.PullbackCone.IsLimit.mk comm
          (fun s => Limits.WidePullback.lift (s.snd ≫ p)
            (Fin.lastCases (motive := fun _ => s.pt ⟶ Z) s.snd
              (fun i => s.fst ≫ Limits.WidePullback.π (fun _ : Fin N => p) i)) (hw s)) ?_ ?_ ?_
        · intro s
          apply Limits.WidePullback.hom_ext (fun _ : Fin N => p)
          · intro i
            rw [Category.assoc, hgπ, Limits.WidePullback.lift_π, Fin.lastCases_castSucc]
          · rw [Category.assoc, hgb, Limits.WidePullback.lift_base, s.condition]
        · intro s
          rw [Limits.WidePullback.lift_π, Fin.lastCases_last]
        · intro s m h1 h2
          apply Limits.WidePullback.hom_ext (fun _ : Fin (N + 1) => p)
          · intro j
            refine Fin.lastCases ?_ (fun i => ?_) j
            · rw [Limits.WidePullback.lift_π, Fin.lastCases_last, h2]
            · rw [Limits.WidePullback.lift_π, Fin.lastCases_castSucc, ← hgπ, ← Category.assoc, h1]
          · rw [Limits.WidePullback.lift_base,
              ← Limits.WidePullback.π_arrow (fun _ : Fin (N + 1) => p) (Fin.last N),
              ← Category.assoc, h2]
      have hget : Etale g := MorphismProperty.of_isPullback (P := @Etale) hpb.flip inferInstance
      rw [← hgb]
      infer_instance

  have L6 : ∀ (X Y : Type u) [TopologicalSpace X] [TopologicalSpace Y]
      [ConnectedSpace Y] (p : X → Y), IsOpenMap p → IsClosedMap p → (∀ y : Y, (p ⁻¹' {y}).Finite) →
      ∀ A : Set X, IsClopen A → A.Nonempty →
        ∃ C : Set X, C ⊆ A ∧ IsClopen C ∧ C.Nonempty ∧ _root_.IsPreconnected C := by
    classical
    intro X Y _ _ _ f hO hCl hfin A hA hAne
    obtain ⟨y₀⟩ := (inferInstance : Nonempty Y)
    have hΦ : (f ⁻¹' {y₀}).Finite := hfin y₀
    have ha : ∀ S : Set X, IsClopen S → S.Nonempty → f '' S = Set.univ := by
      intro S hS hne
      exact IsClopen.eq_univ ⟨hCl _ hS.isClosed, hO _ hS.isOpen⟩ (hne.image _)
    have hb : ∀ S : Set X, IsClopen S → S.Nonempty → (S ∩ f ⁻¹' {y₀}).Nonempty := by
      intro S hS hne
      have : y₀ ∈ f '' S := by rw [ha S hS hne]; trivial
      obtain ⟨x, hx, hfx⟩ := this
      exact ⟨x, hx, hfx⟩
    have hP : ∃ n, ∃ S : Set X, S ⊆ A ∧ IsClopen S ∧ S.Nonempty ∧ (S ∩ f ⁻¹' {y₀}).ncard = n :=
      ⟨_, A, subset_rfl, hA, hAne, rfl⟩
    obtain ⟨S, hSA, hS, hne, hcard⟩ := Nat.find_spec hP
    have hmin : ∀ C : Set X, C ⊆ A → IsClopen C → C.Nonempty →
        Nat.find hP ≤ (C ∩ f ⁻¹' {y₀}).ncard :=
      fun C hCA hC' hCne => Nat.find_min' hP ⟨C, hCA, hC', hCne, rfl⟩
    have hpre : _root_.IsPreconnected S := by
      rw [isPreconnected_iff_subset_of_fully_disjoint_closed hS.isClosed]
      intro u v hu hv hsub hdisj
      by_cases hCu : (S ∩ u).Nonempty
      · by_cases hCv : (S ∩ v).Nonempty
        · exfalso
          have hSu_eq : S ∩ u = S ∩ vᶜ := by
            ext x
            constructor
            · rintro ⟨hxS, hxu⟩
              exact ⟨hxS, fun hxv => Set.disjoint_left.mp hdisj hxu hxv⟩
            · rintro ⟨hxS, hxv⟩
              refine ⟨hxS, ?_⟩
              rcases hsub hxS with h | h
              · exact h
              · exact absurd h hxv
          have hSv_eq : S ∩ v = S ∩ uᶜ := by
            ext x
            constructor
            · rintro ⟨hxS, hxv⟩
              exact ⟨hxS, fun hxu => Set.disjoint_left.mp hdisj hxu hxv⟩
            · rintro ⟨hxS, hxu⟩
              refine ⟨hxS, ?_⟩
              rcases hsub hxS with h | h
              · exact absurd h hxu
              · exact h
          have hclo : IsClopen (S ∩ u) :=
            ⟨hS.isClosed.inter hu, by rw [hSu_eq]; exact hS.isOpen.inter hv.isOpen_compl⟩
          have hclo' : IsClopen (S ∩ v) :=
            ⟨hS.isClosed.inter hv, by rw [hSv_eq]; exact hS.isOpen.inter hu.isOpen_compl⟩
          obtain ⟨x, ⟨hxS, hxv⟩, hxΦ⟩ := hb _ hclo' hCv
          have hlt : (S ∩ u ∩ f ⁻¹' {y₀}).ncard < (S ∩ f ⁻¹' {y₀}).ncard := by
            apply Set.ncard_lt_ncard _ (hΦ.subset Set.inter_subset_right)
            refine ⟨fun y hy => ⟨hy.1.1, hy.2⟩, fun h => ?_⟩
            have := h ⟨hxS, hxΦ⟩
            exact Set.disjoint_left.mp hdisj this.1.2 hxv
          have := hmin _ (Set.inter_subset_left.trans hSA) hclo hCu
          omega
        · left
          intro x hxS
          rcases hsub hxS with h | h
          · exact h
          · exact absurd ⟨x, hxS, h⟩ hCv
      · right
        intro x hxS
        rcases hsub hxS with h | h
        · exact absurd ⟨x, hxS, h⟩ hCu
        · exact h
    exact ⟨S, hSA, hS, hne, hpre⟩

  have RWE : ∀ (R T : Type u) [CommRing R] [CommRing T] (σ : R →+* T) (G : ℕ → Type u)
      [∀ k, CommRing (G k)] (Φ : ∀ k, R →+* G k) (ι : ∀ k, G k →+* T),
      (∀ k, (ι k).comp (Φ k) = σ) → (∀ k, (Φ k).Etale) →
      (∀ (n : ℕ) (t : Fin n → T), ∃ (k : ℕ) (x : Fin n → G k), ∀ i, ι k (x i) = t i) →
      (∀ (k n : ℕ) (x : Fin n → G k), (∀ i, ι k (x i) = 0) → ∃ (j : ℕ) (θ : G k →+* G j),
        (ι j).comp θ = ι k ∧ θ.comp (Φ k) = Φ j ∧ ∀ i, θ (x i) = 0) →
      @Algebra.WeaklyEtale R T _ _ σ.toAlgebra := by
    intro R T _ _ σ G _ Φ ι hcomp hetk hlift hvan
    apply wc_indEtale_weaklyEtale
    refine wc_seq_colimit_indEtale R T σ G Φ ι hcomp ?_ hlift hvan
    intro k
    unfold wcIndEtale
    letI : Algebra R (G k) := (Φ k).toAlgebra
    intro P _ _ _ h
    exact ⟨G k, inferInstance, inferInstance, hetk k, h, AlgHom.id R (G k), AlgHom.id_comp h⟩

  have H7 := wc_fet_galois_closure L3
    (wc_fet_field_point_section_bound wc_hom_ext_affine_open_appLE wc_fin_alg_hom_card_bound)
    (wc_fet_frame_component_galois L1) L6 wc_fnp_widePullback_finite

  obtain ⟨D, π, s, hπfin, hπet, hπsurj, hDconn, hπ, hDsurj, hs, hgalD⟩ :=
    wc_fet_galois_tower_build H7 U hconn E πE hfin het hsurj
  have hπaff : ∀ j, IsAffineHom (π j) := fun j => by
    haveI := hπfin j
    infer_instance

  obtain ⟨W₀, p, t, ht, hpaff, hcompat, hREP, hZERO⟩ :=
    wc_affine_seq_limit_exists wc_seq_colim_localization_away U D π hπaff hπ
  have hWE : WeaklyEtale p :=
    wc_affine_seq_limit_weaklyEtale RWE wc_lfi_specMap_weaklyEtale U D π hπ W₀ p t ht hcompat
      hpaff hπaff hπet hREP hZERO
  have htsurj : ∀ l, Surjective (t l) :=
    wc_affine_seq_limit_proj_surjective wc_seq_colim_comap_surjective U D π hπ W₀ p t ht hcompat
      hpaff hπaff hDsurj hREP hZERO
  have hW₀conn : ConnectedSpace W₀ :=
    wc_affine_seq_limit_connected U D π hπ W₀ p t ht hcompat hcpt hqs hpaff hπaff hDconn htsurj
      hREP hZERO
  haveI := hpaff
  refine ⟨W₀, p, hWE, inferInstance, ?_, hW₀conn, ?_, ?_, fun j => ⟨t j ≫ s j, ?_⟩, ?_⟩
  · rw [← ht 0]
    haveI := htsurj 0
    haveI := hπsurj 0
    infer_instance
  · exact QuasiCompact.compactSpace_of_compactSpace p
  · exact quasiSeparatedSpace_of_quasiSeparated p
  · rw [Category.assoc, hs j, ht j]

  · intro V a b hV hab
    have hab' : ∀ j, (a ≫ t j) ≫ π j = (b ≫ t j) ≫ π j := by
      intro j
      rw [Category.assoc, Category.assoc, ht j, hab]
    choose γ hγπ hγb using fun j => hgalD j V (a ≫ t j) (b ≫ t j) hV (hab' j)
    have hγb' : ∀ j, a ≫ t j ≫ γ j = b ≫ t j := fun j => by
      rw [← Category.assoc]
      exact (hγb j).symm
    obtain ⟨v₀⟩ := (inferInstance : Nonempty V)

    have hcomp : ∀ j k (h : j ≤ k),
        γ k ≫ D.map (homOfLE h).op = D.map (homOfLE h).op ≫ γ j := by
      intro j k h
      haveI := hπfin j
      haveI := hπet j
      haveI := hDconn k
      have hfe : (γ k ≫ D.map (homOfLE h).op) ≫ π j = (D.map (homOfLE h).op ≫ γ j) ≫ π j := by
        rw [Category.assoc, Category.assoc, hπ j k h, hγπ j, hπ j k h, hγπ k]
      refine L1 U _ _ (π j) inferInstance inferInstance _ _ hfe inferInstance ⟨(a ≫ t k) v₀, ?_⟩
      have key : (a ≫ t k) ≫ Limits.pullback.lift _ _ hfe =
          (b ≫ t j) ≫ Limits.pullback.diagonal (π j) := by
        apply Limits.pullback.hom_ext
        · simp only [Category.assoc, Limits.pullback.lift_fst, Limits.pullback.diagonal_fst,
            Category.comp_id]
          rw [← Category.assoc (t k), ← Category.assoc a, hγb' k, Category.assoc, hcompat j k h]
        · simp only [Category.assoc, Limits.pullback.lift_snd, Limits.pullback.diagonal_snd,
            Category.comp_id]
          rw [← Category.assoc (t k), hcompat j k h, hγb' j]
      have hpt := congrArg (fun m => m v₀) key
      simp only [Scheme.Hom.comp_apply] at hpt ⊢
      exact ⟨_, hpt.symm⟩
    have hz : ∀ j k (h : j ≤ k), (t k ≫ γ k) ≫ D.map (homOfLE h).op = t j ≫ γ j := by
      intro j k h
      rw [Category.assoc, hcomp j k h, ← Category.assoc, hcompat j k h]

    obtain ⟨g, hg⟩ := wc_affine_seq_limit_lift
      (wc_affine_seq_limit_local_lift wc_hom_ext_affine_open_appLE)
      (wc_affine_seq_limit_hom_ext wc_hom_ext_affine_open_appLE)
      U D π hπ W₀ p t ht hcompat hpaff hπaff hREP hZERO W₀ (fun j => t j ≫ γ j) hz
    have hg' : ∀ j, g ≫ t j = t j ≫ γ j := hg
    refine ⟨g, ?_, ?_⟩
    · rw [← ht 0, ← Category.assoc, hg' 0, Category.assoc, hγπ 0]
    · apply wc_affine_seq_limit_hom_ext wc_hom_ext_affine_open_appLE U D π W₀ p t ht hpaff hREP V
      intro j
      rw [Category.assoc, hg' j, hγb j, Category.assoc]

theorem wc_pencil_PL_galois_cover (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))) :
    ∃ (W : (wcP1Over F'').left.ProEt) (w : W ⟶ wcGeomPoint F'' (wcP1Over F'') hP) (r : ℕ)
      (θ : (wcRq D.f ℓ (n - 1)).over W ≅
        (wcContSheaf (wcP1Over F'').left (Fin r → ℚ_[ℓ])).over W),
      (∀ c : ℚ_[ℓ],
        ((Scheme.ProEt.topology (wcP1Over F'').left).overPullback AddCommGrpCat.{u+1} W).map
            (wcRqScalar D.f ℓ (n - 1) c) ≫ θ.hom =
          θ.hom ≫ ((Scheme.ProEt.topology (wcP1Over F'').left).overPullback
            AddCommGrpCat.{u+1} W).map (wcConstScalar (wcP1Over F'').left ℓ r c)) ∧
      QuasiCompact w.left ∧ ConnectedSpace W.left ∧
      (∀ (z : W.left) (i : Fin D.m), W.hom z ≠ D.S i (IsLocalRing.closedPoint F'')) ∧
      (∀ p : (wcGeomPoint F'' (wcP1Over F'') hP).left,
        (∀ i : Fin D.m, (wcGeomPoint F'' (wcP1Over F'') hP).hom p ≠
          D.S i (IsLocalRing.closedPoint F'')) →
        ∃ z : W.left, w.left z = p) ∧
      (∀ (V : (wcP1Over F'').left.ProEt) (a b : V ⟶ W), ConnectedSpace V.left →
        a ≫ w = b ≫ w → ∃ γ : W ⟶ W, γ ≫ w = w ∧ b = a ≫ γ) :=
by
  classical
  haveI := D.proper
  haveI hsep : IsSeparated (wcP1Over F'').hom := (inferInstance : IsSeparated (wcProjKStr F'' 1))
  haveI hcomp : IsProper (D.f ≫ (wcP1Over F'').hom) := by rw [D.hf]; exact D.proper
  haveI hfp : IsProper D.f := IsProper.of_comp D.f (wcP1Over F'').hom
  haveI hPw : WeaklyEtale (wcGeomPoint F'' (wcP1Over F'') hP).hom := hP
  obtain ⟨Ub, hUb, hconn, hcpt, hqs, hqcι⟩ := wc_P1bar_smooth_locus F'' hP D.m D.S D.hS
  haveI := hqcι
  have hu : WeaklyEtale (Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom) := inferInstance
  have htors : ∀ j : ℕ, ∃ (E : Scheme.{u}) (πE : E ⟶ Ub.toScheme),
      IsFinite πE ∧ Etale πE ∧ Surjective πE ∧
      ∃ hE : WeaklyEtale (πE ≫ Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom),
      ∃ (b' : ℕ) (e' : Fin b' → ℕ),
        Nonempty ((((wcProEtPush D.f).rightDerived (Nat.unpair j).1).obj
            (wcContSheaf D.Yt.left (ZMod (ℓ ^ (Nat.unpair j).2)))).over
            (MorphismProperty.Over.mk ⊤ (πE ≫ Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom) hE) ≅
          (wcContSheaf (wcP1Over F'').left ((i : Fin b') → ZMod (ℓ ^ e' i))).over
            (MorphismProperty.Over.mk ⊤ (πE ≫ Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom) hE)) := by
    intro j
    obtain ⟨N, V, v, het, hcov, hV, b, e, hiso⟩ :=
      wc_pencil_Rq_torsion_etale_locally_const F' F'' Y n D ℓ hℓ hP Ub hUb
        (Nat.unpair j).1 (Nat.unpair j).2
    exact wc_proet_loc_const_finite_fet_trivial (wcP1Over F'').left _ ℓ Ub.toScheme
      (Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom) hu hconn hcpt hqs N V v het hcov hV b e hiso
  choose E πE hfin het hsurj hE b' e' hθ using htors
  obtain ⟨W₀, p, hpWE, hpqc, hpsurj, hW₀conn, hW₀cpt, hW₀qs, ht, hgal₀⟩ :=
    wc_fet_galois_tower_connected_limit Ub.toScheme hconn hcpt hqs E πE hfin het hsurj
  choose t ht using ht
  haveI := hpWE
  haveI := hpqc
  have hWE : WeaklyEtale (p ≫ Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom) := inferInstance
  let W : (wcP1Over F'').left.ProEt :=
    MorphismProperty.Over.mk ⊤ (p ≫ Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom) hWE
  let w : W ⟶ wcGeomPoint F'' (wcP1Over F'') hP :=
    MorphismProperty.Over.homMk (p ≫ Ub.ι) (Category.assoc _ _ _) trivial
  let Ej : ℕ → (wcP1Over F'').left.ProEt := fun j =>
    MorphismProperty.Over.mk ⊤ (πE j ≫ Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom) (hE j)
  let c : ∀ j, W ⟶ Ej j := fun j =>
    MorphismProperty.Over.homMk (t j)
      (show t j ≫ πE j ≫ Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom =
          p ≫ Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom by
        rw [← Category.assoc, ht j]) trivial
  have hres : ∀ q' k : ℕ, ∃ (b : ℕ) (e : Fin b → ℕ),
      Nonempty ((((wcProEtPush D.f).rightDerived q').obj (wcContSheaf D.Yt.left (ZMod (ℓ ^ k)))).over W ≅
        (wcContSheaf (wcP1Over F'').left ((j : Fin b) → ZMod (ℓ ^ e j))).over W) := by
    intro q' k
    have h := hθ (Nat.pair q' k)
    rw [Nat.unpair_pair] at h
    obtain ⟨θ⟩ := h
    exact ⟨b' (Nat.pair q' k), e' (Nat.pair q' k),
      ⟨((Scheme.ProEt.topology (wcP1Over F'').left).overMapPullback AddCommGrpCat.{u+1}
        (c (Nat.pair q' k))).mapIso θ⟩⟩
  obtain ⟨a, b, e, hZ⟩ :=
    wc_proet_Rq_int_const_of_torsion_const D.f ℓ W hW₀conn hW₀cpt hW₀qs hres (n - 1)
  obtain ⟨τ, hτ⟩ := wc_proet_Rq_rat_linear_triv D.f ℓ W hW₀conn hW₀cpt hW₀qs (n - 1) a b e hZ
  refine ⟨W, w, a, τ, fun c' => hτ c', ?_, hW₀conn, ?_, ?_, ?_⟩
  · show QuasiCompact (p ≫ Ub.ι)
    infer_instance
  · intro z i
    have hy : Ub.ι (p z) ∈ Ub := by
      have hr : Ub.ι (p z) ∈ Set.range Ub.ι := ⟨p z, rfl⟩
      rw [Scheme.Opens.range_ι] at hr
      exact hr
    have key := (hUb (Ub.ι (p z))).1 hy i
    exact key
  · intro x hx
    have hxU : x ∈ Ub := (hUb x).2 hx
    obtain ⟨y, hy⟩ : x ∈ Set.range Ub.ι := by rw [Scheme.Opens.range_ι]; exact hxU
    obtain ⟨z, hz⟩ := hpsurj.surj y
    refine ⟨z, ?_⟩
    show (p ≫ Ub.ι) z = x
    rw [Scheme.Hom.comp_apply, hz, hy]
  · intro V a' b'' hV hab
    have h1 : a'.left ≫ p ≫ Ub.ι = b''.left ≫ p ≫ Ub.ι := by
      have := congrArg (fun f => f.left) hab
      exact this
    have h2' : (a'.left ≫ p) ≫ Ub.ι = (b''.left ≫ p) ≫ Ub.ι := by
      have e1 := Category.assoc a'.left p Ub.ι
      have e2 := Category.assoc b''.left p Ub.ι
      exact e1.trans (h1.trans e2.symm)
    have h2 : a'.left ≫ p = b''.left ≫ p := (cancel_mono Ub.ι).1 h2'
    obtain ⟨γ₀, hγp, hγb⟩ := hgal₀ V.left a'.left b''.left hV h2
    let γ : W ⟶ W := MorphismProperty.Over.homMk γ₀
      (show γ₀ ≫ p ≫ Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom =
          p ≫ Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom by
        rw [← Category.assoc, hγp]) trivial
    refine ⟨γ, ?_, ?_⟩
    · apply MorphismProperty.Over.Hom.ext
      show γ₀ ≫ p ≫ Ub.ι = p ≫ Ub.ι
      rw [← Category.assoc, hγp]
    · apply MorphismProperty.Over.Hom.ext
      show b''.left = a'.left ≫ γ₀
      exact hγb

theorem wc_contSheaf_over_hom_padic_pointwise (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (a b : ℕ) (V : S.ProEt)
    (φ : (wcContSheaf S (Fin a → ℚ_[ℓ])).over V ⟶ (wcContSheaf S (Fin b → ℚ_[ℓ])).over V) :
    ∃ G : V.left → ((Fin a → ℚ_[ℓ]) →+ (Fin b → ℚ_[ℓ])),
      ∀ (T : Over V) (f : (wcContSheaf S (Fin a → ℚ_[ℓ])).obj.obj (Opposite.op T.left))
        (t : T.left.left),
        (show C(↥T.left.left, Fin b → ℚ_[ℓ]) from ((φ.hom.app (Opposite.op T)).hom f).down) t =
          G (T.hom.left t) ((show C(↥T.left.left, Fin a → ℚ_[ℓ]) from f.down) t) :=
by
  classical

  obtain ⟨E, hE⟩ : ∃ E : ∀ W : Over V, C(↥W.left.left, Fin a → ℚ_[ℓ]) →
      C(↥W.left.left, Fin b → ℚ_[ℓ]),
      ∀ (W : Over V) (x : C(↥W.left.left, Fin a → ℚ_[ℓ])),
        E W x = (show C(↥W.left.left, Fin b → ℚ_[ℓ]) from ((φ.hom.app (Opposite.op W)).hom
          (show (wcContSheaf S (Fin a → ℚ_[ℓ])).obj.obj (Opposite.op W.left) from
            ULift.up x)).down) :=
    ⟨_, fun _ _ => rfl⟩

  have hnat : ∀ (U W : Over V) (σ : U ⟶ W) (x : C(↥W.left.left, Fin a → ℚ_[ℓ]))
      (z : ↥U.left.left), E U (x.comp σ.left.left.base.hom) z = E W x (σ.left.left z) := by
    intro U W σ x z
    have h2 := congrArg (fun F : ((wcContSheaf S (Fin a → ℚ_[ℓ])).over V).obj.obj (Opposite.op W) ⟶
        ((wcContSheaf S (Fin b → ℚ_[ℓ])).over V).obj.obj (Opposite.op U) => F.hom
        (show (wcContSheaf S (Fin a → ℚ_[ℓ])).obj.obj (Opposite.op W.left) from ULift.up x))
      (φ.hom.naturality σ.op)
    have h3 := congrArg (fun s : ULift.{u+1} C(↥U.left.left, Fin b → ℚ_[ℓ]) => s.down z) h2
    rw [hE, hE]
    exact h3

  have hadd : ∀ (W : Over V) (x y : C(↥W.left.left, Fin a → ℚ_[ℓ])),
      E W (x + y) = E W x + E W y := by
    intro W x y
    rw [hE, hE, hE]
    have h := map_add (φ.hom.app (Opposite.op W)).hom
      (show (wcContSheaf S (Fin a → ℚ_[ℓ])).obj.obj (Opposite.op W.left) from ULift.up x)
      (show (wcContSheaf S (Fin a → ℚ_[ℓ])).obj.obj (Opposite.op W.left) from ULift.up y)
    exact congrArg (fun s : ULift.{u+1} C(↥W.left.left, Fin b → ℚ_[ℓ]) => s.down) h

  let V₀ : Over V := Over.mk (𝟙 V)
  have hG : ∀ (v : V.left) (y y' : Fin a → ℚ_[ℓ]),
      E V₀ (ContinuousMap.const _ (y + y')) v =
        E V₀ (ContinuousMap.const _ y) v + E V₀ (ContinuousMap.const _ y') v := by
    intro v y y'
    have h1 : ContinuousMap.const (↥V₀.left.left) (y + y') =
        ContinuousMap.const _ y + ContinuousMap.const _ y' := ContinuousMap.ext fun _ => rfl
    rw [h1, hadd, ContinuousMap.add_apply]
  let G : V.left → ((Fin a → ℚ_[ℓ]) →+ (Fin b → ℚ_[ℓ])) := fun v =>
    AddMonoidHom.mk' (fun y => E V₀ (ContinuousMap.const _ y) v) (hG v)

  obtain ⟨P, p, hp, π, huniv, hsect⟩ := wc_profinite_universal_weaklyEtale V.left (Fin a → ℤ_[ℓ])
  haveI : WeaklyEtale (p ≫ V.hom) := by
    haveI := hp
    have := V.prop
    infer_instance
  let PVl : S.ProEt := Scheme.ProEt.mk (p ≫ V.hom)
  let PV : Over V := Over.mk (MorphismProperty.Over.homMk p rfl trivial : PVl ⟶ V)
  let τ : C(↥P, Fin a → ℚ_[ℓ]) := ⟨fun z i => ((π z i : ℤ_[ℓ]) : ℚ_[ℓ]),
    continuous_pi fun i => continuous_subtype_val.comp ((continuous_apply i).comp π.continuous)⟩

  have hfib : ∀ z : ↥P, E PV τ z = E V₀ (ContinuousMap.const _ (τ z)) (p z) := by
    intro z
    obtain ⟨σk, -, hσp, hσπ, hσu⟩ := hsect (π z)
    have hz := hσu _ (P.fromSpecResidueField z)
      (fun s => by rw [Scheme.fromSpecResidueField_apply])
    have hzσ : σk (p z) = z := by
      have s₀ : ↥(Spec (P.residueField z)) := Classical.arbitrary _
      have h1 := congrArg (fun g : Spec (P.residueField z) ⟶ P => g.base s₀) hz
      simp only [Scheme.Hom.comp_apply, Scheme.fromSpecResidueField_apply] at h1
      exact h1.symm
    have hσw : σk ≫ PVl.hom = V.hom := by
      show σk ≫ p ≫ V.hom = V.hom
      rw [← Category.assoc, hσp, Category.id_comp]
    let σl : V ⟶ PVl := MorphismProperty.Over.homMk σk hσw trivial
    let σh : V₀ ⟶ PV := Over.homMk σl (MorphismProperty.Over.Hom.ext (by exact hσp))
    have hτσ : τ.comp σh.left.left.base.hom = ContinuousMap.const _ (τ z) := by
      ext s i
      show ((π (σk.base s) i : ℤ_[ℓ]) : ℚ_[ℓ]) = ((π z i : ℤ_[ℓ]) : ℚ_[ℓ])
      rw [hσπ s]
    have h1 := hnat V₀ PV σh τ (p z)
    have h1' := (congrArg (fun F : C(↥V₀.left.left, Fin a → ℚ_[ℓ]) => E V₀ F (p z)) hτσ).symm.trans h1
    have h2 : σh.left.left (p z) = z := hzσ
    exact (h1'.trans (congrArg (E PV τ) h2)).symm

  have hint : ∀ (W : Over V) (x : C(↥W.left.left, Fin a → ℚ_[ℓ]))
      (c : C(↥W.left.left, Fin a → ℤ_[ℓ])),
      (∀ (s : ↥W.left.left) (i : Fin a), x s i = ((c s i : ℤ_[ℓ]) : ℚ_[ℓ])) →
      ∀ t : ↥W.left.left, E W x t = G (W.hom.left t) (x t) := by
    intro W x c hxc t
    obtain ⟨h, hhp, hhc⟩ := huniv W.left.left W.hom.left c
    have hw : h ≫ PVl.hom = W.left.hom := by
      show h ≫ p ≫ V.hom = W.left.hom
      rw [← Category.assoc, hhp]
      exact MorphismProperty.Over.w W.hom
    let hl : W.left ⟶ PVl := MorphismProperty.Over.homMk h hw trivial
    let hh : W ⟶ PV := Over.homMk hl (MorphismProperty.Over.Hom.ext (by exact hhp))
    have hxτ : x = τ.comp hh.left.left.base.hom := by
      ext s i
      exact (hxc s i).trans (congrArg (fun F : C(↥W.left.left, Fin a → ℤ_[ℓ]) =>
        ((F s i : ℤ_[ℓ]) : ℚ_[ℓ])) hhc.symm)
    have h1 : E W x t = E PV τ (hh.left.left t) :=
      (congrArg (fun F : C(↥W.left.left, Fin a → ℚ_[ℓ]) => E W F t) hxτ).trans
        (hnat W PV hh τ t)
    have e1 : τ (hh.left.left t) = x t :=
      (congrArg (fun F : C(↥W.left.left, Fin a → ℚ_[ℓ]) => F t) hxτ).symm
    have e2 : p (hh.left.left t) = W.hom.left t :=
      (Scheme.Hom.comp_apply h p t).symm.trans
        (congrArg (fun g : W.left.left ⟶ V.left => g.base t) hhp)
    calc E W x t = E PV τ (hh.left.left t) := h1
      _ = E V₀ (ContinuousMap.const _ (τ (hh.left.left t))) (p (hh.left.left t)) := hfib _
      _ = E V₀ (ContinuousMap.const _ (x t)) (W.hom.left t) := by rw [e1, e2]
      _ = G (W.hom.left t) (x t) := rfl

  refine ⟨G, ?_⟩
  intro T f t
  obtain ⟨x, hx⟩ : ∃ x : C(↥T.left.left, Fin a → ℚ_[ℓ]),
      x = (show C(↥T.left.left, Fin a → ℚ_[ℓ]) from f.down) := ⟨_, rfl⟩
  have key : E T x t = G (T.hom.left t) (x t) := by

    have hℓ1 : (1 : ℝ) < (ℓ : ℝ) := by exact_mod_cast (Fact.out : ℓ.Prime).one_lt
    obtain ⟨n, hn⟩ := pow_unbounded_of_one_lt ‖x t‖ hℓ1
    have hpos : (0 : ℝ) < (ℓ : ℝ) ^ n := by
      have : (0 : ℝ) < ℓ := by linarith
      positivity
    have hO : ∀ s : ↥T.left.left, x s ∈ Metric.ball (0 : Fin a → ℚ_[ℓ]) ((ℓ : ℝ) ^ n) →
        ∀ i : Fin a, ‖(ℓ : ℚ_[ℓ]) ^ n * x s i‖ ≤ 1 := by
      intro s hs i
      have hs' : ‖x s‖ < (ℓ : ℝ) ^ n := mem_ball_zero_iff.mp hs
      have hi : ‖x s i‖ ≤ (ℓ : ℝ) ^ n := (norm_le_pi_norm (x s) i).trans hs'.le
      calc ‖(ℓ : ℚ_[ℓ]) ^ n * x s i‖ = ((ℓ : ℝ) ^ n)⁻¹ * ‖x s i‖ := by
            rw [norm_mul, norm_pow, Padic.norm_p, inv_pow]
        _ ≤ ((ℓ : ℝ) ^ n)⁻¹ * (ℓ : ℝ) ^ n :=
            mul_le_mul_of_nonneg_left hi (inv_nonneg.mpr hpos.le)
        _ = 1 := inv_mul_cancel₀ hpos.ne'
    let O : T.left.left.Opens :=
      ⟨x ⁻¹' Metric.ball 0 ((ℓ : ℝ) ^ n), Metric.isOpen_ball.preimage x.continuous⟩
    have htO : t ∈ O := by
      show x t ∈ Metric.ball (0 : Fin a → ℚ_[ℓ]) ((ℓ : ℝ) ^ n)
      rw [mem_ball_zero_iff]
      exact hn

    let TOl : S.ProEt := wcVRes S T.left O
    let ιO : TOl ⟶ T.left := MorphismProperty.Over.homMk O.ι rfl trivial
    let T' : Over V := Over.mk (ιO ≫ T.hom)
    let σO : T' ⟶ T := Over.homMk ιO rfl
    let t' : ↥T'.left.left := (⟨t, htO⟩ : O)
    have hιt : σO.left.left t' = t := Scheme.Opens.ι_apply O ⟨t, htO⟩
    have L2 : T'.hom.left t' = T.hom.left t :=
      (Scheme.Hom.comp_apply σO.left.left T.hom.left t').trans
        (congrArg (fun s => T.hom.left s) hιt)
    obtain ⟨x', hx'⟩ : ∃ x' : C(↥T'.left.left, Fin a → ℚ_[ℓ]),
        x' = x.comp σO.left.left.base.hom := ⟨_, rfl⟩
    have L1 : E T' x' t' = E T x t :=
      (congrArg (fun F : C(↥T'.left.left, Fin a → ℚ_[ℓ]) => E T' F t') hx').trans
        ((hnat T' T σO x t').trans (congrArg (fun s => E T x s) hιt))

    obtain ⟨y, hy⟩ : ∃ y : C(↥T'.left.left, Fin a → ℚ_[ℓ]), y = (ℓ ^ n) • x' := ⟨_, rfl⟩
    have hyb : ∀ (s : ↥T'.left.left) (i : Fin a), ‖y s i‖ ≤ 1 := by
      intro s i
      have hmem : x (σO.left.left s) ∈ Metric.ball (0 : Fin a → ℚ_[ℓ]) ((ℓ : ℝ) ^ n) := by
        let s' : O := s
        have h1 : σO.left.left s = (s' : ↥T.left.left) := Scheme.Opens.ι_apply O s'
        rw [h1]
        exact s'.2
      rw [hy, ContinuousMap.nsmul_apply, Pi.smul_apply, nsmul_eq_mul, Nat.cast_pow, hx']
      exact hO _ hmem i
    let c : C(↥T'.left.left, Fin a → ℤ_[ℓ]) :=
      ⟨fun s i => (⟨y s i, hyb s i⟩ : ℤ_[ℓ]),
        continuous_pi fun i => ((continuous_apply i).comp y.continuous).subtype_mk
          (fun s => hyb s i)⟩
    have L3 : E T' y t' = G (T'.hom.left t') (y t') := hint T' y c (fun _ _ => rfl) t'
    have hyt : y t' = (ℓ ^ n) • x t := by
      rw [hy, ContinuousMap.nsmul_apply, hx']
      try exact congrArg (fun s => (ℓ ^ n) • x s) hιt
    let e : C(↥T'.left.left, Fin a → ℚ_[ℓ]) →+ C(↥T'.left.left, Fin b → ℚ_[ℓ]) :=
      AddMonoidHom.mk' (E T') (hadd T')
    have hEy : E T' y t' = (ℓ ^ n) • E T' x' t' := by
      have h := map_nsmul e (ℓ ^ n) x'
      have h' : E T' y = (ℓ ^ n) • E T' x' := by rw [hy]; exact h
      rw [h', ContinuousMap.nsmul_apply]
    have hfinal : (ℓ ^ n) • E T x t = (ℓ ^ n) • G (T.hom.left t) (x t) := by
      rw [← L1, ← hEy, L3, L2, hyt, map_nsmul]
    have hN : (ℓ ^ n : ℕ) ≠ 0 := pow_ne_zero _ (Fact.out : ℓ.Prime).ne_zero
    funext i
    have h3 := congrFun hfinal i
    simp only [Pi.smul_apply, nsmul_eq_mul] at h3
    exact mul_left_cancel₀ (Nat.cast_ne_zero.mpr hN) h3
  rw [hE] at key
  subst hx
  exact key

theorem wc_contSheaf_over_hom_padic_continuous (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (a b : ℕ) (V : S.ProEt) (hV : Nonempty V.left)
    (φ : (wcContSheaf S (Fin a → ℚ_[ℓ])).over V ⟶ (wcContSheaf S (Fin b → ℚ_[ℓ])).over V)
    (g : (Fin a → ℚ_[ℓ]) →+ (Fin b → ℚ_[ℓ]))
    (hg : ∀ (T : Over V) (f : (wcContSheaf S (Fin a → ℚ_[ℓ])).obj.obj (Opposite.op T.left))
        (t : T.left.left),
        (show C(↥T.left.left, Fin b → ℚ_[ℓ]) from ((φ.hom.app (Opposite.op T)).hom f).down) t =
          g ((show C(↥T.left.left, Fin a → ℚ_[ℓ]) from f.down) t)) :
    Continuous g :=
by
  classical
  obtain ⟨v₀⟩ := hV

  have s2 : ∀ M : ℝ, (∀ k : Fin a → ℤ_[ℓ], ‖g (fun i => ((k i : ℤ_[ℓ]) : ℚ_[ℓ]))‖ ≤ M) →
      Continuous g := by
    intro M hM
    apply continuous_of_continuousAt_zero g
    rw [Metric.continuousAt_iff]
    intro ε hε
    have hℓ1 : (1 : ℝ) < ℓ := by exact_mod_cast (Fact.out : ℓ.Prime).one_lt
    obtain ⟨n, hn⟩ := pow_unbounded_of_one_lt (max M 1 / ε) hℓ1
    have hpos : (0 : ℝ) < (ℓ : ℝ) ^ n := pow_pos (by linarith) n
    refine ⟨((ℓ : ℝ) ^ n)⁻¹, inv_pos.mpr hpos, ?_⟩
    intro y hy
    rw [dist_zero_right] at hy
    rw [map_zero, dist_zero_right]
    set c : ℚ_[ℓ] := (ℓ : ℚ_[ℓ]) ^ n with hc
    have hcnorm : ‖c‖ = ((ℓ : ℝ) ^ n)⁻¹ := by
      rw [hc, Padic.norm_p_pow, zpow_neg, zpow_natCast]
    have hc0 : c ≠ 0 := pow_ne_zero _ (Nat.cast_ne_zero.mpr (Fact.out : ℓ.Prime).ne_zero)
    have hk : ∀ i, ‖y i / c‖ ≤ 1 := by
      intro i
      rw [norm_div, hcnorm, div_inv_eq_mul]
      have h1 : ‖y i‖ ≤ ‖y‖ := norm_le_pi_norm y i
      have h2 : ‖y‖ * (ℓ : ℝ) ^ n < 1 := by
        calc ‖y‖ * (ℓ : ℝ) ^ n < ((ℓ : ℝ) ^ n)⁻¹ * (ℓ : ℝ) ^ n :=
              mul_lt_mul_of_pos_right hy hpos
          _ = 1 := inv_mul_cancel₀ hpos.ne'
      nlinarith [norm_nonneg (y i)]
    let k : Fin a → ℤ_[ℓ] := fun i => ⟨y i / c, hk i⟩
    have hyk : y = (ℓ ^ n : ℕ) • (fun i => ((k i : ℤ_[ℓ]) : ℚ_[ℓ])) := by
      funext i
      rw [Pi.smul_apply, ← Nat.cast_smul_eq_nsmul ℚ_[ℓ], smul_eq_mul, Nat.cast_pow, ← hc]
      show y i = c * (y i / c)
      rw [mul_div_cancel₀ _ hc0]
    have hgy : g y = c • g (fun i => ((k i : ℤ_[ℓ]) : ℚ_[ℓ])) := by
      rw [hyk, map_nsmul, ← Nat.cast_smul_eq_nsmul ℚ_[ℓ], Nat.cast_pow]
    rw [hgy, norm_smul, hcnorm]
    have hM' := (hM k).trans (le_max_left M 1)
    have hε' : max M 1 < ε * (ℓ : ℝ) ^ n := by rw [div_lt_iff₀ hε] at hn; linarith
    rw [inv_mul_lt_iff₀ hpos]
    nlinarith

  have sep : ∀ x y : (Fin a → ℤ_[ℓ]),
      (∀ U : Set (Fin a → ℤ_[ℓ]), IsClopen U → (x ∈ U ↔ y ∈ U)) → x = y := by
    intro x y h
    by_contra hxy
    obtain ⟨U, hU, hxU, hyU⟩ := exists_isClopen_of_totally_separated hxy
    exact hyU ((h U hU).mp hxU)

  have s6 : ∀ (k : Fin a → ℤ_[ℓ]) (T : Scheme.{u}) (x : ↥T) (U : Set (Fin a → ℤ_[ℓ]))
      (hU : IsClopen U),
      (specULiftZIsTerminal.from T ≫ Spec.map (CommRingCat.ofHom
        (LocallyConstant.evalRingHom k :
          LocallyConstant (Fin a → ℤ_[ℓ]) (ULift.{u} ℤ) →+* ULift.{u} ℤ))).base x ∈
          PrimeSpectrum.basicOpen (LocallyConstant.charFn (ULift.{u} ℤ) hU) ↔ k ∈ U := by
    intro k T x U hU
    have e : ((specULiftZIsTerminal.from T ≫ Spec.map (CommRingCat.ofHom
        (LocallyConstant.evalRingHom k :
          LocallyConstant (Fin a → ℤ_[ℓ]) (ULift.{u} ℤ) →+* ULift.{u} ℤ))).base x ∈
          PrimeSpectrum.basicOpen (LocallyConstant.charFn (ULift.{u} ℤ) hU)) ↔
        (LocallyConstant.charFn (ULift.{u} ℤ) hU k ∉
          ((specULiftZIsTerminal.from T).base x : PrimeSpectrum (ULift.{u} ℤ)).asIdeal) := Iff.rfl
    rw [e]
    by_cases hk : k ∈ U
    · rw [(LocallyConstant.charFn_eq_one _ _ _).mpr hk]
      simp only [hk, iff_true]
      exact Ideal.IsPrime.one_notMem
        ((specULiftZIsTerminal.from T).base x : PrimeSpectrum (ULift.{u} ℤ)).isPrime
    · rw [(LocallyConstant.charFn_eq_zero _ _ _).mpr hk]
      simp only [hk, iff_false, not_not]
      exact Ideal.zero_mem _

  obtain ⟨O, hO, hv₀O, -⟩ :=
    AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (X := V.left) (x := v₀) (U := ⊤) trivial
  haveI : IsAffine O.toScheme := hO

  have hιW : WeaklyEtale (Spec.map (CommRingCat.ofHom
      (algebraMap (ULift.{u} ℤ) (LocallyConstant (Fin a → ℤ_[ℓ]) (ULift.{u} ℤ))))) :=
    wc_lc_spec_weaklyEtale.{u} (Fin a → ℤ_[ℓ])
  have hιqc : QuasiCompact (Spec.map (CommRingCat.ofHom
      (algebraMap (ULift.{u} ℤ) (LocallyConstant (Fin a → ℤ_[ℓ]) (ULift.{u} ℤ))))) :=
    inferInstance
  obtain ⟨π0, hπ0⟩ := wc_lc_spec_pi0.{u} (Fin a → ℤ_[ℓ])
  obtain ⟨P, p, q, hpb⟩ : ∃ (P : Scheme.{u}) (p : P ⟶ O.toScheme)
      (q : P ⟶ Spec (CommRingCat.of (LocallyConstant (Fin a → ℤ_[ℓ]) (ULift.{u} ℤ)))),
      IsPullback p q (specULiftZIsTerminal.from O.toScheme) (Spec.map (CommRingCat.ofHom
        (algebraMap (ULift.{u} ℤ) (LocallyConstant (Fin a → ℤ_[ℓ]) (ULift.{u} ℤ))))) :=
    ⟨_, _, _, IsPullback.of_hasPullback _ _⟩
  have hp : WeaklyEtale p := MorphismProperty.of_isPullback (P := @WeaklyEtale) hpb.flip hιW
  have hpqc : QuasiCompact p := MorphismProperty.of_isPullback (P := @QuasiCompact) hpb.flip hιqc
  haveI : CompactSpace ↥P := QuasiCompact.compactSpace_of_compactSpace p

  have hW : WeaklyEtale (p ≫ (wcVRes S V O).hom) :=
    @MorphismProperty.comp_mem _ _ @WeaklyEtale
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ p (wcVRes S V O).hom
      hp (wcVRes S V O).prop
  let Pl : S.ProEt := MorphismProperty.Over.mk ⊤ (p ≫ (wcVRes S V O).hom) hW
  let Th : Pl ⟶ V := MorphismProperty.Over.homMk (p ≫ O.ι)
    (by
      show (p ≫ O.ι) ≫ V.hom = p ≫ (O.ι ≫ V.hom)
      rw [Category.assoc]) trivial
  let T : Over V := Over.mk Th
  let πc : C(↥P, Fin a → ℤ_[ℓ]) := π0.comp q.base.hom
  let τ : C(↥P, Fin a → ℚ_[ℓ]) :=
    ⟨fun z i => ((πc z i : ℤ_[ℓ]) : ℚ_[ℓ]),
      continuous_pi fun i => continuous_subtype_val.comp ((continuous_apply i).comp πc.continuous)⟩
  let f : (wcContSheaf S (Fin a → ℚ_[ℓ])).obj.obj (Opposite.op T.left) :=
    (show (wcContSheaf S (Fin a → ℚ_[ℓ])).obj.obj (Opposite.op Pl) from ULift.up τ)
  let F : C(↥T.left.left, Fin b → ℚ_[ℓ]) :=
    (show C(↥T.left.left, Fin b → ℚ_[ℓ]) from ((φ.hom.app (Opposite.op T)).hom f).down)
  haveI : CompactSpace ↥T.left.left := ‹CompactSpace ↥P›
  obtain ⟨M, hM⟩ := IsCompact.exists_bound_of_continuousOn isCompact_univ F.continuous.continuousOn
  apply s2 M
  intro k
  obtain ⟨σ, hσp, hσq⟩ : ∃ σ : O.toScheme ⟶ P, σ ≫ p = 𝟙 _ ∧
      σ ≫ q = specULiftZIsTerminal.from O.toScheme ≫ Spec.map (CommRingCat.ofHom
        (LocallyConstant.evalRingHom k :
          LocallyConstant (Fin a → ℤ_[ℓ]) (ULift.{u} ℤ) →+* ULift.{u} ℤ)) :=
    ⟨hpb.lift (𝟙 _) _ (specULiftZIsTerminal.hom_ext _ _), hpb.lift_fst _ _ _,
      hpb.lift_snd _ _ _⟩
  let s : O.toScheme := ⟨v₀, hv₀O⟩
  have hπk : πc (σ.base s) = k := by
    apply sep
    intro U hU
    have e1 : (σ ≫ q).base s = (specULiftZIsTerminal.from O.toScheme ≫ Spec.map (CommRingCat.ofHom
        (LocallyConstant.evalRingHom k :
          LocallyConstant (Fin a → ℤ_[ℓ]) (ULift.{u} ℤ) →+* ULift.{u} ℤ))).base s := by
      rw [hσq]
    have e2 : πc (σ.base s) = π0 ((σ ≫ q).base s) := rfl
    rw [e2]
    refine (hπ0 U hU ((σ ≫ q).base s)).trans ?_
    rw [e1]
    exact s6 k _ s U hU
  have h1 := hg T f (σ.base s)
  have h2 : (show C(↥T.left.left, Fin a → ℚ_[ℓ]) from f.down) (σ.base s) =
      fun i => ((k i : ℤ_[ℓ]) : ℚ_[ℓ]) := by
    funext i
    show ((πc (σ.base s) i : ℤ_[ℓ]) : ℚ_[ℓ]) = _
    rw [hπk]
  rw [h2] at h1
  rw [← h1]
  exact hM _ (Set.mem_univ _)

theorem wc_contSheaf_over_hom_linear (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (V : S.ProEt) (hV : ConnectedSpace V.left) (a b : ℕ)
    (φ : (wcContSheaf S (Fin a → ℚ_[ℓ])).over V ⟶ (wcContSheaf S (Fin b → ℚ_[ℓ])).over V) :
    ∃ A : (Fin a → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin b → ℚ_[ℓ]),
      φ = ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} V).map
        (wcContSheafMap S A.toAddMonoidHom (LinearMap.continuous_of_finiteDimensional A)) :=
by
  classical

  obtain ⟨G, hG⟩ := wc_contSheaf_over_hom_padic_pointwise S ℓ a b V φ
  obtain ⟨v₀⟩ : Nonempty V.left := ConnectedSpace.toNonempty

  let T1 : Over V := Over.mk (𝟙 V)
  have hconst : ∀ (v : V.left) (y : Fin a → ℚ_[ℓ]), G v y = G v₀ y := by
    intro v y
    let κ : (wcContSheaf S (Fin a → ℚ_[ℓ])).obj.obj (Opposite.op T1.left) :=
      (show (wcContSheaf S (Fin a → ℚ_[ℓ])).obj.obj (Opposite.op V) from
        ULift.up (ContinuousMap.const ↥V.left y))
    let F : C(↥V.left, Fin b → ℚ_[ℓ]) :=
      (show C(↥T1.left.left, Fin b → ℚ_[ℓ]) from ((φ.hom.app (Opposite.op T1)).hom κ).down)
    have hF : ∀ w : V.left, F w = G w y := by
      intro w
      exact hG T1 κ w
    have hsub : (Set.range F).Subsingleton :=
      (isPreconnected_range F.continuous).subsingleton
    rw [← hF, ← hF]
    exact hsub ⟨v, rfl⟩ ⟨v₀, rfl⟩

  have hform : ∀ (T : Over V) (f : (wcContSheaf S (Fin a → ℚ_[ℓ])).obj.obj (Opposite.op T.left))
      (t : T.left.left),
      (show C(↥T.left.left, Fin b → ℚ_[ℓ]) from ((φ.hom.app (Opposite.op T)).hom f).down) t =
        G v₀ ((show C(↥T.left.left, Fin a → ℚ_[ℓ]) from f.down) t) := by
    intro T f t
    rw [hG T f t, hconst]

  have hgc : Continuous (G v₀) :=
    wc_contSheaf_over_hom_padic_continuous S ℓ a b V ⟨v₀⟩ φ (G v₀) hform
  have hsmul : ∀ (c : ℚ_[ℓ]) (x : Fin a → ℚ_[ℓ]), G v₀ (c • x) = c • G v₀ x := by
    intro c x
    have h1 : Continuous (fun c : ℚ_[ℓ] => G v₀ (c • x)) :=
      hgc.comp (continuous_id.smul continuous_const)
    have h2 : Continuous (fun c : ℚ_[ℓ] => c • G v₀ x) :=
      continuous_id.smul continuous_const
    have h3 := Continuous.ext_on (Padic.denseRange_ratCast ℓ) h1 h2 (by
      rintro _ ⟨q, rfl⟩
      exact map_ratCast_smul (G v₀) ℚ_[ℓ] ℚ_[ℓ] q x)
    exact congrFun h3 c
  let A : (Fin a → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin b → ℚ_[ℓ]) :=
    { toFun := G v₀
      map_add' := (G v₀).map_add
      map_smul' := fun c x => hsmul c x }

  refine ⟨A, ?_⟩
  apply Sheaf.hom_ext
  apply NatTrans.ext
  funext T
  apply AddCommGrpCat.ext
  intro f
  apply ULift.ext
  apply ContinuousMap.ext
  intro t
  exact hform (Opposite.unop T) f t

theorem wc_pencil_PL_shens_nbhd_rigid (K : Type u) [Field K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (s : Spec (.of K) ⟶ (wcP1Over K).left) (hs : s ≫ (wcP1Over K).hom = 𝟙 _)
    (V : (wcP1Over K).left.ProEt) (v : V ⟶ wcGeomPoint K (wcP1Over K) hP)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V.left ≅ Spec (.of A))
    (hV : V.hom (e.inv (IsLocalRing.closedPoint A)) = s (IsLocalRing.closedPoint K))
    (V₀ : (wcP1Over K).left.ProEt) (v₀ : V₀ ⟶ wcGeomPoint K (wcP1Over K) hP)
    (A₀ : Type u) [CommRing A₀] [HenselianLocalRing A₀]
    [IsSepClosed (IsLocalRing.ResidueField A₀)]
    (e₀ : V₀.left ≅ Spec (.of A₀))
    (hV₀ : V₀.hom (e₀.inv (IsLocalRing.closedPoint A₀)) = s (IsLocalRing.closedPoint K)) :
    ∃ c : V ≅ V₀, c.hom ≫ v₀ = v :=
by
  classical

  have stalk : ∀ (P : Scheme.{u}) (p : P) (R : Type u) [CommRing R] [HenselianLocalRing R]
      [IsSepClosed (IsLocalRing.ResidueField R)] (q : P ⟶ Spec (.of R)) [WeaklyEtale q],
      q p = IsLocalRing.closedPoint R → IsIso (P.fromSpecStalk p ≫ q) := by
    intro P p R _ _ _ q _ hp
    haveI : WeaklyEtale (P.fromSpecStalk p) := wc_fromSpecStalk_weaklyEtale P p
    have hφg : Spec.map (Spec.preimage (P.fromSpecStalk p ≫ q)) = P.fromSpecStalk p ≫ q :=
      Spec.map_preimage _
    generalize Spec.preimage (P.fromSpecStalk p ≫ q) = φ at hφg
    have hwe : WeaklyEtale (Spec.map (CommRingCat.ofHom φ.hom)) := by
      rw [CommRingCat.ofHom_hom, hφg]; infer_instance
    letI : Algebra R (P.presheaf.stalk p) := φ.hom.toAlgebra
    have hW : Algebra.WeaklyEtale R (P.presheaf.stalk p) :=
      wc_lpkt_specMap_weaklyEtale_ring R (P.presheaf.stalk p) φ.hom hwe
    have hloc : IsLocalHom (algebraMap R (P.presheaf.stalk p)) := by
      rw [RingHom.algebraMap_toAlgebra, IsLocalRing.isLocalHom_iff_comap_closedPoint]
      have h0 := Scheme.Hom.comp_apply (P.fromSpecStalk p) q
        (IsLocalRing.closedPoint (P.presheaf.stalk p))
      rw [Scheme.fromSpecStalk_closedPoint, hp] at h0
      have h1 := congrArg (fun f : Spec (P.presheaf.stalk p) ⟶ Spec (.of R) =>
        f (IsLocalRing.closedPoint (P.presheaf.stalk p))) hφg
      simp only at h1
      have h2 : (Spec.map φ) (IsLocalRing.closedPoint (P.presheaf.stalk p)) =
          PrimeSpectrum.comap φ.hom (IsLocalRing.closedPoint (P.presheaf.stalk p)) := by
        first
          | rfl
          | (rw [Spec.map_base]; rfl)
      exact h2.symm.trans (h1.trans h0)
    have hbij := wc_olivier R (P.presheaf.stalk p) ‹_› ‹_› hloc hW
    rw [RingHom.algebraMap_toAlgebra] at hbij
    haveI : IsIso φ := (ConcreteCategory.isIso_iff_bijective φ).mpr hbij
    rw [← hφg]
    infer_instance

  have fibre : ∀ (x y : ↥(Limits.pullback (wcP1Over K).hom
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))))),
      Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) x =
        s (IsLocalRing.closedPoint K) →
      Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) y =
        s (IsLocalRing.closedPoint K) → x = y := by
    intro x y hx hy
    obtain ⟨rx, -, hrx⟩ := Scheme.Pullback.exists_preimage_pullback (f := s)
      (g := Limits.pullback.fst (wcP1Over K).hom
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))))
      (IsLocalRing.closedPoint K) x hx.symm
    obtain ⟨ry, -, hry⟩ := Scheme.Pullback.exists_preimage_pullback (f := s)
      (g := Limits.pullback.fst (wcP1Over K).hom
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))))
      (IsLocalRing.closedPoint K) y hy.symm
    haveI : IsIso (s ≫ (wcP1Over K).hom) := by rw [hs]; infer_instance
    haveI := Limits.pullback_snd_iso_of_left_iso (s ≫ (wcP1Over K).hom)
      (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))
    let E := Limits.pullbackRightPullbackFstIso (wcP1Over K).hom
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) s ≪≫
      asIso (Limits.pullback.snd (s ≫ (wcP1Over K).hom)
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))))
    have hr : rx = ry := by
      have e1 : E.hom rx = E.hom ry := Subsingleton.elim _ _
      have e2 := congrArg (fun z => E.inv z) e1
      simp only at e2
      rwa [Scheme.hom_inv_apply, Scheme.hom_inv_apply] at e2
    rw [← hrx, ← hry, hr]

  have hPhom : WeaklyEtale (wcGeomPoint K (wcP1Over K) hP).hom :=
    (wcGeomPoint K (wcP1Over K) hP).prop
  haveI hvW : WeaklyEtale v.left := by
    haveI : WeaklyEtale V.hom := V.prop
    haveI : WeaklyEtale (v.left ≫ (wcGeomPoint K (wcP1Over K) hP).hom) := by
      rw [MorphismProperty.Over.w v]; infer_instance
    exact WeaklyEtale.of_comp v.left (wcGeomPoint K (wcP1Over K) hP).hom
  haveI hv₀W : WeaklyEtale v₀.left := by
    haveI : WeaklyEtale V₀.hom := V₀.prop
    haveI : WeaklyEtale (v₀.left ≫ (wcGeomPoint K (wcP1Over K) hP).hom) := by
      rw [MorphismProperty.Over.w v₀]; infer_instance
    exact WeaklyEtale.of_comp v₀.left (wcGeomPoint K (wcP1Over K) hP).hom

  have hx : (wcGeomPoint K (wcP1Over K) hP).hom ((e.inv ≫ v.left) (IsLocalRing.closedPoint A)) =
      s (IsLocalRing.closedPoint K) := by
    have h1 := Scheme.Hom.comp_apply (e.inv ≫ v.left) (wcGeomPoint K (wcP1Over K) hP).hom
      (IsLocalRing.closedPoint A)
    have h2 := Scheme.Hom.comp_apply e.inv V.hom (IsLocalRing.closedPoint A)
    have h3 : (e.inv ≫ v.left) ≫ (wcGeomPoint K (wcP1Over K) hP).hom = e.inv ≫ V.hom := by
      rw [Category.assoc, MorphismProperty.Over.w v]
    have h4 := congrArg (fun f : Spec (.of A) ⟶ (wcP1Over K).left =>
      f (IsLocalRing.closedPoint A)) h3
    simp only at h4
    exact h1.symm.trans (h4.trans (h2.trans hV))
  have hy : (wcGeomPoint K (wcP1Over K) hP).hom
      ((e₀.inv ≫ v₀.left) (IsLocalRing.closedPoint A₀)) = s (IsLocalRing.closedPoint K) := by
    have h1 := Scheme.Hom.comp_apply (e₀.inv ≫ v₀.left) (wcGeomPoint K (wcP1Over K) hP).hom
      (IsLocalRing.closedPoint A₀)
    have h2 := Scheme.Hom.comp_apply e₀.inv V₀.hom (IsLocalRing.closedPoint A₀)
    have h3 : (e₀.inv ≫ v₀.left) ≫ (wcGeomPoint K (wcP1Over K) hP).hom = e₀.inv ≫ V₀.hom := by
      rw [Category.assoc, MorphismProperty.Over.w v₀]
    have h4 := congrArg (fun f : Spec (.of A₀) ⟶ (wcP1Over K).left =>
      f (IsLocalRing.closedPoint A₀)) h3
    simp only at h4
    exact h1.symm.trans (h4.trans (h2.trans hV₀))
  have hxy : (e.inv ≫ v.left) (IsLocalRing.closedPoint A) =
      (e₀.inv ≫ v₀.left) (IsLocalRing.closedPoint A₀) := fibre _ _ hx hy

  obtain ⟨p, hp1, hp2⟩ := Scheme.Pullback.exists_preimage_pullback
    (f := e.inv ≫ v.left) (g := e₀.inv ≫ v₀.left) _ _ hxy
  haveI hα := stalk _ p A (Limits.pullback.fst (e.inv ≫ v.left) (e₀.inv ≫ v₀.left)) hp1
  haveI hβ := stalk _ p A₀ (Limits.pullback.snd (e.inv ≫ v.left) (e₀.inv ≫ v₀.left)) hp2

  obtain ⟨c', hc'⟩ : ∃ c' : Spec (.of A) ≅ Spec (.of A₀),
      c'.hom ≫ (e₀.inv ≫ v₀.left) = e.inv ≫ v.left := by
    refine ⟨(asIso ((Limits.pullback (e.inv ≫ v.left) (e₀.inv ≫ v₀.left)).fromSpecStalk p ≫
        Limits.pullback.fst (e.inv ≫ v.left) (e₀.inv ≫ v₀.left))).symm ≪≫
      asIso ((Limits.pullback (e.inv ≫ v.left) (e₀.inv ≫ v₀.left)).fromSpecStalk p ≫
        Limits.pullback.snd (e.inv ≫ v.left) (e₀.inv ≫ v₀.left)), ?_⟩
    simp only [Iso.trans_hom, Iso.symm_hom, asIso_hom, asIso_inv, Category.assoc]
    rw [← Limits.pullback.condition, ← Category.assoc (Scheme.fromSpecStalk _ p),
      IsIso.inv_hom_id_assoc]

  have hcl : (e ≪≫ c' ≪≫ e₀.symm).hom ≫ v₀.left = v.left := by
    simp only [Iso.trans_hom, Iso.symm_hom, Category.assoc]
    rw [hc', Iso.hom_inv_id_assoc]
  have hcl2 : (e ≪≫ c' ≪≫ e₀.symm).hom ≫ V₀.hom = V.hom := by
    rw [← MorphismProperty.Over.w v₀, ← Category.assoc, hcl, MorphismProperty.Over.w v]
  refine ⟨MorphismProperty.Over.isoMk (e ≪≫ c' ≪≫ e₀.symm) hcl2, ?_⟩
  apply MorphismProperty.Over.Hom.ext
  refine (MorphismProperty.Comma.comp_left _ _).trans ?_
  first
    | exact hcl
    | (refine (congrArg (· ≫ v₀.left) (MorphismProperty.Over.isoMk_hom_left _ _)).trans ?_;
       exact hcl)

theorem wc_P1_sections_closed_generize (K : Type u) [Field K]
    (m : ℕ) (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left))
    (hS : ∀ i, S i ≫ (wcP1Over K).hom = 𝟙 _) :
    IsClosed {p : (wcP1Over K).left | ∃ i : Fin m, p = S i (IsLocalRing.closedPoint K)} ∧
    ∀ (T : (wcP1Over K).left.ProEt) (t : T.left),
      T.hom t ∈ {p : (wcP1Over K).left | ∃ i : Fin m, p = S i (IsLocalRing.closedPoint K)} →
      ∃ t' : T.left, t' ⤳ t ∧
        T.hom t' ∉ {p : (wcP1Over K).left | ∃ i : Fin m, p = S i (IsLocalRing.closedPoint K)} :=
by
  classical
  haveI hsub : Subsingleton (Spec (.of K)) := by
    show Subsingleton (PrimeSpectrum K); infer_instance

  have hpt : ∀ i, IsClosed ({S i (IsLocalRing.closedPoint K)} : Set (wcP1Over K).left) := by
    intro i
    haveI := isClosedImmersion_of_comp_eq_id (wcP1Over K).hom (S i) (hS i)
    have hr : IsClosed (Set.range (S i)) := (S i).isClosedEmbedding.isClosed_range
    have e : Set.range (S i) = {S i (IsLocalRing.closedPoint K)} := by
      ext x
      simp only [Set.mem_range, Set.mem_singleton_iff]
      constructor
      · rintro ⟨p, rfl⟩; rw [Subsingleton.elim p (IsLocalRing.closedPoint K)]
      · rintro rfl; exact ⟨_, rfl⟩
    rw [← e]; exact hr

  have hSigma : IsClosed
      {p : (wcP1Over K).left | ∃ i : Fin m, p = S i (IsLocalRing.closedPoint K)} := by
    have e : {p : (wcP1Over K).left | ∃ i : Fin m, p = S i (IsLocalRing.closedPoint K)} =
        ⋃ i, ({S i (IsLocalRing.closedPoint K)} : Set (wcP1Over K).left) := by
      ext p
      rw [Set.mem_iUnion]
      exact ⟨fun ⟨i, h⟩ => ⟨i, h⟩, fun ⟨i, h⟩ => ⟨i, h⟩⟩
    rw [e]; exact isClosed_iUnion_of_finite hpt

  obtain ⟨η, hη, hne⟩ : ∃ η : (wcP1Over K).left, (∀ x : (wcP1Over K).left, η ⤳ x) ∧
      ∃ x : (wcP1Over K).left, x ≠ η := by
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) :=
      MvPolynomial.gradedAlgebra
    change ∃ η : ProjectiveSpectrum (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K),
      (∀ x, η ⤳ x) ∧ ∃ x, x ≠ η
    have hprime : (⊥ : HomogeneousIdeal
        (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K)).toIdeal.IsPrime := by
      rw [HomogeneousIdeal.toIdeal_bot]
      exact Ideal.isPrime_bot
    have hX : ∀ j : Fin (1 + 1), MvPolynomial.X j ∈
        HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) :=
      fun j => HomogeneousIdeal.mem_irrelevant_of_mem
        (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) (i := 1) Nat.one_pos
        ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K j))
    have hirr : ¬ HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K)
        ≤ ⊥ := by
      intro h
      have h0 := h (hX 0)
      rw [← HomogeneousIdeal.mem_iff, HomogeneousIdeal.toIdeal_bot, Ideal.mem_bot] at h0
      exact MvPolynomial.X_ne_zero (0 : Fin (1 + 1)) h0
    let η : ProjectiveSpectrum (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) :=
      ⟨⊥, hprime, hirr⟩
    let J : Ideal (MvPolynomial (Fin (1 + 1)) K) := Ideal.span {MvPolynomial.X 0}
    have hJh : J.IsHomogeneous (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) := by
      apply Ideal.homogeneous_span
      intro y hy
      rw [Set.mem_singleton_iff] at hy
      subst hy
      exact ⟨1, (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K 0)⟩
    let I := Ideal.homogeneousHull (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) J
    have hI : I.toIdeal = J := hJh.toIdeal_homogeneousHull_eq_self
    have hIprime : I.toIdeal.IsPrime := by
      rw [hI]
      exact (Ideal.span_singleton_prime (MvPolynomial.X_ne_zero 0)).mpr MvPolynomial.X_prime
    have hIirr : ¬ HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K)
        ≤ I := by
      intro h
      have h1 := h (hX 1)
      rw [← HomogeneousIdeal.mem_iff, hI, Ideal.mem_span_singleton] at h1
      obtain ⟨c, hc⟩ := h1
      have := congrArg (MvPolynomial.eval ![(0 : K), 1]) hc
      simp at this
    let x : ProjectiveSpectrum (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) :=
      ⟨I, hIprime, hIirr⟩
    refine ⟨η, fun y => ?_, x, ?_⟩
    · apply specializes_iff_mem_closure.mpr
      apply (ProjectiveSpectrum.le_iff_mem_closure _ η y).mp
      apply (ProjectiveSpectrum.as_ideal_le_as_ideal _ η y).mp
      exact bot_le
    · intro hxη
      have e : I = ⊥ := congrArg ProjectiveSpectrum.asHomogeneousIdeal hxη
      have h0 : MvPolynomial.X 0 ∈ I.toIdeal := by
        rw [hI]; exact Ideal.mem_span_singleton_self _
      rw [e, HomogeneousIdeal.toIdeal_bot, Ideal.mem_bot] at h0
      exact MvPolynomial.X_ne_zero (0 : Fin (1 + 1)) h0

  have hetaS : η ∉ {p : (wcP1Over K).left | ∃ i : Fin m, p = S i (IsLocalRing.closedPoint K)} := by
    rintro ⟨i, hi⟩
    obtain ⟨x, hx⟩ := hne
    have hxm : x ∈ ({S i (IsLocalRing.closedPoint K)} : Set (wcP1Over K).left) :=
      (hη x).mem_closed (hpt i) (by rw [Set.mem_singleton_iff]; exact hi)
    exact hx ((Set.mem_singleton_iff.mp hxm).trans hi.symm)

  refine ⟨hSigma, ?_⟩
  intro T t _
  haveI : WeaklyEtale T.hom := T.prop
  obtain ⟨t', ht', hpt'⟩ := Flat.generalizingMap T.hom (hη (T.hom t))
  refine ⟨t', ht', ?_⟩
  rw [show T.hom t' = η from hpt']
  exact hetaS

theorem wc_fpe_sepClosure_weaklyEtale (K : Type u) [Field K] :
    WeaklyEtale (Spec.map (CommRingCat.ofHom (algebraMap K (SeparableClosure K)))) :=
by
  classical

  have hsep : ∀ s : SeparableClosure K, ∃ c : TensorProduct K (SeparableClosure K) (SeparableClosure K),
      Algebra.TensorProduct.lmul' K c = 1 ∧
        c * (TensorProduct.tmul K (1 : SeparableClosure K) s - TensorProduct.tmul K s 1) = 0 := by
    intro s
    haveI : Algebra.IsSeparable K (SeparableClosure K) := inferInstance
    haveI : FiniteDimensional K (IntermediateField.adjoin K {s}) :=
      IntermediateField.adjoin.finiteDimensional (Algebra.IsSeparable.isIntegral K s)
    haveI : Algebra.IsSeparable K (IntermediateField.adjoin K {s}) :=
      Algebra.isSeparable_tower_bot_of_isSeparable K _ (SeparableClosure K)
    haveI : Algebra.FormallyUnramified K (IntermediateField.adjoin K {s}) :=
      Algebra.FormallyUnramified.of_isSeparable K _
    haveI : Algebra.FiniteType K (IntermediateField.adjoin K {s}) := Module.Finite.finiteType _
    haveI : Algebra.EssFiniteType K (IntermediateField.adjoin K {s}) :=
      Algebra.EssFiniteType.of_finiteType K _
    obtain ⟨t, ht1, ht2⟩ :=
      (Algebra.FormallyUnramified.iff_exists_tensorProduct (R := K)
        (S := IntermediateField.adjoin K {s})).mp inferInstance
    let φ := Algebra.TensorProduct.map (IntermediateField.adjoin K {s}).val
      (IntermediateField.adjoin K {s}).val
    have hμ : ∀ x : TensorProduct K (IntermediateField.adjoin K {s}) (IntermediateField.adjoin K {s}),
        Algebra.TensorProduct.lmul' K (φ x) =
          (IntermediateField.adjoin K {s}).val (Algebra.TensorProduct.lmul' K x) := by
      intro x
      induction x using TensorProduct.induction_on with
      | zero => simp
      | tmul a b => simp [φ]
      | add a b ha hb => simp only [map_add, ha, hb]
    let g : IntermediateField.adjoin K {s} := ⟨s, IntermediateField.mem_adjoin_simple_self K s⟩
    refine ⟨φ t, ?_, ?_⟩
    · rw [hμ, ht2, map_one]
    · have hg : φ (TensorProduct.tmul K 1 g - TensorProduct.tmul K g 1) =
          TensorProduct.tmul K (1 : SeparableClosure K) s - TensorProduct.tmul K s 1 := by
        simp [φ, g]
      rw [← hg, ← map_mul, mul_comm, ht1 g, map_zero]

  have hflatμ : RingHom.Flat
      (Algebra.TensorProduct.lmul' K :
        TensorProduct K (SeparableClosure K) (SeparableClosure K) →ₐ[K] SeparableClosure K).toRingHom := by
    let μ := (Algebra.TensorProduct.lmul' K :
        TensorProduct K (SeparableClosure K) (SeparableClosure K) →ₐ[K] SeparableClosure K)
    letI : Algebra (TensorProduct K (SeparableClosure K) (SeparableClosure K)) (SeparableClosure K) :=
      μ.toRingHom.toAlgebra
    let M : Submonoid (TensorProduct K (SeparableClosure K) (SeparableClosure K)) :=
      Submonoid.comap μ.toRingHom (IsUnit.submonoid (SeparableClosure K))
    have hM : ∀ y, y ∈ M ↔ IsUnit (μ y) := fun y => by
      rw [Submonoid.mem_comap, IsUnit.mem_submonoid_iff]; rfl
    haveI : IsLocalization (R := TensorProduct K (SeparableClosure K) (SeparableClosure K))
        M (SeparableClosure K) := by
      refine ⟨?_, ?_, ?_⟩
      · intro y
        exact (hM y.1).mp y.2
      · intro z
        refine ⟨⟨TensorProduct.tmul K z 1, 1⟩, ?_⟩
        show z * μ 1 = μ (TensorProduct.tmul K z 1)
        rw [map_one, Algebra.TensorProduct.lmul'_apply_tmul, mul_one]
      · intro x y hxy
        change μ x = μ y at hxy
        have hker : x - y ∈ Ideal.span (Set.range fun s : SeparableClosure K =>
            TensorProduct.tmul K (1 : SeparableClosure K) s - TensorProduct.tmul K s 1) := by
          rw [KaehlerDifferential.span_range_eq_ideal, KaehlerDifferential.ideal, RingHom.mem_ker,
            map_sub]
          exact sub_eq_zero.mpr hxy
        have key : ∀ a ∈ Ideal.span (Set.range fun s : SeparableClosure K =>
            TensorProduct.tmul K (1 : SeparableClosure K) s - TensorProduct.tmul K s 1),
            ∃ c ∈ M, c * a = 0 := by
          intro a ha
          induction ha using Submodule.span_induction with
          | mem a ha =>
            obtain ⟨s, rfl⟩ := ha
            obtain ⟨c, hc1, hc2⟩ := hsep s
            refine ⟨c, (hM c).mpr ?_, hc2⟩
            show IsUnit (Algebra.TensorProduct.lmul' K c)
            rw [hc1]; exact isUnit_one
          | zero => exact ⟨1, M.one_mem, mul_zero 1⟩
          | add a b _ _ ha hb =>
            obtain ⟨c1, h1, e1⟩ := ha
            obtain ⟨c2, h2, e2⟩ := hb
            exact ⟨c1 * c2, M.mul_mem h1 h2, by linear_combination c2 * e1 + c1 * e2⟩
          | smul r a _ ha =>
            obtain ⟨c, h, e⟩ := ha
            refine ⟨c, h, ?_⟩
            rw [smul_eq_mul]; linear_combination r * e
        obtain ⟨c, hc, e⟩ := key _ hker
        exact ⟨⟨c, hc⟩, by rw [mul_sub] at e; exact sub_eq_zero.mp e⟩
    exact IsLocalization.flat (R := TensorProduct K (SeparableClosure K) (SeparableClosure K))
      (SeparableClosure K) M
  have hf : Flat (Spec.map (CommRingCat.ofHom (algebraMap K (SeparableClosure K)))) := by
    rw [HasRingHomProperty.Spec_iff (P := @Flat)]
    exact RingHom.flat_algebraMap_iff.mpr inferInstance
  have hd : Flat (Limits.pullback.diagonal
      (Spec.map (CommRingCat.ofHom (algebraMap K (SeparableClosure K))))) := by
    rw [diagonal_SpecMap]
    haveI : Flat (Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.lmul' K :
        TensorProduct K (SeparableClosure K) (SeparableClosure K) →ₐ[K]
          SeparableClosure K).toRingHom)) :=
      HasRingHomProperty.Spec_iff.mpr hflatμ
    infer_instance
  exact ⟨hf, hd⟩

theorem wc_pencil_PL_generic_geom_point (K : Type u) [Field K] (m : ℕ)
    (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left)) (hS : ∀ j, S j ≫ (wcP1Over K).hom = 𝟙 _)
    (V₀ : (wcP1Over K).left.ProEt)
    (A₀ : Type u) [CommRing A₀] [HenselianLocalRing A₀]
    [IsSepClosed (IsLocalRing.ResidueField A₀)]
    (e₀ : V₀.left ≅ Spec (.of A₀)) :
    ∃ (E : (wcP1Over K).left.ProEt) (a₀ : E ⟶ V₀) (L : Type u) (_ : Field L) (_ : IsSepClosed L)
      (eE : E.left ≅ Spec (.of L)),
      ∀ (z : E.left) (j : Fin m), E.hom z ≠ S j (IsLocalRing.closedPoint K) :=
by
  classical

  have s1 : ∀ (K B : Type u) [CommRing K] [CommRing B] [IsLocalRing B] [Algebra K B],
      IsField K → Algebra.WeaklyEtale K B → IsLocalRing.maximalIdeal B = ⊥ := by
    intro K B _ _ _ _ hK hW
    letI : Field K := hK.toField
    have hμsurj : Function.Surjective (Algebra.TensorProduct.lmul' K (S := B)) := fun b =>
      ⟨b ⊗ₜ[K] (1 : B), by rw [Algebra.TensorProduct.lmul'_apply_tmul, mul_one]⟩
    have hflatQ : Module.Flat (TensorProduct K B B)
        (TensorProduct K B B ⧸ RingHom.ker (Algebra.TensorProduct.lmul' K (S := B)).toRingHom) := by
      let e := RingHom.quotientKerEquivOfSurjective
        (f := (Algebra.TensorProduct.lmul' K (S := B)).toRingHom) hμsurj
      have h1 : ((Algebra.TensorProduct.lmul' K (S := B)).toRingHom).Flat := hW.flat_lmul'
      have h2 : (e.symm.toRingHom.comp (Algebra.TensorProduct.lmul' K (S := B)).toRingHom).Flat :=
        RingHom.Flat.comp h1 (RingHom.Flat.of_bijective (f := e.symm.toRingHom) e.symm.bijective)
      have h3 : e.symm.toRingHom.comp (Algebra.TensorProduct.lmul' K (S := B)).toRingHom =
          algebraMap _ (TensorProduct K B B ⧸
            RingHom.ker (Algebra.TensorProduct.lmul' K (S := B)).toRingHom) := by
        refine RingHom.ext fun t => ?_
        rw [Ideal.Quotient.algebraMap_eq]
        show e.symm (Algebra.TensorProduct.lmul' K (S := B) t) = Ideal.Quotient.mk _ t
        rw [e.symm_apply_eq]
        rfl
      rw [h3, RingHom.flat_algebraMap_iff] at h2
      exact h2
    have habs : ∀ (S : Type u) [CommRing S] (I : Ideal S), Module.Flat S (S ⧸ I) →
        ∀ x ∈ I, ∃ z ∈ I, x * z = x := by
      intro S _ I hflat x hx
      have hrel : ∑ i : Fin 1, (fun _ => x) i • (fun _ => (1 : S ⧸ I)) i = 0 := by
        rw [Fin.sum_univ_one]
        show x • (1 : S ⧸ I) = 0
        rw [Algebra.smul_def, Ideal.Quotient.algebraMap_eq, mul_one,
          Ideal.Quotient.eq_zero_iff_mem]
        exact hx
      obtain ⟨k, a, y, h1, h2⟩ := Module.Flat.isTrivialRelation_of_sum_smul_eq_zero hrel
      choose b hb using fun j => Ideal.Quotient.mk_surjective (I := I) (y j)
      set w : S := ∑ j, a 0 j * b j with hw
      have h10 : (1 : S ⧸ I) = ∑ j, a 0 j • y j := h1 0
      have hmk : Ideal.Quotient.mk I w = 1 := by
        rw [hw, map_sum, h10]
        refine Finset.sum_congr rfl (fun j _ => ?_)
        rw [map_mul, hb j, Algebra.smul_def, Ideal.Quotient.algebraMap_eq]
      have hxw : x * w = 0 := by
        rw [hw, Finset.mul_sum]
        refine Finset.sum_eq_zero (fun j _ => ?_)
        have := h2 j
        rw [Fin.sum_univ_one] at this
        rw [← mul_assoc, this, zero_mul]
      refine ⟨1 - w, ?_, ?_⟩
      · rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, map_one, hmk, sub_self]
      · rw [mul_sub, mul_one, hxw, sub_zero]
    have habs := habs _ _ hflatQ
    have t1 : ∀ b : B, ∃ w : TensorProduct K B B, Algebra.TensorProduct.lmul' K w = 1 ∧
        (b ⊗ₜ[K] (1 : B)) * w = ((1 : B) ⊗ₜ[K] b) * w := by
      intro b
      have hx : b ⊗ₜ[K] (1 : B) - (1 : B) ⊗ₜ[K] b ∈
          RingHom.ker (Algebra.TensorProduct.lmul' K (S := B)).toRingHom := by
        rw [RingHom.mem_ker]
        show Algebra.TensorProduct.lmul' K (S := B) (b ⊗ₜ[K] (1 : B) - (1 : B) ⊗ₜ[K] b) = 0
        rw [map_sub, Algebra.TensorProduct.lmul'_apply_tmul, Algebra.TensorProduct.lmul'_apply_tmul,
          mul_one, one_mul, sub_self]
      obtain ⟨z, hzI, hxz⟩ := habs _ hx
      refine ⟨1 - z, ?_, ?_⟩
      · have hz : Algebra.TensorProduct.lmul' K (S := B) z = 0 := RingHom.mem_ker.mp hzI
        rw [map_sub, map_one, hz, sub_zero]
      · rw [← sub_eq_zero, ← sub_mul, mul_sub, mul_one, hxz, sub_self]
    have t2 : ∀ r : B, ∃ g : B →ₗ[K] B, ∀ b : B, r * g (r * b) = r * b := by
      intro r
      let m := LinearMap.mulLeft K r
      obtain ⟨s, hs⟩ := LinearMap.exists_rightInverse_of_surjective m.rangeRestrict
        (LinearMap.range_rangeRestrict m)
      obtain ⟨g, hg⟩ := LinearMap.exists_extend s
      refine ⟨g, fun b => ?_⟩
      have hp : r * b ∈ LinearMap.range m := ⟨b, rfl⟩
      have h1 : g (r * b) = s ⟨r * b, hp⟩ := LinearMap.congr_fun hg ⟨r * b, hp⟩
      rw [h1]
      have h2 := congrArg Subtype.val (LinearMap.congr_fun hs ⟨r * b, hp⟩)
      exact h2
    have t3 : ∀ (r : B) (g : B →ₗ[K] B), (∀ b : B, r * g (r * b) = r * b) →
        ∀ w : TensorProduct K B B, Algebra.TensorProduct.lmul' K w = 1 →
        (r ⊗ₜ[K] (1 : B)) * w = ((1 : B) ⊗ₜ[K] r) * w → ∃ y : B, r = r * r * y := by
      intro r g hg w hμ hw
      let Φ : TensorProduct K B B →ₗ[K] B := TensorProduct.lift ((LinearMap.mul K B).compl₂ g)
      have hΦ : ∀ a b : B, Φ (a ⊗ₜ[K] b) = a * g b := by
        intro a b
        simp [Φ, TensorProduct.lift.tmul]
      have hA : ∀ t, r * Φ (((1 : B) ⊗ₜ[K] r) * t) = r * Algebra.TensorProduct.lmul' K t := by
        intro t
        induction t using TensorProduct.induction_on with
        | zero => rw [mul_zero, map_zero, map_zero]
        | tmul a b =>
          rw [Algebra.TensorProduct.tmul_mul_tmul, hΦ, Algebra.TensorProduct.lmul'_apply_tmul,
            one_mul]
          calc r * (a * g (r * b)) = a * (r * g (r * b)) := by ring
            _ = a * (r * b) := by rw [hg]
            _ = r * (a * b) := by ring
        | add x y hx hy => rw [mul_add, map_add, mul_add, hx, hy, map_add, mul_add]
      have hB : ∀ t, Φ ((r ⊗ₜ[K] (1 : B)) * t) = r * Φ t := by
        intro t
        induction t using TensorProduct.induction_on with
        | zero => rw [mul_zero, map_zero, mul_zero]
        | tmul a b => rw [Algebra.TensorProduct.tmul_mul_tmul, hΦ, hΦ, one_mul, mul_assoc]
        | add x y hx hy => rw [mul_add, map_add, hx, hy, map_add, mul_add]
      refine ⟨Φ w, ?_⟩
      calc r = r * Algebra.TensorProduct.lmul' K w := by rw [hμ, mul_one]
        _ = r * Φ (((1 : B) ⊗ₜ[K] r) * w) := (hA w).symm
        _ = r * Φ ((r ⊗ₜ[K] (1 : B)) * w) := by rw [hw]
        _ = r * r * Φ w := by rw [hB, mul_assoc]
    rw [eq_bot_iff]
    intro t ht
    rw [Ideal.mem_bot]
    obtain ⟨g, hg⟩ := t2 t
    obtain ⟨w, hμ, hw⟩ := t1 t
    obtain ⟨y, hy⟩ := t3 t g hg w hμ hw
    rcases IsLocalRing.isUnit_or_isUnit_one_sub_self (t * y) with h | h
    · exfalso
      exact (IsLocalRing.mem_maximalIdeal _).mp (Ideal.mul_mem_right y _ ht) h
    · have h0 : t * (1 - t * y) = 0 := by
        calc t * (1 - t * y) = t - t * t * y := by ring
          _ = 0 := by rw [← hy, sub_self]
      exact (h.mul_left_eq_zero).mp h0

  have s2 : ∀ (S : Scheme.{u}) (V' : S.ProEt) (z : V'.left),
      IsField (S.presheaf.stalk (V'.hom z)) → IsField (V'.left.presheaf.stalk z) := by
    intro S V' z hx
    haveI : WeaklyEtale V'.hom := V'.prop
    haveI := wc_fromSpecStalk_weaklyEtale V'.left z
    haveI := wc_fromSpecStalk_weaklyEtale S (V'.hom z)
    have hc : WeaklyEtale (V'.left.fromSpecStalk z ≫ V'.hom) := inferInstance
    haveI : WeaklyEtale (Spec.map (V'.hom.stalkMap z) ≫ S.fromSpecStalk (V'.hom z)) := by
      rw [Scheme.SpecMap_stalkMap_fromSpecStalk]
      exact hc
    haveI h1 : WeaklyEtale (Spec.map (V'.hom.stalkMap z)) :=
      WeaklyEtale.of_comp _ (S.fromSpecStalk (V'.hom z))
    have h2 := wc_lpkt_specMap_weaklyEtale_ring _ _ (V'.hom.stalkMap z).hom
      (by rw [CommRingCat.ofHom_hom]; exact h1)
    exact IsLocalRing.isField_iff_maximalIdeal_eq.mpr
      (@s1 _ _ _ _ _ (V'.hom.stalkMap z).hom.toAlgebra hx h2)

  have s4 : ∀ (S : Scheme.{u}) (V' : S.ProEt) (z : V'.left),
      IsField (V'.left.presheaf.stalk z) →
      ∃ (V'' : S.ProEt) (jP : V'' ⟶ V') (L : Type u) (_ : Field L) (_ : IsSepClosed L)
        (eL : V''.left ≅ Spec (.of L)), jP.left (eL.inv (IsLocalRing.closedPoint L)) = z := by
    intro S V' z hz
    haveI : WeaklyEtale V'.hom := V'.prop
    haveI := wc_fromSpecStalk_weaklyEtale V'.left z
    haveI hres : IsIso (V'.left.residue z) := by
      rw [ConcreteCategory.isIso_iff_bijective, Scheme.residue.eq_1]
      refine ⟨?_, IsLocalRing.residue_surjective⟩
      show Function.Injective (IsLocalRing.residue _)
      rw [RingHom.injective_iff_ker_eq_bot, IsLocalRing.ker_residue]
      exact IsLocalRing.isField_iff_maximalIdeal_eq.mp hz
    haveI : WeaklyEtale (V'.left.fromSpecResidueField z) := by
      rw [Scheme.fromSpecResidueField.eq_1]
      infer_instance
    haveI := wc_fpe_sepClosure_weaklyEtale (V'.left.residueField z)
    let jj : Spec (.of (SeparableClosure (V'.left.residueField z))) ⟶ V'.left :=
      Spec.map (CommRingCat.ofHom (algebraMap (V'.left.residueField z)
        (SeparableClosure (V'.left.residueField z)))) ≫ V'.left.fromSpecResidueField z
    haveI hjj : WeaklyEtale jj := by dsimp only [jj]; infer_instance
    have hW : WeaklyEtale (jj ≫ V'.hom) := inferInstance
    let V'' : S.ProEt := MorphismProperty.Over.mk ⊤ (jj ≫ V'.hom) hW
    let jP : V'' ⟶ V' := MorphismProperty.Over.homMk jj rfl trivial
    refine ⟨V'', jP, SeparableClosure (V'.left.residueField z), inferInstance,
      SeparableClosure.isSepClosed _, Iso.refl _, ?_⟩
    show (V'.left.fromSpecResidueField z)
      ((Spec.map (CommRingCat.ofHom (algebraMap (V'.left.residueField z)
        (SeparableClosure (V'.left.residueField z))))) (IsLocalRing.closedPoint _)) = z
    exact Scheme.fromSpecResidueField_apply z _

  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) :=
    MvPolynomial.gradedAlgebra
  have hprime : (⊥ : HomogeneousIdeal
      (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K)).toIdeal.IsPrime := by
    rw [HomogeneousIdeal.toIdeal_bot]
    exact Ideal.isPrime_bot
  have hirr : ¬ HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K)
      ≤ ⊥ := by
    intro h
    have hX0 := HomogeneousIdeal.mem_irrelevant_of_mem
      (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) (i := 1) Nat.one_pos
      ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr
        (MvPolynomial.isHomogeneous_X K (0 : Fin (1 + 1))))
    have h0 := h hX0
    rw [← HomogeneousIdeal.mem_iff, HomogeneousIdeal.toIdeal_bot, Ideal.mem_bot] at h0
    exact MvPolynomial.X_ne_zero (0 : Fin (1 + 1)) h0
  let η : ProjectiveSpectrum (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) :=
    ⟨⊥, hprime, hirr⟩
  have hspec : ∀ x : ProjectiveSpectrum (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K),
      η ⤳ x := by
    intro x
    apply specializes_iff_mem_closure.mpr
    apply (ProjectiveSpectrum.le_iff_mem_closure _ η x).mp
    apply (ProjectiveSpectrum.as_ideal_le_as_ideal _ η x).mp
    exact bot_le
  have hfη : IsField ((wcP1Over K).left.presheaf.stalk η) := by
    have e := AlgebraicGeometry.Proj.stalkIso
      (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) η
    have h𝔭 : η.asHomogeneousIdeal.toIdeal = ⊥ := HomogeneousIdeal.toIdeal_bot
    have hmax : IsLocalRing.maximalIdeal (Localization.AtPrime η.asHomogeneousIdeal.toIdeal) = ⊥ := by
      rw [← Localization.AtPrime.map_eq_maximalIdeal]
      refine eq_bot_iff.mpr (Ideal.map_le_iff_le_comap.mpr (fun x hx => ?_))
      rw [h𝔭, Ideal.mem_bot] at hx
      rw [Ideal.mem_comap, hx, map_zero]
      exact Ideal.zero_mem _
    have hH : IsField (HomogeneousLocalization.AtPrime
        (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) η.asHomogeneousIdeal.toIdeal) := by
      rw [IsLocalRing.isField_iff_maximalIdeal_eq, eq_bot_iff]
      intro f hf
      rw [Ideal.mem_bot]
      have hnu : ¬ IsUnit f := (IsLocalRing.mem_maximalIdeal f).mp hf
      rw [← HomogeneousLocalization.isUnit_iff_isUnit_val] at hnu
      have h1 : f.val ∈ IsLocalRing.maximalIdeal
          (Localization.AtPrime η.asHomogeneousIdeal.toIdeal) :=
        (IsLocalRing.mem_maximalIdeal _).mpr hnu
      rw [hmax, Ideal.mem_bot] at h1
      apply HomogeneousLocalization.val_injective
      rw [h1, HomogeneousLocalization.val_zero]
    exact MulEquiv.isField hH e.commRingCatIsoToRingEquiv.toMulEquiv

  have c : V₀.left := e₀.inv (IsLocalRing.closedPoint A₀)
  haveI : WeaklyEtale V₀.hom := V₀.prop
  haveI : Flat V₀.hom := inferInstance
  obtain ⟨p, -, hp⟩ := (Flat.generalizingMap V₀.hom) (hspec (V₀.hom c))
  have hP1 : IsField ((wcP1Over K).left.presheaf.stalk (V₀.hom p)) := by
    rw [hp]
    exact hfη
  have hB := s2 _ V₀ p hP1
  obtain ⟨V'', jP, L, hL, hLs, eL, -⟩ := s4 _ V₀ p hB
  have hsub : ∀ x y : V''.left, x = y := by
    intro x y
    have h1 : ∀ w : V''.left, eL.inv (eL.hom w) = w := fun w => by
      rw [← Scheme.Hom.comp_apply, Iso.hom_inv_id]; rfl
    rw [← h1 x, ← h1 y]
    congr 1
    exact Subsingleton.elim (α := PrimeSpectrum L) _ _
  refine ⟨V'', jP, L, hL, hLs, eL, fun z j hz => ?_⟩
  obtain ⟨t', -, ht'⟩ := (wc_P1_sections_closed_generize K m S hS).2 V'' z ⟨j, hz⟩
  rw [hsub t' z] at ht'
  exact ht' ⟨j, hz⟩

theorem wc_pencil_PL_lift_to_cover (K : Type u) [Field K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (m : ℕ) (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left))
    (W : (wcP1Over K).left.ProEt) (w : W ⟶ wcGeomPoint K (wcP1Over K) hP)
    (hcov : ∀ p : (wcGeomPoint K (wcP1Over K) hP).left,
      (∀ i : Fin m, (wcGeomPoint K (wcP1Over K) hP).hom p ≠ S i (IsLocalRing.closedPoint K)) →
      ∃ z : W.left, w.left z = p)
    (E : (wcP1Over K).left.ProEt) (L : Type u) [Field L] [IsSepClosed L]
    (eE : E.left ≅ Spec (.of L))
    (hE : ∀ (z : E.left) (j : Fin m), E.hom z ≠ S j (IsLocalRing.closedPoint K))
    (x : E ⟶ wcGeomPoint K (wcP1Over K) hP) :
    ∃ b : E ⟶ W, b ≫ w = x :=
by
  classical

  have hL : IsSepClosed (IsLocalRing.ResidueField L) := by
    have hinj : Function.Injective (IsLocalRing.residue L) := (IsLocalRing.residue L).injective
    let e : L ≃+* IsLocalRing.ResidueField L :=
      RingEquiv.ofBijective _ ⟨hinj, IsLocalRing.residue_surjective⟩
    apply IsSepClosed.of_exists_root
    intro p _ hirr hsep
    obtain ⟨y, hy⟩ := IsSepClosed.exists_root (p.map e.symm.toRingHom)
      (by rw [Polynomial.degree_map]; exact (Polynomial.degree_pos_of_irreducible hirr).ne')
      (hsep.map)
    refine ⟨e y, ?_⟩
    have h1 := hy.map (f := e.toRingHom)
    have hc : e.toRingHom.comp e.symm.toRingHom = RingHom.id _ := by
      ext z; simp
    rw [Polynomial.map_map, hc, Polynomial.map_id] at h1
    exact h1

  have hsec : ∀ (Q : Scheme.{u}) (π : Q ⟶ Spec (.of L)), WeaklyEtale π → ∀ (q : Q),
      ∃ s : Spec (.of L) ⟶ Q, s ≫ π = 𝟙 _ := by
    intro Q π hπ q
    haveI := wc_fromSpecStalk_weaklyEtale Q q
    obtain ⟨ψ, hψ⟩ : ∃ ψ : CommRingCat.of L ⟶ Q.presheaf.stalk q,
        Spec.map ψ = Q.fromSpecStalk q ≫ π := ⟨_, Spec.map_preimage _⟩
    have hW : WeaklyEtale (Spec.map (CommRingCat.ofHom ψ.hom)) := by
      have e : Spec.map (CommRingCat.ofHom ψ.hom) = Q.fromSpecStalk q ≫ π := hψ
      rw [e]; infer_instance
    have hA := wc_lpkt_specMap_weaklyEtale_ring L (Q.presheaf.stalk q) ψ.hom hW
    letI := ψ.hom.toAlgebra
    have hb := wc_olivier L (Q.presheaf.stalk q) inferInstance hL inferInstance hA
    haveI : IsIso ψ := (ConcreteCategory.isIso_iff_bijective _).mpr hb
    refine ⟨Spec.map (inv ψ) ≫ Q.fromSpecStalk q, ?_⟩
    rw [Category.assoc, ← hψ, ← Spec.map_comp, IsIso.hom_inv_id, Spec.map_id]

  haveI : WeaklyEtale (wcGeomPoint K (wcP1Over K) hP).hom :=
    (wcGeomPoint K (wcP1Over K) hP).prop
  haveI : WeaklyEtale W.hom := W.prop
  haveI : WeaklyEtale (w.left ≫ (wcGeomPoint K (wcP1Over K) hP).hom) := by
    rw [MorphismProperty.Over.w w]; infer_instance
  haveI : WeaklyEtale w.left := WeaklyEtale.of_comp w.left (wcGeomPoint K (wcP1Over K) hP).hom
  have hz : ∀ i : Fin m, (wcGeomPoint K (wcP1Over K) hP).hom
      (x.left (eE.inv (IsLocalRing.closedPoint L))) ≠ S i (IsLocalRing.closedPoint K) := by
    intro i
    rw [← Scheme.Hom.comp_apply, MorphismProperty.Over.w x]
    exact hE _ i
  obtain ⟨z', hz'⟩ := hcov _ hz
  obtain ⟨q, -, -⟩ := Scheme.Pullback.exists_preimage_pullback z' _ hz'
  obtain ⟨s, hs⟩ := hsec _ (Limits.pullback.snd w.left x.left ≫ eE.hom) inferInstance q
  have hs' : s ≫ Limits.pullback.snd w.left x.left = eE.inv := by
    have h1 := congrArg (fun t => t ≫ eE.inv) hs
    simpa using h1
  have hbl : (eE.hom ≫ s ≫ Limits.pullback.fst w.left x.left) ≫ w.left = x.left := by
    rw [Category.assoc, Category.assoc, Limits.pullback.condition, ← Category.assoc s, hs',
      Iso.hom_inv_id_assoc]
  refine ⟨MorphismProperty.Over.homMk (eE.hom ≫ s ≫ Limits.pullback.fst w.left x.left) ?_ trivial,
    ?_⟩
  · have h2 := congrArg (fun t => t ≫ (wcGeomPoint K (wcP1Over K) hP).hom) hbl
    simp only [Category.assoc, MorphismProperty.Over.w w, MorphismProperty.Over.w x] at h2
    simpa only [Category.assoc] using h2
  · apply MorphismProperty.Over.Hom.ext
    exact hbl

theorem wc_free_ext0_eval (S : Scheme.{u}) :
    ∃ ev : ∀ (V : S.ProEt) (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}),
        Abelian.Ext (wcFreeSheaf S V) G 0 ≃+ G.obj.obj (Opposite.op V),
      (∀ (V : S.ProEt) (G H : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (g : G ⟶ H)
          (y : Abelian.Ext (wcFreeSheaf S V) G 0),
        ev V H ((Abelian.Ext.mk₀ g).postcomp (wcFreeSheaf S V) (add_zero 0) y) =
          (g.hom.app (Opposite.op V)).hom (ev V G y)) ∧
      (∀ (V V' : S.ProEt) (a : V' ⟶ V) (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
          (y : Abelian.Ext (wcFreeSheaf S V) G 0),
        ev V' G ((Abelian.Ext.mk₀ (wcFreeSheafMap S a)).precomp G (zero_add 0) y) =
          (G.obj.map a.op).hom (ev V G y)) :=
by
  classical

  have Y : ∃ η : ∀ T : S.ProEt, (wcFreeSheaf S T).obj.obj (Opposite.op T),
      (∀ (T : S.ProEt) (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
          (s : G.obj.obj (Opposite.op T)),
        ∃! g : wcFreeSheaf S T ⟶ G, (g.hom.app (Opposite.op T)).hom (η T) = s) ∧
      ∀ (T T' : S.ProEt) (c : T' ⟶ T),
        ((wcFreeSheafMap S c).hom.app (Opposite.op T')).hom (η T') =
          ((wcFreeSheaf S T).obj.map c.op).hom (η T) := by
    let J := Scheme.ProEt.topology S
    let η : ∀ T : S.ProEt, (wcFreeSheaf S T).obj.obj (Opposite.op T) :=
      fun T => ((toSheafify J (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app
        (Opposite.op T)).hom (FreeAbelianGroup.of (ULift.up (𝟙 T)))
    let e : ∀ (T : S.ProEt) (G : Sheaf J AddCommGrpCat.{u+1}),
        (wcFreeSheaf S T ⟶ G) ≃ G.obj.obj (Opposite.op T) := fun T G =>
      ((sheafificationAdjunction J AddCommGrpCat.{u+1}).homEquiv
          (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) G).trans
        (((Adjunction.whiskerRight (S.ProEt)ᵒᵖ AddCommGrpCat.adj.{u+1}).homEquiv
            (yoneda.obj T ⋙ uliftFunctor.{u+1, u}) G.obj).trans
          (uliftYonedaEquiv.{u+1} (X := T) (F := G.obj ⋙ forget AddCommGrpCat.{u+1})))
    have he : ∀ (T : S.ProEt) (G : Sheaf J AddCommGrpCat.{u+1}) (g : wcFreeSheaf S T ⟶ G),
        e T G g = (g.hom.app (Opposite.op T)).hom (η T) := fun _ _ _ => rfl
    refine ⟨η, fun T G s => ⟨(e T G).symm s, ?_, fun g hg => (e T G).injective ?_⟩, fun T T' c => ?_⟩
    · exact (he T G _).symm.trans (Equiv.apply_symm_apply _ _)
    · exact (he T G g).trans (hg.trans (Equiv.apply_symm_apply _ _).symm)
    · let P := yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free
      let P' := yoneda.obj T' ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free
      let w : P' ⟶ P := Functor.whiskerRight (yoneda.map c) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)
      let x' : P'.obj (Opposite.op T') := FreeAbelianGroup.of (ULift.up (𝟙 T'))
      let x : P.obj (Opposite.op T) := FreeAbelianGroup.of (ULift.up (𝟙 T))
      have h1 : ((sheafifyMap J w).app (Opposite.op T')).hom (((toSheafify J P').app
          (Opposite.op T')).hom x') = ((toSheafify J P).app (Opposite.op T')).hom
            ((w.app (Opposite.op T')).hom x') :=
        (ConcreteCategory.congr_hom
          (congrArg (fun φ => φ.app (Opposite.op T')) (toSheafify_naturality J w)) x').symm
      have h2 : (w.app (Opposite.op T')).hom x' = (P.map c.op).hom x := by
        change FreeAbelianGroup.map _ (FreeAbelianGroup.of _) =
          FreeAbelianGroup.map _ (FreeAbelianGroup.of _)
        refine (FreeAbelianGroup.map_of_apply _).trans
          (Eq.trans ?_ (FreeAbelianGroup.map_of_apply _).symm)
        congr 1
      have hn : ((toSheafify J P).app (Opposite.op T')).hom ((P.map c.op).hom x) =
          ((sheafify J P).map c.op).hom (((toSheafify J P).app (Opposite.op T)).hom x) :=
        NatTrans.naturality_apply (toSheafify J P) c.op x
      change ((sheafifyMap J w).app (Opposite.op T')).hom (((toSheafify J P').app
          (Opposite.op T')).hom x') =
        ((sheafify J P).map c.op).hom (((toSheafify J P).app (Opposite.op T)).hom x)
      rw [h1, h2, hn]
  obtain ⟨η, hη₁, hη₂⟩ := Y

  let E : ∀ (V : S.ProEt) (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}),
      (wcFreeSheaf S V ⟶ G) →+ G.obj.obj (Opposite.op V) :=
    fun V G => AddMonoidHom.mk' (fun φ => (φ.hom.app (Opposite.op V)).hom (η V))
      (fun φ ψ => by simp only [Sheaf.Hom.add_app, AddCommGrpCat.hom_add_apply])
  have hE : ∀ V G, Function.Bijective (E V G) := by
    intro V G
    refine ⟨fun φ ψ h => ?_, fun s => ?_⟩
    · exact (hη₁ V G (E V G φ)).unique rfl h.symm
    · obtain ⟨g, hg, _⟩ := hη₁ V G s
      exact ⟨g, hg⟩
  let ev : ∀ (V : S.ProEt) (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}),
      Abelian.Ext (wcFreeSheaf S V) G 0 ≃+ G.obj.obj (Opposite.op V) :=
    fun V G => Abelian.Ext.addEquiv₀.trans (AddEquiv.ofBijective (E V G) (hE V G))
  have hev : ∀ (V : S.ProEt) (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
      (f : wcFreeSheaf S V ⟶ G),
      ev V G (Abelian.Ext.mk₀ f) = (f.hom.app (Opposite.op V)).hom (η V) := by
    intro V G f
    have h1 : Abelian.Ext.addEquiv₀ (Abelian.Ext.mk₀ f) = f := by
      rw [← Abelian.Ext.addEquiv₀_symm_apply, AddEquiv.apply_symm_apply]
    show E V G (Abelian.Ext.addEquiv₀ (Abelian.Ext.mk₀ f)) = _
    rw [h1]
    rfl
  refine ⟨ev, ?_, ?_⟩
  · intro V G H g y
    obtain ⟨φ, rfl⟩ := (Abelian.Ext.mk₀_bijective _ _).2 y
    show ev V H ((Abelian.Ext.mk₀ φ).comp (Abelian.Ext.mk₀ g) (add_zero 0)) = _
    rw [Abelian.Ext.mk₀_comp_mk₀, hev, hev]
    rfl
  · intro V V' a G y
    obtain ⟨φ, rfl⟩ := (Abelian.Ext.mk₀_bijective _ _).2 y
    show ev V' G ((Abelian.Ext.mk₀ (wcFreeSheafMap S a)).comp (Abelian.Ext.mk₀ φ) (zero_add 0)) = _
    rw [Abelian.Ext.mk₀_comp_mk₀, hev, hev]
    have h1 : ((wcFreeSheafMap S a ≫ φ).hom.app (Opposite.op V')).hom (η V') =
        (φ.hom.app (Opposite.op V')).hom
          (((wcFreeSheafMap S a).hom.app (Opposite.op V')).hom (η V')) := rfl
    rw [h1, hη₂ V V' a]
    exact NatTrans.naturality_apply φ.hom a.op (η V)

theorem ext_rightDerived_adj_edge {C D : Type*} [Category C] [Category D]
    [Abelian C] [Abelian D] [HasExt C] [HasExt D] [HasInjectiveResolutions C]
    (L : D ⥤ C) (R : C ⥤ D) [R.Additive] (adj : L ⊣ R) (A : C) (n : ℕ) :
    ∃ ed : ∀ P : D, Abelian.Ext (L.obj P) A n →+ Abelian.Ext P ((R.rightDerived n).obj A) 0,
      (∀ (P : D) [Projective P], Function.Bijective (ed P)) ∧
      (∀ {P P' : D} (τ : P ⟶ P') (z : Abelian.Ext (L.obj P') A n),
        ed P ((Abelian.Ext.mk₀ (L.map τ)).comp z (zero_add n)) =
          (Abelian.Ext.mk₀ τ).comp (ed P' z) (zero_add 0)) ∧
      (∀ (P : D) (σ : A ⟶ A) (z : Abelian.Ext (L.obj P) A n),
        ed P (z.comp (Abelian.Ext.mk₀ σ) (add_zero n)) =
          (ed P z).comp (Abelian.Ext.mk₀ ((R.rightDerived n).map σ)) (add_zero 0)) :=
by
  classical
  haveI : L.Additive := adj.left_adjoint_additive
  obtain ⟨I⟩ : Nonempty (InjectiveResolution A) := ⟨injectiveResolution A⟩
  let K : CochainComplex D ℕ := (R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex
  let ι : (R.rightDerived n).obj A ≅ K.homology n := I.isoRightDerivedObj R n

  have esymm_zero : ∀ (P : D) (k : ℕ), (adj.homEquiv P (I.cocomplex.X k)).symm 0 = 0 :=
    fun P k => by rw [← adj.homAddEquiv_symm_apply, map_zero]
  have e_zero : ∀ (P : D) (k : ℕ), (adj.homEquiv P (I.cocomplex.X k)) 0 = 0 := fun P k => by
    rw [← esymm_zero P k, Equiv.apply_symm_apply]
  have esymm_add : ∀ (P : D) (k : ℕ) (a b : P ⟶ R.obj (I.cocomplex.X k)),
      (adj.homEquiv P (I.cocomplex.X k)).symm (a + b) =
        (adj.homEquiv P (I.cocomplex.X k)).symm a + (adj.homEquiv P (I.cocomplex.X k)).symm b := by
    intro P k a b
    simp only [← adj.homAddEquiv_symm_apply, map_add]
  have hfk : ∀ (P : D) (k : P ⟶ R.obj (I.cocomplex.X n)),
      k ≫ R.map (I.cocomplex.d n (n + 1)) = 0 →
      (adj.homEquiv P (I.cocomplex.X n)).symm k ≫ I.cocomplex.d n (n + 1) = 0 := by
    intro P k hk
    rw [← adj.homEquiv_naturality_right_symm, hk, esymm_zero]
  have extMk_congr : ∀ (P : D) (f f' : L.obj P ⟶ I.cocomplex.X n) (h : f = f')
      (hf : f ≫ I.cocomplex.d n (n + 1) = 0) (hf' : f' ≫ I.cocomplex.d n (n + 1) = 0),
      I.extMk f (n + 1) rfl hf = I.extMk f' (n + 1) rfl hf' := by
    intro P f f' h hf hf'
    subst h
    rfl
  have extMk_add : ∀ (P : D) (f g : L.obj P ⟶ I.cocomplex.X n)
      (hf : f ≫ I.cocomplex.d n (n + 1) = 0)
      (hg : g ≫ I.cocomplex.d n (n + 1) = 0) (hfg : (f + g) ≫ I.cocomplex.d n (n + 1) = 0),
      I.extMk (f + g) (n + 1) rfl hfg = I.extMk f (n + 1) rfl hf + I.extMk g (n + 1) rfl hg := by
    intro P f g hf hg hfg
    apply I.extEquivCohomologyClass.injective
    rw [InjectiveResolution.extEquivCohomologyClass_add,
      InjectiveResolution.extEquivCohomologyClass_extMk,
      InjectiveResolution.extEquivCohomologyClass_extMk,
      InjectiveResolution.extEquivCohomologyClass_extMk,
      ← CochainComplex.HomComplex.CohomologyClass.mk_add,
      ← CochainComplex.HomComplex.Cocycle.fromSingleMk_add]
    congr 1
    simp only [Preadditive.add_comp]

  let Z : ∀ P : D, AddSubgroup (P ⟶ R.obj (I.cocomplex.X n)) := fun P =>
    { carrier := {k | k ≫ R.map (I.cocomplex.d n (n + 1)) = 0}
      add_mem' := fun {a b} ha hb => by
        simp only [Set.mem_setOf_eq] at ha hb ⊢
        rw [Preadditive.add_comp, ha, hb, add_zero]
      zero_mem' := by simp
      neg_mem' := fun {a} ha => by
        simp only [Set.mem_setOf_eq] at ha ⊢
        rw [Preadditive.neg_comp, ha, neg_zero] }
  have hZ : ∀ (P : D) (z : Z P), z.1 ≫ K.d n (n + 1) = 0 := fun P z => z.2
  have hZ' : ∀ (P : D) (z : Z P), z.1 ≫ R.map (I.cocomplex.d n (n + 1)) = 0 := fun P z => z.2
  have liftAdd : ∀ (P : D) (k k' : P ⟶ K.X n) (hk : k ≫ K.d n (n + 1) = 0)
      (hk' : k' ≫ K.d n (n + 1) = 0) (hkk : (k + k') ≫ K.d n (n + 1) = 0),
      K.liftCycles (k + k') (n + 1) (CochainComplex.next ℕ n) hkk =
        K.liftCycles k (n + 1) (CochainComplex.next ℕ n) hk +
          K.liftCycles k' (n + 1) (CochainComplex.next ℕ n) hk' := by
    intro P k k' hk hk' hkk
    rw [← cancel_mono (K.iCycles n)]
    simp [Preadditive.add_comp]
  let α : ∀ P : D, Z P →+ (P ⟶ (R.rightDerived n).obj A) := fun P =>
    AddMonoidHom.mk' (fun z =>
      K.liftCycles z.1 (n + 1) (CochainComplex.next ℕ n) (hZ P z) ≫ K.homologyπ n ≫ ι.inv) (by
      intro a b
      rw [← Preadditive.add_comp]
      congr 1
      exact liftAdd P _ _ (hZ P a) (hZ P b) _)
  let β : ∀ P : D, Z P →+ Abelian.Ext (L.obj P) A n := fun P =>
    AddMonoidHom.mk' (fun z =>
      I.extMk ((adj.homEquiv P (I.cocomplex.X n)).symm z.1) (n + 1) rfl (hfk P z.1 z.2)) (by
      intro a b
      rw [← extMk_add P _ _ (hfk P a.1 a.2) (hfk P b.1 b.2)]
      · exact extMk_congr P _ _ (by rw [AddSubgroup.coe_add, esymm_add]) _ _
      · rw [← esymm_add]; exact hfk P _ (a + b).2)
  have hβ : ∀ (P : D) (z : Z P), β P z =
      I.extMk ((adj.homEquiv P (I.cocomplex.X n)).symm z.1) (n + 1) rfl (hfk P z.1 z.2) :=
    fun P z => rfl

  have hβs : ∀ P : D, Function.Surjective (β P) := by
    intro P x
    obtain ⟨f, hf, rfl⟩ := I.extMk_surjective x (n + 1) rfl
    have hk : (adj.homEquiv P (I.cocomplex.X n)) f ≫ R.map (I.cocomplex.d n (n + 1)) = 0 := by
      rw [← adj.homEquiv_naturality_right, hf, e_zero]
    refine ⟨⟨_, hk⟩, ?_⟩
    exact extMk_congr P _ _ (Equiv.symm_apply_apply _ _) (hfk P _ hk) hf

  have extMk_zero_iff : ∀ (P : D) (m : ℕ) (f : L.obj P ⟶ I.cocomplex.X m)
      (hf : f ≫ I.cocomplex.d m (m + 1) = 0),
      I.extMk f (m + 1) rfl hf = 0 ↔
        ∃ g' : L.obj P ⟶ I.cocomplex.X ((ComplexShape.up ℕ).prev m),
          g' ≫ I.cocomplex.d ((ComplexShape.up ℕ).prev m) m = f := by
    intro P m
    cases m with
    | zero =>
      intro f hf
      rw [CochainComplex.prev_nat_zero]
      have hd : I.cocomplex.d 0 0 = 0 := I.cocomplex.shape 0 0 (by simp)
      simp only [hd, Limits.comp_zero]
      constructor
      · intro hx
        have hx' := congrArg I.extEquivCohomologyClass hx
        rw [InjectiveResolution.extEquivCohomologyClass_extMk,
          InjectiveResolution.extEquivCohomologyClass_zero,
          CochainComplex.HomComplex.CohomologyClass.mk_eq_zero_iff,
          CochainComplex.HomComplex.Cocycle.fromSingleMk_mem_coboundaries_iff _ _ _ _ _ (-1)
            (by simp)] at hx'
        obtain ⟨g, hg⟩ := hx'
        have hz : Limits.IsZero (I.cochainComplex.X (-1)) :=
          HomologicalComplex.isZero_extend_X I.cocomplex ComplexShape.embeddingUpNat (-1)
            (fun i => by rw [ComplexShape.embeddingUpNat_f]; omega)
        rw [hz.eq_of_tgt g 0, Limits.zero_comp] at hg
        have hf0 : f = 0 := by
          rw [← cancel_mono (I.cochainComplexXIso (↑(0 : ℕ)) 0 rfl).inv, Limits.zero_comp]
          exact hg.symm
        exact ⟨0, hf0.symm⟩
      · rintro ⟨g', hg'⟩
        subst hg'
        exact I.extMk_zero 1 rfl
    | succ p =>
      intro f hf
      rw [CochainComplex.prev_nat_succ]
      exact I.extMk_eq_zero_iff f _ rfl hf p rfl

  have βker : ∀ (P : D) (z : Z P), β P z = 0 ↔
      ∃ g : P ⟶ R.obj (I.cocomplex.X ((ComplexShape.up ℕ).prev n)),
        g ≫ R.map (I.cocomplex.d ((ComplexShape.up ℕ).prev n) n) = z.1 := by
    intro P z
    show I.extMk ((adj.homEquiv P (I.cocomplex.X n)).symm z.1) (n + 1) rfl (hfk P z.1 z.2) = 0 ↔ _
    rw [extMk_zero_iff]
    constructor
    · rintro ⟨g', hg'⟩
      refine ⟨adj.homEquiv _ _ g', ?_⟩
      rw [← adj.homEquiv_naturality_right, hg', Equiv.apply_symm_apply]
    · rintro ⟨g, hg⟩
      refine ⟨(adj.homEquiv _ _).symm g, ?_⟩
      rw [← adj.homEquiv_naturality_right_symm, hg]

  have hle : ∀ P : D, (β P).ker ≤ (α P).ker := by
    intro P z hz
    rw [AddMonoidHom.mem_ker] at hz ⊢
    obtain ⟨g, hg⟩ := (βker P z).1 hz
    show K.liftCycles z.1 (n + 1) (CochainComplex.next ℕ n) (hZ P z) ≫ K.homologyπ n ≫ ι.inv = 0
    rw [← Category.assoc,
      K.liftCycles_homologyπ_eq_zero_of_boundary z.1 (n + 1) (CochainComplex.next ℕ n) g hg.symm,
      Limits.zero_comp]

  let ed : ∀ P : D, Abelian.Ext (L.obj P) A n →+ Abelian.Ext P ((R.rightDerived n).obj A) 0 :=
    fun P =>
      (Abelian.Ext.addEquiv₀.symm :
          (P ⟶ (R.rightDerived n).obj A) ≃+ Abelian.Ext P ((R.rightDerived n).obj A) 0).toAddMonoidHom.comp
        ((QuotientAddGroup.lift (β P).ker (α P) (hle P)).comp
          (QuotientAddGroup.quotientKerEquivOfSurjective (β P) (hβs P)).symm.toAddMonoidHom)
  have hed : ∀ (P : D) (z : Z P), ed P (β P z) = Abelian.Ext.mk₀ (α P z) := by
    intro P z
    have h1 : (QuotientAddGroup.quotientKerEquivOfSurjective (β P) (hβs P)).symm (β P z) =
        (z : Z P ⧸ (β P).ker) := by
      rw [AddEquiv.symm_apply_eq]
      rfl
    show Abelian.Ext.addEquiv₀.symm (QuotientAddGroup.lift (β P).ker (α P) (hle P)
      ((QuotientAddGroup.quotientKerEquivOfSurjective (β P) (hβs P)).symm (β P z))) = _
    rw [h1, QuotientAddGroup.lift_mk, Abelian.Ext.addEquiv₀_symm_apply]
  have hmk : ∀ (P : D) (y : Abelian.Ext P ((R.rightDerived n).obj A) 0),
      ∃ h, Abelian.Ext.mk₀ h = y :=
    fun P y => ⟨Abelian.Ext.addEquiv₀ y, by
      rw [← Abelian.Ext.addEquiv₀_symm_apply, AddEquiv.symm_apply_apply]⟩
  refine ⟨ed, ?_, ?_, ?_⟩
  ·
    intro P _
    have hαs : Function.Surjective (α P) := by
      intro h
      let h' : P ⟶ K.cycles n := Projective.factorThru (h ≫ ι.hom) (K.homologyπ n)
      have hk : (h' ≫ K.iCycles n) ≫ R.map (I.cocomplex.d n (n + 1)) = 0 := by
        rw [Category.assoc]
        erw [HomologicalComplex.iCycles_d]
        rw [Limits.comp_zero]
      refine ⟨⟨h' ≫ K.iCycles n, hk⟩, ?_⟩
      have hl : K.liftCycles (h' ≫ K.iCycles n) (n + 1) (CochainComplex.next ℕ n) hk = h' := by
        rw [← cancel_mono (K.iCycles n)]
        simp
      show K.liftCycles (h' ≫ K.iCycles n) (n + 1) (CochainComplex.next ℕ n) hk ≫
        K.homologyπ n ≫ ι.inv = h
      rw [hl, ← Category.assoc, Projective.factorThru_comp, Category.assoc, Iso.hom_inv_id,
        Category.comp_id]
    have αker : ∀ z : Z P, α P z = 0 →
        ∃ g : P ⟶ R.obj (I.cocomplex.X ((ComplexShape.up ℕ).prev n)),
          g ≫ R.map (I.cocomplex.d ((ComplexShape.up ℕ).prev n) n) = z.1 := by
      intro z hz
      have h0 : K.liftCycles z.1 (n + 1) (CochainComplex.next ℕ n) (hZ P z) ≫ K.homologyπ n = 0 := by
        have hz' : (K.liftCycles z.1 (n + 1) (CochainComplex.next ℕ n) (hZ P z) ≫
            K.homologyπ n ≫ ι.inv) = 0 := hz
        rw [← Category.assoc] at hz'
        have := congrArg (· ≫ ι.hom) hz'
        simpa using this
      let S := ShortComplex.mk (K.toCycles ((ComplexShape.up ℕ).prev n) n) (K.homologyπ n)
        (K.toCycles_comp_homologyπ _ n)
      have hS : S.Exact := S.exact_of_g_is_cokernel (K.homologyIsCokernel _ n rfl)
      refine ⟨hS.liftFromProjective
        (K.liftCycles z.1 (n + 1) (CochainComplex.next ℕ n) (hZ P z)) h0, ?_⟩
      have h2 := hS.liftFromProjective_comp
        (K.liftCycles z.1 (n + 1) (CochainComplex.next ℕ n) (hZ P z)) h0
      have h3 := congrArg (· ≫ K.iCycles n) h2
      simp only [S, Category.assoc, HomologicalComplex.toCycles_i,
        HomologicalComplex.liftCycles_i] at h3
      exact h3
    constructor
    · rw [injective_iff_map_eq_zero]
      intro x hx
      obtain ⟨z, rfl⟩ := hβs P x
      rw [hed] at hx
      have h0 : α P z = 0 := by
        have := congrArg Abelian.Ext.addEquiv₀ hx
        rwa [← Abelian.Ext.addEquiv₀_symm_apply, AddEquiv.apply_symm_apply, map_zero] at this
      exact (βker P z).2 (αker z h0)
    · intro y
      obtain ⟨h, rfl⟩ := hmk P y
      obtain ⟨z, rfl⟩ := hαs h
      exact ⟨β P z, hed P z⟩
  ·
    intro P P' τ z
    obtain ⟨w, rfl⟩ := hβs P' z
    let w' : Z P := ⟨τ ≫ w.1, by
      show (τ ≫ w.1) ≫ R.map (I.cocomplex.d n (n + 1)) = 0
      rw [Category.assoc, hZ' P' w, Limits.comp_zero]⟩
    have hαw' : α P w' = τ ≫ α P' w := by
      show K.liftCycles (τ ≫ w.1) (n + 1) (CochainComplex.next ℕ n) (hZ P w') ≫
          K.homologyπ n ≫ ι.inv =
        τ ≫ K.liftCycles w.1 (n + 1) (CochainComplex.next ℕ n) (hZ P' w) ≫ K.homologyπ n ≫ ι.inv
      rw [← Category.assoc τ, HomologicalComplex.comp_liftCycles]
    have hβw' : β P w' = (Abelian.Ext.mk₀ (L.map τ)).comp (β P' w) (zero_add n) := by
      rw [hβ, hβ, InjectiveResolution.mk₀_comp_extMk]
      exact extMk_congr P _ _ (adj.homEquiv_naturality_left_symm _ _) _ _
    rw [← hβw', hed, hed, hαw', Abelian.Ext.mk₀_comp_mk₀]
  ·
    intro P σ z
    obtain ⟨w, rfl⟩ := hβs P z
    let φ := InjectiveResolution.desc σ I I
    have hφ0 : I.ι.f 0 ≫ φ.f 0 = σ ≫ I.ι.f 0 := InjectiveResolution.desc_commutes_zero σ I I
    have hw' : (w.1 ≫ R.map (φ.f n)) ≫ R.map (I.cocomplex.d n (n + 1)) = 0 := by
      rw [Category.assoc, ← R.map_comp, φ.comm, R.map_comp, ← Category.assoc, hZ' P w,
        Limits.zero_comp]
    let w' : Z P := ⟨w.1 ≫ R.map (φ.f n), hw'⟩
    have key : ι.inv ≫ (R.rightDerived n).map σ =
        HomologicalComplex.homologyMap ((R.mapHomologicalComplex _).map φ) n ≫ ι.inv :=
      InjectiveResolution.isoRightDerivedObj_inv_naturality σ I I φ hφ0 R n
    have hαw' : α P w' = α P w ≫ (R.rightDerived n).map σ := by
      show K.liftCycles (w.1 ≫ R.map (φ.f n)) (n + 1) (CochainComplex.next ℕ n) (hZ P w') ≫
          K.homologyπ n ≫ ι.inv =
        (K.liftCycles w.1 (n + 1) (CochainComplex.next ℕ n) (hZ P w) ≫ K.homologyπ n ≫ ι.inv) ≫
          (R.rightDerived n).map σ
      have e := HomologicalComplex.liftCycles_comp_cyclesMap (K := K) w.1 (n + 1)
        (CochainComplex.next ℕ n) (hZ P w) ((R.mapHomologicalComplex _).map φ)
      rw [Category.assoc, Category.assoc, key, ← Category.assoc (K.homologyπ n),
        HomologicalComplex.homologyπ_naturality, Category.assoc, reassoc_of% e]
      rfl
    let φh : I.Hom I σ := ⟨φ, by rw [CochainComplex.single₀_map_f_zero]; exact hφ0⟩
    have hβw' : β P w' = (β P w).comp (Abelian.Ext.mk₀ σ) (add_zero n) := by
      rw [hβ, hβ, InjectiveResolution.extMk_comp_mk₀ _ _ _ _ φh]
      exact extMk_congr P _ _ (adj.homEquiv_naturality_right_symm _ _) _ _
    rw [← hβw', hed, hed, hαw', Abelian.Ext.mk₀_comp_mk₀]

theorem wc_proet_ladic_free_ext_module_natural (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] :
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
    ∃ (P : S.ProEt → SheafOfModules.{u+1} (wcRingSheaf S ℓ))
      (Pm : ∀ (W W' : S.ProEt), (W' ⟶ W) → (P W' ⟶ P W))
      (ev : ∀ (W : S.ProEt) (M : SheafOfModules.{u+1} (wcRingSheaf S ℓ)),
        (P W ⟶ M) ≃ M.val.obj (Opposite.op W))
      (T : ∀ (q : ℕ) (W : S.ProEt), Abelian.Ext (wcFreeSheaf S W) (wcLadicSheaf S ℓ) q ≃+
        Abelian.Ext (P W) (SheafOfModules.unit (wcRingSheaf S ℓ)) q),
      (∀ (W : S.ProEt) (M N : SheafOfModules.{u+1} (wcRingSheaf S ℓ)) (ψ : M ⟶ N) (g : P W ⟶ M),
        ev W N (g ≫ ψ) = (ψ.val.app (Opposite.op W)).hom (ev W M g)) ∧
      (∀ (W W' : S.ProEt) (b : W' ⟶ W) (M : SheafOfModules.{u+1} (wcRingSheaf S ℓ)) (g : P W ⟶ M),
        ev W' M (Pm W W' b ≫ g) = (M.val.map b.op).hom (ev W M g)) ∧
      (∀ (q : ℕ) (W : S.ProEt) (c : ℚ_[ℓ]) (e : Abelian.Ext (wcFreeSheaf S W) (wcLadicSheaf S ℓ) q),
        T q W (e.comp (Abelian.Ext.mk₀ (wcLadicScalar S ℓ c)) (add_zero q)) =
          (T q W e).comp (Abelian.Ext.mk₀ (wcHMConst S ℓ c)) (add_zero q)) ∧
      (∀ (q : ℕ) (W W' : S.ProEt) (b : W' ⟶ W)
          (e : Abelian.Ext (wcFreeSheaf S W) (wcLadicSheaf S ℓ) q),
        T q W' ((Abelian.Ext.mk₀ (wcFreeSheafMap S b)).comp e (zero_add q)) =
          (Abelian.Ext.mk₀ (Pm W W' b)).comp (T q W e) (zero_add q)) :=
by
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
  classical

  haveI hGC := sheafOfModules_toSheaf_preservesFiniteColimits (Scheme.ProEt.topology S)
    (wcRingSheaf S ℓ)
  have hunit : ∀ (V : (S.ProEt)ᵒᵖ) (k : ℕ), k ≠ 0 →
      IsUnit (k : ↑((wcRingSheaf S ℓ).obj.obj V)) := by
    intro V k hk
    have hk' : (k : ℚ_[ℓ]) ≠ 0 := Nat.cast_ne_zero.mpr hk
    change IsUnit (k : C(↥((Opposite.unop V).left), ULift.{u+1} ℚ_[ℓ]))
    refine isUnit_iff_exists_inv.mpr ⟨ContinuousMap.const _ (ULift.up ((k : ℚ_[ℓ])⁻¹)), ?_⟩
    refine ContinuousMap.ext fun t => ULift.ext _ _ ?_
    simp [hk']
  obtain ⟨L, adj, hLA, hLL, hLC⟩ := sheafOfModules_toSheaf_exact_left_adjoint
    (Scheme.ProEt.topology S) (wcRingSheaf S ℓ) hunit
  haveI := hLA
  haveI := hLL
  haveI := hLC

  obtain ⟨η, hη1, hη2⟩ := wc_proet_free_sheaf_yoneda S
  have hevY : ∀ (W : S.ProEt) (F : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}),
      Function.Bijective (fun h : wcFreeSheaf S W ⟶ F => (h.hom.app (Opposite.op W)).hom (η W)) := by
    intro W F
    refine ⟨fun h₁ h₂ hh => ?_, fun s => ?_⟩
    · obtain ⟨g, -, hg⟩ := hη1 W F ((h₁.hom.app (Opposite.op W)).hom (η W))
      exact (hg h₁ rfl).trans (hg h₂ hh.symm).symm
    · obtain ⟨g, hg, -⟩ := hη1 W F s
      exact ⟨g, hg⟩
  obtain ⟨ev, hev⟩ : ∃ ev : ∀ (W : S.ProEt) (M : SheafOfModules.{u+1} (wcRingSheaf S ℓ)),
      (L.obj (wcFreeSheaf S W) ⟶ M) ≃ M.val.obj (Opposite.op W),
      ∀ (W : S.ProEt) (M : SheafOfModules.{u+1} (wcRingSheaf S ℓ)) (g : L.obj (wcFreeSheaf S W) ⟶ M),
        ev W M g = (((adj.homEquiv (wcFreeSheaf S W) M) g).hom.app (Opposite.op W)).hom (η W) :=
    ⟨fun W M => (adj.homEquiv (wcFreeSheaf S W) M).trans
      (Equiv.ofBijective _ (hevY W ((SheafOfModules.toSheaf.{u+1} (wcRingSheaf S ℓ)).obj M))),
      fun _ _ _ => rfl⟩
  have hnat : ∀ (W : S.ProEt) (M N : SheafOfModules.{u+1} (wcRingSheaf S ℓ)) (ψ : M ⟶ N)
      (g : L.obj (wcFreeSheaf S W) ⟶ M),
      ev W N (g ≫ ψ) = (ψ.val.app (Opposite.op W)).hom (ev W M g) := by
    intro W M N ψ g
    rw [hev, hev, Adjunction.homEquiv_naturality_right]
    rfl
  have hpre : ∀ (W W' : S.ProEt) (b : W' ⟶ W) (M : SheafOfModules.{u+1} (wcRingSheaf S ℓ))
      (g : L.obj (wcFreeSheaf S W) ⟶ M),
      ev W' M (L.map (wcFreeSheafMap S b) ≫ g) = (M.val.map b.op).hom (ev W M g) := by
    intro W W' b M g
    rw [hev, hev, Adjunction.homEquiv_naturality_left]
    have h1 := hη2 W W' b
    have h2 := congrArg (fun φ => AddCommGrpCat.Hom.hom φ (η W))
      ((adj.homEquiv (wcFreeSheaf S W) M g).hom.naturality b.op)
    change ((adj.homEquiv (wcFreeSheaf S W) M g).hom.app (Opposite.op W')).hom
      (((wcFreeSheafMap S b).hom.app (Opposite.op W')).hom (η W')) = _
    rw [h1]
    exact h2

  let G1 := (SheafOfModules.toSheaf.{u+1} (wcRingSheaf S ℓ)).obj
    (SheafOfModules.unit (wcRingSheaf S ℓ))
  let eV : ∀ V : (S.ProEt)ᵒᵖ, G1.obj.obj V ≅ (wcLadicSheaf S ℓ).obj.obj V := fun V =>
    { hom := AddCommGrpCat.ofHom
        { toFun := fun r => (ULift.up ((ContinuousMap.mk ULift.down continuous_uliftDown).comp
              (r : C(↥V.unop.left, ULift.{u+1} ℚ_[ℓ]))) :
              ULift.{u+1} C(↥V.unop.left, ℚ_[ℓ]))
          map_zero' := ULift.ext _ _ (ContinuousMap.ext fun _ => rfl)
          map_add' := fun _ _ => ULift.ext _ _ (ContinuousMap.ext fun _ => rfl) }
      inv := AddCommGrpCat.ofHom
        { toFun := fun w => ((ContinuousMap.mk ULift.up continuous_uliftUp).comp
              (w.down : C(↥V.unop.left, ℚ_[ℓ])) : C(↥V.unop.left, ULift.{u+1} ℚ_[ℓ]))
          map_zero' := ContinuousMap.ext fun _ => rfl
          map_add' := fun _ _ => ContinuousMap.ext fun _ => rfl }
      hom_inv_id := by
        apply AddCommGrpCat.ext
        intro r
        rfl
      inv_hom_id := by
        apply AddCommGrpCat.ext
        intro w
        rfl }
  let NI : G1.obj ≅ (wcLadicSheaf S ℓ).obj := NatIso.ofComponents eV (fun {V W} g => by
    apply AddCommGrpCat.ext
    intro r
    rfl)
  let ι : G1 ≅ wcLadicSheaf S ℓ := ObjectProperty.isoMk _ NI
  have I1 : ∀ c : ℚ_[ℓ], (SheafOfModules.toSheaf.{u+1} (wcRingSheaf S ℓ)).map
      (wcHMConst S ℓ c) ≫ ι.hom = ι.hom ≫ wcLadicScalar S ℓ c := by
    intro c
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext V
    apply AddCommGrpCat.ext
    intro r
    change (ULift.up ((ContinuousMap.mk ULift.down continuous_uliftDown).comp
        ((@id C(↥V.unop.left, ULift.{u+1} ℚ_[ℓ]) r) * ContinuousMap.const _ (ULift.up c))) :
          ULift.{u+1} C(↥V.unop.left, ℚ_[ℓ])) =
      ULift.up (c • (ContinuousMap.mk ULift.down continuous_uliftDown).comp
        (@id C(↥V.unop.left, ULift.{u+1} ℚ_[ℓ]) r))
    apply ULift.ext
    apply ContinuousMap.ext
    intro t
    show ((@id C(↥V.unop.left, ULift.{u+1} ℚ_[ℓ]) r) t).down * c =
      c * ((@id C(↥V.unop.left, ULift.{u+1} ℚ_[ℓ]) r) t).down
    exact mul_comm _ _

  obtain ⟨Φ, hΦ⟩ : ∃ Φ : ∀ (q : ℕ) (W : S.ProEt),
      Abelian.Ext (L.obj (wcFreeSheaf S W)) (SheafOfModules.unit (wcRingSheaf S ℓ)) q →+
        Abelian.Ext (wcFreeSheaf S W) G1 q,
      ∀ q W β, Φ q W β = (Abelian.Ext.mk₀ (adj.unit.app (wcFreeSheaf S W))).comp
        (Abelian.Ext.mapExactFunctor (SheafOfModules.toSheaf.{u+1} (wcRingSheaf S ℓ)) β)
        (zero_add q) :=
    ⟨fun q W => AddMonoidHom.mk' (fun β => (Abelian.Ext.mk₀ (adj.unit.app (wcFreeSheaf S W))).comp
        (Abelian.Ext.mapExactFunctor (SheafOfModules.toSheaf.{u+1} (wcRingSheaf S ℓ)) β)
        (zero_add q))
      (fun a b => by rw [Abelian.Ext.mapExactFunctor_add, Abelian.Ext.comp_add]),
      fun _ _ _ => rfl⟩
  have hB : ∀ (q : ℕ) (W : S.ProEt), Function.Bijective (Φ q W) := by
    intro q W
    have e : (⇑(Φ q W)) = fun β => (Abelian.Ext.mk₀ (adj.unit.app (wcFreeSheaf S W))).comp
        (Abelian.Ext.mapExactFunctor (SheafOfModules.toSheaf.{u+1} (wcRingSheaf S ℓ)) β)
        (zero_add q) := funext (hΦ q W)
    rw [e]
    refine ext_transfer_of_hom_bijective L (SheafOfModules.toSheaf.{u+1} (wcRingSheaf S ℓ)) adj
      (wcFreeSheaf S W) (L.obj (wcFreeSheaf S W)) (adj.unit.app (wcFreeSheaf S W))
      (fun Y => ?_) (SheafOfModules.unit (wcRingSheaf S ℓ)) q
    have e' : (fun f : L.obj (wcFreeSheaf S W) ⟶ Y => adj.unit.app (wcFreeSheaf S W) ≫
        (SheafOfModules.toSheaf.{u+1} (wcRingSheaf S ℓ)).map f) =
        ⇑(adj.homEquiv (wcFreeSheaf S W) Y) :=
      funext fun f => (Adjunction.homEquiv_unit adj _ _ f).symm
    rw [e']
    exact (adj.homEquiv (wcFreeSheaf S W) Y).bijective
  let Pe : ∀ (q : ℕ) (W : S.ProEt), Abelian.Ext (wcFreeSheaf S W) G1 q ≃+
      Abelian.Ext (wcFreeSheaf S W) (wcLadicSheaf S ℓ) q := fun q W =>
    { toFun := fun z => z.comp (Abelian.Ext.mk₀ ι.hom) (add_zero q)
      invFun := fun z => z.comp (Abelian.Ext.mk₀ ι.inv) (add_zero q)
      left_inv := fun z => by
        change (z.comp (Abelian.Ext.mk₀ ι.hom) (add_zero q)).comp (Abelian.Ext.mk₀ ι.inv)
          (add_zero q) = z
        rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id,
          Abelian.Ext.comp_mk₀_id]
      right_inv := fun z => by
        change (z.comp (Abelian.Ext.mk₀ ι.inv) (add_zero q)).comp (Abelian.Ext.mk₀ ι.hom)
          (add_zero q) = z
        rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id,
          Abelian.Ext.comp_mk₀_id]
      map_add' := fun a b => Abelian.Ext.add_comp _ _ _ _ }
  obtain ⟨Ψ, hΨ⟩ : ∃ Ψ : ∀ (q : ℕ) (W : S.ProEt),
      Abelian.Ext (L.obj (wcFreeSheaf S W)) (SheafOfModules.unit (wcRingSheaf S ℓ)) q ≃+
        Abelian.Ext (wcFreeSheaf S W) (wcLadicSheaf S ℓ) q,
      ∀ q W β, Ψ q W β = (Φ q W β).comp (Abelian.Ext.mk₀ ι.hom) (add_zero q) :=
    ⟨fun q W => (AddEquiv.ofBijective (Φ q W) (hB q W)).trans (Pe q W), fun _ _ _ => rfl⟩
  have FS : ∀ (q : ℕ) (W : S.ProEt) (c : ℚ_[ℓ])
      (β : Abelian.Ext (L.obj (wcFreeSheaf S W)) (SheafOfModules.unit (wcRingSheaf S ℓ)) q),
      Ψ q W (β.comp (Abelian.Ext.mk₀ (wcHMConst S ℓ c)) (add_zero q)) =
        (Ψ q W β).comp (Abelian.Ext.mk₀ (wcLadicScalar S ℓ c)) (add_zero q) := by
    intro q W c β
    have e2 : Φ q W (β.comp (Abelian.Ext.mk₀ (wcHMConst S ℓ c)) (add_zero q)) =
        (Φ q W β).comp (Abelian.Ext.mk₀
          ((SheafOfModules.toSheaf.{u+1} (wcRingSheaf S ℓ)).map (wcHMConst S ℓ c))) (add_zero q) := by
      rw [hΦ, hΦ, Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀]
      exact (Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ _).symm
    rw [hΨ, hΨ, e2, Abelian.Ext.comp_assoc_of_third_deg_zero,
      Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀,
      Abelian.Ext.mk₀_comp_mk₀, I1]
  have FN : ∀ (q : ℕ) (W W' : S.ProEt) (b : W' ⟶ W)
      (β : Abelian.Ext (L.obj (wcFreeSheaf S W)) (SheafOfModules.unit (wcRingSheaf S ℓ)) q),
      Ψ q W' ((Abelian.Ext.mk₀ (L.map (wcFreeSheafMap S b))).comp β (zero_add q)) =
        (Abelian.Ext.mk₀ (wcFreeSheafMap S b)).comp (Ψ q W β) (zero_add q) := by
    intro q W W' b β
    have hu : adj.unit.app (wcFreeSheaf S W') ≫
        (SheafOfModules.toSheaf.{u+1} (wcRingSheaf S ℓ)).map (L.map (wcFreeSheafMap S b)) =
        wcFreeSheafMap S b ≫ adj.unit.app (wcFreeSheaf S W) :=
      adj.unit_naturality (wcFreeSheafMap S b)
    have e2 : Φ q W' ((Abelian.Ext.mk₀ (L.map (wcFreeSheafMap S b))).comp β (zero_add q)) =
        (Abelian.Ext.mk₀ (wcFreeSheafMap S b)).comp (Φ q W β) (zero_add q) := by
      rw [hΦ, hΦ, Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
        Abelian.Ext.mk₀_comp_mk₀_assoc, hu, ← Abelian.Ext.mk₀_comp_mk₀_assoc]
    rw [hΨ, hΨ, e2, Abelian.Ext.comp_assoc_of_third_deg_zero]

  refine ⟨fun W => L.obj (wcFreeSheaf S W), fun W W' b => L.map (wcFreeSheafMap S b), ev,
    fun q W => (Ψ q W).symm, hnat, hpre, fun q W c e => ?_, fun q W W' b e => ?_⟩
  · show (Ψ q W).symm (e.comp (Abelian.Ext.mk₀ (wcLadicScalar S ℓ c)) (add_zero q)) =
      ((Ψ q W).symm e).comp (Abelian.Ext.mk₀ (wcHMConst S ℓ c)) (add_zero q)
    rw [AddEquiv.symm_apply_eq, FS, AddEquiv.apply_symm_apply]
  · show (Ψ q W').symm ((Abelian.Ext.mk₀ (wcFreeSheafMap S b)).comp e (zero_add q)) =
      (Abelian.Ext.mk₀ (L.map (wcFreeSheafMap S b))).comp ((Ψ q W).symm e) (zero_add q)
    rw [AddEquiv.symm_apply_eq, FN, AddEquiv.apply_symm_apply]

theorem wc_slice_res_free_corep_val (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (V : S.ProEt)
    [(wcSliceFunctor S V).IsContinuous (Scheme.ProEt.topology V.left) (Scheme.ProEt.topology S)]
    (P : SheafOfModules.{u+1} (wcRingSheaf S ℓ))
    (ev : ∀ M : SheafOfModules.{u+1} (wcRingSheaf S ℓ), (P ⟶ M) ≃ M.val.obj (Opposite.op V))
    (hnat : ∀ (M N : SheafOfModules.{u+1} (wcRingSheaf S ℓ)) (ψ : M ⟶ N) (g : P ⟶ M),
      ev N (g ≫ ψ) = (ψ.val.app (Opposite.op V)).hom (ev M g)) :
    ∃ ε : SheafOfModules.unit (wcRingSheaf V.left ℓ) ⟶ (wcSliceRes S ℓ V).obj P,
      (∀ Y : SheafOfModules.{u+1} (wcRingSheaf S ℓ),
        Function.Bijective (fun f : P ⟶ Y => ε ≫ (wcSliceRes S ℓ V).map f)) ∧
      ∀ (T : V.left.ProEt) (h : (wcSliceFunctor S V).obj T ⟶ V), h.left = T.hom →
        (ε.val.app (Opposite.op T)).hom (1 : C(↥T.left, ULift.{u+1} ℚ_[ℓ])) =
          (P.val.map h.op).hom (ev P (𝟙 P)) :=
by
  classical

  let h₀ : ∀ W' : V.left.ProEt, (wcSliceFunctor S V).obj W' ⟶ V := fun W' =>
    MorphismProperty.Over.homMk W'.hom rfl trivial
  have hcompat : ∀ {W₁ W₂ : V.left.ProEt} (g : W₁ ⟶ W₂),
      (wcSliceFunctor S V).map g ≫ h₀ W₂ = h₀ W₁ := fun g =>
    MorphismProperty.Over.Hom.ext (MorphismProperty.Over.w g)

  let ρ : ∀ Y : SheafOfModules.{u+1} (wcRingSheaf S ℓ), Y.val.obj (Opposite.op V) →
      ((wcSliceRes S ℓ V).obj Y).sections := fun Y s =>
    PresheafOfModules.sectionsMk (fun W' => (Y.val.map (h₀ W'.unop).op).hom s) (by
      intro X X' f
      have e := (PresheafOfModules.map_comp_apply Y.val (h₀ X.unop).op
        ((wcSliceFunctor S V).map f.unop).op s).symm
      rw [← op_comp, hcompat f.unop] at e
      exact e)

  have hρnat : ∀ (M N : SheafOfModules.{u+1} (wcRingSheaf S ℓ)) (ψ : M ⟶ N)
      (s : M.val.obj (Opposite.op V)),
      PresheafOfModules.sectionsMap ((wcSliceRes S ℓ V).map ψ).val (ρ M s) =
        ρ N ((ψ.val.app (Opposite.op V)).hom s) := by
    intro M N ψ s
    apply PresheafOfModules.sections_ext
    intro W'
    refine (PresheafOfModules.sectionsMap_coe _ _ _).trans ?_
    exact PresheafOfModules.naturality_apply ψ.val (h₀ W'.unop).op s

  have hev : ∀ (Y : SheafOfModules.{u+1} (wcRingSheaf S ℓ)) (f : P ⟶ Y),
      ev Y f = (f.val.app (Opposite.op V)).hom (ev P (𝟙 P)) := by
    intro Y f
    rw [← hnat P Y f (𝟙 P), Category.id_comp]
  obtain ⟨ε, hε⟩ : ∃ ε : SheafOfModules.unit (wcRingSheaf V.left ℓ) ⟶ (wcSliceRes S ℓ V).obj P,
      ε = ((wcSliceRes S ℓ V).obj P).unitHomEquiv.symm (ρ P (ev P (𝟙 P))) := ⟨_, rfl⟩
  have hfac : ∀ (Y : SheafOfModules.{u+1} (wcRingSheaf S ℓ)) (f : P ⟶ Y),
      ((wcSliceRes S ℓ V).obj Y).unitHomEquiv (ε ≫ (wcSliceRes S ℓ V).map f) = ρ Y (ev Y f) := by
    intro Y f
    rw [SheafOfModules.unitHomEquiv_comp_apply, hε, Equiv.apply_symm_apply, hev Y f]
    exact hρnat P Y f _

  have hρbij : ∀ Y : SheafOfModules.{u+1} (wcRingSheaf S ℓ), Function.Bijective (ρ Y) := by
    intro Y
    let t : V.left.ProEt := Scheme.ProEt.mk (𝟙 V.left)
    let e' : V ⟶ (wcSliceFunctor S V).obj t :=
      MorphismProperty.Over.homMk (𝟙 V.left)
        (by
          first
            | exact (Category.id_comp (𝟙 V.left ≫ V.hom)).trans (Category.id_comp V.hom)
            | simp [t, wcSliceFunctor, MorphismProperty.Over.map_obj_hom, Scheme.ProEt.mk_hom])
        trivial
    have hee : e' ≫ h₀ t = 𝟙 V :=
      MorphismProperty.Over.Hom.ext (Category.id_comp (𝟙 V.left) : _)
    let bang : ∀ W' : V.left.ProEt, W' ⟶ t := fun W' =>
      MorphismProperty.Over.homMk W'.hom (Category.comp_id W'.hom : _) trivial
    have hW' : ∀ W' : V.left.ProEt, h₀ W' ≫ e' = (wcSliceFunctor S V).map (bang W') := fun W' =>
      MorphismProperty.Over.Hom.ext (Category.comp_id W'.hom : _)
    have hinv : ∀ s : Y.val.obj (Opposite.op V),
        (Y.val.map e'.op).hom ((Y.val.map (h₀ t).op).hom s) = s := by
      intro s
      have e1 := (PresheafOfModules.map_comp_apply Y.val (h₀ t).op e'.op s).symm
      rw [← op_comp, hee, op_id] at e1
      have e2 : ConcreteCategory.hom (Y.val.map (𝟙 (Opposite.op V))) s = s := by
        rw [← PresheafOfModules.presheaf_map_apply_coe]
        first
          | (rw [Y.val.presheaf.map_id]; rfl)
          | simp
          | (erw [CategoryTheory.Functor.map_id]; rfl)
      exact e1.trans e2
    refine ⟨fun s s' hss => ?_, fun σ => ?_⟩
    · have h1 : (Y.val.map (h₀ t).op).hom s = (Y.val.map (h₀ t).op).hom s' := by
        have := congrArg (fun σ : ((wcSliceRes S ℓ V).obj Y).sections => σ.1 (Opposite.op t)) hss
        exact this
      exact (hinv s).symm.trans ((congrArg (fun x => (Y.val.map e'.op).hom x) h1).trans (hinv s'))
    · refine ⟨(Y.val.map e'.op).hom (σ.1 (Opposite.op t)), ?_⟩
      apply PresheafOfModules.sections_ext
      intro W'
      have e1 := (PresheafOfModules.map_comp_apply Y.val e'.op (h₀ W'.unop).op
        (σ.1 (Opposite.op t))).symm
      rw [← op_comp, hW'] at e1
      exact e1.trans (PresheafOfModules.sections_property σ (bang W'.unop).op)
  refine ⟨ε, fun Y => ?_, fun T hT hh => ?_⟩
  ·
    have hfun : (fun f : P ⟶ Y => ε ≫ (wcSliceRes S ℓ V).map f) =
        ((wcSliceRes S ℓ V).obj Y).unitHomEquiv.symm ∘ ρ Y ∘ ev Y := by
      funext f
      apply ((wcSliceRes S ℓ V).obj Y).unitHomEquiv.injective
      simp only [Function.comp_apply, Equiv.apply_symm_apply]
      exact hfac Y f
    rw [hfun]
    exact (Equiv.bijective _).comp ((hρbij Y).comp (Equiv.bijective _))
  ·
    have hTeq : hT = h₀ T := MorphismProperty.Over.Hom.ext hh
    subst hTeq
    have hval : ((wcSliceRes S ℓ V).obj P).unitHomEquiv ε = ρ P (ev P (𝟙 P)) := by
      rw [hε]; exact Equiv.apply_symm_apply _ _
    have h2 := congrArg
      (fun σ : ((wcSliceRes S ℓ V).obj P).sections => σ.1 (Opposite.op T)) hval
    refine (SheafOfModules.unitHomEquiv_apply_coe _ ε (Opposite.op T)).symm.trans ?_
    exact h2

theorem wc_slice_res_trans_iso (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (W W' : S.ProEt) (b : W' ⟶ W)
    [WeaklyEtale b.left]
    [(wcSliceFunctor S W).IsContinuous (Scheme.ProEt.topology W.left) (Scheme.ProEt.topology S)]
    [(wcSliceFunctor S W').IsContinuous (Scheme.ProEt.topology W'.left) (Scheme.ProEt.topology S)]
    [(wcSliceFunctor W.left (Scheme.ProEt.mk b.left)).IsContinuous
      (Scheme.ProEt.topology (Scheme.ProEt.mk b.left).left) (Scheme.ProEt.topology W.left)] :
    ∃ ρ : wcSliceRes S ℓ W ⋙ wcSliceRes W.left ℓ (Scheme.ProEt.mk b.left) ≅ wcSliceRes S ℓ W',
      ∀ (M : SheafOfModules.{u+1} (wcRingSheaf S ℓ)) (T : W'.left.ProEt)
        (k : (wcSliceFunctor S W').obj T ⟶
          (wcSliceFunctor S W).obj ((wcSliceFunctor W.left (Scheme.ProEt.mk b.left)).obj T)),
        k.left = 𝟙 _ →
        ∀ x : M.val.obj (Opposite.op
            ((wcSliceFunctor S W).obj ((wcSliceFunctor W.left (Scheme.ProEt.mk b.left)).obj T))),
          ((ρ.hom.app M).val.app (Opposite.op T)).hom x = (M.val.map k.op).hom x :=
by
  classical
  haveI hFG : (wcSliceFunctor W.left (Scheme.ProEt.mk b.left) ⋙ wcSliceFunctor S W).IsContinuous
      (Scheme.ProEt.topology (Scheme.ProEt.mk b.left).left) (Scheme.ProEt.topology S) :=
    Functor.isContinuous_comp (wcSliceFunctor W.left (Scheme.ProEt.mk b.left)) (wcSliceFunctor S W)
      (Scheme.ProEt.topology (Scheme.ProEt.mk b.left).left) (Scheme.ProEt.topology W.left)
      (Scheme.ProEt.topology S)
  haveI hH : (wcSliceFunctor S W').IsContinuous
      (Scheme.ProEt.topology (Scheme.ProEt.mk b.left).left) (Scheme.ProEt.topology S) :=
    ‹(wcSliceFunctor S W').IsContinuous (Scheme.ProEt.topology W'.left) (Scheme.ProEt.topology S)›

  have hT : ∀ T : W'.left.ProEt, (Iso.refl T.left).hom ≫
      ((wcSliceFunctor S W).obj ((wcSliceFunctor W.left (Scheme.ProEt.mk b.left)).obj T)).hom =
        ((wcSliceFunctor S W').obj T).hom := by
    intro T
    show 𝟙 T.left ≫ (T.hom ≫ b.left) ≫ W.hom = T.hom ≫ W'.hom
    rw [Category.id_comp, Category.assoc, MorphismProperty.Over.w b]
  let c : ∀ T : W'.left.ProEt, (wcSliceFunctor S W').obj T ≅
      (wcSliceFunctor W.left (Scheme.ProEt.mk b.left) ⋙ wcSliceFunctor S W).obj T :=
    fun T => MorphismProperty.Over.isoMk (Iso.refl T.left) (hT T)
  let α : wcSliceFunctor S W' ≅
      wcSliceFunctor W.left (Scheme.ProEt.mk b.left) ⋙ wcSliceFunctor S W :=
    NatIso.ofComponents c (fun {T₁ T₂} g => by
      apply MorphismProperty.Over.Hom.ext
      show g.left ≫ 𝟙 T₂.left = 𝟙 T₁.left ≫ g.left
      rw [Category.comp_id, Category.id_comp])
  have hα : ∀ T : W'.left.ProEt, (α.hom.app T).left = 𝟙 _ := fun T => rfl

  have hR : ((𝟙 (wcRingSheaf (Scheme.ProEt.mk b.left).left ℓ) ≫
        ((wcSliceFunctor W.left (Scheme.ProEt.mk b.left)).sheafPushforwardContinuous RingCat.{u+1}
          (Scheme.ProEt.topology (Scheme.ProEt.mk b.left).left)
          (Scheme.ProEt.topology W.left)).map (𝟙 (wcRingSheaf W.left ℓ)) :
        wcRingSheaf (Scheme.ProEt.mk b.left).left ℓ ⟶
          ((wcSliceFunctor W.left (Scheme.ProEt.mk b.left) ⋙ wcSliceFunctor S W).sheafPushforwardContinuous
            RingCat.{u+1} (Scheme.ProEt.topology (Scheme.ProEt.mk b.left).left)
            (Scheme.ProEt.topology S)).obj (wcRingSheaf S ℓ)) ≫
      (@Functor.sheafPushforwardContinuousNatTrans _ _ _ _ _ _ α.hom RingCat.{u+1} _
          (Scheme.ProEt.topology (Scheme.ProEt.mk b.left).left) (Scheme.ProEt.topology S)
          hH hFG).app (wcRingSheaf S ℓ)) =
      𝟙 (wcRingSheaf (Scheme.ProEt.mk b.left).left ℓ) := by
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext V
    induction V using Opposite.rec with
    | op T =>
    apply RingCat.hom_ext
    apply RingHom.ext
    intro s
    rfl
  let ρ₀ := SheafOfModules.pushforwardComp
    (J := Scheme.ProEt.topology (Scheme.ProEt.mk b.left).left)
    (K := Scheme.ProEt.topology W.left) (F := wcSliceFunctor W.left (Scheme.ProEt.mk b.left))
    (S := wcRingSheaf (Scheme.ProEt.mk b.left).left ℓ) (R := wcRingSheaf W.left ℓ)
    (𝟙 (wcRingSheaf (Scheme.ProEt.mk b.left).left ℓ))
    (K' := Scheme.ProEt.topology S) (G := wcSliceFunctor S W) (R' := wcRingSheaf S ℓ)
    (𝟙 (wcRingSheaf W.left ℓ))
  let ρ₁ := @SheafOfModules.pushforwardNatIso _ _ _ _
    (Scheme.ProEt.topology (Scheme.ProEt.mk b.left).left)
    (Scheme.ProEt.topology S) (wcSliceFunctor S W')
    (wcSliceFunctor W.left (Scheme.ProEt.mk b.left) ⋙ wcSliceFunctor S W)
    (wcRingSheaf (Scheme.ProEt.mk b.left).left ℓ) (wcRingSheaf S ℓ) hH hFG
    ((𝟙 (wcRingSheaf (Scheme.ProEt.mk b.left).left ℓ) ≫
        ((wcSliceFunctor W.left (Scheme.ProEt.mk b.left)).sheafPushforwardContinuous RingCat.{u+1}
          (Scheme.ProEt.topology (Scheme.ProEt.mk b.left).left)
          (Scheme.ProEt.topology W.left)).map (𝟙 (wcRingSheaf W.left ℓ)) :
        wcRingSheaf (Scheme.ProEt.mk b.left).left ℓ ⟶
          ((wcSliceFunctor W.left (Scheme.ProEt.mk b.left) ⋙ wcSliceFunctor S W).sheafPushforwardContinuous
            RingCat.{u+1} (Scheme.ProEt.topology (Scheme.ProEt.mk b.left).left)
            (Scheme.ProEt.topology S)).obj (wcRingSheaf S ℓ))) α
  let ρ₂ := @SheafOfModules.pushforwardCongr _ _ _ _
    (Scheme.ProEt.topology (Scheme.ProEt.mk b.left).left) (Scheme.ProEt.topology S)
    (wcSliceFunctor S W') (wcRingSheaf (Scheme.ProEt.mk b.left).left ℓ) (wcRingSheaf S ℓ) hH _ _ hR
  let ρ : wcSliceRes S ℓ W ⋙ wcSliceRes W.left ℓ (Scheme.ProEt.mk b.left) ≅ wcSliceRes S ℓ W' :=
    ρ₀ ≪≫ ρ₁ ≪≫ ρ₂
  refine ⟨ρ, ?_⟩
  intro M T k hk x
  have hkα : k = α.hom.app T := MorphismProperty.Over.Hom.ext (hk.trans (hα T).symm)
  subst hkα
  rfl

theorem wc_slice_trans_corep_unit_compat (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (W W' : S.ProEt)
    (b : W' ⟶ W) [WeaklyEtale b.left]
    [(wcSliceFunctor S W).IsContinuous (Scheme.ProEt.topology W.left) (Scheme.ProEt.topology S)]
    [(wcSliceFunctor S W').IsContinuous (Scheme.ProEt.topology W'.left) (Scheme.ProEt.topology S)]
    [(wcSliceFunctor W.left (Scheme.ProEt.mk b.left)).IsContinuous
      (Scheme.ProEt.topology (Scheme.ProEt.mk b.left).left) (Scheme.ProEt.topology W.left)]
    (PW PW' : SheafOfModules.{u+1} (wcRingSheaf S ℓ)) (Pmb : PW' ⟶ PW)
    (evW : ∀ M : SheafOfModules.{u+1} (wcRingSheaf S ℓ), (PW ⟶ M) ≃ M.val.obj (Opposite.op W))
    (evW' : ∀ M : SheafOfModules.{u+1} (wcRingSheaf S ℓ), (PW' ⟶ M) ≃ M.val.obj (Opposite.op W'))
    (hnat' : ∀ (M N : SheafOfModules.{u+1} (wcRingSheaf S ℓ)) (ψ : M ⟶ N) (g : PW' ⟶ M),
      evW' N (g ≫ ψ) = (ψ.val.app (Opposite.op W')).hom (evW' M g))
    (hpre : ∀ (M : SheafOfModules.{u+1} (wcRingSheaf S ℓ)) (g : PW ⟶ M),
      evW' M (Pmb ≫ g) = (M.val.map b.op).hom (evW M g))
    (ρ : wcSliceRes S ℓ W ⋙ wcSliceRes W.left ℓ (Scheme.ProEt.mk b.left) ≅ wcSliceRes S ℓ W')
    (hρ : ∀ (M : SheafOfModules.{u+1} (wcRingSheaf S ℓ)) (T : W'.left.ProEt)
        (k : (wcSliceFunctor S W').obj T ⟶
          (wcSliceFunctor S W).obj ((wcSliceFunctor W.left (Scheme.ProEt.mk b.left)).obj T)),
        k.left = 𝟙 _ →
        ∀ x : M.val.obj (Opposite.op
            ((wcSliceFunctor S W).obj ((wcSliceFunctor W.left (Scheme.ProEt.mk b.left)).obj T))),
          ((ρ.hom.app M).val.app (Opposite.op T)).hom x = (M.val.map k.op).hom x)
    (εW : SheafOfModules.unit (wcRingSheaf W.left ℓ) ⟶ (wcSliceRes S ℓ W).obj PW)
    (hεW : ∀ (T : W.left.ProEt) (h : (wcSliceFunctor S W).obj T ⟶ W), h.left = T.hom →
        (εW.val.app (Opposite.op T)).hom (1 : C(↥T.left, ULift.{u+1} ℚ_[ℓ])) =
          (PW.val.map h.op).hom (evW PW (𝟙 PW)))
    (εW' : SheafOfModules.unit (wcRingSheaf W'.left ℓ) ⟶ (wcSliceRes S ℓ W').obj PW')
    (hεW' : ∀ (T : W'.left.ProEt) (h : (wcSliceFunctor S W').obj T ⟶ W'), h.left = T.hom →
        (εW'.val.app (Opposite.op T)).hom (1 : C(↥T.left, ULift.{u+1} ℚ_[ℓ])) =
          (PW'.val.map h.op).hom (evW' PW' (𝟙 PW'))) :
    wcSliceUnit W.left ℓ (Scheme.ProEt.mk b.left) ≫
        (wcSliceRes W.left ℓ (Scheme.ProEt.mk b.left)).map εW ≫ ρ.hom.app PW =
      εW' ≫ (wcSliceRes S ℓ W').map Pmb ∧
    wcSliceUnit W.left ℓ (Scheme.ProEt.mk b.left) ≫
        (wcSliceRes W.left ℓ (Scheme.ProEt.mk b.left)).map (wcSliceUnit S ℓ W) ≫
        ρ.hom.app (SheafOfModules.unit (wcRingSheaf S ℓ)) = wcSliceUnit S ℓ W' :=
by
  classical
  have red : ∀ {Y : Scheme.{u}} {M : SheafOfModules.{u+1} (wcRingSheaf Y ℓ)}
      (f g : SheafOfModules.unit (wcRingSheaf Y ℓ) ⟶ M),
      (∀ T : Y.ProEt, (f.val.app (Opposite.op T)).hom (1 : C(↥T.left, ULift.{u+1} ℚ_[ℓ])) =
        (g.val.app (Opposite.op T)).hom (1 : C(↥T.left, ULift.{u+1} ℚ_[ℓ]))) → f = g := by
    intro Y M f g H
    apply M.unitHomEquiv.injective
    apply PresheafOfModules.sections_ext
    intro X
    rw [SheafOfModules.unitHomEquiv_apply_coe, SheafOfModules.unitHomEquiv_apply_coe]
    exact H X.unop
  have hκ : ∀ (T₀ : Scheme.{u}) (V : T₀.ProEt)
      [(wcSliceFunctor T₀ V).IsContinuous (Scheme.ProEt.topology V.left) (Scheme.ProEt.topology T₀)]
      (T : V.left.ProEt),
      ((wcSliceUnit T₀ ℓ V).val.app (Opposite.op T)).hom (1 : C(↥T.left, ULift.{u+1} ℚ_[ℓ])) =
        (1 : C(↥T.left, ULift.{u+1} ℚ_[ℓ])) := by
    intro T₀ V _ T
    unfold wcSliceUnit
    first
      | (erw [SheafOfModules.unitToPushforwardObjUnit_val_app_apply]; rfl)
      | exact (SheafOfModules.unitToPushforwardObjUnit_val_app_apply _ _).trans rfl
      | rfl
  have s7 : (Pmb.val.app (Opposite.op W')).hom (evW' PW' (𝟙 PW')) =
      (PW.val.map b.op).hom (evW PW (𝟙 PW)) := by
    have h1 := hnat' PW' PW Pmb (𝟙 PW')
    have h2 := hpre PW (𝟙 PW)
    rw [Category.id_comp] at h1
    rw [Category.comp_id] at h2
    rw [← h1, h2]
  have key : ∀ T : W'.left.ProEt, ∃ (k : (wcSliceFunctor S W').obj T ⟶
        (wcSliceFunctor S W).obj ((wcSliceFunctor W.left (Scheme.ProEt.mk b.left)).obj T))
      (h : (wcSliceFunctor S W).obj ((wcSliceFunctor W.left (Scheme.ProEt.mk b.left)).obj T) ⟶ W)
      (h' : (wcSliceFunctor S W').obj T ⟶ W'),
      k.left = 𝟙 _ ∧ h.left = ((wcSliceFunctor W.left (Scheme.ProEt.mk b.left)).obj T).hom ∧
        h'.left = T.hom ∧ k ≫ h = h' ≫ b := by
    intro T
    refine ⟨MorphismProperty.Over.homMk (𝟙 T.left) ?_ trivial,
      MorphismProperty.Over.homMk (T.hom ≫ b.left) rfl trivial,
      MorphismProperty.Over.homMk T.hom rfl trivial, rfl, rfl, rfl, ?_⟩
    · show 𝟙 T.left ≫ (T.hom ≫ b.left) ≫ W.hom = T.hom ≫ W'.hom
      rw [Category.id_comp, Category.assoc, MorphismProperty.Over.w b]
    · apply MorphismProperty.Over.Hom.ext
      show 𝟙 T.left ≫ T.hom ≫ b.left = T.hom ≫ b.left
      exact Category.id_comp _
  refine ⟨red _ _ (fun T => ?_), red _ _ (fun T => ?_)⟩
  · obtain ⟨k, h, h', hk, hh, hh', hkh⟩ := key T
    have e1 := hκ W.left (Scheme.ProEt.mk b.left) T
    have eL : ((wcSliceUnit W.left ℓ (Scheme.ProEt.mk b.left) ≫
        (wcSliceRes W.left ℓ (Scheme.ProEt.mk b.left)).map εW ≫ ρ.hom.app PW).val.app
          (Opposite.op T)).hom (1 : C(↥T.left, ULift.{u+1} ℚ_[ℓ])) =
          (PW.val.map (k ≫ h).op).hom (evW PW (𝟙 PW)) := by
      show ((ρ.hom.app PW).val.app (Opposite.op T)).hom
        ((((wcSliceRes W.left ℓ (Scheme.ProEt.mk b.left)).map εW).val.app (Opposite.op T)).hom
          (((wcSliceUnit W.left ℓ (Scheme.ProEt.mk b.left)).val.app (Opposite.op T)).hom
            (1 : C(↥T.left, ULift.{u+1} ℚ_[ℓ])))) = _
      rw [e1]
      show ((ρ.hom.app PW).val.app (Opposite.op T)).hom
        ((εW.val.app (Opposite.op ((wcSliceFunctor W.left (Scheme.ProEt.mk b.left)).obj T))).hom
          (1 : C(↥((wcSliceFunctor W.left (Scheme.ProEt.mk b.left)).obj T).left,
            ULift.{u+1} ℚ_[ℓ]))) = _
      rw [hεW _ h hh]
      exact (hρ PW T k hk _).trans (PW.val.map_comp_apply h.op k.op _).symm
    have eR : ((εW' ≫ (wcSliceRes S ℓ W').map Pmb).val.app (Opposite.op T)).hom
        (1 : C(↥T.left, ULift.{u+1} ℚ_[ℓ])) =
        (PW.val.map (h' ≫ b).op).hom (evW PW (𝟙 PW)) := by
      show (Pmb.val.app (Opposite.op ((wcSliceFunctor S W').obj T))).hom
        ((εW'.val.app (Opposite.op T)).hom (1 : C(↥T.left, ULift.{u+1} ℚ_[ℓ]))) = _
      rw [hεW' T h' hh', PresheafOfModules.naturality_apply, s7]
      exact (PW.val.map_comp_apply b.op h'.op _).symm
    refine eL.trans ?_
    rw [hkh]
    exact eR.symm
  · obtain ⟨k, -, -, hk, -, -, -⟩ := key T
    have e1 := hκ W.left (Scheme.ProEt.mk b.left) T
    have e2 := hκ S W ((wcSliceFunctor W.left (Scheme.ProEt.mk b.left)).obj T)
    have e3 := hκ S W' T
    show ((ρ.hom.app (SheafOfModules.unit (wcRingSheaf S ℓ))).val.app (Opposite.op T)).hom
        (((wcSliceUnit S ℓ W).val.app
          (Opposite.op ((wcSliceFunctor W.left (Scheme.ProEt.mk b.left)).obj T))).hom
          (((wcSliceUnit W.left ℓ (Scheme.ProEt.mk b.left)).val.app (Opposite.op T)).hom
            (1 : C(↥T.left, ULift.{u+1} ℚ_[ℓ])))) =
      ((wcSliceUnit S ℓ W').val.app (Opposite.op T)).hom (1 : C(↥T.left, ULift.{u+1} ℚ_[ℓ]))
    rw [e3]
    have e2' : ((wcSliceUnit S ℓ W).val.app
          (Opposite.op ((wcSliceFunctor W.left (Scheme.ProEt.mk b.left)).obj T))).hom
          (((wcSliceUnit W.left ℓ (Scheme.ProEt.mk b.left)).val.app (Opposite.op T)).hom
            (1 : C(↥T.left, ULift.{u+1} ℚ_[ℓ]))) =
        (1 : C(↥((wcSliceFunctor W.left (Scheme.ProEt.mk b.left)).obj T).left,
          ULift.{u+1} ℚ_[ℓ])) := by
      rw [e1]
      exact e2
    refine (congrArg (fun x =>
      ((ρ.hom.app (SheafOfModules.unit (wcRingSheaf S ℓ))).val.app (Opposite.op T)).hom x)
        e2').trans ?_
    refine (hρ _ T k hk _).trans ?_
    exact PresheafOfModules.unit_map_one _ k.op

theorem wc_slice_unit_const_comm (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (V : S.ProEt)
    [(wcSliceFunctor S V).IsContinuous (Scheme.ProEt.topology V.left) (Scheme.ProEt.topology S)]
    (c : ℚ_[ℓ]) :
    wcSliceUnit S ℓ V ≫ (wcSliceRes S ℓ V).map (wcHMConst S ℓ c) =
      wcHMConst V.left ℓ c ≫ wcSliceUnit S ℓ V :=
by
  classical
  have hκ : ∀ (T : Scheme.{u}) (W : (T.ProEt)ᵒᵖ) (r : ↑((wcRingSheaf T ℓ).val.obj W)),
      ((wcHMConst T ℓ c).val.app W).hom r =
        r * (show ↑((wcRingSheaf T ℓ).val.obj W) from
          (ContinuousMap.const _ (ULift.up c) : C(↥(Opposite.unop W).left, ULift.{u+1} ℚ_[ℓ]))) := by
    intro T W r
    rfl
  apply (SheafOfModules.unitHomEquiv _).injective
  apply PresheafOfModules.sections_ext
  intro X
  cases X with
  | op T =>
  rw [SheafOfModules.unitHomEquiv_apply_coe, SheafOfModules.unitHomEquiv_apply_coe]
  first
    | rfl
    | (change @Eq ↑((wcRingSheaf S ℓ).val.obj (Opposite.op ((wcSliceFunctor S V).obj T)))
          (((wcHMConst S ℓ c).val.app (Opposite.op ((wcSliceFunctor S V).obj T))).hom
            (1 : ↑((wcRingSheaf S ℓ).val.obj (Opposite.op ((wcSliceFunctor S V).obj T)))))
          (((wcHMConst V.left ℓ c).val.app (Opposite.op T)).hom
            (1 : ↑((wcRingSheaf V.left ℓ).val.obj (Opposite.op T))))
       rw [hκ, hκ, one_mul, one_mul]
       rfl)

theorem wc_slice_res_exact (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (V : S.ProEt)
    [(wcSliceFunctor S V).IsContinuous (Scheme.ProEt.topology V.left) (Scheme.ProEt.topology S)] :
    (wcSliceRes S ℓ V).Additive ∧ Limits.PreservesFiniteLimits (wcSliceRes S ℓ V) ∧
      Limits.PreservesFiniteColimits (wcSliceRes S ℓ V) :=
by
  obtain ⟨DV, hDV⟩ := wc_hm_pull_data_exists V.hom ℓ
  obtain ⟨θ⟩ := wc_hm_pull_Phi_slice_iso S ℓ V DV hDV
  haveI := DV.additive
  haveI := DV.presLim
  haveI := DV.presColim
  exact ⟨Functor.additive_of_iso θ, Limits.preservesFiniteLimits_of_natIso θ,
    Limits.preservesFiniteColimits_of_natIso θ⟩

theorem ext_slice_restriction_chase {A : Type*} [Category A] [Abelian A] [HasExt A]
    {B : Type*} [Category B] [Abelian B] [HasExt B]
    {C : Type*} [Category C] [Abelian C] [HasExt C]
    (RW : A ⥤ B) (RB : B ⥤ C) (RW' : A ⥤ C) (Φ : B ⥤ C)
    [RW.Additive] [Limits.PreservesFiniteLimits RW] [Limits.PreservesFiniteColimits RW]
    [RB.Additive] [Limits.PreservesFiniteLimits RB] [Limits.PreservesFiniteColimits RB]
    [RW'.Additive] [Limits.PreservesFiniteLimits RW'] [Limits.PreservesFiniteColimits RW']
    [Φ.Additive] [Limits.PreservesFiniteLimits Φ] [Limits.PreservesFiniteColimits Φ]
    (θ : Φ ≅ RB) (ρ : RW ⋙ RB ≅ RW')
    (X X' O : A) (OB : B) (OC : C)
    (ε : OB ⟶ RW.obj X) (κ : OB ⟶ RW.obj O) [IsIso κ]
    (ε' : OC ⟶ RW'.obj X') (κ' : OC ⟶ RW'.obj O) [IsIso κ']
    (κB : OC ⟶ RB.obj OB) [IsIso κB] (p : X' ⟶ X) (μ : Φ.obj OB ≅ OC) :
    κB ≫ RB.map ε ≫ ρ.hom.app X = ε' ≫ RW'.map p →
    κB ≫ RB.map κ ≫ ρ.hom.app O = κ' →
    (∀ (e : OC ⟶ OC) (n : ℕ) (y : Abelian.Ext OC OC n),
      (Abelian.Ext.mk₀ e).comp y (zero_add n) = y.comp (Abelian.Ext.mk₀ e) (add_zero n)) →
    ∀ (q : ℕ) (β : Abelian.Ext X O q),
      ((Abelian.Ext.mk₀ ε').comp
          (Abelian.Ext.mapExactFunctor RW' ((Abelian.Ext.mk₀ p).comp β (zero_add q)))
          (zero_add q)).comp (Abelian.Ext.mk₀ (inv κ')) (add_zero q) =
        (Abelian.Ext.mk₀ μ.inv).comp
          ((Abelian.Ext.mapExactFunctor Φ
              (((Abelian.Ext.mk₀ ε).comp (Abelian.Ext.mapExactFunctor RW β) (zero_add q)).comp
                (Abelian.Ext.mk₀ (inv κ)) (add_zero q))).comp
            (Abelian.Ext.mk₀ μ.hom) (add_zero q)) (zero_add q) :=
by
  intro H1 H2 Hc q β
  subst H2

  have R0 : ∀ {P Q R S : C} {n : ℕ} (x : Abelian.Ext P Q n) (f : Q ⟶ R) (g : R ⟶ S),
      (x.comp (Abelian.Ext.mk₀ f) (add_zero n)).comp (Abelian.Ext.mk₀ g) (add_zero n) =
        x.comp (Abelian.Ext.mk₀ (f ≫ g)) (add_zero n) := by
    intro P Q R S n x f g
    rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀]

  have hΦ : ∀ {Y Z : B} {n : ℕ} (α : Abelian.Ext Y Z n),
      Abelian.Ext.mapExactFunctor Φ α =
        ((Abelian.Ext.mk₀ (θ.hom.app Y)).comp (Abelian.Ext.mapExactFunctor RB α)
          (zero_add n)).comp (Abelian.Ext.mk₀ (θ.inv.app Z)) (add_zero n) := by
    intro Y Z n α
    rw [← Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp α θ.hom, R0, Iso.hom_inv_id_app,
      Abelian.Ext.comp_mk₀_id]

  have hρ : Abelian.Ext.mapExactFunctor RB (Abelian.Ext.mapExactFunctor RW β) =
      ((Abelian.Ext.mk₀ (ρ.hom.app X)).comp (Abelian.Ext.mapExactFunctor RW' β)
        (zero_add q)).comp (Abelian.Ext.mk₀ (ρ.inv.app O)) (add_zero q) := by
    rw [← Abelian.Ext.comp_mapExactFunctor,
      ← Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp β ρ.hom, R0, Iso.hom_inv_id_app]
    exact (Abelian.Ext.comp_mk₀_id _).symm
  have hinv : inv (κB ≫ RB.map κ ≫ ρ.hom.app O) = ρ.inv.app O ≫ RB.map (inv κ) ≫ inv κB := by
    apply IsIso.inv_eq_of_hom_inv_id
    simp
  set L := ((Abelian.Ext.mk₀ ε').comp
          (Abelian.Ext.mapExactFunctor RW' ((Abelian.Ext.mk₀ p).comp β (zero_add q)))
          (zero_add q)).comp (Abelian.Ext.mk₀ (inv (κB ≫ RB.map κ ≫ ρ.hom.app O))) (add_zero q)
    with hL
  set e : OC ⟶ OC := μ.inv ≫ θ.hom.app OB ≫ inv κB with he
  set e' : OC ⟶ OC := κB ≫ θ.inv.app OB ≫ μ.hom with he'
  have hee : e ≫ e' = 𝟙 OC := by
    simp [he, he']

  have hcentral : L = (((Abelian.Ext.mk₀ e).comp L (zero_add q)).comp
      (Abelian.Ext.mk₀ e') (add_zero q)) := by
    rw [Hc e q L, R0, hee, Abelian.Ext.comp_mk₀_id]
  rw [hcentral, hΦ, hL]
  simp only [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀, hρ,
    Abelian.Ext.comp_assoc_of_third_deg_zero,
    Abelian.Ext.mk₀_comp_mk₀_assoc, Abelian.Ext.mk₀_comp_mk₀, Category.assoc]
  have ha : e ≫ ε' ≫ RW'.map p = μ.inv ≫ θ.hom.app OB ≫ RB.map ε ≫ ρ.hom.app X := by
    rw [← H1, he]
    simp
  have hb : inv (κB ≫ RB.map κ ≫ ρ.hom.app O) ≫ e' =
      ρ.inv.app O ≫ RB.map (inv κ) ≫ θ.inv.app OB ≫ μ.hom := by
    rw [hinv, he']
    simp
  rw [ha, hb]

theorem wc_proet_free_module_ext_hm_natural (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (P : S.ProEt → SheafOfModules.{u+1} (wcRingSheaf S ℓ))
    (Pm : ∀ (W W' : S.ProEt), (W' ⟶ W) → (P W' ⟶ P W))
    (ev : ∀ (W : S.ProEt) (M : SheafOfModules.{u+1} (wcRingSheaf S ℓ)),
      (P W ⟶ M) ≃ M.val.obj (Opposite.op W))
    (hnat : ∀ (W : S.ProEt) (M N : SheafOfModules.{u+1} (wcRingSheaf S ℓ)) (ψ : M ⟶ N)
      (g : P W ⟶ M), ev W N (g ≫ ψ) = (ψ.val.app (Opposite.op W)).hom (ev W M g))
    (hpre : ∀ (W W' : S.ProEt) (b : W' ⟶ W) (M : SheafOfModules.{u+1} (wcRingSheaf S ℓ))
      (g : P W ⟶ M), ev W' M (Pm W W' b ≫ g) = (M.val.map b.op).hom (ev W M g)) :
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
    ∃ Θ : ∀ (q : ℕ) (W : S.ProEt),
        Abelian.Ext (P W) (SheafOfModules.unit (wcRingSheaf S ℓ)) q ≃+ wcHM W.left ℓ q,
      (∀ (q : ℕ) (W : S.ProEt) (c : ℚ_[ℓ])
          (β : Abelian.Ext (P W) (SheafOfModules.unit (wcRingSheaf S ℓ)) q),
        Θ q W (β.comp (Abelian.Ext.mk₀ (wcHMConst S ℓ c)) (add_zero q)) =
          wcHMScalar W.left ℓ q c (Θ q W β)) ∧
      (∀ (q : ℕ) (W W' : S.ProEt) (b : W' ⟶ W) (Db : wcHMPullData b.left ℓ),
        wcHMPullCanonical Db →
        ∀ β : Abelian.Ext (P W) (SheafOfModules.unit (wcRingSheaf S ℓ)) q,
          Θ q W' ((Abelian.Ext.mk₀ (Pm W W' b)).comp β (zero_add q)) = wcHMPull Db q (Θ q W β)) :=
by
  letI hE : ∀ T : Scheme.{u}, HasExt (SheafOfModules.{u+1} (wcRingSheaf T ℓ)) :=
    fun T => HasExt.standard _
  classical
  have hcont : ∀ (T : Scheme.{u}) (V : T.ProEt),
      (wcSliceFunctor T V).IsContinuous (Scheme.ProEt.topology V.left) (Scheme.ProEt.topology T) := by
    intro T V
    haveI : (wcSliceToOver T V).IsContinuous (Scheme.ProEt.topology V.left)
        ((Scheme.ProEt.topology T).over V) := (wc_slice_over_sites_cont T V).1
    exact Functor.isContinuous_comp (wcSliceToOver T V) (Over.forget V)
      (Scheme.ProEt.topology V.left) ((Scheme.ProEt.topology T).over V) (Scheme.ProEt.topology T)
  haveI := hcont
  haveI : EnoughInjectives (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) :=
    sheafOfModules_enoughInjectives (Scheme.ProEt.topology S) (wcRingSheaf S ℓ)
  haveI : ∀ (T : Scheme.{u}) (V : T.ProEt), (wcSliceRes T ℓ V).Additive :=
    fun T V => (wc_slice_res_exact T ℓ V).1
  haveI : ∀ (T : Scheme.{u}) (V : T.ProEt), Limits.PreservesFiniteLimits (wcSliceRes T ℓ V) :=
    fun T V => (wc_slice_res_exact T ℓ V).2.1
  haveI : ∀ (T : Scheme.{u}) (V : T.ProEt), Limits.PreservesFiniteColimits (wcSliceRes T ℓ V) :=
    fun T V => (wc_slice_res_exact T ℓ V).2.2
  haveI : ∀ (T : Scheme.{u}) (V : T.ProEt), IsIso (wcSliceUnit T ℓ V) :=
    fun T V => wc_slice_unit_isIso T ℓ V
  have h3 : ∀ (T : Scheme.{u}) {A B C' D' : SheafOfModules.{u+1} (wcRingSheaf T ℓ)} {a : ℕ}
      (z : Abelian.Ext A B a) (f : B ⟶ C') (g : C' ⟶ D'),
      (z.comp (Abelian.Ext.mk₀ f) (add_zero a)).comp (Abelian.Ext.mk₀ g) (add_zero a) =
        z.comp (Abelian.Ext.mk₀ (f ≫ g)) (add_zero a) := by
    intro T A B C' D' a z f g
    rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀]
  choose ε hεbij hεval using fun W : S.ProEt =>
    wc_slice_res_free_corep_val S ℓ W (P W) (ev W) (hnat W)
  obtain ⟨Θ₀, hΘ₀⟩ : ∃ Θ₀ : ∀ (q : ℕ) (W : S.ProEt),
      Abelian.Ext (P W) (SheafOfModules.unit (wcRingSheaf S ℓ)) q →+ wcHM W.left ℓ q,
      ∀ q W β, Θ₀ q W β =
        ((Abelian.Ext.mk₀ (ε W)).comp (Abelian.Ext.mapExactFunctor (wcSliceRes S ℓ W) β)
          (zero_add q)).comp (Abelian.Ext.mk₀ (inv (wcSliceUnit S ℓ W))) (add_zero q) :=
    ⟨fun q W => ((Abelian.Ext.mk₀ (inv (wcSliceUnit S ℓ W))).postcomp
        (SheafOfModules.unit (wcRingSheaf W.left ℓ)) (add_zero q)).comp
      (((Abelian.Ext.mk₀ (ε W)).precomp
        ((wcSliceRes S ℓ W).obj (SheafOfModules.unit (wcRingSheaf S ℓ))) (zero_add q)).comp
        ((wcSliceRes S ℓ W).mapExtAddHom (P W) (SheafOfModules.unit (wcRingSheaf S ℓ)) q)),
      fun q W β => rfl⟩
  have hΘbij : ∀ (q : ℕ) (W : S.ProEt), Function.Bijective (Θ₀ q W) := by
    intro q W
    have h1 := ext_transfer_of_corep (wcSliceRes S ℓ W) (P W)
      (SheafOfModules.unit (wcRingSheaf W.left ℓ)) (ε W) (hεbij W)
      (fun I _ k e => by
        haveI := wc_slice_res_preserves_injective S ℓ W I
        exact Abelian.Ext.eq_zero_of_injective e)
      (SheafOfModules.unit (wcRingSheaf S ℓ)) q
    have hpost : Function.Bijective (fun x : Abelian.Ext
