    have hloc : ∀ (U : Y.Opens),
        (∀ (G : Sheaf (Scheme.smallEtaleTopology (U : Scheme.{u})) AddCommGrpCat.{u+1}),
          ℓ • 𝟙 G = 0 → ∀ q : ℕ, 2 ≤ q → Subsingleton (wcEtExt (U : Scheme.{u}) G q)) →
        ∀ r : ℕ, 2 ≤ r →
        ∀ y : Abelian.Ext ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
          (yoneda.obj ((wcZarToEt Y).obj U) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) F r,
