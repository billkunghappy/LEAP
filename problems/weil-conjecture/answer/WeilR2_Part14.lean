  have hfin : ∀ n : ℕ, IsIntegrallyClosed (MvPolynomial (Fin n) (integralClosure A Ω)) :=
    fun n => hgen (integralClosure A Ω) n
  obtain ⟨nσ, ⟨eσ⟩⟩ := Finite.exists_equiv_fin σ
  haveI := hfin nσ
  haveI hQIC : IsIntegrallyClosed (MvPolynomial σ (integralClosure A Ω)) :=
    IsIntegrallyClosed.of_equiv (MvPolynomial.renameEquiv (integralClosure A Ω) eσ).symm.toRingEquiv

  have s10 : ∀ (D : Type u) [CommRing D] [Algebra A D], ∃ (_ : Algebra (MvPolynomial σ A) B)
      (_ : Algebra (MvPolynomial σ A) (MvPolynomial σ D)), algebraMap (MvPolynomial σ A) B = β ∧
      algebraMap (MvPolynomial σ A) (MvPolynomial σ D) = MvPolynomial.map (algebraMap A D) ∧
      Nonempty (TensorProduct (MvPolynomial σ A) (MvPolynomial σ D) B ≃+* TensorProduct A B D) := by
    intro D _ _
    letI iB : Algebra (MvPolynomial σ A) B := β.toAlgebra
    letI iD : Algebra (MvPolynomial σ A) (MvPolynomial σ D) :=
      (MvPolynomial.map (algebraMap A D)).toAlgebra
    refine ⟨iB, iD, rfl, rfl, ?_⟩
    haveI : IsScalarTower A (MvPolynomial σ A) B := IsScalarTower.of_algebraMap_eq (fun a => by
      rw [← hβ]
      rfl)
    let e0 : MvPolynomial σ D ≃+* TensorProduct A (MvPolynomial σ A) D :=
      (MvPolynomial.algebraTensorAlgEquiv (σ := σ) A D).symm.toRingEquiv.trans
        (Algebra.TensorProduct.comm A D (MvPolynomial σ A)).toRingEquiv
    have he0 : ∀ f : MvPolynomial σ A, e0 (algebraMap (MvPolynomial σ A) (MvPolynomial σ D) f) =
        algebraMap (MvPolynomial σ A) (TensorProduct A (MvPolynomial σ A) D) f := by
      intro f
      have key : e0.toRingHom.comp (MvPolynomial.map (algebraMap A D)) =
          algebraMap (MvPolynomial σ A) (TensorProduct A (MvPolynomial σ A) D) := by
        apply MvPolynomial.ringHom_ext
        · intro a
          have h1 : (MvPolynomial.map (algebraMap A D)) (MvPolynomial.C a : MvPolynomial σ A) =
              algebraMap D (MvPolynomial σ D) (algebraMap A D a) := by
            rw [MvPolynomial.map_C, MvPolynomial.algebraMap_eq]
          have h2 : (MvPolynomial.algebraTensorAlgEquiv (σ := σ) A D).symm
              (algebraMap D (MvPolynomial σ D) (algebraMap A D a)) =
              algebraMap D (TensorProduct A D (MvPolynomial σ A)) (algebraMap A D a) :=
            AlgEquiv.commutes _ _
          have h3 : (MvPolynomial.C a : MvPolynomial σ A) ⊗ₜ[A] (1 : D) =
              (1 : MvPolynomial σ A) ⊗ₜ[A] (algebraMap A D a) := by
            rw [Algebra.algebraMap_eq_smul_one a, TensorProduct.tmul_smul,
              TensorProduct.smul_tmul', ← Algebra.algebraMap_eq_smul_one, MvPolynomial.algebraMap_eq]
          rw [RingHom.comp_apply, h1]
          show (Algebra.TensorProduct.comm A D (MvPolynomial σ A))
              ((MvPolynomial.algebraTensorAlgEquiv (σ := σ) A D).symm
                (algebraMap D (MvPolynomial σ D) (algebraMap A D a))) = _
          rw [h2, Algebra.TensorProduct.algebraMap_apply, Algebra.TensorProduct.comm_tmul,
            Algebra.TensorProduct.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply,
            Algebra.algebraMap_self, RingHom.id_apply, h3]
        · intro s
          rw [RingHom.comp_apply, MvPolynomial.map_X]
          show (Algebra.TensorProduct.comm A D (MvPolynomial σ A))
              ((MvPolynomial.algebraTensorAlgEquiv (σ := σ) A D).symm (MvPolynomial.X s)) = _
          rw [MvPolynomial.algebraTensorAlgEquiv_symm_X, Algebra.TensorProduct.comm_tmul,
            Algebra.TensorProduct.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply]
      exact RingHom.congr_fun key f
    let e : MvPolynomial σ D ≃ₐ[MvPolynomial σ A] TensorProduct A (MvPolynomial σ A) D :=
      AlgEquiv.ofRingEquiv (f := e0) he0
    exact ⟨((Algebra.TensorProduct.comm (MvPolynomial σ A) (MvPolynomial σ D) B).trans
        ((Algebra.TensorProduct.congr AlgEquiv.refl e).trans
         (Algebra.TensorProduct.cancelBaseChange A (MvPolynomial σ A) (MvPolynomial σ A) B D))).toRingEquiv⟩
  obtain ⟨_, _, hPB, hPQ, ⟨Φ⟩⟩ := s10 (integralClosure A Ω)

  obtain ⟨hflat, G, _, _, κ, hGet, he2, hf2⟩ :=
    wc_ring_fep_flat_and_base_change (MvPolynomial σ A) B (MvPolynomial σ (integralClosure A Ω)) I F p ι
      hEt hb hc (fun i => (hd i).trans hPB.symm) he hf

  haveI : IsScalarTower A (MvPolynomial σ A) B := IsScalarTower.of_algebraMap_eq (fun a => by
    rw [hPB, MvPolynomial.algebraMap_eq, ← hβ]
    rfl)
  haveI := hflat
  haveI hBflat : Module.Flat A B := Module.Flat.trans A (MvPolynomial σ A) B

  haveI : Module.FaithfullyFlat A B := Module.FaithfullyFlat.of_flat_of_isLocalHom
  haveI : Nontrivial (TensorProduct A B (integralClosure A Ω)) :=
