    have hmax : y.asIdeal.IsMaximal := (PrimeSpectrum.isClosed_singleton_iff_isMaximal y).mp hyc
    have hcomap : y.asIdeal.comap Polynomial.C = IsLocalRing.maximalIdeal A' := by
