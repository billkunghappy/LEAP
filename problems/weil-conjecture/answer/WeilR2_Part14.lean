        Limits.pullback.fst ((F.obj l).hom ≫ Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) zb :=
    (Category.assoc _ _ _).trans ((congrArg (Limits.pullback.lift _ _ hw5 ≫ ·) e1).trans
      ((Category.assoc _ _ _).symm.trans ((congrArg (· ≫ φ l) e3).trans (e5.symm.trans
        ((congrArg (Limits.pullback.lift _ _ hw7 ≫ ·) e7.symm).trans
          (Category.assoc _ _ _).symm)))))
  have h1 : (Limits.pullback.lift _ _ hw5 ≫ Limits.pullback.lift _ _ hw4) ≫
        Limits.pullback.snd ((F.obj l).hom ≫ Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) zb =
      (Limits.pullback.lift _ _ hw7 ≫ Limits.pullback.lift _ _ hw8) ≫
        Limits.pullback.snd ((F.obj l).hom ≫ Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) zb :=
    (Category.assoc _ _ _).trans ((congrArg (Limits.pullback.lift _ _ hw5 ≫ ·) e2).trans
      (e4.trans ((congrArg (· ≫ Spec.map (CommRingCat.ofHom ι)) e6.symm).trans
        ((Category.assoc _ _ _).trans ((congrArg (Limits.pullback.lift _ _ hw7 ≫ ·) e8.symm).trans
          (Category.assoc _ _ _).symm)))))
  have hw6 : (Limits.pullback.lift _ _ hw5 ≫ τ) ≫ q =
      Limits.pullback.lift _ _ hw7 ≫ Limits.pullback.lift _ _ hw8 :=
    (Category.assoc _ _ _).trans ((congrArg (Limits.pullback.lift _ _ hw5 ≫ ·) hτ).trans
      (Limits.pullback.hom_ext h0 h1))
  exact ⟨hpb.lift (hpb'.lift _ _ hw6) (𝟙 _)
      ((hpb'.lift_snd _ _ _).trans (Category.id_comp _).symm),
    hpb.lift_snd _ _ _⟩

theorem wc_affine_et_coh_of_ring_factorisations : ∀ (T : Scheme.{u}) [IsAffine T] (ℓ : ℕ), ℓ.Prime → Nonempty ↥T → (∀ F : Finset Γ(T, ⊤), ∃ (T' : Scheme.{u}) (_ : IsAffine T') (θ : T ⟶ T') (ψ : ↥(Subring.closure (F : Set Γ(T, ⊤))) →+* Γ(T', ⊤)), θ.appTop.hom.comp ψ = (Subring.closure (F : Set Γ(T, ⊤))).subtype ∧ Nat.card (wcEtCoh T' ℓ 0) = ℓ ∧ ∀ q : ℕ, 1 ≤ q → Subsingleton (wcEtCoh T' ℓ q)) → Nat.card (wcEtCoh T ℓ 0) = ℓ ∧ ∀ q : ℕ, 1 ≤ q → Subsingleton (wcEtCoh T ℓ q) :=
by
  intro T _ ℓ hℓ hne H
  classical

  have hs1 : ∀ (R : Type u) [CommRing R] (m q : ℕ), (∀ F : Finset R, ∃ (T₀ : Type u) (_ : CommRing T₀) (ψ : ↥(Subring.closure (F : Set R)) →+* T₀) (j : T₀ →+* R), j.comp ψ = (Subring.closure (F : Set R)).subtype ∧ Subsingleton (wcEtCoh (Spec (.of T₀)) m q)) → Subsingleton (wcEtCoh (Spec (.of R)) m q) := by
    intro R _ m q hyp
    haveI := wc_et_enough_injectives (Spec (.of R))
    let J := InjectiveResolution.of ((constantSheaf (Scheme.smallEtaleTopology (Spec (.of R)))
      AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))
    refine (wc_et_coh_subsingleton_iff_injres_cocycles (Spec (.of R)) m q J).mpr ?_
    intro z hz
    obtain ⟨K, εK, hεK, hmono, hex0, hex, hacyc, I, τ, hτ, hdesc⟩ :=
      wc_et_subring_colimit_resolution R m
    obtain ⟨α, hα⟩ := wc_et_acyclic_res_cocycle_comparison (Spec (.of R)) _ K εK hεK hmono hex0 hex
      hacyc J
    obtain ⟨k, b, hk, hzk⟩ := hα q z hz
    obtain ⟨F, c, hc, hck⟩ := hdesc q k hk
    obtain ⟨T₀, _, ψ, j, hψ, hT⟩ := hyp F
    have hp : Spec.map (CommRingCat.ofHom j) ≫ Spec.map (CommRingCat.ofHom ψ) =
        Spec.map (CommRingCat.ofHom (Subring.closure (F : Set R)).subtype) := by
      rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, hψ]
    let τ' : ∀ n : ℕ, wcEtTransport (Spec.map (CommRingCat.ofHom (Subring.closure (F : Set R)).subtype))
        ((I F).cocomplex.X n) (J.cocomplex.X n) := fun n =>
      { ρ := fun V O h hh => ((α.f n).hom.app (Opposite.op O)).hom.comp ((τ F n).ρ V O h hh)
        nat := by
          intro V V' c' O O' d h hh h' hh' hc' x
          show ((α.f n).hom.app (Opposite.op O')).hom ((τ F n).ρ V' O' h' hh' _) = _
          rw [(τ F n).nat V V' c' O O' d h hh h' hh' hc' x]
          exact congrArg (fun φ => AddCommGrpCat.Hom.hom φ ((τ F n).ρ V O h hh x))
            ((α.f n).hom.naturality d.op) }
    have hτ' : ∀ (n : ℕ) (V : (Spec (.of ↥(Subring.closure (F : Set R)))).Etale)
        (O : (Spec (.of R)).Etale) (k' : O.left ⟶ V.left)
        (hk' : k' ≫ V.hom = O.hom ≫ Spec.map (CommRingCat.ofHom (Subring.closure (F : Set R)).subtype))
        (x : ((I F).cocomplex.X n).obj.obj (Opposite.op V)),
        (τ' (n + 1)).ρ V O k' hk' ((((I F).cocomplex.d n (n + 1)).hom.app (Opposite.op V)).hom x) =
          ((J.cocomplex.d n (n + 1)).hom.app (Opposite.op O)).hom ((τ' n).ρ V O k' hk' x) := by
      intro n V O k' hk' x
      show ((α.f (n + 1)).hom.app (Opposite.op O)).hom ((τ F (n + 1)).ρ V O k' hk' _) =
        ((J.cocomplex.d n (n + 1)).hom.app (Opposite.op O)).hom
          (((α.f n).hom.app (Opposite.op O)).hom ((τ F n).ρ V O k' hk' x))
      rw [hτ F n V O k' hk' x]
      exact (congrArg (fun φ => AddCommGrpCat.Hom.hom (φ.hom.app (Opposite.op O))
        ((τ F n).ρ V O k' hk' x)) (α.comm n (n + 1))).symm
    obtain ⟨b', hb'⟩ := wc_et_injres_transport_factor_coboundary (Spec.map (CommRingCat.ofHom j))
      (Spec.map (CommRingCat.ofHom ψ))
      (Spec.map (CommRingCat.ofHom (Subring.closure (F : Set R)).subtype)) hp m q hT (I F) J τ' hτ'
      c hc
    refine ⟨b' + b, ?_⟩
    rw [map_add, hb', hzk]
    congr 1
    show ((α.f q).hom.app _).hom ((τ F q).ρ _ _ _ _ c) = _
    rw [hck]

  have hconn_spec : ∀ (R : Type u) [CommRing R], Nonempty (PrimeSpectrum R) →
      (∀ e : R, IsIdempotentElem e → e = 0 ∨ e = 1) → ConnectedSpace (PrimeSpectrum R) := by
    intro R _ hne' hid
    rw [connectedSpace_iff_clopen]
    refine ⟨hne', fun s hs => ?_⟩
    obtain ⟨e, he, rfl⟩ := PrimeSpectrum.isClopen_iff.mp hs
    rcases hid e he with h | h
    · left
      rw [h, PrimeSpectrum.basicOpen_zero]
      rfl
    · right
      rw [h, PrimeSpectrum.basicOpen_one]
      rfl
  have hnil_idem : ∀ (R : Type u) [CommRing R] (e : R), IsIdempotentElem e →
      PrimeSpectrum.basicOpen e = ⊥ → e = 0 := by
    intro R _ e he hb
    obtain ⟨n, hn⟩ := (PrimeSpectrum.basicOpen_eq_bot_iff e).mp hb
    rw [← IsIdempotentElem.pow_succ_eq n he, pow_succ, hn, zero_mul]
  have hidem_spec : ∀ (R : Type u) [CommRing R] [ConnectedSpace (PrimeSpectrum R)] (e : R),
      IsIdempotentElem e → e = 0 ∨ e = 1 := by
    intro R _ _ e he
    have hcl : IsClopen ((PrimeSpectrum.basicOpen e : TopologicalSpace.Opens (PrimeSpectrum R)) :
        Set (PrimeSpectrum R)) := PrimeSpectrum.isClopen_iff.mpr ⟨e, he, rfl⟩
    rcases isClopen_iff.mp hcl with h | h
    · left
      exact hnil_idem R e he
        (TopologicalSpace.Opens.ext (h.trans TopologicalSpace.Opens.coe_bot.symm))
    · right
      have hb : PrimeSpectrum.basicOpen e = ⊤ :=
        TopologicalSpace.Opens.ext (h.trans TopologicalSpace.Opens.coe_top.symm)
      have h1 : PrimeSpectrum.basicOpen (1 - e) = ⊥ := by
        have := PrimeSpectrum.basicOpen_mul e (1 - e)
        rw [he.mul_one_sub_self, PrimeSpectrum.basicOpen_zero, hb, top_inf_eq] at this
        exact this.symm
      have h2 := hnil_idem R (1 - e) he.one_sub h1
      rw [sub_eq_zero] at h2
      exact h2.symm

  have hiso_surj : ∀ {X Y : Scheme.{u}} (i : X ≅ Y), Function.Surjective i.hom := by
    intro X Y i y
    refine ⟨i.inv y, ?_⟩
    rw [← Scheme.Hom.comp_apply, Iso.inv_hom_id]
    rfl
  have hto_spec : ∀ (X : Scheme.{u}) [IsAffine X] [ConnectedSpace X],
      ConnectedSpace (PrimeSpectrum Γ(X, ⊤)) := by
    intro X _ _
    have : ConnectedSpace (Spec Γ(X, ⊤)) :=
      Function.Surjective.connectedSpace (hiso_surj X.isoSpec) X.isoSpec.hom.continuous
    exact this
  have hof_spec : ∀ (X : Scheme.{u}) [IsAffine X], ConnectedSpace (PrimeSpectrum Γ(X, ⊤)) →
      ConnectedSpace X := by
    intro X _ h
    haveI : ConnectedSpace (Spec Γ(X, ⊤)) := h
    exact Function.Surjective.connectedSpace (hiso_surj X.isoSpec.symm) X.isoSpec.inv.continuous

  obtain ⟨t⟩ := hne
  haveI hconn : ConnectedSpace T := by
    apply hof_spec
    apply hconn_spec _ ⟨T.isoSpec.hom t⟩
    intro e he
    obtain ⟨T', hT', θ, ψ, hψ, h0, -⟩ := H {e}
    haveI := hT'
    haveI : ConnectedSpace T' := wc_et_coh0_card_prime_connected T' ℓ hℓ h0
    haveI := hto_spec T'
    have hmem : e ∈ Subring.closure (({e} : Finset Γ(T, ⊤)) : Set Γ(T, ⊤)) :=
      Subring.subset_closure (by simp)
    have he' : IsIdempotentElem
        (⟨e, hmem⟩ : Subring.closure (({e} : Finset Γ(T, ⊤)) : Set Γ(T, ⊤))) :=
      Subtype.ext he
    have hψe := RingHom.congr_fun hψ ⟨e, hmem⟩
    change θ.appTop.hom (ψ ⟨e, hmem⟩) = e at hψe
    rcases hidem_spec _ (ψ ⟨e, hmem⟩) (he'.map ψ) with h | h
    · left
      rw [← hψe, h, map_zero]
    · right
      rw [← hψe, h, map_one]
  refine ⟨wc_et_coh_zero_connected_card T ℓ hℓ.ne_zero, fun q hq => ?_⟩

  have hR := hs1 Γ(T, ⊤) ℓ q (fun F => by
    obtain ⟨T', hT', θ, ψ, hψ, -, hq'⟩ := H F
    haveI := hT'
    haveI := hq' q hq
    obtain ⟨E⟩ := wc_et_coh_iso_invariance T'.isoSpec.hom ℓ q
    exact ⟨Γ(T', ⊤), inferInstance, ψ, θ.appTop.hom, hψ, E.subsingleton⟩)
  obtain ⟨E⟩ := wc_et_coh_iso_invariance T.isoSpec.hom ℓ q
  haveI := hR
  exact E.symm.subsingleton

theorem wc_poly_shens_tube_noetherian_factorisation_of_unit : ∀ (ℓ : ℕ) (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)], IsUnit (ℓ : A) → ∀ (x : Spec (.of (Polynomial A))), Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A))) x = IsLocalRing.closedPoint A → ∀ (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (Polynomial A))) x)) (Scheme.Etale.forget (Spec (.of (Polynomial A))))) (φ : ∀ l, Spec (.of B) ⟶ (W'.obj l).right.left) (a : Spec (.of B) ⟶ Spec (.of (Polynomial A))), wcHalShData x B Λ W' φ a → ∀ (C : Type u) [CommRing C] [HenselianLocalRing C] [IsSepClosed (IsLocalRing.ResidueField C)] (c : Spec (.of C) ⟶ Spec (.of A)) (F : Finset Γ(Limits.pullback (a ≫ Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) c, ⊤)), ∃ (A' : Type u) (_ : CommRing A') (_ : HenselianLocalRing A') (_ : IsSepClosed (IsLocalRing.ResidueField A')) (_ : IsUnit (ℓ : A')) (x' : Spec (.of (Polynomial A'))) (_ : Spec.map (CommRingCat.ofHom (algebraMap A' (Polynomial A'))) x' = IsLocalRing.closedPoint A') (B' : Type u) (_ : CommRing B') (_ : HenselianLocalRing B') (_ : IsSepClosed (IsLocalRing.ResidueField B')) (Λ' : Type u) (_ : SmallCategory Λ') (_ : IsCofiltered Λ') (W'' : Λ' ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (Polynomial A'))) x')) (Scheme.Etale.forget (Spec (.of (Polynomial A'))))) (φ' : ∀ l, Spec (.of B') ⟶ (W''.obj l).right.left) (a' : Spec (.of B') ⟶ Spec (.of (Polynomial A'))) (_ : wcHalShData x' B' Λ' W'' φ' a') (C' : Type u) (_ : CommRing C') (_ : HenselianLocalRing C') (_ : IsSepClosed (IsLocalRing.ResidueField C')) (_ : IsNoetherianRing C') (c' : Spec (.of C') ⟶ Spec (.of A')) (θ : Limits.pullback (a ≫ Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) c ⟶ Limits.pullback (a' ≫ Spec.map (CommRingCat.ofHom (algebraMap A' (Polynomial A')))) c') (ψ : ↥(Subring.closure (F : Set Γ(Limits.pullback (a ≫ Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) c, ⊤))) →+* Γ(Limits.pullback (a' ≫ Spec.map (CommRingCat.ofHom (algebraMap A' (Polynomial A')))) c', ⊤)), θ.appTop.hom.comp ψ = (Subring.closure (F : Set Γ(Limits.pullback (a ≫ Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) c, ⊤))).subtype :=
by

  have key : ∀ (R S : Type u) [CommRing R] [CommRing S] (f : R →+* S) (σ' : Type u)
      (x0 : σ' → R) (q : MvPolynomial σ' ℤ),
      MvPolynomial.aeval (fun i => f (x0 i)) q = f (MvPolynomial.aeval x0 q) := by
    intro R S _ _ f σ' x0 q
    induction q using MvPolynomial.induction_on
    · simp
    · simp only [map_add, *]
    · simp only [map_mul, MvPolynomial.aeval_X, *]
  intro ℓ A _ _ _ hℓA x hx B _ _ _ Λ _ _ W' φ a hd C _ _ _ c F

  obtain ⟨β, hβ, I, _, _, D, p, ι, hp, hDp, hιD, hιp, hsurj, hker⟩ :=
    wc_shdata_filtered_etale_presentation x B Λ W' φ a hd (Polynomial A) (Iso.refl _)
  have hβ' : Spec.map (CommRingCat.ofHom β) = a := by
    rw [hβ, Iso.refl_hom, Category.comp_id]
  have hpa : (Spec.preimage a).hom = β := by
    rw [← hβ', Spec.preimage_map, CommRingCat.hom_ofHom]
  have hf : Spec.map (CommRingCat.ofHom (β.comp (algebraMap A (Polynomial A)))) =
      a ≫ Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A))) := by
    rw [CommRingCat.ofHom_comp, Spec.map_comp, hβ']
  obtain ⟨γ, hc⟩ : ∃ γ : A →+* C, Spec.map (CommRingCat.ofHom γ) = c :=
    ⟨(Spec.preimage c).hom, by rw [CommRingCat.ofHom_hom, Spec.map_preimage]⟩

  obtain ⟨e, he1, he2⟩ := wc_spec_pullback_gamma_tensor A B C (β.comp (algebraMap A (Polynomial A)))
    γ (a ≫ Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) c hf hc
  letI : Algebra A B := (β.comp (algebraMap A (Polynomial A))).toAlgebra
  letI : Algebra A C := γ.toAlgebra

  obtain ⟨G, hG0, hGψ⟩ := wc_subring_closure_factor_of_lifts
    Γ(Limits.pullback (a ≫ Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) c, ⊤) F
  let r : (↥F) → TensorProduct A B C := fun k => e k.1
  have hr : ∀ g ∈ G, MvPolynomial.aeval r g = 0 := by
    intro g hg
    have h1 := key _ _ e.toRingHom (↥F) (fun k : (↥F) => (k : Γ(Limits.pullback (a ≫
      Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) c, ⊤))) g
    rw [hG0 g hg, map_zero] at h1
    exact h1

  obtain ⟨SA, SC, hdesc⟩ := wc_poly_tube_stage_finite_descent A B C β γ I D p ι hp hDp hιD hιp
    hsurj hker (↥F) r G hr

  haveI : IsNoetherianRing ↥(Int.castRingHom A).range := isNoetherianRing_range (Int.castRingHom A)
  obtain ⟨A0, hSA, -, hHA, hsepA, hnA, hlocA⟩ := wc_shens_noetherian_subring_local
    (↥(Int.castRingHom A).range) A (Int.castRingHom A).range.subtype SA
  haveI := hHA
  haveI := hnA
  haveI := hlocA
  have hu' : IsUnit (ℓ : ↥A0) :=
    isUnit_of_map_unit A0.subtype _ (by rw [map_natCast]; exact hℓA)

  obtain ⟨C0, hSC, hAC', hHC, hsepC, hnC, -⟩ := wc_shens_noetherian_subring_local
    (↥A0) C (γ.comp A0.subtype) SC
  haveI := hHC
  haveI := hnC
  have hAC : ∀ a ∈ A0, γ a ∈ C0 := fun a ha => hAC' ⟨a, ha⟩

  obtain ⟨E, _, pE, ε, hpE, hεp, t0, ht0G, ht0Λ⟩ := hdesc A0 C0 hAC hSA hSC

  have hring : (Polynomial.mapRingHom A0.subtype).comp (algebraMap ↥A0 (Polynomial ↥A0)) =
      (algebraMap A (Polynomial A)).comp A0.subtype := by
    refine RingHom.ext fun a => ?_
    simp [Polynomial.algebraMap_eq]
  have hsq : Spec.map (CommRingCat.ofHom (Polynomial.mapRingHom A0.subtype)) ≫
      Spec.map (CommRingCat.ofHom (algebraMap ↥A0 (Polynomial ↥A0))) =
      Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A))) ≫
      Spec.map (CommRingCat.ofHom A0.subtype) := by
    rw [← Spec.map_comp, ← Spec.map_comp, ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp, hring]
  have hx' : Spec.map (CommRingCat.ofHom (algebraMap ↥A0 (Polynomial ↥A0)))
      (Spec.map (CommRingCat.ofHom (Polynomial.mapRingHom A0.subtype)) x) =
      IsLocalRing.closedPoint ↥A0 := by
    rw [← Scheme.Hom.comp_apply, hsq, Scheme.Hom.comp_apply, hx]
    haveI : IsLocalHom (CommRingCat.Hom.hom (CommRingCat.ofHom A0.subtype)) := hlocA
    exact Spec_closedPoint

  obtain ⟨B', _, _, _, Λ', _, _, W'', φ', a', e', hinit', haff', hφ', hφa', hlim', he', hpt'⟩ :=
    wc_et_geom_strict_henselization (Spec.map (CommRingCat.ofHom (Polynomial.mapRingHom A0.subtype)) x)
  have hd' : wcHalShData (Spec.map (CommRingCat.ofHom (Polynomial.mapRingHom A0.subtype)) x)
      B' Λ' W'' φ' a' := ⟨hinit', haff', hφ', hφa', hlim', e', he', hpt'⟩

  obtain ⟨u, σ, hu, hσp, hσε⟩ := wc_shens_poly_stage_lift (Polynomial ↥A0) (Polynomial A)
    (Polynomial.mapRingHom A0.subtype) x B Λ W' φ a hd B' Λ' W'' φ' a' hd' E pE hpE ε
    (by rw [hpa]; exact hεp)

  let γ0 : ↥A0 →+* ↥C0 := (γ.comp A0.subtype).codRestrict C0 (fun a => hAC a a.2)
  have h₁ : (a ≫ Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) ≫
      Spec.map (CommRingCat.ofHom A0.subtype) =
      u ≫ (a' ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥A0 (Polynomial ↥A0)))) := by
    rw [Category.assoc, ← hsq, ← Category.assoc a, ← hu, Category.assoc]
  have hγ0 : γ.comp A0.subtype = C0.subtype.comp γ0 := RingHom.ext fun _ => rfl
  have h₂ : c ≫ Spec.map (CommRingCat.ofHom A0.subtype) =
      Spec.map (CommRingCat.ofHom C0.subtype) ≫ Spec.map (CommRingCat.ofHom γ0) := by
    rw [← hc, ← Spec.map_comp, ← Spec.map_comp, ← CommRingCat.ofHom_comp,
      ← CommRingCat.ofHom_comp, hγ0]

  have hf' : Spec.map (CommRingCat.ofHom ((Spec.preimage a').hom.comp
      (algebraMap ↥A0 (Polynomial ↥A0)))) =
      a' ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥A0 (Polynomial ↥A0))) := by
    rw [CommRingCat.ofHom_comp, Spec.map_comp, CommRingCat.ofHom_hom, Spec.map_preimage]
  obtain ⟨e₁, he₁1, he₁2⟩ := wc_spec_pullback_gamma_tensor (↥A0) B' (↥C0)
    ((Spec.preimage a').hom.comp (algebraMap ↥A0 (Polynomial ↥A0))) γ0
    (a' ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥A0 (Polynomial ↥A0))))
    (Spec.map (CommRingCat.ofHom γ0)) hf' rfl

  letI : Algebra ↥A0 E := (pE.comp (algebraMap ↥A0 (Polynomial ↥A0))).toAlgebra
  letI : Algebra ↥A0 B' := ((Spec.preimage a').hom.comp (algebraMap ↥A0 (Polynomial ↥A0))).toAlgebra
  letI : Algebra ↥A0 ↥C0 := γ0.toAlgebra
  let σA : E →ₐ[↥A0] B' :=
    { toRingHom := σ
      commutes' := fun r0 => RingHom.congr_fun hσp (algebraMap ↥A0 (Polynomial ↥A0) r0) }
  let Φ' := Algebra.TensorProduct.map σA (AlgHom.id ↥A0 ↥C0)

  let Λ0 : TensorProduct ↥A0 E ↥C0 →+ TensorProduct A B C :=
    (e.toRingHom.toAddMonoidHom.comp
      (Limits.pullback.map (a ≫ Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) c
        (a' ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥A0 (Polynomial ↥A0))))
        (Spec.map (CommRingCat.ofHom γ0)) u (Spec.map (CommRingCat.ofHom C0.subtype))
        (Spec.map (CommRingCat.ofHom A0.subtype)) h₁ h₂).appTop.hom.toAddMonoidHom).comp
      (e₁.symm.toRingHom.toAddMonoidHom.comp Φ'.toRingHom.toAddMonoidHom)
  have hΛ : ∀ (y : E) (z : ↥C0), Λ0 (y ⊗ₜ z) = ε y ⊗ₜ (z : C) := by
