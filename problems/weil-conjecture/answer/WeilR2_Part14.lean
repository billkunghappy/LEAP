    have hsepQ := crux y.asIdeal hcomap
    let σ₁ : (Spec (.of (Polynomial A'))).residueField y ≃+* y.asIdeal.ResidueField :=
      IsLocalRing.ResidueField.mapEquiv
        (Spec.stalkIso (.of (Polynomial A')) y).commRingCatIsoToRingEquiv
    exact transport _ _ σ₁.symm hsepQ
  have hfac : ∀ {Y Y' : Scheme.{u}} (p : Y' ⟶ Y) (y' : Y') (y : Y), p y' = y →
      ∃ ι : Spec (.of (AlgebraicClosure (Y'.residueField y'))) ⟶
