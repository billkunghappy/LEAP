      haveI : IsFiltered (ULiftHom.{u+1} (CostructuredArrow G.op Y)) :=
        IsFiltered.of_equivalence (ULiftHom.equiv (C := CostructuredArrow G.op Y))
      haveI : HasExactColimitsOfShape (ULiftHom.{u+1} (CostructuredArrow G.op Y))
          AddCommGrpCat.{u+1} := AB5OfSize.ofShape (ULiftHom.{u+1} (CostructuredArrow G.op Y))
      haveI : HasExactColimitsOfShape (CostructuredArrow G.op Y) AddCommGrpCat.{u+1} :=
