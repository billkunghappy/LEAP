        ((Abelian.Ext.mk₀ (ε W)).comp (Abelian.Ext.mapExactFunctor (wcSliceRes S ℓ W) β)
          (zero_add q)).comp
          (Abelian.Ext.mk₀ ((wcSliceRes S ℓ W).map (wcHMConst S ℓ c))) (add_zero q) :=
      (Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ _).symm
    rw [e1, h3, h3, hs']
  · intro q W W' b Db hDb β
    rw [AddEquiv.ofBijective_apply, AddEquiv.ofBijective_apply, hΘ₀, hΘ₀]
