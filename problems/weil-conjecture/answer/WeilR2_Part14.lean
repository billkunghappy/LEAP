      exact hmul _ _ _ _ hu hv
    let m : TensorProduct S (wcKummerEigDom (σC 1) c) (wcKummerEigDom (σC 1) d) →ₗ[S]
        wcKummerEigDom (σC 1) (c * d) := LinearMap.codRestrict _ (Submodule.mulMap _ _) hle
    have hm : ∀ u v, (m (u ⊗ₜ[S] v) : C) = (u : C) * v := by
      intro u v
