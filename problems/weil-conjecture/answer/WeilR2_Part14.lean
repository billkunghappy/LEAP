theorem wc_fet_ext_generic_reduction_of_unit : (∀ (ℓ : ℕ), ℓ.Prime → ∀ (A₀ : Type u) [CommRing A₀] [IsDomain A₀] [IsIntegrallyClosed A₀] [IsNoetherianRing A₀], IsUnit (ℓ : A₀) → ∀ (ζ : A₀), IsPrimitiveRoot ζ ℓ → ∀ (X : Scheme.{u}) [CompactSpace X] [QuasiSeparatedSpace X] (f : X ⟶ Spec (.of A₀)) [Smooth f] (σ : Spec (.of A₀) ⟶ X) (hσ : σ ≫ f = 𝟙 _), (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (z : Spec (.of Ω) ⟶ Spec (.of A₀)), ConnectedSpace ↥(Limits.pullback f z)) → ∀ (P : Scheme.{u}) (p : P ⟶ Limits.pullback f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) (α : ZMod ℓ → (P ⟶ P)), wcFetTorsor p ℓ α → (∃ r : Spec (.of (FractionRing A₀)) ⟶ P, r ≫ p = Limits.pullback.lift (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))) ≫ σ) (𝟙 _) (by rw [Category.assoc, hσ, Category.comp_id, Category.id_comp])) → ∃ (Y : Scheme.{u}) (q : Y ⟶ X) (β : ZMod ℓ → (Y ⟶ Y)) (i : P ⟶ Y), wcFetTorsor q ℓ β ∧ IsPullback i p q (Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))))) → ∀ (ℓ : ℕ), ℓ.Prime → ∀ (A : Type u) [CommRing A] [IsDomain A] [IsIntegrallyClosed A] (Λe : Finset A → Subring A), Monotone Λe → (∀ S, ∀ a ∈ S, a ∈ Λe S) → (∀ S, IsNoetherianRing ↥(Λe S)) → (∀ S, IsIntegrallyClosed ↥(Λe S)) → (∀ S, IsUnit (ℓ : ↥(Λe S))) → (∀ S, ∃ ζ : ↥(Λe S), IsPrimitiveRoot ζ ℓ) → ∀ (L : Type u) [Field L] [IsAlgClosed L] (j : A →+* L), Function.Injective j → (∀ y : L, ∃ a₁ b₁ : A, j b₁ ≠ 0 ∧ y * j b₁ = j a₁) → ∀ (X : Scheme.{u}) [IsAffine X] (f : X ⟶ Spec (.of A)) [Smooth f] (σ : Spec (.of A) ⟶ X), σ ≫ f = 𝟙 _ → (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (z : Spec (.of Ω) ⟶ Spec (.of A)), ConnectedSpace ↥(Limits.pullback f z)) → ∀ (P : Scheme.{u}) (p : P ⟶ Limits.pullback f (Spec.map (CommRingCat.ofHom j))) (α : ZMod ℓ → (P ⟶ P)), wcFetTorsor p ℓ α → ∃ (Y : Scheme.{u}) (q : Y ⟶ X) (β : ZMod ℓ → (Y ⟶ Y)) (i : P ⟶ Y), wcFetTorsor q ℓ β ∧ IsPullback i p q (Limits.pullback.fst f (Spec.map (CommRingCat.ofHom j))) :=
