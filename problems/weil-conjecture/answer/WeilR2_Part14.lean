theorem wc_et_coh_const_prime_devissage : ∀ (T : Scheme.{u}) (m : ℕ), m ≠ 0 → (∀ p : ℕ, p.Prime → p ∣ m → Nat.card (wcEtCoh T p 0) = p ∧ ∀ q : ℕ, 1 ≤ q → Subsingleton (wcEtCoh T p q)) → Nat.card (wcEtCoh T m 0) = m ∧ ∀ q : ℕ, 1 ≤ q → Subsingleton (wcEtCoh T m q) :=
by
  intro T
  classical
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1}) := HasExt.standard _

  have hmid : ∀ (X : Sheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1})
      (S : ShortComplex (Sheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1})), S.ShortExact →
      (∀ n : ℕ, 1 ≤ n → Subsingleton (Abelian.Ext X S.X₁ n)) →
      (∀ n : ℕ, 1 ≤ n → Subsingleton (Abelian.Ext X S.X₃ n)) →
      (∀ n : ℕ, 1 ≤ n → Subsingleton (Abelian.Ext X S.X₂ n)) ∧
        Nat.card (Abelian.Ext X S.X₂ 0) =
          Nat.card (Abelian.Ext X S.X₃ 0) * Nat.card (Abelian.Ext X S.X₁ 0) := by
    intro X S hS h1 h3
    refine ⟨?_, ?_⟩
    · intro n hn
      haveI := h1 n hn
      haveI := h3 n hn
      let ψ : Abelian.Ext X S.X₂ n →+ Abelian.Ext X S.X₃ n :=
        (Abelian.Ext.mk₀ S.g).postcomp X (add_zero n)
      let φ : Abelian.Ext X S.X₁ n →+ Abelian.Ext X S.X₂ n :=
        (Abelian.Ext.mk₀ S.f).postcomp X (add_zero n)
      have hex : ∀ b, ψ b = 0 → ∃ a, φ a = b := fun b hb =>
        Abelian.Ext.covariant_sequence_exact₂ X hS b hb
      have hz : ∀ b : Abelian.Ext X S.X₂ n, b = 0 := by
        intro b
        obtain ⟨a, ha⟩ := hex b (Subsingleton.elim _ _)
        rw [← ha, Subsingleton.elim a 0, map_zero]
      exact ⟨fun a b => by rw [hz a, hz b]⟩
    · let ψ : Abelian.Ext X S.X₂ 0 →+ Abelian.Ext X S.X₃ 0 :=
        (Abelian.Ext.mk₀ S.g).postcomp X (add_zero 0)
      let φ : Abelian.Ext X S.X₁ 0 →+ Abelian.Ext X S.X₂ 0 :=
        (Abelian.Ext.mk₀ S.f).postcomp X (add_zero 0)
      haveI := hS.mono_f
      have hφinj : Function.Injective φ := by
        intro a b hab
        obtain ⟨a', rfl⟩ := (Abelian.Ext.mk₀_bijective X S.X₁).2 a
        obtain ⟨b', rfl⟩ := (Abelian.Ext.mk₀_bijective X S.X₁).2 b
        have e1 : Abelian.Ext.mk₀ (a' ≫ S.f) = Abelian.Ext.mk₀ (b' ≫ S.f) := by
          rw [← Abelian.Ext.mk₀_comp_mk₀, ← Abelian.Ext.mk₀_comp_mk₀]
          exact hab
        have e2 := (Abelian.Ext.mk₀_bijective X S.X₂).1 e1
        rw [cancel_mono] at e2
        rw [e2]
      have hψsurj : Function.Surjective ψ := by
        intro x₃
        haveI := h1 1 le_rfl
        obtain ⟨x₂, hx₂⟩ := Abelian.Ext.covariant_sequence_exact₃ X hS x₃ (zero_add 1)
          (Subsingleton.elim _ _)
        exact ⟨x₂, hx₂⟩
      have hker : ψ.ker = φ.range := by
        ext x
        rw [AddMonoidHom.mem_ker, AddMonoidHom.mem_range]
        constructor
        · intro hx
          exact Abelian.Ext.covariant_sequence_exact₂ X hS x hx
        · rintro ⟨a, rfl⟩
          obtain ⟨a', rfl⟩ := (Abelian.Ext.mk₀_bijective X S.X₁).2 a
          show ((Abelian.Ext.mk₀ a').comp (Abelian.Ext.mk₀ S.f) (add_zero 0)).comp
            (Abelian.Ext.mk₀ S.g) (add_zero 0) = 0
          rw [Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_comp_mk₀, Category.assoc, S.zero,
            Limits.comp_zero, Abelian.Ext.mk₀_zero]
      rw [AddSubgroup.card_eq_card_quotient_mul_card_addSubgroup ψ.ker,
        Nat.card_congr (QuotientAddGroup.quotientKerEquivOfSurjective ψ hψsurj).toEquiv, hker,
        ← Nat.card_congr (AddMonoidHom.ofInjective hφinj).toEquiv]

  have hzero : ∀ (X Z : Sheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1}),
      Limits.IsZero Z → (∀ n, Subsingleton (Abelian.Ext X Z n)) ∧
        Nat.card (Abelian.Ext X Z 0) = 1 := by
    intro X Z hZ
    have hx : ∀ n, ∀ x : Abelian.Ext X Z n, x = 0 := by
      intro n x
      have := Abelian.Ext.comp_mk₀_id x
      rw [hZ.eq_of_tgt (𝟙 _) 0, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero] at this
