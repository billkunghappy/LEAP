        wX ≫ j = (wcQmWs (Limits.pullback.fst pb (wcQmSp A)) j z).ι ≫
          Limits.pullback.fst pb (wcQmSp A) :=
      ⟨IsOpenImmersion.lift j _ hWr, IsOpenImmersion.lift_fac _ _ _⟩
    have hτc : b₀ ≫ a = (s ≫ wX) ≫ j := by rw [Category.assoc, hwX, hkey]
    obtain ⟨τ, hτ1, hτ2⟩ : ∃ τ : T ⟶ Limits.pullback a j,
        τ ≫ Limits.pullback.fst a j = b₀ ∧ τ ≫ Limits.pullback.snd a j = s ≫ wX :=
      ⟨Limits.pullback.lift _ _ hτc, Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
    have hw0c : τ ≫ Limits.pullback.fst a j ≫ a ≫ pb =
        (s ≫ (wcQmWs (Limits.pullback.fst pb (wcQmSp A)) j z).ι ≫
          Limits.pullback.snd pb (wcQmSp A)) ≫ wcQmSp A := by
      rw [reassoc_of% hτ1, reassoc_of% hkey]
      simp only [Category.assoc]
      rw [Limits.pullback.condition]
    obtain ⟨w₀, hw01, hw02⟩ : ∃ w₀ : T ⟶ Limits.pullback (Limits.pullback.fst a j ≫ a ≫ pb) (wcQmSp A),
        w₀ ≫ Limits.pullback.fst (Limits.pullback.fst a j ≫ a ≫ pb) (wcQmSp A) = τ ∧
        w₀ ≫ Limits.pullback.snd (Limits.pullback.fst a j ≫ a ≫ pb) (wcQmSp A) =
          s ≫ (wcQmWs (Limits.pullback.fst pb (wcQmSp A)) j z).ι ≫
            Limits.pullback.snd pb (wcQmSp A) :=
      ⟨Limits.pullback.lift _ _ hw0c, Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
    have he : w₀ ≫ wk = s := by
      rw [← cancel_mono (wcQmWs (Limits.pullback.fst pb (wcQmSp A)) j z).ι]
      apply Limits.pullback.hom_ext
      · simp only [Category.assoc]
        rw [hwk1, reassoc_of% hw01, reassoc_of% hτ2, hwX]
      · simp only [Category.assoc]
        rw [hwk2, hw02]
    refine ⟨w₀, ?_, ?_⟩
    · intro l
      apply Limits.pullback.hom_ext
      · rw [← cancel_mono (ν l).hom]
        apply Limits.pullback.hom_ext
        · simp only [Category.assoc]
          rw [hnK l, reassoc_of% hw01, reassoc_of% hτ1, hb₀' l]
        · simp only [Category.assoc]
          rw [hν2 l, Limits.pullback.condition, reassoc_of% (hn1 l), reassoc_of% he,
            reassoc_of% (ha l)]
      · rw [Category.assoc, hn1 l, he, ha l]
    · intro w₁ hw₁
      have h1 : w₁ ≫ wk = s := by rw [← hn1 l₀, ← Category.assoc, hw₁ l₀, ha l₀]
      apply Limits.pullback.hom_ext
      · apply Limits.pullback.hom_ext
        · rw [hw01, hτ1]
          refine hbu _ (fun l => ?_)
          simp only [Category.assoc]
          rw [← hnK l, reassoc_of% (hw₁ l)]
        · rw [← cancel_mono j]
          simp only [Category.assoc]
          rw [← hwk1, reassoc_of% h1, reassoc_of% he]
      · rw [← hwk2, reassoc_of% h1, reassoc_of% he]
  ·
    intro l rr hrr1 hrr2 σ' hσ1 hσ2
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, hrr1, hnK l, hσ1]
    · rw [← cancel_mono j]
      simp only [Category.assoc]
      rw [hrr2, reassoc_of% (hn1 l), Scheme.homOfLE_ι_assoc, hwk1, reassoc_of% hσ2]

