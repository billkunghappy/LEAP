        (Scheme.smallEtaleTopology X) (wcEtBaseChange g) := by
      intro X B g
      constructor
      intro V S hS
      change S ∈ Scheme.smallGrothendieckTopology @Etale B V at hS
      rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale B
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hS
      have hS' := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale B
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mp hS
      apply hjs
      intro v
      obtain ⟨W, a, w, ha, -, hw⟩ := hS' (Limits.pullback.fst V.hom g v)
      refine ⟨(wcEtBaseChange g).obj W, (wcEtBaseChange g).map a,
        Sieve.image_mem_functorPushforward (wcEtBaseChange g) S ha, ?_⟩
      have h0 : (Limits.pullback.fst W.hom g ≫ a.left) ≫ V.hom = Limits.pullback.snd W.hom g ≫ g := by
        rw [Category.assoc, MorphismProperty.Over.w a]
        exact Limits.pullback.condition
      let m : Limits.pullback W.hom g ⟶ Limits.pullback V.hom g :=
        Limits.pullback.lift (Limits.pullback.fst W.hom g ≫ a.left) (Limits.pullback.snd W.hom g) h0
      have hmap : ((wcEtBaseChange g).map a).left = m := rfl
      have h1 : Limits.pullback.fst a.left (Limits.pullback.fst V.hom g) ≫ W.hom =
          (Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) ≫ Limits.pullback.snd V.hom g) ≫ g := by
        rw [← MorphismProperty.Over.w a, ← Category.assoc, Limits.pullback.condition, Category.assoc,
          Limits.pullback.condition, Category.assoc]
      let ψ : Limits.pullback a.left (Limits.pullback.fst V.hom g) ⟶ Limits.pullback W.hom g :=
        Limits.pullback.lift (Limits.pullback.fst a.left (Limits.pullback.fst V.hom g))
          (Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) ≫ Limits.pullback.snd V.hom g) h1
      have hψ : ψ ≫ m = Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) := by
        apply Limits.pullback.hom_ext
        · rw [Category.assoc, Limits.pullback.lift_fst, ← Category.assoc, Limits.pullback.lift_fst,
            Limits.pullback.condition]
        · rw [Category.assoc, Limits.pullback.lift_snd, Limits.pullback.lift_snd]
      obtain ⟨z, hz⟩ : ∃ z, Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) z = v := by
        have hv : (v : ↥(Limits.pullback V.hom g)) ∈
            Set.range (Limits.pullback.snd a.left (Limits.pullback.fst V.hom g)) := by
          rw [Scheme.Pullback.range_snd]
          exact ⟨w, hw⟩
        exact hv
      rw [hmap]
      exact ⟨ψ z, (Scheme.Hom.comp_apply ψ m z).symm.trans (by rw [hψ]; exact hz)⟩
    intro X B g
    let Φ := wcEtBaseChange g
    haveI h1 : Limits.PreservesFiniteLimits Φ := ⟨fun J _ _ =>
      haveI : Limits.PreservesLimitsOfShape J (wcEtBaseChange g ⋙ Scheme.Etale.forget X) :=
        Limits.preservesLimitsOfShape_of_natIso
          (NatIso.ofComponents (fun _ => Iso.refl _) (fun _ => rfl) :
            Scheme.Etale.forget B ⋙ Over.pullback g ≅ wcEtBaseChange g ⋙ Scheme.Etale.forget X)
      Limits.preservesLimitsOfShape_of_reflects_of_preserves (wcEtBaseChange g) (Scheme.Etale.forget X)⟩
    haveI := flat_of_preservesFiniteLimits Φ
    haveI : Φ.IsContinuous (Scheme.smallEtaleTopology B) (Scheme.smallEtaleTopology X) :=
      Functor.isContinuous_of_coverPreserving (compatiblePreservingOfFlat _ _) (hcov g)
    haveI := hlan Φ
    let adj0 := Functor.sheafPullbackConstruction.sheafAdjunctionContinuous Φ AddCommGrpCat.{u+1}
      (Scheme.smallEtaleTopology B) (Scheme.smallEtaleTopology X)
    let e : wcEtPush g ≅ Φ.sheafPushforwardContinuous AddCommGrpCat.{u+1}
        (Scheme.smallEtaleTopology B) (Scheme.smallEtaleTopology X) :=
      Functor.isoWhiskerRight (Φ.sheafPushforwardContinuousCompSheafToPresheafIso AddCommGrpCat.{u+1}
        (Scheme.smallEtaleTopology B) (Scheme.smallEtaleTopology X)).symm
        (presheafToSheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}) ≪≫
      Functor.associator _ _ _ ≪≫
      Functor.isoWhiskerLeft _ (asIso (sheafificationAdjunction (Scheme.smallEtaleTopology B)
        AddCommGrpCat.{u+1}).counit) ≪≫
      Functor.rightUnitor _
    let hTB : Limits.IsTerminal (⊤_ B.Etale) := Limits.terminalIsTerminal
    let hTX : Limits.IsTerminal (Φ.obj (⊤_ B.Etale)) := Limits.IsTerminal.isTerminalObj Φ _ hTB
    let a2 := ((constantSheafAdj (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1} hTB).comp adj0).ofNatIsoRight
      (Iso.refl _ : Φ.sheafPushforwardContinuous AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology B)
          (Scheme.smallEtaleTopology X) ⋙
        (sheafSections (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}).obj (Opposite.op (⊤_ B.Etale)) ≅
        (sheafSections (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj (Opposite.op (Φ.obj (⊤_ B.Etale))))
    let eL := a2.leftAdjointUniq (constantSheafAdj (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1} hTX)
    exact ⟨Functor.sheafPullbackConstruction.sheafPullback Φ AddCommGrpCat.{u+1}
        (Scheme.smallEtaleTopology B) (Scheme.smallEtaleTopology X), ⟨adj0.ofNatIsoRight e.symm⟩,
        Limits.comp_preservesFiniteLimits (sheafToPresheaf _ _)
          (Φ.op.lan ⋙ presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}),
        ⟨eL.app (AddCommGrpCat.of (ULift.{u+1} ℤ))⟩⟩

  have leray : ∀ {C D : Type (u+2)} [Category.{u+1} C] [Category.{u+1} D] [Abelian C] [Abelian D]
      (L : D ⥤ C) (R : C ⥤ D) [R.Additive] [L.Additive] [L.PreservesMonomorphisms] (adj : L ⊣ R)
      (X : C) (X' : D) (eL : L.obj X' ≅ X) (Λ : C) (I : InjectiveResolution Λ) (q : ℕ),
      Nonempty ((letI := HasExt.standard C; Abelian.Ext X Λ q) ≃
        (letI := HasDerivedCategory.standard D;
          ((DerivedCategory.singleFunctor D 0).obj X' ⟶
            (shiftFunctor (DerivedCategory D) (q : ℤ)).obj
              (DerivedCategory.Q.obj (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj
                I.cocomplex).extend ComplexShape.embeddingUpNat))))) := by
    intro C D _ _ _ _ L R _ _ _ adj X X' eL Λ I q
    letI := HasExt.standard C
    letI := HasDerivedCategory.standard D

    have transport : ∀ (Kx : CochainComplex C ℤ) (Ky : CochainComplex D ℤ)
        (ψ : ∀ i : ℤ, (X ⟶ Kx.X i) ≃+ (X' ⟶ Ky.X i)),
        (∀ (i j : ℤ) (f : X ⟶ Kx.X i), ψ j (f ≫ Kx.d i j) = ψ i f ≫ Ky.d i j) →
        ∀ n : ℤ, Nonempty (CochainComplex.HomComplex.CohomologyClass
            ((CochainComplex.singleFunctor C 0).obj X) Kx n ≃
          CochainComplex.HomComplex.CohomologyClass
            ((CochainComplex.singleFunctor D 0).obj X') Ky n) := by
      intro Kx Ky ψ hψ n
      let Ψ : ∀ k : ℤ, CochainComplex.HomComplex.Cochain ((CochainComplex.singleFunctor C 0).obj X) Kx k ≃+
          CochainComplex.HomComplex.Cochain ((CochainComplex.singleFunctor D 0).obj X') Ky k :=
        fun k => (CochainComplex.HomComplex.Cochain.fromSingleEquiv (X := X) (K := Kx) (zero_add k)).trans
          ((ψ k).trans (CochainComplex.HomComplex.Cochain.fromSingleEquiv (X := X') (K := Ky)
            (zero_add k)).symm)
      have hmk : ∀ (k : ℤ) (f : X ⟶ Kx.X k),
          Ψ k (CochainComplex.HomComplex.Cochain.fromSingleMk f (zero_add k)) =
            CochainComplex.HomComplex.Cochain.fromSingleMk (ψ k f) (zero_add k) := by
        intro k f
        simp only [Ψ, AddEquiv.trans_apply,
          CochainComplex.HomComplex.Cochain.fromSingleEquiv_fromSingleMk]
        rw [AddEquiv.symm_apply_eq, CochainComplex.HomComplex.Cochain.fromSingleEquiv_fromSingleMk]
      have hδ : ∀ (a b : ℤ)
          (β : CochainComplex.HomComplex.Cochain ((CochainComplex.singleFunctor C 0).obj X) Kx a),
          Ψ b (CochainComplex.HomComplex.δ a b β) = CochainComplex.HomComplex.δ a b (Ψ a β) := by
        intro a b β
        obtain ⟨f, rfl⟩ := CochainComplex.HomComplex.Cochain.fromSingleMk_surjective β a (zero_add a)
        rw [CochainComplex.HomComplex.Cochain.δ_fromSingleMk f (zero_add a) b b (zero_add b), hmk, hmk,
          CochainComplex.HomComplex.Cochain.δ_fromSingleMk _ (zero_add a) b b (zero_add b), hψ]
      let Θ : CochainComplex.HomComplex.Cocycle ((CochainComplex.singleFunctor C 0).obj X) Kx n ≃+
          CochainComplex.HomComplex.Cocycle ((CochainComplex.singleFunctor D 0).obj X') Ky n :=
        { toFun := fun z => CochainComplex.HomComplex.Cocycle.mk
            (Ψ n (z : CochainComplex.HomComplex.Cochain _ _ n)) (n + 1) rfl (by
              rw [← hδ, CochainComplex.HomComplex.Cocycle.δ_eq_zero, map_zero])
          invFun := fun z => CochainComplex.HomComplex.Cocycle.mk
            ((Ψ n).symm (z : CochainComplex.HomComplex.Cochain _ _ n)) (n + 1) rfl (by
              apply (Ψ (n + 1)).injective
              rw [hδ, AddEquiv.apply_symm_apply, CochainComplex.HomComplex.Cocycle.δ_eq_zero, map_zero])
          left_inv := fun z => by
            apply Subtype.ext
            exact (Ψ n).symm_apply_apply z.1
          right_inv := fun z => by
            apply Subtype.ext
            exact (Ψ n).apply_symm_apply z.1
          map_add' := fun z w => by
            apply Subtype.ext
            exact (Ψ n).map_add z.1 w.1 }
      have hΘ : ∀ z, (Θ z : CochainComplex.HomComplex.Cochain _ _ n) = Ψ n z := fun z => rfl
      have hmap : AddSubgroup.map (Θ : _ →+ _)
          (CochainComplex.HomComplex.coboundaries ((CochainComplex.singleFunctor C 0).obj X) Kx n) =
          CochainComplex.HomComplex.coboundaries ((CochainComplex.singleFunctor D 0).obj X') Ky n := by
        ext y
        rw [AddSubgroup.mem_map]
        constructor
        · rintro ⟨x, hx, rfl⟩
          rw [CochainComplex.HomComplex.mem_coboundaries_iff x (n - 1) (by omega)] at hx
          obtain ⟨β, hβ⟩ := hx
          rw [CochainComplex.HomComplex.mem_coboundaries_iff _ (n - 1) (by omega)]
          refine ⟨Ψ (n - 1) β, ?_⟩
          rw [← hδ, hβ]
          rfl
        · intro hy
          rw [CochainComplex.HomComplex.mem_coboundaries_iff _ (n - 1) (by omega)] at hy
          obtain ⟨β', hβ'⟩ := hy
          refine ⟨Θ.symm y, ?_, Θ.apply_symm_apply y⟩
          rw [CochainComplex.HomComplex.mem_coboundaries_iff _ (n - 1) (by omega)]
          refine ⟨(Ψ (n - 1)).symm β', ?_⟩
          apply (Ψ n).injective
          rw [hδ, AddEquiv.apply_symm_apply, hβ', ← hΘ, Θ.apply_symm_apply]
      exact ⟨(QuotientAddGroup.congr _ _ Θ hmap).toEquiv⟩

    let pre : ∀ Z : C, (X ⟶ Z) ≃+ (L.obj X' ⟶ Z) := fun Z =>
      { toFun := fun f => eL.hom ≫ f
        invFun := fun g => eL.inv ≫ g
        left_inv := fun f => by simp
        right_inv := fun g => by simp
        map_add' := fun f g => Preadditive.comp_add _ _ _ _ _ _ }
    let φ : ∀ k : ℕ, (X ⟶ I.cocomplex.X k) ≃+ (X' ⟶ R.obj (I.cocomplex.X k)) :=
      fun k => (pre _).trans (adj.homAddEquiv X' (I.cocomplex.X k))
    have hφ : ∀ (i j : ℕ) (f : X ⟶ I.cocomplex.X i),
        φ j (f ≫ I.cocomplex.d i j) = φ i f ≫ R.map (I.cocomplex.d i j) := by
      intro i j f
      show adj.homAddEquiv _ _ (eL.hom ≫ f ≫ I.cocomplex.d i j) =
        adj.homAddEquiv _ _ (eL.hom ≫ f) ≫ R.map (I.cocomplex.d i j)
      rw [Adjunction.homAddEquiv_apply, Adjunction.homAddEquiv_apply, ← Category.assoc,
        Adjunction.homEquiv_naturality_right]

    let χ : ∀ o : Option ℕ, (X ⟶ HomologicalComplex.extend.X I.cocomplex o) ≃+
        (X' ⟶ HomologicalComplex.extend.X ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj
          I.cocomplex) o) := fun o =>
      match o with
      | some k => φ k
      | none =>
        { toFun := fun _ => 0
          invFun := fun _ => 0
          left_inv := fun f => (Limits.isZero_zero C).eq_of_tgt _ _
          right_inv := fun g => (Limits.isZero_zero D).eq_of_tgt _ _
          map_add' := fun _ _ => (add_zero 0).symm }
    have hχ : ∀ (o o' : Option ℕ) (f : X ⟶ HomologicalComplex.extend.X I.cocomplex o),
        χ o' (f ≫ HomologicalComplex.extend.d I.cocomplex o o') =
          χ o f ≫ HomologicalComplex.extend.d ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj
            I.cocomplex) o o' := by
      intro o o' f
      cases o with
      | none =>
        show χ o' (f ≫ 0) = χ none f ≫ 0
        rw [Limits.comp_zero, Limits.comp_zero, map_zero]
      | some i =>
        cases o' with
        | none =>
          show χ none (f ≫ 0) = χ (some i) f ≫ 0
          rw [Limits.comp_zero, Limits.comp_zero, map_zero]
        | some j => exact hφ i j f
    obtain ⟨e2⟩ := transport I.cochainComplex
      (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).extend
        ComplexShape.embeddingUpNat)
      (fun i => χ (ComplexShape.embeddingUpNat.r i)) (fun i j f => hχ _ _ f) (q : ℤ)

    have hinjo : ∀ o : Option ℕ, Injective (HomologicalComplex.extend.X
        ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex) o) := by
      intro o
      cases o with
      | none => exact (Limits.isZero_zero D).injective
      | some k => exact Injective.injective_of_adjoint adj (I.cocomplex.X k)
    haveI hge : CochainComplex.IsStrictlyGE (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj
        I.cocomplex).extend ComplexShape.embeddingUpNat) 0 := by
      rw [CochainComplex.isStrictlyGE_iff]
      intro i hi
      apply HomologicalComplex.isZero_extend_X
      intro k hk
      rw [ComplexShape.embeddingUpNat_f] at hk
      omega
    haveI := CochainComplex.isStrictlyGE_shift (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj
        I.cocomplex).extend ComplexShape.embeddingUpNat) 0 (q : ℤ) (-(q : ℤ)) (by ring)
    haveI : ∀ n : ℤ, Injective (((shiftFunctor (CochainComplex D ℤ) (q : ℤ)).obj
        (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).extend
          ComplexShape.embeddingUpNat)).X n) := by
      intro n
      rw [CochainComplex.shiftFunctor_obj_X']
      exact hinjo _
    haveI := CochainComplex.isKInjective_of_injective ((shiftFunctor (CochainComplex D ℤ) (q : ℤ)).obj
        (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).extend
          ComplexShape.embeddingUpNat)) (-(q : ℤ))
    let c1 := (CochainComplex.HomComplex.CohomologyClass.homAddEquiv
      (K := (CochainComplex.singleFunctor D 0).obj X')
      (L := ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).extend
        ComplexShape.embeddingUpNat) (n := (q : ℤ))).toEquiv
    let c2 := Equiv.ofBijective _ (CochainComplex.IsKInjective.Qh_map_bijective
      ((HomotopyCategory.quotient D (ComplexShape.up ℤ)).obj ((CochainComplex.singleFunctor D 0).obj X'))
      ((shiftFunctor (CochainComplex D ℤ) (q : ℤ)).obj
        (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).extend
          ComplexShape.embeddingUpNat)))
    let c3 := Iso.homCongr ((DerivedCategory.quotientCompQhIso D).app
        ((CochainComplex.singleFunctor D 0).obj X'))
      ((DerivedCategory.quotientCompQhIso D).app ((shiftFunctor (CochainComplex D ℤ) (q : ℤ)).obj
        (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).extend
          ComplexShape.embeddingUpNat)))
    let c4 := Iso.homCongr ((DerivedCategory.singleFunctorIsoCompQ D 0).app X').symm
      ((DerivedCategory.Q.commShiftIso (q : ℤ)).app
        (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).extend
          ComplexShape.embeddingUpNat))

    exact ⟨I.extEquivCohomologyClass.trans (e2.trans (c1.trans (c2.trans (c3.trans c4))))⟩

  intro M Y G m I q
  obtain ⟨L, ⟨adj⟩, hL, ⟨eL⟩⟩ := hadj G
  haveI := adj.rightAdjoint_preservesLimits
  haveI : (wcEtPush G).Additive := Functor.additive_of_preserves_binary_products _
  haveI : L.Additive := adj.left_adjoint_additive
  haveI : L.PreservesMonomorphisms := inferInstance
  exact leray L (wcEtPush G) adj _ _ eL _ I q

theorem wc_qm_inv_adjunction {X B : Scheme.{u}} (g : X ⟶ B) :
    Nonempty (wcQmInv g ⊣ wcEtPush g) ∧ Limits.PreservesFiniteLimits (wcQmInv g) ∧
      Nonempty ((wcQmInv g).obj ((constantSheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ))) ≅
        (constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} ℤ))) :=
by

  have hlan : ∀ {C D : Type (u+1)} [Category.{u} C] [Category.{u} D] [Limits.HasFiniteLimits C]
      (G : C ⥤ D) [Limits.PreservesFiniteLimits G],
      Limits.PreservesFiniteLimits (G.op.lan : (Cᵒᵖ ⥤ AddCommGrpCat.{u+1}) ⥤ (Dᵒᵖ ⥤ AddCommGrpCat.{u+1})) := by
    intro C D _ _ _ G _
    have wc_lan_eval_iso : ∀ {C D : Type (u+1)} [Category.{u} C] [Category.{u} D] (L : C ⥤ D)
        [∀ F : C ⥤ AddCommGrpCat.{u+1}, L.HasPointwiseLeftKanExtension F]
        [∀ F : C ⥤ AddCommGrpCat.{u+1}, L.HasLeftKanExtension F] (Y : D),
        Nonempty ((L.lan : (C ⥤ AddCommGrpCat.{u+1}) ⥤ (D ⥤ AddCommGrpCat.{u+1})) ⋙
            (evaluation D AddCommGrpCat.{u+1}).obj Y ≅
          (Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj (CostructuredArrow.proj L Y) ⋙
            Limits.colim) := by
      intro C D _ _ L _ _ Y
      refine ⟨NatIso.ofComponents (fun F => L.leftKanExtensionObjIsoColimit F Y) ?_⟩
      intro F₁ F₂ φ
      have hnat : ∀ j : CostructuredArrow L Y,
          (L.leftKanExtension F₁).map j.hom ≫ (L.lan.map φ).app Y =
          (L.lan.map φ).app (L.obj j.left) ≫ (L.leftKanExtension F₂).map j.hom :=
        fun j => (L.lan.map φ).naturality j.hom
      have hfac : ∀ j : CostructuredArrow L Y,
          (L.leftKanExtensionUnit F₁).app j.left ≫ (L.lan.map φ).app (L.obj j.left) =
          φ.app j.left ≫ (L.leftKanExtensionUnit F₂).app j.left := fun j =>
        Functor.descOfIsLeftKanExtension_fac_app (L.leftKanExtension F₁)
          (L.leftKanExtensionUnit F₁) (L.leftKanExtension F₂) (φ ≫ L.leftKanExtensionUnit F₂) j.left
      refine (Iso.inv_comp_eq _).1 ?_
      apply Limits.colimit.hom_ext
      intro j
      have key : (L.leftKanExtensionUnit F₁).app j.left ≫ (L.leftKanExtension F₁).map j.hom ≫
          (L.lan.map φ).app Y ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom =
          φ.app j.left ≫ Limits.colimit.ι (CostructuredArrow.proj L Y ⋙ F₂) j :=
        calc (L.leftKanExtensionUnit F₁).app j.left ≫ (L.leftKanExtension F₁).map j.hom ≫
              (L.lan.map φ).app Y ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom
            = (L.leftKanExtensionUnit F₁).app j.left ≫ ((L.leftKanExtension F₁).map j.hom ≫
              (L.lan.map φ).app Y) ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom :=
              congrArg ((L.leftKanExtensionUnit F₁).app j.left ≫ ·) (Category.assoc _ _ _).symm
          _ = (L.leftKanExtensionUnit F₁).app j.left ≫ ((L.lan.map φ).app (L.obj j.left) ≫
              (L.leftKanExtension F₂).map j.hom) ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom :=
              congrArg (fun k => (L.leftKanExtensionUnit F₁).app j.left ≫ k ≫
                (L.leftKanExtensionObjIsoColimit F₂ Y).hom) (hnat j)
          _ = ((L.leftKanExtensionUnit F₁).app j.left ≫ (L.lan.map φ).app (L.obj j.left)) ≫
              (L.leftKanExtension F₂).map j.hom ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom :=
              (congrArg ((L.leftKanExtensionUnit F₁).app j.left ≫ ·) (Category.assoc _ _ _)).trans
                (Category.assoc _ _ _).symm
          _ = (φ.app j.left ≫ (L.leftKanExtensionUnit F₂).app j.left) ≫
              (L.leftKanExtension F₂).map j.hom ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom :=
              congrArg (· ≫ (L.leftKanExtension F₂).map j.hom ≫
                (L.leftKanExtensionObjIsoColimit F₂ Y).hom) (hfac j)
          _ = φ.app j.left ≫ ((L.leftKanExtensionUnit F₂).app j.left ≫
              (L.leftKanExtension F₂).map j.hom ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom) :=
              Category.assoc _ _ _
          _ = φ.app j.left ≫ Limits.colimit.ι (CostructuredArrow.proj L Y ⋙ F₂) j :=
              congrArg (φ.app j.left ≫ ·) (Functor.ι_leftKanExtensionObjIsoColimit_hom L F₂ Y j)
      erw [Functor.ι_leftKanExtensionObjIsoColimit_inv_assoc, Limits.ι_colimMap]
      exact key
    constructor
    intro J _ _
    apply Limits.preservesLimitsOfShape_of_evaluation
    intro Y
    obtain ⟨θ⟩ := wc_lan_eval_iso G.op Y
    haveI := (flat_of_preservesFiniteLimits G).cofiltered Y.unop
    haveI : IsFiltered (CostructuredArrow G.op Y) :=
      IsFiltered.of_equivalence (structuredArrowOpEquivalence G Y.unop)
    haveI : IsFiltered (ULiftHom.{u+1} (CostructuredArrow G.op Y)) :=
      IsFiltered.of_equivalence (ULiftHom.equiv (C := CostructuredArrow G.op Y))
    haveI : HasExactColimitsOfShape (ULiftHom.{u+1} (CostructuredArrow G.op Y))
        AddCommGrpCat.{u+1} := AB5OfSize.ofShape (ULiftHom.{u+1} (CostructuredArrow G.op Y))
    haveI : HasExactColimitsOfShape (CostructuredArrow G.op Y) AddCommGrpCat.{u+1} :=
      @HasExactColimitsOfShape.of_domain_equivalence AddCommGrpCat.{u+1} _
        (ULiftHom.{u+1} (CostructuredArrow G.op Y)) (CostructuredArrow G.op Y) _ _
        (ULiftHom.equiv (C := CostructuredArrow G.op Y)).symm _ _
    exact Limits.preservesLimitsOfShape_of_natIso θ.symm

  have hjs : ∀ (Y : Scheme.{u}) (V : Y.Etale) (S : Sieve V), (∀ v : V.left, ∃ (V₁ : Y.Etale)
