import WeilR2_Part13
set_option maxHeartbeats 4000000

open CategoryTheory AlgebraicGeometry

theorem wc_et_coh_transfer_of_shens_fibres : ∀ (E S P : Scheme.{u}) (f : E ⟶ S) [IsAffineHom f] [Surjective f] (pr : P ⟶ S) (m : ℕ), m ≠ 0 → (∀ (p : P) (C : Type u) [CommRing C] [HenselianLocalRing C] [IsSepClosed (IsLocalRing.ResidueField C)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt P p)) (Scheme.Etale.forget P)) (φ : ∀ l, Spec (.of C) ⟶ (W'.obj l).right.left) (ap : Spec (.of C) ⟶ P), wcHalShData p C Λ W' φ ap → Nat.card (wcEtCoh (Limits.pullback f (ap ≫ pr)) m 0) = m ∧ ∀ q : ℕ, 1 ≤ q → Subsingleton (wcEtCoh (Limits.pullback f (ap ≫ pr)) m q)) → ∀ q : ℕ, Nonempty (wcEtCoh (Limits.pullback f pr) m q ≃ wcEtCoh P m q) :=
by
  classical
  intro E S P f _ _ pr m hm H q

  haveI hgaff : IsAffineHom (Limits.pullback.snd f pr) :=
    MorphismProperty.of_isPullback (P := @IsAffineHom) (IsPullback.of_hasPullback f pr) inferInstance
  have hgsurj : Surjective (Limits.pullback.snd f pr) :=
    MorphismProperty.of_isPullback (P := @Surjective) (IsPullback.of_hasPullback f pr) inferInstance

  obtain ⟨L, ⟨adj⟩, hL, ⟨eZ⟩⟩ := wc_et_push_left_adjoint (Limits.pullback.snd f pr)
  haveI := hL
  haveI : L.Additive := adj.left_adjoint_additive
  haveI : (wcEtPush (Limits.pullback.snd f pr)).Additive := adj.right_adjoint_additive
  haveI : Limits.PreservesColimitsOfSize.{0, 0} L := adj.leftAdjoint_preservesColimits
  haveI : Limits.PreservesFiniteColimits L := inferInstance
  haveI : Limits.PreservesLimitsOfSize.{0, 0} (wcEtPush (Limits.pullback.snd f pr)) :=
    adj.rightAdjoint_preservesLimits
  haveI : Limits.PreservesFiniteLimits (wcEtPush (Limits.pullback.snd f pr)) := inferInstance
  obtain ⟨e⟩ := wc_et_left_adjoint_const_zmod L ⟨eZ⟩ m
  haveI := wc_et_enough_injectives (Limits.pullback f pr)
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology P) AddCommGrpCat.{u+1}) := HasExt.standard _
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology (Limits.pullback f pr)) AddCommGrpCat.{u+1}) :=
    HasExt.standard _
  let I := InjectiveResolution.of ((constantSheaf (Scheme.smallEtaleTopology
    (Limits.pullback f pr)) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))

  have hsub : ∀ (B : Sheaf (Scheme.smallEtaleTopology P) AddCommGrpCat.{u+1}), Limits.IsZero B →
      ∀ n : ℕ, Subsingleton (Abelian.Ext (wcZSh P) B n) := by
    intro B hB n
    have h0 : ∀ z : Abelian.Ext (wcZSh P) B n, z = 0 := fun z => by
      rw [← Abelian.Ext.comp_mk₀_id z, hB.eq_of_src (𝟙 B) 0, Abelian.Ext.mk₀_zero,
        Abelian.Ext.comp_zero]
    exact ⟨fun x y => by rw [h0 x, h0 y]⟩

  have hstalk : ∀ p : P, Nat.card ((wcEtStalk P p).obj ((((wcEtPush (Limits.pullback.snd f pr)).mapHomologicalComplex
        (ComplexShape.up ℕ)).obj I.cocomplex).homology 0)) = m ∧
      ∀ q' : ℕ, 1 ≤ q' → Subsingleton ((wcEtStalk P p).obj ((((wcEtPush (Limits.pullback.snd f pr)).mapHomologicalComplex
        (ComplexShape.up ℕ)).obj I.cocomplex).homology q')) := by
    intro p
    obtain ⟨C, _, _, _, Λ, _, _, W', φ, ap, e', hinit, haff, hφ, hφa, hlim, he, hcomp⟩ :=
      wc_et_geom_strict_henselization p
    have hd : wcHalShData p C Λ W' φ ap := ⟨hinit, haff, hφ, hφa, hlim, e', he, hcomp⟩
    have hH := H p C Λ W' φ ap hd
    have hE : ∀ q' : ℕ, Nonempty ((wcEtStalk P p).obj ((((wcEtPush (Limits.pullback.snd f pr)).mapHomologicalComplex
        (ComplexShape.up ℕ)).obj I.cocomplex).homology q') ≃
          wcEtCoh (Limits.pullback f (ap ≫ pr)) m q') := by
      intro q'
      obtain ⟨E₁⟩ := wc_et_stalk_push_homology (Limits.pullback.snd f pr) p Λ W' hinit
        I.cocomplex q'
      obtain ⟨E₂⟩ := wc_et_limit_push_homology_affine (Limits.pullback.snd f pr) C Λ
        (W' ⋙ StructuredArrow.proj (Over.mk (wcEtGeomPt P p)) (Scheme.Etale.forget P))
        φ ap haff hφ hφa hlim m I q'
      obtain ⟨E₃⟩ := wc_et_coh_iso_invariance (Limits.pullbackLeftPullbackSndIso f pr ap).hom m q'
      exact ⟨E₁.trans (E₂.trans E₃.symm)⟩
    refine ⟨?_, fun q' hq' => ?_⟩
    · obtain ⟨E0⟩ := hE 0
      rw [Nat.card_congr E0]
      exact hH.1
    · obtain ⟨Eq⟩ := hE q'
      haveI := hH.2 q' hq'
      exact Eq.subsingleton

  have hRext : ∀ q' : ℕ, 1 ≤ q' → ∀ n : ℕ, Subsingleton (Abelian.Ext (wcZSh P)
      ((((wcEtPush (Limits.pullback.snd f pr)).mapHomologicalComplex
        (ComplexShape.up ℕ)).obj I.cocomplex).homology q') n) := fun q' hq' n =>
    hsub _ (wc_et_stalks_zero _ (fun p => (hstalk p).2 q' hq')) n

  let ι : (wcEtPush (Limits.pullback.snd f pr)).obj ((constantSheaf (Scheme.smallEtaleTopology
      (Limits.pullback f pr)) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) ≅
      (((wcEtPush (Limits.pullback.snd f pr)).mapHomologicalComplex
        (ComplexShape.up ℕ)).obj I.cocomplex).homology 0 :=
    ((wcEtPush (Limits.pullback.snd f pr)).rightDerivedZeroIsoSelf.app _).symm ≪≫
      I.isoRightDerivedObj (wcEtPush (Limits.pullback.snd f pr)) 0

  let u : (constantSheaf (Scheme.smallEtaleTopology P) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} (ZMod m))) ⟶ (wcEtPush (Limits.pullback.snd f pr)).obj
      ((constantSheaf (Scheme.smallEtaleTopology (Limits.pullback f pr))
      AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) :=
    adj.unit.app ((constantSheaf (Scheme.smallEtaleTopology P) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) ≫ (wcEtPush (Limits.pullback.snd f pr)).map e.hom
  haveI : Mono u := by
    haveI := wc_et_push_unit_mono (Limits.pullback.snd f pr) hgsurj L adj
      ((constantSheaf (Scheme.smallEtaleTopology P) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))
    exact mono_comp _ _
  have hbij : ∀ p : P, Function.Bijective ((wcEtStalk P p).map u).hom := by
    intro p
    haveI := (wc_et_stalk_exact P p).1
    have hmono : Mono ((wcEtStalk P p).map u) := inferInstance
    have hinj : Function.Injective ((wcEtStalk P p).map u).hom :=
      (AddCommGrpCat.mono_iff_injective _).mp hmono
    have hT : Nat.card ((wcEtStalk P p).obj ((wcEtPush (Limits.pullback.snd f pr)).obj
        ((constantSheaf (Scheme.smallEtaleTopology (Limits.pullback f pr))
        AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))))) = m := by
      rw [Nat.card_congr ((wcEtStalk P p).mapIso ι).addCommGroupIsoToAddEquiv.toEquiv]
      exact (hstalk p).1
    have hS := (wc_et_const_zmod_stalk_cyclic P m (Nat.pos_of_ne_zero hm) p).2.1
    haveI : Finite ((wcEtStalk P p).obj ((wcEtPush (Limits.pullback.snd f pr)).obj
        ((constantSheaf (Scheme.smallEtaleTopology (Limits.pullback f pr))
        AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))))) :=
      Nat.finite_of_card_ne_zero (by rw [hT]; exact hm)
    exact hinj.bijective_of_nat_card_le (le_of_eq (hT.trans hS.symm))
  have hK : ∀ n : ℕ, Subsingleton (Abelian.Ext (wcZSh P) (Limits.kernel u) n) := fun n =>
    hsub _ (wc_et_stalks_zero _ (fun p => wc_et_stalk_kernel_subsingleton _ _ u p (hbij p).1)) n
  have hC : ∀ n : ℕ, Subsingleton (Abelian.Ext (wcZSh P) (Limits.cokernel u) n) := fun n =>
    hsub _ (wc_et_stalks_zero _ (fun p => wc_r2gc_stalk_coker_subsingleton _ _ u p (hbij p).2)) n
  obtain ⟨E1⟩ := wc_ext_bij_of_ker_coker_acyclic (wcZSh P) _ _ u hK hC q
  obtain ⟨E2⟩ := wc_ext_leray_equiv_of_higher_ext_vanish L (wcEtPush (Limits.pullback.snd f pr))
    adj (wcZSh P) _ I hRext q
  let E3 : Abelian.Ext (L.obj (wcZSh P)) ((constantSheaf (Scheme.smallEtaleTopology
      (Limits.pullback f pr)) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) q ≃
      Abelian.Ext (wcZSh (Limits.pullback f pr)) ((constantSheaf (Scheme.smallEtaleTopology
      (Limits.pullback f pr)) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) q :=
    { toFun := fun x => (Abelian.Ext.mk₀ eZ.inv).comp x (zero_add q)
      invFun := fun y => (Abelian.Ext.mk₀ eZ.hom).comp y (zero_add q)
      left_inv := fun x => by
        simp only
        rw [← Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add q) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.mk₀_id_comp]
      right_inv := fun y => by
        simp only
        rw [← Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add q) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.mk₀_id_comp] }
  exact ⟨(E1.trans (E2.trans E3)).symm⟩

theorem wc_affine_space_milnor_fibre_acyclic : ∀ (K : Type u) [Field K] [IsAlgClosed K] (ℓ : ℕ), ℓ.Prime → (ℓ : K) ≠ 0 → ∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (sA : Spec (.of A) ⟶ Spec (.of K)) (d : ℕ) (x : Spec (.of (MvPolynomial (Fin d) A))), Spec.map (CommRingCat.ofHom (algebraMap A (MvPolynomial (Fin d) A))) x = IsLocalRing.closedPoint A → ∀ (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (MvPolynomial (Fin d) A))) x)) (Scheme.Etale.forget (Spec (.of (MvPolynomial (Fin d) A))))) (φ : ∀ l, Spec (.of B) ⟶ (W'.obj l).right.left) (a : Spec (.of B) ⟶ Spec (.of (MvPolynomial (Fin d) A))), wcHalShData x B Λ W' φ a → ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (z : Spec (.of Ω) ⟶ Spec (.of A)), Nat.card (wcEtCoh (Limits.pullback (a ≫ Spec.map (CommRingCat.ofHom (algebraMap A (MvPolynomial (Fin d) A)))) z) ℓ 0) = ℓ ∧ ∀ q : ℕ, 1 ≤ q → Subsingleton (wcEtCoh (Limits.pullback (a ≫ Spec.map (CommRingCat.ofHom (algebraMap A (MvPolynomial (Fin d) A)))) z) ℓ q) :=
by
  intro K _ _ ℓ hℓ hℓK
  have hℓ0 : ℓ ≠ 0 := hℓ.ne_zero
  have G : ∀ (d : ℕ) (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (sA : Spec (.of A) ⟶ Spec (.of K)) (x : Spec (.of (MvPolynomial (Fin d) A))), Spec.map (CommRingCat.ofHom (algebraMap A (MvPolynomial (Fin d) A))) x = IsLocalRing.closedPoint A → ∀ (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (MvPolynomial (Fin d) A))) x)) (Scheme.Etale.forget (Spec (.of (MvPolynomial (Fin d) A))))) (φ : ∀ l, Spec (.of B) ⟶ (W'.obj l).right.left) (a : Spec (.of B) ⟶ Spec (.of (MvPolynomial (Fin d) A))), wcHalShData x B Λ W' φ a → ∀ (C : Type u) [CommRing C] [HenselianLocalRing C] [IsSepClosed (IsLocalRing.ResidueField C)] (c : Spec (.of C) ⟶ Spec (.of A)), Nat.card (wcEtCoh (Limits.pullback (a ≫ Spec.map (CommRingCat.ofHom (algebraMap A (MvPolynomial (Fin d) A)))) c) ℓ 0) = ℓ ∧ ∀ q : ℕ, 1 ≤ q → Subsingleton (wcEtCoh (Limits.pullback (a ≫ Spec.map (CommRingCat.ofHom (algebraMap A (MvPolynomial (Fin d) A)))) c) ℓ q) := by
    intro d
    induction d with
    | zero =>
      intro A _ _ _ sA x hx B _ _ _ Λ _ _ W' φ a hd C _ _ _ c
      haveI := wc_affine_space_zero_shens_isIso A x hx B Λ W' φ a hd
      haveI hconn : ConnectedSpace (Spec (.of C)) := by
        rw [connectedSpace_iff_clopen]
        refine ⟨⟨IsLocalRing.closedPoint C⟩, fun s hs => ?_⟩
        by_cases h : (IsLocalRing.closedPoint C : Spec (.of C)) ∈ s
        · right
          ext p
          simp only [Set.mem_univ, iff_true]
          exact (IsLocalRing.specializes_closedPoint (R := C) p).mem_open hs.2 h
        · left
          ext p
          simp only [Set.mem_empty_iff_false, iff_false]
          intro hp
          exact h ((IsLocalRing.specializes_closedPoint (R := C) p).mem_closed hs.1 hp)
      have E : ∀ q : ℕ, Nonempty (wcEtCoh (Spec (.of C)) ℓ q ≃ wcEtCoh (Limits.pullback (a ≫ Spec.map (CommRingCat.ofHom (algebraMap A (MvPolynomial (Fin 0) A)))) c) ℓ q) :=
        fun q => wc_et_coh_iso_invariance (Limits.pullback.snd (a ≫ Spec.map (CommRingCat.ofHom (algebraMap A (MvPolynomial (Fin 0) A)))) c) ℓ q
      refine ⟨?_, fun q hq => ?_⟩
      · obtain ⟨E0⟩ := E 0
        rw [← Nat.card_congr E0]
        exact wc_et_coh_zero_connected_card (Spec (.of C)) ℓ hℓ0
      · obtain ⟨q', rfl⟩ : ∃ q', q = q' + 1 := ⟨q - 1, by omega⟩
        obtain ⟨Eq⟩ := E (q' + 1)
        haveI : Subsingleton (wcEtCoh (Spec (.of C)) ℓ (q' + 1)) :=
          wc_et_strictly_local_ext_vanishing C ((constantSheaf (Scheme.smallEtaleTopology (Spec (.of C))) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))) q'
        exact Eq.symm.subsingleton
    | succ d ih =>
      intro A _ _ _ sA x hx B _ _ _ Λ _ _ W' φ a hd C _ _ _ c
      have hρ : Spec.map (CommRingCat.ofHom (MvPolynomial.rename Fin.succ : MvPolynomial (Fin d) A →ₐ[A] MvPolynomial (Fin (d + 1)) A).toRingHom) ≫ Spec.map (CommRingCat.ofHom (algebraMap A (MvPolynomial (Fin d) A))) = Spec.map (CommRingCat.ofHom (algebraMap A (MvPolynomial (Fin (d + 1)) A))) := by
        have hr : (MvPolynomial.rename Fin.succ : MvPolynomial (Fin d) A →ₐ[A] MvPolynomial (Fin (d + 1)) A).toRingHom.comp (algebraMap A (MvPolynomial (Fin d) A)) = algebraMap A (MvPolynomial (Fin (d + 1)) A) := by
          first
            | exact RingHom.ext fun r => (MvPolynomial.rename Fin.succ : MvPolynomial (Fin d) A →ₐ[A] MvPolynomial (Fin (d + 1)) A).commutes r
            | exact AlgHom.comp_algebraMap (MvPolynomial.rename Fin.succ : MvPolynomial (Fin d) A →ₐ[A] MvPolynomial (Fin (d + 1)) A)
            | (ext r; simp [MvPolynomial.algebraMap_eq])
        rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, hr]
      have hx' : Spec.map (CommRingCat.ofHom (algebraMap A (MvPolynomial (Fin d) A))) (Spec.map (CommRingCat.ofHom (MvPolynomial.rename Fin.succ : MvPolynomial (Fin d) A →ₐ[A] MvPolynomial (Fin (d + 1)) A).toRingHom) x) = IsLocalRing.closedPoint A := by
        rw [← hx, ← hρ, Scheme.Hom.comp_apply]
      obtain ⟨B', _, _, _, Λ', _, _, W'', φ', a', e', hinit', haff', hφ', hφa', hlim', he', hpt'⟩ :=
        wc_et_geom_strict_henselization (Spec.map (CommRingCat.ofHom (MvPolynomial.rename Fin.succ : MvPolynomial (Fin d) A →ₐ[A] MvPolynomial (Fin (d + 1)) A).toRingHom) x)
      have hd' : wcHalShData (Spec.map (CommRingCat.ofHom (MvPolynomial.rename Fin.succ : MvPolynomial (Fin d) A →ₐ[A] MvPolynomial (Fin (d + 1)) A).toRingHom) x) B' Λ' W'' φ' a' :=
        ⟨hinit', haff', hφ', hφa', hlim', e', he', hpt'⟩
      obtain ⟨ã, h1, hx'', hθ⟩ := wc_affine_space_succ_shens_tower A d x hx B Λ W' φ a hd B' Λ' W'' φ' a' hd'
      obtain ⟨B₂, _, _, _, Λ₂, _, _, W₂, φ₂, a₂, e₂, hinit₂, haff₂, hφ₂, hφa₂, hlim₂, he₂, hpt₂⟩ :=
        wc_et_geom_strict_henselization (ã (IsLocalRing.closedPoint B))
      have hd₂ : wcHalShData (ã (IsLocalRing.closedPoint B)) B₂ Λ₂ W₂ φ₂ a₂ :=
        ⟨hinit₂, haff₂, hφ₂, hφa₂, hlim₂, e₂, he₂, hpt₂⟩
      obtain ⟨θ, hθa⟩ := hθ B₂ Λ₂ W₂ φ₂ a₂ hd₂
      have IH := ih A sA _ hx' B' Λ' W'' φ' a' hd' C c
      haveI : Surjective (a₂ ≫ Spec.map (CommRingCat.ofHom (algebraMap B' (Polynomial B')))) :=
        wc_shens_poly_closed_fibre_surjective B' _ hx'' B₂ Λ₂ W₂ φ₂ a₂ hd₂
      haveI : IsAffineHom (a₂ ≫ Spec.map (CommRingCat.ofHom (algebraMap B' (Polynomial B')))) := by
        first
          | infer_instance
          | exact isAffineHom_of_isAffine _
      have T := wc_et_coh_transfer_of_shens_fibres (Spec (.of B₂)) (Spec (.of B'))
        (Limits.pullback (a' ≫ Spec.map (CommRingCat.ofHom (algebraMap A (MvPolynomial (Fin d) A)))) c)
        (a₂ ≫ Spec.map (CommRingCat.ofHom (algebraMap B' (Polynomial B'))))
        (Limits.pullback.fst (a' ≫ Spec.map (CommRingCat.ofHom (algebraMap A (MvPolynomial (Fin d) A)))) c)
        ℓ hℓ0 (fun p Cp _ _ _ Λp _ _ Wp φp ap hdp =>
          wc_affine_line_shens_strict_test_acyclic K ℓ hℓ hℓK B'
            (a' ≫ Spec.map (CommRingCat.ofHom (algebraMap A (MvPolynomial (Fin d) A))) ≫ sA)
            (ã (IsLocalRing.closedPoint B)) hx'' B₂ Λ₂ W₂ φ₂ a₂ hd₂ Cp
            (ap ≫ Limits.pullback.fst (a' ≫ Spec.map (CommRingCat.ofHom (algebraMap A (MvPolynomial (Fin d) A)))) c))
      have key : (a ≫ Spec.map (CommRingCat.ofHom (algebraMap A (MvPolynomial (Fin (d + 1)) A)))) ≫ 𝟙 _ =
          θ.hom ≫ ((a₂ ≫ Spec.map (CommRingCat.ofHom (algebraMap B' (Polynomial B')))) ≫
            (a' ≫ Spec.map (CommRingCat.ofHom (algebraMap A (MvPolynomial (Fin d) A))))) := by
        rw [Category.comp_id, ← h1, ← hθa]
        simp only [Category.assoc]
      have E : ∀ q : ℕ, Nonempty (wcEtCoh (Limits.pullback (a ≫ Spec.map (CommRingCat.ofHom (algebraMap A (MvPolynomial (Fin (d + 1)) A)))) c) ℓ q ≃
          wcEtCoh (Limits.pullback (a' ≫ Spec.map (CommRingCat.ofHom (algebraMap A (MvPolynomial (Fin d) A)))) c) ℓ q) := by
        intro q
        obtain ⟨E1⟩ := wc_et_coh_iso_invariance
          (Limits.pullback.map (a ≫ Spec.map (CommRingCat.ofHom (algebraMap A (MvPolynomial (Fin (d + 1)) A)))) c
            ((a₂ ≫ Spec.map (CommRingCat.ofHom (algebraMap B' (Polynomial B')))) ≫
              (a' ≫ Spec.map (CommRingCat.ofHom (algebraMap A (MvPolynomial (Fin d) A))))) c
            θ.hom (𝟙 _) (𝟙 _) key (by simp)) ℓ q
        obtain ⟨E2⟩ := wc_et_coh_iso_invariance
          (Limits.pullbackRightPullbackFstIso
            (a' ≫ Spec.map (CommRingCat.ofHom (algebraMap A (MvPolynomial (Fin d) A)))) c
            (a₂ ≫ Spec.map (CommRingCat.ofHom (algebraMap B' (Polynomial B'))))).hom ℓ q
        obtain ⟨E3⟩ := T q
        exact ⟨(E1.symm.trans E2).trans E3⟩
      refine ⟨?_, fun q hq => ?_⟩
      · obtain ⟨E0⟩ := E 0
        rw [Nat.card_congr E0]
        exact IH.1
      · obtain ⟨Eq⟩ := E q
        haveI := IH.2 q hq
        exact Eq.subsingleton
  intro A _ _ _ sA d x hx B _ _ _ Λ _ _ W' φ a hd Ω _ _ z
  haveI : IsAlgClosed (IsLocalRing.ResidueField Ω) := IsAlgClosed.of_ringEquiv Ω _
    (RingEquiv.ofBijective (IsLocalRing.residue Ω)
      ⟨(IsLocalRing.residue Ω).injective, IsLocalRing.residue_surjective⟩)
  exact G d A sA x hx B Λ W' φ a hd Ω z

theorem wc_affine_line_milnor_fibre_h0_card : ∀ (ℓ : ℕ), ℓ.Prime → ∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (x : Spec (.of (Polynomial A))), Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A))) x = IsLocalRing.closedPoint A → ∀ (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (Polynomial A))) x)) (Scheme.Etale.forget (Spec (.of (Polynomial A))))) (φ : ∀ l, Spec (.of B) ⟶ (W'.obj l).right.left) (a : Spec (.of B) ⟶ Spec (.of (Polynomial A))), wcHalShData x B Λ W' φ a → ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (z : Spec (.of Ω) ⟶ Spec (.of A)), Nat.card (wcEtCoh (Limits.pullback (a ≫ Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) z) ℓ 0) = ℓ :=
by
  intro ℓ hℓ A _ _ _ x hxc B _ _ _ Λ _ _ W' φ a hd Ω _ _ z

  have c2 : ∀ (R S T : Type u) [CommRing R] [CommRing S] [CommRing T] [Algebra R S] [Algebra R T],
