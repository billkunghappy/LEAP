  have hf : ∀ (W : X.Etale) (s : Cs.obj.obj (Opposite.op W)),
      (κ W ((f.hom.app (Opposite.op W)).hom s)).1 = LocallyConstant.comap
        ⟨Limits.pullback.fst W.hom pr, (Limits.pullback.fst W.hom pr).continuous⟩
        ((e W s).map ULift.up) ∧ (κ W ((f.hom.app (Opposite.op W)).hom s)).2 = 0 := by
    intro W s
    rw [hfapp, hpre]
    exact ⟨rfl, rfl⟩

  obtain ⟨gfun, hgfun⟩ : ∃ gfun : ∀ W : X.Etale, A.obj.obj (Opposite.op W) → Cs.obj.obj (Opposite.op W),
      ∀ W x, e W (gfun W x) = (κ W x).2.map ULift.down :=
    ⟨fun W x => (e W).symm ((κ W x).2.map ULift.down), fun W x => AddEquiv.apply_symm_apply _ _⟩
  have hgadd : ∀ (W : X.Etale) (x y : A.obj.obj (Opposite.op W)),
      gfun W (x + y) = gfun W x + gfun W y := by
    intro W x y
    apply (e W).injective
    rw [map_add, hgfun, hgfun, hgfun, map_add, Prod.snd_add]
    apply LocallyConstant.ext
    intro z
    rfl
  have nat_g : ∀ (W W' : X.Etale) (k : W' ⟶ W) (x : A.obj.obj (Opposite.op W)),
      (Cs.obj.map k.op).hom (gfun W x) = gfun W' ((A.obj.map k.op).hom x) := by
    intro W W' k x
    apply (e W').injective
    apply LocallyConstant.ext
    intro z
    rw [he W W' k (gfun W x) z, hgfun, hgfun, (hκ W W' k x).2]
    rfl
  let gNat : A.obj ⟶ Cs.obj :=
    { app := fun U => AddCommGrpCat.ofHom (AddMonoidHom.mk' (gfun U.unop) (hgadd U.unop))
      naturality := by
        intro U V k
        ext x
        exact (nat_g U.unop V.unop k.unop x).symm }
  let g : A ⟶ Cs := ObjectProperty.homMk gNat
  have hgapp : ∀ (W : X.Etale) (x : A.obj.obj (Opposite.op W)),
      e W ((g.hom.app (Opposite.op W)).hom x) = (κ W x).2.map ULift.down := fun W x => hgfun W x

  have hz : ∀ (W : X.Etale) (s : Cs.obj.obj (Opposite.op W)), gfun W (pre W s) = 0 := by
    intro W s
    apply (e W).injective
    rw [hgfun, map_zero, hpre]
    apply LocallyConstant.ext
    intro z
    rfl
  have w : f ≫ g = 0 := by
    apply (sheafToPresheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map_injective
    rw [Functor.map_comp, Functor.map_zero]
    ext U s
    exact hz U.unop s

  have finj : ∀ (W : X.Etale) (s : Cs.obj.obj (Opposite.op W)),
      (f.hom.app (Opposite.op W)).hom s = 0 → s = 0 := by
    intro W s hs
    apply (e W).map_eq_zero_iff.mp
    apply LocallyConstant.ext
    intro w0
    obtain ⟨y, rfl⟩ := hsurj W w0
    have h0 : (κ W ((f.hom.app (Opposite.op W)).hom s)).1 = 0 := by
      rw [hs, map_zero]; rfl
    have h5 : ULift.up (e W s (Limits.pullback.fst W.hom pr y)) =
        (0 : ULift.{u+1} (ZMod ℓ)) :=
      DFunLike.congr_fun ((hf W s).1.symm.trans h0) y
    exact congrArg ULift.down h5

  have hmid : ∀ (W : X.Etale) (b : A.obj.obj (Opposite.op W)),
      (g.hom.app (Opposite.op W)).hom b = 0 → ∃ s, (f.hom.app (Opposite.op W)).hom s = b := by
    intro W b hb
    have h2 : (κ W b).2 = 0 := by
      have h := hgapp W b
      rw [hb, map_zero] at h
      apply LocallyConstant.ext
      intro z
      have h6 := DFunLike.congr_fun h z
      apply ULift.ext
      exact h6.symm
    have hinv : ∀ (c : ZMod ℓ) (y : ((wcEtBaseChange pr).obj W).left),
        (κ W b).1 (wcPbρ pr pr (a c) (hact c) W y) = (κ W b).1 y := by
      intro c y
      have h7 := (himg W (κ W b)).1 ⟨b, rfl⟩ c y
      rw [h2, LocallyConstant.zero_apply, mul_zero, add_zero] at h7
      exact h7
    obtain ⟨μ, hμ⟩ := hdesc W (κ W b).1 hinv
    refine ⟨(e W).symm (μ.map ULift.down), ?_⟩
    apply hinj W
    rw [hfapp, hpre]
    refine Prod.ext ?_ ?_
    · apply LocallyConstant.ext
      intro y
      refine Eq.trans ?_ (hμ y).symm
      show ULift.up (e W ((e W).symm (μ.map ULift.down)) (Limits.pullback.fst W.hom pr y)) =
        μ (Limits.pullback.fst W.hom pr y)
      rw [AddEquiv.apply_symm_apply]
      rfl
    · exact h2.symm

  have hcov : ∀ (V : X.Etale) (S : Sieve V), (∀ v : V.left, ∃ (V₁ : X.Etale) (c : V₁ ⟶ V),
      S.arrows c ∧ v ∈ Set.range c.left) → S ∈ Scheme.smallEtaleTopology X V := by
    intro V S hS
    change S ∈ Scheme.smallGrothendieckTopology @Etale X V
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale X
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
    apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale X
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
    intro x
    obtain ⟨V₁, c, hc, y, hy⟩ := hS x
    have hw : c.left ≫ V.hom = V₁.hom := MorphismProperty.Over.w c
    have hEt : Etale c.left := by
      have h1 : Etale V.hom := V.prop
      have h2 : Etale (c.left ≫ V.hom) := by rw [hw]; exact V₁.prop
      exact Etale.of_comp c.left V.hom
    exact ⟨V₁, c, y, hc, hEt, hy⟩

  have hloc : ∀ (W : X.Etale) (q : Cs.obj.obj (Opposite.op W)),
      Presheaf.imageSieve g.hom q ∈ Scheme.smallEtaleTopology X W := by
    intro W q
    apply hcov W
    intro v
    obtain ⟨W₁, k, h, hk, haff⟩ := hlift W ((e W q).map ULift.up)
    obtain ⟨t, ht⟩ := (himg W₁ (h, LocallyConstant.comap ⟨k.left, k.left.continuous⟩
      ((e W q).map ULift.up))).2 (fun c y => haff c y)
    have hgt : (g.hom.app (Opposite.op W₁)).hom t = (Cs.obj.map k.op).hom q := by
      apply (e W₁).injective
      apply LocallyConstant.ext
      intro x
      rw [he W W₁ k q x, hgapp, ht]
      rfl
    have hmem : (Presheaf.imageSieve g.hom q).arrows k := by
      rw [Presheaf.imageSieve_apply]
      exact ⟨t, hgt⟩
    exact ⟨W₁, k, hmem, hk v⟩

  have hmono : Mono f := by
    have : Sheaf.IsLocallyInjective f := (Sheaf.isLocallyInjective_iff_injective f).mpr
      (fun U => (injective_iff_map_eq_zero _).mpr (fun s hs => finj U.unop s hs))
    exact Sheaf.mono_of_isLocallyInjective f
  have hepi : Epi g := by
    have : Sheaf.IsLocallySurjective g :=
      Presheaf.IsLocallySurjective.mk (fun {U} q => hloc U q)
    exact Sheaf.epi_of_isLocallySurjective g
  have hι : ∀ U : (X.Etale)ᵒᵖ, Function.Injective ((Limits.kernel.ι g).hom.app U) := fun U => by
    have h1 : Mono ((sheafToPresheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map
        (Limits.kernel.ι g)) :=
      Functor.map_mono (sheafToPresheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1})
        (Limits.kernel.ι g)
    exact (AddCommGrpCat.mono_iff_injective _).mp ((NatTrans.mono_iff_mono_app _).mp h1 U)
  have hk : Epi (Limits.kernel.lift g f w) := by
    have : Sheaf.IsLocallySurjective (Limits.kernel.lift g f w) :=
      Presheaf.isLocallySurjective_of_surjective (Scheme.smallEtaleTopology X) _ (fun U s => by
        have hb : g.hom.app U ((Limits.kernel.ι g).hom.app U s) = 0 := by
          have h := congrArg (fun φ => (φ.hom.app U) s) (Limits.kernel.condition g)
          exact h
        obtain ⟨a', ha'⟩ := hmid U.unop _ hb
        refine ⟨a', hι U ?_⟩
        have h := congrArg (fun φ => (φ.hom.app U) a') (Limits.kernel.lift_ι g f w)
        exact h.trans ha')
    exact Sheaf.epi_of_isLocallySurjective _
  exact ⟨f, g, w, ShortComplex.ShortExact.mk'
    ((ShortComplex.exact_iff_epi_kernel_lift _).mpr hk) hmono hepi, hf⟩

theorem wc_tae_section : ∀ {X P : Scheme.{u}} (pr : P ⟶ X) (ℓ : ℕ), ℓ.Prime → ∀ (a : ZMod ℓ → (P ⟶ P)) (ht : wcFetTorsor pr ℓ a) (A : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) (κ : ∀ W : X.Etale, A.obj.obj (Opposite.op W) →+ (LocallyConstant ((wcEtBaseChange pr).obj W).left (ULift.{u+1} (ZMod ℓ)) × LocallyConstant W.left (ULift.{u+1} (ZMod ℓ)))), (∀ W : X.Etale, Function.Injective (κ W)) → (∀ (W : X.Etale) (x : LocallyConstant ((wcEtBaseChange pr).obj W).left (ULift.{u+1} (ZMod ℓ)) × LocallyConstant W.left (ULift.{u+1} (ZMod ℓ))), (∃ s, κ W s = x) ↔ ∀ (c : ZMod ℓ) (y : ((wcEtBaseChange pr).obj W).left), x.1 (wcPbρ pr pr (a c) (ht.act_p c) W y) = x.1 y + ULift.up c * x.2 (Limits.pullback.fst W.hom pr y)) → (∀ (W W' : X.Etale) (k : W' ⟶ W) (s : A.obj.obj (Opposite.op W)), (κ W' ((A.obj.map k.op).hom s)).1 = LocallyConstant.comap ⟨((wcEtBaseChange pr).map k).left, ((wcEtBaseChange pr).map k).left.continuous⟩ (κ W s).1 ∧ (κ W' ((A.obj.map k.op).hom s)).2 = LocallyConstant.comap ⟨k.left, k.left.continuous⟩ (κ W s).2) → ∀ (e : ∀ W : X.Etale, ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))).obj.obj (Opposite.op W) ≃+ LocallyConstant W.left (ZMod ℓ)), (∀ (W W' : X.Etale) (k : W' ⟶ W) (s : ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))).obj.obj (Opposite.op W)) (x : W'.left), e W' ((((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))).obj.map k.op).hom s) x = e W s (k.left x)) → ∀ (f : (constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))) ⟶ A), (∀ (W : X.Etale) (s : ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))).obj.obj (Opposite.op W)), (κ W ((f.hom.app (Opposite.op W)).hom s)).1 = LocallyConstant.comap ⟨Limits.pullback.fst W.hom pr, (Limits.pullback.fst W.hom pr).continuous⟩ ((e W s).map ULift.up) ∧ (κ W ((f.hom.app (Opposite.op W)).hom s)).2 = 0) → ∀ (D : LocallyConstant ↥(Limits.pullback pr pr) (ZMod ℓ)), (∀ (c : ZMod ℓ) (m : Limits.pullback pr pr ⟶ Limits.pullback pr pr), m ≫ Limits.pullback.fst pr pr = Limits.pullback.fst pr pr ≫ a c → m ≫ Limits.pullback.snd pr pr = Limits.pullback.snd pr pr → ∀ z, D (m z) = D z + c) → (∀ (c : ZMod ℓ) (m : Limits.pullback pr pr ⟶ Limits.pullback pr pr), m ≫ Limits.pullback.fst pr pr = Limits.pullback.fst pr pr → m ≫ Limits.pullback.snd pr pr = Limits.pullback.snd pr pr ≫ a c → ∀ z, D (m z) = D z - c) → ∃ eA : A.obj.obj (Opposite.op (wcTorsorEt pr ht.etale)), ∀ c : ZMod ℓ, (A.obj.map (wcTorsorAct pr ht.etale (a c) (ht.act_p c)).op).hom eA = eA + (f.hom.app (Opposite.op (wcTorsorEt pr ht.etale))).hom (wcConstSec X (ULift.{u+1} (ZMod ℓ)) (wcTorsorEt pr ht.etale) (ULift.up c)) :=
by
  intro X P pr ℓ hℓ a ht A κ hκinj hκim hκ e he f hf D hD1 hD2
  haveI : NeZero ℓ := ⟨hℓ.ne_zero⟩

  have happ : ∀ {Y Z W : Scheme.{u}} (f₁ : Y ⟶ Z) (g₁ : Z ⟶ W) (h₁ : Y ⟶ W), f₁ ≫ g₁ = h₁ →
      ∀ y, g₁ (f₁ y) = h₁ y := by
    intro Y Z W f₁ g₁ h₁ hfg y
    rw [← hfg, Scheme.Hom.comp_apply]

  have hcs : ∀ (W W' : X.Etale) (k : W' ⟶ W) (x : ULift.{u+1} (ZMod ℓ)),
      ((((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))).obj.map k.op).hom
        (wcConstSec X (ULift.{u+1} (ZMod ℓ)) W x)) = wcConstSec X (ULift.{u+1} (ZMod ℓ)) W' x := by
    intro W W' k x
    exact (NatTrans.naturality_apply (toSheafify (Scheme.smallEtaleTopology X)
      ((Functor.const (X.Etale)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))))) k.op x).symm

  obtain ⟨u, hu⟩ : ∃ u : LocallyConstant P (ZMod ℓ), ∀ p : P,
      u p = e (wcTorsorEt pr ht.etale)
        (wcConstSec X (ULift.{u+1} (ZMod ℓ)) (wcTorsorEt pr ht.etale) (ULift.up 1)) p :=
    ⟨e (wcTorsorEt pr ht.etale)
        (wcConstSec X (ULift.{u+1} (ZMod ℓ)) (wcTorsorEt pr ht.etale) (ULift.up 1)), fun p => rfl⟩

  have hscale : ∀ (c : ZMod ℓ) (p : P), e (wcTorsorEt pr ht.etale)
      (wcConstSec X (ULift.{u+1} (ZMod ℓ)) (wcTorsorEt pr ht.etale) (ULift.up c)) p = c * u p := by
    intro c p
    obtain ⟨G, hG⟩ : ∃ G : ULift.{u+1} (ZMod ℓ) →+ ZMod ℓ, ∀ x, G x = e (wcTorsorEt pr ht.etale)
        (wcConstSec X (ULift.{u+1} (ZMod ℓ)) (wcTorsorEt pr ht.etale) x) p :=
      ⟨(LocallyConstant.evalAddMonoidHom p).comp ((e (wcTorsorEt pr ht.etale)).toAddMonoidHom.comp
          ((toSheafify (Scheme.smallEtaleTopology X) ((Functor.const (X.Etale)ᵒᵖ).obj
            (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))))).app (Opposite.op (wcTorsorEt pr ht.etale))).hom),
        fun x => rfl⟩
    have h1 : c.val • (ULift.up 1 : ULift.{u+1} (ZMod ℓ)) = ULift.up c :=
      ULift.ext _ _ ((nsmul_eq_mul c.val (1 : ZMod ℓ)).trans (by rw [mul_one, ZMod.natCast_zmod_val]))
    have h3 : G (c.val • (ULift.up 1 : ULift.{u+1} (ZMod ℓ))) = (c.val : ZMod ℓ) * G (ULift.up 1) :=
      (map_nsmul G c.val _).trans (nsmul_eq_mul _ _)
    rw [h1, ZMod.natCast_zmod_val, hG, hG, ← hu] at h3
    exact h3

  have hu_inv : ∀ (c : ZMod ℓ) (p : P), u (a c p) = u p := by
    intro c p
    have h := he (wcTorsorEt pr ht.etale) (wcTorsorEt pr ht.etale)
      (wcTorsorAct pr ht.etale (a c) (ht.act_p c))
      (wcConstSec X (ULift.{u+1} (ZMod ℓ)) (wcTorsorEt pr ht.etale) (ULift.up 1)) p
    rw [hcs] at h
    rw [hu, hu]
    exact h.symm

  have hτ1 : ∀ c : ZMod ℓ, wcPbρ pr pr (a c) (ht.act_p c) (wcTorsorEt pr ht.etale) ≫
      Limits.pullback.fst pr pr = Limits.pullback.fst pr pr := by
    intro c
    first
      | exact Limits.pullback.lift_fst _ _ _
      | (unfold wcPbρ; exact Limits.pullback.lift_fst _ _ _)
  have hτ2 : ∀ c : ZMod ℓ, wcPbρ pr pr (a c) (ht.act_p c) (wcTorsorEt pr ht.etale) ≫
      Limits.pullback.snd pr pr = Limits.pullback.snd pr pr ≫ a c := by
    intro c
    first
      | exact Limits.pullback.lift_snd _ _ _
      | (unfold wcPbρ; exact Limits.pullback.lift_snd _ _ _)
  have hρ1 : ∀ c : ZMod ℓ,
      ((wcEtBaseChange pr).map (wcTorsorAct pr ht.etale (a c) (ht.act_p c))).left ≫
        Limits.pullback.fst pr pr = Limits.pullback.fst pr pr ≫ a c := by
    intro c
    first
      | exact (wcEtBaseChangeFst pr).naturality (wcTorsorAct pr ht.etale (a c) (ht.act_p c))
      | (haveI : MorphismProperty.HasPullbacksAlong (@Etale : MorphismProperty Scheme.{u}) pr :=
            ⟨fun _ _ => inferInstance⟩
         haveI : MorphismProperty.IsStableUnderBaseChangeAlong (@Etale : MorphismProperty Scheme.{u}) pr :=
            (fun (Q : MorphismProperty Scheme.{u}) [Q.IsStableUnderBaseChange] =>
              (inferInstance : Q.IsStableUnderBaseChangeAlong pr)) (@Etale : MorphismProperty Scheme.{u})
         have h := MorphismProperty.Over.pullback_map_left (@Etale : MorphismProperty Scheme.{u}) ⊤ pr
            (wcTorsorAct pr ht.etale (a c) (ht.act_p c))
         exact (congrArg (fun k => k ≫ Limits.pullback.fst pr pr) h).trans (Limits.pullback.lift_fst _ _ _))
  have hρ2 : ∀ c : ZMod ℓ,
      ((wcEtBaseChange pr).map (wcTorsorAct pr ht.etale (a c) (ht.act_p c))).left ≫
        Limits.pullback.snd pr pr = Limits.pullback.snd pr pr := by
    intro c
    first
      | exact MorphismProperty.Over.w ((wcEtBaseChange pr).map (wcTorsorAct pr ht.etale (a c) (ht.act_p c)))
      | (haveI : MorphismProperty.HasPullbacksAlong (@Etale : MorphismProperty Scheme.{u}) pr :=
            ⟨fun _ _ => inferInstance⟩
         haveI : MorphismProperty.IsStableUnderBaseChangeAlong (@Etale : MorphismProperty Scheme.{u}) pr :=
            (fun (Q : MorphismProperty Scheme.{u}) [Q.IsStableUnderBaseChange] =>
              (inferInstance : Q.IsStableUnderBaseChangeAlong pr)) (@Etale : MorphismProperty Scheme.{u})
         have h := MorphismProperty.Over.pullback_map_left (@Etale : MorphismProperty Scheme.{u}) ⊤ pr
            (wcTorsorAct pr ht.etale (a c) (ht.act_p c))
         exact (congrArg (fun k => k ≫ Limits.pullback.snd pr pr) h).trans (Limits.pullback.lift_snd _ _ _))
  have hτf : ∀ (c : ZMod ℓ) (y : ((wcEtBaseChange pr).obj (wcTorsorEt pr ht.etale)).left),
      Limits.pullback.fst pr pr (wcPbρ pr pr (a c) (ht.act_p c) (wcTorsorEt pr ht.etale) y) =
        Limits.pullback.fst pr pr y :=
    fun c y => happ _ _ _ (hτ1 c) y
  have hτD : ∀ (c : ZMod ℓ) (y : ((wcEtBaseChange pr).obj (wcTorsorEt pr ht.etale)).left),
      D (wcPbρ pr pr (a c) (ht.act_p c) (wcTorsorEt pr ht.etale) y) = D y - c :=
    fun c y => hD2 c _ (hτ1 c) (hτ2 c) y
  have hρf : ∀ (c : ZMod ℓ) (y : ((wcEtBaseChange pr).obj (wcTorsorEt pr ht.etale)).left),
      Limits.pullback.fst pr pr
        (((wcEtBaseChange pr).map (wcTorsorAct pr ht.etale (a c) (ht.act_p c))).left y) =
        a c (Limits.pullback.fst pr pr y) :=
    fun c y => (happ _ _ _ (hρ1 c) y).trans (Scheme.Hom.comp_apply _ _ _)
  have hρD : ∀ (c : ZMod ℓ) (y : ((wcEtBaseChange pr).obj (wcTorsorEt pr ht.etale)).left),
      D (((wcEtBaseChange pr).map (wcTorsorAct pr ht.etale (a c) (ht.act_p c))).left y) = D y + c :=
    fun c y => hD1 c _ (hρ1 c) (hρ2 c) y

  obtain ⟨H, hH⟩ : ∃ H : LocallyConstant ((wcEtBaseChange pr).obj (wcTorsorEt pr ht.etale)).left
      (ULift.{u+1} (ZMod ℓ)), ∀ y : ((wcEtBaseChange pr).obj (wcTorsorEt pr ht.etale)).left,
      H y = ULift.up (u (Limits.pullback.fst pr pr y) * D y) :=
    ⟨LocallyConstant.map ULift.up (LocallyConstant.comap
      ⟨Limits.pullback.fst pr pr, (Limits.pullback.fst pr pr).continuous⟩ u * D), fun y => rfl⟩
  obtain ⟨Λ, hΛ⟩ : ∃ Λ : LocallyConstant (wcTorsorEt pr ht.etale).left (ULift.{u+1} (ZMod ℓ)),
      ∀ p : P, Λ p = ULift.up (-(u p)) :=
    ⟨LocallyConstant.map ULift.up (-u), fun p => rfl⟩

  have hmem : ∀ (c : ZMod ℓ) (y : ((wcEtBaseChange pr).obj (wcTorsorEt pr ht.etale)).left),
      H (wcPbρ pr pr (a c) (ht.act_p c) (wcTorsorEt pr ht.etale) y) =
        H y + ULift.up c * Λ (Limits.pullback.fst (wcTorsorEt pr ht.etale).hom pr y) := by
    intro c y
    rw [hH, hH]
    have k : u (Limits.pullback.fst pr pr (wcPbρ pr pr (a c) (ht.act_p c) (wcTorsorEt pr ht.etale) y)) *
        D (wcPbρ pr pr (a c) (ht.act_p c) (wcTorsorEt pr ht.etale) y) =
        u (Limits.pullback.fst pr pr y) * D y + c * (-(u (Limits.pullback.fst pr pr y))) := by
      rw [hτf, hτD]; ring
    have e2 : Λ (Limits.pullback.fst (wcTorsorEt pr ht.etale).hom pr y) =
        ULift.up (-(u (Limits.pullback.fst pr pr y))) := hΛ _
    rw [e2]
    exact ULift.ext _ _ k
  obtain ⟨eA, heA⟩ := (hκim (wcTorsorEt pr ht.etale) (H, Λ)).2 hmem

  refine ⟨eA, fun c => hκinj (wcTorsorEt pr ht.etale) ?_⟩
  rw [map_add]
  refine Prod.ext ?_ ?_
  · rw [(hκ (wcTorsorEt pr ht.etale) (wcTorsorEt pr ht.etale)
      (wcTorsorAct pr ht.etale (a c) (ht.act_p c)) eA).1, Prod.fst_add,
      (hf (wcTorsorEt pr ht.etale)
        (wcConstSec X (ULift.{u+1} (ZMod ℓ)) (wcTorsorEt pr ht.etale) (ULift.up c))).1, heA]
    refine LocallyConstant.ext fun y => ?_
    show H (((wcEtBaseChange pr).map (wcTorsorAct pr ht.etale (a c) (ht.act_p c))).left y) =
      H y + ULift.up (e (wcTorsorEt pr ht.etale)
        (wcConstSec X (ULift.{u+1} (ZMod ℓ)) (wcTorsorEt pr ht.etale) (ULift.up c))
        (Limits.pullback.fst pr pr y))
    rw [hH, hH]
    have k : u (Limits.pullback.fst pr pr
          (((wcEtBaseChange pr).map (wcTorsorAct pr ht.etale (a c) (ht.act_p c))).left y)) *
        D (((wcEtBaseChange pr).map (wcTorsorAct pr ht.etale (a c) (ht.act_p c))).left y) =
        u (Limits.pullback.fst pr pr y) * D y + e (wcTorsorEt pr ht.etale)
          (wcConstSec X (ULift.{u+1} (ZMod ℓ)) (wcTorsorEt pr ht.etale) (ULift.up c))
          (Limits.pullback.fst pr pr y) := by
      rw [hρf, hρD, hu_inv, hscale]; ring
    exact ULift.ext _ _ k
  · rw [(hκ (wcTorsorEt pr ht.etale) (wcTorsorEt pr ht.etale)
      (wcTorsorAct pr ht.etale (a c) (ht.act_p c)) eA).2, Prod.snd_add,
      (hf (wcTorsorEt pr ht.etale)
        (wcConstSec X (ULift.{u+1} (ZMod ℓ)) (wcTorsorEt pr ht.etale) (ULift.up c))).2, heA, add_zero]
    refine LocallyConstant.ext fun p => ?_
    show Λ (a c p) = Λ p
    exact (hΛ (a c p)).trans ((congrArg (fun t => ULift.up (-t)) (hu_inv c p)).trans (hΛ p).symm)

theorem wc_et_torsor_affine_abelian_ext : ∀ {X P : Scheme.{u}} (pr : P ⟶ X) (ℓ : ℕ), ℓ.Prime → ∀ (a : ZMod ℓ → (P ⟶ P)) (ht : wcFetTorsor pr ℓ a), ∃ (A : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) (f : (constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))) ⟶ A) (g : A ⟶ (constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))) (w : f ≫ g = 0), (ShortComplex.mk f g w).ShortExact ∧ ℓ • 𝟙 A = 0 ∧ ∃ eA : A.obj.obj (Opposite.op (wcTorsorEt pr ht.etale)), ∀ c : ZMod ℓ, (A.obj.map (wcTorsorAct pr ht.etale (a c) (ht.act_p c)).op).hom eA = eA + (f.hom.app (Opposite.op (wcTorsorEt pr ht.etale))).hom (wcConstSec X (ULift.{u+1} (ZMod ℓ)) (wcTorsorEt pr ht.etale) (ULift.up c)) :=
by
  intro X P pr ℓ hℓ a ht
  haveI : NeZero ℓ := ⟨hℓ.ne_zero⟩
  obtain ⟨D, hD1, hD2⟩ := wc_tae_diff_fn pr ℓ a ht
  obtain ⟨A, κ, hκinj, hκim, hκ⟩ := wc_tae_aff_sheaf pr ℓ a ht.act_p
  obtain ⟨e, he⟩ := wc_et_const_zmod_sections_locallyConstant X ℓ
    (fun V S hS x hx => wc_et_locallyConstant_glue X V S hS ℓ x hx)
  have hsurj : ∀ W : X.Etale, Function.Surjective (Limits.pullback.fst W.hom pr) := by
    intro W
    have h1 := Scheme.Pullback.range_fst W.hom pr
    rw [ht.surj, Set.preimage_univ] at h1
    exact Set.range_eq_univ.mp h1
  have hdesc : ∀ (W : X.Etale) (h : LocallyConstant ((wcEtBaseChange pr).obj W).left
      (ULift.{u+1} (ZMod ℓ))), (∀ (c : ZMod ℓ) (y : ((wcEtBaseChange pr).obj W).left),
        h (wcPbρ pr pr (a c) (ht.act_p c) W y) = h y) →
      ∃ μ : LocallyConstant W.left (ULift.{u+1} (ZMod ℓ)),
        ∀ y, h y = μ (Limits.pullback.fst W.hom pr y) :=
    fun W h hh => wc_tae_invariant_descend _ ℓ _ (wc_tae_base_torsor pr ℓ a ht W) h hh
  have hlift := wc_tae_local_lift pr ℓ a ht.act_p ht.etale ht.surj D hD2
  obtain ⟨f, g, w, hS, hf⟩ :=
    wc_tae_ses pr ℓ a ht.act_p A κ hκinj hκim hκ e he hsurj hdesc hlift

  have hz : ∀ v : ULift.{u+1} (ZMod ℓ), ℓ • v = 0 := by
    intro v
    apply ULift.ext
    simp
  have hlc : ∀ {T : Type u} [TopologicalSpace T]
      (φ : LocallyConstant T (ULift.{u+1} (ZMod ℓ))), ℓ • φ = 0 := by
    intro T _ φ
    apply LocallyConstant.ext
    intro y
    first
      | exact hz (φ y)
      | (show ℓ • φ y = 0; exact hz (φ y))
      | (rw [LocallyConstant.coe_nsmul]; exact hz (φ y))
      | (simp only [LocallyConstant.coe_smul, Pi.smul_apply, LocallyConstant.coe_zero,
          Pi.zero_apply]; exact hz (φ y))
  have hsec : ∀ (W : X.Etale) (s : A.obj.obj (Opposite.op W)), ℓ • s = 0 := by
    intro W s
    apply hκinj W
    rw [map_nsmul, map_zero]
    exact Prod.ext (hlc _) (hlc _)
  have htors : ℓ • 𝟙 A = 0 := by
    apply (sheafToPresheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map_injective
    rw [Functor.map_nsmul, Functor.map_zero]
    ext W s
    simp only [NatTrans.app_nsmul, NatTrans.app_zero]
    exact hsec W.unop s
  obtain ⟨eA, heA⟩ := wc_tae_section pr ℓ hℓ a ht A κ hκinj hκim hκ e he f hf D hD1 hD2
  exact ⟨A, f, g, w, hS, htors, eA, heA⟩

theorem wc_et_zmod_abelian_ext_to_module : ∀ (X : Scheme.{u}) (ℓ : ℕ), ℓ.Prime → ∀ (A : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) (f : (constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))) ⟶ A) (g : A ⟶ (constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))) (w : f ≫ g = 0), (ShortComplex.mk f g w).ShortExact → ℓ • 𝟙 A = 0 → ∃ (E : SheafOfModules.{u+1} (wcEtZModRing X ℓ)) (ι : SheafOfModules.unit (wcEtZModRing X ℓ) ⟶ E) (π : E ⟶ SheafOfModules.unit (wcEtZModRing X ℓ)) (w' : ι ≫ π = 0), (ShortComplex.mk ι π w').ShortExact ∧ ∃ κ : ∀ V : X.Etale, E.val.obj (Opposite.op V) ≃+ A.obj.obj (Opposite.op V), (∀ (V V' : X.Etale) (h : V' ⟶ V) (x : E.val.obj (Opposite.op V)), κ V' ((E.val.map h.op).hom x) = (A.obj.map h.op).hom (κ V x)) ∧ ∀ (V : X.Etale) (c : ZMod ℓ), κ V ((ι.val.app (Opposite.op V)).hom (c.val • (1 : (wcEtZModRing X ℓ).obj.obj (Opposite.op V)))) = (f.hom.app (Opposite.op V)).hom (wcConstSec X (ULift.{u+1} (ZMod ℓ)) V (ULift.up c)) :=
by
  intro X ℓ hℓ A f g w hS htors
  haveI : NeZero ℓ := ⟨hℓ.ne_zero⟩
  obtain ⟨α, hinj, hsurj, -⟩ := wc_et_zmod_ring_locbij X ℓ
  obtain ⟨hfull, hess⟩ := sheafOfModules_toSheaf_torsion_equiv (Scheme.smallEtaleTopology X)
    (wcEtZModRing X ℓ) ℓ α hinj hsurj
  haveI := hfull
  haveI := sheafOfModules_toSheaf_preservesFiniteColimits (Scheme.smallEtaleTopology X)
    (wcEtZModRing X ℓ)
  obtain ⟨u, hu⟩ := wc_r2gs_zmod_unit_const_iso X ℓ
  have hA := hess A htors
  let T := SheafOfModules.toSheaf.{u+1} (wcEtZModRing X ℓ)
  let θ : T.obj hA.witness ≅ A := hA.getIso
  let ι : SheafOfModules.unit (wcEtZModRing X ℓ) ⟶ hA.witness := T.preimage (u.hom ≫ f ≫ θ.inv)
  let π : hA.witness ⟶ SheafOfModules.unit (wcEtZModRing X ℓ) := T.preimage (θ.hom ≫ g ≫ u.inv)
  have hTι : T.map ι = u.hom ≫ f ≫ θ.inv := Functor.map_preimage _ _
  have hTπ : T.map π = θ.hom ≫ g ≫ u.inv := Functor.map_preimage _ _
  have w' : ι ≫ π = 0 := by
    apply T.map_injective
    rw [T.map_comp, hTι, hTπ, T.map_zero]
    simp only [Category.assoc, Iso.inv_hom_id_assoc]
    rw [reassoc_of% w, Limits.zero_comp, Limits.comp_zero]
  let S := ShortComplex.mk ι π w'
  let eS : S.map T ≅ ShortComplex.mk f g w :=
    ShortComplex.isoMk u θ u
      (by
        show u.hom ≫ f = T.map ι ≫ θ.hom
        rw [hTι]; simp only [Category.assoc, Iso.inv_hom_id, Category.comp_id])
      (by
        show θ.hom ≫ g = T.map π ≫ u.hom
        rw [hTπ]; simp only [Category.assoc, Iso.inv_hom_id, Category.comp_id])
  have hST : (S.map T).ShortExact := ShortComplex.shortExact_of_iso eS.symm hS
  have hex : S.Exact := (ShortComplex.exact_map_iff_of_faithful S T).mp hST.exact
  have hmono : Mono ι := by
    have : Mono (T.map ι) := hST.mono_f
    exact T.mono_of_mono_map this
  have hepi : Epi π := by
    have : Epi (T.map π) := hST.epi_g
    exact T.epi_of_epi_map this
  have hSE : S.ShortExact := ShortComplex.ShortExact.mk' hex hmono hepi
  let θ' := (sheafToPresheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).mapIso θ
  let κ : ∀ V : X.Etale, hA.witness.val.obj (Opposite.op V) ≃+ A.obj.obj (Opposite.op V) :=
    fun V => (θ'.app (Opposite.op V)).addCommGroupIsoToAddEquiv
  have hnat : ∀ (V V' : X.Etale) (h : V' ⟶ V) (x : hA.witness.val.obj (Opposite.op V)),
      κ V' ((hA.witness.val.map h.op).hom x) = (A.obj.map h.op).hom (κ V x) := by
    intro V V' h x
    exact congrArg (fun φ => φ.hom x) (θ.hom.hom.naturality h.op)
  have key : ∀ (V : X.Etale) (x : (SheafOfModules.unit (wcEtZModRing X ℓ)).val.obj (Opposite.op V)),
      κ V ((ι.val.app (Opposite.op V)).hom x) =
        (f.hom.app (Opposite.op V)).hom ((u.hom.hom.app (Opposite.op V)).hom x) := by
    intro V x
    have h1 : T.map ι ≫ θ.hom = u.hom ≫ f := by
      rw [hTι]; simp only [Category.assoc, Iso.inv_hom_id, Category.comp_id]
    exact congrArg (fun φ : T.obj (SheafOfModules.unit (wcEtZModRing X ℓ)) ⟶ A =>
      (φ.hom.app (Opposite.op V)).hom x) h1
  have hu1 : ∀ V : X.Etale, (u.hom.hom.app (Opposite.op V)).hom
      (1 : (wcEtZModRing X ℓ).obj.obj (Opposite.op V)) =
        wcConstSec X (ULift.{u+1} (ZMod ℓ)) V (ULift.up 1) := by
    intro V
    have h2 : (u.hom.hom.app (Opposite.op V)).hom ((u.inv.hom.app (Opposite.op V)).hom
        (wcConstSec X (ULift.{u+1} (ZMod ℓ)) V (ULift.up 1))) =
        wcConstSec X (ULift.{u+1} (ZMod ℓ)) V (ULift.up 1) := by
      show ((u.inv ≫ u.hom).hom.app (Opposite.op V)).hom
        (wcConstSec X (ULift.{u+1} (ZMod ℓ)) V (ULift.up 1)) = _
      rw [Iso.inv_hom_id]
      rfl
    rw [hu V] at h2
    exact h2
  have hι : ∀ (V : X.Etale) (c : ZMod ℓ),
      κ V ((ι.val.app (Opposite.op V)).hom
        (c.val • (1 : (wcEtZModRing X ℓ).obj.obj (Opposite.op V)))) =
      (f.hom.app (Opposite.op V)).hom (wcConstSec X (ULift.{u+1} (ZMod ℓ)) V (ULift.up c)) := by
    intro V c
    refine (key V _).trans ?_
    congr 1
    have hc : (ULift.up c : ULift.{u+1} (ZMod ℓ)) = c.val • ULift.up 1 := by
      apply ULift.ext
      show c = c.val • (1 : ZMod ℓ)
      rw [nsmul_eq_mul, mul_one, ZMod.natCast_zmod_val]
    rw [hc]
    unfold wcConstSec
    rw [map_nsmul]
    erw [map_nsmul]
    congr 1
    exact hu1 V
  exact ⟨hA.witness, ι, π, w', hSE, κ, hnat, hι⟩

theorem wc_et_torsor_module_affine_ext : ∀ {X P : Scheme.{u}} (pr : P ⟶ X) (ℓ : ℕ), ℓ.Prime → ∀ (a : ZMod ℓ → (P ⟶ P)) (ht : wcFetTorsor pr ℓ a), ∃ (E : SheafOfModules.{u+1} (wcEtZModRing X ℓ)) (ι : SheafOfModules.unit (wcEtZModRing X ℓ) ⟶ E) (π : E ⟶ SheafOfModules.unit (wcEtZModRing X ℓ)) (w : ι ≫ π = 0), (ShortComplex.mk ι π w).ShortExact ∧ ∃ e : E.val.obj (Opposite.op (wcTorsorEt pr ht.etale)), ∀ c : ZMod ℓ, (E.val.map (wcTorsorAct pr ht.etale (a c) (ht.act_p c)).op).hom e = e + (ι.val.app (Opposite.op (wcTorsorEt pr ht.etale))).hom (c.val • (1 : (wcEtZModRing X ℓ).obj.obj (Opposite.op (wcTorsorEt pr ht.etale)))) :=
by
  intro X P pr ℓ hℓ a ht
  obtain ⟨A, f, g, w, hS, htors, eA, heA⟩ := wc_et_torsor_affine_abelian_ext pr ℓ hℓ a ht
  obtain ⟨E, ι, π, w', hSE, κ, hnat, hι⟩ :=
    wc_et_zmod_abelian_ext_to_module X ℓ hℓ A f g w hS htors
  refine ⟨E, ι, π, w', hSE, (κ (wcTorsorEt pr ht.etale)).symm eA, fun c => ?_⟩
  apply (κ (wcTorsorEt pr ht.etale)).injective
  rw [hnat, AddEquiv.apply_symm_apply, heA, map_add, AddEquiv.apply_symm_apply, hι]

theorem wc_et_supp_unit_map_one_isUnit : ∀ {S S' : Scheme.{u}} (g : S' ⟶ S) (n : ℕ) (D : wcEtPullData g n) (V : S.Etale), IsUnit (show (wcEtZModRing S' n).obj.obj (Opposite.op ((wcEtBaseChange g).obj V)) from ((wcEtSuppUnitMap D).val.app (Opposite.op V)).hom (1 : (wcEtZModRing S n).obj.obj (Opposite.op V))) :=
by
  intro S S' g n D V

  have locsurj : ∀ (Y : Scheme.{u}) (n : ℕ),
      ∃ α : (Functor.const (Y.Etale)ᵒᵖ).obj (RingCat.of (ULift.{u+1} (ZMod n))) ⟶ (wcEtZModRing Y n).obj,
        Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology Y) α := by
    intro Y n
    let P : (Y.Etale)ᵒᵖ ⥤ RingCat.{u+1} :=
      (Functor.const (Y.Etale)ᵒᵖ).obj (RingCat.of (ULift.{u+1} (ZMod n)))
    exact ⟨toSheafify (Scheme.smallEtaleTopology Y) P,
      Presheaf.isLocallySurjective_toSheafify' (Scheme.smallEtaleTopology Y) P⟩

  have sep : ∀ (S : Scheme.{u}) (n : ℕ) (M : SheafOfModules.{u+1} (wcEtZModRing S n))
      (W : S.Etale) (R : Sieve W), R ∈ Scheme.smallEtaleTopology S W →
      ∀ x : ↑(M.val.obj (Opposite.op W)),
      (∀ (Q : S.Etale) (g : Q ⟶ W), R.arrows g → (M.val.map g.op).hom x = 0) → x = 0 := by
    intro S n M W R hR x h
    have hs := ((SheafOfModules.toSheaf _).obj M).cond
    have h2 := (Presheaf.isSheaf_iff_isSheaf_forget (Scheme.smallEtaleTopology S) _
      (forget AddCommGrpCat.{u+1})).1 hs
    exact (h2.isSeparated W R hR) x 0
      (fun Q g hg => (h Q g hg).trans (map_zero ((M.val.map g.op).hom)).symm)

  have twist : ∀ {S T : Scheme.{u}} {j : T ⟶ S} {n : ℕ} (E : wcEtPullData j n),
      ∃ e : SheafOfModules.unit (wcEtZModRing T n) ⟶ SheafOfModules.unit (wcEtZModRing T n),
        wcEtSuppUnitMap E ≫ (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange j) _ _ E.cont E.φ).map e
          = @SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcEtBaseChange j) _ _ E.cont E.φ := by
    intro S T j n E
    refine ⟨E.μ.inv ≫ (E.adj.homEquiv _ _).symm
      (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcEtBaseChange j) _ _ E.cont E.φ), ?_⟩
    dsimp only [wcEtSuppUnitMap, wcEtSuppObj]
    rw [Category.assoc, ← Functor.map_comp, Iso.hom_inv_id_assoc,
      ← Adjunction.homEquiv_unit, Equiv.apply_symm_apply]

  have intcast_eq : ∀ (S : Scheme.{u}) (n : ℕ) (V : S.Etale)
      (α : (Functor.const (S.Etale)ᵒᵖ).obj (RingCat.of (ULift.{u+1} (ZMod n))) ⟶ (wcEtZModRing S n).obj)
      (c : ULift.{u+1} (ZMod n)),
      (α.app (Opposite.op V)).hom c = (((c.down.cast : ℤ)) : ↑((wcEtZModRing S n).obj.obj (Opposite.op V))) := by
    intro S n V α c
    have hc : c = (((c.down.cast : ℤ)) : ULift.{u+1} (ZMod n)) := by
      apply ULift.ext
      rw [ULift.down_intCast, ZMod.intCast_zmod_cast]
    conv_lhs => rw [hc]
    exact map_intCast (α.app (Opposite.op V)).hom _

  have comm : ∀ (S : Scheme.{u}) (n : ℕ) (V : S.Etale)
      (x y : ↑((wcEtZModRing S n).obj.obj (Opposite.op V))), x * y = y * x := by
    intro S n V x y
    obtain ⟨α, hsurj⟩ := locsurj S n
    have key := sep S n (SheafOfModules.unit (wcEtZModRing S n)) V
      (Presheaf.imageSieve α x) (Presheaf.imageSieve_mem _ α x) (x * y - y * x) (by
        rintro Q g ⟨c, hc⟩
        change ((wcEtZModRing S n).obj.map g.op).hom (x * y - y * x) = 0
        rw [map_sub, map_mul, map_mul, ← hc, intcast_eq, Int.cast_comm, sub_self])
    exact sub_eq_zero.mp key

  obtain ⟨e, he⟩ := twist D
  let s : ↑((wcEtZModRing S' n).obj.obj (Opposite.op ((wcEtBaseChange g).obj V))) :=
    ((wcEtSuppUnitMap D).val.app (Opposite.op V)).hom (1 : ↑((wcEtZModRing S n).obj.obj (Opposite.op V)))
  let t : ↑((wcEtZModRing S' n).obj.obj (Opposite.op ((wcEtBaseChange g).obj V))) :=
    (e.val.app (Opposite.op ((wcEtBaseChange g).obj V))).hom
      (1 : ↑((wcEtZModRing S' n).obj.obj (Opposite.op ((wcEtBaseChange g).obj V))))
  have hst : s * t = 1 := by
    have h2 := congrArg (fun h => (h.val.app (Opposite.op V)).hom
      (1 : ↑((wcEtZModRing S n).obj.obj (Opposite.op V)))) he
    change (e.val.app (Opposite.op ((wcEtBaseChange g).obj V))).hom s =
      (D.φ.hom.app (Opposite.op V)).hom (1 : ↑((wcEtZModRing S n).obj.obj (Opposite.op V))) at h2
    rw [map_one] at h2
    have h3 : (e.val.app (Opposite.op ((wcEtBaseChange g).obj V))).hom s = s * t := by
      have := (e.val.app (Opposite.op ((wcEtBaseChange g).obj V))).hom.map_smul s
        (1 : ↑((wcEtZModRing S' n).obj.obj (Opposite.op ((wcEtBaseChange g).obj V))))
      exact (congrArg (e.val.app (Opposite.op ((wcEtBaseChange g).obj V))).hom (mul_one s).symm).trans this
    exact h3.symm.trans h2

  have hts : t * s = 1 := (comm S' n ((wcEtBaseChange g).obj V) t s).trans hst
  exact isUnit_iff_exists.mpr ⟨t, hst, hts⟩

theorem wc_et_zmod_ring_sections_lc_equiv : ∀ (Y : Scheme.{u}) (n : ℕ), ∃ e : ∀ V : Y.Etale, (wcEtZModRing Y n).obj.obj (Opposite.op V) ≃+* LocallyConstant V.left (ZMod n), ∀ (V V' : Y.Etale) (h : V' ⟶ V) (x : (wcEtZModRing Y n).obj.obj (Opposite.op V)) (y : V'.left), e V' (((wcEtZModRing Y n).obj.map h.op).hom x) y = e V x (h.left y) :=
by
  intro Y n

  have hcov : ∀ (V : Y.Etale) (S : Sieve V), (∀ v : V.left, ∃ (V₁ : Y.Etale) (c : V₁ ⟶ V),
      S.arrows c ∧ v ∈ Set.range c.left) → S ∈ Scheme.smallEtaleTopology Y V := by
    intro V S hS
    change S ∈ Scheme.smallGrothendieckTopology @Etale Y V
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
    apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
    intro x
    obtain ⟨V₁, c, hc, y, hy⟩ := hS x
    have hw : c.left ≫ V.hom = V₁.hom := MorphismProperty.Over.w c
    have hEt : Etale c.left := by
      have h1 : Etale V.hom := V.prop
      have h2 : Etale (c.left ≫ V.hom) := by rw [hw]; exact V₁.prop
      exact Etale.of_comp c.left V.hom
    exact ⟨V₁, c, y, hc, hEt, hy⟩

  have wcGlue : ∀ (V : Y.Etale) (S : Sieve V), S ∈ Scheme.smallEtaleTopology Y V → ∀ (m : ℕ) (x : ∀ (V' : Y.Etale) (g : V' ⟶ V), S.arrows g → LocallyConstant V'.left (ZMod m)), (∀ (V' V'' : Y.Etale) (g : V' ⟶ V) (hg : S.arrows g) (h : V'' ⟶ V') (w : V''.left), x V'' (h ≫ g) (S.downward_closed hg h) w = x V' g hg (h.left w)) → ∃! f : LocallyConstant V.left (ZMod m), ∀ (V' : Y.Etale) (g : V' ⟶ V) (hg : S.arrows g) (v : V'.left), f (g.left v) = x V' g hg v := by
    intro V S hS m x hx
    have hEt : ∀ (A B : Y.Etale) (g : A ⟶ B), Etale g.left := by
      intro A B g
      haveI : Etale B.hom := B.prop
      have hw : g.left ≫ B.hom = A.hom := MorphismProperty.Over.w g
      haveI : Etale (g.left ≫ B.hom) := by
        rw [hw]
        exact A.prop
      exact Etale.of_comp g.left B.hom
    have hOpen : ∀ (A B : Y.Etale) (g : A ⟶ B), IsOpenMap g.left := by
      intro A B g
      haveI := hEt A B g
      exact g.left.isOpenMap
    have hsurj : ∀ v : V.left, ∃ (V' : Y.Etale) (g : V' ⟶ V) (v' : V'.left),
        S.arrows g ∧ g.left v' = v := by
      change S ∈ Scheme.smallGrothendieckTopology @Etale Y V at hS
      rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hS
      intro v
      obtain ⟨V', g, v', hg, -, hv⟩ := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ V S).mp hS v
      exact ⟨V', g, v', hg, hv⟩
    have hcongr : ∀ (Q : Y.Etale) (k k' : Q ⟶ V) (_ : k = k') (hk : S.arrows k)
        (hk' : S.arrows k') (w : Q.left), x Q k hk w = x Q k' hk' w := by
      intro Q k k' e hk hk' w
      subst e
      rfl
    have hagree : ∀ (V₁ V₂ : Y.Etale) (g₁ : V₁ ⟶ V) (g₂ : V₂ ⟶ V) (hg₁ : S.arrows g₁)
        (hg₂ : S.arrows g₂) (v₁ : V₁.left) (v₂ : V₂.left), g₁.left v₁ = g₂.left v₂ →
        x V₁ g₁ hg₁ v₁ = x V₂ g₂ hg₂ v₂ := by
      intro V₁ V₂ g₁ g₂ hg₁ hg₂ v₁ v₂ hv
      haveI : Etale g₂.left := hEt V₂ V g₂
      haveI : Etale V₁.hom := V₁.prop
      let Q : Y.Etale := MorphismProperty.Over.mk ⊤
        (Limits.pullback.fst g₁.left g₂.left ≫ V₁.hom)
        (inferInstance : Etale (Limits.pullback.fst g₁.left g₂.left ≫ V₁.hom))
      let h₁ : Q ⟶ V₁ := MorphismProperty.Over.homMk (Limits.pullback.fst g₁.left g₂.left) rfl trivial
      have hc : Limits.pullback.snd g₁.left g₂.left ≫ V₂.hom = Q.hom := by
        change Limits.pullback.snd g₁.left g₂.left ≫ V₂.hom =
          Limits.pullback.fst g₁.left g₂.left ≫ V₁.hom
        rw [← MorphismProperty.Over.w g₂, ← MorphismProperty.Over.w g₁, ← Category.assoc,
          ← Category.assoc, Limits.pullback.condition]
      let h₂ : Q ⟶ V₂ := MorphismProperty.Over.homMk (Limits.pullback.snd g₁.left g₂.left) hc trivial
      obtain ⟨c₁, hc₁⟩ : ∃ c : Q ⟶ V, c = h₁ ≫ g₁ := ⟨_, rfl⟩
      obtain ⟨c₂, hc₂⟩ : ∃ c : Q ⟶ V, c = h₂ ≫ g₂ := ⟨_, rfl⟩
      have hc12 : c₁ = c₂ := by
        apply MorphismProperty.Over.Hom.ext
        rw [hc₁, hc₂]
        change Limits.pullback.fst g₁.left g₂.left ≫ g₁.left =
          Limits.pullback.snd g₁.left g₂.left ≫ g₂.left
        exact Limits.pullback.condition
      obtain ⟨w, hw₁, hw₂⟩ := Scheme.Pullback.exists_preimage_pullback v₁ v₂ hv
      have k1 : h₁.left w = v₁ := hw₁
      have k2 : h₂.left w = v₂ := hw₂
      have e1 := hx V₁ Q g₁ hg₁ h₁ w
      have e2 := hx V₂ Q g₂ hg₂ h₂ w
      rw [← k1, ← k2, ← e1, ← e2]
      exact hcongr Q _ _ (hc₁.symm.trans (hc12.trans hc₂)) _ _ w
    choose V₀ g₀ z₀ hg₀ hz₀ using hsurj
    let F : V.left → ZMod m := fun v => x (V₀ v) (g₀ v) (hg₀ v) (z₀ v)
    have hF : ∀ (V' : Y.Etale) (g : V' ⟶ V) (hg : S.arrows g) (v : V'.left),
        F (g.left v) = x V' g hg v := by
      intro V' g hg v
      exact hagree _ _ _ _ _ _ _ _ (hz₀ (g.left v))
    have hFlc : IsLocallyConstant F := by
      rw [IsLocallyConstant.iff_isOpen_fiber]
      intro a
      have hfib : F ⁻¹' {a} = ⋃ (i : Σ V' : Y.Etale, {g : V' ⟶ V // S.arrows g}),
          i.2.1.left '' {z | x i.1 i.2.1 i.2.2 z = a} := by
        ext v
        constructor
        · intro hv
          exact Set.mem_iUnion.2 ⟨⟨V₀ v, g₀ v, hg₀ v⟩, z₀ v, hv, hz₀ v⟩
        · intro hv
          obtain ⟨⟨V', g, hg⟩, z, hz, hzv⟩ := Set.mem_iUnion.1 hv
          subst hzv
          exact (hF V' g hg z).trans hz
      rw [hfib]
      apply isOpen_iUnion
      intro i
      exact hOpen _ _ i.2.1 _ (IsLocallyConstant.isOpen_fiber (x i.1 i.2.1 i.2.2).isLocallyConstant a)
    refine ⟨⟨F, hFlc⟩, fun V' g hg v => hF V' g hg v, ?_⟩
    intro f' hf'
    ext v
    change f' v = F v
    exact (congrArg f' (hz₀ v)).symm.trans (hf' _ _ _ _)

  let L : (Y.Etale)ᵒᵖ ⥤ RingCat.{u+1} :=
    { obj := fun V => RingCat.of (LocallyConstant V.unop.left (ULift.{u+1} (ZMod n)))
      map := fun g => RingCat.ofHom (LocallyConstant.comapRingHom
        ⟨g.unop.left, g.unop.left.continuous⟩)
      map_id := fun _ => rfl
      map_comp := fun _ _ => rfl }
  let eL : ∀ V : Y.Etale, (L.obj (Opposite.op V)) ≃+* LocallyConstant V.left (ZMod n) := fun V =>
    { toFun := fun f => (show LocallyConstant V.left (ULift.{u+1} (ZMod n)) from f).map ULift.down
      invFun := fun g => (show L.obj (Opposite.op V) from g.map ULift.up)
      left_inv := fun f => rfl
      right_inv := fun g => rfl
      map_mul' := fun f g => rfl
      map_add' := fun f g => rfl }

  have hL : Presheaf.IsSheaf (Scheme.smallEtaleTopology Y) L := by
    rw [Presheaf.isSheaf_iff_isSheaf_forget (Scheme.smallEtaleTopology Y) L
      (forget RingCat.{u+1}), isSheaf_iff_isSheaf_of_type]
    intro V S hS x hx
    have hx' := hx.to_sieveCompatible
    obtain ⟨f, hf, huniq⟩ := wcGlue V S hS n
      (fun V' g hg => eL V' (x g hg)) (by
      intro V' V'' g hg h w
      exact (congrArg (fun t => (eL V'' t) w) (hx' g h hg)).trans rfl)
    refine ⟨(eL V).symm f, ?_, ?_⟩
    · intro V' g hg
      apply (eL V').injective
      ext v
      exact hf V' g hg v
    · intro t ht
      have : eL V t = f := by
        apply huniq
        intro V' g hg v
        rw [← ht g hg]
        rfl
      exact (eL V).eq_symm_apply.mpr this

  let P := (Functor.const (Y.Etale)ᵒᵖ).obj (RingCat.of (ULift.{u+1} (ZMod n)))
  let α : P ⟶ L :=
    { app := fun V => RingCat.ofHom (LocallyConstant.constRingHom :
        ULift.{u+1} (ZMod n) →+* LocallyConstant V.unop.left (ULift.{u+1} (ZMod n)))
      naturality := fun _ _ _ => rfl }
  have hinj : Presheaf.IsLocallyInjective (Scheme.smallEtaleTopology Y) α := by
    constructor
    intro X a b hab
    apply hcov
    intro v
    have hab' : a = b :=
      congrArg (fun f : LocallyConstant X.unop.left (ULift.{u+1} (ZMod n)) => f v) hab
    refine ⟨X.unop, 𝟙 _, ?_, ⟨v, rfl⟩⟩
    rw [Presheaf.equalizerSieve_apply, hab']
  have hsurj : Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology Y) α := by
    constructor
    intro V s
    apply hcov
    intro v
    let f : LocallyConstant V.left (ULift.{u+1} (ZMod n)) := s
    let O : V.left.Opens := ⟨{x | f x = f v}, f.isLocallyConstant.isOpen_fiber (f v)⟩
    let V₁ : Y.Etale := MorphismProperty.Over.mk ⊤ (O.ι ≫ V.hom) (by infer_instance)
    let c : V₁ ⟶ V := MorphismProperty.Over.homMk O.ι rfl trivial
    have hv : v ∈ Set.range O.ι := by
      rw [Scheme.Opens.range_ι]
      exact (rfl : f v = f v)
    refine ⟨V₁, c, ?_, hv⟩
    rw [Presheaf.imageSieve_apply]
    refine ⟨f v, ?_⟩
    apply LocallyConstant.ext
    intro x
    have hx : O.ι x ∈ (O : Set V.left) := by
      rw [← Scheme.Opens.range_ι]
      exact ⟨x, rfl⟩
    exact (show f (O.ι x) = f v from hx).symm

  let φ := sheafifyLift (Scheme.smallEtaleTopology Y) α hL
  have hfac : toSheafify (Scheme.smallEtaleTopology Y) P ≫ φ = α :=
    toSheafify_sheafifyLift _ α hL
  have := hinj
  have := hsurj
  have : Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology Y)
      (toSheafify (Scheme.smallEtaleTopology Y) P) :=
    Presheaf.isLocallySurjective_toSheafify' _ P
  have h1 : Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology Y) φ :=
    Presheaf.isLocallySurjective_of_isLocallySurjective_fac _ hfac
  have h2 : Presheaf.IsLocallyInjective (Scheme.smallEtaleTopology Y) φ :=
    Presheaf.isLocallyInjective_of_isLocallyInjective_of_isLocallySurjective_fac _ α hfac
  let Φ : (constantSheaf (Scheme.smallEtaleTopology Y) RingCat.{u+1}).obj
      (RingCat.of (ULift.{u+1} (ZMod n))) ⟶
      (⟨L, hL⟩ : Sheaf (Scheme.smallEtaleTopology Y) RingCat.{u+1}) :=
    ObjectProperty.homMk φ
  have hΦ : IsIso Φ := (Sheaf.isLocallyBijective_iff_isIso Φ).mp ⟨h2, h1⟩
  have hφ : IsIso φ := by
    have : IsIso ((sheafToPresheaf (Scheme.smallEtaleTopology Y) RingCat.{u+1}).map Φ) :=
      Functor.map_isIso _ Φ
    exact this
  have hV : ∀ V, IsIso (φ.app V) := fun V => NatIso.isIso_app_of_isIso φ V
  refine ⟨fun V => (asIso (φ.app (Opposite.op V))).ringCatIsoToRingEquiv.trans (eL V), ?_⟩
  intro V V' g s x
  have key := NatTrans.naturality_apply φ g.op s
  exact (congrArg (fun t => (eL V' t) x) key).trans rfl

theorem wc_et_torsor_class_pull_nonzero : ∀ {X X' P : Scheme.{u}} (g : X' ⟶ X) (pr : P ⟶ X) (ℓ : ℕ), ℓ.Prime → ∀ (a : ZMod ℓ → (P ⟶ P)), wcFetTorsor pr ℓ a → (¬ ∃ σ : X' ⟶ Limits.pullback pr g, σ ≫ Limits.pullback.snd pr g = 𝟙 X') → ∀ (D : wcEtPullData g ℓ), ∃ x : wcEtZModExt X ℓ 1, wcEtPull D 1 x ≠ 0 :=
by
  intro X X' P g pr ℓ hℓ a ht hnosec D
  classical
  haveI : Fact ℓ.Prime := ⟨hℓ⟩
  haveI : NeZero ℓ := ⟨hℓ.ne_zero⟩
  haveI := D.cont
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing X ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing X' ℓ)) := HasExt.standard _
  haveI := D.additive
  haveI := D.presLim
  haveI := D.presColim

  have hw : ∀ c, (Limits.pullback.fst pr g ≫ a c) ≫ pr = Limits.pullback.snd pr g ≫ g := by
    intro c
    rw [Category.assoc, ht.act_p c, Limits.pullback.condition]
  let a' : ZMod ℓ → (Limits.pullback pr g ⟶ Limits.pullback pr g) := fun c =>
    Limits.pullback.lift (Limits.pullback.fst pr g ≫ a c) (Limits.pullback.snd pr g) (hw c)
  have tor' : wcFetTorsor (Limits.pullback.snd pr g) ℓ a' := by
    haveI := ht.finite
    haveI := ht.etale
    let f := Limits.pullback.fst pr g
    let q := Limits.pullback.snd pr g
    haveI hqe : Etale q := inferInstanceAs (Etale (Limits.pullback.snd pr g))
    have hC : f ≫ pr = q ≫ g := Limits.pullback.condition
    have A1 : ∀ c, a' c ≫ f = f ≫ a c := fun c => Limits.pullback.lift_fst _ _ _
    have A2 : ∀ c, a' c ≫ q = q := fun c => Limits.pullback.lift_snd _ _ _
    have act_zero : a' 0 = 𝟙 _ := by
      apply Limits.pullback.hom_ext
      · rw [A1, ht.act_zero, Category.comp_id, Category.id_comp]
      · rw [A2, Category.id_comp]
    have act_add : ∀ c c', a' (c + c') = a' c' ≫ a' c := by
      intro c c'
      apply Limits.pullback.hom_ext
      · have A1' : ∀ (d : ZMod ℓ) {Z : Scheme.{u}} (k : P ⟶ Z), a' d ≫ f ≫ k = f ≫ a d ≫ k := by
          intro d Z k
          rw [← Category.assoc, A1, Category.assoc]
        change a' (c + c') ≫ f = a' c' ≫ a' c ≫ f
        rw [A1, ht.act_add]
        simp only [Category.assoc, A1, A1']
      · change a' (c + c') ≫ q = a' c' ≫ a' c ≫ q
        rw [A2, A2, A2]
    have hsurj : Set.range (Limits.pullback.snd pr g) = Set.univ := by
      rw [Scheme.Pullback.range_snd, ht.surj, Set.preimage_univ]
    let G' : ZMod ℓ → (Limits.pullback pr g ⟶ Limits.pullback q q) := fun c =>
      Limits.pullback.lift (a' c) (𝟙 _) ((A2 c).trans (Category.id_comp _).symm)
    have G'1 : ∀ c, G' c ≫ Limits.pullback.fst q q = a' c := fun c => Limits.pullback.lift_fst _ _ _
    have G'2 : ∀ c, G' c ≫ Limits.pullback.snd q q = 𝟙 _ := fun c => Limits.pullback.lift_snd _ _ _
    let G : ZMod ℓ → (P ⟶ Limits.pullback pr pr) := fun c =>
      Limits.pullback.lift (a c) (𝟙 P) ((ht.act_p c).trans (Category.id_comp pr).symm)
    have G1 : ∀ c, G c ≫ Limits.pullback.fst pr pr = a c := fun c => Limits.pullback.lift_fst _ _ _
    have G2 : ∀ c, G c ≫ Limits.pullback.snd pr pr = 𝟙 P := fun c => Limits.pullback.lift_snd _ _ _
    have hopen : ∀ c, IsOpenImmersion (G' c) := by
      intro c
      haveI : Mono (G' c) := mono_of_mono_fac (G'2 c)
      haveI : Etale (G' c) := by
        apply MorphismProperty.of_postcomp (W := @Etale) (W' := @Etale) _
          (Limits.pullback.snd q q) inferInstance
        rw [G'2 c]; infer_instance
      exact IsOpenImmersion.of_flat_of_mono _
    let κ := Limits.pullback.map q q pr pr f f g hC.symm hC.symm
    have κ1 : κ ≫ Limits.pullback.fst pr pr = Limits.pullback.fst q q ≫ f :=
      Limits.pullback.lift_fst _ _ _
    have κ2 : κ ≫ Limits.pullback.snd pr pr = Limits.pullback.snd q q ≫ f :=
      Limits.pullback.lift_snd _ _ _
    have K : ∀ c, G' c ≫ κ = f ≫ G c := by
      intro c
      apply Limits.pullback.hom_ext
      · simp only [Category.assoc]
        rw [κ1, ← Category.assoc, G'1, A1, G1]
      · simp only [Category.assoc]
        rw [κ2, ← Category.assoc, G'2, Category.id_comp, G2, Category.comp_id]
    have L : ∀ c {T : Scheme.{u}} (t₁ : T ⟶ P) (t₂ : T ⟶ Limits.pullback q q),
        t₁ ≫ G c = t₂ ≫ κ → (t₂ ≫ Limits.pullback.snd q q) ≫ G' c = t₂ := by
      intro c T t₁ t₂ ht₁
      have e1 : t₂ ≫ Limits.pullback.fst q q ≫ f = t₁ ≫ a c := by
        rw [← κ1, ← Category.assoc, ← ht₁, Category.assoc, G1]
      have e2 : t₂ ≫ Limits.pullback.snd q q ≫ f = t₁ := by
        rw [← κ2, ← Category.assoc, ← ht₁, Category.assoc, G2, Category.comp_id]
      apply Limits.pullback.hom_ext
      · simp only [Category.assoc, G'1]
        apply Limits.pullback.hom_ext
        · change t₂ ≫ Limits.pullback.snd q q ≫ a' c ≫ f = t₂ ≫ Limits.pullback.fst q q ≫ f
          rw [A1 c, reassoc_of% e2, e1]
        · change t₂ ≫ Limits.pullback.snd q q ≫ a' c ≫ q = t₂ ≫ Limits.pullback.fst q q ≫ q
          rw [A2, Limits.pullback.condition]
      · simp only [Category.assoc, G'2, Category.comp_id]
    have hR : ∀ c, Set.range (G' c) ⊆ κ ⁻¹' Set.range (G c) := by
      rintro c _ ⟨v, rfl⟩
      refine ⟨f v, ?_⟩
      have := Scheme.Hom.comp_apply (G' c) κ v
      rw [K c, Scheme.Hom.comp_apply] at this
      exact this
    have hdisj : Pairwise fun c c' => Disjoint (Set.range (G' c)) (Set.range (G' c')) := by
      intro c c' hcc'
      have hd : Disjoint (Set.range (G c)) (Set.range (G c')) := ht.graph_disj hcc'
      exact Disjoint.mono (hR c) (hR c') (hd.preimage (⇑κ))
    have hcov : ⋃ c, Set.range (G c) = Set.univ := ht.graph_cover
    have hcover : ⋃ c, Set.range (G' c) = Set.univ := by
      apply Set.eq_univ_of_forall
      intro z
      have hz : κ z ∈ ⋃ c, Set.range (G c) := by
        rw [hcov]; exact Set.mem_univ _
      obtain ⟨c, hc⟩ := Set.mem_iUnion.mp hz
      have hzT : z ∈ Set.range (Limits.pullback.snd (G c) κ) := by
        rw [Scheme.Pullback.range_snd]; exact hc
      obtain ⟨w, rfl⟩ := hzT
      have hL := L c (Limits.pullback.fst (G c) κ) (Limits.pullback.snd (G c) κ)
        Limits.pullback.condition
      refine Set.mem_iUnion.mpr ⟨c, (Limits.pullback.snd (G c) κ ≫ Limits.pullback.snd q q) w, ?_⟩
      have := Scheme.Hom.comp_apply (Limits.pullback.snd (G c) κ ≫ Limits.pullback.snd q q) (G' c) w
      rw [hL] at this
      exact this.symm
    exact ⟨inferInstance, inferInstance, hsurj, A2, act_zero, act_add, hopen, hdisj, hcover⟩

  obtain ⟨E, ι, π, w, hS, e, he⟩ := wc_et_torsor_module_affine_ext pr ℓ hℓ a ht
  refine ⟨hS.extClass, fun h0 => ?_⟩

  have h1 : (Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ hS.extClass).comp
      (Abelian.Ext.mk₀ D.μ.hom) (add_zero 1)) (zero_add 1) = 0 := by
    have h0' := h0
    unfold wcEtPull at h0'
    simp only [AddMonoidHom.comp_apply, Functor.mapExtAddHom_apply] at h0'
    simp only [Abelian.Ext.precomp, Abelian.Ext.postcomp, AddMonoidHom.flip_apply,
      Abelian.Ext.bilinearComp_apply_apply] at h0'
    exact h0'
  have h2 : (Abelian.Ext.mapExactFunctor D.Φ hS.extClass).comp (Abelian.Ext.mk₀ D.μ.hom)
      (add_zero 1) = 0 := by
    have h3 := congrArg (fun z => (Abelian.Ext.mk₀ D.μ.hom).comp z (zero_add 1)) h1
    simp only [Abelian.Ext.comp_zero] at h3
    rw [← Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add 1) (by omega),
      Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.mk₀_id_comp] at h3
    exact h3
  rw [Abelian.Ext.mapExactFunctor_extClass] at h2

  obtain ⟨x₂, hx₂⟩ := Abelian.Ext.contravariant_sequence_exact₁ (hS.map_of_exact D.Φ)
    (SheafOfModules.unit (wcEtZModRing X' ℓ)) (Abelian.Ext.mk₀ D.μ.hom) (add_zero 1) h2
  have hρ : D.Φ.map ι ≫ Abelian.Ext.addEquiv₀ x₂ = D.μ.hom := by
    apply (Abelian.Ext.mk₀_bijective _ _).1
    rw [← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_addEquiv₀_apply]
    exact hx₂

  let r : E ⟶ (SheafOfModules.pushforward D.φ).obj (SheafOfModules.unit (wcEtZModRing X' ℓ)) :=
    D.adj.homEquiv _ _ (Abelian.Ext.addEquiv₀ x₂)
  have hr : ι ≫ r = wcEtSuppUnitMap D := by
    show ι ≫ D.adj.homEquiv _ _ (Abelian.Ext.addEquiv₀ x₂) = _
    rw [← Adjunction.homEquiv_naturality_left, hρ, Adjunction.homEquiv_unit]
    rfl

  let V := wcTorsorEt pr ht.etale
  have hι1 : (r.val.app (Opposite.op V)).hom ((ι.val.app (Opposite.op V)).hom
      (1 : (wcEtZModRing X ℓ).obj.obj (Opposite.op V))) =
      ((wcEtSuppUnitMap D).val.app (Opposite.op V)).hom
        (1 : (wcEtZModRing X ℓ).obj.obj (Opposite.op V)) := by
    rw [← hr]; rfl
  obtain ⟨H, hH⟩ : ∃ H : (wcEtZModRing X' ℓ).obj.obj (Opposite.op ((wcEtBaseChange g).obj V)),
      H = (r.val.app (Opposite.op V)).hom e := ⟨_, rfl⟩
  obtain ⟨s, hs⟩ : ∃ s : (wcEtZModRing X' ℓ).obj.obj (Opposite.op ((wcEtBaseChange g).obj V)),
      s = ((wcEtSuppUnitMap D).val.app (Opposite.op V)).hom
        (1 : (wcEtZModRing X ℓ).obj.obj (Opposite.op V)) := ⟨_, rfl⟩
  have hsu : IsUnit s := by
    rw [hs]; exact wc_et_supp_unit_map_one_isUnit g ℓ D V
  have hrel : ∀ c : ZMod ℓ, ((wcEtZModRing X' ℓ).obj.map ((wcEtBaseChange g).map
      (wcTorsorAct pr ht.etale (a c) (ht.act_p c))).op).hom H = H + c.val • s := by
    intro c
    have k1 := PresheafOfModules.naturality_apply r.val
      (wcTorsorAct pr ht.etale (a c) (ht.act_p c)).op e
    have k2 : (r.val.app (Opposite.op V)).hom
        ((E.val.map (wcTorsorAct pr ht.etale (a c) (ht.act_p c)).op).hom e) =
        (r.val.app (Opposite.op V)).hom e + c.val • ((r.val.app (Opposite.op V)).hom
          ((ι.val.app (Opposite.op V)).hom (1 : (wcEtZModRing X ℓ).obj.obj (Opposite.op V)))) := by
      rw [he c, map_add]
      congr 1
      first
        | rw [map_nsmul, map_nsmul]
        | erw [map_nsmul, map_nsmul]
        | simp only [map_nsmul]
    rw [hι1] at k2
    rw [hH, hs]
    exact k1.symm.trans k2

  obtain ⟨e', he'⟩ := wc_et_zmod_ring_sections_lc_equiv X' ℓ
  have hβ : ∀ c, ((wcEtBaseChange g).map (wcTorsorAct pr ht.etale (a c) (ht.act_p c))).left =
      a' c := by
    intro c
    first
      | exact MorphismProperty.Over.pullback_map_left _ _ _ _
      | rfl
      | (erw [MorphismProperty.Over.pullback_map_left]; rfl)
  have hpt : ∀ (c : ZMod ℓ) (q : ((wcEtBaseChange g).obj V).left),
      e' ((wcEtBaseChange g).obj V) H (a' c q) =
        e' ((wcEtBaseChange g).obj V) H q + c * e' ((wcEtBaseChange g).obj V) s q := by
    intro c q
    have k1 := he' ((wcEtBaseChange g).obj V) ((wcEtBaseChange g).obj V)
      ((wcEtBaseChange g).map (wcTorsorAct pr ht.etale (a c) (ht.act_p c))) H q
    rw [hrel c, hβ c] at k1
    refine k1.symm.trans ?_
    change ((LocallyConstant.evalRingHom q).comp (e' ((wcEtBaseChange g).obj V)).toRingHom)
        (H + c.val • s) =
      ((LocallyConstant.evalRingHom q).comp (e' ((wcEtBaseChange g).obj V)).toRingHom) H +
        c * ((LocallyConstant.evalRingHom q).comp (e' ((wcEtBaseChange g).obj V)).toRingHom) s
    rw [map_add, map_nsmul, nsmul_eq_mul, ZMod.natCast_zmod_val]
  have hσ : ∀ q, e' ((wcEtBaseChange g).obj V) s q ≠ 0 := by
    intro q
    obtain ⟨t, htt⟩ := (hsu.map (e' ((wcEtBaseChange g).obj V))).exists_right_inv
    have k := DFunLike.congr_fun htt q
    rw [LocallyConstant.mul_apply, LocallyConstant.one_apply] at k
    exact left_ne_zero_of_mul_eq_one k

  have hD1 : ∀ c : ZMod ℓ, c ≠ 0 → ∀ q ∈ {q | e' ((wcEtBaseChange g).obj V) H q = 0},
      (a' c) q ∉ {q | e' ((wcEtBaseChange g).obj V) H q = 0} := by
    intro c hc q hq hq'
    have hq0 : e' ((wcEtBaseChange g).obj V) H q = 0 := hq
    have hq0' : e' ((wcEtBaseChange g).obj V) H (a' c q) = 0 := hq'
    rw [hpt, hq0, zero_add] at hq0'
    exact (mul_ne_zero hc (hσ q)) hq0'
  have hD2 : ∀ q, ∃ c : ZMod ℓ, (a' c) q ∈ {q | e' ((wcEtBaseChange g).obj V) H q = 0} := by
    intro q
    refine ⟨-(e' ((wcEtBaseChange g).obj V) H q) * (e' ((wcEtBaseChange g).obj V) s q)⁻¹, ?_⟩
    show e' ((wcEtBaseChange g).obj V) H (a' _ q) = 0
    refine (hpt _ q).trans ?_
    rw [mul_assoc, inv_mul_cancel₀ (hσ q), mul_one, add_neg_cancel]
  obtain ⟨σ₀, hσ₀⟩ := wc_torsor_section_of_fundamental_open (Limits.pullback.snd pr g) ℓ a' tor'
    {q | e' ((wcEtBaseChange g).obj V) H q = 0}
    ((e' ((wcEtBaseChange g).obj V) H).isLocallyConstant.isOpen_fiber 0) hD1 hD2
  exact hnosec ⟨σ₀, hσ₀⟩

theorem wc_cpt_spec_pullback_root_transfer : ∀ (A C K : Type u) [CommRing A] [CommRing C] [CommRing K] (f : A →+* C) (ζ : Spec (.of K) ⟶ Spec (.of A)) (ℓ : ℕ) (s : C) (σ : Limits.pullback (Spec.map (CommRingCat.ofHom f)) ζ ⟶ Limits.pullback (Spec.map (CommRingCat.ofHom (algebraMap C (AdjoinRoot (Polynomial.X ^ ℓ - Polynomial.C s))))) (Limits.pullback.fst (Spec.map (CommRingCat.ofHom f)) ζ)), σ ≫ Limits.pullback.snd _ _ = 𝟙 _ → letI := f.toAlgebra; letI := (Spec.preimage ζ).hom.toAlgebra; ∃ v : TensorProduct A C K, v ^ ℓ = s ⊗ₜ[A] (1 : K) :=
by
  intro A C K _ _ _ f ζ ℓ s σ hσ
  letI := f.toAlgebra
  letI := (Spec.preimage ζ).hom.toAlgebra
  let incL : C →+* TensorProduct A C K := Algebra.TensorProduct.includeLeftRingHom
  let incR : K →+* TensorProduct A C K :=
    (Algebra.TensorProduct.includeRight : K →ₐ[A] TensorProduct A C K).toRingHom
  have h3 : incL.comp f = incR.comp (Spec.preimage ζ).hom :=
    Algebra.TensorProduct.includeLeftRingHom_comp_algebraMap
  have h4 : Spec.map (CommRingCat.ofHom incL) ≫ Spec.map (CommRingCat.ofHom f) =
      Spec.map (CommRingCat.ofHom incR) ≫ ζ := by
    have h4' : Spec.map (CommRingCat.ofHom incL) ≫ Spec.map (CommRingCat.ofHom f) =
        Spec.map (CommRingCat.ofHom incR) ≫ Spec.map (Spec.preimage ζ) := by
      rw [← Spec.map_comp, ← Spec.map_comp]
      congr 1
      ext x
      exact RingHom.congr_fun h3 x
    rw [h4', Spec.map_preimage]
  let j := Limits.pullback.lift (Spec.map (CommRingCat.ofHom incL))
    (Spec.map (CommRingCat.ofHom incR)) h4
  have h5 : j ≫ Limits.pullback.fst (Spec.map (CommRingCat.ofHom f)) ζ =
      Spec.map (CommRingCat.ofHom incL) := Limits.pullback.lift_fst _ _ _
  let g := j ≫ σ ≫ Limits.pullback.fst _ _
  have h6 : g ≫ Spec.map (CommRingCat.ofHom
      (algebraMap C (AdjoinRoot (Polynomial.X ^ ℓ - Polynomial.C s)))) =
      Spec.map (CommRingCat.ofHom incL) := by
    simp only [g]
    rw [Category.assoc, Category.assoc, Limits.pullback.condition, ← Category.assoc σ, hσ,
      Category.id_comp, h5]
  let ψ := Spec.preimage g
  have h7 : Spec.map (CommRingCat.ofHom
      (algebraMap C (AdjoinRoot (Polynomial.X ^ ℓ - Polynomial.C s))) ≫ ψ) =
      Spec.map (CommRingCat.ofHom incL) := by
    rw [Spec.map_comp, Spec.map_preimage, h6]
  have h7' := Spec.map_injective h7
  have h7s : ψ.hom (algebraMap C (AdjoinRoot (Polynomial.X ^ ℓ - Polynomial.C s)) s) = incL s :=
    congrArg (fun φ => φ.hom s) h7'
  have h8 : (AdjoinRoot.root (Polynomial.X ^ ℓ - Polynomial.C s)) ^ ℓ =
      algebraMap C (AdjoinRoot (Polynomial.X ^ ℓ - Polynomial.C s)) s := by
    have := AdjoinRoot.eval₂_root (Polynomial.X ^ ℓ - Polynomial.C s)
    rw [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C, sub_eq_zero] at this
    rw [this, AdjoinRoot.algebraMap_eq]
  refine ⟨ψ.hom (AdjoinRoot.root (Polynomial.X ^ ℓ - Polynomial.C s)), ?_⟩
  rw [← map_pow, h8, h7s]
  rfl

theorem wc_cgtnr_localization_root_descend : ∀ (A B C K : Type u) [CommRing A] [CommRing B] [CommRing C] [CommRing K] [Algebra A B] [Algebra B C] [Algebra A C] [IsScalarTower A B C] [Algebra A K] (u : B) [IsLocalization.Away u C] (m : ℕ) (v : TensorProduct A C K), v ^ m = (algebraMap B C u) ⊗ₜ[A] (1 : K) → ∃ (σ : TensorProduct A B K) (n k : ℕ), (u ⊗ₜ[A] (1 : K)) ^ k * σ ^ m = (u ⊗ₜ[A] (1 : K)) ^ k * (u ⊗ₜ[A] (1 : K)) ^ (n * m + 1) :=
by
  intro A B C K _ _ _ _ _ _ _ _ _ u _ m v hv
  let ψ : TensorProduct A B K →ₗ[B] TensorProduct A C K :=
    TensorProduct.AlgebraTensorModule.rTensor A K (Algebra.linearMap B C)
  have hloc : IsLocalizedModule (Submonoid.powers u) ψ := inferInstance
  let Φ : TensorProduct A B K →ₐ[A] TensorProduct A C K :=
    Algebra.TensorProduct.map (IsScalarTower.toAlgHom A B C) (AlgHom.id A K)
  have hψΦ : ∀ z, ψ z = Φ z := by
    intro z
    induction z using TensorProduct.induction_on with
    | zero => simp
    | tmul b k =>
      simp [ψ, Φ, TensorProduct.AlgebraTensorModule.rTensor_tmul, Algebra.TensorProduct.map_tmul]
    | add x y hx hy => rw [map_add, map_add, hx, hy]
  have hsmulT : ∀ (b : B) (z : TensorProduct A B K), b • z = (b ⊗ₜ[A] (1 : K)) * z := by
    intro b z
    induction z using TensorProduct.induction_on with
    | zero => simp
    | tmul x k =>
      rw [TensorProduct.smul_tmul', Algebra.TensorProduct.tmul_mul_tmul, one_mul, smul_eq_mul]
    | add x y hx hy => rw [smul_add, mul_add, hx, hy]
  have hsmulT' : ∀ (b : B) (w : TensorProduct A C K),
      b • w = (algebraMap B C b ⊗ₜ[A] (1 : K)) * w := by
    intro b w
    induction w using TensorProduct.induction_on with
    | zero => simp
    | tmul x k =>
      rw [TensorProduct.smul_tmul', Algebra.TensorProduct.tmul_mul_tmul, one_mul, Algebra.smul_def]
    | add x y hx hy => rw [smul_add, mul_add, hx, hy]
  have hΦU : Φ (u ⊗ₜ[A] (1 : K)) = algebraMap B C u ⊗ₜ[A] (1 : K) := by
    simp [Φ, Algebra.TensorProduct.map_tmul]
  obtain ⟨⟨σ, s⟩, hs⟩ := IsLocalizedModule.surj (Submonoid.powers u) ψ v
  obtain ⟨a, ha⟩ := (Submonoid.mem_powers_iff _ _).mp s.2
  have h1 : (algebraMap B C u ⊗ₜ[A] (1 : K)) ^ a * v = Φ σ := by
    rw [← hψΦ]
    simp only at hs
    rw [← hs, Submonoid.smul_def, ← ha, hsmulT', map_pow, Algebra.TensorProduct.tmul_pow, one_pow]
  have h2 : ψ ((u ⊗ₜ[A] (1 : K)) ^ (a * m + 1)) = ψ (σ ^ m) := by
    rw [hψΦ, hψΦ, map_pow, map_pow, hΦU, ← h1, mul_pow, hv, ← pow_mul, pow_succ]
  obtain ⟨c, hc⟩ := IsLocalizedModule.exists_of_eq (S := Submonoid.powers u) h2
  obtain ⟨k, hk⟩ := (Submonoid.mem_powers_iff _ _).mp c.2
  refine ⟨σ, a, k, ?_⟩
  rw [Submonoid.smul_def, Submonoid.smul_def, ← hk, hsmulT, hsmulT] at hc
  simp only [Algebra.TensorProduct.tmul_pow, one_pow] at hc ⊢
  exact hc.symm

theorem wc_cgtnr_etale_over_domain_reduced : ∀ (D H : Type u) [CommRing D] [IsDomain D] [CommRing H] [Algebra D H] [Algebra.Etale D H], _root_.IsReduced H :=
by
  intro D H _ _ _ _ _
  haveI : _root_.IsReduced (TensorProduct D (FractionRing D) H) :=
    Algebra.FormallyUnramified.isReduced_of_field (FractionRing D)
      (TensorProduct D (FractionRing D) H)
  exact isReduced_of_injective
    (Algebra.TensorProduct.includeRight (R := D) (A := FractionRing D) (B := H))
    (Algebra.TensorProduct.includeRight_injective (IsFractionRing.injective D (FractionRing D)))

theorem wc_cgtnr_etale_prime_pullback_nzd_radical : ∀ (P G : Type u) [CommRing P] [CommRing G] [IsDomain P] (θ : P →+* G), (∀ (D H : Type u) [CommRing D] [IsDomain D] [CommRing H] [Algebra D H] [Algebra.Etale D H], _root_.IsReduced H) → θ.Etale → ∀ (t : P), Prime t → (∀ z : G, θ t * z = 0 → z = 0) ∧ (∀ (x : G) (N : ℕ), x ^ N ∈ Ideal.span {θ t} → x ∈ Ideal.span {θ t}) :=
by
  intro P G _ _ _ θ hred hθ t ht
  letI : Algebra P G := θ.toAlgebra
  haveI : Algebra.Etale P G := RingHom.etale_algebraMap.mp hθ
  have hreg : IsSMulRegular G t :=
    Module.Flat.isSMulRegular_of_isRegular (IsRegular.of_ne_zero ht.ne_zero)
  refine ⟨fun z hz => ?_, fun x N hx => ?_⟩
  · apply hreg
    show t • z = t • (0 : G)
    rw [smul_zero, Algebra.smul_def]
    exact hz
  · haveI hIp : (Ideal.span {t} : Ideal P).IsPrime := (Ideal.span_singleton_prime ht.ne_zero).mpr ht
    haveI : IsDomain (P ⧸ (Ideal.span {t} : Ideal P)) :=
      (Ideal.Quotient.isDomain_iff_prime _).mpr hIp
    haveI : Algebra.Etale (P ⧸ (Ideal.span {t} : Ideal P))
        (TensorProduct P (P ⧸ (Ideal.span {t} : Ideal P)) G) :=
      Algebra.Etale.baseChange P G (P ⧸ (Ideal.span {t} : Ideal P))
    haveI hR : IsReduced (TensorProduct P (P ⧸ (Ideal.span {t} : Ideal P)) G) :=
      hred (P ⧸ (Ideal.span {t} : Ideal P)) (TensorProduct P (P ⧸ (Ideal.span {t} : Ideal P)) G)
    let e := (Algebra.TensorProduct.quotIdealMapEquivTensorQuot G
        (Ideal.span {t} : Ideal P)).toRingEquiv.trans
      (Algebra.TensorProduct.comm P G (P ⧸ (Ideal.span {t} : Ideal P))).toRingEquiv
    haveI : IsReduced (G ⧸ Ideal.map (algebraMap P G) (Ideal.span {t} : Ideal P)) :=
      isReduced_of_injective e.toRingHom (by exact e.injective)
    have hJ : Ideal.map (algebraMap P G) (Ideal.span {t} : Ideal P) = Ideal.span {θ t} := by
      rw [Ideal.map_span, Set.image_singleton]
      rfl
    rw [← hJ] at hx ⊢
    rw [← Ideal.Quotient.eq_zero_iff_mem] at hx ⊢
    have hnil : IsNilpotent
        (Ideal.Quotient.mk (Ideal.map (algebraMap P G) (Ideal.span {t} : Ideal P)) x) :=
      ⟨N, by rw [← map_pow]; exact hx⟩
    exact hnil.eq_zero

theorem wc_cgtnr_stage_base_change_etale : ∀ (A K F : Type u) [CommRing A] [Field K] [CommRing F] (d : ℕ) (p : MvPolynomial (Option (Fin d)) A →+* F), p.Etale → ∀ (ψ : A →+* K), letI : Algebra A F := (p.comp (algebraMap A (MvPolynomial (Option (Fin d)) A))).toAlgebra; letI : Algebra A K := ψ.toAlgebra; ∃ θ : MvPolynomial (Option (Fin d)) K →+* TensorProduct A F K, θ.Etale ∧ θ (MvPolynomial.X none) = p (MvPolynomial.X none) ⊗ₜ[A] (1 : K) :=
by
  intro A K F _ _ _ d p hp ψ
  letI algAF : Algebra A F := (p.comp (algebraMap A (MvPolynomial (Option (Fin d)) A))).toAlgebra
  letI algAK : Algebra A K := ψ.toAlgebra
  letI algRF : Algebra (MvPolynomial (Option (Fin d)) A) F := p.toAlgebra
  haveI : IsScalarTower A (MvPolynomial (Option (Fin d)) A) F := IsScalarTower.of_algebraMap_eq' rfl
  haveI hEt : Algebra.Etale (MvPolynomial (Option (Fin d)) A) F := hp
  let e₁ : MvPolynomial (Option (Fin d)) K ≃+*
      TensorProduct A (MvPolynomial (Option (Fin d)) A) K :=
    (MvPolynomial.algebraTensorAlgEquiv A K).symm.toRingEquiv.trans
      (Algebra.TensorProduct.comm A K (MvPolynomial (Option (Fin d)) A)).toRingEquiv
  let Ψ : TensorProduct (MvPolynomial (Option (Fin d)) A)
      (TensorProduct A (MvPolynomial (Option (Fin d)) A) K) F ≃+* TensorProduct A F K :=
    (Algebra.TensorProduct.comm (MvPolynomial (Option (Fin d)) A)
      (TensorProduct A (MvPolynomial (Option (Fin d)) A) K) F).toRingEquiv.trans
      (Algebra.TensorProduct.cancelBaseChange A (MvPolynomial (Option (Fin d)) A)
        (MvPolynomial (Option (Fin d)) A) F K).toRingEquiv
  haveI h0 : Algebra.Etale (TensorProduct A (MvPolynomial (Option (Fin d)) A) K)
      (TensorProduct (MvPolynomial (Option (Fin d)) A)
        (TensorProduct A (MvPolynomial (Option (Fin d)) A) K) F) :=
    Algebra.Etale.baseChange _ _ _
  have h₁ : (algebraMap (TensorProduct A (MvPolynomial (Option (Fin d)) A) K)
      (TensorProduct (MvPolynomial (Option (Fin d)) A)
        (TensorProduct A (MvPolynomial (Option (Fin d)) A) K) F)).Etale :=
    RingHom.etale_algebraMap.mpr h0
  have h₂ := RingHom.Etale.respectsIso.1 _ Ψ h₁
  have h₃ := RingHom.Etale.respectsIso.2 _ e₁ h₂
  refine ⟨_, h₃, ?_⟩
  simp [e₁, Ψ, MvPolynomial.algebraTensorAlgEquiv_symm_X, Algebra.TensorProduct.comm_tmul,
    Algebra.TensorProduct.algebraMap_apply, Algebra.TensorProduct.cancelBaseChange_tmul,
    Algebra.smul_def, RingHom.algebraMap_toAlgebra]

theorem wc_cgtnr_filtered_nzd_radical : ∀ (A P K B : Type u) [CommRing A] [CommRing P] [CommRing K] [CommRing B] [Algebra A P] [Algebra A K] (β : P →+* B) (r : P) (I : Type u) [SmallCategory I] [IsFiltered I] (F : I ⥤ CommRingCat.{u}) (p : ∀ i, P →+* F.obj i) (ι : ∀ i, F.obj i →+* B), (∀ {i j : I} (f : i ⟶ j), (F.map f).hom.comp (p i) = p j) → (∀ {i j : I} (f : i ⟶ j), (ι j).comp (F.map f).hom = ι i) → (∀ i, (ι i).comp (p i) = β) → (∀ b : B, ∃ (i : I) (s : F.obj i), ι i s = b) → (∀ (i : I) (s : F.obj i), ι i s = 0 → ∃ (j : I) (f : i ⟶ j), (F.map f).hom s = 0) → letI : Algebra A B := (β.comp (algebraMap A P)).toAlgebra; Module.Flat A B → (∀ i, letI : Algebra A (F.obj i) := ((p i).comp (algebraMap A P)).toAlgebra; (∀ z : TensorProduct A (F.obj i) K, (p i r ⊗ₜ[A] (1 : K)) * z = 0 → z = 0) ∧ (∀ (x : TensorProduct A (F.obj i) K) (N : ℕ), x ^ N ∈ Ideal.span {p i r ⊗ₜ[A] (1 : K)} → x ∈ Ideal.span {p i r ⊗ₜ[A] (1 : K)})) → (∀ z : TensorProduct A B K, (β r ⊗ₜ[A] (1 : K)) * z = 0 → z = 0) ∧ (∀ (x : TensorProduct A B K) (N : ℕ), x ^ N ∈ Ideal.span {β r ⊗ₜ[A] (1 : K)} → x ∈ Ideal.span {β r ⊗ₜ[A] (1 : K)}) :=
by
  intro A P K B _ _ _ _ _ _ β r I _ _ F p ι hFp hιF hιp hsurj hkill
  intro hflat hstage
  letI algB : Algebra A B := (β.comp (algebraMap A P)).toAlgebra
  classical
  letI algF : ∀ i, Algebra A (F.obj i) := fun i => ((p i).comp (algebraMap A P)).toAlgebra
  haveI : Module.Flat A B := hflat
  have eιF : ∀ {i j : I} (f : i ⟶ j) (s : F.obj i), ι j ((F.map f).hom s) = ι i s :=
    fun f s => RingHom.congr_fun (hιF f) s
  have eFp : ∀ {i j : I} (f : i ⟶ j), (F.map f).hom (p i r) = p j r :=
    fun f => RingHom.congr_fun (hFp f) r
  have eιp : ∀ i, ι i (p i r) = β r := fun i => RingHom.congr_fun (hιp i) r
  have eFc : ∀ {i j k : I} (f : i ⟶ j) (f' : j ⟶ k) (x : F.obj i),
      (F.map (f ≫ f')).hom x = (F.map f').hom ((F.map f).hom x) := by
    intro i j k f f' x
    rw [F.map_comp]
    rfl

  let Fα : ∀ {i j : I} (f : i ⟶ j), F.obj i →ₐ[A] F.obj j := fun {i j} f =>
    { toRingHom := (F.map f).hom
      commutes' := fun a => by
        show (F.map f).hom ((p i) (algebraMap A P a)) = p j (algebraMap A P a)
        rw [← hFp f]
        rfl }
  let ια : ∀ i, F.obj i →ₐ[A] B := fun i =>
    { toRingHom := ι i
      commutes' := fun a => by
        show ι i (p i (algebraMap A P a)) = β (algebraMap A P a)
        rw [← hιp i]
        rfl }
  have hFα : ∀ {i j : I} (f : i ⟶ j) (x : F.obj i), Fα f x = (F.map f).hom x := fun _ _ => rfl
  have hια : ∀ i (x : F.obj i), ια i x = ι i x := fun _ _ => rfl
  let τ : ∀ {i j : I}, (i ⟶ j) →
      (TensorProduct A (F.obj i) K →ₐ[A] TensorProduct A (F.obj j) K) :=
    fun f => Algebra.TensorProduct.map (Fα f) (AlgHom.id A K)
  let ρ : ∀ i, TensorProduct A (F.obj i) K →ₐ[A] TensorProduct A B K :=
    fun i => Algebra.TensorProduct.map (ια i) (AlgHom.id A K)
  have hτ : ∀ {i j : I} (f : i ⟶ j) (s : F.obj i) (k : K),
      τ f (s ⊗ₜ[A] k) = (F.map f).hom s ⊗ₜ[A] k :=
    fun f s k => Algebra.TensorProduct.map_tmul (Fα f) (AlgHom.id A K) s k
  have hρ : ∀ i (s : F.obj i) (k : K), ρ i (s ⊗ₜ[A] k) = ι i s ⊗ₜ[A] k :=
    fun i s k => Algebra.TensorProduct.map_tmul (ια i) (AlgHom.id A K) s k
  have hρτ : ∀ {i j : I} (f : i ⟶ j) (x : TensorProduct A (F.obj i) K),
      ρ j (τ f x) = ρ i x := by
    intro i j f x
    induction x using TensorProduct.induction_on with
    | zero => simp only [map_zero]
    | tmul s k => rw [hτ, hρ, hρ, eιF]
    | add x y hx hy => simp only [map_add, hx, hy]
  have hτcomp : ∀ {i j k : I} (f : i ⟶ j) (f' : j ⟶ k) (x : TensorProduct A (F.obj i) K),
      τ (f ≫ f') x = τ f' (τ f x) := by
    intro i j k f f' x
    induction x using TensorProduct.induction_on with
    | zero => simp only [map_zero]
    | tmul s c => rw [hτ, hτ, hτ, eFc]
    | add x y hx hy => simp only [map_add, hx, hy]
  have ht : ∀ {i j : I} (f : i ⟶ j), τ f (p i r ⊗ₜ[A] (1 : K)) = p j r ⊗ₜ[A] (1 : K) := by
    intro i j f
    rw [hτ, eFp]
  have hρt : ∀ i, ρ i (p i r ⊗ₜ[A] (1 : K)) = β r ⊗ₜ[A] (1 : K) := by
    intro i
    rw [hρ, eιp]

  have lift1 : ∀ (b : B) (i₀ : I), ∃ (j : I) (_ : i₀ ⟶ j) (s : F.obj j), ι j s = b := by
    intro b i₀
    obtain ⟨i, s, hs⟩ := hsurj b
    exact ⟨IsFiltered.max i₀ i, IsFiltered.leftToMax i₀ i,
      (F.map (IsFiltered.rightToMax i₀ i)).hom s, by rw [eιF, hs]⟩
  have liftT : ∀ (x : TensorProduct A B K) (i₀ : I),
      ∃ (j : I) (_ : i₀ ⟶ j) (w : TensorProduct A (F.obj j) K), ρ j w = x := by
    intro x
    induction x using TensorProduct.induction_on with
    | zero => intro i₀; exact ⟨i₀, 𝟙 i₀, 0, map_zero _⟩
    | tmul b c =>
      intro i₀
      obtain ⟨j, f, s, hs⟩ := lift1 b i₀
      exact ⟨j, f, s ⊗ₜ[A] c, by rw [hρ, hs]⟩
    | add x y hx hy =>
      intro i₀
      obtain ⟨j₁, f₁, w₁, h₁⟩ := hx i₀
      obtain ⟨j₂, f₂, w₂, h₂⟩ := hy j₁
      exact ⟨j₂, f₁ ≫ f₂, τ f₂ w₁ + w₂, by rw [map_add, hρτ, h₁, h₂]⟩
  have liftFin : ∀ (s : Finset B) (i₀ : I),
      ∃ (j : I) (_ : i₀ ⟶ j) (g : B → F.obj j), ∀ b ∈ s, ι j (g b) = b := by
    intro s i₀
    induction s using Finset.induction_on with
    | empty => exact ⟨i₀, 𝟙 i₀, fun _ => 0, fun b hb => by simp at hb⟩
    | @insert a s ha ih =>
      obtain ⟨j₁, f₁, g₁, h₁⟩ := ih
      obtain ⟨j₂, f₂, x, hx⟩ := lift1 a j₁
      refine ⟨j₂, f₁ ≫ f₂, fun b => if b = a then x else (F.map f₂).hom (g₁ b), ?_⟩
      intro b hb
      dsimp only
      by_cases hba : b = a
      · rw [if_pos hba, hba]
        exact hx
      · rw [if_neg hba, eιF]
        exact h₁ b ((Finset.mem_insert.mp hb).resolve_left hba)

  have killFin : ∀ (i : I) (s : Finset (F.obj i)), (∀ x ∈ s, ι i x = 0) →
      ∃ (j : I) (f : i ⟶ j), ∀ x ∈ s, (F.map f).hom x = 0 := by
    intro i s
    induction s using Finset.induction_on with
    | empty => intro _; exact ⟨i, 𝟙 i, fun x hx => by simp at hx⟩
    | @insert a s ha ih =>
      intro h
      obtain ⟨j₁, f₁, h₁⟩ := ih (fun x hx => h x (Finset.mem_insert_of_mem hx))
      have ha0 : ι j₁ ((F.map f₁).hom a) = 0 := by
        rw [eιF]
        exact h a (Finset.mem_insert_self a s)
      obtain ⟨j₂, f₂, h₂⟩ := hkill j₁ _ ha0
      refine ⟨j₂, f₁ ≫ f₂, fun x hx => ?_⟩
      rw [eFc]
      rcases Finset.mem_insert.mp hx with rfl | hx'
      · exact h₂
      · rw [h₁ x hx', map_zero]

  have killT : ∀ (i : I) (w : TensorProduct A (F.obj i) K), ρ i w = 0 →
      ∃ (j : I) (f : i ⟶ j), τ f w = 0 := by
    intro i w hw
    obtain ⟨S, hS⟩ := TensorProduct.exists_finset w
    let m : S → F.obj i := fun q => q.1.1
    let c : S → K := fun q => q.1.2
    have hw' : w = ∑ q : S, m q ⊗ₜ[A] c q := by
      rw [hS]
      exact (Finset.sum_coe_sort S (fun q => q.1 ⊗ₜ[A] q.2)).symm
    have h0 : ∑ q : S, c q ⊗ₜ[A] ι i (m q) = 0 := by
      have e1 : ρ i w = ∑ q : S, ι i (m q) ⊗ₜ[A] c q := by
        rw [hw', map_sum]
        simp only [hρ]
      have e2 := congrArg (TensorProduct.comm A B K) (e1.symm.trans hw)
      rw [map_sum, map_zero] at e2
      simpa only [TensorProduct.comm_tmul] using e2
    have hinj := Module.Flat.rTensor_preserves_injective_linearMap (M := B)
      (Submodule.span A (Set.range c)).subtype (Submodule.injective_subtype _)
    obtain ⟨k, a, y, hy, ha⟩ :=
      TensorProduct.vanishesTrivially_of_sum_tmul_eq_zero_of_rTensor_injective A
        (m := c) (n := fun q => ι i (m q)) hinj h0
    obtain ⟨j, f, g, hg⟩ := liftFin (Finset.univ.image y) i
    let wv : Fin k → F.obj j := fun l => g (y l)
    have hwv : ∀ l, ι j (wv l) = y l :=
      fun l => hg (y l) (Finset.mem_image_of_mem y (Finset.mem_univ l))
    let d : S → F.obj j := fun q => Fα f (m q) - ∑ l, a q l • wv l
    have hd : ∀ q, ι j (d q) = 0 := by
      intro q
      change ια j (Fα f (m q) - ∑ l, a q l • wv l) = 0
      rw [map_sub, map_sum]
      have e3 : ∀ l, ια j (a q l • wv l) = a q l • y l := fun l => by
        rw [map_smul, hια, hwv]
      simp only [e3]
      rw [hια, hFα, eιF, sub_eq_zero]
      exact hy q
    obtain ⟨j', f', hf'⟩ := killFin j (Finset.univ.image d) (fun x hx => by
      obtain ⟨q, _, rfl⟩ := Finset.mem_image.mp hx
      exact hd q)
    have hdk : ∀ q, Fα f' (Fα f (m q)) = ∑ l, a q l • Fα f' (wv l) := by
      intro q
      have h1 := hf' (d q) (Finset.mem_image_of_mem d (Finset.mem_univ q))
      change Fα f' (Fα f (m q) - ∑ l, a q l • wv l) = 0 at h1
      rw [map_sub, map_sum, sub_eq_zero] at h1
      simpa only [map_smul] using h1
    refine ⟨j', f ≫ f', ?_⟩
    have hτ' : ∀ (s : F.obj i) (x : K), τ (f ≫ f') (s ⊗ₜ[A] x) = Fα f' (Fα f s) ⊗ₜ[A] x := by
      intro s x
      rw [hτcomp, hτ, hτ]
      rfl
    rw [hw', map_sum]
    simp only [hτ', hdk, TensorProduct.sum_tmul, TensorProduct.smul_tmul]
    rw [Finset.sum_comm]
    simp only [← TensorProduct.tmul_sum, ha, TensorProduct.tmul_zero, Finset.sum_const_zero]

  obtain ⟨i₀⟩ := IsFiltered.nonempty (C := I)
  refine ⟨?_, ?_⟩
  · intro z hz
    obtain ⟨j, _, w, hw⟩ := liftT z i₀
    have h1 : ρ j (p j r ⊗ₜ[A] (1 : K) * w) = 0 := by
      rw [map_mul, hρt, hw, hz]
    obtain ⟨k, f, hf⟩ := killT j _ h1
    rw [map_mul, ht] at hf
    have h2 : τ f w = 0 := (hstage k).1 _ hf
    rw [← hw, ← hρτ f w, h2, map_zero]
  · intro x N hx
    obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp hx
    obtain ⟨i, _, w, hw⟩ := liftT x i₀
    obtain ⟨j, f, c', hc'⟩ := liftT c i
    have h1 : ρ j ((τ f w) ^ N - c' * (p j r ⊗ₜ[A] (1 : K))) = 0 := by
      rw [map_sub, map_pow, map_mul, hρτ, hw, hc', hρt, hc, sub_self]
    obtain ⟨k, h, hh⟩ := killT j _ h1
    rw [map_sub, map_pow, map_mul, ht, sub_eq_zero] at hh
    have h2 : (τ h (τ f w)) ^ N ∈ Ideal.span {p k r ⊗ₜ[A] (1 : K)} :=
      Ideal.mem_span_singleton'.mpr ⟨τ h c', hh.symm⟩
    obtain ⟨dd, hdd⟩ := Ideal.mem_span_singleton'.mp ((hstage k).2 _ N h2)
    refine Ideal.mem_span_singleton'.mpr ⟨ρ k dd, ?_⟩
    rw [← hρt k, ← map_mul, hdd, hρτ, hρτ, hw]

theorem wc_cgtnr_tensor_nonunit_of_prime : ∀ (A B K : Type u) [CommRing A] [CommRing B] [Field K] [Algebra A B] (ψ : A →+* K) (Q : Ideal B), Q.IsPrime → ∀ (w : B), w ∈ Q → Q.comap (algebraMap A B) = RingHom.ker ψ → letI : Algebra A K := ψ.toAlgebra; ¬ IsUnit (w ⊗ₜ[A] (1 : K)) :=
by
  intro A B K _ _ _ _ ψ Q hQ w hw hc
  letI algK : Algebra A K := ψ.toAlgebra
  intro hunit
  have h : ∀ a ∈ Q.comap (algebraMap A B), ψ a = 0 := fun a ha => by
    rw [hc] at ha; exact ha
  have hle : RingHom.ker ψ ≤ Q.comap (algebraMap A B) := hc.ge
  letI algpK : Algebra (A ⧸ Q.comap (algebraMap A B)) K :=
    (Ideal.Quotient.lift (Q.comap (algebraMap A B)) ψ h).toAlgebra
  haveI : Q.IsPrime := hQ
  haveI hnt : Nontrivial (TensorProduct (A ⧸ Q.comap (algebraMap A B)) (B ⧸ Q) K) :=
    Algebra.TensorProduct.nontrivial_of_algebraMap_injective_of_isDomain
      (A ⧸ Q.comap (algebraMap A B)) (B ⧸ Q) K
      Ideal.algebraMap_quotient_injective
      (RingHom.lift_injective_of_ker_le_ideal (Q.comap (algebraMap A B)) h hle)
  let f : B →+* TensorProduct (A ⧸ Q.comap (algebraMap A B)) (B ⧸ Q) K :=
    Algebra.TensorProduct.includeLeftRingHom.comp (Ideal.Quotient.mk Q)
  let g : K →+* TensorProduct (A ⧸ Q.comap (algebraMap A B)) (B ⧸ Q) K :=
    Algebra.TensorProduct.includeRight.toRingHom
  letI algC : Algebra A (TensorProduct (A ⧸ Q.comap (algebraMap A B)) (B ⧸ Q) K) :=
    (g.comp ψ).toAlgebra
  have hcompat : ∀ a : A, f (algebraMap A B a) = g (ψ a) := by
    intro a
    show (Ideal.Quotient.mk Q (algebraMap A B a)) ⊗ₜ[A ⧸ Q.comap (algebraMap A B)] (1 : K) =
      (1 : B ⧸ Q) ⊗ₜ[A ⧸ Q.comap (algebraMap A B)] ψ a
    have e1 : Ideal.Quotient.mk Q (algebraMap A B a) =
        algebraMap (A ⧸ Q.comap (algebraMap A B)) (B ⧸ Q) (Ideal.Quotient.mk _ a) := rfl
    have e2 : ψ a = algebraMap (A ⧸ Q.comap (algebraMap A B)) K (Ideal.Quotient.mk _ a) := rfl
    rw [e1, e2, Algebra.algebraMap_eq_smul_one, Algebra.algebraMap_eq_smul_one,
      TensorProduct.smul_tmul]
  let f' : B →ₐ[A] TensorProduct (A ⧸ Q.comap (algebraMap A B)) (B ⧸ Q) K :=
    { f with commutes' := fun a => hcompat a }
  let g' : K →ₐ[A] TensorProduct (A ⧸ Q.comap (algebraMap A B)) (B ⧸ Q) K :=
    { g with commutes' := fun a => rfl }
  let Φ := Algebra.TensorProduct.productMap f' g'
  have hf'w : f' w = 0 := by
    show (Ideal.Quotient.mk Q w) ⊗ₜ[A ⧸ Q.comap (algebraMap A B)] (1 : K) = 0
    rw [Ideal.Quotient.eq_zero_iff_mem.mpr hw, TensorProduct.zero_tmul]
  have hΦ : Φ (w ⊗ₜ[A] (1 : K)) = 0 := by
    rw [Algebra.TensorProduct.productMap_apply_tmul, hf'w, zero_mul]
  have h0 := hunit.map Φ
  rw [hΦ] at h0
  exact not_isUnit_zero h0

theorem wc_cgtnr_generic_prime_through_divisor : ∀ (A : Type u) [CommRing A] [IsDomain A] (d : ℕ) (B : Type u) [CommRing B] [IsLocalRing B] (β : MvPolynomial (Option (Fin d)) A →+* B), β (MvPolynomial.X none) ∈ IsLocalRing.maximalIdeal B → (letI : Algebra (MvPolynomial (Option (Fin d)) A) B := β.toAlgebra; Module.Flat (MvPolynomial (Option (Fin d)) A) B) → ∃ Q : Ideal B, Q.IsPrime ∧ β (MvPolynomial.X none) ∈ Q ∧ Q.comap (β.comp (algebraMap A (MvPolynomial (Option (Fin d)) A))) = ⊥ :=
by
  intro A _ _ d B _ _ β hX hflat
  letI : Algebra (MvPolynomial (Option (Fin d)) A) B := β.toAlgebra
  haveI : Module.Flat (MvPolynomial (Option (Fin d)) A) B := hflat
  haveI : Algebra.HasGoingDown (MvPolynomial (Option (Fin d)) A) B :=
    Algebra.HasGoingDown.of_flat
  have hXp : Prime (MvPolynomial.X none : MvPolynomial (Option (Fin d)) A) :=
    MvPolynomial.X_prime
  have hPp : (Ideal.span {(MvPolynomial.X none : MvPolynomial (Option (Fin d)) A)}).IsPrime :=
    (Ideal.span_singleton_prime hXp.ne_zero).mpr hXp
  have hPC : (Ideal.span {(MvPolynomial.X none : MvPolynomial (Option (Fin d)) A)}).comap
      (algebraMap A (MvPolynomial (Option (Fin d)) A)) = ⊥ := by
    refine (Submodule.eq_bot_iff _).mpr ?_
    intro a ha
    rw [Ideal.mem_comap, Ideal.mem_span_singleton] at ha
    obtain ⟨f, hf⟩ := ha
    have h := congrArg MvPolynomial.constantCoeff hf
    rw [MvPolynomial.algebraMap_eq, MvPolynomial.constantCoeff_C, map_mul,
      MvPolynomial.constantCoeff_X, zero_mul] at h
    exact h
  haveI hqp : (Ideal.comap β (IsLocalRing.maximalIdeal B)).IsPrime :=
    Ideal.comap_isPrime β _
  haveI hlo : (IsLocalRing.maximalIdeal B).LiesOver (Ideal.comap β (IsLocalRing.maximalIdeal B)) :=
    ⟨rfl⟩
  have hPq : Ideal.span {(MvPolynomial.X none : MvPolynomial (Option (Fin d)) A)} ≤
      Ideal.comap β (IsLocalRing.maximalIdeal B) := by
    rw [Ideal.span_singleton_le_iff_mem, Ideal.mem_comap]
    exact hX
  obtain ⟨Q, -, hQp, hQl⟩ :=
    @Ideal.exists_ideal_le_liesOver_of_le _ _ _ _ _ _ _ _ hPp hqp (IsLocalRing.maximalIdeal B) _ hlo
      hPq
  have hPQ : Ideal.span {(MvPolynomial.X none : MvPolynomial (Option (Fin d)) A)} =
      Ideal.comap β Q := hQl.over
  refine ⟨Q, hQp, ?_, ?_⟩
  · have hmem : (MvPolynomial.X none : MvPolynomial (Option (Fin d)) A) ∈
        Ideal.span {(MvPolynomial.X none : MvPolynomial (Option (Fin d)) A)} :=
      Ideal.subset_span rfl
    rw [hPQ, Ideal.mem_comap] at hmem
    exact hmem
  · rw [← Ideal.comap_comap, ← hPQ, hPC]

theorem wc_cpt_geom_tube_no_root : ∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] [IsDomain A] [IsDiscreteValuationRing A] (ℓ : ℕ), ℓ.Prime → IsUnit ((ℓ : ℕ) : A) → ∀ (d : ℕ) (y : Spec (.of (MvPolynomial (Option (Fin d)) A))), Spec.map (CommRingCat.ofHom (algebraMap A (MvPolynomial (Option (Fin d)) A))) y = IsLocalRing.closedPoint A → (MvPolynomial.X none : MvPolynomial (Option (Fin d)) A) ∈ y.asIdeal → ∀ (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (MvPolynomial (Option (Fin d)) A))) y)) (Scheme.Etale.forget (Spec (.of (MvPolynomial (Option (Fin d)) A))))) (φ : ∀ l, Spec (.of B) ⟶ (W'.obj l).right.left) (a : Spec (.of B) ⟶ Spec (.of (MvPolynomial (Option (Fin d)) A))), wcHalShData y B Λ W' φ a → ∀ (β : MvPolynomial (Option (Fin d)) A →+* B), Spec.map (CommRingCat.ofHom β) = a → ∀ (K : Type u) [Field K] [IsSepClosed K] (ζ : Spec (.of K) ⟶ Spec (.of A)), letI : Algebra A (Localization.Away (β (MvPolynomial.X none))) := ((algebraMap B (Localization.Away (β (MvPolynomial.X none)))).comp (β.comp (algebraMap A (MvPolynomial (Option (Fin d)) A)))).toAlgebra; letI : Algebra A K := (Spec.preimage ζ).hom.toAlgebra; ∀ v : TensorProduct A (Localization.Away (β (MvPolynomial.X none))) K, v ^ ℓ ≠ (algebraMap B (Localization.Away (β (MvPolynomial.X none))) (β (MvPolynomial.X none))) ⊗ₜ[A] (1 : K) :=
by
  intro A _ _ _ _ _ ℓ hℓ hunit d y hy hy0 B _ _ _ Λ _ _ W' φ a ha β hβ K _ _ ζ
  letI algC : Algebra A (Localization.Away (β (MvPolynomial.X none))) :=
    ((algebraMap B (Localization.Away (β (MvPolynomial.X none)))).comp
      (β.comp (algebraMap A (MvPolynomial (Option (Fin d)) A)))).toAlgebra
  letI algK : Algebra A K := (Spec.preimage ζ).hom.toAlgebra
  intro v hv
  classical

  have s1 : ∀ (S : Type u) [CommRing S] (t : S), (∀ z : S, t * z = 0 → z = 0) →
      (∀ (x : S) (N : ℕ), x ^ N ∈ Ideal.span {t} → x ∈ Ideal.span {t}) → ¬ IsUnit t →
      ∀ (m : ℕ), 2 ≤ m → ∀ (s : S) (n k : ℕ), t ^ k * s ^ m = t ^ k * t ^ (n * m + 1) → False := by
    intro S _ t hnzd hrad hnu m hm s n k hk
    have cancel : ∀ (j : ℕ) (x z : S), t ^ j * x = t ^ j * z → x = z := by
      intro j
      induction j with
      | zero => intro x z h; simpa using h
      | succ j ih =>
        intro x z h
        apply ih
        have h1 : t * (t ^ j * x - t ^ j * z) = 0 := by
          linear_combination h
        exact sub_eq_zero.mp (hnzd _ h1)
    have hs := cancel k _ _ hk
    clear hk
    obtain ⟨m', rfl⟩ : ∃ m', m = m' + 2 := ⟨m - 2, by omega⟩
    induction n generalizing s with
    | zero =>
      have hmem : s ^ (m' + 2) ∈ Ideal.span {t} := by
        rw [hs]; exact Ideal.subset_span (by simp)
      obtain ⟨b, hb⟩ := Ideal.mem_span_singleton'.mp (hrad s (m' + 2) hmem)
      apply hnu
      rw [← hb] at hs
      have h1 : t * (t ^ (m' + 1) * b ^ (m' + 2) - 1) = 0 := by
        linear_combination hs
      have h2 : t ^ (m' + 1) * b ^ (m' + 2) = 1 := sub_eq_zero.mp (hnzd _ h1)
      exact IsUnit.of_mul_eq_one (t ^ m' * b ^ (m' + 2)) (by linear_combination h2)
    | succ n ih =>
      have hmem : s ^ (m' + 2) ∈ Ideal.span {t} := by
        rw [Ideal.mem_span_singleton']
        exact ⟨t ^ ((n + 1) * (m' + 2)), by rw [hs]; ring⟩
      obtain ⟨b, hb⟩ := Ideal.mem_span_singleton'.mp (hrad s (m' + 2) hmem)
      apply ih b
      apply cancel (m' + 2)
      rw [← hb] at hs
      linear_combination hs

  letI algB : Algebra A B := (β.comp (algebraMap A (MvPolynomial (Option (Fin d)) A))).toAlgebra
  have hST := @IsScalarTower.of_algebraMap_eq' A B (Localization.Away (β (MvPolynomial.X none)))
    _ _ _ algB _ algC rfl
  obtain ⟨σ, n, k, hk⟩ := @wc_cgtnr_localization_root_descend A B
    (Localization.Away (β (MvPolynomial.X none))) K _ _ _ _ algB _ algC hST algK
    (β (MvPolynomial.X none)) _ ℓ v hv

  obtain ⟨β', hβ', I, _, _, F, p, ι, hEt, hFp, hιF, hιp, hsurj, hkill⟩ :=
    wc_shdata_filtered_etale_presentation y B Λ W' φ a ha (MvPolynomial (Option (Fin d)) A)
      (Iso.refl _)
  have hββ : β' = β := by
    have h1 : Spec.map (CommRingCat.ofHom β') = Spec.map (CommRingCat.ofHom β) := by
      rw [hβ', hβ, Iso.refl_hom, Category.comp_id]
    have h2 := Spec.map_injective h1
    exact congrArg CommRingCat.Hom.hom h2
  subst hββ

  letI algRB : Algebra (MvPolynomial (Option (Fin d)) A) B := β'.toAlgebra
  have hflatRB : Module.Flat (MvPolynomial (Option (Fin d)) A) B :=
    (wc_ring_fep_flat_and_base_change (MvPolynomial (Option (Fin d)) A) B
      (MvPolynomial (Option (Fin d)) A) I F p ι hEt hFp hιF (fun i => hιp i) hsurj hkill).1
  haveI : IsScalarTower A (MvPolynomial (Option (Fin d)) A) B := IsScalarTower.of_algebraMap_eq' rfl
  have hflatAB : Module.Flat A B := Module.Flat.trans A (MvPolynomial (Option (Fin d)) A) B

  have hstage : ∀ i, letI : Algebra A (F.obj i) :=
      ((p i).comp (algebraMap A (MvPolynomial (Option (Fin d)) A))).toAlgebra;
      (∀ z : TensorProduct A (F.obj i) K,
        (p i (MvPolynomial.X none) ⊗ₜ[A] (1 : K)) * z = 0 → z = 0) ∧
      (∀ (x : TensorProduct A (F.obj i) K) (N : ℕ),
        x ^ N ∈ Ideal.span {p i (MvPolynomial.X none) ⊗ₜ[A] (1 : K)} →
        x ∈ Ideal.span {p i (MvPolynomial.X none) ⊗ₜ[A] (1 : K)}) := by
    intro i
    letI : Algebra A (F.obj i) :=
      ((p i).comp (algebraMap A (MvPolynomial (Option (Fin d)) A))).toAlgebra
    obtain ⟨θ, hθ, hθX⟩ := wc_cgtnr_stage_base_change_etale A K (F.obj i) d (p i) (hEt i)
      (Spec.preimage ζ).hom
    have h := wc_cgtnr_etale_prime_pullback_nzd_radical (MvPolynomial (Option (Fin d)) K) _ θ
      wc_cgtnr_etale_over_domain_reduced hθ (MvPolynomial.X none) MvPolynomial.X_prime
    rw [hθX] at h
    exact h

  have hte := wc_cgtnr_filtered_nzd_radical A (MvPolynomial (Option (Fin d)) A) K B β'
    (MvPolynomial.X none) I F p ι hFp hιF hιp hsurj hkill hflatAB hstage

  have hres : ∀ x : Spec (.of (IsLocalRing.ResidueField B)),
      Spec.map (CommRingCat.ofHom (IsLocalRing.residue B)) x = IsLocalRing.closedPoint B := by
    intro x
    apply PrimeSpectrum.ext
    change Ideal.comap (IsLocalRing.residue B) x.asIdeal = IsLocalRing.maximalIdeal B
    haveI := x.isPrime
    rw [Ideal.eq_bot_of_prime x.asIdeal, ← RingHom.ker_eq_comap_bot, IsLocalRing.ker_residue]
  have hclosed : a (IsLocalRing.closedPoint B) = y := by
    obtain ⟨e, -, he⟩ := ha.2.2.2.2.2
    let pt : ↥(Spec (.of (AlgebraicClosure
        ((Spec (.of (MvPolynomial (Option (Fin d)) A))).residueField y)))) :=
      IsLocalRing.closedPoint _
    have h1 : (Spec.map (CommRingCat.ofHom e) ≫ Spec.map (CommRingCat.ofHom
        (IsLocalRing.residue B)) ≫ a) pt = (wcEtGeomPt _ y) pt := by rw [he]
    rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply, hres] at h1
    rw [h1]
    simp only [wcEtGeomPt, Scheme.Hom.comp_apply]
    exact Scheme.fromSpecResidueField_apply y _
  have hyI : y.asIdeal = Ideal.comap β' (IsLocalRing.maximalIdeal B) := by
    rw [← hclosed, ← hβ]
    rfl
  have hu : β' (MvPolynomial.X none) ∈ IsLocalRing.maximalIdeal B := by
    have h := hy0
    rw [hyI] at h
    exact h
  have hnu : ¬ IsUnit (β' (MvPolynomial.X none) ⊗ₜ[A] (1 : K)) := by
    by_cases hbot : RingHom.ker (Spec.preimage ζ).hom = ⊥
    · obtain ⟨Q, hQ, huQ, hQc⟩ := wc_cgtnr_generic_prime_through_divisor A d B β' hu hflatRB
      exact wc_cgtnr_tensor_nonunit_of_prime A B K (Spec.preimage ζ).hom Q hQ
        (β' (MvPolynomial.X none)) huQ (by rw [hbot]; exact hQc)
    · have hc : Ideal.comap (algebraMap A B) (IsLocalRing.maximalIdeal B) =
          IsLocalRing.maximalIdeal A := by
        change Ideal.comap (β'.comp (algebraMap A (MvPolynomial (Option (Fin d)) A))) _ = _
        rw [← Ideal.comap_comap, ← hyI]
        exact congrArg PrimeSpectrum.asIdeal hy
      have hmax : RingHom.ker (Spec.preimage ζ).hom = IsLocalRing.maximalIdeal A :=
        IsLocalRing.eq_maximalIdeal ((RingHom.ker_isPrime (Spec.preimage ζ).hom).isMaximal hbot)
      exact wc_cgtnr_tensor_nonunit_of_prime A B K (Spec.preimage ζ).hom
        (IsLocalRing.maximalIdeal B) (IsLocalRing.maximalIdeal.isMaximal B).isPrime
        (β' (MvPolynomial.X none)) hu (by rw [hc, hmax])

  exact s1 (TensorProduct A B K) (β' (MvPolynomial.X none) ⊗ₜ[A] (1 : K)) hte.1 hte.2 hnu ℓ
    hℓ.two_le σ n k hk

theorem wc_cpt_tube_pull_deg1_ne_zero : ∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] [IsDomain A] [IsDiscreteValuationRing A] (ℓ : ℕ), ℓ.Prime → IsUnit ((ℓ : ℕ) : A) → ∀ (d : ℕ) (y : Spec (.of (MvPolynomial (Option (Fin d)) A))), Spec.map (CommRingCat.ofHom (algebraMap A (MvPolynomial (Option (Fin d)) A))) y = IsLocalRing.closedPoint A → (MvPolynomial.X none : MvPolynomial (Option (Fin d)) A) ∈ y.asIdeal → ∀ (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (MvPolynomial (Option (Fin d)) A))) y)) (Scheme.Etale.forget (Spec (.of (MvPolynomial (Option (Fin d)) A))))) (φ : ∀ l, Spec (.of B) ⟶ (W'.obj l).right.left) (a : Spec (.of B) ⟶ Spec (.of (MvPolynomial (Option (Fin d)) A))), wcHalShData y B Λ W' φ a → ∀ (β : MvPolynomial (Option (Fin d)) A →+* B), Spec.map (CommRingCat.ofHom β) = a → ∀ (K : Type u) [Field K] [IsSepClosed K] (ζ : Spec (.of K) ⟶ Spec (.of A)) (D : wcEtPullData (Limits.pullback.fst (Spec.map (CommRingCat.ofHom ((algebraMap B (Localization.Away (β (MvPolynomial.X none)))).comp (β.comp (algebraMap A (MvPolynomial (Option (Fin d)) A)))))) ζ) ℓ), ∃ x, wcEtPull D 1 x ≠ 0 :=
by
  intro A _ _ _ _ _ ℓ hℓ hunit d y hy hy0 B _ _ _ Λ _ _ W' φ a ha β hβ K _ _ ζ D
  classical

  obtain ⟨ω, hω⟩ := wc_henselian_sepClosed_primitive_root A ℓ hunit

  have h1 : (((algebraMap B (Localization.Away (β (MvPolynomial.X none)))).comp
      (β.comp (algebraMap A (MvPolynomial (Option (Fin d)) A)))) ω) ^ ℓ = 1 := by
    rw [← map_pow, hω.pow_eq_one, map_one]
  have h2 : ∀ i : ℕ, 0 < i → i < ℓ → IsUnit (1 - (((algebraMap B
      (Localization.Away (β (MvPolynomial.X none)))).comp
      (β.comp (algebraMap A (MvPolynomial (Option (Fin d)) A)))) ω) ^ i) := by
    intro i hi0 hiℓ
    have hprim : IsPrimitiveRoot (ω ^ i) ℓ :=
      hω.pow_of_coprime i (Nat.coprime_of_lt_prime hi0.ne' hiℓ hℓ).symm
    have hsum : ∑ j ∈ Finset.range ℓ, (ω ^ i) ^ j = 0 := hprim.geom_sum_eq_zero hℓ.one_lt
    have hdvd : (1 - ω ^ i) ∣ ((ℓ : ℕ) : A) := by
      have e : ((ℓ : ℕ) : A) = ∑ j ∈ Finset.range ℓ, (1 - (ω ^ i) ^ j) := by
        rw [Finset.sum_sub_distrib, hsum, sub_zero, Finset.sum_const, Finset.card_range,
          nsmul_eq_mul, mul_one]
      rw [e]
      exact Finset.dvd_sum (fun j _ => one_sub_dvd_one_sub_pow _ _)
    have hu : IsUnit (1 - ω ^ i) := isUnit_of_dvd_unit hdvd hunit
    have hu' := hu.map ((algebraMap B (Localization.Away (β (MvPolynomial.X none)))).comp
      (β.comp (algebraMap A (MvPolynomial (Option (Fin d)) A))))
    rwa [map_sub, map_one, map_pow] at hu'
  have h3 : IsUnit ((ℓ : ℕ) : Localization.Away (β (MvPolynomial.X none))) := by
    have hu' := hunit.map ((algebraMap B (Localization.Away (β (MvPolynomial.X none)))).comp
      (β.comp (algebraMap A (MvPolynomial (Option (Fin d)) A))))
    rwa [map_natCast] at hu'
  have h4 : IsUnit (algebraMap B (Localization.Away (β (MvPolynomial.X none)))
      (β (MvPolynomial.X none))) :=
    IsLocalization.Away.algebraMap_isUnit _

  obtain ⟨tor, htor⟩ := wc_cpt_kummer_ring_torsor (Localization.Away (β (MvPolynomial.X none)))
    ℓ hℓ h3 _ h1 h2 _ h4

  refine wc_et_torsor_class_pull_nonzero _ _ ℓ hℓ tor htor ?_ D
  rintro ⟨σ, hσ⟩
  have hv := wc_cpt_spec_pullback_root_transfer A (Localization.Away (β (MvPolynomial.X none))) K
    ((algebraMap B (Localization.Away (β (MvPolynomial.X none)))).comp
      (β.comp (algebraMap A (MvPolynomial (Option (Fin d)) A)))) ζ ℓ _ σ hσ
  obtain ⟨v, hv⟩ := hv
  exact wc_cpt_geom_tube_no_root A ℓ hℓ hunit d y hy hy0 B Λ W' φ a ha β hβ K ζ v hv

theorem wc_coord_punct_tube_fibre_restr_bij : ∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] [IsDomain A] [IsDiscreteValuationRing A] (ℓ : ℕ), ℓ.Prime → IsUnit ((ℓ : ℕ) : A) → ∀ (d : ℕ) (y : Spec (.of (MvPolynomial (Option (Fin d)) A))), Spec.map (CommRingCat.ofHom (algebraMap A (MvPolynomial (Option (Fin d)) A))) y = IsLocalRing.closedPoint A → (MvPolynomial.X none : MvPolynomial (Option (Fin d)) A) ∈ y.asIdeal → ∀ (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (MvPolynomial (Option (Fin d)) A))) y)) (Scheme.Etale.forget (Spec (.of (MvPolynomial (Option (Fin d)) A))))) (φ : ∀ l, Spec (.of B) ⟶ (W'.obj l).right.left) (a : Spec (.of B) ⟶ Spec (.of (MvPolynomial (Option (Fin d)) A))), wcHalShData y B Λ W' φ a → ∀ (β : MvPolynomial (Option (Fin d)) A →+* B), Spec.map (CommRingCat.ofHom β) = a → ∀ (K : Type u) [Field K] [IsSepClosed K] (ζ : Spec (.of K) ⟶ Spec (.of A)) (D : wcEtPullData (Limits.pullback.fst (Spec.map (CommRingCat.ofHom ((algebraMap B (Localization.Away (β (MvPolynomial.X none)))).comp (β.comp (algebraMap A (MvPolynomial (Option (Fin d)) A)))))) ζ) ℓ) (q : ℕ), Function.Bijective (wcEtPull D q) :=
by
  intro A _ _ _ _ _ ℓ hℓ hunit d y hy hy0 B _ _ _ Λ _ _ W' φ a ha β hβ K _ _ ζ D q
  classical
  have h2 := wc_cpt_tube_low A ℓ hℓ hunit d y hy hy0 B Λ W' φ a ha β hβ
  have h3 := wc_cpt_tube_high A ℓ hℓ hunit d y hy hy0 B Λ W' φ a ha β hβ
  have h4 := wc_cpt_geom_tube_low A ℓ hℓ hunit d y hy hy0 B Λ W' φ a ha β hβ K ζ
  have h5 := wc_cpt_geom_tube_high A ℓ hℓ hunit d y hy hy0 B Λ W' φ a ha β hβ K ζ
  have h6 := wc_cpt_tube_pull_deg1_ne_zero A ℓ hℓ hunit d y hy hy0 B Λ W' φ a ha β hβ K ζ D
  have e : ∀ (Y : Scheme.{u}) (i : ℕ), Nat.card (wcEtZModExt Y ℓ i) = Nat.card (wcEtCoh Y ℓ i) :=
    fun Y i => Nat.card_congr (wc_et_zmodext_coh_equiv Y ℓ i).some

  have key : ∀ {G₀ G₁ : Type (u+2)} [AddGroup G₀] [AddGroup G₁] (F : G₀ →+ G₁),
      Nat.card G₀ = ℓ → Nat.card G₁ = ℓ → (∃ x, F x ≠ 0) → Function.Bijective F := by
    intro G₀ G₁ _ _ F h0 h1 hx
    obtain ⟨x, hx⟩ := hx
    have hℓ0 : ℓ ≠ 0 := hℓ.ne_zero
    haveI : Finite G₀ := Nat.finite_of_card_ne_zero (by rw [h0]; exact hℓ0)
    haveI : Finite G₁ := Nat.finite_of_card_ne_zero (by rw [h1]; exact hℓ0)
    have hdvd := AddSubgroup.card_addSubgroup_dvd_card F.ker
    rw [h0] at hdvd
    rcases hℓ.eq_one_or_self_of_dvd _ hdvd with hk | hk
    · have hinj : Function.Injective F :=
        (AddMonoidHom.ker_eq_bot_iff F).mp (AddSubgroup.eq_bot_of_card_eq _ hk)
      exact hinj.bijective_of_nat_card_le (by rw [h0, h1])
    · exfalso
      have htop : F.ker = ⊤ := (AddSubgroup.card_eq_iff_eq_top F.ker).mp (by rw [hk, h0])
      apply hx
      have hmem : x ∈ F.ker := by rw [htop]; exact AddSubgroup.mem_top x
      exact AddMonoidHom.mem_ker.mp hmem

  have nz : ∀ (Y : Scheme.{u}), Nat.card (wcEtZModExt Y ℓ 0) = ℓ →
      (@Abelian.Ext.mk₀ _ _ _ (HasExt.standard _) _ _
        (𝟙 (SheafOfModules.unit (wcEtZModRing Y ℓ))) : wcEtZModExt Y ℓ 0) ≠ 0 := by
    intro Y hY h0
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Y ℓ)) := HasExt.standard _
    have hz : ∀ z : wcEtZModExt Y ℓ 0, z = 0 := by
      intro z
      rw [← Abelian.Ext.mk₀_id_comp z, h0, Abelian.Ext.zero_comp]
    haveI : Subsingleton (wcEtZModExt Y ℓ 0) := ⟨fun z₁ z₂ => (hz z₁).trans (hz z₂).symm⟩
    have hc : Nat.card (wcEtZModExt Y ℓ 0) = 1 := Nat.card_eq_one_iff_unique.mpr ⟨inferInstance, ⟨0⟩⟩
    have := hℓ.one_lt
    omega
  match q with
  | 0 =>
    have hT := (e _ 0).trans h2.1
    have hTK := (e _ 0).trans h4.1
    refine key (wcEtPull D 0) hT hTK ⟨@Abelian.Ext.mk₀ _ _ _ (HasExt.standard _) _ _ (𝟙 _), ?_⟩
    have hx : wcEtPull D 0 (@Abelian.Ext.mk₀ _ _ _ (HasExt.standard _) _ _ (𝟙 _)) =
        @Abelian.Ext.mk₀ _ _ _ (HasExt.standard _) _ _ (𝟙 _) := by
      unfold wcEtPull
      simp only [AddMonoidHom.comp_apply, Functor.mapExtAddHom_apply,
        Abelian.Ext.mapExactFunctor_mk₀, Functor.map_id]
      simp only [Abelian.Ext.precomp, Abelian.Ext.postcomp, AddMonoidHom.flip_apply,
        Abelian.Ext.bilinearComp_apply_apply, Abelian.Ext.mk₀_comp_mk₀, Category.id_comp,
        Iso.inv_hom_id]
      have hid : D.μ.inv ≫ D.Φ.map (𝟙 _) ≫ D.μ.hom = 𝟙 _ := by
        rw [CategoryTheory.Functor.map_id, Category.id_comp, Iso.inv_hom_id]
      exact congrArg _ hid
    rw [hx]
    exact nz _ hTK
  | 1 =>
    exact key (wcEtPull D 1) ((e _ 1).trans h2.2) ((e _ 1).trans h4.2) h6
  | q + 2 =>
    haveI h3' := h3 (q + 2) (by omega)
    haveI h5' := h5 (q + 2) (by omega)
    haveI s0 := (wc_et_zmodext_coh_equiv
      (Spec (.of (Localization.Away (β (MvPolynomial.X none))))) ℓ (q + 2)).some.subsingleton
    haveI s1 := (wc_et_zmodext_coh_equiv (Limits.pullback (Spec.map (CommRingCat.ofHom
      ((algebraMap B (Localization.Away (β (MvPolynomial.X none)))).comp
        (β.comp (algebraMap A (MvPolynomial (Option (Fin d)) A)))))) ζ) ℓ (q + 2)).some.subsingleton
    refine ⟨fun x₁ x₂ _ => Subsingleton.elim x₁ x₂, fun z => ⟨0, Subsingleton.elim _ _⟩⟩

theorem wc_qmb_tube_purity_transport : ∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] [IsDomain A] [IsDiscreteValuationRing A] (ℓ : ℕ), (∀ (d : ℕ) (y : Spec (.of (MvPolynomial (Option (Fin d)) A))), Spec.map (CommRingCat.ofHom (algebraMap A (MvPolynomial (Option (Fin d)) A))) y = IsLocalRing.closedPoint A → (MvPolynomial.X none : MvPolynomial (Option (Fin d)) A) ∈ y.asIdeal → ∀ (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (MvPolynomial (Option (Fin d)) A))) y)) (Scheme.Etale.forget (Spec (.of (MvPolynomial (Option (Fin d)) A))))) (φ : ∀ l, Spec (.of B) ⟶ (W'.obj l).right.left) (a : Spec (.of B) ⟶ Spec (.of (MvPolynomial (Option (Fin d)) A))), wcHalShData y B Λ W' φ a → ∀ (β : MvPolynomial (Option (Fin d)) A →+* B), Spec.map (CommRingCat.ofHom β) = a → ∀ (K : Type u) [Field K] [IsSepClosed K] (ζ : Spec (.of K) ⟶ Spec (.of A)) (D : wcEtPullData (Limits.pullback.fst (Spec.map (CommRingCat.ofHom ((algebraMap B (Localization.Away (β (MvPolynomial.X none)))).comp (β.comp (algebraMap A (MvPolynomial (Option (Fin d)) A)))))) ζ) ℓ) (q : ℕ), Function.Bijective (wcEtPull D q)) → ∀ (Xb X : Scheme.{u}) (pb : Xb ⟶ Spec (.of A)) (j : X ⟶ Xb) [IsOpenImmersion j] (d : ℕ), wcQmBdChart A pb j d → ∀ (xb : Xb), pb xb = IsLocalRing.closedPoint A → xb ∉ Set.range j → ∀ (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt Xb xb)) (Scheme.Etale.forget Xb)) (φ : ∀ l, Spec (.of B) ⟶ (W'.obj l).right.left) (a : Spec (.of B) ⟶ Xb), wcHalShData xb B Λ W' φ a → ∀ (K : Type u) [Field K] [IsSepClosed K] (ζ : Spec (.of K) ⟶ Spec (.of A)) (D : wcEtPullData (Limits.pullback.fst (Limits.pullback.fst a j ≫ a ≫ pb) ζ) ℓ) (q : ℕ), Function.Bijective (wcEtPull D q) :=
by
  intro A _ _ _ _ _ ℓ hpur Xb X pb j _ d hchart xb hxb hnr B _ _ _ Λ _ _ W' φ a hB K _ _ ζ D q

  have hid : ∀ {S : Scheme.{u}} (Did : wcEtPullData (𝟙 S) ℓ) (i : ℕ) (x : wcEtZModExt S ℓ i),
      wcEtPull Did i x = x := by
    intro S Did i x
    have h1 := wc_et_pull_comp (𝟙 S) (𝟙 S) (𝟙 S) (Category.comp_id _) Did Did Did i x
    have h2 : wcEtPull Did i (wcEtPull Did i x - x) = 0 := by
      rw [map_sub, ← h1, sub_self]
    exact sub_eq_zero.mp (wc_et_pull_id_injective Did i _ h2)

  have hiso : ∀ {S S' : Scheme.{u}} (f : S' ⟶ S) [IsIso f] (Df : wcEtPullData f ℓ) (i : ℕ),
      Function.Bijective (wcEtPull Df i) := by
    intro S S' f _ Df i
    obtain ⟨Dinv⟩ := wc_et_zmod_pull_data_exists (inv f) ℓ
    obtain ⟨DS⟩ := wc_et_zmod_pull_data_exists (𝟙 S) ℓ
    obtain ⟨DS'⟩ := wc_et_zmod_pull_data_exists (𝟙 S') ℓ
    refine ⟨fun x y hxy => ?_, fun y => ⟨wcEtPull Dinv i y, ?_⟩⟩
    · have e := fun z => wc_et_pull_comp f (inv f) (𝟙 S) (IsIso.inv_hom_id f) Df Dinv DS i z
      have h := congrArg (⇑(wcEtPull Dinv i)) hxy
      rw [← e x, ← e y, hid DS i x, hid DS i y] at h
      exact h
    · rw [← wc_et_pull_comp (inv f) f (𝟙 S') (IsIso.hom_inv_id f) Dinv Df DS' i y, hid DS' i y]

  have htrans : ∀ {T T' : Scheme.{u}} (t : T ⟶ Spec (.of A)) (t' : T' ⟶ Spec (.of A)) (Ψ : T ≅ T'),
      Ψ.hom ≫ t' = t →
      (∀ (D' : wcEtPullData (Limits.pullback.fst t' ζ) ℓ) (q : ℕ), Function.Bijective (wcEtPull D' q)) →
      ∀ (D : wcEtPullData (Limits.pullback.fst t ζ) ℓ) (q : ℕ), Function.Bijective (wcEtPull D q) := by
    intro T T' t t' Ψ hΨ hb D q
    have e1 : t ≫ 𝟙 _ = Ψ.hom ≫ t' := by rw [Category.comp_id, hΨ]
    have e2 : ζ ≫ 𝟙 _ = 𝟙 _ ≫ ζ := by rw [Category.comp_id, Category.id_comp]
    let m := Limits.pullback.map t ζ t' ζ Ψ.hom (𝟙 _) (𝟙 _) e1 e2
    have hm : m ≫ Limits.pullback.fst t' ζ = Limits.pullback.fst t ζ ≫ Ψ.hom :=
      Limits.pullback.lift_fst _ _ _
    haveI : IsIso m := Limits.pullback.map_isIso t ζ t' ζ Ψ.hom (𝟙 _) (𝟙 _) e1 e2
    obtain ⟨Dψ⟩ := wc_et_zmod_pull_data_exists Ψ.hom ℓ
    obtain ⟨Dm⟩ := wc_et_zmod_pull_data_exists m ℓ
    obtain ⟨D₂⟩ := wc_et_zmod_pull_data_exists (Limits.pullback.fst t' ζ) ℓ
    obtain ⟨Dk⟩ := wc_et_zmod_pull_data_exists (Limits.pullback.fst t ζ ≫ Ψ.hom) ℓ
    have hcomp : (⇑(wcEtPull D q)) ∘ (⇑(wcEtPull Dψ q)) = (⇑(wcEtPull Dm q)) ∘ (⇑(wcEtPull D₂ q)) := by
      funext x
      simp only [Function.comp_apply]
      rw [← wc_et_pull_comp Ψ.hom (Limits.pullback.fst t ζ) _ rfl Dψ D Dk q x,
        wc_et_pull_comp (Limits.pullback.fst t' ζ) m _ hm D₂ Dm Dk q x]
    have hb' : Function.Bijective ((⇑(wcEtPull D q)) ∘ (⇑(wcEtPull Dψ q))) := by
      rw [hcomp]
      exact (hiso m Dm q).comp (hb D₂ q)
    exact (Function.Bijective.of_comp_iff _ (hiso Ψ.hom Dψ q)).mp hb'

  obtain ⟨V, e, hxV, he, hcomm, hiff⟩ := hchart xb hxb hnr
  haveI : Etale e := he
  obtain ⟨v, hv⟩ : xb ∈ Set.range V.ι := by rw [Scheme.Opens.range_ι]; exact hxV

  obtain ⟨B₁, _, _, _, Λ₁, _, _, W₁, φ₁, a₁, e₁, h1a, h1b, h1c, h1d, h1e, h1f, h1g⟩ :=
    wc_et_geom_strict_henselization v
  have h₁ : wcHalShData v B₁ Λ₁ W₁ φ₁ a₁ := by
    unfold wcHalShData; exact ⟨h1a, h1b, h1c, h1d, h1e, e₁, h1f, h1g⟩
  obtain ⟨ι₁, hι₁⟩ := wc_etale_geom_point_residue_iso V.ι v xb hv
  obtain ⟨θ₁, hθ₁⟩ := wc_shdata_etale_iso V.ι v xb ι₁ hι₁ B₁ Λ₁ W₁ φ₁ a₁ h₁ B Λ W' φ a hB
  obtain ⟨B', _, _, _, Λ', _, _, W'', φ', a', e', h2a, h2b, h2c, h2d, h2e, h2f, h2g⟩ :=
    wc_et_geom_strict_henselization (e v)
  have h₂ : wcHalShData (e v) B' Λ' W'' φ' a' := by
    unfold wcHalShData; exact ⟨h2a, h2b, h2c, h2d, h2e, e', h2f, h2g⟩
  obtain ⟨ι₂, hι₂⟩ := wc_etale_geom_point_residue_iso e v (e v) rfl
  obtain ⟨θ₂, hθ₂⟩ := wc_shdata_etale_iso e v (e v) ι₂ hι₂ B₁ Λ₁ W₁ φ₁ a₁ h₁ B' Λ' W'' φ' a' h₂
  obtain ⟨θ, aV, haV, hθ⟩ : ∃ (θ : Spec (.of B) ≅ Spec (.of B')) (aV : Spec (.of B) ⟶ (V : Scheme.{u})),
      aV ≫ V.ι = a ∧ θ.hom ≫ a' = aV ≫ e :=
    ⟨θ₁.symm ≪≫ θ₂, θ₁.inv ≫ a₁, by rw [Category.assoc, ← hθ₁, Iso.inv_hom_id_assoc],
      by rw [Iso.trans_hom, Iso.symm_hom, Category.assoc, hθ₂, Category.assoc]⟩

  obtain ⟨β, hβ⟩ : ∃ β : MvPolynomial (Option (Fin d)) A →+* B',
      Spec.map (CommRingCat.ofHom β) = a' :=
    ⟨(Spec.preimage a').hom, by rw [CommRingCat.ofHom_hom, Spec.map_preimage]⟩

  have hcl : Spec.map (CommRingCat.ofHom (algebraMap A (MvPolynomial (Option (Fin d)) A))) (e v) =
      IsLocalRing.closedPoint A := by
    rw [← Scheme.Hom.comp_apply, hcomm, Scheme.Hom.comp_apply, hv, hxb]
  have hu : (MvPolynomial.X none : MvPolynomial (Option (Fin d)) A) ∈ (e v).asIdeal :=
    (hiff v).mp (by rw [hv]; exact hnr)

  have key : ∀ s : Spec (.of B), a s ∈ Set.range j ↔
      β (MvPolynomial.X none) ∉ (θ.hom s).asIdeal := by
    intro s
    have h1 : a' (θ.hom s) = e (aV s) := by
      rw [← Scheme.Hom.comp_apply, hθ, Scheme.Hom.comp_apply]
    have h2 : V.ι (aV s) = a s := by rw [← Scheme.Hom.comp_apply, haV]
    have h3 : β (MvPolynomial.X none) ∈ (θ.hom s).asIdeal ↔
        (MvPolynomial.X none : MvPolynomial (Option (Fin d)) A) ∈ (a' (θ.hom s)).asIdeal := by
      rw [← hβ, Spec.map_apply]
      exact Iff.rfl
    rw [h3, h1, ← hiff (aV s), h2, not_not]

  haveI : IsOpenImmersion (Spec.map (CommRingCat.ofHom
      (algebraMap B' (Localization.Away (β (MvPolynomial.X none)))))) :=
    IsOpenImmersion.of_isLocalization (β (MvPolynomial.X none))
  have hgL : ∀ p : Spec (.of B'), p ∈ Set.range (Spec.map (CommRingCat.ofHom
      (algebraMap B' (Localization.Away (β (MvPolynomial.X none)))))) ↔
      β (MvPolynomial.X none) ∉ p.asIdeal := by
    intro p
    have h := PrimeSpectrum.localization_away_comap_range
      (Localization.Away (β (MvPolynomial.X none))) (β (MvPolynomial.X none))
    have e1 : ∀ x, (Spec.map (CommRingCat.ofHom
        (algebraMap B' (Localization.Away (β (MvPolynomial.X none)))))) x =
        PrimeSpectrum.comap (algebraMap B' (Localization.Away (β (MvPolynomial.X none)))) x :=
      fun x => Spec.map_apply _ x
    constructor
    · rintro ⟨x, rfl⟩
      rw [e1]
      have hx : PrimeSpectrum.comap (algebraMap B' (Localization.Away (β (MvPolynomial.X none)))) x ∈
          (PrimeSpectrum.basicOpen (β (MvPolynomial.X none)) : Set (PrimeSpectrum B')) := by
        rw [← h]; exact Set.mem_range_self x
      exact (PrimeSpectrum.mem_basicOpen _ _).mp hx
    · intro hp
      have hp' : p ∈ (PrimeSpectrum.basicOpen (β (MvPolynomial.X none)) : Set (PrimeSpectrum B')) :=
        (PrimeSpectrum.mem_basicOpen _ _).mpr hp
      rw [← h] at hp'
      obtain ⟨x, hx⟩ := hp'
      exact ⟨x, (e1 x).trans hx⟩
  have hrange : Set.range (Limits.pullback.fst a j ≫ θ.hom) = Set.range (Spec.map (CommRingCat.ofHom
      (algebraMap B' (Localization.Away (β (MvPolynomial.X none)))))) := by
    ext p
    rw [hgL p]
    constructor
    · rintro ⟨w, rfl⟩
      have hw : Limits.pullback.fst a j w ∈ a ⁻¹' Set.range j := by
        rw [← Scheme.Pullback.range_fst]; exact Set.mem_range_self w
      rw [Scheme.Hom.comp_apply]
      exact (key _).mp hw
    · intro hp
      have hs : θ.hom (θ.inv p) = p := by
        rw [← Scheme.Hom.comp_apply, Iso.inv_hom_id]; rfl
      have hmem : θ.inv p ∈ Set.range (Limits.pullback.fst a j) := by
        rw [Scheme.Pullback.range_fst]
        exact (key _).mpr (by rw [hs]; exact hp)
      obtain ⟨w, hw⟩ := hmem
      exact ⟨w, by rw [Scheme.Hom.comp_apply, hw, hs]⟩
  let Ψ := IsOpenImmersion.isoOfRangeEq (Limits.pullback.fst a j ≫ θ.hom) (Spec.map (CommRingCat.ofHom
      (algebraMap B' (Localization.Away (β (MvPolynomial.X none)))))) hrange
  have hΨ : Ψ.hom ≫ Spec.map (CommRingCat.ofHom
      (algebraMap B' (Localization.Away (β (MvPolynomial.X none))))) =
      Limits.pullback.fst a j ≫ θ.hom :=
    IsOpenImmersion.isoOfRangeEq_hom_fac _ _ _

  have hτ : Spec.map (CommRingCat.ofHom ((algebraMap B' (Localization.Away (β (MvPolynomial.X none)))).comp
      (β.comp (algebraMap A (MvPolynomial (Option (Fin d)) A))))) =
      Spec.map (CommRingCat.ofHom (algebraMap B' (Localization.Away (β (MvPolynomial.X none))))) ≫
        a' ≫ Spec.map (CommRingCat.ofHom (algebraMap A (MvPolynomial (Option (Fin d)) A))) := by
    rw [CommRingCat.ofHom_comp, CommRingCat.ofHom_comp, Spec.map_comp, Spec.map_comp, hβ]
  have hfinal : Ψ.hom ≫ Spec.map (CommRingCat.ofHom
      ((algebraMap B' (Localization.Away (β (MvPolynomial.X none)))).comp
        (β.comp (algebraMap A (MvPolynomial (Option (Fin d)) A))))) =
      Limits.pullback.fst a j ≫ a ≫ pb := by
    rw [hτ, ← Category.assoc, hΨ, Category.assoc, ← Category.assoc θ.hom, hθ, Category.assoc,
      hcomm, ← Category.assoc aV, haV]

  exact htrans _ _ Ψ hfinal
    (fun D' q' => hpur d (e v) hcl hu B' Λ' W'' φ' a' h₂ β hβ K ζ D' q') D q

theorem wc_qmb_chart_shens_data : ∀ (A : Type u) [CommRing A] [IsLocalRing A] (Xb X : Scheme.{u}) (pb : Xb ⟶ Spec (.of A)) (j : X ⟶ Xb) [IsOpenImmersion j] (d : ℕ), wcQmBdChart A pb j d → ∀ (xb : Xb), pb xb = IsLocalRing.closedPoint A → xb ∉ Set.range j → ∀ (C : Set Xb), IsClosed C → xb ∉ C → ∃ (B : Type u) (_ : CommRing B) (_ : HenselianLocalRing B) (_ : IsSepClosed (IsLocalRing.ResidueField B)) (Λ : Type u) (_ : SmallCategory Λ) (_ : IsCofiltered Λ) (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt Xb xb)) (Scheme.Etale.forget Xb)) (φ' : ∀ l, Spec (.of B) ⟶ (W'.obj l).right.left) (a : Spec (.of B) ⟶ Xb), wcHalShData xb B Λ W' φ' a ∧ (∀ (l : Λ) (w : (W'.obj l).right.left), (W'.obj l).right.hom w ∉ C) ∧ (∀ l, IsAffine (Limits.pullback (W'.obj l).right.hom j)) ∧ IsAffine (Limits.pullback a j) :=
by
  intro A _ _ Xb X pb j _ d hchart xb hpb hnr C hC hxC

  have s3 : ∀ (V : Xb.Opens) (R : Type u) [CommRing R] (e : (V : Scheme.{u}) ⟶ Spec (.of R))
      (r : R), (∀ v : (V : Scheme.{u}), (V.ι v ∉ Set.range j ↔ r ∈ (e v).asIdeal)) →
      ∀ (E : Scheme.{u}) [IsAffine E] (g : E ⟶ Xb) (k : E ⟶ (V : Scheme.{u})), k ≫ V.ι = g →
        IsAffine (Limits.pullback g j) := by
    intro V R _ e r hiff E _ g k hk
    subst hk
    let f : Γ(E, ⊤) := (k ≫ e).appTop ((Scheme.ΓSpecIso (.of R)).inv r)
    have hb : E.basicOpen f =
        (k ≫ e) ⁻¹ᵁ (Spec (.of R)).basicOpen ((Scheme.ΓSpecIso (.of R)).inv r) :=
      (Scheme.preimage_basicOpen _ _).symm
    have hrange : Set.range (Limits.pullback.fst (k ≫ V.ι) j) = Set.range (E.basicOpen f).ι := by
      rw [Scheme.Pullback.range_fst, Scheme.Opens.range_ι]
      ext w
      have h1 : w ∈ E.basicOpen f ↔ r ∉ ((k ≫ e) w).asIdeal := by
        rw [hb, Scheme.Hom.mem_preimage, basicOpen_eq_of_affine]
        exact PrimeSpectrum.mem_basicOpen r ((k ≫ e) w)
      rw [Scheme.Hom.comp_apply] at h1
      have h2 := hiff (k w)
      show (k ≫ V.ι) w ∈ Set.range j ↔ w ∈ E.basicOpen f
      rw [Scheme.Hom.comp_apply, h1]
      exact ⟨fun h h' => (h2.mpr h') h, fun h => Classical.byContradiction fun h' => h (h2.mp h')⟩
    haveI : IsAffine (E.basicOpen f) := (isAffineOpen_top E).basicOpen f
    exact IsAffine.of_isIso (IsOpenImmersion.isoOfRangeEq _ _ hrange).hom

  have s4 : ∀ {Y Z : Scheme.{u}} (i : Y ⟶ Z) [IsOpenImmersion i] (y : Y),
      ∃ ψ : AlgebraicClosure (Y.residueField y) ≃+* AlgebraicClosure (Z.residueField (i y)),
        Spec.map (CommRingCat.ofHom ψ.toRingHom) ≫ wcEtGeomPt Y y ≫ i = wcEtGeomPt Z (i y) := by
    intro Y Z i _ y
    have hbij : Function.Bijective (i.residueFieldMap y).hom :=
      ConcreteCategory.bijective_of_isIso (i.residueFieldMap y)
    let ψ0 : Z.residueField (i y) ≃+* Y.residueField y :=
      RingEquiv.ofBijective (i.residueFieldMap y).hom hbij
    let Φ : AlgebraicClosure (Z.residueField (i y)) ≃+* AlgebraicClosure (Y.residueField y) :=
      IsAlgClosure.equivOfEquiv (AlgebraicClosure (Z.residueField (i y)))
        (AlgebraicClosure (Y.residueField y)) ψ0
    have hΦ : ∀ s : Z.residueField (i y),
        Φ.symm (algebraMap (Y.residueField y) (AlgebraicClosure (Y.residueField y))
          ((i.residueFieldMap y).hom s)) =
        algebraMap (Z.residueField (i y)) (AlgebraicClosure (Z.residueField (i y))) s := by
      intro s
      have h1 := IsAlgClosure.equivOfEquiv_symm_algebraMap
        (AlgebraicClosure (Z.residueField (i y))) (AlgebraicClosure (Y.residueField y)) ψ0 (ψ0 s)
      rw [RingEquiv.symm_apply_apply] at h1
      exact h1
    refine ⟨Φ.symm, ?_⟩
    have hring : i.residueFieldMap y ≫
        CommRingCat.ofHom (algebraMap (Y.residueField y) (AlgebraicClosure (Y.residueField y))) ≫
        CommRingCat.ofHom Φ.symm.toRingHom =
        CommRingCat.ofHom (algebraMap (Z.residueField (i y))
          (AlgebraicClosure (Z.residueField (i y)))) := by
      ext s
      exact hΦ s
    have Lspec : ∀ {R S T U : CommRingCat.{u}} (a : R ⟶ S) (b : S ⟶ T) (c : T ⟶ U) (d : R ⟶ U),
        a ≫ b ≫ c = d → Spec.map d = Spec.map c ≫ Spec.map b ≫ Spec.map a := by
      intro R S T U a b c d h
      subst h
      simp only [Spec.map_comp, Category.assoc]
    have key := Lspec _ _ _ _ hring
    show _ ≫ (Spec.map _ ≫ Y.fromSpecResidueField y) ≫ i =
      Spec.map _ ≫ Z.fromSpecResidueField (i y)
    simp only [Category.assoc]
    rw [← Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField, key]
    simp only [Category.assoc]
    rfl

  obtain ⟨V₀, e, hxV₀, -, -, hiff⟩ := hchart xb hpb hnr
  let O : Xb.Opens := V₀ ⊓ ⟨Cᶜ, hC.isOpen_compl⟩
  have hxO : xb ∈ (V₀ : Set Xb) ∩ Cᶜ := ⟨hxV₀, hxC⟩
  let xO : (O : Scheme.{u}) := ⟨xb, hxO⟩
  obtain ⟨B, _, _, _, Λ, _, _, W₀, φ₀, a₀, e₀, h1, h2, h3, h4, h5, h6, h7⟩ :=
    wc_et_geom_strict_henselization xO
  obtain ⟨W', hW'init, ⟨θ⟩⟩ := wc_et_open_imm_shens_transport O.ι xO Λ W₀ h1
  let ηh : ∀ l, (W'.obj l).right.left ⟶ (W₀.obj l).right.left := fun l => (θ.hom.app l).left
  let ηi : ∀ l, (W₀.obj l).right.left ⟶ (W'.obj l).right.left := fun l => (θ.inv.app l).left
  have hhi : ∀ l, ηh l ≫ ηi l = 𝟙 _ := fun l => by
    have := congrArg (fun f => f.left) (θ.hom_inv_id_app l)
    exact this
  have hih : ∀ l, ηi l ≫ ηh l = 𝟙 _ := fun l => by
    have := congrArg (fun f => f.left) (θ.inv_hom_id_app l)
    exact this
  have hs1 : ∀ l, ηh l ≫ (W₀.obj l).right.hom ≫ O.ι = (W'.obj l).right.hom := fun l =>
    MorphismProperty.Over.w (θ.hom.app l)
  have hs2 : ∀ l, ηi l ≫ (W'.obj l).right.hom = (W₀.obj l).right.hom ≫ O.ι := fun l =>
    MorphismProperty.Over.w (θ.inv.app l)
  have hn1 : ∀ {l l' : Λ} (t : l ⟶ l'),
      (W'.map t).right.left ≫ ηh l' = ηh l ≫ (W₀.map t).right.left := fun t =>
    congrArg (fun f => f.left) (θ.hom.naturality t)
  have hn2 : ∀ {l l' : Λ} (t : l ⟶ l'),
      (W₀.map t).right.left ≫ ηi l' = ηi l ≫ (W'.map t).right.left := fun t =>
    congrArg (fun f => f.left) (θ.inv.naturality t)
  let φ' : ∀ l, Spec (.of B) ⟶ (W'.obj l).right.left := fun l => φ₀ l ≫ ηi l
  have hAff : ∀ l, IsAffine (W'.obj l).right.left := by
    intro l
    haveI := h2 l
    haveI : IsIso (ηh l) := ⟨⟨ηi l, hhi l, hih l⟩⟩
    exact IsAffine.of_isIso (ηh l)
  have hD : wcHalShData (O.ι xO) B Λ W' φ' (a₀ ≫ O.ι) := by
    refine ⟨hW'init, hAff, ?_, ?_, ?_, ?_⟩
    · intro l l' t
      show (φ₀ l ≫ ηi l) ≫ (W'.map t).right.left = φ₀ l' ≫ ηi l'
      rw [Category.assoc, ← hn2 t, ← Category.assoc, h3 t]
    · intro l
      show (φ₀ l ≫ ηi l) ≫ (W'.obj l).right.hom = a₀ ≫ O.ι
      rw [Category.assoc, hs2 l, ← Category.assoc, h4 l]
    · intro T z hz
      obtain ⟨z₀, hz₀, huniq⟩ := h5 T (fun l => z l ≫ ηh l) (fun {l l'} t => by
        show (z l ≫ ηh l) ≫ (W₀.map t).right.left = z l' ≫ ηh l'
        rw [Category.assoc, ← hn1 t, ← Category.assoc, hz t])
      refine ⟨z₀, fun l => ?_, fun w hw => huniq w (fun l => ?_)⟩
      · have e1 : z₀ ≫ φ₀ l = z l ≫ ηh l := hz₀ l
        show z₀ ≫ (φ₀ l ≫ ηi l) = z l
        rw [← Category.assoc, e1, Category.assoc, hhi l, Category.comp_id]
      · have e2 : w ≫ (φ₀ l ≫ ηi l) = z l := hw l
        show w ≫ φ₀ l = z l ≫ ηh l
        rw [← e2, Category.assoc, Category.assoc, hih l, Category.comp_id]
    · obtain ⟨ψ, hψ⟩ := s4 O.ι xO
      refine ⟨ψ.toRingHom.comp e₀, RingHom.IsIntegral.trans _ _ h6
        (RingHom.isIntegral_of_surjective _ ψ.surjective), ?_⟩
      rw [← hψ, ← h7, CommRingCat.ofHom_comp, Spec.map_comp]
      simp only [Category.assoc]
  have hi : ∀ (l : Λ) (w : (W'.obj l).right.left), (W'.obj l).right.hom w ∉ C := by
    intro l w hw
    let p : (O : Scheme.{u}) :=
      (show ((W₀.obj l).right.left ⟶ (O : Scheme.{u})) from (W₀.obj l).right.hom) (ηh l w)
    have hp2 : O.ι p ∈ Cᶜ := (show O.ι p ∈ (V₀ : Set Xb) ∩ Cᶜ from p.2).2
    have heq : (W'.obj l).right.hom w = O.ι p := by
      rw [← hs1 l, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply]
    rw [heq] at hw
    exact hp2 hw
  have hii : ∀ l, IsAffine (Limits.pullback (W'.obj l).right.hom j) := by
    intro l
    exact @s3 V₀ _ _ e _ hiff (W'.obj l).right.left (hAff l) (W'.obj l).right.hom
      (ηh l ≫ (W₀.obj l).right.hom ≫ Xb.homOfLE (inf_le_left : O ≤ V₀))
      (by rw [Category.assoc, Category.assoc, Scheme.homOfLE_ι, hs1 l])
  have hiii : IsAffine (Limits.pullback (a₀ ≫ O.ι) j) :=
    s3 V₀ _ e _ hiff (Spec (.of B)) _ (a₀ ≫ Xb.homOfLE (inf_le_left : O ≤ V₀))
      (by rw [Category.assoc, Scheme.homOfLE_ι])
  exact ⟨B, inferInstance, inferInstance, inferInstance, Λ, inferInstance, inferInstance, W', φ',
    a₀ ≫ O.ι, hD, hi, hii, hiii⟩

theorem wc_qmb_affine_limit_pull : ∀ {Y P : Scheme.{u}} (y : Y) (B : Type u) [CommRing B] [IsLocalRing B] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt Y y)) (Scheme.Etale.forget Y)) (φ' : ∀ l, Spec (.of B) ⟶ (W'.obj l).right.left) (a : Spec (.of B) ⟶ Y), wcHalShData y B Λ W' φ' a → ∀ (g : P ⟶ Y), (∀ l, IsAffine (Limits.pullback (W'.obj l).right.hom g)) → IsAffine (Limits.pullback a g) → ∀ (m q : ℕ) (x : wcEtZModExt (Limits.pullback a g) m q), ∃ (l : Λ) (c₀ : wcEtZModExt (Limits.pullback (W'.obj l).right.hom g) m q), ∀ (π' : Limits.pullback a g ⟶ Limits.pullback (W'.obj l).right.hom g), π' ≫ Limits.pullback.fst (W'.obj l).right.hom g = Limits.pullback.fst a g ≫ φ' l → π' ≫ Limits.pullback.snd (W'.obj l).right.hom g = Limits.pullback.snd a g → ∀ (E : wcEtPullData π' m), wcEtPull E q c₀ = x :=
by
  intro Y P y B _ _ Λ _ _ W' φ' a hB g hQ hZ m q x
  obtain ⟨-, -, H3, H4, H5, -⟩ := hB
  let D : Λ ⥤ P.Etale := W' ⋙ StructuredArrow.proj _ _ ⋙ wcEtBaseChange g
  let π : ∀ l, Limits.pullback a g ⟶ Limits.pullback (W'.obj l).right.hom g := fun l =>
    Limits.pullback.lift (Limits.pullback.fst a g ≫ φ' l) (Limits.pullback.snd a g)
      (by rw [Category.assoc, H4 l, Limits.pullback.condition])
  have hπ1 : ∀ l, π l ≫ Limits.pullback.fst (W'.obj l).right.hom g =
      Limits.pullback.fst a g ≫ φ' l := fun l => Limits.pullback.lift_fst _ _ _
  have hπ2 : ∀ l, π l ≫ Limits.pullback.snd (W'.obj l).right.hom g =
      Limits.pullback.snd a g := fun l => Limits.pullback.lift_snd _ _ _
  have M1 : ∀ {l l' : Λ} (t : l ⟶ l'), (D.map t).left ≫
      Limits.pullback.fst (W'.obj l').right.hom g =
      Limits.pullback.fst (W'.obj l).right.hom g ≫ (W'.map t).right.left := by
    intro l l' t
    first
      | exact Limits.pullback.lift_fst _ _ _
      | (erw [MorphismProperty.Over.pullback_map_left]; exact Limits.pullback.lift_fst _ _ _)
  have M2 : ∀ {l l' : Λ} (t : l ⟶ l'), (D.map t).left ≫
      Limits.pullback.snd (W'.obj l').right.hom g =
      Limits.pullback.snd (W'.obj l).right.hom g := by
    intro l l' t
    first
      | exact Limits.pullback.lift_snd _ _ _
      | (erw [MorphismProperty.Over.pullback_map_left]; exact Limits.pullback.lift_snd _ _ _)
  have hhom : ∀ l, π l ≫ (D.obj l).hom = Limits.pullback.snd a g := fun l => hπ2 l
  have hcompat : ∀ {l l' : Λ} (t : l ⟶ l'), π l ≫ (D.map t).left = π l' := by
    intro l l' t
    refine Limits.pullback.hom_ext (f := (W'.obj l').right.hom) (g := g) ?_ ?_
    · exact (Category.assoc _ _ _).trans <| (whisker_eq (π l) (M1 t)).trans <|
        (Category.assoc _ _ _).symm.trans <| (eq_whisker (hπ1 l) _).trans <|
        (Category.assoc _ _ _).trans <| (whisker_eq _ (H3 t)).trans (hπ1 l').symm
    · exact (Category.assoc _ _ _).trans <| (whisker_eq (π l) (M2 t)).trans <|
        (hπ2 l).trans (hπ2 l').symm
  have hlim : ∀ (T : Scheme.{u}) (w : ∀ l, T ⟶ (D.obj l).left),
      (∀ {l l' : Λ} (t : l ⟶ l'), w l ≫ (D.map t).left = w l') →
      ∃! w₀ : T ⟶ Limits.pullback a g, ∀ l, w₀ ≫ π l = w l := by
    intro T w hw
    have hz : ∀ {l l' : Λ} (t : l ⟶ l'),
        (w l ≫ Limits.pullback.fst (W'.obj l).right.hom g) ≫ (W'.map t).right.left =
          w l' ≫ Limits.pullback.fst (W'.obj l').right.hom g := by
      intro l l' t
      exact (Category.assoc _ _ _).trans <| (whisker_eq (w l) (M1 t)).symm.trans <|
        (Category.assoc _ _ _).symm.trans (eq_whisker (hw t) _)
    obtain ⟨z₀, hz₀, hz₀u⟩ := H5 T (fun l => w l ≫ Limits.pullback.fst (W'.obj l).right.hom g)
      (fun t => hz t)
    have hz₀' : ∀ l, z₀ ≫ φ' l = w l ≫ Limits.pullback.fst (W'.obj l).right.hom g := hz₀
    obtain ⟨l₀⟩ := IsCofiltered.nonempty (C := Λ)
    have hσt : ∀ {l l' : Λ} (t : l ⟶ l'), w l' ≫ Limits.pullback.snd (W'.obj l').right.hom g =
        w l ≫ Limits.pullback.snd (W'.obj l).right.hom g := by
      intro l l' t
      exact (eq_whisker (hw t) _).symm.trans <| (Category.assoc _ _ _).trans (whisker_eq _ (M2 t))
    have hσ : ∀ l, w l ≫ Limits.pullback.snd (W'.obj l).right.hom g =
        w l₀ ≫ Limits.pullback.snd (W'.obj l₀).right.hom g := fun l =>
      (hσt (IsCofiltered.minToRight l₀ l)).trans (hσt (IsCofiltered.minToLeft l₀ l)).symm
    have hcond : z₀ ≫ a = (w l₀ ≫ Limits.pullback.snd (W'.obj l₀).right.hom g) ≫ g :=
      (whisker_eq z₀ (H4 l₀)).symm.trans <| (Category.assoc _ _ _).symm.trans <|
        (eq_whisker (hz₀' l₀) _).trans <| (Category.assoc _ _ _).trans <|
        (whisker_eq _ Limits.pullback.condition).trans (Category.assoc _ _ _).symm
    have hex : ∀ l, Limits.pullback.lift z₀ _ hcond ≫ π l = w l := by
      intro l
      refine Limits.pullback.hom_ext (f := (W'.obj l).right.hom) (g := g) ?_ ?_
      · exact (Category.assoc _ _ _).trans <| (whisker_eq _ (hπ1 l)).trans <|
          (Category.assoc _ _ _).symm.trans <|
          (eq_whisker (Limits.pullback.lift_fst _ _ _) _).trans (hz₀' l)
      · exact (Category.assoc _ _ _).trans <| (whisker_eq _ (hπ2 l)).trans <|
          (Limits.pullback.lift_snd _ _ _).trans (hσ l).symm
    refine ⟨Limits.pullback.lift z₀ _ hcond, hex, ?_⟩
    intro w₁ hw₁
    refine Limits.pullback.hom_ext ?_ ?_
    · refine Eq.trans ?_ (Limits.pullback.lift_fst _ _ _).symm
      apply hz₀u
      intro l
      exact (Category.assoc _ _ _).trans <| (whisker_eq w₁ (hπ1 l)).symm.trans <|
        (Category.assoc _ _ _).symm.trans (eq_whisker (hw₁ l) _)
    · refine Eq.trans ?_ (Limits.pullback.lift_snd _ _ _).symm
      exact (whisker_eq w₁ (hπ2 l₀)).symm.trans <|
        (Category.assoc _ _ _).symm.trans (eq_whisker (hw₁ l₀) _)
  have hcpt : ∀ l, CompactSpace (D.obj l).left := fun l => by
    haveI : IsAffine (D.obj l).left := hQ l
    infer_instance
  have hqs : ∀ l, QuasiSeparatedSpace (D.obj l).left := fun l => by
    haveI : IsAffine (D.obj l).left := hQ l
    infer_instance
  have haff : ∀ {l l' : Λ} (t : l ⟶ l'), IsAffineHom (D.map t).left := fun {l l'} t =>
    @isAffineHom_of_isAffine _ _ (D.map t).left (hQ l) (hQ l')
  have hZc : CompactSpace ↥(Limits.pullback a g : Scheme.{u}) := by
    haveI := hZ
    infer_instance
  have hZq : QuasiSeparatedSpace ↥(Limits.pullback a g : Scheme.{u}) := by
    haveI := hZ
    infer_instance
  obtain ⟨l, c₀, hc₀⟩ := wc_et_limit_pull_surj_qcqs_all (Limits.pullback.snd a g) Λ D π hhom
    hcompat hlim hcpt hqs haff hZc hZq m q x
  refine ⟨l, c₀, ?_⟩
  intro π' h1 h2 E
  have hπ' : π' = π l := Limits.pullback.hom_ext (h1.trans (hπ1 l).symm) (h2.trans (hπ2 l).symm)
  subst hπ'
  exact hc₀ E

theorem wc_qmb_closed_fibre_nbhd_system : ∀ {Xb Z : Scheme.{u}} (ι : Z ⟶ Xb) [IsClosedImmersion ι] (z : Z) (y : ↥(wcQmUs z : Scheme.{u})) (B : Type u) [CommRing B] [IsLocalRing B] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt Xb (ι ((wcQmUs z).ι y)))) (Scheme.Etale.forget Xb)) (φ' : ∀ l, Spec (.of B) ⟶ (W'.obj l).right.left) (a : Spec (.of B) ⟶ Xb), wcHalShData (ι ((wcQmUs z).ι y)) B Λ W' φ' a → (∀ (l : Λ) (w : (W'.obj l).right.left), (W'.obj l).right.hom w ∉ ι '' closure {z}) → ∃ (Af : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (wcQmUs z : Scheme.{u}) y)) (Scheme.Etale.forget (wcQmUs z : Scheme.{u}))) (ν : ∀ l, (Af.obj l).right.left ≅ Limits.pullback (W'.obj l).right.hom ((wcQmUs z).ι ≫ ι)), (Af.Initial ∧ (∀ l, (ν l).hom ≫ Limits.pullback.snd (W'.obj l).right.hom ((wcQmUs z).ι ≫ ι) = (Af.obj l).right.hom) ∧ (∀ {l l' : Λ} (tt : l ⟶ l'), (Af.map tt).right.left ≫ (ν l').hom ≫ Limits.pullback.fst (W'.obj l').right.hom ((wcQmUs z).ι ≫ ι) = (ν l).hom ≫ Limits.pullback.fst (W'.obj l).right.hom ((wcQmUs z).ι ≫ ι) ≫ (W'.map tt).right.left) ∧ ∃ θθ : Spec (.of (AlgebraicClosure ((wcQmUs z : Scheme.{u}).residueField y))) ⟶ Spec (.of (AlgebraicClosure (Xb.residueField (ι ((wcQmUs z).ι y))))), IsIso θθ ∧ ∀ l, (Af.obj l).hom.left ≫ (ν l).hom ≫ Limits.pullback.fst (W'.obj l).right.hom ((wcQmUs z).ι ≫ ι) = θθ ≫ (W'.obj l).hom.left) :=
by
  intro Xb Z ι _ z y B _ _ Λ _ _ W' φ' a hB _hO
  have ptEq : ∀ {X Y : Scheme.{u}} {f g : X ⟶ Y}, f = g → ∀ x, f x = g x := fun h x => by rw [h]
  have main : ∀ (V : Z.Opens) (y : ↥(V : Scheme.{u}))
      (gX : Spec (.of (AlgebraicClosure (Xb.residueField (ι (V.ι y))))) ⟶ Xb)
      (gV : Spec (.of (AlgebraicClosure ((V : Scheme.{u}).residueField y))) ⟶ (V : Scheme.{u}))
      (θθ : Spec (.of (AlgebraicClosure ((V : Scheme.{u}).residueField y))) ⟶
        Spec (.of (AlgebraicClosure (Xb.residueField (ι (V.ι y)))))),
      IsIso θθ → θθ ≫ gX = gV ≫ V.ι ≫ ι →
      ∀ (W' : Λ ⥤ StructuredArrow (Over.mk gX) (Scheme.Etale.forget Xb)), W'.Initial →
      ∃ (Af : Λ ⥤ StructuredArrow (Over.mk gV) (Scheme.Etale.forget (V : Scheme.{u})))
        (ν : ∀ l, (Af.obj l).right.left ≅ Limits.pullback (W'.obj l).right.hom (V.ι ≫ ι)),
        (Af.Initial ∧
          (∀ l, (ν l).hom ≫ Limits.pullback.snd (W'.obj l).right.hom (V.ι ≫ ι) = (Af.obj l).right.hom) ∧
          (∀ {l l' : Λ} (tt : l ⟶ l'), (Af.map tt).right.left ≫ (ν l').hom ≫
              Limits.pullback.fst (W'.obj l').right.hom (V.ι ≫ ι) =
            (ν l).hom ≫ Limits.pullback.fst (W'.obj l).right.hom (V.ι ≫ ι) ≫ (W'.map tt).right.left) ∧
          ∀ l, (Af.obj l).hom.left ≫ (ν l).hom ≫
              Limits.pullback.fst (W'.obj l).right.hom (V.ι ≫ ι) = θθ ≫ (W'.obj l).hom.left) := by
    intro V y gX gV θθ hθiso hθ W' hInit

    obtain ⟨p, hpdef⟩ : ∃ p : ∀ l, Spec (.of (AlgebraicClosure (Xb.residueField (ι (V.ι y))))) ⟶
        (W'.obj l).right.left, ∀ l, p l = (W'.obj l).hom.left :=
      ⟨fun l => (W'.obj l).hom.left, fun _ => rfl⟩
    obtain ⟨m, hmdef⟩ : ∃ m : ∀ (l l' : Λ) (_ : l ⟶ l'), (W'.obj l).right.left ⟶ (W'.obj l').right.left,
        ∀ l l' tt, m l l' tt = (W'.map tt).right.left :=
      ⟨fun l l' tt => (W'.map tt).right.left, fun _ _ _ => rfl⟩
    have hp : ∀ l, p l ≫ (W'.obj l).right.hom = gX := by
      intro l; rw [hpdef]; exact Over.w (W'.obj l).hom
    have hm : ∀ (l l' : Λ) (tt : l ⟶ l'), m l l' tt ≫ (W'.obj l').right.hom = (W'.obj l).right.hom := by
      intro l l' tt; rw [hmdef]; exact MorphismProperty.Over.w (W'.map tt).right
    have hpm : ∀ (l l' : Λ) (tt : l ⟶ l'), p l ≫ m l l' tt = p l' := by
      intro l l' tt; rw [hpdef, hpdef, hmdef]
      exact congrArg CommaMorphism.left (StructuredArrow.w (W'.map tt))
    have hm_id : ∀ l, m l l (𝟙 l) = 𝟙 _ := by
      intro l; rw [hmdef, W'.map_id]; rfl
    have hm_comp : ∀ (l l' l'' : Λ) (f : l ⟶ l') (g : l' ⟶ l''),
        m l l'' (f ≫ g) = m l l' f ≫ m l' l'' g := by
      intro l l' l'' f g; rw [hmdef, hmdef, hmdef, W'.map_comp]; rfl
    have hEt : ∀ l, Etale (W'.obj l).right.hom := fun l => (W'.obj l).right.prop

    obtain ⟨q, hq1, hq2⟩ : ∃ q : ∀ l, Spec (.of (AlgebraicClosure ((V : Scheme.{u}).residueField y))) ⟶
        Limits.pullback (W'.obj l).right.hom (V.ι ≫ ι),
        (∀ l, q l ≫ Limits.pullback.fst (W'.obj l).right.hom (V.ι ≫ ι) = θθ ≫ p l) ∧
        (∀ l, q l ≫ Limits.pullback.snd (W'.obj l).right.hom (V.ι ≫ ι) = gV) :=
      ⟨fun l => Limits.pullback.lift (θθ ≫ p l) gV (by rw [Category.assoc, hp l, hθ]),
        fun l => Limits.pullback.lift_fst _ _ _, fun l => Limits.pullback.lift_snd _ _ _⟩
    obtain ⟨k, hk1, hk2⟩ : ∃ k : ∀ (l l' : Λ) (_ : l ⟶ l'),
        Limits.pullback (W'.obj l).right.hom (V.ι ≫ ι) ⟶ Limits.pullback (W'.obj l').right.hom (V.ι ≫ ι),
        (∀ (l l' : Λ) (tt : l ⟶ l'), k l l' tt ≫ Limits.pullback.fst (W'.obj l').right.hom (V.ι ≫ ι) =
          Limits.pullback.fst (W'.obj l).right.hom (V.ι ≫ ι) ≫ m l l' tt) ∧
        (∀ (l l' : Λ) (tt : l ⟶ l'), k l l' tt ≫ Limits.pullback.snd (W'.obj l').right.hom (V.ι ≫ ι) =
          Limits.pullback.snd (W'.obj l).right.hom (V.ι ≫ ι)) :=
      ⟨fun l l' tt => Limits.pullback.lift
          (Limits.pullback.fst (W'.obj l).right.hom (V.ι ≫ ι) ≫ m l l' tt)
          (Limits.pullback.snd (W'.obj l).right.hom (V.ι ≫ ι))
          (by rw [Category.assoc, hm, Limits.pullback.condition]),
        fun l l' tt => Limits.pullback.lift_fst _ _ _, fun l l' tt => Limits.pullback.lift_snd _ _ _⟩
    have hqk : ∀ (l l' : Λ) (tt : l ⟶ l'), q l ≫ k l l' tt = q l' := by
      intro l l' tt
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, hk1, reassoc_of% (hq1 l), hpm, hq1]
      · rw [Category.assoc, hk2, hq2, hq2]
    have hk_id : ∀ l, k l l (𝟙 l) = 𝟙 _ := by
      intro l
      apply Limits.pullback.hom_ext
      · rw [hk1, hm_id]; exact (Category.comp_id _).trans (Category.id_comp _).symm
      · rw [hk2, Category.id_comp]
    have hk_comp : ∀ (l l' l'' : Λ) (f : l ⟶ l') (g : l' ⟶ l''),
        k l l'' (f ≫ g) = k l l' f ≫ k l' l'' g := by
      intro l l' l'' f g
      apply Limits.pullback.hom_ext
      · rw [hk1, hm_comp, Category.assoc, hk1, reassoc_of% (hk1 l l' f)]
      · rw [hk2, Category.assoc, hk2, hk2]
    let Yl : ∀ l, (V : Scheme.{u}).Etale := fun l => MorphismProperty.Over.mk ⊤
      (Limits.pullback.snd (W'.obj l).right.hom (V.ι ≫ ι)) (by haveI := hEt l; infer_instance)
    let Af : Λ ⥤ StructuredArrow (Over.mk gV) (Scheme.Etale.forget (V : Scheme.{u})) :=
      { obj := fun l => StructuredArrow.mk (S := Over.mk gV)
          (T := Scheme.Etale.forget (V : Scheme.{u})) (Y := Yl l)
          (Over.homMk (q l) (by exact hq2 l))
        map := fun {l l'} tt => StructuredArrow.homMk
          (MorphismProperty.Over.homMk (A := Yl l) (B := Yl l') (k l l' tt) (by exact hk2 l l' tt) trivial)
          (by exact Over.OverMorphism.ext (hqk l l' tt))
        map_id := fun l => by
          apply StructuredArrow.hom_ext
          apply MorphismProperty.Over.Hom.ext
          exact hk_id l
        map_comp := fun {l l' l''} f g => by
          apply StructuredArrow.hom_ext
          apply MorphismProperty.Over.Hom.ext
          exact hk_comp l l' l'' f g }
    refine ⟨Af, fun l => Iso.refl _, ?_, fun l => Category.id_comp _, ?_, ?_⟩
    rotate_left
    · intro l l' tt
      exact (Category.id_comp _).trans ((hk1 l l' tt).trans
        (congrArg (fun φ => Limits.pullback.fst (W'.obj l).right.hom (V.ι ≫ ι) ≫ φ) (hmdef l l' tt)))
    · intro l
      exact (Category.id_comp _).trans ((hq1 l).trans (congrArg (fun φ => θθ ≫ φ) (hpdef l)))

    refine Functor.initial_of_exists_of_isCofiltered Af ?_ ?_
    ·
      intro d
      haveI : Etale d.right.hom := d.right.prop
      obtain ⟨n₀, hn₀def⟩ : ∃ n₀ : Spec (.of (AlgebraicClosure ((V : Scheme.{u}).residueField y))) ⟶
          d.right.left, n₀ = d.hom.left := ⟨_, rfl⟩
      have hn₀ : n₀ ≫ d.right.hom = gV := by
        rw [hn₀def]; exact Over.w d.hom
      obtain ⟨V', e, he, h, x', hhw, hhx⟩ := wc_etale_lift_closed_immersion wc_etale_lift_quotient_alg ι
        (d.right.hom ≫ V.ι) (n₀ (IsLocalRing.closedPoint (AlgebraicClosure ((V : Scheme.{u}).residueField y))))
      haveI := he
      haveI : Etale h := MorphismProperty.of_postcomp (W := @Etale) (W' := @Etale) h
        (d.right.hom ≫ V.ι) inferInstance (by rw [hhw]; infer_instance)
      obtain ⟨t, ht, -⟩ := wc_etale_lift_alg_closed_point
        (AlgebraicClosure (Xb.residueField (ι (V.ι y)))) h (inv θθ ≫ n₀) x' (by
          rw [hhx]
          exact (congrArg n₀ (Subsingleton.elim _ _)).trans (Scheme.Hom.comp_apply _ _ _).symm)
      have ht' : ∀ {W : Scheme.{u}} (r : d.right.left ⟶ W), t ≫ h ≫ r = inv θθ ≫ n₀ ≫ r := by
        intro W r; rw [← Category.assoc, ht, Category.assoc]
      have hn₀' : ∀ {W : Scheme.{u}} (r : (V : Scheme.{u}) ⟶ W), n₀ ≫ d.right.hom ≫ r = gV ≫ r := by
        intro W r; rw [← Category.assoc, hn₀]
      have hp' : (t ≫ Limits.pullback.fst e ι) ≫ e = gX := by
        rw [Category.assoc, Limits.pullback.condition, ← hhw, Category.assoc, Category.assoc, ht',
          hn₀', ← hθ, IsIso.inv_hom_id_assoc]
      let E' : Xb.Etale := MorphismProperty.Over.mk ⊤ e he
      let d' : StructuredArrow (Over.mk gX) (Scheme.Etale.forget Xb) :=
        StructuredArrow.mk (Y := E') (Over.homMk (t ≫ Limits.pullback.fst e ι) hp')
      obtain ⟨l, ⟨α⟩⟩ := ((Functor.initial_iff_of_isCofiltered W').mp hInit).1 d'
      obtain ⟨mα, hmαdef⟩ : ∃ mα : (W'.obj l).right.left ⟶ V', mα = α.right.left := ⟨_, rfl⟩
      have hmα : mα ≫ e = (W'.obj l).right.hom := by rw [hmαdef]; exact MorphismProperty.Over.w α.right
      have hpα : p l ≫ mα = t ≫ Limits.pullback.fst e ι := by
        rw [hpdef, hmαdef]; exact congrArg CommaMorphism.left (StructuredArrow.w α)
      obtain ⟨c, hc1, hc2⟩ : ∃ c : Limits.pullback (W'.obj l).right.hom (V.ι ≫ ι) ⟶ Limits.pullback e ι,
          c ≫ Limits.pullback.fst e ι = Limits.pullback.fst (W'.obj l).right.hom (V.ι ≫ ι) ≫ mα ∧
          c ≫ Limits.pullback.snd e ι = Limits.pullback.snd (W'.obj l).right.hom (V.ι ≫ ι) ≫ V.ι :=
        ⟨Limits.pullback.lift (Limits.pullback.fst (W'.obj l).right.hom (V.ι ≫ ι) ≫ mα)
            (Limits.pullback.snd (W'.obj l).right.hom (V.ι ≫ ι) ≫ V.ι)
            (by rw [Category.assoc, hmα, Limits.pullback.condition, Category.assoc]),
          Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
      have hf : (c ≫ h) ≫ d.right.hom = Limits.pullback.snd (W'.obj l).right.hom (V.ι ≫ ι) := by
        rw [← cancel_mono V.ι, Category.assoc, Category.assoc, hhw, hc2]
      have hqc : q l ≫ c = θθ ≫ t := by
        apply Limits.pullback.hom_ext
        · rw [Category.assoc, Category.assoc, hc1, reassoc_of% (hq1 l), hpα]
        · rw [Category.assoc, Category.assoc, hc2, reassoc_of% (hq2 l), ← hhw, ht',
            IsIso.hom_inv_id_assoc, hn₀']
      have hqf : q l ≫ (c ≫ h) = n₀ := by
        rw [← Category.assoc, hqc, Category.assoc, ht, IsIso.hom_inv_id_assoc]
      exact ⟨l, ⟨StructuredArrow.homMk (MorphismProperty.Over.homMk (A := Yl l) (c ≫ h) hf trivial)
        (by exact Over.OverMorphism.ext (hqf.trans hn₀def))⟩⟩
    ·
      intro d l s s'
      haveI : Etale d.right.hom := d.right.prop
      obtain ⟨n₀, hn₀def⟩ : ∃ n₀ : Spec (.of (AlgebraicClosure ((V : Scheme.{u}).residueField y))) ⟶
          d.right.left, n₀ = d.hom.left := ⟨_, rfl⟩
      obtain ⟨σ, hσdef⟩ : ∃ σ : Limits.pullback (W'.obj l).right.hom (V.ι ≫ ι) ⟶ d.right.left,
          σ = s.right.left := ⟨_, rfl⟩
      obtain ⟨σ', hσ'def⟩ : ∃ σ' : Limits.pullback (W'.obj l).right.hom (V.ι ≫ ι) ⟶ d.right.left,
          σ' = s'.right.left := ⟨_, rfl⟩
      have hσ : σ ≫ d.right.hom = Limits.pullback.snd (W'.obj l).right.hom (V.ι ≫ ι) := by
        rw [hσdef]; exact MorphismProperty.Over.w s.right
      have hσ' : σ' ≫ d.right.hom = Limits.pullback.snd (W'.obj l).right.hom (V.ι ≫ ι) := by
        rw [hσ'def]; exact MorphismProperty.Over.w s'.right
      have hqσ : q l ≫ σ = n₀ := by
        rw [hσdef, hn₀def]; exact congrArg CommaMorphism.left (StructuredArrow.w s)
      have hqσ' : q l ≫ σ' = n₀ := by
        rw [hσ'def, hn₀def]; exact congrArg CommaMorphism.left (StructuredArrow.w s')
      obtain ⟨Sg, hS1, hS2⟩ : ∃ Sg : Limits.pullback (W'.obj l).right.hom (V.ι ≫ ι) ⟶
          Limits.pullback d.right.hom d.right.hom,
          Sg ≫ Limits.pullback.fst d.right.hom d.right.hom = σ ∧
          Sg ≫ Limits.pullback.snd d.right.hom d.right.hom = σ' :=
        ⟨Limits.pullback.lift σ σ' (hσ.trans hσ'.symm),
          Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
      have hQo : IsOpen (Sg ⁻¹' Set.range (Limits.pullback.diagonal d.right.hom)) :=
        Sg.continuous.isOpen_preimage _
          (Limits.pullback.diagonal d.right.hom).isOpenEmbedding.isOpen_range
      have hqSg : q l ≫ Sg = n₀ ≫ Limits.pullback.diagonal d.right.hom := by
        apply Limits.pullback.hom_ext
        · rw [Category.assoc, hS1, hqσ, Category.assoc, Limits.pullback.diagonal_fst, Category.comp_id]
        · rw [Category.assoc, hS2, hqσ', Category.assoc, Limits.pullback.diagonal_snd,
            Category.comp_id]
      have cl2 : ∀ {T : Scheme.{u}} (kk : T ⟶ Limits.pullback (W'.obj l).right.hom (V.ι ≫ ι)),
          Set.range kk ⊆ Sg ⁻¹' Set.range (Limits.pullback.diagonal d.right.hom) →
          kk ≫ σ = kk ≫ σ' := by
        intro T kk hkk
        have hr : Set.range (kk ≫ Sg) ⊆ Set.range (Limits.pullback.diagonal d.right.hom) := by
          rintro _ ⟨v, rfl⟩
