    have e2 : Φ l ∣ z ↔ l ∣ Φ.symm z := by
      conv_lhs => rw [← Φ.apply_symm_apply z]
      exact map_dvd_iff Φ
    rw [e1 a₁ z, e1 b₁ z, e2]
    exact hl _

  obtain ⟨l₁⟩ : Nonempty Λ := IsCofiltered.nonempty
  have hcl := wc_shdata_closed_point_compat y B Λ W' φ a ha l₁
  have hφa : φ l₁ ≫ (W'.obj l₁).right.hom = a := by
    obtain ⟨_, _, _, h4, _⟩ := ha
