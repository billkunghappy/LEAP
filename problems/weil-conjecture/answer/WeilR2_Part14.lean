      ext z
      simp only [Set.mem_singleton_iff, Set.mem_preimage]
      constructor
      · rintro rfl; exact hy1
      · intro hz; exact hinj (hz.trans hy1.symm)
    rw [hset]
    exact hx.preimage (Limits.pullback.fst
      (Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) res).continuous
  obtain ⟨y0, hy0, hy0pt⟩ := wc_glc_closed_point_section (IsLocalRing.ResidueField A) _
    (Limits.pullback.snd (Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) res) y hyc
  let s0 := y0 ≫ Limits.pullback.fst (Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) res
  have hs0 : s0 ≫ Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A))) = res := by
    simp only [s0]
    rw [Category.assoc, Limits.pullback.condition, ← Category.assoc, hy0, Category.id_comp]
  have hs0pt : s0 (IsLocalRing.closedPoint _) = e w :=
    (Scheme.Hom.comp_apply y0 (Limits.pullback.fst
      (Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) res) _).trans
      ((congrArg (Limits.pullback.fst
        (Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) res) hy0pt).trans hy1)
  obtain ⟨t, ht, htpt⟩ := wc_etale_lift_alg_closed_point (IsLocalRing.ResidueField A) e s0 w
    hs0pt.symm
  obtain ⟨R, fo, hfo, hmem, -⟩ := Scheme.exists_affine_mem_range_and_range_subset (U := ⊤)
    (x := t (IsLocalRing.closedPoint (IsLocalRing.ResidueField A))) trivial
  haveI := hfo
  have hrange : Set.range t ⊆ Set.range fo := by
    rintro _ ⟨q, rfl⟩
    rw [Subsingleton.elim q (IsLocalRing.closedPoint _)]
    exact hmem
  let t' := IsOpenImmersion.lift fo t hrange
  have ht' : t' ≫ fo = t := IsOpenImmersion.lift_fac fo t hrange
  haveI : Smooth (fo ≫ e ≫ Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) :=
    inferInstance
  let φ := Spec.preimage (fo ≫ e ≫ Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A))))
  have hφ : Spec.map φ = fo ≫ e ≫ Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A))) :=
    Spec.map_preimage _
  letI : Algebra A R := φ.hom.toAlgebra
  haveI : Algebra.Smooth A R := by
    have h : Smooth (Spec.map φ) := by rw [hφ]; infer_instance
    rw [HasRingHomProperty.Spec_iff (P := @Smooth)] at h
    exact h
  let ψ := Spec.preimage t'
  have hψ : Spec.map ψ = t' := Spec.map_preimage _
  have hφψ : φ ≫ ψ = CommRingCat.ofHom (IsLocalRing.residue A) := by
    apply Spec.map_injective
    rw [Spec.map_comp, hψ, hφ, ← Category.assoc, ht', ← Category.assoc, ht, hs0]
  have hφψ' : ∀ a : A, ψ.hom (φ.hom a) = IsLocalRing.residue A a := fun a =>
    congrArg (fun f => f.hom a) hφψ
  let σbar : R →ₐ[A] IsLocalRing.ResidueField A :=
    { ψ.hom with
      commutes' := fun a => by
        rw [IsLocalRing.ResidueField.algebraMap_eq]
        exact hφψ' a }
  obtain ⟨τ, hτ⟩ := wc_hnas_smooth_section_henselian A R σbar
  let τ' : R ⟶ CommRingCat.of A := CommRingCat.ofHom (τ : R →+* A)
  have hφτ : φ ≫ τ' = 𝟙 _ := by
    ext a
    exact τ.commutes a
  have hτres : τ' ≫ CommRingCat.ofHom (IsLocalRing.residue A) = ψ := by
    ext r
    exact hτ r
  refine ⟨Spec.map τ' ≫ fo, ?_, ?_⟩
  · rw [Category.assoc, ← hφ, ← Spec.map_comp, hφτ, Spec.map_id]
  · have h1 : res ≫ Spec.map τ' ≫ fo = t := by
      rw [← Category.assoc, ← Spec.map_comp, hτres, hψ, ht']
    let pt : Spec (.of (IsLocalRing.ResidueField A)) := IsLocalRing.closedPoint _
    have h2 : (res ≫ Spec.map τ' ≫ fo) pt = t pt :=
      congrArg (fun g : Spec (.of (IsLocalRing.ResidueField A)) ⟶ W => g pt) h1
    exact (congrArg (Spec.map τ' ≫ fo) (hres pt)).symm.trans
      ((Scheme.Hom.comp_apply res (Spec.map τ' ≫ fo) pt).symm.trans (h2.trans htpt))

theorem wc_fsa_ufd_kummer_generator_dom : ∀ (L : Type u) [CommRing L] [IsDomain L] (ℓ : ℕ), ℓ.Prime → IsUnit (ℓ : L) → ∀ (ζ : L), IsPrimitiveRoot ζ ℓ → ∀ (S C : Type u) [CommRing S] [IsDomain S] [UniqueFactorizationMonoid S] [CommRing C] [Algebra L S] [Algebra S C] [Algebra L C] [IsScalarTower L S C] (σC : ZMod ℓ → (C →ₐ[S] C)), σC 0 = AlgHom.id S C → (∀ c c', σC (c + c') = (σC c).comp (σC c')) → Algebra.Etale S C → Module.Finite S C → Function.Surjective (PrimeSpectrum.comap (algebraMap S C)) → Function.Bijective (wcTorDescMu S C ℓ σC) → ∃ (t : C) (a : Sˣ), σC 1 t = algebraMap L C ζ * t ∧ t ^ ℓ = algebraMap S C a :=
by
  classical
  intro L _ _ ℓ hℓ hℓu ζ hζ S C _ _ _ _ _ _ _ _ σC hσ0 hσadd hCet hCfin hCsurj hCbij
  haveI : NeZero ℓ := ⟨hℓ.ne_zero⟩
  obtain ⟨uℓ, huℓ⟩ := hℓu
  have hℓbar : (ℓ : L) * ((uℓ⁻¹ : Lˣ) : L) = 1 := by rw [← huℓ, Units.mul_inv]

  have hσL : ∀ (c : ZMod ℓ) (l : L) (b : C),
      σC c (algebraMap L C l * b) = algebraMap L C l * σC c b := by
    intro c l b
    rw [map_mul, IsScalarTower.algebraMap_apply L S C, AlgHom.commutes]
  have hσnat : ∀ (c d : ZMod ℓ) (b : C), σC (c + d) b = σC c (σC d b) := by
    intro c d b
    rw [hσadd]
    rfl
  have hmul : ∀ (c d : L) (u v : C), σC 1 u = algebraMap L C c * u →
      σC 1 v = algebraMap L C d * v → σC 1 (u * v) = algebraMap L C (c * d) * (u * v) := by
    intro c d u v hu hv
    rw [map_mul, hu, hv, map_mul]
    ring
  have hmuapp : ∀ (a b : C) (c : ZMod ℓ), wcTorDescMu S C ℓ σC (a ⊗ₜ[S] b) c = σC c a * b := by
    intro a b c
    simp [wcTorDescMu, Algebra.TensorProduct.lift_tmul]
  haveI : Module.Flat S C := inferInstance
  haveI : Module.FaithfullyFlat S C := Module.FaithfullyFlat.of_comap_surjective hCsurj
  have hinj : Function.Injective (algebraMap S C) := FaithfulSMul.algebraMap_injective S C
  have hfixS : ∀ b : C, σC 1 b = b → b ∈ Set.range (algebraMap S C) := by
    intro b hb
    have hn : ∀ n : ℕ, σC (n : ZMod ℓ) b = b := by
      intro n
      induction n with
      | zero => simp [hσ0]
      | succ n ih => rw [Nat.cast_succ, hσnat, hb, ih]
    have hall : ∀ c, σC c b = b := by
      intro c
      rw [← ZMod.natCast_zmod_val c]
      exact hn _
    have h1 : (b ⊗ₜ[S] (1 : C) : TensorProduct S C C) = (1 : C) ⊗ₜ[S] b := by
      apply hCbij.1
      funext c
      rw [hmuapp, hmuapp, hall, map_one, mul_one, one_mul]
    let N : Submodule S C := LinearMap.range (Algebra.linearMap S C)
    have h2 := congrArg (LinearMap.lTensor C N.mkQ) h1
    rw [LinearMap.lTensor_tmul, LinearMap.lTensor_tmul] at h2
    have h3 : N.mkQ 1 = 0 := by
      rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
      exact ⟨1, by rw [Algebra.linearMap_apply, map_one]⟩
    rw [h3, TensorProduct.tmul_zero] at h2
    have h4 : N.mkQ b = 0 := by
      apply Module.FaithfullyFlat.tensorProduct_mk_injective (A := S) (B := C) (C ⧸ N)
      rw [map_zero]
      exact h2.symm
    rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero] at h4
    obtain ⟨s, hs⟩ := h4
    exact ⟨s, hs⟩
  have hE1 : ∀ b : C, b ∈ wcKummerEigDom (σC 1) (1 : L) ↔ b ∈ Set.range (algebraMap S C) := by
    intro b
    show σC 1 b = algebraMap L C 1 * b ↔ _
    rw [map_one, one_mul]
    constructor
    · exact hfixS b
    · rintro ⟨s, rfl⟩
      exact AlgHom.commutes _ s
  let jlin : S →ₗ[S] wcKummerEigDom (σC 1) (1 : L) :=
    LinearMap.codRestrict _ (Algebra.linearMap S C) (fun s => (hE1 _).2 ⟨s, rfl⟩)
  have hjbij : Function.Bijective jlin := by
    refine ⟨fun a b h => hinj (congrArg Subtype.val h), fun z => ?_⟩
    obtain ⟨s, hs⟩ := (hE1 z).1 z.2
    exact ⟨s, Subtype.ext hs⟩
  let j : S ≃ₗ[S] wcKummerEigDom (σC 1) (1 : L) := LinearEquiv.ofBijective jlin hjbij
  have hj : ∀ s, (j s : C) = algebraMap S C s := fun s => rfl
  obtain ⟨t, ht⟩ := hCbij.2 (Pi.single 0 1)
  obtain ⟨P, hP⟩ := TensorProduct.exists_finset t
  have hstar : ∀ e : ZMod ℓ, ∑ p ∈ P, σC e p.1 * p.2 = if e = 0 then 1 else 0 := by
    intro e
    have h := congrFun ht e
    rw [hP, map_sum, Finset.sum_apply] at h
    simp only [hmuapp] at h
    rw [h, Pi.single_apply]
  have hcd : ∀ c d : ZMod ℓ, ∑ p ∈ P, σC c p.1 * σC d p.2 = if c = d then 1 else 0 := by
    intro c d
    have hc : d + (c - d) = c := by abel
    have h : ∀ p : C × C, σC c p.1 * σC d p.2 = σC d (σC (c - d) p.1 * p.2) := by
      intro p
      rw [map_mul, ← hσnat, hc]
    simp_rw [h]
    rw [← map_sum, hstar]
    by_cases hcd : c = d
    · subst hcd
      simp
    · have : c - d ≠ 0 := sub_ne_zero.mpr hcd
      simp [this, hcd]
  have hpart : ∀ ω : L, ω ^ ℓ = 1 → ∃ x y : C × C → C,
      (∀ p, σC 1 (x p) = algebraMap L C ω * x p) ∧
      (∀ p, σC 1 (y p) = algebraMap L C (ω ^ (ℓ - 1)) * y p) ∧ ∑ p ∈ P, x p * y p = 1 := by
    intro ω hω
    have hωω : ω ^ (ℓ - 1) * ω = 1 := by
      rw [← pow_succ, Nat.sub_add_cancel hℓ.one_le, hω]
    let χ : ZMod ℓ → L := fun c => ω ^ c.val
    have hχadd : ∀ c d, χ (c + d) = χ c * χ d := by
      intro c d
