        have e : (t + s) * 1 - t = s := by ring
        rw [e] at h
        exact h
      have htpow : ∀ n : ℕ, t ^ n ∈ M ∧ t ^ (n + 1) ∈ M := by
        intro n
        induction n with
        | zero => exact ⟨by simpa using h1, by simpa using ht⟩
        | succ k ih =>
          refine ⟨ih.2, ?_⟩
          have h := M.sub_mem (hmemX _ ih.2) ih.1
          have e : (t + s) * t ^ (k + 1) - t ^ k = t ^ (k + 1 + 1) := by
            have : (t + s) * t ^ (k + 1) = t ^ (k + 1 + 1) + (t * s) * t ^ k := by ring
            rw [this, hts, one_mul, add_sub_cancel_right]
          rw [e] at h
          exact h
      have hspow : ∀ n : ℕ, s ^ n ∈ M ∧ s ^ (n + 1) ∈ M := by
        intro n
        induction n with
        | zero => exact ⟨by simpa using h1, by simpa using hs⟩
        | succ k ih =>
