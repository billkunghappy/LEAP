theorem wc_pfc_p_presentation : ∀ (k : Type u) [Field k] (A : Type u) [CommRing A] [Algebra k A] [Algebra.FinitePresentation k A] (t N d : ℕ) (a : Fin t → A), (∀ j, Algebra.Smooth k (Localization.Away (a j))) → ∃ (C : Type u) (_ : CommRing C) (_ : Algebra (MvPolynomial (Fin d) k) C) (_ : Algebra k C) (_ : IsScalarTower k (MvPolynomial (Fin d) k) C) (_ : Algebra.FinitePresentation (MvPolynomial (Fin d) k) C) (ι : A →ₐ[k] C) (c : ℕ), 1 ≤ c ∧ (∀ j, Algebra.Smooth (MvPolynomial (Fin d) k) (Localization.Away (ι (a j)))) ∧ (∀ i, wcPfcStrictStd (MvPolynomial (Fin d) k) C (algebraMap (MvPolynomial (Fin d) k) C (MvPolynomial.X i ^ c))) ∧ ∀ (Λ : Type u) [CommRing Λ] [Algebra k Λ] [Algebra (MvPolynomial (Fin d) k) Λ] [IsScalarTower k (MvPolynomial (Fin d) k) Λ] (φ : A →ₐ[k] Λ) (μ : Fin d → Fin t → Λ), (∀ i, algebraMap (MvPolynomial (Fin d) k) Λ (MvPolynomial.X i) ^ (2 * N) = ∑ j, μ i j * φ (a j)) → ∃ χ : C →ₐ[MvPolynomial (Fin d) k] Λ, ∀ x, χ (ι x) = φ x :=
