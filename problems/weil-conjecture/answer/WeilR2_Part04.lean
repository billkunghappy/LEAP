          wc_pbc_P1_quot_vanish_one R A a X' f' a' hsq m hm (Injective.under G) J' ιJ hmono
            hsupp huniv
        have hx0 : x₃ = 0 := @Subsingleton.elim _ hs x₃ 0
        rw [hx0, Abelian.Ext.zero_comp]
      · have hs : Subsingleton (Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology X')
            AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)))
            (Limits.cokernel ιJ) (j + 2)) :=
          wc_pbc_P1_quot_vanish_ge2 R A a X' f' a' hsq m hm (Injective.under G) J' ιJ hmono
            hsupp huniv j
        have hx0 : x₃ = 0 := @Subsingleton.elim _ hs x₃ 0
        rw [hx0, Abelian.Ext.zero_comp]
    exact ⟨J', φ', hφmono, ⟨hJ'tor, hsupp⟩, hJ'acyc n _⟩

  have hshift : ∀ (n : ℕ) (G : Sheaf (Scheme.smallEtaleTopology X') AddCommGrpCat.{u+1}), Q G →
      ∀ e : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology X') AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ))) G n, e = 0 := by
    intro n
    induction n with
    | zero => exact h0
    | succ n ih =>
      intro G hG c
      obtain ⟨G', ι, hι, hG', hc⟩ := hkill G hG n c
      let S := ShortComplex.mk ι (Limits.cokernel.π ι) (Limits.cokernel.condition ι)
      have hS : S.ShortExact :=
        ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel ι) hι inferInstance
      obtain ⟨x₃, hx₃⟩ := Abelian.Ext.covariant_sequence_exact₁ _ hS c hc rfl
      have hx0 : x₃ = 0 := ih _ (hcok ι hG') x₃
      rw [← hx₃, hx0, Abelian.Ext.zero_comp]
  have hs := hshift q F ⟨htor, hF⟩
  change Subsingleton (Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology X')
    AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) F q)
  exact ⟨fun x y => (hs x).trans (hs y).symm⟩

theorem wc_inj_complex_cocycle_exact : ∀ {C : Type*} [Category C] [Abelian C] (P : C) (K : CochainComplex C ℕ), (∀ j, Injective (K.X j)) → letI := HasExt.standard C; (∀ p q : ℕ, Subsingleton (Abelian.Ext P (K.homology q) p)) → ∀ (n : ℕ) (c : P ⟶ K.X n), c ≫ K.d n (n + 1) = 0 → ∃ e : P ⟶ K.X (n - 1), e ≫ K.d (n - 1) n = c :=
by
  intro C _ _ P K hinj hH
  letI : HasExt C := HasExt.standard C

  have s1 : ∀ (q : ℕ) (f : P ⟶ K.homology q), f = 0 := by
    intro q f
    apply Abelian.Ext.homEquiv₀.symm.injective
    exact @Subsingleton.elim _ (hH 0 q) _ _

  have s2 : ∀ k : ℕ, ∃ (Q : C) (q : K.X k ⟶ Q) (j : Q ⟶ K.cycles (k + 1))
      (w₁ : K.iCycles k ≫ q = 0) (w₂ : j ≫ K.homologyπ (k + 1) = 0),
      (ShortComplex.mk (K.iCycles k) q w₁).ShortExact ∧
      (ShortComplex.mk j (K.homologyπ (k + 1)) w₂).ShortExact ∧
      q ≫ j = K.toCycles k (k + 1) := by
    intro k
    have hz : K.iCycles k ≫ K.toCycles k (k + 1) = 0 := by
      rw [← cancel_mono (K.iCycles (k + 1)), Category.assoc, HomologicalComplex.toCycles_i,
        HomologicalComplex.iCycles_d, Limits.zero_comp]
    let j := Limits.cokernel.desc (K.iCycles k) (K.toCycles k (k + 1)) hz
    have hqj : Limits.cokernel.π (K.iCycles k) ≫ j = K.toCycles k (k + 1) :=
      Limits.cokernel.π_desc _ _ _
    have w₂ : j ≫ K.homologyπ (k + 1) = 0 := by
      rw [← cancel_epi (Limits.cokernel.π (K.iCycles k)), ← Category.assoc, hqj,
        HomologicalComplex.toCycles_comp_homologyπ, Limits.comp_zero]
    have hA : (ShortComplex.mk (K.iCycles k) (Limits.cokernel.π (K.iCycles k))
        (Limits.cokernel.condition _)).ShortExact :=
      ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel (K.iCycles k)) inferInstance
        inferInstance
    let S0 := ShortComplex.mk (K.iCycles k) (K.toCycles k (k + 1)) hz
    let Sd := ShortComplex.mk (K.iCycles k) (K.d k (k + 1)) (K.iCycles_d k (k + 1))
    have hSd : Sd.Exact :=
      Sd.exact_of_f_is_kernel (K.cyclesIsKernel k (k + 1) (CochainComplex.next ℕ k))
    let φ0 : S0 ⟶ Sd := ShortComplex.homMk (𝟙 _) (𝟙 _) (K.iCycles (k + 1))
      (by simp [S0, Sd]) (by simp [S0, Sd])
    have : Epi φ0.τ₁ := by change Epi (𝟙 _); infer_instance
    have : IsIso φ0.τ₂ := by change IsIso (𝟙 _); infer_instance
    have : Mono φ0.τ₃ := by change Mono (K.iCycles (k + 1)); infer_instance
    have hS0 : S0.Exact := (ShortComplex.exact_iff_of_epi_of_isIso_of_mono φ0).mpr hSd
    have hj : Mono j := (S0.exact_iff_mono_cokernel_desc).mp hS0
    let S1 := ShortComplex.mk (K.toCycles k (k + 1)) (K.homologyπ (k + 1))
      (K.toCycles_comp_homologyπ k (k + 1))
    have hS1 : S1.Exact :=
      S1.exact_of_g_is_cokernel (K.homologyIsCokernel k (k + 1) (CochainComplex.prev_nat_succ k))
    let S2 := ShortComplex.mk j (K.homologyπ (k + 1)) w₂
    let φ : S1 ⟶ S2 := ShortComplex.homMk (Limits.cokernel.π (K.iCycles k)) (𝟙 _) (𝟙 _)
      (by dsimp [S1, S2]; rw [Category.comp_id]; exact hqj) (by simp [S1, S2])
    have : Epi φ.τ₁ := by change Epi (Limits.cokernel.π (K.iCycles k)); infer_instance
    have : IsIso φ.τ₂ := by change IsIso (𝟙 _); infer_instance
    have : Mono φ.τ₃ := by change Mono (𝟙 _); infer_instance
    have hS2 : S2.Exact := (ShortComplex.exact_iff_of_epi_of_isIso_of_mono φ).mp hS1
    exact ⟨_, _, j, _, w₂, hA, ShortComplex.ShortExact.mk' hS2 hj inferInstance, hqj⟩

  have s3 : ∀ m p : ℕ, Subsingleton (Abelian.Ext P (K.cycles m) (p + 1)) := by
    intro m
    induction m with
    | zero =>
      intro p
      have hd : K.d 0 0 = 0 := K.shape 0 0 (by simp)
      haveI := K.isIso_homologyπ 0 0 CochainComplex.prev_nat_zero hd
      let e := asIso (K.homologyπ 0)
      constructor
      intro x y
      have key : ∀ z : Abelian.Ext P (K.cycles 0) (p + 1),
          (z.comp (Abelian.Ext.mk₀ e.hom) (add_zero _)).comp (Abelian.Ext.mk₀ e.inv)
            (add_zero _) = z := by
        intro z
        rw [Abelian.Ext.comp_assoc _ _ _ (add_zero (p + 1)) (add_zero 0) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
      rw [← key x, ← key y, @Subsingleton.elim _ (hH (p + 1) 0)
        (x.comp (Abelian.Ext.mk₀ e.hom) (add_zero _)) (y.comp (Abelian.Ext.mk₀ e.hom) (add_zero _))]
    | succ m ih =>
      intro p
      obtain ⟨Q, q, j, w₁, w₂, hA, hB, _⟩ := s2 m
      constructor
      suffices hz : ∀ x : Abelian.Ext P (K.cycles (m + 1)) (p + 1), x = 0 by
        intro x y; rw [hz x, hz y]
      intro x
      obtain ⟨y, hy⟩ := Abelian.Ext.covariant_sequence_exact₂ P hB x
        (@Subsingleton.elim _ (hH (p + 1) (m + 1)) _ _)
      obtain ⟨z, hz⟩ := Abelian.Ext.covariant_sequence_exact₃ P hA y rfl
        (@Subsingleton.elim _ (ih (p + 1)) _ _)
      have hz0 : z = 0 := by
        haveI := hinj m
        exact Abelian.Ext.eq_zero_of_injective (I := K.X m) z
      rw [hz0, Abelian.Ext.zero_comp] at hz
      rw [← hy, ← hz, Abelian.Ext.zero_comp]
  intro n c hc
  cases n with
  | zero =>
    have hd : K.d 0 0 = 0 := K.shape 0 0 (by simp)
    haveI := K.isIso_homologyπ 0 0 CochainComplex.prev_nat_zero hd
    refine ⟨0, ?_⟩
    let c' := K.liftCycles c 1 (CochainComplex.next ℕ 0) hc
    have hc' : c' ≫ K.iCycles 0 = c := K.liftCycles_i c 1 _ hc
    have h1 : c' ≫ K.homologyπ 0 = 0 := s1 0 _
    have h2 : c' = 0 := by
      rw [← cancel_mono (K.homologyπ 0), h1, Limits.zero_comp]
    rw [Limits.zero_comp, ← hc', h2, Limits.zero_comp]
  | succ k =>
    show ∃ e : P ⟶ K.X k, e ≫ K.d k (k + 1) = c
    let c' := K.liftCycles c (k + 1 + 1) (CochainComplex.next ℕ (k + 1)) hc
    have hc' : c' ≫ K.iCycles (k + 1) = c := K.liftCycles_i c _ _ hc
    obtain ⟨Q, q, j, w₁, w₂, hA, hB, hqj⟩ := s2 k
    have h1 : c' ≫ K.homologyπ (k + 1) = 0 := s1 (k + 1) _
    haveI := hB.mono_f
    let b : P ⟶ Q := hB.exact.lift c' h1
    have hb : b ≫ j = c' := hB.exact.lift_f c' h1
    have hext : (Abelian.Ext.mk₀ b).comp hA.extClass (zero_add 1) = 0 :=
      @Subsingleton.elim _ (s3 k 0) _ _
    obtain ⟨x₂, hx₂⟩ := Abelian.Ext.covariant_sequence_exact₃ P hA (Abelian.Ext.mk₀ b)
      (zero_add 1) hext
    refine ⟨Abelian.Ext.homEquiv₀ x₂, ?_⟩
    have heq : Abelian.Ext.homEquiv₀ x₂ ≫ q = b := by
      apply Abelian.Ext.homEquiv₀.symm.injective
      rw [Abelian.Ext.homEquiv₀_symm_apply, Abelian.Ext.homEquiv₀_symm_apply,
        ← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_homEquiv₀_apply]
      exact hx₂
    rw [← HomologicalComplex.toCycles_i, ← hqj, ← hc', ← hb, ← heq]
    simp only [Category.assoc]

theorem wc_et_push_homology_supp_of_locKill : ∀ {X' Y : Scheme.{u}} (b : X' ⟶ Y) (K : CochainComplex (Sheaf (Scheme.smallEtaleTopology X') AddCommGrpCat.{u+1}) ℕ) (n : ℕ) (P : Y → Prop), IsOpen {y | ¬ P y} → wcEtLocKillN b K n P → wcSuppIn Y {y | ¬ P y} ((((wcEtPush b).mapHomologicalComplex (ComplexShape.up ℕ)).obj K).homology n) :=
by
  intro X' Y b K n P hW hK

  have hcov : ∀ (V : Y.Etale) (S : Sieve V), (∀ v : V.left, ∃ (V₁ : Y.Etale) (c : V₁ ⟶ V),
      S.arrows c ∧ v ∈ Set.range c.left) → S ∈ Scheme.smallEtaleTopology Y V := by
    intro V S hS
    change S ∈ Scheme.smallGrothendieckTopology @Etale Y V
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
    apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
    intro x
    obtain ⟨V₁, c, hc, y, hy⟩ := hS x
    have hw : c.left ≫ V.hom = V₁.hom := MorphismProperty.Over.w c
    have hEt : Etale c.left := by
      have h1 : Etale V.hom := V.prop
      have h2 : Etale (c.left ≫ V.hom) := by rw [hw]; exact V₁.prop
      exact Etale.of_comp c.left V.hom
    exact ⟨V₁, c, y, hc, hEt, hy⟩

  have s1 : ∀ (F G : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}), (F ≅ G) →
      wcSuppIn Y {y | ¬ P y} F → wcSuppIn Y {y | ¬ P y} G := by
    intro F G e hF V s
    let e' : F.obj ≅ G.obj := (sheafToPresheaf _ _).mapIso e
    let s' := (e'.app (Opposite.op V)).inv s
    refine GrothendieckTopology.superset_covering _ ?_ (hF V s')
    rw [Sieve.generate_le_iff]
    intro V' g hg
    apply Sieve.le_generate
    rcases hg with hg | hg
    · left
      have hs : s = (e'.hom.app (Opposite.op V)) s' :=
        (Iso.inv_hom_id_apply (e'.app (Opposite.op V)) s).symm
      rw [hs, ← NatTrans.naturality_apply, hg, map_zero]
    · right; exact hg

  have s2 : ∀ (G : (Y.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1}),
      (∀ (V : Y.Etale) (z : G.obj (Opposite.op V)),
        Sieve.generate (fun (V' : Y.Etale) (g : V' ⟶ V) =>
          G.map g.op z = 0 ∨ ∀ x, V'.hom x ∈ {y | ¬ P y}) ∈ Scheme.smallEtaleTopology Y V) →
      wcSuppIn Y {y | ¬ P y}
        ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj G) := by
    intro G hG V s
    let η := toSheafify (Scheme.smallEtaleTopology Y) G
    have : Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology Y) η :=
      Presheaf.isLocallySurjective_toSheafify' _ _
    have hI := Presheaf.imageSieve_mem (Scheme.smallEtaleTopology Y) η s
    refine GrothendieckTopology.transitive _ hI _ ?_
    intro V₁ f hf
    obtain ⟨t, ht⟩ := hf
    refine GrothendieckTopology.superset_covering _ ?_ (hG V₁ t)
    rw [Sieve.generate_le_iff]
    intro V₂ g hg
    rw [Sieve.pullback_apply]
    apply Sieve.le_generate
    rcases hg with hg | hg
    · left
      change (sheafify (Scheme.smallEtaleTopology Y) G).map (g ≫ f).op s = 0
      rw [op_comp, Functor.map_comp, ConcreteCategory.comp_apply, ← ht,
        ← NatTrans.naturality_apply, hg, map_zero]
    · right; exact hg

  have s3 : ∀ (S : ShortComplex ((Y.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1})),
      (∀ (V : Y.Etale) (c : S.X₂.obj (Opposite.op V)), (S.g.app (Opposite.op V)).hom c = 0 →
        ∀ v : V.left, P (V.hom v) →
        ∃ (W : Y.Etale) (g : W ⟶ V) (w : W.left) (e : S.X₁.obj (Opposite.op W)),
          g.left w = v ∧ (S.f.app (Opposite.op W)).hom e = (S.X₂.map g.op).hom c) →
      ∀ (V : Y.Etale) (z : S.homology.obj (Opposite.op V)),
        Sieve.generate (fun (V' : Y.Etale) (g : V' ⟶ V) =>
          S.homology.map g.op z = 0 ∨ ∀ x, V'.hom x ∈ {y | ¬ P y}) ∈
            Scheme.smallEtaleTopology Y V := by
    intro S hS V z
    have hπ : Epi (S.homologyπ.app (Opposite.op V)) :=
      (NatTrans.epi_iff_epi_app _).1 inferInstance _
    obtain ⟨k, rfl⟩ := (AddCommGrpCat.epi_iff_surjective _).1 hπ z
    have hι : ∀ X, Function.Injective (ConcreteCategory.hom (S.iCycles.app X)) := fun X =>
      (AddCommGrpCat.mono_iff_injective _).1 ((NatTrans.mono_iff_mono_app _).1 inferInstance X)
    have hc : (S.g.app (Opposite.op V)).hom ((S.iCycles.app (Opposite.op V)).hom k) = 0 := by
      have := congrArg (fun φ => (φ.app (Opposite.op V)).hom k) S.iCycles_g
      simp only [NatTrans.comp_app, AddCommGrpCat.hom_comp, AddMonoidHom.coe_comp,
        Function.comp_apply, NatTrans.app_zero, AddCommGrpCat.hom_zero,
        AddMonoidHom.zero_apply] at this
      exact this
    apply hcov
    intro v
    by_cases hv : P (V.hom v)
    · obtain ⟨W, g, w, e, hw, he⟩ := hS V _ hc v hv
      refine ⟨W, g, ?_, w, hw⟩
      apply Sieve.le_generate
      left
      have h1 : ConcreteCategory.hom (S.cycles.map g.op) k =
          ConcreteCategory.hom (S.toCycles.app (Opposite.op W)) e := by
        apply hι
        rw [NatTrans.naturality_apply]
        have n2 := congrArg (fun φ => (φ.app (Opposite.op W)).hom e) S.toCycles_i
        simp only [NatTrans.comp_app, AddCommGrpCat.hom_comp, AddMonoidHom.coe_comp,
          Function.comp_apply] at n2
        exact (he.symm.trans n2.symm)
      rw [← NatTrans.naturality_apply, h1]
      have n3 := congrArg (fun φ => (φ.app (Opposite.op W)).hom e) S.toCycles_comp_homologyπ
      simp only [NatTrans.comp_app, AddCommGrpCat.hom_comp, AddMonoidHom.coe_comp,
        Function.comp_apply] at n3
      simpa using n3
    · let O : V.left.Opens := V.hom ⁻¹ᵁ (⟨{y | ¬ P y}, hW⟩ : Y.Opens)
      have hvO : v ∈ O := hv
      refine ⟨wcEtOpen Y V O, wcEtOpenι Y V O, ?_, ⟨v, hvO⟩, ?_⟩
      · apply Sieve.le_generate
        right
        intro x
        exact x.2
      · show O.ι ⟨v, hvO⟩ = v
        exact Scheme.Opens.ι_apply _ _

  have hprev : ∀ m : ℕ, (ComplexShape.up ℕ).prev m = m - 1 := by
    intro m
    cases m with
    | zero => exact CochainComplex.prev_nat_zero
    | succ k => exact CochainComplex.prev_nat_succ k
  let Φ : Sheaf (Scheme.smallEtaleTopology X') AddCommGrpCat.{u+1} ⥤
      ((Y.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) :=
    sheafToPresheaf (Scheme.smallEtaleTopology X') AddCommGrpCat.{u+1} ⋙
      (Functor.whiskeringLeft (Y.Etale)ᵒᵖ (X'.Etale)ᵒᵖ AddCommGrpCat.{u+1}).obj
        (@Functor.op Y.Etale _ X'.Etale _ (wcEtBaseChange b))
  let Sp : ShortComplex ((Y.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) :=
    ShortComplex.mk (Φ.map (K.d (n - 1) n)) (Φ.map (K.d n (n + 1)))
      (by rw [← Functor.map_comp, K.d_comp_d, Functor.map_zero])
  have hloc : ∀ (V : Y.Etale) (c : Sp.X₂.obj (Opposite.op V)),
      (Sp.g.app (Opposite.op V)).hom c = 0 →
      ∀ v : V.left, P (V.hom v) →
      ∃ (W : Y.Etale) (g : W ⟶ V) (w : W.left) (e : Sp.X₁.obj (Opposite.op W)),
        g.left w = v ∧ (Sp.f.app (Opposite.op W)).hom e = (Sp.X₂.map g.op).hom c :=
    fun V c hc v hv => hK V c hc v hv
  have h2 := s2 Sp.homology (s3 Sp hloc)
  exact s1 _ _
    ((HomologicalComplex.homologyIsoSc' (((wcEtPush b).mapHomologicalComplex
        (ComplexShape.up ℕ)).obj K) (n - 1) n (n + 1) (hprev n)
        (CochainComplex.next ℕ n) :
      _ ≅ (Sp.map (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})).homology) ≪≫
      Sp.mapHomologyIso (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})).symm
    h2

theorem wc_adj_resolution_cocycle_lift : ∀ {C : Type*} {D : Type*} [Category C] [Category D] [Abelian C] [Abelian D] (L : C ⥤ D) (R : D ⥤ C) [R.Additive] (adj : L ⊣ R) [Limits.PreservesFiniteLimits L] (P : D) (A : C) (I : InjectiveResolution A), letI := HasExt.standard D; (∀ q : ℕ, Subsingleton (Abelian.Ext P (L.obj A) q)) → (∀ j q : ℕ, Subsingleton (Abelian.Ext P (L.obj (I.cocomplex.X j)) (q + 1))) → ∀ (n : ℕ) (c : P ⟶ L.obj (I.cocomplex.X n)), c ≫ L.map (I.cocomplex.d n (n + 1)) = 0 → ∃ e : P ⟶ L.obj (I.cocomplex.X (n - 1)), e ≫ L.map (I.cocomplex.d (n - 1) n) = c :=
by
  intro C D _ _ _ _ L R _ adj _ P A I
  letI := HasExt.standard D
  intro hA hK n c hc
  haveI : L.Additive := adj.left_adjoint_additive
  haveI : Limits.PreservesColimitsOfSize L := adj.leftAdjoint_preservesColimits

  have s1 : ∀ (S : ShortComplex D), S.ShortExact →
      (∀ q : ℕ, Subsingleton (Abelian.Ext P S.X₁ (q + 1))) →
      (∀ q : ℕ, Subsingleton (Abelian.Ext P S.X₂ (q + 1))) →
      ∀ q : ℕ, Subsingleton (Abelian.Ext P S.X₃ (q + 1)) := by
    intro S hS h1 h2 q
    haveI := h1 (q + 1)
    haveI := h2 q
    constructor
    suffices hz : ∀ z : Abelian.Ext P S.X₃ (q + 1), z = 0 by
      intro x y; rw [hz x, hz y]
    intro z
    obtain ⟨x₂, hx₂⟩ := Abelian.Ext.covariant_sequence_exact₃ P hS z
      (rfl : q + 1 + 1 = q + 1 + 1) (Subsingleton.elim _ _)
    rw [← hx₂, Subsingleton.elim x₂ 0, Abelian.Ext.zero_comp]

  have s2 : ∀ (S : ShortComplex D), S.ShortExact → Subsingleton (Abelian.Ext P S.X₁ 1) →
      ∀ f : P ⟶ S.X₃, ∃ g : P ⟶ S.X₂, g ≫ S.g = f := by
    intro S hS h1 f
    obtain ⟨x₂, hx₂⟩ := Abelian.Ext.covariant_sequence_exact₃ P hS (Abelian.Ext.mk₀ f)
      (zero_add 1) (Subsingleton.elim _ _)
    refine ⟨Abelian.Ext.homEquiv₀ x₂, ?_⟩
    apply (Abelian.Ext.mk₀_bijective P S.X₃).1
    rw [← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_homEquiv₀_apply]
    exact hx₂

  have s3 : ∀ {X Y W : D} (f : X ⟶ Y) (g : Y ⟶ W) (hfg : f ≫ g = 0),
      (ShortComplex.mk f g hfg).Exact → ∀ (Z : D) (i : Z ⟶ X) (hi : i ≫ f = 0),
      Limits.IsLimit (Limits.KernelFork.ofι i hi) →
      ∃ w : i ≫ Limits.kernel.lift g f hfg = 0,
        (ShortComplex.mk i (Limits.kernel.lift g f hfg) w).ShortExact := by
    intro X Y W f g hfg hex Z i hi hl
    have w : i ≫ Limits.kernel.lift g f hfg = 0 := by
      rw [← cancel_mono (Limits.kernel.ι g), Category.assoc, Limits.kernel.lift_ι, hi,
        Limits.zero_comp]
    refine ⟨w, ?_⟩
    haveI : Mono i := Limits.mono_of_isLimit_fork hl
    haveI : Epi (Limits.kernel.lift g f hfg) := hex.epi_kernelLift
    refine ShortComplex.ShortExact.mk' ?_ inferInstance inferInstance
    exact ShortComplex.exact_of_f_is_kernel _
      (Limits.isKernelOfComp (Limits.kernel.ι g) f hl w (Limits.kernel.lift_ι g f hfg))

  have hw : ∀ m : ℕ, L.map (I.cocomplex.d m (m + 1)) ≫ L.map (I.cocomplex.d (m + 1) (m + 1 + 1))
      = 0 := by
    intro m
    rw [← L.map_comp, HomologicalComplex.d_comp_d, L.map_zero]
  have hex : ∀ m : ℕ, (ShortComplex.mk (L.map (I.cocomplex.d m (m + 1)))
      (L.map (I.cocomplex.d (m + 1) (m + 1 + 1))) (hw m)).Exact := fun m =>
    (I.exact_succ m).map L
  have hι0 : L.map (I.ι.f 0) ≫ L.map (I.cocomplex.d 0 1) = 0 := by
    rw [← L.map_comp, InjectiveResolution.ι_f_zero_comp_complex_d, L.map_zero]
  haveI : Mono (L.map (I.ι.f 0)) := L.map_mono _
  have h₀ : Limits.IsLimit (Limits.KernelFork.ofι (L.map (I.ι.f 0)) hι0) := by
    let S0 := ShortComplex.mk (I.ι.f 0) (I.cocomplex.d 0 1)
      (by rw [InjectiveResolution.ι_f_zero_comp_complex_d])
    have hE : (S0.map L).Exact := I.exact₀.map L
    haveI : Mono (S0.map L).f := (inferInstance : Mono (L.map (I.ι.f 0)))
    exact hE.fIsKernel

  have hA' : ∀ q, Subsingleton (Abelian.Ext P (L.obj (((CochainComplex.single₀ C).obj A).X 0)) q) := by
    intro q
    let e₀ := HomologicalComplex.singleObjXSelf (ComplexShape.up ℕ) 0 A
    haveI := hA q
    refine Function.Injective.subsingleton
      (f := fun x => x.comp (Abelian.Ext.mk₀ (L.map e₀.hom)) (add_zero q)) ?_
    intro x y hxy
    have key : ∀ z : Abelian.Ext P (L.obj (((CochainComplex.single₀ C).obj A).X 0)) q,
        (z.comp (Abelian.Ext.mk₀ (L.map e₀.hom)) (add_zero q)).comp
          (Abelian.Ext.mk₀ (L.map e₀.inv)) (add_zero q) = z := by
      intro z
      rw [Abelian.Ext.comp_assoc _ _ _ (add_zero q) (add_zero 0) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, ← L.map_comp, Iso.hom_inv_id, L.map_id,
        Abelian.Ext.comp_mk₀_id]
    rw [← key x, ← key y]
    exact congrArg (fun z => z.comp (Abelian.Ext.mk₀ (L.map e₀.inv)) (add_zero q)) hxy

  have E : ∀ m q : ℕ, Subsingleton (Abelian.Ext P
      (Limits.kernel (L.map (I.cocomplex.d (m + 1) (m + 1 + 1)))) (q + 1)) := by
    intro m
    induction m with
    | zero =>
      obtain ⟨w, hS⟩ := s3 _ _ (hw 0) (hex 0) _ _ hι0 h₀
      exact s1 _ hS (fun q => hA' (q + 1)) (hK 0)
    | succ m ih =>
      obtain ⟨w, hS⟩ := s3 _ _ (hw (m + 1)) (hex (m + 1)) _ _ (Limits.kernel.condition _)
        (Limits.kernelIsKernel _)
      exact s1 _ hS ih (hK (m + 1))
  rcases n with _ | _ | m
  · obtain ⟨l, hl⟩ : ∃ l : P ⟶ L.obj (((CochainComplex.single₀ C).obj A).X 0),
        l ≫ L.map (I.ι.f 0) = c := ⟨_, (Limits.KernelFork.IsLimit.lift' h₀ c hc).2⟩
    haveI := hA' 0
    haveI : Subsingleton (P ⟶ L.obj (((CochainComplex.single₀ C).obj A).X 0)) :=
      Abelian.Ext.homEquiv₀.symm.subsingleton
    have hc0 : c = 0 := by rw [← hl, Subsingleton.elim l 0, Limits.zero_comp]
    exact ⟨0, by rw [Limits.zero_comp, hc0]⟩
  · obtain ⟨w, hS⟩ := s3 _ _ (hw 0) (hex 0) _ _ hι0 h₀
    obtain ⟨g, hg⟩ := s2 _ hS (hA' 1) (Limits.kernel.lift _ c hc)
    refine ⟨g, ?_⟩
    have := congrArg (· ≫ Limits.kernel.ι _) hg
    simp only [Category.assoc, Limits.kernel.lift_ι] at this
    exact this
  · obtain ⟨w, hS⟩ := s3 _ _ (hw (m + 1)) (hex (m + 1)) _ _ (Limits.kernel.condition _)
      (Limits.kernelIsKernel _)
    obtain ⟨g, hg⟩ := s2 _ hS (E m 0) (Limits.kernel.lift _ c hc)
    refine ⟨g, ?_⟩
    have := congrArg (· ≫ Limits.kernel.ι _) hg
    simp only [Category.assoc, Limits.kernel.lift_ι] at this
    exact this

theorem wc_et_adjoint_univ_transport : ∀ {S Z : Scheme.{u}} (g : Z ⟶ S) [(wcEtBaseChange g).IsContinuous (Scheme.smallEtaleTopology S) (Scheme.smallEtaleTopology Z)] (L : Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1} ⥤ Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}), Nonempty (L ⊣ wcEtPush g) → ∃ ρ : ∀ G : Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}, wcEtTransport g G (L.obj G), (∀ G, wcEtTransportUniv (ρ G)) ∧ ∀ (G G' : Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}) (ψ : G ⟶ G') (V : S.Etale) (O : Z.Etale) (h : O.left ⟶ V.left) (hh : h ≫ V.hom = O.hom ≫ g) (x : G.obj.obj (Opposite.op V)), (ρ G').ρ V O h hh ((ψ.hom.app (Opposite.op V)).hom x) = ((L.map ψ).hom.app (Opposite.op O)).hom ((ρ G).ρ V O h hh x) :=
by
  intro S Z g _ L hadj
  obtain ⟨adj⟩ := hadj
  classical
  let B := wcEtBaseChange g
  let τ := Scheme.smallEtaleTopology S
  let θ : ∀ H : Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1},
      B.op ⋙ H.obj ⟶ ((wcEtPush g).obj H).obj := fun H => toSheafify τ (B.op ⋙ H.obj)
  have hθ : ∀ H : Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}, IsIso (θ H) :=
    fun H => isIso_toSheafify τ (Functor.op_comp_isSheaf B τ (Scheme.smallEtaleTopology Z) H)
  let e : ∀ H : Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1},
      (B.op ⋙ H.obj) ≅ ((wcEtPush g).obj H).obj := fun H => @asIso _ _ _ _ (θ H) (hθ H)
  let u : ∀ (V : S.Etale) (O : Z.Etale) (h : O.left ⟶ V.left), h ≫ V.hom = O.hom ≫ g →
      (O ⟶ B.obj V) := fun V O h hh =>
    MorphismProperty.Over.homMk (Limits.pullback.lift h O.hom hh)
      (Limits.pullback.lift_snd _ _ _) trivial
  have hu_fst : ∀ (V : S.Etale) (O : Z.Etale) (h : O.left ⟶ V.left)
      (hh : h ≫ V.hom = O.hom ≫ g),
      (u V O h hh).left ≫ Limits.pullback.fst V.hom g = h :=
    fun V O h hh => Limits.pullback.lift_fst _ _ _
  have hu_snd : ∀ (V : S.Etale) (O : Z.Etale) (h : O.left ⟶ V.left)
      (hh : h ≫ V.hom = O.hom ≫ g),
      (u V O h hh).left ≫ Limits.pullback.snd V.hom g = O.hom :=
    fun V O h hh => Limits.pullback.lift_snd _ _ _
  have hB_fst : ∀ (V V' : S.Etale) (c : V' ⟶ V),
      (B.map c).left ≫ Limits.pullback.fst V.hom g = Limits.pullback.fst V'.hom g ≫ c.left :=
    fun V V' c => Limits.pullback.lift_fst _ _ _
  have hB_snd : ∀ (V V' : S.Etale) (c : V' ⟶ V),
      (B.map c).left ≫ Limits.pullback.snd V.hom g = Limits.pullback.snd V'.hom g :=
    fun V V' c => Limits.pullback.lift_snd _ _ _
  have K1 : ∀ (V V' : S.Etale) (c : V' ⟶ V) (O O' : Z.Etale) (d : O' ⟶ O)
      (h : O.left ⟶ V.left) (hh : h ≫ V.hom = O.hom ≫ g)
      (h' : O'.left ⟶ V'.left) (hh' : h' ≫ V'.hom = O'.hom ≫ g),
      h' ≫ c.left = d.left ≫ h → u V' O' h' hh' ≫ B.map c = d ≫ u V O h hh := by
    intro V V' c O O' d h hh h' hh' hc
    apply MorphismProperty.Over.Hom.ext
    show (u V' O' h' hh').left ≫ (B.map c).left = d.left ≫ (u V O h hh).left
    apply Limits.pullback.hom_ext
    · exact (Category.assoc _ _ _).trans
        ((congrArg (fun t => (u V' O' h' hh').left ≫ t) (hB_fst V V' c)).trans
        ((Category.assoc _ _ _).symm.trans
        ((congrArg (fun t => t ≫ c.left) (hu_fst V' O' h' hh')).trans
        (hc.trans ((congrArg (fun t => d.left ≫ t) (hu_fst V O h hh)).symm.trans
        (Category.assoc _ _ _).symm)))))
    · exact (Category.assoc _ _ _).trans
        ((congrArg (fun t => (u V' O' h' hh').left ≫ t) (hB_snd V V' c)).trans
        ((hu_snd V' O' h' hh').trans ((MorphismProperty.Over.w d).symm.trans
        ((congrArg (fun t => d.left ≫ t) (hu_snd V O h hh)).symm.trans
        (Category.assoc _ _ _).symm))))
  have K2 : ∀ V : S.Etale,
      u V (B.obj V) (Limits.pullback.fst V.hom g) Limits.pullback.condition = 𝟙 _ := by
    intro V
    apply MorphismProperty.Over.Hom.ext
    show (u V (B.obj V) (Limits.pullback.fst V.hom g) Limits.pullback.condition).left = 𝟙 _
    apply Limits.pullback.hom_ext
    · exact (hu_fst _ _ _ _).trans (Category.id_comp _).symm
    · exact (hu_snd _ _ _ _).trans (Category.id_comp _).symm
  have star : ∀ (G : Sheaf τ AddCommGrpCat.{u+1})
      (H : Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) (T : wcEtTransport g G H)
      (V : S.Etale) (O : Z.Etale) (h : O.left ⟶ V.left) (hh : h ≫ V.hom = O.hom ≫ g)
      (x : G.obj.obj (Opposite.op V)),
      T.ρ V O h hh x = (H.obj.map (u V O h hh).op).hom
        (T.ρ V (B.obj V) (Limits.pullback.fst V.hom g) Limits.pullback.condition x) := by
    intro G H T V O h hh x
    have hn := T.nat V V (𝟙 V) (B.obj V) O (u V O h hh) (Limits.pullback.fst V.hom g)
      Limits.pullback.condition h hh
      ((Category.comp_id h).trans (hu_fst V O h hh).symm) x
    rw [op_id, CategoryTheory.Functor.map_id] at hn
    exact hn
  let α : ∀ G : Sheaf τ AddCommGrpCat.{u+1}, G.obj ⟶ B.op ⋙ (L.obj G).obj :=
    fun G => (adj.unit.app G).hom ≫ (e (L.obj G)).inv
  let ρ : ∀ G : Sheaf τ AddCommGrpCat.{u+1}, wcEtTransport g G (L.obj G) := fun G =>
    { ρ := fun V O h hh =>
        ((L.obj G).obj.map (u V O h hh).op).hom.comp ((α G).app (Opposite.op V)).hom
      nat := by
        intro V V' c O O' d h hh h' hh' hc x
        have key : G.obj.map c.op ≫ (α G).app (Opposite.op V') ≫
              (L.obj G).obj.map (u V' O' h' hh').op =
            (α G).app (Opposite.op V) ≫ (L.obj G).obj.map (u V O h hh).op ≫
              (L.obj G).obj.map d.op := by
          rw [← Category.assoc, (α G).naturality, Category.assoc, Functor.comp_map, Functor.op_map,
            ← (L.obj G).obj.map_comp, ← (L.obj G).obj.map_comp, ← op_comp, ← op_comp,
            Quiver.Hom.unop_op, K1 V V' c O O' d h hh h' hh' hc]
        exact congrArg (fun f => f.hom x) key }
  have hT : ∀ (G : Sheaf τ AddCommGrpCat.{u+1}) (V : S.Etale) (x : G.obj.obj (Opposite.op V)),
      (ρ G).ρ V (B.obj V) (Limits.pullback.fst V.hom g) Limits.pullback.condition x =
        ((α G).app (Opposite.op V)).hom x := by
    intro G V x
    change ((L.obj G).obj.map (u V (B.obj V) _ _).op).hom (((α G).app (Opposite.op V)).hom x) = _
    rw [K2, op_id, CategoryTheory.Functor.map_id]
    rfl
  have hstar : ∀ {H H' : Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}} (φ : H ⟶ H'),
      ((wcEtPush g).map φ).hom = (e H).inv ≫ Functor.whiskerLeft B.op φ.hom ≫ (e H').hom := by
    intro H H' φ
    have h1 : Functor.whiskerLeft B.op φ.hom ≫ θ H' =
        θ H ≫ sheafifyMap τ (Functor.whiskerLeft B.op φ.hom) :=
      toSheafify_naturality τ (Functor.whiskerLeft B.op φ.hom)
    change sheafifyMap τ (Functor.whiskerLeft B.op φ.hom) =
      (e H).inv ≫ Functor.whiskerLeft B.op φ.hom ≫ θ H'
    rw [h1, ← Category.assoc]
    change _ = ((e H).inv ≫ (e H).hom) ≫ _
    rw [Iso.inv_hom_id, Category.id_comp]
  have hhom : ∀ (G : Sheaf τ AddCommGrpCat.{u+1})
      (H : Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) (φ : L.obj G ⟶ H),
      ((adj.homEquiv G H) φ).hom = α G ≫ Functor.whiskerLeft B.op φ.hom ≫ (e H).hom := by
    intro G H φ
    rw [Adjunction.homEquiv_unit]
    change (adj.unit.app G).hom ≫ ((wcEtPush g).map φ).hom = _
    rw [hstar φ]
    show _ = ((adj.unit.app G).hom ≫ (e (L.obj G)).inv) ≫ _
    rw [Category.assoc]
  refine ⟨ρ, ?_, ?_⟩
  · intro G G' T'
    let α' : G.obj ⟶ B.op ⋙ G'.obj :=
      { app := fun V => AddCommGrpCat.ofHom (T'.ρ V.unop (B.obj V.unop)
          (Limits.pullback.fst V.unop.hom g) Limits.pullback.condition)
        naturality := by
          intro V₁ V₂ f
          ext x
          exact T'.nat V₁.unop V₂.unop f.unop (B.obj V₁.unop) (B.obj V₂.unop) (B.map f.unop) _
            Limits.pullback.condition _ Limits.pullback.condition (hB_fst _ _ _).symm x }
    let β : G ⟶ (wcEtPush g).obj G' := ObjectProperty.homMk (α' ≫ (e G').hom)
    let φ : L.obj G ⟶ G' := (adj.homEquiv G G').symm β
    have hβφ : (adj.homEquiv G G') φ = β := Equiv.apply_symm_apply _ _
    have hK : α G ≫ Functor.whiskerLeft B.op φ.hom = α' := by
      have h1 : (α G ≫ Functor.whiskerLeft B.op φ.hom) ≫ (e G').hom = α' ≫ (e G').hom := by
        rw [Category.assoc, ← hhom G G' φ, hβφ]
        rfl
      exact (cancel_mono (e G').hom).mp h1
    refine ⟨φ, ?_, ?_⟩
    · intro V O h hh x
      have hm : (α G).app (Opposite.op V) ≫ (L.obj G).obj.map (u V O h hh).op ≫
            φ.hom.app (Opposite.op O) =
          α'.app (Opposite.op V) ≫ G'.obj.map (u V O h hh).op := by
        rw [φ.hom.naturality, ← Category.assoc, ← NatTrans.congr_app hK (Opposite.op V)]
        rfl
      rw [star G G' T' V O h hh x]
      exact congrArg (fun f => f.hom x) hm
    · intro ψ hψ
      have hK' : α G ≫ Functor.whiskerLeft B.op ψ.hom = α' := by
        ext V x
        have := hψ V.unop (B.obj V.unop) (Limits.pullback.fst V.unop.hom g)
          Limits.pullback.condition x
        rw [hT] at this
        exact this
      apply (adj.homEquiv G G').injective
      apply ObjectProperty.hom_ext
      rw [hhom, hhom, reassoc_of% hK', reassoc_of% hK]
  · intro G G' ψ V O h hh x
    have N1 : α G ≫ Functor.whiskerLeft B.op (L.map ψ).hom = ψ.hom ≫ α G' := by
      have hu := adj.unit.naturality ψ
      have hu' : ψ.hom ≫ (adj.unit.app G').hom =
          (adj.unit.app G).hom ≫ ((wcEtPush g).map (L.map ψ)).hom :=
        congrArg (fun k => k.hom) hu
      show ((adj.unit.app G).hom ≫ (e (L.obj G)).inv) ≫ _ =
        ψ.hom ≫ ((adj.unit.app G').hom ≫ (e (L.obj G')).inv)
      rw [← Category.assoc ψ.hom, hu', hstar (L.map ψ)]
      simp only [Category.assoc, Iso.hom_inv_id, Category.comp_id]
    have h2 : (α G).app (Opposite.op V) ≫ (L.map ψ).hom.app (Opposite.op (B.obj V)) =
        ψ.hom.app (Opposite.op V) ≫ (α G').app (Opposite.op V) :=
      NatTrans.congr_app N1 (Opposite.op V)
    have key : ψ.hom.app (Opposite.op V) ≫ (α G').app (Opposite.op V) ≫
          (L.obj G').obj.map (u V O h hh).op =
        (α G).app (Opposite.op V) ≫ (L.obj G).obj.map (u V O h hh).op ≫
          (L.map ψ).hom.app (Opposite.op O) := by
      rw [(L.map ψ).hom.naturality, ← Category.assoc, ← Category.assoc]
      exact congrArg (fun k => k ≫ (L.obj G').obj.map (u V O h hh).op) h2.symm
    exact congrArg (fun f => f.hom x) key

theorem wc_et_limit_eventually_in_open : ∀ (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (D : Λ ⥤ Scheme.{u}) (P : Scheme.{u}) (π : ∀ l, P ⟶ D.obj l), (∀ {l l' : Λ} (t : l ⟶ l'), π l ≫ D.map t = π l') → (∀ (T : Scheme.{u}) (z : ∀ l, T ⟶ D.obj l), (∀ {l l' : Λ} (t : l ⟶ l'), z l ≫ D.map t = z l') → ∃! z₀ : T ⟶ P, ∀ l, z₀ ≫ π l = z l) → (∀ {l l' : Λ} (t : l ⟶ l'), IsAffineHom (D.map t)) → ∀ (l : Λ) (T : Scheme.{u}) (τ : T ⟶ D.obj l), CompactSpace T → ∀ (O : Set T), IsOpen O → (∀ (y : T) (p : P), τ y = π l p → y ∈ O) → ∃ (l' : Λ) (t : l' ⟶ l), ∀ (y : T) (q : D.obj l'), τ y = D.map t q → y ∈ O :=
by
  intro Λ _ _ D P π hπ hlim haff l T τ hT O hO hOP

  let cP : Limits.Cone D := ⟨P, { app := π, naturality := fun k k' t => by simp [hπ t] }⟩
  have hL : Limits.IsLimit cP :=
    Limits.IsLimit.ofExistsUnique (fun s => hlim s.pt s.π.app (fun t => s.w t))
  have hW : Limits.IsLimit (cP.whisker (Over.forget l)) :=
    (Functor.Initial.isLimitWhiskerEquiv (Over.forget l) cP).symm hL
  have hres : ∀ (W : Scheme.{u}) (a : ∀ j : Over l, W ⟶ D.obj j.left),
      (∀ {j j' : Over l} (g : j ⟶ j'), a j ≫ D.map g.left = a j') →
      ∃! z₀ : W ⟶ P, ∀ j : Over l, z₀ ≫ π j.left = a j := by
    intro W a ha
    let sa : Limits.Cone (Over.forget l ⋙ D) :=
      ⟨W, { app := a, naturality := fun j j' g => by simp [ha g] }⟩
    exact hW.existsUnique sa

  let E : Over l ⥤ Scheme.{u} := Over.post D ⋙ Over.pullback τ ⋙ Over.forget T
  let i₀ : Over l := Over.mk (𝟙 l)
  let fst : ∀ j : Over l, E.obj j ⟶ D.obj j.left := fun j => Limits.pullback.fst (D.map j.hom) τ
  let snd : ∀ j : Over l, E.obj j ⟶ T := fun j => Limits.pullback.snd (D.map j.hom) τ
  have hcondE : ∀ j : Over l, fst j ≫ D.map j.hom = snd j ≫ τ := fun j =>
    Limits.pullback.condition
  have ext : ∀ (j : Over l) {W : Scheme.{u}} (u v : W ⟶ E.obj j), u ≫ fst j = v ≫ fst j →
      u ≫ snd j = v ≫ snd j → u = v := fun j W u v h1 h2 => Limits.pullback.hom_ext h1 h2
  have F1 : ∀ {j j' : Over l} (g : j ⟶ j'), E.map g ≫ fst j' = fst j ≫ D.map g.left := by
    intro j j' g
    have h := Over.pullback_map_left τ ((Over.post D).obj j) (k := (Over.post D).map g)
    refine (congrArg (· ≫ fst j') h).trans ?_
    exact Limits.pullback.lift_fst _ _ _
  have F2 : ∀ {j j' : Over l} (g : j ⟶ j'), E.map g ≫ snd j' = snd j := by
    intro j j' g
    exact Over.w ((Over.pullback τ).map ((Over.post D).map g))

  have hleg : ∀ j : Over l, (Limits.pullback.fst (π l) τ ≫ π j.left) ≫ D.map j.hom =
      Limits.pullback.snd (π l) τ ≫ τ := by
    intro j
    rw [Category.assoc, hπ j.hom]
    exact Limits.pullback.condition
  let leg : ∀ j : Over l, Limits.pullback (π l) τ ⟶ E.obj j := fun j =>
    Limits.pullback.lift (Limits.pullback.fst (π l) τ ≫ π j.left) (Limits.pullback.snd (π l) τ)
      (hleg j)
  have leg_fst : ∀ j : Over l, leg j ≫ fst j = Limits.pullback.fst (π l) τ ≫ π j.left :=
    fun j => Limits.pullback.lift_fst _ _ _
  have leg_snd : ∀ j : Over l, leg j ≫ snd j = Limits.pullback.snd (π l) τ :=
    fun j => Limits.pullback.lift_snd _ _ _
  have hnat : ∀ {j j' : Over l} (g : j ⟶ j'), leg j ≫ E.map g = leg j' := by
    intro j j' g
    apply ext j'
    · rw [Category.assoc, F1 g, ← Category.assoc, leg_fst, leg_fst, Category.assoc, hπ g.left]
    · rw [Category.assoc, F2 g, leg_snd, leg_snd]
  let c : Limits.Cone E := ⟨Limits.pullback (π l) τ,
    { app := leg, naturality := fun j j' g => by
        simp only [Functor.const_obj_map]
        exact ((Category.id_comp _).trans (hnat g).symm) }⟩
  have hc : Limits.IsLimit c := by
    refine Limits.IsLimit.ofExistsUnique (fun s => ?_)
    let a : ∀ j : Over l, s.pt ⟶ D.obj j.left := fun j => s.π.app j ≫ fst j
    have ha : ∀ {j j' : Over l} (g : j ⟶ j'), a j ≫ D.map g.left = a j' := by
      intro j j' g
      show (s.π.app j ≫ fst j) ≫ D.map g.left = s.π.app j' ≫ fst j'
      rw [Category.assoc, ← F1 g, ← Category.assoc, s.w g]
    obtain ⟨z₀, hz₀, hz₀u⟩ := hres s.pt a ha
    let b : s.pt ⟶ T := s.π.app i₀ ≫ snd i₀
    have hb : ∀ j : Over l, s.π.app j ≫ snd j = b := by
      intro j
      have g : j ⟶ i₀ := Over.homMk j.hom (by simp [i₀])
      show s.π.app j ≫ snd j = s.π.app i₀ ≫ snd i₀
      rw [← s.w g, Category.assoc, F2 g]
    have hcond : z₀ ≫ π l = b ≫ τ := by
      have h1 : z₀ ≫ π l = s.π.app i₀ ≫ fst i₀ := hz₀ i₀
      have h2 : fst i₀ ≫ D.map i₀.hom = snd i₀ ≫ τ := hcondE i₀
      have h3 : D.map i₀.hom = 𝟙 (D.obj l) := D.map_id l
      rw [h3] at h2
      have h4 : fst i₀ = snd i₀ ≫ τ := (Category.comp_id (fst i₀)).symm.trans h2
      show z₀ ≫ π l = (s.π.app i₀ ≫ snd i₀) ≫ τ
      rw [h1, Category.assoc, ← h4]
    refine ⟨Limits.pullback.lift z₀ b hcond, fun j => ?_, fun m hm => ?_⟩
    · change Limits.pullback.lift z₀ b hcond ≫ leg j = s.π.app j
      apply ext j
      · rw [Category.assoc, leg_fst, ← Category.assoc, Limits.pullback.lift_fst]
        exact hz₀ j
      · rw [Category.assoc, leg_snd, Limits.pullback.lift_snd, hb j]
    · have hm' : ∀ j, m ≫ leg j = s.π.app j := hm
      have e1 : m ≫ Limits.pullback.fst (π l) τ = z₀ := by
        apply hz₀u
        intro j
        rw [Category.assoc, ← leg_fst j, ← Category.assoc, hm' j]
      have e2 : m ≫ Limits.pullback.snd (π l) τ = b := by
        rw [← leg_snd i₀, ← Category.assoc, hm' i₀]
      refine Limits.pullback.hom_ext (f := π l) (g := τ) ?_ ?_
      · rw [e1, Limits.pullback.lift_fst]
      · rw [e2, Limits.pullback.lift_snd]

  have hsndAff : ∀ i : Over l, IsAffineHom (snd i) := fun i =>
    MorphismProperty.of_isPullback (P := @IsAffineHom)
      (IsPullback.of_hasPullback (D.map i.hom) τ) (haff i.hom)
  have hEaff : ∀ {i j : Over l} (f : i ⟶ j), IsAffineHom (E.map f) := by
    intro i j f
    have big : IsPullback (E.map f ≫ snd j) (fst i) τ (D.map f.left ≫ D.map j.hom) := by
      rw [F2 f, ← D.map_comp, Over.w f]
      exact (IsPullback.of_hasPullback (D.map i.hom) τ).flip
    have right : IsPullback (snd j) (fst j) τ (D.map j.hom) :=
      (IsPullback.of_hasPullback (D.map j.hom) τ).flip
    have sq := IsPullback.of_right big (F1 f) right
    exact MorphismProperty.of_isPullback (P := @IsAffineHom) sq.flip (haff f.left)
  have hEcpt : ∀ i : Over l, CompactSpace (E.obj i) := fun i => by
    have := hsndAff i
    have hqc : QuasiCompact (snd i) := inferInstance
    exact @QuasiCompact.compactSpace_of_compactSpace _ _ (snd i) hqc hT

  let U : (E.obj i₀).Opens := ⟨(snd i₀) ⁻¹' O, hO.preimage (snd i₀).continuous⟩
  have htop : c.π.app i₀ ⁻¹ᵁ U = ⊤ := by
    rw [eq_top_iff]
    intro x _
    change snd i₀ (leg i₀ x) ∈ O
    have e : snd i₀ (leg i₀ x) = Limits.pullback.snd (π l) τ x := by
      rw [← Scheme.Hom.comp_apply, leg_snd i₀]
    have e2 : τ (Limits.pullback.snd (π l) τ x) = π l (Limits.pullback.fst (π l) τ x) := by
      rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, Limits.pullback.condition]
    apply hOP _ (Limits.pullback.fst (π l) τ x)
    rw [e, e2]
  obtain ⟨j, fji, hj⟩ := @exists_map_eq_top (Over l) _ E c hc _ (fun f => hEaff f) hEcpt i₀ U htop
  refine ⟨j.left, j.hom, fun y q hyq => ?_⟩
  obtain ⟨z, hz1, hz2⟩ :=
    Scheme.Pullback.exists_preimage_pullback (f := D.map j.hom) (g := τ) q y hyq.symm
  have hzU : ∀ w : E.obj j, w ∈ E.map fji ⁻¹ᵁ U := by
    rw [hj]; intro w; trivial
  have hw : snd i₀ (E.map fji z) ∈ O := hzU z
  have e : snd i₀ (E.map fji z) = y :=
    (Scheme.Hom.comp_apply (E.map fji) (snd i₀) z).symm.trans
      ((congrArg (fun k : E.obj j ⟶ T => k z) (F2 fji)).trans hz2)
  rw [← e]
  exact hw

theorem wc_et_univ_transport_limit_vanish : ∀ {S Z : Scheme.{u}} (g : Z ⟶ S) (G : Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}) (H : Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) (ρ : wcEtTransport g G H), wcEtTransportUniv ρ → ∀ (U : Z.Etale) (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (D : Λ ⥤ S.Etale) (π : ∀ l, U.left ⟶ (D.obj l).left), (∀ l, π l ≫ (D.obj l).hom = U.hom ≫ g) → (∀ {l l' : Λ} (t : l ⟶ l'), π l ≫ (D.map t).left = π l') → (∀ (T : Scheme.{u}) (z : ∀ l, T ⟶ (D.obj l).left), (∀ {l l' : Λ} (t : l ⟶ l'), z l ≫ (D.map t).left = z l') → ∃! z₀ : T ⟶ U.left, ∀ l, z₀ ≫ π l = z l) → (∀ {l l' : Λ} (t : l ⟶ l'), IsAffineHom (D.map t).left) → ∀ (l : Λ) (W : S.Etale) (c : W ⟶ D.obj l), CompactSpace W.left → ∀ z : G.obj.obj (Opposite.op W), (∀ (O : Z.Etale) (d : O ⟶ U) (k : O.left ⟶ W.left) (hk : k ≫ W.hom = O.hom ≫ g), k ≫ c.left = d.left ≫ π l → ρ.ρ W O k hk z = 0) → ∃ (l' : Λ) (t : l' ⟶ l), ∀ (W' : S.Etale) (a : W' ⟶ W) (b : W' ⟶ D.obj l'), a ≫ c = b ≫ D.map t → (G.obj.map a.op).hom z = 0 :=
by
  intro S Z g G H ρ hρ U Λ _ _ D π hπ hc hlim haff l W c hW z hZ
  obtain ⟨hopen, hkill⟩ := wc_etale_section_vanishing_open S G W z

  have hpt : ∀ (y : W.left) (p : U.left), c.left y = π l p →
      y ∈ {v : W.left | ∃ (V₁ : S.Etale) (c₁ : V₁ ⟶ W), v ∈ Set.range c₁.left ∧
        G.obj.map c₁.op z = 0} := by
    intro y p hyp
    have hcw : c.left ≫ (D.obj l).hom = W.hom := MorphismProperty.Over.w c
    haveI : Etale (D.obj l).hom := (D.obj l).prop
    haveI : Etale (c.left ≫ (D.obj l).hom) := by rw [hcw]; exact W.prop
    haveI : Etale c.left := Etale.of_comp c.left (D.obj l).hom
    haveI : Etale U.hom := U.prop
    let O : Z.Etale := MorphismProperty.Over.mk ⊤
      (Limits.pullback.fst (π l) c.left ≫ U.hom) inferInstance
    let d : O ⟶ U := MorphismProperty.Over.homMk (Limits.pullback.fst (π l) c.left) rfl trivial
    have hk : Limits.pullback.snd (π l) c.left ≫ W.hom = O.hom ≫ g := by
      show Limits.pullback.snd (π l) c.left ≫ W.hom =
        (Limits.pullback.fst (π l) c.left ≫ U.hom) ≫ g
      calc Limits.pullback.snd (π l) c.left ≫ W.hom
          = Limits.pullback.snd (π l) c.left ≫ c.left ≫ (D.obj l).hom := by rw [hcw]
        _ = (Limits.pullback.fst (π l) c.left ≫ π l) ≫ (D.obj l).hom := by
          rw [← Category.assoc, ← Limits.pullback.condition]
        _ = (Limits.pullback.fst (π l) c.left ≫ U.hom) ≫ g := by
          rw [Category.assoc, hπ l, Category.assoc]
    have hside : Limits.pullback.snd (π l) c.left ≫ c.left = d.left ≫ π l :=
      Limits.pullback.condition.symm
    have h0 := hZ O d (Limits.pullback.snd (π l) c.left) hk hside
    obtain ⟨o, -, ho2⟩ := Scheme.Pullback.exists_preimage_pullback p y hyp.symm
    obtain ⟨V', c', v', hv', hz'⟩ := wc_et_univ_transport_locally_injective g G H ρ hρ W O
      (Limits.pullback.snd (π l) c.left) hk z o h0
    show ∃ (V₁ : S.Etale) (c₁ : V₁ ⟶ W), y ∈ Set.range c₁.left ∧ G.obj.map c₁.op z = 0
    exact ⟨V', c', ⟨v', hv'.trans ho2⟩, hz'⟩

  obtain ⟨l', t, ht⟩ := wc_et_limit_eventually_in_open Λ (D ⋙ Scheme.Etale.forget S ⋙ Over.forget S)
    U.left π (fun t => hc t) (fun T z hz => hlim T z (fun t => hz t)) (fun t => haff t)
    l W.left c.left hW _ hopen hpt

  refine ⟨l', t, fun W' a b hab => ?_⟩
  apply hkill W' a
  rintro _ ⟨w', rfl⟩
  apply ht (a.left w') (b.left w')
  have e : (a.left ≫ c.left) w' = (b.left ≫ (D.map t).left) w' :=
    congrArg (fun k : W' ⟶ D.obj l => k.left w') hab
  rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at e
  exact e

theorem wc_et_limit_affine_open_system : ∀ {S X : Scheme.{u}} (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (D : Λ ⥤ S.Etale) (π : ∀ l, X ⟶ (D.obj l).left), (∀ {l l' : Λ} (t : l ⟶ l'), π l ≫ (D.map t).left = π l') → (∀ (T : Scheme.{u}) (z : ∀ l, T ⟶ (D.obj l).left), (∀ {l l' : Λ} (t : l ⟶ l'), z l ≫ (D.map t).left = z l') → ∃! z₀ : T ⟶ X, ∀ l, z₀ ≫ π l = z l) → (∀ {l l' : Λ} (t : l ⟶ l'), IsAffineHom (D.map t).left) → ∀ (l₀ : Λ) (A₀ : (D.obj l₀).left.Opens), IsAffineOpen A₀ → ∃ (I : Type u) (_ : SmallCategory I) (_ : IsCofiltered I) (D' : I ⥤ Scheme.{u}) (c' : Limits.Cone D') (lev : I → Λ) (ιP : c'.pt ⟶ X) (κ : ∀ i, D'.obj i ⟶ (D.obj (lev i)).left), Nonempty (Limits.IsLimit c') ∧ (∀ {i i' : I} (f : i ⟶ i'), IsAffineHom (D'.map f)) ∧ (∀ i, IsAffine (D'.obj i)) ∧ (∀ i, IsOpenImmersion (κ i)) ∧ IsOpenImmersion ιP ∧ (∀ i, IsPullback (c'.π.app i) ιP (κ i) (π (lev i))) ∧ Set.range ιP = (π l₀) ⁻¹' (A₀ : Set (D.obj l₀).left) :=
by
  intro S X Λ _ _ D π hc hlim haff l₀ A₀ hA₀
  classical
  let G : Λ ⥤ Scheme.{u} := D ⋙ Scheme.Etale.forget S ⋙ Over.forget S

  let cn : Limits.Cone G :=
    { pt := X
      π := { app := fun l => π l
             naturality := fun l l' t => (Category.id_comp _).trans (hc t).symm } }
  have hcn : Limits.IsLimit cn := Limits.IsLimit.ofExistsUnique (fun s =>
    hlim s.pt (fun l => s.π.app l) (fun t => s.w t))
  have hcn' : Limits.IsLimit (cn.whisker (Over.forget l₀)) :=
    (Functor.Initial.isLimitWhiskerEquiv (Over.forget l₀) cn).symm hcn
  have hres : ∀ (T : Scheme.{u}) (z : ∀ n : Over l₀, T ⟶ (D.obj n.left).left),
      (∀ {n n' : Over l₀} (t : n ⟶ n'), z n ≫ (D.map t.left).left = z n') →
      ∃ z₀ : T ⟶ X, (∀ n, z₀ ≫ π n.left = z n) ∧
        ∀ w : T ⟶ X, (∀ n, w ≫ π n.left = z n) → w = z₀ := by
    intro T z hz
    let s' : Limits.Cone (Over.forget l₀ ⋙ G) :=
      { pt := T
        π := { app := fun n => z n
               naturality := fun n n' t => (Category.id_comp _).trans (hz t).symm } }
    exact ⟨hcn'.lift s', fun n => hcn'.fac s' n, fun w hw => hcn'.uniq s' w hw⟩
  have hmapcomp : ∀ {a b c : Λ} (f : a ⟶ b) (g : b ⟶ c),
      (D.map (f ≫ g)).left = (D.map f).left ≫ (D.map g).left := by
    intro a b c f g
    rw [Functor.map_comp]
    rfl

  let V : ∀ n : Over l₀, (D.obj n.left).left.Opens := fun n => (D.map n.hom).left ⁻¹ᵁ A₀
  have hDcomp : ∀ {n n' : Over l₀} (t : n ⟶ n'),
      (D.map n.hom).left = (D.map t.left).left ≫ (D.map n'.hom).left := by
    intro n n' t
    rw [← hmapcomp, Over.w t]
  have hVeq : ∀ {n n' : Over l₀} (t : n ⟶ n'), V n = (D.map t.left).left ⁻¹ᵁ V n' := by
    intro n n' t
    show (D.map n.hom).left ⁻¹ᵁ A₀ = (D.map t.left).left ⁻¹ᵁ ((D.map n'.hom).left ⁻¹ᵁ A₀)
    rw [hDcomp t, Scheme.Hom.comp_preimage]
  have hVaff : ∀ n, IsAffineOpen (V n) := fun n =>
    @IsAffineOpen.preimage _ _ _ hA₀ (D.map n.hom).left (haff n.hom)

  obtain ⟨D', κ, hκ, hrange, hD'aff, hnat⟩ : ∃ (D' : Over l₀ ⥤ Scheme.{u})
      (κ : ∀ n, D'.obj n ⟶ (D.obj n.left).left), (∀ n, IsOpenImmersion (κ n)) ∧
      (∀ n, Set.range (κ n) = (V n : Set (D.obj n.left).left)) ∧ (∀ n, IsAffine (D'.obj n)) ∧
      (∀ {n n' : Over l₀} (t : n ⟶ n'), D'.map t ≫ κ n' = κ n ≫ (D.map t.left).left) := by
    let D'' : Over l₀ ⥤ Scheme.{u} :=
      { obj := fun n => (V n : Scheme.{u})
        map := fun {n n'} t => ((D.map t.left).left).resLE (V n') (V n) (hVeq t).le
        map_id := fun n => by
          rw [← cancel_mono (V n).ι, Scheme.Hom.resLE_comp_ι]
          have : (D.map (𝟙 n : n ⟶ n).left).left = 𝟙 _ := by
            rw [Over.id_left, D.map_id]; rfl
          rw [this, Category.comp_id, Category.id_comp]
        map_comp := fun {a b c} f g => by
          rw [← cancel_mono (V c).ι, Scheme.Hom.resLE_comp_ι, Category.assoc,
            Scheme.Hom.resLE_comp_ι, ← Category.assoc, Scheme.Hom.resLE_comp_ι,
            Category.assoc, Over.comp_left, hmapcomp] }
    exact ⟨D'', fun n => (V n).ι, fun n => inferInstance, fun n => Scheme.Opens.range_ι _,
      fun n => hVaff n, fun t => Scheme.Hom.resLE_comp_ι _ _⟩

  let P : X.Opens := (π l₀) ⁻¹ᵁ A₀
  have hR : ∀ n : Over l₀, (π n.left) ⁻¹' Set.range (κ n) = Set.range P.ι := by
    intro n
    ext x
    rw [Set.mem_preimage, hrange n, Scheme.Opens.range_ι]
    show (D.map n.hom).left (π n.left x) ∈ A₀ ↔ π l₀ x ∈ A₀
    rw [← Scheme.Hom.comp_apply, hc n.hom]
  have hleg_range : ∀ n : Over l₀, Set.range (P.ι ≫ π n.left) ⊆ Set.range (κ n) := by
    rintro n _ ⟨w, rfl⟩
    have h1 : P.ι w ∈ (π n.left) ⁻¹' Set.range (κ n) := by
      rw [hR n]; exact ⟨w, rfl⟩
    rw [Scheme.Hom.comp_apply]
    exact h1
  have hlegex : ∀ n : Over l₀, ∃ g : (P : Scheme.{u}) ⟶ D'.obj n, g ≫ κ n = P.ι ≫ π n.left := by
    intro n
    haveI := hκ n
    exact ⟨_, IsOpenImmersion.lift_fac _ _ (hleg_range n)⟩
  choose leg hleg using hlegex
  let c' : Limits.Cone D' :=
    { pt := (P : Scheme.{u})
      π := { app := leg
             naturality := fun n n' t => by
               haveI := hκ n'
               simp only [Functor.const_obj_obj, Functor.const_obj_map, Category.id_comp]
               rw [← cancel_mono (κ n'), Category.assoc, hnat t, ← Category.assoc, hleg n,
                 hleg n', Category.assoc, hc t.left] } }
  have hlimc' : Limits.IsLimit c' := by
    refine Limits.IsLimit.ofExistsUnique (fun s => ?_)
    obtain ⟨z₀, hz₀, hz₀u⟩ := hres s.pt (fun n => s.π.app n ≫ κ n) (fun {n n'} t => by
      rw [Category.assoc, ← hnat t, ← Category.assoc, s.w t])
    obtain ⟨n₀⟩ := IsCofiltered.nonempty (C := Over l₀)
    have hz₀r : Set.range z₀ ⊆ Set.range P.ι := by
      rintro _ ⟨x, rfl⟩
      have h1 : π n₀.left (z₀ x) = κ n₀ (s.π.app n₀ x) := by
        rw [← Scheme.Hom.comp_apply, hz₀ n₀, Scheme.Hom.comp_apply]
      have h2 : z₀ x ∈ (π n₀.left) ⁻¹' Set.range (κ n₀) := by
        rw [Set.mem_preimage, h1]; exact ⟨_, rfl⟩
      rw [hR n₀] at h2
      exact h2
    have hm : IsOpenImmersion.lift P.ι z₀ hz₀r ≫ P.ι = z₀ := IsOpenImmersion.lift_fac _ _ _
    refine ⟨IsOpenImmersion.lift P.ι z₀ hz₀r, fun n => ?_, fun m' hm' => ?_⟩
    · haveI := hκ n
      rw [← cancel_mono (κ n)]
      show (IsOpenImmersion.lift P.ι z₀ hz₀r ≫ leg n) ≫ κ n = s.π.app n ≫ κ n
      rw [Category.assoc, hleg n, ← Category.assoc, hm, hz₀ n]
    · rw [← cancel_mono P.ι, hm]
      apply hz₀u
      intro n
      have h2 : m' ≫ leg n = s.π.app n := hm' n
      rw [Category.assoc, ← hleg n, ← Category.assoc, h2]
  haveI : ∀ n, IsAffine (D'.obj n) := hD'aff
  refine ⟨Over l₀, inferInstance, inferInstance, D', c', fun n => n.left, P.ι, κ, ⟨hlimc'⟩,
    fun f => isAffineHom_of_isAffine _, hD'aff, hκ, inferInstance, fun n => ?_, ?_⟩
  · haveI := hκ n
    refine IsOpenImmersion.isPullback (c'.π.app n) P.ι (κ n) (π n.left) (hleg n).symm ?_
    apply SetLike.coe_injective
    rw [Scheme.Hom.coe_preimage, Scheme.Hom.coe_opensRange, Scheme.Hom.coe_opensRange]
    exact hR n
  · rw [Scheme.Opens.range_ι]
    rfl

theorem wc_colim_standard_etale_data_descend : ∀ (I : Type u) [SmallCategory I] [IsCofiltered I] (B : I → Type u) [∀ i, CommRing (B i)] (R : Type u) [CommRing R] (φ : ∀ i, B i →+* R) (β : ∀ {i j : I}, (j ⟶ i) → (B i →+* B j)), (∀ {i j k : I} (f : k ⟶ j) (g : j ⟶ i) (b : B i), β (f ≫ g) b = β f (β g b)) → (∀ {i j : I} (f : j ⟶ i) (b : B i), φ j (β f b) = φ i b) → (∀ r : R, ∃ (i : I) (b : B i), φ i b = r) → (∀ (i : I) (b : B i), φ i b = 0 → ∃ (j : I) (f : j ⟶ i), β f b = 0) → ∀ (n : ℕ) (f : Fin n → MvPolynomial (Fin n) R) (g : MvPolynomial (Fin n) R), g * (Matrix.of fun a b => MvPolynomial.pderiv a (f b)).det - 1 ∈ Ideal.span (Set.range f) → ∃ (i : I) (f₀ : Fin n → MvPolynomial (Fin n) (B i)) (g₀ : MvPolynomial (Fin n) (B i)), (∀ b, MvPolynomial.map (φ i) (f₀ b) = f b) ∧ g₀ * (Matrix.of fun a b => MvPolynomial.pderiv a (f₀ b)).det - 1 ∈ Ideal.span (Set.range f₀) :=
by
  intro I _ _ B _ R _ φ β hcomp hcompat hsurj hker n f g hg
  classical

  have hT : ∀ {i j : I} (h : j ⟶ i) (p : MvPolynomial (Fin n) (B i)),
      MvPolynomial.map (φ j) (MvPolynomial.map (β h) p) = MvPolynomial.map (φ i) p := by
    intro i j h p
    rw [MvPolynomial.map_map, show (φ j).comp (β h) = φ i from RingHom.ext (hcompat h)]

  have hlift1 : ∀ p : MvPolynomial (Fin n) R, ∃ (i : I) (q : MvPolynomial (Fin n) (B i)),
      MvPolynomial.map (φ i) q = p := by
    intro p
    refine MvPolynomial.induction_on (motive := fun p => ∃ (i : I) (q : MvPolynomial (Fin n) (B i)),
      MvPolynomial.map (φ i) q = p) p ?_ ?_ ?_
    · intro a
      obtain ⟨i, b, hb⟩ := hsurj a
      exact ⟨i, MvPolynomial.C b, by rw [MvPolynomial.map_C, hb]⟩
    · intro p q hp hq
      obtain ⟨i, p', hp'⟩ := hp
      obtain ⟨i', q', hq'⟩ := hq
      refine ⟨IsCofiltered.min i i', MvPolynomial.map (β (IsCofiltered.minToLeft i i')) p' +
        MvPolynomial.map (β (IsCofiltered.minToRight i i')) q', ?_⟩
      rw [map_add, hT, hT, hp', hq']
    · intro p m hp
      obtain ⟨i, p', hp'⟩ := hp
      exact ⟨i, p' * MvPolynomial.X m, by rw [map_mul, MvPolynomial.map_X, hp']⟩

  have hliftF : ∀ (ι : Type) [Fintype ι] (p : ι → MvPolynomial (Fin n) R), ∃ (i : I)
      (q : ι → MvPolynomial (Fin n) (B i)), ∀ k, MvPolynomial.map (φ i) (q k) = p k := by
    intro ι _ p
    choose st q hq using fun k => hlift1 (p k)
    obtain ⟨i, hi⟩ := IsCofiltered.inf_objs_exists (Finset.univ.image st)
    have t : ∀ k, i ⟶ st k := fun k => (hi (Finset.mem_image_of_mem st (Finset.mem_univ k))).some
    exact ⟨i, fun k => MvPolynomial.map (β (t k)) (q k), fun k => by rw [hT, hq]⟩

  have hkillS : ∀ (i : I) (T : Finset (B i)), (∀ t ∈ T, φ i t = 0) →
      ∃ (j : I) (F : j ⟶ i), ∀ t ∈ T, β F t = 0 := by
    intro i T
    refine Finset.induction_on T ?_ ?_
    · intro _
      exact ⟨i, 𝟙 i, fun t ht => by simp at ht⟩
    · intro t T _ ih hT0
      obtain ⟨j, F, hF⟩ := ih (fun s hs => hT0 s (Finset.mem_insert_of_mem hs))
      obtain ⟨j', F', hF'⟩ := hker i t (hT0 t (Finset.mem_insert_self t T))
      refine ⟨IsCofiltered.eq (IsCofiltered.minToLeft j j' ≫ F) (IsCofiltered.minToRight j j' ≫ F'),
        IsCofiltered.eqHom (IsCofiltered.minToLeft j j' ≫ F) (IsCofiltered.minToRight j j' ≫ F') ≫
          (IsCofiltered.minToLeft j j' ≫ F), ?_⟩
      intro s hs
      rcases Finset.mem_insert.mp hs with hst | hs
      · rw [hst, IsCofiltered.eq_condition, hcomp, hcomp, hF', map_zero, map_zero]
      · rw [hcomp, hcomp, hF s hs, map_zero, map_zero]

  have hkillP : ∀ (i : I) (q : MvPolynomial (Fin n) (B i)), MvPolynomial.map (φ i) q = 0 →
      ∃ (j : I) (F : j ⟶ i), MvPolynomial.map (β F) q = 0 := by
    intro i q hq
    obtain ⟨j, F, hF⟩ := hkillS i (q.support.image fun m => q.coeff m) (by
      intro t ht
      obtain ⟨m, -, rfl⟩ := Finset.mem_image.mp ht
      rw [← MvPolynomial.coeff_map, hq]
      simp)
    refine ⟨j, F, ?_⟩
    ext m
    rw [MvPolynomial.coeff_map]
    by_cases hm : m ∈ q.support
    · rw [hF _ (Finset.mem_image_of_mem _ hm)]
      simp
    · have h0 : q.coeff m = 0 := by simpa [MvPolynomial.mem_support_iff] using hm
      rw [h0, map_zero]
      simp

  have hdet : ∀ {A A' : Type u} [CommRing A] [CommRing A'] (ψ : A →+* A')
      (F : Fin n → MvPolynomial (Fin n) A),
      MvPolynomial.map ψ (Matrix.of fun a b => MvPolynomial.pderiv a (F b)).det =
      (Matrix.of fun a b => MvPolynomial.pderiv a (MvPolynomial.map ψ (F b))).det := by
    intro A A' _ _ ψ F
    rw [RingHom.map_det]
    congr 1
    ext a b
    simp [RingHom.mapMatrix_apply, MvPolynomial.pderiv_map]

  obtain ⟨c, hc⟩ := (Ideal.mem_span_range_iff_exists_fun).mp hg
  obtain ⟨i, q, hq⟩ := hliftF (Fin n ⊕ (Fin n ⊕ Unit)) (Sum.elim f (Sum.elim c fun _ => g))
  obtain ⟨f', hf'⟩ : ∃ f' : Fin n → MvPolynomial (Fin n) (B i),
      ∀ b, MvPolynomial.map (φ i) (f' b) = f b :=
    ⟨fun b => q (Sum.inl b), fun b => hq (Sum.inl b)⟩
  obtain ⟨c', hc'⟩ : ∃ c' : Fin n → MvPolynomial (Fin n) (B i),
      ∀ b, MvPolynomial.map (φ i) (c' b) = c b :=
    ⟨fun b => q (Sum.inr (Sum.inl b)), fun b => hq (Sum.inr (Sum.inl b))⟩
  obtain ⟨g', hg'⟩ : ∃ g' : MvPolynomial (Fin n) (B i), MvPolynomial.map (φ i) g' = g :=
    ⟨q (Sum.inr (Sum.inr ())), hq (Sum.inr (Sum.inr ()))⟩
  have hD : MvPolynomial.map (φ i) (g' * (Matrix.of fun a b => MvPolynomial.pderiv a (f' b)).det
      - 1 - ∑ b, c' b * f' b) = 0 := by
    rw [map_sub, map_sub, map_mul, map_one, map_sum, hdet, hg']
    simp only [map_mul, hc', hf']
    rw [hc, sub_self]
  obtain ⟨j, h, hh⟩ := hkillP i _ hD
  refine ⟨j, fun b => MvPolynomial.map (β h) (f' b), MvPolynomial.map (β h) g',
    fun b => by rw [hT, hf'], ?_⟩
  have key : MvPolynomial.map (β h) g' * (Matrix.of fun a b => MvPolynomial.pderiv a
      (MvPolynomial.map (β h) (f' b))).det - 1 = MvPolynomial.map (β h)
      (g' * (Matrix.of fun a b => MvPolynomial.pderiv a (f' b)).det - 1) := by
    rw [map_sub, map_mul, map_one, hdet]
  show MvPolynomial.map (β h) g' * (Matrix.of fun a b => MvPolynomial.pderiv a
      (MvPolynomial.map (β h) (f' b))).det - 1 ∈
      Ideal.span (Set.range fun b => MvPolynomial.map (β h) (f' b))
  rw [map_sub, sub_eq_zero] at hh
  rw [key, hh, map_sum]
  refine Ideal.sum_mem _ fun b _ => ?_
  rw [map_mul]
  exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨b, rfl⟩)

theorem wc_tensor_mvpoly_quotient_equiv : ∀ (B R : Type u) [CommRing B] [CommRing R] [Algebra B R] (n : ℕ) (f₀ : Fin n → MvPolynomial (Fin n) B), Nonempty (TensorProduct B R (MvPolynomial (Fin n) B ⧸ Ideal.span (Set.range f₀)) ≃ₐ[R] MvPolynomial (Fin n) R ⧸ Ideal.span (Set.range fun b => MvPolynomial.map (algebraMap B R) (f₀ b))) :=
by
  intro B R _ _ _ n f₀
  let I : Ideal (MvPolynomial (Fin n) B) := Ideal.span (Set.range f₀)
  let ι : MvPolynomial (Fin n) B →ₐ[B] TensorProduct B R (MvPolynomial (Fin n) B) :=
    Algebra.TensorProduct.includeRight
  let K : Ideal (TensorProduct B R (MvPolynomial (Fin n) B)) := Ideal.map ι I
  let e1 : TensorProduct B R (MvPolynomial (Fin n) B ⧸ I) ≃ₐ[R]
      TensorProduct B R (MvPolynomial (Fin n) B) ⧸ K :=
    Algebra.TensorProduct.tensorQuotientEquiv R (MvPolynomial (Fin n) B) R I
  let φ : TensorProduct B R (MvPolynomial (Fin n) B) ≃ₐ[R] MvPolynomial (Fin n) R :=
    MvPolynomial.algebraTensorAlgEquiv (σ := Fin n) B R
  have hpt : ∀ p : MvPolynomial (Fin n) B,
      φ (ι p) = MvPolynomial.map (algebraMap B R) p := by
    intro p
    simp only [φ, ι, Algebra.TensorProduct.includeRight_apply,
      MvPolynomial.algebraTensorAlgEquiv_tmul, one_smul]
  have hJ : Ideal.span (Set.range fun b => MvPolynomial.map (algebraMap B R) (f₀ b)) =
      Ideal.map (φ : TensorProduct B R (MvPolynomial (Fin n) B) →+* MvPolynomial (Fin n) R) K := by
    simp only [K, I]
    rw [Ideal.map_span, Ideal.map_span, Set.image_image, ← Set.range_comp]
    congr 1
    congr 1
    funext b
    exact (hpt (f₀ b)).symm
  exact ⟨e1.trans (Ideal.quotientEquivAlg K _ φ hJ)⟩

theorem wc_affine_etale_realize_tensor : ∀ (P Y W : Scheme.{u}) [IsAffine P] [IsAffine Y] [IsAffine W] (p : P ⟶ Y) (d₀ : W ⟶ P) (A : Type u) [CommRing A] [Algebra Γ(Y, ⊤) A], Algebra.Etale Γ(Y, ⊤) A → (letI : Algebra Γ(Y, ⊤) Γ(P, ⊤) := p.appTop.hom.toAlgebra; letI : Algebra Γ(P, ⊤) Γ(W, ⊤) := d₀.appTop.hom.toAlgebra; Nonempty (TensorProduct Γ(Y, ⊤) Γ(P, ⊤) A ≃ₐ[Γ(P, ⊤)] Γ(W, ⊤))) → ∃ (E : Scheme.{u}) (e : E ⟶ Y) (j : Limits.pullback p e ⟶ W), IsIso j ∧ IsAffine E ∧ Etale e ∧ j ≫ d₀ = Limits.pullback.fst p e :=
by
  intro P Y W _ _ _ p d₀ A _ _ hA hε
  letI algRS : Algebra Γ(Y, ⊤) Γ(P, ⊤) := p.appTop.hom.toAlgebra
  letI algST : Algebra Γ(P, ⊤) Γ(W, ⊤) := d₀.appTop.hom.toAlgebra
  obtain ⟨ε⟩ := hε
  let fS : Spec (CommRingCat.of Γ(P, ⊤)) ⟶ Spec (CommRingCat.of Γ(Y, ⊤)) :=
    Spec.map (CommRingCat.ofHom (algebraMap Γ(Y, ⊤) Γ(P, ⊤)))
  let fA : Spec (CommRingCat.of A) ⟶ Spec (CommRingCat.of Γ(Y, ⊤)) :=
    Spec.map (CommRingCat.ofHom (algebraMap Γ(Y, ⊤) A))
  let e : Spec (CommRingCat.of A) ⟶ Y := fA ≫ Y.isoSpec.inv
  haveI hfAet : Etale fA := by
    rw [HasRingHomProperty.Spec_iff (P := @Etale)]
    exact (RingHom.etale_algebraMap).mpr hA
  have eq₁ : p ≫ Y.isoSpec.hom = P.isoSpec.hom ≫ fS := (Scheme.isoSpec_hom_naturality p).symm
  have eq₂ : e ≫ Y.isoSpec.hom = 𝟙 _ ≫ fA := by
    simp only [e, Category.assoc, Iso.inv_hom_id, Category.comp_id, Category.id_comp]
  let φ₁ : Limits.pullback p e ⟶ Limits.pullback fS fA :=
    Limits.pullback.map p e fS fA P.isoSpec.hom (𝟙 _) Y.isoSpec.hom eq₁ eq₂
  have hφ₁ : φ₁ ≫ Limits.pullback.fst fS fA = Limits.pullback.fst p e ≫ P.isoSpec.hom :=
    Limits.pullback.lift_fst _ _ _
  let ψ := pullbackSpecIso Γ(Y, ⊤) Γ(P, ⊤) A
  let χ : Spec (CommRingCat.of (TensorProduct Γ(Y, ⊤) Γ(P, ⊤) A)) ⟶ Spec (CommRingCat.of Γ(W, ⊤)) :=
    Spec.map ε.symm.toRingEquiv.toCommRingCatIso.hom
  have key : d₀.appTop ≫ ε.symm.toRingEquiv.toCommRingCatIso.hom =
      CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom :
        Γ(P, ⊤) →+* TensorProduct Γ(Y, ⊤) Γ(P, ⊤) A) := by
    ext s
    change ε.symm (algebraMap Γ(P, ⊤) Γ(W, ⊤) s) = s ⊗ₜ 1
    rw [AlgEquiv.commutes]
    rfl
  let j : Limits.pullback p e ⟶ W := φ₁ ≫ ψ.hom ≫ χ ≫ W.isoSpec.inv
  refine ⟨Spec (CommRingCat.of A), e, j, inferInstance, inferInstance, inferInstance, ?_⟩
  simp only [j, χ, Category.assoc]
  rw [← Scheme.isoSpec_inv_naturality, ← Spec.map_comp_assoc, key, pullbackSpecIso_hom_fst_assoc,
    reassoc_of% hφ₁, Iso.hom_inv_id, Category.comp_id]

theorem wc_et_limit_etale_descend : ∀ {S Z : Scheme.{u}} (g : Z ⟶ S) (U : Z.Etale) (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (D : Λ ⥤ S.Etale) (π : ∀ l, U.left ⟶ (D.obj l).left), (∀ l, π l ≫ (D.obj l).hom = U.hom ≫ g) → (∀ {l l' : Λ} (t : l ⟶ l'), π l ≫ (D.map t).left = π l') → (∀ (T : Scheme.{u}) (z : ∀ l, T ⟶ (D.obj l).left), (∀ {l l' : Λ} (t : l ⟶ l'), z l ≫ (D.map t).left = z l') → ∃! z₀ : T ⟶ U.left, ∀ l, z₀ ≫ π l = z l) → (∀ {l l' : Λ} (t : l ⟶ l'), IsAffineHom (D.map t).left) → ∀ (O : Z.Etale) (d : O ⟶ U) (o : O.left), ∃ (l : Λ) (E : S.Etale) (c : E ⟶ D.obj l) (j : Limits.pullback (π l) c.left ⟶ O.left) (q : ↥(Limits.pullback (π l) c.left)), IsAffine E.left ∧ j ≫ d.left = Limits.pullback.fst (π l) c.left ∧ j q = o :=
by
  intro S Z g U Λ _ _ D π _hπ hc hlim haff O d o

  obtain ⟨l₀⟩ := IsCofiltered.nonempty (C := Λ)
  obtain ⟨A₀, hA₀, hmem, -⟩ := exists_isAffineOpen_mem_and_subset
    (U := (⊤ : (D.obj l₀).left.Opens)) (x := π l₀ (d.left o)) trivial

  obtain ⟨I, _, _, D', c', lev, ιP, κ, ⟨hlimc'⟩, haffT, haffO, hκ, hιP, hpb, hrange⟩ :=
    wc_et_limit_affine_open_system Λ D π hc hlim haff l₀ A₀ hA₀
  haveI : ∀ {i i' : I} (f : i ⟶ i'), IsAffineHom (D'.map f) := fun f => haffT f
  haveI : ∀ i, IsAffine (D'.obj i) := haffO
  haveI hcpt : ∀ i, CompactSpace (D'.obj i) := fun i => inferInstance
  haveI hqs : ∀ i, QuasiSeparatedSpace (D'.obj i) := fun i => inferInstance
  haveI : IsOpenImmersion ιP := hιP
  haveI : IsAffine c'.pt := Scheme.isAffine_of_isLimit c' hlimc'

  have hu : d.left o ∈ Set.range ιP := by rw [hrange]; exact hmem
  have hoV : o ∈ d.left ⁻¹ᵁ ιP.opensRange := by
    rw [Scheme.Hom.mem_preimage, ← SetLike.mem_coe, Scheme.Hom.coe_opensRange]; exact hu
  obtain ⟨W, hW, hoW, hWV⟩ := exists_isAffineOpen_mem_and_subset hoV
  haveI : IsAffine (W : Scheme.{u}) := hW
  have hWr : Set.range (W.ι ≫ d.left) ⊆ Set.range ιP := by
    rintro _ ⟨w, rfl⟩
    have h1 : W.ι w ∈ d.left ⁻¹ᵁ ιP.opensRange :=
      (congrArg (fun x => x ∈ d.left ⁻¹ᵁ ιP.opensRange) (Scheme.Opens.ι_apply W w)).mpr (hWV w.2)
    have h2 : d.left (W.ι w) ∈ ιP.opensRange := (Scheme.Hom.mem_preimage _).mp h1
    have h3 : d.left (W.ι w) ∈ Set.range ιP := Eq.subset (Scheme.Hom.coe_opensRange ιP) h2
    exact Set.mem_of_eq_of_mem (Scheme.Hom.comp_apply W.ι d.left w) h3
  let d₀ : (W : Scheme.{u}) ⟶ c'.pt := IsOpenImmersion.lift ιP (W.ι ≫ d.left) hWr
  have hd₀ : d₀ ≫ ιP = W.ι ≫ d.left := IsOpenImmersion.lift_fac _ _ _

  haveI hdet : Etale d.left := MorphismProperty.of_postcomp (W' := @Etale) @Etale d.left U.hom
    U.prop (by rw [MorphismProperty.Over.w d]; exact O.prop)
  have hd₀ι : Etale (d₀ ≫ ιP) := by rw [hd₀]; infer_instance
  haveI hd₀et : Etale d₀ :=
    MorphismProperty.of_postcomp (W' := @Etale) @Etale d₀ ιP inferInstance hd₀ι
  letI algPW : Algebra Γ(c'.pt, ⊤) Γ((W : Scheme.{u}), ⊤) := d₀.appTop.hom.toAlgebra
  have hEt : Algebra.Etale Γ(c'.pt, ⊤) Γ((W : Scheme.{u}), ⊤) :=
    RingHom.Etale.toAlgebra (HasRingHomProperty.appTop @Etale d₀ hd₀et)

  obtain ⟨n, fP, val, hs, hk, g₁, hg⟩ :=
    wc_sh_standard_presentation_fin Γ(c'.pt, ⊤) Γ((W : Scheme.{u}), ⊤) hEt
  let eW : (MvPolynomial (Fin n) Γ(c'.pt, ⊤) ⧸ Ideal.span (Set.range fP)) ≃ₐ[Γ(c'.pt, ⊤)]
      Γ((W : Scheme.{u}), ⊤) :=
    (Ideal.quotientEquivAlgOfEq Γ(c'.pt, ⊤) hk.symm).trans
      (Ideal.quotientKerAlgEquivOfSurjective hs)

  have hcomp : ∀ {i j k : I} (f : k ⟶ j) (h : j ⟶ i) (b : Γ(D'.obj i, ⊤)),
      (D'.map (f ≫ h)).appTop.hom b = (D'.map f).appTop.hom ((D'.map h).appTop.hom b) := by
    intro i j k f h b
    rw [Functor.map_comp, Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply]
  have hcompat : ∀ {i j : I} (f : j ⟶ i) (b : Γ(D'.obj i, ⊤)),
      (c'.π.app j).appTop.hom ((D'.map f).appTop.hom b) = (c'.π.app i).appTop.hom b := by
    intro i j f b
    rw [← c'.w f, Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply]
  have hlift : ∀ r : Γ(c'.pt, ⊤), ∃ (i : I) (b : Γ(D'.obj i, ⊤)),
      (c'.π.app i).appTop.hom b = r := by
    intro r
    obtain ⟨i, t, ht⟩ := exists_appTop_π_eq_of_isLimit D' c' hlimc' r
    exact ⟨i, t, ht.symm⟩
  have hvan : ∀ (i : I) (b : Γ(D'.obj i, ⊤)), (c'.π.app i).appTop.hom b = 0 →
      ∃ (j : I) (f : j ⟶ i), (D'.map f).appTop.hom b = 0 := by
    intro i b hb
    exact exists_appTop_map_eq_zero_of_isLimit D' c' hlimc' b hb

  obtain ⟨i, f₀, g₀, hmap, hcert⟩ := wc_colim_standard_etale_data_descend I
    (fun i => (Γ(D'.obj i, ⊤) : Type u)) Γ(c'.pt, ⊤) (fun i => (c'.π.app i).appTop.hom)
    (fun f => (D'.map f).appTop.hom) hcomp hcompat hlift hvan n fP g₁ hg

  have hAet : Algebra.Etale Γ(D'.obj i, ⊤)
      (MvPolynomial (Fin n) Γ(D'.obj i, ⊤) ⧸ Ideal.span (Set.range f₀)) :=
    wc_standard_etale_quotient Γ(D'.obj i, ⊤) id Function.bijective_id f₀ g₀ hcert

  letI algYP : Algebra Γ(D'.obj i, ⊤) Γ(c'.pt, ⊤) := (c'.π.app i).appTop.hom.toAlgebra
  obtain ⟨e4⟩ := wc_tensor_mvpoly_quotient_equiv Γ(D'.obj i, ⊤) Γ(c'.pt, ⊤) n f₀
  have hfun : (fun b => MvPolynomial.map (algebraMap Γ(D'.obj i, ⊤) Γ(c'.pt, ⊤)) (f₀ b)) = fP :=
    funext hmap
  have hideal : Ideal.span (Set.range fun b =>
      MvPolynomial.map (algebraMap Γ(D'.obj i, ⊤) Γ(c'.pt, ⊤)) (f₀ b)) =
      Ideal.span (Set.range fP) :=
    congrArg (fun s => Ideal.span (Set.range s)) hfun
  let ε := e4.trans ((Ideal.quotientEquivAlgOfEq Γ(c'.pt, ⊤) hideal).trans eW)

  obtain ⟨E₀, e, j₃, hj₃iso, hE₀aff, he, hj₃⟩ := wc_affine_etale_realize_tensor c'.pt (D'.obj i)
    (W : Scheme.{u}) (c'.π.app i) d₀
    (MvPolynomial (Fin n) Γ(D'.obj i, ⊤) ⧸ Ideal.span (Set.range f₀)) hAet (Nonempty.intro ε)

  haveI := hj₃iso
  haveI := he
  haveI := hκ i
  have H := ((IsPullback.of_hasPullback (c'.π.app i) e).flip.paste_vert (hpb i)).flip
  let j₁ := H.isoPullback.inv ≫ j₃
  have hj₁ : j₁ ≫ d₀ ≫ ιP = Limits.pullback.fst (π (lev i)) (e ≫ κ i) := by
    simp only [j₁, Category.assoc]
    rw [← Category.assoc j₃, hj₃]
    exact H.isoPullback_inv_fst
  haveI : IsIso j₁ := by simp only [j₁]; infer_instance
  obtain ⟨q, hq⟩ := Scheme.Hom.surjective j₁ ⟨o, hoW⟩

  haveI : Etale (D.obj (lev i)).hom := (D.obj (lev i)).prop
  let E : S.Etale := MorphismProperty.Over.mk ⊤ (e ≫ κ i ≫ (D.obj (lev i)).hom) inferInstance
  let c : E ⟶ D.obj (lev i) :=
    MorphismProperty.Over.homMk (e ≫ κ i) (Category.assoc _ _ _) trivial
  refine ⟨lev i, E, c, j₁ ≫ W.ι, q, hE₀aff, ?_, ?_⟩
  · exact (Category.assoc _ _ _).trans ((congrArg (fun k => j₁ ≫ k) hd₀.symm).trans hj₁)
  · exact (Scheme.Hom.comp_apply j₁ W.ι q).trans
      ((congrArg W.ι hq).trans (Scheme.Opens.ι_apply W ⟨o, hoW⟩))

theorem wc_et_univ_transport_limit_local_rep : ∀ {S Z : Scheme.{u}} (g : Z ⟶ S) (G : Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}) (H : Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) (ρ : wcEtTransport g G H), wcEtTransportUniv ρ → ∀ (U : Z.Etale) (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (D : Λ ⥤ S.Etale) (π : ∀ l, U.left ⟶ (D.obj l).left), (∀ l, π l ≫ (D.obj l).hom = U.hom ≫ g) → (∀ {l l' : Λ} (t : l ⟶ l'), π l ≫ (D.map t).left = π l') → (∀ (T : Scheme.{u}) (z : ∀ l, T ⟶ (D.obj l).left), (∀ {l l' : Λ} (t : l ⟶ l'), z l ≫ (D.map t).left = z l') → ∃! z₀ : T ⟶ U.left, ∀ l, z₀ ≫ π l = z l) → (∀ {l l' : Λ} (t : l ⟶ l'), IsAffineHom (D.map t).left) → ∀ (s : H.obj.obj (Opposite.op U)) (o : U.left), ∃ (l : Λ) (W : S.Etale) (c : W ⟶ D.obj l) (x : G.obj.obj (Opposite.op W)) (w : W.left), IsAffine W.left ∧ c.left w = π l o ∧ ∀ (O : Z.Etale) (d : O ⟶ U) (k : O.left ⟶ W.left) (hk : k ≫ W.hom = O.hom ≫ g), k ≫ c.left = d.left ≫ π l → (H.obj.map d.op).hom s = ρ.ρ W O k hk x :=
by
  intro S Z g G H ρ huniv U Λ _ _ D π hπ hc hlim haff s o
  classical

  obtain ⟨O₁, d₁, o₁, V, h, hh, y, hd₁o, hs₁⟩ :=
    wc_et_univ_transport_locally_surjective g G H ρ huniv U s o
  have hs₁' : (H.obj.map d₁.op).hom s = ρ.ρ V O₁ h hh y := hs₁

  obtain ⟨l₁, E, c₁, j, q, hEaffine, hj, hjq⟩ :=
    wc_et_limit_etale_descend g U Λ D π hπ hc hlim haff O₁ d₁ o₁
  haveI := hEaffine

  let F : Λ ⥤ Scheme.{u} :=
    { obj := fun l => (D.obj l).left
      map := fun t => (D.map t).left
      map_id := fun l => by rw [D.map_id]; rfl
      map_comp := fun f g => by rw [D.map_comp]; rfl }
  have hcF : ∀ {l l' : Λ} (t : l ⟶ l'), π l ≫ F.map t = π l' := fun t => hc t
  have hlimF : ∀ (T : Scheme.{u}) (z : ∀ l, T ⟶ F.obj l),
      (∀ {l l' : Λ} (t : l ⟶ l'), z l ≫ F.map t = z l') → ∃! z₀ : T ⟶ U.left, ∀ l, z₀ ≫ π l = z l :=
    fun T z hz => hlim T z hz
  have haffF : ∀ {l l' : Λ} (t : l ⟶ l'), IsAffineHom (F.map t) := fun t => haff t

  let cP : Limits.Cone F :=
    ⟨U.left, { app := π, naturality := fun k k' t => (Category.id_comp _).trans (hcF t).symm }⟩
  have hL : Limits.IsLimit cP :=
    Limits.IsLimit.ofExistsUnique (fun s => hlimF s.pt s.π.app (fun t => s.w t))
  have hW : Limits.IsLimit (cP.whisker (Over.forget l₁)) :=
    (Functor.Initial.isLimitWhiskerEquiv (Over.forget l₁) cP).symm hL
  have hres : ∀ (W : Scheme.{u}) (a : ∀ j : Over l₁, W ⟶ F.obj j.left),
      (∀ {j j' : Over l₁} (g : j ⟶ j'), a j ≫ F.map g.left = a j') →
      ∃! z₀ : W ⟶ U.left, ∀ j : Over l₁, z₀ ≫ π j.left = a j := by
    intro W a ha
    let sa : Limits.Cone (Over.forget l₁ ⋙ F) :=
      ⟨W, { app := a, naturality := fun j j' g => by simp [ha g] }⟩
    exact hW.existsUnique sa

  let Ey : Over l₁ ⥤ Scheme.{u} := Over.post F ⋙ Over.pullback c₁.left ⋙ Over.forget E.left
  let i₀ : Over l₁ := Over.mk (𝟙 l₁)
  let fst : ∀ j : Over l₁, Ey.obj j ⟶ F.obj j.left := fun j =>
    Limits.pullback.fst (F.map j.hom) c₁.left
  let snd : ∀ j : Over l₁, Ey.obj j ⟶ E.left := fun j => Limits.pullback.snd (F.map j.hom) c₁.left
  have hcondE : ∀ j : Over l₁, fst j ≫ F.map j.hom = snd j ≫ c₁.left := fun j =>
    Limits.pullback.condition
  have ext : ∀ (j : Over l₁) {W : Scheme.{u}} (u v : W ⟶ Ey.obj j), u ≫ fst j = v ≫ fst j →
      u ≫ snd j = v ≫ snd j → u = v := fun j W u v h1 h2 => Limits.pullback.hom_ext h1 h2
  have F1 : ∀ {j j' : Over l₁} (g : j ⟶ j'), Ey.map g ≫ fst j' = fst j ≫ F.map g.left := by
    intro j j' g
    have h := Over.pullback_map_left c₁.left ((Over.post F).obj j) (k := (Over.post F).map g)
    refine (congrArg (· ≫ fst j') h).trans ?_
    exact Limits.pullback.lift_fst _ _ _
  have F2 : ∀ {j j' : Over l₁} (g : j ⟶ j'), Ey.map g ≫ snd j' = snd j := by
    intro j j' g
    exact Over.w ((Over.pullback c₁.left).map ((Over.post F).map g))
  have hleg : ∀ j : Over l₁, (Limits.pullback.fst (π l₁) c₁.left ≫ π j.left) ≫ F.map j.hom =
      Limits.pullback.snd (π l₁) c₁.left ≫ c₁.left := by
    intro j
    rw [Category.assoc, hcF j.hom]
    exact Limits.pullback.condition
  let leg : ∀ j : Over l₁, Limits.pullback (π l₁) c₁.left ⟶ Ey.obj j := fun j =>
    Limits.pullback.lift (Limits.pullback.fst (π l₁) c₁.left ≫ π j.left)
      (Limits.pullback.snd (π l₁) c₁.left) (hleg j)
  have leg_fst : ∀ j : Over l₁, leg j ≫ fst j = Limits.pullback.fst (π l₁) c₁.left ≫ π j.left :=
    fun j => Limits.pullback.lift_fst _ _ _
  have leg_snd : ∀ j : Over l₁, leg j ≫ snd j = Limits.pullback.snd (π l₁) c₁.left :=
    fun j => Limits.pullback.lift_snd _ _ _
  have hnat : ∀ {j j' : Over l₁} (g : j ⟶ j'), leg j ≫ Ey.map g = leg j' := by
    intro j j' g
    apply ext j'
    · rw [Category.assoc, F1 g, ← Category.assoc, leg_fst, leg_fst, Category.assoc, hcF g.left]
    · rw [Category.assoc, F2 g, leg_snd, leg_snd]
  let cc : Limits.Cone Ey := ⟨Limits.pullback (π l₁) c₁.left,
    { app := leg, naturality := fun j j' g => by
        simp only [Functor.const_obj_map]
        exact ((Category.id_comp _).trans (hnat g).symm) }⟩
  have hcc : Limits.IsLimit cc := by
    refine Limits.IsLimit.ofExistsUnique (fun s => ?_)
    let a : ∀ j : Over l₁, s.pt ⟶ F.obj j.left := fun j => s.π.app j ≫ fst j
    have ha : ∀ {j j' : Over l₁} (g : j ⟶ j'), a j ≫ F.map g.left = a j' := by
      intro j j' g
      show (s.π.app j ≫ fst j) ≫ F.map g.left = s.π.app j' ≫ fst j'
      rw [Category.assoc, ← F1 g, ← Category.assoc, s.w g]
    obtain ⟨z₀, hz₀, hz₀u⟩ := hres s.pt a ha
    let b : s.pt ⟶ E.left := s.π.app i₀ ≫ snd i₀
    have hb : ∀ j : Over l₁, s.π.app j ≫ snd j = b := by
      intro j
      have g : j ⟶ i₀ := Over.homMk j.hom (by simp [i₀])
      show s.π.app j ≫ snd j = s.π.app i₀ ≫ snd i₀
      rw [← s.w g, Category.assoc, F2 g]
    have hcond : z₀ ≫ π l₁ = b ≫ c₁.left := by
      have h1 : z₀ ≫ π l₁ = s.π.app i₀ ≫ fst i₀ := hz₀ i₀
      have h2 : fst i₀ ≫ F.map i₀.hom = snd i₀ ≫ c₁.left := hcondE i₀
      have h3 : F.map i₀.hom = 𝟙 (F.obj l₁) := F.map_id l₁
      rw [h3] at h2
      have h4 : fst i₀ = snd i₀ ≫ c₁.left := (Category.comp_id (fst i₀)).symm.trans h2
      show z₀ ≫ π l₁ = (s.π.app i₀ ≫ snd i₀) ≫ c₁.left
      rw [h1, Category.assoc, ← h4]
    refine ⟨Limits.pullback.lift z₀ b hcond, fun j => ?_, fun m hm => ?_⟩
    · change Limits.pullback.lift z₀ b hcond ≫ leg j = s.π.app j
      apply ext j
      · rw [Category.assoc, leg_fst, ← Category.assoc, Limits.pullback.lift_fst]
        exact hz₀ j
      · rw [Category.assoc, leg_snd, Limits.pullback.lift_snd, hb j]
    · have hm' : ∀ j, m ≫ leg j = s.π.app j := hm
      have e1 : m ≫ Limits.pullback.fst (π l₁) c₁.left = z₀ := by
        apply hz₀u
        intro j
        rw [Category.assoc, ← leg_fst j, ← Category.assoc, hm' j]
      have e2 : m ≫ Limits.pullback.snd (π l₁) c₁.left = b := by
        rw [← leg_snd i₀, ← Category.assoc, hm' i₀]
      refine Limits.pullback.hom_ext (f := π l₁) (g := c₁.left) ?_ ?_
      · rw [e1, Limits.pullback.lift_fst]
      · rw [e2, Limits.pullback.lift_snd]

  have hsndAff : ∀ i : Over l₁, IsAffineHom (snd i) := fun i =>
    MorphismProperty.of_isPullback (P := @IsAffineHom)
      (IsPullback.of_hasPullback (F.map i.hom) c₁.left) (haffF i.hom)
  have hEaff : ∀ {i j : Over l₁} (f : i ⟶ j), IsAffineHom (Ey.map f) := by
    intro i j f
    have big : IsPullback (Ey.map f ≫ snd j) (fst i) c₁.left (F.map f.left ≫ F.map j.hom) := by
      rw [F2 f, ← F.map_comp, Over.w f]
      exact (IsPullback.of_hasPullback (F.map i.hom) c₁.left).flip
    have right : IsPullback (snd j) (fst j) c₁.left (F.map j.hom) :=
      (IsPullback.of_hasPullback (F.map j.hom) c₁.left).flip
    have sq := IsPullback.of_right big (F1 f) right
    exact MorphismProperty.of_isPullback (P := @IsAffineHom) sq.flip (haffF f.left)
  have hEyAff : ∀ i : Over l₁, IsAffine (Ey.obj i) := fun i => by
    haveI := hsndAff i
    exact isAffine_of_isAffineHom (snd i)
  haveI : ∀ {i j : Over l₁} (f : i ⟶ j), IsAffineHom (Ey.map f) := fun f => hEaff f
  haveI : ∀ i : Over l₁, CompactSpace (Ey.obj i) := fun i => by
    haveI := hEyAff i
    infer_instance
  haveI : ∀ i : Over l₁, QuasiSeparatedSpace (Ey.obj i) := fun i => by
    haveI := hEyAff i
    infer_instance

  have ha : (j ≫ h) ≫ V.hom = Limits.pullback.snd (π l₁) c₁.left ≫ E.hom := by
    calc (j ≫ h) ≫ V.hom = j ≫ O₁.hom ≫ g := by rw [Category.assoc, hh]
      _ = (j ≫ d₁.left) ≫ U.hom ≫ g := by
          rw [← MorphismProperty.Over.w d₁]; simp only [Category.assoc]
      _ = Limits.pullback.fst (π l₁) c₁.left ≫ π l₁ ≫ (D.obj l₁).hom := by rw [hj, hπ l₁]
      _ = (Limits.pullback.fst (π l₁) c₁.left ≫ π l₁) ≫ (D.obj l₁).hom :=
          (Category.assoc _ _ _).symm
      _ = (Limits.pullback.snd (π l₁) c₁.left ≫ c₁.left) ≫ (D.obj l₁).hom := by
          rw [Limits.pullback.condition]
      _ = Limits.pullback.snd (π l₁) c₁.left ≫ E.hom := by
          rw [Category.assoc, MorphismProperty.Over.w c₁]

  let tnat : Ey ⟶ (Functor.const (Over l₁)).obj S :=
    { app := fun i => snd i ≫ E.hom
      naturality := fun i i' f => by
        simp only [Functor.const_obj_map, Category.comp_id]
        rw [← Category.assoc, F2 f]
        exact (Category.comp_id _).symm }
  have hcomp : cc.π ≫ tnat = (Functor.const (Over l₁)).map ((j ≫ h) ≫ V.hom) := by
    refine NatTrans.ext (funext fun i => ?_)
    change leg i ≫ snd i ≫ E.hom = (j ≫ h) ≫ V.hom
    rw [ha, ← Category.assoc, leg_snd]
  obtain ⟨i, m, hm1, hm2⟩ :=
    Scheme.exists_π_app_comp_eq_of_locallyOfFinitePresentation Ey tnat V.hom cc hcc (j ≫ h) hcomp
  have hm1' : leg i ≫ m = j ≫ h := hm1
  have hDw : F.map i.hom ≫ (D.obj l₁).hom = (D.obj i.left).hom :=
    MorphismProperty.Over.w (D.map i.hom)
  have hsndE : snd i ≫ E.hom = fst i ≫ (D.obj i.left).hom := by
    rw [← MorphismProperty.Over.w c₁, ← Category.assoc, ← hcondE i, Category.assoc, hDw]
  have hmW : m ≫ V.hom = fst i ≫ (D.obj i.left).hom := by
    rw [hm2]; exact hsndE

  haveI hEc : Etale c₁.left := by
    haveI : Etale (D.obj l₁).hom := (D.obj l₁).prop
    haveI : Etale (c₁.left ≫ (D.obj l₁).hom) := by
      rw [MorphismProperty.Over.w c₁]; exact E.prop
    exact Etale.of_comp c₁.left (D.obj l₁).hom
  have hEtW : Etale (fst i ≫ (D.obj i.left).hom) := by
    haveI : Etale (D.obj i.left).hom := (D.obj i.left).prop
    haveI : Etale (fst i) := by
      show Etale (Limits.pullback.fst (F.map i.hom) c₁.left)
      infer_instance
    infer_instance
  let W : S.Etale := MorphismProperty.Over.mk ⊤ (fst i ≫ (D.obj i.left).hom) hEtW
  let cW : W ⟶ D.obj i.left := MorphismProperty.Over.homMk (A := W) (B := D.obj i.left) (fst i)
    rfl trivial
  let mm : W ⟶ V := MorphismProperty.Over.homMk (A := W) (B := V) m hmW trivial

  have hfq : Limits.pullback.fst (π l₁) c₁.left q = o := by
    rw [← hj, Scheme.Hom.comp_apply, hjq, hd₁o]
  have hpt : (F.map i.hom) (π i.left o) = c₁.left (Limits.pullback.snd (π l₁) c₁.left q) := by
    have e1 : (π i.left ≫ F.map i.hom) o = π l₁ o := by rw [hcF i.hom]
    have e2 : (Limits.pullback.snd (π l₁) c₁.left ≫ c₁.left) q =
        (Limits.pullback.fst (π l₁) c₁.left ≫ π l₁) q := by rw [Limits.pullback.condition]
    rw [Scheme.Hom.comp_apply] at e1
    rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply, hfq] at e2
    rw [e1, e2]
  obtain ⟨z, hz1, -⟩ :=
    Scheme.Pullback.exists_preimage_pullback (f := F.map i.hom) (g := c₁.left) _ _ hpt

  have hρc : ∀ (O : Z.Etale) (α β : O.left ⟶ V.left) (hα : α ≫ V.hom = O.hom ≫ g)
      (hβ : β ≫ V.hom = O.hom ≫ g), α = β → ρ.ρ V O α hα y = ρ.ρ V O β hβ y := by
    intro O α β hα hβ e
    subst e
    rfl
  refine ⟨i.left, W, cW, (G.obj.map mm.op).hom y, z, ?_, ?_, ?_⟩
  · show IsAffine (Ey.obj i)
    exact hEyAff i
  · exact hz1
  · intro O d k hk hkc
    have hkf : k ≫ fst i = d.left ≫ π i.left := hkc
    have hr : d.left ≫ π l₁ = (k ≫ snd i) ≫ c₁.left :=
      (congrArg (d.left ≫ ·) (hcF i.hom)).symm.trans ((Category.assoc _ _ _).symm.trans
        ((congrArg (· ≫ F.map i.hom) hkf.symm).trans ((Category.assoc _ _ _).trans
          ((congrArg (k ≫ ·) (hcondE i)).trans (Category.assoc _ _ _).symm))))
    obtain ⟨r, hr1, hr2⟩ : ∃ r : O.left ⟶ Limits.pullback (π l₁) c₁.left,
        r ≫ Limits.pullback.fst (π l₁) c₁.left = d.left ∧
          r ≫ Limits.pullback.snd (π l₁) c₁.left = k ≫ snd i :=
      ⟨Limits.pullback.lift d.left (k ≫ snd i) hr, Limits.pullback.lift_fst _ _ _,
        Limits.pullback.lift_snd _ _ _⟩
    have hkr : k = r ≫ leg i := by
      apply ext i
      · exact hkf.trans ((congrArg (· ≫ π i.left) hr1).symm.trans ((Category.assoc _ _ _).trans
          ((congrArg (r ≫ ·) (leg_fst i)).symm.trans (Category.assoc _ _ _).symm)))
      · exact hr2.symm.trans ((congrArg (r ≫ ·) (leg_snd i)).symm.trans (Category.assoc _ _ _).symm)
    have hr' : (r ≫ j) ≫ O₁.hom = O.hom := by
      rw [← MorphismProperty.Over.w d₁, Category.assoc, ← Category.assoc j, hj,
        ← Category.assoc, hr1, MorphismProperty.Over.w d]
    obtain ⟨r', hr'l⟩ : ∃ r' : O ⟶ O₁, r'.left = r ≫ j :=
      ⟨MorphismProperty.Over.homMk (r ≫ j) hr' trivial, rfl⟩
    have hd : d = r' ≫ d₁ := by
      apply MorphismProperty.Over.Hom.ext
      change d.left = r'.left ≫ d₁.left
      rw [hr'l, Category.assoc, hj, hr1]
    have hkey : r'.left ≫ h = k ≫ m := by
      rw [hr'l, Category.assoc, ← hm1', ← Category.assoc]
      exact congrArg (· ≫ m) hkr.symm
    have hh₁ : (r'.left ≫ h) ≫ V.hom = O.hom ≫ g := by
      rw [Category.assoc, hh, ← Category.assoc, MorphismProperty.Over.w r']
    have hh₂ : (k ≫ m) ≫ V.hom = O.hom ≫ g :=
      (Category.assoc _ _ _).trans ((congrArg (k ≫ ·) hmW).trans hk)
    have nat1 := ρ.nat V V (𝟙 V) O₁ O r' h hh (r'.left ≫ h) hh₁
      (by show (r'.left ≫ h) ≫ 𝟙 V.left = r'.left ≫ h; exact Category.comp_id _) y
    have nat2 := ρ.nat V W mm O O (𝟙 O) (k ≫ m) hh₂ k hk
      (by show k ≫ m = 𝟙 O.left ≫ (k ≫ m); exact (Category.id_comp _).symm) y
    rw [op_id, CategoryTheory.Functor.map_id] at nat1
    rw [op_id, CategoryTheory.Functor.map_id] at nat2
    have e1 : (H.obj.map d.op).hom s = (H.obj.map r'.op).hom ((H.obj.map d₁.op).hom s) := by
      rw [hd, op_comp, CategoryTheory.Functor.map_comp]
      rfl
    refine e1.trans ?_
    rw [hs₁']
    refine nat1.symm.trans ?_
    refine (hρc O _ _ hh₁ hh₂ hkey).trans ?_
    exact nat2.symm

theorem wc_et_univ_transport_limit_normalize : ∀ {S Z : Scheme.{u}} (g : Z ⟶ S) (G : Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}) (H : Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) (ρ : wcEtTransport g G H) (U : Z.Etale) (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (D : Λ ⥤ S.Etale) (π : ∀ l, U.left ⟶ (D.obj l).left), (∀ {l l' : Λ} (t : l ⟶ l'), π l ≫ (D.map t).left = π l') → (∀ l, CompactSpace (D.obj l).left) → (∀ l, QuasiSeparatedSpace (D.obj l).left) → CompactSpace U.left → ∀ s : H.obj.obj (Opposite.op U), (∀ o : U.left, ∃ (l : Λ) (W : S.Etale) (c : W ⟶ D.obj l) (x : G.obj.obj (Opposite.op W)) (w : W.left), IsAffine W.left ∧ c.left w = π l o ∧ ∀ (O : Z.Etale) (d : O ⟶ U) (k : O.left ⟶ W.left) (hk : k ≫ W.hom = O.hom ≫ g), k ≫ c.left = d.left ≫ π l → (H.obj.map d.op).hom s = ρ.ρ W O k hk x) → ∃ (l₀ : Λ) (n : ℕ) (W : Fin n → S.Etale) (c : ∀ i, W i ⟶ D.obj l₀) (x : ∀ i, G.obj.obj (Opposite.op (W i))), (∀ i, CompactSpace (W i).left) ∧ (∀ p : U.left, ∃ (i : Fin n) (w : (W i).left), (c i).left w = π l₀ p) ∧ ∀ (i : Fin n) (O : Z.Etale) (d : O ⟶ U) (k : O.left ⟶ (W i).left) (hk : k ≫ (W i).hom = O.hom ≫ g), k ≫ (c i).left = d.left ≫ π l₀ → (H.obj.map d.op).hom s = ρ.ρ (W i) O k hk (x i) :=
by
  intro S Z g G H ρ U Λ _ _ D π hc hqc hqs hU s hloc
  classical
  have hEtHom : ∀ {A B : S.Etale} (a : A ⟶ B), Etale a.left := by
    intro A B a
    haveI : Etale B.hom := B.prop
    haveI : Etale (a.left ≫ B.hom) := by rw [MorphismProperty.Over.w a]; exact A.prop
    exact Etale.of_comp a.left B.hom
  have hbc : ∀ (A B : S.Etale) (β : A ⟶ B) (πA : U.left ⟶ A.left) (πB : U.left ⟶ B.left),
      πA ≫ β.left = πB → CompactSpace A.left → QuasiSeparatedSpace B.left →
      ∀ (W₀ : S.Etale) (c₀ : W₀ ⟶ B) (x₀ : G.obj.obj (Opposite.op W₀)), CompactSpace W₀.left →
      (∀ (O : Z.Etale) (d : O ⟶ U) (k : O.left ⟶ W₀.left) (hk : k ≫ W₀.hom = O.hom ≫ g),
        k ≫ c₀.left = d.left ≫ πB → (H.obj.map d.op).hom s = ρ.ρ W₀ O k hk x₀) →
      ∃ (W' : S.Etale) (c' : W' ⟶ A) (x' : G.obj.obj (Opposite.op W')), CompactSpace W'.left ∧
        (∀ (p : U.left) (w : W₀.left), c₀.left w = πB p → ∃ w' : W'.left, c'.left w' = πA p) ∧
        ∀ (O : Z.Etale) (d : O ⟶ U) (k : O.left ⟶ W'.left) (hk : k ≫ W'.hom = O.hom ≫ g),
          k ≫ c'.left = d.left ≫ πA → (H.obj.map d.op).hom s = ρ.ρ W' O k hk x' := by
    intro A B β πA πB hπ hA hB W₀ c₀ x₀ hW₀ hid₀
    haveI := hEtHom c₀
    haveI := hEtHom β
    haveI : Etale A.hom := A.prop
    haveI : QuasiCompact c₀.left := quasiCompact_of_compactSpace c₀.left
    let P : S.Etale := MorphismProperty.Over.mk ⊤
      (Limits.pullback.snd c₀.left β.left ≫ A.hom) inferInstance
    have h1 : Limits.pullback.fst c₀.left β.left ≫ W₀.hom =
        Limits.pullback.snd c₀.left β.left ≫ A.hom := by
      rw [← MorphismProperty.Over.w c₀, ← Category.assoc, Limits.pullback.condition,
        Category.assoc, MorphismProperty.Over.w β]
    let p₁ : P ⟶ W₀ := MorphismProperty.Over.homMk (Limits.pullback.fst c₀.left β.left) h1 trivial
    let p₂ : P ⟶ A := MorphismProperty.Over.homMk (Limits.pullback.snd c₀.left β.left) rfl trivial
    refine ⟨P, p₂, (G.obj.map p₁.op).hom x₀, ?_, ?_, ?_⟩
    · have hqcs : QuasiCompact (Limits.pullback.snd c₀.left β.left) := inferInstance
      exact @QuasiCompact.compactSpace_of_compactSpace _ _ (Limits.pullback.snd c₀.left β.left)
        hqcs hA
    · intro p w hw
      have e : c₀.left w = β.left (πA p) := by rw [hw, ← hπ, Scheme.Hom.comp_apply]
      obtain ⟨z, -, hz⟩ := Scheme.Pullback.exists_preimage_pullback w (πA p) e
      exact ⟨z, hz⟩
    · intro O d k hk hkc
      have hkc' : k ≫ Limits.pullback.snd c₀.left β.left = d.left ≫ πA := hkc
      have hk' : (k ≫ Limits.pullback.fst c₀.left β.left) ≫ W₀.hom = O.hom ≫ g :=
        calc (k ≫ Limits.pullback.fst c₀.left β.left) ≫ W₀.hom
            = k ≫ (Limits.pullback.fst c₀.left β.left ≫ W₀.hom) := Category.assoc _ _ _
          _ = k ≫ (Limits.pullback.snd c₀.left β.left ≫ A.hom) := congrArg (k ≫ ·) h1
          _ = O.hom ≫ g := hk
      have hkc2 : (k ≫ Limits.pullback.fst c₀.left β.left) ≫ c₀.left = d.left ≫ πB :=
        calc (k ≫ Limits.pullback.fst c₀.left β.left) ≫ c₀.left
            = k ≫ (Limits.pullback.fst c₀.left β.left ≫ c₀.left) := Category.assoc _ _ _
          _ = k ≫ (Limits.pullback.snd c₀.left β.left ≫ β.left) :=
              congrArg (k ≫ ·) Limits.pullback.condition
          _ = (k ≫ Limits.pullback.snd c₀.left β.left) ≫ β.left := (Category.assoc _ _ _).symm
          _ = (d.left ≫ πA) ≫ β.left := congrArg (· ≫ β.left) hkc'
          _ = d.left ≫ πB := by rw [Category.assoc, hπ]
      have e1 := hid₀ O d _ hk' hkc2
      have e2 := ρ.nat W₀ P p₁ O O (𝟙 O) (k ≫ Limits.pullback.fst c₀.left β.left) hk' k hk
        (by
          show k ≫ Limits.pullback.fst c₀.left β.left =
            𝟙 O.left ≫ (k ≫ Limits.pullback.fst c₀.left β.left)
          rw [Category.id_comp]) x₀
      rw [op_id, CategoryTheory.Functor.map_id] at e2
      exact e1.trans e2.symm
  choose lv W c x w hWaff hw hid using hloc
  let N : U.left → Set U.left := fun o => (π (lv o)) ⁻¹' Set.range (c o).left
  have hNo : ∀ o, IsOpen (N o) := fun o => by
    haveI := hEtHom (c o)
    exact ((c o).left.isOpenMap.isOpen_range).preimage (π (lv o)).continuous
  have hoN : ∀ o, o ∈ N o := fun o => ⟨w o, hw o⟩
  obtain ⟨t, ht⟩ := CompactSpace.elim_nhds_subcover N (fun o => (hNo o).mem_nhds (hoN o))
  obtain ⟨l₀, hl₀⟩ := IsCofiltered.inf_objs_exists (t.image lv)
  let e : Fin t.card → U.left := fun i => (t.equivFin.symm i).1
  let τ : ∀ i, l₀ ⟶ lv (e i) := fun i =>
    Classical.choice (hl₀ (Finset.mem_image_of_mem lv (t.equivFin.symm i).2))
  have hWc : ∀ o, CompactSpace (W o).left := fun o => by haveI := hWaff o; infer_instance
  have key := fun i : Fin t.card => hbc (D.obj l₀) (D.obj (lv (e i))) (D.map (τ i)) (π l₀)
    (π (lv (e i))) (hc (τ i)) (hqc l₀) (hqs (lv (e i))) (W (e i)) (c (e i)) (x (e i))
    (hWc (e i)) (hid (e i))
  choose W' c' x' hW'c hpt hid' using key
  refine ⟨l₀, t.card, W', c', x', hW'c, ?_, hid'⟩
  intro p
  have hp : p ∈ ⋃ o ∈ t, N o := by rw [ht]; trivial
  obtain ⟨o, ho, hpo⟩ := Set.mem_iUnion₂.mp hp
  let i := t.equivFin ⟨o, ho⟩
  have hei : e i = o := by
    show (t.equivFin.symm (t.equivFin ⟨o, ho⟩)).1 = o
    rw [Equiv.symm_apply_apply]
  have hmem : p ∈ N (e i) := by rw [hei]; exact hpo
  obtain ⟨w₁, hw₁⟩ := hmem
  obtain ⟨w', hw'⟩ := hpt i p w₁ hw₁
  exact ⟨i, w', hw'⟩

theorem wc_et_univ_transport_limit_pair_agree : ∀ {S Z : Scheme.{u}} (g : Z ⟶ S) (G : Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}) (H : Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) (ρ : wcEtTransport g G H), wcEtTransportUniv ρ → ∀ (U : Z.Etale) (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (D : Λ ⥤ S.Etale) (π : ∀ l, U.left ⟶ (D.obj l).left), (∀ l, π l ≫ (D.obj l).hom = U.hom ≫ g) → (∀ {l l' : Λ} (t : l ⟶ l'), π l ≫ (D.map t).left = π l') → (∀ (T : Scheme.{u}) (z : ∀ l, T ⟶ (D.obj l).left), (∀ {l l' : Λ} (t : l ⟶ l'), z l ≫ (D.map t).left = z l') → ∃! z₀ : T ⟶ U.left, ∀ l, z₀ ≫ π l = z l) → (∀ l, QuasiSeparatedSpace (D.obj l).left) → (∀ {l l' : Λ} (t : l ⟶ l'), IsAffineHom (D.map t).left) → ∀ (s : H.obj.obj (Opposite.op U)) (l₀ : Λ) (n : ℕ) (W : Fin n → S.Etale) (c : ∀ i, W i ⟶ D.obj l₀) (x : ∀ i, G.obj.obj (Opposite.op (W i))), (∀ i, CompactSpace (W i).left) → (∀ (i : Fin n) (O : Z.Etale) (d : O ⟶ U) (k : O.left ⟶ (W i).left) (hk : k ≫ (W i).hom = O.hom ≫ g), k ≫ (c i).left = d.left ≫ π l₀ → (H.obj.map d.op).hom s = ρ.ρ (W i) O k hk (x i)) → ∃ (l₁ : Λ) (t₁ : l₁ ⟶ l₀), ∀ (i j : Fin n) (Y : S.Etale) (a : Y ⟶ W i) (b : Y ⟶ W j) (q : Y ⟶ D.obj l₁), a ≫ c i = q ≫ D.map t₁ → b ≫ c j = q ≫ D.map t₁ → (G.obj.map a.op).hom (x i) = (G.obj.map b.op).hom (x j) :=
by
  intro S Z g G H ρ huniv U Λ _ _ D π hπ hc hlim hqs haff s l₀ n W c x hWc hid
  classical

  have hfib : ∀ {A B C : S.Etale} (a : A ⟶ C) (b : B ⟶ C), ∃ (P : S.Etale) (p₁ : P ⟶ A)
      (p₂ : P ⟶ B), p₁ ≫ a = p₂ ≫ b ∧
      (∀ (T : S.Etale) (y₁ : T ⟶ A) (y₂ : T ⟶ B), y₁ ≫ a = y₂ ≫ b →
        ∃ h : T ⟶ P, h ≫ p₁ = y₁ ∧ h ≫ p₂ = y₂) ∧
      (CompactSpace A.left → CompactSpace B.left → QuasiSeparatedSpace C.left →
        CompactSpace P.left) := by
    intro A B C a b
    haveI : Etale C.hom := C.prop
    haveI : Etale (b.left ≫ C.hom) := by rw [MorphismProperty.Over.w b]; exact B.prop
    haveI : Etale b.left := Etale.of_comp b.left C.hom
    haveI : Etale A.hom := A.prop
    have hfst : Etale (Limits.pullback.fst a.left b.left ≫ A.hom) := inferInstance
    let P : S.Etale := MorphismProperty.Over.mk ⊤ (Limits.pullback.fst a.left b.left ≫ A.hom) hfst
    have hw2 : Limits.pullback.snd a.left b.left ≫ B.hom = P.hom := by
      show _ = Limits.pullback.fst a.left b.left ≫ A.hom
      rw [← MorphismProperty.Over.w b, ← Category.assoc, ← Limits.pullback.condition,
        Category.assoc, MorphismProperty.Over.w a]
    let p₁ : P ⟶ A := MorphismProperty.Over.homMk (Limits.pullback.fst a.left b.left) rfl trivial
    let p₂ : P ⟶ B := MorphismProperty.Over.homMk (Limits.pullback.snd a.left b.left) hw2 trivial
    refine ⟨P, p₁, p₂, ?_, ?_, ?_⟩
    · apply MorphismProperty.Over.Hom.ext
      exact Limits.pullback.condition
    · intro T y₁ y₂ hy
      have hy' : y₁.left ≫ a.left = y₂.left ≫ b.left := congrArg (fun k => k.left) hy
      have hw3 : Limits.pullback.lift y₁.left y₂.left hy' ≫ P.hom = T.hom := by
        show _ ≫ (Limits.pullback.fst a.left b.left ≫ A.hom) = T.hom
        rw [Limits.pullback.lift_fst_assoc, MorphismProperty.Over.w y₁]
      refine ⟨MorphismProperty.Over.homMk (Limits.pullback.lift y₁.left y₂.left hy') hw3 trivial,
        ?_, ?_⟩
      · apply MorphismProperty.Over.Hom.ext
        exact Limits.pullback.lift_fst _ _ _
      · apply MorphismProperty.Over.Hom.ext
        exact Limits.pullback.lift_snd _ _ _
    · intro hA hB hC
      haveI := hA
      haveI := hB
      haveI := hC
      haveI hbqc : QuasiCompact b.left := quasiCompact_of_compactSpace b.left
      have hqc : QuasiCompact (Limits.pullback.fst a.left b.left) :=
        MorphismProperty.of_isPullback (P := @QuasiCompact)
          (IsPullback.of_hasPullback a.left b.left).flip hbqc
      exact @QuasiCompact.compactSpace_of_compactSpace _ _ (Limits.pullback.fst a.left b.left) hqc hA

  have hrefine : ∀ (ι : Type) [Fintype ι] (L : ι → Λ) (t : ∀ k, L k ⟶ l₀),
      ∃ (l₁ : Λ) (t₁ : l₁ ⟶ l₀) (u : ∀ k, l₁ ⟶ L k), ∀ k, u k ≫ t k = t₁ := by
    intro ι _ L t
    have hA : ∀ s : Finset ι, ∃ (l₁ : Λ) (t₁ : l₁ ⟶ l₀),
        ∀ k ∈ s, ∃ v : l₁ ⟶ L k, v ≫ t k = t₁ := by
      intro s
      induction s using Finset.induction_on with
      | empty => exact ⟨l₀, 𝟙 l₀, fun k hk => by simp at hk⟩
      | insert a s ha ih =>
        obtain ⟨l', t', hs⟩ := ih
        obtain ⟨m, g₁, g₂, hg⟩ := IsCofiltered.cospan t' (t a)
        refine ⟨m, g₁ ≫ t', fun k hk => ?_⟩
        rcases Finset.mem_insert.mp hk with hka | hks
        · subst hka
          exact ⟨g₂, hg.symm⟩
        · obtain ⟨v, hv⟩ := hs k hks
          exact ⟨g₁ ≫ v, by rw [Category.assoc, hv]⟩
    obtain ⟨l₁, t₁, hall⟩ := hA Finset.univ
    choose u hu using fun k => hall k (Finset.mem_univ k)
    exact ⟨l₁, t₁, u, hu⟩

  have hpair : ∀ p : Fin n × Fin n, ∃ (l' : Λ) (t : l' ⟶ l₀), ∀ (Y : S.Etale) (a : Y ⟶ W p.1)
      (b : Y ⟶ W p.2) (q : Y ⟶ D.obj l'), a ≫ c p.1 = q ≫ D.map t → b ≫ c p.2 = q ≫ D.map t →
      (G.obj.map a.op).hom (x p.1) = (G.obj.map b.op).hom (x p.2) := by
    rintro ⟨i, j⟩
    obtain ⟨P, p₁, p₂, hcomm, hlift, hcpt⟩ := hfib (c i) (c j)
    have hP : CompactSpace P.left := hcpt (hWc i) (hWc j) (hqs l₀)
    have hvan : ∀ (O : Z.Etale) (d : O ⟶ U) (k : O.left ⟶ P.left)
        (hk : k ≫ P.hom = O.hom ≫ g), k ≫ (p₁ ≫ c i).left = d.left ≫ π l₀ →
        ρ.ρ P O k hk ((G.obj.map p₁.op).hom (x i) - (G.obj.map p₂.op).hom (x j)) = 0 := by
      intro O d k hk hside
      have h1k : (k ≫ p₁.left) ≫ (W i).hom = O.hom ≫ g := by
        rw [Category.assoc, MorphismProperty.Over.w p₁]; exact hk
      have h2k : (k ≫ p₂.left) ≫ (W j).hom = O.hom ≫ g := by
        rw [Category.assoc, MorphismProperty.Over.w p₂]; exact hk
      have hcond1 : k ≫ p₁.left = (𝟙 O : O ⟶ O).left ≫ (k ≫ p₁.left) := by
        show k ≫ p₁.left = 𝟙 O.left ≫ (k ≫ p₁.left)
        exact (Category.id_comp _).symm
      have hcond2 : k ≫ p₂.left = (𝟙 O : O ⟶ O).left ≫ (k ≫ p₂.left) := by
        show k ≫ p₂.left = 𝟙 O.left ≫ (k ≫ p₂.left)
        exact (Category.id_comp _).symm
      have e1 := ρ.nat (W i) P p₁ O O (𝟙 O) (k ≫ p₁.left) h1k k hk hcond1 (x i)
      have e2 := ρ.nat (W j) P p₂ O O (𝟙 O) (k ≫ p₂.left) h2k k hk hcond2 (x j)
      rw [op_id, CategoryTheory.Functor.map_id] at e1 e2
      have side1 : (k ≫ p₁.left) ≫ (c i).left = d.left ≫ π l₀ := by
        rw [Category.assoc]; exact hside
      have hc12 : p₂.left ≫ (c j).left = p₁.left ≫ (c i).left :=
        congrArg (fun m => m.left) hcomm.symm
      have side2 : (k ≫ p₂.left) ≫ (c j).left = d.left ≫ π l₀ := by
        rw [Category.assoc, hc12]; exact hside
      have f1 := hid i O d (k ≫ p₁.left) h1k side1
      have f2 := hid j O d (k ≫ p₂.left) h2k side2
      rw [map_sub, e1, e2, ← f1, ← f2, sub_self]
    obtain ⟨l', t, hkill⟩ := wc_et_univ_transport_limit_vanish g G H ρ huniv U Λ D π hπ hc hlim
      haff l₀ P (p₁ ≫ c i) hP _ hvan
    refine ⟨l', t, fun Y a b q ha hb => ?_⟩
    obtain ⟨h, hh1, hh2⟩ := hlift Y a b (ha.trans hb.symm)
    have hq : h ≫ (p₁ ≫ c i) = q ≫ D.map t := by
      rw [← Category.assoc, hh1]; exact ha
    have hz := hkill Y h q hq
    rw [map_sub, sub_eq_zero] at hz
    rw [← hh1, ← hh2, op_comp, op_comp, CategoryTheory.Functor.map_comp,
      CategoryTheory.Functor.map_comp]
    simp only [AddCommGrpCat.hom_comp, AddMonoidHom.coe_comp, Function.comp_apply]
    exact hz

  choose L T hL using hpair
  obtain ⟨l₁, t₁, u, hu⟩ := hrefine (Fin n × Fin n) L T
  refine ⟨l₁, t₁, fun i j Y a b q ha hb => ?_⟩
  have ht : D.map t₁ = D.map (u (i, j)) ≫ D.map (T (i, j)) := by
    rw [← CategoryTheory.Functor.map_comp, hu]
  refine hL (i, j) Y a b (q ≫ D.map (u (i, j))) ?_ ?_
  · rw [Category.assoc, ← ht]; exact ha
  · rw [Category.assoc, ← ht]; exact hb

theorem wc_et_univ_transport_limit_glue_level : ∀ {S Z : Scheme.{u}} (g : Z ⟶ S) (G : Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}) (H : Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) (ρ : wcEtTransport g G H) (U : Z.Etale) (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (D : Λ ⥤ S.Etale) (π : ∀ l, U.left ⟶ (D.obj l).left) (hπ : ∀ l, π l ≫ (D.obj l).hom = U.hom ≫ g), (∀ {l l' : Λ} (t : l ⟶ l'), π l ≫ (D.map t).left = π l') → ∀ (s : H.obj.obj (Opposite.op U)) (l₀ : Λ) (n : ℕ) (W : Fin n → S.Etale) (c : ∀ i, W i ⟶ D.obj l₀) (x : ∀ i, G.obj.obj (Opposite.op (W i))), (∀ (i : Fin n) (O : Z.Etale) (d : O ⟶ U) (k : O.left ⟶ (W i).left) (hk : k ≫ (W i).hom = O.hom ≫ g), k ≫ (c i).left = d.left ≫ π l₀ → (H.obj.map d.op).hom s = ρ.ρ (W i) O k hk (x i)) → ∀ (l₁ : Λ) (t₁ : l₁ ⟶ l₀), (∀ (i j : Fin n) (Y : S.Etale) (a : Y ⟶ W i) (b : Y ⟶ W j) (q : Y ⟶ D.obj l₁), a ≫ c i = q ≫ D.map t₁ → b ≫ c j = q ≫ D.map t₁ → (G.obj.map a.op).hom (x i) = (G.obj.map b.op).hom (x j)) → ∀ (l₃ : Λ) (u : l₃ ⟶ l₁), (∀ q : (D.obj l₃).left, ∃ (i : Fin n) (w : (W i).left), (c i).left w = (D.map (u ≫ t₁)).left q) → ∃ x₀ : G.obj.obj (Opposite.op (D.obj l₃)), ρ.ρ (D.obj l₃) U (π l₃) (hπ l₃) x₀ = s :=
by
  intro S Z g G H ρ U Λ _ _ D π hπ hc s l₀ n W c x hid l₁ t₁ hagree l₃ u hcov
  classical

  have hEtHom : ∀ {A B : S.Etale} (a : A ⟶ B), Etale a.left := by
    intro A B a
    haveI : Etale B.hom := B.prop
    haveI : Etale (a.left ≫ B.hom) := by rw [MorphismProperty.Over.w a]; exact A.prop
    exact Etale.of_comp a.left B.hom

  have hres : ∀ {Y : Scheme.{u}} {A : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}}
      {V₁ V₂ V₃ : Y.Etale} (e : V₃ ⟶ V₂) (h : V₂ ⟶ V₁) (y : A.obj.obj (Opposite.op V₁)),
      (A.obj.map (e ≫ h).op).hom y = (A.obj.map e.op).hom ((A.obj.map h.op).hom y) := by
    intro Y A V₁ V₂ V₃ e h y
    rw [op_comp, Functor.map_comp]
    rfl


  have hjs : ∀ (Y : Scheme.{u}) (V : Y.Etale) (S : Sieve V), (∀ v : V.left, ∃ (V₁ : Y.Etale)
      (c : V₁ ⟶ V), S.arrows c ∧ v ∈ Set.range c.left) → S ∈ Scheme.smallEtaleTopology Y V := by
    intro Y V S hS
    change S ∈ Scheme.smallGrothendieckTopology @Etale Y V
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
    apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
    intro x
    obtain ⟨V₁, c, hc, y, hy⟩ := hS x
    have hw : c.left ≫ V.hom = V₁.hom := MorphismProperty.Over.w c
    have hEt : Etale c.left := by
      have h1 : Etale V.hom := V.prop
      have h2 : Etale (c.left ≫ V.hom) := by rw [hw]; exact V₁.prop
      exact Etale.of_comp c.left V.hom
    exact ⟨V₁, c, y, hc, hEt, hy⟩
  have hcovS : ∀ {Y : Scheme.{u}} (V : Y.Etale) (k : ℕ) (W' : Fin k → Y.Etale)
      (f : ∀ a, W' a ⟶ V), (∀ y : V.left, ∃ a, y ∈ Set.range (f a).left) →
      Sieve.generate (Presieve.ofArrows W' f) ∈ Scheme.smallEtaleTopology Y V := by
    intro Y V k W' f hcv
    apply hjs
    intro v
    obtain ⟨a, ha⟩ := hcv v
    exact ⟨W' a, f a, ⟨_, 𝟙 _, f a, Presieve.ofArrows.mk a, Category.id_comp _⟩, ha⟩
  have hβu : D.map (u ≫ t₁) = D.map u ≫ D.map t₁ := Functor.map_comp _ _ _

  have hpb : ∀ i, ∃ (Q : S.Etale) (p₁ : Q ⟶ W i) (p₂ : Q ⟶ D.obj l₃),
      p₁ ≫ c i = p₂ ≫ D.map (u ≫ t₁) ∧
      ∀ (w : (W i).left) (q : (D.obj l₃).left), (c i).left w = (D.map (u ≫ t₁)).left q →
        ∃ γ : Q.left, p₂.left γ = q := by
    intro i
    haveI := hEtHom (D.map (u ≫ t₁))
    haveI : Etale (W i).hom := (W i).prop
    let Q : S.Etale := MorphismProperty.Over.mk ⊤
      (Limits.pullback.fst (c i).left (D.map (u ≫ t₁)).left ≫ (W i).hom) inferInstance
    have h1 : Limits.pullback.snd (c i).left (D.map (u ≫ t₁)).left ≫ (D.obj l₃).hom =
        Limits.pullback.fst (c i).left (D.map (u ≫ t₁)).left ≫ (W i).hom := by
      rw [← MorphismProperty.Over.w (D.map (u ≫ t₁)), ← Category.assoc,
        ← Limits.pullback.condition, Category.assoc, MorphismProperty.Over.w (c i)]
    let p₁ : Q ⟶ W i := MorphismProperty.Over.homMk
      (Limits.pullback.fst (c i).left (D.map (u ≫ t₁)).left) rfl trivial
    let p₂ : Q ⟶ D.obj l₃ := MorphismProperty.Over.homMk
      (Limits.pullback.snd (c i).left (D.map (u ≫ t₁)).left) h1 trivial
    refine ⟨Q, p₁, p₂, ?_, ?_⟩
    · apply MorphismProperty.Over.Hom.ext
      exact Limits.pullback.condition
    · intro w q hwq
      obtain ⟨z, -, hz⟩ := Scheme.Pullback.exists_preimage_pullback w q hwq
      exact ⟨z, hz⟩
  choose Q p₁ p₂ hcomm hpts using hpb

  have hsurj : ∀ q : (D.obj l₃).left, ∃ i, q ∈ Set.range (p₂ i).left := by
    intro q
    obtain ⟨i, w, hw⟩ := hcov q
    obtain ⟨γ, hγ⟩ := hpts i w q hw
    exact ⟨i, γ, hγ⟩

  have hP : Presieve.IsSheaf (Scheme.smallEtaleTopology S) (G.obj ⋙ forget AddCommGrpCat.{u+1}) :=
    (isSheaf_iff_isSheaf_of_type _ _).mp
      ((sheafCompose (Scheme.smallEtaleTopology S) (forget AddCommGrpCat.{u+1})).obj G).property
  have hSF := (Presieve.isSheafFor_arrows_iff _ p₂).mp
    (hP.isSheafFor _ (hcovS (D.obj l₃) n Q p₂ hsurj))
  obtain ⟨x₀, hx₀, -⟩ := hSF (fun i => (G.obj.map (p₁ i).op).hom (x i)) (by
    intro i j T gi gj hij
    change (G.obj.map gi.op).hom ((G.obj.map (p₁ i).op).hom (x i)) =
      (G.obj.map gj.op).hom ((G.obj.map (p₁ j).op).hom (x j))
    rw [← hres, ← hres]
    have e := congrArg (fun f => f ≫ (D.map u ≫ D.map t₁)) hij
    simp only [Category.assoc] at e
    apply hagree i j T (gi ≫ p₁ i) (gj ≫ p₁ j) (gi ≫ p₂ i ≫ D.map u)
    · simp only [Category.assoc]
      rw [hcomm i, hβu]
    · simp only [Category.assoc]
      rw [hcomm j, hβu]
      exact e.symm)
  have hx₀' : ∀ i, (G.obj.map (p₂ i).op).hom x₀ = (G.obj.map (p₁ i).op).hom (x i) := hx₀

  have hmix : ∀ i, ∃ (O : Z.Etale) (d : O ⟶ U) (k : O.left ⟶ (Q i).left),
      k ≫ (p₂ i).left = d.left ≫ π l₃ ∧ k ≫ (Q i).hom = O.hom ≫ g ∧
      ∀ (p : U.left) (γ : (Q i).left), π l₃ p = (p₂ i).left γ → ∃ o : O.left, d.left o = p := by
    intro i
    haveI := hEtHom (p₂ i)
    haveI : Etale U.hom := U.prop
    let O : Z.Etale := MorphismProperty.Over.mk ⊤
      (Limits.pullback.fst (π l₃) (p₂ i).left ≫ U.hom) inferInstance
    let d : O ⟶ U := MorphismProperty.Over.homMk (Limits.pullback.fst (π l₃) (p₂ i).left) rfl trivial
    refine ⟨O, d, Limits.pullback.snd (π l₃) (p₂ i).left, ?_, ?_, ?_⟩
    · exact Limits.pullback.condition.symm
    · show Limits.pullback.snd (π l₃) (p₂ i).left ≫ (Q i).hom =
        (Limits.pullback.fst (π l₃) (p₂ i).left ≫ U.hom) ≫ g
      rw [← MorphismProperty.Over.w (p₂ i)]
      simp only [← Category.assoc]
      rw [← Limits.pullback.condition]
      simp only [Category.assoc]
      rw [hπ l₃]
    · intro p γ h
      obtain ⟨z, hz, -⟩ := Scheme.Pullback.exists_preimage_pullback p γ h
      exact ⟨z, hz⟩
  choose O d k hkc hkg hopt using hmix
  have hUcov : ∀ p : U.left, ∃ i, p ∈ Set.range (d i).left := by
    intro p
    obtain ⟨i, γ, hγ⟩ := hsurj (π l₃ p)
    obtain ⟨o, ho⟩ := hopt i p γ hγ.symm
    exact ⟨i, o, ho⟩

  have hagr : ∀ a, (H.obj.map (d a).op).hom (ρ.ρ (D.obj l₃) U (π l₃) (hπ l₃) x₀) =
      (H.obj.map (d a).op).hom s := by
    intro a
