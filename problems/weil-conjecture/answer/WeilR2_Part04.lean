  obtain ⟨ι, _, t, ht⟩ := hfinT (kJ J0) (kfd J0)
  obtain ⟨κ, _, t', ht'⟩ := s16 (Polynomial C₀) B hfin (T (kJ J0)) ι t ht

  refine wc_hnas_pfc_gcl_de_clear_denominators B _ κ t' ht'
    { toFun := D'
