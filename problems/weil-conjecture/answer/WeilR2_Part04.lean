theorem wc_pfc_pd_param_choice : ∀ (k : Type u) [Field k] (Λ : Type u) [CommRing Λ] [IsNoetherianRing Λ] [Algebra k Λ] (𝔮 : Ideal Λ) [𝔮.IsPrime] [IsRegularLocalRing (Localization.AtPrime 𝔮)] (m d e : ℕ) (φ' : MvPolynomial (Fin m) k →ₐ[k] Λ), 0 < e → Submodule.spanFinrank (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮)) = d → RingHom.Flat (Localization.localRingHom (𝔮.comap φ'.toRingHom) 𝔮 φ'.toRingHom rfl) → Ideal.map (Localization.localRingHom (𝔮.comap φ'.toRingHom) 𝔮 φ'.toRingHom rfl) (IsLocalRing.maximalIdeal (Localization.AtPrime (𝔮.comap φ'.toRingHom))) = IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) → ∃ π : Fin d → MvPolynomial (Fin m) k, (∀ i, π i ∈ 𝔮.comap φ'.toRingHom) ∧ Ideal.map (algebraMap Λ (Localization.AtPrime 𝔮)) (Ideal.span (Set.range fun i => φ' (π i))) = IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) ∧ ∀ (i : Fin d) (y : MvPolynomial (Fin m ⊕ Fin d) k), (MvPolynomial.rename Sum.inl (π i) * MvPolynomial.X (Sum.inr i) : MvPolynomial (Fin m ⊕ Fin d) k) ^ 2 * y ∈ Ideal.span ((fun j => (MvPolynomial.rename Sum.inl (π j) * MvPolynomial.X (Sum.inr j) : MvPolynomial (Fin m ⊕ Fin d) k) ^ e) '' {j | j < i}) → (MvPolynomial.rename Sum.inl (π i) * MvPolynomial.X (Sum.inr i) : MvPolynomial (Fin m ⊕ Fin d) k) * y ∈ Ideal.span ((fun j => (MvPolynomial.rename Sum.inl (π j) * MvPolynomial.X (Sum.inr j) : MvPolynomial (Fin m ⊕ Fin d) k) ^ e) '' {j | j < i}) :=
by
  intro k _ Λ _ _ _ 𝔮 _ _ m d e φ' he hd hflat hgen
  classical

  have hs6 : ∀ (P : Type u) [CommRing P] (c : Fin d → P) (i : Fin d), (∀ S : Set (Fin d), S ⊆ {j | j < i} → ∀ a : P, c i ^ 2 * a ∈ Ideal.span ((fun j => c j ^ e) '' S) → c i * a ∈ Ideal.span ((fun j => c j ^ e) '' S)) → ∀ f : MvPolynomial (Fin d) P, (MvPolynomial.C (c i) * MvPolynomial.X i) ^ 2 * f ∈ Ideal.span ((fun j => (MvPolynomial.C (c j) * MvPolynomial.X j) ^ e) '' {j | j < i}) → MvPolynomial.C (c i) * MvPolynomial.X i * f ∈ Ideal.span ((fun j => (MvPolynomial.C (c j) * MvPolynomial.X j) ^ e) '' {j | j < i}) := by
    intro P _ c i hc f hf
    set J' := Ideal.span ((fun j => (MvPolynomial.C (c j) * MvPolynomial.X j : MvPolynomial (Fin d) P) ^ e) '' {j | j < i}) with hJ'
    let Sb : (Fin d →₀ ℕ) → Set (Fin d) := fun β => {j | j < i ∧ e ≤ β j}
    let Jb : (Fin d →₀ ℕ) → Ideal P := fun β => Ideal.span ((fun j => c j ^ e) '' Sb β)
    have hmono : ∀ β β' : Fin d →₀ ℕ, β' ≤ β → Jb β' ≤ Jb β := by
      intro β β' h
      apply Ideal.span_mono
      apply Set.image_mono
      intro j hj
      exact ⟨hj.1, le_trans hj.2 (h j)⟩
    have hg : ∀ j, (MvPolynomial.C (c j) * MvPolynomial.X j : MvPolynomial (Fin d) P) ^ e =
        MvPolynomial.monomial (Finsupp.single j e) (c j ^ e) := by
      intro j
      rw [mul_pow, ← MvPolynomial.C_pow, MvPolynomial.C_mul_X_pow_eq_monomial]
