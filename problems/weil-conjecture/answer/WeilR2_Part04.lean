      Ideal.mem_primeCompl_iff]
    intro hmem
    apply hz
    have h2 : z ∈ Ideal.comap (Ideal.Quotient.mk I) (𝔮.map (Ideal.Quotient.mk I)) := hmem
    rw [Ideal.comap_map_of_surjective' _ Ideal.Quotient.mk_surjective, Ideal.mk_ker] at h2
    exact (sup_le le_rfl hIq) h2

  have hR0L : ∀ r, algebraMap (MvPolynomial (Fin m ⊕ Fin d) k ⧸ J)
      (Localization.AtPrime (𝔮.map (Ideal.Quotient.mk I))) (Ideal.Quotient.mk J r) =
      algebraMap (Λ ⧸ I) (Localization.AtPrime (𝔮.map (Ideal.Quotient.mk I)))
        (Ideal.Quotient.mk I (algebraMap (MvPolynomial (Fin m ⊕ Fin d) k) Λ r)) := by
    intro r
    rw [IsScalarTower.algebraMap_apply (MvPolynomial (Fin m ⊕ Fin d) k ⧸ J) (Λ ⧸ I)
      (Localization.AtPrime (𝔮.map (Ideal.Quotient.mk I))),
      Ideal.Quotient.algebraMap_quotient_map_quotient]

  obtain ⟨M, hM⟩ : ∃ M : Submonoid (MvPolynomial (Fin m ⊕ Fin d) k ⧸ J),
      M = Submonoid.comap (algebraMap (MvPolynomial (Fin m ⊕ Fin d) k ⧸ J)
        (Localization.AtPrime (𝔮.map (Ideal.Quotient.mk I))))
        (IsUnit.submonoid (Localization.AtPrime (𝔮.map (Ideal.Quotient.mk I)))) := ⟨_, rfl⟩
  have hMu : ∀ y : M, IsUnit (algebraMap (MvPolynomial (Fin m ⊕ Fin d) k ⧸ J)
      (Localization.AtPrime (𝔮.map (Ideal.Quotient.mk I))) y) := by
    intro y
    have h : (y : MvPolynomial (Fin m ⊕ Fin d) k ⧸ J) ∈ Submonoid.comap
        (algebraMap (MvPolynomial (Fin m ⊕ Fin d) k ⧸ J)
        (Localization.AtPrime (𝔮.map (Ideal.Quotient.mk I))))
        (IsUnit.submonoid (Localization.AtPrime (𝔮.map (Ideal.Quotient.mk I)))) := by
      rw [← hM]; exact y.2
    exact (IsUnit.mem_submonoid_iff _).mp (Submonoid.mem_comap.mp h)
  obtain ⟨lam₀, hlam⟩ : ∃ f : Localization M →+*
      Localization.AtPrime (𝔮.map (Ideal.Quotient.mk I)),
      ∀ r, f (algebraMap (MvPolynomial (Fin m ⊕ Fin d) k ⧸ J) (Localization M) r) =
        algebraMap (MvPolynomial (Fin m ⊕ Fin d) k ⧸ J)
          (Localization.AtPrime (𝔮.map (Ideal.Quotient.mk I))) r :=
    ⟨IsLocalization.lift hMu, IsLocalization.lift_eq hMu⟩
  have hB1 : ∀ q, q ∉ 𝔮.comap φ'.toRingHom →
      Ideal.Quotient.mk J (MvPolynomial.rename Sum.inl q) ∈ M := by
    intro q hq
    rw [hM, Submonoid.mem_comap, IsUnit.mem_submonoid_iff, hR0L, hren]
    exact hunit _ (fun h => hq (Ideal.mem_comap.mpr h))
  have hB2 : ∀ i, Ideal.Quotient.mk J (MvPolynomial.X (Sum.inr i)) ∈ M := by
    intro i
    rw [hM, Submonoid.mem_comap, IsUnit.mem_submonoid_iff, hR0L, hRXr]
    exact hunit _ (hδ i)

  have hpow : IsLocalRing.maximalIdeal (Localization.AtPrime (𝔮.comap φ'.toRingHom)) ^ n ≤
      Ideal.span (Set.range fun i => algebraMap (MvPolynomial (Fin m) k)
        (Localization.AtPrime (𝔮.comap φ'.toRingHom)) (π i) ^ (8 * c)) := by
    letI := (Localization.localRingHom (𝔮.comap φ'.toRingHom) 𝔮 φ'.toRingHom rfl).toAlgebra
    haveI : Module.Flat (Localization.AtPrime (𝔮.comap φ'.toRingHom))
      (Localization.AtPrime 𝔮) := hflat
    haveI : IsLocalHom (algebraMap (Localization.AtPrime (𝔮.comap φ'.toRingHom))
        (Localization.AtPrime 𝔮)) :=
      Localization.isLocalHom_localRingHom _ _ _ _
    haveI : Module.FaithfullyFlat (Localization.AtPrime (𝔮.comap φ'.toRingHom))
      (Localization.AtPrime 𝔮) := Module.FaithfullyFlat.of_flat_of_isLocalHom
    rw [← Ideal.comap_map_eq_self_of_faithfullyFlat
      (A := Localization.AtPrime (𝔮.comap φ'.toRingHom))
      (B := Localization.AtPrime 𝔮) (Ideal.span _)]
    refine le_trans Ideal.le_comap_map (Ideal.comap_mono ?_)
    rw [RingHom.algebraMap_toAlgebra, Ideal.map_pow, hgen, Ideal.map_span, ← Set.range_comp]
    have hu : Ideal.span (Set.range fun i => algebraMap Λ (Localization.AtPrime 𝔮) (φ' (π i))) =
        IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) := by
      rw [← hπgen, Ideal.map_span, ← Set.range_comp]
      rfl
    have e : ((Localization.localRingHom (𝔮.comap φ'.toRingHom) 𝔮 φ'.toRingHom rfl) ∘
        fun i => algebraMap (MvPolynomial (Fin m) k)
          (Localization.AtPrime (𝔮.comap φ'.toRingHom)) (π i) ^ (8 * c)) =
        fun i => (algebraMap Λ (Localization.AtPrime 𝔮) (φ' (π i))) ^ (8 * c) := by
      funext i
      simp only [Function.comp_apply, map_pow]
      rw [Localization.localRingHom_to_map]
      rfl
    rw [e]
    calc IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) ^ n
        ≤ IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) ^ (d * (8 * c) + 1) :=
          Ideal.pow_le_pow_right hn
      _ = Ideal.span (Set.range fun i => algebraMap Λ (Localization.AtPrime 𝔮) (φ' (π i))) ^
          (d * (8 * c) + 1) := by rw [hu]
      _ ≤ _ := wc_pfc_pd_span_pow_le _ d (8 * c) _

  have hgu : ∀ y : (𝔮.comap φ'.toRingHom).primeCompl,
      IsUnit (((algebraMap (MvPolynomial (Fin m ⊕ Fin d) k ⧸ J) (Localization M)).comp
        ((Ideal.Quotient.mk J).comp (MvPolynomial.rename Sum.inl :
          MvPolynomial (Fin m) k →ₐ[k] MvPolynomial (Fin m ⊕ Fin d) k).toRingHom)) y) := by
    intro y
    exact IsLocalization.map_units (Localization M) (⟨_, hB1 y y.2⟩ : M)
  have hzero : ∀ i, (algebraMap (MvPolynomial (Fin m ⊕ Fin d) k ⧸ J) (Localization M)
      (Ideal.Quotient.mk J (MvPolynomial.rename Sum.inl (π i)))) ^ (8 * c) = 0 := by
    intro i
    have hmem : (MvPolynomial.rename Sum.inl (π i) * MvPolynomial.X (Sum.inr i) :
        MvPolynomial (Fin m ⊕ Fin d) k) ^ (8 * c) ∈ J := by
      rw [mul_comm 8 c, pow_mul, ← hJ]
      exact Ideal.subset_span ⟨i, rfl⟩
    have h0 : algebraMap (MvPolynomial (Fin m ⊕ Fin d) k ⧸ J) (Localization M)
        (Ideal.Quotient.mk J ((MvPolynomial.rename Sum.inl (π i) * MvPolynomial.X (Sum.inr i) :
          MvPolynomial (Fin m ⊕ Fin d) k) ^ (8 * c))) = 0 := by
      rw [Ideal.Quotient.eq_zero_iff_mem.mpr hmem, map_zero]
    rw [map_pow, map_mul, map_pow, map_mul, mul_pow] at h0
    have hb : IsUnit ((algebraMap (MvPolynomial (Fin m ⊕ Fin d) k ⧸ J) (Localization M)
        (Ideal.Quotient.mk J (MvPolynomial.X (Sum.inr i)))) ^ (8 * c)) :=
      (IsLocalization.map_units (Localization M) (⟨_, hB2 i⟩ : M)).pow _
    exact (IsUnit.mul_left_eq_zero hb).mp h0
  obtain ⟨κ₁, hκ₁⟩ : ∃ κ₁ : (Localization.AtPrime (𝔮.comap φ'.toRingHom) ⧸
      IsLocalRing.maximalIdeal (Localization.AtPrime (𝔮.comap φ'.toRingHom)) ^ n) →+*
        Localization M, ∀ q, κ₁ (Ideal.Quotient.mk _ (algebraMap (MvPolynomial (Fin m) k)
          (Localization.AtPrime (𝔮.comap φ'.toRingHom)) q)) =
        algebraMap (MvPolynomial (Fin m ⊕ Fin d) k ⧸ J) (Localization M)
          (Ideal.Quotient.mk J (MvPolynomial.rename Sum.inl q)) := by
    let g' := IsLocalization.lift (M := (𝔮.comap φ'.toRingHom).primeCompl)
      (S := Localization.AtPrime (𝔮.comap φ'.toRingHom)) hgu
    have hg' : ∀ q, g' (algebraMap (MvPolynomial (Fin m) k)
        (Localization.AtPrime (𝔮.comap φ'.toRingHom)) q) =
        algebraMap (MvPolynomial (Fin m ⊕ Fin d) k ⧸ J) (Localization M)
          (Ideal.Quotient.mk J (MvPolynomial.rename Sum.inl q)) :=
      fun q => IsLocalization.lift_eq hgu q
    have hker : IsLocalRing.maximalIdeal (Localization.AtPrime (𝔮.comap φ'.toRingHom)) ^ n ≤
        RingHom.ker g' := by
      refine le_trans hpow ?_
      rw [Ideal.span_le]
      rintro _ ⟨i, rfl⟩
      rw [SetLike.mem_coe, RingHom.mem_ker, map_pow, hg']
      exact hzero i
    exact ⟨Ideal.Quotient.lift _ g' (fun a ha => RingHom.mem_ker.mp (hker ha)), fun q => by
      rw [Ideal.Quotient.lift_mk, hg']⟩
  obtain ⟨κ, hκC, hκX⟩ : ∃ κ : MvPolynomial (Fin d)
      (Localization.AtPrime (𝔮.comap φ'.toRingHom) ⧸
        IsLocalRing.maximalIdeal (Localization.AtPrime (𝔮.comap φ'.toRingHom)) ^ n) →+*
        Localization M, (∀ p, κ (MvPolynomial.C p) = κ₁ p) ∧
        ∀ i, κ (MvPolynomial.X i) = algebraMap (MvPolynomial (Fin m ⊕ Fin d) k ⧸ J)
          (Localization M) (Ideal.Quotient.mk J (MvPolynomial.X (Sum.inr i))) :=
    ⟨MvPolynomial.eval₂Hom κ₁ _, fun p => MvPolynomial.eval₂Hom_C _ _ p,
      fun i => MvPolynomial.eval₂Hom_X' _ _ i⟩
  obtain ⟨θ, hθC, hθl, hθr⟩ : ∃ θ : MvPolynomial (Fin m ⊕ Fin d) k →+*
      MvPolynomial (Fin d) (Localization.AtPrime (𝔮.comap φ'.toRingHom) ⧸
        IsLocalRing.maximalIdeal (Localization.AtPrime (𝔮.comap φ'.toRingHom)) ^ n),
      (∀ a : k, θ (MvPolynomial.C a) = MvPolynomial.C (Ideal.Quotient.mk _
        (algebraMap (MvPolynomial (Fin m) k) (Localization.AtPrime (𝔮.comap φ'.toRingHom))
          (MvPolynomial.C a)))) ∧
      (∀ j, θ (MvPolynomial.X (Sum.inl j)) = MvPolynomial.C (Ideal.Quotient.mk _
        (algebraMap (MvPolynomial (Fin m) k) (Localization.AtPrime (𝔮.comap φ'.toRingHom))
          (MvPolynomial.X j)))) ∧
      ∀ i, θ (MvPolynomial.X (Sum.inr i)) = MvPolynomial.X i :=
    ⟨MvPolynomial.eval₂Hom ((MvPolynomial.C).comp ((Ideal.Quotient.mk _).comp
        ((algebraMap (MvPolynomial (Fin m) k) (Localization.AtPrime (𝔮.comap φ'.toRingHom))).comp
          MvPolynomial.C)))
      (Sum.elim (fun j => MvPolynomial.C (Ideal.Quotient.mk _
        (algebraMap (MvPolynomial (Fin m) k) (Localization.AtPrime (𝔮.comap φ'.toRingHom))
          (MvPolynomial.X j)))) MvPolynomial.X),
      fun a => by rw [MvPolynomial.eval₂Hom_C]; rfl,
      fun j => by rw [MvPolynomial.eval₂Hom_X']; rfl,
      fun i => by rw [MvPolynomial.eval₂Hom_X']; rfl⟩
  have hκθ : κ.comp θ = (algebraMap (MvPolynomial (Fin m ⊕ Fin d) k ⧸ J) (Localization M)).comp
      (Ideal.Quotient.mk J) := by
    apply MvPolynomial.ringHom_ext
    · intro a
      simp only [RingHom.comp_apply]
      rw [hθC, hκC, hκ₁, MvPolynomial.rename_C]
    · rintro (j | i)
      · simp only [RingHom.comp_apply]
        rw [hθl, hκC, hκ₁, MvPolynomial.rename_X]
      · simp only [RingHom.comp_apply]
        rw [hθr, hκX]

  have H2 : ρ.comp (v.comp ((algebraMap S (Localization.AtPrime 𝔪)).comp
      (@algebraMap _ _ _ _ iS))) = lam₀.comp κ₁ := by
    apply Ideal.Quotient.ringHom_ext
    apply IsLocalization.ringHom_ext (𝔮.comap φ'.toRingHom).primeCompl
    refine RingHom.ext fun q => ?_
    simp only [RingHom.comp_apply]
    rw [hv, Localization.localRingHom_to_map, hρ, hκ₁, hlam, hR0L, hren]
    rfl
  have hτ' : (ρ.comp (MvPolynomial.eval₂Hom v (fun i => Ideal.Quotient.mk
      (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) ^ n)
        (algebraMap Λ (Localization.AtPrime 𝔮) (δ i))))).comp
      ((MvPolynomial.map (algebraMap S (Localization.AtPrime 𝔪))).comp
        (MvPolynomial.map (@algebraMap _ _ _ _ iS))) = lam₀.comp κ := by
    apply MvPolynomial.ringHom_ext
    · intro p
      simp only [RingHom.comp_apply, MvPolynomial.map_C, MvPolynomial.eval₂Hom_C, hκC]
      exact RingHom.congr_fun H2 p
    · intro i
      simp only [RingHom.comp_apply, MvPolynomial.map_X, MvPolynomial.eval₂Hom_X', hκX, hlam,
        hR0L, hRXr]
      exact hρ (δ i)
  have hΦ : ∀ a : A', (ρ.comp (MvPolynomial.eval₂Hom v (fun i => Ideal.Quotient.mk
      (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) ^ n)
        (algebraMap Λ (Localization.AtPrime 𝔮) (δ i))))) (χD a) =
      ((IsScalarTower.toAlgHom (MvPolynomial (Fin m ⊕ Fin d) k ⧸ J) (Λ ⧸ I)
        (Localization.AtPrime (𝔮.map (Ideal.Quotient.mk I)))).comp φbar)
        (Ideal.Quotient.mk _ a) := by
    intro a
    rw [RingHom.comp_apply, MvPolynomial.coe_eval₂Hom, hcompat, hρ, AlgHom.comp_apply,
      IsScalarTower.toAlgHom_apply, hφbar]


  obtain ⟨Csm, iC1, iC2, iC3, ψ, γ, hγψ⟩ := core (MvPolynomial (Fin m ⊕ Fin d) k) J M
    (Localization.AtPrime (𝔮.map (Ideal.Quotient.mk I))) lam₀ hlam A'
    (Localization.AtPrime (𝔮.comap φ'.toRingHom) ⧸
      IsLocalRing.maximalIdeal (Localization.AtPrime (𝔮.comap φ'.toRingHom)) ^ n) S
    (Localization.AtPrime 𝔪) 𝔪.primeCompl d θ κ hκθ χD (by
      apply MvPolynomial.ringHom_ext
      · intro a
        exact (hχk a).trans (by rw [RingHom.comp_apply, RingHom.comp_apply, hθC,
          MvPolynomial.map_C, MvPolynomial.map_C])
      · rintro (j | i)
        · exact (hχy j).trans (by rw [RingHom.comp_apply, RingHom.comp_apply, hθl,
            MvPolynomial.map_C, MvPolynomial.map_C])
        · exact (hχt i).trans (by rw [RingHom.comp_apply, RingHom.comp_apply, hθr,
            MvPolynomial.map_X, MvPolynomial.map_X]))
    (ρ.comp (MvPolynomial.eval₂Hom v (fun i => Ideal.Quotient.mk
      (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) ^ n)
        (algebraMap Λ (Localization.AtPrime 𝔮) (δ i))))) hτ'
    ((IsScalarTower.toAlgHom (MvPolynomial (Fin m ⊕ Fin d) k ⧸ J) (Λ ⧸ I)
        (Localization.AtPrime (𝔮.map (Ideal.Quotient.mk I)))).comp φbar) hΦ
  exact ⟨Csm, iC1, iC2, iC3, ψ, γ, hγψ⟩

theorem wc_pfc_p_reduction_datum : (∀ (k : Type u) [Field k] (p : ℕ) [Fact p.Prime] [CharP k p] (Λ : Type u) [CommRing Λ] [IsNoetherianRing Λ] [Algebra k Λ], (∀ (L : Type u) [Field L] [Algebra k L] [FiniteDimensional k L] (𝔔 : Ideal (TensorProduct k L Λ)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) → ∀ (𝔮 : Ideal Λ) [𝔮.IsPrime] (n : ℕ), 1 ≤ n → ∀ (E : Finset (Localization.AtPrime 𝔮 ⧸ IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) ^ n)), ∃ (m : ℕ) (φ' : MvPolynomial (Fin m) k →ₐ[k] Λ), RingHom.Flat (Localization.localRingHom (𝔮.comap φ'.toRingHom) 𝔮 φ'.toRingHom rfl) ∧ Ideal.map (Localization.localRingHom (𝔮.comap φ'.toRingHom) 𝔮 φ'.toRingHom rfl) (IsLocalRing.maximalIdeal (Localization.AtPrime (𝔮.comap φ'.toRingHom))) = IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) ∧ ∃ (S : Type u) (_ : CommRing S) (iS : Algebra (Localization.AtPrime (𝔮.comap φ'.toRingHom) ⧸ IsLocalRing.maximalIdeal (Localization.AtPrime (𝔮.comap φ'.toRingHom)) ^ n) S) (_ : Algebra.Smooth (Localization.AtPrime (𝔮.comap φ'.toRingHom) ⧸ IsLocalRing.maximalIdeal (Localization.AtPrime (𝔮.comap φ'.toRingHom)) ^ n) S) (𝔪 : Ideal S) (_ : 𝔪.IsPrime) (v : Localization.AtPrime 𝔪 →+* Localization.AtPrime 𝔮 ⧸ IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) ^ n), RingHom.Flat v ∧ IsLocalHom v ∧ IsArtinianRing (Localization.AtPrime 𝔪) ∧ (∀ x : Localization.AtPrime (𝔮.comap φ'.toRingHom), v (algebraMap S (Localization.AtPrime 𝔪) (@algebraMap _ _ _ _ iS (Ideal.Quotient.mk (IsLocalRing.maximalIdeal (Localization.AtPrime (𝔮.comap φ'.toRingHom)) ^ n) x))) = Ideal.Quotient.mk (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) ^ n) (Localization.localRingHom (𝔮.comap φ'.toRingHom) 𝔮 φ'.toRingHom rfl x)) ∧ ∀ e ∈ E, e ∈ v.range) → (∀ (k : Type u) [Field k] (A : Type u) [CommRing A] [Algebra k A] [Algebra.FinitePresentation k A] (t N d : ℕ) (a : Fin t → A), (∀ j, Algebra.Smooth k (Localization.Away (a j))) → ∃ (C : Type u) (_ : CommRing C) (_ : Algebra (MvPolynomial (Fin d) k) C) (_ : Algebra k C) (_ : IsScalarTower k (MvPolynomial (Fin d) k) C) (_ : Algebra.FinitePresentation (MvPolynomial (Fin d) k) C) (ι : A →ₐ[k] C) (c : ℕ), 1 ≤ c ∧ (∀ j, Algebra.Smooth (MvPolynomial (Fin d) k) (Localization.Away (ι (a j)))) ∧ (∀ i, wcPfcStrictStd (MvPolynomial (Fin d) k) C (algebraMap (MvPolynomial (Fin d) k) C (MvPolynomial.X i ^ c))) ∧ ∀ (Λ : Type u) [CommRing Λ] [Algebra k Λ] [Algebra (MvPolynomial (Fin d) k) Λ] [IsScalarTower k (MvPolynomial (Fin d) k) Λ] (φ : A →ₐ[k] Λ) (μ : Fin d → Fin t → Λ), (∀ i, algebraMap (MvPolynomial (Fin d) k) Λ (MvPolynomial.X i) ^ (2 * N) = ∑ j, μ i j * φ (a j)) → ∃ χ : C →ₐ[MvPolynomial (Fin d) k] Λ, ∀ x, χ (ι x) = φ x) → ∀ (k : Type u) [Field k] (p : ℕ) [Fact p.Prime] [CharP k p] (Λ : Type u) [CommRing Λ] [IsNoetherianRing Λ] [Algebra k Λ], (∀ (L : Type u) [Field L] [Algebra k L] [FiniteDimensional k L] (𝔔 : Ideal (TensorProduct k L Λ)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) → ∀ (A : Type u) [CommRing A] [Algebra k A] [Algebra.FinitePresentation k A] (φ : A →ₐ[k] Λ) (𝔮 : Ideal Λ), 𝔮 ∈ (Ideal.span (φ '' {a : A | Algebra.Smooth k (Localization.Away a)})).minimalPrimes → ∃ (R : Type u) (_ : CommRing R) (_ : IsNoetherianRing R) (_ : Algebra k R) (_ : Algebra.Smooth k R) (_ : Algebra R Λ) (_ : IsScalarTower k R Λ) (A' : Type u) (_ : CommRing A') (_ : Algebra R A') (_ : Algebra k A') (_ : IsScalarTower k R A') (_ : Algebra.FinitePresentation R A') (ψ₀ : A →ₐ[k] A') (χ₀ : A' →ₐ[R] Λ) (r : ℕ) (π : Fin r → R), (χ₀.restrictScalars k).comp ψ₀ = φ ∧ (Ideal.span (φ '' {a : A | Algebra.Smooth k (Localization.Away a)})).radical ≤ (Ideal.span (χ₀ '' {b : A' | Algebra.Smooth R (Localization.Away b)})).radical ∧ (∀ i, algebraMap R Λ (π i) ∈ 𝔮) ∧ wcPfcAnnSeq π ∧ wcPfcAnnSeq (fun i => algebraMap R Λ (π i)) ∧ (∀ i, wcPfcStrictStd R A' (algebraMap R A' (π i))) ∧ ∃ (_ : Algebra.FinitePresentation (R ⧸ wcPfcPowIdeal π) (A' ⧸ Ideal.map (algebraMap R A') (wcPfcPowIdeal π))) (φbar : (A' ⧸ Ideal.map (algebraMap R A') (wcPfcPowIdeal π)) →ₐ[R ⧸ wcPfcPowIdeal π] (Λ ⧸ Ideal.map (algebraMap R Λ) (wcPfcPowIdeal π))), (∀ a : A', φbar (Ideal.Quotient.mk _ a) = Ideal.Quotient.mk _ (χ₀ a)) ∧ ∃ (_ : (𝔮.map (Ideal.Quotient.mk (Ideal.map (algebraMap R Λ) (wcPfcPowIdeal π)))).IsPrime), 𝔮.map (Ideal.Quotient.mk (Ideal.map (algebraMap R Λ) (wcPfcPowIdeal π))) ∈ minimalPrimes (Λ ⧸ Ideal.map (algebraMap R Λ) (wcPfcPowIdeal π)) ∧ ∃ (C : Type u) (_ : CommRing C) (_ : Algebra (R ⧸ wcPfcPowIdeal π) C) (_ : Algebra.Smooth (R ⧸ wcPfcPowIdeal π) C) (ψ : (A' ⧸ Ideal.map (algebraMap R A') (wcPfcPowIdeal π)) →ₐ[R ⧸ wcPfcPowIdeal π] C) (γ : C →ₐ[R ⧸ wcPfcPowIdeal π] Localization.AtPrime (𝔮.map (Ideal.Quotient.mk (Ideal.map (algebraMap R Λ) (wcPfcPowIdeal π))))), γ.comp ψ = (IsScalarTower.toAlgHom (R ⧸ wcPfcPowIdeal π) (Λ ⧸ Ideal.map (algebraMap R Λ) (wcPfcPowIdeal π)) (Localization.AtPrime (𝔮.map (Ideal.Quotient.mk (Ideal.map (algebraMap R Λ) (wcPfcPowIdeal π)))))).comp φbar :=
by
  intro H3 H2 k _ p _ _ Λ _ _ _ hreg A _ _ _ φ 𝔮 h𝔮
  classical
  haveI h𝔮p : 𝔮.IsPrime := h𝔮.1.1
  haveI hRL : IsRegularLocalRing (Localization.AtPrime 𝔮) := wc_pfc_cz_localization_regular k Λ hreg 𝔮
  obtain ⟨d, hd⟩ : ∃ d, Submodule.spanFinrank
      (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮)) = d := ⟨_, rfl⟩
  obtain ⟨t, a, ha, h𝔥⟩ := wc_pfc_cz_smooth_locus_fg k A Λ φ
  obtain ⟨N₀, hN₀⟩ := wc_pfc_cz_minimal_prime_power Λ _ 𝔮 h𝔮
  obtain ⟨N, hNdef⟩ : ∃ N, N = N₀ + 1 := ⟨_, rfl⟩
  have hNpos : 0 < N := by omega
  have hN : Ideal.map (algebraMap Λ (Localization.AtPrime 𝔮)) (𝔮 ^ N) ≤
      Ideal.map (algebraMap Λ (Localization.AtPrime 𝔮)) (Ideal.span (Set.range fun j => φ (a j))) := by
    rw [← h𝔥]
    exact le_trans (Ideal.map_mono (Ideal.pow_le_pow_right (by omega))) hN₀
  obtain ⟨C, _, _, _, _, _, ι, c, hc, hsm, hss, huniv⟩ := H2 k A t N d a ha
  obtain ⟨n, hn⟩ : ∃ n, n = N + d * (8 * c) + 1 := ⟨_, rfl⟩
  obtain ⟨s, hs⟩ := (Algebra.FiniteType.out : (⊤ : Subalgebra k A).FG)
  let T₀ : Finset (Localization.AtPrime 𝔮 ⧸ IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) ^ n) :=
    (s.image fun x => Ideal.Quotient.mk _ (algebraMap Λ _ (φ x))) ∪
      (Finset.univ.image fun j => Ideal.Quotient.mk _ (algebraMap Λ _ (φ (a j))))

  obtain ⟨m, φ', hflat, hgen, S, _, iS, _, 𝔪, _, v, hvflat, hvloc, -, hvcomp, hvT₀⟩ :=
    H3 k p Λ hreg 𝔮 n (by omega) T₀
  obtain ⟨π, hπ𝔭, hπgen, hπann⟩ :=
    wc_pfc_pd_param_choice k Λ 𝔮 m d (8 * c) φ' (by omega) hd hflat hgen

  let σ : MvPolynomial (Fin m) k →+* Localization.AtPrime 𝔪 :=
    { toFun := fun q => algebraMap S (Localization.AtPrime 𝔪) (@algebraMap _ _ _ _ iS
        (Ideal.Quotient.mk (IsLocalRing.maximalIdeal
          (Localization.AtPrime (𝔮.comap φ'.toRingHom)) ^ n)
          (algebraMap (MvPolynomial (Fin m) k) (Localization.AtPrime (𝔮.comap φ'.toRingHom)) q)))
      map_one' := by simp only [map_one]
      map_mul' := fun x y => by simp only [map_mul]
      map_zero' := by simp only [map_zero]
      map_add' := fun x y => by simp only [map_add] }
  have hσv : ∀ q, v (σ q) = Ideal.Quotient.mk _ (algebraMap Λ (Localization.AtPrime 𝔮) (φ' q)) := by
    intro q
    have h := hvcomp (algebraMap (MvPolynomial (Fin m) k) _ q)
    rw [Localization.localRingHom_to_map] at h
    exact h

  have hαv : ∀ j, Ideal.Quotient.mk (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) ^ n)
      (algebraMap Λ (Localization.AtPrime 𝔮) (φ (a j))) ∈ v.range := fun j =>
    hvT₀ _ (Finset.mem_union_right _ (Finset.mem_image_of_mem _ (Finset.mem_univ j)))
  have h𝔪N : IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) ^ N ≤
      Ideal.span (Set.range fun j => algebraMap Λ (Localization.AtPrime 𝔮) (φ (a j))) := by
    have e1 : IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) ^ N =
        Ideal.map (algebraMap Λ (Localization.AtPrime 𝔮)) (𝔮 ^ N) := by
      rw [Ideal.map_pow, Localization.AtPrime.map_eq_maximalIdeal]
    have e2 : Ideal.span (Set.range fun j => algebraMap Λ (Localization.AtPrime 𝔮) (φ (a j))) =
        Ideal.map (algebraMap Λ (Localization.AtPrime 𝔮)) (Ideal.span (Set.range fun j => φ (a j))) := by
      rw [Ideal.map_span, ← Set.range_comp]
      rfl
    rw [e1, e2]
    exact hN
  have hux : ∀ i, algebraMap Λ (Localization.AtPrime 𝔮) (φ' (π i)) ∈
      IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) := fun i =>
    (IsLocalization.AtPrime.to_map_mem_maximal_iff _ 𝔮 _).mpr (hπ𝔭 i)
  have huv : ∀ i, Ideal.Quotient.mk (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) ^ n)
      (algebraMap Λ (Localization.AtPrime 𝔮) (φ' (π i))) ∈ v.range := fun i =>
    ⟨σ (π i), hσv (π i)⟩

  obtain ⟨δ, lam, hδ, hP⟩ := wc_pfc_pd_twist_loop Λ 𝔮 d t
    (fun i δ x l => (x * φ' (π i)) ^ (2 * N) = ∑ j, l j * φ (a j) ∧
      (∀ j, ∃ l' : Localization.AtPrime 𝔪, v l' * Ideal.Quotient.mk
          (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) ^ n)
          (algebraMap Λ (Localization.AtPrime 𝔮) x) ^ (2 * N) =
        Ideal.Quotient.mk (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) ^ n)
          (algebraMap Λ (Localization.AtPrime 𝔮) (l j))) ∧
      ∀ y, (x * φ' (π i)) ^ 2 * y ∈ Ideal.span ((fun j => (δ j * φ' (π j)) ^ (8 * c)) '' {j | j < i}) →
        x * φ' (π i) * y ∈ Ideal.span ((fun j => (δ j * φ' (π j)) ^ (8 * c)) '' {j | j < i}))
    (by
      intro i δ δ' x l hδδ' hPi
      obtain ⟨h1, h2, h3⟩ := hPi
      have hJ : ((fun j => (δ j * φ' (π j)) ^ (8 * c)) '' {j | j < i}) =
          ((fun j => (δ' j * φ' (π j)) ^ (8 * c)) '' {j | j < i}) :=
        Set.image_congr (fun j hj => by simp only [hδδ' j hj])
      refine ⟨h1, h2, ?_⟩
      intro y hy
      rw [← hJ] at hy ⊢
      exact h3 y hy)
    (by
      intro i δ hδ
      obtain ⟨w, hw, hwv⟩ := wc_pfc_pd_coeff_descent (Localization.AtPrime 𝔮)
        (Localization.AtPrime 𝔪) n N t v hvflat hvloc (by omega)
        (fun j => algebraMap Λ (Localization.AtPrime 𝔮) (φ (a j))) h𝔪N hαv
        (algebraMap Λ (Localization.AtPrime 𝔮) (φ' (π i))) (hux i) (huv i)
      choose dd hdd using hwv
      obtain ⟨δ₀, lam₀, hδ₀, hrel₀, hratio₀⟩ := wc_pfc_pd_clear_denominators Λ 𝔮 N t (φ' (π i))
        (fun j => φ (a j)) w hNpos hw
      have hog : ∀ y : Λ, (δ₀ * φ' (π i)) ^ 2 * y ∈
          Ideal.span ((fun j => (δ j * φ' (π j)) ^ (8 * c)) '' {j | j < i}) →
          ∃ σ' : Λ, σ' ∉ 𝔮 ∧ σ' * (δ₀ * φ' (π i)) * y ∈
            Ideal.span ((fun j => (δ j * φ' (π j)) ^ (8 * c)) '' {j | j < i}) := by
        intro y hy
        have hy' : φ' (π i) * (δ₀ ^ 2 * φ' (π i) * y) ∈
            Ideal.span ((fun j => (δ j * φ' (π j)) ^ (8 * c)) '' {j | j < i}) := by
          have e : φ' (π i) * (δ₀ ^ 2 * φ' (π i) * y) = (δ₀ * φ' (π i)) ^ 2 * y := by ring
          rw [e]
          exact hy
        obtain ⟨σ', hσ', hσ'y⟩ := wc_pfc_pd_regseq_localized Λ 𝔮 d (8 * c)
          (fun j => φ' (π j)) δ hd hπgen hδ i _ hy'
        refine ⟨σ' * δ₀, h𝔮p.mul_notMem hσ' hδ₀, ?_⟩
        have e : σ' * δ₀ * (δ₀ * φ' (π i)) * y = σ' * (δ₀ ^ 2 * φ' (π i) * y) := by ring
        rw [e]
        exact hσ'y
      obtain ⟨s', hs', hs'ann⟩ := wc_pfc_pd_ogoma_multiplier Λ 𝔮 _ (δ₀ * φ' (π i)) hog
      refine ⟨s' * δ₀, fun j => s' ^ (2 * N) * lam₀ j, h𝔮p.mul_notMem hs' hδ₀, ?_, ?_, ?_⟩
      · show (s' * δ₀ * φ' (π i)) ^ (2 * N) = ∑ j, s' ^ (2 * N) * lam₀ j * φ (a j)
        rw [show s' * δ₀ * φ' (π i) = s' * (δ₀ * φ' (π i)) by ring, mul_pow, hrel₀, Finset.mul_sum]
        exact Finset.sum_congr rfl fun j _ => by ring
      · intro j
        refine ⟨dd j, ?_⟩
        show v (dd j) * Ideal.Quotient.mk (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) ^ n)
            (algebraMap Λ (Localization.AtPrime 𝔮) (s' * δ₀)) ^ (2 * N) =
          Ideal.Quotient.mk (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) ^ n)
            (algebraMap Λ (Localization.AtPrime 𝔮) (s' ^ (2 * N) * lam₀ j))
        rw [hdd j, map_mul (algebraMap Λ (Localization.AtPrime 𝔮)) (s' ^ (2 * N)) (lam₀ j),
          hratio₀ j]
        simp only [map_mul, map_pow]
        ring
      · intro y hy
        rw [show s' * δ₀ * φ' (π i) = s' * (δ₀ * φ' (π i)) by ring] at hy ⊢
        exact hs'ann y hy)
  have hrel : ∀ i, (δ i * φ' (π i)) ^ (2 * N) = ∑ j, lam i j * φ (a j) := fun i => (hP i).1
  choose l' hl' using fun i j => (hP i).2.1 j
  have hannΛ : ∀ (i : Fin d) (y : Λ), (δ i * φ' (π i)) ^ 2 * y ∈
      Ideal.span ((fun j => (δ j * φ' (π j)) ^ (8 * c)) '' {j | j < i}) →
      δ i * φ' (π i) * y ∈ Ideal.span ((fun j => (δ j * φ' (π j)) ^ (8 * c)) '' {j | j < i}) :=
    fun i y h => (hP i).2.2 y h

  obtain ⟨χΛ, χD, hχΛι, hχΛX, hχDX, hχDk, hχcompat⟩ :=
    wc_pfc_pd_fibre_lift_ratio k Λ 𝔮 m n d t N φ' S 𝔪 v hvflat hvloc hvcomp π δ A φ s a lam hs
      (fun x hx => hvT₀ _ (Finset.mem_union_left _ (Finset.mem_image_of_mem _ hx)))
      hδ l' hl' hrel C ι huniv

  letI iRΛ : Algebra (MvPolynomial (Fin m ⊕ Fin d) k) Λ :=
    (MvPolynomial.aeval (Sum.elim (fun j => φ' (MvPolynomial.X j)) δ)).toRingHom.toAlgebra
  haveI : IsScalarTower k (MvPolynomial (Fin m ⊕ Fin d) k) Λ := IsScalarTower.of_algebraMap_eq
    (fun x => ((MvPolynomial.aeval (Sum.elim (fun j => φ' (MvPolynomial.X j)) δ)).commutes x).symm)
  have hRX : ∀ x : Fin m ⊕ Fin d, algebraMap (MvPolynomial (Fin m ⊕ Fin d) k) Λ (MvPolynomial.X x) =
      Sum.elim (fun j => φ' (MvPolynomial.X j)) δ x := fun x => MvPolynomial.aeval_X _ x
  have hRren : ∀ q, algebraMap (MvPolynomial (Fin m ⊕ Fin d) k) Λ (MvPolynomial.rename Sum.inl q) =
      φ' q := by
    intro q
    show MvPolynomial.aeval (Sum.elim (fun j => φ' (MvPolynomial.X j)) δ)
      (MvPolynomial.rename Sum.inl q) = φ' q
    rw [MvPolynomial.aeval_rename]
    conv_rhs => rw [MvPolynomial.aeval_unique φ']
    rfl
  have hγ : ∀ i, algebraMap (MvPolynomial (Fin m ⊕ Fin d) k) Λ
      (MvPolynomial.rename Sum.inl (π i) * MvPolynomial.X (Sum.inr i)) = δ i * φ' (π i) := by
    intro i
    rw [map_mul, hRren, hRX]
    exact mul_comm _ _
  letI iPR : Algebra (MvPolynomial (Fin d) k) (MvPolynomial (Fin m ⊕ Fin d) k) :=
    (MvPolynomial.aeval (fun i => (MvPolynomial.rename Sum.inl (π i) * MvPolynomial.X (Sum.inr i) :
      MvPolynomial (Fin m ⊕ Fin d) k))).toRingHom.toAlgebra
  haveI : IsScalarTower k (MvPolynomial (Fin d) k) (MvPolynomial (Fin m ⊕ Fin d) k) :=
    IsScalarTower.of_algebraMap_eq (fun x => ((MvPolynomial.aeval (fun i =>
      (MvPolynomial.rename Sum.inl (π i) * MvPolynomial.X (Sum.inr i) :
        MvPolynomial (Fin m ⊕ Fin d) k))).commutes x).symm)
  have hPR : ∀ i, algebraMap (MvPolynomial (Fin d) k) (MvPolynomial (Fin m ⊕ Fin d) k)
      (MvPolynomial.X i) = MvPolynomial.rename Sum.inl (π i) * MvPolynomial.X (Sum.inr i) :=
    fun i => MvPolynomial.aeval_X _ i
  letI iPΛ : Algebra (MvPolynomial (Fin d) k) Λ :=
    ((algebraMap (MvPolynomial (Fin m ⊕ Fin d) k) Λ).comp
      (algebraMap (MvPolynomial (Fin d) k) (MvPolynomial (Fin m ⊕ Fin d) k))).toAlgebra
  haveI : IsScalarTower (MvPolynomial (Fin d) k) (MvPolynomial (Fin m ⊕ Fin d) k) Λ :=
    IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  haveI : IsScalarTower k (MvPolynomial (Fin d) k) Λ := IsScalarTower.of_algebraMap_eq (fun x => by
    show algebraMap k Λ x = algebraMap (MvPolynomial (Fin m ⊕ Fin d) k) Λ
      (algebraMap (MvPolynomial (Fin d) k) (MvPolynomial (Fin m ⊕ Fin d) k)
        (algebraMap k (MvPolynomial (Fin d) k) x))
    rw [← IsScalarTower.algebraMap_apply k (MvPolynomial (Fin d) k) (MvPolynomial (Fin m ⊕ Fin d) k),
      ← IsScalarTower.algebraMap_apply k (MvPolynomial (Fin m ⊕ Fin d) k) Λ])
  have hPΛ : ∀ i, algebraMap (MvPolynomial (Fin d) k) Λ (MvPolynomial.X i) = δ i * φ' (π i) := by
    intro i
    show algebraMap (MvPolynomial (Fin m ⊕ Fin d) k) Λ
      (algebraMap (MvPolynomial (Fin d) k) (MvPolynomial (Fin m ⊕ Fin d) k) (MvPolynomial.X i)) = _
    rw [hPR, hγ]
  have hχΛP : (χΛ : C →+* Λ).comp (algebraMap (MvPolynomial (Fin d) k) C) =
      algebraMap (MvPolynomial (Fin d) k) Λ := by
    apply MvPolynomial.ringHom_ext
    · intro r
      show χΛ (algebraMap (MvPolynomial (Fin d) k) C (algebraMap k (MvPolynomial (Fin d) k) r)) =
        algebraMap (MvPolynomial (Fin d) k) Λ (algebraMap k (MvPolynomial (Fin d) k) r)
      rw [← IsScalarTower.algebraMap_apply, ← IsScalarTower.algebraMap_apply, AlgHom.commutes]
    · intro i
      show χΛ (algebraMap (MvPolynomial (Fin d) k) C (MvPolynomial.X i)) = _
      rw [hχΛX, hPΛ]
  let χC : C →ₐ[MvPolynomial (Fin d) k] Λ := ⟨(χΛ : C →+* Λ), fun x => RingHom.congr_fun hχΛP x⟩

  let ψ₀ : A →ₐ[k] TensorProduct (MvPolynomial (Fin d) k) (MvPolynomial (Fin m ⊕ Fin d) k) C :=
    { toRingHom := (Algebra.TensorProduct.includeRight : C →ₐ[MvPolynomial (Fin d) k]
          TensorProduct (MvPolynomial (Fin d) k) (MvPolynomial (Fin m ⊕ Fin d) k) C).toRingHom.comp
        ι.toRingHom
      commutes' := fun x => by
        show Algebra.TensorProduct.includeRight (ι (algebraMap k A x)) = algebraMap k _ x
        rw [IsScalarTower.algebraMap_apply k (MvPolynomial (Fin m ⊕ Fin d) k)
            (TensorProduct (MvPolynomial (Fin d) k) (MvPolynomial (Fin m ⊕ Fin d) k) C),
          AlgHom.commutes, IsScalarTower.algebraMap_apply k (MvPolynomial (Fin d) k) C,
          AlgHom.commutes,
          IsScalarTower.algebraMap_apply k (MvPolynomial (Fin d) k) (MvPolynomial (Fin m ⊕ Fin d) k),
          IsScalarTower.algebraMap_apply (MvPolynomial (Fin d) k) (MvPolynomial (Fin m ⊕ Fin d) k)
            (TensorProduct (MvPolynomial (Fin d) k) (MvPolynomial (Fin m ⊕ Fin d) k) C)] }
  let χ₀ : TensorProduct (MvPolynomial (Fin d) k) (MvPolynomial (Fin m ⊕ Fin d) k) C →ₐ[MvPolynomial (Fin m ⊕ Fin d) k] Λ :=
    Algebra.TensorProduct.lift (Algebra.ofId (MvPolynomial (Fin m ⊕ Fin d) k) Λ) χC
      (fun _ _ => Commute.all _ _)
  have hχ₀tmul : ∀ (r : MvPolynomial (Fin m ⊕ Fin d) k) (y : C),
      χ₀ (r ⊗ₜ[MvPolynomial (Fin d) k] y) = algebraMap (MvPolynomial (Fin m ⊕ Fin d) k) Λ r * χΛ y :=
    fun r y => Algebra.TensorProduct.lift_tmul _ _ _ r y
  have hχ₀ψ₀ : ∀ x, χ₀ (ψ₀ x) = φ x := by
    intro x
    show χ₀ (Algebra.TensorProduct.includeRight (ι x)) = φ x
    rw [Algebra.TensorProduct.includeRight_apply, hχ₀tmul, map_one, one_mul]
    exact hχΛι x
  have hrad : (Ideal.span (φ '' {a : A | Algebra.Smooth k (Localization.Away a)})).radical ≤
      (Ideal.span (χ₀ '' {b | Algebra.Smooth (MvPolynomial (Fin m ⊕ Fin d) k)
        (Localization.Away b)})).radical := by
    apply Ideal.radical_mono
    rw [h𝔥, Ideal.span_le]
    rintro _ ⟨j, rfl⟩
    exact Ideal.subset_span ⟨ψ₀ (a j),
      wc_pfc_pd_smooth_away_base_change (MvPolynomial (Fin d) k) C (MvPolynomial (Fin m ⊕ Fin d) k)
        (ι (a j)) (hsm j), hχ₀ψ₀ (a j)⟩

  have hπ𝔮 : ∀ i, algebraMap (MvPolynomial (Fin m ⊕ Fin d) k) Λ
      ((MvPolynomial.rename Sum.inl (π i) * MvPolynomial.X (Sum.inr i) :
        MvPolynomial (Fin m ⊕ Fin d) k) ^ c) ∈ 𝔮 := by
    intro i
    rw [map_pow, hγ]
    exact Ideal.pow_mem_of_mem 𝔮 (Ideal.mul_mem_left _ _ (hπ𝔭 i)) c (by omega)
  have hannR := wc_pfc_pd_annseq_pow (MvPolynomial (Fin m ⊕ Fin d) k) d c
    (fun i => MvPolynomial.rename Sum.inl (π i) * MvPolynomial.X (Sum.inr i)) hc hπann
  have hannΛ' : wcPfcAnnSeq (fun i => algebraMap (MvPolynomial (Fin m ⊕ Fin d) k) Λ
      ((MvPolynomial.rename Sum.inl (π i) * MvPolynomial.X (Sum.inr i) :
        MvPolynomial (Fin m ⊕ Fin d) k) ^ c)) := by
    have e : (fun i => algebraMap (MvPolynomial (Fin m ⊕ Fin d) k) Λ
        ((MvPolynomial.rename Sum.inl (π i) * MvPolynomial.X (Sum.inr i) :
          MvPolynomial (Fin m ⊕ Fin d) k) ^ c)) = fun i => (δ i * φ' (π i)) ^ c :=
      funext fun i => by rw [map_pow, hγ]
    rw [e]
    exact wc_pfc_pd_annseq_pow Λ d c (fun i => δ i * φ' (π i)) hc hannΛ
  have hssR : ∀ i, wcPfcStrictStd (MvPolynomial (Fin m ⊕ Fin d) k)
      (TensorProduct (MvPolynomial (Fin d) k) (MvPolynomial (Fin m ⊕ Fin d) k) C)
      (algebraMap (MvPolynomial (Fin m ⊕ Fin d) k) _
        ((MvPolynomial.rename Sum.inl (π i) * MvPolynomial.X (Sum.inr i) :
          MvPolynomial (Fin m ⊕ Fin d) k) ^ c)) := by
    intro i
    have key : (Algebra.TensorProduct.includeRight : C →ₐ[MvPolynomial (Fin d) k]
          TensorProduct (MvPolynomial (Fin d) k) (MvPolynomial (Fin m ⊕ Fin d) k) C)
        (algebraMap (MvPolynomial (Fin d) k) C (MvPolynomial.X i ^ c)) =
        algebraMap (MvPolynomial (Fin m ⊕ Fin d) k) _
          ((MvPolynomial.rename Sum.inl (π i) * MvPolynomial.X (Sum.inr i) :
            MvPolynomial (Fin m ⊕ Fin d) k) ^ c) := by
      rw [AlgHom.commutes, IsScalarTower.algebraMap_apply (MvPolynomial (Fin d) k)
        (MvPolynomial (Fin m ⊕ Fin d) k)
        (TensorProduct (MvPolynomial (Fin d) k) (MvPolynomial (Fin m ⊕ Fin d) k) C), map_pow, hPR]
    have h := wc_pfc_pd_strict_std_base_change (MvPolynomial (Fin d) k) C
      (MvPolynomial (Fin m ⊕ Fin d) k) _ (hss i)
    rwa [key] at h

  have hJle : Ideal.map (algebraMap (MvPolynomial (Fin m ⊕ Fin d) k)
        (TensorProduct (MvPolynomial (Fin d) k) (MvPolynomial (Fin m ⊕ Fin d) k) C))
        (wcPfcPowIdeal (fun i => (MvPolynomial.rename Sum.inl (π i) * MvPolynomial.X (Sum.inr i) :
          MvPolynomial (Fin m ⊕ Fin d) k) ^ c)) ≤
      Ideal.comap (χ₀ : TensorProduct (MvPolynomial (Fin d) k) (MvPolynomial (Fin m ⊕ Fin d) k) C →+* Λ)
        (Ideal.map (algebraMap (MvPolynomial (Fin m ⊕ Fin d) k) Λ)
          (wcPfcPowIdeal (fun i => (MvPolynomial.rename Sum.inl (π i) * MvPolynomial.X (Sum.inr i) :
            MvPolynomial (Fin m ⊕ Fin d) k) ^ c))) := by
    rw [← Ideal.map_le_iff_le_comap, Ideal.map_map,
      show (χ₀ : TensorProduct (MvPolynomial (Fin d) k) (MvPolynomial (Fin m ⊕ Fin d) k) C →+* Λ).comp
        (algebraMap (MvPolynomial (Fin m ⊕ Fin d) k) _) =
        algebraMap (MvPolynomial (Fin m ⊕ Fin d) k) Λ from RingHom.ext fun x => χ₀.commutes x]
  let φbar : (TensorProduct (MvPolynomial (Fin d) k) (MvPolynomial (Fin m ⊕ Fin d) k) C ⧸
      Ideal.map (algebraMap (MvPolynomial (Fin m ⊕ Fin d) k) _)
        (wcPfcPowIdeal (fun i => (MvPolynomial.rename Sum.inl (π i) * MvPolynomial.X (Sum.inr i) :
          MvPolynomial (Fin m ⊕ Fin d) k) ^ c))) →ₐ[MvPolynomial (Fin m ⊕ Fin d) k ⧸
        wcPfcPowIdeal (fun i => (MvPolynomial.rename Sum.inl (π i) * MvPolynomial.X (Sum.inr i) :
          MvPolynomial (Fin m ⊕ Fin d) k) ^ c)]
      (Λ ⧸ Ideal.map (algebraMap (MvPolynomial (Fin m ⊕ Fin d) k) Λ)
        (wcPfcPowIdeal (fun i => (MvPolynomial.rename Sum.inl (π i) * MvPolynomial.X (Sum.inr i) :
          MvPolynomial (Fin m ⊕ Fin d) k) ^ c))) :=
    { toRingHom := Ideal.quotientMap _ (χ₀ : TensorProduct (MvPolynomial (Fin d) k)
        (MvPolynomial (Fin m ⊕ Fin d) k) C →+* Λ) hJle
      commutes' := fun x => by
        obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective x
        show Ideal.quotientMap _ _ hJle (algebraMap _ _ (Ideal.Quotient.mk _ r)) = _
        rw [Ideal.Quotient.algebraMap_quotient_map_quotient,
          Ideal.Quotient.algebraMap_quotient_map_quotient, Ideal.quotientMap_mk]
        exact congrArg _ (χ₀.commutes r) }
  have hφbar : ∀ x, φbar (Ideal.Quotient.mk _ x) = Ideal.Quotient.mk _ (χ₀ x) :=
    fun x => Ideal.quotientMap_mk (H := hJle)

  have hI : Ideal.map (algebraMap (MvPolynomial (Fin m ⊕ Fin d) k) Λ)
      (wcPfcPowIdeal (fun i => (MvPolynomial.rename Sum.inl (π i) * MvPolynomial.X (Sum.inr i) :
        MvPolynomial (Fin m ⊕ Fin d) k) ^ c)) =
      Ideal.span (Set.range fun i => (fun i => δ i * φ' (π i)) i ^ (8 * c)) := by
    unfold wcPfcPowIdeal
    rw [Ideal.map_span, ← Set.range_comp]
    congr 2
    funext i
    simp only [Function.comp_apply]
    rw [map_pow, map_pow, hγ, ← pow_mul, mul_comm c 8]
  have hgenu : Ideal.map (algebraMap Λ (Localization.AtPrime 𝔮))
      (Ideal.span (Set.range fun i => δ i * φ' (π i))) =
      IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) := by
    rw [← hπgen]
    have hu : ∀ i, IsUnit (algebraMap Λ (Localization.AtPrime 𝔮) (δ i)) := fun i =>
      (IsLocalization.AtPrime.isUnit_to_map_iff _ 𝔮 (δ i)).mpr (hδ i)
    apply le_antisymm
    · rw [Ideal.map_le_iff_le_comap, Ideal.span_le]
      rintro _ ⟨i, rfl⟩
      rw [SetLike.mem_coe, Ideal.mem_comap, map_mul]
      exact Ideal.mul_mem_left _ _ (Ideal.mem_map_of_mem _ (Ideal.subset_span ⟨i, rfl⟩))
    · rw [Ideal.map_le_iff_le_comap, Ideal.span_le]
      rintro _ ⟨i, rfl⟩
      rw [SetLike.mem_coe, Ideal.mem_comap]
      obtain ⟨w, hw⟩ := hu i
      have e : algebraMap Λ (Localization.AtPrime 𝔮) (φ' (π i)) =
          ↑w⁻¹ * algebraMap Λ (Localization.AtPrime 𝔮) (δ i * φ' (π i)) := by
        rw [map_mul, ← hw, ← mul_assoc, Units.inv_mul, one_mul]
      rw [e]
      exact Ideal.mul_mem_left _ _ (Ideal.mem_map_of_mem _ (Ideal.subset_span ⟨i, rfl⟩))
  obtain ⟨hprime, hmin, ρ, hρ⟩ := wc_pfc_pd_quotient_target Λ 𝔮 _ d (8 * c) n
    (fun i => δ i * φ' (π i)) (by omega) hI hgenu (by omega)

  let ρR0 : MvPolynomial (Fin m ⊕ Fin d) k →+* MvPolynomial (Fin d) (Localization.AtPrime 𝔪) :=
    MvPolynomial.eval₂Hom ((MvPolynomial.C).comp (σ.comp (algebraMap k (MvPolynomial (Fin m) k))))
      (Sum.elim (fun j => MvPolynomial.C (σ (MvPolynomial.X j))) MvPolynomial.X)
  have hρC : ∀ r : k, ρR0 (MvPolynomial.C r) = MvPolynomial.C (σ (MvPolynomial.C r)) := by
    intro r
    simp only [ρR0, MvPolynomial.eval₂Hom_C, RingHom.comp_apply]
    rfl
  have hρXl : ∀ j, ρR0 (MvPolynomial.X (Sum.inl j)) = MvPolynomial.C (σ (MvPolynomial.X j)) := by
    intro j
    simp only [ρR0, MvPolynomial.eval₂Hom_X', Sum.elim_inl]
  have hρXr : ∀ i, ρR0 (MvPolynomial.X (Sum.inr i)) = MvPolynomial.X i := by
    intro i
    simp only [ρR0, MvPolynomial.eval₂Hom_X', Sum.elim_inr]
  have hρren : ∀ q, ρR0 (MvPolynomial.rename Sum.inl q) = MvPolynomial.C (σ q) := by
    intro q
    have h : ρR0.comp (MvPolynomial.rename Sum.inl : MvPolynomial (Fin m) k →ₐ[k]
        MvPolynomial (Fin m ⊕ Fin d) k).toRingHom = (MvPolynomial.C).comp σ := by
      apply MvPolynomial.ringHom_ext
      · intro r
        simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
          MvPolynomial.rename_C]
        exact hρC r
      · intro j
        simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
          MvPolynomial.rename_X]
        exact hρXl j
    exact RingHom.congr_fun h q
  letI iPD : Algebra (MvPolynomial (Fin d) k) (MvPolynomial (Fin d) (Localization.AtPrime 𝔪)) :=
    (χD.comp (algebraMap (MvPolynomial (Fin d) k) C)).toAlgebra
  let χDalg : C →ₐ[MvPolynomial (Fin d) k] MvPolynomial (Fin d) (Localization.AtPrime 𝔪) :=
    ⟨χD, fun _ => rfl⟩
  have hρP : ρR0.comp (algebraMap (MvPolynomial (Fin d) k) (MvPolynomial (Fin m ⊕ Fin d) k)) =
      χD.comp (algebraMap (MvPolynomial (Fin d) k) C) := by
    apply MvPolynomial.ringHom_ext
    · intro r
      show ρR0 (algebraMap (MvPolynomial (Fin d) k) (MvPolynomial (Fin m ⊕ Fin d) k)
          (algebraMap k (MvPolynomial (Fin d) k) r)) =
        χD (algebraMap (MvPolynomial (Fin d) k) C (algebraMap k (MvPolynomial (Fin d) k) r))
      rw [← IsScalarTower.algebraMap_apply, ← IsScalarTower.algebraMap_apply, hχDk]
      exact hρC r
    · intro i
      show ρR0 (algebraMap (MvPolynomial (Fin d) k) (MvPolynomial (Fin m ⊕ Fin d) k)
          (MvPolynomial.X i)) = χD (algebraMap (MvPolynomial (Fin d) k) C (MvPolynomial.X i))
      rw [hPR, map_mul, hρren, hρXr, hχDX]
      rfl
  let ρR : MvPolynomial (Fin m ⊕ Fin d) k →ₐ[MvPolynomial (Fin d) k]
      MvPolynomial (Fin d) (Localization.AtPrime 𝔪) := ⟨ρR0, fun y => RingHom.congr_fun hρP y⟩
  let χDA : TensorProduct (MvPolynomial (Fin d) k) (MvPolynomial (Fin m ⊕ Fin d) k) C →+*
      MvPolynomial (Fin d) (Localization.AtPrime 𝔪) :=
    (Algebra.TensorProduct.productMap ρR χDalg).toRingHom
  have hχDAtmul : ∀ (r : MvPolynomial (Fin m ⊕ Fin d) k) (y : C),
      χDA (r ⊗ₜ[MvPolynomial (Fin d) k] y) = ρR0 r * χD y :=
    fun r y => Algebra.TensorProduct.productMap_apply_tmul _ _ r y
  have hχDAalg : ∀ r, χDA (algebraMap (MvPolynomial (Fin m ⊕ Fin d) k)
      (TensorProduct (MvPolynomial (Fin d) k) (MvPolynomial (Fin m ⊕ Fin d) k) C) r) = ρR0 r := by
    intro r
    rw [Algebra.TensorProduct.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply,
      hχDAtmul, map_one, mul_one]
  have hρev : ∀ r : MvPolynomial (Fin m ⊕ Fin d) k,
      MvPolynomial.eval₂ v (fun i => Ideal.Quotient.mk (IsLocalRing.maximalIdeal
        (Localization.AtPrime 𝔮) ^ n) (algebraMap Λ (Localization.AtPrime 𝔮) (δ i))) (ρR0 r) =
      Ideal.Quotient.mk _ (algebraMap Λ (Localization.AtPrime 𝔮)
        (algebraMap (MvPolynomial (Fin m ⊕ Fin d) k) Λ r)) := by
    intro r
    have h : (MvPolynomial.eval₂Hom v (fun i => Ideal.Quotient.mk (IsLocalRing.maximalIdeal
        (Localization.AtPrime 𝔮) ^ n) (algebraMap Λ (Localization.AtPrime 𝔮) (δ i)))).comp ρR0 =
        ((Ideal.Quotient.mk _).comp (algebraMap Λ (Localization.AtPrime 𝔮))).comp
          (algebraMap (MvPolynomial (Fin m ⊕ Fin d) k) Λ) := by
      apply MvPolynomial.ringHom_ext
      · intro r
        simp only [RingHom.comp_apply, MvPolynomial.coe_eval₂Hom]
        rw [hρC, MvPolynomial.eval₂_C, hσv]
        have e : φ' (algebraMap k (MvPolynomial (Fin m) k) r) =
            algebraMap (MvPolynomial (Fin m ⊕ Fin d) k) Λ
              (algebraMap k (MvPolynomial (Fin m ⊕ Fin d) k) r) := by
          rw [AlgHom.commutes, ← IsScalarTower.algebraMap_apply]
        exact congrArg (fun z => Ideal.Quotient.mk (IsLocalRing.maximalIdeal
          (Localization.AtPrime 𝔮) ^ n) (algebraMap Λ (Localization.AtPrime 𝔮) z)) e
      · intro x
        cases x with
        | inl j =>
          simp only [RingHom.comp_apply, MvPolynomial.coe_eval₂Hom]
          rw [hρXl, MvPolynomial.eval₂_C, hσv, hRX]
          rfl
        | inr i =>
          simp only [RingHom.comp_apply, MvPolynomial.coe_eval₂Hom]
          rw [hρXr, MvPolynomial.eval₂_X, hRX]
          rfl
    exact RingHom.congr_fun h r
  have hcompatA : ∀ x, MvPolynomial.eval₂ v (fun i => Ideal.Quotient.mk (IsLocalRing.maximalIdeal
      (Localization.AtPrime 𝔮) ^ n) (algebraMap Λ (Localization.AtPrime 𝔮) (δ i))) (χDA x) =
      Ideal.Quotient.mk _ (algebraMap Λ (Localization.AtPrime 𝔮) (χ₀ x)) := by
    intro x
    induction x using TensorProduct.induction_on with
    | zero => simp only [map_zero, MvPolynomial.eval₂_zero]
    | tmul r y =>
      rw [hχDAtmul, MvPolynomial.eval₂_mul, hρev, hχcompat, hχ₀tmul, map_mul, map_mul]
    | add x y hx hy =>
      rw [map_add, MvPolynomial.eval₂_add, hx, hy, map_add, map_add, map_add]
  obtain ⟨Csm, iC1, iC2, iC3, ψ, γ', hγψ⟩ := wc_pfc_pd_local_smooth_factor k Λ 𝔮 m n d c φ'
    hflat hgen π δ hc (by omega) hπ𝔭 hδ hπgen S 𝔪 v hvcomp (fun j => hRX (Sum.inl j))
    (fun i => hRX (Sum.inr i)) _ χ₀ χDA
    (fun r => by rw [hχDAalg]; exact hρC r)
    (fun j => by rw [hχDAalg]; exact hρXl j)
    (fun i => by rw [hχDAalg]; exact hρXr i)
    hcompatA ρ hρ φbar hφbar
  refine ⟨MvPolynomial (Fin m ⊕ Fin d) k, inferInstance, inferInstance, inferInstance,
    inferInstance, iRΛ, inferInstance,
    TensorProduct (MvPolynomial (Fin d) k) (MvPolynomial (Fin m ⊕ Fin d) k) C, inferInstance,
    inferInstance, inferInstance, inferInstance, inferInstance, ψ₀, χ₀, d,
    fun i => (MvPolynomial.rename Sum.inl (π i) * MvPolynomial.X (Sum.inr i) :
      MvPolynomial (Fin m ⊕ Fin d) k) ^ c,
    AlgHom.ext fun x => hχ₀ψ₀ x, hrad, hπ𝔮, hannR, hannΛ', hssR,
    wc_pfc_cz_fp_quotient_base_change _ _ _, φbar, hφbar, hprime, hmin, Csm, iC1, iC2, iC3,
    ψ, γ', hγψ⟩

theorem wc_pfc_resolve_char_p : ∀ (k : Type u) [Field k] (p : ℕ) [Fact p.Prime] [CharP k p] (Λ : Type u) [CommRing Λ] [IsNoetherianRing Λ] [Algebra k Λ], (∀ (L : Type u) [Field L] [Algebra k L] [FiniteDimensional k L] (𝔔 : Ideal (TensorProduct k L Λ)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) → ∀ (A : Type u) [CommRing A] [Algebra k A] [Algebra.FinitePresentation k A] (φ : A →ₐ[k] Λ) (𝔮 : Ideal Λ), 𝔮 ∈ (Ideal.span (φ '' {a : A | Algebra.Smooth k (Localization.Away a)})).minimalPrimes → ∃ (B : Type u) (_ : CommRing B) (_ : Algebra k B) (_ : Algebra.FinitePresentation k B) (ψ : A →ₐ[k] B) (χ : B →ₐ[k] Λ), χ.comp ψ = φ ∧ (Ideal.span (φ '' {a : A | Algebra.Smooth k (Localization.Away a)})).radical ≤ (Ideal.span (χ '' {b : B | Algebra.Smooth k (Localization.Away b)})).radical ∧ ¬ (Ideal.span (χ '' {b : B | Algebra.Smooth k (Localization.Away b)})).radical ≤ 𝔮 :=
by
  intro k _ p _ _ Λ _ _ _ hreg A _ _ _ φ 𝔮 h𝔮
  haveI : 𝔮.IsPrime := h𝔮.1.1

  obtain ⟨R, _, _, _, _, _, _, A', _, _, _, _, _, ψ₀, χ₀, r, π, hcomp, hrad, hπ, hannR, hannΛ,
    hss, hfp, φbar, hφbar, hprime, hmin, hloc⟩ :=
    wc_pfc_p_reduction_datum wc_pfc_p_flat_artinian_approx wc_pfc_p_presentation
      k p Λ hreg A φ 𝔮 h𝔮
  haveI := hfp
  haveI := hprime

  have h8 := wc_pfc_artinian_localization (R ⧸ wcPfcPowIdeal π)
    (A' ⧸ Ideal.map (algebraMap R A') (wcPfcPowIdeal π))
    (Λ ⧸ Ideal.map (algebraMap R Λ) (wcPfcPowIdeal π)) φbar _ hmin hloc

  obtain ⟨B, _, _, _, ψ, χ, hψχ, hrad2, hnot⟩ :=
    wc_pfc_lifting_lemma R A' Λ χ₀ 𝔮 r π hπ hannR hannΛ hss φbar hφbar h8


  letI : Algebra k B := ((algebraMap R B).comp (algebraMap k R)).toAlgebra
  haveI : IsScalarTower k R B := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  haveI : Algebra.FinitePresentation k B := Algebra.FinitePresentation.trans k R B
  have hsub : ∀ b : B, Algebra.Smooth R (Localization.Away b) →
      Algebra.Smooth k (Localization.Away b) := by
    intro b hb
    haveI := hb
    exact Algebra.Smooth.comp k R (Localization.Away b)
  have hle : (Ideal.span (χ '' {b : B | Algebra.Smooth R (Localization.Away b)})).radical ≤
      (Ideal.span ((χ.restrictScalars k) ''
        {b : B | Algebra.Smooth k (Localization.Away b)})).radical := by
    apply Ideal.radical_mono
    apply Ideal.span_mono
    rintro _ ⟨b, hb, rfl⟩
    exact ⟨b, hsub b hb, rfl⟩
  refine ⟨B, inferInstance, inferInstance, inferInstance, (ψ.restrictScalars k).comp ψ₀,
    χ.restrictScalars k, ?_, ?_, ?_⟩
  · rw [← hcomp]
    ext x
    simp only [AlgHom.comp_apply, AlgHom.restrictScalars_apply]
    rw [← AlgHom.comp_apply χ ψ, hψχ]
  · exact hrad.trans (hrad2.trans hle)
  · intro h
    exact hnot (hle.trans h)

theorem wc_hnas_pfc_popescu_field_case : ∀ (k : Type u) [Field k] (Λ : Type u) [CommRing Λ] [IsNoetherianRing Λ] [Algebra k Λ], (∀ (L : Type u) [Field L] [Algebra k L] [FiniteDimensional k L] (𝔔 : Ideal (TensorProduct k L Λ)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) → ∀ (n : ℕ) (s : Finset (MvPolynomial (Fin n) k)) (b : Fin n → Λ), (∀ f ∈ s, MvPolynomial.aeval b f = 0) → ∃ (D : Type u) (_ : CommRing D) (_ : Algebra k D) (_ : Algebra.Smooth k D) (c : Fin n → D) (γ : D →ₐ[k] Λ), (∀ f ∈ s, MvPolynomial.aeval c f = 0) ∧ ∀ i, γ (c i) = b i :=
by
  intro k _ Λ _ _ _ hreg n s b hb
  classical
  let I : Ideal (MvPolynomial (Fin n) k) := Ideal.span (s : Set (MvPolynomial (Fin n) k))
  haveI hA : Algebra.FinitePresentation k (MvPolynomial (Fin n) k ⧸ I) :=
    Algebra.FinitePresentation.quotient ⟨s, rfl⟩
  have hle : I ≤ RingHom.ker (MvPolynomial.aeval (R := k) b) := by
    apply Ideal.span_le.mpr
    intro g hg
    exact RingHom.mem_ker.mpr (hb g hg)
  have hI : ∀ f ∈ I, MvPolynomial.aeval (R := k) b f = 0 := fun f hf =>
    RingHom.mem_ker.mp (hle hf)
  let φ : (MvPolynomial (Fin n) k ⧸ I) →ₐ[k] Λ :=
    Ideal.Quotient.liftₐ I (MvPolynomial.aeval b) hI

  obtain ⟨B, iB, aB, fB, ψ, χ, hψχ, h1⟩ := wc_pfc_noetherian_induction_unit k Λ (by
    intro A _ _ _ φ' 𝔮 h𝔮
    obtain ⟨p, hp⟩ := CharP.exists k
    rcases CharP.char_is_prime_or_zero k p with hpp | hp0
    · haveI : Fact p.Prime := ⟨hpp⟩
      exact wc_pfc_resolve_char_p k p Λ hreg A φ' 𝔮 h𝔮
    · subst hp0
      haveI : CharZero k := CharP.charP_to_charZero k
      exact wc_pfc_resolve_char_zero k Λ hreg A φ' 𝔮 h𝔮) _ φ

  obtain ⟨D, iD, aD, sD, ψ', χ', hψ'χ'⟩ := wc_pfc_smooth_factor_of_unit_ideal k B Λ χ h1
  let g : MvPolynomial (Fin n) k →ₐ[k] D := ψ'.comp (ψ.comp (Ideal.Quotient.mkₐ k I))
  refine ⟨D, iD, aD, sD, fun i => g (MvPolynomial.X i), χ', ?_, ?_⟩
  · intro f hf
    have e1 : MvPolynomial.aeval (fun i => g (MvPolynomial.X i)) f = g f :=
      (DFunLike.congr_fun (MvPolynomial.aeval_unique g) f).symm
    have hf0 : Ideal.Quotient.mkₐ k I f = 0 := by
      rw [Ideal.Quotient.mkₐ_eq_mk, Ideal.Quotient.eq_zero_iff_mem]
      exact Ideal.subset_span hf
    have e2 : g f = 0 := by
      show ψ' (ψ (Ideal.Quotient.mkₐ k I f)) = 0
      rw [hf0, map_zero, map_zero]
    rw [e1, e2]
  · intro i
    show χ' (ψ' (ψ (Ideal.Quotient.mkₐ k I (MvPolynomial.X i)))) = b i
    rw [← AlgHom.comp_apply χ' ψ', hψ'χ', ← AlgHom.comp_apply χ ψ, hψχ]
    show (Ideal.Quotient.liftₐ I (MvPolynomial.aeval b) hI)
      (Ideal.Quotient.mkₐ k I (MvPolynomial.X i)) = b i
    exact MvPolynomial.aeval_X b i

theorem wc_hnas_popescu_factor_completion : ∀ (R : Type u) [CommRing R] [Algebra.FiniteType ℤ R] (𝔮 : Ideal R) [𝔮.IsPrime] (H : Type u) [CommRing H] [HenselianLocalRing H] [IsNoetherianRing H] (ι : Localization.AtPrime 𝔮 →+* H), IsLocalHom ι → (∀ x : H, ∃ y : Localization.AtPrime 𝔮, x - ι y ∈ IsLocalRing.maximalIdeal H) → Ideal.map ι (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮)) = IsLocalRing.maximalIdeal H → (∀ (A : Type u) [CommRing A] [HenselianLocalRing A] (g : Localization.AtPrime 𝔮 →+* A), IsLocalHom g → ∃! h : H →+* A, IsLocalHom h ∧ h.comp ι = g) → (∀ F : Finset H, ∃ (E : Type u) (_ : CommRing E) (_ : Algebra (Localization.AtPrime 𝔮) E) (_ : Algebra.Etale (Localization.AtPrime 𝔮) E) (e : E →+* H), e.comp (algebraMap (Localization.AtPrime 𝔮) E) = ι ∧ ∀ t ∈ F, t ∈ e.range) → ∀ (n : ℕ) (s : Finset (MvPolynomial (Fin n) (Localization.AtPrime 𝔮))) (b : Fin n → AdicCompletion (IsLocalRing.maximalIdeal H) H), (∀ f ∈ s, MvPolynomial.eval₂ ((algebraMap H (AdicCompletion (IsLocalRing.maximalIdeal H) H)).comp ι) b f = 0) → ∃ (D : Type u) (_ : CommRing D) (_ : Algebra (Localization.AtPrime 𝔮) D) (_ : Algebra.Smooth (Localization.AtPrime 𝔮) D) (c : Fin n → D) (γ : D →+* AdicCompletion (IsLocalRing.maximalIdeal H) H), γ.comp (algebraMap (Localization.AtPrime 𝔮) D) = (algebraMap H (AdicCompletion (IsLocalRing.maximalIdeal H) H)).comp ι ∧ (∀ f ∈ s, MvPolynomial.aeval c f = 0) ∧ ∀ k, γ (c k) = b k :=
by
  intro R _ _ 𝔮 _ H _ _ _ ι _ hres hmeq hUP _ n s b hb

  haveI hRn : IsNoetherianRing R := Algebra.FiniteType.isNoetherianRing ℤ R
  haveI hPn : IsNoetherianRing (Localization.AtPrime 𝔮) :=
    IsLocalization.isNoetherianRing 𝔮.primeCompl _ inferInstance

  obtain ⟨hloc, hcomp, hlocal, -⟩ :=
    wc_hnas_completion_local_complete (Localization.AtPrime 𝔮)
  haveI := hloc
  haveI := hcomp
  haveI hCn := wc_hnas_completion_noetherian (Localization.AtPrime 𝔮)

  haveI hhen : HenselianLocalRing (AdicCompletion (IsLocalRing.maximalIdeal
      (Localization.AtPrime 𝔮)) (Localization.AtPrime 𝔮)) := by
    refine HenselianLocalRing.mk ?_
    intro f hf a₀ h1 h2
    exact (IsAdicComplete.henselianRing _ (IsLocalRing.maximalIdeal _)).is_henselian f hf a₀ h1
      (h2.map (Ideal.Quotient.mk _))

  obtain ⟨h, ⟨-, hh⟩, -⟩ := hUP _ (algebraMap (Localization.AtPrime 𝔮)
    (AdicCompletion (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮)) (Localization.AtPrime 𝔮)))
    hlocal

  have hdens : ∀ (k : ℕ) (x : H), ∃ y : Localization.AtPrime 𝔮,
      x - ι y ∈ IsLocalRing.maximalIdeal H ^ k := by
    have hpow : ∀ k, Ideal.map ι (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) ^ k) =
        IsLocalRing.maximalIdeal H ^ k := fun k => by
      rw [Ideal.map_pow, hmeq]
    have C : ∀ k, ∀ z ∈ Ideal.map ι (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) ^ k),
        ∃ y ∈ IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) ^ k,
        z - ι y ∈ IsLocalRing.maximalIdeal H ^ (k + 1) := by
      intro k z hz
      have hz' : z ∈ Submodule.span H (ι '' ((IsLocalRing.maximalIdeal
          (Localization.AtPrime 𝔮) ^ k : Ideal (Localization.AtPrime 𝔮)) :
            Set (Localization.AtPrime 𝔮))) := hz
      clear hz
      induction hz' using Submodule.span_induction with
      | mem x hx =>
        obtain ⟨p, hp, rfl⟩ := hx
        exact ⟨p, hp, by simp⟩
      | zero => exact ⟨0, zero_mem _, by simp⟩
      | add x z _ _ hx hz =>
        obtain ⟨y1, hy1, h1⟩ := hx
        obtain ⟨y2, hy2, h2⟩ := hz
        refine ⟨y1 + y2, add_mem hy1 hy2, ?_⟩
        have := add_mem h1 h2
        rw [map_add]
        convert this using 1
        ring
      | smul a x _ hx =>
        obtain ⟨y, hy, hw⟩ := hx
        obtain ⟨y', hy'⟩ := hres a
        refine ⟨y' * y, Ideal.mul_mem_left _ _ hy, ?_⟩
        have e : a • x - ι (y' * y) = (a - ι y') * ι y + a * (x - ι y) := by
          rw [smul_eq_mul, map_mul]; ring
        rw [e]
        refine add_mem ?_ (Ideal.mul_mem_left _ _ hw)
        rw [pow_succ']
        exact Ideal.mul_mem_mul hy' (by rw [← hpow k]; exact Ideal.mem_map_of_mem _ hy)
    intro k
    induction k with
    | zero => intro x; exact ⟨0, by simp⟩
    | succ k ih =>
      intro x
      obtain ⟨y0, hy0⟩ := ih x
      rw [← hpow k] at hy0
      obtain ⟨y1, -, hy1⟩ := C k _ hy0
      refine ⟨y0 + y1, ?_⟩
      rw [map_add]
      convert hy1 using 1
      ring

  have hcmp : ∀ (P : Type u) [CommRing P] (H : Type u) [CommRing H] (ι : P →+* H) (𝔪 : Ideal P)
      (𝔫 : Ideal H), (∀ (n : ℕ) (x : H), ∃ y : P, x - ι y ∈ 𝔫 ^ n) → Ideal.map ι 𝔪 = 𝔫 →
      ∀ h : H →+* AdicCompletion 𝔪 P, h.comp ι = algebraMap P (AdicCompletion 𝔪 P) →
      ∃ (Φ : AdicCompletion 𝔪 P →+* AdicCompletion 𝔫 H)
        (Ψ : AdicCompletion 𝔫 H →+* AdicCompletion 𝔪 P),
        Φ.comp (algebraMap P (AdicCompletion 𝔪 P)) = (algebraMap H (AdicCompletion 𝔫 H)).comp ι ∧
        Ψ.comp ((algebraMap H (AdicCompletion 𝔫 H)).comp ι) = algebraMap P (AdicCompletion 𝔪 P) ∧
        ∀ x, Φ (Ψ x) = x := by
    intro P _ H _ ι 𝔪 𝔫 hdens hmeq h hh
    have hpow : ∀ k, Ideal.map ι (𝔪 ^ k) = 𝔫 ^ k := fun k => by
      rw [Ideal.map_pow, hmeq]
    have trunc : ∀ {X : Type u} [CommRing X] (I : Ideal X) {m k : ℕ} (hle : m ≤ k)
        (x : AdicCompletion I X),
        Ideal.Quotient.factorPow I hle (AdicCompletion.evalₐ I k x) =
          AdicCompletion.evalₐ I m x := by
      intro X _ I m k hle x
      obtain ⟨f, rfl⟩ := AdicCompletion.mk_surjective I X x
      rw [AdicCompletion.evalₐ_mk, AdicCompletion.evalₐ_mk]
      have h1 := AdicCompletion.AdicCauchySequence.mk_eq_mk (I := I) (M := X) hle f
      have h2 := (Submodule.Quotient.eq _).mp h1
      change Ideal.Quotient.mk (I ^ m) (f k) = Ideal.Quotient.mk (I ^ m) (f m)
      rw [Ideal.Quotient.eq]
      simpa [smul_eq_mul, Ideal.mul_top] using h2
    have evP : ∀ k (p : P), AdicCompletion.evalₐ 𝔪 k
        (algebraMap P (AdicCompletion 𝔪 P) p) = Ideal.Quotient.mk (𝔪 ^ k) p := by
      intro k p
      rw [AdicCompletion.algebraMap_apply, AdicCompletion.evalₐ_of]
      rfl
    have evH : ∀ k (x : H), AdicCompletion.evalₐ 𝔫 k
        (algebraMap H (AdicCompletion 𝔫 H) x) = Ideal.Quotient.mk (𝔫 ^ k) x := by
      intro k x
      rw [AdicCompletion.algebraMap_apply, AdicCompletion.evalₐ_of]
      rfl
    let ρ : ∀ k, H →+* P ⧸ 𝔪 ^ k := fun k => (AdicCompletion.evalₐ 𝔪 k).toRingHom.comp h
    have hρι : ∀ k (p : P), ρ k (ι p) = Ideal.Quotient.mk (𝔪 ^ k) p := by
      intro k p
      change AdicCompletion.evalₐ 𝔪 k (h (ι p)) = _
      rw [← RingHom.comp_apply h ι, hh, evP]
    have hker : ∀ k, 𝔫 ^ k ≤ RingHom.ker (ρ k) := by
      intro k
      rw [← hpow k, Ideal.map_le_iff_le_comap]
      intro p hp
      rw [Ideal.mem_comap, RingHom.mem_ker, hρι, Ideal.Quotient.eq_zero_iff_mem]
      exact hp
    let ρb : ∀ k, H ⧸ 𝔫 ^ k →+* P ⧸ 𝔪 ^ k := fun k =>
      Ideal.Quotient.lift (𝔫 ^ k) (ρ k) (fun a ha => hker k ha)
    have hle : ∀ k, 𝔪 ^ k ≤ Ideal.comap ι (𝔫 ^ k) := fun k => by
      rw [← hpow k]; exact Ideal.le_comap_map
    let ιb : ∀ k, P ⧸ 𝔪 ^ k →+* H ⧸ 𝔫 ^ k := fun k => Ideal.quotientMap (𝔫 ^ k) ι (hle k)
    have hιb : ∀ k (p : P), ιb k (Ideal.Quotient.mk _ p) = Ideal.Quotient.mk _ (ι p) := by
      intro k p; exact Ideal.quotientMap_mk
    have hρb : ∀ k (x : H), ρb k (Ideal.Quotient.mk _ x) = ρ k x := by
      intro k x; exact Ideal.Quotient.lift_mk _ _ _
    have hρι' : ∀ k z, ρb k (ιb k z) = z := by
      intro k z
      obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective z
      rw [hιb, hρb, hρι]
    have hιsurj : ∀ k z, ∃ w, ιb k w = z := by
      intro k z
      obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective z
      obtain ⟨y, hy⟩ := hdens k x
      refine ⟨Ideal.Quotient.mk _ y, ?_⟩
      rw [hιb]
      exact (Ideal.Quotient.eq.mpr hy).symm
    have hιρ : ∀ k z, ιb k (ρb k z) = z := by
      intro k z
      obtain ⟨w, rfl⟩ := hιsurj k z
      rw [hρι']
    let Φ := AdicCompletion.liftRingHom 𝔫
      (fun k => (ιb k).comp (AdicCompletion.evalₐ 𝔪 k).toRingHom) (by
        intro m k hmk
        refine RingHom.ext fun x => ?_
        change Ideal.Quotient.factorPow 𝔫 hmk (ιb k (AdicCompletion.evalₐ 𝔪 k x)) =
          ιb m (AdicCompletion.evalₐ 𝔪 m x)
        obtain ⟨a, ha⟩ := Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ 𝔪 k x)
        rw [← trunc 𝔪 hmk x, ← ha, hιb]
        rfl)
    let Ψ := AdicCompletion.liftRingHom 𝔪
      (fun k => (ρb k).comp (AdicCompletion.evalₐ 𝔫 k).toRingHom) (by
        intro m k hmk
        refine RingHom.ext fun x => ?_
        change Ideal.Quotient.factorPow 𝔪 hmk (ρb k (AdicCompletion.evalₐ 𝔫 k x)) =
          ρb m (AdicCompletion.evalₐ 𝔫 m x)
        obtain ⟨a, ha⟩ := Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ 𝔫 k x)
        rw [← trunc 𝔫 hmk x, ← ha, hρb]
        change Ideal.Quotient.factorPow 𝔪 hmk (AdicCompletion.evalₐ 𝔪 k (h a)) =
          ρb m (Ideal.Quotient.mk _ a)
        rw [hρb, trunc]
        rfl)
    have hΦev : ∀ k x, AdicCompletion.evalₐ 𝔫 k (Φ x) = ιb k (AdicCompletion.evalₐ 𝔪 k x) := by
      intro k x
      exact AdicCompletion.evalₐ_liftRingHom _ _ _ k x
    have hΨev : ∀ k x, AdicCompletion.evalₐ 𝔪 k (Ψ x) = ρb k (AdicCompletion.evalₐ 𝔫 k x) := by
      intro k x
      exact AdicCompletion.evalₐ_liftRingHom _ _ _ k x
    refine ⟨Φ, Ψ, ?_, ?_, ?_⟩
    · refine RingHom.ext fun p => ?_
      apply AdicCompletion.ext_evalₐ
      intro k
      simp only [RingHom.comp_apply]
      rw [hΦev, evP, hιb, evH]
    · refine RingHom.ext fun p => ?_
      apply AdicCompletion.ext_evalₐ
      intro k
      simp only [RingHom.comp_apply]
      rw [hΨev, evH, hρb, hρι, evP]
    · intro x
      apply AdicCompletion.ext_evalₐ
      intro k
      rw [hΦev, hΨev, hιρ]
  obtain ⟨Φ, Ψ, hΦ, hΨ, hΦΨ⟩ := hcmp _ H ι _ _ hdens hmeq h hh

  have hsol : ∀ f ∈ s, MvPolynomial.aeval (fun k => Ψ (b k)) f = 0 := by
    intro f hf
    rw [MvPolynomial.aeval_def, ← hΨ]
    have e := MvPolynomial.eval₂_comp_left Ψ
      ((algebraMap H (AdicCompletion (IsLocalRing.maximalIdeal H) H)).comp ι) b f
    change MvPolynomial.eval₂ (Ψ.comp ((algebraMap H (AdicCompletion
      (IsLocalRing.maximalIdeal H) H)).comp ι)) (Ψ ∘ b) f = 0
    rw [← e, hb f hf, map_zero]

  have hflat : Module.Flat (Localization.AtPrime 𝔮)
      (AdicCompletion (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮))
        (Localization.AtPrime 𝔮)) :=
    AdicCompletion.flat_of_isNoetherian _
  have hreg := wc_hnas_pfc_formal_fibres_regular R 𝔮
    (AdicCompletion (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮)) (Localization.AtPrime 𝔮))
    ⟨AlgEquiv.refl⟩
  obtain ⟨D, iD, aD, sD, c, γ₀, hc, hγ₀⟩ :=
    wc_hnas_pfc_popescu_reduction_to_field wc_hnas_pfc_popescu_field_case
      (Localization.AtPrime 𝔮)
      (AdicCompletion (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮)) (Localization.AtPrime 𝔮))
      hflat hreg n s (fun k => Ψ (b k)) hsol
  refine ⟨D, iD, aD, sD, c, Φ.comp γ₀.toRingHom, ?_, hc, ?_⟩
  · refine RingHom.ext fun p => ?_
    rw [← hΦ]
    simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe, AlgHom.commutes]
  · intro k
    simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe]
    rw [hγ₀ k, hΦΨ]

theorem wc_hnas_smooth_factor_transfer_etale : ∀ (P : Type u) [CommRing P] (H : Type u) [CommRing H] (ι : P →+* H) (T : Type u) [CommRing T] (θ : H →+* T), (∀ F : Finset H, ∃ (E : Type u) (_ : CommRing E) (_ : Algebra P E) (_ : Algebra.Etale P E) (e : E →+* H), e.comp (algebraMap P E) = ι ∧ ∀ t ∈ F, t ∈ e.range) → (∀ (n : ℕ) (s : Finset (MvPolynomial (Fin n) P)) (b : Fin n → T), (∀ f ∈ s, MvPolynomial.eval₂ (θ.comp ι) b f = 0) → ∃ (D : Type u) (_ : CommRing D) (_ : Algebra P D) (_ : Algebra.Smooth P D) (c : Fin n → D) (γ : D →+* T), γ.comp (algebraMap P D) = θ.comp ι ∧ (∀ f ∈ s, MvPolynomial.aeval c f = 0) ∧ ∀ k, γ (c k) = b k) → ∀ (n : ℕ) (s : Finset (MvPolynomial (Fin n) H)) (b : Fin n → T), (∀ f ∈ s, MvPolynomial.eval₂ θ b f = 0) → ∃ (D : Type u) (_ : CommRing D) (_ : Algebra H D) (_ : Algebra.Smooth H D) (c : Fin n → D) (γ : D →+* T), γ.comp (algebraMap H D) = θ ∧ (∀ f ∈ s, MvPolynomial.aeval c f = 0) ∧ ∀ k, γ (c k) = b k :=
by
  intro P _ H _ ι T _ θ hchart hP n s b hs
  classical

  obtain ⟨E, _, _, _, e, he, hF⟩ := hchart (s.biUnion (fun f => f.coeffs))
  have hpre : ∀ f ∈ s, ∃ fE : MvPolynomial (Fin n) E, MvPolynomial.map e fE = f := by
    intro f hf
    have hmem : f ∈ Set.range (MvPolynomial.map e) := by
      rw [MvPolynomial.mem_range_map_iff_coeffs_subset]
      intro t ht
      obtain ⟨x, hx⟩ := RingHom.mem_range.mp (hF t (Finset.mem_biUnion.mpr ⟨f, hf, ht⟩))
      exact ⟨x, hx⟩
    exact hmem
  choose pre hpre' using hpre
  have hθι : θ.comp ι = (θ.comp e).comp (algebraMap P E) := by rw [← he]; rfl

  obtain ⟨m, q, hq, hker⟩ := Algebra.FinitePresentation.out (R := P) (A := E)
  obtain ⟨G, hG⟩ := hker
  have hev : ∀ (A : Type u) [CommRing A] (κ : E →+* A) (p : MvPolynomial (Fin m) P),
      MvPolynomial.eval₂ (κ.comp (algebraMap P E)) (fun j => κ (q (MvPolynomial.X j))) p
        = κ (q p) := by
    intro A _ κ p
    have h1 : q p = MvPolynomial.aeval (fun j => q (MvPolynomial.X j)) p :=
      congrArg (fun φ : MvPolynomial (Fin m) P →ₐ[P] E => φ p) (MvPolynomial.aeval_unique q)
    rw [h1, MvPolynomial.aeval_def, MvPolynomial.eval₂_comp_left]
    rfl
  have hlift : ∀ fE : MvPolynomial (Fin n) E, ∃ fP : MvPolynomial (Fin (n + m)) P,
      ∀ (A : Type u) [CommRing A] (κ : E →+* A) (x : Fin n → A),
        MvPolynomial.eval₂ (κ.comp (algebraMap P E))
          (Fin.append x (fun j => κ (q (MvPolynomial.X j)))) fP = MvPolynomial.eval₂ κ x fE := by
    intro fE
    obtain ⟨f', hf'⟩ := MvPolynomial.map_surjective (q : MvPolynomial (Fin m) P →+* E) hq fE
    refine ⟨MvPolynomial.eval₂ (MvPolynomial.rename (Fin.natAdd n)).toRingHom
      (fun i => MvPolynomial.X (Fin.castAdd m i)) f', ?_⟩
    intro A _ κ x
    rw [← hf']
    have e1 := MvPolynomial.eval₂_comp_left
      (MvPolynomial.eval₂Hom (κ.comp (algebraMap P E))
        (Fin.append x (fun j => κ (q (MvPolynomial.X j)))))
      (MvPolynomial.rename (Fin.natAdd n)).toRingHom (fun i => MvPolynomial.X (Fin.castAdd m i)) f'
    rw [MvPolynomial.coe_eval₂Hom] at e1
    rw [e1, MvPolynomial.eval₂_map]
    congr 1
    · refine RingHom.ext fun p => ?_
      show MvPolynomial.eval₂ (κ.comp (algebraMap P E))
          (Fin.append x (fun j => κ (q (MvPolynomial.X j))))
          (MvPolynomial.rename (Fin.natAdd n) p) = κ (q p)
      rw [MvPolynomial.eval₂_rename]
      have hc : (Fin.append x (fun j => κ (q (MvPolynomial.X j)))) ∘ Fin.natAdd n
          = (fun j => κ (q (MvPolynomial.X j))) := funext fun j => Fin.append_right _ _ j
      rw [hc, hev]
    · funext i
      simp only [Function.comp_apply, MvPolynomial.eval₂_X, Fin.append_left]
  choose lift hlift using hlift

  let S' : Finset (MvPolynomial (Fin (n + m)) P) :=
    s.attach.image (fun f => lift (pre f.1 f.2)) ∪ G.image (MvPolynomial.rename (Fin.natAdd n))
  let b' : Fin (n + m) → T := Fin.append b (fun j => (θ.comp e) (q (MvPolynomial.X j)))
  have hS' : ∀ g ∈ S', MvPolynomial.eval₂ (θ.comp ι) b' g = 0 := by
    intro g hg
    rw [hθι]
    rcases Finset.mem_union.mp hg with h | h
    · obtain ⟨⟨f, hf⟩, -, hfg⟩ := Finset.mem_image.mp h
      subst hfg
      show MvPolynomial.eval₂ ((θ.comp e).comp (algebraMap P E))
        (Fin.append b (fun j => (θ.comp e) (q (MvPolynomial.X j)))) (lift (pre f hf)) = 0
      rw [hlift (pre f hf) T (θ.comp e) b, ← MvPolynomial.eval₂_map, hpre' f hf]
      exact hs f hf
    · obtain ⟨g0, hg0, hfg⟩ := Finset.mem_image.mp h
      subst hfg
      rw [MvPolynomial.eval₂_rename]
      have hc : b' ∘ Fin.natAdd n = fun j => (θ.comp e) (q (MvPolynomial.X j)) :=
        funext fun j => Fin.append_right _ _ j
      rw [hc, hev]
      have hk : g0 ∈ RingHom.ker q.toRingHom := by
        rw [← hG]; exact Submodule.subset_span hg0
      rw [RingHom.mem_ker] at hk
      show (θ.comp e) (q g0) = 0
      rw [show q g0 = 0 from hk, map_zero]

  obtain ⟨D, _, _, _, c, γ, hγ, hcS, hcb⟩ := hP (n + m) S' b' hS'
  have hK : RingHom.ker q.toRingHom ≤ RingHom.ker
      (MvPolynomial.aeval (fun j => c (Fin.natAdd n j)) :
        MvPolynomial (Fin m) P →ₐ[P] D).toRingHom := by
    rw [← hG, Submodule.span_le]
    intro g0 hg0
    rw [SetLike.mem_coe, RingHom.mem_ker]
    show MvPolynomial.aeval (fun j => c (Fin.natAdd n j)) g0 = 0
    have h1 := hcS _ (Finset.mem_union_right _ (Finset.mem_image_of_mem _ hg0))
    rw [MvPolynomial.aeval_rename] at h1
    exact h1
  let κ : E →ₐ[P] D := q.liftOfSurjective hq _ hK
  have hκq : ∀ p, κ (q p) = MvPolynomial.aeval (fun j => c (Fin.natAdd n j)) p :=
    fun p => q.liftOfSurjective_apply hq _ hK p
  letI : Algebra E D := κ.toRingHom.toAlgebra
  haveI : IsScalarTower P E D := IsScalarTower.of_algebraMap_eq (fun r => (κ.commutes r).symm)
  haveI : Algebra.Smooth E D :=
    ⟨Algebra.FormallySmooth.of_restrictScalars P E D,
      Algebra.FinitePresentation.of_restrict_scalars_finitePresentation P E D⟩
  have hγκ : ∀ y : E, γ (κ y) = θ (e y) := by
    intro y
    obtain ⟨p, rfl⟩ := hq y
    rw [hκq, MvPolynomial.aeval_def, MvPolynomial.eval₂_comp_left, hγ]
    have hc : (⇑γ ∘ fun j => c (Fin.natAdd n j))
        = fun j => (θ.comp e) (q (MvPolynomial.X j)) := by
      funext j
      simp only [Function.comp_apply]
      rw [hcb]
      exact Fin.append_right _ _ j
    rw [hc, hθι, hev]
    rfl
  have hcE : ∀ f (hf : f ∈ s),
      MvPolynomial.aeval (R := E) (fun k => c (Fin.castAdd m k)) (pre f hf) = 0 := by
    intro f hf
    rw [MvPolynomial.aeval_def]
    change MvPolynomial.eval₂ κ.toRingHom (fun k => c (Fin.castAdd m k)) (pre f hf) = 0
    rw [← hlift (pre f hf) D κ.toRingHom (fun k => c (Fin.castAdd m k))]
    have h3 : κ.toRingHom.comp (algebraMap P E) = algebraMap P D := by
      ext r; exact κ.commutes r
    have h4 : Fin.append (fun k => c (Fin.castAdd m k))
        (fun j => κ.toRingHom (q (MvPolynomial.X j))) = c := by
      funext k
      induction k using Fin.addCases with
      | left i => rw [Fin.append_left]
      | right j =>
        rw [Fin.append_right]
        show κ (q (MvPolynomial.X j)) = c (Fin.natAdd n j)
        rw [hκq, MvPolynomial.aeval_X]
    rw [h3, h4, ← MvPolynomial.aeval_def]
    exact hcS _ (Finset.mem_union_left _
      (Finset.mem_image.mpr ⟨⟨f, hf⟩, Finset.mem_attach _ _, rfl⟩))

  letI : Algebra E H := e.toAlgebra
  letI : Algebra E T := (θ.comp e).toAlgebra
  let f₁ : H →ₐ[E] T := { θ with commutes' := fun r => rfl }
  let f₂ : D →ₐ[E] T := { γ with commutes' := fun r => hγκ r }
  refine ⟨TensorProduct E H D, inferInstance, inferInstance, Algebra.Smooth.baseChange E D H,
    fun k => (1 : H) ⊗ₜ[E] c (Fin.castAdd m k),
    (Algebra.TensorProduct.productMap f₁ f₂).toRingHom, ?_, ?_, ?_⟩
  · refine RingHom.ext fun h => ?_
    rw [RingHom.comp_apply, Algebra.TensorProduct.algebraMap_apply, Algebra.algebraMap_self,
      RingHom.id_apply]
    show Algebra.TensorProduct.productMap f₁ f₂ (h ⊗ₜ[E] (1 : D)) = θ h
    rw [Algebra.TensorProduct.productMap_apply_tmul]
    show θ h * γ 1 = θ h
    rw [map_one, mul_one]
  · intro f hf
    rw [← hpre' f hf]
    have hmap : MvPolynomial.map e (pre f hf) = MvPolynomial.map (algebraMap E H) (pre f hf) := rfl
    rw [hmap, MvPolynomial.aeval_map_algebraMap]
    have h5 := congrArg (fun ψ => ψ (pre f hf))
      (MvPolynomial.comp_aeval (fun k => c (Fin.castAdd m k))
        (Algebra.TensorProduct.includeRight (R := E) (A := H) (B := D)))
    simp only [AlgHom.comp_apply, Algebra.TensorProduct.includeRight_apply] at h5
    rw [← h5, hcE f hf, TensorProduct.tmul_zero]
  · intro k
    show Algebra.TensorProduct.productMap f₁ f₂ ((1 : H) ⊗ₜ[E] c (Fin.castAdd m k)) = b k
    rw [Algebra.TensorProduct.productMap_apply_tmul]
    show θ 1 * γ (c (Fin.castAdd m k)) = b k
    rw [map_one, one_mul, hcb]
    exact Fin.append_left _ _ k

theorem wc_henselian_noetherian_approx_system : ∀ (A : Type u) [CommRing A] [HenselianLocalRing A],
    ∃ Λ : Finset A → Subring A, Monotone Λ ∧ (∀ S, ∀ a ∈ S, a ∈ Λ S) ∧
    ∀ S, ∃ (_ : HenselianLocalRing ↥(Λ S)), IsNoetherianRing ↥(Λ S) ∧ IsLocalHom (Λ S).subtype ∧
      ∃ (B : Type u) (_ : CommRing B) (_ : IsLocalRing B) (_ : IsNoetherianRing B)
        (_ : IsAdicComplete (IsLocalRing.maximalIdeal B) B) (φ : ↥(Λ S) →+* B), IsLocalHom φ ∧
        (∀ b : B, ∃ a : ↥(Λ S), b - φ a ∈ IsLocalRing.maximalIdeal B) ∧
        (∀ (n : ℕ) (s : Finset (MvPolynomial (Fin n) ↥(Λ S))) (b : Fin n → B),
          (∀ f ∈ s, MvPolynomial.eval₂ φ b f = 0) →
          ∃ a : Fin n → ↥(Λ S), (∀ f ∈ s, MvPolynomial.eval a f = 0) ∧
            ∀ k, b k - φ (a k) ∈ IsLocalRing.maximalIdeal B) :=
by
  intro A _ _
  classical
  obtain ⟨hs1a, hs1b⟩ := wc_hnas_local_subring_localizations A
  choose hft hPn g hgloc hgcomp using hs1a
  have h2 := fun S : Finset A => @wc_hnas_henselization_exists
    (Localization.AtPrime ((IsLocalRing.maximalIdeal A).comap (Subring.closure (S : Set A)).subtype))
    _ _ (hPn S)
  choose H instH henH noethH ι hιloc hres hmeq hU hchart using h2
  have hex := fun S : Finset A => hU S A (g S) (hgloc S)
  choose h hh huniq using hex
  refine ⟨fun S => (h S).range, ?_, ?_, ?_⟩
  ·
    intro S S' hSS'
    obtain ⟨t, htloc, htcomp⟩ := hs1b S S' hSS'
    haveI := hιloc S'
    haveI := htloc
    obtain ⟨k, ⟨hkloc, hkcomp⟩, -⟩ := hU S (H S') ((ι S').comp t) inferInstance
    haveI := hkloc
    haveI := (hh S').1
    have heq : (h S').comp k = h S := by
      apply huniq S
      refine ⟨inferInstance, ?_⟩
      rw [RingHom.comp_assoc, hkcomp, ← RingHom.comp_assoc, (hh S').2,
        htcomp (g S) (g S') (hgcomp S) (hgcomp S')]
    rintro y ⟨x, rfl⟩
    exact ⟨k x, by rw [← heq]; rfl⟩
  ·
    intro S a ha
    refine ⟨ι S (algebraMap ↥(Subring.closure (S : Set A)) _ ⟨a, Subring.subset_closure ha⟩), ?_⟩
    rw [← RingHom.comp_apply, (hh S).2, ← RingHom.comp_apply, hgcomp S]
    rfl
  · intro S
    haveI := (hh S).1
    obtain ⟨hhen, hloc⟩ := wc_hnas_range_henselian (H S) A (h S) (hh S).1
    refine ⟨hhen, ?_, hloc, ?_⟩
    · exact isNoetherianRing_of_surjective (H S) _ (h S).rangeRestrict
        (h S).rangeRestrict_surjective
    · obtain ⟨hCloc, hCcomp, hθloc, hθres⟩ := wc_hnas_completion_local_complete (H S)
      haveI := hCloc
      haveI := hCcomp
      haveI := wc_hnas_completion_noetherian (H S)
      haveI := hft S
      have hpop := wc_hnas_popescu_factor_completion ↥(Subring.closure (S : Set A))
        ((IsLocalRing.maximalIdeal A).comap (Subring.closure (S : Set A)).subtype) (H S) (ι S)
        (hιloc S) (hres S) (hmeq S) (hU S) (hchart S)
      have htr := wc_hnas_smooth_factor_transfer_etale _ (H S) (ι S)
        (AdicCompletion (IsLocalRing.maximalIdeal (H S)) (H S))
        (algebraMap (H S) (AdicCompletion (IsLocalRing.maximalIdeal (H S)) (H S))) (hchart S) hpop
      have happ := wc_hnas_approx_of_smooth_factor (H S)
        (AdicCompletion (IsLocalRing.maximalIdeal (H S)) (H S))
        (algebraMap (H S) (AdicCompletion (IsLocalRing.maximalIdeal (H S)) (H S))) hθloc hθres
        (wc_hnas_smooth_section_henselian (H S)) htr
      exact wc_hnas_approx_to_range wc_hnas_quotient_complete (H S)
        (AdicCompletion (IsLocalRing.maximalIdeal (H S)) (H S))
        (algebraMap (H S) (AdicCompletion (IsLocalRing.maximalIdeal (H S)) (H S))) hθloc hθres
        happ A (h S)

theorem wc_fet_lfp_model_over_subring : ∀ (A : Type u) [CommRing A] (Λ : Finset A → Subring A), (∀ S, ∀ a ∈ S, a ∈ Λ S) → ∀ (Z : Scheme.{u}) (h : Z ⟶ Spec (.of A)) [IsProper h] [LocallyOfFinitePresentation h], ∃ (S : Finset A) (Y : Scheme.{u}) (hY : Y ⟶ Spec (.of ↥(Λ S))) (π : Z ⟶ Y), IsProper hY ∧ IsPullback π h hY (Spec.map (CommRingCat.ofHom (Λ S).subtype)) :=
by
  intro A _ Λ hcov Z h _ _

  have s4 : ∀ (S : Finset A), IsNoetherianRing ↥(Subring.closure (S : Set A)) := by
    intro S
    let φ : MvPolynomial ↥(S : Set A) ℤ →+* ↥(Subring.closure (S : Set A)) :=
      MvPolynomial.eval₂Hom (Int.castRingHom _) (fun s => ⟨s.1, Subring.subset_closure s.2⟩)
    have hsurj : Function.Surjective φ := by
      intro x
      have hle : Subring.closure (S : Set A) ≤
          φ.range.map (Subring.closure (S : Set A)).subtype := by
        rw [Subring.closure_le]
        intro s hs
        refine Subring.mem_map.mpr ⟨φ (MvPolynomial.X ⟨s, hs⟩), ⟨_, rfl⟩, ?_⟩
        simp [φ]
      obtain ⟨y, hy, hyx⟩ := Subring.mem_map.mp (hle x.2)
      obtain ⟨p, rfl⟩ := RingHom.mem_range.mp hy
      exact ⟨p, Subtype.ext hyx⟩
    exact isNoetherianRing_of_surjective _ _ φ hsurj

  have s5 : ∀ (B B' : Subring A) (hBB' : B ≤ B') (X₀ : Scheme.{u}) (g : X₀ ⟶ Spec (.of ↥B)),
      ∃ Φ : Limits.pullback (Limits.pullback.snd g (Spec.map (CommRingCat.ofHom (Subring.inclusion hBB'))))
          (Spec.map (CommRingCat.ofHom B'.subtype)) ≅ Limits.pullback g (Spec.map (CommRingCat.ofHom B.subtype)),
        Φ.hom ≫ Limits.pullback.snd g (Spec.map (CommRingCat.ofHom B.subtype)) =
          Limits.pullback.snd (Limits.pullback.snd g (Spec.map (CommRingCat.ofHom (Subring.inclusion hBB'))))
            (Spec.map (CommRingCat.ofHom B'.subtype)) := by
    intro B B' hBB' X₀ g
    have hg : Spec.map (CommRingCat.ofHom B'.subtype) ≫ Spec.map (CommRingCat.ofHom (Subring.inclusion hBB')) =
        Spec.map (CommRingCat.ofHom B.subtype) := by
      rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
      rfl
    refine ⟨Limits.pullbackLeftPullbackSndIso _ _ _ ≪≫ Limits.pullback.congrHom rfl hg, ?_⟩
    simp only [Iso.trans_hom, Category.assoc, Limits.pullback.congrHom_hom]
    erw [Limits.pullback.lift_snd, Category.comp_id]
    exact Limits.pullbackLeftPullbackSndIso_hom_snd _ _ _

  have key : ∃ (S : Finset A) (Y₂ : Scheme.{u})
      (h₂ : Y₂ ⟶ Spec (.of ↥(Subring.closure (S : Set A)))) (_ : IsProper h₂)
      (e : Z ⟶ Limits.pullback h₂ (Spec.map (CommRingCat.ofHom (Subring.closure (S : Set A)).subtype))),
      IsIso e ∧ e ≫ Limits.pullback.snd h₂ (Spec.map (CommRingCat.ofHom (Subring.closure (S : Set A)).subtype)) = h := by
    obtain ⟨S₀, Y₀, h₀, hqc₀, hqs₀, hlfp₀, e₀, he₀, he₀h⟩ := wc_ap_fp_scheme_descends_to_finset A Z h
    haveI := hqc₀
    haveI := hqs₀
    haveI := hlfp₀
    haveI := he₀
    have hsnd₀ : Limits.pullback.snd h₀ (Spec.map (CommRingCat.ofHom (Subring.closure (S₀ : Set A)).subtype)) =
        inv e₀ ≫ h := by
      rw [← he₀h, IsIso.inv_hom_id_assoc]
    have hsepA : IsSeparated (Limits.pullback.snd h₀
        (Spec.map (CommRingCat.ofHom (Subring.closure (S₀ : Set A)).subtype))) := by
      rw [hsnd₀]; infer_instance
    obtain ⟨S₁, hS₁, hsep₁⟩ := wc_ap_separated_descends_to_finset A S₀ Y₀ h₀ hsepA
    haveI := hsep₁
    obtain ⟨Φ₁, hΦ₁⟩ := s5 _ _ hS₁ Y₀ h₀
    have hucA : UniversallyClosed (Limits.pullback.snd
        (Limits.pullback.snd h₀ (Spec.map (CommRingCat.ofHom (Subring.inclusion hS₁))))
        (Spec.map (CommRingCat.ofHom (Subring.closure (S₁ : Set A)).subtype))) := by
      rw [← hΦ₁, hsnd₀]; infer_instance
    haveI := s4 S₁
    obtain ⟨S₂, hS₂, huc₂⟩ := wc_ap_universally_closed_descends_to_finset A S₁ _
      (Limits.pullback.snd h₀ (Spec.map (CommRingCat.ofHom (Subring.inclusion hS₁)))) hucA
    haveI := huc₂
    obtain ⟨Φ₂, hΦ₂⟩ := s5 _ _ hS₂ _
      (Limits.pullback.snd h₀ (Spec.map (CommRingCat.ofHom (Subring.inclusion hS₁))))
    haveI hprop : IsProper (Limits.pullback.snd
        (Limits.pullback.snd h₀ (Spec.map (CommRingCat.ofHom (Subring.inclusion hS₁))))
        (Spec.map (CommRingCat.ofHom (Subring.inclusion hS₂)))) := ⟨⟩
    refine ⟨S₂, _, _, hprop, e₀ ≫ Φ₁.inv ≫ Φ₂.inv, inferInstance, ?_⟩
    rw [Category.assoc, Category.assoc, ← hΦ₂, Iso.inv_hom_id_assoc, ← hΦ₁, Iso.inv_hom_id_assoc, he₀h]
  obtain ⟨S, Y₂, h₂, hprop₂, e, he, heh⟩ := key
  haveI := hprop₂
  haveI := he

  have hι : Subring.closure (S : Set A) ≤ Λ S :=
    Subring.closure_le.mpr (fun a ha => hcov S a (Finset.mem_coe.mp ha))
  have hg : Spec.map (CommRingCat.ofHom (Λ S).subtype) ≫
      Spec.map (CommRingCat.ofHom (Subring.inclusion hι)) =
      Spec.map (CommRingCat.ofHom (Subring.closure (S : Set A)).subtype) := by
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
    rfl
  have w' : (e ≫ Limits.pullback.fst h₂ (Spec.map (CommRingCat.ofHom (Subring.closure (S : Set A)).subtype))) ≫ h₂ =
      h ≫ Spec.map (CommRingCat.ofHom (Subring.closure (S : Set A)).subtype) := by
    rw [Category.assoc, Limits.pullback.condition, ← Category.assoc, heh]
  have w : (e ≫ Limits.pullback.fst h₂ (Spec.map (CommRingCat.ofHom (Subring.closure (S : Set A)).subtype))) ≫ h₂ =
      (h ≫ Spec.map (CommRingCat.ofHom (Λ S).subtype)) ≫
        Spec.map (CommRingCat.ofHom (Subring.inclusion hι)) := by
    rw [w', Category.assoc, hg]
  refine ⟨S, Limits.pullback h₂ (Spec.map (CommRingCat.ofHom (Subring.inclusion hι))),
    Limits.pullback.snd h₂ (Spec.map (CommRingCat.ofHom (Subring.inclusion hι))),
    Limits.pullback.lift _ _ w, inferInstance, ?_⟩

  have hbig0 : IsPullback
      (e ≫ Limits.pullback.fst h₂ (Spec.map (CommRingCat.ofHom (Subring.closure (S : Set A)).subtype)))
      h h₂ (Spec.map (CommRingCat.ofHom (Subring.closure (S : Set A)).subtype)) :=
    IsPullback.of_iso_pullback ⟨w'⟩ (asIso e) rfl heh
  have hbig : IsPullback
      (Limits.pullback.lift _ _ w ≫ Limits.pullback.fst h₂ (Spec.map (CommRingCat.ofHom (Subring.inclusion hι))))
      h h₂ (Spec.map (CommRingCat.ofHom (Λ S).subtype) ≫ Spec.map (CommRingCat.ofHom (Subring.inclusion hι))) := by
    rw [Limits.pullback.lift_fst, hg]
    exact hbig0
  exact IsPullback.of_right hbig (Limits.pullback.lift_snd _ _ _)
    (IsPullback.of_hasPullback _ _)

theorem wc_fet_closed_fibre_limit_model : ∀ (A : Type u) [CommRing A] [IsLocalRing A] (Λ : Finset A → Subring A), Monotone Λ → (∀ S, ∀ a ∈ S, a ∈ Λ S) → ∀ (hloc : ∀ S, IsLocalRing ↥(Λ S)), (∀ S, IsLocalHom (Λ S).subtype) → ∀ (S₀ : Finset A) (Y : Scheme.{u}) (hY : Y ⟶ Spec (.of ↥(Λ S₀))) [IsProper hY] (Z Z₀ : Scheme.{u}) (h : Z ⟶ Spec (.of A)) (π : Z ⟶ Y), IsPullback π h hY (Spec.map (CommRingCat.ofHom (Λ S₀).subtype)) → ∀ (i : Z₀ ⟶ Z) (h₀ : Z₀ ⟶ Spec (.of (IsLocalRing.ResidueField A))), IsPullback i h₀ h (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A))) → ∃ (D : (Finset A)ᵒᵖ ⥤ Scheme.{u}) (ρ : (Functor.const (Finset A)ᵒᵖ).obj Z₀ ⟶ D), Nonempty (Limits.IsLimit (Limits.Cone.mk Z₀ ρ)) ∧ (∀ {a b : (Finset A)ᵒᵖ} (f : a ⟶ b), IsAffineHom (D.map f)) ∧ (∀ a, CompactSpace (D.obj a)) ∧ (∀ a, QuasiSeparatedSpace (D.obj a)) ∧ ∀ T : Finset A, ∃ (S : Finset A) (ZS : Scheme.{u}) (hS : ZS ⟶ Spec (.of ↥(Λ S))) (πS : Z ⟶ ZS) (iS : D.obj (Opposite.op T) ⟶ ZS) (h₀S : D.obj (Opposite.op T) ⟶ Spec (.of (IsLocalRing.ResidueField ↥(Λ S)))), IsProper hS ∧ IsPullback iS h₀S hS (Spec.map (CommRingCat.ofHom (IsLocalRing.residue ↥(Λ S)))) ∧ ρ.app (Opposite.op T) ≫ iS = i ≫ πS :=
by
  intro A _ _ Λ hmono hcov hloc hlh S₀ Y hY _ Z Z₀ h π hπ i h₀ hsq
  classical

  have s1 : ∀ (J : Type u) [SmallCategory J] [IsFiltered J] (G : J ⥤ CommRingCat.{u}) (κ : Limits.Cocone G), (∀ j, Function.Injective (κ.ι.app j)) → (∀ x : κ.pt, ∃ (j : J) (y : G.obj j), κ.ι.app j y = x) → Nonempty (Limits.IsColimit κ) := by
    intro J _ _ G κ hinj hsurj
    have ht : Limits.IsColimit ((forget CommRingCat).mapCocone κ) := by
      apply Limits.Types.FilteredColimit.isColimitOf
      · intro x
        obtain ⟨j, y, hy⟩ := hsurj x
        exact ⟨j, y, hy.symm⟩
      · intro i j xi xj h
        refine ⟨IsFiltered.max i j, IsFiltered.leftToMax i j, IsFiltered.rightToMax i j, ?_⟩
        apply hinj (IsFiltered.max i j)
        have e1 := congrArg (fun f => (ConcreteCategory.hom f) xi) (κ.w (IsFiltered.leftToMax i j))
        have e2 := congrArg (fun f => (ConcreteCategory.hom f) xj) (κ.w (IsFiltered.rightToMax i j))
        simp only [CommRingCat.comp_apply] at e1 e2
        change (κ.ι.app (IsFiltered.max i j)) ((G.map (IsFiltered.leftToMax i j)) xi) =
          (κ.ι.app (IsFiltered.max i j)) ((G.map (IsFiltered.rightToMax i j)) xj)
        rw [e1, e2]
        exact h
    have : Limits.ReflectsColimitsOfShape J (forget CommRingCat) :=
      Limits.reflectsColimitsOfShape_of_reflectsIsomorphisms
    exact ⟨Limits.isColimitOfReflects (forget CommRingCat) ht⟩

  have s2 : ∀ (J : Type u) [SmallCategory J] [IsFiltered J] (G : J ⥤ CommRingCat.{u}) (κ : Limits.Cocone G), Limits.IsColimit κ → ∀ (X Y₀ : Scheme.{u}) (h₀ : Y₀ ⟶ X) (q : ∀ j, Spec (G.obj j) ⟶ X), (∀ {i j : J} (f : i ⟶ j), Spec.map (G.map f) ≫ q i = q j) → ∀ (q₀ : Spec κ.pt ⟶ X), (∀ j, Spec.map (κ.ι.app j) ≫ q j = q₀) → ∃ (E : Jᵒᵖ ⥤ Scheme.{u}) (c : Limits.Cone E) (_ : Limits.IsLimit c) (fE : ∀ j, E.obj (Opposite.op j) ⟶ Spec (G.obj j)) (sE : ∀ j, E.obj (Opposite.op j) ⟶ Y₀) (fc : c.pt ⟶ Spec κ.pt) (sc : c.pt ⟶ Y₀), (∀ j, IsPullback (fE j) (sE j) (q j) h₀) ∧ IsPullback fc sc q₀ h₀ ∧ (∀ j, c.π.app (Opposite.op j) ≫ fE j = fc ≫ Spec.map (κ.ι.app j)) ∧ (∀ j, c.π.app (Opposite.op j) ≫ sE j = sc) ∧ (∀ {i j : Jᵒᵖ} (f : i ⟶ j), IsAffineHom (E.map f)) := by
    intro J _ _ G κ hκ X Y₀ h₀ q hq q₀ hq₀
    have hSpec : Limits.IsLimit (Scheme.Spec.mapCone κ.op) :=
      Limits.isLimitOfPreserves Scheme.Spec hκ.op
    let D₀ : Jᵒᵖ ⥤ Over X := (G.op ⋙ Scheme.Spec).toOver X (fun j => q j.unop)
      (fun g => hq g.unop)
    let c₀ : Limits.Cone D₀ :=
      { pt := Over.mk q₀
        π :=
          { app := fun j => Over.homMk (Spec.map (κ.ι.app j.unop)) (hq₀ j.unop)
            naturality := by
              intro j j' g
              apply Over.OverMorphism.ext
              change Spec.map (κ.ι.app j'.unop) =
                Spec.map (κ.ι.app j.unop) ≫ Spec.map (G.map g.unop)
              rw [← Spec.map_comp, κ.w] } }
    let α : G.op ⋙ Scheme.Spec ≅ D₀ ⋙ Over.forget X :=
      NatIso.ofComponents (fun _ => Iso.refl _) (by intros; rfl)
    have h1 : Limits.IsLimit ((Over.forget X).mapCone c₀) :=
      (Limits.IsLimit.equivOfNatIsoOfIso α _ _
        (Limits.Cone.ext (Iso.refl _) (fun j => by
          change Spec.map (κ.ι.app j.unop) ≫ 𝟙 _ = 𝟙 _ ≫ Spec.map (κ.ι.app j.unop)
          simp))) hSpec
    have := IsCofiltered.isConnected Jᵒᵖ
    have hc₀ : Limits.IsLimit c₀ := Limits.isLimitOfReflects (Over.forget X) h1
    let Φ : Over X ⥤ Scheme.{u} := Over.pullback h₀ ⋙ Over.forget Y₀
    have hc : Limits.IsLimit (Φ.mapCone c₀) := Limits.isLimitOfPreserves Φ hc₀
    refine ⟨D₀ ⋙ Φ, Φ.mapCone c₀, hc, fun j => Limits.pullback.fst (q j) h₀,
      fun j => Limits.pullback.snd (q j) h₀, Limits.pullback.fst q₀ h₀, Limits.pullback.snd q₀ h₀,
      fun j => IsPullback.of_hasPullback (q j) h₀, IsPullback.of_hasPullback q₀ h₀,
      fun j => Limits.pullback.lift_fst _ _ _, fun j => Limits.pullback.lift_snd _ _ _, ?_⟩
    intro i j g
    let m : Limits.pullback (q i.unop) h₀ ⟶ Limits.pullback (q j.unop) h₀ := (D₀ ⋙ Φ).map g
    have e1 : m ≫ Limits.pullback.snd (q j.unop) h₀ =
        Limits.pullback.snd (q i.unop) h₀ := Limits.pullback.lift_snd _ _ _
    have e2 : m ≫ Limits.pullback.fst (q j.unop) h₀ =
        Limits.pullback.fst (q i.unop) h₀ ≫ Spec.map (G.map g.unop) :=
      Limits.pullback.lift_fst _ _ _
    have hL : IsPullback m (Limits.pullback.fst (q i.unop) h₀)
        (Limits.pullback.fst (q j.unop) h₀) (Spec.map (G.map g.unop)) := by
      refine IsPullback.of_right (h₁₂ := Limits.pullback.snd (q j.unop) h₀) (v₁₃ := h₀)
        (h₂₂ := q j.unop) ?_ e2 (IsPullback.of_hasPullback (q j.unop) h₀).flip
      rw [e1, hq g.unop]
      exact (IsPullback.of_hasPullback (q i.unop) h₀).flip
    have : IsAffineHom (Spec.map (G.map g.unop)) := isAffineHom_of_isAffine _
    have : IsAffineHom m :=
      MorphismProperty.of_isPullback (P := @IsAffineHom) hL.flip inferInstance
    exact this

  have hmono' : ∀ {T T' : Finset A}, T ≤ T' → Λ (S₀ ∪ T) ≤ Λ (S₀ ∪ T') := fun hTT' =>
    hmono (Finset.union_subset_union (Finset.Subset.refl S₀) hTT')
  have hinc : ∀ (S S' : Finset A) (hle : Λ S ≤ Λ S'), IsLocalHom (Subring.inclusion hle) := by
    intro S S' hle
    refine ⟨fun a ha => ?_⟩
    have h2 : IsUnit ((Λ S').subtype (Subring.inclusion hle a)) := ha.map _
    exact (hlh S).map_nonunit a h2
  let G : Finset A ⥤ CommRingCat.{u} :=
    { obj := fun T => CommRingCat.of (IsLocalRing.ResidueField (Λ (S₀ ∪ T)))
      map := fun {T T'} f => CommRingCat.ofHom
        (IsLocalRing.ResidueField.map (Subring.inclusion (hmono' (leOfHom f))))
      map_id := fun T => by
        ext x
        obtain ⟨y, rfl⟩ := IsLocalRing.residue_surjective x
        change IsLocalRing.ResidueField.map _ (IsLocalRing.residue _ y) = IsLocalRing.residue _ y
        rw [IsLocalRing.ResidueField.map_residue]
        rfl
      map_comp := fun {T T' T''} f g => by
        ext x
        obtain ⟨y, rfl⟩ := IsLocalRing.residue_surjective x
        change IsLocalRing.ResidueField.map _ (IsLocalRing.residue _ y) =
          IsLocalRing.ResidueField.map _ (IsLocalRing.ResidueField.map _ (IsLocalRing.residue _ y))
        rw [IsLocalRing.ResidueField.map_residue, IsLocalRing.ResidueField.map_residue,
          IsLocalRing.ResidueField.map_residue]
        rfl }
  let κ : Limits.Cocone G :=
    { pt := CommRingCat.of (IsLocalRing.ResidueField A)
      ι :=
        { app := fun T => CommRingCat.ofHom (IsLocalRing.ResidueField.map (Λ (S₀ ∪ T)).subtype)
          naturality := fun {T T'} f => by
            ext x
            obtain ⟨y, rfl⟩ := IsLocalRing.residue_surjective x
            change IsLocalRing.ResidueField.map _ (IsLocalRing.ResidueField.map _
              (IsLocalRing.residue _ y)) = IsLocalRing.ResidueField.map _ (IsLocalRing.residue _ y)
            rw [IsLocalRing.ResidueField.map_residue, IsLocalRing.ResidueField.map_residue,
              IsLocalRing.ResidueField.map_residue]
            rfl } }
  let r : ∀ T : Finset A, CommRingCat.of ↥(Λ (S₀ ∪ T)) ⟶ G.obj T :=
    fun T => CommRingCat.ofHom (IsLocalRing.residue ↥(Λ (S₀ ∪ T)))
  let r₀ : CommRingCat.of A ⟶ κ.pt := CommRingCat.ofHom (IsLocalRing.residue A)
  have hinj : ∀ T, Function.Injective (κ.ι.app T) := fun T =>
    RingHom.injective (IsLocalRing.ResidueField.map (Λ (S₀ ∪ T)).subtype)
  have hsurj : ∀ x : κ.pt, ∃ (T : Finset A) (y : G.obj T), κ.ι.app T y = x := by
    intro x
    obtain ⟨a, rfl⟩ := IsLocalRing.residue_surjective x
    have ha : a ∈ Λ (S₀ ∪ {a}) :=
      hcov (S₀ ∪ {a}) a (Finset.mem_union_right _ (Finset.mem_singleton_self a))
    refine ⟨{a}, IsLocalRing.residue _ ⟨a, ha⟩, ?_⟩
    change IsLocalRing.ResidueField.map _ (IsLocalRing.residue _ _) = _
    rw [IsLocalRing.ResidueField.map_residue]
    rfl
  have hκr : ∀ T, r T ≫ κ.ι.app T = CommRingCat.ofHom (Λ (S₀ ∪ T)).subtype ≫ r₀ := by
    intro T
    ext y
    change IsLocalRing.ResidueField.map _ (IsLocalRing.residue _ y) = IsLocalRing.residue A y
    rw [IsLocalRing.ResidueField.map_residue]
    rfl
  have hGr : ∀ {T T' : Finset A} (f : T ⟶ T'),
      r T ≫ G.map f = CommRingCat.ofHom (Subring.inclusion (hmono' (leOfHom f))) ≫ r T' := by
    intro T T' f
    ext y
    change IsLocalRing.ResidueField.map _ (IsLocalRing.residue _ y) = IsLocalRing.residue _ _
    rw [IsLocalRing.ResidueField.map_residue]
    rfl
  obtain ⟨hκ⟩ := s1 (Finset A) G κ hinj hsurj

  let ψ : ∀ T : Finset A, ↥(Λ S₀) →+* ↥(Λ (S₀ ∪ T)) := fun T =>
    (Λ S₀).subtype.codRestrict (Λ (S₀ ∪ T)) (fun b => hmono Finset.subset_union_left b.2)
  let q : ∀ T, Spec (G.obj T) ⟶ Spec (.of ↥(Λ S₀)) :=
    fun T => Spec.map (r T) ≫ Spec.map (CommRingCat.ofHom (ψ T))
  let q₀ : Spec κ.pt ⟶ Spec (.of ↥(Λ S₀)) :=
    Spec.map r₀ ≫ Spec.map (CommRingCat.ofHom (Λ S₀).subtype)
  have I1 : ∀ {T T' : Finset A} (f : T ⟶ T'), CommRingCat.ofHom (ψ T) ≫
      CommRingCat.ofHom (Subring.inclusion (hmono' (leOfHom f))) = CommRingCat.ofHom (ψ T') := by
    intro T T' f
    ext b
    rfl
  have I2 : ∀ T, CommRingCat.ofHom (ψ T) ≫ CommRingCat.ofHom (Λ (S₀ ∪ T)).subtype =
      CommRingCat.ofHom (Λ S₀).subtype := by
    intro T
    ext b
    rfl
  have hq : ∀ {T T' : Finset A} (f : T ⟶ T'), Spec.map (G.map f) ≫ q T = q T' := by
    intro T T' f
    have e : (CommRingCat.ofHom (ψ T) ≫ r T) ≫ G.map f = CommRingCat.ofHom (ψ T') ≫ r T' := by
      rw [Category.assoc, hGr f, ← Category.assoc, I1 f]
    calc Spec.map (G.map f) ≫ q T = Spec.map ((CommRingCat.ofHom (ψ T) ≫ r T) ≫ G.map f) := by
          simp only [q, Spec.map_comp, Category.assoc]
      _ = q T' := by rw [e]; simp only [q, Spec.map_comp]
  have hq₀ : ∀ T, Spec.map (κ.ι.app T) ≫ q T = q₀ := by
    intro T
    have e : (CommRingCat.ofHom (ψ T) ≫ r T) ≫ κ.ι.app T =
        CommRingCat.ofHom (Λ S₀).subtype ≫ r₀ := by
      rw [Category.assoc, hκr T, ← Category.assoc, I2]
    calc Spec.map (κ.ι.app T) ≫ q T = Spec.map ((CommRingCat.ofHom (ψ T) ≫ r T) ≫ κ.ι.app T) := by
          simp only [q, Spec.map_comp, Category.assoc]
      _ = q₀ := by rw [e]; simp only [q₀, Spec.map_comp]
  obtain ⟨E, c, hc, fE, sE, fc, sc, hpb, hpb₀, hcf, hcs, haff⟩ :=
    s2 (Finset A) G κ hκ (Spec (.of ↥(Λ S₀))) Y hY q hq q₀ hq₀

  have hZ : IsPullback h₀ (i ≫ π) q₀ hY := (hsq.paste_horiz hπ).flip
  let φ : Z₀ ≅ c.pt := IsPullback.isoIsPullback _ _ hZ hpb₀
  have hφf : φ.hom ≫ fc = h₀ := IsPullback.isoIsPullback_hom_fst _ _ hZ hpb₀
  have hφs : φ.hom ≫ sc = i ≫ π := IsPullback.isoIsPullback_hom_snd _ _ hZ hpb₀

  let ρ : (Functor.const (Finset A)ᵒᵖ).obj Z₀ ⟶ E :=
    (Functor.const (Finset A)ᵒᵖ).map φ.hom ≫ c.π
  have hprop : ∀ T, IsProper (fE T) := fun T =>
    MorphismProperty.of_isPullback (P := @IsProper) (hpb T).flip inferInstance
  refine ⟨E, ρ, ⟨Limits.IsLimit.ofIsoLimit hc (Limits.Cone.ext φ (fun j => rfl)).symm⟩, haff,
    ?_, ?_, ?_⟩
  · intro a
    obtain ⟨T⟩ := a
    have := hprop T
    exact QuasiCompact.compactSpace_of_compactSpace (fE T)
  · intro a
    obtain ⟨T⟩ := a
    have := hprop T
    exact quasiSeparatedSpace_of_quasiSeparated (fE T)

  intro T
  have wπ : π ≫ hY = (h ≫ Spec.map (CommRingCat.ofHom (Λ (S₀ ∪ T)).subtype)) ≫
      Spec.map (CommRingCat.ofHom (ψ T)) := by
    rw [Category.assoc, ← Spec.map_comp, I2 T]
    exact hπ.w
  have wi : sE T ≫ hY = (fE T ≫ Spec.map (r T)) ≫ Spec.map (CommRingCat.ofHom (ψ T)) := by
    rw [Category.assoc]
    exact (hpb T).w.symm
  let πS : Z ⟶ Limits.pullback hY (Spec.map (CommRingCat.ofHom (ψ T))) :=
    Limits.pullback.lift π (h ≫ Spec.map (CommRingCat.ofHom (Λ (S₀ ∪ T)).subtype)) wπ
  let iS : E.obj (Opposite.op T) ⟶ Limits.pullback hY (Spec.map (CommRingCat.ofHom (ψ T))) :=
    Limits.pullback.lift (sE T) (fE T ≫ Spec.map (r T)) wi
  have hπS1 : πS ≫ Limits.pullback.fst _ _ = π := Limits.pullback.lift_fst _ _ _
  have hπS2 : πS ≫ Limits.pullback.snd _ _ =
      h ≫ Spec.map (CommRingCat.ofHom (Λ (S₀ ∪ T)).subtype) := Limits.pullback.lift_snd _ _ _
  have hiS1 : iS ≫ Limits.pullback.fst _ _ = sE T := Limits.pullback.lift_fst _ _ _
  have hiS2 : iS ≫ Limits.pullback.snd _ _ = fE T ≫ Spec.map (r T) :=
    Limits.pullback.lift_snd _ _ _
  have hpbS : IsPullback iS (fE T) (Limits.pullback.snd hY (Spec.map (CommRingCat.ofHom (ψ T))))
      (Spec.map (r T)) := by
    refine IsPullback.of_right (h₁₂ := Limits.pullback.fst hY (Spec.map (CommRingCat.ofHom (ψ T))))
      (v₁₃ := hY) (h₂₂ := Spec.map (CommRingCat.ofHom (ψ T))) ?_ hiS2
      (IsPullback.of_hasPullback hY _)
    rw [hiS1]
    exact (hpb T).flip
  have key : Spec.map (κ.ι.app T) ≫ Spec.map (r T) =
      Spec.map r₀ ≫ Spec.map (CommRingCat.ofHom (Λ (S₀ ∪ T)).subtype) := by
    rw [← Spec.map_comp, ← Spec.map_comp, hκr T]
  refine ⟨S₀ ∪ T, Limits.pullback hY (Spec.map (CommRingCat.ofHom (ψ T))),
    Limits.pullback.snd _ _, πS, iS, fE T, inferInstance, hpbS, ?_⟩
  change (φ.hom ≫ c.π.app (Opposite.op T)) ≫ iS = i ≫ πS
  apply Limits.pullback.hom_ext
  · simp only [Category.assoc]
    rw [hiS1, hcs, hφs, hπS1]
  · simp only [Category.assoc]
    rw [hiS2, reassoc_of% (hcf T), reassoc_of% hφf, key, ← reassoc_of% hsq.w, hπS2]

theorem wc_fet_ext_lfp_of_subring_system : ∀ (A : Type u) [CommRing A] [IsLocalRing A] (Λ : Finset A → Subring A), Monotone Λ →
    (∀ S, ∀ a ∈ S, a ∈ Λ S) → ∀ (hloc : ∀ S, IsLocalRing ↥(Λ S)), (∀ S, IsLocalHom (Λ S).subtype) →
    (∀ S (Z Z₀ : Scheme.{u}) (h : Z ⟶ Spec (.of ↥(Λ S))) [IsProper h] (i : Z₀ ⟶ Z)
      (h₀ : Z₀ ⟶ Spec (.of (IsLocalRing.ResidueField ↥(Λ S)))),
      IsPullback i h₀ h (Spec.map (CommRingCat.ofHom (IsLocalRing.residue ↥(Λ S)))) →
      ∀ (V₀ : Scheme.{u}) (p₀ : V₀ ⟶ Z₀), IsFinite p₀ → Etale p₀ →
      ∃ (V : Scheme.{u}) (p : V ⟶ Z) (j : V₀ ⟶ V), IsFinite p ∧ Etale p ∧ IsPullback j p₀ p i) →
    ∀ (Z Z₀ : Scheme.{u}) (h : Z ⟶ Spec (.of A)) [IsProper h] [LocallyOfFinitePresentation h]
      (i : Z₀ ⟶ Z) (h₀ : Z₀ ⟶ Spec (.of (IsLocalRing.ResidueField A))),
      IsPullback i h₀ h (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A))) →
      ∀ (V₀ : Scheme.{u}) (p₀ : V₀ ⟶ Z₀), IsFinite p₀ → Etale p₀ →
      ∃ (V : Scheme.{u}) (p : V ⟶ Z) (j : V₀ ⟶ V), IsFinite p ∧ Etale p ∧ IsPullback j p₀ p i :=
by
  intro A _ _ Λ hmono hcov hloc hlh hES Z Z₀ h _ _ i h₀ hsq V₀ p₀ hf he

  obtain ⟨S₀, Y, hY, π, hYp, hπ⟩ := wc_fet_lfp_model_over_subring A Λ hcov Z h
  haveI := hYp

  obtain ⟨D, ρ, ⟨hlim⟩, haff, hcpt, hqs, hT⟩ :=
    wc_fet_closed_fibre_limit_model A Λ hmono hcov hloc hlh S₀ Y hY Z Z₀ h π hπ i h₀ hsq

  have hp₀a : IsAffineHom p₀ := inferInstance
  have hp₀l : LocallyOfFinitePresentation p₀ := inferInstance
  obtain ⟨i₁, V₁, p₁, j₁, hp₁a, hp₁l, hj₁⟩ :=
    wc_limit_affine_lfp_descend (Finset A)ᵒᵖ D (Limits.Cone.mk Z₀ ρ) hlim haff hcpt hqs V₀ p₀
      hp₀a hp₀l

  obtain ⟨i₂, f, hp₂f, hp₂e⟩ :=
    wc_limit_finite_etale_spread (Finset A)ᵒᵖ D (Limits.Cone.mk Z₀ ρ) hlim haff hcpt hqs i₁ V₁ p₁
      V₀ p₀ j₁ hp₁a hp₁l hj₁ hf he
  have hcw : ρ.app i₂ ≫ D.map f = ρ.app i₁ := (Limits.Cone.mk Z₀ ρ).w f
  have w₁ : j₁ ≫ p₁ = (p₀ ≫ ρ.app i₂) ≫ D.map f := by
    rw [Category.assoc, hcw]
    exact hj₁.w
  let j₂ : V₀ ⟶ Limits.pullback p₁ (D.map f) := Limits.pullback.lift j₁ (p₀ ≫ ρ.app i₂) w₁
  have hj₂f : j₂ ≫ Limits.pullback.fst p₁ (D.map f) = j₁ := Limits.pullback.lift_fst _ _ _
  have hj₂s : j₂ ≫ Limits.pullback.snd p₁ (D.map f) = p₀ ≫ ρ.app i₂ :=
    Limits.pullback.lift_snd _ _ _
  have hj₂ : IsPullback j₂ p₀ (Limits.pullback.snd p₁ (D.map f)) (ρ.app i₂) := by
    have hbig : IsPullback (j₂ ≫ Limits.pullback.fst p₁ (D.map f)) p₀ p₁
        (ρ.app i₂ ≫ D.map f) := by
      rw [hj₂f, hcw]
      exact hj₁
    exact IsPullback.of_right hbig hj₂s (IsPullback.of_hasPullback p₁ (D.map f))

  obtain ⟨S, ZS, hS, πS, iS, h₀S, hSp, hpbS, hcomm⟩ := hT i₂.unop
  haveI := hSp
  obtain ⟨W, q, k, hqf, hqe, hk⟩ := hES S ZS (D.obj i₂) hS iS h₀S hpbS
    (Limits.pullback p₁ (D.map f)) (Limits.pullback.snd p₁ (D.map f)) hp₂f hp₂e

  have hcomm' : ρ.app i₂ ≫ iS = i ≫ πS := hcomm
  have w₂ : (j₂ ≫ k) ≫ q = (p₀ ≫ i) ≫ πS := by
    rw [Category.assoc, hk.w, ← Category.assoc, hj₂s, Category.assoc, hcomm', Category.assoc]
  let j : V₀ ⟶ Limits.pullback q πS := Limits.pullback.lift (j₂ ≫ k) (p₀ ≫ i) w₂
  have hjf : j ≫ Limits.pullback.fst q πS = j₂ ≫ k := Limits.pullback.lift_fst _ _ _
  have hjs : j ≫ Limits.pullback.snd q πS = p₀ ≫ i := Limits.pullback.lift_snd _ _ _
  refine ⟨Limits.pullback q πS, Limits.pullback.snd q πS, j, ?_, ?_, ?_⟩
  · exact MorphismProperty.of_isPullback (P := @IsFinite) (IsPullback.of_hasPullback q πS) hqf
  · exact MorphismProperty.of_isPullback (P := @Etale) (IsPullback.of_hasPullback q πS) hqe
  · have hbig : IsPullback (j ≫ Limits.pullback.fst q πS) p₀ q (i ≫ πS) := by
      rw [hjf, ← hcomm']
      exact hj₂.paste_horiz hk
    exact IsPullback.of_right hbig hjs (IsPullback.of_hasPullback q πS)

theorem wc_proper_henselian_fet_ext : ∀ (A : Type u) [CommRing A] [HenselianLocalRing A] (Z Z₀ : Scheme.{u}) (h : Z ⟶ Spec (.of A))
    [IsProper h] (i : Z₀ ⟶ Z) (h₀ : Z₀ ⟶ Spec (.of (IsLocalRing.ResidueField A))),
    IsPullback i h₀ h (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A))) →
    ∀ (V₀ : Scheme.{u}) (p₀ : V₀ ⟶ Z₀), IsFinite p₀ → Etale p₀ →
    ∃ (V : Scheme.{u}) (p : V ⟶ Z) (j : V₀ ⟶ V), IsFinite p ∧ Etale p ∧ IsPullback j p₀ p i :=
by
  intro A _ _ Z Z₀ h _ i h₀ hsq V₀ p₀ hf he

  obtain ⟨Y, hY, hYp, hYl, ι, hι, hιh⟩ := wc_ap_closed_immersion_into_fp_proper A Z h
  haveI := hYp
  haveI := hYl
  haveI := hι

  obtain ⟨Z', h', hp', hl', κ, hκ, hκh, hsub⟩ := wc_ap_fp_proper_shrink_closed_fibre A Z Y hY ι
  haveI := hp'
  haveI := hl'
  haveI := hκ
  have hκh' : κ ≫ h' = h := hκh.trans hιh

  obtain ⟨Λ, hmono, hcov, hS⟩ := wc_henselian_noetherian_approx_system A
  choose hhen hnoeth hlocal B instB instL instN instC φ hφ hres happrox using hS

  have hESZ' := wc_fet_ext_lfp_of_subring_system A Λ hmono hcov (fun S => (hhen S).toIsLocalRing)
    hlocal (fun S => @wc_fet_ext_of_completion_approx (Λ S) (B S) _ (hhen S).toIsLocalRing
      (hnoeth S) (instB S) (instL S) (φ S) (hφ S) (hres S) (happrox S)
      (@wc_fet_ext_complete_noetherian (B S) (instB S) (instL S) (instN S) (instC S)))

  have hi' := IsPullback.of_hasPullback h' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)))
  have hw : (i ≫ κ) ≫ h' = h₀ ≫ Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)) := by
    rw [Category.assoc, hκh']
    exact hsq.w
  let k : Z₀ ⟶ Limits.pullback h' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A))) :=
    Limits.pullback.lift (i ≫ κ) h₀ hw
  have hk1 : k ≫ Limits.pullback.fst h' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)))
      = i ≫ κ := Limits.pullback.lift_fst _ _ _
  have hk2 : k ≫ Limits.pullback.snd h' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)))
      = h₀ := Limits.pullback.lift_snd _ _ _
  have hP : IsPullback i k κ
      (Limits.pullback.fst h' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)))) := by
    refine IsPullback.of_bot ?_ hk1.symm hi'
    rw [hk2, hκh']
    exact hsq
  haveI hkc : IsClosedImmersion k :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion) hP hκ
  have hksurj : Function.Surjective k := by
    intro z'
    have hz : h' (Limits.pullback.fst h' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A))) z')
        = IsLocalRing.closedPoint A := by
      rw [← Scheme.Hom.comp_apply, Limits.pullback.condition, Scheme.Hom.comp_apply]
      have hx : Limits.pullback.snd h' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A))) z'
          = IsLocalRing.closedPoint (IsLocalRing.ResidueField A) := Subsingleton.elim _ _
      rw [hx]
      exact IsLocalRing.comap_closedPoint (IsLocalRing.residue A)
    have hmem : z' ∈ Set.range (Limits.pullback.fst
        (Limits.pullback.fst h' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)))) κ) := by
      rw [Scheme.Pullback.range_fst]
      exact hsub (show _ ∈ h' ⁻¹' {IsLocalRing.closedPoint A} from hz)
    obtain ⟨w, hw'⟩ := hmem
    refine ⟨hP.flip.isoPullback.inv w, ?_⟩
    rw [← Scheme.Hom.comp_apply, hP.flip.isoPullback_inv_fst, hw']
  obtain ⟨V₀', p₀', jV, hf₀', he₀', hV⟩ :=
    wc_fet_ext_surj_closed_immersion Z₀ _ k hksurj V₀ p₀ hf he
  obtain ⟨V', p', j', hfp', hep', hj'⟩ := hESZ' Z' _ h' _ _ hi' V₀' p₀' hf₀' he₀'
  have hw2 : (jV ≫ j') ≫ p' = (p₀ ≫ i) ≫ κ := by
    simp only [Category.assoc]
    rw [hj'.w, reassoc_of% hV.w, hk1]
  let j : V₀ ⟶ Limits.pullback p' κ := Limits.pullback.lift (jV ≫ j') (p₀ ≫ i) hw2
  have hjf : j ≫ Limits.pullback.fst p' κ = jV ≫ j' := Limits.pullback.lift_fst _ _ _
  have hjs : j ≫ Limits.pullback.snd p' κ = p₀ ≫ i := Limits.pullback.lift_snd _ _ _
  refine ⟨Limits.pullback p' κ, Limits.pullback.snd p' κ, j, ?_, ?_, ?_⟩
  · exact MorphismProperty.of_isPullback (P := @IsFinite) (IsPullback.of_hasPullback p' κ) hfp'
  · exact MorphismProperty.of_isPullback (P := @Etale) (IsPullback.of_hasPullback p' κ) hep'
  · have hbig : IsPullback (j ≫ Limits.pullback.fst p' κ) p₀ p' (i ≫ κ) := by
      rw [hjf, ← hk1]
      exact hV.paste_horiz hj'
    exact IsPullback.of_right hbig hjs (IsPullback.of_hasPullback p' κ)

theorem wc_etale_hom_eq_of_closed_fibre : ∀ (A : Type u) [CommRing A] [IsLocalRing A] (V V' Z : Scheme.{u}) (h : Z ⟶ Spec (.of A))
    (p : V ⟶ Z) (p' : V' ⟶ Z), UniversallyClosed (p ≫ h) → Etale p' → IsSeparated p' →
    ∀ (V₀ : Scheme.{u}) (j : V₀ ⟶ V), (p ≫ h) ⁻¹' {IsLocalRing.closedPoint A} ⊆ Set.range j →
    ∀ φ ψ : V ⟶ V', φ ≫ p' = p → ψ ≫ p' = p → j ≫ φ = j ≫ ψ → φ = ψ :=
by
  intro A _ _ V V' Z h p p' hUC hEt _ V₀ j hcl φ ψ hφ hψ hj
  haveI := hUC
  haveI := hEt
  let Δ := Limits.pullback.diagonal p'
  let e : V ⟶ Limits.pullback p' p' := Limits.pullback.lift φ ψ (hφ.trans hψ.symm)
  have he1 : e ≫ Limits.pullback.fst p' p' = φ := Limits.pullback.lift_fst _ _ _
  have he2 : e ≫ Limits.pullback.snd p' p' = ψ := Limits.pullback.lift_snd _ _ _
  have hje : j ≫ e = j ≫ φ ≫ Δ := by
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, he1, Category.assoc, Category.assoc, Limits.pullback.diagonal_fst,
        Category.comp_id]
    · rw [Category.assoc, he2, Category.assoc, Category.assoc, Limits.pullback.diagonal_snd,
        Category.comp_id, hj]
  have hjr : ∀ y : V₀, e (j y) ∈ Set.range Δ := by
    intro y
    have h1 := congrArg (fun k : V₀ ⟶ Limits.pullback p' p' => k y) hje
    simp only [Scheme.Hom.comp_apply] at h1
    exact ⟨φ (j y), h1.symm⟩
  have hE : IsOpen (e ⁻¹' Set.range Δ) :=
    (IsOpenImmersion.isOpen_range Δ).preimage e.continuous
  have hC : IsClosed (e ⁻¹' Set.range Δ)ᶜ := hE.isClosed_compl
  have hS : IsClosed ((p ≫ h) '' (e ⁻¹' Set.range Δ)ᶜ) :=
    Scheme.Hom.isClosedMap (p ≫ h) _ hC
  have hm : IsLocalRing.closedPoint A ∉ (p ≫ h) '' (e ⁻¹' Set.range Δ)ᶜ := by
    rintro ⟨x, hxC, hx⟩
    obtain ⟨y, rfl⟩ := hcl (show x ∈ (p ≫ h) ⁻¹' {IsLocalRing.closedPoint A} from hx)
    exact hxC (hjr y)
  have hall : ∀ x : V, e x ∈ Set.range Δ := by
    intro x
    by_contra hx
    exact hm ((IsLocalRing.specializes_closedPoint ((p ≫ h) x)).mem_closed hS ⟨x, hx, rfl⟩)
  have hsub : Set.range e ⊆ Set.range Δ := by
    rintro _ ⟨x, rfl⟩
    exact hall x
  let g := IsOpenImmersion.lift Δ e hsub
  have hg : g ≫ Δ = e := IsOpenImmersion.lift_fac _ _ _
  calc φ = e ≫ Limits.pullback.fst p' p' := he1.symm
    _ = g ≫ Δ ≫ Limits.pullback.fst p' p' := by rw [← hg, Category.assoc]
    _ = g := by rw [Limits.pullback.diagonal_fst, Category.comp_id]
    _ = g ≫ Δ ≫ Limits.pullback.snd p' p' := by rw [Limits.pullback.diagonal_snd, Category.comp_id]
    _ = ψ := by rw [← Category.assoc, hg, he2]

theorem wc_fet_hom_lift_of_ext : ∀ (A : Type u) [CommRing A] [IsLocalRing A],
    (∀ (Z Z₀ : Scheme.{u}) (h : Z ⟶ Spec (.of A)) [IsProper h] (i : Z₀ ⟶ Z)
      (h₀ : Z₀ ⟶ Spec (.of (IsLocalRing.ResidueField A))),
      IsPullback i h₀ h (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A))) →
      ∀ (V₀ : Scheme.{u}) (p₀ : V₀ ⟶ Z₀), IsFinite p₀ → Etale p₀ →
      ∃ (V : Scheme.{u}) (p : V ⟶ Z) (j : V₀ ⟶ V), IsFinite p ∧ Etale p ∧ IsPullback j p₀ p i) →
    ∀ (Z Z₀ : Scheme.{u}) (h : Z ⟶ Spec (.of A)) [IsProper h] (i : Z₀ ⟶ Z)
      (h₀ : Z₀ ⟶ Spec (.of (IsLocalRing.ResidueField A))),
      IsPullback i h₀ h (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A))) →
    ∀ (V V' V₀ V₀' : Scheme.{u}) (p : V ⟶ Z) (p' : V' ⟶ Z) (p₀ : V₀ ⟶ Z₀) (p₀' : V₀' ⟶ Z₀)
      (j : V₀ ⟶ V) (j' : V₀' ⟶ V'), IsFinite p → Etale p → IsFinite p' → Etale p' →
      IsPullback j p₀ p i → IsPullback j' p₀' p' i →
      ∀ φ₀ : V₀ ⟶ V₀', φ₀ ≫ p₀' = p₀ → ∃ φ : V ⟶ V', φ ≫ p' = p ∧ j ≫ φ = φ₀ ≫ j' :=
by
  intro A _ _ hES Z Z₀ h _ i h₀ hi V V' V₀ V₀' p p' p₀ p₀' j j' hpf hpe hp'f hp'e hj hj' φ₀ hφ₀
  haveI := hpf
  haveI := hpe
  haveI := hp'f
  haveI := hp'e
  haveI : IsFinite p₀' := MorphismProperty.of_isPullback (P := @IsFinite) hj' hp'f
  haveI : Etale p₀' := MorphismProperty.of_isPullback (P := @Etale) hj' hp'e

  have hrng : ∀ {P X Y S : Scheme.{u}} {fst : P ⟶ X} {snd : P ⟶ Y} {f : X ⟶ S} {g : Y ⟶ S},
      IsPullback fst snd f g → Set.range fst = f ⁻¹' Set.range g := by
    intro P X Y S fst snd f g H
    rw [← Scheme.Pullback.range_fst]
    ext x
    constructor
    · rintro ⟨y, rfl⟩
      exact ⟨H.isoPullback.hom y, by rw [← Scheme.Hom.comp_apply, H.isoPullback_hom_fst]⟩
    · rintro ⟨y, rfl⟩
      exact ⟨H.isoPullback.inv y, by rw [← Scheme.Hom.comp_apply, H.isoPullback_inv_fst]⟩

  have hr : Set.range (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A))) =
      {IsLocalRing.closedPoint A} := by
    ext z
    simp only [Set.mem_range]
    constructor
    · rintro ⟨x, rfl⟩
      have hx' : x = IsLocalRing.closedPoint (IsLocalRing.ResidueField A) := Subsingleton.elim _ _
      subst hx'
      exact IsLocalRing.comap_closedPoint (IsLocalRing.residue A)
    · rintro rfl
      exact ⟨IsLocalRing.closedPoint (IsLocalRing.ResidueField A),
        IsLocalRing.comap_closedPoint (IsLocalRing.residue A)⟩

  have hcl : (p ≫ h) ⁻¹' {IsLocalRing.closedPoint A} ⊆ Set.range j := by
    intro x hx
    rw [hrng hj, Set.mem_preimage, hrng hi, Set.mem_preimage, hr]
    simp only [Set.mem_preimage, Scheme.Hom.comp_apply] at hx
    exact hx

  have key : ∀ (W : Scheme.{u}) (uu : W ⟶ V) (jW : V₀ ⟶ W), IsFinite uu → Etale uu →
      IsPullback jW (𝟙 V₀) uu j → IsIso uu := by
    intro W uu jW huf hue hu
    haveI := huf
    haveI := hue
    have hju : jW ≫ uu = j := by rw [hu.w, Category.id_comp]

    obtain ⟨ℓ, hℓf, hℓs⟩ : ∃ ℓ : V₀ ⟶ Limits.pullback uu uu,
        ℓ ≫ Limits.pullback.fst uu uu = jW ∧ ℓ ≫ Limits.pullback.snd uu uu = jW :=
      ⟨Limits.pullback.lift jW jW rfl, Limits.pullback.lift_fst _ _ _,
        Limits.pullback.lift_snd _ _ _⟩
    have houter : IsPullback (ℓ ≫ Limits.pullback.fst uu uu) (𝟙 V₀) uu (jW ≫ uu) := by
      rw [hℓf, hju]; exact hu
    have hsq : IsPullback ℓ (𝟙 V₀) (Limits.pullback.snd uu uu) jW :=
      IsPullback.of_right houter (by rw [hℓs, Category.id_comp])
        (IsPullback.of_hasPullback uu uu)
    have hsub : ((Limits.pullback.snd uu uu ≫ uu) ≫ (p ≫ h)) ⁻¹' {IsLocalRing.closedPoint A} ⊆
        Set.range ℓ := by
      intro x hx
      rw [hrng hsq, Set.mem_preimage, hrng hu, Set.mem_preimage]
      apply hcl
      simp only [Set.mem_preimage, Scheme.Hom.comp_apply] at hx ⊢
      exact hx
    have hℓΔ : jW ≫ Limits.pullback.diagonal uu = ℓ := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, Limits.pullback.diagonal_fst, Category.comp_id, hℓf]
      · rw [Category.assoc, Limits.pullback.diagonal_snd, Category.comp_id, hℓs]
    have hgc : IsClosedMap ⇑((Limits.pullback.snd uu uu ≫ uu) ≫ (p ≫ h)) :=
      Scheme.Hom.isClosedMap _
    have hΔ : Function.Surjective (Limits.pullback.diagonal uu) := by
      by_contra hns
      obtain ⟨y, hy⟩ := not_forall.mp hns
      have hC : IsClosed (Set.range (Limits.pullback.diagonal uu))ᶜ :=
        ((Limits.pullback.diagonal uu).isOpenMap.isOpen_range).isClosed_compl
      have himg := hgc _ hC
      have hs : IsLocalRing.closedPoint A ∈
          ((Limits.pullback.snd uu uu ≫ uu) ≫ (p ≫ h)) '' (Set.range (Limits.pullback.diagonal uu))ᶜ :=
        (IsLocalRing.specializes_closedPoint (((Limits.pullback.snd uu uu ≫ uu) ≫ (p ≫ h)) y)).mem_closed
          himg ⟨y, hy, rfl⟩
      obtain ⟨x, hx, hxs⟩ := hs
      obtain ⟨y', hy'⟩ := hsub hxs
      apply hx
      refine ⟨jW y', ?_⟩
      rw [← Scheme.Hom.comp_apply, hℓΔ, hy']
    haveI : IsIso (Limits.pullback.diagonal uu) :=
      (isIso_iff_isOpenImmersion_and_surjective _).mpr ⟨inferInstance, ⟨hΔ⟩⟩
    haveI : Mono uu := by
      rw [← Limits.pullback.isIso_diagonal_iff]
      infer_instance
    haveI : IsOpenImmersion uu := IsOpenImmersion.of_flat_of_mono uu

    have hsurj : Function.Surjective uu := by
      by_contra hns
      obtain ⟨y, hy⟩ := not_forall.mp hns
      have hC : IsClosed (Set.range uu)ᶜ := (uu.isOpenMap.isOpen_range).isClosed_compl
      have himg : IsClosed ((p ≫ h) '' (Set.range uu)ᶜ) := (p ≫ h).isClosedMap _ hC
      have hs : IsLocalRing.closedPoint A ∈ (p ≫ h) '' (Set.range uu)ᶜ :=
        (IsLocalRing.specializes_closedPoint ((p ≫ h) y)).mem_closed himg ⟨y, hy, rfl⟩
      obtain ⟨x, hx, hxs⟩ := hs
      obtain ⟨y', hy'⟩ := hcl hxs
      apply hx
      refine ⟨jW y', ?_⟩
      rw [← Scheme.Hom.comp_apply, hju, hy']
    exact (isIso_iff_isOpenImmersion_and_surjective uu).mpr ⟨inferInstance, ⟨hsurj⟩⟩

  obtain ⟨i', hfst, hsnd⟩ : ∃ k : Limits.pullback p₀' p₀ ⟶ Limits.pullback p' p,
      k ≫ Limits.pullback.fst p' p = Limits.pullback.fst p₀' p₀ ≫ j' ∧
      k ≫ Limits.pullback.snd p' p = Limits.pullback.snd p₀' p₀ ≫ j :=
    ⟨Limits.pullback.lift (Limits.pullback.fst p₀' p₀ ≫ j') (Limits.pullback.snd p₀' p₀ ≫ j)
      (by rw [Category.assoc, Category.assoc, hj'.w, hj.w, ← Category.assoc, ← Category.assoc,
        Limits.pullback.condition]),
      Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
  have hii : IsPullback i' (Limits.pullback.fst p₀' p₀) (Limits.pullback.fst p' p) j' := by
    have houter : IsPullback (i' ≫ Limits.pullback.snd p' p) (Limits.pullback.fst p₀' p₀) p
        (j' ≫ p') := by
      rw [hsnd, hj'.w]
      exact IsPullback.paste_horiz (IsPullback.of_hasPullback p₀' p₀).flip hj
    exact IsPullback.of_right houter hfst (IsPullback.of_hasPullback p' p).flip
  have hiii : IsPullback i' (Limits.pullback.snd p₀' p₀) (Limits.pullback.snd p' p) j := by
    have houter : IsPullback (i' ≫ Limits.pullback.fst p' p) (Limits.pullback.snd p₀' p₀) p'
        (j ≫ p) := by
      rw [hfst, hj.w]
      exact IsPullback.paste_horiz (IsPullback.of_hasPullback p₀' p₀) hj'
    exact IsPullback.of_right houter hsnd (IsPullback.of_hasPullback p' p)
  have hi' := (hii.paste_vert hj').paste_vert hi

  obtain ⟨Γ, hΓf, hΓs⟩ : ∃ Γ : V₀ ⟶ Limits.pullback p₀' p₀,
      Γ ≫ Limits.pullback.fst p₀' p₀ = φ₀ ∧ Γ ≫ Limits.pullback.snd p₀' p₀ = 𝟙 V₀ :=
    ⟨Limits.pullback.lift φ₀ (𝟙 V₀) (hφ₀.trans (Category.id_comp p₀).symm),
      Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
  haveI : IsFinite (Γ ≫ Limits.pullback.snd p₀' p₀) := by rw [hΓs]; infer_instance
  haveI hΓfin : IsFinite Γ := IsFinite.of_comp Γ (Limits.pullback.snd p₀' p₀)
  have hΓet : Etale Γ := MorphismProperty.of_postcomp (W := @Etale) (W' := @Etale) Γ
    (Limits.pullback.snd p₀' p₀) inferInstance (by rw [hΓs]; infer_instance)

  obtain ⟨W, q, jW, hqf, hqe, hjW⟩ := hES (Limits.pullback p' p) (Limits.pullback p₀' p₀)
    ((Limits.pullback.fst p' p ≫ p') ≫ h) i' ((Limits.pullback.fst p₀' p₀ ≫ p₀') ≫ h₀) hi'
    V₀ Γ hΓfin hΓet
  haveI := hqf
  haveI := hqe
  have hu := hjW.paste_vert hiii
  rw [hΓs] at hu
  haveI hiso := key W (q ≫ Limits.pullback.snd p' p) jW inferInstance inferInstance hu
  have e : j ≫ inv (q ≫ Limits.pullback.snd p' p) = jW := by
    rw [IsIso.comp_inv_eq, hu.w, Category.id_comp]
  refine ⟨inv (q ≫ Limits.pullback.snd p' p) ≫ q ≫ Limits.pullback.fst p' p, ?_, ?_⟩
  · rw [Category.assoc, Category.assoc, Limits.pullback.condition, ← Category.assoc q,
      IsIso.inv_hom_id_assoc]
  · rw [← Category.assoc, e, ← Category.assoc, hjW.w, Category.assoc, hfst, ← Category.assoc,
      hΓf]

theorem wc_fet_torsor_axioms_of_closed_fibre : ∀ (A : Type u) [CommRing A] [IsLocalRing A] (Z Z₀ : Scheme.{u}) (h : Z ⟶ Spec (.of A))
    [IsProper h] (i : Z₀ ⟶ Z) [IsClosedImmersion i], h ⁻¹' {IsLocalRing.closedPoint A} ⊆ Set.range i →
    ∀ (m : ℕ) (V V₀ : Scheme.{u}) (p : V ⟶ Z) (p₀ : V₀ ⟶ Z₀) (j : V₀ ⟶ V) [IsFinite p] [Etale p],
    IsPullback j p₀ p i → Set.range p₀ = Set.univ →
    ∀ (a : ZMod m → (V ⟶ V)) (a₀ : ZMod m → (V₀ ⟶ V₀)) (ha : ∀ c, a c ≫ p = p)
      (ha₀ : ∀ c, a₀ c ≫ p₀ = p₀), (∀ c, a₀ c ≫ j = j ≫ a c) →
    (Pairwise fun c c' =>
      Disjoint (Set.range (Limits.pullback.lift (a₀ c) (𝟙 V₀) ((ha₀ c).trans (Category.id_comp p₀).symm)))
        (Set.range (Limits.pullback.lift (a₀ c') (𝟙 V₀) ((ha₀ c').trans (Category.id_comp p₀).symm)))) →
    (⋃ c, Set.range (Limits.pullback.lift (a₀ c) (𝟙 V₀) ((ha₀ c).trans (Category.id_comp p₀).symm)))
      = Set.univ →
    Set.range p = Set.univ ∧
    (Pairwise fun c c' =>
      Disjoint (Set.range (Limits.pullback.lift (a c) (𝟙 V) ((ha c).trans (Category.id_comp p).symm)))
        (Set.range (Limits.pullback.lift (a c') (𝟙 V) ((ha c').trans (Category.id_comp p).symm)))) ∧
    (⋃ c, Set.range (Limits.pullback.lift (a c) (𝟙 V) ((ha c).trans (Category.id_comp p).symm)))
      = Set.univ :=
by
  intro A _ _ Z Z₀ h _ i _ hcl m V V₀ p p₀ j _ _ hj hsurj₀ a a₀ ha ha₀ hcomp hdisj₀ hcov₀
  classical

  have L1 : ∀ (X : Scheme.{u}) (f : X ⟶ Spec (.of A)), IsClosedMap f → ∀ D : Set X, IsClosed D →
      D.Nonempty → ∃ x ∈ D, f x = IsLocalRing.closedPoint A := by
    intro X f hf D hD hDne
    obtain ⟨x₀, hx₀⟩ := hDne
    have hS : IsClosed (f '' D) := hf D hD
    have hy : f x₀ ∈ f '' D := ⟨x₀, hx₀, rfl⟩
    have hsp : f x₀ ⤳ IsLocalRing.closedPoint A := IsLocalRing.specializes_closedPoint (f x₀)
    obtain ⟨x, hx, hfx⟩ := hsp.mem_closed hS hy
    exact ⟨x, hx, hfx⟩

  let σ : ZMod m → (V ⟶ Limits.pullback p p) := fun c =>
    Limits.pullback.lift (a c) (𝟙 V) ((ha c).trans (Category.id_comp p).symm)
  let σ₀ : ZMod m → (V₀ ⟶ Limits.pullback p₀ p₀) := fun c =>
    Limits.pullback.lift (a₀ c) (𝟙 V₀) ((ha₀ c).trans (Category.id_comp p₀).symm)
  have hσf : ∀ c, σ c ≫ Limits.pullback.fst p p = a c := fun c => Limits.pullback.lift_fst _ _ _
  have hσs : ∀ c, σ c ≫ Limits.pullback.snd p p = 𝟙 V := fun c => Limits.pullback.lift_snd _ _ _
  have hσ0f : ∀ c, σ₀ c ≫ Limits.pullback.fst p₀ p₀ = a₀ c := fun c => Limits.pullback.lift_fst _ _ _
  have hσ0s : ∀ c, σ₀ c ≫ Limits.pullback.snd p₀ p₀ = 𝟙 V₀ := fun c =>
    Limits.pullback.lift_snd _ _ _
  have hsndσ : ∀ c (v : V), Limits.pullback.snd p p (σ c v) = v := by
    intro c v
    rw [← Scheme.Hom.comp_apply, hσs]
    rfl

  have hG : ∀ c, IsOpen (Set.range (σ c)) ∧ IsClosed (Set.range (σ c)) := by
    intro c
    haveI : IsClosedImmersion (σ c ≫ Limits.pullback.snd p p) := by rw [hσs c]; infer_instance
    haveI : IsClosedImmersion (σ c) := IsClosedImmersion.of_comp (σ c) (Limits.pullback.snd p p)
    haveI : Mono (σ c) := mono_of_mono_fac (hσs c)
    haveI : Etale (σ c) := by
      apply MorphismProperty.of_postcomp (W := @Etale) (W' := @Etale) _ (Limits.pullback.snd p p)
        inferInstance
      rw [hσs c]; infer_instance
    haveI : IsOpenImmersion (σ c) := IsOpenImmersion.of_flat_of_mono _
    exact ⟨IsOpenImmersion.isOpen_range _, (σ c).isClosedEmbedding.isClosed_range⟩

  have hjr : Set.range j = p ⁻¹' Set.range i := by
    have e1 : Set.range j = Set.range (Limits.pullback.fst p i) := by
      ext x
      constructor
      · rintro ⟨y, rfl⟩
        refine ⟨hj.isoPullback.hom y, ?_⟩
        rw [← Scheme.Hom.comp_apply, hj.isoPullback_hom_fst]
      · rintro ⟨y, rfl⟩
        refine ⟨hj.isoPullback.inv y, ?_⟩
        rw [← Scheme.Hom.comp_apply, hj.isoPullback_inv_fst]
    rw [e1, Scheme.Pullback.range_fst]
  let κ := Limits.pullback.map p₀ p₀ p p j j i hj.w.symm hj.w.symm
  have hκfst : κ ≫ Limits.pullback.fst p p = Limits.pullback.fst p₀ p₀ ≫ j :=
    Limits.pullback.lift_fst _ _ _
  have hκsnd : κ ≫ Limits.pullback.snd p p = Limits.pullback.snd p₀ p₀ ≫ j :=
    Limits.pullback.lift_snd _ _ _
  have hκmono : Mono κ := by
    constructor
    intro T u w huw
    have key : ∀ (q : Limits.pullback p₀ p₀ ⟶ V₀) (X : Limits.pullback p p ⟶ V),
        κ ≫ X = q ≫ j → u ≫ q = w ≫ q := by
      intro q X hq
      have h1 : (u ≫ q) ≫ j = (w ≫ q) ≫ j := by
        have := congrArg (· ≫ X) huw
        simp only [Category.assoc] at this ⊢
        rw [hq] at this
        exact this
      have h2 : (u ≫ q) ≫ p₀ = (w ≫ q) ≫ p₀ := by
        rw [← cancel_mono i]
        have := congrArg (· ≫ p) h1
        simp only [Category.assoc] at this ⊢
        rw [← hj.w]
        exact this
      exact hj.hom_ext h1 h2
    exact Limits.pullback.hom_ext (key _ _ hκfst) (key _ _ hκsnd)
  have hκinj : Function.Injective κ := by
    haveI := hκmono
    exact Scheme.Hom.injective κ
  have hκrange : Set.range κ = Limits.pullback.fst p p ⁻¹' Set.range j ∩
      Limits.pullback.snd p p ⁻¹' Set.range j :=
    Scheme.Pullback.range_map p₀ p₀ p p j j i hj.w.symm hj.w.symm
  have K1 : ∀ c, σ₀ c ≫ κ = j ≫ σ c := by
    intro c
    apply Limits.pullback.hom_ext
    · simp only [Category.assoc]
      rw [hκfst, hσf, ← Category.assoc, hσ0f]
      exact hcomp c
    · simp only [Category.assoc]
      rw [hκsnd, hσs, ← Category.assoc, hσ0s, Category.id_comp, Category.comp_id]
  have hκσ : ∀ c (v₀ : V₀), κ (σ₀ c v₀) = σ c (j v₀) := by
    intro c v₀
    rw [← Scheme.Hom.comp_apply, K1, Scheme.Hom.comp_apply]

  have hh : IsClosedMap h := Scheme.Hom.isClosedMap h
  have he : IsClosedMap (Limits.pullback.fst p p ≫ p ≫ h) := Scheme.Hom.isClosedMap _

  have F2 : ∀ v : V, h (p v) = IsLocalRing.closedPoint A → v ∈ Set.range j := by
    intro v hv
    rw [hjr]
    exact hcl hv
  have hpcond : ∀ x : (Limits.pullback p p : Scheme.{u}),
      p (Limits.pullback.fst p p x) = p (Limits.pullback.snd p p x) := by
    intro x
    rw [← Scheme.Hom.comp_apply, Limits.pullback.condition, Scheme.Hom.comp_apply]
  have F3 : ∀ x : (Limits.pullback p p : Scheme.{u}),
      h (p (Limits.pullback.fst p p x)) = IsLocalRing.closedPoint A → x ∈ Set.range κ := by
    intro x hx
    rw [hκrange]
    refine ⟨F2 _ hx, F2 _ ?_⟩
    rw [← hpcond]
    exact hx
  change Pairwise (fun c c' => Disjoint (Set.range (σ₀ c)) (Set.range (σ₀ c'))) at hdisj₀
  change (⋃ c, Set.range (σ₀ c)) = Set.univ at hcov₀
  refine ⟨?_, ?_, ?_⟩
  ·
    by_contra hne
    have hD : IsClosed (Set.range p)ᶜ := (Scheme.Hom.isOpenMap p).isOpen_range.isClosed_compl
    obtain ⟨z, hz, hzs⟩ := L1 Z h hh _ hD (Set.nonempty_compl.mpr hne)
    obtain ⟨y, rfl⟩ := hcl (show h z ∈ ({IsLocalRing.closedPoint A} : Set _) from hzs)
    have hy : y ∈ Set.range p₀ := by rw [hsurj₀]; exact Set.mem_univ y
    obtain ⟨v₀, rfl⟩ := hy
    apply hz
    refine ⟨j v₀, ?_⟩
    rw [← Scheme.Hom.comp_apply, hj.w, Scheme.Hom.comp_apply]
  ·
    change Pairwise fun c c' => Disjoint (Set.range (σ c)) (Set.range (σ c'))
    intro c c' hcc'
    rw [Set.disjoint_iff_inter_eq_empty]
    by_contra hne
    obtain ⟨x, ⟨⟨v, rfl⟩, ⟨v', hv'⟩⟩, hxs⟩ := L1 _ (Limits.pullback.fst p p ≫ p ≫ h) he _
      ((hG c).2.inter (hG c').2) (Set.nonempty_iff_ne_empty.mpr hne)
    have hvv : v' = v := by
      have := congrArg (fun y => Limits.pullback.snd p p y) hv'
      simp only [hsndσ] at this
      exact this
    subst hvv
    rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at hxs
    have hv : v' ∈ Set.range j := by
      have := F2 (Limits.pullback.snd p p (σ c v')) (by rw [← hpcond]; exact hxs)
      rwa [hsndσ] at this
    obtain ⟨v₀, rfl⟩ := hv
    have heq : σ₀ c v₀ = σ₀ c' v₀ := hκinj (by rw [hκσ, hκσ, hv'])
    exact Set.disjoint_left.mp (hdisj₀ hcc') ⟨v₀, rfl⟩ ⟨v₀, heq.symm⟩
  ·
    change (⋃ c, Set.range (σ c)) = Set.univ
    by_contra hne
    have hU : IsOpen (⋃ c, Set.range (σ c)) := isOpen_iUnion fun c => (hG c).1
    obtain ⟨x, hx, hxs⟩ := L1 _ (Limits.pullback.fst p p ≫ p ≫ h) he _ hU.isClosed_compl
      (Set.nonempty_compl.mpr hne)
    rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at hxs
    obtain ⟨w, rfl⟩ := F3 x hxs
    have hw : w ∈ ⋃ c, Set.range (σ₀ c) := by rw [hcov₀]; exact Set.mem_univ w
    obtain ⟨c, v₀, rfl⟩ := Set.mem_iUnion.mp hw
    exact hx (Set.mem_iUnion.mpr ⟨c, j v₀, (hκσ c v₀).symm⟩)

theorem wc_proper_henselian_fet_torsor_lift : ∀ (A : Type u) [CommRing A] [HenselianLocalRing A]
    (Z : Scheme.{u}) (h : Z ⟶ Spec (.of A)) [IsProper h] (m : ℕ), m ≠ 0 →
    ∀ (V₀ : Scheme.{u})
      (p₀ : V₀ ⟶ Limits.pullback h (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A))))
      (a₀ : ZMod m → (V₀ ⟶ V₀)), wcFetTorsor p₀ m a₀ →
    ∃ (V : Scheme.{u}) (p : V ⟶ Z) (a : ZMod m → (V ⟶ V)) (j : V₀ ⟶ V), wcFetTorsor p m a ∧
      IsPullback j p₀ p (Limits.pullback.fst h (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)))) ∧
      ∀ c, a₀ c ≫ j = j ≫ a c :=
by
  intro A _ _ Z h _ m _ V₀ p₀ a₀ ht₀
  haveI : IsClosedImmersion (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A))) :=
    IsClosedImmersion.spec_of_surjective _ IsLocalRing.residue_surjective

  have hi : IsPullback (Limits.pullback.fst h (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A))))
      (Limits.pullback.snd h (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)))) h
      (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A))) :=
    IsPullback.of_hasPullback _ _

  have hrange : Set.range (Limits.pullback.fst h
      (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)))) = h ⁻¹' {IsLocalRing.closedPoint A} := by
    rw [Scheme.Pullback.range_fst]
    ext z
    simp only [Set.mem_preimage, Set.mem_range, Set.mem_singleton_iff]
    constructor
    · rintro ⟨x, hx⟩
      rw [← hx]
      have hx' : x = IsLocalRing.closedPoint (IsLocalRing.ResidueField A) := Subsingleton.elim _ _
      subst hx'
      exact IsLocalRing.comap_closedPoint (IsLocalRing.residue A)
    · intro hz
      refine ⟨IsLocalRing.closedPoint (IsLocalRing.ResidueField A), ?_⟩
      rw [hz]
      exact IsLocalRing.comap_closedPoint (IsLocalRing.residue A)

  obtain ⟨V, p, j, hpf, hpe, hj⟩ := wc_proper_henselian_fet_ext A Z _ h _ _ hi V₀ p₀
    ht₀.finite ht₀.etale
  haveI := hpf
  haveI := hpe

  have hjr : Set.range j = p ⁻¹' Set.range (Limits.pullback.fst h
      (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)))) := by
    have e1 : Set.range j = Set.range (Limits.pullback.fst p (Limits.pullback.fst h
        (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A))))) := by
      ext x
      constructor
      · rintro ⟨y, rfl⟩
        refine ⟨hj.isoPullback.hom y, ?_⟩
        rw [← Scheme.Hom.comp_apply, hj.isoPullback_hom_fst]
      · rintro ⟨y, rfl⟩
        refine ⟨hj.isoPullback.inv y, ?_⟩
        rw [← Scheme.Hom.comp_apply, hj.isoPullback_inv_fst]
    rw [e1, Scheme.Pullback.range_fst]
  have hpre : (p ≫ h) ⁻¹' {IsLocalRing.closedPoint A} ⊆ Set.range j := by
    intro x hx
    rw [hjr, hrange]
    change (p ≫ h) x ∈ ({IsLocalRing.closedPoint A} : Set _) at hx
    rw [Scheme.Hom.comp_apply] at hx
    exact hx

  have hlift : ∀ c, ∃ φ : V ⟶ V, φ ≫ p = p ∧ j ≫ φ = a₀ c ≫ j := fun c =>
    wc_fet_hom_lift_of_ext A (wc_proper_henselian_fet_ext A) Z _ h _ _ hi V V V₀ V₀ p p p₀ p₀ j j
      hpf hpe hpf hpe hj hj (a₀ c) (ht₀.act_p c)
  choose a ha hja using hlift

  have huniq : ∀ φ ψ : V ⟶ V, φ ≫ p = p → ψ ≫ p = p → j ≫ φ = j ≫ ψ → φ = ψ :=
    wc_etale_hom_eq_of_closed_fibre A V V Z h p p inferInstance hpe inferInstance V₀ j hpre
  have ha0 : a 0 = 𝟙 V := huniq _ _ (ha 0) (Category.id_comp p)
    (by rw [hja 0, ht₀.act_zero, Category.id_comp, Category.comp_id])
  have hadd : ∀ c c', a (c + c') = a c' ≫ a c := fun c c' =>
    huniq _ _ (ha (c + c')) (by rw [Category.assoc, ha c, ha c'])
      (by rw [hja (c + c'), ht₀.act_add, reassoc_of% (hja c'), hja c, Category.assoc])

  have hgo : ∀ c, IsOpenImmersion (Limits.pullback.lift (a c) (𝟙 V)
      ((ha c).trans (Category.id_comp p).symm)) := by
    intro c
    have hs : Limits.pullback.lift (a c) (𝟙 V) ((ha c).trans (Category.id_comp p).symm) ≫
        Limits.pullback.snd p p = 𝟙 V := Limits.pullback.lift_snd _ _ _
    haveI : Mono (Limits.pullback.lift (a c) (𝟙 V) ((ha c).trans (Category.id_comp p).symm)) :=
      mono_of_mono_fac hs
    have : Etale (Limits.pullback.lift (a c) (𝟙 V) ((ha c).trans (Category.id_comp p).symm)) := by
      apply MorphismProperty.of_postcomp (W := @Etale) (W' := @Etale) _ (Limits.pullback.snd p p)
        inferInstance
      rw [hs]; infer_instance
    exact IsOpenImmersion.of_flat_of_mono _

  obtain ⟨hsurj, hdisj, hcov⟩ := wc_fet_torsor_axioms_of_closed_fibre A Z _ h
    (Limits.pullback.fst h (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)))) hrange.symm.subset
    m V V₀ p p₀ j hj ht₀.surj a a₀ ha ht₀.act_p (fun c => (hja c).symm) ht₀.graph_disj ht₀.graph_cover
  exact ⟨V, p, a, j, ⟨hpf, hpe, hsurj, ha, ha0, hadd, hgo, hdisj, hcov⟩, hj, fun c => (hja c).symm⟩

theorem wc_et_proper_henselian_const_quot_h1_surj : ∀ (A : Type u) [CommRing A] [HenselianLocalRing A]
    [IsSepClosed (IsLocalRing.ResidueField A)]
    (Z : Scheme.{u}) (h : Z ⟶ Spec (.of A)) [IsProper h] (WZ : Set Z),
    (∀ z : Z, z ∈ WZ ↔ h z ≠ IsLocalRing.closedPoint A) → ∀ (m : ℕ), m ≠ 0 →
    ∀ (F' : Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1})
      (ιF : F' ⟶ (constantSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))), Mono ιF → wcSuppIn Z WZ F' →
    (∀ (H : Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1})
        (χ : H ⟶ (constantSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))),
        wcSuppIn Z WZ H → ∃ χ' : H ⟶ F', χ' ≫ ιF = χ) →
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) := HasExt.standard _
    ∀ ζ : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ))) (Limits.cokernel ιF) 1,
      ∃ η : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ)))
        ((constantSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) 1,
        η.comp (Abelian.Ext.mk₀ (Limits.cokernel.π ιF)) (add_zero 1) = ζ :=
by
  intro A _ _ _ Z h _ WZ hW m hm F' ιF hFmono hFsupp hFmax
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) := HasExt.standard _
  intro ζ

  haveI : IsClosedImmersion (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A))) :=
    IsClosedImmersion.spec_of_surjective _ IsLocalRing.residue_surjective
  have hrange : Set.range (Limits.pullback.fst h
      (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)))) = WZᶜ := by
    rw [Scheme.Pullback.range_fst]
    ext z
    simp only [Set.mem_preimage, Set.mem_range, Set.mem_compl_iff, hW, not_not]
    constructor
    · rintro ⟨x, hx⟩
      rw [← hx]
      have hx' : x = IsLocalRing.closedPoint (IsLocalRing.ResidueField A) := Subsingleton.elim _ _
      subst hx'
      exact IsLocalRing.comap_closedPoint (IsLocalRing.residue A)
    · intro hz
      refine ⟨IsLocalRing.closedPoint (IsLocalRing.ResidueField A), ?_⟩
      rw [hz]
      exact IsLocalRing.comap_closedPoint (IsLocalRing.residue A)

  let α : wcEtExtZeroPre Z WZ m ⟶
      (Functor.const _).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))) :=
    { app := fun V => AddCommGrpCat.ofHom (wcSuppSub.{u} m (∀ x, V.unop.hom x ∈ WZ)).subtype
      naturality := fun _ _ _ => rfl }
  have hεmono : Mono (wcEtExtZeroι Z WZ m) := by
    have : ∀ V, Mono (α.app V) := fun V =>
      (AddCommGrpCat.mono_iff_injective _).mpr (AddSubgroup.subtype_injective _)
    have : Mono α := NatTrans.mono_of_mono_app α
    exact Functor.map_mono (presheafToSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) α
  have hEsupp : wcSuppIn Z WZ (wcEtExtZero Z WZ m) := by
    intro V s
    let η := toSheafify (Scheme.smallEtaleTopology Z) (wcEtExtZeroPre Z WZ m)
    have : Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology Z) η :=
      Presheaf.isLocallySurjective_toSheafify' _ _
    have hI := Presheaf.imageSieve_mem (Scheme.smallEtaleTopology Z) η s
    refine GrothendieckTopology.superset_covering _ ?_ hI
    intro V' g hg
    obtain ⟨t, ht⟩ := hg
    apply Sieve.le_generate
    by_cases hp : ∀ x, V'.hom x ∈ WZ
    · exact Or.inr hp
    · left
      have key : ∀ (p : Prop), ¬p → ∀ y : ↥(wcSuppSub.{u} m p), y = 0 := by
        intro p hp y
        obtain ⟨y, hy⟩ := y
        have hy' : y ∈ (⊥ : AddSubgroup (ULift.{u+1} (ZMod m))) := by
          unfold wcSuppSub at hy
          rwa [iSup_neg hp] at hy
        exact Subtype.ext ((AddSubgroup.mem_bot).mp hy')
      have ht0 : t = 0 := key _ hp t
      have h2 : (sheafify (Scheme.smallEtaleTopology Z) (wcEtExtZeroPre Z WZ m)).map g.op s
          = 0 := by
        rw [← ht, ht0, map_zero]
      exact h2
  have hloc : ∀ (V : Z.Etale), (∀ x, V.hom x ∈ WZ) →
      ∀ s : ((constantSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))).obj.obj (Opposite.op V),
      Sieve.generate (fun (V' : Z.Etale) (k : V' ⟶ V) =>
        ∃ t : (wcEtExtZero Z WZ m).obj.obj (Opposite.op V'),
          ((wcEtExtZeroι Z WZ m).hom.app (Opposite.op V')).hom t =
          (((constantSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).obj
            (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))).obj.map k.op).hom s) ∈
        Scheme.smallEtaleTopology Z V := by
    intro V hV s
    let ηC := toSheafify (Scheme.smallEtaleTopology Z)
      ((Functor.const (Z.Etale)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))
    let ηW := toSheafify (Scheme.smallEtaleTopology Z) (wcEtExtZeroPre Z WZ m)
    have : Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology Z) ηC :=
      Presheaf.isLocallySurjective_toSheafify' _ _
    have hI := Presheaf.imageSieve_mem (Scheme.smallEtaleTopology Z) ηC s
    refine GrothendieckTopology.superset_covering _ ?_ hI
    intro V' k hk
    obtain ⟨a, ha⟩ := hk
    apply Sieve.le_generate
    have hp : ∀ x, V'.hom x ∈ WZ := by
      intro x
      rw [← MorphismProperty.Over.w k, Scheme.Hom.comp_apply]
      exact hV _
    have ha' : a ∈ wcSuppSub.{u} m (∀ x, V'.hom x ∈ WZ) :=
      AddSubgroup.mem_iSup_of_mem hp (AddSubgroup.mem_top a)
    refine ⟨(ηW.app (Opposite.op V')).hom ⟨a, ha'⟩, ?_⟩
    have hn : (α ≫ ηC).app (Opposite.op V') =
        (ηW ≫ sheafifyMap (Scheme.smallEtaleTopology Z) α).app (Opposite.op V') := by
      rw [toSheafify_naturality]
    have h2 := congrArg (fun f => f.hom (⟨a, ha'⟩ : wcSuppSub.{u} m (∀ x, V'.hom x ∈ WZ))) hn
    calc _ = ((ηW ≫ sheafifyMap (Scheme.smallEtaleTopology Z) α).app (Opposite.op V')).hom
            ⟨a, ha'⟩ := rfl
      _ = ((α ≫ ηC).app (Opposite.op V')).hom ⟨a, ha'⟩ := h2.symm
      _ = (ηC.app (Opposite.op V')).hom a := rfl
      _ = _ := ha
  have hdie : ∀ (H : Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1})
      (φ : H ⟶ (constantSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))),
      wcSuppIn Z WZ H → φ ≫ Limits.cokernel.π (wcEtExtZeroι Z WZ m) = 0 := by
    intro H φ hH
    have hnat : ∀ (V₁ V₂ : Z.Etale) (a : V₂ ⟶ V₁) (y : H.obj.obj (Opposite.op V₁)),
        ((Limits.cokernel.π (wcEtExtZeroι Z WZ m)).hom.app (Opposite.op V₂)).hom
          ((φ.hom.app (Opposite.op V₂)).hom ((H.obj.map a.op).hom y)) =
        ((Limits.cokernel (wcEtExtZeroι Z WZ m)).obj.map a.op).hom
          (((Limits.cokernel.π (wcEtExtZeroι Z WZ m)).hom.app (Opposite.op V₁)).hom
            ((φ.hom.app (Opposite.op V₁)).hom y)) := by
      intro V₁ V₂ a y
      have h1 : (φ.hom.app (Opposite.op V₂)).hom ((H.obj.map a.op).hom y) =
          (((constantSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).obj
            (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))).obj.map a.op).hom
            ((φ.hom.app (Opposite.op V₁)).hom y) :=
        NatTrans.naturality_apply φ.hom a.op y
      rw [h1]
      exact NatTrans.naturality_apply (Limits.cokernel.π (wcEtExtZeroι Z WZ m)).hom a.op _
