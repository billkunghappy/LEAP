    have E2 := ρ.nat (W a) (Q a) (p₁ a) (O a) (O a) (𝟙 (O a)) (k a ≫ (p₁ a).left) h1 (k a)
      (hkg a) (by
        show k a ≫ (p₁ a).left = 𝟙 (O a).left ≫ (k a ≫ (p₁ a).left)
        rw [Category.id_comp]) (x a)
    rw [op_id, CategoryTheory.Functor.map_id] at E2
    have E3 := hid a (O a) (d a) (k a ≫ (p₁ a).left) h1 hside
    exact E1.symm.trans ((congrArg (fun z => ρ.ρ (Q a) (O a) (k a) (hkg a) z) (hx₀' a)).trans
      (E2.trans E3.symm))

  refine ⟨x₀, ?_⟩
  apply H.isSeparated _ _ (hcovS U n O d hUcov) _ s
  intro T e he
  obtain ⟨T', h, f, hf, rfl⟩ := he
  cases hf with
  | mk a =>
    change (H.obj.map (h ≫ d a).op).hom _ = (H.obj.map (h ≫ d a).op).hom _
    rw [hres, hres, hagr a]

theorem wc_et_univ_transport_limit_surj : ∀ {S Z : Scheme.{u}} (g : Z ⟶ S) (G : Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}) (H : Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) (ρ : wcEtTransport g G H), wcEtTransportUniv ρ → ∀ (U : Z.Etale) (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (D : Λ ⥤ S.Etale) (π : ∀ l, U.left ⟶ (D.obj l).left) (hπ : ∀ l, π l ≫ (D.obj l).hom = U.hom ≫ g), (∀ {l l' : Λ} (t : l ⟶ l'), π l ≫ (D.map t).left = π l') → (∀ (T : Scheme.{u}) (z : ∀ l, T ⟶ (D.obj l).left), (∀ {l l' : Λ} (t : l ⟶ l'), z l ≫ (D.map t).left = z l') → ∃! z₀ : T ⟶ U.left, ∀ l, z₀ ≫ π l = z l) → (∀ l, CompactSpace (D.obj l).left) → (∀ l, QuasiSeparatedSpace (D.obj l).left) → (∀ {l l' : Λ} (t : l ⟶ l'), IsAffineHom (D.map t).left) → CompactSpace U.left → ∀ s : H.obj.obj (Opposite.op U), ∃ (l : Λ) (x : G.obj.obj (Opposite.op (D.obj l))), ρ.ρ (D.obj l) U (π l) (hπ l) x = s :=
by
  intro S Z g G H ρ huniv U Λ _ _ D π hπ hc hlim hqc hqs haff hU s

  have hloc := fun o => wc_et_univ_transport_limit_local_rep g G H ρ huniv U Λ D π hπ hc hlim
    haff s o

  obtain ⟨l₀, n, W, c, x, hWc, hcov, hid⟩ :=
    wc_et_univ_transport_limit_normalize g G H ρ U Λ D π hc hqc hqs hU s hloc

  obtain ⟨l₁, t₁, hagree⟩ := wc_et_univ_transport_limit_pair_agree g G H ρ huniv U Λ D π hπ hc
    hlim hqs haff s l₀ n W c x hWc hid

  have hEt : ∀ i, Etale (c i).left := fun i => by
    haveI : Etale (D.obj l₀).hom := (D.obj l₀).prop
    haveI : Etale ((c i).left ≫ (D.obj l₀).hom) := by
      rw [MorphismProperty.Over.w (c i)]; exact (W i).prop
    exact Etale.of_comp (c i).left (D.obj l₀).hom
  have hΩ : IsOpen (⋃ i, Set.range (c i).left) :=
    isOpen_iUnion fun i => by
      haveI := hEt i
      exact (c i).left.isOpenMap.isOpen_range
  have hO : IsOpen ((D.map t₁).left ⁻¹' (⋃ i, Set.range (c i).left)) :=
    hΩ.preimage (D.map t₁).left.continuous
  obtain ⟨l₃, u, hu⟩ := wc_et_limit_eventually_in_open Λ (D ⋙ Scheme.Etale.forget S ⋙ Over.forget S)
    U.left π (fun t => hc t) hlim (fun t => haff t) l₁ (D.obj l₁).left (𝟙 _) (hqc l₁)
    ((D.map t₁).left ⁻¹' (⋃ i, Set.range (c i).left)) hO (by
      intro y p hy
      have hy' : y = π l₁ p := hy
      subst hy'
      obtain ⟨i, w, hw⟩ := hcov p
      show (D.map t₁).left (π l₁ p) ∈ ⋃ i, Set.range (c i).left
      refine Set.mem_iUnion.mpr ⟨i, w, ?_⟩
      rw [hw, ← hc t₁, Scheme.Hom.comp_apply])

  refine ⟨l₃, ?_⟩
  refine wc_et_univ_transport_limit_glue_level g G H ρ U Λ D π hπ hc s l₀ n W c x hid l₁ t₁ hagree
    l₃ u ?_
  intro q
  have hq : (D.map u).left q ∈ (D.map t₁).left ⁻¹' (⋃ i, Set.range (c i).left) := hu _ q rfl
  obtain ⟨i, w, hw⟩ := Set.mem_iUnion.mp hq
  refine ⟨i, w, ?_⟩
  rw [hw, Functor.map_comp]
  exact (Scheme.Hom.comp_apply (D.map u).left (D.map t₁).left q).symm

theorem wc_et_pullback_sections_colimit : ∀ {S Z : Scheme.{u}} (g : Z ⟶ S) (L : Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1} ⥤ Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}), Nonempty (L ⊣ wcEtPush g) → ∃ ρ : ∀ (G : Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}) (U : Z.Etale) (V : S.Etale) (α : U.left ⟶ V.left), α ≫ V.hom = U.hom ≫ g → (G.obj.obj (Opposite.op V) →+ (L.obj G).obj.obj (Opposite.op U)), (∀ (G G' : Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}) (ψ : G ⟶ G') (U : Z.Etale) (V : S.Etale) (α : U.left ⟶ V.left) (hα : α ≫ V.hom = U.hom ≫ g) (x : G.obj.obj (Opposite.op V)), ρ G' U V α hα ((ψ.hom.app (Opposite.op V)).hom x) = ((L.map ψ).hom.app (Opposite.op U)).hom (ρ G U V α hα x)) ∧ (∀ (G : Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}) (U : Z.Etale) (V V' : S.Etale) (w : V ⟶ V') (α : U.left ⟶ V.left) (hα : α ≫ V.hom = U.hom ≫ g) (hα' : (α ≫ w.left) ≫ V'.hom = U.hom ≫ g) (x : G.obj.obj (Opposite.op V')), ρ G U V' (α ≫ w.left) hα' x = ρ G U V α hα ((G.obj.map w.op).hom x)) ∧ (∀ (G : Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}) (U U' : Z.Etale) (u : U' ⟶ U) (V : S.Etale) (α : U.left ⟶ V.left) (hα : α ≫ V.hom = U.hom ≫ g) (hα' : (u.left ≫ α) ≫ V.hom = U'.hom ≫ g) (x : G.obj.obj (Opposite.op V)), ((L.obj G).obj.map u.op).hom (ρ G U V α hα x) = ρ G U' V (u.left ≫ α) hα' x) ∧ (∀ (U : Z.Etale) (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (D : Λ ⥤ S.Etale) (π : ∀ l, U.left ⟶ (D.obj l).left) (hπ : ∀ l, π l ≫ (D.obj l).hom = U.hom ≫ g), (∀ {l l' : Λ} (t : l ⟶ l'), π l ≫ (D.map t).left = π l') → (∀ (T : Scheme.{u}) (z : ∀ l, T ⟶ (D.obj l).left), (∀ {l l' : Λ} (t : l ⟶ l'), z l ≫ (D.map t).left = z l') → ∃! z₀ : T ⟶ U.left, ∀ l, z₀ ≫ π l = z l) → (∀ l, CompactSpace (D.obj l).left) → (∀ l, QuasiSeparatedSpace (D.obj l).left) → (∀ {l l' : Λ} (t : l ⟶ l'), IsAffineHom (D.map t).left) → CompactSpace U.left → QuasiSeparatedSpace U.left → (∀ (G : Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}) (s : (L.obj G).obj.obj (Opposite.op U)), ∃ (l : Λ) (x : G.obj.obj (Opposite.op (D.obj l))), ρ G U (D.obj l) (π l) (hπ l) x = s) ∧ (∀ (G : Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}) (l : Λ) (x : G.obj.obj (Opposite.op (D.obj l))), ρ G U (D.obj l) (π l) (hπ l) x = 0 → ∃ (l' : Λ) (t : l' ⟶ l), (G.obj.map (D.map t).op).hom x = 0)) :=
by

  have hjs : ∀ (Y : Scheme.{u}) (V : Y.Etale) (S : Sieve V), (∀ v : V.left, ∃ (V₁ : Y.Etale)
      (c : V₁ ⟶ V), S.arrows c ∧ v ∈ Set.range c.left) → S ∈ Scheme.smallEtaleTopology Y V := by
    intro Y V S hS
    change S ∈ Scheme.smallGrothendieckTopology @Etale Y V
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
    apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
    intro x
    obtain ⟨V₁, c, hc, y, hy⟩ := hS x
    have hw : c.left ≫ V.hom = V₁.hom := MorphismProperty.Over.w c
    have hEt : Etale c.left := by
      have h1 : Etale V.hom := V.prop
      have h2 : Etale (c.left ≫ V.hom) := by rw [hw]; exact V₁.prop
      exact Etale.of_comp c.left V.hom
    exact ⟨V₁, c, y, hc, hEt, hy⟩

  have hcov : ∀ {X B : Scheme.{u}} (g : X ⟶ B), CoverPreserving (Scheme.smallEtaleTopology B)
      (Scheme.smallEtaleTopology X) (wcEtBaseChange g) := by
    intro X B g
    constructor
    intro V S hS
    change S ∈ Scheme.smallGrothendieckTopology @Etale B V at hS
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale B
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hS
    have hS' := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale B
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mp hS
    apply hjs
    intro v
    obtain ⟨W, a, w, ha, -, hw⟩ := hS' (Limits.pullback.fst V.hom g v)
    refine ⟨(wcEtBaseChange g).obj W, (wcEtBaseChange g).map a,
      Sieve.image_mem_functorPushforward (wcEtBaseChange g) S ha, ?_⟩
    have h0 : (Limits.pullback.fst W.hom g ≫ a.left) ≫ V.hom = Limits.pullback.snd W.hom g ≫ g := by
      rw [Category.assoc, MorphismProperty.Over.w a]
      exact Limits.pullback.condition
    let m : Limits.pullback W.hom g ⟶ Limits.pullback V.hom g :=
      Limits.pullback.lift (Limits.pullback.fst W.hom g ≫ a.left) (Limits.pullback.snd W.hom g) h0
    have hmap : ((wcEtBaseChange g).map a).left = m := rfl
    have h1 : Limits.pullback.fst a.left (Limits.pullback.fst V.hom g) ≫ W.hom =
        (Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) ≫ Limits.pullback.snd V.hom g) ≫ g := by
      rw [← MorphismProperty.Over.w a, ← Category.assoc, Limits.pullback.condition, Category.assoc,
        Limits.pullback.condition, Category.assoc]
    let ψ : Limits.pullback a.left (Limits.pullback.fst V.hom g) ⟶ Limits.pullback W.hom g :=
      Limits.pullback.lift (Limits.pullback.fst a.left (Limits.pullback.fst V.hom g))
        (Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) ≫ Limits.pullback.snd V.hom g) h1
    have hψ : ψ ≫ m = Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, Limits.pullback.lift_fst, ← Category.assoc, Limits.pullback.lift_fst,
          Limits.pullback.condition]
      · rw [Category.assoc, Limits.pullback.lift_snd, Limits.pullback.lift_snd]
    obtain ⟨z, hz⟩ : ∃ z, Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) z = v := by
      have hv : (v : ↥(Limits.pullback V.hom g)) ∈
