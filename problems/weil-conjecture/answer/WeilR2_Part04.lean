        exact h
      have h1 := Ideal.mem_map_of_mem
        (MvPolynomial.aeval Z : MvPolynomial (Fin n) R →ₐ[R] MvPolynomial (Fin (n + c)) D) hstd1
      rw [Ideal.map_span, map_sub, map_sum, hΦC, ← hrange] at h1
