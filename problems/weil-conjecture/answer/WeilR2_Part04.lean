theorem wc_pfc_pc_char_p_tensor_fibre : (∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A] (B : Type u) [CommRing B] [IsLocalRing B] [IsNoetherianRing B] [Algebra A B] [IsLocalHom (algebraMap A B)] [Module.Flat A B], IsRegularLocalRing A → IsRegularLocalRing (B ⧸ Ideal.map (algebraMap A B) (IsLocalRing.maximalIdeal A)) → IsRegularLocalRing B) → (∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A] (B : Type u) [CommRing B] [IsLocalRing B] [IsNoetherianRing B] [Algebra A B] [IsLocalHom (algebraMap A B)] [Module.Flat A B], IsRegularLocalRing B → IsRegularLocalRing A) → (∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A], IsRegularLocalRing A → ∀ (𝔭 : Ideal A) [𝔭.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔭)) → (∀ (C₀ : Type u) [CommRing C₀] [IsLocalRing C₀] [IsNoetherianRing C₀], IsRegularLocalRing C₀ → ∀ (𝔮 : Ideal (Polynomial C₀)) [𝔮.IsPrime], 𝔮.comap Polynomial.C = IsLocalRing.maximalIdeal C₀ → IsRegularLocalRing (Localization.AtPrime 𝔮)) → (∀ (P : Type u) [CommRing P] [IsLocalRing P] [IsNoetherianRing P], IsRegularLocalRing P → ∀ (Λ : Type u) [CommRing Λ] [Algebra P Λ], Nonempty (AdicCompletion (IsLocalRing.maximalIdeal P) P ≃ₐ[P] Λ) → IsRegularLocalRing Λ) → ((∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A] (B : Type u) [CommRing B] [IsLocalRing B] [IsNoetherianRing B] [Algebra A B] [IsLocalHom (algebraMap A B)] [Module.Flat A B], IsRegularLocalRing A → IsRegularLocalRing (B ⧸ Ideal.map (algebraMap A B) (IsLocalRing.maximalIdeal A)) → IsRegularLocalRing B) → ∀ (K : Type u) [Field K] (B : Type u) [CommRing B] [Algebra K B] [IsNoetherianRing B], (∀ (𝔮 : Ideal B) [𝔮.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔮)) → ∀ (L : Type u) [Field L] [Algebra K L] [FiniteDimensional K L] [Algebra.IsSeparable K L] (𝔔 : Ideal (TensorProduct K L B)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) → (∀ (T : Type u) [CommRing T], (∀ (I : Ideal T) (D : Derivation ℤ T T), ∃ D' : Derivation ℤ (AdicCompletion I T) (AdicCompletion I T), ∀ t : T, D' (algebraMap T (AdicCompletion I T) t) = algebraMap T (AdicCompletion I T) (D t)) ∧ (∀ (M : Submonoid T) (D : Derivation ℤ T T), ∃ D' : Derivation ℤ (Localization M) (Localization M), ∀ t : T, D' (algebraMap T (Localization M) t) = algebraMap T (Localization M) (D t))) → ((∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A] (B : Type u) [CommRing B] [IsLocalRing B] [IsNoetherianRing B] [Algebra A B] [IsLocalHom (algebraMap A B)] [Module.Flat A B], IsRegularLocalRing A → IsRegularLocalRing (B ⧸ Ideal.map (algebraMap A B) (IsLocalRing.maximalIdeal A)) → IsRegularLocalRing B) → ∀ (R : Type u) [CommRing R] [IsNoetherianRing R], (∀ (𝔮 : Ideal R) [𝔮.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔮)) → ∀ (D : Derivation ℤ R R) (f : R), IsUnit (D f) → ∀ (n : ℕ), 0 < n → ∀ (𝔔 : Ideal (Polynomial R ⧸ Ideal.span {(Polynomial.X ^ n - Polynomial.C f : Polynomial R)})) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) → ((∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A] (B : Type u) [CommRing B] [IsLocalRing B] [IsNoetherianRing B] [Algebra A B] [IsLocalHom (algebraMap A B)] [Module.Flat A B], IsRegularLocalRing B → IsRegularLocalRing A) → (∀ (K : Type u) [Field K] (B : Type u) [CommRing B] [Algebra K B] [IsNoetherianRing B], (∀ (𝔮 : Ideal B) [𝔮.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔮)) → ∀ (L : Type u) [Field L] [Algebra K L] [FiniteDimensional K L] [Algebra.IsSeparable K L] (𝔔 : Ideal (TensorProduct K L B)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) → ∀ (K : Type u) [Field K] (B : Type u) [CommRing B] [Algebra K B] [IsNoetherianRing B], (∀ (L : Type u) [Field L] [Algebra K L] [FiniteDimensional K L] [IsPurelyInseparable K L] (𝔔 : Ideal (TensorProduct K L B)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) → ∀ (L : Type u) [Field L] [Algebra K L] [FiniteDimensional K L] (𝔔 : Ideal (TensorProduct K L B)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) → (∀ (p n : ℕ) (k : Type u) [Field k] [CharP k p], p.Prime → IsNoetherianRing (MvPowerSeries (Fin n) k) → ∀ (B : Type u) [CommRing B] [IsDomain B] [Algebra (MvPowerSeries (Fin n) k) B], Function.Injective (algebraMap (MvPowerSeries (Fin n) k) B) → Module.Finite (MvPowerSeries (Fin n) k) B → ∀ f : B, (¬ ∃ g : FractionRing B, g ^ p = algebraMap B (FractionRing B) f) → ∃ D : Derivation ℤ B B, D f ≠ 0) → (∀ (A : Type u) [CommRing A] [IsNoetherianRing A] (B : Type u) [CommRing B] [Algebra A B], Module.Finite A B → ∀ (𝔪 : Ideal A) [𝔪.IsPrime], Nonempty (TensorProduct A B (AdicCompletion (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔪)) (Localization.AtPrime 𝔪)) ≃ₐ[B] AdicCompletion (Ideal.map (algebraMap A (Localization (Algebra.algebraMapSubmonoid B 𝔪.primeCompl))) 𝔪) (Localization (Algebra.algebraMapSubmonoid B 𝔪.primeCompl)))) → ∀ (C₀ : Type u) [CommRing C₀] [IsLocalRing C₀] [IsNoetherianRing C₀] [IsDomain C₀], IsRegularLocalRing C₀ → ∀ (p n : ℕ) (k : Type u) [Field k] [CharP k p], p.Prime → Nonempty (C₀ ≃+* MvPowerSeries (Fin n) k) → ∀ (𝔮 : Ideal (Polynomial C₀)) [𝔮.IsMaximal], 𝔮.comap Polynomial.C = IsLocalRing.maximalIdeal C₀ → ∀ (Λ : Type u) [CommRing Λ] [Algebra (Localization.AtPrime 𝔮) Λ] [Algebra C₀ Λ] [IsScalarTower C₀ (Localization.AtPrime 𝔮) Λ], Nonempty (AdicCompletion (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮)) (Localization.AtPrime 𝔮) ≃ₐ[Localization.AtPrime 𝔮] Λ) → ∀ (L : Type u) [Field L] [Algebra C₀ L] [Algebra (FractionRing C₀) L] [IsScalarTower C₀ (FractionRing C₀) L] [FiniteDimensional (FractionRing C₀) L] (𝔔 : Ideal (TensorProduct C₀ L Λ)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔) :=
by
  intro R1 R2 R3 POLY COMP SEP DEXT DCRIT PIRED DEXIST FCT C₀ _ _ _ _ hreg p n k _ _ hp he 𝔮 _ hq Λ _ _ _ _ hΛ L _ _ _ _ _ 𝔔 _

  have sF : ∀ (C₀ : Type u) [CommRing C₀] (Λ : Type u) [CommRing Λ] [Algebra C₀ Λ],
      IsNoetherianRing Λ → (∀ (𝔮 : Ideal Λ) [𝔮.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔮)) →
      (IsNoetherianRing (TensorProduct C₀ (FractionRing C₀) Λ) ∧
        ∀ (𝔔 : Ideal (TensorProduct C₀ (FractionRing C₀) Λ)) [𝔔.IsPrime],
          IsRegularLocalRing (Localization.AtPrime 𝔔)) := by
    intro C₀ _ Λ _ _ hΛn hΛreg
    letI : Algebra Λ (TensorProduct C₀ (FractionRing C₀) Λ) :=
      Algebra.TensorProduct.rightAlgebra
    haveI hT : IsLocalization (Algebra.algebraMapSubmonoid Λ (nonZeroDivisors C₀))
        (TensorProduct C₀ (FractionRing C₀) Λ) :=
      IsLocalization.tensorRight (S := Λ) (FractionRing C₀) (nonZeroDivisors C₀)
    refine ⟨IsLocalization.isNoetherianRing (Algebra.algebraMapSubmonoid Λ (nonZeroDivisors C₀))
      _ hΛn, ?_⟩
    intro 𝔔 _
    haveI h𝔮 : (Ideal.comap (algebraMap Λ (TensorProduct C₀ (FractionRing C₀) Λ)) 𝔔).IsPrime :=
      Ideal.comap_isPrime _ _
    haveI := IsLocalization.isLocalization_isLocalization_atPrime_isLocalization
      (Algebra.algebraMapSubmonoid Λ (nonZeroDivisors C₀)) (Localization.AtPrime 𝔔) 𝔔
    haveI := hΛreg (Ideal.comap (algebraMap Λ (TensorProduct C₀ (FractionRing C₀) Λ)) 𝔔)
    exact IsRegularLocalRing.of_ringEquiv (IsLocalization.algEquiv
      (Ideal.comap (algebraMap Λ (TensorProduct C₀ (FractionRing C₀) Λ)) 𝔔).primeCompl
      (Localization.AtPrime
        (Ideal.comap (algebraMap Λ (TensorProduct C₀ (FractionRing C₀) Λ)) 𝔔))
      (Localization.AtPrime 𝔔)).toRingEquiv
  have CL6 := DCRIT R1
  have CL7 := PIRED R2 (SEP R1)
  have hP : IsRegularLocalRing (Localization.AtPrime 𝔮) := POLY C₀ hreg 𝔮 hq
  have hΛreg : IsRegularLocalRing Λ := COMP (Localization.AtPrime 𝔮) hP Λ hΛ
  haveI := hΛreg
  obtain ⟨hFn, hFreg⟩ := sF C₀ Λ inferInstance (fun 𝔭 _ => R3 Λ hΛreg 𝔭)


  clear COMP R2 R1 SEP PIRED DCRIT POLY R3 sF

  have hC0 : (p : C₀) = 0 := by
    obtain ⟨e⟩ := he
    have h1 : (p : MvPowerSeries (Fin n) k) = 0 := by
      rw [← map_natCast (algebraMap k (MvPowerSeries (Fin n) k)) p, CharP.cast_eq_zero k p, map_zero]
    have h2 : (p : C₀) = e.symm (p : MvPowerSeries (Fin n) k) := (map_natCast e.symm p).symm
    rw [h2, h1, map_zero]
  haveI hK : CharP (FractionRing C₀) p := by
    rw [CharP.charP_iff_prime_eq_zero hp, ← map_natCast (algebraMap C₀ (FractionRing C₀)) p, hC0,
      map_zero]

  have CONV : ∀ (X : Type u) [CommRing X] (i₁ i₂ : Algebra ℤ X) (m₁ m₂ : Module ℤ X)
      (E : @Derivation ℤ X X _ _ _ i₁ _ m₁),
      ∃ E' : @Derivation ℤ X X _ _ _ i₂ _ m₂, ∀ x, E' x = E x := by
    intro X _ i₁ i₂ m₁ m₂ E
    obtain rfl : i₁ = i₂ := Subsingleton.elim _ _
    obtain rfl : m₁ = m₂ := Subsingleton.elim _ _
    exact ⟨E, fun _ => rfl⟩
  have LEIB : ∀ (X : Type u) [CommRing X] (i : Algebra ℤ X) (m : Module ℤ X)
      (E : @Derivation ℤ X X _ _ _ i _ m) (a b : X), E (a * b) = a * E b + b * E a := by
    intro X _ i m E a b
    obtain rfl : i = Ring.toIntAlgebra X := Subsingleton.elim _ _
    obtain rfl : m = AddCommGroup.toIntModule X := Subsingleton.elim _ _
    rw [E.leibniz, smul_eq_mul, smul_eq_mul]
  have TR : ∀ (R : Type u) [CommRing R] [inst : Algebra ℤ R] (S : Type u) [CommRing S]
      (Θ : R ≃+* S) (d : S → S), (∀ x y : S, d (x + y) = d x + d y) →
      (∀ x y : S, d (x * y) = x * d y + y * d x) →
      ∃ D : Derivation ℤ R R, ∀ x : R, D x = Θ.symm (d (Θ x)) := by
    intro R _ inst S _ Θ d hadd hmul
    have hd0 : d 0 = 0 := by
      have h := hadd 0 0
      rw [add_zero] at h
      exact (left_eq_add.mp h)
    let G : R →+ R :=
      { toFun := fun x => Θ.symm (d (Θ x))
        map_zero' := by simp [hd0]
        map_add' := fun x y => by simp [hadd] }
    obtain rfl : inst = Ring.toIntAlgebra R := Subsingleton.elim _ _
    refine ⟨Derivation.mk' G.toIntLinearMap (fun a b => ?_), fun x => rfl⟩
    change Θ.symm (d (Θ (a * b))) = a • Θ.symm (d (Θ b)) + b • Θ.symm (d (Θ a))
    rw [map_mul, hmul, map_add, map_mul, map_mul, RingEquiv.symm_apply_apply,
      RingEquiv.symm_apply_apply, smul_eq_mul, smul_eq_mul]
  have hl : ∀ (R X Y : Type u) [CommRing R] [CommRing X] [CommRing Y] [Algebra R X] [Algebra R Y]
      (x : X), algebraMap X (TensorProduct R X Y) x = x ⊗ₜ[R] (1 : Y) := by
    intro R X Y _ _ _ _ _ x
    rw [Algebra.TensorProduct.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply]

  have FRAC : ∀ (B : Type u) [CommRing B] (M : Type u) [Field M] [Algebra B M] [IsFractionRing B M]
      (T : Type u) [CommRing T] [Algebra B T] (D : Derivation ℤ T T),
      ∃ D' : Derivation ℤ (TensorProduct B M T) (TensorProduct B M T),
        ∀ t : T, D' (TensorProduct.tmul B (1 : M) t) = TensorProduct.tmul B (1 : M) (D t) := by
    intro B _ M _ _ _ T _ _ D
    obtain ⟨D₁, hD₁⟩ := (DEXT T).2 (Algebra.algebraMapSubmonoid T (nonZeroDivisors B)) D
    letI : Algebra T (TensorProduct B M T) := Algebra.TensorProduct.rightAlgebra
    haveI : IsLocalization (Algebra.algebraMapSubmonoid T (nonZeroDivisors B))
        (TensorProduct B M T) :=
      IsLocalization.tensorRight (S := T) M (nonZeroDivisors B)
    let Ξ := IsLocalization.algEquiv (Algebra.algebraMapSubmonoid T (nonZeroDivisors B))
      (Localization (Algebra.algebraMapSubmonoid T (nonZeroDivisors B))) (TensorProduct B M T)
    obtain ⟨D', hD'⟩ := TR (TensorProduct B M T) _ Ξ.symm.toRingEquiv (⇑D₁)
      (fun a b => map_add D₁ a b) (fun a b => by rw [D₁.leibniz, smul_eq_mul, smul_eq_mul])
    obtain ⟨E, hE⟩ : ∃ E : Derivation ℤ (TensorProduct B M T) (TensorProduct B M T),
        ∀ x, E x = D' x := CONV _ _ _ _ _ D'
    refine ⟨E, fun t => ?_⟩
    have h1 : ∀ s : T, TensorProduct.tmul B (1 : M) s = algebraMap T (TensorProduct B M T) s :=
      fun s => (Algebra.TensorProduct.right_algebraMap_apply s).symm
    rw [hE, hD', h1, h1]
    show Ξ (D₁ (Ξ.symm (algebraMap T _ t))) = _
    rw [AlgEquiv.commutes, hD₁, AlgEquiv.commutes]

  have POLYD : ∀ (R : Type u) [CommRing R] (B : Type u) [CommRing B] [Algebra R B]
      (D : Derivation ℤ B B), ∃ D' : Derivation ℤ (TensorProduct R (Polynomial R) B)
        (TensorProduct R (Polynomial R) B), ∀ b : B,
        D' (Algebra.TensorProduct.includeRight b) = Algebra.TensorProduct.includeRight (D b) := by
    intro R _ B _ _ D
    let Ψ : TensorProduct R (Polynomial R) B ≃+* Polynomial B :=
      (Algebra.TensorProduct.comm R (Polynomial R) B).toRingEquiv.trans
        (polyEquivTensor' R B).symm.toRingEquiv
    have hΨ : ∀ x : B, Ψ (Algebra.TensorProduct.includeRight x) = Polynomial.C x := by
      intro x
      show (polyEquivTensor' R B).symm (Algebra.TensorProduct.comm R (Polynomial R) B
        (Algebra.TensorProduct.includeRight x)) = Polynomial.C x
      rw [Algebra.TensorProduct.includeRight_apply, Algebra.TensorProduct.comm_tmul,
        AlgEquiv.symm_apply_eq]
      have h2 := (polyEquivTensor' R B).commutes x
      rw [Polynomial.algebraMap_apply, Algebra.TensorProduct.algebraMap_apply] at h2
      exact h2.symm
    obtain ⟨D', hD'⟩ := TR _ _ Ψ
      (fun q => PolynomialModule.equivPolynomialSelf (D.mapCoeffs q))
      (fun a b => by rw [map_add, map_add])
      (fun a b => by rw [Derivation.leibniz, map_add, LinearEquiv.map_smul, LinearEquiv.map_smul,
        smul_eq_mul, smul_eq_mul])
    refine ⟨D', fun b => ?_⟩
    rw [hD', hΨ, Derivation.mapCoeffs_C, RingEquiv.symm_apply_eq, hΨ]
    rfl

  have FIN : ∀ (A : Type u) [CommRing A] [IsNoetherianRing A] (𝔮 : Ideal A) [𝔮.IsPrime] (Λ : Type u)
      [CommRing Λ] [Algebra (Localization.AtPrime 𝔮) Λ] [Algebra A Λ]
      [IsScalarTower A (Localization.AtPrime 𝔮) Λ],
      Nonempty (AdicCompletion (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮))
        (Localization.AtPrime 𝔮) ≃ₐ[Localization.AtPrime 𝔮] Λ) →
      ∀ (B : Type u) [CommRing B] [Algebra A B], Module.Finite A B → ∀ (D : Derivation ℤ B B),
      ∃ D' : Derivation ℤ (TensorProduct A B Λ) (TensorProduct A B Λ), ∀ b : B,
        D' (algebraMap B (TensorProduct A B Λ) b) = algebraMap B (TensorProduct A B Λ) (D b) := by
    intro A _ _ 𝔮 _ Λ _ _ _ _ hΛ B _ _ hfin D
    obtain ⟨e⟩ := hΛ
    obtain ⟨Φ⟩ := FCT A B hfin 𝔮
    let e' := AlgEquiv.restrictScalars A e
    let Θ := (Algebra.TensorProduct.congr (AlgEquiv.refl : B ≃ₐ[B] B) e'.symm).trans Φ
    obtain ⟨D₁, hD₁⟩ := (DEXT B).2 (Algebra.algebraMapSubmonoid B 𝔮.primeCompl) D
    obtain ⟨D₁', hc₁⟩ := CONV (Localization (Algebra.algebraMapSubmonoid B 𝔮.primeCompl)) _
      (Ring.toIntAlgebra _) _ (AddCommGroup.toIntModule _) D₁
    obtain ⟨D₂, hD₂⟩ := (DEXT (Localization (Algebra.algebraMapSubmonoid B 𝔮.primeCompl))).1
      (Ideal.map (algebraMap A (Localization (Algebra.algebraMapSubmonoid B 𝔮.primeCompl))) 𝔮) D₁'
    obtain ⟨D', hD'⟩ := TR _ _ Θ.toRingEquiv (⇑D₂) (fun a b => map_add D₂ a b)
      (LEIB _ _ _ D₂)
    obtain ⟨E, hE⟩ : ∃ E : Derivation ℤ (TensorProduct A B Λ) (TensorProduct A B Λ),
        ∀ x, E x = D' x := CONV _ _ _ _ _ D'
    refine ⟨E, fun b => ?_⟩
    have e1 : ∀ b : B, algebraMap B (AdicCompletion (Ideal.map (algebraMap A
        (Localization (Algebra.algebraMapSubmonoid B 𝔮.primeCompl))) 𝔮)
        (Localization (Algebra.algebraMapSubmonoid B 𝔮.primeCompl))) b =
        algebraMap (Localization (Algebra.algebraMapSubmonoid B 𝔮.primeCompl))
          (AdicCompletion (Ideal.map (algebraMap A
            (Localization (Algebra.algebraMapSubmonoid B 𝔮.primeCompl))) 𝔮)
            (Localization (Algebra.algebraMapSubmonoid B 𝔮.primeCompl)))
          (algebraMap B (Localization (Algebra.algebraMapSubmonoid B 𝔮.primeCompl)) b) :=
      fun b => IsScalarTower.algebraMap_apply _ _ _ b
    rw [hE, hD']
    show Θ.symm (D₂ (Θ (algebraMap B _ b))) = _
    rw [AlgEquiv.commutes, e1, hD₂, hc₁, hD₁, ← e1, AlgEquiv.commutes]

  have BT : ∀ (C : Type u) [CommRing C] [IsNoetherianRing C] (𝔮 : Ideal (Polynomial C)) [𝔮.IsPrime]
      (Λ : Type u) [CommRing Λ] [Algebra (Localization.AtPrime 𝔮) Λ] [Algebra C Λ]
      [IsScalarTower C (Localization.AtPrime 𝔮) Λ],
      Nonempty (AdicCompletion (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮))
        (Localization.AtPrime 𝔮) ≃ₐ[Localization.AtPrime 𝔮] Λ) →
      ∀ (B : Type u) [CommRing B] [Algebra C B], Module.Finite C B → ∀ (D : Derivation ℤ B B),
      ∃ D' : Derivation ℤ (TensorProduct C B Λ) (TensorProduct C B Λ), ∀ b : B,
        D' (algebraMap B (TensorProduct C B Λ) b) = algebraMap B (TensorProduct C B Λ) (D b) := by
    intro C _ _ 𝔮 _ Λ _ _ _ _ hΛ B _ _ hfin D
    haveI := hfin
    letI : Algebra (Polynomial C) Λ := ((algebraMap (Localization.AtPrime 𝔮) Λ).comp
      (algebraMap (Polynomial C) (Localization.AtPrime 𝔮))).toAlgebra
    haveI : IsScalarTower (Polynomial C) (Localization.AtPrime 𝔮) Λ :=
      IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    haveI : IsScalarTower C (Polynomial C) Λ := IsScalarTower.of_algebraMap_eq (fun c => by
      show algebraMap C Λ c = algebraMap (Localization.AtPrime 𝔮) Λ
        (algebraMap (Polynomial C) (Localization.AtPrime 𝔮) (algebraMap C (Polynomial C) c))
      rw [← IsScalarTower.algebraMap_apply C (Polynomial C) (Localization.AtPrime 𝔮),
        ← IsScalarTower.algebraMap_apply C (Localization.AtPrime 𝔮) Λ])
    obtain ⟨Dt, hDt⟩ := POLYD C B D
    obtain ⟨D'', hD''⟩ := FIN (Polynomial C) 𝔮 Λ hΛ (TensorProduct C (Polynomial C) B)
      inferInstance Dt
    let Ξ : TensorProduct C B Λ ≃+* TensorProduct (Polynomial C) (TensorProduct C (Polynomial C) B) Λ :=
      (Algebra.TensorProduct.comm C B Λ).toRingEquiv.trans
        ((Algebra.TensorProduct.cancelBaseChange C (Polynomial C) Λ Λ B).symm.toRingEquiv.trans
          (Algebra.TensorProduct.comm (Polynomial C) Λ (TensorProduct C (Polynomial C) B)).toRingEquiv)
    have key : ∀ b : B, Ξ (algebraMap B (TensorProduct C B Λ) b) =
        (Algebra.TensorProduct.includeRight b : TensorProduct C (Polynomial C) B) ⊗ₜ[Polynomial C]
          (1 : Λ) := by
      intro b
      rw [hl, Algebra.TensorProduct.includeRight_apply]
      show (Algebra.TensorProduct.comm (Polynomial C) Λ (TensorProduct C (Polynomial C) B))
        ((Algebra.TensorProduct.cancelBaseChange C (Polynomial C) Λ Λ B).symm
          ((Algebra.TensorProduct.comm C B Λ) (b ⊗ₜ[C] (1 : Λ)))) = _
      rw [Algebra.TensorProduct.comm_tmul, Algebra.TensorProduct.cancelBaseChange_symm_tmul,
        Algebra.TensorProduct.comm_tmul]
    obtain ⟨D', hD'⟩ := TR _ _ Ξ (⇑D'') (fun a b => map_add D'' a b) (LEIB _ _ _ D'')
    obtain ⟨E, hE⟩ : ∃ E : Derivation ℤ (TensorProduct C B Λ) (TensorProduct C B Λ),
        ∀ x, E x = D' x := CONV _ _ _ _ _ D'
    refine ⟨E, fun b => ?_⟩
    rw [hE, hD', key, ← hl (Polynomial C) (TensorProduct C (Polynomial C) B) Λ, hD'']
    erw [hDt]
    rw [hl (Polynomial C) (TensorProduct C (Polynomial C) B) Λ, ← key, RingEquiv.symm_apply_apply]

  have DEX : ∀ (C₀ : Type u) [CommRing C₀] [IsNoetherianRing C₀] (p n : ℕ) (k : Type u) [Field k]
      [CharP k p], p.Prime → Nonempty (C₀ ≃+* MvPowerSeries (Fin n) k) →
      ∀ (B : Type u) [CommRing B] [IsDomain B] [Algebra C₀ B], Function.Injective (algebraMap C₀ B) →
      Module.Finite C₀ B → ∀ f : B,
      (¬ ∃ g : FractionRing B, g ^ p = algebraMap B (FractionRing B) f) →
      ∃ D : Derivation ℤ B B, D f ≠ 0 := by
    intro C₀ _ _ p n k _ _ hp he B _ _ _ hinj hfin f hf
    obtain ⟨e⟩ := he
    letI : Algebra (MvPowerSeries (Fin n) k) B :=
      ((algebraMap C₀ B).comp e.symm.toRingHom).toAlgebra
    have hN : IsNoetherianRing (MvPowerSeries (Fin n) k) := isNoetherianRing_of_ringEquiv C₀ e
    have hinj' : Function.Injective (algebraMap (MvPowerSeries (Fin n) k) B) :=
      hinj.comp e.symm.injective
    have hfin' : Module.Finite (MvPowerSeries (Fin n) k) B := by
      obtain ⟨S, hS⟩ := hfin.fg_top
      refine ⟨⟨S, ?_⟩⟩
      rw [eq_top_iff]
      intro b hbtop
      clear hbtop
      have hb : b ∈ Submodule.span C₀ (S : Set B) := by rw [hS]; exact Submodule.mem_top
      induction hb using Submodule.span_induction with
      | mem x hx => exact Submodule.subset_span hx
      | zero => exact Submodule.zero_mem _
      | add x y _ _ hx hy => exact Submodule.add_mem _ hx hy
      | smul c x _ hx =>
        have hcx : c • x = (e c) • x := by
          rw [Algebra.smul_def, Algebra.smul_def]
          show algebraMap C₀ B c * x = algebraMap C₀ B (e.symm (e c)) * x
          rw [RingEquiv.symm_apply_apply]
        rw [hcx]
        exact Submodule.smul_mem _ _ hx
    exact DEXIST p n k hp hN B hinj' hfin' f hf

  have ORD : ∀ (A : Type u) [CommRing A] [IsDomain A] (K : Type u) [Field K] [Algebra A K]
      [IsFractionRing A K] (M : Type u) [Field M] [Algebra K M] [FiniteDimensional K M] [Algebra A M]
      [IsScalarTower A K M], ∃ B : Subalgebra A M, Module.Finite A B ∧ IsFractionRing B M := by
    intro A _ _ K _ _ _ M _ _ _ _ _
    obtain ⟨s, b, hb⟩ := FiniteDimensional.exists_is_basis_integral A K M
    refine ⟨Algebra.adjoin A (Set.range b), ?_, ?_⟩
    · apply Algebra.finite_adjoin_of_finite_of_isIntegral (Set.finite_range b)
      rintro _ ⟨i, rfl⟩
      exact hb i
    · set B := Algebra.adjoin A (Set.range b) with hB
      apply IsFractionRing.of_field B M
      intro z
      obtain ⟨t, ht⟩ := IsLocalization.exist_integer_multiples_of_finite (nonZeroDivisors A)
        (fun i => b.repr z i)
      have ht' : ∀ i, ∃ x : A, algebraMap A K x = (t : A) • b.repr z i := fun i => ht i
      choose a ha using ht'
      have hmem : ∑ i, a i • b i ∈ B :=
        Subalgebra.sum_mem _ (fun i _ => Subalgebra.smul_mem _
          (Algebra.subset_adjoin (Set.mem_range_self (f := ⇑b) i)) _)
      have ht0 : algebraMap A M (t : A) ≠ 0 := by
        rw [IsScalarTower.algebraMap_apply A K M]
        exact (map_ne_zero _).mpr
          ((map_ne_zero_iff _ (IsFractionRing.injective A K)).mpr (nonZeroDivisors.ne_zero t.2))
      have key : ∑ i, a i • b i = (t : A) • z := by
        conv_rhs => rw [← b.sum_repr z]
        rw [Finset.smul_sum]
        refine Finset.sum_congr rfl (fun i _ => ?_)
        rw [← smul_assoc, ← ha i, algebraMap_smul]
      refine ⟨⟨_, hmem⟩, algebraMap A B (t : A), ?_⟩
      have e1 : algebraMap B M ⟨_, hmem⟩ = ∑ i, a i • b i := rfl
      have e2 : algebraMap B M (algebraMap A B (t : A)) = algebraMap A M (t : A) :=
        (IsScalarTower.algebraMap_apply A B M (t : A)).symm
      rw [e1, e2, eq_div_iff ht0, key, Algebra.smul_def, mul_comm]
  have charp : ∀ (p : ℕ) (T : Type u) [CommRing T] [Algebra ℤ T] (D : Derivation ℤ T T) (a v : T),
      (p : T) = 0 → IsUnit (D (a * v ^ p)) → IsUnit (D a) := by
    intro p T _ _ D a v hp h
    rw [Derivation.leibniz, Derivation.leibniz_pow, nsmul_eq_mul, hp, zero_mul, smul_zero,
      zero_add, smul_eq_mul] at h
    exact isUnit_of_mul_isUnit_right h

  have MD : ∀ (K : Type u) [Field K] [Algebra C₀ K] [IsFractionRing C₀ K] (M : Type u) [Field M]
      [Algebra K M] [FiniteDimensional K M] (f : M), (∀ g : M, g ^ p ≠ f) →
      ∃ D : Derivation ℤ (TensorProduct K M (TensorProduct C₀ K Λ))
        (TensorProduct K M (TensorProduct C₀ K Λ)),
        IsUnit (D (algebraMap M (TensorProduct K M (TensorProduct C₀ K Λ)) f)) := by
    intro K _ _ _ M _ _ _ f hf
    letI : Algebra C₀ M := ((algebraMap K M).comp (algebraMap C₀ K)).toAlgebra
    haveI : IsScalarTower C₀ K M := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    obtain ⟨BM, hfin, hfr⟩ := ORD C₀ K M
    haveI := hfr
    have hiM : Function.Injective (algebraMap C₀ M) := by
      change Function.Injective ((algebraMap K M).comp (algebraMap C₀ K))
      rw [RingHom.coe_comp]
      exact (algebraMap K M).injective.comp (IsFractionRing.injective C₀ K)
    have hinj : Function.Injective (algebraMap C₀ BM) := by
      intro a b hab
      apply hiM
      rw [IsScalarTower.algebraMap_apply C₀ BM M a, IsScalarTower.algebraMap_apply C₀ BM M b, hab]
    obtain ⟨x, y, hy, hxy⟩ := IsFractionRing.div_surjective (A := BM) f
    have hy0 : algebraMap BM M y ≠ 0 := IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors hy
    have hf'eq : algebraMap BM M (x * y ^ (p - 1)) = f * (algebraMap BM M y) ^ p := by
      rw [map_mul, map_pow, ← pow_sub_one_mul hp.ne_zero, ← hxy,
        mul_comm (algebraMap BM M y ^ (p - 1)) (algebraMap BM M y), ← mul_assoc,
        div_mul_cancel₀ _ hy0]
    have hnp : ¬ ∃ g : FractionRing BM, g ^ p = algebraMap BM (FractionRing BM) (x * y ^ (p - 1)) := by
      rintro ⟨g, hg⟩
      let σ : FractionRing BM ≃ₐ[BM] M :=
        IsLocalization.algEquiv (nonZeroDivisors BM) (FractionRing BM) M
      have h1 : (σ g) ^ p = f * (algebraMap BM M y) ^ p := by
        rw [← map_pow, hg, AlgEquiv.commutes, hf'eq]
      exact hf (σ g / algebraMap BM M y)
        (by rw [div_pow, h1, mul_div_cancel_right₀ _ (pow_ne_zero _ hy0)])
    obtain ⟨D₀, hD₀⟩ := DEX C₀ p n k hp he BM hinj hfin (x * y ^ (p - 1)) hnp
    obtain ⟨D₁, hD₁⟩ := BT C₀ 𝔮 Λ hΛ BM hfin D₀
    obtain ⟨D₂, hD₂⟩ := FRAC BM M (TensorProduct C₀ BM Λ) D₁
    let Θ : TensorProduct K M (TensorProduct C₀ K Λ) ≃ₐ[M]
        TensorProduct BM M (TensorProduct C₀ BM Λ) :=
      (Algebra.TensorProduct.cancelBaseChange C₀ K M M Λ).trans
        (Algebra.TensorProduct.cancelBaseChange C₀ BM M M Λ).symm
    obtain ⟨D', hD'⟩ := TR (TensorProduct K M (TensorProduct C₀ K Λ))
      (TensorProduct BM M (TensorProduct C₀ BM Λ)) Θ.toRingEquiv (⇑D₂)
      (fun a b => map_add D₂ a b) (LEIB _ _ _ D₂)
    have hBT : ∀ b : BM, (algebraMap BM M b) ⊗ₜ[BM] (1 : TensorProduct C₀ BM Λ) =
        (1 : M) ⊗ₜ[BM] (algebraMap BM (TensorProduct C₀ BM Λ) b) := by
      intro b
      rw [Algebra.algebraMap_eq_smul_one (A := M), Algebra.algebraMap_eq_smul_one
        (A := TensorProduct C₀ BM Λ), TensorProduct.smul_tmul]
    have hval : ∀ b : BM, D' (algebraMap M (TensorProduct K M (TensorProduct C₀ K Λ))
        (algebraMap BM M b)) =
        algebraMap M (TensorProduct K M (TensorProduct C₀ K Λ)) (algebraMap BM M (D₀ b)) := by
      intro b
      rw [hD']
      show Θ.symm (D₂ (Θ (algebraMap M _ (algebraMap BM M b)))) = _
      rw [AlgEquiv.commutes, hl BM M (TensorProduct C₀ BM Λ), hBT, hD₂]
      erw [hD₁]
      rw [← hBT, ← hl BM M (TensorProduct C₀ BM Λ), AlgEquiv.commutes]
    have hpM : (p : M) = 0 := by
      rw [← map_natCast (algebraMap C₀ M) p, hC0, map_zero]
    refine ⟨D', charp p _ D' _
      (algebraMap M (TensorProduct K M (TensorProduct C₀ K Λ)) (algebraMap BM M y)) ?_ ?_⟩
    · exact (map_natCast (algebraMap M (TensorProduct K M (TensorProduct C₀ K Λ))) p).symm.trans
        (by rw [hpM, map_zero])
    · rw [← map_pow, ← map_mul, ← hf'eq, hval]
      exact (isUnit_iff_ne_zero.mpr
        ((map_ne_zero_iff _ (IsFractionRing.injective BM M)).mpr hD₀)).map _

  have tr : ∀ (R : Type u) [CommRing R] (S : Type u) [CommRing S], Nonempty (R ≃+* S) →
      (∀ (𝔮 : Ideal R) [𝔮.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔮)) →
      ∀ (𝔔 : Ideal S) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔) := by
    intro R _ S _ ⟨e⟩ h 𝔔 _
    have h𝔮 : (𝔔.comap e).IsPrime := Ideal.comap_isPrime _ _
    have hmap : Submonoid.map e.toMonoidHom (𝔔.comap e).primeCompl = 𝔔.primeCompl := by
      ext x
      rw [Submonoid.mem_map, Ideal.mem_primeCompl_iff]
      constructor
      · rintro ⟨y, hy, rfl⟩
        rw [Ideal.mem_primeCompl_iff, Ideal.mem_comap] at hy
        simpa using hy
      · intro hx
        refine ⟨e.symm x, ?_, by simp⟩
        rw [Ideal.mem_primeCompl_iff, Ideal.mem_comap]
        simpa using hx
    have := h (𝔔.comap e)
    exact IsRegularLocalRing.of_ringEquiv
      (IsLocalization.ringEquivOfRingEquiv (Localization.AtPrime (𝔔.comap e))
        (Localization.AtPrime 𝔔) e hmap)
  have s3 : ∀ (K : Type u) [Field K] (M : Type u) [Field M] [Algebra K M] [FiniteDimensional K M]
      (B : Type u) [CommRing B] [Algebra K B] [IsNoetherianRing B],
      IsNoetherianRing (TensorProduct K M B) := by
    intro K _ M _ _ _ B _ _ _
    have : Module.Finite B (TensorProduct K B M) := Module.Finite.base_change K B M
    have : Algebra.FiniteType B (TensorProduct K B M) := inferInstance
    have : IsNoetherianRing (TensorProduct K B M) := Algebra.FiniteType.isNoetherianRing B _
    exact isNoetherianRing_of_ringEquiv _ (Algebra.TensorProduct.comm K B M).toRingEquiv
  have s4 : ∀ (K : Type u) [Field K] (B : Type u) [CommRing B] [Algebra K B],
      (∀ (𝔮 : Ideal B) [𝔮.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔮)) →
      ∀ (L : Type u) [Field L] [Algebra K L], Module.finrank K L = 1 →
      ∀ (𝔔 : Ideal (TensorProduct K L B)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔) := by
    intro K _ B _ _ hB L _ _ h1 𝔔 _
    have hbt : (⊥ : IntermediateField K L) = ⊤ :=
      IntermediateField.bot_eq_top_iff_finrank_eq_one.mpr h1
    let e : L ≃ₐ[K] K := IntermediateField.topEquiv.symm.trans
      ((IntermediateField.equivOfEq hbt.symm).trans (IntermediateField.botEquiv K L))
    let Φ : TensorProduct K L B ≃ₐ[K] B :=
      (Algebra.TensorProduct.congr e AlgEquiv.refl).trans (Algebra.TensorProduct.lid K B)
    exact tr B _ ⟨Φ.symm.toRingEquiv⟩ hB 𝔔

  have IND : ∀ (K : Type u) [Field K] [Algebra C₀ K] [IsFractionRing C₀ K] [CharP K p],
      IsNoetherianRing (TensorProduct C₀ K Λ) →
      (∀ (𝔔 : Ideal (TensorProduct C₀ K Λ)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) →
      ∀ (L' : Type u) [Field L'] [Algebra K L'] [FiniteDimensional K L'] [IsPurelyInseparable K L']
      (𝔔' : Ideal (TensorProduct K L' (TensorProduct C₀ K Λ))) [𝔔'.IsPrime],
      IsRegularLocalRing (Localization.AtPrime 𝔔') := by
    intro K _ _ _ _ hKn hKreg L' _ _ _ _ 𝔔' _
    haveI := hKn
    refine wc_hnas_pfc_gcl_psc_insep_induction p K hp
      (fun (L₀ : Type u) [Field L₀] [Algebra K L₀] =>
        ∀ (𝔔₀ : Ideal (TensorProduct K L₀ (TensorProduct C₀ K Λ)))
          [𝔔₀.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔₀)) ?_ ?_ L' 𝔔'
    · intro L₀ _ _ h1 𝔔₀ _
      exact s4 K (TensorProduct C₀ K Λ) hKreg L₀ h1 𝔔₀
    · intro L₀ _ _ _ M _ _ _ _ _ β f hf hβ hadj hQM 𝔔₀ _
      haveI : IsNoetherianRing (TensorProduct K M (TensorProduct C₀ K Λ)) :=
        s3 K M (TensorProduct C₀ K Λ)
      obtain ⟨D, hD⟩ := MD K M f hf
      obtain ⟨e⟩ := wc_hnas_pfc_gcl_psc_adjoin_root_tensor p K M L₀ β f hp hf hβ hadj
        (TensorProduct C₀ K Λ)
      exact tr _ _ ⟨e.symm⟩ (CL6 _ hQM D _ hD p hp.pos) 𝔔₀
  haveI := hFn
  let e := Algebra.TensorProduct.cancelBaseChange C₀ (FractionRing C₀) (FractionRing C₀) L Λ
  refine tr _ _ ⟨e.toRingEquiv⟩ ?_ 𝔔
  intro 𝔮' _
  exact CL7 (FractionRing C₀) (TensorProduct C₀ (FractionRing C₀) Λ)
    (IND (FractionRing C₀) hFn hFreg) L 𝔮'

theorem wc_pfc_pc_fibre_of_tensor_fibre : (∀ (T : Type u) [CommRing T], (∀ (I : Ideal T) (D : Derivation ℤ T T), ∃ D' : Derivation ℤ (AdicCompletion I T) (AdicCompletion I T), ∀ t : T, D' (algebraMap T (AdicCompletion I T) t) = algebraMap T (AdicCompletion I T) (D t)) ∧ (∀ (M : Submonoid T) (D : Derivation ℤ T T), ∃ D' : Derivation ℤ (Localization M) (Localization M), ∀ t : T, D' (algebraMap T (Localization M) t) = algebraMap T (Localization M) (D t))) → (∀ (R : Type u) [CommRing R] (S : Type u) [CommRing S] [Algebra R S] (L : Type u) [CommRing L] [Algebra R L] (D : Derivation ℤ S S), (∀ r : R, D (algebraMap R S r) = 0) → ∃ D' : Derivation ℤ (TensorProduct R L S) (TensorProduct R L S), (∀ s : S, D' (Algebra.TensorProduct.includeRight s) = Algebra.TensorProduct.includeRight (D s)) ∧ ∀ l : L, D' (Algebra.TensorProduct.includeLeft (S := R) l) = 0) → (∀ (R : Type u) [CommRing R] [IsLocalRing R] [IsNoetherianRing R], IsRegularLocalRing R → ∀ (D : Derivation ℤ R R) (f : R), f ∈ IsLocalRing.maximalIdeal R → IsUnit (D f) → IsRegularLocalRing (R ⧸ Ideal.span {f})) → ∀ (C₀ : Type u) [CommRing C₀] [IsLocalRing C₀] [IsNoetherianRing C₀] [IsDomain C₀], ∀ (𝔮 : Ideal (Polynomial C₀)) [𝔮.IsMaximal], 𝔮.comap Polynomial.C = IsLocalRing.maximalIdeal C₀ → (∀ (Λ : Type u) [CommRing Λ] [Algebra (Localization.AtPrime 𝔮) Λ] [Algebra C₀ Λ] [IsScalarTower C₀ (Localization.AtPrime 𝔮) Λ], Nonempty (AdicCompletion (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮)) (Localization.AtPrime 𝔮) ≃ₐ[Localization.AtPrime 𝔮] Λ) → ∀ (L : Type u) [Field L] [Algebra C₀ L] [Algebra (FractionRing C₀) L] [IsScalarTower C₀ (FractionRing C₀) L] [FiniteDimensional (FractionRing C₀) L] (𝔔 : Ideal (TensorProduct C₀ L Λ)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) → ∀ (𝔭 : Ideal (Localization.AtPrime 𝔮)) [𝔭.IsPrime], 𝔭 ≠ ⊥ → 𝔭.comap ((algebraMap (Polynomial C₀) (Localization.AtPrime 𝔮)).comp Polynomial.C) = ⊥ → ∀ (Λ : Type u) [CommRing Λ] [Algebra (Localization.AtPrime 𝔮) Λ], Nonempty (AdicCompletion (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮)) (Localization.AtPrime 𝔮) ≃ₐ[Localization.AtPrime 𝔮] Λ) → ∀ (L : Type u) [Field L] [Algebra (Localization.AtPrime 𝔮) L] [Algebra (𝔭).ResidueField L] [IsScalarTower (Localization.AtPrime 𝔮) (𝔭).ResidueField L] [FiniteDimensional (𝔭).ResidueField L] (𝔔 : Ideal (TensorProduct (Localization.AtPrime 𝔮) L Λ)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔) :=
by

  have hconv : ∀ (A : Type u) [CommRing A] {i1 : Algebra ℤ A} {i2 : Module ℤ A}
      (D : @Derivation ℤ A A _ _ _ i1 _ i2),
      (∀ a b, D (a + b) = D a + D b) ∧ (∀ a b, D (a * b) = a * D b + b * D a) := by
    intro A _ i1 i2 D
    obtain rfl : i1 = Ring.toIntAlgebra A := Subsingleton.elim _ _
    obtain rfl : i2 = AddCommGroup.toIntModule A := Subsingleton.elim _ _
    exact ⟨fun a b => map_add D a b, fun a b => by rw [Derivation.leibniz, smul_eq_mul, smul_eq_mul]⟩
  have hmk : ∀ (A : Type u) [CommRing A] (f : A → A), (∀ a b, f (a + b) = f a + f b) →
      (∀ a b, f (a * b) = a * f b + b * f a) → ∃ D : Derivation ℤ A A, ∀ x, D x = f x := by
    intro A _ f hadd hmul
    refine ⟨Derivation.mk' (AddMonoidHom.mk' f hadd).toIntLinearMap (fun a b => ?_), fun x => rfl⟩
    simp only [AddMonoidHom.coe_toIntLinearMap, AddMonoidHom.mk'_apply, smul_eq_mul]
    exact hmul a b

  have s1 : ∀ (C₀ : Type u) [CommRing C₀] [IsDomain C₀] (𝔮 : Ideal (Polynomial C₀)) [𝔮.IsPrime]
      (𝔭 : Ideal (Localization.AtPrime 𝔮)) [𝔭.IsPrime], 𝔭 ≠ ⊥ →
      𝔭.comap ((algebraMap (Polynomial C₀) (Localization.AtPrime 𝔮)).comp Polynomial.C) = ⊥ →
      ∃ φ : FractionRing C₀ →+* 𝔭.ResidueField, (∀ c : C₀, φ (algebraMap C₀ (FractionRing C₀) c) =
        algebraMap (Localization.AtPrime 𝔮) 𝔭.ResidueField
          (algebraMap (Polynomial C₀) (Localization.AtPrime 𝔮) (Polynomial.C c))) ∧ φ.Finite := by
    intro C₀ _ _ 𝔮 _ 𝔭 _ hne hgen
    let ι := algebraMap (Polynomial C₀) (Localization.AtPrime 𝔮)
    let ψ : Polynomial C₀ →+* 𝔭.ResidueField :=
      (algebraMap (Localization.AtPrime 𝔮) 𝔭.ResidueField).comp ι
    let g : C₀ →+* 𝔭.ResidueField := ψ.comp Polynomial.C
    have hg : Function.Injective g := by
      refine (injective_iff_map_eq_zero g).mpr fun x hx => ?_
      have h1 : ι (Polynomial.C x) ∈ 𝔭 := Ideal.algebraMap_residueField_eq_zero.mp hx
      have h2 : x ∈ 𝔭.comap (ι.comp Polynomial.C) := h1
      rw [hgen] at h2
      exact h2
    let φ : FractionRing C₀ →+* 𝔭.ResidueField := IsFractionRing.lift hg
    have hφ : ∀ c : C₀, φ (algebraMap C₀ (FractionRing C₀) c) = g c := fun c =>
      IsFractionRing.lift_algebraMap hg c
    refine ⟨φ, hφ, ?_⟩
    letI : Algebra (FractionRing C₀) 𝔭.ResidueField := φ.toAlgebra
    show Module.Finite (FractionRing C₀) 𝔭.ResidueField
    let xb : 𝔭.ResidueField := ψ Polynomial.X
    have hψ : ∀ a : Polynomial C₀,
        ψ a = Polynomial.aeval xb (a.map (algebraMap C₀ (FractionRing C₀))) := by
      have : ψ = (Polynomial.aeval xb).toRingHom.comp
          (Polynomial.mapRingHom (algebraMap C₀ (FractionRing C₀))) := by
        refine Polynomial.ringHom_ext (fun c => ?_) ?_
        · simp only [RingHom.comp_apply, Polynomial.coe_mapRingHom, Polynomial.map_C,
            AlgHom.toRingHom_eq_coe, RingHom.coe_coe, Polynomial.aeval_C]
          exact (hφ c).symm
        · simp only [RingHom.comp_apply, Polynomial.coe_mapRingHom, Polynomial.map_X,
            AlgHom.toRingHom_eq_coe, RingHom.coe_coe, Polynomial.aeval_X]
          rfl
      intro a
      rw [this]
      rfl
    have halg : IsIntegral (FractionRing C₀) xb := by
      obtain ⟨z, hz, hz0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hne
      obtain ⟨⟨a, s⟩, hzs⟩ := IsLocalization.mk'_surjective 𝔮.primeCompl z
      have hzs' : IsLocalization.mk' (Localization.AtPrime 𝔮) a s = z := hzs
      clear hzs
      have ha0 : a ≠ 0 := by
        rintro rfl
        apply hz0
        rw [← hzs', IsLocalization.mk'_zero]
      have hspec := IsLocalization.mk'_spec (Localization.AtPrime 𝔮) a s
      rw [hzs'] at hspec
      have hamem : ι a ∈ 𝔭 := by
        show algebraMap (Polynomial C₀) (Localization.AtPrime 𝔮) a ∈ 𝔭
        rw [← hspec]
        exact Ideal.mul_mem_right _ _ hz
      have hψa : ψ a = 0 := Ideal.algebraMap_residueField_eq_zero.mpr hamem
      rw [hψ] at hψa
      refine IsAlgebraic.isIntegral ⟨_, ?_, hψa⟩
      exact (Polynomial.map_ne_zero_iff (IsFractionRing.injective C₀ (FractionRing C₀))).mpr ha0
    let F : IntermediateField (FractionRing C₀) 𝔭.ResidueField :=
      IntermediateField.adjoin (FractionRing C₀) {xb}
    have hRF : ∀ a : Polynomial C₀, ψ a ∈ F := by
      intro a
      rw [hψ]
      exact IntermediateField.algebra_adjoin_le_adjoin (FractionRing C₀) {xb}
        (Polynomial.aeval_mem_adjoin_singleton (FractionRing C₀) xb)
    have hPF : ∀ p : Localization.AtPrime 𝔮,
        algebraMap (Localization.AtPrime 𝔮) 𝔭.ResidueField p ∈ F := by
      intro p
      obtain ⟨⟨a, s⟩, rfl⟩ := IsLocalization.mk'_surjective 𝔮.primeCompl p
      have hspec := IsLocalization.mk'_spec (Localization.AtPrime 𝔮) a s
      have hu : ψ (s : Polynomial C₀) ≠ 0 := by
        have := IsLocalization.map_units (Localization.AtPrime 𝔮) s
        exact (this.map (algebraMap (Localization.AtPrime 𝔮) 𝔭.ResidueField)).ne_zero
      have heq : algebraMap (Localization.AtPrime 𝔮) 𝔭.ResidueField
          (IsLocalization.mk' (Localization.AtPrime 𝔮) a s) = ψ a / ψ s := by
        rw [eq_div_iff hu]
        show _ = algebraMap (Localization.AtPrime 𝔮) 𝔭.ResidueField (ι a)
        rw [← hspec, map_mul]
        rfl
      rw [heq]
      exact div_mem (hRF a) (hRF s)
    have htop : F = ⊤ := by
      rw [eq_top_iff]
      intro z _
      obtain ⟨u, v, hv, huv⟩ := IsFractionRing.div_surjective (A := Localization.AtPrime 𝔮 ⧸ 𝔭) z
      obtain ⟨u, rfl⟩ := Ideal.Quotient.mk_surjective u
      obtain ⟨v, rfl⟩ := Ideal.Quotient.mk_surjective v
      rw [← huv, Ideal.algebraMap_quotient_residueField_mk,
        Ideal.algebraMap_quotient_residueField_mk]
      exact div_mem (hPF u) (hPF v)
    have hfd : FiniteDimensional (FractionRing C₀) F :=
      IntermediateField.adjoin.finiteDimensional halg
    rw [htop] at hfd
    exact Module.Finite.equiv IntermediateField.topEquiv.toLinearEquiv

  have s2 : ∀ (C₀ : Type u) [CommRing C₀] (𝔮 : Ideal (Polynomial C₀)) [𝔮.IsPrime] (L : Type u)
      [CommRing L] [Algebra (Localization.AtPrime 𝔮) L] [Algebra C₀ L]
      [IsScalarTower C₀ (Localization.AtPrime 𝔮) L] (Λ : Type u) [CommRing Λ]
      [Algebra (Localization.AtPrime 𝔮) Λ] [Algebra C₀ Λ]
      [IsScalarTower C₀ (Localization.AtPrime 𝔮) Λ],
      ∃ π : TensorProduct C₀ L Λ →+* TensorProduct (Localization.AtPrime 𝔮) L Λ,
        Function.Surjective π ∧ RingHom.ker π = Ideal.span {TensorProduct.tmul C₀
          (algebraMap (Localization.AtPrime 𝔮) L
            (algebraMap (Polynomial C₀) (Localization.AtPrime 𝔮) Polynomial.X)) (1 : Λ) -
          TensorProduct.tmul C₀ (1 : L) (algebraMap (Localization.AtPrime 𝔮) Λ
            (algebraMap (Polynomial C₀) (Localization.AtPrime 𝔮) Polynomial.X))} := by
    intro C₀ _ 𝔮 _ L _ _ _ _ Λ _ _ _ _
    let π : TensorProduct C₀ L Λ →+* TensorProduct (Localization.AtPrime 𝔮) L Λ :=
      (Algebra.TensorProduct.mapOfCompatibleSMul (Localization.AtPrime 𝔮) C₀ C₀ L Λ).toRingHom
    have hπ : ∀ (l : L) (m : Λ), π (TensorProduct.tmul C₀ l m) =
        TensorProduct.tmul (Localization.AtPrime 𝔮) l m := fun l m =>
      Algebra.TensorProduct.mapOfCompatibleSMul_tmul _ _ _ _ _ l m
    refine ⟨π, ?_, ?_⟩
    · intro y
      induction y using TensorProduct.induction_on with
      | zero => exact ⟨0, map_zero π⟩
      | tmul l m => exact ⟨TensorProduct.tmul C₀ l m, hπ l m⟩
      | add a b ha hb =>
        obtain ⟨a', rfl⟩ := ha
        obtain ⟨b', rfl⟩ := hb
        exact ⟨a' + b', map_add π a' b'⟩
    · set xP : Localization.AtPrime 𝔮 :=
        algebraMap (Polynomial C₀) (Localization.AtPrime 𝔮) Polynomial.X with hxP
      set h : TensorProduct C₀ L Λ :=
        TensorProduct.tmul C₀ (algebraMap (Localization.AtPrime 𝔮) L xP) (1 : Λ) -
        TensorProduct.tmul C₀ (1 : L) (algebraMap (Localization.AtPrime 𝔮) Λ xP) with hh
      apply le_antisymm
      · let J := Ideal.span {h}
        let q := Ideal.Quotient.mk J
        let ρL : L →+* TensorProduct C₀ L Λ ⧸ J :=
          q.comp (Algebra.TensorProduct.includeLeft (S := C₀) (R := C₀) (A := L) (B := Λ)).toRingHom
        let ρΛ : Λ →+* TensorProduct C₀ L Λ ⧸ J :=
          q.comp (Algebra.TensorProduct.includeRight (R := C₀) (A := L) (B := Λ)).toRingHom
        have hρL : ∀ l, ρL l = q (TensorProduct.tmul C₀ l 1) := fun l => rfl
        have hρΛ : ∀ m, ρΛ m = q (TensorProduct.tmul C₀ 1 m) := fun m => rfl
        have hclaim : ρL.comp (algebraMap (Localization.AtPrime 𝔮) L) =
            ρΛ.comp (algebraMap (Localization.AtPrime 𝔮) Λ) := by
          apply IsLocalization.ringHom_ext 𝔮.primeCompl
          apply Polynomial.ringHom_ext
          · intro c
            have hc : algebraMap (Polynomial C₀) (Localization.AtPrime 𝔮) (Polynomial.C c) =
                algebraMap C₀ (Localization.AtPrime 𝔮) c := by
              rw [IsScalarTower.algebraMap_apply C₀ (Polynomial C₀) (Localization.AtPrime 𝔮),
                Polynomial.algebraMap_eq]
            simp only [RingHom.comp_apply]
            rw [hc, ← IsScalarTower.algebraMap_apply, ← IsScalarTower.algebraMap_apply, hρL, hρΛ]
            congr 1
            rw [← Algebra.TensorProduct.algebraMap_apply, Algebra.TensorProduct.algebraMap_apply']
          · simp only [RingHom.comp_apply]
            rw [hρL, hρΛ]
            refine Ideal.Quotient.eq.mpr (Ideal.subset_span ?_)
            rfl
        letI : Algebra (Localization.AtPrime 𝔮) (TensorProduct C₀ L Λ ⧸ J) :=
          (ρΛ.comp (algebraMap (Localization.AtPrime 𝔮) Λ)).toAlgebra
        let ρL' : L →ₐ[Localization.AtPrime 𝔮] TensorProduct C₀ L Λ ⧸ J :=
          { ρL with commutes' := fun p => RingHom.congr_fun hclaim p }
        let ρΛ' : Λ →ₐ[Localization.AtPrime 𝔮] TensorProduct C₀ L Λ ⧸ J :=
          { ρΛ with commutes' := fun p => rfl }
        let Ψ := Algebra.TensorProduct.productMap ρL' ρΛ'
        have hΨ : ∀ t, Ψ (π t) = q t := by
          intro t
          induction t using TensorProduct.induction_on with
          | zero => rw [map_zero, map_zero, map_zero]
          | tmul l m =>
            rw [hπ, Algebra.TensorProduct.productMap_apply_tmul]
            show ρL l * ρΛ m = q (TensorProduct.tmul C₀ l m)
            rw [hρL, hρΛ, ← map_mul, Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
          | add a b ha hb => rw [map_add, map_add, ha, hb, map_add]
        intro t ht
        rw [RingHom.mem_ker] at ht
        have : q t = 0 := by rw [← hΨ, ht, map_zero]
        exact Ideal.Quotient.eq_zero_iff_mem.mp this
      · rw [Ideal.span_singleton_le_iff_mem, RingHom.mem_ker, hh, map_sub, hπ, hπ,
          Algebra.algebraMap_eq_smul_one, Algebra.algebraMap_eq_smul_one, TensorProduct.smul_tmul,
          sub_self]

  have s4 : ∀ (T : Type u) [CommRing T] (Q : Type u) [CommRing Q] (π : T →+* Q),
      Function.Surjective π → ∀ (h : T), RingHom.ker π = Ideal.span {h} →
      ∀ (𝔔 : Ideal Q) [𝔔.IsPrime], Nonempty ((Localization.AtPrime (𝔔.comap π) ⧸
        Ideal.span {algebraMap T (Localization.AtPrime (𝔔.comap π)) h}) ≃+*
          Localization.AtPrime 𝔔) := by
    intro T _ Q _ π hπ h hker 𝔔 _
    have h1 : Function.Surjective (Localization.localRingHom (𝔔.comap π) 𝔔 π rfl) := by
      intro z
      obtain ⟨⟨y, t⟩, hz⟩ := IsLocalization.mk'_surjective 𝔔.primeCompl z
      change IsLocalization.mk' _ y t = z at hz
      subst hz
      obtain ⟨x, rfl⟩ := hπ y
      obtain ⟨s, hs⟩ := hπ t
      have hs' : s ∈ (𝔔.comap π).primeCompl := by
        show s ∉ Ideal.comap π 𝔔
        rw [Ideal.mem_comap, hs]; exact t.2
      refine ⟨IsLocalization.mk' (Localization.AtPrime (𝔔.comap π)) x ⟨s, hs'⟩, ?_⟩
      rw [Localization.localRingHom_mk']
      congr 1
      exact Subtype.ext hs
    have hM : Submonoid.map π (𝔔.comap π).primeCompl = 𝔔.primeCompl := by
      ext x
      simp only [Submonoid.mem_map]
      constructor
      · rintro ⟨y, hy, rfl⟩
        exact hy
      · intro hx
        obtain ⟨y, rfl⟩ := hπ x
        exact ⟨y, hx, rfl⟩
    have hk : RingHom.ker (Localization.localRingHom (𝔔.comap π) 𝔔 π rfl) =
        Ideal.span {algebraMap T (Localization.AtPrime (𝔔.comap π)) h} := by
      have := IsLocalization.ker_map (S := Localization.AtPrime (𝔔.comap π))
        (Localization.AtPrime 𝔔) π hM
      rw [hker, Ideal.map_span, Set.image_singleton] at this
      exact this
    exact ⟨(Ideal.quotEquivOfEq hk.symm).trans (RingHom.quotientKerEquivOfSurjective h1)⟩

  intro DEXT DTEN QREG' C₀ _ _ _ _ 𝔮 _ hq GT' 𝔭 _ hne hgen Λ _ _ hΛ L _ _ _ _ _ 𝔔 _
  have QREG := PLift.up QREG'
  have GT := PLift.up GT'
  clear QREG' GT'

  have s3 : ∃ f : Λ → Λ, (∀ a b, f (a + b) = f a + f b) ∧ (∀ a b, f (a * b) = a * f b + b * f a) ∧
      (∀ c : C₀, f (algebraMap (Localization.AtPrime 𝔮) Λ
        (algebraMap (Polynomial C₀) (Localization.AtPrime 𝔮) (Polynomial.C c))) = 0) ∧
      f (algebraMap (Localization.AtPrime 𝔮) Λ
        (algebraMap (Polynomial C₀) (Localization.AtPrime 𝔮) Polynomial.X)) = 1 := by
    obtain ⟨e⟩ := hΛ
    obtain ⟨D₀, hD₀⟩ := hmk (Polynomial C₀) (fun p => Polynomial.derivative p)
      (fun a b => Polynomial.derivative_add) (fun a b => by
        simp only [Polynomial.derivative_mul]; ring)
    obtain ⟨D₁, hD₁⟩ := (DEXT (Polynomial C₀)).2 𝔮.primeCompl D₀
    obtain ⟨h1a, h1m⟩ := hconv (Localization.AtPrime 𝔮) D₁
    obtain ⟨D₁', hD₁'⟩ := hmk (Localization.AtPrime 𝔮) (fun x => D₁ x) h1a h1m
    obtain ⟨D₂, hD₂⟩ := (DEXT (Localization.AtPrime 𝔮)).1 (IsLocalRing.maximalIdeal _) D₁'
    obtain ⟨h2a, h2m⟩ := hconv _ D₂
    refine ⟨fun x => e (D₂ (e.symm x)), fun a b => ?_, fun a b => ?_, fun c => ?_, ?_⟩
    · simp only [map_add, h2a]
    · simp only [map_mul, h2m, map_add, AlgEquiv.apply_symm_apply]
    · simp only [AlgEquiv.commutes, hD₂, hD₁', hD₁, hD₀, Polynomial.derivative_C, map_zero]
    · simp only [AlgEquiv.commutes, hD₂, hD₁', hD₁, hD₀, Polynomial.derivative_X, map_one]
  obtain ⟨fΛ, hfa, hfm, hfc, hfx⟩ := s3

  letI iCΛ : Algebra C₀ Λ :=
    ((algebraMap (Localization.AtPrime 𝔮) Λ).comp (algebraMap C₀ (Localization.AtPrime 𝔮))).toAlgebra
  haveI tΛ : IsScalarTower C₀ (Localization.AtPrime 𝔮) Λ := IsScalarTower.of_algebraMap_eq' rfl
  letI iCL : Algebra C₀ L :=
    ((algebraMap (Localization.AtPrime 𝔮) L).comp (algebraMap C₀ (Localization.AtPrime 𝔮))).toAlgebra
  haveI tL : IsScalarTower C₀ (Localization.AtPrime 𝔮) L := IsScalarTower.of_algebraMap_eq' rfl
  have hcP : ∀ c : C₀, algebraMap C₀ (Localization.AtPrime 𝔮) c =
      algebraMap (Polynomial C₀) (Localization.AtPrime 𝔮) (Polynomial.C c) := by
    intro c
    rw [IsScalarTower.algebraMap_apply C₀ (Polynomial C₀) (Localization.AtPrime 𝔮),
      Polynomial.algebraMap_eq]

  obtain ⟨φ, hφ, hfin⟩ := s1 C₀ 𝔮 𝔭 hne hgen
  letI iKL : Algebra (FractionRing C₀) L := ((algebraMap 𝔭.ResidueField L).comp φ).toAlgebra
  haveI tKL : IsScalarTower C₀ (FractionRing C₀) L := by
    refine IsScalarTower.of_algebraMap_eq (fun c => ?_)
    change algebraMap (Localization.AtPrime 𝔮) L (algebraMap C₀ (Localization.AtPrime 𝔮) c) =
      algebraMap 𝔭.ResidueField L (φ (algebraMap C₀ (FractionRing C₀) c))
    rw [hφ, hcP]
    exact (IsScalarTower.algebraMap_apply (Localization.AtPrime 𝔮) 𝔭.ResidueField L _)
  haveI fKL : FiniteDimensional (FractionRing C₀) L := by
    letI : Algebra (FractionRing C₀) 𝔭.ResidueField := φ.toAlgebra
    haveI : Module.Finite (FractionRing C₀) 𝔭.ResidueField := hfin
    haveI : IsScalarTower (FractionRing C₀) 𝔭.ResidueField L := IsScalarTower.of_algebraMap_eq' rfl
    exact Module.Finite.trans 𝔭.ResidueField L

  obtain ⟨DΛ, hDΛ⟩ := hmk Λ fΛ hfa hfm
  obtain ⟨Δ, hΔr, hΔl⟩ := DTEN C₀ Λ L DΛ (fun c => by
    rw [hDΛ]
    show fΛ (algebraMap (Localization.AtPrime 𝔮) Λ (algebraMap C₀ (Localization.AtPrime 𝔮) c)) = 0
    rw [hcP]
    exact hfc c)

  obtain ⟨π, hπs, hker⟩ := s2 C₀ 𝔮 L Λ
  set h : TensorProduct C₀ L Λ := TensorProduct.tmul C₀
      (algebraMap (Localization.AtPrime 𝔮) L
        (algebraMap (Polynomial C₀) (Localization.AtPrime 𝔮) Polynomial.X)) (1 : Λ) -
      TensorProduct.tmul C₀ (1 : L) (algebraMap (Localization.AtPrime 𝔮) Λ
        (algebraMap (Polynomial C₀) (Localization.AtPrime 𝔮) Polynomial.X)) with hh
  have hΔh : Δ h = -1 := by
    rw [hh, map_sub]
    have e1 : TensorProduct.tmul C₀ (algebraMap (Localization.AtPrime 𝔮) L
        (algebraMap (Polynomial C₀) (Localization.AtPrime 𝔮) Polynomial.X)) (1 : Λ) =
        Algebra.TensorProduct.includeLeft (S := C₀) (algebraMap (Localization.AtPrime 𝔮) L
          (algebraMap (Polynomial C₀) (Localization.AtPrime 𝔮) Polynomial.X)) := rfl
    have e2 : TensorProduct.tmul C₀ (1 : L) (algebraMap (Localization.AtPrime 𝔮) Λ
        (algebraMap (Polynomial C₀) (Localization.AtPrime 𝔮) Polynomial.X)) =
        Algebra.TensorProduct.includeRight (algebraMap (Localization.AtPrime 𝔮) Λ
          (algebraMap (Polynomial C₀) (Localization.AtPrime 𝔮) Polynomial.X)) := rfl
    rw [e1, e2, hΔl, hΔr, hDΛ, hfx, map_one, zero_sub]
  obtain ⟨hTa, hTm⟩ := hconv (TensorProduct C₀ L Λ) Δ
  obtain ⟨ΔT, hΔT⟩ := hmk (TensorProduct C₀ L Λ) (fun t => Δ t) hTa hTm

  have hreg : IsRegularLocalRing (Localization.AtPrime (𝔔.comap π)) := GT.down Λ ⟨hΛ.some⟩ L _

  obtain ⟨Δ', hΔ'⟩ := (DEXT (TensorProduct C₀ L Λ)).2 (𝔔.comap π).primeCompl ΔT
  obtain ⟨hLa, hLm⟩ := hconv (Localization.AtPrime (𝔔.comap π)) Δ'
  obtain ⟨Δ'', hΔ''⟩ := hmk (Localization.AtPrime (𝔔.comap π)) (fun x => Δ' x) hLa hLm
  have hhmem : h ∈ 𝔔.comap π := by
    rw [Ideal.mem_comap]
    have : h ∈ RingHom.ker π := by rw [hker]; exact Ideal.mem_span_singleton_self h
    rw [RingHom.mem_ker] at this
    rw [this]
    exact Ideal.zero_mem _
  haveI := hreg
  have hfmem : algebraMap (TensorProduct C₀ L Λ) (Localization.AtPrime (𝔔.comap π)) h ∈
      IsLocalRing.maximalIdeal (Localization.AtPrime (𝔔.comap π)) :=
    (IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime (𝔔.comap π))
      (𝔔.comap π) h).mpr hhmem
  have hunit : IsUnit (Δ'' (algebraMap (TensorProduct C₀ L Λ)
      (Localization.AtPrime (𝔔.comap π)) h)) := by
    rw [hΔ'']
    show IsUnit (Δ' (algebraMap (TensorProduct C₀ L Λ) (Localization (𝔔.comap π).primeCompl) h))
    rw [hΔ', hΔT]
    show IsUnit (algebraMap (TensorProduct C₀ L Λ) (Localization (𝔔.comap π).primeCompl) (Δ h))
    rw [hΔh, map_neg, map_one]
    exact IsUnit.neg (α := Localization (𝔔.comap π).primeCompl) isUnit_one
  have hq_reg := QREG.down (Localization.AtPrime (𝔔.comap π)) hreg Δ'' _ hfmem hunit

  obtain ⟨e⟩ := s4 (TensorProduct C₀ L Λ) _ π hπs h hker 𝔔
  haveI := hq_reg
  exact IsRegularLocalRing.of_ringEquiv e

theorem wc_hnas_pfc_poly_complete_fibres : (∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A] (B : Type u) [CommRing B] [IsLocalRing B] [IsNoetherianRing B] [Algebra A B] [IsLocalHom (algebraMap A B)] [Module.Flat A B], IsRegularLocalRing A → IsRegularLocalRing (B ⧸ Ideal.map (algebraMap A B) (IsLocalRing.maximalIdeal A)) → IsRegularLocalRing B) → (∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A] (B : Type u) [CommRing B] [IsLocalRing B] [IsNoetherianRing B] [Algebra A B] [IsLocalHom (algebraMap A B)] [Module.Flat A B], IsRegularLocalRing B → IsRegularLocalRing A) → (∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A], IsRegularLocalRing A → ∀ (𝔭 : Ideal A) [𝔭.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔭)) → (∀ (B : Type u) [CommRing B] [IsLocalRing B] [IsNoetherianRing B] (S : Type u) [CommRing S] [IsLocalRing S] [Algebra B S], Function.Surjective (algebraMap B S) → Nonempty (TensorProduct B S (AdicCompletion (IsLocalRing.maximalIdeal B) B) ≃ₐ[S] AdicCompletion (IsLocalRing.maximalIdeal S) S)) → ∀ (C : Type u) [CommRing C] [IsLocalRing C] [IsNoetherianRing C], IsAdicComplete (IsLocalRing.maximalIdeal C) C → ∀ (𝔮 : Ideal (Polynomial C)) [𝔮.IsMaximal], 𝔮.comap Polynomial.C = IsLocalRing.maximalIdeal C → ∀ (Λ : Type u) [CommRing Λ] [Algebra (Localization.AtPrime 𝔮) Λ], Nonempty (AdicCompletion (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮)) (Localization.AtPrime 𝔮) ≃ₐ[Localization.AtPrime 𝔮] Λ) → ∀ (𝔭 : Ideal (Localization.AtPrime 𝔮)) [𝔭.IsPrime] (L : Type u) [Field L] [Algebra (Localization.AtPrime 𝔮) L] [Algebra 𝔭.ResidueField L] [IsScalarTower (Localization.AtPrime 𝔮) 𝔭.ResidueField L] [FiniteDimensional 𝔭.ResidueField L] (𝔔 : Ideal (TensorProduct (Localization.AtPrime 𝔮) L Λ)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔) :=
by
  intro R1 R2 R3 SURJ C _ _ _ hC 𝔮 _ hq Λ _ _ hΛ 𝔭 _ L _ _ _ _ _ 𝔔 _
  have POLY := wc_pfc_pc_poly_localization_regular R1
  have COMP := wc_pfc_pc_completion_regular R1
  refine wc_pfc_pc_reduce_to_domain (wc_pfc_pc_fib_of_surjective SURJ) ?_ C hC 𝔮 hq 𝔭 Λ hΛ L 𝔔
  intro D _ _ _ _ hD 𝔮 _ hq 𝔭 _ hgen Λ _ _ hΛ L _ _ _ _ _ 𝔔 _
  rcases wc_hnas_pfc_gcl_cohen_finite D hD with
    ⟨A, iA, lA, nA, aA, hdom, hreg, hinj, hfin, hchar⟩ |
    ⟨p, n, k, fk, ck, aA, hp, hn, hdom, hreg, hinj, hfin⟩
  · haveI := hdom
    haveI := hfin
    have hA : ∀ m : ℕ, m ≠ 0 → (m : A) ≠ 0 := by
      intro m hm h
      apply hchar m hm
      rw [← map_natCast (algebraMap A D) m, h, map_zero]
    obtain ⟨hmax, hq0, hgen0⟩ := wc_pfc_pc_finite_poly_comap A D hinj 𝔮 hq
    haveI := hmax
    refine wc_pfc_pc_fib_finite_transfer A D hinj 𝔮 hq 𝔭 ?_ Λ hΛ L 𝔔
    intro Λ' _ _ hΛ' L' _ _ _ _ _ 𝔔' _
    by_cases h0 : 𝔭.comap (Localization.localRingHom (𝔮.comap (Polynomial.mapRingHom (algebraMap A D))) 𝔮
        (Polynomial.mapRingHom (algebraMap A D)) rfl) = ⊥
    · exact wc_pfc_pc_char_zero_generic R1 R3 POLY COMP wc_hnas_pfc_gcl_separable_base_change A hreg hA
        _ hq0 _ h0 Λ' hΛ' L' 𝔔'
    · exact wc_pfc_pc_fibre_of_tensor_fibre wc_hnas_pfc_gcl_derivation_extend wc_pfc_pc_derivation_tensor
        wc_pfc_pc_quotient_regular_of_derivation A _ hq0
        (wc_pfc_pc_char_zero_tensor_fibre R1 R3 POLY COMP wc_hnas_pfc_gcl_separable_base_change A hreg hA
          _ hq0) _ h0 (hgen0 𝔭 hgen) Λ' hΛ' L' 𝔔'
  · haveI hloc : IsLocalRing (MvPowerSeries (Fin n) k) := hreg.toIsLocalRing
    haveI := hn
    haveI := hdom
    haveI := hfin
    obtain ⟨hmax, hq0, hgen0⟩ := wc_pfc_pc_finite_poly_comap (MvPowerSeries (Fin n) k) D hinj 𝔮 hq
    haveI := hmax
    refine wc_pfc_pc_fib_finite_transfer (MvPowerSeries (Fin n) k) D hinj 𝔮 hq 𝔭 ?_ Λ hΛ L 𝔔
    intro Λ' _ _ hΛ' L' _ _ _ _ _ 𝔔' _
    by_cases h0 : 𝔭.comap (Localization.localRingHom
        (𝔮.comap (Polynomial.mapRingHom (algebraMap (MvPowerSeries (Fin n) k) D))) 𝔮
        (Polynomial.mapRingHom (algebraMap (MvPowerSeries (Fin n) k) D)) rfl) = ⊥
    · exact wc_pfc_pc_char_p_generic R1 R2 R3 POLY COMP wc_hnas_pfc_gcl_separable_base_change
        wc_hnas_pfc_gcl_derivation_extend wc_hnas_pfc_gcl_derivation_criterion
        wc_hnas_pfc_gcl_purely_inseparable_reduction wc_pfc_pc_derivation_exists_poly
        wc_hnas_pfc_gcl_finite_completion_tensor (MvPowerSeries (Fin n) k) hreg p n k hp
        ⟨RingEquiv.refl _⟩ _ hq0 _ h0 Λ' hΛ' L' 𝔔'
    · exact wc_pfc_pc_fibre_of_tensor_fibre wc_hnas_pfc_gcl_derivation_extend wc_pfc_pc_derivation_tensor
        wc_pfc_pc_quotient_regular_of_derivation (MvPowerSeries (Fin n) k) _ hq0
        (wc_pfc_pc_char_p_tensor_fibre R1 R2 R3 POLY COMP wc_hnas_pfc_gcl_separable_base_change
          wc_hnas_pfc_gcl_derivation_extend wc_hnas_pfc_gcl_derivation_criterion
          wc_hnas_pfc_gcl_purely_inseparable_reduction wc_hnas_pfc_gcl_derivation_exists
          wc_hnas_pfc_gcl_finite_completion_tensor (MvPowerSeries (Fin n) k) hreg p n k hp
          ⟨RingEquiv.refl _⟩ _ hq0) _ h0 (hgen0 𝔭 hgen) Λ' hΛ' L' 𝔔'

theorem wc_hnas_pfc_grf_descent : (∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A] (B : Type u) [CommRing B] [IsLocalRing B] [IsNoetherianRing B] [Algebra A B] [IsLocalHom (algebraMap A B)] [Module.Flat A B], IsRegularLocalRing B → IsRegularLocalRing A) → ∀ (A : Type u) [CommRing A] (C : Type u) [CommRing C] (D : Type u) [CommRing D] [Algebra A C] [Algebra A D] [Algebra C D] [IsScalarTower A C D] [IsNoetherianRing C] [IsNoetherianRing D], Module.FaithfullyFlat C D → (∀ (𝔭 : Ideal A) [𝔭.IsPrime] (L : Type u) [Field L] [Algebra A L] [Algebra 𝔭.ResidueField L] [IsScalarTower A 𝔭.ResidueField L] [FiniteDimensional 𝔭.ResidueField L] (𝔔 : Ideal (TensorProduct A L D)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) → ∀ (𝔭 : Ideal A) [𝔭.IsPrime] (L : Type u) [Field L] [Algebra A L] [Algebra 𝔭.ResidueField L] [IsScalarTower A 𝔭.ResidueField L] [FiniteDimensional 𝔭.ResidueField L] (𝔔 : Ideal (TensorProduct A L C)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔) :=
by
  intro R2' A _ C _ D _ _ _ _ _ _ _ hff hD' 𝔭 _ L _ _ _ _ _ 𝔔 _
  have R2 := PLift.up R2'
  have hD := PLift.up hD'
  clear R2' hD'

  have hnoeth : ∀ (B : Type u) [CommRing B] [Algebra A B] [IsNoetherianRing B],
      IsNoetherianRing (TensorProduct A L B) := by
    intro B _ _ _
    letI : Algebra (Localization.AtPrime 𝔭) L :=
      ((algebraMap 𝔭.ResidueField L).comp
        (algebraMap (Localization.AtPrime 𝔭) 𝔭.ResidueField)).toAlgebra
    haveI : IsScalarTower (Localization.AtPrime 𝔭) 𝔭.ResidueField L :=
      IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    haveI : IsScalarTower A (Localization.AtPrime 𝔭) L :=
      IsScalarTower.of_algebraMap_eq (fun a => by
        change algebraMap A L a = algebraMap 𝔭.ResidueField L
          (algebraMap (Localization.AtPrime 𝔭) 𝔭.ResidueField
            (algebraMap A (Localization.AtPrime 𝔭) a))
        rw [← IsScalarTower.algebraMap_apply A (Localization.AtPrime 𝔭) 𝔭.ResidueField,
          ← IsScalarTower.algebraMap_apply])
    haveI : Module.Finite (Localization.AtPrime 𝔭) L :=
      Module.Finite.trans 𝔭.ResidueField L
    haveI hN : IsNoetherianRing (TensorProduct A (Localization.AtPrime 𝔭) B) := by
      letI : Algebra B (TensorProduct A (Localization.AtPrime 𝔭) B) :=
        Algebra.TensorProduct.rightAlgebra
      haveI := IsLocalization.tensorRight (R := A) (S := B) (Localization.AtPrime 𝔭) 𝔭.primeCompl
      exact IsLocalization.isNoetherianRing (Algebra.algebraMapSubmonoid B 𝔭.primeCompl) _
        inferInstance
    haveI : IsNoetherianRing (TensorProduct (Localization.AtPrime 𝔭)
        (TensorProduct A (Localization.AtPrime 𝔭) B) L) :=
      IsNoetherianRing.of_finite (TensorProduct A (Localization.AtPrime 𝔭) B)
        (TensorProduct (Localization.AtPrime 𝔭) (TensorProduct A (Localization.AtPrime 𝔭) B) L)
    let e1 := Algebra.TensorProduct.comm (Localization.AtPrime 𝔭)
      (TensorProduct A (Localization.AtPrime 𝔭) B) L
    let e2 := Algebra.TensorProduct.cancelBaseChange A (Localization.AtPrime 𝔭) L L B
    exact isNoetherianRing_of_ringEquiv _ (e1.toRingEquiv.trans e2.toRingEquiv)
  haveI hT0 : IsNoetherianRing (TensorProduct A L C) := hnoeth C
  haveI hT1 : IsNoetherianRing (TensorProduct A L D) := hnoeth D
  clear hnoeth

  let φ : TensorProduct A L C →ₐ[A] TensorProduct A L D :=
    Algebra.TensorProduct.map (AlgHom.id A L) (IsScalarTower.toAlgHom A C D)
  letI : Algebra C (TensorProduct A L C) := Algebra.TensorProduct.rightAlgebra
  letI : Algebra D (TensorProduct A L D) := Algebra.TensorProduct.rightAlgebra
  letI : Algebra (TensorProduct A L C) (TensorProduct A L D) := φ.toRingHom.toAlgebra
  letI : Algebra C (TensorProduct A L D) :=
    ((algebraMap D (TensorProduct A L D)).comp (algebraMap C D)).toAlgebra
  haveI : IsScalarTower A C (TensorProduct A L C) := Algebra.TensorProduct.right_isScalarTower
  haveI : IsScalarTower A D (TensorProduct A L D) := Algebra.TensorProduct.right_isScalarTower
  haveI : IsScalarTower C D (TensorProduct A L D) :=
    IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  haveI : IsScalarTower C (TensorProduct A L C) (TensorProduct A L D) :=
    IsScalarTower.of_algebraMap_eq (fun c => by
      change (1 : L) ⊗ₜ[A] (algebraMap C D c) = φ ((1 : L) ⊗ₜ[A] c)
      simp [φ, Algebra.TensorProduct.map_tmul])
  haveI : IsScalarTower A (TensorProduct A L C) (TensorProduct A L D) :=
    IsScalarTower.of_algebraMap_eq (fun a => (φ.commutes a).symm)
  haveI : IsScalarTower L (TensorProduct A L C) (TensorProduct A L D) :=
    IsScalarTower.of_algebraMap_eq (fun l => by
      change l ⊗ₜ[A] (1 : D) = φ (l ⊗ₜ[A] (1 : C))
      simp [φ, Algebra.TensorProduct.map_tmul])
  haveI hPC : Algebra.IsPushout A C L (TensorProduct A L C) := TensorProduct.isPushout'
  haveI hPD : Algebra.IsPushout A D L (TensorProduct A L D) := TensorProduct.isPushout'
  haveI hP : Algebra.IsPushout C D (TensorProduct A L C) (TensorProduct A L D) :=
    (Algebra.IsPushout.comp_iff A C L (TensorProduct A L C)).mp hPD
  have hff' : (algebraMap (TensorProduct A L C) (TensorProduct A L D)).FaithfullyFlat :=
    RingHom.FaithfullyFlat.isStableUnderBaseChange C D (TensorProduct A L C)
      (TensorProduct A L D) (RingHom.faithfullyFlat_algebraMap_iff.mpr hff)
  haveI : Module.FaithfullyFlat (TensorProduct A L C) (TensorProduct A L D) :=
    RingHom.faithfullyFlat_algebraMap_iff.mp hff'
  have hflat : (algebraMap (TensorProduct A L C) (TensorProduct A L D)).Flat :=
    RingHom.flat_algebraMap_iff.mpr inferInstance
  obtain ⟨⟨𝔔', h𝔔'⟩, heq⟩ :=
    PrimeSpectrum.comap_surjective_of_faithfullyFlat
      (A := TensorProduct A L C) (B := TensorProduct A L D) ⟨𝔔, inferInstance⟩
  have hQ : 𝔔 = 𝔔'.comap (algebraMap (TensorProduct A L C) (TensorProduct A L D)) :=
    (congrArg PrimeSpectrum.asIdeal heq).symm
  haveI := h𝔔'
  let ψ := Localization.localRingHom 𝔔 𝔔' (algebraMap (TensorProduct A L C) (TensorProduct A L D)) hQ
  have hψflat : ψ.Flat := RingHom.Flat.localRingHom hflat 𝔔' 𝔔 hQ
  have hψloc : IsLocalHom ψ := Localization.isLocalHom_localRingHom 𝔔 𝔔' _ hQ
  letI : Algebra (Localization.AtPrime 𝔔) (Localization.AtPrime 𝔔') := ψ.toAlgebra
  haveI : Module.Flat (Localization.AtPrime 𝔔) (Localization.AtPrime 𝔔') :=
    RingHom.flat_algebraMap_iff.mp hψflat
  haveI : IsLocalHom (algebraMap (Localization.AtPrime 𝔔) (Localization.AtPrime 𝔔')) := hψloc
  haveI : IsNoetherianRing (Localization.AtPrime 𝔔) :=
    IsLocalization.isNoetherianRing 𝔔.primeCompl _ hT0
  haveI : IsNoetherianRing (Localization.AtPrime 𝔔') :=
    IsLocalization.isNoetherianRing 𝔔'.primeCompl _ hT1
  exact R2.down (Localization.AtPrime 𝔔) (Localization.AtPrime 𝔔') (hD.down 𝔭 L 𝔔')

theorem wc_hnas_pfc_grf_comp : (∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A] (B : Type u) [CommRing B] [IsLocalRing B] [IsNoetherianRing B] [Algebra A B] [IsLocalHom (algebraMap A B)] [Module.Flat A B], IsRegularLocalRing A → IsRegularLocalRing (B ⧸ Ideal.map (algebraMap A B) (IsLocalRing.maximalIdeal A)) → IsRegularLocalRing B) → ∀ (A : Type u) [CommRing A] (C : Type u) [CommRing C] (D : Type u) [CommRing D] [Algebra A C] [Algebra A D] [Algebra C D] [IsScalarTower A C D] [IsNoetherianRing C] [IsNoetherianRing D], Module.Flat C D → (∀ (𝔭 : Ideal A) [𝔭.IsPrime] (L : Type u) [Field L] [Algebra A L] [Algebra 𝔭.ResidueField L] [IsScalarTower A 𝔭.ResidueField L] [FiniteDimensional 𝔭.ResidueField L] (𝔔 : Ideal (TensorProduct A L C)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) → (∀ (𝔭 : Ideal C) [𝔭.IsPrime] (L : Type u) [Field L] [Algebra C L] [Algebra 𝔭.ResidueField L] [IsScalarTower C 𝔭.ResidueField L] [FiniteDimensional 𝔭.ResidueField L] (𝔔 : Ideal (TensorProduct C L D)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) → ∀ (𝔭 : Ideal A) [𝔭.IsPrime] (L : Type u) [Field L] [Algebra A L] [Algebra 𝔭.ResidueField L] [IsScalarTower A 𝔭.ResidueField L] [FiniteDimensional 𝔭.ResidueField L] (𝔔 : Ideal (TensorProduct A L D)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔) :=
by

  have hresfin : ∀ (A : Type u) [CommRing A] (C : Type u) [CommRing C] [Algebra A C] (𝔭 : Ideal A) [𝔭.IsPrime] (L : Type u) [Field L] [Algebra A L] [Algebra 𝔭.ResidueField L] [IsScalarTower A 𝔭.ResidueField L] [FiniteDimensional 𝔭.ResidueField L] (𝔓 : Ideal (TensorProduct A L C)) [𝔓.IsPrime], (Ideal.ResidueField.map (𝔓.comap (Algebra.TensorProduct.includeRight : C →ₐ[A] TensorProduct A L C).toRingHom) 𝔓 (Algebra.TensorProduct.includeRight : C →ₐ[A] TensorProduct A L C).toRingHom rfl).Finite := by
    intro A _ C _ _ 𝔭 _ L _ _ _ _ _ 𝔓 _
    have hfrac : ∀ k : 𝔓.ResidueField, ∃ t s : TensorProduct A L C, s ∉ 𝔓 ∧
        k = algebraMap _ 𝔓.ResidueField t * (algebraMap _ 𝔓.ResidueField s)⁻¹ := by
      intro k
      obtain ⟨w, rfl⟩ := IsLocalRing.residue_surjective k
      obtain ⟨⟨t, s⟩, rfl⟩ := IsLocalization.mk'_surjective 𝔓.primeCompl w
      refine ⟨t, s, s.2, ?_⟩
      have hs : algebraMap _ 𝔓.ResidueField (s : TensorProduct A L C) ≠ 0 := by
        rw [Ne, Ideal.algebraMap_residueField_eq_zero]
        exact s.2
      rw [eq_mul_inv_iff_mul_eq₀ hs,
        IsScalarTower.algebraMap_apply (TensorProduct A L C) (Localization.AtPrime 𝔓) 𝔓.ResidueField,
        IsScalarTower.algebraMap_apply (TensorProduct A L C) (Localization.AtPrime 𝔓) 𝔓.ResidueField t,
        IsLocalRing.ResidueField.algebraMap_eq, ← map_mul, IsLocalization.mk'_spec]
    let incl : C →+* TensorProduct A L C :=
      (Algebra.TensorProduct.includeRight : C →ₐ[A] TensorProduct A L C).toRingHom
    let j : L →+* TensorProduct A L C :=
      (Algebra.TensorProduct.includeLeft : L →ₐ[A] TensorProduct A L C).toRingHom
    let τ : TensorProduct A L C →+* 𝔓.ResidueField := algebraMap _ _
    let 𝔯 : Ideal C := 𝔓.comap incl
    have e1 : ∀ a : A, incl (algebraMap A C a) = j (algebraMap A L a) := by
      intro a
      change Algebra.TensorProduct.includeRight (algebraMap A C a) =
        Algebra.TensorProduct.includeLeft (algebraMap A L a)
      rw [AlgHom.commutes, AlgHom.commutes]
    haveI : (𝔓.comap j).IsPrime := Ideal.comap_isPrime _ _
    have hj : 𝔓.comap j = ⊥ := Ideal.eq_bot_of_prime _
    have h𝔭 : 𝔭 = 𝔯.comap (algebraMap A C) := by
      ext a
      rw [Ideal.mem_comap, Ideal.mem_comap]
      have h2 : j (algebraMap A L a) ∈ 𝔓 ↔ algebraMap A L a = 0 := by
        rw [← Ideal.mem_comap, hj, Ideal.mem_bot]
      rw [e1, h2, IsScalarTower.algebraMap_apply A 𝔭.ResidueField L,
        map_eq_zero_iff _ (algebraMap 𝔭.ResidueField L).injective, ← RingHom.mem_ker,
        Ideal.ker_algebraMap_residueField]
    let σ : 𝔭.ResidueField →+* 𝔯.ResidueField := Ideal.ResidueField.map 𝔭 𝔯 (algebraMap A C) h𝔭
    let ρ : 𝔯.ResidueField →+* 𝔓.ResidueField := Ideal.ResidueField.map 𝔯 𝔓 incl rfl
    have hι : (τ.comp j).comp (algebraMap 𝔭.ResidueField L) = ρ.comp σ := by
      apply Ideal.ResidueField.ringHom_ext
      apply RingHom.ext
      intro a
      simp only [RingHom.comp_apply]
      rw [← IsScalarTower.algebraMap_apply, Ideal.ResidueField.map_algebraMap,
        Ideal.ResidueField.map_algebraMap, e1]
    letI : Algebra 𝔯.ResidueField 𝔓.ResidueField := ρ.toAlgebra
    letI : Algebra 𝔭.ResidueField 𝔯.ResidueField := σ.toAlgebra
    letI : Algebra 𝔭.ResidueField 𝔓.ResidueField := (ρ.comp σ).toAlgebra
    haveI : IsScalarTower 𝔭.ResidueField 𝔯.ResidueField 𝔓.ResidueField :=
      IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    let f : L →ₐ[𝔭.ResidueField] 𝔓.ResidueField :=
      { toRingHom := τ.comp j
        commutes' := fun c => RingHom.congr_fun hι c }
    let b := Module.finBasis 𝔭.ResidueField L
    let y : Fin (Module.finrank 𝔭.ResidueField L) → 𝔓.ResidueField := fun s => τ (j (b s))
    have hyint : ∀ s, IsIntegral 𝔯.ResidueField (y s) := by
      intro s
      have h1 : IsIntegral 𝔭.ResidueField (b s) := IsIntegral.of_finite _ _
      have h2 : IsIntegral 𝔭.ResidueField (f (b s)) := by
        haveI : IsScalarTower 𝔭.ResidueField 𝔭.ResidueField 𝔓.ResidueField :=
          IsScalarTower.of_algebraMap_eq (fun _ => rfl)
        exact IsIntegral.map f h1
      exact IsIntegral.tower_top h2
    let S : Subalgebra 𝔯.ResidueField 𝔓.ResidueField := Algebra.adjoin 𝔯.ResidueField (Set.range y)
    haveI hfinS : Module.Finite 𝔯.ResidueField S :=
      Algebra.finite_adjoin_of_finite_of_isIntegral (Set.finite_range y)
        (by rintro _ ⟨s, rfl⟩; exact hyint s)
    have hjS : ∀ l : L, τ (j l) ∈ S := by
      intro l
      rw [← b.sum_repr l, map_sum, map_sum]
      refine Subalgebra.sum_mem _ (fun s _ => ?_)
      rw [Algebra.smul_def, map_mul, map_mul]
      refine Subalgebra.mul_mem _ ?_ (Algebra.subset_adjoin ⟨s, rfl⟩)
      have h3 := RingHom.congr_fun hι (b.repr l s)
      simp only [RingHom.comp_apply] at h3
      rw [h3]
      exact Subalgebra.algebraMap_mem S (σ (b.repr l s))
    have hincS : ∀ c : C, τ (incl c) ∈ S := by
      intro c
      have h4 := Ideal.ResidueField.map_algebraMap 𝔯 𝔓 incl rfl c
      change τ (incl c) ∈ S
      rw [show τ (incl c) = ρ (algebraMap C 𝔯.ResidueField c) from h4.symm]
      exact Subalgebra.algebraMap_mem S _
    have hTS : ∀ x : TensorProduct A L C, τ x ∈ S := by
      intro x
      induction x using TensorProduct.induction_on with
      | zero => rw [map_zero]; exact Subalgebra.zero_mem S
      | tmul l c =>
        have h5 : (l ⊗ₜ[A] c : TensorProduct A L C) = j l * incl c := by
          simp [j, incl, Algebra.TensorProduct.tmul_mul_tmul]
        rw [h5, map_mul]
        exact Subalgebra.mul_mem _ (hjS l) (hincS c)
      | add x y hx hy => rw [map_add]; exact Subalgebra.add_mem _ hx hy
    have hinv : ∀ x ∈ S, x⁻¹ ∈ S := by
      intro x hx
      have h6 : IsIntegral 𝔯.ResidueField (S.val ⟨x, hx⟩) :=
        IsIntegral.map S.val (IsIntegral.of_finite 𝔯.ResidueField (⟨x, hx⟩ : S))
      exact Subalgebra.inv_mem_of_algebraic S (x := ⟨x, hx⟩) h6.isAlgebraic
    have hall : ∀ z : 𝔓.ResidueField, z ∈ S := by
      intro z
      obtain ⟨t, s, _, rfl⟩ := hfrac z
      exact Subalgebra.mul_mem _ (hTS t) (hinv _ (hTS s))
    show Module.Finite 𝔯.ResidueField 𝔓.ResidueField
    exact Module.Finite.of_surjective S.val.toLinearMap (fun z => ⟨⟨z, hall z⟩, rfl⟩)

  have hfibloc : ∀ (T : Type u) [CommRing T] (V : Type u) [CommRing V] [Algebra T V] (𝔔 : Ideal V) [𝔔.IsPrime], ∃ (𝔔' : Ideal (TensorProduct T (𝔔.comap (algebraMap T V)).ResidueField V)) (_ : 𝔔'.IsPrime), Nonempty (Localization.AtPrime 𝔔' ≃+* (Localization.AtPrime 𝔔 ⧸ Ideal.map (Localization.localRingHom (𝔔.comap (algebraMap T V)) 𝔔 (algebraMap T V) rfl) (IsLocalRing.maximalIdeal (Localization.AtPrime (𝔔.comap (algebraMap T V)))))) := by
    intro T _ V _ _ 𝔔 _
    let 𝔓 : Ideal T := 𝔔.comap (algebraMap T V)
    haveI h𝔓 : 𝔓.IsPrime := Ideal.comap_isPrime _ _
    let φ : Localization.AtPrime 𝔓 →+* Localization.AtPrime 𝔔 :=
      Localization.localRingHom 𝔓 𝔔 (algebraMap T V) rfl
    haveI hφloc : IsLocalHom φ := Localization.isLocalHom_localRingHom 𝔓 𝔔 _ rfl
    let I : Ideal (Localization.AtPrime 𝔔) :=
      Ideal.map φ (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔓))
    have hI : I ≤ IsLocalRing.maximalIdeal (Localization.AtPrime 𝔔) := by
      rw [Ideal.map_le_iff_le_comap]
      intro x hx
      rw [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      intro hu
      exact (IsLocalRing.mem_maximalIdeal _).mp hx (isUnit_of_map_unit φ x hu)
    haveI : Nontrivial (Localization.AtPrime 𝔔 ⧸ I) :=
      Ideal.Quotient.nontrivial_iff.mpr
        (ne_top_of_le_ne_top (Ideal.IsMaximal.ne_top inferInstance) hI)
    haveI : IsLocalRing (Localization.AtPrime 𝔔 ⧸ I) :=
      IsLocalRing.of_surjective' (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective
    let π : Localization.AtPrime 𝔔 →+* Localization.AtPrime 𝔔 ⧸ I := Ideal.Quotient.mk I
    let φbar : 𝔓.ResidueField →+* Localization.AtPrime 𝔔 ⧸ I :=
      Ideal.Quotient.lift (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔓)) (π.comp φ)
        (fun a ha => Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_map_of_mem φ ha))
    let γ : V →+* Localization.AtPrime 𝔔 ⧸ I := π.comp (algebraMap V (Localization.AtPrime 𝔔))
    have hagree : ∀ t : T, φbar (algebraMap T 𝔓.ResidueField t) = γ (algebraMap T V t) := by
      intro t
      rw [IsScalarTower.algebraMap_apply T (Localization.AtPrime 𝔓) 𝔓.ResidueField]
      change π (φ (algebraMap T (Localization.AtPrime 𝔓) t)) = _
      rw [Localization.localRingHom_to_map]
      rfl
    letI : Algebra T (Localization.AtPrime 𝔔 ⧸ I) := (γ.comp (algebraMap T V)).toAlgebra
    let f1 : 𝔓.ResidueField →ₐ[T] Localization.AtPrime 𝔔 ⧸ I :=
      { toRingHom := φbar, commutes' := fun t => hagree t }
    let f2 : V →ₐ[T] Localization.AtPrime 𝔔 ⧸ I :=
      { toRingHom := γ, commutes' := fun t => rfl }
    let β : TensorProduct T 𝔓.ResidueField V →ₐ[T] Localization.AtPrime 𝔔 ⧸ I :=
      Algebra.TensorProduct.productMap f1 f2
    have hβ : ∀ k v, β (k ⊗ₜ[T] v) = φbar k * γ v := fun k v =>
      Algebra.TensorProduct.productMap_apply_tmul f1 f2 k v
    let 𝔔' : Ideal (TensorProduct T 𝔓.ResidueField V) :=
      Ideal.comap β (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔔 ⧸ I))
    haveI h𝔔' : 𝔔'.IsPrime := Ideal.comap_isPrime _ _
    refine ⟨𝔔', h𝔔', ?_⟩
    have hγu : ∀ u : V, u ∉ 𝔔 → IsUnit (γ u) := fun u hu =>
      (IsLocalization.map_units (Localization.AtPrime 𝔔) (⟨u, hu⟩ : 𝔔.primeCompl)).map π
    have hβu : ∀ u : V, u ∉ 𝔔 → (1 : 𝔓.ResidueField) ⊗ₜ[T] u ∈ 𝔔'.primeCompl := by
      intro u hu
      refine Ideal.mem_primeCompl_iff.mpr ?_
      intro h
      have h' : β ((1 : 𝔓.ResidueField) ⊗ₜ[T] u) ∈ IsLocalRing.maximalIdeal _ := h
      rw [hβ, map_one, one_mul] at h'
      exact (IsLocalRing.mem_maximalIdeal _).mp h' (hγu u hu)
    have ha : ∀ s : T, s ∉ 𝔓 → algebraMap T 𝔓.ResidueField s ≠ 0 := fun s hs h =>
      hs (Ideal.algebraMap_residueField_eq_zero.mp h)
    have hfrac : ∀ k : 𝔓.ResidueField, ∃ t s : T, s ∉ 𝔓 ∧
        k = algebraMap T 𝔓.ResidueField t * (algebraMap T 𝔓.ResidueField s)⁻¹ := by
      intro k
      obtain ⟨w, rfl⟩ := IsLocalRing.residue_surjective k
      obtain ⟨⟨t, s⟩, rfl⟩ := IsLocalization.mk'_surjective 𝔓.primeCompl w
      refine ⟨t, s, s.2, ?_⟩
      have hs : algebraMap T 𝔓.ResidueField (s : T) ≠ 0 := ha s s.2
      rw [eq_mul_inv_iff_mul_eq₀ hs,
        IsScalarTower.algebraMap_apply T (Localization.AtPrime 𝔓) 𝔓.ResidueField,
        IsScalarTower.algebraMap_apply T (Localization.AtPrime 𝔓) 𝔓.ResidueField t,
        IsLocalRing.ResidueField.algebraMap_eq, ← map_mul, IsLocalization.mk'_spec]
    have h1P : (1 : T) ∉ 𝔓 := fun h => (Ideal.IsPrime.ne_top h𝔓) ((Ideal.eq_top_iff_one _).mpr h)
    have hnf : ∀ z : TensorProduct T 𝔓.ResidueField V, ∃ s : T, s ∉ 𝔓 ∧ ∃ v : V,
        z = (algebraMap T 𝔓.ResidueField s)⁻¹ ⊗ₜ[T] v := by
      intro z
      induction z using TensorProduct.induction_on with
      | zero => exact ⟨1, h1P, 0, by rw [TensorProduct.tmul_zero]⟩
      | tmul k v =>
        obtain ⟨t, s, hs, rfl⟩ := hfrac k
        refine ⟨s, hs, t • v, ?_⟩
        rw [← TensorProduct.smul_tmul (R := T) t _ v, Algebra.smul_def]
      | add x y hx hy =>
        obtain ⟨s, hs, v, rfl⟩ := hx
        obtain ⟨s', hs', v', rfl⟩ := hy
        have hss : s * s' ∉ 𝔓 := fun h => (Ideal.IsPrime.mem_or_mem h𝔓 h).elim hs hs'
        refine ⟨s * s', hss, s' • v + s • v', ?_⟩
        rw [TensorProduct.tmul_add, ← TensorProduct.smul_tmul (R := T) s' _ v,
          ← TensorProduct.smul_tmul (R := T) s _ v', Algebra.smul_def, Algebra.smul_def, map_mul]
        have e1 : (algebraMap T 𝔓.ResidueField s)⁻¹ = algebraMap T 𝔓.ResidueField s' *
            (algebraMap T 𝔓.ResidueField s * algebraMap T 𝔓.ResidueField s')⁻¹ := by
          rw [mul_inv, mul_left_comm, mul_inv_cancel₀ (ha s' hs'), mul_one]
        have e2 : (algebraMap T 𝔓.ResidueField s')⁻¹ = algebraMap T 𝔓.ResidueField s *
            (algebraMap T 𝔓.ResidueField s * algebraMap T 𝔓.ResidueField s')⁻¹ := by
          rw [mul_inv, ← mul_assoc, mul_inv_cancel₀ (ha s hs), one_mul]
        rw [← e1, ← e2]
    have hkerR : ∀ w ∈ Ideal.map (algebraMap T V) 𝔓,
        ((1 : 𝔓.ResidueField) ⊗ₜ[T] w : TensorProduct T 𝔓.ResidueField V) = 0 := by
      intro w hw
      have hle : Ideal.map (algebraMap T V) 𝔓 ≤ RingHom.ker
          (Algebra.TensorProduct.includeRight : V →ₐ[T] TensorProduct T 𝔓.ResidueField V).toRingHom := by
        rw [Ideal.map_le_iff_le_comap]
        intro p hp
        rw [Ideal.mem_comap, RingHom.mem_ker]
        change Algebra.TensorProduct.includeRight (algebraMap T V p) = 0
        rw [AlgHom.commutes, Algebra.TensorProduct.algebraMap_apply,
          Ideal.algebraMap_residueField_eq_zero.mpr hp, TensorProduct.zero_tmul]
      exact hle hw
    have hIeq : I = Ideal.map (algebraMap V (Localization.AtPrime 𝔔))
        (Ideal.map (algebraMap T V) 𝔓) := by
      change Ideal.map φ (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔓)) = _
      rw [← Localization.AtPrime.map_eq_maximalIdeal, Ideal.map_map, Ideal.map_map]
      congr 1
      exact RingHom.ext (fun t => Localization.localRingHom_to_map 𝔓 𝔔 (algebraMap T V) rfl t)
    have hker : ∀ z : TensorProduct T 𝔓.ResidueField V, β z = 0 →
        ∃ c ∈ 𝔔'.primeCompl, c * z = 0 := by
      intro z hz
      obtain ⟨s, hs, v, rfl⟩ := hnf z
      rw [hβ] at hz
      have hu1 : IsUnit (φbar ((algebraMap T 𝔓.ResidueField s)⁻¹)) :=
        (IsUnit.mk0 _ (inv_ne_zero (ha s hs))).map φbar
      have hγv : γ v = 0 := (hu1.mul_right_eq_zero).mp hz
      have hvI : algebraMap V (Localization.AtPrime 𝔔) v ∈ I :=
        Ideal.Quotient.eq_zero_iff_mem.mp hγv
      rw [hIeq, IsLocalization.mem_map_algebraMap_iff 𝔔.primeCompl] at hvI
      obtain ⟨⟨⟨j, hj⟩, ⟨u', hu'⟩⟩, hju⟩ := hvI
      simp only at hju
      rw [← map_mul, IsLocalization.eq_iff_exists 𝔔.primeCompl] at hju
      obtain ⟨⟨c, hc⟩, hc'⟩ := hju
      simp only at hc'
      have huv : (c * u') * v ∈ Ideal.map (algebraMap T V) 𝔓 := by
        have e : (c * u') * v = c * j := by rw [← hc']; ring
        rw [e]
        exact Ideal.mul_mem_left _ _ hj
      have hcu : c * u' ∉ 𝔔 := fun h => (Ideal.IsPrime.mem_or_mem inferInstance h).elim hc hu'
      refine ⟨1 ⊗ₜ[T] (c * u'), hβu _ hcu, ?_⟩
      rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul]
      rw [show ((algebraMap T 𝔓.ResidueField s)⁻¹ ⊗ₜ[T] (c * u' * v) :
          TensorProduct T 𝔓.ResidueField V) =
          ((algebraMap T 𝔓.ResidueField s)⁻¹ ⊗ₜ[T] (1 : V)) *
            ((1 : 𝔓.ResidueField) ⊗ₜ[T] (c * u' * v)) by
          rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul],
        hkerR _ huv, mul_zero]
    letI : Algebra (TensorProduct T 𝔓.ResidueField V) (Localization.AtPrime 𝔔 ⧸ I) :=
      β.toRingHom.toAlgebra
    haveI hloc : IsLocalization 𝔔'.primeCompl (Localization.AtPrime 𝔔 ⧸ I) := by
      refine ⟨⟨?_, ?_, ?_⟩⟩
      · rintro ⟨y, hy⟩
        exact IsLocalRing.notMem_maximalIdeal.mp
          (show β y ∉ IsLocalRing.maximalIdeal (Localization.AtPrime 𝔔 ⧸ I) from hy)
      · intro w
        obtain ⟨z, rfl⟩ := Ideal.Quotient.mk_surjective w
        obtain ⟨⟨v, ⟨u, hu⟩⟩, rfl⟩ := IsLocalization.mk'_surjective 𝔔.primeCompl z
        refine ⟨⟨1 ⊗ₜ[T] v, ⟨1 ⊗ₜ[T] u, hβu u hu⟩⟩, ?_⟩
        change Ideal.Quotient.mk I (IsLocalization.mk' (Localization.AtPrime 𝔔) v ⟨u, hu⟩) *
          β (1 ⊗ₜ[T] u) = β (1 ⊗ₜ[T] v)
        rw [hβ, hβ, map_one, one_mul, one_mul]
        change Ideal.Quotient.mk I _ * Ideal.Quotient.mk I _ = Ideal.Quotient.mk I _
        rw [← map_mul, IsLocalization.mk'_spec]
      · intro x y hxy
        obtain ⟨c, hc, hc0⟩ := hker (x - y) (by
          change β (x - y) = 0
          rw [map_sub, sub_eq_zero]
          exact hxy)
        exact ⟨⟨c, hc⟩, by rw [← sub_eq_zero, ← mul_sub]; exact hc0⟩
    exact ⟨(IsLocalization.algEquiv 𝔔'.primeCompl (Localization.AtPrime 𝔔')
      (Localization.AtPrime 𝔔 ⧸ I)).toRingEquiv⟩

  intro R1' A _ C _ D _ _ _ _ _ _ _ hflat hAC' hCD' 𝔭 _ L _ _ _ _ _ 𝔔 _
  have R1 := PLift.up R1'
  have hAC := PLift.up hAC'
  have hCD := PLift.up hCD'
  have hRF := PLift.up hresfin
  have hFL := PLift.up hfibloc
  clear R1' hAC' hCD' hresfin hfibloc

  have htrans : ∀ (X : Type u) [CommRing X] (Y : Type u) [CommRing Y], (X ≃+* Y) →
      (∀ (𝔮 : Ideal X) [𝔮.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔮)) →
      ∀ (𝔮 : Ideal Y) [𝔮.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔮) := by
    intro X _ Y _ Ψ hX 𝔮 _
    have : (𝔮.comap (Ψ : X →+* Y)).IsPrime := Ideal.comap_isPrime _ _
    have h := hX (𝔮.comap (Ψ : X →+* Y))
    have H : (𝔮.comap (Ψ : X →+* Y)).primeCompl.map Ψ.toMonoidHom = 𝔮.primeCompl := by
      ext x
      constructor
      · rintro ⟨y, hy, rfl⟩
        exact hy
      · intro hx
        refine ⟨Ψ.symm x, ?_, ?_⟩
        · change Ψ (Ψ.symm x) ∉ 𝔮
          simpa using hx
        · simp
    exact IsRegularLocalRing.of_ringEquiv (IsLocalization.ringEquivOfRingEquiv
      (Localization.AtPrime (𝔮.comap (Ψ : X →+* Y))) (Localization.AtPrime 𝔮) Ψ H)

  have hnoeth : ∀ (B : Type u) [CommRing B] [Algebra A B] [IsNoetherianRing B],
      IsNoetherianRing (TensorProduct A L B) := by
    intro B _ _ _
    letI : Algebra (Localization.AtPrime 𝔭) L :=
      ((algebraMap 𝔭.ResidueField L).comp
        (algebraMap (Localization.AtPrime 𝔭) 𝔭.ResidueField)).toAlgebra
    haveI : IsScalarTower (Localization.AtPrime 𝔭) 𝔭.ResidueField L :=
      IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    haveI : IsScalarTower A (Localization.AtPrime 𝔭) L :=
      IsScalarTower.of_algebraMap_eq (fun a => by
        change algebraMap A L a = algebraMap 𝔭.ResidueField L
          (algebraMap (Localization.AtPrime 𝔭) 𝔭.ResidueField
            (algebraMap A (Localization.AtPrime 𝔭) a))
        rw [← IsScalarTower.algebraMap_apply A (Localization.AtPrime 𝔭) 𝔭.ResidueField,
          ← IsScalarTower.algebraMap_apply])
    haveI : Module.Finite (Localization.AtPrime 𝔭) L :=
      Module.Finite.trans 𝔭.ResidueField L
    haveI hN : IsNoetherianRing (TensorProduct A (Localization.AtPrime 𝔭) B) := by
      letI : Algebra B (TensorProduct A (Localization.AtPrime 𝔭) B) :=
        Algebra.TensorProduct.rightAlgebra
      haveI := IsLocalization.tensorRight (R := A) (S := B) (Localization.AtPrime 𝔭) 𝔭.primeCompl
      exact IsLocalization.isNoetherianRing (Algebra.algebraMapSubmonoid B 𝔭.primeCompl) _
        inferInstance
    haveI : IsNoetherianRing (TensorProduct (Localization.AtPrime 𝔭)
        (TensorProduct A (Localization.AtPrime 𝔭) B) L) :=
      IsNoetherianRing.of_finite (TensorProduct A (Localization.AtPrime 𝔭) B)
        (TensorProduct (Localization.AtPrime 𝔭) (TensorProduct A (Localization.AtPrime 𝔭) B) L)
    let e1 := Algebra.TensorProduct.comm (Localization.AtPrime 𝔭)
      (TensorProduct A (Localization.AtPrime 𝔭) B) L
    let e2 := Algebra.TensorProduct.cancelBaseChange A (Localization.AtPrime 𝔭) L L B
    exact isNoetherianRing_of_ringEquiv _ (e1.toRingEquiv.trans e2.toRingEquiv)
  haveI hT0 : IsNoetherianRing (TensorProduct A L C) := hnoeth C
  haveI hT1 : IsNoetherianRing (TensorProduct A L D) := hnoeth D
  clear hnoeth

  let φ : TensorProduct A L C →ₐ[A] TensorProduct A L D :=
    Algebra.TensorProduct.map (AlgHom.id A L) (IsScalarTower.toAlgHom A C D)
  letI : Algebra C (TensorProduct A L C) := Algebra.TensorProduct.rightAlgebra
  letI : Algebra D (TensorProduct A L D) := Algebra.TensorProduct.rightAlgebra
  letI : Algebra (TensorProduct A L C) (TensorProduct A L D) := φ.toRingHom.toAlgebra
  letI : Algebra C (TensorProduct A L D) :=
    ((algebraMap D (TensorProduct A L D)).comp (algebraMap C D)).toAlgebra
  haveI : IsScalarTower A C (TensorProduct A L C) := Algebra.TensorProduct.right_isScalarTower
  haveI : IsScalarTower A D (TensorProduct A L D) := Algebra.TensorProduct.right_isScalarTower
  haveI : IsScalarTower C D (TensorProduct A L D) :=
    IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  haveI : IsScalarTower C (TensorProduct A L C) (TensorProduct A L D) :=
    IsScalarTower.of_algebraMap_eq (fun c => by
      change (1 : L) ⊗ₜ[A] (algebraMap C D c) = φ ((1 : L) ⊗ₜ[A] c)
      simp [φ, Algebra.TensorProduct.map_tmul])
  haveI : IsScalarTower A (TensorProduct A L C) (TensorProduct A L D) :=
    IsScalarTower.of_algebraMap_eq (fun a => (φ.commutes a).symm)
  haveI : IsScalarTower L (TensorProduct A L C) (TensorProduct A L D) :=
    IsScalarTower.of_algebraMap_eq (fun l => by
      change l ⊗ₜ[A] (1 : D) = φ (l ⊗ₜ[A] (1 : C))
      simp [φ, Algebra.TensorProduct.map_tmul])
  haveI hPD : Algebra.IsPushout A D L (TensorProduct A L D) := TensorProduct.isPushout'
  haveI hP : Algebra.IsPushout C D (TensorProduct A L C) (TensorProduct A L D) :=
    (Algebra.IsPushout.comp_iff A C L (TensorProduct A L C)).mp hPD
  have hψflat : (algebraMap (TensorProduct A L C) (TensorProduct A L D)).Flat :=
    RingHom.Flat.isStableUnderBaseChange C D (TensorProduct A L C)
      (TensorProduct A L D) (RingHom.flat_algebraMap_iff.mpr hflat)

  let 𝔓 : Ideal (TensorProduct A L C) :=
    𝔔.comap (algebraMap (TensorProduct A L C) (TensorProduct A L D))
  haveI h𝔓 : 𝔓.IsPrime := Ideal.comap_isPrime _ _
  let 𝔯 : Ideal C :=
    𝔓.comap (Algebra.TensorProduct.includeRight : C →ₐ[A] TensorProduct A L C).toRingHom
  haveI h𝔯 : 𝔯.IsPrime := Ideal.comap_isPrime _ _

  let ψl := Localization.localRingHom 𝔓 𝔔
    (algebraMap (TensorProduct A L C) (TensorProduct A L D)) rfl
  have hψlflat : ψl.Flat := RingHom.Flat.localRingHom hψflat 𝔔 𝔓 rfl
  have hψlloc : IsLocalHom ψl := Localization.isLocalHom_localRingHom 𝔓 𝔔 _ rfl
  letI : Algebra (Localization.AtPrime 𝔓) (Localization.AtPrime 𝔔) := ψl.toAlgebra
  haveI : Module.Flat (Localization.AtPrime 𝔓) (Localization.AtPrime 𝔔) :=
    RingHom.flat_algebraMap_iff.mp hψlflat
  haveI : IsLocalHom (algebraMap (Localization.AtPrime 𝔓) (Localization.AtPrime 𝔔)) := hψlloc
  haveI : IsNoetherianRing (Localization.AtPrime 𝔓) :=
    IsLocalization.isNoetherianRing 𝔓.primeCompl _ hT0
  haveI : IsNoetherianRing (Localization.AtPrime 𝔔) :=
    IsLocalization.isNoetherianRing 𝔔.primeCompl _ hT1
  have hbase : IsRegularLocalRing (Localization.AtPrime 𝔓) := hAC.down 𝔭 L 𝔓

  haveI hP' : Algebra.IsPushout C (TensorProduct A L C) D (TensorProduct A L D) := hP.symm
  let eU : TensorProduct C (TensorProduct A L C) D ≃ₐ[TensorProduct A L C] TensorProduct A L D :=
    Algebra.IsPushout.equiv C (TensorProduct A L C) D (TensorProduct A L D)
  let E1 : TensorProduct (TensorProduct A L C) 𝔓.ResidueField (TensorProduct A L D) ≃ₐ[TensorProduct A L C]
      TensorProduct (TensorProduct A L C) 𝔓.ResidueField (TensorProduct C (TensorProduct A L C) D) :=
    Algebra.TensorProduct.congr AlgEquiv.refl eU.symm
  let E2 := Algebra.TensorProduct.cancelBaseChange C (TensorProduct A L C) 𝔓.ResidueField
    𝔓.ResidueField D
  let E : TensorProduct C 𝔓.ResidueField D ≃+*
      TensorProduct (TensorProduct A L C) 𝔓.ResidueField (TensorProduct A L D) :=
    (E1.toRingEquiv.trans E2.toRingEquiv).symm

  let ρ := Ideal.ResidueField.map 𝔯 𝔓
    (Algebra.TensorProduct.includeRight : C →ₐ[A] TensorProduct A L C).toRingHom rfl
  have hρ : ρ.Finite := hRF.down A C 𝔭 L 𝔓
  letI : Algebra 𝔯.ResidueField 𝔓.ResidueField := ρ.toAlgebra
  haveI : IsScalarTower C 𝔯.ResidueField 𝔓.ResidueField :=
    IsScalarTower.of_algebraMap_eq (fun c => by
      change _ = ρ (algebraMap C 𝔯.ResidueField c)
      rw [Ideal.ResidueField.map_algebraMap]
      rfl)
  haveI : FiniteDimensional 𝔯.ResidueField 𝔓.ResidueField := hρ
  have hKD : ∀ (𝔮 : Ideal (TensorProduct C 𝔓.ResidueField D)) [𝔮.IsPrime],
      IsRegularLocalRing (Localization.AtPrime 𝔮) := fun 𝔮 _ => hCD.down 𝔯 𝔓.ResidueField 𝔮
  have hKU := htrans _ _ E hKD

  obtain ⟨𝔔', h𝔔', ⟨e⟩⟩ := hFL.down (TensorProduct A L C) (TensorProduct A L D) 𝔔
  have h1 : IsRegularLocalRing (Localization.AtPrime 𝔔') := hKU 𝔔'
  have hfib : IsRegularLocalRing (Localization.AtPrime 𝔔 ⧸ Ideal.map
      (algebraMap (Localization.AtPrime 𝔓) (Localization.AtPrime 𝔔))
      (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔓))) :=
    IsRegularLocalRing.of_ringEquiv e
  exact R1.down (Localization.AtPrime 𝔓) (Localization.AtPrime 𝔔) hbase hfib

theorem wc_hnas_pfc_grf_localize : ∀ (A : Type u) [CommRing A] (C : Type u) [CommRing C] [Algebra A C] (𝔭' : Ideal C) [𝔭'.IsPrime] (A' : Type u) [CommRing A'] [Algebra A A'] [IsLocalization.AtPrime A' (𝔭'.comap (algebraMap A C))] [Algebra A' (Localization.AtPrime 𝔭')] [IsScalarTower A A' (Localization.AtPrime 𝔭')], (∀ (𝔭 : Ideal A) [𝔭.IsPrime] (L : Type u) [Field L] [Algebra A L] [Algebra 𝔭.ResidueField L] [IsScalarTower A 𝔭.ResidueField L] [FiniteDimensional 𝔭.ResidueField L] (𝔔 : Ideal (TensorProduct A L C)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) → ∀ (𝔭 : Ideal A') [𝔭.IsPrime] (L : Type u) [Field L] [Algebra A' L] [Algebra 𝔭.ResidueField L] [IsScalarTower A' 𝔭.ResidueField L] [FiniteDimensional 𝔭.ResidueField L] (𝔔 : Ideal (TensorProduct A' L (Localization.AtPrime 𝔭'))) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔) :=
by

  have t_s1 : ∀ (A : Type u) [CommRing A] (A' : Type u) [CommRing A'] [Algebra A A'] (S : Submonoid A) [IsLocalization S A'] (𝔭 : Ideal A') [𝔭.IsPrime], Function.Surjective (Ideal.ResidueField.map (𝔭.comap (algebraMap A A')) 𝔭 (algebraMap A A') rfl) := by
    intro A _ A' _ _ S _ 𝔭 _
    have hst : ∀ a : A, Ideal.ResidueField.map (𝔭.comap (algebraMap A A')) 𝔭 (algebraMap A A') rfl
        (algebraMap A _ a) = algebraMap A' 𝔭.ResidueField (algebraMap A A' a) :=
      fun a => Ideal.ResidueField.map_algebraMap _ _ _ _ a
    have h1 : ∀ a' : A', ∃ w, Ideal.ResidueField.map (𝔭.comap (algebraMap A A')) 𝔭
        (algebraMap A A') rfl w = algebraMap A' 𝔭.ResidueField a' := by
      intro a'
      obtain ⟨⟨a, s⟩, rfl⟩ := IsLocalization.mk'_surjective S a'
      refine ⟨algebraMap A _ a / algebraMap A _ (s : A), ?_⟩
      rw [map_div₀, hst, hst]
      have hs : IsUnit (algebraMap A A' s) := IsLocalization.map_units A' s
      have hne : algebraMap A' 𝔭.ResidueField (algebraMap A A' s) ≠ 0 := (hs.map _).ne_zero
      rw [div_eq_iff hne, ← map_mul, IsLocalization.mk'_spec]
    intro z
    obtain ⟨x, y, _, rfl⟩ := IsFractionRing.div_surjective (A := A' ⧸ 𝔭) z
    obtain ⟨a₁, rfl⟩ := Ideal.Quotient.mk_surjective x
    obtain ⟨a₂, rfl⟩ := Ideal.Quotient.mk_surjective y
    obtain ⟨w₁, hw₁⟩ := h1 a₁
    obtain ⟨w₂, hw₂⟩ := h1 a₂
    refine ⟨w₁ / w₂, ?_⟩
    rw [map_div₀, hw₁, hw₂, IsScalarTower.algebraMap_apply A' (A' ⧸ 𝔭) 𝔭.ResidueField a₁,
      IsScalarTower.algebraMap_apply A' (A' ⧸ 𝔭) 𝔭.ResidueField a₂]
    rfl

  have t_s2 : PLift (∀ (A : Type u) [CommRing A] (A' : Type u) [CommRing A'] [Algebra A A'] (S : Submonoid A) [IsLocalization S A'] (L : Type u) [CommRing L] [Algebra A' L] [Algebra A L] [IsScalarTower A A' L] (X : Type u) [CommRing X] [Algebra A' X] [Algebra A X] [IsScalarTower A A' X], Nonempty (TensorProduct A' L X ≃+* TensorProduct A L X)) := by
    refine ⟨?_⟩
    intro A _ A' _ _ S _ L _ _ _ _ X _ _ _ _
    haveI := IsLocalization.tensorProduct_compatibleSMul S A' L X
    let Θ := TensorProduct.equivOfCompatibleSMul A A' A' L X
    have hΘ : ∀ (l : L) (x : X), Θ (TensorProduct.tmul A' l x) = TensorProduct.tmul A l x :=
      fun l x => rfl
    have hmul : ∀ x y : TensorProduct A' L X, Θ (x * y) = Θ x * Θ y := by
      intro x y
      induction x using TensorProduct.induction_on with
      | zero => simp
      | tmul l x =>
        induction y using TensorProduct.induction_on with
        | zero => simp
        | tmul l' x' =>
          rw [Algebra.TensorProduct.tmul_mul_tmul, hΘ, hΘ, hΘ, Algebra.TensorProduct.tmul_mul_tmul]
        | add y z hy hz => rw [mul_add, map_add, hy, hz, map_add, mul_add]
      | add x z hx hz => rw [add_mul, map_add, hx, hz, map_add, add_mul]
    exact ⟨{ Θ.toEquiv with map_mul' := hmul, map_add' := Θ.map_add }⟩

  have t_s3 : PLift (∀ (A : Type u) [CommRing A] (C : Type u) [CommRing C] [Algebra A C] (L : Type u) [CommRing L] [Algebra A L] (S : Submonoid C), Nonempty (TensorProduct A L (Localization S) ≃+* Localization (Submonoid.map (Algebra.TensorProduct.includeRight : C →ₐ[A] TensorProduct A L C) S))) := by
    refine ⟨?_⟩
    intro A _ C _ _ L _ _ S
    set M := Submonoid.map (Algebra.TensorProduct.includeRight : C →ₐ[A] TensorProduct A L C) S
      with hM
    let j : C →ₐ[A] Localization S := IsScalarTower.toAlgHom A C (Localization S)
    let φ : TensorProduct A L C →ₐ[A] TensorProduct A L (Localization S) :=
      Algebra.TensorProduct.map (AlgHom.id A L) j
    have hφt : ∀ (l : L) (c : C), φ (TensorProduct.tmul A l c) =
        TensorProduct.tmul A l (algebraMap C (Localization S) c) := fun l c => rfl
    have hφ : ∀ y : M, IsUnit ((φ : TensorProduct A L C →+* TensorProduct A L (Localization S))
        (y : TensorProduct A L C)) := by
      rintro ⟨_, s, hs, rfl⟩
      refine IsUnit.of_mul_eq_one
        (TensorProduct.tmul A (1 : L) (IsLocalization.mk' (Localization S) (1 : C) ⟨s, hs⟩)) ?_
      change φ (TensorProduct.tmul A (1 : L) s) * _ = 1
      rw [hφt, Algebra.TensorProduct.tmul_mul_tmul, mul_one,
        (IsLocalization.mk'_spec' (Localization S) (1 : C) ⟨s, hs⟩).trans (map_one _)]
      rfl
    let Φ : Localization M →+* TensorProduct A L (Localization S) :=
      IsLocalization.lift (M := M) (S := Localization M) hφ
    have hΦκ : ∀ t, Φ (algebraMap _ (Localization M) t) = φ t := fun t => IsLocalization.lift_eq _ _
    let κ : TensorProduct A L C →+* Localization M := algebraMap _ (Localization M)
    have hγ : ∀ s : S, IsUnit ((κ.comp (Algebra.TensorProduct.includeRight :
        C →ₐ[A] TensorProduct A L C).toRingHom) (s : C)) := by
      intro s
      exact IsLocalization.map_units (Localization M) (⟨_, s, s.2, rfl⟩ : M)
    let γ' : Localization S →+* Localization M := IsLocalization.lift hγ
    have hγ'c : ∀ c : C, γ' (algebraMap C _ c) = κ (TensorProduct.tmul A (1 : L) c) :=
      fun c => IsLocalization.lift_eq _ _
    have hγ'A : ∀ a : A, γ' (algebraMap A (Localization S) a) = algebraMap A (Localization M) a := by
      intro a
      rw [IsScalarTower.algebraMap_apply A C (Localization S), hγ'c,
        IsScalarTower.algebraMap_apply A (TensorProduct A L C) (Localization M)]
      congr 1
      exact (Algebra.TensorProduct.includeRight : C →ₐ[A] TensorProduct A L C).commutes a
    let γA : Localization S →ₐ[A] Localization M := { γ' with commutes' := hγ'A }
    let lA : L →ₐ[A] Localization M :=
      (IsScalarTower.toAlgHom A (TensorProduct A L C) (Localization M)).comp
        Algebra.TensorProduct.includeLeft
    let Ψ : TensorProduct A L (Localization S) →ₐ[A] Localization M :=
      Algebra.TensorProduct.lift lA γA (fun _ _ => Commute.all _ _)
    have hΨt : ∀ (l : L) (y : Localization S), Ψ (TensorProduct.tmul A l y) =
        κ (TensorProduct.tmul A l (1 : C)) * γ' y := fun l y => rfl
    have hΨφ : ∀ t : TensorProduct A L C, Ψ (φ t) = κ t := by
      intro t
      induction t using TensorProduct.induction_on with
      | zero => simp
      | tmul l c =>
        rw [hφt, hΨt, hγ'c, ← map_mul, Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
      | add x y hx hy => rw [map_add, map_add, hx, hy, map_add]
    have h1 : (Ψ : TensorProduct A L (Localization S) →+* Localization M).comp Φ =
        RingHom.id _ := by
      apply IsLocalization.ringHom_ext M
      refine RingHom.ext fun t => ?_
      simp only [RingHom.comp_apply, RingHom.id_apply]
      rw [hΦκ]
      exact hΨφ t
    have hΦγ : Φ.comp γ' =
        (Algebra.TensorProduct.includeRight : Localization S →ₐ[A] TensorProduct A L (Localization S)).toRingHom := by
      apply IsLocalization.ringHom_ext S
      refine RingHom.ext fun c => ?_
      simp only [RingHom.comp_apply]
      rw [hγ'c, hΦκ, hφt]
      rfl
    have h2 : ∀ u : TensorProduct A L (Localization S), Φ (Ψ u) = u := by
      intro u
      induction u using TensorProduct.induction_on with
      | zero => simp
      | tmul l y =>
        rw [hΨt, map_mul, hΦκ, hφt, map_one]
        have : Φ (γ' y) = TensorProduct.tmul A (1 : L) y := by
          rw [← RingHom.comp_apply, hΦγ]
          rfl
        rw [this, Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
      | add x y hx hy => rw [map_add, map_add, hx, hy]
    exact ⟨RingEquiv.ofRingHom (Ψ : TensorProduct A L (Localization S) →+* Localization M) Φ h1
      (RingHom.ext h2)⟩

  have t_s4 : ∀ (T : Type u) [CommRing T] (M : Submonoid T) (U : Type u) [CommRing U] (_e : Localization M ≃+* U) (𝔔 : Ideal U) [𝔔.IsPrime], ∃ (𝔔₀ : Ideal T) (_ : 𝔔₀.IsPrime), Nonempty (Localization.AtPrime 𝔔₀ ≃+* Localization.AtPrime 𝔔) := by
    intro T _ M U _ e 𝔔 _
    let 𝔔₁ : Ideal (Localization M) := 𝔔.comap (e : Localization M →+* U)
    haveI : 𝔔₁.IsPrime := Ideal.comap_isPrime _ _
    have H : 𝔔₁.primeCompl.map e.toMonoidHom = 𝔔.primeCompl := by
      ext x
      constructor
      · rintro ⟨y, hy, rfl⟩
        exact hy
      · intro hx
        refine ⟨e.symm x, ?_, ?_⟩
        · change e (e.symm x) ∉ 𝔔
          simpa using hx
        · simp
    refine ⟨𝔔₁.comap (algebraMap T (Localization M)), Ideal.comap_isPrime _ _, ⟨?_⟩⟩
    exact (IsLocalization.localizationLocalizationAtPrimeIsoLocalization M 𝔔₁).toRingEquiv.trans
      (IsLocalization.ringEquivOfRingEquiv (Localization.AtPrime 𝔔₁) (Localization.AtPrime 𝔔) e H)

  intro A _ C _ _ 𝔭' _ A' _ _ _ _ _ hGRF₀ 𝔭 _ L _ _ _ _ _ 𝔔 _
  obtain hGRF : PLift (∀ (𝔭 : Ideal A) [𝔭.IsPrime] (L : Type u) [Field L] [Algebra A L] [Algebra 𝔭.ResidueField L] [IsScalarTower A 𝔭.ResidueField L] [FiniteDimensional 𝔭.ResidueField L] (𝔔 : Ideal (TensorProduct A L C)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) := ⟨hGRF₀⟩
  clear hGRF₀
  letI : Algebra A L := ((algebraMap A' L).comp (algebraMap A A')).toAlgebra
  haveI : IsScalarTower A A' L := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  let 𝔭₁ : Ideal A := 𝔭.comap (algebraMap A A')
  let ρ := Ideal.ResidueField.map 𝔭₁ 𝔭 (algebraMap A A') rfl
  letI : Algebra 𝔭₁.ResidueField 𝔭.ResidueField := ρ.toAlgebra
  letI : Algebra 𝔭₁.ResidueField L := ((algebraMap 𝔭.ResidueField L).comp ρ).toAlgebra
  haveI : IsScalarTower 𝔭₁.ResidueField 𝔭.ResidueField L :=
    IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  haveI : IsScalarTower A 𝔭₁.ResidueField L := IsScalarTower.of_algebraMap_eq (fun a => by
    change algebraMap A' L (algebraMap A A' a) =
      algebraMap 𝔭.ResidueField L (ρ (algebraMap A 𝔭₁.ResidueField a))
    rw [Ideal.ResidueField.map_algebraMap, ← IsScalarTower.algebraMap_apply A' 𝔭.ResidueField L]
    try rfl)
  have hρ : Function.Surjective ρ := t_s1 A A' (𝔭'.comap (algebraMap A C)).primeCompl 𝔭
  haveI : Module.Finite 𝔭₁.ResidueField 𝔭.ResidueField :=
    Module.Finite.of_surjective (Algebra.linearMap 𝔭₁.ResidueField 𝔭.ResidueField) hρ
  haveI : FiniteDimensional 𝔭₁.ResidueField L := Module.Finite.trans 𝔭.ResidueField L
  obtain ⟨e₁⟩ := t_s2.down A A' (𝔭'.comap (algebraMap A C)).primeCompl L (Localization.AtPrime 𝔭')
  obtain ⟨e₂⟩ := t_s3.down A C L 𝔭'.primeCompl
  let e : Localization (Submonoid.map (Algebra.TensorProduct.includeRight :
      C →ₐ[A] TensorProduct A L C) 𝔭'.primeCompl) ≃+*
      TensorProduct A' L (Localization.AtPrime 𝔭') := (e₁.trans e₂).symm
  obtain ⟨𝔔₀, h𝔔₀, ⟨ι⟩⟩ := t_s4 _ _ _ e 𝔔
  have := hGRF.down 𝔭₁ L 𝔔₀
  exact IsRegularLocalRing.of_ringEquiv ι

theorem wc_hnas_pfc_completion_flat_local : ∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A] (B : Type u) [CommRing B] [IsLocalRing B] [IsNoetherianRing B] [Algebra A B] [IsLocalHom (algebraMap A B)] [Module.Flat A B], ∃ φ : AdicCompletion (IsLocalRing.maximalIdeal A) A →+* AdicCompletion (IsLocalRing.maximalIdeal B) B, φ.comp (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A)) = (algebraMap B (AdicCompletion (IsLocalRing.maximalIdeal B) B)).comp (algebraMap A B) ∧ IsLocalHom φ ∧ φ.Flat :=
by

  have SI : ∀ (R S : Type u) [CommRing R] [CommRing S] [Algebra R S]
      (M : Type u) [AddCommGroup M] [Module R M] (I : Ideal R) (K : Submodule R M),
      K ≤ I • (⊤ : Submodule R M) → ∀ (y : TensorProduct R S K),
      (K.subtype.lTensor S) y ∈
        (Ideal.map (algebraMap R S) I) • (⊤ : Submodule S (TensorProduct R S M)) := by
    intro R S _ _ _ M _ _ I K hK y
    induction y using TensorProduct.induction_on with
    | zero => rw [map_zero]; exact Submodule.zero_mem _
    | tmul s k =>
      rw [LinearMap.lTensor_tmul]
      have hk : (k : M) ∈ I • (⊤ : Submodule R M) := hK k.2
      change TensorProduct.tmul R s (k : M) ∈ _
      refine Submodule.smul_induction_on
        (p := fun m => TensorProduct.tmul R s m ∈
          (Ideal.map (algebraMap R S) I) • (⊤ : Submodule S (TensorProduct R S M)))
        hk ?_ ?_
      · intro r hr n _
        change TensorProduct.tmul R s (r • n) ∈ _
        rw [TensorProduct.tmul_smul, ← algebraMap_smul S r (TensorProduct.tmul R s n)]
        exact Submodule.smul_mem_smul (Ideal.mem_map_of_mem _ hr) Submodule.mem_top
      · intro a b ha hb
        rw [TensorProduct.tmul_add]
        exact Submodule.add_mem _ ha hb
    | add a b ha hb => rw [map_add]; exact Submodule.add_mem _ ha hb

  have AR : ∀ (R : Type u) [CommRing R] [IsNoetherianRing R] (I J : Ideal R),
      ∃ c : ℕ, ∀ n ≥ c, ∀ x : J, (x : R) ∈ I ^ n → x ∈ I ^ (n - c) • (⊤ : Submodule R J) := by
    intro R _ _ I J
    obtain ⟨c, hc⟩ := Ideal.exists_pow_inf_eq_pow_smul I (J : Submodule R R)
    refine ⟨c, fun n hn x hx => ?_⟩
    rw [Submodule.mem_smul_top_iff]
    have h1 : (x : R) ∈ I ^ n • (⊤ : Submodule R R) ⊓ (J : Submodule R R) := by
      refine ⟨?_, x.2⟩
      rw [smul_eq_mul, Ideal.mul_top]
      exact hx
    rw [hc n hn] at h1
    exact Submodule.smul_mono le_rfl inf_le_right h1

  have TR : ∀ (A R S : Type u) [CommRing A] [CommRing R] [CommRing S] [Algebra A R]
      [Algebra R S] [Algebra A S] [IsScalarTower A R S] [Module.Flat A S] (𝔟 : Ideal A),
      (∀ r : R, ∃ a : A, r - algebraMap A R a ∈ Ideal.map (algebraMap A R) 𝔟) →
      ∀ (N₁ : Type u) [AddCommGroup N₁] [Module R N₁] [Module A N₁] [IsScalarTower A R N₁]
      (N₂ : Type u) [AddCommGroup N₂] [Module R N₂] [Module A N₂] [IsScalarTower A R N₂],
      (∀ b ∈ 𝔟, ∀ x : N₁, algebraMap A R b • x = 0) →
      (∀ b ∈ 𝔟, ∀ x : N₂, algebraMap A R b • x = 0) →
      ∀ (f : N₁ →ₗ[R] N₂), Function.Injective f → Function.Injective (f.lTensor S) := by
    intro A R S _ _ _ _ _ _ _ _ 𝔟 hd N₁ _ _ _ _ N₂ _ _ _ _ h₁ h₂ f hf
    have comp : ∀ (N : Type u) [AddCommGroup N] [Module R N] [Module A N] [IsScalarTower A R N],
        (∀ b ∈ 𝔟, ∀ x : N, algebraMap A R b • x = 0) → TensorProduct.CompatibleSMul A R S N := by
      intro N _ _ _ _ hN
      refine ⟨fun r s n => ?_⟩
      obtain ⟨a, ha⟩ := hd r
      have ht : ∀ t ∈ Ideal.map (algebraMap A R) 𝔟, ∀ (s : S) (n : N),
          TensorProduct.tmul A (t • s) n = 0 ∧ t • n = 0 := by
        intro t ht
        induction ht using Submodule.span_induction with
        | mem x hx =>
          obtain ⟨b, hb, rfl⟩ := hx
          intro s n
          refine ⟨?_, hN b hb n⟩
          rw [algebraMap_smul, TensorProduct.smul_tmul, ← algebraMap_smul R b n, hN b hb n,
            TensorProduct.tmul_zero]
        | zero => intro s n; simp
        | add x y _ _ hx hy =>
          intro s n
          refine ⟨?_, ?_⟩
          · rw [add_smul, TensorProduct.add_tmul, (hx s n).1, (hy s n).1, add_zero]
          · rw [add_smul, (hx s n).2, (hy s n).2, add_zero]
        | smul c x _ hx =>
          intro s n
          refine ⟨?_, ?_⟩
          · rw [smul_eq_mul, mul_comm, mul_smul]
            exact (hx (c • s) n).1
          · rw [smul_eq_mul, mul_smul, (hx s n).2, smul_zero]
      have hr : r = algebraMap A R a + (r - algebraMap A R a) := by ring
      rw [hr, add_smul, add_smul, TensorProduct.add_tmul, TensorProduct.tmul_add,
        (ht _ ha s n).1, (ht _ ha s n).2, add_zero, TensorProduct.tmul_zero, add_zero,
        algebraMap_smul, algebraMap_smul, TensorProduct.smul_tmul]
    haveI := comp N₁ h₁
    haveI := comp N₂ h₂
    let d₁ := TensorProduct.mapOfCompatibleSMul A R R S N₁
    let d₂ := TensorProduct.mapOfCompatibleSMul A R R S N₂
    let c₁ := TensorProduct.mapOfCompatibleSMul R A R S N₁
    have hcd : ∀ x : TensorProduct R S N₁, c₁ (d₁ x) = x := by
      intro x
      induction x using TensorProduct.induction_on with
      | zero => simp
      | tmul s n => simp [c₁, d₁, TensorProduct.mapOfCompatibleSMul_tmul]
      | add a b ha hb => rw [map_add, map_add, ha, hb]
    have hcomm : ∀ x : TensorProduct R S N₁, d₂ (f.lTensor S x) =
        (f.restrictScalars A).lTensor S (d₁ x) := by
      intro x
      induction x using TensorProduct.induction_on with
      | zero => simp
      | tmul s n => simp [d₁, d₂, TensorProduct.mapOfCompatibleSMul_tmul]
      | add a b ha hb => rw [map_add, map_add, ha, hb, map_add, map_add]
    have hinj := Module.Flat.lTensor_preserves_injective_linearMap (M := S)
      (f.restrictScalars A) hf
    intro x y hxy
    have h := congrArg d₂ hxy
    rw [hcomm, hcomm] at h
    rw [← hcd x, ← hcd y, hinj h]

  have CRIT : ∀ (A R S : Type u) [CommRing A] [CommRing R] [IsNoetherianRing R] [CommRing S]
      [IsLocalRing S] [IsNoetherianRing S] [Algebra A R] [Algebra R S] [Algebra A S]
      [IsScalarTower A R S] [Module.Flat A S] (𝔞 : Ideal A),
      (∀ (n : ℕ) (r : R), ∃ a : A, r - algebraMap A R a ∈ Ideal.map (algebraMap A R) (𝔞 ^ n)) →
      Ideal.map (algebraMap A S) 𝔞 ≤ IsLocalRing.maximalIdeal S → Module.Flat R S := by
    intro A R S _ _ _ _ _ _ _ _ _ _ _ 𝔞 hd hloc
    rw [Module.Flat.iff_lTensor_injective']
    intro J
    rw [injective_iff_map_eq_zero]
    intro x hx
    obtain ⟨c, hc⟩ := AR R (Ideal.map (algebraMap A R) 𝔞) J
    have key : ∀ m : ℕ, x ∈ (Ideal.map (algebraMap A S) 𝔞) ^ m •
        (⊤ : Submodule S (TensorProduct R S J)) := by
      intro m
      let K : Submodule R J := Submodule.comap J.subtype (Ideal.map (algebraMap A R) 𝔞 ^ (m + c))
      let Q : Submodule R R := Ideal.map (algebraMap A R) 𝔞 ^ (m + c)
      let f : (J ⧸ K) →ₗ[R] (R ⧸ Q) := K.mapQ Q J.subtype le_rfl
      have hf : Function.Injective f := by
        rw [← LinearMap.ker_eq_bot, Submodule.ker_mapQ]
        exact Submodule.mkQ_map_self K
      have hb : ∀ b ∈ 𝔞 ^ (m + c), algebraMap A R b ∈ Ideal.map (algebraMap A R) 𝔞 ^ (m + c) := by
        intro b hb
        rw [← Ideal.map_pow]
        exact Ideal.mem_map_of_mem _ hb
      have h₁ : ∀ b ∈ 𝔞 ^ (m + c), ∀ z : J ⧸ K, algebraMap A R b • z = 0 := by
        intro b hb' z
        induction z using Submodule.Quotient.induction_on with
        | H z =>
          rw [← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero]
          show ((algebraMap A R b • z : J) : R) ∈ Ideal.map (algebraMap A R) 𝔞 ^ (m + c)
          rw [Submodule.coe_smul, smul_eq_mul]
          exact Ideal.mul_mem_right _ _ (hb b hb')
      have h₂ : ∀ b ∈ 𝔞 ^ (m + c), ∀ z : R ⧸ Q, algebraMap A R b • z = 0 := by
        intro b hb' z
        induction z using Submodule.Quotient.induction_on with
        | H z =>
          rw [← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero, smul_eq_mul]
          exact Ideal.mul_mem_right _ _ (hb b hb')
      have hfi := TR A R S (𝔞 ^ (m + c)) (hd (m + c)) (J ⧸ K) (R ⧸ Q) h₁ h₂ f hf
      have e1 : f.lTensor S (K.mkQ.lTensor S x) = 0 := by
        rw [← LinearMap.lTensor_comp_apply, Submodule.mapQ_mkQ, LinearMap.lTensor_comp_apply,
          hx, map_zero]
      have e2 : K.mkQ.lTensor S x = 0 := hfi (by rw [e1, map_zero])
      obtain ⟨y, hy⟩ :=
        (lTensor_exact S (LinearMap.exact_subtype_mkQ K) (Submodule.mkQ_surjective K) x).mp e2
      have hK : K ≤ Ideal.map (algebraMap A R) 𝔞 ^ m • (⊤ : Submodule R J) := by
        intro z hz
        have h3 := hc (m + c) (by omega) z hz
        rwa [show m + c - c = m by omega] at h3
      have h3 := SI R S J (Ideal.map (algebraMap A R) 𝔞 ^ m) K hK y
      rw [hy, Ideal.map_pow, Ideal.map_map, ← IsScalarTower.algebraMap_eq] at h3
      exact h3
    have hne : Ideal.map (algebraMap A S) 𝔞 ≠ ⊤ := by
      intro h
      rw [h, top_le_iff] at hloc
      exact (IsLocalRing.maximalIdeal.isMaximal S).ne_top hloc
    have hbot := Ideal.iInf_pow_smul_eq_bot_of_isLocalRing (M := TensorProduct R S J) _ hne
    have hx' : x ∈ ⨅ i, (Ideal.map (algebraMap A S) 𝔞) ^ i •
        (⊤ : Submodule S (TensorProduct R S J)) :=
      Submodule.mem_iInf _ |>.mpr key
    rw [hbot] at hx'
    exact (Submodule.mem_bot S).mp hx'

  have ev : ∀ {X : Type u} [CommRing X] (I : Ideal X) (k : ℕ) (p : X),
      AdicCompletion.evalₐ I k (algebraMap X (AdicCompletion I X) p) =
        Ideal.Quotient.mk (I ^ k) p := by
    intro X _ I k p
    rw [AdicCompletion.algebraMap_apply, AdicCompletion.evalₐ_of]
    rfl
  have trunc : ∀ {X : Type u} [CommRing X] (I : Ideal X) {m k : ℕ} (hle : m ≤ k)
      (x : AdicCompletion I X),
      Ideal.Quotient.factorPow I hle (AdicCompletion.evalₐ I k x) =
        AdicCompletion.evalₐ I m x := by
    intro X _ I m k hle x
    obtain ⟨f, rfl⟩ := AdicCompletion.mk_surjective I X x
    rw [AdicCompletion.evalₐ_mk, AdicCompletion.evalₐ_mk]
    have h1 := AdicCompletion.AdicCauchySequence.mk_eq_mk (I := I) (M := X) hle f
    have h2 := (Submodule.Quotient.eq _).mp h1
    change Ideal.Quotient.mk (I ^ m) (f k) = Ideal.Quotient.mk (I ^ m) (f m)
    rw [Ideal.Quotient.eq]
    simpa [smul_eq_mul, Ideal.mul_top] using h2

  have ev1 : ∀ (P : Type u) [CommRing P] [IsLocalRing P] [IsNoetherianRing P]
      [IsLocalRing (AdicCompletion (IsLocalRing.maximalIdeal P) P)]
      (a : AdicCompletion (IsLocalRing.maximalIdeal P) P),
      a ∈ IsLocalRing.maximalIdeal (AdicCompletion (IsLocalRing.maximalIdeal P) P) →
      AdicCompletion.evalₐ (IsLocalRing.maximalIdeal P) 1 a = 0 := by
    intro P _ _ _ _ a ha
    let e : AdicCompletion (IsLocalRing.maximalIdeal P) P →+* IsLocalRing.ResidueField P :=
      (Ideal.quotEquivOfEq (pow_one (IsLocalRing.maximalIdeal P))).toRingHom.comp
        (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal P) 1).toRingHom
    have he : Function.Surjective e := by
      intro z
      obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective z
      refine ⟨algebraMap P (AdicCompletion (IsLocalRing.maximalIdeal P) P) p, ?_⟩
      change Ideal.quotEquivOfEq (pow_one (IsLocalRing.maximalIdeal P))
        (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal P) 1
          (algebraMap P (AdicCompletion (IsLocalRing.maximalIdeal P) P) p)) = _
      rw [ev, Ideal.quotEquivOfEq_mk]
    have hmax := IsLocalRing.eq_maximalIdeal (RingHom.ker_isMaximal_of_surjective e he)
    rw [← hmax, RingHom.mem_ker] at ha
    change Ideal.quotEquivOfEq (pow_one (IsLocalRing.maximalIdeal P))
      (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal P) 1 a) = 0 at ha
    exact (map_eq_zero_iff _ (Ideal.quotEquivOfEq _).injective).mp ha
  have MAP : ∀ (A B : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A] [CommRing B]
      [IsLocalRing B] [IsNoetherianRing B] [Algebra A B] [IsLocalHom (algebraMap A B)]
      [IsLocalRing (AdicCompletion (IsLocalRing.maximalIdeal A) A)],
      ∃ φ : AdicCompletion (IsLocalRing.maximalIdeal A) A →+*
        AdicCompletion (IsLocalRing.maximalIdeal B) B,
      φ.comp (algebraMap A _) = (algebraMap B _).comp (algebraMap A B) ∧ IsLocalHom φ := by
    intro A B _ _ _ _ _ _ _ _ _
    have hle : ∀ k, IsLocalRing.maximalIdeal A ^ k ≤
        Ideal.comap (algebraMap A B) (IsLocalRing.maximalIdeal B ^ k) := by
      intro k
      rw [← Ideal.map_le_iff_le_comap, Ideal.map_pow]
      exact Ideal.pow_right_mono (IsLocalRing.map_maximalIdeal_le (algebraMap A B)) k
    let ιb : ∀ k, A ⧸ IsLocalRing.maximalIdeal A ^ k →+* B ⧸ IsLocalRing.maximalIdeal B ^ k :=
      fun k => Ideal.quotientMap (IsLocalRing.maximalIdeal B ^ k) (algebraMap A B) (hle k)
    have hιb : ∀ k (p : A), ιb k (Ideal.Quotient.mk _ p) = Ideal.Quotient.mk _ (algebraMap A B p) :=
      fun k p => Ideal.quotientMap_mk
    let Φ := AdicCompletion.liftRingHom (IsLocalRing.maximalIdeal B)
      (fun k => (ιb k).comp (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal A) k).toRingHom) (by
        intro m k hmk
        refine RingHom.ext fun x => ?_
        change Ideal.Quotient.factorPow (IsLocalRing.maximalIdeal B) hmk
          (ιb k (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal A) k x)) =
          ιb m (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal A) m x)
        obtain ⟨a, ha⟩ := Ideal.Quotient.mk_surjective
          (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal A) k x)
        rw [← trunc (IsLocalRing.maximalIdeal A) hmk x, ← ha, hιb]
        rfl)
    have hΦev : ∀ k x, AdicCompletion.evalₐ (IsLocalRing.maximalIdeal B) k (Φ x) =
        ιb k (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal A) k x) := by
      intro k x
      exact AdicCompletion.evalₐ_liftRingHom _ _ _ k x
    refine ⟨Φ, ?_, ?_⟩
    · refine RingHom.ext fun p => ?_
      apply AdicCompletion.ext_evalₐ
      intro k
      simp only [RingHom.comp_apply]
      rw [hΦev, ev, hιb, ev]
    · refine IsLocalHom.mk fun a ha => ?_
      by_contra hna
      have ha0 := ev1 A a ((IsLocalRing.mem_maximalIdeal a).mpr hna)
      have h0 : AdicCompletion.evalₐ (IsLocalRing.maximalIdeal B) 1 (Φ a) = 0 := by
        rw [hΦev, ha0, map_zero]
      have hu := ha.map (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal B) 1)
      rw [h0, isUnit_zero_iff] at hu
      have h1 : Ideal.Quotient.mk (IsLocalRing.maximalIdeal B ^ 1) 1 = 0 := by
        rw [map_one]; exact hu.symm
      rw [Ideal.Quotient.eq_zero_iff_mem, pow_one] at h1
      exact (IsLocalRing.maximalIdeal.isMaximal B).ne_top ((Ideal.eq_top_iff_one _).mpr h1)

  intro A _ _ _ B _ _ _ _ _ _
  obtain ⟨hAl, -, -, -⟩ := wc_hnas_completion_local_complete A
  obtain ⟨hBl, -, hBloc, -⟩ := wc_hnas_completion_local_complete B
  haveI := hAl
  haveI := hBl
  haveI := wc_hnas_completion_noetherian A
  haveI := wc_hnas_completion_noetherian B
  obtain ⟨φ, hsq, hφloc⟩ := MAP A B
  refine ⟨φ, hsq, hφloc, ?_⟩
  letI : Algebra (AdicCompletion (IsLocalRing.maximalIdeal A) A)
      (AdicCompletion (IsLocalRing.maximalIdeal B) B) := φ.toAlgebra
  haveI : IsScalarTower A (AdicCompletion (IsLocalRing.maximalIdeal A) A)
      (AdicCompletion (IsLocalRing.maximalIdeal B) B) := by
    refine IsScalarTower.of_algebraMap_eq fun x => ?_
    change _ = φ (algebraMap A _ x)
    rw [← RingHom.comp_apply φ, hsq, RingHom.comp_apply,
      ← IsScalarTower.algebraMap_apply A B (AdicCompletion (IsLocalRing.maximalIdeal B) B)]
  haveI : Module.Flat B (AdicCompletion (IsLocalRing.maximalIdeal B) B) :=
    AdicCompletion.flat_of_isNoetherian _
  haveI : Module.Flat A (AdicCompletion (IsLocalRing.maximalIdeal B) B) :=
    Module.Flat.trans A B _
  haveI := hBloc
  have hloc : Ideal.map (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal B) B))
      (IsLocalRing.maximalIdeal A) ≤
      IsLocalRing.maximalIdeal (AdicCompletion (IsLocalRing.maximalIdeal B) B) := by
    rw [IsScalarTower.algebraMap_eq A B (AdicCompletion (IsLocalRing.maximalIdeal B) B)]
    exact IsLocalRing.map_maximalIdeal_le _
  have hfl := CRIT A (AdicCompletion (IsLocalRing.maximalIdeal A) A)
    (AdicCompletion (IsLocalRing.maximalIdeal B) B) (IsLocalRing.maximalIdeal A)
    (wc_hnas_hs_completion_levels A).1 hloc
  exact RingHom.flat_algebraMap_iff.mpr hfl

theorem wc_fgu_flat_fibre_ascent : (∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A] (B : Type u) [CommRing B] [IsLocalRing B] [IsNoetherianRing B] [Algebra A B] [IsLocalHom (algebraMap A B)] [Module.Flat A B], IsRegularLocalRing A → IsRegularLocalRing (B ⧸ Ideal.map (algebraMap A B) (IsLocalRing.maximalIdeal A)) → IsRegularLocalRing B) → ∀ (D : Type u) [CommRing D] [IsNoetherianRing D] (S : Type u) [CommRing S] [IsNoetherianRing S] [Algebra D S] [Module.Flat D S], (∀ (𝔔 : Ideal (D)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) → (∀ (𝔮 : Ideal D) [𝔮.IsPrime], (∀ (𝔔 : Ideal (TensorProduct D 𝔮.ResidueField S)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔))) → (∀ (𝔔 : Ideal (S)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) :=
by
  intro r1' D _ _ S _ _ _ _ hD' hF' 𝔔 _
  have R1 := PLift.up r1'
  have HD := PLift.up hD'
  have HF := PLift.up hF'
  clear r1' hD' hF'
  have regEq : ∀ (I J : Ideal S) [I.IsPrime] [J.IsPrime], I = J →
      IsRegularLocalRing (Localization.AtPrime I) → IsRegularLocalRing (Localization.AtPrime J) := by
    intro I J _ _ h hI
    subst h
    exact hI
  have key : ∀ (q0 : Ideal D) [q0.IsPrime] (P : Ideal (q0.Fiber S)) [P.IsPrime],
      q0 = (Ideal.comap Algebra.TensorProduct.includeRight P).comap (algebraMap D S) →
      IsRegularLocalRing (Localization.AtPrime (Ideal.comap Algebra.TensorProduct.includeRight P)) := by
    intro q0 _ P _ hrq
    have hflat : (Localization.localRingHom q0 (Ideal.comap Algebra.TensorProduct.includeRight P)
        (algebraMap D S) hrq).Flat :=
      RingHom.Flat.localRingHom (RingHom.flat_algebraMap_iff.mpr inferInstance) _ q0 hrq
    letI : Algebra (Localization.AtPrime q0)
        (Localization.AtPrime (Ideal.comap Algebra.TensorProduct.includeRight P)) :=
      (Localization.localRingHom q0 (Ideal.comap Algebra.TensorProduct.includeRight P)
        (algebraMap D S) hrq).toAlgebra
    haveI : Module.Flat (Localization.AtPrime q0)
        (Localization.AtPrime (Ideal.comap Algebra.TensorProduct.includeRight P)) :=
      RingHom.flat_algebraMap_iff.mp hflat
    haveI : IsLocalHom (algebraMap (Localization.AtPrime q0)
        (Localization.AtPrime (Ideal.comap Algebra.TensorProduct.includeRight P))) :=
      Localization.isLocalHom_localRingHom _ _ _ hrq
    haveI : IsNoetherianRing (Localization.AtPrime q0) :=
      IsLocalization.isNoetherianRing q0.primeCompl _ inferInstance
    haveI : IsNoetherianRing
        (Localization.AtPrime (Ideal.comap Algebra.TensorProduct.includeRight P)) :=
      IsLocalization.isNoetherianRing
        (Ideal.comap Algebra.TensorProduct.includeRight P).primeCompl _ inferInstance
    haveI : IsScalarTower D (Localization.AtPrime q0)
        (Localization.AtPrime (Ideal.comap Algebra.TensorProduct.includeRight P)) :=
      IsScalarTower.of_algebraMap_eq (fun d => by
        change _ = Localization.localRingHom q0 _ (algebraMap D S) hrq
          (algebraMap D (Localization.AtPrime q0) d)
        rw [Localization.localRingHom_to_map]
        exact IsScalarTower.algebraMap_apply D S _ d)
    have eF := Ideal.Fiber.localizationAlgEquivQuotient q0 P
    have hI : Ideal.map (algebraMap D
          (Localization.AtPrime (Ideal.comap Algebra.TensorProduct.includeRight P))) q0 =
        Ideal.map (algebraMap (Localization.AtPrime q0)
          (Localization.AtPrime (Ideal.comap Algebra.TensorProduct.includeRight P)))
          (IsLocalRing.maximalIdeal (Localization.AtPrime q0)) := by
      rw [← (Localization.AtPrime.map_eq_maximalIdeal :
          Ideal.map (algebraMap D (Localization.AtPrime q0)) q0 =
            IsLocalRing.maximalIdeal (Localization.AtPrime q0)),
        Ideal.map_map, ← IsScalarTower.algebraMap_eq]
    haveI : IsRegularLocalRing (Localization.AtPrime P) := HF.down q0 P
    haveI : IsRegularLocalRing (Localization.AtPrime q0) := HD.down q0
    haveI : IsRegularLocalRing
        (Localization.AtPrime (Ideal.comap Algebra.TensorProduct.includeRight P) ⧸
          Ideal.map (algebraMap (Localization.AtPrime q0)
            (Localization.AtPrime (Ideal.comap Algebra.TensorProduct.includeRight P)))
            (IsLocalRing.maximalIdeal (Localization.AtPrime q0))) :=
      IsRegularLocalRing.of_ringEquiv (R := Localization.AtPrime P)
        (eF.toRingEquiv.trans (Ideal.quotEquivOfEq hI))
    exact R1.down (Localization.AtPrime q0)
      (Localization.AtPrime (Ideal.comap Algebra.TensorProduct.includeRight P))
      inferInstance inferInstance
  obtain ⟨P, hr⟩ : ∃ P : PrimeSpectrum ((𝔔.comap (algebraMap D S)).Fiber S),
      Ideal.comap Algebra.TensorProduct.includeRight P.asIdeal = 𝔔 :=
    ⟨PrimeSpectrum.preimageEquivFiber D S ⟨𝔔.comap (algebraMap D S), inferInstance⟩
        ⟨⟨𝔔, inferInstance⟩, rfl⟩,
      congrArg (fun y => y.1.asIdeal)
        ((PrimeSpectrum.preimageEquivFiber D S ⟨𝔔.comap (algebraMap D S), inferInstance⟩).symm_apply_apply
          ⟨⟨𝔔, inferInstance⟩, rfl⟩)⟩
  exact regEq _ _ hr (key _ P.asIdeal (by rw [hr]))

theorem wc_fgu_purely_transcendental : (∀ (n : ℕ) (D : Type u) [CommRing D] [IsNoetherianRing D], (∀ (𝔔 : Ideal (D)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) → (∀ (𝔔 : Ideal (MvPolynomial (Fin n) D)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔))) → (∀ (S : Type u) [CommRing S] (M : Submonoid S) (T : Type u) [CommRing T] [Algebra S T] [IsLocalization M T], (∀ (𝔔 : Ideal (S)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) → (∀ (𝔔 : Ideal (T)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔))) → (∀ (S : Type u) [CommRing S] (S' : Type u) [CommRing S'], (S ≃+* S') → (∀ (𝔔 : Ideal (S)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) → (∀ (𝔔 : Ideal (S')) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔))) → ∀ (F : Type u) [Field F] (E : Type u) [Field E] [Algebra F E] (r : ℕ) (x : Fin r → E), AlgebraicIndependent F x → IntermediateField.adjoin F (Set.range x) = ⊤ → ∀ (D : Type u) [CommRing D] [Algebra F D] [IsNoetherianRing D], (∀ (𝔔 : Ideal (D)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) → IsNoetherianRing (TensorProduct F E D) ∧ (∀ (𝔔 : Ideal (TensorProduct F E D)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) :=
by
  intro mvpoly0 loc0 trans0 F _ E _ _ r x hx htop D _ _ _ hD
  have MVPOLY := PLift.up mvpoly0
  have LOC := PLift.up loc0
  have TRANS := PLift.up trans0
  clear mvpoly0 loc0 trans0
  let e : TensorProduct F (MvPolynomial (Fin r) F) D ≃+* MvPolynomial (Fin r) D :=
    (Algebra.TensorProduct.comm F (MvPolynomial (Fin r) F) D).toRingEquiv.trans
      (MvPolynomial.scalarRTensorAlgEquiv (R := F) (N := D) (σ := Fin r)).toRingEquiv
  have hBN : IsNoetherianRing (TensorProduct F (MvPolynomial (Fin r) F) D) :=
    isNoetherianRing_of_ringEquiv _ e.symm
  have hBR := TRANS.down _ _ e.symm (MVPOLY.down r D hD)
  letI : Algebra (MvPolynomial (Fin r) F) E := (MvPolynomial.aeval x).toRingHom.toAlgebra
  haveI : IsScalarTower F (MvPolynomial (Fin r) F) E :=
    IsScalarTower.of_algebraMap_eq (fun c => (MvPolynomial.aeval_C x c).symm)
  haveI : FaithfulSMul (MvPolynomial (Fin r) F) E :=
    (faithfulSMul_iff_algebraMap_injective (MvPolynomial (Fin r) F) E).mpr
      (algebraicIndependent_iff_injective_aeval.mp hx)
  haveI hfr : IsFractionRing (MvPolynomial (Fin r) F) E := by
    apply IsFractionRing.of_field
    intro z
    have hz : z ∈ IntermediateField.adjoin F (Set.range x) := by
      rw [htop]; exact IntermediateField.mem_top
    rw [IntermediateField.mem_adjoin_iff_div] at hz
    obtain ⟨p, hp, q, hq, rfl⟩ := hz
    rw [Algebra.adjoin_range_eq_range_aeval] at hp hq
    obtain ⟨U, rfl⟩ := hp
    obtain ⟨V, rfl⟩ := hq
    exact ⟨U, V, rfl⟩
  letI : Algebra (TensorProduct F (MvPolynomial (Fin r) F) D)
      (TensorProduct (MvPolynomial (Fin r) F) E (TensorProduct F (MvPolynomial (Fin r) F) D)) :=
    Algebra.TensorProduct.rightAlgebra
  haveI hloc : IsLocalization (Algebra.algebraMapSubmonoid (TensorProduct F (MvPolynomial (Fin r) F) D)
      (nonZeroDivisors (MvPolynomial (Fin r) F)))
      (TensorProduct (MvPolynomial (Fin r) F) E (TensorProduct F (MvPolynomial (Fin r) F) D)) :=
    IsLocalization.tensorRight (R := MvPolynomial (Fin r) F)
      (S := TensorProduct F (MvPolynomial (Fin r) F) D) E (nonZeroDivisors _)
  have hTN : IsNoetherianRing
      (TensorProduct (MvPolynomial (Fin r) F) E (TensorProduct F (MvPolynomial (Fin r) F) D)) := by
    have h := IsLocalization.isNoetherianRing (Algebra.algebraMapSubmonoid (TensorProduct F (MvPolynomial (Fin r) F) D)
      (nonZeroDivisors (MvPolynomial (Fin r) F)))
      (TensorProduct (MvPolynomial (Fin r) F) E (TensorProduct F (MvPolynomial (Fin r) F) D)) hBN
    exact h
  have hTR := LOC.down _ (Algebra.algebraMapSubmonoid (TensorProduct F (MvPolynomial (Fin r) F) D)
      (nonZeroDivisors (MvPolynomial (Fin r) F)))
      (TensorProduct (MvPolynomial (Fin r) F) E (TensorProduct F (MvPolynomial (Fin r) F) D)) hBR
  let c := Algebra.TensorProduct.cancelBaseChange F (MvPolynomial (Fin r) F) E E D
  exact ⟨isNoetherianRing_of_ringEquiv _ c.toRingEquiv, TRANS.down _ _ c.toRingEquiv hTR⟩

theorem wc_fgu_sep_gen : ∀ (k : Type u) [Field k] (Ω : Type u) [Field Ω] [Algebra k Ω] [IsAlgClosed Ω] (s : Finset Ω), ∃ (k₁ : IntermediateField k Ω) (r : ℕ) (x : Fin r → Ω), Algebra.IsAlgebraic k k₁ ∧ AlgebraicIndependent k₁ x ∧ ∀ a ∈ s, IsSeparable (IntermediateField.adjoin k₁ (Set.range x)) a :=
by
  intro k _ Ω _ _ _ s
  haveI hΩ : PerfectField Ω := IsAlgClosed.perfectField Ω
  haveI hk₁ : PerfectField (perfectClosure k Ω) := perfectClosure.perfectField k Ω
  haveI hEFT : Algebra.EssFiniteType (perfectClosure k Ω)
      (IntermediateField.adjoin (perfectClosure k Ω) (s : Set Ω)) :=
    IntermediateField.essFiniteType_iff.mpr (IntermediateField.fg_adjoin_finset s)
  obtain ⟨t, hT, hsep⟩ := exists_isTranscendenceBasis_and_isSeparable_of_perfectField
    (perfectClosure k Ω) (IntermediateField.adjoin (perfectClosure k Ω) (s : Set Ω))
  let k₁ := perfectClosure k Ω
  let K := IntermediateField.adjoin k₁ (s : Set Ω)
  let x : Fin t.card → Ω := fun i => ((t.equivFin.symm i : K) : Ω)
  have hx : x = (K.val ∘ Subtype.val) ∘ t.equivFin.symm := rfl
  refine ⟨k₁, t.card, x, IsPurelyInseparable.isAlgebraic k k₁, ?_, ?_⟩
  · have h1 := hT.1.comp t.equivFin.symm t.equivFin.symm.injective
    have h2 := h1.map' (f := K.val) K.val.injective
    exact h2
  · intro a ha
    let F₁ : IntermediateField k₁ K := IntermediateField.adjoin k₁ (t : Set K)
    let F₂ : IntermediateField k₁ Ω := IntermediateField.adjoin k₁ (Set.range x)
    have hrange : K.val '' (t : Set K) = Set.range x := by
      rw [hx, Function.Surjective.range_comp t.equivFin.symm.surjective, Set.range_comp]
      congr 1
      ext y
      simp
    have hmap : IntermediateField.map K.val F₁ = F₂ := by
      change IntermediateField.map K.val (IntermediateField.adjoin k₁ (t : Set K)) = F₂
      rw [IntermediateField.adjoin_map, hrange]
    let θ : F₁ ≃ₐ[k₁] F₂ :=
      (IntermediateField.equivMap F₁ K.val).trans (IntermediateField.equivOfEq hmap)
    have hθ : ∀ c : F₁, ((θ c : F₂) : Ω) = ((c : K) : Ω) := fun c => rfl
    have hcomp : (algebraMap F₂ Ω).comp (θ : F₁ →+* F₂) =
        (algebraMap K Ω).comp (algebraMap F₁ K) := by
      ext c
      exact hθ c
    let a' : K := ⟨a, IntermediateField.subset_adjoin k₁ (s : Set Ω) (Finset.mem_coe.mpr ha)⟩
    have hf : (minpoly F₁ a').Separable := @Algebra.IsSeparable.isSeparable F₁ K _ _ _ hsep a'
    have hg : ((minpoly F₁ a').map (θ : F₁ →+* F₂)).Separable := hf.map
    have hzero : Polynomial.aeval a ((minpoly F₁ a').map (θ : F₁ →+* F₂)) = 0 := by
      rw [Polynomial.aeval_def, Polynomial.eval₂_map, hcomp]
      show Polynomial.eval₂ ((algebraMap K Ω).comp (algebraMap F₁ K)) (algebraMap K Ω a')
        (minpoly F₁ a') = 0
      rw [← Polynomial.hom_eval₂, ← Polynomial.aeval_def, minpoly.aeval, map_zero]
    exact hg.of_dvd (minpoly.dvd F₂ a hzero)

theorem wc_fgu_sep_descent : ∀ (k : Type u) [Field k] (Ω : Type u) [Field Ω] [Algebra k Ω] (k₁ : IntermediateField k Ω), Algebra.IsAlgebraic k k₁ → ∀ (s : Finset Ω) (r : ℕ) (x : Fin r → Ω), AlgebraicIndependent k₁ x → (∀ a ∈ s, IsSeparable (IntermediateField.adjoin k₁ (Set.range x)) a) → ∃ k' : IntermediateField k Ω, k' ≤ k₁ ∧ FiniteDimensional k k' ∧ AlgebraicIndependent k' x ∧ ∀ a ∈ s, IsSeparable (IntermediateField.adjoin k' (Set.range x)) a :=
by
  intro k _ Ω _ _ k₁ hk₁ s r x hind hsep
  classical

  have SEP : ∀ (F₁ : Type u) [Field F₁] [Algebra F₁ Ω] (F₂ : Type u) [Field F₂] [Algebra F₂ Ω]
      (a : Ω), IsSeparable F₁ a →
      (∀ n : ℕ, algebraMap F₁ Ω ((minpoly F₁ a).coeff n) ∈ Set.range (algebraMap F₂ Ω)) →
      IsSeparable F₂ a := by
    intro F₁ _ _ F₂ _ _ a h1 h2
    have h1' : (minpoly F₁ a).Separable := h1
    have hl : (minpoly F₁ a).map (algebraMap F₁ Ω) ∈ Polynomial.lifts (algebraMap F₂ Ω) := by
      rw [Polynomial.lifts_iff_coeff_lifts]
      intro n
      rw [Polynomial.coeff_map]
      exact h2 n
    rw [Polynomial.mem_lifts] at hl
    obtain ⟨g, hg⟩ := hl
    have hgs : g.Separable := by
      rw [← Polynomial.separable_map (algebraMap F₂ Ω), hg]
      exact h1'.map
    have hroot : Polynomial.aeval a g = 0 := by
      rw [Polynomial.aeval_def, ← Polynomial.eval_map, hg, Polynomial.eval_map,
        ← Polynomial.aeval_def, minpoly.aeval]
    exact hgs.of_dvd (minpoly.dvd F₂ a hroot)

  have FC : ∀ (S : Set Ω) (C : Finset Ω), (∀ c ∈ C, c ∈ IntermediateField.adjoin k₁ S) →
      ∃ T : Finset Ω, (↑T : Set Ω) ⊆ (k₁ : Set Ω) ∧
        ∀ c ∈ C, c ∈ IntermediateField.adjoin (IntermediateField.adjoin k (↑T : Set Ω)) S := by
    intro S C hC
    have h1 : ∀ c ∈ C, ∃ U : Finset Ω, (↑U : Set Ω) ⊆ (k₁ : Set Ω) ∪ S ∧
        c ∈ IntermediateField.adjoin k (↑U : Set Ω) := by
      intro c hc
      apply IntermediateField.exists_finset_of_mem_adjoin
      have h : c ∈ IntermediateField.restrictScalars k (IntermediateField.adjoin k₁ S) :=
        (IntermediateField.mem_restrictScalars k).mpr (hC c hc)
      rw [IntermediateField.restrictScalars_adjoin_eq_sup] at h
      rw [IntermediateField.adjoin_union, IntermediateField.adjoin_self]
      exact h
    choose! U hU using h1
    refine ⟨C.biUnion (fun c => (U c).filter (· ∈ k₁)), ?_, ?_⟩
    · intro y hy
      simp only [Finset.mem_coe, Finset.mem_biUnion, Finset.mem_filter] at hy
      obtain ⟨c, _, _, h⟩ := hy
      exact h
    · intro c hc
      apply (IntermediateField.mem_restrictScalars k).mp
      rw [IntermediateField.adjoin_adjoin_left]
      refine IntermediateField.adjoin.mono k _ _ ?_ (hU c hc).2
      intro y hy
      rcases (hU c hc).1 hy with h | h
      · left
        simp only [Finset.mem_coe, Finset.mem_biUnion, Finset.mem_filter]
        exact ⟨c, hc, hy, h⟩
      · right
        exact h

  let F₁ := IntermediateField.adjoin k₁ (Set.range x)
  let C : Finset Ω := s.biUnion
    (fun a => (minpoly F₁ a).support.image (fun n => (((minpoly F₁ a).coeff n : F₁) : Ω)))
  have hC : ∀ c ∈ C, c ∈ IntermediateField.adjoin k₁ (Set.range x) := by
    intro c hc
    simp only [C, Finset.mem_biUnion, Finset.mem_image] at hc
    obtain ⟨a, _, n, _, rfl⟩ := hc
    exact ((minpoly F₁ a).coeff n).2
  obtain ⟨T, hT, hTC⟩ := FC (Set.range x) C hC

  have hle : IntermediateField.adjoin k (↑T : Set Ω) ≤ k₁ := IntermediateField.adjoin_le_iff.mpr hT
  have hfd : FiniteDimensional k (IntermediateField.adjoin k (↑T : Set Ω)) := by
    apply IntermediateField.finiteDimensional_adjoin
    intro y hy
    have hyk : y ∈ k₁ := hT hy
    have hint : IsIntegral k (⟨y, hyk⟩ : k₁) :=
      (hk₁.isAlgebraic (⟨y, hyk⟩ : k₁)).isIntegral
    exact IntermediateField.isIntegral_iff.mp hint

  have hind' : AlgebraicIndependent (IntermediateField.adjoin k (↑T : Set Ω)) x := by
    let ι : IntermediateField.adjoin k (↑T : Set Ω) →+* k₁ :=
      (IntermediateField.inclusion hle).toRingHom
    have hι : Function.Injective ι := ι.injective
    have e : (algebraMap k₁ Ω).comp ι = algebraMap (IntermediateField.adjoin k (↑T : Set Ω)) Ω :=
      RingHom.ext fun _ => rfl
    rw [algebraicIndependent_iff] at hind ⊢
    intro p hp
    apply MvPolynomial.map_injective ι hι
    rw [map_zero]
    apply hind
    rw [MvPolynomial.aeval_def, MvPolynomial.eval₂_map, e, ← MvPolynomial.aeval_def]
    exact hp
  refine ⟨IntermediateField.adjoin k (↑T : Set Ω), hle, hfd, hind', ?_⟩
  intro a ha
  apply SEP F₁ _ a (hsep a ha)
  intro n
  by_cases hn : n ∈ (minpoly F₁ a).support
  · have hmem : (((minpoly F₁ a).coeff n : F₁) : Ω) ∈ C := by
      simp only [C, Finset.mem_biUnion, Finset.mem_image]
      exact ⟨a, ha, n, hn, rfl⟩
    exact ⟨⟨_, hTC _ hmem⟩, rfl⟩
  · rw [Polynomial.notMem_support_iff.mp hn, map_zero]
    exact ⟨0, map_zero _⟩

theorem wc_fgu_maclane_sep_generated : (∀ (k : Type u) [Field k] (Ω : Type u) [Field Ω] [Algebra k Ω] [IsAlgClosed Ω] (s : Finset Ω), ∃ (k₁ : IntermediateField k Ω) (r : ℕ) (x : Fin r → Ω), Algebra.IsAlgebraic k k₁ ∧ AlgebraicIndependent k₁ x ∧ ∀ a ∈ s, IsSeparable (IntermediateField.adjoin k₁ (Set.range x)) a) → (∀ (k : Type u) [Field k] (Ω : Type u) [Field Ω] [Algebra k Ω] (k₁ : IntermediateField k Ω), Algebra.IsAlgebraic k k₁ → ∀ (s : Finset Ω) (r : ℕ) (x : Fin r → Ω), AlgebraicIndependent k₁ x → (∀ a ∈ s, IsSeparable (IntermediateField.adjoin k₁ (Set.range x)) a) → ∃ k' : IntermediateField k Ω, k' ≤ k₁ ∧ FiniteDimensional k k' ∧ AlgebraicIndependent k' x ∧ ∀ a ∈ s, IsSeparable (IntermediateField.adjoin k' (Set.range x)) a) → ∀ (k : Type u) [Field k] (L : Type u) [Field L] [Algebra k L], (∃ s : Finset L, IntermediateField.adjoin k (s : Set L) = ⊤) → ∃ (k' : Type u) (_ : Field k') (_ : Algebra k k') (_ : FiniteDimensional k k') (E : Type u) (_ : Field E) (_ : Algebra k' E) (_ : Algebra k E) (_ : IsScalarTower k k' E) (r : ℕ) (x : Fin r → E), AlgebraicIndependent k' x ∧ IntermediateField.adjoin k' (Set.range x) = ⊤ ∧ ∃ (K' : Type u) (_ : Field K') (_ : Algebra E K') (_ : Algebra k K') (_ : IsScalarTower k E K') (_ : Algebra L K') (_ : IsScalarTower k L K'), FiniteDimensional E K' ∧ Algebra.IsSeparable E K' ∧ Algebra.EssFiniteType k K' :=
by
  classical
  intro SEPGEN SEPDESC k _ L _ _ hfg
  obtain ⟨s, hs⟩ := hfg
  let ι : L →ₐ[k] AlgebraicClosure L := IsScalarTower.toAlgHom k L (AlgebraicClosure L)
  let s' : Finset (AlgebraicClosure L) := s.image ι
  obtain ⟨k₁, r, x, halg, hind₁, hsep₁⟩ := SEPGEN k (AlgebraicClosure L) s'
  obtain ⟨k', -, hfin, hind, hsep⟩ := SEPDESC k (AlgebraicClosure L) k₁ halg s' r x hind₁ hsep₁
  let E₀ : IntermediateField k' (AlgebraicClosure L) := IntermediateField.adjoin k' (Set.range x)

  let xE : Fin r → E₀ := fun i => ⟨x i, IntermediateField.subset_adjoin k' (Set.range x) ⟨i, rfl⟩⟩
  have h4 : AlgebraicIndependent k' xE := AlgebraicIndependent.of_comp E₀.val hind
  have h5 : IntermediateField.adjoin k' (Set.range xE) = ⊤ := by
    apply IntermediateField.map_injective E₀.val
    rw [IntermediateField.adjoin_map, ← Set.range_comp, ← AlgHom.fieldRange_eq_map,
      IntermediateField.fieldRange_val]
    rfl

  let K₀ : IntermediateField E₀ (AlgebraicClosure L) := IntermediateField.adjoin E₀ (s' : Set (AlgebraicClosure L))
  have h7 : FiniteDimensional E₀ K₀ :=
    IntermediateField.finiteDimensional_adjoin
      (fun a ha => (hsep a (Finset.mem_coe.mp ha)).isIntegral)
  have h8 : Algebra.IsSeparable E₀ K₀ :=
    (IntermediateField.isSeparable_adjoin_iff_isSeparable E₀ (AlgebraicClosure L)).mpr
      (fun a ha => hsep a (Finset.mem_coe.mp ha))
  have h9 : ∀ l : L, ι l ∈ K₀ := by
    let K₂ : IntermediateField k (AlgebraicClosure L) := (K₀.restrictScalars k').restrictScalars k
    have hsK : (ι '' (s : Set L)) ⊆ (K₂ : Set (AlgebraicClosure L)) := by
      rintro _ ⟨l, hl, rfl⟩
      show ι l ∈ K₂
      rw [IntermediateField.mem_restrictScalars, IntermediateField.mem_restrictScalars]
      apply IntermediateField.subset_adjoin E₀ (s' : Set (AlgebraicClosure L))
      exact Finset.mem_coe.mpr (Finset.mem_image_of_mem ι hl)
    have hle : IntermediateField.adjoin k (ι '' (s : Set L)) ≤ K₂ :=
      IntermediateField.adjoin_le_iff.mpr hsK
    intro l
    have hl : l ∈ IntermediateField.adjoin k (s : Set L) := by
      rw [hs]; exact IntermediateField.mem_top
    have hm : ι l ∈ IntermediateField.map ι (IntermediateField.adjoin k (s : Set L)) :=
      (IntermediateField.mem_map _).mpr ⟨l, hl, rfl⟩
    rw [IntermediateField.adjoin_map] at hm
    have hm2 := hle hm
    rwa [IntermediateField.mem_restrictScalars, IntermediateField.mem_restrictScalars] at hm2

  haveI : Module.Finite k k' := hfin
  haveI : Algebra.FiniteType k k' := Module.Finite.finiteType k'
  haveI e1 : Algebra.EssFiniteType k k' := Algebra.EssFiniteType.of_finiteType k k'
  haveI e2 : Algebra.EssFiniteType k' E₀ :=
    IntermediateField.essFiniteType_iff.mpr
      (IntermediateField.fg_def.mpr ⟨Set.range x, Set.finite_range x, rfl⟩)
  haveI : Module.Finite E₀ K₀ := h7
  haveI : Algebra.FiniteType E₀ K₀ := Module.Finite.finiteType K₀
  haveI e3 : Algebra.EssFiniteType E₀ K₀ := Algebra.EssFiniteType.of_finiteType E₀ K₀

  letI algkE : Algebra k E₀ := ((algebraMap k' E₀).comp (algebraMap k k')).toAlgebra
  haveI towkE : IsScalarTower k k' E₀ := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  letI algkK : Algebra k K₀ := ((algebraMap E₀ K₀).comp (algebraMap k E₀)).toAlgebra
  haveI towkK : IsScalarTower k E₀ K₀ := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  let ψ : L →+* K₀ := (ι : L →+* AlgebraicClosure L).codRestrict K₀ h9
  letI algLK : Algebra L K₀ := ψ.toAlgebra
  haveI towkLK : IsScalarTower k L K₀ := IsScalarTower.of_algebraMap_eq (fun c => by
    apply Subtype.ext
    change (((algebraMap k k' c : k') : AlgebraicClosure L)) = ι (algebraMap k L c)
    rw [AlgHom.commutes]
    exact IntermediateField.coe_algebraMap_apply k' c)
  haveI e4 : Algebra.EssFiniteType k E₀ := Algebra.EssFiniteType.comp k k' E₀
  have h11 : Algebra.EssFiniteType k K₀ := Algebra.EssFiniteType.comp k E₀ K₀
  exact ⟨k', inferInstance, inferInstance, hfin, E₀, inferInstance, inferInstance, algkE, towkE,
    r, xE, h4, h5, K₀, inferInstance, inferInstance, algkK, towkK, algLK, towkLK, h7, h8, h11⟩

theorem wc_hnas_pfc_fibre_fg_upgrade : (∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A] (B : Type u) [CommRing B] [IsLocalRing B] [IsNoetherianRing B] [Algebra A B] [IsLocalHom (algebraMap A B)] [Module.Flat A B], IsRegularLocalRing A → IsRegularLocalRing (B ⧸ Ideal.map (algebraMap A B) (IsLocalRing.maximalIdeal A)) → IsRegularLocalRing B) → (∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A] (B : Type u) [CommRing B] [IsLocalRing B] [IsNoetherianRing B] [Algebra A B] [IsLocalHom (algebraMap A B)] [Module.Flat A B], IsRegularLocalRing B → IsRegularLocalRing A) → (∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A], IsRegularLocalRing A → ∀ (𝔭 : Ideal A) [𝔭.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔭)) → ∀ (P : Type u) [CommRing P] [IsLocalRing P] [IsNoetherianRing P], (∀ (Λ : Type u) [CommRing Λ] [Algebra P Λ], Nonempty (AdicCompletion (IsLocalRing.maximalIdeal P) P ≃ₐ[P] Λ) → ∀ (𝔭 : Ideal P) [𝔭.IsPrime] (L : Type u) [Field L] [Algebra P L] [Algebra 𝔭.ResidueField L] [IsScalarTower P 𝔭.ResidueField L] [FiniteDimensional 𝔭.ResidueField L] (𝔔 : Ideal (TensorProduct P L Λ)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) → ∀ (Λ : Type u) [CommRing Λ] [Algebra P Λ], Nonempty (AdicCompletion (IsLocalRing.maximalIdeal P) P ≃ₐ[P] Λ) → ∀ (𝔭 : Ideal P) [𝔭.IsPrime] (L : Type u) [Field L] [Algebra P L] [Algebra 𝔭.ResidueField L] [IsScalarTower P 𝔭.ResidueField L], (∃ s : Finset L, IntermediateField.adjoin 𝔭.ResidueField (s : Set L) = ⊤) → ∀ (𝔔 : Ideal (TensorProduct P L Λ)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔) :=
by
  intro r1' r2' _r3 P _ _ _ hF' Λ _ _ hΛ 𝔭 _ L _ _ _ _ hfg 𝔔 _
  have R1 := PLift.up r1'
  have R2 := PLift.up r2'
  have HF := PLift.up hF'
  clear r1' r2' _r3 hF'

  have TRANS : PLift (∀ (S : Type u) [CommRing S] (S' : Type u) [CommRing S'], (S ≃+* S') → (∀ (𝔔 : Ideal (S)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) → (∀ (𝔔 : Ideal (S')) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔))) := ⟨by
    intro S _ S' _ e hS 𝔔 _
    have : (𝔔.comap (e : S →+* S')).IsPrime := Ideal.comap_isPrime _ _
    have h := hS (𝔔.comap (e : S →+* S'))
    have H : (𝔔.comap (e : S →+* S')).primeCompl.map e.toMonoidHom = 𝔔.primeCompl := by
      ext x
      constructor
      · rintro ⟨y, hy, rfl⟩
        exact hy
      · intro hx
        refine ⟨e.symm x, ?_, ?_⟩
        · change e (e.symm x) ∉ 𝔔
          simpa using hx
        · simp
    exact IsRegularLocalRing.of_ringEquiv (IsLocalization.ringEquivOfRingEquiv
      (Localization.AtPrime (𝔔.comap (e : S →+* S'))) (Localization.AtPrime 𝔔) e H)⟩

  have LOC : PLift (∀ (S : Type u) [CommRing S] (M : Submonoid S) (T : Type u) [CommRing T] [Algebra S T] [IsLocalization M T], (∀ (𝔔 : Ideal (S)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) → (∀ (𝔔 : Ideal (T)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔))) := ⟨by
    intro S _ M T _ _ _ hS 𝔔 _
    have : IsLocalization.AtPrime (Localization.AtPrime 𝔔) (𝔔.comap (algebraMap S T)) :=
      IsLocalization.isLocalization_isLocalization_atPrime_isLocalization M (Localization.AtPrime 𝔔) 𝔔
    have h := hS (𝔔.comap (algebraMap S T))
    exact IsRegularLocalRing.of_ringEquiv (IsLocalization.algEquiv (𝔔.comap (algebraMap S T)).primeCompl
      (Localization.AtPrime (𝔔.comap (algebraMap S T))) (Localization.AtPrime 𝔔)).toRingEquiv⟩

  have NOETH : PLift (∀ (k : Type u) [CommRing k] (D : Type u) [CommRing D] [Algebra k D] [IsNoetherianRing D] (L : Type u) [CommRing L] [Algebra k L] [Algebra.EssFiniteType k L], IsNoetherianRing (TensorProduct k L D)) := ⟨by
    intro k _ D _ _ _ L _ _ _
    have := Algebra.EssFiniteType.baseChange k L D
    have := Algebra.EssFiniteType.isNoetherianRing D (TensorProduct k D L)
    exact isNoetherianRing_of_ringEquiv _ (Algebra.TensorProduct.comm k D L).toRingEquiv⟩

  have FF : PLift (∀ (A : Type u) [CommRing A] [IsLocalRing A], IsField A → IsRegularLocalRing A) := ⟨by
    intro A _ _ hA
    have hm : IsLocalRing.maximalIdeal A = ⊥ := (IsLocalRing.isField_iff_maximalIdeal_eq).mp hA
    have : IsNoetherianRing A := by
      letI := hA.toField
      infer_instance
    exact ⟨by simp [hm, ringKrullDim_eq_zero_of_isField hA]⟩⟩

  have PFR : PLift (∀ (κ : Type u) [Field κ], (∀ (𝔔 : Ideal (Polynomial κ)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔))) := ⟨by
    intro κ _ 𝔔 _
    have : IsNoetherianRing (Localization.AtPrime 𝔔) :=
      IsLocalization.isNoetherianRing 𝔔.primeCompl (Localization.AtPrime 𝔔) inferInstance
    by_cases h : 𝔔 = ⊥
    · subst h
      apply FF.down
      rw [IsLocalRing.isField_iff_maximalIdeal_eq, ← Localization.AtPrime.map_eq_maximalIdeal, Ideal.map_bot]
    · have := IsLocalization.AtPrime.isDiscreteValuationRing_of_dedekind_domain (Polynomial κ) h
        (Localization.AtPrime 𝔔)
      obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible (Localization.AtPrime 𝔔)
      refine ⟨?_⟩
      rw [hϖ.maximalIdeal_eq, IsDiscreteValuationRing.ringKrullDim_eq_one]
      rw [show Ideal.span {ϖ} = (Localization.AtPrime 𝔔) ∙ ϖ from rfl,
        Submodule.spanFinrank_singleton hϖ.ne_zero]
      rfl⟩

  have FIBRE0 := PLift.up (wc_fgu_flat_fibre_ascent R1.down)

  have MVPOLY0 : PLift (∀ (n : ℕ) (D : Type u) [CommRing D] [IsNoetherianRing D], (∀ (𝔔 : Ideal (D)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) → (∀ (𝔔 : Ideal (MvPolynomial (Fin n) D)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔))) := ⟨by
    have POLY0 : ∀ (D : Type u) [CommRing D] [IsNoetherianRing D], (∀ (𝔔 : Ideal (D)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) → (∀ (𝔔 : Ideal (Polynomial D)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) := by
      intro D _ _ hD
      refine FIBRE0.down D (Polynomial D) hD ?_
      intro 𝔮 _
      exact TRANS.down _ _ (polyEquivTensor' D 𝔮.ResidueField).toRingEquiv (PFR.down _)
    intro n
    induction n with
    | zero =>
      intro D _ _ hD
      exact TRANS.down _ _ (MvPolynomial.isEmptyRingEquiv D (Fin 0)).symm hD
    | succ n ih =>
      intro D _ _ hD
      exact TRANS.down _ _ (MvPolynomial.finSuccEquiv D n).symm.toRingEquiv (POLY0 _ (ih D hD))⟩

  have TRANSC0 := PLift.up (wc_fgu_purely_transcendental MVPOLY0.down LOC.down TRANS.down)

  have FSF : PLift (∀ (E : Type u) [Field E] (N : Type u) [Field N] [Algebra E N] [FiniteDimensional E N] [Algebra.IsSeparable E N] (κ : Type u) [Field κ] [Algebra E κ], (∀ (𝔔 : Ideal (TensorProduct E κ N)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔))) := ⟨by
    intro E _ N _ _ _ _ κ _ _ 𝔔 _
    have : Module.Finite κ (TensorProduct E κ N) := Module.Finite.base_change E κ N
    have : IsArtinianRing (TensorProduct E κ N) := IsArtinianRing.of_finite κ _
    have : Algebra.FormallyUnramified E N := Algebra.FormallyUnramified.of_isSeparable E N
    have : Algebra.FormallyUnramified κ (TensorProduct E κ N) := inferInstance
    have : Algebra.EssFiniteType κ (TensorProduct E κ N) := inferInstance
    have : IsReduced (TensorProduct E κ N) := Algebra.FormallyUnramified.isReduced_of_field κ _
    have : IsArtinianRing (Localization.AtPrime 𝔔) := IsArtinianRing.localization_artinian 𝔔.primeCompl _
    apply FF.down
    exact IsArtinianRing.isField_of_isReduced_of_isLocalRing _⟩

  have SEP0 : PLift (∀ (E : Type u) [Field E] (N : Type u) [Field N] [Algebra E N] [FiniteDimensional E N] [Algebra.IsSeparable E N] (D : Type u) [CommRing D] [Algebra E D] [IsNoetherianRing D], (∀ (𝔔 : Ideal (D)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) → IsNoetherianRing (TensorProduct E D N) ∧ (∀ (𝔔 : Ideal (TensorProduct E D N)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔))) := ⟨by
    intro E _ N _ _ _ _ D _ _ _ hD
    have : Module.Finite D (TensorProduct E D N) := Module.Finite.base_change E D N
    have : IsNoetherianRing (TensorProduct E D N) := IsNoetherianRing.of_finite D _
    have : Module.Free D (TensorProduct E D N) :=
      Module.Free.of_basis (Algebra.TensorProduct.basis D (Module.Free.chooseBasis E N))
    have : Module.Flat D (TensorProduct E D N) := Module.Flat.of_free
    refine ⟨inferInstance, FIBRE0.down D _ hD ?_⟩
    intro 𝔮 _
    exact TRANS.down _ _ (Algebra.TensorProduct.cancelBaseChange E D 𝔮.ResidueField 𝔮.ResidueField N).symm.toRingEquiv
      (FSF.down E N 𝔮.ResidueField)⟩

  have DESC0 : PLift (∀ (k : Type u) [Field k] (D : Type u) [CommRing D] [Algebra k D] (L : Type u) [Field L] [Algebra k L] (L' : Type u) [Field L'] [Algebra k L'] [Algebra L L'] [IsScalarTower k L L'], IsNoetherianRing (TensorProduct k L D) → IsNoetherianRing (TensorProduct k L' D) → (∀ (𝔔 : Ideal (TensorProduct k L' D)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) → (∀ (𝔔 : Ideal (TensorProduct k L D)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔))) := ⟨by
    intro k _ D _ _ L _ _ L' _ _ _ _ hN0 hN1 hD'
    have hD : ∀ (𝔔 : Ideal (TensorProduct k D L')) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔) :=
      TRANS.down _ _ (Algebra.TensorProduct.comm k L' D).toRingEquiv hD'
    clear hD'
    suffices H : ∀ (𝔔 : Ideal (TensorProduct k D L)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔) from
      TRANS.down _ _ (Algebra.TensorProduct.comm k D L).toRingEquiv H
    have hT0 : IsNoetherianRing (TensorProduct k D L) :=
      isNoetherianRing_of_ringEquiv _ (Algebra.TensorProduct.comm k L D).toRingEquiv
    have hT1 : IsNoetherianRing (TensorProduct k D L') :=
      isNoetherianRing_of_ringEquiv _ (Algebra.TensorProduct.comm k L' D).toRingEquiv
    clear hN0 hN1
    intro 𝔔 _
    let φ : TensorProduct k D L →ₐ[k] TensorProduct k D L' :=
      Algebra.TensorProduct.map (AlgHom.id k D) (IsScalarTower.toAlgHom k L L')
    letI : Algebra L (TensorProduct k D L) := Algebra.TensorProduct.rightAlgebra
    letI : Algebra L' (TensorProduct k D L') := Algebra.TensorProduct.rightAlgebra
    letI : Algebra (TensorProduct k D L) (TensorProduct k D L') := φ.toRingHom.toAlgebra
    letI : Algebra L (TensorProduct k D L') :=
      ((algebraMap L' (TensorProduct k D L')).comp (algebraMap L L')).toAlgebra
    haveI : IsScalarTower k L (TensorProduct k D L) := Algebra.TensorProduct.right_isScalarTower
    haveI : IsScalarTower k L' (TensorProduct k D L') := Algebra.TensorProduct.right_isScalarTower
    haveI : IsScalarTower L L' (TensorProduct k D L') :=
      IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    haveI : IsScalarTower L (TensorProduct k D L) (TensorProduct k D L') :=
      IsScalarTower.of_algebraMap_eq (fun c => by
        change (1 : D) ⊗ₜ[k] (algebraMap L L' c) = φ ((1 : D) ⊗ₜ[k] c)
        simp [φ, Algebra.TensorProduct.map_tmul])
    haveI : IsScalarTower k (TensorProduct k D L) (TensorProduct k D L') :=
      IsScalarTower.of_algebraMap_eq (fun a => (φ.commutes a).symm)
    haveI : IsScalarTower D (TensorProduct k D L) (TensorProduct k D L') :=
      IsScalarTower.of_algebraMap_eq (fun l => by
        change l ⊗ₜ[k] (1 : L') = φ (l ⊗ₜ[k] (1 : L))
        simp [φ, Algebra.TensorProduct.map_tmul])
    haveI hPD : Algebra.IsPushout k L' D (TensorProduct k D L') := TensorProduct.isPushout'
    haveI hP : Algebra.IsPushout L L' (TensorProduct k D L) (TensorProduct k D L') :=
      (Algebra.IsPushout.comp_iff k L D (TensorProduct k D L)).mp hPD
    have hff' : (algebraMap (TensorProduct k D L) (TensorProduct k D L')).FaithfullyFlat :=
      RingHom.FaithfullyFlat.isStableUnderBaseChange L L' (TensorProduct k D L)
        (TensorProduct k D L') (RingHom.faithfullyFlat_algebraMap_iff.mpr inferInstance)
    haveI : Module.FaithfullyFlat (TensorProduct k D L) (TensorProduct k D L') :=
      RingHom.faithfullyFlat_algebraMap_iff.mp hff'
    have hflat : (algebraMap (TensorProduct k D L) (TensorProduct k D L')).Flat :=
      RingHom.flat_algebraMap_iff.mpr inferInstance
    obtain ⟨⟨𝔔', h𝔔'⟩, heq⟩ :=
      PrimeSpectrum.comap_surjective_of_faithfullyFlat
        (A := TensorProduct k D L) (B := TensorProduct k D L') ⟨𝔔, inferInstance⟩
    have hQ : 𝔔 = 𝔔'.comap (algebraMap (TensorProduct k D L) (TensorProduct k D L')) :=
      (congrArg PrimeSpectrum.asIdeal heq).symm
    haveI := h𝔔'
    let ψ := Localization.localRingHom 𝔔 𝔔' (algebraMap (TensorProduct k D L) (TensorProduct k D L')) hQ
    have hψflat : ψ.Flat := RingHom.Flat.localRingHom hflat 𝔔' 𝔔 hQ
    have hψloc : IsLocalHom ψ := Localization.isLocalHom_localRingHom 𝔔 𝔔' _ hQ
    letI : Algebra (Localization.AtPrime 𝔔) (Localization.AtPrime 𝔔') := ψ.toAlgebra
    haveI : Module.Flat (Localization.AtPrime 𝔔) (Localization.AtPrime 𝔔') :=
      RingHom.flat_algebraMap_iff.mp hψflat
    haveI : IsLocalHom (algebraMap (Localization.AtPrime 𝔔) (Localization.AtPrime 𝔔')) := hψloc
    haveI : IsNoetherianRing (Localization.AtPrime 𝔔) :=
      IsLocalization.isNoetherianRing 𝔔.primeCompl _ hT0
    haveI : IsNoetherianRing (Localization.AtPrime 𝔔') :=
      IsLocalization.isNoetherianRing 𝔔'.primeCompl _ hT1
    exact R2.down (Localization.AtPrime 𝔔) (Localization.AtPrime 𝔔') (hD 𝔔')⟩

  have TOWER : PLift (∀ (k : Type u) [Field k] (k' : Type u) [Field k'] [Algebra k k'] (E : Type u) [Field E] [Algebra k' E] [Algebra k E] [IsScalarTower k k' E] (K' : Type u) [Field K'] [Algebra E K'] [Algebra k K'] [IsScalarTower k E K'] (D : Type u) [CommRing D] [Algebra k D], Nonempty (TensorProduct E (TensorProduct k' E (TensorProduct k k' D)) K' ≃+* TensorProduct k K' D)) := ⟨by
    intro k _ k' _ _ E _ _ _ _ K' _ _ _ _ D _ _
    let e1 : TensorProduct k' E (TensorProduct k k' D) ≃ₐ[E] TensorProduct k E D :=
      Algebra.TensorProduct.cancelBaseChange k k' E E D
    let e2 : TensorProduct E (TensorProduct k' E (TensorProduct k k' D)) K' ≃ₐ[E]
        TensorProduct E (TensorProduct k E D) K' := Algebra.TensorProduct.congr e1 AlgEquiv.refl
    let e3 := Algebra.TensorProduct.comm E (TensorProduct k E D) K'
    let e4 : TensorProduct E K' (TensorProduct k E D) ≃ₐ[K'] TensorProduct k K' D :=
      Algebra.TensorProduct.cancelBaseChange k E K' K' D
    exact ⟨(e2.toRingEquiv.trans e3.toRingEquiv).trans e4.toRingEquiv⟩⟩

  have MACLANE0 := PLift.up (wc_fgu_maclane_sep_generated wc_fgu_sep_gen wc_fgu_sep_descent)

  have GEOREG : PLift (∀ (k : Type u) [Field k] (D : Type u) [CommRing D] [Algebra k D] [IsNoetherianRing D], (∀ (k' : Type u) [Field k'] [Algebra k k'] [FiniteDimensional k k'], (∀ (𝔔 : Ideal (TensorProduct k k' D)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔))) → ∀ (L : Type u) [Field L] [Algebra k L], (∃ s : Finset L, IntermediateField.adjoin k (s : Set L) = ⊤) → (∀ (𝔔 : Ideal (TensorProduct k L D)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔))) := ⟨by
    intro k _ D _ _ _ hD L _ _ hfgL
    obtain ⟨k', _, _, _, E, _, _, _, _, r, x, hx, hxtop, K', _, _, _, _, _, _, _, _, hKeft⟩ :=
      MACLANE0.down k L hfgL
    have : IsNoetherianRing (TensorProduct k k' D) := NOETH.down k D k'
    obtain ⟨hN2, hR2⟩ := TRANSC0.down k' E r x hx hxtop (TensorProduct k k' D) (hD k')
    have : IsNoetherianRing (TensorProduct k' E (TensorProduct k k' D)) := hN2
    obtain ⟨_, hR3⟩ := SEP0.down E K' (TensorProduct k' E (TensorProduct k k' D)) hR2
    obtain ⟨e⟩ := TOWER.down k k' E K' D
    have hR4 := TRANS.down _ _ e hR3
    have hLeft : Algebra.EssFiniteType k (⊤ : IntermediateField k L) :=
      IntermediateField.essFiniteType_iff.mpr hfgL
    have hLeft' : Algebra.EssFiniteType k L :=
      Algebra.EssFiniteType.of_surjective (IntermediateField.topEquiv : (⊤ : IntermediateField k L) ≃ₐ[k] L).toAlgHom
        IntermediateField.topEquiv.surjective
    exact DESC0.down k D L K' (NOETH.down k D L) (NOETH.down k D K') hR4⟩

  obtain ⟨eΛ⟩ := hΛ
  have : IsNoetherianRing (AdicCompletion (IsLocalRing.maximalIdeal P) P) := wc_hnas_completion_noetherian P
  have : IsNoetherianRing Λ := isNoetherianRing_of_ringEquiv _ eΛ.toRingEquiv
  have : IsNoetherianRing (TensorProduct P 𝔭.ResidueField Λ) := NOETH.down P Λ 𝔭.ResidueField
  have hGeo := GEOREG.down 𝔭.ResidueField (TensorProduct P 𝔭.ResidueField Λ) (by
    intro k' _ _ _
    letI : Algebra P k' := ((algebraMap 𝔭.ResidueField k').comp (algebraMap P 𝔭.ResidueField)).toAlgebra
    haveI : IsScalarTower P 𝔭.ResidueField k' := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    exact TRANS.down _ _ (Algebra.TensorProduct.cancelBaseChange P 𝔭.ResidueField k' k' Λ).symm.toRingEquiv
      (HF.down Λ ⟨eΛ⟩ 𝔭 k')) L hfg
  exact TRANS.down _ _ (Algebra.TensorProduct.cancelBaseChange P 𝔭.ResidueField L L Λ).toRingEquiv hGeo 𝔔

theorem wc_hnas_pfc_gring_of_maximal : (∀ (A : Type u) [CommRing A] (C : Type u) [CommRing C] (D : Type u) [CommRing D] [Algebra A C] [Algebra A D] [Algebra C D] [IsScalarTower A C D] [IsNoetherianRing C] [IsNoetherianRing D], Module.FaithfullyFlat C D → (∀ (𝔭 : Ideal A) [𝔭.IsPrime] (L : Type u) [Field L] [Algebra A L] [Algebra 𝔭.ResidueField L] [IsScalarTower A 𝔭.ResidueField L] [FiniteDimensional 𝔭.ResidueField L] (𝔔 : Ideal (TensorProduct A L D)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) → ∀ (𝔭 : Ideal A) [𝔭.IsPrime] (L : Type u) [Field L] [Algebra A L] [Algebra 𝔭.ResidueField L] [IsScalarTower A 𝔭.ResidueField L] [FiniteDimensional 𝔭.ResidueField L] (𝔔 : Ideal (TensorProduct A L C)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) → (∀ (A : Type u) [CommRing A] (C : Type u) [CommRing C] (D : Type u) [CommRing D] [Algebra A C] [Algebra A D] [Algebra C D] [IsScalarTower A C D] [IsNoetherianRing C] [IsNoetherianRing D], Module.Flat C D → (∀ (𝔭 : Ideal A) [𝔭.IsPrime] (L : Type u) [Field L] [Algebra A L] [Algebra 𝔭.ResidueField L] [IsScalarTower A 𝔭.ResidueField L] [FiniteDimensional 𝔭.ResidueField L] (𝔔 : Ideal (TensorProduct A L C)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) → (∀ (𝔭 : Ideal C) [𝔭.IsPrime] (L : Type u) [Field L] [Algebra C L] [Algebra 𝔭.ResidueField L] [IsScalarTower C 𝔭.ResidueField L] [FiniteDimensional 𝔭.ResidueField L] (𝔔 : Ideal (TensorProduct C L D)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) → ∀ (𝔭 : Ideal A) [𝔭.IsPrime] (L : Type u) [Field L] [Algebra A L] [Algebra 𝔭.ResidueField L] [IsScalarTower A 𝔭.ResidueField L] [FiniteDimensional 𝔭.ResidueField L] (𝔔 : Ideal (TensorProduct A L D)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) → (∀ (A : Type u) [CommRing A] (C : Type u) [CommRing C] (C' : Type u) [CommRing C'] [Algebra A C] [Algebra A C'], (C ≃ₐ[A] C') → (∀ (𝔭 : Ideal A) [𝔭.IsPrime] (L : Type u) [Field L] [Algebra A L] [Algebra 𝔭.ResidueField L] [IsScalarTower A 𝔭.ResidueField L] [FiniteDimensional 𝔭.ResidueField L] (𝔔 : Ideal (TensorProduct A L C)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) → ∀ (𝔭 : Ideal A) [𝔭.IsPrime] (L : Type u) [Field L] [Algebra A L] [Algebra 𝔭.ResidueField L] [IsScalarTower A 𝔭.ResidueField L] [FiniteDimensional 𝔭.ResidueField L] (𝔔 : Ideal (TensorProduct A L C')) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) → (∀ (A : Type u) [CommRing A] (C : Type u) [CommRing C] [Algebra A C] (𝔭' : Ideal C) [𝔭'.IsPrime] (A' : Type u) [CommRing A'] [Algebra A A'] [IsLocalization.AtPrime A' (𝔭'.comap (algebraMap A C))] [Algebra A' (Localization.AtPrime 𝔭')] [IsScalarTower A A' (Localization.AtPrime 𝔭')], (∀ (𝔭 : Ideal A) [𝔭.IsPrime] (L : Type u) [Field L] [Algebra A L] [Algebra 𝔭.ResidueField L] [IsScalarTower A 𝔭.ResidueField L] [FiniteDimensional 𝔭.ResidueField L] (𝔔 : Ideal (TensorProduct A L C)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) → ∀ (𝔭 : Ideal A') [𝔭.IsPrime] (L : Type u) [Field L] [Algebra A' L] [Algebra 𝔭.ResidueField L] [IsScalarTower A' 𝔭.ResidueField L] [FiniteDimensional 𝔭.ResidueField L] (𝔔 : Ideal (TensorProduct A' L (Localization.AtPrime 𝔭'))) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) → (∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A] (B : Type u) [CommRing B] [IsLocalRing B] [IsNoetherianRing B] [Algebra A B] [IsLocalHom (algebraMap A B)] [Module.Flat A B], ∃ φ : AdicCompletion (IsLocalRing.maximalIdeal A) A →+* AdicCompletion (IsLocalRing.maximalIdeal B) B, φ.comp (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A)) = (algebraMap B (AdicCompletion (IsLocalRing.maximalIdeal B) B)).comp (algebraMap A B) ∧ IsLocalHom φ ∧ φ.Flat) → (∀ (C : Type u) [CommRing C] [IsLocalRing C] [IsNoetherianRing C], IsAdicComplete (IsLocalRing.maximalIdeal C) C → (IsNoetherianRing C ∧ ∀ (𝔪 : Ideal C) [𝔪.IsPrime], ∀ (Λ : Type u) [CommRing Λ] [Algebra (Localization.AtPrime 𝔪) Λ], Nonempty (AdicCompletion (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔪)) (Localization.AtPrime 𝔪) ≃ₐ[Localization.AtPrime 𝔪] Λ) → ∀ (𝔭 : Ideal (Localization.AtPrime 𝔪)) [𝔭.IsPrime] (L : Type u) [Field L] [Algebra (Localization.AtPrime 𝔪) L] [Algebra 𝔭.ResidueField L] [IsScalarTower (Localization.AtPrime 𝔪) 𝔭.ResidueField L] [FiniteDimensional 𝔭.ResidueField L] (𝔔 : Ideal (TensorProduct (Localization.AtPrime 𝔪) L Λ)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔))) → ∀ (S : Type u) [CommRing S] [IsNoetherianRing S], (∀ (𝔪 : Ideal S) [𝔪.IsMaximal], ∀ (Λ : Type u) [CommRing Λ] [Algebra (Localization.AtPrime 𝔪) Λ], Nonempty (AdicCompletion (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔪)) (Localization.AtPrime 𝔪) ≃ₐ[Localization.AtPrime 𝔪] Λ) → ∀ (𝔭 : Ideal (Localization.AtPrime 𝔪)) [𝔭.IsPrime] (L : Type u) [Field L] [Algebra (Localization.AtPrime 𝔪) L] [Algebra 𝔭.ResidueField L] [IsScalarTower (Localization.AtPrime 𝔪) 𝔭.ResidueField L] [FiniteDimensional 𝔭.ResidueField L] (𝔔 : Ideal (TensorProduct (Localization.AtPrime 𝔪) L Λ)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) → (IsNoetherianRing S ∧ ∀ (𝔪 : Ideal S) [𝔪.IsPrime], ∀ (Λ : Type u) [CommRing Λ] [Algebra (Localization.AtPrime 𝔪) Λ], Nonempty (AdicCompletion (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔪)) (Localization.AtPrime 𝔪) ≃ₐ[Localization.AtPrime 𝔪] Λ) → ∀ (𝔭 : Ideal (Localization.AtPrime 𝔪)) [𝔭.IsPrime] (L : Type u) [Field L] [Algebra (Localization.AtPrime 𝔪) L] [Algebra 𝔭.ResidueField L] [IsScalarTower (Localization.AtPrime 𝔪) 𝔭.ResidueField L] [FiniteDimensional 𝔭.ResidueField L] (𝔔 : Ideal (TensorProduct (Localization.AtPrime 𝔪) L Λ)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) :=
by
  have s1 : ∀ (S : Type u) [CommRing S] (𝔭 𝔪 : Ideal S) [𝔭.IsPrime] [𝔪.IsPrime], 𝔭 ≤ 𝔪 → ∀ [Algebra (Localization.AtPrime 𝔪) (Localization.AtPrime 𝔭)] [IsScalarTower S (Localization.AtPrime 𝔪) (Localization.AtPrime 𝔭)] (𝔮 : Ideal (Localization.AtPrime 𝔪)) [𝔮.IsPrime], 𝔮.comap (algebraMap S (Localization.AtPrime 𝔪)) = 𝔭 → IsLocalization.AtPrime (Localization.AtPrime 𝔭) 𝔮 := by
    intro S _ 𝔭 𝔪 _ _ h𝔭𝔪 _ _ 𝔮 _ h𝔮
    have hMN : 𝔪.primeCompl ≤ 𝔭.primeCompl := fun s hs h => hs (h𝔭𝔪 h)
    haveI h1 := IsLocalization.isLocalization_of_submonoid_le (Localization.AtPrime 𝔪)
      (Localization.AtPrime 𝔭) 𝔪.primeCompl 𝔭.primeCompl hMN
    refine IsLocalization.isLocalization_of_is_exists_mul_mem (Localization.AtPrime 𝔭)
      (M := Submonoid.map (algebraMap S (Localization.AtPrime 𝔪)) 𝔭.primeCompl)
      (N := 𝔮.primeCompl) ?_ ?_
    · rintro _ ⟨s, hs, rfl⟩ h
      apply hs
      rw [← h𝔮]
      exact h
    · rintro ⟨x, hx⟩
      obtain ⟨⟨a, t⟩, ht⟩ := IsLocalization.surj 𝔪.primeCompl x
      refine ⟨algebraMap S (Localization.AtPrime 𝔪) t, a, ?_, ?_⟩
      · intro ha
        have h2 : algebraMap S (Localization.AtPrime 𝔪) a ∈ 𝔮 := by
          rw [← h𝔮] at ha
          exact ha
        simp only at ht
        rw [← ht] at h2
        rcases (inferInstance : 𝔮.IsPrime).mem_or_mem h2 with h3 | h3
        · exact hx h3
        · have h4 : (t : S) ∈ 𝔭 := by
            rw [← h𝔮]
            exact h3
          exact t.2 (h𝔭𝔪 h4)
      · simp only at ht ⊢
        rw [mul_comm]
        exact ht.symm
  have s2 : ∀ (P : Type u) [CommRing P] (Ω : Type u) [CommRing Ω] [Algebra P Ω] [Module.Flat P Ω] (𝔭' : Ideal Ω) [𝔭'.IsPrime] (A' : Type u) [CommRing A'] [Algebra P A'] [IsLocalization.AtPrime A' (𝔭'.comap (algebraMap P Ω))] [Algebra A' (Localization.AtPrime 𝔭')] [IsScalarTower P A' (Localization.AtPrime 𝔭')], Module.Flat A' (Localization.AtPrime 𝔭') ∧ IsLocalHom (algebraMap A' (Localization.AtPrime 𝔭')) := by
    intro P _ Ω _ _ _ 𝔭' _ A' _ _ _ _ _
    let ℓ := Localization.localRingHom (𝔭'.comap (algebraMap P Ω)) 𝔭' (algebraMap P Ω) rfl
    have hℓflat : ℓ.Flat := RingHom.Flat.localRingHom
      (RingHom.flat_algebraMap_iff.mpr inferInstance) 𝔭' (𝔭'.comap (algebraMap P Ω)) rfl
    have hℓloc : IsLocalHom ℓ := Localization.isLocalHom_localRingHom _ _ _ _
    let e : A' ≃ₐ[P] Localization.AtPrime (𝔭'.comap (algebraMap P Ω)) :=
      IsLocalization.algEquiv (𝔭'.comap (algebraMap P Ω)).primeCompl A'
        (Localization.AtPrime (𝔭'.comap (algebraMap P Ω)))
    let eR : A' →+* Localization.AtPrime (𝔭'.comap (algebraMap P Ω)) := e.toRingEquiv.toRingHom
    have hc : algebraMap A' (Localization.AtPrime 𝔭') = ℓ.comp eR := by
      apply IsLocalization.ringHom_ext (𝔭'.comap (algebraMap P Ω)).primeCompl
      ext x
      simp only [RingHom.comp_apply]
      rw [← IsScalarTower.algebraMap_apply P A' (Localization.AtPrime 𝔭')]
      have he : eR (algebraMap P A' x) = algebraMap P (Localization.AtPrime (𝔭'.comap (algebraMap P Ω))) x :=
        e.commutes x
      rw [he, Localization.localRingHom_to_map, IsScalarTower.algebraMap_apply P Ω (Localization.AtPrime 𝔭')]
    have heloc : IsLocalHom eR := ⟨fun a ha => by
      have := ha.map (e.symm.toRingEquiv.toRingHom)
      simpa [eR] using this⟩
    constructor
    · rw [← RingHom.flat_algebraMap_iff, hc]
      exact RingHom.Flat.comp (RingHom.Flat.of_bijective e.bijective) hℓflat
    · rw [hc]
      exact RingHom.isLocalHom_comp ℓ eR
  have s4 : ∀ (S : Type u) [CommRing S] (𝔭 𝔪 : Ideal S) [𝔭.IsPrime] [𝔪.IsPrime], 𝔭 ≤ 𝔪 → ∀ (Ω : Type u) [CommRing Ω] [Algebra (Localization.AtPrime 𝔪) Ω] [Module.FaithfullyFlat (Localization.AtPrime 𝔪) Ω], ∃ 𝔭' : Ideal Ω, 𝔭'.IsPrime ∧ (𝔭'.comap (algebraMap (Localization.AtPrime 𝔪) Ω)).comap (algebraMap S (Localization.AtPrime 𝔪)) = 𝔭 := by
    intro S _ 𝔭 𝔪 _ _ h Ω _ _ _
    have hdisj : Disjoint (𝔪.primeCompl : Set S) 𝔭 := by
      rw [Set.disjoint_left]
      intro s hs hp
      exact hs (h hp)
    have hprime := IsLocalization.isPrime_of_isPrime_disjoint 𝔪.primeCompl (Localization.AtPrime 𝔪)
      𝔭 inferInstance hdisj
    have hcomap := IsLocalization.under_map_of_isPrime_disjoint 𝔪.primeCompl
      (Localization.AtPrime 𝔪) (inferInstance : 𝔭.IsPrime) hdisj
    rw [Ideal.under_def] at hcomap
    obtain ⟨q, hq⟩ := PrimeSpectrum.comap_surjective_of_faithfullyFlat
      (A := Localization.AtPrime 𝔪) (B := Ω) ⟨_, hprime⟩
    refine ⟨q.asIdeal, q.2, ?_⟩
    have h2 := congrArg PrimeSpectrum.asIdeal hq
    rw [PrimeSpectrum.comap_asIdeal] at h2
    rw [h2]
    exact hcomap
  have s3 : (∀ (A : Type u) [CommRing A] (C : Type u) [CommRing C] (D : Type u) [CommRing D] [Algebra A C] [Algebra A D] [Algebra C D] [IsScalarTower A C D] [IsNoetherianRing C] [IsNoetherianRing D], Module.FaithfullyFlat C D → (∀ (𝔭 : Ideal A) [𝔭.IsPrime] (L : Type u) [Field L] [Algebra A L] [Algebra 𝔭.ResidueField L] [IsScalarTower A 𝔭.ResidueField L] [FiniteDimensional 𝔭.ResidueField L] (𝔔 : Ideal (TensorProduct A L D)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) → ∀ (𝔭 : Ideal A) [𝔭.IsPrime] (L : Type u) [Field L] [Algebra A L] [Algebra 𝔭.ResidueField L] [IsScalarTower A 𝔭.ResidueField L] [FiniteDimensional 𝔭.ResidueField L] (𝔔 : Ideal (TensorProduct A L C)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) → (∀ (A : Type u) [CommRing A] (C : Type u) [CommRing C] (C' : Type u) [CommRing C'] [Algebra A C] [Algebra A C'], (C ≃ₐ[A] C') → (∀ (𝔭 : Ideal A) [𝔭.IsPrime] (L : Type u) [Field L] [Algebra A L] [Algebra 𝔭.ResidueField L] [IsScalarTower A 𝔭.ResidueField L] [FiniteDimensional 𝔭.ResidueField L] (𝔔 : Ideal (TensorProduct A L C)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) → ∀ (𝔭 : Ideal A) [𝔭.IsPrime] (L : Type u) [Field L] [Algebra A L] [Algebra 𝔭.ResidueField L] [IsScalarTower A 𝔭.ResidueField L] [FiniteDimensional 𝔭.ResidueField L] (𝔔 : Ideal (TensorProduct A L C')) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) → (∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A] (B : Type u) [CommRing B] [IsLocalRing B] [IsNoetherianRing B] [Algebra A B] [IsLocalHom (algebraMap A B)] [Module.Flat A B], ∃ φ : AdicCompletion (IsLocalRing.maximalIdeal A) A →+* AdicCompletion (IsLocalRing.maximalIdeal B) B, φ.comp (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A)) = (algebraMap B (AdicCompletion (IsLocalRing.maximalIdeal B) B)).comp (algebraMap A B) ∧ IsLocalHom φ ∧ φ.Flat) → ∀ (A' : Type u) [CommRing A'] [IsLocalRing A'] [IsNoetherianRing A'] (E : Type u) [CommRing E] [IsLocalRing E] [IsNoetherianRing E] [Algebra A' E] [IsLocalHom (algebraMap A' E)] [Module.Flat A' E], (∀ (𝔭 : Ideal A') [𝔭.IsPrime] (L : Type u) [Field L] [Algebra A' L] [Algebra 𝔭.ResidueField L] [IsScalarTower A' 𝔭.ResidueField L] [FiniteDimensional 𝔭.ResidueField L] (𝔔 : Ideal (TensorProduct A' L (AdicCompletion (IsLocalRing.maximalIdeal E) E))) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) → ∀ (Λ : Type u) [CommRing Λ] [Algebra A' Λ], Nonempty (AdicCompletion (IsLocalRing.maximalIdeal A') A' ≃ₐ[A'] Λ) → ∀ (𝔭 : Ideal A') [𝔭.IsPrime] (L : Type u) [Field L] [Algebra A' L] [Algebra 𝔭.ResidueField L] [IsScalarTower A' 𝔭.ResidueField L] [FiniteDimensional 𝔭.ResidueField L] (𝔔 : Ideal (TensorProduct A' L Λ)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔) := by
    intro hDESC hTRANS hCFLAT A' _ _ _ E _ _ _ _ _ _ hGRF Λ _ _ hΛ
    obtain ⟨e⟩ := hΛ
    haveI : IsNoetherianRing (AdicCompletion (IsLocalRing.maximalIdeal A') A') :=
      wc_hnas_completion_noetherian A'
    haveI : IsNoetherianRing (AdicCompletion (IsLocalRing.maximalIdeal E) E) :=
      wc_hnas_completion_noetherian E
    obtain ⟨φ, hsq, hloc, hflat⟩ := hCFLAT A' E
    letI : Algebra (AdicCompletion (IsLocalRing.maximalIdeal A') A')
        (AdicCompletion (IsLocalRing.maximalIdeal E) E) := φ.toAlgebra
    haveI : IsScalarTower A' (AdicCompletion (IsLocalRing.maximalIdeal A') A')
        (AdicCompletion (IsLocalRing.maximalIdeal E) E) := IsScalarTower.of_algebraMap_eq (fun x => by
      rw [RingHom.algebraMap_toAlgebra,
        IsScalarTower.algebraMap_apply A' E (AdicCompletion (IsLocalRing.maximalIdeal E) E)]
      exact (congrArg (fun f => f x) hsq).symm)
    haveI : Module.Flat (AdicCompletion (IsLocalRing.maximalIdeal A') A')
        (AdicCompletion (IsLocalRing.maximalIdeal E) E) := RingHom.flat_algebraMap_iff.mp hflat
    haveI : IsLocalHom (algebraMap (AdicCompletion (IsLocalRing.maximalIdeal A') A')
        (AdicCompletion (IsLocalRing.maximalIdeal E) E)) := hloc
    haveI : Module.FaithfullyFlat (AdicCompletion (IsLocalRing.maximalIdeal A') A')
        (AdicCompletion (IsLocalRing.maximalIdeal E) E) := Module.FaithfullyFlat.of_flat_of_isLocalHom
    have hC := hDESC A' (AdicCompletion (IsLocalRing.maximalIdeal A') A')
      (AdicCompletion (IsLocalRing.maximalIdeal E) E) inferInstance hGRF
    exact hTRANS A' _ Λ e hC
  intro hDESC hCOMP hTRANS hLOC hCFLAT hCL S _ _ hmax
  refine ⟨inferInstance, ?_⟩
  intro 𝔭 _ Λ _ _ hΛ
  obtain ⟨𝔪, h𝔪max, h𝔭𝔪⟩ := Ideal.exists_le_maximal 𝔭 (Ideal.IsPrime.ne_top ‹_›)
  haveI : 𝔪.IsMaximal := h𝔪max
  haveI hPnoeth : IsNoetherianRing (Localization.AtPrime 𝔪) :=
    IsLocalization.isNoetherianRing 𝔪.primeCompl _ inferInstance
  have hlc := wc_hnas_completion_local_complete (Localization.AtPrime 𝔪)
  have hcpl := hlc.choose_spec.1
  haveI hΩnoeth : IsNoetherianRing (AdicCompletion (IsLocalRing.maximalIdeal
      (Localization.AtPrime 𝔪)) (Localization.AtPrime 𝔪)) := wc_hnas_completion_noetherian _
  haveI : Module.Flat (Localization.AtPrime 𝔪) (AdicCompletion (IsLocalRing.maximalIdeal
      (Localization.AtPrime 𝔪)) (Localization.AtPrime 𝔪)) := AdicCompletion.flat_of_isNoetherian _
  haveI : IsLocalHom (algebraMap (Localization.AtPrime 𝔪) (AdicCompletion (IsLocalRing.maximalIdeal
      (Localization.AtPrime 𝔪)) (Localization.AtPrime 𝔪))) := hlc.choose_spec.2.1
  haveI : Module.FaithfullyFlat (Localization.AtPrime 𝔪) (AdicCompletion (IsLocalRing.maximalIdeal
      (Localization.AtPrime 𝔪)) (Localization.AtPrime 𝔪)) := Module.FaithfullyFlat.of_flat_of_isLocalHom
  obtain ⟨𝔭', h𝔭'prime, h𝔭'⟩ := s4 S 𝔭 𝔪 h𝔭𝔪 (AdicCompletion (IsLocalRing.maximalIdeal
      (Localization.AtPrime 𝔪)) (Localization.AtPrime 𝔪))
  haveI := h𝔭'prime
  have hMN : 𝔪.primeCompl ≤ 𝔭.primeCompl := fun s hs h => hs (h𝔭𝔪 h)
  letI : Algebra (Localization.AtPrime 𝔪) (Localization.AtPrime 𝔭) :=
    IsLocalization.localizationAlgebraOfSubmonoidLe (Localization.AtPrime 𝔪)
      (Localization.AtPrime 𝔭) 𝔪.primeCompl 𝔭.primeCompl hMN
  haveI : IsScalarTower S (Localization.AtPrime 𝔪) (Localization.AtPrime 𝔭) :=
    IsLocalization.localization_isScalarTower_of_submonoid_le (Localization.AtPrime 𝔪)
      (Localization.AtPrime 𝔭) _ _ hMN
  haveI hA'loc : IsLocalization.AtPrime (Localization.AtPrime 𝔭)
      (𝔭'.comap (algebraMap (Localization.AtPrime 𝔪) (AdicCompletion (IsLocalRing.maximalIdeal
      (Localization.AtPrime 𝔪)) (Localization.AtPrime 𝔪)))) := s1 S 𝔭 𝔪 h𝔭𝔪 _ h𝔭'
  have hunits : ∀ y : (𝔭'.comap (algebraMap (Localization.AtPrime 𝔪) (AdicCompletion
      (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔪)) (Localization.AtPrime 𝔪)))).primeCompl,
      IsUnit (algebraMap (Localization.AtPrime 𝔪) (Localization.AtPrime 𝔭') y) := by
    intro y
    rw [IsScalarTower.algebraMap_apply (Localization.AtPrime 𝔪) (AdicCompletion
      (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔪)) (Localization.AtPrime 𝔪))
      (Localization.AtPrime 𝔭')]
    exact IsLocalization.map_units (Localization.AtPrime 𝔭') (⟨_, y.2⟩ : 𝔭'.primeCompl)
  letI : Algebra (Localization.AtPrime 𝔭) (Localization.AtPrime 𝔭') :=
    (IsLocalization.lift (M := (𝔭'.comap (algebraMap (Localization.AtPrime 𝔪) (AdicCompletion
      (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔪)) (Localization.AtPrime 𝔪)))).primeCompl)
      (S := Localization.AtPrime 𝔭) hunits).toAlgebra
  haveI : IsScalarTower (Localization.AtPrime 𝔪) (Localization.AtPrime 𝔭) (Localization.AtPrime 𝔭') :=
    IsScalarTower.of_algebraMap_eq (fun x => (IsLocalization.lift_eq hunits x).symm)
  haveI hEnoeth : IsNoetherianRing (Localization.AtPrime 𝔭') :=
    IsLocalization.isNoetherianRing 𝔭'.primeCompl _ hΩnoeth
  haveI hA'noeth : IsNoetherianRing (Localization.AtPrime 𝔭) :=
    IsLocalization.isNoetherianRing 𝔭.primeCompl _ inferInstance
  haveI hÊnoeth : IsNoetherianRing (AdicCompletion (IsLocalRing.maximalIdeal
      (Localization.AtPrime 𝔭')) (Localization.AtPrime 𝔭')) := wc_hnas_completion_noetherian _
  have h1 := hLOC (Localization.AtPrime 𝔪) (AdicCompletion (IsLocalRing.maximalIdeal
      (Localization.AtPrime 𝔪)) (Localization.AtPrime 𝔪)) 𝔭' (Localization.AtPrime 𝔭)
    (hmax 𝔪 _ ⟨AlgEquiv.refl⟩)
  have h2 := (hCL _ hcpl).2 𝔭' (AdicCompletion (IsLocalRing.maximalIdeal
      (Localization.AtPrime 𝔭')) (Localization.AtPrime 𝔭')) ⟨AlgEquiv.refl⟩
  have h3 := hCOMP (Localization.AtPrime 𝔭) (Localization.AtPrime 𝔭') (AdicCompletion
    (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔭')) (Localization.AtPrime 𝔭'))
    (AdicCompletion.flat_of_isNoetherian _) h1 h2
  obtain ⟨hfl, hlh⟩ := s2 (Localization.AtPrime 𝔪) (AdicCompletion (IsLocalRing.maximalIdeal
      (Localization.AtPrime 𝔪)) (Localization.AtPrime 𝔪)) 𝔭' (Localization.AtPrime 𝔭)
  exact s3 hDESC hTRANS hCFLAT (Localization.AtPrime 𝔭) (Localization.AtPrime 𝔭') h3 Λ hΛ

theorem wc_hnas_pfc_poly_base_change_fibres : ∀ (B : Type u) [CommRing B] (𝔮 : Ideal (Polynomial B)) [𝔮.IsPrime] (Ω : Type u) [CommRing Ω] [Algebra (Localization.AtPrime (𝔮.comap Polynomial.C)) Ω], (∀ (𝔭 : Ideal (Localization.AtPrime (𝔮.comap Polynomial.C))) [𝔭.IsPrime] (L : Type u) [Field L] [Algebra (Localization.AtPrime (𝔮.comap Polynomial.C)) L] [Algebra 𝔭.ResidueField L] [IsScalarTower (Localization.AtPrime (𝔮.comap Polynomial.C)) 𝔭.ResidueField L], (∃ s : Finset L, IntermediateField.adjoin 𝔭.ResidueField (s : Set L) = ⊤) → ∀ (𝔔 : Ideal (TensorProduct (Localization.AtPrime (𝔮.comap Polynomial.C)) L Ω)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) → ∀ (𝔮' : Ideal (Polynomial Ω)) [𝔮'.IsPrime] (h : 𝔮 = 𝔮'.comap (Polynomial.mapRingHom ((algebraMap (Localization.AtPrime (𝔮.comap Polynomial.C)) Ω).comp (algebraMap B (Localization.AtPrime (𝔮.comap Polynomial.C)))))) [Algebra (Localization.AtPrime 𝔮) (Localization.AtPrime 𝔮')], algebraMap (Localization.AtPrime 𝔮) (Localization.AtPrime 𝔮') = Localization.localRingHom 𝔮 𝔮' (Polynomial.mapRingHom ((algebraMap (Localization.AtPrime (𝔮.comap Polynomial.C)) Ω).comp (algebraMap B (Localization.AtPrime (𝔮.comap Polynomial.C))))) h → ∀ (𝔭 : Ideal (Localization.AtPrime 𝔮)) [𝔭.IsPrime] (L : Type u) [Field L] [Algebra (Localization.AtPrime 𝔮) L] [Algebra 𝔭.ResidueField L] [IsScalarTower (Localization.AtPrime 𝔮) 𝔭.ResidueField L] [FiniteDimensional 𝔭.ResidueField L] (𝔔 : Ideal (TensorProduct (Localization.AtPrime 𝔮) L (Localization.AtPrime 𝔮'))) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔) :=
by

  have t_s2 : PLift (∀ (A : Type u) [CommRing A] (A' : Type u) [CommRing A'] [Algebra A A'] (S : Submonoid A) [IsLocalization S A'] (L : Type u) [CommRing L] [Algebra A' L] [Algebra A L] [IsScalarTower A A' L] (X : Type u) [CommRing X] [Algebra A' X] [Algebra A X] [IsScalarTower A A' X], Nonempty (TensorProduct A' L X ≃+* TensorProduct A L X)) := by
    refine ⟨?_⟩
    intro A _ A' _ _ S _ L _ _ _ _ X _ _ _ _
    haveI := IsLocalization.tensorProduct_compatibleSMul S A' L X
    let Θ := TensorProduct.equivOfCompatibleSMul A A' A' L X
    have hΘ : ∀ (l : L) (x : X), Θ (TensorProduct.tmul A' l x) = TensorProduct.tmul A l x :=
      fun l x => rfl
    have hmul : ∀ x y : TensorProduct A' L X, Θ (x * y) = Θ x * Θ y := by
      intro x y
      induction x using TensorProduct.induction_on with
      | zero => simp
      | tmul l x =>
        induction y using TensorProduct.induction_on with
        | zero => simp
        | tmul l' x' =>
          rw [Algebra.TensorProduct.tmul_mul_tmul, hΘ, hΘ, hΘ, Algebra.TensorProduct.tmul_mul_tmul]
        | add y z hy hz => rw [mul_add, map_add, hy, hz, map_add, mul_add]
      | add x z hx hz => rw [add_mul, map_add, hx, hz, map_add, add_mul]
    exact ⟨{ Θ.toEquiv with map_mul' := hmul, map_add' := Θ.map_add }⟩

  have t_s3 : PLift (∀ (A : Type u) [CommRing A] (C : Type u) [CommRing C] [Algebra A C] (L : Type u) [CommRing L] [Algebra A L] (S : Submonoid C), Nonempty (TensorProduct A L (Localization S) ≃+* Localization (Submonoid.map (Algebra.TensorProduct.includeRight : C →ₐ[A] TensorProduct A L C) S))) := by
    refine ⟨?_⟩
    intro A _ C _ _ L _ _ S
    set M := Submonoid.map (Algebra.TensorProduct.includeRight : C →ₐ[A] TensorProduct A L C) S
      with hM
    let j : C →ₐ[A] Localization S := IsScalarTower.toAlgHom A C (Localization S)
    let φ : TensorProduct A L C →ₐ[A] TensorProduct A L (Localization S) :=
      Algebra.TensorProduct.map (AlgHom.id A L) j
    have hφt : ∀ (l : L) (c : C), φ (TensorProduct.tmul A l c) =
        TensorProduct.tmul A l (algebraMap C (Localization S) c) := fun l c => rfl
    have hφ : ∀ y : M, IsUnit ((φ : TensorProduct A L C →+* TensorProduct A L (Localization S))
        (y : TensorProduct A L C)) := by
      rintro ⟨_, s, hs, rfl⟩
      refine IsUnit.of_mul_eq_one
        (TensorProduct.tmul A (1 : L) (IsLocalization.mk' (Localization S) (1 : C) ⟨s, hs⟩)) ?_
      change φ (TensorProduct.tmul A (1 : L) s) * _ = 1
      rw [hφt, Algebra.TensorProduct.tmul_mul_tmul, mul_one,
        (IsLocalization.mk'_spec' (Localization S) (1 : C) ⟨s, hs⟩).trans (map_one _)]
      rfl
    let Φ : Localization M →+* TensorProduct A L (Localization S) :=
      IsLocalization.lift (M := M) (S := Localization M) hφ
    have hΦκ : ∀ t, Φ (algebraMap _ (Localization M) t) = φ t := fun t => IsLocalization.lift_eq _ _
    let κ : TensorProduct A L C →+* Localization M := algebraMap _ (Localization M)
    have hγ : ∀ s : S, IsUnit ((κ.comp (Algebra.TensorProduct.includeRight :
        C →ₐ[A] TensorProduct A L C).toRingHom) (s : C)) := by
      intro s
      exact IsLocalization.map_units (Localization M) (⟨_, s, s.2, rfl⟩ : M)
    let γ' : Localization S →+* Localization M := IsLocalization.lift hγ
    have hγ'c : ∀ c : C, γ' (algebraMap C _ c) = κ (TensorProduct.tmul A (1 : L) c) :=
      fun c => IsLocalization.lift_eq _ _
    have hγ'A : ∀ a : A, γ' (algebraMap A (Localization S) a) = algebraMap A (Localization M) a := by
      intro a
      rw [IsScalarTower.algebraMap_apply A C (Localization S), hγ'c,
        IsScalarTower.algebraMap_apply A (TensorProduct A L C) (Localization M)]
      congr 1
      exact (Algebra.TensorProduct.includeRight : C →ₐ[A] TensorProduct A L C).commutes a
    let γA : Localization S →ₐ[A] Localization M := { γ' with commutes' := hγ'A }
    let lA : L →ₐ[A] Localization M :=
      (IsScalarTower.toAlgHom A (TensorProduct A L C) (Localization M)).comp
        Algebra.TensorProduct.includeLeft
    let Ψ : TensorProduct A L (Localization S) →ₐ[A] Localization M :=
      Algebra.TensorProduct.lift lA γA (fun _ _ => Commute.all _ _)
    have hΨt : ∀ (l : L) (y : Localization S), Ψ (TensorProduct.tmul A l y) =
        κ (TensorProduct.tmul A l (1 : C)) * γ' y := fun l y => rfl
    have hΨφ : ∀ t : TensorProduct A L C, Ψ (φ t) = κ t := by
      intro t
      induction t using TensorProduct.induction_on with
      | zero => simp
      | tmul l c =>
        rw [hφt, hΨt, hγ'c, ← map_mul, Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
      | add x y hx hy => rw [map_add, map_add, hx, hy, map_add]
    have h1 : (Ψ : TensorProduct A L (Localization S) →+* Localization M).comp Φ =
        RingHom.id _ := by
      apply IsLocalization.ringHom_ext M
      refine RingHom.ext fun t => ?_
      simp only [RingHom.comp_apply, RingHom.id_apply]
      rw [hΦκ]
      exact hΨφ t
    have hΦγ : Φ.comp γ' =
        (Algebra.TensorProduct.includeRight : Localization S →ₐ[A] TensorProduct A L (Localization S)).toRingHom := by
      apply IsLocalization.ringHom_ext S
      refine RingHom.ext fun c => ?_
      simp only [RingHom.comp_apply]
      rw [hγ'c, hΦκ, hφt]
      rfl
    have h2 : ∀ u : TensorProduct A L (Localization S), Φ (Ψ u) = u := by
      intro u
      induction u using TensorProduct.induction_on with
      | zero => simp
      | tmul l y =>
        rw [hΨt, map_mul, hΦκ, hφt, map_one]
        have : Φ (γ' y) = TensorProduct.tmul A (1 : L) y := by
          rw [← RingHom.comp_apply, hΦγ]
          rfl
        rw [this, Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
      | add x y hx hy => rw [map_add, map_add, hx, hy]
    exact ⟨RingEquiv.ofRingHom (Ψ : TensorProduct A L (Localization S) →+* Localization M) Φ h1
      (RingHom.ext h2)⟩

  have t_s4 : ∀ (T : Type u) [CommRing T] (M : Submonoid T) (U : Type u) [CommRing U] (_e : Localization M ≃+* U) (𝔔 : Ideal U) [𝔔.IsPrime], ∃ (𝔔₀ : Ideal T) (_ : 𝔔₀.IsPrime), Nonempty (Localization.AtPrime 𝔔₀ ≃+* Localization.AtPrime 𝔔) := by
    intro T _ M U _ e 𝔔 _
    let 𝔔₁ : Ideal (Localization M) := 𝔔.comap (e : Localization M →+* U)
    haveI : 𝔔₁.IsPrime := Ideal.comap_isPrime _ _
    have H : 𝔔₁.primeCompl.map e.toMonoidHom = 𝔔.primeCompl := by
      ext x
      constructor
      · rintro ⟨y, hy, rfl⟩
        exact hy
      · intro hx
        refine ⟨e.symm x, ?_, ?_⟩
        · change e (e.symm x) ∉ 𝔔
          simpa using hx
        · simp
    refine ⟨𝔔₁.comap (algebraMap T (Localization M)), Ideal.comap_isPrime _ _, ⟨?_⟩⟩
    exact (IsLocalization.localizationLocalizationAtPrimeIsoLocalization M 𝔔₁).toRingEquiv.trans
      (IsLocalization.ringEquivOfRingEquiv (Localization.AtPrime 𝔔₁) (Localization.AtPrime 𝔔) e H)

  have t_c3 : ∀ (T : Type u) [CommRing T] (T' : Type u) [CommRing T'] (_θ : T' ≃+* T) (M : Submonoid T) (U : Type u) [CommRing U] (_e : Localization M ≃+* U) (𝔔 : Ideal U) [𝔔.IsPrime], ∃ (𝔔₀ : Ideal T') (_ : 𝔔₀.IsPrime), Nonempty (Localization.AtPrime 𝔔₀ ≃+* Localization.AtPrime 𝔔) := by
    intro T _ T' _ θ M U _ e 𝔔 _
    obtain ⟨𝔔₂, h𝔔₂, ⟨ι⟩⟩ := t_s4 T M U e 𝔔
    let 𝔔₀ : Ideal T' := 𝔔₂.comap (θ : T' →+* T)
    haveI : 𝔔₀.IsPrime := Ideal.comap_isPrime _ _
    have H : 𝔔₀.primeCompl.map θ.toMonoidHom = 𝔔₂.primeCompl := by
      ext x
      constructor
      · rintro ⟨y, hy, rfl⟩
        exact hy
      · intro hx
        refine ⟨θ.symm x, ?_, ?_⟩
        · change θ (θ.symm x) ∉ 𝔔₂
          simpa using hx
        · simp
    exact ⟨𝔔₀, inferInstance, ⟨(IsLocalization.ringEquivOfRingEquiv (Localization.AtPrime 𝔔₀)
      (Localization.AtPrime 𝔔₂) θ H).trans ι⟩⟩

  have t_c4 : PLift (∀ (R : Type u) [CommRing R] (S : Type u) [CommRing S] [Algebra R S] [Algebra (Polynomial R) (Polynomial S)], algebraMap (Polynomial R) (Polynomial S) = Polynomial.mapRingHom (algebraMap R S) → ∀ (L : Type u) [CommRing L] [Algebra (Polynomial R) L] [Algebra R L] [IsScalarTower R (Polynomial R) L], Nonempty (TensorProduct (Polynomial R) L (Polynomial S) ≃+* TensorProduct R L S)) := by
    refine ⟨?_⟩
    intro R _ S _ _ _ hRS L _ _ _ _
    have hCa : ∀ a : R, algebraMap (Polynomial R) L (Polynomial.C a) = algebraMap R L a := by
      intro a
      rw [IsScalarTower.algebraMap_apply R (Polynomial R) L, Polynomial.algebraMap_eq]
    have hCS : ∀ a : R, Polynomial.C (algebraMap R S a) =
        algebraMap (Polynomial R) (Polynomial S) (Polynomial.C a) := by
      intro a
      rw [hRS, Polynomial.coe_mapRingHom, Polynomial.map_C]
    have hXS : algebraMap (Polynomial R) (Polynomial S) Polynomial.X = Polynomial.X := by
      rw [hRS, Polynomial.coe_mapRingHom, Polynomial.map_X]
    let j : Polynomial S →+* TensorProduct R L S :=
      Polynomial.eval₂RingHom (Algebra.TensorProduct.includeRight : S →ₐ[R] TensorProduct R L S).toRingHom
        (TensorProduct.tmul R (algebraMap (Polynomial R) L Polynomial.X) (1 : S))
    have hjC : ∀ s : S, j (Polynomial.C s) = TensorProduct.tmul R (1 : L) s := fun s =>
      Polynomial.eval₂_C _ _
    have hjX : j Polynomial.X =
        TensorProduct.tmul R (algebraMap (Polynomial R) L Polynomial.X) (1 : S) :=
      Polynomial.eval₂_X _ _
    have hjcomp : j.comp (algebraMap (Polynomial R) (Polynomial S)) =
        algebraMap (Polynomial R) (TensorProduct R L S) := by
      apply Polynomial.ringHom_ext
      · intro a
        rw [RingHom.comp_apply, ← hCS, hjC, Algebra.TensorProduct.algebraMap_apply, hCa,
          Algebra.algebraMap_eq_smul_one, Algebra.algebraMap_eq_smul_one, TensorProduct.smul_tmul]
      · rw [RingHom.comp_apply, hXS, hjX, Algebra.TensorProduct.algebraMap_apply]
    have hjcomm : ∀ p : Polynomial R, j (algebraMap (Polynomial R) (Polynomial S) p) =
        algebraMap (Polynomial R) (TensorProduct R L S) p := fun p => by
      rw [← RingHom.comp_apply, hjcomp]
    let jA : Polynomial S →ₐ[Polynomial R] TensorProduct R L S := { j with commutes' := hjcomm }
    let Φ : TensorProduct (Polynomial R) L (Polynomial S) →ₐ[Polynomial R] TensorProduct R L S :=
      Algebra.TensorProduct.lift
        (Algebra.TensorProduct.includeLeft : L →ₐ[Polynomial R] TensorProduct R L S) jA
        (fun _ _ => Commute.all _ _)
    have hΦ : ∀ (l : L) (g : Polynomial S), Φ (TensorProduct.tmul (Polynomial R) l g) =
        TensorProduct.tmul R l (1 : S) * j g := fun l g => rfl
    let fA : L →ₐ[R] TensorProduct (Polynomial R) L (Polynomial S) :=
      { (Algebra.TensorProduct.includeLeftRingHom :
          L →+* TensorProduct (Polynomial R) L (Polynomial S)) with
        commutes' := fun a => by
          show TensorProduct.tmul (Polynomial R) (algebraMap R L a) (1 : Polynomial S) =
            algebraMap R (TensorProduct (Polynomial R) L (Polynomial S)) a
          rw [Algebra.TensorProduct.algebraMap_apply] }
    let gA : S →ₐ[R] TensorProduct (Polynomial R) L (Polynomial S) :=
      { ((Algebra.TensorProduct.includeRight : Polynomial S →ₐ[Polynomial R]
          TensorProduct (Polynomial R) L (Polynomial S)).toRingHom.comp Polynomial.C) with
        commutes' := fun a => by
          show TensorProduct.tmul (Polynomial R) (1 : L) (Polynomial.C (algebraMap R S a)) =
            algebraMap R (TensorProduct (Polynomial R) L (Polynomial S)) a
          rw [Algebra.TensorProduct.algebraMap_apply, ← hCa, hCS,
            Algebra.algebraMap_eq_smul_one (A := Polynomial S),
            Algebra.algebraMap_eq_smul_one (A := L), TensorProduct.smul_tmul] }
    let Ψ : TensorProduct R L S →ₐ[R] TensorProduct (Polynomial R) L (Polynomial S) :=
      Algebra.TensorProduct.lift fA gA (fun _ _ => Commute.all _ _)
    have hΨ : ∀ (l : L) (s : S), Ψ (TensorProduct.tmul R l s) =
        TensorProduct.tmul (Polynomial R) l (1 : Polynomial S) *
          TensorProduct.tmul (Polynomial R) (1 : L) (Polynomial.C s) := fun l s => rfl
    have hΨj : (Ψ : TensorProduct R L S →+* TensorProduct (Polynomial R) L (Polynomial S)).comp j =
        (Algebra.TensorProduct.includeRight : Polynomial S →ₐ[Polynomial R]
          TensorProduct (Polynomial R) L (Polynomial S)).toRingHom := by
      apply Polynomial.ringHom_ext
      · intro s
        rw [RingHom.comp_apply, hjC]
        show Ψ (TensorProduct.tmul R (1 : L) s) =
          TensorProduct.tmul (Polynomial R) (1 : L) (Polynomial.C s)
        rw [hΨ, Algebra.TensorProduct.tmul_mul_tmul, one_mul, one_mul]
      · rw [RingHom.comp_apply, hjX]
        show Ψ (TensorProduct.tmul R (algebraMap (Polynomial R) L Polynomial.X) (1 : S)) =
          TensorProduct.tmul (Polynomial R) (1 : L) Polynomial.X
        rw [hΨ]
        simp only [Algebra.TensorProduct.tmul_mul_tmul, mul_one, map_one]
        have e1 : TensorProduct.tmul (Polynomial R) (algebraMap (Polynomial R) L Polynomial.X)
            (1 : Polynomial S) = TensorProduct.tmul (Polynomial R) (1 : L)
              (algebraMap (Polynomial R) (Polynomial S) Polynomial.X) := by
          rw [Algebra.algebraMap_eq_smul_one, Algebra.algebraMap_eq_smul_one, TensorProduct.smul_tmul]
        rw [e1, hXS]
    have hΨj' : ∀ g : Polynomial S, Ψ (j g) = TensorProduct.tmul (Polynomial R) (1 : L) g :=
      fun g => RingHom.congr_fun hΨj g
    have h1 : ∀ y : TensorProduct R L S, Φ (Ψ y) = y := by
      intro y
      induction y using TensorProduct.induction_on with
      | zero => simp
      | tmul l s =>
        rw [hΨ, map_mul, hΦ, hΦ, hjC]
        simp only [map_one, mul_one, one_mul, Algebra.TensorProduct.tmul_mul_tmul]
      | add x z hx hz => rw [map_add, map_add, hx, hz]
    have h2 : ∀ x : TensorProduct (Polynomial R) L (Polynomial S), Ψ (Φ x) = x := by
      intro x
      induction x using TensorProduct.induction_on with
      | zero => simp
      | tmul l g =>
        rw [hΦ, map_mul, hΨj', hΨ]
        simp only [map_one, mul_one, one_mul, Algebra.TensorProduct.tmul_mul_tmul]
      | add x z hx hz => rw [map_add, map_add, hx, hz]
    exact ⟨RingEquiv.ofRingHom
      (Φ : TensorProduct (Polynomial R) L (Polynomial S) →+* TensorProduct R L S)
      (Ψ : TensorProduct R L S →+* TensorProduct (Polynomial R) L (Polynomial S))
      (RingHom.ext fun y => h1 y) (RingHom.ext fun x => h2 x)⟩

  have t_c5 : ∀ (R : Type u) [CommRing R] (A : Type u) [CommRing A] [Algebra (Polynomial R) A] (M : Submonoid (Polynomial R)) [IsLocalization M A] (𝔭 : Ideal A) [𝔭.IsPrime] (L : Type u) [Field L] [Algebra A L] [Algebra 𝔭.ResidueField L] [IsScalarTower A 𝔭.ResidueField L] [FiniteDimensional 𝔭.ResidueField L] (K₀ : Type u) [Field K₀] [Algebra K₀ L] (f₀ : R →+* K₀), (∀ r : R, algebraMap K₀ L (f₀ r) = algebraMap A L (algebraMap (Polynomial R) A (Polynomial.C r))) → ∃ s : Finset L, IntermediateField.adjoin K₀ (s : Set L) = ⊤ := by
    classical
    intro R _ A _ _ M _ 𝔭 _ L _ _ _ _ _ K₀ _ _ f₀ hf₀
    obtain ⟨n, b, hb⟩ := Module.Finite.exists_fin (R := 𝔭.ResidueField) (M := L)
    refine ⟨insert (algebraMap A L (algebraMap (Polynomial R) A Polynomial.X))
      (Finset.univ.image b), ?_⟩
    set F := IntermediateField.adjoin K₀ ((insert (algebraMap A L (algebraMap (Polynomial R) A
      Polynomial.X)) (Finset.univ.image b) : Finset L) : Set L) with hF
    have hxb : algebraMap A L (algebraMap (Polynomial R) A Polynomial.X) ∈ F :=
      IntermediateField.subset_adjoin K₀ _ (by simp)
    have hbF : ∀ i, b i ∈ F := fun i => IntermediateField.subset_adjoin K₀ _ (by simp)
    have h1 : ∀ g : Polynomial R, algebraMap A L (algebraMap (Polynomial R) A g) ∈ F := by
      intro g
      refine Polynomial.induction_on g (fun r => ?_) (fun p q hp hq => ?_) (fun k r ih => ?_)
      · rw [← hf₀ r]
        exact IntermediateField.algebraMap_mem F _
      · rw [map_add, map_add]
        exact add_mem hp hq
      · rw [pow_succ, ← mul_assoc, map_mul, map_mul]
        exact mul_mem ih hxb
    have h2 : ∀ a : A, algebraMap A L a ∈ F := by
      intro a
      obtain ⟨⟨g, m⟩, rfl⟩ := IsLocalization.mk'_surjective M a
      have hm : algebraMap A L (algebraMap (Polynomial R) A m) ≠ 0 :=
        ((IsLocalization.map_units A m).map (algebraMap A L)).ne_zero
      have e : algebraMap A L (IsLocalization.mk' A g m) =
          algebraMap A L (algebraMap (Polynomial R) A g) /
            algebraMap A L (algebraMap (Polynomial R) A m) := by
        rw [eq_div_iff hm, ← map_mul, IsLocalization.mk'_spec]
      rw [e]
      exact div_mem (h1 g) (h1 m)
    have h3 : ∀ z : 𝔭.ResidueField, algebraMap 𝔭.ResidueField L z ∈ F := by
      intro z
      obtain ⟨x, y, _, rfl⟩ := IsFractionRing.div_surjective (A := A ⧸ 𝔭) z
      obtain ⟨a₁, rfl⟩ := Ideal.Quotient.mk_surjective x
      obtain ⟨a₂, rfl⟩ := Ideal.Quotient.mk_surjective y
      have e : ∀ a : A, algebraMap 𝔭.ResidueField L
          (algebraMap (A ⧸ 𝔭) 𝔭.ResidueField (Ideal.Quotient.mk 𝔭 a)) = algebraMap A L a := by
        intro a
        rw [IsScalarTower.algebraMap_apply A 𝔭.ResidueField L,
          IsScalarTower.algebraMap_apply A (A ⧸ 𝔭) 𝔭.ResidueField]
        rfl
      rw [map_div₀, e, e]
      exact div_mem (h2 a₁) (h2 a₂)
    rw [eq_top_iff]
    intro l _
    have hl : l ∈ Submodule.span 𝔭.ResidueField (Set.range b) := by rw [hb]; trivial
    obtain ⟨c, rfl⟩ := (Submodule.mem_span_range_iff_exists_fun 𝔭.ResidueField).mp hl
    refine sum_mem (fun i _ => ?_)
    rw [Algebra.smul_def]
    exact mul_mem (h3 (c i)) (hbF i)

  intro B _ 𝔮 _ Ω _ _ H₀ 𝔮' _ h _ hA 𝔭 _ L _ _ _ _ _ 𝔔 _
  obtain H : PLift (∀ (𝔭 : Ideal (Localization.AtPrime (𝔮.comap Polynomial.C))) [𝔭.IsPrime] (L : Type u) [Field L] [Algebra (Localization.AtPrime (𝔮.comap Polynomial.C)) L] [Algebra 𝔭.ResidueField L] [IsScalarTower (Localization.AtPrime (𝔮.comap Polynomial.C)) 𝔭.ResidueField L], (∃ s : Finset L, IntermediateField.adjoin 𝔭.ResidueField (s : Set L) = ⊤) → ∀ (𝔔 : Ideal (TensorProduct (Localization.AtPrime (𝔮.comap Polynomial.C)) L Ω)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) := ⟨H₀⟩
  clear H₀
  letI iBΩ : Algebra B Ω := ((algebraMap (Localization.AtPrime (𝔮.comap Polynomial.C)) Ω).comp
    (algebraMap B (Localization.AtPrime (𝔮.comap Polynomial.C)))).toAlgebra
  haveI tBPΩ : IsScalarTower B (Localization.AtPrime (𝔮.comap Polynomial.C)) Ω :=
    IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  letI iRΩ : Algebra (Polynomial B) (Polynomial Ω) :=
    (Polynomial.mapRingHom (algebraMap B Ω)).toAlgebra
  letI iRL : Algebra (Polynomial B) L :=
    ((algebraMap (Localization.AtPrime 𝔮) L).comp
      (algebraMap (Polynomial B) (Localization.AtPrime 𝔮))).toAlgebra
  haveI tRAL : IsScalarTower (Polynomial B) (Localization.AtPrime 𝔮) L :=
    IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  letI iBL : Algebra B L := ((algebraMap (Polynomial B) L).comp Polynomial.C).toAlgebra
  haveI tBRL : IsScalarTower B (Polynomial B) L := IsScalarTower.of_algebraMap_eq (fun b => by
    rw [Polynomial.algebraMap_eq]
    try rfl)
  obtain ⟨ι, hι⟩ : ∃ ι : Localization.AtPrime (𝔮.comap Polynomial.C) →+* Localization.AtPrime 𝔮,
      ∀ b : B, ι (algebraMap B _ b) =
        algebraMap (Polynomial B) (Localization.AtPrime 𝔮) (Polynomial.C b) :=
    ⟨Localization.localRingHom (𝔮.comap Polynomial.C) 𝔮 Polynomial.C rfl,
      fun b => Localization.localRingHom_to_map _ _ _ _ b⟩
  letI iPL : Algebra (Localization.AtPrime (𝔮.comap Polynomial.C)) L :=
    ((algebraMap (Localization.AtPrime 𝔮) L).comp ι).toAlgebra
  haveI tBPL : IsScalarTower B (Localization.AtPrime (𝔮.comap Polynomial.C)) L :=
    IsScalarTower.of_algebraMap_eq (fun b => by
      show algebraMap (Polynomial B) L (Polynomial.C b) =
        algebraMap (Localization.AtPrime 𝔮) L (ι (algebraMap B _ b))
      rw [hι]
      try rfl)
  haveI tRAE : IsScalarTower (Polynomial B) (Localization.AtPrime 𝔮) (Localization.AtPrime 𝔮') :=
    IsScalarTower.of_algebraMap_eq (fun r => by
      rw [hA, Localization.localRingHom_to_map,
        IsScalarTower.algebraMap_apply (Polynomial B) (Polynomial Ω) (Localization.AtPrime 𝔮')]
      try rfl)
  obtain ⟨e₁⟩ := t_s2.down (Polynomial B) (Localization.AtPrime 𝔮) 𝔮.primeCompl L
    (Localization.AtPrime 𝔮')
  obtain ⟨e₂⟩ := t_s3.down (Polynomial B) (Polynomial Ω) L 𝔮'.primeCompl
  obtain ⟨θ₁⟩ := t_c4.down B Ω rfl L
  obtain ⟨θ₂⟩ := t_s2.down B (Localization.AtPrime (𝔮.comap Polynomial.C))
    (𝔮.comap Polynomial.C).primeCompl L Ω
  let e : Localization (Submonoid.map (Algebra.TensorProduct.includeRight :
      Polynomial Ω →ₐ[Polynomial B] TensorProduct (Polynomial B) L (Polynomial Ω)) 𝔮'.primeCompl) ≃+*
      TensorProduct (Localization.AtPrime 𝔮) L (Localization.AtPrime 𝔮') := (e₁.trans e₂).symm
  obtain ⟨𝔔₀, h𝔔₀, ⟨ι₀⟩⟩ := t_c3 _ _ (θ₂.trans θ₁.symm) _ _ e 𝔔
  let 𝔭' : Ideal (Localization.AtPrime (𝔮.comap Polynomial.C)) := 𝔭.comap ι
  haveI : 𝔭'.IsPrime := Ideal.comap_isPrime _ _
  let ρ := Ideal.ResidueField.map 𝔭' 𝔭 ι rfl
  letI iKL : Algebra 𝔭'.ResidueField L := ((algebraMap 𝔭.ResidueField L).comp ρ).toAlgebra
  haveI tPKL : IsScalarTower (Localization.AtPrime (𝔮.comap Polynomial.C)) 𝔭'.ResidueField L :=
    IsScalarTower.of_algebraMap_eq (fun x => by
      change algebraMap (Localization.AtPrime 𝔮) L (ι x) =
        algebraMap 𝔭.ResidueField L (ρ (algebraMap _ 𝔭'.ResidueField x))
      rw [Ideal.ResidueField.map_algebraMap,
        ← IsScalarTower.algebraMap_apply (Localization.AtPrime 𝔮) 𝔭.ResidueField L])
  have hfg := t_c5 B (Localization.AtPrime 𝔮) 𝔮.primeCompl 𝔭 L 𝔭'.ResidueField
    ((algebraMap (Localization.AtPrime (𝔮.comap Polynomial.C)) 𝔭'.ResidueField).comp
      (algebraMap B (Localization.AtPrime (𝔮.comap Polynomial.C)))) (fun r => by
      rw [RingHom.comp_apply, ← IsScalarTower.algebraMap_apply
        (Localization.AtPrime (𝔮.comap Polynomial.C)) 𝔭'.ResidueField L]
      change algebraMap (Localization.AtPrime 𝔮) L (ι (algebraMap B _ r)) = _
      rw [hι])
  have hreg := H.down 𝔭' L hfg 𝔔₀
  exact IsRegularLocalRing.of_ringEquiv ι₀

