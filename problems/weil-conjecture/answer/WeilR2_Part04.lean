      map_smul' := fun m x => by
        rw [Algebra.smul_def, eq_intCast, ← zsmul_eq_mul, RingHom.id_apply]
        exact map_zsmul D' m x
      map_one_eq_zero' := by
        letI : Algebra ℤ (FractionRing B) := Ring.toIntAlgebra _
        exact D'.map_one_eq_zero
      leibniz' := by
        letI : Algebra ℤ (FractionRing B) := Ring.toIntAlgebra _
        exact D'.leibniz } ?_ f
    (by change D' _ ≠ 0; rw [hD'f]; exact one_ne_zero)
  intro r hr
  obtain ⟨G, hG, rfl⟩ := Subring.mem_map.mp hr
  change D' _ = 0
  apply hD'E
  rw [← hφ]
  refine Subfield.subset_closure (Or.inr ?_)
  show φ G ∈ F J0
  rw [hF]
  exact Subfield.subset_closure ⟨G, hG, rfl⟩

theorem wc_pfc_pc_char_zero_generic : (∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A] (B : Type u) [CommRing B] [IsLocalRing B] [IsNoetherianRing B] [Algebra A B] [IsLocalHom (algebraMap A B)] [Module.Flat A B], IsRegularLocalRing A → IsRegularLocalRing (B ⧸ Ideal.map (algebraMap A B) (IsLocalRing.maximalIdeal A)) → IsRegularLocalRing B) → (∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A], IsRegularLocalRing A → ∀ (𝔭 : Ideal A) [𝔭.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔭)) → (∀ (C₀ : Type u) [CommRing C₀] [IsLocalRing C₀] [IsNoetherianRing C₀], IsRegularLocalRing C₀ → ∀ (𝔮 : Ideal (Polynomial C₀)) [𝔮.IsPrime], 𝔮.comap Polynomial.C = IsLocalRing.maximalIdeal C₀ → IsRegularLocalRing (Localization.AtPrime 𝔮)) → (∀ (P : Type u) [CommRing P] [IsLocalRing P] [IsNoetherianRing P], IsRegularLocalRing P → ∀ (Λ : Type u) [CommRing Λ] [Algebra P Λ], Nonempty (AdicCompletion (IsLocalRing.maximalIdeal P) P ≃ₐ[P] Λ) → IsRegularLocalRing Λ) → ((∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A] (B : Type u) [CommRing B] [IsLocalRing B] [IsNoetherianRing B] [Algebra A B] [IsLocalHom (algebraMap A B)] [Module.Flat A B], IsRegularLocalRing A → IsRegularLocalRing (B ⧸ Ideal.map (algebraMap A B) (IsLocalRing.maximalIdeal A)) → IsRegularLocalRing B) → ∀ (K : Type u) [Field K] (B : Type u) [CommRing B] [Algebra K B] [IsNoetherianRing B], (∀ (𝔮 : Ideal B) [𝔮.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔮)) → ∀ (L : Type u) [Field L] [Algebra K L] [FiniteDimensional K L] [Algebra.IsSeparable K L] (𝔔 : Ideal (TensorProduct K L B)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) → ∀ (C₀ : Type u) [CommRing C₀] [IsLocalRing C₀] [IsNoetherianRing C₀] [IsDomain C₀], IsRegularLocalRing C₀ → (∀ m : ℕ, m ≠ 0 → (m : C₀) ≠ 0) → ∀ (𝔮 : Ideal (Polynomial C₀)) [𝔮.IsMaximal], 𝔮.comap Polynomial.C = IsLocalRing.maximalIdeal C₀ → ∀ (𝔭 : Ideal (Localization.AtPrime 𝔮)) [𝔭.IsPrime], 𝔭 = ⊥ → ∀ (Λ : Type u) [CommRing Λ] [Algebra (Localization.AtPrime 𝔮) Λ], Nonempty (AdicCompletion (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮)) (Localization.AtPrime 𝔮) ≃ₐ[Localization.AtPrime 𝔮] Λ) → ∀ (L : Type u) [Field L] [Algebra (Localization.AtPrime 𝔮) L] [Algebra (𝔭).ResidueField L] [IsScalarTower (Localization.AtPrime 𝔮) (𝔭).ResidueField L] [FiniteDimensional (𝔭).ResidueField L] (𝔔 : Ideal (TensorProduct (Localization.AtPrime 𝔮) L Λ)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔) :=
by
  intro R1 R3 POLY COMP SEP C₀ _ _ _ _ hreg hchar 𝔮 _ hq 𝔭 _ h𝔭 Λ _ _ hΛ L _ _ _ _ _ 𝔔 _
  subst h𝔭
  have hP : IsRegularLocalRing (Localization.AtPrime 𝔮) := POLY C₀ hreg 𝔮 hq
  have hι₀ : Function.Injective (Polynomial.C : C₀ →+* Polynomial C₀) := Polynomial.C_injective
