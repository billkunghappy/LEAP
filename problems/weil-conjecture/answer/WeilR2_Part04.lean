      rw [h1]
      have h2 := congrArg (fun F : MvPolynomial (Fin m) k →ₐ[k] _ => F q)
        (MvPolynomial.sumAlgEquiv_comp_rename_inr k (Fin d) (Fin m))
      simp only [AlgHom.coe_comp, Function.comp_apply,
        IsScalarTower.toAlgHom_apply, MvPolynomial.algebraMap_eq] at h2
      exact h2
    have hEg : ∀ j, E (MvPolynomial.rename Sum.inl (π j) * MvPolynomial.X (Sum.inr j)) =
        MvPolynomial.C (π j) * MvPolynomial.X j := by
      intro j; rw [map_mul, hER, hEX]
    have hmapJ : Ideal.map E (Ideal.span ((fun j => (MvPolynomial.rename Sum.inl (π j) *
        MvPolynomial.X (Sum.inr j) : MvPolynomial (Fin m ⊕ Fin d) k) ^ e) '' {j | j < i})) =
        Ideal.span ((fun j => (MvPolynomial.C (π j) * MvPolynomial.X j :
          MvPolynomial (Fin d) (MvPolynomial (Fin m) k)) ^ e) '' {j | j < i}) := by
      rw [Ideal.map_span, Set.image_image]
      congr 1
      apply Set.image_congr
      intro j _
      simp only [map_pow, hEg]
    have h1 := Ideal.mem_map_of_mem E hy
    rw [hmapJ, map_mul, map_pow, hEg] at h1
    have h2 := H (E y) h1
    rw [← hEg, ← map_mul, ← hmapJ] at h2
    rw [← Ideal.comap_map_of_bijective E E.bijective (I := Ideal.span ((fun j =>
      (MvPolynomial.rename Sum.inl (π j) * MvPolynomial.X (Sum.inr j) :
        MvPolynomial (Fin m ⊕ Fin d) k) ^ e) '' {j | j < i}))]
    exact h2

  have uscale : ∀ (x y u : Fin d → Localization.AtPrime 𝔮), (∀ i, IsUnit (u i)) →
      (∀ i, x i = u i * y i) → Ideal.span (Set.range x) = Ideal.span (Set.range y) := by
    intro x y u hu hx
    apply le_antisymm
    · rw [Ideal.span_le]
      rintro _ ⟨i, rfl⟩
      rw [hx i]
      exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨i, rfl⟩)
    · rw [Ideal.span_le]
      rintro _ ⟨i, rfl⟩
      refine (Ideal.unit_mul_mem_iff_mem _ (hu i)).mp ?_
      rw [← hx i]
      exact Ideal.subset_span ⟨i, rfl⟩
  have hG : ∀ π : Fin d → Λ, Ideal.map (algebraMap Λ (Localization.AtPrime 𝔮))
      (Ideal.span (Set.range π)) =
      Ideal.span (Set.range (fun i => algebraMap Λ (Localization.AtPrime 𝔮) (π i))) := by
    intro π
    rw [Ideal.map_span, ← Set.range_comp]
    rfl
  have hunit : ∀ s : Λ, s ∉ 𝔮 → IsUnit (algebraMap Λ (Localization.AtPrime 𝔮) s) :=
    fun s hs => IsLocalization.map_units (Localization.AtPrime 𝔮) (⟨s, hs⟩ : 𝔮.primeCompl)
  have hunitQ : ∀ s : MvPolynomial (Fin m) k, s ∉ 𝔮.comap φ'.toRingHom →
      IsUnit (algebraMap (MvPolynomial (Fin m) k) (Localization.AtPrime (𝔮.comap φ'.toRingHom)) s) :=
    fun s hs => IsLocalization.map_units (Localization.AtPrime (𝔮.comap φ'.toRingHom))
      (⟨s, hs⟩ : (𝔮.comap φ'.toRingHom).primeCompl)

  have hs4 : ∀ (x : Fin d → Localization.AtPrime 𝔮),
      Ideal.span (Set.range x) = IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) →
      ∀ (T : Set (Fin d)) (t : Fin d), t ∉ T → ∀ y, x t * y ∈ Ideal.span (x '' T) →
        y ∈ Ideal.span (x '' T) := by
    intro x hx T t ht y hy
    let A : Finset (Localization.AtPrime 𝔮) := Finset.image x (Finset.univ.filter (· ∈ T))
    let B : Finset (Localization.AtPrime 𝔮) := Finset.image x (Finset.univ.filter (· ∉ T))
    have hA : (A : Set (Localization.AtPrime 𝔮)) = x '' T := by
      ext z; simp [A]
    have hAB : (A : Set (Localization.AtPrime 𝔮)) ∪ (B : Set _) = Set.range x := by
      ext z
      simp only [A, B, Finset.coe_image, Finset.coe_filter, Finset.mem_univ, true_and,
        Set.mem_union, Set.mem_image, Set.mem_setOf_eq, Set.mem_range]
      constructor
      · rintro (⟨i, _, rfl⟩ | ⟨i, _, rfl⟩) <;> exact ⟨i, rfl⟩
      · rintro ⟨i, rfl⟩
        by_cases hi : i ∈ T
        · exact Or.inl ⟨i, hi, rfl⟩
        · exact Or.inr ⟨i, hi, rfl⟩
    have hcard : A.card + B.card ≤
        Submodule.spanFinrank (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮)) := by
      rw [hd]
      calc A.card + B.card ≤ (Finset.univ.filter (· ∈ T)).card +
            (Finset.univ.filter (fun i : Fin d => ¬ (i ∈ T))).card :=
            Nat.add_le_add Finset.card_image_le Finset.card_image_le
        _ = d := by
            rw [Finset.card_filter_add_card_filter_not, Finset.card_univ, Fintype.card_fin]
    obtain ⟨hreg, -, hB⟩ := wc_ogp_quotient_regular (Localization.AtPrime 𝔮) A B
      (by rw [hAB]; exact hx) hcard
    have htB : x t ∈ B := Finset.mem_image.mpr ⟨t, by simp [ht], rfl⟩
    have hxt := hB (x t) htB
    haveI := hreg
    haveI := wcpa_regular_isDomain
      (Localization.AtPrime 𝔮 ⧸ Ideal.span (A : Set (Localization.AtPrime 𝔮)))
      wcpa_rs_quotient_regular hreg
    rw [← hA] at hy ⊢
    have h0 : Ideal.Quotient.mk (Ideal.span (A : Set (Localization.AtPrime 𝔮))) (x t) *
        Ideal.Quotient.mk (Ideal.span (A : Set (Localization.AtPrime 𝔮))) y = 0 := by
      rw [← map_mul, Ideal.Quotient.eq_zero_iff_mem]; exact hy
    rcases mul_eq_zero.mp h0 with h | h
    · exact absurd (Ideal.Quotient.eq_zero_iff_mem.mp h) hxt
    · exact Ideal.Quotient.eq_zero_iff_mem.mp h

  have hs5 : ∀ (x : Fin d → Localization.AtPrime 𝔮),
      (∀ (T : Set (Fin d)) (t : Fin d), t ∉ T → ∀ y, x t * y ∈ Ideal.span (x '' T) →
        y ∈ Ideal.span (x '' T)) →
      ∀ (S : Set (Fin d)) (t : Fin d), t ∉ S → ∀ y, x t * y ∈ Ideal.span ((fun j => x j ^ e) '' S) →
        y ∈ Ideal.span ((fun j => x j ^ e) '' S) := by
    intro x H S t ht y hy
    let F : Finset (Fin d) := S.toFinset
    let o := F.orderEmbOfFin rfl
    let ι' : Fin (F.card + 1) → Fin d := Fin.snoc (α := fun _ => Fin d) (fun a => o a) t
    have hι'c : ∀ a, ι' a.castSucc = o a := fun a => by simp only [ι', Fin.snoc_castSucc]
    have hι'l : ι' (Fin.last F.card) = t := by simp only [ι', Fin.snoc_last]
    have hro : Set.range o = S := by
      rw [Finset.range_orderEmbOfFin]; exact Set.coe_toFinset S
    have hinj : Function.Injective ι' := by
      intro a b hab
      rcases Fin.eq_castSucc_or_eq_last a with ⟨a', rfl⟩ | rfl <;>
        rcases Fin.eq_castSucc_or_eq_last b with ⟨b', rfl⟩ | rfl
      · rw [hι'c, hι'c] at hab; rw [o.injective hab]
      · rw [hι'c, hι'l] at hab
        have h1 : t ∈ Set.range o := ⟨a', hab⟩
        rw [hro] at h1; exact absurd h1 ht
      · rw [hι'l, hι'c] at hab
        have h1 : t ∈ Set.range o := ⟨b', hab.symm⟩
        rw [hro] at h1; exact absurd h1 ht
      · rfl
    let x' : Fin (F.card + 1) → Localization.AtPrime 𝔮 := fun a => x (ι' a)
    have H' : ∀ (T : Set (Fin (F.card + 1))) (t' : Fin (F.card + 1)), t' ∉ T → ∀ y,
        x' t' * y ∈ Ideal.span (x' '' T) → y ∈ Ideal.span (x' '' T) := by
      intro T t' ht' y hy
      have himg : x' '' T = x '' (ι' '' T) := by rw [Set.image_image]
      rw [himg] at hy ⊢
      exact H (ι' '' T) (ι' t') (fun h => ht' (hinj.mem_set_image.mp h)) y hy
    have key := wc_ogp_regseq_pow (Localization.AtPrime 𝔮) (F.card + 1) x' H' e (Fin.last F.card) y
    have hset : (fun j => x' j ^ e) '' {j | j < Fin.last F.card} = (fun j => x j ^ e) '' S := by
      have h1 : {j : Fin (F.card + 1) | j < Fin.last F.card} = Set.range Fin.castSucc := by
        rw [Fin.range_castSucc]
        ext j
        simp only [Set.mem_setOf_eq, Fin.lt_iff_val_lt_val, Fin.val_last]
      rw [h1, ← hro, ← Set.range_comp, ← Set.range_comp]
      congr 1
      funext a
      simp only [Function.comp, x', hι'c]
    have hxl : x' (Fin.last F.card) = x t := by simp only [x', hι'l]
    rw [hset, hxl] at key
    exact key hy

  have hfcomp : (Localization.localRingHom (𝔮.comap φ'.toRingHom) 𝔮 φ'.toRingHom rfl).comp
      (algebraMap (MvPolynomial (Fin m) k) (Localization.AtPrime (𝔮.comap φ'.toRingHom))) =
      (algebraMap Λ (Localization.AtPrime 𝔮)).comp φ'.toRingHom :=
    RingHom.ext fun z => Localization.localRingHom_to_map _ _ _ rfl z
  have hdesc : ∀ (I : Ideal (MvPolynomial (Fin m) k)) (z : MvPolynomial (Fin m) k),
      algebraMap Λ (Localization.AtPrime 𝔮) (φ' z) ∈
        Ideal.map ((algebraMap Λ (Localization.AtPrime 𝔮)).comp φ'.toRingHom) I →
      algebraMap (MvPolynomial (Fin m) k) (Localization.AtPrime (𝔮.comap φ'.toRingHom)) z ∈
        Ideal.map (algebraMap (MvPolynomial (Fin m) k) (Localization.AtPrime (𝔮.comap φ'.toRingHom))) I := by
    intro I z hz
    letI : Algebra (Localization.AtPrime (𝔮.comap φ'.toRingHom)) (Localization.AtPrime 𝔮) :=
      (Localization.localRingHom (𝔮.comap φ'.toRingHom) 𝔮 φ'.toRingHom rfl).toAlgebra
    haveI : Module.Flat (Localization.AtPrime (𝔮.comap φ'.toRingHom)) (Localization.AtPrime 𝔮) :=
      RingHom.flat_algebraMap_iff.mp hflat
    haveI : IsLocalHom (algebraMap (Localization.AtPrime (𝔮.comap φ'.toRingHom))
        (Localization.AtPrime 𝔮)) :=
      Localization.isLocalHom_localRingHom _ _ _ rfl
    haveI : Module.FaithfullyFlat (Localization.AtPrime (𝔮.comap φ'.toRingHom))
        (Localization.AtPrime 𝔮) := Module.FaithfullyFlat.of_flat_of_isLocalHom
    rw [← Ideal.comap_map_eq_self_of_faithfullyFlat (B := Localization.AtPrime 𝔮)
      (Ideal.map (algebraMap (MvPolynomial (Fin m) k)
        (Localization.AtPrime (𝔮.comap φ'.toRingHom))) I), Ideal.mem_comap]
    have h1 : algebraMap (Localization.AtPrime (𝔮.comap φ'.toRingHom)) (Localization.AtPrime 𝔮)
        (algebraMap (MvPolynomial (Fin m) k) (Localization.AtPrime (𝔮.comap φ'.toRingHom)) z) =
        algebraMap Λ (Localization.AtPrime 𝔮) (φ' z) :=
      Localization.localRingHom_to_map _ _ _ rfl z
    have h2 : Ideal.map (algebraMap (Localization.AtPrime (𝔮.comap φ'.toRingHom))
        (Localization.AtPrime 𝔮)) (Ideal.map (algebraMap (MvPolynomial (Fin m) k)
          (Localization.AtPrime (𝔮.comap φ'.toRingHom))) I) =
        Ideal.map ((algebraMap Λ (Localization.AtPrime 𝔮)).comp φ'.toRingHom) I := by
      rw [Ideal.map_map]; exact congrArg (fun g => Ideal.map g I) hfcomp
    rw [h1, h2]; exact hz

  have ogoma1 : ∀ (J : Ideal (MvPolynomial (Fin m) k)) (p : MvPolynomial (Fin m) k),
      (∀ y, algebraMap _ (Localization.AtPrime (𝔮.comap φ'.toRingHom)) (p ^ 2 * y) ∈
        Ideal.map (algebraMap _ (Localization.AtPrime (𝔮.comap φ'.toRingHom))) J →
        algebraMap _ (Localization.AtPrime (𝔮.comap φ'.toRingHom)) (p * y) ∈
        Ideal.map (algebraMap _ (Localization.AtPrime (𝔮.comap φ'.toRingHom))) J) →
      ∃ s, s ∉ 𝔮.comap φ'.toRingHom ∧ ∀ y,
        algebraMap _ (Localization.AtPrime (𝔮.comap φ'.toRingHom)) (p ^ 2 * y) ∈
          Ideal.map (algebraMap _ (Localization.AtPrime (𝔮.comap φ'.toRingHom))) J →
        s * p * y ∈ J := by
    intro J p hJ
    let K' : Ideal (MvPolynomial (Fin m) k) :=
      { carrier := {y | algebraMap _ (Localization.AtPrime (𝔮.comap φ'.toRingHom)) (p ^ 2 * y) ∈
          Ideal.map (algebraMap _ (Localization.AtPrime (𝔮.comap φ'.toRingHom))) J}
        add_mem' := by
          intro x y hx hy
          simp only [Set.mem_setOf_eq, mul_add, map_add] at hx hy ⊢
          exact add_mem hx hy
        zero_mem' := by
          change (algebraMap (MvPolynomial (Fin m) k) (Localization.AtPrime (𝔮.comap φ'.toRingHom)))
            (p ^ 2 * 0) ∈ Ideal.map (algebraMap (MvPolynomial (Fin m) k)
              (Localization.AtPrime (𝔮.comap φ'.toRingHom))) J
          rw [mul_zero, map_zero]
          exact zero_mem _
        smul_mem' := by
          intro c x hx
          simp only [Set.mem_setOf_eq, smul_eq_mul] at hx ⊢
          rw [mul_left_comm, map_mul]
          exact Ideal.mul_mem_left _ _ hx }
    have hK' : ∀ y, y ∈ K' ↔ algebraMap _ (Localization.AtPrime (𝔮.comap φ'.toRingHom)) (p ^ 2 * y) ∈
        Ideal.map (algebraMap _ (Localization.AtPrime (𝔮.comap φ'.toRingHom))) J := fun y => Iff.rfl
    obtain ⟨F, hF⟩ := (IsNoetherian.noetherian K' : K'.FG)
    have hfin : ∀ F : Finset (MvPolynomial (Fin m) k), (∀ k ∈ F, k ∈ K') →
        ∃ s, s ∉ 𝔮.comap φ'.toRingHom ∧ ∀ k ∈ F, s * p * k ∈ J := by
      intro F
      induction F using Finset.induction_on with
      | empty => exact fun _ => ⟨1, (inferInstance : (𝔮.comap φ'.toRingHom).IsPrime).one_notMem, by simp⟩
      | insert b F hbF ih =>
        intro hsub
        obtain ⟨s', hs', hs'F⟩ := ih (fun k hk => hsub k (Finset.mem_insert_of_mem hk))
        have hb := hJ b ((hK' b).mp (hsub b (Finset.mem_insert_self b F)))
        obtain ⟨u, hu, hub⟩ := (IsLocalization.algebraMap_mem_map_algebraMap_iff
          (𝔮.comap φ'.toRingHom).primeCompl
          (Localization.AtPrime (𝔮.comap φ'.toRingHom)) J (p * b)).mp hb
        refine ⟨u * s', fun h => ?_, ?_⟩
        · rcases (inferInstance : (𝔮.comap φ'.toRingHom).IsPrime).mem_or_mem h with h1 | h1
          · exact hu h1
          · exact hs' h1
        · intro k hk
          rcases Finset.mem_insert.mp hk with rfl | hk
          · have : u * s' * p * k = s' * (u * (p * k)) := by ring
            rw [this]
            exact Ideal.mul_mem_left _ _ hub
          · have : u * s' * p * k = u * (s' * p * k) := by ring
            rw [this]
            exact Ideal.mul_mem_left _ _ (hs'F k hk)
    obtain ⟨s, hs, hsF⟩ := hfin F (fun k hk => by rw [← hF]; exact Submodule.subset_span hk)
    have hsK : ∀ y ∈ K', s * p * y ∈ J := by
      intro y hy
      rw [← hF] at hy
      induction hy using Submodule.span_induction with
      | mem x hx => exact hsF x hx
      | zero => simp
      | add x z _ _ hx hz => rw [mul_add]; exact add_mem hx hz
      | smul c x _ hx =>
        rw [smul_eq_mul, mul_left_comm]
        exact Ideal.mul_mem_left _ _ hx
    exact ⟨s, hs, fun y hy => hsK y hy⟩

  have ogomaU : ∀ (t : Fin d) (J : Set (Fin d) → Ideal (MvPolynomial (Fin m) k))
      (p : MvPolynomial (Fin m) k),
      (∀ S : Set (Fin d), S ⊆ {j | j < t} → ∀ y,
        algebraMap _ (Localization.AtPrime (𝔮.comap φ'.toRingHom)) (p ^ 2 * y) ∈
          Ideal.map (algebraMap _ (Localization.AtPrime (𝔮.comap φ'.toRingHom))) (J S) →
        algebraMap _ (Localization.AtPrime (𝔮.comap φ'.toRingHom)) (p * y) ∈
          Ideal.map (algebraMap _ (Localization.AtPrime (𝔮.comap φ'.toRingHom))) (J S)) →
      ∃ s, s ∉ 𝔮.comap φ'.toRingHom ∧ ∀ S : Set (Fin d), S ⊆ {j | j < t} → ∀ y,
        (s * p) ^ 2 * y ∈ J S → s * p * y ∈ J S := by
    intro t J p hJ
    have hS : ∀ S : Set (Fin d), ∃ s, s ∉ 𝔮.comap φ'.toRingHom ∧ (S ⊆ {j | j < t} → ∀ y,
        algebraMap _ (Localization.AtPrime (𝔮.comap φ'.toRingHom)) (p ^ 2 * y) ∈
          Ideal.map (algebraMap _ (Localization.AtPrime (𝔮.comap φ'.toRingHom))) (J S) →
        s * p * y ∈ J S) := by
      intro S
      by_cases hSt : S ⊆ {j | j < t}
      · obtain ⟨s, hs, h⟩ := ogoma1 (J S) p (hJ S hSt)
        exact ⟨s, hs, fun _ => h⟩
      · exact ⟨1, (inferInstance : (𝔮.comap φ'.toRingHom).IsPrime).one_notMem,
          fun h => absurd h hSt⟩
    choose sf hsf hsfJ using hS
    have hprod : Finset.univ.prod sf ∉ 𝔮.comap φ'.toRingHom := by
      intro hmem
      obtain ⟨S, _, hS⟩ := (Ideal.IsPrime.prod_mem_iff).mp hmem
      exact hsf S hS
    refine ⟨Finset.univ.prod sf, hprod, ?_⟩
    intro S hSt y hy
    have hy' : algebraMap _ (Localization.AtPrime (𝔮.comap φ'.toRingHom)) (p ^ 2 * y) ∈
        Ideal.map (algebraMap _ (Localization.AtPrime (𝔮.comap φ'.toRingHom))) (J S) := by
      have h1 := Ideal.mem_map_of_mem
        (algebraMap (MvPolynomial (Fin m) k) (Localization.AtPrime (𝔮.comap φ'.toRingHom))) hy
      have h2 : algebraMap (MvPolynomial (Fin m) k) (Localization.AtPrime (𝔮.comap φ'.toRingHom))
          ((Finset.univ.prod sf * p) ^ 2 * y) =
          algebraMap _ (Localization.AtPrime (𝔮.comap φ'.toRingHom)) (Finset.univ.prod sf) ^ 2 *
            algebraMap _ (Localization.AtPrime (𝔮.comap φ'.toRingHom)) (p ^ 2 * y) := by
        simp only [map_mul, map_pow]; ring
      rw [h2] at h1
      exact (Ideal.unit_mul_mem_iff_mem _ ((hunitQ _ hprod).pow 2)).mp h1
    have h3 := hsfJ S hSt y hy'
    rw [← Finset.prod_erase_mul Finset.univ sf (Finset.mem_univ S)]
    have : (∏ x ∈ Finset.univ.erase S, sf x) * sf S * p * y =
        (∏ x ∈ Finset.univ.erase S, sf x) * (sf S * p * y) := by ring
    rw [this]
    exact Ideal.mul_mem_left _ _ h3

  have step : ∀ π : Fin d → MvPolynomial (Fin m) k,
      Ideal.map (algebraMap Λ (Localization.AtPrime 𝔮)) (Ideal.span (Set.range fun i => φ' (π i))) =
        IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) →
      ∀ t : Fin d, ∃ s, s ∉ 𝔮.comap φ'.toRingHom ∧ ∀ S : Set (Fin d), S ⊆ {j | j < t} → ∀ y,
        (s * π t) ^ 2 * y ∈ Ideal.span ((fun j => π j ^ e) '' S) →
        s * π t * y ∈ Ideal.span ((fun j => π j ^ e) '' S) := by
    intro π hπG t
    let x : Fin d → Localization.AtPrime 𝔮 := fun i => algebraMap Λ (Localization.AtPrime 𝔮) (φ' (π i))
    have hx : Ideal.span (Set.range x) = IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) := by
      rw [← hπG, Ideal.map_span, ← Set.range_comp]; rfl
    have H := hs4 x hx
    apply ogomaU t (fun S => Ideal.span ((fun j => π j ^ e) '' S)) (π t)
    intro S hSt y hy
    beta_reduce at hy ⊢
    have hmapS : Ideal.map ((algebraMap Λ (Localization.AtPrime 𝔮)).comp φ'.toRingHom)
        (Ideal.span ((fun j => π j ^ e) '' S)) = Ideal.span ((fun j => x j ^ e) '' S) := by
      rw [Ideal.map_span, Set.image_image]
      congr 1
      apply Set.image_congr
      intro j _
      simp only [x, RingHom.comp_apply, map_pow]
      rfl
    have hy2 : algebraMap Λ (Localization.AtPrime 𝔮) (φ' (π t ^ 2 * y)) ∈
        Ideal.span ((fun j => x j ^ e) '' S) := by
      rw [← hmapS]
      have h1 := Ideal.mem_map_of_mem
        (Localization.localRingHom (𝔮.comap φ'.toRingHom) 𝔮 φ'.toRingHom rfl) hy
      rw [Ideal.map_map, hfcomp, Localization.localRingHom_to_map] at h1
      exact h1
    have e1 : algebraMap Λ (Localization.AtPrime 𝔮) (φ' (π t ^ 2 * y)) =
        x t * algebraMap Λ (Localization.AtPrime 𝔮) (φ' (π t * y)) := by
      simp only [x, map_mul, map_pow]; ring
    rw [e1] at hy2
    apply hdesc
    rw [hmapS]
    exact hs5 x H S t (fun h => lt_irrefl t (hSt h)) _ hy2

  have hs1 : ∀ (r : ℕ) (v : Fin r → Localization.AtPrime 𝔮),
      Ideal.span (Set.range v) = IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) →
      ∃ σ : Fin d → Fin r, Ideal.span (Set.range fun j => v (σ j)) =
        IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) := by
    intro r v hv
    have hmem : ∀ l, v l ∈ IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) :=
      fun l => hv ▸ Ideal.subset_span ⟨l, rfl⟩
    let w : Fin r → IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) := fun l => ⟨v l, hmem l⟩
    have htrans : ∀ {ι : Type} (u : ι → IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮)),
        Submodule.span (Localization.AtPrime 𝔮) (Set.range u) = ⊤ ↔
        Ideal.span (Set.range (fun i => (u i : Localization.AtPrime 𝔮))) =
          IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) := by
      intro ι u
      have hm : Submodule.map (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮)).subtype
          (Submodule.span (Localization.AtPrime 𝔮) (Set.range u)) =
          Ideal.span (Set.range (fun i => (u i : Localization.AtPrime 𝔮))) := by
        rw [Submodule.map_span, ← Set.range_comp]; rfl
      constructor
      · intro h; rw [← hm, h, Submodule.map_subtype_top]
      · intro h
        apply Submodule.map_injective_of_injective
          (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮)).injective_subtype
        rw [hm, h, Submodule.map_subtype_top]
    have h1 : Submodule.span (Localization.AtPrime 𝔮) (Set.range w) = ⊤ := (htrans w).mpr hv
    have h2 : Submodule.span (IsLocalRing.ResidueField (Localization.AtPrime 𝔮))
        (Set.range (fun l => (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮)).toCotangent (w l))) = ⊤ := by
      have := (IsLocalRing.CotangentSpace.span_image_eq_top_iff (s := Set.range w)).mpr h1
      rw [← Set.range_comp] at this
      exact this
    obtain ⟨κ, a, ha_inj, ha_span, ha_li⟩ := exists_linearIndependent'
      (IsLocalRing.ResidueField (Localization.AtPrime 𝔮))
      (fun l => (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮)).toCotangent (w l))
    haveI : Finite κ := Finite.of_injective a ha_inj
    letI : Fintype κ := Fintype.ofFinite κ
    have hspan : Submodule.span (IsLocalRing.ResidueField (Localization.AtPrime 𝔮))
        (Set.range ((fun l => (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮)).toCotangent (w l)) ∘ a)) = ⊤ := by
      rw [ha_span, h2]
    let b := Module.Basis.mk ha_li hspan.ge
    have hcard : Fintype.card κ = d := by
      rw [← Module.finrank_eq_card_basis b, ← hd,
        IsLocalRing.spanFinrank_maximalIdeal_eq_finrank_cotangentSpace]
    let eq := Fintype.equivFinOfCardEq hcard
    refine ⟨fun j => a (eq.symm j), ?_⟩
    apply (htrans (fun j => w (a (eq.symm j)))).mp
    apply (IsLocalRing.CotangentSpace.span_image_eq_top_iff).mp
    rw [← Set.range_comp]
    have : Set.range (⇑(IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮)).toCotangent ∘
        fun j => w (a (eq.symm j))) =
        Set.range ((fun l => (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮)).toCotangent (w l)) ∘ a) := by
      ext z; constructor
      · rintro ⟨j, rfl⟩; exact ⟨eq.symm j, rfl⟩
      · rintro ⟨x, rfl⟩; exact ⟨eq x, by simp⟩
    rw [this, hspan]
  obtain ⟨r, gen, hgen'⟩ := Submodule.fg_iff_exists_fin_generating_family.mp
    (IsNoetherian.noetherian (𝔮.comap φ'.toRingHom))
  have hgenI : Ideal.span (Set.range gen) = 𝔮.comap φ'.toRingHom := hgen'
  have hv : Ideal.span (Set.range fun l => algebraMap Λ (Localization.AtPrime 𝔮) (φ' (gen l))) =
      IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) := by
    rw [← hgen]
    have e1 : IsLocalRing.maximalIdeal (Localization.AtPrime (𝔮.comap φ'.toRingHom)) =
        Ideal.map (algebraMap _ (Localization.AtPrime (𝔮.comap φ'.toRingHom)))
          (Ideal.span (Set.range gen)) := by
      rw [hgenI]; exact Localization.AtPrime.map_eq_maximalIdeal.symm
    rw [e1, Ideal.map_map, hfcomp, Ideal.map_span, ← Set.range_comp]
    rfl
  obtain ⟨σ, hσ⟩ := hs1 r _ hv

  have loop : ∀ n : ℕ, ∃ π : Fin d → MvPolynomial (Fin m) k,
      ((∀ i, π i ∈ 𝔮.comap φ'.toRingHom) ∧
        Ideal.map (algebraMap Λ (Localization.AtPrime 𝔮)) (Ideal.span (Set.range fun i => φ' (π i))) =
          IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮)) ∧
      ∀ i : Fin d, i.val < n → ∀ S : Set (Fin d), S ⊆ {j | j < i} → ∀ a,
        π i ^ 2 * a ∈ Ideal.span ((fun j => π j ^ e) '' S) →
        π i * a ∈ Ideal.span ((fun j => π j ^ e) '' S) := by
    intro n
    induction n with
    | zero =>
      refine ⟨fun i => gen (σ i), ⟨fun i => ?_, ?_⟩, fun i hi => absurd hi (Nat.not_lt_zero _)⟩
      · rw [← hgenI]; exact Ideal.subset_span ⟨σ i, rfl⟩
      · rw [Ideal.map_span, ← Set.range_comp]; exact hσ
    | succ n ih =>
      obtain ⟨π, ⟨hπ𝔭, hπG⟩, hπC⟩ := ih
      by_cases hk : n < d
      · let t : Fin d := ⟨n, hk⟩
        obtain ⟨s, hs, hsC⟩ := step π hπG t
        let π' : Fin d → MvPolynomial (Fin m) k := fun i => if i = t then s * π i else π i
        have hJ : ∀ i : Fin d, i ≤ t → ∀ S : Set (Fin d), S ⊆ {j | j < i} →
            (fun j => π' j ^ e) '' S = (fun j => π j ^ e) '' S := by
          intro i hi S hS
          apply Set.image_congr
          intro j hj
          have hjt : j ≠ t := ne_of_lt (lt_of_lt_of_le (hS hj) hi)
          simp only [π', if_neg hjt]
        refine ⟨π', ⟨fun i => ?_, ?_⟩, ?_⟩
        · by_cases hi : i = t
          · simp only [π', if_pos hi]; exact Ideal.mul_mem_left _ _ (hπ𝔭 i)
          · simp only [π', if_neg hi]; exact hπ𝔭 i
        · rw [hG, ← hπG, hG]
          refine uscale _ _ (fun i => if i = t then algebraMap Λ (Localization.AtPrime 𝔮) (φ' s) else 1)
            (fun i => ?_) (fun i => ?_)
          · by_cases hi : i = t
            · simp only [if_pos hi]; exact hunit _ hs
            · simp only [if_neg hi]; exact isUnit_one
          · by_cases hi : i = t
            · simp only [π', if_pos hi, map_mul]
            · simp only [π', if_neg hi, one_mul]
        · intro i hi S hS a
          by_cases hik : i.val < n
          · have hit : i ≠ t := fun h => by rw [h] at hik; exact lt_irrefl _ hik
            have hle : i ≤ t := le_of_lt (show i.val < t.val from hik)
            rw [hJ i hle S hS]
            simp only [π', if_neg hit]
            exact hπC i hik S hS a
          · have hit : i = t := Fin.ext (by simp [t]; omega)
            subst hit
            rw [hJ _ le_rfl S hS]
            simp only [π', if_true]
            exact hsC S hS a
      · refine ⟨π, ⟨hπ𝔭, hπG⟩, fun i hi => hπC i ?_⟩
        have := i.isLt
        omega
  obtain ⟨π, ⟨hπ𝔭, hπG⟩, hπC⟩ := loop d
  refine ⟨π, hπ𝔭, hπG, fun i y hy => ?_⟩
  exact hs9 π i (hs6 (MvPolynomial (Fin m) k) π i (hπC i i.isLt)) y hy

theorem wc_pfc_pd_annseq_pow : ∀ (Z : Type u) [CommRing Z] (r c : ℕ) (x : Fin r → Z), 1 ≤ c → (∀ (i : Fin r) (y : Z), x i ^ 2 * y ∈ Ideal.span ((fun j => x j ^ (8 * c)) '' {j | j < i}) → x i * y ∈ Ideal.span ((fun j => x j ^ (8 * c)) '' {j | j < i})) → wcPfcAnnSeq (fun i => x i ^ c) :=
by
  intro Z _ r c x hc H
  unfold wcPfcAnnSeq
  intro i y hy
  have key : ∀ j, (x j ^ c) ^ 8 = x j ^ (8 * c) := fun j => by rw [← pow_mul, mul_comm]
  simp only [key] at hy ⊢
  set J := Ideal.span ((fun j => x j ^ (8 * c)) '' {j | j < i}) with hJ
  have boot : ∀ (k : ℕ) (y : Z), x i ^ (k + 1) * y ∈ J → x i * y ∈ J := by
    intro k
    induction k with
    | zero => intro y h; simpa using h
    | succ k ih =>
      intro y h
      apply H i y
      have h2 : x i * (x i * y) ∈ J := ih (x i * y) (by
        have e : x i ^ (k + 1) * (x i * y) = x i ^ (k + 1 + 1) * y := by ring
        rw [e]; exact h)
      have e : x i ^ 2 * y = x i * (x i * y) := by ring
      rw [e]; exact h2
  obtain ⟨c', hc'⟩ : ∃ c', c = c' + 1 := ⟨c - 1, by omega⟩
  have h1 : x i * y ∈ J := boot (2 * c' + 1) y (by
    have e : x i ^ (2 * c' + 1 + 1) * y = y * (x i ^ c) ^ 2 := by rw [hc']; ring
    rw [e]; exact hy)
  have e : y * x i ^ c = x i ^ c' * (x i * y) := by rw [hc']; ring
  rw [e]; exact J.mul_mem_left _ h1

theorem wc_pfc_pd_strict_std_base_change : ∀ (P : Type u) [CommRing P] (C : Type u) [CommRing C] [Algebra P C] (R : Type u) [CommRing R] [Algebra P R] (a : C), wcPfcStrictStd P C a → wcPfcStrictStd R (TensorProduct P R C) (Algebra.TensorProduct.includeRight a) :=
by
  intro P _ C _ _ R _ _ a ha
  obtain ⟨n, m, c, hcn, hcm, f, e, hM, hS⟩ := ha
  obtain ⟨Φ, hΦ⟩ : ∃ Φ : MvPolynomial (Fin n) P →+* MvPolynomial (Fin n) R,
      Φ = MvPolynomial.map (algebraMap P R) := ⟨_, rfl⟩
  have hΦC : ∀ r, Φ (MvPolynomial.C r) = MvPolynomial.C (algebraMap P R r) := by
    intro r; rw [hΦ, MvPolynomial.map_C]
  have hΦX : ∀ i, Φ (MvPolynomial.X i) = MvPolynomial.X i := by
    intro i; rw [hΦ, MvPolynomial.map_X]
  have hΦd : ∀ (i : Fin n) (p : MvPolynomial (Fin n) P),
      MvPolynomial.pderiv i (Φ p) = Φ (MvPolynomial.pderiv i p) := by
    intro i p; rw [hΦ, MvPolynomial.pderiv_map]

  obtain ⟨α, hα⟩ : ∃ α : MvPolynomial (Fin n) R →ₐ[R] TensorProduct P R C,
      α = MvPolynomial.aeval (fun i => (Algebra.TensorProduct.includeRight :
        C →ₐ[P] TensorProduct P R C) (e (Ideal.Quotient.mk (Ideal.span (Set.range f))
          (MvPolynomial.X i)))) := ⟨_, rfl⟩
  have hαΦ : ∀ x, α (Φ x) = (Algebra.TensorProduct.includeRight : C →ₐ[P] TensorProduct P R C)
      (e (Ideal.Quotient.mk (Ideal.span (Set.range f)) x)) := by
    have key : α.toRingHom.comp Φ =
        (Algebra.TensorProduct.includeRight : C →ₐ[P] TensorProduct P R C).toRingHom.comp
          (e.toRingEquiv.toRingHom.comp (Ideal.Quotient.mk (Ideal.span (Set.range f)))) := by
      apply MvPolynomial.ringHom_ext
      · intro r
        simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
          RingEquiv.toRingHom_eq_coe, AlgEquiv.coe_ringEquiv]
        rw [hΦC, hα, MvPolynomial.aeval_C, ← IsScalarTower.algebraMap_apply,
          ← MvPolynomial.algebraMap_eq, Ideal.Quotient.mk_algebraMap P (Ideal.span (Set.range f)),
          AlgEquiv.commutes, AlgHom.commutes]
      · intro i
        simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
          RingEquiv.toRingHom_eq_coe, AlgEquiv.coe_ringEquiv]
        rw [hΦX, hα, MvPolynomial.aeval_X]
    intro x
    exact RingHom.congr_fun key x
  have hαK : ∀ y ∈ Ideal.span (Set.range (fun j => Φ (f j))), α y = 0 := by
    have hle : Ideal.span (Set.range (fun j => Φ (f j))) ≤ RingHom.ker α := by
      rw [Ideal.span_le]
      rintro _ ⟨j, rfl⟩
      rw [SetLike.mem_coe, RingHom.mem_ker, hαΦ,
        Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (s := Set.range f) ⟨j, rfl⟩),
        map_zero, map_zero]
    intro y hy
    exact (RingHom.mem_ker).mp (hle hy)
  obtain ⟨ᾱ, hᾱ⟩ : ∃ ᾱ : (MvPolynomial (Fin n) R ⧸ Ideal.span (Set.range (fun j => Φ (f j))))
      →ₐ[R] TensorProduct P R C,
      ∀ y, ᾱ (Ideal.Quotient.mk _ y) = α y :=
    ⟨Ideal.Quotient.liftₐ _ α hαK, fun y => rfl⟩

  have hleK : Ideal.span (Set.range f) ≤
      Ideal.comap (MvPolynomial.mapAlgHom (σ := Fin n) (Algebra.ofId P R))
        (Ideal.span (Set.range (fun j => Φ (f j)))) := by
    rw [Ideal.span_le]
    rintro _ ⟨j, rfl⟩
    rw [SetLike.mem_coe, Ideal.mem_comap]
    exact Ideal.subset_span ⟨j, by rw [hΦ]; rfl⟩
  obtain ⟨ν, hν⟩ : ∃ ν : (MvPolynomial (Fin n) P ⧸ Ideal.span (Set.range f)) →ₐ[P]
      (MvPolynomial (Fin n) R ⧸ Ideal.span (Set.range (fun j => Φ (f j)))),
      ∀ x, ν (Ideal.Quotient.mk _ x) = Ideal.Quotient.mk _ (Φ x) :=
    ⟨Ideal.quotientMapₐ _ (MvPolynomial.mapAlgHom (σ := Fin n) (Algebra.ofId P R)) hleK,
      fun x => by
        show Ideal.Quotient.mk _ (MvPolynomial.mapAlgHom (σ := Fin n) (Algebra.ofId P R) x) = _
        exact congrArg _ (by rw [hΦ]; rfl)⟩
  obtain ⟨β, hβ⟩ : ∃ β : TensorProduct P R C →ₐ[R]
      (MvPolynomial (Fin n) R ⧸ Ideal.span (Set.range (fun j => Φ (f j)))),
      ∀ (r : R) (y : C), β (r ⊗ₜ[P] y) = algebraMap R _ r * ν (e.symm y) :=
    ⟨Algebra.TensorProduct.lift (Algebra.ofId R _) (ν.comp e.symm.toAlgHom)
      (fun _ _ => Commute.all _ _), fun r y => by
        rw [Algebra.TensorProduct.lift_tmul]; rfl⟩
  have KI : ∀ x, β ((Algebra.TensorProduct.includeRight : C →ₐ[P] TensorProduct P R C)
      (e (Ideal.Quotient.mk (Ideal.span (Set.range f)) x))) =
      Ideal.Quotient.mk (Ideal.span (Set.range (fun j => Φ (f j)))) (Φ x) := by
    intro x
    rw [Algebra.TensorProduct.includeRight_apply, hβ, map_one, one_mul,
      AlgEquiv.symm_apply_apply, hν]
  have h1 : ᾱ.comp β = AlgHom.id R (TensorProduct P R C) := by
    apply Algebra.TensorProduct.ext'
    intro r y
    obtain ⟨x, hx⟩ := Ideal.Quotient.mk_surjective (e.symm y)
    obtain rfl : y = e (Ideal.Quotient.mk _ x) := by rw [hx, AlgEquiv.apply_symm_apply]
    rw [AlgHom.comp_apply, AlgHom.id_apply, hβ, AlgEquiv.symm_apply_apply, hν, map_mul,
      AlgHom.commutes, hᾱ, hαΦ, Algebra.TensorProduct.includeRight_apply,
      Algebra.TensorProduct.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply,
      Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
  have h2 : β.comp ᾱ = AlgHom.id R _ := by
    apply Ideal.Quotient.algHom_ext R
    apply MvPolynomial.algHom_ext
    intro i
    simp only [AlgHom.comp_apply, AlgHom.id_apply, Ideal.Quotient.mkₐ_eq_mk]
    rw [hᾱ, hα, MvPolynomial.aeval_X, KI, hΦX]
  obtain ⟨e', he'⟩ : ∃ e' : (MvPolynomial (Fin n) R ⧸
      Ideal.span (Set.range (fun j => Φ (f j)))) ≃ₐ[R] TensorProduct P R C,
      ∀ z, e'.symm z = β z :=
    ⟨AlgEquiv.ofAlgHom ᾱ β h1 h2, fun z => rfl⟩
  refine ⟨n, m, c, hcn, hcm, fun j => Φ (f j), e', ?_, ?_⟩
  · obtain ⟨x, hx, hxa⟩ :=
      (Ideal.mem_map_iff_of_surjective _ Ideal.Quotient.mk_surjective).mp hM
    have ha : a = e (Ideal.Quotient.mk (Ideal.span (Set.range f)) x) := by
      rw [hxa, AlgEquiv.apply_symm_apply]
    rw [he', ha, KI]
    apply Ideal.mem_map_of_mem
    have hmin : Ideal.map Φ (Ideal.span (Set.range (fun I : Fin c ↪ Fin n =>
        Matrix.det (Matrix.of (fun j l : Fin c =>
          MvPolynomial.pderiv (I l) (f (Fin.castLE hcm j))))))) ≤
        Ideal.span (Set.range (fun I : Fin c ↪ Fin n =>
        Matrix.det (Matrix.of (fun j l : Fin c =>
          MvPolynomial.pderiv (I l) (Φ (f (Fin.castLE hcm j))))))) := by
      rw [Ideal.map_span, Ideal.span_le]
      rintro _ ⟨_, ⟨I, rfl⟩, rfl⟩
      refine Ideal.subset_span ⟨I, ?_⟩
      rw [RingHom.map_det, RingHom.mapMatrix_apply]
      refine congrArg Matrix.det (Matrix.ext fun j l => ?_)
      simp only [Matrix.map_apply, Matrix.of_apply, hΦd]
    exact hmin (Ideal.mem_map_of_mem Φ hx)
  · intro j hj
    obtain ⟨g, hg, hgf⟩ := hS j hj
    refine ⟨Φ g, ?_, ?_⟩
    · rw [he', ← KI, hg, AlgEquiv.apply_symm_apply]
    · have h := Ideal.mem_map_of_mem Φ hgf
      rw [Submodule.add_eq_sup, Ideal.map_sup, Ideal.map_pow, Ideal.map_span, Ideal.map_span,
        Set.image_image, ← Set.range_comp, map_mul] at h
      rw [Submodule.add_eq_sup]
      exact h

theorem wc_pfc_pd_smooth_away_base_change : ∀ (P : Type u) [CommRing P] (C : Type u) [CommRing C] [Algebra P C] (R : Type u) [CommRing R] [Algebra P R] (a : C), Algebra.Smooth P (Localization.Away a) → Algebra.Smooth R (Localization.Away (Algebra.TensorProduct.includeRight a : TensorProduct P R C)) :=
by
  intro P _ C _ _ R _ _ a h
  haveI : Algebra.Smooth P (Localization.Away a) := h
  haveI hT : Algebra.Smooth R (TensorProduct P R (Localization.Away a)) :=
    Algebra.Smooth.baseChange P (Localization.Away a) R
  set b : TensorProduct P R C := Algebra.TensorProduct.includeRight a with hb
  let φ : C →ₐ[P] Localization.Away b :=
    (IsScalarTower.toAlgHom P (TensorProduct P R C) (Localization.Away b)).comp
      Algebra.TensorProduct.includeRight
  have hu2 : IsUnit (φ a) := IsLocalization.Away.algebraMap_isUnit b
  let g₁ : Localization.Away a →ₐ[P] Localization.Away b := IsLocalization.Away.liftAlgHom a hu2
  have hg₁ : ∀ c : C, g₁ (algebraMap C (Localization.Away a) c) =
      algebraMap (TensorProduct P R C) (Localization.Away b) ((1 : R) ⊗ₜ[P] c) := by
    intro c
    simp [g₁, φ, IsLocalization.Away.liftAlgHom_apply]
  let g : TensorProduct P R (Localization.Away a) →ₐ[R] Localization.Away b :=
    Algebra.TensorProduct.lift (Algebra.ofId R _) g₁ (fun _ _ => Commute.all _ _)
  have hg : ∀ (r : R) (c : C), g (r ⊗ₜ[P] algebraMap C (Localization.Away a) c) =
      algebraMap (TensorProduct P R C) (Localization.Away b) (r ⊗ₜ[P] c) := by
    intro r c
    simp only [g, Algebra.TensorProduct.lift_tmul, hg₁, Algebra.ofId_apply]
    rw [IsScalarTower.algebraMap_apply R (TensorProduct P R C) (Localization.Away b), ← map_mul,
      Algebra.TensorProduct.algebraMap_apply, Algebra.TensorProduct.tmul_mul_tmul, mul_one,
      one_mul, Algebra.algebraMap_self, RingHom.id_apply]
  let ψ : TensorProduct P R C →ₐ[R] TensorProduct P R (Localization.Away a) :=
    Algebra.TensorProduct.map (AlgHom.id R R) (IsScalarTower.toAlgHom P C (Localization.Away a))
  have hψ : ∀ (r : R) (c : C), ψ (r ⊗ₜ[P] c) = r ⊗ₜ[P] algebraMap C (Localization.Away a) c :=
    fun r c => rfl
  have hu1 : IsUnit (ψ b) := by
    rw [hb, Algebra.TensorProduct.includeRight_apply, hψ]
    exact IsUnit.map (Algebra.TensorProduct.includeRight :
      Localization.Away a →ₐ[P] TensorProduct P R (Localization.Away a))
      (IsLocalization.Away.algebraMap_isUnit a)
  let f : Localization.Away b →ₐ[R] TensorProduct P R (Localization.Away a) :=
    IsLocalization.Away.liftAlgHom b hu1
  have hf : ∀ t, f (algebraMap (TensorProduct P R C) (Localization.Away b) t) = ψ t := by
    intro t
    simp [f, IsLocalization.Away.liftAlgHom_apply]
  have e1 : g.comp f = AlgHom.id R _ := by
    apply AlgHom.coe_ringHom_injective
    apply IsLocalization.ringHom_ext (Submonoid.powers b)
    apply RingHom.ext
    intro t
    simp only [RingHom.comp_apply, AlgHom.coe_toRingHom, AlgHom.comp_apply, AlgHom.id_apply]
    induction t using TensorProduct.induction_on with
    | zero => simp only [map_zero]
    | tmul r c => rw [hf, hψ, hg]
    | add x y hx hy => simp only [map_add] at hx hy ⊢; rw [hx, hy]
  have e2 : f.comp g = AlgHom.id R _ := by
    apply Algebra.TensorProduct.ext
    · exact Subsingleton.elim _ _
    · apply AlgHom.coe_ringHom_injective
      apply IsLocalization.ringHom_ext (Submonoid.powers a)
      apply RingHom.ext
      intro c
      simp only [RingHom.comp_apply, AlgHom.coe_toRingHom, AlgHom.comp_apply, AlgHom.id_apply,
        AlgHom.coe_restrictScalars', Algebra.TensorProduct.includeRight_apply]
      rw [hg, hf, hψ]
  exact Algebra.Smooth.of_equiv (AlgEquiv.ofAlgHom g f e1 e2)

theorem wc_pfc_pd_span_pow_le : ∀ (Z : Type u) [CommRing Z] (d e : ℕ) (u : Fin d → Z), Ideal.span (Set.range u) ^ (d * e + 1) ≤ Ideal.span (Set.range fun i => u i ^ e) :=
by
  intro Z _ d e u
  classical
  have key : ∀ s : Finset (Fin d),
      Ideal.span (u '' (s : Set (Fin d))) ^ (s.card * e + 1) ≤
        Ideal.span ((fun i => u i ^ e) '' (s : Set (Fin d))) := by
    intro s
    induction s using Finset.induction_on with
    | empty =>
      simp
    | insert a s ha ih =>
      rw [Finset.coe_insert, Set.image_insert_eq, Set.image_insert_eq, Ideal.span_insert,
        Ideal.span_insert, Finset.card_insert_of_notMem ha]
      have hexp : (s.card + 1) * e + 1 = e + (s.card * e + 1) := by ring
      rw [hexp]
      calc (Ideal.span {u a} ⊔ Ideal.span (u '' (s : Set (Fin d)))) ^ (e + (s.card * e + 1))
          ≤ Ideal.span {u a} ^ e ⊔ Ideal.span (u '' (s : Set (Fin d))) ^ (s.card * e + 1) :=
            Ideal.sup_pow_add_le_pow_sup_pow
        _ ≤ Ideal.span {u a ^ e} ⊔ Ideal.span ((fun i => u i ^ e) '' (s : Set (Fin d))) := by
            rw [Ideal.span_singleton_pow]
            exact sup_le_sup le_rfl ih
  have h := key Finset.univ
  rw [Finset.coe_univ, Set.image_univ, Set.image_univ, Finset.card_univ, Fintype.card_fin] at h
  exact h

theorem wc_pfc_pd_quotient_target : ∀ (Λ : Type u) [CommRing Λ] (𝔮 : Ideal Λ) [𝔮.IsPrime] (I : Ideal Λ) (d e n : ℕ) (u : Fin d → Λ), 0 < e → I = Ideal.span (Set.range fun i => u i ^ e) → Ideal.map (algebraMap Λ (Localization.AtPrime 𝔮)) (Ideal.span (Set.range u)) = IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) → d * e + 1 ≤ n → ∃ (_ : (𝔮.map (Ideal.Quotient.mk I)).IsPrime), 𝔮.map (Ideal.Quotient.mk I) ∈ minimalPrimes (Λ ⧸ I) ∧ ∃ ρ : (Localization.AtPrime 𝔮 ⧸ IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) ^ n) →+* Localization.AtPrime (𝔮.map (Ideal.Quotient.mk I)), ∀ x : Λ, ρ (Ideal.Quotient.mk _ (algebraMap Λ _ x)) = algebraMap (Λ ⧸ I) _ (Ideal.Quotient.mk I x) :=
by
  intro Λ _ 𝔮 _ I d e n u he hI hgen hn
  have hmax : ∀ x : Λ, x ∈ 𝔮 ↔ algebraMap Λ (Localization.AtPrime 𝔮) x ∈
      IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) := by
    intro x
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff,
      IsLocalization.AtPrime.isUnit_to_map_iff _ 𝔮 x, Ideal.mem_primeCompl_iff, not_not]
  have hu : ∀ i, u i ∈ 𝔮 := by
    intro i
    rw [hmax, ← hgen]
    exact Ideal.mem_map_of_mem _ (Ideal.subset_span ⟨i, rfl⟩)
  have hI𝔮 : I ≤ 𝔮 := by
    rw [hI, Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    exact Ideal.pow_mem_of_mem 𝔮 (hu i) e he
  have hker : RingHom.ker (Ideal.Quotient.mk I) ≤ 𝔮 := by
    rw [Ideal.mk_ker]; exact hI𝔮
  haveI hprime : (𝔮.map (Ideal.Quotient.mk I)).IsPrime :=
    Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective hker
  have hcomap : Ideal.comap (Ideal.Quotient.mk I) (𝔮.map (Ideal.Quotient.mk I)) = 𝔮 := by
    rw [Ideal.comap_map_of_surjective' _ Ideal.Quotient.mk_surjective, Ideal.mk_ker]
    exact sup_eq_left.mpr hI𝔮
  have hstar : IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) ^ n ≤
      Ideal.map (algebraMap Λ (Localization.AtPrime 𝔮)) I := by
    rw [← hgen, ← Ideal.map_pow]
    apply Ideal.map_mono
    calc Ideal.span (Set.range u) ^ n ≤ Ideal.span (Set.range u) ^ (d * e + 1) :=
          Ideal.pow_le_pow_right hn
      _ ≤ Ideal.span (Set.range fun i => u i ^ e) := wc_pfc_pd_span_pow_le Λ d e u
      _ = I := hI.symm
  refine ⟨hprime, ?_, ?_⟩
  ·
    refine ⟨⟨hprime, bot_le⟩, ?_⟩
    rintro P ⟨hP, _⟩ hPle
    have hP' : (Ideal.comap (Ideal.Quotient.mk I) P).IsPrime := Ideal.IsPrime.comap _
    have hP'le : Ideal.comap (Ideal.Quotient.mk I) P ≤ 𝔮 := by
      rw [← hcomap]; exact Ideal.comap_mono hPle
    have hIP' : I ≤ Ideal.comap (Ideal.Quotient.mk I) P := by
      intro a ha
      rw [Ideal.mem_comap, Ideal.Quotient.eq_zero_iff_mem.mpr ha]
      exact P.zero_mem
    have hdisj : Disjoint (𝔮.primeCompl : Set Λ)
        ((Ideal.comap (Ideal.Quotient.mk I) P : Ideal Λ) : Set Λ) := by
      rw [Set.disjoint_left]
      intro a ha haP
      exact ha (hP'le haP)
    have hunder := IsLocalization.under_map_of_isPrime_disjoint 𝔮.primeCompl
      (Localization.AtPrime 𝔮) hP' hdisj
    have h𝔮P' : 𝔮 ≤ Ideal.comap (Ideal.Quotient.mk I) P := by
      intro x hx
      have h1 : algebraMap Λ (Localization.AtPrime 𝔮) (x ^ n) ∈
          Ideal.map (algebraMap Λ (Localization.AtPrime 𝔮))
            (Ideal.comap (Ideal.Quotient.mk I) P) := by
        rw [map_pow]
        exact Ideal.map_mono hIP' (hstar (Ideal.pow_mem_pow ((hmax x).mp hx) n))
      have h2 : x ^ n ∈ Ideal.comap (Ideal.Quotient.mk I) P := by
        rw [← hunder]; exact h1
      exact hP'.mem_of_pow_mem n h2
    calc 𝔮.map (Ideal.Quotient.mk I) ≤
          (Ideal.comap (Ideal.Quotient.mk I) P).map (Ideal.Quotient.mk I) := Ideal.map_mono h𝔮P'
      _ = P := Ideal.map_comap_of_surjective _ Ideal.Quotient.mk_surjective P
  ·
    let ℓ := Localization.localRingHom 𝔮 (𝔮.map (Ideal.Quotient.mk I)) (Ideal.Quotient.mk I)
      hcomap.symm
    have hℓ : ∀ x : Λ, ℓ (algebraMap Λ _ x) =
        algebraMap (Λ ⧸ I) _ (Ideal.Quotient.mk I x) :=
      fun x => Localization.localRingHom_to_map _ _ _ _ x
    have hcomp : ℓ.comp (algebraMap Λ (Localization.AtPrime 𝔮)) =
        (algebraMap (Λ ⧸ I) (Localization.AtPrime (𝔮.map (Ideal.Quotient.mk I)))).comp
          (Ideal.Quotient.mk I) := RingHom.ext hℓ
    have hkill : ∀ y ∈ IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) ^ n, ℓ y = 0 := by
      intro y hy
      have h1 := Ideal.mem_map_of_mem ℓ (hstar hy)
      rw [Ideal.map_map, hcomp, ← Ideal.map_map, Ideal.map_quotient_self, Ideal.map_bot] at h1
      exact (Ideal.mem_bot).mp h1
    exact ⟨Ideal.Quotient.lift _ ℓ hkill, fun x => by rw [Ideal.Quotient.lift_mk]; exact hℓ x⟩

theorem wc_pfc_pd_coeff_descent : ∀ (B : Type u) [CommRing B] [IsLocalRing B] (D : Type u) [CommRing D] [IsLocalRing D] (n N t : ℕ) (v : D →+* B ⧸ IsLocalRing.maximalIdeal B ^ n), RingHom.Flat v → IsLocalHom v → N ≤ n → ∀ (α : Fin t → B), IsLocalRing.maximalIdeal B ^ N ≤ Ideal.span (Set.range α) → (∀ j, Ideal.Quotient.mk (IsLocalRing.maximalIdeal B ^ n) (α j) ∈ v.range) → ∀ x ∈ IsLocalRing.maximalIdeal B, Ideal.Quotient.mk (IsLocalRing.maximalIdeal B ^ n) x ∈ v.range → ∃ w : Fin t → B, x ^ (2 * N) = ∑ j, w j * α j ∧ ∀ j, Ideal.Quotient.mk (IsLocalRing.maximalIdeal B ^ n) (w j) ∈ v.range :=
by
  intro B _ _ D _ _ n N t v hflat hloc hNn α hα hαr x hx hxr
  classical
  rcases Nat.eq_zero_or_pos n with hn | hn
  · subst hn
    have hN : N = 0 := by omega
    subst hN
    have h1 : (1 : B) ∈ Ideal.span (Set.range α) := hα (by simp)
    obtain ⟨c, hc⟩ := (Ideal.mem_span_range_iff_exists_fun).mp h1
    refine ⟨c, by simp [hc], fun j => ⟨0, ?_⟩⟩
    rw [map_zero, eq_comm, Ideal.Quotient.eq_zero_iff_mem]
    simp
  · have hne : IsLocalRing.maximalIdeal B ^ n ≠ ⊤ := by
      intro h
      apply (IsLocalRing.maximalIdeal.isMaximal B).ne_top
      rw [eq_top_iff, ← h]
      exact Ideal.pow_le_self (by omega)
    haveI : Nontrivial (B ⧸ IsLocalRing.maximalIdeal B ^ n) :=
      Ideal.Quotient.nontrivial_iff.mpr hne
    haveI : IsLocalRing (B ⧸ IsLocalRing.maximalIdeal B ^ n) :=
      IsLocalRing.of_surjective' (Ideal.Quotient.mk _) Ideal.Quotient.mk_surjective
    letI : Algebra D (B ⧸ IsLocalRing.maximalIdeal B ^ n) := v.toAlgebra
    haveI : Module.Flat D (B ⧸ IsLocalRing.maximalIdeal B ^ n) := hflat
    haveI : IsLocalHom (algebraMap D (B ⧸ IsLocalRing.maximalIdeal B ^ n)) := hloc
    haveI : Module.FaithfullyFlat D (B ⧸ IsLocalRing.maximalIdeal B ^ n) :=
      Module.FaithfullyFlat.of_flat_of_isLocalHom
    have hdesc : ∀ (I : Ideal D) (y : D), v y ∈ Ideal.map v I → y ∈ I := by
      intro I y hy
      have := Ideal.comap_map_eq_self_of_faithfullyFlat (B := B ⧸ IsLocalRing.maximalIdeal B ^ n) I
      rw [← this]
      exact hy
    have hxN : x ^ N ∈ Ideal.span (Set.range α) := hα (Ideal.pow_mem_pow hx N)
    obtain ⟨c, hc⟩ := (Ideal.mem_span_range_iff_exists_fun).mp hxN
    choose δ hδ using hαr
    obtain ⟨ξ, hξ⟩ := hxr
    have hmem : v (ξ ^ N) ∈ Ideal.map v (Ideal.span (Set.range δ)) := by
      rw [map_pow, hξ, ← map_pow, ← hc, map_sum]
      refine Ideal.sum_mem _ (fun j _ => ?_)
      rw [map_mul, ← hδ j]
      exact Ideal.mul_mem_left _ _ (Ideal.mem_map_of_mem v (Ideal.subset_span ⟨j, rfl⟩))
    obtain ⟨e, he⟩ := (Ideal.mem_span_range_iff_exists_fun).mp (hdesc _ _ hmem)
    choose w' hw' using fun j =>
      Ideal.Quotient.mk_surjective (I := IsLocalRing.maximalIdeal B ^ n) (v (e j))
    set r := x ^ N - ∑ j, w' j * α j with hr
    have hqr : Ideal.Quotient.mk (IsLocalRing.maximalIdeal B ^ n) r = 0 := by
      have h2 : Ideal.Quotient.mk (IsLocalRing.maximalIdeal B ^ n) (x ^ N) = v (ξ ^ N) := by
        rw [map_pow, map_pow, hξ]
      rw [hr, map_sub, h2, ← he, map_sum, map_sum, sub_eq_zero]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [map_mul, map_mul, hw', hδ]
    refine ⟨fun j => x ^ N * w' j + c j * r, ?_, fun j => ⟨ξ ^ N * e j, ?_⟩⟩
    · have hs : ∑ j, w' j * α j = x ^ N - r := by rw [hr]; ring
      have h3 : ∑ j, (x ^ N * w' j + c j * r) * α j
          = x ^ N * ∑ j, w' j * α j + r * ∑ j, c j * α j := by
        rw [Finset.mul_sum, Finset.mul_sum, ← Finset.sum_add_distrib]
        refine Finset.sum_congr rfl (fun j _ => ?_)
        ring
      rw [h3, hs, hc, two_mul, pow_add]
      ring
    · simp only [map_add, map_mul, map_pow, hqr, mul_zero, add_zero, hξ, hw']

theorem wc_pfc_pd_clear_denominators : ∀ (Λ : Type u) [CommRing Λ] (𝔮 : Ideal Λ) [𝔮.IsPrime] (N t : ℕ) (x : Λ) (α : Fin t → Λ) (w : Fin t → Localization.AtPrime 𝔮), 0 < N → algebraMap Λ (Localization.AtPrime 𝔮) x ^ (2 * N) = ∑ j, w j * algebraMap Λ (Localization.AtPrime 𝔮) (α j) → ∃ (δ : Λ) (lam : Fin t → Λ), δ ∉ 𝔮 ∧ (δ * x) ^ (2 * N) = ∑ j, lam j * α j ∧ ∀ j, algebraMap Λ (Localization.AtPrime 𝔮) (lam j) = algebraMap Λ (Localization.AtPrime 𝔮) δ ^ (2 * N) * w j :=
by
  intro Λ _ 𝔮 _ N t x α w hN hx
  classical
  obtain ⟨b, hb⟩ := IsLocalization.exist_integer_multiples_of_finite 𝔮.primeCompl w
  have hb' : ∀ j, ∃ y : Λ, algebraMap Λ (Localization.AtPrime 𝔮) y = (b : Λ) • w j :=
    fun j => RingHom.mem_rangeS.mp (hb j)
  choose β hβ using hb'
  have hsq : (b : Λ) ∉ 𝔮 := b.2
  have key : algebraMap Λ (Localization.AtPrime 𝔮) ((b : Λ) * x ^ (2 * N)) =
      algebraMap Λ (Localization.AtPrime 𝔮) (∑ j, β j * α j) := by
    rw [map_mul, map_pow, hx, map_sum, Finset.mul_sum]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    rw [map_mul, hβ j, Algebra.smul_def]
    ring
  obtain ⟨c', hc'⟩ := IsLocalization.exists_of_eq (M := 𝔮.primeCompl) key
  have hcq : (c' : Λ) ∉ 𝔮 := c'.2
  obtain ⟨M, hM⟩ : ∃ M, 2 * N = M + 1 := ⟨2 * N - 1, by omega⟩
  refine ⟨(c' : Λ) * (b : Λ), fun j => ((c' : Λ) * (b : Λ)) ^ M * (c' : Λ) * β j, ?_, ?_, ?_⟩
  · intro h
    rcases Ideal.IsPrime.mem_or_mem ‹𝔮.IsPrime› h with h | h
    · exact hcq h
    · exact hsq h
  · rw [hM] at hc' ⊢
    calc ((c' : Λ) * (b : Λ) * x) ^ (M + 1)
        = ((c' : Λ) * (b : Λ)) ^ M * ((c' : Λ) * ((b : Λ) * x ^ (M + 1))) := by ring
      _ = ((c' : Λ) * (b : Λ)) ^ M * ((c' : Λ) * ∑ j, β j * α j) := by rw [hc']
      _ = ∑ j, ((c' : Λ) * (b : Λ)) ^ M * (c' : Λ) * β j * α j := by
        rw [Finset.mul_sum, Finset.mul_sum]
        refine Finset.sum_congr rfl (fun j _ => ?_)
        ring
  · intro j
    rw [hM]
    simp only [map_mul, map_pow, hβ j, Algebra.smul_def]
    ring

theorem wc_pfc_pd_ogoma_multiplier : ∀ (Λ : Type u) [CommRing Λ] [IsNoetherianRing Λ] (𝔮 : Ideal Λ) [𝔮.IsPrime] (J : Ideal Λ) (x : Λ), (∀ y : Λ, x ^ 2 * y ∈ J → ∃ σ : Λ, σ ∉ 𝔮 ∧ σ * x * y ∈ J) → ∃ s : Λ, s ∉ 𝔮 ∧ ∀ y : Λ, (s * x) ^ 2 * y ∈ J → s * x * y ∈ J :=
by
  intro Λ _ _ 𝔮 _ J x hx
  classical
  let L : Λ → Ideal Λ := fun t => Submodule.comap (LinearMap.mulLeft Λ (t * x)) J
  have hL : ∀ t y, y ∈ L t ↔ t * x * y ∈ J := fun t y => by
    simp only [L, Submodule.mem_comap, LinearMap.mulLeft_apply]
  have h1 : (1 : Λ) ∉ 𝔮 := fun h => (Ideal.IsPrime.ne_top ‹𝔮.IsPrime›) ((Ideal.eq_top_iff_one _).mpr h)
  have hN : IsNoetherian Λ Λ := inferInstance
  obtain ⟨I₀, ⟨t₀, ht₀, hI₀⟩, hmax⟩ := set_has_maximal_iff_noetherian.mpr hN
    {I : Submodule Λ Λ | ∃ t, t ∉ 𝔮 ∧ I = L t} ⟨L 1, 1, h1, rfl⟩
  subst hI₀
  have hS : ∀ t' : Λ, t' ∉ 𝔮 → ∀ y, t₀ * t' * x * y ∈ J → t₀ * x * y ∈ J := by
    intro t' ht' y hy
    have hle : L t₀ ≤ L (t₀ * t') := by
      intro z hz
      rw [hL] at hz ⊢
      have := J.mul_mem_left t' hz
      have e : t₀ * t' * x * z = t' * (t₀ * x * z) := by ring
      rw [e]; exact this
    have hmem : L (t₀ * t') ∈ {I : Submodule Λ Λ | ∃ t, t ∉ 𝔮 ∧ I = L t} :=
      ⟨t₀ * t', Ideal.IsPrime.mul_notMem ‹𝔮.IsPrime› ht₀ ht', rfl⟩
    have heq : L t₀ = L (t₀ * t') := hle.lt_or_eq.resolve_left (hmax _ hmem)
    have hy' : y ∈ L (t₀ * t') := (hL _ _).mpr hy
    rw [← heq] at hy'
    exact (hL _ _).mp hy'
  refine ⟨t₀, ht₀, fun y hy => ?_⟩
  have e1 : (t₀ * x) ^ 2 * y = x ^ 2 * (t₀ ^ 2 * y) := by ring
  rw [e1] at hy
  obtain ⟨σ, hσ, hσJ⟩ := hx _ hy
  apply hS (t₀ * σ) (Ideal.IsPrime.mul_notMem ‹𝔮.IsPrime› ht₀ hσ) y
  have e2 : t₀ * (t₀ * σ) * x * y = σ * x * (t₀ ^ 2 * y) := by ring
  rw [e2]; exact hσJ

theorem wc_pfc_pd_regseq_localized : ∀ (Λ : Type u) [CommRing Λ] (𝔮 : Ideal Λ) [𝔮.IsPrime] [IsRegularLocalRing (Localization.AtPrime 𝔮)] (d e : ℕ) (u δ : Fin d → Λ), Submodule.spanFinrank (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮)) = d → Ideal.map (algebraMap Λ (Localization.AtPrime 𝔮)) (Ideal.span (Set.range u)) = IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) → (∀ j, δ j ∉ 𝔮) → ∀ (i : Fin d) (y : Λ), u i * y ∈ Ideal.span ((fun j => (δ j * u j) ^ e) '' {j | j < i}) → ∃ σ : Λ, σ ∉ 𝔮 ∧ σ * y ∈ Ideal.span ((fun j => (δ j * u j) ^ e) '' {j | j < i}) :=
by
  intro Λ _ 𝔮 _ _ d e u δ hd hu hδ i y hy
  classical

  have hU : ∀ j, IsUnit (algebraMap Λ (Localization.AtPrime 𝔮) (δ j)) := fun j =>
    IsLocalization.map_units (Localization.AtPrime 𝔮) (⟨δ j, hδ j⟩ : 𝔮.primeCompl)
  let x : Fin d → Localization.AtPrime 𝔮 := fun j => algebraMap Λ (Localization.AtPrime 𝔮) (δ j * u j)
  have hu' : Ideal.span (Set.range (fun j => algebraMap Λ (Localization.AtPrime 𝔮) (u j))) =
      IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) := by
    rw [← hu, Ideal.map_span, ← Set.range_comp]
    rfl
  have hx : Ideal.span (Set.range x) = IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) := by
    rw [← hu']
    apply le_antisymm
    · rw [Ideal.span_le]
      rintro _ ⟨j, rfl⟩
      show algebraMap Λ (Localization.AtPrime 𝔮) (δ j * u j) ∈ _
      rw [map_mul]
      exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨j, rfl⟩)
    · rw [Ideal.span_le]
      rintro _ ⟨j, rfl⟩
      refine (Ideal.unit_mul_mem_iff_mem _ (hU j)).mp ?_
      rw [← map_mul]
      exact Ideal.subset_span ⟨j, rfl⟩

  have H : ∀ (T : Set (Fin d)) (t : Fin d), t ∉ T → ∀ y' : Localization.AtPrime 𝔮,
      x t * y' ∈ Ideal.span (x '' T) → y' ∈ Ideal.span (x '' T) := by
    intro T t ht y' hy'
    let A : Finset (Localization.AtPrime 𝔮) := Finset.image x (Finset.univ.filter (· ∈ T))
    let B : Finset (Localization.AtPrime 𝔮) := Finset.image x (Finset.univ.filter (· ∉ T))
    have hA : (A : Set (Localization.AtPrime 𝔮)) = x '' T := by
      ext z; simp [A]
    have hAB : (A : Set (Localization.AtPrime 𝔮)) ∪ (B : Set _) = Set.range x := by
      ext z
      simp only [A, B, Finset.coe_image, Finset.coe_filter, Finset.mem_univ, true_and,
        Set.mem_union, Set.mem_image, Set.mem_setOf_eq, Set.mem_range]
      constructor
      · rintro (⟨j, _, rfl⟩ | ⟨j, _, rfl⟩) <;> exact ⟨j, rfl⟩
      · rintro ⟨j, rfl⟩
        by_cases hj : j ∈ T
        · exact Or.inl ⟨j, hj, rfl⟩
        · exact Or.inr ⟨j, hj, rfl⟩
    have hcard : A.card + B.card ≤
        Submodule.spanFinrank (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮)) := by
      rw [hd]
      calc A.card + B.card ≤ (Finset.univ.filter (· ∈ T)).card +
            (Finset.univ.filter (fun j : Fin d => ¬ (j ∈ T))).card :=
            Nat.add_le_add Finset.card_image_le Finset.card_image_le
        _ = d := by
            rw [Finset.card_filter_add_card_filter_not, Finset.card_univ, Fintype.card_fin]
    obtain ⟨hreg, -, hB⟩ := wc_ogp_quotient_regular (Localization.AtPrime 𝔮) A B
      (by rw [hAB]; exact hx) hcard
    have htB : x t ∈ B := Finset.mem_image.mpr ⟨t, by simp [ht], rfl⟩
    have hxt := hB (x t) htB
    haveI := hreg
    haveI := wcpa_regular_isDomain
      (Localization.AtPrime 𝔮 ⧸ Ideal.span (A : Set (Localization.AtPrime 𝔮)))
      wcpa_rs_quotient_regular hreg
    rw [← hA] at hy' ⊢
    have h0 : Ideal.Quotient.mk (Ideal.span (A : Set (Localization.AtPrime 𝔮))) (x t) *
        Ideal.Quotient.mk (Ideal.span (A : Set (Localization.AtPrime 𝔮))) y' = 0 := by
      rw [← map_mul, Ideal.Quotient.eq_zero_iff_mem]; exact hy'
    rcases mul_eq_zero.mp h0 with h | h
    · exact absurd (Ideal.Quotient.eq_zero_iff_mem.mp h) hxt
    · exact Ideal.Quotient.eq_zero_iff_mem.mp h

  have hmap : Ideal.map (algebraMap Λ (Localization.AtPrime 𝔮))
      (Ideal.span ((fun j => (δ j * u j) ^ e) '' {j | j < i})) =
      Ideal.span ((fun j => x j ^ e) '' {j | j < i}) := by
    rw [Ideal.map_span, Set.image_image]
    simp only [map_pow, x]

  have hy' := Ideal.mem_map_of_mem (algebraMap Λ (Localization.AtPrime 𝔮)) hy
  rw [hmap] at hy'
  have h1 : x i * algebraMap Λ (Localization.AtPrime 𝔮) y ∈
      Ideal.span ((fun j => x j ^ e) '' {j | j < i}) := by
    have e1 : x i * algebraMap Λ (Localization.AtPrime 𝔮) y =
        algebraMap Λ (Localization.AtPrime 𝔮) (δ i) *
          algebraMap Λ (Localization.AtPrime 𝔮) (u i * y) := by
      simp only [x, map_mul]; ring
    rw [e1]
    exact Ideal.mul_mem_left _ _ hy'
  have h2 := wc_ogp_regseq_pow (Localization.AtPrime 𝔮) d x H e i _ h1
  rw [← hmap] at h2

  obtain ⟨m, hm, hmy⟩ := (IsLocalization.algebraMap_mem_map_algebraMap_iff 𝔮.primeCompl
    (Localization.AtPrime 𝔮) _ y).mp h2
  exact ⟨m, hm, hmy⟩

theorem wc_pfc_pd_fibre_lift_ratio : ∀ (k : Type u) [Field k] (Λ : Type u) [CommRing Λ] [Algebra k Λ] (𝔮 : Ideal Λ) [𝔮.IsPrime] (m n d t N : ℕ) (φ' : MvPolynomial (Fin m) k →ₐ[k] Λ) (S : Type u) [CommRing S] [iS : Algebra (Localization.AtPrime (𝔮.comap φ'.toRingHom) ⧸ IsLocalRing.maximalIdeal (Localization.AtPrime (𝔮.comap φ'.toRingHom)) ^ n) S] (𝔪 : Ideal S) [𝔪.IsPrime] (v : Localization.AtPrime 𝔪 →+* Localization.AtPrime 𝔮 ⧸ IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) ^ n), RingHom.Flat v → IsLocalHom v → (∀ x : Localization.AtPrime (𝔮.comap φ'.toRingHom), v (algebraMap S (Localization.AtPrime 𝔪) (@algebraMap _ _ _ _ iS (Ideal.Quotient.mk (IsLocalRing.maximalIdeal (Localization.AtPrime (𝔮.comap φ'.toRingHom)) ^ n) x))) = Ideal.Quotient.mk (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) ^ n) (Localization.localRingHom (𝔮.comap φ'.toRingHom) 𝔮 φ'.toRingHom rfl x)) → ∀ (π : Fin d → MvPolynomial (Fin m) k) (δ : Fin d → Λ) (A : Type u) [CommRing A] [Algebra k A] (φ : A →ₐ[k] Λ) (s : Finset A) (a : Fin t → A) (lam : Fin d → Fin t → Λ), Algebra.adjoin k (s : Set A) = ⊤ → (∀ x ∈ s, Ideal.Quotient.mk (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) ^ n) (algebraMap Λ (Localization.AtPrime 𝔮) (φ x)) ∈ v.range) → (∀ i, δ i ∉ 𝔮) → ∀ (l' : Fin d → Fin t → Localization.AtPrime 𝔪), (∀ i j, v (l' i j) * Ideal.Quotient.mk (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) ^ n) (algebraMap Λ (Localization.AtPrime 𝔮) (δ i)) ^ (2 * N) = Ideal.Quotient.mk (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) ^ n) (algebraMap Λ (Localization.AtPrime 𝔮) (lam i j))) → (∀ i, (δ i * φ' (π i)) ^ (2 * N) = ∑ j, lam i j * φ (a j)) → ∀ (C : Type u) [CommRing C] [Algebra (MvPolynomial (Fin d) k) C] [Algebra k C] [IsScalarTower k (MvPolynomial (Fin d) k) C] (ι : A →ₐ[k] C), (∀ (Λ' : Type u) [CommRing Λ'] [Algebra k Λ'] [Algebra (MvPolynomial (Fin d) k) Λ'] [IsScalarTower k (MvPolynomial (Fin d) k) Λ'] (φ₁ : A →ₐ[k] Λ') (μ : Fin d → Fin t → Λ'), (∀ i, algebraMap (MvPolynomial (Fin d) k) Λ' (MvPolynomial.X i) ^ (2 * N) = ∑ j, μ i j * φ₁ (a j)) → ∃ χ : C →ₐ[MvPolynomial (Fin d) k] Λ', ∀ x, χ (ι x) = φ₁ x) → ∃ (χΛ : C →ₐ[k] Λ) (χD : C →+* MvPolynomial (Fin d) (Localization.AtPrime 𝔪)), (∀ x, χΛ (ι x) = φ x) ∧ (∀ i, χΛ (algebraMap (MvPolynomial (Fin d) k) C (MvPolynomial.X i)) = δ i * φ' (π i)) ∧ (∀ i, χD (algebraMap (MvPolynomial (Fin d) k) C (MvPolynomial.X i)) = MvPolynomial.C (algebraMap S (Localization.AtPrime 𝔪) (@algebraMap _ _ _ _ iS (Ideal.Quotient.mk (IsLocalRing.maximalIdeal (Localization.AtPrime (𝔮.comap φ'.toRingHom)) ^ n) (algebraMap (MvPolynomial (Fin m) k) (Localization.AtPrime (𝔮.comap φ'.toRingHom)) (π i))))) * MvPolynomial.X i) ∧ (∀ c : k, χD (algebraMap k C c) = MvPolynomial.C (algebraMap S (Localization.AtPrime 𝔪) (@algebraMap _ _ _ _ iS (Ideal.Quotient.mk (IsLocalRing.maximalIdeal (Localization.AtPrime (𝔮.comap φ'.toRingHom)) ^ n) (algebraMap (MvPolynomial (Fin m) k) (Localization.AtPrime (𝔮.comap φ'.toRingHom)) (MvPolynomial.C c)))))) ∧ ∀ x, MvPolynomial.eval₂ v (fun i => Ideal.Quotient.mk (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) ^ n) (algebraMap Λ (Localization.AtPrime 𝔮) (δ i))) (χD x) = Ideal.Quotient.mk (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) ^ n) (algebraMap Λ (Localization.AtPrime 𝔮) (χΛ x)) :=
by
  intro k _ Λ _ _ 𝔮 _ m n d t N φ' S _ iS 𝔪 _ v hvflat hvloc hvcomp π δ A _ _ φ s a lam hadj hs hδ l' hl' hrel C _ _ _ _ ι huniv
  classical

  have s1 : ∀ (R : Type u) [CommRing R] [IsLocalRing R] (L : Type u) [CommRing L] [IsLocalRing L]
      (I : Ideal L) (f : R →+* L ⧸ I), RingHom.Flat f → IsLocalHom f → Function.Injective f := by
    intro R _ _ L _ _ I f hf hloc
    haveI := hloc
    haveI : Nontrivial (L ⧸ I) := by
      by_contra hnt
      rw [not_nontrivial_iff_subsingleton] at hnt
      exact not_isUnit_zero (isUnit_of_map_unit f 0 (isUnit_of_subsingleton _))
    haveI : IsLocalRing (L ⧸ I) :=
      IsLocalRing.of_surjective' (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective
    letI := f.toAlgebra
    haveI : Module.Flat R (L ⧸ I) := hf
    haveI : IsLocalHom (algebraMap R (L ⧸ I)) := hloc
    haveI : Module.FaithfullyFlat R (L ⧸ I) := Module.FaithfullyFlat.of_flat_of_isLocalHom
    have h := Ideal.comap_map_eq_self_of_faithfullyFlat (A := R) (B := L ⧸ I) ⊥
    rw [Ideal.map_bot] at h
    rw [RingHom.injective_iff_ker_eq_bot, RingHom.ker_eq_comap_bot]
    exact h

  have core : ∀ (k : Type u) [Field k] (m d t N : ℕ) (Λ : Type u) [CommRing Λ] [Algebra k Λ] (Z : Type u) [CommRing Z] (pr : Λ →+* Z) (D : Type u) [CommRing D] (v : D →+* Z), Function.Injective v → ∀ (φ' : MvPolynomial (Fin m) k →ₐ[k] Λ) (σ : MvPolynomial (Fin m) k →+* D), (∀ q, v (σ q) = pr (φ' q)) → ∀ (π : Fin d → MvPolynomial (Fin m) k) (δ : Fin d → Λ) (A : Type u) [CommRing A] [Algebra k A] (φ : A →ₐ[k] Λ) (φD : A →+* D) (a : Fin t → A) (lam : Fin d → Fin t → Λ) (l' : Fin d → Fin t → D), (∀ x, v (φD x) = pr (φ x)) → (∀ i, IsUnit (pr (δ i))) → (∀ i j, v (l' i j) * pr (δ i) ^ (2 * N) = pr (lam i j)) → (∀ i, (δ i * φ' (π i)) ^ (2 * N) = ∑ j, lam i j * φ (a j)) → ∀ (C : Type u) [CommRing C] [Algebra (MvPolynomial (Fin d) k) C] [Algebra k C] [IsScalarTower k (MvPolynomial (Fin d) k) C] (ι : A →ₐ[k] C), (∀ (Λ' : Type u) [CommRing Λ'] [Algebra k Λ'] [Algebra (MvPolynomial (Fin d) k) Λ'] [IsScalarTower k (MvPolynomial (Fin d) k) Λ'] (φ₁ : A →ₐ[k] Λ') (μ : Fin d → Fin t → Λ'), (∀ i, algebraMap (MvPolynomial (Fin d) k) Λ' (MvPolynomial.X i) ^ (2 * N) = ∑ j, μ i j * φ₁ (a j)) → ∃ χ : C →ₐ[MvPolynomial (Fin d) k] Λ', ∀ x, χ (ι x) = φ₁ x) → ∃ (χΛ : C →ₐ[k] Λ) (χD : C →+* MvPolynomial (Fin d) D), (∀ x, χΛ (ι x) = φ x) ∧ (∀ i, χΛ (algebraMap (MvPolynomial (Fin d) k) C (MvPolynomial.X i)) = δ i * φ' (π i)) ∧ (∀ i, χD (algebraMap (MvPolynomial (Fin d) k) C (MvPolynomial.X i)) = MvPolynomial.C (σ (π i)) * MvPolynomial.X i) ∧ (∀ c : k, χD (algebraMap k C c) = MvPolynomial.C (σ (MvPolynomial.C c))) ∧ ∀ x, MvPolynomial.eval₂ v (fun i => pr (δ i)) (χD x) = pr (χΛ x) := by
    intro k _ m d t N Λ _ _ Z _ pr D _ v hv φ' σ hσ π δ A _ _ φ φD a lam l' hφD hunit hl' hrel C _ _ _ _ ι huniv
    obtain ⟨ev, hevC, hevX, hevdef⟩ : ∃ ev : MvPolynomial (Fin d) D →+* Z,
        (∀ y, ev (MvPolynomial.C y) = v y) ∧ (∀ i, ev (MvPolynomial.X i) = pr (δ i)) ∧
        ∀ f, ev f = MvPolynomial.eval₂ v (fun i => pr (δ i)) f :=
      ⟨MvPolynomial.eval₂Hom v (fun i => pr (δ i)), fun y => MvPolynomial.eval₂Hom_C _ _ _,
        fun i => MvPolynomial.eval₂Hom_X' _ _ _, fun _ => rfl⟩
    have hk : ∀ c : k, v (σ (MvPolynomial.C c)) = pr (algebraMap k Λ c) := by
      intro c
      rw [hσ, ← MvPolynomial.algebraMap_eq, AlgHom.commutes]
    have hA2 : ∀ c : k, φD (algebraMap k A c) = σ (MvPolynomial.C c) := by
      intro c
      apply hv
      rw [hφD, AlgHom.commutes, hk]
    have hA4 : ∀ i, σ (π i) ^ (2 * N) = ∑ j, l' i j * φD (a j) := by
      intro i
      apply hv
      apply ((hunit i).pow (2 * N)).mul_left_cancel
      rw [map_pow, hσ, ← mul_pow, ← map_mul, ← map_pow, hrel i, map_sum, map_sum, Finset.mul_sum]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      simp only [map_mul]
      rw [hφD, ← hl' i j]
      ring
    obtain ⟨W, hW⟩ : ∃ W : Subring (Λ × MvPolynomial (Fin d) D),
        ∀ z, z ∈ W ↔ pr z.1 = ev z.2 :=
      ⟨RingHom.eqLocus (pr.comp (RingHom.fst Λ (MvPolynomial (Fin d) D)))
        (ev.comp (RingHom.snd Λ (MvPolynomial (Fin d) D))), fun z => RingHom.mem_eqLocus⟩
    obtain ⟨κ, hκ⟩ : ∃ κ : k →+* W, ∀ c, (κ c : Λ × MvPolynomial (Fin d) D) =
        (algebraMap k Λ c, MvPolynomial.C (σ (MvPolynomial.C c))) :=
      ⟨((algebraMap k Λ).prod ((MvPolynomial.C : D →+* MvPolynomial (Fin d) D).comp
        (σ.comp MvPolynomial.C))).codRestrict W
        (fun c => (hW _).mpr (by
          show pr (algebraMap k Λ c) = ev (MvPolynomial.C (σ (MvPolynomial.C c)))
          rw [hevC, hk])), fun c => rfl⟩
    obtain ⟨w, hw⟩ : ∃ w : Fin d → W, ∀ i, (w i : Λ × MvPolynomial (Fin d) D) =
        (δ i * φ' (π i), MvPolynomial.C (σ (π i)) * MvPolynomial.X i) :=
      ⟨fun i => ⟨(δ i * φ' (π i), MvPolynomial.C (σ (π i)) * MvPolynomial.X i), (hW _).mpr (by
        show pr (δ i * φ' (π i)) = ev (MvPolynomial.C (σ (π i)) * MvPolynomial.X i)
        rw [map_mul, map_mul, hevC, hevX, hσ]
        exact mul_comm _ _)⟩, fun i => rfl⟩
    obtain ⟨φ₁n, hφ₁n⟩ : ∃ f : A →+* W, ∀ x, (f x : Λ × MvPolynomial (Fin d) D) =
        (φ x, MvPolynomial.C (φD x)) :=
      ⟨(φ.toRingHom.prod ((MvPolynomial.C : D →+* MvPolynomial (Fin d) D).comp φD)).codRestrict W
        (fun x => (hW _).mpr (by
          show pr (φ x) = ev (MvPolynomial.C (φD x))
          rw [hevC, hφD])), fun x => rfl⟩
    obtain ⟨μ, hμ⟩ : ∃ μ : Fin d → Fin t → W, ∀ i j, (μ i j : Λ × MvPolynomial (Fin d) D) =
        (lam i j, MvPolynomial.C (l' i j) * MvPolynomial.X i ^ (2 * N)) :=
      ⟨fun i j => ⟨(lam i j, MvPolynomial.C (l' i j) * MvPolynomial.X i ^ (2 * N)),
        (hW _).mpr (by
          show pr (lam i j) = ev (MvPolynomial.C (l' i j) * MvPolynomial.X i ^ (2 * N))
          rw [map_mul, map_pow, hevC, hevX]
          exact (hl' i j).symm)⟩, fun i j => rfl⟩
    letI : Algebra k W := κ.toAlgebra
    letI : Algebra (MvPolynomial (Fin d) k) W := (MvPolynomial.eval₂Hom κ w).toAlgebra
    haveI : IsScalarTower k (MvPolynomial (Fin d) k) W := IsScalarTower.of_algebraMap_eq (fun c => by
      show κ c = MvPolynomial.eval₂Hom κ w (algebraMap k (MvPolynomial (Fin d) k) c)
      rw [MvPolynomial.algebraMap_eq, MvPolynomial.eval₂Hom_C])
    have hXW : ∀ i, algebraMap (MvPolynomial (Fin d) k) W (MvPolynomial.X i) = w i :=
      fun i => MvPolynomial.eval₂Hom_X' _ _ _
    obtain ⟨φ₁, hφ₁⟩ : ∃ φ₁ : A →ₐ[k] W, ∀ x, (φ₁ x : Λ × MvPolynomial (Fin d) D) =
        (φ x, MvPolynomial.C (φD x)) :=
      ⟨AlgHom.mk φ₁n (fun c => by
        apply Subtype.ext
        show (φ₁n (algebraMap k A c) : Λ × MvPolynomial (Fin d) D) = (κ c : Λ × MvPolynomial (Fin d) D)
        rw [hφ₁n, hκ, AlgHom.commutes, hA2]), hφ₁n⟩
    have hrelW : ∀ i, algebraMap (MvPolynomial (Fin d) k) W (MvPolynomial.X i) ^ (2 * N) =
        ∑ j, μ i j * φ₁ (a j) := by
      intro i
      rw [hXW]
      apply Subtype.ext
      simp only [SubmonoidClass.coe_pow, AddSubmonoidClass.coe_finset_sum, MulMemClass.coe_mul,
        hw, hμ, hφ₁]
      refine Prod.ext ?_ ?_
      · simp only [Prod.pow_fst, Prod.fst_sum, Prod.fst_mul]
        exact hrel i
      · simp only [Prod.pow_snd, Prod.snd_sum, Prod.snd_mul]
        rw [mul_pow, ← map_pow, hA4 i, map_sum, Finset.sum_mul]
        refine Finset.sum_congr rfl (fun j _ => ?_)
        simp only [map_mul]
        ring
    obtain ⟨χ, hχ⟩ := huniv (↥W) φ₁ μ hrelW
    have hχc : ∀ c : k, ((χ (algebraMap k C c) : W) : Λ × MvPolynomial (Fin d) D) =
        (algebraMap k Λ c, MvPolynomial.C (σ (MvPolynomial.C c))) := by
      intro c
      rw [IsScalarTower.algebraMap_apply k (MvPolynomial (Fin d) k) C, AlgHom.commutes,
        ← IsScalarTower.algebraMap_apply k (MvPolynomial (Fin d) k) W]
      exact hκ c
    let χD : C →+* MvPolynomial (Fin d) D :=
      (RingHom.snd Λ (MvPolynomial (Fin d) D)).comp (W.subtype.comp χ.toRingHom)
    let χΛ : C →ₐ[k] Λ :=
      AlgHom.mk ((RingHom.fst Λ (MvPolynomial (Fin d) D)).comp (W.subtype.comp χ.toRingHom))
        (fun c => congrArg Prod.fst (hχc c))
    refine ⟨χΛ, χD, ?_, ?_, ?_, ?_, ?_⟩
    · intro x
      show ((χ (ι x) : W) : Λ × MvPolynomial (Fin d) D).1 = φ x
      rw [hχ x, hφ₁]
    · intro i
      show ((χ (algebraMap (MvPolynomial (Fin d) k) C (MvPolynomial.X i)) : W) :
        Λ × MvPolynomial (Fin d) D).1 = δ i * φ' (π i)
      rw [AlgHom.commutes, hXW, hw]
    · intro i
      show ((χ (algebraMap (MvPolynomial (Fin d) k) C (MvPolynomial.X i)) : W) :
        Λ × MvPolynomial (Fin d) D).2 = MvPolynomial.C (σ (π i)) * MvPolynomial.X i
      rw [AlgHom.commutes, hXW, hw]
    · intro c
      show ((χ (algebraMap k C c) : W) : Λ × MvPolynomial (Fin d) D).2 = _
      rw [hχc]
    · intro x
      have h := (hW _).mp (χ x).2
      rw [hevdef] at h
      exact h.symm

  let pr : Λ →+* (Localization.AtPrime 𝔮 ⧸ IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) ^ n) :=
    (Ideal.Quotient.mk _).comp (algebraMap Λ (Localization.AtPrime 𝔮))
  let σ : MvPolynomial (Fin m) k →+* Localization.AtPrime 𝔪 :=
    (algebraMap S (Localization.AtPrime 𝔪)).comp ((@algebraMap _ _ _ _ iS).comp
      ((Ideal.Quotient.mk (IsLocalRing.maximalIdeal (Localization.AtPrime (𝔮.comap φ'.toRingHom)) ^ n)).comp
        (algebraMap (MvPolynomial (Fin m) k) (Localization.AtPrime (𝔮.comap φ'.toRingHom)))))
  have hvinj : Function.Injective v := s1 _ _ _ v hvflat hvloc
  have hσ : ∀ q, v (σ q) = pr (φ' q) := by
    intro q
    have h := hvcomp (algebraMap (MvPolynomial (Fin m) k) _ q)
    rw [Localization.localRingHom_to_map] at h
    exact h

  have hrange : ∀ x, pr (φ x) ∈ v.range := by
    intro x
    have hx : x ∈ Algebra.adjoin k (s : Set A) := by rw [hadj]; trivial
    induction hx using Algebra.adjoin_induction with
    | mem y hy => exact hs y hy
    | algebraMap c =>
      refine ⟨σ (MvPolynomial.C c), ?_⟩
      rw [hσ, ← MvPolynomial.algebraMap_eq, AlgHom.commutes, AlgHom.commutes]
    | add y z _ _ hy hz => rw [map_add, map_add]; exact v.range.add_mem hy hz
    | mul y z _ _ hy hz => rw [map_mul, map_mul]; exact v.range.mul_mem hy hz

  obtain ⟨φD, hφD⟩ : ∃ g' : A →+* Localization.AtPrime 𝔪, ∀ x, v (g' x) = pr (φ x) := by
    let e := RingEquiv.ofBijective v.rangeRestrict
      ⟨fun x y h => hvinj (congrArg Subtype.val h), v.rangeRestrict_surjective⟩
    refine ⟨e.symm.toRingHom.comp ((pr.comp φ.toRingHom).codRestrict v.range hrange), fun x => ?_⟩
    have := e.apply_symm_apply ((pr.comp φ.toRingHom).codRestrict v.range hrange x)
    exact congrArg Subtype.val this

  have hδu : ∀ i, IsUnit (pr (δ i)) := fun i =>
    ((IsLocalization.AtPrime.isUnit_to_map_iff (Localization.AtPrime 𝔮) 𝔮 (δ i)).mpr
      (hδ i)).map (Ideal.Quotient.mk _)
  obtain ⟨χΛ, χD, h1, h2, h3, h4, h5⟩ := core k m d t N Λ _ pr (Localization.AtPrime 𝔪) v hvinj
    φ' σ hσ π δ A φ φD a lam l' hφD hδu hl' hrel C ι huniv
  exact ⟨χΛ, χD, h1, h2, h3, h4, h5⟩

theorem wc_pfc_pd_twist_loop : ∀ (Λ : Type u) [CommRing Λ] (𝔮 : Ideal Λ) [𝔮.IsPrime] (d t : ℕ) (P : Fin d → (Fin d → Λ) → Λ → (Fin t → Λ) → Prop), (∀ (i : Fin d) (δ δ' : Fin d → Λ) (x : Λ) (l : Fin t → Λ), (∀ j, j < i → δ j = δ' j) → P i δ x l → P i δ' x l) → (∀ (i : Fin d) (δ : Fin d → Λ), (∀ j, δ j ∉ 𝔮) → ∃ (x : Λ) (l : Fin t → Λ), x ∉ 𝔮 ∧ P i δ x l) → ∃ (δ : Fin d → Λ) (lam : Fin d → Fin t → Λ), (∀ i, δ i ∉ 𝔮) ∧ ∀ i, P i δ (δ i) (lam i) :=
by
  intro Λ _ 𝔮 _ d t P hloc hex
  classical
  have key : ∀ k : ℕ, k ≤ d → ∃ (δ : Fin d → Λ) (lam : Fin d → Fin t → Λ),
      (∀ j, δ j ∉ 𝔮) ∧ ∀ i : Fin d, (i : ℕ) < k → P i δ (δ i) (lam i) := by
    intro k
    induction k with
    | zero =>
      intro _
      exact ⟨fun _ => 1, fun _ _ => 0, fun _ => Ideal.IsPrime.one_notMem ‹_›,
        fun i hi => absurd hi (Nat.not_lt_zero _)⟩
    | succ k ih =>
      intro hk
      obtain ⟨δ, lam, hδ, hP⟩ := ih (by omega)
      have hkd : k < d := by omega
      obtain ⟨x, l, hx, hPx⟩ := hex ⟨k, hkd⟩ δ hδ
      have hagree : ∀ i : Fin d, (i : ℕ) ≤ k → ∀ j, j < i →
          δ j = Function.update δ ⟨k, hkd⟩ x j := by
        intro i hi j hj
        have hne : j ≠ ⟨k, hkd⟩ := by
          intro h
          have h1 : (j : ℕ) = k := congrArg Fin.val h
          have h2 : (j : ℕ) < i := hj
          omega
        rw [Function.update_of_ne hne]
      refine ⟨Function.update δ ⟨k, hkd⟩ x, Function.update lam ⟨k, hkd⟩ l, ?_, ?_⟩
      · intro j
        by_cases h : j = ⟨k, hkd⟩
        · rw [h, Function.update_self]; exact hx
        · rw [Function.update_of_ne h]; exact hδ j
      · intro i hi
        by_cases h : (i : ℕ) = k
        · have hii : i = ⟨k, hkd⟩ := Fin.ext h
          rw [hii, Function.update_self, Function.update_self]
          exact hloc _ δ _ x l (hagree _ le_rfl) hPx
        · have hne : i ≠ ⟨k, hkd⟩ := fun e => h (congrArg Fin.val e)
          rw [Function.update_of_ne hne, Function.update_of_ne hne]
          exact hloc i δ _ _ _ (hagree i (by omega)) (hP i (by omega))
  obtain ⟨δ, lam, hδ, hP⟩ := key d le_rfl
  exact ⟨δ, lam, hδ, fun i => hP i i.isLt⟩

theorem wc_pfc_pd_spread_localization : ∀ (Q₀ : Type u) [CommRing Q₀] (F : Type u) [CommRing F] [Algebra Q₀ F] [Algebra.FinitePresentation Q₀ F] (R₁ : Type u) [CommRing R₁] [Algebra Q₀ R₁] (M : Submonoid R₁) (L : Type u) [CommRing L] [Algebra R₁ L] [IsLocalization M L] [Algebra Q₀ L] [IsScalarTower Q₀ R₁ L] (f : F →ₐ[Q₀] L), ∃ s ∈ M, ∃ (f' : F →ₐ[Q₀] Localization.Away s) (j : Localization.Away s →ₐ[R₁] L), (j.restrictScalars Q₀).comp f' = f :=
by
  intro Q₀ _ F _ _ _ R₁ _ _ M L _ _ _ _ _ f
  classical

  have hU : ∀ (b : R₁) (B : Type u) [CommRing B] [Algebra R₁ B]
      (φ ψ : Localization.Away b →ₐ[R₁] B), φ = ψ := fun b B _ _ φ ψ =>
    (IsLocalization.algHom_subsingleton (Submonoid.powers b)
      (S := Localization.Away b) (P := B)).elim φ ψ

  have hJ : ∀ s ∈ M, Nonempty (Localization.Away s →ₐ[R₁] L) := by
    intro s hs
    refine ⟨IsLocalization.liftAlgHom (M := Submonoid.powers s) (f := Algebra.ofId R₁ L) ?_⟩
    rintro ⟨y, hy⟩
    obtain ⟨k, rfl⟩ := Submonoid.mem_powers_iff _ _ |>.mp hy
    exact IsLocalization.map_units L (⟨s ^ k, Submonoid.pow_mem _ hs k⟩ : M)

  have hK : ∀ s₀ s : R₁, s₀ ∣ s →
      Nonempty (Localization.Away s₀ →ₐ[R₁] Localization.Away s) := by
    intro s₀ s hd
    refine ⟨IsLocalization.liftAlgHom (M := Submonoid.powers s₀)
      (f := Algebra.ofId R₁ (Localization.Away s)) ?_⟩
    rintro ⟨y, hy⟩
    obtain ⟨k, rfl⟩ := Submonoid.mem_powers_iff _ _ |>.mp hy
    show IsUnit (algebraMap R₁ (Localization.Away s) (s₀ ^ k))
    rw [map_pow]
    exact (isUnit_of_dvd_unit (map_dvd _ hd) (IsLocalization.Away.algebraMap_isUnit s)).pow k

  obtain ⟨n, f₀, hsurj, hfg⟩ := Algebra.FinitePresentation.out (R := Q₀) (A := F)
  obtain ⟨G, hG⟩ := hfg

  have hden : ∀ i : Fin n, ∃ x : R₁ × M,
      f (f₀ (MvPolynomial.X i)) * algebraMap R₁ L (x.2 : R₁) = algebraMap R₁ L x.1 :=
    fun i => IsLocalization.surj M _
  choose x hx using hden
  set s₀ : R₁ := ∏ i, ((x i).2 : R₁) with hs₀
  have hs₀M : s₀ ∈ M := Submonoid.prod_mem _ (fun i _ => (x i).2.2)
  have hunit₀ : ∀ i, IsUnit (algebraMap R₁ (Localization.Away s₀) ((x i).2 : R₁)) := fun i =>
    isUnit_of_dvd_unit
      (map_dvd _ (Finset.dvd_prod_of_mem (fun i => ((x i).2 : R₁)) (Finset.mem_univ i)))
      (IsLocalization.Away.algebraMap_isUnit s₀)
  let g : MvPolynomial (Fin n) Q₀ →ₐ[Q₀] Localization.Away s₀ :=
    MvPolynomial.aeval (fun i => algebraMap R₁ (Localization.Away s₀) (x i).1 *
      ((hunit₀ i).unit⁻¹ : (Localization.Away s₀)ˣ))
  obtain ⟨j₀⟩ := hJ s₀ hs₀M
  have hjg : ∀ p, j₀ (g p) = f (f₀ p) := by
    have h : (j₀.restrictScalars Q₀).comp g = f.comp f₀ := by
      apply MvPolynomial.algHom_ext
      intro i
      simp only [AlgHom.comp_apply, AlgHom.restrictScalars_apply, g, MvPolynomial.aeval_X,
        map_mul, AlgHom.commutes]
      have e2 : j₀ (((hunit₀ i).unit⁻¹ : (Localization.Away s₀)ˣ) : Localization.Away s₀) *
          algebraMap R₁ L ((x i).2 : R₁) = 1 := by
        rw [← AlgHom.commutes j₀, ← map_mul, IsUnit.val_inv_mul, map_one]
      linear_combination (-(j₀ (((hunit₀ i).unit⁻¹ : (Localization.Away s₀)ˣ) :
        Localization.Away s₀))) * hx i + f (f₀ (MvPolynomial.X i)) * e2
    intro p
    exact AlgHom.congr_fun h p

  have hkill : ∀ r : MvPolynomial (Fin n) Q₀, ∃ t ∈ M,
      r ∈ G → algebraMap R₁ (Localization.Away s₀) t * g r = 0 := by
    intro r
    by_cases hr : r ∈ G
    · have hrk : r ∈ RingHom.ker f₀.toRingHom := by
        rw [← hG]; exact Ideal.subset_span hr
      have hf0 : f₀ r = 0 := RingHom.mem_ker.mp hrk
      have hj0 : j₀ (g r) = 0 := by rw [hjg, hf0, map_zero]
      obtain ⟨k, b, hb⟩ := IsLocalization.Away.surj s₀ (g r)
      have hbL : algebraMap R₁ L b = 0 := by
        have := congrArg j₀ hb
        rw [map_mul, map_pow, AlgHom.commutes, AlgHom.commutes, hj0, zero_mul] at this
        exact this.symm
      obtain ⟨m, hm⟩ := (IsLocalization.map_eq_zero_iff M L b).mp hbL
      refine ⟨m, m.2, fun _ => ?_⟩
      have hu : IsUnit (algebraMap R₁ (Localization.Away s₀) s₀ ^ k) :=
        (IsLocalization.Away.algebraMap_isUnit s₀).pow k
      refine (hu.mul_left_eq_zero).mp ?_
      rw [mul_assoc, hb, ← map_mul, hm, map_zero]
    · exact ⟨1, M.one_mem, fun h => absurd h hr⟩
  choose t htM ht using hkill
  set s : R₁ := s₀ * ∏ r ∈ G, t r with hs
  have hsM : s ∈ M := M.mul_mem hs₀M (Submonoid.prod_mem _ (fun r _ => htM r))
  obtain ⟨κ⟩ := hK s₀ s (dvd_mul_right _ _)
  obtain ⟨j⟩ := hJ s hsM
  have hjκ : j.comp κ = j₀ := hU s₀ L _ _
  have hκG : ∀ r ∈ G, κ (g r) = 0 := by
    intro r hr
    have hu : IsUnit (algebraMap R₁ (Localization.Away s) (t r)) :=
      isUnit_of_dvd_unit (map_dvd _ (dvd_mul_of_dvd_right (Finset.dvd_prod_of_mem t hr) s₀))
        (IsLocalization.Away.algebraMap_isUnit s)
    refine (hu.mul_right_eq_zero).mp ?_
    rw [← AlgHom.commutes κ, ← map_mul, ht r hr, map_zero]

  let ψ : MvPolynomial (Fin n) Q₀ →ₐ[Q₀] Localization.Away s := (κ.restrictScalars Q₀).comp g
  have hψ : ∀ a ∈ RingHom.ker f₀, ψ a = 0 := by
    intro a ha
    have hle : Ideal.span (G : Set (MvPolynomial (Fin n) Q₀)) ≤ RingHom.ker ψ := by
      rw [Ideal.span_le]
      intro r hr
      exact RingHom.mem_ker.mpr (hκG r hr)
    have ha' : a ∈ Ideal.span (G : Set (MvPolynomial (Fin n) Q₀)) := by
      rw [hG]; exact ha
    exact RingHom.mem_ker.mp (hle ha')
  let e := Ideal.quotientKerAlgEquivOfSurjective hsurj
  let f' : F →ₐ[Q₀] Localization.Away s :=
    (Ideal.Quotient.liftₐ (RingHom.ker f₀) ψ hψ).comp e.symm.toAlgHom
  have hkey : ∀ p, f' (f₀ p) = ψ p := by
    intro p
    have he : e (Ideal.Quotient.mk _ p) = f₀ p := rfl
    have he' : e.symm (f₀ p) = Ideal.Quotient.mk _ p := e.symm_apply_eq.mpr he.symm
    show Ideal.Quotient.liftₐ (RingHom.ker f₀) ψ hψ (e.symm (f₀ p)) = ψ p
    rw [he']
    rfl
  refine ⟨s, hsM, f', j, ?_⟩
  apply AlgHom.ext
  intro y
  obtain ⟨p, rfl⟩ := hsurj y
  rw [AlgHom.comp_apply, AlgHom.restrictScalars_apply, hkey p, ← hjg p, ← hjκ]
  rfl

theorem wc_pfc_pd_fp_descent_localization : ∀ (R₀ : Type u) [CommRing R₀] (M : Submonoid R₀) (L : Type u) [CommRing L] [Algebra R₀ L] [IsLocalization M L] (T : Type u) [CommRing T] [Algebra L T] [Algebra R₀ T] [IsScalarTower R₀ L T] [Algebra.FinitePresentation L T], ∃ (T₁ : Type u) (_ : CommRing T₁) (_ : Algebra R₀ T₁) (_ : Algebra.FinitePresentation R₀ T₁) (_ : Algebra T₁ T) (_ : IsScalarTower R₀ T₁ T), IsLocalization (Algebra.algebraMapSubmonoid T₁ M) T :=
by
  intro R₀ _ M L _ _ _ T _ _ _ _ _
  classical
  obtain ⟨n, p, hp, hker⟩ := Algebra.FinitePresentation.out (R := L) (A := T)
  obtain ⟨G, hG⟩ := hker
  letI algPQ : Algebra (MvPolynomial (Fin n) R₀) (MvPolynomial (Fin n) L) :=
    MvPolynomial.algebraMvPolynomial
  haveI hQloc : IsLocalization (Submonoid.map (MvPolynomial.C : R₀ →+* MvPolynomial (Fin n) R₀) M)
      (MvPolynomial (Fin n) L) := MvPolynomial.isLocalization M L
  choose c hc using fun g : MvPolynomial (Fin n) L =>
    IsLocalization.surj (Submonoid.map (MvPolynomial.C : R₀ →+* MvPolynomial (Fin n) R₀) M) g
  set I : Ideal (MvPolynomial (Fin n) R₀) :=
    Ideal.span ((G.image (fun g => (c g).1) : Finset (MvPolynomial (Fin n) R₀)) :
      Set (MvPolynomial (Fin n) R₀)) with hIdef
  have hIfg : I.FG := ⟨G.image (fun g => (c g).1), rfl⟩
  have hFP : Algebra.FinitePresentation R₀ (MvPolynomial (Fin n) R₀ ⧸ I) :=
    Algebra.FinitePresentation.quotient hIfg
  have hpG : ∀ g ∈ G, p g = 0 := by
    intro g hg
    have h1 : g ∈ RingHom.ker p.toRingHom := by
      rw [← hG]; exact Ideal.subset_span hg
    exact h1
  set q : MvPolynomial (Fin n) R₀ →+* T :=
    p.toRingHom.comp (algebraMap (MvPolynomial (Fin n) R₀) (MvPolynomial (Fin n) L)) with hqdef
  have hI : I ≤ RingHom.ker q := by
    rw [hIdef, Ideal.span_le]
    intro x hx
    simp only [Finset.coe_image, Set.mem_image, Finset.mem_coe] at hx
    obtain ⟨g, hg, rfl⟩ := hx
    rw [SetLike.mem_coe, RingHom.mem_ker]
    show p (algebraMap (MvPolynomial (Fin n) R₀) (MvPolynomial (Fin n) L) (c g).1) = 0
    rw [← hc g, map_mul, hpG g hg, zero_mul]
  let ψ : (MvPolynomial (Fin n) R₀ ⧸ I) →+* T := Ideal.Quotient.lift I q (fun a ha => hI ha)
  have hψ : ∀ a : MvPolynomial (Fin n) R₀, ψ (Ideal.Quotient.mk I a) =
      p (algebraMap (MvPolynomial (Fin n) R₀) (MvPolynomial (Fin n) L) a) :=
    fun a => Ideal.Quotient.lift_mk _ _ _
  letI alg : Algebra (MvPolynomial (Fin n) R₀ ⧸ I) T := ψ.toAlgebra
  have hRT : ∀ r : R₀, algebraMap R₀ (MvPolynomial (Fin n) R₀ ⧸ I) r =
      Ideal.Quotient.mk I (MvPolynomial.C r) := fun r => rfl
  have htower : IsScalarTower R₀ (MvPolynomial (Fin n) R₀ ⧸ I) T :=
    IsScalarTower.of_algebraMap_eq (R := R₀) (S := MvPolynomial (Fin n) R₀ ⧸ I) (A := T)
      (fun r => by
        rw [RingHom.algebraMap_toAlgebra, hRT, hψ, MvPolynomial.algebraMap_def, MvPolynomial.map_C]
        exact (IsScalarTower.algebraMap_apply R₀ L T r).trans (p.commutes _).symm)
  have hloc := IsLocalization.of_surjective
    (Submonoid.map (MvPolynomial.C : R₀ →+* MvPolynomial (Fin n) R₀) M) (MvPolynomial (Fin n) L)
    (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective p.toRingHom hp
    (RingHom.ext fun a => (hψ a).symm)
    (by
      rw [Ideal.mk_ker, ← hG, Ideal.span_le]
      intro g hg
      have hu : IsUnit (algebraMap (MvPolynomial (Fin n) R₀) (MvPolynomial (Fin n) L) (c g).2) :=
        IsLocalization.map_units (MvPolynomial (Fin n) L) (c g).2
      obtain ⟨v, hv⟩ := hu
      have hmem : algebraMap (MvPolynomial (Fin n) R₀) (MvPolynomial (Fin n) L) (c g).1 ∈
          Ideal.map (algebraMap (MvPolynomial (Fin n) R₀) (MvPolynomial (Fin n) L)) I :=
        Ideal.mem_map_of_mem _ (Ideal.subset_span (Finset.mem_coe.mpr
          (Finset.mem_image_of_mem _ hg)))
      have he : g = algebraMap (MvPolynomial (Fin n) R₀) (MvPolynomial (Fin n) L) (c g).1 *
          ((v⁻¹ : (MvPolynomial (Fin n) L)ˣ) : MvPolynomial (Fin n) L) := by
        rw [← hc g, ← hv, Units.mul_inv_cancel_right]
      rw [SetLike.mem_coe, he]
      exact Ideal.mul_mem_right _ _ hmem)
  have hsub : Submonoid.map (Ideal.Quotient.mk I)
      (Submonoid.map (MvPolynomial.C : R₀ →+* MvPolynomial (Fin n) R₀) M) =
      Algebra.algebraMapSubmonoid (MvPolynomial (Fin n) R₀ ⧸ I) M := by
    ext y
    simp only [Submonoid.mem_map, Algebra.algebraMapSubmonoid]
    constructor
    · rintro ⟨_, ⟨m, hm, rfl⟩, rfl⟩
      exact ⟨m, hm, rfl⟩
    · rintro ⟨m, hm, rfl⟩
      exact ⟨MvPolynomial.C m, ⟨m, hm, rfl⟩, rfl⟩
  exact ⟨MvPolynomial (Fin n) R₀ ⧸ I, inferInstance, inferInstance, hFP, alg, htower, hsub ▸ hloc⟩

theorem wc_pfc_pd_smooth_descent : ∀ (R₀ : Type u) [CommRing R₀] (M : Submonoid R₀) (L : Type u) [CommRing L] [Algebra R₀ L] [IsLocalization M L] (T : Type u) [CommRing T] [Algebra L T] [Algebra R₀ T] [IsScalarTower R₀ L T] [Algebra.Smooth L T] (E : Type u) [CommRing E] [Algebra R₀ E] [Algebra.FinitePresentation R₀ E] (f : E →ₐ[R₀] T), ∃ (T' : Type u) (_ : CommRing T') (_ : Algebra R₀ T') (_ : Algebra.Smooth R₀ T') (g : E →ₐ[R₀] T') (h : T' →ₐ[R₀] T), h.comp g = f :=
by
  intro R₀ _ M L _ _ _ T _ _ _ _ _ E _ _ _ f

  haveI : Algebra.FormallySmooth R₀ L := Algebra.FormallySmooth.of_isLocalization M
  haveI : Algebra.FormallySmooth L T := inferInstance
  haveI hTfs : Algebra.FormallySmooth R₀ T := Algebra.FormallySmooth.comp R₀ L T
  haveI : Algebra.FinitePresentation L T := inferInstance

  obtain ⟨T₁, _, _, _, _, _, hloc⟩ := wc_pfc_pd_fp_descent_localization R₀ M L T
  set N := Algebra.algebraMapSubmonoid T₁ M with hN
  haveI : IsLocalization N T := hloc

  have s3 : ∀ (𝔓 : Ideal T₁) [𝔓.IsPrime], Disjoint (N : Set T₁) (𝔓 : Set T₁) →
      Algebra.FormallySmooth R₀ (Localization.AtPrime 𝔓) := by
    intro 𝔓 _ hdisj
    haveI h𝔓' : (Ideal.map (algebraMap T₁ T) 𝔓).IsPrime :=
      IsLocalization.isPrime_of_isPrime_disjoint N T 𝔓 inferInstance hdisj
    have hcomap : Ideal.comap (algebraMap T₁ T) (Ideal.map (algebraMap T₁ T) 𝔓) = 𝔓 :=
      IsLocalization.comap_map_of_isPrime_disjoint N T inferInstance hdisj
    set 𝔓' := Ideal.map (algebraMap T₁ T) 𝔓 with h𝔓'def
    let B := Localization.AtPrime 𝔓'
    haveI : IsScalarTower R₀ T₁ B := IsScalarTower.of_algebraMap_eq (fun r => by
      rw [IsScalarTower.algebraMap_apply R₀ T B, IsScalarTower.algebraMap_apply R₀ T₁ T,
        ← IsScalarTower.algebraMap_apply T₁ T B])
    have hB : IsLocalization.AtPrime B (Ideal.comap (algebraMap T₁ T) 𝔓') :=
      IsLocalization.isLocalization_isLocalization_atPrime_isLocalization N B 𝔓'
    have key : ∀ (Q : Ideal T₁) [Q.IsPrime], Q = 𝔓 → IsLocalization.AtPrime B Q →
        IsLocalization.AtPrime B 𝔓 := by
      rintro Q _ rfl h; exact h
    haveI : IsLocalization 𝔓.primeCompl B := key _ hcomap hB
    let e : Localization.AtPrime 𝔓 ≃ₐ[T₁] B :=
      IsLocalization.algEquiv 𝔓.primeCompl (Localization.AtPrime 𝔓) B
    haveI : Algebra.FormallySmooth T B := Algebra.FormallySmooth.of_isLocalization 𝔓'.primeCompl
    haveI : Algebra.FormallySmooth R₀ B := Algebra.FormallySmooth.comp R₀ T B
    exact Algebra.FormallySmooth.of_equiv (e.restrictScalars R₀).symm

  obtain ⟨x, hxN, hRx⟩ : ∃ x ∈ N, Algebra.Smooth R₀ (Localization.Away x) := by
    have hU := Algebra.isOpen_smoothLocus (R := R₀) (A := T₁)
    obtain ⟨K, hK⟩ := (PrimeSpectrum.isClosed_iff_zeroLocus_ideal _).mp hU.isClosed_compl
    have hKN : ¬ Disjoint (K : Set T₁) (N : Set T₁) := by
      intro hd
      obtain ⟨p, hp, hKp, hpN⟩ := Ideal.exists_le_prime_disjoint K N hd
      have h1 : (⟨p, hp⟩ : PrimeSpectrum T₁) ∈ PrimeSpectrum.zeroLocus (K : Set T₁) :=
        (PrimeSpectrum.mem_zeroLocus _ _).mpr hKp
      rw [← hK] at h1
      apply h1
      show Algebra.IsSmoothAt R₀ p
      exact s3 p hpN.symm
    obtain ⟨x, hxK, hxN⟩ := Set.not_disjoint_iff.mp hKN
    refine ⟨x, hxN, ?_⟩
    have hsub : (PrimeSpectrum.basicOpen x : Set (PrimeSpectrum T₁)) ⊆ Algebra.smoothLocus R₀ T₁ := by
      intro q hq
      by_contra hqU
      have : q ∈ PrimeSpectrum.zeroLocus (K : Set T₁) := by rw [← hK]; exact hqU
      exact (PrimeSpectrum.mem_basicOpen _ _).mp hq ((PrimeSpectrum.mem_zeroLocus _ _).mp this hxK)
    haveI : Algebra.FormallySmooth R₀ (Localization.Away x) :=
      (Algebra.basicOpen_subset_smoothLocus_iff).mp hsub
    haveI : Algebra.FinitePresentation T₁ (Localization.Away x) :=
      IsLocalization.Away.finitePresentation x
    haveI : Algebra.FinitePresentation R₀ (Localization.Away x) :=
      Algebra.FinitePresentation.trans R₀ T₁ _
    exact ⟨inferInstance, inferInstance⟩

  have hle : Submonoid.powers x ≤ N := (Submonoid.powers_le).mpr hxN
  letI : Algebra (Localization.Away x) T :=
    IsLocalization.localizationAlgebraOfSubmonoidLe (Localization.Away x) T (Submonoid.powers x) N hle
  haveI : IsScalarTower T₁ (Localization.Away x) T :=
    IsLocalization.localization_isScalarTower_of_submonoid_le (Localization.Away x) T _ N hle
  haveI : IsLocalization (Submonoid.map (algebraMap T₁ (Localization.Away x)) N) T :=
    IsLocalization.isLocalization_of_submonoid_le (Localization.Away x) T _ N hle
  haveI : IsScalarTower R₀ (Localization.Away x) T := IsScalarTower.of_algebraMap_eq (fun r => by
    rw [IsScalarTower.algebraMap_apply R₀ T₁ (Localization.Away x),
      ← IsScalarTower.algebraMap_apply T₁ (Localization.Away x) T,
      ← IsScalarTower.algebraMap_apply R₀ T₁ T])

  obtain ⟨s, _, f', j, hcomp⟩ := wc_pfc_pd_spread_localization R₀ E (Localization.Away x)
    (Submonoid.map (algebraMap T₁ (Localization.Away x)) N) T f

  haveI : Algebra.Smooth (Localization.Away x) (Localization.Away s) :=
    Algebra.Smooth.of_isLocalization_Away s
  haveI : Algebra.Smooth R₀ (Localization.Away s) := Algebra.Smooth.comp R₀ (Localization.Away x) _
  exact ⟨Localization.Away s, inferInstance, inferInstance, inferInstance, f',
    j.restrictScalars R₀, hcomp⟩

theorem wc_pfc_pd_local_smooth_factor : ∀ (k : Type u) [Field k] (Λ : Type u) [CommRing Λ] [Algebra k Λ] (𝔮 : Ideal Λ) [𝔮.IsPrime] (m n d c : ℕ) (φ' : MvPolynomial (Fin m) k →ₐ[k] Λ), RingHom.Flat (Localization.localRingHom (𝔮.comap φ'.toRingHom) 𝔮 φ'.toRingHom rfl) → Ideal.map (Localization.localRingHom (𝔮.comap φ'.toRingHom) 𝔮 φ'.toRingHom rfl) (IsLocalRing.maximalIdeal (Localization.AtPrime (𝔮.comap φ'.toRingHom))) = IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) → ∀ (π : Fin d → MvPolynomial (Fin m) k) (δ : Fin d → Λ), 1 ≤ c → d * (8 * c) + 1 ≤ n → (∀ i, π i ∈ 𝔮.comap φ'.toRingHom) → (∀ i, δ i ∉ 𝔮) → Ideal.map (algebraMap Λ (Localization.AtPrime 𝔮)) (Ideal.span (Set.range fun i => φ' (π i))) = IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) → ∀ (S : Type u) [CommRing S] [iS : Algebra (Localization.AtPrime (𝔮.comap φ'.toRingHom) ⧸ IsLocalRing.maximalIdeal (Localization.AtPrime (𝔮.comap φ'.toRingHom)) ^ n) S] [Algebra.Smooth (Localization.AtPrime (𝔮.comap φ'.toRingHom) ⧸ IsLocalRing.maximalIdeal (Localization.AtPrime (𝔮.comap φ'.toRingHom)) ^ n) S] (𝔪 : Ideal S) [𝔪.IsPrime] (v : Localization.AtPrime 𝔪 →+* Localization.AtPrime 𝔮 ⧸ IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) ^ n), (∀ x : Localization.AtPrime (𝔮.comap φ'.toRingHom), v (algebraMap S (Localization.AtPrime 𝔪) (@algebraMap _ _ _ _ iS (Ideal.Quotient.mk (IsLocalRing.maximalIdeal (Localization.AtPrime (𝔮.comap φ'.toRingHom)) ^ n) x))) = Ideal.Quotient.mk (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) ^ n) (Localization.localRingHom (𝔮.comap φ'.toRingHom) 𝔮 φ'.toRingHom rfl x)) → ∀ [Algebra (MvPolynomial (Fin m ⊕ Fin d) k) Λ] [IsScalarTower k (MvPolynomial (Fin m ⊕ Fin d) k) Λ], (∀ j, algebraMap (MvPolynomial (Fin m ⊕ Fin d) k) Λ (MvPolynomial.X (Sum.inl j)) = φ' (MvPolynomial.X j)) → (∀ i, algebraMap (MvPolynomial (Fin m ⊕ Fin d) k) Λ (MvPolynomial.X (Sum.inr i)) = δ i) → ∀ (A' : Type u) [CommRing A'] [Algebra (MvPolynomial (Fin m ⊕ Fin d) k) A'] [Algebra.FinitePresentation (MvPolynomial (Fi