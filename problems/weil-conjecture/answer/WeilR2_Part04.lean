        rw [← Algebra.adjoin_singleton_eq_range_aeval]; exact a.2
      obtain ⟨h, hh⟩ := this
      exact ⟨h, Subtype.ext (by rw [hcoe]; exact hh.symm)⟩
    have hm : ∀ m : G, m ∈ IsLocalRing.maximalIdeal G ↔ (m : Ω × κ).2 = 0 := by
      intro m
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, hU, not_not]
    have hJchar : ∀ a : A, a ∈ Ideal.map (algebraMap G A) (IsLocalRing.maximalIdeal G) ↔
