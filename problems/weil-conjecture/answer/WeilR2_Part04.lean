          MvPolynomial.aeval Z (a I)) * (Matrix.of fun k l : Fin c => MvPolynomial.pderiv (Fin.castAdd c (I k)) (K l)).det =
          (MvPolynomial.C (algebraMap R D π) ^ 3) ^ c * (MvPolynomial.C (algebraMap R D π) - ∑ I,
            (MvPolynomial.aeval Z : MvPolynomial (Fin n) R →ₐ[R] MvPolynomial (Fin (n + c)) D)
              (a I * (Matrix.of fun j l : Fin c => MvPolynomial.pderiv (I l) (f (Fin.castLE hcm j))).det)) := by
        rw [mul_sub, Finset.mul_sum]
        congr 1
        · ring
        · refine Finset.sum_congr rfl (fun I _ => ?_)
          rw [map_mul, show ∀ x y : MvPolynomial (Fin (n + c)) D, (MvPolynomial.C (algebraMap R D π) ^ 3) ^ c * (x * y) =
