      simp only [map_sub, map_mul, map_pow]
      ring

  have hTransport : ∀ (R : Type u) [CommRing R] (D : Type u) [CommRing D] [Algebra R D] (π : R) (n m c : ℕ) (hcm : c ≤ m) (f : Fin m → MvPolynomial (Fin n) R) (a : (Fin c ↪ Fin n) → MvPolynomial (Fin n) R) (Z : Fin n → MvPolynomial (Fin (n + c)) D) (K : Fin c → MvPolynomial (Fin (n + c)) D), MvPolynomial.C π - ∑ I, a I * (Matrix.of fun j l : Fin c => MvPolynomial.pderiv (I l) (f (Fin.castLE hcm j))).det ∈ Ideal.span (Set.range f) → (∀ j : Fin m, c ≤ j.val → MvPolynomial.C π * f j ∈ Ideal.span (f '' {i | i.val < c}) + Ideal.span (Set.range f) ^ 2) → (∀ i i' : Fin n, MvPolynomial.pderiv (Fin.castAdd c i) (Z i') = if i = i' then MvPolynomial.C (algebraMap R D π) ^ 3 else 0) → (∀ l : Fin c, MvPolynomial.aeval Z (f (Fin.castLE hcm l)) = MvPolynomial.C (algebraMap R D π) ^ 3 * K l) → (MvPolynomial.C (algebraMap R D π) ^ (3 * c + 1) - ∑ I, (MvPolynomial.C (algebraMap R D π) ^ (3 * c) * MvPolynomial.aeval Z (a I)) * (Matrix.of fun k l : Fin c => MvPolynomial.pderiv (Fin.castAdd c (I k)) (K l)).det ∈ Ideal.span (Set.range fun j => MvPolynomial.aeval Z (f j))) ∧ (∀ j : Fin m, c ≤ j.val → MvPolynomial.C (algebraMap R D π) * MvPolynomial.aeval Z (f j) ∈ Ideal.span ((fun j => MvPolynomial.aeval Z (f j)) '' {j' | j'.val < c}) + Ideal.span (Set.range fun j => MvPolynomial.aeval Z (f j)) ^ 2) := by
    intro R _ D _ _ π n m c hcm f a Z K hstd1 hstd2 hdZ hZK
    have s4 : ∀ (R : Type u) [CommRing R] (S : Type u) [CommRing S] [Algebra R S] (N n : ℕ) (p : MvPolynomial (Fin N) R) (Y : Fin N → MvPolynomial (Fin n) S) (j : Fin n), MvPolynomial.pderiv j (MvPolynomial.aeval Y p) = ∑ i, MvPolynomial.aeval Y (MvPolynomial.pderiv i p) * MvPolynomial.pderiv j (Y i) := by
      intro R _ S _ _ N n p Y j
      induction p using MvPolynomial.induction_on with
      | C r => simp [MvPolynomial.algebraMap_apply]
      | add p q hp hq => simp only [map_add, hp, hq, add_mul, Finset.sum_add_distrib]
      | mul_X p k hp =>
        have e : ∀ i, MvPolynomial.aeval Y (MvPolynomial.pderiv i (p * MvPolynomial.X k)) =
            (if i = k then MvPolynomial.aeval Y p else 0) + Y k * MvPolynomial.aeval Y (MvPolynomial.pderiv i p) := by
          intro i
          rw [Derivation.leibniz, MvPolynomial.pderiv_X, smul_eq_mul, smul_eq_mul]
          by_cases h : i = k
          · subst h; simp
          · simp [Ne.symm h, h]
        simp only [e, add_mul, Finset.sum_add_distrib, ite_mul, zero_mul, Finset.sum_ite_eq', Finset.mem_univ, ite_true]
        rw [map_mul, MvPolynomial.aeval_X, Derivation.leibniz, hp, smul_eq_mul, smul_eq_mul, Finset.mul_sum]
        simp only [mul_assoc]
        try ring
    have hΦC : (MvPolynomial.aeval Z : MvPolynomial (Fin n) R →ₐ[R] MvPolynomial (Fin (n + c)) D)
        (MvPolynomial.C π) = MvPolynomial.C (algebraMap R D π) := by
      rw [← MvPolynomial.algebraMap_eq, AlgHom.commutes, MvPolynomial.algebraMap_apply]
    have hrange : (Set.range fun j => MvPolynomial.aeval Z (f j)) =
        (MvPolynomial.aeval Z : MvPolynomial (Fin n) R →ₐ[R] MvPolynomial (Fin (n + c)) D) '' Set.range f := by
      rw [← Set.range_comp]; rfl
    have himg : ((fun j => MvPolynomial.aeval Z (f j)) '' {j' : Fin m | j'.val < c}) =
        (MvPolynomial.aeval Z : MvPolynomial (Fin n) R →ₐ[R] MvPolynomial (Fin (n + c)) D) ''
          (f '' {j' | j'.val < c}) := by
      rw [Set.image_image]
    constructor
    · have hent : ∀ (I : Fin c ↪ Fin n), (MvPolynomial.C (algebraMap R D π) ^ 3 : MvPolynomial (Fin (n + c)) D) •
          (MvPolynomial.aeval Z : MvPolynomial (Fin n) R →ₐ[R] MvPolynomial (Fin (n + c)) D).mapMatrix
            (Matrix.of fun j l : Fin c => MvPolynomial.pderiv (I l) (f (Fin.castLE hcm j))) =
          (MvPolynomial.C (algebraMap R D π) ^ 3 : MvPolynomial (Fin (n + c)) D) •
            (Matrix.of fun k l : Fin c => MvPolynomial.pderiv (Fin.castAdd c (I k)) (K l)).transpose := by
        intro I
        refine Matrix.ext fun j l => ?_
        simp only [Matrix.smul_apply, AlgHom.mapMatrix_apply, Matrix.map_apply, Matrix.of_apply,
          Matrix.transpose_apply, smul_eq_mul]
        have e1 := s4 R D n (n + c) (f (Fin.castLE hcm j)) Z (Fin.castAdd c (I l))
        simp only [hdZ, mul_ite, mul_zero, Finset.sum_ite_eq, Finset.mem_univ, ite_true] at e1
        rw [hZK j, ← map_pow, MvPolynomial.pderiv_C_mul, map_pow] at e1
