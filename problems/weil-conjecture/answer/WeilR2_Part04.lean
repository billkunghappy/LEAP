      exact ⟨l', t, ht (D.obj l') (D.map t) (𝟙 _)
        ((Category.comp_id _).trans (Category.id_comp _).symm)⟩

theorem wc_et_limit_cover_descends : ∀ {S Z : Scheme.{u}} (g : Z ⟶ S) (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (D : Λ ⥤ S.Etale) (U : Z.Etale) (π : ∀ l, U.left ⟶ (D.obj l).left), (∀ l, π l ≫ (D.obj l).hom = U.hom ≫ g) → (∀ {l l' : Λ} (t : l ⟶ l'), π l ≫ (D.map t).left = π l') → (∀ (T : Scheme.{u}) (z : ∀ l, T ⟶ (D.obj l).left), (∀ {l l' : Λ} (t : l ⟶ l'), z l ≫ (D.map t).left = z l') → ∃! z₀ : T ⟶ U.left, ∀ l, z₀ ≫ π l = z l) → (∀ l, CompactSpace (D.obj l).left) → (∀ l, QuasiSeparatedSpace (D.obj l).left) → (∀ {l l' : Λ} (t : l ⟶ l'), IsAffineHom (D.map t).left) → ∀ R ∈ Scheme.smallEtaleTopology Z U, ∃ (l : Λ) (k : ℕ) (V : Fin k → S.Etale) (c : ∀ i, V i ⟶ D.obj l) (U' : Fin k → Z.Etale) (f : ∀ i, U' i ⟶ U) (e : ∀ i, (U' i).left ⟶ (V i).left), (∀ i, IsPullback (e i) (f i).left (c i).left (π l)) ∧ (∀ i, R.arrows (f i)) ∧ (∀ i, IsAffine (V i).left) ∧ ∀ x : U.left, ∃ i, x ∈ Set.range (f i).left :=
by
  classical
  intro S Z g Λ _ _ D U π hπ hc hlim hcpt _hqs haff R hR

  have hEt : ∀ {E D' : S.Etale} (c : E ⟶ D'), Etale c.left := fun {E D'} c =>
    MorphismProperty.of_postcomp (W' := @Etale) @Etale c.left D'.hom D'.prop
      (by rw [MorphismProperty.Over.w c]; exact E.prop)

  have hU : CompactSpace U.left := by
    let F : Λ ⥤ Scheme.{u} := D ⋙ Scheme.Etale.forget S ⋙ Over.forget S
    let cn : Limits.Cone F :=
      { pt := U.left
        π := { app := fun l => π l
               naturality := fun l l' t => (Category.id_comp _).trans (hc t).symm } }
    have hcn : Limits.IsLimit cn := Limits.IsLimit.ofExistsUnique (fun s =>
      hlim s.pt (fun l => s.π.app l) (fun t => s.w t))
    haveI : ∀ {i j : Λ} (f : i ⟶ j), IsAffineHom (F.map f) := fun f => haff f
    haveI : ∀ i, CompactSpace (F.obj i) := hcpt
    exact Scheme.compactSpace_of_isLimit F cn hcn

  have rebase : ∀ (l₁ : Λ) (E : S.Etale) (c₁ : E ⟶ D.obj l₁), IsAffine E.left →
      ∀ (l : Λ), (l ⟶ l₁) → ∃ (V : S.Etale) (c : V ⟶ D.obj l)
        (r : Limits.pullback (π l) c.left ⟶ Limits.pullback (π l₁) c₁.left),
        IsAffine V.left ∧ r ≫ Limits.pullback.fst (π l₁) c₁.left = Limits.pullback.fst (π l) c.left ∧
        Set.range (Limits.pullback.fst (π l) c.left) =
          Set.range (Limits.pullback.fst (π l₁) c₁.left) := by
    intro l₁ E c₁ hE l t
    haveI := hEt c₁
    haveI : Etale (D.obj l).hom := (D.obj l).prop
    let V : S.Etale := MorphismProperty.Over.mk ⊤
      (Limits.pullback.snd c₁.left (D.map t).left ≫ (D.obj l).hom) inferInstance
    let c : V ⟶ D.obj l :=
      MorphismProperty.Over.homMk (Limits.pullback.snd c₁.left (D.map t).left) rfl trivial
    have hpb : IsPullback (Limits.pullback.fst c₁.left (D.map t).left)
        (Limits.pullback.snd c₁.left (D.map t).left) c₁.left (D.map t).left :=
      IsPullback.of_hasPullback _ _
    have hAff : IsAffineHom (Limits.pullback.fst c₁.left (D.map t).left) :=
      MorphismProperty.of_isPullback (P := @IsAffineHom) hpb.flip (haff t)
    have hVaff : IsAffine V.left :=
      @isAffine_of_isAffineHom _ _ (Limits.pullback.fst c₁.left (D.map t).left) hAff hE
    have hw : Limits.pullback.fst (π l) c.left ≫ π l₁ =
        (Limits.pullback.snd (π l) c.left ≫ Limits.pullback.fst c₁.left (D.map t).left) ≫ c₁.left := by
      calc Limits.pullback.fst (π l) c.left ≫ π l₁
          = (Limits.pullback.fst (π l) c.left ≫ π l) ≫ (D.map t).left := by
            rw [Category.assoc, hc t]
        _ = (Limits.pullback.snd (π l) c.left ≫ c.left) ≫ (D.map t).left := by
            rw [Limits.pullback.condition]
        _ = Limits.pullback.snd (π l) c.left ≫
              (Limits.pullback.snd c₁.left (D.map t).left ≫ (D.map t).left) := by
            rw [Category.assoc]; rfl
        _ = Limits.pullback.snd (π l) c.left ≫
              (Limits.pullback.fst c₁.left (D.map t).left ≫ c₁.left) :=
            congrArg (fun k => Limits.pullback.snd (π l) c.left ≫ k)
              (Limits.pullback.condition (f := c₁.left) (g := (D.map t).left)).symm
        _ = _ := (Category.assoc _ _ _).symm
    let r : Limits.pullback (π l) c.left ⟶ Limits.pullback (π l₁) c₁.left :=
      Limits.pullback.lift (Limits.pullback.fst (π l) c.left)
        (Limits.pullback.snd (π l) c.left ≫ Limits.pullback.fst c₁.left (D.map t).left) hw
    have hr : r ≫ Limits.pullback.fst (π l₁) c₁.left = Limits.pullback.fst (π l) c.left :=
      Limits.pullback.lift_fst _ _ _
    refine ⟨V, c, r, hVaff, hr, ?_⟩
    apply Set.Subset.antisymm
    · rintro x ⟨z, rfl⟩
      refine ⟨r z, ?_⟩
      rw [← Scheme.Hom.comp_apply, hr]
    · rintro x ⟨z₁, rfl⟩
      have e0 : (Limits.pullback.snd (π l₁) c₁.left ≫ c₁.left) z₁ =
          (Limits.pullback.fst (π l₁) c₁.left ≫ π l ≫ (D.map t).left) z₁ := by
        rw [hc t, Limits.pullback.condition]
      simp only [Scheme.Hom.comp_apply] at e0
      obtain ⟨v, -, hv2⟩ := Scheme.Pullback.exists_preimage_pullback
        (f := c₁.left) (g := (D.map t).left) _ _ e0
      obtain ⟨z, hz1, -⟩ := Scheme.Pullback.exists_preimage_pullback
        (f := π l) (g := c.left) (Limits.pullback.fst (π l₁) c₁.left z₁) v hv2.symm
      exact ⟨z, hz1⟩

  obtain ⟨k₀, W, fW, hWR, -, hWsurj⟩ := wc_et_finite_affine_refinement Z U hU R hR
  have hW' : ∀ x : U.left, ∃ (i : Fin k₀) (w : (W i).left), (fW i).left w = x := by
    intro x
    obtain ⟨i, w, hw⟩ := hWsurj x
    exact ⟨i, w, hw⟩
  choose jx wx hwx using hW'

  have hdesc := fun x : U.left =>
    wc_et_limit_etale_descend g U Λ D π hπ hc hlim haff (W (jx x)) (fW (jx x)) (wx x)
  choose lx Ex cx jj qx hEaff hjj hq using hdesc
  have hNopen : ∀ x : U.left, IsOpen (Set.range (Limits.pullback.fst (π (lx x)) (cx x).left)) := by
    intro x
    haveI := hEt (cx x)
    exact (Limits.pullback.fst (π (lx x)) (cx x).left).isOpenMap.isOpen_range
  have hNmem : ∀ x : U.left, x ∈ Set.range (Limits.pullback.fst (π (lx x)) (cx x).left) := by
    intro x
    refine ⟨qx x, ?_⟩
    rw [← hjj x, Scheme.Hom.comp_apply, hq x, hwx x]

  obtain ⟨T, hT⟩ := isCompact_univ.elim_finite_subcover
    (fun x : U.left => Set.range (Limits.pullback.fst (π (lx x)) (cx x).left)) hNopen
    (fun y _ => Set.mem_iUnion.2 ⟨y, hNmem y⟩)
  let p : Fin T.card → U.left := fun i => (T.equivFin.symm i).1
  have hcov : ∀ y : U.left, ∃ i : Fin T.card,
      y ∈ Set.range (Limits.pullback.fst (π (lx (p i))) (cx (p i)).left) := by
    intro y
    have hy := hT (Set.mem_univ y)
    simp only [Set.mem_iUnion] at hy
    obtain ⟨x, hxT, hyx⟩ := hy
    have hpi : p (T.equivFin ⟨x, hxT⟩) = x := by
      simp only [p, Equiv.symm_apply_apply]
    refine ⟨T.equivFin ⟨x, hxT⟩, ?_⟩
    rw [hpi]
    exact hyx

  obtain ⟨l, hl⟩ := IsCofiltered.inf_objs_exists (Finset.univ.image (fun i : Fin T.card => lx (p i)))
  have τ : ∀ i : Fin T.card, l ⟶ lx (p i) := fun i =>
    (hl (Finset.mem_image_of_mem _ (Finset.mem_univ i))).some

  have hreb := fun i : Fin T.card => rebase (lx (p i)) (Ex (p i)) (cx (p i)) (hEaff (p i)) l (τ i)
  choose V c' r hVaff hr hrange using hreb

  let U' : Fin T.card → Z.Etale := fun i =>
    MorphismProperty.Over.mk ⊤ (Limits.pullback.fst (π l) (c' i).left ≫ U.hom)
      (by haveI := hEt (c' i); haveI : Etale U.hom := U.prop; infer_instance)
  let f : ∀ i, U' i ⟶ U := fun i =>
    MorphismProperty.Over.homMk (Limits.pullback.fst (π l) (c' i).left) rfl trivial
  refine ⟨l, T.card, V, c', U', f, fun i => Limits.pullback.snd (π l) (c' i).left,
    fun i => (IsPullback.of_hasPullback (π l) (c' i).left).flip, ?_, hVaff, ?_⟩
  · intro i
    have hm : (r i ≫ jj (p i)) ≫ (fW (jx (p i))).left = Limits.pullback.fst (π l) (c' i).left := by
      rw [Category.assoc, hjj (p i), hr i]
    have hm2 : (r i ≫ jj (p i)) ≫ (W (jx (p i))).hom = Limits.pullback.fst (π l) (c' i).left ≫ U.hom := by
      rw [← MorphismProperty.Over.w (fW (jx (p i))), ← Category.assoc, hm]
    let m' : U' i ⟶ W (jx (p i)) := MorphismProperty.Over.homMk (r i ≫ jj (p i)) hm2 trivial
    have hfac : f i = m' ≫ fW (jx (p i)) := by
      apply MorphismProperty.Over.Hom.ext
      exact hm.symm
    rw [hfac]
    exact R.downward_closed (hWR _) m'
  · intro y
    obtain ⟨i, hi⟩ := hcov y
    refine ⟨i, ?_⟩
    show y ∈ Set.range (Limits.pullback.fst (π l) (c' i).left)
    rw [hrange i]
    exact hi

theorem wc_limit_restrict_over : ∀ {S X : Scheme.{u}} (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (D : Λ ⥤ S.Etale) (π : ∀ l, X ⟶ (D.obj l).left), (∀ {l l' : Λ} (t : l ⟶ l'), π l ≫ (D.map t).left = π l') → (∀ (T : Scheme.{u}) (z : ∀ l, T ⟶ (D.obj l).left), (∀ {l l' : Λ} (t : l ⟶ l'), z l ≫ (D.map t).left = z l') → ∃! z₀ : T ⟶ X, ∀ l, z₀ ≫ π l = z l) → ∀ (l₀ : Λ) (T : Scheme.{u}) (z : ∀ n : Over l₀, T ⟶ (D.obj n.left).left), (∀ {n n' : Over l₀} (t : n ⟶ n'), z n ≫ (D.map t.left).left = z n') → ∃! z₀ : T ⟶ X, ∀ n : Over l₀, z₀ ≫ π n.left = z n :=
by
  intro S X Λ _ _ D π hπ hlim l₀ T z hz
  have F1 : ∀ {a b c : Λ} (f : a ⟶ b) (g : b ⟶ c),
      (D.map (f ≫ g)).left = (D.map f).left ≫ (D.map g).left := by
    intro a b c f g
    rw [Functor.map_comp]
    rfl
  have F2 : ∀ a : Λ, (D.map (𝟙 a)).left = 𝟙 _ := by
    intro a
    rw [CategoryTheory.Functor.map_id]
    rfl
  have K : ∀ (n₁ n₂ : Over l₀) (l : Λ) (a₁ : n₁.left ⟶ l) (a₂ : n₂.left ⟶ l),
      z n₁ ≫ (D.map a₁).left = z n₂ ≫ (D.map a₂).left := by
    intro n₁ n₂ l a₁ a₂
    let d₁ := IsCofiltered.minToLeft n₁.left n₂.left
    let d₂ := IsCofiltered.minToRight n₁.left n₂.left
    let e1 := IsCofiltered.eqHom (d₁ ≫ a₁) (d₂ ≫ a₂)
    have he1 : e1 ≫ d₁ ≫ a₁ = e1 ≫ d₂ ≫ a₂ := IsCofiltered.eq_condition _ _
    let e2 := IsCofiltered.eqHom (e1 ≫ d₁ ≫ n₁.hom) (e1 ≫ d₂ ≫ n₂.hom)
    have he2 : e2 ≫ e1 ≫ d₁ ≫ n₁.hom = e2 ≫ e1 ≫ d₂ ≫ n₂.hom :=
      IsCofiltered.eq_condition _ _
    let c₁ := e2 ≫ e1 ≫ d₁
    let c₂ := e2 ≫ e1 ≫ d₂
    have hi : c₁ ≫ a₁ = c₂ ≫ a₂ := by
      calc c₁ ≫ a₁ = e2 ≫ (e1 ≫ d₁ ≫ a₁) := by simp only [c₁, Category.assoc]
        _ = e2 ≫ (e1 ≫ d₂ ≫ a₂) := congrArg (fun t => e2 ≫ t) he1
        _ = c₂ ≫ a₂ := by simp only [c₂, Category.assoc]
    have hii : c₁ ≫ n₁.hom = c₂ ≫ n₂.hom := by
      show (e2 ≫ e1 ≫ d₁) ≫ n₁.hom = (e2 ≫ e1 ≫ d₂) ≫ n₂.hom
      rw [Category.assoc, Category.assoc, Category.assoc, Category.assoc]
      exact he2
    let k : Over l₀ := Over.mk (c₁ ≫ n₁.hom)
    let h₁ : k ⟶ n₁ := Over.homMk c₁ rfl
    let h₂ : k ⟶ n₂ := Over.homMk c₂ hii.symm
    have z1 : z k ≫ (D.map c₁).left = z n₁ := hz h₁
    have z2 : z k ≫ (D.map c₂).left = z n₂ := hz h₂
    rw [← z1, ← z2, Category.assoc, Category.assoc, ← F1, ← F1, hi]
  let nl : Λ → Over l₀ := fun l => Over.mk (IsCofiltered.minToRight l l₀)
  let z' : ∀ l, T ⟶ (D.obj l).left := fun l =>
    z (nl l) ≫ (D.map (IsCofiltered.minToLeft l l₀ : (nl l).left ⟶ l)).left
  have hz' : ∀ {l l' : Λ} (t : l ⟶ l'), z' l ≫ (D.map t).left = z' l' := by
    intro l l' t
    show (z (nl l) ≫ (D.map (IsCofiltered.minToLeft l l₀ : (nl l).left ⟶ l)).left) ≫
        (D.map t).left =
      z (nl l') ≫ (D.map (IsCofiltered.minToLeft l' l₀ : (nl l').left ⟶ l')).left
    rw [Category.assoc, ← F1]
    exact K (nl l) (nl l') l' _ _
  obtain ⟨z₀, hz₀, huniq⟩ := hlim T z' hz'
  refine ⟨z₀, fun n => ?_, fun y hy => huniq y (fun l => ?_)⟩
  · rw [hz₀ n.left]
    show z (nl n.left) ≫
        (D.map (IsCofiltered.minToLeft n.left l₀ : (nl n.left).left ⟶ n.left)).left = z n
    rw [K (nl n.left) n n.left _ (𝟙 n.left), F2, Category.comp_id]
  · show y ≫ π l = z (nl l) ≫ (D.map (IsCofiltered.minToLeft l l₀ : (nl l).left ⟶ l)).left
    rw [← hπ (IsCofiltered.minToLeft l l₀ : (nl l).left ⟶ l), ← Category.assoc]
    exact congrArg (fun t => t ≫ (D.map (IsCofiltered.minToLeft l l₀ : (nl l).left ⟶ l)).left)
      (hy (nl l))

theorem wc_et_cech_nerve_limit_presentation : ∀ {S Z : Scheme.{u}} (g : Z ⟶ S) (U : Z.Etale) (M₀ : Type u) [SmallCategory M₀] [IsCofiltered M₀] (D₀ : M₀ ⥤ S.Etale) (π₀ : ∀ l, U.left ⟶ (D₀.obj l).left), (∀ l, π₀ l ≫ (D₀.obj l).hom = U.hom ≫ g) → (∀ {l l' : M₀} (t : l ⟶ l'), π₀ l ≫ (D₀.map t).left = π₀ l') → ∀ (m₀ : M₀), (∀ (T : Scheme.{u}) (z : ∀ n : Over m₀, T ⟶ (D₀.obj n.left).left), (∀ {n n' : Over m₀} (t : n ⟶ n'), z n ≫ (D₀.map t.left).left = z n') → ∃! z₀ : T ⟶ U.left, ∀ n : Over m₀, z₀ ≫ π₀ n.left = z n) → (∀ l, CompactSpace (D₀.obj l).left) → (∀ l, QuasiSeparatedSpace (D₀.obj l).left) → (∀ {l l' : M₀} (t : l ⟶ l'), IsAffineHom (D₀.map t).left) → CompactSpace U.left → QuasiSeparatedSpace U.left → ∀ (k : ℕ) (V : Fin k → Z.Etale) (f : ∀ i, V i ⟶ U) (V₀ : Fin k → S.Etale) (c : ∀ i, V₀ i ⟶ D₀.obj m₀) (e : ∀ i, (V i).left ⟶ (V₀ i).left), (∀ i, IsPullback (e i) (f i).left (c i).left (π₀ m₀)) → (∀ i, IsAffine (V₀ i).left) → ∃ (M : Type u) (_ : SmallCategory M) (_ : IsCofiltered M) (U' : M ⥤ S.Etale) (V' : Fin k → M ⥤ S.Etale) (f' : ∀ i, V' i ⟶ U') (π : ∀ (p : ℕ) (σ : Fin (p + 1) → Fin k) (n : M), (Limits.widePullback U (fun l => V (σ l)) (fun l => f (σ l))).left ⟶ ((wcLevelWP U' V' f' σ).obj n).left), (∀ (p : ℕ) (σ : Fin (p + 1) → Fin k) (n : M), π p σ n ≫ ((wcLevelWP U' V' f' σ).obj n).hom = (Limits.widePullback U (fun l => V (σ l)) (fun l => f (σ l))).hom ≫ g) ∧ (∀ (p : ℕ) (σ : Fin (p + 1) → Fin k) {n n' : M} (t : n ⟶ n'), π p σ n ≫ ((wcLevelWP U' V' f' σ).map t).left = π p σ n') ∧ (∀ (p : ℕ) (σ : Fin (p + 1) → Fin k) (T : Scheme.{u}) (z : ∀ n : M, T ⟶ ((wcLevelWP U' V' f' σ).obj n).left), (∀ {n n' : M} (t : n ⟶ n'), z n ≫ ((wcLevelWP U' V' f' σ).map t).left = z n') → ∃! z₀ : T ⟶ (Limits.widePullback U (fun l => V (σ l)) (fun l => f (σ l))).left, ∀ n : M, z₀ ≫ π p σ n = z n) ∧ (∀ (p : ℕ) (σ : Fin (p + 1) → Fin k) (n : M), CompactSpace ((wcLevelWP U' V' f' σ).obj n).left) ∧ (∀ (p : ℕ) (σ : Fin (p + 1) → Fin k) (n : M), QuasiSeparatedSpace ((wcLevelWP U' V' f' σ).obj n).left) ∧ (∀ (p : ℕ) (σ : Fin (p + 1) → Fin k) {n n' : M} (t : n ⟶ n'), IsAffineHom ((wcLevelWP U' V' f' σ).map t).left) ∧ (∀ (p : ℕ) (σ : Fin (p + 1) → Fin k), CompactSpace (Limits.widePullback U (fun l => V (σ l)) (fun l => f (σ l))).left ∧ QuasiSeparatedSpace (Limits.widePullback U (fun l => V (σ l)) (fun l => f (σ l))).left) ∧ (∀ (p : ℕ) (τ : Fin (p + 2) → Fin k) (j : Fin (p + 2)) (n : M), (wcCechFace V f τ j).left ≫ π p (fun l => τ (j.succAbove l)) n = π (p + 1) τ n ≫ (wcCechFace (fun i => (V' i).obj n) (fun i => (f' i).app n) τ j).left) :=
by

  have WPlift : ∀ (X : Scheme.{u}) (B : X.Etale) (m : ℕ) (P : Fin m → X.Etale) (a : ∀ j, P j ⟶ B)
      (T : Scheme.{u}) (x : T ⟶ B.left) (y : ∀ j, T ⟶ (P j).left), (∀ j, y j ≫ (a j).left = x) →
      ∃! h : T ⟶ (Limits.widePullback B P a).left, h ≫ (Limits.WidePullback.base a).left = x ∧
        ∀ j, h ≫ (Limits.WidePullback.π a j).left = y j := by
    intro X B m P a T x y hy
    have hc := Limits.isLimitOfPreserves (Scheme.Etale.forget X ⋙ Over.forget X)
      (Limits.limit.isLimit (Limits.WidePullbackShape.wideCospan B P a))
    let s := Limits.WidePullbackShape.mkCone
      (F := Limits.WidePullbackShape.wideCospan B P a ⋙ (Scheme.Etale.forget X ⋙ Over.forget X))
      x y (fun j => hy j)
    obtain ⟨h, hh, hu⟩ := hc.existsUnique s
    refine ⟨h, ⟨hh none, fun j => hh (some j)⟩, fun h' hh' => hu h' ?_⟩
    rintro (_ | j)
    · exact hh'.1
    · exact hh'.2 j
  have WPext : ∀ (X : Scheme.{u}) (B : X.Etale) (m : ℕ) (P : Fin m → X.Etale) (a : ∀ j, P j ⟶ B)
      (T : Scheme.{u}) (h h' : T ⟶ (Limits.widePullback B P a).left),
      h ≫ (Limits.WidePullback.base a).left = h' ≫ (Limits.WidePullback.base a).left →
      (∀ j, h ≫ (Limits.WidePullback.π a j).left = h' ≫ (Limits.WidePullback.π a j).left) →
      h = h' := by
    intro X B m P a T h h' hb hp
    have hc := Limits.isLimitOfPreserves (Scheme.Etale.forget X ⋙ Over.forget X)
      (Limits.limit.isLimit (Limits.WidePullbackShape.wideCospan B P a))
    apply hc.hom_ext
    rintro (_ | j)
    · exact hb
    · exact hp j
  have piA : ∀ (X : Scheme.{u}) (B : X.Etale) (m : ℕ) (P : Fin m → X.Etale) (a : ∀ j, P j ⟶ B)
      (j : Fin m), (Limits.WidePullback.π a j).left ≫ (a j).left =
        (Limits.WidePullback.base a).left := by
    intro X B m P a j
