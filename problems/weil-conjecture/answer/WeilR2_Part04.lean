        exact hmP.2.1 ⟨x, htop x⟩

  have sLift : ∀ (p : ℕ) [Fact p.Prime] (K : Type u) [Field K] [CharP K p] (R : Type u)
      [CommRing R] [CharP R p] (I : Ideal R), I * I = ⊥ → ∀ (τ : K →+* R ⧸ I),
      ∃ σ₁ : K →+* R, ∀ a, Ideal.Quotient.mk I (σ₁ a) = τ a := by
    intro p _ K _ _ R _ _ I hI τ
    letI := ZMod.algebra K p
    letI := ZMod.algebra R p
    haveI := hFS p K
    have hnil : IsNilpotent I := ⟨2, by rw [pow_two, hI, Ideal.zero_eq_bot]⟩
    let τA : K →ₐ[ZMod p] R ⧸ I :=
      { τ with
        commutes' := fun r => RingHom.congr_fun
          (RingHom.ext_zmod (τ.comp (algebraMap (ZMod p) K)) (algebraMap (ZMod p) (R ⧸ I))) r }
    refine ⟨(Algebra.FormallySmooth.lift I hnil τA).toRingHom, fun a => ?_⟩
    exact Algebra.FormallySmooth.mk_lift I hnil τA a

  have sCorr : ∀ (K : Type u) [Field K] (R : Type u) [CommRing R] (I : Ideal R), I * I = ⊥ →
      ∀ (σ₁ : K →+* R) (J : Type u) (s : J → K),
      LinearIndependent K (fun j => KaehlerDifferential.D ℤ K (s j)) →
      ∀ (t : J → R), (∀ j, t j - σ₁ (s j) ∈ I) →
      ∃ σ : K →+* R, (∀ a, σ a - σ₁ a ∈ I) ∧ ∀ j, σ (s j) = t j := by
    intro K _ R _ I hI σ₁ J s hli t ht
    letI : Module K I := Module.compHom I σ₁
    have hsmul : ∀ (c : K) (x : I), ((c • x : I) : R) = σ₁ c * (x : R) := fun c x => rfl
    let δ : J → I := fun j => ⟨t j - σ₁ (s j), ht j⟩
    obtain ⟨ℓ, hℓ⟩ := LinearMap.exists_extend ((Module.Basis.span hli).constr K δ)
    have hℓv : ∀ j, ℓ (KaehlerDifferential.D ℤ K (s j)) = δ j := by
      intro j
      have h1 : ((Module.Basis.span hli j : _) : Ω[K⁄ℤ]) = KaehlerDifferential.D ℤ K (s j) := by
        rw [Module.Basis.span_apply]
      rw [← h1]
      have := LinearMap.congr_fun hℓ (Module.Basis.span hli j)
      simp only [LinearMap.comp_apply, Submodule.subtype_apply] at this
      rw [this, Module.Basis.constr_basis]
    obtain ⟨E, hEdef⟩ : ∃ E : K → R, ∀ a, E a = ((ℓ (KaehlerDifferential.D ℤ K a) : I) : R) :=
      ⟨_, fun _ => rfl⟩
    have hEI : ∀ a, E a ∈ I := fun a => by rw [hEdef]; exact (ℓ _).2
    have hEadd : ∀ a b, E (a + b) = E a + E b := by
      intro a b
      rw [hEdef, hEdef, hEdef, map_add, map_add, Submodule.coe_add]
    have hE0 : E 0 = 0 := by
      rw [hEdef, map_zero, map_zero, ZeroMemClass.coe_zero]
    have hE1 : E 1 = 0 := by
      rw [hEdef, Derivation.map_one_eq_zero, map_zero, ZeroMemClass.coe_zero]
    have hEmul : ∀ a b, E (a * b) = σ₁ a * E b + σ₁ b * E a := by
      intro a b
      rw [hEdef, hEdef, hEdef, Derivation.leibniz, map_add, map_smul, map_smul,
        Submodule.coe_add, hsmul, hsmul]
    have hEE : ∀ a b, E a * E b = 0 := fun a b => by
      have h : E a * E b ∈ I * I := Ideal.mul_mem_mul (hEI a) (hEI b)
      rw [hI] at h
      exact (Submodule.mem_bot _).mp h
    let σ : K →+* R :=
      { toFun := fun a => σ₁ a + E a
        map_one' := by
          show σ₁ 1 + E 1 = 1
          rw [map_one, hE1, add_zero]
        map_mul' := fun a b => by
          show σ₁ (a * b) + E (a * b) = (σ₁ a + E a) * (σ₁ b + E b)
          rw [map_mul, hEmul]
          linear_combination -(hEE a b)
        map_zero' := by
          show σ₁ 0 + E 0 = 0
          rw [map_zero, hE0, add_zero]
        map_add' := fun a b => by
          show σ₁ (a + b) + E (a + b) = (σ₁ a + E a) + (σ₁ b + E b)
          rw [map_add, hEadd]
          ring }
    refine ⟨σ, fun a => ?_, fun j => ?_⟩
    · show σ₁ a + E a - σ₁ a ∈ I
      rw [add_sub_cancel_left]
      exact hEI a
    · show σ₁ (s j) + E (s j) = t j
      rw [hEdef, hℓv]
      show σ₁ (s j) + (t j - σ₁ (s j)) = t j
      ring

  intro p _ K _ _ R0 _ hpR0 π0 hsurj0 n0 hn0 J s hli t0 ht0
  have key : ∀ n : ℕ, ∀ (R : Type u) [CommRing R], (p : R) = 0 → ∀ π : R →+* K,
      Function.Surjective π → RingHom.ker π ^ n = ⊥ → ∀ t : J → R, (∀ j, π (t j) = s j) →
      ∃ σ : K →+* R, π.comp σ = RingHom.id K ∧ ∀ j, σ (s j) = t j := by
    intro n
    induction n with
    | zero =>
      intro R _ hpR π hsurj hn t ht
      exfalso
      rw [pow_zero, Ideal.one_eq_top] at hn
      have h1 : (1 : R) ∈ (⊥ : Ideal R) := hn ▸ Submodule.mem_top
      have h2 : (1 : R) = 0 := (Submodule.mem_bot _).mp h1
      have h3 : π 1 = 0 := by rw [h2, map_zero]
      rw [map_one] at h3
      exact one_ne_zero h3
    | succ m ih =>
      intro R _ hpR π hsurj hn t ht
      rcases Nat.eq_zero_or_pos m with hm0 | hm
      · subst hm0
        rw [zero_add, pow_one] at hn
        have hinj : Function.Injective π := (RingHom.injective_iff_ker_eq_bot π).mpr hn
        let e := RingEquiv.ofBijective π ⟨hinj, hsurj⟩
        refine ⟨e.symm.toRingHom, RingHom.ext fun a => e.apply_symm_apply a, fun j => ?_⟩
        apply hinj
        rw [ht j]
        exact e.apply_symm_apply (s j)
      · have hIN : RingHom.ker π ^ m ≤ RingHom.ker π := Ideal.pow_le_self (by omega)
        have hII : RingHom.ker π ^ m * RingHom.ker π ^ m = ⊥ := by
          rw [← pow_add]
          apply le_bot_iff.mp
          rw [← hn]
          exact Ideal.pow_le_pow_right (by omega)
        let I := RingHom.ker π ^ m
        let π' : R ⧸ I →+* K :=
          Ideal.Quotient.lift I π (fun a ha => (RingHom.mem_ker).mp (hIN ha))
        have hπ'mk : ∀ r, π' (Ideal.Quotient.mk I r) = π r := fun r =>
          Ideal.Quotient.lift_mk _ _ _
        have hπ'surj : Function.Surjective π' := fun y => by
          obtain ⟨r, hr⟩ := hsurj y
          exact ⟨_, (hπ'mk r).trans hr⟩
        have hpR' : (p : R ⧸ I) = 0 := by
          rw [← map_natCast (Ideal.Quotient.mk I), hpR, map_zero]
        have hkerπ' : RingHom.ker π' = (RingHom.ker π).map (Ideal.Quotient.mk I) :=
          Ideal.ker_quotient_lift _ _
        have hker' : RingHom.ker π' ^ m = ⊥ := by
          rw [hkerπ', ← Ideal.map_pow]
          exact Ideal.map_quotient_self I
        obtain ⟨σ', hσ', hσ's⟩ := ih (R ⧸ I) hpR' π' hπ'surj hker'
          (fun j => Ideal.Quotient.mk I (t j)) (fun j => by rw [hπ'mk, ht])
        haveI : Nontrivial R := π.domain_nontrivial
        haveI : CharP R p := (CharP.charP_iff_prime_eq_zero (Fact.out)).mpr hpR
        obtain ⟨σ₁, hσ₁⟩ := sLift p K R I hII σ'
        have hπσ₁ : ∀ a, π (σ₁ a) = a := fun a => by
          rw [← hπ'mk, hσ₁]
          exact RingHom.congr_fun hσ' a
        have hδ : ∀ j, t j - σ₁ (s j) ∈ I := fun j => by
          rw [← Ideal.Quotient.eq, hσ₁]
          exact (hσ's j).symm
        obtain ⟨σ, hσI, hσs⟩ := sCorr K R I hII σ₁ J s hli t hδ
        refine ⟨σ, RingHom.ext fun a => ?_, hσs⟩
        have h0 : π (σ a - σ₁ a) = 0 := (RingHom.mem_ker).mp (hIN (hσI a))
        rw [map_sub, hπσ₁, sub_eq_zero] at h0
        exact h0
  exact key n0 R0 hpR0 π0 hsurj0 hn0 t0 ht0

theorem wc_pfc_p_csa_cohen_claim : ∀ (k : Type u) [Field k] (p : ℕ) [Fact p.Prime] [CharP k p] (K : Type u) [Field K] [Algebra k K] (R : Type u) [CommRing R] [Algebra k R] (π : R →+* K), Function.Surjective π → π.comp (algebraMap k R) = algebraMap k K → ∀ (n : ℕ), RingHom.ker π ^ n = ⊥ → FiniteDimensional K (LinearMap.ker (KaehlerDifferential.mapBaseChange ℤ k K)) → ∀ (d : ℕ) (lam' : Fin d → R), Ideal.span (Set.range lam') = RingHom.ker π → ∃ σ : K →+* R, π.comp σ = RingHom.id K ∧ ∃ C₀ : Finset K, ∀ c : k, ∃ h : MvPolynomial (Fin d) (IntermediateField.adjoin k (C₀ : Set K)), MvPolynomial.eval₂Hom σ lam' (MvPolynomial.map (algebraMap (IntermediateField.adjoin k (C₀ : Set K)) K) h) = algebraMap k R c :=
by
  classical
  intro k _ p _ _ K _ _ R _ _ π hπsurj hπalg n hkerpow hfin d lam' hspan

  haveI : Nontrivial R := π.domain_nontrivial
  haveI hcharR : CharP R p := charP_of_injective_algebraMap (algebraMap k R).injective p
  haveI hcharK : CharP K p := charP_of_injective_algebraMap (algebraMap k K).injective p
  have hp : p.Prime := Fact.out
  have hnq : n ≤ p ^ n := (Nat.lt_pow_self hp.one_lt).le
  have hfrob : ∀ y z : R, y - z ∈ RingHom.ker π → y ^ (p ^ n) = z ^ (p ^ n) := by
    intro y z hyz
    have h0 : (y - z) ^ (p ^ n) = 0 := by
      have h1 : (y - z) ^ (p ^ n) ∈ RingHom.ker π ^ n :=
        Ideal.pow_le_pow_right hnq (Ideal.pow_mem_pow hyz _)
      rw [hkerpow] at h1
      exact Ideal.mem_bot.mp h1
    calc y ^ (p ^ n) = (z + (y - z)) ^ (p ^ n) := by congr 1; abel
      _ = z ^ (p ^ n) + (y - z) ^ (p ^ n) := add_pow_char_pow _ _ _ _
      _ = z ^ (p ^ n) := by rw [h0, add_zero]
  have hjR : ∀ c : k, π (algebraMap k R c) = algebraMap k K c :=
    fun c => RingHom.congr_fun hπalg c

  obtain ⟨b, hbsub, hbspan, hbli⟩ :=
    exists_linearIndependent k (Set.range (KaehlerDifferential.D ℤ k))
  have hpre : ∀ ω : b, ∃ y : k, KaehlerDifferential.D ℤ k y = ω := fun ω => by
    obtain ⟨y, hy⟩ := hbsub ω.2
    exact ⟨y, hy⟩
  choose β hβ using hpre
  have hfun : (fun i : b => KaehlerDifferential.D ℤ k (β i)) = Subtype.val := funext hβ
  have hLI : LinearIndependent k (fun i : b => KaehlerDifferential.D ℤ k (β i)) := by
    rw [hfun]; exact hbli
  have hSP : Submodule.span k (Set.range fun i : b => KaehlerDifferential.D ℤ k (β i)) = ⊤ := by
    rw [hfun, Subtype.range_coe, hbspan]
    exact KaehlerDifferential.span_range_derivation ℤ k

  obtain ⟨B₀, hB₀⟩ := wc_pfc_p_csa_exceptional_finite k K hfin b β hLI hSP

  obtain ⟨σ, hσ, hσpre⟩ := wc_pfc_p_csa_prescribed_section p K R (CharP.cast_eq_zero R p) π
    hπsurj n hkerpow {i : b // i ∉ B₀} (fun i => algebraMap k K (β i.1)) hB₀
    (fun i => algebraMap k R (β i.1)) (fun i => hjR _)
  have hσπ : ∀ z, π (σ z) = z := fun z => RingHom.congr_fun hσ z

  have hΨsurj := wc_pfc_p_csa_eval_surjective K R π σ hσ n hkerpow d lam' hspan
  choose P hP using fun i : b =>
    hΨsurj (algebraMap k R (β i) - σ (algebraMap k K (β i)))
  refine ⟨σ, hσ, B₀.biUnion (fun i => (P i).coeffs), ?_⟩

  let G : MvPolynomial (Fin d) (IntermediateField.adjoin k
      ((B₀.biUnion (fun i => (P i).coeffs) : Finset K) : Set K)) →+* R :=
    (MvPolynomial.eval₂Hom σ lam').comp (MvPolynomial.map (algebraMap _ K))
  have hG : ∀ h, G h = MvPolynomial.eval₂Hom σ lam' (MvPolynomial.map (algebraMap _ K) h) :=
    fun h => rfl
  have e1 : ∀ f ∈ IntermediateField.adjoin k
      ((B₀.biUnion (fun i => (P i).coeffs) : Finset K) : Set K), σ f ∈ G.range := by
    intro f hf
    refine RingHom.mem_range.mpr ⟨MvPolynomial.C ⟨f, hf⟩, ?_⟩
    rw [hG, MvPolynomial.map_C, MvPolynomial.eval₂Hom_C]
    rfl
  have e2 : ∀ i ∈ B₀, MvPolynomial.eval₂Hom σ lam' (P i) ∈ G.range := by
    intro i hi
    obtain ⟨h, hh⟩ := (MvPolynomial.mem_range_map_iff_coeffs_subset
      (f := algebraMap (IntermediateField.adjoin k
        ((B₀.biUnion (fun i => (P i).coeffs) : Finset K) : Set K)) K) (x := P i)).mpr
      (fun c hc => ⟨⟨c, IntermediateField.subset_adjoin k _
        (Finset.mem_coe.mpr (Finset.mem_biUnion.mpr ⟨i, hi, hc⟩))⟩, rfl⟩)
    exact RingHom.mem_range.mpr ⟨h, by rw [hG, hh]⟩
  let T : Subring k := Subring.comap (algebraMap k R) G.range
  have hT : ∀ c : k, c ∈ T ↔ algebraMap k R c ∈ G.range := fun c => Iff.rfl
  have hgen : Set.range (fun y : k => y ^ (p ^ n)) ∪ Set.range β ⊆ (T : Set k) := by
    rintro _ (⟨y, rfl⟩ | ⟨i, rfl⟩)
    · rw [SetLike.mem_coe, hT]
      have hy : algebraMap k R (y ^ (p ^ n)) = σ (algebraMap k K (y ^ (p ^ n))) := by
        rw [map_pow, map_pow, map_pow]
        apply hfrob
        rw [RingHom.mem_ker, map_sub, hjR, hσπ, sub_self]
      rw [hy]
      exact e1 _ (IntermediateField.algebraMap_mem _ _)
    · rw [SetLike.mem_coe, hT]
      by_cases hi : i ∈ B₀
      · have hb : algebraMap k R (β i) =
            σ (algebraMap k K (β i)) + MvPolynomial.eval₂Hom σ lam' (P i) := by
          rw [hP i]; abel
        rw [hb]
        exact add_mem (e1 _ (IntermediateField.algebraMap_mem _ _)) (e2 i hi)
      · have h1 := hσpre ⟨i, hi⟩
        simp only at h1
        rw [← h1]
        exact e1 _ (IntermediateField.algebraMap_mem _ _)
  have hcl := wc_pfc_p_csa_frobenius_generation p k b β hSP n
  have htop : T = ⊤ := by
    rw [eq_top_iff, ← hcl]
    exact Subring.closure_le.mpr hgen
  intro c
  have hc : c ∈ T := by rw [htop]; trivial
  rw [hT] at hc
  obtain ⟨h, hh⟩ := RingHom.mem_range.mp hc
  exact ⟨h, hh⟩

theorem wc_pfc_p_csa_local : ∀ (k₀ : Type u) [Field k₀] (K : Type u) [Field K] [Algebra k₀ K] (R : Type u) [CommRing R] [Algebra k₀ R] (π : R →+* K) (σ : K →+* R), π.comp σ = RingHom.id K → ∀ (n : ℕ), RingHom.ker π ^ n = ⊥ → ∀ (d : ℕ) (lam' : Fin d → R), Ideal.span (Set.range lam') = RingHom.ker π → ∀ (F : IntermediateField k₀ K) (D : Subalgebra k₀ R), (∀ x : R, x ∈ D ↔ ∃ h : MvPolynomial (Fin d) F, MvPolynomial.eval₂Hom σ lam' (MvPolynomial.map (algebraMap F K) h) = x) → ∃ (_ : IsLocalRing D), IsArtinianRing D ∧ IsLocalHom (algebraMap D R) ∧ Ideal.map (algebraMap D R) (IsLocalRing.maximalIdeal D) = RingHom.ker π ∧ (∀ x ∈ D, π x ∈ F) ∧ (∀ f ∈ F, σ f ∈ D) ∧ (∀ i, lam' i ∈ D) :=
by
  intro k₀ _ K _ _ R _ _ π σ hπσ n hn d lam' hspan F D hD
  have hσ : ∀ c, π (σ c) = c := fun c => RingHom.congr_fun hπσ c
  have hlamker : ∀ i, lam' i ∈ RingHom.ker π := by
    intro i
    rw [← hspan]
    exact Ideal.subset_span ⟨i, rfl⟩
  have hnil : ∀ z ∈ RingHom.ker π, z ^ n = 0 := by
    intro z hz
    have h1 : z ^ n ∈ RingHom.ker π ^ n := Ideal.pow_mem_pow hz n
    rw [hn] at h1
    exact Ideal.mem_bot.mp h1
  haveI : Nontrivial R := π.domain_nontrivial
  have hkey : π.comp (MvPolynomial.eval₂Hom σ lam') = MvPolynomial.constantCoeff := by
    apply MvPolynomial.ringHom_ext
    · intro c
      rw [RingHom.comp_apply, MvPolynomial.eval₂Hom_C, hσ, MvPolynomial.constantCoeff_C]
    · intro i
      rw [RingHom.comp_apply, MvPolynomial.eval₂Hom_X', (RingHom.mem_ker).mp (hlamker i),
        MvPolynomial.constantCoeff_X]
  have hπD : ∀ x ∈ D, π x ∈ F := by
    intro x hx
    obtain ⟨h, rfl⟩ := (hD x).mp hx
    have := RingHom.congr_fun hkey (MvPolynomial.map (algebraMap F K) h)
    rw [RingHom.comp_apply] at this
    rw [this, MvPolynomial.constantCoeff_map]
    exact (MvPolynomial.constantCoeff h).2
  have hσF : ∀ f ∈ F, σ f ∈ D := by
    intro f hf
    exact (hD _).mpr ⟨MvPolynomial.C ⟨f, hf⟩, by
      rw [MvPolynomial.map_C, MvPolynomial.eval₂Hom_C]; rfl⟩
  have hlamD : ∀ i, lam' i ∈ D := by
    intro i
    exact (hD _).mpr ⟨MvPolynomial.X i, by rw [MvPolynomial.map_X, MvPolynomial.eval₂Hom_X']⟩
  have hunit : ∀ a : D, IsUnit a ↔ π (a : R) ≠ 0 := by
    intro a
    constructor
    · intro ha
      exact ((ha.map D.val).map π).ne_zero
    · intro ha
      have hcF : π (a : R) ∈ F := hπD _ a.2
      have hciF : (π (a : R))⁻¹ ∈ F := F.inv_mem hcF
      let b : D := ⟨σ (π (a : R))⁻¹, hσF _ hciF⟩
      let z : D := a * b - 1
      have hz : ((z : D) : R) ∈ RingHom.ker π := by
        rw [RingHom.mem_ker]
        show π ((a : R) * σ (π (a : R))⁻¹ - 1) = 0
        rw [map_sub, map_mul, hσ, map_one, mul_inv_cancel₀ ha, sub_self]
      have hzn : IsNilpotent z := by
        refine ⟨n, ?_⟩
        apply Subtype.ext
        rw [SubmonoidClass.coe_pow]
        exact hnil _ hz
      have hab : IsUnit (a * b) := by
        have h1 := hzn.isUnit_one_add
        have h2 : (1 : D) + z = a * b := by
          simp only [z]
          ring
        rwa [h2] at h1
      exact isUnit_of_mul_isUnit_left hab
  haveI hloc : IsLocalRing D := IsLocalRing.of_nonunits_add (by
    intro a b ha hb
    have ha' : π (a : R) = 0 := by
      by_contra h
      exact (mem_nonunits_iff.mp ha) ((hunit a).mpr h)
    have hb' : π (b : R) = 0 := by
      by_contra h
      exact (mem_nonunits_iff.mp hb) ((hunit b).mpr h)
    rw [mem_nonunits_iff]
    intro hab
    apply (hunit _).mp hab
    show π ((a : R) + b) = 0
    rw [map_add, ha', hb', add_zero])
  have hmax : ∀ a : D, a ∈ IsLocalRing.maximalIdeal D ↔ π (a : R) = 0 := by
    intro a
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, hunit, not_not]
  have hlh : IsLocalHom (algebraMap D R) :=
    ⟨fun a ha => (hunit a).mpr (ha.map π).ne_zero⟩
  have hmap : Ideal.map (algebraMap D R) (IsLocalRing.maximalIdeal D) = RingHom.ker π := by
    apply le_antisymm
    · rw [Ideal.map_le_iff_le_comap]
      intro a ha
      rw [Ideal.mem_comap, RingHom.mem_ker]
      exact (hmax a).mp ha
    · rw [← hspan, Ideal.span_le]
      rintro _ ⟨i, rfl⟩
      have hm : (⟨lam' i, hlamD i⟩ : D) ∈ IsLocalRing.maximalIdeal D :=
        (hmax _).mpr ((RingHom.mem_ker).mp (hlamker i))
      exact Ideal.mem_map_of_mem _ hm
  obtain ⟨φ, hφ⟩ : ∃ φ : MvPolynomial (Fin d) F →+* D, Function.Surjective φ := by
    refine ⟨((MvPolynomial.eval₂Hom σ lam').comp
      (MvPolynomial.map (algebraMap F K))).codRestrict D (fun h => (hD _).mpr ⟨h, rfl⟩), ?_⟩
    rintro ⟨x, hx⟩
    obtain ⟨h, rfl⟩ := (hD x).mp hx
    exact ⟨h, rfl⟩
  haveI : IsNoetherianRing D := isNoetherianRing_of_surjective _ _ φ hφ
  have hpow : IsLocalRing.maximalIdeal D ^ n = ⊥ := by
    rw [eq_bot_iff]
    intro a ha
    have h1 : algebraMap D R a ∈
        Ideal.map (algebraMap D R) (IsLocalRing.maximalIdeal D ^ n) := Ideal.mem_map_of_mem _ ha
    rw [Ideal.map_pow, hmap, hn, Ideal.mem_bot] at h1
    rw [Ideal.mem_bot]
    exact Subtype.ext h1
  have hart : IsArtinianRing D :=
    (isArtinianRing_iff_isNilpotent_maximalIdeal D).mpr ⟨n, by rw [Ideal.zero_eq_bot]; exact hpow⟩
  exact ⟨hloc, hart, hlh, hmap, hπD, hσF, hlamD⟩

theorem wc_pfc_p_csa_flat : ∀ (k₀ : Type u) [Field k₀] (K : Type u) [Field K] [Algebra k₀ K] (R : Type u) [CommRing R] [Algebra k₀ R] (σ : K →+* R) (d : ℕ) (lam' : Fin d → R), Function.Surjective (MvPolynomial.eval₂Hom σ lam') → ∀ (F : IntermediateField k₀ K) (s : ℕ) (g : Fin s → MvPolynomial (Fin d) K), (∀ i, ((g i).coeffs : Set K) ⊆ Set.range (algebraMap F K)) → RingHom.ker (MvPolynomial.eval₂Hom σ lam') = Ideal.span (Set.range g) → ∀ (D : Subalgebra k₀ R), (∀ x : R, x ∈ D ↔ ∃ h : MvPolynomial (Fin d) F, MvPolynomial.eval₂Hom σ lam' (MvPolynomial.map (algebraMap F K) h) = x) → Module.Free D R :=
by
  classical
  intro k₀ _ K _ _ R _ _ σ d lam' hsurj F s g hcoef hker D hD
  have hdesc : ∀ i, ∃ y : MvPolynomial (Fin d) F, MvPolynomial.map (algebraMap F K) y = g i :=
    fun i => (MvPolynomial.mem_range_map_iff_coeffs_subset).mpr (hcoef i)
  choose g' hg' using hdesc
  have hg0 : ∀ l, MvPolynomial.eval₂Hom σ lam' (MvPolynomial.map (algebraMap F K) (g' l)) = 0 := by
    intro l
    rw [← RingHom.mem_ker, hker, hg']
    exact Ideal.subset_span ⟨l, rfl⟩
  obtain ⟨ι, ⟨b⟩⟩ : ∃ ι : Type u, Nonempty (Module.Basis ι F K) :=
    ⟨_, ⟨Module.Basis.ofVectorSpace F K⟩⟩
  let cf : ι → MvPolynomial (Fin d) K → MvPolynomial (Fin d) F := fun j P =>
    ∑ m ∈ P.support, MvPolynomial.monomial m (b.coord j (P.coeff m))
  have hcf : ∀ j P n, (cf j P).coeff n = b.coord j (P.coeff n) := by
    intro j P n
    simp only [cf, MvPolynomial.coeff_sum, MvPolynomial.coeff_monomial]
    rw [Finset.sum_ite_eq']
    split_ifs with hn
    · rfl
    · rw [MvPolynomial.notMem_support_iff.mp hn, map_zero]
  let comp : ι → MvPolynomial (Fin d) K →+ MvPolynomial (Fin d) F := fun j =>
    { toFun := cf j
      map_zero' := by
        refine MvPolynomial.ext _ _ (fun n => ?_)
        rw [hcf]
        simp
      map_add' := fun P Q => by
        refine MvPolynomial.ext _ _ (fun n => ?_)
        rw [hcf]
        simp [hcf] }
  have hC0 : ∀ j P n, (comp j P).coeff n = b.coord j (P.coeff n) := fun j P n => hcf j P n
  have ha : ∀ j (f : MvPolynomial (Fin d) F) (P : MvPolynomial (Fin d) K),
      comp j (MvPolynomial.map (algebraMap F K) f * P) = f * comp j P := by
    intro j f P
    refine MvPolynomial.ext _ _ (fun n => ?_)
    rw [hC0, MvPolynomial.coeff_mul, MvPolynomial.coeff_mul, map_sum]
    refine Finset.sum_congr rfl (fun x _ => ?_)
    rw [MvPolynomial.coeff_map, ← Algebra.smul_def, map_smul, smul_eq_mul, hC0]
  have hc1 : ∀ j (h : MvPolynomial (Fin d) F),
      comp j (MvPolynomial.C (b j) * MvPolynomial.map (algebraMap F K) h) = h := by
    intro j h
    refine MvPolynomial.ext _ _ (fun n => ?_)
    rw [hC0, MvPolynomial.coeff_C_mul, MvPolynomial.coeff_map, mul_comm, ← Algebra.smul_def,
      map_smul, Module.Basis.coord_apply, Module.Basis.repr_self, Finsupp.single_eq_same,
      smul_eq_mul, mul_one]
  have hc2 : ∀ i j (h : MvPolynomial (Fin d) F), i ≠ j →
      comp j (MvPolynomial.C (b i) * MvPolynomial.map (algebraMap F K) h) = 0 := by
    intro i j h hij
    refine MvPolynomial.ext _ _ (fun n => ?_)
    rw [hC0, MvPolynomial.coeff_C_mul, MvPolynomial.coeff_map, mul_comm, ← Algebra.smul_def,
      map_smul, Module.Basis.coord_apply, Module.Basis.repr_self, Finsupp.single_apply,
      if_neg hij, smul_zero]
    simp
  let v : ι → R := fun j => σ (b j)
  have hsmul : ∀ (δ : D) (r : R), δ • r = (δ : R) * r := fun δ r => rfl

  have hsp : ⊤ ≤ Submodule.span D (Set.range v) := by
    intro r _
    obtain ⟨P, rfl⟩ := hsurj r
    induction P using MvPolynomial.induction_on' with
    | monomial m c =>
      have hmono : MvPolynomial.monomial m c =
          MvPolynomial.C c * MvPolynomial.map (algebraMap F K) (MvPolynomial.monomial m 1) := by
        rw [MvPolynomial.map_monomial, map_one, MvPolynomial.C_mul_monomial, mul_one]
      have hc : c = ∑ j ∈ (b.repr c).support, (b.repr c) j • b j := by
        conv_lhs => rw [← b.linearCombination_repr c]
        rw [Finsupp.linearCombination_apply, Finsupp.sum]
      rw [hmono, map_mul, MvPolynomial.eval₂Hom_C, hc, map_sum, Finset.sum_mul]
      refine Submodule.sum_mem _ (fun j _ => ?_)
      have hmem : MvPolynomial.eval₂Hom σ lam' (MvPolynomial.map (algebraMap F K)
          (MvPolynomial.C ((b.repr c) j) * MvPolynomial.monomial m 1)) ∈ D :=
        (hD _).mpr ⟨_, rfl⟩
      have heq : σ ((b.repr c) j • b j) * MvPolynomial.eval₂Hom σ lam'
          (MvPolynomial.map (algebraMap F K) (MvPolynomial.monomial m 1)) =
          (⟨_, hmem⟩ : D) • v j := by
        rw [hsmul]
        show _ = MvPolynomial.eval₂Hom σ lam' (MvPolynomial.map (algebraMap F K)
          (MvPolynomial.C ((b.repr c) j) * MvPolynomial.monomial m 1)) * σ (b j)
        simp only [Algebra.smul_def, map_mul, MvPolynomial.map_C, MvPolynomial.eval₂Hom_C]
        ring
      rw [heq]
      exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨j, rfl⟩)
    | add P Q hP hQ =>
      rw [map_add]
      exact Submodule.add_mem _ (hP trivial) (hQ trivial)

  have hli : LinearIndependent D v := by
    rw [linearIndependent_iff']
    intro t c hrel j hj
    choose h hh using fun i => (hD _).mp (c i).2
    set Q : MvPolynomial (Fin d) K :=
      ∑ i ∈ t, MvPolynomial.C (b i) * MvPolynomial.map (algebraMap F K) (h i) with hQ
    have hΨQ : MvPolynomial.eval₂Hom σ lam' Q = 0 := by
      rw [hQ, map_sum]
      rw [← hrel]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [map_mul, MvPolynomial.eval₂Hom_C, hh, hsmul, mul_comm]
    have hQmem : Q ∈ Ideal.span (Set.range g) := by
      rw [← hker, RingHom.mem_ker]
      exact hΨQ
    obtain ⟨e, he⟩ := (Ideal.mem_span_range_iff_exists_fun).mp hQmem
    have h1 : comp j Q = h j := by
      rw [hQ, map_sum, Finset.sum_eq_single_of_mem j hj (fun i _ hij => hc2 i j _ hij), hc1]
    have h2 : comp j Q = ∑ l, g' l * comp j (e l) := by
      rw [← he, map_sum]
      refine Finset.sum_congr rfl (fun l _ => ?_)
      rw [← hg', mul_comm, ha]
    apply Subtype.ext
    rw [ZeroMemClass.coe_zero, ← hh, ← h1, h2, map_sum, map_sum]
    refine Finset.sum_eq_zero (fun l _ => ?_)
    rw [map_mul, map_mul, hg0, zero_mul]
  exact Module.Free.of_basis (Module.Basis.mk hli hsp)

theorem wc_pfc_p_csa_diff_span : ∀ (k : Type u) [Field k] (K : Type u) [Field K] [Algebra k K] (Z : Finset K) (w : K → K) (q : ℕ), (∀ z ∈ Z, w z ≠ 0) → ∀ (ν : Set (IntermediateField.adjoin k ((Z : Set K) ∪ (fun z => w z ^ q) '' (Z : Set K)))), (∀ z ∈ Z, ∃ a ∈ ν, (a : K) = z * w z ^ q) → (∀ z ∈ Z, ∃ a ∈ ν, (a : K) = w z ^ q) → Submodule.span (IntermediateField.adjoin k ((Z : Set K) ∪ (fun z => w z ^ q) '' (Z : Set K))) (KaehlerDifferential.D k (IntermediateField.adjoin k ((Z : Set K) ∪ (fun z => w z ^ q) '' (Z : Set K))) '' ν) = ⊤ :=
by
  intro k _ K _ _ Z w q hw ν h1 h2
  set N := Submodule.span (IntermediateField.adjoin k ((Z : Set K) ∪ (fun z => w z ^ q) '' (Z : Set K)))
    (KaehlerDifferential.D k (IntermediateField.adjoin k ((Z : Set K) ∪ (fun z => w z ^ q) '' (Z : Set K))) '' ν) with hN
  have key : ∀ (y : K) (hy : y ∈ IntermediateField.adjoin k ((Z : Set K) ∪ (fun z => w z ^ q) '' (Z : Set K))),
      KaehlerDifferential.D k (IntermediateField.adjoin k ((Z : Set K) ∪ (fun z => w z ^ q) '' (Z : Set K))) ⟨y, hy⟩ ∈ N := by
    intro y hy
    induction hy using IntermediateField.adjoin_induction with
    | mem x hx =>
      rcases hx with hx | ⟨z, hz, rfl⟩
      · have hz : x ∈ Z := Finset.mem_coe.mp hx
        obtain ⟨a, ha, hae⟩ := h1 x hz
        obtain ⟨b, hb, hbe⟩ := h2 x hz
        have hwq : w x ^ q ≠ 0 := pow_ne_zero q (hw x hz)
        have heq : ∀ h, (⟨x, h⟩ : IntermediateField.adjoin k ((Z : Set K) ∪ (fun z => w z ^ q) '' (Z : Set K))) = a * b⁻¹ := by
          intro h
          apply Subtype.ext
          rw [IntermediateField.coe_mul, IntermediateField.coe_inv, hae, hbe,
            mul_inv_cancel_right₀ hwq]
        rw [heq, Derivation.leibniz, Derivation.leibniz_inv]
        have hDa : KaehlerDifferential.D k (IntermediateField.adjoin k ((Z : Set K) ∪ (fun z => w z ^ q) '' (Z : Set K))) a ∈ N :=
          Submodule.subset_span ⟨a, ha, rfl⟩
        have hDb : KaehlerDifferential.D k (IntermediateField.adjoin k ((Z : Set K) ∪ (fun z => w z ^ q) '' (Z : Set K))) b ∈ N :=
          Submodule.subset_span ⟨b, hb, rfl⟩
        exact N.add_mem (N.smul_mem _ (N.smul_mem _ hDb)) (N.smul_mem _ hDa)
      · obtain ⟨b, hb, hbe⟩ := h2 z (Finset.mem_coe.mp hz)
        have heq : ∀ h, (⟨w z ^ q, h⟩ : IntermediateField.adjoin k ((Z : Set K) ∪ (fun z => w z ^ q) '' (Z : Set K))) = b :=
          fun h => Subtype.ext hbe.symm
        rw [heq]
        exact Submodule.subset_span ⟨b, hb, rfl⟩
    | algebraMap c =>
      have heq : ∀ h, (⟨algebraMap k K c, h⟩ : IntermediateField.adjoin k ((Z : Set K) ∪ (fun z => w z ^ q) '' (Z : Set K))) =
          algebraMap k (IntermediateField.adjoin k ((Z : Set K) ∪ (fun z => w z ^ q) '' (Z : Set K))) c := fun h => rfl
      rw [heq, Derivation.map_algebraMap]
      exact N.zero_mem
    | add x y hx hy ihx ihy =>
      have heq : ∀ h, (⟨x + y, h⟩ : IntermediateField.adjoin k ((Z : Set K) ∪ (fun z => w z ^ q) '' (Z : Set K))) =
          (⟨x, hx⟩ : IntermediateField.adjoin k ((Z : Set K) ∪ (fun z => w z ^ q) '' (Z : Set K))) + ⟨y, hy⟩ := fun h => rfl
      rw [heq, map_add]
      exact N.add_mem ihx ihy
    | inv x hx ih =>
      have heq : ∀ h, (⟨x⁻¹, h⟩ : IntermediateField.adjoin k ((Z : Set K) ∪ (fun z => w z ^ q) '' (Z : Set K))) =
          (⟨x, hx⟩ : IntermediateField.adjoin k ((Z : Set K) ∪ (fun z => w z ^ q) '' (Z : Set K)))⁻¹ := fun h => rfl
      rw [heq, Derivation.leibniz_inv]
      exact N.smul_mem _ ih
    | mul x y hx hy ihx ihy =>
      have heq : ∀ h, (⟨x * y, h⟩ : IntermediateField.adjoin k ((Z : Set K) ∪ (fun z => w z ^ q) '' (Z : Set K))) =
          (⟨x, hx⟩ : IntermediateField.adjoin k ((Z : Set K) ∪ (fun z => w z ^ q) '' (Z : Set K))) * ⟨y, hy⟩ := fun h => rfl
      rw [heq, Derivation.leibniz]
      exact N.add_mem (N.smul_mem _ ihy) (N.smul_mem _ ihx)
  rw [eq_top_iff, ← KaehlerDifferential.span_range_derivation k (IntermediateField.adjoin k ((Z : Set K) ∪ (fun z => w z ^ q) '' (Z : Set K))),
    Submodule.span_le]
  rintro _ ⟨x, rfl⟩
  exact key x.1 x.2

theorem wc_pfc_p_coefficient_subalgebra : ∀ (k : Type u) [Field k] (p : ℕ) [Fact p.Prime] [CharP k p] (Λ : Type u) [CommRing Λ] [IsNoetherianRing Λ] [Algebra k Λ] (𝔮 : Ideal Λ) [𝔮.IsPrime] (n : ℕ), 1 ≤ n → FiniteDimensional (IsLocalRing.ResidueField (Localization.AtPrime 𝔮)) (LinearMap.ker (KaehlerDifferential.mapBaseChange ℤ k (IsLocalRing.ResidueField (Localization.AtPrime 𝔮)))) → ∀ (E : Finset (Localization.AtPrime 𝔮 ⧸ IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) ^ n)), ∃ (D : Subalgebra k (Localization.AtPrime 𝔮 ⧸ IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) ^ n)) (_ : IsLocalRing D), IsArtinianRing D ∧ IsLocalHom (algebraMap D (Localization.AtPrime 𝔮 ⧸ IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) ^ n)) ∧ Module.Flat D (Localization.AtPrime 𝔮 ⧸ IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) ^ n) ∧ Ideal.map (algebraMap D (Localization.AtPrime 𝔮 ⧸ IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) ^ n)) (IsLocalRing.maximalIdeal D) = Ideal.map (Ideal.Quotient.mk (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) ^ n)) (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮)) ∧ (∀ e ∈ E, e ∈ D) ∧ ∃ (F : IntermediateField k (IsLocalRing.ResidueField (Localization.AtPrime 𝔮))), F.FG ∧ (∀ a : Localization.AtPrime 𝔮, Ideal.Quotient.mk (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) ^ n) a ∈ D → IsLocalRing.residue (Localization.AtPrime 𝔮) a ∈ F) ∧ (∀ f ∈ F, ∃ a : Localization.AtPrime 𝔮, Ideal.Quotient.mk (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) ^ n) a ∈ D ∧ IsLocalRing.residue (Localization.AtPrime 𝔮) a = f) ∧ ∃ (t : ℕ) (lam : Fin t → Λ) (μ : Fin t → F), (∀ j, Ideal.Quotient.mk (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) ^ n) (algebraMap Λ (Localization.AtPrime 𝔮) (lam j)) ∈ D) ∧ (∀ j, (μ j : IsLocalRing.ResidueField (Localization.AtPrime 𝔮)) = IsLocalRing.residue (Localization.AtPrime 𝔮) (algebraMap Λ (Localization.AtPrime 𝔮) (lam j))) ∧ LinearIndependent F (fun j => KaehlerDifferential.D k F (μ j)) ∧ Submodule.span F (Set.range fun j => KaehlerDifferential.D k F (μ j)) = ⊤ :=
by
  classical
  intro k _ p _ _ Λ _ _ _ 𝔮 _ n hn hfin E

  have tr : ∀ (K : Type u) [Field K] [Algebra k K] (i₁ i₂ : Algebra ℤ K)
      (t₁ : @IsScalarTower ℤ k K _ _ i₁.toSMul) (t₂ : @IsScalarTower ℤ k K _ _ i₂.toSMul),
      (letI := i₁; letI := t₁;
        FiniteDimensional K (LinearMap.ker (KaehlerDifferential.mapBaseChange ℤ k K))) →
      (letI := i₂; letI := t₂;
        FiniteDimensional K (LinearMap.ker (KaehlerDifferential.mapBaseChange ℤ k K))) := by
    intro K _ _ i₁ i₂ t₁ t₂ h
    have e : i₁ = i₂ := Subsingleton.elim _ _
    subst e
    exact h
  haveI : IsNoetherianRing (Localization.AtPrime 𝔮) :=
    IsLocalization.isNoetherianRing 𝔮.primeCompl _ inferInstance
  suffices main : ∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A] [Algebra k A]
      [Algebra Λ A] [IsLocalization 𝔮.primeCompl A],
      FiniteDimensional (IsLocalRing.ResidueField A)
        (LinearMap.ker (KaehlerDifferential.mapBaseChange ℤ k (IsLocalRing.ResidueField A))) →
      ∀ (E : Finset (A ⧸ IsLocalRing.maximalIdeal A ^ n)),
      ∃ (D : Subalgebra k (A ⧸ IsLocalRing.maximalIdeal A ^ n)) (_ : IsLocalRing D),
        IsArtinianRing D ∧ IsLocalHom (algebraMap D (A ⧸ IsLocalRing.maximalIdeal A ^ n)) ∧
        Module.Flat D (A ⧸ IsLocalRing.maximalIdeal A ^ n) ∧
        Ideal.map (algebraMap D (A ⧸ IsLocalRing.maximalIdeal A ^ n)) (IsLocalRing.maximalIdeal D) =
          Ideal.map (Ideal.Quotient.mk (IsLocalRing.maximalIdeal A ^ n)) (IsLocalRing.maximalIdeal A) ∧
        (∀ e ∈ E, e ∈ D) ∧
        ∃ (F : IntermediateField k (IsLocalRing.ResidueField A)), F.FG ∧
          (∀ a : A, Ideal.Quotient.mk (IsLocalRing.maximalIdeal A ^ n) a ∈ D →
            IsLocalRing.residue A a ∈ F) ∧
          (∀ f ∈ F, ∃ a : A, Ideal.Quotient.mk (IsLocalRing.maximalIdeal A ^ n) a ∈ D ∧
            IsLocalRing.residue A a = f) ∧
          ∃ (t : ℕ) (lam : Fin t → Λ) (μ : Fin t → F),
            (∀ j, Ideal.Quotient.mk (IsLocalRing.maximalIdeal A ^ n) (algebraMap Λ A (lam j)) ∈ D) ∧
            (∀ j, (μ j : IsLocalRing.ResidueField A) = IsLocalRing.residue A (algebraMap Λ A (lam j))) ∧
            LinearIndependent F (fun j => KaehlerDifferential.D k F (μ j)) ∧
            Submodule.span F (Set.range fun j => KaehlerDifferential.D k F (μ j)) = ⊤ by
    exact main (Localization.AtPrime 𝔮) (tr _ _ _ _ _ hfin) E
  clear hfin E
  intro A _ _ _ _ _ _ hfin E
  have hle : IsLocalRing.maximalIdeal A ^ n ≤ IsLocalRing.maximalIdeal A := Ideal.pow_le_self (by omega)
  have hp : p.Prime := Fact.out
  have hq1 : 1 ≤ p ^ n := Nat.one_le_pow _ _ hp.pos
  have hnq : n ≤ p ^ n := (Nat.lt_pow_self hp.one_lt).le

  obtain ⟨π, hπmk, hker⟩ : ∃ π : (A ⧸ IsLocalRing.maximalIdeal A ^ n) →+* IsLocalRing.ResidueField A,
      (∀ a, π (Ideal.Quotient.mk (IsLocalRing.maximalIdeal A ^ n) a) = IsLocalRing.residue A a) ∧
      RingHom.ker π = Ideal.map (Ideal.Quotient.mk (IsLocalRing.maximalIdeal A ^ n))
        (IsLocalRing.maximalIdeal A) :=
    ⟨Ideal.Quotient.factor hle, fun a => Ideal.Quotient.factor_mk hle a, Ideal.Quotient.factor_ker hle⟩
  have hπsurj : Function.Surjective π := by
    intro y
    obtain ⟨a, rfl⟩ := IsLocalRing.residue_surjective y
    exact ⟨_, hπmk a⟩
  have hkerpow : RingHom.ker π ^ n = ⊥ := by
    rw [hker, ← Ideal.map_pow, Ideal.map_quotient_self]
  have hπalg : π.comp (algebraMap k (A ⧸ IsLocalRing.maximalIdeal A ^ n)) =
      algebraMap k (IsLocalRing.ResidueField A) := by
    refine RingHom.ext fun c => ?_
    rw [RingHom.comp_apply, ← Ideal.Quotient.mk_algebraMap, hπmk]
    rfl

  have hfrob : ∀ y z : (A ⧸ IsLocalRing.maximalIdeal A ^ n),
      y - z ∈ RingHom.ker π → y ^ (p ^ n) = z ^ (p ^ n) := by
    intro y z hyz
    haveI : Nontrivial (A ⧸ IsLocalRing.maximalIdeal A ^ n) := π.domain_nontrivial
    haveI : CharP (A ⧸ IsLocalRing.maximalIdeal A ^ n) p :=
      charP_of_injective_algebraMap (algebraMap k _).injective p
    have h0 : (y - z) ^ (p ^ n) = 0 := by
      have h1 : (y - z) ^ (p ^ n) ∈ RingHom.ker π ^ n :=
        Ideal.pow_le_pow_right hnq (Ideal.pow_mem_pow hyz _)
      rw [hkerpow] at h1
      exact Ideal.mem_bot.mp h1
    calc y ^ (p ^ n) = (z + (y - z)) ^ (p ^ n) := by congr 1; abel
      _ = z ^ (p ^ n) + (y - z) ^ (p ^ n) := add_pow_char_pow _ _ _ _
      _ = z ^ (p ^ n) := by rw [h0, add_zero]

  obtain ⟨d, x, hx⟩ := Submodule.fg_iff_exists_fin_generating_family.mp
    (IsNoetherian.noetherian (IsLocalRing.maximalIdeal A))
  have hx' : Ideal.span (Set.range x) = IsLocalRing.maximalIdeal A := hx
  obtain ⟨lam', hlam'⟩ : ∃ lam' : Fin d → (A ⧸ IsLocalRing.maximalIdeal A ^ n),
      lam' = fun i => Ideal.Quotient.mk _ (x i) := ⟨_, rfl⟩
  have hspan : Ideal.span (Set.range lam') = RingHom.ker π := by
    have e : Ideal.map (Ideal.Quotient.mk (IsLocalRing.maximalIdeal A ^ n))
        (IsLocalRing.maximalIdeal A) = Ideal.map (Ideal.Quotient.mk (IsLocalRing.maximalIdeal A ^ n))
        (Ideal.span (Set.range x)) := by rw [hx']
    rw [hker, e, Ideal.map_span, hlam', ← Set.range_comp]
    rfl

  obtain ⟨σ, hσ, C₀, hC₀⟩ := wc_pfc_p_csa_cohen_claim k p (IsLocalRing.ResidueField A)
    (A ⧸ IsLocalRing.maximalIdeal A ^ n) π hπsurj hπalg n hkerpow hfin d lam' hspan
  have hσπ : ∀ z, π (σ z) = z := fun z => RingHom.congr_fun hσ z
  have hΨsurj := wc_pfc_p_csa_eval_surjective _ _ π σ hσ n hkerpow d lam' hspan

  obtain ⟨sg, g, hg⟩ := Submodule.fg_iff_exists_fin_generating_family.mp
    (IsNoetherian.noetherian (RingHom.ker (MvPolynomial.eval₂Hom σ lam')))
  have hg' : RingHom.ker (MvPolynomial.eval₂Hom σ lam') = Ideal.span (Set.range g) := hg.symm
  obtain ⟨P, hP⟩ : ∃ P : (A ⧸ IsLocalRing.maximalIdeal A ^ n) →
      MvPolynomial (Fin d) (IsLocalRing.ResidueField A),
      ∀ e, MvPolynomial.eval₂Hom σ lam' (P e) = e := ⟨_, Function.surjInv_eq hΨsurj⟩
  obtain ⟨Z, hC₀Z, hgZ, hEZ⟩ : ∃ Z : Finset (IsLocalRing.ResidueField A),
      C₀ ⊆ Z ∧ (∀ i, (g i).coeffs ⊆ Z) ∧ ∀ e ∈ E, (P e).coeffs ⊆ Z := by
    refine ⟨C₀ ∪ (Finset.univ.biUnion fun i => (g i).coeffs) ∪ E.biUnion fun e => (P e).coeffs,
      ?_, ?_, ?_⟩
    · intro c hc
      exact Finset.mem_union_left _ (Finset.mem_union_left _ hc)
    · intro i c hc
      exact Finset.mem_union_left _ (Finset.mem_union_right _
        (Finset.mem_biUnion.mpr ⟨i, Finset.mem_univ _, hc⟩))
    · intro e he c hc
      exact Finset.mem_union_right _ (Finset.mem_biUnion.mpr ⟨e, he, hc⟩)

  choose X hX using fun z : IsLocalRing.ResidueField A =>
    Ideal.Quotient.mk_surjective (I := IsLocalRing.maximalIdeal A ^ n) (σ z)
  have hfrac : ∀ z, ∃ (a : Λ) (s : 𝔮.primeCompl), IsLocalization.mk' A a s = X z := by
    intro z
    obtain ⟨⟨a, s⟩, h⟩ := IsLocalization.mk'_surjective 𝔮.primeCompl (X z)
    exact ⟨a, s, h⟩
  choose a s hs using hfrac
  obtain ⟨w, hwdef⟩ : ∃ w : IsLocalRing.ResidueField A → IsLocalRing.ResidueField A, ∀ z,
      w z = IsLocalRing.residue A (algebraMap Λ A (s z)) := ⟨_, fun z => rfl⟩
  have hw0 : ∀ z, w z ≠ 0 := by
    intro z
    rw [hwdef]
    exact ((IsLocalization.map_units A (s z)).map (IsLocalRing.residue A)).ne_zero

  obtain ⟨F', hF'⟩ : ∃ F' : IntermediateField k (IsLocalRing.ResidueField A),
      F' = IntermediateField.adjoin k ((Z : Set (IsLocalRing.ResidueField A)) ∪
        (fun z => w z ^ (p ^ n)) '' (Z : Set (IsLocalRing.ResidueField A))) := ⟨_, rfl⟩
  have hZF : ∀ z ∈ Z, z ∈ F' := fun z hz => by
    rw [hF']
    exact IntermediateField.subset_adjoin k _ (Set.mem_union_left _ (Finset.mem_coe.mpr hz))
  have hwF : ∀ z ∈ Z, w z ^ (p ^ n) ∈ F' := fun z hz => by
    rw [hF']
    exact IntermediateField.subset_adjoin k _ (Set.mem_union_right _ ⟨z, Finset.mem_coe.mpr hz, rfl⟩)
  have hFG : F'.FG := by
    have := IntermediateField.fg_adjoin_finset (F := k) (Z ∪ Z.image (fun z => w z ^ (p ^ n)))
    rw [Finset.coe_union, Finset.coe_image] at this
    rw [hF']
    exact this
  have hC₀F : IntermediateField.adjoin k (C₀ : Set (IsLocalRing.ResidueField A)) ≤ F' :=
    IntermediateField.adjoin_le_iff.mpr fun z hz => hZF z (hC₀Z hz)
  have hincl : (algebraMap F' (IsLocalRing.ResidueField A)).comp
      ((IntermediateField.inclusion hC₀F : _ →ₐ[k] F') : _ →+* F') =
      algebraMap (IntermediateField.adjoin k (C₀ : Set (IsLocalRing.ResidueField A)))
        (IsLocalRing.ResidueField A) :=
    RingHom.ext fun _ => rfl
  obtain ⟨D, hDmem⟩ : ∃ D : Subalgebra k (A ⧸ IsLocalRing.maximalIdeal A ^ n),
      ∀ y, y ∈ D ↔ ∃ h : MvPolynomial (Fin d) F', MvPolynomial.eval₂Hom σ lam'
        (MvPolynomial.map (algebraMap F' (IsLocalRing.ResidueField A)) h) = y := by
    refine ⟨{ carrier := Set.range fun h : MvPolynomial (Fin d) F' =>
                MvPolynomial.eval₂Hom σ lam' (MvPolynomial.map (algebraMap F' (IsLocalRing.ResidueField A)) h)
              mul_mem' := ?_
              one_mem' := ⟨1, by simp⟩
              add_mem' := ?_
              zero_mem' := ⟨0, by simp⟩
              algebraMap_mem' := ?_ }, fun y => Iff.rfl⟩
    · rintro _ _ ⟨h₁, rfl⟩ ⟨h₂, rfl⟩
      exact ⟨h₁ * h₂, by simp⟩
    · rintro _ _ ⟨h₁, rfl⟩ ⟨h₂, rfl⟩
      exact ⟨h₁ + h₂, by simp⟩
    · intro c
      obtain ⟨h, hh⟩ := hC₀ c
      refine ⟨MvPolynomial.map ((IntermediateField.inclusion hC₀F : _ →ₐ[k] F') : _ →+* F') h, ?_⟩
      show MvPolynomial.eval₂Hom σ lam' (MvPolynomial.map (algebraMap F' (IsLocalRing.ResidueField A))
        (MvPolynomial.map ((IntermediateField.inclusion hC₀F : _ →ₐ[k] F') : _ →+* F') h)) = _
      rw [MvPolynomial.map_map, hincl]
      exact hh

  obtain ⟨hDloc, hDart, hDlh, hDmax, hDres, hσD, -⟩ :=
    wc_pfc_p_csa_local k _ _ π σ hσ n hkerpow d lam' hspan F' D hDmem
  haveI hfree : Module.Free D (A ⧸ IsLocalRing.maximalIdeal A ^ n) :=
    wc_pfc_p_csa_flat k _ _ σ d lam' hΨsurj F' sg g
      (fun i c hc => ⟨⟨c, hZF c (hgZ i hc)⟩, rfl⟩) hg' D hDmem

  have key1 : ∀ z, Ideal.Quotient.mk (IsLocalRing.maximalIdeal A ^ n)
      (algebraMap Λ A ((s z : Λ) ^ (p ^ n))) = σ (w z ^ (p ^ n)) := by
    intro z
    rw [map_pow (algebraMap Λ A), map_pow (Ideal.Quotient.mk _), map_pow σ]
    apply hfrob
    rw [RingHom.mem_ker, map_sub, hπmk, hσπ, hwdef, sub_self]
  have key2 : ∀ z, algebraMap Λ A (a z * (s z : Λ) ^ (p ^ n - 1)) =
      X z * algebraMap Λ A ((s z : Λ) ^ (p ^ n)) := by
    intro z
    rw [← hs z, map_mul, ← IsLocalization.mk'_spec A (a z) (s z),
      mul_assoc, ← map_mul (algebraMap Λ A), ← pow_succ', Nat.sub_add_cancel hq1]
  obtain ⟨lamF, cval, hcl, hcr, hcF, hmk⟩ : ∃ (lamF : {z // z ∈ Z} ⊕ {z // z ∈ Z} → Λ)
      (cval : {z // z ∈ Z} ⊕ {z // z ∈ Z} → IsLocalRing.ResidueField A),
      (∀ z : {z // z ∈ Z}, cval (Sum.inl z) = z.1 * w z.1 ^ (p ^ n)) ∧
      (∀ z : {z // z ∈ Z}, cval (Sum.inr z) = w z.1 ^ (p ^ n)) ∧
      (∀ i, cval i ∈ F') ∧
      ∀ i, Ideal.Quotient.mk (IsLocalRing.maximalIdeal A ^ n)
        (algebraMap Λ A (lamF i)) = σ (cval i) := by
    refine ⟨Sum.elim (fun z => a z.1 * (s z.1 : Λ) ^ (p ^ n - 1)) (fun z => (s z.1 : Λ) ^ (p ^ n)),
      Sum.elim (fun z => z.1 * w z.1 ^ (p ^ n)) (fun z => w z.1 ^ (p ^ n)),
      fun z => rfl, fun z => rfl, ?_, ?_⟩
    · rintro (z | z)
      · exact mul_mem (hZF _ z.2) (hwF _ z.2)
      · exact hwF _ z.2
    · rintro (z | z)
      · show Ideal.Quotient.mk (IsLocalRing.maximalIdeal A ^ n)
          (algebraMap Λ A (a z.1 * (s z.1 : Λ) ^ (p ^ n - 1))) = σ (z.1 * w z.1 ^ (p ^ n))
        rw [key2, map_mul (Ideal.Quotient.mk _), hX, key1, map_mul σ]
      · exact key1 _

  have s6' : ∀ (G : IntermediateField k (IsLocalRing.ResidueField A)),
      G = IntermediateField.adjoin k ((Z : Set (IsLocalRing.ResidueField A)) ∪
        (fun z => w z ^ (p ^ n)) '' (Z : Set (IsLocalRing.ResidueField A))) →
      ∀ ν : Set G, (∀ z ∈ Z, ∃ a ∈ ν, (a : IsLocalRing.ResidueField A) = z * w z ^ (p ^ n)) →
        (∀ z ∈ Z, ∃ a ∈ ν, (a : IsLocalRing.ResidueField A) = w z ^ (p ^ n)) →
        Submodule.span G (KaehlerDifferential.D k G '' ν) = ⊤ := by
    rintro G rfl ν h1 h2
    exact wc_pfc_p_csa_diff_span k _ Z w (p ^ n) (fun z _ => hw0 z) ν h1 h2
  let μF : ({z // z ∈ Z} ⊕ {z // z ∈ Z}) → F' := fun i => ⟨cval i, hcF i⟩
  have hspan6 := s6' F' hF' (Set.range μF)
    (fun z hz => ⟨μF (Sum.inl ⟨z, hz⟩), ⟨_, rfl⟩, hcl ⟨z, hz⟩⟩)
    (fun z hz => ⟨μF (Sum.inr ⟨z, hz⟩), ⟨_, rfl⟩, hcr ⟨z, hz⟩⟩)
  have h6' : Submodule.span F' (KaehlerDifferential.D k F' '' Set.range μF) = ⊤ := hspan6
  have hspanF : Submodule.span F' (Set.range fun i => KaehlerDifferential.D k F' (μF i)) = ⊤ := by
    rw [← Set.range_comp] at h6'
    exact h6'
  obtain ⟨κ, a', ha'inj, hsp, hli⟩ :=
    exists_linearIndependent' F' (fun i => KaehlerDifferential.D k F' (μF i))
  haveI : Finite κ := Finite.of_injective a' ha'inj
  let eqv : Fin (Nat.card κ) ≃ κ := (Finite.equivFin κ).symm
  refine ⟨D, hDloc, hDart, hDlh, Module.Flat.of_free, hDmax.trans hker, ?_, F', hFG, ?_, ?_,
    Nat.card κ, fun j => lamF (a' (eqv j)), fun j => μF (a' (eqv j)), ?_, ?_, ?_, ?_⟩
  · intro e he
    obtain ⟨h, hh⟩ := (MvPolynomial.mem_range_map_iff_coeffs_subset (f := algebraMap F'
      (IsLocalRing.ResidueField A)) (x := P e)).mpr
      (fun c hc => ⟨⟨c, hZF c (hEZ e he hc)⟩, rfl⟩)
    exact (hDmem e).mpr ⟨h, by rw [hh, hP]⟩
  · intro y hy
    rw [← hπmk]
    exact hDres _ hy
  · intro f hf
    exact ⟨X f, by rw [hX]; exact hσD f hf, by rw [← hπmk, hX, hσπ]⟩
  · intro j
    rw [hmk]
    exact hσD _ (hcF _)
  · intro j
    show cval _ = _
    rw [← hπmk, hmk, hσπ]
  · exact hli.comp eqv eqv.injective
  · have e : Set.range (fun j => KaehlerDifferential.D k F' (μF (a' (eqv j)))) =
        Set.range ((fun i => KaehlerDifferential.D k F' (μF i)) ∘ a') :=
      eqv.surjective.range_comp ((fun i => KaehlerDifferential.D k F' (μF i)) ∘ a')
    rw [e, hsp, hspanF]

theorem wc_pfc_p_field_formally_smooth : ∀ (p : ℕ) [Fact p.Prime] (K : Type u) [Field K] [CharP K p], @Algebra.FormallySmooth (ZMod p) K _ _ (ZMod.algebra K p) :=
by

  have s1 : ∀ (p : ℕ) [Fact p.Prime] (B : Type u) [CommRing B] [CharP B p] (I : Ideal B),
      I ^ 2 = ⊥ → ∃ φ : B ⧸ I →+* B, ∀ b : B, φ (Ideal.Quotient.mk I b) = b ^ p := by
    intro p _ B _ _ I hI
    have hp := (Fact.out : p.Prime)
    have H : ∀ a ∈ I, frobenius B p a = 0 := by
      intro a ha
      rw [frobenius_def]
      have h2 : a ^ 2 = 0 := by
        have : a ^ 2 ∈ I ^ 2 := Ideal.pow_mem_pow ha 2
        rw [hI] at this
        exact (Submodule.mem_bot _).mp this
      have : p = 2 + (p - 2) := by have := hp.two_le; omega
      rw [this, pow_add, h2, zero_mul]
    exact ⟨Ideal.Quotient.lift I (frobenius B p) H, fun b => by
      rw [Ideal.Quotient.lift_mk, frobenius_def]⟩

  have s3 : ∀ (K : Type u) [Field K] (B : Type u) [CommRing B]
      (c : Set (Σ L : Subfield K, (L →+* B))), c.Nonempty →
      (∀ x ∈ c, ∀ y ∈ c, (x.1 ≤ y.1 ∧ ∀ (z : x.1) (w : y.1), (z : K) = w → y.2 w = x.2 z) ∨
        (y.1 ≤ x.1 ∧ ∀ (z : y.1) (w : x.1), (z : K) = w → x.2 w = y.2 z)) →
      ∃ (M : Subfield K) (hM : M →+* B),
        (∀ x ∈ c, x.1 ≤ M ∧ ∀ (z : x.1) (w : M), (z : K) = w → hM w = x.2 z) ∧
        ∀ w : M, ∃ x ∈ c, (w : K) ∈ x.1 := by
    intro K _ B _ c hne hc
    classical
    have K1 : ∀ x ∈ c, ∀ y ∈ c, ∀ (z : x.1) (w : y.1), (z : K) = w → x.2 z = y.2 w := by
      intro x hx y hy z w hzw
      rcases hc x hx y hy with ⟨_, h⟩ | ⟨_, h⟩
      · exact (h z w hzw).symm
      · exact h w z hzw.symm
    have : Nonempty c := hne.to_subtype
    let S : c → Subfield K := fun i => i.1.1
    have hdir : Directed (· ≤ ·) S := by
      intro i j
      rcases hc i.1 i.2 j.1 j.2 with ⟨h, _⟩ | ⟨h, _⟩
      · exact ⟨j, h, le_rfl⟩
      · exact ⟨i, le_rfl, h⟩
    let M : Subfield K := ⨆ i, S i
    have hmem : ∀ w : K, w ∈ M ↔ ∃ i : c, w ∈ S i := fun w => Subfield.mem_iSup_of_directed hdir
    let wit : M → c := fun w => ((hmem w.1).mp w.2).choose
    have wit_spec : ∀ w : M, (w : K) ∈ (wit w).1.1 := fun w => ((hmem w.1).mp w.2).choose_spec
    let F : M → B := fun w => (wit w).1.2 ⟨w, wit_spec w⟩
    have hF : ∀ (x) (hx : x ∈ c) (z : x.1) (w : M), (z : K) = w → F w = x.2 z := by
      intro x hx z w hzw
      exact K1 _ (wit w).2 x hx _ z hzw.symm
    have two : ∀ w₁ w₂ : M, ∃ x ∈ c, (w₁ : K) ∈ x.1 ∧ (w₂ : K) ∈ x.1 := by
      intro w₁ w₂
      rcases hc (wit w₁).1 (wit w₁).2 (wit w₂).1 (wit w₂).2 with ⟨h, _⟩ | ⟨h, _⟩
      · exact ⟨_, (wit w₂).2, h (wit_spec w₁), wit_spec w₂⟩
      · exact ⟨_, (wit w₁).2, wit_spec w₁, h (wit_spec w₂)⟩
    obtain ⟨x₀, hx₀⟩ := hne
    let hM : M →+* B :=
      { toFun := F
        map_one' := by
          show F 1 = 1
          rw [hF x₀ hx₀ 1 1 rfl, map_one]
        map_mul' := by
          intro w₁ w₂
          show F (w₁ * w₂) = F w₁ * F w₂
          obtain ⟨x, hx, h1, h2⟩ := two w₁ w₂
          rw [hF x hx ⟨_, h1⟩ w₁ rfl, hF x hx ⟨_, h2⟩ w₂ rfl,
            hF x hx (⟨_, h1⟩ * ⟨_, h2⟩) (w₁ * w₂) rfl, map_mul]
        map_zero' := by
          show F 0 = 0
          rw [hF x₀ hx₀ 0 0 rfl, map_zero]
        map_add' := by
          intro w₁ w₂
          show F (w₁ + w₂) = F w₁ + F w₂
          obtain ⟨x, hx, h1, h2⟩ := two w₁ w₂
          rw [hF x hx ⟨_, h1⟩ w₁ rfl, hF x hx ⟨_, h2⟩ w₂ rfl,
            hF x hx (⟨_, h1⟩ + ⟨_, h2⟩) (w₁ + w₂) rfl, map_add] }
    refine ⟨M, hM, fun x hx => ⟨?_, fun z w hzw => hF x hx z w hzw⟩,
      fun w => ⟨(wit w).1, (wit w).2, wit_spec w⟩⟩
    intro a ha
    exact (hmem a).mpr ⟨⟨x, hx⟩, ha⟩

  have s2 : ∀ (p : ℕ) [Fact p.Prime] (K : Type u) [Field K] [CharP K p] (B : Type u) [CommRing B]
      (I : Ideal B) (g : K →+* B ⧸ I) (L : Subfield K) (h : L →+* B), (∀ a : K, a ^ p ∈ L) →
      (∀ z : L, Ideal.Quotient.mk I (h z) = g z) →
      (∀ (z : L) (a : K) (b : B), (z : K) = a ^ p → Ideal.Quotient.mk I b = g a → h z = b ^ p) →
      ∀ a : K, ∃ (L' : Subfield K) (h' : L' →+* B), L ≤ L' ∧ a ∈ L' ∧
        (∀ (z : L) (w : L'), (z : K) = w → h' w = h z) ∧
        ∀ w : L', Ideal.Quotient.mk I (h' w) = g w := by
    intro p _ K _ _ B _ I g L h hp1 hlift hfrob a
    classical
    have hp := (Fact.out : p.Prime)
    by_cases haL : a ∈ L
    · refine ⟨L, h, le_rfl, haL, fun z w hzw => ?_, hlift⟩
      rw [Subtype.ext hzw]
    · let c : L := ⟨a ^ p, hp1 a⟩
      have hirr : Irreducible (Polynomial.X ^ p - Polynomial.C c) := by
        apply X_pow_sub_C_irreducible_of_prime hp
        intro y hy
        apply haL
        have h1 : (y : K) ^ p = a ^ p := by
          have := congrArg (fun t : L => (t : K)) hy
          simpa [c] using this
        have h2 : (y : K) = a := frobenius_inj K p (by simpa [frobenius_def] using h1)
        rw [← h2]; exact y.2
      have hmon : (Polynomial.X ^ p - Polynomial.C c).Monic :=
        Polynomial.monic_X_pow_sub_C c hp.ne_zero
      have haev : Polynomial.aeval a (Polynomial.X ^ p - Polynomial.C c) = 0 := by
        rw [map_sub, map_pow, Polynomial.aeval_X, Polynomial.aeval_C]
        exact sub_eq_zero.mpr rfl
      have hint : IsIntegral L a := ⟨_, hmon, by rwa [Polynomial.aeval_def] at haev⟩
      have hmin : Polynomial.X ^ p - Polynomial.C c = minpoly L a :=
        minpoly.eq_of_irreducible_of_monic hirr haev hmon
      obtain ⟨b, hb⟩ := Ideal.Quotient.mk_surjective (g a)
      have hhc : h c = b ^ p := hfrob c a b rfl hb
      have hev : Polynomial.eval₂ h b (minpoly L a) = 0 := by
        rw [← hmin]; simp [hhc]
      let ψ := AdjoinRoot.lift h b hev
      let E := IntermediateField.adjoin L {a}
      let e := IntermediateField.adjoinRootEquivAdjoin L hint
      let L' := E.toSubfield
      let ι : L' →+* E :=
        { toFun := fun w => ⟨w.1, (IntermediateField.mem_toSubfield _ _).mp w.2⟩
          map_one' := Subtype.ext rfl
          map_mul' := fun _ _ => Subtype.ext rfl
          map_zero' := Subtype.ext rfl
          map_add' := fun _ _ => Subtype.ext rfl }
      let h' : L' →+* B := ψ.comp (e.symm.toAlgHom.toRingHom.comp ι)
      have hofz : ∀ z : L, e.symm (algebraMap L E z) = AdjoinRoot.of _ z := by
        intro z
        rw [AlgEquiv.commutes, AdjoinRoot.algebraMap_eq]
      have f12 : (Ideal.Quotient.mk I).comp ψ =
          g.comp ((E.val : E →ₐ[L] K).toRingHom.comp e.toAlgHom.toRingHom) := by
        apply AdjoinRoot.ringHom_ext
        · ext z
          simp only [RingHom.comp_apply]
          rw [AdjoinRoot.lift_of, hlift]
          congr 1
          rw [← AdjoinRoot.algebraMap_eq]
          show z.1 = ((e (algebraMap L _ z) : E) : K)
          rw [AlgEquiv.commutes]
          rfl
        · simp only [RingHom.comp_apply]
          rw [AdjoinRoot.lift_root, hb]
          congr 1
          show a = ((e (AdjoinRoot.root _) : E) : K)
          rw [IntermediateField.adjoinRootEquivAdjoin_apply_root]
          rfl
      refine ⟨L', h', ?_, ?_, ?_, ?_⟩
      · intro z hz
        exact (IntermediateField.mem_toSubfield _ _).mpr
          (IntermediateField.algebraMap_mem E (⟨z, hz⟩ : L))
      · exact (IntermediateField.mem_toSubfield _ _).mpr
          (IntermediateField.mem_adjoin_simple_self L a)
      · intro z w hzw
        have hιw : ι w = algebraMap L E z := Subtype.ext hzw.symm
        show ψ (e.symm (ι w)) = h z
        rw [hιw, hofz, AdjoinRoot.lift_of]
      · intro w
        have := RingHom.congr_fun f12 (e.symm (ι w))
        show Ideal.Quotient.mk I (ψ (e.symm (ι w))) = g w
        rw [show Ideal.Quotient.mk I (ψ (e.symm (ι w))) =
          ((Ideal.Quotient.mk I).comp ψ) (e.symm (ι w)) from rfl, this]
        show g ((e (e.symm (ι w)) : E) : K) = g w
        rw [AlgEquiv.apply_symm_apply]
        rfl

  have s4 : ∀ (K : Type u) [Field K] (B : Type u) [CommRing B]
      (P : (Σ L : Subfield K, (L →+* B)) → Prop), (∃ x, P x) →
      (∀ c : Set (Σ L : Subfield K, (L →+* B)), c.Nonempty → (∀ x ∈ c, P x) →
        (∀ x ∈ c, ∀ y ∈ c, (x.1 ≤ y.1 ∧ ∀ (z : x.1) (w : y.1), (z : K) = w → y.2 w = x.2 z) ∨
          (y.1 ≤ x.1 ∧ ∀ (z : y.1) (w : x.1), (z : K) = w → x.2 w = y.2 z)) →
        ∃ u, P u ∧ ∀ x ∈ c, x.1 ≤ u.1 ∧ ∀ (z : x.1) (w : u.1), (z : K) = w → u.2 w = x.2 z) →
      (∀ x, P x → ∀ a : K, ∃ y, P y ∧
        (x.1 ≤ y.1 ∧ ∀ (z : x.1) (w : y.1), (z : K) = w → y.2 w = x.2 z) ∧ a ∈ y.1) →
      ∃ x, P x ∧ ∀ a : K, a ∈ x.1 := by
    intro K _ B _ P hne hch hext
    let _ : Preorder (Σ L : Subfield K, (L →+* B)) :=
      { le := fun x y => x.1 ≤ y.1 ∧ ∀ (z : x.1) (w : y.1), (z : K) = w → y.2 w = x.2 z
        le_refl := fun x => ⟨le_rfl, fun z w hzw => by rw [Subtype.ext hzw]⟩
        le_trans := fun x y v hxy hyv => ⟨hxy.1.trans hyv.1, fun z w hzw => by
          rw [hyv.2 ⟨z, hxy.1 z.2⟩ w hzw, hxy.2 z ⟨z, hxy.1 z.2⟩ rfl]⟩ }
    obtain ⟨x₀, hx₀⟩ := hne
    obtain ⟨m, -, hm⟩ := zorn_le_nonempty₀ {x | P x} (fun c hcs hchain y hy =>
      hch c ⟨y, hy⟩ hcs (fun x hx y hy => hchain.total hx hy)) x₀ hx₀
    refine ⟨m, hm.prop, fun a => ?_⟩
    obtain ⟨y, hy, hmy, hay⟩ := hext m hm.prop a
    exact (hm.2 hy hmy).1 hay

  intro p _ K _ _
  letI := ZMod.algebra K p
  apply Algebra.FormallySmooth.of_comp_surjective
  intro B _ _ I hI g
  by_cases hB : Subsingleton B
  · let f0 : K →+* B :=
      { toFun := fun _ => 0
        map_one' := Subsingleton.elim _ _
        map_mul' := fun _ _ => Subsingleton.elim _ _
        map_zero' := rfl
        map_add' := fun _ _ => Subsingleton.elim _ _ }
    refine ⟨{ f0 with commutes' := fun _ => Subsingleton.elim _ _ }, ?_⟩
    have : Subsingleton (B ⧸ I) := ⟨fun x y => by
      obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective x
      obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective y
      rw [Subsingleton.elim x y]⟩
    ext x
    exact Subsingleton.elim _ _
  · rw [not_subsingleton_iff_nontrivial] at hB
    have : CharP B p := charP_of_injective_algebraMap (algebraMap (ZMod p) B).injective p
    obtain ⟨φ, hφ⟩ := s1 p B I hI
    let g₀ : K →+* B ⧸ I := g.toRingHom
    let P : (Σ L : Subfield K, (L →+* B)) → Prop := fun x =>
      (∀ a : K, a ^ p ∈ x.1) ∧ (∀ z : x.1, Ideal.Quotient.mk I (x.2 z) = g₀ z) ∧
      (∀ (z : x.1) (a : K) (b : B), (z : K) = a ^ p → Ideal.Quotient.mk I b = g₀ a →
        x.2 z = b ^ p)
    have hP0 : ∃ x, P x := by
      let F₀ := (frobenius K p).fieldRange
      let e := (frobenius K p).rangeRestrictFieldEquiv
      have he : ∀ c : K, ((e c : F₀) : K) = c ^ p := fun c => by
        rw [RingHom.rangeRestrictFieldEquiv_apply_coe, frobenius_def]
      refine ⟨⟨F₀, φ.comp (g₀.comp (e.symm : F₀ →+* K))⟩, ?_, ?_, ?_⟩
      · intro a
        exact RingHom.mem_fieldRange.mpr ⟨a, frobenius_def p a⟩
      · intro z
        obtain ⟨b, hb⟩ := Ideal.Quotient.mk_surjective (g₀ (e.symm z))
        show Ideal.Quotient.mk I (φ (g₀ (e.symm z))) = g₀ z
        rw [← hb, hφ, map_pow, hb, ← map_pow]
        congr 1
        rw [← he, RingEquiv.apply_symm_apply]
      · intro z a b hz hb
        show φ (g₀ (e.symm z)) = b ^ p
        have : e.symm z = a := by
          apply frobenius_inj K p
          rw [frobenius_def, frobenius_def, ← he, RingEquiv.apply_symm_apply, hz]
        rw [this, ← hb, hφ]
    have hchain : ∀ c : Set (Σ L : Subfield K, (L →+* B)), c.Nonempty → (∀ x ∈ c, P x) →
        (∀ x ∈ c, ∀ y ∈ c, (x.1 ≤ y.1 ∧ ∀ (z : x.1) (w : y.1), (z : K) = w → y.2 w = x.2 z) ∨
          (y.1 ≤ x.1 ∧ ∀ (z : y.1) (w : x.1), (z : K) = w → x.2 w = y.2 z)) →
        ∃ u, P u ∧ ∀ x ∈ c, x.1 ≤ u.1 ∧ ∀ (z : x.1) (w : u.1), (z : K) = w → u.2 w = x.2 z := by
      intro c hne hcP hcc
      obtain ⟨M, hM, hub, hwit⟩ := s3 K B c hne hcc
      refine ⟨⟨M, hM⟩, ⟨?_, ?_, ?_⟩, hub⟩
      · intro a
        obtain ⟨x₀, hx₀⟩ := hne
        exact (hub x₀ hx₀).1 ((hcP x₀ hx₀).1 a)
      · intro w
        obtain ⟨x, hx, hwx⟩ := hwit w
        show Ideal.Quotient.mk I (hM w) = g₀ w
        rw [(hub x hx).2 ⟨w, hwx⟩ w rfl]
        exact (hcP x hx).2.1 ⟨w, hwx⟩
      · intro w a b hw hb
        obtain ⟨x, hx, hwx⟩ := hwit w
        show hM w = b ^ p
        rw [(hub x hx).2 ⟨w, hwx⟩ w rfl]
        exact (hcP x hx).2.2 ⟨w, hwx⟩ a b hw hb
    have hext : ∀ x, P x → ∀ a : K, ∃ y, P y ∧
        (x.1 ≤ y.1 ∧ ∀ (z : x.1) (w : y.1), (z : K) = w → y.2 w = x.2 z) ∧ a ∈ y.1 := by
      rintro ⟨L, h⟩ ⟨hP1, hP2, hP3⟩ a
      obtain ⟨L', h', hLL', haL', hcomp, hlift⟩ := s2 p K B I g₀ L h hP1 hP2 hP3 a
      refine ⟨⟨L', h'⟩, ⟨fun a' => hLL' (hP1 a'), hlift, ?_⟩, ⟨hLL', hcomp⟩, haL'⟩
      intro w a' b hw hb
      show h' w = b ^ p
      rw [hcomp ⟨a' ^ p, hP1 a'⟩ w hw.symm]
      exact hP3 _ a' b rfl hb
    obtain ⟨m, hmP, htop⟩ := s4 K B P hP0 hchain hext
    let f₀ : K →+* B := m.2.comp (RingHom.codRestrict (RingHom.id K) m.1 htop)
    refine ⟨{ f₀ with commutes' := fun r => ?_ }, ?_⟩
    · exact RingHom.congr_fun
        (RingHom.ext_zmod (f₀.comp (algebraMap (ZMod p) K)) (algebraMap (ZMod p) B)) r
    · ext x
      show Ideal.Quotient.mk I (m.2 ⟨x, htop x⟩) = g x
      exact hmP.2.1 ⟨x, htop x⟩

theorem wc_pfc_p_s0_derivation_of_section : ∀ (B : Type u) [CommRing B] [IsLocalRing B] (σ : IsLocalRing.ResidueField B →+* B ⧸ IsLocalRing.maximalIdeal B ^ 2), (∀ b : B, σ (IsLocalRing.residue B b) - Ideal.Quotient.mk (IsLocalRing.maximalIdeal B ^ 2) b ∈ Ideal.map (Ideal.Quotient.mk (IsLocalRing.maximalIdeal B ^ 2)) (IsLocalRing.maximalIdeal B)) → ∀ f : IsLocalRing.CotangentSpace B →ₗ[IsLocalRing.ResidueField B] IsLocalRing.ResidueField B, ∃ δ : Derivation ℤ B (IsLocalRing.ResidueField B), ∀ (x : B) (hx : x ∈ IsLocalRing.maximalIdeal B), δ x = f ((IsLocalRing.maximalIdeal B).toCotangent ⟨x, hx⟩) :=
by
  intro B _ _ σ hσ f
  have hlift : ∀ b : B, ∃ x ∈ IsLocalRing.maximalIdeal B,
      Ideal.Quotient.mk (IsLocalRing.maximalIdeal B ^ 2) x =
        Ideal.Quotient.mk (IsLocalRing.maximalIdeal B ^ 2) b - σ (IsLocalRing.residue B b) := by
    intro b
    have h := neg_mem (hσ b)
    rw [neg_sub] at h
    exact (Ideal.mem_map_iff_of_surjective _ Ideal.Quotient.mk_surjective).mp h
  choose xb hxm hxq using hlift
  obtain ⟨δ₀, hδ₀⟩ : ∃ δ₀ : B → IsLocalRing.ResidueField B, ∀ b,
      δ₀ b = f ((IsLocalRing.maximalIdeal B).toCotangent ⟨xb b, hxm b⟩) := ⟨_, fun _ => rfl⟩
  have hC : ∀ (b x : B) (hx : x ∈ IsLocalRing.maximalIdeal B),
      Ideal.Quotient.mk (IsLocalRing.maximalIdeal B ^ 2) x =
        Ideal.Quotient.mk (IsLocalRing.maximalIdeal B ^ 2) b - σ (IsLocalRing.residue B b) →
      δ₀ b = f ((IsLocalRing.maximalIdeal B).toCotangent ⟨x, hx⟩) := by
    intro b x hx h
    rw [hδ₀]
    congr 1
    rw [Ideal.toCotangent_eq]
    exact Ideal.Quotient.eq.mp ((hxq b).trans h.symm)
  have hadd : ∀ a b, δ₀ (a + b) = δ₀ a + δ₀ b := by
    intro a b
    rw [hC (a + b) (xb a + xb b) (add_mem (hxm a) (hxm b))
      (by simp only [map_add, hxq]; ring), hδ₀, hδ₀]
    have e : (⟨xb a + xb b, add_mem (hxm a) (hxm b)⟩ : IsLocalRing.maximalIdeal B) =
        ⟨xb a, hxm a⟩ + ⟨xb b, hxm b⟩ := rfl
    rw [e, map_add, map_add]
  have hleib : ∀ a b, δ₀ (a * b) = a • δ₀ b + b • δ₀ a := by
    intro a b
    have hx : a * xb b + b * xb a ∈ IsLocalRing.maximalIdeal B :=
      add_mem (Ideal.mul_mem_left _ a (hxm b)) (Ideal.mul_mem_left _ b (hxm a))
    have hzero : Ideal.Quotient.mk (IsLocalRing.maximalIdeal B ^ 2) (xb a * xb b) = 0 := by
      rw [Ideal.Quotient.eq_zero_iff_mem, pow_two]
      exact Ideal.mul_mem_mul (hxm a) (hxm b)
    have hq : Ideal.Quotient.mk (IsLocalRing.maximalIdeal B ^ 2) (a * xb b + b * xb a) =
        Ideal.Quotient.mk (IsLocalRing.maximalIdeal B ^ 2) (a * b) -
          σ (IsLocalRing.residue B (a * b)) := by
      rw [map_mul, hxq, hxq] at hzero
      simp only [map_add, map_mul, hxq]
      linear_combination hzero
    rw [hC (a * b) _ hx hq, hδ₀, hδ₀]
    have e : (⟨a * xb b + b * xb a, hx⟩ : IsLocalRing.maximalIdeal B) =
        a • ⟨xb b, hxm b⟩ + b • ⟨xb a, hxm a⟩ := rfl
    rw [e, map_add, map_smul, map_smul, map_add, LinearMap.map_smul_of_tower,
      LinearMap.map_smul_of_tower]
  let D : B →ₗ[ℤ] IsLocalRing.ResidueField B := (AddMonoidHom.mk' δ₀ hadd).toIntLinearMap
  refine ⟨Derivation.mk' D (fun a b => hleib a b), ?_⟩
  intro x hx
  show δ₀ x = _
  exact hC x x hx (by rw [(IsLocalRing.residue_eq_zero_iff x).mpr hx, map_zero, sub_zero])

theorem wc_pfc_p_s0_chain_rule : ∀ (k : Type u) [CommRing k] (R : Type u) [CommRing R] [Algebra k R] (M : Type u) [AddCommGroup M] [Module R M] (D : Derivation ℤ R M) (t : ℕ) (z : Fin t → R) (G : MvPolynomial (Fin t) k), D (MvPolynomial.aeval z G) = ∑ j, MvPolynomial.aeval z (MvPolynomial.pderiv j G) • D (z j) + ∑ α ∈ G.support, MvPolynomial.aeval z (MvPolynomial.monomial α (1 : k)) • D (algebraMap k R (G.coeff α)) :=
by
  intro k _ R _ _ M _ _ D t z G
  classical
  have s2 : ∀ α : Fin t →₀ ℕ, D (MvPolynomial.aeval z (MvPolynomial.monomial α (1 : k))) =
      ∑ j, MvPolynomial.aeval z (MvPolynomial.pderiv j (MvPolynomial.monomial α (1 : k))) • D (z j) := by
    intro α
    induction α using Finsupp.induction with
    | zero =>
      rw [MvPolynomial.monomial_zero', MvPolynomial.C_1, map_one, Derivation.map_one_eq_zero]
      simp
    | single_add a b f ha hb ih =>
      rw [MvPolynomial.monomial_single_add]
      have e1 : ∀ j, MvPolynomial.aeval z (MvPolynomial.pderiv j
          (MvPolynomial.X a ^ b * MvPolynomial.monomial f (1:k))) =
          (if a = j then (b : R) * z a ^ (b - 1) else 0) *
            MvPolynomial.aeval z (MvPolynomial.monomial f (1:k)) +
          z a ^ b * MvPolynomial.aeval z (MvPolynomial.pderiv j (MvPolynomial.monomial f (1:k))) := by
        intro j
        rw [Derivation.leibniz, Derivation.leibniz_pow, MvPolynomial.pderiv_X, Pi.single_apply]
        by_cases haj : a = j
        · subst haj
          simp only [ite_true, smul_eq_mul, map_add, map_mul, map_pow, MvPolynomial.aeval_X,
            mul_one, nsmul_eq_mul, map_natCast]
          ring
        · simp only [haj, ite_false, smul_eq_mul, map_add, map_mul, map_pow,
            MvPolynomial.aeval_X, mul_zero, smul_zero, map_zero, zero_mul]
          ring
      simp only [e1, add_smul, Finset.sum_add_distrib, ite_mul, zero_mul, ite_smul, zero_smul,
        Finset.sum_ite_eq, Finset.mem_univ, ite_true, mul_smul, ← Finset.smul_sum]
      rw [map_mul, map_pow, MvPolynomial.aeval_X, Derivation.leibniz, Derivation.leibniz_pow, ih]
      module
  have s3 : ∀ (α : Fin t →₀ ℕ) (c : k), D (MvPolynomial.aeval z (MvPolynomial.monomial α c)) =
      ∑ j, MvPolynomial.aeval z (MvPolynomial.pderiv j (MvPolynomial.monomial α c)) • D (z j) +
        MvPolynomial.aeval z (MvPolynomial.monomial α (1 : k)) • D (algebraMap k R c) := by
    intro α c
    have hm : (MvPolynomial.monomial α c : MvPolynomial (Fin t) k) =
        MvPolynomial.C c * MvPolynomial.monomial α 1 := by
      rw [MvPolynomial.C_mul_monomial, mul_one]
    rw [hm, map_mul, MvPolynomial.aeval_C, Derivation.leibniz, s2 α]
    simp only [MvPolynomial.pderiv_C_mul, map_mul, MvPolynomial.aeval_C, mul_smul,
      ← Finset.smul_sum]
  have hG := MvPolynomial.as_sum G
  have hp : ∀ j, MvPolynomial.pderiv j G =
      ∑ α ∈ G.support, MvPolynomial.pderiv j (MvPolynomial.monomial α (G.coeff α)) := by
    intro j
    conv_lhs => rw [hG]
    exact map_sum _ _ _
  conv_lhs => rw [hG]
  rw [map_sum, map_sum]
  simp only [s3, Finset.sum_add_distrib]
  congr 1
  simp only [hp, map_sum, Finset.sum_smul]
  exact Finset.sum_comm

theorem wc_pfc_p_s0_extend_derivation : ∀ (k : Type u) [Field k] (Λ : Type u) [CommRing Λ] [Algebra k Λ] (𝔮 : Ideal Λ) [𝔮.IsPrime], (∀ (r : ℕ) (c : Fin r → IsLocalRing.ResidueField (Localization.AtPrime 𝔮)) (a : Fin r → k), ∑ i, TensorProduct.tmul (Localization.AtPrime 𝔮) (c i) (KaehlerDifferential.D ℤ (Localization.AtPrime 𝔮) (algebraMap k (Localization.AtPrime 𝔮) (a i))) = 0 → ∑ i, TensorProduct.tmul k (c i) (KaehlerDifferential.D ℤ k (a i)) = 0) → ∀ ε : k → IsLocalRing.ResidueField (Localization.AtPrime 𝔮), (∀ a b, ε (a + b) = ε a + ε b) → (∀ a b, ε (a * b) = algebraMap k (IsLocalRing.ResidueField (Localization.AtPrime 𝔮)) a * ε b + algebraMap k (IsLocalRing.ResidueField (Localization.AtPrime 𝔮)) b * ε a) → ∃ Δ : Derivation ℤ (Localization.AtPrime 𝔮) (IsLocalRing.ResidueField (Localization.AtPrime 𝔮)), ∀ a : k, Δ (algebraMap k (Localization.AtPrime 𝔮) a) = ε a :=
by
  classical
  intro k _ Λ _ _ 𝔮 _ hinj ε hadd hmul

  have s1 : ∀ (K : Type u) [Field K] (V : Type u) [AddCommGroup V] [Module K V] (ι : Type u)
      (v : ι → V) (e : ι → K), (∀ (r : ℕ) (c : Fin r → K) (a : Fin r → ι),
        ∑ i, c i • v (a i) = 0 → ∑ i, c i * e (a i) = 0) → ∃ ℓ : V →ₗ[K] K, ∀ i, ℓ (v i) = e i := by
    intro K _ V _ _ ι v e H
    have key : ∀ (S : Finset ι) (c : ι → K), ∑ i ∈ S, c i • v i = 0 →
        ∑ i ∈ S, c i * e i = 0 := by
      intro S c h
      rw [← Finset.sum_coe_sort] at h ⊢
      rw [← Equiv.sum_comp S.equivFin.symm] at h ⊢
      exact H _ (fun j => c (S.equivFin.symm j)) (fun j => (S.equivFin.symm j : ι)) h
    let Φ : (ι →₀ K) →ₗ[K] V := Finsupp.linearCombination K v
    let Ψ : (ι →₀ K) →ₗ[K] K := Finsupp.linearCombination K e
    have hb : LinearMap.ker Φ ≤ LinearMap.ker Ψ := by
      intro w hw
      rw [LinearMap.mem_ker] at hw ⊢
      simp only [Φ, Ψ, Finsupp.linearCombination_apply, Finsupp.sum, smul_eq_mul] at hw ⊢
      exact key _ _ hw
    let ψ₁ := (LinearMap.ker Φ).liftQ Ψ hb
    let ψ₀ : ↥(LinearMap.range Φ) →ₗ[K] K := ψ₁ ∘ₗ Φ.quotKerEquivRange.symm.toLinearMap
    obtain ⟨ℓ, hℓ⟩ := LinearMap.exists_extend ψ₀
    refine ⟨ℓ, fun i => ?_⟩
    have h1 := LinearMap.congr_fun hℓ ⟨Φ (Finsupp.single i 1), LinearMap.mem_range_self _ _⟩
    simp only [LinearMap.comp_apply, Submodule.subtype_apply, ψ₀, LinearEquiv.coe_coe,
      LinearMap.quotKerEquivRange_symm_apply_image, ψ₁] at h1
    simpa [Φ, Ψ] using h1

  have s2 : ∀ (K : Type u) [Field K] [Algebra k K] (ε : k → K),
      (∀ a b, ε (a + b) = ε a + ε b) →
      (∀ a b, ε (a * b) = algebraMap k K a * ε b + algebraMap k K b * ε a) →
      ∀ (r : ℕ) (c : Fin r → K) (a : Fin r → k),
        ∑ i, TensorProduct.tmul k (c i) (KaehlerDifferential.D ℤ k (a i)) = 0 →
        ∑ i, c i * ε (a i) = 0 := by
    intro K _ _ ε hadd hmul r c a h
    let ε' : Derivation ℤ k K := Derivation.mk' (AddMonoidHom.mk' ε hadd).toIntLinearMap
      (fun a b => by
        show ε (a * b) = a • ε b + b • ε a
        rw [Algebra.smul_def, Algebra.smul_def]
        exact hmul a b)
    have hε' : ∀ x, ε' x = ε x := fun x => rfl
    have h2 := congrArg (LinearMap.liftBaseChange K ε'.liftKaehlerDifferential) h
    rw [map_sum, map_zero] at h2
    simp only [LinearMap.liftBaseChange_tmul, Derivation.liftKaehlerDifferential_comp_D,
      smul_eq_mul, hε'] at h2
    exact h2

  let v : k → TensorProduct (Localization.AtPrime 𝔮) (IsLocalRing.ResidueField (Localization.AtPrime 𝔮))
      (KaehlerDifferential ℤ (Localization.AtPrime 𝔮)) := fun a =>
    TensorProduct.tmul (Localization.AtPrime 𝔮) (1 : IsLocalRing.ResidueField (Localization.AtPrime 𝔮))
      (KaehlerDifferential.D ℤ (Localization.AtPrime 𝔮) (algebraMap k (Localization.AtPrime 𝔮) a))
  obtain ⟨ℓ, hℓ⟩ := s1 _ _ k v ε (by
    intro r c a h
    have h' : ∑ i, TensorProduct.tmul (Localization.AtPrime 𝔮) (c i)
        (KaehlerDifferential.D ℤ (Localization.AtPrime 𝔮) (algebraMap k (Localization.AtPrime 𝔮) (a i))) = 0 := by
      rw [← h]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      simp only [v, TensorProduct.smul_tmul', smul_eq_mul, mul_one]
    exact s2 _ ε hadd hmul r c a (hinj r c a h'))

  let f : KaehlerDifferential ℤ (Localization.AtPrime 𝔮) →ₗ[Localization.AtPrime 𝔮]
      IsLocalRing.ResidueField (Localization.AtPrime 𝔮) :=
    (ℓ.restrictScalars (Localization.AtPrime 𝔮)).comp
      (TensorProduct.mk (Localization.AtPrime 𝔮) (IsLocalRing.ResidueField (Localization.AtPrime 𝔮))
        (KaehlerDifferential ℤ (Localization.AtPrime 𝔮)) 1)
  let g : Localization.AtPrime 𝔮 →+ IsLocalRing.ResidueField (Localization.AtPrime 𝔮) :=
    f.toAddMonoidHom.comp (KaehlerDifferential.D ℤ (Localization.AtPrime 𝔮)).toAddMonoidHom
  have hg : ∀ x, g x = f (KaehlerDifferential.D ℤ (Localization.AtPrime 𝔮) x) := fun x => rfl
  have mk : ∀ (A M : Type u) [CommRing A] [AddCommGroup M] [Module A M] (I : Algebra ℤ A)
      (g : A →+ M), (∀ x y, g (x * y) = x • g y + y • g x) →
      ∃ D : @Derivation ℤ A M _ _ _ I _ _, ∀ x, D x = g x := by
    intro A M _ _ _ I g hl
    have h : I = Ring.toIntAlgebra A := Subsingleton.elim _ _
    subst h
    exact ⟨Derivation.mk' g.toIntLinearMap hl, fun _ => rfl⟩
  have leib : ∀ (A M : Type u) [CommRing A] [AddCommGroup M] [Module A M] (I : Algebra ℤ A)
      (J : Module ℤ M) (D : @Derivation ℤ A M _ _ _ I _ J) (x y : A),
      D (x * y) = x • D y + y • D x := fun _ _ _ _ _ _ _ D x y => D.leibniz x y
  obtain ⟨Δ, hΔ⟩ := mk _ _ _ g (fun x y => by
    have hD := leib _ _ _ _ (KaehlerDifferential.D ℤ (Localization.AtPrime 𝔮)) x y
    rw [hg, hg, hg, hD, map_add, map_smul, map_smul])
  exact ⟨Δ, fun a => by rw [hΔ]; exact hℓ a⟩

theorem wc_pfc_p_stage0_cotangent_indep : ∀ (k : Type u) [Field k] (p : ℕ) [Fact p.Prime] [CharP k p] (Λ : Type u) [CommRing Λ] [IsNoetherianRing Λ] [Algebra k Λ] (𝔮 : Ideal Λ) [𝔮.IsPrime], (∀ (r : ℕ) (c : Fin r → IsLocalRing.ResidueField (Localization.AtPrime 𝔮)) (a : Fin r → k), ∑ i, TensorProduct.tmul (Localization.AtPrime 𝔮) (c i) (KaehlerDifferential.D ℤ (Localization.AtPrime 𝔮) (algebraMap k (Localization.AtPrime 𝔮) (a i))) = 0 → ∑ i, TensorProduct.tmul k (c i) (KaehlerDifferential.D ℤ k (a i)) = 0) → ∀ (F : IntermediateField k (IsLocalRing.ResidueField (Localization.AtPrime 𝔮))) (t : ℕ) (lam : Fin t → Λ) (μ : Fin t → F), (∀ j, (μ j : IsLocalRing.ResidueField (Localization.AtPrime 𝔮)) = IsLocalRing.residue (Localization.AtPrime 𝔮) (algebraMap Λ (Localization.AtPrime 𝔮) (lam j))) → LinearIndependent F (fun j => KaehlerDifferential.D k F (μ j)) → ∃ (r : ℕ) (G : Fin r → MvPolynomial (Fin t) k), r = Submodule.spanFinrank (IsLocalRing.maximalIdeal (Localization.AtPrime (𝔮.comap (MvPolynomial.aeval (R := k) lam).toRingHom))) ∧ (∀ i, MvPolynomial.aeval (R := k) lam (G i) ∈ 𝔮) ∧ ∀ c : Fin r → Localization.AtPrime 𝔮, ∑ i, c i * algebraMap Λ (Localization.AtPrime 𝔮) (MvPolynomial.aeval (R := k) lam (G i)) ∈ IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) ^ 2 → ∀ i, c i ∈ IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) :=
by
  intro k _ p _ _ Λ _ _ _ 𝔮 _ hinj F t lam μ hμ hli
  classical


  have Dconv : ∀ (A M : Type u) [CommRing A] [AddCommGroup M] [Module A M] (I : Algebra ℤ A)
      (D : @Derivation ℤ A M _ _ _ I _ _),
      ∃ D' : @Derivation ℤ A M _ _ _ (Ring.toIntAlgebra A) _ _, ∀ x, D' x = D x := by
    intro A M _ _ _ I D
    have h : I = Ring.toIntAlgebra A := Subsingleton.elim _ _
    subst h
    exact ⟨D, fun _ => rfl⟩

  have Eps : ∀ (B : Type u) [CommRing B] [IsLocalRing B] [Algebra k B]
      (L : Type u) [Field L] [Algebra k L]
      (δ' : Derivation ℤ B (IsLocalRing.ResidueField B)) (ρ' : IsLocalRing.ResidueField B →+* L),
      (∀ a : k, ρ' (IsLocalRing.residue B (algebraMap k B a)) = algebraMap k L a) →
      ∀ a b : k, ρ' (δ' (algebraMap k B (a * b))) =
        algebraMap k L a * ρ' (δ' (algebraMap k B b)) +
        algebraMap k L b * ρ' (δ' (algebraMap k B a)) := by
    intro B _ _ _ L _ _ δ' ρ' hst a b
    rw [map_mul, Derivation.leibniz, Algebra.smul_def, Algebra.smul_def,
      IsLocalRing.ResidueField.algebraMap_eq, map_add, map_mul, map_mul, hst, hst]


  have TS4 : ∀ (B : Type u) [CommRing B] [IsLocalRing B] [IsNoetherianRing B] (ι : Type u)
      (g : ι → B) (hg : ∀ i, g i ∈ IsLocalRing.maximalIdeal B),
      Ideal.span (Set.range g) = IsLocalRing.maximalIdeal B →
      ∃ (r : ℕ) (s : Fin r → ι), r = Submodule.spanFinrank (IsLocalRing.maximalIdeal B) ∧
      ∀ i₀ : Fin r, ∃ f : IsLocalRing.CotangentSpace B →ₗ[IsLocalRing.ResidueField B]
        IsLocalRing.ResidueField B, ∀ i : Fin r,
        f ((IsLocalRing.maximalIdeal B).toCotangent ⟨g (s i), hg (s i)⟩) =
          if i = i₀ then 1 else 0 := by
    intro B _ _ _ ι g hg hspan
    let v : ι → IsLocalRing.CotangentSpace B :=
      fun i => (IsLocalRing.maximalIdeal B).toCotangent ⟨g i, hg i⟩
    have hv : Submodule.span (IsLocalRing.ResidueField B) (Set.range v) = ⊤ := by
      have hspan' : Submodule.span B
          (Set.range (fun i => (⟨g i, hg i⟩ : IsLocalRing.maximalIdeal B))) = ⊤ := by
        apply Submodule.map_injective_of_injective (IsLocalRing.maximalIdeal B).injective_subtype
        rw [Submodule.map_span, Submodule.map_top, Submodule.range_subtype, ← Set.range_comp]
        exact hspan
      have h := (IsLocalRing.CotangentSpace.span_image_eq_top_iff
        (s := Set.range (fun i => (⟨g i, hg i⟩ : IsLocalRing.maximalIdeal B)))).mpr hspan'
      rw [← Set.range_comp] at h
      exact h
    obtain ⟨b, hbsub, hbspan, hbli⟩ :=
      exists_linearIndependent (IsLocalRing.ResidueField B) (Set.range v)
    haveI : Finite b := hbli.finite
    let r := Nat.card b
    let e : Fin r ≃ b := (Finite.equivFin b).symm
    have hli' : LinearIndependent (IsLocalRing.ResidueField B)
        (fun i : Fin r => (e i : IsLocalRing.CotangentSpace B)) :=
      hbli.comp e e.injective
    have hsp : ⊤ ≤ Submodule.span (IsLocalRing.ResidueField B)
        (Set.range fun i : Fin r => (e i : IsLocalRing.CotangentSpace B)) := by
      have : Set.range (fun i : Fin r => (e i : IsLocalRing.CotangentSpace B)) = b := by
        ext x
        constructor
        · rintro ⟨i, rfl⟩; exact (e i).2
        · intro hx; exact ⟨e.symm ⟨x, hx⟩, by simp⟩
      rw [this, hbspan, hv]
    let 𝔟 := Module.Basis.mk hli' hsp
    have hmem : ∀ i : Fin r, ∃ j, v j = (e i : IsLocalRing.CotangentSpace B) :=
      fun i => hbsub (e i).2
    choose s hs using hmem
    refine ⟨r, s, ?_, ?_⟩
    · rw [IsLocalRing.spanFinrank_maximalIdeal_eq_finrank_cotangentSpace,
        Module.finrank_eq_card_basis 𝔟, Fintype.card_fin]
    · intro i₀
      refine ⟨𝔟.coord i₀, fun i => ?_⟩
      have h1 : (IsLocalRing.maximalIdeal B).toCotangent ⟨g (s i), hg (s i)⟩ = 𝔟 i := by
        rw [Module.Basis.mk_apply]
        exact hs i
      rw [h1, Module.Basis.coord_apply, Module.Basis.repr_self, Finsupp.single_apply]



  have Q1 : ∀ (B : Type u) [CommRing B] [IsLocalRing B] [Algebra k B]
      (f : IsLocalRing.CotangentSpace B →ₗ[IsLocalRing.ResidueField B] IsLocalRing.ResidueField B),
      ∃ δ : Derivation ℤ B (IsLocalRing.ResidueField B),
        ∀ (x : B) (hx : x ∈ IsLocalRing.maximalIdeal B),
        δ x = f ((IsLocalRing.maximalIdeal B).toCotangent ⟨x, hx⟩) := by
    intro B _ _ _ f
    let π : B ⧸ IsLocalRing.maximalIdeal B ^ 2 →+* IsLocalRing.ResidueField B :=
      Ideal.Quotient.factor (Ideal.pow_le_self two_ne_zero)
    haveI : CharP (IsLocalRing.ResidueField B) p :=
      charP_of_injective_algebraMap (algebraMap k (IsLocalRing.ResidueField B)).injective p
    have hp0 : ((p : ℕ) : B ⧸ IsLocalRing.maximalIdeal B ^ 2) = 0 := by
      rw [← map_natCast (algebraMap k (B ⧸ IsLocalRing.maximalIdeal B ^ 2)) p,
        CharP.cast_eq_zero, map_zero]
    have hker : RingHom.ker π ^ 2 = ⊥ := by
      have e1 : RingHom.ker π = Ideal.map (Ideal.Quotient.mk (IsLocalRing.maximalIdeal B ^ 2))
          (IsLocalRing.maximalIdeal B) := Ideal.Quotient.factor_ker _
      rw [e1]
      exact (Ideal.map_pow _ _ _).symm.trans (Ideal.map_quotient_self _)
    have hπ : Function.Surjective π := Ideal.Quotient.factor_surjective _
    have hsec0 : ∃ σ : IsLocalRing.ResidueField B →+* B ⧸ IsLocalRing.maximalIdeal B ^ 2,
        π.comp σ = RingHom.id _ := by
      haveI : Nontrivial (B ⧸ IsLocalRing.maximalIdeal B ^ 2) := π.domain_nontrivial
      haveI : CharP (B ⧸ IsLocalRing.maximalIdeal B ^ 2) p :=
        (CharP.charP_iff_prime_eq_zero (Fact.out : p.Prime)).mpr hp0
      letI : Algebra (ZMod p) (B ⧸ IsLocalRing.maximalIdeal B ^ 2) :=
        ZMod.algebra (B ⧸ IsLocalRing.maximalIdeal B ^ 2) p
      letI : Algebra (ZMod p) (IsLocalRing.ResidueField B) := ZMod.algebra _ p
      haveI : Algebra.FormallySmooth (ZMod p) (IsLocalRing.ResidueField B) :=
        wc_pfc_p_field_formally_smooth p _
      let e := RingHom.quotientKerEquivOfSurjective hπ
      let g : IsLocalRing.ResidueField B →ₐ[ZMod p]
          (B ⧸ IsLocalRing.maximalIdeal B ^ 2) ⧸ RingHom.ker π :=
        { toRingHom := (e.symm : IsLocalRing.ResidueField B →+* _)
          commutes' := fun r => DFunLike.congr_fun (RingHom.ext_zmod
            ((e.symm : IsLocalRing.ResidueField B →+* _).comp
              (algebraMap (ZMod p) (IsLocalRing.ResidueField B)))
            (algebraMap (ZMod p) ((B ⧸ IsLocalRing.maximalIdeal B ^ 2) ⧸ RingHom.ker π))) r }
      have hnil : IsNilpotent (RingHom.ker π) := ⟨2, hker.trans Submodule.zero_eq_bot.symm⟩
      refine ⟨(Algebra.FormallySmooth.lift (RingHom.ker π) hnil g : _ →+* _), ?_⟩
      ext x
      have h1 := Algebra.FormallySmooth.mk_lift (RingHom.ker π) hnil g x
      have h2 := RingHom.quotientKerEquivOfSurjective_apply_mk hπ
        (Algebra.FormallySmooth.lift (RingHom.ker π) hnil g x)
      change π (Algebra.FormallySmooth.lift (RingHom.ker π) hnil g x) = x
      rw [← h2, h1]
      exact e.apply_symm_apply x
    obtain ⟨σ, hσ⟩ := hsec0
    have hsec : ∀ b : B, σ (IsLocalRing.residue _ b) -
        Ideal.Quotient.mk (IsLocalRing.maximalIdeal B ^ 2) b ∈
        Ideal.map (Ideal.Quotient.mk (IsLocalRing.maximalIdeal B ^ 2))
          (IsLocalRing.maximalIdeal B) := by
      intro b
      rw [← Ideal.Quotient.factor_ker (Ideal.pow_le_self two_ne_zero), RingHom.mem_ker, map_sub]
      change (π.comp σ) (IsLocalRing.residue _ b) - π (Ideal.Quotient.mk _ b) = 0
      rw [hσ, RingHom.id_apply, sub_eq_zero]
      exact (Ideal.Quotient.factor_mk (Ideal.pow_le_self two_ne_zero) b).symm
    exact wc_pfc_p_s0_derivation_of_section _ σ hsec f


  have s6gen : ∀ (F' : Type u) [Field F'] [Algebra k F'] (μ' : Fin t → F'),
      LinearIndependent F' (fun j => KaehlerDifferential.D k F' (μ' j)) →
      ∀ G : MvPolynomial (Fin t) k, MvPolynomial.aeval μ' G = 0 →
      ∀ j, MvPolynomial.aeval μ' (MvPolynomial.pderiv j G) = 0 := by
    intro F' _ _ μ' hli' G hG
    have h := wc_pfc_p_s0_chain_rule k F' (KaehlerDifferential k F')
      ((KaehlerDifferential.D k F').restrictScalars ℤ) t μ' G
    have hD : ∀ x, ((KaehlerDifferential.D k F').restrictScalars ℤ) x =
        KaehlerDifferential.D k F' x := fun x => rfl
    simp only [hD, Derivation.map_algebraMap, smul_zero, Finset.sum_const_zero, add_zero, hG,
      map_zero] at h
    exact Fintype.linearIndependent_iff.mp hli' _ h.symm


  have TD : ∀ (L : Type u) [Field L] [Algebra k L]
      (ν : Fin t → L) (R : Type u) [CommRing R] [IsLocalRing R] [Algebra k R]
      (ρ' : IsLocalRing.ResidueField R →+* L) (z : Fin t → R),
      (∀ j, ρ' (IsLocalRing.residue R (z j)) = ν j) →
      (∀ a : k, ρ' (IsLocalRing.residue R (algebraMap k R a)) = algebraMap k L a) →
      (∀ P : MvPolynomial (Fin t) k, ρ' (IsLocalRing.residue R (MvPolynomial.aeval z P)) =
        MvPolynomial.aeval ν P) ∧
      ∀ (δ' : Derivation ℤ R (IsLocalRing.ResidueField R)) (G : MvPolynomial (Fin t) k),
        (∀ j, MvPolynomial.aeval ν (MvPolynomial.pderiv j G) = 0) →
        ρ' (δ' (MvPolynomial.aeval z G)) = ∑ α ∈ G.support,
          MvPolynomial.aeval ν (MvPolynomial.monomial α (1 : k)) *
            ρ' (δ' (algebraMap k R (G.coeff α))) := by
    intro L _ _ ν R _ _ _ ρ' z hz ha
    have part1 : ∀ P : MvPolynomial (Fin t) k,
        ρ' (IsLocalRing.residue R (MvPolynomial.aeval z P)) = MvPolynomial.aeval ν P := by
      intro P
      have : (ρ'.comp ((IsLocalRing.residue R).comp
          (MvPolynomial.aeval (R := k) z).toRingHom)) =
          (MvPolynomial.aeval (R := k) ν).toRingHom := by
        apply MvPolynomial.ringHom_ext
        · intro a
          simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
            MvPolynomial.aeval_C]
          exact ha a
        · intro j
          simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
            MvPolynomial.aeval_X]
          exact hz j
      exact DFunLike.congr_fun this P
    refine ⟨part1, ?_⟩
    intro δ' G hG
    rw [wc_pfc_p_s0_chain_rule k R (IsLocalRing.ResidueField R) δ' t z G, map_add, map_sum,
      map_sum]
    have e1 : ∀ j, ρ' (MvPolynomial.aeval z (MvPolynomial.pderiv j G) • δ' (z j)) = 0 := by
      intro j
      rw [Algebra.smul_def, IsLocalRing.ResidueField.algebraMap_eq, map_mul, part1, hG, zero_mul]
    have e2 : ∀ α, ρ' (MvPolynomial.aeval z (MvPolynomial.monomial α (1 : k)) •
        δ' (algebraMap k R (G.coeff α))) =
        MvPolynomial.aeval ν (MvPolynomial.monomial α (1 : k)) *
          ρ' (δ' (algebraMap k R (G.coeff α))) := by
      intro α
      rw [Algebra.smul_def, IsLocalRing.ResidueField.algebraMap_eq, map_mul, part1]
    simp only [e1, e2, Finset.sum_const_zero, zero_add]


  have TC : ∀ (A : Type u) [CommRing A] [IsLocalRing A] (r : ℕ) (g : Fin r → A) (i₀ : Fin r)
      (Δ : Derivation ℤ A (IsLocalRing.ResidueField A)),
      (∀ i, IsLocalRing.residue A (g i) = 0) → (∀ i, Δ (g i) = if i = i₀ then 1 else 0) →
      ∀ c : Fin r → A, ∑ i, c i * g i ∈ IsLocalRing.maximalIdeal A ^ 2 →
      c i₀ ∈ IsLocalRing.maximalIdeal A := by
    intro A _ _ r g i₀ Δ hres hΔ c hc
    have s9 : ∀ x : A, x ∈ IsLocalRing.maximalIdeal A ^ 2 → Δ x = 0 := by
      intro x hx
      rw [pow_two] at hx
      refine Submodule.mul_induction_on hx ?_ ?_
      · intro m hm n hn
        rw [Derivation.leibniz, Algebra.smul_def, Algebra.smul_def,
          IsLocalRing.ResidueField.algebraMap_eq,
          (IsLocalRing.residue_eq_zero_iff m).mpr hm, (IsLocalRing.residue_eq_zero_iff n).mpr hn,
          zero_mul, zero_mul, add_zero]
      · intro x y hx hy
        rw [map_add, hx, hy, add_zero]
    have h0 := s9 _ hc
    rw [map_sum] at h0
    have h1 : ∀ i, Δ (c i * g i) = if i = i₀ then IsLocalRing.residue A (c i) else 0 := by
      intro i
      rw [Derivation.leibniz, Algebra.smul_def, Algebra.smul_def,
        IsLocalRing.ResidueField.algebraMap_eq, hres i, zero_mul, add_zero, hΔ i]
      split_ifs <;> simp
    simp only [h1, Finset.sum_ite_eq', Finset.mem_univ, ite_true] at h0
    exact (IsLocalRing.residue_eq_zero_iff _).mp h0


  have TA : ∀ (𝔭 : Ideal (MvPolynomial (Fin t) k)) [𝔭.IsPrime],
      Ideal.span (Set.range fun P : 𝔭 =>
        algebraMap (MvPolynomial (Fin t) k) (Localization.AtPrime 𝔭) P.1) =
        IsLocalRing.maximalIdeal (Localization.AtPrime 𝔭) := by
    intro 𝔭 _
    rw [← Localization.AtPrime.map_eq_maximalIdeal, Ideal.map]
    congr 1
    ext x
    constructor
    · rintro ⟨P, rfl⟩; exact ⟨P.1, P.2, rfl⟩
    · rintro ⟨P, hP, rfl⟩; exact ⟨⟨P, hP⟩, rfl⟩


  haveI h𝔭₀prime : (𝔮.comap (MvPolynomial.aeval (R := k) lam).toRingHom).IsPrime :=
    Ideal.comap_isPrime _ _
  haveI : IsNoetherianRing
      (Localization.AtPrime (𝔮.comap (MvPolynomial.aeval (R := k) lam).toRingHom)) :=
    IsLocalization.isNoetherianRing
      (𝔮.comap (MvPolynomial.aeval (R := k) lam).toRingHom).primeCompl _ inferInstance
  have hg : ∀ P : (𝔮.comap (MvPolynomial.aeval (R := k) lam).toRingHom),
      algebraMap (MvPolynomial (Fin t) k)
        (Localization.AtPrime (𝔮.comap (MvPolynomial.aeval (R := k) lam).toRingHom)) P.1 ∈
      IsLocalRing.maximalIdeal
        (Localization.AtPrime (𝔮.comap (MvPolynomial.aeval (R := k) lam).toRingHom)) :=
    fun P => by
      rw [← Localization.AtPrime.map_eq_maximalIdeal]; exact Ideal.mem_map_of_mem _ P.2
  obtain ⟨r, s, hr, hdual⟩ := TS4
    (Localization.AtPrime (𝔮.comap (MvPolynomial.aeval (R := k) lam).toRingHom))
    (↥(𝔮.comap (MvPolynomial.aeval (R := k) lam).toRingHom))
    (fun P => algebraMap (MvPolynomial (Fin t) k)
      (Localization.AtPrime (𝔮.comap (MvPolynomial.aeval (R := k) lam).toRingHom)) P.1) hg
    (TA _)
  refine ⟨r, fun i => (s i).1, hr, fun i => (s i).2, ?_⟩
  intro c hc i₀
  obtain ⟨f, hf⟩ := hdual i₀
  obtain ⟨δ, hδ⟩ := Q1 _ f

  haveI : IsLocalHom (Localization.localRingHom
      (𝔮.comap (MvPolynomial.aeval (R := k) lam).toRingHom) 𝔮
      (MvPolynomial.aeval (R := k) lam).toRingHom rfl) :=
    Localization.isLocalHom_localRingHom _ _ _ rfl
  let ρ := IsLocalRing.ResidueField.map (Localization.localRingHom
      (𝔮.comap (MvPolynomial.aeval (R := k) lam).toRingHom) 𝔮
      (MvPolynomial.aeval (R := k) lam).toRingHom rfl)
  have hρ : ∀ P : MvPolynomial (Fin t) k, ρ (IsLocalRing.residue _
      (algebraMap (MvPolynomial (Fin t) k)
        (Localization.AtPrime (𝔮.comap (MvPolynomial.aeval (R := k) lam).toRingHom)) P)) =
      IsLocalRing.residue _ (algebraMap Λ (Localization.AtPrime 𝔮)
        (MvPolynomial.aeval (R := k) lam P)) := by
    intro P
    show IsLocalRing.ResidueField.map _ _ = _
    rw [IsLocalRing.ResidueField.map_residue, Localization.localRingHom_to_map]
    rfl
  have hstar : ∀ a : k, ρ (IsLocalRing.residue _ (algebraMap k
      (Localization.AtPrime (𝔮.comap (MvPolynomial.aeval (R := k) lam).toRingHom)) a)) =
      algebraMap k (IsLocalRing.ResidueField (Localization.AtPrime 𝔮)) a := by
    intro a
    rw [IsScalarTower.algebraMap_apply k (MvPolynomial (Fin t) k)
        (Localization.AtPrime (𝔮.comap (MvPolynomial.aeval (R := k) lam).toRingHom)) a,
      hρ, MvPolynomial.algebraMap_eq, MvPolynomial.aeval_C,
      ← IsScalarTower.algebraMap_apply k Λ (Localization.AtPrime 𝔮) a,
      IsScalarTower.algebraMap_apply k (Localization.AtPrime 𝔮)
        (IsLocalRing.ResidueField (Localization.AtPrime 𝔮)),
      IsLocalRing.ResidueField.algebraMap_eq]

  let ε : k → IsLocalRing.ResidueField (Localization.AtPrime 𝔮) := fun a => ρ (δ (algebraMap k
      (Localization.AtPrime (𝔮.comap (MvPolynomial.aeval (R := k) lam).toRingHom)) a))
  have hε_add : ∀ a b, ε (a + b) = ε a + ε b := by
    intro a b; simp only [ε, map_add]
  have hε_mul : ∀ a b, ε (a * b) =
      algebraMap k (IsLocalRing.ResidueField (Localization.AtPrime 𝔮)) a * ε b +
      algebraMap k (IsLocalRing.ResidueField (Localization.AtPrime 𝔮)) b * ε a :=
    fun a b => Eps _ _ δ ρ hstar a b
  obtain ⟨Δ₀, hΔ₀⟩ := wc_pfc_p_s0_extend_derivation k Λ 𝔮 hinj ε hε_add hε_mul
  obtain ⟨Δ, hΔΔ₀⟩ := Dconv _ _ _ Δ₀
  have hΔ : ∀ a : k, Δ (algebraMap k (Localization.AtPrime 𝔮) a) = ε a := fun a => by
    rw [hΔΔ₀, hΔ₀]

  let ν : Fin t → IsLocalRing.ResidueField (Localization.AtPrime 𝔮) :=
    fun j => (μ j : IsLocalRing.ResidueField (Localization.AtPrime 𝔮))
  have hzA : ∀ j, (RingHom.id _) (IsLocalRing.residue (Localization.AtPrime 𝔮)
      ((algebraMap Λ (Localization.AtPrime 𝔮) ∘ lam) j)) = ν j := by
    intro j
    exact (hμ j).symm
  have haA : ∀ a : k, (RingHom.id _) (IsLocalRing.residue (Localization.AtPrime 𝔮)
      (algebraMap k (Localization.AtPrime 𝔮) a)) =
      algebraMap k (IsLocalRing.ResidueField (Localization.AtPrime 𝔮)) a := by
    intro a
    rw [RingHom.id_apply, IsScalarTower.algebraMap_apply k (Localization.AtPrime 𝔮)
      (IsLocalRing.ResidueField (Localization.AtPrime 𝔮)), IsLocalRing.ResidueField.algebraMap_eq]
  have hz0 : ∀ j, ρ (IsLocalRing.residue _
      ((algebraMap (MvPolynomial (Fin t) k)
        (Localization.AtPrime (𝔮.comap (MvPolynomial.aeval (R := k) lam).toRingHom)) ∘
          MvPolynomial.X) j)) = ν j := by
    intro j
    rw [Function.comp_apply, hρ, MvPolynomial.aeval_X]
    exact (hμ j).symm
  have hgbar : ∀ P : MvPolynomial (Fin t) k, algebraMap Λ (Localization.AtPrime 𝔮)
      (MvPolynomial.aeval (R := k) lam P) =
      MvPolynomial.aeval (algebraMap Λ (Localization.AtPrime 𝔮) ∘ lam) P := fun P =>
    (MvPolynomial.aeval_algebraMap_apply _ lam P).symm
  have hg0 : ∀ P : MvPolynomial (Fin t) k,
      algebraMap (MvPolynomial (Fin t) k)
        (Localization.AtPrime (𝔮.comap (MvPolynomial.aeval (R := k) lam).toRingHom)) P =
      MvPolynomial.aeval (algebraMap (MvPolynomial (Fin t) k)
        (Localization.AtPrime (𝔮.comap (MvPolynomial.aeval (R := k) lam).toRingHom)) ∘
          MvPolynomial.X) P := fun P => by
    rw [MvPolynomial.aeval_algebraMap_apply, MvPolynomial.aeval_X_left_apply]
  have hres0 : ∀ i, IsLocalRing.residue (Localization.AtPrime 𝔮)
      (algebraMap Λ (Localization.AtPrime 𝔮) (MvPolynomial.aeval (R := k) lam (s i).1)) = 0 := by
    intro i
    rw [IsLocalRing.residue_eq_zero_iff, ← Localization.AtPrime.map_eq_maximalIdeal]
    exact Ideal.mem_map_of_mem _ (s i).2
  obtain ⟨pA1, pA2⟩ := TD _ ν _ (RingHom.id _) _ hzA haA
  obtain ⟨-, p02⟩ := TD _ ν _ ρ _ hz0 hstar
  have hνF : ∀ P : MvPolynomial (Fin t) k, MvPolynomial.aeval ν P =
      ((MvPolynomial.aeval μ P : F) : IsLocalRing.ResidueField (Localization.AtPrime 𝔮)) := by
    intro P
    exact (MvPolynomial.aeval_algebraMap_apply
      (IsLocalRing.ResidueField (Localization.AtPrime 𝔮)) μ P)
  have hpart : ∀ i j, MvPolynomial.aeval ν (MvPolynomial.pderiv j (s i).1) = 0 := by
    intro i j
    have h1 := pA1 (s i).1
    rw [RingHom.id_apply, ← hgbar, hres0 i, hνF] at h1
    have h2 : MvPolynomial.aeval μ (s i).1 = 0 := Subtype.ext h1.symm
    rw [hνF, s6gen F μ hli _ h2 j]
    rfl

  have hΔg : ∀ i, Δ (algebraMap Λ (Localization.AtPrime 𝔮)
      (MvPolynomial.aeval (R := k) lam (s i).1)) = if i = i₀ then 1 else 0 := by
    intro i
    have eA := pA2 Δ (s i).1 (hpart i)
    have e0 := p02 δ (s i).1 (hpart i)
    rw [RingHom.id_apply, ← hgbar] at eA
    rw [← hg0] at e0
    simp only [RingHom.id_apply, hΔ] at eA
    rw [eA]
    have e1 : δ (algebraMap (MvPolynomial (Fin t) k)
        (Localization.AtPrime (𝔮.comap (MvPolynomial.aeval (R := k) lam).toRingHom)) (s i).1) =
        if i = i₀ then 1 else 0 := by
      rw [hδ _ (hg (s i))]
      exact hf i
    rw [e1] at e0
    have e2 : ρ (if i = i₀ then 1 else 0) = if i = i₀ then 1 else 0 := by
      split_ifs
      · exact map_one ρ
      · exact map_zero ρ
    rw [← e2, e0] <;> rfl
  exact TC _ r _ i₀ Δ hres0 hΔg c hc

theorem wc_pfc_p_chart_prime_decomp : ∀ (k : Type u) [Field k] (Λ : Type u) [CommRing Λ] [Algebra k Λ] (𝔮 : Ideal Λ) [𝔮.IsPrime] (t s : ℕ) (lam : Fin t → Λ) (w : Fin s → Λ), (∀ i, w i ∈ 𝔮) → Ideal.comap (MvPolynomial.aeval (R := k) (Fin.append lam w)).toRingHom 𝔮 = Ideal.map (MvPolynomial.rename (R := k) (Fin.castAdd s)) (Ideal.comap (MvPolynomial.aeval (R := k) lam).toRingHom 𝔮) ⊔ Ideal.span (Set.range fun i => (MvPolynomial.X (Fin.natAdd t i) : MvPolynomial (Fin (t + s)) k)) ∧ Ideal.comap (MvPolynomial.rename (R := k) (Fin.castAdd s)).toRingHom (Ideal.comap (MvPolynomial.aeval (R := k) (Fin.append lam w)).toRingHom 𝔮) = Ideal.comap (MvPolynomial.aeval (R := k) lam).toRingHom 𝔮 :=
by
  intro k _ Λ _ _ 𝔮 _ t s lam w hw
  have hren : ∀ P : MvPolynomial (Fin t) k,
      MvPolynomial.aeval (R := k) (Fin.append lam w)
        (MvPolynomial.rename (R := k) (Fin.castAdd s) P) = MvPolynomial.aeval (R := k) lam P := by
    intro P
    have hc : (Fin.append lam w ∘ Fin.castAdd s) = lam :=
      funext fun j => Fin.append_left lam w j
    rw [MvPolynomial.aeval_rename, hc]
  have hB : Ideal.comap (MvPolynomial.rename (R := k) (Fin.castAdd s)).toRingHom
      (Ideal.comap (MvPolynomial.aeval (R := k) (Fin.append lam w)).toRingHom 𝔮) =
      Ideal.comap (MvPolynomial.aeval (R := k) lam).toRingHom 𝔮 := by
    ext P
    show MvPolynomial.aeval (R := k) (Fin.append lam w)
        (MvPolynomial.rename (R := k) (Fin.castAdd s) P) ∈ 𝔮 ↔ MvPolynomial.aeval (R := k) lam P ∈ 𝔮
    rw [hren]
  have hWQ : Ideal.span (Set.range fun i =>
      (MvPolynomial.X (Fin.natAdd t i) : MvPolynomial (Fin (t + s)) k)) ≤
      Ideal.comap (MvPolynomial.aeval (R := k) (Fin.append lam w)).toRingHom 𝔮 := by
    rw [Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    show MvPolynomial.aeval (R := k) (Fin.append lam w) (MvPolynomial.X (Fin.natAdd t i)) ∈ 𝔮
    rw [MvPolynomial.aeval_X, Fin.append_right]
    exact hw i
  refine ⟨le_antisymm ?_ (sup_le ?_ hWQ), hB⟩
  · intro f hf
    have hf' : MvPolynomial.aeval (R := k) (Fin.append lam w) f ∈ 𝔮 := hf
    let σ : MvPolynomial (Fin (t + s)) k →ₐ[k] MvPolynomial (Fin t) k :=
      MvPolynomial.aeval (Fin.append (fun j => MvPolynomial.X j) (fun _ => 0))
    have hcong : (Ideal.Quotient.mkₐ k (Ideal.span (Set.range fun i =>
        (MvPolynomial.X (Fin.natAdd t i) : MvPolynomial (Fin (t + s)) k)))).comp
        ((MvPolynomial.rename (R := k) (Fin.castAdd s)).comp σ) =
        Ideal.Quotient.mkₐ k (Ideal.span (Set.range fun i =>
        (MvPolynomial.X (Fin.natAdd t i) : MvPolynomial (Fin (t + s)) k))) := by
      apply MvPolynomial.algHom_ext
      intro n
      induction n using Fin.addCases with
      | left j =>
        simp only [AlgHom.comp_apply, σ, MvPolynomial.aeval_X, Fin.append_left,
          MvPolynomial.rename_X]
      | right i =>
        simp only [AlgHom.comp_apply, σ, MvPolynomial.aeval_X, Fin.append_right, map_zero]
        symm
        rw [Ideal.Quotient.mkₐ_eq_mk, Ideal.Quotient.eq_zero_iff_mem]
        exact Ideal.subset_span ⟨i, rfl⟩
    have hd : f - MvPolynomial.rename (R := k) (Fin.castAdd s) (σ f) ∈
        Ideal.span (Set.range fun i =>
          (MvPolynomial.X (Fin.natAdd t i) : MvPolynomial (Fin (t + s)) k)) := by
      have h := congrArg (fun F => F f) hcong
      simp only [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk] at h
      exact (Ideal.Quotient.mk_eq_mk_iff_sub_mem _ _).mp h.symm
    have hσ : σ f ∈ Ideal.comap (MvPolynomial.aeval (R := k) lam).toRingHom 𝔮 := by
      show MvPolynomial.aeval (R := k) lam (σ f) ∈ 𝔮
      rw [← hren]
      have h1 : MvPolynomial.aeval (R := k) (Fin.append lam w)
          (f - MvPolynomial.rename (R := k) (Fin.castAdd s) (σ f)) ∈ 𝔮 := hWQ hd
      rw [map_sub] at h1
      have h2 := Ideal.sub_mem _ hf' h1
      rwa [sub_sub_cancel] at h2
    have key := Ideal.add_mem _
      (Ideal.mem_sup_left (T := Ideal.span (Set.range fun i =>
          (MvPolynomial.X (Fin.natAdd t i) : MvPolynomial (Fin (t + s)) k)))
        (Ideal.mem_map_of_mem (MvPolynomial.rename (R := k) (Fin.castAdd s)) hσ))
      (Ideal.mem_sup_right (S := Ideal.map (MvPolynomial.rename (R := k) (Fin.castAdd s))
          (Ideal.comap (MvPolynomial.aeval (R := k) lam).toRingHom 𝔮)) hd)
    rwa [add_sub_cancel] at key
  · rw [Ideal.map_le_iff_le_comap]
    intro P hP
    show MvPolynomial.aeval (R := k) (Fin.append lam w)
        (MvPolynomial.rename (R := k) (Fin.castAdd s) P) ∈ 𝔮
    rw [hren]
    exact hP

theorem wc_pfc_p_chart_embdim_le : ∀ (k : Type u) [Field k] (t s : ℕ) (𝔭₀ : Ideal (MvPolynomial (Fin t) k)) [𝔭₀.IsPrime] (𝔭 : Ideal (MvPolynomial (Fin (t + s)) k)) [𝔭.IsPrime], 𝔭 = Ideal.map (MvPolynomial.rename (Fin.castAdd s)) 𝔭₀ ⊔ Ideal.span (Set.range fun i => (MvPolynomial.X (Fin.natAdd t i) : MvPolynomial (Fin (t + s)) k)) → Ideal.comap (MvPolynomial.rename (Fin.castAdd s)).toRingHom 𝔭 = 𝔭₀ → Submodule.spanFinrank (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔭)) ≤ Submodule.spanFinrank (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔭₀)) + s :=
by
  intro k _ t s 𝔭₀ _ 𝔭 _ hdec hcomap
  classical
  let ι : MvPolynomial (Fin t) k →ₐ[k] MvPolynomial (Fin (t + s)) k :=
    MvPolynomial.rename (Fin.castAdd s)
  let ρ : Localization.AtPrime 𝔭₀ →+* Localization.AtPrime 𝔭 :=
    Localization.localRingHom 𝔭₀ 𝔭 ι.toRingHom hcomap.symm
  let y' : Fin s → Localization.AtPrime 𝔭 := fun i =>
    algebraMap (MvPolynomial (Fin (t + s)) k) (Localization.AtPrime 𝔭)
      (MvPolynomial.X (Fin.natAdd t i))
  have : IsNoetherianRing (Localization.AtPrime 𝔭₀) :=
    IsLocalization.isNoetherianRing 𝔭₀.primeCompl _ inferInstance
  have hFG : (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔭₀)).FG :=
    IsNoetherian.noetherian _
  have hid : IsLocalRing.maximalIdeal (Localization.AtPrime 𝔭) =
      Ideal.map ρ (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔭₀)) ⊔
        Ideal.span (Set.range y') := by
    have h1 : Ideal.map (algebraMap (MvPolynomial (Fin (t + s)) k) (Localization.AtPrime 𝔭)) 𝔭 =
        Ideal.map (algebraMap (MvPolynomial (Fin (t + s)) k) (Localization.AtPrime 𝔭))
          (Ideal.map ι.toRingHom 𝔭₀ ⊔ Ideal.span (Set.range fun i =>
            (MvPolynomial.X (Fin.natAdd t i) : MvPolynomial (Fin (t + s)) k))) :=
      congrArg (Ideal.map (algebraMap (MvPolynomial (Fin (t + s)) k) (Localization.AtPrime 𝔭))) hdec
    rw [Localization.AtPrime.map_eq_maximalIdeal] at h1
    rw [h1, ← Localization.AtPrime.map_eq_maximalIdeal (I := 𝔭₀), Ideal.map_sup, Ideal.map_span,
      Ideal.map_map, Ideal.map_map]
    congr 1
    · congr 1
      refine RingHom.ext fun x => ?_
      exact (Localization.localRingHom_to_map 𝔭₀ 𝔭 ι.toRingHom hcomap.symm x).symm
    · rw [← Set.range_comp]
      rfl
  rw [hid]
  obtain ⟨T, hTcard, hTspan⟩ := Submodule.FG.exists_span_set_encard_eq_spanFinrank hFG
  have hTfin : T.Finite := Set.finite_of_encard_eq_coe hTcard
  have hTn : T.ncard = (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔭₀)).spanFinrank := by
    have := hTfin.cast_ncard_eq
    rw [hTcard] at this
    exact_mod_cast this
  have hmap : Ideal.map ρ (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔭₀)) =
      Ideal.span (ρ '' T) := by
    rw [← hTspan]
    exact Ideal.map_span ρ T
  rw [hmap, ← Ideal.span_union]
  have hUfin : (ρ '' T ∪ Set.range y').Finite := (hTfin.image ρ).union (Set.finite_range y')
  refine (Submodule.spanFinrank_span_le_ncard_of_finite hUfin).trans ?_
  refine (Set.ncard_union_le _ _).trans ?_
  have h1 : (ρ '' T).ncard ≤ T.ncard := Set.ncard_image_le hTfin
  have h2 : (Set.range y').ncard ≤ s := by
    rw [← Set.image_univ]
    refine (Set.ncard_image_le Set.finite_univ).trans ?_
    rw [Set.ncard_univ, Nat.card_eq_fintype_card, Fintype.card_fin]
  omega

theorem wc_pfc_p_chart_nakayama : ∀ (B : Type u) [CommRing B] [IsLocalRing B] [IsNoetherianRing B] (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A] (f : B →+* A), IsLocalHom f → IsLocalRing.maximalIdeal A ≤ Ideal.map f (IsLocalRing.maximalIdeal B) ⊔ IsLocalRing.maximalIdeal A ^ 2 → Ideal.map f (IsLocalRing.maximalIdeal B) = IsLocalRing.maximalIdeal A ∧ Submodule.spanFinrank (IsLocalRing.maximalIdeal A) ≤ Submodule.spanFinrank (IsLocalRing.maximalIdeal B) :=
by
  intro B _ _ _ A _ _ _ f hf hle
  haveI : IsLocalHom f := hf
  have hI : Ideal.map f (IsLocalRing.maximalIdeal B) = IsLocalRing.maximalIdeal A := by
    refine le_antisymm (IsLocalRing.map_maximalIdeal_le f) ?_
    refine Submodule.le_of_le_smul_of_le_jacobson_bot (IsNoetherian.noetherian _)
      (IsLocalRing.maximalIdeal_le_jacobson ⊥) ?_
    have h2 : IsLocalRing.maximalIdeal A • IsLocalRing.maximalIdeal A =
        IsLocalRing.maximalIdeal A ^ 2 := by
      rw [Ideal.smul_eq_mul, pow_two]
    rw [h2]
    exact hle
  refine ⟨hI, ?_⟩
  obtain ⟨s, hs, hspan⟩ := Submodule.FG.exists_span_set_encard_eq_spanFinrank
    (IsNoetherian.noetherian (IsLocalRing.maximalIdeal B))
  have hsfin : s.Finite := Set.finite_of_encard_eq_coe hs
  have hcard : s.ncard = Submodule.spanFinrank (IsLocalRing.maximalIdeal B) := by
    rw [Set.ncard_def, hs, ENat.toNat_coe]
  have hA : IsLocalRing.maximalIdeal A = Ideal.span (f '' s) := by
    rw [← hI, ← Ideal.map_span]
    congr 1
    exact hspan.symm
  rw [hA, ← hcard]
  exact (Submodule.spanFinrank_span_le_ncard_of_finite (hsfin.image f)).trans
    (Set.ncard_image_le hsfin)

theorem wc_pfc_p_cotangent_complement : ∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A] (J : Ideal A), J ≤ IsLocalRing.maximalIdeal A → ∀ (r : ℕ) (x : Fin r → A), Ideal.span (Set.range x) = IsLocalRing.maximalIdeal A → ∃ (s : ℕ) (ι : Fin s → Fin r), Function.Injective ι ∧ IsLocalRing.maximalIdeal A ≤ J ⊔ Ideal.span (Set.range (x ∘ ι)) ⊔ IsLocalRing.maximalIdeal A ^ 2 ∧ ∀ (e : Fin s → A) (j : A), j ∈ J → j + ∑ i, e i * x (ι i) ∈ IsLocalRing.maximalIdeal A ^ 2 → ∀ i, e i ∈ IsLocalRing.maximalIdeal A :=
by
  intro A _ _ _ J _ r x hx
  classical
  have hxm : ∀ l, x l ∈ IsLocalRing.maximalIdeal A := fun l => by
    rw [← hx]; exact Ideal.subset_span ⟨l, rfl⟩
  let P : ℕ → Prop := fun n => ∃ ι : Fin n → Fin r, Function.Injective ι ∧
      ∀ (e : Fin n → A) (j : A), j ∈ J → j + ∑ i, e i * x (ι i) ∈ IsLocalRing.maximalIdeal A ^ 2 →
        ∀ i, e i ∈ IsLocalRing.maximalIdeal A
  have hP0 : P 0 := ⟨Fin.elim0, fun a => a.elim0, fun _ _ _ _ i => i.elim0⟩
  have hPs : P (Nat.findGreatest P r) := Nat.findGreatest_spec (Nat.zero_le r) hP0
  have hns : ¬ P (Nat.findGreatest P r + 1) := by
    rintro ⟨ι', hinj', hind'⟩
    have hle : Nat.findGreatest P r + 1 ≤ r := by
      simpa using Fintype.card_le_of_injective ι' hinj'
    exact Nat.findGreatest_is_greatest (Nat.lt_succ_self _) hle ⟨ι', hinj', hind'⟩
  generalize Nat.findGreatest P r = s at hPs hns
  obtain ⟨ι, hinj, hind⟩ := hPs
  refine ⟨s, ι, hinj, ?_, hind⟩
  have key : ∀ l, x l ∈ J ⊔ Ideal.span (Set.range (x ∘ ι)) ⊔ IsLocalRing.maximalIdeal A ^ 2 := by
    intro l
    by_cases hl : l ∈ Set.range ι
    · obtain ⟨i, rfl⟩ := hl
      exact Submodule.mem_sup_left (Submodule.mem_sup_right (Ideal.subset_span ⟨i, rfl⟩))
    · have hinj' : Function.Injective (Fin.cons l ι : Fin (s + 1) → Fin r) :=
        Fin.cons_injective_iff.mpr ⟨hl, hinj⟩
      have hng : ¬ ∀ (e : Fin (s + 1) → A) (j : A), j ∈ J →
          j + ∑ i, e i * x ((Fin.cons l ι : Fin (s + 1) → Fin r) i) ∈
            IsLocalRing.maximalIdeal A ^ 2 → ∀ i, e i ∈ IsLocalRing.maximalIdeal A :=
        fun h => hns ⟨_, hinj', h⟩
      push_neg at hng
      obtain ⟨e', j, hj, hy, k, hk⟩ := hng
      rw [Fin.sum_univ_succ] at hy
      simp only [Fin.cons_zero, Fin.cons_succ] at hy
      have h0 : e' 0 ∉ IsLocalRing.maximalIdeal A := by
        intro h0
        have hsq : e' 0 * x l ∈ IsLocalRing.maximalIdeal A ^ 2 := by
          rw [pow_two]; exact Ideal.mul_mem_mul h0 (hxm l)
        have hd := Ideal.sub_mem _ hy hsq
        have hd' : j + ∑ i : Fin s, e' i.succ * x (ι i) ∈ IsLocalRing.maximalIdeal A ^ 2 := by
          convert hd using 1; ring
        have hall := hind (fun i => e' i.succ) j hj hd'
        rcases Fin.eq_zero_or_eq_succ k with rfl | ⟨i, rfl⟩
        · exact hk h0
        · exact hk (hall i)
      obtain ⟨u, hu⟩ := ((IsLocalRing.notMem_maximalIdeal).mp h0).exists_left_inv
      have hmem : e' 0 * x l ∈ J ⊔ Ideal.span (Set.range (x ∘ ι)) ⊔
          IsLocalRing.maximalIdeal A ^ 2 := by
        have e1 : e' 0 * x l = (j + (e' 0 * x l + ∑ i : Fin s, e' i.succ * x (ι i))) + (-j) +
            -(∑ i : Fin s, e' i.succ * x (ι i)) := by ring
        rw [e1]
        refine Ideal.add_mem _ (Ideal.add_mem _ (Submodule.mem_sup_right hy) ?_) ?_
        · exact Submodule.mem_sup_left (Submodule.mem_sup_left (Submodule.neg_mem _ hj))
        · refine Submodule.mem_sup_left (Submodule.mem_sup_right (Submodule.neg_mem _
            (Ideal.sum_mem _ fun i _ => Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨i, rfl⟩))))
      have hxl : x l = u * (e' 0 * x l) := by rw [← mul_assoc, hu, one_mul]
      rw [hxl]; exact Ideal.mul_mem_left _ _ hmem
  intro y hy
  rw [← hx] at hy
  exact (Ideal.span_le.mpr (by rintro _ ⟨l, rfl⟩; exact key l)) hy

theorem wc_pfc_p_cotangent_indep_card : ∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A] (N : ℕ) (y : Fin N → A), (∀ i, y i ∈ IsLocalRing.maximalIdeal A) → (∀ c : Fin N → A, ∑ i, c i * y i ∈ IsLocalRing.maximalIdeal A ^ 2 → ∀ i, c i ∈ IsLocalRing.maximalIdeal A) → N ≤ Submodule.spanFinrank (IsLocalRing.maximalIdeal A) :=
by
  intro A _ _ _ N y hy hind
  classical
  rw [IsLocalRing.spanFinrank_maximalIdeal_eq_finrank_cotangentSpace A]
  let v : Fin N → IsLocalRing.CotangentSpace A :=
    fun i => (IsLocalRing.maximalIdeal A).toCotangent ⟨y i, hy i⟩
  have hli : LinearIndependent (IsLocalRing.ResidueField A) v := by
    rw [Fintype.linearIndependent_iff]
    intro g hg
    choose c hc using fun i => IsLocalRing.residue_surjective (g i)
    have hsmul : ∀ i, g i • v i =
        (IsLocalRing.maximalIdeal A).toCotangent (c i • (⟨y i, hy i⟩ : IsLocalRing.maximalIdeal A)) := by
      intro i
      rw [map_smul, ← hc i, ← IsLocalRing.ResidueField.algebraMap_eq, algebraMap_smul]
    simp only [hsmul] at hg
    rw [← map_sum, Ideal.toCotangent_eq_zero] at hg
    have hz : ((∑ i, c i • (⟨y i, hy i⟩ : IsLocalRing.maximalIdeal A) : IsLocalRing.maximalIdeal A) : A)
        = ∑ i, c i * y i := by
      rw [Submodule.coe_sum]
      rfl
    rw [hz] at hg
    intro i
    rw [← hc i]
    exact (IsLocalRing.residue_eq_zero_iff _).mpr (hind c hg i)
  have := hli.fintype_card_le_finrank
  simpa using this

theorem wc_pfc_p_embdim_match : ∀ (k : Type u) [Field k] (p : ℕ) [Fact p.Prime] [CharP k p] (Λ : Type u) [CommRing Λ] [IsNoetherianRing Λ] [Algebra k Λ] (𝔮 : Ideal Λ) [𝔮.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔮) → (∀ (r : ℕ) (c : Fin r → IsLocalRing.ResidueField (Localization.AtPrime 𝔮)) (a : Fin r → k), ∑ i, TensorProduct.tmul (Localization.AtPrime 𝔮) (c i) (KaehlerDifferential.D ℤ (Localization.AtPrime 𝔮) (algebraMap k (Localization.AtPrime 𝔮) (a i))) = 0 → ∑ i, TensorProduct.tmul k (c i) (KaehlerDifferential.D ℤ k (a i)) = 0) → ∀ (F : IntermediateField k (IsLocalRing.ResidueField (Localization.AtPrime 𝔮))), F.FG → ∀ (t : ℕ) (lam : Fin t → Λ) (μ : Fin t → F), (∀ j, (μ j : IsLocalRing.ResidueField (Localization.AtPrime 𝔮)) = IsLocalRing.residue (Localization.AtPrime 𝔮) (algebraMap Λ (Localization.AtPrime 𝔮) (lam j))) → LinearIndependent F (fun j => KaehlerDifferential.D k F (μ j)) → Submodule.span F (Set.range fun j => KaehlerDifferential.D k F (μ j)) = ⊤ → ∀ (r : ℕ) (x : Fin r → Λ), Ideal.span (Set.range x) = 𝔮 → ∃ (m : ℕ) (φ' : MvPolynomial (Fin m) k →ₐ[k] Λ), (∀ i, φ' (MvPolynomial.X i) ∈ Set.range lam ∪ Set.range x) ∧ (∀ j, ∃ i, φ' (MvPolynomial.X i) = lam j) ∧ Ideal.map (Localization.localRingHom (𝔮.comap φ'.toRingHom) 𝔮 φ'.toRingHom rfl) (IsLocalRing.maximalIdeal (Localization.AtPrime (𝔮.comap φ'.toRingHom))) = IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) ∧ Submodule.spanFinrank (IsLocalRing.maximalIdeal (Localization.AtPrime (𝔮.comap φ'.toRingHom))) = Submodule.spanFinrank (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮)) :=
by
  intro k _ p _ _ Λ _ _ _ 𝔮 _ _ hinj F _ t lam μ hμ hli _ r x hx
  classical
  haveI hAn : IsNoetherianRing (Localization.AtPrime 𝔮) :=
    IsLocalization.isNoetherianRing 𝔮.primeCompl _ inferInstance

  obtain ⟨e₀, G, he₀, hGq, hGind⟩ :=
    wc_pfc_p_stage0_cotangent_indep k p Λ 𝔮 hinj F t lam μ hμ hli
  have hmapq : Ideal.map (algebraMap Λ (Localization.AtPrime 𝔮)) 𝔮 =
      IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) :=
    Localization.AtPrime.map_eq_maximalIdeal

  have hxq : ∀ l, x l ∈ 𝔮 := fun l => hx ▸ Ideal.subset_span ⟨l, rfl⟩
  let x' : Fin r → Localization.AtPrime 𝔮 := fun l => algebraMap Λ _ (x l)
  have hx' : Ideal.span (Set.range x') = IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) := by
    rw [← hmapq]
    apply le_antisymm
    · apply Ideal.span_le.mpr
      rintro _ ⟨l, rfl⟩
      exact Ideal.mem_map_of_mem _ (hxq l)
    · rw [Ideal.map_le_iff_le_comap]
      intro y hy
      rw [← hx] at hy
      refine (Ideal.span_le.mpr ?_) hy
      rintro _ ⟨l, rfl⟩
      exact Ideal.subset_span ⟨l, rfl⟩
  have hx'm : ∀ l, x' l ∈ IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) := fun l => by
    rw [← hx']; exact Ideal.subset_span ⟨l, rfl⟩

  let g : Fin e₀ → Localization.AtPrime 𝔮 := fun i =>
    algebraMap Λ (Localization.AtPrime 𝔮) (MvPolynomial.aeval (R := k) lam (G i))
  have hgm : ∀ i, g i ∈ IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) := fun i => by
    rw [← hmapq]; exact Ideal.mem_map_of_mem _ (hGq i)
  let J : Ideal (Localization.AtPrime 𝔮) := Ideal.span (Set.range g)
  have hJ : J ≤ IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) :=
    Ideal.span_le.mpr (by rintro _ ⟨i, rfl⟩; exact hgm i)
  obtain ⟨s, ι, -, hcov, hcomp⟩ := wc_pfc_p_cotangent_complement _ J hJ r x' hx'

  let w : Fin s → Λ := fun l => x (ι l)
  have hw : ∀ i, w i ∈ 𝔮 := fun i => hxq (ι i)
  let φ' : MvPolynomial (Fin (t + s)) k →ₐ[k] Λ := MvPolynomial.aeval (Fin.append lam w)
  obtain ⟨hdec, hcomap⟩ := wc_pfc_p_chart_prime_decomp k Λ 𝔮 t s lam w hw
  have hφcast : ∀ j, φ' (MvPolynomial.X (Fin.castAdd s j)) = lam j := fun j => by
    simp [φ']
  have hφnat : ∀ l, φ' (MvPolynomial.X (Fin.natAdd t l)) = x (ι l) := fun l => by
    simp [φ', w]
  have hφren : ∀ P : MvPolynomial (Fin t) k,
      φ' (MvPolynomial.rename (Fin.castAdd s) P) = MvPolynomial.aeval (R := k) lam P := fun P => by
    have hc : (Fin.append lam w ∘ Fin.castAdd s) = lam := funext fun j => Fin.append_left lam w j
    show MvPolynomial.aeval (Fin.append lam w) (MvPolynomial.rename (Fin.castAdd s) P) = _
    rw [MvPolynomial.aeval_rename, hc]
  refine ⟨t + s, φ', ?_, ?_, ?_⟩
  · intro i
    induction i using Fin.addCases with
    | left j => exact Or.inl ⟨j, (hφcast j).symm⟩
    | right l => exact Or.inr ⟨ι l, (hφnat l).symm⟩
  · intro j
    exact ⟨Fin.castAdd s j, hφcast j⟩
  haveI : IsNoetherianRing (Localization.AtPrime (𝔮.comap φ'.toRingHom)) :=
    IsLocalization.isNoetherianRing (𝔮.comap φ'.toRingHom).primeCompl _
      (inferInstance : IsNoetherianRing (MvPolynomial (Fin (t + s)) k))

  have hup := wc_pfc_p_chart_embdim_le k t s (𝔮.comap (MvPolynomial.aeval (R := k) lam).toRingHom)
    (𝔮.comap φ'.toRingHom) hdec hcomap

  have hmid : e₀ + s ≤
      Submodule.spanFinrank (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮)) := by
    apply wc_pfc_p_cotangent_indep_card _ (e₀ + s) (Fin.append g (fun l => x' (ι l)))
    · intro i
      induction i using Fin.addCases with
      | left j => rw [Fin.append_left]; exact hgm j
      | right l => rw [Fin.append_right]; exact hx'm (ι l)
    · intro c hc
      rw [Fin.sum_univ_add] at hc
      simp only [Fin.append_left, Fin.append_right] at hc
      have hjJ : (∑ i : Fin e₀, c (Fin.castAdd s i) * g i) ∈ J :=
        Ideal.sum_mem _ (fun i _ => Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨i, rfl⟩))
      have hnat : ∀ l, c (Fin.natAdd e₀ l) ∈ IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) :=
        hcomp (fun l => c (Fin.natAdd e₀ l)) _ hjJ hc
      have hsq : (∑ l : Fin s, c (Fin.natAdd e₀ l) * x' (ι l)) ∈
          IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) ^ 2 := by
        apply Ideal.sum_mem
        intro l _
        rw [pow_two]
        exact Ideal.mul_mem_mul (hnat l) (hx'm (ι l))
      have hdiff := Ideal.sub_mem _ hc hsq
      rw [add_sub_cancel_right] at hdiff
      have hcast := hGind (fun i => c (Fin.castAdd s i)) hdiff
      intro i
      induction i using Fin.addCases with
      | left j => exact hcast j
      | right l => exact hnat l

  have hθmem : ∀ q ∈ 𝔮.comap φ'.toRingHom,
      algebraMap Λ (Localization.AtPrime 𝔮) (φ' q) ∈
        Ideal.map (Localization.localRingHom (𝔮.comap φ'.toRingHom) 𝔮 φ'.toRingHom rfl)
          (IsLocalRing.maximalIdeal (Localization.AtPrime (𝔮.comap φ'.toRingHom))) := by
    intro q hq
    have e : algebraMap Λ (Localization.AtPrime 𝔮) (φ' q) =
        Localization.localRingHom (𝔮.comap φ'.toRingHom) 𝔮 φ'.toRingHom rfl
          (algebraMap _ (Localization.AtPrime (𝔮.comap φ'.toRingHom)) q) :=
      (Localization.localRingHom_to_map _ _ _ rfl q).symm
    rw [e]
    apply Ideal.mem_map_of_mem
    rw [← Localization.AtPrime.map_eq_maximalIdeal]
    exact Ideal.mem_map_of_mem _ hq
  have hJθ : J ≤ Ideal.map (Localization.localRingHom (𝔮.comap φ'.toRingHom) 𝔮 φ'.toRingHom rfl)
      (IsLocalRing.maximalIdeal (Localization.AtPrime (𝔮.comap φ'.toRingHom))) := by
    apply Ideal.span_le.mpr
    rintro _ ⟨i, rfl⟩
    have h2 : MvPolynomial.rename (Fin.castAdd s) (G i) ∈ 𝔮.comap φ'.toRingHom := by
      rw [Ideal.mem_comap]
      change φ' _ ∈ 𝔮
      rw [hφren]
      exact hGq i
    have h3 := hθmem _ h2
    rw [hφren] at h3
    exact h3
  have hxθ : Ideal.span (Set.range fun l => x' (ι l)) ≤
      Ideal.map (Localization.localRingHom (𝔮.comap φ'.toRingHom) 𝔮 φ'.toRingHom rfl)
        (IsLocalRing.maximalIdeal (Localization.AtPrime (𝔮.comap φ'.toRingHom))) := by
    apply Ideal.span_le.mpr
    rintro _ ⟨l, rfl⟩
    have h2 : MvPolynomial.X (Fin.natAdd t l) ∈ 𝔮.comap φ'.toRingHom := by
      rw [Ideal.mem_comap]
      change φ' _ ∈ 𝔮
      rw [hφnat]
      exact hxq _
    have h3 := hθmem _ h2
    rw [hφnat] at h3
    exact h3
  have hle : IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) ≤
      Ideal.map (Localization.localRingHom (𝔮.comap φ'.toRingHom) 𝔮 φ'.toRingHom rfl)
        (IsLocalRing.maximalIdeal (Localization.AtPrime (𝔮.comap φ'.toRingHom))) ⊔
      IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) ^ 2 :=
    hcov.trans (sup_le_sup_right (sup_le hJθ hxθ) _)
  obtain ⟨hmap, hlow⟩ := wc_pfc_p_chart_nakayama _ _
    (Localization.localRingHom (𝔮.comap φ'.toRingHom) 𝔮 φ'.toRingHom rfl)
    (Localization.isLocalHom_localRingHom _ _ _ rfl) hle
  refine ⟨hmap, ?_⟩

  omega

theorem wc_pfe_hom_poly_repr : ∀ (R : Type u) [CommRing R] (d : ℕ) (x : Fin d → R) (I : Ideal R) (n : ℕ) (z : R), z ∈ I * Ideal.span (Set.range x) ^ n ↔ ∃ G : MvPolynomial (Fin d) R, G.IsHomogeneous n ∧ (∀ α, G.coeff α ∈ I) ∧ MvPolynomial.eval x G = z :=
by
  classical
  intro R _ d x I n z
  constructor
  · intro hz
    induction n generalizing z with
    | zero =>
      rw [pow_zero, mul_one] at hz
      refine ⟨MvPolynomial.C z, MvPolynomial.isHomogeneous_C _ _, fun α => ?_,
        MvPolynomial.eval_C _⟩
      rw [MvPolynomial.coeff_C]
      split_ifs
      · exact hz
      · exact I.zero_mem
    | succ n ih =>
      rw [pow_succ, ← mul_assoc] at hz
      refine Submodule.mul_induction_on
        (C := fun w => ∃ G : MvPolynomial (Fin d) R, G.IsHomogeneous (n + 1) ∧
          (∀ α, G.coeff α ∈ I) ∧ MvPolynomial.eval x G = w) hz ?_ ?_
      · intro u hu v hv
        obtain ⟨Gu, hGu, hcu, heu⟩ := ih u hu
        obtain ⟨c, hc⟩ := (Ideal.mem_span_range_iff_exists_fun).mp hv
        refine ⟨∑ i, MvPolynomial.C (c i) * (MvPolynomial.X i * Gu), ?_, ?_, ?_⟩
        · apply MvPolynomial.IsHomogeneous.sum
          intro i _
          have h1 : (MvPolynomial.X i * Gu).IsHomogeneous (1 + n) :=
            (MvPolynomial.isHomogeneous_X R i).mul hGu
          rw [add_comm] at h1
          exact h1.C_mul _
        · intro α
          rw [MvPolynomial.coeff_sum]
          apply Ideal.sum_mem
          intro i _
          rw [MvPolynomial.coeff_C_mul, MvPolynomial.coeff_X_mul']
          apply Ideal.mul_mem_left
          split_ifs
          · exact hcu _
          · exact I.zero_mem
        · rw [map_sum]
          simp only [map_mul, MvPolynomial.eval_C, MvPolynomial.eval_X, heu]
          rw [← hc, Finset.mul_sum]
          exact Finset.sum_congr rfl fun i _ => by ring
      · rintro a b ⟨Ga, hGa, hca, hea⟩ ⟨Gb, hGb, hcb, heb⟩
        refine ⟨Ga + Gb, hGa.add hGb, fun α => ?_, by rw [map_add, hea, heb]⟩
        rw [MvPolynomial.coeff_add]
        exact I.add_mem (hca α) (hcb α)
  · rintro ⟨G, hG, hc, rfl⟩
    rw [MvPolynomial.eval_eq']
    apply Ideal.sum_mem
    intro α hα
    apply Ideal.mul_mem_mul (hc α)
    have hdeg : ∑ i, α i = n := by
      have h1 : Finsupp.degree α = n := by
        by_contra hne
        exact (MvPolynomial.mem_support_iff.mp hα) (hG.coeff_eq_zero hne)
      rwa [Finsupp.degree_eq_sum] at h1
    rw [← hdeg, ← Finset.prod_pow_eq_pow_sum]
    apply Ideal.prod_mem_prod
    intro i _
    exact Ideal.pow_mem_pow (Ideal.subset_span (Set.mem_range_self i)) _

theorem wc_pfe_quasi_regular : (∀ (R : Type u) [CommRing R] (d : ℕ) (x : Fin d → R) (I : Ideal R) (n : ℕ) (z : R), z ∈ I * Ideal.span (Set.range x) ^ n ↔ ∃ G : MvPolynomial (Fin d) R, G.IsHomogeneous n ∧ (∀ α, G.coeff α ∈ I) ∧ MvPolynomial.eval x G = z) → ∀ (A : Type u) [CommRing A] (d : ℕ) (y : Fin d → A), (∀ (U : Set (Fin d)) (j : Fin d), j ∉ U → ∀ s : A, y j * s ∈ Ideal.span (y '' U) → s ∈ Ideal.span (y '' U)) → ∀ (n : ℕ) (F : MvPolynomial (Fin d) A), F.IsHomogeneous n → MvPolynomial.eval y F ∈ Ideal.span (Set.range y) ^ (n + 1) → ∀ α, F.coeff α ∈ Ideal.span (Set.range y) :=
by
  intro Rep A _

  have t_tail : ∀ (c : ℕ) (y : Fin (c + 1) → A), (∀ (U : Set (Fin (c + 1))) (j : Fin (c + 1)), j ∉ U → ∀ s : A, y j * s ∈ Ideal.span (y '' U) → s ∈ Ideal.span (y '' U)) → (∀ (U : Set (Fin c)) (j : Fin c), j ∉ U → ∀ s : A, Fin.tail y j * s ∈ Ideal.span (Fin.tail y '' U) → s ∈ Ideal.span (Fin.tail y '' U)) ∧ (∀ s : A, y 0 * s ∈ Ideal.span (Set.range (Fin.tail y)) → s ∈ Ideal.span (Set.range (Fin.tail y))) ∧ Ideal.span (Set.range (Fin.tail y)) ⊔ Ideal.span {y 0} ≤ Ideal.span (Set.range y) := by
    intro c y H
    refine ⟨?_, ?_, ?_⟩
    · intro U j hj s hs
      have himg : y '' (Fin.succ '' U) = Fin.tail y '' U := by
        rw [Set.image_image]; rfl
      have hj' : j.succ ∉ Fin.succ '' U := by
        rintro ⟨u, hu, huj⟩
        exact hj (Fin.succ_injective _ huj ▸ hu)
      have := H (Fin.succ '' U) j.succ hj' s (by rw [himg]; exact hs)
      rwa [himg] at this
    · intro s hs
      have himg : y '' Set.range Fin.succ = Set.range (Fin.tail y) := by
        rw [← Set.range_comp]; rfl
      have h0 : (0 : Fin (c+1)) ∉ Set.range Fin.succ := by
        rintro ⟨i, hi⟩; exact Fin.succ_ne_zero i hi
      have := H _ 0 h0 s (by rw [himg]; exact hs)
      rwa [himg] at this
    · refine sup_le (Ideal.span_mono ?_) ?_
      · rintro _ ⟨i, rfl⟩; exact ⟨i.succ, rfl⟩
      · rw [Ideal.span_singleton_le_iff_mem]; exact Ideal.subset_span ⟨0, rfl⟩

  have t_split : ∀ (c n : ℕ) (y : Fin (c + 1) → A) (F : MvPolynomial (Fin (c + 1)) A), F.IsHomogeneous n → (∀ e ≤ n, ((MvPolynomial.finSuccEquiv A c F).coeff e).IsHomogeneous (n - e)) ∧ (∀ e, n < e → (MvPolynomial.finSuccEquiv A c F).coeff e = 0) ∧ MvPolynomial.eval y F = ∑ e ∈ Finset.range (n + 1), y 0 ^ e * MvPolynomial.eval (Fin.tail y) ((MvPolynomial.finSuccEquiv A c F).coeff e) ∧ ∀ α : Fin (c + 1) →₀ ℕ, F.coeff α = ((MvPolynomial.finSuccEquiv A c F).coeff (α 0)).coeff α.tail := by
    intro c n y F hF
    have hdeg : (MvPolynomial.finSuccEquiv A c F).natDegree ≤ n := by
      rw [MvPolynomial.natDegree_finSuccEquiv]
      exact (MvPolynomial.degreeOf_le_totalDegree F 0).trans hF.totalDegree_le
    have hvan : ∀ e, n < e → (MvPolynomial.finSuccEquiv A c F).coeff e = 0 := fun e he =>
      Polynomial.coeff_eq_zero_of_natDegree_lt (lt_of_le_of_lt hdeg he)
    refine ⟨fun e he => hF.finSuccEquiv_coeff_isHomogeneous e (n - e) (by omega), hvan, ?_, ?_⟩
    · conv_lhs => rw [← Fin.cons_self_tail y]
      rw [MvPolynomial.eval_eq_eval_mv_eval']
      rw [Polynomial.eval_eq_sum_range' (n := n + 1)]
      · refine Finset.sum_congr rfl (fun e _ => ?_)
        rw [Polynomial.coeff_map, mul_comm]
      · exact lt_of_le_of_lt (Polynomial.natDegree_map_le.trans hdeg) (Nat.lt_succ_self n)
    · intro α
      conv_lhs => rw [← Finsupp.cons_tail α]
      rw [MvPolynomial.finSuccEquiv_coeff_coeff]

  have t_nzd : ∀ (c : ℕ) (y : Fin c → A) (t : A), (∀ (m : ℕ) (P : MvPolynomial (Fin c) A), P.IsHomogeneous m → MvPolynomial.eval y P ∈ Ideal.span (Set.range y) ^ (m + 1) → ∀ α, P.coeff α ∈ Ideal.span (Set.range y)) → (∀ s : A, t * s ∈ Ideal.span (Set.range y) → s ∈ Ideal.span (Set.range y)) → ∀ (l k : ℕ) (s : A), t ^ l * s ∈ Ideal.span (Set.range y) ^ k → s ∈ Ideal.span (Set.range y) ^ k := by
    intro c y t QR N
    have h0 : ∀ l a, t ^ l * a ∈ Ideal.span (Set.range y) → a ∈ Ideal.span (Set.range y) := by
      intro l
      induction l with
      | zero => intro a h; simpa using h
      | succ l ih =>
        intro a h
        rw [pow_succ', mul_assoc] at h
        exact ih a (N _ h)
    intro l k
    induction k with
    | zero => intro s _; simp
    | succ k ih =>
      intro s hs
      have hsk : s ∈ Ideal.span (Set.range y) ^ k := ih s (Ideal.pow_le_pow_right (Nat.le_succ k) hs)
      obtain ⟨P, hP, -, hPe⟩ := (Rep A c y ⊤ k s).mp (by rw [Ideal.top_mul]; exact hsk)
      have hP' : (MvPolynomial.C (t ^ l) * P).IsHomogeneous k := by
        have := (MvPolynomial.isHomogeneous_C (Fin c) (t ^ l)).mul hP
        rwa [zero_add] at this
      have hcoef := QR k _ hP' (by rw [MvPolynomial.eval_mul, MvPolynomial.eval_C, hPe]; exact hs)
      have hPJ : ∀ α, P.coeff α ∈ Ideal.span (Set.range y) := fun α => h0 l _ (by
        have := hcoef α
        rwa [MvPolynomial.coeff_C_mul] at this)
      rw [pow_succ']
      exact (Rep A c y _ k s).mpr ⟨P, hP, hPJ, hPe⟩

  have t_desc : ∀ (c : ℕ) (y : Fin c → A) (t : A), (∀ (m : ℕ) (P : MvPolynomial (Fin c) A), P.IsHomogeneous m → MvPolynomial.eval y P ∈ Ideal.span (Set.range y) ^ (m + 1) → ∀ α, P.coeff α ∈ Ideal.span (Set.range y)) → (∀ (l k : ℕ) (s : A), t ^ l * s ∈ Ideal.span (Set.range y) ^ k → s ∈ Ideal.span (Set.range y) ^ k) → ∀ (n l : ℕ), l ≤ n → ∀ G : ℕ → MvPolynomial (Fin c) A, (∀ e ≤ l, (G e).IsHomogeneous (n - e)) → ∑ e ∈ Finset.range (l + 1), t ^ e * MvPolynomial.eval y (G e) ∈ Ideal.span (Set.range y) ^ (n + 1) → ∀ e ≤ l, ∀ α, (G e).coeff α ∈ Ideal.span (Set.range y) ⊔ Ideal.span {t} := by
    intro c y t QR L
    have R0 : ∀ (m : ℕ) (P : MvPolynomial (Fin c) A), P.IsHomogeneous m → MvPolynomial.eval y P ∈ Ideal.span (Set.range y) ^ m := by
      intro m P hP
      have := (Rep A c y ⊤ m _).mpr ⟨P, hP, fun _ => Submodule.mem_top, rfl⟩
      rwa [Ideal.top_mul] at this
    intro n l
    induction l with
    | zero =>
      intro _ G hG hS e he α
      have he0 : e = 0 := by omega
      rw [he0]
      rw [Finset.sum_range_one, pow_zero, one_mul] at hS
      exact Ideal.mem_sup_left (QR n (G 0) (by simpa using hG 0 le_rfl) hS α)
    | succ l ih =>
      intro hln G hG hS
      rw [Finset.sum_range_succ] at hS
      have hLowmem : ∑ e ∈ Finset.range (l + 1), t ^ e * MvPolynomial.eval y (G e) ∈ Ideal.span (Set.range y) ^ (n - l) := by
        refine Ideal.sum_mem _ (fun e he => ?_)
        have he' : e ≤ l := Nat.lt_succ_iff.mp (Finset.mem_range.mp he)
        exact Ideal.mul_mem_left _ _ (Ideal.pow_le_pow_right (by omega) (R0 _ _ (hG e (by omega))))
      have hSmem := Ideal.pow_le_pow_right (I := Ideal.span (Set.range y)) (show n - l ≤ n + 1 by omega) hS
      have htop : t ^ (l + 1) * MvPolynomial.eval y (G (l + 1)) ∈ Ideal.span (Set.range y) ^ (n - l) := by
        have := Ideal.sub_mem _ hSmem hLowmem
        rwa [add_sub_cancel_left] at this
      have hev' := L (l + 1) (n - l) _ htop
      have hev : MvPolynomial.eval y (G (l + 1)) ∈ Ideal.span (Set.range y) ^ (n - (l + 1) + 1) := by
        rwa [show n - (l + 1) + 1 = n - l by omega]
      have hlast : ∀ α, (G (l + 1)).coeff α ∈ Ideal.span (Set.range y) := QR _ _ (hG (l + 1) le_rfl) hev
      obtain ⟨Q, hQ, -, hQe⟩ := (Rep A c y ⊤ (n - l) _).mp (by rw [Ideal.top_mul]; exact hev')
      have hG'hom : ∀ e ≤ l, (Function.update G l (G l + MvPolynomial.C t * Q) e).IsHomogeneous (n - e) := by
        intro e he
        by_cases hel : e = l
        · rw [hel, Function.update_self]
          refine (hG l (by omega)).add ?_
          have := (MvPolynomial.isHomogeneous_C (Fin c) t).mul hQ
          rwa [zero_add] at this
        · rw [Function.update_of_ne hel]
          exact hG e (by omega)
      have hsum : ∑ e ∈ Finset.range (l + 1), t ^ e * MvPolynomial.eval y (Function.update G l (G l + MvPolynomial.C t * Q) e) = ∑ e ∈ Finset.range (l + 1), t ^ e * MvPolynomial.eval y (G e) + t ^ (l + 1) * MvPolynomial.eval y (G (l + 1)) := by
        rw [Finset.sum_range_succ, Finset.sum_range_succ]
        have hrest : ∑ e ∈ Finset.range l, t ^ e * MvPolynomial.eval y (Function.update G l (G l + MvPolynomial.C t * Q) e) = ∑ e ∈ Finset.range l, t ^ e * MvPolynomial.eval y (G e) := by
          refine Finset.sum_congr rfl (fun e he => ?_)
          rw [Function.update_of_ne (Nat.ne_of_lt (Finset.mem_range.mp he))]
        rw [hrest, Function.update_self, MvPolynomial.eval_add, MvPolynomial.eval_mul, MvPolynomial.eval_C, hQe]
        ring
      have hIH := ih (by omega) _ hG'hom (by rw [hsum]; exact hS)
      intro e he α
      rcases Nat.lt_or_ge e (l + 1) with hlt | hge
      · by_cases hel : e = l
        · rw [hel]
          have h1 := hIH l le_rfl α
          rw [Function.update_self, MvPolynomial.coeff_add, MvPolynomial.coeff_C_mul] at h1
          have h2 : t * Q.coeff α ∈ Ideal.span (Set.range y) ⊔ Ideal.span {t} :=
            Ideal.mem_sup_right (Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self t))
          have := Ideal.sub_mem _ h1 h2
          rwa [add_sub_cancel_right] at this
        · have h1 := hIH e (by omega) α
          rwa [Function.update_of_ne hel] at h1
      · have : e = l + 1 := by omega
        rw [this]
        exact Ideal.mem_sup_left (hlast α)

  intro d
  induction d with
  | zero =>
    intro y _ n F _ hv α
    have hJ : Ideal.span (Set.range y) = ⊥ := by
      rw [Set.range_eq_empty, Ideal.span_empty]
    rw [hJ] at hv ⊢
    have hv0 : MvPolynomial.eval y F = 0 := by
      rw [← Ideal.mem_bot]; exact Ideal.pow_le_self (Nat.succ_ne_zero n) hv
    have hα : α = 0 := Finsupp.ext (fun i => Fin.elim0 i)
    rw [hα]
    rw [MvPolynomial.eq_C_of_isEmpty F, MvPolynomial.eval_C] at hv0
    rw [Ideal.mem_bot]
    exact hv0
  | succ c ih =>
    intro y hH n F hF hv α
    obtain ⟨hH', hN, hle⟩ := t_tail c y hH
    have hQR' := ih (Fin.tail y) hH'
    have hL := t_nzd c (Fin.tail y) (y 0) hQR' hN
    obtain ⟨G, hG, hGc, hGe⟩ := (Rep A (c + 1) y (Ideal.span (Set.range y)) n _).mp
      (by rw [← pow_succ']; exact hv)
    obtain ⟨hom, van, split, coeffEq⟩ := t_split c n y (F - G) (hF.sub hG)
    have hz : ∑ e ∈ Finset.range (n + 1), y 0 ^ e * MvPolynomial.eval (Fin.tail y)
        ((MvPolynomial.finSuccEquiv A c (F - G)).coeff e) ∈
        Ideal.span (Set.range (Fin.tail y)) ^ (n + 1) := by
      rw [← split, MvPolynomial.eval_sub, hGe, sub_self]; exact Submodule.zero_mem _
    have hdesc := t_desc c (Fin.tail y) (y 0) hQR' hL n n le_rfl
      (fun e => (MvPolynomial.finSuccEquiv A c (F - G)).coeff e) hom hz
    have hsplitc : F.coeff α = (F - G).coeff α + G.coeff α := by
      rw [MvPolynomial.coeff_sub, sub_add_cancel]
    rw [hsplitc]
    refine Ideal.add_mem _ ?_ (hGc α)
    rw [coeffEq α]
    by_cases hα : α 0 ≤ n
    · exact hle (hdesc _ hα _)
    · rw [van _ (by omega), MvPolynomial.coeff_zero]; exact Submodule.zero_mem _

theorem wc_pfe_free_mod_pow : (∀ (R : Type u) [CommRing R] (d : ℕ) (x : Fin d → R) (I : Ideal R) (n : ℕ) (z : R), z ∈ I * Ideal.span (Set.range x) ^ n ↔ ∃ G : MvPolynomial (Fin d) R, G.IsHomogeneous n ∧ (∀ α, G.coeff α ∈ I) ∧ MvPolynomial.eval x G = z) → ∀ (B : Type u) [CommRing B] [IsLocalRing B] (A : Type u) [CommRing A] [IsLocalRing A] [Algebra B A], IsLocalHom (algebraMap B A) → Ideal.map (algebraMap B A) (IsLocalRing.maximalIdeal B) = IsLocalRing.maximalIdeal A → ∀ (d : ℕ) (x : Fin d → B), Ideal.span (Set.range x) = IsLocalRing.maximalIdeal B → (∀ (n : ℕ) (F : MvPolynomial (Fin d) A), F.IsHomogeneous n → MvPolynomial.eval (fun i => algebraMap B A (x i)) F ∈ IsLocalRing.maximalIdeal A ^ (n + 1) → ∀ α, F.coeff α ∈ IsLocalRing.maximalIdeal A) → ∀ n : ℕ, Module.Free (B ⧸ IsLocalRing.maximalIdeal B ^ n) (A ⧸ Ideal.map (algebraMap B A) (IsLocalRing.maximalIdeal B ^ n)) :=
by
  classical
  intro Rep B _ _ A _ _ _ hloc hmap d x hx QR n
  haveI : IsLocalHom (algebraMap B A) := hloc

  obtain ⟨ι, e, hsp1, hri⟩ : ∃ (ι : Type u) (e : ι → A),
      (∀ a : A, ∃ y ∈ Submodule.span B (Set.range e), a - y ∈ IsLocalRing.maximalIdeal A) ∧
      (∀ (s : Finset ι) (c : ι → B), ∑ l ∈ s, algebraMap B A (c l) * e l ∈
        IsLocalRing.maximalIdeal A → ∀ l ∈ s, c l ∈ IsLocalRing.maximalIdeal B) := by
    let b := Module.Basis.ofVectorSpace (IsLocalRing.ResidueField B) (IsLocalRing.ResidueField A)
    let e := fun l => Function.surjInv (IsLocalRing.residue_surjective (R := A)) (b l)
    have he : ∀ l, IsLocalRing.residue A (e l) = b l := fun l => Function.surjInv_eq _ _
    let lift := Function.surjInv (IsLocalRing.residue_surjective (R := B))
    have hlift : ∀ r, IsLocalRing.residue B (lift r) = r := fun r => Function.surjInv_eq _ _
    have hres : ∀ (s : Finset _) (c : _ → B),
        IsLocalRing.residue A (∑ l ∈ s, algebraMap B A (c l) * e l)
        = ∑ l ∈ s, IsLocalRing.residue B (c l) • b l := by
      intro s c
      rw [map_sum]
      refine Finset.sum_congr rfl fun l _ => ?_
      rw [map_mul, he, Algebra.smul_def, IsLocalRing.ResidueField.algebraMap_residue]
    refine ⟨_, e, ?_, ?_⟩
    · intro a
      refine ⟨∑ l ∈ (b.repr (IsLocalRing.residue A a)).support,
        algebraMap B A (lift (b.repr (IsLocalRing.residue A a) l)) * e l, ?_, ?_⟩
      · refine Submodule.sum_mem _ fun l _ => ?_
        rw [← Algebra.smul_def]
        exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨l, rfl⟩)
      · rw [← IsLocalRing.residue_eq_zero_iff, map_sub, hres, sub_eq_zero]
        conv_lhs => rw [← b.linearCombination_repr (IsLocalRing.residue A a)]
        rw [Finsupp.linearCombination_apply, Finsupp.sum]
        simp only [hlift]
    · intro s c hs l hl
      have h0 := (IsLocalRing.residue_eq_zero_iff _).mpr hs
      rw [hres] at h0
      have := linearIndependent_iff'.mp b.linearIndependent s _ h0 l hl
      exact (IsLocalRing.residue_eq_zero_iff _).mp this

  have hspan : ∀ (j : ℕ) (a : A), ∃ y ∈ Submodule.span B (Set.range e),
      a - y ∈ IsLocalRing.maximalIdeal A ^ j := by
    intro j
    induction j with
    | zero => intro a; exact ⟨0, zero_mem _, by simp⟩
    | succ j ih =>
      have K : ∀ z ∈ IsLocalRing.maximalIdeal A ^ j, ∀ a' : A,
          ∃ y' ∈ Submodule.span B (Set.range e),
          a' * z - y' ∈ IsLocalRing.maximalIdeal A ^ (j+1) := by
        intro z hz
        rw [← hmap, ← Ideal.map_pow] at hz
        change z ∈ Submodule.span A (⇑(algebraMap B A) '' ↑(IsLocalRing.maximalIdeal B ^ j)) at hz
        induction hz using Submodule.span_induction with
        | mem w hw =>
          obtain ⟨β, hβ, rfl⟩ := hw
          intro a'
          obtain ⟨y0, hy0, ha⟩ := hsp1 a'
          refine ⟨β • y0, Submodule.smul_mem _ _ hy0, ?_⟩
          have : a' * algebraMap B A β - β • y0 = (a' - y0) * algebraMap B A β := by
            rw [Algebra.smul_def]; ring
          rw [this, pow_succ']
          apply Ideal.mul_mem_mul ha
          rw [← hmap, ← Ideal.map_pow]; exact Ideal.mem_map_of_mem _ hβ
        | zero => intro a'; exact ⟨0, zero_mem _, by simp⟩
        | add w z _ _ hw hz =>
          intro a'
          obtain ⟨y1, hy1, h1'⟩ := hw a'
          obtain ⟨y2, hy2, h2'⟩ := hz a'
          refine ⟨y1 + y2, add_mem hy1 hy2, ?_⟩
          have : a' * (w + z) - (y1 + y2) = (a' * w - y1) + (a' * z - y2) := by ring
          rw [this]; exact add_mem h1' h2'
        | smul r w _ hw =>
          intro a'
          obtain ⟨y1, hy1, h1'⟩ := hw (a' * r)
          refine ⟨y1, hy1, ?_⟩
          rw [smul_eq_mul, ← mul_assoc]; exact h1'
      intro a
      obtain ⟨y, hy, hz⟩ := ih a
      obtain ⟨y', hy', h'⟩ := K _ hz 1
      refine ⟨y + y', add_mem hy hy', ?_⟩
      rw [one_mul] at h'
      have : a - (y + y') = a - y - y' := by ring
      rw [this]; exact h'

  have RI : ∀ (s : Finset ι) (c : ι → B), ∑ l ∈ s, algebraMap B A (c l) * e l ∈
      IsLocalRing.maximalIdeal A → ∀ l ∈ s, c l ∈ Ideal.span (Set.range x) := by
    rw [hx]; exact hri
  have key : ∀ P : MvPolynomial (Fin d) B, MvPolynomial.eval (fun i => algebraMap B A (x i))
      (MvPolynomial.map (algebraMap B A) P) = algebraMap B A (MvPolynomial.eval x P) := by
    intro P
    induction P using MvPolynomial.induction_on with
    | C a => simp
    | add p q hp hq => simp [hp, hq]
    | mul_X p i hp => simp [hp]
  have hindep : ∀ (j : ℕ) (s : Finset ι) (c : ι → B), ∑ l ∈ s, algebraMap B A (c l) * e l ∈
      IsLocalRing.maximalIdeal A ^ j → ∀ l ∈ s, c l ∈ Ideal.span (Set.range x) ^ j := by
    intro j
    induction j with
    | zero => intro s c _ l _; simp
    | succ j ih =>
      intro s c hs
      have hj := ih s c (Ideal.pow_le_pow_right (Nat.le_succ j) hs)
      have hG : ∀ l, ∃ G : MvPolynomial (Fin d) B, l ∈ s →
          (G.IsHomogeneous j ∧ MvPolynomial.eval x G = c l) := by
        intro l
        by_cases hl : l ∈ s
        · have hm : c l ∈ ⊤ * Ideal.span (Set.range x) ^ j := by
            rw [Ideal.top_mul]; exact hj l hl
          obtain ⟨G, hGh, -, hGe⟩ := (Rep B d x ⊤ j (c l)).mp hm
          exact ⟨G, fun _ => ⟨hGh, hGe⟩⟩
        · exact ⟨0, fun h => absurd h hl⟩
      choose G hG using hG
      have hFh : (∑ l ∈ s, MvPolynomial.C (e l) *
          MvPolynomial.map (algebraMap B A) (G l)).IsHomogeneous j := by
        apply MvPolynomial.IsHomogeneous.sum
        intro l hl
        exact ((hG l hl).1.map _).C_mul _
      have hFe : MvPolynomial.eval (fun i => algebraMap B A (x i))
          (∑ l ∈ s, MvPolynomial.C (e l) * MvPolynomial.map (algebraMap B A) (G l))
          = ∑ l ∈ s, algebraMap B A (c l) * e l := by
        rw [map_sum]
        refine Finset.sum_congr rfl fun l hl => ?_
        rw [map_mul, MvPolynomial.eval_C, key, (hG l hl).2, mul_comm]
      have hcoef := QR j _ hFh (by rw [hFe]; exact hs)
      have hGc : ∀ α, ∀ l ∈ s, (G l).coeff α ∈ Ideal.span (Set.range x) := by
        intro α
        apply RI s (fun l => (G l).coeff α)
        have := hcoef α
        simp only [MvPolynomial.coeff_sum, MvPolynomial.coeff_C_mul,
          MvPolynomial.coeff_map] at this
        convert this using 1
        exact Finset.sum_congr rfl fun l _ => mul_comm _ _
      intro l hl
      have := (Rep B d x (Ideal.span (Set.range x)) j (c l)).mpr
        ⟨G l, (hG l hl).1, fun α => hGc α l hl, (hG l hl).2⟩
      rwa [← pow_succ'] at this

  have hmapn : Ideal.map (algebraMap B A) (IsLocalRing.maximalIdeal B ^ n)
      = IsLocalRing.maximalIdeal A ^ n := by rw [Ideal.map_pow, hmap]
  have hsp : ∀ a : A, ∃ y ∈ Submodule.span B (Set.range e),
      a - y ∈ Ideal.map (algebraMap B A) (IsLocalRing.maximalIdeal B ^ n) := by
    rw [hmapn]; exact hspan n
  have hli : ∀ (s : Finset ι) (c : ι → B), ∑ l ∈ s, algebraMap B A (c l) * e l ∈
      Ideal.map (algebraMap B A) (IsLocalRing.maximalIdeal B ^ n) →
      ∀ l ∈ s, c l ∈ IsLocalRing.maximalIdeal B ^ n := by
    rw [hmapn, ← hx]; exact hindep n
  generalize IsLocalRing.maximalIdeal B ^ n = I at hsp hli
  let v : ι → A ⧸ Ideal.map (algebraMap B A) I :=
    fun l => Ideal.Quotient.mk (Ideal.map (algebraMap B A) I) (e l)
  have hmem : ∀ y ∈ Submodule.span B (Set.range e),
      Ideal.Quotient.mk (Ideal.map (algebraMap B A) I) y ∈
        Submodule.span (B ⧸ I) (Set.range v) := by
    intro y hy
    induction hy using Submodule.span_induction with
    | mem z hz =>
      obtain ⟨l, rfl⟩ := hz
      exact Submodule.subset_span ⟨l, rfl⟩
    | zero => simp
    | add y z _ _ hy hz => rw [map_add]; exact add_mem hy hz
    | smul b y _ hy =>
      rw [Algebra.smul_def, ← Ideal.Quotient.mk_smul_mk_quotient_map_quotient]
      exact Submodule.smul_mem _ _ hy
  have hsp' : ⊤ ≤ Submodule.span (B ⧸ I) (Set.range v) := by
    rintro w -
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective w
    obtain ⟨y, hy, hay⟩ := hsp a
    have : Ideal.Quotient.mk (Ideal.map (algebraMap B A) I) a
        = Ideal.Quotient.mk (Ideal.map (algebraMap B A) I) y := Ideal.Quotient.eq.mpr hay
    rw [this]; exact hmem y hy
  have hli' : LinearIndependent (B ⧸ I) v := by
    rw [linearIndependent_iff']
    intro s g hg l hl
    let c : ι → B := fun l => Function.surjInv Ideal.Quotient.mk_surjective (g l)
    have hc : ∀ l, Ideal.Quotient.mk I (c l) = g l := fun l => Function.surjInv_eq _ _
    have h0 : Ideal.Quotient.mk (Ideal.map (algebraMap B A) I)
        (∑ l ∈ s, algebraMap B A (c l) * e l) = 0 := by
      rw [map_sum, ← hg]
      refine Finset.sum_congr rfl fun l _ => ?_
      rw [← hc l, Ideal.Quotient.mk_smul_mk_quotient_map_quotient]
    have := hli s c (Ideal.Quotient.eq_zero_iff_mem.mp h0) l hl
    rw [← hc l]; exact Ideal.Quotient.eq_zero_iff_mem.mpr this
  exact Module.Free.of_basis (Module.Basis.mk hli' hsp')

theorem wc_pfe_flat_of_lTensor_quot_pow : ∀ (B : Type u) [CommRing B] [IsLocalRing B] [IsNoetherianRing B] (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A] [Algebra B A], IsLocalHom (algebraMap B A) → (∀ (n : ℕ) (P : Submodule B (B ⧸ IsLocalRing.maximalIdeal B ^ n)), Function.Injective (LinearMap.lTensor A P.subtype)) → Module.Flat B A :=
by
  intro B _ _ _ A _ _ _ _ hφ hinj
  rw [Module.Flat.iff_lTensor_injective']
  intro I
  rw [injective_iff_map_eq_zero]
  intro z hz

  obtain ⟨c, hc⟩ := Ideal.exists_pow_inf_eq_pow_smul (IsLocalRing.maximalIdeal B)
    (I : Submodule B B)
  have hAR : ∀ n ≥ c, IsLocalRing.maximalIdeal B ^ n ⊓ I ≤
      IsLocalRing.maximalIdeal B ^ (n - c) * I := by
    intro n hn
    have h := hc n hn
    simp only [Ideal.smul_eq_mul, Ideal.mul_top] at h
    rw [h]
    exact Ideal.mul_mono_right inf_le_right

  have hrange : ∀ (J : Ideal B), (∀ P : Submodule B (B ⧸ J),
      Function.Injective (LinearMap.lTensor A P.subtype)) →
      z ∈ LinearMap.range (LinearMap.lTensor A (Submodule.inclusion (inf_le_right : J ⊓ I ≤ I))) := by
    intro J hJ
    let g : ↥I →ₗ[B] B ⧸ J := J.mkQ ∘ₗ I.subtype
    let π := g.rangeRestrict
    have hex : Function.Exact (Submodule.inclusion (inf_le_right : J ⊓ I ≤ I)) π := by
      intro i
      rw [Subtype.ext_iff]
      change g i = 0 ↔ _
      simp only [g, LinearMap.comp_apply, Submodule.mkQ_apply, Submodule.subtype_apply,
        Submodule.Quotient.mk_eq_zero]
      constructor
      · intro hi
        exact ⟨⟨i, Submodule.mem_inf.mpr ⟨hi, i.2⟩⟩, rfl⟩
      · rintro ⟨v, rfl⟩
        exact (Submodule.mem_inf.mp v.2).1
    have hexA := lTensor_exact A hex (LinearMap.surjective_rangeRestrict g)
    have hπz : LinearMap.lTensor A π z = 0 := by
      apply hJ (LinearMap.range g)
      rw [map_zero, ← LinearMap.lTensor_comp_apply, LinearMap.subtype_comp_rangeRestrict]
      have e : g = J.mkQ ∘ₗ I.subtype := rfl
      rw [e, LinearMap.lTensor_comp_apply, hz, map_zero]
    exact LinearMap.mem_range.mpr ((hexA z).mp hπz)

  have hsmall : ∀ (J L : Ideal B) (K : Ideal A), J ⊓ I ≤ L * I →
      Ideal.map (algebraMap B A) L ≤ K → ∀ w : TensorProduct B A ↥(J ⊓ I),
      LinearMap.lTensor A (Submodule.inclusion (inf_le_right : J ⊓ I ≤ I)) w ∈
        K • (⊤ : Submodule A (TensorProduct B A ↥I)) := by
    intro J L K hJL hLK w
    have hLI : L * I ≤ I := Ideal.mul_le_inf.trans inf_le_right
    have key : ∀ (a : A) (x : B) (hx : x ∈ L * I), ∀ y : ↥I, (y : B) = x →
        TensorProduct.tmul B a y ∈ K • (⊤ : Submodule A (TensorProduct B A ↥I)) := by
      intro a x hx
      refine Submodule.mul_induction_on'
        (C := fun x _ => ∀ y : ↥I, (y : B) = x →
          TensorProduct.tmul B a y ∈ K • (⊤ : Submodule A (TensorProduct B A ↥I))) ?_ ?_ hx
      · intro m hm i hi y hy
        have e : y = m • (⟨i, hi⟩ : ↥I) := Subtype.ext (by rw [hy]; rfl)
        rw [e, ← TensorProduct.smul_tmul, ← algebraMap_smul A m a, ← TensorProduct.smul_tmul']
        exact Submodule.smul_mem_smul (hLK (Ideal.mem_map_of_mem _ hm)) Submodule.mem_top
      · intro x₁ hx₁ x₂ hx₂ ih₁ ih₂ y hy
        have e : y = (⟨x₁, hLI hx₁⟩ : ↥I) + ⟨x₂, hLI hx₂⟩ := Subtype.ext (by rw [hy]; rfl)
        rw [e, TensorProduct.tmul_add]
        exact Submodule.add_mem _ (ih₁ _ rfl) (ih₂ _ rfl)
    induction w using TensorProduct.induction_on with
    | zero => rw [map_zero]; exact Submodule.zero_mem _
    | tmul a v =>
      rw [LinearMap.lTensor_tmul]
      exact key a (v : B) (hJL v.2) _ rfl
    | add w₁ w₂ h₁ h₂ =>
      rw [map_add]
      exact Submodule.add_mem _ h₁ h₂

  haveI : Module.Finite B ↥I := Module.Finite.of_fg (IsNoetherian.noetherian I)
  haveI : Module.Finite A (TensorProduct B A ↥I) := Module.Finite.base_change B A ↥I
  have hkrull := Ideal.iInf_pow_smul_eq_bot_of_isLocalRing (M := TensorProduct B A ↥I)
    (IsLocalRing.maximalIdeal A) (IsLocalRing.maximalIdeal.isMaximal A).ne_top

  have hloc : Ideal.map (algebraMap B A) (IsLocalRing.maximalIdeal B) ≤
      IsLocalRing.maximalIdeal A := by
    rw [Ideal.map_le_iff_le_comap]
    intro b hb
    apply Ideal.mem_comap.mpr
    exact (IsLocalRing.mem_maximalIdeal _).mpr
      (fun hu => (IsLocalRing.mem_maximalIdeal _).mp hb (isUnit_of_map_unit (algebraMap B A) b hu))

  have hz0 : z ∈ ⨅ k : ℕ, IsLocalRing.maximalIdeal A ^ k •
      (⊤ : Submodule A (TensorProduct B A ↥I)) := by
    rw [Submodule.mem_iInf]
    intro k
    obtain ⟨w, hw⟩ := LinearMap.mem_range.mp
      (hrange (IsLocalRing.maximalIdeal B ^ (k + c)) (hinj (k + c)))
    rw [← hw]
    apply hsmall (IsLocalRing.maximalIdeal B ^ (k + c)) (IsLocalRing.maximalIdeal B ^ k)
      (IsLocalRing.maximalIdeal A ^ k)
    · have h := hAR (k + c) (Nat.le_add_left c k)
      rwa [Nat.add_sub_cancel] at h
    · rw [Ideal.map_pow]
      exact Ideal.pow_right_mono hloc k
  rw [hkrull] at hz0
  exact (Submodule.mem_bot A).mp hz0

theorem wc_pfe_lTensor_inj_of_flat_quot : ∀ (B : Type u) [CommRing B] (A : Type u) [CommRing A] [Algebra B A] (I : Ideal B), Module.Flat (B ⧸ I) (A ⧸ Ideal.map (algebraMap B A) I) → ∀ P : Submodule B (B ⧸ I), Function.Injective (LinearMap.lTensor A P.subtype) :=
by
  intro B _ A _ _ I hflat P
  classical

  have T2 : ∀ (b : B) (a : A), (Ideal.Quotient.mk I b) • (Ideal.Quotient.mk (Ideal.map (algebraMap B A) I) a)
      = Ideal.Quotient.mk (Ideal.map (algebraMap B A) I) (b • a) := by
    intro b a
    rw [← Ideal.Quotient.algebraMap_eq, algebraMap_smul, Algebra.smul_def, Algebra.smul_def, map_mul,
      Ideal.Quotient.mk_algebraMap]

  have s1 : ∀ (N : Type u) [AddCommGroup N] [Module (B ⧸ I) N] [Module B N] [IsScalarTower B (B ⧸ I) N]
      (x : A), x ∈ Ideal.map (algebraMap B A) I → ∀ n : N, TensorProduct.tmul B x n = 0 := by
    intro N _ _ _ _ x hx n
    induction hx using Submodule.span_induction with
    | mem y hy =>
      obtain ⟨b, hb, rfl⟩ := hy
      rw [Algebra.algebraMap_eq_smul_one, TensorProduct.smul_tmul, ← algebraMap_smul (B ⧸ I) b n,
        Ideal.Quotient.algebraMap_eq, Ideal.Quotient.eq_zero_iff_mem.mpr hb, zero_smul,
        TensorProduct.tmul_zero]
    | zero => exact TensorProduct.zero_tmul _ _
    | add y z _ _ hy hz => rw [TensorProduct.add_tmul, hy, hz, add_zero]
    | smul a y _ hy => rw [smul_eq_mul, ← smul_eq_mul, ← TensorProduct.smul_tmul', hy, smul_zero]

  have s2 : ∀ (N : Type u) [AddCommGroup N] [Module (B ⧸ I) N] [Module B N] [IsScalarTower B (B ⧸ I) N],
      ∃ α : TensorProduct B A N →+ TensorProduct (B ⧸ I) (A ⧸ Ideal.map (algebraMap B A) I) N,
        Function.Injective α ∧ ∀ (a : A) (n : N), α (TensorProduct.tmul B a n) =
          TensorProduct.tmul (B ⧸ I) (Ideal.Quotient.mk (Ideal.map (algebraMap B A) I) a) n := by
    intro N _ _ _ _
    have T1N : ∀ (b : B) (n : N), (Ideal.Quotient.mk I b) • n = b • n := by
      intro b n
      rw [← Ideal.Quotient.algebraMap_eq, algebraMap_smul]
    let φ : A →+ N →+ TensorProduct (B ⧸ I) (A ⧸ Ideal.map (algebraMap B A) I) N :=
      { toFun := fun a => (TensorProduct.mk (B ⧸ I) (A ⧸ Ideal.map (algebraMap B A) I) N
            (Ideal.Quotient.mk (Ideal.map (algebraMap B A) I) a)).toAddMonoidHom
        map_zero' := by
          ext n
          simp
        map_add' := by
          intro a a'
          ext n
          simp }
    have hφ : ∀ (r : B) (m : A) (n : N), φ (r • m) n = φ m (r • n) := by
      intro r m n
      show TensorProduct.tmul (B ⧸ I) (Ideal.Quotient.mk (Ideal.map (algebraMap B A) I) (r • m)) n =
        TensorProduct.tmul (B ⧸ I) (Ideal.Quotient.mk (Ideal.map (algebraMap B A) I) m) (r • n)
      rw [← T2, TensorProduct.smul_tmul, T1N]
    have hsurj : Function.Surjective (Ideal.Quotient.mk (Ideal.map (algebraMap B A) I)) :=
      Ideal.Quotient.mk_surjective
    let σ : A ⧸ Ideal.map (algebraMap B A) I → A := Function.surjInv hsurj
    have hσ : ∀ (a : A) (n : N), TensorProduct.tmul B (σ (Ideal.Quotient.mk _ a)) n =
        TensorProduct.tmul B a n := by
      intro a n
      have h1 : Ideal.Quotient.mk (Ideal.map (algebraMap B A) I) (σ (Ideal.Quotient.mk _ a)) =
          Ideal.Quotient.mk _ a := Function.surjInv_eq hsurj _
      have h2 : σ (Ideal.Quotient.mk _ a) - a ∈ Ideal.map (algebraMap B A) I := Ideal.Quotient.eq.mp h1
      rw [← sub_eq_zero, ← TensorProduct.sub_tmul]
      exact s1 N _ h2 n
    let ψ : (A ⧸ Ideal.map (algebraMap B A) I) →+ N →+ TensorProduct B A N :=
      { toFun := fun x => (TensorProduct.mk B A N (σ x)).toAddMonoidHom
        map_zero' := by
          ext n
          show TensorProduct.tmul B (σ 0) n = 0
          rw [← map_zero (Ideal.Quotient.mk (Ideal.map (algebraMap B A) I)), hσ, TensorProduct.zero_tmul]
        map_add' := by
          intro x y
          ext n
          obtain ⟨a, rfl⟩ := hsurj x
          obtain ⟨a', rfl⟩ := hsurj y
          show TensorProduct.tmul B (σ (Ideal.Quotient.mk _ a + Ideal.Quotient.mk _ a')) n =
            TensorProduct.tmul B (σ (Ideal.Quotient.mk _ a)) n +
              TensorProduct.tmul B (σ (Ideal.Quotient.mk _ a')) n
          rw [← map_add, hσ, hσ, hσ, TensorProduct.add_tmul] }
    have hψ : ∀ (c : B ⧸ I) (x : A ⧸ Ideal.map (algebraMap B A) I) (n : N), ψ (c • x) n = ψ x (c • n) := by
      intro c x n
      obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective c
      obtain ⟨a, rfl⟩ := hsurj x
      show TensorProduct.tmul B (σ (Ideal.Quotient.mk I b • Ideal.Quotient.mk _ a)) n =
        TensorProduct.tmul B (σ (Ideal.Quotient.mk _ a)) (Ideal.Quotient.mk I b • n)
      rw [T2, hσ, hσ, T1N, TensorProduct.smul_tmul]
    have hα : ∀ (a : A) (n : N), TensorProduct.liftAddHom φ hφ (TensorProduct.tmul B a n) =
        TensorProduct.tmul (B ⧸ I) (Ideal.Quotient.mk (Ideal.map (algebraMap B A) I) a) n := by
      intro a n
      rw [TensorProduct.liftAddHom_tmul]
      rfl
    have hβ : ∀ (a : A) (n : N), TensorProduct.liftAddHom ψ hψ
        (TensorProduct.tmul (B ⧸ I) (Ideal.Quotient.mk (Ideal.map (algebraMap B A) I) a) n) =
        TensorProduct.tmul B a n := by
      intro a n
      rw [TensorProduct.liftAddHom_tmul]
      exact hσ a n
    have hinv : ∀ t, TensorProduct.liftAddHom ψ hψ (TensorProduct.liftAddHom φ hφ t) = t := by
      intro t
      induction t using TensorProduct.induction_on with
      | zero => simp only [map_zero]
      | tmul a n => rw [hα, hβ]
      | add x y hx hy => rw [map_add, map_add, hx, hy]
    exact ⟨TensorProduct.liftAddHom φ hφ, Function.LeftInverse.injective hinv, hα⟩

  let P' : Submodule (B ⧸ I) (B ⧸ I) :=
    { carrier := (P : Set (B ⧸ I))
      add_mem' := fun hx hy => P.add_mem hx hy
      zero_mem' := P.zero_mem
      smul_mem' := by
        intro c x hx
        obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective c
        have : (Ideal.Quotient.mk I b) • x = b • x := by
          rw [← Ideal.Quotient.algebraMap_eq, algebraMap_smul]
        rw [this]
        exact P.smul_mem b hx }
  let e : P ≃ₗ[B] P' :=
    { toFun := fun x => ⟨x.1, x.2⟩
      invFun := fun y => ⟨y.1, y.2⟩
      map_add' := fun _ _ => rfl
      map_smul' := fun _ _ => rfl
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl }

  have hL : Function.Injective (LinearMap.lTensor A (P'.subtype.restrictScalars B)) := by
    obtain ⟨αN, hNinj, hN⟩ := s2 P'
    obtain ⟨αM, -, hM⟩ := s2 (B ⧸ I)
    have hR : Function.Injective (LinearMap.lTensor (A ⧸ Ideal.map (algebraMap B A) I) P'.subtype) :=
      Module.Flat.lTensor_preserves_injective_linearMap _ (Submodule.injective_subtype P')
    have sq : ∀ t, αM (LinearMap.lTensor A (P'.subtype.restrictScalars B) t) =
        LinearMap.lTensor (A ⧸ Ideal.map (algebraMap B A) I) P'.subtype (αN t) := by
      intro t
      induction t using TensorProduct.induction_on with
      | zero => simp only [map_zero]
      | tmul a n =>
        rw [LinearMap.lTensor_tmul, hN, hM, LinearMap.lTensor_tmul]
        rfl
      | add x y hx hy =>
        rw [LinearMap.map_add, AddMonoidHom.map_add, hx, hy, AddMonoidHom.map_add, LinearMap.map_add]
    intro t₁ t₂ h
    apply hNinj
    apply hR
    rw [← sq, ← sq, h]

  have hcomp : P.subtype = (P'.subtype.restrictScalars B) ∘ₗ (e : P →ₗ[B] P') := LinearMap.ext fun _ => rfl
  rw [hcomp, LinearMap.lTensor_comp, LinearMap.coe_comp]
  refine hL.comp ?_
  rw [← LinearEquiv.coe_lTensor]
  exact (LinearEquiv.lTensor A e).injective

theorem wc_pfc_p_flat_of_embdim : ∀ (B : Type u) [CommRing B] [IsLocalRing B] [IsNoetherianRing B] (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A] (f : B →+* A), IsLocalHom f → IsRegularLocalRing A → Ideal.map f (IsLocalRing.maximalIdeal B) = IsLocalRing.maximalIdeal A → Submodule.spanFinrank (IsLocalRing.maximalIdeal B) = Submodule.spanFinrank (IsLocalRing.maximalIdeal A) → f.Flat :=
by
  intro B _ _ _ A _ _ _ f hf hreg hmap hrank
  letI : Algebra B A := f.toAlgebra
  haveI : IsLocalHom (algebraMap B A) := hf
  haveI := hreg

  have hFG : (IsLocalRing.maximalIdeal B).FG := IsNoetherian.noetherian _
  obtain ⟨x, hx⟩ : ∃ x : Fin (Submodule.spanFinrank (IsLocalRing.maximalIdeal B)) → B,
      Ideal.span (Set.range x) = IsLocalRing.maximalIdeal B := by
    obtain ⟨s, hs, hspan⟩ := Submodule.FG.exists_span_set_encard_eq_spanFinrank hFG
    have hfin : s.Finite := Set.finite_of_encard_eq_coe hs
    haveI : Finite s := hfin
    have hcard : Nat.card s = Submodule.spanFinrank (IsLocalRing.maximalIdeal B) := by
      rw [Nat.card_coe_set_eq]
      have h1 := hfin.cast_ncard_eq
      rw [hs] at h1
      exact_mod_cast h1
    let e : s ≃ Fin (Submodule.spanFinrank (IsLocalRing.maximalIdeal B)) :=
      Finite.equivFinOfCardEq hcard
    refine ⟨fun i => (e.symm i : B), ?_⟩
    have hr : Set.range (fun i => (e.symm i : B)) = s := by
      ext r
      constructor
      · rintro ⟨i, rfl⟩
        exact (e.symm i).2
      · intro hr
        exact ⟨e ⟨r, hr⟩, by simp⟩
    rw [hr]
    exact hspan

  let y : Fin (Submodule.spanFinrank (IsLocalRing.maximalIdeal B)) → A := fun i => f (x i)
  have hy : Ideal.span (Set.range y) = IsLocalRing.maximalIdeal A := by
    rw [← hmap]
    conv_rhs => rw [← hx]
    rw [Ideal.map_span, ← Set.range_comp]
    rfl
  have hH := wc_pfc_cz_pf_regular_any_order A wcpa_rs_quotient_regular
    (fun T _ h => wcpa_regular_isDomain T wcpa_rs_quotient_regular h) _ y hrank.symm hy

  have hQR := wc_pfe_quasi_regular wc_pfe_hom_poly_repr A _ y hH
  rw [hy] at hQR

  have hfree := wc_pfe_free_mod_pow wc_pfe_hom_poly_repr B A hf hmap _ x hx hQR

  have hinj : ∀ (n : ℕ) (P : Submodule B (B ⧸ IsLocalRing.maximalIdeal B ^ n)),
      Function.Injective (LinearMap.lTensor A P.subtype) := by
    intro n P
    haveI := hfree n
    exact wc_pfe_lTensor_inj_of_flat_quot B A (IsLocalRing.maximalIdeal B ^ n)
      Module.Flat.of_free P

  exact wc_pfe_flat_of_lTensor_quot_pow B A hf hinj

theorem wc_pfc_p_artinian_smooth_witness : ∀ (k : Type u) [Field k] (Λ : Type u) [CommRing Λ] [IsNoetherianRing Λ] [Algebra k Λ] (𝔮 : Ideal Λ) [𝔮.IsPrime] (n : ℕ), 1 ≤ n → ∀ (m : ℕ) (φ' : MvPolynomial (Fin m) k →ₐ[k] Λ), RingHom.Flat (Localization.localRingHom (𝔮.comap φ'.toRingHom) 𝔮 φ'.toRingHom rfl) → Ideal.map (Localization.localRingHom (𝔮.comap φ'.toRingHom) 𝔮 φ'.toRingHom rfl) (IsLocalRing.maximalIdeal (Localization.AtPrime (𝔮.comap φ'.toRingHom))) = IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) → ∀ (D : Subalgebra k (Localization.AtPrime 𝔮 ⧸ IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) ^ n)) [IsLocalRing D], IsArtinianRing D → IsLocalHom (algebraMap D (Localization.AtPrime 𝔮 ⧸ IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) ^ n)) → Module.Flat D (Localization.AtPrime 𝔮 ⧸ IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) ^ n) → Ideal.map (algebraMap D (Localization.AtPrime 𝔮 ⧸ IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) ^ n)) (IsLocalRing.maximalIdeal D) = Ideal.map (Ideal.Quotient.mk (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) ^ n)) (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮)) → (∀ i, Ideal.Quotient.mk (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) ^ n) (algebraMap Λ (Localization.AtPrime 𝔮) (φ' (MvPolynomial.X i))) ∈ D) → ∀ (F : IntermediateField k (IsLocalRing.ResidueField (Localization.AtPrime 𝔮))), F.FG → (∀ a : Localization.AtPrime 𝔮, Ideal.Quotient.mk (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) ^ n) a ∈ D → IsLocalRing.residue (Localization.AtPrime 𝔮) a ∈ F) → (∀ f ∈ F, ∃ a : Localization.AtPrime 𝔮, Ideal.Quotient.mk (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) ^ n) a ∈ D ∧ IsLocalRing.residue (Localization.AtPrime 𝔮) a = f) → ∀ (t : ℕ) (μ : Fin t → F), (∀ j, ∃ i, (μ j : IsLocalRing.ResidueField (Localization.AtPrime 𝔮)) = IsLocalRing.residue (Localization.AtPrime 𝔮) (algebraMap Λ (Localization.AtPrime 𝔮) (φ' (MvPolynomial.X i)))) → Submodule.span F (Set.range fun j => KaehlerDifferential.D k F (μ j)) = ⊤ → ∀ (E : Finset (Localization.AtPrime 𝔮 ⧸ IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) ^ n)), (∀ e ∈ E, e ∈ D) → ∃ (S : Type u) (_ : CommRing S) (iS : Algebra (Localization.AtPrime (𝔮.comap φ'.toRingHom) ⧸ IsLocalRing.maximalIdeal (Localization.AtPrime (𝔮.comap φ'.toRingHom)) ^ n) S) (_ : Algebra.Smooth (Localization.AtPrime (𝔮.comap φ'.toRingHom) ⧸ IsLocalRing.maximalIdeal (Localization.AtPrime (𝔮.comap φ'.toRingHom)) ^ n) S) (𝔪 : Ideal S) (_ : 𝔪.IsPrime) (v : Localization.AtPrime 𝔪 →+* Localization.AtPrime 𝔮 ⧸ IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) ^ n), RingHom.Flat v ∧ IsLocalHom v ∧ IsArtinianRing (Localization.AtPrime 𝔪) ∧ (∀ x : Localization.AtPrime (𝔮.comap φ'.toRingHom), v (algebraMap S (Localization.AtPrime 𝔪) (@algebraMap _ _ _ _ iS (Ideal.Quotient.mk (IsLocalRing.maximalIdeal (Localization.AtPrime (𝔮.comap φ'.toRingHom)) ^ n) x))) = Ideal.Quotient.mk (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) ^ n) (Localization.localRingHom (𝔮.comap φ'.toRingHom) 𝔮 φ'.toRingHom rfl x)) ∧ ∀ e ∈ E, e ∈ v.range :=
by
  classical



  have s1 : ∀ (R D T : Type u) [CommRing R] [CommRing D] [CommRing T] [IsLocalRing R]
      [IsLocalRing D] [IsLocalRing T] [Algebra R D] [Algebra D T] [Algebra R T]
      [IsScalarTower R D T] [Module.Flat R T] [Module.Flat D T] [IsLocalHom (algebraMap D T)],
      Ideal.map (algebraMap R T) (IsLocalRing.maximalIdeal R) =
        Ideal.map (algebraMap D T) (IsLocalRing.maximalIdeal D) →
      Module.Flat R D ∧ Ideal.map (algebraMap R D) (IsLocalRing.maximalIdeal R) =
        IsLocalRing.maximalIdeal D ∧ IsLocalHom (algebraMap R D) := by
    intro R D T _ _ _ _ _ _ _ _ _ _ _ _ _ h
    haveI hff : Module.FaithfullyFlat D T := Module.FaithfullyFlat.of_flat_of_isLocalHom
    have hJ : Ideal.map (algebraMap R D) (IsLocalRing.maximalIdeal R) =
        IsLocalRing.maximalIdeal D := by
      have e1 : Ideal.map (algebraMap D T)
          (Ideal.map (algebraMap R D) (IsLocalRing.maximalIdeal R)) =
          Ideal.map (algebraMap D T) (IsLocalRing.maximalIdeal D) := by
        rw [Ideal.map_map, ← IsScalarTower.algebraMap_eq, h]
      rw [← Ideal.comap_map_eq_self_of_faithfullyFlat (B := T)
        (Ideal.map (algebraMap R D) (IsLocalRing.maximalIdeal R)), e1,
        Ideal.comap_map_eq_self_of_faithfullyFlat]
    refine ⟨?_, hJ, ?_⟩
    · rw [Module.Flat.iff_lTensor_preserves_injective_linearMap]
      intro N N' _ _ _ _ f hf
      let φ : TensorProduct R D N →ₗ[D] TensorProduct R D N' := f.baseChange D
      have hφ : ∀ x, φ x = f.lTensor D x := fun x => by
        rw [← LinearMap.baseChange_eq_ltensor]
      let c := TensorProduct.AlgebraTensorModule.cancelBaseChange R D T T N
      let c' := TensorProduct.AlgebraTensorModule.cancelBaseChange R D T T N'
      have hcomm : ∀ x, c' (φ.lTensor T x) = f.lTensor T (c x) := by
        intro x
        induction x using TensorProduct.induction_on with
        | zero => simp
        | tmul t y =>
          induction y using TensorProduct.induction_on with
          | zero => simp
          | tmul d n =>
            simp [φ, c, c', LinearMap.lTensor_tmul, LinearMap.baseChange_tmul,
              TensorProduct.AlgebraTensorModule.cancelBaseChange_tmul]
          | add y z hy hz =>
            rw [TensorProduct.tmul_add, map_add, map_add, hy, hz, map_add, map_add]
        | add x y hx hy => rw [map_add, map_add, hx, hy, map_add, map_add]
      have hinjT : Function.Injective (f.lTensor T) :=
        Module.Flat.lTensor_preserves_injective_linearMap f hf
      have hinj : Function.Injective (φ.lTensor T) := by
        intro x y hxy
        have := congrArg c' hxy
        rw [hcomm, hcomm] at this
        exact c.injective (hinjT this)
      have hφinj : Function.Injective φ :=
        (Module.FaithfullyFlat.lTensor_injective_iff_injective D T φ).mp hinj
      intro x y hxy
      apply hφinj
      rw [hφ, hφ]
      exact hxy
    · refine ⟨fun r hr => ?_⟩
      by_contra hnu
      have h1 : r ∈ IsLocalRing.maximalIdeal R := (IsLocalRing.mem_maximalIdeal _).mpr hnu
      have h2 : algebraMap R D r ∈ IsLocalRing.maximalIdeal D := by
        rw [← hJ]; exact Ideal.mem_map_of_mem _ h1
      exact (IsLocalRing.mem_maximalIdeal _).mp h2 hr



  have s3 : ∀ (R D : Type u) [CommRing R] [CommRing D] [IsLocalRing R] [IsLocalRing D]
      [Algebra R D] [IsLocalHom (algebraMap R D)] [IsNoetherianRing R] [Module.Flat R D]
      [Module.Finite R D]
      [Algebra.FormallyUnramified (IsLocalRing.ResidueField R) (IsLocalRing.ResidueField D)]
      [Algebra.EssFiniteType (IsLocalRing.ResidueField R) (IsLocalRing.ResidueField D)],
      Ideal.map (algebraMap R D) (IsLocalRing.maximalIdeal R) = IsLocalRing.maximalIdeal D →
      Algebra.Etale R D := by
    intro R D _ _ _ _ _ _ _ _ _ _ _ hmax
    haveI : Algebra.FiniteType R D := Module.Finite.finiteType D
    haveI : Algebra.FinitePresentation R D :=
      Algebra.FinitePresentation.of_finiteType.mp inferInstance
    haveI : Algebra.EssFiniteType R D := Algebra.EssFiniteType.of_finiteType R D
    haveI := Algebra.FormallyUnramified.isSeparable (IsLocalRing.ResidueField R)
      (IsLocalRing.ResidueField D)
    haveI := Algebra.FormallyUnramified.of_map_maximalIdeal hmax
    exact Algebra.Etale.of_formallyUnramified_of_flat



  have s4 : ∀ (k : Type u) [Field k] (R : Type u) [CommRing R] [IsLocalRing R] [Algebra k R]
      (D : Type u) [CommRing D] [IsLocalRing D] [Algebra k D] [Algebra R D] [IsScalarTower k R D]
      [IsLocalHom (algebraMap R D)] (K : Type u) [Field K] [Algebra k K] (ρ : D →ₐ[k] K),
      (∀ d, ρ d = 0 ↔ d ∈ IsLocalRing.maximalIdeal D) → ∀ (F : IntermediateField k K), F.FG →
      (∀ d, ρ d ∈ F) → (∀ f ∈ F, ∃ d, ρ d = f) → ∀ (t : ℕ) (μ : Fin t → F),
      (∀ j, ∃ r : R, (μ j : K) = ρ (algebraMap R D r)) →
      Submodule.span F (Set.range fun j => KaehlerDifferential.D k F (μ j)) = ⊤ →
      Algebra.EssFiniteType (IsLocalRing.ResidueField R) (IsLocalRing.ResidueField D) ∧
      Algebra.FormallyUnramified (IsLocalRing.ResidueField R) (IsLocalRing.ResidueField D) := by
    intro k _ R _ _ _ D _ _ _ _ _ _ K _ _ ρ hρ0 F hFG hρF hFρ t μ hμ hspan
    let ρr : D →+* K := ρ.toRingHom
    haveI : IsLocalHom ρr := ⟨fun d hd => by
      by_contra hnu
      have h1 : d ∈ IsLocalRing.maximalIdeal D := (IsLocalRing.mem_maximalIdeal _).mpr hnu
      have h2 : ρ d = 0 := (hρ0 d).mpr h1
      have h3 : ρr d = 0 := h2
      rw [h3] at hd
      exact not_isUnit_zero hd⟩
    let L : IsLocalRing.ResidueField D →+* K := IsLocalRing.ResidueField.lift ρr
    have hL : ∀ d, L (IsLocalRing.residue D d) = ρ d := fun d =>
      IsLocalRing.ResidueField.lift_residue_apply ρr d
    have hLF : ∀ x, L x ∈ F := by
      intro x
      obtain ⟨d, rfl⟩ := IsLocalRing.residue_surjective x
      rw [hL]; exact hρF d
    let ψ : IsLocalRing.ResidueField D →+* F := L.codRestrict F hLF
    have hψ : ∀ x, (ψ x : K) = L x := fun x => rfl
    have hψbij : Function.Bijective ψ := by
      refine ⟨ψ.injective, fun f => ?_⟩
      obtain ⟨d, hd⟩ := hFρ f f.2
      refine ⟨IsLocalRing.residue D d, Subtype.ext ?_⟩
      rw [hψ, hL, hd]
    let e : IsLocalRing.ResidueField D ≃+* F := RingEquiv.ofBijective ψ hψbij
    have he : ∀ x, (e x : K) = L x := fun x => rfl
    have hek : ∀ c : k, e (algebraMap k (IsLocalRing.ResidueField D) c) = algebraMap k F c := by
      intro c
      apply Subtype.ext
      rw [he, IsScalarTower.algebraMap_apply k D (IsLocalRing.ResidueField D),
        IsLocalRing.ResidueField.algebraMap_eq, hL, AlgHom.commutes]
      rfl
    let eA : IsLocalRing.ResidueField D ≃ₐ[k] F := AlgEquiv.ofRingEquiv (f := e) hek
    haveI : Algebra.EssFiniteType k F := IntermediateField.essFiniteType_iff.mpr hFG
    haveI : Algebra.EssFiniteType k (IsLocalRing.ResidueField D) :=
      Algebra.EssFiniteType.of_surjective (eA.symm : F →ₐ[k] IsLocalRing.ResidueField D)
        eA.symm.surjective
    haveI : IsScalarTower k (IsLocalRing.ResidueField R) (IsLocalRing.ResidueField D) := by
      refine IsScalarTower.of_algebraMap_eq (fun c => ?_)
      rw [IsScalarTower.algebraMap_apply k R (IsLocalRing.ResidueField R),
        IsScalarTower.algebraMap_apply k D (IsLocalRing.ResidueField D),
        IsScalarTower.algebraMap_apply k R D, IsLocalRing.ResidueField.algebraMap_eq R,
        IsLocalRing.ResidueField.algebraMap_eq D, IsLocalRing.ResidueField.algebraMap_residue]
    have hess : Algebra.EssFiniteType (IsLocalRing.ResidueField R) (IsLocalRing.ResidueField D) :=
      Algebra.EssFiniteType.of_comp k _ _
    refine ⟨hess, ?_⟩
    letI : Algebra (IsLocalRing.ResidueField R) F :=
      ((e : IsLocalRing.ResidueField D →+* F).comp
        (algebraMap (IsLocalRing.ResidueField R) (IsLocalRing.ResidueField D))).toAlgebra
    have hRF : ∀ x, algebraMap (IsLocalRing.ResidueField R) F x =
        e (algebraMap (IsLocalRing.ResidueField R) (IsLocalRing.ResidueField D) x) := fun x => rfl
    haveI : IsScalarTower k (IsLocalRing.ResidueField R) F := by
      refine IsScalarTower.of_algebraMap_eq (fun c => ?_)
      rw [hRF, ← IsScalarTower.algebraMap_apply, hek]
    have hμR : ∀ j, ∃ x : IsLocalRing.ResidueField R, μ j = algebraMap _ F x := by
      intro j
      obtain ⟨r, hr⟩ := hμ j
      refine ⟨IsLocalRing.residue R r, Subtype.ext ?_⟩
      rw [hRF, he, IsLocalRing.ResidueField.algebraMap_residue, hL, hr]
    have hz : ∀ ω ∈ Submodule.span F (Set.range fun j => KaehlerDifferential.D k F (μ j)),
        KaehlerDifferential.map k (IsLocalRing.ResidueField R) F F ω = 0 := by
      intro ω hω
      induction hω using Submodule.span_induction with
      | mem x hx =>
        obtain ⟨j, rfl⟩ := hx
        obtain ⟨y, hy⟩ := hμR j
        rw [KaehlerDifferential.map_D, Algebra.algebraMap_self, RingHom.id_apply, hy,
          Derivation.map_algebraMap]
      | zero => exact map_zero _
      | add x z _ _ hx hz => rw [map_add, hx, hz, add_zero]
      | smul a x _ hx => rw [map_smul, hx, smul_zero]
    have hsub : Subsingleton (Ω[F⁄IsLocalRing.ResidueField R]) := by
      have hall : ∀ ω : Ω[F⁄IsLocalRing.ResidueField R], ω = 0 := by
        intro ω
        obtain ⟨ω', rfl⟩ := KaehlerDifferential.map_surjective k (IsLocalRing.ResidueField R) F ω
        exact hz ω' (by rw [hspan]; trivial)
      exact ⟨fun a b => by rw [hall a, hall b]⟩
    haveI : Algebra.FormallyUnramified (IsLocalRing.ResidueField R) F :=
      (Algebra.formallyUnramified_iff _ _).mpr hsub
    let eR : F ≃ₐ[IsLocalRing.ResidueField R] IsLocalRing.ResidueField D :=
      AlgEquiv.ofRingEquiv (f := e.symm) (fun x => by rw [hRF, RingEquiv.symm_apply_apply])
    exact Algebra.FormallyUnramified.of_equiv eR



  have s5 : ∀ (R : Type u) [CommRing R] [IsLocalRing R] (D : Type u) [CommRing D] [IsLocalRing D]
      [Algebra R D] [IsLocalHom (algebraMap R D)] (N : ℕ),
      IsLocalRing.maximalIdeal R ^ N = ⊥ →
      Ideal.map (algebraMap R D) (IsLocalRing.maximalIdeal R) = IsLocalRing.maximalIdeal D →
      Module.Finite (IsLocalRing.ResidueField R) (IsLocalRing.ResidueField D) →
      Module.Finite R D := by
    intro R _ _ D _ _ _ _ N hN hmax hfin
    obtain ⟨s, hs⟩ := hfin.fg_top
    choose lift hlift using fun y : IsLocalRing.ResidueField D => IsLocalRing.residue_surjective y
    let M : Submodule R D := Submodule.span R ((s.image lift : Finset D) : Set D)
    set I := IsLocalRing.maximalIdeal R with hI
    have key : ∀ y ∈ Submodule.span (IsLocalRing.ResidueField R)
