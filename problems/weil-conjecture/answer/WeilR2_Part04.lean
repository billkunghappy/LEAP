Sum.inl (π i) * MvPolynomial.X (Sum.inr i) : MvPolynomial (Fin m ⊕ Fin d) k) ^ c))) _ (Ideal.Quotient.mk _ x)) → ∀ (φbar : (A' ⧸ Ideal.map (algebraMap (MvPolynomial (Fin m ⊕ Fin d) k) A') (wcPfcPowIdeal (fun i => (MvPolynomial.rename Sum.inl (π i) * MvPolynomial.X (Sum.inr i) : MvPolynomial (Fin m ⊕ Fin d) k) ^ c))) →ₐ[MvPolynomial (Fin m ⊕ Fin d) k ⧸ wcPfcPowIdeal (fun i => (MvPolynomial.rename Sum.inl (π i) * MvPolynomial.X (Sum.inr i) : MvPolynomial (Fin m ⊕ Fin d) k) ^ c)] (Λ ⧸ Ideal.map (algebraMap (MvPolynomial (Fin m ⊕ Fin d) k) Λ) (wcPfcPowIdeal (fun i => (MvPolynomial.rename Sum.inl (π i) * MvPolynomial.X (Sum.inr i) : MvPolynomial (Fin m ⊕ Fin d) k) ^ c)))), (∀ x : A', φbar (Ideal.Quotient.mk _ x) = Ideal.Quotient.mk _ (χ₀ x)) → ∃ (C : Type u) (_ : CommRing C) (_ : Algebra (MvPolynomial (Fin m ⊕ Fin d) k ⧸ wcPfcPowIdeal (fun i => (MvPolynomial.rename Sum.inl (π i) * MvPolynomial.X (Sum.inr i) : MvPolynomial (Fin m ⊕ Fin d) k) ^ c)) C) (_ : Algebra.Smooth (MvPolynomial (Fin m ⊕ Fin d) k ⧸ wcPfcPowIdeal (fun i => (MvPolynomial.rename Sum.inl (π i) * MvPolynomial.X (Sum.inr i) : MvPolynomial (Fin m ⊕ Fin d) k) ^ c)) C) (ψ : (A' ⧸ Ideal.map (algebraMap (MvPolynomial (Fin m ⊕ Fin d) k) A') (wcPfcPowIdeal (fun i => (MvPolynomial.rename Sum.inl (π i) * MvPolynomial.X (Sum.inr i) : MvPolynomial (Fin m ⊕ Fin d) k) ^ c))) →ₐ[MvPolynomial (Fin m ⊕ Fin d) k ⧸ wcPfcPowIdeal (fun i => (MvPolynomial.rename Sum.inl (π i) * MvPolynomial.X (Sum.inr i) : MvPolynomial (Fin m ⊕ Fin d) k) ^ c)] C) (γ : C →ₐ[MvPolynomial (Fin m ⊕ Fin d) k ⧸ wcPfcPowIdeal (fun i => (MvPolynomial.rename Sum.inl (π i) * MvPolynomial.X (Sum.inr i) : MvPolynomial (Fin m ⊕ Fin d) k) ^ c)] Localization.AtPrime (𝔮.map (Ideal.Quotient.mk (Ideal.map (algebraMap (MvPolynomial (Fin m ⊕ Fin d) k) Λ) (wcPfcPowIdeal (fun i => (MvPolynomial.rename Sum.inl (π i) * MvPolynomial.X (Sum.inr i) : MvPolynomial (Fin m ⊕ Fin d) k) ^ c)))))), γ.comp ψ = (IsScalarTower.toAlgHom (MvPolynomial (Fin m ⊕ Fin d) k ⧸ wcPfcPowIdeal (fun i => (MvPolynomial.rename Sum.inl (π i) * MvPolynomial.X (Sum.inr i) : MvPolynomial (Fin m ⊕ Fin d) k) ^ c)) (Λ ⧸ Ideal.map (algebraMap (MvPolynomial (Fin m ⊕ Fin d) k) Λ) (wcPfcPowIdeal (fun i => (MvPolynomial.rename Sum.inl (π i) * MvPolynomial.X (Sum.inr i) : MvPolynomial (Fin m ⊕ Fin d) k) ^ c))) (Localization.AtPrime (𝔮.map (Ideal.Quotient.mk (Ideal.map (algebraMap (MvPolynomial (Fin m ⊕ Fin d) k) Λ) (wcPfcPowIdeal (fun i => (MvPolynomial.rename Sum.inl (π i) * MvPolynomial.X (Sum.inr i) : MvPolynomial (Fin m ⊕ Fin d) k) ^ c))))))).comp φbar :=
by
  intro k _ Λ _ _ 𝔮 _ m n d c φ' hflat hgen π δ hc hn hπ𝔭 hδ hπgen S _ iS _ 𝔪 _ v hv _ _ hRXl hRXr
    A' _ _ _ χ₀ χD hχk hχy hχt hcompat hqp ρ hρ φbar hφbar
  classical

  have hs11 : ∀ (P₀ : Type u) [CommRing P₀] (S : Type u) [CommRing S] [Algebra P₀ S] [Algebra.Smooth P₀ S] (d : ℕ) (s : MvPolynomial (Fin d) S) (T : Type u) [CommRing T] [Algebra (MvPolynomial (Fin d) S) T] [IsLocalization.Away s T] [Algebra (MvPolynomial (Fin d) P₀) T], (∀ p : MvPolynomial (Fin d) P₀, algebraMap (MvPolynomial (Fin d) P₀) T p = algebraMap (MvPolynomial (Fin d) S) T (MvPolynomial.map (algebraMap P₀ S) p)) → Algebra.Smooth (MvPolynomial (Fin d) P₀) T := by
    intro P₀ _ S _ _ _ d s T _ _ _ _ h
    letI : Algebra (MvPolynomial (Fin d) P₀) (MvPolynomial (Fin d) S) :=
      MvPolynomial.algebraMvPolynomial
    haveI : IsScalarTower (MvPolynomial (Fin d) P₀) (MvPolynomial (Fin d) S) T :=
      IsScalarTower.of_algebraMap_eq (fun p => by rw [h]; rfl)
    haveI : Algebra.Smooth (MvPolynomial (Fin d) S) T := Algebra.Smooth.of_isLocalization_Away s
    haveI : Algebra.IsPushout P₀ (MvPolynomial (Fin d) P₀) S (MvPolynomial (Fin d) S) :=
      Algebra.IsPushout.symm inferInstance
    haveI : Algebra.Smooth (MvPolynomial (Fin d) P₀) (MvPolynomial (Fin d) S) :=
      Algebra.Smooth.of_equiv (Algebra.IsPushout.equiv P₀ (MvPolynomial (Fin d) P₀) S
        (MvPolynomial (Fin d) S))
    exact Algebra.Smooth.comp (MvPolynomial (Fin d) P₀) (MvPolynomial (Fin d) S) T

  have hs13 : ∀ (R₀ : Type u) [CommRing R₀] (L₀ : Type u) [CommRing L₀] [Algebra R₀ L₀] (P' : Type u) [CommRing P'] (T₀ : Type u) [CommRing T₀] [Algebra P' T₀] [Algebra.Smooth P' T₀] (L : Type u) [CommRing L] [Algebra R₀ L] (κ : P' →+* L₀) (lam₀ : L₀ →+* L) (τ₀ : T₀ →+* L), (∀ r : R₀, lam₀ (algebraMap R₀ L₀ r) = algebraMap R₀ L r) → (∀ p : P', τ₀ (algebraMap P' T₀ p) = lam₀ (κ p)) → ∃ (T : Type u) (_ : CommRing T) (_ : Algebra L₀ T) (_ : Algebra R₀ T) (_ : IsScalarTower R₀ L₀ T) (_ : Algebra.Smooth L₀ T) (ι : T₀ →+* T) (τ : T →ₐ[R₀] L), (∀ p : P', ι (algebraMap P' T₀ p) = algebraMap L₀ T (κ p)) ∧ (∀ y : T₀, τ (ι y) = τ₀ y) ∧ (∀ z : L₀, τ (algebraMap L₀ T z) = lam₀ z) := by
    intro R₀ _ L₀ _ _ P' _ T₀ _ _ _ L _ _ κ lam₀ τ₀ h1 h2
    letI : Algebra P' L₀ := κ.toAlgebra
    letI : Algebra P' L := (lam₀.comp κ).toAlgebra
    let F₁ : L₀ →ₐ[P'] L := { lam₀ with commutes' := fun _ => rfl }
    let F₂ : T₀ →ₐ[P'] L := { τ₀ with commutes' := fun p => h2 p }
    let τ₁ := Algebra.TensorProduct.productMap F₁ F₂
    have hτ₁ : ∀ (a : L₀) (b : T₀), τ₁ (a ⊗ₜ[P'] b) = lam₀ a * τ₀ b :=
      fun a b => Algebra.TensorProduct.productMap_apply_tmul F₁ F₂ a b
    have hal : ∀ z : L₀, algebraMap L₀ (TensorProduct P' L₀ T₀) z = z ⊗ₜ[P'] (1 : T₀) := by
      intro z
      rw [Algebra.TensorProduct.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply]
    refine ⟨TensorProduct P' L₀ T₀, inferInstance, inferInstance, inferInstance, inferInstance,
      Algebra.Smooth.baseChange P' T₀ L₀, Algebra.TensorProduct.includeRight.toRingHom,
      { toRingHom := τ₁.toRingHom
        commutes' := fun r => by
          show τ₁ (algebraMap R₀ _ r) = _
          rw [Algebra.TensorProduct.algebraMap_apply, hτ₁, map_one, mul_one]
          exact h1 r }, ?_, ?_, ?_⟩
    · intro p
      show (1 : L₀) ⊗ₜ[P'] (algebraMap P' T₀ p) = _
      rw [hal, Algebra.algebraMap_eq_smul_one p, TensorProduct.tmul_smul,
        TensorProduct.smul_tmul', Algebra.smul_def, mul_one]
