              ((eq_whisker (hz tn) _).trans (hw j).symm)))))
    have h2 : (D₀.map (Over.mk (𝟙 m₀)).hom).left = 𝟙 _ := by
      show (D₀.map (𝟙 m₀)).left = _
      rw [D₀.map_id]
      rfl
    have hwc : ∀ j, w j ≫ (c (σ j)).left = y ≫ π₀ m₀ := by
      intro j
      have hin : ((Limits.WidePullback.π (fun j => (f' (σ j)).app (Over.mk (𝟙 m₀))) j).left ≫
          pr (σ j) (Over.mk (𝟙 m₀))) ≫ (c (σ j)).left =
          (Limits.WidePullback.base (fun j => (f' (σ j)).app (Over.mk (𝟙 m₀)))).left :=
        (Category.assoc _ _ _).trans ((whisker_eq _ ((hpb' (σ j) _).w.trans
          ((whisker_eq _ h2).trans (Category.comp_id _)))).trans (piL p σ _ j))
      exact (eq_whisker (hw j) _).trans ((Category.assoc _ _ _).trans
        ((whisker_eq _ hin).trans (hy' (Over.mk (𝟙 m₀))).symm))
    obtain ⟨z₀, ⟨hz₀b, hz₀π⟩, hz₀u⟩ := WPlift Z U (p + 1) (fun l => V (σ l)) (fun l => f (σ l)) T y
      (fun j => (hpb (σ j)).lift (w j) y (hwc j)) (fun j => (hpb (σ j)).lift_snd _ _ _)
    have hz₀π' : ∀ j, z₀ ≫ (Limits.WidePullback.π (fun l => f (σ l)) j).left =
        (hpb (σ j)).lift (w j) y (hwc j) := hz₀π
    have hz₀u' : ∀ h : T ⟶ (Limits.widePullback U (fun l => V (σ l)) (fun l => f (σ l))).left,
        (h ≫ (Limits.WidePullback.base (fun l => f (σ l))).left = y ∧
          ∀ j, h ≫ (Limits.WidePullback.π (fun l => f (σ l)) j).left =
            (hpb (σ j)).lift (w j) y (hwc j)) → h = z₀ := hz₀u
    refine ⟨z₀, fun n => ?_, fun z₁ hz₁ => ?_⟩
    · apply lvlExt p σ n
      · exact (Category.assoc _ _ _).trans ((whisker_eq z₀ (hπb p σ n)).trans
          ((Category.assoc _ _ _).symm.trans ((eq_whisker hz₀b _).trans (hy' n))))
      · intro j
        exact (Category.assoc _ _ _).trans ((whisker_eq z₀ (hπc p σ n j)).trans
          ((Category.assoc _ _ _).symm.trans ((eq_whisker (hz₀π' j) _).trans
            (((hpb (σ j)).lift_fst _ _ _).trans (hstar n j).symm))))
    · have hz₁' : ∀ n, z₁ ≫ π p σ n = z n := hz₁
      have e1 : z₁ ≫ (Limits.WidePullback.base (fun l => f (σ l))).left = y := by
        apply hyu'
        intro n
        exact (Category.assoc _ _ _).trans ((whisker_eq z₁ (hπb p σ n).symm).trans
          ((Category.assoc _ _ _).symm.trans (eq_whisker (hz₁' n) _)))
      have e2 : ∀ j, z₁ ≫ (Limits.WidePullback.π (fun l => f (σ l)) j).left =
          (hpb (σ j)).lift (w j) y (hwc j) := by
        intro j
        apply (hpb (σ j)).hom_ext
        · exact (Category.assoc _ _ _).trans ((whisker_eq z₁ (hπc p σ (Over.mk (𝟙 m₀)) j).symm).trans
            ((Category.assoc _ _ _).symm.trans ((eq_whisker (hz₁' (Over.mk (𝟙 m₀))) _).trans
              ((hw j).symm.trans ((hpb (σ j)).lift_fst _ _ _).symm))))
        · exact (Category.assoc _ _ _).trans ((whisker_eq z₁ (piW p σ j)).trans
            (e1.trans ((hpb (σ j)).lift_snd _ _ _).symm))
      exact hz₀u' z₁ ⟨e1, e2⟩
  ·
    intro p σ n
    obtain ⟨hq, -⟩ := baseQ S ((Over.forget m₀ ⋙ D₀).obj n) k (fun i => (V' i).obj n)
      (fun i => (f' i).app n) (fun i => (legL i n).1) (fun i => (legL i n).2) (p + 1) σ
    exact @QuasiCompact.compactSpace_of_compactSpace _ _
      (Limits.WidePullback.base (fun j => (f' (σ j)).app n)).left hq (hcpt n.left)
  ·
    intro p σ n
    obtain ⟨-, hq⟩ := baseQ S ((Over.forget m₀ ⋙ D₀).obj n) k (fun i => (V' i).obj n)
      (fun i => (f' i).app n) (fun i => (legL i n).1) (fun i => (legL i n).2) (p + 1) σ
    exact @quasiSeparatedSpace_of_quasiSeparated _ _
      (Limits.WidePullback.base (fun j => (f' (σ j)).app n)).left (hqs n.left) hq
  ·
    intro p σ n n' t
    have sq := WPsq S ((Over.forget m₀ ⋙ D₀).obj n) (p + 1) (fun j => (V' (σ j)).obj n)
      (fun j => (f' (σ j)).app n) ((Over.forget m₀ ⋙ D₀).obj n') (fun j => (V' (σ j)).obj n')
      (fun j => (f' (σ j)).app n') (D₀.map t.left).left (fun j => ((V' (σ j)).map t).left)
      (fun j => hcsq (σ j) t) ((wcLevelWP (Over.forget m₀ ⋙ D₀) V' f' σ).map t).left
      (T1 p σ t) (fun j => T2 p σ t j)
    exact MorphismProperty.of_isPullback (P := @IsAffineHom) sq.flip (haff t.left)
  ·
    intro p σ
    obtain ⟨hq, hs⟩ := baseQ Z U k V f (fun i => (legZ i).1) (fun i => (legZ i).2) (p + 1) σ
    exact ⟨@QuasiCompact.compactSpace_of_compactSpace _ _
        (Limits.WidePullback.base (fun l => f (σ l))).left hq hUc,
      @quasiSeparatedSpace_of_quasiSeparated _ _
        (Limits.WidePullback.base (fun l => f (σ l))).left hUq hs⟩
  ·
    intro p τ j n
    have fB : (wcCechFace V f τ j).left ≫
        (Limits.WidePullback.base (fun l => f (τ (j.succAbove l)))).left =
        (Limits.WidePullback.base (fun l => f (τ l))).left :=
      hL1 Z _ _ _ (Limits.WidePullback.lift_base _ _ _ _)
    have fP : ∀ l, (wcCechFace V f τ j).left ≫
        (Limits.WidePullback.π (fun l => f (τ (j.succAbove l))) l).left =
        (Limits.WidePullback.π (fun l => f (τ l)) (j.succAbove l)).left :=
      fun l => hL1 Z _ _ _ (Limits.WidePullback.lift_π _ _ _ _ _)
    have gB : (wcCechFace (fun i => (V' i).obj n) (fun i => (f' i).app n) τ j).left ≫
        (Limits.WidePullback.base (fun l => (f' (τ (j.succAbove l))).app n)).left =
        (Limits.WidePullback.base (fun l => (f' (τ l)).app n)).left :=
      hL1 S _ _ _ (Limits.WidePullback.lift_base _ _ _ _)
    have gP : ∀ l, (wcCechFace (fun i => (V' i).obj n) (fun i => (f' i).app n) τ j).left ≫
        (Limits.WidePullback.π (fun l => (f' (τ (j.succAbove l))).app n) l).left =
        (Limits.WidePullback.π (fun l => (f' (τ l)).app n) (j.succAbove l)).left :=
      fun l => hL1 S _ _ _ (Limits.WidePullback.lift_π _ _ _ _ _)
    apply lvlExt p (fun l => τ (j.succAbove l)) n
    · exact (Category.assoc _ _ _).trans ((whisker_eq _ (hπb p _ n)).trans
        ((Category.assoc _ _ _).symm.trans ((eq_whisker fB _).trans ((hπb (p + 1) τ n).symm.trans
          ((whisker_eq _ gB.symm).trans (Category.assoc _ _ _).symm)))))
    · intro l
      exact (Category.assoc _ _ _).trans ((whisker_eq _ (hπc p _ n l)).trans
        ((Category.assoc _ _ _).symm.trans ((eq_whisker (fP l) _).trans
          ((hπc (p + 1) τ n (j.succAbove l)).symm.trans
            ((whisker_eq _ (eq_whisker (gP l) _).symm).trans
              ((whisker_eq _ (Category.assoc _ _ _)).trans (Category.assoc _ _ _).symm))))))

theorem wc_cechAcyclic_of_level_colimit : ∀ {C C' : Type (u+1)} [Category.{u} C] [Category.{u} C'] [Limits.HasFiniteWidePullbacks C] [Limits.HasFiniteWidePullbacks C'] (G : Cᵒᵖ ⥤ AddCommGrpCat.{u+1}) (H : C'ᵒᵖ ⥤ AddCommGrpCat.{u+1}) (U : C') (k : ℕ) (V : Fin k → C') (f : ∀ i, V i ⟶ U) (M : Type u) [SmallCategory M] [IsCofiltered M] (U' : M ⥤ C) (V' : Fin k → M ⥤ C) (f' : ∀ i, V' i ⟶ U') (ρ : ∀ (p : ℕ) (σ : Fin (p + 1) → Fin k) (n : M), G.obj (Opposite.op ((wcLevelWP U' V' f' σ).obj n)) →+ H.obj (Opposite.op (Limits.widePullback U (fun l => V (σ l)) (fun l => f (σ l))))), (∀ (p : ℕ) (σ : Fin (p + 1) → Fin k) {n n' : M} (t : n ⟶ n') (x : G.obj (Opposite.op ((wcLevelWP U' V' f' σ).obj n'))), ρ p σ n (G.map ((wcLevelWP U' V' f' σ).map t).op x) = ρ p σ n' x) → (∀ (p : ℕ) (τ : Fin (p + 2) → Fin k) (j : Fin (p + 2)) (n : M) (x : G.obj (Opposite.op ((wcLevelWP U' V' f' (fun l => τ (j.succAbove l))).obj n))), H.map (wcCechFace V f τ j).op (ρ p (fun l => τ (j.succAbove l)) n x) = ρ (p + 1) τ n (G.map (wcCechFace (fun i => (V' i).obj n) (fun i => (f' i).app n) τ j).op x)) → (∀ (p : ℕ) (σ : Fin (p + 1) → Fin k) (s : H.obj (Opposite.op (Limits.widePullback U (fun l => V (σ l)) (fun l => f (σ l))))), ∃ (n : M) (x : G.obj (Opposite.op ((wcLevelWP U' V' f' σ).obj n))), ρ p σ n x = s) → (∀ (p : ℕ) (σ : Fin (p + 1) → Fin k) (n : M) (x : G.obj (Opposite.op ((wcLevelWP U' V' f' σ).obj n))), ρ p σ n x = 0 → ∃ (n' : M) (t : n' ⟶ n), G.map ((wcLevelWP U' V' f' σ).map t).op x = 0) → (∀ n : M, wcCechAcyclic G (fun i => (V' i).obj n) (fun i => (f' i).app n)) → wcCechAcyclic H V f :=
by
  intro C C' _ _ _ _ G H U k V f M _ _ U' V' f' ρ hT hF hS hI hA

  have hcomp : ∀ {X Y Z : C} (a : X ⟶ Y) (b : Y ⟶ Z) (z : G.obj (Opposite.op Z)),
      G.map (a ≫ b).op z = G.map a.op (G.map b.op z) := by
    intro X Y Z a b z
    rw [op_comp, Functor.map_comp]
    all_goals rfl

  have hLπ : ∀ {q : ℕ} (σ : Fin (q + 1) → Fin k) {n n' : M} (t : n' ⟶ n) (l : Fin (q + 1)),
      (wcLevelWP U' V' f' σ).map t ≫ Limits.WidePullback.π (fun j => (f' (σ j)).app n) l =
      Limits.WidePullback.π (fun j => (f' (σ j)).app n') l ≫ (V' (σ l)).map t :=
    by intro q σ n n' t l; erw [Limits.WidePullback.lift_π]
  have hLb : ∀ {q : ℕ} (σ : Fin (q + 1) → Fin k) {n n' : M} (t : n' ⟶ n),
      (wcLevelWP U' V' f' σ).map t ≫ Limits.WidePullback.base (fun j => (f' (σ j)).app n) =
      Limits.WidePullback.base (fun j => (f' (σ j)).app n') ≫ U'.map t :=
    by intro q σ n n' t; erw [Limits.WidePullback.lift_base]

  have efπ : ∀ {q : ℕ} (τ : Fin (q + 2) → Fin k) (j : Fin (q + 2)) (n : M) (l : Fin (q + 1)),
      wcCechFace (fun i => (V' i).obj n) (fun i => (f' i).app n) τ j ≫
        Limits.WidePullback.π (fun a => (f' (τ (j.succAbove a))).app n) l =
      Limits.WidePullback.π (fun a => (f' (τ a)).app n) (j.succAbove l) := by
    intro q τ j n l
    simp only [wcCechFace, Limits.WidePullback.lift_π]
  have efb : ∀ {q : ℕ} (τ : Fin (q + 2) → Fin k) (j : Fin (q + 2)) (n : M),
      wcCechFace (fun i => (V' i).obj n) (fun i => (f' i).app n) τ j ≫
        Limits.WidePullback.base (fun a => (f' (τ (j.succAbove a))).app n) =
      Limits.WidePullback.base (fun a => (f' (τ a)).app n) := by
    intro q τ j n
    simp only [wcCechFace, Limits.WidePullback.lift_base]

  have hstar : ∀ {q : ℕ} (τ : Fin (q + 2) → Fin k) (j : Fin (q + 2)) {n n' : M} (t : n' ⟶ n),
      wcCechFace (fun i => (V' i).obj n') (fun i => (f' i).app n') τ j ≫
        (wcLevelWP U' V' f' (fun l => τ (j.succAbove l))).map t =
      (wcLevelWP U' V' f' τ).map t ≫
        wcCechFace (fun i => (V' i).obj n) (fun i => (f' i).app n) τ j := by
    intro q τ j n n' t
    apply Limits.WidePullback.hom_ext
    · intro l
      erw [Category.assoc, Category.assoc, hLπ, efπ, ← Category.assoc, efπ, hLπ]
    · erw [Category.assoc, Category.assoc, hLb, efb, ← Category.assoc, efb, hLb]
  unfold wcCechAcyclic
  intro p c hc

  choose n1 x1 hx1 using fun τ : Fin (p + 2) → Fin k => hS (p + 1) τ (c τ)
  obtain ⟨K⟩ := IsCofiltered.cone_nonempty (Discrete.functor n1)
  let n₀ : M := K.pt
  let g₀ : ∀ τ, n₀ ⟶ n1 τ := fun τ => K.π.app ⟨τ⟩
  obtain ⟨x, hxdef⟩ : ∃ x : ∀ τ : Fin (p + 2) → Fin k,
      G.obj (Opposite.op ((wcLevelWP U' V' f' τ).obj n₀)),
      ∀ τ, x τ = G.map ((wcLevelWP U' V' f' τ).map (g₀ τ)).op (x1 τ) := ⟨_, fun _ => rfl⟩
  have hx : ∀ τ, ρ (p + 1) τ n₀ (x τ) = c τ := by
    intro τ
    rw [hxdef, hT, hx1]

  obtain ⟨y, hydef⟩ : ∃ y : ∀ ρ' : Fin (p + 3) → Fin k,
      G.obj (Opposite.op ((wcLevelWP U' V' f' ρ').obj n₀)),
      ∀ ρ', y ρ' = ∑ j : Fin (p + 3), ((-1 : ℤ) ^ (j : ℕ)) •
        G.map (wcCechFace (fun i => (V' i).obj n₀) (fun i => (f' i).app n₀) ρ' j).op
          (x (fun l => ρ' (j.succAbove l))) := ⟨_, fun _ => rfl⟩
  have hy : ∀ ρ', ρ (p + 2) ρ' n₀ (y ρ') = 0 := by
    intro ρ'
    rw [hydef]
    refine (map_sum _ _ _).trans ((Finset.sum_congr rfl (fun j _ => ?_)).trans (hc ρ'))
    refine (map_zsmul _ _ _).trans (congrArg (fun z => ((-1 : ℤ) ^ (j : ℕ)) • z) ?_)
    exact (hF (p + 1) ρ' j n₀ _).symm.trans
      (congrArg (fun z => H.map (wcCechFace V f ρ' j).op z) (hx _))

  choose n2 s2 hs2 using fun ρ' : Fin (p + 3) → Fin k => hI (p + 2) ρ' n₀ (y ρ') (hy ρ')
  classical
  obtain ⟨K2⟩ := IsCofiltered.cone_nonempty (Limits.WidePullbackShape.wideCospan n₀ n2 s2)
  let ls : M := K2.pt
  let g : ls ⟶ n₀ := K2.π.app none
  let cc : ∀ ρ', ls ⟶ n2 ρ' := fun ρ' => K2.π.app (some ρ')
  have hcc : ∀ ρ', cc ρ' ≫ s2 ρ' = g := fun ρ' =>
    K2.w (Limits.WidePullbackShape.Hom.term ρ')
  have hkill : ∀ ρ', G.map ((wcLevelWP U' V' f' ρ').map g).op (y ρ') = 0 := by
    intro ρ'
    rw [← hcc ρ', Functor.map_comp, hcomp, hs2, map_zero]

  obtain ⟨x', hx'def⟩ : ∃ x' : ∀ τ : Fin (p + 2) → Fin k,
      G.obj (Opposite.op ((wcLevelWP U' V' f' τ).obj ls)),
      ∀ τ, x' τ = G.map ((wcLevelWP U' V' f' τ).map g).op (x τ) := ⟨_, fun _ => rfl⟩
  have hx'c : ∀ ρ' : Fin (p + 3) → Fin k, ∑ j : Fin (p + 3), ((-1 : ℤ) ^ (j : ℕ)) •
      G.map (wcCechFace (fun i => (V' i).obj ls) (fun i => (f' i).app ls) ρ' j).op
        (x' (fun l => ρ' (j.succAbove l))) = 0 := by
    intro ρ'
    refine Eq.trans ?_ (hkill ρ')
    rw [hydef]
    refine Eq.trans (Finset.sum_congr rfl (fun j _ => ?_)) (map_sum _ _ _).symm
    refine Eq.trans (congrArg (fun z => ((-1 : ℤ) ^ (j : ℕ)) • z) ?_) (map_zsmul _ _ _).symm
    exact (congrArg (fun z => G.map
        (wcCechFace (fun i => (V' i).obj ls) (fun i => (f' i).app ls) ρ' j).op z) (hx'def _)).trans
      ((hcomp _ _ _).symm.trans
        ((congrArg (fun m => G.map m.op (x (fun l => ρ' (j.succAbove l)))) (hstar ρ' j g)).trans
          (hcomp _ _ _)))

  obtain ⟨b, hb⟩ := hA ls p x' hx'c

  refine ⟨fun σ => ρ p σ ls (b σ), fun τ => ?_⟩
  beta_reduce
  rw [← hx τ, ← hT (p + 1) τ g (x τ), ← hx'def τ, ← hb τ]
  refine Eq.trans (Finset.sum_congr rfl (fun j _ => ?_)) (map_sum _ _ _).symm
  refine Eq.trans (congrArg (fun z => ((-1 : ℤ) ^ (j : ℕ)) • z) ?_) (map_zsmul _ _ _).symm
  exact hF p τ j ls _

theorem wc_et_pullback_injective_limit_acyclic : ∀ {S Z : Scheme.{u}} (g : Z ⟶ S) (L : Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1} ⥤ Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}), Nonempty (L ⊣ wcEtPush g) → ∀ (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (D : Λ ⥤ S.Etale) (π : ∀ l, Z ⟶ (D.obj l).left), (∀ l, π l ≫ (D.obj l).hom = g) → (∀ {l l' : Λ} (t : l ⟶ l'), π l ≫ (D.map t).left = π l') → (∀ (T : Scheme.{u}) (z : ∀ l, T ⟶ (D.obj l).left), (∀ {l l' : Λ} (t : l ⟶ l'), z l ≫ (D.map t).left = z l') → ∃! z₀ : T ⟶ Z, ∀ l, z₀ ≫ π l = z l) → (∀ l, CompactSpace (D.obj l).left) → (∀ l, QuasiSeparatedSpace (D.obj l).left) → (∀ {l l' : Λ} (t : l ⟶ l'), IsAffineHom (D.map t).left) → CompactSpace Z → QuasiSeparatedSpace Z → Z.IsSeparated → ∀ (J : Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}) [Injective J] (q : ℕ), Subsingleton (wcEtExt Z (L.obj J) (q + 1)) :=
by
  intro S Z g L hadj Λ _ _ D π hπ hπc hlim hcpt hqs haff hZc hZq _hZs J _ q
  haveI := wc_et_enough_injectives Z
  obtain ⟨ρ, -, hV, hU, hlimρ⟩ := wc_et_pullback_sections_colimit g L hadj

  have hρα : ∀ (G : Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}) (U : Z.Etale)
      (V : S.Etale) (α β : U.left ⟶ V.left) (hα : α ≫ V.hom = U.hom ≫ g)
      (hβ : β ≫ V.hom = U.hom ≫ g) (x : G.obj.obj (Opposite.op V)),
      α = β → ρ G U V α hα x = ρ G U V β hβ x := by
    intro G U V α β hα hβ x e
    subst e
    rfl
  have hleg : ∀ (U U' : Z.Etale) (u : U' ⟶ U) (V : S.Etale) (α : U.left ⟶ V.left),
      α ≫ V.hom = U.hom ≫ g → (u.left ≫ α) ≫ V.hom = U'.hom ≫ g := by
    intro U U' u V α h
    rw [Category.assoc, h, ← Category.assoc, MorphismProperty.Over.w u]
  have hleg' : ∀ (U : Z.Etale) (V V' : S.Etale) (w : V ⟶ V') (α : U.left ⟶ V.left),
      α ≫ V.hom = U.hom ≫ g → (α ≫ w.left) ≫ V'.hom = U.hom ≫ g := by
    intro U V V' w α h
    rw [Category.assoc, MorphismProperty.Over.w w, h]
  have hT : Limits.IsTerminal (wcEtTop Z) :=
    @MorphismProperty.Over.mkIdTerminal _ _ @Etale Z
      MorphismProperty.IsMultiplicative.toContainsIdentities
  exact wc_et_cartan_criterion_const Z
      (fun U => CompactSpace U.left ∧ QuasiSeparatedSpace U.left ∧
        ∃ (M₀ : Type u) (_ : SmallCategory M₀) (_ : IsCofiltered M₀) (D₀ : M₀ ⥤ S.Etale)
          (π₀ : ∀ l, U.left ⟶ (D₀.obj l).left),
          (∀ l, π₀ l ≫ (D₀.obj l).hom = U.hom ≫ g) ∧
          (∀ {l l' : M₀} (t : l ⟶ l'), π₀ l ≫ (D₀.map t).left = π₀ l') ∧
          (∀ (T : Scheme.{u}) (z : ∀ l, T ⟶ (D₀.obj l).left),
            (∀ {l l' : M₀} (t : l ⟶ l'), z l ≫ (D₀.map t).left = z l') →
            ∃! z₀ : T ⟶ U.left, ∀ l, z₀ ≫ π₀ l = z l) ∧
          (∀ l, CompactSpace (D₀.obj l).left) ∧ (∀ l, QuasiSeparatedSpace (D₀.obj l).left) ∧
          (∀ {l l' : M₀} (t : l ⟶ l'), IsAffineHom (D₀.map t).left))
      (fun U k V f => CompactSpace U.left ∧ QuasiSeparatedSpace U.left ∧
        ∃ (M₀ : Type u) (_ : SmallCategory M₀) (_ : IsCofiltered M₀) (D₀ : M₀ ⥤ S.Etale)
          (π₀ : ∀ l, U.left ⟶ (D₀.obj l).left),
          (∀ l, π₀ l ≫ (D₀.obj l).hom = U.hom ≫ g) ∧
