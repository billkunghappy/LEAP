    refine ⟨_, ?_, hsm⟩
    rw [map_mul]
    intro h
    rcases hQ.mem_or_mem h with h | h
    · exact hpQ h
    · exact hIQ h

  have hAwayMul : ∀ (R : Type u) [CommRing R] (D : Type u) [CommRing D] [Algebra R D] [Algebra.FinitePresentation R D] (P : Type u) [CommRing P] [Algebra R P] [Algebra D P] [IsScalarTower R D P] (t : P) (δ : D), Algebra.Smooth D (Localization.Away t) → Algebra.Smooth R (Localization.Away δ) → Algebra.Smooth R (Localization.Away (t * algebraMap D P δ)) := by
    intro R _ D _ _ _ P _ _ _ _ t δ ht hδ
    let W := Localization.Away t
    let x : W := algebraMap P W (algebraMap D P δ)
    let W' := Localization.Away x
    let Dδ := Localization.Away δ
    have hsWW' : Algebra.Smooth W W' := Algebra.Smooth.of_isLocalization_Away x
    have hsDW' : Algebra.Smooth D W' := Algebra.Smooth.comp D W W'
    have hDW' : ∀ y : D, algebraMap D W' y = algebraMap W W' (algebraMap P W (algebraMap D P y)) := by
      intro y
      rw [IsScalarTower.algebraMap_apply D W W', IsScalarTower.algebraMap_apply D P W]
    have hRW' : ∀ r : R, algebraMap R W' r = algebraMap D W' (algebraMap R D r) := by
      intro r
      rw [hDW', IsScalarTower.algebraMap_apply R W W', IsScalarTower.algebraMap_apply R P W,
        IsScalarTower.algebraMap_apply R D P]
    have hunit : ∀ y : Submonoid.powers δ, IsUnit (algebraMap D W' y) := by
      rintro ⟨_, k, rfl⟩
      simp only [map_pow]
      apply IsUnit.pow
      rw [hDW']
      exact IsLocalization.Away.algebraMap_isUnit x
    let lift : Dδ →+* W' := IsLocalization.lift (M := Submonoid.powers δ) (S := Dδ) hunit
    letI alg : Algebra Dδ W' := lift.toAlgebra
    have hlift : ∀ y : D, algebraMap Dδ W' (algebraMap D Dδ y) = algebraMap D W' y := fun y =>
      IsLocalization.lift_eq hunit y
    haveI tD : IsScalarTower D Dδ W' := IsScalarTower.of_algebraMap_eq (fun y => (hlift y).symm)
    haveI tR : IsScalarTower R Dδ W' := IsScalarTower.of_algebraMap_eq (fun r => by
      rw [IsScalarTower.algebraMap_apply R D Dδ, hlift, hRW'])
    haveI : Algebra.FormallySmooth D W' := hsDW'.formallySmooth
    have hfs : Algebra.FormallySmooth Dδ W' :=
      Algebra.FormallySmooth.localization_base (Submonoid.powers δ) (R := D) (Rₘ := Dδ) (Sₘ := W')
    haveI : Algebra.FinitePresentation D W' := hsDW'.finitePresentation
    haveI : Algebra.FinitePresentation D Dδ := IsLocalization.Away.finitePresentation δ
    have hfp : Algebra.FinitePresentation Dδ W' :=
      Algebra.FinitePresentation.of_restrict_scalars_finitePresentation D Dδ W'
    haveI hsm : Algebra.Smooth Dδ W' := Algebra.Smooth.mk hfs hfp
    haveI : Algebra.Smooth R W' := Algebra.Smooth.comp R Dδ W'
    haveI : IsLocalization.Away (t * algebraMap D P δ) W' :=
      IsLocalization.Away.mul' W W' t (algebraMap D P δ)
    let e : Localization.Away (t * algebraMap D P δ) ≃ₐ[P] W' :=
      IsLocalization.algEquiv (Submonoid.powers (t * algebraMap D P δ)) _ W'
    exact Algebra.Smooth.of_equiv (e.restrictScalars R).symm

  have hNak : ∀ (D : Type u) [CommRing D] (π : D) (n c m : ℕ) (K : Fin c → MvPolynomial (Fin n) D) (G : Fin m → MvPolynomial (Fin n) D) (J : MvPolynomial (Fin n) D), (∀ x : Localization.Away (Ideal.Quotient.mk (Ideal.span (Set.range K)) J), algebraMap D (Localization.Away (Ideal.Quotient.mk (Ideal.span (Set.range K)) J)) π ^ 2 * x = 0 → algebraMap D (Localization.Away (Ideal.Quotient.mk (Ideal.span (Set.range K)) J)) π * x = 0) → (∀ j, G j ∈ Ideal.span {MvPolynomial.C π ^ 2} + Ideal.span (Set.range K)) → (∀ j, MvPolynomial.C π * G j ∈ Ideal.span (Set.range K) + Ideal.span (Set.range G) ^ 2) → ∃ (ρ : MvPolynomial (Fin n) D) (N : ℕ), ρ - J ^ N ∈ Ideal.span {MvPolynomial.C π} + Ideal.span (Set.range K) ∧ ∀ j, ρ * G j ∈ Ideal.span (Set.range K) := by
    intro R _ π n c m K G J hann hG3 hG4
    have s1 : ∀ (W : Type u) [CommRing W] (p : W) (m : ℕ) (g : Fin m → W),
        (∀ x : W, p ^ 2 * x = 0 → p * x = 0) → (∀ j, g j ∈ Ideal.span {p ^ 2}) →
        (∀ j, p * g j ∈ Ideal.span (Set.range g) ^ 2) →
        ∃ r : W, r - 1 ∈ Ideal.span {p} ∧ ∀ j, r * g j = 0 := by
      intro W _ p m g hp hg2 hpg
      have ha : Ideal.span (Set.range g) ≤ Ideal.span {p ^ 2} := by
        rw [Ideal.span_le]
        rintro _ ⟨j, rfl⟩
        exact hg2 j
      have hb : Ideal.span (Set.range g) ^ 2 ≤ Ideal.span {p ^ 2} * Ideal.span (Set.range g) := by
        rw [pow_two]; exact Ideal.mul_mono_left ha
      have hle : Ideal.span (Set.range g) ≤ Ideal.span {p} • Ideal.span (Set.range g) := by
        rw [Ideal.span_le]
        rintro _ ⟨j, rfl⟩
        obtain ⟨z, hz, hz'⟩ := (Ideal.mem_span_singleton_mul).mp (hb (hpg j))
        obtain ⟨h, hh⟩ := Ideal.mem_span_singleton'.mp (hg2 j)
        have h0 : p ^ 2 * (p * h - z) = 0 := by linear_combination p * hh - hz'
        have h1 := hp _ h0
        have hgz : g j = p * z := by linear_combination -hh + h1
        rw [SetLike.mem_coe, Ideal.smul_eq_mul, hgz]
        exact Ideal.mem_span_singleton_mul.mpr ⟨z, hz, rfl⟩
      obtain ⟨r, hr1, hr⟩ := Submodule.exists_sub_one_mem_and_smul_eq_zero_of_fg_of_le_smul
        (Ideal.span {p}) (Ideal.span (Set.range g)) (Submodule.fg_span (Set.finite_range g)) hle
      refine ⟨r, hr1, fun j => ?_⟩
      have := hr (g j) (Ideal.subset_span ⟨j, rfl⟩)
      rwa [smul_eq_mul] at this
    simp only [Submodule.add_eq_sup] at hG3 hG4 ⊢
    set I : Ideal (MvPolynomial (Fin n) R) := Ideal.span (Set.range K) with hI
    set W := Localization.Away (Ideal.Quotient.mk I J) with hW
    set ι := algebraMap (MvPolynomial (Fin n) R ⧸ I) W with hι
    set p := algebraMap R W π with hp
    have hφC : ι (Ideal.Quotient.mk I (MvPolynomial.C π)) = p := by
      rw [hι, hp, ← MvPolynomial.algebraMap_eq, Ideal.Quotient.mk_algebraMap,
        ← IsScalarTower.algebraMap_apply]
    have hφK : ∀ e ∈ I, ι (Ideal.Quotient.mk I e) = 0 := by
      intro e he
      rw [Ideal.Quotient.eq_zero_iff_mem.mpr he, map_zero]
    have L : ∀ e : MvPolynomial (Fin n) R, ι (Ideal.Quotient.mk I e) = 0 →
        ∃ t : ℕ, J ^ t * e ∈ I := by
      intro e he
      obtain ⟨⟨_, t, rfl⟩, ht⟩ :=
        (IsLocalization.map_eq_zero_iff (Submonoid.powers (Ideal.Quotient.mk I J)) W _).mp he
      refine ⟨t, ?_⟩
      rw [← Ideal.Quotient.eq_zero_iff_mem, map_mul, map_pow]
      exact ht
    have hg2 : ∀ j, ι (Ideal.Quotient.mk I (G j)) ∈ Ideal.span {p ^ 2} := by
      intro j
      obtain ⟨a, ha, b, hb, hab⟩ := Submodule.mem_sup.mp (hG3 j)
      obtain ⟨t, rfl⟩ := Ideal.mem_span_singleton'.mp ha
      refine Ideal.mem_span_singleton'.mpr ⟨ι (Ideal.Quotient.mk I t), ?_⟩
