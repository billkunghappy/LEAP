      have h2 := Ideal.mem_map_of_mem
        (MvPolynomial.aeval Z : MvPolynomial (Fin n) R →ₐ[R] MvPolynomial (Fin (n + c)) D) (hstd2 j hj)
      rw [Ideal.add_eq_sup, Ideal.map_sup, Ideal.map_pow, Ideal.map_span, Ideal.map_span, map_mul, hΦC] at h2
      rw [hrange, himg, Ideal.add_eq_sup]
      exact h2

  have hAwayPi : ∀ (D : Type u) [CommRing D] (p : D) (n m c : ℕ) (hcm : c ≤ m) (K : Fin c → MvPolynomial (Fin (n + c)) D) (F : Fin m → MvPolynomial (Fin (n + c)) D) (b : (Fin c ↪ Fin n) → MvPolynomial (Fin (n + c)) D) (e : ℕ), (∀ l, F (Fin.castLE hcm l) = MvPolynomial.C p ^ 3 * K l) → MvPolynomial.C p ^ e - ∑ I, b I * (Matrix.of fun k l : Fin c => MvPolynomial.pderiv (Fin.castAdd c (I k)) (K l)).det ∈ Ideal.span (Set.range (Fin.append K F)) → (∀ j : Fin m, c ≤ j.val → MvPolynomial.C p * F j ∈ Ideal.span (F '' {j' | j'.val < c}) + Ideal.span (Set.range F) ^ 2) → ∀ Q : Ideal (MvPolynomial (Fin (n + c)) D ⧸ Ideal.span (Set.range (Fin.append K F))), Q.IsPrime → Ideal.Quotient.mk (Ideal.span (Set.range (Fin.append K F))) (MvPolynomial.C p) ∉ Q → ∃ t, t ∉ Q ∧ Algebra.Smooth D (Localization.Away t) := by
    intro D _ p n m c hcm K F b e hFK hSTD1 hSTD2 Q hQ hpQ
    have hI : ∃ I : Fin c ↪ Fin n, Ideal.Quotient.mk (Ideal.span (Set.range (Fin.append K F)))
        (Matrix.of fun k l : Fin c => MvPolynomial.pderiv (Fin.castAdd c (I k)) (K l)).det ∉ Q := by
      by_contra hall
      push_neg at hall
      apply hpQ
      apply hQ.mem_of_pow_mem e
      have h1 := (Ideal.Quotient.eq_zero_iff_mem (I := Ideal.span (Set.range (Fin.append K F)))).mpr hSTD1
      rw [map_sub, sub_eq_zero, map_sum] at h1
      rw [← map_pow, h1]
      exact Ideal.sum_mem _ (fun I _ => by rw [map_mul]; exact Ideal.mul_mem_left _ _ (hall I))
    obtain ⟨I, hIQ⟩ := hI
    have s1 : ∀ (R : Type u) [CommRing R] (n c : ℕ) (F : Fin c → MvPolynomial (Fin n) R) (ι : Fin c → Fin n), Function.Injective ι → Algebra.Smooth R (Localization.Away (Ideal.Quotient.mk (Ideal.span (Set.range F)) (Matrix.of fun k l : Fin c => MvPolynomial.pderiv (ι k) (F l)).det)) := by
      intro R _ n c F ι hι
      exact wc_pfc_jacobian_localization_smooth R n c F ι hι _ (IsLocalization.Away.algebraMap_isUnit _)
    have hcastK : ∀ l : Fin c, Fin.append K F (Fin.castLE (Nat.le_add_right c m) l) = K l := by
      intro l
      rw [show Fin.castLE (Nat.le_add_right c m) l = Fin.castAdd m l from Fin.ext rfl, Fin.append_left]
    have hFle : Ideal.span (Set.range F) ≤ Ideal.span (Set.range (Fin.append K F)) := by
      apply Ideal.span_mono
      rintro _ ⟨j, rfl⟩
      exact ⟨Fin.natAdd c j, Fin.append_right K F j⟩
    have hKle : Ideal.span (Set.range K) ≤ Ideal.span (Fin.append K F '' {j' | j'.val < c}) := by
      apply Ideal.span_mono
      rintro _ ⟨l, rfl⟩
      refine ⟨Fin.castAdd m l, ?_, Fin.append_left K F l⟩
      show (Fin.castAdd m l).val < c
      simp
    have hlt : ∀ j : Fin m, j.val < c → ∃ l : Fin c, F j = MvPolynomial.C p ^ 3 * K l := by
      intro j hj
      refine ⟨⟨j.val, hj⟩, ?_⟩
      rw [← hFK]
      congr 1
    have hFltK : Ideal.span (F '' {j' | j'.val < c}) ≤ Ideal.span (Set.range K) := by
      rw [Ideal.span_le]
      rintro _ ⟨j, hj, rfl⟩
      obtain ⟨l, hl⟩ := hlt j hj
      rw [hl]
      exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨l, rfl⟩)
    have hinj : Function.Injective (fun k => Fin.castAdd c (I k)) :=
      fun a b h => I.injective (Fin.castAdd_injective n c h)
    have hsm := wc_pfc_ds_strictly_standard_smooth s1 D (n + c) (c + m) c (Nat.le_add_right c m)
      (Fin.append K F) (fun k => Fin.castAdd c (I k)) hinj
      (MvPolynomial.C p * (Matrix.of fun k l : Fin c => MvPolynomial.pderiv (Fin.castAdd c (I k)) (K l)).det)
      (MvPolynomial.C p) (by simp only [hcastK, sub_self]; exact zero_mem _) (by
        intro j hj
        induction j using Fin.addCases with
