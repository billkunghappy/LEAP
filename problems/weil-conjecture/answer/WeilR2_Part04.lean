theorem wc_pfc_pc_fib_of_surjective : (∀ (B : Type u) [CommRing B] [IsLocalRing B] [IsNoetherianRing B] (S : Type u) [CommRing S] [IsLocalRing S] [Algebra B S], Function.Surjective (algebraMap B S) → Nonempty (TensorProduct B S (AdicCompletion (IsLocalRing.maximalIdeal B) B) ≃ₐ[S] AdicCompletion (IsLocalRing.maximalIdeal S) S)) → ∀ (P : Type u) [CommRing P] [IsLocalRing P] [IsNoetherianRing P] (S : Type u) [CommRing S] [IsLocalRing S] [IsNoetherianRing S] [Algebra P S], Function.Surjective (algebraMap P S) → ∀ (𝔭 : Ideal S) [𝔭.IsPrime], (∀ (Λ : Type u) [CommRing Λ] [Algebra S Λ], Nonempty (AdicCompletion (IsLocalRing.maximalIdeal S) S ≃ₐ[S] Λ) → ∀ (L : Type u) [Field L] [Algebra S L] [Algebra (𝔭).ResidueField L] [IsScalarTower S (𝔭).ResidueField L] [FiniteDimensional (𝔭).ResidueField L] (𝔔 : Ideal (TensorProduct S L Λ)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) → ∀ (Λ : Type u) [CommRing Λ] [Algebra P Λ], Nonempty (AdicCompletion (IsLocalRing.maximalIdeal P) P ≃ₐ[P] Λ) → ∀ (L : Type u) [Field L] [Algebra P L] [Algebra (𝔭.comap (algebraMap P S)).ResidueField L] [IsScalarTower P (𝔭.comap (algebraMap P S)).ResidueField L] [FiniteDimensional (𝔭.comap (algebraMap P S)).ResidueField L] (𝔔 : Ideal (TensorProduct P L Λ)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔) :=
by
  intro SURJ P _ _ _ S _ _ _ _ hsurj 𝔭 _ hFS Λ _ _ hΛ L _ _ _ _ _ 𝔔 _
  have h1 : Function.Surjective (Localization.localRingHom (𝔭.comap (algebraMap P S)) 𝔭
      (algebraMap P S) rfl) := by
    intro z
    obtain ⟨⟨y, t⟩, hz⟩ := IsLocalization.mk'_surjective 𝔭.primeCompl z
    change IsLocalization.mk' _ y t = z at hz
    subst hz
    obtain ⟨x, rfl⟩ := hsurj y
    obtain ⟨s, hs⟩ := hsurj t
    have hs' : s ∈ (𝔭.comap (algebraMap P S)).primeCompl := by
      show s ∉ Ideal.comap (algebraMap P S) 𝔭
      rw [Ideal.mem_comap, hs]; exact t.2
    refine ⟨IsLocalization.mk' (Localization.AtPrime (𝔭.comap (algebraMap P S))) x ⟨s, hs'⟩, ?_⟩
    rw [Localization.localRingHom_mk']
    congr 1
    exact Subtype.ext hs
  have hρs : Function.Surjective (Ideal.ResidueField.map (𝔭.comap (algebraMap P S)) 𝔭
      (algebraMap P S) rfl) := by
    intro w
    obtain ⟨z, rfl⟩ := IsLocalRing.residue_surjective w
    obtain ⟨z', rfl⟩ := h1 z
    exact ⟨IsLocalRing.residue _ z', IsLocalRing.ResidueField.map_residue _ z'⟩
  let ρe : (𝔭.comap (algebraMap P S)).ResidueField ≃+* 𝔭.ResidueField :=
    RingEquiv.ofBijective (Ideal.ResidueField.map (𝔭.comap (algebraMap P S)) 𝔭
      (algebraMap P S) rfl) ⟨RingHom.injective _, hρs⟩
  letI iK : Algebra 𝔭.ResidueField L :=
    ((algebraMap (𝔭.comap (algebraMap P S)).ResidueField L).comp ρe.symm.toRingHom).toAlgebra
  letI iS : Algebra S L :=
    ((algebraMap 𝔭.ResidueField L).comp (algebraMap S 𝔭.ResidueField)).toAlgebra
  haveI : IsScalarTower S 𝔭.ResidueField L := IsScalarTower.of_algebraMap_eq' rfl
  haveI : IsScalarTower P S L := by
    refine IsScalarTower.of_algebraMap_eq (fun p => ?_)
    change algebraMap P L p = algebraMap (𝔭.comap (algebraMap P S)).ResidueField L
      (ρe.symm (algebraMap S 𝔭.ResidueField (algebraMap P S p)))
    have hx : algebraMap S 𝔭.ResidueField (algebraMap P S p) =
        ρe (algebraMap P (𝔭.comap (algebraMap P S)).ResidueField p) := by
      have hρe : ∀ x, ρe x = Ideal.ResidueField.map (𝔭.comap (algebraMap P S)) 𝔭
          (algebraMap P S) rfl x := fun x => RingEquiv.ofBijective_apply _ _ x
      rw [hρe, Ideal.ResidueField.map_algebraMap]
    rw [hx, RingEquiv.symm_apply_apply, ← IsScalarTower.algebraMap_apply]
  haveI : FiniteDimensional 𝔭.ResidueField L := by
    letI : Algebra 𝔭.ResidueField (𝔭.comap (algebraMap P S)).ResidueField :=
      ρe.symm.toRingHom.toAlgebra
    haveI : Module.Finite 𝔭.ResidueField (𝔭.comap (algebraMap P S)).ResidueField :=
      RingHom.Finite.of_surjective _ ρe.symm.surjective
    haveI : IsScalarTower 𝔭.ResidueField (𝔭.comap (algebraMap P S)).ResidueField L :=
      IsScalarTower.of_algebraMap_eq' rfl
    exact Module.Finite.trans (𝔭.comap (algebraMap P S)).ResidueField L
  obtain ⟨σ⟩ := SURJ P S hsurj
  obtain ⟨e⟩ := hΛ
  let τ : TensorProduct P S Λ ≃ₐ[S] AdicCompletion (IsLocalRing.maximalIdeal S) S :=
    (Algebra.TensorProduct.congr (AlgEquiv.refl : S ≃ₐ[S] S) e.symm).trans σ
  let Ψ : TensorProduct S L (AdicCompletion (IsLocalRing.maximalIdeal S) S) ≃+*
      TensorProduct P L Λ :=
    ((Algebra.TensorProduct.congr (AlgEquiv.refl : L ≃ₐ[S] L) τ.symm).trans
      (Algebra.TensorProduct.cancelBaseChange P S S L Λ)).toRingEquiv
  have t_s2 : ∀ (T' : Type u) [CommRing T'] (T : Type u) [CommRing T] (Ψ : T' ≃+* T)
      (𝔔 : Ideal T) [𝔔.IsPrime],
      IsRegularLocalRing (Localization.AtPrime (Ideal.comap (Ψ : T' →+* T) 𝔔)) →
      IsRegularLocalRing (Localization.AtPrime 𝔔) := by
    intro T' _ T _ Ψ 𝔔 _ h
    have H : Submonoid.map Ψ.toMonoidHom (Ideal.comap (Ψ : T' →+* T) 𝔔).primeCompl
        = 𝔔.primeCompl := by
      ext x
      simp only [Submonoid.mem_map]
      constructor
      · rintro ⟨y, hy, rfl⟩
        exact hy
      · intro hx
        refine ⟨Ψ.symm x, ?_, by simp⟩
        show Ψ.symm x ∉ Ideal.comap (Ψ : T' →+* T) 𝔔
        rw [Ideal.mem_comap]
        simpa using hx
    haveI := h
    exact IsRegularLocalRing.of_ringEquiv (IsLocalization.ringEquivOfRingEquiv
      (Localization.AtPrime (Ideal.comap (Ψ : T' →+* T) 𝔔)) (Localization.AtPrime 𝔔) Ψ H)
  have hreg := hFS (AdicCompletion (IsLocalRing.maximalIdeal S) S) ⟨AlgEquiv.refl⟩ L
    (Ideal.comap (Ψ : TensorProduct S L (AdicCompletion (IsLocalRing.maximalIdeal S) S) →+*
      TensorProduct P L Λ) 𝔔)
  exact t_s2 _ _ Ψ 𝔔 hreg

theorem wc_pfc_pc_reduce_to_domain : (∀ (P : Type u) [CommRing P] [IsLocalRing P] [IsNoetherianRing P] (S : Type u) [CommRing S] [IsLocalRing S] [IsNoetherianRing S] [Algebra P S], Function.Surjective (algebraMap P S) → ∀ (𝔭 : Ideal S) [𝔭.IsPrime], (∀ (Λ : Type u) [CommRing Λ] [Algebra S Λ], Nonempty (AdicCompletion (IsLocalRing.maximalIdeal S) S ≃ₐ[S] Λ) → ∀ (L : Type u) [Field L] [Algebra S L] [Algebra (𝔭).ResidueField L] [IsScalarTower S (𝔭).ResidueField L] [FiniteDimensional (𝔭).ResidueField L] (𝔔 : Ideal (TensorProduct S L Λ)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) → ∀ (Λ : Type u) [CommRing Λ] [Algebra P Λ], Nonempty (AdicCompletion (IsLocalRing.maximalIdeal P) P ≃ₐ[P] Λ) → ∀ (L : Type u) [Field L] [Algebra P L] [Algebra (𝔭.comap (algebraMap P S)).ResidueField L] [IsScalarTower P (𝔭.comap (algebraMap P S)).ResidueField L] [FiniteDimensional (𝔭.comap (algebraMap P S)).ResidueField L] (𝔔 : Ideal (TensorProduct P L Λ)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) → (∀ (C : Type u) [CommRing C] [IsLocalRing C] [IsNoetherianRing C] [IsDomain C], IsAdicComplete (IsLocalRing.maximalIdeal C) C → ∀ (𝔮 : Ideal (Polynomial C)) [𝔮.IsMaximal], 𝔮.comap Polynomial.C = IsLocalRing.maximalIdeal C → ∀ (𝔭 : Ideal (Localization.AtPrime 𝔮)) [𝔭.IsPrime], 𝔭.comap ((algebraMap (Polynomial C) (Localization.AtPrime 𝔮)).comp Polynomial.C) = ⊥ → ∀ (Λ : Type u) [CommRing Λ] [Algebra (Localization.AtPrime 𝔮) Λ], Nonempty (AdicCompletion (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮)) (Localization.AtPrime 𝔮) ≃ₐ[Localization.AtPrime 𝔮] Λ) → ∀ (L : Type u) [Field L] [Algebra (Localization.AtPrime 𝔮) L] [Algebra (𝔭).ResidueField L] [IsScalarTower (Localization.AtPrime 𝔮) (𝔭).ResidueField L] [FiniteDimensional (𝔭).ResidueField L] (𝔔 : Ideal (TensorProduct (Localization.AtPrime 𝔮) L Λ)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) → ∀ (C : Type u) [CommRing C] [IsLocalRing C] [IsNoetherianRing C], IsAdicComplete (IsLocalRing.maximalIdeal C) C → ∀ (𝔮 : Ideal (Polynomial C)) [𝔮.IsMaximal], 𝔮.comap Polynomial.C = IsLocalRing.maximalIdeal C → ∀ (𝔭 : Ideal (Localization.AtPrime 𝔮)) [𝔭.IsPrime], ∀ (Λ : Type u) [CommRing Λ] [Algebra (Localization.AtPrime 𝔮) Λ], Nonempty (AdicCompletion (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮)) (Localization.AtPrime 𝔮) ≃ₐ[Localization.AtPrime 𝔮] Λ) → ∀ (L : Type u) [Field L] [Algebra (Localization.AtPrime 𝔮) L] [Algebra (𝔭).ResidueField L] [IsScalarTower (Localization.AtPrime 𝔮) (𝔭).ResidueField L] [FiniteDimensional (𝔭).ResidueField L] (𝔔 : Ideal (TensorProduct (Localization.AtPrime 𝔮) L Λ)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔) :=
by

  have s2 : ∀ (C : Type u) [CommRing C] [IsLocalRing C] (J : Ideal C) [IsLocalRing (C ⧸ J)]
      (𝔮 : Ideal (Polynomial C)) [𝔮.IsMaximal], 𝔮.comap Polynomial.C = IsLocalRing.maximalIdeal C →
      Ideal.map Polynomial.C J ≤ 𝔮 →
      (𝔮.map (Polynomial.mapRingHom (Ideal.Quotient.mk J))).IsMaximal ∧
      (𝔮.map (Polynomial.mapRingHom (Ideal.Quotient.mk J))).comap
        (Polynomial.mapRingHom (Ideal.Quotient.mk J)) = 𝔮 ∧
      (𝔮.map (Polynomial.mapRingHom (Ideal.Quotient.mk J))).comap Polynomial.C =
        IsLocalRing.maximalIdeal (C ⧸ J) := by
    intro C _ _ J _ 𝔮 h𝔮max h𝔮 hJ
    have hs : Function.Surjective (Polynomial.mapRingHom (Ideal.Quotient.mk J)) := by
      intro p
      obtain ⟨q, hq⟩ := Polynomial.map_surjective (Ideal.Quotient.mk J)
        Ideal.Quotient.mk_surjective p
      exact ⟨q, hq⟩
    have hker : RingHom.ker (Polynomial.mapRingHom (Ideal.Quotient.mk J)) ≤ 𝔮 := by
      rw [Polynomial.ker_mapRingHom, Ideal.mk_ker]
      exact hJ
    have hcomap : (𝔮.map (Polynomial.mapRingHom (Ideal.Quotient.mk J))).comap
        (Polynomial.mapRingHom (Ideal.Quotient.mk J)) = 𝔮 := by
      rw [Ideal.comap_map_of_surjective' _ hs, sup_eq_left.mpr hker]
    have hmax : (𝔮.map (Polynomial.mapRingHom (Ideal.Quotient.mk J))).IsMaximal := by
      rcases Ideal.map_eq_top_or_isMaximal_of_surjective _ hs h𝔮max with h | h
      · exfalso
        have h' : 𝔮 = ⊤ := by rw [← hcomap, h, Ideal.comap_top]
        exact h𝔮max.ne_top h'
      · exact h
    refine ⟨hmax, hcomap, ?_⟩
    have hpull : Ideal.comap (Ideal.Quotient.mk J)
        ((𝔮.map (Polynomial.mapRingHom (Ideal.Quotient.mk J))).comap Polynomial.C) =
        IsLocalRing.maximalIdeal C := by
      rw [Ideal.comap_comap, ← Polynomial.mapRingHom_comp_C, ← Ideal.comap_comap, hcomap, h𝔮]
    have hI : (𝔮.map (Polynomial.mapRingHom (Ideal.Quotient.mk J))).comap Polynomial.C =
        Ideal.map (Ideal.Quotient.mk J) (IsLocalRing.maximalIdeal C) := by
      rw [← hpull, Ideal.map_comap_of_surjective _ Ideal.Quotient.mk_surjective]
    rw [hI]
    rcases Ideal.map_eq_top_or_isMaximal_of_surjective (Ideal.Quotient.mk J)
        Ideal.Quotient.mk_surjective (IsLocalRing.maximalIdeal.isMaximal C) with h | h
    · exfalso
      have h' : IsLocalRing.maximalIdeal C = ⊤ := by
        rw [← hpull, hI, h, Ideal.comap_top]
      exact (IsLocalRing.maximalIdeal.isMaximal C).ne_top h'
    · exact IsLocalRing.eq_maximalIdeal h

  have s3 : ∀ (A : Type u) [CommRing A] (B : Type u) [CommRing B] (π : A →+* B),
      Function.Surjective π → ∀ (𝔮 : Ideal A) [𝔮.IsPrime] (𝔮' : Ideal B) [𝔮'.IsPrime]
      (h : 𝔮 = 𝔮'.comap π), Function.Surjective (Localization.localRingHom 𝔮 𝔮' π h) ∧
      ∀ (𝔭 : Ideal (Localization.AtPrime 𝔮)) [𝔭.IsPrime],
        RingHom.ker π ≤ 𝔭.comap (algebraMap A (Localization.AtPrime 𝔮)) →
        (𝔭.map (Localization.localRingHom 𝔮 𝔮' π h)).IsPrime ∧
        (𝔭.map (Localization.localRingHom 𝔮 𝔮' π h)).comap
          (Localization.localRingHom 𝔮 𝔮' π h) = 𝔭 := by
    intro A _ B _ π hπ 𝔮 _ 𝔮' _ h
    have hunit : ∀ u : A, π u ∈ 𝔮'.primeCompl → u ∈ 𝔮.primeCompl := by
      intro u hu
      show u ∉ 𝔮
      intro hu'
      rw [h] at hu'
      exact hu hu'
    have hsurj : Function.Surjective (Localization.localRingHom 𝔮 𝔮' π h) := by
      intro z
      obtain ⟨⟨g, t⟩, hz⟩ := IsLocalization.mk'_surjective 𝔮'.primeCompl
        (S := Localization.AtPrime 𝔮') z
      change IsLocalization.mk' _ g t = z at hz
      subst hz
      obtain ⟨a, rfl⟩ := hπ g
      obtain ⟨s, hs⟩ := hπ (t : B)
      refine ⟨IsLocalization.mk' (Localization.AtPrime 𝔮) a
        ⟨s, hunit s (by rw [hs]; exact t.2)⟩, ?_⟩
      rw [Localization.localRingHom_mk']
      congr 1
      exact Subtype.ext hs
    refine ⟨hsurj, ?_⟩
    intro 𝔭 h𝔭 hK
    have hker : RingHom.ker (Localization.localRingHom 𝔮 𝔮' π h) ≤ 𝔭 := by
      intro z hz
      rw [RingHom.mem_ker] at hz
      obtain ⟨⟨a, s⟩, hzs⟩ := IsLocalization.mk'_surjective 𝔮.primeCompl
        (S := Localization.AtPrime 𝔮) z
      change IsLocalization.mk' _ a s = z at hzs
      subst hzs
      rw [Localization.localRingHom_mk', IsLocalization.mk'_eq_zero_iff] at hz
      obtain ⟨m, hm⟩ := hz
      obtain ⟨u, hu⟩ := hπ (m : B)
      have hu' : u ∈ 𝔮.primeCompl := hunit u (by rw [hu]; exact m.2)
      have hua : u * a ∈ RingHom.ker π := by
        rw [RingHom.mem_ker, map_mul, hu, hm]
      have h1 : algebraMap A (Localization.AtPrime 𝔮) u *
          algebraMap A (Localization.AtPrime 𝔮) a ∈ 𝔭 := by
        rw [← map_mul]
        exact hK hua
      have h2 : algebraMap A (Localization.AtPrime 𝔮) a ∈ 𝔭 := by
        rcases h𝔭.mem_or_mem h1 with h3 | h3
        · exfalso
          exact h𝔭.ne_top (Ideal.eq_top_of_isUnit_mem _ h3
            (IsLocalization.map_units (Localization.AtPrime 𝔮) (⟨u, hu'⟩ : 𝔮.primeCompl)))
        · exact h3
      rw [IsLocalization.mk'_eq_mul_mk'_one]
      exact Ideal.mul_mem_right _ _ h2
    exact ⟨Ideal.map_isPrime_of_surjective hsurj hker,
      by rw [Ideal.comap_map_of_surjective' _ hsurj, sup_eq_left.mpr hker]⟩

  intro SF DOM C _ _ _ hC 𝔮 _ h𝔮 𝔭 _

  have s1 : ∀ (C : Type u) [CommRing C] [IsLocalRing C] [IsNoetherianRing C]
      [IsAdicComplete (IsLocalRing.maximalIdeal C) C] (J : Ideal C), J ≠ ⊤ →
      ∃ (_ : IsLocalRing (C ⧸ J)), IsAdicComplete (IsLocalRing.maximalIdeal (C ⧸ J)) (C ⧸ J) := by
    intro C _ _ _ _ J hJ
    haveI hnt : Nontrivial (C ⧸ J) := Ideal.Quotient.nontrivial_iff.mpr hJ
    haveI hloc : IsLocalRing (C ⧸ J) :=
      IsLocalRing.of_surjective' (Ideal.Quotient.mk J) Ideal.Quotient.mk_surjective
    refine ⟨hloc, ?_⟩
    haveI : IsNoetherianRing (C ⧸ J) := Ideal.Quotient.isNoetherianRing J
    have hH : IsHausdorff (IsLocalRing.maximalIdeal (C ⧸ J)) (C ⧸ J) :=
      IsHausdorff.of_isLocalRing (IsLocalRing.maximalIdeal (C ⧸ J)) (C ⧸ J)
        (IsLocalRing.maximalIdeal.isMaximal _).ne_top
    have hmap : (IsLocalRing.maximalIdeal C).map (Ideal.Quotient.mk J) =
        IsLocalRing.maximalIdeal (C ⧸ J) :=
      IsLocalRing.map_maximalIdeal_of_surjective _ Ideal.Quotient.mk_surjective
    have key : ∀ (I : Ideal C) (n : ℕ) (x : C ⧸ J),
        x ∈ (I.map (Ideal.Quotient.mk J)) ^ n • (⊤ : Submodule (C ⧸ J) (C ⧸ J)) ↔
          x ∈ (I ^ n).map (Ideal.Quotient.mk J) := by
      intro I n x
      rw [Ideal.smul_eq_mul, Ideal.mul_top, Ideal.map_pow]
    have keyC : ∀ (I : Ideal C) (n : ℕ) (x : C),
        x ∈ I ^ n • (⊤ : Submodule C C) ↔ x ∈ I ^ n := by
      intro I n x
      rw [Ideal.smul_eq_mul, Ideal.mul_top]
    have hP : IsPrecomplete (IsLocalRing.maximalIdeal (C ⧸ J)) (C ⧸ J) := by
      rw [← hmap]
      constructor
      intro g hg
      have hd : ∀ i, g (i + 1) - g i ∈
          (IsLocalRing.maximalIdeal C ^ i).map (Ideal.Quotient.mk J) := by
        intro i
        have h1 := hg (Nat.le_succ i)
        rw [SModEq.sub_mem, key] at h1
        rw [← neg_sub]
        exact neg_mem h1
      choose e he hfe using fun i =>
        (Ideal.mem_map_iff_of_surjective _ Ideal.Quotient.mk_surjective).mp (hd i)
      obtain ⟨c₀, hc₀⟩ := Ideal.Quotient.mk_surjective (g 0)
      let h : ℕ → C := fun n => c₀ + ∑ i ∈ Finset.range n, e i
      have hfh : ∀ n, Ideal.Quotient.mk J (h n) = g n := by
        intro n
        simp only [h, map_add, map_sum, hfe, hc₀]
        rw [Finset.sum_range_sub (fun i => g i) n]
        abel
      have hcau : ∀ a n, a ≤ n → h n - h a ∈ IsLocalRing.maximalIdeal C ^ a := by
        intro a n han
        induction n, han using Nat.le_induction with
        | base => simp
        | succ k hak ih =>
          have h2 : h (k + 1) - h a = (h k - h a) + e k := by
            simp only [h, Finset.sum_range_succ]; ring
          rw [h2]
          exact add_mem ih (Ideal.pow_le_pow_right hak (he k))
      obtain ⟨L, hL⟩ := IsPrecomplete.prec
        (inferInstance : IsPrecomplete (IsLocalRing.maximalIdeal C) C) (f := h) (by
          intro a n han
          rw [SModEq.sub_mem, keyC, ← neg_sub]
          exact neg_mem (hcau a n han))
      refine ⟨Ideal.Quotient.mk J L, fun n => ?_⟩
      have h3 := hL n
      rw [SModEq.sub_mem, keyC] at h3
      rw [SModEq.sub_mem, key, ← hfh n, ← map_sub]
      exact Ideal.mem_map_of_mem _ h3
    exact { toIsHausdorff := hH, toIsPrecomplete := hP }
  have transport : ∀ (𝔭₁ 𝔭₂ : Ideal (Localization.AtPrime 𝔮)) [𝔭₁.IsPrime] [𝔭₂.IsPrime],
      𝔭₁ = 𝔭₂ →
      (∀ (Λ : Type u) [CommRing Λ] [Algebra (Localization.AtPrime 𝔮) Λ], Nonempty (AdicCompletion (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮)) (Localization.AtPrime 𝔮) ≃ₐ[Localization.AtPrime 𝔮] Λ) → ∀ (L : Type u) [Field L] [Algebra (Localization.AtPrime 𝔮) L] [Algebra (𝔭₁).ResidueField L] [IsScalarTower (Localization.AtPrime 𝔮) (𝔭₁).ResidueField L] [FiniteDimensional (𝔭₁).ResidueField L] (𝔔 : Ideal (TensorProduct (Localization.AtPrime 𝔮) L Λ)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) →
      (∀ (Λ : Type u) [CommRing Λ] [Algebra (Localization.AtPrime 𝔮) Λ], Nonempty (AdicCompletion (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮)) (Localization.AtPrime 𝔮) ≃ₐ[Localization.AtPrime 𝔮] Λ) → ∀ (L : Type u) [Field L] [Algebra (Localization.AtPrime 𝔮) L] [Algebra (𝔭₂).ResidueField L] [IsScalarTower (Localization.AtPrime 𝔮) (𝔭₂).ResidueField L] [FiniteDimensional (𝔭₂).ResidueField L] (𝔔 : Ideal (TensorProduct (Localization.AtPrime 𝔮) L Λ)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) := by
    intro 𝔭₁ 𝔭₂ _ _ e H
    subst e
    exact H

  obtain ⟨𝔭₀, h𝔭₀def⟩ : ∃ J : Ideal C,
      J = 𝔭.comap ((algebraMap (Polynomial C) (Localization.AtPrime 𝔮)).comp Polynomial.C) :=
    ⟨_, rfl⟩
  have hmem₀ : ∀ c : C, c ∈ 𝔭₀ ↔
      algebraMap (Polynomial C) (Localization.AtPrime 𝔮) (Polynomial.C c) ∈ 𝔭 := by
    intro c
    rw [h𝔭₀def]
    rfl
  haveI h𝔭₀ : 𝔭₀.IsPrime := by
    rw [h𝔭₀def]
    exact Ideal.comap_isPrime _ 𝔭
  haveI := hC
  obtain ⟨hloc, hC'⟩ := s1 C 𝔭₀ h𝔭₀.ne_top
  haveI := hloc
  have hJ : Ideal.map Polynomial.C 𝔭₀ ≤ 𝔮 := by
    rw [Ideal.map_le_iff_le_comap, h𝔮]
    exact IsLocalRing.le_maximalIdeal h𝔭₀.ne_top
  obtain ⟨hmax, hcomap, hCmax⟩ := s2 C 𝔭₀ 𝔮 h𝔮 hJ
  have hπs : Function.Surjective (Polynomial.mapRingHom (Ideal.Quotient.mk 𝔭₀)) := by
    intro p
    obtain ⟨q, hq⟩ := Polynomial.map_surjective (Ideal.Quotient.mk 𝔭₀)
      Ideal.Quotient.mk_surjective p
    exact ⟨q, hq⟩
  have hK : RingHom.ker (Polynomial.mapRingHom (Ideal.Quotient.mk 𝔭₀)) ≤
      𝔭.comap (algebraMap (Polynomial C) (Localization.AtPrime 𝔮)) := by
    rw [Polynomial.ker_mapRingHom, Ideal.mk_ker, Ideal.map_le_iff_le_comap]
    intro c hc
    rw [Ideal.mem_comap, Ideal.mem_comap]
    exact (hmem₀ c).mp hc
  generalize 𝔮.map (Polynomial.mapRingHom (Ideal.Quotient.mk 𝔭₀)) = 𝔮' at hmax hcomap hCmax
  haveI := hmax
  obtain ⟨hψs, hprime⟩ := s3 (Polynomial C) (Polynomial (C ⧸ 𝔭₀))
    (Polynomial.mapRingHom (Ideal.Quotient.mk 𝔭₀)) hπs 𝔮 𝔮' hcomap.symm
  obtain ⟨h𝔭'prime, h𝔭'comap⟩ := hprime 𝔭 hK
  have hψι : ∀ c : C, Localization.localRingHom 𝔮 𝔮'
      (Polynomial.mapRingHom (Ideal.Quotient.mk 𝔭₀)) hcomap.symm
      (algebraMap (Polynomial C) (Localization.AtPrime 𝔮) (Polynomial.C c)) =
      algebraMap (Polynomial (C ⧸ 𝔭₀)) (Localization.AtPrime 𝔮')
        (Polynomial.C (Ideal.Quotient.mk 𝔭₀ c)) := by
    intro c
    rw [Localization.localRingHom_to_map, Polynomial.coe_mapRingHom, Polynomial.map_C]
  generalize Localization.localRingHom 𝔮 𝔮'
      (Polynomial.mapRingHom (Ideal.Quotient.mk 𝔭₀)) hcomap.symm = ψ at hψs h𝔭'prime h𝔭'comap hψι
  generalize Ideal.map ψ 𝔭 = 𝔭' at h𝔭'prime h𝔭'comap
  haveI := h𝔭'prime

  have hGEN : 𝔭'.comap ((algebraMap (Polynomial (C ⧸ 𝔭₀)) (Localization.AtPrime 𝔮')).comp
      Polynomial.C) = ⊥ := by
    have e1 : Ideal.comap (Ideal.Quotient.mk 𝔭₀) (𝔭'.comap
        ((algebraMap (Polynomial (C ⧸ 𝔭₀)) (Localization.AtPrime 𝔮')).comp Polynomial.C)) =
        𝔭₀ := by
      ext c
      rw [Ideal.mem_comap, Ideal.mem_comap, RingHom.comp_apply, ← hψι c, hmem₀ c,
        ← h𝔭'comap, Ideal.mem_comap]
    have e2 := congrArg (Ideal.map (Ideal.Quotient.mk 𝔭₀)) e1
    rw [Ideal.map_comap_of_surjective _ Ideal.Quotient.mk_surjective,
      Ideal.map_quotient_self] at e2
    exact e2
  have hS := DOM (C ⧸ 𝔭₀) hC' 𝔮' hCmax 𝔭' hGEN
  letI : Algebra (Localization.AtPrime 𝔮) (Localization.AtPrime 𝔮') := ψ.toAlgebra
  have hP := SF (Localization.AtPrime 𝔮) (Localization.AtPrime 𝔮') hψs 𝔭' hS
  exact transport _ 𝔭 h𝔭'comap hP

theorem wc_pfc_pc_finite_poly_comap : ∀ (C₀ : Type u) [CommRing C₀] [IsLocalRing C₀] [IsNoetherianRing C₀] (C : Type u) [CommRing C] [IsLocalRing C] [IsNoetherianRing C] [Algebra C₀ C] [Module.Finite C₀ C], Function.Injective (algebraMap C₀ C) → ∀ (𝔮 : Ideal (Polynomial C)) [𝔮.IsMaximal], 𝔮.comap Polynomial.C = IsLocalRing.maximalIdeal C → (𝔮.comap (Polynomial.mapRingHom (algebraMap C₀ C))).IsMaximal ∧ (𝔮.comap (Polynomial.mapRingHom (algebraMap C₀ C))).comap Polynomial.C = IsLocalRing.maximalIdeal C₀ ∧ ∀ (𝔭 : Ideal (Localization.AtPrime 𝔮)) [𝔭.IsPrime], 𝔭.comap ((algebraMap (Polynomial C) (Localization.AtPrime 𝔮)).comp Polynomial.C) = ⊥ → (𝔭.comap (Localization.localRingHom (𝔮.comap (Polynomial.mapRingHom (algebraMap C₀ C))) 𝔮 (Polynomial.mapRingHom (algebraMap C₀ C)) rfl)).comap ((algebraMap (Polynomial C₀) (Localization.AtPrime (𝔮.comap (Polynomial.mapRingHom (algebraMap C₀ C))))).comp Polynomial.C) = ⊥ :=
by
  intro C₀ _ _ _ C _ _ _ _ _ hinj 𝔮 _ hq
  have hint : (Polynomial.mapRingHom (algebraMap C₀ C)).IsIntegral := by
    letI : Algebra (Polynomial C₀) (Polynomial C) := Polynomial.algebra C₀ C
    intro p
    have h : IsIntegral (Polynomial C₀) p :=
      Polynomial.isIntegral_iff_isIntegral_coeff.2 (fun n => IsIntegral.of_finite C₀ _)
    rw [_root_.IsIntegral, Polynomial.algebraMap_def] at h
    exact h
  have hfint : (algebraMap C₀ C).IsIntegral :=
    algebraMap_isIntegral_iff.2 (Algebra.IsIntegral.of_finite C₀ C)
  refine ⟨Ideal.isMaximal_comap_of_isIntegral_of_isMaximal _ hint 𝔮, ?_, ?_⟩
  · rw [Ideal.comap_comap, Polynomial.mapRingHom_comp_C, ← Ideal.comap_comap, hq]
    haveI hmax : (Ideal.comap (algebraMap C₀ C) (IsLocalRing.maximalIdeal C)).IsMaximal :=
      Ideal.isMaximal_comap_of_isIntegral_of_isMaximal _ hfint _
    exact IsLocalRing.eq_maximalIdeal hmax
  · intro 𝔭 _ h𝔭
    rw [eq_bot_iff]
    intro c hc
    rw [Ideal.mem_comap, Ideal.mem_comap, RingHom.comp_apply, Localization.localRingHom_to_map,
      Polynomial.coe_mapRingHom, Polynomial.map_C] at hc
    have hc' : algebraMap C₀ C c ∈ (⊥ : Ideal C) := by
      rw [← h𝔭]
      exact hc
    rw [Ideal.mem_bot] at hc' ⊢
    exact hinj (by rw [hc', map_zero])

theorem wc_pfc_pc_fib_finite_transfer : ∀ (C₀ : Type u) [CommRing C₀] [IsLocalRing C₀] [IsNoetherianRing C₀] (C : Type u) [CommRing C] [IsLocalRing C] [IsNoetherianRing C] [Algebra C₀ C] [Module.Finite C₀ C], Function.Injective (algebraMap C₀ C) → ∀ (𝔮 : Ideal (Polynomial C)) [𝔮.IsMaximal], 𝔮.comap Polynomial.C = IsLocalRing.maximalIdeal C → ∀ (𝔭 : Ideal (Localization.AtPrime 𝔮)) [𝔭.IsPrime], (∀ (Λ : Type u) [CommRing Λ] [Algebra (Localization.AtPrime (𝔮.comap (Polynomial.mapRingHom (algebraMap C₀ C)))) Λ], Nonempty (AdicCompletion (IsLocalRing.maximalIdeal (Localization.AtPrime (𝔮.comap (Polynomial.mapRingHom (algebraMap C₀ C))))) (Localization.AtPrime (𝔮.comap (Polynomial.mapRingHom (algebraMap C₀ C)))) ≃ₐ[Localization.AtPrime (𝔮.comap (Polynomial.mapRingHom (algebraMap C₀ C)))] Λ) → ∀ (L : Type u) [Field L] [Algebra (Localization.AtPrime (𝔮.comap (Polynomial.mapRingHom (algebraMap C₀ C)))) L] [Algebra (𝔭.comap (Localization.localRingHom (𝔮.comap (Polynomial.mapRingHom (algebraMap C₀ C))) 𝔮 (Polynomial.mapRingHom (algebraMap C₀ C)) rfl)).ResidueField L] [IsScalarTower (Localization.AtPrime (𝔮.comap (Polynomial.mapRingHom (algebraMap C₀ C)))) (𝔭.comap (Localization.localRingHom (𝔮.comap (Polynomial.mapRingHom (algebraMap C₀ C))) 𝔮 (Polynomial.mapRingHom (algebraMap C₀ C)) rfl)).ResidueField L] [FiniteDimensional (𝔭.comap (Localization.localRingHom (𝔮.comap (Polynomial.mapRingHom (algebraMap C₀ C))) 𝔮 (Polynomial.mapRingHom (algebraMap C₀ C)) rfl)).ResidueField L] (𝔔 : Ideal (TensorProduct (Localization.AtPrime (𝔮.comap (Polynomial.mapRingHom (algebraMap C₀ C)))) L Λ)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) → ∀ (Λ : Type u) [CommRing Λ] [Algebra (Localization.AtPrime 𝔮) Λ], Nonempty (AdicCompletion (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮)) (Localization.AtPrime 𝔮) ≃ₐ[Localization.AtPrime 𝔮] Λ) → ∀ (L : Type u) [Field L] [Algebra (Localization.AtPrime 𝔮) L] [Algebra (𝔭).ResidueField L] [IsScalarTower (Localization.AtPrime 𝔮) (𝔭).ResidueField L] [FiniteDimensional (𝔭).ResidueField L] (𝔔 : Ideal (TensorProduct (Localization.AtPrime 𝔮) L Λ)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔) :=
by
  have T1 := wc_hnas_pfc_gcl_finite_completion_tensor
  have T2 := wc_hnas_pfc_gcl_semilocal_completion_split
  intro C₀ _ _ _ C _ _ _ _ _ hinj 𝔮 _ h𝔮 𝔭 _ H Λ _ _ hΛ L _ _ _ _ _ 𝔔 _
  have G := PLift.up H
  clear H

  have s1 : ∀ (C₀ : Type u) [CommRing C₀] (C : Type u) [CommRing C] [Algebra C₀ C], Module.Finite C₀ C → (Polynomial.mapRingHom (algebraMap C₀ C)).Finite := by
    intro C₀ _ C _ _ hfin
    letI : Algebra (Polynomial C₀) (Polynomial C) := (Polynomial.mapRingHom (algebraMap C₀ C)).toAlgebra
    have hsmul : ∀ (p : Polynomial C₀) (q : Polynomial C), p • q = Polynomial.map (algebraMap C₀ C) p * q :=
      fun p q => rfl
    show Module.Finite (Polynomial C₀) (Polynomial C)
    classical
    obtain ⟨S, hS⟩ := hfin.fg_top
    refine ⟨⟨S.image Polynomial.C, ?_⟩⟩
    rw [Submodule.eq_top_iff']
    intro p
    refine Polynomial.induction_on' p ?_ ?_
    · intro p q hp hq
      exact Submodule.add_mem _ hp hq
    · intro n a
      have ha : a ∈ Submodule.span C₀ (↑S : Set C) := by rw [hS]; trivial
      induction ha using Submodule.span_induction with
      | mem c hc =>
        have e : Polynomial.monomial n c = (Polynomial.monomial n (1 : C₀)) • Polynomial.C c := by
          rw [hsmul, Polynomial.map_monomial, map_one, Polynomial.monomial_mul_C, one_mul]
        rw [e]
        exact Submodule.smul_mem _ _
          (Submodule.subset_span (by simp only [Finset.coe_image]; exact ⟨c, hc, rfl⟩))
      | zero => rw [map_zero]; exact Submodule.zero_mem _
      | add x y _ _ hx hy => rw [map_add]; exact Submodule.add_mem _ hx hy
      | smul r x _ hx =>
        have e : Polynomial.monomial n (r • x) = (Polynomial.C r) • Polynomial.monomial n x := by
          rw [hsmul, Polynomial.map_C, Polynomial.C_mul_monomial, Algebra.smul_def]
        rw [e]
        exact Submodule.smul_mem _ _ hx

  have s2 : ∀ (A : Type u) [CommRing A] (B : Type u) [CommRing B] (f : A →+* B), f.Finite → ∀ (𝔮 : Ideal B) [𝔮.IsPrime] (𝔭 : Ideal (Localization.AtPrime 𝔮)) [𝔭.IsPrime], (Ideal.ResidueField.map (𝔭.comap (Localization.localRingHom (𝔮.comap f) 𝔮 f rfl)) 𝔭 (Localization.localRingHom (𝔮.comap f) 𝔮 f rfl) rfl).Finite := by
    intro A _ B _ f hf 𝔮 _ 𝔭 _
    letI : Algebra A B := f.toAlgebra
    haveI hfin : Module.Finite A B := hf
    have hψ : ∀ a : A, Localization.localRingHom (𝔮.comap f) 𝔮 f rfl
        (algebraMap A (Localization.AtPrime (𝔮.comap f)) a) =
        algebraMap B (Localization.AtPrime 𝔮) (f a) := fun a =>
      Localization.localRingHom_to_map _ 𝔮 f rfl a
    let g : B →+* 𝔭.ResidueField := (algebraMap (Localization.AtPrime 𝔮) 𝔭.ResidueField).comp
      (algebraMap B (Localization.AtPrime 𝔮))
    let α : A →+* (𝔭.comap (Localization.localRingHom (𝔮.comap f) 𝔮 f rfl)).ResidueField :=
      (algebraMap (Localization.AtPrime (𝔮.comap f))
        (𝔭.comap (Localization.localRingHom (𝔮.comap f) 𝔮 f rfl)).ResidueField).comp
        (algebraMap A (Localization.AtPrime (𝔮.comap f)))
    have hρα : ∀ a : A, Ideal.ResidueField.map (𝔭.comap (Localization.localRingHom (𝔮.comap f) 𝔮 f rfl)) 𝔭
        (Localization.localRingHom (𝔮.comap f) 𝔮 f rfl) rfl (α a) = g (algebraMap A B a) := by
      intro a
      change Ideal.ResidueField.map (𝔭.comap (Localization.localRingHom (𝔮.comap f) 𝔮 f rfl)) 𝔭
        (Localization.localRingHom (𝔮.comap f) 𝔮 f rfl) rfl
        (algebraMap _ _ (algebraMap A (Localization.AtPrime (𝔮.comap f)) a)) = _
      rw [Ideal.ResidueField.map_algebraMap, hψ]
      rfl

    have ht : ∀ t : 𝔮.primeCompl, g (t : B) ≠ 0 := by
      intro t h0
      have h1 : algebraMap B (Localization.AtPrime 𝔮) (t : B) ∈ 𝔭 :=
        Ideal.algebraMap_residueField_eq_zero.mp h0
      exact Ideal.IsPrime.ne_top ‹𝔭.IsPrime›
        (Ideal.eq_top_of_isUnit_mem _ h1 (IsLocalization.map_units _ t))

    have hfrac : ∀ z : 𝔭.ResidueField, ∃ x y : B, g y ≠ 0 ∧ z * g y = g x := by
      intro z
      obtain ⟨u, hu⟩ := IsLocalRing.residue_surjective z
      have hu' : algebraMap (Localization.AtPrime 𝔭) 𝔭.ResidueField u = z := hu
      obtain ⟨⟨x₁, s⟩, hxs⟩ := IsLocalization.surj 𝔭.primeCompl u
      simp only at hxs
      have e0 : z * algebraMap (Localization.AtPrime 𝔮) 𝔭.ResidueField (s : Localization.AtPrime 𝔮) =
          algebraMap (Localization.AtPrime 𝔮) 𝔭.ResidueField x₁ := by
        rw [← hu', IsScalarTower.algebraMap_apply (Localization.AtPrime 𝔮) (Localization.AtPrime 𝔭)
          𝔭.ResidueField (s : Localization.AtPrime 𝔮),
          IsScalarTower.algebraMap_apply (Localization.AtPrime 𝔮) (Localization.AtPrime 𝔭)
          𝔭.ResidueField x₁, ← map_mul, hxs]
      have hs : algebraMap (Localization.AtPrime 𝔮) 𝔭.ResidueField (s : Localization.AtPrime 𝔮) ≠ 0 :=
        fun h => s.2 (Ideal.algebraMap_residueField_eq_zero.mp h)
      obtain ⟨⟨x₂, t₁⟩, h1⟩ := IsLocalization.surj 𝔮.primeCompl x₁
      obtain ⟨⟨s₂, t₂⟩, h2⟩ := IsLocalization.surj 𝔮.primeCompl (s : Localization.AtPrime 𝔮)
      simp only at h1 h2
      have e1 : algebraMap (Localization.AtPrime 𝔮) 𝔭.ResidueField x₁ * g t₁ = g x₂ := by
        simp only [g, RingHom.comp_apply]
        rw [← map_mul, h1]
      have e2 : algebraMap (Localization.AtPrime 𝔮) 𝔭.ResidueField (s : Localization.AtPrime 𝔮) *
          g t₂ = g s₂ := by
        simp only [g, RingHom.comp_apply]
        rw [← map_mul, h2]
      refine ⟨x₂ * t₂, s₂ * t₁, ?_, ?_⟩
      · rw [map_mul, ← e2]
        exact mul_ne_zero (mul_ne_zero hs (ht t₂)) (ht t₁)
      · rw [map_mul, map_mul, ← e1, ← e2]
        linear_combination (g t₁ * g t₂) * e0

    have happrox : ∀ y : B, g y ≠ 0 → ∃ a₀ : A, ∃ w : B,
        g (algebraMap A B a₀) ≠ 0 ∧ g (algebraMap A B a₀) = g w * g y := by
      intro y hy
      have hy𝔯 : y ∉ RingHom.ker g := fun h => hy (RingHom.mem_ker.mp h)
      have hle : RingHom.ker g ≤ RingHom.ker g ⊔ Ideal.span {y} := le_sup_left
      have hmem : y ∈ (↑(RingHom.ker g ⊔ Ideal.span {y}) : Set B) \ ↑(RingHom.ker g) :=
        ⟨Ideal.mem_sup_right (Ideal.mem_span_singleton_self y), hy𝔯⟩
      have hyint : _root_.IsIntegral A y := Algebra.IsIntegral.isIntegral y
      haveI : (RingHom.ker g).IsPrime := RingHom.ker_isPrime g
      have hlt := Ideal.under_lt_under_of_integral_mem_sdiff hle hmem hyint
      obtain ⟨a₀, ha₀J, ha₀𝔯⟩ := SetLike.exists_of_lt hlt
      have h1 : algebraMap A B a₀ ∈ RingHom.ker g ⊔ Ideal.span {y} := ha₀J
      have h2 : algebraMap A B a₀ ∉ RingHom.ker g := ha₀𝔯
      obtain ⟨r, hr, s, hs, hrs⟩ := Submodule.mem_sup.mp h1
      obtain ⟨w, rfl⟩ := Ideal.mem_span_singleton'.mp hs
      refine ⟨a₀, w, fun h => h2 (RingHom.mem_ker.mpr h), ?_⟩
      rw [← hrs, map_add, RingHom.mem_ker.mp hr, zero_add, map_mul]

    letI : Algebra (𝔭.comap (Localization.localRingHom (𝔮.comap f) 𝔮 f rfl)).ResidueField
        𝔭.ResidueField :=
      (Ideal.ResidueField.map (𝔭.comap (Localization.localRingHom (𝔮.comap f) 𝔮 f rfl)) 𝔭
        (Localization.localRingHom (𝔮.comap f) 𝔮 f rfl) rfl).toAlgebra
    have hsmul : ∀ (c : (𝔭.comap (Localization.localRingHom (𝔮.comap f) 𝔮 f rfl)).ResidueField)
        (v : 𝔭.ResidueField), c • v = Ideal.ResidueField.map
          (𝔭.comap (Localization.localRingHom (𝔮.comap f) 𝔮 f rfl)) 𝔭
          (Localization.localRingHom (𝔮.comap f) 𝔮 f rfl) rfl c * v := fun c v => rfl
    show Module.Finite (𝔭.comap (Localization.localRingHom (𝔮.comap f) 𝔮 f rfl)).ResidueField
      𝔭.ResidueField
    classical
    obtain ⟨S, hS⟩ := hfin.fg_top
    have hspan : ∀ x : B, g x ∈ Submodule.span
        (𝔭.comap (Localization.localRingHom (𝔮.comap f) 𝔮 f rfl)).ResidueField
        (↑(S.image g) : Set 𝔭.ResidueField) := by
      intro x
      have hx : x ∈ Submodule.span A (↑S : Set B) := by rw [hS]; trivial
      induction hx using Submodule.span_induction with
      | mem x hx =>
        exact Submodule.subset_span (by simp only [Finset.coe_image]; exact ⟨x, hx, rfl⟩)
      | zero => rw [map_zero]; exact Submodule.zero_mem _
      | add x y _ _ hx hy => rw [map_add]; exact Submodule.add_mem _ hx hy
      | smul a x _ hx =>
        rw [Algebra.smul_def, map_mul, ← hρα, ← hsmul]
        exact Submodule.smul_mem _ _ hx
    refine ⟨⟨S.image g, ?_⟩⟩
    rw [Submodule.eq_top_iff']
    intro z
    obtain ⟨x, y, hy, hzy⟩ := hfrac z
    obtain ⟨a₀, w, ha0, hw⟩ := happrox y hy
    have hra : Ideal.ResidueField.map (𝔭.comap (Localization.localRingHom (𝔮.comap f) 𝔮 f rfl)) 𝔭
        (Localization.localRingHom (𝔮.comap f) 𝔮 f rfl) rfl (α a₀) ≠ 0 := by
      rw [hρα]; exact ha0
    have hzf : z = (α a₀)⁻¹ • g (x * w) := by
      rw [hsmul, map_inv₀, eq_inv_mul_iff_mul_eq₀ hra, hρα, hw, map_mul]
      linear_combination g w * hzy
    rw [hzf]
    exact Submodule.smul_mem _ _ (hspan _)

  have s3 : ∀ (R : Type u) [CommRing R] (M : Submonoid R) (S : Type u) [CommRing S] [Algebra R S] [IsLocalization M S] (X : Type u) [CommRing X] [Algebra R X] [Algebra S X] [IsScalarTower R S X] (Y : Type u) [CommRing Y] [Algebra R Y] [Algebra S Y] [IsScalarTower R S Y], Nonempty (TensorProduct R X Y ≃+* TensorProduct S X Y) := by
    intro R _ M S _ _ _ X _ _ _ _ Y _ _ _ _
    have := IsLocalization.tensorProduct_compatibleSMul M S X Y
    exact ⟨(Algebra.TensorProduct.equivOfCompatibleSMul R S S X Y).symm.toRingEquiv⟩

  have s4 : ∀ (A : Type u) [CommRing A] (B : Type u) [CommRing B] [Algebra A B] (M : Submonoid A) (P : Type u) [CommRing P] [Algebra A P] [IsLocalization M P] (N : Submonoid B) (Q : Type u) [CommRing Q] [Algebra B Q] [IsLocalization N Q] (φ : P →+* Q), φ.comp (algebraMap A P) = (algebraMap B Q).comp (algebraMap A B) → ∀ (X : Type u) [CommRing X] [Algebra P X] [Algebra A X] [IsScalarTower A P X] (Λ : Type u) [CommRing Λ] [Algebra Q Λ] (E : Type u) [CommRing E] [Algebra B E] (Θ : TensorProduct A B X ≃+* Λ × E), (∀ b : B, Θ (b ⊗ₜ[A] (1 : X)) = (algebraMap Q Λ (algebraMap B Q b), algebraMap B E b)) → ∀ (L : Type u) [CommRing L] [Algebra Q L] [Algebra P L], algebraMap P L = (algebraMap Q L).comp φ → ∃ (R₂ : Type u) (_ : CommRing R₂), Nonempty (TensorProduct P L X ≃+* (TensorProduct Q L Λ) × R₂) := by
    intro A _ B _ _ M P _ _ _ N Q _ _ _ φ hφ X _ _ _ _ Λ _ _ E _ _ Θ hΘ L _ _ _ hL
    letI iAL : Algebra A L := ((algebraMap P L).comp (algebraMap A P)).toAlgebra
    haveI tAPL : IsScalarTower A P L := IsScalarTower.of_algebraMap_eq' rfl
    letI iBL : Algebra B L := ((algebraMap Q L).comp (algebraMap B Q)).toAlgebra
    haveI tBQL : IsScalarTower B Q L := IsScalarTower.of_algebraMap_eq' rfl
    haveI tABL : IsScalarTower A B L := by
      refine IsScalarTower.of_algebraMap_eq' ?_
      change (algebraMap P L).comp (algebraMap A P) =
        ((algebraMap Q L).comp (algebraMap B Q)).comp (algebraMap A B)
      rw [hL, RingHom.comp_assoc, hφ, RingHom.comp_assoc]
    letI iBΛ : Algebra B Λ := ((algebraMap Q Λ).comp (algebraMap B Q)).toAlgebra
    haveI tBQΛ : IsScalarTower B Q Λ := IsScalarTower.of_algebraMap_eq' rfl
    obtain ⟨e₁⟩ := s3 A M P L X
    let e₂ := Algebra.TensorProduct.cancelBaseChange A B B L X
    let Θ' : TensorProduct A B X ≃ₐ[B] Λ × E := AlgEquiv.ofRingEquiv (f := Θ) (fun b => hΘ b)
    let e₃ := Algebra.TensorProduct.congr (AlgEquiv.refl (R := B) (A₁ := L)) Θ'
    let e₄ := Algebra.TensorProduct.prodRight B B L Λ E
    obtain ⟨e₅⟩ := s3 B N Q L Λ
    exact ⟨TensorProduct B L E, inferInstance, ⟨e₁.symm.trans (e₂.symm.toRingEquiv.trans
      (e₃.toRingEquiv.trans (e₄.toRingEquiv.trans (RingEquiv.prodCongr e₅ (RingEquiv.refl _)))))⟩⟩

  have s5 : ∀ (R : Type u) [CommRing R] (R₁ : Type u) [CommRing R₁] (R₂ : Type u) [CommRing R₂] (Ψ : R ≃+* R₁ × R₂) (𝔔 : Ideal R₁) [𝔔.IsPrime], Nonempty (Localization.AtPrime (𝔔.comap ((RingHom.fst R₁ R₂).comp Ψ.toRingHom)) ≃+* Localization.AtPrime 𝔔) := by
    intro R _ R₁ _ R₂ _ Ψ 𝔔 _
    set π : R →+* R₁ := (RingHom.fst R₁ R₂).comp Ψ.toRingHom with hπ
    have hπs : ∀ (x : R₁) (y : R₂), π (Ψ.symm (x, y)) = x := by
      intro x y
      simp [π]
    letI : Algebra R (Localization.AtPrime 𝔔) :=
      ((algebraMap R₁ (Localization.AtPrime 𝔔)).comp π).toAlgebra
    have hal : ∀ r : R, algebraMap R (Localization.AtPrime 𝔔) r =
        algebraMap R₁ (Localization.AtPrime 𝔔) (π r) := fun r => rfl
    have hloc : IsLocalization (𝔔.comap π).primeCompl (Localization.AtPrime 𝔔) := by
      constructor
      constructor
      · rintro ⟨r, hr⟩
        rw [hal]
        exact IsLocalization.map_units (Localization.AtPrime 𝔔) (⟨π r, hr⟩ : 𝔔.primeCompl)
      · intro z
        obtain ⟨⟨x, s⟩, hxs⟩ := IsLocalization.surj 𝔔.primeCompl z
        have hs : Ψ.symm ((s : R₁), (1 : R₂)) ∈ (𝔔.comap π).primeCompl := by
          change π (Ψ.symm ((s : R₁), (1 : R₂))) ∉ 𝔔
          rw [hπs]
          exact s.2
        refine ⟨⟨Ψ.symm (x, 0), ⟨_, hs⟩⟩, ?_⟩
        simp only [hal, hπs]
        exact hxs
      · intro r₁ r₂ h
        rw [hal, hal] at h
        obtain ⟨c, hc⟩ := IsLocalization.exists_of_eq (M := 𝔔.primeCompl) h
        have hc' : Ψ.symm ((c : R₁), (0 : R₂)) ∈ (𝔔.comap π).primeCompl := by
          change π (Ψ.symm ((c : R₁), (0 : R₂))) ∉ 𝔔
          rw [hπs]
          exact c.2
        refine ⟨⟨_, hc'⟩, ?_⟩
        apply Ψ.injective
        simp only [map_mul, RingEquiv.apply_symm_apply]
        have e1 : ∀ r : R, Ψ r = (π r, (Ψ r).2) := fun r => rfl
        rw [e1 r₁, e1 r₂]
        simp only [Prod.mk_mul_mk, zero_mul, hc]
    exact ⟨(IsLocalization.algEquiv (𝔔.comap π).primeCompl
      (Localization.AtPrime (𝔔.comap π)) (Localization.AtPrime 𝔔)).toRingEquiv⟩

  letI iAB : Algebra (Polynomial C₀) (Polynomial C) :=
    (Polynomial.mapRingHom (algebraMap C₀ C)).toAlgebra
  have hφfin : (Polynomial.mapRingHom (algebraMap C₀ C)).Finite := s1 C₀ C inferInstance
  haveI hfinAB : Module.Finite (Polynomial C₀) (Polynomial C) := hφfin
  have hρ := s2 _ _ (Polynomial.mapRingHom (algebraMap C₀ C)) hφfin 𝔮 𝔭
  letI iPL : Algebra (Localization.AtPrime (𝔮.comap (Polynomial.mapRingHom (algebraMap C₀ C)))) L :=
    ((algebraMap (Localization.AtPrime 𝔮) L).comp (Localization.localRingHom
      (𝔮.comap (Polynomial.mapRingHom (algebraMap C₀ C))) 𝔮
      (Polynomial.mapRingHom (algebraMap C₀ C)) rfl)).toAlgebra
  letI iκL : Algebra (𝔭.comap (Localization.localRingHom
      (𝔮.comap (Polynomial.mapRingHom (algebraMap C₀ C))) 𝔮
      (Polynomial.mapRingHom (algebraMap C₀ C)) rfl)).ResidueField L :=
    ((algebraMap 𝔭.ResidueField L).comp (Ideal.ResidueField.map (𝔭.comap (Localization.localRingHom
      (𝔮.comap (Polynomial.mapRingHom (algebraMap C₀ C))) 𝔮
      (Polynomial.mapRingHom (algebraMap C₀ C)) rfl)) 𝔭 (Localization.localRingHom
      (𝔮.comap (Polynomial.mapRingHom (algebraMap C₀ C))) 𝔮
      (Polynomial.mapRingHom (algebraMap C₀ C)) rfl) rfl)).toAlgebra
  haveI tPκL : IsScalarTower (Localization.AtPrime (𝔮.comap (Polynomial.mapRingHom (algebraMap C₀ C))))
      (𝔭.comap (Localization.localRingHom
      (𝔮.comap (Polynomial.mapRingHom (algebraMap C₀ C))) 𝔮
      (Polynomial.mapRingHom (algebraMap C₀ C)) rfl)).ResidueField L := by
    refine IsScalarTower.of_algebraMap_eq (fun x => ?_)
    change algebraMap (Localization.AtPrime 𝔮) L (Localization.localRingHom
      (𝔮.comap (Polynomial.mapRingHom (algebraMap C₀ C))) 𝔮
      (Polynomial.mapRingHom (algebraMap C₀ C)) rfl x) =
      algebraMap 𝔭.ResidueField L (Ideal.ResidueField.map (𝔭.comap (Localization.localRingHom
      (𝔮.comap (Polynomial.mapRingHom (algebraMap C₀ C))) 𝔮
      (Polynomial.mapRingHom (algebraMap C₀ C)) rfl)) 𝔭 (Localization.localRingHom
      (𝔮.comap (Polynomial.mapRingHom (algebraMap C₀ C))) 𝔮
      (Polynomial.mapRingHom (algebraMap C₀ C)) rfl) rfl (algebraMap _ _ x))
    rw [Ideal.ResidueField.map_algebraMap, ← IsScalarTower.algebraMap_apply]
  haveI fκL : FiniteDimensional (𝔭.comap (Localization.localRingHom
      (𝔮.comap (Polynomial.mapRingHom (algebraMap C₀ C))) 𝔮
      (Polynomial.mapRingHom (algebraMap C₀ C)) rfl)).ResidueField L :=
    RingHom.Finite.comp (RingHom.finite_algebraMap.mpr inferInstance) hρ
  obtain ⟨T1e⟩ := T1 (Polynomial C₀) (Polynomial C) hfinAB
    (𝔮.comap (Polynomial.mapRingHom (algebraMap C₀ C)))
  obtain ⟨E, _, _, ⟨T2e⟩⟩ := T2 (Polynomial C₀) (Polynomial C)
    hfinAB (𝔮.comap (Polynomial.mapRingHom (algebraMap C₀ C))) 𝔮 rfl
  obtain ⟨eΛ⟩ := hΛ
  let Θ := T1e.toRingEquiv.trans (T2e.toRingEquiv.trans
    (RingEquiv.prodCongr eΛ.toRingEquiv (RingEquiv.refl E)))
  have hΘ : ∀ b : Polynomial C, Θ (b ⊗ₜ[Polynomial C₀] (1 : AdicCompletion (IsLocalRing.maximalIdeal
      (Localization.AtPrime (𝔮.comap (Polynomial.mapRingHom (algebraMap C₀ C)))))
      (Localization.AtPrime (𝔮.comap (Polynomial.mapRingHom (algebraMap C₀ C)))))) =
      (algebraMap (Localization.AtPrime 𝔮) Λ (algebraMap (Polynomial C) (Localization.AtPrime 𝔮) b),
        algebraMap (Polynomial C) E b) := by
    intro b
    have h2 := T1e.commutes b
    simp only [Algebra.TensorProduct.algebraMap_apply, Algebra.algebraMap_self,
      RingHom.id_apply] at h2
    change (RingEquiv.prodCongr eΛ.toRingEquiv (RingEquiv.refl E)) (T2e (T1e _)) = _
    rw [h2, T2e.commutes, Prod.algebraMap_apply]
    change (eΛ (algebraMap (Polynomial C) _ b), algebraMap (Polynomial C) E b) = _
    rw [IsScalarTower.algebraMap_apply (Polynomial C) (Localization.AtPrime 𝔮)
      (AdicCompletion (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮)) (Localization.AtPrime 𝔮)),
      AlgEquiv.commutes]
  have hψc : (Localization.localRingHom (𝔮.comap (Polynomial.mapRingHom (algebraMap C₀ C))) 𝔮
      (Polynomial.mapRingHom (algebraMap C₀ C)) rfl).comp
      (algebraMap (Polynomial C₀) (Localization.AtPrime (𝔮.comap (Polynomial.mapRingHom (algebraMap C₀ C))))) =
      (algebraMap (Polynomial C) (Localization.AtPrime 𝔮)).comp (algebraMap (Polynomial C₀) (Polynomial C)) :=
    RingHom.ext (Localization.localRingHom_to_map _ 𝔮 (Polynomial.mapRingHom (algebraMap C₀ C)) rfl)
  obtain ⟨R₂, _, ⟨Γ⟩⟩ := s4 (Polynomial C₀) (Polynomial C)
    (𝔮.comap (Polynomial.mapRingHom (algebraMap C₀ C))).primeCompl
    (Localization.AtPrime (𝔮.comap (Polynomial.mapRingHom (algebraMap C₀ C)))) 𝔮.primeCompl
    (Localization.AtPrime 𝔮) _ hψc _ Λ E Θ hΘ L rfl
  have hreg := G.down
    (AdicCompletion (IsLocalRing.maximalIdeal (Localization.AtPrime (𝔮.comap (Polynomial.mapRingHom (algebraMap C₀ C)))))
      (Localization.AtPrime (𝔮.comap (Polynomial.mapRingHom (algebraMap C₀ C))))) ⟨AlgEquiv.refl⟩ L
    (𝔔.comap ((RingHom.fst _ _).comp Γ.toRingHom))
  obtain ⟨σ⟩ := s5 _ _ R₂ Γ 𝔔
  exact IsRegularLocalRing.of_ringEquiv
    (R := Localization.AtPrime (𝔔.comap ((RingHom.fst _ _).comp Γ.toRingHom)))
    (R' := Localization.AtPrime 𝔔) σ

theorem wc_pfc_pc_poly_localization_regular : (∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A] (B : Type u) [CommRing B] [IsLocalRing B] [IsNoetherianRing B] [Algebra A B] [IsLocalHom (algebraMap A B)] [Module.Flat A B], IsRegularLocalRing A → IsRegularLocalRing (B ⧸ Ideal.map (algebraMap A B) (IsLocalRing.maximalIdeal A)) → IsRegularLocalRing B) → ∀ (C₀ : Type u) [CommRing C₀] [IsLocalRing C₀] [IsNoetherianRing C₀], IsRegularLocalRing C₀ → ∀ (𝔮 : Ideal (Polynomial C₀)) [𝔮.IsPrime], 𝔮.comap Polynomial.C = IsLocalRing.maximalIdeal C₀ → IsRegularLocalRing (Localization.AtPrime 𝔮) :=
by


  have s3 : ∀ (κ : Type u) [Field κ] (P : Ideal (Polynomial κ)) [P.IsPrime],
      IsRegularLocalRing (Localization.AtPrime P) := by
    intro κ _ P _
    by_cases hP : P = ⊥
    · have hbot : IsLocalRing.maximalIdeal (Localization.AtPrime P) = ⊥ := by
        rw [← Localization.AtPrime.map_eq_maximalIdeal]
        refine le_bot_iff.mp (Ideal.map_le_iff_le_comap.mpr ?_)
        intro p hp
        have hp0 : p = 0 := by
          rw [hP, Ideal.mem_bot] at hp
          exact hp
        rw [hp0]
        exact Ideal.zero_mem _
      refine IsRegularLocalRing.mk ?_
      rw [hbot, Submodule.spanFinrank_bot,
        ringKrullDim_eq_zero_of_isField (IsLocalRing.isField_iff_maximalIdeal_eq.mpr hbot)]
      simp
    · haveI : IsDedekindDomain (Polynomial κ) := IsPrincipalIdealRing.isDedekindDomain _
      haveI : IsDomain (Localization.AtPrime P) := inferInstance
      haveI : IsDiscreteValuationRing (Localization.AtPrime P) :=
        IsLocalization.AtPrime.isDiscreteValuationRing_of_dedekind_domain (Polynomial κ) hP
          (Localization.AtPrime P)
      infer_instance
  intro R1 C₀ _ _ _ hreg 𝔮 _ h

  haveI hflat : Module.Flat C₀ (Localization.AtPrime 𝔮) :=
    Module.Flat.trans C₀ (Polynomial C₀) (Localization.AtPrime 𝔮)
  haveI hloc : IsLocalHom (algebraMap C₀ (Localization.AtPrime 𝔮)) := by
    refine ⟨fun a ha => ?_⟩
    rw [IsScalarTower.algebraMap_apply C₀ (Polynomial C₀) (Localization.AtPrime 𝔮),
      Polynomial.algebraMap_eq] at ha
    have h1 := (IsLocalization.AtPrime.isUnit_to_map_iff (Localization.AtPrime 𝔮) 𝔮
      (Polynomial.C a)).mp ha
    by_contra hna
    have h2 : a ∈ IsLocalRing.maximalIdeal C₀ := hna
    rw [← h, Ideal.mem_comap] at h2
    exact h1 h2

  let ρ : Polynomial C₀ →+* Polynomial (IsLocalRing.ResidueField C₀) :=
    Polynomial.mapRingHom (IsLocalRing.residue C₀)
  have hρ : Function.Surjective ρ :=
    Polynomial.map_surjective _ IsLocalRing.residue_surjective
  have hker : RingHom.ker ρ = Ideal.map Polynomial.C (IsLocalRing.maximalIdeal C₀) := by
    rw [Polynomial.ker_mapRingHom, IsLocalRing.ker_residue]
  have hkerle : RingHom.ker ρ ≤ 𝔮 := by
    rw [hker, Ideal.map_le_iff_le_comap, h]
  haveI hP : (𝔮.map ρ).IsPrime := Ideal.map_isPrime_of_surjective hρ hkerle
  have hcomap : (𝔮.map ρ).comap ρ = 𝔮 := by
    rw [Ideal.comap_map_of_surjective ρ hρ, ← RingHom.ker_eq_comap_bot, sup_eq_left.mpr hkerle]
  have hmemP : ∀ s, s ∈ 𝔮 ↔ ρ s ∈ 𝔮.map ρ := fun s => by
    rw [← Ideal.mem_comap, hcomap]
  obtain ⟨ψ, hψdef⟩ : ∃ ψ : Localization.AtPrime 𝔮 →+* Localization.AtPrime (𝔮.map ρ),
      ψ = Localization.localRingHom 𝔮 (𝔮.map ρ) ρ hcomap.symm := ⟨_, rfl⟩
  have hψ : Function.Surjective ψ := by
    intro z
    obtain ⟨⟨t', ⟨u', hu'⟩⟩, rfl⟩ := IsLocalization.mk'_surjective (𝔮.map ρ).primeCompl z
    obtain ⟨t, rfl⟩ := hρ t'
    obtain ⟨u, rfl⟩ := hρ u'
    have hu : u ∈ 𝔮.primeCompl := fun hu => hu' ((hmemP u).mp hu)
    refine ⟨IsLocalization.mk' (Localization.AtPrime 𝔮) t ⟨u, hu⟩, ?_⟩
    rw [hψdef, Localization.localRingHom_mk']
  have hB : (algebraMap (Polynomial C₀) (Localization.AtPrime 𝔮)).comp Polynomial.C =
      algebraMap C₀ (Localization.AtPrime 𝔮) := by
    rw [IsScalarTower.algebraMap_eq C₀ (Polynomial C₀) (Localization.AtPrime 𝔮),
      Polynomial.algebraMap_eq]
  have hkerψ : RingHom.ker ψ =
      Ideal.map (algebraMap C₀ (Localization.AtPrime 𝔮)) (IsLocalRing.maximalIdeal C₀) := by
    apply le_antisymm
    · intro x hx
      rw [RingHom.mem_ker] at hx
      obtain ⟨⟨t, ⟨u, hu⟩⟩, rfl⟩ := IsLocalization.mk'_surjective 𝔮.primeCompl x
      rw [hψdef, Localization.localRingHom_mk', IsLocalization.mk'_eq_zero_iff] at hx
      obtain ⟨⟨v', hv'⟩, hv⟩ := hx
      obtain ⟨v, rfl⟩ := hρ v'
      have hv𝔮 : v ∈ 𝔮.primeCompl := fun hv0 => hv' ((hmemP v).mp hv0)
      have hvt : t * v ∈ Ideal.map Polynomial.C (IsLocalRing.maximalIdeal C₀) := by
        rw [← hker, RingHom.mem_ker, map_mul, mul_comm]
        exact hv
      have e : IsLocalization.mk' (Localization.AtPrime 𝔮) t (⟨u, hu⟩ : 𝔮.primeCompl) =
          algebraMap _ (Localization.AtPrime 𝔮) (t * v) *
            IsLocalization.mk' (Localization.AtPrime 𝔮) (1 : Polynomial C₀)
              ((⟨u, hu⟩ : 𝔮.primeCompl) * ⟨v, hv𝔮⟩) := by
        rw [← IsLocalization.mk'_eq_mul_mk'_one]
        exact (IsLocalization.mk'_cancel t ⟨u, hu⟩ ⟨v, hv𝔮⟩).symm
      change IsLocalization.mk' (Localization.AtPrime 𝔮) t (⟨u, hu⟩ : 𝔮.primeCompl) ∈ _
      rw [e]
      apply Ideal.mul_mem_right
      rw [← hB, ← Ideal.map_map]
      exact Ideal.mem_map_of_mem _ hvt
    · rw [Ideal.map_le_iff_le_comap]
      intro c hc
      rw [Ideal.mem_comap, RingHom.mem_ker, ← hB, RingHom.comp_apply, hψdef,
        Localization.localRingHom_to_map]
      have h0 : ρ (Polynomial.C c) = 0 := by
        rw [← RingHom.mem_ker, hker]
        exact Ideal.mem_map_of_mem _ hc
      rw [h0, map_zero]
  let e : (Localization.AtPrime 𝔮 ⧸
      Ideal.map (algebraMap C₀ (Localization.AtPrime 𝔮)) (IsLocalRing.maximalIdeal C₀)) ≃+*
      Localization.AtPrime (𝔮.map ρ) :=
    (Ideal.quotEquivOfEq hkerψ.symm).trans (RingHom.quotientKerEquivOfSurjective hψ)
  have hfib : IsRegularLocalRing (Localization.AtPrime 𝔮 ⧸
      Ideal.map (algebraMap C₀ (Localization.AtPrime 𝔮)) (IsLocalRing.maximalIdeal C₀)) :=
    @IsRegularLocalRing.of_ringEquiv _ _ (s3 (IsLocalRing.ResidueField C₀) (𝔮.map ρ)) _ _ e.symm
  exact R1 C₀ (Localization.AtPrime 𝔮) hreg hfib

theorem wc_pfc_pc_completion_regular : (∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A] (B : Type u) [CommRing B] [IsLocalRing B] [IsNoetherianRing B] [Algebra A B] [IsLocalHom (algebraMap A B)] [Module.Flat A B], IsRegularLocalRing A → IsRegularLocalRing (B ⧸ Ideal.map (algebraMap A B) (IsLocalRing.maximalIdeal A)) → IsRegularLocalRing B) → ∀ (P : Type u) [CommRing P] [IsLocalRing P] [IsNoetherianRing P], IsRegularLocalRing P → ∀ (Λ : Type u) [CommRing Λ] [Algebra P Λ], Nonempty (AdicCompletion (IsLocalRing.maximalIdeal P) P ≃ₐ[P] Λ) → IsRegularLocalRing Λ :=
by
  have hfield : ∀ (K : Type u) [Field K], IsRegularLocalRing K := by
    intro K _
    exact IsRegularLocalRing.mk (by
      rw [IsLocalRing.maximalIdeal_eq_bot, Submodule.spanFinrank_bot,
        ringKrullDim_eq_zero_of_field]
      rfl)
  intro R1 P _ _ _ hP Λ _ _ hΛ
  haveI hCn : IsNoetherianRing (AdicCompletion (IsLocalRing.maximalIdeal P) P) :=
    wc_hnas_completion_noetherian P
  obtain ⟨hsurj, hker⟩ := wc_hnas_hs_completion_levels P
  haveI hflat : Module.Flat P (AdicCompletion (IsLocalRing.maximalIdeal P) P) :=
    AdicCompletion.flat_of_isNoetherian _
  set ι := algebraMap P (AdicCompletion (IsLocalRing.maximalIdeal P) P) with hι
  let φ : P →+* (AdicCompletion (IsLocalRing.maximalIdeal P) P ⧸
      Ideal.map ι (IsLocalRing.maximalIdeal P)) :=
    (Ideal.Quotient.mk (Ideal.map ι (IsLocalRing.maximalIdeal P))).comp ι
  have h4 : Function.Surjective φ := by
    intro q
    obtain ⟨c, rfl⟩ := Ideal.Quotient.mk_surjective q
    obtain ⟨p, hp⟩ := hsurj 1 c
    rw [pow_one] at hp
    refine ⟨p, ?_⟩
    change Ideal.Quotient.mk _ (ι p) = Ideal.Quotient.mk _ c
    exact (Ideal.Quotient.eq.mpr hp).symm
  have h5 : RingHom.ker φ = IsLocalRing.maximalIdeal P := by
    ext p
    rw [RingHom.mem_ker]
    change Ideal.Quotient.mk _ (ι p) = 0 ↔ _
    rw [Ideal.Quotient.eq_zero_iff_mem]
    constructor
    · intro h
      have := hker 1 p (by rw [pow_one]; exact h)
      rwa [pow_one] at this
    · intro h
      exact Ideal.mem_map_of_mem ι h
  have hκ : IsRegularLocalRing (IsLocalRing.ResidueField P) := hfield _
  let E : IsLocalRing.ResidueField P ≃+* (AdicCompletion (IsLocalRing.maximalIdeal P) P ⧸
      Ideal.map ι (IsLocalRing.maximalIdeal P)) :=
    (Ideal.quotEquivOfEq h5.symm).trans (RingHom.quotientKerEquivOfSurjective h4)
  have hQ : IsRegularLocalRing (AdicCompletion (IsLocalRing.maximalIdeal P) P ⧸
      Ideal.map ι (IsLocalRing.maximalIdeal P)) := IsRegularLocalRing.of_ringEquiv E
  haveI hC : IsRegularLocalRing (AdicCompletion (IsLocalRing.maximalIdeal P) P) :=
    R1 P (AdicCompletion (IsLocalRing.maximalIdeal P) P) hP hQ
  obtain ⟨e⟩ := hΛ
  exact IsRegularLocalRing.of_ringEquiv e.toRingEquiv

theorem wc_pfc_pc_quotient_regular_of_derivation : ∀ (R : Type u) [CommRing R] [IsLocalRing R] [IsNoetherianRing R], IsRegularLocalRing R → ∀ (D : Derivation ℤ R R) (f : R), f ∈ IsLocalRing.maximalIdeal R → IsUnit (D f) → IsRegularLocalRing (R ⧸ Ideal.span {f}) :=
by
  intro R _ _ _ hR D f hf hD
  have s3 : ∀ y ∈ IsLocalRing.maximalIdeal R ^ 2, D y ∈ IsLocalRing.maximalIdeal R := by
    intro y hy
    rw [sq] at hy
    refine Submodule.mul_induction_on hy ?_ ?_
    · intro a ha b hb
      rw [Derivation.leibniz, smul_eq_mul, smul_eq_mul]
      exact Ideal.add_mem _ (Ideal.mul_mem_right _ _ ha) (Ideal.mul_mem_right _ _ hb)
    · intro x z hx hz
      rw [map_add]
      exact Ideal.add_mem _ hx hz
  have hf2 : f ∉ IsLocalRing.maximalIdeal R ^ 2 := fun h =>
    (IsLocalRing.notMem_maximalIdeal.mpr hD) (s3 f h)
  exact (wc_rl_quot_regular wc_rl_quot_embdim R hR f hf hf2).1

theorem wc_pfc_pc_derivation_tensor : ∀ (R : Type u) [CommRing R] (S : Type u) [CommRing S] [Algebra R S] (L : Type u) [CommRing L] [Algebra R L] (D : Derivation ℤ S S), (∀ r : R, D (algebraMap R S r) = 0) → ∃ D' : Derivation ℤ (TensorProduct R L S) (TensorProduct R L S), (∀ s : S, D' (Algebra.TensorProduct.includeRight s) = Algebra.TensorProduct.includeRight (D s)) ∧ ∀ l : L, D' (Algebra.TensorProduct.includeLeft (S := R) l) = 0 :=
by
  intro R _ S _ _ L _ _ D hD
  let DR : S →ₗ[R] S :=
    { toFun := fun s => D s
      map_add' := fun a b => D.map_add a b
      map_smul' := fun r s => by
        simp only [RingHom.id_apply]
        rw [Algebra.smul_def, Derivation.leibniz, hD r, smul_zero, add_zero, smul_eq_mul,
          Algebra.smul_def] }
  let Φ : TensorProduct R L S →ₗ[R] TensorProduct R L S := LinearMap.lTensor L DR
  have hΦ : ∀ (l : L) (s : S), Φ (l ⊗ₜ[R] s) = l ⊗ₜ[R] D s := fun l s => by
    simp only [Φ, LinearMap.lTensor_tmul]
    rfl
  have hleib : ∀ a b : TensorProduct R L S, Φ (a * b) = a • Φ b + b • Φ a := by
    intro a b
    simp only [smul_eq_mul]
    induction a using TensorProduct.induction_on with
    | zero => simp
    | add a₁ a₂ h₁ h₂ => rw [add_mul, map_add, h₁, h₂, map_add]; ring
    | tmul l s =>
      induction b using TensorProduct.induction_on with
      | zero => simp
      | add b₁ b₂ h₁ h₂ => rw [mul_add, map_add, h₁, h₂, map_add]; ring
      | tmul l' s' =>
        rw [Algebra.TensorProduct.tmul_mul_tmul, hΦ, hΦ, hΦ, Algebra.TensorProduct.tmul_mul_tmul,
          Algebra.TensorProduct.tmul_mul_tmul, Derivation.leibniz, smul_eq_mul, smul_eq_mul,
          TensorProduct.tmul_add, mul_comm l' l]
  let D'R : Derivation R (TensorProduct R L S) (TensorProduct R L S) := Derivation.mk' Φ hleib
  refine ⟨D'R.restrictScalars ℤ, ?_, ?_⟩
  · intro s
    show Φ (1 ⊗ₜ[R] s) = 1 ⊗ₜ[R] D s
    exact hΦ 1 s
  · intro l
    show Φ (l ⊗ₜ[R] 1) = 0
    rw [hΦ, Derivation.map_one_eq_zero, TensorProduct.tmul_zero]

theorem wc_pfc_pc_derivation_exists_poly : ∀ (C₀ : Type u) [CommRing C₀] [IsNoetherianRing C₀] (p n : ℕ) (k : Type u) [Field k] [CharP k p], p.Prime → Nonempty (C₀ ≃+* MvPowerSeries (Fin n) k) → ∀ (B : Type u) [CommRing B] [IsDomain B] [Algebra (Polynomial C₀) B], Function.Injective (algebraMap (Polynomial C₀) B) → Module.Finite (Polynomial C₀) B → ∀ f : B, (¬ ∃ g : FractionRing B, g ^ p = algebraMap B (FractionRing B) f) → ∃ D : Derivation ℤ B B, D f ≠ 0 :=
by
  intro C₀ _ _ p n k _ _ hp hψ B _ _ _ hinj hfin f hf
  obtain ⟨ψ⟩ := hψ
  classical
  haveI : Fact p.Prime := ⟨hp⟩

  have s9 : ∀ (k' : Subfield k), ∃ S : Subring (MvPowerSeries (Fin n) k), ∀ G : MvPowerSeries (Fin n) k, G ∈ S ↔ (∀ e : Fin n →₀ ℕ, MvPowerSeries.coeff e G ∈ k' ∧ (MvPowerSeries.coeff e G ≠ 0 → ∀ j, p ∣ e j)) := by
    intro k'
    refine ⟨{ carrier := {G | ∀ e : Fin n →₀ ℕ, MvPowerSeries.coeff e G ∈ k' ∧ (MvPowerSeries.coeff e G ≠ 0 → ∀ j, p ∣ e j)}
              mul_mem' := by
                intro G H hG hH e
                rw [MvPowerSeries.coeff_mul]
                refine ⟨Subfield.sum_mem _ fun x _ => Subfield.mul_mem _ (hG x.1).1 (hH x.2).1, fun hne j => ?_⟩
                obtain ⟨x, hx, hx0⟩ := Finset.exists_ne_zero_of_sum_ne_zero hne
                rw [Finset.HasAntidiagonal.mem_antidiagonal] at hx
                rw [← hx, Finsupp.add_apply]
                exact dvd_add ((hG x.1).2 (left_ne_zero_of_mul hx0) j) ((hH x.2).2 (right_ne_zero_of_mul hx0) j)
              one_mem' := by
                intro e
                rw [MvPowerSeries.coeff_one]
                split_ifs with h
                · exact ⟨Subfield.one_mem _, fun _ j => by simp [h]⟩
                · exact ⟨Subfield.zero_mem _, fun h0 => absurd rfl h0⟩
              add_mem' := by
                intro G H hG hH e
                rw [map_add]
                refine ⟨Subfield.add_mem _ (hG e).1 (hH e).1, fun hne => ?_⟩
                by_cases h0 : MvPowerSeries.coeff e G = 0
                · rw [h0, zero_add] at hne; exact (hH e).2 hne
                · exact (hG e).2 h0
              zero_mem' := by
                intro e
                rw [map_zero]
                exact ⟨Subfield.zero_mem _, fun h0 => absurd rfl h0⟩
              neg_mem' := by
                intro G hG e
                rw [map_neg]
                exact ⟨Subfield.neg_mem _ (hG e).1, fun hne => (hG e).2 (neg_ne_zero.mp hne)⟩ },
      fun G => Iff.rfl⟩
  choose S0 hS0 using s9

  have s3 : ∀ F : Subfield k, ∃ S : Subring (Polynomial C₀), ∀ G : Polynomial C₀, G ∈ S ↔ ∀ m : ℕ, ψ (G.coeff m) ∈ S0 F ∧ (G.coeff m ≠ 0 → p ∣ m) := by
    intro F
    refine ⟨{ carrier := {G | ∀ m : ℕ, ψ (G.coeff m) ∈ S0 F ∧ (G.coeff m ≠ 0 → p ∣ m)}
              mul_mem' := by
                intro G H hG hH m
                rw [Polynomial.coeff_mul]
                refine ⟨?_, fun hne => ?_⟩
                · rw [map_sum]
                  exact (S0 F).sum_mem fun x _ => by
                    rw [map_mul]; exact (S0 F).mul_mem (hG x.1).1 (hH x.2).1
                · obtain ⟨x, hx, hx0⟩ := Finset.exists_ne_zero_of_sum_ne_zero hne
                  rw [Finset.HasAntidiagonal.mem_antidiagonal] at hx
                  rw [← hx]
                  exact dvd_add ((hG x.1).2 (left_ne_zero_of_mul hx0)) ((hH x.2).2 (right_ne_zero_of_mul hx0))
              one_mem' := by
                intro m
                rw [Polynomial.coeff_one]
                split_ifs with h
                · exact ⟨by rw [map_one]; exact (S0 F).one_mem, fun _ => by subst h; exact dvd_zero p⟩
                · exact ⟨by rw [map_zero]; exact (S0 F).zero_mem, fun h0 => absurd rfl h0⟩
              add_mem' := by
                intro G H hG hH m
                rw [Polynomial.coeff_add]
                refine ⟨by rw [map_add]; exact (S0 F).add_mem (hG m).1 (hH m).1, fun hne => ?_⟩
                by_cases h0 : G.coeff m = 0
                · rw [h0, zero_add] at hne; exact (hH m).2 hne
                · exact (hG m).2 h0
              zero_mem' := by
                intro m
                rw [Polynomial.coeff_zero, map_zero]
                exact ⟨(S0 F).zero_mem, fun h0 => absurd rfl h0⟩
              neg_mem' := by
                intro G hG m
                rw [Polynomial.coeff_neg, map_neg]
                exact ⟨(S0 F).neg_mem (hG m).1, fun hne => (hG m).2 (neg_ne_zero.mp hne)⟩ },
      fun G => Iff.rfl⟩
  choose T hT using s3

  have hS0mono : ∀ F F' : Subfield k, F ≤ F' → ∀ H, H ∈ S0 F → H ∈ S0 F' := by
    intro F F' h H hH
    rw [hS0] at hH ⊢
    exact fun e => ⟨h (hH e).1, (hH e).2⟩
  have hTmono : ∀ F F' : Subfield k, F ≤ F' → ∀ G, G ∈ T F → G ∈ T F' := by
    intro F F' h G hG
    rw [hT] at hG ⊢
    exact fun m => ⟨hS0mono F F' h _ (hG m).1, (hG m).2⟩

  have s16 : ∀ (A B : Type u) [CommRing A] [CommRing B] [Algebra A B], Module.Finite A B → ∀ (S : Subring A) (ι : Type) [Fintype ι] (t : ι → A), (∀ G : A, ∃ g : ι → A, (∀ i, g i ∈ S) ∧ G = ∑ i, g i * t i) → ∃ (κ : Type) (_ : Fintype κ) (t' : κ → B), ∀ b : B, ∃ c : κ → B, (∀ i, c i ∈ S.map (algebraMap A B)) ∧ b = ∑ i, c i * t' i := by
    intro A B _ _ _ hfin S ι _ t ht
    haveI := hfin
    obtain ⟨m, s, hs⟩ := Module.Finite.exists_fin (R := A) (M := B)
    choose g hgS hg using ht
    refine ⟨ι × Fin m, inferInstance, fun x => algebraMap A B (t x.1) * s x.2, fun b => ?_⟩
    have hb : b ∈ Submodule.span A (Set.range s) := by rw [hs]; trivial
    obtain ⟨a, ha⟩ := (Submodule.mem_span_range_iff_exists_fun A).mp hb
    refine ⟨fun x => algebraMap A B (g (a x.2) x.1), fun x => Subring.mem_map.mpr ⟨_, hgS _ x.1, rfl⟩, ?_⟩
    rw [← ha, Fintype.sum_prod_type_right]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [Algebra.smul_def]
    conv_lhs => rw [hg (a j)]
    rw [map_sum, Finset.sum_mul]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [map_mul]
    ring

  haveI hcA : CharP (MvPowerSeries (Fin n) k) p :=
    charP_of_injective_algebraMap (algebraMap k (MvPowerSeries (Fin n) k)).injective p
  haveI hcC : CharP C₀ p :=
    charP_of_injective_ringHom (f := (ψ.symm : MvPowerSeries (Fin n) k →+* C₀)) ψ.symm.injective p
  haveI : Nontrivial C₀ := ψ.symm.injective.nontrivial
  haveI : NoZeroDivisors C₀ :=
    Function.Injective.noZeroDivisors (fun c : C₀ => algebraMap (Polynomial C₀) B (Polynomial.C c))
      (hinj.comp Polynomial.C_injective) (by simp) (fun x y => by simp)
  haveI : IsDomain C₀ := NoZeroDivisors.to_isDomain C₀
  haveI : ExpChar (Polynomial C₀) p := ExpChar.prime hp
  haveI hcB : CharP B p := charP_of_injective_algebraMap hinj p
  haveI hcL : CharP (FractionRing B) p :=
    charP_of_injective_algebraMap (IsFractionRing.injective B (FractionRing B)) p
  haveI : ExpChar (FractionRing B) p := ExpChar.prime hp

  have s1 := wc_hnas_pfc_gcl_de_simple_ext
  have s2 := wc_hnas_pfc_gcl_de_exchange s1
  have C1 := wc_hnas_pfc_gcl_de_purely_insep_derivation s1 (wc_hnas_pfc_gcl_de_maximal_avoiding s2)
  have C3 := wc_hnas_pfc_gcl_de_compositum_intersection (wc_hnas_pfc_gcl_de_compositum_simple s1)
  have SAT := wc_hnas_pfc_gcl_de_frob_subring_saturated C1
  have PRC := wc_hnas_pfc_gcl_de_pth_root_of_saturated SAT wc_hnas_pfc_gcl_de_frobenius_coeff
  obtain ⟨P, hPfin, hPint⟩ := wc_hnas_pfc_gcl_de_p_basis s1 s2 p k hp

  obtain ⟨kJ, kpow, kanti, kint, kfd⟩ : ∃ kJ : Finset k → Subfield k,
      (∀ J (y : k), y ^ p ∈ kJ J) ∧ (∀ J J', J ⊆ J' → kJ J' ≤ kJ J) ∧
      (∀ c : k, (∀ J, c ∈ kJ J) → ∃ y : k, y ^ p = c) ∧ (∀ J, FiniteDimensional (kJ J) k) :=
    ⟨fun J => Subfield.closure (Set.range (fun y : k => y ^ p) ∪ (P \ (J : Set k))),
      fun J y => Subfield.subset_closure (Or.inl ⟨y, rfl⟩),
      fun J J' hJ => Subfield.closure_mono
        (Set.union_subset_union_right _ (Set.diff_subset_diff_right (Finset.coe_subset.mpr hJ))),
      hPint, hPfin⟩

  have hpowS : ∀ F : Subfield k, (∀ y : k, y ^ p ∈ F) → ∀ a : MvPowerSeries (Fin n) k, a ^ p ∈ S0 F := by
    intro F hF a
    rw [hS0]
    intro e
    obtain ⟨h1, h2⟩ := wc_hnas_pfc_gcl_de_frobenius_coeff p n k hp a
    by_cases hd : ∀ j, p ∣ e j
    · refine ⟨?_, fun _ => hd⟩
      have he : p • Finsupp.mapRange (fun m => m / p) (Nat.zero_div p) e = e := by
        ext j
        simp only [Finsupp.smul_apply, Finsupp.mapRange_apply, smul_eq_mul]
        exact Nat.mul_div_cancel' (hd j)
      rw [← he, h1]
      exact hF _
    · rw [h2 e hd]
      exact ⟨F.zero_mem, fun h0 => absurd rfl h0⟩

  have hmono : ∀ (F : Subfield k) (b : C₀) (a : ℕ), ψ b ∈ S0 F → p ∣ a →
      Polynomial.C b * Polynomial.X ^ a ∈ T F := by
    intro F b a hb ha
    rw [hT]
    intro m
    rw [Polynomial.coeff_C_mul_X_pow]
    split_ifs with h
    · exact ⟨hb, fun _ => by rw [h]; exact ha⟩
    · rw [map_zero]; exact ⟨(S0 F).zero_mem, fun h0 => absurd rfl h0⟩

  have hpowT : ∀ F : Subfield k, (∀ y : k, y ^ p ∈ F) → ∀ G : Polynomial C₀, G ^ p ∈ T F := by
    intro F hF G
    have hG := G.as_sum_support_C_mul_X_pow
    rw [hG, sum_pow_char]
    refine (T F).sum_mem fun m _ => ?_
    rw [mul_pow, ← Polynomial.C_pow, ← pow_mul]
    exact hmono F _ _ (by rw [map_pow]; exact hpowS F hF _) (dvd_mul_left p m)

  have hsat0 : ∀ F : Subfield k, (∀ y : k, y ^ p ∈ F) → ∀ d : Polynomial C₀, d ≠ 0 → d ∈ T F →
      ∀ (s : ℕ) (N : Polynomial C₀), N.support.card = s → N * d ∈ T F → N ∈ T F := by
    intro F hF d hd0 hdT s
    induction s using Nat.strong_induction_on with
    | _ s ih =>
      intro N hNs hNd
      by_cases hN0 : N = 0
      · rw [hN0]; exact (T F).zero_mem
      have hα : N.leadingCoeff ≠ 0 := Polynomial.leadingCoeff_ne_zero.mpr hN0
      have hβ : d.leadingCoeff ≠ 0 := Polynomial.leadingCoeff_ne_zero.mpr hd0
      have hαβ : N.leadingCoeff * d.leadingCoeff ≠ 0 := mul_ne_zero hα hβ
      have h1 := (hT F _).mp hNd (N.natDegree + d.natDegree)
      have h2 := (hT F _).mp hdT d.natDegree
      rw [Polynomial.coeff_mul_degree_add_degree] at h1
      have hpb : p ∣ d.natDegree := h2.2 hβ
      have hpab : p ∣ N.natDegree + d.natDegree := h1.2 hαβ
      have hpa : p ∣ N.natDegree := by
        rw [add_comm] at hpab
        exact (Nat.dvd_add_right hpb).mp hpab
      have hψβ : ψ d.leadingCoeff ≠ 0 := by
        intro h
        apply hβ
        exact ψ.injective (h.trans (map_zero ψ).symm)
      have hlcN : ψ N.leadingCoeff ∈ S0 F := by
        rw [hS0]
        refine SAT p n k hp F hF (ψ d.leadingCoeff) (ψ N.leadingCoeff) hψβ ((hS0 F _).mp h2.1) ?_
        rw [← map_mul]
        exact (hS0 F _).mp h1.1
      have hM : Polynomial.C N.leadingCoeff * Polynomial.X ^ N.natDegree ∈ T F :=
        hmono F _ _ hlcN hpa
      have hsplit := N.eraseLead_add_C_mul_X_pow
      have hE : N.eraseLead * d ∈ T F := by
        have e : N.eraseLead * d =
            N * d - (Polynomial.C N.leadingCoeff * Polynomial.X ^ N.natDegree) * d := by
          rw [eq_sub_iff_add_eq, ← add_mul, hsplit]
        rw [e]
        exact (T F).sub_mem hNd ((T F).mul_mem hM hdT)
      have hcard : N.eraseLead.support.card < s := by
        rw [Polynomial.card_support_eraseLead, ← hNs]
        have : N.support.card ≠ 0 := fun h => hN0 (Polynomial.card_support_eq_zero.mp h)
        omega
      have hEr : N.eraseLead ∈ T F := ih _ hcard N.eraseLead rfl hE
      rw [← hsplit]
      exact (T F).add_mem hEr hM
  have hsat : ∀ F : Subfield k, (∀ y : k, y ^ p ∈ F) → ∀ d : Polynomial C₀, d ≠ 0 → d ∈ T F →
      ∀ N : Polynomial C₀, N * d ∈ T F → N ∈ T F :=
    fun F hF d hd hdT N hNd => hsat0 F hF d hd hdT _ N rfl hNd

  have hroot : ∀ (ι : Type u) [Nonempty ι] (Fi : ι → Subfield k), (∀ i, ∀ y : k, y ^ p ∈ Fi i) →
      (∀ c : k, (∀ i, c ∈ Fi i) → ∃ y : k, y ^ p = c) → ∀ N : Polynomial C₀,
      (∀ i, N ∈ T (Fi i)) → ∃ M : Polynomial C₀, M ^ p = N := by
    intro ι _ Fi hFpow hFint N hN
    have hR : ∀ m, ∃ R : MvPowerSeries (Fin n) k, R ^ p = ψ (N.coeff m) := by
      intro m
      refine PRC p n k hp ι Fi hFpow hFint (ψ (N.coeff m)) fun i =>
        ⟨1, one_ne_zero, (hS0 (Fi i) 1).mp (S0 (Fi i)).one_mem, ?_⟩
      rw [mul_one]
      exact (hS0 _ _).mp ((hT _ _).mp (hN i) m).1
    choose R hR using hR
    obtain ⟨i0⟩ := ‹Nonempty ι›
    have hdiv : ∀ m ∈ N.support, p ∣ m := fun m hm =>
      ((hT _ _).mp (hN i0) m).2 (Polynomial.mem_support_iff.mp hm)
    refine ⟨∑ m ∈ N.support, Polynomial.C (ψ.symm (R m)) * Polynomial.X ^ (m / p), ?_⟩
    rw [sum_pow_char]
    conv_rhs => rw [N.as_sum_support_C_mul_X_pow]
    refine Finset.sum_congr rfl fun m hm => ?_
    rw [mul_pow, ← Polynomial.C_pow, ← pow_mul, ← map_pow, hR, RingEquiv.symm_apply_apply,
      Nat.div_mul_cancel (hdiv m hm)]

  have hfinT : ∀ F : Subfield k, FiniteDimensional F k → ∃ (ι : Type) (_ : Fintype ι)
      (t : ι → Polynomial C₀), ∀ G : Polynomial C₀, ∃ g : ι → Polynomial C₀,
      (∀ i, g i ∈ T F) ∧ G = ∑ i, g i * t i := by
    intro F hFd
    obtain ⟨ι, _, t, ht⟩ := wc_hnas_pfc_gcl_de_power_series_finite p n k hp F hFd
    choose g0 hg0 hG0 using ht
    obtain ⟨r0, hr0⟩ : ∃ r0 : ℕ → Fin p, ∀ m, (r0 m : ℕ) = m % p :=
      ⟨fun m => ⟨m % p, Nat.mod_lt m hp.pos⟩, fun _ => rfl⟩
    refine ⟨ι × Fin p, inferInstance,
      fun x => Polynomial.C (ψ.symm (t x.1)) * Polynomial.X ^ (x.2 : ℕ), fun G => ?_⟩
    obtain ⟨A, hA⟩ : ∃ A : ℕ → ι → Polynomial C₀, ∀ m i,
        A m i = Polynomial.C (ψ.symm (g0 (ψ (G.coeff m)) i)) * Polynomial.X ^ (m / p * p) :=
      ⟨_, fun _ _ => rfl⟩
    refine ⟨fun x => ∑ m ∈ G.support, if r0 m = x.2 then A m x.1 else 0, fun x => ?_, ?_⟩
    · refine (T F).sum_mem fun m _ => ?_
      split_ifs
      · rw [hA]
        exact hmono F _ _ (by rw [RingEquiv.apply_symm_apply, hS0]; exact hg0 _ x.1)
          (dvd_mul_left p _)
      · exact (T F).zero_mem
    · have hm : ∀ m, Polynomial.C (G.coeff m) * Polynomial.X ^ m =
          ∑ i, A m i * (Polynomial.C (ψ.symm (t i)) * Polynomial.X ^ ((r0 m : Fin p) : ℕ)) := by
        intro m
        have e1 : G.coeff m = ∑ i, ψ.symm (g0 (ψ (G.coeff m)) i) * ψ.symm (t i) := by
          have := congrArg ψ.symm (hG0 (ψ (G.coeff m)))
          rw [RingEquiv.symm_apply_apply, map_sum] at this
          simpa only [map_mul] using this
        have e2 : (Polynomial.X : Polynomial C₀) ^ m =
            Polynomial.X ^ (m / p * p) * Polynomial.X ^ (m % p) := by
          rw [← pow_add, Nat.div_add_mod']
        conv_lhs => rw [e1, e2]
        rw [map_sum, Finset.sum_mul]
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [map_mul, hA, hr0]
        ring
      calc G = ∑ m ∈ G.support, Polynomial.C (G.coeff m) * Polynomial.X ^ m :=
            G.as_sum_support_C_mul_X_pow
        _ = ∑ m ∈ G.support, ∑ i, A m i *
              (Polynomial.C (ψ.symm (t i)) * Polynomial.X ^ ((r0 m : Fin p) : ℕ)) :=
            Finset.sum_congr rfl fun m _ => hm m
        _ = ∑ m ∈ G.support, ∑ x : ι × Fin p, if r0 m = x.2 then A m x.1 *
              (Polynomial.C (ψ.symm (t x.1)) * Polynomial.X ^ (x.2 : ℕ)) else 0 := by
          refine Finset.sum_congr rfl fun m _ => ?_
          rw [Fintype.sum_prod_type]
          refine Finset.sum_congr rfl fun i _ => ?_
          rw [Finset.sum_eq_single (r0 m)]
          · simp
          · intro r _ hr
            simp [Ne.symm hr]
          · intro h
            exact absurd (Finset.mem_univ _) h
        _ = _ := by
          rw [Finset.sum_comm]
          refine Finset.sum_congr rfl fun x _ => ?_
          dsimp only
          rw [Finset.sum_mul]
          refine Finset.sum_congr rfl fun m _ => ?_
          rw [ite_mul, zero_mul]

  obtain ⟨φ, hφ⟩ : ∃ φ : Polynomial C₀ →+* FractionRing B,
      ∀ a, φ a = algebraMap B (FractionRing B) (algebraMap (Polynomial C₀) B a) :=
    ⟨(algebraMap B (FractionRing B)).comp (algebraMap (Polynomial C₀) B), fun _ => rfl⟩
  have hφinj : Function.Injective φ := by
    intro a b hab
    rw [hφ, hφ] at hab
    exact hinj (IsFractionRing.injective B (FractionRing B) hab)

  obtain ⟨F, hF⟩ : ∃ F : Finset k → Subfield (FractionRing B), ∀ J,
      F J = Subfield.closure (φ '' (T (kJ J) : Set (Polynomial C₀))) := ⟨_, fun _ => rfl⟩

  have hK0fd : FiniteDimensional (Subfield.closure (Set.range φ)) (FractionRing B) := by
    obtain ⟨κ, _, t', ht'⟩ := s16 (Polynomial C₀) B hfin ⊤ Unit (fun _ => 1)
      (fun G => ⟨fun _ => G, fun _ => Subring.mem_top _, by simp⟩)
    have h14 := wc_hnas_pfc_gcl_de_fraction_field_finite B _ κ t' ht'
    have hset : (algebraMap B (FractionRing B)) ''
        ((Subring.map (algebraMap (Polynomial C₀) B) ⊤ : Subring B) : Set B) =
        Set.range φ := by
      ext x
      simp only [Set.mem_image, SetLike.mem_coe, Subring.mem_map, Subring.mem_top, true_and,
        Set.mem_range]
      constructor
      · rintro ⟨b, ⟨a, rfl⟩, rfl⟩
        exact ⟨a, hφ a⟩
      · rintro ⟨a, rfl⟩
        exact ⟨_, ⟨a, rfl⟩, (hφ a).symm⟩
    rw [hset] at h14
    exact h14

  have hFle : ∀ J, F J ≤ Subfield.closure (Set.range φ) := by
    intro J
    rw [hF]
    exact Subfield.closure_mono (Set.image_subset_range _ _)
  have hFpow : ∀ J, ∀ y ∈ Subfield.closure (Set.range φ), y ^ p ∈ F J := by
    intro J y hy
    have hle : Subfield.closure (Set.range φ) ≤ (F J).comap (frobenius (FractionRing B) p) := by
      rw [Subfield.closure_le]
      rintro _ ⟨a, rfl⟩
      show frobenius (FractionRing B) p (φ a) ∈ F J
      rw [frobenius_def, ← map_pow, hF]
      exact Subfield.subset_closure ⟨a ^ p, hpowT (kJ J) (kpow J) a, rfl⟩
    have := hle hy
    rwa [Subfield.mem_comap, frobenius_def] at this
  have hdir : ∀ J J', ∃ l, F l ≤ F J ⊓ F J' := by
    intro J J'
    refine ⟨J ∪ J', le_inf ?_ ?_⟩
    · rw [hF, hF]
      exact Subfield.closure_mono (Set.image_mono fun G hG =>
        hTmono _ _ (kanti J (J ∪ J') Finset.subset_union_left) G hG)
    · rw [hF, hF]
      exact Subfield.closure_mono (Set.image_mono fun G hG =>
        hTmono _ _ (kanti J' (J ∪ J') Finset.subset_union_right) G hG)

  have hint : ∀ x ∈ Subfield.closure (Set.range φ), (∀ J, x ∈ F J) →
      ∃ y ∈ Subfield.closure (Set.range φ), y ^ p = x := by
    intro x hx hJ
    by_cases hx0 : x = 0
    · exact ⟨0, Subfield.zero_mem _, by rw [hx0, zero_pow hp.ne_zero]⟩
    have rep : ∀ S : Subring (Polynomial C₀),
        x ∈ Subfield.closure ((S.map φ : Subring (FractionRing B)) : Set (FractionRing B)) →
        ∃ u ∈ S, ∃ v ∈ S, φ v ≠ 0 ∧ x = φ u / φ v := by
      intro S hS
      rw [Subfield.mem_closure_iff, Subring.closure_eq] at hS
      obtain ⟨y', hy', z, hz, hyz⟩ := hS
      obtain ⟨u, hu, rfl⟩ := Subring.mem_map.mp hy'
      obtain ⟨v, hv, rfl⟩ := Subring.mem_map.mp hz
      refine ⟨u, hu, v, hv, ?_, hyz.symm⟩
      intro h0
      apply hx0
      rw [← hyz, h0, div_zero]
    have hrange : Set.range φ =
        (((⊤ : Subring (Polynomial C₀)).map φ : Subring (FractionRing B)) : Set (FractionRing B)) := by
      rw [Subring.coe_map, Subring.coe_top, Set.image_univ]
    rw [hrange] at hx
    obtain ⟨a, -, b, -, hb0, hxab⟩ := rep ⊤ hx
    have hpp1 : p - 1 + 1 = p := Nat.sub_add_cancel hp.one_lt.le
    have hφbp : (φ b) ^ p = (φ b) ^ (p - 1) * φ b := by rw [← pow_succ, hpp1]
    have hbp : b ^ p = b ^ (p - 1) * b := by rw [← pow_succ, hpp1]
    obtain ⟨N, hN⟩ : ∃ N : Polynomial C₀, N = a * b ^ (p - 1) := ⟨_, rfl⟩
    have hxN : x = φ N / (φ b) ^ p := by
      rw [hxab, div_eq_div_iff hb0 (pow_ne_zero _ hb0), hN, map_mul, map_pow, hφbp]
      ring
    have hNT : ∀ J, N ∈ T (kJ J) := by
      intro J
      have hxi := hJ J
      rw [hF, ← Subring.coe_map] at hxi
      obtain ⟨u, hu, v, hv, hv0, hxuv⟩ := rep _ hxi
      have huv : u * b = a * v := by
        apply hφinj
        rw [map_mul, map_mul]
        rw [hxuv] at hxab
        exact (div_eq_div_iff hv0 hb0).mp hxab
      have hbS : b ^ p ∈ T (kJ J) := hpowT _ (kpow J) b
      have hNv : N * v = u * b ^ p := by
        rw [hN, hbp]
        calc a * b ^ (p - 1) * v = (a * v) * b ^ (p - 1) := by ring
          _ = (u * b) * b ^ (p - 1) := by rw [huv]
          _ = u * (b ^ (p - 1) * b) := by ring
      have hv0' : v ≠ 0 := fun h => hv0 (by rw [h, map_zero])
      exact hsat (kJ J) (kpow J) v hv0' hv N (by rw [hNv]; exact (T _).mul_mem hu hbS)
