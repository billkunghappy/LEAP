import WeilR2_Part03
set_option maxHeartbeats 4000000

open CategoryTheory AlgebraicGeometry

theorem wc_hnas_completion_noetherian : ∀ (P : Type u) [CommRing P] [IsLocalRing P] [IsNoetherianRing P], IsNoetherianRing (AdicCompletion (IsLocalRing.maximalIdeal P) P) :=
by
  intro P _ _ _
  classical
  obtain ⟨r, x, hx⟩ := Submodule.fg_iff_exists_fin_generating_family.mp
    (IsNoetherian.noetherian (IsLocalRing.maximalIdeal P))
  set I := IsLocalRing.maximalIdeal P with hI
  have hxI : ∀ i, x i ∈ I := fun i => hx ▸ Ideal.subset_span ⟨i, rfl⟩

  have H2 : ∀ (n : ℕ) (q : MvPolynomial (Fin r) P),
      (∀ d : Fin r →₀ ℕ, d.degree < n → q.coeff d = 0) → MvPolynomial.eval x q ∈ I ^ n := by
    intro n q hq
    rw [MvPolynomial.eval_eq']
    refine Ideal.sum_mem _ (fun d hd => ?_)
    have hdeg : n ≤ d.degree := by
      by_contra h
      exact (MvPolynomial.mem_support_iff.mp hd) (hq d (not_le.mp h))
    apply Ideal.mul_mem_left
    have h1 : ∏ i, x i ^ d i ∈ ∏ i, I ^ d i :=
      Ideal.prod_mem_prod (fun i _ => Ideal.pow_mem_pow (hxI i) _)
    rw [Finset.prod_pow_eq_pow_sum, ← Finsupp.degree_eq_sum] at h1
    exact Ideal.pow_le_pow_right hdeg h1

  have HC : ∀ (n : ℕ) (p q : MvPolynomial (Fin r) P),
      (∀ d : Fin r →₀ ℕ, d.degree < n → p.coeff d = q.coeff d) →
      Ideal.Quotient.mk (I ^ n) (MvPolynomial.eval x p) =
        Ideal.Quotient.mk (I ^ n) (MvPolynomial.eval x q) := by
    intro n p q h
    rw [Ideal.Quotient.eq, ← map_sub]
    exact H2 n (p - q) (fun d hd => by rw [MvPolynomial.coeff_sub, h d hd, sub_self])

  have H3' : ∀ (n : ℕ) (y : P), y ∈ Ideal.span (Set.range x) ^ n →
      ∃ h : MvPolynomial (Fin r) P, h.IsHomogeneous n ∧ MvPolynomial.eval x h = y := by
    intro n
    induction n with
    | zero =>
      intro y _
      exact ⟨MvPolynomial.C y, MvPolynomial.isHomogeneous_C _ _, MvPolynomial.eval_C _⟩
    | succ n ih =>
      intro y hy
      rw [pow_succ] at hy
      refine Submodule.mul_induction_on hy ?_ ?_
      · intro a ha b hb
        obtain ⟨ha', hah, hae⟩ := ih a ha
        obtain ⟨c, hc⟩ := Ideal.mem_span_range_iff_exists_fun.mp hb
        refine ⟨ha' * ∑ i, MvPolynomial.C (c i) * MvPolynomial.X i, ?_, ?_⟩
        · apply hah.mul
          apply MvPolynomial.IsHomogeneous.sum
          intro i _
          have := (MvPolynomial.isHomogeneous_C (Fin r) (c i)).mul
            (MvPolynomial.isHomogeneous_X P i)
          rwa [zero_add] at this
        · simp only [map_mul, map_sum, MvPolynomial.eval_C, MvPolynomial.eval_X, hae, hc]
      · rintro _ _ ⟨h1, hh1, he1⟩ ⟨h2, hh2, he2⟩
        exact ⟨h1 + h2, hh1.add hh2, by rw [map_add, he1, he2]⟩
  have H3 : ∀ (n : ℕ) (y : P), y ∈ I ^ n →
      ∃ h : MvPolynomial (Fin r) P, h.IsHomogeneous n ∧ MvPolynomial.eval x h = y := by
    intro n y hy
    rw [← hx] at hy
    exact H3' n y hy

  let f : (n : ℕ) → MvPowerSeries (Fin r) P →+* P ⧸ I ^ n := fun n =>
    { toFun := fun F => Ideal.Quotient.mk (I ^ n) (MvPolynomial.eval x (MvPowerSeries.truncTotal n F))
      map_one' := by
        rw [← map_one (Ideal.Quotient.mk (I ^ n)), ← map_one (MvPolynomial.eval x)]
        apply HC
        intro d hd
        rw [MvPowerSeries.coeff_truncTotal _ hd, MvPowerSeries.coeff_one, MvPolynomial.coeff_one]
        by_cases h : d = 0
        · subst h; simp
        · simp [h, Ne.symm h]
      map_mul' := by
        intro F G
        rw [← map_mul, ← map_mul]
        apply HC
        intro d hd
        rw [MvPowerSeries.coeff_truncTotal _ hd, MvPowerSeries.coeff_mul, MvPolynomial.coeff_mul]
        refine Finset.sum_congr rfl (fun p hp => ?_)
        have hp' := Finset.HasAntidiagonal.mem_antidiagonal.mp hp
        have h1 : p.1.degree + p.2.degree = d.degree := by
          rw [← hp', Finsupp.degree_eq_sum, Finsupp.degree_eq_sum, Finsupp.degree_eq_sum,
            ← Finset.sum_add_distrib]
          rfl
        rw [MvPowerSeries.coeff_truncTotal _ (by omega), MvPowerSeries.coeff_truncTotal _ (by omega)]
      map_zero' := by simp
      map_add' := by intro F G; simp }
  have hf : ∀ {m n : ℕ} (hle : m ≤ n), (Ideal.Quotient.factorPow I hle).comp (f n) = f m := by
    intro m n hle
    refine RingHom.ext (fun F => ?_)
    have hfp : ∀ y : P, Ideal.Quotient.factorPow I hle (Ideal.Quotient.mk (I ^ n) y) =
        Ideal.Quotient.mk (I ^ m) y := fun y => rfl
    show Ideal.Quotient.factorPow I hle (Ideal.Quotient.mk (I ^ n)
        (MvPolynomial.eval x (MvPowerSeries.truncTotal n F))) =
      Ideal.Quotient.mk (I ^ m) (MvPolynomial.eval x (MvPowerSeries.truncTotal m F))
    rw [hfp]
    apply HC
    intro d hd
    rw [MvPowerSeries.coeff_truncTotal _ hd,
      MvPowerSeries.coeff_truncTotal _ (lt_of_lt_of_le hd hle)]
  set Ψ := AdicCompletion.liftRingHom I f hf with hΨdef
  have hΨ : ∀ (n : ℕ) (F : MvPowerSeries (Fin r) P), AdicCompletion.evalₐ I n (Ψ F) =
      Ideal.Quotient.mk (I ^ n) (MvPolynomial.eval x (MvPowerSeries.truncTotal n F)) := by
    intro n F
    rw [hΨdef, AdicCompletion.evalₐ_liftRingHom]
    rfl

  have hsurj : Function.Surjective Ψ := by
    intro b
    obtain ⟨a, rfl⟩ := AdicCompletion.mk_surjective I P b
    have ha : ∀ m n, m ≤ n → (a : ℕ → P) n - (a : ℕ → P) m ∈ I ^ m := by
      intro m n hmn
      have := AdicCompletion.AdicCauchySequence.mk_eq_mk hmn a
      rw [Submodule.Quotient.eq] at this
      simpa [Ideal.smul_eq_mul, Ideal.mul_top] using this
    let c : ℕ → P := fun k => if k = 0 then 0 else (a : ℕ → P) k
    have hc : ∀ k, c (k + 1) - c k ∈ I ^ k := by
      intro k
      rcases Nat.eq_zero_or_pos k with rfl | hk
      · simp
      · simp only [c, if_neg (Nat.succ_ne_zero k), if_neg hk.ne']
        exact ha k (k + 1) (Nat.le_succ k)
    choose h hh he using fun k => H3 k _ (hc k)
    let F : MvPowerSeries (Fin r) P := fun e => (h e.degree).coeff e
    refine ⟨F, ?_⟩
    apply AdicCompletion.ext_evalₐ
    intro n
    rw [hΨ, AdicCompletion.evalₐ_mk]
    have e1 : Ideal.Quotient.mk (I ^ n) (MvPolynomial.eval x (MvPowerSeries.truncTotal n F)) =
        Ideal.Quotient.mk (I ^ n) (MvPolynomial.eval x (∑ k ∈ Finset.range n, h k)) := by
      apply HC
      intro d hd
      rw [MvPowerSeries.coeff_truncTotal _ hd, MvPolynomial.coeff_sum,
        Finset.sum_eq_single_of_mem d.degree (Finset.mem_range.mpr hd)]
      · rfl
      · intro k _ hk
        exact (hh k).coeff_eq_zero (Ne.symm hk)
    rw [e1, map_sum]
    simp only [he]
    rw [Finset.sum_range_sub]
    have hc0 : c 0 = 0 := by simp [c]
    rw [hc0, sub_zero]
    rcases Nat.eq_zero_or_pos n with rfl | hn
    · rw [Ideal.Quotient.eq]; simp
    · simp only [c, if_neg hn.ne']
  have : IsNoetherianRing (MvPowerSeries (Fin r) P) := MvPowerSeries.isNoetherianRing P
  exact isNoetherianRing_of_surjective (MvPowerSeries (Fin r) P) _ Ψ hsurj

theorem wc_hnas_smooth_section_henselian : ∀ (H : Type u) [CommRing H] [HenselianLocalRing H] (D : Type u) [CommRing D] [Algebra H D] [Algebra.Smooth H D] (σ : D →ₐ[H] IsLocalRing.ResidueField H), ∃ τ : D →ₐ[H] H, ∀ x : D, IsLocalRing.residue H (τ x) = σ x :=
by
  intro H _ _ D _ _ _ σ
  classical

  have hetale : ∀ (E : Type u) [CommRing E] [Algebra H E] [Algebra.Etale H E]
      (σ : E →ₐ[H] IsLocalRing.ResidueField H), ∃ τ : E →ₐ[H] H,
        ∀ x : E, IsLocalRing.residue H (τ x) = σ x := by
    intro E _ _ _ σ
    haveI hq : (RingHom.ker σ).IsPrime := RingHom.ker_isPrime σ
    haveI : Algebra.FormallyEtale E (Localization.AtPrime (RingHom.ker σ)) :=
      Algebra.FormallyEtale.of_isLocalization (RingHom.ker σ).primeCompl
    haveI : Algebra.IsEtaleAt H (RingHom.ker σ) :=
      Algebra.FormallyEtale.comp H E (Localization.AtPrime (RingHom.ker σ))
    obtain ⟨g, hg, hstd⟩ := Algebra.IsEtaleAt.exists_isStandardEtale (R := H) (RingHom.ker σ)
    have hσg : IsUnit (σ g) := isUnit_iff_ne_zero.mpr (fun h => hg (RingHom.mem_ker.mpr h))
    let σg : Localization.Away g →ₐ[H] IsLocalRing.ResidueField H :=
      IsLocalization.Away.liftAlgHom g hσg
    have hσg_apply : ∀ y : E, σg (algebraMap E (Localization.Away g) y) = σ y := by
      intro y
      rw [IsLocalization.Away.liftAlgHom_apply, IsLocalization.Away.lift_eq]
      rfl
    obtain ⟨Q⟩ := hstd.nonempty_standardEtalePresentation
    let e : Q.Ring ≃ₐ[H] Localization.Away g :=
      AlgEquiv.ofBijective (Q.lift Q.x Q.hasMap) Q.lift_bijective
    have heX : e Q.X = Q.x := by
      rw [AlgEquiv.ofBijective_apply]
      exact Q.lift_X _ _
    set a₀ := σg Q.x with ha₀
    have hf0 : Polynomial.aeval a₀ Q.f = 0 := by
      rw [ha₀, Polynomial.aeval_algHom_apply, Q.hasMap.1, map_zero]
    have hf' : Polynomial.aeval a₀ (Polynomial.derivative Q.f) ≠ 0 := by
      rw [ha₀, Polynomial.aeval_algHom_apply]
      exact ((StandardEtalePair.HasMap.isUnit_derivative_f Q.P Q.hasMap).map σg).ne_zero
    have hg0 : Polynomial.aeval a₀ Q.g ≠ 0 := by
      rw [ha₀, Polynomial.aeval_algHom_apply]
      exact (Q.hasMap.2.map σg).ne_zero
    have hHen := ((HenselianLocalRing.TFAE H).out 1 2).mp (inferInstance : HenselianLocalRing H)
    obtain ⟨a, hroot, hres⟩ := hHen Q.f Q.monic_f a₀ hf0 hf'
    have hres' : ∀ p : Polynomial H,
        IsLocalRing.residue H (Polynomial.aeval a p) = Polynomial.aeval a₀ p := by
      intro p
      rw [← hres, ← IsLocalRing.ResidueField.algebraMap_eq, ← Algebra.ofId_apply,
        ← Algebra.ofId_apply, ← Polynomial.aeval_algHom_apply]
    have hHas : Q.HasMap a := by
      refine ⟨?_, ?_⟩
      · rw [Polynomial.coe_aeval_eq_eval]
        exact hroot
      · rw [← IsLocalRing.residue_ne_zero_iff_isUnit, hres']
        exact hg0
    have hcomp : (Algebra.ofId H (IsLocalRing.ResidueField H)).comp (Q.lift a hHas) =
        σg.comp (e : Q.Ring →ₐ[H] Localization.Away g) := by
      apply StandardEtalePair.hom_ext
      rw [AlgHom.comp_apply, AlgHom.comp_apply, Q.lift_X, AlgEquiv.coe_toAlgHom, heX,
        Algebra.ofId_apply, IsLocalRing.ResidueField.algebraMap_eq, hres]
    refine ⟨((Q.lift a hHas).comp (e.symm : Localization.Away g →ₐ[H] Q.Ring)).comp
      (IsScalarTower.toAlgHom H E (Localization.Away g)), fun y => ?_⟩
    have h1 := congrArg (fun φ => φ (e.symm (algebraMap E (Localization.Away g) y))) hcomp
    simp only [AlgHom.comp_apply, AlgEquiv.coe_toAlgHom, AlgEquiv.apply_symm_apply,
      Algebra.ofId_apply, IsLocalRing.ResidueField.algebraMap_eq] at h1
    rw [AlgHom.comp_apply, AlgHom.comp_apply, IsScalarTower.coe_toAlgHom',
      AlgEquiv.coe_toAlgHom, h1, hσg_apply]

  have hhalg : ∀ (κ : Type) [Fintype κ] [DecidableEq κ] (F : κ → MvPolynomial κ H),
      Algebra.Etale H (MvPolynomial (κ ⊕ Unit) H ⧸ Ideal.span (Set.range (Sum.elim
        (fun j => MvPolynomial.rename Sum.inl (F j)) (fun _ : Unit => MvPolynomial.X (Sum.inr ()) *
          MvPolynomial.rename Sum.inl (Matrix.det (Matrix.of fun j k =>
            MvPolynomial.pderiv k (F j))) - 1)))) := by
    intro κ _ _ F
    set Δ : MvPolynomial κ H := Matrix.det (Matrix.of fun j k => MvPolynomial.pderiv k (F j))
      with hΔ
    set rel : κ ⊕ Unit → MvPolynomial (κ ⊕ Unit) H := Sum.elim
      (fun j => MvPolynomial.rename Sum.inl (F j))
      (fun _ : Unit => MvPolynomial.X (Sum.inr ()) * MvPolynomial.rename Sum.inl Δ - 1) with hrel
    let P₀ : Algebra.Presentation H (MvPolynomial (κ ⊕ Unit) H ⧸ Ideal.span (Set.range rel))
      (κ ⊕ Unit) (κ ⊕ Unit) := Algebra.Presentation.naive (v := rel)
    have hP₀rel : P₀.relation = rel := Algebra.Presentation.naive_relation _ _
    let P' : Algebra.PreSubmersivePresentation H
        (MvPolynomial (κ ⊕ Unit) H ⧸ Ideal.span (Set.range rel)) (κ ⊕ Unit) (κ ⊕ Unit) :=
      { toPresentation := P₀, map := id, map_inj := Function.injective_id }
    have hzero : ∀ p : MvPolynomial κ H,
        MvPolynomial.pderiv (Sum.inr () : κ ⊕ Unit) (MvPolynomial.rename Sum.inl p) = 0 := by
      intro p
      induction p using MvPolynomial.induction_on with
      | C a => rw [MvPolynomial.rename_C, MvPolynomial.pderiv_C]
      | add p q hp hq => rw [map_add, map_add, hp, hq, add_zero]
      | mul_X p n hp =>
        rw [map_mul, MvPolynomial.rename_X, MvPolynomial.pderiv_mul, hp,
          MvPolynomial.pderiv_X_of_ne (by simp), zero_mul, mul_zero, add_zero]
    have hJ : P'.jacobiMatrix = Matrix.fromBlocks
        (Matrix.of fun k j => MvPolynomial.rename Sum.inl (MvPolynomial.pderiv k (F j)))
        (Matrix.of fun k (_ : Unit) => MvPolynomial.pderiv (Sum.inl k) (rel (Sum.inr ()))) 0
        (Matrix.of fun (_ : Unit) (_ : Unit) => MvPolynomial.rename Sum.inl Δ) := by
      apply Matrix.ext
      intro i j
      rw [P'.jacobiMatrix_apply]
      show MvPolynomial.pderiv i (P₀.relation j) = _
      rw [hP₀rel]
      rcases i with k | ⟨⟩ <;> rcases j with j | ⟨⟩
      · rw [Matrix.fromBlocks_apply₁₁, Matrix.of_apply]
        simp only [hrel, Sum.elim_inl]
        exact MvPolynomial.pderiv_rename Sum.inl_injective k (F j)
      · rw [Matrix.fromBlocks_apply₁₂, Matrix.of_apply]
      · rw [Matrix.fromBlocks_apply₂₁, Matrix.zero_apply]
        simp only [hrel, Sum.elim_inl]
        exact hzero _
      · rw [Matrix.fromBlocks_apply₂₂, Matrix.of_apply]
        simp only [hrel, Sum.elim_inr]
        rw [map_sub, MvPolynomial.pderiv_mul, MvPolynomial.pderiv_X_self, hzero,
          Derivation.map_one_eq_zero, one_mul, mul_zero, add_zero, sub_zero]
    have hdet : P'.jacobiMatrix.det =
        MvPolynomial.rename Sum.inl Δ * MvPolynomial.rename Sum.inl Δ := by
      have hA : (Matrix.of fun k j => (MvPolynomial.rename (Sum.inl : κ → κ ⊕ Unit) :
            MvPolynomial κ H →ₐ[H] MvPolynomial (κ ⊕ Unit) H) (MvPolynomial.pderiv k (F j))) =
          ((MvPolynomial.rename (Sum.inl : κ → κ ⊕ Unit) :
            MvPolynomial κ H →ₐ[H] MvPolynomial (κ ⊕ Unit) H).mapMatrix
              (Matrix.of fun j k => MvPolynomial.pderiv k (F j))).transpose := by
        apply Matrix.ext
        intro k j
        rfl
      rw [hJ, Matrix.det_fromBlocks_zero₂₁, hA, Matrix.det_transpose, ← AlgHom.map_det, ← hΔ,
        Matrix.det_unique (Matrix.of fun (_ : Unit) (_ : Unit) => MvPolynomial.rename Sum.inl Δ),
        Matrix.of_apply]
    have hunit : IsUnit P'.jacobian := by
      rw [P'.jacobian_eq_jacobiMatrix_det, hdet, Algebra.Generators.algebraMap_apply, map_mul]
      have h : MvPolynomial.aeval P₀.val
          (MvPolynomial.X (Sum.inr ()) * MvPolynomial.rename Sum.inl Δ - 1) = 0 :=
        P₀.aeval_val_relation (Sum.inr ())
      rw [map_sub, map_mul, map_one, sub_eq_zero] at h
      have hu : IsUnit (MvPolynomial.aeval P₀.val (MvPolynomial.rename Sum.inl Δ)) :=
        isUnit_of_mul_isUnit_right (by rw [h]; exact isUnit_one)
      exact hu.mul hu
    let P : Algebra.SubmersivePresentation H
        (MvPolynomial (κ ⊕ Unit) H ⧸ Ideal.span (Set.range rel)) (κ ⊕ Unit) (κ ⊕ Unit) :=
      { toPreSubmersivePresentation := P', jacobian_isUnit := hunit }
    rw [Algebra.Etale.iff_isStandardSmoothOfRelativeDimension_zero]
    exact ⟨⟨κ ⊕ Unit, κ ⊕ Unit, inferInstance, inferInstance, P, Nat.sub_self _⟩⟩

  have hfreeze : ∀ (κ ι : Type) (m : κ → ι), Function.Injective m → ∀ (w : ι → H) (k : κ)
      (p : MvPolynomial ι H), MvPolynomial.pderiv k (MvPolynomial.aeval
        (Function.extend m MvPolynomial.X (fun i => MvPolynomial.C (w i))) p) =
      MvPolynomial.aeval (Function.extend m MvPolynomial.X (fun i => MvPolynomial.C (w i)))
        (MvPolynomial.pderiv (m k) p) := by
    intro κ ι m hm w k p
    induction p using MvPolynomial.induction_on with
    | C a => simp
    | add p q hp hq => simp only [map_add, hp, hq]
    | mul_X p n hp =>
      rw [map_mul, MvPolynomial.pderiv_mul, hp, MvPolynomial.pderiv_mul, map_add, map_mul, map_mul,
        MvPolynomial.aeval_X]
      congr 2
      by_cases hn : ∃ k', m k' = n
      · obtain ⟨k', rfl⟩ := hn
        rw [hm.extend_apply, MvPolynomial.pderiv_X, MvPolynomial.pderiv_X]
        by_cases hk : k = k'
        · subst hk; simp
        · have : m k ≠ m k' := fun h => hk (hm h)
          simp [Ne.symm hk, Ne.symm this]
      · rw [Function.extend_apply' _ _ _ hn, MvPolynomial.pderiv_C,
          MvPolynomial.pderiv_X_of_ne (fun h => hn ⟨k, h.symm⟩), map_zero]

  have hmv : ∀ (κ : Type) [Fintype κ] [DecidableEq κ] (F : κ → MvPolynomial κ H) (a₀ : κ → H),
      (∀ j, MvPolynomial.eval a₀ (F j) ∈ IsLocalRing.maximalIdeal H) →
      IsUnit (Matrix.det (Matrix.of fun j k => MvPolynomial.eval a₀ (MvPolynomial.pderiv k (F j)))) →
      ∃ a : κ → H, (∀ j, MvPolynomial.eval a (F j) = 0) ∧
        ∀ k, a k - a₀ k ∈ IsLocalRing.maximalIdeal H := by
    intro κ _ _ F a₀ hF hdet
    set Δ : MvPolynomial κ H := Matrix.det (Matrix.of fun j k => MvPolynomial.pderiv k (F j))
      with hΔ
    set rel : κ ⊕ Unit → MvPolynomial (κ ⊕ Unit) H := Sum.elim
      (fun j => MvPolynomial.rename Sum.inl (F j))
      (fun _ : Unit => MvPolynomial.X (Sum.inr ()) * MvPolynomial.rename Sum.inl Δ - 1) with hrel
    set I := Ideal.span (Set.range rel) with hI
    haveI : Algebra.Etale H (MvPolynomial (κ ⊕ Unit) H ⧸ I) := hhalg κ F
    have hevΔ : MvPolynomial.eval a₀ Δ = Matrix.det (Matrix.of fun j k =>
        MvPolynomial.eval a₀ (MvPolynomial.pderiv k (F j))) := by
      rw [hΔ, RingHom.map_det]
      rfl
    set res := IsLocalRing.residue H
    have hres : ∀ q : MvPolynomial κ H,
        MvPolynomial.aeval (fun k => res (a₀ k)) q = res (MvPolynomial.eval a₀ q) := by
      intro q
      rw [MvPolynomial.aeval_def, MvPolynomial.eval, MvPolynomial.coe_eval₂Hom,
        MvPolynomial.eval₂_comp_left]
      rfl
    set u := res (MvPolynomial.eval a₀ Δ) with hu
    have hu0 : u ≠ 0 := by
      rw [hu, hevΔ]
      exact (IsLocalRing.residue_ne_zero_iff_isUnit _).mpr hdet
    set pt : κ ⊕ Unit → IsLocalRing.ResidueField H :=
      Sum.elim (fun k => res (a₀ k)) (fun _ => u⁻¹) with hpt
    set Φ := MvPolynomial.aeval (R := H) pt with hΦ
    have hΦI : ∀ a ∈ I, Φ a = 0 := by
      intro a ha
      have : I ≤ RingHom.ker Φ := by
        rw [hI, Ideal.span_le]
        rintro _ ⟨i, rfl⟩
        rw [SetLike.mem_coe, RingHom.mem_ker]
        rcases i with j | _
        · simp only [hrel, Sum.elim_inl, hΦ, MvPolynomial.aeval_rename]
          rw [show pt ∘ Sum.inl = fun k => res (a₀ k) from rfl, hres,
            IsLocalRing.residue_eq_zero_iff]
          exact hF j
        · simp only [hrel, Sum.elim_inr, hΦ, map_sub, map_mul, MvPolynomial.aeval_rename,
            MvPolynomial.aeval_X, map_one]
          rw [show pt ∘ Sum.inl = fun k => res (a₀ k) from rfl, hres]
          simp only [hpt, Sum.elim_inr]
          rw [← hu, inv_mul_cancel₀ hu0, sub_self]
      exact this ha
    let σ' := Ideal.Quotient.liftₐ I Φ hΦI
    obtain ⟨τ, hτ⟩ := hetale _ σ'
    refine ⟨fun k => τ (Ideal.Quotient.mk I (MvPolynomial.X (Sum.inl k))), fun j => ?_,
      fun k => ?_⟩
    · have h1 : (τ.comp (Ideal.Quotient.mkₐ H I)) =
          MvPolynomial.aeval (fun i => τ (Ideal.Quotient.mk I (MvPolynomial.X i))) := by
        rw [MvPolynomial.aeval_unique (τ.comp (Ideal.Quotient.mkₐ H I))]
        rfl
      have h2 := congrArg (fun φ => φ (MvPolynomial.rename Sum.inl (F j))) h1
      simp only [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk, MvPolynomial.aeval_rename] at h2
      have h3 : Ideal.Quotient.mk I (MvPolynomial.rename Sum.inl (F j)) = 0 := by
        rw [Ideal.Quotient.eq_zero_iff_mem, hI]
        exact Ideal.subset_span ⟨Sum.inl j, rfl⟩
      rw [h3, map_zero] at h2
      rw [← MvPolynomial.coe_aeval_eq_eval]
      exact h2.symm
    · rw [← IsLocalRing.residue_eq_zero_iff, map_sub, sub_eq_zero, hτ]
      show Φ (MvPolynomial.X (Sum.inl k)) = _
      rw [hΦ, MvPolynomial.aeval_X]
      rfl

  have hstdsec : ∀ (S : Type u) [CommRing S] [Algebra H S] [Algebra.IsStandardSmooth H S]
      (σ : S →ₐ[H] IsLocalRing.ResidueField H), ∃ τ : S →ₐ[H] H,
        ∀ x : S, IsLocalRing.residue H (τ x) = σ x := by
    intro S _ _ _ σ
    obtain ⟨ι, κ, hκfin, hιfin, ⟨P⟩⟩ := Algebra.IsStandardSmooth.out (R := H) (S := S)
    letI : Fintype κ := Fintype.ofFinite κ
    have hm : Function.Injective P.map := P.map_inj
    choose w hw using fun i => IsLocalRing.residue_surjective (σ (P.val i))
    have key : ∀ (b : ι → H), (∀ i, IsLocalRing.residue H (b i) = σ (P.val i)) →
        ∀ q : MvPolynomial ι H,
          IsLocalRing.residue H (MvPolynomial.eval b q) = σ (MvPolynomial.aeval P.val q) := by
      intro b hb q
      have h1 := congrArg (fun φ => φ q)
        (MvPolynomial.comp_aeval b (Algebra.ofId H (IsLocalRing.ResidueField H)))
      have h2 := congrArg (fun φ => φ q) (MvPolynomial.comp_aeval P.val σ)
      simp only [AlgHom.comp_apply, Algebra.ofId_apply,
        IsLocalRing.ResidueField.algebraMap_eq] at h1 h2
      have hfun : (fun i => IsLocalRing.residue H (b i)) = fun i => σ (P.val i) := funext hb
      rw [hfun] at h1
      rw [h2, ← h1]
      rfl
    set e : ι → MvPolynomial κ H :=
      Function.extend P.map MvPolynomial.X (fun i => MvPolynomial.C (w i)) with he
    have hfr : ∀ (k : κ) (p : MvPolynomial ι H), MvPolynomial.pderiv k (MvPolynomial.aeval e p) =
        MvPolynomial.aeval e (MvPolynomial.pderiv (P.map k) p) := by
      intro k p
      rw [he]
      exact hfreeze κ ι P.map hm w k p
    have he_m : ∀ k, e (P.map k) = MvPolynomial.X k := fun k => hm.extend_apply _ _ k
    have he_n : ∀ i, (¬∃ k, P.map k = i) → e i = MvPolynomial.C (w i) :=
      fun i hi => Function.extend_apply' _ _ _ hi
    have hcomp : ∀ (a : κ → H) (q : MvPolynomial ι H), MvPolynomial.eval a
        (MvPolynomial.aeval e q) = MvPolynomial.eval (fun i => MvPolynomial.eval a (e i)) q := by
      intro a q
      have h := congrArg (fun φ => φ q) (MvPolynomial.comp_aeval e (MvPolynomial.aeval (R := H) a))
      simp only [AlgHom.comp_apply] at h
      exact h
    have hw' : (fun i => MvPolynomial.eval (fun k => w (P.map k)) (e i)) = w := by
      funext i
      by_cases hi : ∃ k, P.map k = i
      · obtain ⟨k, rfl⟩ := hi
        rw [he_m, MvPolynomial.eval_X]
      · rw [he_n i hi, MvPolynomial.eval_C]
    have hF0 : ∀ j, MvPolynomial.eval (fun k => w (P.map k))
        (MvPolynomial.aeval e (P.relation j)) ∈ IsLocalRing.maximalIdeal H := by
      intro j
      rw [← IsLocalRing.residue_eq_zero_iff, hcomp, hw', key w hw, P.aeval_val_relation, map_zero]
    have hJ : IsUnit (Matrix.det (Matrix.of fun j k => MvPolynomial.eval (fun k => w (P.map k))
        (MvPolynomial.pderiv k (MvPolynomial.aeval e (P.relation j))))) := by
      have hmat : (Matrix.of fun j k => MvPolynomial.eval (fun k => w (P.map k))
          (MvPolynomial.pderiv k (MvPolynomial.aeval e (P.relation j)))) =
          ((MvPolynomial.eval w).mapMatrix P.jacobiMatrix).transpose := by
        ext j k
        rw [Matrix.of_apply, Matrix.transpose_apply, RingHom.mapMatrix_apply, Matrix.map_apply,
          P.jacobiMatrix_apply, hfr, hcomp, hw']
      rw [hmat, Matrix.det_transpose, ← RingHom.map_det, ← IsLocalRing.residue_ne_zero_iff_isUnit,
        key w hw]
      have hjac := P.jacobian_isUnit
      rw [P.jacobian_eq_jacobiMatrix_det, Algebra.Generators.algebraMap_apply] at hjac
      exact (hjac.map σ).ne_zero
    obtain ⟨a, ha0, ha⟩ :=
      hmv κ (fun j => MvPolynomial.aeval e (P.relation j)) (fun k => w (P.map k)) hF0 hJ
    have hb_rel : ∀ j,
        MvPolynomial.eval (fun i => MvPolynomial.eval a (e i)) (P.relation j) = 0 := by
      intro j
      rw [← hcomp]
      exact ha0 j
    have hb_res : ∀ i, IsLocalRing.residue H (MvPolynomial.eval a (e i)) = σ (P.val i) := by
      intro i
      by_cases hi : ∃ k, P.map k = i
      · obtain ⟨k, rfl⟩ := hi
        have h1 := ha k
        rw [← IsLocalRing.residue_eq_zero_iff, map_sub, sub_eq_zero] at h1
        rw [he_m, MvPolynomial.eval_X, h1]
        exact hw _
      · rw [he_n i hi, MvPolynomial.eval_C]
        exact hw i
    have hker : RingHom.ker (MvPolynomial.aeval P.val).toRingHom ≤
        RingHom.ker (MvPolynomial.aeval (R := H)
          (fun i => MvPolynomial.eval a (e i))).toRingHom := by
      intro x hx
      have hx' : x ∈ Ideal.span (Set.range P.relation) := by
        rw [P.span_range_relation_eq_ker, P.ker_eq_ker_aeval_val]
        exact hx
      have hle : Ideal.span (Set.range P.relation) ≤
          RingHom.ker (MvPolynomial.aeval (R := H)
            (fun i => MvPolynomial.eval a (e i))).toRingHom := by
        rw [Ideal.span_le]
        rintro _ ⟨j, rfl⟩
        rw [SetLike.mem_coe, RingHom.mem_ker]
        exact hb_rel j
      exact hle hx'
    refine ⟨(MvPolynomial.aeval P.val).liftOfSurjective P.aeval_val_surjective
      (MvPolynomial.aeval (R := H) (fun i => MvPolynomial.eval a (e i))) hker, fun x => ?_⟩
    obtain ⟨q, rfl⟩ := P.aeval_val_surjective x
    rw [AlgHom.liftOfSurjective_apply]
    exact key _ hb_res q

  haveI hp : (RingHom.ker σ).IsPrime := RingHom.ker_isPrime σ
  haveI : Algebra.FormallySmooth D (Localization.AtPrime (RingHom.ker σ)) :=
    Algebra.FormallySmooth.of_isLocalization (RingHom.ker σ).primeCompl
  haveI : Algebra.IsSmoothAt H (RingHom.ker σ) :=
    Algebra.FormallySmooth.comp H D (Localization.AtPrime (RingHom.ker σ))
  obtain ⟨f, hf, hstd⟩ := Algebra.IsSmoothAt.exists_notMem_isStandardSmooth H (RingHom.ker σ)
  have hσf : IsUnit (σ f) := by
    rw [isUnit_iff_ne_zero]
    intro h
    exact hf (RingHom.mem_ker.mpr h)
  let σf : Localization.Away f →ₐ[H] IsLocalRing.ResidueField H :=
    IsLocalization.Away.liftAlgHom f hσf
  obtain ⟨τf, hτf⟩ := hstdsec (Localization.Away f) σf
  refine ⟨τf.comp (IsScalarTower.toAlgHom H D (Localization.Away f)), fun x => ?_⟩
  rw [AlgHom.comp_apply, hτf, IsScalarTower.coe_toAlgHom', IsLocalization.Away.liftAlgHom_apply,
    IsLocalization.Away.lift_eq]
  rfl

theorem wc_hnas_hs_etale_chart_merge : ∀ (P : Type u) [CommRing P] (R : Type u) [CommRing R] [Algebra P R] (E₁ : Type u) [CommRing E₁] [Algebra P E₁] [Algebra.Etale P E₁] (E₂ : Type u) [CommRing E₂] [Algebra P E₂] [Algebra.Etale P E₂] (φ₁ : E₁ →ₐ[P] R) (φ₂ : E₂ →ₐ[P] R), ∃ (E : Type u) (_ : CommRing E) (_ : Algebra P E) (_ : Algebra.Etale P E) (φ : E →ₐ[P] R) (i₁ : E₁ →ₐ[P] E) (i₂ : E₂ →ₐ[P] E), φ.comp i₁ = φ₁ ∧ φ.comp i₂ = φ₂ :=
by
  intro P _ R _ _ E₁ _ _ _ E₂ _ _ _ φ₁ φ₂
  letI : Algebra.Etale E₁ (TensorProduct P E₁ E₂) := Algebra.Etale.baseChange P E₂ E₁
  have hE : Algebra.Etale P (TensorProduct P E₁ E₂) := Algebra.Etale.comp P E₁ (TensorProduct P E₁ E₂)
  exact ⟨TensorProduct P E₁ E₂, inferInstance, inferInstance, hE,
    Algebra.TensorProduct.productMap φ₁ φ₂,
    (Algebra.TensorProduct.includeLeft : E₁ →ₐ[P] TensorProduct P E₁ E₂),
    Algebra.TensorProduct.includeRight,
    Algebra.TensorProduct.productMap_left φ₁ φ₂, Algebra.TensorProduct.productMap_right φ₁ φ₂⟩

theorem wc_hnas_hs_etale_hull_subring : (∀ (P : Type u) [CommRing P] (R : Type u) [CommRing R] [Algebra P R] (E₁ : Type u) [CommRing E₁] [Algebra P E₁] [Algebra.Etale P E₁] (E₂ : Type u) [CommRing E₂] [Algebra P E₂] [Algebra.Etale P E₂] (φ₁ : E₁ →ₐ[P] R) (φ₂ : E₂ →ₐ[P] R), ∃ (E : Type u) (_ : CommRing E) (_ : Algebra P E) (_ : Algebra.Etale P E) (φ : E →ₐ[P] R) (i₁ : E₁ →ₐ[P] E) (i₂ : E₂ →ₐ[P] E), φ.comp i₁ = φ₁ ∧ φ.comp i₂ = φ₂) → ∀ (P : Type u) [CommRing P] (R : Type u) [CommRing R] [Algebra P R], ∃ H : Subring R, (∀ x : R, x ∈ H ↔ ∃ (E : Type u) (_ : CommRing E) (_ : Algebra P E) (_ : Algebra.Etale P E) (φ : E →ₐ[P] R), x ∈ φ.range) ∧ ∀ F : Finset R, (∀ x ∈ F, x ∈ H) → ∃ (E : Type u) (_ : CommRing E) (_ : Algebra P E) (_ : Algebra.Etale P E) (φ : E →ₐ[P] R), ∀ x ∈ F, x ∈ φ.range :=
by
  intro M P _ R _ _
  classical
  let S : Set R := {x | ∃ (E : Type u) (_ : CommRing E) (_ : Algebra P E) (_ : Algebra.Etale P E)
    (φ : E →ₐ[P] R), x ∈ φ.range}
  have hpair : ∀ x y : R, x ∈ S → y ∈ S → ∃ (E : Type u) (_ : CommRing E) (_ : Algebra P E)
      (_ : Algebra.Etale P E) (φ : E →ₐ[P] R), x ∈ φ.range ∧ y ∈ φ.range := by
    rintro x y ⟨E₁, _, _, _, φ₁, hx⟩ ⟨E₂, _, _, _, φ₂, hy⟩
    obtain ⟨E, _, _, _, φ, i₁, i₂, c₁, c₂⟩ := M P R E₁ E₂ φ₁ φ₂
    obtain ⟨a, ha⟩ := (AlgHom.mem_range _).1 hx
    obtain ⟨b, hb⟩ := (AlgHom.mem_range _).1 hy
    exact ⟨E, inferInstance, inferInstance, inferInstance, φ,
      (AlgHom.mem_range _).2 ⟨i₁ a, (DFunLike.congr_fun c₁ a).trans ha⟩,
      (AlgHom.mem_range _).2 ⟨i₂ b, (DFunLike.congr_fun c₂ b).trans hb⟩⟩
  have hbase : ∀ x : R, x ∈ (Algebra.ofId P R).range → x ∈ S := fun x hx =>
    ⟨P, inferInstance, inferInstance, inferInstance, Algebra.ofId P R, hx⟩
  let H : Subring R :=
    { carrier := S
      zero_mem' := hbase 0 (zero_mem _)
      one_mem' := hbase 1 (one_mem _)
      add_mem' := by
        intro x y hx hy
        obtain ⟨E, _, _, _, φ, hx', hy'⟩ := hpair x y hx hy
        exact ⟨E, inferInstance, inferInstance, inferInstance, φ, add_mem hx' hy'⟩
      mul_mem' := by
        intro x y hx hy
        obtain ⟨E, _, _, _, φ, hx', hy'⟩ := hpair x y hx hy
        exact ⟨E, inferInstance, inferInstance, inferInstance, φ, mul_mem hx' hy'⟩
      neg_mem' := by
        intro x hx
        obtain ⟨E, _, _, _, φ, hx'⟩ := hx
        exact ⟨E, inferInstance, inferInstance, inferInstance, φ, neg_mem hx'⟩ }
  refine ⟨H, fun x => Iff.rfl, ?_⟩
  intro F
  induction F using Finset.induction_on with
  | empty =>
    intro _
    exact ⟨P, inferInstance, inferInstance, inferInstance, Algebra.ofId P R,
      fun x hx => by simp at hx⟩
  | insert a F' _ ih =>
    intro hF
    obtain ⟨E₁, _, _, _, φ₁, h₁⟩ := ih (fun x hx => hF x (Finset.mem_insert_of_mem hx))
    obtain ⟨E₂, _, _, _, φ₂, h₂⟩ := hF a (Finset.mem_insert_self a F')
    obtain ⟨E, _, _, _, φ, i₁, i₂, c₁, c₂⟩ := M P R E₁ E₂ φ₁ φ₂
    refine ⟨E, inferInstance, inferInstance, inferInstance, φ, fun x hx => ?_⟩
    rcases Finset.mem_insert.1 hx with rfl | hx'
    · obtain ⟨b, hb⟩ := (AlgHom.mem_range _).1 h₂
      exact (AlgHom.mem_range _).2 ⟨i₂ b, (DFunLike.congr_fun c₂ b).trans hb⟩
    · obtain ⟨b, hb⟩ := (AlgHom.mem_range _).1 (h₁ x hx')
      exact (AlgHom.mem_range _).2 ⟨i₁ b, (DFunLike.congr_fun c₁ b).trans hb⟩

theorem wc_hnas_hs_etale_inverse : ∀ (P : Type u) [CommRing P] (R : Type u) [CommRing R] [Algebra P R] (E : Type u) [CommRing E] [Algebra P E] [Algebra.Etale P E] (φ : E →ₐ[P] R) (e : E), IsUnit (φ e) → ∃ (E' : Type u) (_ : CommRing E') (_ : Algebra P E') (_ : Algebra.Etale P E') (φ' : E' →ₐ[P] R) (y : E'), φ' y * φ e = 1 :=
by
  intro P _ R _ _ E _ _ _ φ e hu
  have hf : ∀ s : Submonoid.powers e, IsUnit (φ s) := by
    rintro ⟨s, hs⟩
    obtain ⟨n, rfl⟩ := (Submonoid.mem_powers_iff s e).mp hs
    simp only [map_pow]
    exact hu.pow n
  let φ' : Localization.Away e →ₐ[P] R :=
    IsLocalization.liftAlgHom (M := Submonoid.powers e) (S := Localization.Away e) (f := φ) hf
  have hstar : ∀ x : E, φ' (algebraMap E (Localization.Away e) x) = φ x := by
    intro x
    simp only [φ', IsLocalization.liftAlgHom_apply]
    exact IsLocalization.lift_eq hf x
  refine ⟨Localization.Away e, inferInstance, inferInstance,
    Algebra.Etale.comp P E (Localization.Away e), φ',
    IsLocalization.Away.invSelf e, ?_⟩
  rw [← hstar e, ← map_mul, mul_comm, IsLocalization.Away.mul_invSelf, map_one]

theorem wc_hnas_hs_etale_simple_root : ∀ (P : Type u) [CommRing P] (R : Type u) [CommRing R] [Algebra P R] (E : Type u) [CommRing E] [Algebra P E] [Algebra.Etale P E] (φ : E →ₐ[P] R) (f : Polynomial E) (b : R), f.Monic → Polynomial.eval₂ (φ : E →+* R) b f = 0 → IsUnit (Polynomial.eval₂ (φ : E →+* R) b (Polynomial.derivative f)) → ∃ (E' : Type u) (_ : CommRing E') (_ : Algebra P E') (_ : Algebra.Etale P E') (φ' : E' →ₐ[P] R), b ∈ φ'.range :=
by
  intro P _ R _ _ E _ _ _ φ f b hf h0 h1
  let Q : StandardEtalePair E :=
    StandardEtalePair.mk f hf (Polynomial.derivative f) ⟨1, 0, 1, by simp⟩
  letI algER : Algebra E R := (φ : E →+* R).toAlgebra
  haveI : IsScalarTower P E R :=
    IsScalarTower.of_algebraMap_eq (fun p => (φ.commutes p).symm)
  have hb : Q.HasMap b := by
    refine ⟨?_, ?_⟩
    · rw [Polynomial.aeval_def]; exact h0
    · rw [Polynomial.aeval_def]; exact h1
  let ψ : Q.Ring →ₐ[E] R := Q.lift b hb
  letI algPQ : Algebra P Q.Ring := ((algebraMap E Q.Ring).comp (algebraMap P E)).toAlgebra
  haveI : IsScalarTower P E Q.Ring := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  haveI hEt : Algebra.Etale P Q.Ring := Algebra.Etale.comp P E Q.Ring
  refine ⟨Q.Ring, inferInstance, algPQ, hEt, ψ.restrictScalars P, Q.X, ?_⟩
  exact StandardEtalePair.lift_X Q b hb

theorem wc_hnas_hs_etale_hom_unique_residue : ∀ (P : Type u) [CommRing P] (E : Type u) [CommRing E] [Algebra P E] [Algebra.Etale P E] (A : Type u) [CommRing A] [IsLocalRing A] [Algebra P A] (τ τ' : E →ₐ[P] A), (∀ x : E, IsLocalRing.residue A (τ x) = IsLocalRing.residue A (τ' x)) → τ = τ' :=
by
  intro P _ E _ _ _ A _ _ _ τ τ' h
  obtain ⟨t, ht, ht1⟩ :=
    (Algebra.FormallyUnramified.iff_exists_tensorProduct (R := P) (S := E)).mp inferInstance
  have key : ∀ x : TensorProduct P E E,
      IsLocalRing.residue A (Algebra.TensorProduct.productMap τ τ' x) =
        IsLocalRing.residue A (τ (Algebra.TensorProduct.lmul' P x)) := by
    intro x
    induction x using TensorProduct.induction_on with
    | zero => simp only [map_zero]
    | tmul a b =>
      rw [Algebra.TensorProduct.productMap_apply_tmul, Algebra.TensorProduct.lmul'_apply_tmul,
        map_mul, map_mul, map_mul, h b]
    | add x y hx hy =>
      rw [map_add, map_add, map_add, map_add, map_add, hx, hy]
  have hc : IsUnit (Algebra.TensorProduct.productMap τ τ' t) := by
    apply (IsLocalRing.residue_ne_zero_iff_isUnit _).mp
    rw [key, ht1, map_one, map_one]
    exact one_ne_zero
  ext s
  have e := congrArg (Algebra.TensorProduct.productMap τ τ') (ht s)
  rw [map_mul, map_sub, map_zero, Algebra.TensorProduct.productMap_apply_tmul,
    Algebra.TensorProduct.productMap_apply_tmul, map_one, map_one, one_mul, mul_one] at e
  have h2 := (hc.mul_left_eq_zero).mp e
  exact (sub_eq_zero.mp h2).symm

theorem wc_hnas_hs_etale_section_over_base : ∀ (P : Type u) [CommRing P] (A : Type u) [CommRing A] [HenselianLocalRing A] [Algebra P A], (∀ (E : Type u) [CommRing E] [Algebra A E] [Algebra.Etale A E] (σ : E →ₐ[A] IsLocalRing.ResidueField A), ∃ τ : E →ₐ[A] A, ∀ x : E, IsLocalRing.residue A (τ x) = σ x) → ∀ (E : Type u) [CommRing E] [Algebra P E] [Algebra.Etale P E] (σ : E →+* IsLocalRing.ResidueField A), σ.comp (algebraMap P E) = (IsLocalRing.residue A).comp (algebraMap P A) → ∃ τ : E →ₐ[P] A, ∀ x : E, IsLocalRing.residue A (τ x) = σ x :=
by
  intro P _ A _ _ _ H E _ _ _ σ hσ
  haveI : Algebra.Etale A (TensorProduct P A E) := Algebra.Etale.baseChange P E A
  have hc : ∀ p : P, σ (algebraMap P E p) = algebraMap P (IsLocalRing.ResidueField A) p := by
    intro p
    rw [IsScalarTower.algebraMap_apply P A (IsLocalRing.ResidueField A) p,
      IsLocalRing.ResidueField.algebraMap_eq]
    exact RingHom.congr_fun hσ p
  let g : E →ₐ[P] IsLocalRing.ResidueField A := AlgHom.mk σ hc
  let σ' : TensorProduct P A E →ₐ[A] IsLocalRing.ResidueField A :=
    Algebra.TensorProduct.lift (Algebra.ofId A _) g (fun _ _ => Commute.all _ _)
  obtain ⟨τ', hτ'⟩ := H (TensorProduct P A E) σ'
  refine ⟨(τ'.restrictScalars P).comp Algebra.TensorProduct.includeRight, fun x => ?_⟩
  rw [AlgHom.comp_apply, AlgHom.restrictScalars_apply, Algebra.TensorProduct.includeRight_apply,
    hτ']
  simp only [σ', Algebra.TensorProduct.lift_tmul, map_one, one_mul]
  rfl

theorem wc_hnas_hs_unramified_max_ideal_local : ∀ (P : Type u) [CommRing P] [IsLocalRing P] (R : Type u) [CommRing R] [IsLocalRing R] [Algebra P R] [IsLocalHom (algebraMap P R)] (E : Type u) [CommRing E] [Algebra P E] [Algebra.Etale P E] (φ : E →ₐ[P] R) (e : E), φ e ∈ IsLocalRing.maximalIdeal R → ∃ s : E, IsUnit (φ s) ∧ s * e ∈ Ideal.map (algebraMap P E) (IsLocalRing.maximalIdeal P) :=
by
  intro P _ _ R _ _ _ _ E _ _ _ φ e he
  let q : Ideal E := Ideal.comap (φ : E →+* R) (IsLocalRing.maximalIdeal R)
  have hq : q.IsPrime := Ideal.IsPrime.comap _
  have heq : e ∈ q := he
  let L := Localization.AtPrime q
  have hloc : IsLocalHom (algebraMap P L) := by
    constructor
    intro p hp
    by_contra hnp
    have h1 : algebraMap P R p ∈ IsLocalRing.maximalIdeal R := map_nonunit (algebraMap P R) p hnp
    have h2 : algebraMap P E p ∈ q := by
      show φ (algebraMap P E p) ∈ IsLocalRing.maximalIdeal R
      rw [φ.commutes]; exact h1
    have h3 : algebraMap E L (algebraMap P E p) ∈ IsLocalRing.maximalIdeal L :=
      (IsLocalization.AtPrime.to_map_mem_maximal_iff L q (algebraMap P E p)).2 h2
    rw [← IsScalarTower.algebraMap_apply P E L] at h3
    exact (IsLocalRing.mem_maximalIdeal _).1 h3 hp
  have H : Ideal.map (algebraMap P L) (IsLocalRing.maximalIdeal P) = IsLocalRing.maximalIdeal L :=
    Algebra.FormallyUnramified.map_maximalIdeal
  rw [IsScalarTower.algebraMap_eq P E L, ← Ideal.map_map] at H
  have h6 : algebraMap E L e ∈ IsLocalRing.maximalIdeal L :=
    (IsLocalization.AtPrime.to_map_mem_maximal_iff L q e).2 heq
  rw [← H] at h6
  obtain ⟨m, hm, hme⟩ :=
    (IsLocalization.algebraMap_mem_map_algebraMap_iff q.primeCompl L _ e).1 h6
  refine ⟨m, ?_, hme⟩
  have hmq : m ∉ q := hm
  exact IsLocalRing.notMem_maximalIdeal.1 hmq

theorem wc_hnas_hs_etale_local_ring_levels : ∀ (P : Type u) [CommRing P] [IsLocalRing P] [IsNoetherianRing P] (R : Type u) [CommRing R] [IsLocalRing R] [Algebra P R] [IsLocalHom (algebraMap P R)], (∀ r : R, ∃ p : P, r - algebraMap P R p ∈ IsLocalRing.maximalIdeal R) → ∀ (E : Type u) [CommRing E] [Algebra P E] [Algebra.Etale P E] (φ : E →ₐ[P] R), ∃ φB : Localization.AtPrime (Ideal.comap φ (IsLocalRing.maximalIdeal R)) →ₐ[P] R, (∀ x : E, φB (algebraMap E _ x) = φ x) ∧ IsNoetherianRing (Localization.AtPrime (Ideal.comap φ (IsLocalRing.maximalIdeal R))) ∧ IsLocalRing.maximalIdeal (Localization.AtPrime (Ideal.comap φ (IsLocalRing.maximalIdeal R))) = Ideal.map (algebraMap P _) (IsLocalRing.maximalIdeal P) ∧ ∀ (k : ℕ) (b : Localization.AtPrime (Ideal.comap φ (IsLocalRing.maximalIdeal R))), ∃ p : P, b - algebraMap P _ p ∈ Ideal.map (algebraMap P _) (IsLocalRing.maximalIdeal P ^ k) :=
by
  intro P _ _ _ R _ _ _ _ resP E _ _ _ φ

  have levels : ∀ (B : Type u) [CommRing B] (f : P →+* B) (I : Ideal P),
      (∀ b : B, ∃ p : P, b - f p ∈ Ideal.map f I) →
      ∀ (k : ℕ) (b : B), ∃ p : P, b - f p ∈ Ideal.map f (I ^ k) := by
    intro B _ f I h1
    have C : ∀ (k : ℕ) (x : B), x ∈ Ideal.map f (I ^ k) →
        ∃ p ∈ I ^ k, x - f p ∈ Ideal.map f (I ^ (k + 1)) := by
      intro k x hx
      have hmul : ∀ ε y : B, ε ∈ Ideal.map f I → y ∈ Ideal.map f (I ^ k) →
          ε * y ∈ Ideal.map f (I ^ (k + 1)) := by
        intro ε y hε hy
        rw [pow_succ', Ideal.map_mul]
        exact Ideal.mul_mem_mul hε hy
      change x ∈ Submodule.span B (f '' ↑(I ^ k)) at hx
      induction hx using Submodule.span_induction with
      | mem x hx =>
        obtain ⟨m, hm, rfl⟩ := hx
        exact ⟨m, hm, by rw [sub_self]; exact Ideal.zero_mem _⟩
      | zero => exact ⟨0, Ideal.zero_mem _, by rw [map_zero, sub_zero]; exact Ideal.zero_mem _⟩
      | add x y _ _ hx hy =>
        obtain ⟨px, hpx, hx⟩ := hx
        obtain ⟨py, hpy, hy⟩ := hy
        refine ⟨px + py, Ideal.add_mem _ hpx hpy, ?_⟩
        have e : x + y - f (px + py) = (x - f px) + (y - f py) := by rw [map_add]; ring
        rw [e]
        exact Ideal.add_mem _ hx hy
      | smul a x hxmem hx =>
        obtain ⟨p, hp, hxp⟩ := hx
        obtain ⟨p', hp'⟩ := h1 a
        refine ⟨p' * p, Ideal.mul_mem_left _ _ hp, ?_⟩
        have e : a • x - f (p' * p) = f p' * (x - f p) + (a - f p') * x := by
          rw [smul_eq_mul, map_mul]; ring
        rw [e]
        exact Ideal.add_mem _ (Ideal.mul_mem_left _ _ hxp) (hmul _ _ hp' hxmem)
    intro k
    induction k with
    | zero =>
      intro b
      refine ⟨0, ?_⟩
      rw [pow_zero, Ideal.one_eq_top, Ideal.map_top]
      exact Submodule.mem_top
    | succ k ih =>
      intro b
      obtain ⟨p, hp⟩ := ih b
      obtain ⟨p'', -, hp''⟩ := C k _ hp
      refine ⟨p + p'', ?_⟩
      have e : b - f (p + p'') = b - f p - f p'' := by rw [map_add]; ring
      rw [e]
      exact hp''
  have key : ∀ (q : Ideal E) [q.IsPrime],
      (∀ x : E, x ∈ q ↔ φ x ∈ IsLocalRing.maximalIdeal R) →
      ∃ φB : Localization.AtPrime q →ₐ[P] R, (∀ x : E, φB (algebraMap E _ x) = φ x) ∧
        IsNoetherianRing (Localization.AtPrime q) ∧
        IsLocalRing.maximalIdeal (Localization.AtPrime q) =
          Ideal.map (algebraMap P _) (IsLocalRing.maximalIdeal P) ∧
        ∀ (k : ℕ) (b : Localization.AtPrime q), ∃ p : P, b - algebraMap P _ p ∈
          Ideal.map (algebraMap P _) (IsLocalRing.maximalIdeal P ^ k) := by
    intro q _ hq
    have hunit : ∀ y : q.primeCompl, IsUnit (φ y) := by
      intro y
      have hy : (y : E) ∉ q := y.2
      rw [hq] at hy
      exact IsLocalRing.notMem_maximalIdeal.mp hy
    let φB : Localization.AtPrime q →ₐ[P] R :=
      IsLocalization.liftAlgHom (M := q.primeCompl) (S := Localization.AtPrime q) (f := φ) hunit
    have hcomp : ∀ x : E, φB (algebraMap E _ x) = φ x := by
      intro x
      show IsLocalization.liftAlgHom (M := q.primeCompl) (S := Localization.AtPrime q) (f := φ)
        hunit (algebraMap E _ x) = φ x
      rw [IsLocalization.liftAlgHom_apply, IsLocalization.lift_eq]
      rfl

    haveI : Algebra.FinitePresentation P E := inferInstance
    haveI : Algebra.FiniteType P E := Algebra.FiniteType.of_finitePresentation
    haveI : IsNoetherianRing E := Algebra.FiniteType.isNoetherianRing P E
    have hnoeth : IsNoetherianRing (Localization.AtPrime q) :=
      IsLocalization.isNoetherianRing q.primeCompl _ inferInstance

    haveI hloc : IsLocalHom (algebraMap P (Localization.AtPrime q)) := by
      constructor
      intro p hp
      by_contra hpn
      have h1 : algebraMap P R p ∈ IsLocalRing.maximalIdeal R := by
        rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
        intro hu
        exact hpn ((isUnit_map_iff (algebraMap P R) p).mp hu)
      have h2 : algebraMap P E p ∈ q := by
        rw [hq, AlgHom.commutes]; exact h1
      have h3 : algebraMap E (Localization.AtPrime q) (algebraMap P E p) ∈
          IsLocalRing.maximalIdeal (Localization.AtPrime q) :=
        (IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime q) q _).mpr h2
      rw [← IsScalarTower.algebraMap_apply] at h3
      exact ((IsLocalRing.mem_maximalIdeal _).mp h3) hp
    haveI : Algebra.FormallyEtale P E := Algebra.Etale.formallyEtale
    haveI : Algebra.FormallyUnramified P E :=
      (Algebra.FormallyEtale.iff_formallyUnramified_and_formallySmooth.mp inferInstance).1
    haveI : Algebra.FormallyUnramified E (Localization.AtPrime q) :=
      Algebra.FormallyUnramified.of_isLocalization q.primeCompl
    haveI : Algebra.FormallyUnramified P (Localization.AtPrime q) :=
      Algebra.FormallyUnramified.comp P E _
    haveI : Algebra.EssFiniteType P E := Algebra.EssFiniteType.of_finiteType P E
    haveI : Algebra.EssFiniteType E (Localization.AtPrime q) :=
      Algebra.EssFiniteType.of_isLocalization _ q.primeCompl
    haveI : Algebra.EssFiniteType P (Localization.AtPrime q) := Algebra.EssFiniteType.comp P E _
    have hmax : IsLocalRing.maximalIdeal (Localization.AtPrime q) =
        Ideal.map (algebraMap P _) (IsLocalRing.maximalIdeal P) :=
      (Algebra.FormallyUnramified.map_maximalIdeal).symm
    have lev1 : ∀ b : Localization.AtPrime q, ∃ p : P, b - algebraMap P _ p ∈
        Ideal.map (algebraMap P (Localization.AtPrime q)) (IsLocalRing.maximalIdeal P) := by
      intro b
      obtain ⟨p, hp⟩ := resP (φB b)
      refine ⟨p, ?_⟩
      rw [← hmax]
      by_contra hx
      have hu := (IsLocalRing.notMem_maximalIdeal.mp hx).map φB
      rw [map_sub, AlgHom.commutes] at hu
      exact (IsLocalRing.notMem_maximalIdeal.mpr hu) hp
    exact ⟨φB, hcomp, hnoeth, hmax,
      levels _ (algebraMap P (Localization.AtPrime q)) _ lev1⟩
  exact key _ (fun x => Ideal.mem_comap)

theorem wc_hnas_hs_completion_levels : ∀ (P : Type u) [CommRing P] [IsLocalRing P] [IsNoetherianRing P], (∀ (k : ℕ) (c : AdicCompletion (IsLocalRing.maximalIdeal P) P), ∃ p : P, c - algebraMap P (AdicCompletion (IsLocalRing.maximalIdeal P) P) p ∈ Ideal.map (algebraMap P (AdicCompletion (IsLocalRing.maximalIdeal P) P)) (IsLocalRing.maximalIdeal P ^ k)) ∧ (∀ (k : ℕ) (p : P), algebraMap P (AdicCompletion (IsLocalRing.maximalIdeal P) P) p ∈ Ideal.map (algebraMap P (AdicCompletion (IsLocalRing.maximalIdeal P) P)) (IsLocalRing.maximalIdeal P ^ k) → p ∈ IsLocalRing.maximalIdeal P ^ k) :=
by
  intro P _ _ _
  have hfg : (IsLocalRing.maximalIdeal P).FG := IsNoetherian.noetherian _
  have hmem : ∀ (k : ℕ) (b : AdicCompletion (IsLocalRing.maximalIdeal P) P),
      b ∈ Ideal.map (algebraMap P (AdicCompletion (IsLocalRing.maximalIdeal P) P))
        (IsLocalRing.maximalIdeal P ^ k) ↔
      AdicCompletion.eval (IsLocalRing.maximalIdeal P) P k b = 0 := by
    intro k b
    have h1 := AdicCompletion.pow_smul_top_eq_ker_eval (M := P) (n := k) hfg
    have h2 := Ideal.smul_top_eq_map (S := AdicCompletion (IsLocalRing.maximalIdeal P) P)
      (IsLocalRing.maximalIdeal P ^ k)
    have h3 := SetLike.ext_iff.mp (h2.symm.trans h1) b
    rw [Submodule.restrictScalars_mem, LinearMap.mem_ker] at h3
    exact h3
  have hof : ∀ (k : ℕ) (p : P), AdicCompletion.eval (IsLocalRing.maximalIdeal P) P k
      (algebraMap P (AdicCompletion (IsLocalRing.maximalIdeal P) P) p) =
      Submodule.Quotient.mk p := by
    intro k p
    change AdicCompletion.eval (IsLocalRing.maximalIdeal P) P k
      (AdicCompletion.of (IsLocalRing.maximalIdeal P) P p) = _
    rw [AdicCompletion.eval_of]
    rfl
  refine ⟨fun k c => ?_, fun k p h => ?_⟩
  · obtain ⟨p, hp⟩ := Submodule.Quotient.mk_surjective _
      (AdicCompletion.eval (IsLocalRing.maximalIdeal P) P k c)
    refine ⟨p, (hmem k _).mpr ?_⟩
    rw [map_sub, hof, hp, sub_self]
  · rw [hmem, hof, Submodule.Quotient.mk_eq_zero] at h
    have hle : IsLocalRing.maximalIdeal P ^ k • (⊤ : Submodule P P) ≤
        IsLocalRing.maximalIdeal P ^ k := by
      rw [Ideal.smul_eq_mul, Ideal.mul_top]
    exact hle h

theorem wc_hnas_hs_etale_ideal_descent : ∀ (P : Type u) [CommRing P] [IsLocalRing P] [IsNoetherianRing P] (R : Type u) [CommRing R] [IsLocalRing R] [Algebra P R] [IsLocalHom (algebraMap P R)], (∀ (P : Type u) [CommRing P] [IsLocalRing P] [IsNoetherianRing P] (R : Type u) [CommRing R] [IsLocalRing R] [Algebra P R] [IsLocalHom (algebraMap P R)], (∀ r : R, ∃ p : P, r - algebraMap P R p ∈ IsLocalRing.maximalIdeal R) → ∀ (E : Type u) [CommRing E] [Algebra P E] [Algebra.Etale P E] (φ : E →ₐ[P] R), ∃ φB : Localization.AtPrime (Ideal.comap φ (IsLocalRing.maximalIdeal R)) →ₐ[P] R, (∀ x : E, φB (algebraMap E _ x) = φ x) ∧ IsNoetherianRing (Localization.AtPrime (Ideal.comap φ (IsLocalRing.maximalIdeal R))) ∧ IsLocalRing.maximalIdeal (Localization.AtPrime (Ideal.comap φ (IsLocalRing.maximalIdeal R))) = Ideal.map (algebraMap P _) (IsLocalRing.maximalIdeal P) ∧ ∀ (k : ℕ) (b : Localization.AtPrime (Ideal.comap φ (IsLocalRing.maximalIdeal R))), ∃ p : P, b - algebraMap P _ p ∈ Ideal.map (algebraMap P _) (IsLocalRing.maximalIdeal P ^ k)) → (∀ r : R, ∃ p : P, r - algebraMap P R p ∈ IsLocalRing.maximalIdeal R) → (∀ (k : ℕ) (c : R), ∃ p : P, c - algebraMap P R p ∈ Ideal.map (algebraMap P R) (IsLocalRing.maximalIdeal P ^ k)) → (∀ (k : ℕ) (p : P), algebraMap P R p ∈ Ideal.map (algebraMap P R) (IsLocalRing.maximalIdeal P ^ k) → p ∈ IsLocalRing.maximalIdeal P ^ k) → ∀ (E : Type u) [CommRing E] [Algebra P E] [Algebra.Etale P E] (φ : E →ₐ[P] R) (n : ℕ) (a : Fin n → E) (z : E), φ z ∈ Ideal.span (Set.range (fun i => φ (a i))) → ∃ s : E, IsUnit (φ s) ∧ s * z ∈ Ideal.span (Set.range a) :=
by
  intro P _ _ _ R _ _ _ _ Hlev resP levS levI E _ _ _ φ n a z hz
  classical

  have s1 : ∀ (B : Type u) [CommRing B] [IsLocalRing B] [IsNoetherianRing B] (J : Ideal B)
      (x : B), (∀ k : ℕ, x ∈ J ⊔ IsLocalRing.maximalIdeal B ^ k) → x ∈ J := by
    intro B _ _ _ J x hx
    have hbot := Ideal.iInf_pow_smul_eq_bot_of_isLocalRing (M := B ⧸ J)
      (IsLocalRing.maximalIdeal B) (IsLocalRing.maximalIdeal.isMaximal B).ne_top
    have hmem : (Ideal.Quotient.mk J x : B ⧸ J) ∈
        ⨅ i, (IsLocalRing.maximalIdeal B) ^ i • (⊤ : Submodule B (B ⧸ J)) := by
      rw [Submodule.mem_iInf]
      intro k
      obtain ⟨j, hj, y, hy, rfl⟩ := Submodule.mem_sup.mp (hx k)
      have e : (Ideal.Quotient.mk J (j + y) : B ⧸ J) = y • (1 : B ⧸ J) := by
        rw [map_add, Ideal.Quotient.eq_zero_iff_mem.mpr hj, zero_add, Algebra.smul_def, mul_one,
          Ideal.Quotient.algebraMap_eq]
      rw [e]
      exact Submodule.smul_mem_smul hy Submodule.mem_top
    rw [hbot] at hmem
    exact Ideal.Quotient.eq_zero_iff_mem.mp ((Submodule.mem_bot B).mp hmem)

  have s2 : ∀ (q : Ideal E) [q.IsPrime] (I : Ideal E) (z : E),
      algebraMap E (Localization.AtPrime q) z ∈ Ideal.map (algebraMap E (Localization.AtPrime q)) I →
      ∃ s : E, s ∉ q ∧ s * z ∈ I := by
    intro q _ I z h
    obtain ⟨⟨⟨x1, hx1⟩, ⟨t, ht⟩⟩, he⟩ :=
      (IsLocalization.mem_map_algebraMap_iff q.primeCompl (Localization.AtPrime q)).mp h
    simp only at he
    rw [← map_mul] at he
    obtain ⟨⟨c, hc⟩, hce⟩ := (IsLocalization.eq_iff_exists q.primeCompl (Localization.AtPrime q)).mp he
    simp only at hce
    refine ⟨c * t, q.primeCompl.mul_mem hc ht, ?_⟩
    have e : c * t * z = c * x1 := by rw [← hce]; ring
    rw [e]
    exact I.mul_mem_left c hx1
  obtain ⟨φB, hφB, hNoeth, hm, hlevB⟩ := Hlev P R resP E φ
  haveI := hNoeth

  have hA : ∀ k : ℕ, algebraMap E (Localization.AtPrime (Ideal.comap φ (IsLocalRing.maximalIdeal R))) z ∈
      Ideal.map (algebraMap E _) (Ideal.span (Set.range a)) ⊔
        IsLocalRing.maximalIdeal (Localization.AtPrime (Ideal.comap φ (IsLocalRing.maximalIdeal R))) ^ k := by
    intro k
    obtain ⟨r, hr⟩ := (Ideal.mem_span_range_iff_exists_fun).mp hz
    choose p hp using fun i => levS k (r i)
    obtain ⟨w, hw⟩ : ∃ w, w = z - ∑ i, algebraMap P E (p i) * a i := ⟨_, rfl⟩
    have hφw : φ w ∈ Ideal.map (algebraMap P R) (IsLocalRing.maximalIdeal P ^ k) := by
      have e : φ w = ∑ i, (r i - algebraMap P R (p i)) * φ (a i) := by
        rw [hw, map_sub, map_sum, ← hr]
        simp only [map_mul, AlgHom.commutes, sub_mul, Finset.sum_sub_distrib]
      rw [e]
      exact Ideal.sum_mem _ (fun i _ => Ideal.mul_mem_right _ _ (hp i))

    have hwB : algebraMap E (Localization.AtPrime (Ideal.comap φ (IsLocalRing.maximalIdeal R))) w ∈
        Ideal.map (algebraMap P _) (IsLocalRing.maximalIdeal P ^ k) := by
      obtain ⟨p0, hp0⟩ := hlevB k (algebraMap E _ w)
      have hle : Ideal.map (algebraMap P (Localization.AtPrime (Ideal.comap φ (IsLocalRing.maximalIdeal R))))
          (IsLocalRing.maximalIdeal P ^ k) ≤
          Ideal.comap φB (Ideal.map (algebraMap P R) (IsLocalRing.maximalIdeal P ^ k)) := by
        rw [Ideal.map_le_iff_le_comap]
        intro x hx
        rw [Ideal.mem_comap, Ideal.mem_comap, AlgHom.commutes]
        exact Ideal.mem_map_of_mem _ hx
      have h1 := hle hp0
      rw [Ideal.mem_comap, map_sub, hφB, AlgHom.commutes] at h1
      have h2 : algebraMap P R p0 ∈ Ideal.map (algebraMap P R) (IsLocalRing.maximalIdeal P ^ k) := by
        have h' := Ideal.sub_mem _ hφw h1
        rwa [sub_sub_cancel] at h'
      have h3 := levI k p0 h2
      have h' := Ideal.add_mem _ hp0 (Ideal.mem_map_of_mem (algebraMap P _) h3)
      rwa [sub_add_cancel] at h'
    rw [Ideal.map_pow, ← hm] at hwB
    have hzw : z = ∑ i, algebraMap P E (p i) * a i + w := by rw [hw]; ring
    rw [hzw, map_add]
    refine Submodule.add_mem_sup ?_ hwB
    rw [map_sum]
    refine Ideal.sum_mem _ (fun i _ => ?_)
    rw [map_mul]
    exact Ideal.mul_mem_left _ _ (Ideal.mem_map_of_mem _ (Ideal.subset_span ⟨i, rfl⟩))

  have hB := s1 _ _ _ hA

  obtain ⟨s, hs, hsz⟩ := s2 (Ideal.comap φ (IsLocalRing.maximalIdeal R)) _ z hB
  refine ⟨s, ?_, hsz⟩
  exact IsLocalRing.notMem_maximalIdeal.mp (fun h => hs (Ideal.mem_comap.mpr h))

theorem wc_hnas_hs_inverse_closed_subring_local : ∀ (R : Type u) [CommRing R] [IsLocalRing R] (H : Subring R), (∀ x ∈ H, IsUnit x → ∃ y ∈ H, x * y = 1) → ∃ (_ : IsLocalRing ↥H), IsLocalHom H.subtype ∧ ∀ x : ↥H, x ∈ IsLocalRing.maximalIdeal ↥H ↔ (x : R) ∈ IsLocalRing.maximalIdeal R :=
by
  intro R _ _ H hinv
  have K : ∀ x : ↥H, IsUnit (x : R) → IsUnit x := by
    intro x hx
    obtain ⟨y, hy, hxy⟩ := hinv (x : R) x.2 hx
    have h1 : x * (⟨y, hy⟩ : ↥H) = 1 := Subtype.ext hxy
    exact isUnit_iff_exists_inv.mpr ⟨_, h1⟩
  have K' : ∀ x : ↥H, IsUnit x ↔ IsUnit (x : R) := fun x =>
    ⟨fun h => h.map H.subtype, K x⟩
  haveI : Nontrivial ↥H := ⟨⟨0, 1, fun h => zero_ne_one (congrArg Subtype.val h)⟩⟩
  have hloc : IsLocalRing ↥H := by
    apply IsLocalRing.of_isUnit_or_isUnit_one_sub_self
    intro a
    rcases IsLocalRing.isUnit_or_isUnit_one_sub_self (a : R) with h | h
    · exact Or.inl (K a h)
    · right
      apply K
      have e : ((1 - a : ↥H) : R) = 1 - (a : R) := rfl
      rw [e]
      exact h
  refine ⟨hloc, ⟨fun a ha => K a ha⟩, fun x => ?_⟩
  rw [IsLocalRing.mem_maximalIdeal, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff,
    mem_nonunits_iff, K' x]

theorem wc_hnas_hs_hull_henselian : ∀ (P : Type u) [CommRing P] (R : Type u) [CommRing R] [HenselianLocalRing R] [Algebra P R] (H : Subring R) [IsLocalRing ↥H], (∀ x : ↥H, x ∈ IsLocalRing.maximalIdeal ↥H ↔ (x : R) ∈ IsLocalRing.maximalIdeal R) → (∀ F : Finset R, (∀ x ∈ F, x ∈ H) → ∃ (E : Type u) (_ : CommRing E) (_ : Algebra P E) (_ : Algebra.Etale P E) (φ : E →ₐ[P] R), ∀ x ∈ F, x ∈ φ.range) → (∀ (E : Type u) [CommRing E] [Algebra P E] [Algebra.Etale P E] (φ : E →ₐ[P] R) (f : Polynomial E) (b : R), f.Monic → Polynomial.eval₂ (φ : E →+* R) b f = 0 → IsUnit (Polynomial.eval₂ (φ : E →+* R) b (Polynomial.derivative f)) → b ∈ H) → HenselianLocalRing ↥H :=
by
  intro P _ R _ _ _ H _ char chart root
  classical
  refine HenselianLocalRing.mk ?_
  intro f hf a₀ h1 h2
  have hev : ∀ (p : Polynomial H) (x : H),
      Polynomial.eval (H.subtype x) (p.map H.subtype) = H.subtype (Polynomial.eval x p) := by
    intro p x
    rw [Polynomial.eval_map, Polynomial.eval₂_at_apply]
  have hfRm : (f.map H.subtype).Monic := hf.map H.subtype
  have hd : Polynomial.derivative (f.map H.subtype) = (Polynomial.derivative f).map H.subtype :=
    Polynomial.derivative_map f H.subtype
  have hR1 : Polynomial.eval (H.subtype a₀) (f.map H.subtype) ∈ IsLocalRing.maximalIdeal R := by
    rw [hev]; exact (char _).1 h1
  have hR2 : IsUnit (Polynomial.eval (H.subtype a₀) (Polynomial.derivative (f.map H.subtype))) := by
    rw [hd, hev]; exact h2.map H.subtype
  obtain ⟨b, hb, hba⟩ := HenselianLocalRing.is_henselian (f.map H.subtype) hfRm (H.subtype a₀) hR1 hR2
  obtain ⟨E, iE, iPE, iEt, φ, hφ⟩ := chart (f.support.image (fun n => ((f.coeff n : H) : R))) (by
    intro x hx
    obtain ⟨n, _, rfl⟩ := Finset.mem_image.1 hx
    exact (f.coeff n).2)
  have hlifts : f.map H.subtype ∈ Polynomial.lifts (φ : E →+* R) := by
    rw [Polynomial.lifts_iff_coeff_lifts]
    intro n
    rw [Polynomial.coeff_map]
    by_cases hn : n ∈ f.support
    · obtain ⟨e, he⟩ := (AlgHom.mem_range φ).1 (hφ _ (Finset.mem_image_of_mem _ hn))
      exact ⟨e, by simpa using he⟩
    · rw [Polynomial.notMem_support_iff.1 hn, map_zero]
      exact ⟨0, map_zero _⟩
  obtain ⟨fE, hfE, -, hfEm⟩ := Polynomial.lifts_and_degree_eq_and_monic hlifts hfRm
  have e1 : Polynomial.eval₂ (φ : E →+* R) b fE = 0 := by
    rw [Polynomial.eval₂_eq_eval_map, hfE]; exact hb
  have e2 : Polynomial.eval₂ (φ : E →+* R) b (Polynomial.derivative fE) =
      Polynomial.eval b (Polynomial.derivative (f.map H.subtype)) := by
    rw [Polynomial.eval₂_eq_eval_map, ← Polynomial.derivative_map, hfE]
  have hu : IsUnit (Polynomial.eval b (Polynomial.derivative (f.map H.subtype))) := by
    by_contra hv
    have hv' : Polynomial.eval b (Polynomial.derivative (f.map H.subtype)) ∈
        IsLocalRing.maximalIdeal R := (IsLocalRing.mem_maximalIdeal _).2 hv
    have hdiff : Polynomial.eval b (Polynomial.derivative (f.map H.subtype)) -
        Polynomial.eval (H.subtype a₀) (Polynomial.derivative (f.map H.subtype)) ∈
        IsLocalRing.maximalIdeal R :=
      Ideal.mem_of_dvd _ (Polynomial.sub_dvd_eval_sub b (H.subtype a₀) _) hba
    have h3 : Polynomial.eval (H.subtype a₀) (Polynomial.derivative (f.map H.subtype)) ∈
        IsLocalRing.maximalIdeal R := by
      have h4 := Ideal.sub_mem _ hv' hdiff
      rwa [sub_sub_cancel] at h4
    exact (IsLocalRing.mem_maximalIdeal _).1 h3 hR2
  have hbH : b ∈ H := root E φ fE b hfEm e1 (by rw [e2]; exact hu)
  refine ⟨⟨b, hbH⟩, ?_, ?_⟩
  · apply Subtype.ext
    have h5 := hev f ⟨b, hbH⟩
    change Polynomial.eval b (f.map H.subtype) = _ at h5
    change H.subtype (Polynomial.eval ⟨b, hbH⟩ f) = 0
    rw [← h5]
    exact hb
  · exact (char _).2 hba

theorem wc_hnas_hs_hull_noetherian : ∀ (P : Type u) [CommRing P] (R : Type u) [CommRing R] [IsNoetherianRing R] [Algebra P R] (H : Subring R), (∀ x : R, x ∈ H ↔ ∃ (E : Type u) (_ : CommRing E) (_ : Algebra P E) (_ : Algebra.Etale P E) (φ : E →ₐ[P] R), x ∈ φ.range) → (∀ F : Finset R, (∀ x ∈ F, x ∈ H) → ∃ (E : Type u) (_ : CommRing E) (_ : Algebra P E) (_ : Algebra.Etale P E) (φ : E →ₐ[P] R), ∀ x ∈ F, x ∈ φ.range) → (∀ x ∈ H, IsUnit x → ∃ y ∈ H, x * y = 1) → (∀ (E : Type u) [CommRing E] [Algebra P E] [Algebra.Etale P E] (φ : E →ₐ[P] R) (n : ℕ) (a : Fin n → E) (z : E), φ z ∈ Ideal.span (Set.range (fun i => φ (a i))) → ∃ s : E, IsUnit (φ s) ∧ s * z ∈ Ideal.span (Set.range a)) → IsNoetherianRing ↥H :=
by
  intro P _ R _ _ _ H mem fin inv KBR
  classical
  have s1 : ∀ (E : Type u) [CommRing E] [Algebra P E] [Algebra.Etale P E] (φ : E →ₐ[P] R)
      (e : E), φ e ∈ H := fun E _ _ _ φ e =>
    (mem _).2 ⟨E, inferInstance, inferInstance, inferInstance, φ, AlgHom.mem_range_self φ e⟩
  have s2 : ∀ (I : Ideal H) (x : H), (x : R) ∈ Ideal.map H.subtype I → x ∈ I := by
    intro I x hx
    have hx' : (x : R) ∈ Submodule.span R (H.subtype '' (I : Set H)) := hx
    obtain ⟨n, c, g', hsum⟩ := Submodule.mem_span_set'.mp hx'
    have hg : ∀ i, ∃ g : H, g ∈ I ∧ (g : R) = (g' i : R) := by
      intro i
      obtain ⟨g, hgI, hgeq⟩ := (g' i).2
      exact ⟨g, hgI, hgeq⟩
    choose g hgI hgeq using hg
    obtain ⟨E, iE, iA, iEt, φ, hF⟩ :=
      fin (insert (x : R) (Finset.univ.image (fun i => (g i : R)))) (by
        intro y hy
        rcases Finset.mem_insert.mp hy with h | h
        · rw [h]; exact x.2
        · obtain ⟨i, _, rfl⟩ := Finset.mem_image.mp h
          exact (g i).2)
    obtain ⟨z, hz⟩ := (AlgHom.mem_range φ).1 (hF _ (Finset.mem_insert_self _ _))
    have ha : ∀ i, ∃ a : E, φ a = (g i : R) := fun i =>
      (AlgHom.mem_range φ).1 (hF _ (Finset.mem_insert_of_mem
        (Finset.mem_image_of_mem _ (Finset.mem_univ i))))
    choose a ha using ha
    have hmem : φ z ∈ Ideal.span (Set.range (fun i => φ (a i))) := by
      rw [Ideal.mem_span_range_iff_exists_fun]
      refine ⟨c, ?_⟩
      rw [hz, ← hsum]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [ha i, hgeq i, smul_eq_mul]
    obtain ⟨s, hs, hsz⟩ := KBR E φ n a z hmem
    obtain ⟨d, hd⟩ := (Ideal.mem_span_range_iff_exists_fun).1 hsz
    have h2 : φ s * (x : R) = ∑ i, φ (d i) * (g i : R) := by
      rw [← hz, ← map_mul, ← hd, map_sum]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [map_mul, ha i]
    obtain ⟨y, hyH, hy⟩ := inv (φ s) (s1 E φ s) hs
    have h3 : (x : R) = ∑ i, (y * φ (d i)) * (g i : R) := by
      calc (x : R) = y * (φ s * (x : R)) := by
            rw [← mul_assoc, mul_comm y, hy, one_mul]
        _ = _ := by
            rw [h2, Finset.mul_sum]
            refine Finset.sum_congr rfl (fun i _ => by ring)
    let t : Fin n → H := fun i => ⟨y * φ (d i), H.mul_mem hyH (s1 E φ (d i))⟩
    have hxeq : x = ∑ i, t i * g i := by
      apply Subtype.ext
      change (x : R) = H.subtype (∑ i, t i * g i)
      rw [h3, map_sum]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rfl
    rw [hxeq]
    exact Ideal.sum_mem I (fun i _ => Ideal.mul_mem_left I (t i) (hgI i))
  have s3 : ∀ I : Ideal H, Ideal.comap H.subtype (Ideal.map H.subtype I) = I := fun I =>
    le_antisymm (fun x hx => s2 I x (Ideal.mem_comap.mp hx)) Ideal.le_comap_map
  have s4 : StrictMono (fun I : Ideal H => Ideal.map H.subtype I) := by
    apply Monotone.strictMono_of_injective
    · intro I J h
      exact Ideal.map_mono h
    · intro I J h
      have h' := congrArg (Ideal.comap H.subtype) h
      simp only at h'
      rwa [s3, s3] at h'
  haveI : WellFoundedGT (Ideal R) := isNoetherian_iff.mp (isNoetherianRing_iff.mp ‹_›)
  have hWF : WellFoundedGT (Ideal H) := s4.wellFoundedGT
  exact isNoetherianRing_iff.mpr (isNoetherian_iff.mpr hWF)

theorem wc_hnas_hs_hull_lift_exists : (∀ (P : Type u) [CommRing P] (R : Type u) [CommRing R] [Algebra P R] (E₁ : Type u) [CommRing E₁] [Algebra P E₁] [Algebra.Etale P E₁] (E₂ : Type u) [CommRing E₂] [Algebra P E₂] [Algebra.Etale P E₂] (φ₁ : E₁ →ₐ[P] R) (φ₂ : E₂ →ₐ[P] R), ∃ (E : Type u) (_ : CommRing E) (_ : Algebra P E) (_ : Algebra.Etale P E) (φ : E →ₐ[P] R) (i₁ : E₁ →ₐ[P] E) (i₂ : E₂ →ₐ[P] E), φ.comp i₁ = φ₁ ∧ φ.comp i₂ = φ₂) → (∀ (P : Type u) [CommRing P] (A : Type u) [CommRing A] [HenselianLocalRing A] [Algebra P A] (E : Type u) [CommRing E] [Algebra P E] [Algebra.Etale P E] (σ : E →+* IsLocalRing.ResidueField A), σ.comp (algebraMap P E) = (IsLocalRing.residue A).comp (algebraMap P A) → ∃ τ : E →ₐ[P] A, ∀ x : E, IsLocalRing.residue A (τ x) = σ x) → (∀ (P : Type u) [CommRing P] (E : Type u) [CommRing E] [Algebra P E] [Algebra.Etale P E] (A : Type u) [CommRing A] [IsLocalRing A] [Algebra P A] (τ τ' : E →ₐ[P] A), (∀ x : E, IsLocalRing.residue A (τ x) = IsLocalRing.residue A (τ' x)) → τ = τ') → ∀ (P : Type u) [CommRing P] [IsLocalRing P] (R : Type u) [CommRing R] [IsLocalRing R] [Algebra P R] [IsLocalHom (algebraMap P R)] (H : Subring R) (ι : P →+* ↥H), (∀ p : P, (ι p : R) = algebraMap P R p) → (∀ r : R, ∃ p : P, r - algebraMap P R p ∈ IsLocalRing.maximalIdeal R) → (∀ x : R, x ∈ H ↔ ∃ (E : Type u) (_ : CommRing E) (_ : Algebra P E) (_ : Algebra.Etale P E) (φ : E →ₐ[P] R), x ∈ φ.range) → (∀ x ∈ H, IsUnit x → ∃ y ∈ H, x * y = 1) → (∀ (E : Type u) [CommRing E] [Algebra P E] [Algebra.Etale P E] (φ : E →ₐ[P] R) (z : E), φ z = 0 → ∃ s : E, IsUnit (φ s) ∧ s * z = 0) → ∀ (A : Type u) [CommRing A] [HenselianLocalRing A] (g : P →+* A), IsLocalHom g → ∃ h : ↥H →+* A, IsLocalHom h ∧ h.comp ι = g :=
by
  intro M ES UQ P _ _ R _ _ _ _ H ι hι resP mem inv K0 A _ _ g hg
  classical
  letI : Algebra P A := g.toAlgebra
  haveI := hg

  let κb : IsLocalRing.ResidueField P →+* IsLocalRing.ResidueField R :=
    IsLocalRing.ResidueField.map (algebraMap P R)
  have κinj : Function.Injective κb := κb.injective
  have κsurj : Function.Surjective κb := by
    intro y
    obtain ⟨r, rfl⟩ := IsLocalRing.residue_surjective y
    obtain ⟨p, hp⟩ := resP r
    refine ⟨IsLocalRing.residue P p, ?_⟩
    have h1 : IsLocalRing.residue R (r - algebraMap P R p) = 0 :=
      (IsLocalRing.residue_eq_zero_iff _).2 hp
    rw [map_sub, sub_eq_zero] at h1
    rw [h1]
    exact IsLocalRing.ResidueField.map_residue _ p
  let e := RingEquiv.ofBijective κb ⟨κinj, κsurj⟩
  have he : ∀ a, e a = κb a := fun a => rfl
  let θ : IsLocalRing.ResidueField R →+* IsLocalRing.ResidueField A :=
    (IsLocalRing.ResidueField.map g).comp e.symm.toRingHom
  let ρ : R →+* IsLocalRing.ResidueField A := θ.comp (IsLocalRing.residue R)
  have hρP : ∀ p : P, ρ (algebraMap P R p) = IsLocalRing.residue A (g p) := by
    intro p
    have h1 : IsLocalRing.residue R (algebraMap P R p) = e (IsLocalRing.residue P p) := by
      rw [he]
      exact (IsLocalRing.ResidueField.map_residue _ p).symm
    show IsLocalRing.ResidueField.map g (e.symm (IsLocalRing.residue R (algebraMap P R p))) = _
    rw [h1, RingEquiv.symm_apply_apply, IsLocalRing.ResidueField.map_residue]
  have hρ0 : ∀ x : R, ρ x = 0 ↔ x ∈ IsLocalRing.maximalIdeal R := by
    intro x
    rw [← IsLocalRing.residue_eq_zero_iff]
    constructor
    · intro hx
      exact θ.injective (by rw [map_zero]; exact hx)
    · intro hx
      show θ _ = 0
      rw [hx, map_zero]
  have hunit : ∀ x : R, IsUnit x → ρ x ≠ 0 := by
    intro x hx h0
    exact (IsLocalRing.mem_maximalIdeal x).1 ((hρ0 x).1 h0) hx

  have Sec : ∀ (E : Type u) [CommRing E] [Algebra P E] [Algebra.Etale P E] (φ : E →ₐ[P] R),
      ∃ τ : E →ₐ[P] A, ∀ x : E, IsLocalRing.residue A (τ x) = ρ (φ x) := by
    intro E _ _ _ φ
    obtain ⟨τ, hτ⟩ := ES P A E (ρ.comp (φ : E →+* R)) (by
      ext p
      show ρ (φ (algebraMap P E p)) = IsLocalRing.residue A (algebraMap P A p)
      rw [AlgHom.commutes, hρP]
      rfl)
    exact ⟨τ, fun x => hτ x⟩

  have Compat : ∀ (E₁ : Type u) [CommRing E₁] [Algebra P E₁] [Algebra.Etale P E₁]
      (φ₁ : E₁ →ₐ[P] R) (τ₁ : E₁ →ₐ[P] A),
      (∀ x : E₁, IsLocalRing.residue A (τ₁ x) = ρ (φ₁ x)) →
      ∀ (E₂ : Type u) [CommRing E₂] [Algebra P E₂] [Algebra.Etale P E₂]
      (φ₂ : E₂ →ₐ[P] R) (τ₂ : E₂ →ₐ[P] A),
      (∀ x : E₂, IsLocalRing.residue A (τ₂ x) = ρ (φ₂ x)) →
      ∀ (e₁ : E₁) (e₂ : E₂), φ₁ e₁ = φ₂ e₂ → τ₁ e₁ = τ₂ e₂ := by
    intro E₁ _ _ _ φ₁ τ₁ hτ₁ E₂ _ _ _ φ₂ τ₂ hτ₂ e₁ e₂ he₁₂
    obtain ⟨E, _, _, _, φ, i₁, i₂, h₁, h₂⟩ := M P R E₁ E₂ φ₁ φ₂
    obtain ⟨τ, hτ⟩ := Sec E φ
    have hφ₁ : ∀ x, φ (i₁ x) = φ₁ x := fun x => by rw [← h₁]; rfl
    have hφ₂ : ∀ x, φ (i₂ x) = φ₂ x := fun x => by rw [← h₂]; rfl
    have u₁ : τ.comp i₁ = τ₁ := UQ P E₁ A (τ.comp i₁) τ₁ (fun x => by
      rw [AlgHom.comp_apply, hτ, hφ₁, hτ₁])
    have u₂ : τ.comp i₂ = τ₂ := UQ P E₂ A (τ.comp i₂) τ₂ (fun x => by
      rw [AlgHom.comp_apply, hτ, hφ₂, hτ₂])
    obtain ⟨s, hs, hsz⟩ := K0 E φ (i₁ e₁ - i₂ e₂) (by rw [map_sub, hφ₁, hφ₂, he₁₂, sub_self])
    have hτs : IsUnit (τ s) := by
      rw [← IsLocalRing.residue_ne_zero_iff_isUnit, hτ]
      exact hunit _ hs
    have hz : τ (i₁ e₁ - i₂ e₂) = 0 := by
      have h0 : τ s * τ (i₁ e₁ - i₂ e₂) = 0 := by rw [← map_mul, hsz, map_zero]
      exact hτs.mul_right_eq_zero.1 h0
    rw [map_sub, sub_eq_zero] at hz
    rw [← u₁, ← u₂, AlgHom.comp_apply, AlgHom.comp_apply, hz]

  have hex : ∀ x : ↥H, ∃ a : A, ∃ (E : Type u) (_ : CommRing E) (_ : Algebra P E)
      (_ : Algebra.Etale P E) (φ : E →ₐ[P] R) (τ : E →ₐ[P] A),
      (∀ y, IsLocalRing.residue A (τ y) = ρ (φ y)) ∧ ∃ e, φ e = (x : R) ∧ τ e = a := by
    intro x
    obtain ⟨E, _, _, _, φ, hx⟩ := (mem x).1 x.2
    obtain ⟨e, hxe⟩ := (AlgHom.mem_range φ).1 hx
    obtain ⟨τ, hτ⟩ := Sec E φ
    exact ⟨τ e, E, inferInstance, inferInstance, inferInstance, φ, τ, hτ, e, hxe, rfl⟩
  choose h₀ hh₀ using hex
  have star : ∀ (E : Type u) [CommRing E] [Algebra P E] [Algebra.Etale P E]
      (φ : E →ₐ[P] R) (τ : E →ₐ[P] A), (∀ y, IsLocalRing.residue A (τ y) = ρ (φ y)) →
      ∀ (x : ↥H) (e : E), φ e = (x : R) → h₀ x = τ e := by
    intro E _ _ _ φ τ hτ x e hxe
    obtain ⟨E', _, _, _, φ', τ', hτ', e', he', hτe'⟩ := hh₀ x
    rw [← hτe']
    exact Compat E' φ' τ' hτ' E φ τ hτ e' e (he'.trans hxe.symm)
  have common : ∀ x y : ↥H, ∃ (E : Type u) (_ : CommRing E) (_ : Algebra P E)
      (_ : Algebra.Etale P E) (φ : E →ₐ[P] R) (τ : E →ₐ[P] A),
      (∀ z, IsLocalRing.residue A (τ z) = ρ (φ z)) ∧
      ∃ a b : E, φ a = (x : R) ∧ φ b = (y : R) := by
    intro x y
    obtain ⟨E₁, _, _, _, φ₁, hx⟩ := (mem x).1 x.2
    obtain ⟨e₁, he₁⟩ := (AlgHom.mem_range φ₁).1 hx
    obtain ⟨E₂, _, _, _, φ₂, hy⟩ := (mem y).1 y.2
    obtain ⟨e₂, he₂⟩ := (AlgHom.mem_range φ₂).1 hy
    obtain ⟨E, _, _, _, φ, i₁, i₂, h₁, h₂⟩ := M P R E₁ E₂ φ₁ φ₂
    obtain ⟨τ, hτ⟩ := Sec E φ
    refine ⟨E, inferInstance, inferInstance, inferInstance, φ, τ, hτ, i₁ e₁, i₂ e₂, ?_, ?_⟩
    · rw [← he₁, ← h₁]; rfl
    · rw [← he₂, ← h₂]; rfl
  have hone : h₀ 1 = 1 := by
    obtain ⟨E, _, _, _, φ, τ, hτ, a, _, _, _⟩ := common 1 1
    rw [star E φ τ hτ 1 1 (by rw [map_one]; rfl), map_one]
  have hzero : h₀ 0 = 0 := by
    obtain ⟨E, _, _, _, φ, τ, hτ, a, _, _, _⟩ := common 0 0
    rw [star E φ τ hτ 0 0 (by rw [map_zero]; rfl), map_zero]
  have hadd : ∀ x y : ↥H, h₀ (x + y) = h₀ x + h₀ y := by
    intro x y
    obtain ⟨E, _, _, _, φ, τ, hτ, a, b, ha, hb⟩ := common x y
    rw [star E φ τ hτ x a ha, star E φ τ hτ y b hb,
      star E φ τ hτ (x + y) (a + b) (by rw [map_add, ha, hb]; rfl), map_add]
  have hmul : ∀ x y : ↥H, h₀ (x * y) = h₀ x * h₀ y := by
    intro x y
    obtain ⟨E, _, _, _, φ, τ, hτ, a, b, ha, hb⟩ := common x y
    rw [star E φ τ hτ x a ha, star E φ τ hτ y b hb,
      star E φ τ hτ (x * y) (a * b) (by rw [map_mul, ha, hb]; rfl), map_mul]
  let h : ↥H →+* A :=
    { toFun := h₀, map_one' := hone, map_mul' := hmul, map_zero' := hzero, map_add' := hadd }
  have hcomp : h.comp ι = g := by
    ext p
    obtain ⟨E, _, _, _, φ, τ, hτ, _, _, _, _⟩ := common (ι p) (ι p)
    show h₀ (ι p) = g p
    exact (star E φ τ hτ (ι p) (algebraMap P E p) (by rw [AlgHom.commutes, hι])).trans
      (τ.commutes p)
  have hloc : IsLocalHom h := by
    constructor
    intro x hx
    obtain ⟨E, _, _, _, φ, τ, hτ, a, _, ha, _⟩ := common x x
    have h1 : h x = τ a := star E φ τ hτ x a ha
    rw [h1, ← IsLocalRing.residue_ne_zero_iff_isUnit, hτ, ha] at hx
    have hxu : IsUnit (x : R) := by
      by_contra hn
      exact hx ((hρ0 _).2 ((IsLocalRing.mem_maximalIdeal _).2 hn))
    obtain ⟨y, hy, hxy⟩ := inv x x.2 hxu
    exact isUnit_iff_exists_inv.2 ⟨⟨y, hy⟩, Subtype.ext hxy⟩
  exact ⟨h, hloc, hcomp⟩

theorem wc_hnas_hs_hull_lift_unique : ∀ (P : Type u) [CommRing P] (R : Type u) [CommRing R] [Algebra P R] (H : Subring R) [IsLocalRing ↥H] (ι : P →+* ↥H), (∀ p : P, (ι p : R) = algebraMap P R p) → (∀ x : ↥H, ∃ p : P, x - ι p ∈ IsLocalRing.maximalIdeal ↥H) → (∀ x : R, x ∈ H ↔ ∃ (E : Type u) (_ : CommRing E) (_ : Algebra P E) (_ : Algebra.Etale P E) (φ : E →ₐ[P] R), x ∈ φ.range) → (∀ (P : Type u) [CommRing P] (E : Type u) [CommRing E] [Algebra P E] [Algebra.Etale P E] (A : Type u) [CommRing A] [IsLocalRing A] [Algebra P A] (τ τ' : E →ₐ[P] A), (∀ x : E, IsLocalRing.residue A (τ x) = IsLocalRing.residue A (τ' x)) → τ = τ') → ∀ (A : Type u) [CommRing A] [IsLocalRing A] (g : P →+* A) (h h' : ↥H →+* A), IsLocalHom h → IsLocalHom h' → h.comp ι = g → h'.comp ι = g → h = h' :=
by
  intro P _ R _ _ H _ ι hι hres mem U A _ _ g h h' hh hh' hc hc'
  ext x
  obtain ⟨E, _, _, _, φ, hxφ⟩ := (mem x.1).1 x.2
  obtain ⟨e, he⟩ := (AlgHom.mem_range φ).1 hxφ
  have hφH : ∀ y : E, (φ : E →+* R) y ∈ H := fun y =>
    (mem _).2 ⟨E, inferInstance, inferInstance, inferInstance, φ, AlgHom.mem_range_self φ y⟩
  let φH : E →+* ↥H := (φ : E →+* R).codRestrict H hφH
  have hφHe : φH e = x := Subtype.ext he
  have key : ∀ p : P, φH (algebraMap P E p) = ι p := fun p => Subtype.ext (by
    show φ (algebraMap P E p) = (ι p : R)
    rw [φ.commutes p, hι p])
  letI : Algebra P A := g.toAlgebra
  let τ : E →ₐ[P] A :=
    { toRingHom := h.comp φH
      commutes' := fun p => by
        show h (φH (algebraMap P E p)) = g p
        rw [key p, ← hc]; rfl }
  let τ' : E →ₐ[P] A :=
    { toRingHom := h'.comp φH
      commutes' := fun p => by
        show h' (φH (algebraMap P E p)) = g p
        rw [key p, ← hc']; rfl }
  have hres' : ∀ y : E, IsLocalRing.residue A (τ y) = IsLocalRing.residue A (τ' y) := by
    intro y
    obtain ⟨p, hp⟩ := hres (φH y)
    have h1 : h (φH y - ι p) ∈ IsLocalRing.maximalIdeal A := map_nonunit h _ hp
    have h2 : h' (φH y - ι p) ∈ IsLocalRing.maximalIdeal A := map_nonunit h' _ hp
    rw [map_sub] at h1 h2
    have e1 : h (ι p) = g p := by rw [← hc]; rfl
    have e2 : h' (ι p) = g p := by rw [← hc']; rfl
    rw [e1] at h1
    rw [e2] at h2
    have h3 := Ideal.sub_mem _ h1 h2
    rw [sub_sub_sub_cancel_right] at h3
    show IsLocalRing.residue A (h (φH y)) = IsLocalRing.residue A (h' (φH y))
    rw [← sub_eq_zero, ← map_sub, IsLocalRing.residue_eq_zero_iff]
    exact h3
  have hτ := U P E A τ τ' hres'
  have hev : τ e = τ' e := by rw [hτ]
  rw [← hφHe]
  exact hev

theorem wc_hnas_hs_hull_max_ideal : ∀ (P : Type u) [CommRing P] [IsLocalRing P] (R : Type u) [CommRing R] [IsLocalRing R] [Algebra P R] (H : Subring R) [IsLocalRing ↥H] (ι : P →+* ↥H), (∀ p : P, (ι p : R) = algebraMap P R p) → IsLocalHom ι → (∀ x : R, x ∈ H ↔ ∃ (E : Type u) (_ : CommRing E) (_ : Algebra P E) (_ : Algebra.Etale P E) (φ : E →ₐ[P] R), x ∈ φ.range) → (∀ x ∈ H, IsUnit x → ∃ y ∈ H, x * y = 1) → (∀ (E : Type u) [CommRing E] [Algebra P E] [Algebra.Etale P E] (φ : E →ₐ[P] R) (e : E), φ e ∈ IsLocalRing.maximalIdeal R → ∃ s : E, IsUnit (φ s) ∧ s * e ∈ Ideal.map (algebraMap P E) (IsLocalRing.maximalIdeal P)) → Ideal.map ι (IsLocalRing.maximalIdeal P) = IsLocalRing.maximalIdeal ↥H :=
by
  intro P _ _ R _ _ _ H _ ι hι hloc mem inv hK
  haveI := hloc
  have s2 : ∀ z : ↥H, IsUnit (z : R) → IsUnit z := by
    intro z hz
    obtain ⟨y, hyH, hy⟩ := inv (z : R) z.2 hz
    refine IsUnit.of_mul_eq_one (⟨y, hyH⟩ : ↥H) ?_
    apply Subtype.ext
    simpa using hy
  refine le_antisymm (IsLocalRing.map_maximalIdeal_le ι) ?_
  intro x hx
  have hxn : ¬ IsUnit x := (IsLocalRing.mem_maximalIdeal x).1 hx
  obtain ⟨E, iE1, iE2, iE3, φ, hxφ⟩ := (mem (x : R)).1 x.2
  obtain ⟨e, he⟩ := (AlgHom.mem_range φ).1 hxφ
  have hxR : φ e ∈ IsLocalRing.maximalIdeal R := by
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, he]
    exact fun h => hxn (s2 x h)
  obtain ⟨s, hs, hse⟩ := hK E φ e hxR
  have hφH : ∀ t, (φ : E →+* R) t ∈ H := fun t =>
    (mem _).2 ⟨E, iE1, iE2, iE3, φ, AlgHom.mem_range_self φ t⟩
  let ψ : E →+* ↥H := (φ : E →+* R).codRestrict H hφH
  have hψι : ψ.comp (algebraMap P E) = ι := by
    refine RingHom.ext fun p => Subtype.ext ?_
    show φ (algebraMap P E p) = (ι p : R)
    rw [φ.commutes p, hι p]
  have hψe : ψ e = x := Subtype.ext he
  have hψs : IsUnit (ψ s) := s2 (ψ s) hs
  have h1 : ψ (s * e) ∈ Ideal.map ψ (Ideal.map (algebraMap P E) (IsLocalRing.maximalIdeal P)) :=
    Ideal.mem_map_of_mem ψ hse
  rw [Ideal.map_map, hψι, map_mul, hψe] at h1
  exact (Ideal.unit_mul_mem_iff_mem _ hψs).1 h1

theorem wc_hnas_henselization_exists : ∀ (P : Type u) [CommRing P] [IsLocalRing P] [IsNoetherianRing P], ∃ (H : Type u) (_ : CommRing H) (_ : HenselianLocalRing H) (_ : IsNoetherianRing H) (ι : P →+* H), IsLocalHom ι ∧ (∀ x : H, ∃ y : P, x - ι y ∈ IsLocalRing.maximalIdeal H) ∧ Ideal.map ι (IsLocalRing.maximalIdeal P) = IsLocalRing.maximalIdeal H ∧ (∀ (A : Type u) [CommRing A] [HenselianLocalRing A] (g : P →+* A), IsLocalHom g → ∃! h : H →+* A, IsLocalHom h ∧ h.comp ι = g) ∧ (∀ F : Finset H, ∃ (E : Type u) (_ : CommRing E) (_ : Algebra P E) (_ : Algebra.Etale P E) (e : E →+* H), e.comp (algebraMap P E) = ι ∧ ∀ t ∈ F, t ∈ e.range) :=
by
  intro P _ _ _
  classical
  have ES : ∀ (P' : Type u) [CommRing P'] (A : Type u) [CommRing A] [HenselianLocalRing A]
      [Algebra P' A] (E : Type u) [CommRing E] [Algebra P' E] [Algebra.Etale P' E]
      (σ : E →+* IsLocalRing.ResidueField A),
      σ.comp (algebraMap P' E) = (IsLocalRing.residue A).comp (algebraMap P' A) →
      ∃ τ : E →ₐ[P'] A, ∀ x : E, IsLocalRing.residue A (τ x) = σ x := by
    intro P' _ A _ _ _
    exact wc_hnas_hs_etale_section_over_base P' A
      (fun E _ _ _ σ => wc_hnas_smooth_section_henselian A E σ)
  have key : ∀ (R : Type u) [CommRing R] [Algebra P R] [HenselianLocalRing R] [IsNoetherianRing R]
      [IsLocalHom (algebraMap P R)],
      (∀ r : R, ∃ p : P, r - algebraMap P R p ∈ IsLocalRing.maximalIdeal R) →
      (∀ (k : ℕ) (c : R), ∃ p : P, c - algebraMap P R p ∈
        Ideal.map (algebraMap P R) (IsLocalRing.maximalIdeal P ^ k)) →
      (∀ (k : ℕ) (p : P), algebraMap P R p ∈
        Ideal.map (algebraMap P R) (IsLocalRing.maximalIdeal P ^ k) →
        p ∈ IsLocalRing.maximalIdeal P ^ k) →
      ∃ (H : Type u) (_ : CommRing H) (_ : HenselianLocalRing H) (_ : IsNoetherianRing H)
        (ι : P →+* H), IsLocalHom ι ∧ (∀ x : H, ∃ y : P, x - ι y ∈ IsLocalRing.maximalIdeal H) ∧
        Ideal.map ι (IsLocalRing.maximalIdeal P) = IsLocalRing.maximalIdeal H ∧
        (∀ (A : Type u) [CommRing A] [HenselianLocalRing A] (g : P →+* A), IsLocalHom g →
          ∃! h : H →+* A, IsLocalHom h ∧ h.comp ι = g) ∧
        (∀ F : Finset H, ∃ (E : Type u) (_ : CommRing E) (_ : Algebra P E) (_ : Algebra.Etale P E)
          (e : E →+* H), e.comp (algebraMap P E) = ι ∧ ∀ t ∈ F, t ∈ e.range) := by
    intro R _ _ _ _ _ resP levS levI
    obtain ⟨Hs, mem, fin⟩ := wc_hnas_hs_etale_hull_subring wc_hnas_hs_etale_chart_merge P R
    have inv : ∀ x ∈ Hs, IsUnit x → ∃ y ∈ Hs, x * y = 1 := by
      intro x hx hu
      obtain ⟨E, _, _, _, φ, hxφ⟩ := (mem x).1 hx
      obtain ⟨e, rfl⟩ := (AlgHom.mem_range φ).1 hxφ
      obtain ⟨E', _, _, _, φ', y, hy⟩ := wc_hnas_hs_etale_inverse P R E φ e hu
      exact ⟨φ' y, (mem _).2 ⟨E', inferInstance, inferInstance, inferInstance, φ',
        AlgHom.mem_range_self φ' y⟩, by rw [mul_comm]; exact hy⟩
    obtain ⟨hHloc, _hHsub, char⟩ := wc_hnas_hs_inverse_closed_subring_local R Hs inv
    haveI := hHloc
    have hPmem : ∀ p : P, algebraMap P R p ∈ Hs := fun p =>
      (mem _).2 ⟨P, inferInstance, inferInstance, inferInstance, Algebra.ofId P R,
        AlgHom.mem_range_self (Algebra.ofId P R) p⟩
    let ι : P →+* Hs := (algebraMap P R).codRestrict Hs hPmem
    have hι : ∀ p : P, (ι p : R) = algebraMap P R p := fun p => rfl
    have sr : ∀ (E : Type u) [CommRing E] [Algebra P E] [Algebra.Etale P E] (φ : E →ₐ[P] R)
        (f : Polynomial E) (b : R), f.Monic → Polynomial.eval₂ (φ : E →+* R) b f = 0 →
        IsUnit (Polynomial.eval₂ (φ : E →+* R) b (Polynomial.derivative f)) → b ∈ Hs := by
      intro E _ _ _ φ f b hf h1 h2
      obtain ⟨E', _, _, _, φ', hb⟩ := wc_hnas_hs_etale_simple_root P R E φ f b hf h1 h2
      exact (mem b).2 ⟨E', inferInstance, inferInstance, inferInstance, φ', hb⟩
    haveI hHhen : HenselianLocalRing Hs := wc_hnas_hs_hull_henselian P R Hs char fin sr
    have KBR := wc_hnas_hs_etale_ideal_descent P R wc_hnas_hs_etale_local_ring_levels resP levS levI
    have K0 : ∀ (E : Type u) [CommRing E] [Algebra P E] [Algebra.Etale P E] (φ : E →ₐ[P] R)
        (z : E), φ z = 0 → ∃ s : E, IsUnit (φ s) ∧ s * z = 0 := by
      intro E _ _ _ φ z hz
      obtain ⟨s, hs, hsz⟩ := KBR E φ 0 (fun i => i.elim0) z (by rw [hz]; exact Ideal.zero_mem _)
      refine ⟨s, hs, ?_⟩
      rw [Set.range_eq_empty, Ideal.span_empty, Ideal.mem_bot] at hsz
      exact hsz
    haveI hHnoeth : IsNoetherianRing Hs := wc_hnas_hs_hull_noetherian P R Hs mem fin inv KBR
    have hιloc : IsLocalHom ι := by
      constructor
      intro p hp
      exact (isUnit_map_iff (algebraMap P R) p).1 (hp.map Hs.subtype)
    have hres : ∀ x : Hs, ∃ y : P, x - ι y ∈ IsLocalRing.maximalIdeal Hs := by
      intro x
      obtain ⟨p, hp⟩ := resP x
      exact ⟨p, (char _).2 hp⟩
    have hmax : Ideal.map ι (IsLocalRing.maximalIdeal P) = IsLocalRing.maximalIdeal Hs :=
      wc_hnas_hs_hull_max_ideal P R Hs ι hι hιloc mem inv
        (wc_hnas_hs_unramified_max_ideal_local P R)
    refine ⟨Hs, inferInstance, hHhen, hHnoeth, ι, hιloc, hres, hmax, ?_, ?_⟩
    · intro A _ _ g hg
      obtain ⟨h, hh, hc⟩ := wc_hnas_hs_hull_lift_exists wc_hnas_hs_etale_chart_merge ES
        wc_hnas_hs_etale_hom_unique_residue P R Hs ι hι resP mem inv K0 A g hg
      refine ⟨h, ⟨hh, hc⟩, ?_⟩
      rintro h' ⟨hh', hc'⟩
      exact wc_hnas_hs_hull_lift_unique P R Hs ι hι hres mem wc_hnas_hs_etale_hom_unique_residue
        A g h' h hh' hh hc' hc
    · intro F
      obtain ⟨E, _, _, _, φ, hF⟩ := fin (F.image Subtype.val) (by
        intro x hx
        obtain ⟨y, _, rfl⟩ := Finset.mem_image.1 hx
        exact y.2)
      have hφH : ∀ e, (φ : E →+* R) e ∈ Hs := fun e =>
        (mem _).2 ⟨E, inferInstance, inferInstance, inferInstance, φ, AlgHom.mem_range_self φ e⟩
      refine ⟨E, inferInstance, inferInstance, inferInstance,
        (φ : E →+* R).codRestrict Hs hφH, ?_, ?_⟩
      · refine RingHom.ext fun p => Subtype.ext ?_
        show φ (algebraMap P E p) = algebraMap P R p
        exact φ.commutes p
      · intro t ht
        obtain ⟨e, he⟩ := (AlgHom.mem_range φ).1 (hF t (Finset.mem_image_of_mem _ ht))
        exact RingHom.mem_range.2 ⟨e, Subtype.ext he⟩
  obtain ⟨hRloc, hRcomp, hRlh, resP⟩ := wc_hnas_completion_local_complete P
  haveI := hRloc
  haveI := hRcomp
  haveI := hRlh
  haveI : IsNoetherianRing (AdicCompletion (IsLocalRing.maximalIdeal P) P) :=
    wc_hnas_completion_noetherian P
  haveI : HenselianLocalRing (AdicCompletion (IsLocalRing.maximalIdeal P) P) := by
    haveI := IsAdicComplete.henselianRing (AdicCompletion (IsLocalRing.maximalIdeal P) P)
      (IsLocalRing.maximalIdeal (AdicCompletion (IsLocalRing.maximalIdeal P) P))
    exact HenselianLocalRing.mk (fun f hf a₀ h1 h2 =>
      HenselianRing.is_henselian f hf a₀ h1 (h2.map _))
  exact key (AdicCompletion (IsLocalRing.maximalIdeal P) P) resP
    (wc_hnas_hs_completion_levels P).1 (wc_hnas_hs_completion_levels P).2

theorem wc_hnas_range_henselian : ∀ (H : Type u) [CommRing H] [HenselianLocalRing H] (A : Type u) [CommRing A] [IsLocalRing A] (h : H →+* A), IsLocalHom h → ∃ (_ : HenselianLocalRing ↥h.range), IsLocalHom h.range.subtype :=
by
  intro H _ _ A _ _ h hh
  classical
  set ρ : H →+* ↥h.range := h.rangeRestrict with hρdef
  have hρsurj : Function.Surjective ρ := h.rangeRestrict_surjective
  have hιρ : ∀ y, h.range.subtype (ρ y) = h y := fun y => rfl
  haveI : Nontrivial ↥h.range := inferInstance
  letI L : IsLocalRing ↥h.range := IsLocalRing.of_surjective' ρ hρsurj
  have hρunit : ∀ y : H, IsUnit (ρ y) → IsUnit y := by
    intro y hy
    have : IsUnit (h y) := by
      rw [← hιρ y]; exact hy.map _
    exact isUnit_of_map_unit h y this
  have hm1 : ∀ z : H, z ∈ IsLocalRing.maximalIdeal H →
      ρ z ∈ IsLocalRing.maximalIdeal ↥h.range := by
    intro z hz
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hz ⊢
    exact fun hu => hz (hρunit z hu)
  have hm2 : ∀ z : H, ρ z ∈ IsLocalRing.maximalIdeal ↥h.range →
      z ∈ IsLocalRing.maximalIdeal H := by
    intro z hz
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hz ⊢
    exact fun hu => hz (hu.map ρ)
  have hloc : IsLocalHom h.range.subtype := by
    refine ⟨fun x hx => ?_⟩
    obtain ⟨y, rfl⟩ := hρsurj x
    rw [hιρ] at hx
    exact (isUnit_of_map_unit h y hx).map ρ
  refine ⟨{ toIsLocalRing := L, is_henselian := ?_ }, hloc⟩
  intro f hf a₀ h₁ h₂
  have hlift : f ∈ Polynomial.lifts ρ :=
    (Polynomial.mem_lifts f).2 (Polynomial.map_surjective ρ hρsurj f)
  obtain ⟨g, hgf, -, hgm⟩ := Polynomial.lifts_and_degree_eq_and_monic hlift hf
  obtain ⟨b₀, rfl⟩ := hρsurj a₀
  have e1 : ρ (g.eval b₀) = f.eval (ρ b₀) := by
    rw [← hgf, Polynomial.eval_map_apply]
  have e2 : ρ ((Polynomial.derivative g).eval b₀) = (Polynomial.derivative f).eval (ρ b₀) := by
    rw [← hgf, Polynomial.derivative_map, Polynomial.eval_map_apply]
  have g1 : g.eval b₀ ∈ IsLocalRing.maximalIdeal H := hm2 _ (by rw [e1]; exact h₁)
  have g2 : IsUnit ((Polynomial.derivative g).eval b₀) := hρunit _ (by rw [e2]; exact h₂)
  obtain ⟨b, hbroot, hbm⟩ := HenselianLocalRing.is_henselian g hgm b₀ g1 g2
  refine ⟨ρ b, ?_, ?_⟩
  · have : f.eval (ρ b) = ρ (g.eval b) := by
      rw [← hgf, Polynomial.eval_map_apply]
    rw [Polynomial.IsRoot, this, hbroot.eq_zero, map_zero]
  · rw [← map_sub]
    exact hm1 _ hbm

theorem wc_hnas_quotient_complete : ∀ (C : Type u) [CommRing C] [IsLocalRing C] [IsNoetherianRing C] [IsAdicComplete (IsLocalRing.maximalIdeal C) C] (J : Ideal C), J ≠ ⊤ → ∃ (_ : IsLocalRing (C ⧸ J)), IsAdicComplete (IsLocalRing.maximalIdeal (C ⧸ J)) (C ⧸ J) :=
by
  intro C _ _ _ _ J hJ
  haveI hnt : Nontrivial (C ⧸ J) := Ideal.Quotient.nontrivial_iff.mpr hJ
  haveI hloc : IsLocalRing (C ⧸ J) :=
    IsLocalRing.of_surjective' (Ideal.Quotient.mk J) Ideal.Quotient.mk_surjective
  refine ⟨hloc, ?_⟩
  haveI : IsNoetherianRing (C ⧸ J) := Ideal.Quotient.isNoetherianRing J
  have hH : IsHausdorff (IsLocalRing.maximalIdeal (C ⧸ J)) (C ⧸ J) :=
    IsHausdorff.of_isLocalRing (IsLocalRing.maximalIdeal (C ⧸ J)) (C ⧸ J)
      (IsLocalRing.maximalIdeal.isMaximal _).ne_top
  have hmap : (IsLocalRing.maximalIdeal C).map (Ideal.Quotient.mk J) =
      IsLocalRing.maximalIdeal (C ⧸ J) :=
    IsLocalRing.map_maximalIdeal_of_surjective _ Ideal.Quotient.mk_surjective
  have key : ∀ (I : Ideal C) (n : ℕ) (x : C ⧸ J),
      x ∈ (I.map (Ideal.Quotient.mk J)) ^ n • (⊤ : Submodule (C ⧸ J) (C ⧸ J)) ↔
        x ∈ (I ^ n).map (Ideal.Quotient.mk J) := by
    intro I n x
    rw [Ideal.smul_eq_mul, Ideal.mul_top, Ideal.map_pow]
  have keyC : ∀ (I : Ideal C) (n : ℕ) (x : C),
      x ∈ I ^ n • (⊤ : Submodule C C) ↔ x ∈ I ^ n := by
    intro I n x
    rw [Ideal.smul_eq_mul, Ideal.mul_top]
  have hP : IsPrecomplete (IsLocalRing.maximalIdeal (C ⧸ J)) (C ⧸ J) := by
    rw [← hmap]
    constructor
    intro g hg
    have hd : ∀ i, g (i + 1) - g i ∈
        (IsLocalRing.maximalIdeal C ^ i).map (Ideal.Quotient.mk J) := by
      intro i
      have h1 := hg (Nat.le_succ i)
      rw [SModEq.sub_mem, key] at h1
      rw [← neg_sub]
      exact neg_mem h1
    choose e he hfe using fun i =>
      (Ideal.mem_map_iff_of_surjective _ Ideal.Quotient.mk_surjective).mp (hd i)
    obtain ⟨c₀, hc₀⟩ := Ideal.Quotient.mk_surjective (g 0)
    let h : ℕ → C := fun n => c₀ + ∑ i ∈ Finset.range n, e i
    have hfh : ∀ n, Ideal.Quotient.mk J (h n) = g n := by
      intro n
      simp only [h, map_add, map_sum, hfe, hc₀]
      rw [Finset.sum_range_sub (fun i => g i) n]
      abel
    have hcau : ∀ a n, a ≤ n → h n - h a ∈ IsLocalRing.maximalIdeal C ^ a := by
      intro a n han
      induction n, han using Nat.le_induction with
      | base => simp
      | succ k hak ih =>
        have h2 : h (k + 1) - h a = (h k - h a) + e k := by
          simp only [h, Finset.sum_range_succ]; ring
        rw [h2]
        exact add_mem ih (Ideal.pow_le_pow_right hak (he k))
    obtain ⟨L, hL⟩ := IsPrecomplete.prec
      (inferInstance : IsPrecomplete (IsLocalRing.maximalIdeal C) C) (f := h) (by
        intro a n han
        rw [SModEq.sub_mem, keyC, ← neg_sub]
        exact neg_mem (hcau a n han))
    refine ⟨Ideal.Quotient.mk J L, fun n => ?_⟩
    have h3 := hL n
    rw [SModEq.sub_mem, keyC] at h3
    rw [SModEq.sub_mem, key, ← hfh n, ← map_sub]
    exact Ideal.mem_map_of_mem _ h3
  exact { toIsHausdorff := hH, toIsPrecomplete := hP }

theorem wc_hnas_approx_to_range : (∀ (C : Type u) [CommRing C] [IsLocalRing C] [IsNoetherianRing C] [IsAdicComplete (IsLocalRing.maximalIdeal C) C] (J : Ideal C), J ≠ ⊤ → ∃ (_ : IsLocalRing (C ⧸ J)), IsAdicComplete (IsLocalRing.maximalIdeal (C ⧸ J)) (C ⧸ J)) → ∀ (H : Type u) [CommRing H] [IsLocalRing H] [IsNoetherianRing H] (C : Type u) [CommRing C] [IsLocalRing C] [IsNoetherianRing C] [IsAdicComplete (IsLocalRing.maximalIdeal C) C] (θ : H →+* C), IsLocalHom θ → (∀ c : C, ∃ x : H, c - θ x ∈ IsLocalRing.maximalIdeal C) → (∀ (n : ℕ) (s : Finset (MvPolynomial (Fin n) H)) (b : Fin n → C), (∀ f ∈ s, MvPolynomial.eval₂ θ b f = 0) → ∃ a : Fin n → H, (∀ f ∈ s, MvPolynomial.eval a f = 0) ∧ ∀ k, b k - θ (a k) ∈ IsLocalRing.maximalIdeal C) → ∀ (A : Type u) [CommRing A] [Nontrivial A] (h : H →+* A), ∃ (B : Type u) (_ : CommRing B) (_ : IsLocalRing B) (_ : IsNoetherianRing B) (_ : IsAdicComplete (IsLocalRing.maximalIdeal B) B) (φ : ↥h.range →+* B), IsLocalHom φ ∧ (∀ b : B, ∃ a : ↥h.range, b - φ a ∈ IsLocalRing.maximalIdeal B) ∧ (∀ (n : ℕ) (s : Finset (MvPolynomial (Fin n) ↥h.range)) (b : Fin n → B), (∀ f ∈ s, MvPolynomial.eval₂ φ b f = 0) → ∃ a : Fin n → ↥h.range, (∀ f ∈ s, MvPolynomial.eval a f = 0) ∧ ∀ k, b k - φ (a k) ∈ IsLocalRing.maximalIdeal B) :=
by
  classical
  intro Q H _ _ _ C _ _ _ _ θ hθ hres happ A _ _ h
  haveI := hθ

  have happι : ∀ (ι : Type u) [Fintype ι] (s : Finset (MvPolynomial ι H)) (b : ι → C),
      (∀ f ∈ s, MvPolynomial.eval₂ θ b f = 0) → ∃ a : ι → H,
        (∀ f ∈ s, MvPolynomial.eval a f = 0) ∧ ∀ k, b k - θ (a k) ∈ IsLocalRing.maximalIdeal C := by
    intro ι _ s b hb
    let e := Fintype.equivFin ι
    have hbe : (b ∘ e.symm) ∘ e = b := by funext i; simp
    obtain ⟨a'', ha1, ha2⟩ := happ (Fintype.card ι) (s.image (MvPolynomial.rename e))
      (b ∘ e.symm) (by
        intro g hg
        obtain ⟨f, hf, rfl⟩ := Finset.mem_image.mp hg
        rw [MvPolynomial.eval₂_rename, hbe]
        exact hb f hf)
    refine ⟨a'' ∘ e, fun f hf => ?_, fun k => ?_⟩
    · have := ha1 _ (Finset.mem_image_of_mem _ hf)
      rw [MvPolynomial.eval_rename] at this
      exact this
    · have := ha2 (e k)
      simpa using this

  obtain ⟨J, hJ⟩ : ∃ J : Ideal C, J = Ideal.map θ (RingHom.ker h) := ⟨_, rfl⟩
  obtain ⟨m, k, hk⟩ :=
    Submodule.fg_iff_exists_fin_generating_family.mp (IsNoetherian.noetherian (RingHom.ker h))
  have hkK : ∀ j, k j ∈ RingHom.ker h := by
    intro j
    rw [← hk]
    exact Submodule.subset_span ⟨j, rfl⟩
  have hJspan : J = Ideal.span (Set.range (θ ∘ k)) := by
    rw [hJ, ← hk]
    show Ideal.map θ (Ideal.span (Set.range k)) = _
    rw [Ideal.map_span, Set.range_comp]

  have hs1 : ∀ (n : ℕ) (s : Finset (MvPolynomial (Fin n) H)) (c : Fin n → C),
      (∀ f ∈ s, MvPolynomial.eval₂ θ c f ∈ J) →
      ∃ a : Fin n → H, (∀ f ∈ s, MvPolynomial.eval a f ∈ RingHom.ker h) ∧
        ∀ i, c i - θ (a i) ∈ IsLocalRing.maximalIdeal C := by
    intro n s c hc
    have hd : ∀ p : s, ∃ d : Fin m → C,
        ∑ j, d j * (θ ∘ k) j = MvPolynomial.eval₂ θ c (p : MvPolynomial (Fin n) H) := by
      intro p
      have := hc p p.2
      rw [hJspan] at this
      exact (Ideal.mem_span_range_iff_exists_fun).mp this
    choose d hd using hd
    let G : s → MvPolynomial (Fin n ⊕ (s × Fin m)) H := fun p =>
      MvPolynomial.rename Sum.inl (p : MvPolynomial (Fin n) H) -
        ∑ j : Fin m, MvPolynomial.C (k j) * MvPolynomial.X (Sum.inr (p, j))
    obtain ⟨a', ha1, ha2⟩ := happι (Fin n ⊕ (s × Fin m)) (s.attach.image G)
      (Sum.elim c (fun q => d q.1 q.2)) (by
        intro g hg
        obtain ⟨p, -, rfl⟩ := Finset.mem_image.mp hg
        simp only [G, MvPolynomial.eval₂_sub, MvPolynomial.eval₂_rename, MvPolynomial.eval₂_sum,
          MvPolynomial.eval₂_mul, MvPolynomial.eval₂_C, MvPolynomial.eval₂_X, Sum.elim_inr,
          Sum.elim_comp_inl]
        rw [← hd p, sub_eq_zero]
        refine Finset.sum_congr rfl (fun j _ => ?_)
        simp [mul_comm])
    refine ⟨a' ∘ Sum.inl, fun f hf => ?_, fun i => ?_⟩
    · have h0 := ha1 (G ⟨f, hf⟩) (Finset.mem_image_of_mem _ (Finset.mem_attach _ _))
      simp only [G, MvPolynomial.eval_rename, map_sub, map_sum, map_mul, MvPolynomial.eval_C,
        MvPolynomial.eval_X] at h0
      rw [sub_eq_zero] at h0
      rw [h0]
      exact Ideal.sum_mem _ (fun j _ => Ideal.mul_mem_right _ _ (hkK j))
    · simpa using ha2 (Sum.inl i)

  have hKle : RingHom.ker h ≤ IsLocalRing.maximalIdeal H :=
    IsLocalRing.le_maximalIdeal (RingHom.ker_ne_top h)
  have hJle : J ≤ IsLocalRing.maximalIdeal C := by
    rw [hJ]
    apply Ideal.map_le_of_le_comap
    intro x hx
    exact map_nonunit θ x (hKle hx)
  have hJne : J ≠ ⊤ := ne_top_of_le_ne_top (IsLocalRing.maximalIdeal.isMaximal C).ne_top hJle
  obtain ⟨instL, instC⟩ := Q C J hJne
  have hρ : Function.Surjective h.rangeRestrict := h.rangeRestrict_surjective
  haveI hπloc : IsLocalHom (Ideal.Quotient.mk J) :=
    IsLocalHom.of_surjective _ Ideal.Quotient.mk_surjective
  have hπ𝔪 : ∀ x ∈ IsLocalRing.maximalIdeal C,
      Ideal.Quotient.mk J x ∈ IsLocalRing.maximalIdeal (C ⧸ J) :=
    fun x hx => map_nonunit (Ideal.Quotient.mk J) x hx

  have hker : RingHom.ker h.rangeRestrict ≤ RingHom.ker ((Ideal.Quotient.mk J).comp θ) := by
    intro z hz
    rw [RingHom.mem_ker] at hz
    have hz' : h z = 0 := congrArg Subtype.val hz
    rw [RingHom.mem_ker, RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem, hJ]
    exact Ideal.mem_map_of_mem θ hz'
  obtain ⟨φ, hφ⟩ : ∃ φ : ↥h.range →+* C ⧸ J,
      ∀ z, φ (h.rangeRestrict z) = Ideal.Quotient.mk J (θ z) :=
    ⟨h.rangeRestrict.liftOfSurjective hρ ⟨(Ideal.Quotient.mk J).comp θ, hker⟩,
      fun z => h.rangeRestrict.liftOfSurjective_comp_apply hρ ⟨(Ideal.Quotient.mk J).comp θ, hker⟩ z⟩
  have hφloc : IsLocalHom φ := by
    constructor
    intro y hy
    obtain ⟨z, rfl⟩ := hρ y
    rw [hφ] at hy
    have h1 : IsUnit (θ z) := IsLocalHom.map_nonunit _ hy
    have h2 : IsUnit z := IsLocalHom.map_nonunit _ h1
    exact h2.map h.rangeRestrict
  refine ⟨C ⧸ J, inferInstance, instL, inferInstance, instC, φ, hφloc, ?_, ?_⟩

  · intro b
    obtain ⟨c, rfl⟩ := Ideal.Quotient.mk_surjective b
    obtain ⟨x, hx⟩ := hres c
    refine ⟨h.rangeRestrict x, ?_⟩
    rw [hφ, ← map_sub]
    exact hπ𝔪 _ hx

  · intro n s b hb
    obtain ⟨F, hF⟩ : ∃ F : MvPolynomial (Fin n) ↥h.range → MvPolynomial (Fin n) H,
        ∀ f, MvPolynomial.map h.rangeRestrict (F f) = f :=
      ⟨Function.surjInv (MvPolynomial.map_surjective _ hρ),
        Function.surjInv_eq (MvPolynomial.map_surjective _ hρ)⟩
    obtain ⟨c, hc⟩ : ∃ c : Fin n → C, ∀ i, Ideal.Quotient.mk J (c i) = b i :=
      ⟨fun i => Function.surjInv Ideal.Quotient.mk_surjective (b i),
        fun i => Function.surjInv_eq Ideal.Quotient.mk_surjective (b i)⟩
    have hcomp : (Ideal.Quotient.mk J).comp θ = φ.comp h.rangeRestrict := by
      ext z
      simp [hφ]
    have hcb : (Ideal.Quotient.mk J ∘ c) = b := funext hc
    obtain ⟨a, ha1, ha2⟩ := hs1 n (s.image F) c (by
      intro g hg
      obtain ⟨f, hf, rfl⟩ := Finset.mem_image.mp hg
      rw [← Ideal.Quotient.eq_zero_iff_mem, MvPolynomial.eval₂_comp_left, hcomp, hcb,
        ← MvPolynomial.eval₂_map, hF]
      exact hb f hf)
    refine ⟨h.rangeRestrict ∘ a, fun f hf => ?_, fun i => ?_⟩
    · have h0 := ha1 (F f) (Finset.mem_image_of_mem _ hf)
      rw [← hF f, ← MvPolynomial.map_eval]
      exact Subtype.ext (RingHom.mem_ker.mp h0)
    · rw [Function.comp_apply, ← hc i, hφ, ← map_sub]
      exact hπ𝔪 _ (ha2 i)

theorem wc_hnas_approx_of_smooth_factor : ∀ (H : Type u) [CommRing H] [IsLocalRing H] (T : Type u) [CommRing T] [IsLocalRing T] (θ : H →+* T), IsLocalHom θ → (∀ t : T, ∃ x : H, t - θ x ∈ IsLocalRing.maximalIdeal T) → (∀ (D : Type u) [CommRing D] [Algebra H D] [Algebra.Smooth H D] (σ : D →ₐ[H] IsLocalRing.ResidueField H), ∃ τ : D →ₐ[H] H, ∀ x : D, IsLocalRing.residue H (τ x) = σ x) → (∀ (n : ℕ) (s : Finset (MvPolynomial (Fin n) H)) (b : Fin n → T), (∀ f ∈ s, MvPolynomial.eval₂ θ b f = 0) → ∃ (D : Type u) (_ : CommRing D) (_ : Algebra H D) (_ : Algebra.Smooth H D) (c : Fin n → D) (γ : D →+* T), γ.comp (algebraMap H D) = θ ∧ (∀ f ∈ s, MvPolynomial.aeval c f = 0) ∧ ∀ k, γ (c k) = b k) → ∀ (n : ℕ) (s : Finset (MvPolynomial (Fin n) H)) (b : Fin n → T), (∀ f ∈ s, MvPolynomial.eval₂ θ b f = 0) → ∃ a : Fin n → H, (∀ f ∈ s, MvPolynomial.eval a f = 0) ∧ ∀ k, b k - θ (a k) ∈ IsLocalRing.maximalIdeal T :=
by
  intro H _ _ T _ _ θ hθ hR hS hF n s b hb
  have : IsLocalHom θ := hθ
  let ebar : IsLocalRing.ResidueField H →+* IsLocalRing.ResidueField T :=
    IsLocalRing.ResidueField.map θ
  have hres : ∀ x : H, ebar (IsLocalRing.residue H x) = IsLocalRing.residue T (θ x) :=
    fun x => IsLocalRing.ResidueField.map_residue θ x
  have hinj : Function.Injective ebar := ebar.injective
  have hsurj : Function.Surjective ebar := by
    intro y
    obtain ⟨t, rfl⟩ := IsLocalRing.residue_surjective y
    obtain ⟨x, hx⟩ := hR t
    refine ⟨IsLocalRing.residue H x, ?_⟩
    rw [hres]
    have h0 : IsLocalRing.residue T (t - θ x) = 0 := (IsLocalRing.residue_eq_zero_iff _).mpr hx
    rw [map_sub, sub_eq_zero] at h0
    exact h0.symm
  let e : IsLocalRing.ResidueField H ≃+* IsLocalRing.ResidueField T :=
    RingEquiv.ofBijective ebar ⟨hinj, hsurj⟩
  have he : ∀ z, e z = ebar z := fun z => rfl
  obtain ⟨D, _, _, _, c, γ, hγ, hc, hcb⟩ := hF n s b hb
  let σ₀ : D →+* IsLocalRing.ResidueField H :=
    (e.symm : IsLocalRing.ResidueField T →+* IsLocalRing.ResidueField H).comp
      ((IsLocalRing.residue T).comp γ)
  have hK : ∀ x : D, ebar (σ₀ x) = IsLocalRing.residue T (γ x) := by
    intro x
    rw [← he]
    exact e.apply_symm_apply _
  have hcomm : ∀ h : H, σ₀ (algebraMap H D h) = algebraMap H (IsLocalRing.ResidueField H) h := by
    intro h
    apply hinj
    rw [hK, IsLocalRing.ResidueField.algebraMap_eq, hres]
    have := RingHom.congr_fun hγ h
    simp only [RingHom.comp_apply] at this
    rw [this]
  let σ : D →ₐ[H] IsLocalRing.ResidueField H := { σ₀ with commutes' := hcomm }
  have hσ : ∀ x, σ x = σ₀ x := fun x => rfl
  obtain ⟨τ, hτ⟩ := hS D σ
  refine ⟨fun k => τ (c k), ?_, ?_⟩
  · intro f hf
    have h2 : MvPolynomial.eval (fun k => τ (c k)) f = τ (MvPolynomial.aeval c f) := by
      rw [MvPolynomial.comp_aeval_apply, ← MvPolynomial.coe_aeval_eq_eval]
      rfl
    rw [h2, hc f hf, map_zero]
  · intro k
    rw [← IsLocalRing.residue_eq_zero_iff, map_sub, ← hcb k, ← hres, hτ, hσ, hK, sub_self]

theorem wc_hnas_pfc_fibres_of_field : ∀ (P : Type u) [CommRing P] [IsLocalRing P], IsLocalRing.maximalIdeal P = ⊥ → ∀ (Λ : Type u) [CommRing Λ] [Algebra P Λ], Nonempty (AdicCompletion (IsLocalRing.maximalIdeal P) P ≃ₐ[P] Λ) → ∀ (𝔭 : Ideal P) [𝔭.IsPrime] (L : Type u) [Field L] [Algebra P L] [Algebra 𝔭.ResidueField L] [IsScalarTower P 𝔭.ResidueField L] [FiniteDimensional 𝔭.ResidueField L] (𝔔 : Ideal (TensorProduct P L Λ)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔) :=
by
  intro P _ _ h Λ _ _ hΛ 𝔭 _ L _ _ _ _ _ 𝔔 _
  obtain ⟨e₀⟩ := hΛ
  have s1 : IsAdicComplete (IsLocalRing.maximalIdeal P) P := by
    rw [h]; exact IsAdicComplete.bot P
  have hbij : Function.Bijective
      (Algebra.ofId P (AdicCompletion (IsLocalRing.maximalIdeal P) P)) := by
    have hb := AdicCompletion.of_bijective_iff.mpr s1
    convert hb using 1
    funext x
    rw [Algebra.ofId_apply, AdicCompletion.algebraMap_apply, Algebra.algebraMap_self_apply]
  let ε : P ≃ₐ[P] Λ := (AlgEquiv.ofBijective _ hbij).trans e₀
  let ψ : TensorProduct P L Λ ≃+* L :=
    ((Algebra.TensorProduct.congr (AlgEquiv.refl : L ≃ₐ[P] L) ε.symm).trans
      (Algebra.TensorProduct.rid P P L)).toRingEquiv
  have hunit : 𝔔.primeCompl ≤ IsUnit.submonoid (TensorProduct P L Λ) := by
    intro x hx
    rw [IsUnit.mem_submonoid_iff]
    have hx0 : x ≠ 0 := fun h0 => hx (h0 ▸ 𝔔.zero_mem)
    have h1 : ψ x ≠ 0 := (map_ne_zero_iff ψ ψ.injective).mpr hx0
    have h2 : IsUnit (ψ.symm (ψ x)) := h1.isUnit.map ψ.symm
    rwa [RingEquiv.symm_apply_apply] at h2
  let θ := IsLocalization.atUnits (TensorProduct P L Λ) 𝔔.primeCompl
    (S := Localization.AtPrime 𝔔) hunit
  exact IsRegularLocalRing.of_ringEquiv (ψ.symm.trans θ.toRingEquiv)

theorem wc_hnas_pfc_fibres_dvr_char_zero : ∀ (P : Type u) [CommRing P] [IsDomain P] [IsDiscreteValuationRing P], (∀ n : ℕ, n ≠ 0 → (n : P) ≠ 0) → ∀ (Λ : Type u) [CommRing Λ] [Algebra P Λ], Nonempty (AdicCompletion (IsLocalRing.maximalIdeal P) P ≃ₐ[P] Λ) → ∀ (𝔭 : Ideal P) [𝔭.IsPrime] (L : Type u) [Field L] [Algebra P L] [Algebra 𝔭.ResidueField L] [IsScalarTower P 𝔭.ResidueField L] [FiniteDimensional 𝔭.ResidueField L] (𝔔 : Ideal (TensorProduct P L Λ)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔) :=
by

  have s1 : ∀ (T : Type u) [CommRing T] [IsReduced T] [IsArtinianRing T] (𝔔 : Ideal T) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔) := by
    intro T _ _ _ 𝔔 _
    have h : IsField (Localization.AtPrime 𝔔) := IsArtinianRing.isField_of_isReduced_of_isLocalRing _
    letI := h.toField
    infer_instance

  have s2 : ∀ (P : Type u) [CommRing P] [IsDomain P] [IsDiscreteValuationRing P] (Λ : Type u) [CommRing Λ] [Algebra P Λ], Nonempty (AdicCompletion (IsLocalRing.maximalIdeal P) P ≃ₐ[P] Λ) → ∀ ϖ : P, Irreducible ϖ → IsLocalRing Λ ∧ IsNoetherianRing Λ ∧ ¬ IsUnit (algebraMap P Λ ϖ) ∧ ∀ c : Λ, ∃ (p : P) (y : Λ), c = algebraMap P Λ p + algebraMap P Λ ϖ * y := by
    intro P _ _ _ Λ _ _ hε ϖ hϖ
    obtain ⟨ε⟩ := hε
    obtain ⟨hloc, -, hlh, -⟩ := wc_hnas_completion_local_complete P
    haveI := hloc
    haveI := hlh
    haveI := wc_hnas_completion_noetherian P
    refine ⟨RingEquiv.isLocalRing ε.toRingEquiv, isNoetherianRing_of_ringEquiv _ ε.toRingEquiv, ?_, ?_⟩
    · intro hu
      have h1 : IsUnit (algebraMap P (AdicCompletion (IsLocalRing.maximalIdeal P) P) ϖ) := by
        have := hu.map ε.symm
        rwa [AlgEquiv.commutes] at this
      exact hϖ.not_isUnit (isUnit_of_map_unit _ _ h1)
    · intro c
      obtain ⟨p, hp⟩ := (wc_hnas_hs_completion_levels P).1 1 (ε.symm c)
      have hmax : IsLocalRing.maximalIdeal P = Ideal.span {ϖ} :=
        (IsDiscreteValuationRing.irreducible_iff_uniformizer ϖ).mp hϖ
      have hle : IsLocalRing.maximalIdeal P ^ 1 ≤ Ideal.span {ϖ} := by rw [pow_one, hmax]
      have hp' := Ideal.map_mono (f := algebraMap P (AdicCompletion (IsLocalRing.maximalIdeal P) P)) hle hp
      rw [Ideal.map_span, Set.image_singleton, Ideal.mem_span_singleton'] at hp'
      obtain ⟨y', hy'⟩ := hp'
      refine ⟨p, ε y', ?_⟩
      have h2 := congrArg ε hy'
      rw [map_mul, map_sub, AlgEquiv.commutes, AlgEquiv.commutes, AlgEquiv.apply_symm_apply] at h2
      rw [mul_comm (algebraMap P Λ ϖ), h2]
      ring

  have s3 : ∀ (P : Type u) [CommRing P] [IsDomain P] [IsDiscreteValuationRing P] (Λ : Type u) [CommRing Λ] [IsLocalRing Λ] [IsNoetherianRing Λ] [Algebra P Λ] (ϖ : P), Irreducible ϖ → ¬ IsUnit (algebraMap P Λ ϖ) → (∀ c : Λ, ∃ (p : P) (y : Λ), c = algebraMap P Λ p + algebraMap P Λ ϖ * y) → ∀ c : Λ, c ≠ 0 → ∃ (n : ℕ) (v : Λ), IsUnit v ∧ c = algebraMap P Λ ϖ ^ n * v := by
    intro P _ _ _ Λ _ _ _ _ ϖ hϖ hnu hH c hc
    classical
    have hJ : Ideal.span {algebraMap P Λ ϖ} ≠ ⊤ := by
      rw [Ne, Ideal.span_singleton_eq_top]; exact hnu
    have hK := Ideal.iInf_pow_eq_bot_of_isLocalRing (Ideal.span {algebraMap P Λ ϖ}) hJ
    have hex : ∃ i, c ∉ Ideal.span {algebraMap P Λ ϖ} ^ i := by
      by_contra hne
      push_neg at hne
      apply hc
      have h1 : c ∈ ⨅ i, Ideal.span {algebraMap P Λ ϖ} ^ i := Ideal.mem_iInf.mpr hne
      rw [hK] at h1
      exact (Submodule.mem_bot _).mp h1
    have hm0 : Nat.find hex ≠ 0 := by
      intro h0
      have h1 := Nat.find_spec hex
      rw [h0, pow_zero, Ideal.one_eq_top] at h1
      exact h1 Submodule.mem_top
    obtain ⟨n, hn⟩ := Nat.exists_eq_succ_of_ne_zero hm0
    have hcn : c ∈ Ideal.span {algebraMap P Λ ϖ} ^ n := by
      have h1 := Nat.find_min hex (show n < Nat.find hex by omega)
      simpa using h1
    have hcn1 : c ∉ Ideal.span {algebraMap P Λ ϖ} ^ (n+1) := by
      have h1 := Nat.find_spec hex
      rw [hn] at h1
      exact h1
    rw [Ideal.span_singleton_pow, Ideal.mem_span_singleton'] at hcn
    obtain ⟨w, hw⟩ := hcn
    refine ⟨n, w, ?_, by rw [← hw]; ring⟩
    obtain ⟨p, y, hpy⟩ := hH w
    by_cases hp : IsUnit p
    · by_contra hwu
      have h1 : w ∈ IsLocalRing.maximalIdeal Λ := (IsLocalRing.mem_maximalIdeal _).mpr hwu
      have h2 : algebraMap P Λ ϖ * y ∈ IsLocalRing.maximalIdeal Λ :=
        Ideal.mul_mem_right _ _ ((IsLocalRing.mem_maximalIdeal _).mpr hnu)
      have h3 : algebraMap P Λ p ∈ IsLocalRing.maximalIdeal Λ := by
        have h4 := Ideal.sub_mem _ h1 h2
        rwa [hpy, add_sub_cancel_right] at h4
      exact (IsLocalRing.mem_maximalIdeal _).mp h3 (hp.map _)
    · exfalso
      have hpm : p ∈ IsLocalRing.maximalIdeal P := (IsLocalRing.mem_maximalIdeal _).mpr hp
      rw [(IsDiscreteValuationRing.irreducible_iff_uniformizer ϖ).mp hϖ,
        Ideal.mem_span_singleton'] at hpm
      obtain ⟨a, ha⟩ := hpm
      apply hcn1
      rw [Ideal.span_singleton_pow, Ideal.mem_span_singleton']
      refine ⟨algebraMap P Λ a + y, ?_⟩
      rw [← hw, hpy, ← ha, map_mul, pow_succ]
      ring

  have s4 : ∀ (P : Type u) [CommRing P] (Λ : Type u) [CommRing Λ] [Algebra P Λ] (ϖ : P), (∀ c : Λ, ∃ (p : P) (y : Λ), c = algebraMap P Λ p + algebraMap P Λ ϖ * y) → ∀ (L : Type u) [Field L] [Algebra P L], algebraMap P L ϖ = 0 → Nontrivial (TensorProduct P L Λ) → IsField (TensorProduct P L Λ) := by
    intro P _ Λ _ _ ϖ hH L _ _ h0 hnt
    haveI := hnt
    have hsurj : ∀ x : TensorProduct P L Λ, ∃ l : L, x = TensorProduct.tmul P l (1 : Λ) := by
      intro x
      induction x using TensorProduct.induction_on with
      | zero => exact ⟨0, by rw [TensorProduct.zero_tmul]⟩
      | tmul l c =>
        obtain ⟨p, y, rfl⟩ := hH c
        refine ⟨p • l, ?_⟩
        have e1 : TensorProduct.tmul P l (algebraMap P Λ p) = TensorProduct.tmul P (p • l) (1 : Λ) := by
          rw [Algebra.algebraMap_eq_smul_one, TensorProduct.smul_tmul]
        have e2 : TensorProduct.tmul P l (algebraMap P Λ ϖ * y) = 0 := by
          rw [← Algebra.smul_def, ← TensorProduct.smul_tmul, Algebra.smul_def, h0, zero_mul,
            TensorProduct.zero_tmul]
        rw [TensorProduct.tmul_add, e1, e2, add_zero]
      | add x y hx hy =>
        obtain ⟨a, rfl⟩ := hx
        obtain ⟨b, rfl⟩ := hy
        exact ⟨a + b, by rw [TensorProduct.add_tmul]⟩
    refine ⟨exists_pair_ne _, mul_comm, ?_⟩
    intro x hx
    obtain ⟨l, rfl⟩ := hsurj x
    have hl : l ≠ 0 := by
      rintro rfl
      exact hx (TensorProduct.zero_tmul _ _)
    refine ⟨TensorProduct.tmul P l⁻¹ (1 : Λ), ?_⟩
    rw [Algebra.TensorProduct.tmul_mul_tmul, mul_inv_cancel₀ hl, one_mul,
      ← Algebra.TensorProduct.one_def]

  have s5 : ∀ (P : Type u) [CommRing P] (Λ : Type u) [CommRing Λ] [Algebra P Λ] (ϖ : P), (∀ c : Λ, c ≠ 0 → ∃ (n : ℕ) (v : Λ), IsUnit v ∧ c = algebraMap P Λ ϖ ^ n * v) → ∀ (K : Type u) [Field K] [Algebra P K], algebraMap P K ϖ ≠ 0 → (∀ k : K, ∃ (b : P) (n : ℕ), k * algebraMap P K ϖ ^ n = algebraMap P K b) → Nontrivial (TensorProduct P K Λ) → IsField (TensorProduct P K Λ) := by
    intro P _ Λ _ _ ϖ hU K _ _ hπ hden hnt
    haveI := hnt
    have hI : ∀ (a : K) (b : P) (c : Λ),
        TensorProduct.tmul P (a * algebraMap P K b) c = TensorProduct.tmul P a (algebraMap P Λ b * c) := by
      intro a b c
      rw [show a * algebraMap P K b = b • a by rw [Algebra.smul_def, mul_comm],
        TensorProduct.smul_tmul, Algebra.smul_def]
    have key : ∀ (n m : ℕ) (c : Λ), TensorProduct.tmul P (algebraMap P K ϖ ^ n)⁻¹ c =
        TensorProduct.tmul P (algebraMap P K ϖ ^ (n + m))⁻¹ (algebraMap P Λ (ϖ ^ m) * c) := by
      intro n m c
      have h1 : (algebraMap P K ϖ ^ n)⁻¹ =
          (algebraMap P K ϖ ^ (n + m))⁻¹ * algebraMap P K (ϖ ^ m) := by
        rw [map_pow, pow_add, mul_inv, mul_assoc, inv_mul_cancel₀ (pow_ne_zero _ hπ), mul_one]
      rw [h1, hI]
    have hnf : ∀ x : TensorProduct P K Λ, ∃ (n : ℕ) (c : Λ),
        x = TensorProduct.tmul P (algebraMap P K ϖ ^ n)⁻¹ c := by
      intro x
      induction x using TensorProduct.induction_on with
      | zero => exact ⟨0, 0, by rw [TensorProduct.tmul_zero]⟩
      | tmul k c =>
        obtain ⟨b, n, hk⟩ := hden k
        have hπn : algebraMap P K ϖ ^ n ≠ 0 := pow_ne_zero _ hπ
        have hk' : k = (algebraMap P K ϖ ^ n)⁻¹ * algebraMap P K b := by
          rw [eq_inv_mul_iff_mul_eq₀ hπn, mul_comm, hk]
        exact ⟨n, algebraMap P Λ b * c, by rw [hk', hI]⟩
      | add x y hx hy =>
        obtain ⟨n, c, rfl⟩ := hx
        obtain ⟨m, c', rfl⟩ := hy
        refine ⟨n + m, algebraMap P Λ (ϖ ^ m) * c + algebraMap P Λ (ϖ ^ n) * c', ?_⟩
        rw [key n m c, key m n c', add_comm m n, TensorProduct.tmul_add]
    refine ⟨exists_pair_ne _, mul_comm, ?_⟩
    intro x hx
    obtain ⟨n, c, rfl⟩ := hnf x
    have hc : c ≠ 0 := by
      rintro rfl
      exact hx (TensorProduct.tmul_zero _ _)
    obtain ⟨m, v, hv, rfl⟩ := hU c hc
    have ha : (algebraMap P K ϖ ^ n)⁻¹ * algebraMap P K (ϖ ^ m) ≠ 0 :=
      mul_ne_zero (inv_ne_zero (pow_ne_zero _ hπ)) (by rw [map_pow]; exact pow_ne_zero _ hπ)
    refine ⟨TensorProduct.tmul P ((algebraMap P K ϖ ^ n)⁻¹ * algebraMap P K (ϖ ^ m))⁻¹ (↑hv.unit⁻¹ : Λ), ?_⟩
    have e : TensorProduct.tmul P (algebraMap P K ϖ ^ n)⁻¹ (algebraMap P Λ ϖ ^ m * v) =
        TensorProduct.tmul P ((algebraMap P K ϖ ^ n)⁻¹ * algebraMap P K (ϖ ^ m)) v := by
      rw [hI, map_pow]
    rw [e, Algebra.TensorProduct.tmul_mul_tmul, mul_inv_cancel₀ ha,
      IsUnit.mul_val_inv, ← Algebra.TensorProduct.one_def]

  have s6 : ∀ (K : Type u) [Field K] [CharZero K] (L : Type u) [Field L] [Algebra K L] [FiniteDimensional K L] (E : Type u) [CommRing E] [Algebra K E], IsField E → IsReduced (TensorProduct K E L) ∧ IsArtinianRing (TensorProduct K E L) :=
    fun K _ _ L _ _ _ E _ _ h => ⟨(letI := h.toField; haveI : Algebra.FormallyUnramified K L := Algebra.FormallyUnramified.of_isSeparable K L; Algebra.FormallyUnramified.isReduced_of_field E (TensorProduct K E L)), (letI := h.toField; IsArtinianRing.of_finite E (TensorProduct K E L))⟩

  have s7 : ∀ (P : Type u) [CommRing P] [IsDomain P] [IsDiscreteValuationRing P] (ϖ : P), Irreducible ϖ → ∀ (𝔭 : Ideal P) [𝔭.IsPrime], ϖ ∉ 𝔭 → Function.Injective (algebraMap P 𝔭.ResidueField) ∧ ∀ k : 𝔭.ResidueField, ∃ (b : P) (n : ℕ), k * algebraMap P 𝔭.ResidueField ϖ ^ n = algebraMap P 𝔭.ResidueField b := by
    intro P _ _ _ ϖ hϖ 𝔭 _ h
    have hbot : 𝔭 = ⊥ := by
      by_contra hne
      have hmax : 𝔭.IsMaximal := Ideal.IsPrime.isMaximal inferInstance hne
      have h1 := IsLocalRing.eq_maximalIdeal hmax
      rw [h1, (IsDiscreteValuationRing.irreducible_iff_uniformizer ϖ).mp hϖ] at h
      exact h (Ideal.mem_span_singleton_self ϖ)
    refine ⟨?_, ?_⟩
    · rw [RingHom.injective_iff_ker_eq_bot, Ideal.ker_algebraMap_residueField, hbot]
    · intro k
      obtain ⟨z, rfl⟩ : ∃ z : Localization.AtPrime 𝔭,
          algebraMap (Localization.AtPrime 𝔭) 𝔭.ResidueField z = k := by
        rw [IsLocalRing.ResidueField.algebraMap_eq]
        exact IsLocalRing.residue_surjective k
      obtain ⟨x, hz⟩ := IsLocalization.surj 𝔭.primeCompl z
      have hs : (x.2 : P) ≠ 0 := by
        intro h0
        apply x.2.2
        rw [h0]
        exact 𝔭.zero_mem
      obtain ⟨n, u, hu⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hs hϖ
      refine ⟨x.1 * ↑u⁻¹, n, ?_⟩
      have h1 := congrArg (algebraMap (Localization.AtPrime 𝔭) 𝔭.ResidueField) hz
      rw [map_mul, ← IsScalarTower.algebraMap_apply, ← IsScalarTower.algebraMap_apply] at h1
      rw [hu, map_mul, map_pow] at h1
      rw [map_mul, ← h1]
      have hu1 : algebraMap P 𝔭.ResidueField ↑u * algebraMap P 𝔭.ResidueField ↑u⁻¹ = 1 := by
        rw [← map_mul, Units.mul_inv, map_one]
      linear_combination (-(algebraMap (Localization.AtPrime 𝔭) 𝔭.ResidueField z *
        algebraMap P 𝔭.ResidueField ϖ ^ n)) * hu1

  intro P _ _ _ hchar Λ _ _ hΛ 𝔭 _ L _ _ _ _ _ 𝔔 _
  obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible P
  obtain ⟨hloc, hnoeth, hnu, hH⟩ := s2 P Λ hΛ ϖ hϖ
  haveI := hloc
  haveI := hnoeth
  have hU := s3 P Λ ϖ hϖ hnu hH
  have hTnt : Nontrivial (TensorProduct P L Λ) := by
    by_contra hcon
    rw [not_nontrivial_iff_subsingleton] at hcon
    have h1 : (1 : TensorProduct P L Λ) ∈ 𝔔 := by
      rw [Subsingleton.elim (1 : TensorProduct P L Λ) 0]
      exact 𝔔.zero_mem
    exact (Ideal.IsPrime.ne_top ‹_›) (Ideal.eq_top_of_isUnit_mem _ h1 isUnit_one)
  haveI := hTnt
  suffices hRA : IsReduced (TensorProduct P L Λ) ∧ IsArtinianRing (TensorProduct P L Λ) by
    haveI := hRA.1
    haveI := hRA.2
    exact s1 _ 𝔔
  by_cases hmem : ϖ ∈ 𝔭
  · have h0 : algebraMap P L ϖ = 0 := by
      rw [IsScalarTower.algebraMap_apply P 𝔭.ResidueField L,
        Ideal.algebraMap_residueField_eq_zero.mpr hmem, map_zero]
    have hT := s4 P Λ ϖ hH L h0 hTnt
    exact ⟨(letI := hT.toField; inferInstance), (letI := hT.toField; inferInstance)⟩
  · obtain ⟨hinj, hden⟩ := s7 P ϖ hϖ 𝔭 hmem
    haveI : CharZero 𝔭.ResidueField := by
      refine charZero_of_inj_zero fun n hn => ?_
      by_contra hn0
      apply hchar n hn0
      apply hinj
      rw [map_natCast, map_zero]
      exact hn
    have hπ : algebraMap P 𝔭.ResidueField ϖ ≠ 0 := by
      intro h
      apply hϖ.ne_zero
      apply hinj
      rw [h, map_zero]
    let e := (Algebra.TensorProduct.comm 𝔭.ResidueField L (TensorProduct P 𝔭.ResidueField Λ)).symm.trans
      (Algebra.TensorProduct.cancelBaseChange P 𝔭.ResidueField 𝔭.ResidueField L Λ)
    have hnt2 : Nontrivial (TensorProduct 𝔭.ResidueField (TensorProduct P 𝔭.ResidueField Λ) L) :=
      e.symm.injective.nontrivial
    haveI := hnt2
    have hEnt : Nontrivial (TensorProduct P 𝔭.ResidueField Λ) := by
      by_contra hcon
      rw [not_nontrivial_iff_subsingleton] at hcon
      apply (one_ne_zero : (1 : TensorProduct 𝔭.ResidueField (TensorProduct P 𝔭.ResidueField Λ) L) ≠ 0)
      rw [Algebra.TensorProduct.one_def, Subsingleton.elim (1 : TensorProduct P 𝔭.ResidueField Λ) 0,
        TensorProduct.zero_tmul]
    have hE := s5 P Λ ϖ hU 𝔭.ResidueField hπ hden hEnt
    obtain ⟨hred, hart⟩ := s6 𝔭.ResidueField L (TensorProduct P 𝔭.ResidueField Λ) hE
    haveI := hred
    haveI := hart
    exact ⟨isReduced_of_injective e.symm.toRingEquiv e.symm.injective,
      RingEquiv.isArtinianRing e.toRingEquiv⟩

theorem wc_hnas_pfc_gring_int : (∀ (P : Type u) [CommRing P] [IsLocalRing P], IsLocalRing.maximalIdeal P = ⊥ → ∀ (Λ : Type u) [CommRing Λ] [Algebra P Λ], Nonempty (AdicCompletion (IsLocalRing.maximalIdeal P) P ≃ₐ[P] Λ) → ∀ (𝔭 : Ideal P) [𝔭.IsPrime] (L : Type u) [Field L] [Algebra P L] [Algebra 𝔭.ResidueField L] [IsScalarTower P 𝔭.ResidueField L] [FiniteDimensional 𝔭.ResidueField L] (𝔔 : Ideal (TensorProduct P L Λ)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) → (∀ (P : Type u) [CommRing P] [IsDomain P] [IsDiscreteValuationRing P], (∀ n : ℕ, n ≠ 0 → (n : P) ≠ 0) → ∀ (Λ : Type u) [CommRing Λ] [Algebra P Λ], Nonempty (AdicCompletion (IsLocalRing.maximalIdeal P) P ≃ₐ[P] Λ) → ∀ (𝔭 : Ideal P) [𝔭.IsPrime] (L : Type u) [Field L] [Algebra P L] [Algebra 𝔭.ResidueField L] [IsScalarTower P 𝔭.ResidueField L] [FiniteDimensional 𝔭.ResidueField L] (𝔔 : Ideal (TensorProduct P L Λ)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) → ∀ (A : Type u) [CommRing A], Nonempty (A ≃+* ℤ) → (IsNoetherianRing A ∧ ∀ (𝔪 : Ideal A) [𝔪.IsPrime], ∀ (Λ : Type u) [CommRing Λ] [Algebra (Localization.AtPrime 𝔪) Λ], Nonempty (AdicCompletion (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔪)) (Localization.AtPrime 𝔪) ≃ₐ[Localization.AtPrime 𝔪] Λ) → ∀ (𝔭 : Ideal (Localization.AtPrime 𝔪)) [𝔭.IsPrime] (L : Type u) [Field L] [Algebra (Localization.AtPrime 𝔪) L] [Algebra 𝔭.ResidueField L] [IsScalarTower (Localization.AtPrime 𝔪) 𝔭.ResidueField L] [FiniteDimensional 𝔭.ResidueField L] (𝔔 : Ideal (TensorProduct (Localization.AtPrime 𝔪) L Λ)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) :=
by
  intro hF hD A _ hA
  obtain ⟨e⟩ := hA
  haveI hN : IsNoetherianRing A := isNoetherianRing_of_ringEquiv ℤ e.symm
  haveI hdom : IsDomain A := MulEquiv.isDomain ℤ e.toMulEquiv
  haveI hpid : IsPrincipalIdealRing A :=
    IsPrincipalIdealRing.of_surjective e.symm.toRingHom e.symm.surjective
  haveI hded : IsDedekindDomain A := IsPrincipalIdealRing.isDedekindDomain A
  refine ⟨hN, ?_⟩
  intro 𝔪 _ Λ _ _ hΛ 𝔭 _ L _ _ _ _ _ 𝔔 _
  by_cases h𝔪 : 𝔪 = ⊥
  · have hmax : IsLocalRing.maximalIdeal (Localization.AtPrime 𝔪) = ⊥ := by
      rw [← Localization.AtPrime.map_eq_maximalIdeal, Ideal.map_eq_bot_iff_le_ker]
      intro x hx
      rw [h𝔪] at hx
      rw [Ideal.mem_bot.mp hx]
      exact zero_mem _
    exact hF (Localization.AtPrime 𝔪) hmax Λ hΛ 𝔭 L 𝔔
  · haveI hdvr : IsDiscreteValuationRing (Localization.AtPrime 𝔪) :=
      IsLocalization.AtPrime.isDiscreteValuationRing_of_dedekind_domain A h𝔪
        (Localization.AtPrime 𝔪)
    have hinj : Function.Injective (algebraMap A (Localization.AtPrime 𝔪)) :=
      IsLocalization.injective (Localization.AtPrime 𝔪) (Ideal.primeCompl_le_nonZeroDivisors 𝔪)
    have hchar : ∀ n : ℕ, n ≠ 0 → (n : Localization.AtPrime 𝔪) ≠ 0 := by
      intro n hn hn0
      apply hn
      have h1 : (n : A) = 0 := hinj (by rw [map_natCast, hn0, map_zero])
      have h2 := congrArg e h1
      rw [map_natCast, map_zero] at h2
      exact_mod_cast h2
    exact hD (Localization.AtPrime 𝔪) hchar Λ hΛ 𝔭 L 𝔔

theorem wc_hnas_pfc_completion_surj_base_change : ∀ (B : Type u) [CommRing B] [IsLocalRing B] [IsNoetherianRing B] (S : Type u) [CommRing S] [IsLocalRing S] [Algebra B S], Function.Surjective (algebraMap B S) → Nonempty (TensorProduct B S (AdicCompletion (IsLocalRing.maximalIdeal B) B) ≃ₐ[S] AdicCompletion (IsLocalRing.maximalIdeal S) S) :=
by
  intro B _ _ _ S _ _ _ hsurj
  have hmap : Ideal.map (algebraMap B S) (IsLocalRing.maximalIdeal B) =
      IsLocalRing.maximalIdeal S :=
    IsLocalRing.map_maximalIdeal_of_surjective _ hsurj
  have : Module.Finite B S := Module.Finite.of_surjective (Algebra.linearMap B S) hsurj

  have hconv : ∀ (R : Type u) [CommRing R] (I : Ideal R) (x : AdicCompletion I R) (n : ℕ) (r : R),
      x.val n = Submodule.Quotient.mk r ↔
        AdicCompletion.evalₐ I n x = Ideal.Quotient.mk (I ^ n) r := by
    intro R _ I x n r
    obtain ⟨f, rfl⟩ := AdicCompletion.mk_surjective I R x
    rw [AdicCompletion.evalₐ_mk]
    change Submodule.Quotient.mk (f n) = Submodule.Quotient.mk r ↔
      Ideal.Quotient.mk (I ^ n) (f n) = Ideal.Quotient.mk (I ^ n) r
    rw [Submodule.Quotient.eq, Ideal.Quotient.eq]
    simp [Ideal.mul_top]
  have trunc : ∀ {X : Type u} [CommRing X] (I : Ideal X) {m k : ℕ} (hle : m ≤ k)
      (x : AdicCompletion I X),
      Ideal.Quotient.factorPow I hle (AdicCompletion.evalₐ I k x) =
        AdicCompletion.evalₐ I m x := by
    intro X _ I m k hle x
    obtain ⟨f, rfl⟩ := AdicCompletion.mk_surjective I X x
    rw [AdicCompletion.evalₐ_mk, AdicCompletion.evalₐ_mk]
    have h1 := AdicCompletion.AdicCauchySequence.mk_eq_mk (I := I) (M := X) hle f
    have h2 := (Submodule.Quotient.eq _).mp h1
    change Ideal.Quotient.mk (I ^ m) (f k) = Ideal.Quotient.mk (I ^ m) (f m)
    rw [Ideal.Quotient.eq]
    simpa [smul_eq_mul, Ideal.mul_top] using h2
  set 𝔪 := IsLocalRing.maximalIdeal B with h𝔪
  set 𝔫 := IsLocalRing.maximalIdeal S with h𝔫

  have hsub : ∀ n : ℕ, (𝔪 ^ n • ⊤ : Submodule B S) =
      Submodule.restrictScalars B (𝔫 ^ n • ⊤ : Submodule S S) := by
    intro n
    rw [Ideal.smul_top_eq_map, Ideal.map_pow, hmap]
    congr 1
    exact (Ideal.mul_top _).symm.trans (Ideal.smul_eq_mul _ _).symm
  let q : ∀ n : ℕ, (S ⧸ (𝔪 ^ n • ⊤ : Submodule B S)) ≃ₗ[B] (S ⧸ (𝔫 ^ n • ⊤ : Submodule S S)) :=
    fun n => (Submodule.quotEquivOfEq _ _ (hsub n)).trans
      (Submodule.Quotient.restrictScalarsEquiv B _)
  have hq : ∀ n (s : S), q n (Submodule.Quotient.mk s) = Submodule.Quotient.mk s :=
    fun n s => rfl
  have hq' : ∀ n (s : S), (q n).symm (Submodule.Quotient.mk s) = Submodule.Quotient.mk s :=
    fun n s => (LinearEquiv.symm_apply_eq _).mpr (hq n s).symm
  have htr : ∀ {m n : ℕ} (hmn : m ≤ n) (y : S ⧸ (𝔪 ^ n • ⊤ : Submodule B S)),
      AdicCompletion.transitionMap 𝔫 S hmn (q n y) =
        q m (AdicCompletion.transitionMap 𝔪 S hmn y) := by
    intro m n hmn y
    obtain ⟨s, rfl⟩ := Submodule.Quotient.mk_surjective _ y
    rfl
  have htr' : ∀ {m n : ℕ} (hmn : m ≤ n) (y : S ⧸ (𝔫 ^ n • ⊤ : Submodule S S)),
      AdicCompletion.transitionMap 𝔪 S hmn ((q n).symm y) =
        (q m).symm (AdicCompletion.transitionMap 𝔫 S hmn y) := by
    intro m n hmn y
    obtain ⟨s, rfl⟩ := Submodule.Quotient.mk_surjective _ y
    rw [hq', show AdicCompletion.transitionMap 𝔫 S hmn (Submodule.Quotient.mk s) =
      Submodule.Quotient.mk s from rfl, hq']
    rfl
  let E : AdicCompletion 𝔪 S ≃+ AdicCompletion 𝔫 S :=
    { toFun := fun x => ⟨fun n => q n (x.val n), fun {m n} hmn => by rw [htr, x.property hmn]⟩
      invFun := fun y => ⟨fun n => (q n).symm (y.val n),
        fun {m n} hmn => by rw [htr', y.property hmn]⟩
      left_inv := fun x => AdicCompletion.ext fun n => (q n).symm_apply_apply _
      right_inv := fun y => AdicCompletion.ext fun n => (q n).apply_symm_apply _
      map_add' := fun x y => AdicCompletion.ext fun n => by
        show q n ((x + y).val n) = q n (x.val n) + q n (y.val n)
        rw [AdicCompletion.val_add, Pi.add_apply]
        exact map_add _ _ _ }
  have hE : ∀ x n, (E x).val n = q n (x.val n) := fun _ _ => rfl

  have hle : ∀ n : ℕ, 𝔪 ^ n ≤ Ideal.comap (algebraMap B S) (𝔫 ^ n) := fun n => by
    rw [← Ideal.map_le_iff_le_comap, Ideal.map_pow, hmap]
  let ι : ∀ n : ℕ, B ⧸ 𝔪 ^ n →+* S ⧸ 𝔫 ^ n := fun n =>
    Ideal.quotientMap (𝔫 ^ n) (algebraMap B S) (hle n)
  let φ₀ : AdicCompletion 𝔪 B →+* AdicCompletion 𝔫 S :=
    AdicCompletion.liftRingHom 𝔫 (fun n => (ι n).comp (AdicCompletion.evalₐ 𝔪 n).toRingHom) (by
      intro m k hmk
      refine RingHom.ext fun x => ?_
      change Ideal.Quotient.factorPow 𝔫 hmk (ι k (AdicCompletion.evalₐ 𝔪 k x)) =
        ι m (AdicCompletion.evalₐ 𝔪 m x)
      obtain ⟨a, ha⟩ := Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ 𝔪 k x)
      rw [← trunc 𝔪 hmk x, ← ha]
      rfl)
  have hφ₀ev : ∀ n x, AdicCompletion.evalₐ 𝔫 n (φ₀ x) = ι n (AdicCompletion.evalₐ 𝔪 n x) :=
    fun n x => AdicCompletion.evalₐ_liftRingHom _ _ _ n x
  have hcomm : ∀ b : B, φ₀ (algebraMap B (AdicCompletion 𝔪 B) b) =
      algebraMap B (AdicCompletion 𝔫 S) b := by
    intro b
    apply AdicCompletion.ext_evalₐ
    intro n
    rw [hφ₀ev, AdicCompletion.algebraMap_apply, AdicCompletion.algebraMap_apply,
      AdicCompletion.evalₐ_of, AdicCompletion.evalₐ_of]
    simp only [Algebra.algebraMap_self_apply]
    exact Ideal.quotientMap_mk
  let φ : AdicCompletion 𝔪 B →ₐ[B] AdicCompletion 𝔫 S := { φ₀ with commutes' := hcomm }
  have hφ : ∀ (x : AdicCompletion 𝔪 B) (n : ℕ) (β : B), x.val n = Submodule.Quotient.mk β →
      (φ x).val n = Submodule.Quotient.mk (algebraMap B S β) := by
    intro x n β hx
    rw [hconv B 𝔪 x n β] at hx
    rw [hconv S 𝔫 (φ x) n (algebraMap B S β)]
    change AdicCompletion.evalₐ 𝔫 n (φ₀ x) = _
    rw [hφ₀ev, hx]
    exact Ideal.quotientMap_mk

  set Θ : TensorProduct B S (AdicCompletion 𝔪 B) →ₐ[S] AdicCompletion 𝔫 S :=
    Algebra.TensorProduct.lift (Algebra.ofId S (AdicCompletion 𝔫 S)) φ
      (fun _ _ => Commute.all _ _) with hΘ

  let Ψ : TensorProduct B S (AdicCompletion 𝔪 B) → AdicCompletion 𝔪 S :=
    fun z => AdicCompletion.ofTensorProduct 𝔪 S (TensorProduct.comm B S (AdicCompletion 𝔪 B) z)
  have hΨ : Function.Bijective Ψ :=
    (AdicCompletion.ofTensorProduct_bijective_of_finite_of_isNoetherian 𝔪 S).comp
      (TensorProduct.comm B S (AdicCompletion 𝔪 B)).bijective
  have hkey : ∀ z, Θ z = E (Ψ z) := by
    intro z
    induction z using TensorProduct.induction_on with
    | zero => simp [Ψ]
    | add x y hx hy =>
      show Θ (x + y) = E (AdicCompletion.ofTensorProduct 𝔪 S
        (TensorProduct.comm B S (AdicCompletion 𝔪 B) (x + y)))
      rw [map_add, map_add, map_add, map_add, hx, hy]
    | tmul s b =>
      apply AdicCompletion.ext
      intro n
      obtain ⟨β, hβ⟩ := Submodule.Quotient.mk_surjective _ (b.val n)
      have h1 : (Θ (s ⊗ₜ[B] b)).val n = Submodule.Quotient.mk (s * algebraMap B S β) := by
        rw [hΘ, Algebra.TensorProduct.lift_tmul, AdicCompletion.val_mul, hφ b n β hβ.symm,
          Algebra.ofId_apply, AdicCompletion.algebraMap_apply, AdicCompletion.of_apply]
        rfl
      have hΨt : Ψ (s ⊗ₜ[B] b) = AdicCompletion.ofTensorProduct 𝔪 S (b ⊗ₜ[B] s) := by
        simp only [Ψ, TensorProduct.comm_tmul]
      have h2 : (E (Ψ (s ⊗ₜ[B] b))).val n =
          Submodule.Quotient.mk (algebraMap B S β * s) := by
        rw [hΨt, hE, AdicCompletion.ofTensorProduct_tmul, AdicCompletion.smul_eval,
          AdicCompletion.of_apply, ← hβ, ← Algebra.smul_def]
        rfl
      rw [h1, h2, mul_comm]
  have hbij : Function.Bijective Θ := by
    have h : (Θ : TensorProduct B S (AdicCompletion 𝔪 B) → AdicCompletion 𝔫 S) = E ∘ Ψ :=
      funext hkey
    rw [h]
    exact E.bijective.comp hΨ
  exact ⟨AlgEquiv.ofBijective Θ hbij⟩

theorem wc_hnas_pfc_gring_of_surjective : (∀ (B : Type u) [CommRing B] [IsLocalRing B] [IsNoetherianRing B] (S : Type u) [CommRing S] [IsLocalRing S] [Algebra B S], Function.Surjective (algebraMap B S) → Nonempty (TensorProduct B S (AdicCompletion (IsLocalRing.maximalIdeal B) B) ≃ₐ[S] AdicCompletion (IsLocalRing.maximalIdeal S) S)) → ∀ (B : Type u) [CommRing B] (S : Type u) [CommRing S] (f : B →+* S), Function.Surjective f → (IsNoetherianRing B ∧ ∀ (𝔪 : Ideal B) [𝔪.IsPrime], ∀ (Λ : Type u) [CommRing Λ] [Algebra (Localization.AtPrime 𝔪) Λ], Nonempty (AdicCompletion (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔪)) (Localization.AtPrime 𝔪) ≃ₐ[Localization.AtPrime 𝔪] Λ) → ∀ (𝔭 : Ideal (Localization.AtPrime 𝔪)) [𝔭.IsPrime] (L : Type u) [Field L] [Algebra (Localization.AtPrime 𝔪) L] [Algebra 𝔭.ResidueField L] [IsScalarTower (Localization.AtPrime 𝔪) 𝔭.ResidueField L] [FiniteDimensional 𝔭.ResidueField L] (𝔔 : Ideal (TensorProduct (Localization.AtPrime 𝔪) L Λ)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) → (IsNoetherianRing S ∧ ∀ (𝔪 : Ideal S) [𝔪.IsPrime], ∀ (Λ : Type u) [CommRing Λ] [Algebra (Localization.AtPrime 𝔪) Λ], Nonempty (AdicCompletion (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔪)) (Localization.AtPrime 𝔪) ≃ₐ[Localization.AtPrime 𝔪] Λ) → ∀ (𝔭 : Ideal (Localization.AtPrime 𝔪)) [𝔭.IsPrime] (L : Type u) [Field L] [Algebra (Localization.AtPrime 𝔪) L] [Algebra 𝔭.ResidueField L] [IsScalarTower (Localization.AtPrime 𝔪) 𝔭.ResidueField L] [FiniteDimensional 𝔭.ResidueField L] (𝔔 : Ideal (TensorProduct (Localization.AtPrime 𝔪) L Λ)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) :=
by

  have s1 : ∀ (A : Type u) [CommRing A] (C : Type u) [CommRing C] (f : A →+* C),
      Function.Surjective f → ∀ (P : Ideal C) [P.IsPrime],
      Function.Surjective (Localization.localRingHom (Ideal.comap f P) P f rfl) ∧
        Function.Surjective (Ideal.ResidueField.map (Ideal.comap f P) P f rfl) := by
    intro A _ C _ f hf P _
    have h1 : Function.Surjective (Localization.localRingHom (Ideal.comap f P) P f rfl) := by
      intro z
      obtain ⟨⟨y, t⟩, hz⟩ := IsLocalization.mk'_surjective P.primeCompl z
      change IsLocalization.mk' _ y t = z at hz
      subst hz
      obtain ⟨x, rfl⟩ := hf y
      obtain ⟨s, hs⟩ := hf t
      have hs' : s ∈ (Ideal.comap f P).primeCompl := by
        show s ∉ Ideal.comap f P
        rw [Ideal.mem_comap, hs]; exact t.2
      refine ⟨IsLocalization.mk' (Localization.AtPrime (Ideal.comap f P)) x ⟨s, hs'⟩, ?_⟩
      rw [Localization.localRingHom_mk']
      congr 1
      exact Subtype.ext hs
    refine ⟨h1, ?_⟩
    intro w
    obtain ⟨z, rfl⟩ := IsLocalRing.residue_surjective w
    obtain ⟨z', rfl⟩ := h1 z
    exact ⟨IsLocalRing.residue _ z', IsLocalRing.ResidueField.map_residue _ z'⟩

  have s2 : ∀ (T' : Type u) [CommRing T'] (T : Type u) [CommRing T] (Ψ : T' ≃+* T)
      (𝔔 : Ideal T) [𝔔.IsPrime],
      IsRegularLocalRing (Localization.AtPrime (Ideal.comap (Ψ : T' →+* T) 𝔔)) →
      IsRegularLocalRing (Localization.AtPrime 𝔔) := by
    intro T' _ T _ Ψ 𝔔 _ h
    have H : Submonoid.map Ψ.toMonoidHom (Ideal.comap (Ψ : T' →+* T) 𝔔).primeCompl
        = 𝔔.primeCompl := by
      ext x
      simp only [Submonoid.mem_map]
      constructor
      · rintro ⟨y, hy, rfl⟩
        exact hy
      · intro hx
        refine ⟨Ψ.symm x, ?_, by simp⟩
        show Ψ.symm x ∉ Ideal.comap (Ψ : T' →+* T) 𝔔
        rw [Ideal.mem_comap]
        simpa using hx
    haveI := h
    exact IsRegularLocalRing.of_ringEquiv (IsLocalization.ringEquivOfRingEquiv
      (Localization.AtPrime (Ideal.comap (Ψ : T' →+* T) 𝔔)) (Localization.AtPrime 𝔔) Ψ H)

  have s3 : ∀ (B' : Type u) [CommRing B'] (S' : Type u) [CommRing S'] [Algebra B' S']
      (L : Type u) [CommRing L] [Algebra S' L] [Algebra B' L] [IsScalarTower B' S' L]
      (M : Type u) [CommRing M] [Algebra B' M] (Λ : Type u) [CommRing Λ] [Algebra S' Λ],
      (TensorProduct B' S' M ≃ₐ[S'] Λ) →
      Nonempty (TensorProduct B' L M ≃+* TensorProduct S' L Λ) := by
    intro B' _ S' _ _ L _ _ _ _ M _ _ Λ _ _ σ
    exact ⟨((Algebra.TensorProduct.cancelBaseChange B' S' S' L M).symm.trans
      (Algebra.TensorProduct.congr (AlgEquiv.refl : L ≃ₐ[S'] L) σ)).toRingEquiv⟩

  have s4 : ∀ (K' : Type u) [Field K'] (K : Type u) [Field K] (L : Type u) [Field L]
      [Algebra K L] [Algebra K' L] (ρ : K' →+* K), Function.Surjective ρ →
      algebraMap K' L = (algebraMap K L).comp ρ → FiniteDimensional K L →
      FiniteDimensional K' L := by
    intro K' _ K _ L _ _ _ ρ hρ heq hK
    letI : Algebra K' K := ρ.toAlgebra
    haveI : Module.Finite K' K := RingHom.Finite.of_surjective ρ hρ
    haveI : IsScalarTower K' K L :=
      IsScalarTower.of_algebraMap_eq' (by rw [heq, RingHom.algebraMap_toAlgebra])
    exact Module.Finite.trans K L

  intro hS
  have hloc : ∀ (B' : Type u) [CommRing B'] [IsLocalRing B'] [IsNoetherianRing B']
      (S' : Type u) [CommRing S'] [IsLocalRing S'] (φ : B' →+* S'), Function.Surjective φ →
      (∀ (Λ : Type u) [CommRing Λ] [Algebra B' Λ], Nonempty (AdicCompletion (IsLocalRing.maximalIdeal B') B' ≃ₐ[B'] Λ) → ∀ (𝔭 : Ideal B') [𝔭.IsPrime] (L : Type u) [Field L] [Algebra B' L] [Algebra 𝔭.ResidueField L] [IsScalarTower B' 𝔭.ResidueField L] [FiniteDimensional 𝔭.ResidueField L] (𝔔 : Ideal (TensorProduct B' L Λ)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) →
      ∀ (Λ : Type u) [CommRing Λ] [Algebra S' Λ], Nonempty (AdicCompletion (IsLocalRing.maximalIdeal S') S' ≃ₐ[S'] Λ) → ∀ (𝔭 : Ideal S') [𝔭.IsPrime] (L : Type u) [Field L] [Algebra S' L] [Algebra 𝔭.ResidueField L] [IsScalarTower S' 𝔭.ResidueField L] [FiniteDimensional 𝔭.ResidueField L] (𝔔 : Ideal (TensorProduct S' L Λ)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔) := by
    intro B' _ _ _ S' _ _ φ hφ hB Λ _ _ hΛ 𝔭 _ L _ _ _ _ _ 𝔔 _
    letI : Algebra B' S' := φ.toAlgebra
    obtain ⟨σ⟩ := hS B' S' (by rw [RingHom.algebraMap_toAlgebra]; exact hφ)
    obtain ⟨e⟩ := hΛ
    have hs1 := s1 B' S' φ hφ 𝔭
    letI : Algebra B' L := ((algebraMap S' L).comp φ).toAlgebra
    haveI : IsScalarTower B' S' L := IsScalarTower.of_algebraMap_eq' rfl
    letI : Algebra (Ideal.comap φ 𝔭).ResidueField L :=
      ((algebraMap 𝔭.ResidueField L).comp
        (Ideal.ResidueField.map (Ideal.comap φ 𝔭) 𝔭 φ rfl)).toAlgebra
    haveI : IsScalarTower B' (Ideal.comap φ 𝔭).ResidueField L := by
      refine IsScalarTower.of_algebraMap_eq (fun x => ?_)
      change algebraMap S' L (φ x) = algebraMap 𝔭.ResidueField L
        (Ideal.ResidueField.map (Ideal.comap φ 𝔭) 𝔭 φ rfl (algebraMap B' _ x))
      rw [Ideal.ResidueField.map_algebraMap, ← IsScalarTower.algebraMap_apply]
    haveI : FiniteDimensional (Ideal.comap φ 𝔭).ResidueField L :=
      s4 _ _ L _ hs1.2 rfl inferInstance
    obtain ⟨Ψ⟩ := s3 B' S' L _ Λ (σ.trans e)
    have hreg := hB (AdicCompletion (IsLocalRing.maximalIdeal B') B') ⟨AlgEquiv.refl⟩
      (Ideal.comap φ 𝔭) L (Ideal.comap (Ψ : _ →+* _) 𝔔)
    exact s2 _ _ Ψ 𝔔 hreg

  intro B _ S _ f hf hG
  obtain ⟨hBn, hBF⟩ := hG
  refine ⟨isNoetherianRing_of_surjective B S f hf, ?_⟩
  intro 𝔪 _
  haveI : IsNoetherianRing (Localization.AtPrime (Ideal.comap f 𝔪)) :=
    IsLocalization.isNoetherianRing (Ideal.comap f 𝔪).primeCompl _ hBn
  exact hloc _ _ (Localization.localRingHom (Ideal.comap f 𝔪) 𝔪 f rfl)
    (s1 B S f hf 𝔪).1 (hBF (Ideal.comap f 𝔪))

theorem wc_hnas_pfc_regular_flat_ascent : ∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A] (B : Type u) [CommRing B] [IsLocalRing B] [IsNoetherianRing B] [Algebra A B] [IsLocalHom (algebraMap A B)] [Module.Flat A B], IsRegularLocalRing A → IsRegularLocalRing (B ⧸ Ideal.map (algebraMap A B) (IsLocalRing.maximalIdeal A)) → IsRegularLocalRing B :=
by

  have gd_lift : ∀ (R : Type u) [CommRing R] (S : Type u) [CommRing S] [Algebra R S]
      [Algebra.HasGoingDown R S] (l : LTSeries (PrimeSpectrum R)) (Q : PrimeSpectrum S),
      PrimeSpectrum.comap (algebraMap R S) Q = RelSeries.last l →
      ∃ l' : LTSeries (PrimeSpectrum S), l'.length = l.length ∧ RelSeries.last l' = Q ∧
        PrimeSpectrum.comap (algebraMap R S) (RelSeries.head l') = RelSeries.head l := by
    intro R _ S _ _ _ l
    induction l using RelSeries.inductionOn with
    | singleton x =>
      intro Q hQ
      exact ⟨RelSeries.singleton _ Q, rfl, rfl, hQ⟩
    | cons p x hx ih =>
      intro Q hQ
      rw [RelSeries.last_cons] at hQ
      obtain ⟨p', hlen, hlast, hhead⟩ := ih Q hQ
      have hlt : x.asIdeal < (RelSeries.head p).asIdeal := hx
      have : (RelSeries.head p').asIdeal.LiesOver (RelSeries.head p).asIdeal :=
        ⟨by rw [← hhead]; rfl⟩
      obtain ⟨P, hPlt, hPprime, hPover⟩ :=
        Ideal.exists_ideal_lt_liesOver_of_lt (R := R) (S := S) (RelSeries.head p').asIdeal hlt
      have hlt' : (⟨P, hPprime⟩ : PrimeSpectrum S) < RelSeries.head p' := hPlt
      refine ⟨p'.cons ⟨P, hPprime⟩ hlt', ?_, ?_, ?_⟩
      · rw [RelSeries.cons_length, RelSeries.cons_length, hlen]
      · rw [RelSeries.last_cons, hlast]
      · rw [RelSeries.head_cons, RelSeries.head_cons]
        ext1
        rw [PrimeSpectrum.comap_asIdeal]
        exact hPover.over.symm

  have chain : ∀ (R : Type u) [CommRing R] [IsLocalRing R] (n : ℕ),
      (n : WithBot ℕ∞) ≤ ringKrullDim R →
      ∃ l : LTSeries (PrimeSpectrum R), l.length = n ∧
        RelSeries.last l = IsLocalRing.closedPoint R := by
    intro R _ _ n hn
    have htop : ∀ a : PrimeSpectrum R, a ≤ IsLocalRing.closedPoint R := fun a =>
      (PrimeSpectrum.asIdeal_le_asIdeal _ _).mp (IsLocalRing.le_maximalIdeal a.isPrime.ne_top)
    have hdim : ringKrullDim R ≤ (Order.height (IsLocalRing.closedPoint R) : WithBot ℕ∞) := by
      rw [ringKrullDim.eq_def, Order.krullDim_eq_iSup_height]
      exact iSup_le fun a => WithBot.coe_le_coe.mpr (Order.height_mono (htop a))
    have h2 : ((n : ℕ∞) : WithBot ℕ∞) ≤ (Order.height (IsLocalRing.closedPoint R) : WithBot ℕ∞) :=
      hn.trans hdim
    obtain ⟨l, hl, hlen⟩ := Order.exists_series_of_le_height _ (WithBot.coe_le_coe.mp h2)
    exact ⟨l, hlen, hl⟩
  intro A _ _ _ B _ _ _ _ _ _ hA hF
  set I := Ideal.map (algebraMap A B) (IsLocalRing.maximalIdeal A) with hIdef
  have : IsLocalRing (B ⧸ I) := hF.toIsLocalRing
  set π : B →+* B ⧸ I := Ideal.Quotient.mk I with hπdef
  have hπ : Function.Surjective π := Ideal.Quotient.mk_surjective
  set d := Submodule.spanFinrank (IsLocalRing.maximalIdeal A) with hd
  set e := Submodule.spanFinrank (IsLocalRing.maximalIdeal (B ⧸ I)) with he
  set n := Submodule.spanFinrank (IsLocalRing.maximalIdeal B) with hn

  have h1 : n ≤ d + e := by
    obtain ⟨S, hScard, hSspan⟩ :=
      (IsNoetherian.noetherian (IsLocalRing.maximalIdeal A)).exists_span_set_encard_eq_spanFinrank
    obtain ⟨T, hTcard, hTspan⟩ :=
      (IsNoetherian.noetherian (IsLocalRing.maximalIdeal (B ⧸ I))).exists_span_set_encard_eq_spanFinrank
    have hSfin : S.Finite := Set.finite_of_encard_eq_coe hScard
    have hTfin : T.Finite := Set.finite_of_encard_eq_coe hTcard
    have hSn : S.ncard = d := by
      have := hSfin.cast_ncard_eq
      rw [hScard] at this
      exact_mod_cast this
    have hTn : T.ncard = e := by
      have := hTfin.cast_ncard_eq
      rw [hTcard] at this
      exact_mod_cast this
    set σ := Function.surjInv hπ with hσ
    set T' := σ '' T with hT'
    have hπT' : π '' T' = T := by
      rw [hT', Set.image_image]
      simp only [hσ, Function.surjInv_eq hπ, Set.image_id']
    set U := (algebraMap A B) '' S ∪ T' with hUdef
    have hUfin : U.Finite := (hSfin.image _).union (hTfin.image _)
    have hIspan : I = Ideal.span ((algebraMap A B) '' S) := by
      rw [hIdef, ← Ideal.map_span]
      congr 1
      exact hSspan.symm
    have hU : Ideal.span U = IsLocalRing.maximalIdeal B := by
      apply le_antisymm
      · rw [Ideal.span_le]
        rintro x (⟨s, hs, rfl⟩ | ⟨t, ht, rfl⟩)
        · have hs' : s ∈ IsLocalRing.maximalIdeal A := by
            rw [← hSspan]; exact Submodule.subset_span hs
          exact map_nonunit (algebraMap A B) s hs'
        · have ht' : t ∈ IsLocalRing.maximalIdeal (B ⧸ I) := by
            rw [← hTspan]; exact Submodule.subset_span ht
          rw [SetLike.mem_coe, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
          intro hu
          rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at ht'
          apply ht'
          rw [← Function.surjInv_eq hπ t]
          exact hu.map π
      · intro x hx
        have hx1 : π x ∈ IsLocalRing.maximalIdeal (B ⧸ I) := by
          rw [← IsLocalRing.map_maximalIdeal_of_surjective π hπ]
          exact Ideal.mem_map_of_mem _ hx
        have hx2 : π x ∈ Ideal.map π (Ideal.span T') := by
          rw [Ideal.map_span, hπT']
          rw [← hTspan] at hx1
          exact hx1
        obtain ⟨y, hy, hyx⟩ := (Ideal.mem_map_iff_of_surjective π hπ).mp hx2
        have hxy : x - y ∈ I := Ideal.Quotient.eq.mp hyx.symm
        rw [hIspan] at hxy
        have e1 : x - y ∈ Ideal.span U := Ideal.span_mono Set.subset_union_left hxy
        have e2 : y ∈ Ideal.span U := Ideal.span_mono Set.subset_union_right hy
        have := add_mem e1 e2
        rwa [sub_add_cancel] at this
    calc n = Submodule.spanFinrank (Ideal.span U) := by rw [hU]
      _ ≤ U.ncard := Submodule.spanFinrank_span_le_ncard_of_finite hUfin
      _ ≤ ((algebraMap A B) '' S).ncard + T'.ncard := Set.ncard_union_le _ _
      _ ≤ S.ncard + T.ncard := add_le_add (Set.ncard_image_le hSfin) (Set.ncard_image_le hTfin)
      _ = d + e := by rw [hSn, hTn]

  have hdA : (d : WithBot ℕ∞) = ringKrullDim A := hA.spanFinrank_maximalIdeal
  have heF : (e : WithBot ℕ∞) = ringKrullDim (B ⧸ I) := hF.spanFinrank_maximalIdeal
  have h2 : ((d + e : ℕ) : WithBot ℕ∞) ≤ ringKrullDim B := by
    have : Algebra.HasGoingDown A B := Algebra.HasGoingDown.of_flat
    obtain ⟨lF, hlFlen, -⟩ := chain (B ⧸ I) e heF.le
    let g : PrimeSpectrum (B ⧸ I) → PrimeSpectrum B := PrimeSpectrum.comap π
    have hgmono : Monotone g := fun a b hab =>
      (PrimeSpectrum.asIdeal_le_asIdeal _ _).mp
        (Ideal.comap_mono ((PrimeSpectrum.asIdeal_le_asIdeal _ _).mpr hab))
    have hg : StrictMono g :=
      hgmono.strictMono_of_injective (PrimeSpectrum.comap_injective_of_surjective π hπ)
    let lB := lF.map g hg
    have hP₀ : PrimeSpectrum.comap (algebraMap A B) (RelSeries.head lB) =
        IsLocalRing.closedPoint A := by
      ext1
      have := (RelSeries.head lF).isPrime
      rw [PrimeSpectrum.comap_asIdeal, LTSeries.head_map, PrimeSpectrum.comap_asIdeal]
      symm
      apply Ideal.IsMaximal.eq_of_le (IsLocalRing.maximalIdeal.isMaximal A)
        (Ideal.IsPrime.ne_top inferInstance)
      intro a ha
      rw [Ideal.mem_comap, Ideal.mem_comap,
        Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_map_of_mem _ ha)]
      exact zero_mem _
    obtain ⟨lA, hlAlen, hlAlast⟩ := chain A d hdA.le
    obtain ⟨l', hl'len, hl'last, -⟩ :=
      gd_lift A B lA (RelSeries.head lB) (by rw [hP₀, hlAlast])
    have hlen : (l'.smash lB hl'last).length = d + e := by
      rw [RelSeries.smash_length, hl'len, hlAlen, LTSeries.map_length, hlFlen]
    rw [← hlen, ringKrullDim.eq_def]
    exact Order.LTSeries.length_le_krullDim _
  have h3 : ringKrullDim B ≤ (n : WithBot ℕ∞) := ringKrullDim_le_spanFinrank_maximalIdeal B
  have h4 : (n : WithBot ℕ∞) ≤ ((d + e : ℕ) : WithBot ℕ∞) := by exact_mod_cast h1
  exact IsRegularLocalRing.mk (le_antisymm (h4.trans h2) h3)

theorem wc_rl_quot_embdim : ∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A] (x : A), x ∈ IsLocalRing.maximalIdeal A → x ∉ IsLocalRing.maximalIdeal A ^ 2 → ∃ (_ : IsLocalRing (A ⧸ Ideal.span {x})), Submodule.spanFinrank (IsLocalRing.maximalIdeal (A ⧸ Ideal.span {x})) + 1 = Submodule.spanFinrank (IsLocalRing.maximalIdeal A) :=
by
  intro A _ _ _ x hx hx2
  classical
  have hItop : Ideal.span {x} ≠ (⊤ : Ideal A) := by
    intro h
    have h1 : Ideal.span {x} ≤ IsLocalRing.maximalIdeal A :=
      (Ideal.span_singleton_le_iff_mem _).mpr hx
    rw [h] at h1
    exact (IsLocalRing.maximalIdeal.isMaximal A).ne_top (top_le_iff.mp h1)
  haveI : Nontrivial (A ⧸ Ideal.span {x}) := Ideal.Quotient.nontrivial_iff.mpr hItop
  haveI inst : IsLocalRing (A ⧸ Ideal.span {x}) :=
    IsLocalRing.of_surjective' (Ideal.Quotient.mk (Ideal.span {x})) Ideal.Quotient.mk_surjective
  refine ⟨inst, ?_⟩
  have hπs : Function.Surjective (Ideal.Quotient.mk (Ideal.span {x})) :=
    Ideal.Quotient.mk_surjective
  have hmap : Ideal.map (Ideal.Quotient.mk (Ideal.span {x})) (IsLocalRing.maximalIdeal A) =
      IsLocalRing.maximalIdeal (A ⧸ Ideal.span {x}) :=
    IsLocalRing.map_maximalIdeal_of_surjective _ hπs
  have hπx : Ideal.Quotient.mk (Ideal.span {x}) x = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self x)

  have hle : Submodule.spanFinrank (IsLocalRing.maximalIdeal A) ≤
      Submodule.spanFinrank (IsLocalRing.maximalIdeal (A ⧸ Ideal.span {x})) + 1 := by
    have hfg : (IsLocalRing.maximalIdeal (A ⧸ Ideal.span {x})).FG := IsNoetherian.noetherian _
    obtain ⟨T, hTe, hTs⟩ := Submodule.FG.exists_span_set_encard_eq_spanFinrank hfg
    have hTf : T.Finite := Set.finite_of_encard_eq_coe hTe
    have hTn : T.ncard = Submodule.spanFinrank (IsLocalRing.maximalIdeal (A ⧸ Ideal.span {x})) := by
      have h1 := hTf.cast_ncard_eq
      rw [hTe] at h1
      exact_mod_cast h1
    have hπL : (Ideal.Quotient.mk (Ideal.span {x})) '' (Function.surjInv hπs '' T) = T := by
      rw [Set.image_image]
      simp only [Function.surjInv_eq hπs, Set.image_id']
    have hLf : (Function.surjInv hπs '' T).Finite := hTf.image _
    have hLn : (Function.surjInv hπs '' T).ncard ≤ T.ncard := Set.ncard_image_le hTf
    have hJ : Ideal.span (insert x (Function.surjInv hπs '' T)) = IsLocalRing.maximalIdeal A := by
      apply le_antisymm
      · rw [Ideal.span_le]
        intro y hy
        rcases Set.mem_insert_iff.mp hy with h | ⟨t, ht, rfl⟩
        · rw [h]; exact hx
        · by_contra hc
          have hu : IsUnit (Function.surjInv hπs t) := IsLocalRing.notMem_maximalIdeal.mp hc
          have hu' := hu.map (Ideal.Quotient.mk (Ideal.span {x}))
          rw [Function.surjInv_eq hπs] at hu'
          have htm : t ∈ IsLocalRing.maximalIdeal (A ⧸ Ideal.span {x}) := by
            rw [← hTs]; exact Submodule.subset_span ht
          exact (IsLocalRing.notMem_maximalIdeal.mpr hu') htm
      · intro z hz
        have h1 : Ideal.Quotient.mk (Ideal.span {x}) z ∈
            Ideal.map (Ideal.Quotient.mk (Ideal.span {x})) (Ideal.span (Function.surjInv hπs '' T)) := by
          rw [Ideal.map_span, hπL]
          have h0 : Ideal.Quotient.mk (Ideal.span {x}) z ∈
              Ideal.map (Ideal.Quotient.mk (Ideal.span {x})) (IsLocalRing.maximalIdeal A) :=
            Ideal.mem_map_of_mem _ hz
          rw [hmap, ← hTs] at h0
          exact h0
        obtain ⟨w, hw, hwz⟩ := (Ideal.mem_map_iff_of_surjective _ hπs).mp h1
        have h2 : z - w ∈ Ideal.span {x} := by
          rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, hwz, sub_self]
        obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp h2
        have h3 : z = w + c * x := by rw [hc]; ring
        rw [h3]
        refine Ideal.add_mem _ (Ideal.span_mono (Set.subset_insert _ _) hw) ?_
        exact Ideal.mul_mem_left _ _ (Ideal.subset_span (Set.mem_insert _ _))
    have h4 : Submodule.spanFinrank (IsLocalRing.maximalIdeal A) ≤
        (insert x (Function.surjInv hπs '' T)).ncard := by
      rw [← hJ]
      exact Submodule.spanFinrank_span_le_ncard_of_finite (hLf.insert x)
    have h5 : (insert x (Function.surjInv hπs '' T)).ncard ≤
        (Function.surjInv hπs '' T).ncard + 1 := Set.ncard_insert_le x _
    omega

  have hge : Submodule.spanFinrank (IsLocalRing.maximalIdeal (A ⧸ Ideal.span {x})) + 1 ≤
      Submodule.spanFinrank (IsLocalRing.maximalIdeal A) := by
    have hfg : (IsLocalRing.maximalIdeal A).FG := IsNoetherian.noetherian _
    obtain ⟨S, hSe, hSs⟩ := Submodule.FG.exists_span_set_encard_eq_spanFinrank hfg
    have hSf : S.Finite := Set.finite_of_encard_eq_coe hSe
    have hcard0 : hSf.toFinset.card = Submodule.spanFinrank (IsLocalRing.maximalIdeal A) := by
      rw [← Set.ncard_eq_toFinset_card S hSf]
      have h1 := hSf.cast_ncard_eq
      rw [hSe] at h1
      exact_mod_cast h1
    obtain ⟨Sf, hSfc, hcard⟩ : ∃ Sf : Finset A, (Sf : Set A) = S ∧
        Sf.card = Submodule.spanFinrank (IsLocalRing.maximalIdeal A) :=
      ⟨hSf.toFinset, hSf.coe_toFinset, hcard0⟩
    subst hSfc
    have hSm : ∀ a ∈ Sf, a ∈ IsLocalRing.maximalIdeal A := by
      intro a ha
      rw [← hSs]
      exact Submodule.subset_span (Finset.mem_coe.mpr ha)
    have hxS : x ∈ Submodule.span A (Sf : Set A) := by rw [hSs]; exact hx
    obtain ⟨f, -, hf⟩ := Submodule.mem_span_finset.mp hxS
    simp only [smul_eq_mul] at hf
    obtain ⟨s₀, hs₀, hfs₀⟩ : ∃ s₀ ∈ Sf, f s₀ ∉ IsLocalRing.maximalIdeal A := by
      by_contra hcon
      push_neg at hcon
      apply hx2
      rw [← hf, sq]
      exact Ideal.sum_mem _ (fun a ha => Ideal.mul_mem_mul (hcon a ha) (hSm a ha))
    obtain ⟨v, hv⟩ := (IsLocalRing.notMem_maximalIdeal.mp hfs₀).exists_left_inv
    have hsum : f s₀ * s₀ + ∑ a ∈ Sf.erase s₀, f a * a = x :=
      (Finset.add_sum_erase Sf (fun a => f a * a) hs₀).trans hf
    have hs₀eq : v * (x - ∑ a ∈ Sf.erase s₀, f a * a) = s₀ := by
      rw [← hsum]
      calc v * (f s₀ * s₀ + ∑ a ∈ Sf.erase s₀, f a * a - ∑ a ∈ Sf.erase s₀, f a * a)
          = (v * f s₀) * s₀ := by ring
        _ = s₀ := by rw [hv, one_mul]
    obtain ⟨J, hJdef⟩ : ∃ J : Ideal A, J = Ideal.span (insert x ((Sf.erase s₀ : Finset A) : Set A)) :=
      ⟨_, rfl⟩
    have hxJ : x ∈ J := by rw [hJdef]; exact Ideal.subset_span (Set.mem_insert _ _)
    have hRJ : ∀ a ∈ Sf.erase s₀, a ∈ J := by
      intro a ha
      rw [hJdef]
      exact Ideal.subset_span (Set.mem_insert_of_mem _ (Finset.mem_coe.mpr ha))
    have hs₀J : s₀ ∈ J := by
      have h1 : v * (x - ∑ a ∈ Sf.erase s₀, f a * a) ∈ J :=
        Ideal.mul_mem_left _ _ (Ideal.sub_mem _ hxJ
          (Ideal.sum_mem _ (fun a ha => Ideal.mul_mem_left _ _ (hRJ a ha))))
      rwa [hs₀eq] at h1
    have hmJ : IsLocalRing.maximalIdeal A ≤ J := by
      rw [← hSs]
      apply Submodule.span_le.mpr
      intro a ha
      by_cases h : a = s₀
      · rw [h]; exact hs₀J
      · exact hRJ a (Finset.mem_erase.mpr ⟨h, Finset.mem_coe.mp ha⟩)
    have hm' : IsLocalRing.maximalIdeal (A ⧸ Ideal.span {x}) =
        Ideal.span ((Ideal.Quotient.mk (Ideal.span {x})) '' ((Sf.erase s₀ : Finset A) : Set A)) := by
      apply le_antisymm
      · rw [← hmap]
        calc Ideal.map (Ideal.Quotient.mk (Ideal.span {x})) (IsLocalRing.maximalIdeal A)
            ≤ Ideal.map (Ideal.Quotient.mk (Ideal.span {x})) J := Ideal.map_mono hmJ
          _ = _ := by rw [hJdef, Ideal.map_span, Set.image_insert_eq, hπx, Ideal.span_insert_zero]
      · rw [Ideal.span_le]
        rintro _ ⟨a, ha, rfl⟩
        rw [← hmap]
        exact Ideal.mem_map_of_mem _ (hSm a (Finset.mem_of_mem_erase ha))
    have hfin : ((Ideal.Quotient.mk (Ideal.span {x})) ''
        ((Sf.erase s₀ : Finset A) : Set A)).Finite := (Finset.finite_toSet _).image _
    have h1 : Submodule.spanFinrank (IsLocalRing.maximalIdeal (A ⧸ Ideal.span {x})) ≤
        ((Ideal.Quotient.mk (Ideal.span {x})) '' ((Sf.erase s₀ : Finset A) : Set A)).ncard := by
      rw [hm']
      exact Submodule.spanFinrank_span_le_ncard_of_finite hfin
    have h2 : ((Ideal.Quotient.mk (Ideal.span {x})) '' ((Sf.erase s₀ : Finset A) : Set A)).ncard ≤
        (Sf.erase s₀).card := by
      rw [← Set.ncard_coe_finset]
      exact Set.ncard_image_le (Finset.finite_toSet _)
    have h3 : (Sf.erase s₀).card = Sf.card - 1 := Finset.card_erase_of_mem hs₀
    have h4 : 0 < Sf.card := Finset.card_pos.mpr ⟨s₀, hs₀⟩
    omega
  omega

theorem wc_rl_quot_regular : (∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A] (x : A), x ∈ IsLocalRing.maximalIdeal A → x ∉ IsLocalRing.maximalIdeal A ^ 2 → ∃ (_ : IsLocalRing (A ⧸ Ideal.span {x})), Submodule.spanFinrank (IsLocalRing.maximalIdeal (A ⧸ Ideal.span {x})) + 1 = Submodule.spanFinrank (IsLocalRing.maximalIdeal A)) → ∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A], IsRegularLocalRing A → ∀ x : A, x ∈ IsLocalRing.maximalIdeal A → x ∉ IsLocalRing.maximalIdeal A ^ 2 → IsRegularLocalRing (A ⧸ Ideal.span {x}) ∧ ringKrullDim (A ⧸ Ideal.span {x}) + 1 = ringKrullDim A :=
by
  intro EMB A _ _ _ hA x hx hx2
  obtain ⟨hloc, hemb⟩ := EMB A x hx hx2
  haveI := hloc
  haveI : IsNoetherianRing (A ⧸ Ideal.span {x}) := Ideal.Quotient.isNoetherianRing _
  have hdimA : ringKrullDim A = ((Submodule.spanFinrank
      (IsLocalRing.maximalIdeal (A ⧸ Ideal.span {x})) + 1 : ℕ) : WithBot ℕ∞) := by
    rw [hemb]
    exact (@IsRegularLocalRing.spanFinrank_maximalIdeal A _ hA).symm
  have hup : ringKrullDim (A ⧸ Ideal.span {x}) ≤ ((Submodule.spanFinrank
      (IsLocalRing.maximalIdeal (A ⧸ Ideal.span {x})) : ℕ) : WithBot ℕ∞) :=
    ringKrullDim_le_spanFinrank_maximalIdeal _
  have hle : Ideal.span {x} ≤ Ring.jacobson A := by
    rw [IsLocalRing.ringJacobson_eq_maximalIdeal A]
    exact (Ideal.span_singleton_le_iff_mem _).mpr hx
  have hlow0 := ringKrullDim_le_ringKrullDim_quotient_add_spanFinrank (Ideal.span {x}) hle
  have hs : Submodule.spanFinrank (Ideal.span {x}) ≤ 1 := by
    have := Submodule.spanFinrank_span_le_ncard_of_finite (R := A) (Set.finite_singleton x)
    rw [Set.ncard_singleton] at this
    exact this
  have hs' : ((Submodule.spanFinrank (Ideal.span {x}) : ℕ) : WithBot ℕ∞) ≤ 1 := by
    exact_mod_cast hs
  have hlow : ringKrullDim A ≤ ringKrullDim (A ⧸ Ideal.span {x}) + 1 := by
    refine hlow0.trans ?_
    gcongr
  generalize he : Submodule.spanFinrank (IsLocalRing.maximalIdeal (A ⧸ Ideal.span {x})) = e
    at hdimA hup
  have h0 : (0 : WithBot ℕ∞) ≤ ringKrullDim (A ⧸ Ideal.span {x}) :=
    ringKrullDim_nonneg_of_nontrivial
  obtain ⟨j, hj⟩ : ∃ j : ℕ, ringKrullDim (A ⧸ Ideal.span {x}) = (j : WithBot ℕ∞) := by
    generalize ringKrullDim (A ⧸ Ideal.span {x}) = D at h0 hup
    induction D using WithBot.recBotCoe with
    | bot => exact absurd h0 (by simp)
    | coe n =>
      induction n using ENat.recTopCoe with
      | top =>
        exfalso
        have h3 : ((⊤ : ℕ∞) : WithBot ℕ∞) ≤ ((e : ℕ∞) : WithBot ℕ∞) := hup
        exact ENat.coe_ne_top e (top_le_iff.mp (WithBot.coe_le_coe.mp h3))
      | coe j => exact ⟨j, rfl⟩
  rw [hj] at hup hlow
  rw [hdimA] at hlow
  have h1 : j ≤ e := by exact_mod_cast hup
  have h2 : e + 1 ≤ j + 1 := by exact_mod_cast hlow
  have hje : j = e := by omega
  have hdimA' : ringKrullDim (A ⧸ Ideal.span {x}) = ((Submodule.spanFinrank
      (IsLocalRing.maximalIdeal (A ⧸ Ideal.span {x})) : ℕ) : WithBot ℕ∞) := by
    rw [hj, hje, he]
  refine ⟨IsRegularLocalRing.mk hdimA'.symm, ?_⟩
  rw [hj, hdimA, hje]
  push_cast
  ring

theorem wc_rl_isDomain : (∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A] (x : A), x ∈ IsLocalRing.maximalIdeal A → x ∉ IsLocalRing.maximalIdeal A ^ 2 → ∃ (_ : IsLocalRing (A ⧸ Ideal.span {x})), Submodule.spanFinrank (IsLocalRing.maximalIdeal (A ⧸ Ideal.span {x})) + 1 = Submodule.spanFinrank (IsLocalRing.maximalIdeal A)) → (∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A], IsRegularLocalRing A → ∀ x : A, x ∈ IsLocalRing.maximalIdeal A → x ∉ IsLocalRing.maximalIdeal A ^ 2 → IsRegularLocalRing (A ⧸ Ideal.span {x}) ∧ ringKrullDim (A ⧸ Ideal.span {x}) + 1 = ringKrullDim A) → ∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A], IsRegularLocalRing A → IsDomain A :=
by
  intro EMB QR

  have s2 : ∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A], IsRegularLocalRing A →
      Submodule.spanFinrank (IsLocalRing.maximalIdeal A) ≠ 0 →
      IsLocalRing.maximalIdeal A ∉ minimalPrimes A := by
    intro A _ _ _ hA hne hmin
    have : (IsLocalRing.maximalIdeal A).IsPrime :=
      Ideal.IsMaximal.isPrime (IsLocalRing.maximalIdeal.isMaximal A)
    have h0 : (IsLocalRing.maximalIdeal A).height = 0 := Ideal.height_eq_zero_iff.mpr hmin
    have h1 := IsLocalRing.maximalIdeal_height_eq_ringKrullDim (R := A)
    have h2 := hA.spanFinrank_maximalIdeal
    rw [h0, ← h2] at h1
    apply hne
    exact_mod_cast h1.symm

  have s3 : ∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A],
      IsLocalRing.maximalIdeal A ≠ ⊥ → IsLocalRing.maximalIdeal A ∉ minimalPrimes A →
      ∃ x ∈ IsLocalRing.maximalIdeal A, x ∉ IsLocalRing.maximalIdeal A ^ 2 ∧
        ∀ P ∈ minimalPrimes A, x ∉ P := by
    intro A _ _ _ hbot hmin
    set m := IsLocalRing.maximalIdeal A with hm
    have hfin : (insert (m ^ 2) (minimalPrimes A)).Finite :=
      (minimalPrimes.finite_of_isNoetherianRing A).insert (m ^ 2)
    have hiff := Ideal.subset_union_prime_finite hfin (f := id) (m ^ 2) (m ^ 2)
      (fun i hi hia _ => by
        rcases Set.mem_insert_iff.mp hi with h | h
        · exact absurd h hia
        · exact Ideal.minimalPrimes_isPrime h) (I := m)
    have hnot0 : ¬ ∃ i ∈ insert (m ^ 2) (minimalPrimes A), m ≤ id i := by
      rintro ⟨i, hi, hle⟩
      rcases Set.mem_insert_iff.mp hi with h | h
      · subst h
        apply hbot
        have hle' : m ≤ m • m := by
          simpa [pow_two, Ideal.smul_eq_mul] using hle
        exact Submodule.eq_bot_of_le_smul_of_le_jacobson_bot m m (IsNoetherian.noetherian m) hle'
          (IsLocalRing.maximalIdeal_le_jacobson ⊥)
      · apply hmin
        have hP : i.IsPrime := Ideal.minimalPrimes_isPrime h
        have : i ≤ m := IsLocalRing.le_maximalIdeal hP.ne_top
        have heq : i = m := le_antisymm this hle
        rw [← heq]; exact h
    have hnot := mt hiff.mp hnot0
    rw [Set.not_subset] at hnot
    obtain ⟨x, hxm, hx⟩ := hnot
    simp only [Set.mem_iUnion, not_exists] at hx
    refine ⟨x, hxm, fun h => hx (m ^ 2) (Set.mem_insert _ _) h,
      fun P hP h => hx P (Set.mem_insert_of_mem _ hP) h⟩

  have s4 : ∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A] (x : A),
      x ∈ IsLocalRing.maximalIdeal A → (Ideal.span {x}).IsPrime →
      (∀ P ∈ minimalPrimes A, x ∉ P) → IsDomain A := by
    intro A _ _ _ x hx hJ hav
    obtain ⟨P₀, hP₀, hle⟩ :=
      Ideal.exists_minimalPrimes_le (I := (⊥ : Ideal A)) (J := Ideal.span {x}) bot_le
    have hP₀' : P₀ ∈ minimalPrimes A := hP₀
    have hxP : x ∉ P₀ := hav P₀ hP₀'
    have hpr : P₀.IsPrime := Ideal.minimalPrimes_isPrime hP₀
    have hsm : P₀ ≤ Ideal.span {x} • P₀ := by
      intro y hy
      obtain ⟨a, rfl⟩ := Ideal.mem_span_singleton'.mp (hle hy)
      have ha : a ∈ P₀ := (hpr.mem_or_mem hy).resolve_right hxP
      have e : a * x = x • a := by rw [smul_eq_mul, mul_comm]
      rw [e]
      exact Submodule.smul_mem_smul (Ideal.mem_span_singleton_self x) ha
    have hJle : Ideal.span {x} ≤ (⊥ : Ideal A).jacobson :=
      le_trans ((Ideal.span_singleton_le_iff_mem _).mpr hx) (IsLocalRing.maximalIdeal_le_jacobson ⊥)
    have hP0 : P₀ = ⊥ := Submodule.eq_bot_of_le_smul_of_le_jacobson_bot _ P₀
      (IsNoetherian.noetherian P₀) hsm hJle
    haveI : (⊥ : Ideal A).IsPrime := hP0 ▸ hpr
    exact IsDomain.of_bot_isPrime A

  have P : ∀ d : ℕ, ∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A],
      IsRegularLocalRing A → Submodule.spanFinrank (IsLocalRing.maximalIdeal A) = d →
      IsDomain A := by
    intro d
    induction d with
    | zero =>
      intro A _ _ _ _ hd
      have hb : IsLocalRing.maximalIdeal A = ⊥ :=
        (Submodule.spanFinrank_eq_zero_iff_eq_bot (IsNoetherian.noetherian _)).mp hd
      haveI : (⊥ : Ideal A).IsPrime :=
        hb ▸ Ideal.IsMaximal.isPrime (IsLocalRing.maximalIdeal.isMaximal A)
      exact IsDomain.of_bot_isPrime A
    | succ d ih =>
      intro A _ _ _ hA hd
      have hbot : IsLocalRing.maximalIdeal A ≠ ⊥ := by
        intro h
        rw [h, Submodule.spanFinrank_bot] at hd
        omega
      have hmin := s2 A hA (by omega)
      obtain ⟨x, hx, hx2, hav⟩ := s3 A hbot hmin
      obtain ⟨hloc, hemb⟩ := EMB A x hx hx2
      haveI := hloc
      have hreg := (QR A hA x hx hx2).1
      have hdom : IsDomain (A ⧸ Ideal.span {x}) := ih _ hreg (by omega)
      have hJ : (Ideal.span {x}).IsPrime := (Ideal.Quotient.isDomain_iff_prime _).mp hdom
      exact s4 A x hx hJ hav
  intro A _ _ _ hA
  exact P _ A hA rfl

theorem wc_rl_socle_or_regular_elem : ∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A], IsLocalRing.maximalIdeal A ≠ ⊥ → (∃ z : A, z ≠ 0 ∧ ∀ y ∈ IsLocalRing.maximalIdeal A, z * y = 0) ∨ (∃ x ∈ IsLocalRing.maximalIdeal A, x ∉ IsLocalRing.maximalIdeal A ^ 2 ∧ IsSMulRegular A x) :=
by
  intro A _ _ _ hm
  classical
  by_cases hAss : IsLocalRing.maximalIdeal A ∈ associatedPrimes A A
  · left
    have hA : IsAssociatedPrime (IsLocalRing.maximalIdeal A) A := AssociatedPrimes.mem_iff.mp hAss
    obtain ⟨hprime, z, hz⟩ := isAssociatedPrime_iff.mp hA
    have hmem : ∀ y, y ∈ IsLocalRing.maximalIdeal A ↔ y * z = 0 := by
      intro y
      rw [hz, Submodule.mem_colon_singleton, Submodule.mem_bot, smul_eq_mul]
    refine ⟨z, ?_, ?_⟩
    · rintro rfl
      apply hprime.ne_top
      rw [eq_top_iff]
      intro y _
      exact (hmem y).mpr (mul_zero y)
    · intro y hy
      rw [mul_comm]
      exact (hmem y).mp hy
  · right
    have hAssle : ∀ p ∈ associatedPrimes A A,
        p.IsPrime ∧ p ≤ IsLocalRing.maximalIdeal A ∧ p ≠ IsLocalRing.maximalIdeal A := by
      intro p hp
      have hpr : p.IsPrime := (AssociatedPrimes.mem_iff.mp hp).isPrime
      exact ⟨hpr, IsLocalRing.le_maximalIdeal hpr.ne_top, fun h => hAss (h ▸ hp)⟩
    have hfin : (associatedPrimes A A).Finite := associatedPrimes.finite A A
    have hsfin : (insert (IsLocalRing.maximalIdeal A ^ 2) (associatedPrimes A A)).Finite :=
      hfin.insert _
    have hpa := Ideal.subset_union_prime_finite (R := A) (f := id) hsfin
      (IsLocalRing.maximalIdeal A ^ 2) (IsLocalRing.maximalIdeal A ^ 2)
      (fun i hi hne _ => by
        rcases (Set.mem_insert_iff.mp hi) with h | h
        · exact absurd h hne
        · exact (hAssle i h).1) (I := IsLocalRing.maximalIdeal A)
    have hnot : ¬ ((IsLocalRing.maximalIdeal A : Set A) ⊆
        ⋃ i ∈ insert (IsLocalRing.maximalIdeal A ^ 2) (associatedPrimes A A),
          ((id i : Ideal A) : Set A)) := by
      intro hsub
      obtain ⟨i, hi, hle⟩ := hpa.mp hsub
      rcases (Set.mem_insert_iff.mp hi) with h | h
      · rw [h] at hle
        apply hm
        apply Submodule.eq_bot_of_le_smul_of_le_jacobson_bot (IsLocalRing.maximalIdeal A)
          (IsLocalRing.maximalIdeal A) (IsNoetherian.noetherian _)
        · rw [Ideal.smul_eq_mul, ← pow_two]
          exact hle
        · exact IsLocalRing.maximalIdeal_le_jacobson ⊥
      · exact (hAssle i h).2.2 (le_antisymm (hAssle i h).2.1 hle)
    obtain ⟨x, hxm, hxs⟩ := Set.not_subset.mp hnot
    refine ⟨x, hxm, ?_, ?_⟩
    · intro hx2
      apply hxs
      exact Set.mem_iUnion₂.mpr ⟨IsLocalRing.maximalIdeal A ^ 2, Set.mem_insert _ _, hx2⟩
    · have hx : x ∉ ⋃ p ∈ associatedPrimes A A, (p : Set A) := by
        intro hx
        obtain ⟨p, hp, hxp⟩ := Set.mem_iUnion₂.mp hx
        exact hxs (Set.mem_iUnion₂.mpr ⟨p, Set.mem_insert_of_mem _ hp, hxp⟩)
      rw [biUnion_associatedPrimes_eq_compl_regular] at hx
      simpa using hx

theorem wc_rl_min_presentation : ∀ (A : Type u) [CommRing A] [IsLocalRing A] (M : Type u) [AddCommGroup M] [Module A M] [Module.Finite A M], ∃ (r : ℕ) (π : (Fin r → A) →ₗ[A] M), Function.Surjective π ∧ ∀ v : Fin r → A, π v = 0 → ∀ i, v i ∈ IsLocalRing.maximalIdeal A :=
by
  classical
  intro A _ _ M _ _ _
  have hex : ∃ n, ∃ s : Fin n → M, Submodule.span A (Set.range s) = ⊤ :=
    Module.Finite.exists_fin
  have key : ∀ (n : ℕ) (s : Fin n → M), Submodule.span A (Set.range s) = ⊤ →
      (∀ m, (∃ t : Fin m → M, Submodule.span A (Set.range t) = ⊤) → n ≤ m) →
      ∀ v : Fin n → A, ∑ j, v j • s j = 0 → ∀ i, v i ∈ IsLocalRing.maximalIdeal A := by
    intro n s hs hmin v hv i
    by_contra hvi
    obtain ⟨u, hu⟩ := IsLocalRing.notMem_maximalIdeal.mp hvi
    obtain ⟨k, rfl⟩ : ∃ k, n = k + 1 := ⟨n - 1, by have := i.pos; omega⟩
    set N := Submodule.span A (Set.range (fun z : Fin k => s (i.succAbove z))) with hN
    have hw : ∑ z : Fin k, v (i.succAbove z) • s (i.succAbove z) ∈ N :=
      Submodule.sum_mem _ (fun z _ => Submodule.smul_mem _ _ (Submodule.subset_span ⟨z, rfl⟩))
    rw [Fin.sum_univ_succAbove _ i] at hv
    have hsi : v i • s i ∈ N := by
      have e : v i • s i = -(∑ z : Fin k, v (i.succAbove z) • s (i.succAbove z)) :=
        eq_neg_of_add_eq_zero_left hv
      rw [e]
      exact N.neg_mem hw
    have hsi' : s i ∈ N := by
      have e : s i = ((u⁻¹ : Aˣ) : A) • (v i • s i) := by
        rw [← hu, smul_smul, Units.inv_mul, one_smul]
      rw [e]
      exact N.smul_mem _ hsi
    have hall : Set.range s ⊆ N := by
      rintro _ ⟨j, rfl⟩
      by_cases hj : j = i
      · rw [hj]; exact hsi'
      · obtain ⟨z, rfl⟩ := Fin.exists_succAbove_eq hj
        exact Submodule.subset_span ⟨z, rfl⟩
    have hNtop : N = ⊤ := by
      rw [eq_top_iff, ← hs]
      exact Submodule.span_le.mpr hall
    have := hmin k ⟨_, hNtop⟩
    omega
  obtain ⟨s, hs⟩ := Nat.find_spec hex
  refine ⟨Nat.find hex, Fintype.linearCombination A s, ?_, ?_⟩
  · rw [← LinearMap.range_eq_top, Fintype.range_linearCombination, hs]
  · intro v hv
    refine key _ s hs (fun m hm => Nat.find_min' hex hm) v ?_
    rw [Fintype.linearCombination_apply] at hv
    exact hv

theorem wc_rl_quotSMulTop_map_injective : ∀ (A : Type u) [CommRing A] (x : A) (K : Type u) [AddCommGroup K] [Module A K] (F : Type u) [AddCommGroup F] [Module A F] (N : Type u) [AddCommGroup N] [Module A N] (f : K →ₗ[A] F) (g : F →ₗ[A] N), Function.Injective f → Function.Exact f g → IsSMulRegular N x → Function.Injective (QuotSMulTop.map x f) :=
by
  intro A _ x K _ _ F _ _ N _ _ f g hf hex hreg
  rw [injective_iff_map_eq_zero]
  intro ξ hξ
  obtain ⟨k, rfl⟩ := Submodule.Quotient.mk_surjective _ ξ
  rw [QuotSMulTop.map_apply_mk, Submodule.Quotient.mk_eq_zero] at hξ
  obtain ⟨y, -, hy⟩ := (Submodule.mem_smul_pointwise_iff_exists _ _ _).mp hξ
  have hgy : g y = 0 := by
    apply hreg.right_eq_zero_of_smul
    rw [← map_smul, hy]
    exact hex.apply_apply_eq_zero k
  obtain ⟨k', rfl⟩ := (hex y).mp hgy
  have hk : x • k' = k := hf (by rw [map_smul, hy])
  rw [Submodule.Quotient.mk_eq_zero]
  exact (Submodule.mem_smul_pointwise_iff_exists _ _ _).mpr ⟨k', Submodule.mem_top, hk⟩

theorem wc_rl_quotSMulTop_projective : ∀ (A : Type u) [CommRing A] (x : A) (P : Type u) [AddCommGroup P] [Module A P] [Module.Projective A P], Module.Projective (A ⧸ Ideal.span {x}) (QuotSMulTop x P) :=
by
  intro A _ x P _ _ _
  exact Module.Projective.of_equiv
    (LinearEquiv.extendScalarsOfSurjective (S := A ⧸ Ideal.span {x})
      Ideal.Quotient.mk_surjective (QuotSMulTop.equivQuotTensor x P)).symm

theorem wc_rl_pd_quot_ascent : (∀ (A : Type u) [CommRing A] (x : A) (K : Type u) [AddCommGroup K] [Module A K] (F : Type u) [AddCommGroup F] [Module A F] (N : Type u) [AddCommGroup N] [Module A N] (f : K →ₗ[A] F) (g : F →ₗ[A] N), Function.Injective f → Function.Exact f g → IsSMulRegular N x → Function.Injective (QuotSMulTop.map x f)) → (∀ (A : Type u) [CommRing A] (x : A) (P : Type u) [AddCommGroup P] [Module A P] [Module.Projective A P], Module.Projective (A ⧸ Ideal.span {x}) (QuotSMulTop x P)) → ∀ (A : Type u) [CommRing A] (x : A), IsSMulRegular A x → ∀ (M : Type u) [AddCommGroup M] [Module A M], IsSMulRegular M x → ∀ n : ℕ, CategoryTheory.HasProjectiveDimensionLT (ModuleCat.of A M) n → CategoryTheory.HasProjectiveDimensionLT (ModuleCat.of (A ⧸ Ideal.span {x}) (QuotSMulTop x M)) n :=
by
  intro INJ QPROJ A _ x hA

  have ses : ∀ (R : Type u) [CommRing R] (K : Type u) [AddCommGroup K] [Module R K]
      (F : Type u) [AddCommGroup F] [Module R F] (N : Type u) [AddCommGroup N] [Module R N]
      (f : K →ₗ[R] F) (g : F →ₗ[R] N), Function.Injective f → Function.Exact f g →
      Function.Surjective g → Module.Projective R F → ∀ m : ℕ,
      (HasProjectiveDimensionLT (ModuleCat.of R N) (m + 2) →
        HasProjectiveDimensionLT (ModuleCat.of R K) (m + 1)) ∧
      (HasProjectiveDimensionLT (ModuleCat.of R K) (m + 1) →
        HasProjectiveDimensionLT (ModuleCat.of R N) (m + 2)) := by
    intro R _ K _ _ F _ _ N _ _ f g hf hex hg hP m
    let S : ShortComplex (ModuleCat.{u} R) :=
      ShortComplex.mk (ModuleCat.ofHom f) (ModuleCat.ofHom g) (by
        ext k; exact hex.apply_apply_eq_zero k)
    have hS : S.ShortExact := by
      refine ShortComplex.ShortExact.mk' ?_ ?_ ?_
      · exact (ShortComplex.ShortExact.moduleCat_exact_iff_function_exact S).mpr hex
      · exact (ModuleCat.mono_iff_injective _).mpr hf
      · exact (ModuleCat.epi_iff_surjective _).mpr hg
    have hF1 : HasProjectiveDimensionLT (ModuleCat.of R F) 1 := by
      rw [← projective_iff_hasProjectiveDimensionLT_one]
      exact (IsProjective.iff_projective F).mp hP
    have hFk : ∀ k : ℕ, HasProjectiveDimensionLT (ModuleCat.of R F) (k + 1) := fun k =>
      hasProjectiveDimensionLT_of_ge _ 1 (k + 1) (by omega)
    constructor
    · intro hN
      exact hS.hasProjectiveDimensionLT_X₁ (m + 1) (hFk m) hN
    · intro hK
      exact hS.hasProjectiveDimensionLT_X₃ (m + 1) hK (hFk (m + 1))
  have hsurj : Function.Surjective (algebraMap A (A ⧸ Ideal.span {x})) :=
    Ideal.Quotient.mk_surjective
  have key : ∀ m : ℕ, ∀ (M : Type u) [AddCommGroup M] [Module A M], IsSMulRegular M x →
      HasProjectiveDimensionLT (ModuleCat.of A M) (m + 1) →
      HasProjectiveDimensionLT (ModuleCat.of (A ⧸ Ideal.span {x}) (QuotSMulTop x M)) (m + 1) := by
    intro m
    induction m with
    | zero =>
      intro M _ _ _ hM
      rw [zero_add, ← projective_iff_hasProjectiveDimensionLT_one] at hM ⊢
      have := (IsProjective.iff_projective M).mpr hM
      exact (IsProjective.iff_projective (R := A ⧸ Ideal.span {x}) (QuotSMulTop x M)).mp
        (QPROJ A x M)
    | succ m ih =>
      intro M _ _ hMx hM
      let g : (M →₀ A) →ₗ[A] M := Finsupp.linearCombination A id
      have hg : Function.Surjective g := Finsupp.linearCombination_id_surjective A M
      let f : LinearMap.ker g →ₗ[A] (M →₀ A) := (LinearMap.ker g).subtype
      have hf : Function.Injective f := (LinearMap.ker g).injective_subtype
      have hex : Function.Exact f g := LinearMap.exact_subtype_ker_map g
      have hK : HasProjectiveDimensionLT (ModuleCat.of A (LinearMap.ker g)) (m + 1) :=
        (ses A (LinearMap.ker g) (M →₀ A) M f g hf hex hg inferInstance m).1 hM
      have hFx : IsSMulRegular (M →₀ A) x := IsSMulRegular.finsupp hA
      have hKx : IsSMulRegular (LinearMap.ker g) x := IsSMulRegular.of_injective f hf hFx
      have hK' := ih (LinearMap.ker g) hKx hK
      let f' := LinearMap.extendScalarsOfSurjective hsurj
        (QuotSMulTop.map (M := LinearMap.ker g) (M' := M →₀ A) x f)
      let g' := LinearMap.extendScalarsOfSurjective hsurj
        (QuotSMulTop.map (M := M →₀ A) (M' := M) x g)
      have ef : (⇑f' : QuotSMulTop x (LinearMap.ker g) → QuotSMulTop x (M →₀ A)) =
          ⇑(QuotSMulTop.map (M := LinearMap.ker g) (M' := M →₀ A) x f) :=
        funext fun v => LinearMap.extendScalarsOfSurjective_apply hsurj _ v
      have eg : (⇑g' : QuotSMulTop x (M →₀ A) → QuotSMulTop x M) =
          ⇑(QuotSMulTop.map (M := M →₀ A) (M' := M) x g) :=
        funext fun v => LinearMap.extendScalarsOfSurjective_apply hsurj _ v
      have hinj := INJ A x (LinearMap.ker g) (M →₀ A) M f g hf hex hMx
      have hf' : Function.Injective f' := by
        rw [ef]; exact hinj
      have hex' : Function.Exact f' g' := by
        rw [ef, eg]; exact QuotSMulTop.map_exact x hex hg
      have hg' : Function.Surjective g' := by
        rw [eg]; exact QuotSMulTop.map_surjective x hg
      exact (ses _ _ _ _ f' g' hf' hex' hg' (QPROJ A x (M →₀ A)) m).2 hK'
  intro M _ _ hMx n hn
  cases n with
  | zero =>
    rw [hasProjectiveDimensionLT_zero_iff_isZero, ModuleCat.isZero_iff_subsingleton] at hn ⊢
    have : Subsingleton M := hn
    exact (Submodule.mkQ_surjective _).subsingleton
  | succ m => exact key m M hMx hn

theorem wc_rl_pd_quot_descent : (∀ (A : Type u) [CommRing A] [IsLocalRing A] (M : Type u) [AddCommGroup M] [Module A M] [Module.Finite A M], ∃ (r : ℕ) (π : (Fin r → A) →ₗ[A] M), Function.Surjective π ∧ ∀ v : Fin r → A, π v = 0 → ∀ i, v i ∈ IsLocalRing.maximalIdeal A) → (∀ (A : Type u) [CommRing A] (x : A) (K : Type u) [AddCommGroup K] [Module A K] (F : Type u) [AddCommGroup F] [Module A F] (N : Type u) [AddCommGroup N] [Module A N] (f : K →ₗ[A] F) (g : F →ₗ[A] N), Function.Injective f → Function.Exact f g → IsSMulRegular N x → Function.Injective (QuotSMulTop.map x f)) → (∀ (A : Type u) [CommRing A] (x : A) (P : Type u) [AddCommGroup P] [Module A P] [Module.Projective A P], Module.Projective (A ⧸ Ideal.span {x}) (QuotSMulTop x P)) → ∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A] (x : A), x ∈ IsLocalRing.maximalIdeal A → IsSMulRegular A x → ∀ (N : Type u) [AddCommGroup N] [Module A N] [Module.Finite A N], IsSMulRegular N x → ∀ n : ℕ, CategoryTheory.HasProjectiveDimensionLT (ModuleCat.of (A ⧸ Ideal.span {x}) (QuotSMulTop x N)) n → CategoryTheory.HasProjectiveDimensionLT (ModuleCat.of A N) n :=
by
  intro MINP INJ QPROJ A _ _ _ x hx hA

  have ses : ∀ (R : Type u) [CommRing R] (K : Type u) [AddCommGroup K] [Module R K]
      (F : Type u) [AddCommGroup F] [Module R F] (N : Type u) [AddCommGroup N] [Module R N]
      (f : K →ₗ[R] F) (g : F →ₗ[R] N), Function.Injective f → Function.Exact f g →
      Function.Surjective g → Module.Projective R F → ∀ m : ℕ,
      (HasProjectiveDimensionLT (ModuleCat.of R N) (m + 2) →
        HasProjectiveDimensionLT (ModuleCat.of R K) (m + 1)) ∧
      (HasProjectiveDimensionLT (ModuleCat.of R K) (m + 1) →
        HasProjectiveDimensionLT (ModuleCat.of R N) (m + 2)) := by
    intro R _ K _ _ F _ _ N _ _ f g hf hex hg hP m
    let S : ShortComplex (ModuleCat.{u} R) :=
      ShortComplex.mk (ModuleCat.ofHom f) (ModuleCat.ofHom g) (by
        ext k; exact hex.apply_apply_eq_zero k)
    have hS : S.ShortExact := by
      refine ShortComplex.ShortExact.mk' ?_ ?_ ?_
      · exact (ShortComplex.ShortExact.moduleCat_exact_iff_function_exact S).mpr hex
      · exact (ModuleCat.mono_iff_injective _).mpr hf
      · exact (ModuleCat.epi_iff_surjective _).mpr hg
    have hF1 : HasProjectiveDimensionLT (ModuleCat.of R F) 1 := by
      rw [← projective_iff_hasProjectiveDimensionLT_one]
      exact (IsProjective.iff_projective F).mp hP
    have hFk : ∀ k : ℕ, HasProjectiveDimensionLT (ModuleCat.of R F) (k + 1) := fun k =>
      hasProjectiveDimensionLT_of_ge _ 1 (k + 1) (by omega)
    constructor
    · intro hN
      exact hS.hasProjectiveDimensionLT_X₁ (m + 1) (hFk m) hN
    · intro hK
      exact hS.hasProjectiveDimensionLT_X₃ (m + 1) hK (hFk (m + 1))
  have hsurj : Function.Surjective (algebraMap A (A ⧸ Ideal.span {x})) :=
    Ideal.Quotient.mk_surjective
  have hjac : IsLocalRing.maximalIdeal A ≤ (⊥ : Ideal A).jacobson :=
    IsLocalRing.maximalIdeal_le_jacobson ⊥

  have NAK : ∀ (M : Type u) [AddCommGroup M] [Module A M] [Module.Finite A M],
      Subsingleton (QuotSMulTop x M) → Subsingleton M := by
    intro M _ _ _ hM
    have h1 := Submodule.Quotient.subsingleton_iff.mp hM
    have h2 : (⊤ : Submodule A M) ≤ Ideal.span {x} • ⊤ := by
      rw [Submodule.ideal_span_singleton_smul]
      exact h1.ge
    have hle : Ideal.span {x} ≤ (⊥ : Ideal A).jacobson :=
      le_trans ((Ideal.span_singleton_le_iff_mem _).mpr hx) hjac
    have h3 := Submodule.eq_bot_of_le_smul_of_le_jacobson_bot (Ideal.span {x}) ⊤
      Module.Finite.fg_top h2 hle
    refine subsingleton_of_forall_eq 0 (fun m => ?_)
    have hm : m ∈ (⊤ : Submodule A M) := trivial
    rw [h3] at hm
    exact (Submodule.mem_bot A).mp hm

  have PROJ : ∀ (N : Type u) [AddCommGroup N] [Module A N] [Module.Finite A N],
      IsSMulRegular N x → Module.Projective (A ⧸ Ideal.span {x}) (QuotSMulTop x N) →
      Module.Projective A N := by
    intro N _ _ _ hNx hNp
    obtain ⟨r, π, hπs, hπm⟩ := MINP A N
    let f : LinearMap.ker π →ₗ[A] (Fin r → A) := (LinearMap.ker π).subtype
    have hf : Function.Injective f := (LinearMap.ker π).injective_subtype
    have hex : Function.Exact f π := LinearMap.exact_subtype_ker_map π
    let fb := QuotSMulTop.map (M := LinearMap.ker π) (M' := Fin r → A) x f
    let gb := QuotSMulTop.map (M := Fin r → A) (M' := N) x π
    have hfb : Function.Injective fb := INJ A x (LinearMap.ker π) (Fin r → A) N f π hf hex hNx
    have hexb : Function.Exact fb gb := QuotSMulTop.map_exact x hex hπs
    have hgbs : Function.Surjective gb := QuotSMulTop.map_surjective x hπs
    let gb' := LinearMap.extendScalarsOfSurjective hsurj gb
    have egb : (⇑gb' : QuotSMulTop x (Fin r → A) → QuotSMulTop x N) = ⇑gb :=
      funext fun v => LinearMap.extendScalarsOfSurjective_apply hsurj _ v
    have hgb's : Function.Surjective gb' := by
      rw [egb]; exact hgbs
    haveI := hNp
    obtain ⟨s, hs⟩ := Module.projective_lifting_property gb' LinearMap.id hgb's
    let sA : QuotSMulTop x N →ₗ[A] QuotSMulTop x (Fin r → A) := s.restrictScalars A
    have hgs : ∀ y, gb (sA y) = y := fun y => by
      have h := LinearMap.congr_fun hs y
      rw [LinearMap.comp_apply, LinearMap.id_apply] at h
      change gb (s y) = y
      exact (congrFun egb (s y)).symm.trans h
    let e : QuotSMulTop x (Fin r → A) →ₗ[A] QuotSMulTop x (Fin r → A) :=
      LinearMap.id - sA.comp gb
    have he1 : ∀ v, gb (e v) = 0 := by
      intro v
      simp only [e, LinearMap.sub_apply, LinearMap.id_apply, LinearMap.comp_apply, map_sub, hgs,
        sub_self]
    have he2 : ∀ v, gb v = 0 → e v = v := by
      intro v hv
      simp only [e, LinearMap.sub_apply, LinearMap.id_apply, LinearMap.comp_apply, hv, map_zero,
        sub_zero]
    let ψ : (Fin r → A) →ₗ[A] QuotSMulTop x (Fin r → A) := e.comp (Submodule.mkQ _)
    let W : Submodule A (QuotSMulTop x (Fin r → A)) := LinearMap.range fb
    have hW : W ≤ IsLocalRing.maximalIdeal A • W := by
      intro w hw
      obtain ⟨kb, rfl⟩ := LinearMap.mem_range.mp hw
      obtain ⟨k, rfl⟩ := Submodule.mkQ_surjective _ kb
      have hk0 : π (k : Fin r → A) = 0 := k.2
      have hcoef := hπm _ hk0
      have hgw : gb (fb (Submodule.mkQ _ k)) = 0 := hexb.apply_apply_eq_zero _
      have hw' : fb (Submodule.mkQ _ k) = ψ (k : Fin r → A) := by
        rw [← he2 _ hgw]
        rfl
      rw [hw']
      have hψ : ψ (k : Fin r → A) = ∑ i, (k : Fin r → A) i •
          ψ (fun j => if i = j then (1 : A) else 0) := by
        conv_lhs => rw [pi_eq_sum_univ (k : Fin r → A)]
        rw [map_sum]
        simp only [map_smul]
      rw [hψ]
      exact Submodule.sum_mem _ fun i _ =>
        Submodule.smul_mem_smul (hcoef i) ((hexb _).mp (he1 _))
    have hWfg : W.FG := by
      change (LinearMap.range fb).FG
      rw [LinearMap.range_eq_map]
      exact Module.Finite.fg_top.map fb
    have hW0 : W = ⊥ := Submodule.eq_bot_of_le_smul_of_le_jacobson_bot _ W hWfg hW hjac
    have hK' : Subsingleton (QuotSMulTop x (LinearMap.ker π)) :=
      subsingleton_of_forall_eq 0 fun kb => hfb (by
        have h : fb kb ∈ W := LinearMap.mem_range_self fb kb
        rw [hW0] at h
        rw [(Submodule.mem_bot A).mp h, map_zero])
    have hK : Subsingleton (LinearMap.ker π) := NAK (LinearMap.ker π) hK'
    have hπi : Function.Injective π := by
      refine LinearMap.ker_eq_bot.mp (eq_bot_iff.mpr fun v hv => ?_)
      exact (Submodule.mem_bot A).mpr
        (congrArg Subtype.val (Subsingleton.elim (⟨v, hv⟩ : LinearMap.ker π) 0))
    exact Module.Projective.of_equiv (LinearEquiv.ofBijective π ⟨hπi, hπs⟩)

  have key : ∀ m : ℕ, ∀ (N : Type u) [AddCommGroup N] [Module A N] [Module.Finite A N],
      IsSMulRegular N x →
      HasProjectiveDimensionLT (ModuleCat.of (A ⧸ Ideal.span {x}) (QuotSMulTop x N)) (m + 1) →
      HasProjectiveDimensionLT (ModuleCat.of A N) (m + 1) := by
    intro m
    induction m with
    | zero =>
      intro N _ _ _ hNx hN
      rw [zero_add, ← projective_iff_hasProjectiveDimensionLT_one] at hN ⊢
      have hP := (IsProjective.iff_projective (R := A ⧸ Ideal.span {x}) (QuotSMulTop x N)).mpr hN
      exact (IsProjective.iff_projective N).mp (PROJ N hNx hP)
    | succ m ih =>
      intro N _ _ _ hNx hN
      obtain ⟨r, π, hπs, -⟩ := MINP A N
      let f : LinearMap.ker π →ₗ[A] (Fin r → A) := (LinearMap.ker π).subtype
      have hf : Function.Injective f := (LinearMap.ker π).injective_subtype
      have hex : Function.Exact f π := LinearMap.exact_subtype_ker_map π
      have hFx : IsSMulRegular (Fin r → A) x := IsSMulRegular.pi (fun _ => hA)
      have hKx : IsSMulRegular (LinearMap.ker π) x := IsSMulRegular.of_injective f hf hFx
      let f' := LinearMap.extendScalarsOfSurjective hsurj
        (QuotSMulTop.map (M := LinearMap.ker π) (M' := Fin r → A) x f)
      let g' := LinearMap.extendScalarsOfSurjective hsurj
        (QuotSMulTop.map (M := Fin r → A) (M' := N) x π)
      have ef : (⇑f' : QuotSMulTop x (LinearMap.ker π) → QuotSMulTop x (Fin r → A)) =
          ⇑(QuotSMulTop.map (M := LinearMap.ker π) (M' := Fin r → A) x f) :=
        funext fun v => LinearMap.extendScalarsOfSurjective_apply hsurj _ v
      have eg : (⇑g' : QuotSMulTop x (Fin r → A) → QuotSMulTop x N) =
          ⇑(QuotSMulTop.map (M := Fin r → A) (M' := N) x π) :=
        funext fun v => LinearMap.extendScalarsOfSurjective_apply hsurj _ v
      have hinj := INJ A x (LinearMap.ker π) (Fin r → A) N f π hf hex hNx
      have hf' : Function.Injective f' := by
        rw [ef]; exact hinj
      have hex' : Function.Exact f' g' := by
        rw [ef, eg]; exact QuotSMulTop.map_exact x hex hπs
      have hg' : Function.Surjective g' := by
        rw [eg]; exact QuotSMulTop.map_surjective x hπs
      have hK' := (ses _ _ _ _ f' g' hf' hex' hg' (QPROJ A x (Fin r → A)) m).1 hN
      have hK := ih (LinearMap.ker π) hKx hK'
      exact (ses A _ _ _ f π hf hex hπs inferInstance m).2 hK
  intro N _ _ _ hNx n hn
  cases n with
  | zero =>
    rw [hasProjectiveDimensionLT_zero_iff_isZero, ModuleCat.isZero_iff_subsingleton] at hn ⊢
    exact NAK N hn
  | succ m => exact key m N hNx hn

theorem wc_rl_pd_free_of_socle : (∀ (A : Type u) [CommRing A] [IsLocalRing A] (M : Type u) [AddCommGroup M] [Module A M] [Module.Finite A M], ∃ (r : ℕ) (π : (Fin r → A) →ₗ[A] M), Function.Surjective π ∧ ∀ v : Fin r → A, π v = 0 → ∀ i, v i ∈ IsLocalRing.maximalIdeal A) → ∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A] (z : A), z ≠ 0 → (∀ y ∈ IsLocalRing.maximalIdeal A, z * y = 0) → ∀ (M : Type u) [AddCommGroup M] [Module A M] [Module.Finite A M] (n : ℕ), CategoryTheory.HasProjectiveDimensionLT (ModuleCat.of A M) n → Module.Free A M :=
by
  intro MINP A _ _ _ z hz hsoc

  have socle : ∀ (r : ℕ) (K : Submodule A (Fin r → A)),
      (∀ v ∈ K, ∀ i, v i ∈ IsLocalRing.maximalIdeal A) → Module.Free A K → K = ⊥ := by
    intro r K hK hfree
    by_contra hne
    haveI : Nontrivial K := Submodule.nontrivial_iff_ne_bot.mpr hne
    let b := Module.Free.chooseBasis A K
    obtain ⟨i⟩ := b.index_nonempty
    have h1 : z • b i = 0 := by
      apply Subtype.ext
      funext j
      simp only [Submodule.coe_smul, Pi.smul_apply, smul_eq_mul, Submodule.coe_zero,
        Pi.zero_apply]
      exact hsoc _ (hK _ (b i).2 j)
    have h2 := congrArg b.repr h1
    rw [map_smul, b.repr_self, map_zero, Finsupp.smul_single, smul_eq_mul, mul_one,
      Finsupp.single_eq_zero] at h2
    exact hz h2

  have shift : ∀ (M : Type u) [AddCommGroup M] [Module A M] (r : ℕ)
      (π : (Fin r → A) →ₗ[A] M), Function.Surjective π → ∀ n : ℕ,
      HasProjectiveDimensionLT (ModuleCat.of A M) (n + 2) →
      HasProjectiveDimensionLT (ModuleCat.of A (LinearMap.ker π)) (n + 1) := by
    intro M _ _ r π hπ n hM
    let S : ShortComplex (ModuleCat.{u} A) :=
      ShortComplex.mk (ModuleCat.ofHom (LinearMap.ker π).subtype) (ModuleCat.ofHom π)
        (by ext x; exact x.2)
    have hS : S.ShortExact := by
      refine ShortComplex.ShortExact.mk' ?_ ?_ ?_
      · rw [ShortComplex.moduleCat_exact_iff]
        intro x hx
        exact ⟨⟨x, hx⟩, rfl⟩
      · exact (ModuleCat.mono_iff_injective _).mpr Subtype.val_injective
      · exact (ModuleCat.epi_iff_surjective _).mpr hπ
    haveI hP : Projective S.X₂ :=
      (IsProjective.iff_projective (R := A) (P := Fin r → A)).mp inferInstance
    have h2 : HasProjectiveDimensionLT S.X₂ (n + 1) :=
      hasProjectiveDimensionLT_of_ge _ 1 (n + 1) (by omega)
    have h3 : HasProjectiveDimensionLT S.X₃ (n + 1 + 1) := hM
    exact hS.hasProjectiveDimensionLT_X₁ (n + 1) h2 h3
  have P : ∀ n : ℕ, ∀ (M : Type u) [AddCommGroup M] [Module A M] [Module.Finite A M],
      HasProjectiveDimensionLT (ModuleCat.of A M) n → Module.Free A M := by
    intro n
    induction n using Nat.strong_induction_on with
    | _ n ih =>
    intro M _ _ _ hM
    match n, ih, hM with
    | 0, _, hM =>
      have h0 := (hasProjectiveDimensionLT_zero_iff_isZero _).mp hM
      haveI := (ModuleCat.isZero_iff_subsingleton).mp h0
      exact Module.Free.of_subsingleton A M
    | 1, _, hM =>
      haveI : Projective (ModuleCat.of A M) :=
        projective_iff_hasProjectiveDimensionLT_one.mpr hM
      haveI : Module.Projective A M := (IsProjective.iff_projective (R := A) (P := M)).mpr this
      exact Module.free_of_flat_of_isLocalRing
    | m + 2, ih, hM =>
      obtain ⟨r, π, hπ, hker⟩ := MINP A M
      haveI : Module.Finite A (LinearMap.ker π) := Module.IsNoetherian.finite A _
      have hK := shift M r π hπ m hM
      have hfree := ih (m + 1) (by omega) (LinearMap.ker π) hK
      have hbot := socle r (LinearMap.ker π) (fun v hv => hker v hv) hfree
      have hinj : Function.Injective π := LinearMap.ker_eq_bot.mp hbot
      exact Module.Free.of_equiv (LinearEquiv.ofBijective π ⟨hinj, hπ⟩)
  intro M _ _ _ n hM
  exact P n M hM

theorem wc_rl_residue_retract : ∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A] (x : A), x ∈ IsLocalRing.maximalIdeal A → x ∉ IsLocalRing.maximalIdeal A ^ 2 → ∃ (_ : IsLocalRing (A ⧸ Ideal.span {x})), Nonempty (CategoryTheory.Retract (ModuleCat.of (A ⧸ Ideal.span {x}) (IsLocalRing.ResidueField (A ⧸ Ideal.span {x}))) (ModuleCat.of (A ⧸ Ideal.span {x}) (QuotSMulTop x (IsLocalRing.maximalIdeal A)))) :=
by
  intro A _ _ _ x hx hx2
  have hI : Ideal.span {x} ≠ ⊤ := by
    rw [Ne, Ideal.span_singleton_eq_top]
    exact (IsLocalRing.mem_maximalIdeal x).mp hx
  haveI : Nontrivial (A ⧸ Ideal.span {x}) := Ideal.Quotient.nontrivial_iff.mpr hI
  haveI hloc : IsLocalRing (A ⧸ Ideal.span {x}) :=
    IsLocalRing.of_surjective' (Ideal.Quotient.mk _) Ideal.Quotient.mk_surjective
  haveI hlh : IsLocalHom (Ideal.Quotient.mk (Ideal.span {x})) :=
    IsLocalHom.of_surjective _ Ideal.Quotient.mk_surjective
  refine ⟨hloc, ?_⟩

  obtain ⟨φ, hφ⟩ : ∃ φ : ↥(IsLocalRing.maximalIdeal A) →ₗ[A] IsLocalRing.ResidueField A,
      φ ⟨x, hx⟩ = 1 := by
    have hv : (IsLocalRing.maximalIdeal A).toCotangent ⟨x, hx⟩ ≠ 0 := by
      rw [Ne, Ideal.toCotangent_eq_zero]; exact hx2
    obtain ⟨ψ, hψ⟩ : ∃ ψ : Module.Dual (IsLocalRing.ResidueField A) (IsLocalRing.CotangentSpace A),
        ψ ((IsLocalRing.maximalIdeal A).toCotangent ⟨x, hx⟩) ≠ 0 := by
      by_contra h
      push_neg at h
      exact hv ((Module.forall_dual_apply_eq_zero_iff _ _).mp h)
    refine ⟨(((ψ ((IsLocalRing.maximalIdeal A).toCotangent ⟨x, hx⟩))⁻¹ • ψ).restrictScalars A) ∘ₗ
      (IsLocalRing.maximalIdeal A).toCotangent, ?_⟩
    simp only [LinearMap.coe_comp, Function.comp_apply, LinearMap.coe_restrictScalars,
      LinearMap.smul_apply, smul_eq_mul]
    exact inv_mul_cancel₀ hψ

  open Pointwise in
  have hker : x • (⊤ : Submodule A ↥(IsLocalRing.maximalIdeal A)) ≤ LinearMap.ker φ := by
    intro m hm
    obtain ⟨b, -, rfl⟩ := (Submodule.mem_smul_pointwise_iff_exists _ _ _).mp hm
    rw [LinearMap.mem_ker, map_smul, Algebra.smul_def, IsLocalRing.ResidueField.algebraMap_eq,
      (IsLocalRing.residue_eq_zero_iff x).mpr hx, zero_mul]
  open Pointwise in
  let rA : QuotSMulTop x ↥(IsLocalRing.maximalIdeal A) →ₗ[A] IsLocalRing.ResidueField A :=
    (x • (⊤ : Submodule A ↥(IsLocalRing.maximalIdeal A))).liftQ φ hker
  let e : IsLocalRing.ResidueField A →+* IsLocalRing.ResidueField (A ⧸ Ideal.span {x}) :=
    IsLocalRing.ResidueField.map (Ideal.Quotient.mk (Ideal.span {x}))
  have hsm : ∀ (a : A) (z : QuotSMulTop x ↥(IsLocalRing.maximalIdeal A)),
      (Ideal.Quotient.mk (Ideal.span {x}) a) • z = a • z := by
    intro a z
    rw [← Ideal.Quotient.algebraMap_eq, algebraMap_smul]

  let r : QuotSMulTop x ↥(IsLocalRing.maximalIdeal A) →ₗ[A ⧸ Ideal.span {x}]
      IsLocalRing.ResidueField (A ⧸ Ideal.span {x}) :=
    { toFun := fun z => e (rA z)
      map_add' := by intro z w; simp only [map_add]
      map_smul' := by
        intro c z
        obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective c
        rw [hsm, map_smul, Algebra.smul_def, Algebra.smul_def, map_mul, RingHom.id_apply,
          IsLocalRing.ResidueField.algebraMap_eq, IsLocalRing.ResidueField.algebraMap_eq]
        congr 1 }
  have hr : ∀ z, r z = e (rA z) := fun z => rfl
  let t : QuotSMulTop x ↥(IsLocalRing.maximalIdeal A) := Submodule.Quotient.mk ⟨x, hx⟩
  have hrt : r t = 1 := by
    rw [hr]
    change e (φ ⟨x, hx⟩) = 1
    rw [hφ, map_one]

  let i₀ : (A ⧸ Ideal.span {x}) →ₗ[A ⧸ Ideal.span {x}] QuotSMulTop x ↥(IsLocalRing.maximalIdeal A) :=
    LinearMap.toSpanSingleton _ _ t
  have hi₀ : IsLocalRing.maximalIdeal (A ⧸ Ideal.span {x}) ≤ LinearMap.ker i₀ := by
    intro c hc
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective c
    have ha : a ∈ IsLocalRing.maximalIdeal A := by
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      intro hu
      exact (IsLocalRing.mem_maximalIdeal _).mp hc (hu.map _)
    rw [LinearMap.mem_ker, LinearMap.toSpanSingleton_apply, hsm]
    change Submodule.Quotient.mk (a • (⟨x, hx⟩ : ↥(IsLocalRing.maximalIdeal A))) = 0
    rw [Submodule.Quotient.mk_eq_zero]
    have : a • (⟨x, hx⟩ : ↥(IsLocalRing.maximalIdeal A)) = x • ⟨a, ha⟩ := by
      apply Subtype.ext
      simp only [SetLike.val_smul, smul_eq_mul]
      ring
    rw [this]
    exact Submodule.smul_mem_pointwise_smul _ _ _ trivial
  let i' := (IsLocalRing.maximalIdeal (A ⧸ Ideal.span {x})).liftQ i₀ hi₀
  let i : IsLocalRing.ResidueField (A ⧸ Ideal.span {x}) →ₗ[A ⧸ Ideal.span {x}]
      QuotSMulTop x ↥(IsLocalRing.maximalIdeal A) :=
    { toFun := fun y => i' y
      map_add' := fun y w => i'.map_add y w
      map_smul' := fun c y => i'.map_smul c y }
  have hi : ∀ c, i (IsLocalRing.residue _ c) = c • t := fun c => rfl
  refine ⟨⟨ModuleCat.ofHom i, ModuleCat.ofHom r, ?_⟩⟩
  ext y
  obtain ⟨c, rfl⟩ := IsLocalRing.residue_surjective y
  change r (i (IsLocalRing.residue _ c)) = IsLocalRing.residue _ c
  rw [hi, map_smul, hrt, Algebra.smul_def, mul_one, IsLocalRing.ResidueField.algebraMap_eq]

theorem wc_rl_finite_pd_of_regular : (∀ (A : Type u) [CommRing A] [IsLocalRing A] (M : Type u) [AddCommGroup M] [Module A M] [Module.Finite A M], ∃ (r : ℕ) (π : (Fin r → A) →ₗ[A] M), Function.Surjective π ∧ ∀ v : Fin r → A, π v = 0 → ∀ i, v i ∈ IsLocalRing.maximalIdeal A) → (∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A] (x : A), x ∈ IsLocalRing.maximalIdeal A → x ∉ IsLocalRing.maximalIdeal A ^ 2 → ∃ (_ : IsLocalRing (A ⧸ Ideal.span {x})), Submodule.spanFinrank (IsLocalRing.maximalIdeal (A ⧸ Ideal.span {x})) + 1 = Submodule.spanFinrank (IsLocalRing.maximalIdeal A)) → (∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A], IsRegularLocalRing A → ∀ x : A, x ∈ IsLocalRing.maximalIdeal A → x ∉ IsLocalRing.maximalIdeal A ^ 2 → IsRegularLocalRing (A ⧸ Ideal.span {x}) ∧ ringKrullDim (A ⧸ Ideal.span {x}) + 1 = ringKrullDim A) → (∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A], IsRegularLocalRing A → IsDomain A) → (∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A] (x : A), x ∈ IsLocalRing.maximalIdeal A → IsSMulRegular A x → ∀ (N : Type u) [AddCommGroup N] [Module A N] [Module.Finite A N], IsSMulRegular N x → ∀ n : ℕ, CategoryTheory.HasProjectiveDimensionLT (ModuleCat.of (A ⧸ Ideal.span {x}) (QuotSMulTop x N)) n → CategoryTheory.HasProjectiveDimensionLT (ModuleCat.of A N) n) → ∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A], IsRegularLocalRing A → ∀ (M : Type u) [AddCommGroup M] [Module A M] [Module.Finite A M], ∃ n : ℕ, CategoryTheory.HasProjectiveDimensionLT (ModuleCat.of A M) n :=
by
  intro MINP EMB QR DOM DESC

  have shift : ∀ (A : Type u) [CommRing A] (M : Type u) [AddCommGroup M] [Module A M] (r : ℕ)
      (π : (Fin r → A) →ₗ[A] M), Function.Surjective π → ∀ n : ℕ,
      HasProjectiveDimensionLT (ModuleCat.of A (LinearMap.ker π)) n →
      HasProjectiveDimensionLT (ModuleCat.of A M) (n + 1) := by
    intro A _ M _ _ r π hπ n hK
    let S : ShortComplex (ModuleCat.{u} A) :=
      ShortComplex.mk (ModuleCat.ofHom (LinearMap.ker π).subtype) (ModuleCat.ofHom π)
        (by ext x; exact x.2)
    have hS : S.ShortExact := by
      refine ShortComplex.ShortExact.mk' ?_ ?_ ?_
      · rw [ShortComplex.moduleCat_exact_iff]
        intro x hx
        exact ⟨⟨x, hx⟩, rfl⟩
      · exact (ModuleCat.mono_iff_injective _).mpr Subtype.val_injective
      · exact (ModuleCat.epi_iff_surjective _).mpr hπ
    haveI hP : Projective S.X₂ :=
      (IsProjective.iff_projective (R := A) (P := Fin r → A)).mp inferInstance
    have h2 : HasProjectiveDimensionLT S.X₂ (n + 1) :=
      hasProjectiveDimensionLT_of_ge _ 1 (n + 1) (by omega)
    have h1 : HasProjectiveDimensionLT S.X₁ n := hK
    exact hS.hasProjectiveDimensionLT_X₃ n h1 h2

  have P : ∀ d : ℕ, ∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A],
      IsRegularLocalRing A → Submodule.spanFinrank (IsLocalRing.maximalIdeal A) = d →
      ∀ (M : Type u) [AddCommGroup M] [Module A M] [Module.Finite A M],
      ∃ n : ℕ, HasProjectiveDimensionLT (ModuleCat.of A M) n := by
    intro d
    induction d with
    | zero =>
      intro A _ _ _ hA hd M _ _ _
      have hFG : (IsLocalRing.maximalIdeal A).FG := IsNoetherian.noetherian _
      have hbot : IsLocalRing.maximalIdeal A = ⊥ :=
        (Submodule.spanFinrank_eq_zero_iff_eq_bot hFG).mp hd
      obtain ⟨r, π, hπ, hker⟩ := MINP A M
      have hinj : Function.Injective π := by
        rw [injective_iff_map_eq_zero]
        intro v hv
        funext i
        have := hker v hv i
        rw [hbot] at this
        exact (Submodule.mem_bot A).mp this
      haveI : Module.Projective A M :=
        Module.Projective.of_equiv (LinearEquiv.ofBijective π ⟨hinj, hπ⟩)
      haveI : Projective (ModuleCat.of A M) :=
        (IsProjective.iff_projective (R := A) (P := M)).mp inferInstance
      exact ⟨1, projective_iff_hasProjectiveDimensionLT_one.mp inferInstance⟩
    | succ d ih =>
      intro A _ _ _ hA hd M _ _ _
      have hFG : (IsLocalRing.maximalIdeal A).FG := IsNoetherian.noetherian _
      have hne : IsLocalRing.maximalIdeal A ≠ ⊥ := by
        intro h
        rw [h, Submodule.spanFinrank_bot] at hd
        omega
      have hnle : ¬ IsLocalRing.maximalIdeal A ≤ IsLocalRing.maximalIdeal A ^ 2 := by
        intro h
        apply hne
        refine Submodule.eq_bot_of_le_smul_of_le_jacobson_bot (IsLocalRing.maximalIdeal A) _ hFG
          ?_ (IsLocalRing.maximalIdeal_le_jacobson ⊥)
        rw [Ideal.smul_eq_mul, ← pow_two]
        exact h
      obtain ⟨x, hxm, hx2⟩ := SetLike.not_le_iff_exists.mp hnle
      have hx0 : x ≠ 0 := by
        rintro rfl
        exact hx2 (Submodule.zero_mem _)
      haveI : IsDomain A := DOM A hA
      obtain ⟨hloc, hemb⟩ := EMB A x hxm hx2
      haveI := hloc
      have hd' : Submodule.spanFinrank (IsLocalRing.maximalIdeal (A ⧸ Ideal.span {x})) = d := by
        omega
      have hA' : IsRegularLocalRing (A ⧸ Ideal.span {x}) := (QR A hA x hxm hx2).1
      have hxA : IsSMulRegular A x := IsSMulRegular.of_ne_zero hx0
      obtain ⟨r, π, hπ, -⟩ := MINP A M
      haveI : Module.Finite A (LinearMap.ker π) := Module.IsNoetherian.finite A _
      have hxK : IsSMulRegular (LinearMap.ker π) x :=
        IsSMulRegular.submodule (LinearMap.ker π) x (IsSMulRegular.pi (fun _ => hxA))
      haveI : Module.Finite (A ⧸ Ideal.span {x}) (QuotSMulTop x (LinearMap.ker π)) :=
        Module.Finite.of_restrictScalars_finite A _ _
      obtain ⟨n, hn⟩ := ih (A ⧸ Ideal.span {x}) hA' hd' (QuotSMulTop x (LinearMap.ker π))
      have hK := DESC A x hxm hxA (LinearMap.ker π) hxK n hn
      exact ⟨n + 1, shift A M r π hπ n hK⟩
  intro A _ _ _ hA M _ _ _
  exact P _ A hA rfl M

theorem wc_rl_regular_of_finite_pd_residue : (∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A] (x : A), x ∈ IsLocalRing.maximalIdeal A → x ∉ IsLocalRing.maximalIdeal A ^ 2 → ∃ (_ : IsLocalRing (A ⧸ Ideal.span {x})), Submodule.spanFinrank (IsLocalRing.maximalIdeal (A ⧸ Ideal.span {x})) + 1 = Submodule.spanFinrank (IsLocalRing.maximalIdeal A)) → (∀ (A : Type u) [CommRing A] (x : A), IsSMulRegular A x → ∀ (M : Type u) [AddCommGroup M] [Module A M], IsSMulRegular M x → ∀ n : ℕ, CategoryTheory.HasProjectiveDimensionLT (ModuleCat.of A M) n → CategoryTheory.HasProjectiveDimensionLT (ModuleCat.of (A ⧸ Ideal.span {x}) (QuotSMulTop x M)) n) → (∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A] (z : A), z ≠ 0 → (∀ y ∈ IsLocalRing.maximalIdeal A, z * y = 0) → ∀ (M : Type u) [AddCommGroup M] [Module A M] [Module.Finite A M] (n : ℕ), CategoryTheory.HasProjectiveDimensionLT (ModuleCat.of A M) n → Module.Free A M) → (∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A] (x : A), x ∈ IsLocalRing.maximalIdeal A → x ∉ IsLocalRing.maximalIdeal A ^ 2 → ∃ (_ : IsLocalRing (A ⧸ Ideal.span {x})), Nonempty (CategoryTheory.Retract (ModuleCat.of (A ⧸ Ideal.span {x}) (IsLocalRing.ResidueField (A ⧸ Ideal.span {x}))) (ModuleCat.of (A ⧸ Ideal.span {x}) (QuotSMulTop x (IsLocalRing.maximalIdeal A))))) → (∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A], IsLocalRing.maximalIdeal A ≠ ⊥ → (∃ z : A, z ≠ 0 ∧ ∀ y ∈ IsLocalRing.maximalIdeal A, z * y = 0) ∨ (∃ x ∈ IsLocalRing.maximalIdeal A, x ∉ IsLocalRing.maximalIdeal A ^ 2 ∧ IsSMulRegular A x)) → ∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A] (n : ℕ), CategoryTheory.HasProjectiveDimensionLT (ModuleCat.of A (IsLocalRing.ResidueField A)) n → IsRegularLocalRing A :=
by
  intro EMB ASC SOC RET DIC

  have s1 : ∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A],
      IsLocalRing.maximalIdeal A = ⊥ → IsRegularLocalRing A := by
    intro A _ _ _ h
    apply IsRegularLocalRing.mk
    rw [h, Submodule.spanFinrank_bot,
      ringKrullDim_eq_zero_of_isField (IsLocalRing.isField_iff_maximalIdeal_eq.mpr h)]
    simp

  have s2 : ∀ (A : Type u) [CommRing A] [IsLocalRing A],
      Module.Free A (IsLocalRing.ResidueField A) → IsLocalRing.maximalIdeal A = ⊥ := by
    intro A _ _ hf
    let b := Module.Free.chooseBasis A (IsLocalRing.ResidueField A)
    rcases isEmpty_or_nonempty (Module.Free.ChooseBasisIndex A (IsLocalRing.ResidueField A))
      with hι | ⟨⟨i⟩⟩
    · exfalso
      have h10 : (1 : IsLocalRing.ResidueField A) ≠ 0 := by
        intro h
        apply (IsLocalRing.maximalIdeal.isMaximal A).ne_top
        rw [Ideal.eq_top_iff_one, ← IsLocalRing.residue_eq_zero_iff, (IsLocalRing.residue A).map_one]
        exact h
      exact h10 (b.repr.toEquiv.subsingleton.elim 1 0)
    · rw [eq_bot_iff]
      intro a ha
      rw [Submodule.mem_bot]
      have h1 : a • b i = 0 := by
        rw [Algebra.smul_def, IsLocalRing.ResidueField.algebraMap_eq,
          (IsLocalRing.residue_eq_zero_iff a).mpr ha, zero_mul]
      have h2 := congrArg b.repr h1
      rw [map_smul, b.repr_self, map_zero, Finsupp.smul_single, smul_eq_mul, mul_one,
        Finsupp.single_eq_zero] at h2
      exact h2

  have s3 : ∀ (A : Type u) [CommRing A] [IsLocalRing A] (n : ℕ),
      CategoryTheory.HasProjectiveDimensionLT (ModuleCat.of A (IsLocalRing.ResidueField A)) n →
      CategoryTheory.HasProjectiveDimensionLT (ModuleCat.of A ↥(IsLocalRing.maximalIdeal A)) n := by
    intro A _ _ n hk
    cases n with
    | zero =>
      exfalso
      have h10 : (1 : IsLocalRing.ResidueField A) ≠ 0 := by
        intro h
        apply (IsLocalRing.maximalIdeal.isMaximal A).ne_top
        rw [Ideal.eq_top_iff_one, ← IsLocalRing.residue_eq_zero_iff, (IsLocalRing.residue A).map_one]
        exact h
      rw [hasProjectiveDimensionLT_zero_iff_isZero] at hk
      exact h10 ((ModuleCat.subsingleton_of_isZero hk).elim 1 0)
    | succ m =>
      let S : ShortComplex (ModuleCat.{u} A) :=
        ShortComplex.mk (ModuleCat.ofHom (IsLocalRing.maximalIdeal A).subtype)
          (ModuleCat.ofHom (Algebra.linearMap A (IsLocalRing.ResidueField A))) (by
            ext x
            simp [IsLocalRing.ResidueField.algebraMap_eq,
              (IsLocalRing.residue_eq_zero_iff _).mpr x.2])
      have hS : S.ShortExact := by
        apply ShortComplex.ShortExact.mk'
        · rw [ShortComplex.moduleCat_exact_iff]
          intro y hy
          have hy' : IsLocalRing.residue A y = 0 := by
            rw [← IsLocalRing.ResidueField.algebraMap_eq]; exact hy
          exact ⟨⟨y, (IsLocalRing.residue_eq_zero_iff y).mp hy'⟩, rfl⟩
        · rw [ModuleCat.mono_iff_injective]
          exact Submodule.injective_subtype _
        · rw [ModuleCat.epi_iff_surjective]
          intro y
          obtain ⟨a, rfl⟩ := IsLocalRing.residue_surjective y
          exact ⟨a, by simp [S, IsLocalRing.ResidueField.algebraMap_eq]⟩
      have h2 : HasProjectiveDimensionLT S.X₂ (m + 1) := by
        have : Projective S.X₂ := (inferInstance : Projective (ModuleCat.of A A))
        have : HasProjectiveDimensionLT S.X₂ 1 :=
          projective_iff_hasProjectiveDimensionLT_one.mp inferInstance
        exact hasProjectiveDimensionLT_of_ge _ 1 (m + 1) (by omega)
      have h3 : HasProjectiveDimensionLT S.X₃ (m + 1 + 1) :=
        hasProjectiveDimensionLT_of_ge _ (m + 1) (m + 1 + 1) (by omega)
      exact hS.hasProjectiveDimensionLT_X₁ (m + 1) h2 h3

  have s4 : ∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A] (x : A),
      IsSMulRegular A x → ∀ e : ℕ, ringKrullDim (A ⧸ Ideal.span {x}) = (e : WithBot ℕ∞) →
      Submodule.spanFinrank (IsLocalRing.maximalIdeal A) = e + 1 → IsRegularLocalRing A := by
    intro A _ _ _ x hx e hd hs
    have hx0 : x ∈ nonZeroDivisors A := by
      rw [mem_nonZeroDivisors_iff_right]
      intro y hy
      apply hx
      show x * y = x * 0
      rw [mul_zero, mul_comm, hy]
    have h1 := ringKrullDim_quotient_succ_le_of_nonZeroDivisor hx0
    have h2 := ringKrullDim_le_spanFinrank_maximalIdeal A
    rw [hd] at h1
    rw [hs] at h2
    apply IsRegularLocalRing.mk
    rw [hs]
    refine le_antisymm ?_ h2
    push_cast
    exact h1

  have P : ∀ e : ℕ, ∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A],
      Submodule.spanFinrank (IsLocalRing.maximalIdeal A) = e → ∀ n : ℕ,
      CategoryTheory.HasProjectiveDimensionLT (ModuleCat.of A (IsLocalRing.ResidueField A)) n →
      IsRegularLocalRing A := by
    intro e
    induction e with
    | zero =>
      intro A _ _ _ he n hk
      apply s1
      exact (Submodule.spanFinrank_eq_zero_iff_eq_bot (IsNoetherian.noetherian _)).mp he
    | succ e ih =>
      intro A _ _ _ he n hk
      have hne : IsLocalRing.maximalIdeal A ≠ ⊥ := by
        intro h
        rw [h, Submodule.spanFinrank_bot] at he
        omega
      rcases DIC A hne with ⟨z, hz0, hz⟩ | ⟨x, hx, hx2, hreg⟩
      · exact absurd (s2 A (SOC A z hz0 hz (IsLocalRing.ResidueField A) n hk)) hne
      · have hm := s3 A n hk
        have hq := ASC A x hreg (IsLocalRing.maximalIdeal A)
          (IsSMulRegular.submodule _ x hreg) n hm
        obtain ⟨hloc, hemb⟩ := EMB A x hx hx2
        obtain ⟨_, ⟨r⟩⟩ := RET A x hx hx2
        have hN : IsNoetherianRing (A ⧸ Ideal.span {x}) := Ideal.Quotient.isNoetherianRing _
        have hk' := r.hasProjectiveDimensionLT n
        have hspan := Nat.add_right_cancel (hemb.trans he)
        have hreg' := ih (A ⧸ Ideal.span {x}) hspan n hk'
        have hdim : ringKrullDim (A ⧸ Ideal.span {x}) = (e : WithBot ℕ∞) := by
          rw [← hspan]
          exact (@IsRegularLocalRing.spanFinrank_maximalIdeal _ _ hreg').symm
        exact s4 A x hreg e hdim he
  intro A _ _ _ n hk
  exact P _ A rfl n hk

theorem wc_rfd_pd_flat_descent : ∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A] (B : Type u) [CommRing B] [IsLocalRing B] [Algebra A B] [IsLocalHom (algebraMap A B)] [Module.Flat A B] (M : Type u) [AddCommGroup M] [Module A M] [Module.Finite A M] (n : ℕ), CategoryTheory.HasProjectiveDimensionLT (ModuleCat.of B (TensorProduct A B M)) n → CategoryTheory.HasProjectiveDimensionLT (ModuleCat.of A M) n :=
by
  intro A _ _ _ B _ _ _ _ _
  haveI hff : Module.FaithfullyFlat A B := Module.FaithfullyFlat.of_flat_of_isLocalHom
  have ses : ∀ (R : Type u) [CommRing R] (X Y Z : Type u) [AddCommGroup X] [Module R X]
      [AddCommGroup Y] [Module R Y] [AddCommGroup Z] [Module R Z] (f : X →ₗ[R] Y) (g : Y →ₗ[R] Z),
      Function.Injective f → Function.Exact f g → Function.Surjective g →
      ∃ w : ModuleCat.ofHom f ≫ ModuleCat.ofHom g = 0,
        (ShortComplex.mk (ModuleCat.ofHom f) (ModuleCat.ofHom g) w).ShortExact := by
    intro R _ X Y Z _ _ _ _ _ _ f g hf hfg hg
    have w : ModuleCat.ofHom f ≫ ModuleCat.ofHom g = 0 := by
      ext x
      simpa using hfg.apply_apply_eq_zero x
    refine ⟨w, ShortComplex.ShortExact.mk' ?_ ?_ ?_⟩
    · rw [ShortComplex.moduleCat_exact_iff]
      intro y hy
      exact (hfg y).mp hy
    · exact (ModuleCat.mono_iff_injective _).mpr hf
    · exact (ModuleCat.epi_iff_surjective _).mpr hg
  have P0 : ∀ (M : Type u) [AddCommGroup M] [Module A M] [Module.Finite A M],
      HasProjectiveDimensionLT (ModuleCat.of B (TensorProduct A B M)) 0 →
      HasProjectiveDimensionLT (ModuleCat.of A M) 0 := by
    intro M _ _ _ h
    rw [hasProjectiveDimensionLT_zero_iff_isZero, ModuleCat.isZero_iff_subsingleton] at h ⊢
    haveI := h
    exact Module.FaithfullyFlat.lTensor_reflects_triviality A B M
  have P1 : ∀ (M : Type u) [AddCommGroup M] [Module A M] [Module.Finite A M],
      HasProjectiveDimensionLT (ModuleCat.of B (TensorProduct A B M)) 1 →
      HasProjectiveDimensionLT (ModuleCat.of A M) 1 := by
    intro M _ _ _ h
    rw [← projective_iff_hasProjectiveDimensionLT_one, ← IsProjective.iff_projective] at h ⊢
    haveI := h
    haveI : Module.Flat B (TensorProduct A B M) := Module.Flat.of_projective
    haveI : Module.Flat A M := Module.Flat.of_flat_tensorProduct A M B
    haveI : Module.Free A M := Module.free_of_flat_of_isLocalRing
    exact Module.Projective.of_free
  have step : ∀ n : ℕ, (∀ (M : Type u) [AddCommGroup M] [Module A M] [Module.Finite A M],
      HasProjectiveDimensionLT (ModuleCat.of B (TensorProduct A B M)) (n + 1) →
      HasProjectiveDimensionLT (ModuleCat.of A M) (n + 1)) →
      (∀ (M : Type u) [AddCommGroup M] [Module A M] [Module.Finite A M],
      HasProjectiveDimensionLT (ModuleCat.of B (TensorProduct A B M)) (n + 2) →
      HasProjectiveDimensionLT (ModuleCat.of A M) (n + 2)) := by
    intro n ih M _ _ _ h
    obtain ⟨r, g, hg⟩ := Module.Finite.exists_fin' A M
    haveI : IsNoetherian A (Fin r → A) := isNoetherian_of_isNoetherianRing_of_finite A (Fin r → A)
    haveI : IsNoetherian A (LinearMap.ker g) := isNoetherian_submodule' _
    haveI : Module.Finite A (LinearMap.ker g) := Module.IsNoetherian.finite A _
    have hf : Function.Injective (LinearMap.ker g).subtype := Submodule.subtype_injective _
    have hfg := LinearMap.exact_subtype_ker_map g
    have hf' : Function.Injective (LinearMap.baseChange B (LinearMap.ker g).subtype) := by
      rw [LinearMap.baseChange_eq_ltensor]
      exact Module.Flat.lTensor_preserves_injective_linearMap _ hf
    have hfg' : Function.Exact (LinearMap.baseChange B (LinearMap.ker g).subtype)
        (LinearMap.baseChange B g) := by
      rw [LinearMap.baseChange_eq_ltensor, LinearMap.baseChange_eq_ltensor]
      exact Module.Flat.lTensor_exact B hfg
    have hg' : Function.Surjective (LinearMap.baseChange B g) := by
      rw [LinearMap.baseChange_eq_ltensor]
      exact LinearMap.lTensor_surjective B hg
    obtain ⟨w', hS'⟩ := ses B _ _ _ _ _ hf' hfg' hg'
    haveI h1B : HasProjectiveDimensionLT (ModuleCat.of B (TensorProduct A B (Fin r → A))) 1 := by
      rw [← projective_iff_hasProjectiveDimensionLT_one, ← IsProjective.iff_projective]
      exact Module.Projective.of_free
    have h2B : HasProjectiveDimensionLT (ModuleCat.of B (TensorProduct A B (Fin r → A))) (n + 1) :=
      hasProjectiveDimensionLT_of_ge _ 1 (n + 1) (by omega)
    have hK' : HasProjectiveDimensionLT
        (ModuleCat.of B (TensorProduct A B (LinearMap.ker g))) (n + 1) :=
      hS'.hasProjectiveDimensionLT_X₁ (n + 1) h2B h
    have hK : HasProjectiveDimensionLT (ModuleCat.of A (LinearMap.ker g)) (n + 1) := ih _ hK'
    obtain ⟨w, hS⟩ := ses A _ _ _ _ _ hf hfg hg
    haveI h1A : HasProjectiveDimensionLT (ModuleCat.of A (Fin r → A)) 1 := by
      rw [← projective_iff_hasProjectiveDimensionLT_one, ← IsProjective.iff_projective]
      exact Module.Projective.of_free
    have h2A : HasProjectiveDimensionLT (ModuleCat.of A (Fin r → A)) (n + 1 + 1) :=
      hasProjectiveDimensionLT_of_ge _ 1 (n + 1 + 1) (by omega)
    exact hS.hasProjectiveDimensionLT_X₃ (n + 1) hK h2A
  have all : ∀ n : ℕ, (∀ (M : Type u) [AddCommGroup M] [Module A M] [Module.Finite A M],
      HasProjectiveDimensionLT (ModuleCat.of B (TensorProduct A B M)) n →
      HasProjectiveDimensionLT (ModuleCat.of A M) n) ∧
      (∀ (M : Type u) [AddCommGroup M] [Module A M] [Module.Finite A M],
      HasProjectiveDimensionLT (ModuleCat.of B (TensorProduct A B M)) (n + 1) →
      HasProjectiveDimensionLT (ModuleCat.of A M) (n + 1)) := by
    intro n
    induction n with
    | zero => exact ⟨P0, P1⟩
    | succ k ih => exact ⟨ih.2, step k ih.2⟩
  intro M _ _ _ n h
  exact (all n).1 M h

theorem wc_hnas_pfc_regular_flat_descent : ∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A] (B : Type u) [CommRing B] [IsLocalRing B] [IsNoetherianRing B] [Algebra A B] [IsLocalHom (algebraMap A B)] [Module.Flat A B], IsRegularLocalRing B → IsRegularLocalRing A :=
by
  intro A _ _ _ B _ _ _ _ _ _ hB
  have EMB := wc_rl_quot_embdim
  have QR := wc_rl_quot_regular EMB
  have DOM := wc_rl_isDomain EMB QR
  have MINP := wc_rl_min_presentation
  have INJ := wc_rl_quotSMulTop_map_injective
  have QPROJ := wc_rl_quotSMulTop_projective
  have ASC := wc_rl_pd_quot_ascent INJ QPROJ
  have DESC := wc_rl_pd_quot_descent MINP INJ QPROJ
  have SOC := wc_rl_pd_free_of_socle MINP
  obtain ⟨n, hn⟩ := wc_rl_finite_pd_of_regular MINP EMB QR DOM DESC B hB
    (TensorProduct A B (IsLocalRing.ResidueField A))
  have hA := wc_rfd_pd_flat_descent A B (IsLocalRing.ResidueField A) n hn
  exact wc_rl_regular_of_finite_pd_residue EMB ASC SOC wc_rl_residue_retract
    wc_rl_socle_or_regular_elem A n hA

theorem wc_hnas_pfc_regular_localization : ∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A], IsRegularLocalRing A → ∀ (𝔭 : Ideal A) [𝔭.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔭) :=
by
  intro A _ _ _ hA 𝔭 _


  have key : ∀ (R : Type u) [CommRing R] (X Y Z : Type u) [AddCommGroup X] [Module R X]
      [AddCommGroup Y] [Module R Y] [AddCommGroup Z] [Module R Z] (f : X →ₗ[R] Y) (g : Y →ₗ[R] Z),
      Function.Injective f → Function.Exact f g → Function.Surjective g → Module.Projective R Y →
      ∀ n : ℕ, (HasProjectiveDimensionLT (ModuleCat.of R Z) (n + 2) ↔
        HasProjectiveDimensionLT (ModuleCat.of R X) (n + 1)) := by
    intro R _ X Y Z _ _ _ _ _ _ f g hf hex hg hY n
    let S : ShortComplex (ModuleCat.{u} R) := ShortComplex.mk (ModuleCat.ofHom f) (ModuleCat.ofHom g)
      (by ext x; exact hex.apply_apply_eq_zero x)
    have hS : S.ShortExact := by
      refine ShortComplex.ShortExact.mk' ?_ ?_ ?_
      · exact (ShortComplex.ShortExact.moduleCat_exact_iff_function_exact S).mpr hex
      · exact (ModuleCat.mono_iff_injective _).mpr hf
      · exact (ModuleCat.epi_iff_surjective _).mpr hg
    have hP : Projective S.X₂ := (IsProjective.iff_projective Y).mp hY
    exact hS.hasProjectiveDimensionLT_X₃_iff n hP

  have LOCPD : ∀ (n : ℕ) (M : Type u) [AddCommGroup M] [Module A M],
      HasProjectiveDimensionLT (ModuleCat.of A M) n →
      HasProjectiveDimensionLT (ModuleCat.of (Localization.AtPrime 𝔭)
        (LocalizedModule 𝔭.primeCompl M)) n := by
    intro n
    induction n using Nat.strong_induction_on with
    | _ n ih =>
      intro M _ _ hM
      rcases n with _ | _ | k
      · rw [hasProjectiveDimensionLT_zero_iff_isZero] at hM ⊢
        haveI := ModuleCat.subsingleton_of_isZero hM
        have h0 : ∀ x : LocalizedModule 𝔭.primeCompl M, x = 0 := fun x =>
          LocalizedModule.induction_on
            (fun m s => by rw [Subsingleton.elim m 0, LocalizedModule.zero_mk]) x
        haveI : Subsingleton (LocalizedModule 𝔭.primeCompl M) := ⟨fun a b => by rw [h0 a, h0 b]⟩
        exact ModuleCat.isZero_of_subsingleton _
      · rw [← projective_iff_hasProjectiveDimensionLT_one, ← IsProjective.iff_projective] at hM ⊢
        haveI := hM
        infer_instance
      · let π : (M →₀ A) →ₗ[A] M := Finsupp.linearCombination A id
        have hπ : Function.Surjective π :=
          Finsupp.linearCombination_surjective A Function.surjective_id
        have gen : ∀ (K F : Type u) [AddCommGroup K] [Module A K] [AddCommGroup F] [Module A F]
            [Module.Projective A F] (f : K →ₗ[A] F) (g : F →ₗ[A] M), Function.Injective f →
            Function.Exact f g → Function.Surjective g →
            HasProjectiveDimensionLT (ModuleCat.of (Localization.AtPrime 𝔭)
              (LocalizedModule 𝔭.primeCompl M)) (k + 2) := by
          intro K F _ _ _ _ _ f g hf hfg hg
          have hK := (key A K F M f g hf hfg hg inferInstance k).mp hM
          have hK' := ih (k + 1) (by omega) K hK
          have hi : Function.Injective (LocalizedModule.map 𝔭.primeCompl f) :=
            IsLocalizedModule.map_injective 𝔭.primeCompl
              (LocalizedModule.mkLinearMap 𝔭.primeCompl K)
              (LocalizedModule.mkLinearMap 𝔭.primeCompl F) f hf
          have he : Function.Exact (LocalizedModule.map 𝔭.primeCompl f)
              (LocalizedModule.map 𝔭.primeCompl g) :=
            IsLocalizedModule.map_exact 𝔭.primeCompl
              (LocalizedModule.mkLinearMap 𝔭.primeCompl K)
              (LocalizedModule.mkLinearMap 𝔭.primeCompl F)
              (LocalizedModule.mkLinearMap 𝔭.primeCompl M) f g hfg
          have hs : Function.Surjective (LocalizedModule.map 𝔭.primeCompl g) :=
            IsLocalizedModule.map_surjective 𝔭.primeCompl
              (LocalizedModule.mkLinearMap 𝔭.primeCompl F)
              (LocalizedModule.mkLinearMap 𝔭.primeCompl M) g hg
          exact (key (Localization.AtPrime 𝔭) (LocalizedModule 𝔭.primeCompl K)
            (LocalizedModule 𝔭.primeCompl F) (LocalizedModule 𝔭.primeCompl M)
            (LocalizedModule.map 𝔭.primeCompl f)
            (LocalizedModule.map 𝔭.primeCompl g) hi he hs inferInstance k).mpr hK'
        exact gen (LinearMap.ker π) (M →₀ A) (LinearMap.ker π).subtype π
          (Submodule.injective_subtype _) (LinearMap.exact_subtype_ker_map π) hπ

  have RESID : Nonempty (LocalizedModule 𝔭.primeCompl (A ⧸ 𝔭) ≃ₗ[Localization.AtPrime 𝔭]
      IsLocalRing.ResidueField (Localization.AtPrime 𝔭)) := by
    have hres : ∀ a : A, algebraMap A (IsLocalRing.ResidueField (Localization.AtPrime 𝔭)) a = 0 ↔
        a ∈ 𝔭 := by
      intro a
      rw [IsScalarTower.algebraMap_apply A (Localization.AtPrime 𝔭)
          (IsLocalRing.ResidueField (Localization.AtPrime 𝔭)),
        IsLocalRing.ResidueField.algebraMap_eq, IsLocalRing.residue_eq_zero_iff]
      exact IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime 𝔭) 𝔭 a
    let φ : A →ₗ[A] IsLocalRing.ResidueField (Localization.AtPrime 𝔭) := Algebra.linearMap A _
    have hle : 𝔭 ≤ LinearMap.ker φ := fun a ha => by
      rw [LinearMap.mem_ker]; exact (hres a).mpr ha
    let ρ : (A ⧸ 𝔭) →ₗ[A] IsLocalRing.ResidueField (Localization.AtPrime 𝔭) :=
      Submodule.liftQ 𝔭 φ hle
    have hρinj : Function.Injective ρ := by
      rw [← LinearMap.ker_eq_bot]
      apply Submodule.ker_liftQ_eq_bot
      intro a ha
      rw [LinearMap.mem_ker] at ha
      exact (hres a).mp ha
    have hloc : IsLocalizedModule 𝔭.primeCompl ρ := by
      refine IsLocalizedModule.mk ?_ ?_ ?_
      · intro s
        rw [Module.End.isUnit_iff]
        have hs : algebraMap A (IsLocalRing.ResidueField (Localization.AtPrime 𝔭)) s ≠ 0 :=
          fun h => s.2 ((hres s).mp h)
        constructor
        · intro y z hyz
          simp only [Module.algebraMap_end_apply, Algebra.smul_def] at hyz
          exact mul_left_cancel₀ hs hyz
        · intro y
          refine ⟨(algebraMap A _ s)⁻¹ * y, ?_⟩
          simp only [Module.algebraMap_end_apply, Algebra.smul_def]
          rw [← mul_assoc, mul_inv_cancel₀ hs, one_mul]
      · intro y
        obtain ⟨z, rfl⟩ := IsLocalRing.residue_surjective y
        obtain ⟨⟨a, s⟩, rfl⟩ := IsLocalization.mk'_surjective 𝔭.primeCompl z
        refine ⟨⟨Submodule.Quotient.mk a, s⟩, ?_⟩
        dsimp only
        rw [Submonoid.smul_def, Algebra.smul_def]
        change _ = algebraMap A (IsLocalRing.ResidueField (Localization.AtPrime 𝔭)) a
        rw [IsScalarTower.algebraMap_apply A (Localization.AtPrime 𝔭)
            (IsLocalRing.ResidueField (Localization.AtPrime 𝔭)) (s : A),
          IsScalarTower.algebraMap_apply A (Localization.AtPrime 𝔭)
            (IsLocalRing.ResidueField (Localization.AtPrime 𝔭)) a,
          IsLocalRing.ResidueField.algebraMap_eq, ← map_mul, IsLocalization.mk'_spec']
      · intro x₁ x₂ h
        exact ⟨1, by rw [one_smul, one_smul]; exact hρinj h⟩
    haveI := hloc
    exact ⟨LinearEquiv.extendScalarsOfIsLocalization 𝔭.primeCompl (Localization.AtPrime 𝔭)
      (IsLocalizedModule.iso 𝔭.primeCompl ρ)⟩

  have EMB := wc_rl_quot_embdim
  have QR := wc_rl_quot_regular EMB
  have DOM := wc_rl_isDomain EMB QR
  have MINP := wc_rl_min_presentation
  have INJ := wc_rl_quotSMulTop_map_injective
  have QPROJ := wc_rl_quotSMulTop_projective
  have ASC := wc_rl_pd_quot_ascent INJ QPROJ
  have DESC := wc_rl_pd_quot_descent MINP INJ QPROJ
  have SOC := wc_rl_pd_free_of_socle MINP
  obtain ⟨n, hn⟩ := wc_rl_finite_pd_of_regular MINP EMB QR DOM DESC A hA (A ⧸ 𝔭)
  have h1 := LOCPD n (A ⧸ 𝔭) hn
  obtain ⟨e⟩ := RESID
  haveI := h1
  have h2 := hasProjectiveDimensionLT_of_iso (LinearEquiv.toModuleIso e) n
  haveI : IsNoetherianRing (Localization.AtPrime 𝔭) :=
    IsLocalization.isNoetherianRing 𝔭.primeCompl _ inferInstance
  exact wc_rl_regular_of_finite_pd_residue EMB ASC SOC wc_rl_residue_retract
    wc_rl_socle_or_regular_elem (Localization.AtPrime 𝔭) n h2

theorem wc_hnas_pfc_gcl_reduce_domain : (∀ (B : Type u) [CommRing B] [IsLocalRing B] [IsNoetherianRing B] (S : Type u) [CommRing S] [IsLocalRing S] [Algebra B S], Function.Surjective (algebraMap B S) → Nonempty (TensorProduct B S (AdicCompletion (IsLocalRing.maximalIdeal B) B) ≃ₐ[S] AdicCompletion (IsLocalRing.maximalIdeal S) S)) → (∀ (D : Type u) [CommRing D] [IsLocalRing D] [IsNoetherianRing D] [IsDomain D], IsAdicComplete (IsLocalRing.maximalIdeal D) D → (∀ (𝔪 : Ideal (D)) [𝔪.IsPrime], ∀ (Λ : Type u) [CommRing Λ] [Algebra (Localization.AtPrime 𝔪) Λ], Nonempty (AdicCompletion (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔪)) (Localization.AtPrime 𝔪) ≃ₐ[Localization.AtPrime 𝔪] Λ) → ∀ (𝔭 : Ideal (Localization.AtPrime 𝔪)) [𝔭.IsPrime], 𝔭 = ⊥ → ∀ (L : Type u) [Field L] [Algebra (Localization.AtPrime 𝔪) L] [Algebra 𝔭.ResidueField L] [IsScalarTower (Localization.AtPrime 𝔪) 𝔭.ResidueField L] [FiniteDimensional 𝔭.ResidueField L] (𝔔 : Ideal (TensorProduct (Localization.AtPrime 𝔪) L Λ)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔))) → ∀ (C : Type u) [CommRing C] [IsLocalRing C] [IsNoetherianRing C], IsAdicComplete (IsLocalRing.maximalIdeal C) C → (IsNoetherianRing C ∧ ∀ (𝔪 : Ideal C) [𝔪.IsPrime], ∀ (Λ : Type u) [CommRing Λ] [Algebra (Localization.AtPrime 𝔪) Λ], Nonempty (AdicCompletion (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔪)) (Localization.AtPrime 𝔪) ≃ₐ[Localization.AtPrime 𝔪] Λ) → ∀ (𝔭 : Ideal (Localization.AtPrime 𝔪)) [𝔭.IsPrime] (L : Type u) [Field L] [Algebra (Localization.AtPrime 𝔪) L] [Algebra 𝔭.ResidueField L] [IsScalarTower (Localization.AtPrime 𝔪) 𝔭.ResidueField L] [FiniteDimensional 𝔭.ResidueField L] (𝔔 : Ideal (TensorProduct (Localization.AtPrime 𝔪) L Λ)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) :=
by
  intro SURJ DOM C _ _ _ hC

  have QC : ∀ (C : Type u) [CommRing C] [IsLocalRing C] [IsNoetherianRing C]
      [IsAdicComplete (IsLocalRing.maximalIdeal C) C] (J : Ideal C), J ≠ ⊤ →
      ∃ (_ : IsLocalRing (C ⧸ J)), IsAdicComplete (IsLocalRing.maximalIdeal (C ⧸ J)) (C ⧸ J) := by
    intro C _ _ _ _ J hJ
    haveI hnt : Nontrivial (C ⧸ J) := Ideal.Quotient.nontrivial_iff.mpr hJ
    haveI hloc : IsLocalRing (C ⧸ J) :=
      IsLocalRing.of_surjective' (Ideal.Quotient.mk J) Ideal.Quotient.mk_surjective
    refine ⟨hloc, ?_⟩
    haveI : IsNoetherianRing (C ⧸ J) := Ideal.Quotient.isNoetherianRing J
    have hH : IsHausdorff (IsLocalRing.maximalIdeal (C ⧸ J)) (C ⧸ J) :=
      IsHausdorff.of_isLocalRing (IsLocalRing.maximalIdeal (C ⧸ J)) (C ⧸ J)
        (IsLocalRing.maximalIdeal.isMaximal _).ne_top
    have hmap : (IsLocalRing.maximalIdeal C).map (Ideal.Quotient.mk J) =
        IsLocalRing.maximalIdeal (C ⧸ J) :=
      IsLocalRing.map_maximalIdeal_of_surjective _ Ideal.Quotient.mk_surjective
    have key : ∀ (I : Ideal C) (n : ℕ) (x : C ⧸ J),
        x ∈ (I.map (Ideal.Quotient.mk J)) ^ n • (⊤ : Submodule (C ⧸ J) (C ⧸ J)) ↔
          x ∈ (I ^ n).map (Ideal.Quotient.mk J) := by
      intro I n x
      rw [Ideal.smul_eq_mul, Ideal.mul_top, Ideal.map_pow]
    have keyC : ∀ (I : Ideal C) (n : ℕ) (x : C),
        x ∈ I ^ n • (⊤ : Submodule C C) ↔ x ∈ I ^ n := by
      intro I n x
      rw [Ideal.smul_eq_mul, Ideal.mul_top]
    have hP : IsPrecomplete (IsLocalRing.maximalIdeal (C ⧸ J)) (C ⧸ J) := by
      rw [← hmap]
      constructor
      intro g hg
      have hd : ∀ i, g (i + 1) - g i ∈
          (IsLocalRing.maximalIdeal C ^ i).map (Ideal.Quotient.mk J) := by
        intro i
        have h1 := hg (Nat.le_succ i)
        rw [SModEq.sub_mem, key] at h1
        rw [← neg_sub]
        exact neg_mem h1
      choose e he hfe using fun i =>
        (Ideal.mem_map_iff_of_surjective _ Ideal.Quotient.mk_surjective).mp (hd i)
      obtain ⟨c₀, hc₀⟩ := Ideal.Quotient.mk_surjective (g 0)
      let h : ℕ → C := fun n => c₀ + ∑ i ∈ Finset.range n, e i
      have hfh : ∀ n, Ideal.Quotient.mk J (h n) = g n := by
        intro n
        simp only [h, map_add, map_sum, hfe, hc₀]
        rw [Finset.sum_range_sub (fun i => g i) n]
        abel
      have hcau : ∀ a n, a ≤ n → h n - h a ∈ IsLocalRing.maximalIdeal C ^ a := by
        intro a n han
        induction n, han using Nat.le_induction with
        | base => simp
        | succ k hak ih =>
          have h2 : h (k + 1) - h a = (h k - h a) + e k := by
            simp only [h, Finset.sum_range_succ]; ring
          rw [h2]
          exact add_mem ih (Ideal.pow_le_pow_right hak (he k))
      obtain ⟨L, hL⟩ := IsPrecomplete.prec
        (inferInstance : IsPrecomplete (IsLocalRing.maximalIdeal C) C) (f := h) (by
          intro a n han
          rw [SModEq.sub_mem, keyC, ← neg_sub]
          exact neg_mem (hcau a n han))
      refine ⟨Ideal.Quotient.mk J L, fun n => ?_⟩
      have h3 := hL n
      rw [SModEq.sub_mem, keyC] at h3
      rw [SModEq.sub_mem, key, ← hfh n, ← map_sub]
      exact Ideal.mem_map_of_mem _ h3
    exact { toIsHausdorff := hH, toIsPrecomplete := hP }

  have hsurj : ∀ (A : Type u) [CommRing A] (B : Type u) [CommRing B] (f : A →+* B),
      Function.Surjective f → ∀ (J : Ideal B) [J.IsPrime] (I : Ideal A) [I.IsPrime]
      (h : I = Ideal.comap f J), Function.Surjective (Localization.localRingHom I J f h) := by
    intro A _ B _ f hf J _ I _ h
    subst h
    intro z
    obtain ⟨⟨y, t⟩, hz⟩ := IsLocalization.mk'_surjective J.primeCompl z
    change IsLocalization.mk' _ y t = z at hz
    subst hz
    obtain ⟨x, rfl⟩ := hf y
    obtain ⟨s, hs⟩ := hf t
    have hs' : s ∈ (Ideal.comap f J).primeCompl := by
      show s ∉ Ideal.comap f J
      rw [Ideal.mem_comap, hs]; exact t.2
    refine ⟨IsLocalization.mk' (Localization.AtPrime (Ideal.comap f J)) x ⟨s, hs'⟩, ?_⟩
    rw [Localization.localRingHom_mk']
    congr 1
    exact Subtype.ext hs

  have htrans : ∀ (T' : Type u) [CommRing T'] (T : Type u) [CommRing T] (Ψ : T' ≃+* T)
      (𝔔 : Ideal T) [𝔔.IsPrime],
      IsRegularLocalRing (Localization.AtPrime (Ideal.comap (Ψ : T' →+* T) 𝔔)) →
      IsRegularLocalRing (Localization.AtPrime 𝔔) := by
    intro T' _ T _ Ψ 𝔔 _ h
    have H : Submonoid.map Ψ.toMonoidHom (Ideal.comap (Ψ : T' →+* T) 𝔔).primeCompl
        = 𝔔.primeCompl := by
      ext x
      simp only [Submonoid.mem_map]
      constructor
      · rintro ⟨y, hy, rfl⟩
        exact hy
      · intro hx
        refine ⟨Ψ.symm x, ?_, by simp⟩
        show Ψ.symm x ∉ Ideal.comap (Ψ : T' →+* T) 𝔔
        rw [Ideal.mem_comap]
        simpa using hx
    haveI := h
    exact IsRegularLocalRing.of_ringEquiv (IsLocalization.ringEquivOfRingEquiv
      (Localization.AtPrime (Ideal.comap (Ψ : T' →+* T) 𝔔)) (Localization.AtPrime 𝔔) Ψ H)

  have hs3 : ∀ (B' : Type u) [CommRing B'] (S' : Type u) [CommRing S'] [Algebra B' S']
      (L : Type u) [CommRing L] [Algebra S' L] [Algebra B' L] [IsScalarTower B' S' L]
      (M : Type u) [CommRing M] [Algebra B' M] (Λ : Type u) [CommRing Λ] [Algebra S' Λ]
      (σ : TensorProduct B' S' M ≃ₐ[S'] Λ),
      Nonempty (TensorProduct B' L M ≃+* TensorProduct S' L Λ) :=
    fun B' _ S' _ _ L _ _ _ _ M _ _ Λ _ _ σ =>
      ⟨((Algebra.TensorProduct.cancelBaseChange B' S' S' L M).symm.trans
        (Algebra.TensorProduct.congr (AlgEquiv.refl : L ≃ₐ[S'] L) σ)).toRingEquiv⟩
  refine ⟨inferInstance, ?_⟩
  intro 𝔪 _ Λ _ _ hΛ 𝔭 _ L _ _ _ _ _ 𝔔 _

  obtain ⟨q, hq⟩ : ∃ q : Ideal C, q = Ideal.comap (algebraMap C (Localization.AtPrime 𝔪)) 𝔭 :=
    ⟨_, rfl⟩
  haveI hqp : q.IsPrime := by rw [hq]; exact Ideal.comap_isPrime _ _
  have hqm : q ≤ 𝔪 := by
    intro x hx
    rw [hq, Ideal.mem_comap] at hx
    have h1 : algebraMap C (Localization.AtPrime 𝔪) x ∈ IsLocalRing.maximalIdeal _ :=
      IsLocalRing.le_maximalIdeal (Ideal.IsPrime.ne_top ‹𝔭.IsPrime›) hx
    exact (IsLocalization.AtPrime.to_map_mem_maximal_iff _ 𝔪 x).mp h1

  haveI : IsAdicComplete (IsLocalRing.maximalIdeal C) C := hC
  obtain ⟨hloc, hcomp⟩ := QC C q (Ideal.IsPrime.ne_top hqp)
  haveI := hloc
  obtain ⟨f, hf, hker⟩ : ∃ f : C →+* C ⧸ q, Function.Surjective f ∧ RingHom.ker f = q :=
    ⟨Ideal.Quotient.mk q, Ideal.Quotient.mk_surjective, Ideal.mk_ker⟩

  obtain ⟨𝔫, h𝔫⟩ : ∃ 𝔫 : Ideal (C ⧸ q), 𝔫 = Ideal.map f 𝔪 := ⟨_, rfl⟩
  haveI h𝔫p : 𝔫.IsPrime := by
    rw [h𝔫]; exact Ideal.map_isPrime_of_surjective hf (by rw [hker]; exact hqm)
  have h𝔪 : 𝔪 = Ideal.comap f 𝔫 := by
    rw [h𝔫, Ideal.comap_map_of_surjective' f hf, hker, sup_eq_left.mpr hqm]

  have hφs : Function.Surjective (Localization.localRingHom 𝔪 𝔫 f h𝔪) :=
    hsurj C (C ⧸ q) f hf 𝔫 𝔪 h𝔪
  have hpb : 𝔭 = Ideal.comap (Localization.localRingHom 𝔪 𝔫 f h𝔪) ⊥ := by
    ext z
    obtain ⟨⟨x, s⟩, hz⟩ := IsLocalization.mk'_surjective 𝔪.primeCompl z
    change IsLocalization.mk' _ x s = z at hz
    subst hz
    rw [Ideal.mem_comap, Ideal.mem_bot, Localization.localRingHom_mk',
      IsLocalization.mk'_eq_zero_iff, IsLocalization.mk'_mem_iff]
    have e : algebraMap C (Localization.AtPrime 𝔪) x ∈ 𝔭 ↔ f x = 0 := by
      rw [← Ideal.mem_comap, ← hq, ← RingHom.mem_ker, hker]
    rw [e]
    constructor
    · intro hx
      exact ⟨1, by rw [hx, mul_zero]⟩
    · rintro ⟨m, hm⟩
      have hm0 : (m : C ⧸ q) ≠ 0 := fun h0 => m.2 (h0 ▸ 𝔫.zero_mem)
      exact (mul_eq_zero.mp hm).resolve_left hm0
  haveI hbot : (⊥ : Ideal (Localization.AtPrime 𝔫)).IsPrime := Ideal.isPrime_bot

  have hρs : Function.Surjective
      (Ideal.ResidueField.map 𝔭 ⊥ (Localization.localRingHom 𝔪 𝔫 f h𝔪) hpb) := by
    intro w
    obtain ⟨z, rfl⟩ := IsLocalRing.residue_surjective w
    obtain ⟨z', rfl⟩ := hsurj _ _ (Localization.localRingHom 𝔪 𝔫 f h𝔪) hφs ⊥ 𝔭 hpb z
    exact ⟨IsLocalRing.residue _ z', IsLocalRing.ResidueField.map_residue _ z'⟩
  let ρ' : 𝔭.ResidueField ≃+* (⊥ : Ideal (Localization.AtPrime 𝔫)).ResidueField :=
    RingEquiv.ofBijective (Ideal.ResidueField.map 𝔭 ⊥ (Localization.localRingHom 𝔪 𝔫 f h𝔪) hpb)
      ⟨RingHom.injective _, hρs⟩
  letI iK : Algebra (⊥ : Ideal (Localization.AtPrime 𝔫)).ResidueField L :=
    ((algebraMap 𝔭.ResidueField L).comp ρ'.symm.toRingHom).toAlgebra
  letI iS : Algebra (Localization.AtPrime 𝔫) L :=
    ((algebraMap (⊥ : Ideal (Localization.AtPrime 𝔫)).ResidueField L).comp
      (algebraMap (Localization.AtPrime 𝔫) _)).toAlgebra
  haveI iT : IsScalarTower (Localization.AtPrime 𝔫)
      (⊥ : Ideal (Localization.AtPrime 𝔫)).ResidueField L :=
    IsScalarTower.of_algebraMap_eq' rfl
  haveI iF : FiniteDimensional (⊥ : Ideal (Localization.AtPrime 𝔫)).ResidueField L := by
    letI : Algebra (⊥ : Ideal (Localization.AtPrime 𝔫)).ResidueField 𝔭.ResidueField :=
      ρ'.symm.toRingHom.toAlgebra
    haveI : Module.Finite (⊥ : Ideal (Localization.AtPrime 𝔫)).ResidueField 𝔭.ResidueField :=
      RingHom.Finite.of_surjective ρ'.symm.toRingHom ρ'.symm.surjective
    haveI : IsScalarTower (⊥ : Ideal (Localization.AtPrime 𝔫)).ResidueField
        𝔭.ResidueField L := IsScalarTower.of_algebraMap_eq' rfl
    exact Module.Finite.trans 𝔭.ResidueField L
  have heq : algebraMap (Localization.AtPrime 𝔪) L =
      (algebraMap (Localization.AtPrime 𝔫) L).comp (Localization.localRingHom 𝔪 𝔫 f h𝔪) := by
    refine RingHom.ext fun x => ?_
    have e1 : algebraMap (Localization.AtPrime 𝔫) (⊥ : Ideal (Localization.AtPrime 𝔫)).ResidueField
        (Localization.localRingHom 𝔪 𝔫 f h𝔪 x) = ρ' (algebraMap _ 𝔭.ResidueField x) :=
      (Ideal.ResidueField.map_algebraMap _ _ _ _ x).symm
    change algebraMap (Localization.AtPrime 𝔪) L x = algebraMap 𝔭.ResidueField L
      (ρ'.symm (algebraMap (Localization.AtPrime 𝔫) (⊥ : Ideal (Localization.AtPrime 𝔫)).ResidueField
        (Localization.localRingHom 𝔪 𝔫 f h𝔪 x)))
    rw [e1, RingEquiv.symm_apply_apply, ← IsScalarTower.algebraMap_apply]

  letI : Algebra (Localization.AtPrime 𝔪) (Localization.AtPrime 𝔫) :=
    (Localization.localRingHom 𝔪 𝔫 f h𝔪).toAlgebra
  haveI : IsScalarTower (Localization.AtPrime 𝔪) (Localization.AtPrime 𝔫) L :=
    IsScalarTower.of_algebraMap_eq' heq
  obtain ⟨σ⟩ := SURJ (Localization.AtPrime 𝔪) (Localization.AtPrime 𝔫) hφs
  obtain ⟨e⟩ := hΛ
  obtain ⟨Ψ⟩ := hs3 (Localization.AtPrime 𝔪) (Localization.AtPrime 𝔫) L Λ _
    ((Algebra.TensorProduct.congr AlgEquiv.refl e.symm).trans σ)
  have hreg := DOM (C ⧸ q) hcomp 𝔫
    (AdicCompletion (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔫)) (Localization.AtPrime 𝔫))
    ⟨AlgEquiv.refl⟩ ⊥ rfl L (Ideal.comap (Ψ.symm : _ →+* _) 𝔔)
  exact htrans _ _ Ψ.symm 𝔔 hreg

theorem wc_hnas_pfc_gcl_cf_coeff_field_char_zero : ∀ (D : Type u) [CommRing D] [IsLocalRing D] [IsNoetherianRing D], IsAdicComplete (IsLocalRing.maximalIdeal D) D → (∀ m : ℕ, m ≠ 0 → (m : IsLocalRing.ResidueField D) ≠ 0) → ∃ (k : Type u) (_ : Field k) (_ : Algebra k D), Function.Surjective ((IsLocalRing.residue D).comp (algebraMap k D)) :=
by
  intro D _ _ _ hD H
  classical
  haveI : CharZero (IsLocalRing.ResidueField D) := charZero_of_inj_zero (fun n hn => by
    by_contra h
    exact H n h hn)
  haveI : IsAdicComplete (IsLocalRing.maximalIdeal D) D := hD

  have hensel : ∀ (K : Type u) [Field K] (ι : K →+* D) (f : Polynomial K)
      (t : IsLocalRing.ResidueField D), f.Monic →
      Polynomial.eval₂ ((IsLocalRing.residue D).comp ι) t f = 0 →
      Polynomial.eval₂ ((IsLocalRing.residue D).comp ι) t (Polynomial.derivative f) ≠ 0 →
      ∃ x : D, IsLocalRing.residue D x = t ∧ Polynomial.eval₂ ι x f = 0 := by
    intro K _ ι f t hf h0 h1
    obtain ⟨a₀, rfl⟩ := IsLocalRing.residue_surjective t
    have key : ∀ g : Polynomial K, IsLocalRing.residue D (Polynomial.eval₂ ι a₀ g) =
        Polynomial.eval₂ ((IsLocalRing.residue D).comp ι) (IsLocalRing.residue D a₀) g :=
      fun g => Polynomial.hom_eval₂ g ι (IsLocalRing.residue D) a₀
    obtain ⟨a, ha, haa⟩ := HenselianRing.is_henselian (I := IsLocalRing.maximalIdeal D)
      (f.map ι) (hf.map ι) a₀ (by
        rw [Polynomial.eval_map, ← IsLocalRing.residue_eq_zero_iff, key, h0]) (by
        rw [Polynomial.derivative_map, Polynomial.eval_map]
        change IsUnit (IsLocalRing.residue D _)
        rw [key]
        exact isUnit_iff_ne_zero.mpr h1)
    refine ⟨a, ?_, ?_⟩
    · rw [← sub_eq_zero, ← map_sub, IsLocalRing.residue_eq_zero_iff]
      exact haa
    · rw [← Polynomial.eval_map]
      exact ha

  have good : ∀ (K : Type u) [Field K] (ι : K →+* D) (t : IsLocalRing.ResidueField D),
      ∃ x : D, IsLocalRing.residue D x = t ∧ ∀ g : Polynomial K,
        IsLocalRing.residue D (Polynomial.eval₂ ι x g) = 0 → Polynomial.eval₂ ι x g = 0 := by
    intro K _ ι t
    letI : Algebra K (IsLocalRing.ResidueField D) := ((IsLocalRing.residue D).comp ι).toAlgebra
    haveI : CharZero K := RingHom.charZero ((IsLocalRing.residue D).comp ι)
    have key : ∀ (x : D) (g : Polynomial K), IsLocalRing.residue D (Polynomial.eval₂ ι x g) =
        Polynomial.aeval (IsLocalRing.residue D x) g := by
      intro x g
      rw [Polynomial.aeval_def, RingHom.algebraMap_toAlgebra]
      exact Polynomial.hom_eval₂ g ι (IsLocalRing.residue D) x
    by_cases ht : IsIntegral K t
    · have hsep : (minpoly K t).Separable := (minpoly.irreducible ht).separable
      have h0 : Polynomial.aeval t (minpoly K t) = 0 := minpoly.aeval K t
      have h1 := hsep.aeval_derivative_ne_zero h0
      rw [Polynomial.aeval_def, RingHom.algebraMap_toAlgebra] at h0 h1
      obtain ⟨x, hx, hfx⟩ := hensel K ι (minpoly K t) t (minpoly.monic ht) h0 h1
      refine ⟨x, hx, fun g hg => ?_⟩
      rw [key, hx] at hg
      obtain ⟨h, rfl⟩ := minpoly.dvd K t hg
      rw [Polynomial.eval₂_mul, hfx, zero_mul]
    · obtain ⟨x, hx⟩ := IsLocalRing.residue_surjective t
      refine ⟨x, hx, fun g hg => ?_⟩
      rw [key, hx] at hg
      have hg0 : g = 0 := by
        by_contra hne
        exact ht (isAlgebraic_iff_isIntegral.mp ⟨g, hne, hg⟩)
      rw [hg0, Polynomial.eval₂_zero]

  let S : Set (Subring D) := {R | ∀ x ∈ R, IsLocalRing.residue D x = 0 → x = 0}
  have hbot : (⊥ : Subring D) ∈ S := by
    intro x hx h
    obtain ⟨n, rfl⟩ := Subring.mem_bot.mp hx
    rw [map_intCast, Int.cast_eq_zero] at h
    rw [h, Int.cast_zero]
  have hchain : ∀ c ⊆ S, IsChain (· ≤ ·) c → ∀ y ∈ c, ∃ ub ∈ S, ∀ z ∈ c, z ≤ ub := by
    intro c hcS hc y hy
    refine ⟨sSup c, ?_, fun z hz => le_sSup hz⟩
    intro x hx h
    obtain ⟨R, hR, hxR⟩ := (Subring.mem_sSup_of_directedOn ⟨y, hy⟩ hc.directedOn).mp hx
    exact hcS hR x hxR h
  obtain ⟨k₀, -, hk₀⟩ := zorn_le_nonempty₀ S hchain ⊥ hbot
  have hP : ∀ x ∈ k₀, IsLocalRing.residue D x = 0 → x = 0 := hk₀.1
  have hmax : ∀ k' : Subring D, (∀ x ∈ k', IsLocalRing.residue D x = 0 → x = 0) →
      k₀ ≤ k' → k' ≤ k₀ := fun k' h1 h2 => hk₀.2 h1 h2

  have hfield : IsField k₀ := by
    refine ⟨⟨0, 1, fun h => zero_ne_one (congrArg Subtype.val h)⟩, mul_comm, ?_⟩
    intro a ha
    have ha' : (a : D) ≠ 0 := fun h => ha (Subtype.ext h)
    have hres : IsLocalRing.residue D a ≠ 0 := fun h => ha' (hP a a.2 h)
    obtain ⟨u, hu⟩ := (IsLocalRing.residue_ne_zero_iff_isUnit _).mp hres
    have hapow : ∀ N : ℕ, (a : D) ^ N ∈ k₀ := fun N => pow_mem a.2 N
    let T : Subring D :=
      { carrier := {z | ∃ N : ℕ, z * (a : D) ^ N ∈ k₀}
        mul_mem' := by
          rintro z w ⟨N, hN⟩ ⟨M, hM⟩
          refine ⟨N + M, ?_⟩
          have : z * w * (a : D) ^ (N + M) = (z * (a : D) ^ N) * (w * (a : D) ^ M) := by
            rw [pow_add]; ring
          rw [this]
          exact mul_mem hN hM
        one_mem' := ⟨0, by rw [pow_zero, one_mul]; exact one_mem _⟩
        add_mem' := by
          rintro z w ⟨N, hN⟩ ⟨M, hM⟩
          refine ⟨N + M, ?_⟩
          have : (z + w) * (a : D) ^ (N + M) =
              (z * (a : D) ^ N) * (a : D) ^ M + (w * (a : D) ^ M) * (a : D) ^ N := by
            rw [pow_add]; ring
          rw [this]
          exact add_mem (mul_mem hN (hapow M)) (mul_mem hM (hapow N))
        zero_mem' := ⟨0, by rw [zero_mul]; exact zero_mem _⟩
        neg_mem' := by
          rintro z ⟨N, hN⟩
          refine ⟨N, ?_⟩
          rw [neg_mul]
          exact neg_mem hN }
    have hT : T ≤ k₀ := by
      refine hmax T ?_ ?_
      · rintro z ⟨N, hN⟩ hz
        have h1 : IsLocalRing.residue D (z * (a : D) ^ N) = 0 := by
          rw [map_mul, hz, zero_mul]
        have h2 := hP _ hN h1
        have hunit : IsUnit ((a : D) ^ N) := by
          rw [← hu]; exact u.isUnit.pow N
        exact (hunit.mul_left_eq_zero).mp h2
      · intro z hz
        exact ⟨0, by rw [pow_zero, mul_one]; exact hz⟩
    have hyT : ((u⁻¹ : Dˣ) : D) ∈ T := ⟨1, by rw [pow_one, ← hu, Units.inv_mul]; exact one_mem _⟩
    refine ⟨⟨_, hT hyT⟩, Subtype.ext ?_⟩
    show (a : D) * ((u⁻¹ : Dˣ) : D) = 1
    rw [← hu, Units.mul_inv]

  letI : Field k₀ := hfield.toField
  letI : Algebra k₀ D := k₀.subtype.toAlgebra
  refine ⟨k₀, inferInstance, inferInstance, fun t => ?_⟩
  obtain ⟨x, hx, hg⟩ := good k₀ k₀.subtype t
  have hk' : (Polynomial.eval₂RingHom k₀.subtype x).range ≤ k₀ := by
    refine hmax _ ?_ ?_
    · intro z hz hz0
      obtain ⟨g, rfl⟩ := RingHom.mem_range.mp hz
      exact hg g hz0
    · intro z hz
      exact RingHom.mem_range.mpr ⟨Polynomial.C ⟨z, hz⟩, by simp⟩
  have hxk : x ∈ k₀ := hk' (RingHom.mem_range.mpr ⟨Polynomial.X, by simp⟩)
  exact ⟨⟨x, hxk⟩, hx⟩

theorem wc_cf_udvr_base : (∀ (p : ℕ), p.Prime → ∀ (σ : Type u) (a : MvPolynomial σ ℤ), a ≠ 0 → ∃ (k : ℕ) (a' : MvPolynomial σ ℤ), a = MvPolynomial.C ((p : ℤ) ^ k) * a' ∧ ¬ (MvPolynomial.C (p : ℤ) ∣ a')) → ∀ (p : ℕ), p.Prime → ∀ (κ : Type u) [Field κ] [CharP κ p], ∃ (Ω : Type u) (_ : Field Ω) (_ : IsAlgClosed Ω) (_ : CharZero Ω) (G₀ : Subring (Ω × κ)), (∀ g ∈ G₀, g.1 = 0 → g.2 = 0) ∧ (∀ g ∈ G₀, g.1 ≠ 0 → ∃ (k : ℕ) (u v : Ω × κ), u ∈ G₀ ∧ v ∈ G₀ ∧ u * v = 1 ∧ g = (p : Ω × κ) ^ k * u) ∧ ∀ θ : κ, ∃ q : Polynomial κ, q ≠ 0 ∧ (∀ n : ℕ, ∃ g ∈ G₀, g.2 = q.coeff n) ∧ q.eval θ = 0 :=
by
  intro hs9 p hp κ _ _
  classical
  haveI hfact : Fact p.Prime := ⟨hp⟩
  letI alg : Algebra (ZMod p) κ := ZMod.algebra κ p
  obtain ⟨s, hs⟩ := exists_isTranscendenceBasis (ZMod p) κ
  let ρ : MvPolynomial s ℤ →+* κ := MvPolynomial.eval₂Hom (Int.castRingHom κ) (Subtype.val : s → κ)
  have hρ : ∀ a, ρ a = MvPolynomial.aeval (Subtype.val : s → κ)
      (MvPolynomial.map (Int.castRingHom (ZMod p)) a) := by
    intro a
    rw [MvPolynomial.aeval_eq_eval₂Hom, MvPolynomial.eval₂Hom_map_hom]
    have h : (algebraMap (ZMod p) κ).comp (Int.castRingHom (ZMod p)) = Int.castRingHom κ :=
      RingHom.ext_int _ _
    rw [h]
  have hinj : Function.Injective (MvPolynomial.aeval (R := ZMod p) (Subtype.val : s → κ)) :=
    algebraicIndependent_iff_injective_aeval.mp hs.1

  have hK : ∀ a, ρ a = 0 → MvPolynomial.C (p : ℤ) ∣ a := by
    intro a ha
    rw [hρ] at ha
    have h0 : MvPolynomial.map (Int.castRingHom (ZMod p)) a = 0 := hinj (by rw [ha, map_zero])
    rw [MvPolynomial.C_dvd_iff_dvd_coeff]
    intro m
    have h1 := MvPolynomial.ext_iff.mp h0 m
    simp only [MvPolynomial.coeff_map, MvPolynomial.coeff_zero] at h1
    have h2 : ((a.coeff m : ℤ) : ZMod p) = 0 := by simpa using h1
    exact (ZMod.intCast_zmod_eq_zero_iff_dvd _ _).mp h2

  obtain ⟨j, hj⟩ : ∃ j : MvPolynomial s ℤ →+* AlgebraicClosure (FractionRing (MvPolynomial s ℤ)),
      Function.Injective j :=
    ⟨(algebraMap (FractionRing (MvPolynomial s ℤ))
        (AlgebraicClosure (FractionRing (MvPolynomial s ℤ)))).comp
      (algebraMap (MvPolynomial s ℤ) (FractionRing (MvPolynomial s ℤ))),
      by
        rw [RingHom.coe_comp]
        exact (RingHom.injective (algebraMap (FractionRing (MvPolynomial s ℤ))
          (AlgebraicClosure (FractionRing (MvPolynomial s ℤ))))).comp
          (IsFractionRing.injective (MvPolynomial s ℤ) (FractionRing (MvPolynomial s ℤ)))⟩
  haveI hQ : (RingHom.ker ρ).IsPrime := RingHom.ker_isPrime ρ
  let ψ : MvPolynomial s ℤ →+* AlgebraicClosure (FractionRing (MvPolynomial s ℤ)) × κ := j.prod ρ
  have hψ : ∀ a, ψ a = (j a, ρ a) := fun a => RingHom.prod_apply j ρ a
  have hQc : ∀ y ∈ (RingHom.ker ρ).primeCompl, ρ y ≠ 0 ∧ j y ≠ 0 := by
    intro y hy
    have h1 : ρ y ≠ 0 := fun h => hy (RingHom.mem_ker.mpr h)
    refine ⟨h1, fun h => h1 ?_⟩
    have : y = 0 := hj (by rw [h, map_zero])
    rw [this, map_zero]
  have hu : ∀ y : (RingHom.ker ρ).primeCompl, IsUnit (ψ y) := by
    intro y
    obtain ⟨h1, h2⟩ := hQc y y.2
    rw [hψ, Prod.isUnit_iff]
    exact ⟨isUnit_iff_ne_zero.mpr h2, isUnit_iff_ne_zero.mpr h1⟩
  obtain ⟨Φ, hΦ⟩ : ∃ Φ : Localization.AtPrime (RingHom.ker ρ) →+*
      AlgebraicClosure (FractionRing (MvPolynomial s ℤ)) × κ,
      ∀ a, Φ (algebraMap _ (Localization.AtPrime (RingHom.ker ρ)) a) = ψ a :=
    ⟨IsLocalization.lift hu, IsLocalization.lift_eq hu⟩
  have hF : ∀ (a : MvPolynomial s ℤ) (t : (RingHom.ker ρ).primeCompl),
      Φ (IsLocalization.mk' (Localization.AtPrime (RingHom.ker ρ)) a t) * ψ t = ψ a := by
    intro a t
    have h := congrArg Φ (IsLocalization.mk'_spec (Localization.AtPrime (RingHom.ker ρ)) a t)
    rw [map_mul, hΦ, hΦ] at h
    exact h
  refine ⟨AlgebraicClosure (FractionRing (MvPolynomial s ℤ)), inferInstance, inferInstance,
    inferInstance, Φ.range, ?_, ?_, ?_⟩
  ·
    intro g hg h1
    obtain ⟨z, rfl⟩ := RingHom.mem_range.mp hg
    obtain ⟨⟨a, t⟩, hz⟩ := IsLocalization.mk'_surjective (RingHom.ker ρ).primeCompl z
    have hz' : IsLocalization.mk' (Localization.AtPrime (RingHom.ker ρ)) a t = z := hz
    subst hz'
    obtain ⟨hρt, hjt⟩ := hQc t t.2
    have e1 := congrArg Prod.fst (hF a t)
    have e2 := congrArg Prod.snd (hF a t)
    rw [Prod.fst_mul, hψ, hψ] at e1
    rw [Prod.snd_mul, hψ, hψ] at e2
    simp only at e1 e2
    rw [h1, zero_mul] at e1
    have ha : a = 0 := hj (by rw [← e1, map_zero])
    have hρa : ρ a = 0 := by rw [ha, map_zero]
    rw [hρa] at e2
    exact (mul_eq_zero.mp e2).resolve_right hρt
  ·
    intro g hg h1
    obtain ⟨z, rfl⟩ := RingHom.mem_range.mp hg
    obtain ⟨⟨a, t⟩, hz⟩ := IsLocalization.mk'_surjective (RingHom.ker ρ).primeCompl z
    have hz' : IsLocalization.mk' (Localization.AtPrime (RingHom.ker ρ)) a t = z := hz
    subst hz'
    obtain ⟨hρt, hjt⟩ := hQc t t.2
    have e1 := congrArg Prod.fst (hF a t)
    rw [Prod.fst_mul, hψ, hψ] at e1
    simp only at e1
    have ha : a ≠ 0 := by
      rintro rfl
      rw [map_zero] at e1
      exact h1 ((mul_eq_zero.mp e1).resolve_right hjt)
    obtain ⟨k, a', hka, ha'⟩ := hs9 p hp s a ha
    have ha'Q : a' ∈ (RingHom.ker ρ).primeCompl := fun h => ha' (hK a' (RingHom.mem_ker.mp h))
    refine ⟨k, Φ (IsLocalization.mk' (Localization.AtPrime (RingHom.ker ρ)) a' t),
      Φ (IsLocalization.mk' (Localization.AtPrime (RingHom.ker ρ)) (t : MvPolynomial s ℤ)
        ⟨a', ha'Q⟩), ⟨_, rfl⟩, ⟨_, rfl⟩, ?_, ?_⟩
    · rw [← map_mul, IsLocalization.mk'_mul_mk'_eq_one', map_one]
    · rw [hka, ← IsLocalization.mul_mk'_eq_mk'_of_mul, map_mul, hΦ]
      congr 1
      rw [map_pow, map_natCast, map_pow, map_natCast]
  ·
    intro θ
    haveI hA : Algebra.IsAlgebraic (Algebra.adjoin (ZMod p) (Set.range (Subtype.val : s → κ))) κ :=
      hs.isAlgebraic
    obtain ⟨q₀, hq₀, hq₀θ⟩ := Algebra.IsAlgebraic.isAlgebraic
      (R := Algebra.adjoin (ZMod p) (Set.range (Subtype.val : s → κ))) θ
    have hinjA : Function.Injective
        (algebraMap (Algebra.adjoin (ZMod p) (Set.range (Subtype.val : s → κ))) κ) :=
      Subtype.val_injective
    refine ⟨q₀.map (algebraMap (Algebra.adjoin (ZMod p) (Set.range (Subtype.val : s → κ))) κ),
      (Polynomial.map_ne_zero_iff hinjA).mpr hq₀, fun n => ?_, ?_⟩
    · rw [Polynomial.coeff_map]
      have hmem : algebraMap (Algebra.adjoin (ZMod p) (Set.range (Subtype.val : s → κ))) κ
          (q₀.coeff n) ∈ (MvPolynomial.aeval (R := ZMod p) (Subtype.val : s → κ)).range := by
        rw [← Algebra.adjoin_range_eq_range_aeval (ZMod p) (Subtype.val : s → κ)]
        exact (q₀.coeff n).2
      obtain ⟨b, hb⟩ := (AlgHom.mem_range _).mp hmem
      obtain ⟨a, rfl⟩ := MvPolynomial.map_surjective (Int.castRingHom (ZMod p))
        ZMod.intCast_surjective b
      refine ⟨Φ (algebraMap _ (Localization.AtPrime (RingHom.ker ρ)) a), ⟨_, rfl⟩, ?_⟩
      rw [hΦ, hψ, hρ]
      exact hb
    · rw [Polynomial.eval_map_algebraMap]
      exact hq₀θ

theorem wc_cf_udvr_extend : (∀ (R : Type u) [CommRing R] [IsDomain R] [IsIntegrallyClosed R] (Ω : Type u) [Field Ω] [Algebra R Ω], Function.Injective (algebraMap R Ω) → ∀ (f : Polynomial R), f.Monic → ∀ α : Ω, Polynomial.aeval α f = 0 → ∀ r : Polynomial R, r ≠ 0 → Polynomial.aeval α r = 0 → ∃ μ ν : Polynomial R, μ.Monic ∧ ν.Monic ∧ f = μ * ν ∧ 1 ≤ μ.natDegree ∧ μ.natDegree ≤ r.natDegree) → (∀ (R : Type u) [CommRing R] [IsLocalRing R] (A : Type u) [CommRing A] [Algebra R A] [Algebra.IsIntegral R A], (1 : A) ∉ Ideal.map (algebraMap R A) (IsLocalRing.maximalIdeal R) → (∀ a : A, a ∉ Ideal.map (algebraMap R A) (IsLocalRing.maximalIdeal R) → ∃ b : A, a * b - 1 ∈ Ideal.map (algebraMap R A) (IsLocalRing.maximalIdeal R)) → ∀ a : A, a ∉ Ideal.map (algebraMap R A) (IsLocalRing.maximalIdeal R) → IsUnit a) → (∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] (ϖ : R), Irreducible ϖ → ∀ r : Polynomial R, r ≠ 0 → ∃ (k : ℕ) (r' : Polynomial R), r = Polynomial.C (ϖ ^ k) * r' ∧ ∃ i : ℕ, IsUnit (r'.coeff i)) → (∀ (L κ : Type u) [Field L] [Field κ] [Algebra L κ] (θ : κ), IsIntegral L θ → ∀ s : Polynomial L, Polynomial.aeval θ s ≠ 0 → ∃ s' : Polynomial L, Polynomial.aeval θ s * Polynomial.aeval θ s' = 1) → ∀ (p : ℕ), p.Prime → ∀ (Ω κ : Type u) [Field Ω] [IsAlgClosed Ω] [Field κ] [CharP κ p] (G : Subring (Ω × κ)) [IsDomain G] [IsDiscreteValuationRing G], (∀ g ∈ G, g.1 = 0 → g.2 = 0) → (∀ g ∈ G, g.1 ≠ 0 → ∃ (k : ℕ) (u v : Ω × κ), u ∈ G ∧ v ∈ G ∧ u * v = 1 ∧ g = (p : Ω × κ) ^ k * u) → IsLocalRing.maximalIdeal G = Ideal.span {(p : G)} → (∀ g : G, IsUnit g ↔ (g : Ω × κ).2 ≠ 0) → ∀ θ : κ, (∃ q : Polynomial κ, q ≠ 0 ∧ (∀ n : ℕ, ∃ g ∈ G, g.2 = q.coeff n) ∧ q.eval θ = 0) → ∃ G' : Subring (Ω × κ), G ≤ G' ∧ (∀ g ∈ G', g.1 = 0 → g.2 = 0) ∧ (∀ g ∈ G', g.1 ≠ 0 → ∃ (k : ℕ) (u v : Ω × κ), u ∈ G' ∧ v ∈ G' ∧ u * v = 1 ∧ g = (p : Ω × κ) ^ k * u) ∧ ∃ g ∈ G', g.2 = θ :=
by
  classical
  have s1 : ∀ (G : Type u) [CommRing G] [IsLocalRing G] (κ : Type u) [Field κ] (φ : G →+* κ), (∀ g : G, IsUnit g ↔ φ g ≠ 0) → ∀ (θ : κ) (q : Polynomial κ), q ≠ 0 → (∀ n : ℕ, ∃ g : G, φ g = q.coeff n) → q.eval θ = 0 → ∃ f : Polynomial G, f.Monic ∧ 1 ≤ f.natDegree ∧ Polynomial.eval₂ φ θ f = 0 ∧ (∀ r : Polynomial G, r.natDegree < f.natDegree → Polynomial.eval₂ φ θ r = 0 → ∀ i : ℕ, φ (r.coeff i) = 0) ∧ (∀ μ ν : Polynomial G, μ.Monic → ν.Monic → f = μ * ν → μ.natDegree = 0 ∨ ν.natDegree = 0) := by
    intro G _ _ κ _ φ hU θ q hq0 hqc hqθ
    haveI : IsLocalHom φ := ⟨fun a ha => (hU a).mpr ha.ne_zero⟩
    let ι : IsLocalRing.ResidueField G →+* κ := IsLocalRing.ResidueField.lift φ
    have hι : ι.comp (IsLocalRing.residue G) = φ := IsLocalRing.ResidueField.lift_comp_residue φ
    letI : Algebra (IsLocalRing.ResidueField G) κ := ι.toAlgebra
    have hlift : q ∈ Polynomial.lifts ι := by
      rw [Polynomial.lifts_iff_coeff_lifts]
      intro n
      obtain ⟨g, hg⟩ := hqc n
      refine ⟨IsLocalRing.residue G g, ?_⟩
      rw [← hg, ← hι]
      rfl
    obtain ⟨q₀, hq₀⟩ := (Polynomial.mem_lifts q).mp hlift
    have hq₀0 : q₀ ≠ 0 := by
      rintro rfl
      apply hq0
      rw [← hq₀, Polynomial.map_zero]
    have hθint : IsIntegral (IsLocalRing.ResidueField G) θ := by
      apply IsAlgebraic.isIntegral
      refine ⟨q₀, hq₀0, ?_⟩
      rw [Polynomial.aeval_def, ← Polynomial.eval_map]
      show Polynomial.eval θ (q₀.map ι) = 0
      rw [hq₀]
      exact hqθ
    have hres : Function.Surjective (IsLocalRing.residue G) := IsLocalRing.residue_surjective
    have hev : ∀ r : Polynomial G, Polynomial.eval₂ φ θ r =
        Polynomial.aeval θ (r.map (IsLocalRing.residue G)) := by
      intro r
      rw [Polynomial.aeval_def, Polynomial.eval₂_map]
      exact congrArg (fun F => Polynomial.eval₂ F θ r) hι.symm
    have hfbm : (minpoly (IsLocalRing.ResidueField G) θ).Monic := minpoly.monic hθint
    have hfbirr : Irreducible (minpoly (IsLocalRing.ResidueField G) θ) := minpoly.irreducible hθint
    have hfbdeg : 0 < (minpoly (IsLocalRing.ResidueField G) θ).natDegree :=
      minpoly.natDegree_pos hθint
    have hfbl : minpoly (IsLocalRing.ResidueField G) θ ∈ Polynomial.lifts (IsLocalRing.residue G) :=
      (Polynomial.mem_lifts _).mpr (Polynomial.map_surjective _ hres _)
    obtain ⟨f, hfmap, hfdeg, hfm⟩ := Polynomial.lifts_and_natDegree_eq_and_monic hfbl hfbm
    refine ⟨f, hfm, by omega, ?_, ?_, ?_⟩
    · rw [hev, hfmap]
      exact minpoly.aeval _ θ
    · intro r hr hr0 i
      have hrb : Polynomial.aeval θ (r.map (IsLocalRing.residue G)) = 0 := by
        rw [← hev]; exact hr0
      have hrb0 : r.map (IsLocalRing.residue G) = 0 := by
        by_contra hne
        have h1 := minpoly.degree_le_of_ne_zero (IsLocalRing.ResidueField G) θ hne hrb
        have h2 : (r.map (IsLocalRing.residue G)).degree ≤ r.degree := Polynomial.degree_map_le
        have h3 : (minpoly (IsLocalRing.ResidueField G) θ).natDegree ≤ r.natDegree :=
          Polynomial.natDegree_le_natDegree (h1.trans h2)
        omega
      have h4 := congrArg (fun P => P.coeff i) hrb0
      simp only [Polynomial.coeff_map, Polynomial.coeff_zero] at h4
      rw [← hι, RingHom.comp_apply, h4, map_zero]
    · intro μ ν hμ hν hfμν
      have hm := congrArg (Polynomial.map (IsLocalRing.residue G)) hfμν
      rw [hfmap, Polynomial.map_mul] at hm
      rcases hfbirr.isUnit_or_isUnit hm with h | h
      · left
        rw [← hμ.natDegree_map (IsLocalRing.residue G), (hμ.map _).isUnit_iff.mp h,
          Polynomial.natDegree_one]
      · right
        rw [← hν.natDegree_map (IsLocalRing.residue G), (hν.map _).isUnit_iff.mp h,
          Polynomial.natDegree_one]
  have s2 : (∀ (L κ : Type u) [Field L] [Field κ] [Algebra L κ] (θ : κ), IsIntegral L θ → ∀ s : Polynomial L, Polynomial.aeval θ s ≠ 0 → ∃ s' : Polynomial L, Polynomial.aeval θ s * Polynomial.aeval θ s' = 1) → ∀ (G : Type u) [CommRing G] [IsLocalRing G] (κ : Type u) [Field κ] (φ : G →+* κ), (∀ g : G, IsUnit g ↔ φ g ≠ 0) → ∀ (θ : κ) (q : Polynomial κ), q ≠ 0 → (∀ n : ℕ, ∃ g : G, φ g = q.coeff n) → q.eval θ = 0 → ∀ s : Polynomial G, Polynomial.eval₂ φ θ s ≠ 0 → ∃ s' : Polynomial G, Polynomial.eval₂ φ θ s * Polynomial.eval₂ φ θ s' = 1 := by
    intro P7 G _ _ κ _ φ hU θ q hq0 hqc hqθ
    haveI : IsLocalHom φ := ⟨fun a ha => (hU a).mpr ha.ne_zero⟩
    let ι : IsLocalRing.ResidueField G →+* κ := IsLocalRing.ResidueField.lift φ
    have hι : ι.comp (IsLocalRing.residue G) = φ := IsLocalRing.ResidueField.lift_comp_residue φ
    letI : Algebra (IsLocalRing.ResidueField G) κ := ι.toAlgebra
    have hlift : q ∈ Polynomial.lifts ι := by
      rw [Polynomial.lifts_iff_coeff_lifts]
      intro n
      obtain ⟨g, hg⟩ := hqc n
      refine ⟨IsLocalRing.residue G g, ?_⟩
      rw [← hg, ← hι]
      rfl
    obtain ⟨q₀, hq₀⟩ := (Polynomial.mem_lifts q).mp hlift
    have hq₀0 : q₀ ≠ 0 := by
      rintro rfl
      apply hq0
      rw [← hq₀, Polynomial.map_zero]
    have hθint : IsIntegral (IsLocalRing.ResidueField G) θ := by
      apply IsAlgebraic.isIntegral
      refine ⟨q₀, hq₀0, ?_⟩
      rw [Polynomial.aeval_def, ← Polynomial.eval_map]
      show Polynomial.eval θ (q₀.map ι) = 0
      rw [hq₀]
      exact hqθ
    have hres : Function.Surjective (IsLocalRing.residue G) := IsLocalRing.residue_surjective
    have hev : ∀ r : Polynomial G, Polynomial.eval₂ φ θ r =
        Polynomial.aeval θ (r.map (IsLocalRing.residue G)) := by
      intro r
      rw [Polynomial.aeval_def, Polynomial.eval₂_map]
      exact congrArg (fun F => Polynomial.eval₂ F θ r) hι.symm
    intro s hs
    have hs' : Polynomial.aeval θ (s.map (IsLocalRing.residue G)) ≠ 0 := by
      rw [← hev]; exact hs
    obtain ⟨sb', hsb'⟩ := P7 (IsLocalRing.ResidueField G) κ θ hθint _ hs'
    obtain ⟨s', hs''⟩ := Polynomial.map_surjective _ hres sb'
    refine ⟨s', ?_⟩
    rw [hev, hev, hs'']
    exact hsb'
  have s3 : (∀ (R : Type u) [CommRing R] [IsDomain R] [IsIntegrallyClosed R] (Ω : Type u) [Field Ω] [Algebra R Ω], Function.Injective (algebraMap R Ω) → ∀ (f : Polynomial R), f.Monic → ∀ α : Ω, Polynomial.aeval α f = 0 → ∀ r : Polynomial R, r ≠ 0 → Polynomial.aeval α r = 0 → ∃ μ ν : Polynomial R, μ.Monic ∧ ν.Monic ∧ f = μ * ν ∧ 1 ≤ μ.natDegree ∧ μ.natDegree ≤ r.natDegree) → ∀ (R : Type u) [CommRing R] [IsDomain R] [IsIntegrallyClosed R] (Ω : Type u) [Field Ω] (j : R →+* Ω), Function.Injective j → ∀ (f : Polynomial R), f.Monic → (∀ μ ν : Polynomial R, μ.Monic → ν.Monic → f = μ * ν → μ.natDegree = 0 ∨ ν.natDegree = 0) → ∀ α : Ω, Polynomial.eval₂ j α f = 0 → ∀ r : Polynomial R, r.natDegree < f.natDegree → Polynomial.eval₂ j α r = 0 → r = 0 := by
    intro P4 R _ _ _ Ω _ j hj f hf hirr α hfα r hr hrα
