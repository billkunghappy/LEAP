          simp only
          ring
    have hirr : Irreducible (p : G) := by
      refine irreducible_iff.mpr ⟨fun h => ((hU _).mp h) hp2, fun a b hab => ?_⟩
      by_contra hcon
      push_neg at hcon
      obtain ⟨ha, hb⟩ := hcon
      have ha2 : (a : Ω × κ).2 = 0 := by
        by_contra h
        exact ha ((hU a).mpr h)
      have hb2 : (b : Ω × κ).2 = 0 := by
        by_contra h
        exact hb ((hU b).mpr h)
      obtain ⟨a', rfl⟩ := hH a ha2
      obtain ⟨b', rfl⟩ := hH b hb2
      have h3 : (p : G) * 1 = (p : G) * ((p : G) * (a' * b')) := by
        rw [mul_one]
        conv_lhs => rw [hab]
        ring
      have h4 := mul_left_cancel₀ hp0 h3
      exact ((hU _).mp (isUnit_iff_exists_inv.mpr ⟨a' * b', h4.symm⟩)) hp2
    have hfact : IsDiscreteValuationRing.HasUnitMulPowIrreducibleFactorization G := by
      refine ⟨(p : G), hirr, fun {x} hx => ?_⟩
      have hx1 : (x : Ω × κ).1 ≠ 0 := by
        intro h
        apply hx
        apply hπ₁
        rw [map_zero]
        exact h
      obtain ⟨k, u, v, hu, hv, huv, hg⟩ := hD x x.2 hx1
      obtain ⟨U, hU'⟩ := mkU u v hu hv huv
      refine ⟨k, U, ?_⟩
      apply Subtype.ext
      rw [hU', Subring.coe_mul, Subring.coe_pow, hcoe, hg]
    haveI hdvr : IsDiscreteValuationRing G :=
      IsDiscreteValuationRing.ofHasUnitMulPowIrreducibleFactorization hfact
    exact ⟨hdom, hdvr, (IsDiscreteValuationRing.irreducible_iff_uniformizer _).mp hirr, hp0, hU⟩

  have s10 : ∀ (Ω κ : Type u) [Field Ω] [Field κ] (G : Subring (Ω × κ)) [IsLocalRing G], (∀ g : G, IsUnit g ↔ (g : Ω × κ).2 ≠ 0) → (∀ θ : κ, ∃ g ∈ G, g.2 = θ) → Nonempty (IsLocalRing.ResidueField G ≃+* κ) := by
    intro Ω κ _ _ G _ hU hS
    let π₂ : G →+* κ := (RingHom.snd Ω κ).comp G.subtype
    have hsurj : Function.Surjective π₂ := by
      intro θ
      obtain ⟨g, hg, h⟩ := hS θ
      exact ⟨⟨g, hg⟩, h⟩
    have hker : RingHom.ker π₂ = IsLocalRing.maximalIdeal G := by
      ext g
      rw [RingHom.mem_ker, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, hU, not_not]
      rfl
    exact ⟨(Ideal.quotEquivOfEq hker.symm).trans (RingHom.quotientKerEquivOfSurjective hsurj)⟩

  obtain ⟨Ω, fΩ, aΩ, cΩ, G₀, hI₀, hD₀, hAlg⟩ := wc_cf_udvr_base s9 p hp κ
  let S : Set (Subring (Ω × κ)) := {G | (∀ g ∈ G, g.1 = 0 → g.2 = 0) ∧
    (∀ g ∈ G, g.1 ≠ 0 → ∃ (k : ℕ) (u v : Ω × κ), u ∈ G ∧ v ∈ G ∧ u * v = 1 ∧
      g = (p : Ω × κ) ^ k * u)}
  have hchain : ∀ c ⊆ S, IsChain (· ≤ ·) c → ∀ y ∈ c, ∃ ub ∈ S, ∀ z ∈ c, z ≤ ub := by
    intro c hcS hc y hy
    refine ⟨sSup c, ⟨fun g hg h0 => ?_, fun g hg h0 => ?_⟩, fun z hz => le_sSup hz⟩
    · obtain ⟨G, hG, hgG⟩ := (Subring.mem_sSup_of_directedOn ⟨y, hy⟩ hc.directedOn).mp hg
      exact (hcS hG).1 g hgG h0
    · obtain ⟨G, hG, hgG⟩ := (Subring.mem_sSup_of_directedOn ⟨y, hy⟩ hc.directedOn).mp hg
      obtain ⟨k, u, v, hu, hv, huv, hg'⟩ := (hcS hG).2 g hgG h0
      exact ⟨k, u, v, le_sSup hG hu, le_sSup hG hv, huv, hg'⟩
  obtain ⟨M, hG₀M, hM⟩ := zorn_le_nonempty₀ S hchain G₀ ⟨hI₀, hD₀⟩
  obtain ⟨hIM, hDM⟩ := hM.1
  obtain ⟨hdom, hdvr, hmax, hp0, hU⟩ := s2 p hp Ω κ M hIM hDM
  have hsurj : ∀ θ : κ, ∃ g ∈ M, g.2 = θ := by
    intro θ
    obtain ⟨q, hq0, hqc, hqθ⟩ := hAlg θ
    have hqc' : ∀ n : ℕ, ∃ g ∈ M, g.2 = q.coeff n := by
      intro n
      obtain ⟨g, hg, h⟩ := hqc n
      exact ⟨g, hG₀M hg, h⟩
    obtain ⟨G', hMG', hI', hD', g, hg, hgθ⟩ :=
      wc_cf_udvr_extend s4 s5 s6 s7 p hp Ω κ M hIM hDM hmax hU θ ⟨q, hq0, hqc', hqθ⟩
    have hG'M : G' ≤ M := hM.2 ⟨hI', hD'⟩ hMG'
    exact ⟨g, hG'M hg, hgθ⟩
  obtain ⟨e⟩ := s10 Ω κ M hU hsurj
  exact ⟨M, inferInstance, inferInstance, inferInstance, hdom, hmax, hp0, ⟨e⟩⟩

theorem wc_hnas_pfc_gcl_cf_complete_unramified : ∀ (p : ℕ), p.Prime → ∀ (S : Type u) [CommRing S] [IsLocalRing S] [IsNoetherianRing S] [IsDomain S], IsLocalRing.maximalIdeal S = Ideal.span {(p : S)} → (p : S) ≠ 0 → ∃ (Λ : Type u) (_ : CommRing Λ) (_ : IsLocalRing Λ) (_ : IsNoetherianRing Λ), IsDomain Λ ∧ IsAdicComplete (IsLocalRing.maximalIdeal Λ) Λ ∧ IsLocalRing.maximalIdeal Λ = Ideal.span {(p : Λ)} ∧ (p : Λ) ≠ 0 ∧ Nonempty (IsLocalRing.ResidueField Λ ≃+* IsLocalRing.ResidueField S) :=
by
  intro p hp S _ _ _ _ hm hp0
  obtain ⟨hloc, hcomp, hθ, hres⟩ := wc_hnas_completion_local_complete S
  haveI := hloc
  haveI := hθ
  have hnoeth := wc_hnas_completion_noetherian S
  obtain ⟨hL1, hL2⟩ := wc_hnas_hs_completion_levels S
  set C := AdicCompletion (IsLocalRing.maximalIdeal S) S with hC
  set θ := algebraMap S C with hθdef

  have hmem : ∀ s : S, θ s ∈ IsLocalRing.maximalIdeal C ↔ s ∈ IsLocalRing.maximalIdeal S := by
    intro s
    rw [IsLocalRing.mem_maximalIdeal, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff,
      mem_nonunits_iff, isUnit_map_iff]
  have hθp : θ (p : S) = (p : C) := map_natCast θ p
  have hle : Ideal.map θ (IsLocalRing.maximalIdeal S) ≤ IsLocalRing.maximalIdeal C := by
    rw [Ideal.map_le_iff_le_comap]
    intro s hs
    exact (hmem s).mpr hs

  have hmapm : Ideal.map θ (IsLocalRing.maximalIdeal S) = IsLocalRing.maximalIdeal C := by
    apply le_antisymm hle
    intro c hc
    obtain ⟨s, hs⟩ := hL1 1 c
    rw [pow_one] at hs
    have h1 : c - θ s ∈ IsLocalRing.maximalIdeal C := hle hs
    have h2 : θ s ∈ IsLocalRing.maximalIdeal C := by
      have := sub_mem hc h1
      rwa [sub_sub_cancel] at this
    have h3 := Ideal.mem_map_of_mem θ ((hmem s).mp h2)
    have := add_mem hs h3
    rwa [sub_add_cancel] at this
  have hmC : IsLocalRing.maximalIdeal C = Ideal.span {(p : C)} := by
    rw [← hmapm, congrArg (Ideal.map θ) hm, Ideal.map_span, Set.image_singleton, hθp]

  have hpS : (p : S) ∈ IsLocalRing.maximalIdeal S := by
    rw [hm]; exact Ideal.mem_span_singleton_self _
  have hpow : ∀ k : ℕ, (p : C) ^ k ≠ 0 := by
    intro k hk
    have h0 : θ ((p : S) ^ k) ∈ Ideal.map θ (IsLocalRing.maximalIdeal S ^ (k + 1)) := by
      rw [map_pow, hθp, hk]; exact zero_mem _
    have h1 := hL2 (k + 1) _ h0
    rw [hm, Ideal.span_singleton_pow, Ideal.mem_span_singleton'] at h1
    obtain ⟨a, ha⟩ := h1
    have h2 : (p : S) ^ k * (1 - a * p) = 0 := by linear_combination -ha
    have h3 : 1 - a * (p : S) = 0 := (mul_eq_zero.mp h2).resolve_left (pow_ne_zero _ hp0)
    have hu : IsUnit (p : S) :=
      isUnit_iff_exists_inv.mpr ⟨a, by rw [mul_comm]; exact (sub_eq_zero.mp h3).symm⟩
    exact ((IsLocalRing.mem_maximalIdeal _).mp hpS) hu

  have hHaus : IsHausdorff (IsLocalRing.maximalIdeal C) C := hcomp.toIsHausdorff
  have hpowI : ∀ n : ℕ, (IsLocalRing.maximalIdeal C ^ n • (⊤ : Submodule C C)) =
      Ideal.span {(p : C) ^ n} := by
    intro n
    rw [Ideal.smul_eq_mul, Ideal.mul_top, hmC, Ideal.span_singleton_pow]
  have hesc : ∀ x : C, x ≠ 0 → ∃ n, x ∉ Ideal.span {(p : C) ^ n} := by
    intro x hx
    by_contra h
    push_neg at h
    apply hx
    apply hHaus.haus x
    intro n
    rw [SModEq.zero, hpowI]
    exact h n
  have hval : ∀ x : C, x ≠ 0 → ∃ (u : C) (a : ℕ), IsUnit u ∧ x = u * (p : C) ^ a := by
    intro x hx
    classical
    have hex := hesc x hx
    have hspec : x ∉ Ideal.span {(p : C) ^ (Nat.find hex)} := Nat.find_spec hex
    have hn0 : Nat.find hex ≠ 0 := by
      intro h0
      apply hspec
      rw [h0, pow_zero, Ideal.span_singleton_one]
      exact Submodule.mem_top
    obtain ⟨a, ha⟩ : ∃ a, Nat.find hex = a + 1 := ⟨Nat.find hex - 1, by omega⟩
    have hmin : x ∈ Ideal.span {(p : C) ^ a} := by
      by_contra h
      have := Nat.find_min' hex h
      omega
    obtain ⟨u, hu⟩ := Ideal.mem_span_singleton'.mp hmin
    refine ⟨u, a, ?_, hu.symm⟩
    by_contra hnu
    have humem : u ∈ IsLocalRing.maximalIdeal C := (IsLocalRing.mem_maximalIdeal _).mpr hnu
    rw [hmC, Ideal.mem_span_singleton'] at humem
    obtain ⟨b, hb⟩ := humem
    apply hspec
    rw [ha, Ideal.mem_span_singleton']
    exact ⟨b, by rw [← hu, ← hb]; ring⟩
  have hdom : IsDomain C := by
    haveI : NoZeroDivisors C := ⟨fun {x y} hxy => by
      by_contra h
      push_neg at h
      obtain ⟨u, a, hu, rfl⟩ := hval x h.1
      obtain ⟨v, b, hv, rfl⟩ := hval y h.2
      apply hpow (a + b)
      have : (u * v) * (p : C) ^ (a + b) = 0 := by linear_combination hxy
      exact (hu.mul hv).mul_right_eq_zero.mp this⟩
    exact NoZeroDivisors.to_isDomain C

  have hresid : Nonempty (IsLocalRing.ResidueField C ≃+* IsLocalRing.ResidueField S) := by
    let f := IsLocalRing.ResidueField.map θ
    have hinj : Function.Injective f := f.injective
    have hsurj : Function.Surjective f := by
      intro z
      obtain ⟨c, rfl⟩ := IsLocalRing.residue_surjective z
      obtain ⟨a, ha⟩ := hres c
      refine ⟨IsLocalRing.residue S a, ?_⟩
      rw [IsLocalRing.ResidueField.map_residue]
      have := (IsLocalRing.residue_eq_zero_iff (c - θ a)).mpr ha
      rw [map_sub, sub_eq_zero] at this
      exact this.symm
    exact ⟨(RingEquiv.ofBijective f ⟨hinj, hsurj⟩).symm⟩
  have hp1 : (p : C) ≠ 0 := by
    have := hpow 1
    rwa [pow_one] at this
  exact ⟨C, inferInstance, hloc, hnoeth, hdom, hcomp, hmC, hp1, hresid⟩

theorem wc_hnas_pfc_gcl_cf_crl_p_basis : ∀ (p : ℕ), p.Prime → ∀ (κ : Type u) [Field κ] [CharP κ p], ∃ (J : Type u) (b : J → κ), (∀ x : κ, ∃ (s : Finset (J →₀ ℕ)) (c : (J →₀ ℕ) → κ), (∀ e ∈ s, ∀ j, e j < p) ∧ x = ∑ e ∈ s, c e ^ p * e.prod (fun j k => b j ^ k)) ∧ (∀ (s : Finset (J →₀ ℕ)) (c : (J →₀ ℕ) → κ), (∀ e ∈ s, ∀ j, e j < p) → ∑ e ∈ s, c e ^ p * e.prod (fun j k => b j ^ k) = 0 → ∀ e ∈ s, c e = 0) :=
by
  classical
  intro p hp κ _ _
  haveI : Fact p.Prime := ⟨hp⟩
  have hp0 : p ≠ 0 := hp.ne_zero
  have hpos : 0 < p := hp.pos

  obtain ⟨m, hm⟩ : ∃ m : (κ →₀ ℕ) → κ, ∀ e, m e = e.prod (fun j k => j ^ k) := ⟨_, fun e => rfl⟩
  have M0 : m 0 = 1 := by rw [hm, Finsupp.prod_zero_index]
  have M1 : ∀ e e' : κ →₀ ℕ, m (e + e') = m e * m e' := by
    intro e e'
    rw [hm, hm, hm]
    exact Finsupp.prod_add_index' (fun j => pow_zero _) (fun j a b => pow_add _ _ _)
  have M2 : ∀ (a : κ) (k : ℕ), m (Finsupp.single a k) = a ^ k := by
    intro a k
    rw [hm]
    exact Finsupp.prod_single_index (pow_zero a)

  obtain ⟨IND, hIND⟩ : ∃ IND : Set κ → Prop, ∀ Q, IND Q ↔
      ∀ (s : Finset (κ →₀ ℕ)) (c : (κ →₀ ℕ) → κ), (∀ e ∈ s, ∀ j, e j < p) →
        (∀ e ∈ s, (e.support : Set κ) ⊆ Q) → ∑ e ∈ s, c e ^ p * m e = 0 → ∀ e ∈ s, c e = 0 :=
    ⟨_, fun Q => Iff.rfl⟩
  have hInd0 : IND ∅ := by
    rw [hIND]
    intro s c _ hsupp hs0 e he
    have h0 : ∀ e' ∈ s, e' = 0 := by
      intro e' he'
      have := hsupp e' he'
      rw [Set.subset_empty_iff, Finset.coe_eq_empty, Finsupp.support_eq_empty] at this
      exact this
    have hs : s = {0} := by
      ext e'
      constructor
      · intro h
        exact Finset.mem_singleton.mpr (h0 e' h)
      · intro h
        rw [Finset.mem_singleton.mp h, ← h0 e he]
        exact he
    rw [hs, Finset.sum_singleton, M0, mul_one] at hs0
    rw [h0 e he]
    exact (pow_eq_zero_iff hp0).mp hs0

  obtain ⟨B, -, hBmax⟩ := zorn_subset_nonempty {Q : Set κ | IND Q}
    (fun C hCS hC hne => by
      have hfin : ∀ F : Finset κ, (F : Set κ) ⊆ ⋃₀ C → ∃ Q ∈ C, (F : Set κ) ⊆ Q := by
        intro F
        induction F using Finset.induction_on with
        | empty =>
          intro _
          obtain ⟨Q, hQ⟩ := hne
          exact ⟨Q, hQ, by simp⟩
        | insert a F haF ih =>
          intro hF
          rw [Finset.coe_insert, Set.insert_subset_iff] at hF
          obtain ⟨Q1, hQ1, hF1⟩ := ih hF.2
          obtain ⟨Q2, hQ2, ha2⟩ := Set.mem_sUnion.mp hF.1
          rcases hC.total hQ1 hQ2 with h | h
          · exact ⟨Q2, hQ2, by rw [Finset.coe_insert]; exact Set.insert_subset ha2 (hF1.trans h)⟩
          · exact ⟨Q1, hQ1, by rw [Finset.coe_insert]; exact Set.insert_subset (h ha2) hF1⟩
      refine ⟨⋃₀ C, ?_, fun s hs => Set.subset_sUnion_of_mem hs⟩
      show IND (⋃₀ C)
      rw [hIND]
      intro s c hred hsupp hs0
      obtain ⟨Q, hQC, hQ⟩ := hfin (s.biUnion (fun e => e.support)) (by
        intro t ht
        obtain ⟨e, he, hte⟩ := Finset.mem_biUnion.mp (Finset.mem_coe.mp ht)
        exact hsupp e he (Finset.mem_coe.mpr hte))
      have hQI : IND Q := hCS hQC
      rw [hIND] at hQI
      exact hQI s c hred (fun e he =>
        (Finset.coe_subset.mpr (Finset.subset_biUnion_of_mem (fun e => e.support) he)).trans hQ) hs0)
    ∅ hInd0
  have hB : IND B := hBmax.prop
  have hBmax' : ∀ x, IND (insert x B) → x ∈ B := by
    intro x h
    have heq := hBmax.eq_of_subset h (Set.subset_insert x B)
    rw [heq]
    exact Set.mem_insert x B

  obtain ⟨PF, hPF⟩ : ∃ PF : κ → Prop, ∀ x, PF x ↔ ∃ (s : Finset (κ →₀ ℕ)) (c : (κ →₀ ℕ) → κ),
      (∀ e ∈ s, ∀ j, e j < p) ∧ (∀ e ∈ s, (e.support : Set κ) ⊆ B) ∧
        x = ∑ e ∈ s, c e ^ p * m e := ⟨_, fun x => Iff.rfl⟩
  have hzero : PF 0 := (hPF 0).2 ⟨∅, 0, by simp, by simp, by simp⟩
  have hadd : ∀ x y, PF x → PF y → PF (x + y) := by
    intro x y hx hy
    obtain ⟨s, H, hs, hsB, rfl⟩ := (hPF x).1 hx
    obtain ⟨s', H', hs', hsB', rfl⟩ := (hPF y).1 hy
    obtain ⟨K, hK⟩ : ∃ K : (κ →₀ ℕ) → κ, ∀ e, K e = if e ∈ s then H e else 0 := ⟨_, fun e => rfl⟩
    obtain ⟨K', hK'⟩ : ∃ K' : (κ →₀ ℕ) → κ, ∀ e, K' e = if e ∈ s' then H' e else 0 :=
      ⟨_, fun e => rfl⟩
    have e1 : ∑ e ∈ s, H e ^ p * m e = ∑ e ∈ s ∪ s', K e ^ p * m e := by
      calc ∑ e ∈ s, H e ^ p * m e = ∑ e ∈ s, K e ^ p * m e :=
            Finset.sum_congr rfl (fun e he => by rw [hK, if_pos he])
        _ = ∑ e ∈ s ∪ s', K e ^ p * m e :=
            Finset.sum_subset Finset.subset_union_left
              (fun e _ he => by rw [hK, if_neg he, zero_pow hp0, zero_mul])
    have e2 : ∑ e ∈ s', H' e ^ p * m e = ∑ e ∈ s ∪ s', K' e ^ p * m e := by
      calc ∑ e ∈ s', H' e ^ p * m e = ∑ e ∈ s', K' e ^ p * m e :=
            Finset.sum_congr rfl (fun e he => by rw [hK', if_pos he])
        _ = ∑ e ∈ s ∪ s', K' e ^ p * m e :=
            Finset.sum_subset Finset.subset_union_right
              (fun e _ he => by rw [hK', if_neg he, zero_pow hp0, zero_mul])
    refine (hPF _).2 ⟨s ∪ s', fun e => K e + K' e, ?_, ?_, ?_⟩
    · intro e he j
      rcases Finset.mem_union.1 he with h | h
      · exact hs e h j
      · exact hs' e h j
    · intro e he
      rcases Finset.mem_union.1 he with h | h
      · exact hsB e h
      · exact hsB' e h
    · rw [e1, e2]
      simp only [add_pow_char, add_mul, Finset.sum_add_distrib]
  have hsum : ∀ (t : Finset (κ →₀ ℕ)) (f : (κ →₀ ℕ) → κ), (∀ i ∈ t, PF (f i)) →
      PF (∑ i ∈ t, f i) := fun t f hf => Finset.sum_induction f PF hadd hzero hf
  have hmono : ∀ (a : κ) (d : κ →₀ ℕ), (d.support : Set κ) ⊆ B → PF (a ^ p * m d) := by
    intro a d hd
    obtain ⟨rr, hrr⟩ : ∃ rr : κ →₀ ℕ, rr = Finsupp.mapRange (· % p) (Nat.zero_mod p) d :=
      ⟨_, rfl⟩
    obtain ⟨qq, hqq⟩ : ∃ qq : κ →₀ ℕ, qq = Finsupp.mapRange (· / p) (Nat.zero_div p) d :=
      ⟨_, rfl⟩
    have hdd : d = rr + p • qq := by
      ext j
      simp [hrr, hqq, Nat.mod_add_div]
    have hpow : ∀ n : ℕ, m (n • qq) = m qq ^ n := by
      intro n
      induction n with
      | zero => rw [zero_smul, M0, pow_zero]
      | succ n ih => rw [succ_nsmul, M1, ih, pow_succ]
    have hrrB : (rr.support : Set κ) ⊆ B := by
      rw [hrr]
      exact (Finset.coe_subset.mpr Finsupp.support_mapRange).trans hd
    refine (hPF _).2 ⟨{rr}, fun _ => a * m qq, ?_, ?_, ?_⟩
    · intro e he j
      rw [Finset.mem_singleton.mp he, hrr, Finsupp.mapRange_apply]
      exact Nat.mod_lt _ hpos
    · intro e he
      rw [Finset.mem_singleton.mp he]
      exact hrrB
    · rw [Finset.sum_singleton]
      show a ^ p * m d = (a * m qq) ^ p * m rr
      rw [hdd, M1, hpow]
      ring
  have hmul : ∀ x y, PF x → PF y → PF (x * y) := by
    intro x y hx hy
    obtain ⟨s, H, hs, hsB, rfl⟩ := (hPF x).1 hx
    obtain ⟨s', H', hs', hsB', rfl⟩ := (hPF y).1 hy
    have hdouble : ∑ e ∈ s, ∑ e' ∈ s', (H e * H' e') ^ p * m (e + e') =
        (∑ e ∈ s, H e ^ p * m e) * (∑ e ∈ s', H' e ^ p * m e) := by
      rw [Finset.sum_mul_sum]
      refine Finset.sum_congr rfl (fun e _ => Finset.sum_congr rfl (fun e' _ => ?_))
      rw [M1]
      ring
    rw [← hdouble]
    refine hsum _ _ (fun e he => hsum _ _ (fun e' he' => hmono _ _ ?_))
    intro t ht
    have := Finsupp.support_add (Finset.mem_coe.mp ht)
    rcases Finset.mem_union.1 this with h | h
    · exact hsB e he h
    · exact hsB' e' he' h
  have hnegone : PF (-1) := by
    have := hmono (-1) 0 (by simp)
    rwa [M0, mul_one, neg_one_pow_char] at this
  have hpowPF : ∀ y : κ, PF (y ^ p) := fun y => by
    have := hmono y 0 (by simp)
    rwa [M0, mul_one] at this
  have hBPF : ∀ b ∈ B, PF b := fun b hb => by
    have := hmono 1 (Finsupp.single b 1) (by
      intro t ht
      rw [Finset.mem_singleton.mp (Finsupp.support_single_subset (Finset.mem_coe.mp ht))]
      exact hb)
    rwa [M2, pow_one, one_pow, one_mul] at this
  have hVPF : ∀ x ∈ Subfield.closure (Set.range (fun y : κ => y ^ p) ∪ B), PF x := by
    intro x hx
    induction hx using Subfield.closure_induction with
    | mem x hx =>
      rcases hx with ⟨y, rfl⟩ | hx
      · exact hpowPF y
      · exact hBPF x hx
    | one =>
      have := hpowPF 1
      rwa [one_pow] at this
    | add x y _ _ hx hy => exact hadd x y hx hy
    | neg x _ hx =>
      have := hmul _ _ hnegone hx
      rwa [neg_one_mul] at this
    | inv x _ hx =>
      have hpw : ∀ n : ℕ, PF (x ^ n) := by
        intro n
        induction n with
        | zero =>
          rw [pow_zero]
          have := hpowPF 1
          rwa [one_pow] at this
        | succ n ih =>
          rw [pow_succ]
          exact hmul _ _ ih hx
      have hid : x⁻¹ = x ^ (p - 1) * x⁻¹ ^ p := by
        by_cases hx0 : x = 0
        · rw [hx0, inv_zero, zero_pow hp0, mul_zero]
        · have h1 : x⁻¹ ^ p = x⁻¹ ^ (p - 1) * x⁻¹ := by
            rw [← pow_succ, Nat.sub_add_cancel hpos]
          rw [h1, ← mul_assoc, ← mul_pow, mul_inv_cancel₀ hx0, one_pow, one_mul]
      rw [hid]
      exact hmul _ _ (hpw _) (hpowPF _)
    | mul x y _ _ hx hy => exact hmul x y hx hy
  set V := Subfield.closure (Set.range (fun y : κ => y ^ p) ∪ B) with hV
  have hKpV : ∀ y : κ, y ^ p ∈ V := fun y => Subfield.subset_closure (Or.inl ⟨y, rfl⟩)
  have hBV : ∀ b ∈ B, b ∈ V := fun b hb => Subfield.subset_closure (Or.inr hb)

  have hextend : ∀ x, x ∉ V → IND (insert x B) := by
    intro x hxV
    have hxp : x ^ p ∈ V := hKpV x
    have hlin : ∀ a : Fin p → κ, (∀ i, a i ∈ V) → ∑ i, a i * x ^ (i : ℕ) = 0 → ∀ i, a i = 0 := by
      set cc : V := ⟨x ^ p, hxp⟩ with hcc
      set q : Polynomial V := Polynomial.X ^ p - Polynomial.C cc with hq
      have noroot : ∀ c' : V, c' ^ p ≠ cc := by
        intro c' h
        have h1 : ((c' : κ)) ^ p = x ^ p := by
          have := congrArg (Subtype.val) h
          simpa [cc] using this
        have h2 : ((c' : κ) - x) ^ p = 0 := by
          rw [sub_pow_char, h1, sub_self]
        have h3 : (c' : κ) - x = 0 := (pow_eq_zero_iff hp0).mp h2
        apply hxV
        rw [← sub_eq_zero.mp h3]
        exact c'.2
      have hirr : Irreducible q := X_pow_sub_C_irreducible_of_prime hp noroot
      have hmon : q.Monic := Polynomial.monic_X_pow_sub_C cc hp0
      have hqb : Polynomial.aeval x q = 0 := by
        rw [hq, map_sub, map_pow, Polynomial.aeval_X, Polynomial.aeval_C]
        show x ^ p - x ^ p = 0
        exact sub_self _
      have hmin : q = minpoly V x := minpoly.eq_of_irreducible_of_monic hirr hqb hmon
      have hdeg' : q.degree = p := Polynomial.degree_X_pow_sub_C hpos cc
      intro a ha hs' i
      set f : Fin p → V := fun i => ⟨a i, ha i⟩ with hf
      set Q : Polynomial V := ∑ j : Fin p, Polynomial.C (f j) * Polynomial.X ^ (j : ℕ) with hQ
      have hQb : Polynomial.aeval x Q = 0 := by
        rw [← hs', hQ, map_sum]
        refine Finset.sum_congr rfl fun j _ => ?_
        rw [map_mul, map_pow, Polynomial.aeval_C, Polynomial.aeval_X]
        rfl
      have hQ0 : Q = 0 := by
        by_contra hne
        have h1 := minpoly.degree_le_of_ne_zero V x hne hQb
        have h2 : Q.degree < p := Polynomial.degree_sum_fin_lt f
        rw [← hmin, hdeg'] at h1
        exact absurd (lt_of_le_of_lt h1 h2) (lt_irrefl _)
      have hcoeff : Q.coeff i = f i := by
        rw [hQ, Polynomial.finsetSum_coeff]
        simp only [Polynomial.coeff_C_mul_X_pow]
        rw [Finset.sum_eq_single i]
        · simp
        · intro j _ hj; rw [if_neg]; intro h; exact hj (Fin.ext h.symm)
        · intro h; exact absurd (Finset.mem_univ i) h
      have h0 : f i = 0 := by rw [← hcoeff, hQ0, Polynomial.coeff_zero]
      have := congrArg Subtype.val h0
      simpa [f] using this
    have hB' := (hIND B).1 hB
    rw [hIND]
    intro s c hred hsupp hs0
    obtain ⟨A, hA⟩ : ∃ A : ℕ → κ, ∀ i, A i =
        ∑ e ∈ s.filter (fun e => e x = i), c e ^ p * m (Finsupp.erase x e) := ⟨_, fun i => rfl⟩
    have hmerase : ∀ e : κ →₀ ℕ, m e = m (Finsupp.erase x e) * x ^ (e x) := by
      intro e
      conv_lhs => rw [← Finsupp.erase_add_single x e]
      rw [M1, M2]
    have heraseB : ∀ e ∈ s, ((Finsupp.erase x e).support : Set κ) ⊆ B := by
      intro e he t ht
      rw [Finset.mem_coe, Finsupp.support_erase, Finset.mem_erase] at ht
      rcases Set.mem_insert_iff.mp (hsupp e he (Finset.mem_coe.mpr ht.2)) with h | h
      · exact absurd h ht.1
      · exact h
    have hmV : ∀ e ∈ s, m (Finsupp.erase x e) ∈ V := by
      intro e he
      rw [hm, Finsupp.prod]
      exact Subfield.prod_mem _ (fun t ht => Subfield.pow_mem _ (hBV t (heraseB e he ht)) _)
    have hAV : ∀ i, A i ∈ V := by
      intro i
      rw [hA]
      exact Subfield.sum_mem _ (fun e he =>
        Subfield.mul_mem _ (hKpV _) (hmV e (Finset.mem_filter.mp he).1))
    have hAsum : ∑ i : Fin p, A i * x ^ (i : ℕ) = 0 := by
      rw [Fin.sum_univ_eq_sum_range (fun i => A i * x ^ i) p]
      refine Eq.trans ?_ hs0
      rw [← Finset.sum_fiberwise_of_maps_to (g := fun e : κ →₀ ℕ => e x) (t := Finset.range p)
        (fun e he => Finset.mem_range.mpr (hred e he x))]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [hA, Finset.sum_mul]
      refine Finset.sum_congr rfl (fun e he => ?_)
      rw [hmerase e, (Finset.mem_filter.mp he).2, mul_assoc]
    intro e he
    have hi : e x < p := hred e he x
    have hA0 : A (e x) = 0 := hlin (fun i => A i) (fun i => hAV i) hAsum ⟨e x, hi⟩
    have hinj : Set.InjOn (Finsupp.erase x : (κ →₀ ℕ) → (κ →₀ ℕ))
        ((s.filter (fun e' => e' x = e x) : Finset (κ →₀ ℕ)) : Set (κ →₀ ℕ)) := by
      intro e1 he1 e2 he2 h12
      have h1 := (Finset.mem_filter.mp he1).2
      have h2 := (Finset.mem_filter.mp he2).2
      rw [← Finsupp.erase_add_single x e1, ← Finsupp.erase_add_single x e2, h12, h1, h2]
    have hr : ∀ f ∈ (s.filter (fun e' => e' x = e x)).image (Finsupp.erase x), ∀ j, f j < p := by
      intro f hf j
      obtain ⟨e', he', rfl⟩ := Finset.mem_image.mp hf
      rw [Finsupp.erase_apply]
      split_ifs
      · exact hpos
      · exact hred e' (Finset.mem_filter.mp he').1 j
    have hsB : ∀ f ∈ (s.filter (fun e' => e' x = e x)).image (Finsupp.erase x),
        (f.support : Set κ) ⊆ B := by
      intro f hf
      obtain ⟨e', he', rfl⟩ := Finset.mem_image.mp hf
      exact heraseB e' (Finset.mem_filter.mp he').1
    have hz : ∑ f ∈ (s.filter (fun e' => e' x = e x)).image (Finsupp.erase x),
        (fun f => c (f + Finsupp.single x (e x))) f ^ p * m f = 0 := by
      rw [Finset.sum_image hinj]
      refine Eq.trans ?_ hA0
      rw [hA]
      refine Finset.sum_congr rfl (fun e' he' => ?_)
      have h1 := (Finset.mem_filter.mp he').2
      show c (Finsupp.erase x e' + Finsupp.single x (e x)) ^ p * m (Finsupp.erase x e') =
        c e' ^ p * m (Finsupp.erase x e')
      rw [← h1, Finsupp.erase_add_single]
    have key := hB' _ _ hr hsB hz (Finsupp.erase x e)
      (Finset.mem_image_of_mem _ (Finset.mem_filter.mpr ⟨he, rfl⟩))
    have key' : c (Finsupp.erase x e + Finsupp.single x (e x)) = 0 := key
    rwa [Finsupp.erase_add_single] at key'
  have hall : ∀ x, x ∈ V := by
    intro x
    by_contra hxV
    exact hxV (hBV x (hBmax' x (hextend x hxV)))
  have hPFall : ∀ x, PF x := fun x => hVPF x (hall x)

  have hT2 : ∀ f : B →₀ ℕ, m (Finsupp.mapDomain Subtype.val f) = f.prod (fun j k => (j : κ) ^ k) := by
    intro f
    rw [hm]
    exact Finsupp.prod_mapDomain_index (fun _ => pow_zero _) (fun _ _ _ => pow_add _ _ _)
  have hT3 : ∀ f : B →₀ ℕ,
      Finsupp.subtypeDomain (· ∈ B) (Finsupp.mapDomain Subtype.val f) = f := by
    intro f
    ext j
    rw [Finsupp.subtypeDomain_apply, Finsupp.mapDomain_apply_of_injective Subtype.val_injective]
  have hT4 : ∀ e : κ →₀ ℕ, (e.support : Set κ) ⊆ B →
      Finsupp.mapDomain Subtype.val (Finsupp.subtypeDomain (· ∈ B) e) = e := by
    intro e he
    ext a
    by_cases ha : a ∈ B
    · have : a = ((⟨a, ha⟩ : B) : κ) := rfl
      rw [this, Finsupp.mapDomain_apply_of_injective Subtype.val_injective,
        Finsupp.subtypeDomain_apply]
    · rw [Finsupp.mapDomain_of_notMem_range _ _ (by rintro ⟨y, rfl⟩; exact ha y.2)]
      symm
      rw [← Finsupp.notMem_support_iff]
      exact fun h => ha (he h)
  refine ⟨↥B, Subtype.val, ?_, ?_⟩
  · intro x
    obtain ⟨s, c, hred, hsB, hx⟩ := (hPF x).1 (hPFall x)
    have hinjσ : Set.InjOn (Finsupp.subtypeDomain (· ∈ B) : (κ →₀ ℕ) → (B →₀ ℕ))
        (s : Set (κ →₀ ℕ)) := by
      intro e1 h1 e2 h2 h12
      have := congrArg (Finsupp.mapDomain Subtype.val) h12
      rwa [hT4 e1 (hsB e1 h1), hT4 e2 (hsB e2 h2)] at this
    refine ⟨s.image (Finsupp.subtypeDomain (· ∈ B)),
      fun f => c (Finsupp.mapDomain Subtype.val f), ?_, ?_⟩
    · intro f hf j
      obtain ⟨e, he, rfl⟩ := Finset.mem_image.mp hf
      rw [Finsupp.subtypeDomain_apply]
      exact hred e he _
    · rw [Finset.sum_image hinjσ, hx]
      refine Finset.sum_congr rfl (fun e he => ?_)
      show c e ^ p * m e = c (Finsupp.mapDomain Subtype.val (Finsupp.subtypeDomain (· ∈ B) e)) ^ p *
        (Finsupp.subtypeDomain (· ∈ B) e).prod (fun j k => (j : κ) ^ k)
      rw [← hT2, hT4 e (hsB e he)]
  · intro s' c' hred' hs0 f hf
    have hB' := (hIND B).1 hB
    have hinjι : Set.InjOn (Finsupp.mapDomain (Subtype.val : B → κ) : (B →₀ ℕ) → (κ →₀ ℕ))
        (s' : Set (B →₀ ℕ)) :=
      fun f1 _ f2 _ h => Finsupp.mapDomain_injective Subtype.val_injective h
    have hr : ∀ e ∈ s'.image (Finsupp.mapDomain (Subtype.val : B → κ)), ∀ j, e j < p := by
      intro e he j
      obtain ⟨f', hf', rfl⟩ := Finset.mem_image.mp he
      by_cases ha : j ∈ B
      · have : j = ((⟨j, ha⟩ : B) : κ) := rfl
        rw [this, Finsupp.mapDomain_apply_of_injective Subtype.val_injective]
        exact hred' f' hf' _
      · rw [Finsupp.mapDomain_of_notMem_range _ _ (by rintro ⟨y, rfl⟩; exact ha y.2)]
        exact hpos
    have hsupp : ∀ e ∈ s'.image (Finsupp.mapDomain (Subtype.val : B → κ)),
        (e.support : Set κ) ⊆ B := by
      intro e he a ha
      obtain ⟨f', hf', rfl⟩ := Finset.mem_image.mp he
      by_contra hab
      rw [Finset.mem_coe, Finsupp.mem_support_iff,
        Finsupp.mapDomain_of_notMem_range _ _ (by rintro ⟨y, rfl⟩; exact hab y.2)] at ha
      exact ha rfl
    have hz : ∑ e ∈ s'.image (Finsupp.mapDomain (Subtype.val : B → κ)),
        (fun e => c' (Finsupp.subtypeDomain (· ∈ B) e)) e ^ p * m e = 0 := by
      rw [Finset.sum_image hinjι]
      refine Eq.trans (Finset.sum_congr rfl (fun f _ => ?_)) hs0
      show c' (Finsupp.subtypeDomain (· ∈ B) (Finsupp.mapDomain Subtype.val f)) ^ p *
        m (Finsupp.mapDomain Subtype.val f) = c' f ^ p * f.prod (fun j k => (j : κ) ^ k)
      rw [hT3, hT2]
    have key := hB' _ _ hr hsupp hz (Finsupp.mapDomain Subtype.val f) (Finset.mem_image_of_mem _ hf)
    have key' : c' (Finsupp.subtypeDomain (· ∈ B) (Finsupp.mapDomain Subtype.val f)) = 0 := key
    rwa [hT3] at key'

theorem wc_hnas_pfc_gcl_cf_crl_pform_subring : ∀ (p : ℕ), p.Prime → ∀ (Q : Type u) [CommRing Q] (R : Subring Q) (J : Type u) (T : J → Q), (∀ j, T j ∈ R) → ∃ A : Subring Q, ∀ a : Q, a ∈ A ↔ ∃ (s : Finset (J →₀ ℕ)) (H : (J →₀ ℕ) → Q) (G : Q), (∀ e ∈ s, ∀ j, e j < p) ∧ (∀ e ∈ s, H e ∈ R) ∧ G ∈ R ∧ a = ∑ e ∈ s, H e ^ p * e.prod (fun j k => T j ^ k) + (p : Q) * G :=
by
  classical
  intro p hp Q _ R J T hT
  have hp0 : p ≠ 0 := hp.ne_zero
  have hpos : 0 < p := hp.pos
  obtain ⟨τ, hτ⟩ : ∃ τ : (J →₀ ℕ) → Q, ∀ e, τ e = e.prod (fun j k => T j ^ k) :=
    ⟨_, fun e => rfl⟩
  obtain ⟨P, hP⟩ : ∃ P : Q → Prop, ∀ a, P a ↔ ∃ (s : Finset (J →₀ ℕ)) (H : (J →₀ ℕ) → Q) (G : Q),
      (∀ e ∈ s, ∀ j, e j < p) ∧ (∀ e ∈ s, H e ∈ R) ∧ G ∈ R ∧
        a = ∑ e ∈ s, H e ^ p * τ e + (p : Q) * G := ⟨_, fun a => Iff.rfl⟩

  have hτR : ∀ e, τ e ∈ R := by
    intro e
    rw [hτ, Finsupp.prod]
    exact Subring.prod_mem R (fun j _ => Subring.pow_mem R (hT j) _)

  have F1 : ∀ e e' : J →₀ ℕ, τ (e + e') = τ e * τ e' := by
    intro e e'
    rw [hτ, hτ, hτ]
    exact Finsupp.prod_add_index' (fun j => pow_zero _) (fun j a b => pow_add _ _ _)

  have F2 : ∀ x ∈ R, ∀ y ∈ R, ∃ r ∈ R, (x + y) ^ p = x ^ p + y ^ p + (p : Q) * x * y * r := by
    intro x hx y hy
    obtain ⟨r, hr⟩ := exists_add_pow_prime_eq hp (⟨x, hx⟩ : R) ⟨y, hy⟩
    refine ⟨r, r.2, ?_⟩
    have := congrArg (Subtype.val) hr
    simpa using this
  have hzero : P 0 := (hP 0).2 ⟨∅, 0, 0, by simp, by simp, R.zero_mem, by simp⟩
  have hone : P 1 := by
    refine (hP 1).2 ⟨{0}, fun _ => 1, 0, ?_, ?_, R.zero_mem, ?_⟩
    · intro e he j
      rw [Finset.mem_singleton] at he
      subst he
      simpa using hpos
    · intro e _
      exact R.one_mem
    · simp [hτ]
  have hpX : ∀ X ∈ R, P ((p : Q) * X) := fun X hX =>
    (hP _).2 ⟨∅, 0, X, by simp, by simp, hX, by simp⟩

  have hadd : ∀ a b, P a → P b → P (a + b) := by
    intro a b ha hb
    obtain ⟨s, H, G, hs, hH, hG, rfl⟩ := (hP a).1 ha
    obtain ⟨s', H', G', hs', hH', hG', rfl⟩ := (hP b).1 hb
    obtain ⟨K, hK⟩ : ∃ K : (J →₀ ℕ) → Q, ∀ e, K e = if e ∈ s then H e else 0 := ⟨_, fun e => rfl⟩
    obtain ⟨K', hK'⟩ : ∃ K' : (J →₀ ℕ) → Q, ∀ e, K' e = if e ∈ s' then H' e else 0 :=
      ⟨_, fun e => rfl⟩
    have hKR : ∀ e, K e ∈ R := by
      intro e
      rw [hK]
      split_ifs with h
      · exact hH e h
      · exact R.zero_mem
    have hK'R : ∀ e, K' e ∈ R := by
      intro e
      rw [hK']
      split_ifs with h
      · exact hH' e h
      · exact R.zero_mem
    have e1 : ∑ e ∈ s, H e ^ p * τ e = ∑ e ∈ s ∪ s', K e ^ p * τ e := by
      calc ∑ e ∈ s, H e ^ p * τ e = ∑ e ∈ s, K e ^ p * τ e :=
            Finset.sum_congr rfl (fun e he => by rw [hK, if_pos he])
        _ = ∑ e ∈ s ∪ s', K e ^ p * τ e :=
            Finset.sum_subset Finset.subset_union_left
              (fun e _ he => by rw [hK, if_neg he, zero_pow hp0, zero_mul])
    have e2 : ∑ e ∈ s', H' e ^ p * τ e = ∑ e ∈ s ∪ s', K' e ^ p * τ e := by
      calc ∑ e ∈ s', H' e ^ p * τ e = ∑ e ∈ s', K' e ^ p * τ e :=
            Finset.sum_congr rfl (fun e he => by rw [hK', if_pos he])
        _ = ∑ e ∈ s ∪ s', K' e ^ p * τ e :=
            Finset.sum_subset Finset.subset_union_right
              (fun e _ he => by rw [hK', if_neg he, zero_pow hp0, zero_mul])
    choose r hrR hr using fun e => F2 (K e) (hKR e) (K' e) (hK'R e)
    refine (hP _).2 ⟨s ∪ s', fun e => K e + K' e,
      G + G' - ∑ e ∈ s ∪ s', K e * K' e * r e * τ e, ?_, ?_, ?_, ?_⟩
    · intro e he j
      rcases Finset.mem_union.1 he with h | h
      · exact hs e h j
      · exact hs' e h j
    · intro e _
      exact R.add_mem (hKR e) (hK'R e)
    · refine R.sub_mem (R.add_mem hG hG') (R.sum_mem fun e _ => ?_)
      exact R.mul_mem (R.mul_mem (R.mul_mem (hKR e) (hK'R e)) (hrR e)) (hτR e)
    · have e3 : ∑ e ∈ s ∪ s', (K e + K' e) ^ p * τ e = ∑ e ∈ s ∪ s', K e ^ p * τ e +
          ∑ e ∈ s ∪ s', K' e ^ p * τ e + (p : Q) * ∑ e ∈ s ∪ s', K e * K' e * r e * τ e := by
        rw [Finset.mul_sum, ← Finset.sum_add_distrib, ← Finset.sum_add_distrib]
        apply Finset.sum_congr rfl
        intro e _
        rw [hr e]
        ring
      beta_reduce
      rw [e1, e2, e3]
      ring

  have hsum : ∀ (t : Finset (J →₀ ℕ)) (f : (J →₀ ℕ) → Q), (∀ i ∈ t, P (f i)) →
      P (∑ i ∈ t, f i) := fun t f hf => Finset.sum_induction f P hadd hzero hf

  have hmono : ∀ (d : J →₀ ℕ) (x : Q), x ∈ R → P (x ^ p * τ d) := by
    intro d x hx
    obtain ⟨rr, hrr⟩ : ∃ rr : J →₀ ℕ, rr = Finsupp.mapRange (· % p) (Nat.zero_mod p) d :=
      ⟨_, rfl⟩
    obtain ⟨qq, hqq⟩ : ∃ qq : J →₀ ℕ, qq = Finsupp.mapRange (· / p) (Nat.zero_div p) d :=
      ⟨_, rfl⟩
    have hd : d = rr + p • qq := by
      ext j
      simp [hrr, hqq, Nat.mod_add_div]
    have hpow : ∀ n : ℕ, τ (n • qq) = τ qq ^ n := by
      intro n
      induction n with
      | zero => simp [hτ]
      | succ n ih => rw [succ_nsmul, F1, ih, pow_succ]
    refine (hP _).2 ⟨{rr}, fun _ => x * τ qq, 0, ?_, ?_, R.zero_mem, ?_⟩
    · intro e he j
      rw [Finset.mem_singleton] at he
      subst he
      rw [hrr, Finsupp.mapRange_apply]
      exact Nat.mod_lt _ hpos
    · intro e _
      exact R.mul_mem hx (hτR qq)
    · simp only [Finset.sum_singleton, mul_zero, add_zero]
      rw [hd, F1, hpow]
      ring

  have hmul : ∀ a b, P a → P b → P (a * b) := by
    intro a b ha hb
    obtain ⟨s, H, G, hs, hH, hG, rfl⟩ := (hP a).1 ha
    obtain ⟨s', H', G', hs', hH', hG', rfl⟩ := (hP b).1 hb
    have hS : ∑ e ∈ s, H e ^ p * τ e ∈ R :=
      R.sum_mem fun e he => R.mul_mem (R.pow_mem (hH e he) _) (hτR e)
    have hS' : ∑ e ∈ s', H' e ^ p * τ e ∈ R :=
      R.sum_mem fun e he => R.mul_mem (R.pow_mem (hH' e he) _) (hτR e)
    have hdouble : ∑ e ∈ s, ∑ e' ∈ s', (H e * H' e') ^ p * τ (e + e') =
        (∑ e ∈ s, H e ^ p * τ e) * (∑ e ∈ s', H' e ^ p * τ e) := by
      rw [Finset.sum_mul_sum]
      apply Finset.sum_congr rfl
      intro e _
      apply Finset.sum_congr rfl
      intro e' _
      rw [F1]
      ring
    have key : (∑ e ∈ s, H e ^ p * τ e + (p : Q) * G) * (∑ e ∈ s', H' e ^ p * τ e + (p : Q) * G') =
        ∑ e ∈ s, ∑ e' ∈ s', (H e * H' e') ^ p * τ (e + e') +
          (p : Q) * (G * ∑ e ∈ s', H' e ^ p * τ e + (∑ e ∈ s, H e ^ p * τ e) * G' +
            (p : Q) * G * G') := by
      rw [hdouble]
      ring
    rw [key]
    apply hadd
    · exact hsum _ _ (fun e he => hsum _ _ (fun e' he' =>
        hmono (e + e') _ (R.mul_mem (hH e he) (hH' e' he'))))
    · exact hpX _ (R.add_mem (R.add_mem (R.mul_mem hG hS') (R.mul_mem hS hG'))
        (R.mul_mem (R.mul_mem (natCast_mem R p) hG) hG'))

  have hnegone : P (-1) := by
    rcases hp.eq_two_or_odd' with h2 | hodd
    · refine (hP _).2 ⟨{0}, fun _ => 1, -1, ?_, ?_, R.neg_mem R.one_mem, ?_⟩
      · intro e he j
        rw [Finset.mem_singleton] at he
        subst he
        simpa using hpos
      · intro e _
        exact R.one_mem
      · subst h2
        simp only [Finset.sum_singleton, hτ, Finsupp.prod_zero_index, one_pow, mul_one]
        push_cast
        ring
    · refine (hP _).2 ⟨{0}, fun _ => -1, 0, ?_, ?_, R.zero_mem, ?_⟩
      · intro e he j
        rw [Finset.mem_singleton] at he
        subst he
        simpa using hpos
      · intro e _
        exact R.neg_mem R.one_mem
      · simp only [Finset.sum_singleton, hτ, Finsupp.prod_zero_index, hodd.neg_one_pow, mul_one,
          mul_zero, add_zero]
  have hneg : ∀ a, P a → P (-a) := by
    intro a ha
    have := hmul _ _ hnegone ha
    rwa [neg_one_mul] at this
  let A : Subring Q :=
    { carrier := {a | P a}
      mul_mem' := fun {a b} ha hb => hmul a b ha hb
      one_mem' := hone
      add_mem' := fun {a b} ha hb => hadd a b ha hb
      zero_mem' := hzero
      neg_mem' := fun {a} ha => hneg a ha }
  refine ⟨A, fun a => ?_⟩
  show P a ↔ _
  rw [hP]
  simp only [hτ]

theorem wc_hnas_pfc_gcl_cf_crl_kernel : ∀ (p : ℕ), p.Prime → ∀ (Λ : Type u) [CommRing Λ] [IsLocalRing Λ] [IsDomain Λ], IsLocalRing.maximalIdeal Λ = Ideal.span {(p : Λ)} → (p : Λ) ≠ 0 → ∀ (J : Type u) (b : J → IsLocalRing.ResidueField Λ), (∀ (s : Finset (J →₀ ℕ)) (c : (J →₀ ℕ) → IsLocalRing.ResidueField Λ), (∀ e ∈ s, ∀ j, e j < p) → ∑ e ∈ s, c e ^ p * e.prod (fun j k => b j ^ k) = 0 → ∀ e ∈ s, c e = 0) → ∀ (t : J → Λ), (∀ j, IsLocalRing.residue Λ (t j) = b j) → ∀ (C : Type u) [CommRing C] (I : Ideal C), (∀ a ∈ I, ∀ c ∈ I, a * c = 0) → (∀ a ∈ I, (p : C) * a = 0) → ∀ (f : Λ →+* C ⧸ I) (T : J → C), (∀ j, Ideal.Quotient.mk I (T j) = f (t j)) → ∀ (s : Finset (J →₀ ℕ)) (h : (J →₀ ℕ) → Λ) (g : Λ) (η : (J →₀ ℕ) → C) (γ : C), (∀ e ∈ s, ∀ j, e j < p) → (∀ e ∈ s, Ideal.Quotient.mk I (η e) = f (h e)) → Ideal.Quotient.mk I γ = f g → ∑ e ∈ s, h e ^ p * e.prod (fun j k => t j ^ k) + (p : Λ) * g = 0 → ∑ e ∈ s, η e ^ p * e.prod (fun j k => T j ^ k) + (p : C) * γ = 0 :=
by
  intro p hp Λ _ _ _ hm hp0 J b hind t ht C _ I hsq htor f T hT s h g η γ hred hη hγ hrel
  classical
  obtain ⟨n, rfl⟩ : ∃ n, p = n + 1 := ⟨p - 1, (Nat.sub_add_cancel hp.pos).symm⟩

  have powc : ∀ x y : C, x - y ∈ I → x ^ (n + 1) = y ^ (n + 1) := by
    intro x y hxy
    obtain ⟨i, hiI, rfl⟩ : ∃ i ∈ I, x = y + i := ⟨x - y, hxy, by ring⟩
    have hii : i * i = 0 := hsq i hiI i hiI
    have aux : ∀ m : ℕ, (y + i) ^ (m + 1) = y ^ (m + 1) + ((m : C) + 1) * y ^ m * i := by
      intro m
      induction m with
      | zero => simp
      | succ m ih =>
        rw [pow_succ, ih]
        push_cast
        linear_combination ((m : C) + 1) * y ^ m * hii
    have hpi : ((n : C) + 1) * i = 0 := by
      have := htor i hiI
      push_cast at this
      exact this
    rw [aux n]
    linear_combination y ^ n * hpi

  have hpres : IsLocalRing.residue Λ ((n + 1 : ℕ) : Λ) = 0 := by
    rw [IsLocalRing.residue_eq_zero_iff, hm]
    exact Ideal.mem_span_singleton_self _
  have hres_prod : ∀ e : J →₀ ℕ,
      IsLocalRing.residue Λ (e.prod fun j k => t j ^ k) = e.prod fun j k => b j ^ k := by
    intro e
    rw [map_finsuppProd]
    simp only [map_pow, ht]
  have hrel' : ∑ e ∈ s, (IsLocalRing.residue Λ (h e)) ^ (n + 1) *
      e.prod (fun j k => b j ^ k) = 0 := by
    have := congrArg (IsLocalRing.residue Λ) hrel
    rw [map_add, map_mul, hpres, zero_mul, add_zero, map_sum, map_zero] at this
    rw [← this]
    refine Finset.sum_congr rfl fun e _ => ?_
    rw [map_mul, map_pow, hres_prod]
  have hres0 : ∀ e ∈ s, IsLocalRing.residue Λ (h e) = 0 :=
    hind s (fun e => IsLocalRing.residue Λ (h e)) hred hrel'
  have hdiv : ∀ e, ∃ a : Λ, e ∈ s → h e = ((n + 1 : ℕ) : Λ) * a := by
    intro e
    by_cases he : e ∈ s
    · have hmem : h e ∈ IsLocalRing.maximalIdeal Λ :=
        (IsLocalRing.residue_eq_zero_iff _).mp (hres0 e he)
      rw [hm, Ideal.mem_span_singleton'] at hmem
      obtain ⟨a, ha⟩ := hmem
      exact ⟨a, fun _ => by rw [← ha, mul_comm]⟩
    · exact ⟨0, fun h1 => absurd h1 he⟩
  choose h' hh' using hdiv

  obtain ⟨S', hS'⟩ : ∃ S' : Λ, S' = ∑ e ∈ s, h' e ^ (n + 1) * e.prod (fun j k => t j ^ k) :=
    ⟨_, rfl⟩
  have hsum : ∑ e ∈ s, h e ^ (n + 1) * e.prod (fun j k => t j ^ k) =
      ((n + 1 : ℕ) : Λ) ^ (n + 1) * S' := by
    rw [hS', Finset.mul_sum]
    refine Finset.sum_congr rfl fun e he => ?_
    rw [hh' e he, mul_pow, mul_assoc]
  have hg : g = -(((n + 1 : ℕ) : Λ) ^ n * S') := by
    rw [hsum] at hrel
    have h2 : ((n + 1 : ℕ) : Λ) * (((n + 1 : ℕ) : Λ) ^ n * S' + g) = 0 := by
      linear_combination hrel
    have h3 := (mul_eq_zero.mp h2).resolve_left hp0
    linear_combination h3

  have hlift : ∀ e, ∃ y : C, Ideal.Quotient.mk I y = f (h' e) :=
    fun e => Ideal.Quotient.mk_surjective _
  choose η' hη' using hlift

  have hηp : ∀ e ∈ s, η e ^ (n + 1) = ((n + 1 : ℕ) : C) ^ (n + 1) * η' e ^ (n + 1) := by
    intro e he
    rw [← mul_pow]
    apply powc
    rw [← Ideal.Quotient.eq, hη e he, hh' e he]
    simp [hη']

  obtain ⟨Sc, hSc⟩ : ∃ Sc : C, Sc = ∑ e ∈ s, η' e ^ (n + 1) * e.prod (fun j k => T j ^ k) :=
    ⟨_, rfl⟩
  have htrans : Ideal.Quotient.mk I Sc = f S' := by
    rw [hSc, hS', map_sum, map_sum]
    refine Finset.sum_congr rfl fun e _ => ?_
    rw [map_mul, map_mul, map_pow, map_pow, hη', map_finsuppProd, map_finsuppProd]
    simp only [map_pow, hT]
  have hγI : γ - (-(((n + 1 : ℕ) : C) ^ n * Sc)) ∈ I := by
    rw [← Ideal.Quotient.eq, hγ, hg]
    simp [htrans]
  have hpγ : ((n + 1 : ℕ) : C) * γ = -(((n + 1 : ℕ) : C) ^ (n + 1) * Sc) := by
    have := htor _ hγI
    linear_combination this

  have hsumη : ∑ e ∈ s, η e ^ (n + 1) * e.prod (fun j k => T j ^ k) =
      ((n + 1 : ℕ) : C) ^ (n + 1) * Sc := by
    rw [hSc, Finset.mul_sum]
    refine Finset.sum_congr rfl fun e he => ?_
    rw [hηp e he, mul_assoc]
  rw [hsumη, hpγ]
  ring

theorem wc_hnas_pfc_gcl_cf_crl_square_zero_lift : (∀ (p : ℕ), p.Prime → ∀ (Q : Type u) [CommRing Q] (R : Subring Q) (J : Type u) (T : J → Q), (∀ j, T j ∈ R) → ∃ A : Subring Q, ∀ a : Q, a ∈ A ↔ ∃ (s : Finset (J →₀ ℕ)) (H : (J →₀ ℕ) → Q) (G : Q), (∀ e ∈ s, ∀ j, e j < p) ∧ (∀ e ∈ s, H e ∈ R) ∧ G ∈ R ∧ a = ∑ e ∈ s, H e ^ p * e.prod (fun j k => T j ^ k) + (p : Q) * G) → (∀ (p : ℕ), p.Prime → ∀ (Λ : Type u) [CommRing Λ] [IsLocalRing Λ] [IsDomain Λ], IsLocalRing.maximalIdeal Λ = Ideal.span {(p : Λ)} → (p : Λ) ≠ 0 → ∀ (J : Type u) (b : J → IsLocalRing.ResidueField Λ), (∀ (s : Finset (J →₀ ℕ)) (c : (J →₀ ℕ) → IsLocalRing.ResidueField Λ), (∀ e ∈ s, ∀ j, e j < p) → ∑ e ∈ s, c e ^ p * e.prod (fun j k => b j ^ k) = 0 → ∀ e ∈ s, c e = 0) → ∀ (t : J → Λ), (∀ j, IsLocalRing.residue Λ (t j) = b j) → ∀ (C : Type u) [CommRing C] (I : Ideal C), (∀ a ∈ I, ∀ c ∈ I, a * c = 0) → (∀ a ∈ I, (p : C) * a = 0) → ∀ (f : Λ →+* C ⧸ I) (T : J → C), (∀ j, Ideal.Quotient.mk I (T j) = f (t j)) → ∀ (s : Finset (J →₀ ℕ)) (h : (J →₀ ℕ) → Λ) (g : Λ) (η : (J →₀ ℕ) → C) (γ : C), (∀ e ∈ s, ∀ j, e j < p) → (∀ e ∈ s, Ideal.Quotient.mk I (η e) = f (h e)) → Ideal.Quotient.mk I γ = f g → ∑ e ∈ s, h e ^ p * e.prod (fun j k => t j ^ k) + (p : Λ) * g = 0 → ∑ e ∈ s, η e ^ p * e.prod (fun j k => T j ^ k) + (p : C) * γ = 0) → ∀ (p : ℕ), p.Prime → ∀ (Λ : Type u) [CommRing Λ] [IsLocalRing Λ] [IsDomain Λ], IsLocalRing.maximalIdeal Λ = Ideal.span {(p : Λ)} → (p : Λ) ≠ 0 → ∀ (J : Type u) (b : J → IsLocalRing.ResidueField Λ), (∀ x : IsLocalRing.ResidueField Λ, ∃ (s : Finset (J →₀ ℕ)) (c : (J →₀ ℕ) → IsLocalRing.ResidueField Λ), (∀ e ∈ s, ∀ j, e j < p) ∧ x = ∑ e ∈ s, c e ^ p * e.prod (fun j k => b j ^ k)) → (∀ (s : Finset (J →₀ ℕ)) (c : (J →₀ ℕ) → IsLocalRing.ResidueField Λ), (∀ e ∈ s, ∀ j, e j < p) → ∑ e ∈ s, c e ^ p * e.prod (fun j k => b j ^ k) = 0 → ∀ e ∈ s, c e = 0) → ∀ (C : Type u) [CommRing C] (I : Ideal C), (∀ a ∈ I, ∀ c ∈ I, a * c = 0) → (∀ a ∈ I, (p : C) * a = 0) → ∀ f : Λ →+* C ⧸ I, ∃ g : Λ →+* C, (Ideal.Quotient.mk I).comp g = f :=
by
  intro S2 S3 p hp Λ _ _ _ hm hp0 J b hspan hind C _ I hII hpI f
  classical

  have pmap : ∀ (Q : Type u) [CommRing Q] (Q' : Type u) [CommRing Q'] (ψ : Q →+* Q')
      (U : J → Q) (s : Finset (J →₀ ℕ)) (H : (J →₀ ℕ) → Q) (G : Q),
      ψ (∑ e ∈ s, H e ^ p * e.prod (fun j k => U j ^ k) + (p : Q) * G) =
        ∑ e ∈ s, ψ (H e) ^ p * e.prod (fun j k => ψ (U j) ^ k) + (p : Q') * ψ G := by
    intro Q _ Q' _ ψ U s H G
    simp [map_add, map_sum, map_mul, map_pow, map_natCast, map_finsuppProd]

  have pmem : ∀ (Q : Type u) [CommRing Q] (R : Subring Q) (U : J → Q), (∀ j, U j ∈ R) →
      ∀ (s : Finset (J →₀ ℕ)) (H : (J →₀ ℕ) → Q) (G : Q), (∀ e ∈ s, H e ∈ R) → G ∈ R →
      ∑ e ∈ s, H e ^ p * e.prod (fun j k => U j ^ k) + (p : Q) * G ∈ R := by
    intro Q _ R U hU s H G hH hG
    refine R.add_mem (R.sum_mem fun e he => R.mul_mem (R.pow_mem (hH e he) p) ?_)
      (R.mul_mem (natCast_mem R p) hG)
    show ∏ j ∈ e.support, U j ^ e j ∈ R
    exact R.prod_mem fun j _ => R.pow_mem (hU j) _
  have hres : Function.Surjective (IsLocalRing.residue Λ) := IsLocalRing.residue_surjective
  have hmk : Function.Surjective (Ideal.Quotient.mk I) := Ideal.Quotient.mk_surjective
  choose t ht using fun j => hres (b j)
  choose T hT using fun j => hmk (f (t j))
  let P : Subring (Λ × C) :=
    RingHom.eqLocus (f.comp (RingHom.fst Λ C)) ((Ideal.Quotient.mk I).comp (RingHom.snd Λ C))
  have hPmem : ∀ q : Λ × C, q ∈ P ↔ f q.1 = Ideal.Quotient.mk I q.2 := fun q => Iff.rfl
  let Tt : J → Λ × C := fun j => (t j, T j)
  have hTt : ∀ j, Tt j ∈ P := fun j => (hPmem _).mpr (hT j).symm
  obtain ⟨A, hA⟩ := S2 p hp (Λ × C) P J Tt hTt

  have hAP : ∀ a ∈ A, f a.1 = Ideal.Quotient.mk I a.2 := by
    intro a ha
    obtain ⟨s, H, G, _, hH, hG, rfl⟩ := (hA a).mp ha
    exact (hPmem _).mp (pmem (Λ × C) P Tt hTt s H G hH hG)

  have hlam : ∀ x : Λ, ∃ (s : Finset (J →₀ ℕ)) (h : (J →₀ ℕ) → Λ) (g : Λ),
      (∀ e ∈ s, ∀ j, e j < p) ∧ x = ∑ e ∈ s, h e ^ p * e.prod (fun j k => t j ^ k) + (p : Λ) * g := by
    intro x
    obtain ⟨s, c, hred, hx⟩ := hspan (IsLocalRing.residue Λ x)
    choose h hh using fun e => hres (c e)
    have hy : IsLocalRing.residue Λ (x - ∑ e ∈ s, h e ^ p * e.prod (fun j k => t j ^ k)) = 0 := by
      have h1 := pmap Λ _ (IsLocalRing.residue Λ) t s h 0
      simp only [mul_zero, add_zero, map_zero] at h1
      rw [map_sub, h1, hx]
      simp only [hh, ht, sub_self]
    rw [IsLocalRing.residue_eq_zero_iff, hm, Ideal.mem_span_singleton'] at hy
    obtain ⟨a, ha⟩ := hy
    exact ⟨s, h, a, hred, by linear_combination -ha⟩

  have hsurj : ∀ x : Λ, ∃ c : C, (x, c) ∈ A := by
    intro x
    obtain ⟨s, h, g, hred, hx⟩ := hlam x
    choose η hη using fun e => hmk (f (h e))
    obtain ⟨γ, hγ⟩ := hmk (f g)
    let H : (J →₀ ℕ) → Λ × C := fun e => (h e, η e)
    let G : Λ × C := (g, γ)
    have ha : (∑ e ∈ s, H e ^ p * e.prod (fun j k => Tt j ^ k) + (p : Λ × C) * G) ∈ A :=
      (hA _).mpr ⟨s, H, G, hred, fun e _ => (hPmem _).mpr (hη e).symm, (hPmem _).mpr hγ.symm, rfl⟩
    have h1 := pmap (Λ × C) Λ (RingHom.fst Λ C) Tt s H G
    refine ⟨(∑ e ∈ s, H e ^ p * e.prod (fun j k => Tt j ^ k) + (p : Λ × C) * G).2, ?_⟩
    have heq : (x, (∑ e ∈ s, H e ^ p * e.prod (fun j k => Tt j ^ k) + (p : Λ × C) * G).2) =
        ∑ e ∈ s, H e ^ p * e.prod (fun j k => Tt j ^ k) + (p : Λ × C) * G := by
      refine Prod.ext ?_ rfl
      exact hx.trans h1.symm
    rw [heq]
    exact ha

  have hzero : ∀ c : C, ((0 : Λ), c) ∈ A → c = 0 := by
    intro c hc
    obtain ⟨s, H, G, hred, hH, hG, heq⟩ := (hA _).mp hc
    have h1 := (congrArg (RingHom.fst Λ C) heq).trans (pmap _ _ (RingHom.fst Λ C) Tt s H G)
    have h2 := (congrArg (RingHom.snd Λ C) heq).trans (pmap _ _ (RingHom.snd Λ C) Tt s H G)
    have key := S3 p hp Λ hm hp0 J b hind t ht C I hII hpI f T hT s (fun e => (H e).1) G.1
      (fun e => (H e).2) G.2 hred (fun e he => ((hPmem _).mp (hH e he)).symm)
      ((hPmem _).mp hG).symm h1.symm
    exact h2.trans key

  let ρ : A →+* Λ := (RingHom.fst Λ C).comp A.subtype
  have hinj : Function.Injective ρ := by
    rw [injective_iff_map_eq_zero]
    intro a ha
    have ha' : (a : Λ × C).1 = 0 := ha
    have h0 : ((0 : Λ), (a : Λ × C).2) ∈ A := by
      have : ((0 : Λ), (a : Λ × C).2) = (a : Λ × C) := Prod.ext ha'.symm rfl
      rw [this]; exact a.2
    apply Subtype.ext
    exact Prod.ext ha' (hzero _ h0)
  have hsurjρ : Function.Surjective ρ := by
    intro x
    obtain ⟨c, hc⟩ := hsurj x
    exact ⟨⟨(x, c), hc⟩, rfl⟩
  let e := RingEquiv.ofBijective ρ ⟨hinj, hsurjρ⟩
  refine ⟨(RingHom.snd Λ C).comp (A.subtype.comp e.symm.toRingHom), ?_⟩
  apply RingHom.ext
  intro x
  have hx : ((e.symm x : A) : Λ × C).1 = x := e.apply_symm_apply x
  have hP := hAP _ (e.symm x).2
  change Ideal.Quotient.mk I ((e.symm x : A) : Λ × C).2 = f x
  rw [← hP, hx]

theorem wc_hnas_pfc_gcl_cf_crl_complete_glue : ∀ (p : ℕ) (Λ : Type u) [CommRing Λ] (D : Type u) [CommRing D] [IsLocalRing D], IsAdicComplete (IsLocalRing.maximalIdeal D) D → (p : D) ∈ IsLocalRing.maximalIdeal D → (∀ (C : Type u) [CommRing C] (I : Ideal C), (∀ a ∈ I, ∀ c ∈ I, a * c = 0) → (∀ a ∈ I, (p : C) * a = 0) → ∀ f : Λ →+* C ⧸ I, ∃ g : Λ →+* C, (Ideal.Quotient.mk I).comp g = f) → ∀ f₁ : Λ →+* IsLocalRing.ResidueField D, ∃ φ : Λ →+* D, (IsLocalRing.residue D).comp φ = f₁ :=
by
  intro p Λ _ D _ _ hD hp H f₁
  set 𝔪 := IsLocalRing.maximalIdeal D with h𝔪
  have : IsAdicComplete 𝔪 D := hD

  have step : ∀ n : ℕ, 1 ≤ n → ∀ ψ : Λ →+* D ⧸ 𝔪 ^ n, ∃ ψ' : Λ →+* D ⧸ 𝔪 ^ (n + 1),
      (Ideal.Quotient.factorPow 𝔪 (Nat.le_succ n)).comp ψ' = ψ := by
    intro n hn ψ
    set π := Ideal.Quotient.factorPow 𝔪 (Nat.le_succ n) with hπ
    have hsurj : Function.Surjective π := by
      intro y
      obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective y
      exact ⟨Ideal.Quotient.mk _ x, rfl⟩
    have hI : ∀ a ∈ RingHom.ker π, ∃ x ∈ 𝔪 ^ n, Ideal.Quotient.mk (𝔪 ^ (n + 1)) x = a := by
      intro a ha
      obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective a
      refine ⟨x, ?_, rfl⟩
      have h0 : π (Ideal.Quotient.mk _ x) = 0 := ha
      exact Ideal.Quotient.eq_zero_iff_mem.mp h0
    have hsq : ∀ a ∈ RingHom.ker π, ∀ c ∈ RingHom.ker π, a * c = 0 := by
      intro a ha c hc
      obtain ⟨x, hx, rfl⟩ := hI a ha
      obtain ⟨y, hy, rfl⟩ := hI c hc
      rw [← map_mul, Ideal.Quotient.eq_zero_iff_mem]
      have hxy : x * y ∈ 𝔪 ^ (n + n) := by
        rw [pow_add]
        exact Ideal.mul_mem_mul hx hy
      exact Ideal.pow_le_pow_right (by omega) hxy
    have htor : ∀ a ∈ RingHom.ker π, ((p : ℕ) : D ⧸ 𝔪 ^ (n + 1)) * a = 0 := by
      intro a ha
      obtain ⟨x, hx, rfl⟩ := hI a ha
      rw [← map_natCast (Ideal.Quotient.mk (𝔪 ^ (n + 1))) p, ← map_mul,
        Ideal.Quotient.eq_zero_iff_mem, pow_succ']
      exact Ideal.mul_mem_mul hp hx
    let e := RingHom.quotientKerEquivOfSurjective hsurj
    obtain ⟨g, hg⟩ := H (D ⧸ 𝔪 ^ (n + 1)) (RingHom.ker π) hsq htor (e.symm.toRingHom.comp ψ)
    refine ⟨g, RingHom.ext fun l => ?_⟩
    have h1 := congrArg (fun φ => φ l) hg
    simp only [RingHom.comp_apply] at h1
    rw [RingHom.comp_apply, ← RingHom.quotientKerEquivOfSurjective_apply_mk hsurj (g l)]
    change e _ = _
    rw [h1]
    exact e.apply_symm_apply (ψ l)

  choose L hL using step
  let f₀ : Λ →+* D ⧸ 𝔪 ^ 1 := (Ideal.quotEquivOfEq (pow_one 𝔪).symm).toRingHom.comp f₁
  let ψ : (k : ℕ) → (Λ →+* D ⧸ 𝔪 ^ (k + 1)) := fun k =>
    Nat.rec (motive := fun k => Λ →+* D ⧸ 𝔪 ^ (k + 1)) f₀
      (fun k ψk => L (k + 1) (Nat.succ_pos k) ψk) k
  have hψ : ∀ k, (Ideal.Quotient.factorPow 𝔪 (Nat.le_succ (k + 1))).comp (ψ (k + 1)) = ψ k :=
    fun k => hL (k + 1) (Nat.succ_pos k) (ψ k)

  let F : (n : ℕ) → (Λ →+* D ⧸ 𝔪 ^ n) := fun n =>
    (Ideal.Quotient.factorPow 𝔪 (Nat.le_succ n)).comp (ψ n)
  have tower : ∀ (a b c : ℕ) (hab : a ≤ b) (hbc : b ≤ c),
      (Ideal.Quotient.factorPow 𝔪 hab).comp (Ideal.Quotient.factorPow 𝔪 hbc) =
        Ideal.Quotient.factorPow 𝔪 (hab.trans hbc) := by
    intro a b c hab hbc
    apply Ideal.Quotient.ringHom_ext
    rfl
  have hid : ∀ a : ℕ, Ideal.Quotient.factorPow 𝔪 (le_refl a) = RingHom.id _ := by
    intro a
    apply Ideal.Quotient.ringHom_ext
    rfl
  have hF1 : ∀ n, (Ideal.Quotient.factorPow 𝔪 (Nat.le_succ n)).comp (F (n + 1)) = F n := by
    intro n
    show (Ideal.Quotient.factorPow 𝔪 (Nat.le_succ n)).comp
      ((Ideal.Quotient.factorPow 𝔪 (Nat.le_succ (n + 1))).comp (ψ (n + 1))) = F n
    rw [hψ n]
  have hF : ∀ {m n : ℕ} (hle : m ≤ n), (Ideal.Quotient.factorPow 𝔪 hle).comp (F n) = F m := by
    intro m n hle
    induction n, hle using Nat.le_induction with
    | base => rw [hid]; rfl
    | succ n hmn ih =>
      rw [← tower m n (n + 1) hmn (Nat.le_succ n), RingHom.comp_assoc, hF1, ih]

  refine ⟨IsAdicComplete.liftRingHom 𝔪 F hF, RingHom.ext fun l => ?_⟩
  have h1 := IsAdicComplete.mk_liftRingHom 𝔪 F hF (n := 1) l
  have h2 : F 1 l = ψ 0 l := congrArg (fun φ => φ l) (hψ 0)
  obtain ⟨y, hy⟩ := IsLocalRing.residue_surjective (f₁ l)
  have h3 : ψ 0 l = Ideal.Quotient.mk (𝔪 ^ 1) y := by
    show (Ideal.quotEquivOfEq (pow_one 𝔪).symm) (f₁ l) = _
    rw [← hy]
    exact Ideal.quotEquivOfEq_mk _ y
  rw [h2, h3, Ideal.Quotient.eq, pow_one] at h1
  rw [RingHom.comp_apply, ← hy]
  exact Ideal.Quotient.eq.mpr h1

theorem wc_hnas_pfc_gcl_cf_cohen_ring_lift : ∀ (p : ℕ), p.Prime → ∀ (Λ : Type u) [CommRing Λ] [IsLocalRing Λ] [IsNoetherianRing Λ] [IsDomain Λ], IsAdicComplete (IsLocalRing.maximalIdeal Λ) Λ → IsLocalRing.maximalIdeal Λ = Ideal.span {(p : Λ)} → (p : Λ) ≠ 0 → ∀ (D : Type u) [CommRing D] [IsLocalRing D] [IsNoetherianRing D], IsAdicComplete (IsLocalRing.maximalIdeal D) D → ∀ σ : IsLocalRing.ResidueField Λ →+* IsLocalRing.ResidueField D, ∃ φ : Λ →+* D, (IsLocalRing.residue D).comp φ = σ.comp (IsLocalRing.residue Λ) :=
by
  intro p hp Λ _ _ _ _ _ hΛm hp0 D _ _ _ hD σ

  have hpΛ : IsLocalRing.residue Λ (p : Λ) = 0 := by
    rw [IsLocalRing.residue_eq_zero_iff, hΛm]
    exact Ideal.subset_span rfl

  have hpD : (p : D) ∈ IsLocalRing.maximalIdeal D := by
    rw [← IsLocalRing.residue_eq_zero_iff, map_natCast, ← map_natCast σ p,
      ← map_natCast (IsLocalRing.residue Λ) p, hpΛ, map_zero]

  haveI : CharP (IsLocalRing.ResidueField Λ) p := by
    refine (CharP.charP_iff_prime_eq_zero hp).mpr ?_
    rw [← map_natCast (IsLocalRing.residue Λ) p]
    exact hpΛ

  obtain ⟨J, b, hspan, hind⟩ :=
    wc_hnas_pfc_gcl_cf_crl_p_basis p hp (IsLocalRing.ResidueField Λ)

  have hlift := wc_hnas_pfc_gcl_cf_crl_square_zero_lift wc_hnas_pfc_gcl_cf_crl_pform_subring
    wc_hnas_pfc_gcl_cf_crl_kernel p hp Λ hΛm hp0 J b hspan hind

  exact wc_hnas_pfc_gcl_cf_crl_complete_glue p Λ D hD hpD hlift (σ.comp (IsLocalRing.residue Λ))

theorem wc_hnas_pfc_gcl_cf_system_of_parameters : ∀ (n : ℕ) (S : Type u) [CommRing S] [IsLocalRing S] [IsNoetherianRing S], ringKrullDim S ≤ (n : WithBot ℕ∞) → ∃ y : Fin n → S, (∀ i, y i ∈ IsLocalRing.maximalIdeal S) ∧ IsLocalRing.maximalIdeal S ≤ (Ideal.span (Set.range y)).radical :=
by
  intro n S _ _ _ hdim
  obtain ⟨s, hmin, hcard⟩ :=
    Ideal.exists_finset_card_eq_height_of_isNoetherianRing (IsLocalRing.maximalIdeal S)
  have hcard' : ((s.card : ℕ∞) : WithBot ℕ∞) = ringKrullDim S := by
    rw [hcard]; exact IsLocalRing.maximalIdeal_height_eq_ringKrullDim
  have hle : s.card ≤ n := by
    have h : ((s.card : ℕ∞) : WithBot ℕ∞) ≤ (n : WithBot ℕ∞) := hcard' ▸ hdim
    exact_mod_cast h
  have hspan : Ideal.span (s : Set S) ≤ IsLocalRing.maximalIdeal S := hmin.1.2
  have hs : ∀ t ∈ s, t ∈ IsLocalRing.maximalIdeal S :=
    fun t ht => hspan (Ideal.subset_span ht)
  have hrad : IsLocalRing.maximalIdeal S ≤ (Ideal.span (s : Set S)).radical := by
    rw [Ideal.radical_eq_sInf]
    refine le_sInf ?_
    rintro J ⟨hJs, hJp⟩
    exact hmin.2 ⟨hJp, hJs⟩ (IsLocalRing.le_maximalIdeal hJp.ne_top)
  set L := s.toList with hL
  have hLlen : L.length = s.card := Finset.length_toList s
  refine ⟨fun i => L.getD i 0, ?_, ?_⟩
  · intro i
    show L.getD (i : ℕ) 0 ∈ IsLocalRing.maximalIdeal S
    by_cases hi : (i : ℕ) < L.length
    · rw [List.getD_eq_getElem _ _ hi]
      exact hs _ (Finset.mem_toList.mp (List.getElem_mem hi))
    · rw [List.getD_eq_default _ _ (not_lt.mp hi)]
      exact zero_mem _
  · refine hrad.trans (Ideal.radical_mono (Ideal.span_mono ?_))
    intro a ha
    have haL : a ∈ L := Finset.mem_toList.mpr ha
    obtain ⟨j, hj, hja⟩ := List.mem_iff_getElem.mp haL
    refine ⟨⟨j, by omega⟩, ?_⟩
    simp only
    rw [List.getD_eq_getElem _ _ hj, hja]

theorem wc_hnas_pfc_gcl_cf_power_series_eval : ∀ (Λ : Type u) [CommRing Λ] (D : Type u) [CommRing D] [IsLocalRing D] [Algebra Λ D], IsAdicComplete (IsLocalRing.maximalIdeal D) D → ∀ (r : ℕ) (y : Fin r → D), (∀ i, y i ∈ IsLocalRing.maximalIdeal D) → ∃ Φ : MvPowerSeries (Fin r) Λ →ₐ[Λ] D, ∀ i, Φ (MvPowerSeries.X i) = y i :=
by
  intro Λ _ D _ _ _ hD r y hy
  set I := IsLocalRing.maximalIdeal D with hI

  have s1 : ∀ (k : ℕ) (P : MvPolynomial (Fin r) Λ),
      (∀ e : Fin r →₀ ℕ, P.coeff e ≠ 0 → ∃ i, k ≤ e i) → MvPolynomial.aeval y P ∈ I ^ k := by
    intro k P hP
    rw [MvPolynomial.as_sum P, map_sum]
    refine Ideal.sum_mem _ (fun e he => ?_)
    obtain ⟨i, hi⟩ := hP e (MvPolynomial.mem_support_iff.mp he)
    rw [MvPolynomial.aeval_monomial, Finsupp.prod_fintype _ _ (fun j => pow_zero _)]
    refine Ideal.mul_mem_left _ _ ?_
    have h1 : y i ^ (e i) ∈ I ^ k := Ideal.pow_le_pow_right hi (Ideal.pow_mem_pow (hy i) _)
    exact Ideal.mem_of_dvd _ (Finset.dvd_prod_of_mem (fun j => y j ^ e j) (Finset.mem_univ i)) h1

  have s2 : ∀ (M e : Fin r →₀ ℕ) (F G : MvPowerSeries (Fin r) Λ), e ≤ M →
      (MvPowerSeries.trunc' Λ M (F * G)).coeff e =
        (MvPowerSeries.trunc' Λ M F * MvPowerSeries.trunc' Λ M G).coeff e := by
    intro M e F G he
    rw [MvPowerSeries.coeff_trunc', if_pos he, MvPowerSeries.coeff_mul, MvPolynomial.coeff_mul]
    refine Finset.sum_congr rfl (fun p hp => ?_)
    have hpe : p.1 + p.2 = e := Finset.HasAntidiagonal.mem_antidiagonal.mp hp
    have h1 : p.1 ≤ e := by rw [← hpe]; exact le_self_add
    have h2 : p.2 ≤ e := by rw [← hpe]; exact le_add_self
    rw [MvPowerSeries.coeff_trunc', MvPowerSeries.coeff_trunc', if_pos (h1.trans he),
      if_pos (h2.trans he)]

  let N : ℕ → (Fin r →₀ ℕ) := fun k => Finsupp.equivFunOnFinite.symm (fun _ => k)
  have hN : ∀ k i, N k i = k := fun k i => by simp [N]

  have star : ∀ (k : ℕ) (Q : MvPolynomial (Fin r) Λ), (∀ e, e ≤ N k → Q.coeff e = 0) →
      MvPolynomial.aeval y Q ∈ I ^ k := by
    intro k Q hQ
    apply s1 k Q
    intro e he
    by_contra hcon
    push_neg at hcon
    exact he (hQ e (Finsupp.le_def.mpr (fun i => by rw [hN]; exact (hcon i).le)))

  let f : (n : ℕ) → MvPowerSeries (Fin r) Λ →+* D ⧸ I ^ n := fun n =>
    { toFun := fun F => Ideal.Quotient.mk (I ^ n) (MvPolynomial.aeval y (MvPowerSeries.trunc' Λ (N n) F))
      map_one' := by simp only [MvPowerSeries.trunc'_one, map_one]
      map_mul' := fun F G => by
        show Ideal.Quotient.mk (I ^ n) (MvPolynomial.aeval y (MvPowerSeries.trunc' Λ (N n) (F * G))) =
          Ideal.Quotient.mk (I ^ n) (MvPolynomial.aeval y (MvPowerSeries.trunc' Λ (N n) F)) *
          Ideal.Quotient.mk (I ^ n) (MvPolynomial.aeval y (MvPowerSeries.trunc' Λ (N n) G))
        rw [← map_mul (Ideal.Quotient.mk (I ^ n)), ← map_mul (MvPolynomial.aeval y),
          Ideal.Quotient.eq, ← map_sub]
        apply star
        intro e he
        rw [MvPolynomial.coeff_sub, s2 (N n) e F G he, sub_self]
      map_zero' := by simp only [map_zero]
      map_add' := fun F G => by simp only [map_add] }
  have hf : ∀ {m n : ℕ} (hle : m ≤ n), (Ideal.Quotient.factorPow I hle).comp (f n) = f m := by
    intro m n hle
    refine RingHom.ext (fun F => ?_)
    show Ideal.Quotient.mk (I ^ m) (MvPolynomial.aeval y (MvPowerSeries.trunc' Λ (N n) F)) =
      Ideal.Quotient.mk (I ^ m) (MvPolynomial.aeval y (MvPowerSeries.trunc' Λ (N m) F))
    rw [Ideal.Quotient.eq, ← map_sub]
    apply star
    intro e he
    have he' : e ≤ N n := le_trans he (Finsupp.le_def.mpr (fun i => by rw [hN, hN]; exact hle))
    rw [MvPolynomial.coeff_sub, MvPowerSeries.coeff_trunc', MvPowerSeries.coeff_trunc', if_pos he,
      if_pos he', sub_self]
  have hC : ∀ (n : ℕ) (c : Λ), f n (MvPowerSeries.C c) =
      Ideal.Quotient.mk (I ^ n) (algebraMap Λ D c) := by
    intro n c
    show Ideal.Quotient.mk (I ^ n) (MvPolynomial.aeval y (MvPowerSeries.trunc' Λ (N n) (MvPowerSeries.C c))) = _
    rw [MvPowerSeries.trunc'_C, MvPolynomial.aeval_C]
  have hX : ∀ (n : ℕ) (i : Fin r), f n (MvPowerSeries.X i) = Ideal.Quotient.mk (I ^ n) (y i) := by
    intro n i
    show Ideal.Quotient.mk (I ^ n) (MvPolynomial.aeval y (MvPowerSeries.trunc' Λ (N n) (MvPowerSeries.X i))) = _
    rw [← MvPolynomial.aeval_X (R := Λ) y i, Ideal.Quotient.eq, ← map_sub]
    apply star
    intro e he
    rw [MvPolynomial.coeff_sub, MvPowerSeries.coeff_trunc', if_pos he, MvPowerSeries.coeff_X,
      MvPolynomial.coeff_X']
    by_cases h : e = Finsupp.single i 1
    · subst h; simp
    · rw [if_neg h, if_neg (Ne.symm h), sub_self]

  haveI := hD
  have sep : ∀ a b : D, (∀ n, Ideal.Quotient.mk (I ^ n) a = Ideal.Quotient.mk (I ^ n) b) → a = b := by
    intro a b h
    rw [IsHausdorff.eq_iff_smodEq (I := I)]
    intro n
    rw [SModEq.sub_mem, Ideal.smul_eq_mul, Ideal.mul_top]
    exact Ideal.Quotient.eq.mp (h n)
  let φ := IsAdicComplete.liftRingHom I f hf
  have hφ : ∀ n x, Ideal.Quotient.mk (I ^ n) (φ x) = f n x := IsAdicComplete.mk_liftRingHom I f hf
  have hcomm : ∀ c : Λ, φ (algebraMap Λ (MvPowerSeries (Fin r) Λ) c) = algebraMap Λ D c := by
    intro c
    apply sep
    intro n
    rw [hφ, ← MvPowerSeries.c_eq_algebraMap, hC]
  refine ⟨AlgHom.mk φ hcomm, fun i => ?_⟩
  apply sep
  intro n
  exact (hφ n _).trans (hX n i)

theorem wc_hnas_pfc_gcl_cf_complete_nakayama : ∀ (A : Type u) [CommRing A] (I : Ideal A), IsAdicComplete I A → ∀ (M : Type u) [AddCommGroup M] [Module A M], IsHausdorff I M → ∀ (T : Finset M), Submodule.span A (T : Set M) ⊔ I • (⊤ : Submodule A M) = ⊤ → Submodule.span A (T : Set M) = ⊤ :=
by
  intro A _ I hc M _ _ hH T h
  classical

  have step : ∀ (n : ℕ) (z : M), z ∈ I ^ n • (⊤ : Submodule A M) →
      ∃ c : M → A, (∀ t, c t ∈ I ^ n) ∧
        z - ∑ t ∈ T, c t • t ∈ I ^ (n + 1) • (⊤ : Submodule A M) := by
    intro n z hz
    have heq : I ^ n • (⊤ : Submodule A M) =
        I ^ n • Submodule.span A (T : Set M) ⊔ I ^ (n + 1) • (⊤ : Submodule A M) := by
      conv_lhs => rw [← h]
      rw [Submodule.smul_sup, pow_succ, Submodule.mul_smul]
    rw [heq, Submodule.mem_sup] at hz
    obtain ⟨y, hy, w, hw, rfl⟩ := hz
    have claim : ∀ y ∈ I ^ n • Submodule.span A (T : Set M),
        ∃ c : M → A, (∀ t, c t ∈ I ^ n) ∧ y = ∑ t ∈ T, c t • t := by
      intro y hy
      refine Submodule.smul_induction_on
        (p := fun y => ∃ c : M → A, (∀ t, c t ∈ I ^ n) ∧ y = ∑ t ∈ T, c t • t) hy ?_ ?_
      · intro r hr m hm
        obtain ⟨b, -, hb⟩ := (Submodule.mem_span_finset).mp hm
        refine ⟨fun t => r * b t, fun t => Ideal.mul_mem_right _ _ hr, ?_⟩
        rw [← hb, Finset.smul_sum]
        refine Finset.sum_congr rfl (fun t _ => ?_)
        rw [mul_smul]
      · intro y y' ihy ihy'
        obtain ⟨c, hc, rfl⟩ := ihy
        obtain ⟨c', hc', rfl⟩ := ihy'
        refine ⟨fun t => c t + c' t, fun t => Ideal.add_mem _ (hc t) (hc' t), ?_⟩
        rw [← Finset.sum_add_distrib]
        refine Finset.sum_congr rfl (fun t _ => ?_)
        rw [add_smul]
    obtain ⟨c, hc, hyc⟩ := claim y hy
    refine ⟨c, hc, ?_⟩
    rw [← hyc, add_sub_cancel_left]
    exact hw

  obtain ⟨C, hC⟩ : ∃ C : ℕ → M → M → A, ∀ n z, z ∈ I ^ n • (⊤ : Submodule A M) →
      (∀ t, C n z t ∈ I ^ n) ∧
        z - ∑ t ∈ T, C n z t • t ∈ I ^ (n + 1) • (⊤ : Submodule A M) := by
    refine ⟨fun n z => if hz : z ∈ I ^ n • (⊤ : Submodule A M) then
      Classical.choose (step n z hz) else 0, ?_⟩
    intro n z hz
    simp only [dif_pos hz]
    exact Classical.choose_spec (step n z hz)
  rw [eq_top_iff]
  intro x _

  obtain ⟨a, -, haS⟩ : ∃ a : ℕ → M → A, a 0 = 0 ∧
      ∀ n, a (n + 1) = a n + C n (x - ∑ t ∈ T, a n t • t) :=
    ⟨fun n => Nat.rec (motive := fun _ => M → A) 0
      (fun k ak => ak + C k (x - ∑ t ∈ T, ak t • t)) n, rfl, fun _ => rfl⟩
  have inv : ∀ n, x - ∑ t ∈ T, a n t • t ∈ I ^ n • (⊤ : Submodule A M) := by
    intro n
    induction n with
    | zero =>
      rw [pow_zero, Ideal.one_eq_top, Submodule.top_smul]
      exact Submodule.mem_top
    | succ n ih =>
      have key : x - ∑ t ∈ T, a (n + 1) t • t = (x - ∑ t ∈ T, a n t • t) -
          ∑ t ∈ T, C n (x - ∑ t ∈ T, a n t • t) t • t := by
        rw [haS n]
        simp only [Pi.add_apply, add_smul, Finset.sum_add_distrib]
        abel
      rw [key]
      exact (hC n _ ih).2
  have hinc : ∀ n t, a (n + 1) t - a n t ∈ I ^ n := by
    intro n t
    rw [haS n, Pi.add_apply, add_sub_cancel_left]
    exact (hC n _ (inv n)).1 t

  have hcauchy : ∀ t m n, m ≤ n → a n t - a m t ∈ I ^ m := by
    intro t m n hmn
    induction n, hmn using Nat.le_induction with
    | base => rw [sub_self]; exact Ideal.zero_mem _
    | succ n hmn ih =>
      have e : a (n + 1) t - a m t = (a (n + 1) t - a n t) + (a n t - a m t) := by abel
      rw [e]
      exact Ideal.add_mem _ (Ideal.pow_le_pow_right hmn (hinc n t)) ih
  have hsmodA : ∀ (J : Ideal A) (p q : A), p ≡ q [SMOD J • (⊤ : Submodule A A)] ↔ p - q ∈ J := by
    intro J p q
    rw [SModEq.sub_mem, Ideal.smul_eq_mul, Ideal.mul_top]
  have hLex : ∀ t, ∃ L : A, ∀ n, a n t - L ∈ I ^ n := by
    intro t
    obtain ⟨L, hL⟩ := IsPrecomplete.prec hc.toIsPrecomplete (f := fun n => a n t)
      (fun {m n} hmn => by
        rw [hsmodA]
        have hneg := Submodule.neg_mem _ (hcauchy t m n hmn)
        rw [neg_sub] at hneg
        exact hneg)
    exact ⟨L, fun n => (hsmodA _ _ _).mp (hL n)⟩
  choose L hL using hLex
  have hres : ∀ n, x - ∑ t ∈ T, L t • t ∈ I ^ n • (⊤ : Submodule A M) := by
    intro n
    have e : x - ∑ t ∈ T, L t • t =
        (x - ∑ t ∈ T, a n t • t) + ∑ t ∈ T, (a n t - L t) • t := by
      simp only [sub_smul, Finset.sum_sub_distrib]
      abel
    rw [e]
    exact Submodule.add_mem _ (inv n)
      (Submodule.sum_mem _ (fun t _ => Submodule.smul_mem_smul (hL t n) Submodule.mem_top))
  have hx : x - ∑ t ∈ T, L t • t = 0 := by
    apply IsHausdorff.haus hH
    intro n
    rw [SModEq.sub_mem, sub_zero]
    exact hres n
  rw [sub_eq_zero.mp hx]
  exact Submodule.sum_mem _ (fun t ht =>
    Submodule.smul_mem _ _ (Submodule.subset_span (Finset.mem_coe.mpr ht)))

theorem wc_hnas_pfc_gcl_cf_span_mod_pow : ∀ (Λ : Type u) [CommRing Λ] (D : Type u) [CommRing D] [IsLocalRing D] [IsNoetherianRing D] [Algebra Λ D], Function.Surjective ((IsLocalRing.residue D).comp (algebraMap Λ D)) → ∀ N : ℕ, ∃ T : Finset D, Submodule.span Λ (T : Set D) ⊔ (IsLocalRing.maximalIdeal D ^ N).restrictScalars Λ = ⊤ :=
by
  classical
  intro Λ _ D _ _ _ _ hsurj N
  induction N with
  | zero =>
    refine ⟨∅, ?_⟩
    rw [pow_zero, Ideal.one_eq_top, Submodule.restrictScalars_top, sup_top_eq]
  | succ N ih =>
    obtain ⟨T, hT⟩ := ih
    obtain ⟨G, hG⟩ := IsNoetherian.noetherian (IsLocalRing.maximalIdeal D ^ N)
    refine ⟨T ∪ G, ?_⟩
    set P : Submodule Λ D := Submodule.span Λ ((T ∪ G : Finset D) : Set D) ⊔
      (IsLocalRing.maximalIdeal D ^ (N + 1)).restrictScalars Λ with hP
    have hTsub : Submodule.span Λ (T : Set D) ≤ Submodule.span Λ ((T ∪ G : Finset D) : Set D) :=
      Submodule.span_mono (by rw [Finset.coe_union]; exact Set.subset_union_left)
    have hGsub : ∀ g ∈ G, g ∈ Submodule.span Λ ((T ∪ G : Finset D) : Set D) := fun g hg =>
      Submodule.subset_span (by rw [Finset.coe_union]; exact Set.mem_union_right _ hg)
    have key : ∀ z ∈ Submodule.span D (G : Set D), ∀ d : D, d * z ∈ P := by
      intro z hz
      induction hz using Submodule.span_induction with
      | mem g hg =>
        intro d
        obtain ⟨l, hl⟩ := hsurj (IsLocalRing.residue D d)
        have hw : d - algebraMap Λ D l ∈ IsLocalRing.maximalIdeal D := by
          rw [← IsLocalRing.residue_eq_zero_iff, map_sub, sub_eq_zero]
          exact hl.symm
        have hgN : g ∈ IsLocalRing.maximalIdeal D ^ N := by
          rw [← hG]; exact Submodule.subset_span hg
        have h1 : (d - algebraMap Λ D l) * g ∈ IsLocalRing.maximalIdeal D ^ (N + 1) := by
          rw [pow_succ']; exact Ideal.mul_mem_mul hw hgN
        have h2 : l • g ∈ P := Submodule.mem_sup_left (Submodule.smul_mem _ l (hGsub g hg))
        have h3 : (d - algebraMap Λ D l) * g ∈ P :=
          Submodule.mem_sup_right (by simpa using h1)
        have he : d * g = l • g + (d - algebraMap Λ D l) * g := by
          rw [Algebra.smul_def]; ring
        rw [he]; exact P.add_mem h2 h3
      | zero => intro d; rw [mul_zero]; exact P.zero_mem
      | add x y _ _ hx hy => intro d; rw [mul_add]; exact P.add_mem (hx d) (hy d)
      | smul a x _ hx => intro d; rw [smul_eq_mul, ← mul_assoc]; exact hx (d * a)
    rw [Submodule.eq_top_iff']
    intro x
    have hx : x ∈ Submodule.span Λ (T : Set D) ⊔
        (IsLocalRing.maximalIdeal D ^ N).restrictScalars Λ := by
      rw [hT]; trivial
    obtain ⟨y, hy, z, hz, rfl⟩ := Submodule.mem_sup.mp hx
    have hz' : z ∈ Submodule.span D (G : Set D) := by
      rw [hG]; simpa using hz
    refine P.add_mem (Submodule.mem_sup_left (hTsub hy)) ?_
    simpa using key z hz' 1

theorem wc_hnas_pfc_gcl_cf_injective_of_dim : ∀ (A : Type u) [CommRing A] [IsDomain A] (D : Type u) [CommRing D] [IsDomain D] [Algebra A D], Module.Finite A D → ringKrullDim A ≤ ringKrullDim D → ringKrullDim A ≠ ⊤ → Function.Injective (algebraMap A D) :=
by
  intro A _ _ D _ _ _ hfin hle htop
  haveI : Algebra.IsIntegral A D := Algebra.IsIntegral.of_finite A D
  rw [injective_iff_map_eq_zero]
  intro a ha
  by_contra hne
  have hnzd : a ∈ nonZeroDivisors A := mem_nonZeroDivisors_of_ne_zero hne
  have h1 := ringKrullDim_quotient_succ_le_of_nonZeroDivisor hnzd
  have hI : Ideal.span {a} ≤ RingHom.ker (algebraMap A D) :=
    (Ideal.span_singleton_le_iff_mem _).mpr (RingHom.mem_ker.mpr ha)
  have h2 : ringKrullDim D ≤ ringKrullDim (A ⧸ Ideal.span {a}) := by
    rw [ringKrullDim_quotient]
    let f : PrimeSpectrum D → PrimeSpectrum.zeroLocus ((Ideal.span {a} : Ideal A) : Set A) :=
      fun Q => ⟨PrimeSpectrum.comap (algebraMap A D) Q, by
        rw [PrimeSpectrum.mem_zeroLocus]
        intro x hx
        have hx0 : algebraMap A D x = 0 := RingHom.mem_ker.mp (hI hx)
        show x ∈ Ideal.comap (algebraMap A D) Q.asIdeal
        rw [Ideal.mem_comap, hx0]
        exact zero_mem _⟩
    have hf : StrictMono f := by
      intro Q Q' hQ
      have hlt : Q.asIdeal < Q'.asIdeal := hQ
      obtain ⟨x, hx, hnx⟩ := SetLike.exists_of_lt hlt
      have key := Ideal.under_lt_under_of_integral_mem_sdiff (R := A) hlt.le
        (x := x) ⟨hx, hnx⟩ (Algebra.IsIntegral.isIntegral x)
      rw [Ideal.under_def, Ideal.under_def] at key
      exact key
    exact Order.krullDim_le_of_strictMono f hf
  have h0 : 0 ≤ ringKrullDim D := ringKrullDim_nonneg_of_nontrivial
  generalize ringKrullDim A = x at *
  generalize ringKrullDim D = y at *
  generalize ringKrullDim (A ⧸ Ideal.span {a}) = q at *
  induction q using WithBot.recBotCoe with
  | bot =>
    have : y = ⊥ := le_bot_iff.mp h2
    rw [this] at h0
    exact absurd h0 (by decide)
  | coe q =>
    induction q using ENat.recTopCoe with
    | top =>
      apply htop
      apply top_le_iff.mp
      refine le_trans ?_ h1
      rfl
    | coe n =>
      have h3 : ((n : ℕ∞) : WithBot ℕ∞) + 1 ≤ ((n : ℕ∞) : WithBot ℕ∞) := h1.trans (hle.trans h2)
      have h4 : ((n + 1 : ℕ) : WithBot ℕ∞) ≤ ((n : ℕ) : WithBot ℕ∞) := by exact_mod_cast h3
      have h5 : n + 1 ≤ n := by exact_mod_cast h4
      omega

theorem wc_hnas_pfc_gcl_cf_power_series_regular : ∀ (Λ : Type u) [CommRing Λ] [IsLocalRing Λ] [IsNoetherianRing Λ] [IsDomain Λ] (π : Λ), IsLocalRing.maximalIdeal Λ = Ideal.span {π} → ∀ (r : ℕ), IsDomain (MvPowerSeries (Fin r) Λ) ∧ IsRegularLocalRing (MvPowerSeries (Fin r) Λ) ∧ IsLocalRing.maximalIdeal (MvPowerSeries (Fin r) Λ) = Ideal.span (insert (MvPowerSeries.C π) (Set.range MvPowerSeries.X)) ∧ (π = 0 → ringKrullDim (MvPowerSeries (Fin r) Λ) ≤ (r : WithBot ℕ∞)) ∧ ringKrullDim (MvPowerSeries (Fin r) Λ) ≤ ((r + 1 : ℕ) : WithBot ℕ∞) :=
by
  intro Λ _ _ _ _ π hπ r
  classical
  haveI hloc : IsLocalRing (MvPowerSeries (Fin r) Λ) := MvPowerSeries.instIsLocalRing
  haveI hnoeth : IsNoetherianRing (MvPowerSeries (Fin r) Λ) := MvPowerSeries.isNoetherianRing Λ
  haveI hnt : Nontrivial (MvPowerSeries (Fin r) Λ) := MvPowerSeries.instNontrivial
  haveI hdom : IsDomain (MvPowerSeries (Fin r) Λ) := NoZeroDivisors.to_isDomain _

  have cond_add : ∀ (i : ℕ) (a b : Fin r →₀ ℕ),
      (∀ j : Fin r, (j : ℕ) < i → (a + b) j = 0) ↔
        ((∀ j : Fin r, (j : ℕ) < i → a j = 0) ∧ (∀ j : Fin r, (j : ℕ) < i → b j = 0)) := by
    intro i a b
    constructor
    · intro h
      refine ⟨fun j hj => ?_, fun j hj => ?_⟩
      · have := h j hj
        rw [Finsupp.add_apply] at this
        omega
      · have := h j hj
        rw [Finsupp.add_apply] at this
        omega
    · intro h j hj
      rw [Finsupp.add_apply, h.1 j hj, h.2 j hj]
  have trunc : ∀ i : ℕ, ∃ τ : MvPowerSeries (Fin r) Λ →+* MvPowerSeries (Fin r) Λ,
      ∀ (f : MvPowerSeries (Fin r) Λ) (e : Fin r →₀ ℕ), MvPowerSeries.coeff e (τ f) =
        if (∀ j : Fin r, (j : ℕ) < i → e j = 0) then MvPowerSeries.coeff e f else 0 := by
    intro i
    let T : MvPowerSeries (Fin r) Λ → MvPowerSeries (Fin r) Λ := fun f e =>
      if (∀ j : Fin r, (j : ℕ) < i → e j = 0) then MvPowerSeries.coeff e f else 0
    have hT : ∀ (f : MvPowerSeries (Fin r) Λ) (e : Fin r →₀ ℕ), MvPowerSeries.coeff e (T f) =
        if (∀ j : Fin r, (j : ℕ) < i → e j = 0) then MvPowerSeries.coeff e f else 0 :=
      fun f e => rfl
    refine ⟨{ toFun := T, map_one' := ?_, map_mul' := ?_, map_zero' := ?_, map_add' := ?_ }, hT⟩
    · ext e
      rw [hT, MvPowerSeries.coeff_one]
      by_cases hc : (∀ j : Fin r, (j : ℕ) < i → e j = 0)
      · rw [if_pos hc]
      · rw [if_neg hc]
        have : e ≠ 0 := by
          rintro rfl
          exact hc (fun j _ => rfl)
        rw [if_neg this]
    · intro f g
      ext e
      rw [hT, MvPowerSeries.coeff_mul, MvPowerSeries.coeff_mul]
      by_cases hc : (∀ j : Fin r, (j : ℕ) < i → e j = 0)
      · rw [if_pos hc]
        refine Finset.sum_congr rfl (fun p hp => ?_)
        have hpe : p.1 + p.2 = e := Finset.HasAntidiagonal.mem_antidiagonal.mp hp
        have hcp := (cond_add i p.1 p.2).mp (by rw [hpe]; exact hc)
        rw [hT, hT, if_pos hcp.1, if_pos hcp.2]
      · rw [if_neg hc]
        symm
        refine Finset.sum_eq_zero (fun p hp => ?_)
        have hpe : p.1 + p.2 = e := Finset.HasAntidiagonal.mem_antidiagonal.mp hp
        rw [hT, hT]
        by_cases h1 : (∀ j : Fin r, (j : ℕ) < i → p.1 j = 0)
        · by_cases h2 : (∀ j : Fin r, (j : ℕ) < i → p.2 j = 0)
          · exfalso
            apply hc
            rw [← hpe]
            exact (cond_add i p.1 p.2).mpr ⟨h1, h2⟩
          · rw [if_neg h2, mul_zero]
        · rw [if_neg h1, zero_mul]
    · ext e
      rw [hT, map_zero]
      split_ifs <;> rfl
    · intro f g
      ext e
      rw [hT, map_add, map_add, hT, hT]
      split_ifs <;> simp
  choose τ hτ using trunc
  have memP : ∀ (i : ℕ) (f : MvPowerSeries (Fin r) Λ), f ∈ RingHom.ker (τ i) ↔
      ∀ e : Fin r →₀ ℕ, (∀ j : Fin r, (j : ℕ) < i → e j = 0) → MvPowerSeries.coeff e f = 0 := by
    intro i f
    rw [RingHom.mem_ker]
    constructor
    · intro h e he
      have := hτ i f e
      rw [h, map_zero, if_pos he] at this
      exact this.symm
    · intro h
      ext e
      rw [hτ, map_zero]
      split_ifs with he
      · exact h e he
      · rfl
  have mono : ∀ i : ℕ, RingHom.ker (τ i) ≤ RingHom.ker (τ (i + 1)) := by
    intro i f hf
    rw [memP] at hf ⊢
    intro e he
    exact hf e (fun j hj => he j (by omega))
  have Xnot : ∀ k : Fin r, MvPowerSeries.X k ∉ RingHom.ker (τ (k : ℕ)) := by
    intro k hk
    rw [memP] at hk
    have h1 := hk (Finsupp.single k 1) (fun j hj => by
      apply Finsupp.single_eq_of_ne
      intro h
      rw [h] at hj
      omega)
    rw [MvPowerSeries.coeff_index_single_X, if_pos rfl] at h1
    exact one_ne_zero h1
  have Xin : ∀ k : Fin r, MvPowerSeries.X k ∈ RingHom.ker (τ ((k : ℕ) + 1)) := by
    intro k
    rw [memP]
    intro e he
    rw [MvPowerSeries.coeff_X, if_neg]
    intro h
    have := he k (by omega)
    rw [h, Finsupp.single_eq_same] at this
    exact one_ne_zero this

  let p : ℕ → PrimeSpectrum (MvPowerSeries (Fin r) Λ) := fun i =>
    ⟨RingHom.ker (τ i), RingHom.ker_isPrime _⟩
  have hlt : ∀ i : ℕ, i < r → p i < p (i + 1) := by
    intro i hi
    rw [← PrimeSpectrum.asIdeal_lt_asIdeal]
    show RingHom.ker (τ i) < RingHom.ker (τ (i + 1))
    rw [SetLike.lt_iff_le_and_exists]
    exact ⟨mono i, MvPowerSeries.X ⟨i, hi⟩, Xin ⟨i, hi⟩, Xnot ⟨i, hi⟩⟩
  let L : LTSeries (PrimeSpectrum (MvPowerSeries (Fin r) Λ)) :=
    LTSeries.mk r (fun m => p m.val) (by
      rw [Fin.strictMono_iff_lt_succ]
      intro k
      exact hlt k.val k.isLt)
  have hdim1 : (r : WithBot ℕ∞) ≤ ringKrullDim (MvPowerSeries (Fin r) Λ) :=
    Order.LTSeries.length_le_krullDim L
  have hπmem : π ∈ IsLocalRing.maximalIdeal Λ := by
    rw [hπ]; exact Ideal.mem_span_singleton_self π
  have hπnu : ¬ IsUnit π := (IsLocalRing.mem_maximalIdeal π).mp hπmem
  have hdim2 : π ≠ 0 → ((r + 1 : ℕ) : WithBot ℕ∞) ≤ ringKrullDim (MvPowerSeries (Fin r) Λ) := by
    intro hπ0
    let Q : PrimeSpectrum (MvPowerSeries (Fin r) Λ) :=
      ⟨IsLocalRing.maximalIdeal _, (IsLocalRing.maximalIdeal.isMaximal _).isPrime⟩
    have hPQ : L.last < Q := by
      show p r < Q
      rw [← PrimeSpectrum.asIdeal_lt_asIdeal]
      show RingHom.ker (τ r) < IsLocalRing.maximalIdeal _
      rw [SetLike.lt_iff_le_and_exists]
      refine ⟨?_, MvPowerSeries.C π, ?_, ?_⟩
      · intro f hf
        rw [memP] at hf
        have h0 : MvPowerSeries.constantCoeff f = 0 := by
          rw [← MvPowerSeries.coeff_zero_eq_constantCoeff_apply]
          exact hf 0 (fun j _ => rfl)
        rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff,
          MvPowerSeries.isUnit_iff_constantCoeff, h0]
        exact not_isUnit_zero
      · rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff,
          MvPowerSeries.isUnit_iff_constantCoeff, MvPowerSeries.constantCoeff_C]
        exact hπnu
      · rw [memP]
        intro h
        apply hπ0
        have := h 0 (fun j _ => rfl)
        rwa [MvPowerSeries.coeff_zero_C] at this
    have := Order.LTSeries.length_le_krullDim (L.snoc Q hPQ)
    rw [RelSeries.snoc_length] at this
    exact this

  have memX : ∀ f : MvPowerSeries (Fin r) Λ, MvPowerSeries.constantCoeff f = 0 →
      f ∈ Ideal.span (Set.range (MvPowerSeries.X : Fin r → MvPowerSeries (Fin r) Λ)) := by
    intro f hf
    have h0 : τ 0 f = f := by
      ext e
      rw [hτ, if_pos (fun j hj => absurd hj (Nat.not_lt_zero _))]
    have hr : τ r f = 0 := by
      rw [← RingHom.mem_ker, memP]
      intro e he
      have : e = 0 := by
        ext j
        exact he j j.isLt
      rw [this, MvPowerSeries.coeff_zero_eq_constantCoeff_apply, hf]
    have htel : f = ∑ i ∈ Finset.range r, (τ i f - τ (i + 1) f) := by
      rw [Finset.sum_range_sub' (fun i => τ i f) r, h0, hr, sub_zero]
    rw [htel]
    apply Ideal.sum_mem
    intro i hi
    have hi' : i < r := Finset.mem_range.mp hi
    have hdvd : MvPowerSeries.X (⟨i, hi'⟩ : Fin r) ∣ τ i f - τ (i + 1) f := by
      rw [MvPowerSeries.X_dvd_iff]
      intro m hm
      rw [map_sub, hτ, hτ]
      have hiff : (∀ j : Fin r, (j : ℕ) < i + 1 → m j = 0) ↔
          (∀ j : Fin r, (j : ℕ) < i → m j = 0) := by
        constructor
        · intro h j hj
          exact h j (by omega)
        · intro h j hj
          by_cases hji : (j : ℕ) < i
          · exact h j hji
          · have : j = ⟨i, hi'⟩ := Fin.ext (by simp only; omega)
            rw [this]
            exact hm
      by_cases hc : (∀ j : Fin r, (j : ℕ) < i → m j = 0)
      · rw [if_pos hc, if_pos (hiff.mpr hc), sub_self]
      · rw [if_neg hc, if_neg (fun h => hc (hiff.mp h)), sub_self]
    obtain ⟨g, hg⟩ := hdvd
    rw [hg]
    exact Ideal.mul_mem_right _ _ (Ideal.subset_span ⟨_, rfl⟩)

  have hM : IsLocalRing.maximalIdeal (MvPowerSeries (Fin r) Λ) =
      Ideal.span (insert (MvPowerSeries.C π) (Set.range MvPowerSeries.X)) := by
    apply le_antisymm
    · intro f hf
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff,
        MvPowerSeries.isUnit_iff_constantCoeff] at hf
      have hc : MvPowerSeries.constantCoeff f ∈ Ideal.span {π} := by
        rw [← hπ]
        exact hf
      obtain ⟨a, ha⟩ := Ideal.mem_span_singleton.mp hc
      have hsub : f - MvPowerSeries.C a * MvPowerSeries.C π ∈
          Ideal.span (Set.range (MvPowerSeries.X : Fin r → MvPowerSeries (Fin r) Λ)) := by
        apply memX
        rw [map_sub, map_mul, MvPowerSeries.constantCoeff_C, MvPowerSeries.constantCoeff_C, ha]
        ring
      have h1 : f = (f - MvPowerSeries.C a * MvPowerSeries.C π) +
          MvPowerSeries.C a * MvPowerSeries.C π := by ring
      rw [h1]
      refine Ideal.add_mem _ (Ideal.span_mono (Set.subset_insert _ _) hsub) ?_
      exact Ideal.mul_mem_left _ _ (Ideal.subset_span (Set.mem_insert _ _))
    · rw [Ideal.span_le]
      rintro g (rfl | ⟨k, rfl⟩)
      · refine (IsLocalRing.mem_maximalIdeal _).mpr ?_
        rw [mem_nonunits_iff, MvPowerSeries.isUnit_iff_constantCoeff,
          MvPowerSeries.constantCoeff_C]
        exact hπnu
      · refine (IsLocalRing.mem_maximalIdeal _).mpr ?_
        rw [mem_nonunits_iff, MvPowerSeries.isUnit_iff_constantCoeff,
          MvPowerSeries.constantCoeff_X]
        exact not_isUnit_zero

  have hXfin : (Set.range (MvPowerSeries.X : Fin r → MvPowerSeries (Fin r) Λ)).Finite :=
    Set.finite_range _
  have hXcard : (Set.range (MvPowerSeries.X : Fin r → MvPowerSeries (Fin r) Λ)).ncard ≤ r := by
    rw [← Set.image_univ]
    calc _ ≤ (Set.univ : Set (Fin r)).ncard := Set.ncard_image_le Set.finite_univ
      _ = r := by rw [Set.ncard_univ, Nat.card_fin]
  have hspan1 : Submodule.spanFinrank (IsLocalRing.maximalIdeal (MvPowerSeries (Fin r) Λ)) ≤
      r + 1 := by
    rw [hM]
    calc _ ≤ (insert (MvPowerSeries.C π)
          (Set.range (MvPowerSeries.X : Fin r → MvPowerSeries (Fin r) Λ))).ncard :=
          Submodule.spanFinrank_span_le_ncard_of_finite (hXfin.insert (MvPowerSeries.C π))
      _ ≤ (Set.range (MvPowerSeries.X : Fin r → MvPowerSeries (Fin r) Λ)).ncard + 1 :=
          Set.ncard_insert_le _ _
      _ ≤ r + 1 := by omega
  have hspan0 : π = 0 →
      Submodule.spanFinrank (IsLocalRing.maximalIdeal (MvPowerSeries (Fin r) Λ)) ≤ r := by
    intro h0
    rw [hM, h0, map_zero, Ideal.span_insert_zero]
    exact (Submodule.spanFinrank_span_le_ncard_of_finite hXfin).trans hXcard
  have hup : ringKrullDim (MvPowerSeries (Fin r) Λ) ≤
      (Submodule.spanFinrank (IsLocalRing.maximalIdeal (MvPowerSeries (Fin r) Λ)) : WithBot ℕ∞) :=
    ringKrullDim_le_spanFinrank_maximalIdeal _
  refine ⟨hdom, ?_, hM, ?_, ?_⟩
  · refine IsRegularLocalRing.mk (le_antisymm ?_ hup)
    by_cases h0 : π = 0
    · exact (Nat.mono_cast (hspan0 h0)).trans hdim1
    · exact (Nat.mono_cast hspan1).trans (hdim2 h0)
  · intro h0
    exact hup.trans (Nat.mono_cast (hspan0 h0))
  · exact hup.trans (Nat.mono_cast hspan1)

theorem wc_hnas_pfc_gcl_cf_power_series_complete : ∀ (Λ : Type u) [CommRing Λ] [IsLocalRing Λ] (π : Λ), IsLocalRing.maximalIdeal Λ = Ideal.span {π} → IsAdicComplete (IsLocalRing.maximalIdeal Λ) Λ → ∀ (r : ℕ), IsLocalRing.maximalIdeal (MvPowerSeries (Fin r) Λ) = Ideal.span (insert (MvPowerSeries.C π) (Set.range MvPowerSeries.X)) → IsAdicComplete (IsLocalRing.maximalIdeal (MvPowerSeries (Fin r) Λ)) (MvPowerSeries (Fin r) Λ) :=
by
  intro Λ _ _ π hm hc r hA
  classical
  rw [hm] at hc
  rw [hA]

  set J : Ideal (MvPowerSeries (Fin r) Λ) :=
    Ideal.span (insert (MvPowerSeries.C π) (Set.range MvPowerSeries.X)) with hJdef
  have hCJ : MvPowerSeries.C π ∈ J := Ideal.subset_span (Set.mem_insert _ _)
  have hXJ : ∀ i : Fin r, (MvPowerSeries.X i : MvPowerSeries (Fin r) Λ) ∈ J :=
    fun i => Ideal.subset_span (Set.mem_insert_of_mem _ ⟨i, rfl⟩)

  have s1 : ∀ g : MvPowerSeries (Fin r) Λ, ∃ q : Fin r → MvPowerSeries (Fin r) Λ,
      g = MvPowerSeries.C (MvPowerSeries.constantCoeff g) + ∑ i, MvPowerSeries.X i * q i ∧
      ∀ (i : Fin r) (e : Fin r →₀ ℕ), MvPowerSeries.coeff e (q i) = 0 ∨
        MvPowerSeries.coeff e (q i) = MvPowerSeries.coeff (e + Finsupp.single i 1) g := by
    intro g
    let q : Fin r → MvPowerSeries (Fin r) Λ := fun i =>
      (fun e => if (∀ j < i, e j = 0) then MvPowerSeries.coeff (e + Finsupp.single i 1) g else 0 :
        (Fin r →₀ ℕ) → Λ)
    have hqc : ∀ i e, MvPowerSeries.coeff e (q i) =
        if (∀ j < i, e j = 0) then MvPowerSeries.coeff (e + Finsupp.single i 1) g else 0 :=
      fun _ _ => rfl
    refine ⟨q, ?_, ?_⟩
    · refine MvPowerSeries.ext fun e => ?_
      rw [map_add, map_sum, MvPowerSeries.coeff_C]
      simp_rw [MvPowerSeries.X_def, MvPowerSeries.coeff_monomial_mul, hqc, one_mul]
      by_cases he : e = 0
      · subst he
        rw [if_pos rfl, MvPowerSeries.coeff_zero_eq_constantCoeff_apply, Finset.sum_eq_zero, add_zero]
        intro i _
        rw [if_neg]
        rw [Finsupp.single_le_iff]
        simp
      · rw [if_neg he, zero_add]
        have hne : e.support.Nonempty := Finsupp.support_nonempty_iff.mpr he
        have hi0mem : e.support.min' hne ∈ e.support := Finset.min'_mem _ _
        have hmin : ∀ j, e j ≠ 0 → e.support.min' hne ≤ j :=
          fun j hj => Finset.min'_le _ _ (Finsupp.mem_support_iff.mpr hj)
        generalize e.support.min' hne = i0 at hi0mem hmin
        rw [Finset.sum_eq_single i0]
        · have hle : Finsupp.single i0 1 ≤ e := by
            rw [Finsupp.single_le_iff]
            exact Nat.one_le_iff_ne_zero.mpr (Finsupp.mem_support_iff.mp hi0mem)
          rw [if_pos hle, if_pos, tsub_add_cancel_of_le hle]
          intro j hj
          rw [Finsupp.tsub_apply, Finsupp.single_apply, if_neg hj.ne', Nat.sub_zero]
          by_contra hc'
          exact absurd (hmin j hc') (not_le.mpr hj)
        · intro i _ hi
          by_cases h1 : Finsupp.single i 1 ≤ e
          · rw [if_pos h1]
            have hei : e i ≠ 0 := by
              rw [Finsupp.single_le_iff] at h1
              omega
            have hlt : i0 < i := lt_of_le_of_ne (hmin i hei) (Ne.symm hi)
            rw [if_neg]
            intro h2
            have h3 := h2 i0 hlt
            rw [Finsupp.tsub_apply, Finsupp.single_apply, if_neg hi, Nat.sub_zero] at h3
            exact (Finsupp.mem_support_iff.mp hi0mem) h3
          · rw [if_neg h1]
        · intro h
          exact absurd (Finset.mem_univ i0) h
    · intro i e
      rw [hqc]
      split_ifs
      · right; rfl
      · left; rfl

  let I : ℕ → Ideal (MvPowerSeries (Fin r) Λ) := fun n =>
    { carrier := {g | ∀ e : Fin r →₀ ℕ,
          MvPowerSeries.coeff e g ∈ Ideal.span {π ^ (n - Finsupp.degree e)}}
      add_mem' := fun {a b} ha hb e => by
        rw [map_add]
        exact add_mem (ha e) (hb e)
      zero_mem' := fun e => by
        rw [map_zero]
        exact zero_mem _
      smul_mem' := fun c x hx e => by
        rw [smul_eq_mul, MvPowerSeries.coeff_mul]
        refine Ideal.sum_mem _ fun p hp => ?_
        have hp' : p.2 ≤ e := by
          rw [Finset.HasAntidiagonal.mem_antidiagonal] at hp
          rw [← hp]
          exact le_add_self
        have hdeg : Finsupp.degree p.2 ≤ Finsupp.degree e := Finsupp.degree_mono hp'
        refine Ideal.mul_mem_left _ _ ?_
        have := hx p.2
        rw [Ideal.mem_span_singleton] at this ⊢
        exact (pow_dvd_pow π (by omega)).trans this }
  have hI : ∀ n g, g ∈ I n ↔ ∀ e : Fin r →₀ ℕ,
      MvPowerSeries.coeff e g ∈ Ideal.span {π ^ (n - Finsupp.degree e)} := fun _ _ => Iff.rfl
  have s2 : ∀ n, J ^ n ≤ I n := by
    intro n
    induction n with
    | zero =>
      intro x _
      rw [hI]
      intro e
      rw [Nat.zero_sub, pow_zero, Ideal.span_singleton_one]
      exact Submodule.mem_top
    | succ n ih =>
      rw [pow_succ, Ideal.mul_le]
      intro x hx y hy
      have hxI := (hI n x).1 (ih hx)
      induction hy using Submodule.span_induction with
      | mem y hy =>
        rcases hy with rfl | ⟨i, rfl⟩
        · rw [hI]
          intro e
          rw [MvPowerSeries.coeff_mul_C]
          have := hxI e
          rw [Ideal.mem_span_singleton] at this ⊢
          calc π ^ (n + 1 - Finsupp.degree e) ∣ π ^ (n - Finsupp.degree e) * π := by
                rw [← pow_succ]
                exact pow_dvd_pow π (by omega)
            _ ∣ _ := mul_dvd_mul_right this π
        · rw [hI]
          intro e
          rw [MvPowerSeries.X_def, MvPowerSeries.coeff_mul_monomial]
          split_ifs with h
          · rw [mul_one]
            have := hxI (e - Finsupp.single i 1)
            have hdeg : Finsupp.degree e = Finsupp.degree (e - Finsupp.single i 1) + 1 := by
              conv_lhs => rw [← tsub_add_cancel_of_le h]
              rw [map_add, Finsupp.degree_single]
            rw [hdeg]
            rwa [show n + 1 - (Finsupp.degree (e - Finsupp.single i 1) + 1)
              = n - Finsupp.degree (e - Finsupp.single i 1) by omega]
          · exact zero_mem _
      | zero =>
        rw [mul_zero]
        exact zero_mem _
      | add y z _ _ hy hz =>
        rw [mul_add]
        exact add_mem hy hz
      | smul a y _ hy =>
        rw [smul_eq_mul, mul_left_comm]
        exact Ideal.mul_mem_left _ a hy

  have s3 : ∀ n (g : MvPowerSeries (Fin r) Λ), (∀ e : Fin r →₀ ℕ,
      MvPowerSeries.coeff e g ∈ Ideal.span {π ^ (n - Finsupp.degree e)}) → g ∈ J ^ n := by
    intro n
    induction n with
    | zero =>
      intro g _
      rw [pow_zero, Ideal.one_eq_top]
      exact Submodule.mem_top
    | succ n ih =>
      intro g hg
      obtain ⟨q, hq, hq'⟩ := s1 g
      rw [hq]
      refine add_mem ?_ (Ideal.sum_mem _ fun i _ => ?_)
      · have h0 := hg 0
        rw [map_zero, Nat.sub_zero, MvPowerSeries.coeff_zero_eq_constantCoeff_apply,
          Ideal.mem_span_singleton'] at h0
        obtain ⟨a, ha⟩ := h0
        rw [← ha, map_mul, map_pow]
        exact Ideal.mul_mem_left _ _ (Ideal.pow_mem_pow hCJ _)
      · rw [pow_succ']
        refine Ideal.mul_mem_mul (hXJ i) (ih _ fun e => ?_)
        rcases hq' i e with h | h
        · rw [h]
          exact zero_mem _
        · rw [h]
          have := hg (e + Finsupp.single i 1)
          rwa [map_add, Finsupp.degree_single, Nat.add_sub_add_right] at this
  have hJ : ∀ (n : ℕ) (g : MvPowerSeries (Fin r) Λ), g ∈ J ^ n ↔ ∀ e : Fin r →₀ ℕ,
      MvPowerSeries.coeff e g ∈ Ideal.span {π ^ (n - Finsupp.degree e)} :=
    fun n g => ⟨fun h => (hI n g).1 (s2 n h), s3 n g⟩

  have hΛ : ∀ (k : ℕ) (a : Λ), a ∈ (Ideal.span {π} ^ k • ⊤ : Submodule Λ Λ) ↔
      a ∈ Ideal.span {π ^ k} := by
    intro k a
    rw [Ideal.smul_eq_mul, Ideal.mul_top, Ideal.span_singleton_pow]
  have hAJ : ∀ (n : ℕ) (g : MvPowerSeries (Fin r) Λ),
      g ∈ (J ^ n • ⊤ : Submodule (MvPowerSeries (Fin r) Λ) (MvPowerSeries (Fin r) Λ)) ↔
        g ∈ J ^ n := by
    intro n g
    rw [Ideal.smul_eq_mul, Ideal.mul_top]
  have hH : IsHausdorff J (MvPowerSeries (Fin r) Λ) := by
    refine ⟨fun x hx => ?_⟩
    refine MvPowerSeries.ext fun e => ?_
    rw [map_zero]
    refine IsHausdorff.haus hc.toIsHausdorff _ fun k => ?_
    rw [SModEq.zero, hΛ]
    have := (hJ (k + Finsupp.degree e) x).1 ((hAJ _ x).1 (SModEq.zero.1 (hx _))) e
    rwa [Nat.add_sub_cancel] at this
  have hP : IsPrecomplete J (MvPowerSeries (Fin r) Λ) := by
    refine ⟨fun f hf => ?_⟩
    have hd : ∀ e : Fin r →₀ ℕ, ∃ L : Λ, ∀ k,
        MvPowerSeries.coeff e (f (k + Finsupp.degree e)) - L ∈ Ideal.span {π ^ k} := by
      intro e
      obtain ⟨L, hL⟩ := IsPrecomplete.prec hc.toIsPrecomplete
        (f := fun k => MvPowerSeries.coeff e (f (k + Finsupp.degree e))) (by
          intro m n hmn
          rw [SModEq.sub_mem, hΛ, ← map_sub]
          have := (hJ _ _).1 ((hAJ _ _).1
            (SModEq.sub_mem.1 (hf (Nat.add_le_add_right hmn (Finsupp.degree e))))) e
          rwa [Nat.add_sub_cancel] at this)
      refine ⟨L, fun k => ?_⟩
      have := hL k
      rw [SModEq.sub_mem, hΛ] at this
      exact this
    choose L hL using hd
    let Lp : MvPowerSeries (Fin r) Λ := L
    have hLc : ∀ e, MvPowerSeries.coeff e Lp = L e := fun _ => rfl
    refine ⟨Lp, fun n => ?_⟩
    rw [SModEq.sub_mem, hAJ, hJ]
    intro e
    rw [map_sub, hLc]
    by_cases hn : n ≤ Finsupp.degree e
    · rw [Nat.sub_eq_zero_of_le hn, pow_zero, Ideal.span_singleton_one]
      exact Submodule.mem_top
    · obtain ⟨k, rfl⟩ : ∃ k, n = k + Finsupp.degree e := ⟨n - Finsupp.degree e, by omega⟩
      rw [Nat.add_sub_cancel]
      exact hL e k
  exact @IsAdicComplete.mk _ _ _ _ _ _ hH hP

theorem wc_hnas_pfc_gcl_cf_normalization : (∀ (n : ℕ) (S : Type u) [CommRing S] [IsLocalRing S] [IsNoetherianRing S], ringKrullDim S ≤ (n : WithBot ℕ∞) → ∃ y : Fin n → S, (∀ i, y i ∈ IsLocalRing.maximalIdeal S) ∧ IsLocalRing.maximalIdeal S ≤ (Ideal.span (Set.range y)).radical) → (∀ (Λ : Type u) [CommRing Λ] (D : Type u) [CommRing D] [IsLocalRing D] [Algebra Λ D], IsAdicComplete (IsLocalRing.maximalIdeal D) D → ∀ (r : ℕ) (y : Fin r → D), (∀ i, y i ∈ IsLocalRing.maximalIdeal D) → ∃ Φ : MvPowerSeries (Fin r) Λ →ₐ[Λ] D, ∀ i, Φ (MvPowerSeries.X i) = y i) → (∀ (A : Type u) [CommRing A] (I : Ideal A), IsAdicComplete I A → ∀ (M : Type u) [AddCommGroup M] [Module A M], IsHausdorff I M → ∀ (T : Finset M), Submodule.span A (T : Set M) ⊔ I • (⊤ : Submodule A M) = ⊤ → Submodule.span A (T : Set M) = ⊤) → (∀ (Λ : Type u) [CommRing Λ] (D : Type u) [CommRing D] [IsLocalRing D] [IsNoetherianRing D] [Algebra Λ D], Function.Surjective ((IsLocalRing.residue D).comp (algebraMap Λ D)) → ∀ N : ℕ, ∃ T : Finset D, Submodule.span Λ (T : Set D) ⊔ (IsLocalRing.maximalIdeal D ^ N).restrictScalars Λ = ⊤) → (∀ (A : Type u) [CommRing A] [IsDomain A] (D : Type u) [CommRing D] [IsDomain D] [Algebra A D], Module.Finite A D → ringKrullDim A ≤ ringKrullDim D → ringKrullDim A ≠ ⊤ → Function.Injective (algebraMap A D)) → (∀ (Λ : Type u) [CommRing Λ] [IsLocalRing Λ] [IsNoetherianRing Λ] [IsDomain Λ] (π : Λ), IsLocalRing.maximalIdeal Λ = Ideal.span {π} → ∀ (r : ℕ), IsDomain (MvPowerSeries (Fin r) Λ) ∧ IsRegularLocalRing (MvPowerSeries (Fin r) Λ) ∧ IsLocalRing.maximalIdeal (MvPowerSeries (Fin r) Λ) = Ideal.span (insert (MvPowerSeries.C π) (Set.range MvPowerSeries.X)) ∧ (π = 0 → ringKrullDim (MvPowerSeries (Fin r) Λ) ≤ (r : WithBot ℕ∞)) ∧ ringKrullDim (MvPowerSeries (Fin r) Λ) ≤ ((r + 1 : ℕ) : WithBot ℕ∞)) → (∀ (Λ : Type u) [CommRing Λ] [IsLocalRing Λ] (π : Λ), IsLocalRing.maximalIdeal Λ = Ideal.span {π} → IsAdicComplete (IsLocalRing.maximalIdeal Λ) Λ → ∀ (r : ℕ), IsLocalRing.maximalIdeal (MvPowerSeries (Fin r) Λ) = Ideal.span (insert (MvPowerSeries.C π) (Set.range MvPowerSeries.X)) → IsAdicComplete (IsLocalRing.maximalIdeal (MvPowerSeries (Fin r) Λ)) (MvPowerSeries (Fin r) Λ)) → ∀ (Λ : Type u) [CommRing Λ] [IsLocalRing Λ] [IsNoetherianRing Λ] [IsDomain Λ] (D : Type u) [CommRing D] [IsLocalRing D] [IsNoetherianRing D] [IsDomain D] [Algebra Λ D], IsAdicComplete (IsLocalRing.maximalIdeal Λ) Λ → IsAdicComplete (IsLocalRing.maximalIdeal D) D → ∀ π : Λ, IsLocalRing.maximalIdeal Λ = Ideal.span {π} → Function.Surjective ((IsLocalRing.residue D).comp (algebraMap Λ D)) → algebraMap Λ D π ∈ IsLocalRing.maximalIdeal D → (algebraMap Λ D π = 0 → π = 0) → ∃ (r : ℕ) (_ : Algebra (MvPowerSeries (Fin r) Λ) D), IsDomain (MvPowerSeries (Fin r) Λ) ∧ IsRegularLocalRing (MvPowerSeries (Fin r) Λ) ∧ Function.Injective (algebraMap (MvPowerSeries (Fin r) Λ) D) ∧ Module.Finite (MvPowerSeries (Fin r) Λ) D :=
by
  intro P5 P6 P7 P8 P9 P10 P11 Λ _ _ _ _ D _ _ _ _ _ hΛc hD π hπ hsurj hπm hπ0

  have hdimNat : ∀ (S : Type u) [CommRing S] [IsLocalRing S] [IsNoetherianRing S],
      ∃ d : ℕ, ringKrullDim S = (d : WithBot ℕ∞) := by
    intro S _ _ _
    have h1 : ringKrullDim S < ⊤ := ringKrullDim_lt_top
    have h2 : 0 ≤ ringKrullDim S := ringKrullDim_nonneg_of_nontrivial
    have hbot : ringKrullDim S ≠ ⊥ := by
      intro h; rw [h] at h2; simp at h2
    obtain ⟨e, he⟩ := WithBot.ne_bot_iff_exists.mp hbot
    have hetop : e ≠ ⊤ := by
      rintro rfl; rw [← he] at h1; exact lt_irrefl _ h1
    obtain ⟨d, rfl⟩ := ENat.ne_top_iff_exists.mp hetop
    exact ⟨d, he.symm⟩
  set t := algebraMap Λ D π with ht

  have s1 : ∃ (r : ℕ) (y : Fin r → D), (∀ i, y i ∈ IsLocalRing.maximalIdeal D) ∧
      IsLocalRing.maximalIdeal D ≤ (Ideal.span (insert t (Set.range y))).radical ∧
      (t = 0 → (r : WithBot ℕ∞) ≤ ringKrullDim D) ∧
      (t ≠ 0 → ((r + 1 : ℕ) : WithBot ℕ∞) ≤ ringKrullDim D) := by
    obtain ⟨d, hd⟩ := hdimNat D
    by_cases ht0 : t = 0
    · obtain ⟨y, hy, hrad⟩ := P5 d D hd.le
      exact ⟨d, y, hy,
        hrad.trans (Ideal.radical_mono (Ideal.span_mono (Set.subset_insert t _))),
        fun _ => hd.ge, fun h => absurd ht0 h⟩
    · have htnz : t ∈ nonZeroDivisors D := mem_nonZeroDivisors_of_ne_zero ht0
      have hdrop := ringKrullDim_quotient_succ_le_of_nonZeroDivisor htnz
      have hne : Ideal.span {t} ≠ ⊤ := by
        rw [Ne, Ideal.span_singleton_eq_top]
        exact fun h => (IsLocalRing.notMem_maximalIdeal.mpr h) hπm
      haveI : Nontrivial (D ⧸ Ideal.span {t}) := Ideal.Quotient.nontrivial_iff.mpr hne
      haveI : IsLocalRing (D ⧸ Ideal.span {t}) :=
        IsLocalRing.of_surjective' (Ideal.Quotient.mk _) Ideal.Quotient.mk_surjective
      haveI : IsNoetherianRing (D ⧸ Ideal.span {t}) := Ideal.Quotient.isNoetherianRing _
      obtain ⟨q, hq⟩ := hdimNat (D ⧸ Ideal.span {t})
      rw [hq, hd] at hdrop
      have hqd : q + 1 ≤ d := by exact_mod_cast hdrop
      obtain ⟨r, rfl⟩ : ∃ r, d = r + 1 := ⟨d - 1, by omega⟩
      have hqr : ringKrullDim (D ⧸ Ideal.span {t}) ≤ (r : WithBot ℕ∞) := by
        rw [hq]; exact_mod_cast (by omega : q ≤ r)
      obtain ⟨yb, hyb, hradb⟩ := P5 r (D ⧸ Ideal.span {t}) hqr
      choose y hy using fun i => Ideal.Quotient.mk_surjective (yb i)
      have hyfun : (Ideal.Quotient.mk (Ideal.span {t})) ∘ y = yb := funext hy
      refine ⟨r, y, ?_, ?_, fun h => absurd h ht0, fun _ => hd.ge⟩
      · intro i
        by_contra h
        have hu := IsLocalRing.notMem_maximalIdeal.mp h
        have h3 := hyb i
        rw [← hy i] at h3
        exact IsLocalRing.notMem_maximalIdeal.mpr (hu.map _) h3
      · intro z hz
        have hmz : Ideal.Quotient.mk (Ideal.span {t}) z ∈
            IsLocalRing.maximalIdeal (D ⧸ Ideal.span {t}) := by
          rw [← IsLocalRing.map_maximalIdeal_of_surjective _ Ideal.Quotient.mk_surjective]
          exact Ideal.mem_map_of_mem _ hz
        obtain ⟨k, hk⟩ := hradb hmz
        rw [← hyfun, Set.range_comp, ← Ideal.map_span, ← map_pow,
          Ideal.mem_quotient_iff_mem_sup] at hk
        refine ⟨k, ?_⟩
        rw [Ideal.span_insert, sup_comm]
        exact hk
  obtain ⟨r, y, hy, hrad, hdim0, hdim1⟩ := s1

  obtain ⟨Φ, hX⟩ := P6 Λ D hD r y hy
  letI : Algebra (MvPowerSeries (Fin r) Λ) D := Φ.toRingHom.toAlgebra
  haveI : IsScalarTower Λ (MvPowerSeries (Fin r) Λ) D :=
    IsScalarTower.of_algebraMap_eq (fun x => (Φ.commutes x).symm)

  obtain ⟨hdom, hreg, hmA, hdimA0, hdimA1⟩ := P10 Λ π hπ r
  have e1 : algebraMap (MvPowerSeries (Fin r) Λ) D (MvPowerSeries.C π) = t := by
    rw [MvPowerSeries.c_eq_algebraMap]; exact Φ.commutes π
  have e2 : (⇑(algebraMap (MvPowerSeries (Fin r) Λ) D) ∘ MvPowerSeries.X) = y :=
    funext fun i => hX i
  have hmap : Ideal.map (algebraMap (MvPowerSeries (Fin r) Λ) D)
      (IsLocalRing.maximalIdeal (MvPowerSeries (Fin r) Λ)) =
      Ideal.span (insert t (Set.range y)) := by
    rw [hmA, Ideal.map_span, Set.image_insert_eq, ← Set.range_comp, e1, e2]
  have hJle : Ideal.span (insert t (Set.range y)) ≤ IsLocalRing.maximalIdeal D := by
    rw [Ideal.span_le]
    rintro z (rfl | ⟨i, rfl⟩)
    · exact hπm
    · exact hy i

  obtain ⟨N, hN⟩ := Ideal.exists_pow_le_of_le_radical_of_fg hrad
    (IsNoetherian.noetherian (IsLocalRing.maximalIdeal D))

  obtain ⟨T, hT⟩ := P8 Λ D hsurj N
  have hspan : Submodule.span (MvPowerSeries (Fin r) Λ) (T : Set D) ⊔
      (IsLocalRing.maximalIdeal (MvPowerSeries (Fin r) Λ)) •
        (⊤ : Submodule (MvPowerSeries (Fin r) Λ) D) = ⊤ := by
    rw [eq_top_iff]
    intro x _
    have hx : x ∈ Submodule.span Λ (T : Set D) ⊔
        (IsLocalRing.maximalIdeal D ^ N).restrictScalars Λ := by
      rw [hT]; trivial
    obtain ⟨a, ha, j, hj, rfl⟩ := Submodule.mem_sup.mp hx
    refine Submodule.add_mem_sup
      (Submodule.span_le_restrictScalars Λ (MvPowerSeries (Fin r) Λ) _ ha) ?_
    rw [Ideal.smul_top_eq_map]
    have hj' : j ∈ IsLocalRing.maximalIdeal D ^ N := hj
    have hj2 : j ∈ Ideal.map (algebraMap (MvPowerSeries (Fin r) Λ) D)
        (IsLocalRing.maximalIdeal (MvPowerSeries (Fin r) Λ)) := by
      rw [hmap]; exact hN hj'
    exact hj2
  have hHaus : IsHausdorff (IsLocalRing.maximalIdeal (MvPowerSeries (Fin r) Λ)) D := by
    refine ⟨fun x hx => ?_⟩
    apply IsHausdorff.haus hD.toIsHausdorff x
    intro n
    have h1 := hx n
    rw [SModEq.zero] at h1 ⊢
    rw [Ideal.smul_top_eq_map] at h1
    have h1' : x ∈ Ideal.map (algebraMap (MvPowerSeries (Fin r) Λ) D)
        (IsLocalRing.maximalIdeal (MvPowerSeries (Fin r) Λ) ^ n) := h1
    rw [Ideal.map_pow, hmap] at h1'
    have h2 := Ideal.pow_right_mono hJle n h1'
    rw [Ideal.smul_eq_mul, Ideal.mul_top]
    exact h2
  have hAc := P11 Λ π hπ hΛc r hmA
  have hTtop := P7 (MvPowerSeries (Fin r) Λ) (IsLocalRing.maximalIdeal (MvPowerSeries (Fin r) Λ))
    hAc D hHaus T hspan
  have hfin : Module.Finite (MvPowerSeries (Fin r) Λ) D := ⟨⟨T, hTtop⟩⟩

  haveI := hdom
  have hle : ringKrullDim (MvPowerSeries (Fin r) Λ) ≤ ringKrullDim D := by
    by_cases ht0 : t = 0
    · exact (hdimA0 (hπ0 ht0)).trans (hdim0 ht0)
    · exact hdimA1.trans (hdim1 ht0)
  have hcast : ((r + 1 : ℕ) : WithBot ℕ∞) ≠ ⊤ := by
    intro h
    have h2 : (((r + 1 : ℕ) : ℕ∞) : WithBot ℕ∞) = ((⊤ : ℕ∞) : WithBot ℕ∞) := h
    exact ENat.natCast_ne_top _ (WithBot.coe_injective h2)
  have hnt : ringKrullDim (MvPowerSeries (Fin r) Λ) ≠ ⊤ := ne_top_of_le_ne_top hcast hdimA1
  have hinj := P9 (MvPowerSeries (Fin r) Λ) D hfin hle hnt
  exact ⟨r, Φ.toRingHom.toAlgebra, hdom, hreg, hinj, hfin⟩

theorem wc_hnas_pfc_gcl_cf_coeff_field_char_p : ∀ (p : ℕ), p.Prime → ∀ (Λ : Type u) [CommRing Λ] [IsLocalRing Λ], IsLocalRing.maximalIdeal Λ = Ideal.span {(p : Λ)} → ∀ (D : Type u) [CommRing D] [IsLocalRing D], (p : D) = 0 → ∀ (φ : Λ →+* D) (σ : IsLocalRing.ResidueField Λ →+* IsLocalRing.ResidueField D), Function.Surjective σ → (IsLocalRing.residue D).comp φ = σ.comp (IsLocalRing.residue Λ) → ∃ (k : Type u) (_ : Field k) (_ : CharP k p) (_ : Algebra k D), Function.Surjective ((IsLocalRing.residue D).comp (algebraMap k D)) :=
by
  intro p hp Λ _ _ hm D _ _ hpD φ σ hσ hcomm
  have hker : ∀ a ∈ IsLocalRing.maximalIdeal Λ, φ a = 0 := by
    intro a ha
    rw [hm, Ideal.mem_span_singleton] at ha
    obtain ⟨c, rfl⟩ := ha
    rw [map_mul, map_natCast, hpD, zero_mul]
  let ψ : IsLocalRing.ResidueField Λ →+* D :=
    Ideal.Quotient.lift (IsLocalRing.maximalIdeal Λ) φ hker
  have hψ : ∀ a, ψ (IsLocalRing.residue Λ a) = φ a := fun a =>
    Ideal.Quotient.lift_mk _ _ _
  have hpκ : ((p : ℕ) : IsLocalRing.ResidueField Λ) = 0 := by
    rw [← map_natCast (IsLocalRing.residue Λ) p, IsLocalRing.residue_eq_zero_iff, hm]
    exact Ideal.mem_span_singleton_self _
  have hchar : CharP (IsLocalRing.ResidueField Λ) p :=
    (CharP.charP_iff_prime_eq_zero hp).mpr hpκ
  letI : Algebra (IsLocalRing.ResidueField Λ) D := ψ.toAlgebra
  refine ⟨IsLocalRing.ResidueField Λ, inferInstance, hchar, this, ?_⟩
  intro z
  obtain ⟨w, rfl⟩ := hσ z
  obtain ⟨a, rfl⟩ := IsLocalRing.residue_surjective w
  refine ⟨IsLocalRing.residue Λ a, ?_⟩
  change IsLocalRing.residue D (ψ (IsLocalRing.residue Λ a)) = σ (IsLocalRing.residue Λ a)
  rw [hψ]
  exact RingHom.congr_fun hcomm a

theorem wc_hnas_pfc_gcl_cohen_finite : ∀ (D : Type u) [CommRing D] [IsLocalRing D] [IsNoetherianRing D] [IsDomain D], IsAdicComplete (IsLocalRing.maximalIdeal D) D → (∃ (A : Type u) (_ : CommRing A) (_ : IsLocalRing A) (_ : IsNoetherianRing A) (_ : Algebra A D), IsDomain A ∧ IsRegularLocalRing A ∧ Function.Injective (algebraMap A D) ∧ Module.Finite A D ∧ ∀ m : ℕ, m ≠ 0 → (m : D) ≠ 0) ∨ (∃ (p n : ℕ) (k : Type u) (_ : Field k) (_ : CharP k p) (_ : Algebra (MvPowerSeries (Fin n) k) D), p.Prime ∧ IsNoetherianRing (MvPowerSeries (Fin n) k) ∧ IsDomain (MvPowerSeries (Fin n) k) ∧ IsRegularLocalRing (MvPowerSeries (Fin n) k) ∧ Function.Injective (algebraMap (MvPowerSeries (Fin n) k) D) ∧ Module.Finite (MvPowerSeries (Fin n) k) D) :=
by
  intro D _ _ _ _ hD

  have N := wc_hnas_pfc_gcl_cf_normalization wc_hnas_pfc_gcl_cf_system_of_parameters
    wc_hnas_pfc_gcl_cf_power_series_eval wc_hnas_pfc_gcl_cf_complete_nakayama
    wc_hnas_pfc_gcl_cf_span_mod_pow wc_hnas_pfc_gcl_cf_injective_of_dim
    wc_hnas_pfc_gcl_cf_power_series_regular wc_hnas_pfc_gcl_cf_power_series_complete

  have F : ∀ (k : Type u) [Field k] [Algebra k D],
      Function.Surjective ((IsLocalRing.residue D).comp (algebraMap k D)) →
      ∃ (r : ℕ) (_ : Algebra (MvPowerSeries (Fin r) k) D), IsDomain (MvPowerSeries (Fin r) k) ∧
        IsRegularLocalRing (MvPowerSeries (Fin r) k) ∧
        Function.Injective (algebraMap (MvPowerSeries (Fin r) k) D) ∧
        Module.Finite (MvPowerSeries (Fin r) k) D := by
    intro k _ _ hsurj
    have hm : IsLocalRing.maximalIdeal k = Ideal.span {(0 : k)} := by
      rw [IsLocalRing.maximalIdeal_eq_bot, eq_comm, Ideal.span_singleton_eq_bot]
    have hc : IsAdicComplete (IsLocalRing.maximalIdeal k) k := by
      rw [IsLocalRing.maximalIdeal_eq_bot]
      exact IsAdicComplete.bot k
    exact N k D hc hD 0 hm hsurj (by rw [map_zero]; exact zero_mem _) (fun _ => rfl)
  by_cases H : ∀ m : ℕ, m ≠ 0 → (m : IsLocalRing.ResidueField D) ≠ 0
  ·
    left
    have hD0 : ∀ m : ℕ, m ≠ 0 → (m : D) ≠ 0 := by
      intro m hm h
      apply H m hm
      rw [← map_natCast (IsLocalRing.residue D) m, h, map_zero]
    obtain ⟨k, fk, ak, hsurj⟩ := wc_hnas_pfc_gcl_cf_coeff_field_char_zero D hD H
    obtain ⟨r, aA, hdom, hreg, hinj, hfin⟩ := F k hsurj
    exact ⟨MvPowerSeries (Fin r) k, inferInstance, inferInstance,
      MvPowerSeries.isNoetherianRing k, aA, hdom, hreg, hinj, hfin, hD0⟩
  ·
    push_neg at H
    obtain ⟨m, hm0, hm⟩ := H
    obtain ⟨p, hcp⟩ : ∃ p, CharP (IsLocalRing.ResidueField D) p := ⟨_, ringChar.charP _⟩
    have hpdvd : p ∣ m := (CharP.cast_eq_zero_iff (IsLocalRing.ResidueField D) p m).mp hm
    have hp0 : p ≠ 0 := by
      rintro rfl
      exact hm0 (zero_dvd_iff.mp hpdvd)
    have hpp : p.Prime := by
      haveI : NeZero p := ⟨hp0⟩
      exact (CharP.char_is_prime_of_pos (IsLocalRing.ResidueField D) p).out
    have hpm : (p : D) ∈ IsLocalRing.maximalIdeal D := by
      rw [← IsLocalRing.residue_eq_zero_iff, map_natCast]
      exact CharP.cast_eq_zero _ p
    obtain ⟨S, iS, lS, nS, hSdom, hSm, hSp, ⟨e₁⟩⟩ :=
      wc_hnas_pfc_gcl_cf_unramified_dvr_exists p hpp (IsLocalRing.ResidueField D)
    haveI := hSdom
    obtain ⟨Λ, iΛ, lΛ, nΛ, hΛdom, hΛc, hΛm, hΛp, ⟨e₂⟩⟩ :=
      wc_hnas_pfc_gcl_cf_complete_unramified p hpp S hSm hSp
    haveI := hΛdom
    let σ : IsLocalRing.ResidueField Λ →+* IsLocalRing.ResidueField D := (e₂.trans e₁).toRingHom
    have hσ : Function.Surjective σ := (e₂.trans e₁).surjective
    obtain ⟨φ, hφ⟩ := wc_hnas_pfc_gcl_cf_cohen_ring_lift p hpp Λ hΛc hΛm hΛp D hD σ
    by_cases hpD : (p : D) = 0
    ·
      right
      obtain ⟨k, fk, ck, ak, hsurj⟩ :=
        wc_hnas_pfc_gcl_cf_coeff_field_char_p p hpp Λ hΛm D hpD φ σ hσ hφ
      obtain ⟨r, aA, hdom, hreg, hinj, hfin⟩ := F k hsurj
      exact ⟨p, r, k, fk, ck, aA, hpp, MvPowerSeries.isNoetherianRing k, hdom, hreg, hinj, hfin⟩
    ·
      left
      letI : Algebra Λ D := φ.toAlgebra
      have hsurj : Function.Surjective ((IsLocalRing.residue D).comp (algebraMap Λ D)) := by
        change Function.Surjective ((IsLocalRing.residue D).comp φ)
        rw [hφ]
        exact hσ.comp IsLocalRing.residue_surjective
      have hφp : algebraMap Λ D (p : Λ) = (p : D) := map_natCast _ p
      obtain ⟨r, aA, hdom, hreg, hinj, hfin⟩ := N Λ D hΛc hD (p : Λ) hΛm hsurj
        (by rw [hφp]; exact hpm) (fun h => absurd (hφp.symm.trans h) hpD)
      have hD0 : ∀ m : ℕ, m ≠ 0 → (m : D) ≠ 0 := by
        intro m hm h
        obtain ⟨q, hcq⟩ : ∃ q, CharP D q := ⟨_, ringChar.charP _⟩
        have hqm : q ∣ m := (CharP.cast_eq_zero_iff D q m).mp h
        have hq0 : q ≠ 0 := by
          rintro rfl
          exact hm (zero_dvd_iff.mp hqm)
        have hqp : q.Prime := by
          haveI : NeZero q := ⟨hq0⟩
          exact (CharP.char_is_prime_of_pos D q).out
        have hqκ : (q : IsLocalRing.ResidueField D) = 0 := by
          rw [← map_natCast (IsLocalRing.residue D), CharP.cast_eq_zero, map_zero]
        have hpq : p ∣ q := (CharP.cast_eq_zero_iff _ p q).mp hqκ
        have hpq' : p = q := (Nat.prime_dvd_prime_iff_eq hpp hqp).mp hpq
        apply hpD
        rw [hpq']
        exact CharP.cast_eq_zero D q
      exact ⟨MvPowerSeries (Fin r) Λ, inferInstance, inferInstance,
        MvPowerSeries.isNoetherianRing Λ, aA, hdom, hreg, hinj, hfin, hD0⟩

theorem wc_hnas_pfc_gcl_finite_completion_tensor : ∀ (A : Type u) [CommRing A] [IsNoetherianRing A] (B : Type u) [CommRing B] [Algebra A B], Module.Finite A B → ∀ (𝔪 : Ideal A) [𝔪.IsPrime], Nonempty (TensorProduct A B (AdicCompletion (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔪)) (Localization.AtPrime 𝔪)) ≃ₐ[B] AdicCompletion (Ideal.map (algebraMap A (Localization (Algebra.algebraMapSubmonoid B 𝔪.primeCompl))) 𝔪) (Localization (Algebra.algebraMapSubmonoid B 𝔪.primeCompl))) :=
by
  intro A _ _ B _ _ hfin 𝔪 _
  classical

  have bridge : ∀ {R : Type u} [CommRing R] (J : Ideal R) (n : ℕ) (x : AdicCompletion J R) (r : R),
      x.val n = Submodule.Quotient.mk r → AdicCompletion.evalₐ J n x = Ideal.Quotient.mk (J ^ n) r := by
    intro R _ J n x r h
    obtain ⟨f, rfl⟩ := AdicCompletion.mk_surjective J R x
    rw [AdicCompletion.evalₐ_mk]
    rw [AdicCompletion.mk_apply_coe, Submodule.mkQ_apply, Submodule.Quotient.eq] at h
    rw [Ideal.Quotient.eq]
    simpa [smul_eq_mul, Ideal.mul_top] using h
  have trunc : ∀ {X : Type u} [CommRing X] (I : Ideal X) {m k : ℕ} (hle : m ≤ k)
      (x : AdicCompletion I X),
      Ideal.Quotient.factorPow I hle (AdicCompletion.evalₐ I k x) =
        AdicCompletion.evalₐ I m x := by
    intro X _ I m k hle x
    obtain ⟨f, rfl⟩ := AdicCompletion.mk_surjective I X x
    rw [AdicCompletion.evalₐ_mk, AdicCompletion.evalₐ_mk]
    have h1 := AdicCompletion.AdicCauchySequence.mk_eq_mk (I := I) (M := X) hle f
    have h2 := (Submodule.Quotient.eq _).mp h1
    change Ideal.Quotient.mk (I ^ m) (f k) = Ideal.Quotient.mk (I ^ m) (f m)
    rw [Ideal.Quotient.eq]
    simpa [smul_eq_mul, Ideal.mul_top] using h2

  have cmap : ∀ (R : Type u) [CommRing R] (S : Type u) [CommRing S] [Algebra R S] (J : Ideal R)
      (K : Ideal S), Ideal.map (algebraMap R S) J = K →
      ∃ g : AdicCompletion J R →+* AdicCompletion K S,
        ∀ (n : ℕ) (x : AdicCompletion J R) (r : R),
          AdicCompletion.evalₐ J n x = Ideal.Quotient.mk _ r →
          AdicCompletion.evalₐ K n (g x) = Ideal.Quotient.mk _ (algebraMap R S r) := by
    intro R _ S _ _ J K hJK
    have hle : ∀ k, J ^ k ≤ Ideal.comap (algebraMap R S) (K ^ k) := fun k => by
      rw [← hJK, ← Ideal.map_pow]; exact Ideal.le_comap_map
    let ιb : ∀ k, R ⧸ J ^ k →+* S ⧸ K ^ k := fun k =>
      Ideal.quotientMap (K ^ k) (algebraMap R S) (hle k)
    refine ⟨AdicCompletion.liftRingHom K
      (fun k => (ιb k).comp (AdicCompletion.evalₐ J k).toRingHom) ?_, ?_⟩
    · intro m k hmk
      refine RingHom.ext fun x => ?_
      change Ideal.Quotient.factorPow K hmk (ιb k (AdicCompletion.evalₐ J k x)) =
        ιb m (AdicCompletion.evalₐ J m x)
      obtain ⟨a, ha⟩ := Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ J k x)
      rw [← trunc J hmk x, ← ha]
      rfl
    · intro n x r hx
      rw [AdicCompletion.evalₐ_liftRingHom]
      change ιb n (AdicCompletion.evalₐ J n x) = _
      rw [hx]
      rfl

  have restrict : ∀ (R : Type u) [CommRing R] (S : Type u) [CommRing S] [Algebra R S]
      (J : Ideal R) (K : Ideal S), Ideal.map (algebraMap R S) J = K →
      ∃ e : AdicCompletion J S →+ AdicCompletion K S, Function.Bijective e ∧
        ∀ (n : ℕ) (x : AdicCompletion J S) (s : S), x.val n = Submodule.Quotient.mk s →
          (e x).val n = Submodule.Quotient.mk s := by
    intro R _ S _ _ J K hJK
    have hsub : ∀ n, (J ^ n • ⊤ : Submodule R S) =
        (K ^ n • ⊤ : Submodule S S).restrictScalars R := by
      intro n
      rw [Ideal.smul_top_eq_map, Ideal.map_pow, hJK, smul_eq_mul, Ideal.mul_top]
    let q : ∀ n, (S ⧸ (J ^ n • ⊤ : Submodule R S)) ≃ₗ[R] (S ⧸ (K ^ n • ⊤ : Submodule S S)) :=
      fun n => (Submodule.quotEquivOfEq _ _ (hsub n)).trans
        (Submodule.Quotient.restrictScalarsEquiv R _)
    have hq : ∀ n s, q n (Submodule.Quotient.mk s) = Submodule.Quotient.mk s := fun n s => by
      simp only [q, LinearEquiv.trans_apply, Submodule.quotEquivOfEq_mk,
        Submodule.Quotient.restrictScalarsEquiv_mk]
    have hq' : ∀ n s, (q n).symm (Submodule.Quotient.mk s) = Submodule.Quotient.mk s :=
      fun n s => by rw [LinearEquiv.symm_apply_eq, hq]
    let F : AdicCompletion J S → AdicCompletion K S := fun x => ⟨fun n => q n (x.val n), by
      intro m n hmn
      obtain ⟨s, hs⟩ := Submodule.Quotient.mk_surjective _ (x.val n)
      have hm : x.val m = Submodule.Quotient.mk s := by
        rw [← AdicCompletion.transitionMap_comp_eval_apply J S hmn x, ← hs]
        rfl
      change AdicCompletion.transitionMap K S hmn (q n (x.val n)) = q m (x.val m)
      rw [← hs, hm, hq, hq]
      rfl⟩
    let G : AdicCompletion K S → AdicCompletion J S := fun x => ⟨fun n => (q n).symm (x.val n), by
      intro m n hmn
      obtain ⟨s, hs⟩ := Submodule.Quotient.mk_surjective _ (x.val n)
      have hm : x.val m = Submodule.Quotient.mk s := by
        rw [← AdicCompletion.transitionMap_comp_eval_apply K S hmn x, ← hs]
        rfl
      change AdicCompletion.transitionMap J S hmn ((q n).symm (x.val n)) = (q m).symm (x.val m)
      rw [← hs, hm, hq', hq']
      rfl⟩
    let e : AdicCompletion J S →+ AdicCompletion K S :=
      { toFun := F
        map_zero' := by
          apply AdicCompletion.ext
          intro n
          change q n ((0 : AdicCompletion J S).val n) = (0 : AdicCompletion K S).val n
          rw [show (0 : AdicCompletion J S).val n = 0 from rfl,
            show (0 : AdicCompletion K S).val n = 0 from rfl, map_zero]
        map_add' := by
          intro x y
          apply AdicCompletion.ext
          intro n
          change q n ((x + y).val n) = (F x + F y).val n
          rw [show (x + y).val n = x.val n + y.val n from rfl,
            show (F x + F y).val n = (F x).val n + (F y).val n from rfl, map_add] }
    refine ⟨e, ?_, ?_⟩
    · refine Function.bijective_iff_has_inverse.mpr ⟨G, ?_, ?_⟩
      · intro x
        apply AdicCompletion.ext
        intro n
        change (q n).symm (q n (x.val n)) = x.val n
        exact LinearEquiv.symm_apply_apply _ _
      · intro x
        apply AdicCompletion.ext
        intro n
        change q n ((q n).symm (x.val n)) = x.val n
        exact LinearEquiv.apply_symm_apply _ _
    · intro n x s hx
      change q n (x.val n) = _
      rw [hx, hq]

  haveI hTow : IsScalarTower A (Localization.AtPrime 𝔪)
      (Localization (Algebra.algebraMapSubmonoid B 𝔪.primeCompl)) := by
    apply IsScalarTower.of_algebraMap_eq'
    rw [RingHom.algebraMap_toAlgebra, IsLocalization.map_comp, ← IsScalarTower.algebraMap_eq]
  haveI hFin : Module.Finite (Localization.AtPrime 𝔪)
      (Localization (Algebra.algebraMapSubmonoid B 𝔪.primeCompl)) :=
    Module.Finite.of_isLocalization A B 𝔪.primeCompl
  have hMI : Ideal.map (algebraMap (Localization.AtPrime 𝔪)
      (Localization (Algebra.algebraMapSubmonoid B 𝔪.primeCompl)))
      (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔪)) =
      Ideal.map (algebraMap A (Localization (Algebra.algebraMapSubmonoid B 𝔪.primeCompl))) 𝔪 := by
    rw [← Localization.AtPrime.map_eq_maximalIdeal, Ideal.map_map,
      ← IsScalarTower.algebraMap_eq]
  obtain ⟨g₀, hg₀⟩ := cmap (Localization.AtPrime 𝔪)
    (Localization (Algebra.algebraMapSubmonoid B 𝔪.primeCompl))
    (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔪)) _ hMI
  obtain ⟨e₂, he₂bij, he₂⟩ := restrict (Localization.AtPrime 𝔪)
    (Localization (Algebra.algebraMapSubmonoid B 𝔪.primeCompl))
    (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔪)) _ hMI
  let g : AdicCompletion (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔪))
      (Localization.AtPrime 𝔪) →ₐ[A]
      AdicCompletion (Ideal.map (algebraMap A
        (Localization (Algebra.algebraMapSubmonoid B 𝔪.primeCompl))) 𝔪)
        (Localization (Algebra.algebraMapSubmonoid B 𝔪.primeCompl)) :=
    { g₀ with
      commutes' := by
        intro a
        apply AdicCompletion.ext_evalₐ
        intro n
        change AdicCompletion.evalₐ _ n (g₀ _) = _
        rw [hg₀ n _ (algebraMap A (Localization.AtPrime 𝔪) a)]
        · rw [AdicCompletion.algebraMap_apply, AdicCompletion.evalₐ_of,
            ← IsScalarTower.algebraMap_apply]
        · rw [AdicCompletion.algebraMap_apply, AdicCompletion.evalₐ_of] }
  let L := Algebra.TensorProduct.lift (Algebra.ofId B _) g (fun _ _ => Commute.all _ _)
  have hBC : IsBaseChange (Localization.AtPrime 𝔪)
      (IsScalarTower.toAlgHom A B (Localization (Algebra.algebraMapSubmonoid B 𝔪.primeCompl))).toLinearMap := by
    haveI : IsLocalizedModule 𝔪.primeCompl
        (IsScalarTower.toAlgHom A B (Localization (Algebra.algebraMapSubmonoid B 𝔪.primeCompl))).toLinearMap :=
      isLocalizedModule_iff_isLocalization.mpr inferInstance
    exact IsLocalizedModule.isBaseChange 𝔪.primeCompl (Localization.AtPrime 𝔪) _
  let E1 := TensorProduct.comm A B (AdicCompletion (IsLocalRing.maximalIdeal
      (Localization.AtPrime 𝔪)) (Localization.AtPrime 𝔪))
  let E2 := (TensorProduct.AlgebraTensorModule.cancelBaseChange A (Localization.AtPrime 𝔪)
      (Localization.AtPrime 𝔪) (AdicCompletion (IsLocalRing.maximalIdeal
      (Localization.AtPrime 𝔪)) (Localization.AtPrime 𝔪)) B).symm
  let E3 := LinearEquiv.lTensor (AdicCompletion (IsLocalRing.maximalIdeal
      (Localization.AtPrime 𝔪)) (Localization.AtPrime 𝔪)) hBC.equiv
  have he₄ : ∀ b x, E3 (E2 (E1 (TensorProduct.tmul A b x))) =
      TensorProduct.tmul (Localization.AtPrime 𝔪) x
        (algebraMap B (Localization (Algebra.algebraMapSubmonoid B 𝔪.primeCompl)) b) := by
    intro b x
    simp only [E1, E2, E3]
    rw [TensorProduct.comm_tmul,
      TensorProduct.AlgebraTensorModule.cancelBaseChange_symm_tmul, LinearEquiv.lTensor_tmul,
      IsBaseChange.equiv_tmul, one_smul]
    rfl
  let T := AdicCompletion.ofTensorProduct (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔪))
    (Localization (Algebra.algebraMapSubmonoid B 𝔪.primeCompl))
  have hTbij : Function.Bijective T :=
    AdicCompletion.ofTensorProduct_bijective_of_finite_of_isNoetherian _ _
  let Φ := e₂.comp (T.toAddMonoidHom.comp (E3.toLinearMap.toAddMonoidHom.comp
    (E2.toLinearMap.toAddMonoidHom.comp E1.toLinearMap.toAddMonoidHom)))
  have hΦ : ∀ z, Φ z = e₂ (T (E3 (E2 (E1 z)))) := fun z => rfl
  have hLΦ : ∀ z, L z = Φ z := by
    intro z
    induction z using TensorProduct.induction_on with
    | zero => rw [map_zero L, map_zero Φ]
    | tmul b x =>
      rw [hΦ]
      apply AdicCompletion.ext_evalₐ
      intro n
      obtain ⟨p, hp⟩ := Submodule.Quotient.mk_surjective _ (x.val n)
      have hT : (T (TensorProduct.tmul (Localization.AtPrime 𝔪) x
          (algebraMap B (Localization (Algebra.algebraMapSubmonoid B 𝔪.primeCompl)) b))).val n =
          Submodule.Quotient.mk (p • algebraMap B
            (Localization (Algebra.algebraMapSubmonoid B 𝔪.primeCompl)) b) := by
        simp only [T]
        rw [AdicCompletion.ofTensorProduct_tmul, AdicCompletion.smul_eval,
          AdicCompletion.of_apply, ← hp]
        rfl
      rw [he₄, bridge _ n _ _ (he₂ n _ _ hT)]
      simp only [L, Algebra.TensorProduct.lift_tmul, Algebra.ofId_apply, map_mul]
      change AdicCompletion.evalₐ _ n (algebraMap B _ b) * AdicCompletion.evalₐ _ n (g₀ x) = _
      rw [hg₀ n x p (bridge _ n x p hp.symm), AdicCompletion.algebraMap_apply,
        AdicCompletion.evalₐ_of, ← map_mul, Algebra.smul_def, mul_comm]
    | add x y hx hy =>
      rw [map_add L, map_add Φ, hx, hy]
  have hbij : Function.Bijective L := by
    have : ⇑L = fun z => e₂ (T (E3 (E2 (E1 z)))) := funext fun z => (hLΦ z).trans (hΦ z)
    rw [this]
    exact he₂bij.comp (hTbij.comp (E3.bijective.comp (E2.bijective.comp E1.bijective)))
  exact ⟨AlgEquiv.ofBijective L hbij⟩

theorem wc_hnas_pfc_gcl_semilocal_completion_split : ∀ (A : Type u) [CommRing A] [IsNoetherianRing A] (B : Type u) [CommRing B] [Algebra A B], Module.Finite A B → ∀ (𝔪 : Ideal A) [𝔪.IsPrime] (𝔫 : Ideal B) [𝔫.IsPrime], 𝔫.comap (algebraMap A B) = 𝔪 → ∃ (E : Type u) (_ : CommRing E) (_ : Algebra B E), Nonempty (AdicCompletion (Ideal.map (algebraMap A (Localization (Algebra.algebraMapSubmonoid B 𝔪.primeCompl))) 𝔪) (Localization (Algebra.algebraMapSubmonoid B 𝔪.primeCompl)) ≃ₐ[B] ((AdicCompletion (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔫)) (Localization.AtPrime 𝔫)) × E)) :=
by

  have T_trunc : ∀ {X : Type u} [CommRing X] (I : Ideal X) {m k : ℕ} (hle : m ≤ k)
      (x : AdicCompletion I X),
      Ideal.Quotient.factorPow I hle (AdicCompletion.evalₐ I k x) =
        AdicCompletion.evalₐ I m x := by
    intro X _ I m k hle x
    obtain ⟨f, rfl⟩ := AdicCompletion.mk_surjective I X x
    rw [AdicCompletion.evalₐ_mk, AdicCompletion.evalₐ_mk]
    have h1 := AdicCompletion.AdicCauchySequence.mk_eq_mk (I := I) (M := X) hle f
    have h2 := (Submodule.Quotient.eq _).mp h1
    change Ideal.Quotient.mk (I ^ m) (f k) = Ideal.Quotient.mk (I ^ m) (f m)
    rw [Ideal.Quotient.eq]
    simpa [smul_eq_mul, Ideal.mul_top] using h2
  have T_fp : ∀ {X : Type u} [CommRing X] (I : Ideal X) {m k : ℕ} (hle : m ≤ k) (c : X),
      Ideal.Quotient.factorPow I hle (Ideal.Quotient.mk (I ^ k) c) =
        Ideal.Quotient.mk (I ^ m) c := by
    intro X _ I m k hle c
    rfl
  have T_evalAlg : ∀ (R : Type u) [CommRing R] (C : Type u) [CommRing C] [Algebra R C]
      (I : Ideal C) (k : ℕ) (r : R),
      AdicCompletion.evalₐ I k (algebraMap R (AdicCompletion I C) r) =
        Ideal.Quotient.mk (I ^ k) (algebraMap R C r) := by
    intro R _ C _ _ I k r
    rw [AdicCompletion.algebraMap_apply, AdicCompletion.evalₐ_of]

  have s6 : ∀ (R : Type u) [CommRing R] (C : Type u) [CommRing C] [Algebra R C] (D : Type u) [CommRing D] [Algebra R D] (g : C →ₐ[R] D) (𝔐 : Ideal C) (𝔑 : Ideal D), Ideal.map g 𝔐 ≤ 𝔑 → (∀ (k : ℕ) (d : D), ∃ c : C, d - g c ∈ 𝔑 ^ k) → (∀ (k : ℕ) (c : C), g c ∈ 𝔑 ^ k → c ∈ 𝔐 ^ k) → Nonempty (AdicCompletion 𝔐 C ≃ₐ[R] AdicCompletion 𝔑 D) := by
    intro R _ C _ _ D _ _ g 𝔐 𝔑 hmap hdens hrefl
    have hmap' : Ideal.map (g : C →+* D) 𝔐 ≤ 𝔑 := hmap
    have hle : ∀ k, 𝔐 ^ k ≤ Ideal.comap (g : C →+* D) (𝔑 ^ k) := by
      intro k
      rw [← Ideal.map_le_iff_le_comap, Ideal.map_pow]
      exact Ideal.pow_right_mono hmap' k
    let gb : ∀ k, C ⧸ 𝔐 ^ k →+* D ⧸ 𝔑 ^ k := fun k =>
      Ideal.quotientMap (𝔑 ^ k) (g : C →+* D) (hle k)
    have hgb : ∀ k (c : C), gb k (Ideal.Quotient.mk _ c) = Ideal.Quotient.mk _ (g c) := by
      intro k c; exact Ideal.quotientMap_mk
    have hbij : ∀ k, Function.Bijective (gb k) := by
      intro k
      constructor
      · rw [injective_iff_map_eq_zero]
        intro z hz
        obtain ⟨c, rfl⟩ := Ideal.Quotient.mk_surjective z
        rw [hgb, Ideal.Quotient.eq_zero_iff_mem] at hz
        rw [Ideal.Quotient.eq_zero_iff_mem]
        exact hrefl k c hz
      · intro z
        obtain ⟨d, rfl⟩ := Ideal.Quotient.mk_surjective z
        obtain ⟨c, hc⟩ := hdens k d
        refine ⟨Ideal.Quotient.mk _ c, ?_⟩
        rw [hgb]
        exact (Ideal.Quotient.eq.mpr hc).symm
    let e : ∀ k, C ⧸ 𝔐 ^ k ≃+* D ⧸ 𝔑 ^ k := fun k => RingEquiv.ofBijective (gb k) (hbij k)
    have he : ∀ k z, e k z = gb k z := fun k z => rfl
    let Φ := AdicCompletion.liftRingHom 𝔑
      (fun k => (gb k).comp (AdicCompletion.evalₐ 𝔐 k).toRingHom) (by
        intro m k hmk
        refine RingHom.ext fun x => ?_
        change Ideal.Quotient.factorPow 𝔑 hmk (gb k (AdicCompletion.evalₐ 𝔐 k x)) =
          gb m (AdicCompletion.evalₐ 𝔐 m x)
        obtain ⟨a, ha⟩ := Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ 𝔐 k x)
        rw [← T_trunc 𝔐 hmk x, ← ha, hgb, T_fp, T_fp, hgb])
    let Ψ := AdicCompletion.liftRingHom 𝔐
      (fun k => (e k).symm.toRingHom.comp (AdicCompletion.evalₐ 𝔑 k).toRingHom) (by
        intro m k hmk
        refine RingHom.ext fun x => ?_
        change Ideal.Quotient.factorPow 𝔐 hmk ((e k).symm (AdicCompletion.evalₐ 𝔑 k x)) =
          (e m).symm (AdicCompletion.evalₐ 𝔑 m x)
        obtain ⟨c, hc⟩ := Ideal.Quotient.mk_surjective ((e k).symm (AdicCompletion.evalₐ 𝔑 k x))
        have h2 : gb k (Ideal.Quotient.mk _ c) = AdicCompletion.evalₐ 𝔑 k x := by
          rw [hc, ← he, RingEquiv.apply_symm_apply]
        rw [hgb] at h2
        rw [← hc, ← T_trunc 𝔑 hmk x, ← h2, T_fp, T_fp]
        apply (e m).injective
        rw [RingEquiv.apply_symm_apply, he, hgb])
    have hΦev : ∀ k x, AdicCompletion.evalₐ 𝔑 k (Φ x) = gb k (AdicCompletion.evalₐ 𝔐 k x) := by
      intro k x
      exact AdicCompletion.evalₐ_liftRingHom _ _ _ k x
    have hΨev : ∀ k x, AdicCompletion.evalₐ 𝔐 k (Ψ x) =
        (e k).symm (AdicCompletion.evalₐ 𝔑 k x) := by
      intro k x
      exact AdicCompletion.evalₐ_liftRingHom _ _ _ k x
    have h1 : Φ.comp Ψ = RingHom.id _ := by
      refine RingHom.ext fun x => ?_
      apply AdicCompletion.ext_evalₐ
      intro k
      rw [RingHom.comp_apply, hΦev, hΨev, ← he, RingEquiv.apply_symm_apply, RingHom.id_apply]
    have h2 : Ψ.comp Φ = RingHom.id _ := by
      refine RingHom.ext fun x => ?_
      apply AdicCompletion.ext_evalₐ
      intro k
      rw [RingHom.comp_apply, hΨev, hΦev, ← he, RingEquiv.symm_apply_apply, RingHom.id_apply]
    refine ⟨AlgEquiv.ofRingEquiv (f := RingEquiv.ofRingHom Φ Ψ h1 h2) ?_⟩
    intro r
    apply AdicCompletion.ext_evalₐ
    intro k
    change AdicCompletion.evalₐ 𝔑 k (Φ (algebraMap R _ r)) = _
    rw [hΦev, T_evalAlg, T_evalAlg, hgb, AlgHom.commutes]

  have s3 : ∀ (R : Type u) [CommRing R] (C : Type u) [CommRing C] [Algebra R C] (I J : Ideal C), I ≤ J → ∀ N : ℕ, J ^ N ≤ I → Nonempty (AdicCompletion I C ≃ₐ[R] AdicCompletion J C) := by
    intro R _ C _ _ I J hIJ N hN
    have hIJk : ∀ k, I ^ k ≤ J ^ k := fun k => Ideal.pow_right_mono hIJ k
    have hJI : ∀ k, J ^ ((N + 1) * k) ≤ I ^ k := by
      intro k
      rw [pow_mul]
      exact Ideal.pow_right_mono ((Ideal.pow_le_pow_right (Nat.le_succ N)).trans hN) k
    have hkK : ∀ k, k ≤ (N + 1) * k := fun k => Nat.le_mul_of_pos_left k (Nat.succ_pos N)
    let Φ := AdicCompletion.liftRingHom J
      (fun k => (Ideal.Quotient.factor (hIJk k)).comp (AdicCompletion.evalₐ I k).toRingHom) (by
        intro m k hmk
        refine RingHom.ext fun x => ?_
        change Ideal.Quotient.factorPow J hmk
            (Ideal.Quotient.factor (hIJk k) (AdicCompletion.evalₐ I k x)) =
          Ideal.Quotient.factor (hIJk m) (AdicCompletion.evalₐ I m x)
        obtain ⟨a, ha⟩ := Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ I k x)
        rw [← T_trunc I hmk x, ← ha, Ideal.Quotient.factor_mk, T_fp, T_fp,
          Ideal.Quotient.factor_mk])
    let Ψ := AdicCompletion.liftRingHom I
      (fun k => (Ideal.Quotient.factor (hJI k)).comp
        (AdicCompletion.evalₐ J ((N + 1) * k)).toRingHom) (by
        intro m k hmk
        refine RingHom.ext fun x => ?_
        change Ideal.Quotient.factorPow I hmk
            (Ideal.Quotient.factor (hJI k) (AdicCompletion.evalₐ J ((N + 1) * k) x)) =
          Ideal.Quotient.factor (hJI m) (AdicCompletion.evalₐ J ((N + 1) * m) x)
        obtain ⟨a, ha⟩ := Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ J ((N + 1) * k) x)
        rw [← T_trunc J (Nat.mul_le_mul_left (N + 1) hmk) x, ← ha, Ideal.Quotient.factor_mk,
          T_fp, T_fp, Ideal.Quotient.factor_mk])
    have hΦev : ∀ k x, AdicCompletion.evalₐ J k (Φ x) =
        Ideal.Quotient.factor (hIJk k) (AdicCompletion.evalₐ I k x) := by
      intro k x
      exact AdicCompletion.evalₐ_liftRingHom _ _ _ k x
    have hΨev : ∀ k x, AdicCompletion.evalₐ I k (Ψ x) =
        Ideal.Quotient.factor (hJI k) (AdicCompletion.evalₐ J ((N + 1) * k) x) := by
      intro k x
      exact AdicCompletion.evalₐ_liftRingHom _ _ _ k x
    have h1 : Φ.comp Ψ = RingHom.id _ := by
      refine RingHom.ext fun x => ?_
      apply AdicCompletion.ext_evalₐ
      intro k
      rw [RingHom.comp_apply, hΦev, hΨev, RingHom.id_apply]
      obtain ⟨a, ha⟩ := Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ J ((N + 1) * k) x)
      rw [← T_trunc J (hkK k) x, ← ha, Ideal.Quotient.factor_mk, Ideal.Quotient.factor_mk, T_fp]
    have h2 : Ψ.comp Φ = RingHom.id _ := by
      refine RingHom.ext fun x => ?_
      apply AdicCompletion.ext_evalₐ
      intro k
      rw [RingHom.comp_apply, hΨev, hΦev, RingHom.id_apply]
      obtain ⟨a, ha⟩ := Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ I ((N + 1) * k) x)
      rw [← T_trunc I (hkK k) x, ← ha, Ideal.Quotient.factor_mk, Ideal.Quotient.factor_mk, T_fp]
    refine ⟨AlgEquiv.ofRingEquiv (f := RingEquiv.ofRingHom Φ Ψ h1 h2) ?_⟩
    intro r
    apply AdicCompletion.ext_evalₐ
    intro k
    change AdicCompletion.evalₐ J k (Φ (algebraMap R _ r)) = _
    rw [hΦev, T_evalAlg, T_evalAlg, Ideal.Quotient.factor_mk]

  have s4 : ∀ (R : Type u) [CommRing R] (C : Type u) [CommRing C] [Algebra R C] (P Q : Ideal C), IsCoprime P Q → Nonempty (AdicCompletion (P * Q) C ≃ₐ[R] (AdicCompletion P C × AdicCompletion Q C)) := by
    intro R _ C _ _ P Q hPQ
    have cop : ∀ k, IsCoprime (P ^ k) (Q ^ k) := fun k => hPQ.pow
    have hk : ∀ k, (P * Q) ^ k = P ^ k ⊓ Q ^ k := by
      intro k
      rw [mul_pow, Ideal.mul_eq_inf_of_isCoprime (cop k)]
    have hP : ∀ k, (P * Q) ^ k ≤ P ^ k := fun k => Ideal.pow_right_mono Ideal.mul_le_left k
    have hQ : ∀ k, (P * Q) ^ k ≤ Q ^ k := fun k => Ideal.pow_right_mono Ideal.mul_le_right k
    let e : ∀ k, C ⧸ (P * Q) ^ k ≃+* (C ⧸ P ^ k) × (C ⧸ Q ^ k) := fun k =>
      (Ideal.quotEquivOfEq (hk k)).trans (Ideal.quotientInfEquivQuotientProd _ _ (cop k))
    have he : ∀ k (c : C), e k (Ideal.Quotient.mk _ c) =
        (Ideal.Quotient.mk _ c, Ideal.Quotient.mk _ c) := by
      intro k c
      rfl
    let Φ₁ := AdicCompletion.liftRingHom P
      (fun k => (Ideal.Quotient.factor (hP k)).comp (AdicCompletion.evalₐ (P * Q) k).toRingHom) (by
        intro m k hmk
        refine RingHom.ext fun x => ?_
        change Ideal.Quotient.factorPow P hmk
            (Ideal.Quotient.factor (hP k) (AdicCompletion.evalₐ (P * Q) k x)) =
          Ideal.Quotient.factor (hP m) (AdicCompletion.evalₐ (P * Q) m x)
        obtain ⟨a, ha⟩ := Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ (P * Q) k x)
        rw [← T_trunc (P * Q) hmk x, ← ha, Ideal.Quotient.factor_mk, T_fp, T_fp,
          Ideal.Quotient.factor_mk])
    let Φ₂ := AdicCompletion.liftRingHom Q
      (fun k => (Ideal.Quotient.factor (hQ k)).comp (AdicCompletion.evalₐ (P * Q) k).toRingHom) (by
        intro m k hmk
        refine RingHom.ext fun x => ?_
        change Ideal.Quotient.factorPow Q hmk
            (Ideal.Quotient.factor (hQ k) (AdicCompletion.evalₐ (P * Q) k x)) =
          Ideal.Quotient.factor (hQ m) (AdicCompletion.evalₐ (P * Q) m x)
        obtain ⟨a, ha⟩ := Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ (P * Q) k x)
        rw [← T_trunc (P * Q) hmk x, ← ha, Ideal.Quotient.factor_mk, T_fp, T_fp,
          Ideal.Quotient.factor_mk])
    let Φ := Φ₁.prod Φ₂
    let Ψ := AdicCompletion.liftRingHom (P * Q)
      (fun k => (e k).symm.toRingHom.comp
        ((AdicCompletion.evalₐ P k).toRingHom.prodMap (AdicCompletion.evalₐ Q k).toRingHom)) (by
        intro m k hmk
        refine RingHom.ext fun x => ?_
        change Ideal.Quotient.factorPow (P * Q) hmk
            ((e k).symm (AdicCompletion.evalₐ P k x.1, AdicCompletion.evalₐ Q k x.2)) =
          (e m).symm (AdicCompletion.evalₐ P m x.1, AdicCompletion.evalₐ Q m x.2)
        obtain ⟨c, hc⟩ := Ideal.Quotient.mk_surjective
          ((e k).symm (AdicCompletion.evalₐ P k x.1, AdicCompletion.evalₐ Q k x.2))
        have h2 : e k (Ideal.Quotient.mk _ c) =
            (AdicCompletion.evalₐ P k x.1, AdicCompletion.evalₐ Q k x.2) := by
          rw [hc, RingEquiv.apply_symm_apply]
        rw [he] at h2
        obtain ⟨h21, h22⟩ := Prod.mk.inj h2
        rw [← hc, ← T_trunc P hmk x.1, ← T_trunc Q hmk x.2, ← h21, ← h22, T_fp, T_fp, T_fp]
        apply (e m).injective
        rw [RingEquiv.apply_symm_apply, he])
    have hΦ₁ev : ∀ k x, AdicCompletion.evalₐ P k (Φ₁ x) =
        Ideal.Quotient.factor (hP k) (AdicCompletion.evalₐ (P * Q) k x) := by
      intro k x
      exact AdicCompletion.evalₐ_liftRingHom _ _ _ k x
    have hΦ₂ev : ∀ k x, AdicCompletion.evalₐ Q k (Φ₂ x) =
        Ideal.Quotient.factor (hQ k) (AdicCompletion.evalₐ (P * Q) k x) := by
      intro k x
      exact AdicCompletion.evalₐ_liftRingHom _ _ _ k x
    have hΨev : ∀ k x, AdicCompletion.evalₐ (P * Q) k (Ψ x) =
        (e k).symm (AdicCompletion.evalₐ P k x.1, AdicCompletion.evalₐ Q k x.2) := by
      intro k x
      exact AdicCompletion.evalₐ_liftRingHom _ _ _ k x
    have h1 : Φ.comp Ψ = RingHom.id _ := by
      refine RingHom.ext fun x => ?_
      obtain ⟨y1, y2⟩ := x
      have key : ∀ k, ∃ c : C, AdicCompletion.evalₐ (P * Q) k (Ψ (y1, y2)) =
            Ideal.Quotient.mk _ c ∧
          AdicCompletion.evalₐ P k y1 = Ideal.Quotient.mk _ c ∧
          AdicCompletion.evalₐ Q k y2 = Ideal.Quotient.mk _ c := by
        intro k
        obtain ⟨c, hc⟩ := Ideal.Quotient.mk_surjective
          ((e k).symm (AdicCompletion.evalₐ P k y1, AdicCompletion.evalₐ Q k y2))
        have h2 : e k (Ideal.Quotient.mk _ c) =
            (AdicCompletion.evalₐ P k y1, AdicCompletion.evalₐ Q k y2) := by
          rw [hc, RingEquiv.apply_symm_apply]
        rw [he] at h2
        obtain ⟨h21, h22⟩ := Prod.mk.inj h2
        exact ⟨c, by rw [hΨev, ← hc], h21.symm, h22.symm⟩
      refine Prod.ext ?_ ?_
      · apply AdicCompletion.ext_evalₐ
        intro k
        obtain ⟨c, hc1, hc2, -⟩ := key k
        change AdicCompletion.evalₐ P k (Φ₁ (Ψ (y1, y2))) = AdicCompletion.evalₐ P k y1
        rw [hΦ₁ev, hc1, hc2, Ideal.Quotient.factor_mk]
      · apply AdicCompletion.ext_evalₐ
        intro k
        obtain ⟨c, hc1, -, hc3⟩ := key k
        change AdicCompletion.evalₐ Q k (Φ₂ (Ψ (y1, y2))) = AdicCompletion.evalₐ Q k y2
        rw [hΦ₂ev, hc1, hc3, Ideal.Quotient.factor_mk]
    have h2 : Ψ.comp Φ = RingHom.id _ := by
      refine RingHom.ext fun x => ?_
      apply AdicCompletion.ext_evalₐ
      intro k
      rw [RingHom.comp_apply, hΨev, RingHom.id_apply]
      change (e k).symm (AdicCompletion.evalₐ P k (Φ₁ x), AdicCompletion.evalₐ Q k (Φ₂ x)) = _
      rw [hΦ₁ev, hΦ₂ev]
      obtain ⟨c, hc⟩ := Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ (P * Q) k x)
      rw [← hc, Ideal.Quotient.factor_mk, Ideal.Quotient.factor_mk, ← he,
        RingEquiv.symm_apply_apply]
    refine ⟨AlgEquiv.ofRingEquiv (f := RingEquiv.ofRingHom Φ Ψ h1 h2) ?_⟩
    intro r
    change Φ (algebraMap R _ r) = _
    rw [Prod.algebraMap_apply]
    refine Prod.ext ?_ ?_
    · apply AdicCompletion.ext_evalₐ
      intro k
      change AdicCompletion.evalₐ P k (Φ₁ (algebraMap R _ r)) = _
      rw [hΦ₁ev, T_evalAlg, T_evalAlg, Ideal.Quotient.factor_mk]
    · apply AdicCompletion.ext_evalₐ
      intro k
      change AdicCompletion.evalₐ Q k (Φ₂ (algebraMap R _ r)) = _
      rw [hΦ₂ev, T_evalAlg, T_evalAlg, Ideal.Quotient.factor_mk]

  have s2 : ∀ (C : Type u) [CommRing C] [IsNoetherianRing C] (I P : Ideal C), P.IsMaximal → I ≤ P → (∀ 𝔔 : Ideal C, 𝔔.IsPrime → I ≤ 𝔔 → 𝔔.IsMaximal) → ∃ Q : Ideal C, IsCoprime P Q ∧ I ≤ P * Q ∧ ∃ N : ℕ, (P * Q) ^ N ≤ I := by
    classical
    intro C _ _ I P hP hIP hall
    have hfin := Ideal.finite_minimalPrimes_of_isNoetherianRing C I
    set F := hfin.toFinset with hFdef
    have hmemF : ∀ p, p ∈ F ↔ p ∈ I.minimalPrimes := fun p => hfin.mem_toFinset
    have hFmax : ∀ p ∈ F, p.IsMaximal := by
      intro p hp
      have h : Minimal (fun q : Ideal C => q.IsPrime ∧ I ≤ q) p := (hmemF p).mp hp
      exact hall p h.prop.1 h.prop.2
    have hPF : P ∈ F := by
      obtain ⟨p, hp, hpP⟩ := Ideal.exists_minimalPrimes_le hIP
      have hp' : p ∈ F := (hmemF p).mpr hp
      have := (hFmax p hp').eq_of_le hP.ne_top hpP
      rw [← this]; exact hp'
    have hcop : IsCoprime P ((F.erase P).inf id) := by
      rw [Ideal.isCoprime_iff_sup_eq]
      by_contra hne
      have h1 : P = P ⊔ (F.erase P).inf id := hP.eq_of_le hne le_sup_left
      have h2 : (F.erase P).inf id ≤ P := le_sup_right.trans h1.symm.le
      obtain ⟨q, hq, hqP⟩ := (Ideal.IsPrime.inf_le' hP.isPrime).mp h2
      have hqF := Finset.mem_erase.mp hq
      exact hqF.1 ((hFmax q hqF.2).eq_of_le hP.ne_top hqP)
    have hrad : P * (F.erase P).inf id = I.radical := by
      rw [Ideal.mul_eq_inf_of_isCoprime hcop, ← Ideal.sInf_minimalPrimes]
      have e1 : P ⊓ (F.erase P).inf id = F.inf id := by
        conv_rhs => rw [← Finset.insert_erase hPF]
        rw [Finset.inf_insert]
        rfl
      rw [e1, Finset.inf_id_eq_sInf, hFdef, Set.Finite.coe_toFinset]
    refine ⟨(F.erase P).inf id, hcop, ?_⟩
    rw [hrad]
    exact ⟨Ideal.le_radical, Ideal.exists_radical_pow_le_of_fg I (IsNoetherian.noetherian _)⟩

  have s1 : ∀ (A : Type u) [CommRing A] (B : Type u) [CommRing B] [Algebra A B], Module.Finite A B → ∀ (𝔪 : Ideal A) [𝔪.IsPrime] (𝔫 : Ideal B) [𝔫.IsPrime], 𝔫.comap (algebraMap A B) = 𝔪 → Algebra.algebraMapSubmonoid B 𝔪.primeCompl ≤ 𝔫.primeCompl ∧ (Ideal.map (algebraMap B (Localization (Algebra.algebraMapSubmonoid B 𝔪.primeCompl))) 𝔫).IsMaximal ∧ Ideal.map (algebraMap A (Localization (Algebra.algebraMapSubmonoid B 𝔪.primeCompl))) 𝔪 ≤ Ideal.map (algebraMap B (Localization (Algebra.algebraMapSubmonoid B 𝔪.primeCompl))) 𝔫 ∧ ∀ 𝔔 : Ideal (Localization (Algebra.algebraMapSubmonoid B 𝔪.primeCompl)), 𝔔.IsPrime → Ideal.map (algebraMap A (Localization (Algebra.algebraMapSubmonoid B 𝔪.primeCompl))) 𝔪 ≤ 𝔔 → 𝔔.IsMaximal := by
    intro A _ B _ _ hfin 𝔪 _ 𝔫 _ h𝔫
    haveI := hfin
    haveI : Algebra.IsIntegral A B := Algebra.IsIntegral.of_finite A B
    set M := Algebra.algebraMapSubmonoid B 𝔪.primeCompl with hMdef
    have hAC : algebraMap A (Localization M) =
        (algebraMap B (Localization M)).comp (algebraMap A B) :=
      IsScalarTower.algebraMap_eq A B (Localization M)
    have hM : M ≤ 𝔫.primeCompl := by
      intro x hx
      obtain ⟨a, ha, rfl⟩ := Submonoid.mem_map.mp hx
      intro hxn
      apply ha
      rw [← h𝔫]
      exact Ideal.mem_comap.mpr hxn
    have hIP : Ideal.map (algebraMap A (Localization M)) 𝔪 ≤
        Ideal.map (algebraMap B (Localization M)) 𝔫 := by
      rw [hAC, ← Ideal.map_map]
      apply Ideal.map_mono
      rw [Ideal.map_le_iff_le_comap, h𝔫]
    have hclaim : ∀ 𝔔 : Ideal (Localization M), 𝔔.IsPrime →
        Ideal.map (algebraMap A (Localization M)) 𝔪 ≤ 𝔔 →
        Ideal.comap (algebraMap A (Localization M)) 𝔔 = 𝔪 := by
      intro 𝔔 h𝔔 hI
      apply le_antisymm
      · intro a ha
        by_contra hna
        have hu : IsUnit (algebraMap A (Localization M) a) := by
          rw [hAC, RingHom.comp_apply]
          exact IsLocalization.map_units (Localization M)
            (⟨algebraMap A B a, Submonoid.mem_map_of_mem _ hna⟩ : M)
        exact h𝔔.ne_top (Ideal.eq_top_of_isUnit_mem _ (Ideal.mem_comap.mp ha) hu)
      · exact Ideal.map_le_iff_le_comap.mp hI
    have hd : ∀ 𝔔 : Ideal (Localization M), 𝔔.IsPrime →
        Ideal.map (algebraMap A (Localization M)) 𝔪 ≤ 𝔔 → 𝔔.IsMaximal := by
      intro 𝔔 h𝔔 hI
      obtain ⟨𝔔', h𝔔'max, hle⟩ := Ideal.exists_le_maximal 𝔔 h𝔔.ne_top
      by_cases heq : 𝔔 = 𝔔'
      · rw [heq]; exact h𝔔'max
      exfalso
      have hI' : Ideal.map (algebraMap A (Localization M)) 𝔪 ≤ 𝔔' := hI.trans hle
      have hne : Ideal.comap (algebraMap B (Localization M)) 𝔔 ≠
          Ideal.comap (algebraMap B (Localization M)) 𝔔' := by
        intro h
        apply heq
        rw [← IsLocalization.map_under M (Localization M) 𝔔,
          ← IsLocalization.map_under M (Localization M) 𝔔']
        exact congrArg (Ideal.map (algebraMap B (Localization M))) h
      have hle' : Ideal.comap (algebraMap B (Localization M)) 𝔔 ≤
          Ideal.comap (algebraMap B (Localization M)) 𝔔' := Ideal.comap_mono hle
      obtain ⟨x, hx1, hx2⟩ : ∃ x, x ∈ Ideal.comap (algebraMap B (Localization M)) 𝔔' ∧
          x ∉ Ideal.comap (algebraMap B (Localization M)) 𝔔 := by
        by_contra hc
        push_neg at hc
        exact hne (le_antisymm hle' hc)
      haveI : (Ideal.comap (algebraMap B (Localization M)) 𝔔).IsPrime := Ideal.comap_isPrime _ _
      have hint : IsIntegral A x := Algebra.IsIntegral.isIntegral x
      have hlt := Ideal.under_lt_under_of_integral_mem_sdiff (R := A) hle' ⟨hx1, hx2⟩ hint
      have e1 : Ideal.under A (Ideal.comap (algebraMap B (Localization M)) 𝔔) = 𝔪 := by
        rw [← hclaim 𝔔 h𝔔 hI]
        show Ideal.comap (algebraMap A B) (Ideal.comap (algebraMap B (Localization M)) 𝔔) = _
        rw [Ideal.comap_comap, ← hAC]
      have e2 : Ideal.under A (Ideal.comap (algebraMap B (Localization M)) 𝔔') = 𝔪 := by
        rw [← hclaim 𝔔' h𝔔'max.isPrime hI']
        show Ideal.comap (algebraMap A B) (Ideal.comap (algebraMap B (Localization M)) 𝔔') = _
        rw [Ideal.comap_comap, ← hAC]
      rw [e1, e2] at hlt
      exact lt_irrefl _ hlt
    have hdisj : Disjoint (M : Set B) (𝔫 : Set B) :=
      Set.disjoint_left.mpr (fun x hxM hxn => hM hxM hxn)
    have hPprime : (Ideal.map (algebraMap B (Localization M)) 𝔫).IsPrime :=
      IsLocalization.isPrime_of_isPrime_disjoint M (Localization M) 𝔫 inferInstance hdisj
    exact ⟨hM, hd _ hPprime hIP, hIP, hd⟩

  have s5 : ∀ (B : Type u) [CommRing B] (M : Submonoid B) (𝔫 : Ideal B) [𝔫.IsPrime], M ≤ 𝔫.primeCompl → (Ideal.map (algebraMap B (Localization M)) 𝔫).IsMaximal → ∃ g : Localization M →ₐ[B] Localization.AtPrime 𝔫, Ideal.map g (Ideal.map (algebraMap B (Localization M)) 𝔫) ≤ IsLocalRing.maximalIdeal (Localization.AtPrime 𝔫) ∧ (∀ (k : ℕ) (d : Localization.AtPrime 𝔫), ∃ c : Localization M, d - g c ∈ IsLocalRing.maximalIdeal (Localization.AtPrime 𝔫) ^ k) ∧ (∀ (k : ℕ) (c : Localization M), g c ∈ IsLocalRing.maximalIdeal (Localization.AtPrime 𝔫) ^ k → c ∈ Ideal.map (algebraMap B (Localization M)) 𝔫 ^ k) := by
    intro B _ M 𝔫 _ hM hPmax
    have hunits : ∀ y : M, IsUnit ((Algebra.ofId B (Localization.AtPrime 𝔫)) (y : B)) :=
      fun y => IsLocalization.map_units (Localization.AtPrime 𝔫) (⟨y, hM y.2⟩ : 𝔫.primeCompl)
    let g : Localization M →ₐ[B] Localization.AtPrime 𝔫 :=
      IsLocalization.liftAlgHom (M := M) (S := Localization M) hunits
    have hgcomp : (g : Localization M →+* Localization.AtPrime 𝔫).comp
        (algebraMap B (Localization M)) = algebraMap B (Localization.AtPrime 𝔫) :=
      RingHom.ext g.commutes
    have hmapP : Ideal.map g (Ideal.map (algebraMap B (Localization M)) 𝔫) =
        IsLocalRing.maximalIdeal (Localization.AtPrime 𝔫) := by
      change Ideal.map (g : Localization M →+* Localization.AtPrime 𝔫) _ = _
      rw [Ideal.map_map, hgcomp, Localization.AtPrime.map_eq_maximalIdeal]
    have hdisj : Disjoint (M : Set B) (𝔫 : Set B) :=
      Set.disjoint_left.mpr (fun x hxM hxn => hM hxM hxn)
    have hcomapP : Ideal.comap (algebraMap B (Localization M))
        (Ideal.map (algebraMap B (Localization M)) 𝔫) = 𝔫 :=
      IsLocalization.under_map_of_isPrime_disjoint M (Localization M) inferInstance hdisj
    have hnotP : ∀ s : B, s ∉ 𝔫 →
        algebraMap B (Localization M) s ∉ Ideal.map (algebraMap B (Localization M)) 𝔫 := by
      intro s hs h
      apply hs
      rw [← hcomapP]
      exact Ideal.mem_comap.mpr h
    refine ⟨g, hmapP.le, ?_, ?_⟩
    · intro k d
      obtain ⟨⟨b, s⟩, hbs⟩ := IsLocalization.surj 𝔫.primeCompl d
      obtain ⟨y, i, hi, hyi⟩ := hPmax.exists_inv (hnotP s s.2)
      have hu : g i ∈ IsLocalRing.maximalIdeal (Localization.AtPrime 𝔫) := by
        rw [← hmapP]; exact Ideal.mem_map_of_mem g hi
      have hgy : g y * algebraMap B (Localization.AtPrime 𝔫) s = 1 - g i := by
        have := congrArg g hyi
        rw [map_add, map_mul, map_one, g.commutes] at this
        linear_combination this
      have hgeom := geom_sum_mul (g i) k
      refine ⟨algebraMap B (Localization M) b * y * ∑ j ∈ Finset.range k, i ^ j, ?_⟩
      have hgc : g (algebraMap B (Localization M) b * y * ∑ j ∈ Finset.range k, i ^ j) =
          algebraMap B (Localization.AtPrime 𝔫) b * g y * ∑ j ∈ Finset.range k, g i ^ j := by
        simp only [map_mul, map_sum, map_pow, g.commutes]
      have key : d - g (algebraMap B (Localization M) b * y * ∑ j ∈ Finset.range k, i ^ j) =
          d * g i ^ k := by
        rw [hgc, ← hbs]
        linear_combination d * hgeom - d * (∑ j ∈ Finset.range k, g i ^ j) * hgy
      rw [key]
      exact Ideal.mul_mem_left _ d (Ideal.pow_mem_pow hu k)
    · intro k c hc
      obtain ⟨⟨b, m⟩, hbm⟩ := IsLocalization.surj M c
      have hgbm : g c * algebraMap B (Localization.AtPrime 𝔫) m =
          algebraMap B (Localization.AtPrime 𝔫) b := by
        have := congrArg g hbm
        rwa [map_mul, g.commutes, g.commutes] at this
      have hmaxk : IsLocalRing.maximalIdeal (Localization.AtPrime 𝔫) ^ k =
          Ideal.map (algebraMap B (Localization.AtPrime 𝔫)) (𝔫 ^ k) := by
        rw [Ideal.map_pow, Localization.AtPrime.map_eq_maximalIdeal]
      have hb : algebraMap B (Localization.AtPrime 𝔫) b ∈
          Ideal.map (algebraMap B (Localization.AtPrime 𝔫)) (𝔫 ^ k) := by
        rw [← hmaxk, ← hgbm]; exact Ideal.mul_mem_right _ _ hc
      obtain ⟨⟨⟨x, hx⟩, s⟩, hxs⟩ :=
        (IsLocalization.mem_map_algebraMap_iff 𝔫.primeCompl _).mp hb
      have hxs' : algebraMap B (Localization.AtPrime 𝔫) (b * s) =
          algebraMap B (Localization.AtPrime 𝔫) x := by
        rw [map_mul]; exact hxs
      obtain ⟨t, ht⟩ := (IsLocalization.eq_iff_exists 𝔫.primeCompl _).mp hxs'
      have hts : (t : B) * s * b ∈ 𝔫 ^ k := by
        have : (t : B) * s * b = t * x := by rw [← ht]; ring
        rw [this]; exact Ideal.mul_mem_left _ _ hx
      have htsn : (t : B) * s ∉ 𝔫 := (t * s).2
      set P := Ideal.map (algebraMap B (Localization M)) 𝔫 with hPdef
      set a := algebraMap B (Localization M) ((t : B) * s) with hadef
      have haP : a ∉ P := hnotP _ htsn
      have hab : a * algebraMap B (Localization M) b ∈ P ^ k := by
        rw [hPdef, ← Ideal.map_pow, hadef, ← map_mul]
        exact Ideal.mem_map_of_mem _ hts
      have hcop : IsCoprime (P ^ k) (Ideal.span {a}) := by
        apply IsCoprime.pow_left
        rw [Ideal.isCoprime_iff_sup_eq]
        by_contra hne
        have h1 : P = P ⊔ Ideal.span {a} := hPmax.eq_of_le hne le_sup_left
        apply haP
        rw [h1]
        exact Ideal.mem_sup_right (Ideal.mem_span_singleton_self a)
      have hbP : algebraMap B (Localization M) b ∈ P ^ k := by
        obtain ⟨p, hp, q, hq, hpq⟩ := Ideal.isCoprime_iff_exists.mp hcop
        obtain ⟨r, rfl⟩ := Ideal.mem_span_singleton'.mp hq
        have : algebraMap B (Localization M) b =
            algebraMap B (Localization M) b * p + r * (a * algebraMap B (Localization M) b) := by
          linear_combination (algebraMap B (Localization M) b) * hpq.symm
        rw [this]
        exact Ideal.add_mem _ (Ideal.mul_mem_left _ _ hp) (Ideal.mul_mem_left _ _ hab)
      rw [← hbm] at hbP
      exact (Ideal.mul_unit_mem_iff_mem _ (IsLocalization.map_units (Localization M) m)).mp hbP

  intro A _ _ B _ _ hfin 𝔪 _ 𝔫 _ h𝔫
  haveI : Module.Finite A B := hfin
  haveI : IsNoetherianRing B := IsNoetherianRing.of_finite A B
  haveI : IsNoetherianRing (Localization (Algebra.algebraMapSubmonoid B 𝔪.primeCompl)) :=
    IsLocalization.isNoetherianRing (Algebra.algebraMapSubmonoid B 𝔪.primeCompl) _ inferInstance
  obtain ⟨hM, hPmax, hIP, hall⟩ := s1 A B hfin 𝔪 𝔫 h𝔫
  obtain ⟨Q, hcop, hIPQ, N, hN⟩ := s2 _ _ _ hPmax hIP hall
  obtain ⟨e₁⟩ := s3 B _ _ _ hIPQ N hN
  obtain ⟨e₂⟩ := s4 B _ _ Q hcop
  obtain ⟨g, h1, h2, h3⟩ := s5 B _ 𝔫 hM hPmax
  obtain ⟨e₃⟩ := s6 B _ _ g _ _ h1 h2 h3
  exact ⟨AdicCompletion Q (Localization (Algebra.algebraMapSubmonoid B 𝔪.primeCompl)),
    inferInstance, inferInstance, ⟨e₁.trans (e₂.trans (AlgEquiv.prodCongr e₃ AlgEquiv.refl))⟩⟩

theorem wc_hnas_pfc_gcl_finite_transfer : (∀ (A : Type u) [CommRing A] [IsNoetherianRing A] (B : Type u) [CommRing B] [Algebra A B], Module.Finite A B → ∀ (𝔪 : Ideal A) [𝔪.IsPrime], Nonempty (TensorProduct A B (AdicCompletion (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔪)) (Localization.AtPrime 𝔪)) ≃ₐ[B] AdicCompletion (Ideal.map (algebraMap A (Localization (Algebra.algebraMapSubmonoid B 𝔪.primeCompl))) 𝔪) (Localization (Algebra.algebraMapSubmonoid B 𝔪.primeCompl)))) → (∀ (A : Type u) [CommRing A] [IsNoetherianRing A] (B : Type u) [CommRing B] [Algebra A B], Module.Finite A B → ∀ (𝔪 : Ideal A) [𝔪.IsPrime] (𝔫 : Ideal B) [𝔫.IsPrime], 𝔫.comap (algebraMap A B) = 𝔪 → ∃ (E : Type u) (_ : CommRing E) (_ : Algebra B E), Nonempty (AdicCompletion (Ideal.map (algebraMap A (Localization (Algebra.algebraMapSubmonoid B 𝔪.primeCompl))) 𝔪) (Localization (Algebra.algebraMapSubmonoid B 𝔪.primeCompl)) ≃ₐ[B] ((AdicCompletion (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔫)) (Localization.AtPrime 𝔫)) × E))) → ∀ (A : Type u) [CommRing A] [IsNoetherianRing A] (B : Type u) [CommRing B] [IsDomain B] [Algebra A B], Function.Injective (algebraMap A B) → Module.Finite A B → (∀ (𝔪 : Ideal (A)) [𝔪.IsPrime], ∀ (Λ : Type u) [CommRing Λ] [Algebra (Localization.AtPrime 𝔪) Λ], Nonempty (AdicCompletion (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔪)) (Localization.AtPrime 𝔪) ≃ₐ[Localization.AtPrime 𝔪] Λ) → ∀ (𝔭 : Ideal (Localization.AtPrime 𝔪)) [𝔭.IsPrime], 𝔭 = ⊥ → ∀ (L : Type u) [Field L] [Algebra (Localization.AtPrime 𝔪) L] [Algebra 𝔭.ResidueField L] [IsScalarTower (Localization.AtPrime 𝔪) 𝔭.ResidueField L] [FiniteDimensional 𝔭.ResidueField L] (𝔔 : Ideal (TensorProduct (Localization.AtPrime 𝔪) L Λ)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) → (∀ (𝔪 : Ideal (B)) [𝔪.IsPrime], ∀ (Λ : Type u) [CommRing Λ] [Algebra (Localization.AtPrime 𝔪) Λ], Nonempty (AdicCompletion (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔪)) (Localization.AtPrime 𝔪) ≃ₐ[Localization.AtPrime 𝔪] Λ) → ∀ (𝔭 : Ideal (Localization.AtPrime 𝔪)) [𝔭.IsPrime], 𝔭 = ⊥ → ∀ (L : Type u) [Field L] [Algebra (Localization.AtPrime 𝔪) L] [Algebra 𝔭.ResidueField L] [IsScalarTower (Localization.AtPrime 𝔪) 𝔭.ResidueField L] [FiniteDimensional 𝔭.ResidueField L] (𝔔 : Ideal (TensorProduct (Localization.AtPrime 𝔪) L Λ)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) :=
by
  intro T1 T2 A _ _ B _ _ _ hinj hfin genA 𝔫 _ Λ _ _ hΛ 𝔭 _ h𝔭 L _ _ _ _ _ 𝔔 _
  have G := PLift.up genA
  clear genA
  subst h𝔭

  have s1 : ∀ (A : Type u) [CommRing A] [IsDomain A] (B : Type u) [CommRing B] [IsDomain B] [Algebra A B], Function.Injective (algebraMap A B) → Module.Finite A B → ∀ (𝔫 : Ideal B) [𝔫.IsPrime], Function.Injective (Localization.localRingHom (𝔫.comap (algebraMap A B)) 𝔫 (algebraMap A B) rfl) ∧ ∀ (h : (⊥ : Ideal (Localization.AtPrime (𝔫.comap (algebraMap A B)))) = (⊥ : Ideal (Localization.AtPrime 𝔫)).comap (Localization.localRingHom (𝔫.comap (algebraMap A B)) 𝔫 (algebraMap A B) rfl)), (Ideal.ResidueField.map (⊥ : Ideal (Localization.AtPrime (𝔫.comap (algebraMap A B)))) (⊥ : Ideal (Localization.AtPrime 𝔫)) (Localization.localRingHom (𝔫.comap (algebraMap A B)) 𝔫 (algebraMap A B) rfl) h).Finite := by
    intro A _ _ B _ _ _ hinj hfin 𝔫 _
    set 𝔪 := 𝔫.comap (algebraMap A B) with h𝔪
    set φ := Localization.localRingHom 𝔪 𝔫 (algebraMap A B) rfl with hφdef
    have hφ : ∀ a : A, φ (algebraMap A (Localization.AtPrime 𝔪) a) =
        algebraMap B (Localization.AtPrime 𝔫) (algebraMap A B a) := fun a =>
      Localization.localRingHom_to_map 𝔪 𝔫 (algebraMap A B) rfl a
    have hBQ : Function.Injective (algebraMap B (Localization.AtPrime 𝔫)) :=
      IsLocalization.injective (Localization.AtPrime 𝔫) (Ideal.primeCompl_le_nonZeroDivisors 𝔫)
    refine ⟨?_, ?_⟩
    · rw [injective_iff_map_eq_zero]
      intro x hx
      obtain ⟨⟨a, s⟩, hxs⟩ := IsLocalization.surj 𝔪.primeCompl x
      simp only at hxs
      have h1 := congrArg φ hxs
      rw [map_mul, hx, zero_mul, hφ] at h1
      have ha : a = 0 := by
        apply hinj
        apply hBQ
        rw [← h1, map_zero, map_zero]
      rw [ha, map_zero] at hxs
      have hu := IsLocalization.map_units (Localization.AtPrime 𝔪) s
      exact (hu.mul_left_eq_zero).mp hxs
    · intro h
      set κP := (⊥ : Ideal (Localization.AtPrime 𝔪)).ResidueField
      set κQ := (⊥ : Ideal (Localization.AtPrime 𝔫)).ResidueField
      set ρ := Ideal.ResidueField.map (⊥ : Ideal (Localization.AtPrime 𝔪))
        (⊥ : Ideal (Localization.AtPrime 𝔫)) φ h with hρdef
      let θ : B →+* κQ := (algebraMap (Localization.AtPrime 𝔫) κQ).comp
        (algebraMap B (Localization.AtPrime 𝔫))
      let α : A →+* κP := (algebraMap (Localization.AtPrime 𝔪) κP).comp
        (algebraMap A (Localization.AtPrime 𝔪))
      have hQκ : Function.Injective (algebraMap (Localization.AtPrime 𝔫) κQ) :=
        IsFractionRing.injective _ _
      have hθinj : Function.Injective θ := hQκ.comp hBQ
      have hρα : ∀ a : A, ρ (α a) = θ (algebraMap A B a) := by
        intro a
        change ρ (algebraMap (Localization.AtPrime 𝔪) κP (algebraMap A (Localization.AtPrime 𝔪) a)) = _
        rw [hρdef, Ideal.ResidueField.map_algebraMap, hφ]
        rfl
      letI : Algebra κP κQ := ρ.toAlgebra
      have hsmul : ∀ (c : κP) (y : κQ), c • y = ρ c * y := fun c y => rfl
      show Module.Finite κP κQ
      classical
      obtain ⟨S, hS⟩ := hfin.fg_top
      have hspan : ∀ x : B, θ x ∈ Submodule.span κP (↑(S.image θ) : Set κQ) := by
        intro x
        have hx : x ∈ Submodule.span A (↑S : Set B) := by rw [hS]; trivial
        induction hx using Submodule.span_induction with
        | mem x hx =>
          exact Submodule.subset_span (by simp only [Finset.coe_image]; exact ⟨x, hx, rfl⟩)
        | zero => rw [map_zero]; exact Submodule.zero_mem _
        | add x y _ _ hx hy => rw [map_add]; exact Submodule.add_mem _ hx hy
        | smul a x _ hx =>
          rw [Algebra.smul_def, map_mul, ← hρα, ← hsmul]
          exact Submodule.smul_mem _ _ hx
      refine ⟨⟨S.image θ, ?_⟩⟩
      rw [Submodule.eq_top_iff']
      intro z
      obtain ⟨q1, q2, hq2, hz⟩ := IsFractionRing.div_surjective (Localization.AtPrime 𝔫) z
      obtain ⟨⟨c1, t1⟩, h1⟩ := IsLocalization.surj 𝔫.primeCompl q1
      obtain ⟨⟨c2, t2⟩, h2⟩ := IsLocalization.surj 𝔫.primeCompl q2
      simp only at h1 h2
      have ht : ∀ t : 𝔫.primeCompl, θ (t : B) ≠ 0 := by
        intro t ht0
        apply t.2
        have : (t : B) = 0 := hθinj (by rw [ht0, map_zero])
        rw [this]
        exact 𝔫.zero_mem
      set Q1 := algebraMap (Localization.AtPrime 𝔫) κQ q1
      set Q2 := algebraMap (Localization.AtPrime 𝔫) κQ q2
      have hQ2 : Q2 ≠ 0 := by
        intro h0
        apply nonZeroDivisors.ne_zero hq2
        apply hQκ
        rw [map_zero]
        exact h0
      have e1 : Q1 * θ t1 = θ c1 := by
        simp only [θ, RingHom.comp_apply, Q1]
        rw [← map_mul, h1]
      have e2 : Q2 * θ t2 = θ c2 := by
        simp only [θ, RingHom.comp_apply, Q2]
        rw [← map_mul, h2]
      have e : z * Q2 = Q1 := by rw [← hz]; exact div_mul_cancel₀ Q1 hQ2
      have hzy : z * θ (c2 * (t1 : B)) = θ (c1 * (t2 : B)) := by
        rw [map_mul, map_mul]
        linear_combination (θ t1 * θ t2) * e + θ t2 * e1 - z * θ t1 * e2
      have hc2 : c2 ≠ 0 := by
        intro h0
        rw [h0, map_zero] at e2
        exact mul_ne_zero hQ2 (ht t2) e2
      have hy : c2 * (t1 : B) ≠ 0 := mul_ne_zero hc2 (fun h0 => ht t1 (by rw [h0, map_zero]))
      have hyint : IsIntegral A (c2 * (t1 : B)) := Algebra.IsIntegral.isIntegral _
      have hne : Ideal.under A (Ideal.span {c2 * (t1 : B)}) ≠ ⊥ :=
        Ideal.under_ne_bot_of_integral_mem hy (Ideal.mem_span_singleton_self _) hyint
      obtain ⟨a₀, ha₀, ha₀ne⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hne
      have ha₀' : algebraMap A B a₀ ∈ Ideal.span {c2 * (t1 : B)} := ha₀
      obtain ⟨w, hw⟩ := Ideal.mem_span_singleton'.mp ha₀'
      have hra : ρ (α a₀) ≠ 0 := by
        rw [hρα]
        intro h0
        apply ha₀ne
        apply hinj
        apply hθinj
        rw [h0, map_zero, map_zero]
      have hzf : z = (α a₀)⁻¹ • θ (c1 * (t2 : B) * w) := by
        rw [hsmul, map_inv₀, eq_inv_mul_iff_mul_eq₀ hra, hρα, ← hw]
        simp only [map_mul] at hzy ⊢
        linear_combination θ w * hzy
      rw [hzf]
      exact Submodule.smul_mem _ _ (hspan _)

  have s3 : ∀ (R : Type u) [CommRing R] (M : Submonoid R) (S : Type u) [CommRing S] [Algebra R S] [IsLocalization M S] (X : Type u) [CommRing X] [Algebra R X] [Algebra S X] [IsScalarTower R S X] (Y : Type u) [CommRing Y] [Algebra R Y] [Algebra S Y] [IsScalarTower R S Y], Nonempty (TensorProduct R X Y ≃+* TensorProduct S X Y) := by
    intro R _ M S _ _ _ X _ _ _ _ Y _ _ _ _
    have := IsLocalization.tensorProduct_compatibleSMul M S X Y
    exact ⟨(Algebra.TensorProduct.equivOfCompatibleSMul R S S X Y).symm.toRingEquiv⟩

  have s4 : ∀ (A : Type u) [CommRing A] (B : Type u) [CommRing B] [Algebra A B] (M : Submonoid A) (P : Type u) [CommRing P] [Algebra A P] [IsLocalization M P] (N : Submonoid B) (Q : Type u) [CommRing Q] [Algebra B Q] [IsLocalization N Q] (φ : P →+* Q), φ.comp (algebraMap A P) = (algebraMap B Q).comp (algebraMap A B) → ∀ (X : Type u) [CommRing X] [Algebra P X] [Algebra A X] [IsScalarTower A P X] (Λ : Type u) [CommRing Λ] [Algebra Q Λ] (E : Type u) [CommRing E] [Algebra B E] (Θ : TensorProduct A B X ≃+* Λ × E), (∀ b : B, Θ (b ⊗ₜ[A] (1 : X)) = (algebraMap Q Λ (algebraMap B Q b), algebraMap B E b)) → ∀ (L : Type u) [CommRing L] [Algebra Q L] [Algebra P L], algebraMap P L = (algebraMap Q L).comp φ → ∃ (R₂ : Type u) (_ : CommRing R₂), Nonempty (TensorProduct P L X ≃+* (TensorProduct Q L Λ) × R₂) := by
    intro A _ B _ _ M P _ _ _ N Q _ _ _ φ hφ X _ _ _ _ Λ _ _ E _ _ Θ hΘ L _ _ _ hL
    letI iAL : Algebra A L := ((algebraMap P L).comp (algebraMap A P)).toAlgebra
    haveI tAPL : IsScalarTower A P L := IsScalarTower.of_algebraMap_eq' rfl
    letI iBL : Algebra B L := ((algebraMap Q L).comp (algebraMap B Q)).toAlgebra
    haveI tBQL : IsScalarTower B Q L := IsScalarTower.of_algebraMap_eq' rfl
    haveI tABL : IsScalarTower A B L := by
      refine IsScalarTower.of_algebraMap_eq' ?_
      change (algebraMap P L).comp (algebraMap A P) =
        ((algebraMap Q L).comp (algebraMap B Q)).comp (algebraMap A B)
      rw [hL, RingHom.comp_assoc, hφ, RingHom.comp_assoc]
    letI iBΛ : Algebra B Λ := ((algebraMap Q Λ).comp (algebraMap B Q)).toAlgebra
    haveI tBQΛ : IsScalarTower B Q Λ := IsScalarTower.of_algebraMap_eq' rfl
    obtain ⟨e₁⟩ := s3 A M P L X
    let e₂ := Algebra.TensorProduct.cancelBaseChange A B B L X
    let Θ' : TensorProduct A B X ≃ₐ[B] Λ × E := AlgEquiv.ofRingEquiv (f := Θ) (fun b => hΘ b)
    let e₃ := Algebra.TensorProduct.congr (AlgEquiv.refl (R := B) (A₁ := L)) Θ'
    let e₄ := Algebra.TensorProduct.prodRight B B L Λ E
    obtain ⟨e₅⟩ := s3 B N Q L Λ
    exact ⟨TensorProduct B L E, inferInstance, ⟨e₁.symm.trans (e₂.symm.toRingEquiv.trans
      (e₃.toRingEquiv.trans (e₄.toRingEquiv.trans (RingEquiv.prodCongr e₅ (RingEquiv.refl _)))))⟩⟩

  have s5 : ∀ (R : Type u) [CommRing R] (R₁ : Type u) [CommRing R₁] (R₂ : Type u) [CommRing R₂] (Ψ : R ≃+* R₁ × R₂) (𝔔 : Ideal R₁) [𝔔.IsPrime], Nonempty (Localization.AtPrime (𝔔.comap ((RingHom.fst R₁ R₂).comp Ψ.toRingHom)) ≃+* Localization.AtPrime 𝔔) := by
    intro R _ R₁ _ R₂ _ Ψ 𝔔 _
    set π : R →+* R₁ := (RingHom.fst R₁ R₂).comp Ψ.toRingHom with hπ
    have hπs : ∀ (x : R₁) (y : R₂), π (Ψ.symm (x, y)) = x := by
      intro x y
      simp [π]
    letI : Algebra R (Localization.AtPrime 𝔔) :=
      ((algebraMap R₁ (Localization.AtPrime 𝔔)).comp π).toAlgebra
    have hal : ∀ r : R, algebraMap R (Localization.AtPrime 𝔔) r =
        algebraMap R₁ (Localization.AtPrime 𝔔) (π r) := fun r => rfl
    have hloc : IsLocalization (𝔔.comap π).primeCompl (Localization.AtPrime 𝔔) := by
      constructor
      constructor
      · rintro ⟨r, hr⟩
        rw [hal]
        exact IsLocalization.map_units (Localization.AtPrime 𝔔) (⟨π r, hr⟩ : 𝔔.primeCompl)
      · intro z
        obtain ⟨⟨x, s⟩, hxs⟩ := IsLocalization.surj 𝔔.primeCompl z
        have hs : Ψ.symm ((s : R₁), (1 : R₂)) ∈ (𝔔.comap π).primeCompl := by
          change π (Ψ.symm ((s : R₁), (1 : R₂))) ∉ 𝔔
          rw [hπs]
          exact s.2
        refine ⟨⟨Ψ.symm (x, 0), ⟨_, hs⟩⟩, ?_⟩
        simp only [hal, hπs]
        exact hxs
      · intro r₁ r₂ h
        rw [hal, hal] at h
        obtain ⟨c, hc⟩ := IsLocalization.exists_of_eq (M := 𝔔.primeCompl) h
        have hc' : Ψ.symm ((c : R₁), (0 : R₂)) ∈ (𝔔.comap π).primeCompl := by
          change π (Ψ.symm ((c : R₁), (0 : R₂))) ∉ 𝔔
          rw [hπs]
          exact c.2
        refine ⟨⟨_, hc'⟩, ?_⟩
        apply Ψ.injective
        simp only [map_mul, RingEquiv.apply_symm_apply]
        have e1 : ∀ r : R, Ψ r = (π r, (Ψ r).2) := fun r => rfl
        rw [e1 r₁, e1 r₂]
        simp only [Prod.mk_mul_mk, zero_mul, hc]
    exact ⟨(IsLocalization.algEquiv (𝔔.comap π).primeCompl
      (Localization.AtPrime (𝔔.comap π)) (Localization.AtPrime 𝔔)).toRingEquiv⟩

  haveI : IsDomain A := Function.Injective.isDomain (algebraMap A B) hinj
  obtain ⟨hφinj, hρfin⟩ := s1 A B hinj hfin 𝔫
  let φ := Localization.localRingHom (𝔫.comap (algebraMap A B)) 𝔫 (algebraMap A B) rfl
  have hbot : (⊥ : Ideal (Localization.AtPrime (𝔫.comap (algebraMap A B)))) =
      (⊥ : Ideal (Localization.AtPrime 𝔫)).comap φ :=
    (Ideal.comap_bot_of_injective φ hφinj).symm
  let ρ := Ideal.ResidueField.map (⊥ : Ideal (Localization.AtPrime (𝔫.comap (algebraMap A B))))
    (⊥ : Ideal (Localization.AtPrime 𝔫)) φ hbot
  have hρ := hρfin hbot

  letI iPL : Algebra (Localization.AtPrime (𝔫.comap (algebraMap A B))) L :=
    ((algebraMap (Localization.AtPrime 𝔫) L).comp φ).toAlgebra
  letI iκL : Algebra (⊥ : Ideal (Localization.AtPrime (𝔫.comap (algebraMap A B)))).ResidueField L :=
    ((algebraMap (⊥ : Ideal (Localization.AtPrime 𝔫)).ResidueField L).comp ρ).toAlgebra
  haveI tPκL : IsScalarTower (Localization.AtPrime (𝔫.comap (algebraMap A B)))
      (⊥ : Ideal (Localization.AtPrime (𝔫.comap (algebraMap A B)))).ResidueField L := by
    refine IsScalarTower.of_algebraMap_eq (fun x => ?_)
    change algebraMap (Localization.AtPrime 𝔫) L (φ x) =
      algebraMap (⊥ : Ideal (Localization.AtPrime 𝔫)).ResidueField L
        (ρ (algebraMap _ (⊥ : Ideal (Localization.AtPrime (𝔫.comap (algebraMap A B)))).ResidueField x))
    rw [Ideal.ResidueField.map_algebraMap, ← IsScalarTower.algebraMap_apply]
  haveI fκL : FiniteDimensional
      (⊥ : Ideal (Localization.AtPrime (𝔫.comap (algebraMap A B)))).ResidueField L :=
    RingHom.Finite.comp (RingHom.finite_algebraMap.mpr inferInstance) hρ

  obtain ⟨T1e⟩ := T1 A B hfin (𝔫.comap (algebraMap A B))
  obtain ⟨E, _, _, ⟨T2e⟩⟩ := T2 A B hfin (𝔫.comap (algebraMap A B)) 𝔫 rfl
  obtain ⟨eΛ⟩ := hΛ
  let Θ := T1e.toRingEquiv.trans (T2e.toRingEquiv.trans
    (RingEquiv.prodCongr eΛ.toRingEquiv (RingEquiv.refl E)))
  have hΘ : ∀ b : B, Θ (b ⊗ₜ[A] (1 : AdicCompletion (IsLocalRing.maximalIdeal
      (Localization.AtPrime (𝔫.comap (algebraMap A B)))) (Localization.AtPrime (𝔫.comap (algebraMap A B))))) =
      (algebraMap (Localization.AtPrime 𝔫) Λ (algebraMap B (Localization.AtPrime 𝔫) b),
        algebraMap B E b) := by
    intro b
    have h1 : (b ⊗ₜ[A] (1 : AdicCompletion (IsLocalRing.maximalIdeal
        (Localization.AtPrime (𝔫.comap (algebraMap A B)))) (Localization.AtPrime (𝔫.comap (algebraMap A B))))) =
        algebraMap B _ b := rfl
    change (RingEquiv.prodCongr eΛ.toRingEquiv (RingEquiv.refl E)) (T2e (T1e _)) = _
    rw [h1, T1e.commutes, T2e.commutes, Prod.algebraMap_apply]
    change (eΛ (algebraMap B _ b), algebraMap B E b) = _
    rw [IsScalarTower.algebraMap_apply B (Localization.AtPrime 𝔫)
      (AdicCompletion (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔫)) (Localization.AtPrime 𝔫)),
      AlgEquiv.commutes]
  have hφc : φ.comp (algebraMap A (Localization.AtPrime (𝔫.comap (algebraMap A B)))) =
      (algebraMap B (Localization.AtPrime 𝔫)).comp (algebraMap A B) :=
    RingHom.ext (Localization.localRingHom_to_map _ 𝔫 (algebraMap A B) rfl)
  obtain ⟨R₂, _, ⟨Γ⟩⟩ := s4 A B (𝔫.comap (algebraMap A B)).primeCompl
    (Localization.AtPrime (𝔫.comap (algebraMap A B))) 𝔫.primeCompl (Localization.AtPrime 𝔫) φ hφc
    _ Λ E Θ hΘ L rfl
  have hreg := G.down (𝔫.comap (algebraMap A B))
    (AdicCompletion (IsLocalRing.maximalIdeal (Localization.AtPrime (𝔫.comap (algebraMap A B))))
      (Localization.AtPrime (𝔫.comap (algebraMap A B)))) ⟨AlgEquiv.refl⟩ ⊥ rfl L
    (𝔔.comap ((RingHom.fst _ _).comp Γ.toRingHom))
  obtain ⟨σ⟩ := s5 _ _ R₂ Γ 𝔔
  exact IsRegularLocalRing.of_ringEquiv
    (R := Localization.AtPrime (𝔔.comap ((RingHom.fst _ _).comp Γ.toRingHom)))
    (R' := Localization.AtPrime 𝔔) σ

theorem wc_hnas_pfc_gcl_separable_base_change : (∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A] (B : Type u) [CommRing B] [IsLocalRing B] [IsNoetherianRing B] [Algebra A B] [IsLocalHom (algebraMap A B)] [Module.Flat A B], IsRegularLocalRing A → IsRegularLocalRing (B ⧸ Ideal.map (algebraMap A B) (IsLocalRing.maximalIdeal A)) → IsRegularLocalRing B) → ∀ (K : Type u) [Field K] (B : Type u) [CommRing B] [Algebra K B] [IsNoetherianRing B], (∀ (𝔮 : Ideal B) [𝔮.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔮)) → ∀ (L : Type u) [Field L] [Algebra K L] [FiniteDimensional K L] [Algebra.IsSeparable K L] (𝔔 : Ideal (TensorProduct K L B)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔) :=
by
  intro R1₀

  obtain R1 : PLift (∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A] (B : Type u) [CommRing B] [IsLocalRing B] [IsNoetherianRing B] [Algebra A B] [IsLocalHom (algebraMap A B)] [Module.Flat A B], IsRegularLocalRing A → IsRegularLocalRing (B ⧸ Ideal.map (algebraMap A B) (IsLocalRing.maximalIdeal A)) → IsRegularLocalRing B) := ⟨R1₀⟩
  clear R1₀

  have transport : ∀ (R : Type u) [CommRing R] (S : Type u) [CommRing S] (e : R ≃+* S),
      PLift (∀ (𝔮 : Ideal R) [𝔮.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔮)) →
      ∀ (P : Ideal S) [P.IsPrime], IsRegularLocalRing (Localization.AtPrime P) := by
    intro R _ S _ e hR P _
    have hc : Submonoid.map e.toMonoidHom (P.comap e).primeCompl = P.primeCompl := by
      ext y
      constructor
      · rintro ⟨x, hx, rfl⟩
        exact hx
      · intro hy
        refine ⟨e.symm y, ?_, ?_⟩
        · change e (e.symm y) ∉ P
          rw [RingEquiv.apply_symm_apply]
          exact hy
        · change e (e.symm y) = y
          exact RingEquiv.apply_symm_apply e y
    have := hR.down (P.comap e)
    exact IsRegularLocalRing.of_ringEquiv
      (IsLocalization.ringEquivOfRingEquiv (Localization.AtPrime (P.comap e))
        (Localization.AtPrime P) e hc)

  have fibre : ∀ (C : Type u) [CommRing C] [IsLocalRing C] (J : Ideal C),
      IsLocalRing.maximalIdeal C = J → IsRegularLocalRing (C ⧸ J) := by
    intro C _ _ J h
    subst h
    exact (inferInstance : IsRegularLocalRing (IsLocalRing.ResidueField C))

  have step : ∀ (B : Type u) [CommRing B] [IsNoetherianRing B] (T : Type u) [CommRing T]
      [IsNoetherianRing T] [Algebra B T] [Module.Flat B T] [Algebra.FiniteType B T]
      [Algebra.FormallyUnramified B T],
      PLift (∀ (𝔮 : Ideal B) [𝔮.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔮)) →
      PLift (∀ (P : Ideal T) [P.IsPrime], IsRegularLocalRing (Localization.AtPrime P)) := by
    intro B _ _ T _ _ _ _ _ _ hB
    refine ⟨fun P _ => ?_⟩
    have h1 : (algebraMap B T).Flat := RingHom.flat_algebraMap_iff.mpr inferInstance
    let q := P.comap (algebraMap B T)
    let A := Localization.AtPrime q
    let C := Localization.AtPrime P
    let f : A →+* C := Localization.localRingHom q P (algebraMap B T) rfl
    letI : Algebra A C := f.toAlgebra
    have : IsLocalHom (algebraMap A C) := Localization.isLocalHom_localRingHom q P _ rfl
    have : IsScalarTower B A C := IsScalarTower.of_algebraMap_eq (fun x => by
      rw [IsScalarTower.algebraMap_apply B T C]
      exact (Localization.localRingHom_to_map q P (algebraMap B T) rfl x).symm)
    have : Algebra.EssFiniteType B T := Algebra.EssFiniteType.of_finiteType B T
    have : Algebra.EssFiniteType T C := Algebra.EssFiniteType.of_isLocalization C P.primeCompl
    have : Algebra.EssFiniteType B C := Algebra.EssFiniteType.comp B T C
    have : Algebra.EssFiniteType A C := Algebra.EssFiniteType.of_comp B A C
    have : Algebra.FormallyUnramified T C :=
      Algebra.FormallyUnramified.of_isLocalization P.primeCompl
    have : Algebra.FormallyUnramified B C := Algebra.FormallyUnramified.comp B T C
    have : Algebra.FormallyUnramified A C := Algebra.FormallyUnramified.of_restrictScalars B A C
    have hm : Ideal.map (algebraMap A C) (IsLocalRing.maximalIdeal A) =
        IsLocalRing.maximalIdeal C := Algebra.FormallyUnramified.map_maximalIdeal
    have : Module.Flat A C := RingHom.Flat.localRingHom h1 P q rfl
    exact R1.down A C (hB.down q) (fibre C _ hm.symm)
  intro K _ B _ _ _ hB₀ L _ _ _ _ 𝔔 _
  obtain hB : PLift (∀ (𝔮 : Ideal B) [𝔮.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔮)) :=
    ⟨hB₀⟩
  clear hB₀
  have hfree : Module.Free B (TensorProduct K B L) := Module.Free.tensor
  have hflat : Module.Flat B (TensorProduct K B L) := Module.Flat.of_free
  have hft : Algebra.FiniteType B (TensorProduct K B L) := inferInstance
  have hnoeth : IsNoetherianRing (TensorProduct K B L) :=
    Algebra.FiniteType.isNoetherianRing B (TensorProduct K B L)
  have := Algebra.FormallyUnramified.of_isSeparable K L
  have hunr : Algebra.FormallyUnramified B (TensorProduct K B L) :=
    Algebra.FormallyUnramified.base_change (R := K) (A := L) B
  have main := step B (TensorProduct K B L) hB
  exact transport (TensorProduct K B L) _ (Algebra.TensorProduct.comm K B L).toRingEquiv main 𝔔

theorem wc_hnas_pfc_gcl_fibre_ring_regular : (∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A] (B : Type u) [CommRing B] [IsLocalRing B] [IsNoetherianRing B] [Algebra A B] [IsLocalHom (algebraMap A B)] [Module.Flat A B], IsRegularLocalRing A → IsRegularLocalRing (B ⧸ Ideal.map (algebraMap A B) (IsLocalRing.maximalIdeal A)) → IsRegularLocalRing B) → (∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A], IsRegularLocalRing A → ∀ (𝔭 : Ideal A) [𝔭.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔭)) → ∀ (P : Type u) [CommRing P] [IsLocalRing P] [IsNoetherianRing P] [IsDomain P], IsRegularLocalRing P → ∀ (Λ : Type u) [CommRing Λ] [Algebra P Λ], Nonempty (AdicCompletion (IsLocalRing.maximalIdeal (P)) (P) ≃ₐ[P] Λ) → (IsNoetherianRing (TensorProduct P (⊥ : Ideal P).ResidueField Λ) ∧ ∀ (𝔔 : Ideal (TensorProduct P (⊥ : Ideal P).ResidueField Λ)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) :=
by
  have hres : ∀ (R : Type u) [CommRing R] [IsLocalRing R],
      IsRegularLocalRing (IsLocalRing.ResidueField R) := fun R _ _ => inferInstance
  intro R1 R3 P _ _ _ _ hP Λ _ _ hΛ
  obtain ⟨hCloc, -, hι, -⟩ := wc_hnas_completion_local_complete P
  haveI := hCloc
  haveI : IsLocalHom (algebraMap P (AdicCompletion (IsLocalRing.maximalIdeal P) P)) := hι
  haveI := wc_hnas_completion_noetherian P
  haveI : Module.Flat P (AdicCompletion (IsLocalRing.maximalIdeal P) P) :=
    AdicCompletion.flat_of_isNoetherian _
  have hfib : IsRegularLocalRing (AdicCompletion (IsLocalRing.maximalIdeal P) P ⧸
      Ideal.map (algebraMap P (AdicCompletion (IsLocalRing.maximalIdeal P) P))
        (IsLocalRing.maximalIdeal P)) := by
    obtain ⟨h1, h2⟩ := wc_hnas_hs_completion_levels P
    let φ : P →+* AdicCompletion (IsLocalRing.maximalIdeal P) P ⧸
        Ideal.map (algebraMap P (AdicCompletion (IsLocalRing.maximalIdeal P) P))
          (IsLocalRing.maximalIdeal P) :=
      (Ideal.Quotient.mk _).comp (algebraMap P (AdicCompletion (IsLocalRing.maximalIdeal P) P))
    have hsurj : Function.Surjective φ := by
      intro z
      obtain ⟨c, rfl⟩ := Ideal.Quotient.mk_surjective z
      obtain ⟨p, hp⟩ := h1 1 c
      rw [pow_one] at hp
      exact ⟨p, (Ideal.Quotient.eq.mpr hp).symm⟩
    have hker : IsLocalRing.maximalIdeal P = RingHom.ker φ := by
      ext x
      rw [RingHom.mem_ker]
      change _ ↔ Ideal.Quotient.mk _
        (algebraMap P (AdicCompletion (IsLocalRing.maximalIdeal P) P) x) = 0
      rw [Ideal.Quotient.eq_zero_iff_mem]
      constructor
      · intro hx
        exact Ideal.mem_map_of_mem _ hx
      · intro hx
        have := h2 1 x (by rw [pow_one]; exact hx)
        rwa [pow_one] at this
    let e : IsLocalRing.ResidueField P ≃+* AdicCompletion (IsLocalRing.maximalIdeal P) P ⧸
        Ideal.map (algebraMap P (AdicCompletion (IsLocalRing.maximalIdeal P) P))
          (IsLocalRing.maximalIdeal P) :=
      (Ideal.quotEquivOfEq hker).trans (RingHom.quotientKerEquivOfSurjective hsurj)
    haveI := hres P
    exact IsRegularLocalRing.of_ringEquiv e
  have hC : IsRegularLocalRing (AdicCompletion (IsLocalRing.maximalIdeal P) P) := R1 P _ hP hfib
  obtain ⟨e⟩ := hΛ
  have hΛreg : IsRegularLocalRing Λ := by
    haveI := hC
    exact IsRegularLocalRing.of_ringEquiv e.toRingEquiv
  haveI := hΛreg
  letI : Algebra Λ (TensorProduct P (⊥ : Ideal P).ResidueField Λ) :=
    Algebra.TensorProduct.rightAlgebra
  haveI hT : IsLocalization (Algebra.algebraMapSubmonoid Λ (nonZeroDivisors P))
      (TensorProduct P (⊥ : Ideal P).ResidueField Λ) :=
    IsLocalization.tensorRight (S := Λ) _ (nonZeroDivisors P)
  refine ⟨IsLocalization.isNoetherianRing (Algebra.algebraMapSubmonoid Λ (nonZeroDivisors P))
    _ inferInstance, ?_⟩
  intro 𝔔 _
  haveI h𝔮 : (Ideal.comap (algebraMap Λ (TensorProduct P (⊥ : Ideal P).ResidueField Λ)) 𝔔).IsPrime :=
    Ideal.comap_isPrime _ _
  haveI := IsLocalization.isLocalization_isLocalization_atPrime_isLocalization
    (Algebra.algebraMapSubmonoid Λ (nonZeroDivisors P)) (Localization.AtPrime 𝔔) 𝔔
  haveI := R3 Λ hΛreg (Ideal.comap (algebraMap Λ (TensorProduct P (⊥ : Ideal P).ResidueField Λ)) 𝔔)
  exact IsRegularLocalRing.of_ringEquiv (IsLocalization.algEquiv
    (Ideal.comap (algebraMap Λ (TensorProduct P (⊥ : Ideal P).ResidueField Λ)) 𝔔).primeCompl
    (Localization.AtPrime
      (Ideal.comap (algebraMap Λ (TensorProduct P (⊥ : Ideal P).ResidueField Λ)) 𝔔))
    (Localization.AtPrime 𝔔)).toRingEquiv

theorem wc_hnas_pfc_gcl_regular_char_zero : (∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A], IsRegularLocalRing A → ∀ (𝔭 : Ideal A) [𝔭.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔭)) → (∀ (P : Type u) [CommRing P] [IsLocalRing P] [IsNoetherianRing P] [IsDomain P], IsRegularLocalRing P → ∀ (Λ : Type u) [CommRing Λ] [Algebra P Λ], Nonempty (AdicCompletion (IsLocalRing.maximalIdeal (P)) (P) ≃ₐ[P] Λ) → (IsNoetherianRing (TensorProduct P (⊥ : Ideal P).ResidueField Λ) ∧ ∀ (𝔔 : Ideal (TensorProduct P (⊥ : Ideal P).ResidueField Λ)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔))) → (∀ (K : Type u) [Field K] (B : Type u) [CommRing B] [Algebra K B] [IsNoetherianRing B], (∀ (𝔮 : Ideal B) [𝔮.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔮)) → ∀ (L : Type u) [Field L] [Algebra K L] [FiniteDimensional K L] [Algebra.IsSeparable K L] (𝔔 : Ideal (TensorProduct K L B)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) → ∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A] [IsDomain A], IsRegularLocalRing A → (∀ m : ℕ, m ≠ 0 → (m : A) ≠ 0) → (∀ (𝔪 : Ideal (A)) [𝔪.IsPrime], ∀ (Λ : Type u) [CommRing Λ] [Algebra (Localization.AtPrime 𝔪) Λ], Nonempty (AdicCompletion (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔪)) (Localization.AtPrime 𝔪) ≃ₐ[Localization.AtPrime 𝔪] Λ) → ∀ (𝔭 : Ideal (Localization.AtPrime 𝔪)) [𝔭.IsPrime], 𝔭 = ⊥ → ∀ (L : Type u) [Field L] [Algebra (Localization.AtPrime 𝔪) L] [Algebra 𝔭.ResidueField L] [IsScalarTower (Localization.AtPrime 𝔪) 𝔭.ResidueField L] [FiniteDimensional 𝔭.ResidueField L] (𝔔 : Ideal (TensorProduct (Localization.AtPrime 𝔪) L Λ)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) :=
by
  intro H3 H6 H9 A _ _ _ _ hreg hchar 𝔪 _ Λ _ _ hΛ 𝔭 _ h𝔭 L _ _ _ _ _ 𝔔 _
  subst h𝔭
  have hP : IsRegularLocalRing (Localization.AtPrime 𝔪) := H3 A hreg 𝔪
  have hι₁ : Function.Injective (algebraMap A (Localization.AtPrime 𝔪)) :=
    IsLocalization.injective (Localization.AtPrime 𝔪) (Ideal.primeCompl_le_nonZeroDivisors 𝔪)
  have hι₂ : Function.Injective (algebraMap (Localization.AtPrime 𝔪)
      (⊥ : Ideal (Localization.AtPrime 𝔪)).ResidueField) := by
    rw [RingHom.injective_iff_ker_eq_bot]
    exact Ideal.ker_algebraMap_residueField _
  haveI : CharZero (⊥ : Ideal (Localization.AtPrime 𝔪)).ResidueField := by
    refine charZero_of_inj_zero ?_
    intro n hn
    by_contra hne
    apply hchar n hne
    apply hι₁
    apply hι₂
    simp only [map_natCast, map_zero]
    exact hn
  obtain ⟨hBn, hBreg⟩ := H6 (Localization.AtPrime 𝔪) hP Λ hΛ
  haveI := hBn
  let e := Algebra.TensorProduct.cancelBaseChange (Localization.AtPrime 𝔪)
    (⊥ : Ideal (Localization.AtPrime 𝔪)).ResidueField
    (⊥ : Ideal (Localization.AtPrime 𝔪)).ResidueField L Λ
  haveI : (Ideal.comap e 𝔔).IsPrime := Ideal.comap_isPrime e 𝔔
  have h9 := H9 (⊥ : Ideal (Localization.AtPrime 𝔪)).ResidueField
    (TensorProduct (Localization.AtPrime 𝔪) (⊥ : Ideal (Localization.AtPrime 𝔪)).ResidueField Λ)
    hBreg L (Ideal.comap e 𝔔)
  have hM : Submonoid.map e.toRingEquiv.toMonoidHom (Ideal.comap e 𝔔).primeCompl
      = 𝔔.primeCompl := by
    ext x
    constructor
    · rintro ⟨y, hy, rfl⟩
      exact hy
    · intro hx
      refine ⟨e.symm x, ?_, ?_⟩
      · change e (e.symm x) ∉ 𝔔
        rw [AlgEquiv.apply_symm_apply]
        exact hx
      · change e (e.symm x) = x
        exact AlgEquiv.apply_symm_apply e x
  haveI := h9
  let φ : Localization.AtPrime (Ideal.comap e 𝔔) ≃+* Localization.AtPrime 𝔔 :=
    IsLocalization.ringEquivOfRingEquiv (S := Localization.AtPrime (Ideal.comap e 𝔔))
      (Q := Localization.AtPrime 𝔔) e.toRingEquiv hM
  exact IsRegularLocalRing.of_ringEquiv (R := Localization.AtPrime (Ideal.comap e 𝔔))
    (R' := Localization.AtPrime 𝔔) φ

theorem wc_hnas_pfc_gcl_purely_inseparable_reduction : (∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A] (B : Type u) [CommRing B] [IsLocalRing B] [IsNoetherianRing B] [Algebra A B] [IsLocalHom (algebraMap A B)] [Module.Flat A B], IsRegularLocalRing B → IsRegularLocalRing A) → (∀ (K : Type u) [Field K] (B : Type u) [CommRing B] [Algebra K B] [IsNoetherianRing B], (∀ (𝔮 : Ideal B) [𝔮.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔮)) → ∀ (L : Type u) [Field L] [Algebra K L] [FiniteDimensional K L] [Algebra.IsSeparable K L] (𝔔 : Ideal (TensorProduct K L B)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) → ∀ (K : Type u) [Field K] (B : Type u) [CommRing B] [Algebra K B] [IsNoetherianRing B], (∀ (L : Type u) [Field L] [Algebra K L] [FiniteDimensional K L] [IsPurelyInseparable K L] (𝔔 : Ideal (TensorProduct K L B)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) → ∀ (L : Type u) [Field L] [Algebra K L] [FiniteDimensional K L] (𝔔 : Ideal (TensorProduct K L B)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔) :=
by
  intro R2₀ CL9₀
  obtain R2 : PLift (∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A] (B : Type u) [CommRing B] [IsLocalRing B] [IsNoetherianRing B] [Algebra A B] [IsLocalHom (algebraMap A B)] [Module.Flat A B], IsRegularLocalRing B → IsRegularLocalRing A) := ⟨R2₀⟩
  clear R2₀
  obtain CL9 : PLift (∀ (K : Type u) [Field K] (B : Type u) [CommRing B] [Algebra K B] [IsNoetherianRing B], (∀ (𝔮 : Ideal B) [𝔮.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔮)) → ∀ (L : Type u) [Field L] [Algebra K L] [FiniteDimensional K L] [Algebra.IsSeparable K L] (𝔔 : Ideal (TensorProduct K L B)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) := ⟨CL9₀⟩
  clear CL9₀

  have transport : ∀ (R : Type u) [CommRing R] (S : Type u) [CommRing S] (e : R ≃+* S),
      PLift (∀ (𝔮 : Ideal R) [𝔮.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔮)) →
      PLift (∀ (P : Ideal S) [P.IsPrime], IsRegularLocalRing (Localization.AtPrime P)) := by
    intro R _ S _ e hR
    refine ⟨fun P _ => ?_⟩
    have hc : Submonoid.map e.toMonoidHom (P.comap e).primeCompl = P.primeCompl := by
      ext y
      constructor
      · rintro ⟨x, hx, rfl⟩
        exact hx
      · intro hy
        refine ⟨e.symm y, ?_, ?_⟩
        · change e (e.symm y) ∉ P
          rw [RingEquiv.apply_symm_apply]
          exact hy
        · change e (e.symm y) = y
          exact RingEquiv.apply_symm_apply e y
    have := hR.down (P.comap e)
    exact IsRegularLocalRing.of_ringEquiv
      (IsLocalization.ringEquivOfRingEquiv (Localization.AtPrime (P.comap e))
        (Localization.AtPrime P) e hc)

  have noeth : ∀ (K : Type u) [Field K] (L : Type u) [Field L] [Algebra K L]
      [FiniteDimensional K L] (B : Type u) [CommRing B] [Algebra K B] [IsNoetherianRing B],
      IsNoetherianRing (TensorProduct K L B) := by
    intro K _ L _ _ _ B _ _ _
    have : IsNoetherianRing (TensorProduct K B L) :=
      Algebra.FiniteType.isNoetherianRing B (TensorProduct K B L)
    exact isNoetherianRing_of_ringEquiv _ (Algebra.TensorProduct.comm K B L).toRingEquiv

  have descent : ∀ (L : Type u) [Field L] (R : Type u) [CommRing R] [Algebra L R]
      [IsNoetherianRing R] (N : Type u) [Field N] [Algebra L N] [FiniteDimensional L N],
      PLift (∀ (Q : Ideal (TensorProduct L R N)) [Q.IsPrime],
        IsRegularLocalRing (Localization.AtPrime Q)) →
      PLift (∀ (q : Ideal R) [q.IsPrime], IsRegularLocalRing (Localization.AtPrime q)) := by
    intro L _ R _ _ _ N _ _ _ hS
    refine ⟨fun q hq => ?_⟩
    have hRnt : Nontrivial R := ⟨⟨0, 1, fun h => hq.ne_top (by
      rw [Ideal.eq_top_iff_one, ← h]; exact q.zero_mem)⟩⟩
    have hinj : Function.Injective (algebraMap R (TensorProduct L R N)) :=
      Algebra.TensorProduct.includeLeft_injective (R := L) (S := R) (A := R) (B := N)
        (algebraMap L N).injective
    have hSnt : Nontrivial (TensorProduct L R N) := hinj.nontrivial
    have hfree : Module.Free R (TensorProduct L R N) := inferInstance
    have hflat : Module.Flat R (TensorProduct L R N) := Module.Flat.of_free
    have hff : Module.FaithfullyFlat R (TensorProduct L R N) := inferInstance
    obtain ⟨Q, hQ⟩ := PrimeSpectrum.comap_surjective_of_faithfullyFlat
      (A := R) (B := TensorProduct L R N) ⟨q, hq⟩
    have hQq : q = Q.asIdeal.comap (algebraMap R (TensorProduct L R N)) :=
      (congrArg PrimeSpectrum.asIdeal hQ).symm
    have hSn0 : IsNoetherianRing (TensorProduct L R N) :=
      IsNoetherianRing.of_finite R (TensorProduct L R N)
    have hRn : IsNoetherianRing (Localization.AtPrime q) :=
      IsLocalization.isNoetherianRing q.primeCompl _ inferInstance
    have hSn : IsNoetherianRing (Localization.AtPrime Q.asIdeal) :=
      IsLocalization.isNoetherianRing Q.asIdeal.primeCompl _ inferInstance
    have h1 : (algebraMap R (TensorProduct L R N)).Flat :=
      RingHom.flat_algebraMap_iff.mpr inferInstance
    let f : Localization.AtPrime q →+* Localization.AtPrime Q.asIdeal :=
      Localization.localRingHom q Q.asIdeal (algebraMap R (TensorProduct L R N)) hQq
    letI : Algebra (Localization.AtPrime q) (Localization.AtPrime Q.asIdeal) := f.toAlgebra
    have : IsLocalHom (algebraMap (Localization.AtPrime q) (Localization.AtPrime Q.asIdeal)) :=
      Localization.isLocalHom_localRingHom q Q.asIdeal _ hQq
    have : Module.Flat (Localization.AtPrime q) (Localization.AtPrime Q.asIdeal) :=
      RingHom.Flat.localRingHom h1 Q.asIdeal q hQq
    exact R2.down _ _ (hS.down Q.asIdeal)

  have tower : ∀ (K : Type u) [Field K] (L : Type u) [Field L] [Algebra K L]
      [FiniteDimensional K L], ∃ (N : Type u) (_ : Field N) (_ : Algebra K N) (_ : Algebra L N)
      (_ : IsScalarTower K L N) (_ : FiniteDimensional L N) (P : Type u) (_ : Field P)
      (_ : Algebra K P) (_ : Algebra P N) (_ : IsScalarTower K P N),
      FiniteDimensional K P ∧ IsPurelyInseparable K P ∧ FiniteDimensional P N ∧
        Algebra.IsSeparable P N := by
    intro K _ L _ _ _
    let Ω := AlgebraicClosure L
    let M := IntermediateField.normalClosure K L Ω
    haveI hMn : Normal K M := normalClosure.normal K L Ω
    haveI hMf : FiniteDimensional K M := normalClosure.is_finiteDimensional K L Ω
    let ι : L →ₐ[K] Ω := IsScalarTower.toAlgHom K L Ω
    have hι : ∀ x, ι x ∈ M := fun x => AlgHom.fieldRange_le_normalClosure ι ⟨x, rfl⟩
    let ι' : L →+* M :=
      { toFun := fun x => ⟨ι x, hι x⟩
        map_one' := Subtype.ext (map_one ι)
        map_mul' := fun a b => Subtype.ext (map_mul ι a b)
        map_zero' := Subtype.ext (map_zero ι)
        map_add' := fun a b => Subtype.ext (map_add ι a b) }
    letI : Algebra L M := ι'.toAlgebra
    haveI hT : IsScalarTower K L M := IsScalarTower.of_algebraMap_eq (fun x => by
      apply Subtype.ext
      change algebraMap K Ω x = ι (algebraMap K L x)
      exact (ι.commutes x).symm)
    haveI hLM : FiniteDimensional L M := FiniteDimensional.right K L M
    let P := IntermediateField.fixedField (⊤ : Subgroup (M ≃ₐ[K] M))
    have hsep : Algebra.IsSeparable P M := FixedPoints.isSeparable (↥(⊤ : Subgroup (M ≃ₐ[K] M))) M
    have hpi : IsPurelyInseparable K P := by
      rw [isPurelyInseparable_iff_natSepDegree_eq_one]
      intro x
      have hmin : minpoly K (algebraMap P M x) = minpoly K x :=
        minpoly.algebraMap_eq (algebraMap P M).injective x
      rw [← hmin]
      have hspl := Normal.splits hMn (algebraMap P M x)
      classical
      rw [Polynomial.natSepDegree_eq_of_splits _ hspl, Finset.card_eq_one]
      refine ⟨algebraMap P M x, ?_⟩
      ext z
      rw [Finset.mem_singleton, Multiset.mem_toFinset]
      constructor
      · intro hz
        rw [Polynomial.mem_aroots] at hz
        obtain ⟨σ, hσ⟩ := minpoly.exists_algEquiv_of_root'
          (Algebra.IsAlgebraic.isAlgebraic (algebraMap P M x)) hz.2
        have hfix : σ (algebraMap P M x) = algebraMap P M x :=
          (IntermediateField.mem_fixedField_iff _ _).mp x.2 σ (Subgroup.mem_top σ)
        rw [← hσ, hfix]
      · rintro rfl
        exact Polynomial.mem_aroots.mpr
          ⟨minpoly.ne_zero (Algebra.IsIntegral.isIntegral _), minpoly.aeval K _⟩
    exact ⟨M, inferInstance, inferInstance, inferInstance, hT, hLM, P, inferInstance,
      inferInstance, inferInstance, inferInstance, inferInstance, hpi, inferInstance, hsep⟩

  intro K _ B _ _ _ H₀ L _ _ _ 𝔔 _
  obtain H : PLift (∀ (L : Type u) [Field L] [Algebra K L] [FiniteDimensional K L] [IsPurelyInseparable K L] (𝔔 : Ideal (TensorProduct K L B)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) := ⟨H₀⟩
  clear H₀
  obtain ⟨N, _, _, _, _, _, P, _, _, _, _, hKP, hpi, hPN, hsep⟩ := tower K L
  haveI := hKP
  haveI := hpi
  haveI := hPN
  haveI := hsep
  haveI hPB : IsNoetherianRing (TensorProduct K P B) := noeth K P B
  have hP : PLift (∀ (Q : Ideal (TensorProduct K P B)) [Q.IsPrime],
      IsRegularLocalRing (Localization.AtPrime Q)) := ⟨fun Q _ => H.down P Q⟩
  have hNPB : PLift (∀ (Q : Ideal (TensorProduct P N (TensorProduct K P B))) [Q.IsPrime],
      IsRegularLocalRing (Localization.AtPrime Q)) :=
    ⟨fun Q _ => CL9.down P (TensorProduct K P B) hP.down N Q⟩
  have hNB := transport _ _ (Algebra.TensorProduct.cancelBaseChange K P N N B).toRingEquiv hNPB
  have hLBN := transport _ _ ((Algebra.TensorProduct.comm L (TensorProduct K L B) N).toRingEquiv.trans
    (Algebra.TensorProduct.cancelBaseChange K L N N B).toRingEquiv).symm hNB
  haveI hLB : IsNoetherianRing (TensorProduct K L B) := noeth K L B
  exact (descent L (TensorProduct K L B) N hLBN).down 𝔔

theorem wc_hnas_pfc_gcl_derivation_criterion : (∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A] (B : Type u) [CommRing B] [IsLocalRing B] [IsNoetherianRing B] [Algebra A B] [IsLocalHom (algebraMap A B)] [Module.Flat A B], IsRegularLocalRing A → IsRegularLocalRing (B ⧸ Ideal.map (algebraMap A B) (IsLocalRing.maximalIdeal A)) → IsRegularLocalRing B) → ∀ (R : Type u) [CommRing R] [IsNoetherianRing R], (∀ (𝔮 : Ideal R) [𝔮.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔮)) → ∀ (D : Derivation ℤ R R) (f : R), IsUnit (D f) → ∀ (n : ℕ), 0 < n → ∀ (𝔔 : Ideal (Polynomial R ⧸ Ideal.span {(Polynomial.X ^ n - Polynomial.C f : Polynomial R)})) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔) :=
by
  have flatC : ∀ (R : Type u) [CommRing R], (Polynomial.C : R →+* Polynomial R).Flat := by
    intro R _
    have : Module.Flat R (Polynomial R) := Module.Flat.of_free
    exact RingHom.flat_algebraMap_iff.mpr this

  have s1 : ∀ (R : Type u) [CommRing R] (D : Derivation ℤ R R), ∃ δ : Derivation ℤ (Polynomial R) (Polynomial R), (∀ a : R, δ (Polynomial.C a) = Polynomial.C (D a)) ∧ δ Polynomial.X = 0 := by
    intro R _ D
    refine ⟨(PolynomialModule.equivPolynomialSelf (R := R)).toLinearMap.compDer D.mapCoeffs, ?_, ?_⟩
    · intro a
      change PolynomialModule.equivPolynomialSelf (D.mapCoeffs (Polynomial.C a)) = _
      rw [Derivation.mapCoeffs_C]
      ext i
      simp [PolynomialModule.equivPolynomialSelf, Polynomial.coeff_C]
    · change PolynomialModule.equivPolynomialSelf (D.mapCoeffs Polynomial.X) = _
      rw [Derivation.mapCoeffs_X, map_zero]

  have s2 : ∀ (S : Type u) [CommRing S] (δ : Derivation ℤ S S) (𝔑 : Ideal S) [𝔑.IsPrime] (F : S), F ∈ 𝔑 → δ F ∉ 𝔑 → algebraMap S (Localization.AtPrime 𝔑) F ∉ IsLocalRing.maximalIdeal (Localization.AtPrime 𝔑) ^ 2 := by
    intro S _ δ 𝔑 _ F hF hδ hmem
    have hsq : ∀ x ∈ 𝔑 ^ 2, δ x ∈ 𝔑 := by
      intro x hx
      rw [sq] at hx
      refine Submodule.mul_induction_on hx ?_ ?_
      · intro a ha b hb
        rw [Derivation.leibniz, smul_eq_mul, smul_eq_mul]
        exact Ideal.add_mem _ (Ideal.mul_mem_right _ _ ha) (Ideal.mul_mem_right _ _ hb)
      · intro x y hx hy
        rw [map_add]; exact Ideal.add_mem _ hx hy
    rw [← Localization.AtPrime.map_eq_maximalIdeal, ← Ideal.map_pow] at hmem
    obtain ⟨⟨a, s⟩, h⟩ := (IsLocalization.mem_map_algebraMap_iff 𝔑.primeCompl
      (Localization.AtPrime 𝔑)).mp hmem
    rw [← map_mul] at h
    obtain ⟨c, hc⟩ := IsLocalization.exists_of_eq (M := 𝔑.primeCompl) h
    have hu : (c : S) * s ∉ 𝔑 := by
      intro h'
      rcases Ideal.IsPrime.mem_or_mem inferInstance h' with h1 | h1
      · exact c.2 h1
      · exact s.2 h1
    have huF : (c : S) * s * F ∈ 𝔑 ^ 2 := by
      have : (c : S) * s * F = c * a := by rw [← hc]; ring
      rw [this]
      exact Ideal.mul_mem_left _ _ a.2
    have h1 := hsq _ huF
    rw [Derivation.leibniz, smul_eq_mul, smul_eq_mul] at h1
    have h2 : F * δ ((c : S) * s) ∈ 𝔑 := Ideal.mul_mem_right _ _ hF
    have h3 : (c : S) * s * δ F ∈ 𝔑 := by
      have := Ideal.sub_mem _ h1 h2
      simpa using this
    rcases Ideal.IsPrime.mem_or_mem inferInstance h3 with h4 | h4
    · exact hu h4
    · exact hδ h4

  have s3 : ∀ (S : Type u) [CommRing S] (I : Ideal S) (𝔑 : Ideal S) [𝔑.IsPrime] (𝔔 : Ideal (S ⧸ I)) [𝔔.IsPrime], 𝔑 = 𝔔.comap (Ideal.Quotient.mk I) → Nonempty (Localization.AtPrime 𝔔 ≃+* (Localization.AtPrime 𝔑 ⧸ Ideal.map (algebraMap S (Localization.AtPrime 𝔑)) I)) := by
    intro S _ I 𝔑 _ 𝔔 _ h
    let φ := Localization.localRingHom 𝔑 𝔔 (Ideal.Quotient.mk I) h
    have hsurj : Function.Surjective φ :=
      RingHom.SurjectiveOnStalks.localRingHom_surjective
        (RingHom.surjectiveOnStalks_of_surjective Ideal.Quotient.mk_surjective) 𝔑 𝔔 h
    have hT : Submonoid.map (Ideal.Quotient.mk I) 𝔑.primeCompl = 𝔔.primeCompl := by
      ext t
      constructor
      · rintro ⟨s, hs, rfl⟩ ht
        apply hs
        show s ∈ 𝔑
        rw [h]
        exact ht
      · intro ht
        obtain ⟨s, rfl⟩ := Ideal.Quotient.mk_surjective t
        refine ⟨s, fun hs => ht ?_, rfl⟩
        have hs' : s ∈ 𝔑 := hs
        rw [h] at hs'
        exact hs'
    have hker : RingHom.ker φ = Ideal.map (algebraMap S (Localization.AtPrime 𝔑)) I := by
      have := IsLocalization.ker_map (S := Localization.AtPrime 𝔑) (Localization.AtPrime 𝔔)
        (Ideal.Quotient.mk I) hT
      rw [Ideal.mk_ker] at this
      rw [← this]
      rfl
    exact ⟨(RingHom.quotientKerEquivOfSurjective hsurj).symm.trans (Ideal.quotEquivOfEq hker)⟩

  have s4 : ∀ (T : Type u) [CommRing T] [IsDomain T] [IsPrincipalIdealRing T] (𝔓 : Ideal T) [𝔓.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔓) := by
    intro T _ _ _ 𝔓 _
    have : IsNoetherianRing (Localization.AtPrime 𝔓) :=
      IsLocalization.isNoetherianRing 𝔓.primeCompl _ inferInstance
    by_cases h : 𝔓 = ⊥
    · have hm : IsLocalRing.maximalIdeal (Localization.AtPrime 𝔓) = ⊥ := by
        rw [← Localization.AtPrime.map_eq_maximalIdeal, Ideal.map_eq_bot_iff_le_ker]
        intro x hx
        rw [h, Ideal.mem_bot] at hx
        rw [hx, RingHom.mem_ker, map_zero]
      have hF : IsField (Localization.AtPrime 𝔓) := IsLocalRing.isField_iff_maximalIdeal_eq.mpr hm
      refine IsRegularLocalRing.mk ?_
      rw [hm, Submodule.spanFinrank_bot, ringKrullDim_eq_zero_of_isField hF]
      rfl
    · have : IsDomain (Localization.AtPrime 𝔓) :=
        IsLocalization.isDomain_localization (Ideal.primeCompl_le_nonZeroDivisors 𝔓)
      have : IsDedekindDomain T := IsPrincipalIdealRing.isDedekindDomain T
      have : IsDiscreteValuationRing (Localization.AtPrime 𝔓) :=
        IsLocalization.AtPrime.isDiscreteValuationRing_of_dedekind_domain T h _
      obtain ⟨g, hg⟩ := (IsPrincipalIdealRing.principal
        (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔓))).principal
      have hg0 : g ≠ 0 := by
        rintro rfl
        apply IsDiscreteValuationRing.not_a_field (Localization.AtPrime 𝔓)
        rw [hg]
        exact Submodule.span_zero_singleton _
      refine IsRegularLocalRing.mk ?_
      rw [IsDiscreteValuationRing.ringKrullDim_eq_one, hg, Submodule.spanFinrank_singleton hg0]
      rfl

  have s5 : ∀ (A : Type u) [CommRing A] [IsDomain A] (𝔓 : Ideal (Polynomial A)) [𝔓.IsPrime], 𝔓.comap Polynomial.C = ⊥ → IsRegularLocalRing (Localization.AtPrime 𝔓) := by
    intro A _ _ 𝔓 _ h𝔓
    classical
    let K := FractionRing A
    let M : Submonoid (Polynomial A) := Submonoid.map Polynomial.C (nonZeroDivisors A)
    letI : Algebra (Polynomial A) (Polynomial K) := Polynomial.algebra A K
    have : IsLocalization M (Polynomial K) := Polynomial.isLocalization (nonZeroDivisors A) K
    let e : Localization M ≃ₐ[Polynomial A] Polynomial K :=
      IsLocalization.algEquiv M (Localization M) (Polynomial K)
    have : IsPrincipalIdealRing (Localization M) :=
      IsPrincipalIdealRing.of_surjective e.symm.toRingEquiv.toRingHom e.symm.surjective
    have hM : M ≤ nonZeroDivisors (Polynomial A) := by
      rintro _ ⟨a, ha, rfl⟩
      exact mem_nonZeroDivisors_of_ne_zero (Polynomial.C_ne_zero.mpr (nonZeroDivisors.ne_zero ha))
    have : IsDomain (Localization M) := IsLocalization.isDomain_of_le_nonZeroDivisors _ hM
    have hdisj : Disjoint (M : Set (Polynomial A)) (𝔓 : Set (Polynomial A)) := by
      rw [Set.disjoint_left]
      rintro _ ⟨a, ha, rfl⟩ hmem
      have h1 : a ∈ 𝔓.comap Polynomial.C := hmem
      rw [h𝔓, Ideal.mem_bot] at h1
      exact nonZeroDivisors.ne_zero ha h1
    let p : Ideal (Localization M) := Ideal.map (algebraMap _ _) 𝔓
    have hp : p.IsPrime := IsLocalization.isPrime_of_isPrime_disjoint M _ 𝔓 inferInstance hdisj
    have hcomap : p.comap (algebraMap _ (Localization M)) = 𝔓 :=
      IsLocalization.under_map_of_isPrime_disjoint M _ inferInstance hdisj
    have hreg : IsRegularLocalRing (Localization.AtPrime p) := s4 (Localization M) p
    let f := IsLocalization.localizationLocalizationAtPrimeIsoLocalization M p
    have key : ∀ (J : Ideal (Polynomial A)) [J.IsPrime], J = 𝔓 →
        IsRegularLocalRing (Localization.AtPrime J) → IsRegularLocalRing (Localization.AtPrime 𝔓) := by
      intro J _ hJ hr
      subst hJ
      exact hr
    exact key _ hcomap (@IsRegularLocalRing.of_ringEquiv (Localization.AtPrime p) _ hreg _ _
      f.symm.toRingEquiv)

  have s6 : ∀ (R : Type u) [CommRing R] (𝔑 : Ideal (Polynomial R)) [𝔑.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔑 ⧸ Ideal.map (Localization.localRingHom (𝔑.comap Polynomial.C) 𝔑 Polynomial.C rfl) (IsLocalRing.maximalIdeal (Localization.AtPrime (𝔑.comap Polynomial.C)))) := by
    intro R _ 𝔑 _
    set 𝔭 := 𝔑.comap Polynomial.C with h𝔭
    let I₀ : Ideal (Polynomial R) := Ideal.map Polynomial.C 𝔭
    have hmax : IsLocalRing.maximalIdeal (Localization.AtPrime 𝔭) =
        Ideal.map (algebraMap R (Localization.AtPrime 𝔭)) 𝔭 :=
      Localization.AtPrime.map_eq_maximalIdeal.symm
    have hcomp : (Localization.localRingHom 𝔭 𝔑 Polynomial.C rfl).comp
        (algebraMap R (Localization.AtPrime 𝔭)) =
        (algebraMap (Polynomial R) (Localization.AtPrime 𝔑)).comp Polynomial.C := by
      ext r
      · exact Localization.localRingHom_to_map 𝔭 𝔑 Polynomial.C rfl r
    have hJ : Ideal.map (Localization.localRingHom 𝔭 𝔑 Polynomial.C rfl)
        (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔭)) =
        Ideal.map (algebraMap (Polynomial R) (Localization.AtPrime 𝔑)) I₀ := by
      rw [hmax, Ideal.map_map, hcomp, ← Ideal.map_map]
    have hle : I₀ ≤ 𝔑 := Ideal.map_le_iff_le_comap.mpr le_rfl
    let 𝔔₀ : Ideal (Polynomial R ⧸ I₀) := Ideal.map (Ideal.Quotient.mk I₀) 𝔑
    have h𝔔₀ : 𝔔₀.IsPrime := Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective
      (by rw [Ideal.mk_ker]; exact hle)
    have hcomap0 : 𝔔₀.comap (Ideal.Quotient.mk I₀) = 𝔑 := by
      rw [Ideal.comap_map_of_surjective' _ Ideal.Quotient.mk_surjective, Ideal.mk_ker]
      exact sup_eq_left.mpr hle
    obtain ⟨e1⟩ := s3 (Polynomial R) I₀ 𝔑 𝔔₀ hcomap0.symm
    let e := Ideal.polynomialQuotientEquivQuotientPolynomial 𝔭
    let 𝔓 : Ideal (Polynomial (R ⧸ 𝔭)) := 𝔔₀.comap e
    have h𝔓 : 𝔓.IsPrime := Ideal.comap_isPrime _ _
    have hmap : Submonoid.map e.toMonoidHom 𝔓.primeCompl = 𝔔₀.primeCompl := by
      ext t
      constructor
      · rintro ⟨s, hs, rfl⟩ ht
        exact hs ht
      · intro ht
        refine ⟨e.symm t, ?_, by simp⟩
        intro hs
        apply ht
        have : e (e.symm t) ∈ 𝔔₀ := hs
        simpa using this
    let e2 : Localization.AtPrime 𝔓 ≃+* Localization.AtPrime 𝔔₀ :=
      IsLocalization.ringEquivOfRingEquiv (Localization.AtPrime 𝔓) (Localization.AtPrime 𝔔₀) e hmap
    have hbot : 𝔓.comap Polynomial.C = ⊥ := by
      ext a
      constructor
      · intro h
        obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective a
        have h1 : e (Polynomial.C (Ideal.Quotient.mk 𝔭 a)) ∈ 𝔔₀ := h
        rw [← Polynomial.map_C, Ideal.polynomialQuotientEquivQuotientPolynomial_map_mk] at h1
        have h2 : Polynomial.C a ∈ 𝔔₀.comap (Ideal.Quotient.mk I₀) := h1
        rw [hcomap0] at h2
        have h3 : a ∈ 𝔭 := h2
        exact Ideal.mem_bot.mpr (Ideal.Quotient.eq_zero_iff_mem.mpr h3)
      · intro h
        rw [Ideal.mem_bot] at h
        rw [h]
        exact Ideal.zero_mem _
    have hreg : IsRegularLocalRing (Localization.AtPrime 𝔓) := s5 (R ⧸ 𝔭) 𝔓 hbot
    exact @IsRegularLocalRing.of_ringEquiv _ _ hreg _ _
      ((e2.trans e1).trans (Ideal.quotEquivOfEq hJ.symm))

  intro R1
  have s7 : ∀ (R : Type u) [CommRing R] [IsNoetherianRing R], (∀ (𝔮 : Ideal R) [𝔮.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔮)) → ∀ (𝔑 : Ideal (Polynomial R)) [𝔑.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔑) := by
    intro R _ _ hreg 𝔑 _
    have hCflat : (Polynomial.C : R →+* Polynomial R).Flat := flatC R
    set 𝔭 := 𝔑.comap Polynomial.C with h𝔭
    have hA : IsNoetherianRing (Localization.AtPrime 𝔭) :=
      IsLocalization.isNoetherianRing 𝔭.primeCompl _ inferInstance
    have hB : IsNoetherianRing (Localization.AtPrime 𝔑) :=
      IsLocalization.isNoetherianRing 𝔑.primeCompl _ inferInstance
    have h6 := s6 R 𝔑
    have hA' := hreg 𝔭
    have hfl := RingHom.Flat.localRingHom hCflat 𝔑 𝔭 rfl
    have hlh := Localization.isLocalHom_localRingHom 𝔭 𝔑 Polynomial.C rfl
    clear s1 s2 s3 s4 s5 s6 hreg flatC
    letI alg : Algebra (Localization.AtPrime 𝔭) (Localization.AtPrime 𝔑) :=
      (Localization.localRingHom 𝔭 𝔑 Polynomial.C rfl).toAlgebra
    have heq : algebraMap (Localization.AtPrime 𝔭) (Localization.AtPrime 𝔑) =
        Localization.localRingHom 𝔭 𝔑 Polynomial.C rfl := rfl
    have hloc : IsLocalHom (algebraMap (Localization.AtPrime 𝔭) (Localization.AtPrime 𝔑)) := by
      rw [heq]; exact hlh
    have hflat : Module.Flat (Localization.AtPrime 𝔭) (Localization.AtPrime 𝔑) := by
      rw [← RingHom.flat_algebraMap_iff, heq]; exact hfl
    have h6' : IsRegularLocalRing (Localization.AtPrime 𝔑 ⧸ Ideal.map
        (algebraMap (Localization.AtPrime 𝔭) (Localization.AtPrime 𝔑))
        (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔭))) := by
      rw [heq]; exact h6
    exact @R1 (Localization.AtPrime 𝔭) _ _ hA (Localization.AtPrime 𝔑) _ _ hB alg hloc hflat hA' h6'

  intro R _ _ hreg D f hDf n _ 𝔔 _
  let F : Polynomial R := Polynomial.X ^ n - Polynomial.C f
  let I : Ideal (Polynomial R) := Ideal.span {F}
  let 𝔑 : Ideal (Polynomial R) := 𝔔.comap (Ideal.Quotient.mk I)
  have h𝔑 : 𝔑.IsPrime := Ideal.comap_isPrime _ _
  have hF : F ∈ 𝔑 := by
    show Ideal.Quotient.mk I F ∈ 𝔔
    rw [Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self F)]
    exact Ideal.zero_mem _
  obtain ⟨δ, hδC, hδX⟩ := s1 R D
  have hδF : δ F = - Polynomial.C (D f) := by
    show δ (Polynomial.X ^ n - Polynomial.C f) = _
    rw [map_sub, Derivation.leibniz_pow, hδX, smul_zero, smul_zero, hδC, zero_sub]
  have hnot : δ F ∉ 𝔑 := by
    intro h
    apply Ideal.IsPrime.ne_top h𝔑
    refine Ideal.eq_top_of_isUnit_mem _ h ?_
    rw [hδF]
    exact (hDf.map Polynomial.C).neg
  have hx2 := s2 (Polynomial R) δ 𝔑 F hF hnot
  have hx : algebraMap (Polynomial R) (Localization.AtPrime 𝔑) F ∈
      IsLocalRing.maximalIdeal (Localization.AtPrime 𝔑) :=
    (IsLocalization.AtPrime.to_map_mem_maximal_iff _ 𝔑 F).mpr hF
  have hS : IsRegularLocalRing (Localization.AtPrime 𝔑) := s7 R hreg 𝔑
  have hSn : IsNoetherianRing (Localization.AtPrime 𝔑) :=
    IsLocalization.isNoetherianRing 𝔑.primeCompl _ inferInstance
  obtain ⟨hq, -⟩ := wc_rl_quot_regular wc_rl_quot_embdim _ hS _ hx hx2
  obtain ⟨e⟩ := s3 (Polynomial R) I 𝔑 𝔔 rfl
  have hspan : Ideal.map (algebraMap (Polynomial R) (Localization.AtPrime 𝔑)) I =
      Ideal.span {algebraMap (Polynomial R) (Localization.AtPrime 𝔑) F} := by
    rw [Ideal.map_span, Set.image_singleton]
  exact @IsRegularLocalRing.of_ringEquiv _ _ hq _ _ ((e.trans (Ideal.quotEquivOfEq hspan)).symm)

theorem wc_hnas_pfc_gcl_de_simple_ext : ∀ (p : ℕ) (L : Type u) [Field L] [CharP L p], p.Prime → ∀ (M : Subfield L) (b : L), b ^ p ∈ M → b ∉ M → (∀ g ∈ Subfield.closure ((M : Set L) ∪ {b}), ∃ a : Fin p → L, (∀ i, a i ∈ M) ∧ g = ∑ i, a i * b ^ (i : ℕ)) ∧ (∀ a : Fin p → L, (∀ i, a i ∈ M) → ∑ i, a i * b ^ (i : ℕ) = 0 → ∀ i, a i = 0) :=
by
  intro p L _ _ hp M b hbp hb
  haveI : Fact p.Prime := ⟨hp⟩
  have hp0 : p ≠ 0 := hp.ne_zero
  have hp1 : 1 ≤ p := hp.one_lt.le
  set c : M := ⟨b ^ p, hbp⟩ with hc
  set q : Polynomial M := Polynomial.X ^ p - Polynomial.C c with hq
  have noroot : ∀ c' : M, c' ^ p ≠ c := by
    intro c' h
    have h1 : ((c' : L)) ^ p = b ^ p := by
      have := congrArg (Subtype.val) h
      simpa [c] using this
    have h2 : ((c' : L) - b) ^ p = 0 := by
      rw [sub_pow_char, h1, sub_self]
    have h3 : (c' : L) - b = 0 := (pow_eq_zero_iff hp0).mp h2
    apply hb
    rw [← sub_eq_zero.mp h3]
    exact c'.2
  have hirr : Irreducible q := X_pow_sub_C_irreducible_of_prime hp noroot
  have hmon : q.Monic := Polynomial.monic_X_pow_sub_C c hp0
  have hqb : Polynomial.aeval b q = 0 := by
    rw [hq, map_sub, map_pow, Polynomial.aeval_X, Polynomial.aeval_C]
    show b ^ p - b ^ p = 0
    exact sub_self _
  have hmin : q = minpoly M b := minpoly.eq_of_irreducible_of_monic hirr hqb hmon
  have hdeg : q.natDegree = p := Polynomial.natDegree_X_pow_sub_C
  have hdeg' : q.degree = p := Polynomial.degree_X_pow_sub_C (Nat.pos_of_ne_zero hp0) c
  refine ⟨?_, ?_⟩
  ·
    have key : ∀ g ∈ Subfield.closure ((M : Set L) ∪ {b}), g ^ p ∈ M ∧
        ∃ P : Polynomial M, Polynomial.aeval b P = g := by
      intro g hg
      induction hg using Subfield.closure_induction with
      | mem x hx =>
        rcases hx with hx | hx
        · exact ⟨Subfield.pow_mem _ hx _, Polynomial.C ⟨x, hx⟩, by rw [Polynomial.aeval_C]; rfl⟩
        · rw [Set.mem_singleton_iff] at hx
          subst hx
          exact ⟨hbp, Polynomial.X, Polynomial.aeval_X _⟩
      | one => exact ⟨by rw [one_pow]; exact Subfield.one_mem _, 1, map_one _⟩
      | add x y _ _ hx hy =>
        obtain ⟨hx1, Px, hPx⟩ := hx
        obtain ⟨hy1, Py, hPy⟩ := hy
        exact ⟨by rw [add_pow_char]; exact Subfield.add_mem _ hx1 hy1, Px + Py,
          by rw [map_add, hPx, hPy]⟩
      | neg x _ hx =>
        obtain ⟨hx1, Px, hPx⟩ := hx
        refine ⟨?_, -Px, by rw [map_neg, hPx]⟩
        rw [neg_pow]
        exact Subfield.mul_mem _ (Subfield.pow_mem _ (Subfield.neg_mem _ (Subfield.one_mem _)) _) hx1
      | inv x _ hx =>
        obtain ⟨hx1, Px, hPx⟩ := hx
        refine ⟨by rw [inv_pow]; exact Subfield.inv_mem _ hx1, ?_⟩
        by_cases hx0 : x = 0
        · exact ⟨0, by rw [map_zero, hx0, inv_zero]⟩
        · refine ⟨Px ^ (p - 1) * Polynomial.C ⟨(x ^ p)⁻¹, Subfield.inv_mem _ hx1⟩, ?_⟩
          rw [map_mul, map_pow, Polynomial.aeval_C, hPx]
          show x ^ (p - 1) * (x ^ p)⁻¹ = x⁻¹
          have : x ^ p = x ^ (p - 1) * x := by rw [← pow_succ, Nat.sub_add_cancel hp1]
          rw [this, mul_inv, ← mul_assoc, mul_inv_cancel₀ (pow_ne_zero _ hx0), one_mul]
      | mul x y _ _ hx hy =>
        obtain ⟨hx1, Px, hPx⟩ := hx
        obtain ⟨hy1, Py, hPy⟩ := hy
        exact ⟨by rw [mul_pow]; exact Subfield.mul_mem _ hx1 hy1, Px * Py,
          by rw [map_mul, hPx, hPy]⟩
    intro g hg
    obtain ⟨-, P, hP⟩ := key g hg
    have hPR : Polynomial.aeval b P = Polynomial.aeval b (P %ₘ q) := by
      have hdiv : P %ₘ q + q * (P /ₘ q) = P := Polynomial.modByMonic_add_div P q
      conv_lhs => rw [← hdiv]
      rw [map_add, map_mul, hqb, zero_mul, add_zero]
    have hq1 : q ≠ 1 := by
      intro h; rw [h, Polynomial.natDegree_one] at hdeg; exact hp0 hdeg.symm
    have hRdeg : (P %ₘ q).natDegree < p := by
      rw [← hdeg]; exact Polynomial.natDegree_modByMonic_lt P hmon hq1
    refine ⟨fun i => ((P %ₘ q).coeff (i : ℕ) : L), fun i => ((P %ₘ q).coeff (i:ℕ)).2, ?_⟩
    rw [← hP, hPR, Polynomial.aeval_eq_sum_range' hRdeg]
    rw [← Fin.sum_univ_eq_sum_range (fun i => (P %ₘ q).coeff i • b ^ i) p]
    rfl
  · intro a ha hsum i
    set f : Fin p → M := fun i => ⟨a i, ha i⟩ with hf
    set Q : Polynomial M := ∑ j : Fin p, Polynomial.C (f j) * Polynomial.X ^ (j : ℕ) with hQ
    have hQb : Polynomial.aeval b Q = 0 := by
      rw [← hsum, hQ, map_sum]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [map_mul, map_pow, Polynomial.aeval_C, Polynomial.aeval_X]
      rfl
    have hQ0 : Q = 0 := by
      by_contra hne
      have h1 := minpoly.degree_le_of_ne_zero M b hne hQb
      have h2 : Q.degree < p := Polynomial.degree_sum_fin_lt f
      rw [← hmin, hdeg'] at h1
      exact absurd (lt_of_le_of_lt h1 h2) (lt_irrefl _)
    have hcoeff : Q.coeff i = f i := by
      rw [hQ, Polynomial.finsetSum_coeff]
      simp only [Polynomial.coeff_C_mul_X_pow]
      rw [Finset.sum_eq_single i]
      · simp
      · intro j _ hj; rw [if_neg]; intro h; exact hj (Fin.ext h.symm)
      · intro h; exact absurd (Finset.mem_univ i) h
    have h0 : f i = 0 := by rw [← hcoeff, hQ0, Polynomial.coeff_zero]
    have := congrArg Subtype.val h0
    simpa [f] using this

theorem wc_hnas_pfc_gcl_de_exchange : (∀ (p : ℕ) (L : Type u) [Field L] [CharP L p], p.Prime → ∀ (M : Subfield L) (b : L), b ^ p ∈ M → b ∉ M → (∀ g ∈ Subfield.closure ((M : Set L) ∪ {b}), ∃ a : Fin p → L, (∀ i, a i ∈ M) ∧ g = ∑ i, a i * b ^ (i : ℕ)) ∧ (∀ a : Fin p → L, (∀ i, a i ∈ M) → ∑ i, a i * b ^ (i : ℕ) = 0 → ∀ i, a i = 0)) → ∀ (p : ℕ) (L : Type u) [Field L] [CharP L p], p.Prime → ∀ (M : Subfield L), (∀ y : L, y ^ p ∈ M) → ∀ a b : L, a ∉ M → a ∈ Subfield.closure ((M : Set L) ∪ {b}) → b ∈ Subfield.closure ((M : Set L) ∪ {a}) :=
by
  intro H p L _ _ hp M hM a b ha hab
  have hb : b ∉ M := by
    intro hbM
    apply ha
    have hle : Subfield.closure ((M : Set L) ∪ {b}) ≤ M := by
      rw [Subfield.closure_le]
      intro x hx
      rcases hx with hx | hx
      · exact hx
      · rw [Set.mem_singleton_iff] at hx
        rw [hx]
        exact hbM
    exact hle hab
  have hli : ∀ c : L, c ∉ M → LinearIndependent M (fun i : Fin p => c ^ (i : ℕ)) := by
    intro c hc
    rw [Fintype.linearIndependent_iff]
    intro g hg i
    have h0 := (H p L hp M c (hM c) hc).2 (fun j => (g j : L)) (fun j => (g j).2) hg
    exact Subtype.ext (h0 i)
  have hrank : ∀ c : L, c ∉ M →
      Module.finrank M (Submodule.span M (Set.range (fun i : Fin p => c ^ (i : ℕ)))) = p := by
    intro c hc
    rw [finrank_span_eq_card (hli c hc), Fintype.card_fin]
  have hle : Submodule.span M (Set.range (fun i : Fin p => a ^ (i : ℕ))) ≤
      Submodule.span M (Set.range (fun i : Fin p => b ^ (i : ℕ))) := by
    rw [Submodule.span_le]
    rintro _ ⟨i, rfl⟩
    have hai : a ^ (i : ℕ) ∈ Subfield.closure ((M : Set L) ∪ {b}) := Subfield.pow_mem _ hab _
    obtain ⟨c, hcM, hc⟩ := (H p L hp M b (hM b) hb).1 _ hai
    rw [SetLike.mem_coe, Submodule.mem_span_range_iff_exists_fun]
    exact ⟨fun j => ⟨c j, hcM j⟩, hc.symm⟩
  haveI : FiniteDimensional M (Submodule.span M (Set.range (fun i : Fin p => b ^ (i : ℕ)))) :=
    FiniteDimensional.span_of_finite M (Set.finite_range _)
  have heq := Submodule.eq_of_le_of_finrank_eq hle (by rw [hrank a ha, hrank b hb])
  have hbW : b ∈ Submodule.span M (Set.range (fun i : Fin p => a ^ (i : ℕ))) := by
    rw [heq]
    apply Submodule.subset_span
    exact ⟨⟨1, hp.one_lt⟩, pow_one b⟩
  obtain ⟨d, hd⟩ := (Submodule.mem_span_range_iff_exists_fun M).mp hbW
  rw [← hd]
  apply Subfield.sum_mem
  intro i _
  have h1 : ((d i : M) : L) ∈ Subfield.closure ((M : Set L) ∪ {a}) :=
    Subfield.subset_closure (Or.inl (d i).2)
  have h2 : a ∈ Subfield.closure ((M : Set L) ∪ {a}) := Subfield.subset_closure (Or.inr rfl)
  exact Subfield.mul_mem _ h1 (Subfield.pow_mem _ h2 _)

theorem wc_hnas_pfc_gcl_de_maximal_avoiding : (∀ (p : ℕ) (L : Type u) [Field L] [CharP L p], p.Prime → ∀ (M : Subfield L), (∀ y : L, y ^ p ∈ M) → ∀ a b : L, a ∉ M → a ∈ Subfield.closure ((M : Set L) ∪ {b}) → b ∈ Subfield.closure ((M : Set L) ∪ {a})) → ∀ (p : ℕ) (L : Type u) [Field L] [CharP L p], p.Prime → ∀ (E : Subfield L), (∀ y : L, y ^ p ∈ E) → ∀ f : L, f ∉ E → ∃ E' : Subfield L, E ≤ E' ∧ f ∉ E' ∧ ∀ g : L, g ∈ Subfield.closure ((E' : Set L) ∪ {f}) :=
by
  intro hexch p L _ _ hp E hE f hfE
  obtain ⟨E', hEE', hmax⟩ := zorn_le_nonempty₀ {K : Subfield L | E ≤ K ∧ f ∉ K}
    (fun c hcS hc y hy => by
      refine ⟨sSup c, ⟨le_trans (hcS hy).1 (le_sSup hy), fun hf => ?_⟩,
        fun z hz => le_sSup hz⟩
      have hdir : DirectedOn (· ≤ ·) c := by
        intro a ha b hb
        rcases hc.total ha hb with hab | hba
        · exact ⟨b, hb, hab, le_rfl⟩
        · exact ⟨a, ha, le_rfl, hba⟩
      obtain ⟨s, hs, hfs⟩ := (Subfield.mem_sSup_of_directedOn ⟨y, hy⟩ hdir).mp hf
      exact (hcS hs).2 hfs)
    E ⟨le_rfl, hfE⟩
  have hfE' : f ∉ E' := hmax.prop.2
  refine ⟨E', hEE', hfE', fun g => ?_⟩
  have hle : E' ≤ Subfield.closure ((E' : Set L) ∪ {g}) := fun x hx =>
    Subfield.subset_closure (Set.mem_union_left _ hx)
  by_cases hf : f ∈ Subfield.closure ((E' : Set L) ∪ {g})
  · exact hexch p L hp E' (fun y => hEE' (hE y)) f g hfE' hf
  · have heq : Subfield.closure ((E' : Set L) ∪ {g}) = E' :=
      hmax.eq_of_ge ⟨le_trans hEE' hle, hf⟩ hle
    have hg : g ∈ E' := by
      rw [← heq]
      exact Subfield.subset_closure (Set.mem_union_right _ (Set.mem_singleton g))
    exact Subfield.subset_closure (Set.mem_union_left _ hg)

theorem wc_hnas_pfc_gcl_de_purely_insep_derivation : (∀ (p : ℕ) (L : Type u) [Field L] [CharP L p], p.Prime → ∀ (M : Subfield L) (b : L), b ^ p ∈ M → b ∉ M → (∀ g ∈ Subfield.closure ((M : Set L) ∪ {b}), ∃ a : Fin p → L, (∀ i, a i ∈ M) ∧ g = ∑ i, a i * b ^ (i : ℕ)) ∧ (∀ a : Fin p → L, (∀ i, a i ∈ M) → ∑ i, a i * b ^ (i : ℕ) = 0 → ∀ i, a i = 0)) → (∀ (p : ℕ) (L : Type u) [Field L] [CharP L p], p.Prime → ∀ (E : Subfield L), (∀ y : L, y ^ p ∈ E) → ∀ f : L, f ∉ E → ∃ E' : Subfield L, E ≤ E' ∧ f ∉ E' ∧ ∀ g : L, g ∈ Subfield.closure ((E' : Set L) ∪ {f})) → ∀ (p : ℕ) (L : Type u) [Field L] [CharP L p], p.Prime → ∀ (E : Subfield L), (∀ y : L, y ^ p ∈ E) → ∀ f : L, f ∉ E → ∃ D : Derivation ℤ L L, (∀ e ∈ E, D e = 0) ∧ D f = 1 :=
by
  intro hS1 hS3 p L _ _ hp E hE f hf
  obtain ⟨E', hEE', hfE', hgen⟩ := hS3 p L hp E hE f hf
  have hfp : f ^ p ∈ E' := hEE' (hE f)
  obtain ⟨hspan, hind⟩ := hS1 p L hp E' f hfp hfE'
  have hp0 : p ≠ 0 := hp.ne_zero

  have hsurj : ∀ g : L, ∃ P : Polynomial E', Polynomial.aeval f P = g := by
    intro g
    obtain ⟨a, ha, hg⟩ := hspan g (hgen g)
    refine ⟨∑ i : Fin p, Polynomial.C (⟨a i, ha i⟩ : E') * Polynomial.X ^ (i : ℕ), ?_⟩
    rw [hg, map_sum]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [map_mul, map_pow, Polynomial.aeval_C, Polynomial.aeval_X]
    rfl

  set c : E' := ⟨f ^ p, hfp⟩ with hc
  set q : Polynomial E' := Polynomial.X ^ p - Polynomial.C c with hq
  have hmon : q.Monic := Polynomial.monic_X_pow_sub_C c hp0
  have hdeg : q.natDegree = p := Polynomial.natDegree_X_pow_sub_C
  have hqf : Polynomial.aeval f q = 0 := by
    rw [hq, map_sub, map_pow, Polynomial.aeval_X, Polynomial.aeval_C]
    show f ^ p - f ^ p = 0
    exact sub_self _
  have hq1 : q ≠ 1 := by
    intro h; rw [h, Polynomial.natDegree_one] at hdeg; exact hp0 hdeg.symm
  have hker : ∀ P : Polynomial E', Polynomial.aeval f P = 0 →
      Polynomial.aeval f (Polynomial.derivative P) = 0 := by
    intro P hP
    have hdiv : P %ₘ q + q * (P /ₘ q) = P := Polynomial.modByMonic_add_div P q
    have hRf : Polynomial.aeval f (P %ₘ q) = 0 := by
      have := congrArg (Polynomial.aeval f) hdiv
      rw [map_add, map_mul, hqf, zero_mul, add_zero, hP] at this
      exact this
    have hRdeg : (P %ₘ q).natDegree < p := by
      rw [← hdeg]; exact Polynomial.natDegree_modByMonic_lt P hmon hq1
    have hR0 : P %ₘ q = 0 := by
      have hsum : ∑ i : Fin p, (((P %ₘ q).coeff (i : ℕ) : E') : L) * f ^ (i : ℕ) = 0 := by
        rw [← hRf, Polynomial.aeval_eq_sum_range' hRdeg,
          ← Fin.sum_univ_eq_sum_range (fun i => (P %ₘ q).coeff i • f ^ i) p]
        rfl
      have hz := hind _ (fun i => ((P %ₘ q).coeff (i : ℕ)).2) hsum
      refine Polynomial.ext fun n => ?_
      rw [Polynomial.coeff_zero]
      by_cases hn : n < p
      · exact Subtype.ext (by simpa using hz ⟨n, hn⟩)
      · exact Polynomial.coeff_eq_zero_of_natDegree_lt (lt_of_lt_of_le hRdeg (not_lt.mp hn))
    rw [hR0, zero_add] at hdiv
    have hdq : Polynomial.aeval f (Polynomial.derivative q) = 0 := by
      rw [hq, Polynomial.derivative_sub, Polynomial.derivative_X_pow, Polynomial.derivative_C,
        sub_zero, map_mul, Polynomial.aeval_C, map_natCast, CharP.cast_eq_zero, zero_mul]
    rw [← hdiv, Polynomial.derivative_mul, map_add, map_mul, map_mul, hqf, hdq, zero_mul,
      zero_mul, add_zero]

  choose σ hσ using hsurj
  obtain ⟨δ, hδdef⟩ : ∃ δ : L → L, ∀ g, δ g = Polynomial.aeval f (Polynomial.derivative (σ g)) :=
    ⟨_, fun _ => rfl⟩
  have key : ∀ (g : L) (P : Polynomial E'), Polynomial.aeval f P = g →
      δ g = Polynomial.aeval f (Polynomial.derivative P) := by
    intro g P hPg
    have h0 : Polynomial.aeval f (σ g - P) = 0 := by rw [map_sub, hσ, hPg, sub_self]
    have := hker _ h0
    rw [Polynomial.derivative_sub, map_sub, sub_eq_zero] at this
    rw [hδdef]
    exact this
  have hadd : ∀ x y, δ (x + y) = δ x + δ y := by
    intro x y
    rw [key (x + y) (σ x + σ y) (by rw [map_add, hσ, hσ]), Polynomial.derivative_add, map_add,
      hδdef x, hδdef y]
  have hmul : ∀ x y, δ (x * y) = x * δ y + y * δ x := by
    intro x y
    rw [key (x * y) (σ x * σ y) (by rw [map_mul, hσ, hσ]), hδdef x, hδdef y,
      Polynomial.derivative_mul, map_add, map_mul, map_mul, hσ, hσ]
    ring
  have hone : δ 1 = 0 := by
    rw [key 1 1 (map_one _), Polynomial.derivative_one, map_zero]
  let δ₀ : L →+ L := AddMonoidHom.mk' δ hadd
  refine ⟨{ toFun := δ
            map_add' := hadd
            map_smul' := fun m x => by
              rw [RingHom.id_apply]
              exact map_zsmul δ₀ m x
            map_one_eq_zero' := hone
            leibniz' := fun a b => hmul a b }, ?_, ?_⟩
  · intro e he
    show δ e = 0
    rw [key e (Polynomial.C (⟨e, hEE' he⟩ : E')) (by rw [Polynomial.aeval_C]; rfl),
      Polynomial.derivative_C, map_zero]
  · show δ f = 1
    rw [key f Polynomial.X (Polynomial.aeval_X f), Polynomial.derivative_X, map_one]

theorem wc_hnas_pfc_gcl_de_p_basis : (∀ (p : ℕ) (L : Type u) [Field L] [CharP L p], p.Prime → ∀ (M : Subfield L) (b : L), b ^ p ∈ M → b ∉ M → (∀ g ∈ Subfield.closure ((M : Set L) ∪ {b}), ∃ a : Fin p → L, (∀ i, a i ∈ M) ∧ g = ∑ i, a i * b ^ (i : ℕ)) ∧ (∀ a : Fin p → L, (∀ i, a i ∈ M) → ∑ i, a i * b ^ (i : ℕ) = 0 → ∀ i, a i = 0)) → (∀ (p : ℕ) (L : Type u) [Field L] [CharP L p], p.Prime → ∀ (M : Subfield L), (∀ y : L, y ^ p ∈ M) → ∀ a b : L, a ∉ M → a ∈ Subfield.closure ((M : Set L) ∪ {b}) → b ∈ Subfield.closure ((M : Set L) ∪ {a})) → ∀ (p : ℕ) (k : Type u) [Field k] [CharP k p], p.Prime → ∃ P : Set k, (∀ J : Finset k, FiniteDimensional (Subfield.closure (Set.range (fun y : k => y ^ p) ∪ (P \ (J : Set k)))) k) ∧ ∀ c : k, (∀ J : Finset k, c ∈ Subfield.closure (Set.range (fun y : k => y ^ p) ∪ (P \ (J : Set k)))) → ∃ y : k, y ^ p = c :=
by
  intro H1 H2 p k _ _ hp
  classical
  set Kp : Set k := Set.range (fun y : k => y ^ p) with hKp
  have hKpcl : ∀ y : k, y ^ p ∈ Kp := fun y => ⟨y, rfl⟩

  have hfs : ∀ (A S : Set k) (x : k), x ∈ Subfield.closure (A ∪ S) →
      ∃ T : Finset k, (T : Set k) ⊆ S ∧ x ∈ Subfield.closure (A ∪ (T : Set k)) := by
    intro A S x hx
    have mono : ∀ (T T' : Finset k), T ⊆ T' →
        Subfield.closure (A ∪ (T : Set k)) ≤ Subfield.closure (A ∪ (T' : Set k)) :=
      fun T T' h => Subfield.closure_mono
        (Set.union_subset_union_right _ (Finset.coe_subset.mpr h))
    induction hx using Subfield.closure_induction with
    | mem x hx =>
      rcases hx with hx | hx
      · exact ⟨∅, by simp, Subfield.subset_closure (Or.inl hx)⟩
      · exact ⟨{x}, by simpa using hx, Subfield.subset_closure (Or.inr (by simp))⟩
    | one => exact ⟨∅, by simp, Subfield.one_mem _⟩
    | add x y _ _ hx hy =>
      obtain ⟨T1, h1, hx1⟩ := hx
      obtain ⟨T2, h2, hy2⟩ := hy
      refine ⟨T1 ∪ T2, by rw [Finset.coe_union]; exact Set.union_subset h1 h2,
        Subfield.add_mem _ ?_ ?_⟩
      · exact mono T1 _ Finset.subset_union_left hx1
      · exact mono T2 _ Finset.subset_union_right hy2
    | neg x _ hx =>
      obtain ⟨T, h, hx⟩ := hx
      exact ⟨T, h, Subfield.neg_mem _ hx⟩
    | inv x _ hx =>
      obtain ⟨T, h, hx⟩ := hx
      exact ⟨T, h, Subfield.inv_mem _ hx⟩
    | mul x y _ _ hx hy =>
      obtain ⟨T1, h1, hx1⟩ := hx
      obtain ⟨T2, h2, hy2⟩ := hy
      refine ⟨T1 ∪ T2, by rw [Finset.coe_union]; exact Set.union_subset h1 h2,
        Subfield.mul_mem _ ?_ ?_⟩
      · exact mono T1 _ Finset.subset_union_left hx1
      · exact mono T2 _ Finset.subset_union_right hy2

  obtain ⟨P, -, hPmax⟩ := zorn_subset_nonempty
    {Q : Set k | ∀ b ∈ Q, b ∉ Subfield.closure (Kp ∪ (Q \ {b}))}
    (fun c hcS hc hne => by
      have hfin : ∀ F : Finset k, (F : Set k) ⊆ ⋃₀ c → ∃ Q ∈ c, (F : Set k) ⊆ Q := by
        intro F
        induction F using Finset.induction_on with
        | empty =>
          intro _
          obtain ⟨Q, hQ⟩ := hne
          exact ⟨Q, hQ, by simp⟩
        | insert a F haF ih =>
          intro hF
          rw [Finset.coe_insert, Set.insert_subset_iff] at hF
          obtain ⟨Q1, hQ1, hF1⟩ := ih hF.2
          obtain ⟨Q2, hQ2, ha2⟩ := Set.mem_sUnion.mp hF.1
          rcases hc.total hQ1 hQ2 with h | h
          · exact ⟨Q2, hQ2, by rw [Finset.coe_insert]; exact Set.insert_subset ha2 (hF1.trans h)⟩
          · exact ⟨Q1, hQ1, by rw [Finset.coe_insert]; exact Set.insert_subset (h ha2) hF1⟩
      refine ⟨⋃₀ c, ?_, fun s hs => Set.subset_sUnion_of_mem hs⟩
      intro b hb hbcl
      obtain ⟨T, hTS, hbT⟩ := hfs Kp (⋃₀ c \ {b}) b hbcl
      obtain ⟨Q, hQc, hQ⟩ := hfin (insert b T)
        (by rw [Finset.coe_insert]; exact Set.insert_subset hb (hTS.trans Set.diff_subset))
      rw [Finset.coe_insert, Set.insert_subset_iff] at hQ
      have hQS : ∀ b ∈ Q, b ∉ Subfield.closure (Kp ∪ (Q \ {b})) := hcS hQc
      apply hQS b hQ.1
      refine Subfield.closure_mono (Set.union_subset_union_right _ ?_) hbT
      intro t ht
      exact ⟨hQ.2 ht, (hTS ht).2⟩)
    ∅ (by simp)
  have hind : ∀ b ∈ P, b ∉ Subfield.closure (Kp ∪ (P \ {b})) := hPmax.prop
  have hmaxP : ∀ a : k, (∀ b ∈ insert a P, b ∉ Subfield.closure (Kp ∪ (insert a P \ {b}))) →
      a ∈ P := by
    intro a h
    have heq := hPmax.eq_of_subset h (Set.subset_insert a P)
    rw [heq]
    exact Set.mem_insert a P

  have hspan : ∀ a : k, a ∈ Subfield.closure (Kp ∪ P) := by
    intro a
    by_contra haQ
    have haP : a ∉ P := fun h => haQ (Subfield.subset_closure (Or.inr h))
    apply haP
    apply hmaxP a
    intro b hb hbcl
    rcases Set.mem_insert_iff.mp hb with hba | hbP
    · subst hba
      apply haQ
      refine Subfield.closure_mono (Set.union_subset_union_right _ ?_) hbcl
      rintro t ⟨ht1, ht2⟩
      rcases Set.mem_insert_iff.mp ht1 with h | h
      · exact absurd h ht2
      · exact h
    · have h1 : b ∈ Subfield.closure
          ((Subfield.closure (Kp ∪ (P \ {b})) : Set k) ∪ {a}) := by
        refine (Subfield.closure_le.mpr ?_) hbcl
        rintro t (ht | ⟨ht1, ht2⟩)
        · exact Subfield.subset_closure (Or.inl (Subfield.subset_closure (Or.inl ht)))
        · rcases Set.mem_insert_iff.mp ht1 with h | h
          · exact Subfield.subset_closure (Or.inr h)
          · exact Subfield.subset_closure
              (Or.inl (Subfield.subset_closure (Or.inr ⟨h, ht2⟩)))
      have h2 := H2 p k hp (Subfield.closure (Kp ∪ (P \ {b})))
        (fun y => Subfield.subset_closure (Or.inl (hKpcl y))) b a (hind b hbP) h1
      apply haQ
      refine (Subfield.closure_le.mpr ?_) h2
      rintro t (ht | ht)
      · exact Subfield.closure_mono (Set.union_subset_union_right _ Set.diff_subset) ht
      · rw [Set.mem_singleton_iff.mp ht]
        exact Subfield.subset_closure (Or.inr hbP)

  have hfd : ∀ J : Finset k,
      FiniteDimensional (Subfield.closure (Kp ∪ (P \ (J : Set k)))) k := by
    intro J
    set K := Subfield.closure (Kp ∪ (P \ (J : Set k))) with hK
    have hint : ∀ t ∈ (J : Set k), IsIntegral K t := by
      intro t _
      have hpow : IsIntegral K (t ^ p) := by
        have : t ^ p = algebraMap K k ⟨t ^ p, Subfield.subset_closure (Or.inl (hKpcl t))⟩ :=
          rfl
        rw [this]
        exact isIntegral_algebraMap
      exact IsIntegral.of_pow hp.pos hpow
    haveI : FiniteDimensional K (IntermediateField.adjoin K (J : Set k)) :=
      IntermediateField.finiteDimensional_adjoin hint
    have htop : IntermediateField.adjoin K (J : Set k) = ⊤ := by
      rw [eq_top_iff]
      intro x _
      rw [← IntermediateField.mem_toSubfield, IntermediateField.adjoin_toSubfield]
      refine (Subfield.closure_le.mpr ?_) (hspan x)
      rintro t (ht | ht)
      · exact Subfield.subset_closure (Or.inl ⟨⟨t, Subfield.subset_closure (Or.inl ht)⟩, rfl⟩)
      · by_cases htJ : t ∈ (J : Set k)
        · exact Subfield.subset_closure (Or.inr htJ)
        · exact Subfield.subset_closure
            (Or.inl ⟨⟨t, Subfield.subset_closure (Or.inr ⟨ht, htJ⟩)⟩, rfl⟩)
    have hfin : FiniteDimensional K (⊤ : IntermediateField K k) := by
      rw [← htop]; infer_instance
    exact Module.Finite.equiv (IntermediateField.topEquiv (F := K) (E := k)).toLinearEquiv

  have hdesc : ∀ (N R : Subfield k) (b x : k), N ≤ R → b ∉ R → b ^ p ∈ N →
      x ∈ Subfield.closure ((N : Set k) ∪ {b}) → x ∈ R → x ∈ N := by
    intro N R b x hNR hbR hbN hxN hxR
    have hbN' : b ∉ N := fun h => hbR (hNR h)
    obtain ⟨a, haN, hxa⟩ := (H1 p k hp N b hbN hbN').1 x hxN
    have hindR := (H1 p k hp R b (hNR hbN) hbR).2
    obtain ⟨i0, hi0⟩ : ∃ i0 : Fin p, (i0 : ℕ) = 0 := ⟨⟨0, hp.pos⟩, rfl⟩
    have h0 := hindR (fun i => a i - if i = i0 then x else 0)
      (fun i => R.sub_mem (hNR (haN i)) (by split_ifs; exact hxR; exact R.zero_mem)) (by
        simp only [sub_mul, Finset.sum_sub_distrib, ite_mul, zero_mul, Finset.sum_ite_eq',
          Finset.mem_univ, ite_true, hi0, pow_zero, mul_one]
        rw [← hxa, sub_self]) i0
    have h0' : a i0 = x := sub_eq_zero.mp (by simpa using h0)
    rw [← h0']
    exact haN i0

  have hinter : ∀ T : Finset k, (T : Set k) ⊆ P → ∀ x : k,
      x ∈ Subfield.closure (Kp ∪ (T : Set k)) →
      x ∈ Subfield.closure (Kp ∪ (P \ (T : Set k))) → ∃ y : k, y ^ p = x := by
    intro T
    induction T using Finset.induction_on with
    | empty =>
      intro _ x hx _
      haveI : ExpChar k p := ExpChar.prime hp
      have hle : Subfield.closure (Kp ∪ ((∅ : Finset k) : Set k)) ≤
          (frobenius k p).fieldRange := by
        rw [Subfield.closure_le]
        rintro t (⟨y, rfl⟩ | ht)
        · exact RingHom.mem_fieldRange.mpr ⟨y, by rw [frobenius_def]⟩
        · simp at ht
      obtain ⟨y, hy⟩ := RingHom.mem_fieldRange.mp (hle hx)
      exact ⟨y, by rw [← frobenius_def]; exact hy⟩
    | insert b T' hbT ih =>
      intro hT x hx1 hx2
      rw [Finset.coe_insert, Set.insert_subset_iff] at hT
      apply ih hT.2 x
      · refine hdesc (Subfield.closure (Kp ∪ (T' : Set k))) (Subfield.closure (Kp ∪ (P \ {b})))
          b x ?_ (hind b hT.1) (Subfield.subset_closure (Or.inl (hKpcl b))) ?_ ?_
        · refine Subfield.closure_mono (Set.union_subset_union_right _ ?_)
          intro t ht
          refine ⟨hT.2 ht, fun h => hbT ?_⟩
          rw [Set.mem_singleton_iff.mp h] at ht
          exact Finset.mem_coe.mp ht
        · refine (Subfield.closure_le.mpr ?_) hx1
          rintro t (ht | ht)
          · exact Subfield.subset_closure (Or.inl (Subfield.subset_closure (Or.inl ht)))
          · rw [Finset.coe_insert] at ht
            rcases Set.mem_insert_iff.mp ht with h | h
            · exact Subfield.subset_closure (Or.inr h)
            · exact Subfield.subset_closure (Or.inl (Subfield.subset_closure (Or.inr h)))
        · refine Subfield.closure_mono (Set.union_subset_union_right _ ?_) hx2
          rintro t ⟨ht1, ht2⟩
          refine ⟨ht1, fun h => ht2 ?_⟩
          rw [Set.mem_singleton_iff.mp h, Finset.coe_insert]
          exact Set.mem_insert _ _
      · refine Subfield.closure_mono (Set.union_subset_union_right _ ?_) hx2
        rintro t ⟨ht1, ht2⟩
        refine ⟨ht1, fun h => ht2 ?_⟩
        rw [Finset.coe_insert]
        exact Set.mem_insert_of_mem _ h

  refine ⟨P, hfd, fun c hc => ?_⟩
  obtain ⟨T, hTP, hcT⟩ := hfs Kp P c (hspan c)
  exact hinter T hTP c hcT (hc T)

theorem wc_hnas_pfc_gcl_de_compositum_simple : (∀ (p : ℕ) (L : Type u) [Field L] [CharP L p], p.Prime → ∀ (M : Subfield L) (b : L), b ^ p ∈ M → b ∉ M → (∀ g ∈ Subfield.closure ((M : Set L) ∪ {b}), ∃ a : Fin p → L, (∀ i, a i ∈ M) ∧ g = ∑ i, a i * b ^ (i : ℕ)) ∧ (∀ a : Fin p → L, (∀ i, a i ∈ M) → ∑ i, a i * b ^ (i : ℕ) = 0 → ∀ i, a i = 0)) → ∀ (p : ℕ) (L : Type u) [Field L] [CharP L p], p.Prime → ∀ (K M : Subfield L), K ≤ M → FiniteDimensional K L → (∀ N : Subfield L, K ≤ N → N ≤ M → N = K ∨ N = M) → ∀ (ι : Type u) [Nonempty ι] (F : ι → Subfield L), (∀ i, F i ≤ K) → (∀ i, ∀ y ∈ K, y ^ p ∈ F i) → (∀ i j, ∃ l, F l ≤ F i ⊓ F j) → (∀ x ∈ K, (∀ i, x ∈ F i) → ∃ y ∈ K, y ^ p = x) → ∀ f ∈ M, (∀ i, f ∈ Subfield.closure ((fun y : L => y ^ p) '' (M : Set L) ∪ (F i : Set L))) → ∃ g ∈ M, g ^ p = f :=
by
  intro S1 p L _ _ hp K M hKM hfd hmin ι _ F H1 H2 H3 H4 f hf hfcl
  classical
  haveI : Fact p.Prime := ⟨hp⟩
  haveI : ExpChar L p := ExpChar.prime hp
  haveI : FiniteDimensional K L := hfd

  have frob : ∀ (d : ℕ) (c : Fin d → L) (x : L),
      (∑ j, c j * x ^ (j : ℕ)) ^ p = ∑ j, c j ^ p * (x ^ p) ^ (j : ℕ) := by
    intro d c x
    rw [sum_pow_char]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [mul_pow, pow_right_comm x (j : ℕ) p]

  have clo_le : ∀ (K' : Subfield L) (x : L), Subfield.closure ((K' : Set L) ∪ {x}) ≤
      (IntermediateField.adjoin K' ({x} : Set L)).toSubfield := by
    intro K' x
    rw [Subfield.closure_le]
    rintro z (hz | hz)
    · exact IntermediateField.algebraMap_mem _ (⟨z, hz⟩ : K')
    · rw [Set.mem_singleton_iff] at hz
      rw [hz]
      exact IntermediateField.mem_adjoin_simple_self K' x

  have s2 : ∀ (K' : Subfield L) (x : L) (n : ℕ) (e : Fin n → L), (∀ j, e j ∈ K') →
      x ^ n = ∑ j, e j * x ^ (j : ℕ) → ∀ g ∈ Subfield.closure ((K' : Set L) ∪ {x}),
      ∃ c : Fin n → L, (∀ j, c j ∈ K') ∧ g = ∑ j, c j * x ^ (j : ℕ) := by
    intro K' x n e he hrel g hg
    rcases Nat.eq_zero_or_pos n with hn | hn
    · exfalso
      subst hn
      simp at hrel
    let e' : Fin n → K' := fun j => ⟨e j, he j⟩
    let q : Polynomial K' :=
      Polynomial.X ^ n - ∑ j : Fin n, Polynomial.C (e' j) * Polynomial.X ^ (j : ℕ)
    have hlt : (∑ j : Fin n, Polynomial.C (e' j) * Polynomial.X ^ (j : ℕ)).degree < (n : WithBot ℕ) :=
      Polynomial.degree_sum_fin_lt e'
    have hmon : q.Monic := Polynomial.monic_X_pow_sub hlt
    have hqdeg : q.degree = (n : WithBot ℕ) := by
      show (Polynomial.X ^ n - ∑ j : Fin n, Polynomial.C (e' j) * Polynomial.X ^ (j : ℕ)).degree = (n : WithBot ℕ)
      rw [Polynomial.degree_sub_eq_left_of_degree_lt (by rwa [Polynomial.degree_X_pow]),
        Polynomial.degree_X_pow]
    have hqnat : q.natDegree = n := Polynomial.natDegree_eq_of_degree_eq_some hqdeg
    have hqx : Polynomial.aeval x q = 0 := by
      show Polynomial.aeval x
        (Polynomial.X ^ n - ∑ j : Fin n, Polynomial.C (e' j) * Polynomial.X ^ (j : ℕ)) = 0
      rw [map_sub, map_pow, Polynomial.aeval_X, map_sum, hrel, sub_eq_zero]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [map_mul, map_pow, Polynomial.aeval_C, Polynomial.aeval_X]
      rfl
    have hint : IsIntegral K' x := ⟨q, hmon, by rw [← Polynomial.aeval_def]; exact hqx⟩
    have hgA : g ∈ IntermediateField.adjoin K' ({x} : Set L) := clo_le K' x hg
    have hsub := IntermediateField.adjoin_simple_toSubalgebra_of_isAlgebraic hint.isAlgebraic
    have hgB : g ∈ Algebra.adjoin K' ({x} : Set L) := by
      rw [← hsub]; exact hgA
    rw [Algebra.adjoin_singleton_eq_range_aeval] at hgB
    obtain ⟨P, hP'⟩ := hgB
    have hP : Polynomial.aeval x P = g := hP'
    have hPR : Polynomial.aeval x P = Polynomial.aeval x (P %ₘ q) := by
      have hdiv : P %ₘ q + q * (P /ₘ q) = P := Polynomial.modByMonic_add_div P q
      conv_lhs => rw [← hdiv]
      rw [map_add, map_mul, hqx, zero_mul, add_zero]
    have hq1 : q ≠ 1 := by
      intro h
      rw [h, Polynomial.natDegree_one] at hqnat
      omega
    have hRdeg : (P %ₘ q).natDegree < n := by
      rw [← hqnat]; exact Polynomial.natDegree_modByMonic_lt P hmon hq1
    refine ⟨fun i => ((P %ₘ q).coeff (i : ℕ) : L), fun i => ((P %ₘ q).coeff (i : ℕ)).2, ?_⟩
    rw [← hP, hPR, Polynomial.aeval_eq_sum_range' hRdeg]
    rw [← Fin.sum_univ_eq_sum_range (fun i => (P %ₘ q).coeff i • x ^ i) n]
    rfl

  have minind : ∀ (K' : Subfield L) (y : L), IsIntegral K' y → ∀ (d : ℕ),
      d ≤ (minpoly K' y).natDegree →
      ∀ c : Fin d → L, (∀ j, c j ∈ K') → ∑ j, c j * y ^ (j : ℕ) = 0 → ∀ j, c j = 0 := by
    intro K' y hy d hd c hc hsum i
    let f : Fin d → K' := fun i => ⟨c i, hc i⟩
    let Q : Polynomial K' := ∑ j : Fin d, Polynomial.C (f j) * Polynomial.X ^ (j : ℕ)
    have hQb : Polynomial.aeval y Q = 0 := by
      rw [← hsum]
      show Polynomial.aeval y (∑ j : Fin d, Polynomial.C (f j) * Polynomial.X ^ (j : ℕ)) = _
      rw [map_sum]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [map_mul, map_pow, Polynomial.aeval_C, Polynomial.aeval_X]
      rfl
    have hQ0 : Q = 0 := by
      by_contra hne
      have h1 := minpoly.degree_le_of_ne_zero K' y hne hQb
      have h2 : Q.degree < d := Polynomial.degree_sum_fin_lt f
      rw [Polynomial.degree_eq_natDegree (minpoly.ne_zero hy)] at h1
      have h3 : ((minpoly K' y).natDegree : WithBot ℕ) < d := lt_of_le_of_lt h1 h2
      have h4 : (minpoly K' y).natDegree < d := by exact_mod_cast h3
      omega
    have hcoeff : Q.coeff i = f i := by
      show (∑ j : Fin d, Polynomial.C (f j) * Polynomial.X ^ (j : ℕ)).coeff i = f i
      rw [Polynomial.finsetSum_coeff]
      simp only [Polynomial.coeff_C_mul_X_pow]
      rw [Finset.sum_eq_single i]
      · simp
      · intro j _ hj; rw [if_neg]; intro h; exact hj (Fin.ext h.symm)
      · intro h; exact absurd (Finset.mem_univ i) h
    have h0 : f i = 0 := by rw [← hcoeff, hQ0, Polynomial.coeff_zero]
    have := congrArg Subtype.val h0
    simpa [f] using this

  by_cases hMK : M ≤ K
  · obtain ⟨y, hyK, hy⟩ := H4 f (hMK hf) (fun i => by
      have hle : Subfield.closure ((fun y : L => y ^ p) '' (M : Set L) ∪ (F i : Set L)) ≤ F i := by
        rw [Subfield.closure_le]
        rintro z (⟨y, hy, rfl⟩ | hz)
        · exact H2 i y (hMK hy)
        · exact hz
      exact hle (hfcl i))
    exact ⟨y, hKM hyK, hy⟩
  obtain ⟨θ, hθM, hθK⟩ := SetLike.not_le_iff_exists.mp hMK
  have hKcl : ∀ x : L, K ≤ Subfield.closure ((K : Set L) ∪ {x}) :=
    fun x z hz => Subfield.subset_closure (Set.mem_union_left _ hz)
  have hclM : ∀ x : L, x ∈ M → Subfield.closure ((K : Set L) ∪ {x}) ≤ M := by
    intro x hx
    rw [Subfield.closure_le]
    rintro z (hz | hz)
    · exact hKM hz
    · rw [Set.mem_singleton_iff.mp hz]; exact hx
  have hN1 : Subfield.closure ((K : Set L) ∪ {θ}) = M := by
    rcases hmin _ (hKcl θ) (hclM θ hθM) with h | h
    · exfalso
      apply hθK
      rw [← h]
      exact Subfield.subset_closure (Set.mem_union_right _ rfl)
    · exact h

  have finish : ∀ (d : ℕ) (e : Fin d → L), (∀ j, e j ∈ K) → θ ^ d = ∑ j, e j * θ ^ (j : ℕ) →
      ∀ i0 : ι, (∀ c : Fin d → L, (∀ j, c j ∈ F i0) →
        ∑ j, c j * (θ ^ p) ^ (j : ℕ) = 0 → ∀ j, c j = 0) → ∃ g ∈ M, g ^ p = f := by
    intro d e he hrel i0 hind
    have hrelp : (θ ^ p) ^ d = ∑ j, e j ^ p * (θ ^ p) ^ (j : ℕ) := by
      rw [pow_right_comm θ p d, hrel, frob]
    have hrep : ∀ i, ∃ a : Fin d → L, (∀ j, a j ∈ F i) ∧ f = ∑ j, a j * (θ ^ p) ^ (j : ℕ) := by
      intro i
      have hle : Subfield.closure ((fun y : L => y ^ p) '' (M : Set L) ∪ (F i : Set L)) ≤
          Subfield.closure ((F i : Set L) ∪ {θ ^ p}) := by
        rw [Subfield.closure_le]
        rintro z (⟨y, hy, rfl⟩ | hz)
        · rw [← hN1] at hy
          obtain ⟨c, hc, rfl⟩ := s2 K θ d e he hrel y hy
          show (∑ j, c j * θ ^ (j : ℕ)) ^ p ∈ _
          rw [frob]
          have htmem : θ ^ p ∈ Subfield.closure ((F i : Set L) ∪ {θ ^ p}) :=
            Subfield.subset_closure (Set.mem_union_right _ (Set.mem_singleton (θ ^ p)))
          refine Subfield.sum_mem _ fun j _ => Subfield.mul_mem _ ?_ (Subfield.pow_mem _ htmem _)
          exact Subfield.subset_closure (Set.mem_union_left _ (H2 i _ (hc j)))
        · exact Subfield.subset_closure (Set.mem_union_left _ hz)
      exact s2 (F i) (θ ^ p) d (fun j => e j ^ p) (fun j => H2 i _ (he j)) hrelp f (hle (hfcl i))
    choose a ha hfa using hrep
    have hall : ∀ j i, a i0 j ∈ F i := by
      intro j i
      obtain ⟨l, hl⟩ := H3 i i0
      have hz := hind (fun j => a i0 j - a l j)
        (fun j => Subfield.sub_mem _ (ha i0 j) ((le_inf_iff.mp hl).2 (ha l j))) (by
          simp only [sub_mul, Finset.sum_sub_distrib]
          rw [← hfa i0, ← hfa l, sub_self]) j
      have : a i0 j = a l j := sub_eq_zero.mp hz
      rw [this]
      exact (le_inf_iff.mp hl).1 (ha l j)
    have hroot : ∀ j, ∃ y ∈ K, y ^ p = a i0 j := fun j => H4 _ (H1 i0 (ha i0 j)) (hall j)
    choose y hyK hyp using hroot
    refine ⟨∑ j, y j * θ ^ (j : ℕ),
      Subfield.sum_mem _ fun j _ => Subfield.mul_mem _ (hKM (hyK j)) (Subfield.pow_mem _ hθM _), ?_⟩
    rw [frob, hfa i0]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [hyp j]
  rcases hmin _ (hKcl (θ ^ p)) (hclM (θ ^ p) (Subfield.pow_mem _ hθM p)) with hB | hA
  ·
    have hθpK : θ ^ p ∈ K := by
      rw [← hB]; exact Subfield.subset_closure (Set.mem_union_right _ rfl)
    have hex : ∃ i0, θ ^ p ∉ F i0 := by
      by_contra hcon
      push_neg at hcon
      obtain ⟨y, hyK, hy⟩ := H4 _ hθpK hcon
      apply hθK
      have h2 : (θ - y) ^ p = 0 := by rw [sub_pow_char, hy, sub_self]
      have h3 : θ - y = 0 := (pow_eq_zero_iff hp.ne_zero).mp h2
      rw [sub_eq_zero.mp h3]; exact hyK
    obtain ⟨i0, hi0⟩ := hex
    let e : Fin p → L := fun j => if (j : ℕ) = 0 then θ ^ p else 0
    have he : ∀ j, e j ∈ K := by
      intro j
      show (if (j : ℕ) = 0 then θ ^ p else 0) ∈ K
      split_ifs
      · exact hθpK
      · exact K.zero_mem
    have hrel : θ ^ p = ∑ j, e j * θ ^ (j : ℕ) := by
      rw [Finset.sum_eq_single (⟨0, hp.pos⟩ : Fin p)]
      · simp [e]
      · intro j _ hj
        have : (j : ℕ) ≠ 0 := fun h => hj (Fin.ext h)
        show (if (j : ℕ) = 0 then θ ^ p else 0) * θ ^ (j : ℕ) = 0
        rw [if_neg this, zero_mul]
      · intro h; exact absurd (Finset.mem_univ _) h
    exact finish p e he hrel i0 (S1 p L hp (F i0) (θ ^ p) (H2 i0 _ hθpK) hi0).2
  ·
    have hθint : IsIntegral K θ := IsIntegral.of_finite K θ
    have hθpint : IsIntegral K (θ ^ p) := IsIntegral.of_finite K (θ ^ p)
    have hadj : IntermediateField.adjoin K ({θ} : Set L) =
        IntermediateField.adjoin K ({θ ^ p} : Set L) := by
      apply le_antisymm
      · rw [IntermediateField.adjoin_simple_le_iff]
        have : θ ∈ Subfield.closure ((K : Set L) ∪ {θ ^ p}) := by
          rw [hA, ← hN1]; exact Subfield.subset_closure (Set.mem_union_right _ rfl)
        exact clo_le K (θ ^ p) this
      · rw [IntermediateField.adjoin_simple_le_iff]
        exact pow_mem (IntermediateField.mem_adjoin_simple_self K θ) p
    have hdeq : (minpoly K θ).natDegree = (minpoly K (θ ^ p)).natDegree := by
      rw [← IntermediateField.adjoin.finrank hθint, ← IntermediateField.adjoin.finrank hθpint, hadj]
    let d := (minpoly K θ).natDegree
    let e : Fin d → L := fun j => -(((minpoly K θ).coeff j : K) : L)
    have he : ∀ j, e j ∈ K := fun j => K.neg_mem ((minpoly K θ).coeff j).2
    have hrel : θ ^ d = ∑ j, e j * θ ^ (j : ℕ) := by
      have h0 := minpoly.aeval K θ
      have hs := (minpoly.monic hθint).as_sum
      rw [hs, map_add, map_pow, Polynomial.aeval_X, map_sum] at h0
      simp only [map_mul, map_pow, Polynomial.aeval_X, Polynomial.aeval_C] at h0
      rw [← Fin.sum_univ_eq_sum_range
        (fun i => algebraMap K L ((minpoly K θ).coeff i) * θ ^ i)] at h0
      simp only [e, neg_mul, Finset.sum_neg_distrib]
      rw [eq_neg_iff_add_eq_zero]
      exact h0
    exact finish d e he hrel (Classical.arbitrary ι) (fun c hc hsum =>
      minind K (θ ^ p) hθpint d hdeq.le c (fun j => H1 _ (hc j)) hsum)

theorem wc_hnas_pfc_gcl_de_compositum_intersection : (∀ (p : ℕ) (L : Type u) [Field L] [CharP L p], p.Prime → ∀ (K M : Subfield L), K ≤ M → FiniteDimensional K L → (∀ N : Subfield L, K ≤ N → N ≤ M → N = K ∨ N = M) → ∀ (ι : Type u) [Nonempty ι] (F : ι → Subfield L), (∀ i, F i ≤ K) → (∀ i, ∀ y ∈ K, y ^ p ∈ F i) → (∀ i j, ∃ l, F l ≤ F i ⊓ F j) → (∀ x ∈ K, (∀ i, x ∈ F i) → ∃ y ∈ K, y ^ p = x) → ∀ f ∈ M, (∀ i, f ∈ Subfield.closure ((fun y : L => y ^ p) '' (M : Set L) ∪ (F i : Set L))) → ∃ g ∈ M, g ^ p = f) → ∀ (p : ℕ) (L : Type u) [Field L] [CharP L p], p.Prime → ∀ (K M : Subfield L), K ≤ M → FiniteDimensional K L → ∀ (ι : Type u) [Nonempty ι] (F : ι → Subfield L), (∀ i, F i ≤ K) → (∀ i, ∀ y ∈ K, y ^ p ∈ F i) → (∀ i j, ∃ l, F l ≤ F i ⊓ F j) → (∀ x ∈ K, (∀ i, x ∈ F i) → ∃ y ∈ K, y ^ p = x) → ∀ f ∈ M, (∀ i, f ∈ Subfield.closure ((fun y : L => y ^ p) '' (M : Set L) ∪ (F i : Set L))) → ∃ g ∈ M, g ^ p = f :=
by
  intro H p L _ _ hp K M hKM hfin ι _ F hFK hpow hdir hint
  classical
  have := hfin
  obtain ⟨μ, hμ⟩ : ∃ μ : Subfield L → ℕ, ∀ N : Subfield L,
      μ N = Module.finrank K (Submodule.span K (N : Set L)) := ⟨_, fun _ => rfl⟩

  have ha : ∀ N : Subfield L, K ≤ N → ∀ x ∈ Submodule.span K (N : Set L), x ∈ N := by
    intro N hKN x hx
    induction hx using Submodule.span_induction with
    | mem x hx => exact hx
    | zero => exact N.zero_mem
    | add x y _ _ hx hy => exact N.add_mem hx hy
    | smul c x _ hx =>
      have e : c • x = (c : L) * x := rfl
      rw [e]
      exact N.mul_mem (hKN c.2) hx

  have hb : ∀ N : Subfield L, μ N ≤ Module.finrank K L := by
    intro N
    rw [hμ]
    exact Submodule.finrank_le _

  have hc : ∀ N₁ N₂ : Subfield L, K ≤ N₁ → N₁ < N₂ → μ N₁ < μ N₂ := by
    intro N₁ N₂ hK hlt
    rw [hμ, hμ]
    apply Submodule.finrank_lt_finrank_of_lt
    obtain ⟨x, hx2, hx1⟩ := SetLike.exists_of_lt hlt
    refine lt_of_le_of_ne (Submodule.span_mono (fun z hz => hlt.le hz)) ?_
    intro heq
    apply hx1
    apply ha N₁ hK
    rw [heq]
    exact Submodule.subset_span hx2

  have hd : ∀ N : Subfield L, K ≤ N → FiniteDimensional N L := by
    intro N hKN
    obtain ⟨m, s, hs⟩ := Module.Finite.exists_fin (R := K) (M := L)
    refine Module.finite_def.mpr ⟨Finset.univ.image s, ?_⟩
    rw [eq_top_iff]
    intro x hxtop
    clear hxtop
    have hx : x ∈ Submodule.span K (Set.range s) := by rw [hs]; trivial
    rw [Finset.coe_image, Finset.coe_univ, Set.image_univ]
    induction hx using Submodule.span_induction with
    | mem y hy => exact Submodule.subset_span hy
    | zero => exact Submodule.zero_mem _
    | add y z _ _ hy hz => exact Submodule.add_mem _ hy hz
    | smul c y _ hy =>
      have e : c • y = (⟨(c : L), hKN c.2⟩ : N) • y := rfl
      rw [e]
      exact Submodule.smul_mem _ _ hy

  have he : ∀ M : Subfield L, K < M → ∃ M' : Subfield L, K ≤ M' ∧ M' < M ∧
      ∀ N : Subfield L, K ≤ N → N < M → μ N ≤ μ M' := by
    intro M hlt
    obtain ⟨M', ⟨h1, h2⟩, hmin⟩ :=
      (InvImage.wf (fun N : Subfield L => Module.finrank K L - μ N) wellFounded_lt).has_min
        {N : Subfield L | K ≤ N ∧ N < M} ⟨K, le_rfl, hlt⟩
    refine ⟨M', h1, h2, fun N hN1 hN2 => ?_⟩
    have h3 : ¬ (Module.finrank K L - μ N < Module.finrank K L - μ M') := hmin N ⟨hN1, hN2⟩
    have h4 := hb N
    have h5 := hb M'
    omega
  have Q : ∀ n : ℕ, ∀ M : Subfield L, K ≤ M → μ M = n → ∀ f ∈ M,
      (∀ i, f ∈ Subfield.closure ((fun y : L => y ^ p) '' (M : Set L) ∪ (F i : Set L))) →
      ∃ g ∈ M, g ^ p = f := by
    intro n
    induction n using Nat.strong_induction_on with
    | _ n IH =>
    intro M hKM hμM f hfM hcl
    by_cases hKeq : K = M
    · subst hKeq
      exact H p L hp K K le_rfl hfin (fun N h1 h2 => Or.inl (le_antisymm h2 h1)) ι F hFK hpow
        hdir hint f hfM hcl
    · have hlt : K < M := lt_of_le_of_ne hKM hKeq
      obtain ⟨M', hKM', hM'M, hmax⟩ := he M hlt
      have hμlt : μ M' < n := by rw [← hμM]; exact hc M' M hKM' hM'M
      have hmin : ∀ N : Subfield L, M' ≤ N → N ≤ M → N = M' ∨ N = M := by
        intro N h1 h2
        by_cases e1 : N = M'
        · exact Or.inl e1
        by_cases e2 : N = M
        · exact Or.inr e2
        exfalso
        have hNM : N < M := lt_of_le_of_ne h2 e2
        have hM'N : M' < N := lt_of_le_of_ne h1 (Ne.symm e1)
        have h6 := hc M' N hKM' hM'N
        have h7 := hmax N (hKM'.trans h1) hNM
        omega
      refine H p L hp M' M hM'M.le (hd M' hKM') hmin ι
        (fun i => Subfield.closure ((fun y : L => y ^ p) '' (M' : Set L) ∪ (F i : Set L)))
        ?_ ?_ ?_ ?_ f hfM ?_
      · intro i
        rw [Subfield.closure_le]
        refine Set.union_subset ?_ ?_
        · rintro _ ⟨y, hy, rfl⟩
          exact M'.pow_mem hy p
        · intro z hz
          exact hKM' (hFK i hz)
      · intro i y hy
        exact Subfield.subset_closure (Or.inl ⟨y, hy, rfl⟩)
      · intro i j
        obtain ⟨l, hl⟩ := hdir i j
        refine ⟨l, le_inf ?_ ?_⟩
        · exact Subfield.closure_mono (Set.union_subset_union_right _
            (fun z hz => (Subfield.mem_inf.mp (hl hz)).1))
        · exact Subfield.closure_mono (Set.union_subset_union_right _
            (fun z hz => (Subfield.mem_inf.mp (hl hz)).2))
      · intro x hx hxF
        exact IH (μ M') hμlt M' hKM' rfl x hx hxF
      · intro i
        exact Subfield.closure_mono (Set.union_subset_union_right _
          (fun z hz => Subfield.subset_closure (Or.inr hz))) (hcl i)
  intro f hfM hcl
  exact Q (μ M) M hKM rfl f hfM hcl

theorem wc_hnas_pfc_gcl_de_frobenius_coeff : ∀ (p n : ℕ) (k : Type u) [Field k] [CharP k p], p.Prime → ∀ (M : MvPowerSeries (Fin n) k), (∀ e : Fin n →₀ ℕ, MvPowerSeries.coeff (p • e) (M ^ p) = (MvPowerSeries.coeff e M) ^ p) ∧ ∀ m : Fin n →₀ ℕ, (¬ ∀ j, p ∣ m j) → MvPowerSeries.coeff m (M ^ p) = 0 :=
by
  classical
  intro p n k _ _ hp M
  haveI : Fact p.Prime := ⟨hp⟩
  haveI hA : CharP (MvPowerSeries (Fin n) k) p :=
    charP_of_injective_algebraMap (algebraMap k (MvPowerSeries (Fin n) k)).injective p
  haveI : ExpChar (MvPowerSeries (Fin n) k) p := ExpChar.prime hp
  have key : ∀ m : Fin n →₀ ℕ, MvPowerSeries.coeff m (M ^ p) =
      ∑ d ∈ Finset.Iic m, (if m = p • d then (MvPowerSeries.coeff d M) ^ p else 0) := by
    intro m
    obtain ⟨T, hT⟩ : ∃ T : MvPowerSeries (Fin n) k,
        T = ∑ d ∈ Finset.Iic m, MvPowerSeries.monomial d (MvPowerSeries.coeff d M) := ⟨_, rfl⟩
    obtain ⟨R, hR⟩ : ∃ R : MvPowerSeries (Fin n) k, R = M - T := ⟨_, rfl⟩
    have hMTR : T + R = M := by rw [hR]; abel
    have hTc : ∀ d ≤ m, MvPowerSeries.coeff d T = MvPowerSeries.coeff d M := by
      intro d hd
      rw [hT, map_sum]
      simp only [MvPowerSeries.coeff_monomial]
      rw [Finset.sum_ite_eq]
      simp [Finset.mem_Iic.mpr hd]
    have hRc : ∀ d ≤ m, MvPowerSeries.coeff d R = 0 := by
      intro d hd
      rw [hR, map_sub, hTc d hd, sub_self]
    have hRp : MvPowerSeries.coeff m (R ^ p) = 0 := by
      obtain ⟨q, hq⟩ : ∃ q, p = q + 1 := ⟨p - 1, (Nat.sub_add_cancel hp.one_lt.le).symm⟩
      rw [hq, pow_succ', MvPowerSeries.coeff_mul]
      apply Finset.sum_eq_zero
      intro x hx
      rw [Finset.HasAntidiagonal.mem_antidiagonal] at hx
      rw [hRc x.1 (hx ▸ le_self_add), zero_mul]
    have hTp : T ^ p = ∑ d ∈ Finset.Iic m,
        MvPowerSeries.monomial (p • d) ((MvPowerSeries.coeff d M) ^ p) := by
      rw [hT, sum_pow_char]
      simp only [MvPowerSeries.monomial_pow]
    have hMp : M ^ p = T ^ p + R ^ p := by rw [← add_pow_char, hMTR]
    rw [hMp, map_add, hRp, add_zero, hTp, map_sum]
    simp only [MvPowerSeries.coeff_monomial]
  refine ⟨fun e => ?_, fun m hm => ?_⟩
  · rw [key, Finset.sum_eq_single e]
    · simp
    · intro d _ hde
      rw [if_neg]
      intro h
      apply hde
      ext j
      have := congrArg (fun f => f j) h
      simp only [Finsupp.smul_apply, smul_eq_mul] at this
      exact (Nat.eq_of_mul_eq_mul_left hp.pos this).symm
    · intro he
      exfalso
      apply he
      rw [Finset.mem_Iic, Finsupp.le_def]
      intro j
      simp only [Finsupp.smul_apply, smul_eq_mul]
      exact Nat.le_mul_of_pos_left _ hp.pos
  · rw [key]
    apply Finset.sum_eq_zero
    intro d _
    rw [if_neg]
    rintro rfl
    apply hm
    intro j
    simp only [Finsupp.smul_apply, smul_eq_mul]
    exact Dvd.intro _ rfl

theorem wc_hnas_pfc_gcl_de_power_series_finite : ∀ (p n : ℕ) (k : Type u) [Field k], p.Prime → ∀ (k' : Subfield k), FiniteDimensional k' k → ∃ (ι : Type) (_ : Fintype ι) (t : ι → MvPowerSeries (Fin n) k), ∀ G : MvPowerSeries (Fin n) k, ∃ g : ι → MvPowerSeries (Fin n) k, (∀ i, (∀ e : Fin n →₀ ℕ, MvPowerSeries.coeff e (g i) ∈ k' ∧ (MvPowerSeries.coeff e (g i) ≠ 0 → ∀ j, p ∣ e j))) ∧ G = ∑ i, g i * t i :=
by
  intro p n k _ hp k' hfd
  classical
  haveI := hfd
  have hp0 : 0 < p := hp.pos
  let b : Module.Basis (Fin (Module.finrank k' k)) k' k := Module.finBasis k' k
  let hat : (Fin n → Fin p) → (Fin n →₀ ℕ) :=
    fun E => Finsupp.equivFunOnFinite.symm (fun j => (E j : ℕ))
  have hhat : ∀ E j, hat E j = (E j : ℕ) := fun E j => by
    simp only [hat, Finsupp.coe_equivFunOnFinite_symm]
  refine ⟨Fin (Module.finrank k' k) × (Fin n → Fin p), inferInstance,
    fun i => MvPowerSeries.C (b i.1) * MvPowerSeries.monomial (hat i.2) 1, ?_⟩
  intro G
  let H : (Fin n → Fin p) → MvPowerSeries (Fin n) k := fun E d =>
    if (∀ j, p ∣ d j) then MvPowerSeries.coeff (d + hat E) G else 0
  have hH : ∀ E d, MvPowerSeries.coeff d (H E) =
      if (∀ j, p ∣ d j) then MvPowerSeries.coeff (d + hat E) G else 0 := fun E d => rfl
  let g : Fin (Module.finrank k' k) × (Fin n → Fin p) → MvPowerSeries (Fin n) k :=
    fun i d => ((b.repr (MvPowerSeries.coeff d (H i.2))) i.1 : k)
  have hg : ∀ i d, MvPowerSeries.coeff d (g i) =
      ((b.repr (MvPowerSeries.coeff d (H i.2))) i.1 : k) := fun i d => rfl
  refine ⟨g, ?_, ?_⟩
  · intro i e
    refine ⟨by rw [hg]; exact SetLike.coe_mem _, fun hne => ?_⟩
    by_contra hcon
    apply hne
    rw [hg, hH, if_neg hcon]
    simp
  · ext m
    rw [map_sum]
    simp only [← mul_assoc, MvPowerSeries.coeff_mul_monomial, MvPowerSeries.coeff_mul_C, mul_one]
    rw [Fintype.sum_prod_type_right]
    have key : ∀ E : Fin n → Fin p, (∑ β : Fin (Module.finrank k' k),
        (if hat E ≤ m then MvPowerSeries.coeff (m - hat E) (g (β, E)) * b β else 0)) =
        if hat E ≤ m then MvPowerSeries.coeff (m - hat E) (H E) else 0 := by
      intro E
      split_ifs with hle
      · conv_rhs => rw [← b.sum_repr (MvPowerSeries.coeff (m - hat E) (H E))]
        rfl
      · simp
    simp only [key]
    let E₀ : Fin n → Fin p := fun j => ⟨m j % p, Nat.mod_lt _ hp0⟩
    have hle₀ : hat E₀ ≤ m := by
      intro j
      rw [hhat]
      exact Nat.mod_le _ _
    rw [Fintype.sum_eq_single E₀]
    · rw [if_pos hle₀, hH, if_pos, tsub_add_cancel_of_le hle₀]
      intro j
      rw [Finsupp.tsub_apply, hhat]
      exact Nat.dvd_sub_mod _
    · intro E hE
      split_ifs with hle
      · rw [hH, if_neg]
        intro hdiv
        apply hE
        funext j
        apply Fin.ext
        have h1 := hdiv j
        rw [Finsupp.tsub_apply, hhat] at h1
        have h2 : (E j : ℕ) ≤ m j := by have := hle j; rwa [hhat] at this
        have h3 : (E j : ℕ) % p = m j % p := (Nat.modEq_iff_dvd' h2).mpr h1
        rw [Nat.mod_eq_of_lt (E j).isLt] at h3
        exact h3
      · rfl

theorem wc_hnas_pfc_gcl_de_frob_subring_saturated : (∀ (p : ℕ) (L : Type u) [Field L] [CharP L p], p.Prime → ∀ (E : Subfield L), (∀ y : L, y ^ p ∈ E) → ∀ f : L, f ∉ E → ∃ D : Derivation ℤ L L, (∀ e ∈ E, D e = 0) ∧ D f = 1) → ∀ (p n : ℕ) (k : Type u) [Field k] [CharP k p], p.Prime → ∀ (k' : Subfield k), (∀ y : k, y ^ p ∈ k') → ∀ (d N : MvPowerSeries (Fin n) k), d ≠ 0 → (∀ e : Fin n →₀ ℕ, MvPowerSeries.coeff e d ∈ k' ∧ (MvPowerSeries.coeff e d ≠ 0 → ∀ j, p ∣ e j)) → (∀ e : Fin n →₀ ℕ, MvPowerSeries.coeff e (N * d) ∈ k' ∧ (MvPowerSeries.coeff e (N * d) ≠ 0 → ∀ j, p ∣ e j)) → (∀ e : Fin n →₀ ℕ, MvPowerSeries.coeff e N ∈ k' ∧ (MvPowerSeries.coeff e N ≠ 0 → ∀ j, p ∣ e j)) :=
by
  intro hPI p n k _ _ hp k' hk' d N hd hdS hNdS e
  classical
  constructor
  · by_contra hc
    obtain ⟨θ, hθ0, hθ1⟩ := hPI p k hp k' hk' _ hc
    let Θ : MvPowerSeries (Fin n) k → MvPowerSeries (Fin n) k :=
      fun G m => θ (MvPowerSeries.coeff m G)
    have hΘc : ∀ G m, MvPowerSeries.coeff m (Θ G) = θ (MvPowerSeries.coeff m G) := fun G m => rfl
    have hleib : ∀ G H, Θ (G * H) = G * Θ H + Θ G * H := by
      intro G H
      ext m
      rw [hΘc, map_add, MvPowerSeries.coeff_mul, MvPowerSeries.coeff_mul, MvPowerSeries.coeff_mul,
        map_sum, ← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl fun x _ => ?_
      rw [Derivation.leibniz, smul_eq_mul, smul_eq_mul, hΘc, hΘc]
      ring
    have hd0 : Θ d = 0 := by
      ext m
      rw [hΘc, map_zero]
      exact hθ0 _ (hdS m).1
    have hNd0 : Θ (N * d) = 0 := by
      ext m
      rw [hΘc, map_zero]
      exact hθ0 _ (hNdS m).1
    rw [hleib, hd0, mul_zero, zero_add] at hNd0
    have hN0 : Θ N = 0 := (mul_eq_zero.mp hNd0).resolve_right hd
    have h := hΘc N e
    rw [hN0, map_zero, hθ1] at h
    exact one_ne_zero h.symm
  · intro hne j
    by_contra hpj
    have hkill : ∀ G : MvPowerSeries (Fin n) k,
        (∀ e : Fin n →₀ ℕ, MvPowerSeries.coeff e G ≠ 0 → ∀ j, p ∣ e j) →
        MvPowerSeries.pderiv j G = 0 := by
      intro G hG
      ext m
      rw [MvPowerSeries.coeff_pderiv, map_zero]
      by_cases h0 : MvPowerSeries.coeff (m + Finsupp.single j 1) G = 0
      · rw [h0, zero_mul]
      · have h1 := hG _ h0 j
        rw [Finsupp.add_apply, Finsupp.single_eq_same] at h1
        have h2 : ((m j + 1 : ℕ) : k) = 0 := (CharP.cast_eq_zero_iff k p _).mpr h1
        push_cast at h2
        rw [h2, mul_zero]
    have h1 := hkill d (fun e => (hdS e).2)
    have h2 := hkill (N * d) (fun e => (hNdS e).2)
    rw [Derivation.leibniz, h1, smul_zero, zero_add, smul_eq_mul] at h2
    have hN0 : MvPowerSeries.pderiv j N = 0 := (mul_eq_zero.mp h2).resolve_left hd
    have hej : e j ≠ 0 := fun h => hpj (h ▸ dvd_zero p)
    have hle : Finsupp.single j 1 ≤ e :=
      Finsupp.single_le_iff.mpr (Nat.one_le_iff_ne_zero.mpr hej)
    have hc := congrArg (MvPowerSeries.coeff (e - Finsupp.single j 1)) hN0
    rw [MvPowerSeries.coeff_pderiv, tsub_add_cancel_of_le hle, map_zero] at hc
    have hnat : (e - Finsupp.single j 1 : Fin n →₀ ℕ) j + 1 = e j := by
      rw [Finsupp.tsub_apply, Finsupp.single_eq_same]
      omega
    have hcast : ((((e - Finsupp.single j 1 : Fin n →₀ ℕ) j : ℕ) : k) + 1) = ((e j : ℕ) : k) := by
      rw [← hnat]
      push_cast
      ring
    rw [hcast] at hc
    have hek : ((e j : ℕ) : k) ≠ 0 := fun h => hpj ((CharP.cast_eq_zero_iff k p _).mp h)
    exact (mul_ne_zero hne hek) hc

theorem wc_hnas_pfc_gcl_de_pth_root_of_saturated : (∀ (p n : ℕ) (k : Type u) [Field k] [CharP k p], p.Prime → ∀ (k' : Subfield k), (∀ y : k, y ^ p ∈ k') → ∀ (d N : MvPowerSeries (Fin n) k), d ≠ 0 → (∀ e : Fin n →₀ ℕ, MvPowerSeries.coeff e d ∈ k' ∧ (MvPowerSeries.coeff e d ≠ 0 → ∀ j, p ∣ e j)) → (∀ e : Fin n →₀ ℕ, MvPowerSeries.coeff e (N * d) ∈ k' ∧ (MvPowerSeries.coeff e (N * d) ≠ 0 → ∀ j, p ∣ e j)) → (∀ e : Fin n →₀ ℕ, MvPowerSeries.coeff e N ∈ k' ∧ (MvPowerSeries.coeff e N ≠ 0 → ∀ j, p ∣ e j))) → (∀ (p n : ℕ) (k : Type u) [Field k] [CharP k p], p.Prime → ∀ (M : MvPowerSeries (Fin n) k), (∀ e : Fin n →₀ ℕ, MvPowerSeries.coeff (p • e) (M ^ p) = (MvPowerSeries.coeff e M) ^ p) ∧ ∀ m : Fin n →₀ ℕ, (¬ ∀ j, p ∣ m j) → MvPowerSeries.coeff m (M ^ p) = 0) → ∀ (p n : ℕ) (k : Type u) [Field k] [CharP k p], p.Prime → ∀ (ι : Type u) [Nonempty ι] (F : ι → Subfield k), (∀ i, ∀ y : k, y ^ p ∈ F i) → (∀ c : k, (∀ i, c ∈ F i) → ∃ y : k, y ^ p = c) → ∀ N : MvPowerSeries (Fin n) k, (∀ i, ∃ d : MvPowerSeries (Fin n) k, d ≠ 0 ∧ (∀ e : Fin n →₀ ℕ, MvPowerSeries.coeff e d ∈ F i ∧ (MvPowerSeries.coeff e d ≠ 0 → ∀ j, p ∣ e j)) ∧ (∀ e : Fin n →₀ ℕ, MvPowerSeries.coeff e (N * d) ∈ F i ∧ (MvPowerSeries.coeff e (N * d) ≠ 0 → ∀ j, p ∣ e j))) → ∃ M : MvPowerSeries (Fin n) k, M ^ p = N :=
