    intro R _ J M L _ _ lam₀ hlam A' _ _ _ P _ S _ _ _ D _ _ N _ d θ κ hκθ χD hχR τ' hτ' Φ hΦ
    letI iPS : Algebra (MvPolynomial (Fin d) P) (MvPolynomial (Fin d) S) :=
      MvPolynomial.algebraMvPolynomial
    letI iSD : Algebra (MvPolynomial (Fin d) S) (MvPolynomial (Fin d) D) :=
      MvPolynomial.algebraMvPolynomial
    letI iRS : Algebra R (MvPolynomial (Fin d) S) :=
      ((MvPolynomial.map (algebraMap P S)).comp θ).toAlgebra
    letI iRD : Algebra R (MvPolynomial (Fin d) D) :=
      ((MvPolynomial.map (algebraMap S D)).comp
        ((MvPolynomial.map (algebraMap P S)).comp θ)).toAlgebra
    haveI : IsScalarTower R (MvPolynomial (Fin d) S) (MvPolynomial (Fin d) D) :=
      IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    haveI : IsLocalization (Submonoid.map MvPolynomial.C N) (MvPolynomial (Fin d) D) :=
      MvPolynomial.isLocalization N D
    let χDa : A' →ₐ[R] MvPolynomial (Fin d) D :=
      { χD with commutes' := fun r => RingHom.congr_fun hχR r }

    obtain ⟨s, -, f', j, hfj⟩ := wc_pfc_pd_spread_localization R A' (MvPolynomial (Fin d) S)
      (Submonoid.map MvPolynomial.C N) (MvPolynomial (Fin d) D) χDa

    haveI hT₀ : Algebra.Smooth (MvPolynomial (Fin d) P) (Localization.Away s) :=
      hs11 P S d s (Localization.Away s) (fun p => by
        rw [IsScalarTower.algebraMap_apply (MvPolynomial (Fin d) P) (MvPolynomial (Fin d) S)
          (Localization.Away s)]
        rfl)
    have hf'R : ∀ r, f' (algebraMap R A' r) =
        algebraMap (MvPolynomial (Fin d) P) (Localization.Away s) (θ r) := by
      intro r
      rw [f'.commutes, IsScalarTower.algebraMap_apply R (MvPolynomial (Fin d) S)
        (Localization.Away s), IsScalarTower.algebraMap_apply (MvPolynomial (Fin d) P)
        (MvPolynomial (Fin d) S) (Localization.Away s)]
      rfl
    have hE3 : ∀ p, j (algebraMap (MvPolynomial (Fin d) P) (Localization.Away s) p) =
        MvPolynomial.map (algebraMap S D) (MvPolynomial.map (algebraMap P S) p) := by
      intro p
      rw [IsScalarTower.algebraMap_apply (MvPolynomial (Fin d) P) (MvPolynomial (Fin d) S)
        (Localization.Away s), j.commutes]
      rfl
    let τ₀ : Localization.Away s →+* L := τ'.comp j.toRingHom
    have hF1 : ∀ p, τ₀ (algebraMap (MvPolynomial (Fin d) P) (Localization.Away s) p) =
        lam₀ (κ p) := by
      intro p
      show τ' (j _) = _
