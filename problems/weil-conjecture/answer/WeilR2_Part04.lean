      exact (div_eq_div_iff hv0 hb0).mp hxab
    have hbS : b ^ p ∈ S := (hS _).mpr (hbpow i)
    have hNv : N * v = u * b ^ p := by
      rw [hN, hbp]
      calc a * b ^ (p - 1) * v = (a * v) * b ^ (p - 1) := by ring
        _ = (u * b) * b ^ (p - 1) := by rw [huv]
        _ = u * (b ^ (p - 1) * b) := by ring
    refine ⟨v, fun h => hv0 (by rw [h, map_zero]), (hS v).mp hv, ?_⟩
    rw [hNv]
    exact (hS _).mp (S.mul_mem hu hbS)
  obtain ⟨M, hM⟩ := H12 p n k hp ι F hFpow hFint N hd
  refine ⟨φ M / φ b, Subfield.div_mem _ (Subfield.subset_closure ⟨M, rfl⟩)
    (Subfield.subset_closure ⟨b, rfl⟩), ?_⟩
  rw [div_pow, ← map_pow, hM, hxN]

theorem wc_hnas_pfc_gcl_de_fraction_field_finite : ∀ (B : Type u) [CommRing B] [IsDomain B] (R : Subring B) (ι : Type) [Fintype ι] (t : ι → B), (∀ b : B, ∃ c : ι → B, (∀ i, c i ∈ R) ∧ b = ∑ i, c i * t i) → FiniteDimensional (Subfield.closure (algebraMap B (FractionRing B) '' (R : Set B))) (FractionRing B) :=
by
  intro B _ _ R ι _ t ht
  set K0 := Subfield.closure (algebraMap B (FractionRing B) '' (R : Set B)) with hK0
  let W : Submodule K0 (FractionRing B) :=
    Submodule.span K0 (Set.range (fun i => algebraMap B (FractionRing B) (t i)))
  have imB : ∀ b : B, algebraMap B (FractionRing B) b ∈ W := by
    intro b
    obtain ⟨c, hc, rfl⟩ := ht b
    rw [map_sum]
    refine Submodule.sum_mem W (fun i _ => ?_)
    rw [map_mul]
    have hci : algebraMap B (FractionRing B) (c i) ∈ K0 :=
      Subfield.subset_closure ⟨c i, hc i, rfl⟩
    have e : algebraMap B (FractionRing B) (c i) * algebraMap B (FractionRing B) (t i) =
        (⟨_, hci⟩ : K0) • algebraMap B (FractionRing B) (t i) := rfl
    rw [e]
    exact Submodule.smul_mem W _ (Submodule.subset_span ⟨i, rfl⟩)
  have inner : ∀ i, ∀ w ∈ W, algebraMap B (FractionRing B) (t i) * w ∈ W := by
    intro i w hw
    induction hw using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨j, rfl⟩ := hx
      rw [← map_mul]; exact imB _
    | zero => rw [mul_zero]; exact W.zero_mem
    | add x y _ _ hx hy => rw [mul_add]; exact W.add_mem hx hy
    | smul a x _ hx => rw [mul_smul_comm]; exact W.smul_mem a hx
  have mulW : ∀ w ∈ W, ∀ w' ∈ W, w * w' ∈ W := by
    intro w hw
    induction hw using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨j, rfl⟩ := hx
      exact inner j
    | zero => intro w' _; rw [zero_mul]; exact W.zero_mem
    | add x y _ _ hx hy =>
      intro w' hw'; rw [add_mul]; exact W.add_mem (hx w' hw') (hy w' hw')
    | smul a x _ hx =>
      intro w' hw'; rw [smul_mul_assoc]; exact W.smul_mem a (hx w' hw')
  have hfgW : W.FG := Submodule.fg_span (Set.finite_range _)
  have one_mem : (1 : FractionRing B) ∈ W := by
    rw [← map_one (algebraMap B (FractionRing B))]; exact imB 1
  let A : Subalgebra K0 (FractionRing B) :=
    W.toSubalgebra one_mem (fun x y hx hy => mulW x hx y hy)
  have hWfin : Module.Finite K0 W := Module.Finite.iff_fg.mpr hfgW
  have hAfin : Module.Finite K0 A := hWfin
  have invW : ∀ y : B, (algebraMap B (FractionRing B) y)⁻¹ ∈ W := by
    intro y
    have ha : algebraMap B (FractionRing B) y ∈ A := imB y
    have hint : IsIntegral K0 (⟨_, ha⟩ : A) := IsIntegral.of_finite K0 _
    have hint' : IsIntegral K0 (algebraMap B (FractionRing B) y) := hint.map A.val
    exact Subalgebra.inv_mem_of_algebraic (A := A) (x := ⟨_, ha⟩) hint'.isAlgebraic
  have allW : ∀ z : FractionRing B, z ∈ W := by
    intro z
    obtain ⟨x, y, _, rfl⟩ := IsFractionRing.div_surjective (A := B) z
    rw [div_eq_mul_inv]
    exact mulW _ (imB x) _ (invW y)
  have htop : W = ⊤ := Submodule.eq_top_iff'.mpr allW
  show Module.Finite K0 (FractionRing B)
  rw [Module.finite_def, ← htop]
  exact hfgW

theorem wc_hnas_pfc_gcl_de_clear_denominators : ∀ (B : Type u) [CommRing B] [IsDomain B] (R : Subring B) (ι : Type) [Fintype ι] (t : ι → B), (∀ b : B, ∃ c : ι → B, (∀ i, c i ∈ R) ∧ b = ∑ i, c i * t i) → ∀ (D' : Derivation ℤ (FractionRing B) (FractionRing B)), (∀ r ∈ R, D' (algebraMap B (FractionRing B) r) = 0) → ∀ f : B, D' (algebraMap B (FractionRing B) f) ≠ 0 → ∃ D : Derivation ℤ B B, D f ≠ 0 :=
by
  intro B _ _ R ι _ t ht D' hR f hf
  obtain ⟨b₀, hb₀⟩ := IsLocalization.exist_integer_multiples_of_finite (nonZeroDivisors B)
    (fun i => D' (algebraMap B (FractionRing B) (t i)))
  have hg : algebraMap B (FractionRing B) (b₀ : B) ≠ 0 :=
    IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors b₀.2
  have H1 : ∀ i, ∃ u : B, algebraMap B (FractionRing B) u =
      algebraMap B (FractionRing B) (b₀ : B) * D' (algebraMap B (FractionRing B) (t i)) := by
    intro i
    obtain ⟨u, hu⟩ := hb₀ i
    refine ⟨u, ?_⟩
    rw [hu, Algebra.smul_def]
  choose u hu using H1
  have hinj : Function.Injective (algebraMap B (FractionRing B)) :=
    IsFractionRing.injective B (FractionRing B)
  have key : ∀ b : B, ∃ y : B, algebraMap B (FractionRing B) y =
      algebraMap B (FractionRing B) (b₀ : B) * D' (algebraMap B (FractionRing B) b) := by
    intro b
    obtain ⟨c, hc, rfl⟩ := ht b
    refine ⟨∑ i, c i * u i, ?_⟩
    rw [map_sum, map_sum, map_sum, Finset.mul_sum]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    simp only [map_mul]
    rw [D'.leibniz, hR _ (hc i), smul_zero, add_zero, smul_eq_mul, hu]
    ring
  choose Dfun hD using key
  have hadd : ∀ a b, Dfun (a + b) = Dfun a + Dfun b := by
    intro a b
    apply hinj
    rw [map_add, hD, hD, hD, map_add, map_add, mul_add]
  have hleib : ∀ a b : B, (AddMonoidHom.mk' Dfun hadd) (a * b) =
      a • (AddMonoidHom.mk' Dfun hadd) b + b • (AddMonoidHom.mk' Dfun hadd) a := by
    intro a b
    simp only [AddMonoidHom.mk'_apply, smul_eq_mul]
    apply hinj
    rw [map_add, map_mul, map_mul, hD, hD, hD, map_mul, D'.leibniz, smul_eq_mul, smul_eq_mul]
    ring
  refine ⟨Derivation.mk' (AddMonoidHom.mk' Dfun hadd).toIntLinearMap hleib, ?_⟩
  show Dfun f ≠ 0
  intro h0
  have h1 := hD f
  rw [h0, map_zero] at h1
  exact mul_ne_zero hg hf h1.symm

theorem wc_hnas_pfc_gcl_derivation_exists : ∀ (p n : ℕ) (k : Type u) [Field k] [CharP k p], p.Prime → IsNoetherianRing (MvPowerSeries (Fin n) k) → ∀ (B : Type u) [CommRing B] [IsDomain B] [Algebra (MvPowerSeries (Fin n) k) B], Function.Injective (algebraMap (MvPowerSeries (Fin n) k) B) → Module.Finite (MvPowerSeries (Fin n) k) B → ∀ f : B, (¬ ∃ g : FractionRing B, g ^ p = algebraMap B (FractionRing B) f) → ∃ D : Derivation ℤ B B, D f ≠ 0 :=
by
  intro p n k _ _ hp _ B _ _ _ hinj hfin f hf
  classical
  haveI : Fact p.Prime := ⟨hp⟩

  have s9 : ∀ (p n : ℕ) (k : Type u) [Field k] (k' : Subfield k), ∃ S : Subring (MvPowerSeries (Fin n) k), ∀ G : MvPowerSeries (Fin n) k, G ∈ S ↔ (∀ e : Fin n →₀ ℕ, MvPowerSeries.coeff e G ∈ k' ∧ (MvPowerSeries.coeff e G ≠ 0 → ∀ j, p ∣ e j)) := by
    intro p n k _ k'
    refine ⟨{ carrier := {G | ∀ e : Fin n →₀ ℕ, MvPowerSeries.coeff e G ∈ k' ∧ (MvPowerSeries.coeff e G ≠ 0 → ∀ j, p ∣ e j)}
              mul_mem' := by
                intro G H hG hH e
                rw [MvPowerSeries.coeff_mul]
                refine ⟨Subfield.sum_mem _ fun x _ => Subfield.mul_mem _ (hG x.1).1 (hH x.2).1, fun hne j => ?_⟩
                obtain ⟨x, hx, hx0⟩ := Finset.exists_ne_zero_of_sum_ne_zero hne
                rw [Finset.HasAntidiagonal.mem_antidiagonal] at hx
                rw [← hx, Finsupp.add_apply]
                exact dvd_add ((hG x.1).2 (left_ne_zero_of_mul hx0) j) ((hH x.2).2 (right_ne_zero_of_mul hx0) j)
              one_mem' := by
                intro e
                rw [MvPowerSeries.coeff_one]
                split_ifs with h
                · exact ⟨Subfield.one_mem _, fun _ j => by simp [h]⟩
                · exact ⟨Subfield.zero_mem _, fun h0 => absurd rfl h0⟩
              add_mem' := by
                intro G H hG hH e
                rw [map_add]
                refine ⟨Subfield.add_mem _ (hG e).1 (hH e).1, fun hne => ?_⟩
                by_cases h0 : MvPowerSeries.coeff e G = 0
                · rw [h0, zero_add] at hne; exact (hH e).2 hne
                · exact (hG e).2 h0
              zero_mem' := by
                intro e
                rw [map_zero]
                exact ⟨Subfield.zero_mem _, fun h0 => absurd rfl h0⟩
              neg_mem' := by
                intro G hG e
                rw [map_neg]
                exact ⟨Subfield.neg_mem _ (hG e).1, fun hne => (hG e).2 (neg_ne_zero.mp hne)⟩ },
      fun G => Iff.rfl⟩

  have s16 : ∀ (A B : Type u) [CommRing A] [CommRing B] [Algebra A B], Module.Finite A B → ∀ (S : Subring A) (ι : Type) [Fintype ι] (t : ι → A), (∀ G : A, ∃ g : ι → A, (∀ i, g i ∈ S) ∧ G = ∑ i, g i * t i) → ∃ (κ : Type) (_ : Fintype κ) (t' : κ → B), ∀ b : B, ∃ c : κ → B, (∀ i, c i ∈ S.map (algebraMap A B)) ∧ b = ∑ i, c i * t' i := by
    intro A B _ _ _ hfin S ι _ t ht
    haveI := hfin
    obtain ⟨m, s, hs⟩ := Module.Finite.exists_fin (R := A) (M := B)
    choose g hgS hg using ht
    refine ⟨ι × Fin m, inferInstance, fun x => algebraMap A B (t x.1) * s x.2, fun b => ?_⟩
    have hb : b ∈ Submodule.span A (Set.range s) := by rw [hs]; trivial
    obtain ⟨a, ha⟩ := (Submodule.mem_span_range_iff_exists_fun A).mp hb
    refine ⟨fun x => algebraMap A B (g (a x.2) x.1), fun x => Subring.mem_map.mpr ⟨_, hgS _ x.1, rfl⟩, ?_⟩
    rw [← ha, Fintype.sum_prod_type_right]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [Algebra.smul_def]
    conv_lhs => rw [hg (a j)]
    rw [map_sum, Finset.sum_mul]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [map_mul]
    ring

  haveI hcA : CharP (MvPowerSeries (Fin n) k) p :=
    charP_of_injective_algebraMap (algebraMap k (MvPowerSeries (Fin n) k)).injective p
  haveI hcB : CharP B p := charP_of_injective_algebraMap hinj p
  haveI hcL : CharP (FractionRing B) p :=
    charP_of_injective_algebraMap (IsFractionRing.injective B (FractionRing B)) p
  haveI : ExpChar (FractionRing B) p := ExpChar.prime hp

  have s1 := wc_hnas_pfc_gcl_de_simple_ext
  have s2 := wc_hnas_pfc_gcl_de_exchange s1
  have C1 := wc_hnas_pfc_gcl_de_purely_insep_derivation s1 (wc_hnas_pfc_gcl_de_maximal_avoiding s2)
  have C3 := wc_hnas_pfc_gcl_de_compositum_intersection (wc_hnas_pfc_gcl_de_compositum_simple s1)
  have C9 := wc_hnas_pfc_gcl_de_frac_pth_root
    (wc_hnas_pfc_gcl_de_pth_root_of_saturated (wc_hnas_pfc_gcl_de_frob_subring_saturated C1)
      wc_hnas_pfc_gcl_de_frobenius_coeff) wc_hnas_pfc_gcl_de_frobenius_coeff s9
  obtain ⟨P, hPfin, hPint⟩ := wc_hnas_pfc_gcl_de_p_basis s1 s2 p k hp

  obtain ⟨kJ, kpow, kanti, kint, kfd⟩ : ∃ kJ : Finset k → Subfield k,
      (∀ J (y : k), y ^ p ∈ kJ J) ∧ (∀ J J', J ⊆ J' → kJ J' ≤ kJ J) ∧
      (∀ c : k, (∀ J, c ∈ kJ J) → ∃ y : k, y ^ p = c) ∧ (∀ J, FiniteDimensional (kJ J) k) :=
    ⟨fun J => Subfield.closure (Set.range (fun y : k => y ^ p) ∪ (P \ (J : Set k))),
      fun J y => Subfield.subset_closure (Or.inl ⟨y, rfl⟩),
      fun J J' hJ => Subfield.closure_mono
        (Set.union_subset_union_right _ (Set.diff_subset_diff_right (Finset.coe_subset.mpr hJ))),
      hPint, hPfin⟩

  have hpowIn : ∀ J (a : MvPowerSeries (Fin n) k), ∀ e : Fin n →₀ ℕ,
      MvPowerSeries.coeff e (a ^ p) ∈ kJ J ∧ (MvPowerSeries.coeff e (a ^ p) ≠ 0 → ∀ j, p ∣ e j) := by
    intro J a e
    obtain ⟨h1, h2⟩ := wc_hnas_pfc_gcl_de_frobenius_coeff p n k hp a
    by_cases hd : ∀ j, p ∣ e j
    · refine ⟨?_, fun _ => hd⟩
      have he : p • Finsupp.mapRange (fun m => m / p) (Nat.zero_div p) e = e := by
        ext j
        simp only [Finsupp.smul_apply, Finsupp.mapRange_apply, smul_eq_mul]
        exact Nat.mul_div_cancel' (hd j)
      rw [← he, h1]
      exact kpow J _
    · rw [h2 e hd]
      exact ⟨Subfield.zero_mem _, fun h0 => absurd rfl h0⟩

  obtain ⟨φ, hφ⟩ : ∃ φ : MvPowerSeries (Fin n) k →+* FractionRing B,
      ∀ a, φ a = algebraMap B (FractionRing B) (algebraMap (MvPowerSeries (Fin n) k) B a) :=
    ⟨(algebraMap B (FractionRing B)).comp (algebraMap (MvPowerSeries (Fin n) k) B), fun _ => rfl⟩
  have hφinj : Function.Injective φ := by
    intro a b hab
    rw [hφ, hφ] at hab
    exact hinj (IsFractionRing.injective B (FractionRing B) hab)

  obtain ⟨F, hF⟩ : ∃ F : Finset k → Subfield (FractionRing B), ∀ J, F J = Subfield.closure (φ ''
      {G : MvPowerSeries (Fin n) k | (∀ e : Fin n →₀ ℕ, MvPowerSeries.coeff e G ∈ kJ J ∧
        (MvPowerSeries.coeff e G ≠ 0 → ∀ j, p ∣ e j))}) := ⟨_, fun _ => rfl⟩

  have hK0fd : FiniteDimensional (Subfield.closure (Set.range φ)) (FractionRing B) := by
    obtain ⟨κ, _, t', ht'⟩ := s16 (MvPowerSeries (Fin n) k) B hfin ⊤ Unit (fun _ => 1)
      (fun G => ⟨fun _ => G, fun _ => Subring.mem_top _, by simp⟩)
    have h14 := wc_hnas_pfc_gcl_de_fraction_field_finite B _ κ t' ht'
    have hset : (algebraMap B (FractionRing B)) ''
        ((Subring.map (algebraMap (MvPowerSeries (Fin n) k) B) ⊤ : Subring B) : Set B) =
        Set.range φ := by
      ext x
      simp only [Set.mem_image, SetLike.mem_coe, Subring.mem_map, Subring.mem_top, true_and,
        Set.mem_range]
      constructor
      · rintro ⟨b, ⟨a, rfl⟩, rfl⟩
        exact ⟨a, hφ a⟩
      · rintro ⟨a, rfl⟩
        exact ⟨_, ⟨a, rfl⟩, (hφ a).symm⟩
    rw [hset] at h14
    exact h14

  have hFle : ∀ J, F J ≤ Subfield.closure (Set.range φ) := by
    intro J
    rw [hF]
    exact Subfield.closure_mono (Set.image_subset_range _ _)
  have hFpow : ∀ J, ∀ y ∈ Subfield.closure (Set.range φ), y ^ p ∈ F J := by
    intro J y hy
    have hle : Subfield.closure (Set.range φ) ≤ (F J).comap (frobenius (FractionRing B) p) := by
      rw [Subfield.closure_le]
      rintro _ ⟨a, rfl⟩
      show frobenius (FractionRing B) p (φ a) ∈ F J
      rw [frobenius_def, ← map_pow, hF]
      exact Subfield.subset_closure ⟨a ^ p, hpowIn J a, rfl⟩
    have := hle hy
    rwa [Subfield.mem_comap, frobenius_def] at this
  have hdir : ∀ J J', ∃ l, F l ≤ F J ⊓ F J' := by
    intro J J'
    refine ⟨J ∪ J', le_inf ?_ ?_⟩
    · rw [hF, hF]
      exact Subfield.closure_mono (Set.image_mono fun G hG e =>
        ⟨kanti J (J ∪ J') Finset.subset_union_left (hG e).1, (hG e).2⟩)
    · rw [hF, hF]
      exact Subfield.closure_mono (Set.image_mono fun G hG e =>
        ⟨kanti J' (J ∪ J') Finset.subset_union_right (hG e).1, (hG e).2⟩)
  have hint : ∀ x ∈ Subfield.closure (Set.range φ), (∀ J, x ∈ F J) →
      ∃ y ∈ Subfield.closure (Set.range φ), y ^ p = x := by
    intro x hx hJ
    exact C9 p n k hp (FractionRing B) φ hφinj (Finset k) kJ kpow kint x hx
      (fun J => by rw [← hF]; exact hJ J)

  have hJ0 : ∃ J0, algebraMap B (FractionRing B) f ∉ Subfield.closure
      ((fun y : FractionRing B => y ^ p) '' ((⊤ : Subfield (FractionRing B)) : Set (FractionRing B)) ∪
        (F J0 : Set (FractionRing B))) := by
    by_contra hcon
    push_neg at hcon
    obtain ⟨g, -, hg⟩ := C3 p (FractionRing B) hp (Subfield.closure (Set.range φ)) ⊤ le_top hK0fd
      (Finset k) F hFle hFpow hdir hint _ (Subfield.mem_top _) hcon
    exact hf ⟨g, hg⟩
  obtain ⟨J0, hJ0⟩ := hJ0

  obtain ⟨D', hD'E, hD'f⟩ := C1 p (FractionRing B) hp _
    (fun y => Subfield.subset_closure (Or.inl ⟨y, Subfield.mem_top y, rfl⟩)) _ hJ0

  obtain ⟨S, hS⟩ := s9 p n k (kJ J0)
  obtain ⟨ι, _, t, ht⟩ := wc_hnas_pfc_gcl_de_power_series_finite p n k hp (kJ J0) (kfd J0)
  obtain ⟨κ, _, t', ht'⟩ := s16 (MvPowerSeries (Fin n) k) B hfin S ι t (fun G => by
    obtain ⟨g, hg, hG⟩ := ht G
    exact ⟨g, fun i => (hS (g i)).mpr (hg i), hG⟩)

  refine wc_hnas_pfc_gcl_de_clear_denominators B _ κ t' ht'
    { toFun := D'
      map_add' := fun x y => map_add D' x y
      map_smul' := fun m x => by
        rw [Algebra.smul_def, eq_intCast, ← zsmul_eq_mul, RingHom.id_apply]
        exact map_zsmul D' m x
      map_one_eq_zero' := by
        letI : Algebra ℤ (FractionRing B) := Ring.toIntAlgebra _
        exact D'.map_one_eq_zero
      leibniz' := by
        letI : Algebra ℤ (FractionRing B) := Ring.toIntAlgebra _
        exact D'.leibniz } ?_ f
    (by change D' _ ≠ 0; rw [hD'f]; exact one_ne_zero)
  intro r hr
  obtain ⟨G, hG, rfl⟩ := Subring.mem_map.mp hr
  change D' _ = 0
  apply hD'E
  rw [← hφ]
  refine Subfield.subset_closure (Or.inr ?_)
  show φ G ∈ F J0
  rw [hF]
  exact Subfield.subset_closure ⟨G, (hS G).mp hG, rfl⟩

theorem wc_hnas_pfc_gcl_derivation_extend : ∀ (T : Type u) [CommRing T], (∀ (I : Ideal T) (D : Derivation ℤ T T), ∃ D' : Derivation ℤ (AdicCompletion I T) (AdicCompletion I T), ∀ t : T, D' (algebraMap T (AdicCompletion I T) t) = algebraMap T (AdicCompletion I T) (D t)) ∧ (∀ (M : Submonoid T) (D : Derivation ℤ T T), ∃ D' : Derivation ℤ (Localization M) (Localization M), ∀ t : T, D' (algebraMap T (Localization M) t) = algebraMap T (Localization M) (D t)) :=
by
  intro T _
  constructor
  · intro I D

    have hD : ∀ (n : ℕ) (x : T), x ∈ I ^ (n + 1) → D x ∈ I ^ n := by
      intro n
      induction n with
      | zero => intro x _; simp
      | succ n ih =>
        intro x hx
        rw [pow_succ] at hx
        refine Submodule.mul_induction_on hx ?_ ?_
        · intro a ha b hb
          rw [Derivation.leibniz, smul_eq_mul, smul_eq_mul]
          refine add_mem (Ideal.mul_mem_right _ _ ha) ?_
          rw [pow_succ']
          exact Ideal.mul_mem_mul hb (ih a ha)
        · intro x y hx hy
          rw [map_add]
          exact add_mem hx hy

    have trunc : ∀ (x : AdicCompletion I T) {m k : ℕ}, m ≤ k → ∀ s : T,
        AdicCompletion.evalₐ I k x = Ideal.Quotient.mk (I ^ k) s →
        AdicCompletion.evalₐ I m x = Ideal.Quotient.mk (I ^ m) s := by
      intro x m k hle s hs
      obtain ⟨f, rfl⟩ := AdicCompletion.mk_surjective I T x
      rw [AdicCompletion.evalₐ_mk] at hs ⊢
      have h1 := AdicCompletion.AdicCauchySequence.mk_eq_mk (I := I) (M := T) hle f
      have h2 := (Submodule.Quotient.eq _).mp h1
      have h3 : (f k : T) - f m ∈ I ^ m := by simpa [smul_eq_mul, Ideal.mul_top] using h2
      rw [Ideal.Quotient.eq] at hs ⊢
      have h4 : (f k : T) - s ∈ I ^ m := Ideal.pow_le_pow_right hle hs
      have e : (f m : T) - s = (f k - s) - (f k - f m) := by ring
      rw [e]
      exact sub_mem h4 h3
    have hlift : ∀ (x : AdicCompletion I T) (n : ℕ), ∃ t : T,
        AdicCompletion.evalₐ I n x = Ideal.Quotient.mk (I ^ n) t := by
      intro x n
      obtain ⟨t, ht⟩ := Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ I n x)
      exact ⟨t, ht.symm⟩
    choose ℓ hℓ using hlift
    have hchar0 : ∀ (x : AdicCompletion I T) (n : ℕ) (t : T),
        AdicCompletion.evalₐ I (n + 1) x = Ideal.Quotient.mk (I ^ (n + 1)) t →
        D t - D (ℓ x (n + 1)) ∈ I ^ n := by
      intro x n t ht
      rw [← map_sub]
      apply hD
      rw [← Ideal.Quotient.eq, ← ht]
      exact hℓ x (n + 1)
    have hcauchy : ∀ x : AdicCompletion I T, ∀ n : ℕ,
        D (ℓ x (n + 1)) ≡ D (ℓ x (n + 1 + 1)) [SMOD (I ^ n • ⊤ : Submodule T T)] := by
      intro x n
      have h := hchar0 x n (ℓ x (n + 2)) (trunc x (Nat.le_succ (n + 1)) _ (hℓ x (n + 2)))
      rw [SModEq.sub_mem]
      have h' : D (ℓ x (n + 1)) - D (ℓ x (n + 1 + 1)) ∈ I ^ n := by
        rw [← neg_sub]
        exact neg_mem h
      simpa [smul_eq_mul, Ideal.mul_top] using h'
    let E : AdicCompletion I T → AdicCompletion I T := fun x =>
      AdicCompletion.mk I T (AdicCompletion.AdicCauchySequence.mk I T
        (fun n => D (ℓ x (n + 1))) (hcauchy x))
    have hE : ∀ (x : AdicCompletion I T) (n : ℕ) (t : T),
        AdicCompletion.evalₐ I (n + 1) x = Ideal.Quotient.mk (I ^ (n + 1)) t →
        AdicCompletion.evalₐ I n (E x) = Ideal.Quotient.mk (I ^ n) (D t) := by
      intro x n t ht
      show AdicCompletion.evalₐ I n (AdicCompletion.mk I T (AdicCompletion.AdicCauchySequence.mk I T
        (fun n => D (ℓ x (n + 1))) (hcauchy x))) = _
      rw [AdicCompletion.evalₐ_mk]
      change Ideal.Quotient.mk (I ^ n) (D (ℓ x (n + 1))) = _
      exact (Ideal.Quotient.eq.mpr (hchar0 x n t ht)).symm
    have hadd : ∀ x y, E (x + y) = E x + E y := by
      intro x y
      apply AdicCompletion.ext_evalₐ
      intro n
      rw [map_add, hE x n _ (hℓ x (n + 1)), hE y n _ (hℓ y (n + 1)),
        hE (x + y) n (ℓ x (n + 1) + ℓ y (n + 1)) (by rw [map_add, map_add, hℓ, hℓ]),
        map_add D, map_add]
    have hleib : ∀ x y : AdicCompletion I T, E (x * y) = x • E y + y • E x := by
      intro x y
      rw [smul_eq_mul, smul_eq_mul]
      apply AdicCompletion.ext_evalₐ
      intro n
      have hx : AdicCompletion.evalₐ I n x = Ideal.Quotient.mk (I ^ n) (ℓ x (n + 1)) :=
        trunc x (Nat.le_succ n) _ (hℓ x (n + 1))
      have hy : AdicCompletion.evalₐ I n y = Ideal.Quotient.mk (I ^ n) (ℓ y (n + 1)) :=
        trunc y (Nat.le_succ n) _ (hℓ y (n + 1))
      rw [map_add, map_mul, map_mul, hx, hy, hE x n _ (hℓ x (n + 1)), hE y n _ (hℓ y (n + 1)),
        hE (x * y) n (ℓ x (n + 1) * ℓ y (n + 1)) (by rw [map_mul, map_mul, hℓ, hℓ]),
        Derivation.leibniz]
      simp only [smul_eq_mul, map_add, map_mul]
    have hev : ∀ (k : ℕ) (s : T), AdicCompletion.evalₐ I k
        (algebraMap T (AdicCompletion I T) s) = Ideal.Quotient.mk (I ^ k) s := by
      intro k s
      rw [AlgHom.commutes]
      rfl
    let δ : AdicCompletion I T →+ AdicCompletion I T := AddMonoidHom.mk' E hadd
    refine ⟨Derivation.mk' δ.toIntLinearMap (fun a b => hleib a b), fun t => ?_⟩
    show E (algebraMap T (AdicCompletion I T) t) = _
    apply AdicCompletion.ext_evalₐ
    intro n
    rw [hE _ n t (hev (n + 1) t), hev]
  · intro M D
    let L := Localization M
    let j := algebraMap T L
    let g : T →+* TrivSqZeroExt L L :=
      { toFun := fun t => ((j t, j (D t)) : TrivSqZeroExt L L)
        map_one' := by
          refine TrivSqZeroExt.ext ?_ ?_
          · change j 1 = 1
            exact map_one j
          · change j (D 1) = 0
            rw [Derivation.map_one_eq_zero, map_zero]
        map_mul' := fun a b => by
          refine TrivSqZeroExt.ext ?_ ?_
          · change j (a * b) = j a * j b
            exact map_mul j a b
          · change j (D (a * b)) = j a • j (D b) + MulOpposite.op (j b) • j (D a)
            rw [Derivation.leibniz]
            simp only [smul_eq_mul, op_smul_eq_mul, map_add, map_mul]
            ring
        map_zero' := by
          refine TrivSqZeroExt.ext ?_ ?_
          · change j 0 = 0
            exact map_zero j
          · change j (D 0) = 0
            rw [map_zero, map_zero]
        map_add' := fun a b => by
          refine TrivSqZeroExt.ext ?_ ?_
          · change j (a + b) = j a + j b
            exact map_add j a b
          · change j (D (a + b)) = j (D a) + j (D b)
            rw [map_add, map_add] }
    have hunits : ∀ y : M, IsUnit (g y) := by
      intro y
      rw [TrivSqZeroExt.isUnit_iff_isUnit_fst]
      exact IsLocalization.map_units L y
    let ψ : L →+* TrivSqZeroExt L L := IsLocalization.lift (M := M) (S := L) hunits
    have hψ : ∀ t : T, ψ (j t) = g t := fun t => IsLocalization.lift_eq hunits t
    let fstR : TrivSqZeroExt L L →+* L :=
      { toFun := TrivSqZeroExt.fst
        map_one' := TrivSqZeroExt.fst_one
        map_mul' := fun a b => TrivSqZeroExt.fst_mul a b
        map_zero' := TrivSqZeroExt.fst_zero
        map_add' := fun a b => TrivSqZeroExt.fst_add a b }
    have hfst : ∀ x : L, (ψ x).fst = x := by
      have h : fstR.comp ψ = RingHom.id L := by
        apply IsLocalization.ringHom_ext M
        ext t
        show (ψ (j t)).fst = j t
        rw [hψ]
        rfl
      intro x
      exact RingHom.congr_fun h x
    let δ0 : L →+ L :=
      { toFun := fun x => (ψ x).snd
        map_zero' := by rw [map_zero]; rfl
        map_add' := fun x y => by rw [map_add]; rfl }
    refine ⟨{ toFun := fun x => (ψ x).snd
              map_add' := fun x y => map_add δ0 x y
              map_smul' := ?_
              map_one_eq_zero' := ?_
              leibniz' := ?_ }, fun t => ?_⟩
    · intro c x
      rw [RingHom.id_apply]
      have hsm : (ψ ((c : L) * x)).snd = (c : L) * (ψ x).snd := by
        rw [map_mul, map_intCast, TrivSqZeroExt.snd_mul, hfst]
        have h1 : ((c : TrivSqZeroExt L L)).fst = (c : L) := by
          rw [← map_intCast fstR]; rfl
        have h2 : ((c : TrivSqZeroExt L L)).snd = 0 := by
          rw [← map_intCast g c]
          change j (D (c : T)) = 0
          rw [Derivation.map_intCast, map_zero]
        rw [h1, h2, smul_zero, add_zero, smul_eq_mul]
      convert hsm using 2 <;> simp [Algebra.smul_def] <;> rw [map_intCast]
    · change (ψ 1).snd = 0
      rw [map_one]
      rfl
    · intro x y
      change (ψ (x * y)).snd = x • (ψ y).snd + y • (ψ x).snd
      rw [map_mul, TrivSqZeroExt.snd_mul, hfst, hfst]
      simp only [smul_eq_mul, op_smul_eq_mul]
      ring
    · change (ψ (j t)).snd = j (D t)
      rw [hψ]
      rfl

theorem wc_hnas_pfc_gcl_psc_insep_induction : ∀ (p : ℕ) (K : Type u) [Field K] [CharP K p], p.Prime → ∀ (Q : ∀ (L : Type u) [Field L] [Algebra K L], Prop), (∀ (L : Type u) [Field L] [Algebra K L], Module.finrank K L = 1 → Q L) → (∀ (L : Type u) [Field L] [Algebra K L] [FiniteDimensional K L] (M : Type u) [Field M] [Algebra K M] [Algebra M L] [IsScalarTower K M L] [FiniteDimensional K M] (β : L) (f : M), (∀ g : M, g ^ p ≠ f) → algebraMap M L f = β ^ p → IntermediateField.adjoin M {β} = ⊤ → Q M → Q L) → ∀ (L : Type u) [Field L] [Algebra K L] [FiniteDimensional K L] [IsPurelyInseparable K L], Q L :=
by
  classical
  intro p K _ _ hp Q hbase hstep

  have s1 : ∀ (L : Type u) [Field L] [Algebra K L] [FiniteDimensional K L],
      Module.finrank K L ≠ 1 → ∃ E : IntermediateField K L, E ≠ ⊤ ∧
        ∀ F : IntermediateField K L, E ≤ F → F ≠ E → F = ⊤ := by
    intro L _ _ _ h1
    have hpos : 0 < Module.finrank K L := Module.finrank_pos
    have hP : ∃ j : ℕ, ∃ E : IntermediateField K L, E ≠ ⊤ ∧
        Module.finrank K E + j = Module.finrank K L := by
      refine ⟨Module.finrank K L - 1, ⊥, ?_, ?_⟩
      · intro h
        exact h1 (IntermediateField.bot_eq_top_iff_finrank_eq_one.mp h)
      · rw [IntermediateField.finrank_bot]; omega
    obtain ⟨E₀, hE₀, hd⟩ := Nat.find_spec hP
    refine ⟨E₀, hE₀, fun F hle hne => ?_⟩
    by_contra hFtop
    haveI : FiniteDimensional K F := IntermediateField.finiteDimensional_left F
    haveI : FiniteDimensional K (⊤ : IntermediateField K L) :=
      IntermediateField.finiteDimensional_left ⊤
    have h1' : Module.finrank K E₀ < Module.finrank K F := by
      by_contra hc
      push_neg at hc
      exact hne (IntermediateField.eq_of_le_of_finrank_le hle hc).symm
    have h2' : Module.finrank K F < Module.finrank K L := by
      by_contra hc
      push_neg at hc
      apply hFtop
      apply IntermediateField.eq_of_le_of_finrank_le le_top
      rw [IntermediateField.finrank_top']; exact hc
    have hmin := Nat.find_min' hP ⟨F, hFtop,
      (by omega : Module.finrank K F + (Module.finrank K L - Module.finrank K F)
        = Module.finrank K L)⟩
    omega

  have s2 : ∀ (L : Type u) [Field L] [Algebra K L] [IsPurelyInseparable K L]
      (E : IntermediateField K L) (β : L), β ∉ E →
        ∃ γ : L, γ ∉ E ∧ γ ^ p ∈ E ∧ ∀ g : L, g ^ p = γ ^ p → g = γ := by
    intro L _ _ _ E β hβ
    haveI : ExpChar K p := ExpChar.prime hp
    haveI : CharP L p := charP_of_injective_algebraMap (algebraMap K L).injective p
    haveI : Fact p.Prime := ⟨hp⟩
    have hex : ∃ j : ℕ, β ^ p ^ j ∈ E := by
      obtain ⟨n, hn⟩ := IsPurelyInseparable.pow_mem K p β
      obtain ⟨c, hc⟩ := RingHom.mem_range.mp hn
      refine ⟨n, ?_⟩
      rw [← hc]
      exact E.algebraMap_mem c
    have hj0 : Nat.find hex ≠ 0 := by
      intro h
      have := Nat.find_spec hex
      rw [h, pow_zero, pow_one] at this
      exact hβ this
    refine ⟨β ^ p ^ (Nat.find hex - 1), Nat.find_min hex (by omega), ?_, ?_⟩
    · rw [← pow_mul, ← pow_succ, Nat.sub_add_cancel (Nat.one_le_iff_ne_zero.mpr hj0)]
      exact Nat.find_spec hex
    · intro g hg
      have h0 : (g - β ^ p ^ (Nat.find hex - 1)) ^ p = 0 := by
        rw [sub_pow_char, hg, sub_self]
      exact sub_eq_zero.mp ((pow_eq_zero_iff hp.ne_zero).mp h0)

  have s3 : ∀ (L : Type u) [Field L] [Algebra K L] (E : IntermediateField K L),
      (∀ F : IntermediateField K L, E ≤ F → F ≠ E → F = ⊤) →
        ∀ γ : L, γ ∉ E → IntermediateField.adjoin E {γ} = ⊤ := by
    intro L _ _ E hmax γ hγ
    apply IntermediateField.restrictScalars_injective K
    rw [IntermediateField.restrictScalars_top, IntermediateField.restrictScalars_adjoin]
    apply hmax
    · intro x hx
      exact IntermediateField.subset_adjoin K _ (Set.mem_union_left _ hx)
    · intro h
      apply hγ
      rw [← h]
      exact IntermediateField.subset_adjoin K _ (Set.mem_union_right _ rfl)

  have main : ∀ d : ℕ, ∀ (L : Type u) [Field L] [Algebra K L] [FiniteDimensional K L]
      [IsPurelyInseparable K L], Module.finrank K L = d → Q L := by
    intro d
    induction d using Nat.strong_induction_on with
    | _ d IH =>
    intro L _ _ _ _ hd
    by_cases h1 : d = 1
    · exact hbase L (hd.trans h1)
    obtain ⟨E₀, hE₀, hmax⟩ := s1 L (by rw [hd]; exact h1)
    obtain ⟨β, hβ⟩ : ∃ β : L, β ∉ E₀ := by
      by_contra hc
      push_neg at hc
      exact hE₀ (eq_top_iff.mpr (fun x _ => hc x))
    obtain ⟨γ, hγE, hγp, huniq⟩ := s2 L E₀ β hβ
    let f : E₀ := ⟨γ ^ p, hγp⟩
    have hfnot : ∀ g : E₀, g ^ p ≠ f := by
      intro g hg
      have hg' : (g : L) ^ p = γ ^ p := by
        have := congrArg (fun x : E₀ => (x : L)) hg
        simpa [f] using this
      apply hγE
      rw [← huniq _ hg']
      exact g.2
    have hadj := s3 L E₀ hmax γ hγE
    haveI : FiniteDimensional K E₀ := IntermediateField.finiteDimensional_left E₀
    haveI : IsPurelyInseparable K E₀ := IsPurelyInseparable.tower_bot K E₀ L
    haveI : FiniteDimensional K (⊤ : IntermediateField K L) :=
      IntermediateField.finiteDimensional_left ⊤
    have hlt : Module.finrank K E₀ < d := by
      by_contra hc
      push_neg at hc
      apply hE₀
      apply IntermediateField.eq_of_le_of_finrank_le le_top
      rw [IntermediateField.finrank_top', hd]; exact hc
    have hQ : Q E₀ := IH _ hlt E₀ rfl
    exact hstep L E₀ γ f hfnot rfl hadj hQ
  intro L _ _ _ _
  exact main _ L rfl

theorem wc_hnas_pfc_gcl_psc_adjoin_root_tensor : ∀ (p : ℕ) (K : Type u) [Field K] (M : Type u) [Field M] [Algebra K M] (L : Type u) [Field L] [Algebra K L] [Algebra M L] [IsScalarTower K M L] (β : L) (f : M), p.Prime → (∀ g : M, g ^ p ≠ f) → algebraMap M L f = β ^ p → IntermediateField.adjoin M {β} = ⊤ → ∀ (B : Type u) [CommRing B] [Algebra K B], Nonempty (TensorProduct K L B ≃+* (Polynomial (TensorProduct K M B) ⧸ Ideal.span {(Polynomial.X ^ p - Polynomial.C (algebraMap M (TensorProduct K M B) f) : Polynomial (TensorProduct K M B))})) :=
by
  intro p K _ M _ _ L _ _ _ _ β f hp hf hβ hadj B _ _
  have hint : IsIntegral M β := by
    apply IsIntegral.of_pow hp.pos
    rw [← hβ]; exact isIntegral_algebraMap
  have hirr : Irreducible (Polynomial.X ^ p - Polynomial.C f : Polynomial M) :=
    X_pow_sub_C_irreducible_of_prime hp hf
  have hmon : (Polynomial.X ^ p - Polynomial.C f : Polynomial M).Monic :=
    Polynomial.monic_X_pow_sub_C f hp.ne_zero
  have haev : Polynomial.aeval β (Polynomial.X ^ p - Polynomial.C f : Polynomial M) = 0 := by
    rw [Polynomial.aeval_sub, Polynomial.aeval_X_pow, Polynomial.aeval_C, hβ, sub_self]
  have hg : (Polynomial.X ^ p - Polynomial.C f : Polynomial M) = minpoly M β :=
    minpoly.eq_of_irreducible_of_monic hirr haev hmon
  let e0 : AdjoinRoot (minpoly M β) ≃ₐ[M] L :=
    ((IntermediateField.adjoinRootEquivAdjoin M hint).trans
      (IntermediateField.equivOfEq hadj)).trans IntermediateField.topEquiv
  let eK : L ≃ₐ[K] AdjoinRoot (minpoly M β) := e0.symm.restrictScalars K
  let E1 : TensorProduct K L B ≃ₐ[K] TensorProduct K B (AdjoinRoot (minpoly M β)) :=
    (Algebra.TensorProduct.congr eK AlgEquiv.refl).trans
      (Algebra.TensorProduct.comm K (AdjoinRoot (minpoly M β)) B)
  let q : Polynomial (TensorProduct K B M) :=
    (minpoly M β).map (Algebra.TensorProduct.includeRight : M →ₐ[K] TensorProduct K B M).toRingHom
  let E2 := AdjoinRoot.tensorAlgEquiv (R := K) (T := B) (minpoly M β) q rfl
  let cm : TensorProduct K B M ≃+* TensorProduct K M B := (Algebra.TensorProduct.comm K B M).toRingEquiv
  have hr : Ideal.span {(Polynomial.X ^ p - Polynomial.C (algebraMap M (TensorProduct K M B) f) : Polynomial (TensorProduct K M B))}
      = (Ideal.span {q}).map (Polynomial.mapEquiv cm) := by
    rw [Ideal.map_span, Set.image_singleton]
    refine congrArg (fun t => Ideal.span {t}) ?_
    show _ = q.map (cm : TensorProduct K B M →+* TensorProduct K M B)
    simp only [q, ← hg, Polynomial.map_sub, Polynomial.map_pow,
      Polynomial.map_X, Polynomial.map_C]
    congr 2
  let E3 := Ideal.quotientEquiv (Ideal.span {q}) _ (Polynomial.mapEquiv cm) hr
  exact ⟨E1.toRingEquiv.trans (E2.toRingEquiv.trans E3)⟩

theorem wc_hnas_pfc_gcl_psc_finite_order_model : ∀ (A : Type u) [CommRing A] [IsDomain A] (𝔪 : Ideal A) [𝔪.IsPrime] (K : Type u) [Field K] [Algebra (Localization.AtPrime 𝔪) K] [IsFractionRing (Localization.AtPrime 𝔪) K] (M : Type u) [Field M] [Algebra K M] [FiniteDimensional K M] [Algebra A M], algebraMap A M = (algebraMap K M).comp ((algebraMap (Localization.AtPrime 𝔪) K).comp (algebraMap A (Localization.AtPrime 𝔪))) → ∃ B : Subalgebra A M, Module.Finite A B ∧ IsFractionRing B M :=
by
  have s1 : ∀ (A : Type u) [CommRing A] [IsDomain A] (𝔪 : Ideal A) [𝔪.IsPrime] (K : Type u) [Field K] [Algebra (Localization.AtPrime 𝔪) K] [IsFractionRing (Localization.AtPrime 𝔪) K] [Algebra A K], algebraMap A K = (algebraMap (Localization.AtPrime 𝔪) K).comp (algebraMap A (Localization.AtPrime 𝔪)) → IsFractionRing A K := by
    intro A _ _ 𝔪 _ K _ _ _ _ h
    have hι : Function.Injective (algebraMap A (Localization.AtPrime 𝔪)) :=
      IsLocalization.injective (Localization.AtPrime 𝔪) (Ideal.primeCompl_le_nonZeroDivisors 𝔪)
    have hψ : Function.Injective (algebraMap (Localization.AtPrime 𝔪) K) :=
      IsFractionRing.injective _ _
    have hφ : Function.Injective (algebraMap A K) := by
      rw [h]; exact hψ.comp hι
    haveI : FaithfulSMul A K := (faithfulSMul_iff_algebraMap_injective A K).mpr hφ
    apply IsFractionRing.of_field A K
    intro z
    obtain ⟨x, y, hy, rfl⟩ := IsFractionRing.div_surjective (Localization.AtPrime 𝔪) z
    obtain ⟨⟨a, s⟩, hs⟩ := IsLocalization.surj 𝔪.primeCompl x
    obtain ⟨⟨a', s'⟩, hs'⟩ := IsLocalization.surj 𝔪.primeCompl y
    have hφ' : ∀ r, algebraMap A K r =
        algebraMap (Localization.AtPrime 𝔪) K (algebraMap A (Localization.AtPrime 𝔪) r) :=
      fun r => by rw [h]; rfl
    have hs0 : algebraMap A K (s : A) ≠ 0 := by
      rw [map_ne_zero_iff _ hφ]
      intro h0
      apply s.2
      rw [h0]
      exact 𝔪.zero_mem
    have hs'0 : algebraMap A K (s' : A) ≠ 0 := by
      rw [map_ne_zero_iff _ hφ]
      intro h0
      apply s'.2
      rw [h0]
      exact 𝔪.zero_mem
    have hy0 : algebraMap (Localization.AtPrime 𝔪) K y ≠ 0 := by
      rw [map_ne_zero_iff _ hψ]
      exact nonZeroDivisors.ne_zero hy
    have ha : algebraMap A K a = algebraMap (Localization.AtPrime 𝔪) K x * algebraMap A K s := by
      rw [hφ' a, hφ' s, ← map_mul]
      exact congrArg _ hs.symm
    have ha' : algebraMap A K a' = algebraMap (Localization.AtPrime 𝔪) K y * algebraMap A K s' := by
      rw [hφ' a', hφ' s', ← map_mul]
      exact congrArg _ hs'.symm
    refine ⟨a * s', a' * s, ?_⟩
    rw [map_mul, map_mul, ha, ha', div_eq_div_iff hy0 (mul_ne_zero (mul_ne_zero hy0 hs'0) hs0)]
    ring
  have s2 : ∀ (A : Type u) [CommRing A] [IsDomain A] (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K] (M : Type u) [Field M] [Algebra K M] [FiniteDimensional K M] [Algebra A M] [IsScalarTower A K M], ∃ B : Subalgebra A M, Module.Finite A B ∧ IsFractionRing B M := by
    intro A _ _ K _ _ _ M _ _ _ _ _
    obtain ⟨s, b, hb⟩ := FiniteDimensional.exists_is_basis_integral A K M
    refine ⟨Algebra.adjoin A (Set.range b), ?_, ?_⟩
    · apply Algebra.finite_adjoin_of_finite_of_isIntegral (Set.finite_range b)
      rintro _ ⟨i, rfl⟩
      exact hb i
    · set B := Algebra.adjoin A (Set.range b) with hB
      apply IsFractionRing.of_field B M
      intro z
      obtain ⟨t, ht⟩ := IsLocalization.exist_integer_multiples_of_finite (nonZeroDivisors A)
        (fun i => b.repr z i)
      have ht' : ∀ i, ∃ x : A, algebraMap A K x = (t : A) • b.repr z i := fun i => ht i
      choose a ha using ht'
      have hmem : ∑ i, a i • b i ∈ B :=
