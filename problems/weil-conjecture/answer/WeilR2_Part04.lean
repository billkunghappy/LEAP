 (∀ (𝔭 : Ideal C) [𝔭.IsPrime] (L : Type u) [Field L] [Algebra C L] [Algebra 𝔭.ResidueField L] [IsScalarTower C 𝔭.ResidueField L] [FiniteDimensional 𝔭.ResidueField L] (𝔔 : Ideal (TensorProduct C L D)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) → ∀ (𝔭 : Ideal A) [𝔭.IsPrime] (L : Type u) [Field L] [Algebra A L] [Algebra 𝔭.ResidueField L] [IsScalarTower A 𝔭.ResidueField L] [FiniteDimensional 𝔭.ResidueField L] (𝔔 : Ideal (TensorProduct A L D)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) → (∀ (A : Type u) [CommRing A] (C : Type u) [CommRing C] (C' : Type u) [CommRing C'] [Algebra A C] [Algebra A C'], (C ≃ₐ[A] C') → (∀ (𝔭 : Ideal A) [𝔭.IsPrime] (L : Type u) [Field L] [Algebra A L] [Algebra 𝔭.ResidueField L] [IsScalarTower A 𝔭.ResidueField L] [FiniteDimensional 𝔭.ResidueField L] (𝔔 : Ideal (TensorProduct A L C)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) → ∀ (𝔭 : Ideal A) [𝔭.IsPrime] (L : Type u) [Field L] [Algebra A L] [Algebra 𝔭.ResidueField L] [IsScalarTower A 𝔭.ResidueField L] [FiniteDimensional 𝔭.ResidueField L] (𝔔 : Ideal (TensorProduct A L C')) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) → (∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A] (B : Type u) [CommRing B] [IsLocalRing B] [IsNoetherianRing B] [Algebra A B] [IsLocalHom (algebraMap A B)] [Module.Flat A B], ∃ φ : AdicCompletion (IsLocalRing.maximalIdeal A) A →+* AdicCompletion (IsLocalRing.maximalIdeal B) B, φ.comp (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A)) = (algebraMap B (AdicCompletion (IsLocalRing.maximalIdeal B) B)).comp (algebraMap A B) ∧ IsLocalHom φ ∧ φ.Flat) → (∀ (B : Type u) [CommRing B] (𝔮 : Ideal (Polynomial B)) [𝔮.IsPrime] (Ω : Type u) [CommRing Ω] [Algebra (Localization.AtPrime (𝔮.comap Polynomial.C)) Ω], (∀ (𝔭 : Ideal (Localization.AtPrime (𝔮.comap Polynomial.C))) [𝔭.IsPrime] (L : Type u) [Field L] [Algebra (Localization.AtPrime (𝔮.comap Polynomial.C)) L] [Algebra 𝔭.ResidueField L] [IsScalarTower (Localization.AtPrime (𝔮.comap Polynomial.C)) 𝔭.ResidueField L], (∃ s : Finset L, IntermediateField.adjoin 𝔭.ResidueField (s : Set L) = ⊤) → ∀ (𝔔 : Ideal (TensorProduct (Localization.AtPrime (𝔮.comap Polynomial.C)) L Ω)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) → ∀ (𝔮' : Ideal (Polynomial Ω)) [𝔮'.IsPrime] (h : 𝔮 = 𝔮'.comap (Polynomial.mapRingHom ((algebraMap (Localization.AtPrime (𝔮.comap Polynomial.C)) Ω).comp (algebraMap B (Localization.AtPrime (𝔮.comap Polynomial.C)))))) [Algebra (Localization.AtPrime 𝔮) (Localization.AtPrime 𝔮')], algebraMap (Localization.AtPrime 𝔮) (Localization.AtPrime 𝔮') = Localization.localRingHom 𝔮 𝔮' (Polynomial.mapRingHom ((algebraMap (Localization.AtPrime (𝔮.comap Polynomial.C)) Ω).comp (algebraMap B (Localization.AtPrime (𝔮.comap Polynomial.C))))) h → ∀ (𝔭 : Ideal (Localization.AtPrime 𝔮)) [𝔭.IsPrime] (L : Type u) [Field L] [Algebra (Localization.AtPrime 𝔮) L] [Algebra 𝔭.ResidueField L] [IsScalarTower (Localization.AtPrime 𝔮) 𝔭.ResidueField L] [FiniteDimensional 𝔭.ResidueField L] (𝔔 : Ideal (TensorProduct (Localization.AtPrime 𝔮) L (Localization.AtPrime 𝔮'))) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) → (∀ (B : Type u) [CommRing B] (𝔮 : Ideal (Polynomial B)) [𝔮.IsMaximal] (Ω : Type u) [CommRing Ω] [IsLocalRing Ω] [Algebra (Localization.AtPrime (𝔮.comap Polynomial.C)) Ω], IsLocalHom (algebraMap (Localization.AtPrime (𝔮.comap Polynomial.C)) Ω) → (∀ w : Ω, ∃ a : Localization.AtPrime (𝔮.comap Polynomial.C), w - algebraMap (Localization.AtPrime (𝔮.comap Polynomial.C)) Ω a ∈ IsLocalRing.maximalIdeal Ω) → ∃ 𝔮' : Ideal (Polynomial Ω), 𝔮'.IsMaximal ∧ 𝔮'.comap Polynomial.C = IsLocalRing.maximalIdeal Ω ∧ 𝔮 = 𝔮'.comap (Polynomial.mapRingHom ((algebraMap (Localization.AtPrime (𝔮.comap Polynomial.C)) Ω).comp (algebraMap B (Localization.AtPrime (𝔮.comap Polynomial.C)))))) → ∀ (B : Type u) [CommRing B] [IsNoetherianRing B], (∀ (𝔫 : Ideal B) [𝔫.IsPrime], ∀ (Λ : Type u) [CommRing Λ] [Algebra (Localization.AtPrime 𝔫) Λ], Nonempty (AdicCompletion (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔫)) (Localization.AtPrime 𝔫) ≃ₐ[Localization.AtPrime 𝔫] Λ) → ∀ (𝔭 : Ideal (Localization.AtPrime 𝔫)) [𝔭.IsPrime] (L : Type u) [Field L] [Algebra (Localization.AtPrime 𝔫) L] [Algebra 𝔭.ResidueField L] [IsScalarTower (Localization.AtPrime 𝔫) 𝔭.ResidueField L], (∃ s : Finset L, IntermediateField.adjoin 𝔭.ResidueField (s : Set L) = ⊤) → ∀ (𝔔 : Ideal (TensorProduct (Localization.AtPrime 𝔫) L Λ)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) → ∀ (𝔮 : Ideal (Polynomial B)) [𝔮.IsMaximal], ∀ (Λ : Type u) [CommRing Λ] [Algebra (Localization.AtPrime 𝔮) Λ], Nonempty (AdicCompletion (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮)) (Localization.AtPrime 𝔮) ≃ₐ[Localization.AtPrime 𝔮] Λ) → ∀ (𝔭 : Ideal (Localization.AtPrime 𝔮)) [𝔭.IsPrime] (L : Type u) [Field L] [Algebra (Localization.AtPrime 𝔮) L] [Algebra 𝔭.ResidueField L] [IsScalarTower (Localization.AtPrime 𝔮) 𝔭.ResidueField L] [FiniteDimensional 𝔭.ResidueField L] (𝔔 : Ideal (TensorProduct (Localization.AtPrime 𝔮) L Λ)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔) :=
by

  have s2 : (∀ (A : Type u) [CommRing A] (C : Type u) [CommRing C] (D : Type u) [CommRing D] [Algebra A C] [Algebra A D] [Algebra C D] [IsScalarTower A C D] [IsNoetherianRing C] [IsNoetherianRing D], Module.FaithfullyFlat C D → (∀ (𝔭 : Ideal A) [𝔭.IsPrime] (L : Type u) [Field L] [Algebra A L] [Algebra 𝔭.ResidueField L] [IsScalarTower A 𝔭.ResidueField L] [FiniteDimensional 𝔭.ResidueField L] (𝔔 : Ideal (TensorProduct A L D)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) → ∀ (𝔭 : Ideal A) [𝔭.IsPrime] (L : Type u) [Field L] [Algebra A L] [Algebra 𝔭.ResidueField L] [IsScalarTower A 𝔭.ResidueField L] [FiniteDimensional 𝔭.ResidueField L] (𝔔 : Ideal (TensorProduct A L C)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) → (∀ (A : Type u) [CommRing A] (C : Type u) [CommRing C] (C' : Type u) [CommRing C'] [Algebra A C] [Algebra A C'], (C ≃ₐ[A] C') → (∀ (𝔭 : Ideal A) [𝔭.IsPrime] (L : Type u) [Field L] [Algebra A L] [Algebra 𝔭.ResidueField L] [IsScalarTower A 𝔭.ResidueField L] [FiniteDimensional 𝔭.ResidueField L] (𝔔 : Ideal (TensorProduct A L C)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) → ∀ (𝔭 : Ideal A) [𝔭.IsPrime] (L : Type u) [Field L] [Algebra A L] [Algebra 𝔭.ResidueField L] [IsScalarTower A 𝔭.ResidueField L] [FiniteDimensional 𝔭.ResidueField L] (𝔔 : Ideal (TensorProduct A L C')) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) → (∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A] (B : Type u) [CommRing B] [IsLocalRing B] [IsNoetherianRing B] [Algebra A B] [IsLocalHom (algebraMap A B)] [Module.Flat A B], ∃ φ : AdicCompletion (IsLocalRing.maximalIdeal A) A →+* AdicCompletion (IsLocalRing.maximalIdeal B) B, φ.comp (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A)) = (algebraMap B (AdicCompletion (IsLocalRing.maximalIdeal B) B)).comp (algebraMap A B) ∧ IsLocalHom φ ∧ φ.Flat) → ∀ (A' : Type u) [CommRing A'] [IsLocalRing A'] [IsNoetherianRing A'] (E : Type u) [CommRing E] [IsLocalRing E] [IsNoetherianRing E] [Algebra A' E] [IsLocalHom (algebraMap A' E)] [Module.Flat A' E], (∀ (𝔭 : Ideal A') [𝔭.IsPrime] (L : Type u) [Field L] [Algebra A' L] [Algebra 𝔭.ResidueField L] [IsScalarTower A' 𝔭.ResidueField L] [FiniteDimensional 𝔭.ResidueField L] (𝔔 : Ideal (TensorProduct A' L (AdicCompletion (IsLocalRing.maximalIdeal E) E))) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) → ∀ (Λ : Type u) [CommRing Λ] [Algebra A' Λ], Nonempty (AdicCompletion (IsLocalRing.maximalIdeal A') A' ≃ₐ[A'] Λ) → ∀ (𝔭 : Ideal A') [𝔭.IsPrime] (L : Type u) [Field L] [Algebra A' L] [Algebra 𝔭.ResidueField L] [IsScalarTower A' 𝔭.ResidueField L] [FiniteDimensional 𝔭.ResidueField L] (𝔔 : Ideal (TensorProduct A' L Λ)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔) := by
    intro hDESC hTRANS hCFLAT A' _ _ _ E _ _ _ _ _ _ hGRF Λ _ _ hΛ
    obtain ⟨e⟩ := hΛ
    haveI : IsNoetherianRing (AdicCompletion (IsLocalRing.maximalIdeal A') A') :=
      wc_hnas_completion_noetherian A'
    haveI : IsNoetherianRing (AdicCompletion (IsLocalRing.maximalIdeal E) E) :=
      wc_hnas_completion_noetherian E
    obtain ⟨φ, hsq, hloc, hflat⟩ := hCFLAT A' E
    letI : Algebra (AdicCompletion (IsLocalRing.maximalIdeal A') A')
        (AdicCompletion (IsLocalRing.maximalIdeal E) E) := φ.toAlgebra
    haveI : IsScalarTower A' (AdicCompletion (IsLocalRing.maximalIdeal A') A')
        (AdicCompletion (IsLocalRing.maximalIdeal E) E) := IsScalarTower.of_algebraMap_eq (fun x => by
      rw [RingHom.algebraMap_toAlgebra,
        IsScalarTower.algebraMap_apply A' E (AdicCompletion (IsLocalRing.maximalIdeal E) E)]
      exact (congrArg (fun f => f x) hsq).symm)
    haveI : Module.Flat (AdicCompletion (IsLocalRing.maximalIdeal A') A')
        (AdicCompletion (IsLocalRing.maximalIdeal E) E) := RingHom.flat_algebraMap_iff.mp hflat
    haveI : IsLocalHom (algebraMap (AdicCompletion (IsLocalRing.maximalIdeal A') A')
        (AdicCompletion (IsLocalRing.maximalIdeal E) E)) := hloc
    haveI : Module.FaithfullyFlat (AdicCompletion (IsLocalRing.maximalIdeal A') A')
