  have wc_pfc_ssr_tubular_retraction : ∀ (R : Type u) [CommRing R] (D : Type u) [CommRing D] [Algebra R D] (n : ℕ) (E : Matrix (Fin n) (Fin n) D) (T : Fin n → Fin n → Fin n → D) (g : MvPolynomial (Fin n) D), g = (1 - Matrix.of fun m i : Fin n => ∑ j, MvPolynomial.C (T j i m) * MvPolynomial.X j).det → ∃ β : Localization.Away (Ideal.Quotient.mk (Ideal.span (Set.range fun k : Fin n => ∑ i, MvPolynomial.C (E i k) * MvPolynomial.X i)) g) →ₐ[R] D, β.comp (IsScalarTower.toAlgHom R D (Localization.Away (Ideal.Quotient.mk (Ideal.span (Set.range fun k : Fin n => ∑ i, MvPolynomial.C (E i k) * MvPolynomial.X i)) g))) = AlgHom.id R D := by
