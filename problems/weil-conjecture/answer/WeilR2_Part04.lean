  obtain ⟨g, hg⟩ : ∃ g : MvPolynomial (Fin n) D,
      g = (1 - Matrix.of fun m i : Fin n => ∑ j, MvPolynomial.C (T j i m) * MvPolynomial.X j).det :=
    ⟨_, rfl⟩
  haveI hsm := wc_pfc_ssr_tubular_smooth R D n E hE g
  obtain ⟨δ, hδ⟩ := wc_pfc_ssr_tubular_derivation R D n x E T d0 g hE hEd hTd hg
  have hspan := wc_pfc_ssr_tubular_span R D n x E T d0 g hE2 hEd hTd hg
  obtain ⟨b, hb⟩ := wc_pfc_ssr_basis_of_derivation R _ n _ δ hδ hspan
  haveI : Algebra.IsStandardSmooth R (Localization.Away (Ideal.Quotient.mk (Ideal.span
      (Set.range fun k : Fin n => ∑ i, MvPolynomial.C (E i k) * MvPolynomial.X i)) g)) :=
    Algebra.IsStandardSmooth.of_basis_kaehlerDifferential b (by
      rintro _ ⟨i, rfl⟩
      exact ⟨_, (hb i).symm⟩)
  obtain ⟨β, hβ⟩ := wc_pfc_ssr_tubular_retraction R D n E T g hg
  exact wc_pfc_ssr_std_transfer R D _ _ β hβ

theorem wc_pfc_elementary_standard_descent : ∀ (A : Type u) [CommRing A] (Λ : Type u) [CommRing Λ] [Algebra A Λ] (M : Submonoid A) (n : ℕ) (s : Finset (MvPolynomial (Fin n) A)) (b : Fin n → Λ), (∀ f ∈ s, MvPolynomial.aeval b f = 0) → ∀ (N c : ℕ) (hc : c ≤ N) (F : Fin c → MvPolynomial (Fin N) (Localization M)), IsUnit (Ideal.Quotient.mk (Ideal.span (Set.range F)) (Matrix.of fun i j : Fin c => MvPolynomial.pderiv (Fin.castLE hc i) (F j)).det) → ∀ (cB : Fin n → MvPolynomial (Fin N) (Localization M) ⧸ Ideal.span (Set.range F)) (γ : (MvPolynomial (Fin N) (Localization M) ⧸ Ideal.span (Set.range F)) →ₐ[Localization M] Localization (Algebra.algebraMapSubmonoid Λ M)), (∀ f ∈ s, MvPolynomial.aeval cB (f.map (algebraMap A (Localization M))) = 0) → (∀ i, γ (cB i) = algebraMap Λ _ (b i)) → ∃ (N' : ℕ) (hnN : n ≤ N') (m cc : ℕ) (hcN : cc ≤ N') (hcm : cc ≤ m) (g : Fin m → MvPolynomial (Fin N') A) (lam : Fin N' → Λ) (π : A) (a' : MvPolynomial (Fin N') A), π ∈ M ∧ (∀ i : Fin n, lam (Fin.castLE hnN i) = b i) ∧ (∀ j, MvPolynomial.aeval lam (g j) = 0) ∧ (∀ f ∈ s, MvPolynomial.rename (Fin.castLE hnN) f ∈ Ideal.span (Set.range g)) ∧ (MvPolynomial.C π - a' * (Matrix.of fun i j : Fin cc => MvPolynomial.pderiv (Fin.castLE hcN i) (g (Fin.castLE hcm j))).det ∈ Ideal.span (Set.range g)) ∧ (∀ j : Fin m, cc ≤ j.val → MvPolynomial.C π * g j ∈ Ideal.span (g '' {j' | j'.val < cc}) + Ideal.span (Set.range g) ^ 2) :=
by

  have hres : ∀ (R : Type u) [CommRing R] (T : Type u) [CommRing T] [Algebra R T] (n N c : ℕ) (hc : c ≤ N) (F : Fin c → MvPolynomial (Fin N) R), IsUnit (Ideal.Quotient.mk (Ideal.span (Set.range F)) (Matrix.of fun i j : Fin c => MvPolynomial.pderiv (Fin.castLE hc i) (F j)).det) → ∀ (cB : Fin n → MvPolynomial (Fin N) R ⧸ Ideal.span (Set.range F)) (γ : (MvPolynomial (Fin N) R ⧸ Ideal.span (Set.range F)) →ₐ[R] T) (u : R), IsUnit u → ∀ (ℓ : Fin N → T), (∀ k, algebraMap R T u * γ (Ideal.Quotient.mk (Ideal.span (Set.range F)) (MvPolynomial.X k)) = ℓ k) → ∃ (F' : Fin c → MvPolynomial (Fin N) R) (H' : Fin n → MvPolynomial (Fin N) R), IsUnit (Ideal.Quotient.mk (Ideal.span (Set.range F')) (Matrix.of fun i j : Fin c => MvPolynomial.pderiv (Fin.castLE hc i) (F' j)).det) ∧ (∀ p : MvPolynomial (Fin n) R, MvPolynomial.aeval cB p = 0 → MvPolynomial.aeval H' p ∈ Ideal.span (Set.range F')) ∧ (∀ j, MvPolynomial.aeval ℓ (F' j) = 0) ∧ (∀ i, MvPolynomial.aeval ℓ (H' i) = γ (cB i)) := by
    intro R _ T _ _ n N c hc F hunit cB γ u hu ℓ hℓ
    classical
    obtain ⟨v, hvu⟩ := hu.exists_left_inv
    let σ : MvPolynomial (Fin N) R →ₐ[R] MvPolynomial (Fin N) R :=
      MvPolynomial.aeval (fun k => MvPolynomial.C v * MvPolynomial.X k)
    have hσX : ∀ k, σ (MvPolynomial.X k) = MvPolynomial.C v * MvPolynomial.X k :=
      fun k => MvPolynomial.aeval_X _ k
    have hσC : ∀ a, σ (MvPolynomial.C a) = MvPolynomial.C a := fun a => by
      rw [MvPolynomial.aeval_C]; rfl
    choose hh hhh using fun i => Ideal.Quotient.mk_surjective (cB i)
    set F' : Fin c → MvPolynomial (Fin N) R := fun j => σ (F j) with hF'
    set I' := Ideal.span (Set.range F') with hI'
    have hle : Ideal.span (Set.range F) ≤
        I'.comap (σ : MvPolynomial (Fin N) R →+* MvPolynomial (Fin N) R) := by
      rw [Ideal.span_le]
      rintro _ ⟨j, rfl⟩
      exact Ideal.subset_span ⟨j, rfl⟩
    have hev : ∀ p, MvPolynomial.aeval ℓ (σ p) =
        γ (Ideal.Quotient.mk (Ideal.span (Set.range F)) p) := by
      have key : (MvPolynomial.aeval ℓ).comp σ =
          γ.comp (Ideal.Quotient.mkₐ R (Ideal.span (Set.range F))) := by
        apply MvPolynomial.algHom_ext
        intro k
        rw [AlgHom.comp_apply, AlgHom.comp_apply, hσX, map_mul, MvPolynomial.aeval_C,
          MvPolynomial.aeval_X, Ideal.Quotient.mkₐ_eq_mk, ← hℓ k, ← mul_assoc, ← map_mul, hvu,
          map_one, one_mul]
      intro p
      have := AlgHom.congr_fun key p
      rw [AlgHom.comp_apply, AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk] at this
      exact this
    have hchain : ∀ (i : Fin N) (p : MvPolynomial (Fin N) R),
        MvPolynomial.pderiv i (σ p) = MvPolynomial.C v * σ (MvPolynomial.pderiv i p) := by
      intro i p
      induction p using MvPolynomial.induction_on with
      | C a => rw [hσC, MvPolynomial.pderiv_C, map_zero, mul_zero]
      | add p q hp hq => rw [map_add, map_add, hp, hq, map_add, map_add, mul_add]
      | mul_X p k hp =>
        simp only [map_mul, hσX, Derivation.leibniz, smul_eq_mul, MvPolynomial.pderiv_C,
          MvPolynomial.pderiv_X, hp, map_add, mul_zero, add_zero]
        by_cases hik : k = i
        · subst hik
          simp only [Pi.single_eq_same, map_one]
          ring
        · simp only [Pi.single_eq_of_ne hik, map_zero]
          ring
    have hjac : (Matrix.of fun i j : Fin c => MvPolynomial.pderiv (Fin.castLE hc i) (F' j)) =
        (MvPolynomial.C v : MvPolynomial (Fin N) R) •
          (σ : MvPolynomial (Fin N) R →+* MvPolynomial (Fin N) R).mapMatrix
          (Matrix.of fun i j : Fin c => MvPolynomial.pderiv (Fin.castLE hc i) (F j)) := by
      refine Matrix.ext fun i j => ?_
      simp only [hF', Matrix.of_apply, Matrix.smul_apply, RingHom.mapMatrix_apply,
        Matrix.map_apply, smul_eq_mul, hchain]
      rfl
    have hdet : (Matrix.of fun i j : Fin c => MvPolynomial.pderiv (Fin.castLE hc i) (F' j)).det =
        MvPolynomial.C v ^ c *
          σ (Matrix.of fun i j : Fin c => MvPolynomial.pderiv (Fin.castLE hc i) (F j)).det := by
      rw [hjac, Matrix.det_smul, Fintype.card_fin, ← RingHom.map_det]
      rfl
    have hCv : IsUnit (MvPolynomial.C v : MvPolynomial (Fin N) R) :=
      ⟨⟨MvPolynomial.C v, MvPolynomial.C u, by rw [← map_mul, hvu, map_one],
        by rw [← map_mul, mul_comm, hvu, map_one]⟩, rfl⟩
    refine ⟨F', fun i => σ (hh i), ?_, ?_, ?_, ?_⟩
    · rw [hdet, map_mul, map_pow]
      refine ((hCv.map _).pow c).mul ?_
      rw [show Ideal.Quotient.mk I' (σ (Matrix.of fun i j : Fin c =>
          MvPolynomial.pderiv (Fin.castLE hc i) (F j)).det) =
          Ideal.quotientMap I' (σ : MvPolynomial (Fin N) R →+* MvPolynomial (Fin N) R) hle
            (Ideal.Quotient.mk (Ideal.span (Set.range F)) (Matrix.of fun i j : Fin c =>
              MvPolynomial.pderiv (Fin.castLE hc i) (F j)).det) from Ideal.quotientMap_mk.symm]
      exact hunit.map _
    · intro p hp
      have h1 : MvPolynomial.aeval (fun i => σ (hh i)) p = σ (MvPolynomial.aeval hh p) :=
        (MvPolynomial.comp_aeval_apply hh σ p).symm
      have h2 : MvPolynomial.aeval hh p ∈ Ideal.span (Set.range F) := by
        rw [← Ideal.Quotient.eq_zero_iff_mem]
        have h3 : Ideal.Quotient.mkₐ R (Ideal.span (Set.range F)) (MvPolynomial.aeval hh p) =
            MvPolynomial.aeval
              (fun i => Ideal.Quotient.mkₐ R (Ideal.span (Set.range F)) (hh i)) p :=
          MvPolynomial.comp_aeval_apply hh _ p
        simp only [Ideal.Quotient.mkₐ_eq_mk, hhh] at h3
        rw [h3]
        exact hp
      rw [h1]
      exact hle h2
    · intro j
      rw [hF']
      simp only
      rw [hev, Ideal.Quotient.eq_zero_iff_mem.mpr
        (Ideal.subset_span ⟨j, rfl⟩ : F j ∈ Ideal.span (Set.range F)), map_zero]
    · intro i
      simp only
      rw [hev, hhh]

  have hgraph : ∀ (R : Type u) [CommRing R] (T : Type u) [CommRing T] [Algebra R T] (n N c : ℕ) (hc : c ≤ N) (h : n + c ≤ n + N) (hn : n ≤ n + N) (F' : Fin c → MvPolynomial (Fin N) R) (H' : Fin n → MvPolynomial (Fin N) R), IsUnit (Ideal.Quotient.mk (Ideal.span (Set.range F')) (Matrix.of fun i j : Fin c => MvPolynomial.pderiv (Fin.castLE hc i) (F' j)).det) → ∀ (ℓ : Fin N → T), (∀ j, MvPolynomial.aeval ℓ (F' j) = 0) → ∃ G : Fin (n + c) → MvPolynomial (Fin (n + N)) R, IsUnit (Ideal.Quotient.mk (Ideal.span (Set.range G)) (Matrix.of fun i j : Fin (n + c) => MvPolynomial.pderiv (Fin.castLE h i) (G j)).det) ∧ (∀ p : MvPolynomial (Fin n) R, MvPolynomial.aeval H' p ∈ Ideal.span (Set.range F') → MvPolynomial.rename (Fin.castLE hn) p ∈ Ideal.span (Set.range G)) ∧ (∀ j, MvPolynomial.aeval (Fin.append (fun i => MvPolynomial.aeval ℓ (H' i)) ℓ) (G j) = 0) := by
    intro R _ T _ _ n N c hc h hn F' H' hunit ℓ hF'
    classical
    let ρ : MvPolynomial (Fin N) R →ₐ[R] MvPolynomial (Fin (n + N)) R :=
      MvPolynomial.rename (Fin.natAdd n)
    let G : Fin (n + c) → MvPolynomial (Fin (n + N)) R :=
      Fin.append (fun i => MvPolynomial.X (Fin.castAdd N i) - ρ (H' i)) (fun j => ρ (F' j))
    have hGl : ∀ i, G (Fin.castAdd c i) = MvPolynomial.X (Fin.castAdd N i) - ρ (H' i) :=
      fun i => Fin.append_left _ _ i
    have hGr : ∀ j, G (Fin.natAdd n j) = ρ (F' j) := fun j => Fin.append_right _ _ j
    have hle : Ideal.span (Set.range F') ≤ (Ideal.span (Set.range G)).comap
        (ρ : MvPolynomial (Fin N) R →+* MvPolynomial (Fin (n + N)) R) := by
      rw [Ideal.span_le]
      rintro _ ⟨j, rfl⟩
      exact Ideal.subset_span ⟨Fin.natAdd n j, hGr j⟩
    have hvan : ∀ (i : Fin n) (q : MvPolynomial (Fin N) R),
        MvPolynomial.pderiv (Fin.castAdd N i) (ρ q) = 0 := by
      intro i q
      apply MvPolynomial.pderiv_eq_zero_of_notMem_vars
      intro hmem
      have h1 := MvPolynomial.vars_rename (Fin.natAdd n) q hmem
      obtain ⟨k, -, hk⟩ := Finset.mem_image.mp h1
      have h2 := congrArg Fin.val hk
      simp only [Fin.val_natAdd, Fin.val_castAdd] at h2
      have := i.isLt
      omega
    have hρd : ∀ (k : Fin N) (q : MvPolynomial (Fin N) R),
        MvPolynomial.pderiv (Fin.natAdd n k) (ρ q) = ρ (MvPolynomial.pderiv k q) :=
      fun k q => MvPolynomial.pderiv_rename (Fin.natAdd_injective N n) k q
    have hdet : (Matrix.of fun i j : Fin (n + c) =>
        MvPolynomial.pderiv (Fin.castLE h i) (G j)).det =
        ρ (Matrix.of fun i j : Fin c => MvPolynomial.pderiv (Fin.castLE hc i) (F' j)).det := by
      rw [← Matrix.det_submatrix_equiv_self finSumFinEquiv,
        ← Matrix.fromBlocks_toBlocks ((Matrix.of fun i j : Fin (n + c) =>
          MvPolynomial.pderiv (Fin.castLE h i) (G j)).submatrix finSumFinEquiv finSumFinEquiv)]
      have h12 : ((Matrix.of fun i j : Fin (n + c) =>
          MvPolynomial.pderiv (Fin.castLE h i) (G j)).submatrix finSumFinEquiv
            finSumFinEquiv).toBlocks₁₂ = 0 := by
        refine Matrix.ext fun i j => ?_
        simp only [Matrix.toBlocks₁₂, Matrix.of_apply, Matrix.submatrix_apply,
          finSumFinEquiv_apply_left, finSumFinEquiv_apply_right, Matrix.zero_apply]
        rw [show Fin.castLE h (Fin.castAdd c i) = Fin.castAdd N i from Fin.ext rfl, hGr, hvan]
      have h11 : ((Matrix.of fun i j : Fin (n + c) =>
          MvPolynomial.pderiv (Fin.castLE h i) (G j)).submatrix finSumFinEquiv
            finSumFinEquiv).toBlocks₁₁ = 1 := by
        refine Matrix.ext fun i i' => ?_
        simp only [Matrix.toBlocks₁₁, Matrix.of_apply, Matrix.submatrix_apply,
          finSumFinEquiv_apply_left]
        rw [show Fin.castLE h (Fin.castAdd c i) = Fin.castAdd N i from Fin.ext rfl, hGl, map_sub,
          hvan, sub_zero, MvPolynomial.pderiv_X, Matrix.one_apply]
        by_cases hii : i = i'
        · subst hii
          simp
        · rw [if_neg hii, Pi.single_eq_of_ne]
          intro heq
          apply hii
          have h3 := congrArg Fin.val heq
          simp only [Fin.val_castAdd] at h3
          exact Fin.ext h3.symm
      have h22 : ((Matrix.of fun i j : Fin (n + c) =>
          MvPolynomial.pderiv (Fin.castLE h i) (G j)).submatrix finSumFinEquiv
            finSumFinEquiv).toBlocks₂₂ =
          (ρ : MvPolynomial (Fin N) R →+* MvPolynomial (Fin (n + N)) R).mapMatrix
            (Matrix.of fun i j : Fin c => MvPolynomial.pderiv (Fin.castLE hc i) (F' j)) := by
        refine Matrix.ext fun k j => ?_
        simp only [Matrix.toBlocks₂₂, Matrix.of_apply, Matrix.submatrix_apply,
          finSumFinEquiv_apply_right, RingHom.mapMatrix_apply, Matrix.map_apply]
        rw [show Fin.castLE h (Fin.natAdd n k) = Fin.natAdd n (Fin.castLE hc k) from Fin.ext rfl,
          hGr, hρd]
        rfl
      rw [h12, h11, h22, Matrix.det_fromBlocks_zero₁₂, Matrix.det_one, one_mul,
        ← RingHom.map_det]
      rfl
    have hunitG : IsUnit (Ideal.Quotient.mk (Ideal.span (Set.range G))
        (Matrix.of fun i j : Fin (n + c) => MvPolynomial.pderiv (Fin.castLE h i) (G j)).det) := by
      rw [hdet, show Ideal.Quotient.mk (Ideal.span (Set.range G))
          (ρ (Matrix.of fun i j : Fin c => MvPolynomial.pderiv (Fin.castLE hc i) (F' j)).det) =
          Ideal.quotientMap (Ideal.span (Set.range G))
            (ρ : MvPolynomial (Fin N) R →+* MvPolynomial (Fin (n + N)) R) hle
            (Ideal.Quotient.mk (Ideal.span (Set.range F'))
              (Matrix.of fun i j : Fin c => MvPolynomial.pderiv (Fin.castLE hc i) (F' j)).det)
          from Ideal.quotientMap_mk.symm]
      exact hunit.map _
    have hmem : ∀ p : MvPolynomial (Fin n) R,
        MvPolynomial.aeval H' p ∈ Ideal.span (Set.range F') →
        MvPolynomial.rename (Fin.castLE hn) p ∈ Ideal.span (Set.range G) := by
      intro p hp
      have hext : (Ideal.Quotient.mkₐ R (Ideal.span (Set.range G))).comp
          (MvPolynomial.rename (Fin.castLE hn)) =
          ((Ideal.Quotient.mkₐ R (Ideal.span (Set.range G))).comp ρ).comp
            (MvPolynomial.aeval H') := by
        apply MvPolynomial.algHom_ext
        intro i
        simp only [AlgHom.comp_apply, MvPolynomial.rename_X, MvPolynomial.aeval_X,
          Ideal.Quotient.mkₐ_eq_mk]
        rw [Ideal.Quotient.eq, show Fin.castLE hn i = Fin.castAdd N i from Fin.ext rfl, ← hGl]
        exact Ideal.subset_span ⟨_, rfl⟩
      have h1 := AlgHom.congr_fun hext p
      simp only [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk] at h1
      rw [← Ideal.Quotient.eq_zero_iff_mem, h1, Ideal.Quotient.eq_zero_iff_mem]
      exact hle hp
    have hev : ∀ q, MvPolynomial.aeval
        (Fin.append (fun i => MvPolynomial.aeval ℓ (H' i)) ℓ) (ρ q) =
        MvPolynomial.aeval ℓ q := by
      intro q
      rw [MvPolynomial.aeval_rename]
      have hfun : (Fin.append (fun i => MvPolynomial.aeval ℓ (H' i)) ℓ) ∘ Fin.natAdd n = ℓ :=
        funext fun k => Fin.append_right _ _ k
      rw [hfun]
    refine ⟨G, hunitG, hmem, fun j => ?_⟩
    refine Fin.addCases (fun i => ?_) (fun j => ?_) j
    · rw [hGl, map_sub, MvPolynomial.aeval_X, hev, Fin.append_left, sub_self]
    · rw [hGr, hev, hF']

  have hclear : ∀ (A : Type u) [CommRing A] (Λ : Type u) [CommRing Λ] [Algebra A Λ] (M : Submonoid A) (K N' : ℕ) (h : K ≤ N') (G : Fin K → MvPolynomial (Fin N') (Localization M)), IsUnit (Ideal.Quotient.mk (Ideal.span (Set.range G)) (Matrix.of fun i j : Fin K => MvPolynomial.pderiv (Fin.castLE h i) (G j)).det) → ∀ (lam : Fin N' → Λ), (∀ j, MvPolynomial.aeval (fun i => algebraMap Λ (Localization (Algebra.algebraMapSubmonoid Λ M)) (lam i)) (G j) = 0) → ∃ g0 : Fin K → MvPolynomial (Fin N') A, (∀ j, MvPolynomial.aeval lam (g0 j) = 0) ∧ Ideal.map (MvPolynomial.map (algebraMap A (Localization M))) (Ideal.span (Set.range g0)) = Ideal.span (Set.range G) ∧ IsUnit (Ideal.Quotient.mk (Ideal.map (MvPolynomial.map (algebraMap A (Localization M))) (Ideal.span (Set.range g0))) (MvPolynomial.map (algebraMap A (Localization M)) (Matrix.of fun i j : Fin K => MvPolynomial.pderiv (Fin.castLE h i) (g0 j)).det)) := by
    intro A _ Λ _ _ M K N' h G hunit lam hG
    classical
    set Q := Localization M
    set T := Localization (Algebra.algebraMapSubmonoid Λ M)
    let φ : MvPolynomial (Fin N') A →+* MvPolynomial (Fin N') Q :=
      MvPolynomial.map (algebraMap A Q)
    have step : ∀ j, ∃ (g1 : MvPolynomial (Fin N') A) (e : A), e ∈ M ∧
        MvPolynomial.aeval lam g1 = 0 ∧ φ g1 = MvPolynomial.C (algebraMap A Q e) * G j := by
      intro j
      letI : Algebra (MvPolynomial (Fin N') A) (MvPolynomial (Fin N') Q) :=
        MvPolynomial.algebraMvPolynomial
      haveI : IsLocalization (Submonoid.map (MvPolynomial.C : A →+* MvPolynomial (Fin N') A) M)
          (MvPolynomial (Fin N') Q) := MvPolynomial.isLocalization M Q
      obtain ⟨⟨g1, ⟨s1, hs1⟩⟩, h1⟩ := IsLocalization.surj
        (Submonoid.map (MvPolynomial.C : A →+* MvPolynomial (Fin N') A) M) (G j)
      obtain ⟨w, hw, rfl⟩ := Submonoid.mem_map.mp hs1
      have h1' : φ g1 = MvPolynomial.C (algebraMap A Q w) * G j := by
        have : G j * φ (MvPolynomial.C w) = φ g1 := by
          rw [MvPolynomial.algebraMap_def] at h1; exact h1
        rw [← this, MvPolynomial.map_C, mul_comm]
      have hval : algebraMap Λ T (MvPolynomial.aeval lam g1) = 0 := by
        have e1 := MvPolynomial.aeval_algebraMap_apply T lam g1
        rw [← e1, ← MvPolynomial.aeval_map_algebraMap Q]
        change MvPolynomial.aeval _ (φ g1) = 0
        rw [h1', map_mul,
          show (⇑(algebraMap Λ T) ∘ lam) = fun i => algebraMap Λ T (lam i) from rfl,
          hG j, mul_zero]
      obtain ⟨⟨v, hv⟩, hv0⟩ :=
        (IsLocalization.map_eq_zero_iff (Algebra.algebraMapSubmonoid Λ M) T _).mp hval
      obtain ⟨v0, hv0M, rfl⟩ := Submonoid.mem_map.mp hv
      refine ⟨MvPolynomial.C v0 * g1, v0 * w, M.mul_mem hv0M hw, ?_, ?_⟩
      · rw [map_mul, MvPolynomial.aeval_C]
        exact hv0
      · rw [map_mul, h1']
        simp only [φ, MvPolynomial.map_C, map_mul]
        ring
    choose g0 e he hg0 hφ using step
    have heU : ∀ j, IsUnit (MvPolynomial.C (algebraMap A Q (e j)) : MvPolynomial (Fin N') Q) :=
      fun j => (IsLocalization.map_units Q ⟨e j, he j⟩).map MvPolynomial.C
    have hideal : Ideal.map φ (Ideal.span (Set.range g0)) = Ideal.span (Set.range G) := by
      rw [Ideal.map_span, ← Set.range_comp]
      apply le_antisymm
      · rw [Ideal.span_le]
        rintro _ ⟨j, rfl⟩
        simp only [Function.comp_apply, hφ]
        exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨j, rfl⟩)
      · rw [Ideal.span_le]
        rintro _ ⟨j, rfl⟩
        obtain ⟨v, hv⟩ := (heU j).exists_left_inv
        have : G j = v * (φ ∘ g0) j := by
          simp only [Function.comp_apply, hφ, ← mul_assoc, hv, one_mul]
        rw [SetLike.mem_coe, this]
        exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨j, rfl⟩)
    refine ⟨g0, hg0, hideal, ?_⟩
    change IsUnit (Ideal.Quotient.mk (Ideal.map φ (Ideal.span (Set.range g0))) (φ _))
    rw [hideal, RingHom.map_det]
    have hmat : φ.mapMatrix
        (Matrix.of fun i j : Fin K => MvPolynomial.pderiv (Fin.castLE h i) (g0 j)) =
        (Matrix.of fun i j : Fin K => MvPolynomial.pderiv (Fin.castLE h i) (G j)) *
          Matrix.diagonal (fun j => MvPolynomial.C (algebraMap A Q (e j))) := by
      refine Matrix.ext fun i j => ?_
      simp only [RingHom.mapMatrix_apply, Matrix.map_apply, Matrix.of_apply, Matrix.mul_diagonal]
      rw [← MvPolynomial.pderiv_map]
      change MvPolynomial.pderiv (Fin.castLE h i) (φ (g0 j)) = _
      rw [hφ, Derivation.leibniz, MvPolynomial.pderiv_C, smul_zero, add_zero, smul_eq_mul,
        mul_comm]
    rw [hmat, Matrix.det_mul, Matrix.det_diagonal, map_mul]
    refine hunit.mul ?_
    have hprod : IsUnit (∏ j, (MvPolynomial.C (algebraMap A Q (e j)) :
        MvPolynomial (Fin N') Q)) := by
      rw [← map_prod, ← map_prod]
      exact (IsLocalization.map_units Q ⟨∏ j, e j, Submonoid.prod_mem _ (fun j _ => he j)⟩).map _
    exact hprod.map _

  have hsatur : ∀ (A : Type u) [CommRing A] (M : Submonoid A) (N' : ℕ) (I : Ideal (MvPolynomial (Fin N') A)), (∀ p : MvPolynomial (Fin N') A, MvPolynomial.map (algebraMap A (Localization M)) p ∈ Ideal.map (MvPolynomial.map (algebraMap A (Localization M))) I → ∃ w ∈ M, MvPolynomial.C w * p ∈ I) ∧ (∀ q : MvPolynomial (Fin N') A, IsUnit (Ideal.Quotient.mk (Ideal.map (MvPolynomial.map (algebraMap A (Localization M))) I) (MvPolynomial.map (algebraMap A (Localization M)) q)) → ∃ π₀ ∈ M, ∃ U : MvPolynomial (Fin N') A, MvPolynomial.C π₀ - U * q ∈ I) := by
    intro A _ M N' I
    letI : Algebra (MvPolynomial (Fin N') A) (MvPolynomial (Fin N') (Localization M)) :=
      MvPolynomial.algebraMvPolynomial
    haveI : IsLocalization (Submonoid.map MvPolynomial.C M)
        (MvPolynomial (Fin N') (Localization M)) := MvPolynomial.isLocalization M (Localization M)
    have hmap : (MvPolynomial.map (algebraMap A (Localization M)) :
        MvPolynomial (Fin N') A →+* MvPolynomial (Fin N') (Localization M)) =
        algebraMap (MvPolynomial (Fin N') A) (MvPolynomial (Fin N') (Localization M)) :=
      MvPolynomial.algebraMap_def.symm
    rw [hmap]
    have part1 : ∀ p : MvPolynomial (Fin N') A,
        algebraMap (MvPolynomial (Fin N') A) (MvPolynomial (Fin N') (Localization M)) p ∈
          Ideal.map (algebraMap (MvPolynomial (Fin N') A)
            (MvPolynomial (Fin N') (Localization M))) I →
        ∃ w ∈ M, MvPolynomial.C w * p ∈ I := by
      intro p hp
      obtain ⟨⟨i, ⟨s1, hs1⟩⟩, h1⟩ :=
        (IsLocalization.mem_map_algebraMap_iff (Submonoid.map MvPolynomial.C M) _).mp hp
      obtain ⟨w1, hw1, rfl⟩ := Submonoid.mem_map.mp hs1
      have h1' : algebraMap (MvPolynomial (Fin N') A) (MvPolynomial (Fin N') (Localization M))
          (p * MvPolynomial.C w1) =
          algebraMap (MvPolynomial (Fin N') A) (MvPolynomial (Fin N') (Localization M)) i.1 := by
        rw [map_mul]; exact h1
      obtain ⟨⟨c, hc⟩, h2⟩ :=
        (IsLocalization.eq_iff_exists (Submonoid.map MvPolynomial.C M) _).mp h1'
      obtain ⟨w2, hw2, rfl⟩ := Submonoid.mem_map.mp hc
      have h2' : MvPolynomial.C w2 * (p * MvPolynomial.C w1) = MvPolynomial.C w2 * i.1 := h2
      refine ⟨w2 * w1, M.mul_mem hw2 hw1, ?_⟩
      rw [map_mul, show MvPolynomial.C w2 * MvPolynomial.C w1 * p =
        MvPolynomial.C w2 * (p * MvPolynomial.C w1) by ring, h2']
      exact I.mul_mem_left _ i.2
    refine ⟨part1, ?_⟩
    intro q hq
    obtain ⟨rb, hrb⟩ := hq.exists_left_inv
    obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective rb
    rw [← map_mul, ← map_one (Ideal.Quotient.mk _), Ideal.Quotient.eq] at hrb
    obtain ⟨⟨r0, ⟨s0, hs0⟩⟩, hr0⟩ := IsLocalization.surj
      (Submonoid.map (MvPolynomial.C : A →+* MvPolynomial (Fin N') A) M) r
    obtain ⟨w0, hw0, rfl⟩ := Submonoid.mem_map.mp hs0
    have hr0' : r * algebraMap (MvPolynomial (Fin N') A) (MvPolynomial (Fin N') (Localization M))
        (MvPolynomial.C w0) =
        algebraMap (MvPolynomial (Fin N') A) (MvPolynomial (Fin N') (Localization M)) r0 := hr0
    have key : algebraMap (MvPolynomial (Fin N') A) (MvPolynomial (Fin N') (Localization M))
        (r0 * q - MvPolynomial.C w0) ∈
        Ideal.map (algebraMap (MvPolynomial (Fin N') A)
          (MvPolynomial (Fin N') (Localization M))) I := by
      have e : algebraMap (MvPolynomial (Fin N') A) (MvPolynomial (Fin N') (Localization M))
          (r0 * q - MvPolynomial.C w0) =
          algebraMap (MvPolynomial (Fin N') A) (MvPolynomial (Fin N') (Localization M))
            (MvPolynomial.C w0) *
          (r * algebraMap (MvPolynomial (Fin N') A)
            (MvPolynomial (Fin N') (Localization M)) q - 1) := by
        rw [map_sub, map_mul, ← hr0']; ring
      rw [e]
      exact Ideal.mul_mem_left _ _ hrb
    obtain ⟨w, hw, hwI⟩ := part1 _ key
    refine ⟨w * w0, M.mul_mem hw hw0, MvPolynomial.C w * r0, ?_⟩
    have e2 : MvPolynomial.C (w * w0) - MvPolynomial.C w * r0 * q =
        -(MvPolynomial.C w * (r0 * q - MvPolynomial.C w0)) := by rw [map_mul]; ring
    rw [e2]
    exact I.neg_mem hwI

  have hpkg : ∀ (A : Type u) [CommRing A] (Λ : Type u) [CommRing Λ] [Algebra A Λ] (M : Submonoid A) (n : ℕ) (s : Finset (MvPolynomial (Fin n) A)) (b : Fin n → Λ), (∀ f ∈ s, MvPolynomial.aeval b f = 0) → ∀ (N' cc : ℕ) (hnN : n ≤ N') (hcN : cc ≤ N') (g0 : Fin cc → MvPolynomial (Fin N') A) (lam : Fin N' → Λ) (π₀ : A) (U : MvPolynomial (Fin N') A), π₀ ∈ M → (∀ i : Fin n, lam (Fin.castLE hnN i) = b i) → (∀ j, MvPolynomial.aeval lam (g0 j) = 0) → MvPolynomial.C π₀ - U * (Matrix.of fun i j : Fin cc => MvPolynomial.pderiv (Fin.castLE hcN i) (g0 j)).det ∈ Ideal.span (Set.range g0) → (∀ f ∈ s, ∃ w ∈ M, MvPolynomial.C w * MvPolynomial.rename (Fin.castLE hnN) f ∈ Ideal.span (Set.range g0)) → ∃ (m : ℕ) (hcm : cc ≤ m) (g : Fin m → MvPolynomial (Fin N') A) (π : A) (a' : MvPolynomial (Fin N') A), π ∈ M ∧ (∀ j, MvPolynomial.aeval lam (g j) = 0) ∧ (∀ f ∈ s, MvPolynomial.rename (Fin.castLE hnN) f ∈ Ideal.span (Set.range g)) ∧ (MvPolynomial.C π - a' * (Matrix.of fun i j : Fin cc => MvPolynomial.pderiv (Fin.castLE hcN i) (g (Fin.castLE hcm j))).det ∈ Ideal.span (Set.range g)) ∧ (∀ j : Fin m, cc ≤ j.val → MvPolynomial.C π * g j ∈ Ideal.span (g '' {j' | j'.val < cc}) + Ideal.span (Set.range g) ^ 2) := by
    intro A _ Λ _ _ M n s b hb N' cc hnN hcN g0 lam π₀ U hπ₀ hlamb hg0 hU hsat
    classical
    choose! W hWM hW using hsat
    let e : Fin s.card → MvPolynomial (Fin n) A := fun k => (s.equivFin.symm k).1
    have he : ∀ k, e k ∈ s := fun k => (s.equivFin.symm k).2
    obtain ⟨ω, hωdef⟩ : ∃ ω, ω = ∏ f ∈ s, W f := ⟨_, rfl⟩
    have hω : ω ∈ M := hωdef ▸ Submonoid.prod_mem _ (fun f hf => hWM f hf)
    let g : Fin (cc + s.card) → MvPolynomial (Fin N') A :=
      Fin.append g0 (fun k => MvPolynomial.rename (Fin.castLE hnN) (e k))
    have hcm : cc ≤ cc + s.card := Nat.le_add_right _ _
    have hgl : ∀ j : Fin cc, g (Fin.castLE hcm j) = g0 j := by
      intro j
      rw [show Fin.castLE hcm j = Fin.castAdd s.card j from Fin.ext rfl]
      exact Fin.append_left _ _ _
    have hgr : ∀ k : Fin s.card,
        g (Fin.natAdd cc k) = MvPolynomial.rename (Fin.castLE hnN) (e k) :=
      fun k => Fin.append_right _ _ _
    have hrange : Set.range g0 = g '' {j' | j'.val < cc} := by
      ext x
      constructor
      · rintro ⟨j, rfl⟩
        refine ⟨Fin.castLE hcm j, ?_, hgl j⟩
        show (Fin.castLE hcm j).val < cc
        simp
      · rintro ⟨j', hj', rfl⟩
        refine ⟨⟨j'.val, hj'⟩, ?_⟩
        rw [← hgl]
        congr 1
    have hsub : Ideal.span (Set.range g0) ≤ Ideal.span (Set.range g) :=
      Ideal.span_mono (by rintro _ ⟨j, rfl⟩; exact ⟨Fin.castLE hcm j, hgl j⟩)
    refine ⟨cc + s.card, hcm, g, π₀ * ω, MvPolynomial.C ω * U, M.mul_mem hπ₀ hω, ?_, ?_, ?_, ?_⟩
    · intro j
      refine Fin.addCases (fun j => ?_) (fun k => ?_) j
      · rw [show g (Fin.castAdd s.card j) = g0 j from Fin.append_left _ _ _]
        exact hg0 j
      · rw [hgr, MvPolynomial.aeval_rename]
        have hfun : lam ∘ Fin.castLE hnN = b := funext hlamb
        rw [hfun]
        exact hb _ (he k)
    · intro f hf
      apply Ideal.subset_span
      refine ⟨Fin.natAdd cc (s.equivFin ⟨f, hf⟩), ?_⟩
      rw [hgr]
      simp only [e, Equiv.symm_apply_apply]
    · have hdet : (Matrix.of fun i j : Fin cc =>
          MvPolynomial.pderiv (Fin.castLE hcN i) (g (Fin.castLE hcm j))) =
          Matrix.of fun i j : Fin cc => MvPolynomial.pderiv (Fin.castLE hcN i) (g0 j) := by
        ext i j
        simp only [Matrix.of_apply, hgl]
      rw [hdet]
      apply hsub
      have e1 : MvPolynomial.C (π₀ * ω) - MvPolynomial.C ω * U *
          (Matrix.of fun i j : Fin cc => MvPolynomial.pderiv (Fin.castLE hcN i) (g0 j)).det =
          MvPolynomial.C ω * (MvPolynomial.C π₀ - U *
          (Matrix.of fun i j : Fin cc => MvPolynomial.pderiv (Fin.castLE hcN i) (g0 j)).det) := by
        rw [map_mul]; ring
      rw [e1]
      exact Ideal.mul_mem_left _ _ hU
    · intro j hj
      apply Ideal.mem_sup_left
      rw [← hrange]
      obtain ⟨k, rfl⟩ : ∃ k : Fin s.card, j = Fin.natAdd cc k :=
        ⟨⟨j.val - cc, by have := j.isLt; omega⟩, Fin.ext (by simp; omega)⟩
      rw [hgr]
      obtain ⟨d, hd⟩ := Finset.dvd_prod_of_mem W (he k)
      have e1 : MvPolynomial.C (π₀ * ω) * MvPolynomial.rename (Fin.castLE hnN) (e k) =
          MvPolynomial.C (π₀ * d) *
            (MvPolynomial.C (W (e k)) * MvPolynomial.rename (Fin.castLE hnN) (e k)) := by
        rw [hωdef, hd]; simp only [map_mul]; ring
      rw [e1]
      exact Ideal.mul_mem_left _ _ (hW _ (he k))

  intro A _ Λ _ _ M n s b hb N c hc F hunit cB γ hcB hγ
  classical
  have hsurj : ∀ k : Fin N, ∃ (lk : Λ) (tk : A), tk ∈ M ∧
      γ (Ideal.Quotient.mk (Ideal.span (Set.range F)) (MvPolynomial.X k)) *
        algebraMap Λ (Localization (Algebra.algebraMapSubmonoid Λ M)) (algebraMap A Λ tk) =
        algebraMap Λ (Localization (Algebra.algebraMapSubmonoid Λ M)) lk := by
    intro k
    obtain ⟨⟨lk, ⟨y, hy⟩⟩, hk⟩ := IsLocalization.surj (Algebra.algebraMapSubmonoid Λ M)
      (γ (Ideal.Quotient.mk (Ideal.span (Set.range F)) (MvPolynomial.X k)))
    obtain ⟨tk, htk, rfl⟩ := Submonoid.mem_map.mp hy
    exact ⟨lk, tk, htk, hk⟩
  choose lk t ht hlt using hsurj
  have hu : (∏ k, t k) ∈ M := Submonoid.prod_mem _ (fun k _ => ht k)
  have huQ : IsUnit (algebraMap A (Localization M) (∏ k, t k)) :=
    IsLocalization.map_units (Localization M) ⟨_, hu⟩
  set ℓΛ : Fin N → Λ := fun k => algebraMap A Λ (∏ j ∈ Finset.univ.erase k, t j) * lk k with hℓΛ
  have hℓ : ∀ k, algebraMap (Localization M) (Localization (Algebra.algebraMapSubmonoid Λ M))
      (algebraMap A (Localization M) (∏ k, t k)) *
      γ (Ideal.Quotient.mk (Ideal.span (Set.range F)) (MvPolynomial.X k)) =
      algebraMap Λ (Localization (Algebra.algebraMapSubmonoid Λ M)) (ℓΛ k) := by
    intro k
    rw [← IsScalarTower.algebraMap_apply, IsScalarTower.algebraMap_apply A Λ
      (Localization (Algebra.algebraMapSubmonoid Λ M))]
    simp only [hℓΛ, map_mul]
    rw [← hlt k, ← Finset.mul_prod_erase Finset.univ t (Finset.mem_univ k), map_mul, map_mul]
    ring
  obtain ⟨F', H', hF'unit, hmem1, hF'zero, hH'⟩ := hres (Localization M)
    (Localization (Algebra.algebraMapSubmonoid Λ M)) n N c hc F hunit cB γ _ huQ
    (fun k => algebraMap Λ (Localization (Algebra.algebraMapSubmonoid Λ M)) (ℓΛ k)) hℓ
  have h : n + c ≤ n + N := Nat.add_le_add_left hc n
  have hn : n ≤ n + N := Nat.le_add_right n N
  obtain ⟨G, hGunit, hmem2, hGzero⟩ := hgraph (Localization M)
    (Localization (Algebra.algebraMapSubmonoid Λ M)) n N c hc h hn F' H' hF'unit _ hF'zero
  set lam : Fin (n + N) → Λ := Fin.append b ℓΛ with hlam
  have hlamι : (fun i => algebraMap Λ (Localization (Algebra.algebraMapSubmonoid Λ M)) (lam i)) =
      Fin.append (fun i => MvPolynomial.aeval
        (fun k => algebraMap Λ (Localization (Algebra.algebraMapSubmonoid Λ M)) (ℓΛ k)) (H' i))
        (fun k => algebraMap Λ (Localization (Algebra.algebraMapSubmonoid Λ M)) (ℓΛ k)) := by
    funext i
    refine Fin.addCases (fun i => ?_) (fun i => ?_) i
    · rw [hlam, Fin.append_left, Fin.append_left, hH', hγ]
    · rw [hlam, Fin.append_right, Fin.append_right]
  obtain ⟨g0, hg0zero, hideal, hg0unit⟩ := hclear A Λ M (n + c) (n + N) h G
    hGunit lam (by rw [hlamι]; exact hGzero)
  obtain ⟨sat1, sat2⟩ := hsatur A M (n + N) (Ideal.span (Set.range g0))
  obtain ⟨π₀, hπ₀, U, hU⟩ := sat2 _ hg0unit
  have hsat : ∀ f ∈ s, ∃ w ∈ M, MvPolynomial.C w * MvPolynomial.rename (Fin.castLE hn) f ∈
      Ideal.span (Set.range g0) := by
    intro f hf
    have h1 := hmem2 _ (hmem1 _ (hcB f hf))
    rw [← MvPolynomial.map_rename, ← hideal] at h1
    exact sat1 _ h1
  have hlamb : ∀ i : Fin n, lam (Fin.castLE hn i) = b i := by
    intro i
    rw [show Fin.castLE hn i = Fin.castAdd N i from Fin.ext rfl, hlam, Fin.append_left]
  obtain ⟨m, hcm, g, π, a', hπ, hgzero, hsg, hstd1, hstd2⟩ :=
    hpkg A Λ M n s b hb (n + N) (n + c) hn h g0 lam π₀ U hπ₀ hlamb hg0zero hU hsat
  exact ⟨n + N, hn, m, n + c, h, hcm, g, lam, π, a', hπ, hlamb, hgzero, hsg, hstd1, hstd2⟩

theorem wc_pfc_jacobian_localization_smooth : ∀ (R : Type u) [CommRing R] (n m : ℕ) (F : Fin m → MvPolynomial (Fin n) R) (ι : Fin m → Fin n), Function.Injective ι → ∀ e : MvPolynomial (Fin n) R ⧸ Ideal.span (Set.range F), IsUnit (algebraMap (MvPolynomial (Fin n) R ⧸ Ideal.span (Set.range F)) (Localization.Away e) (Ideal.Quotient.mk (Ideal.span (Set.range F)) (Matrix.of fun i j : Fin m => MvPolynomial.pderiv (ι i) (F j)).det)) → Algebra.Smooth R (Localization.Away e) :=
by
  intro R _ n m F ι hι e h
  classical
  let P : Algebra.PreSubmersivePresentation R (MvPolynomial (Fin n) R ⧸ Ideal.span (Set.range F))
      (Fin n) (Fin m) :=
    Algebra.PreSubmersivePresentation.mk (Algebra.Presentation.naive (v := F)) ι hι
  have hval : ∀ x : MvPolynomial (Fin n) R,
      algebraMap P.Ring (MvPolynomial (Fin n) R ⧸ Ideal.span (Set.range F)) x =
        Ideal.Quotient.mk (Ideal.span (Set.range F)) x := by
    intro x
    rw [Algebra.Generators.algebraMap_apply]
    have hh : MvPolynomial.aeval P.val = Ideal.Quotient.mkₐ R (Ideal.span (Set.range F)) := by
      apply MvPolynomial.algHom_ext
      intro i
      rw [MvPolynomial.aeval_X, Ideal.Quotient.mkₐ_eq_mk]
      rfl
    exact congrArg (fun f => f x) hh
  have hPj : P.jacobian = Ideal.Quotient.mk (Ideal.span (Set.range F))
      (Matrix.of fun i j : Fin m => MvPolynomial.pderiv (ι i) (F j)).det := by
    rw [Algebra.PreSubmersivePresentation.jacobian_eq_jacobiMatrix_det]
    have hmat : P.jacobiMatrix = Matrix.of fun i j : Fin m => MvPolynomial.pderiv (ι i) (F j) := by
      ext i j
      rw [Algebra.PreSubmersivePresentation.jacobiMatrix_apply]
      rfl
    rw [hmat]
    exact hval _
  let Q := Algebra.PreSubmersivePresentation.localizationAway (Localization.Away e) e
  let C := Q.comp P
  have hC : C.jacobian = algebraMap _ (Localization.Away e) P.jacobian *
      algebraMap _ (Localization.Away e) e := by
    rw [Algebra.PreSubmersivePresentation.comp_jacobian_eq_jacobian_smul_jacobian, Algebra.smul_def,
      Algebra.PreSubmersivePresentation.localizationAway_jacobian]
  have hunit : IsUnit C.jacobian := by
    rw [hC, hPj]
    exact h.mul (IsLocalization.Away.algebraMap_isUnit e)
  have : Algebra.IsStandardSmooth R (Localization.Away e) :=
    (Algebra.SubmersivePresentation.mk C hunit).isStandardSmooth
  infer_instance

theorem wc_pfc_thickened_std_smooth : (∀ (R : Type u) [CommRing R] (n m : ℕ) (F : Fin m → MvPolynomial (Fin n) R) (ι : Fin m → Fin n), Function.Injective ι → ∀ e : MvPolynomial (Fin n) R ⧸ Ideal.span (Set.range F), IsUnit (algebraMap (MvPolynomial (Fin n) R ⧸ Ideal.span (Set.range F)) (Localization.Away e) (Ideal.Quotient.mk (Ideal.span (Set.range F)) (Matrix.of fun i j : Fin m => MvPolynomial.pderiv (ι i) (F j)).det)) → Algebra.Smooth R (Localization.Away e)) → ∀ (A : Type u) [CommRing A] (w : A) (n c : ℕ) (hc : c ≤ n) (f : Fin c → MvPolynomial (Fin n) A) (U : MvPolynomial (Fin n) A), U * (Matrix.of fun i j : Fin c => MvPolynomial.pderiv (Fin.castLE hc i) (f j)).det - 1 ∈ Ideal.span (Set.range f) ⊔ Ideal.span {MvPolynomial.C w} → Algebra.Smooth A (MvPolynomial (Fin (n + c)) A ⧸ Ideal.span (Set.range fun j : Fin c => MvPolynomial.rename (Fin.castAdd c) (f j) - MvPolynomial.C w * MvPolynomial.X (Fin.natAdd n j))) :=
by
  intro H A _ w n c hc f U hU
  classical
  set F : Fin c → MvPolynomial (Fin (n + c)) A := fun j =>
    MvPolynomial.rename (Fin.castAdd c) (f j) - MvPolynomial.C w * MvPolynomial.X (Fin.natAdd n j)
    with hFdef
  have hFj : ∀ j, F j = MvPolynomial.rename (Fin.castAdd c) (f j) -
      MvPolynomial.C w * MvPolynomial.X (Fin.natAdd n j) := fun j => rfl
  set I := Ideal.span (Set.range F) with hI
  set Δ := (Matrix.of fun i j : Fin c => MvPolynomial.pderiv (Fin.castLE hc i) (f j)).det with hΔ
  set e₁ : MvPolynomial (Fin (n + c)) A ⧸ I :=
    Ideal.Quotient.mk I (MvPolynomial.rename (Fin.castAdd c) Δ) with he₁
  set e₂ : MvPolynomial (Fin (n + c)) A ⧸ I := algebraMap A _ w with he₂
  have hstar : ∀ a : A, Ideal.Quotient.mk I (MvPolynomial.C a) = algebraMap A _ a := fun a => by
    rw [← MvPolynomial.algebraMap_eq, Ideal.Quotient.mk_algebraMap]

  have hspan : Ideal.span ({e₁, e₂} : Set (MvPolynomial (Fin (n + c)) A ⧸ I)) = ⊤ := by
    let ψ : MvPolynomial (Fin n) A →+* MvPolynomial (Fin (n + c)) A ⧸ I :=
      (Ideal.Quotient.mk I).comp (MvPolynomial.rename (Fin.castAdd c)).toRingHom
    have hψ : ∀ p, ψ p = Ideal.Quotient.mk I (MvPolynomial.rename (Fin.castAdd c) p) :=
      fun p => rfl
    have hle : Ideal.span (Set.range f) ⊔ Ideal.span {MvPolynomial.C w} ≤
        (Ideal.span {e₂}).comap ψ := by
      apply sup_le
      · rw [Ideal.span_le]
        rintro _ ⟨j, rfl⟩
        rw [SetLike.mem_coe, Ideal.mem_comap, hψ]
        have hF0 : Ideal.Quotient.mk I (F j) = 0 :=
          Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨j, rfl⟩)
        have e : MvPolynomial.rename (Fin.castAdd c) (f j) =
            F j + MvPolynomial.C w * MvPolynomial.X (Fin.natAdd n j) := by
          rw [hFj]; ring
        rw [e, map_add, hF0, zero_add, map_mul, hstar]
        exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _)
      · rw [Ideal.span_le]
        rintro _ rfl
        rw [SetLike.mem_coe, Ideal.mem_comap, hψ, MvPolynomial.rename_C, hstar]
        exact Ideal.mem_span_singleton_self _
    have h1 := hle hU
    rw [Ideal.mem_comap, map_sub, map_mul, map_one] at h1
    obtain ⟨t, ht⟩ := Ideal.mem_span_singleton'.mp h1
    have hψΔ : ψ Δ = e₁ := rfl
    rw [hψΔ] at ht
    rw [Ideal.eq_top_iff_one, Ideal.mem_span_pair]
    refine ⟨ψ U, -t, ?_⟩
    linear_combination -ht

  have h₁ : Algebra.Smooth A (Localization.Away e₁) := by
    refine H A (n + c) c F (fun i => Fin.castAdd c (Fin.castLE hc i))
      ((Fin.castAdd_injective n c).comp (Fin.castLE_injective hc)) e₁ ?_
    have hdet : (Matrix.of fun i j : Fin c =>
        MvPolynomial.pderiv (Fin.castAdd c (Fin.castLE hc i)) (F j)).det =
        MvPolynomial.rename (Fin.castAdd c) Δ := by
      rw [hΔ, AlgHom.map_det]
      congr 1
      ext i j
      have hne : (Fin.natAdd n j : Fin (n + c)) ≠ Fin.castAdd c (Fin.castLE hc i) := by
        intro h
        have := congrArg Fin.val h
        simp only [Fin.val_natAdd, Fin.val_castAdd, Fin.val_castLE] at this
        omega
      simp only [AlgHom.mapMatrix_apply, Matrix.map_apply, Matrix.of_apply, hFj]
      rw [map_sub, MvPolynomial.pderiv_C_mul, MvPolynomial.pderiv_X,
        MvPolynomial.pderiv_rename (Fin.castAdd_injective n c)]
      simp [hne]
    show IsUnit (algebraMap _ (Localization.Away e₁) (Ideal.Quotient.mk I
      (Matrix.of fun i j : Fin c =>
        MvPolynomial.pderiv (Fin.castAdd c (Fin.castLE hc i)) (F j)).det))
    rw [hdet]
    exact IsLocalization.Away.algebraMap_isUnit e₁

  have h₂ : Algebra.Smooth A (Localization.Away e₂) := by
    refine H A (n + c) c F (Fin.natAdd n) (Fin.natAdd_injective c n) e₂ ?_
    have hdet : (Matrix.of fun i j : Fin c =>
        MvPolynomial.pderiv (Fin.natAdd n i) (F j)).det = (-MvPolynomial.C w) ^ c := by
      have hM : (Matrix.of fun i j : Fin c => MvPolynomial.pderiv (Fin.natAdd n i) (F j)) =
          Matrix.diagonal (fun _ => -MvPolynomial.C w) := by
        ext i j
        have h0 : MvPolynomial.pderiv (Fin.natAdd n i)
            (MvPolynomial.rename (Fin.castAdd c) (f j)) = 0 := by
          apply MvPolynomial.pderiv_eq_zero_of_notMem_vars
          intro hmem
          have hm2 := MvPolynomial.vars_rename (Fin.castAdd c) (f j) hmem
          obtain ⟨k, -, hk⟩ := Finset.mem_image.mp hm2
          have := congrArg Fin.val hk
          simp only [Fin.val_natAdd, Fin.val_castAdd] at this
          omega
        rw [Matrix.of_apply, hFj, map_sub, h0, MvPolynomial.pderiv_C_mul, MvPolynomial.pderiv_X]
        by_cases hij : i = j
        · subst hij
          simp
        · have hne : Fin.natAdd n j ≠ Fin.natAdd n i :=
            fun h => hij ((Fin.natAdd_injective c n) h).symm
          simp [hne, hij]
      rw [hM, Matrix.det_diagonal, Finset.prod_const, Finset.card_univ, Fintype.card_fin]
    show IsUnit (algebraMap _ (Localization.Away e₂) (Ideal.Quotient.mk I
      (Matrix.of fun i j : Fin c => MvPolynomial.pderiv (Fin.natAdd n i) (F j)).det))
    rw [hdet, map_pow, map_neg, hstar, map_pow, map_neg]
    exact (IsLocalization.Away.algebraMap_isUnit e₂).neg.pow c

  rw [← RingHom.smooth_algebraMap]
  apply RingHom.Smooth.ofLocalizationSpanTarget (algebraMap A _) ({e₁, e₂} : Set _) hspan
  rintro ⟨r, hr⟩
  show RingHom.Smooth ((algebraMap _ (Localization.Away r)).comp (algebraMap A _))
  rw [← IsScalarTower.algebraMap_eq, RingHom.smooth_algebraMap]
  rcases Set.mem_insert_iff.mp hr with rfl | hr'
  · exact h₁
  · obtain rfl := Set.mem_singleton_iff.mp hr'
    exact h₂

theorem wc_pfc_lifting_mod_pi : ∀ (A : Type u) [CommRing A] [IsNoetherianRing A] (Λ : Type u) [CommRing Λ] [Algebra A Λ] (π : A), (∀ a : A, π * a = 0 → a = 0) → (∀ x : Λ, π • x = 0 → x = 0) → ∀ (N m : ℕ) (g : Fin m → MvPolynomial (Fin N) A) (lam : Fin N → Λ), (∀ j, MvPolynomial.aeval lam (g j) = 0) → ∀ (C : Type u) [CommRing C] [Algebra (A ⧸ Ideal.span {π ^ 8}) C] [Algebra.Smooth (A ⧸ Ideal.span {π ^ 8}) C] (cb : Fin N → C) (γb : C →ₐ[A ⧸ Ideal.span {π ^ 8}] Λ ⧸ (Ideal.span {π ^ 8}).map (algebraMap A Λ)), (∀ j, MvPolynomial.aeval cb ((g j).map (Ideal.Quotient.mk (Ideal.span {π ^ 8}))) = 0) → (∀ i, γb (cb i) = Ideal.Quotient.mk _ (lam i)) → ∃ (D : Type u) (_ : CommRing D) (_ : Algebra A D) (_ : Algebra.Smooth A D) (d : Fin N → D) (γ : D →ₐ[A] Λ), (∀ j, MvPolynomial.aeval d (g j) ∈ (Ideal.span {π ^ 4}).map (algebraMap A D)) ∧ ∀ i, γ (d i) - lam i ∈ (Ideal.span {π ^ 4}).map (algebraMap A Λ) :=
by
  intro A _ _ Λ _ _ π _ _ N m g lam _ C _ _ _ cb γb hcb hγb
  classical

  obtain ⟨n, c, hc, fb, α, β, hβα, hunit⟩ :=
    wc_pfc_smooth_std_retract (A ⧸ Ideal.span {π ^ 8}) C
  have hφs : Function.Surjective
      (MvPolynomial.map (σ := Fin n) (Ideal.Quotient.mk (Ideal.span {π ^ 8}))) :=
    MvPolynomial.map_surjective _ Ideal.Quotient.mk_surjective

  have s3 : ∀ (f : Fin c → MvPolynomial (Fin n) A),
      (∀ j, MvPolynomial.map (Ideal.Quotient.mk (Ideal.span {π ^ 8})) (f j) = fb j) →
      ∀ p : MvPolynomial (Fin n) A,
      MvPolynomial.map (Ideal.Quotient.mk (Ideal.span {π ^ 8})) p ∈ Ideal.span (Set.range fb) →
      p ∈ Ideal.span (Set.range f) ⊔ Ideal.span {MvPolynomial.C (π ^ 8)} := by
    intro f hf p hp
    have hspan : Ideal.span (Set.range fb) = Ideal.map
        (MvPolynomial.map (σ := Fin n) (Ideal.Quotient.mk (Ideal.span {π ^ 8})))
        (Ideal.span (Set.range f)) := by
      rw [Ideal.map_span, ← Set.range_comp]
      congr 2
      funext j
      exact (hf j).symm
    rw [hspan, Ideal.mem_map_iff_of_surjective _ hφs] at hp
    obtain ⟨q, hq, hqp⟩ := hp
    have hker : p - q ∈ Ideal.span {MvPolynomial.C (π ^ 8)} := by
      have h1 : p - q ∈ RingHom.ker
          (MvPolynomial.map (σ := Fin n) (Ideal.Quotient.mk (Ideal.span {π ^ 8}))) := by
        rw [RingHom.mem_ker, map_sub, hqp, sub_self]
      rw [MvPolynomial.ker_map, Ideal.mk_ker, Ideal.map_span, Set.image_singleton] at h1
      exact h1
    have e : p = q + (p - q) := by ring
    rw [e]
    exact Submodule.add_mem_sup hq hker

  have hC84 : Ideal.span {(MvPolynomial.C (π ^ 8) : MvPolynomial (Fin n) A)} ≤
      Ideal.span {MvPolynomial.C (π ^ 4)} := by
    rw [Ideal.span_singleton_le_span_singleton]
    exact ⟨MvPolynomial.C (π ^ 4), by rw [← map_mul]; congr 1; ring⟩
  have hJ84 : (Ideal.span {π ^ 8}).map (algebraMap A Λ) ≤
      (Ideal.span {π ^ 4}).map (algebraMap A Λ) := by
    apply Ideal.map_mono
    rw [Ideal.span_singleton_le_span_singleton]
    exact ⟨π ^ 4, by ring⟩

  have s4 : ∀ (I : Ideal (MvPolynomial (Fin n) (A ⧸ Ideal.span {π ^ 8})))
      (γ' : (MvPolynomial (Fin n) (A ⧸ Ideal.span {π ^ 8}) ⧸ I) →ₐ[A ⧸ Ideal.span {π ^ 8}]
        Λ ⧸ (Ideal.span {π ^ 8}).map (algebraMap A Λ)) (lam' : Fin n → Λ),
      (∀ k, γ' (Ideal.Quotient.mk I (MvPolynomial.X k)) =
        Ideal.Quotient.mk ((Ideal.span {π ^ 8}).map (algebraMap A Λ)) (lam' k)) →
      ∀ p : MvPolynomial (Fin n) A,
      γ' (Ideal.Quotient.mk I (MvPolynomial.map (Ideal.Quotient.mk (Ideal.span {π ^ 8})) p)) =
        Ideal.Quotient.mk ((Ideal.span {π ^ 8}).map (algebraMap A Λ)) (MvPolynomial.aeval lam' p) := by
    intro I γ' lam' hlam' p
    induction p using MvPolynomial.induction_on with
    | C a =>
      rw [MvPolynomial.map_C, MvPolynomial.aeval_C, ← MvPolynomial.algebraMap_eq,
        Ideal.Quotient.mk_algebraMap, AlgHom.commutes]
      rfl
    | add p q hp hq => simp only [map_add, hp, hq]
    | mul_X p k hp => simp only [map_mul, hp, MvPolynomial.map_X, MvPolynomial.aeval_X, hlam']

  have s5 : ∀ (I : Ideal (MvPolynomial (Fin n) (A ⧸ Ideal.span {π ^ 8})))
      (P : Fin N → MvPolynomial (Fin n) A) (p : MvPolynomial (Fin N) A),
      Ideal.Quotient.mk I (MvPolynomial.map (Ideal.Quotient.mk (Ideal.span {π ^ 8}))
        (MvPolynomial.aeval P p)) =
      MvPolynomial.aeval (fun i => Ideal.Quotient.mk I
        (MvPolynomial.map (Ideal.Quotient.mk (Ideal.span {π ^ 8})) (P i)))
        (MvPolynomial.map (Ideal.Quotient.mk (Ideal.span {π ^ 8})) p) := by
    intro I P p
    induction p using MvPolynomial.induction_on with
    | C a =>
      rw [MvPolynomial.aeval_C, MvPolynomial.map_C, MvPolynomial.aeval_C,
        MvPolynomial.algebraMap_eq, MvPolynomial.map_C, ← MvPolynomial.algebraMap_eq,
        Ideal.Quotient.mk_algebraMap]
    | add p q hp hq => simp only [map_add, hp, hq]
    | mul_X p i hp => simp only [map_mul, hp, MvPolynomial.aeval_X, MvPolynomial.map_X]

  have hcs : Function.Surjective (fun p : MvPolynomial (Fin n) A =>
      Ideal.Quotient.mk (Ideal.span (Set.range fb))
        (MvPolynomial.map (Ideal.Quotient.mk (Ideal.span {π ^ 8})) p)) := by
    intro y
    obtain ⟨q, rfl⟩ := Ideal.Quotient.mk_surjective y
    obtain ⟨p, rfl⟩ := hφs q
    exact ⟨p, rfl⟩
  set f : Fin c → MvPolynomial (Fin n) A := fun j => Function.surjInv hφs (fb j) with hfdef
  have hf : ∀ j, MvPolynomial.map (Ideal.Quotient.mk (Ideal.span {π ^ 8})) (f j) = fb j :=
    fun j => Function.surjInv_eq hφs (fb j)
  set P : Fin N → MvPolynomial (Fin n) A := fun i => Function.surjInv hcs (α (cb i)) with hPdef
  have hP : ∀ i, Ideal.Quotient.mk (Ideal.span (Set.range fb))
      (MvPolynomial.map (Ideal.Quotient.mk (Ideal.span {π ^ 8})) (P i)) = α (cb i) :=
    fun i => Function.surjInv_eq hcs (α (cb i))
  have hJs : Function.Surjective
      (Ideal.Quotient.mk ((Ideal.span {π ^ 8}).map (algebraMap A Λ))) :=
    Ideal.Quotient.mk_surjective
  set lam' : Fin n → Λ := fun k => Function.surjInv hJs
    ((γb.comp β) (Ideal.Quotient.mk (Ideal.span (Set.range fb)) (MvPolynomial.X k))) with hlamdef
  have hlam' : ∀ k, (γb.comp β) (Ideal.Quotient.mk (Ideal.span (Set.range fb)) (MvPolynomial.X k)) =
      Ideal.Quotient.mk ((Ideal.span {π ^ 8}).map (algebraMap A Λ)) (lam' k) :=
    fun k => (Function.surjInv_eq hJs _).symm
  have key := s4 (Ideal.span (Set.range fb)) (γb.comp β) lam' hlam'
  obtain ⟨u, hu⟩ := hunit.exists_left_inv
  set U : MvPolynomial (Fin n) A := Function.surjInv hcs u with hUdef
  have hU : Ideal.Quotient.mk (Ideal.span (Set.range fb))
      (MvPolynomial.map (Ideal.Quotient.mk (Ideal.span {π ^ 8})) U) = u :=
    Function.surjInv_eq hcs u

  have hΔ : MvPolynomial.map (Ideal.Quotient.mk (Ideal.span {π ^ 8}))
      (Matrix.of fun i j : Fin c => MvPolynomial.pderiv (Fin.castLE hc i) (f j)).det =
      (Matrix.of fun i j : Fin c => MvPolynomial.pderiv (Fin.castLE hc i) (fb j)).det := by
    rw [RingHom.map_det]
    refine congrArg Matrix.det (Matrix.ext fun i j => ?_)
    simp only [RingHom.mapMatrix_apply, Matrix.map_apply, Matrix.of_apply]
    rw [← MvPolynomial.pderiv_map, hf]
  have hunitf : U * (Matrix.of fun i j : Fin c => MvPolynomial.pderiv (Fin.castLE hc i) (f j)).det - 1
      ∈ Ideal.span (Set.range f) ⊔ Ideal.span {MvPolynomial.C (π ^ 4)} := by
    refine sup_le_sup_left hC84 _ (s3 f hf _ ?_)
    rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, map_mul, map_one, map_sub, map_mul, map_one,
      hU, hΔ, hu, sub_self]
  have hsmooth := wc_pfc_thickened_std_smooth wc_pfc_jacobian_localization_smooth
    A (π ^ 4) n c hc f U hunitf

  have hfJ : ∀ j, MvPolynomial.aeval lam' (f j) ∈
      Ideal.span {algebraMap A Λ (π ^ 8)} := by
    intro j
    have h1 := key (f j)
    rw [hf j, Ideal.Quotient.eq_zero_iff_mem.mpr
      (Ideal.subset_span (Set.mem_range_self j)), map_zero] at h1
    have h2 := Ideal.Quotient.eq_zero_iff_mem.mp h1.symm
    rwa [Ideal.map_span, Set.image_singleton] at h2
  choose ν hν using fun j => Ideal.mem_span_singleton'.mp (hfJ j)
  set μ : Fin c → Λ := fun j => ν j * algebraMap A Λ (π ^ 4) with hμdef
  have hμ : ∀ j, MvPolynomial.aeval lam' (f j) = algebraMap A Λ (π ^ 4) * μ j := by
    intro j
    rw [← hν j, hμdef]
    simp only [map_pow]
    ring

  set F : Fin c → MvPolynomial (Fin (n + c)) A := fun j =>
    MvPolynomial.rename (Fin.castAdd c) (f j) - MvPolynomial.C (π ^ 4) *
      MvPolynomial.X (Fin.natAdd n j) with hFdef
  have hv1 : (Fin.append lam' μ : Fin (n + c) → Λ) ∘ Fin.castAdd c = lam' :=
    funext fun k => Fin.append_left lam' μ k
  set v : Fin (n + c) → Λ := Fin.append lam' μ with hvdef
  have hle : Ideal.span (Set.range F) ≤ RingHom.ker (MvPolynomial.aeval (R := A) v) := by
    rw [Ideal.span_le]
    rintro _ ⟨j, rfl⟩
    rw [SetLike.mem_coe, RingHom.mem_ker, hFdef]
    simp only [map_sub, map_mul, MvPolynomial.aeval_rename, MvPolynomial.aeval_C,
      MvPolynomial.aeval_X]
    rw [hv1, hvdef, Fin.append_right, hμ, sub_self]
  let γ : (MvPolynomial (Fin (n + c)) A ⧸ Ideal.span (Set.range F)) →ₐ[A] Λ :=
    Ideal.Quotient.liftₐ (Ideal.span (Set.range F)) (MvPolynomial.aeval v)
      (fun a ha => RingHom.mem_ker.mp (hle ha))
  let ψ : MvPolynomial (Fin n) A →ₐ[A] MvPolynomial (Fin (n + c)) A ⧸ Ideal.span (Set.range F) :=
    (Ideal.Quotient.mkₐ A (Ideal.span (Set.range F))).comp (MvPolynomial.rename (Fin.castAdd c))
  have hψ : ∀ p, ψ p = Ideal.Quotient.mk (Ideal.span (Set.range F))
      (MvPolynomial.rename (Fin.castAdd c) p) := fun p => rfl
  have hψle : Ideal.span (Set.range f) ⊔ Ideal.span {MvPolynomial.C (π ^ 4)} ≤
      Ideal.comap ψ ((Ideal.span {π ^ 4}).map
        (algebraMap A (MvPolynomial (Fin (n + c)) A ⧸ Ideal.span (Set.range F)))) := by
    have hw : algebraMap A (MvPolynomial (Fin (n + c)) A ⧸ Ideal.span (Set.range F)) (π ^ 4) ∈
        (Ideal.span {π ^ 4}).map
          (algebraMap A (MvPolynomial (Fin (n + c)) A ⧸ Ideal.span (Set.range F))) :=
      Ideal.mem_map_of_mem _ (Ideal.mem_span_singleton_self _)
    apply sup_le
    · rw [Ideal.span_le]
      rintro _ ⟨j, rfl⟩
      rw [SetLike.mem_coe, Ideal.mem_comap, hψ]
      have hF0 : Ideal.Quotient.mk (Ideal.span (Set.range F)) (F j) = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨j, rfl⟩)
      have e : MvPolynomial.rename (Fin.castAdd c) (f j) =
          F j + MvPolynomial.C (π ^ 4) * MvPolynomial.X (Fin.natAdd n j) := by
        rw [hFdef]; ring
      rw [e, map_add, hF0, zero_add, map_mul, ← MvPolynomial.algebraMap_eq,
        Ideal.Quotient.mk_algebraMap]
      exact Ideal.mul_mem_right _ _ hw
    · rw [Ideal.span_le]
      rintro _ rfl
      rw [SetLike.mem_coe, Ideal.mem_comap, hψ, MvPolynomial.rename_C,
        ← MvPolynomial.algebraMap_eq, Ideal.Quotient.mk_algebraMap]
      exact hw
  refine ⟨MvPolynomial (Fin (n + c)) A ⧸ Ideal.span (Set.range F), inferInstance, inferInstance,
    hsmooth, fun i => ψ (P i), γ, ?_, ?_⟩
  ·
    intro j
    have h1 : Ideal.Quotient.mk (Ideal.span (Set.range fb))
        (MvPolynomial.map (Ideal.Quotient.mk (Ideal.span {π ^ 8}))
          (MvPolynomial.aeval P (g j))) = 0 := by
      rw [s5, show (fun i => Ideal.Quotient.mk (Ideal.span (Set.range fb))
          (MvPolynomial.map (Ideal.Quotient.mk (Ideal.span {π ^ 8})) (P i))) =
          fun i => α (cb i) from funext hP, ← MvPolynomial.comp_aeval_apply, hcb j, map_zero]
    have h2 := sup_le_sup_left hC84 _ (s3 f hf _ (Ideal.Quotient.eq_zero_iff_mem.mp h1))
    have h3 := hψle h2
    rw [Ideal.mem_comap, MvPolynomial.comp_aeval_apply] at h3
    exact h3
  ·
    intro i
    have hval : γ (ψ (P i)) = MvPolynomial.aeval lam' (P i) := by
      rw [hψ]
      change MvPolynomial.aeval v (MvPolynomial.rename (Fin.castAdd c) (P i)) = _
      rw [MvPolynomial.aeval_rename, hv1]
    rw [hval]
    apply hJ84
    rw [← Ideal.Quotient.eq, ← key, hP, ← hγb i]
    rw [AlgHom.comp_apply]
    congr 1
    exact AlgHom.congr_fun hβα (cb i)

theorem wc_pfc_ds_kill_relations_smooth : ∀ (R : Type u) [CommRing R] (n c m : ℕ) (K : Fin c → MvPolynomial (Fin n) R) (G : Fin m → MvPolynomial (Fin n) R) (Δ ρ : MvPolynomial (Fin n) R), (∀ j, ρ * G j ∈ Ideal.span (Set.range K)) → Algebra.Smooth R (Localization.Away (Ideal.Quotient.mk (Ideal.span (Set.range K)) Δ)) → Algebra.Smooth R (Localization.Away (Ideal.Quotient.mk (Ideal.span (Set.range (Fin.append K G))) (Δ * ρ))) :=
by
  have s3 : ∀ (P Q S : Type u) [CommRing P] [CommRing Q] [CommRing S] [Algebra Q S]
      [Algebra P S] (f : P →+* Q), (∀ x : P, algebraMap P S x = algebraMap Q S (f x)) →
      Function.Surjective f → ∀ (u : P) (v : Q),
      f u = v → (∀ x : P, f x = 0 → u * x = 0) →
      IsLocalization.Away v S → IsLocalization.Away u S := by
    intro P Q S _ _ _ _ _ f htow hsurj u v huv hker hS
    show IsLocalization (Submonoid.powers u) S
    rw [isLocalization_iff]
    refine ⟨?_, ?_, ?_⟩
    · rintro ⟨y, hy⟩
      obtain ⟨k, rfl⟩ := (Submonoid.mem_powers_iff _ _).mp hy
      show IsUnit (algebraMap P S (u ^ k))
      rw [htow, map_pow, huv, map_pow]
      exact (IsLocalization.Away.algebraMap_isUnit (S := S) v).pow k
    · intro z
      obtain ⟨k, q, hq⟩ := IsLocalization.Away.surj v z
      obtain ⟨p, rfl⟩ := hsurj q
      refine ⟨(p, ⟨u ^ k, k, rfl⟩), ?_⟩
      show z * algebraMap P S (u ^ k) = algebraMap P S p
      rw [htow, htow, map_pow, huv, map_pow, hq]
    · intro x y hxy
      rw [htow, htow] at hxy
      obtain ⟨k, hk⟩ := IsLocalization.Away.exists_of_eq v hxy
      have h0 : f (u ^ k * (x - y)) = 0 := by
        rw [map_mul, map_pow, map_sub, huv, mul_sub, hk, sub_self]
      have h1 := hker _ h0
      refine ⟨⟨u ^ (k + 1), k + 1, rfl⟩, ?_⟩
      show u ^ (k + 1) * x = u ^ (k + 1) * y
      linear_combination h1
  have s4 : ∀ (R P S : Type u) [CommRing R] [CommRing P] [CommRing S] [Algebra R P] [Algebra P S]
      [Algebra R S], (∀ r : R, algebraMap R S r = algebraMap P S (algebraMap R P r)) →
      ∀ (a b : P), Algebra.Smooth R (Localization.Away a) →
      IsLocalization.Away (a * b) S → Algebra.Smooth R S := by
    intro R P S _ _ _ _ _ _ htow a b hsm hS
    haveI : IsScalarTower R P S := IsScalarTower.of_algebraMap_eq htow
    have : Algebra.Smooth (Localization.Away a)
        (Localization.Away (algebraMap P (Localization.Away a) b)) := inferInstance
    have : Algebra.Smooth R (Localization.Away (algebraMap P (Localization.Away a) b)) :=
      Algebra.Smooth.comp R (Localization.Away a) _
    have i1 : IsLocalization.Away a (Localization.Away a) := _root_.Localization.isLocalization
    have i2 : IsLocalization.Away (algebraMap P (Localization.Away a) b)
        (Localization.Away (algebraMap P (Localization.Away a) b)) :=
      _root_.Localization.isLocalization
    have h1 : IsLocalization.Away (b * a)
        (Localization.Away (algebraMap P (Localization.Away a) b)) :=
      IsLocalization.Away.mul (Localization.Away a) _ a b
    have h2 : IsLocalization.Away (a * b)
        (Localization.Away (algebraMap P (Localization.Away a) b)) := by
      rw [mul_comm]; exact h1
    let e : Localization.Away (algebraMap P (Localization.Away a) b) ≃ₐ[P] S :=
      IsLocalization.algEquiv (Submonoid.powers (a * b)) _ S
    exact Algebra.Smooth.of_equiv (e.restrictScalars R)
  intro R _ n c m K G Δ ρ hρ hsm
  have hle : Ideal.span (Set.range K) ≤ Ideal.span (Set.range (Fin.append K G)) := by
    apply Ideal.span_mono
    rintro _ ⟨l, rfl⟩
    exact ⟨Fin.castAdd m l, Fin.append_left K G l⟩
  have hcol : ∀ t ∈ Ideal.span (Set.range (Fin.append K G)), ρ * t ∈ Ideal.span (Set.range K) := by
    intro t ht
    induction ht using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨i, rfl⟩ := hx
      induction i using Fin.addCases with
      | left l =>
        rw [Fin.append_left]
        exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨l, rfl⟩)
      | right j =>
        rw [Fin.append_right]
        exact hρ j
    | zero => rw [mul_zero]; exact Submodule.zero_mem _
    | add x y _ _ hx hy => rw [mul_add]; exact Submodule.add_mem _ hx hy
    | smul a x _ hx =>
      rw [smul_eq_mul, mul_left_comm]
      exact Ideal.mul_mem_left _ a hx
  letI alg2 : Algebra (MvPolynomial (Fin n) R ⧸ Ideal.span (Set.range K))
      (Localization.Away (Ideal.Quotient.mk (Ideal.span (Set.range (Fin.append K G))) (Δ * ρ))) :=
    ((algebraMap (MvPolynomial (Fin n) R ⧸ Ideal.span (Set.range (Fin.append K G)))
      (Localization.Away (Ideal.Quotient.mk (Ideal.span (Set.range (Fin.append K G))) (Δ * ρ)))).comp
      (Ideal.Quotient.factor hle)).toAlgebra
  have t2 : ∀ r : R, algebraMap R
      (Localization.Away (Ideal.Quotient.mk (Ideal.span (Set.range (Fin.append K G))) (Δ * ρ))) r =
      algebraMap (MvPolynomial (Fin n) R ⧸ Ideal.span (Set.range K)) _
        (algebraMap R (MvPolynomial (Fin n) R ⧸ Ideal.span (Set.range K)) r) := by
    intro r
    have h := (Ideal.Quotient.factorₐ R hle).commutes r
    rw [Ideal.Quotient.factorₐ_apply] at h
    show _ = algebraMap (MvPolynomial (Fin n) R ⧸ Ideal.span (Set.range (Fin.append K G))) _
      (Ideal.Quotient.factor hle (algebraMap R _ r))
    rw [h]
    exact IsScalarTower.algebraMap_apply R
      (MvPolynomial (Fin n) R ⧸ Ideal.span (Set.range (Fin.append K G))) _ r
  have hloc : IsLocalization.Away (Ideal.Quotient.mk (Ideal.span (Set.range K)) (Δ * ρ))
      (Localization.Away (Ideal.Quotient.mk (Ideal.span (Set.range (Fin.append K G))) (Δ * ρ))) := by
    refine s3 _ _ _ (Ideal.Quotient.factor hle) (fun x => rfl) (Ideal.Quotient.factor_surjective hle) _
      (Ideal.Quotient.mk (Ideal.span (Set.range (Fin.append K G))) (Δ * ρ))
      (Ideal.Quotient.factor_mk hle _) ?_ _root_.Localization.isLocalization
    intro x hx
    obtain ⟨t, rfl⟩ := Ideal.Quotient.mk_surjective x
    have ht : t ∈ Ideal.span (Set.range (Fin.append K G)) := by
      rw [← Ideal.Quotient.eq_zero_iff_mem, ← Ideal.Quotient.factor_mk hle]
      exact hx
    rw [← map_mul, Ideal.Quotient.eq_zero_iff_mem, mul_assoc]
    exact Ideal.mul_mem_left _ _ (hcol t ht)
  rw [map_mul] at hloc
  exact s4 R _ _ t2 _ _ hsm hloc

theorem wc_pfc_ds_strictly_standard_smooth : (∀ (R : Type u) [CommRing R] (n c : ℕ) (F : Fin c → MvPolynomial (Fin n) R) (ι : Fin c → Fin n), Function.Injective ι → Algebra.Smooth R (Localization.Away (Ideal.Quotient.mk (Ideal.span (Set.range F)) (Matrix.of fun k l : Fin c => MvPolynomial.pderiv (ι k) (F l)).det))) → ∀ (R : Type u) [CommRing R] (n m c : ℕ) (hcm : c ≤ m) (F : Fin m → MvPolynomial (Fin n) R) (ι : Fin c → Fin n), Function.Injective ι → ∀ (t a : MvPolynomial (Fin n) R), t - a * (Matrix.of fun k l : Fin c => MvPolynomial.pderiv (ι k) (F (Fin.castLE hcm l))).det ∈ Ideal.span (Set.range F) → (∀ j : Fin m, c ≤ j.val → t * F j ∈ Ideal.span (F '' {j' | j'.val < c}) + Ideal.span (Set.range F) ^ 2) → Algebra.Smooth R (Localization.Away (Ideal.Quotient.mk (Ideal.span (Set.range F)) t)) :=
by
  intro H0 R _ n m c hcm F ι hι t a h1 h2
  classical

  have sDet : ∀ (S : Type u) [CommRing S] (m : ℕ) (f : Fin m → S) (J : Ideal S) (t : S),
      (∀ j, t * f j ∈ J + Ideal.span (Set.range f) ^ 2) →
      ∃ s : S, (∀ j, s * f j ∈ J) ∧ s - t ^ m ∈ Ideal.span (Set.range f) := by
    intro S _ m f J t h
    have hlin : ∀ w ∈ Ideal.span (Set.range f) ^ 2, ∃ b : Fin m → S,
        (∀ k, b k ∈ Ideal.span (Set.range f)) ∧ w = ∑ k, b k * f k := by
      intro w hw
      rw [pow_two] at hw
      refine Submodule.mul_induction_on (C := fun w => ∃ b : Fin m → S,
        (∀ k, b k ∈ Ideal.span (Set.range f)) ∧ w = ∑ k, b k * f k) hw ?_ ?_
      · intro u hu v hv
        obtain ⟨c, hc⟩ := (Ideal.mem_span_range_iff_exists_fun).mp hv
        refine ⟨fun k => u * c k, fun k => Ideal.mul_mem_right _ _ hu, ?_⟩
        rw [← hc, Finset.mul_sum]
        exact Finset.sum_congr rfl (fun k _ => by ring)
      · intro x y hx hy
        obtain ⟨b, hb, rfl⟩ := hx
        obtain ⟨b', hb', rfl⟩ := hy
        refine ⟨fun k => b k + b' k, fun k => add_mem (hb k) (hb' k), ?_⟩
        rw [← Finset.sum_add_distrib]
        exact Finset.sum_congr rfl (fun k _ => by ring)
    have hdec : ∀ j, ∃ u ∈ J, ∃ b : Fin m → S, (∀ k, b k ∈ Ideal.span (Set.range f)) ∧
        t * f j = u + ∑ k, b k * f k := by
      intro j
      obtain ⟨u, hu, w, hw, huw⟩ := Submodule.mem_sup.mp (h j)
      obtain ⟨b, hb, rfl⟩ := hlin w hw
      exact ⟨u, hu, b, hb, huw.symm⟩
    choose u hu B hB hdec using hdec
    set M : Matrix (Fin m) (Fin m) S := t • (1 : Matrix (Fin m) (Fin m) S) - Matrix.of B with hM
    have hMf : M.mulVec f = u := by
      funext j
      rw [hM, Matrix.sub_mulVec, Matrix.smul_mulVec, Matrix.one_mulVec, Pi.sub_apply, Pi.smul_apply,
        smul_eq_mul, hdec j]
      simp [Matrix.mulVec, dotProduct]
    refine ⟨M.det, ?_, ?_⟩
    · intro j
      have e : M.det * f j = (M.adjugate.mulVec (M.mulVec f)) j := by
        rw [Matrix.mulVec_mulVec, Matrix.adjugate_mul, Matrix.smul_mulVec, Matrix.one_mulVec]
        rfl
      rw [e, hMf]
      simp only [Matrix.mulVec, dotProduct]
      exact Ideal.sum_mem _ (fun k _ => Ideal.mul_mem_left _ _ (hu k))
    · rw [← Ideal.Quotient.eq, RingHom.map_det, map_pow]
      have hmat : (Ideal.Quotient.mk (Ideal.span (Set.range f))).mapMatrix M =
          Ideal.Quotient.mk (Ideal.span (Set.range f)) t •
            (1 : Matrix (Fin m) (Fin m) (S ⧸ Ideal.span (Set.range f))) := by
        ext i j
        have hz := Ideal.Quotient.eq_zero_iff_mem.mpr (hB i j)
        by_cases hij : i = j
        · subst hij; simp [hM, hz]
        · simp [hM, hij, hz]
      rw [hmat, Matrix.det_smul, Matrix.det_one, Fintype.card_fin, mul_one]

  have sAway : ∀ (Q : Type u) [CommRing Q] [Algebra R Q] (τ y : Q) (N : ℕ), τ ∣ y → y ∣ τ ^ N →
      Algebra.Smooth R (Localization.Away y) → Algebra.Smooth R (Localization.Away τ) := by
    intro Q _ _ τ y N hd1 hd2 hs
    obtain ⟨u, hu⟩ := hd1
    obtain ⟨v, hv⟩ := hd2
    have ha : IsUnit (algebraMap Q (Localization.Away y) τ) := by
      have h := IsLocalization.Away.algebraMap_isUnit (S := Localization.Away y) y
      have h' : algebraMap Q (Localization.Away y) y =
          algebraMap Q (Localization.Away y) τ * algebraMap Q (Localization.Away y) u := by
        rw [← map_mul, ← hu]
      rw [h'] at h
      exact isUnit_of_mul_isUnit_left h
    have hb : IsUnit (algebraMap Q (Localization.Away τ) y) := by
      have h := (IsLocalization.Away.algebraMap_isUnit (S := Localization.Away τ) τ).pow N
      have h' : algebraMap Q (Localization.Away τ) τ ^ N =
          algebraMap Q (Localization.Away τ) y * algebraMap Q (Localization.Away τ) v := by
        rw [← map_pow, ← map_mul, ← hv]
      rw [h'] at h
      exact isUnit_of_mul_isUnit_left h
    have hunit : ∀ (S : Type u) [CommRing S] [Algebra Q S], IsUnit (algebraMap Q S y) →
        IsUnit (algebraMap Q S τ) → ∀ r ∈ Submonoid.powers y ⊔ Submonoid.powers τ,
          IsUnit (algebraMap Q S r) := by
      intro S _ _ hy hτ r hr
      obtain ⟨a, ha', b, hb', rfl⟩ := Submonoid.mem_sup.mp hr
      obtain ⟨i, rfl⟩ := (Submonoid.mem_powers_iff _ _).mp ha'
      obtain ⟨j, rfl⟩ := (Submonoid.mem_powers_iff _ _).mp hb'
      rw [map_mul, map_pow, map_pow]
      exact (hy.pow i).mul (hτ.pow j)
    have i1 : IsLocalization (Submonoid.powers y ⊔ Submonoid.powers τ) (Localization.Away y) :=
      IsLocalization.of_le (Submonoid.powers y) _ le_sup_left
        (hunit _ (IsLocalization.Away.algebraMap_isUnit y) ha)
    have i2 : IsLocalization (Submonoid.powers y ⊔ Submonoid.powers τ) (Localization.Away τ) :=
      IsLocalization.of_le (Submonoid.powers τ) _ le_sup_right
        (hunit _ hb (IsLocalization.Away.algebraMap_isUnit τ))
    let e : Localization.Away y ≃ₐ[Q] Localization.Away τ :=
      IsLocalization.algEquiv (Submonoid.powers y ⊔ Submonoid.powers τ) _ _
    exact Algebra.Smooth.of_equiv (e.restrictScalars R)

  let K : Fin c → MvPolynomial (Fin n) R := fun l => F (Fin.castLE hcm l)
  have hJK : F '' {j' | j'.val < c} = Set.range K := by
    ext x
    constructor
    · rintro ⟨j, hj, rfl⟩
      exact ⟨⟨j.val, hj⟩, congrArg F (Fin.ext rfl)⟩
    · rintro ⟨l, rfl⟩
      exact ⟨Fin.castLE hcm l, l.isLt, rfl⟩
  have h2' : ∀ j, t * F j ∈ Ideal.span (Set.range K) + Ideal.span (Set.range F) ^ 2 := by
    intro j
    by_cases hj : c ≤ j.val
    · rw [← hJK]; exact h2 j hj
    · apply Ideal.mem_sup_left
      apply Ideal.mul_mem_left
      exact Ideal.subset_span ⟨⟨j.val, by omega⟩, congrArg F (Fin.ext rfl)⟩
  obtain ⟨s, hs, hst⟩ := sDet _ m F (Ideal.span (Set.range K)) t h2'
  have hρ : ∀ j, (t * s) * F j ∈ Ideal.span (Set.range K) := by
    intro j
    rw [mul_assoc]
    exact Ideal.mul_mem_left _ _ (hs j)
  have hW := H0 R n c K ι hι
  have hsm := wc_pfc_ds_kill_relations_smooth R n c m K F
    (Matrix.of fun k l : Fin c => MvPolynomial.pderiv (ι k) (K l)).det (t * s) hρ hW
  have hI1 : Ideal.span (Set.range (Fin.append K F)) = Ideal.span (Set.range F) := by
    apply le_antisymm
    · rw [Ideal.span_le]
      rintro _ ⟨i, rfl⟩
      induction i using Fin.addCases with
      | left l => rw [Fin.append_left]; exact Ideal.subset_span ⟨_, rfl⟩
      | right j => rw [Fin.append_right]; exact Ideal.subset_span ⟨_, rfl⟩
    · apply Ideal.span_mono
      rintro _ ⟨j, rfl⟩
      exact ⟨Fin.natAdd c j, Fin.append_right K F j⟩
  rw [hI1] at hsm
  have hτ : Ideal.Quotient.mk (Ideal.span (Set.range F)) t =
      Ideal.Quotient.mk (Ideal.span (Set.range F)) a *
        Ideal.Quotient.mk (Ideal.span (Set.range F))
          (Matrix.of fun k l : Fin c => MvPolynomial.pderiv (ι k) (K l)).det := by
    rw [← map_mul]; exact Ideal.Quotient.eq.mpr h1
  have hs' : Ideal.Quotient.mk (Ideal.span (Set.range F)) s =
      Ideal.Quotient.mk (Ideal.span (Set.range F)) t ^ m := by
    rw [← map_pow]; exact Ideal.Quotient.eq.mpr hst
  refine sAway _ _ _ (m + 2) ?_ ?_ hsm
  · refine ⟨Ideal.Quotient.mk (Ideal.span (Set.range F))
        (Matrix.of fun k l : Fin c => MvPolynomial.pderiv (ι k) (K l)).det *
        Ideal.Quotient.mk (Ideal.span (Set.range F)) s, ?_⟩
    simp only [map_mul]; ring
  · refine ⟨Ideal.Quotient.mk (Ideal.span (Set.range F)) a, ?_⟩
    rw [map_mul, map_mul, hs']
    linear_combination (Ideal.Quotient.mk (Ideal.span (Set.range F)) t) ^ (m + 1) * hτ

theorem wc_pfc_ds_nakayama_kill : ∀ (R : Type u) [CommRing R] (π : R) (n c m : ℕ) (K : Fin c → MvPolynomial (Fin n) R) (G : Fin m → MvPolynomial (Fin n) R) (J : MvPolynomial (Fin n) R), (∀ x : Localization.Away (Ideal.Quotient.mk (Ideal.span (Set.range K)) J), algebraMap R (Localization.Away (Ideal.Quotient.mk (Ideal.span (Set.range K)) J)) π * x = 0 → x = 0) → J - 1 ∈ Ideal.span {MvPolynomial.C π} + Ideal.span (Set.range K) → (∀ j, G j ∈ Ideal.span {MvPolynomial.C π ^ 2} + Ideal.span (Set.range K)) → (∀ j, MvPolynomial.C π * G j ∈ Ideal.span (Set.range K) + Ideal.span (Set.range G) ^ 2) → ∃ ρ : MvPolynomial (Fin n) R, ρ - 1 ∈ Ideal.span {MvPolynomial.C π} + Ideal.span (Set.range K) ∧ ∀ j, ρ * G j ∈ Ideal.span (Set.range K) :=
by
  intro R _ π n c m K G J hreg hJ hG3 hG4

  have s1 : ∀ (W : Type u) [CommRing W] (p : W) (m : ℕ) (g : Fin m → W),
      (∀ x : W, p * x = 0 → x = 0) → (∀ j, g j ∈ Ideal.span {p ^ 2}) →
      (∀ j, p * g j ∈ Ideal.span (Set.range g) ^ 2) →
      ∃ r : W, r - 1 ∈ Ideal.span {p} ∧ ∀ j, r * g j = 0 := by
    intro W _ p m g hp hg2 hpg
    have ha : Ideal.span (Set.range g) ≤ Ideal.span {p ^ 2} := by
      rw [Ideal.span_le]
      rintro _ ⟨j, rfl⟩
      exact hg2 j
    have hb : Ideal.span (Set.range g) ^ 2 ≤ Ideal.span {p ^ 2} * Ideal.span (Set.range g) := by
      rw [pow_two]; exact Ideal.mul_mono_left ha
    have hle : Ideal.span (Set.range g) ≤ Ideal.span {p} • Ideal.span (Set.range g) := by
      rw [Ideal.span_le]
      rintro _ ⟨j, rfl⟩
      obtain ⟨z, hz, hz'⟩ := (Ideal.mem_span_singleton_mul).mp (hb (hpg j))
      have h0 : p * (g j - p * z) = 0 := by linear_combination -hz'
      have hgz : g j = p * z := sub_eq_zero.mp (hp _ h0)
      rw [SetLike.mem_coe, Ideal.smul_eq_mul, hgz]
      exact Ideal.mem_span_singleton_mul.mpr ⟨z, hz, rfl⟩
    obtain ⟨r, hr1, hr⟩ := Submodule.exists_sub_one_mem_and_smul_eq_zero_of_fg_of_le_smul
      (Ideal.span {p}) (Ideal.span (Set.range g)) (Submodule.fg_span (Set.finite_range g)) hle
    refine ⟨r, hr1, fun j => ?_⟩
    have := hr (g j) (Ideal.subset_span ⟨j, rfl⟩)
    rwa [smul_eq_mul] at this
  simp only [Submodule.add_eq_sup] at hJ hG3 hG4 ⊢
  set I : Ideal (MvPolynomial (Fin n) R) := Ideal.span (Set.range K) with hI
  set 𝔟 : Ideal (MvPolynomial (Fin n) R) := Ideal.span {MvPolynomial.C π} ⊔ I with h𝔟
  set W := Localization.Away (Ideal.Quotient.mk I J) with hW
  set ι := algebraMap (MvPolynomial (Fin n) R ⧸ I) W with hι
  set p := algebraMap R W π with hp
  have hφC : ι (Ideal.Quotient.mk I (MvPolynomial.C π)) = p := by
    rw [hι, hp, ← MvPolynomial.algebraMap_eq, Ideal.Quotient.mk_algebraMap,
      ← IsScalarTower.algebraMap_apply]
  have hφK : ∀ e ∈ I, ι (Ideal.Quotient.mk I e) = 0 := by
    intro e he
    rw [Ideal.Quotient.eq_zero_iff_mem.mpr he, map_zero]
  have L : ∀ e : MvPolynomial (Fin n) R, ι (Ideal.Quotient.mk I e) = 0 →
      ∃ t : ℕ, J ^ t * e ∈ I := by
    intro e he
    obtain ⟨⟨_, t, rfl⟩, ht⟩ :=
      (IsLocalization.map_eq_zero_iff (Submonoid.powers (Ideal.Quotient.mk I J)) W _).mp he
    refine ⟨t, ?_⟩
    rw [← Ideal.Quotient.eq_zero_iff_mem, map_mul, map_pow]
    exact ht

  have hg2 : ∀ j, ι (Ideal.Quotient.mk I (G j)) ∈ Ideal.span {p ^ 2} := by
    intro j
    obtain ⟨a, ha, b, hb, hab⟩ := Submodule.mem_sup.mp (hG3 j)
    obtain ⟨t, rfl⟩ := Ideal.mem_span_singleton'.mp ha
    refine Ideal.mem_span_singleton'.mpr ⟨ι (Ideal.Quotient.mk I t), ?_⟩
    rw [← hab, map_add, map_add, hφK b hb, map_mul, map_mul, map_pow, map_pow, hφC, add_zero]
  have hpg : ∀ j, p * ι (Ideal.Quotient.mk I (G j)) ∈
      Ideal.span (Set.range (fun j => ι (Ideal.Quotient.mk I (G j)))) ^ 2 := by
    intro j
    obtain ⟨a, ha, b, hb, hab⟩ := Submodule.mem_sup.mp (hG4 j)
    have hmem := Ideal.mem_map_of_mem (ι.comp (Ideal.Quotient.mk I)) hb
    rw [Ideal.map_pow, Ideal.map_span, ← Set.range_comp] at hmem
    have e1 : p * ι (Ideal.Quotient.mk I (G j)) = (ι.comp (Ideal.Quotient.mk I)) b := by
      rw [RingHom.comp_apply, ← hφC, ← map_mul, ← map_mul, ← hab, map_add, map_add, hφK a ha,
        zero_add]
    rw [e1]
    exact hmem
  obtain ⟨r, hr1, hrg⟩ := s1 W p m (fun j => ι (Ideal.Quotient.mk I (G j))) hreg hg2 hpg
  have hrg' : ∀ j, r * ι (Ideal.Quotient.mk I (G j)) = 0 := fun j => hrg j

  obtain ⟨k, a, hk⟩ := IsLocalization.Away.surj (Ideal.Quotient.mk I J) r
  obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective a
  obtain ⟨y, hy⟩ := Ideal.mem_span_singleton'.mp hr1
  obtain ⟨k', b, hk'⟩ := IsLocalization.Away.surj (Ideal.Quotient.mk I J) y
  obtain ⟨y0, rfl⟩ := Ideal.Quotient.mk_surjective b
  have hk2 : r * ι (Ideal.Quotient.mk I J) ^ k = ι (Ideal.Quotient.mk I x) := hk
  have hk2' : y * ι (Ideal.Quotient.mk I J) ^ k' = ι (Ideal.Quotient.mk I y0) := hk'
  have hE : ι (Ideal.Quotient.mk I (x * J ^ k' - J ^ k * J ^ k' - y0 * MvPolynomial.C π * J ^ k))
      = 0 := by
    simp only [map_sub, map_mul, map_pow, hφC]
    linear_combination (-(ι (Ideal.Quotient.mk I J)) ^ k') * hk2
      + (p * ι (Ideal.Quotient.mk I J) ^ k) * hk2'
      - (ι (Ideal.Quotient.mk I J) ^ k * ι (Ideal.Quotient.mk I J) ^ k') * hy
  obtain ⟨t, ht⟩ := L _ hE
  have hIb : I ≤ 𝔟 := le_sup_right
  have hJ' : Ideal.Quotient.mk 𝔟 J = 1 := by
    rw [← map_one (Ideal.Quotient.mk 𝔟)]; exact Ideal.Quotient.eq.mpr hJ
  have hC' : Ideal.Quotient.mk 𝔟 (MvPolynomial.C π) = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_sup_left (Ideal.mem_span_singleton_self _))
  have hx' : Ideal.Quotient.mk 𝔟 x = 1 := by
    have h0 := Ideal.Quotient.eq_zero_iff_mem.mpr (hIb ht)
    simp only [map_sub, map_mul, map_pow, hJ', hC', one_pow, one_mul, mul_one, mul_zero,
      sub_zero] at h0
    exact sub_eq_zero.mp h0
  have hX : ∀ j, ι (Ideal.Quotient.mk I (x * G j)) = 0 := by
    intro j
    rw [map_mul, map_mul]
    linear_combination (-(ι (Ideal.Quotient.mk I (G j)))) * hk2
      + (ι (Ideal.Quotient.mk I J) ^ k) * hrg' j
  choose s hs using fun j => L _ (hX j)
  refine ⟨J ^ (∑ i, s i) * x, ?_, fun j => ?_⟩
  · rw [← Ideal.Quotient.eq, map_mul, map_pow, hJ', hx', one_pow, one_mul, map_one]
  · have hle : s j ≤ ∑ i, s i :=
      Finset.single_le_sum (fun i _ => Nat.zero_le (s i)) (Finset.mem_univ j)
    have hpow : J ^ (∑ i, s i) = J ^ (s j) * J ^ (∑ i, s i - s j) := (pow_mul_pow_sub J hle).symm
    have e : J ^ (∑ i, s i) * x * G j = J ^ (∑ i, s i - s j) * (J ^ (s j) * (x * G j)) := by
      rw [hpow]; ring
    rw [e]
    exact Ideal.mul_mem_left _ _ (hs j)

theorem wc_pfc_desingularization : ∀ (A : Type u) [CommRing A] [IsNoetherianRing A] (Λ : Type u) [CommRing Λ] [Algebra A Λ] (π : A), (∀ a : A, π * a = 0 → a = 0) → (∀ x : Λ, π • x = 0 → x = 0) → ∀ (N m : ℕ) (g : Fin m → MvPolynomial (Fin N) A) (lam : Fin N → Λ) (cc : ℕ) (hcN : cc ≤ N) (hcm : cc ≤ m) (a' : MvPolynomial (Fin N) A), (∀ j, MvPolynomial.aeval lam (g j) = 0) → (MvPolynomial.C π - a' * (Matrix.of fun i j : Fin cc => MvPolynomial.pderiv (Fin.castLE hcN i) (g (Fin.castLE hcm j))).det ∈ Ideal.span (Set.range g)) → (∀ j : Fin m, cc ≤ j.val → MvPolynomial.C π * g j ∈ Ideal.span (g '' {j' | j'.val < cc}) + Ideal.span (Set.range g) ^ 2) → ∀ (D : Type u) [CommRing D] [Algebra A D] [Algebra.Smooth A D] (d : Fin N → D) (γ : D →ₐ[A] Λ), (∀ j, MvPolynomial.aeval d (g j) ∈ (Ideal.span {π ^ 4}).map (algebraMap A D)) → (∀ i, γ (d i) - lam i ∈ (Ideal.span {π ^ 4}).map (algebraMap A Λ)) → ∃ (E : Type u) (_ : CommRing E) (_ : Algebra A E) (_ : Algebra.Smooth A E) (e : Fin N → E) (δ : E →ₐ[A] Λ), (∀ j, MvPolynomial.aeval e (g j) = 0) ∧ ∀ i, δ (e i) = lam i :=
by
  intro A _ _ Λ _ _ π hπA hπΛ N m g lam cc hcN hcm a' hglam hstd1 hstd2 D _ _ _ d γ hd hγ
  classical

  have s1 : ∀ (R : Type u) [CommRing R] (n c : ℕ) (F : Fin c → MvPolynomial (Fin n) R) (ι : Fin c → Fin n), Function.Injective ι → Algebra.Smooth R (Localization.Away (Ideal.Quotient.mk (Ideal.span (Set.range F)) (Matrix.of fun k l : Fin c => MvPolynomial.pderiv (ι k) (F l)).det)) := by
    intro R _ n c F ι hι
    exact wc_pfc_jacobian_localization_smooth R n c F ι hι _ (IsLocalization.Away.algebraMap_isUnit _)

  have s3 : ∀ (R : Type u) [CommRing R] (B : Type u) [CommRing B] [Algebra R B] (N : ℕ) (p : MvPolynomial (Fin N) R) (a y : Fin N → B) (I : Ideal B), (∀ i, y i ∈ I) → MvPolynomial.aeval (a + y) p - MvPolynomial.aeval a p - ∑ i, MvPolynomial.aeval a (MvPolynomial.pderiv i p) * y i ∈ I ^ 2 := by
    intro R _ B _ _ N p a y I hy
    induction p using MvPolynomial.induction_on with
    | C r => simp
    | add p q hp hq =>
      have e : MvPolynomial.aeval (a + y) (p + q) - MvPolynomial.aeval a (p + q) - ∑ i, MvPolynomial.aeval a (MvPolynomial.pderiv i (p + q)) * y i
          = (MvPolynomial.aeval (a + y) p - MvPolynomial.aeval a p - ∑ i, MvPolynomial.aeval a (MvPolynomial.pderiv i p) * y i)
            + (MvPolynomial.aeval (a + y) q - MvPolynomial.aeval a q - ∑ i, MvPolynomial.aeval a (MvPolynomial.pderiv i q) * y i) := by
        simp only [map_add, add_mul, Finset.sum_add_distrib]; ring
      rw [e]; exact add_mem hp hq
    | mul_X p k hp =>
      set L := ∑ i, MvPolynomial.aeval a (MvPolynomial.pderiv i p) * y i with hL
      set P := MvPolynomial.aeval a p with hP
      set e := MvPolynomial.aeval (a + y) p - P - L with he
      have hLI : L ∈ I := Ideal.sum_mem _ (fun i _ => Ideal.mul_mem_left _ _ (hy i))
      have hs : ∑ i, MvPolynomial.aeval a (MvPolynomial.pderiv i (p * MvPolynomial.X k)) * y i = L * a k + P * y k := by
        have e2 : ∀ i, MvPolynomial.aeval a (MvPolynomial.pderiv i (p * MvPolynomial.X k)) * y i =
            (if i = k then P * y k else 0) + MvPolynomial.aeval a (MvPolynomial.pderiv i p) * y i * a k := by
          intro i
          rw [Derivation.leibniz, MvPolynomial.pderiv_X, smul_eq_mul, smul_eq_mul]
          by_cases h : i = k
          · subst h; simp [hP]; ring
          · simp [Ne.symm h, h]; ring
        simp only [e2, Finset.sum_add_distrib, Finset.sum_ite_eq', Finset.mem_univ, ite_true, ← Finset.sum_mul, hL]
        ring
      have key : MvPolynomial.aeval (a + y) (p * MvPolynomial.X k) - MvPolynomial.aeval a (p * MvPolynomial.X k) - ∑ i, MvPolynomial.aeval a (MvPolynomial.pderiv i (p * MvPolynomial.X k)) * y i
          = L * y k + e * (a k + y k) := by
        rw [hs]
        simp only [map_mul, MvPolynomial.aeval_X, Pi.add_apply, he]
        ring
      rw [key, pow_two]
      exact add_mem (Ideal.mul_mem_mul hLI (hy k)) (Ideal.mul_mem_right _ _ (by rw [← pow_two]; exact hp))

  have s4 : ∀ (R : Type u) [CommRing R] (S : Type u) [CommRing S] [Algebra R S] (N n : ℕ) (p : MvPolynomial (Fin N) R) (Y : Fin N → MvPolynomial (Fin n) S) (j : Fin n), MvPolynomial.pderiv j (MvPolynomial.aeval Y p) = ∑ i, MvPolynomial.aeval Y (MvPolynomial.pderiv i p) * MvPolynomial.pderiv j (Y i) := by
    intro R _ S _ _ N n p Y j
    induction p using MvPolynomial.induction_on with
    | C r => simp [MvPolynomial.algebraMap_apply]
    | add p q hp hq => simp only [map_add, hp, hq, add_mul, Finset.sum_add_distrib]
    | mul_X p k hp =>
      have e : ∀ i, MvPolynomial.aeval Y (MvPolynomial.pderiv i (p * MvPolynomial.X k)) =
          (if i = k then MvPolynomial.aeval Y p else 0) + Y k * MvPolynomial.aeval Y (MvPolynomial.pderiv i p) := by
        intro i
        rw [Derivation.leibniz, MvPolynomial.pderiv_X, smul_eq_mul, smul_eq_mul]
        by_cases h : i = k
        · subst h; simp
        · simp [Ne.symm h, h]
      simp only [e, add_mul, Finset.sum_add_distrib, ite_mul, zero_mul, Finset.sum_ite_eq', Finset.mem_univ, ite_true]
      rw [map_mul, MvPolynomial.aeval_X, Derivation.leibniz, hp, smul_eq_mul, smul_eq_mul, Finset.mul_sum]
      simp only [mul_assoc]
      try ring

  have s5 : ∀ (R : Type u) [CommRing R] (S : Type u) [CommRing S] [Algebra R S] (a b : S), Ideal.span {a, b} = ⊤ → Algebra.Smooth R (Localization.Away a) → Algebra.Smooth R (Localization.Away b) → Algebra.Smooth R S := by
    intro R _ S _ _ a b hab ha hb
    rw [← RingHom.smooth_algebraMap]
    apply RingHom.Smooth.ofLocalizationSpanTarget (algebraMap R S) {a, b} hab
    rintro ⟨r, hr⟩
    rcases hr with rfl | hr
    · rw [← IsScalarTower.algebraMap_eq, RingHom.smooth_algebraMap]; exact ha
    · rw [Set.mem_singleton_iff] at hr
      subst hr
      rw [← IsScalarTower.algebraMap_eq, RingHom.smooth_algebraMap]; exact hb

  have s6 : ∀ (A : Type u) [CommRing A] (D : Type u) [CommRing D] [Algebra A D] (π : A) (N m cc : ℕ) (hcN : cc ≤ N) (hcm : cc ≤ m) (g : Fin m → MvPolynomial (Fin N) A) (a' : MvPolynomial (Fin N) A) (d : Fin N → D), (MvPolynomial.C π - a' * (Matrix.of fun i j : Fin cc => MvPolynomial.pderiv (Fin.castLE hcN i) (g (Fin.castLE hcm j))).det ∈ Ideal.span (Set.range g)) → (∀ j, MvPolynomial.aeval d (g j) ∈ (Ideal.span {π ^ 4}).map (algebraMap A D)) → ∃ (S : Fin N → Fin cc → D) (r : Fin cc → Fin N → D) (H : Fin cc → MvPolynomial (Fin (N + cc)) D), (∀ j, MvPolynomial.aeval (fun i => MvPolynomial.C (d i) + (MvPolynomial.C (algebraMap A D π) ^ 2 * ∑ k, MvPolynomial.C (S i k) * MvPolynomial.X (Fin.natAdd N k) + MvPolynomial.C (algebraMap A D π) ^ 3 * MvPolynomial.X (Fin.castAdd cc i))) (g j) ∈ Ideal.span {MvPolynomial.C (algebraMap A D π) ^ 2}) ∧ (∀ l : Fin cc, MvPolynomial.aeval (fun i => MvPolynomial.C (d i) + (MvPolynomial.C (algebraMap A D π) ^ 2 * ∑ k, MvPolynomial.C (S i k) * MvPolynomial.X (Fin.natAdd N k) + MvPolynomial.C (algebraMap A D π) ^ 3 * MvPolynomial.X (Fin.castAdd cc i))) (g (Fin.castLE hcm l)) = MvPolynomial.C (algebraMap A D π) ^ 3 * (MvPolynomial.X (Fin.natAdd N l) + ∑ i, MvPolynomial.C (r l i) * MvPolynomial.X (Fin.castAdd cc i) + MvPolynomial.C (algebraMap A D π) * H l)) := by
    intro A _ D _ _ π N m cc hcN hcm g a' d hstd1 hd
    set p : D := algebraMap A D π with hp
    have hd' : ∀ j, ∃ w : D, w * p ^ 4 = MvPolynomial.aeval d (g j) := by
      intro j
      have h := hd j
      rw [Ideal.map_span, Set.image_singleton, map_pow, Ideal.mem_span_singleton'] at h
      exact h
    choose w hw using hd'
    set Mb : Matrix (Fin cc) (Fin cc) D := Matrix.of fun k l =>
      MvPolynomial.aeval d (MvPolynomial.pderiv (Fin.castLE hcN k) (g (Fin.castLE hcm l))) with hMb
    set ad : D := MvPolynomial.aeval d a' with had
    have hz : ∃ z : D, z * p ^ 4 = p - ad * Mb.det := by
      have h1 := Ideal.mem_map_of_mem (MvPolynomial.aeval d : MvPolynomial (Fin N) A →ₐ[A] D) hstd1
      have hle : Ideal.map (MvPolynomial.aeval d : MvPolynomial (Fin N) A →ₐ[A] D) (Ideal.span (Set.range g)) ≤
          Ideal.span {p ^ 4} := by
        rw [Ideal.map_span, Ideal.span_le]
        rintro _ ⟨_, ⟨j, rfl⟩, rfl⟩
        rw [SetLike.mem_coe, Ideal.mem_span_singleton']
        exact ⟨w j, hw j⟩
      have h2 := hle h1
      rw [map_sub, map_mul, AlgHom.map_det, MvPolynomial.aeval_C] at h2
      rw [← Ideal.mem_span_singleton']
      convert h2 using 3
      rfl
    obtain ⟨z, hz⟩ := hz
    let S : Fin N → Fin cc → D := fun i k =>
      ∑ k', if Fin.castLE hcN k' = i then ad * Mb.transpose.adjugate k' k else 0
    let r : Fin cc → Fin N → D := fun l i =>
      MvPolynomial.aeval d (MvPolynomial.pderiv i (g (Fin.castLE hcm l)))
    have hrS : ∀ l k, ∑ i, r l i * S i k = if l = k then p - z * p ^ 4 else 0 := by
      intro l k
      simp only [S, Finset.mul_sum, mul_ite, mul_zero]
      rw [Finset.sum_comm]
      simp only [Finset.sum_ite_eq, Finset.mem_univ, ite_true]
      have e : ∀ k', r l (Fin.castLE hcN k') * (ad * Mb.transpose.adjugate k' k) =
          ad * (Mb.transpose l k' * Mb.transpose.adjugate k' k) := by
        intro k'; simp only [r, hMb, Matrix.transpose_apply, Matrix.of_apply]; ring
      simp only [e, ← Finset.mul_sum]
      rw [← Matrix.mul_apply, Matrix.mul_adjugate, Matrix.smul_apply, Matrix.one_apply,
        Matrix.det_transpose]
      split_ifs with h
      · rw [hz]; simp
      · simp
    set Y : Fin N → MvPolynomial (Fin (N + cc)) D := fun i =>
      MvPolynomial.C p ^ 2 * ∑ k, MvPolynomial.C (S i k) * MvPolynomial.X (Fin.natAdd N k) +
        MvPolynomial.C p ^ 3 * MvPolynomial.X (Fin.castAdd cc i) with hY
    set I : Ideal (MvPolynomial (Fin (N + cc)) D) := Ideal.span {MvPolynomial.C p ^ 2} with hI
    have hYI : ∀ i, Y i ∈ I := by
      intro i
      refine add_mem (Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _)) ?_
      rw [show MvPolynomial.C p ^ 3 * MvPolynomial.X (Fin.castAdd cc i) =
        MvPolynomial.C p ^ 2 * (MvPolynomial.C p * MvPolynomial.X (Fin.castAdd cc i)) by ring]
      exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _)
    have hI2 : I ^ 2 = Ideal.span {MvPolynomial.C p ^ 4} := by
      rw [hI, Ideal.span_singleton_pow]; congr 2; ring
    have hCa : ∀ q : MvPolynomial (Fin N) A,
        MvPolynomial.aeval (fun i => (MvPolynomial.C (d i) : MvPolynomial (Fin (N + cc)) D)) q =
          MvPolynomial.C (MvPolynomial.aeval d q) := by
      intro q
      have := MvPolynomial.comp_aeval_apply d (IsScalarTower.toAlgHom A D (MvPolynomial (Fin (N + cc)) D)) q
      simp only [IsScalarTower.toAlgHom_apply, MvPolynomial.algebraMap_eq] at this
      exact this.symm
    have hZeq : (fun i => MvPolynomial.C (d i) + (MvPolynomial.C p ^ 2 * ∑ k, MvPolynomial.C (S i k) *
        MvPolynomial.X (Fin.natAdd N k) + MvPolynomial.C p ^ 3 * MvPolynomial.X (Fin.castAdd cc i))) =
        (fun i => (MvPolynomial.C (d i) : MvPolynomial (Fin (N + cc)) D)) + Y := by
      funext i; rfl
    have htay : ∀ j, ∃ u : MvPolynomial (Fin (N + cc)) D,
        MvPolynomial.aeval ((fun i => (MvPolynomial.C (d i) : MvPolynomial (Fin (N + cc)) D)) + Y) (g j) =
          MvPolynomial.C (MvPolynomial.aeval d (g j)) +
            ∑ i, MvPolynomial.C (MvPolynomial.aeval d (MvPolynomial.pderiv i (g j))) * Y i +
            u * MvPolynomial.C p ^ 4 := by
      intro j
      have h := s3 A (MvPolynomial (Fin (N + cc)) D) N (g j) (fun i => MvPolynomial.C (d i)) Y I hYI
      rw [hI2, Ideal.mem_span_singleton'] at h
      obtain ⟨u, hu⟩ := h
      refine ⟨u, ?_⟩
      simp only [hCa] at hu
      rw [hu]; ring
    choose u hu using htay
    refine ⟨S, r, fun l => MvPolynomial.C (w (Fin.castLE hcm l)) + u (Fin.castLE hcm l) -
      MvPolynomial.C z * MvPolynomial.C p ^ 2 * MvPolynomial.X (Fin.natAdd N l), ?_, ?_⟩
    · intro j
      rw [hZeq, hu j, ← hw j]
      refine add_mem (add_mem ?_ ?_) ?_
      · rw [map_mul, map_pow, show MvPolynomial.C (w j) * MvPolynomial.C p ^ 4 =
          (MvPolynomial.C (w j) * MvPolynomial.C p ^ 2) * MvPolynomial.C p ^ 2 by ring]
        exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _)
      · exact Ideal.sum_mem _ (fun i _ => Ideal.mul_mem_left _ _ (hYI i))
      · rw [show u j * MvPolynomial.C p ^ 4 = (u j * MvPolynomial.C p ^ 2) * MvPolynomial.C p ^ 2 by ring]
        exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _)
    · intro l
      rw [hZeq, hu (Fin.castLE hcm l), ← hw (Fin.castLE hcm l)]
      have hlin : ∑ i, MvPolynomial.C (MvPolynomial.aeval d (MvPolynomial.pderiv i (g (Fin.castLE hcm l)))) * Y i =
          MvPolynomial.C p ^ 2 * MvPolynomial.C (p - z * p ^ 4) * MvPolynomial.X (Fin.natAdd N l) +
            MvPolynomial.C p ^ 3 * ∑ i, MvPolynomial.C (r l i) * MvPolynomial.X (Fin.castAdd cc i) := by
        have e1 : ∀ i, MvPolynomial.C (MvPolynomial.aeval d (MvPolynomial.pderiv i (g (Fin.castLE hcm l)))) * Y i =
            MvPolynomial.C p ^ 2 * ∑ k, MvPolynomial.C (r l i * S i k) * MvPolynomial.X (Fin.natAdd N k) +
              MvPolynomial.C p ^ 3 * (MvPolynomial.C (r l i) * MvPolynomial.X (Fin.castAdd cc i)) := by
          intro i
          simp only [hY, r, mul_add, Finset.mul_sum, map_mul]
          congr 1
          · refine Finset.sum_congr rfl (fun k _ => by ring)
          · ring
        simp only [e1, Finset.sum_add_distrib, ← Finset.mul_sum]
        rw [Finset.sum_comm]
        simp only [← Finset.sum_mul, ← map_sum, hrS, apply_ite MvPolynomial.C, map_zero, ite_mul, zero_mul,
          Finset.sum_ite_eq, Finset.mem_univ, ite_true]
        ring
      rw [hlin, map_mul, map_pow]
      simp only [map_sub, map_mul, map_pow]
      ring

  have s10 : ∀ (A : Type u) [CommRing A] (D : Type u) [CommRing D] [Algebra A D] (π : A), (∀ x : D, algebraMap A D π * x = 0 → x = 0) → ∀ (N m cc : ℕ) (hcN : cc ≤ N) (hcm : cc ≤ m) (g : Fin m → MvPolynomial (Fin N) A) (a' : MvPolynomial (Fin N) A) (Z : Fin N → MvPolynomial (Fin (N + cc)) D) (K : Fin cc → MvPolynomial (Fin (N + cc)) D), (MvPolynomial.C π - a' * (Matrix.of fun i j : Fin cc => MvPolynomial.pderiv (Fin.castLE hcN i) (g (Fin.castLE hcm j))).det ∈ Ideal.span (Set.range g)) → (∀ j : Fin m, cc ≤ j.val → MvPolynomial.C π * g j ∈ Ideal.span (g '' {j' | j'.val < cc}) + Ideal.span (Set.range g) ^ 2) → (∀ i i' : Fin N, MvPolynomial.pderiv (Fin.castAdd cc i) (Z i') = if i = i' then MvPolynomial.C (algebraMap A D π) ^ 3 else 0) → (∀ l : Fin cc, MvPolynomial.aeval Z (g (Fin.castLE hcm l)) = MvPolynomial.C (algebraMap A D π) ^ 3 * K l) → (MvPolynomial.C (algebraMap A D π) - MvPolynomial.aeval Z a' * (Matrix.of fun k l : Fin cc => MvPolynomial.pderiv (Fin.castAdd cc (Fin.castLE hcN k)) (K l)).det ∈ Ideal.span (Set.range fun j => MvPolynomial.aeval Z (g j))) ∧ (∀ j : Fin m, cc ≤ j.val → MvPolynomial.C (algebraMap A D π) * MvPolynomial.aeval Z (g j) ∈ Ideal.span ((fun j => MvPolynomial.aeval Z (g j)) '' {j' | j'.val < cc}) + Ideal.span (Set.range fun j => MvPolynomial.aeval Z (g j)) ^ 2) := by
    intro A _ D _ _ π hpD N m cc hcN hcm g a' Z K hstd1 hstd2 hdZ hZK
    set φ : MvPolynomial (Fin N) A →ₐ[A] MvPolynomial (Fin (N + cc)) D := MvPolynomial.aeval Z with hφ
    have hφC : φ (MvPolynomial.C π) = MvPolynomial.C (algebraMap A D π) := by
      rw [← MvPolynomial.algebraMap_eq, AlgHom.commutes, MvPolynomial.algebraMap_apply]
    have hrange : (Set.range fun j => MvPolynomial.aeval Z (g j)) = φ '' Set.range g := by
      rw [← Set.range_comp]; rfl
    have himg : ((fun j => MvPolynomial.aeval Z (g j)) '' {j' : Fin m | j'.val < cc}) = φ '' (g '' {j' | j'.val < cc}) := by
      rw [Set.image_image]
    have hreg : ∀ x : MvPolynomial (Fin (N + cc)) D, MvPolynomial.C (algebraMap A D π ^ 3) * x = 0 → x = 0 := by
      intro x hx
      ext mm
      have h := congrArg (fun q : MvPolynomial (Fin (N + cc)) D => q.coeff mm) hx
      have h2 : algebraMap A D π ^ 3 * x.coeff mm = 0 := by
        rw [← MvPolynomial.coeff_C_mul]; simpa using h
      show x.coeff mm = 0
      apply hpD; apply hpD; apply hpD
      linear_combination h2
    constructor
    · have hmat : φ.mapMatrix (Matrix.of fun i j : Fin cc => MvPolynomial.pderiv (Fin.castLE hcN i) (g (Fin.castLE hcm j))) =
          Matrix.of fun k l : Fin cc => MvPolynomial.pderiv (Fin.castAdd cc (Fin.castLE hcN k)) (K l) := by
        refine Matrix.ext fun k l => ?_
        simp only [AlgHom.mapMatrix_apply, Matrix.map_apply, Matrix.of_apply]
        have e1 := s4 A D N (N + cc) (g (Fin.castLE hcm l)) Z (Fin.castAdd cc (Fin.castLE hcN k))
        simp only [hdZ, mul_ite, mul_zero, Finset.sum_ite_eq, Finset.mem_univ, ite_true] at e1
        rw [hZK l, ← map_pow, MvPolynomial.pderiv_C_mul] at e1
        rw [← sub_eq_zero]
        apply hreg
        rw [mul_sub, e1, ← hφ]
        ring
      have h1 := Ideal.mem_map_of_mem φ hstd1
      rw [Ideal.map_span, map_sub, map_mul, hφC, AlgHom.map_det, hmat] at h1
      rw [hrange]
      exact h1
    · intro j hj
      have h2 := Ideal.mem_map_of_mem φ (hstd2 j hj)
      rw [Ideal.add_eq_sup, Ideal.map_sup, Ideal.map_pow, Ideal.map_span, Ideal.map_span, map_mul, hφC] at h2
      rw [hrange, himg, Ideal.add_eq_sup]
      exact h2

  have s9 : ∀ (D : Type u) [CommRing D] (p : D), (∀ x : D, p * x = 0 → x = 0) → ∀ (N m cc : ℕ) (hcN : cc ≤ N) (hcm : cc ≤ m) (K : Fin cc → MvPolynomial (Fin (N + cc)) D) (F : Fin m → MvPolynomial (Fin (N + cc)) D) (a : MvPolynomial (Fin (N + cc)) D), (∀ l, F (Fin.castLE hcm l) = MvPolynomial.C p ^ 3 * K l) → (∀ j, F j ∈ Ideal.span {MvPolynomial.C p ^ 2}) → (∀ j : Fin m, cc ≤ j.val → MvPolynomial.C p * F j ∈ Ideal.span (F '' {j' | j'.val < cc}) + Ideal.span (Set.range F) ^ 2) → (MvPolynomial.C p - a * (Matrix.of fun k l : Fin cc => MvPolynomial.pderiv (Fin.castAdd cc (Fin.castLE hcN k)) (K l)).det ∈ Ideal.span (Set.range F)) → (∀ k l : Fin cc, MvPolynomial.pderiv (Fin.natAdd N k) (K l) - (if k = l then 1 else 0) ∈ Ideal.span {MvPolynomial.C p}) → Algebra.Smooth D (MvPolynomial (Fin (N + cc)) D ⧸ Ideal.span (Set.range (Fin.append K F))) := by
    intro D _ p hp N m cc hcN hcm K F a hFK hF2 hSTD2 hSTD1 hdK
    set J : MvPolynomial (Fin (N + cc)) D := (Matrix.of fun k l : Fin cc => MvPolynomial.pderiv (Fin.natAdd N k) (K l)).det with hJ
    set 𝔟 : Ideal (MvPolynomial (Fin (N + cc)) D) := Ideal.span {MvPolynomial.C p} + Ideal.span (Set.range K) with h𝔟
    have hWsm : Algebra.Smooth D (Localization.Away (Ideal.Quotient.mk (Ideal.span (Set.range K)) J)) :=
      s1 D (N + cc) cc K (Fin.natAdd N) (fun a b h => (Fin.natAdd_inj N).mp h)
    have hpmem : p ∈ nonZeroDivisors D :=
      mem_nonZeroDivisors_iff.mpr ⟨hp, fun x hx => hp x (by rw [mul_comm]; exact hx)⟩
    have hWreg : ∀ x : Localization.Away (Ideal.Quotient.mk (Ideal.span (Set.range K)) J),
        algebraMap D (Localization.Away (Ideal.Quotient.mk (Ideal.span (Set.range K)) J)) p * x = 0 → x = 0 := by
      intro x hx
      have hreg := Module.Flat.isSMulRegular_of_nonZeroDivisors
        (M := Localization.Away (Ideal.Quotient.mk (Ideal.span (Set.range K)) J)) hpmem
      apply hreg
      show p • x = p • (0 : Localization.Away (Ideal.Quotient.mk (Ideal.span (Set.range K)) J))
      rw [smul_zero, Algebra.smul_def]
      exact hx
    have hJ1 : J - 1 ∈ 𝔟 := by
      apply Ideal.mem_sup_left
      rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, map_one, sub_eq_zero, hJ, RingHom.map_det]
      rw [← Matrix.det_one (R := MvPolynomial (Fin (N + cc)) D ⧸ Ideal.span {MvPolynomial.C p}) (n := Fin cc)]
      congr 1
      refine Matrix.ext fun k l => ?_
      simp only [RingHom.mapMatrix_apply, Matrix.map_apply, Matrix.of_apply]
      have h := hdK k l
      rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, sub_eq_zero] at h
      rw [h, Matrix.one_apply]
      split_ifs <;> simp
    have hlt : ∀ j : Fin m, j.val < cc → ∃ l : Fin cc, F j = MvPolynomial.C p ^ 3 * K l := by
      intro j hj
      refine ⟨⟨j.val, hj⟩, ?_⟩
      rw [← hFK]
      congr 1
    have hFltK : Ideal.span (F '' {j' | j'.val < cc}) ≤ Ideal.span (Set.range K) := by
      rw [Ideal.span_le]
      rintro _ ⟨j, hj, rfl⟩
      obtain ⟨l, hl⟩ := hlt j hj
      rw [hl]
      exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨l, rfl⟩)
    have hpF : ∀ j : Fin m, MvPolynomial.C p * F j ∈ Ideal.span (Set.range K) + Ideal.span (Set.range F) ^ 2 := by
      intro j
      by_cases hj : j.val < cc
      · obtain ⟨l, hl⟩ := hlt j hj
        apply Ideal.mem_sup_left
        rw [hl]
        exact Ideal.mul_mem_left _ _ (Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨l, rfl⟩))
      · have h := hSTD2 j (by omega)
        exact (sup_le_sup_right hFltK _) h
    obtain ⟨ρ, hρ1, hρF⟩ := wc_pfc_ds_nakayama_kill D p (N + cc) cc m K F J hWreg hJ1
      (fun j => Ideal.mem_sup_left (hF2 j)) hpF
    have hdsm : Algebra.Smooth D (Localization.Away (Ideal.Quotient.mk (Ideal.span (Set.range (Fin.append K F))) (J * ρ))) :=
      wc_pfc_ds_kill_relations_smooth D (N + cc) cc m K F J ρ hρF hWsm
    have hcastK : ∀ l : Fin cc, Fin.append K F (Fin.castLE (Nat.le_add_right cc m) l) = K l := by
      intro l
      rw [show Fin.castLE (Nat.le_add_right cc m) l = Fin.castAdd m l from Fin.ext rfl, Fin.append_left]
    have hFle : Ideal.span (Set.range F) ≤ Ideal.span (Set.range (Fin.append K F)) := by
      apply Ideal.span_mono
      rintro _ ⟨j, rfl⟩
      exact ⟨Fin.natAdd cc j, Fin.append_right K F j⟩
    have hKle : Ideal.span (Set.range K) ≤ Ideal.span (Fin.append K F '' {j' | j'.val < cc}) := by
      apply Ideal.span_mono
      rintro _ ⟨l, rfl⟩
      refine ⟨Fin.castAdd m l, ?_, Fin.append_left K F l⟩
      show (Fin.castAdd m l).val < cc
      simp
    have hinj : Function.Injective (Fin.castAdd cc ∘ Fin.castLE hcN) :=
      (Fin.castAdd_injective N cc).comp (Fin.castLE_injective hcN)
    have hesm : Algebra.Smooth D (Localization.Away (Ideal.Quotient.mk (Ideal.span (Set.range (Fin.append K F))) (MvPolynomial.C p))) := by
      refine wc_pfc_ds_strictly_standard_smooth s1 D (N + cc) (cc + m) cc (Nat.le_add_right cc m) (Fin.append K F)
        (Fin.castAdd cc ∘ Fin.castLE hcN) hinj (MvPolynomial.C p) a ?_ ?_
      · simp only [Function.comp_apply, hcastK]
        exact hFle hSTD1
      · intro j hj
        induction j using Fin.addCases with
        | left l =>
          exfalso
          simp at hj
          omega
        | right j =>
          rw [Fin.append_right]
          have h := hpF j
          refine (sup_le_sup (le_trans hKle le_rfl) (Ideal.pow_right_mono hFle 2)) h
    have hcover : Ideal.span {Ideal.Quotient.mk (Ideal.span (Set.range (Fin.append K F))) (MvPolynomial.C p),
        Ideal.Quotient.mk (Ideal.span (Set.range (Fin.append K F))) (J * ρ)} = ⊤ := by
      have hJρ : J * ρ - 1 ∈ 𝔟 := by
        have : J * ρ - 1 = (J - 1) * ρ + (ρ - 1) := by ring
        rw [this]
        exact add_mem (Ideal.mul_mem_right _ _ hJ1) hρ1
      obtain ⟨α, hα, κ, hκ, hακ⟩ := Submodule.mem_sup.mp hJρ
      obtain ⟨β, hβ⟩ := Ideal.mem_span_singleton'.mp hα
      have hκ' : Ideal.Quotient.mk (Ideal.span (Set.range (Fin.append K F))) κ = 0 := by
        rw [Ideal.Quotient.eq_zero_iff_mem]
        refine Ideal.span_mono ?_ hκ
        rintro _ ⟨l, rfl⟩
        exact ⟨Fin.castAdd m l, Fin.append_left K F l⟩
      rw [Ideal.eq_top_iff_one, Ideal.mem_span_pair]
      refine ⟨-Ideal.Quotient.mk _ β, 1, ?_⟩
      have e : J * ρ = 1 + β * MvPolynomial.C p + κ := by rw [hβ]; linear_combination -hακ
      rw [e]
      simp only [map_add, map_mul, map_one, hκ']
      ring
    exact s5 D _ _ _ hcover hesm hdsm

  have hπmem : π ∈ nonZeroDivisors A :=
    mem_nonZeroDivisors_iff.mpr ⟨hπA, fun x hx => hπA x (by rw [mul_comm]; exact hx)⟩
  have hpD : ∀ x : D, algebraMap A D π * x = 0 → x = 0 := by
    intro x hx
    have hreg := Module.Flat.isSMulRegular_of_nonZeroDivisors (M := D) hπmem
    apply hreg
    show π • x = π • (0 : D)
    rw [smul_zero, Algebra.smul_def]
    exact hx

  have hμ : ∀ i, ∃ μ : Λ, μ * (algebraMap A Λ π) ^ 4 = γ (d i) - lam i := by
    intro i
    have h := hγ i
    rw [Ideal.map_span, Set.image_singleton, map_pow, Ideal.mem_span_singleton'] at h
    exact h
  choose μ hμ using hμ

  obtain ⟨S, r, H, hF2, hFK⟩ := s6 A D π N m cc hcN hcm g a' d hstd1 hd
  set Z : Fin N → MvPolynomial (Fin (N + cc)) D := fun i => MvPolynomial.C (d i) +
    (MvPolynomial.C (algebraMap A D π) ^ 2 * ∑ k, MvPolynomial.C (S i k) * MvPolynomial.X (Fin.natAdd N k) +
      MvPolynomial.C (algebraMap A D π) ^ 3 * MvPolynomial.X (Fin.castAdd cc i)) with hZ
  set K : Fin cc → MvPolynomial (Fin (N + cc)) D := fun l => MvPolynomial.X (Fin.natAdd N l) +
    ∑ i, MvPolynomial.C (r l i) * MvPolynomial.X (Fin.castAdd cc i) + MvPolynomial.C (algebraMap A D π) * H l with hK
  set F : Fin m → MvPolynomial (Fin (N + cc)) D := fun j => MvPolynomial.aeval Z (g j) with hF
  have hne : ∀ (i : Fin N) (k : Fin cc), Fin.castAdd cc i ≠ Fin.natAdd N k := by
    intro i k h
    have := congrArg Fin.val h
    simp only [Fin.val_castAdd, Fin.val_natAdd] at this
    omega

  have hdZ : ∀ i i' : Fin N, MvPolynomial.pderiv (Fin.castAdd cc i) (Z i') =
      if i = i' then MvPolynomial.C (algebraMap A D π) ^ 3 else 0 := by
    intro i i'
    simp only [hZ, map_add, map_sum, Derivation.leibniz, Derivation.leibniz_pow, MvPolynomial.pderiv_C,
      MvPolynomial.pderiv_X, Pi.single_apply, smul_eq_mul, mul_zero, add_zero, zero_add,
      Fin.castAdd_inj, (hne _ _).symm, ite_false, Finset.sum_const_zero, smul_zero]
    by_cases h : i = i'
    · subst h; simp
    · simp [h, Ne.symm h]
  obtain ⟨hSTD1', hSTD2'⟩ := s10 A D π hpD N m cc hcN hcm g a' Z K hstd1 hstd2 hdZ hFK

  have hdK : ∀ k l : Fin cc, MvPolynomial.pderiv (Fin.natAdd N k) (K l) - (if k = l then 1 else 0) ∈
      Ideal.span {MvPolynomial.C (algebraMap A D π)} := by
    intro k l
    have e : MvPolynomial.pderiv (Fin.natAdd N k) (K l) - (if k = l then 1 else 0) =
        MvPolynomial.C (algebraMap A D π) * MvPolynomial.pderiv (Fin.natAdd N k) (H l) := by
      simp only [hK, map_add, map_sum, Derivation.leibniz, MvPolynomial.pderiv_C,
        MvPolynomial.pderiv_X, Pi.single_apply, smul_eq_mul, mul_zero, zero_mul, add_zero,
        hne, ite_false, Finset.sum_const_zero, Fin.natAdd_inj]
      by_cases h : k = l
      · subst h; simp
      · simp [h, Ne.symm h]
    rw [e]
    exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _)

  have hEsm : Algebra.Smooth D (MvPolynomial (Fin (N + cc)) D ⧸ Ideal.span (Set.range (Fin.append K F))) :=
    s9 D (algebraMap A D π) hpD N m cc hcN hcm K F (MvPolynomial.aeval Z a') hFK hF2 hSTD2' hSTD1' hdK
  haveI := hEsm
  have hAsm : Algebra.Smooth A (MvPolynomial (Fin (N + cc)) D ⧸ Ideal.span (Set.range (Fin.append K F))) :=
    Algebra.Smooth.comp A D _

  set I := Ideal.span (Set.range (Fin.append K F)) with hI
  have hge : ∀ j, MvPolynomial.aeval (fun i => Ideal.Quotient.mk I (Z i)) (g j) = 0 := by
    intro j
    have h1 := MvPolynomial.comp_aeval_apply Z (Ideal.Quotient.mkₐ A I) (g j)
    simp only [Ideal.Quotient.mkₐ_eq_mk] at h1
    rw [← h1, Ideal.Quotient.eq_zero_iff_mem]
    have : MvPolynomial.aeval Z (g j) = Fin.append K F (Fin.natAdd cc j) := by
      rw [Fin.append_right]
    rw [this]
    exact Ideal.subset_span ⟨_, rfl⟩

  let ν : Fin (N + cc) → Λ := Fin.append (fun i => -(algebraMap A Λ π * μ i)) (fun _ => 0)
  let Ψ : MvPolynomial (Fin (N + cc)) D →ₐ[A] Λ :=
    { MvPolynomial.eval₂Hom (γ : D →+* Λ) ν with
      commutes' := fun a => by
        show MvPolynomial.eval₂ (γ : D →+* Λ) ν (algebraMap A (MvPolynomial (Fin (N + cc)) D) a) = _
        rw [MvPolynomial.algebraMap_apply, MvPolynomial.eval₂_C]
        exact γ.commutes a }
  have hΨ : ∀ q, Ψ q = MvPolynomial.eval₂ (γ : D →+* Λ) ν q := fun q => rfl
  have hγp : (γ : D →+* Λ) (algebraMap A D π) = algebraMap A Λ π := γ.commutes π
  have hΨZ : ∀ i, Ψ (Z i) = lam i := by
    intro i
    rw [hΨ]
    simp only [hZ, MvPolynomial.eval₂_add, MvPolynomial.eval₂_mul, MvPolynomial.eval₂_pow,
      MvPolynomial.eval₂_C, MvPolynomial.eval₂_X, MvPolynomial.eval₂_sum, ν, Fin.append_left,
      Fin.append_right, mul_zero, Finset.sum_const_zero, hγp]
    have h := hμ i
    simp only [RingHom.coe_coe] at h ⊢
    linear_combination -h
  have hΨF : ∀ j, Ψ (F j) = 0 := by
    intro j
    show Ψ (MvPolynomial.aeval Z (g j)) = 0
    rw [MvPolynomial.comp_aeval_apply]
    simp only [hΨZ]
    exact hglam j
  have hΨK : ∀ l, Ψ (K l) = 0 := by
    intro l
    have h1 := hΨF (Fin.castLE hcm l)
    have h2 : F (Fin.castLE hcm l) = MvPolynomial.C (algebraMap A D π) ^ 3 * K l := hFK l
    rw [h2, map_mul, map_pow] at h1
    have h3 : Ψ (MvPolynomial.C (algebraMap A D π)) = algebraMap A Λ π := by
      rw [← MvPolynomial.algebraMap_apply, AlgHom.commutes]
    rw [h3] at h1
    have hreg : ∀ x : Λ, algebraMap A Λ π * x = 0 → x = 0 := fun x hx =>
      hπΛ x (by rw [Algebra.smul_def]; exact hx)
    apply hreg; apply hreg; apply hreg
    rw [← h1]; ring
  have hker : I ≤ RingHom.ker Ψ := by
    rw [hI, Ideal.span_le]
    rintro _ ⟨j, rfl⟩
    induction j using Fin.addCases with
    | left l => rw [SetLike.mem_coe, RingHom.mem_ker, Fin.append_left]; exact hΨK l
    | right j => rw [SetLike.mem_coe, RingHom.mem_ker, Fin.append_right]; exact hΨF j
  have hker' : ∀ a ∈ I, Ψ a = 0 := fun a ha => RingHom.mem_ker.mp (hker ha)
  let δ := Ideal.Quotient.liftₐ I Ψ hker'
  refine ⟨MvPolynomial (Fin (N + cc)) D ⧸ I, inferInstance, inferInstance, hAsm,
    fun i => Ideal.Quotient.mk I (Z i), δ, hge, ?_⟩
  intro i
  show Ideal.Quotient.liftₐ I Ψ hker' (Ideal.Quotient.mk I (Z i)) = lam i
  rw [Ideal.Quotient.liftₐ_apply]
  exact (Ideal.Quotient.lift_mk _ _ _).trans (hΨZ i)

theorem wc_hnas_pfc_popescu_reduction_to_field : (∀ (k : Type u) [Field k] (Λ : Type u) [CommRing Λ] [IsNoetherianRing Λ] [Algebra k Λ], (∀ (L : Type u) [Field L] [Algebra k L] [FiniteDimensional k L] (𝔔 : Ideal (TensorProduct k L Λ)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) → ∀ (n : ℕ) (s : Finset (MvPolynomial (Fin n) k)) (b : Fin n → Λ), (∀ f ∈ s, MvPolynomial.aeval b f = 0) → ∃ (D : Type u) (_ : CommRing D) (_ : Algebra k D) (_ : Algebra.Smooth k D) (c : Fin n → D) (γ : D →ₐ[k] Λ), (∀ f ∈ s, MvPolynomial.aeval c f = 0) ∧ ∀ i, γ (c i) = b i) → ∀ (A : Type u) [CommRing A] [IsNoetherianRing A] (Λ : Type u) [CommRing Λ] [IsNoetherianRing Λ] [Algebra A Λ], Module.Flat A Λ → (∀ (𝔭 : Ideal A) [𝔭.IsPrime] (L : Type u) [Field L] [Algebra A L] [Algebra 𝔭.ResidueField L] [IsScalarTower A 𝔭.ResidueField L] [FiniteDimensional 𝔭.ResidueField L] (𝔔 : Ideal (TensorProduct A L Λ)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) → ∀ (n : ℕ) (s : Finset (MvPolynomial (Fin n) A)) (b : Fin n → Λ), (∀ f ∈ s, MvPolynomial.aeval b f = 0) → ∃ (D : Type u) (_ : CommRing D) (_ : Algebra A D) (_ : Algebra.Smooth A D) (c : Fin n → D) (γ : D →ₐ[A] Λ), (∀ f ∈ s, MvPolynomial.aeval c f = 0) ∧ ∀ i, γ (c i) = b i :=
by
  intro FIELD A _ _ Λ _ _ _ hF hR
  classical

  have step : ∀ (A₀ : Type u) [CommRing A₀] [IsNoetherianRing A₀] (Λ₀ : Type u) [CommRing Λ₀]
      [IsNoetherianRing Λ₀] [Algebra A₀ Λ₀], Module.Flat A₀ Λ₀ →
      (∀ (𝔭 : Ideal A₀) [𝔭.IsPrime] (L : Type u) [Field L] [Algebra A₀ L] [Algebra 𝔭.ResidueField L]
        [IsScalarTower A₀ 𝔭.ResidueField L] [FiniteDimensional 𝔭.ResidueField L]
        (𝔔 : Ideal (TensorProduct A₀ L Λ₀)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) →
      (∀ J₀ : Ideal A₀, J₀ ≠ ⊥ → ∀ (n : ℕ) (s : Finset (MvPolynomial (Fin n) (A₀ ⧸ J₀)))
        (b : Fin n → Λ₀ ⧸ J₀.map (algebraMap A₀ Λ₀)), (∀ f ∈ s, MvPolynomial.aeval b f = 0) →
        ∃ (D : Type u) (_ : CommRing D) (_ : Algebra (A₀ ⧸ J₀) D) (_ : Algebra.Smooth (A₀ ⧸ J₀) D)
          (c : Fin n → D) (γ : D →ₐ[A₀ ⧸ J₀] Λ₀ ⧸ J₀.map (algebraMap A₀ Λ₀)),
          (∀ f ∈ s, MvPolynomial.aeval c f = 0) ∧ ∀ i, γ (c i) = b i) →
      ∀ (n : ℕ) (s : Finset (MvPolynomial (Fin n) A₀)) (b : Fin n → Λ₀),
        (∀ f ∈ s, MvPolynomial.aeval b f = 0) →
        ∃ (D : Type u) (_ : CommRing D) (_ : Algebra A₀ D) (_ : Algebra.Smooth A₀ D) (c : Fin n → D)
          (γ : D →ₐ[A₀] Λ₀), (∀ f ∈ s, MvPolynomial.aeval c f = 0) ∧ ∀ i, γ (c i) = b i := by
    intro A₀ _ _ Λ₀ _ _ _ hF₀ hR₀ IH₀ n s b hb
    by_cases hsub : Subsingleton A₀
    ·
      haveI : Subsingleton Λ₀ := by
        refine subsingleton_of_zero_eq_one (M₀ := Λ₀) ?_
        rw [← map_zero (algebraMap A₀ Λ₀), ← map_one (algebraMap A₀ Λ₀), Subsingleton.elim (0 : A₀) 1]
      refine ⟨A₀, inferInstance, inferInstance, inferInstance, fun _ => 0, Algebra.ofId A₀ Λ₀, ?_, ?_⟩
      · intro f _
        exact Subsingleton.elim _ _
      · intro i
        exact Subsingleton.elim _ _
    haveI : Nontrivial A₀ := not_subsingleton_iff_nontrivial.mp hsub
    by_cases hred : IsReduced A₀
    ·
      haveI := hred
      haveI := hF₀
      obtain ⟨r, e, he1, horth, hidem, hfac⟩ := wc_pfc_total_fractions_factors FIELD A₀ Λ₀ hF₀ hR₀
      have hPTQ := wc_pfc_pt_finite_product (Localization (nonZeroDivisors A₀))
        (Localization (Algebra.algebraMapSubmonoid Λ₀ (nonZeroDivisors A₀))) r e he1 horth hidem hfac
      obtain ⟨D', _, _, _, c', γ', hc', hγ'⟩ := hPTQ n
        (s.image (MvPolynomial.map (algebraMap A₀ (Localization (nonZeroDivisors A₀)))))
        (fun i => algebraMap Λ₀ (Localization (Algebra.algebraMapSubmonoid Λ₀ (nonZeroDivisors A₀))) (b i))
        (by
          intro f hf
          obtain ⟨f₀, hf₀, rfl⟩ := Finset.mem_image.mp hf
          rw [MvPolynomial.aeval_map_algebraMap]
          have h := MvPolynomial.aeval_algebraMap_apply
            (Localization (Algebra.algebraMapSubmonoid Λ₀ (nonZeroDivisors A₀))) b f₀
          rw [show (fun i => algebraMap Λ₀ (Localization (Algebra.algebraMapSubmonoid Λ₀
              (nonZeroDivisors A₀))) (b i)) = ⇑(algebraMap Λ₀ (Localization
              (Algebra.algebraMapSubmonoid Λ₀ (nonZeroDivisors A₀)))) ∘ b from rfl, h, hb f₀ hf₀,
            map_zero])
      obtain ⟨N, cN, hcN, F, α, β, hβα, hunit⟩ :=
        wc_pfc_smooth_std_retract (Localization (nonZeroDivisors A₀)) D'
      have h1 : ∀ f ∈ s, MvPolynomial.aeval (fun i => α (c' i))
          (f.map (algebraMap A₀ (Localization (nonZeroDivisors A₀)))) = 0 := by
        intro f hf
        rw [← MvPolynomial.comp_aeval_apply, hc' _ (Finset.mem_image_of_mem _ hf), map_zero]
      have h2 : ∀ i, (γ'.comp β) (α (c' i)) =
          algebraMap Λ₀ (Localization (Algebra.algebraMapSubmonoid Λ₀ (nonZeroDivisors A₀))) (b i) := by
        intro i
        have hβα' := AlgHom.congr_fun hβα (c' i)
        rw [AlgHom.comp_apply, AlgHom.id_apply] at hβα'
        rw [AlgHom.comp_apply, hβα', hγ' i]
      obtain ⟨N', hnN, m, cc, hcN', hcm, g, lam, π, a', hπM, hlam, hglam, hsg, hstd1, hstd2⟩ :=
        wc_pfc_elementary_standard_descent A₀ Λ₀ (nonZeroDivisors A₀) n s b hb N cN hcN F hunit
          (fun i => α (c' i)) (γ'.comp β) h1 h2
      have hπA : ∀ a : A₀, π * a = 0 → a = 0 := fun a ha =>
        (mul_left_mem_nonZeroDivisors_eq_zero_iff hπM).mp ha
      have hπΛ : ∀ x : Λ₀, π • x = 0 → x = 0 := by
        intro x hx
        have hreg := Module.Flat.isSMulRegular_of_nonZeroDivisors (M := Λ₀) hπM
        exact hreg (show π • x = π • (0 : Λ₀) by rw [hx, smul_zero])
      have hne : Ideal.span {π ^ 8} ≠ ⊥ := by
        intro h
        exact nonZeroDivisors.ne_zero (pow_mem hπM 8) (Ideal.span_singleton_eq_bot.mp h)
      have hsol : ∀ f ∈ Finset.univ.image (fun j => (g j).map (Ideal.Quotient.mk (Ideal.span {π ^ 8}))),
          MvPolynomial.aeval (fun i => Ideal.Quotient.mk ((Ideal.span {π ^ 8}).map (algebraMap A₀ Λ₀))
            (lam i)) f = 0 := by
        intro f hf
        obtain ⟨j, -, rfl⟩ := Finset.mem_image.mp hf
        rw [show (g j).map (Ideal.Quotient.mk (Ideal.span {π ^ 8})) =
            (g j).map (algebraMap A₀ (A₀ ⧸ Ideal.span {π ^ 8})) from rfl,
          MvPolynomial.aeval_map_algebraMap]
        exact (MvPolynomial.aeval_algebraMap_apply
          (Λ₀ ⧸ (Ideal.span {π ^ 8}).map (algebraMap A₀ Λ₀)) lam (g j)).trans
          (by rw [hglam j, map_zero])
      obtain ⟨C, _, _, _, cb, γb, hcb, hγb⟩ := IH₀ _ hne N'
        (Finset.univ.image (fun j => (g j).map (Ideal.Quotient.mk (Ideal.span {π ^ 8}))))
        (fun i => Ideal.Quotient.mk ((Ideal.span {π ^ 8}).map (algebraMap A₀ Λ₀)) (lam i)) hsol
      have hcb' : ∀ j, MvPolynomial.aeval cb ((g j).map (Ideal.Quotient.mk (Ideal.span {π ^ 8}))) = 0 :=
        fun j => hcb _ (Finset.mem_image_of_mem _ (Finset.mem_univ j))
      obtain ⟨D, _, _, _, d, γ, hd, hγ⟩ :=
        wc_pfc_lifting_mod_pi A₀ Λ₀ π hπA hπΛ N' m g lam hglam C cb γb hcb' hγb
      obtain ⟨E, _, _, _, e', δ, he', hδ⟩ :=
        wc_pfc_desingularization A₀ Λ₀ π hπA hπΛ N' m g lam cc hcN' hcm a' hglam hstd1 hstd2
          D d γ hd hγ
      refine ⟨E, inferInstance, inferInstance, inferInstance, fun i => e' (Fin.castLE hnN i), δ, ?_, ?_⟩
      · intro f hf
        have hle : Ideal.span (Set.range g) ≤ RingHom.ker (MvPolynomial.aeval e') := by
          rw [Ideal.span_le]
          rintro _ ⟨j, rfl⟩
          exact RingHom.mem_ker.mpr (he' j)
        have h0 := RingHom.mem_ker.mp (hle (hsg f hf))
        rw [MvPolynomial.aeval_rename] at h0
        exact h0
      · intro i
        show δ (e' (Fin.castLE hnN i)) = b i
        rw [hδ, hlam]
    ·
      have hN : nilradical A₀ ≠ ⊥ := by
        intro h
        apply hred
        refine ⟨fun x hx => ?_⟩
        have hx' : x ∈ nilradical A₀ := mem_nilradical.mpr hx
        rw [h] at hx'
        exact Ideal.mem_bot.mp hx'
      obtain ⟨k, hk⟩ := IsNoetherianRing.isNilpotent_nilradical A₀
      have hex : ∃ k, nilradical A₀ ^ k = ⊥ := ⟨k, by rw [hk]; rfl⟩
      obtain ⟨k0, hk0, hmin⟩ : ∃ k0, nilradical A₀ ^ k0 = ⊥ ∧ ∀ m < k0, nilradical A₀ ^ m ≠ ⊥ :=
        ⟨Nat.find hex, Nat.find_spec hex, fun m hm => Nat.find_min hex hm⟩
      have hk0ne0 : k0 ≠ 0 := by
        intro h
        rw [h, pow_zero, Ideal.one_eq_top] at hk0
        exact top_ne_bot hk0
      have hk0ne1 : k0 ≠ 1 := by
        intro h
        rw [h, pow_one] at hk0
        exact hN hk0
      have hJ : nilradical A₀ ^ (k0 - 1) ≠ ⊥ := hmin _ (by omega)
      have hJ2 : (nilradical A₀ ^ (k0 - 1)) ^ 2 = ⊥ := by
        rw [← pow_mul]
        exact le_bot_iff.mp (le_trans (Ideal.pow_le_pow_right (by omega)) hk0.le)
      have hPT := IH₀ _ hJ
      have happrox := wc_pfc_sq_zero_approx wc_pfc_smooth_std_retract
      obtain ⟨B, _, _, _, c, ψ, hc, hψ⟩ := happrox A₀ Λ₀ _ hJ2 hPT n s b hb
      exact wc_pfc_sq_zero_exact happrox A₀ Λ₀ hF₀ _ hJ2 hPT n s b hb B c ψ hc hψ

  have main : ∀ I : Ideal A, ∀ (n : ℕ) (s : Finset (MvPolynomial (Fin n) (A ⧸ I)))
      (b : Fin n → Λ ⧸ I.map (algebraMap A Λ)), (∀ f ∈ s, MvPolynomial.aeval b f = 0) →
      ∃ (D : Type u) (_ : CommRing D) (_ : Algebra (A ⧸ I) D) (_ : Algebra.Smooth (A ⧸ I) D)
        (c : Fin n → D) (γ : D →ₐ[A ⧸ I] Λ ⧸ I.map (algebraMap A Λ)),
        (∀ f ∈ s, MvPolynomial.aeval c f = 0) ∧ ∀ i, γ (c i) = b i := by
    intro I
    induction I using WellFoundedGT.induction
    rename_i I IH
    obtain ⟨hFI, hRI⟩ := wc_pfc_quotient_hyps A Λ hF hR I
    refine step (A ⧸ I) (Λ ⧸ I.map (algebraMap A Λ)) hFI hRI ?_
    intro J₀ hJ₀
    apply wc_pfc_pt_quotient_quotient A Λ I J₀
    apply IH
    refine lt_of_le_of_ne ?_ ?_
    · intro x hx
      rw [Ideal.mem_comap, Ideal.Quotient.eq_zero_iff_mem.mpr hx]
      exact zero_mem _
    · intro h
      apply hJ₀
      rw [← Ideal.map_comap_of_surjective _ Ideal.Quotient.mk_surjective J₀, ← h,
        Ideal.map_quotient_self]
  exact step A Λ hF hR (fun J _ => main J)

theorem wc_pfc_smooth_factor_of_unit_ideal : ∀ (R : Type u) [CommRing R] (A : Type u) [CommRing A] [Algebra R A] (Λ : Type u) [CommRing Λ] [Algebra R Λ] (φ : A →ₐ[R] Λ), (1 : Λ) ∈ Ideal.span (φ '' {a : A | Algebra.Smooth R (Localization.Away a)}) → ∃ (D : Type u) (_ : CommRing D) (_ : Algebra R D) (_ : Algebra.Smooth R D) (ψ : A →ₐ[R] D) (χ : D →ₐ[R] Λ), χ.comp ψ = φ :=
by
  intro R _ A _ _ Λ _ _ φ h1
  classical

  have hloc : ∀ (S : Type u) [CommRing S] [Algebra R S] (s : Set S), Ideal.span s = ⊤ →
      (∀ x ∈ s, Algebra.Smooth R (Localization.Away x)) → Algebra.Smooth R S := by
    intro S _ _ s hs H
    rw [← RingHom.smooth_algebraMap]
    refine RingHom.Smooth.ofLocalizationSpanTarget (algebraMap R S) s hs ?_
    intro r
    have h := (RingHom.smooth_algebraMap (R := R) (S := Localization.Away (r : S))).mpr (H r r.2)
    rw [IsScalarTower.algebraMap_eq R S (Localization.Away (r : S))] at h
    exact h

  have h1' : (1 : Λ) ∈ Submodule.span Λ (φ '' {a : A | Algebra.Smooth R (Localization.Away a)}) := h1
  obtain ⟨n, c, w, hw⟩ := Submodule.mem_span_set'.mp h1'
  have hw' : ∀ i, ∃ a : A, Algebra.Smooth R (Localization.Away a) ∧ φ a = (w i : Λ) :=
    fun i => (w i).2
  choose a ha hφa using hw'
  have hc : ∑ i, c i * φ (a i) = 1 := by
    rw [← hw]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [hφa, smul_eq_mul]

  obtain ⟨g, hg⟩ : ∃ g : MvPolynomial (Fin n) A,
      g = ∑ i, MvPolynomial.C (a i) * MvPolynomial.X i - 1 := ⟨_, rfl⟩
  obtain ⟨I, hI⟩ : ∃ I : Ideal (MvPolynomial (Fin n) A), I = Ideal.span {g} := ⟨_, rfl⟩
  have hqg : Ideal.Quotient.mk I g = 0 := by
    rw [Ideal.Quotient.eq_zero_iff_mem, hI]
    exact Ideal.mem_span_singleton_self g
  have hrel : ∑ k, Ideal.Quotient.mk I (MvPolynomial.C (a k)) * Ideal.Quotient.mk I (MvPolynomial.X k)
      = 1 := by
    rw [hg, map_sub, map_one, sub_eq_zero, map_sum] at hqg
    rw [← hqg]
    refine Finset.sum_congr rfl (fun k _ => ?_)
    rw [map_mul]
  have hRD : ∀ r : R, algebraMap R (MvPolynomial (Fin n) A ⧸ I) r =
      Ideal.Quotient.mk I (MvPolynomial.C (algebraMap R A r)) := fun r => by
    rw [IsScalarTower.algebraMap_apply R (MvPolynomial (Fin n) A) (MvPolynomial (Fin n) A ⧸ I),
      Ideal.Quotient.algebraMap_eq, MvPolynomial.algebraMap_apply]
  have hAD : ∀ x : A, algebraMap A (MvPolynomial (Fin n) A ⧸ I) x =
      Ideal.Quotient.mk I (MvPolynomial.C x) := fun x => by
    rw [IsScalarTower.algebraMap_apply A (MvPolynomial (Fin n) A) (MvPolynomial (Fin n) A ⧸ I),
      Ideal.Quotient.algebraMap_eq, MvPolynomial.algebraMap_eq]

  have heg : MvPolynomial.eval₂Hom (φ : A →+* Λ) c g = 0 := by
    rw [hg, map_sub, map_sum, map_one, sub_eq_zero, ← hc]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [map_mul, MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_X', mul_comm]
    rfl
  have hker : ∀ x ∈ I, MvPolynomial.eval₂Hom (φ : A →+* Λ) c x = 0 := by
    intro x hx
    rw [hI] at hx
    obtain ⟨y, rfl⟩ := Ideal.mem_span_singleton'.mp hx
    rw [map_mul, heg, mul_zero]
  obtain ⟨χ₀, hχ₀⟩ : ∃ χ₀ : (MvPolynomial (Fin n) A ⧸ I) →+* Λ, ∀ x,
      χ₀ (Ideal.Quotient.mk I x) = MvPolynomial.eval₂Hom (φ : A →+* Λ) c x :=
    ⟨Ideal.Quotient.lift I _ hker, fun x => Ideal.Quotient.lift_mk I _ hker⟩
  have hχ₀C : ∀ x, χ₀ (Ideal.Quotient.mk I (MvPolynomial.C x)) = φ x := fun x => by
    rw [hχ₀, MvPolynomial.eval₂Hom_C]
    rfl

  have hspan : Ideal.span (Set.range (fun j => Ideal.Quotient.mk I (MvPolynomial.C (a j)))) = ⊤ := by
    rw [Ideal.eq_top_iff_one, ← hrel]
    refine Ideal.sum_mem _ (fun j _ => ?_)
    rw [mul_comm]
    exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨j, rfl⟩)

  have hchart : ∀ j : Fin n, Nonempty (MvPolynomial {i : Fin n // i ≠ j} (Localization.Away (a j))
      ≃ₐ[R] Localization.Away (Ideal.Quotient.mk I (MvPolynomial.C (a j)))) := by
    intro j
    obtain ⟨u, hu⟩ : ∃ u : Localization.Away (a j),
        algebraMap A (Localization.Away (a j)) (a j) * u = 1 :=
      ⟨_, IsLocalization.Away.mul_invSelf (a j)⟩

    have hR : algebraMap (MvPolynomial (Fin n) A ⧸ I)
          (Localization.Away (Ideal.Quotient.mk I (MvPolynomial.C (a j))))
          (Ideal.Quotient.mk I (MvPolynomial.C (a j))) *
        algebraMap (MvPolynomial (Fin n) A ⧸ I)
          (Localization.Away (Ideal.Quotient.mk I (MvPolynomial.C (a j))))
          (Ideal.Quotient.mk I (MvPolynomial.X j)) =
        1 - ∑ i : {i : Fin n // i ≠ j}, algebraMap (MvPolynomial (Fin n) A ⧸ I)
          (Localization.Away (Ideal.Quotient.mk I (MvPolynomial.C (a j))))
          (Ideal.Quotient.mk I (MvPolynomial.C (a i))) *
        algebraMap (MvPolynomial (Fin n) A ⧸ I)
          (Localization.Away (Ideal.Quotient.mk I (MvPolynomial.C (a j))))
          (Ideal.Quotient.mk I (MvPolynomial.X i)) := by
      have h := congrArg (algebraMap (MvPolynomial (Fin n) A ⧸ I)
          (Localization.Away (Ideal.Quotient.mk I (MvPolynomial.C (a j))))) hrel
      rw [map_sum, map_one] at h
      simp only [map_mul] at h
      rw [Fintype.sum_eq_add_sum_subtype_ne _ j] at h
      rw [← h]
      ring

    have hunitL : IsUnit (((algebraMap (MvPolynomial (Fin n) A ⧸ I)
        (Localization.Away (Ideal.Quotient.mk I (MvPolynomial.C (a j))))).comp
        ((Ideal.Quotient.mk I).comp MvPolynomial.C)) (a j)) :=
      IsLocalization.Away.algebraMap_isUnit (Ideal.Quotient.mk I (MvPolynomial.C (a j)))
    obtain ⟨ℓ, hℓ⟩ : ∃ ℓ : Localization.Away (a j) →+*
        Localization.Away (Ideal.Quotient.mk I (MvPolynomial.C (a j))),
        ∀ x : A, ℓ (algebraMap A (Localization.Away (a j)) x) =
          algebraMap (MvPolynomial (Fin n) A ⧸ I)
            (Localization.Away (Ideal.Quotient.mk I (MvPolynomial.C (a j))))
            (Ideal.Quotient.mk I (MvPolynomial.C x)) :=
      ⟨IsLocalization.Away.lift (a j) hunitL, fun x => IsLocalization.Away.lift_eq (a j) hunitL x⟩
    obtain ⟨α, hαC, hαX⟩ : ∃ α : MvPolynomial {i : Fin n // i ≠ j} (Localization.Away (a j)) →+*
        Localization.Away (Ideal.Quotient.mk I (MvPolynomial.C (a j))),
        (∀ y, α (MvPolynomial.C y) = ℓ y) ∧
        ∀ i : {i : Fin n // i ≠ j}, α (MvPolynomial.X i) =
          algebraMap (MvPolynomial (Fin n) A ⧸ I)
            (Localization.Away (Ideal.Quotient.mk I (MvPolynomial.C (a j))))
            (Ideal.Quotient.mk I (MvPolynomial.X i.1)) :=
      ⟨MvPolynomial.eval₂Hom ℓ _, fun y => MvPolynomial.eval₂Hom_C _ _ _,
        fun i => MvPolynomial.eval₂Hom_X' _ _ _⟩

    obtain ⟨T, hT⟩ : ∃ T : MvPolynomial {i : Fin n // i ≠ j} (Localization.Away (a j)),
        T = ∑ i : {i : Fin n // i ≠ j},
          MvPolynomial.C (algebraMap A (Localization.Away (a j)) (a i)) * MvPolynomial.X i :=
      ⟨_, rfl⟩
    obtain ⟨v, hvj, hvne⟩ : ∃ v : Fin n → MvPolynomial {i : Fin n // i ≠ j} (Localization.Away (a j)),
        v j = MvPolynomial.C u * (1 - T) ∧ ∀ i : {i : Fin n // i ≠ j}, v i = MvPolynomial.X i :=
      ⟨fun k => if h : k = j then MvPolynomial.C u * (1 - T) else MvPolynomial.X ⟨k, h⟩,
        by simp, fun i => by simp [i.2]⟩
    obtain ⟨β₀, hβ₀C, hβ₀X⟩ : ∃ β₀ : MvPolynomial (Fin n) A →+*
        MvPolynomial {i : Fin n // i ≠ j} (Localization.Away (a j)),
        (∀ x, β₀ (MvPolynomial.C x) = MvPolynomial.C (algebraMap A (Localization.Away (a j)) x)) ∧
        ∀ k, β₀ (MvPolynomial.X k) = v k :=
      ⟨MvPolynomial.eval₂Hom (MvPolynomial.C.comp (algebraMap A (Localization.Away (a j)))) v,
        fun x => MvPolynomial.eval₂Hom_C _ _ _, fun k => MvPolynomial.eval₂Hom_X' _ _ _⟩
    have hβ₀g : β₀ g = 0 := by
      rw [hg, map_sub, map_sum, map_one, Fintype.sum_eq_add_sum_subtype_ne _ j]
      simp only [map_mul, hβ₀C, hβ₀X, hvne]
      rw [hvj, ← hT, ← mul_assoc, ← map_mul, hu, map_one, one_mul]
      ring
    have hβker : ∀ x ∈ I, β₀ x = 0 := by
      intro x hx
      rw [hI] at hx
      obtain ⟨y, rfl⟩ := Ideal.mem_span_singleton'.mp hx
      rw [map_mul, hβ₀g, mul_zero]
    obtain ⟨β₁, hβ₁⟩ : ∃ β₁ : (MvPolynomial (Fin n) A ⧸ I) →+*
        MvPolynomial {i : Fin n // i ≠ j} (Localization.Away (a j)),
        ∀ x, β₁ (Ideal.Quotient.mk I x) = β₀ x :=
      ⟨Ideal.Quotient.lift I β₀ hβker, fun x => Ideal.Quotient.lift_mk I β₀ hβker⟩
    have hunitP : IsUnit (β₁ (Ideal.Quotient.mk I (MvPolynomial.C (a j)))) := by
      refine isUnit_iff_exists_inv.mpr ⟨MvPolynomial.C u, ?_⟩
      rw [hβ₁, hβ₀C, ← map_mul, hu, map_one]
    obtain ⟨β, hβ⟩ : ∃ β : Localization.Away (Ideal.Quotient.mk I (MvPolynomial.C (a j))) →+*
        MvPolynomial {i : Fin n // i ≠ j} (Localization.Away (a j)),
        ∀ x, β (algebraMap (MvPolynomial (Fin n) A ⧸ I)
          (Localization.Away (Ideal.Quotient.mk I (MvPolynomial.C (a j)))) x) = β₁ x :=
      ⟨IsLocalization.Away.lift _ hunitP, fun x => IsLocalization.Away.lift_eq _ hunitP x⟩

    have hβα : β.comp α = RingHom.id _ := by
      apply MvPolynomial.ringHom_ext
      · intro y
        have hy : (β.comp α).comp MvPolynomial.C =
            (MvPolynomial.C : Localization.Away (a j) →+*
              MvPolynomial {i : Fin n // i ≠ j} (Localization.Away (a j))) := by
          apply IsLocalization.ringHom_ext (Submonoid.powers (a j))
          ext x
          simp only [RingHom.comp_apply]
          rw [hαC, hℓ, hβ, hβ₁, hβ₀C]
        exact DFunLike.congr_fun hy y
      · intro i
        simp only [RingHom.comp_apply, RingHom.id_apply]
        rw [hαX, hβ, hβ₁, hβ₀X, hvne]

    have hαβ : α.comp β = RingHom.id _ := by
      apply IsLocalization.ringHom_ext (Submonoid.powers (Ideal.Quotient.mk I (MvPolynomial.C (a j))))
      apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext
      · intro x
        simp only [RingHom.comp_apply, RingHom.id_apply]
        rw [hβ, hβ₁, hβ₀C, hαC, hℓ]
      · intro k
        simp only [RingHom.comp_apply, RingHom.id_apply]
        rw [hβ, hβ₁, hβ₀X]
        by_cases hk : k = j
        · subst hk
          rw [hvj, map_mul, hαC, map_sub, map_one, hT, map_sum]
          simp only [map_mul, hαC, hℓ, hαX]
          rw [← hR, ← hℓ (a k), ← mul_assoc, ← map_mul, mul_comm u, hu, map_one, one_mul]
        · have hv := hvne ⟨k, hk⟩
          simp only at hv
          rw [hv, hαX]
    refine ⟨AlgEquiv.ofRingEquiv (f := RingEquiv.ofRingHom α β hαβ hβα) ?_⟩
    intro r
    show α (algebraMap R (MvPolynomial {i : Fin n // i ≠ j} (Localization.Away (a j))) r) = _
    rw [MvPolynomial.algebraMap_apply, IsScalarTower.algebraMap_apply R A (Localization.Away (a j)),
      hαC, hℓ, IsScalarTower.algebraMap_apply R (MvPolynomial (Fin n) A ⧸ I)
        (Localization.Away (Ideal.Quotient.mk I (MvPolynomial.C (a j)))), hRD]

  have hsm : Algebra.Smooth R (MvPolynomial (Fin n) A ⧸ I) := by
    refine hloc _ _ hspan ?_
    rintro x ⟨j, rfl⟩
    have := ha j
    have : Algebra.Smooth R (MvPolynomial {i : Fin n // i ≠ j} (Localization.Away (a j))) :=
      Algebra.Smooth.comp R (Localization.Away (a j)) _
    exact Algebra.Smooth.of_equiv (hchart j).some
  refine ⟨MvPolynomial (Fin n) A ⧸ I, inferInstance, inferInstance, hsm,
    IsScalarTower.toAlgHom R A _, { toRingHom := χ₀, commutes' := fun r => ?_ }, ?_⟩
  · show χ₀ (algebraMap R (MvPolynomial (Fin n) A ⧸ I) r) = algebraMap R Λ r
    rw [hRD, hχ₀C, AlgHom.commutes]
  · apply AlgHom.ext
    intro x
    rw [AlgHom.comp_apply, IsScalarTower.toAlgHom_apply, hAD]
    exact hχ₀C x

theorem wc_pfc_noetherian_induction_unit : ∀ (R : Type u) [CommRing R] (Λ : Type u) [CommRing Λ] [IsNoetherianRing Λ] [Algebra R Λ], (∀ (A : Type u) [CommRing A] [Algebra R A] [Algebra.FinitePresentation R A] (φ : A →ₐ[R] Λ) (𝔮 : Ideal Λ), 𝔮 ∈ (Ideal.span (φ '' {a : A | Algebra.Smooth R (Localization.Away a)})).minimalPrimes → ∃ (B : Type u) (_ : CommRing B) (_ : Algebra R B) (_ : Algebra.FinitePresentation R B) (ψ : A →ₐ[R] B) (χ : B →ₐ[R] Λ), χ.comp ψ = φ ∧ (Ideal.span (φ '' {a : A | Algebra.Smooth R (Localization.Away a)})).radical ≤ (Ideal.span (χ '' {b : B | Algebra.Smooth R (Localization.Away b)})).radical ∧ ¬ (Ideal.span (χ '' {b : B | Algebra.Smooth R (Localization.Away b)})).radical ≤ 𝔮) → ∀ (A : Type u) [CommRing A] [Algebra R A] [Algebra.FinitePresentation R A] (φ : A →ₐ[R] Λ), ∃ (B : Type u) (_ : CommRing B) (_ : Algebra R B) (_ : Algebra.FinitePresentation R B) (ψ : A →ₐ[R] B) (χ : B →ₐ[R] Λ), χ.comp ψ = φ ∧ (1 : Λ) ∈ Ideal.span (χ '' {b : B | Algebra.Smooth R (Localization.Away b)}) :=
by
  intro R _ Λ _ _ _ H A _ _ _ φ
  classical
  let S : Set (Ideal Λ) := {I | ∃ (B : Type u) (_ : CommRing B) (_ : Algebra R B)
    (_ : Algebra.FinitePresentation R B) (ψ : A →ₐ[R] B) (χ : B →ₐ[R] Λ), χ.comp ψ = φ ∧
    I = (Ideal.span (χ '' {b : B | Algebra.Smooth R (Localization.Away b)})).radical}
  have hS : S.Nonempty :=
    ⟨_, A, inferInstance, inferInstance, inferInstance, AlgHom.id R A, φ, AlgHom.comp_id φ, rfl⟩
  obtain ⟨I₀, hI₀S, hmax⟩ :=
    (set_has_maximal_iff_noetherian (R := Λ) (M := Λ)).mpr inferInstance S hS
  obtain ⟨B, iB, aB, fB, ψ, χ, hψχ, hI₀⟩ := hI₀S
  refine ⟨B, iB, aB, fB, ψ, χ, hψχ, ?_⟩
  have htop : (Ideal.span (χ '' {b : B | Algebra.Smooth R (Localization.Away b)})).radical = ⊤ := by
    by_contra hne
    have hJne : Ideal.span (χ '' {b : B | Algebra.Smooth R (Localization.Away b)}) ≠ ⊤ :=
      fun h => hne (by rw [h, Ideal.radical_top])
    obtain ⟨⟨𝔮, h𝔮⟩⟩ := Ideal.nonempty_minimalPrimes hJne
    have hp : 𝔮.IsPrime := h𝔮.1.1
    have hJq : Ideal.span (χ '' {b : B | Algebra.Smooth R (Localization.Away b)}) ≤ 𝔮 := h𝔮.1.2
    have hrq : (Ideal.span (χ '' {b : B | Algebra.Smooth R (Localization.Away b)})).radical ≤ 𝔮 :=
      hp.radical_le_iff.mpr hJq
    obtain ⟨C, iC, aC, fC, ψ', χ', hχ', hle, hnot⟩ := H B χ 𝔮 h𝔮
    have hmem : (Ideal.span (χ' '' {c : C | Algebra.Smooth R (Localization.Away c)})).radical
        ∈ S :=
      ⟨C, iC, aC, fC, ψ'.comp ψ, χ', by rw [← AlgHom.comp_assoc, hχ', hψχ], rfl⟩
    have h1 := hmax _ hmem
    rw [hI₀] at h1
    apply hnot
    have h3 : (Ideal.span (χ' '' {c : C | Algebra.Smooth R (Localization.Away c)})).radical ≤
        (Ideal.span (χ '' {b : B | Algebra.Smooth R (Localization.Away b)})).radical := by
      by_contra h2
      exact h1 (lt_of_le_of_ne hle (fun h => h2 (le_of_eq h.symm)))
    exact h3.trans hrq
  rw [Ideal.radical_eq_top] at htop
  rw [htop]
  exact Submodule.mem_top

theorem wc_pfc_cz_localization_regular : ∀ (k : Type u) [Field k] (Λ : Type u) [CommRing Λ] [Algebra k Λ], (∀ (L : Type u) [Field L] [Algebra k L] [FiniteDimensional k L] (𝔔 : Ideal (TensorProduct k L Λ)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) → ∀ (𝔮 : Ideal Λ) [𝔮.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔮) :=
by
  intro k _ Λ _ _ hreg 𝔮 _
  let e : TensorProduct k k Λ ≃+* Λ := (Algebra.TensorProduct.lid k Λ).toRingEquiv
  haveI h𝔔 : (Ideal.comap e 𝔮).IsPrime := Ideal.comap_isPrime e 𝔮
  haveI hR : IsRegularLocalRing (Localization.AtPrime (Ideal.comap e 𝔮)) :=
    hreg k (Ideal.comap e 𝔮)
  have hM : Submonoid.map e.toMonoidHom (Ideal.comap e 𝔮).primeCompl = 𝔮.primeCompl := by
    ext y
    constructor
    · rintro ⟨x, hx, rfl⟩
      exact hx
    · intro hy
      refine ⟨e.symm y, ?_, ?_⟩
      · change e.symm y ∉ Ideal.comap e 𝔮
        rw [Ideal.mem_comap, RingEquiv.apply_symm_apply]
        exact hy
      · exact RingEquiv.apply_symm_apply e y
  let φ : Localization.AtPrime (Ideal.comap e 𝔮) ≃+* Localization.AtPrime 𝔮 :=
    IsLocalization.ringEquivOfRingEquiv (Localization.AtPrime (Ideal.comap e 𝔮))
      (Localization.AtPrime 𝔮) e hM
  exact IsRegularLocalRing.of_ringEquiv (R := Localization.AtPrime (Ideal.comap e 𝔮)) φ

theorem wc_pfc_cz_smooth_locus_fg : ∀ (k : Type u) [Field k] (A : Type u) [CommRing A] [Algebra k A] (Λ : Type u) [CommRing Λ] [IsNoetherianRing Λ] [Algebra k Λ] (φ : A →ₐ[k] Λ), ∃ (r : ℕ) (a : Fin r → A), (∀ j, Algebra.Smooth k (Localization.Away (a j))) ∧ Ideal.span (φ '' {a : A | Algebra.Smooth k (Localization.Away a)}) = Ideal.span (Set.range fun j => φ (a j)) :=
by
  classical
  intro k _ A _ _ Λ _ _ _ φ
  set S : Set A := {a : A | Algebra.Smooth k (Localization.Away a)} with hSdef
  have hfg : (Submodule.span Λ (φ '' S)).FG := Ideal.fg_of_isNoetherianRing _
  obtain ⟨t, ht, hspan⟩ := (Submodule.fg_span_iff_fg_span_finset_subset (φ '' S)).mp hfg
  obtain ⟨u, huS, hut⟩ := (Finset.subset_set_image_iff (f := (φ : A → Λ))).mp ht
  have hmem : ∀ j : Fin u.card, ((u.equivFin.symm j : A)) ∈ S := fun j =>
    huS (Finset.mem_coe.mpr (u.equivFin.symm j).2)
  refine ⟨u.card, fun j => (u.equivFin.symm j : A), fun j => hmem j, ?_⟩
  apply le_antisymm
  · change Submodule.span Λ (φ '' S) ≤ _
    rw [hspan]
    apply Ideal.span_mono
    intro y hy
    rw [← hut, Finset.coe_image] at hy
    obtain ⟨x, hx, rfl⟩ := hy
    refine ⟨u.equivFin ⟨x, Finset.mem_coe.mp hx⟩, ?_⟩
    simp only [Equiv.symm_apply_apply]
  · rw [Ideal.span_le]
    rintro _ ⟨j, rfl⟩
    exact Ideal.subset_span ⟨_, hmem j, rfl⟩

theorem wc_pfc_cz_minimal_prime_power : ∀ (Λ : Type u) [CommRing Λ] [IsNoetherianRing Λ] (I 𝔮 : Ideal Λ) [𝔮.IsPrime], 𝔮 ∈ I.minimalPrimes → ∃ n : ℕ, Ideal.map (algebraMap Λ (Localization.AtPrime 𝔮)) (𝔮 ^ n) ≤ Ideal.map (algebraMap Λ (Localization.AtPrime 𝔮)) I :=
by
  intro Λ _ _ I 𝔮 _ h𝔮
  have hcomap : Ideal.comap (algebraMap Λ (Localization.AtPrime 𝔮))
      (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮)) = 𝔮 := by
    rw [← Ideal.under_def]
    exact Localization.AtPrime.under_maximalIdeal ..
  have hkey : ∀ P : Ideal (Localization.AtPrime 𝔮), P.IsPrime →
      Ideal.map (algebraMap Λ (Localization.AtPrime 𝔮)) I ≤ P →
      Ideal.map (algebraMap Λ (Localization.AtPrime 𝔮)) 𝔮 ≤ P := by
    intro P hP hJP
    have hPm : P ≤ IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) :=
      IsLocalRing.le_maximalIdeal hP.ne_top
    have hQ : (Ideal.comap (algebraMap Λ (Localization.AtPrime 𝔮)) P).IsPrime :=
      Ideal.comap_isPrime _ P
    have hIQ : I ≤ Ideal.comap (algebraMap Λ (Localization.AtPrime 𝔮)) P :=
      Ideal.map_le_iff_le_comap.mp hJP
    have hQq : Ideal.comap (algebraMap Λ (Localization.AtPrime 𝔮)) P ≤ 𝔮 := by
      have := Ideal.comap_mono (f := algebraMap Λ (Localization.AtPrime 𝔮)) hPm
      rwa [hcomap] at this
    have h𝔮' : 𝔮 ≤ Ideal.comap (algebraMap Λ (Localization.AtPrime 𝔮)) P :=
      Minimal.le_of_le (show Minimal (fun q : Ideal Λ => q.IsPrime ∧ I ≤ q) 𝔮 from h𝔮)
        ⟨hQ, hIQ⟩ hQq
    exact Ideal.map_le_iff_le_comap.mpr h𝔮'
  have hrad : Ideal.map (algebraMap Λ (Localization.AtPrime 𝔮)) 𝔮 ≤
      (Ideal.map (algebraMap Λ (Localization.AtPrime 𝔮)) I).radical := by
    rw [Ideal.radical_eq_sInf]
    refine le_sInf ?_
    rintro P ⟨hJP, hP⟩
    exact hkey P hP hJP
  obtain ⟨n, hn⟩ := Ideal.exists_pow_le_of_le_radical_of_fg hrad
    ((Ideal.fg_of_isNoetherianRing 𝔮).map (algebraMap Λ (Localization.AtPrime 𝔮)))
  exact ⟨n, by rw [Ideal.map_pow]; exact hn⟩

theorem wc_ogp_regseq_pow : ∀ (R : Type u) [CommRing R] (d : ℕ) (x : Fin d → R), (∀ (T : Set (Fin d)) (t : Fin d), t ∉ T → ∀ y : R, x t * y ∈ Ideal.span (x '' T) → y ∈ Ideal.span (x '' T)) → ∀ (e : ℕ) (t : Fin d) (y : R), x t * y ∈ Ideal.span ((fun j => x j ^ e) '' {j | j < t}) → y ∈ Ideal.span ((fun j => x j ^ e) '' {j | j < t}) :=
by
  intro R _ d x hx e t y hy

  have hcomb : ∀ (L : Ideal R) (u w z : R), (∀ c : R, u * c ∈ L → c ∈ L) →
      (∀ c : R, z * c ∈ Ideal.span {u} ⊔ L → c ∈ Ideal.span {u} ⊔ L) →
      (∀ c : R, z * c ∈ Ideal.span {w} ⊔ L → c ∈ Ideal.span {w} ⊔ L) →
      ∀ c : R, z * c ∈ Ideal.span {u * w} ⊔ L → c ∈ Ideal.span {u * w} ⊔ L := by
    intro L u w z h1 h2 h3 c hc
    have hle : Ideal.span {u * w} ⊔ L ≤ Ideal.span {u} ⊔ L :=
      sup_le_sup_right (Ideal.span_singleton_le_span_singleton.mpr (dvd_mul_right u w)) L
    obtain ⟨a, l, hl, hal⟩ := Ideal.mem_span_singleton_sup.mp (h2 c (hle hc))
    obtain ⟨b, l', hl', hbl⟩ := Ideal.mem_span_singleton_sup.mp hc
    have hb : z * a - b * w ∈ L := by
      apply h1
      have e1 : u * (z * a - b * w) = l' - z * l := by linear_combination z * hal - hbl
      rw [e1]
      exact sub_mem hl' (Ideal.mul_mem_left L z hl)
    have hza : z * a ∈ Ideal.span {w} ⊔ L :=
      Ideal.mem_span_singleton_sup.mpr ⟨b, z * a - b * w, hb, by ring⟩
    obtain ⟨a', l'', hl'', hal'⟩ := Ideal.mem_span_singleton_sup.mp (h3 a hza)
    exact Ideal.mem_span_singleton_sup.mpr ⟨a', u * l'' + l,
      add_mem (Ideal.mul_mem_left L u hl'') hl, by linear_combination u * hal' + hal⟩

  have hupd : ∀ (y : Fin d → R), (∀ (T : Set (Fin d)) (t : Fin d), t ∉ T → ∀ c : R,
      y t * c ∈ Ideal.span (y '' T) → c ∈ Ideal.span (y '' T)) →
      ∀ (i : Fin d) (k : ℕ) (T : Set (Fin d)) (t : Fin d), t ∉ T → ∀ c : R,
      Function.update y i (y i ^ k) t * c ∈ Ideal.span (Function.update y i (y i ^ k) '' T) →
      c ∈ Ideal.span (Function.update y i (y i ^ k) '' T) := by
    intro y hP i k T t ht
    by_cases hiT : i ∈ T
    · have hti : t ≠ i := fun h => ht (h ▸ hiT)
      rw [Function.update_of_ne hti]
      have hspan : ∀ v : R, Ideal.span (Function.update y i v '' T) =
          Ideal.span {v} ⊔ Ideal.span (y '' (T \ {i})) := by
        intro v
        have himg : Function.update y i v '' T = insert v (y '' (T \ {i})) := by
          ext z
          simp only [Set.mem_image, Set.mem_insert_iff, Set.mem_diff, Set.mem_singleton_iff]
          constructor
          · rintro ⟨j, hj, rfl⟩
            by_cases hji : j = i
            · left; rw [hji, Function.update_self]
            · right; exact ⟨j, ⟨hj, hji⟩, (Function.update_of_ne hji _ _).symm⟩
          · rintro (rfl | ⟨j, ⟨hj, hji⟩, rfl⟩)
            · exact ⟨i, hiT, Function.update_self _ _ _⟩
            · exact ⟨j, hj, Function.update_of_ne hji _ _⟩
        rw [himg, Ideal.span_insert]
      have hold : Ideal.span (y '' T) = Ideal.span {y i} ⊔ Ideal.span (y '' (T \ {i})) := by
        have h := hspan (y i)
        rwa [Function.update_eq_self] at h
      have h1 : ∀ c : R, y i * c ∈ Ideal.span (y '' (T \ {i})) → c ∈ Ideal.span (y '' (T \ {i})) :=
        hP (T \ {i}) i (fun h => h.2 rfl)
      have h2 : ∀ c : R, y t * c ∈ Ideal.span {y i} ⊔ Ideal.span (y '' (T \ {i})) →
          c ∈ Ideal.span {y i} ⊔ Ideal.span (y '' (T \ {i})) := by
        rw [← hold]; exact hP T t ht
      have key : ∀ k : ℕ, ∀ c : R, y t * c ∈ Ideal.span {y i ^ k} ⊔ Ideal.span (y '' (T \ {i})) →
          c ∈ Ideal.span {y i ^ k} ⊔ Ideal.span (y '' (T \ {i})) := by
        intro k
        induction k with
        | zero =>
          intro c _
          rw [pow_zero, Ideal.span_singleton_one, top_sup_eq]
          exact Submodule.mem_top
        | succ k ih =>
          rw [pow_succ']
          exact hcomb _ (y i) (y i ^ k) (y t) h1 h2 ih
      rw [hspan]
      exact key k
    · have himg : Function.update y i (y i ^ k) '' T = y '' T :=
        Set.image_congr (fun j hj => Function.update_of_ne
          (fun h : j = i => hiT (by rw [← h]; exact hj)) _ _)
      rw [himg]
      by_cases hti : t = i
      · rw [hti, Function.update_self]
        have key : ∀ k : ℕ, ∀ c : R, y i ^ k * c ∈ Ideal.span (y '' T) →
            c ∈ Ideal.span (y '' T) := by
          intro k
          induction k with
          | zero => intro c hc; simpa using hc
          | succ k ih =>
            intro c hc
            apply ih
            apply hP T i hiT
            rw [← mul_assoc, ← pow_succ']
            exact hc
        exact key k
      · rw [Function.update_of_ne hti]
        exact hP T t ht

  have hfin : ∀ (S : Finset (Fin d)) (T : Set (Fin d)) (t : Fin d), t ∉ T → ∀ c : R,
      (fun j => if j ∈ S then x j ^ e else x j) t * c ∈
        Ideal.span ((fun j => if j ∈ S then x j ^ e else x j) '' T) →
      c ∈ Ideal.span ((fun j => if j ∈ S then x j ^ e else x j) '' T) := by
    intro S
    induction S using Finset.induction_on with
    | empty => simpa using hx
    | insert a S haS ih =>
      have hf : (fun j => if j ∈ insert a S then x j ^ e else x j) =
          Function.update (fun j => if j ∈ S then x j ^ e else x j) a
            ((fun j => if j ∈ S then x j ^ e else x j) a ^ e) := by
        funext j
        by_cases hja : j = a
        · subst hja; simp [haS]
        · simp [hja]
      rw [hf]
      exact hupd _ ih a e

  have h := hfin (Finset.univ.filter (fun j => j < t)) {j | j < t} t (lt_irrefl t) y
  have h1 : (fun j => if j ∈ Finset.univ.filter (fun j => j < t) then x j ^ e else x j) t = x t := by
    simp
  have h2 : (fun j => if j ∈ Finset.univ.filter (fun j => j < t) then x j ^ e else x j) ''
      {j | j < t} = (fun j => x j ^ e) '' {j | j < t} :=
    Set.image_congr (fun j hj => by simp [show j < t from hj])
  rw [h1, h2] at h
  exact h hy

theorem wc_ogp_quotient_regular : ∀ (R : Type u) [CommRing R] [IsRegularLocalRing R] (A B : Finset R), Ideal.span ((A : Set R) ∪ (B : Set R)) = IsLocalRing.maximalIdeal R → A.card + B.card ≤ Submodule.spanFinrank (IsLocalRing.maximalIdeal R) → ∃ _ : IsRegularLocalRing (R ⧸ Ideal.span (A : Set R)), Submodule.spanFinrank (IsLocalRing.maximalIdeal (R ⧸ Ideal.span (A : Set R))) ≤ B.card ∧ ∀ z ∈ B, z ∉ Ideal.span (A : Set R) :=
by
  intro R _ _ A B hgen hcard
  classical

  have hnot : ∀ z ∈ B, z ∉ Ideal.span (A : Set R) := by
    intro z hz hzA
    have hSfin : ((A : Set R) ∪ ((B.erase z : Finset R) : Set R)).Finite :=
      (Finset.finite_toSet A).union (Finset.finite_toSet _)
    have hspan : Ideal.span ((A : Set R) ∪ ((B.erase z : Finset R) : Set R)) =
        IsLocalRing.maximalIdeal R := by
      rw [← hgen]
      apply le_antisymm
      · apply Ideal.span_mono
        apply Set.union_subset_union_right
        exact Finset.coe_subset.mpr (Finset.erase_subset z B)
      · rw [Ideal.span_le]
        rintro w (hw | hw)
        · exact Ideal.subset_span (Or.inl hw)
        · by_cases hwz : w = z
          · subst hwz
            exact Ideal.span_mono Set.subset_union_left hzA
          · exact Ideal.subset_span
              (Or.inr (Finset.mem_coe.mpr (Finset.mem_erase.mpr ⟨hwz, hw⟩)))
    have h1 : Submodule.spanFinrank (IsLocalRing.maximalIdeal R) ≤
        ((A : Set R) ∪ ((B.erase z : Finset R) : Set R)).ncard := by
      rw [← hspan]
      exact Submodule.spanFinrank_span_le_ncard_of_finite hSfin
    have h2 : ((A : Set R) ∪ ((B.erase z : Finset R) : Set R)).ncard ≤
        A.card + (B.erase z).card := by
      calc ((A : Set R) ∪ ((B.erase z : Finset R) : Set R)).ncard
          ≤ (A : Set R).ncard + ((B.erase z : Finset R) : Set R).ncard := Set.ncard_union_le _ _
        _ = A.card + (B.erase z).card := by rw [Set.ncard_coe_finset, Set.ncard_coe_finset]
    have h3 : (B.erase z).card = B.card - 1 := Finset.card_erase_of_mem hz
    have h4 : 0 < B.card := Finset.card_pos.mpr ⟨z, hz⟩
    omega

  have haM : Ideal.span (A : Set R) ≤ IsLocalRing.maximalIdeal R := by
    rw [← hgen]; exact Ideal.span_mono Set.subset_union_left
  have hne : Ideal.span (A : Set R) ≠ ⊤ := fun h =>
    (IsLocalRing.maximalIdeal.isMaximal R).ne_top (top_le_iff.mp (h ▸ haM))
  haveI : Nontrivial (R ⧸ Ideal.span (A : Set R)) := Ideal.Quotient.nontrivial_iff.mpr hne
  haveI hloc : IsLocalRing (R ⧸ Ideal.span (A : Set R)) :=
    IsLocalRing.of_surjective' (Ideal.Quotient.mk _) Ideal.Quotient.mk_surjective

  have hemb : Submodule.spanFinrank (IsLocalRing.maximalIdeal (R ⧸ Ideal.span (A : Set R))) ≤
      B.card := by
    have hm : IsLocalRing.maximalIdeal (R ⧸ Ideal.span (A : Set R)) =
        Ideal.span ((Ideal.Quotient.mk (Ideal.span (A : Set R))) '' (B : Set R)) := by
      rw [← IsLocalRing.map_maximalIdeal_of_surjective (Ideal.Quotient.mk _)
        Ideal.Quotient.mk_surjective, ← hgen, Ideal.map_span, Set.image_union]
      apply le_antisymm
      · rw [Ideal.span_le]
        rintro _ (⟨a, ha, rfl⟩ | ⟨b, hb, rfl⟩)
        · rw [Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ha)]
          exact Submodule.zero_mem _
        · exact Ideal.subset_span ⟨b, hb, rfl⟩
      · exact Ideal.span_mono Set.subset_union_right
    rw [hm]
    calc _ ≤ ((Ideal.Quotient.mk (Ideal.span (A : Set R))) '' (B : Set R)).ncard :=
          Submodule.spanFinrank_span_le_ncard_of_finite ((Finset.finite_toSet B).image _)
      _ ≤ (B : Set R).ncard := Set.ncard_image_le (Finset.finite_toSet B)
      _ = B.card := Set.ncard_coe_finset B

  have hdim : ((B.card : ℕ) : WithBot ℕ∞) ≤ ringKrullDim (R ⧸ Ideal.span (A : Set R)) := by
    have hjac : Ideal.span (A : Set R) ≤ Ring.jacobson R := by
      refine haM.trans ?_
      rw [← Ideal.jacobson_bot]
      exact IsLocalRing.maximalIdeal_le_jacobson ⊥
    have hK := ringKrullDim_le_ringKrullDim_quotient_add_spanFinrank
      (Ideal.span (A : Set R)) hjac
    have hsa : Submodule.spanFinrank (Ideal.span (A : Set R)) ≤ A.card := by
      have := Submodule.spanFinrank_span_le_ncard_of_finite (R := R) (Finset.finite_toSet A)
      rw [Set.ncard_coe_finset] at this
      exact this
    have hR := IsRegularLocalRing.spanFinrank_maximalIdeal (R := R)
    rw [← hR] at hK
    have hnn := ringKrullDim_nonneg_of_nontrivial (R := R ⧸ Ideal.span (A : Set R))
    generalize ringKrullDim (R ⧸ Ideal.span (A : Set R)) = D at hK hnn ⊢
    cases D with
    | bot => exact absurd hnn (by simp)
    | coe e =>
      have hK' : ((Submodule.spanFinrank (IsLocalRing.maximalIdeal R) : ℕ) : ℕ∞) ≤
          e + ((Submodule.spanFinrank (Ideal.span (A : Set R)) : ℕ) : ℕ∞) := by
        exact_mod_cast hK
      suffices h : ((B.card : ℕ) : ℕ∞) ≤ e by exact_mod_cast h
      cases e using ENat.recTopCoe with
      | top => exact le_top
      | coe m =>
        have h5 : Submodule.spanFinrank (IsLocalRing.maximalIdeal R) ≤
            m + Submodule.spanFinrank (Ideal.span (A : Set R)) := by exact_mod_cast hK'
        exact_mod_cast (by omega : B.card ≤ m)
  have hreg : IsRegularLocalRing (R ⧸ Ideal.span (A : Set R)) :=
    IsRegularLocalRing.of_spanFinrank_maximalIdeal_le _
      ((by exact_mod_cast hemb : ((Submodule.spanFinrank
        (IsLocalRing.maximalIdeal (R ⧸ Ideal.span (A : Set R))) : ℕ) : WithBot ℕ∞) ≤
          ((B.card : ℕ) : WithBot ℕ∞)).trans hdim)
  exact ⟨hreg, hemb, hnot⟩

theorem wcpa_regular_isDomain : ∀ (R : Type u) [CommRing R], (∀ (T : Type u) [CommRing T] [IsRegularLocalRing T] (r : ℕ) (x : Fin r → IsLocalRing.maximalIdeal T), LinearIndependent (IsLocalRing.ResidueField T) (fun i => (IsLocalRing.maximalIdeal T).toCotangent (x i)) → IsRegularLocalRing (T ⧸ Ideal.span (Set.range (fun i => (x i : T)))) ∧ ringKrullDim (T ⧸ Ideal.span (Set.range (fun i => (x i : T)))) + r = ringKrullDim T) → IsRegularLocalRing R → IsDomain R :=
by
  intro R _ H hR
  have s2 : ∀ (T : Type u) [CommRing T] [IsLocalRing T] [IsNoetherianRing T],
      ∀ x ∈ IsLocalRing.maximalIdeal T, (∀ p ∈ minimalPrimes T, x ∉ p) →
        (Ideal.span {x}).IsPrime → IsDomain T := by
    intro T _ _ _ x hx havoid hprime
    obtain ⟨q, hq, hqle⟩ :=
      Ideal.exists_minimalPrimes_le (I := (⊥ : Ideal T)) (J := Ideal.span {x}) bot_le
    have hqm : q ∈ minimalPrimes T := hq
    have hqprime : q.IsPrime := hq.1.1
    have hxq : x ∉ q := havoid q hqm
    have hle : q ≤ ⊥ ⊔ IsLocalRing.maximalIdeal T • q := by
      intro y hy
      obtain ⟨a, rfl⟩ := Ideal.mem_span_singleton'.mp (hqle hy)
      have ha : a ∈ q := (hqprime.mem_or_mem hy).resolve_right hxq
      apply Submodule.mem_sup_right
      rw [mul_comm]
      exact Submodule.smul_mem_smul hx ha
    have hq0 : q ≤ ⊥ := Submodule.le_of_le_smul_of_le_jacobson_bot
      (IsNoetherian.noetherian q) (IsLocalRing.maximalIdeal_le_jacobson ⊥) hle
    have hqbot : q = ⊥ := le_bot_iff.mp hq0
    subst hqbot
    exact @IsDomain.of_bot_isPrime T _ hqprime
  have s1 : ∀ (T : Type u) [CommRing T] [IsRegularLocalRing T],
      Submodule.spanFinrank (IsLocalRing.maximalIdeal T) ≠ 0 →
      ∃ x ∈ IsLocalRing.maximalIdeal T, x ∉ IsLocalRing.maximalIdeal T ^ 2 ∧
        ∀ p ∈ minimalPrimes T, x ∉ p := by
    intro T _ _ hn
    have ha : ¬ IsLocalRing.maximalIdeal T ≤ IsLocalRing.maximalIdeal T ^ 2 := by
      intro h
      apply hn
      have h' : IsLocalRing.maximalIdeal T ≤
          ⊥ ⊔ IsLocalRing.maximalIdeal T • IsLocalRing.maximalIdeal T := by
        rw [bot_sup_eq, Ideal.smul_eq_mul, ← pow_two]; exact h
      have h0 : IsLocalRing.maximalIdeal T ≤ ⊥ := Submodule.le_of_le_smul_of_le_jacobson_bot
        (IsNoetherian.noetherian _) (IsLocalRing.maximalIdeal_le_jacobson ⊥) h'
      rw [le_bot_iff.mp h0, Submodule.spanFinrank_bot]
    have hb : IsLocalRing.maximalIdeal T ∉ minimalPrimes T := by
      intro h
      apply hn
      have h0 : (IsLocalRing.maximalIdeal T).height = 0 := (Ideal.height_eq_zero_iff).mpr h
      have h1 := IsLocalRing.maximalIdeal_height_eq_ringKrullDim (R := T)
      have h2 := IsRegularLocalRing.spanFinrank_maximalIdeal (R := T)
      rw [← h1, h0] at h2
      exact_mod_cast h2
    by_contra hcon
    push_neg at hcon
    have hfin : (insert (IsLocalRing.maximalIdeal T ^ 2) (minimalPrimes T)).Finite :=
      (minimalPrimes.finite_of_isNoetherianRing T).insert _
    have hpr : ∀ i ∈ insert (IsLocalRing.maximalIdeal T ^ 2) (minimalPrimes T),
        i ≠ IsLocalRing.maximalIdeal T ^ 2 → i ≠ IsLocalRing.maximalIdeal T ^ 2 →
          (id i).IsPrime := by
      intro i hi hia _
      exact ((Set.mem_insert_iff.mp hi).resolve_left hia).1.1
    have hsub : ((IsLocalRing.maximalIdeal T : Ideal T) : Set T) ⊆
        ⋃ i ∈ insert (IsLocalRing.maximalIdeal T ^ 2) (minimalPrimes T),
          ((id i : Ideal T) : Set T) := by
      intro x hx
      rw [Set.mem_iUnion₂]
      by_cases hx2 : x ∈ IsLocalRing.maximalIdeal T ^ 2
      · exact ⟨_, Set.mem_insert _ _, hx2⟩
      · obtain ⟨p, hp, hxp⟩ := hcon x hx hx2
        exact ⟨p, Set.mem_insert_of_mem _ hp, hxp⟩
    obtain ⟨i, hi, hmi⟩ := (Ideal.subset_union_prime_finite hfin (f := id) _ _ hpr).mp hsub
    rcases Set.mem_insert_iff.mp hi with h | h
    · exact ha (h ▸ hmi)
    · have hip : i.IsPrime := h.1.1
      have he := (IsLocalRing.maximalIdeal.isMaximal T).eq_of_le hip.ne_top hmi
      exact hb (he ▸ h)
  have key : ∀ n : ℕ, ∀ (T : Type u) [CommRing T] [IsRegularLocalRing T],
      Submodule.spanFinrank (IsLocalRing.maximalIdeal T) = n → IsDomain T := by
    intro n
    induction n using Nat.strong_induction_on with
    | _ n ih =>
    intro T _ _ hTn
    by_cases hn : n = 0
    · subst hn
      have hbot : IsLocalRing.maximalIdeal T = ⊥ :=
        (Submodule.spanFinrank_eq_zero_iff_eq_bot (IsNoetherian.noetherian _)).mp hTn
      exact (IsLocalRing.isField_iff_maximalIdeal_eq.mpr hbot).isDomain
    · obtain ⟨x, hx, hx2, havoid⟩ := s1 T (hTn ▸ hn)
      let v : Fin 1 → IsLocalRing.maximalIdeal T := fun _ => ⟨x, hx⟩
      have hli : LinearIndependent (IsLocalRing.ResidueField T)
          (fun i => (IsLocalRing.maximalIdeal T).toCotangent (v i)) := by
        rw [Fintype.linearIndependent_iff]
        intro g hg i
        rw [Fin.sum_univ_one] at hg
        have hne : (IsLocalRing.maximalIdeal T).toCotangent ⟨x, hx⟩ ≠ 0 := fun h0 =>
          hx2 ((Ideal.toCotangent_eq_zero _ _).mp h0)
        have hg0 : g 0 = 0 := by
          by_contra hgne
          apply hne
          rw [← one_smul (IsLocalRing.ResidueField T)
            ((IsLocalRing.maximalIdeal T).toCotangent ⟨x, hx⟩), ← inv_mul_cancel₀ hgne, mul_smul]
          exact (congrArg (fun w => (g 0)⁻¹ • w) hg).trans (smul_zero _)
        rw [Subsingleton.elim i 0]
        exact hg0
      obtain ⟨hreg', hdim'⟩ := H T 1 v hli
      have heq : Ideal.span (Set.range (fun i => (v i : T))) = Ideal.span {x} := by
        congr 1
        exact Set.range_const
      let e := Ideal.quotEquivOfEq heq
      haveI hreg : IsRegularLocalRing (T ⧸ Ideal.span {x}) := IsRegularLocalRing.of_ringEquiv e
      have hdim : ringKrullDim (T ⧸ Ideal.span {x}) + 1 = ringKrullDim T := by
        rw [← ringKrullDim_eq_of_ringEquiv e]; exact_mod_cast hdim'
      have hemb : Submodule.spanFinrank (IsLocalRing.maximalIdeal (T ⧸ Ideal.span {x})) + 1 = n := by
        have a1 := IsRegularLocalRing.spanFinrank_maximalIdeal (R := T ⧸ Ideal.span {x})
        have a2 := IsRegularLocalRing.spanFinrank_maximalIdeal (R := T)
        rw [← a1, ← a2, hTn] at hdim
        exact_mod_cast hdim
      haveI := ih _ (by omega) (T ⧸ Ideal.span {x}) rfl
      have hprime : (Ideal.span {x}).IsPrime :=
        (Ideal.Quotient.isDomain_iff_prime _).mp inferInstance
      exact s2 T x hx havoid hprime
  exact key _ R rfl

theorem wcpa_rs_quotient_regular : ∀ (R : Type u) [CommRing R] [IsRegularLocalRing R] (r : ℕ) (x : Fin r → IsLocalRing.maximalIdeal R), LinearIndependent (IsLocalRing.ResidueField R) (fun i => (IsLocalRing.maximalIdeal R).toCotangent (x i)) → IsRegularLocalRing (R ⧸ Ideal.span (Set.range (fun i => (x i : R)))) ∧ ringKrullDim (R ⧸ Ideal.span (Set.range (fun i => (x i : R)))) + r = ringKrullDim R :=
by
  intro R _ _ r x hli
  classical
  set J := Ideal.span (Set.range (fun i => (x i : R))) with hJ
  set d := Module.finrank (IsLocalRing.ResidueField R) (IsLocalRing.CotangentSpace R) with hd
  have hdR : ((d : ℕ) : WithBot ℕ∞) = ringKrullDim R := by
    rw [hd, ← IsLocalRing.spanFinrank_maximalIdeal_eq_finrank_cotangentSpace]
    exact IsRegularLocalRing.spanFinrank_maximalIdeal

  have hrd : r ≤ d := by
    have := hli.fintype_card_le_finrank
    simpa using this
  obtain ⟨C, hC⟩ := Submodule.exists_isCompl (Submodule.span (IsLocalRing.ResidueField R)
    (Set.range (fun i => (IsLocalRing.maximalIdeal R).toCotangent (x i))))
  have hWr : Module.finrank (IsLocalRing.ResidueField R) (Submodule.span
      (IsLocalRing.ResidueField R)
      (Set.range (fun i => (IsLocalRing.maximalIdeal R).toCotangent (x i)))) = r := by
    rw [finrank_span_eq_card hli]; simp
  have hCd : Module.finrank (IsLocalRing.ResidueField R) C = d - r := by
    have h := Submodule.finrank_add_eq_of_isCompl hC
    rw [hWr] at h
    have hd' : Module.finrank (IsLocalRing.ResidueField R)
        (IsLocalRing.maximalIdeal R).Cotangent = d := rfl
    omega
  let b := Module.finBasisOfFinrankEq (IsLocalRing.ResidueField R) C hCd
  obtain ⟨y, hy⟩ : ∃ y : Fin (d - r) → IsLocalRing.maximalIdeal R,
      ∀ j, (IsLocalRing.maximalIdeal R).toCotangent (y j) = (b j : _) := by
    choose y hy using fun j => (IsLocalRing.maximalIdeal R).toCotangent_surjective (b j : _)
    exact ⟨y, hy⟩

  have hspan : Submodule.span (IsLocalRing.ResidueField R)
      ((IsLocalRing.maximalIdeal R).toCotangent '' (Set.range x ∪ Set.range y)) = ⊤ := by
    rw [Set.image_union, ← Set.range_comp, ← Set.range_comp, Submodule.span_union]
    have h2 : Submodule.span (IsLocalRing.ResidueField R)
        (Set.range ((IsLocalRing.maximalIdeal R).toCotangent ∘ y)) = C := by
      have : (IsLocalRing.maximalIdeal R).toCotangent ∘ y = C.subtype ∘ b := funext hy
      rw [this, Set.range_comp, Submodule.span_image, b.span_eq, Submodule.map_subtype_top]
    rw [h2]
    exact hC.sup_eq_top
  have hspanR := IsLocalRing.CotangentSpace.span_image_eq_top_iff.mp hspan
  have hmJ : IsLocalRing.maximalIdeal R = J ⊔ Ideal.span (Set.range (fun j => (y j : R))) := by
    have := congrArg (Submodule.map (IsLocalRing.maximalIdeal R).subtype) hspanR
    rw [Submodule.map_span, Submodule.map_subtype_top, Set.image_union, ← Set.range_comp,
      ← Set.range_comp] at this
    exact this.symm.trans (by rw [Submodule.span_union]; rfl)
  have hJle : J ≤ IsLocalRing.maximalIdeal R :=
    Ideal.span_le.mpr (by rintro _ ⟨i, rfl⟩; exact (x i).2)
  have hJne : J ≠ ⊤ := ne_top_of_le_ne_top (IsLocalRing.maximalIdeal.isMaximal R).ne_top hJle
  haveI : Nontrivial (R ⧸ J) := Ideal.Quotient.nontrivial_iff.mpr hJne
  haveI : IsLocalRing (R ⧸ J) :=
    IsLocalRing.of_surjective' (Ideal.Quotient.mk J) Ideal.Quotient.mk_surjective
  haveI : IsNoetherianRing (R ⧸ J) := inferInstance
  have hmT : IsLocalRing.maximalIdeal (R ⧸ J) =
      Ideal.span (Set.range (Ideal.Quotient.mk J ∘ fun j => (y j : R))) := by
    have := congrArg (Ideal.map (Ideal.Quotient.mk J)) hmJ
    rw [Ideal.map_sup, Ideal.map_quotient_self, bot_sup_eq, Ideal.map_span, ← Set.range_comp,
      IsLocalRing.map_maximalIdeal_of_surjective (Ideal.Quotient.mk J)
        Ideal.Quotient.mk_surjective] at this
    exact this
  have hsT : Submodule.spanFinrank (IsLocalRing.maximalIdeal (R ⧸ J)) ≤ d - r := by
    rw [hmT]
    refine (Submodule.spanFinrank_span_le_ncard_of_finite (Set.finite_range _)).trans ?_
    rw [← Set.image_univ]
    refine (Set.ncard_image_le Set.finite_univ).trans ?_
    simp
  have hJr : Submodule.spanFinrank J ≤ r := by
    refine (Submodule.spanFinrank_span_le_ncard_of_finite (Set.finite_range _)).trans ?_
    rw [← Set.image_univ]
    refine (Set.ncard_image_le Set.finite_univ).trans ?_
    simp

  have hJjac : J ≤ Ring.jacobson R := by
    rw [← Ideal.jacobson_bot, IsLocalRing.jacobson_eq_maximalIdeal ⊥ bot_ne_top]
    exact hJle
  have hlow : ringKrullDim R ≤ ringKrullDim (R ⧸ J) + (r : WithBot ℕ∞) :=
    (ringKrullDim_le_ringKrullDim_quotient_add_spanFinrank J hJjac).trans
      (add_le_add le_rfl (by exact_mod_cast hJr))
  have hup : ringKrullDim (R ⧸ J) ≤ ((d - r : ℕ) : WithBot ℕ∞) :=
    (ringKrullDim_le_spanFinrank_maximalIdeal (R ⧸ J)).trans (by exact_mod_cast hsT)
  have key : ringKrullDim (R ⧸ J) = ((d - r : ℕ) : WithBot ℕ∞) := by
    have cast : ∀ n : ℕ, ((n : ℕ) : WithBot ℕ∞) = (((n : ℕ∞)) : WithBot ℕ∞) := fun n => rfl
    rw [← hdR] at hlow
    generalize ringKrullDim (R ⧸ J) = a at hup hlow ⊢
    induction a using WithBot.recBotCoe with
    | bot => simp at hlow
    | coe t =>
      rw [cast] at hup
      have hup' := WithBot.coe_le_coe.mp hup
      rw [cast d, cast r, ← WithBot.coe_add, WithBot.coe_le_coe] at hlow
      induction t using ENat.recTopCoe with
      | top => simp at hup'
      | coe s =>
        have h1 : s ≤ d - r := by exact_mod_cast hup'
        have h2 : d ≤ s + r := by exact_mod_cast hlow
        have h3 : s = d - r := by omega
        rw [cast, h3]
  refine ⟨IsRegularLocalRing.mk (le_antisymm ?_ (ringKrullDim_le_spanFinrank_maximalIdeal _)), ?_⟩
  · rw [key]
    exact_mod_cast hsT
  · rw [key, ← hdR, ← Nat.cast_add, Nat.sub_add_cancel hrd]

theorem wc_pfc_cz_ogoma_parameters : ∀ (Λ : Type u) [CommRing Λ] [IsNoetherianRing Λ] (I 𝔮 : Ideal Λ) [𝔮.IsPrime] [IsRegularLocalRing (Localization.AtPrime 𝔮)] (d n e : ℕ), Submodule.spanFinrank (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮)) = d → I ≤ 𝔮 → Ideal.map (algebraMap Λ (Localization.AtPrime 𝔮)) (𝔮 ^ n) ≤ Ideal.map (algebraMap Λ (Localization.AtPrime 𝔮)) I → ∃ π : Fin d → Λ, Ideal.map (algebraMap Λ (Localization.AtPrime 𝔮)) (Ideal.span (Set.range π)) = IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) ∧ (∀ i, π i ^ n ∈ I) ∧ ∀ i (y : Λ), π i ^ 2 * y ∈ Ideal.span ((fun j => π j ^ e) '' {j | j < i}) → π i * y ∈ Ideal.span ((fun j => π j ^ e) '' {j | j < i}) :=
by
  intro Λ _ _ I 𝔮 _ _ d n e hd hI hn
  classical

  have hnpos : 0 < n := by
    rcases Nat.eq_zero_or_pos n with h0 | h0
    · exfalso
      subst h0
      have h1 : Ideal.map (algebraMap Λ (Localization.AtPrime 𝔮)) I ≤
          IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) :=
        (Ideal.map_mono hI).trans (Localization.AtPrime.map_eq_maximalIdeal).le
      rw [pow_zero, Ideal.one_eq_top, Ideal.map_top] at hn
      exact (IsLocalRing.maximalIdeal.isMaximal (Localization.AtPrime 𝔮)).ne_top
        (eq_top_iff.mpr (hn.trans h1))
    · exact h0

  have uscale : ∀ (x y u : Fin d → Localization.AtPrime 𝔮), (∀ i, IsUnit (u i)) →
      (∀ i, x i = u i * y i) → Ideal.span (Set.range x) = Ideal.span (Set.range y) := by
    intro x y u hu hx
    apply le_antisymm
    · rw [Ideal.span_le]
      rintro _ ⟨i, rfl⟩
      rw [hx i]
      exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨i, rfl⟩)
    · rw [Ideal.span_le]
      rintro _ ⟨i, rfl⟩
      refine (Ideal.unit_mul_mem_iff_mem _ (hu i)).mp ?_
      rw [← hx i]
      exact Ideal.subset_span ⟨i, rfl⟩
  have hG : ∀ π : Fin d → Λ, Ideal.map (algebraMap Λ (Localization.AtPrime 𝔮))
      (Ideal.span (Set.range π)) =
      Ideal.span (Set.range (fun i => algebraMap Λ (Localization.AtPrime 𝔮) (π i))) := by
    intro π
    rw [Ideal.map_span, ← Set.range_comp]
    rfl
  have hunit : ∀ s : Λ, s ∉ 𝔮 → IsUnit (algebraMap Λ (Localization.AtPrime 𝔮) s) :=
    fun s hs => IsLocalization.map_units (Localization.AtPrime 𝔮) (⟨s, hs⟩ : 𝔮.primeCompl)

  have hs1 : ∃ g : Fin d → Localization.AtPrime 𝔮, Ideal.span (Set.range g) =
      IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) := by
    obtain ⟨S, hS1, hS2⟩ := Submodule.FG.exists_span_set_encard_eq_spanFinrank
      (IsNoetherian.noetherian (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮)))
    rw [hd] at hS1
    obtain ⟨F, rfl⟩ := (Set.finite_of_encard_eq_coe hS1).exists_finset_coe
    have hcard : F.card = d := by
      rw [Set.encard_coe_eq_coe_finsetCard] at hS1
      exact_mod_cast hS1
    subst hcard
    refine ⟨fun i => (F.equivFin.symm i : Localization.AtPrime 𝔮), ?_⟩
    have hr : Set.range (fun i => (F.equivFin.symm i : Localization.AtPrime 𝔮)) = (F : Set _) := by
      ext z
      constructor
      · rintro ⟨i, rfl⟩
        exact (F.equivFin.symm i).2
      · intro hz
        exact ⟨F.equivFin ⟨z, hz⟩, by simp⟩
    rw [hr]
    exact hS2

  obtain ⟨g, hg⟩ := hs1
  have hlift : ∀ i, ∃ a s : Λ, s ∉ 𝔮 ∧
      g i * algebraMap Λ (Localization.AtPrime 𝔮) s = algebraMap Λ (Localization.AtPrime 𝔮) a := by
    intro i
    obtain ⟨⟨a, s⟩, h⟩ := IsLocalization.surj 𝔮.primeCompl (g i)
    exact ⟨a, s, s.2, h⟩
  choose a s hs hga using hlift
  have ha𝔮 : ∀ i, a i ∈ 𝔮 := by
    intro i
    have hgi : g i ∈ IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) := by
      rw [← hg]; exact Ideal.subset_span ⟨i, rfl⟩
    have : algebraMap Λ (Localization.AtPrime 𝔮) (a i) ∈
        IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) := by
      rw [← hga i]; exact Ideal.mul_mem_right _ _ hgi
    exact (IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime 𝔮) 𝔮 (a i)).mp this
  have hm : ∀ i, ∃ m : Λ, m ∉ 𝔮 ∧ m * a i ^ n ∈ I := by
    intro i
    have h1 : algebraMap Λ (Localization.AtPrime 𝔮) (a i ^ n) ∈
        Ideal.map (algebraMap Λ (Localization.AtPrime 𝔮)) I :=
      hn (Ideal.mem_map_of_mem _ (Ideal.pow_mem_pow (ha𝔮 i) n))
    obtain ⟨m, hm1, hm2⟩ :=
      (IsLocalization.algebraMap_mem_map_algebraMap_iff 𝔮.primeCompl
        (Localization.AtPrime 𝔮) I (a i ^ n)).mp h1
    exact ⟨m, hm1, hm2⟩
  choose m hm𝔮 hmI using hm
  have hπ₀G : Ideal.map (algebraMap Λ (Localization.AtPrime 𝔮))
      (Ideal.span (Set.range fun i => m i * a i)) =
      IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) := by
    rw [hG, ← hg]
    refine uscale _ _ (fun i => algebraMap Λ (Localization.AtPrime 𝔮) (m i) *
      algebraMap Λ (Localization.AtPrime 𝔮) (s i)) (fun i => (hunit _ (hm𝔮 i)).mul (hunit _ (hs i)))
      (fun i => ?_)
    simp only [map_mul]
    rw [← hga i]
    ring
  have hπ₀I : ∀ i, (m i * a i) ^ n ∈ I := by
    intro i
    obtain ⟨n', rfl⟩ := Nat.exists_eq_succ_of_ne_zero hnpos.ne'
    rw [mul_pow, pow_succ (m i), mul_assoc]
    exact Ideal.mul_mem_left _ _ (hmI i)

  have ogoma : ∀ (J : Ideal Λ) (p : Λ), (∀ y : Λ, algebraMap Λ (Localization.AtPrime 𝔮) (p ^ 2 * y) ∈
      Ideal.map (algebraMap Λ (Localization.AtPrime 𝔮)) J →
      algebraMap Λ (Localization.AtPrime 𝔮) (p * y) ∈
      Ideal.map (algebraMap Λ (Localization.AtPrime 𝔮)) J) →
      ∃ s : Λ, s ∉ 𝔮 ∧ ∀ y : Λ, (s * p) ^ 2 * y ∈ J → s * p * y ∈ J := by
    intro J p hJ
    let K' : Ideal Λ :=
      { carrier := {y | algebraMap Λ (Localization.AtPrime 𝔮) (p ^ 2 * y) ∈
          Ideal.map (algebraMap Λ (Localization.AtPrime 𝔮)) J}
        add_mem' := by
          intro x y hx hy
          simp only [Set.mem_setOf_eq, mul_add, map_add] at hx hy ⊢
          exact add_mem hx hy
        zero_mem' := by simp
        smul_mem' := by
          intro c x hx
          simp only [Set.mem_setOf_eq, smul_eq_mul] at hx ⊢
          rw [mul_left_comm, map_mul]
          exact Ideal.mul_mem_left _ _ hx }
    have hK' : ∀ y, y ∈ K' ↔ algebraMap Λ (Localization.AtPrime 𝔮) (p ^ 2 * y) ∈
        Ideal.map (algebraMap Λ (Localization.AtPrime 𝔮)) J := fun y => Iff.rfl
    obtain ⟨F, hF⟩ := (IsNoetherian.noetherian K' : K'.FG)
    have hfin : ∀ F : Finset Λ, (∀ k ∈ F, k ∈ K') → ∃ s : Λ, s ∉ 𝔮 ∧ ∀ k ∈ F, s * p * k ∈ J := by
      intro F
      induction F using Finset.induction_on with
      | empty => exact fun _ => ⟨1, (inferInstance : 𝔮.IsPrime).one_notMem, by simp⟩
      | insert b F hbF ih =>
        intro hsub
        obtain ⟨s', hs', hs'F⟩ := ih (fun k hk => hsub k (Finset.mem_insert_of_mem hk))
        have hb := hJ b ((hK' b).mp (hsub b (Finset.mem_insert_self b F)))
        obtain ⟨u, hu, hub⟩ := (IsLocalization.algebraMap_mem_map_algebraMap_iff 𝔮.primeCompl
          (Localization.AtPrime 𝔮) J (p * b)).mp hb
        refine ⟨u * s', fun h => ?_, ?_⟩
        · rcases (inferInstance : 𝔮.IsPrime).mem_or_mem h with h1 | h1
          · exact hu h1
          · exact hs' h1
        · intro k hk
          rcases Finset.mem_insert.mp hk with rfl | hk
          · have : u * s' * p * k = s' * (u * (p * k)) := by ring
            rw [this]
            exact Ideal.mul_mem_left _ _ hub
          · have : u * s' * p * k = u * (s' * p * k) := by ring
            rw [this]
            exact Ideal.mul_mem_left _ _ (hs'F k hk)
    obtain ⟨s, hs, hsF⟩ := hfin F (fun k hk => by rw [← hF]; exact Submodule.subset_span hk)
    have hsK : ∀ y ∈ K', s * p * y ∈ J := by
      intro y hy
      rw [← hF] at hy
      induction hy using Submodule.span_induction with
      | mem x hx => exact hsF x hx
      | zero => simp
      | add x z _ _ hx hz => rw [mul_add]; exact add_mem hx hz
      | smul c x _ hx =>
        rw [smul_eq_mul, mul_left_comm]
        exact Ideal.mul_mem_left _ _ hx
    refine ⟨s, hs, fun y hy => hsK y ?_⟩
    rw [hK']
    have h1 := Ideal.mem_map_of_mem (algebraMap Λ (Localization.AtPrime 𝔮)) hy
    have h2 : algebraMap Λ (Localization.AtPrime 𝔮) ((s * p) ^ 2 * y) =
        algebraMap Λ (Localization.AtPrime 𝔮) s ^ 2 *
          algebraMap Λ (Localization.AtPrime 𝔮) (p ^ 2 * y) := by
      simp only [map_mul, map_pow]; ring
    rw [h2] at h1
    exact (Ideal.unit_mul_mem_iff_mem _ ((hunit s hs).pow 2)).mp h1

  have hs5 : ∀ (x : Fin d → Localization.AtPrime 𝔮),
      Ideal.span (Set.range x) = IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) →
      ∀ (T : Set (Fin d)) (t : Fin d), t ∉ T → ∀ y, x t * y ∈ Ideal.span (x '' T) →
        y ∈ Ideal.span (x '' T) := by
    intro x hx T t ht y hy
    let A : Finset (Localization.AtPrime 𝔮) := Finset.image x (Finset.univ.filter (· ∈ T))
    let B : Finset (Localization.AtPrime 𝔮) := Finset.image x (Finset.univ.filter (· ∉ T))
    have hA : (A : Set (Localization.AtPrime 𝔮)) = x '' T := by
      ext z; simp [A]
    have hAB : (A : Set (Localization.AtPrime 𝔮)) ∪ (B : Set _) = Set.range x := by
      ext z
      simp only [A, B, Finset.coe_image, Finset.coe_filter, Finset.mem_univ, true_and,
        Set.mem_union, Set.mem_image, Set.mem_setOf_eq, Set.mem_range]
      constructor
      · rintro (⟨i, _, rfl⟩ | ⟨i, _, rfl⟩) <;> exact ⟨i, rfl⟩
      · rintro ⟨i, rfl⟩
        by_cases hi : i ∈ T
        · exact Or.inl ⟨i, hi, rfl⟩
        · exact Or.inr ⟨i, hi, rfl⟩
    have hcard : A.card + B.card ≤
        Submodule.spanFinrank (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮)) := by
      rw [hd]
      calc A.card + B.card ≤ (Finset.univ.filter (· ∈ T)).card +
            (Finset.univ.filter (fun i : Fin d => ¬ (i ∈ T))).card :=
            Nat.add_le_add Finset.card_image_le Finset.card_image_le
        _ = d := by
            rw [Finset.card_filter_add_card_filter_not, Finset.card_univ, Fintype.card_fin]
    obtain ⟨hreg, -, hB⟩ := wc_ogp_quotient_regular (Localization.AtPrime 𝔮) A B
      (by rw [hAB]; exact hx) hcard
    have htB : x t ∈ B := Finset.mem_image.mpr ⟨t, by simp [ht], rfl⟩
    have hxt := hB (x t) htB
    haveI := hreg
    haveI := wcpa_regular_isDomain
      (Localization.AtPrime 𝔮 ⧸ Ideal.span (A : Set (Localization.AtPrime 𝔮)))
      wcpa_rs_quotient_regular hreg
    rw [← hA] at hy ⊢
    have h0 : Ideal.Quotient.mk (Ideal.span (A : Set (Localization.AtPrime 𝔮))) (x t) *
        Ideal.Quotient.mk (Ideal.span (A : Set (Localization.AtPrime 𝔮))) y = 0 := by
      rw [← map_mul, Ideal.Quotient.eq_zero_iff_mem]; exact hy
    rcases mul_eq_zero.mp h0 with h | h
    · exact absurd (Ideal.Quotient.eq_zero_iff_mem.mp h) hxt
    · exact Ideal.Quotient.eq_zero_iff_mem.mp h

  have step : ∀ π : Fin d → Λ, Ideal.map (algebraMap Λ (Localization.AtPrime 𝔮))
      (Ideal.span (Set.range π)) = IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) →
      ∀ t : Fin d, ∃ s : Λ, s ∉ 𝔮 ∧ ∀ y : Λ,
        (s * π t) ^ 2 * y ∈ Ideal.span ((fun j => π j ^ e) '' {j | j < t}) →
        s * π t * y ∈ Ideal.span ((fun j => π j ^ e) '' {j | j < t}) := by
    intro π hπ t
    have hx : Ideal.span (Set.range (fun i => algebraMap Λ (Localization.AtPrime 𝔮) (π i))) =
        IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) := by rw [← hG]; exact hπ
    have H := hs5 _ hx
    have hpow := wc_ogp_regseq_pow (Localization.AtPrime 𝔮) d _ H e t
    have hmap : Ideal.map (algebraMap Λ (Localization.AtPrime 𝔮))
        (Ideal.span ((fun j => π j ^ e) '' {j | j < t})) =
        Ideal.span ((fun j => (algebraMap Λ (Localization.AtPrime 𝔮) (π j)) ^ e) '' {j | j < t}) := by
      rw [Ideal.map_span, Set.image_image]
      simp only [map_pow]
    apply ogoma
    intro y hy
    rw [hmap] at hy ⊢
    have e1 : algebraMap Λ (Localization.AtPrime 𝔮) (π t ^ 2 * y) =
        algebraMap Λ (Localization.AtPrime 𝔮) (π t) *
          (algebraMap Λ (Localization.AtPrime 𝔮) (π t) * algebraMap Λ (Localization.AtPrime 𝔮) y) := by
      simp only [map_mul, map_pow]; ring
    rw [e1] at hy
    rw [map_mul]
    exact hpow _ hy

  have loop : ∀ k : ℕ, ∃ π : Fin d → Λ, Ideal.map (algebraMap Λ (Localization.AtPrime 𝔮))
      (Ideal.span (Set.range π)) = IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) ∧
      (∀ i, π i ^ n ∈ I) ∧ ∀ i : Fin d, i.val < k → ∀ (y : Λ),
        π i ^ 2 * y ∈ Ideal.span ((fun j => π j ^ e) '' {j | j < i}) →
        π i * y ∈ Ideal.span ((fun j => π j ^ e) '' {j | j < i}) := by
    intro k
    induction k with
    | zero => exact ⟨fun i => m i * a i, hπ₀G, hπ₀I, fun i hi => absurd hi (Nat.not_lt_zero _)⟩
    | succ k ih =>
      obtain ⟨π, hπG, hπI, hπC⟩ := ih
      by_cases hk : k < d
      · let t : Fin d := ⟨k, hk⟩
        obtain ⟨s, hs, hsC⟩ := step π hπG t
        let π' : Fin d → Λ := fun i => if i = t then s * π i else π i
        have hJ : ∀ i : Fin d, i ≤ t → (fun j => π' j ^ e) '' {j | j < i} =
            (fun j => π j ^ e) '' {j | j < i} := by
          intro i hi
          apply Set.image_congr
          intro j hj
          have hjt : j ≠ t := ne_of_lt (lt_of_lt_of_le hj hi)
          simp only [π', if_neg hjt]
        refine ⟨π', ?_, ?_, ?_⟩
        · rw [hG, ← hπG, hG]
          refine uscale _ _ (fun i => if i = t then algebraMap Λ (Localization.AtPrime 𝔮) s else 1)
            (fun i => ?_) (fun i => ?_)
          · by_cases hi : i = t
            · simp only [if_pos hi]; exact hunit s hs
            · simp only [if_neg hi]; exact isUnit_one
          · by_cases hi : i = t
            · simp only [π', if_pos hi, map_mul]
            · simp only [π', if_neg hi, one_mul]
        · intro i
          by_cases hi : i = t
          · simp only [π', if_pos hi, mul_pow]
            exact Ideal.mul_mem_left _ _ (hπI i)
          · simp only [π', if_neg hi]
            exact hπI i
        · intro i hi y
          by_cases hik : i.val < k
          · have hit : i ≠ t := fun h => by rw [h] at hik; exact lt_irrefl _ hik
            have hle : i ≤ t := le_of_lt (show i.val < t.val from hik)
            rw [hJ i hle]
            simp only [π', if_neg hit]
            exact hπC i hik y
          · have hit : i = t := Fin.ext (by simp [t]; omega)
            subst hit
            rw [hJ _ le_rfl]
            simp only [π', if_true]
            exact hsC y
      · refine ⟨π, hπG, hπI, fun i hi => hπC i ?_⟩
        have := i.isLt
        omega
  obtain ⟨π, hπG, hπI, hπC⟩ := loop d
  exact ⟨π, hπG, hπI, fun i y => hπC i i.isLt y⟩

theorem wc_pfc_cz_parameter_algebra : ∀ (k : Type u) [Field k] (A : Type u) [CommRing A] [Algebra k A] [Algebra.FinitePresentation k A] (r d n : ℕ) (a : Fin r → A), (∀ j, Algebra.Smooth k (Localization.Away (a j))) → ∃ (B : Type u) (_ : CommRing B) (_ : Algebra (MvPolynomial (Fin d) k) B) (_ : Algebra k B) (_ : IsScalarTower k (MvPolynomial (Fin d) k) B) (_ : Algebra.FinitePresentation (MvPolynomial (Fin d) k) B) (ι : A →ₐ[k] B), (∀ j, Algebra.Smooth (MvPolynomial (Fin d) k) (Localization.Away (ι (a j)))) ∧ (∀ i, Algebra.Smooth (MvPolynomial (Fin d) k) (Localization.Away (algebraMap (MvPolynomial (Fin d) k) B (MvPolynomial.X i)))) ∧ ∀ (Λ : Type u) [CommRing Λ] [Algebra k Λ] [Algebra (MvPolynomial (Fin d) k) Λ] [IsScalarTower k (MvPolynomial (Fin d) k) Λ] (φ : A →ₐ[k] Λ) (μ : Fin d → Fin r → Λ), (∀ i, algebraMap (MvPolynomial (Fin d) k) Λ (MvPolynomial.X i) ^ n = ∑ j, μ i j * φ (a j)) → ∃ χ : B →ₐ[MvPolynomial (Fin d) k] Λ, ∀ x, χ (ι x) = φ x :=
by
  intro k _ A _ _ _ r d n a ha
  classical

  have hpow : ∀ (R B : Type u) [CommRing R] [CommRing B] [Algebra R B] (s : Fin r → B) (b : B),
      (∀ j, Algebra.Smooth R (Localization.Away (s j))) → b ^ n ∈ Ideal.span (Set.range s) →
      Algebra.Smooth R (Localization.Away b) := by
    intro R B _ _ _ s b hs hb
    rw [← RingHom.smooth_algebraMap]
    have hspan : Ideal.span (Set.range fun j => algebraMap B (Localization.Away b) (s j)) = ⊤ := by
      apply Ideal.eq_top_of_isUnit_mem _ _ ((IsLocalization.Away.algebraMap_isUnit b).pow n)
      rw [← map_pow]
      have h := Ideal.mem_map_of_mem (algebraMap B (Localization.Away b)) hb
      rw [Ideal.map_span, ← Set.range_comp] at h
      exact h
    refine RingHom.Smooth.ofLocalizationSpanTarget (algebraMap R (Localization.Away b)) _ hspan ?_
    rintro ⟨_, j, rfl⟩
    have := hs j
    have : Algebra.Smooth R (Localization.Away (algebraMap B (Localization.Away (s j)) b)) :=
      Algebra.Smooth.comp R (Localization.Away (s j)) _
    have : IsLocalization.Away (s j * b)
        (Localization.Away (algebraMap B (Localization.Away b) (s j))) :=
      IsLocalization.Away.mul (Localization.Away b) _ b (s j)
    have : IsLocalization.Away (s j * b)
        (Localization.Away (algebraMap B (Localization.Away (s j)) b)) :=
      IsLocalization.Away.mul' (Localization.Away (s j)) _ (s j) b
    have hsm : Algebra.Smooth R (Localization.Away (algebraMap B (Localization.Away b) (s j))) :=
      Algebra.Smooth.of_equiv ((IsLocalization.algEquiv (Submonoid.powers (s j * b))
        (Localization.Away (algebraMap B (Localization.Away (s j)) b))
        (Localization.Away (algebraMap B (Localization.Away b) (s j)))).restrictScalars R)
    have h := (RingHom.smooth_algebraMap (R := R)
      (S := Localization.Away (algebraMap B (Localization.Away b) (s j)))).mpr hsm
    rw [IsScalarTower.algebraMap_eq R (Localization.Away b)
      (Localization.Away (algebraMap B (Localization.Away b) (s j)))] at h
    exact h

  have hpoly : ∀ (A' : Type u) [CommRing A'] [Algebra k A'] [Algebra.Smooth k A'] (τ : Type)
      [Finite τ] (f : MvPolynomial (Fin d) k →+* MvPolynomial τ (MvPolynomial (Fin d) A')),
      (∀ c, f (MvPolynomial.C c) = MvPolynomial.C (MvPolynomial.C (algebraMap k A' c))) →
      (∀ i, f (MvPolynomial.X i) = MvPolynomial.C (MvPolynomial.X i)) → f.Smooth := by
    intro A' _ _ _ τ _ f hC hX
    letI : Algebra (MvPolynomial (Fin d) k) (MvPolynomial (Fin d) A') :=
      MvPolynomial.algebraMvPolynomial
    have h1 : (algebraMap (MvPolynomial (Fin d) k) (MvPolynomial (Fin d) A')).Smooth :=
      RingHom.Smooth.isStableUnderBaseChange k A' (MvPolynomial (Fin d) k)
        (MvPolynomial (Fin d) A') (RingHom.smooth_algebraMap.mpr inferInstance)
    have : Algebra.Smooth (MvPolynomial (Fin d) A') (MvPolynomial τ (MvPolynomial (Fin d) A')) :=
      Algebra.Smooth.mk
    have h2 : (algebraMap (MvPolynomial (Fin d) A')
        (MvPolynomial τ (MvPolynomial (Fin d) A'))).Smooth :=
      RingHom.smooth_algebraMap.mpr inferInstance
    have hf : f = (algebraMap (MvPolynomial (Fin d) A')
        (MvPolynomial τ (MvPolynomial (Fin d) A'))).comp
        (algebraMap (MvPolynomial (Fin d) k) (MvPolynomial (Fin d) A')) := by
      apply MvPolynomial.ringHom_ext
      · intro c
        rw [hC, RingHom.comp_apply, MvPolynomial.algebraMap_eq]
        congr 1
        exact (MvPolynomial.map_C _ _).symm
      · intro i
        rw [hX, RingHom.comp_apply, MvPolynomial.algebraMap_eq]
        congr 1
        exact (MvPolynomial.map_X _ _).symm
    rw [hf]
    exact RingHom.Smooth.comp h1 h2

  obtain ⟨g, hg⟩ : ∃ g : Fin d → MvPolynomial (Fin d ⊕ Fin d × Fin r) A,
      g = fun i => MvPolynomial.X (Sum.inl i) ^ n -
        ∑ l, MvPolynomial.X (Sum.inr (i, l)) * MvPolynomial.C (a l) := ⟨_, rfl⟩
  obtain ⟨I, hI⟩ : ∃ I : Ideal (MvPolynomial (Fin d ⊕ Fin d × Fin r) A),
      I = Ideal.span (Set.range g) := ⟨_, rfl⟩
  have hrel : ∀ i, Ideal.Quotient.mk I (MvPolynomial.X (Sum.inl i)) ^ n =
      ∑ l, Ideal.Quotient.mk I (MvPolynomial.X (Sum.inr (i, l))) *
        Ideal.Quotient.mk I (MvPolynomial.C (a l)) := by
    intro i
    have h : Ideal.Quotient.mk I (g i) = 0 := by
      rw [Ideal.Quotient.eq_zero_iff_mem, hI]
      exact Ideal.subset_span ⟨i, rfl⟩
    rw [hg] at h
    simp only [map_sub, map_pow, map_sum, map_mul] at h
    exact sub_eq_zero.mp h
  have hkB : ∀ c : k, algebraMap k (MvPolynomial (Fin d ⊕ Fin d × Fin r) A ⧸ I) c =
      Ideal.Quotient.mk I (MvPolynomial.C (algebraMap k A c)) := fun c => by
    rw [IsScalarTower.algebraMap_apply k (MvPolynomial (Fin d ⊕ Fin d × Fin r) A)
      (MvPolynomial (Fin d ⊕ Fin d × Fin r) A ⧸ I), Ideal.Quotient.algebraMap_eq,
      MvPolynomial.algebraMap_apply]
  obtain ⟨ι, hι⟩ : ∃ ι : A →ₐ[k] (MvPolynomial (Fin d ⊕ Fin d × Fin r) A ⧸ I),
      ∀ x, ι x = Ideal.Quotient.mk I (MvPolynomial.C x) :=
    ⟨IsScalarTower.toAlgHom k A _, fun x => by
      rw [IsScalarTower.toAlgHom_apply, IsScalarTower.algebraMap_apply A
        (MvPolynomial (Fin d ⊕ Fin d × Fin r) A) (MvPolynomial (Fin d ⊕ Fin d × Fin r) A ⧸ I),
        Ideal.Quotient.algebraMap_eq, MvPolynomial.algebraMap_eq]⟩
  letI iRB : Algebra (MvPolynomial (Fin d) k) (MvPolynomial (Fin d ⊕ Fin d × Fin r) A ⧸ I) :=
    (MvPolynomial.aeval (R := k) (fun i => Ideal.Quotient.mk I
      (MvPolynomial.X (Sum.inl i) : MvPolynomial (Fin d ⊕ Fin d × Fin r) A))).toRingHom.toAlgebra
  haveI tRB : @IsScalarTower k (MvPolynomial (Fin d) k)
      (MvPolynomial (Fin d ⊕ Fin d × Fin r) A ⧸ I) _ (@Algebra.toSMul _ _ _ _ iRB) _ :=
    IsScalarTower.of_algebraMap_eq (fun c => ((MvPolynomial.aeval (R := k) (fun i =>
      Ideal.Quotient.mk I (MvPolynomial.X (Sum.inl i) :
        MvPolynomial (Fin d ⊕ Fin d × Fin r) A))).commutes c).symm)
  have hXB : ∀ i, algebraMap (MvPolynomial (Fin d) k) (MvPolynomial (Fin d ⊕ Fin d × Fin r) A ⧸ I)
      (MvPolynomial.X i) = Ideal.Quotient.mk I (MvPolynomial.X (Sum.inl i)) :=
    fun i => MvPolynomial.aeval_X _ i
  have hCB : ∀ c : k, algebraMap (MvPolynomial (Fin d) k)
      (MvPolynomial (Fin d ⊕ Fin d × Fin r) A ⧸ I) (MvPolynomial.C c) =
      Ideal.Quotient.mk I (MvPolynomial.C (algebraMap k A c)) :=
    fun c => (MvPolynomial.aeval_C _ c).trans (hkB c)

  haveI : Algebra.FinitePresentation k (MvPolynomial (Fin d ⊕ Fin d × Fin r) A) :=
    Algebra.FinitePresentation.mvPolynomial k A _
  haveI : Algebra.FinitePresentation k (MvPolynomial (Fin d ⊕ Fin d × Fin r) A ⧸ I) :=
    Algebra.FinitePresentation.quotient (by rw [hI]; exact Submodule.fg_span (Set.finite_range g))
  haveI hfpR : Algebra.FinitePresentation (MvPolynomial (Fin d) k)
      (MvPolynomial (Fin d ⊕ Fin d × Fin r) A ⧸ I) :=
    Algebra.FinitePresentation.of_restrict_scalars_finitePresentation k _ _

  have hsmA : ∀ j, Algebra.Smooth (MvPolynomial (Fin d) k)
      (Localization.Away (Ideal.Quotient.mk I (MvPolynomial.C (a j)))) := by
    intro j
    have := ha j
    obtain ⟨u, hu⟩ : ∃ u : Localization.Away (a j),
        algebraMap A (Localization.Away (a j)) (a j) * u = 1 :=
      ⟨_, IsLocalization.Away.mul_invSelf (a j)⟩

    have hR : ∀ i, algebraMap _ (Localization.Away (Ideal.Quotient.mk I (MvPolynomial.C (a j))))
          (Ideal.Quotient.mk I (MvPolynomial.X (Sum.inl i))) ^ n =
        algebraMap _ (Localization.Away (Ideal.Quotient.mk I (MvPolynomial.C (a j))))
          (Ideal.Quotient.mk I (MvPolynomial.X (Sum.inr (i, j)))) *
        algebraMap _ (Localization.Away (Ideal.Quotient.mk I (MvPolynomial.C (a j))))
          (Ideal.Quotient.mk I (MvPolynomial.C (a j))) +
        ∑ l : {l : Fin r // l ≠ j},
          algebraMap _ (Localization.Away (Ideal.Quotient.mk I (MvPolynomial.C (a j))))
            (Ideal.Quotient.mk I (MvPolynomial.X (Sum.inr (i, l.1)))) *
          algebraMap _ (Localization.Away (Ideal.Quotient.mk I (MvPolynomial.C (a j))))
            (Ideal.Quotient.mk I (MvPolynomial.C (a l.1))) := by
      intro i
      have h := congrArg (algebraMap _
        (Localization.Away (Ideal.Quotient.mk I (MvPolynomial.C (a j))))) (hrel i)
      rw [map_pow, map_sum] at h
      simp only [map_mul] at h
      rw [h, Fintype.sum_eq_add_sum_subtype_ne _ j]

    have hunitL : IsUnit (((algebraMap (MvPolynomial (Fin d ⊕ Fin d × Fin r) A ⧸ I)
        (Localization.Away (Ideal.Quotient.mk I (MvPolynomial.C (a j))))).comp
        ((Ideal.Quotient.mk I).comp MvPolynomial.C)) (a j)) :=
      IsLocalization.Away.algebraMap_isUnit (Ideal.Quotient.mk I (MvPolynomial.C (a j)))
    obtain ⟨ℓ, hℓ⟩ : ∃ ℓ : Localization.Away (a j) →+*
        Localization.Away (Ideal.Quotient.mk I (MvPolynomial.C (a j))),
        ∀ x : A, ℓ (algebraMap A (Localization.Away (a j)) x) =
          algebraMap _ (Localization.Away (Ideal.Quotient.mk I (MvPolynomial.C (a j))))
            (Ideal.Quotient.mk I (MvPolynomial.C x)) :=
      ⟨IsLocalization.Away.lift (a j) hunitL, fun x => IsLocalization.Away.lift_eq (a j) hunitL x⟩
    obtain ⟨α, hαCC, hαCX, hαX⟩ : ∃ α : MvPolynomial {p : Fin d × Fin r // p.2 ≠ j}
          (MvPolynomial (Fin d) (Localization.Away (a j))) →+*
          Localization.Away (Ideal.Quotient.mk I (MvPolynomial.C (a j))),
        (∀ y, α (MvPolynomial.C (MvPolynomial.C y)) = ℓ y) ∧
        (∀ i, α (MvPolynomial.C (MvPolynomial.X i)) =
          algebraMap _ (Localization.Away (Ideal.Quotient.mk I (MvPolynomial.C (a j))))
            (Ideal.Quotient.mk I (MvPolynomial.X (Sum.inl i)))) ∧
        ∀ p : {p : Fin d × Fin r // p.2 ≠ j}, α (MvPolynomial.X p) =
          algebraMap _ (Localization.Away (Ideal.Quotient.mk I (MvPolynomial.C (a j))))
            (Ideal.Quotient.mk I (MvPolynomial.X (Sum.inr p.1))) :=
      ⟨MvPolynomial.eval₂Hom (MvPolynomial.eval₂Hom ℓ (fun i => algebraMap _
          (Localization.Away (Ideal.Quotient.mk I (MvPolynomial.C (a j))))
          (Ideal.Quotient.mk I (MvPolynomial.X (Sum.inl i)))))
        (fun p => algebraMap _ (Localization.Away (Ideal.Quotient.mk I (MvPolynomial.C (a j))))
          (Ideal.Quotient.mk I (MvPolynomial.X (Sum.inr p.1)))),
        fun y => by rw [MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_C],
        fun i => by rw [MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_X'],
        fun p => MvPolynomial.eval₂Hom_X' _ _ _⟩

    obtain ⟨T, hT⟩ : ∃ T : Fin d → MvPolynomial {p : Fin d × Fin r // p.2 ≠ j}
          (MvPolynomial (Fin d) (Localization.Away (a j))),
        T = fun i => ∑ l : {l : Fin r // l ≠ j},
          (MvPolynomial.X (⟨(i, l.1), l.2⟩ : {p : Fin d × Fin r // p.2 ≠ j}) :
            MvPolynomial {p : Fin d × Fin r // p.2 ≠ j}
              (MvPolynomial (Fin d) (Localization.Away (a j)))) *
          MvPolynomial.C (MvPolynomial.C (algebraMap A (Localization.Away (a j)) (a l.1))) :=
      ⟨_, rfl⟩
    have hTi : ∀ i, T i = ∑ l : {l : Fin r // l ≠ j},
          (MvPolynomial.X (⟨(i, l.1), l.2⟩ : {p : Fin d × Fin r // p.2 ≠ j}) :
            MvPolynomial {p : Fin d × Fin r // p.2 ≠ j}
              (MvPolynomial (Fin d) (Localization.Away (a j)))) *
          MvPolynomial.C (MvPolynomial.C (algebraMap A (Localization.Away (a j)) (a l.1))) :=
      fun i => by rw [hT]
    obtain ⟨V, hVl, hVj, hVne⟩ : ∃ V : Fin d ⊕ Fin d × Fin r →
          MvPolynomial {p : Fin d × Fin r // p.2 ≠ j}
            (MvPolynomial (Fin d) (Localization.Away (a j))),
        (∀ i, V (Sum.inl i) = MvPolynomial.C (MvPolynomial.X i)) ∧
        (∀ i, V (Sum.inr (i, j)) = MvPolynomial.C (MvPolynomial.C u) *
          (MvPolynomial.C (MvPolynomial.X i) ^ n - T i)) ∧
        ∀ p : {p : Fin d × Fin r // p.2 ≠ j}, V (Sum.inr p.1) = MvPolynomial.X p :=
      ⟨Sum.elim (fun i => MvPolynomial.C (MvPolynomial.X i))
        (fun p => if h : p.2 = j then MvPolynomial.C (MvPolynomial.C u) *
          (MvPolynomial.C (MvPolynomial.X p.1) ^ n - T p.1) else MvPolynomial.X ⟨p, h⟩),
        fun i => rfl, fun i => by simp, fun p => by simp [p.2]⟩
    have hVne2 : ∀ (i : Fin d) (l : {l : Fin r // l ≠ j}), V (Sum.inr (i, l.1)) =
        MvPolynomial.X (⟨(i, l.1), l.2⟩ : {p : Fin d × Fin r // p.2 ≠ j}) :=
      fun i l => hVne ⟨(i, l.1), l.2⟩
    obtain ⟨β₀, hβ₀C, hβ₀X⟩ : ∃ β₀ : MvPolynomial (Fin d ⊕ Fin d × Fin r) A →+*
          MvPolynomial {p : Fin d × Fin r // p.2 ≠ j}
            (MvPolynomial (Fin d) (Localization.Away (a j))),
        (∀ x, β₀ (MvPolynomial.C x) =
          MvPolynomial.C (MvPolynomial.C (algebraMap A (Localization.Away (a j)) x))) ∧
        ∀ s, β₀ (MvPolynomial.X s) = V s :=
      ⟨MvPolynomial.eval₂Hom ((MvPolynomial.C.comp MvPolynomial.C).comp
          (algebraMap A (Localization.Away (a j)))) V,
        fun x => MvPolynomial.eval₂Hom_C _ _ _, fun s => MvPolynomial.eval₂Hom_X' _ _ _⟩
    have hu' : (MvPolynomial.C (MvPolynomial.C u) : MvPolynomial {p : Fin d × Fin r // p.2 ≠ j}
          (MvPolynomial (Fin d) (Localization.Away (a j)))) *
        MvPolynomial.C (MvPolynomial.C (algebraMap A (Localization.Away (a j)) (a j))) = 1 := by
      rw [← map_mul, ← map_mul, mul_comm, hu, map_one, map_one]
    have hβ₀g : ∀ i, β₀ (g i) = 0 := by
      intro i
      rw [hg]
      simp only [map_sub, map_pow, map_sum, map_mul, hβ₀C, hβ₀X]
      rw [Fintype.sum_eq_add_sum_subtype_ne _ j, hVl, hVj]
      simp only [hVne2]
      rw [← hTi i]
      linear_combination (T i - MvPolynomial.C (MvPolynomial.X i) ^ n) * hu'
    have hIker : I ≤ RingHom.ker β₀ := by
      rw [hI, Ideal.span_le]
      rintro _ ⟨i, rfl⟩
      exact RingHom.mem_ker.mpr (hβ₀g i)
    obtain ⟨β₁, hβ₁⟩ : ∃ β₁ : (MvPolynomial (Fin d ⊕ Fin d × Fin r) A ⧸ I) →+*
          MvPolynomial {p : Fin d × Fin r // p.2 ≠ j}
            (MvPolynomial (Fin d) (Localization.Away (a j))),
        ∀ x, β₁ (Ideal.Quotient.mk I x) = β₀ x :=
      ⟨Ideal.Quotient.lift I β₀ (fun x hx => RingHom.mem_ker.mp (hIker hx)),
        fun x => Ideal.Quotient.lift_mk I β₀ _⟩
    have hunitP : IsUnit (β₁ (Ideal.Quotient.mk I (MvPolynomial.C (a j)))) := by
      refine isUnit_iff_exists_inv.mpr ⟨MvPolynomial.C (MvPolynomial.C u), ?_⟩
      rw [hβ₁, hβ₀C, mul_comm, hu']
    obtain ⟨β, hβ⟩ : ∃ β : Localization.Away (Ideal.Quotient.mk I (MvPolynomial.C (a j))) →+*
          MvPolynomial {p : Fin d × Fin r // p.2 ≠ j}
            (MvPolynomial (Fin d) (Localization.Away (a j))),
        ∀ x, β (algebraMap _ (Localization.Away (Ideal.Quotient.mk I (MvPolynomial.C (a j)))) x) =
          β₁ x :=
      ⟨IsLocalization.Away.lift _ hunitP, fun x => IsLocalization.Away.lift_eq _ hunitP x⟩

    have hβα : β.comp α = RingHom.id _ := by
      apply MvPolynomial.ringHom_ext
      · intro y
        have hy : (β.comp α).comp MvPolynomial.C = MvPolynomial.C := by
          apply MvPolynomial.ringHom_ext
          · intro z
            have hz : ((β.comp α).comp MvPolynomial.C).comp MvPolynomial.C =
                (MvPolynomial.C.comp MvPolynomial.C : Localization.Away (a j) →+*
                  MvPolynomial {p : Fin d × Fin r // p.2 ≠ j}
                    (MvPolynomial (Fin d) (Localization.Away (a j)))) := by
              apply IsLocalization.ringHom_ext (Submonoid.powers (a j))
              ext x
              simp only [RingHom.comp_apply]
              rw [hαCC, hℓ, hβ, hβ₁, hβ₀C]
            exact DFunLike.congr_fun hz z
          · intro i
            simp only [RingHom.comp_apply]
            rw [hαCX, hβ, hβ₁, hβ₀X, hVl]
        exact DFunLike.congr_fun hy y
      · intro p
        simp only [RingHom.comp_apply, RingHom.id_apply]
        rw [hαX, hβ, hβ₁, hβ₀X, hVne]

    have hℓu : ℓ u * algebraMap _ (Localization.Away (Ideal.Quotient.mk I (MvPolynomial.C (a j))))
        (Ideal.Quotient.mk I (MvPolynomial.C (a j))) = 1 := by
      rw [← hℓ, ← map_mul, mul_comm, hu, map_one]
    have hαβ : α.comp β = RingHom.id _ := by
      apply IsLocalization.ringHom_ext
        (Submonoid.powers (Ideal.Quotient.mk I (MvPolynomial.C (a j))))
      apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext
      · intro x
        simp only [RingHom.comp_apply, RingHom.id_apply]
        rw [hβ, hβ₁, hβ₀C, hαCC, hℓ]
      · intro s
        simp only [RingHom.comp_apply, RingHom.id_apply]
        rw [hβ, hβ₁, hβ₀X]
        rcases s with i | ⟨i, l⟩
        · rw [hVl, hαCX]
        · by_cases hl : l = j
          · rw [hl, hVj, map_mul, map_sub, map_pow, hαCC, hαCX, hTi i, map_sum]
            simp only [map_mul, hαCC, hαX, hℓ]
            linear_combination ℓ u * hR i +
              algebraMap _ (Localization.Away (Ideal.Quotient.mk I (MvPolynomial.C (a j))))
                (Ideal.Quotient.mk I (MvPolynomial.X (Sum.inr (i, j)))) * hℓu
          · rw [hVne ⟨(i, l), hl⟩, hαX]

    obtain ⟨f, hf⟩ : ∃ f : MvPolynomial (Fin d) k →+* MvPolynomial {p : Fin d × Fin r // p.2 ≠ j}
          (MvPolynomial (Fin d) (Localization.Away (a j))),
        f = β.comp (algebraMap (MvPolynomial (Fin d) k)
          (Localization.Away (Ideal.Quotient.mk I (MvPolynomial.C (a j))))) := ⟨_, rfl⟩
    have hfs := hpoly (Localization.Away (a j)) {p : Fin d × Fin r // p.2 ≠ j} f
        (fun c => ?_) (fun i => ?_)
    rotate_left
    · rw [hf, RingHom.comp_apply, IsScalarTower.algebraMap_apply (MvPolynomial (Fin d) k)
        (MvPolynomial (Fin d ⊕ Fin d × Fin r) A ⧸ I)
        (Localization.Away (Ideal.Quotient.mk I (MvPolynomial.C (a j)))), hCB, hβ, hβ₁, hβ₀C,
        ← IsScalarTower.algebraMap_apply k A (Localization.Away (a j))]
    · rw [hf, RingHom.comp_apply, IsScalarTower.algebraMap_apply (MvPolynomial (Fin d) k)
        (MvPolynomial (Fin d ⊕ Fin d × Fin r) A ⧸ I)
        (Localization.Away (Ideal.Quotient.mk I (MvPolynomial.C (a j)))), hXB, hβ, hβ₁, hβ₀X,
        hVl]
    have hαf : algebraMap (MvPolynomial (Fin d) k)
        (Localization.Away (Ideal.Quotient.mk I (MvPolynomial.C (a j)))) = α.comp f := by
      rw [hf, ← RingHom.comp_assoc, hαβ, RingHom.id_comp]
    have hαbij : Function.Bijective α := by
      refine Function.bijective_iff_has_inverse.mpr ⟨β, fun x => ?_, fun x => ?_⟩
      · exact DFunLike.congr_fun hβα x
      · exact DFunLike.congr_fun hαβ x
    rw [← RingHom.smooth_algebraMap, hαf]
    exact RingHom.Smooth.comp hfs (RingHom.Smooth.of_bijective hαbij)
  refine ⟨MvPolynomial (Fin d ⊕ Fin d × Fin r) A ⧸ I, inferInstance, iRB, inferInstance, tRB,
    hfpR, ι, ?_, ?_, ?_⟩
  ·
    intro j
    rw [hι]
    exact hsmA j
  ·
    intro i
    refine hpow (MvPolynomial (Fin d) k) _ (fun l => Ideal.Quotient.mk I (MvPolynomial.C (a l)))
      _ hsmA ?_
    rw [hXB, hrel i]
    exact Ideal.sum_mem _ (fun l _ => Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨l, rfl⟩))
  ·
    intro Λ _ _ _ _ φ μ hμ
    obtain ⟨χ₀', hχC, hχX⟩ : ∃ χ₀' : MvPolynomial (Fin d ⊕ Fin d × Fin r) A →+* Λ,
        (∀ x, χ₀' (MvPolynomial.C x) = φ x) ∧
        ∀ s, χ₀' (MvPolynomial.X s) = Sum.elim
          (fun i => algebraMap (MvPolynomial (Fin d) k) Λ (MvPolynomial.X i))
          (fun p => μ p.1 p.2) s :=
      ⟨MvPolynomial.eval₂Hom (φ : A →+* Λ) _, fun x => MvPolynomial.eval₂Hom_C _ _ _,
        fun s => MvPolynomial.eval₂Hom_X' _ _ _⟩
    have hχg : ∀ i, χ₀' (g i) = 0 := by
      intro i
      rw [hg]
      simp only [map_sub, map_pow, map_sum, map_mul, hχC, hχX, Sum.elim_inl, Sum.elim_inr]
      rw [hμ i]
      exact sub_self _
    have hIk : I ≤ RingHom.ker χ₀' := by
      rw [hI, Ideal.span_le]
      rintro _ ⟨i, rfl⟩
      exact RingHom.mem_ker.mpr (hχg i)
    obtain ⟨χ₀, hχ₀⟩ : ∃ χ₀ : (MvPolynomial (Fin d ⊕ Fin d × Fin r) A ⧸ I) →+* Λ,
        ∀ x, χ₀ (Ideal.Quotient.mk I x) = χ₀' x :=
      ⟨Ideal.Quotient.lift I χ₀' (fun x hx => RingHom.mem_ker.mp (hIk hx)),
        fun x => Ideal.Quotient.lift_mk I χ₀' _⟩
    have hlin : χ₀.comp (algebraMap (MvPolynomial (Fin d) k)
        (MvPolynomial (Fin d ⊕ Fin d × Fin r) A ⧸ I)) =
        algebraMap (MvPolynomial (Fin d) k) Λ := by
      apply MvPolynomial.ringHom_ext
      · intro c
        rw [RingHom.comp_apply, hCB, hχ₀, hχC, AlgHom.commutes,
          IsScalarTower.algebraMap_apply k (MvPolynomial (Fin d) k) Λ, MvPolynomial.algebraMap_eq]
      · intro i
        rw [RingHom.comp_apply, hXB, hχ₀, hχX, Sum.elim_inl]
    refine ⟨{ toRingHom := χ₀, commutes' := fun p => DFunLike.congr_fun hlin p }, fun x => ?_⟩
    show χ₀ (ι x) = φ x
    rw [hι, hχ₀, hχC]

theorem wc_pfc_cz_monomial_annihilator : ∀ (k : Type u) [Field k] (d e : ℕ) (i : Fin d) (y : MvPolynomial (Fin d) k), MvPolynomial.X i ^ 2 * y ∈ Ideal.span ((fun j => (MvPolynomial.X j : MvPolynomial (Fin d) k) ^ e) '' {j | j < i}) → MvPolynomial.X i * y ∈ Ideal.span ((fun j => (MvPolynomial.X j : MvPolynomial (Fin d) k) ^ e) '' {j | j < i}) :=
by
  intro k _ d e i y h
  have hset : ((fun j => (MvPolynomial.X j : MvPolynomial (Fin d) k) ^ e) '' {j | j < i}) =
      (fun s => MvPolynomial.monomial s (1 : k)) '' ((fun j => Finsupp.single j e) '' {j | j < i}) := by
    rw [Set.image_image]
    congr 1
    funext j
    exact MvPolynomial.X_pow_eq_monomial
  rw [hset, MvPolynomial.mem_ideal_span_monomial_image] at h ⊢
  intro m hm
  have hm' : Finsupp.single i 1 + m ∈ (MvPolynomial.X i * (MvPolynomial.X i * y)).support := by
    rw [MvPolynomial.support_X_mul]
    exact Finset.mem_map_of_mem _ hm
  rw [← mul_assoc, ← pow_two] at hm'
  obtain ⟨s, ⟨j, hj, rfl⟩, hle⟩ := h _ hm'
  refine ⟨Finsupp.single j e, ⟨j, hj, rfl⟩, ?_⟩
  have hji : j ≠ i := ne_of_lt hj
  rw [Finsupp.single_le_iff] at hle ⊢
  have h0 : (Finsupp.single i 1 : Fin d →₀ ℕ) j = 0 := by
    rw [Finsupp.single_apply, if_neg hji.symm]
  rw [Finsupp.add_apply, h0, zero_add] at hle
  exact hle

theorem wc_pfc_lmp_elkik_presentation : ∀ (R : Type u) [CommRing R] [IsNoetherianRing R] (A : Type u) [CommRing A] [Algebra R A] [Algebra.FinitePresentation R A], ∃ (C : Type u) (_ : CommRing C) (_ : Algebra R C) (_ : Algebra.FinitePresentation R C) (ι : A →ₐ[R] C) (ρ : C →ₐ[R] A), ρ.comp ι = AlgHom.id R A ∧ ∀ a : A, Algebra.Smooth R (Localization.Away a) → Algebra.Smooth R (Localization.Away (ι a)) ∧ Module.Free (Localization.Away (ι a)) (Ω[Localization.Away (ι a)⁄R]) :=
by
  have wc_pfc_elk_localize_resolution : ∀ (A : Type u) [CommRing A] (M : Type u) [AddCommGroup M] [Module A M] (n s t : ℕ) (π : (Fin n → A) →ₗ[A] M) (ν : Fin s → Fin n → A) (κ : Fin t → Fin s → A), Function.Surjective π → (∀ x : Fin n → A, π x = 0 ↔ ∃ c : Fin s → A, ∑ j, c j • ν j = x) → (∀ c : Fin s → A, ∑ j, c j • ν j = 0 ↔ ∃ d : Fin t → A, ∑ k, d k • κ k = c) → ∀ (a : A) (M' : Type u) [AddCommGroup M'] [Module A M'] [Module (Localization.Away a) M'] [IsScalarTower A (Localization.Away a) M'] (f : M →ₗ[A] M'), IsLocalizedModule (Submonoid.powers a) f → ∃ π' : (Fin n → Localization.Away a) →ₗ[Localization.Away a] M', Function.Surjective π' ∧ (∀ y : Fin n → Localization.Away a, π' y = 0 ↔ ∃ c : Fin s → Localization.Away a, ∑ j, c j • (fun i => algebraMap A (Localization.Away a) (ν j i)) = y) ∧ (∀ c : Fin s → Localization.Away a, ∑ j, c j • (fun i => algebraMap A (Localization.Away a) (ν j i)) = 0 ↔ ∃ d : Fin t → Localization.Away a, ∑ k, d k • (fun j => algebraMap A (Localization.Away a) (κ k j)) = c) := by
    intro A _ M _ _ n s t π ν κ hπ hν hκ a M' _ _ _ _ f hf
    classical
    set S := Localization.Away a
    let mp : ∀ {m : ℕ}, (Fin m → A) → (Fin m → S) := fun x i => algebraMap A S (x i)
    have mp_sum : ∀ {m r : ℕ} (c : Fin r → A) (v : Fin r → Fin m → A),
        mp (∑ j, c j • v j) = ∑ j, algebraMap A S (c j) • mp (v j) := by
      intro m r c v
      ext i
      simp [mp, Finset.sum_apply, map_sum, map_mul, Algebra.smul_def]
    have mp_smul : ∀ {m : ℕ} (b : A) (x : Fin m → A), mp (b • x) = algebraMap A S b • mp x := by
      intro m b x
      ext i
      simp [mp, map_mul]
    have mp_zero : ∀ {m : ℕ}, mp (0 : Fin m → A) = 0 := by
      intro m; ext i; simp [mp]
    have hu : IsUnit (algebraMap A S a) := IsLocalization.Away.algebraMap_isUnit a
    have hinv : ∀ m : ℕ, ((hu.unit⁻¹ ^ m : Sˣ) : S) * algebraMap A S a ^ m = 1 := by
      intro m
      rw [Units.val_pow_eq_pow_val, ← mul_pow, hu.val_inv_mul, one_pow]

    have hD : ∀ {m : ℕ} (y : Fin m → S), ∃ k : ℕ, ∃ x : Fin m → A,
        algebraMap A S a ^ k • y = mp x := by
      intro m y
      obtain ⟨⟨b, hb⟩, hb'⟩ := IsLocalization.exist_integer_multiples (Submonoid.powers a)
        (Finset.univ : Finset (Fin m)) y
      obtain ⟨k, rfl⟩ := hb
      choose x hx using fun i => hb' i (Finset.mem_univ i)
      refine ⟨k, x, ?_⟩
      ext i
      simp only [Pi.smul_apply, smul_eq_mul, mp]
      rw [hx i, Algebra.smul_def, map_pow]

    have hZ : ∀ {m : ℕ} (w : Fin m → A), mp w = 0 → ∃ N : ℕ, a ^ N • w = 0 := by
      intro m w hw
      have h1 : ∀ i, ∃ c : Submonoid.powers a, (c : A) * w i = 0 := fun i =>
        (IsLocalization.map_eq_zero_iff (Submonoid.powers a) S (w i)).mp (congr_fun hw i)
      choose c hc using h1
      have hp : (∏ i, (c i : A)) ∈ Submonoid.powers a :=
        Submonoid.prod_mem _ (fun i _ => (c i).2)
      obtain ⟨N, hN⟩ := hp
      refine ⟨N, ?_⟩
      ext i
      obtain ⟨r, hr⟩ := Finset.dvd_prod_of_mem (fun j => (c j : A)) (Finset.mem_univ i)
      simp only [Pi.smul_apply, smul_eq_mul, Pi.zero_apply]
      have hN' : a ^ N = ∏ i, (c i : A) := hN
      rw [hN', hr]
      calc (c i : A) * r * w i = r * ((c i : A) * w i) := by ring
        _ = 0 := by rw [hc i, mul_zero]
    let π' : (Fin n → S) →ₗ[S] M' := Fintype.linearCombination S (fun i => f (π (Pi.single i 1)))
    have hK : ∀ x : Fin n → A, π' (mp x) = f (π x) := by
      intro x
      have hx : x = ∑ i, x i • (Pi.single i 1 : Fin n → A) := by
        ext j; simp [Finset.sum_apply, Pi.single_apply]
      simp only [π', Fintype.linearCombination_apply, mp, algebraMap_smul]
      conv_rhs => rw [hx]
      rw [map_sum, map_sum]
      simp only [map_smul]
    let ν' : Fin s → Fin n → S := fun j => mp (ν j)
    let κ' : Fin t → Fin s → S := fun k => mp (κ k)
    let θ' : (Fin s → S) →ₗ[S] (Fin n → S) := Fintype.linearCombination S ν'
    have hθ' : ∀ c, θ' c = ∑ j, c j • ν' j := fun c => Fintype.linearCombination_apply S ν' c
    have hπν : ∀ j, π (ν j) = 0 := fun j =>
      (hν (ν j)).mpr ⟨Pi.single j 1, by simp [Pi.single_apply]⟩
    have hνκ : ∀ k, ∑ j, κ k j • ν j = 0 := fun k =>
      (hκ (κ k)).mpr ⟨Pi.single k 1, by simp [Pi.single_apply]⟩
    refine ⟨π', ?_, ?_, ?_⟩
    ·
      intro m'
      obtain ⟨⟨m, ⟨b, hb⟩⟩, hm⟩ := IsLocalizedModule.surj (Submonoid.powers a) f m'
      obtain ⟨k, rfl⟩ := hb
      obtain ⟨p, rfl⟩ := hπ m
      refine ⟨((hu.unit⁻¹ ^ k : Sˣ) : S) • mp p, ?_⟩
      rw [map_smul, hK]
      have hm' : a ^ k • m' = f (π p) := hm
      rw [← hm', ← algebraMap_smul S (a ^ k) m', smul_smul, map_pow, hinv, one_smul]
    · intro y
      constructor
      · intro hy
        obtain ⟨k, x, hx⟩ := hD y
        have h1 : f (π x) = 0 := by
          rw [← hK, ← hx, map_smul, hy, smul_zero]
        obtain ⟨⟨b, hb⟩, hb'⟩ := (IsLocalizedModule.eq_zero_iff (Submonoid.powers a) f).mp h1
        obtain ⟨N, rfl⟩ := hb
        have h2 : π (a ^ N • x) = 0 := by rw [map_smul]; exact hb'
        obtain ⟨d, hd⟩ := (hν _).mp h2
        refine ⟨fun j => ((hu.unit⁻¹ ^ (N + k) : Sˣ) : S) * algebraMap A S (d j), ?_⟩
        have h3 : ∑ j, algebraMap A S (d j) • ν' j = algebraMap A S a ^ (N + k) • y := by
          rw [← mp_sum, hd, mp_smul, ← hx, smul_smul, map_pow, ← pow_add]
        simp only [mul_smul]
        rw [← Finset.smul_sum]
        change ((hu.unit⁻¹ ^ (N + k) : Sˣ) : S) • ∑ j, algebraMap A S (d j) • ν' j = y
        rw [h3, smul_smul, hinv, one_smul]
      · rintro ⟨c, rfl⟩
        rw [map_sum]
        refine Finset.sum_eq_zero (fun j _ => ?_)
        rw [map_smul]
        change c j • π' (mp (ν j)) = 0
        rw [hK, hπν, map_zero, smul_zero]
    · intro c
      constructor
      · intro hc
        obtain ⟨k, x, hx⟩ := hD c
        have h1 : mp (∑ j, x j • ν j) = 0 := by
          have hc' : ∑ j, c j • ν' j = 0 := hc
          rw [mp_sum, show (∑ j, algebraMap A S (x j) • mp (ν j)) = θ' (mp x) from (hθ' _).symm,
            ← hx, map_smul, hθ', hc', smul_zero]
        obtain ⟨N, hN⟩ := hZ _ h1
        have h2 : ∑ j, (a ^ N • x) j • ν j = 0 := by
          rw [Finset.smul_sum] at hN
          rw [← hN]
          refine Finset.sum_congr rfl (fun j _ => ?_)
          simp [smul_smul]
        obtain ⟨d, hd⟩ := (hκ _).mp h2
        refine ⟨fun k' => ((hu.unit⁻¹ ^ (N + k) : Sˣ) : S) * algebraMap A S (d k'), ?_⟩
        have h3 : ∑ k', algebraMap A S (d k') • κ' k' = algebraMap A S a ^ (N + k) • c := by
          rw [← mp_sum, hd, mp_smul, ← hx, smul_smul, map_pow, ← pow_add]
        simp only [mul_smul]
        rw [← Finset.smul_sum]
        change ((hu.unit⁻¹ ^ (N + k) : Sˣ) : S) • ∑ k', algebraMap A S (d k') • κ' k' = c
        rw [h3, smul_smul, hinv, one_smul]
      · rintro ⟨d, rfl⟩
        rw [← hθ', map_sum]
        refine Finset.sum_eq_zero (fun k _ => ?_)
        rw [map_smul, hθ']
        change d k • ∑ j, algebraMap A S (κ k j) • mp (ν j) = 0
        rw [← mp_sum, hνκ, mp_zero, smul_zero]
  have wc_pfc_elk_split_projective : ∀ (S : Type u) [CommRing S] (M : Type u) [AddCommGroup M] [Module S M] [Module.Projective S M] (n s t : ℕ) (π : (Fin n → S) →ₗ[S] M) (ν : Fin s → Fin n → S) (κ : Fin t → Fin s → S), Function.Surjective π → (∀ y : Fin n → S, π y = 0 ↔ ∃ c : Fin s → S, ∑ j, c j • ν j = y) → (∀ c : Fin s → S, ∑ j, c j • ν j = 0 ↔ ∃ d : Fin t → S, ∑ k, d k • κ k = c) → Module.Projective S ((Fin s → S) ⧸ Submodule.span S (Set.range κ)) ∧ Nonempty ((M × ((Fin s → S) ⧸ Submodule.span S (Set.range κ))) ≃ₗ[S] (Fin n → S)) := by
    intro S _ M _ _ _ n s t π ν κ hπ hν hκ
    let θ := Fintype.linearCombination S ν
    have hker : Submodule.span S (Set.range κ) = LinearMap.ker θ := by
      ext c
      rw [Submodule.mem_span_range_iff_exists_fun, LinearMap.mem_ker, Fintype.linearCombination_apply, hκ]
    have hrange : LinearMap.range θ = LinearMap.ker π := by
      ext y
      rw [LinearMap.mem_range, LinearMap.mem_ker, hν]
      simp only [θ, Fintype.linearCombination_apply]
    let ε : ((Fin s → S) ⧸ Submodule.span S (Set.range κ)) ≃ₗ[S] LinearMap.ker π :=
      (Submodule.quotEquivOfEq _ _ hker).trans ((LinearMap.quotKerEquivRange θ).trans
        (LinearEquiv.ofEq _ _ hrange))
    obtain ⟨σ, hσ⟩ := LinearMap.exists_rightInverse_of_surjective π (LinearMap.range_eq_top.mpr hπ)
    have hσx : ∀ m, π (σ m) = m := fun m => LinearMap.congr_fun hσ m
    let p : (Fin n → S) →ₗ[S] LinearMap.ker π :=
      (LinearMap.id - σ ∘ₗ π).codRestrict (LinearMap.ker π) (fun x => by
        simp [hσx])
    have hp : p ∘ₗ (LinearMap.ker π).subtype = LinearMap.id := by
      ext ⟨k, hk⟩ : 1
      apply Subtype.ext
      simp [p, LinearMap.mem_ker.mp hk]
    haveI : Module.Projective S (LinearMap.ker π) := Module.Projective.of_split _ p hp
    haveI : Module.Projective S ((Fin s → S) ⧸ Submodule.span S (Set.range κ)) :=
      Module.Projective.of_equiv ε.symm
    refine ⟨inferInstance, ⟨?_⟩⟩
    have hex : Function.Exact (LinearMap.ker π).subtype π := LinearMap.exact_subtype_ker_map π
    let e := ((hex.splitSurjectiveEquiv (Submodule.injective_subtype _)) ⟨σ, hσ⟩).1
    exact (((LinearEquiv.refl S M).prodCongr ε).trans (LinearEquiv.prodComm S M _)).trans e.symm
  have wc_pfc_elk_localization_linear_iso : ∀ (R : Type u) [CommRing R] (A : Type u) [CommRing A] [Algebra R A] (s t : ℕ) (κ : Fin t → Fin s → A) (a : A), Nonempty (Localization.Away (algebraMap A (MvPolynomial (Fin s) A ⧸ Ideal.span (Set.range fun k => ∑ j, MvPolynomial.C (κ k j) * MvPolynomial.X j)) a) ≃ₐ[R] (MvPolynomial (Fin s) (Localization.Away a) ⧸ Ideal.span (Set.range fun k => ∑ j, MvPolynomial.C (algebraMap A (Localization.Away a) (κ k j)) * MvPolynomial.X j))) := by
    intro R _ A _ _ s t κ a
    classical
    set S := Localization.Away a
    set I := Ideal.span (Set.range fun k => ∑ j, MvPolynomial.C (κ k j) *
      (MvPolynomial.X j : MvPolynomial (Fin s) A)) with hI
    set I' := Ideal.span (Set.range fun k => ∑ j, MvPolynomial.C (algebraMap A S (κ k j)) *
      (MvPolynomial.X j : MvPolynomial (Fin s) S)) with hI'
    set C := MvPolynomial (Fin s) A ⧸ I
    set C' := MvPolynomial (Fin s) S ⧸ I'
    set L := Localization.Away (algebraMap A C a)

    let f₀ : MvPolynomial (Fin s) A →+* C' :=
      (Ideal.Quotient.mk I').comp (MvPolynomial.map (algebraMap A S))
    have hf₀ : ∀ p ∈ I, f₀ p = 0 := by
      have hle : I ≤ RingHom.ker f₀ := by
        rw [hI, Ideal.span_le]
        rintro _ ⟨k, rfl⟩
        rw [SetLike.mem_coe, RingHom.mem_ker]
        change Ideal.Quotient.mk I' (MvPolynomial.map (algebraMap A S) _) = 0
        rw [Ideal.Quotient.eq_zero_iff_mem]
        simp only [map_sum, map_mul, MvPolynomial.map_C, MvPolynomial.map_X]
        exact Ideal.subset_span ⟨k, rfl⟩
      exact fun p hp => hle hp
    let f₁ : C →+* C' := Ideal.Quotient.lift I f₀ hf₀
    have hf₁C : ∀ x : A, f₁ (algebraMap A C x) = Ideal.Quotient.mk I' (MvPolynomial.C (algebraMap A S x)) := by
      intro x
      rw [← Ideal.Quotient.mk_algebraMap, MvPolynomial.algebraMap_eq]
      rw [Ideal.Quotient.lift_mk]
      simp [f₀]
    have hf₁X : ∀ j, f₁ (Ideal.Quotient.mk I (MvPolynomial.X j)) = Ideal.Quotient.mk I' (MvPolynomial.X j) := by
      intro j
      rw [Ideal.Quotient.lift_mk]
      simp [f₀]
    have hunit : IsUnit (f₁ (algebraMap A C a)) := by
      rw [hf₁C]
      exact (IsLocalization.Away.algebraMap_isUnit a).map ((Ideal.Quotient.mk I').comp MvPolynomial.C)
    let F := @IsLocalization.Away.lift C _ L _ _ C' _ (algebraMap A C a) _ f₁ hunit
    have hF : ∀ c : C, F (algebraMap C L c) = f₁ c := fun c => IsLocalization.Away.lift_eq _ hunit c

    have hunitL : IsUnit (algebraMap A L a) := by
      rw [IsScalarTower.algebraMap_apply A C L]
      exact IsLocalization.Away.algebraMap_isUnit _
    let g₀ := @IsLocalization.Away.lift A _ S _ _ L _ a _ (algebraMap A L) hunitL
    have hg₀ : ∀ x : A, g₀ (algebraMap A S x) = algebraMap A L x := fun x => IsLocalization.Away.lift_eq _ hunitL x
    let g₁ : MvPolynomial (Fin s) S →+* L :=
      MvPolynomial.eval₂Hom g₀ (fun j => algebraMap C L (Ideal.Quotient.mk I (MvPolynomial.X j)))
    have hg₁ : ∀ p ∈ I', g₁ p = 0 := by
      have hle : I' ≤ RingHom.ker g₁ := by
        rw [hI', Ideal.span_le]
        rintro _ ⟨k, rfl⟩
        rw [SetLike.mem_coe, RingHom.mem_ker]
        have h0 : Ideal.Quotient.mk I (∑ j, MvPolynomial.C (κ k j) * MvPolynomial.X j) = 0 :=
          Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨k, rfl⟩)
        calc g₁ (∑ j, MvPolynomial.C (algebraMap A S (κ k j)) * MvPolynomial.X j)
            = algebraMap C L (Ideal.Quotient.mk I
                (∑ j, MvPolynomial.C (κ k j) * MvPolynomial.X j)) := by
              simp only [g₁, MvPolynomial.coe_eval₂Hom, MvPolynomial.eval₂_sum, MvPolynomial.eval₂_mul,
                MvPolynomial.eval₂_C, MvPolynomial.eval₂_X, map_sum, map_mul]
              refine Finset.sum_congr rfl (fun j _ => ?_)
              rw [hg₀, IsScalarTower.algebraMap_apply A C L]
              rfl
          _ = 0 := by rw [h0, map_zero]
      exact fun p hp => hle hp
    let G : C' →+* L := Ideal.Quotient.lift I' g₁ hg₁
    have hGC : ∀ σ : S, G (Ideal.Quotient.mk I' (MvPolynomial.C σ)) = g₀ σ := by
      intro σ; rw [Ideal.Quotient.lift_mk]; simp [g₁]
    have hGX : ∀ j, G (Ideal.Quotient.mk I' (MvPolynomial.X j)) =
        algebraMap C L (Ideal.Quotient.mk I (MvPolynomial.X j)) := by
      intro j; rw [Ideal.Quotient.lift_mk]; simp [g₁]
    have hGF : G.comp F = RingHom.id L := by
      apply IsLocalization.ringHom_ext (Submonoid.powers (algebraMap A C a))
      apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext
      · intro x
        simp only [RingHom.comp_apply, RingHom.id_apply]
        rw [hF]
        have e : Ideal.Quotient.mk I (MvPolynomial.C x) = algebraMap A C x := by
          rw [← Ideal.Quotient.mk_algebraMap, MvPolynomial.algebraMap_eq]
        rw [e, hf₁C, hGC, hg₀, IsScalarTower.algebraMap_apply A C L]
      · intro j
        simp only [RingHom.comp_apply, RingHom.id_apply]
        rw [hF, hf₁X, hGX]
    have hFG : F.comp G = RingHom.id C' := by
      apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext
      · intro σ
        simp only [RingHom.comp_apply, RingHom.id_apply]
        rw [hGC]
        have : F.comp g₀ = (Ideal.Quotient.mk I').comp MvPolynomial.C := by
          apply IsLocalization.ringHom_ext (Submonoid.powers a)
          ext x
          simp only [RingHom.comp_apply]
          rw [hg₀, IsScalarTower.algebraMap_apply A C L, hF, hf₁C]
        exact congrArg (fun φ => φ σ) this
      · intro j
        simp only [RingHom.comp_apply, RingHom.id_apply]
        rw [hGX, hF, hf₁X]
        rfl
    let e : L ≃+* C' := RingEquiv.ofRingHom F G hFG hGF
    refine ⟨AlgEquiv.ofRingEquiv (f := e) (fun r => ?_)⟩
    show F (algebraMap R L r) = algebraMap R C' r
    rw [IsScalarTower.algebraMap_apply R C L, IsScalarTower.algebraMap_apply R A C, hF, hf₁C,
      IsScalarTower.algebraMap_apply R S C', IsScalarTower.algebraMap_apply R A S,
      ← Ideal.Quotient.mk_algebraMap, MvPolynomial.algebraMap_eq]
  have wc_pfc_elk_transport_smooth_free : ∀ (R : Type u) [CommRing R] (B : Type u) [CommRing B] [Algebra R B] (B' : Type u) [CommRing B'] [Algebra R B'], (B ≃ₐ[R] B') → Algebra.Smooth R B' → Module.Free B' Ω[B'⁄R] → Algebra.Smooth R B ∧ Module.Free B Ω[B⁄R] := by
    intro R _ B _ _ B' _ _ e hsm hfr
    refine ⟨Algebra.Smooth.of_equiv e.symm, ?_⟩
    letI : Algebra B' B := e.symm.toRingHom.toAlgebra
    haveI : IsScalarTower R B' B := IsScalarTower.of_algebraMap_eq (fun x => (e.symm.commutes x).symm)
    let e' : B' ≃ₐ[B'] B := AlgEquiv.ofRingEquiv (f := e.symm.toRingEquiv) (fun x => rfl)
    haveI : Algebra.FormallyEtale B' B := Algebra.FormallyEtale.of_equiv e'
    exact Module.Free.of_equiv (KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale R B' B)
  have wc_pfc_elk_linear_formally_smooth : ∀ (S : Type u) [CommRing S] (s t : ℕ) (κ : Fin t → Fin s → S), Module.Projective S ((Fin s → S) ⧸ Submodule.span S (Set.range κ)) → Algebra.FormallySmooth S (MvPolynomial (Fin s) S ⧸ Ideal.span (Set.range fun k => ∑ j, MvPolynomial.C (κ k j) * MvPolynomial.X j)) := by
    intro S _ s t κ hQ
    classical
    set L := Submodule.span S (Set.range κ) with hL
    set I := Ideal.span (Set.range fun k => ∑ j, MvPolynomial.C (κ k j) *
      (MvPolynomial.X j : MvPolynomial (Fin s) S)) with hI
    obtain ⟨σ, hσ⟩ := LinearMap.exists_rightInverse_of_surjective L.mkQ (Submodule.range_mkQ L)
    have hσx : ∀ q, L.mkQ (σ q) = q := fun q => LinearMap.congr_fun hσ q
    let lin : (Fin s → S) →ₗ[S] MvPolynomial (Fin s) S :=
      Fintype.linearCombination S (fun i => MvPolynomial.X i)
    have hlin : ∀ c, lin c = ∑ i, MvPolynomial.C (c i) * MvPolynomial.X i := by
      intro c
      simp only [lin, Fintype.linearCombination_apply, MvPolynomial.C_mul']
    let αt : MvPolynomial (Fin s) S →ₐ[S] MvPolynomial (Fin s) S :=
      MvPolynomial.aeval (fun j => lin (σ (L.mkQ (Pi.single j 1))))
    have hαlin : αt.toLinearMap ∘ₗ lin = lin ∘ₗ σ ∘ₗ L.mkQ := by
      ext j
      simp [lin, αt, Fintype.linearCombination_apply_single]
    have hαlin' : ∀ c, αt (lin c) = lin (σ (L.mkQ c)) := fun c => LinearMap.congr_fun hαlin c
    have hκL : ∀ k, κ k ∈ L := fun k => Submodule.subset_span ⟨k, rfl⟩
    have hαI : ∀ p ∈ I, αt p = 0 := by
      have hle : I ≤ RingHom.ker αt := by
        rw [hI, Ideal.span_le]
        rintro _ ⟨k, rfl⟩
        show αt (∑ j, MvPolynomial.C (κ k j) * MvPolynomial.X j) = 0
        rw [← hlin (κ k), hαlin']
        have h0 : L.mkQ (κ k) = 0 := (Submodule.Quotient.mk_eq_zero L).mpr (hκL k)
        rw [h0, map_zero, map_zero]
      exact fun p hp => hle hp
    let α := Ideal.Quotient.liftₐ I αt hαI
    have hlinL : ∀ c ∈ L, lin c ∈ I := by
      intro c hc
      induction hc using Submodule.span_induction with
      | mem x hx =>
        obtain ⟨k, rfl⟩ := hx
        rw [hlin]
        exact Ideal.subset_span ⟨k, rfl⟩
      | zero => rw [map_zero]; exact I.zero_mem
      | add x y _ _ hx hy => rw [map_add]; exact I.add_mem hx hy
      | smul r x _ hx =>
        rw [map_smul, Algebra.smul_def]
        exact I.mul_mem_left _ hx
    have hβα : (Ideal.Quotient.mkₐ S I).comp α = AlgHom.id S _ := by
      apply Ideal.Quotient.algHom_ext
      apply MvPolynomial.algHom_ext
      intro j
      simp only [AlgHom.comp_apply, AlgHom.id_apply, α, Ideal.Quotient.mkₐ_eq_mk,
        Ideal.Quotient.liftₐ_apply, Ideal.Quotient.lift_mk]
      rw [Ideal.Quotient.eq]
      show αt (MvPolynomial.X j) - MvPolynomial.X j ∈ I
      have e1 : αt (MvPolynomial.X j) = lin (σ (L.mkQ (Pi.single j 1))) := by
        simp [αt]
      have e2 : (MvPolynomial.X j : MvPolynomial (Fin s) S) = lin (Pi.single j 1) := by
        simp [lin, Fintype.linearCombination_apply_single]
      rw [e1, e2, ← map_sub]
      apply hlinL
      rw [← Submodule.Quotient.mk_eq_zero L, Submodule.Quotient.mk_sub]
      exact sub_eq_zero.mpr (hσx _)
    refine Algebra.FormallySmooth.of_comp_surjective (fun B _ _ J hJ g => ?_)
    obtain ⟨h, hh⟩ := Algebra.FormallySmooth.comp_surjective S (MvPolynomial (Fin s) S) J hJ
      (g.comp (Ideal.Quotient.mkₐ S I))
    refine ⟨h.comp α, ?_⟩
    rw [← AlgHom.comp_assoc, hh, AlgHom.comp_assoc, hβα, AlgHom.comp_id]
  have wc_pfc_elk_linear_kaehler : ∀ (S : Type u) [CommRing S] (s t : ℕ) (κ : Fin t → Fin s → S), Nonempty (Ω[(MvPolynomial (Fin s) S ⧸ Ideal.span (Set.range fun k => ∑ j, MvPolynomial.C (κ k j) * MvPolynomial.X j))⁄S] ≃ₗ[MvPolynomial (Fin s) S ⧸ Ideal.span (Set.range fun k => ∑ j, MvPolynomial.C (κ k j) * MvPolynomial.X j)] TensorProduct S (MvPolynomial (Fin s) S ⧸ Ideal.span (Set.range fun k => ∑ j, MvPolynomial.C (κ k j) * MvPolynomial.X j)) ((Fin s → S) ⧸ Submodule.span S (Set.range κ))) := by
    intro S _ s t κ
    classical
    set L := Submodule.span S (Set.range κ) with hL
    set I := Ideal.span (Set.range fun k => ∑ j, MvPolynomial.C (κ k j) *
      (MvPolynomial.X j : MvPolynomial (Fin s) S)) with hI
    set P := MvPolynomial (Fin s) S
    set T := P ⧸ I
    let lin : (Fin s → S) →ₗ[S] P := Fintype.linearCombination S (fun i => MvPolynomial.X i)
    have hlin : ∀ c, lin c = ∑ i, MvPolynomial.C (c i) * MvPolynomial.X i := by
      intro c
      simp only [lin, Fintype.linearCombination_apply]
      exact Finset.sum_congr rfl (fun i _ => MvPolynomial.smul_eq_C_mul _ _)
    have hlinκ : ∀ k, lin (κ k) ∈ I := fun k => by rw [hlin]; exact Ideal.subset_span ⟨k, rfl⟩
    have hlinX : ∀ j, lin (Pi.single j 1) = MvPolynomial.X j := by
      intro j; simp [lin, Fintype.linearCombination_apply_single]

    let ψ₀ : (Fin s → S) →ₗ[S] Ω[T⁄S] :=
      (KaehlerDifferential.D S T).toLinearMap ∘ₗ (Ideal.Quotient.mkₐ S I).toLinearMap ∘ₗ lin
    have hψ₀ : L ≤ LinearMap.ker ψ₀ := by
      rw [hL, Submodule.span_le]
      rintro _ ⟨k, rfl⟩
      rw [SetLike.mem_coe, LinearMap.mem_ker]
      show KaehlerDifferential.D S T (Ideal.Quotient.mkₐ S I (lin (κ k))) = 0
      rw [Ideal.Quotient.mkₐ_eq_mk, Ideal.Quotient.eq_zero_iff_mem.mpr (hlinκ k)]
      exact (KaehlerDifferential.D S T).map_zero
    let ψ : ((Fin s → S) ⧸ L) →ₗ[S] Ω[T⁄S] := L.liftQ ψ₀ hψ₀
    have hψq : ∀ c, ψ (L.mkQ c) = KaehlerDifferential.D S T (Ideal.Quotient.mk I (lin c)) :=
      fun c => rfl
    let Ψ : TensorProduct S T ((Fin s → S) ⧸ L) →ₗ[T] Ω[T⁄S] := LinearMap.liftBaseChange T ψ

    let δt : Derivation S P (TensorProduct S T ((Fin s → S) ⧸ L)) :=
      MvPolynomial.mkDerivation S (fun j => (1 : T) ⊗ₜ[S] L.mkQ (Pi.single j 1))
    have hδX : ∀ j, δt (MvPolynomial.X j) = (1 : T) ⊗ₜ[S] L.mkQ (Pi.single j 1) :=
      fun j => MvPolynomial.mkDerivation_X S _ j
    have hδlin' : ∀ c, δt (lin c) = (1 : T) ⊗ₜ[S] L.mkQ c := by
      intro c
      have hc : c = ∑ i, c i • (Pi.single i 1 : Fin s → S) := by
        ext j; simp [Finset.sum_apply, Pi.single_apply]
      conv_rhs => rw [hc]
      simp only [lin, Fintype.linearCombination_apply, map_sum, map_smul, hδX,
        TensorProduct.tmul_sum, TensorProduct.tmul_smul]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [Derivation.map_smul, hδX]
    have hsmul0 : ∀ x ∈ I, ∀ n : TensorProduct S T ((Fin s → S) ⧸ L), x • n = 0 := by
      intro x hx n
      rw [← algebraMap_smul T x n, Ideal.Quotient.algebraMap_eq,
        Ideal.Quotient.eq_zero_iff_mem.mpr hx]
      exact zero_smul T n
    have hδI : ∀ p ∈ I, δt p = 0 := by
      intro p hp
      induction hp using Submodule.span_induction with
      | mem x hx =>
        obtain ⟨k, rfl⟩ := hx
        show δt (∑ j, MvPolynomial.C (κ k j) * MvPolynomial.X j) = 0
        rw [← hlin, hδlin']
        have h0 : L.mkQ (κ k) = 0 :=
          (Submodule.Quotient.mk_eq_zero L).mpr (Submodule.subset_span ⟨k, rfl⟩)
        rw [h0, TensorProduct.tmul_zero]
      | zero => exact δt.map_zero
      | add x y _ _ hx hy => rw [map_add, hx, hy, add_zero]
      | smul r x hxI hx =>
        rw [smul_eq_mul, Derivation.leibniz, hx, smul_zero, zero_add]
        exact hsmul0 x hxI _
    let D0 : P →ₗ[S] TensorProduct S T ((Fin s → S) ⧸ L) := δt
    have hD0 : I.restrictScalars S ≤ LinearMap.ker D0 := fun p hp => hδI p hp
    let Dq : T →ₗ[S] TensorProduct S T ((Fin s → S) ⧸ L) :=
      ((I.restrictScalars S).liftQ D0 hD0) ∘ₗ
        (Submodule.Quotient.restrictScalarsEquiv S I).symm.toLinearMap
    have hDq : ∀ p : P, Dq (Ideal.Quotient.mk I p) = δt p := by
      intro p
      have e : (Submodule.Quotient.restrictScalarsEquiv S I).symm (Submodule.Quotient.mk p) =
          Submodule.Quotient.mk p :=
        (LinearEquiv.symm_apply_eq _).mpr (Submodule.Quotient.restrictScalarsEquiv_mk S I p).symm
      show (I.restrictScalars S).liftQ D0 hD0
        ((Submodule.Quotient.restrictScalarsEquiv S I).symm (Submodule.Quotient.mk p)) = δt p
      rw [e, Submodule.liftQ_apply]
      rfl
    have hleib : ∀ a b : T, Dq (a * b) = a • Dq b + b • Dq a := by
      intro a b
      obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective a
      obtain ⟨q, rfl⟩ := Ideal.Quotient.mk_surjective b
      rw [← map_mul, hDq, hDq, hDq, Derivation.leibniz]
      rw [← algebraMap_smul T p, ← algebraMap_smul T q, Ideal.Quotient.algebraMap_eq]
    let δ : Derivation S T (TensorProduct S T ((Fin s → S) ⧸ L)) := Derivation.mk' Dq hleib
    have hδ : ∀ p, δ (Ideal.Quotient.mk I p) = δt p := fun p => hDq p
    let Φ : Ω[T⁄S] →ₗ[T] TensorProduct S T ((Fin s → S) ⧸ L) := δ.liftKaehlerDifferential
    have hΦD : ∀ x, Φ (KaehlerDifferential.D S T x) = δ x :=
      fun x => Derivation.liftKaehlerDifferential_comp_D δ x
    have hΦψ : ∀ q, Φ (ψ q) = (1 : T) ⊗ₜ[S] q := by
      intro q
      obtain ⟨c, rfl⟩ := L.mkQ_surjective q
      rw [hψq, hΦD, hδ, hδlin']
    have h1 : Φ ∘ₗ Ψ = LinearMap.id := by
      apply TensorProduct.AlgebraTensorModule.ext
      intro x y
      rw [LinearMap.comp_apply, LinearMap.liftBaseChange_tmul, map_smul, hΦψ,
        TensorProduct.smul_tmul', smul_eq_mul, mul_one, LinearMap.id_apply]
    have hadj : Algebra.adjoin S (Set.range fun j => Ideal.Quotient.mk I (MvPolynomial.X j : P)) = ⊤ := by
      have e : (Set.range fun j => Ideal.Quotient.mk I (MvPolynomial.X j : P)) =
          (Ideal.Quotient.mkₐ S I) '' Set.range MvPolynomial.X := by
        rw [← Set.range_comp]; rfl
      rw [e, Algebra.adjoin_image, MvPolynomial.adjoin_range_X, Algebra.map_top,
        AlgHom.range_eq_top]
      exact Ideal.Quotient.mkₐ_surjective S I
    have h2 : Ψ ∘ₗ Φ = LinearMap.id := by
      apply Derivation.liftKaehlerDifferential_unique
      apply Derivation.ext_of_adjoin_eq_top _ hadj
      rintro _ ⟨j, rfl⟩
      show Ψ (Φ (KaehlerDifferential.D S T _)) = KaehlerDifferential.D S T _
      rw [hΦD, hδ, ← hlinX j, hδlin', LinearMap.liftBaseChange_tmul, one_smul, hψq, hlinX]
    exact ⟨LinearEquiv.ofLinear Φ Ψ h1 h2⟩
  have wc_pfc_elk_free_kaehler_tower : ∀ (R : Type u) [CommRing R] (S : Type u) [CommRing S] [Algebra R S] (T : Type u) [CommRing T] [Algebra R T] [Algebra S T] [IsScalarTower R S T] [Algebra.FormallySmooth S T] (N : Type u) [AddCommGroup N] [Module S N] (n : ℕ), Nonempty (Ω[T⁄S] ≃ₗ[T] TensorProduct S T N) → Nonempty ((Ω[S⁄R] × N) ≃ₗ[S] (Fin n → S)) → Module.Free T Ω[T⁄R] := by
    intro R _ S _ _ T _ _ _ _ _ N _ _ n ⟨eΩ⟩ ⟨eN⟩
    have hex := KaehlerDifferential.exact_mapBaseChange_map R S T
    have hinj : Function.Injective (KaehlerDifferential.mapBaseChange R S T) := by
      rw [injective_iff_map_eq_zero]
      intro x hx
      haveI : Subsingleton (Algebra.H1Cotangent S T) := Algebra.FormallySmooth.subsingleton_h1Cotangent
      obtain ⟨y, rfl⟩ := (Algebra.H1Cotangent.exact_δ_mapBaseChange R S T x).mp hx
      rw [Subsingleton.elim y 0, map_zero]
    haveI : Module.Projective S N :=
      Module.Projective.of_split (eN.toLinearMap ∘ₗ LinearMap.inr S _ N)
        (LinearMap.snd S _ N ∘ₗ eN.symm.toLinearMap) (by ext x; simp)
    haveI : Module.Projective T Ω[T⁄S] := Module.Projective.of_equiv eΩ.symm
    obtain ⟨l, hl⟩ := LinearMap.exists_rightInverse_of_surjective (KaehlerDifferential.map R S T T)
      (LinearMap.range_eq_top.mpr (KaehlerDifferential.map_surjective R S T))
    let e := ((hex.splitSurjectiveEquiv hinj) ⟨l, hl⟩).1
    let e2 := e.trans ((LinearEquiv.refl T _).prodCongr eΩ)
    let e3 := e2.trans (TensorProduct.prodRight S T T Ω[S⁄R] N).symm
    let e4 := e3.trans (LinearEquiv.baseChange S T _ _ eN)
    exact Module.Free.of_equiv e4.symm
  intro R _ _ A _ _ _
  classical
  haveI : IsNoetherianRing A := Algebra.FiniteType.isNoetherianRing R A

  obtain ⟨n, π, hπ⟩ := Module.Finite.exists_fin' A (Ω[A⁄R])
  have hK : (LinearMap.ker π).FG := IsNoetherian.noetherian _
  obtain ⟨s, ν, hνspan⟩ := Submodule.fg_iff_exists_fin_generating_family.mp hK
  have hν : ∀ x : Fin n → A, π x = 0 ↔ ∃ c : Fin s → A, ∑ j, c j • ν j = x := by
    intro x
    rw [← LinearMap.mem_ker, ← hνspan, Submodule.mem_span_range_iff_exists_fun]
  have hK2 : (LinearMap.ker (Fintype.linearCombination A ν)).FG := IsNoetherian.noetherian _
  obtain ⟨t, κ, hκspan⟩ := Submodule.fg_iff_exists_fin_generating_family.mp hK2
  have hκ : ∀ c : Fin s → A, ∑ j, c j • ν j = 0 ↔ ∃ d : Fin t → A, ∑ k, d k • κ k = c := by
    intro c
    rw [← Fintype.linearCombination_apply, ← LinearMap.mem_ker, ← hκspan,
      Submodule.mem_span_range_iff_exists_fun]

  have hIfg : (Ideal.span (Set.range fun k => ∑ j, MvPolynomial.C (κ k j) *
      (MvPolynomial.X j : MvPolynomial (Fin s) A))).FG :=
    Submodule.fg_span (Set.finite_range _)
  haveI fpAC : Algebra.FinitePresentation A (MvPolynomial (Fin s) A ⧸ Ideal.span (Set.range
      fun k => ∑ j, MvPolynomial.C (κ k j) * (MvPolynomial.X j : MvPolynomial (Fin s) A))) :=
    Algebra.FinitePresentation.quotient hIfg
  haveI fpRC : Algebra.FinitePresentation R (MvPolynomial (Fin s) A ⧸ Ideal.span (Set.range
      fun k => ∑ j, MvPolynomial.C (κ k j) * (MvPolynomial.X j : MvPolynomial (Fin s) A))) :=
    Algebra.FinitePresentation.trans R A _
  have hI : ∀ p ∈ Ideal.span (Set.range fun k => ∑ j, MvPolynomial.C (κ k j) *
      (MvPolynomial.X j : MvPolynomial (Fin s) A)),
      MvPolynomial.aeval (R := A) (fun _ : Fin s => (0 : A)) p = 0 := by
    intro p hp
    have hle : Ideal.span (Set.range fun k => ∑ j, MvPolynomial.C (κ k j) *
        (MvPolynomial.X j : MvPolynomial (Fin s) A)) ≤
        RingHom.ker (MvPolynomial.aeval (R := A) (fun _ : Fin s => (0 : A))) := by
      rw [Ideal.span_le]
      rintro _ ⟨k, rfl⟩
      simp
    exact RingHom.mem_ker.mp (hle hp)
  let ρ₀ := Ideal.Quotient.liftₐ (Ideal.span (Set.range fun k => ∑ j, MvPolynomial.C (κ k j) *
      (MvPolynomial.X j : MvPolynomial (Fin s) A))) (MvPolynomial.aeval (fun _ : Fin s => (0 : A))) hI
  refine ⟨MvPolynomial (Fin s) A ⧸ Ideal.span (Set.range fun k => ∑ j, MvPolynomial.C (κ k j) *
      (MvPolynomial.X j : MvPolynomial (Fin s) A)), inferInstance, inferInstance, fpRC,
      IsScalarTower.toAlgHom R A _, ρ₀.restrictScalars R, ?_, ?_⟩
  · ext x
    show ρ₀ (algebraMap A _ x) = x
    rw [AlgHom.commutes]
    rfl
  · intro a ha
    haveI := ha
    obtain ⟨π', hπ', hν', hκ'⟩ := wc_pfc_elk_localize_resolution A (Ω[A⁄R]) n s t π ν κ hπ hν hκ a
      (Ω[Localization.Away a⁄R]) (KaehlerDifferential.map R R A (Localization.Away a))
      (KaehlerDifferential.isLocalizedModule_map R A (Localization.Away a) (Submonoid.powers a))
    obtain ⟨hQ, ⟨eQ⟩⟩ := wc_pfc_elk_split_projective (Localization.Away a)
      (Ω[Localization.Away a⁄R]) n s t π' _ _ hπ' hν' hκ'
    haveI hfs := wc_pfc_elk_linear_formally_smooth (Localization.Away a) s t
      (fun k j => algebraMap A (Localization.Away a) (κ k j)) hQ
    obtain ⟨eΩ⟩ := wc_pfc_elk_linear_kaehler (Localization.Away a) s t
      (fun k j => algebraMap A (Localization.Away a) (κ k j))
    have hfree := wc_pfc_elk_free_kaehler_tower R (Localization.Away a) _ _ n ⟨eΩ⟩ ⟨eQ⟩
    have hIfg' : (Ideal.span (Set.range fun k => ∑ j, MvPolynomial.C
        (algebraMap A (Localization.Away a) (κ k j)) *
        (MvPolynomial.X j : MvPolynomial (Fin s) (Localization.Away a)))).FG :=
      Submodule.fg_span (Set.finite_range _)
    haveI fpSC' : Algebra.FinitePresentation (Localization.Away a) (MvPolynomial (Fin s)
        (Localization.Away a) ⧸ Ideal.span (Set.range fun k => ∑ j, MvPolynomial.C
        (algebraMap A (Localization.Away a) (κ k j)) *
        (MvPolynomial.X j : MvPolynomial (Fin s) (Localization.Away a)))) :=
      Algebra.FinitePresentation.quotient hIfg'
    haveI : Algebra.FormallySmooth R (MvPolynomial (Fin s)
        (Localization.Away a) ⧸ Ideal.span (Set.range fun k => ∑ j, MvPolynomial.C
        (algebraMap A (Localization.Away a) (κ k j)) *
        (MvPolynomial.X j : MvPolynomial (Fin s) (Localization.Away a)))) :=
      Algebra.FormallySmooth.comp R (Localization.Away a) _
    haveI : Algebra.FinitePresentation R (Localization.Away a) := ha.finitePresentation
    haveI : Algebra.FinitePresentation R (MvPolynomial (Fin s)
        (Localization.Away a) ⧸ Ideal.span (Set.range fun k => ∑ j, MvPolynomial.C
        (algebraMap A (Localization.Away a) (κ k j)) *
        (MvPolynomial.X j : MvPolynomial (Fin s) (Localization.Away a)))) :=
      Algebra.FinitePresentation.trans R (Localization.Away a) (MvPolynomial (Fin s)
        (Localization.Away a) ⧸ Ideal.span (Set.range fun k => ∑ j, MvPolynomial.C
        (algebraMap A (Localization.Away a) (κ k j)) *
        (MvPolynomial.X j : MvPolynomial (Fin s) (Localization.Away a))))
    have hsm : Algebra.Smooth R (MvPolynomial (Fin s)
        (Localization.Away a) ⧸ Ideal.span (Set.range fun k => ∑ j, MvPolynomial.C
        (algebraMap A (Localization.Away a) (κ k j)) *
        (MvPolynomial.X j : MvPolynomial (Fin s) (Localization.Away a)))) := Algebra.Smooth.mk
    obtain ⟨e⟩ := wc_pfc_elk_localization_linear_iso R A s t κ a
    have h := wc_pfc_elk_transport_smooth_free R _ (MvPolynomial (Fin s)
        (Localization.Away a) ⧸ Ideal.span (Set.range fun k => ∑ j, MvPolynomial.C
        (algebraMap A (Localization.Away a) (κ k j)) *
        (MvPolynomial.X j : MvPolynomial (Fin s) (Localization.Away a)))) e hsm hfree
    exact h

theorem wc_pfc_ssp_smooth_conormal_local : ∀ (R : Type u) [CommRing R] (C : Type u) [CommRing C] [Algebra R C] (n : ℕ) (p : MvPolynomial (Fin n) R →ₐ[R] C), Function.Surjective p → ∀ h : MvPolynomial (Fin n) R, Algebra.Smooth R (Localization.Away (p h)) → ∃ (N : ℕ) (q : Fin n → MvPolynomial (Fin n) R), (∀ j, q j ∈ RingHom.ker p) ∧ ∀ g ∈ RingHom.ker p, ∃ s : ℕ, h ^ s * (h ^ N * g - ∑ j, MvPolynomial.pderiv j g * q j) ∈ RingHom.ker p ^ 2 :=
by
  intro R _ C _ _ n
  classical

  have s1 : ∀ (P' T : Type u) [CommRing P'] [CommRing T] [Algebra R P'] [Algebra R T]
      [Algebra.FormallySmooth R T] (π : P' →ₐ[R] T), Function.Surjective π →
      ∀ (ι₀ : MvPolynomial (Fin n) R →ₐ[R] P'), ∃ q : Fin n → P', (∀ j, q j ∈ RingHom.ker π) ∧
        ∀ x : MvPolynomial (Fin n) R, ι₀ x ∈ RingHom.ker π →
          ι₀ x - ∑ j, ι₀ (MvPolynomial.pderiv j x) * q j ∈ RingHom.ker π ^ 2 := by
    intro P' T _ _ _ _ _ π hπ ι₀
    obtain ⟨mk, hκmk, hmksurj, hmk0⟩ : ∃ mk : P' →ₐ[R] P' ⧸ RingHom.ker π.toRingHom ^ 2,
        (∀ y, π.kerSquareLift (mk y) = π y) ∧ Function.Surjective mk ∧
        ∀ y, mk y = 0 ↔ y ∈ RingHom.ker π.toRingHom ^ 2 :=
      ⟨Ideal.Quotient.mkₐ R _, fun y => AlgHom.kerSquareLift_mk π y,
        Ideal.Quotient.mkₐ_surjective R _, fun y => by
          rw [Ideal.Quotient.mkₐ_eq_mk, Ideal.Quotient.eq_zero_iff_mem]⟩
    have hκsurj : Function.Surjective π.kerSquareLift := by
      intro t
      obtain ⟨y, rfl⟩ := hπ t
      exact ⟨_, hκmk y⟩
    have hZ : ∀ b b' : P' ⧸ RingHom.ker π.toRingHom ^ 2, π.kerSquareLift b = 0 →
        π.kerSquareLift b' = 0 → b * b' = 0 := by
      intro b b' hb hb'
      obtain ⟨w, rfl⟩ := hmksurj b
      obtain ⟨w', rfl⟩ := hmksurj b'
      rw [hκmk] at hb hb'
      rw [← map_mul, hmk0, pow_two]
      exact Ideal.mul_mem_mul (RingHom.mem_ker.mpr hb) (RingHom.mem_ker.mpr hb')
    have hnil : IsNilpotent (RingHom.ker
        (π.kerSquareLift : P' ⧸ RingHom.ker π.toRingHom ^ 2 →+* T)) := by
      have key : ∀ I : Ideal (P' ⧸ RingHom.ker π.toRingHom ^ 2),
          (∀ r ∈ I, ∀ s ∈ I, r * s = 0) → I ^ 2 = 0 := by
        intro I hI
        rw [pow_two I, Ideal.zero_eq_bot, eq_bot_iff, Ideal.mul_le]
        intro r hr s hs
        rw [Ideal.mem_bot]
        exact hI r hr s hs
      refine ⟨2, key _ fun r hr s hs => ?_⟩
      exact hZ r s (RingHom.mem_ker.mp hr) (RingHom.mem_ker.mp hs)
    obtain ⟨σ, hσ⟩ : ∃ σ : T →ₐ[R] P' ⧸ RingHom.ker π.toRingHom ^ 2,
        ∀ t, π.kerSquareLift (σ t) = t :=
      ⟨Algebra.FormallySmooth.liftOfSurjective (AlgHom.id R T) π.kerSquareLift hκsurj hnil,
        fun t => Algebra.FormallySmooth.liftOfSurjective_apply (AlgHom.id R T) π.kerSquareLift
          hκsurj hnil t⟩
    obtain ⟨φ, hφ⟩ : ∃ φ : P' → P' ⧸ RingHom.ker π.toRingHom ^ 2,
        ∀ y, φ y = mk y - σ (π y) := ⟨_, fun _ => rfl⟩
    have hκφ : ∀ y, π.kerSquareLift (φ y) = 0 := by
      intro y; rw [hφ, map_sub, hκmk, hσ, sub_self]
    have hφadd : ∀ y z, φ (y + z) = φ y + φ z := by
      intro y z; simp only [hφ, map_add]; ring
    have hφalg : ∀ r : R, φ (algebraMap R P' r) = 0 := by
      intro r; simp only [hφ, AlgHom.commutes, sub_self]
    have hφmul : ∀ y z, φ (y * z) = mk y * φ z + mk z * φ y := by
      intro y z
      have h0 : φ y * φ z = 0 := hZ _ _ (hκφ y) (hκφ z)
      simp only [hφ, map_mul] at h0 ⊢
      linear_combination -h0
    have hC : ∀ a : R, ι₀ (MvPolynomial.C a) = algebraMap R P' a := fun a => by
      rw [← MvPolynomial.algebraMap_eq]; exact ι₀.commutes a
    have hchain : ∀ x : MvPolynomial (Fin n) R, φ (ι₀ x) =
        ∑ j, mk (ι₀ (MvPolynomial.pderiv j x)) * φ (ι₀ (MvPolynomial.X j)) := by
      intro x
      induction x using MvPolynomial.induction_on
      next a =>
        rw [hC, hφalg]
        simp only [MvPolynomial.pderiv_C, map_zero, zero_mul, Finset.sum_const_zero]
      next x y hx hy =>
        simp only [map_add, hφadd, hx, hy, add_mul, Finset.sum_add_distrib]
      next x i hx =>
        have e1 : ∀ j, mk (ι₀ (MvPolynomial.pderiv j (x * MvPolynomial.X i))) *
              φ (ι₀ (MvPolynomial.X j)) =
            mk (ι₀ (MvPolynomial.X i)) * (mk (ι₀ (MvPolynomial.pderiv j x)) *
              φ (ι₀ (MvPolynomial.X j))) +
            (if j = i then mk (ι₀ x) * φ (ι₀ (MvPolynomial.X i)) else 0) := by
          intro j
          rw [MvPolynomial.pderiv_mul]
          by_cases hji : j = i
          · subst hji
            rw [MvPolynomial.pderiv_X_self, if_pos rfl]
            simp only [map_add, map_mul, map_one]
            ring
          · rw [MvPolynomial.pderiv_X_of_ne (Ne.symm hji), if_neg hji]
            simp only [map_add, map_mul, map_zero]
            ring
        rw [Finset.sum_congr rfl (fun j _ => e1 j), Finset.sum_add_distrib, ← Finset.mul_sum, ← hx]
        simp only [Finset.sum_ite_eq', Finset.mem_univ, ↓reduceIte, map_mul, hφmul]
        ring
    choose q hq using fun j => hmksurj (φ (ι₀ (MvPolynomial.X j)))
    refine ⟨q, fun j => ?_, fun x hx => ?_⟩
    · rw [RingHom.mem_ker, ← hκmk, hq, hκφ]
    · have hx' : π (ι₀ x) = 0 := RingHom.mem_ker.mp hx
      have e : mk (ι₀ x - ∑ j, ι₀ (MvPolynomial.pderiv j x) * q j) = 0 := by
        rw [map_sub, map_sum]
        simp only [map_mul, hq]
        rw [← hchain, hφ, hx', map_zero, sub_zero, sub_self]
      exact (hmk0 _).mp e
  intro p hp h hsm

  have hcomp : ∀ x : MvPolynomial (Fin n) R, Localization.awayMapₐ p h
      (algebraMap (MvPolynomial (Fin n) R) (Localization.Away h) x) =
      algebraMap C (Localization.Away (p h)) (p x) := by
    intro x
    simp [Localization.awayMapₐ, IsLocalization.Away.mapₐ_apply, IsLocalization.Away.map,
      IsLocalization.map_eq]
  have hsurj : Function.Surjective (Localization.awayMapₐ p h) := by
    intro z
    obtain ⟨k, c, hc⟩ := IsLocalization.Away.surj (p h) z
    obtain ⟨x, rfl⟩ := hp c
    refine ⟨IsLocalization.mk' (Localization.Away h) x
      (⟨h ^ k, k, rfl⟩ : Submonoid.powers h), ?_⟩
    have e1 : IsLocalization.mk' (Localization.Away h) x (⟨h ^ k, k, rfl⟩ : Submonoid.powers h) *
        algebraMap _ (Localization.Away h) (h ^ k) = algebraMap _ _ x :=
      IsLocalization.mk'_spec _ _ _
    have e2 := congrArg (Localization.awayMapₐ p h) e1
    rw [map_mul, hcomp, hcomp, map_pow, map_pow, ← hc] at e2
    exact (IsLocalization.Away.algebraMap_pow_isUnit (p h) k).mul_left_injective e2
  have hker : RingHom.ker (Localization.awayMapₐ p h) ≤
      Ideal.map (algebraMap (MvPolynomial (Fin n) R) (Localization.Away h)) (RingHom.ker p) := by
    intro w hw
    rw [RingHom.mem_ker] at hw
    obtain ⟨k, x, hx⟩ := IsLocalization.Away.surj h w
    have e2 := congrArg (Localization.awayMapₐ p h) hx
    rw [map_mul, hw, zero_mul, hcomp] at e2
    obtain ⟨⟨m, t, rfl⟩, hm⟩ := (IsLocalization.map_eq_zero_iff (Submonoid.powers (p h))
      (Localization.Away (p h)) (p x)).mp e2.symm
    have hxI : h ^ t * x ∈ RingHom.ker p := by
      rw [RingHom.mem_ker, map_mul, map_pow]; exact hm
    have e3 : w * algebraMap _ (Localization.Away h) (h ^ (t + k)) =
        algebraMap _ (Localization.Away h) (h ^ t * x) := by
      rw [pow_add, map_mul, map_mul, ← hx]
      simp only [map_pow]
      ring
    have hu : IsUnit (algebraMap (MvPolynomial (Fin n) R) (Localization.Away h) (h ^ (t + k))) := by
      rw [map_pow]; exact IsLocalization.Away.algebraMap_pow_isUnit h _
    have hw' : w = algebraMap _ (Localization.Away h) (h ^ t * x) * ↑hu.unit⁻¹ := by
      rw [← e3, mul_assoc, IsUnit.mul_val_inv, mul_one]
    rw [hw']
    exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ hxI)

  have : Algebra.FormallySmooth R (Localization.Away (p h)) := inferInstance
  obtain ⟨q', hq'J, hstar'⟩ := s1 (Localization.Away h) (Localization.Away (p h))
    (Localization.awayMapₐ p h) hsurj
    (IsScalarTower.toAlgHom R (MvPolynomial (Fin n) R) (Localization.Away h))
  have hq'map : ∀ j, q' j ∈ Ideal.map (algebraMap (MvPolynomial (Fin n) R)
      (Localization.Away h)) (RingHom.ker p) := fun j => hker (hq'J j)
  have hstar : ∀ g ∈ RingHom.ker p, algebraMap (MvPolynomial (Fin n) R) (Localization.Away h) g -
      ∑ j, algebraMap (MvPolynomial (Fin n) R) (Localization.Away h) (MvPolynomial.pderiv j g) *
        q' j ∈ Ideal.map (algebraMap (MvPolynomial (Fin n) R) (Localization.Away h))
          (RingHom.ker p) ^ 2 := by
    intro g hg
    have hg0 : IsScalarTower.toAlgHom R (MvPolynomial (Fin n) R) (Localization.Away h) g ∈
        RingHom.ker (Localization.awayMapₐ p h) := by
      rw [RingHom.mem_ker, IsScalarTower.toAlgHom_apply, hcomp, RingHom.mem_ker.mp hg, map_zero]
    have := Ideal.pow_right_mono hker 2 (hstar' g hg0)
    simpa only [IsScalarTower.toAlgHom_apply] using this

  have hq'' : ∀ j, ∃ (a : MvPolynomial (Fin n) R) (k : ℕ), a ∈ RingHom.ker p ∧
      q' j * algebraMap _ (Localization.Away h) (h ^ k) = algebraMap _ (Localization.Away h) a := by
    intro j
    obtain ⟨⟨⟨a, ha⟩, ⟨m, k, rfl⟩⟩, e⟩ := (IsLocalization.mem_map_algebraMap_iff
      (Submonoid.powers h) (Localization.Away h)).mp (hq'map j)
    exact ⟨a, k, ha, e⟩
  choose a k ha hak using hq''
  obtain ⟨K, hK⟩ : ∃ K, K = ∑ j, k j := ⟨_, rfl⟩
  have hkK : ∀ j, k j ≤ K := fun j => by
    rw [hK]; exact Finset.single_le_sum (f := k) (fun j _ => Nat.zero_le _) (Finset.mem_univ j)
  refine ⟨K, fun j => a j * h ^ (K - k j), fun j => Ideal.mul_mem_right _ _ (ha j), ?_⟩
  have hqK : ∀ j, q' j * algebraMap _ (Localization.Away h) (h ^ K) =
      algebraMap _ (Localization.Away h) (a j * h ^ (K - k j)) := by
    intro j
    have e : h ^ K = h ^ k j * h ^ (K - k j) := by rw [← pow_add, Nat.add_sub_cancel' (hkK j)]
    rw [e, map_mul, ← mul_assoc, hak j, map_mul]
  intro g hg
  have hmem : algebraMap _ (Localization.Away h)
      (h ^ K * g - ∑ j, MvPolynomial.pderiv j g * (a j * h ^ (K - k j))) ∈
      Ideal.map (algebraMap _ (Localization.Away h)) (RingHom.ker p ^ 2) := by
    have e : algebraMap _ (Localization.Away h)
        (h ^ K * g - ∑ j, MvPolynomial.pderiv j g * (a j * h ^ (K - k j))) =
        algebraMap _ (Localization.Away h) (h ^ K) *
          (algebraMap _ (Localization.Away h) g - ∑ j, algebraMap _ (Localization.Away h)
            (MvPolynomial.pderiv j g) * q' j) := by
      rw [map_sub, map_mul, map_sum, mul_sub, Finset.mul_sum]
      congr 1
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [map_mul, ← hqK j]; ring
    rw [e, Ideal.map_pow]
    exact Ideal.mul_mem_left _ _ (hstar g hg)
  generalize (h ^ K * g - ∑ j, MvPolynomial.pderiv j g * (a j * h ^ (K - k j))) = E at hmem ⊢
  obtain ⟨⟨⟨b, hb⟩, ⟨m, s₀, rfl⟩⟩, e2⟩ := (IsLocalization.mem_map_algebraMap_iff
    (Submonoid.powers h) (Localization.Away h)).mp hmem
  have e2' : algebraMap _ (Localization.Away h) (E * h ^ s₀) =
      algebraMap _ (Localization.Away h) b := by rw [map_mul]; exact e2
  obtain ⟨⟨c, t, rfl⟩, e3⟩ := (IsLocalization.eq_iff_exists (Submonoid.powers h)
    (Localization.Away h)).mp e2'
  have e3' : h ^ t * (E * h ^ s₀) = h ^ t * b := e3
  refine ⟨t + s₀, ?_⟩
  have e4 : h ^ (t + s₀) * E = h ^ t * b := by rw [← e3']; ring
  rw [e4]
  exact Ideal.mul_mem_left _ _ hb

theorem wc_pfc_ssp_kaehler_presentation : ∀ (R : Type u) [CommRing R] (C : Type u) [CommRing C] [Algebra R C] (n : ℕ) (p : MvPolynomial (Fin n) R →ₐ[R] C), Function.Surjective p → (∀ P : MvPolynomial (Fin n) R, KaehlerDifferential.D R C (p P) = ∑ j, p (MvPolynomial.pderiv j P) • KaehlerDifferential.D R C (p (MvPolynomial.X j))) ∧ ∀ w : Fin n → C, ∑ j, w j • KaehlerDifferential.D R C (p (MvPolynomial.X j)) = 0 → ∃ g ∈ RingHom.ker p, ∀ j, w j = p (MvPolynomial.pderiv j g) :=
by
  intro R _ C _ _ n p hp
  classical
  refine ⟨fun P => ?_, fun w hw => ?_⟩
  · induction P using MvPolynomial.induction_on
    next a =>
      have h1 : p (MvPolynomial.C a) = algebraMap R C a := by
        rw [← MvPolynomial.algebraMap_eq, AlgHom.commutes]
      simp [h1]
    next P Q hP hQ =>
      simp only [map_add, hP, hQ, add_smul, Finset.sum_add_distrib]
    next Q i hQ =>
      rw [map_mul, Derivation.leibniz, hQ]
      simp only [MvPolynomial.pderiv_mul, MvPolynomial.pderiv_X, map_add, map_mul, add_smul,
        Finset.sum_add_distrib]
      rw [add_comm]
      congr 1
      · rw [Finset.smul_sum]
        refine Finset.sum_congr rfl fun j _ => ?_
        rw [smul_smul, mul_comm]
      · simp [Pi.single_apply, apply_ite]
  · letI : Algebra (MvPolynomial (Fin n) R) C := p.toRingHom.toAlgebra
    haveI : IsScalarTower R (MvPolynomial (Fin n) R) C :=
      IsScalarTower.of_algebraMap_eq (fun r => (p.commutes r).symm)
    have hp' : Function.Surjective (algebraMap (MvPolynomial (Fin n) R) C) := hp
    have hex := KaehlerDifferential.exact_kerCotangentToTensor_mapBaseChange R
      (MvPolynomial (Fin n) R) C hp'
    have hξ0 : KaehlerDifferential.mapBaseChange R (MvPolynomial (Fin n) R) C
        (∑ j, w j • Algebra.TensorProduct.basis C (KaehlerDifferential.mvPolynomialBasis R (Fin n)) j)
        = 0 := by
      rw [map_sum]
      simp only [map_smul, Algebra.TensorProduct.basis_apply,
        KaehlerDifferential.mapBaseChange_tmul, one_smul,
        KaehlerDifferential.mvPolynomialBasis_apply, KaehlerDifferential.map_D]
      exact hw
    obtain ⟨z, hz⟩ := (hex _).mp hξ0
    obtain ⟨⟨g, hg⟩, rfl⟩ := Ideal.toCotangent_surjective _ z
    rw [KaehlerDifferential.kerCotangentToTensor_toCotangent] at hz
    refine ⟨g, RingHom.mem_ker.mpr (RingHom.mem_ker.mp hg), fun j => ?_⟩
    have h2 := congrFun
      ((Algebra.TensorProduct.basis C (KaehlerDifferential.mvPolynomialBasis R (Fin n))).repr_sum_self w) j
    rw [← hz, Algebra.TensorProduct.basis_repr_tmul, Finsupp.smul_apply, one_smul,
      Finsupp.mapRange_apply, KaehlerDifferential.mvPolynomialBasis_repr_apply] at h2
    exact h2.symm

theorem wc_pfc_ssp_localized_projector : ∀ (R : Type u) [CommRing R] (C : Type u) [CommRing C] [Algebra R C] (n : ℕ) (p : MvPolynomial (Fin n) R →ₐ[R] C), Function.Surjective p → (∀ P : MvPolynomial (Fin n) R, KaehlerDifferential.D R C (p P) = ∑ j, p (MvPolynomial.pderiv j P) • KaehlerDifferential.D R C (p (MvPolynomial.X j))) → (∀ w : Fin n → C, ∑ j, w j • KaehlerDifferential.D R C (p (MvPolynomial.X j)) = 0 → ∃ g ∈ RingHom.ker p, ∀ j, w j = p (MvPolynomial.pderiv j g)) → ∀ (h : MvPolynomial (Fin n) R) (N : ℕ) (q : Fin n → MvPolynomial (Fin n) R), (∀ j, q j ∈ RingHom.ker p) → (∀ g ∈ RingHom.ker p, ∀ i, h ^ N * MvPolynomial.pderiv i g - ∑ j, MvPolynomial.pderiv j g * MvPolynomial.pderiv i (q j) ∈ RingHom.ker p) → (∀ ω : Ω[Localization.Away (p h)⁄R], ∃ v : Fin n → Localization.Away (p h), ∑ j, v j • KaehlerDifferential.D R (Localization.Away (p h)) (algebraMap C (Localization.Away (p h)) (p (MvPolynomial.X j))) = ω) ∧ (∀ i, ∑ k, (IsLocalization.Away.invSelf (S := Localization.Away (p h)) (p h) ^ N * algebraMap C (Localization.Away (p h)) (p (MvPolynomial.pderiv k (q i)))) • KaehlerDifferential.D R (Localization.Away (p h)) (algebraMap C (Localization.Away (p h)) (p (MvPolynomial.X k))) = 0) ∧ ∀ v : Fin n → Localization.Away (p h), ∑ j, v j • KaehlerDifferential.D R (Localization.Away (p h)) (algebraMap C (Localization.Away (p h)) (p (MvPolynomial.X j))) = 0 → Matrix.vecMul v (Matrix.of fun i k => IsLocalization.Away.invSelf (S := Localization.Away (p h)) (p h) ^ N * algebraMap C (Localization.Away (p h)) (p (MvPolynomial.pderiv k (q i)))) = v :=
by
  intro R _ C _ _ n p hp H1 H2 h N q hq hDS
  classical

  have s1 : ∀ (a : C) (w x : Fin n → C),
      KaehlerDifferential.map R R C (Localization.Away a)
        (∑ j, w j • KaehlerDifferential.D R C (x j)) =
      ∑ j, algebraMap C (Localization.Away a) (w j) •
        KaehlerDifferential.D R (Localization.Away a) (algebraMap C (Localization.Away a) (x j)) := by
    intro a w x
    rw [map_sum]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [LinearMap.map_smul, KaehlerDifferential.map_D, algebraMap_smul]

  have s2 : ∀ (a : C) (x : Fin n → C),
      (∀ c : C, ∃ w : Fin n → C, ∑ j, w j • KaehlerDifferential.D R C (x j) =
        KaehlerDifferential.D R C c) →
      ∀ ω : Ω[Localization.Away a⁄R], ∃ v : Fin n → Localization.Away a,
        ∑ j, v j • KaehlerDifferential.D R (Localization.Away a)
          (algebraMap C (Localization.Away a) (x j)) = ω := by
    intro a x hx ω
    have hspan : ∀ ω₀ : Ω[C⁄R], ∃ w : Fin n → C,
        ∑ j, w j • KaehlerDifferential.D R C (x j) = ω₀ := by
      intro ω₀
      have hle : Submodule.span C (Set.range (KaehlerDifferential.D R C)) ≤
          Submodule.span C (Set.range fun j => KaehlerDifferential.D R C (x j)) := by
        rw [Submodule.span_le]
        rintro _ ⟨c, rfl⟩
        obtain ⟨w, hw⟩ := hx c
        exact (Submodule.mem_span_range_iff_exists_fun C).mpr ⟨w, hw⟩
      rw [KaehlerDifferential.span_range_derivation] at hle
      exact (Submodule.mem_span_range_iff_exists_fun C).mp (hle Submodule.mem_top)
    obtain ⟨⟨ω₀, ⟨m, hm⟩⟩, hω⟩ := IsLocalizedModule.surj (Submonoid.powers a)
      (KaehlerDifferential.map R R C (Localization.Away a)) ω
    obtain ⟨s, rfl⟩ := (Submonoid.mem_powers_iff _ _).mp hm
    obtain ⟨w, rfl⟩ := hspan ω₀
    rw [s1, Submonoid.smul_def] at hω
    simp only at hω
    refine ⟨fun j => IsLocalization.Away.invSelf (S := Localization.Away a) a ^ s *
      algebraMap C (Localization.Away a) (w j), ?_⟩
    simp only [mul_smul]
    rw [← Finset.smul_sum, ← hω, ← algebraMap_smul (Localization.Away a) (a ^ s) ω, smul_smul,
      map_pow, ← mul_pow, mul_comm, IsLocalization.Away.mul_invSelf, one_pow, one_smul]

  have s3 : ∀ (a : C) (x : Fin n → C) (v : Fin n → Localization.Away a),
      ∑ j, v j • KaehlerDifferential.D R (Localization.Away a)
        (algebraMap C (Localization.Away a) (x j)) = 0 →
      ∃ (s t : ℕ) (w : Fin n → C),
        (∀ j, algebraMap C (Localization.Away a) a ^ s * v j =
          algebraMap C (Localization.Away a) (w j)) ∧
        ∑ j, (a ^ t * w j) • KaehlerDifferential.D R C (x j) = 0 := by
    intro a x v hv
    have hsurj : ∀ j, ∃ (k : ℕ) (c : C), v j * algebraMap C (Localization.Away a) a ^ k =
        algebraMap C (Localization.Away a) c := fun j => IsLocalization.Away.surj a (v j)
    choose k c hkc using hsurj
    obtain ⟨s, hs⟩ : ∃ s, s = ∑ j, k j := ⟨_, rfl⟩
    have hks : ∀ j, k j ≤ s := fun j => by
      rw [hs]; exact Finset.single_le_sum (f := k) (fun _ _ => Nat.zero_le _) (Finset.mem_univ j)
    have hW1 : ∀ j, algebraMap C (Localization.Away a) a ^ s * v j =
        algebraMap C (Localization.Away a) (a ^ (s - k j) * c j) := by
      intro j
      rw [map_mul, map_pow, ← hkc j]
      have e : s = (s - k j) + k j := (Nat.sub_add_cancel (hks j)).symm
      conv_lhs => rw [e, pow_add]
      ring
    have hμ : KaehlerDifferential.map R R C (Localization.Away a)
        (∑ j, (a ^ (s - k j) * c j) • KaehlerDifferential.D R C (x j)) = 0 := by
      rw [s1]
      have e : ∀ j, algebraMap C (Localization.Away a) (a ^ (s - k j) * c j) •
          KaehlerDifferential.D R (Localization.Away a) (algebraMap C (Localization.Away a) (x j)) =
          algebraMap C (Localization.Away a) a ^ s • (v j •
          KaehlerDifferential.D R (Localization.Away a) (algebraMap C (Localization.Away a) (x j))) := by
        intro j
        rw [← hW1 j, mul_smul]
      rw [Finset.sum_congr rfl fun j _ => e j, ← Finset.smul_sum, hv, smul_zero]
    obtain ⟨⟨m, hm⟩, hm0⟩ := (IsLocalizedModule.eq_zero_iff (Submonoid.powers a)
      (KaehlerDifferential.map R R C (Localization.Away a))).mp hμ
    obtain ⟨t, rfl⟩ := (Submonoid.mem_powers_iff _ _).mp hm
    refine ⟨s, t, fun j => a ^ (s - k j) * c j, hW1, ?_⟩
    rw [Submonoid.smul_def] at hm0
    simp only at hm0
    rw [Finset.smul_sum] at hm0
    simp only [smul_smul] at hm0
    exact hm0

  have alg : ∀ (T : Type u) [CommRing T] (α inv : T), α * inv = 1 → ∀ (N t s : ℕ)
      (v e : Fin n → T) (k : Fin n),
      α ^ N * (α ^ t * (α ^ s * v k)) = ∑ j, α ^ t * (α ^ s * v j) * e j →
      ∑ j, v j * (inv ^ N * e j) = v k := by
    intro T _ α inv hu N t s v e k H
    have key1 : ∀ m : ℕ, inv ^ m * α ^ m = 1 := fun m => by
      rw [← mul_pow, mul_comm, hu, one_pow]
    have key : ∀ M m : ℕ, inv ^ (M + m) * α ^ m = inv ^ M := fun M m => by
      rw [pow_add, mul_assoc, key1, mul_one]
    calc ∑ j, v j * (inv ^ N * e j)
        = ∑ j, inv ^ (N + (t + s)) * (α ^ t * (α ^ s * v j) * e j) := by
          refine Finset.sum_congr rfl fun j _ => ?_
          rw [← key N (t + s)]
          ring
      _ = inv ^ (N + (t + s)) * (α ^ N * (α ^ t * (α ^ s * v k))) := by
          rw [← Finset.mul_sum, H]
      _ = (inv ^ (N + (t + s)) * α ^ (N + (t + s))) * v k := by ring
      _ = v k := by rw [key1, one_mul]
  refine ⟨?_, ?_, ?_⟩
  ·
    apply s2 (p h) (fun j => p (MvPolynomial.X j))
    intro c
    obtain ⟨P, rfl⟩ := hp c
    exact ⟨fun j => p (MvPolynomial.pderiv j P), (H1 P).symm⟩
  ·
    intro i
    have e1 := s1 (p h) (fun k => p (MvPolynomial.pderiv k (q i))) (fun k => p (MvPolynomial.X k))
    rw [← H1, (RingHom.mem_ker).mp (hq i), map_zero, map_zero] at e1
    simp only [mul_smul]
    rw [← Finset.smul_sum, ← e1, smul_zero]
  ·
    intro v hv
    obtain ⟨s, t, w, hW1, hW2⟩ := s3 (p h) (fun j => p (MvPolynomial.X j)) v hv
    obtain ⟨g, hg, hW3⟩ := H2 (fun j => p h ^ t * w j) hW2
    have hW3' : ∀ j, p h ^ t * w j = p (MvPolynomial.pderiv j g) := hW3
    have hW4 : ∀ k, p h ^ N * (p h ^ t * w k) =
        ∑ j, (p h ^ t * w j) * p (MvPolynomial.pderiv k (q j)) := by
      intro k
      have e := (RingHom.mem_ker).mp (hDS g hg k)
      rw [map_sub, map_mul, map_pow, map_sum, sub_eq_zero] at e
      simp only [map_mul] at e
      simp only [hW3']
      exact e
    have hu : algebraMap C (Localization.Away (p h)) (p h) *
        IsLocalization.Away.invSelf (S := Localization.Away (p h)) (p h) = 1 :=
      IsLocalization.Away.mul_invSelf (p h)
    funext k
    simp only [Matrix.vecMul, dotProduct, Matrix.of_apply]
    refine alg (Localization.Away (p h)) _ _ hu N t s v
      (fun j => algebraMap C (Localization.Away (p h)) (p (MvPolynomial.pderiv k (q j)))) k ?_
    have e := congrArg (algebraMap C (Localization.Away (p h))) (hW4 k)
    simp only [map_mul, map_pow, map_sum, ← hW1] at e
    exact e

theorem wc_pfc_ssp_split_matrices : ∀ (T : Type u) [CommRing T] (M : Type u) [AddCommGroup M] [Module T M], Module.Free T M → ∀ (n : ℕ) (u : Fin n → M) (E : Matrix (Fin n) (Fin n) T), (∀ ω : M, ∃ v : Fin n → T, ∑ j, v j • u j = ω) → (∀ i, ∑ k, E i k • u k = 0) → (∀ v : Fin n → T, ∑ j, v j • u j = 0 → Matrix.vecMul v E = v) → ∃ (δ : ℕ) (A : Matrix (Fin δ) (Fin n) T) (B : Matrix (Fin n) (Fin δ) T), A * B = 1 ∧ B * A = 1 - E :=
by
  intro T _ M _ _ hfree n u E H1 H2 H3
  classical
  rcases subsingleton_or_nontrivial T with hT | hT
  · refine ⟨0, 0, 0, ?_, ?_⟩
    · ext i j; exact i.elim0
    · ext i j; exact Subsingleton.elim _ _
  have : StrongRankCondition T := commRing_strongRankCondition T
  let π : (Fin n → T) →ₗ[T] M := Fintype.linearCombination T u
  have hπ : ∀ v, π v = ∑ j, v j • u j := fun v => Fintype.linearCombination_apply T u v
  have : Module.Finite T M := Module.Finite.of_surjective π (fun ω => by
    obtain ⟨v, hv⟩ := H1 ω
    exact ⟨v, (hπ v).trans hv⟩)
  let b := Module.finBasis T M
  choose L hL using fun l => H1 (b l)
  let Lm : Matrix (Fin (Module.finrank T M)) (Fin n) T := Matrix.of fun l k => L l k
  let B : Matrix (Fin n) (Fin (Module.finrank T M)) T := Matrix.of fun j l => b.repr (u j) l
  have hπL : ∀ l, π (Lm l) = b l := fun l => (hπ _).trans (hL l)
  have K1 : ∀ v : Fin n → T, π (Matrix.vecMul v E) = 0 := by
    intro v
    rw [hπ]
    simp only [Matrix.vecMul, dotProduct, Finset.sum_smul, mul_smul]
    rw [Finset.sum_comm]
    simp only [← Finset.smul_sum, H2, smul_zero, Finset.sum_const_zero]
  have K2 : ∀ (w : Fin n → T) l, b.repr (π w) l = ∑ j, w j * B j l := by
    intro w l
    rw [hπ, map_sum, Finsupp.finsetSum_apply]
    simp [B]
  refine ⟨Module.finrank T M, Lm * (1 - E), B, ?_, ?_⟩
  · ext l l'
    have h := K2 ((Lm * (1 - E) : Matrix (Fin (Module.finrank T M)) (Fin n) T) l) l'
    rw [Matrix.mul_apply, ← h, Matrix.mul_apply_eq_vecMul, Matrix.vecMul_sub, Matrix.vecMul_one,
      map_sub, K1, sub_zero, hπL, Module.Basis.repr_self_apply, Matrix.one_apply]
  · ext j k
    have hw : π (Matrix.vecMul (B j) Lm) = u j := by
      rw [hπ]
      simp only [Matrix.vecMul, dotProduct, Finset.sum_smul, mul_smul]
      rw [Finset.sum_comm]
      simp only [← Finset.smul_sum]
      have e : ∀ l, ∑ k, Lm l k • u k = b l := fun l => (hπ _).symm.trans (hπL l)
      simp only [e]
      exact b.sum_repr (u j)
    have he : π (Pi.single j 1) = u j := by
      rw [hπ]
      simp [Pi.single_apply]
    have hd : π (Pi.single j 1 - Matrix.vecMul (B j) Lm) = 0 := by
      rw [map_sub, hw, he, sub_self]
    have h3 := H3 _ ((hπ _).symm.trans hd)
    have h4 : Matrix.vecMul (Pi.single j 1 - Matrix.vecMul (B j) Lm) (1 - E) = 0 := by
      rw [Matrix.vecMul_sub, Matrix.vecMul_one, h3, sub_self]
    rw [Matrix.sub_vecMul, sub_eq_zero, Matrix.single_one_vecMul, Matrix.vecMul_vecMul] at h4
    rw [Matrix.mul_apply_eq_vecMul, ← h4]
    rfl

theorem wc_pfc_ssp_clear_denominators : ∀ (R : Type u) [CommRing R] (C : Type u) [CommRing C] [Algebra R C] (n : ℕ) (p : MvPolynomial (Fin n) R →ₐ[R] C), Function.Surjective p → ∀ (h : MvPolynomial (Fin n) R) (N : ℕ) (q : Fin n → MvPolynomial (Fin n) R), (∀ j, q j ∈ RingHom.ker p) → ∀ (δ : ℕ) (A : Matrix (Fin δ) (Fin n) (Localization.Away (p h))) (B : Matrix (Fin n) (Fin δ) (Localization.Away (p h))), A * B = 1 → B * A = 1 - Matrix.of (fun i k => IsLocalization.Away.invSelf (S := Localization.Away (p h)) (p h) ^ N * algebraMap C (Localization.Away (p h)) (p (MvPolynomial.pderiv k (q i)))) → ∃ (K : ℕ) (Ah : Fin δ → Fin n → MvPolynomial (Fin n) R) (Bh : Fin n → Fin δ → MvPolynomial (Fin n) R), (∀ l l', ∑ j, Ah l j * Bh j l' - (if l = l' then h ^ (N + K) else 0) ∈ RingHom.ker p) ∧ ∀ i k, ∑ l, Bh i l * Ah l k - (if i = k then h ^ (N + K) else 0) + MvPolynomial.pderiv k (h ^ K * q i) ∈ RingHom.ker p :=
by
  intro R _ C _ _ n p hp h N q hq δ A B hAB hBA
  classical

  obtain ⟨b, hb⟩ := IsLocalization.exist_integer_multiples_of_finite (Submonoid.powers (p h))
    (S := Localization.Away (p h))
    (Sum.elim (fun x : Fin δ × Fin n => A x.1 x.2) (fun x : Fin n × Fin δ => B x.1 x.2))
  obtain ⟨K0, hK0⟩ := (Submonoid.mem_powers_iff _ _).mp b.2
  have hA0 : ∀ l j, ∃ c : C, algebraMap C (Localization.Away (p h)) c =
      algebraMap C (Localization.Away (p h)) (p h) ^ K0 * A l j := by
    intro l j
    obtain ⟨c, hc⟩ := hb (Sum.inl (l, j))
    refine ⟨c, ?_⟩
    simpa [← hK0, Algebra.smul_def] using hc
  have hB0 : ∀ j l, ∃ c : C, algebraMap C (Localization.Away (p h)) c =
      algebraMap C (Localization.Away (p h)) (p h) ^ K0 * B j l := by
    intro j l
    obtain ⟨c, hc⟩ := hb (Sum.inr (j, l))
    refine ⟨c, ?_⟩
    simpa [← hK0, Algebra.smul_def] using hc
  choose A0 hA0 using hA0
  choose B0 hB0 using hB0
  have hsum : ∀ (m : ℕ) (f g : Fin m → C) (F G : Fin m → Localization.Away (p h)),
      (∀ j, algebraMap C (Localization.Away (p h)) (f j) =
        algebraMap C (Localization.Away (p h)) (p h) ^ K0 * F j) →
      (∀ j, algebraMap C (Localization.Away (p h)) (g j) =
        algebraMap C (Localization.Away (p h)) (p h) ^ K0 * G j) →
      algebraMap C (Localization.Away (p h)) (∑ j, f j * g j) =
        algebraMap C (Localization.Away (p h)) (p h) ^ (2 * K0) * ∑ j, F j * G j := by
    intro m f g F G hf hg
    rw [map_sum, Finset.mul_sum]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [map_mul, hf, hg]
    ring

  have hι1 : ∀ l l', algebraMap C (Localization.Away (p h))
      (∑ j, A0 l j * B0 j l' - if l = l' then p h ^ (2 * K0) else 0) = 0 := by
    intro l l'
    have e := congrFun (congrFun hAB l) l'
    rw [Matrix.mul_apply, Matrix.one_apply] at e
    rw [map_sub, hsum _ _ _ _ _ (hA0 l) (fun j => hB0 j l'), e]
    split_ifs <;> simp

  have hu : algebraMap C (Localization.Away (p h)) (p h) ^ N *
      IsLocalization.Away.invSelf (S := Localization.Away (p h)) (p h) ^ N = 1 := by
    rw [← mul_pow, IsLocalization.Away.mul_invSelf, one_pow]
  have hι2 : ∀ i k, algebraMap C (Localization.Away (p h))
      (p h ^ N * ∑ l, B0 i l * A0 l k - (if i = k then p h ^ (N + 2 * K0) else 0) +
        p h ^ (2 * K0) * p (MvPolynomial.pderiv k (q i))) = 0 := by
    intro i k
    have e := congrFun (congrFun hBA i) k
    rw [Matrix.mul_apply, Matrix.sub_apply, Matrix.one_apply, Matrix.of_apply] at e
    rw [map_add, map_sub, map_mul, map_mul, hsum _ _ _ _ _ (fun l => hB0 i l) (fun l => hA0 l k), e]
    split_ifs
    · simp only [map_pow]
      linear_combination (-(algebraMap C (Localization.Away (p h)) (p h) ^ (2 * K0)) *
        algebraMap C (Localization.Away (p h)) (p (MvPolynomial.pderiv k (q i)))) * hu
    · simp only [map_pow, map_zero]
      linear_combination (-(algebraMap C (Localization.Away (p h)) (p h) ^ (2 * K0)) *
        algebraMap C (Localization.Away (p h)) (p (MvPolynomial.pderiv k (q i)))) * hu

  have hex : ∀ e : (Fin δ × Fin δ) ⊕ (Fin n × Fin n), ∃ s : ℕ, p h ^ s *
      (Sum.elim (fun x : Fin δ × Fin δ =>
          ∑ j, A0 x.1 j * B0 j x.2 - if x.1 = x.2 then p h ^ (2 * K0) else 0)
        (fun x : Fin n × Fin n => p h ^ N * ∑ l, B0 x.1 l * A0 l x.2 -
          (if x.1 = x.2 then p h ^ (N + 2 * K0) else 0) +
            p h ^ (2 * K0) * p (MvPolynomial.pderiv x.2 (q x.1))) e) = 0 := by
    intro e
    have hz : algebraMap C (Localization.Away (p h)) (Sum.elim (fun x : Fin δ × Fin δ =>
          ∑ j, A0 x.1 j * B0 j x.2 - if x.1 = x.2 then p h ^ (2 * K0) else 0)
        (fun x : Fin n × Fin n => p h ^ N * ∑ l, B0 x.1 l * A0 l x.2 -
          (if x.1 = x.2 then p h ^ (N + 2 * K0) else 0) +
            p h ^ (2 * K0) * p (MvPolynomial.pderiv x.2 (q x.1))) e) = 0 := by
      rcases e with ⟨l, l'⟩ | ⟨i, k⟩
      · exact hι1 l l'
      · exact hι2 i k
    obtain ⟨⟨m, hm⟩, hme⟩ :=
      (IsLocalization.map_eq_zero_iff (Submonoid.powers (p h)) (Localization.Away (p h)) _).mp hz
    obtain ⟨s, rfl⟩ := (Submonoid.mem_powers_iff _ _).mp hm
    exact ⟨s, hme⟩
  choose s hs using hex
  have ht : ∀ e, p h ^ (∑ e', s e') *
      (Sum.elim (fun x : Fin δ × Fin δ =>
          ∑ j, A0 x.1 j * B0 j x.2 - if x.1 = x.2 then p h ^ (2 * K0) else 0)
        (fun x : Fin n × Fin n => p h ^ N * ∑ l, B0 x.1 l * A0 l x.2 -
          (if x.1 = x.2 then p h ^ (N + 2 * K0) else 0) +
            p h ^ (2 * K0) * p (MvPolynomial.pderiv x.2 (q x.1))) e) = 0 := by
    intro e
    have hle : s e ≤ ∑ e', s e' :=
      Finset.single_le_sum (fun _ _ => Nat.zero_le _) (Finset.mem_univ e)
    obtain ⟨d, hd⟩ := Nat.exists_eq_add_of_le hle
    rw [hd, pow_add, mul_comm (p h ^ s e), mul_assoc, hs e, mul_zero]

  choose Ah' hAh' using fun l j => hp (A0 l j)
  choose Bh' hBh' using fun j l => hp (B0 j l)

  refine ⟨(∑ e', s e') + 2 * K0, fun l j => h ^ (N + ∑ e', s e') * Ah' l j, Bh', ?_, ?_⟩
  · intro l l'
    have z : p h ^ (∑ e', s e') *
        (∑ j, A0 l j * B0 j l' - if l = l' then p h ^ (2 * K0) else 0) = 0 :=
      ht (Sum.inl (l, l'))
    rw [RingHom.mem_ker]
    have hs1 : p (∑ j, h ^ (N + ∑ e', s e') * Ah' l j * Bh' j l') =
        p h ^ (N + ∑ e', s e') * ∑ j, A0 l j * B0 j l' := by
      rw [map_sum, Finset.mul_sum]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [map_mul, map_mul, map_pow, hAh', hBh']
      ring
    rw [map_sub, hs1]
    split_ifs at z ⊢
    · rw [map_pow]
      linear_combination p h ^ N * z
    · rw [map_zero]
      linear_combination p h ^ N * z
  · intro i k
    have z : p h ^ (∑ e', s e') *
        (p h ^ N * ∑ l, B0 i l * A0 l k - (if i = k then p h ^ (N + 2 * K0) else 0) +
          p h ^ (2 * K0) * p (MvPolynomial.pderiv k (q i))) = 0 :=
      ht (Sum.inr (i, k))
    rw [RingHom.mem_ker]
    have hd : p (MvPolynomial.pderiv k (h ^ ((∑ e', s e') + 2 * K0) * q i)) =
        p h ^ ((∑ e', s e') + 2 * K0) * p (MvPolynomial.pderiv k (q i)) := by
      rw [MvPolynomial.pderiv_mul, map_add, map_mul, map_mul, RingHom.mem_ker.mp (hq i),
        mul_zero, zero_add, map_pow]
    have hs2 : p (∑ l, Bh' i l * (h ^ (N + ∑ e', s e') * Ah' l k)) =
        p h ^ (N + ∑ e', s e') * ∑ l, B0 i l * A0 l k := by
      rw [map_sum, Finset.mul_sum]
      refine Finset.sum_congr rfl fun l _ => ?_
      rw [map_mul, map_mul, map_pow, hAh', hBh']
      ring
    rw [map_add, map_sub, hs2, hd]
    split_ifs at z ⊢
    · rw [map_pow]
      linear_combination z
    · rw [map_zero]
      linear_combination z

theorem wc_pfc_ssp_presentation_extension : ∀ (R : Type u) [CommRing R] (C : Type u) [CommRing C] [Algebra R C] (n m δ : ℕ) (p : MvPolynomial (Fin n) R →ₐ[R] C), Function.Surjective p → ∀ (g : Fin m → MvPolynomial (Fin n) R), Ideal.span (Set.range g) = RingHom.ker p → ∀ (F : Fin n → MvPolynomial (Fin (n + δ)) R), (∀ i, F i ∈ Ideal.map (MvPolynomial.rename (Fin.castAdd δ)) (RingHom.ker p) ⊔ Ideal.span (Set.range fun l : Fin δ => (MvPolynomial.X (Fin.natAdd n l) : MvPolynomial (Fin (n + δ)) R))) → Ideal.span (Set.range (Fin.append F (Fin.append (fun k => MvPolynomial.rename (Fin.castAdd δ) (g k)) (fun l : Fin δ => (MvPolynomial.X (Fin.natAdd n l) : MvPolynomial (Fin (n + δ)) R))))) = Ideal.map (MvPolynomial.rename (Fin.castAdd δ)) (RingHom.ker p) ⊔ Ideal.span (Set.range fun l : Fin δ => (MvPolynomial.X (Fin.natAdd n l) : MvPolynomial (Fin (n + δ)) R)) ∧ ∃ e : (MvPolynomial (Fin (n + δ)) R ⧸ Ideal.span (Set.range (Fin.append F (Fin.append (fun k => MvPolynomial.rename (Fin.castAdd δ) (g k)) (fun l : Fin δ => (MvPolynomial.X (Fin.natAdd n l) : MvPolynomial (Fin (n + δ)) R)))))) ≃ₐ[R] C, ∀ s : MvPolynomial (Fin n) R, e.symm (p s) = Ideal.Quotient.mk _ (MvPolynomial.rename (Fin.castAdd δ) s) :=
by
  intro R _ C _ _ n m δ p hp g hg F hF
  classical

  have hrange : ∀ {k₁ k₂ : ℕ} (a : Fin k₁ → MvPolynomial (Fin (n + δ)) R)
      (b : Fin k₂ → MvPolynomial (Fin (n + δ)) R),
      Set.range (Fin.append a b) = Set.range a ∪ Set.range b := by
    intro k₁ k₂ a b
    ext x
    constructor
    · rintro ⟨k, rfl⟩
      induction k using Fin.addCases with
      | left i => exact Or.inl ⟨i, (Fin.append_left a b i).symm⟩
      | right j => exact Or.inr ⟨j, (Fin.append_right a b j).symm⟩
    · rintro (⟨i, rfl⟩ | ⟨j, rfl⟩)
      · exact ⟨Fin.castAdd k₂ i, Fin.append_left a b i⟩
      · exact ⟨Fin.natAdd k₁ j, Fin.append_right a b j⟩

  have hspan : Ideal.span (Set.range (Fin.append F (Fin.append (fun k => MvPolynomial.rename (Fin.castAdd δ) (g k)) (fun l : Fin δ => (MvPolynomial.X (Fin.natAdd n l) : MvPolynomial (Fin (n + δ)) R))))) = Ideal.map (MvPolynomial.rename (Fin.castAdd δ)) (RingHom.ker p) ⊔ Ideal.span (Set.range fun l : Fin δ => (MvPolynomial.X (Fin.natAdd n l) : MvPolynomial (Fin (n + δ)) R)) := by
    rw [hrange, hrange, Ideal.span_union, Ideal.span_union]
    have hg' : Ideal.span (Set.range (fun k => MvPolynomial.rename (Fin.castAdd δ) (g k))) =
        Ideal.map (MvPolynomial.rename (Fin.castAdd δ)) (RingHom.ker p) := by
      rw [← hg, Ideal.map_span, ← Set.range_comp]
      rfl
    rw [hg']
    apply sup_eq_right.mpr
    rw [Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    exact hF i

  let ψ : MvPolynomial (Fin (n + δ)) R →ₐ[R] C :=
    MvPolynomial.aeval (Fin.append (fun i : Fin n => p (MvPolynomial.X i)) (fun _ : Fin δ => (0 : C)))
  let σ : MvPolynomial (Fin (n + δ)) R →ₐ[R] MvPolynomial (Fin n) R :=
    MvPolynomial.aeval (Fin.append (fun i : Fin n => (MvPolynomial.X i : MvPolynomial (Fin n) R))
      (fun _ : Fin δ => 0))
  have hψι : ∀ s, ψ (MvPolynomial.rename (Fin.castAdd δ) s) = p s := by
    have h : ψ.comp (MvPolynomial.rename (Fin.castAdd δ)) = p := by
      apply MvPolynomial.algHom_ext
      intro i
      simp [ψ, MvPolynomial.aeval_X, Fin.append_left]
    intro s
    exact congrArg (fun φ : MvPolynomial (Fin n) R →ₐ[R] C => φ s) h
  have hψσ : ψ = p.comp σ := by
    apply MvPolynomial.algHom_ext
    intro k
    induction k using Fin.addCases with
    | left i => simp [ψ, σ]
    | right l => simp [ψ, σ]
  have hret : ∀ y, y - MvPolynomial.rename (Fin.castAdd δ) (σ y) ∈
      Ideal.span (Set.range fun l : Fin δ => (MvPolynomial.X (Fin.natAdd n l) : MvPolynomial (Fin (n + δ)) R)) := by
    have h : (Ideal.Quotient.mkₐ R (Ideal.span (Set.range fun l : Fin δ => (MvPolynomial.X (Fin.natAdd n l) : MvPolynomial (Fin (n + δ)) R)))).comp
        ((MvPolynomial.rename (Fin.castAdd δ)).comp σ) =
        Ideal.Quotient.mkₐ R (Ideal.span (Set.range fun l : Fin δ => (MvPolynomial.X (Fin.natAdd n l) : MvPolynomial (Fin (n + δ)) R))) := by
      apply MvPolynomial.algHom_ext
      intro k
      induction k using Fin.addCases with
      | left i => simp [σ]
      | right l =>
        rw [AlgHom.comp_apply, AlgHom.comp_apply]
        simp only [σ, MvPolynomial.aeval_X, Fin.append_right, map_zero]
        rw [eq_comm, Ideal.Quotient.mkₐ_eq_mk, Ideal.Quotient.eq_zero_iff_mem]
        exact Ideal.subset_span ⟨l, rfl⟩
    intro y
    rw [← Ideal.Quotient.eq]
    have h2 := congrArg (fun φ : MvPolynomial (Fin (n + δ)) R →ₐ[R] _ => φ y) h
    simp only [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk] at h2
    exact h2.symm
  have hker : RingHom.ker ψ = Ideal.map (MvPolynomial.rename (Fin.castAdd δ)) (RingHom.ker p) ⊔ Ideal.span (Set.range fun l : Fin δ => (MvPolynomial.X (Fin.natAdd n l) : MvPolynomial (Fin (n + δ)) R)) := by
    apply le_antisymm
    · intro y hy
      rw [RingHom.mem_ker] at hy
      have h1 : σ y ∈ RingHom.ker p := by
        rw [RingHom.mem_ker]
        have h2 : (p.comp σ) y = 0 := by rw [← hψσ]; exact hy
        simpa using h2
      have e : y = MvPolynomial.rename (Fin.castAdd δ) (σ y) +
          (y - MvPolynomial.rename (Fin.castAdd δ) (σ y)) := by ring
      rw [e]
      exact Ideal.add_mem _ (Ideal.mem_sup_left (Ideal.mem_map_of_mem _ h1))
        (Ideal.mem_sup_right (hret y))
    · apply sup_le
      · rw [Ideal.map_le_iff_le_comap]
        intro x hx
        rw [Ideal.mem_comap, RingHom.mem_ker]
        have : ψ (MvPolynomial.rename (Fin.castAdd δ) x) = p x := hψι x
        rw [this]
        exact (RingHom.mem_ker).mp hx
      · rw [Ideal.span_le]
        rintro _ ⟨l, rfl⟩
        simp [ψ]
  have hψsurj : Function.Surjective ψ := by
    intro c
    obtain ⟨s, rfl⟩ := hp c
    exact ⟨_, hψι s⟩
  have heq := hspan.trans hker.symm
  refine ⟨hspan, (Ideal.quotientEquivAlgOfEq R heq).trans
    (Ideal.quotientKerAlgEquivOfSurjective hψsurj), ?_⟩
  intro s
  rw [AlgEquiv.symm_apply_eq, AlgEquiv.trans_apply, Ideal.quotientEquivAlgOfEq_mk]
  exact (hψι s).symm

theorem wc_pfc_ssp_generation : ∀ (R : Type u) [CommRing R] (n δ : ℕ) (I : Ideal (MvPolynomial (Fin n) R)) (h : MvPolynomial (Fin n) R) (N : ℕ) (q : Fin n → MvPolynomial (Fin n) R) (Ah : Fin δ → Fin n → MvPolynomial (Fin n) R) (Bh : Fin n → Fin δ → MvPolynomial (Fin n) R), (∀ j, q j ∈ I) → (∀ g ∈ I, h ^ N * g - ∑ j, MvPolynomial.pderiv j g * q j ∈ I ^ 2) → (∀ g ∈ I, ∀ i, h ^ N * MvPolynomial.pderiv i g - ∑ j, MvPolynomial.pderiv j g * MvPolynomial.pderiv i (q j) ∈ I) → (∀ l l', ∑ j, Ah l j * Bh j l' - (if l = l' then h ^ N else 0) ∈ I) → (∀ i k, ∑ l, Bh i l * Ah l k - (if i = k then h ^ N else 0) + MvPolynomial.pderiv k (q i) ∈ I) → (∀ l : Fin δ, MvPolynomial.rename (Fin.castAdd δ) h ^ (2 * N) * MvPolynomial.X (Fin.natAdd n l) ∈ Ideal.span (Set.range fun i : Fin n => MvPolynomial.rename (Fin.castAdd δ) (q i) + ∑ l', MvPolynomial.rename (Fin.castAdd δ) (Bh i l') * MvPolynomial.X (Fin.natAdd n l')) + (Ideal.map (MvPolynomial.rename (Fin.castAdd δ)) I ⊔ Ideal.span (Set.range fun l' : Fin δ => (MvPolynomial.X (Fin.natAdd n l') : MvPolynomial (Fin (n + δ)) R))) ^ 2) ∧ ∀ g ∈ I, MvPolynomial.rename (Fin.castAdd δ) h ^ (2 * N) * MvPolynomial.rename (Fin.castAdd δ) g ∈ Ideal.span (Set.range fun i : Fin n => MvPolynomial.rename (Fin.castAdd δ) (q i) + ∑ l', MvPolynomial.rename (Fin.castAdd δ) (Bh i l') * MvPolynomial.X (Fin.natAdd n l')) + (Ideal.map (MvPolynomial.rename (Fin.castAdd δ)) I ⊔ Ideal.span (Set.range fun l' : Fin δ => (MvPolynomial.X (Fin.natAdd n l') : MvPolynomial (Fin (n + δ)) R))) ^ 2 :=
by
  intro R _ n δ I h N q Ah Bh hq hD2 hDS hD3 hD4
  classical

  have hAQ : ∀ l k, ∑ i, Ah l i * MvPolynomial.pderiv k (q i) ∈ I := by
    intro l k
    have t1 : ∑ i, Ah l i * (∑ l', Bh i l' * Ah l' k - (if i = k then h ^ N else 0) +
        MvPolynomial.pderiv k (q i)) = ∑ i, ∑ l', Ah l i * Bh i l' * Ah l' k - Ah l k * h ^ N +
        ∑ i, Ah l i * MvPolynomial.pderiv k (q i) := by
      simp only [mul_add, mul_sub, Finset.sum_add_distrib, Finset.sum_sub_distrib, Finset.mul_sum,
        mul_ite, mul_zero, Finset.sum_ite_eq, Finset.sum_ite_eq', Finset.mem_univ, ↓reduceIte,
        mul_assoc]
    have t2 : ∑ l', (∑ j, Ah l j * Bh j l' - (if l = l' then h ^ N else 0)) * Ah l' k =
        ∑ l', ∑ j, Ah l j * Bh j l' * Ah l' k - h ^ N * Ah l k := by
      simp only [sub_mul, Finset.sum_sub_distrib, Finset.sum_mul, ite_mul, zero_mul,
        Finset.sum_ite_eq, Finset.sum_ite_eq', Finset.mem_univ, ↓reduceIte]
    have t3 : ∑ i, ∑ l', Ah l i * Bh i l' * Ah l' k = ∑ l', ∑ j, Ah l j * Bh j l' * Ah l' k :=
      Finset.sum_comm
    have e : ∑ i, Ah l i * MvPolynomial.pderiv k (q i) =
        ∑ i, Ah l i * (∑ l', Bh i l' * Ah l' k - (if i = k then h ^ N else 0) +
          MvPolynomial.pderiv k (q i)) -
        ∑ l', (∑ j, Ah l j * Bh j l' - (if l = l' then h ^ N else 0)) * Ah l' k := by
      rw [t1, t2, t3]; ring
    rw [e]
    exact Ideal.sub_mem _ (Ideal.sum_mem _ fun i _ => Ideal.mul_mem_left _ _ (hD4 i k))
      (Ideal.sum_mem _ fun l' _ => Ideal.mul_mem_right _ _ (hD3 l l'))
  have hQB : ∀ i l, ∑ j, MvPolynomial.pderiv j (q i) * Bh j l ∈ I := by
    intro i l
    have t1 : ∑ j, (∑ l', Bh i l' * Ah l' j - (if i = j then h ^ N else 0) +
        MvPolynomial.pderiv j (q i)) * Bh j l = ∑ j, ∑ l', Bh i l' * Ah l' j * Bh j l -
        h ^ N * Bh i l + ∑ j, MvPolynomial.pderiv j (q i) * Bh j l := by
      simp only [add_mul, sub_mul, Finset.sum_add_distrib, Finset.sum_sub_distrib, Finset.sum_mul,
        ite_mul, zero_mul, Finset.sum_ite_eq, Finset.sum_ite_eq', Finset.mem_univ, ↓reduceIte]
    have t2 : ∑ l', Bh i l' * (∑ j, Ah l' j * Bh j l - (if l' = l then h ^ N else 0)) =
        ∑ l', ∑ j, Bh i l' * Ah l' j * Bh j l - Bh i l * h ^ N := by
      simp only [mul_sub, Finset.sum_sub_distrib, Finset.mul_sum, mul_ite, mul_zero,
        Finset.sum_ite_eq, Finset.sum_ite_eq', Finset.mem_univ, ↓reduceIte, mul_assoc]
    have t3 : ∑ j, ∑ l', Bh i l' * Ah l' j * Bh j l = ∑ l', ∑ j, Bh i l' * Ah l' j * Bh j l :=
      Finset.sum_comm
    have e : ∑ j, MvPolynomial.pderiv j (q i) * Bh j l =
        ∑ j, (∑ l', Bh i l' * Ah l' j - (if i = j then h ^ N else 0) +
          MvPolynomial.pderiv j (q i)) * Bh j l -
        ∑ l', Bh i l' * (∑ j, Ah l' j * Bh j l - (if l' = l then h ^ N else 0)) := by
      rw [t1, t2, t3]; ring
    rw [e]
    exact Ideal.sub_mem _ (Ideal.sum_mem _ fun j _ => Ideal.mul_mem_right _ _ (hD4 i j))
      (Ideal.sum_mem _ fun l' _ => Ideal.mul_mem_left _ _ (hD3 l' l))

  set ι : MvPolynomial (Fin n) R →ₐ[R] MvPolynomial (Fin (n + δ)) R :=
    MvPolynomial.rename (Fin.castAdd δ) with hι
  set t : Fin δ → MvPolynomial (Fin (n + δ)) R := fun l => MvPolynomial.X (Fin.natAdd n l) with ht
  set J : Ideal (MvPolynomial (Fin (n + δ)) R) := Ideal.map ι I ⊔ Ideal.span (Set.range t) with hJ
  set F : Fin n → MvPolynomial (Fin (n + δ)) R := fun i => ι (q i) + ∑ l', ι (Bh i l') * t l'
    with hF

  have K1 : ∀ x ∈ I, ι x ∈ J := fun x hx => Ideal.mem_sup_left (Ideal.mem_map_of_mem _ hx)
  have K2 : ∀ l, t l ∈ J := fun l => Ideal.mem_sup_right (Ideal.subset_span ⟨l, rfl⟩)
  have K3 : ∀ x ∈ I ^ 2, ι x ∈ J ^ 2 := by
    intro x hx
    have h1 : ι x ∈ Ideal.map ι (I ^ 2) := Ideal.mem_map_of_mem _ hx
    rw [Ideal.map_pow] at h1
    exact Ideal.pow_right_mono (le_sup_left : Ideal.map ι I ≤ J) 2 h1
  have K4 : ∀ x ∈ I, ∀ l, ι x * t l ∈ J ^ 2 := by
    intro x hx l
    rw [pow_two]
    exact Ideal.mul_mem_mul (K1 x hx) (K2 l)
  have K5 : ∀ (z : MvPolynomial (Fin (n + δ)) R) (c : Fin n → MvPolynomial (Fin (n + δ)) R),
      z - ∑ i, c i * F i ∈ J ^ 2 → z ∈ Ideal.span (Set.range F) + J ^ 2 := by
    intro z c hz
    have e : z = (z - ∑ i, c i * F i) + ∑ i, c i * F i := by ring
    rw [e, Submodule.add_eq_sup]
    exact Ideal.add_mem _ (Ideal.mem_sup_right hz) (Ideal.sum_mem _ fun i _ =>
      Ideal.mem_sup_left (Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨i, rfl⟩)))

  have Gt : ∀ l, ι h ^ (2 * N) * t l ∈ Ideal.span (Set.range F) + J ^ 2 := by
    intro l
    have hγI : ∑ i, Ah l i * q i ∈ I := Ideal.sum_mem _ fun i _ => Ideal.mul_mem_left _ _ (hq i)
    have hdγ : ∀ j, MvPolynomial.pderiv j (∑ i, Ah l i * q i) ∈ I := by
      intro j
      have e : MvPolynomial.pderiv j (∑ i, Ah l i * q i) =
          ∑ i, MvPolynomial.pderiv j (Ah l i) * q i +
          ∑ i, Ah l i * MvPolynomial.pderiv j (q i) := by
        rw [map_sum, ← Finset.sum_add_distrib]
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [MvPolynomial.pderiv_mul]
      rw [e]
      exact Ideal.add_mem _ (Ideal.sum_mem _ fun i _ => Ideal.mul_mem_left _ _ (hq i)) (hAQ l j)
    have hγ2 : h ^ N * ∑ i, Ah l i * q i ∈ I ^ 2 := by
      have e : h ^ N * ∑ i, Ah l i * q i =
          (h ^ N * ∑ i, Ah l i * q i -
            ∑ j, MvPolynomial.pderiv j (∑ i, Ah l i * q i) * q j) +
          ∑ j, MvPolynomial.pderiv j (∑ i, Ah l i * q i) * q j := by ring
      rw [e]
      refine Ideal.add_mem _ (hD2 _ hγI) (Ideal.sum_mem _ fun j _ => ?_)
      rw [pow_two]; exact Ideal.mul_mem_mul (hdγ j) (hq j)
    have hε : ∀ l', h ^ N * (∑ j, Ah l j * Bh j l' - (if l = l' then h ^ N else 0)) ∈ I :=
      fun l' => Ideal.mul_mem_left _ _ (hD3 l l')
    refine K5 _ (fun i => ι (h ^ N * Ah l i)) ?_
    have a1 : ∑ i, ι (h ^ N * Ah l i) * F i = ∑ i, ι (h ^ N * Ah l i) * ι (q i) +
        ∑ i, ∑ l', ι (h ^ N * Ah l i) * ι (Bh i l') * t l' := by
      rw [← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl fun i _ => ?_
      simp only [hF, mul_add, Finset.mul_sum, mul_assoc]
    have a2 : ∑ i, ι (h ^ N * Ah l i) * ι (q i) = ι (h ^ N * ∑ i, Ah l i * q i) := by
      rw [Finset.mul_sum, map_sum]
      refine Finset.sum_congr rfl fun i _ => ?_
      simp only [map_mul]; ring
    have a3 : ∑ i, ∑ l', ι (h ^ N * Ah l i) * ι (Bh i l') * t l' =
        ∑ l', ι (h ^ N * ∑ j, Ah l j * Bh j l') * t l' := by
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl fun l' _ => ?_
      rw [Finset.mul_sum, map_sum, Finset.sum_mul]
      refine Finset.sum_congr rfl fun j _ => ?_
      simp only [map_mul]; ring
    have b1 : ∑ l', ι (h ^ N * (if l = l' then h ^ N else 0)) * t l' = ι h ^ (2 * N) * t l := by
      rw [Finset.sum_eq_single l]
      · rw [if_pos rfl, map_mul, map_pow]; ring
      · intro b _ hb
        rw [if_neg (Ne.symm hb), mul_zero, map_zero, zero_mul]
      · intro hl; exact absurd (Finset.mem_univ l) hl
    have b2 : ∑ l', ι (h ^ N * (∑ j, Ah l j * Bh j l' - (if l = l' then h ^ N else 0))) * t l' =
        ∑ l', ι (h ^ N * ∑ j, Ah l j * Bh j l') * t l' - ι h ^ (2 * N) * t l := by
      rw [← b1, ← Finset.sum_sub_distrib]
      refine Finset.sum_congr rfl fun l' _ => ?_
      rw [mul_sub, map_sub, sub_mul]
    have key : ι h ^ (2 * N) * t l - ∑ i, ι (h ^ N * Ah l i) * F i =
        -(ι (h ^ N * ∑ i, Ah l i * q i) +
          ∑ l', ι (h ^ N * (∑ j, Ah l j * Bh j l' - (if l = l' then h ^ N else 0))) * t l') := by
      rw [a1, a2, a3, b2]; ring
    rw [key]
    exact (Ideal.neg_mem_iff _).mpr (Ideal.add_mem _ (K3 _ hγ2)
      (Ideal.sum_mem _ fun l' _ => K4 _ (hε l') l'))

  have Gg : ∀ g ∈ I, ι h ^ (2 * N) * ι g ∈ Ideal.span (Set.range F) + J ^ 2 := by
    intro g hg
    have hw : ∀ l, h ^ N * ∑ j, MvPolynomial.pderiv j g * Bh j l ∈ I := by
      intro l
      have c1 : ∑ j, (∑ i, MvPolynomial.pderiv i g * MvPolynomial.pderiv j (q i)) * Bh j l =
          ∑ i, MvPolynomial.pderiv i g * ∑ j, MvPolynomial.pderiv j (q i) * Bh j l := by
        simp only [Finset.sum_mul, Finset.mul_sum]
        rw [Finset.sum_comm]
        exact Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => by ring
      have e : h ^ N * ∑ j, MvPolynomial.pderiv j g * Bh j l =
          ∑ j, (h ^ N * MvPolynomial.pderiv j g -
            ∑ i, MvPolynomial.pderiv i g * MvPolynomial.pderiv j (q i)) * Bh j l +
          ∑ i, MvPolynomial.pderiv i g * ∑ j, MvPolynomial.pderiv j (q i) * Bh j l := by
        rw [← c1, ← Finset.sum_add_distrib, Finset.mul_sum]
        exact Finset.sum_congr rfl fun j _ => by ring
      rw [e]
      exact Ideal.add_mem _ (Ideal.sum_mem _ fun j _ => Ideal.mul_mem_right _ _ (hDS g hg j))
        (Ideal.sum_mem _ fun i _ => Ideal.mul_mem_left _ _ (hQB i l))
    have hσ : h ^ N * (h ^ N * g - ∑ j, MvPolynomial.pderiv j g * q j) ∈ I ^ 2 :=
      Ideal.mul_mem_left _ _ (hD2 g hg)
    refine K5 _ (fun j => ι (h ^ N * MvPolynomial.pderiv j g)) ?_
    have a1 : ∑ j, ι (h ^ N * MvPolynomial.pderiv j g) * F j =
        ∑ j, ι (h ^ N * MvPolynomial.pderiv j g) * ι (q j) +
        ∑ j, ∑ l, ι (h ^ N * MvPolynomial.pderiv j g) * ι (Bh j l) * t l := by
      rw [← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl fun j _ => ?_
      simp only [hF, mul_add, Finset.mul_sum, mul_assoc]
    have a2 : ι (h ^ N * (h ^ N * g - ∑ j, MvPolynomial.pderiv j g * q j)) =
        ι h ^ (2 * N) * ι g - ∑ j, ι (h ^ N * MvPolynomial.pderiv j g) * ι (q j) := by
      simp only [map_mul, map_sub, map_sum, map_pow]
      rw [mul_sub, Finset.mul_sum]
      have s : ∑ j, ι h ^ N * (ι (MvPolynomial.pderiv j g) * ι (q j)) =
          ∑ j, ι h ^ N * ι (MvPolynomial.pderiv j g) * ι (q j) :=
        Finset.sum_congr rfl fun j _ => by ring
      rw [s]; ring
    have a3 : ∑ j, ∑ l, ι (h ^ N * MvPolynomial.pderiv j g) * ι (Bh j l) * t l =
        ∑ l, ι (h ^ N * ∑ j, MvPolynomial.pderiv j g * Bh j l) * t l := by
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl fun l _ => ?_
      rw [Finset.mul_sum, map_sum, Finset.sum_mul]
      refine Finset.sum_congr rfl fun j _ => ?_
      simp only [map_mul]; ring
    have key : ι h ^ (2 * N) * ι g - ∑ j, ι (h ^ N * MvPolynomial.pderiv j g) * F j =
        ι (h ^ N * (h ^ N * g - ∑ j, MvPolynomial.pderiv j g * q j)) -
        ∑ l, ι (h ^ N * ∑ j, MvPolynomial.pderiv j g * Bh j l) * t l := by
      rw [a1, a2, a3]; ring
    rw [key]
    exact Ideal.sub_mem _ (K3 _ hσ) (Ideal.sum_mem _ fun l _ => K4 _ (hw l) l)
  exact ⟨Gt, Gg⟩

theorem wc_pfc_ssp_jacobian_det : ∀ (R : Type u) [CommRing R] (n δ : ℕ) (I : Ideal (MvPolynomial (Fin n) R)) (h : MvPolynomial (Fin n) R) (N : ℕ) (q : Fin n → MvPolynomial (Fin n) R) (Ah : Fin δ → Fin n → MvPolynomial (Fin n) R) (Bh : Fin n → Fin δ → MvPolynomial (Fin n) R), (∀ i k, ∑ l, Bh i l * Ah l k - (if i = k then h ^ N else 0) + MvPolynomial.pderiv k (q i) ∈ I) → (Matrix.of (fun (i : Fin n) (k : Fin (n + δ)) => MvPolynomial.pderiv k (MvPolynomial.rename (Fin.castAdd δ) (q i) + ∑ l, MvPolynomial.rename (Fin.castAdd δ) (Bh i l) * MvPolynomial.X (Fin.natAdd n l))) * Matrix.of (fun (k : Fin (n + δ)) (j : Fin n) => Fin.append (fun k' : Fin n => if k' = j then (1 : MvPolynomial (Fin (n + δ)) R) else 0) (fun l : Fin δ => MvPolynomial.rename (Fin.castAdd δ) (Ah l j)) k)).det - MvPolynomial.rename (Fin.castAdd δ) h ^ (N * n) ∈ Ideal.map (MvPolynomial.rename (Fin.castAdd δ)) I ⊔ Ideal.span (Set.range fun l : Fin δ => (MvPolynomial.X (Fin.natAdd n l) : MvPolynomial (Fin (n + δ)) R)) :=
by
  intro R _ n δ I h N q Ah Bh hD4

  have s1 : ∀ (J : Ideal (MvPolynomial (Fin (n + δ)) R))
      (M : Matrix (Fin n) (Fin n) (MvPolynomial (Fin (n + δ)) R)) (d : MvPolynomial (Fin (n + δ)) R),
      (∀ i j, M i j - (if i = j then d else 0) ∈ J) → M.det - d ^ n ∈ J := by
    intro J M d hM
    rw [← Ideal.Quotient.eq]
    have hmat : (Ideal.Quotient.mk J).mapMatrix M =
        Matrix.diagonal (fun _ => Ideal.Quotient.mk J d) := by
      ext i j
      rw [RingHom.mapMatrix_apply, Matrix.map_apply, Matrix.diagonal_apply,
        Ideal.Quotient.eq.mpr (hM i j)]
      split_ifs <;> simp
    rw [RingHom.map_det, hmat, Matrix.det_diagonal, Finset.prod_const, Finset.card_univ,
      Fintype.card_fin, map_pow]

  have hne : ∀ (j : Fin n) (l : Fin δ), (Fin.castAdd δ j : Fin (n + δ)) ≠ Fin.natAdd n l := by
    intro j l hc
    have h1 := congrArg Fin.val hc
    simp only [Fin.val_castAdd, Fin.val_natAdd] at h1
    have h2 := j.isLt
    omega

  have hZ : ∀ (l : Fin δ) (g : MvPolynomial (Fin n) R),
      MvPolynomial.pderiv (Fin.natAdd n l) (MvPolynomial.rename (Fin.castAdd δ) g) = 0 := by
    intro l g
    induction g using MvPolynomial.induction_on with
    | C a => rw [MvPolynomial.rename_C, MvPolynomial.pderiv_C]
    | add p r hp hr => rw [map_add, map_add, hp, hr, add_zero]
    | mul_X p i hp =>
      rw [map_mul, MvPolynomial.rename_X, MvPolynomial.pderiv_mul, hp,
        MvPolynomial.pderiv_X_of_ne (hne i l), zero_mul, mul_zero, add_zero]

  have s4 : ∀ (f : MvPolynomial (Fin n) R) (b : Fin δ → MvPolynomial (Fin n) R) (j : Fin n),
      MvPolynomial.pderiv (Fin.castAdd δ j) (MvPolynomial.rename (Fin.castAdd δ) f +
        ∑ l, MvPolynomial.rename (Fin.castAdd δ) (b l) * MvPolynomial.X (Fin.natAdd n l)) =
      MvPolynomial.rename (Fin.castAdd δ) (MvPolynomial.pderiv j f) +
        ∑ l, MvPolynomial.rename (Fin.castAdd δ) (MvPolynomial.pderiv j (b l)) *
          MvPolynomial.X (Fin.natAdd n l) := by
    intro f b j
    rw [map_add, map_sum, MvPolynomial.pderiv_rename (Fin.castAdd_injective n δ)]
    congr 1
    refine Finset.sum_congr rfl (fun l _ => ?_)
    rw [MvPolynomial.pderiv_mul, MvPolynomial.pderiv_rename (Fin.castAdd_injective n δ),
      MvPolynomial.pderiv_X_of_ne (hne j l).symm, mul_zero, add_zero]

  have s3 : ∀ (f : MvPolynomial (Fin n) R) (b : Fin δ → MvPolynomial (Fin n) R) (l : Fin δ),
      MvPolynomial.pderiv (Fin.natAdd n l) (MvPolynomial.rename (Fin.castAdd δ) f +
        ∑ l', MvPolynomial.rename (Fin.castAdd δ) (b l') * MvPolynomial.X (Fin.natAdd n l')) =
      MvPolynomial.rename (Fin.castAdd δ) (b l) := by
    intro f b l
    rw [map_add, map_sum, hZ, zero_add, Finset.sum_eq_single l]
    · rw [MvPolynomial.pderiv_mul, hZ, MvPolynomial.pderiv_X_self, zero_mul, zero_add, mul_one]
    · intro l' _ hl'
      rw [MvPolynomial.pderiv_mul, hZ, MvPolynomial.pderiv_X_of_ne, zero_mul, zero_add, mul_zero]
      exact fun hc => hl' (Fin.natAdd_injective _ _ hc)
    · intro hl; exact absurd (Finset.mem_univ l) hl

  have s2 : ∀ (Jac : Matrix (Fin n) (Fin (n + δ)) (MvPolynomial (Fin (n + δ)) R)) (i j : Fin n),
      (Jac * Matrix.of (fun (k : Fin (n + δ)) (j' : Fin n) => Fin.append
        (fun k' : Fin n => if k' = j' then (1 : MvPolynomial (Fin (n + δ)) R) else 0)
        (fun l : Fin δ => MvPolynomial.rename (Fin.castAdd δ) (Ah l j')) k)) i j =
      Jac i (Fin.castAdd δ j) + ∑ l, Jac i (Fin.natAdd n l) *
        MvPolynomial.rename (Fin.castAdd δ) (Ah l j) := by
    intro Jac i j
    rw [Matrix.mul_apply, Fin.sum_univ_add]
    simp only [Matrix.of_apply, Fin.append_left, Fin.append_right, mul_ite, mul_one, mul_zero,
      Finset.sum_ite_eq', Finset.mem_univ, if_true]

  rw [pow_mul]
  apply s1
  intro i j
  rw [s2]
  simp only [Matrix.of_apply]
  rw [s4]
  simp only [s3]
  have e1 : MvPolynomial.rename (Fin.castAdd δ) (∑ l, Bh i l * Ah l j -
      (if i = j then h ^ N else 0) + MvPolynomial.pderiv j (q i)) ∈
      Ideal.map (MvPolynomial.rename (Fin.castAdd δ)) I ⊔
        Ideal.span (Set.range fun l : Fin δ =>
          (MvPolynomial.X (Fin.natAdd n l) : MvPolynomial (Fin (n + δ)) R)) :=
    Ideal.mem_sup_left (Ideal.mem_map_of_mem (MvPolynomial.rename (Fin.castAdd δ)) (hD4 i j))
  have e2 : ∑ l, MvPolynomial.rename (Fin.castAdd δ) (MvPolynomial.pderiv j (Bh i l)) *
      MvPolynomial.X (Fin.natAdd n l) ∈ Ideal.map (MvPolynomial.rename (Fin.castAdd δ)) I ⊔
        Ideal.span (Set.range fun l : Fin δ =>
          (MvPolynomial.X (Fin.natAdd n l) : MvPolynomial (Fin (n + δ)) R)) :=
    Ideal.mem_sup_right (Ideal.sum_mem _ fun l _ =>
      Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨l, rfl⟩))
  convert Ideal.add_mem _ e1 e2 using 1
  rw [map_add, map_sub, map_sum, apply_ite (MvPolynomial.rename (Fin.castAdd δ)), map_pow,
    map_zero]
  simp only [map_mul]
  ring

theorem wc_pfc_ssp_cauchy_binet : ∀ (T : Type u) [CommRing T] (c N : ℕ) (M : Matrix (Fin c) (Fin N) T) (Ψ : Matrix (Fin N) (Fin c) T), (M * Ψ).det ∈ Ideal.span (Set.range fun I : Fin c ↪ Fin N => (Matrix.of fun j l : Fin c => M j (I l)).det) :=
by
  intro T _ c N M Ψ
  classical
  have hexp : (M * Ψ).det = ∑ p : Fin c → Fin N,
      (∏ l, Ψ (p l) l) * (Matrix.of fun j l : Fin c => M j (p l)).det := by
    simp only [Matrix.det_apply', Matrix.mul_apply, Finset.prod_univ_sum, Fintype.piFinset_univ,
      Finset.mul_sum, Matrix.of_apply]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun p _ => Finset.sum_congr rfl fun σ _ => ?_
    rw [Finset.prod_mul_distrib]
    ring
  rw [hexp]
  refine Ideal.sum_mem _ fun p _ => Ideal.mul_mem_left _ _ ?_
  by_cases hp : Function.Injective p
  · exact Ideal.subset_span ⟨⟨p, hp⟩, rfl⟩
  · simp only [Function.Injective, not_forall] at hp
    obtain ⟨i, i', h, hne⟩ := hp
    rw [Matrix.det_zero_of_column_eq hne (fun k => by simp [h])]
    exact Ideal.zero_mem _

theorem wc_pfc_lmp_strictly_standard_powers : ∀ (R : Type u) [CommRing R] (C : Type u) [CommRing C] [Algebra R C] [Algebra.FinitePresentation R C] (a : C), Algebra.Smooth R (Localization.Away a) → Module.Free (Localization.Away a) (Ω[Localization.Away a⁄R]) → ∃ e₀ : ℕ, ∀ e : ℕ, e₀ ≤ e → wcPfcStrictStd R C (a ^ e) :=
by
  intro R _ C _ _ _ a hsm hfree
  classical
  obtain ⟨n, p, hp, hfg⟩ := Algebra.FinitePresentation.out (R := R) (A := C)
  have hfg' : (RingHom.ker p).FG := hfg
  obtain ⟨h, rfl⟩ := hp a
  obtain ⟨m₀, g, hg⟩ := Submodule.fg_iff_exists_fin_generating_family.mp hfg'
  have hg' : Ideal.span (Set.range g) = RingHom.ker p := hg
  have hgI : ∀ k, g k ∈ RingHom.ker p := fun k => by
    rw [← hg']; exact Ideal.subset_span ⟨k, rfl⟩

  obtain ⟨N₀, q₀, hq₀, hstar₀⟩ := wc_pfc_ssp_smooth_conormal_local R C n p hp h hsm
  choose sk hsk using fun k => hstar₀ (g k) (hgI k)
  obtain ⟨s, hs⟩ : ∃ s : ℕ, s = ∑ k, sk k := ⟨_, rfl⟩
  have hsk_le : ∀ k, sk k ≤ s := fun k => by
    rw [hs]; exact Finset.single_le_sum (f := sk) (fun j _ => Nat.zero_le _) (Finset.mem_univ k)
  have hq₁ : ∀ j, h ^ s * q₀ j ∈ RingHom.ker p := fun j => Ideal.mul_mem_left _ _ (hq₀ j)
  have hstar₁ : ∀ x ∈ RingHom.ker p, h ^ (N₀ + s) * x -
      ∑ j, MvPolynomial.pderiv j x * (h ^ s * q₀ j) ∈ RingHom.ker p ^ 2 := by
    intro x hx
    rw [← hg'] at hx
    induction hx using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨k, rfl⟩ := hx
      obtain ⟨d, hd⟩ : ∃ d, s = d + sk k := ⟨s - sk k, by have := hsk_le k; omega⟩
      have e : h ^ (N₀ + s) * g k - ∑ j, MvPolynomial.pderiv j (g k) * (h ^ s * q₀ j) =
          h ^ d * (h ^ sk k * (h ^ N₀ * g k - ∑ j, MvPolynomial.pderiv j (g k) * q₀ j)) := by
        rw [hd, mul_sub, mul_sub, Finset.mul_sum, Finset.mul_sum]
        congr 1
        · ring
        · apply Finset.sum_congr rfl; intro j _; ring
      rw [e]; exact Ideal.mul_mem_left _ _ (hsk k)
    | zero => simp
    | add x y _ _ hx hy =>
      have e : h ^ (N₀ + s) * (x + y) - ∑ j, MvPolynomial.pderiv j (x + y) * (h ^ s * q₀ j) =
          (h ^ (N₀ + s) * x - ∑ j, MvPolynomial.pderiv j x * (h ^ s * q₀ j)) +
          (h ^ (N₀ + s) * y - ∑ j, MvPolynomial.pderiv j y * (h ^ s * q₀ j)) := by
        simp only [map_add, add_mul, Finset.sum_add_distrib]; ring
      rw [e]; exact Ideal.add_mem _ hx hy
    | smul a x hx' hx =>
      have hxI : x ∈ RingHom.ker p := by rw [← hg']; exact hx'
      rw [smul_eq_mul]
      have e : h ^ (N₀ + s) * (a * x) - ∑ j, MvPolynomial.pderiv j (a * x) * (h ^ s * q₀ j) =
          a * (h ^ (N₀ + s) * x - ∑ j, MvPolynomial.pderiv j x * (h ^ s * q₀ j)) -
          ∑ j, MvPolynomial.pderiv j a * (x * (h ^ s * q₀ j)) := by
        rw [mul_sub, Finset.mul_sum, sub_sub, ← Finset.sum_add_distrib]
        congr 1
        · ring
        · apply Finset.sum_congr rfl; intro j _; rw [MvPolynomial.pderiv_mul]; ring
      rw [e]
      refine Ideal.sub_mem _ (Ideal.mul_mem_left _ _ hx)
        (Ideal.sum_mem _ fun j _ => Ideal.mul_mem_left _ _ ?_)
      rw [pow_two]; exact Ideal.mul_mem_mul hxI (hq₁ j)

  have hd2 : ∀ (I : Ideal (MvPolynomial (Fin n) R)) (i : Fin n) (x : MvPolynomial (Fin n) R),
      x ∈ I ^ 2 → MvPolynomial.pderiv i x ∈ I := by
    intro I i x hx
    rw [pow_two] at hx
    refine Submodule.mul_induction_on hx ?_ ?_
    · intro a ha b hb
      rw [MvPolynomial.pderiv_mul]
      exact Ideal.add_mem _ (Ideal.mul_mem_left _ _ hb) (Ideal.mul_mem_right _ _ ha)
    · intro x y hx hy
      rw [map_add]; exact Ideal.add_mem _ hx hy
  have hDSgen : ∀ (I : Ideal (MvPolynomial (Fin n) R)) (N : ℕ) (q : Fin n → MvPolynomial (Fin n) R),
      (∀ j, q j ∈ I) → (∀ g ∈ I, h ^ N * g - ∑ j, MvPolynomial.pderiv j g * q j ∈ I ^ 2) →
      ∀ g ∈ I, ∀ i, h ^ N * MvPolynomial.pderiv i g -
        ∑ j, MvPolynomial.pderiv j g * MvPolynomial.pderiv i (q j) ∈ I := by
    intro I N q hq hst g hg i
    have h1 := hd2 I i _ (hst g hg)
    rw [map_sub, MvPolynomial.pderiv_mul, map_sum] at h1
    simp only [MvPolynomial.pderiv_mul] at h1
    have e : h ^ N * MvPolynomial.pderiv i g -
        ∑ j, MvPolynomial.pderiv j g * MvPolynomial.pderiv i (q j) =
        (MvPolynomial.pderiv i (h ^ N) * g + h ^ N * MvPolynomial.pderiv i g -
          ∑ j, (MvPolynomial.pderiv i (MvPolynomial.pderiv j g) * q j +
            MvPolynomial.pderiv j g * MvPolynomial.pderiv i (q j))) -
        MvPolynomial.pderiv i (h ^ N) * g +
        ∑ j, MvPolynomial.pderiv i (MvPolynomial.pderiv j g) * q j := by
      rw [Finset.sum_add_distrib]; ring
    rw [e]
    exact Ideal.add_mem _ (Ideal.sub_mem _ h1 (Ideal.mul_mem_left _ _ hg))
      (Ideal.sum_mem _ fun j _ => Ideal.mul_mem_left _ _ (hq j))

  have hDS₁ := hDSgen (RingHom.ker p) (N₀ + s) (fun j => h ^ s * q₀ j) hq₁ hstar₁
  obtain ⟨H1, H2⟩ := wc_pfc_ssp_kaehler_presentation R C n p hp
  obtain ⟨hspanΩ, hrows, hproj⟩ := wc_pfc_ssp_localized_projector R C n p hp H1 H2 h (N₀ + s)
    (fun j => h ^ s * q₀ j) hq₁ hDS₁
  obtain ⟨δ, A, B, hAB, hBA⟩ := wc_pfc_ssp_split_matrices (Localization.Away (p h))
    (Ω[Localization.Away (p h)⁄R]) hfree n
    (fun j => KaehlerDifferential.D R (Localization.Away (p h))
      (algebraMap C (Localization.Away (p h)) (p (MvPolynomial.X j))))
    (Matrix.of fun i k => IsLocalization.Away.invSelf (S := Localization.Away (p h)) (p h) ^ (N₀ + s) *
      algebraMap C (Localization.Away (p h)) (p (MvPolynomial.pderiv k (h ^ s * q₀ i))))
    hspanΩ hrows hproj
  obtain ⟨K, Ah, Bh, hD3, hD4⟩ := wc_pfc_ssp_clear_denominators R C n p hp h (N₀ + s)
    (fun j => h ^ s * q₀ j) hq₁ δ A B hAB hBA

  have hq2 : ∀ j, h ^ K * (h ^ s * q₀ j) ∈ RingHom.ker p := fun j => Ideal.mul_mem_left _ _ (hq₁ j)
  have hstar2 : ∀ x ∈ RingHom.ker p, h ^ (N₀ + s + K) * x -
      ∑ j, MvPolynomial.pderiv j x * (h ^ K * (h ^ s * q₀ j)) ∈ RingHom.ker p ^ 2 := by
    intro x hx
    have e : h ^ (N₀ + s + K) * x - ∑ j, MvPolynomial.pderiv j x * (h ^ K * (h ^ s * q₀ j)) =
        h ^ K * (h ^ (N₀ + s) * x - ∑ j, MvPolynomial.pderiv j x * (h ^ s * q₀ j)) := by
      rw [mul_sub, Finset.mul_sum]
      congr 1
      · ring
      · apply Finset.sum_congr rfl; intro j _; ring
    rw [e]; exact Ideal.mul_mem_left _ _ (hstar₁ x hx)
  have hDS2 := hDSgen (RingHom.ker p) (N₀ + s + K) (fun j => h ^ K * (h ^ s * q₀ j)) hq2 hstar2
  obtain ⟨hGt, hGg⟩ := wc_pfc_ssp_generation R n δ (RingHom.ker p) h (N₀ + s + K)
    (fun j => h ^ K * (h ^ s * q₀ j)) Ah Bh hq2 hstar2 hDS2 hD3 hD4
  have hdiff := wc_pfc_ssp_jacobian_det R n δ (RingHom.ker p) h (N₀ + s + K)
    (fun j => h ^ K * (h ^ s * q₀ j)) Ah Bh hD4

  set F : Fin n → MvPolynomial (Fin (n + δ)) R := fun i =>
    MvPolynomial.rename (Fin.castAdd δ) (h ^ K * (h ^ s * q₀ i)) +
      ∑ l, MvPolynomial.rename (Fin.castAdd δ) (Bh i l) * MvPolynomial.X (Fin.natAdd n l) with hF
  set f : Fin (n + (m₀ + δ)) → MvPolynomial (Fin (n + δ)) R := Fin.append F
    (Fin.append (fun k => MvPolynomial.rename (Fin.castAdd δ) (g k))
      (fun l : Fin δ => (MvPolynomial.X (Fin.natAdd n l) : MvPolynomial (Fin (n + δ)) R))) with hf
  have hFJ : ∀ i, F i ∈ Ideal.map (MvPolynomial.rename (Fin.castAdd δ)) (RingHom.ker p) ⊔
      Ideal.span (Set.range fun l : Fin δ =>
        (MvPolynomial.X (Fin.natAdd n l) : MvPolynomial (Fin (n + δ)) R)) := by
    intro i
    show _ + _ ∈ _
    exact Ideal.add_mem _ (Ideal.mem_sup_left (Ideal.mem_map_of_mem _ (hq2 i)))
      (Ideal.mem_sup_right (Ideal.sum_mem _ fun l _ =>
        Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨l, rfl⟩)))
  obtain ⟨hspan, e, he⟩ : Ideal.span (Set.range f) =
      Ideal.map (MvPolynomial.rename (Fin.castAdd δ)) (RingHom.ker p) ⊔
        Ideal.span (Set.range fun l : Fin δ =>
          (MvPolynomial.X (Fin.natAdd n l) : MvPolynomial (Fin (n + δ)) R)) ∧
      ∃ e : (MvPolynomial (Fin (n + δ)) R ⧸ Ideal.span (Set.range f)) ≃ₐ[R] C,
        ∀ t : MvPolynomial (Fin n) R, e.symm (p t) =
          Ideal.Quotient.mk _ (MvPolynomial.rename (Fin.castAdd δ) t) :=
    wc_pfc_ssp_presentation_extension R C n m₀ δ p hp g hg' F hFJ
  have hcm : n ≤ n + (m₀ + δ) := by omega
  have hcn : n ≤ n + δ := by omega
  have hι : ∀ e' : ℕ, e.symm (p h ^ e') = Ideal.Quotient.mk (Ideal.span (Set.range f))
      (MvPolynomial.rename (Fin.castAdd δ) h ^ e') := by
    intro e'; simp only [map_pow, he]

  refine ⟨(N₀ + s + K) * n + 2 * (N₀ + s + K), fun e' he' =>
    ⟨n + δ, n + (m₀ + δ), n, hcn, hcm, f, e, ?_, ?_⟩⟩
  ·
    rw [hι]
    have hfc : ∀ j : Fin n, f (Fin.castLE hcm j) = F j := by
      intro j
      have : Fin.castLE hcm j = Fin.castAdd (m₀ + δ) j := Fin.ext rfl
      rw [this]; exact Fin.append_left _ _ _
    have hCB := wc_pfc_ssp_cauchy_binet (MvPolynomial (Fin (n + δ)) R) n (n + δ)
      (Matrix.of fun (i : Fin n) (k : Fin (n + δ)) => MvPolynomial.pderiv k (F i))
      (Matrix.of fun (k : Fin (n + δ)) (j : Fin n) => Fin.append
        (fun k' : Fin n => if k' = j then (1 : MvPolynomial (Fin (n + δ)) R) else 0)
        (fun l : Fin δ => MvPolynomial.rename (Fin.castAdd δ) (Ah l j)) k)
    have hle : Ideal.span (Set.range fun I : Fin n ↪ Fin (n + δ) =>
        (Matrix.of fun j l : Fin n => (Matrix.of fun (i : Fin n) (k : Fin (n + δ)) =>
          MvPolynomial.pderiv k (F i)) j (I l)).det) ≤
        Ideal.span (Set.range (fun I : Fin n ↪ Fin (n + δ) => Matrix.det (Matrix.of
          (fun j l : Fin n => MvPolynomial.pderiv (I l) (f (Fin.castLE hcm j)))))) := by
      apply Ideal.span_mono
      rintro _ ⟨I, rfl⟩
      refine ⟨I, ?_⟩
      simp only [Matrix.of_apply, hfc]
    have hq_eq : Ideal.Quotient.mk (Ideal.span (Set.range f))
        ((Matrix.of fun (i : Fin n) (k : Fin (n + δ)) => MvPolynomial.pderiv k (F i)) *
          (Matrix.of fun (k : Fin (n + δ)) (j : Fin n) => Fin.append
            (fun k' : Fin n => if k' = j then (1 : MvPolynomial (Fin (n + δ)) R) else 0)
            (fun l : Fin δ => MvPolynomial.rename (Fin.castAdd δ) (Ah l j)) k)).det =
        Ideal.Quotient.mk (Ideal.span (Set.range f))
          (MvPolynomial.rename (Fin.castAdd δ) h ^ ((N₀ + s + K) * n)) := by
      rw [Ideal.Quotient.eq, hspan]; exact hdiff
    obtain ⟨d, rfl⟩ : ∃ d, e' = d + (N₀ + s + K) * n := ⟨e' - (N₀ + s + K) * n, by omega⟩
    rw [pow_add, map_mul, ← hq_eq]
    exact Ideal.mul_mem_left _ _ (Ideal.mem_map_of_mem _ (hle hCB))
  ·
    intro j hj
    refine ⟨MvPolynomial.rename (Fin.castAdd δ) h ^ e', (hι e').symm, ?_⟩
    have hrange : Set.range F ⊆ f '' {i | i.val < n} := by
      rintro _ ⟨i, rfl⟩
      exact ⟨Fin.castAdd (m₀ + δ) i, i.isLt, Fin.append_left _ _ _⟩
    have hmono : Ideal.span (Set.range F) +
        (Ideal.map (MvPolynomial.rename (Fin.castAdd δ)) (RingHom.ker p) ⊔
          Ideal.span (Set.range fun l : Fin δ =>
            (MvPolynomial.X (Fin.natAdd n l) : MvPolynomial (Fin (n + δ)) R))) ^ 2 ≤
        Ideal.span (f '' {i | i.val < n}) + Ideal.span (Set.range f) ^ 2 := by
      rw [hspan, Submodule.add_eq_sup, Submodule.add_eq_sup]
      exact sup_le_sup_right (Ideal.span_mono hrange) _
    obtain ⟨d, rfl⟩ : ∃ d, e' = d + 2 * (N₀ + s + K) := ⟨e' - 2 * (N₀ + s + K), by omega⟩
    refine hmono ?_
    rw [pow_add, mul_assoc]
    refine Ideal.mul_mem_left _ _ ?_
    induction j using Fin.addCases with
    | left i =>
      have h1 : (Fin.castAdd (m₀ + δ) i : ℕ) = i := rfl
      have h2 := i.isLt
      omega
    | right j' =>
      induction j' using Fin.addCases with
      | left k =>
        have hfj : f (Fin.natAdd n (Fin.castAdd δ k)) = MvPolynomial.rename (Fin.castAdd δ) (g k) :=
          (Fin.append_right _ _ _).trans (Fin.append_left _ _ _)
        rw [hfj]; exact hGg (g k) (hgI k)
      | right l =>
        have hfj : f (Fin.natAdd n (Fin.natAdd m₀ l)) = MvPolynomial.X (Fin.natAdd n l) :=
          (Fin.append_right _ _ _).trans (Fin.append_right _ _ _)
        rw [hfj]; exact hGt l

theorem wc_pfc_cz_fp_quotient_base_change : ∀ (R : Type u) [CommRing R] (A : Type u) [CommRing A] [Algebra R A] [Algebra.FinitePresentation R A] (J : Ideal R), Algebra.FinitePresentation (R ⧸ J) (A ⧸ Ideal.map (algebraMap R A) J) :=
by
  intro R _ A _ _ _ J
  haveI : Algebra.FinitePresentation (R ⧸ J) (TensorProduct R (R ⧸ J) A) :=
    Algebra.FinitePresentation.baseChange (R ⧸ J)
  let f : TensorProduct R (R ⧸ J) A ≃+* A ⧸ Ideal.map (algebraMap R A) J :=
    (Algebra.TensorProduct.comm R (R ⧸ J) A).toRingEquiv.trans
      (Algebra.TensorProduct.quotIdealMapEquivTensorQuot A J).symm.toRingEquiv
  have hf : ∀ x : R ⧸ J, f (algebraMap (R ⧸ J) (TensorProduct R (R ⧸ J) A) x) =
      algebraMap (R ⧸ J) (A ⧸ Ideal.map (algebraMap R A) J) x := by
    intro x
    obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective x
    have h1 : algebraMap (R ⧸ J) (TensorProduct R (R ⧸ J) A) (Ideal.Quotient.mk J r) =
        (Ideal.Quotient.mk J r) ⊗ₜ[R] (1 : A) := rfl
    rw [h1, Ideal.Quotient.algebraMap_quotient_map_quotient]
    show (Algebra.TensorProduct.quotIdealMapEquivTensorQuot A J).symm
        ((Algebra.TensorProduct.comm R (R ⧸ J) A) ((Ideal.Quotient.mk J r) ⊗ₜ[R] (1 : A))) = _
    rw [Algebra.TensorProduct.comm_tmul,
      Algebra.TensorProduct.quotIdealMapEquivTensorQuot_symm_tmul,
      ← Algebra.algebraMap_eq_smul_one]
    rfl
  exact Algebra.FinitePresentation.equiv (AlgEquiv.ofRingEquiv (f := f) hf)

theorem wc_pfc_res_ring_equiv_transport : ∀ (R₁ A₁ Λ₁ R₂ A₂ Λ₂ : Type u) [CommRing R₁] [CommRing A₁] [CommRing Λ₁] [CommRing R₂] [CommRing A₂] [CommRing Λ₂] [Algebra R₁ A₁] [Algebra R₁ Λ₁] [Algebra R₂ A₂] [Algebra R₂ Λ₂] (eR : R₁ ≃+* R₂) (eA : A₁ ≃+* A₂) (eΛ : Λ₁ ≃+* Λ₂) (φ₁ : A₁ →ₐ[R₁] Λ₁) (φ₂ : A₂ →ₐ[R₂] Λ₂) (𝔮₁ : Ideal Λ₁) (𝔮₂ : Ideal Λ₂), (∀ r, eA (algebraMap R₁ A₁ r) = algebraMap R₂ A₂ (eR r)) → (∀ r, eΛ (algebraMap R₁ Λ₁ r) = algebraMap R₂ Λ₂ (eR r)) → (∀ a, φ₂ (eA a) = eΛ (φ₁ a)) → 𝔮₂ = 𝔮₁.map eΛ → wcPfcRes R₁ A₁ Λ₁ φ₁ 𝔮₁ → wcPfcRes R₂ A₂ Λ₂ φ₂ 𝔮₂ :=
by
  intro R₁ A₁ Λ₁ R₂ A₂ Λ₂ _ _ _ _ _ _ _ _ _ _ eR eA eΛ φ₁ φ₂ 𝔮₁ 𝔮₂ h1 h2 h3 h4 hres
  obtain ⟨B, iB, aB, hfp, ψ₁, χ₁, hc, hle, hnot⟩ := hres
  letI inst₂ : Algebra R₂ B := ((algebraMap R₁ B).comp eR.symm.toRingHom).toAlgebra
  have E1 : ∀ r, algebraMap R₂ B r = algebraMap R₁ B (eR.symm r) := fun r => rfl

  have hfp₂ : Algebra.FinitePresentation R₂ B := by
    rw [← RingHom.finitePresentation_algebraMap]
    have e : algebraMap R₂ B = (algebraMap R₁ B).comp eR.symm.toRingHom := rfl
    rw [e]
    apply RingHom.FinitePresentation.comp
    · exact RingHom.finitePresentation_algebraMap.mpr hfp
    · apply RingHom.FinitePresentation.of_surjective _ eR.symm.surjective
      rw [(RingHom.injective_iff_ker_eq_bot eR.symm.toRingHom).mp eR.symm.injective]
      exact Submodule.fg_bot

  have E2 : ∀ r, eA.symm (algebraMap R₂ A₂ r) = algebraMap R₁ A₁ (eR.symm r) := by
    intro r
    rw [RingEquiv.symm_apply_eq, h1, RingEquiv.apply_symm_apply]
  let χ₂ : B →ₐ[R₂] Λ₂ :=
    { (eΛ.toRingHom.comp χ₁.toRingHom) with
      commutes' := fun r => by
        show eΛ (χ₁ (algebraMap R₂ B r)) = algebraMap R₂ Λ₂ r
        rw [E1, χ₁.commutes, h2, RingEquiv.apply_symm_apply] }
  let ψ₂ : A₂ →ₐ[R₂] B :=
    { (ψ₁.toRingHom.comp eA.symm.toRingHom) with
      commutes' := fun r => by
        show ψ₁ (eA.symm (algebraMap R₂ A₂ r)) = algebraMap R₂ B r
        rw [E2, ψ₁.commutes, E1] }
  have hχ₂ : ∀ b, χ₂ b = eΛ (χ₁ b) := fun b => rfl
  have hψ₂ : ∀ a, ψ₂ a = ψ₁ (eA.symm a) := fun a => rfl
  have E3 : ∀ a, eΛ.symm (φ₂ a) = φ₁ (eA.symm a) := by
    intro a
    rw [RingEquiv.symm_apply_eq, ← h3, RingEquiv.apply_symm_apply]
  have hfac : χ₂.comp ψ₂ = φ₂ := by
    ext a
    rw [AlgHom.comp_apply, hχ₂, hψ₂, ← AlgHom.comp_apply, hc, ← h3, RingEquiv.apply_symm_apply]

  have S1 : ∀ b : B, Algebra.Smooth R₁ (Localization.Away b) →
      Algebra.Smooth R₂ (Localization.Away b) := by
    intro b hb
    have E4 : algebraMap R₂ (Localization.Away b) =
        (algebraMap R₁ (Localization.Away b)).comp eR.symm.toRingHom := by
      ext r
      rw [RingHom.comp_apply, IsScalarTower.algebraMap_apply R₂ B (Localization.Away b),
        IsScalarTower.algebraMap_apply R₁ B (Localization.Away b)]
      rfl
    rw [← RingHom.smooth_algebraMap, E4]
    exact RingHom.Smooth.comp (RingHom.Smooth.of_bijective eR.symm.bijective)
      (RingHom.smooth_algebraMap.mpr hb)

  have S2 : ∀ a : A₂, Algebra.Smooth R₂ (Localization.Away a) →
      Algebra.Smooth R₁ (Localization.Away (eA.symm a)) := by
    intro a ha
    have hM : Submonoid.map eA.symm.toMonoidHom (Submonoid.powers a) =
        Submonoid.powers (eA.symm a) := by
      rw [Submonoid.map_powers]; rfl
    let ε := IsLocalization.ringEquivOfRingEquiv (Localization.Away a)
      (Localization.Away (eA.symm a)) eA.symm hM
    have E5 : ∀ x, ε (algebraMap A₂ _ x) =
        algebraMap A₁ (Localization.Away (eA.symm a)) (eA.symm x) :=
      fun x => IsLocalization.ringEquivOfRingEquiv_eq hM x
    have E6 : algebraMap R₁ (Localization.Away (eA.symm a)) =
        ε.toRingHom.comp ((algebraMap R₂ (Localization.Away a)).comp eR.toRingHom) := by
      ext r
      simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingHom.coe_coe]
      rw [IsScalarTower.algebraMap_apply R₂ A₂ (Localization.Away a), E5, E2,
        RingEquiv.symm_apply_apply, ← IsScalarTower.algebraMap_apply]
    rw [← RingHom.smooth_algebraMap, E6]
    exact RingHom.Smooth.comp (RingHom.Smooth.comp (RingHom.Smooth.of_bijective eR.bijective)
      (RingHom.smooth_algebraMap.mpr ha)) (RingHom.Smooth.of_bijective ε.bijective)

  have T : ∀ {P Q : Type u} [CommRing P] [CommRing Q] (f : P →+* Q) (S : Set P) (T' : Set Q),
      f '' S ⊆ T' → ∀ x ∈ (Ideal.span S).radical, f x ∈ (Ideal.span T').radical := by
    intro P Q _ _ f S T' hST x hx
    obtain ⟨n, hn⟩ := hx
    refine ⟨n, ?_⟩
    rw [← map_pow]
    have hm := Ideal.mem_map_of_mem f hn
    rw [Ideal.map_span] at hm
    exact Ideal.span_mono hST hm
  have F1 : (eΛ : Λ₁ →+* Λ₂) '' (χ₁ '' {b : B | Algebra.Smooth R₁ (Localization.Away b)}) ⊆
      χ₂ '' {b : B | Algebra.Smooth R₂ (Localization.Away b)} := by
    rintro _ ⟨_, ⟨b, hb, rfl⟩, rfl⟩
    exact ⟨b, S1 b hb, rfl⟩
  have F2 : (eΛ.symm : Λ₂ →+* Λ₁) '' (φ₂ '' {a : A₂ | Algebra.Smooth R₂ (Localization.Away a)}) ⊆
      φ₁ '' {a : A₁ | Algebra.Smooth R₁ (Localization.Away a)} := by
    rintro _ ⟨_, ⟨a, ha, rfl⟩, rfl⟩
    exact ⟨eA.symm a, S2 a ha, (E3 a).symm⟩
  refine ⟨B, iB, inst₂, hfp₂, ψ₂, χ₂, hfac, ?_, ?_⟩
  ·
    intro y hy
    have k1 := T (eΛ.symm : Λ₂ →+* Λ₁) _ _ F2 y hy
    have k2 := T (eΛ : Λ₁ →+* Λ₂) _ _ F1 _ (hle k1)
    simpa using k2
  ·
    intro hcon
    apply hnot
    intro x hx
    have hx2 := hcon (T (eΛ : Λ₁ →+* Λ₂) _ _ F1 x hx)
    rw [h4, Ideal.mem_map_of_equiv] at hx2
    obtain ⟨z, hz, hzx⟩ := hx2
    have hzx' : z = x := eΛ.injective (by simpa using hzx)
    rw [← hzx']
    exact hz

theorem wc_pfc_res_quot_quot : ∀ (R : Type u) [CommRing R] (A : Type u) [CommRing A] [Algebra R A] (Λ : Type u) [CommRing Λ] [Algebra R Λ] (φ : A →ₐ[R] Λ) (𝔮 : Ideal Λ) (I J : Ideal R) (s : R), J = I ⊔ Ideal.span {s ^ 8} → ∀ (φJ : (A ⧸ Ideal.map (algebraMap R A) J) →ₐ[R ⧸ J] (Λ ⧸ Ideal.map (algebraMap R Λ) J)), (∀ a : A, φJ (Ideal.Quotient.mk _ a) = Ideal.Quotient.mk _ (φ a)) → ∀ (φI : (A ⧸ Ideal.map (algebraMap R A) I) →ₐ[R ⧸ I] (Λ ⧸ Ideal.map (algebraMap R Λ) I)), (∀ a : A, φI (Ideal.Quotient.mk _ a) = Ideal.Quotient.mk _ (φ a)) → ∀ (φII : ((A ⧸ Ideal.map (algebraMap R A) I) ⧸ Ideal.map (algebraMap (R ⧸ I) (A ⧸ Ideal.map (algebraMap R A) I)) (Ideal.span {Ideal.Quotient.mk I s ^ 8})) →ₐ[(R ⧸ I) ⧸ Ideal.span {Ideal.Quotient.mk I s ^ 8}] ((Λ ⧸ Ideal.map (algebraMap R Λ) I) ⧸ Ideal.map (algebraMap (R ⧸ I) (Λ ⧸ Ideal.map (algebraMap R Λ) I)) (Ideal.span {Ideal.Quotient.mk I s ^ 8}))), (∀ x, φII (Ideal.Quotient.mk _ x) = Ideal.Quotient.mk _ (φI x)) → wcPfcRes (R ⧸ J) (A ⧸ Ideal.map (algebraMap R A) J) (Λ ⧸ Ideal.map (algebraMap R Λ) J) φJ (𝔮.map (Ideal.Quotient.mk (Ideal.map (algebraMap R Λ) J))) → wcPfcRes ((R ⧸ I) ⧸ Ideal.span {Ideal.Quotient.mk I s ^ 8}) ((A ⧸ Ideal.map (algebraMap R A) I) ⧸ Ideal.map (algebraMap (R ⧸ I) (A ⧸ Ideal.map (algebraMap R A) I)) (Ideal.span {Ideal.Quotient.mk I s ^ 8})) ((Λ ⧸ Ideal.map (algebraMap R Λ) I) ⧸ Ideal.map (algebraMap (R ⧸ I) (Λ ⧸ Ideal.map (algebraMap R Λ) I)) (Ideal.span {Ideal.Quotient.mk I s ^ 8})) φII ((𝔮.map (Ideal.Quotient.mk (Ideal.map (algebraMap R Λ) I))).map (Ideal.Quotient.mk (Ideal.map (algebraMap (R ⧸ I) (Λ ⧸ Ideal.map (algebraMap R Λ) I)) (Ideal.span {Ideal.Quotient.mk I s ^ 8})))) :=
by
  intro R _ A _ _ Λ _ _ φ 𝔮 I J s hJ φJ hφJ φI hφI φII hφII hres

  have gen : ∀ (X : Type u) [CommRing X] (P Q : Ideal X) (L : Ideal (X ⧸ P)), P ≤ Q →
      Ideal.map (Ideal.Quotient.mk P) Q = L →
      ∃ e : (X ⧸ Q) ≃+* ((X ⧸ P) ⧸ L), ∀ x : X,
        e (Ideal.Quotient.mk Q x) = Ideal.Quotient.mk L (Ideal.Quotient.mk P x) := by
    intro X _ P Q L hPQ hL
    refine ⟨(DoubleQuot.quotQuotEquivQuotOfLE hPQ).symm.trans (Ideal.quotEquivOfEq hL),
      fun x => ?_⟩
    rw [RingEquiv.trans_apply, DoubleQuot.quotQuotEquivQuotOfLE_symm_mk]
    exact Ideal.quotEquivOfEq_mk hL _
  have hIJ : I ≤ J := by rw [hJ]; exact le_sup_left
  have hR : Ideal.map (Ideal.Quotient.mk I) J = Ideal.span {Ideal.Quotient.mk I s ^ 8} := by
    rw [hJ, Ideal.map_sup, Ideal.map_quotient_self, bot_sup_eq, Ideal.map_span,
      Set.image_singleton, map_pow]
  have hA : Ideal.map (Ideal.Quotient.mk (Ideal.map (algebraMap R A) I))
      (Ideal.map (algebraMap R A) J) =
      Ideal.map (algebraMap (R ⧸ I) (A ⧸ Ideal.map (algebraMap R A) I))
        (Ideal.span {Ideal.Quotient.mk I s ^ 8}) := by
    rw [← hR, Ideal.map_map, Ideal.map_map]
    congr 1
  have hΛ : Ideal.map (Ideal.Quotient.mk (Ideal.map (algebraMap R Λ) I))
      (Ideal.map (algebraMap R Λ) J) =
      Ideal.map (algebraMap (R ⧸ I) (Λ ⧸ Ideal.map (algebraMap R Λ) I))
        (Ideal.span {Ideal.Quotient.mk I s ^ 8}) := by
    rw [← hR, Ideal.map_map, Ideal.map_map]
    congr 1
  obtain ⟨eR, heR⟩ := gen R I J _ hIJ hR
  obtain ⟨eA, heA⟩ := gen A _ _ _ (Ideal.map_mono hIJ) hA
  obtain ⟨eΛ, heΛ⟩ := gen Λ _ _ _ (Ideal.map_mono hIJ) hΛ
  refine wc_pfc_res_ring_equiv_transport _ _ _ _ _ _ eR eA eΛ φJ φII _ _ ?_ ?_ ?_ ?_ hres
  · intro r
    obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective r
    rw [Ideal.Quotient.algebraMap_quotient_map_quotient, heA, heR,
      Ideal.Quotient.algebraMap_quotient_map_quotient,
      Ideal.Quotient.algebraMap_quotient_map_quotient]
  · intro r
    obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective r
    rw [Ideal.Quotient.algebraMap_quotient_map_quotient, heΛ, heR,
      Ideal.Quotient.algebraMap_quotient_map_quotient,
      Ideal.Quotient.algebraMap_quotient_map_quotient]
  · intro a
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective a
    rw [heA, hφII, hφI, hφJ, heΛ]
  · have hc : ((eΛ : (Λ ⧸ Ideal.map (algebraMap R Λ) J) →+*
        ((Λ ⧸ Ideal.map (algebraMap R Λ) I) ⧸ Ideal.map (algebraMap (R ⧸ I)
          (Λ ⧸ Ideal.map (algebraMap R Λ) I)) (Ideal.span {Ideal.Quotient.mk I s ^ 8}))).comp
          (Ideal.Quotient.mk (Ideal.map (algebraMap R Λ) J))) =
        (Ideal.Quotient.mk (Ideal.map (algebraMap (R ⧸ I) (Λ ⧸ Ideal.map (algebraMap R Λ) I))
          (Ideal.span {Ideal.Quotient.mk I s ^ 8}))).comp
          (Ideal.Quotient.mk (Ideal.map (algebraMap R Λ) I)) := by
      ext x
      exact heΛ x
    rw [Ideal.map_map, ← hc, ← Ideal.map_map]
    rfl

theorem wc_pfc_strict_std_quotient : ∀ (R : Type u) [CommRing R] (A : Type u) [CommRing A] [Algebra R A] (J : Ideal R) (a : A), wcPfcStrictStd R A a → wcPfcStrictStd (R ⧸ J) (A ⧸ Ideal.map (algebraMap R A) J) (Ideal.Quotient.mk _ a) :=
by
  intro R _ A _ _ J a ha
  obtain ⟨n, m, c, hcn, hcm, f, e, hM, hS⟩ := ha
  obtain ⟨Φ, hΦ⟩ : ∃ Φ : MvPolynomial (Fin n) R →+* MvPolynomial (Fin n) (R ⧸ J),
      Φ = MvPolynomial.map (Ideal.Quotient.mk J) := ⟨_, rfl⟩
  have hΦC : ∀ r, Φ (MvPolynomial.C r) = MvPolynomial.C (Ideal.Quotient.mk J r) := by
    intro r; rw [hΦ, MvPolynomial.map_C]
  have hΦX : ∀ i, Φ (MvPolynomial.X i) = MvPolynomial.X i := by
    intro i; rw [hΦ, MvPolynomial.map_X]
  have hΦs : Function.Surjective Φ := by
    rw [hΦ]; exact MvPolynomial.map_surjective _ Ideal.Quotient.mk_surjective
  have hΦd : ∀ (i : Fin n) (p : MvPolynomial (Fin n) R),
      MvPolynomial.pderiv i (Φ p) = Φ (MvPolynomial.pderiv i p) := by
    intro i p; rw [hΦ, MvPolynomial.pderiv_map]
  obtain ⟨α, hα⟩ : ∃ α : MvPolynomial (Fin n) (R ⧸ J) →ₐ[R ⧸ J] A ⧸ Ideal.map (algebraMap R A) J,
      α = MvPolynomial.aeval (fun i => Ideal.Quotient.mk (Ideal.map (algebraMap R A) J)
        (e (Ideal.Quotient.mk (Ideal.span (Set.range f)) (MvPolynomial.X i)))) := ⟨_, rfl⟩
  have hαΦ : ∀ x, α (Φ x) = Ideal.Quotient.mk (Ideal.map (algebraMap R A) J)
      (e (Ideal.Quotient.mk (Ideal.span (Set.range f)) x)) := by
    have key : α.toRingHom.comp Φ =
        (Ideal.Quotient.mk (Ideal.map (algebraMap R A) J)).comp
          (e.toRingEquiv.toRingHom.comp (Ideal.Quotient.mk (Ideal.span (Set.range f)))) := by
      apply MvPolynomial.ringHom_ext
      · intro r
        simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
          RingEquiv.toRingHom_eq_coe, AlgEquiv.toRingEquiv_eq_coe, RingEquiv.coe_toRingHom,
          AlgEquiv.coe_ringEquiv]
        rw [hΦC, hα, MvPolynomial.aeval_C, Ideal.Quotient.algebraMap_quotient_map_quotient,
          ← MvPolynomial.algebraMap_eq, Ideal.Quotient.mk_algebraMap R (Ideal.span (Set.range f)),
          AlgEquiv.commutes, Ideal.Quotient.mk_algebraMap R (Ideal.map (algebraMap R A) J)]
      · intro i
        simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
          RingEquiv.toRingHom_eq_coe, AlgEquiv.toRingEquiv_eq_coe, RingEquiv.coe_toRingHom,
          AlgEquiv.coe_ringEquiv]
        rw [hΦX, hα, MvPolynomial.aeval_X]
    intro x
    exact RingHom.congr_fun key x
  have hαK : ∀ y ∈ Ideal.span (Set.range (fun j => Φ (f j))), α y = 0 := by
    have hle : Ideal.span (Set.range (fun j => Φ (f j))) ≤ RingHom.ker α := by
      rw [Ideal.span_le]
      rintro _ ⟨j, rfl⟩
      rw [SetLike.mem_coe, RingHom.mem_ker, hαΦ,
        Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (s := Set.range f) ⟨j, rfl⟩),
        map_zero, map_zero]
    intro y hy
    exact (RingHom.mem_ker).mp (hle hy)
  obtain ⟨ᾱ, hᾱ⟩ : ∃ ᾱ : (MvPolynomial (Fin n) (R ⧸ J) ⧸ Ideal.span (Set.range (fun j => Φ (f j))))
      →ₐ[R ⧸ J] A ⧸ Ideal.map (algebraMap R A) J,
      ∀ y, ᾱ (Ideal.Quotient.mk _ y) = α y :=
    ⟨Ideal.Quotient.liftₐ _ α hαK, fun y => rfl⟩
  have hleK : Ideal.span (Set.range f) ≤
      Ideal.comap Φ (Ideal.span (Set.range (fun j => Φ (f j)))) := by
    rw [Ideal.span_le]
    rintro _ ⟨j, rfl⟩
    rw [SetLike.mem_coe, Ideal.mem_comap]
    exact Ideal.subset_span ⟨j, rfl⟩
  obtain ⟨ν, hν⟩ : ∃ ν : (MvPolynomial (Fin n) R ⧸ Ideal.span (Set.range f)) →+*
      (MvPolynomial (Fin n) (R ⧸ J) ⧸ Ideal.span (Set.range (fun j => Φ (f j)))),
      ∀ x, ν (Ideal.Quotient.mk _ x) = Ideal.Quotient.mk _ (Φ x) :=
    ⟨Ideal.quotientMap _ Φ hleK, fun x => Ideal.quotientMap_mk⟩
  have hβ₀ : ∀ y ∈ Ideal.map (algebraMap R A) J,
      (ν.comp e.symm.toRingEquiv.toRingHom) y = 0 := by
    have hle : Ideal.map (algebraMap R A) J ≤ RingHom.ker (ν.comp e.symm.toRingEquiv.toRingHom) := by
      rw [Ideal.map_le_iff_le_comap]
      intro r hr
      rw [Ideal.mem_comap, RingHom.mem_ker, RingHom.comp_apply]
      simp only [RingEquiv.toRingHom_eq_coe, AlgEquiv.toRingEquiv_eq_coe, RingEquiv.coe_toRingHom,
        AlgEquiv.coe_ringEquiv]
      rw [AlgEquiv.commutes, ← Ideal.Quotient.mk_algebraMap, MvPolynomial.algebraMap_eq, hν, hΦC,
        Ideal.Quotient.eq_zero_iff_mem.mpr hr, map_zero, map_zero]
    intro y hy
    exact (RingHom.mem_ker).mp (hle hy)
  obtain ⟨β, hβ⟩ : ∃ β : (A ⧸ Ideal.map (algebraMap R A) J) →+*
      (MvPolynomial (Fin n) (R ⧸ J) ⧸ Ideal.span (Set.range (fun j => Φ (f j)))),
      ∀ y, β (Ideal.Quotient.mk _ y) = ν (e.symm y) :=
    ⟨Ideal.Quotient.lift _ _ hβ₀, fun y => rfl⟩
  have KI : ∀ x, β (Ideal.Quotient.mk (Ideal.map (algebraMap R A) J)
      (e (Ideal.Quotient.mk (Ideal.span (Set.range f)) x))) =
      Ideal.Quotient.mk (Ideal.span (Set.range (fun j => Φ (f j)))) (Φ x) := by
    intro x
    rw [hβ, AlgEquiv.symm_apply_apply, hν]
  have h1 : ᾱ.toRingHom.comp β = RingHom.id _ := by
    apply Ideal.Quotient.ringHom_ext
    refine RingHom.ext fun y => ?_
    obtain ⟨x, hx⟩ := Ideal.Quotient.mk_surjective (e.symm y)
    have hy : y = e (Ideal.Quotient.mk _ x) := by rw [hx, AlgEquiv.apply_symm_apply]
    simp only [RingHom.comp_apply, RingHom.id_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe]
    rw [hy, KI, hᾱ, hαΦ]
  have h2 : β.comp ᾱ.toRingHom = RingHom.id _ := by
    apply Ideal.Quotient.ringHom_ext
    refine RingHom.ext fun y => ?_
    obtain ⟨x, rfl⟩ := hΦs y
    simp only [RingHom.comp_apply, RingHom.id_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe]
    rw [hᾱ, hαΦ, KI]
  obtain ⟨e', he'⟩ : ∃ e' : (MvPolynomial (Fin n) (R ⧸ J) ⧸
      Ideal.span (Set.range (fun j => Φ (f j)))) ≃ₐ[R ⧸ J] A ⧸ Ideal.map (algebraMap R A) J,
      ∀ z, e'.symm z = β z :=
    ⟨AlgEquiv.ofRingEquiv (f := RingEquiv.ofRingHom ᾱ.toRingHom β h1 h2)
      (fun r => ᾱ.commutes r), fun z => rfl⟩
  refine ⟨n, m, c, hcn, hcm, fun j => Φ (f j), e', ?_, ?_⟩
  · obtain ⟨x, hx, hxa⟩ :=
      (Ideal.mem_map_iff_of_surjective _ Ideal.Quotient.mk_surjective).mp hM
    have ha : a = e (Ideal.Quotient.mk (Ideal.span (Set.range f)) x) := by
      rw [hxa, AlgEquiv.apply_symm_apply]
    rw [he', ha, KI]
    apply Ideal.mem_map_of_mem
    have hmin : Ideal.map Φ (Ideal.span (Set.range (fun I : Fin c ↪ Fin n =>
        Matrix.det (Matrix.of (fun j l : Fin c =>
          MvPolynomial.pderiv (I l) (f (Fin.castLE hcm j))))))) ≤
        Ideal.span (Set.range (fun I : Fin c ↪ Fin n =>
        Matrix.det (Matrix.of (fun j l : Fin c =>
          MvPolynomial.pderiv (I l) (Φ (f (Fin.castLE hcm j))))))) := by
      rw [Ideal.map_span, Ideal.span_le]
      rintro _ ⟨_, ⟨I, rfl⟩, rfl⟩
      refine Ideal.subset_span ⟨I, ?_⟩
      rw [RingHom.map_det, RingHom.mapMatrix_apply]
      refine congrArg Matrix.det (Matrix.ext fun j l => ?_)
      simp only [Matrix.map_apply, Matrix.of_apply, hΦd]
    exact hmin (Ideal.mem_map_of_mem Φ hx)
  · intro j hj
    obtain ⟨g, hg, hgf⟩ := hS j hj
    refine ⟨Φ g, ?_, ?_⟩
    · rw [he', ← KI, hg, AlgEquiv.apply_symm_apply]
    · have h := Ideal.mem_map_of_mem Φ hgf
      rw [Submodule.add_eq_sup, Ideal.map_sup, Ideal.map_pow, Ideal.map_span, Ideal.map_span,
        Set.image_image, ← Set.range_comp, map_mul] at h
      rw [Submodule.add_eq_sup]
      exact h

theorem wc_pfc_chart_local : ∀ (S : Type u) [CommRing S] (n m : ℕ) (f : Fin m → MvPolynomial (Fin n) S) (c : MvPolynomial (Fin n) S), Algebra.Smooth S (Localization.Away (Ideal.Quotient.mk (Ideal.span (Set.range f)) c)) → ∀ (𝔭 : Ideal (MvPolynomial (Fin n) S)), 𝔭.IsPrime → Ideal.span (Set.range f) ≤ 𝔭 → c ∉ 𝔭 → ∃ (s : ℕ) (E : Fin s → Fin m) (ι : Fin s → Fin n) (u : MvPolynomial (Fin n) S) (h : Fin m → Fin s → MvPolynomial (Fin n) S), Function.Injective E ∧ Function.Injective ι ∧ u * (Matrix.of fun i j : Fin s => MvPolynomial.pderiv (ι i) (f (E j))).det ∉ 𝔭 ∧ ∀ l : Fin m, u * (Matrix.of fun i j : Fin s => MvPolynomial.pderiv (ι i) (f (E j))).det * f l = ∑ j, h l j * f (E j) :=
by
  intro S _ n m f c hsm 𝔭 h𝔭 hI hc
  classical

  have s5 : ∀ (T : Type u) [CommRing T] (m s : ℕ) (f : Fin m → T) (E : Fin s → Fin m)
      (𝔭 : Ideal T), 𝔭.IsPrime → ∀ (w : T) (H : Fin m → Fin s → T), w ∉ 𝔭 →
      (∀ l, w * f l - ∑ j, H l j * f (E j) ∈ 𝔭 * Ideal.span (Set.range f)) →
      ∃ (v : T) (h : Fin m → Fin s → T), v ∉ 𝔭 ∧ ∀ l, v * f l = ∑ j, h l j * f (E j) := by
    intro T _ m s f E 𝔭 h𝔭 w H hw hrel
    have hA : ∀ l, ∃ a : Fin m → T, (∀ k, a k ∈ 𝔭) ∧
        w * f l - ∑ j, H l j * f (E j) = ∑ k, a k * f k := by
      intro l
      have h1 := hrel l
      rw [← Ideal.smul_eq_mul, Submodule.mem_ideal_smul_span_iff_exists_sum] at h1
      obtain ⟨a, ha, he⟩ := h1
      refine ⟨a, ha, ?_⟩
      rw [← he, Finsupp.sum_fintype]
      · simp only [smul_eq_mul]
      · intro i; simp
    choose A hA hAe using hA
    let B : Matrix (Fin m) (Fin m) T := w • (1 : Matrix (Fin m) (Fin m) T) - Matrix.of A
    have hBf : Matrix.mulVec B f = fun l => ∑ j, H l j * f (E j) := by
      funext l
      have e : (Matrix.mulVec (Matrix.of A) f) l = ∑ k, A l k * f k := rfl
      simp only [B, Matrix.sub_mulVec, Matrix.smul_mulVec, Matrix.one_mulVec, Pi.sub_apply,
        Pi.smul_apply, smul_eq_mul]
      rw [e, ← hAe l]
      ring
    have key : B.det • f = Matrix.mulVec B.adjugate (Matrix.mulVec B f) := by
      rw [Matrix.mulVec_mulVec, Matrix.adjugate_mul, Matrix.smul_mulVec, Matrix.one_mulVec]
    refine ⟨B.det, fun k j => ∑ l, B.adjugate k l * H l j, ?_, ?_⟩
    · intro hdet
      have hmat : (Ideal.Quotient.mk 𝔭).mapMatrix B =
          Matrix.diagonal (fun _ => Ideal.Quotient.mk 𝔭 w) := by
        ext i j
        have hz : Ideal.Quotient.mk 𝔭 (A i j) = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr (hA i j)
        rw [RingHom.mapMatrix_apply, Matrix.map_apply, Matrix.diagonal_apply]
        by_cases hij : i = j
        · subst hij
          simp [B, hz]
        · simp [B, hz, hij, Matrix.one_apply_ne hij]
      have hmap : (Ideal.Quotient.mk 𝔭) B.det = (Ideal.Quotient.mk 𝔭 w) ^ m := by
        rw [RingHom.map_det, hmat, Matrix.det_diagonal, Finset.prod_const, Finset.card_univ,
          Fintype.card_fin]
      have h0 : (Ideal.Quotient.mk 𝔭) B.det = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr hdet
      rw [hmap] at h0
      have hne : Ideal.Quotient.mk 𝔭 w ≠ 0 := fun h2 => hw (Ideal.Quotient.eq_zero_iff_mem.mp h2)
      exact pow_ne_zero m hne h0
    · intro k
      have h1 := congrFun key k
      rw [hBf] at h1
      simp only [Pi.smul_apply, smul_eq_mul] at h1
      rw [h1]
      simp only [Matrix.mulVec, dotProduct, Finset.mul_sum, Finset.sum_mul]
      rw [Finset.sum_comm]
      exact Finset.sum_congr rfl fun j _ => Finset.sum_congr rfl fun l _ => by ring

  have s2 : ∀ (T : Type u) [CommRing T] (n m : ℕ) (J : Matrix (Fin n) (Fin m) T)
      (𝔭 : Ideal T), 𝔭.IsPrime → ∃ (s : ℕ) (E : Fin s → Fin m) (ι : Fin s → Fin n),
      Function.Injective E ∧ Function.Injective ι ∧ (J.submatrix ι E).det ∉ 𝔭 ∧
      ∀ (i : Fin n) (l : Fin m), (J.submatrix (Fin.cons i ι) (Fin.cons l E)).det ∈ 𝔭 := by
    intro T _ n m J 𝔭 h𝔭
    let Pr : ℕ → Prop := fun r => ∃ (ι : Fin r → Fin n) (E : Fin r → Fin m),
      Function.Injective ι ∧ Function.Injective E ∧ (J.submatrix ι E).det ∉ 𝔭
    have h0 : Pr 0 := ⟨Fin.elim0, Fin.elim0, fun a => Fin.elim0 a, fun a => Fin.elim0 a, by
      rw [Matrix.det_isEmpty]; exact h𝔭.one_notMem⟩
    obtain ⟨ι, E, hι, hE, hΔ⟩ := Nat.findGreatest_spec (P := Pr) (Nat.zero_le n) h0
    refine ⟨Nat.findGreatest Pr n, E, ι, hE, hι, hΔ, ?_⟩
    intro i l
    by_cases hi : i ∈ Set.range ι
    · obtain ⟨k, rfl⟩ := hi
      have h1 : (J.submatrix (Fin.cons (ι k) ι) (Fin.cons l E)).det = 0 := by
        apply Matrix.det_zero_of_row_eq (Fin.succ_ne_zero k).symm
        funext c
        simp
      rw [h1]; exact 𝔭.zero_mem
    by_cases hl : l ∈ Set.range E
    · obtain ⟨k, rfl⟩ := hl
      have h1 : (J.submatrix (Fin.cons i ι) (Fin.cons (E k) E)).det = 0 := by
        apply Matrix.det_zero_of_column_eq (Fin.succ_ne_zero k).symm
        intro r
        simp
      rw [h1]; exact 𝔭.zero_mem
    by_contra hnot
    have hι' : Function.Injective (Fin.cons i ι : Fin (Nat.findGreatest Pr n + 1) → Fin n) :=
      Fin.cons_injective_iff.mpr ⟨hi, hι⟩
    have hE' : Function.Injective (Fin.cons l E : Fin (Nat.findGreatest Pr n + 1) → Fin m) :=
      Fin.cons_injective_iff.mpr ⟨hl, hE⟩
    have hle : Nat.findGreatest Pr n + 1 ≤ n := by
      simpa using Fintype.card_le_of_injective _ hι'
    exact Nat.findGreatest_is_greatest (Nat.lt_succ_self _) hle ⟨_, _, hι', hE', hnot⟩

  have s3 : ∀ (T : Type u) [CommRing T] (n m s : ℕ) (J : Matrix (Fin n) (Fin m) T)
      (ι : Fin s → Fin n) (E : Fin s → Fin m) (i : Fin n) (l : Fin m),
      (J.submatrix ι E).det * (J.submatrix (Fin.cons i ι) (Fin.cons l E)).det =
        (J.submatrix ι E).det * ((J.submatrix ι E).det * J i l -
          ∑ j, J i (E j) * ∑ k, (J.submatrix ι E).adjugate j k * J (ι k) l) := by
    intro T _ n m s J ι E i l
    obtain ⟨K, hK⟩ : ∃ K, K = J.submatrix ι E := ⟨_, rfl⟩
    obtain ⟨L, hL⟩ : ∃ L, L = J.submatrix (Fin.cons i ι) (Fin.cons l E) := ⟨_, rfl⟩
    rw [← hK, ← hL]
    obtain ⟨b, hb⟩ : ∃ b : Fin s → T, b = fun k => J (ι k) l := ⟨_, rfl⟩
    obtain ⟨v, hv⟩ : ∃ v : Fin s → T, v = Matrix.mulVec K.adjugate b := ⟨_, rfl⟩
    let Y : Matrix (Fin (s+1)) (Fin (s+1)) T := Matrix.of fun r c =>
      Fin.cases (motive := fun _ => T) (Fin.cases (motive := fun _ => T) K.det (fun _ => 0) c)
        (fun j' => Fin.cases (motive := fun _ => T) (-v j') (fun j => if j' = j then 1 else 0) c) r
    have hY00 : Y 0 0 = K.det := rfl
    have hY0s : ∀ j : Fin s, Y 0 j.succ = 0 := fun j => rfl
    have hYs0 : ∀ j' : Fin s, Y j'.succ 0 = -v j' := fun j' => rfl
    have hYss : ∀ j' j : Fin s, Y j'.succ j.succ = if j' = j then 1 else 0 := fun _ _ => rfl
    have hL00 : L 0 0 = J i l := by rw [hL]; rfl
    have hL0s : ∀ j : Fin s, L 0 j.succ = J i (E j) := fun j => by rw [hL]; rfl
    have hLs0 : ∀ k : Fin s, L k.succ 0 = b k := fun k => by rw [hL, hb]; rfl
    have hLss : ∀ k j : Fin s, L k.succ j.succ = K k j := fun _ _ => by rw [hL, hK]; rfl
    have hdetY : Y.det = K.det := by
      rw [Matrix.det_succ_row_zero, Fin.sum_univ_succ]
      have h1 : Y.submatrix Fin.succ (Fin.succAbove 0) = 1 := by
        ext a c
        simp only [Matrix.submatrix_apply, Fin.succAbove_zero, hYss, Matrix.one_apply]
      rw [h1, Matrix.det_one]
      simp [hY00, hY0s]
    have hLYs : ∀ (r : Fin (s+1)) (j : Fin s), (L * Y) r j.succ = L r j.succ := by
      intro r j
      rw [Matrix.mul_apply, Fin.sum_univ_succ, hY0s, mul_zero, zero_add]
      simp only [hYss, mul_ite, mul_one, mul_zero, Finset.sum_ite_eq', Finset.mem_univ, ite_true]
    have hLY0 : ∀ k : Fin s, (L * Y) k.succ 0 = 0 := by
      intro k
      rw [Matrix.mul_apply, Fin.sum_univ_succ, hY00, hLs0]
      simp only [hYs0, hLss, mul_neg, Finset.sum_neg_distrib]
      have e : ∑ x, K k x * v x = (Matrix.mulVec K v) k := rfl
      rw [e, hv, Matrix.mulVec_mulVec, Matrix.mul_adjugate, Matrix.smul_mulVec,
        Matrix.one_mulVec]
      simp only [Pi.smul_apply, smul_eq_mul]
      ring
    have hLY00 : (L * Y) 0 0 =
        K.det * J i l - ∑ j, J i (E j) * ∑ k, K.adjugate j k * J (ι k) l := by
      rw [Matrix.mul_apply, Fin.sum_univ_succ, hY00, hL00]
      simp only [hYs0, hL0s, mul_neg, Finset.sum_neg_distrib]
      rw [hv, hb]
      simp only [Matrix.mulVec, dotProduct]
      ring
    have hdetLY : (L * Y).det = (L * Y) 0 0 * K.det := by
      rw [Matrix.det_succ_column_zero, Fin.sum_univ_succ]
      simp only [hLY0, mul_zero, zero_mul, Finset.sum_const_zero, add_zero]
      have h1 : (L * Y).submatrix (Fin.succAbove 0) Fin.succ = K := by
        ext a c
        simp only [Matrix.submatrix_apply, Fin.succAbove_zero, hLYs, hLss]
      rw [h1]
      simp
    rw [Matrix.det_mul, hdetY, hLY00] at hdetLY
    rw [mul_comm K.det L.det, hdetLY]
    ring

  obtain ⟨N, q, hq, hstar⟩ := wc_pfc_ssp_smooth_conormal_local S
    (MvPolynomial (Fin n) S ⧸ Ideal.span (Set.range f)) n
    (Ideal.Quotient.mkₐ S (Ideal.span (Set.range f)))
    (Ideal.Quotient.mkₐ_surjective S _) c hsm
  have hker : ∀ g, g ∈ RingHom.ker (Ideal.Quotient.mkₐ S (Ideal.span (Set.range f))) ↔
      g ∈ Ideal.span (Set.range f) := by
    intro g
    rw [RingHom.mem_ker, Ideal.Quotient.mkₐ_eq_mk, Ideal.Quotient.eq_zero_iff_mem]
  have hkerEq : RingHom.ker (Ideal.Quotient.mkₐ S (Ideal.span (Set.range f))) =
      Ideal.span (Set.range f) := Ideal.ext hker
  have hq' : ∀ j, q j ∈ Ideal.span (Set.range f) := fun j => (hker _).mp (hq j)
  choose sl hsl using fun l : Fin m =>
    hstar (f l) ((hker _).mpr (Ideal.subset_span ⟨l, rfl⟩))
  obtain ⟨σ, hσ⟩ : ∃ σ, σ = ∑ l, sl l := ⟨_, rfl⟩
  have hslσ : ∀ l, sl l ≤ σ := fun l => by
    rw [hσ]; exact Finset.single_le_sum (f := sl) (fun j _ => Nat.zero_le _) (Finset.mem_univ l)
  obtain ⟨J, hJ⟩ : ∃ J : Matrix (Fin n) (Fin m) (MvPolynomial (Fin n) S),
      J = Matrix.of fun i l => MvPolynomial.pderiv i (f l) := ⟨_, rfl⟩
  obtain ⟨t, ht⟩ : ∃ t : MvPolynomial (Fin n) S, t = c ^ (σ + N) := ⟨_, rfl⟩
  obtain ⟨Q, hQd⟩ : ∃ Q : Fin n → MvPolynomial (Fin n) S, Q = fun i => c ^ σ * q i := ⟨_, rfl⟩
  have hQ : ∀ i, Q i ∈ Ideal.span (Set.range f) := fun i => by
    rw [hQd]; exact Ideal.mul_mem_left _ _ (hq' i)
  have hρ : ∀ l, t * f l - ∑ i, J i l * Q i ∈ Ideal.span (Set.range f) ^ 2 := by
    intro l
    obtain ⟨a, ha⟩ := Nat.exists_eq_add_of_le (hslσ l)
    have hmem := hsl l
    rw [hkerEq] at hmem
    have hsum : ∑ i, J i l * Q i = c ^ σ * ∑ i, MvPolynomial.pderiv i (f l) * q i := by
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [hJ, hQd]
      simp only [Matrix.of_apply]
      ring
    have e : t * f l - ∑ i, J i l * Q i = c ^ a * (c ^ sl l *
        (c ^ N * f l - ∑ j, MvPolynomial.pderiv j (f l) * q j)) := by
      rw [hsum, ht, ha]
      ring
    rw [e]
    exact Ideal.mul_mem_left _ _ hmem
  have ht𝔭 : t ∉ 𝔭 := by
    rw [ht]; exact fun h => hc (h𝔭.mem_of_pow_mem _ h)

  obtain ⟨s, E, ι, hE, hι, hΔ, hbord⟩ := s2 _ n m J 𝔭 h𝔭
  obtain ⟨Δ, hΔd⟩ : ∃ Δ, Δ = (J.submatrix ι E).det := ⟨_, rfl⟩
  obtain ⟨β, hβd⟩ : ∃ β : Fin m → Fin s → MvPolynomial (Fin n) S,
      β = fun l j => ∑ k, (J.submatrix ι E).adjugate j k * J (ι k) l := ⟨_, rfl⟩
  have hΔ' : Δ ∉ 𝔭 := by rw [hΔd]; exact hΔ

  have hγ : ∀ i l, Δ * J i l - ∑ j, J i (E j) * β l j ∈ 𝔭 := by
    intro i l
    have e := s3 _ n m s J ι E i l
    rw [← hΔd] at e
    have hm : Δ * (J.submatrix (Fin.cons i ι) (Fin.cons l E)).det ∈ 𝔭 :=
      Ideal.mul_mem_left _ _ (hbord i l)
    rw [e] at hm
    rw [hβd]
    exact (h𝔭.mem_or_mem hm).resolve_left hΔ'

  have hI2 : Ideal.span (Set.range f) ^ 2 ≤ 𝔭 * Ideal.span (Set.range f) :=
    (pow_two _).le.trans (Ideal.mul_mono hI le_rfl)
  have hrel : ∀ l, Δ * t * f l - ∑ j, β l j * t * f (E j) ∈ 𝔭 * Ideal.span (Set.range f) := by
    intro l
    have h1 : ∑ i, (Δ * J i l - ∑ j, J i (E j) * β l j) * Q i =
        Δ * ∑ i, J i l * Q i - ∑ i, (∑ j, J i (E j) * β l j) * Q i := by
      rw [Finset.mul_sum, ← Finset.sum_sub_distrib]
      exact Finset.sum_congr rfl fun i _ => by ring
    have h2 : ∑ j, β l j * (t * f (E j) - ∑ i, J i (E j) * Q i) =
        ∑ j, β l j * t * f (E j) - ∑ j, β l j * ∑ i, J i (E j) * Q i := by
      rw [← Finset.sum_sub_distrib]
      exact Finset.sum_congr rfl fun j _ => by ring
    have h3 : ∑ j, β l j * ∑ i, J i (E j) * Q i = ∑ i, (∑ j, J i (E j) * β l j) * Q i := by
      simp only [Finset.mul_sum, Finset.sum_mul]
      rw [Finset.sum_comm]
      exact Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => by ring
    have hid : Δ * t * f l - ∑ j, β l j * t * f (E j) =
        Δ * (t * f l - ∑ i, J i l * Q i) -
          ∑ j, β l j * (t * f (E j) - ∑ i, J i (E j) * Q i) +
          ∑ i, (Δ * J i l - ∑ j, J i (E j) * β l j) * Q i := by
      rw [h1, h2, h3]
      ring
    rw [hid]
    refine Ideal.add_mem _ (Ideal.sub_mem _ (Ideal.mul_mem_left _ _ (hI2 (hρ l)))
      (Ideal.sum_mem _ fun j _ => Ideal.mul_mem_left _ _ (hI2 (hρ (E j))))) ?_
    exact Ideal.sum_mem _ fun i _ => Ideal.mul_mem_mul (hγ i l) (hQ i)

  have hw : Δ * t ∉ 𝔭 := fun h => (h𝔭.mem_or_mem h).elim hΔ' ht𝔭
  obtain ⟨v, h', hv, hvrel⟩ := s5 _ m s f E 𝔭 h𝔭 (Δ * t) (fun l j => β l j * t) hw hrel

  have hdet : (Matrix.of fun i j : Fin s => MvPolynomial.pderiv (ι i) (f (E j))).det = Δ := by
    rw [hΔd, hJ]; rfl
  refine ⟨s, E, ι, v, fun l j => Δ * h' l j, hE, hι, ?_, ?_⟩
  · rw [hdet]
    exact fun h => (h𝔭.mem_or_mem h).elim hv hΔ'
  · intro l
    rw [hdet]
    calc v * Δ * f l = Δ * (v * f l) := by ring
      _ = Δ * ∑ j, h' l j * f (E j) := by rw [hvrel l]
      _ = ∑ j, Δ * h' l j * f (E j) := by
        rw [Finset.mul_sum]
        exact Finset.sum_congr rfl fun j _ => by ring

theorem wc_pfc_elk_lifted_cover : (∀ (S : Type u) [CommRing S] (n m : ℕ) (f : Fin m → MvPolynomial (Fin n) S) (c : MvPolynomial (Fin n) S), Algebra.Smooth S (Localization.Away (Ideal.Quotient.mk (Ideal.span (Set.range f)) c)) → ∀ (𝔭 : Ideal (MvPolynomial (Fin n) S)), 𝔭.IsPrime → Ideal.span (Set.range f) ≤ 𝔭 → c ∉ 𝔭 → ∃ (s : ℕ) (E : Fin s → Fin m) (ι : Fin s → Fin n) (u : MvPolynomial (Fin n) S) (h : Fin m → Fin s → MvPolynomial (Fin n) S), Function.Injective E ∧ Function.Injective ι ∧ u * (Matrix.of fun i j : Fin s => MvPolynomial.pderiv (ι i) (f (E j))).det ∉ 𝔭 ∧ ∀ l : Fin m, u * (Matrix.of fun i j : Fin s => MvPolynomial.pderiv (ι i) (f (E j))).det * f l = ∑ j, h l j * f (E j)) → ∀ (R : Type u) [CommRing R] [IsNoetherianRing R] (π : R) (C : Type u) [CommRing C] [Algebra (R ⧸ Ideal.span {π ^ 8}) C] [Algebra.FinitePresentation (R ⧸ Ideal.span {π ^ 8}) C], ∃ (n m : ℕ) (F : Fin m → MvPolynomial (Fin n) R) (p : MvPolynomial (Fin n) R →+* C) (r : ℕ) (s : Fin r → ℕ) (E : ∀ k, Fin (s k) → Fin m) (ι : ∀ k, Fin (s k) → Fin n) (U : Fin r → MvPolynomial (Fin n) R) (H : ∀ k, Fin m → Fin (s k) → MvPolynomial (Fin n) R) (G : Fin r → Fin m → MvPolynomial (Fin n) R), Function.Surjective p ∧ (∀ x : R, p (MvPolynomial.C x) = algebraMap (R ⧸ Ideal.span {π ^ 8}) C (Ideal.Quotient.mk _ x)) ∧ RingHom.ker p = Ideal.span (Set.range F) ⊔ Ideal.span {MvPolynomial.C (π ^ 8)} ∧ (∀ k, Function.Injective (E k)) ∧ (∀ k, Function.Injective (ι k)) ∧ (∀ k l, U k * wcElkDelta F (E k) (ι k) * F l = ∑ j, H k l j * F (E k j) + MvPolynomial.C (π ^ 8) * G k l) ∧ (∀ k (j₀ j : Fin (s k)), H k (E k j₀) j = if j = j₀ then U k * wcElkDelta F (E k) (ι k) else 0) ∧ (∀ k (j₀ : Fin (s k)), G k (E k j₀) = 0) ∧ ∀ q : MvPolynomial (Fin n) R, Algebra.Smooth (R ⧸ Ideal.span {π ^ 8}) (Localization.Away (p q)) → ∃ (M : ℕ) (Y : Fin r → MvPolynomial (Fin n) R), q ^ M - ∑ k, Y k * (U k * wcElkDelta F (E k) (ι k)) ∈ Ideal.span (Set.range F) ⊔ Ideal.span {MvPolynomial.C (π ^ 8)} :=
by
  intro hchart R _ _ π C _ _ _
  classical

  have htrans : ∀ (A B B' : Type u) [CommRing A] [CommRing B] [CommRing B'] [Algebra A B]
      [Algebra A B'] (e : B ≃ₐ[A] B') (b : B), Algebra.Smooth A (Localization.Away (e b)) →
      Algebra.Smooth A (Localization.Away b) := by
    intro A B B' _ _ _ _ _ e b hs
    have hM : Submonoid.map e.symm (Submonoid.powers (e b)) = Submonoid.powers b := by
      rw [Submonoid.map_powers, AlgEquiv.symm_apply_apply]
    haveI := hs
    exact Algebra.Smooth.of_equiv
      (IsLocalization.algEquivOfAlgEquiv (Localization.Away (e b)) (Localization.Away b) e.symm hM)
  haveI hSnoeth : IsNoetherianRing (R ⧸ Ideal.span {π ^ 8}) := Ideal.Quotient.isNoetherianRing _

  obtain ⟨n, g, hg, hfg⟩ := Algebra.FinitePresentation.out (R := R ⧸ Ideal.span {π ^ 8}) (A := C)
  obtain ⟨m, f, hf⟩ := Submodule.fg_iff_exists_fin_generating_family.mp hfg
  have hf' : Ideal.span (Set.range f) = RingHom.ker g := hf
  have hf'' : Ideal.span (Set.range f) = RingHom.ker g.toRingHom := hf
  haveI hPnoeth : IsNoetherianRing (MvPolynomial (Fin n) (R ⧸ Ideal.span {π ^ 8})) :=
    MvPolynomial.isNoetherianRing

  obtain ⟨𝒜, h𝒜def⟩ : ∃ 𝒜 : Set (MvPolynomial (Fin n) (R ⧸ Ideal.span {π ^ 8})),
      𝒜 = {a | ∃ (s : ℕ) (E : Fin s → Fin m) (ι : Fin s → Fin n)
        (u : MvPolynomial (Fin n) (R ⧸ Ideal.span {π ^ 8}))
        (h : Fin m → Fin s → MvPolynomial (Fin n) (R ⧸ Ideal.span {π ^ 8})),
        Function.Injective E ∧ Function.Injective ι ∧
        a = u * (Matrix.of fun i j : Fin s => MvPolynomial.pderiv (ι i) (f (E j))).det ∧
        ∀ l : Fin m, u * (Matrix.of fun i j : Fin s => MvPolynomial.pderiv (ι i) (f (E j))).det *
          f l = ∑ j, h l j * f (E j)} := ⟨_, rfl⟩
  have hfg𝒜 : (Submodule.span (MvPolynomial (Fin n) (R ⧸ Ideal.span {π ^ 8})) 𝒜).FG :=
    IsNoetherian.noetherian _
  obtain ⟨T, hT𝒜, hTspan⟩ := (Submodule.fg_span_iff_fg_span_finset_subset 𝒜).mp hfg𝒜
  have ht : ∀ k : Fin T.card, (T.equivFin.symm k).1 ∈ 𝒜 := fun k => hT𝒜 (T.equivFin.symm k).2
  rw [h𝒜def] at ht
  choose s E ι u h hE hι ha hrel using ht
  have h𝒜a : ∀ x ∈ 𝒜, x ∈ Ideal.span (Set.range fun k : Fin T.card =>
      u k * (Matrix.of fun i j : Fin (s k) => MvPolynomial.pderiv (ι k i) (f (E k j))).det) := by
    intro x hx
    have hx' : x ∈ Submodule.span (MvPolynomial (Fin n) (R ⧸ Ideal.span {π ^ 8}))
        (T : Set (MvPolynomial (Fin n) (R ⧸ Ideal.span {π ^ 8}))) := by
      rw [← hTspan]; exact Submodule.subset_span hx
    refine (Submodule.span_le.mpr ?_) hx'
    intro y hy
    refine Ideal.subset_span ⟨T.equivFin ⟨y, hy⟩, ?_⟩
    simp only
    rw [← ha, Equiv.symm_apply_apply]
  have hcover : ∀ c : MvPolynomial (Fin n) (R ⧸ Ideal.span {π ^ 8}),
      Algebra.Smooth (R ⧸ Ideal.span {π ^ 8})
        (Localization.Away (Ideal.Quotient.mk (Ideal.span (Set.range f)) c)) →
      ∃ (M : ℕ) (y : Fin T.card → MvPolynomial (Fin n) (R ⧸ Ideal.span {π ^ 8})),
        c ^ M - ∑ k, y k * (u k * (Matrix.of fun i j : Fin (s k) =>
          MvPolynomial.pderiv (ι k i) (f (E k j))).det) ∈ Ideal.span (Set.range f) := by
    intro c hc
    have hrad : c ∈ (Ideal.span (Set.range f) ⊔ Ideal.span (Set.range fun k : Fin T.card =>
        u k * (Matrix.of fun i j : Fin (s k) =>
          MvPolynomial.pderiv (ι k i) (f (E k j))).det)).radical := by
      rw [Ideal.radical_eq_sInf, Ideal.mem_sInf]
      rintro 𝔭 ⟨hJ𝔭, h𝔭⟩
      by_contra hc𝔭
      obtain ⟨s', E', ι', u', h', hE', hι', hnot, hrel'⟩ :=
        hchart _ n m f c hc 𝔭 h𝔭 (le_sup_left.trans hJ𝔭) hc𝔭
      apply hnot
      apply hJ𝔭
      apply Ideal.mem_sup_right
      apply h𝒜a
      rw [h𝒜def]
      exact ⟨s', E', ι', u', h', hE', hι', rfl, hrel'⟩
    obtain ⟨M, hM⟩ := Ideal.mem_radical_iff.mp hrad
    obtain ⟨y₁, hy₁, y₂, hy₂, hy⟩ := Submodule.mem_sup.mp hM
    obtain ⟨y, hy₂'⟩ := Ideal.mem_span_range_iff_exists_fun.mp hy₂
    refine ⟨M, y, ?_⟩
    rw [hy₂', ← hy, add_sub_cancel_right]
    exact hy₁

  obtain ⟨Φ, hΦdef⟩ : ∃ Φ : MvPolynomial (Fin n) R →+* MvPolynomial (Fin n) (R ⧸ Ideal.span {π ^ 8}),
      Φ = MvPolynomial.map (Ideal.Quotient.mk (Ideal.span {π ^ 8})) := ⟨_, rfl⟩
  have hΦ : Function.Surjective Φ := by
    rw [hΦdef]; exact MvPolynomial.map_surjective _ Ideal.Quotient.mk_surjective
  have hkerΦ : RingHom.ker Φ = Ideal.span {MvPolynomial.C (π ^ 8)} := by
    rw [hΦdef, MvPolynomial.ker_map, Ideal.mk_ker, Ideal.map_span, Set.image_singleton]
  choose F hF using fun l => hΦ (f l)
  have hfF : f = Φ ∘ F := funext fun l => (hF l).symm
  have hdet : ∀ k, Φ (wcElkDelta F (E k) (ι k)) =
      (Matrix.of fun i j : Fin (s k) => MvPolynomial.pderiv (ι k i) (f (E k j))).det := by
    intro k
    unfold wcElkDelta
    rw [RingHom.map_det]
    congr 1
    ext i j
    rw [RingHom.mapMatrix_apply, Matrix.map_apply, Matrix.of_apply, Matrix.of_apply, ← hF, hΦdef,
      MvPolynomial.pderiv_map]
  choose U hU using fun k => hΦ (u k)
  choose H' hH' using fun k l j => hΦ (h k l j)
  have hmod : ∀ k l, U k * wcElkDelta F (E k) (ι k) * F l - ∑ j, H' k l j * F (E k j) ∈
      Ideal.span {MvPolynomial.C (π ^ 8)} := by
    intro k l
    rw [← hkerΦ, RingHom.mem_ker]
    simp only [map_sub, map_mul, map_sum, hU, hdet, hF, hH']
    rw [hrel k l, sub_self]
  choose G' hG' using fun k l => Ideal.mem_span_singleton'.mp (hmod k l)

  obtain ⟨H, hHdef⟩ : ∃ H : ∀ k, Fin m → Fin (s k) → MvPolynomial (Fin n) R, ∀ k l j,
      H k l j = if hl : ∃ j₀, E k j₀ = l then
        (if j = hl.choose then U k * wcElkDelta F (E k) (ι k) else 0) else H' k l j :=
    ⟨fun k l j => if hl : ∃ j₀, E k j₀ = l then
        (if j = hl.choose then U k * wcElkDelta F (E k) (ι k) else 0) else H' k l j,
      fun _ _ _ => rfl⟩
  obtain ⟨G, hGdef⟩ : ∃ G : Fin T.card → Fin m → MvPolynomial (Fin n) R, ∀ k l,
      G k l = if ∃ j₀, E k j₀ = l then 0 else G' k l :=
    ⟨fun k l => if ∃ j₀, E k j₀ = l then 0 else G' k l, fun _ _ => rfl⟩
  have hRel : ∀ k l, U k * wcElkDelta F (E k) (ι k) * F l =
      ∑ j, H k l j * F (E k j) + MvPolynomial.C (π ^ 8) * G k l := by
    intro k l
    by_cases hl : ∃ j₀, E k j₀ = l
    · simp only [hHdef, hGdef, dif_pos hl, if_pos hl, mul_zero, add_zero, ite_mul, zero_mul,
        Finset.sum_ite_eq', Finset.mem_univ, if_true]
      rw [hl.choose_spec]
    · simp only [hHdef, hGdef, dif_neg hl, if_neg hl]
      linear_combination -(hG' k l)
  have hConv : ∀ k (j₀ j : Fin (s k)), H k (E k j₀) j =
      if j = j₀ then U k * wcElkDelta F (E k) (ι k) else 0 := by
    intro k j₀ j
    have hl : ∃ j', E k j' = E k j₀ := ⟨j₀, rfl⟩
    rw [hHdef, dif_pos hl]
    simp only [hE k hl.choose_spec]
  have hGConv : ∀ k (j₀ : Fin (s k)), G k (E k j₀) = 0 := by
    intro k j₀
    rw [hGdef, if_pos ⟨j₀, rfl⟩]

  have hkey : Ideal.comap Φ (Ideal.span (Set.range f)) =
      Ideal.span (Set.range F) ⊔ Ideal.span {MvPolynomial.C (π ^ 8)} := by
    rw [hfF, Set.range_comp, ← Ideal.map_span, Ideal.comap_map_of_surjective' _ hΦ, hkerΦ]
  refine ⟨n, m, F, g.toRingHom.comp Φ, T.card, s, E, ι, U, H, G, ?_, ?_, ?_, hE, hι, hRel, hConv,
    hGConv, ?_⟩
  · exact hg.comp hΦ
  · intro x
    show g (Φ (MvPolynomial.C x)) = _
    rw [hΦdef, MvPolynomial.map_C]
    exact g.commutes _
  · rw [← RingHom.comap_ker, ← hf'', hkey]
  · intro q hq
    have hs : Algebra.Smooth (R ⧸ Ideal.span {π ^ 8})
        (Localization.Away (Ideal.Quotient.mk (Ideal.span (Set.range f)) (Φ q))) := by
      have he : ((Ideal.quotientEquivAlgOfEq (R ⧸ Ideal.span {π ^ 8}) hf').trans
          (Ideal.quotientKerAlgEquivOfSurjective hg)) (Ideal.Quotient.mk _ (Φ q)) =
          (g.toRingHom.comp Φ) q := rfl
      apply htrans _ _ _ ((Ideal.quotientEquivAlgOfEq (R ⧸ Ideal.span {π ^ 8}) hf').trans
          (Ideal.quotientKerAlgEquivOfSurjective hg))
      rw [he]
      exact hq
    obtain ⟨M, y, hMy⟩ := hcover (Φ q) hs
    choose Y hY using fun k => hΦ (y k)
    refine ⟨M, Y, ?_⟩
    rw [← hkey, Ideal.mem_comap]
    simp only [map_sub, map_pow, map_sum, map_mul, hY, hU, hdet]
    exact hMy

theorem wc_pfc_elk_D_pi_smooth : (∀ (R : Type u) [CommRing R] (n m : ℕ) (F : Fin m → MvPolynomial (Fin n) R) (ι : Fin m → Fin n), Function.Injective ι → ∀ e : MvPolynomial (Fin n) R ⧸ Ideal.span (Set.range F), IsUnit (algebraMap (MvPolynomial (Fin n) R ⧸ Ideal.span (Set.range F)) (Localization.Away e) (Ideal.Quotient.mk (Ideal.span (Set.range F)) (Matrix.of fun i j : Fin m => MvPolynomial.pderiv (ι i) (F j)).det)) → Algebra.Smooth R (Localization.Away e)) → ∀ (R : Type u) [CommRing R] (π : R) (n m r : ℕ) (F : Fin m → MvPolynomial (Fin n) R) (s : Fin r → ℕ) (E : ∀ k, Fin (s k) → Fin m) (ι : ∀ k, Fin (s k) → Fin n) (U : Fin r → MvPolynomial (Fin n) R) (H : ∀ k, Fin m → Fin (s k) → MvPolynomial (Fin n) R) (G : Fin r → Fin m → MvPolynomial (Fin n) R), (∀ k l, U k * wcElkDelta F (E k) (ι k) * F l = ∑ j, H k l j * F (E k j) + MvPolynomial.C (π ^ 8) * G k l) → Algebra.Smooth R (Localization.Away (Ideal.Quotient.mk (wcElkIdeal π F s E ι U H G) (MvPolynomial.C π))) :=
by
  intro hjac R _ π n m r F s E ι U H G hRel
  classical

  have key : ∀ (s' : ℕ) (A : MvPolynomial (Fin n) R) (E' : Fin s' → Fin m)
      (H' : Fin m → Fin s' → MvPolynomial (Fin n) R) (G' : Fin m → MvPolynomial (Fin n) R)
      (l : Fin m), A * F l = ∑ j, H' l j * F (E' j) + MvPolynomial.C (π ^ 8) * G' l →
      MvPolynomial.C (π ^ 4) * wcElkP π A E' H' G' l =
        -(MvPolynomial.rename (Fin.castAdd m) A * wcElkEq1 π F l) +
          ∑ j, MvPolynomial.rename (Fin.castAdd m) (H' l j) * wcElkEq1 π F (E' j) := by
    intro s' A E' H' G' l h
    have h' := congrArg (MvPolynomial.rename (R := R) (Fin.castAdd m : Fin n → Fin (n + m))) h
    simp only [map_mul, map_add, map_sum, MvPolynomial.rename_C] at h'
    have hc : (MvPolynomial.C (π ^ 8) : MvPolynomial (Fin (n + m)) R) =
        MvPolynomial.C (π ^ 4) * MvPolynomial.C (π ^ 4) := by
      rw [← map_mul]; congr 1; ring
    have e2 : ∑ j, MvPolynomial.rename (Fin.castAdd m) (H' l j) *
        (MvPolynomial.C (π ^ 4) * MvPolynomial.X (Fin.natAdd n (E' j))) =
        MvPolynomial.C (π ^ 4) * ∑ j, MvPolynomial.rename (Fin.castAdd m) (H' l j) *
          MvPolynomial.X (Fin.natAdd n (E' j)) := by
      rw [Finset.mul_sum]
      exact Finset.sum_congr rfl (fun j _ => by ring)
    unfold wcElkP wcElkEq1
    simp only [mul_sub, Finset.sum_sub_distrib]
    rw [e2]
    linear_combination h' + MvPolynomial.rename (Fin.castAdd m) (G' l) * hc

  set J₁ : Ideal (MvPolynomial (Fin (n + m)) R) := Ideal.span (Set.range (wcElkEq1 π F)) with hJ₁
  set J₂ : Ideal (MvPolynomial (Fin (n + m)) R) := wcElkIdeal π F s E ι U H G with hJ₂
  have hz : ∀ (i : Fin m) (p : MvPolynomial (Fin n) R),
      MvPolynomial.pderiv (Fin.natAdd n i) (MvPolynomial.rename (Fin.castAdd m) p) = 0 := by
    intro i p
    induction p using MvPolynomial.induction_on with
    | C a => rw [MvPolynomial.rename_C, MvPolynomial.pderiv_C]
    | add p q hp hq => rw [map_add, map_add, hp, hq, add_zero]
    | mul_X p k hp =>
      rw [map_mul, MvPolynomial.rename_X, MvPolynomial.pderiv_mul, hp, MvPolynomial.pderiv_X]
      have hne : Fin.castAdd m k ≠ Fin.natAdd n i := by
        intro h
        have h2 := congrArg Fin.val h
        simp only [Fin.val_castAdd, Fin.val_natAdd] at h2
        have := k.isLt
        omega
      rw [Pi.single_eq_of_ne hne, zero_mul, mul_zero, add_zero]
  have hM : (Matrix.of fun i j : Fin m =>
      MvPolynomial.pderiv (Fin.natAdd n i) (wcElkEq1 π F j)) =
      Matrix.diagonal (fun _ => -MvPolynomial.C (π ^ 4)) := by
    ext i j
    rw [Matrix.of_apply, Matrix.diagonal_apply]
    unfold wcElkEq1
    rw [map_sub, hz, MvPolynomial.pderiv_C_mul, MvPolynomial.pderiv_X, zero_sub]
    by_cases hij : i = j
    · subst hij
      rw [if_pos rfl, Pi.single_eq_same, mul_one]
    · rw [if_neg hij, Pi.single_eq_of_ne (fun h => hij ((Fin.natAdd_injective m n h).symm)),
        mul_zero, neg_zero]
  have hu : IsUnit (algebraMap (MvPolynomial (Fin (n + m)) R ⧸ J₁)
      (Localization.Away (Ideal.Quotient.mk J₁ (MvPolynomial.C π)))
      (Ideal.Quotient.mk J₁ (MvPolynomial.C π))) := IsLocalization.Away.algebraMap_isUnit _
  have hsm₁ : Algebra.Smooth R (Localization.Away (Ideal.Quotient.mk J₁ (MvPolynomial.C π))) := by
    apply hjac R (n + m) m (wcElkEq1 π F) (Fin.natAdd n) (Fin.natAdd_injective m n)
    rw [hM, Matrix.det_diagonal, Finset.prod_const, Finset.card_univ, Fintype.card_fin,
      show (MvPolynomial.C (π ^ 4) : MvPolynomial (Fin (n + m)) R) = MvPolynomial.C π ^ 4 from
        map_pow _ _ _, map_pow, map_neg, map_pow, map_pow, map_neg, map_pow]
    exact ((hu.pow 4).neg).pow m

  have hle : J₁ ≤ J₂ := Ideal.span_mono Set.subset_union_left
  have hkill : ∀ t ∈ J₂, ((algebraMap (MvPolynomial (Fin (n + m)) R ⧸ J₁)
      (Localization.Away (Ideal.Quotient.mk J₁ (MvPolynomial.C π)))).comp
        (Ideal.Quotient.mk J₁)) t = 0 := by
    intro t ht
    rw [← RingHom.mem_ker]
    revert t
    rw [← SetLike.le_def, hJ₂]
    unfold wcElkIdeal
    rw [Ideal.span_le]
    rintro t (⟨l, rfl⟩ | ⟨kl, rfl⟩)
    · have hl : wcElkEq1 π F l ∈ J₁ := Ideal.subset_span (Set.mem_range_self l)
      rw [SetLike.mem_coe, RingHom.mem_ker, RingHom.comp_apply,
        Ideal.Quotient.eq_zero_iff_mem.mpr hl, map_zero]
    · have hkey := key (s kl.1) (U kl.1 * wcElkDelta F (E kl.1) (ι kl.1)) (E kl.1) (H kl.1)
        (G kl.1) kl.2 (hRel kl.1 kl.2)
      have hmem : MvPolynomial.C (π ^ 4) * wcElkP π (U kl.1 * wcElkDelta F (E kl.1) (ι kl.1))
          (E kl.1) (H kl.1) (G kl.1) kl.2 ∈ J₁ := by
        rw [hkey]
        have hq : ∀ l, wcElkEq1 π F l ∈ J₁ := fun l => Ideal.subset_span (Set.mem_range_self l)
        refine Ideal.add_mem _ (neg_mem (Ideal.mul_mem_left _ _ (hq kl.2)))
          (Ideal.sum_mem _ fun j _ => Ideal.mul_mem_left _ _ (hq _))
      have h0 := Ideal.Quotient.eq_zero_iff_mem.mpr hmem
      rw [map_mul, show (MvPolynomial.C (π ^ 4) : MvPolynomial (Fin (n + m)) R) =
        MvPolynomial.C π ^ 4 from map_pow _ _ _, map_pow] at h0
      have h1 := congrArg (algebraMap (MvPolynomial (Fin (n + m)) R ⧸ J₁)
        (Localization.Away (Ideal.Quotient.mk J₁ (MvPolynomial.C π)))) h0
      rw [map_mul, map_pow, map_zero] at h1
      rw [SetLike.mem_coe, RingHom.mem_ker, RingHom.comp_apply]
      exact (hu.pow 4).mul_right_eq_zero.mp h1

  have hg₁ : IsUnit (((algebraMap (MvPolynomial (Fin (n + m)) R ⧸ J₂)
      (Localization.Away (Ideal.Quotient.mk J₂ (MvPolynomial.C π)))).comp
        (Ideal.Quotient.factor hle)) (Ideal.Quotient.mk J₁ (MvPolynomial.C π))) := by
    rw [RingHom.comp_apply, Ideal.Quotient.factor_mk]
    exact IsLocalization.Away.algebraMap_isUnit _
  have hf₂ : IsUnit ((Ideal.Quotient.lift J₂ ((algebraMap (MvPolynomial (Fin (n + m)) R ⧸ J₁)
      (Localization.Away (Ideal.Quotient.mk J₁ (MvPolynomial.C π)))).comp
        (Ideal.Quotient.mk J₁)) hkill) (Ideal.Quotient.mk J₂ (MvPolynomial.C π))) := by
    rw [Ideal.Quotient.lift_mk]
    exact hu
  let α := IsLocalization.Away.lift (S := Localization.Away (Ideal.Quotient.mk J₁ (MvPolynomial.C π)))
    (Ideal.Quotient.mk J₁ (MvPolynomial.C π)) hg₁
  let β := IsLocalization.Away.lift (S := Localization.Away (Ideal.Quotient.mk J₂ (MvPolynomial.C π)))
    (Ideal.Quotient.mk J₂ (MvPolynomial.C π)) hf₂
  have hα : ∀ t, α (algebraMap _ (Localization.Away (Ideal.Quotient.mk J₁ (MvPolynomial.C π)))
      (Ideal.Quotient.mk J₁ t)) = algebraMap _
        (Localization.Away (Ideal.Quotient.mk J₂ (MvPolynomial.C π))) (Ideal.Quotient.mk J₂ t) := by
    intro t
    rw [IsLocalization.Away.lift_eq, RingHom.comp_apply, Ideal.Quotient.factor_mk]
  have hβ : ∀ t, β (algebraMap _ (Localization.Away (Ideal.Quotient.mk J₂ (MvPolynomial.C π)))
      (Ideal.Quotient.mk J₂ t)) = algebraMap _
        (Localization.Away (Ideal.Quotient.mk J₁ (MvPolynomial.C π))) (Ideal.Quotient.mk J₁ t) := by
    intro t
    rw [IsLocalization.Away.lift_eq, Ideal.Quotient.lift_mk, RingHom.comp_apply]
  have hβα : β.comp α = RingHom.id _ := by
    apply IsLocalization.ringHom_ext (Submonoid.powers (Ideal.Quotient.mk J₁ (MvPolynomial.C π)))
    apply Ideal.Quotient.ringHom_ext
    refine RingHom.ext fun t => ?_
    simp only [RingHom.comp_apply, RingHom.id_apply]
    rw [hα, hβ]
  have hαβ : α.comp β = RingHom.id _ := by
    apply IsLocalization.ringHom_ext (Submonoid.powers (Ideal.Quotient.mk J₂ (MvPolynomial.C π)))
    apply Ideal.Quotient.ringHom_ext
    refine RingHom.ext fun t => ?_
    simp only [RingHom.comp_apply, RingHom.id_apply]
    rw [hβ, hα]
  let eqv := RingEquiv.ofRingHom α β hαβ hβα
  have hR : ∀ x : R, eqv (algebraMap R
      (Localization.Away (Ideal.Quotient.mk J₁ (MvPolynomial.C π))) x) =
      algebraMap R (Localization.Away (Ideal.Quotient.mk J₂ (MvPolynomial.C π))) x := by
    intro x
    show α _ = _
    rw [IsScalarTower.algebraMap_apply R (MvPolynomial (Fin (n + m)) R ⧸ J₁)
        (Localization.Away (Ideal.Quotient.mk J₁ (MvPolynomial.C π))),
      IsScalarTower.algebraMap_apply R (MvPolynomial (Fin (n + m)) R ⧸ J₂)
        (Localization.Away (Ideal.Quotient.mk J₂ (MvPolynomial.C π))),
      ← Ideal.Quotient.mk_algebraMap, ← Ideal.Quotient.mk_algebraMap, hα]
  exact Algebra.Smooth.of_equiv (AlgEquiv.ofRingEquiv (f := eqv) hR)

theorem wc_pfc_elk_D_chart_smooth : (∀ (R : Type u) [CommRing R] (n m : ℕ) (F : Fin m → MvPolynomial (Fin n) R) (ι : Fin m → Fin n), Function.Injective ι → ∀ e : MvPolynomial (Fin n) R ⧸ Ideal.span (Set.range F), IsUnit (algebraMap (MvPolynomial (Fin n) R ⧸ Ideal.span (Set.range F)) (Localization.Away e) (Ideal.Quotient.mk (Ideal.span (Set.range F)) (Matrix.of fun i j : Fin m => MvPolynomial.pderiv (ι i) (F j)).det)) → Algebra.Smooth R (Localization.Away e)) → (∀ (R : Type u) [CommRing R] (M : Type u) [AddCommGroup M] [Module R M] [Module.Flat R M] (w : R), (∀ y : R, y * w ^ 2 = 0 → y * w = 0) → ∀ x : M, w ^ 2 • x = 0 → w • x = 0) → ∀ (R : Type u) [CommRing R] (π : R), (∀ y : R, y * π ^ 2 = 0 → y * π = 0) → ∀ (n m r : ℕ) (F : Fin m → MvPolynomial (Fin n) R) (s : Fin r → ℕ) (E : ∀ k, Fin (s k) → Fin m) (ι : ∀ k, Fin (s k) → Fin n) (U : Fin r → MvPolynomial (Fin n) R) (H : ∀ k, Fin m → Fin (s k) → MvPolynomial (Fin n) R) (G : Fin r → Fin m → MvPolynomial (Fin n) R), (∀ k, Function.Injective (E k)) → (∀ k, Function.Injective (ι k)) → (∀ k l, U k * wcElkDelta F (E k) (ι k) * F l = ∑ j, H k l j * F (E k j) + MvPolynomial.C (π ^ 8) * G k l) → (∀ k (j₀ j : Fin (s k)), H k (E k j₀) j = if j = j₀ then U k * wcElkDelta F (E k) (ι k) else 0) → (∀ k (j₀ : Fin (s k)), G k (E k j₀) = 0) → ∀ k, Algebra.Smooth R (Localization.Away (Ideal.Quotient.mk (wcElkIdeal π F s E ι U H G) (MvPolynomial.rename (Fin.castAdd m) (U k * wcElkDelta F (E k) (ι k))))) :=
by
  intro hjac hflat R _ π hπ n m r F s E ι U H G hE hι hRel hConv hGConv
  classical

  have hπ4 : ∀ y : R, y * (π ^ 4) ^ 2 = 0 → y * π ^ 4 = 0 := by
    intro y hy
    have h8 : y * π ^ 8 = 0 := by linear_combination hy
    have h7 : y * π ^ 7 = 0 := by
      have := hπ (y * π ^ 6) (by linear_combination h8); linear_combination this
    have h6 : y * π ^ 6 = 0 := by
      have := hπ (y * π ^ 5) (by linear_combination h7); linear_combination this
    have h5 : y * π ^ 5 = 0 := by
      have := hπ (y * π ^ 4) (by linear_combination h6); linear_combination this
    have := hπ (y * π ^ 3) (by linear_combination h5); linear_combination this

  have key : ∀ (s' : ℕ) (A : MvPolynomial (Fin n) R) (E' : Fin s' → Fin m)
      (H' : Fin m → Fin s' → MvPolynomial (Fin n) R) (G' : Fin m → MvPolynomial (Fin n) R)
      (l : Fin m), A * F l = ∑ j, H' l j * F (E' j) + MvPolynomial.C (π ^ 8) * G' l →
      MvPolynomial.C (π ^ 4) * wcElkP π A E' H' G' l =
        -(MvPolynomial.rename (Fin.castAdd m) A * wcElkEq1 π F l) +
          ∑ j, MvPolynomial.rename (Fin.castAdd m) (H' l j) * wcElkEq1 π F (E' j) := by
    intro s' A E' H' G' l h
    have h' := congrArg (MvPolynomial.rename (R := R) (Fin.castAdd m : Fin n → Fin (n + m))) h
    simp only [map_mul, map_add, map_sum, MvPolynomial.rename_C] at h'
    have hc : (MvPolynomial.C (π ^ 8) : MvPolynomial (Fin (n + m)) R) =
        MvPolynomial.C (π ^ 4) * MvPolynomial.C (π ^ 4) := by
      rw [← map_mul]; congr 1; ring
    have e2 : ∑ j, MvPolynomial.rename (Fin.castAdd m) (H' l j) *
        (MvPolynomial.C (π ^ 4) * MvPolynomial.X (Fin.natAdd n (E' j))) =
        MvPolynomial.C (π ^ 4) * ∑ j, MvPolynomial.rename (Fin.castAdd m) (H' l j) *
          MvPolynomial.X (Fin.natAdd n (E' j)) := by
      rw [Finset.mul_sum]
      exact Finset.sum_congr rfl (fun j _ => by ring)
    unfold wcElkP wcElkEq1
    simp only [mul_sub, Finset.sum_sub_distrib]
    rw [e2]
    linear_combination h' + MvPolynomial.rename (Fin.castAdd m) (G' l) * hc

  have cs : ∀ (s t : ℕ) (A B : MvPolynomial (Fin n) R) (E : Fin s → Fin m)
      (H : Fin m → Fin s → MvPolynomial (Fin n) R) (G : Fin m → MvPolynomial (Fin n) R)
      (E' : Fin t → Fin m) (H' : Fin m → Fin t → MvPolynomial (Fin n) R)
      (G' : Fin m → MvPolynomial (Fin n) R),
      (∀ l, A * F l = ∑ j, H l j * F (E j) + MvPolynomial.C (π ^ 8) * G l) →
      (∀ l, B * F l = ∑ j, H' l j * F (E' j) + MvPolynomial.C (π ^ 8) * G' l) →
      ∀ l, ∑ i, (B * H l i - ∑ j, H' l j * H (E' j) i) * F (E i) =
        MvPolynomial.C (π ^ 8) * (A * G' l - B * G l + ∑ j, H' l j * G (E' j)) := by
    intro s t A B E H G E' H' G' relA relB l
    have t1 : ∑ i, (B * H l i - ∑ j, H' l j * H (E' j) i) * F (E i) =
        B * ∑ i, H l i * F (E i) - ∑ i, (∑ j, H' l j * H (E' j) i) * F (E i) := by
      rw [Finset.mul_sum, ← Finset.sum_sub_distrib]
      exact Finset.sum_congr rfl fun _ _ => by ring
    have t23 : ∑ i, (∑ j, H' l j * H (E' j) i) * F (E i) =
        A * ∑ j, H' l j * F (E' j) - MvPolynomial.C (π ^ 8) * ∑ j, H' l j * G (E' j) := by
      have hrow : ∀ j, ∑ i, H (E' j) i * F (E i) =
          A * F (E' j) - MvPolynomial.C (π ^ 8) * G (E' j) := fun j => by
        rw [relA (E' j)]; ring
      calc ∑ i, (∑ j, H' l j * H (E' j) i) * F (E i)
          = ∑ j, H' l j * ∑ i, H (E' j) i * F (E i) := by
            simp_rw [Finset.sum_mul, Finset.mul_sum]
            rw [Finset.sum_comm]
            exact Finset.sum_congr rfl fun _ _ => Finset.sum_congr rfl fun _ _ => by ring
        _ = ∑ j, H' l j * (A * F (E' j) - MvPolynomial.C (π ^ 8) * G (E' j)) := by
            simp_rw [hrow]
        _ = _ := by
            rw [Finset.mul_sum, Finset.mul_sum, ← Finset.sum_sub_distrib]
            exact Finset.sum_congr rfl fun _ _ => by ring
    linear_combination t1 - t23 - B * relA l + A * relB l

  have minor : ∀ (s : ℕ) (F' c : Fin s → MvPolynomial (Fin n) R) (ι : Fin s → Fin n) (w : R)
      (g : MvPolynomial (Fin n) R) (K : Ideal (MvPolynomial (Fin n) R)),
      (∀ j, F' j ∈ K) → MvPolynomial.C w ∈ K → ∑ j, c j * F' j = MvPolynomial.C w * g →
      ∀ j, (Matrix.of fun i j : Fin s => MvPolynomial.pderiv (ι i) (F' j)).det * c j ∈ K := by
    intro s F' c ι w g K hF hw hsum j
    obtain ⟨M, hM⟩ : ∃ M : Matrix (Fin s) (Fin s) (MvPolynomial (Fin n) R),
        M = Matrix.of fun i j : Fin s => MvPolynomial.pderiv (ι i) (F' j) := ⟨_, rfl⟩
    rw [← hM]
    have hv : ∀ i, M.mulVec c i ∈ K := by
      intro i
      have h1 := congrArg (MvPolynomial.pderiv (ι i)) hsum
      rw [map_sum, MvPolynomial.pderiv_C_mul] at h1
      simp only [MvPolynomial.pderiv_mul] at h1
      have h2 : M.mulVec c i = MvPolynomial.C w * MvPolynomial.pderiv (ι i) g -
          ∑ j, MvPolynomial.pderiv (ι i) (c j) * F' j := by
        rw [← h1, Finset.sum_add_distrib, add_sub_cancel_left]
        simp only [Matrix.mulVec, dotProduct, hM, Matrix.of_apply]
        exact Finset.sum_congr rfl fun j _ => mul_comm _ _
      rw [h2]
      exact K.sub_mem (K.mul_mem_right _ hw) (K.sum_mem fun j _ => K.mul_mem_left _ (hF j))
    have h3 : M.adjugate.mulVec (M.mulVec c) = M.det • c := by
      rw [Matrix.mulVec_mulVec, Matrix.adjugate_mul, Matrix.smul_mulVec, Matrix.one_mulVec]
    have h4 := congrFun h3 j
    rw [Pi.smul_apply, smul_eq_mul] at h4
    rw [← h4]
    simp only [Matrix.mulVec, dotProduct]
    exact K.sum_mem fun i _ => K.mul_mem_left _ (hv i)

  have alg : ∀ (T : Type u) [CommRing T] (s t : ℕ) (E : Fin s → Fin m) (E' : Fin t → Fin m)
      (l : Fin m) (a b w : T) (z : Fin m → T) (h : Fin m → Fin s → T) (γ : Fin m → T)
      (h' : Fin m → Fin t → T) (γ' : Fin m → T),
      (∀ x, a * z x = ∑ i, h x i * z (E i) + w * γ x) →
      a * (b * z l - ∑ j, h' l j * z (E' j) - w * γ' l) =
        ∑ i, (b * h l i - ∑ j, h' l j * h (E' j) i) * z (E i) +
          w * (b * γ l - ∑ j, h' l j * γ (E' j) - a * γ' l) := by
    intro T _ s t E E' l a b w z h γ h' γ' hown
    have s1 : a * ∑ j, h' l j * z (E' j) = ∑ j, h' l j * (a * z (E' j)) := by
      rw [Finset.mul_sum]; exact Finset.sum_congr rfl fun _ _ => by ring
    have s2 : ∑ j, h' l j * (a * z (E' j)) =
        ∑ j, h' l j * ∑ i, h (E' j) i * z (E i) + w * ∑ j, h' l j * γ (E' j) := by
      simp_rw [hown]
      rw [Finset.mul_sum, ← Finset.sum_add_distrib]
      exact Finset.sum_congr rfl fun _ _ => by ring
    have s3 : ∑ j, h' l j * ∑ i, h (E' j) i * z (E i) =
        ∑ i, (∑ j, h' l j * h (E' j) i) * z (E i) := by
      simp_rw [Finset.mul_sum, Finset.sum_mul]
      rw [Finset.sum_comm]
      exact Finset.sum_congr rfl fun _ _ => Finset.sum_congr rfl fun _ _ => by ring
    have s4 : ∑ i, (b * h l i - ∑ j, h' l j * h (E' j) i) * z (E i) =
        b * ∑ i, h l i * z (E i) - ∑ i, (∑ j, h' l j * h (E' j) i) * z (E i) := by
      rw [Finset.mul_sum, ← Finset.sum_sub_distrib]
      exact Finset.sum_congr rfl fun _ _ => by ring
    linear_combination b * hown l - s1 - s2 - s3 - s4

  have unitAux : ∀ (S T : Type u) [CommRing S] [CommRing T] [Algebra S T] (a v δ d : S) (N : ℕ),
      IsUnit (algebraMap S T a) → a = v * δ → d = δ * a ^ N → IsUnit (algebraMap S T d) := by
    intro S T _ _ _ a v δ d N ha hav hd
    rw [hd, map_mul, map_pow]
    refine IsUnit.mul ?_ (ha.pow N)
    rw [hav, map_mul] at ha
    exact isUnit_of_mul_isUnit_right ha
  have hne : ∀ (a : Fin n) (b : Fin m), Fin.castAdd m a ≠ Fin.natAdd n b := by
    intro a b h
    have h2 := congrArg Fin.val h
    simp only [Fin.val_castAdd, Fin.val_natAdd] at h2
    have := a.isLt
    omega
  have hz : ∀ (i : Fin m) (p : MvPolynomial (Fin n) R),
      MvPolynomial.pderiv (Fin.natAdd n i) (MvPolynomial.rename (Fin.castAdd m) p) = 0 := by
    intro i p
    induction p using MvPolynomial.induction_on with
    | C a => rw [MvPolynomial.rename_C, MvPolynomial.pderiv_C]
    | add p q hp hq => rw [map_add, map_add, hp, hq, add_zero]
    | mul_X p k hp =>
      rw [map_mul, MvPolynomial.rename_X, MvPolynomial.pderiv_mul, hp, MvPolynomial.pderiv_X,
        Pi.single_eq_of_ne (hne k i), zero_mul, mul_zero, add_zero]

  have hDk : ∀ (s : ℕ) (E : Fin s → Fin m) (ι : Fin s → Fin n) (V : MvPolynomial (Fin n) R)
      (H : Fin m → Fin s → MvPolynomial (Fin n) R) (G : Fin m → MvPolynomial (Fin n) R)
      (eqk : Fin m → MvPolynomial (Fin (n + m)) R), Function.Injective E → Function.Injective ι →
      (∀ l, (∃ j, E j = l) → eqk l = wcElkEq1 π F l) →
      (∀ l, ¬ (∃ j, E j = l) → eqk l = wcElkP π (V * wcElkDelta F E ι) E H G l) →
      Algebra.Smooth R (Localization.Away (Ideal.Quotient.mk (Ideal.span (Set.range eqk))
        (MvPolynomial.rename (Fin.castAdd m) (V * wcElkDelta F E ι)))) := by
    intro s E ι V H G eqk hE hι heqk1 heqk2
    obtain ⟨ι', hι'⟩ : ∃ ι' : Fin m → Fin (n + m), ∀ l, ι' l =
        if h : ∃ j, E j = l then Fin.castAdd m (ι h.choose) else Fin.natAdd n l :=
      ⟨_, fun _ => rfl⟩
    have hι'p : ∀ j, ι' (E j) = Fin.castAdd m (ι j) := by
      intro j
      have h : ∃ j', E j' = E j := ⟨j, rfl⟩
      rw [hι', dif_pos h]
      exact congrArg _ (congrArg _ (hE h.choose_spec))
    have hι'n : ∀ l, ¬ (∃ j, E j = l) → ι' l = Fin.natAdd n l := fun l h => by
      rw [hι', dif_neg h]
    have hinj : Function.Injective ι' := by
      intro a b hab
      by_cases ha : ∃ j, E j = a <;> by_cases hb : ∃ j, E j = b
      · obtain ⟨ja, rfl⟩ := ha
        obtain ⟨jb, rfl⟩ := hb
        rw [hι'p, hι'p] at hab
        exact congrArg E (hι (Fin.castAdd_injective _ _ hab))
      · obtain ⟨ja, rfl⟩ := ha
        rw [hι'p, hι'n b hb] at hab
        exact absurd hab (hne _ _)
      · obtain ⟨jb, rfl⟩ := hb
        rw [hι'p, hι'n a ha] at hab
        exact absurd hab.symm (hne _ _)
      · rw [hι'n a ha, hι'n b hb] at hab
        exact Fin.natAdd_injective m n hab
    obtain ⟨M, hM⟩ : ∃ M : Matrix (Fin m) (Fin m) (MvPolynomial (Fin (n + m)) R),
        M = Matrix.of fun i j => MvPolynomial.pderiv (ι' i) (eqk j) := ⟨_, rfl⟩
    have hMab : ∀ a b, M a b = MvPolynomial.pderiv (ι' a) (eqk b) := fun a b => by
      rw [hM, Matrix.of_apply]
    have hLL : ∀ a, ¬ (∃ j, E j = a) → ∀ b, (∃ j, E j = b) → M a b = 0 := by
      intro a ha b hb
      rw [hMab, hι'n a ha, heqk1 b hb]
      unfold wcElkEq1
      rw [map_sub, hz, MvPolynomial.pderiv_C_mul, MvPolynomial.pderiv_X,
        Pi.single_eq_of_ne (fun h => ha (by
          obtain ⟨j, hj⟩ := hb; exact ⟨j, hj.trans (Fin.natAdd_injective m n h)⟩)),
        mul_zero, sub_zero]
    have hNP : M.toSquareBlockProp (fun i => ¬ ∃ j, E j = i) =
        Matrix.diagonal (fun _ => MvPolynomial.rename (Fin.castAdd m) (V * wcElkDelta F E ι)) := by
      refine Matrix.ext fun i j => ?_
      obtain ⟨a, ha⟩ := i
      obtain ⟨b, hb⟩ := j
      show M a b = _
      rw [hMab, hι'n a ha, heqk2 b hb, Matrix.diagonal_apply]
      unfold wcElkP
      simp only [map_sub, map_sum, MvPolynomial.pderiv_mul, MvPolynomial.pderiv_C_mul, hz,
        MvPolynomial.pderiv_C, MvPolynomial.pderiv_X, zero_mul, mul_zero, zero_add, sub_zero,
        add_zero]
      have hsum : ∀ j, (Pi.single (Fin.natAdd n a) (1 : MvPolynomial (Fin (n + m)) R) :
          Fin (n + m) → MvPolynomial (Fin (n + m)) R) (Fin.natAdd n (E j)) = 0 := fun j =>
        Pi.single_eq_of_ne (fun h => ha ⟨j, Fin.natAdd_injective m n h⟩) _
      simp only [hsum, mul_zero, Finset.sum_const_zero, sub_zero]
      by_cases hab : a = b
      · subst hab; simp
      · rw [Pi.single_eq_of_ne (fun h => hab (Fin.natAdd_injective m n h).symm),
          if_neg (fun h => hab (congrArg Subtype.val h)), mul_zero]
    let e : Fin s ≃ {a // ∃ j, E j = a} := Equiv.ofBijective (fun j => ⟨E j, j, rfl⟩)
      ⟨fun x y h => hE (congrArg Subtype.val h), fun ⟨a, j, hj⟩ => ⟨j, Subtype.ext hj⟩⟩
    have hP : (M.toSquareBlockProp (fun i => ∃ j, E j = i)).submatrix e e =
        (MvPolynomial.rename (Fin.castAdd m) :
          MvPolynomial (Fin n) R →ₐ[R] MvPolynomial (Fin (n + m)) R).toRingHom.mapMatrix
          (Matrix.of fun i j : Fin s => MvPolynomial.pderiv (ι i) (F (E j))) := by
      refine Matrix.ext fun i j => ?_
      show M (E i) (E j) = MvPolynomial.rename (Fin.castAdd m) (MvPolynomial.pderiv (ι i) (F (E j)))
      rw [hMab, hι'p, heqk1 _ ⟨j, rfl⟩]
      unfold wcElkEq1
      rw [map_sub, MvPolynomial.pderiv_rename (Fin.castAdd_injective _ _),
        MvPolynomial.pderiv_C_mul, MvPolynomial.pderiv_X, Pi.single_eq_of_ne (hne _ _).symm,
        mul_zero, sub_zero]
    have hdet : M.det = MvPolynomial.rename (Fin.castAdd m) (wcElkDelta F E ι) *
        MvPolynomial.rename (Fin.castAdd m) (V * wcElkDelta F E ι) ^
          Fintype.card {a // ¬ ∃ j, E j = a} := by
      rw [Matrix.twoBlockTriangular_det M (fun i => ∃ j, E j = i) hLL, hNP, Matrix.det_diagonal,
        Finset.prod_const, Finset.card_univ, ← Matrix.det_submatrix_equiv_self e, hP,
        ← RingHom.map_det]
      rfl
    apply hjac R (n + m) m eqk ι' hinj
    rw [← hM]
    exact unitAux _ _
      (Ideal.Quotient.mk _ (MvPolynomial.rename (Fin.castAdd m) (V * wcElkDelta F E ι)))
      (Ideal.Quotient.mk _ (MvPolynomial.rename (Fin.castAdd m) V))
      (Ideal.Quotient.mk _ (MvPolynomial.rename (Fin.castAdd m) (wcElkDelta F E ι))) _ _
      (IsLocalization.Away.algebraMap_isUnit _) (by rw [← map_mul, ← map_mul])
      (by rw [hdet, map_mul, map_pow])


  intro k
  obtain ⟨A, hA⟩ : ∃ A, A = U k * wcElkDelta F (E k) (ι k) := ⟨_, rfl⟩
  rw [← hA]
  have hRel' : ∀ l, A * F l = ∑ j, H k l j * F (E k j) + MvPolynomial.C (π ^ 8) * G k l :=
    fun l => by rw [hA]; exact hRel k l
  have hConv' : ∀ (j₀ j : Fin (s k)), H k (E k j₀) j = if j = j₀ then A else 0 :=
    fun j₀ j => by rw [hA]; exact hConv k j₀ j
  obtain ⟨eqk, heqk⟩ : ∃ eqk : Fin m → MvPolynomial (Fin (n + m)) R, ∀ l, eqk l =
      if ∃ j, E k j = l then wcElkEq1 π F l else wcElkP π A (E k) (H k) (G k) l :=
    ⟨_, fun _ => rfl⟩
  obtain ⟨J, hJ⟩ : ∃ J : Ideal (MvPolynomial (Fin (n + m)) R), J = Ideal.span (Set.range eqk) :=
    ⟨_, rfl⟩
  have hL := hDk (s k) (E k) (ι k) (U k) (H k) (G k) eqk (hE k) (hι k)
    (fun l h => by rw [heqk, if_pos h]) (fun l h => by rw [heqk, if_neg h, hA])
  rw [← hA, ← hJ] at hL
  obtain ⟨κ, hκ⟩ : ∃ κ : MvPolynomial (Fin (n + m)) R →+*
      Localization.Away (Ideal.Quotient.mk J (MvPolynomial.rename (Fin.castAdd m) A)),
      κ = (algebraMap _ _).comp (Ideal.Quotient.mk J) := ⟨_, rfl⟩
  have hJκ : ∀ t ∈ J, κ t = 0 := fun t ht => by
    rw [hκ, RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem.mpr ht, map_zero]
  have hā : IsUnit (κ (MvPolynomial.rename (Fin.castAdd m) A)) := by
    rw [hκ, RingHom.comp_apply]; exact IsLocalization.Away.algebraMap_isUnit _
  have hC : ∀ x : R, κ (MvPolynomial.C x) = algebraMap R
      (Localization.Away (Ideal.Quotient.mk J (MvPolynomial.rename (Fin.castAdd m) A))) x := by
    intro x
    rw [hκ, RingHom.comp_apply, IsScalarTower.algebraMap_apply R (MvPolynomial (Fin (n + m)) R ⧸ J)
      (Localization.Away (Ideal.Quotient.mk J (MvPolynomial.rename (Fin.castAdd m) A))),
      ← Ideal.Quotient.mk_algebraMap, MvPolynomial.algebraMap_eq]
  obtain ⟨ϖ, hϖ⟩ : ∃ ϖ : Localization.Away (Ideal.Quotient.mk J
      (MvPolynomial.rename (Fin.castAdd m) A)), ϖ = algebraMap R _ (π ^ 4) := ⟨_, rfl⟩
  have hC8 : κ (MvPolynomial.C (π ^ 8)) = ϖ * ϖ := by
    rw [hC, hϖ, ← map_mul, ← pow_add]
  have hJmem1 : ∀ j, wcElkEq1 π F (E k j) ∈ J := fun j => by
    rw [hJ]; exact Ideal.subset_span ⟨E k j, by rw [heqk, if_pos ⟨j, rfl⟩]⟩

  have hown : ∀ l, κ (wcElkP π A (E k) (H k) (G k) l) = 0 := by
    intro l
    by_cases h : ∃ j, E k j = l
    · obtain ⟨j₀, rfl⟩ := h
      have hP0 : wcElkP π A (E k) (H k) (G k) (E k j₀) = 0 := by
        unfold wcElkP
        rw [hGConv k j₀, map_zero, mul_zero, sub_zero,
          Finset.sum_eq_single j₀ (fun j _ hj => by rw [hConv' j₀ j, if_neg hj, map_zero, zero_mul])
            (fun h => absurd (Finset.mem_univ _) h), hConv' j₀ j₀, if_pos rfl, sub_self]
      rw [hP0, map_zero]
    · exact hJκ _ (by rw [hJ]; exact Ideal.subset_span ⟨l, by rw [heqk, if_neg h]⟩)

  have heq1 : ∀ l, κ (wcElkEq1 π F l) = 0 := by
    intro l
    by_cases h : ∃ j, E k j = l
    · exact hJκ _ (by rw [hJ]; exact Ideal.subset_span ⟨l, by rw [heqk, if_pos h]⟩)
    · have h1 := congrArg κ (key (s k) A (E k) (H k) (G k) l (hRel' l))
      have hsum0 : κ (∑ j, MvPolynomial.rename (Fin.castAdd m) (H k l j) *
          wcElkEq1 π F (E k j)) = 0 := by
        rw [map_sum]
        exact Finset.sum_eq_zero fun j _ => by rw [map_mul, hJκ _ (hJmem1 j), mul_zero]
      rw [map_mul, hown, mul_zero, map_add, hsum0, add_zero, map_neg, map_mul] at h1
      have h2 : κ (MvPolynomial.rename (Fin.castAdd m) A) * κ (wcElkEq1 π F l) = 0 := by
        linear_combination h1
      exact hā.mul_right_eq_zero.mp h2
  have hF : ∀ l, κ (MvPolynomial.rename (Fin.castAdd m) (F l)) =
      ϖ * κ (MvPolynomial.X (Fin.natAdd n l)) := by
    intro l
    have h := heq1 l
    unfold wcElkEq1 at h
    rw [map_sub, map_mul, hC, ← hϖ, sub_eq_zero] at h
    exact h
  have hzrel : ∀ x, κ (MvPolynomial.rename (Fin.castAdd m) A) * κ (MvPolynomial.X (Fin.natAdd n x)) =
      ∑ i, κ (MvPolynomial.rename (Fin.castAdd m) (H k x i)) *
        κ (MvPolynomial.X (Fin.natAdd n (E k i))) +
        ϖ * κ (MvPolynomial.rename (Fin.castAdd m) (G k x)) := by
    intro x
    have h := hown x
    unfold wcElkP at h
    simp only [map_sub, map_mul, map_sum, hC] at h
    rw [hϖ]
    linear_combination h
  have hdiv : ∀ x, κ (MvPolynomial.rename (Fin.castAdd m) A) * x ∈ Ideal.span {ϖ} →
      x ∈ Ideal.span {ϖ} := by
    intro x hx
    have e : x = ↑hā.unit⁻¹ * (κ (MvPolynomial.rename (Fin.castAdd m) A) * x) := by
      rw [← mul_assoc, hā.val_inv_mul, one_mul]
    rw [e]
    exact Ideal.mul_mem_left _ _ hx
  haveI := hL
  haveI : Module.Flat R (Localization.Away (Ideal.Quotient.mk J
      (MvPolynomial.rename (Fin.castAdd m) A))) := Algebra.Smooth.flat R _

  have hother : ∀ (k' : Fin r) (l : Fin m),
      κ (wcElkP π (U k' * wcElkDelta F (E k') (ι k')) (E k') (H k') (G k') l) = 0 := by
    intro k' l
    obtain ⟨B, hB⟩ : ∃ B, B = U k' * wcElkDelta F (E k') (ι k') := ⟨_, rfl⟩
    rw [← hB]
    have hRelB : ∀ l, B * F l = ∑ j, H k' l j * F (E k' j) + MvPolynomial.C (π ^ 8) * G k' l :=
      fun l => by rw [hB]; exact hRel k' l
    obtain ⟨K, hK⟩ : ∃ K : Ideal (MvPolynomial (Fin n) R), K = Ideal.comap
        (κ.comp (MvPolynomial.rename (Fin.castAdd m) :
          MvPolynomial (Fin n) R →ₐ[R] MvPolynomial (Fin (n + m)) R).toRingHom)
        (Ideal.span {ϖ}) := ⟨_, rfl⟩
    have hmemK : ∀ p, p ∈ K ↔ κ (MvPolynomial.rename (Fin.castAdd m) p) ∈ Ideal.span {ϖ} :=
      fun p => by rw [hK, Ideal.mem_comap]; rfl
    have hFK : ∀ j, F (E k j) ∈ K := fun j => (hmemK _).mpr (by
      rw [hF]; exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _))
    have hC8K : MvPolynomial.C (π ^ 8) ∈ K := (hmemK _).mpr (by
      rw [MvPolynomial.rename_C, hC8]; exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _))
    have hcs := cs (s k) (s k') A B (E k) (H k) (G k) (E k') (H k') (G k') hRel' hRelB l
    have hci : ∀ i, κ (MvPolynomial.rename (Fin.castAdd m)
        (B * H k l i - ∑ j, H k' l j * H k (E k' j) i)) ∈ Ideal.span {ϖ} := by
      intro i
      have hm := minor (s k) (fun j => F (E k j))
        (fun i => B * H k l i - ∑ j, H k' l j * H k (E k' j) i) (ι k) (π ^ 8) _ K hFK hC8K hcs i
      have hm2 : A * (B * H k l i - ∑ j, H k' l j * H k (E k' j) i) ∈ K := by
        rw [hA, mul_assoc]; exact K.mul_mem_left _ hm
      rw [hmemK, map_mul, map_mul] at hm2
      exact hdiv _ hm2
    have hal := alg _ (s k) (s k') (E k) (E k') l (κ (MvPolynomial.rename (Fin.castAdd m) A))
      (κ (MvPolynomial.rename (Fin.castAdd m) B)) ϖ
      (fun x => κ (MvPolynomial.X (Fin.natAdd n x)))
      (fun x i => κ (MvPolynomial.rename (Fin.castAdd m) (H k x i)))
      (fun x => κ (MvPolynomial.rename (Fin.castAdd m) (G k x)))
      (fun x j => κ (MvPolynomial.rename (Fin.castAdd m) (H k' x j)))
      (fun x => κ (MvPolynomial.rename (Fin.castAdd m) (G k' x))) hzrel
    beta_reduce at hal
    have hP'eq : κ (wcElkP π B (E k') (H k') (G k') l) =
        κ (MvPolynomial.rename (Fin.castAdd m) B) * κ (MvPolynomial.X (Fin.natAdd n l)) -
        ∑ j, κ (MvPolynomial.rename (Fin.castAdd m) (H k' l j)) *
          κ (MvPolynomial.X (Fin.natAdd n (E k' j))) -
        ϖ * κ (MvPolynomial.rename (Fin.castAdd m) (G k' l)) := by
      rw [hϖ]; unfold wcElkP; simp only [map_sub, map_mul, map_sum, hC]
    have hP'n : κ (wcElkP π B (E k') (H k') (G k') l) ∈ Ideal.span {ϖ} := by
      apply hdiv
      rw [hP'eq, hal]
      refine Ideal.add_mem _ (Ideal.sum_mem _ fun i _ => Ideal.mul_mem_right _ _ ?_)
        (Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _))
      have := hci i
      simp only [map_sub, map_mul, map_sum] at this
      exact this
    have hk0 := key (s k') B (E k') (H k') (G k') l (hRelB l)
    have hk : ϖ * κ (wcElkP π B (E k') (H k') (G k') l) = 0 := by
      have e1 : κ (MvPolynomial.C (π ^ 4) * wcElkP π B (E k') (H k') (G k') l) =
          ϖ * κ (wcElkP π B (E k') (H k') (G k') l) := by
        rw [map_mul, hC, ← hϖ]
      have e2 : κ (-(MvPolynomial.rename (Fin.castAdd m) B * wcElkEq1 π F l) +
          ∑ j, MvPolynomial.rename (Fin.castAdd m) (H k' l j) * wcElkEq1 π F (E k' j)) = 0 := by
        rw [map_add, map_neg, map_mul, heq1, mul_zero, neg_zero, zero_add, map_sum]
        exact Finset.sum_eq_zero (fun j _ => by rw [map_mul, heq1, mul_zero])
      rw [← e1, hk0, e2]
    obtain ⟨y, hy⟩ := Ideal.mem_span_singleton'.mp hP'n
    rw [← hy] at hk
    have h2 : (π ^ 4) ^ 2 • y = 0 := by
      rw [Algebra.smul_def, map_pow, ← hϖ]
      linear_combination hk
    have h3 := hflat R _ (π ^ 4) hπ4 y h2
    rw [Algebra.smul_def, ← hϖ] at h3
    rw [← hy, mul_comm, h3]

  obtain ⟨I, hI⟩ : ∃ I, I = wcElkIdeal π F s E ι U H G := ⟨_, rfl⟩
  rw [← hI]
  have hIκ : ∀ t ∈ I, κ t = 0 := by
    intro t ht
    rw [← RingHom.mem_ker]
    revert t
    rw [← SetLike.le_def, hI]
    unfold wcElkIdeal
    rw [Ideal.span_le]
    rintro t (⟨l, rfl⟩ | ⟨⟨k', l⟩, rfl⟩)
    · rw [SetLike.mem_coe, RingHom.mem_ker]; exact heq1 l
    · rw [SetLike.mem_coe, RingHom.mem_ker]; exact hother k' l
  have hle : J ≤ I := by
    rw [hJ, Ideal.span_le]
    rintro _ ⟨l, rfl⟩
    rw [heqk, hI]
    split_ifs
    · exact Ideal.subset_span (Or.inl ⟨l, rfl⟩)
    · rw [hA]; exact Ideal.subset_span (Or.inr ⟨(k, l), rfl⟩)

  have hkill : ∀ t ∈ I, ((algebraMap (MvPolynomial (Fin (n + m)) R ⧸ J)
      (Localization.Away (Ideal.Quotient.mk J (MvPolynomial.rename (Fin.castAdd m) A)))).comp
        (Ideal.Quotient.mk J)) t = 0 := fun t ht => by rw [← hκ]; exact hIκ t ht
  have hu : IsUnit (algebraMap (MvPolynomial (Fin (n + m)) R ⧸ J)
      (Localization.Away (Ideal.Quotient.mk J (MvPolynomial.rename (Fin.castAdd m) A)))
      (Ideal.Quotient.mk J (MvPolynomial.rename (Fin.castAdd m) A))) :=
    IsLocalization.Away.algebraMap_isUnit _
  have hg₁ : IsUnit (((algebraMap (MvPolynomial (Fin (n + m)) R ⧸ I)
      (Localization.Away (Ideal.Quotient.mk I (MvPolynomial.rename (Fin.castAdd m) A)))).comp
        (Ideal.Quotient.factor hle)) (Ideal.Quotient.mk J (MvPolynomial.rename (Fin.castAdd m) A))) := by
    rw [RingHom.comp_apply, Ideal.Quotient.factor_mk]
    exact IsLocalization.Away.algebraMap_isUnit _
  have hf₂ : IsUnit ((Ideal.Quotient.lift I ((algebraMap (MvPolynomial (Fin (n + m)) R ⧸ J)
      (Localization.Away (Ideal.Quotient.mk J (MvPolynomial.rename (Fin.castAdd m) A)))).comp
        (Ideal.Quotient.mk J)) hkill) (Ideal.Quotient.mk I (MvPolynomial.rename (Fin.castAdd m) A))) := by
    rw [Ideal.Quotient.lift_mk]
    exact hu
  let α := IsLocalization.Away.lift
    (S := Localization.Away (Ideal.Quotient.mk J (MvPolynomial.rename (Fin.castAdd m) A)))
    (Ideal.Quotient.mk J (MvPolynomial.rename (Fin.castAdd m) A)) hg₁
  let β := IsLocalization.Away.lift
    (S := Localization.Away (Ideal.Quotient.mk I (MvPolynomial.rename (Fin.castAdd m) A)))
    (Ideal.Quotient.mk I (MvPolynomial.rename (Fin.castAdd m) A)) hf₂
  have hα : ∀ t, α (algebraMap _ (Localization.Away (Ideal.Quotient.mk J
      (MvPolynomial.rename (Fin.castAdd m) A))) (Ideal.Quotient.mk J t)) = algebraMap _
        (Localization.Away (Ideal.Quotient.mk I (MvPolynomial.rename (Fin.castAdd m) A)))
        (Ideal.Quotient.mk I t) := by
    intro t
    rw [IsLocalization.Away.lift_eq, RingHom.comp_apply, Ideal.Quotient.factor_mk]
  have hβ : ∀ t, β (algebraMap _ (Localization.Away (Ideal.Quotient.mk I
      (MvPolynomial.rename (Fin.castAdd m) A))) (Ideal.Quotient.mk I t)) = algebraMap _
        (Localization.Away (Ideal.Quotient.mk J (MvPolynomial.rename (Fin.castAdd m) A)))
        (Ideal.Quotient.mk J t) := by
    intro t
    rw [IsLocalization.Away.lift_eq, Ideal.Quotient.lift_mk, RingHom.comp_apply]
  have hβα : β.comp α = RingHom.id _ := by
    apply IsLocalization.ringHom_ext
      (Submonoid.powers (Ideal.Quotient.mk J (MvPolynomial.rename (Fin.castAdd m) A)))
    apply Ideal.Quotient.ringHom_ext
    refine RingHom.ext fun t => ?_
    simp only [RingHom.comp_apply, RingHom.id_apply]
    rw [hα, hβ]
  have hαβ : α.comp β = RingHom.id _ := by
    apply IsLocalization.ringHom_ext
      (Submonoid.powers (Ideal.Quotient.mk I (MvPolynomial.rename (Fin.castAdd m) A)))
    apply Ideal.Quotient.ringHom_ext
    refine RingHom.ext fun t => ?_
    simp only [RingHom.comp_apply, RingHom.id_apply]
    rw [hβ, hα]
  let eqv := RingEquiv.ofRingHom α β hαβ hβα
  have hR : ∀ x : R, eqv (algebraMap R
      (Localization.Away (Ideal.Quotient.mk J (MvPolynomial.rename (Fin.castAdd m) A))) x) =
      algebraMap R (Localization.Away (Ideal.Quotient.mk I
        (MvPolynomial.rename (Fin.castAdd m) A))) x := by
    intro x
    show α _ = _
    rw [IsScalarTower.algebraMap_apply R (MvPolynomial (Fin (n + m)) R ⧸ J)
        (Localization.Away (Ideal.Quotient.mk J (MvPolynomial.rename (Fin.castAdd m) A))),
      IsScalarTower.algebraMap_apply R (MvPolynomial (Fin (n + m)) R ⧸ I)
        (Localization.Away (Ideal.Quotient.mk I (MvPolynomial.rename (Fin.castAdd m) A))),
      ← Ideal.Quotient.mk_algebraMap, ← Ideal.Quotient.mk_algebraMap, hα]
  exact Algebra.Smooth.of_equiv (AlgEquiv.ofRingEquiv (f := eqv) hR)

theorem wc_pfc_elk_D_map : ∀ (R : Type u) [CommRing R] (Λ : Type u) [CommRing Λ] [Algebra R Λ] (π : R), (∀ y : Λ, y * algebraMap R Λ π ^ 2 = 0 → y * algebraMap R Λ π = 0) → ∀ (n m r : ℕ) (F : Fin m → MvPolynomial (Fin n) R) (s : Fin r → ℕ) (E : ∀ k, Fin (s k) → Fin m) (ι : ∀ k, Fin (s k) → Fin n) (U : Fin r → MvPolynomial (Fin n) R) (H : ∀ k, Fin m → Fin (s k) → MvPolynomial (Fin n) R) (G : Fin r → Fin m → MvPolynomial (Fin n) R), (∀ k l, U k * wcElkDelta F (E k) (ι k) * F l = ∑ j, H k l j * F (E k j) + MvPolynomial.C (π ^ 8) * G k l) → ∀ (lam : Fin n → Λ) (μ : Fin m → Λ), (∀ l, MvPolynomial.aeval lam (F l) = algebraMap R Λ (π ^ 8) * μ l) → wcElkIdeal π F s E ι U H G ≤ RingHom.ker (MvPolynomial.aeval (R := R) (Fin.append lam fun l => algebraMap R Λ (π ^ 4) * μ l)) :=
by
  intro R _ Λ _ _ π hAnn n m r F s E ι U H G hRel lam μ hPt
  have hν1 : ∀ q : MvPolynomial (Fin n) R,
      MvPolynomial.aeval (R := R) (Fin.append lam fun l => algebraMap R Λ (π ^ 4) * μ l)
        (MvPolynomial.rename (Fin.castAdd m) q) = MvPolynomial.aeval lam q := by
    intro q
    rw [MvPolynomial.aeval_rename]
    have hc : (Fin.append lam fun l => algebraMap R Λ (π ^ 4) * μ l) ∘ Fin.castAdd m = lam :=
      funext fun i => Fin.append_left _ _ i
    rw [hc]
  have hν2 : ∀ l : Fin m,
      MvPolynomial.aeval (R := R) (Fin.append lam fun l => algebraMap R Λ (π ^ 4) * μ l)
        (MvPolynomial.X (Fin.natAdd n l)) = algebraMap R Λ (π ^ 4) * μ l := by
    intro l
    rw [MvPolynomial.aeval_X, Fin.append_right]
  have hdesc : ∀ t : Λ, t * algebraMap R Λ π ^ 8 = 0 → t * algebraMap R Λ π ^ 4 = 0 := by
    intro t h8
    have h7 : t * algebraMap R Λ π ^ 7 = 0 := by
      have := hAnn (t * algebraMap R Λ π ^ 6) (by rw [← h8]; ring)
      rw [← this]; ring
    have h6 : t * algebraMap R Λ π ^ 6 = 0 := by
      have := hAnn (t * algebraMap R Λ π ^ 5) (by rw [← h7]; ring)
      rw [← this]; ring
    have h5 : t * algebraMap R Λ π ^ 5 = 0 := by
      have := hAnn (t * algebraMap R Λ π ^ 4) (by rw [← h6]; ring)
      rw [← this]; ring
    have := hAnn (t * algebraMap R Λ π ^ 3) (by rw [← h5]; ring)
    rw [← this]; ring
  have hb : algebraMap R Λ (π ^ 8) = algebraMap R Λ π ^ 8 := map_pow _ _ _
  have hc : algebraMap R Λ (π ^ 4) = algebraMap R Λ π ^ 4 := map_pow _ _ _
  unfold wcElkIdeal
  rw [Ideal.span_le, Set.union_subset_iff]
  constructor
  · rintro _ ⟨l, rfl⟩
    rw [SetLike.mem_coe, RingHom.mem_ker]
    show MvPolynomial.aeval (R := R) (Fin.append lam fun l => algebraMap R Λ (π ^ 4) * μ l)
      (wcElkEq1 π F l) = 0
    unfold wcElkEq1
    rw [map_sub, map_mul, hν1, hν2, MvPolynomial.aeval_C, hPt, hb, hc]
    ring
  · rintro _ ⟨⟨k, l⟩, rfl⟩
    rw [SetLike.mem_coe, RingHom.mem_ker]
    show MvPolynomial.aeval (R := R) (Fin.append lam fun l => algebraMap R Λ (π ^ 4) * μ l)
      (wcElkP π (U k * wcElkDelta F (E k) (ι k)) (E k) (H k) (G k) l) = 0
    have hR := congrArg (MvPolynomial.aeval (R := R) lam) (hRel k l)
    generalize U k * wcElkDelta F (E k) (ι k) = A at hR ⊢
    simp only [map_mul, map_add, map_sum, MvPolynomial.aeval_C, hPt] at hR
    unfold wcElkP
    simp only [map_sub, map_mul, map_sum, hν1, hν2, MvPolynomial.aeval_C]
    rw [hb] at hR
    rw [hc]
    have hs8 : (∑ j, MvPolynomial.aeval lam (H k l j) * μ (E k j)) * algebraMap R Λ π ^ 8 =
        ∑ j, MvPolynomial.aeval lam (H k l j) * (algebraMap R Λ π ^ 8 * μ (E k j)) := by
      rw [Finset.sum_mul]
      exact Finset.sum_congr rfl fun j _ => by ring
    have hs4 : (∑ j, MvPolynomial.aeval lam (H k l j) * μ (E k j)) * algebraMap R Λ π ^ 4 =
        ∑ j, MvPolynomial.aeval lam (H k l j) * (algebraMap R Λ π ^ 4 * μ (E k j)) := by
      rw [Finset.sum_mul]
      exact Finset.sum_congr rfl fun j _ => by ring
    have ht := hdesc (MvPolynomial.aeval lam A * μ l -
        ∑ j, MvPolynomial.aeval lam (H k l j) * μ (E k j) - MvPolynomial.aeval lam (G k l))
      (by linear_combination hR - hs8)
    linear_combination ht + hs4

theorem wc_pfc_elkik_lift : (∀ (R : Type u) [CommRing R] (n m : ℕ) (F : Fin m → MvPolynomial (Fin n) R) (ι : Fin m → Fin n), Function.Injective ι → ∀ e : MvPolynomial (Fin n) R ⧸ Ideal.span (Set.range F), IsUnit (algebraMap (MvPolynomial (Fin n) R ⧸ Ideal.span (Set.range F)) (Localization.Away e) (Ideal.Quotient.mk (Ideal.span (Set.range F)) (Matrix.of fun i j : Fin m => MvPolynomial.pderiv (ι i) (F j)).det)) → Algebra.Smooth R (Localization.Away e)) → (∀ (S : Type u) [CommRing S] (n m : ℕ) (f : Fin m → MvPolynomial (Fin n) S) (c : MvPolynomial (Fin n) S), Algebra.Smooth S (Localization.Away (Ideal.Quotient.mk (Ideal.span (Set.range f)) c)) → ∀ (𝔭 : Ideal (MvPolynomial (Fin n) S)), 𝔭.IsPrime → Ideal.span (Set.range f) ≤ 𝔭 → c ∉ 𝔭 → ∃ (s : ℕ) (E : Fin s → Fin m) (ι : Fin s → Fin n) (u : MvPolynomial (Fin n) S) (h : Fin m → Fin s → MvPolynomial (Fin n) S), Function.Injective E ∧ Function.Injective ι ∧ u * (Matrix.of fun i j : Fin s => MvPolynomial.pderiv (ι i) (f (E j))).det ∉ 𝔭 ∧ ∀ l : Fin m, u * (Matrix.of fun i j : Fin s => MvPolynomial.pderiv (ι i) (f (E j))).det * f l = ∑ j, h l j * f (E j)) → (∀ (R : Type u) [CommRing R] (M : Type u) [AddCommGroup M] [Module R M] [Module.Flat R M] (w : R), (∀ y : R, y * w ^ 2 = 0 → y * w = 0) → ∀ x : M, w ^ 2 • x = 0 → w • x = 0) → ∀ (R : Type u) [CommRing R] [IsNoetherianRing R] (Λ : Type u) [CommRing Λ] [Algebra R Λ] (π : R), (∀ y : R, y * π ^ 2 = 0 → y * π = 0) → (∀ y : Λ, y * algebraMap R Λ π ^ 2 = 0 → y * algebraMap R Λ π = 0) → ∀ (C : Type u) [CommRing C] [Algebra (R ⧸ Ideal.span {π ^ 8}) C] [Algebra.FinitePresentation (R ⧸ Ideal.span {π ^ 8}) C] (χbar : C →ₐ[R ⧸ Ideal.span {π ^ 8}] (Λ ⧸ Ideal.map (algebraMap R Λ) (Ideal.span {π ^ 8}))), ∃ (D : Type u) (_ : CommRing D) (_ : Algebra R D) (_ : Algebra.FinitePresentation R D) (χD : D →ₐ[R] Λ) (θ : C →+* (D ⧸ Ideal.map (algebraMap R D) (Ideal.span {π ^ 4}))), (∀ r : R, θ (algebraMap (R ⧸ Ideal.span {π ^ 8}) C (Ideal.Quotient.mk _ r)) = Ideal.Quotient.mk _ (algebraMap R D r)) ∧ (∀ (c : C) (d : D) (l : Λ), Ideal.Quotient.mk _ d = θ c → Ideal.Quotient.mk _ l = χbar c → χD d - l ∈ Ideal.map (algebraMap R Λ) (Ideal.span {π ^ 4})) ∧ Algebra.Smooth R (Localization.Away (algebraMap R D π)) ∧ (∀ c : C, Algebra.Smooth (R ⧸ Ideal.span {π ^ 8}) (Localization.Away c) → ∀ d : D, Ideal.Quotient.mk _ d = θ c → d ∈ (Ideal.span {e : D | Algebra.Smooth R (Localization.Away e)}).radical) :=
by
  intro hjac hchart hflat R _ _ Λ _ _ π hannR hannΛ C _ _ _ χbar
  classical
  obtain ⟨n, m, F, p, r, s, E, ι, U, H, G, hp, hpC, hker, hE, hι, hRel, hConv, hGConv, hcov⟩ :=
    wc_pfc_elk_lifted_cover hchart R π C
  obtain ⟨I, hIdef⟩ : ∃ I : Ideal (MvPolynomial (Fin (n + m)) R),
      I = wcElkIdeal π F s E ι U H G := ⟨_, rfl⟩

  have hfg : I.FG := by
    rw [hIdef]
    exact Submodule.fg_def.mpr ⟨Set.range (wcElkEq1 π F) ∪ Set.range (fun kl : Fin r × Fin m =>
      wcElkP π (U kl.1 * wcElkDelta F (E kl.1) (ι kl.1)) (E kl.1) (H kl.1) (G kl.1) kl.2),
      (Set.finite_range _).union (Set.finite_range _), rfl⟩
  haveI hfpD : Algebra.FinitePresentation R (MvPolynomial (Fin (n + m)) R ⧸ I) :=
    Algebra.FinitePresentation.quotient hfg

  choose lam hlam using fun i : Fin n => Ideal.Quotient.mk_surjective (χbar (p (MvPolynomial.X i)))
  have hmapspan : ∀ k : ℕ, Ideal.map (algebraMap R Λ) (Ideal.span {π ^ k}) =
      Ideal.span {algebraMap R Λ (π ^ k)} := by
    intro k; rw [Ideal.map_span, Set.image_singleton]
  have hstar : ∀ q : MvPolynomial (Fin n) R, χbar (p q) =
      Ideal.Quotient.mk (Ideal.map (algebraMap R Λ) (Ideal.span {π ^ 8}))
        (MvPolynomial.aeval lam q) := by
    intro q
    have e : (χbar.toRingHom.comp p) = (Ideal.Quotient.mk (Ideal.map (algebraMap R Λ)
        (Ideal.span {π ^ 8}))).comp (MvPolynomial.aeval lam).toRingHom := by
      apply MvPolynomial.ringHom_ext
      · intro x
        show χbar (p (MvPolynomial.C x)) =
          Ideal.Quotient.mk _ (MvPolynomial.aeval lam (MvPolynomial.C x))
        rw [hpC, AlgHom.commutes, MvPolynomial.aeval_C,
          Ideal.Quotient.algebraMap_quotient_map_quotient]
      · intro i
        show χbar (p (MvPolynomial.X i)) =
          Ideal.Quotient.mk _ (MvPolynomial.aeval lam (MvPolynomial.X i))
        rw [MvPolynomial.aeval_X, hlam i]
    exact RingHom.congr_fun e q
  have hFker : ∀ l, F l ∈ RingHom.ker p := fun l => by
    rw [hker]; exact Ideal.mem_sup_left (Ideal.subset_span ⟨l, rfl⟩)
  have hμ : ∀ l, ∃ μl : Λ, MvPolynomial.aeval lam (F l) = algebraMap R Λ (π ^ 8) * μl := by
    intro l
    have h1 : Ideal.Quotient.mk (Ideal.map (algebraMap R Λ) (Ideal.span {π ^ 8}))
        (MvPolynomial.aeval lam (F l)) = 0 := by
      rw [← hstar, RingHom.mem_ker.mp (hFker l), map_zero]
    rw [Ideal.Quotient.eq_zero_iff_mem, hmapspan, Ideal.mem_span_singleton'] at h1
    obtain ⟨a, ha⟩ := h1
    exact ⟨a, by rw [← ha, mul_comm]⟩
  choose μ hμ using hμ
  obtain ⟨ψ, hψ⟩ : ∃ ψ : MvPolynomial (Fin (n + m)) R →ₐ[R] Λ,
      ψ = MvPolynomial.aeval (Fin.append lam fun l => algebraMap R Λ (π ^ 4) * μ l) := ⟨_, rfl⟩
  have hIψ : ∀ a ∈ I, ψ a = 0 := by
    intro a ha
    rw [hIdef] at ha
    have h := wc_pfc_elk_D_map R Λ π hannΛ n m r F s E ι U H G hRel lam μ hμ ha
    rw [hψ]; exact RingHom.mem_ker.mp h
  let χD : (MvPolynomial (Fin (n + m)) R ⧸ I) →ₐ[R] Λ := Ideal.Quotient.liftₐ I ψ hIψ
  have hχφ : ∀ q, χD (Ideal.Quotient.mk I (MvPolynomial.rename (Fin.castAdd m) q)) =
      MvPolynomial.aeval lam q := by
    intro q
    have hc : (Fin.append lam fun l => algebraMap R Λ (π ^ 4) * μ l) ∘ Fin.castAdd m = lam :=
      funext fun i => Fin.append_left _ _ i
    change ψ (MvPolynomial.rename (Fin.castAdd m) q) = _
    rw [hψ, MvPolynomial.aeval_rename, hc]

  obtain ⟨φ, hφ⟩ : ∃ φ : MvPolynomial (Fin n) R →+* MvPolynomial (Fin (n + m)) R ⧸ I,
      ∀ q, φ q = Ideal.Quotient.mk I (MvPolynomial.rename (Fin.castAdd m) q) :=
    ⟨(Ideal.Quotient.mk I).comp (MvPolynomial.rename (Fin.castAdd m)).toRingHom, fun q => rfl⟩
  have hKer : ∀ K : Ideal (MvPolynomial (Fin (n + m)) R ⧸ I),
      algebraMap R (MvPolynomial (Fin (n + m)) R ⧸ I) (π ^ 4) ∈ K →
      RingHom.ker p ≤ Ideal.comap φ K := by
    intro K hK
    rw [hker, sup_le_iff, Ideal.span_le, Ideal.span_le]
    constructor
    · rintro _ ⟨l, rfl⟩
      rw [SetLike.mem_coe, Ideal.mem_comap, hφ]
      have e : Ideal.Quotient.mk I (MvPolynomial.rename (Fin.castAdd m) (F l)) =
          algebraMap R (MvPolynomial (Fin (n + m)) R ⧸ I) (π ^ 4) *
            Ideal.Quotient.mk I (MvPolynomial.X (Fin.natAdd n l)) := by
        rw [show algebraMap R (MvPolynomial (Fin (n + m)) R ⧸ I) (π ^ 4) =
          Ideal.Quotient.mk I (MvPolynomial.C (π ^ 4)) from rfl, ← map_mul, Ideal.Quotient.eq]
        rw [hIdef]
        exact Ideal.subset_span (Or.inl ⟨l, rfl⟩)
      rw [e]
      exact K.mul_mem_right _ hK
    · rw [Set.singleton_subset_iff, SetLike.mem_coe, Ideal.mem_comap, hφ, MvPolynomial.rename_C]
      show algebraMap R (MvPolynomial (Fin (n + m)) R ⧸ I) (π ^ 8) ∈ K
      rw [show π ^ 8 = π ^ 4 * π ^ 4 by ring, map_mul]
      exact K.mul_mem_left _ hK
  have hπ4J : algebraMap R (MvPolynomial (Fin (n + m)) R ⧸ I) (π ^ 4) ∈
      Ideal.map (algebraMap R (MvPolynomial (Fin (n + m)) R ⧸ I)) (Ideal.span {π ^ 4}) :=
    Ideal.mem_map_of_mem _ (Ideal.mem_span_singleton_self _)
  let θ' : MvPolynomial (Fin n) R →+* (MvPolynomial (Fin (n + m)) R ⧸ I) ⧸
      Ideal.map (algebraMap R (MvPolynomial (Fin (n + m)) R ⧸ I)) (Ideal.span {π ^ 4}) :=
    (Ideal.Quotient.mk _).comp φ
  have hθ'0 : ∀ q ∈ RingHom.ker p, θ' q = 0 := by
    intro q hq
    exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_comap.mp (hKer _ hπ4J hq))
  let θ : C →+* (MvPolynomial (Fin (n + m)) R ⧸ I) ⧸
      Ideal.map (algebraMap R (MvPolynomial (Fin (n + m)) R ⧸ I)) (Ideal.span {π ^ 4}) :=
    (Ideal.Quotient.lift (RingHom.ker p) θ' hθ'0).comp
      (RingHom.quotientKerEquivOfSurjective hp).symm.toRingHom
  have hθp : ∀ q, θ (p q) = Ideal.Quotient.mk _ (φ q) := by
    intro q
    have e : (RingHom.quotientKerEquivOfSurjective hp).symm (p q) = Ideal.Quotient.mk _ q := by
      rw [RingEquiv.symm_apply_eq, RingHom.quotientKerEquivOfSurjective_apply_mk]
    show Ideal.Quotient.lift (RingHom.ker p) θ' hθ'0
      ((RingHom.quotientKerEquivOfSurjective hp).symm (p q)) = _
    rw [e, Ideal.Quotient.lift_mk]
    rfl
  have hDpi : Algebra.Smooth R (Localization.Away
      (Ideal.Quotient.mk I (MvPolynomial.C π))) := by
    have h := wc_pfc_elk_D_pi_smooth hjac R π n m r F s E ι U H G hRel
    rw [← hIdef] at h
    exact h
  refine ⟨MvPolynomial (Fin (n + m)) R ⧸ I, inferInstance, inferInstance, hfpD, χD, θ,
    ?_, ?_, ?_, ?_⟩
  ·
    intro x
    rw [← hpC, hθp, hφ, MvPolynomial.rename_C]
    rfl
  ·
    intro c d l hd hl
    obtain ⟨q, rfl⟩ := hp c
    rw [hθp, Ideal.Quotient.eq] at hd
    rw [hstar, Ideal.Quotient.eq, hmapspan, Ideal.mem_span_singleton'] at hl
    obtain ⟨a, ha⟩ := hl
    have h1 : χD (d - φ q) ∈ Ideal.map (algebraMap R Λ) (Ideal.span {π ^ 4}) := by
      rw [Ideal.map_span, Set.image_singleton, Ideal.mem_span_singleton'] at hd
      obtain ⟨b, hb⟩ := hd
      rw [← hb, map_mul, AlgHom.commutes, hmapspan]
      exact (Ideal.span _).mul_mem_left _ (Ideal.mem_span_singleton_self _)
    have h2 : l - MvPolynomial.aeval lam q ∈
        Ideal.map (algebraMap R Λ) (Ideal.span {π ^ 4}) := by
      rw [← ha, hmapspan, show π ^ 8 = π ^ 4 * π ^ 4 by ring, map_mul, ← mul_assoc]
      exact (Ideal.span _).mul_mem_left _ (Ideal.mem_span_singleton_self _)
    have h3 : χD d - l = χD (d - φ q) - (l - MvPolynomial.aeval lam q) := by
      rw [map_sub, hφ, hχφ]; ring
    rw [h3]
    exact Ideal.sub_mem _ h1 h2
  ·
    exact hDpi
  ·
    intro c hc d hd
    obtain ⟨q, rfl⟩ := hp c
    obtain ⟨M, Y, hMY⟩ := hcov q hc
    obtain ⟨K, hK⟩ : ∃ K : Ideal (MvPolynomial (Fin (n + m)) R ⧸ I),
        K = Ideal.span {e : MvPolynomial (Fin (n + m)) R ⧸ I |
          Algebra.Smooth R (Localization.Away e)} := ⟨_, rfl⟩
    rw [← hK]
    have hπK : algebraMap R (MvPolynomial (Fin (n + m)) R ⧸ I) π ∈ K := by
      rw [hK]
      apply Ideal.subset_span
      exact hDpi
    have hπ4K : algebraMap R (MvPolynomial (Fin (n + m)) R ⧸ I) (π ^ 4) ∈ K := by
      rw [map_pow]; exact Ideal.pow_mem_of_mem _ hπK 4 (by norm_num)
    have hAK : ∀ k, U k * wcElkDelta F (E k) (ι k) ∈ Ideal.comap φ K := by
      intro k
      rw [Ideal.mem_comap, hφ, hK]
      apply Ideal.subset_span
      show Algebra.Smooth R (Localization.Away (Ideal.Quotient.mk I
        (MvPolynomial.rename (Fin.castAdd m) (U k * wcElkDelta F (E k) (ι k)))))
      have h := wc_pfc_elk_D_chart_smooth hjac hflat R π hannR n m r F s E ι U H G hE hι hRel
        hConv hGConv k
      rw [← hIdef] at h
      exact h
    have hsum : ∑ k, Y k * (U k * wcElkDelta F (E k) (ι k)) ∈ Ideal.comap φ K :=
      Ideal.sum_mem _ (fun k _ => (Ideal.comap φ K).mul_mem_left _ (hAK k))
    have hMY' := hMY
    rw [← hker] at hMY'
    have hdiff := hKer K hπ4K hMY'
    have hqM : q ^ M ∈ Ideal.comap φ K := by
      have := Ideal.add_mem _ hdiff hsum
      rwa [sub_add_cancel] at this
    rw [Ideal.mem_comap, map_pow] at hqM
    rw [hθp, Ideal.Quotient.eq] at hd
    have hdK : d - φ q ∈ K := by
      rw [Ideal.map_span, Set.image_singleton, Ideal.mem_span_singleton'] at hd
      obtain ⟨b, hb⟩ := hd
      rw [← hb]
      exact K.mul_mem_left _ hπ4K
    have h1 : φ q ∈ K.radical := Ideal.mem_radical_iff.mpr ⟨M, hqM⟩
    have h2 : d = (d - φ q) + φ q := by ring
    rw [h2]
    exact Ideal.add_mem _ (Ideal.le_radical hdK) h1

theorem wc_pfc_merge_factorizations : ∀ (R : Type u) [CommRing R] [IsNoetherianRing R] (Λ : Type u) [CommRing Λ] [Algebra R Λ] (π : R), (∀ y : R, y * π ^ 2 = 0 → y * π = 0) → (∀ y : Λ, y * algebraMap R Λ π ^ 2 = 0 → y * algebraMap R Λ π = 0) → ∀ (A : Type u) [CommRing A] [Algebra R A] [Algebra.FinitePresentation R A] (φ : A →ₐ[R] Λ), wcPfcStrictStd R A (algebraMap R A π) → ∀ (D : Type u) [CommRing D] [Algebra R D] [Algebra.FinitePresentation R D] (χD : D →ₐ[R] Λ) (σ : A →+* (D ⧸ Ideal.map (algebraMap R D) (Ideal.span {π ^ 4}))), (∀ r : R, σ (algebraMap R A r) = Ideal.Quotient.mk _ (algebraMap R D r)) → (∀ (a : A) (d : D), Ideal.Quotient.mk _ d = σ a → χD d - φ a ∈ Ideal.map (algebraMap R Λ) (Ideal.span {π ^ 4})) → ∃ (B : Type u) (_ : CommRing B) (_ : Algebra R B) (_ : Algebra.FinitePresentation R B) (ψ : A →ₐ[R] B) (ψD : D →ₐ[R] B) (χ : B →ₐ[R] Λ), χ.comp ψ = φ ∧ χ.comp ψD = χD ∧ ∀ d : D, Algebra.Smooth R (Localization.Away d) → ψD d ∈ (Ideal.span {b : B | Algebra.Smooth R (Localization.Away b)}).radical :=
by
  classical

  have hNorm : ∀ (R : Type u) [CommRing R] (A : Type u) [CommRing A] [Algebra R A] (π : R), wcPfcStrictStd R A (algebraMap R A π) → ∃ (n m c : ℕ) (hcm : c ≤ m) (f : Fin m → MvPolynomial (Fin n) R) (_ : (MvPolynomial (Fin n) R ⧸ Ideal.span (Set.range f)) ≃ₐ[R] A) (a : (Fin c ↪ Fin n) → MvPolynomial (Fin n) R), MvPolynomial.C π - ∑ I, a I * (Matrix.of fun j l : Fin c => MvPolynomial.pderiv (I l) (f (Fin.castLE hcm j))).det ∈ Ideal.span (Set.range f) ∧ ∀ j : Fin m, c ≤ j.val → MvPolynomial.C π * f j ∈ Ideal.span (f '' {i | i.val < c}) + Ideal.span (Set.range f) ^ 2 := by
    intro R _ A _ _ π hss
    obtain ⟨n, m, c, _, hcm, f, e, h1, h2⟩ := hss
    have he : e.symm (algebraMap R A π) =
        Ideal.Quotient.mk (Ideal.span (Set.range f)) (MvPolynomial.C π) := by
      rw [AlgEquiv.commutes, ← MvPolynomial.algebraMap_eq, Ideal.Quotient.mk_algebraMap]
    rw [he, Ideal.map_span, ← Set.range_comp, Ideal.mem_span_range_iff_exists_fun] at h1
    obtain ⟨β, hβ⟩ := h1
    choose a ha using fun I => Ideal.Quotient.mk_surjective (β I)
    refine ⟨n, m, c, hcm, f, e, a, ?_, ?_⟩
    · rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, map_sum, ← hβ]
      simp only [map_mul, ha, Function.comp_apply, sub_self]
    · intro j hj
      obtain ⟨g, hg, hgf⟩ := h2 j hj
      rw [he] at hg
      have hd : MvPolynomial.C π - g ∈ Ideal.span (Set.range f) := Ideal.Quotient.eq.mp hg.symm
      have e1 : MvPolynomial.C π * f j = g * f j + (MvPolynomial.C π - g) * f j := by ring
      rw [e1]
      refine add_mem hgf (Ideal.mem_sup_right ?_)
      rw [pow_two]
      exact Ideal.mul_mem_mul hd (Ideal.subset_span (Set.mem_range_self j))

  have hLift : ∀ (R : Type u) [CommRing R] (A : Type u) [CommRing A] [Algebra R A] (Λ : Type u) [CommRing Λ] [Algebra R Λ] (φ : A →ₐ[R] Λ) (π : R) (D : Type u) [CommRing D] [Algebra R D] (χD : D →ₐ[R] Λ) (σ : A →+* (D ⧸ Ideal.map (algebraMap R D) (Ideal.span {π ^ 4}))), (∀ r : R, σ (algebraMap R A r) = Ideal.Quotient.mk _ (algebraMap R D r)) → (∀ (a : A) (d : D), Ideal.Quotient.mk _ d = σ a → χD d - φ a ∈ Ideal.map (algebraMap R Λ) (Ideal.span {π ^ 4})) → ∀ (n m : ℕ) (f : Fin m → MvPolynomial (Fin n) R) (e : (MvPolynomial (Fin n) R ⧸ Ideal.span (Set.range f)) ≃ₐ[R] A), ∃ d : Fin n → D, (∀ j, MvPolynomial.aeval d (f j) ∈ Ideal.map (algebraMap R D) (Ideal.span {π ^ 4})) ∧ ∀ i, χD (d i) - φ (e (Ideal.Quotient.mk _ (MvPolynomial.X i))) ∈ Ideal.map (algebraMap R Λ) (Ideal.span {π ^ 4}) := by
    intro R _ A _ _ Λ _ _ φ π D _ _ χD σ hσ1 hσ2 n m f e
    choose d hd using fun i => Ideal.Quotient.mk_surjective
      (σ (e (Ideal.Quotient.mk (Ideal.span (Set.range f)) (MvPolynomial.X i))))
    have hagree : (Ideal.Quotient.mk (Ideal.map (algebraMap R D) (Ideal.span {π ^ 4}))).comp
        (MvPolynomial.aeval d : MvPolynomial (Fin n) R →ₐ[R] D).toRingHom =
        σ.comp ((e : (MvPolynomial (Fin n) R ⧸ Ideal.span (Set.range f)) →ₐ[R] A).toRingHom.comp
          (Ideal.Quotient.mk (Ideal.span (Set.range f)))) := by
      apply MvPolynomial.ringHom_ext
      · intro r
        have hC : (e : (MvPolynomial (Fin n) R ⧸ Ideal.span (Set.range f)) →ₐ[R] A)
            (Ideal.Quotient.mk (Ideal.span (Set.range f)) (algebraMap R (MvPolynomial (Fin n) R) r)) =
              algebraMap R A r := by
          rw [Ideal.Quotient.mk_algebraMap]; exact AlgHom.commutes _ r
        simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe, MvPolynomial.aeval_C]
        rw [← MvPolynomial.algebraMap_eq, hC, hσ1, Ideal.Quotient.mk_algebraMap]
      · intro i
        simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe, MvPolynomial.aeval_X]
        exact hd i
    refine ⟨d, fun j => ?_, fun i => hσ2 _ _ (hd i)⟩
    rw [← Ideal.Quotient.eq_zero_iff_mem]
    have h1 := congrArg (fun g => g (f j)) hagree
    simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe] at h1
    rw [h1, (Ideal.Quotient.eq_zero_iff_mem (I := Ideal.span (Set.range f))).mpr
      (Ideal.subset_span (Set.mem_range_self j)), map_zero, map_zero]

  have hSubst : ∀ (R : Type u) [CommRing R] (D : Type u) [CommRing D] [Algebra R D] (π : R) (n m c : ℕ) (hcm : c ≤ m) (f : Fin m → MvPolynomial (Fin n) R) (a : (Fin c ↪ Fin n) → MvPolynomial (Fin n) R) (d : Fin n → D), MvPolynomial.C π - ∑ I, a I * (Matrix.of fun j l : Fin c => MvPolynomial.pderiv (I l) (f (Fin.castLE hcm j))).det ∈ Ideal.span (Set.range f) → (∀ j, MvPolynomial.aeval d (f j) ∈ Ideal.map (algebraMap R D) (Ideal.span {π ^ 4})) → ∃ (S : Fin n → Fin c → D) (r : Fin c → Fin n → D) (H : Fin c → MvPolynomial (Fin (n + c)) D), (∀ j, MvPolynomial.aeval (fun i => MvPolynomial.C (d i) + (MvPolynomial.C (algebraMap R D π) ^ 2 * ∑ k, MvPolynomial.C (S i k) * MvPolynomial.X (Fin.natAdd n k) + MvPolynomial.C (algebraMap R D π) ^ 3 * MvPolynomial.X (Fin.castAdd c i))) (f j) ∈ Ideal.span {MvPolynomial.C (algebraMap R D π) ^ 2}) ∧ ∀ l : Fin c, MvPolynomial.aeval (fun i => MvPolynomial.C (d i) + (MvPolynomial.C (algebraMap R D π) ^ 2 * ∑ k, MvPolynomial.C (S i k) * MvPolynomial.X (Fin.natAdd n k) + MvPolynomial.C (algebraMap R D π) ^ 3 * MvPolynomial.X (Fin.castAdd c i))) (f (Fin.castLE hcm l)) = MvPolynomial.C (algebraMap R D π) ^ 3 * (MvPolynomial.X (Fin.natAdd n l) + ∑ i, MvPolynomial.C (r l i) * MvPolynomial.X (Fin.castAdd c i) + MvPolynomial.C (algebraMap R D π) * H l) := by
    intro R _ D _ _ π n m c hcm f a d hstd1 hd
    have s3 : ∀ (R : Type u) [CommRing R] (B : Type u) [CommRing B] [Algebra R B] (N : ℕ) (p : MvPolynomial (Fin N) R) (a y : Fin N → B) (I : Ideal B), (∀ i, y i ∈ I) → MvPolynomial.aeval (a + y) p - MvPolynomial.aeval a p - ∑ i, MvPolynomial.aeval a (MvPolynomial.pderiv i p) * y i ∈ I ^ 2 := by
      intro R _ B _ _ N p a y I hy
      induction p using MvPolynomial.induction_on with
      | C r => simp
      | add p q hp hq =>
        have e : MvPolynomial.aeval (a + y) (p + q) - MvPolynomial.aeval a (p + q) - ∑ i, MvPolynomial.aeval a (MvPolynomial.pderiv i (p + q)) * y i
            = (MvPolynomial.aeval (a + y) p - MvPolynomial.aeval a p - ∑ i, MvPolynomial.aeval a (MvPolynomial.pderiv i p) * y i)
              + (MvPolynomial.aeval (a + y) q - MvPolynomial.aeval a q - ∑ i, MvPolynomial.aeval a (MvPolynomial.pderiv i q) * y i) := by
          simp only [map_add, add_mul, Finset.sum_add_distrib]; ring
        rw [e]; exact add_mem hp hq
      | mul_X p k hp =>
        set L := ∑ i, MvPolynomial.aeval a (MvPolynomial.pderiv i p) * y i with hL
        set P := MvPolynomial.aeval a p with hP
        set e := MvPolynomial.aeval (a + y) p - P - L with he
        have hLI : L ∈ I := Ideal.sum_mem _ (fun i _ => Ideal.mul_mem_left _ _ (hy i))
        have hs : ∑ i, MvPolynomial.aeval a (MvPolynomial.pderiv i (p * MvPolynomial.X k)) * y i = L * a k + P * y k := by
          have e2 : ∀ i, MvPolynomial.aeval a (MvPolynomial.pderiv i (p * MvPolynomial.X k)) * y i =
              (if i = k then P * y k else 0) + MvPolynomial.aeval a (MvPolynomial.pderiv i p) * y i * a k := by
            intro i
            rw [Derivation.leibniz, MvPolynomial.pderiv_X, smul_eq_mul, smul_eq_mul]
            by_cases h : i = k
            · subst h; simp [hP]; ring
            · simp [Ne.symm h, h]; ring
          simp only [e2, Finset.sum_add_distrib, Finset.sum_ite_eq', Finset.mem_univ, ite_true, ← Finset.sum_mul, hL]
          ring
        have key : MvPolynomial.aeval (a + y) (p * MvPolynomial.X k) - MvPolynomial.aeval a (p * MvPolynomial.X k) - ∑ i, MvPolynomial.aeval a (MvPolynomial.pderiv i (p * MvPolynomial.X k)) * y i
            = L * y k + e * (a k + y k) := by
          rw [hs]
          simp only [map_mul, MvPolynomial.aeval_X, Pi.add_apply, he]
          ring
        rw [key, pow_two]
        exact add_mem (Ideal.mul_mem_mul hLI (hy k)) (Ideal.mul_mem_right _ _ (by rw [← pow_two]; exact hp))
    set p : D := algebraMap R D π with hp
    have hd' : ∀ j, ∃ w : D, w * p ^ 4 = MvPolynomial.aeval d (f j) := by
      intro j
      have h := hd j
      rw [Ideal.map_span, Set.image_singleton, map_pow, Ideal.mem_span_singleton'] at h
      exact h
    choose w hw using hd'
    set Mb : (Fin c ↪ Fin n) → Matrix (Fin c) (Fin c) D := fun I => Matrix.of fun j l =>
      MvPolynomial.aeval d (MvPolynomial.pderiv (I l) (f (Fin.castLE hcm j))) with hMb
    set ad : (Fin c ↪ Fin n) → D := fun I => MvPolynomial.aeval d (a I) with had
    have hz : ∃ z : D, z * p ^ 4 = p - ∑ I, ad I * (Mb I).det := by
      have h1 := Ideal.mem_map_of_mem (MvPolynomial.aeval d : MvPolynomial (Fin n) R →ₐ[R] D) hstd1
      have hle : Ideal.map (MvPolynomial.aeval d : MvPolynomial (Fin n) R →ₐ[R] D) (Ideal.span (Set.range f)) ≤
          Ideal.span {p ^ 4} := by
        rw [Ideal.map_span, Ideal.span_le]
        rintro _ ⟨_, ⟨j, rfl⟩, rfl⟩
        rw [SetLike.mem_coe, Ideal.mem_span_singleton']
        exact ⟨w j, hw j⟩
      have h2 := hle h1
      rw [map_sub, map_sum, MvPolynomial.aeval_C] at h2
      simp only [map_mul, AlgHom.map_det] at h2
      rw [← Ideal.mem_span_singleton']
      exact h2
    obtain ⟨z, hz⟩ := hz
    let S : Fin n → Fin c → D := fun i k =>
      ∑ I, ∑ l', if I l' = i then ad I * (Mb I).adjugate l' k else 0
    let r : Fin c → Fin n → D := fun l i =>
      MvPolynomial.aeval d (MvPolynomial.pderiv i (f (Fin.castLE hcm l)))
    have hrS : ∀ l k, ∑ i, r l i * S i k = if l = k then p - z * p ^ 4 else 0 := by
      intro l k
      have e1 : ∀ i, r l i * S i k = ∑ I, ∑ l', if I l' = i then ad I * (Mb I l l' * (Mb I).adjugate l' k) else 0 := by
        intro i
        simp only [S, Finset.mul_sum, mul_ite, mul_zero]
        refine Finset.sum_congr rfl (fun I _ => Finset.sum_congr rfl (fun l' _ => ?_))
        split_ifs with h
        · subst h; simp only [r, hMb, Matrix.of_apply]; ring
        · rfl
      simp only [e1]
      rw [Finset.sum_comm]
      have e2 : ∀ I : Fin c ↪ Fin n, (∑ i, ∑ l', if I l' = i then ad I * (Mb I l l' * (Mb I).adjugate l' k) else 0) = ad I * ((Mb I).det * if l = k then 1 else 0) := by
        intro I
        rw [Finset.sum_comm]
        simp only [Finset.sum_ite_eq, Finset.mem_univ, ite_true]
        rw [← Finset.mul_sum, ← Matrix.mul_apply, Matrix.mul_adjugate, Matrix.smul_apply, Matrix.one_apply, smul_eq_mul]
      simp only [e2]
      have hz' : ∑ I, ad I * (Mb I).det = p - z * p ^ 4 := by rw [hz]; ring
      split_ifs with h
      · simp only [mul_one]; exact hz'
      · simp
    set Y : Fin n → MvPolynomial (Fin (n + c)) D := fun i =>
      MvPolynomial.C p ^ 2 * ∑ k, MvPolynomial.C (S i k) * MvPolynomial.X (Fin.natAdd n k) +
        MvPolynomial.C p ^ 3 * MvPolynomial.X (Fin.castAdd c i) with hY
    set Iy : Ideal (MvPolynomial (Fin (n + c)) D) := Ideal.span {MvPolynomial.C p ^ 2} with hIy
    have hYI : ∀ i, Y i ∈ Iy := by
      intro i
      refine add_mem (Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _)) ?_
      rw [show MvPolynomial.C p ^ 3 * MvPolynomial.X (Fin.castAdd c i) =
        MvPolynomial.C p ^ 2 * (MvPolynomial.C p * MvPolynomial.X (Fin.castAdd c i)) by ring]
      exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _)
    have hI2 : Iy ^ 2 = Ideal.span {MvPolynomial.C p ^ 4} := by
      rw [hIy, Ideal.span_singleton_pow]; congr 2; ring
    have hCa : ∀ q : MvPolynomial (Fin n) R,
        MvPolynomial.aeval (fun i => (MvPolynomial.C (d i) : MvPolynomial (Fin (n + c)) D)) q =
          MvPolynomial.C (MvPolynomial.aeval d q) := by
      intro q
      have := MvPolynomial.comp_aeval_apply d (IsScalarTower.toAlgHom R D (MvPolynomial (Fin (n + c)) D)) q
      simp only [IsScalarTower.toAlgHom_apply, MvPolynomial.algebraMap_eq] at this
      exact this.symm
    have hZeq : (fun i => MvPolynomial.C (d i) + (MvPolynomial.C p ^ 2 * ∑ k, MvPolynomial.C (S i k) *
        MvPolynomial.X (Fin.natAdd n k) + MvPolynomial.C p ^ 3 * MvPolynomial.X (Fin.castAdd c i))) =
        (fun i => (MvPolynomial.C (d i) : MvPolynomial (Fin (n + c)) D)) + Y := by
      funext i; rfl
    have htay : ∀ j, ∃ u : MvPolynomial (Fin (n + c)) D,
        MvPolynomial.aeval ((fun i => (MvPolynomial.C (d i) : MvPolynomial (Fin (n + c)) D)) + Y) (f j) =
          MvPolynomial.C (MvPolynomial.aeval d (f j)) +
            ∑ i, MvPolynomial.C (MvPolynomial.aeval d (MvPolynomial.pderiv i (f j))) * Y i +
            u * MvPolynomial.C p ^ 4 := by
      intro j
      have h := s3 R (MvPolynomial (Fin (n + c)) D) n (f j) (fun i => MvPolynomial.C (d i)) Y Iy hYI
      rw [hI2, Ideal.mem_span_singleton'] at h
      obtain ⟨u, hu⟩ := h
      refine ⟨u, ?_⟩
      simp only [hCa] at hu
      rw [hu]; ring
    choose u hu using htay
    refine ⟨S, r, fun l => MvPolynomial.C (w (Fin.castLE hcm l)) + u (Fin.castLE hcm l) -
      MvPolynomial.C z * MvPolynomial.C p ^ 2 * MvPolynomial.X (Fin.natAdd n l), ?_, ?_⟩
    · intro j
      rw [hZeq, hu j, ← hw j]
      refine add_mem (add_mem ?_ ?_) ?_
      · rw [map_mul, map_pow, show MvPolynomial.C (w j) * MvPolynomial.C p ^ 4 =
          (MvPolynomial.C (w j) * MvPolynomial.C p ^ 2) * MvPolynomial.C p ^ 2 by ring]
        exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _)
      · exact Ideal.sum_mem _ (fun i _ => Ideal.mul_mem_left _ _ (hYI i))
      · rw [show u j * MvPolynomial.C p ^ 4 = (u j * MvPolynomial.C p ^ 2) * MvPolynomial.C p ^ 2 by ring]
        exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _)
    · intro l
      rw [hZeq, hu (Fin.castLE hcm l), ← hw (Fin.castLE hcm l)]
      have hlin : ∑ i, MvPolynomial.C (MvPolynomial.aeval d (MvPolynomial.pderiv i (f (Fin.castLE hcm l)))) * Y i =
          MvPolynomial.C p ^ 2 * MvPolynomial.C (p - z * p ^ 4) * MvPolynomial.X (Fin.natAdd n l) +
