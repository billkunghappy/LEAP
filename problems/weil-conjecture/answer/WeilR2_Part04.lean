  exact s2 hDESC hTRANS hCFLAT (Localization.AtPrime 𝔮) (Localization.AtPrime 𝔮') h3

theorem wc_hnas_pfc_gring_polynomial : (∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A] (B : Type u) [CommRing B] [IsLocalRing B] [IsNoetherianRing B] [Algebra A B] [IsLocalHom (algebraMap A B)] [Module.Flat A B], IsRegularLocalRing A → IsRegularLocalRing (B ⧸ Ideal.map (algebraMap A B) (IsLocalRing.maximalIdeal A)) → IsRegularLocalRing B) → (∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A] (B : Type u) [CommRing B] [IsLocalRing B] [IsNoetherianRing B] [Algebra A B] [IsLocalHom (algebraMap A B)] [Module.Flat A B], IsRegularLocalRing B → IsRegularLocalRing A) → (∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A], IsRegularLocalRing A → ∀ (𝔭 : Ideal A) [𝔭.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔭)) → (∀ (B : Type u) [CommRing B] [IsLocalRing B] [IsNoetherianRing B] (S : Type u) [CommRing S] [IsLocalRing S] [Algebra B S], Function.Surjective (algebraMap B S) → Nonempty (TensorProduct B S (AdicCompletion (IsLocalRing.maximalIdeal B) B) ≃ₐ[S] AdicCompletion (IsLocalRing.maximalIdeal S) S)) → (∀ (C : Type u) [CommRing C] [IsLocalRing C] [IsNoetherianRing C], IsAdicComplete (IsLocalRing.maximalIdeal C) C → (IsNoetherianRing C ∧ ∀ (𝔪 : Ideal C) [𝔪.IsPrime], ∀ (Λ : Type u) [CommRing Λ] [Algebra (Localization.AtPrime 𝔪) Λ], Nonempty (AdicCompletion (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔪)) (Localization.AtPrime 𝔪) ≃ₐ[Localization.AtPrime 𝔪] Λ) → ∀ (𝔭 : Ideal (Localization.AtPrime 𝔪)) [𝔭.IsPrime] (L : Type u) [Field L] [Algebra (Localization.AtPrime 𝔪) L] [Algebra 𝔭.ResidueField L] [IsScalarTower (Localization.AtPrime 𝔪) 𝔭.ResidueField L] [FiniteDimensional 𝔭.ResidueField L] (𝔔 : Ideal (TensorProduct (Localization.AtPrime 𝔪) L Λ)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔))) → (∀ (C : Type u) [CommRing C] [IsLocalRing C] [IsNoetherianRing C], IsAdicComplete (IsLocalRing.maximalIdeal C) C → ∀ (𝔮 : Ideal (Polynomial C)) [𝔮.IsMaximal], 𝔮.comap Polynomial.C = IsLocalRing.maximalIdeal C → ∀ (Λ : Type u) [CommRing Λ] [Algebra (Localization.AtPrime 𝔮) Λ], Nonempty (AdicCompletion (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮)) (Localization.AtPrime 𝔮) ≃ₐ[Localization.AtPrime 𝔮] Λ) → ∀ (𝔭 : Ideal (Localization.AtPrime 𝔮)) [𝔭.IsPrime] (L : Type u) [Field L] [Algebra (Localization.AtPrime 𝔮) L] [Algebra 𝔭.ResidueField L] [IsScalarTower (Localization.AtPrime 𝔮) 𝔭.ResidueField L] [FiniteDimensional 𝔭.ResidueField L] (𝔔 : Ideal (TensorProduct (Localization.AtPrime 𝔮) L Λ)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) → ∀ (B : Type u) [CommRing B], (IsNoetherianRing B ∧ ∀ (𝔪 : Ideal B) [𝔪.IsPrime], ∀ (Λ : Type u) [CommRing Λ] [Algebra (Localization.AtPrime 𝔪) Λ], Nonempty (AdicCompletion (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔪)) (Localization.AtPrime 𝔪) ≃ₐ[Localization.AtPrime 𝔪] Λ) → ∀ (𝔭 : Ideal (Localization.AtPrime 𝔪)) [𝔭.IsPrime] (L : Type u) [Field L] [Algebra (Localization.AtPrime 𝔪) L] [Algebra 𝔭.ResidueField L] [IsScalarTower (Localization.AtPrime 𝔪) 𝔭.ResidueField L] [FiniteDimensional 𝔭.ResidueField L] (𝔔 : Ideal (TensorProduct (Localization.AtPrime 𝔪) L Λ)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) → (IsNoetherianRing (Polynomial B) ∧ ∀ (𝔪 : Ideal (Polynomial B)) [𝔪.IsPrime], ∀ (Λ : Type u) [CommRing Λ] [Algebra (Localization.AtPrime 𝔪) Λ], Nonempty (AdicCompletion (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔪)) (Localization.AtPrime 𝔪) ≃ₐ[Localization.AtPrime 𝔪] Λ) → ∀ (𝔭 : Ideal (Localization.AtPrime 𝔪)) [𝔭.IsPrime] (L : Type u) [Field L] [Algebra (Localization.AtPrime 𝔪) L] [Algebra 𝔭.ResidueField L] [IsScalarTower (Localization.AtPrime 𝔪) 𝔭.ResidueField L] [FiniteDimensional 𝔭.ResidueField L] (𝔔 : Ideal (TensorProduct (Localization.AtPrime 𝔪) L Λ)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) :=
by
  intro r1 r2 r3 _hS hCL hPC B _ hG

  have hTRANS : ∀ (A : Type u) [CommRing A] (C : Type u) [CommRing C] (C' : Type u) [CommRing C'] [Algebra A C] [Algebra A C'], (C ≃ₐ[A] C') → (∀ (𝔭 : Ideal A) [𝔭.IsPrime] (L : Type u) [Field L] [Algebra A L] [Algebra 𝔭.ResidueField L] [IsScalarTower A 𝔭.ResidueField L] [FiniteDimensional 𝔭.ResidueField L] (𝔔 : Ideal (TensorProduct A L C)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) → ∀ (𝔭 : Ideal A) [𝔭.IsPrime] (L : Type u) [Field L] [Algebra A L] [Algebra 𝔭.ResidueField L] [IsScalarTower A 𝔭.ResidueField L] [FiniteDimensional 𝔭.ResidueField L] (𝔔 : Ideal (TensorProduct A L C')) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔) := by
    intro A _ C _ C' _ _ _ e hC 𝔭 _ L _ _ _ _ _ 𝔔 _
    let Ψ : TensorProduct A L C ≃+* TensorProduct A L C' :=
      (Algebra.TensorProduct.congr (AlgEquiv.refl : L ≃ₐ[A] L) e).toRingEquiv
    have : (𝔔.comap (Ψ : TensorProduct A L C →+* TensorProduct A L C')).IsPrime :=
      Ideal.comap_isPrime _ _
    have h := hC 𝔭 L (𝔔.comap (Ψ : TensorProduct A L C →+* TensorProduct A L C'))
    have H : (𝔔.comap (Ψ : TensorProduct A L C →+* TensorProduct A L C')).primeCompl.map
        Ψ.toMonoidHom = 𝔔.primeCompl := by
      ext x
      constructor
      · rintro ⟨y, hy, rfl⟩
        exact hy
      · intro hx
        refine ⟨Ψ.symm x, ?_, ?_⟩
        · change Ψ (Ψ.symm x) ∉ 𝔔
          simpa using hx
        · simp
    exact IsRegularLocalRing.of_ringEquiv (IsLocalization.ringEquivOfRingEquiv
      (Localization.AtPrime (𝔔.comap (Ψ : TensorProduct A L C →+* TensorProduct A L C')))
      (Localization.AtPrime 𝔔) Ψ H)

  have hMAXLIFT : ∀ (B : Type u) [CommRing B] (𝔮 : Ideal (Polynomial B)) [𝔮.IsMaximal] (Ω : Type u) [CommRing Ω] [IsLocalRing Ω] [Algebra (Localization.AtPrime (𝔮.comap Polynomial.C)) Ω], IsLocalHom (algebraMap (Localization.AtPrime (𝔮.comap Polynomial.C)) Ω) → (∀ w : Ω, ∃ a : Localization.AtPrime (𝔮.comap Polynomial.C), w - algebraMap (Localization.AtPrime (𝔮.comap Polynomial.C)) Ω a ∈ IsLocalRing.maximalIdeal Ω) → ∃ 𝔮' : Ideal (Polynomial Ω), 𝔮'.IsMaximal ∧ 𝔮'.comap Polynomial.C = IsLocalRing.maximalIdeal Ω ∧ 𝔮 = 𝔮'.comap (Polynomial.mapRingHom ((algebraMap (Localization.AtPrime (𝔮.comap Polynomial.C)) Ω).comp (algebraMap B (Localization.AtPrime (𝔮.comap Polynomial.C))))) := by
    intro B _ 𝔮 _ Ω _ _ _ hloc hres
    set p := 𝔮.comap (Polynomial.C : B →+* Polynomial B) with hp
    let K := Polynomial B ⧸ 𝔮
    letI : Field K := Ideal.Quotient.field 𝔮
    haveI hKnt : Nontrivial K := DivisionRing.toNontrivial
    haveI hRnt : Nontrivial (IsLocalRing.ResidueField Ω) := DivisionRing.toNontrivial
    let π : Polynomial B →+* K := Ideal.Quotient.mk 𝔮
    let g : B →+* K := π.comp Polynomial.C
    have hg0 : ∀ b, g b = 0 ↔ b ∈ p := by
      intro b
      change Ideal.Quotient.mk 𝔮 (Polynomial.C b) = 0 ↔ _
      rw [Ideal.Quotient.eq_zero_iff_mem]
      rfl
    have hgu : ∀ y : p.primeCompl, IsUnit (g y) := by
      intro y
      refine isUnit_iff_ne_zero.mpr ?_
      intro h
      exact y.2 ((hg0 y).mp h)
    let gP : Localization.AtPrime p →+* K := IsLocalization.lift (M := p.primeCompl) hgu
    have hgP : ∀ b, gP (algebraMap B _ b) = g b := fun b => IsLocalization.lift_eq hgu b
    have hker : ∀ x ∈ IsLocalRing.maximalIdeal (Localization.AtPrime p), gP x = 0 := by
      intro x hx
      obtain ⟨⟨a, s⟩, rfl⟩ := IsLocalization.mk'_surjective p.primeCompl x
      have ha : a ∈ p :=
        (IsLocalization.AtPrime.mk'_mem_maximal_iff (Localization.AtPrime p) p a s).mp hx
      have e := IsLocalization.mk'_spec (Localization.AtPrime p) a s
      have e2 := congrArg gP e
      rw [map_mul, hgP, hgP, (hg0 a).mpr ha] at e2
      exact (mul_eq_zero.mp e2).resolve_right (hgu s).ne_zero
    let gK : IsLocalRing.ResidueField (Localization.AtPrime p) →+* K :=
      Ideal.Quotient.lift (IsLocalRing.maximalIdeal (Localization.AtPrime p)) gP hker
    have hgK : ∀ a, gK (IsLocalRing.residue _ a) = gP a := fun a => Ideal.Quotient.lift_mk _ _ _
    let r := IsLocalRing.ResidueField.map (algebraMap (Localization.AtPrime p) Ω)
    have hr : Function.Bijective r := by
      refine ⟨r.injective, ?_⟩
      intro z
      obtain ⟨w, rfl⟩ := IsLocalRing.residue_surjective z
      obtain ⟨a, ha⟩ := hres w
      refine ⟨IsLocalRing.residue _ a, ?_⟩
      rw [IsLocalRing.ResidueField.map_residue]
      symm
      rw [← sub_eq_zero, ← map_sub, IsLocalRing.residue_eq_zero_iff]
      exact ha
    let e := RingEquiv.ofBijective r hr
    let ω : Ω →+* K :=
      (gK.comp (e.symm : IsLocalRing.ResidueField Ω →+* _)).comp (IsLocalRing.residue Ω)
    have hω : ∀ a, ω (algebraMap (Localization.AtPrime p) Ω a) = gP a := by
      intro a
      change gK (e.symm (IsLocalRing.residue Ω (algebraMap _ Ω a))) = gP a
      have : IsLocalRing.residue Ω (algebraMap _ Ω a) = e (IsLocalRing.residue _ a) := by
        change _ = r (IsLocalRing.residue _ a)
        rw [IsLocalRing.ResidueField.map_residue]
      rw [this, RingEquiv.symm_apply_apply, hgK]
    have hω0 : ∀ w, ω w = 0 ↔ w ∈ IsLocalRing.maximalIdeal Ω := by
      intro w
      change gK (e.symm (IsLocalRing.residue Ω w)) = 0 ↔ _
      rw [map_eq_zero_iff gK gK.injective, map_eq_zero_iff _ e.symm.injective,
        IsLocalRing.residue_eq_zero_iff]
    let Φ : Polynomial Ω →+* K := Polynomial.eval₂RingHom ω (π Polynomial.X)
    let φ := (algebraMap (Localization.AtPrime p) Ω).comp (algebraMap B (Localization.AtPrime p))
    have hΦφ : Φ.comp (Polynomial.mapRingHom φ) = π := by
      apply Polynomial.ringHom_ext
      · intro b
        simp only [RingHom.comp_apply, Polynomial.coe_mapRingHom, Polynomial.map_C, Φ,
          Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C, φ]
        rw [hω, hgP]
        rfl
      · simp [Φ]
    have hΦs : Function.Surjective Φ := by
      intro k
      obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective k
      exact ⟨Polynomial.map φ f, by
        change (Φ.comp (Polynomial.mapRingHom φ)) f = π f
        rw [hΦφ]⟩
    refine ⟨RingHom.ker Φ, RingHom.ker_isMaximal_of_surjective Φ hΦs, ?_, ?_⟩
    · ext w
      rw [Ideal.mem_comap, RingHom.mem_ker, ← hω0 w]
      simp [Φ]
    · rw [RingHom.comap_ker, hΦφ]
      exact (Ideal.mk_ker).symm

  haveI : IsNoetherianRing B := hG.1
  exact wc_hnas_pfc_gring_of_maximal (wc_hnas_pfc_grf_descent r2) (wc_hnas_pfc_grf_comp r1)
    hTRANS wc_hnas_pfc_grf_localize wc_hnas_pfc_completion_flat_local hCL (Polynomial B)
    (wc_hnas_pfc_poly_maximal_fibres hPC (wc_hnas_pfc_grf_descent r2) (wc_hnas_pfc_grf_comp r1)
      hTRANS wc_hnas_pfc_completion_flat_local wc_hnas_pfc_poly_base_change_fibres hMAXLIFT B
      (fun 𝔫 _ => by
        haveI : IsNoetherianRing (Localization.AtPrime 𝔫) :=
          IsLocalization.isNoetherianRing 𝔫.primeCompl _ hG.1
        exact wc_hnas_pfc_fibre_fg_upgrade r1 r2 r3 (Localization.AtPrime 𝔫) (hG.2 𝔫)))

theorem wc_hnas_pfc_formal_fibres_regular : ∀ (R : Type u) [CommRing R] [Algebra.FiniteType ℤ R] (𝔮 : Ideal R) [𝔮.IsPrime] (Λ : Type u) [CommRing Λ] [Algebra (Localization.AtPrime 𝔮) Λ], Nonempty (AdicCompletion (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮)) (Localization.AtPrime 𝔮) ≃ₐ[Localization.AtPrime 𝔮] Λ) → ∀ (𝔭 : Ideal (Localization.AtPrime 𝔮)) [𝔭.IsPrime] (L : Type u) [Field L] [Algebra (Localization.AtPrime 𝔮) L] [Algebra 𝔭.ResidueField L] [IsScalarTower (Localization.AtPrime 𝔮) 𝔭.ResidueField L] [FiniteDimensional 𝔭.ResidueField L] (𝔔 : Ideal (TensorProduct (Localization.AtPrime 𝔮) L Λ)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔) :=
by
  intro R _ hR 𝔮 _

  obtain ⟨n, g, hg⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp hR

  have ε : ULift.{u, 0} ℤ ≃+* ℤ := ULift.ringEquiv
  obtain ⟨ψ, hψ⟩ : ∃ ψ : MvPolynomial (Fin n) (ULift.{u, 0} ℤ) →+* R, Function.Surjective ψ := by
    refine ⟨g.toRingHom.comp (MvPolynomial.map ε.toRingHom), ?_⟩
    intro r
    obtain ⟨p, rfl⟩ := hg r
    obtain ⟨q, rfl⟩ := MvPolynomial.map_surjective (ε.toRingHom) ε.surjective p
    exact ⟨q, rfl⟩

  have hSurj : ∀ (B : Type u) [CommRing B] (S : Type u) [CommRing S] (f : B →+* S),
      Function.Surjective f → wcGRing B → wcGRing S :=
    wc_hnas_pfc_gring_of_surjective wc_hnas_pfc_completion_surj_base_change
  have hPoly : ∀ (B : Type u) [CommRing B], wcGRing B → wcGRing (Polynomial B) :=
    wc_hnas_pfc_gring_polynomial wc_hnas_pfc_regular_flat_ascent
      wc_hnas_pfc_regular_flat_descent wc_hnas_pfc_regular_localization
      wc_hnas_pfc_completion_surj_base_change
      (wc_hnas_pfc_gring_complete_local wc_hnas_pfc_regular_flat_ascent
        wc_hnas_pfc_regular_flat_descent wc_hnas_pfc_regular_localization
        wc_hnas_pfc_completion_surj_base_change)
      (wc_hnas_pfc_poly_complete_fibres wc_hnas_pfc_regular_flat_ascent
        wc_hnas_pfc_regular_flat_descent wc_hnas_pfc_regular_localization
        wc_hnas_pfc_completion_surj_base_change)

  have hGA : wcGRing (ULift.{u, 0} ℤ) :=
    wc_hnas_pfc_gring_int wc_hnas_pfc_fibres_of_field wc_hnas_pfc_fibres_dvr_char_zero
      (ULift.{u, 0} ℤ) ⟨ε⟩

  have claim : ∀ k : ℕ, wcGRing (MvPolynomial (Fin k) (ULift.{u, 0} ℤ)) := by
    intro k
    induction k with
    | zero =>
      exact hSurj (ULift.{u, 0} ℤ) _
        (MvPolynomial.isEmptyRingEquiv (ULift.{u, 0} ℤ) (Fin 0)).symm.toRingHom
        (MvPolynomial.isEmptyRingEquiv (ULift.{u, 0} ℤ) (Fin 0)).symm.surjective hGA
    | succ k ih =>
      exact hSurj _ _ (MvPolynomial.finSuccEquiv (ULift.{u, 0} ℤ) k).symm.toRingEquiv.toRingHom
        (MvPolynomial.finSuccEquiv (ULift.{u, 0} ℤ) k).symm.surjective (hPoly _ ih)

  have hGR : wcGRing R := hSurj _ R ψ hψ (claim n)
  exact hGR.2 𝔮

theorem wc_pfc_quotient_hyps : ∀ (A : Type u) [CommRing A] [IsNoetherianRing A] (Λ : Type u) [CommRing Λ] [IsNoetherianRing Λ] [Algebra A Λ], Module.Flat A Λ → (∀ (𝔭 : Ideal A) [𝔭.IsPrime] (L : Type u) [Field L] [Algebra A L] [Algebra 𝔭.ResidueField L] [IsScalarTower A 𝔭.ResidueField L] [FiniteDimensional 𝔭.ResidueField L] (𝔔 : Ideal (TensorProduct A L Λ)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) → ∀ (I : Ideal A), Module.Flat (A ⧸ I) (Λ ⧸ I.map (algebraMap A Λ)) ∧ (∀ (𝔭 : Ideal (A ⧸ I)) [𝔭.IsPrime] (L : Type u) [Field L] [Algebra (A ⧸ I) L] [Algebra 𝔭.ResidueField L] [IsScalarTower (A ⧸ I) 𝔭.ResidueField L] [FiniteDimensional 𝔭.ResidueField L] (𝔔 : Ideal (TensorProduct (A ⧸ I) L (Λ ⧸ I.map (algebraMap A Λ)))) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) :=
by
  intro A _ _ Λ _ _ _ hF hR I
  let e : TensorProduct A (A ⧸ I) Λ ≃ₐ[A ⧸ I] Λ ⧸ I.map (algebraMap A Λ) :=
    (AlgEquiv.extendScalarsOfSurjective (R := A) (S := A ⧸ I) Ideal.Quotient.mk_surjective
      (((Algebra.TensorProduct.quotIdealMapEquivTensorQuot Λ I).restrictScalars A).trans
        (Algebra.TensorProduct.comm A Λ (A ⧸ I)))).symm
  refine ⟨?_, ?_⟩
  · haveI : Module.Flat A Λ := hF
    haveI := Module.Flat.baseChange A (A ⧸ I) Λ
    exact Module.Flat.of_linearEquiv e.symm.toLinearEquiv
  · intro 𝔭 _ L _ _ _ _ _ 𝔔 _
    let 𝔭' : Ideal A := 𝔭.comap (Ideal.Quotient.mk I)
    let φ : 𝔭'.ResidueField →+* 𝔭.ResidueField :=
      Ideal.ResidueField.map 𝔭' 𝔭 (Ideal.Quotient.mk I) rfl
    have hφ : Function.Surjective φ :=
      (RingHom.SurjectiveOnStalks.residueFieldMap_bijective
        (RingHom.surjectiveOnStalks_of_surjective Ideal.Quotient.mk_surjective) 𝔭' 𝔭 rfl).2
    letI iAL : Algebra A L := ((algebraMap (A ⧸ I) L).comp (Ideal.Quotient.mk I)).toAlgebra
    letI iKL : Algebra 𝔭'.ResidueField L := ((algebraMap 𝔭.ResidueField L).comp φ).toAlgebra
    haveI t1 : IsScalarTower A (A ⧸ I) L := IsScalarTower.of_algebraMap_eq' rfl
    haveI t2 : IsScalarTower A 𝔭'.ResidueField L := by
      refine IsScalarTower.of_algebraMap_eq (fun a => ?_)
      symm
      change algebraMap 𝔭.ResidueField L (φ (algebraMap A 𝔭'.ResidueField a)) =
        algebraMap (A ⧸ I) L (Ideal.Quotient.mk I a)
      rw [Ideal.ResidueField.map_algebraMap, ← IsScalarTower.algebraMap_apply]
    haveI t3 : FiniteDimensional 𝔭'.ResidueField L := by
      letI : Algebra 𝔭'.ResidueField 𝔭.ResidueField := φ.toAlgebra
      haveI : IsScalarTower 𝔭'.ResidueField 𝔭.ResidueField L := IsScalarTower.of_algebraMap_eq' rfl
      haveI : Module.Finite 𝔭'.ResidueField 𝔭.ResidueField := RingHom.Finite.of_surjective φ hφ
      exact Module.Finite.trans 𝔭.ResidueField L
    let Ψ : TensorProduct A L Λ ≃+* TensorProduct (A ⧸ I) L (Λ ⧸ I.map (algebraMap A Λ)) :=
      ((Algebra.TensorProduct.cancelBaseChange A (A ⧸ I) (A ⧸ I) L Λ).symm.trans
        (Algebra.TensorProduct.congr (AlgEquiv.refl : L ≃ₐ[A ⧸ I] L) e)).toRingEquiv
    have hreg := hR 𝔭' L (𝔔.comap Ψ)
    have H : Submonoid.map Ψ.toMonoidHom (𝔔.comap Ψ).primeCompl = 𝔔.primeCompl := by
      ext y
      constructor
      · rintro ⟨x, hx, rfl⟩
        exact hx
      · intro hy
        refine ⟨Ψ.symm y, ?_, ?_⟩
        · show Ψ (Ψ.symm y) ∉ 𝔔
          rw [RingEquiv.apply_symm_apply]
          exact hy
        · show Ψ (Ψ.symm y) = y
          exact RingEquiv.apply_symm_apply Ψ y
    haveI := hreg
    exact IsRegularLocalRing.of_ringEquiv
      (IsLocalization.ringEquivOfRingEquiv (Localization.AtPrime (𝔔.comap Ψ))
        (Localization.AtPrime 𝔔) Ψ H)

theorem wc_pfc_pt_quotient_quotient : ∀ (A : Type u) [CommRing A] (Λ : Type u) [CommRing Λ] [Algebra A Λ] (I : Ideal A) (J : Ideal (A ⧸ I)), (∀ (n : ℕ) (s : Finset (MvPolynomial (Fin n) (A ⧸ J.comap (Ideal.Quotient.mk I)))) (b : Fin n → Λ ⧸ (J.comap (Ideal.Quotient.mk I)).map (algebraMap A Λ)), (∀ f ∈ s, MvPolynomial.aeval b f = 0) → ∃ (D : Type u) (_ : CommRing D) (_ : Algebra (A ⧸ J.comap (Ideal.Quotient.mk I)) D) (_ : Algebra.Smooth (A ⧸ J.comap (Ideal.Quotient.mk I)) D) (c : Fin n → D) (γ : D →ₐ[A ⧸ J.comap (Ideal.Quotient.mk I)] Λ ⧸ (J.comap (Ideal.Quotient.mk I)).map (algebraMap A Λ)), (∀ f ∈ s, MvPolynomial.aeval c f = 0) ∧ ∀ i, γ (c i) = b i) → ∀ (n : ℕ) (s : Finset (MvPolynomial (Fin n) ((A ⧸ I) ⧸ J))) (b : Fin n → (Λ ⧸ I.map (algebraMap A Λ)) ⧸ J.map (algebraMap (A ⧸ I) (Λ ⧸ I.map (algebraMap A Λ)))), (∀ f ∈ s, MvPolynomial.aeval b f = 0) → ∃ (D : Type u) (_ : CommRing D) (_ : Algebra ((A ⧸ I) ⧸ J) D) (_ : Algebra.Smooth ((A ⧸ I) ⧸ J) D) (c : Fin n → D) (γ : D →ₐ[(A ⧸ I) ⧸ J] (Λ ⧸ I.map (algebraMap A Λ)) ⧸ J.map (algebraMap (A ⧸ I) (Λ ⧸ I.map (algebraMap A Λ)))), (∀ f ∈ s, MvPolynomial.aeval c f = 0) ∧ ∀ i, γ (c i) = b i :=
by
  classical
  have transport : ∀ (R₁ : Type u) [CommRing R₁] (S₁ : Type u) [CommRing S₁] [Algebra R₁ S₁]
      (R₂ : Type u) [CommRing R₂] (S₂ : Type u) [CommRing S₂] [Algebra R₂ S₂]
      (eR : R₁ ≃+* R₂) (eS : S₁ ≃+* S₂),
      (∀ x : R₁, eS (algebraMap R₁ S₁ x) = algebraMap R₂ S₂ (eR x)) →
      (∀ (n : ℕ) (s : Finset (MvPolynomial (Fin n) R₁)) (b : Fin n → S₁),
        (∀ f ∈ s, MvPolynomial.aeval b f = 0) → ∃ (D : Type u) (_ : CommRing D) (_ : Algebra R₁ D)
          (_ : Algebra.Smooth R₁ D) (c : Fin n → D) (γ : D →ₐ[R₁] S₁),
          (∀ f ∈ s, MvPolynomial.aeval c f = 0) ∧ ∀ i, γ (c i) = b i) →
      ∀ (n : ℕ) (s : Finset (MvPolynomial (Fin n) R₂)) (b : Fin n → S₂),
        (∀ f ∈ s, MvPolynomial.aeval b f = 0) → ∃ (D : Type u) (_ : CommRing D) (_ : Algebra R₂ D)
          (_ : Algebra.Smooth R₂ D) (c : Fin n → D) (γ : D →ₐ[R₂] S₂),
          (∀ f ∈ s, MvPolynomial.aeval c f = 0) ∧ ∀ i, γ (c i) = b i := by
    intro R₁ _ S₁ _ _ R₂ _ S₂ _ _ eR eS hc H n s b hb
    have hcomp : (eS : S₁ →+* S₂).comp ((algebraMap R₁ S₁).comp (eR.symm : R₂ →+* R₁))
        = algebraMap R₂ S₂ := by
      ext r
      simp only [RingHom.coe_comp, RingHom.coe_coe, Function.comp_apply, hc,
        RingEquiv.apply_symm_apply]
    obtain ⟨D, _, _, _, c, γ, hcs, hγ⟩ := H n (s.image (MvPolynomial.map (eR.symm : R₂ →+* R₁)))
      (fun i => eS.symm (b i)) (by
        intro g hg
        obtain ⟨p, hp, rfl⟩ := Finset.mem_image.mp hg
        apply eS.injective
        rw [map_zero, MvPolynomial.aeval_def, MvPolynomial.eval₂_map]
        have e1 : eS (MvPolynomial.eval₂ ((algebraMap R₁ S₁).comp (eR.symm : R₂ →+* R₁))
            (fun i => eS.symm (b i)) p) = MvPolynomial.eval₂ ((eS : S₁ →+* S₂).comp
            ((algebraMap R₁ S₁).comp (eR.symm : R₂ →+* R₁))) (fun i => eS (eS.symm (b i))) p :=
          MvPolynomial.eval₂_comp_left (eS : S₁ →+* S₂) _ _ p
        rw [e1, hcomp]
        simp only [RingEquiv.apply_symm_apply]
        have h0 := hb p hp
        rw [MvPolynomial.aeval_def] at h0
        exact h0)
    letI iRR : Algebra R₂ R₁ := (eR.symm : R₂ →+* R₁).toAlgebra
    letI iRD : Algebra R₂ D := ((algebraMap R₁ D).comp (eR.symm : R₂ →+* R₁)).toAlgebra
    haveI : IsScalarTower R₂ R₁ D := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    let e₀ : R₂ ≃ₐ[R₂] R₁ := AlgEquiv.ofRingEquiv (f := eR.symm) (fun x => rfl)
    haveI : Algebra.Smooth R₂ R₁ := Algebra.Smooth.of_equiv e₀
    haveI : Algebra.Smooth R₂ D := Algebra.Smooth.comp R₂ R₁ D
    let γ' : D →ₐ[R₂] S₂ :=
      { toRingHom := (eS : S₁ →+* S₂).comp (γ : D →+* S₁)
        commutes' := fun r => by
          show eS (γ (algebraMap R₁ D (eR.symm r))) = algebraMap R₂ S₂ r
          rw [AlgHom.commutes, hc, RingEquiv.apply_symm_apply] }
    refine ⟨D, inferInstance, iRD, inferInstance, c, γ', ?_, ?_⟩
    · intro p hp
      have h := hcs _ (Finset.mem_image_of_mem _ hp)
      rw [MvPolynomial.aeval_def, MvPolynomial.eval₂_map] at h
      rw [MvPolynomial.aeval_def]
      exact h
    · intro i
      show eS (γ (c i)) = b i
      rw [hγ, RingEquiv.apply_symm_apply]
  intro A _ Λ _ _ I J H

  have hφ : Function.Surjective ((Ideal.Quotient.mk J).comp (Ideal.Quotient.mk I)) :=
    Ideal.Quotient.mk_surjective.comp Ideal.Quotient.mk_surjective
  have hK : J.comap (Ideal.Quotient.mk I) =
      RingHom.ker ((Ideal.Quotient.mk J).comp (Ideal.Quotient.mk I)) := by
    rw [← RingHom.comap_ker, Ideal.mk_ker]
  let eR : (A ⧸ J.comap (Ideal.Quotient.mk I)) ≃+* ((A ⧸ I) ⧸ J) :=
    (Ideal.quotEquivOfEq hK).trans (RingHom.quotientKerEquivOfSurjective hφ)
  have heR : ∀ a : A, eR (Ideal.Quotient.mk _ a) = Ideal.Quotient.mk J (Ideal.Quotient.mk I a) :=
    fun a => rfl

  have hq : (algebraMap (A ⧸ I) (Λ ⧸ I.map (algebraMap A Λ))).comp (Ideal.Quotient.mk I) =
      (Ideal.Quotient.mk (I.map (algebraMap A Λ))).comp (algebraMap A Λ) := by
    ext a
    exact Ideal.Quotient.algebraMap_quotient_map_quotient a
  have hJ' : J.map (algebraMap (A ⧸ I) (Λ ⧸ I.map (algebraMap A Λ))) =
      ((J.comap (Ideal.Quotient.mk I)).map (algebraMap A Λ)).map
        (Ideal.Quotient.mk (I.map (algebraMap A Λ))) := by
    conv_lhs => rw [← Ideal.map_comap_of_surjective _ Ideal.Quotient.mk_surjective J]
    rw [Ideal.map_map, Ideal.map_map, hq]
  have hIK : I.map (algebraMap A Λ) ≤ (J.comap (Ideal.Quotient.mk I)).map (algebraMap A Λ) :=
    Ideal.map_mono (fun x hx => by
      rw [Ideal.mem_comap, Ideal.Quotient.eq_zero_iff_mem.mpr hx]
      exact zero_mem _)
  have hψ : Function.Surjective ((Ideal.Quotient.mk (J.map (algebraMap (A ⧸ I)
      (Λ ⧸ I.map (algebraMap A Λ))))).comp (Ideal.Quotient.mk (I.map (algebraMap A Λ)))) :=
    Ideal.Quotient.mk_surjective.comp Ideal.Quotient.mk_surjective
  have hL : (J.comap (Ideal.Quotient.mk I)).map (algebraMap A Λ) =
      RingHom.ker ((Ideal.Quotient.mk (J.map (algebraMap (A ⧸ I)
        (Λ ⧸ I.map (algebraMap A Λ))))).comp (Ideal.Quotient.mk (I.map (algebraMap A Λ)))) := by
    rw [← RingHom.comap_ker, Ideal.mk_ker, hJ', Ideal.comap_map_mk hIK]
  let eS : (Λ ⧸ (J.comap (Ideal.Quotient.mk I)).map (algebraMap A Λ)) ≃+*
      ((Λ ⧸ I.map (algebraMap A Λ)) ⧸ J.map (algebraMap (A ⧸ I) (Λ ⧸ I.map (algebraMap A Λ)))) :=
    (Ideal.quotEquivOfEq hL).trans (RingHom.quotientKerEquivOfSurjective hψ)
  have heS : ∀ y : Λ, eS (Ideal.Quotient.mk _ y) =
      Ideal.Quotient.mk _ (Ideal.Quotient.mk (I.map (algebraMap A Λ)) y) := fun y => rfl
  have hc : ∀ x : A ⧸ J.comap (Ideal.Quotient.mk I),
      eS (algebraMap _ (Λ ⧸ (J.comap (Ideal.Quotient.mk I)).map (algebraMap A Λ)) x) =
      algebraMap ((A ⧸ I) ⧸ J) ((Λ ⧸ I.map (algebraMap A Λ)) ⧸
        J.map (algebraMap (A ⧸ I) (Λ ⧸ I.map (algebraMap A Λ)))) (eR x) := by
    intro x
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective x
    rw [Ideal.Quotient.algebraMap_quotient_map_quotient, heS, heR,
      Ideal.Quotient.algebraMap_quotient_map_quotient,
      Ideal.Quotient.algebraMap_quotient_map_quotient]
  exact transport _ _ _ _ eR eS hc H

theorem wc_pfc_sqa_std_smooth_quot : ∀ (A : Type u) [CommRing A] (N m : ℕ) (hm : m ≤ N) (τ : Type) [Fintype τ] [DecidableEq τ] (F : Fin m → MvPolynomial (Fin N) A) (G : Fin m → MvPolynomial τ A), Algebra.Smooth A (MvPolynomial (Fin N ⊕ τ ⊕ Unit) A ⧸ Ideal.span (Set.range (Sum.elim (fun j : Fin m => MvPolynomial.rename (Sum.inl : Fin N → Fin N ⊕ τ ⊕ Unit) (F j) - MvPolynomial.rename (fun t : τ => (Sum.inr (Sum.inl t) : Fin N ⊕ τ ⊕ Unit)) (G j)) (fun _ : Unit => MvPolynomial.X (Sum.inr (Sum.inr ()) : Fin N ⊕ τ ⊕ Unit) * MvPolynomial.rename (Sum.inl : Fin N → Fin N ⊕ τ ⊕ Unit) (Matrix.of fun i j : Fin m => MvPolynomial.pderiv (Fin.castLE hm i) (F j)).det - 1)))) :=
by
  intro A _ N m hm τ _ _ F G

  have hgen : ∀ (σ : Type) [Finite σ] (ι : Type) [Fintype ι] [DecidableEq ι]
      (v : ι → MvPolynomial σ A) (a : ι → σ), Function.Injective a →
      IsUnit (Ideal.Quotient.mk (Ideal.span (Set.range v))
        (Matrix.of fun i j : ι => MvPolynomial.pderiv (a i) (v j)).det) →
      Algebra.Smooth A (MvPolynomial σ A ⧸ Ideal.span (Set.range v)) := by
    intro σ _ ι _ _ v a ha hu
    let P := Algebra.PreSubmersivePresentation.naive (v := v) a ha
    have h1 : P.jacobiMatrix = Matrix.of fun i j : ι => MvPolynomial.pderiv (a i) (v j) := by
      ext i j
      rw [P.jacobiMatrix_apply]
      rfl
    have h2 : ∀ p : MvPolynomial σ A, MvPolynomial.aeval P.val p =
        Ideal.Quotient.mk (Ideal.span (Set.range v)) p := by
      have h3 : (MvPolynomial.aeval P.val : MvPolynomial σ A →ₐ[A] _) =
          Ideal.Quotient.mkₐ A (Ideal.span (Set.range v)) := by
        apply MvPolynomial.algHom_ext
        intro i
        rw [MvPolynomial.aeval_X]
        rfl
      intro p
      rw [DFunLike.congr_fun h3 p, Ideal.Quotient.mkₐ_eq_mk]
    have hJ : P.jacobian = Ideal.Quotient.mk (Ideal.span (Set.range v))
        (Matrix.of fun i j : ι => MvPolynomial.pderiv (a i) (v j)).det := by
      rw [P.jacobian_eq_jacobiMatrix_det, h1, Algebra.Generators.algebraMap_apply]
      exact h2 _
    let Q : Algebra.SubmersivePresentation A (MvPolynomial σ A ⧸ Ideal.span (Set.range v)) σ ι :=
      Algebra.SubmersivePresentation.mk P (hJ ▸ hu)
    have := Q.isStandardSmooth
    infer_instance

  have hz : ∀ {σ' : Type} (f : σ' → Fin N ⊕ τ ⊕ Unit) (x : Fin N ⊕ τ ⊕ Unit),
      (∀ y, f y ≠ x) → ∀ p : MvPolynomial σ' A,
      MvPolynomial.pderiv x (MvPolynomial.rename f p) = 0 := by
    intro σ' f x hx p
    classical
    apply MvPolynomial.pderiv_eq_zero_of_notMem_vars
    intro hmem
    obtain ⟨y, -, hy⟩ := Finset.mem_image.mp (MvPolynomial.vars_rename f p hmem)
    exact hx y hy
  let v : Fin m ⊕ Unit → MvPolynomial (Fin N ⊕ τ ⊕ Unit) A :=
    Sum.elim (fun j : Fin m => MvPolynomial.rename (Sum.inl : Fin N → Fin N ⊕ τ ⊕ Unit) (F j) -
        MvPolynomial.rename (fun t : τ => (Sum.inr (Sum.inl t) : Fin N ⊕ τ ⊕ Unit)) (G j))
      (fun _ : Unit => MvPolynomial.X (Sum.inr (Sum.inr ()) : Fin N ⊕ τ ⊕ Unit) *
        MvPolynomial.rename (Sum.inl : Fin N → Fin N ⊕ τ ⊕ Unit)
          (Matrix.of fun i j : Fin m => MvPolynomial.pderiv (Fin.castLE hm i) (F j)).det - 1)
  let a : Fin m ⊕ Unit → Fin N ⊕ τ ⊕ Unit :=
    Sum.elim (fun k : Fin m => (Sum.inl (Fin.castLE hm k) : Fin N ⊕ τ ⊕ Unit))
      (fun _ : Unit => (Sum.inr (Sum.inr ()) : Fin N ⊕ τ ⊕ Unit))
  have ha : Function.Injective a :=
    Function.Injective.sumElim (Sum.inl_injective.comp (Fin.castLE_injective hm))
      (fun x y _ => Subsingleton.elim x y) (fun _ _ => Sum.inl_ne_inr)
  let J : Matrix (Fin m) (Fin m) (MvPolynomial (Fin N) A) :=
    Matrix.of fun i j : Fin m => MvPolynomial.pderiv (Fin.castLE hm i) (F j)
  have hnU : ∀ y : Fin N, (Sum.inl y : Fin N ⊕ τ ⊕ Unit) ≠ Sum.inr (Sum.inr ()) :=
    fun _ => Sum.inl_ne_inr
  have hYU : ∀ t : τ, (Sum.inr (Sum.inl t) : Fin N ⊕ τ ⊕ Unit) ≠ Sum.inr (Sum.inr ()) := by
    intro t h; simp at h
  have hYX : ∀ (k : Fin N) (t : τ), (Sum.inr (Sum.inl t) : Fin N ⊕ τ ⊕ Unit) ≠ Sum.inl k := by
    intro k t h; simp at h

  have hdet : (Matrix.of fun i j : Fin m ⊕ Unit => MvPolynomial.pderiv (a i) (v j)).det =
      MvPolynomial.rename (Sum.inl : Fin N → Fin N ⊕ τ ⊕ Unit) J.det *
        MvPolynomial.rename (Sum.inl : Fin N → Fin N ⊕ τ ⊕ Unit) J.det := by
    set M := Matrix.of fun i j : Fin m ⊕ Unit => MvPolynomial.pderiv (a i) (v j) with hM
    have h21 : M.toBlocks₂₁ = 0 := by
      refine Matrix.ext fun u j => ?_
      show MvPolynomial.pderiv (Sum.inr (Sum.inr ()) : Fin N ⊕ τ ⊕ Unit)
        (MvPolynomial.rename (Sum.inl : Fin N → Fin N ⊕ τ ⊕ Unit) (F j) -
          MvPolynomial.rename (fun t : τ => (Sum.inr (Sum.inl t) : Fin N ⊕ τ ⊕ Unit)) (G j)) = 0
      rw [map_sub, hz _ _ hnU (F j), hz _ _ hYU (G j), sub_zero]
    have h11 : M.toBlocks₁₁ =
        (MvPolynomial.rename (Sum.inl : Fin N → Fin N ⊕ τ ⊕ Unit) :
          MvPolynomial (Fin N) A →ₐ[A] MvPolynomial (Fin N ⊕ τ ⊕ Unit) A).mapMatrix J := by
      refine Matrix.ext fun i j => ?_
      rw [AlgHom.mapMatrix_apply, Matrix.map_apply]
      show MvPolynomial.pderiv (Sum.inl (Fin.castLE hm i) : Fin N ⊕ τ ⊕ Unit)
        (MvPolynomial.rename (Sum.inl : Fin N → Fin N ⊕ τ ⊕ Unit) (F j) -
          MvPolynomial.rename (fun t : τ => (Sum.inr (Sum.inl t) : Fin N ⊕ τ ⊕ Unit)) (G j)) =
        MvPolynomial.rename (Sum.inl : Fin N → Fin N ⊕ τ ⊕ Unit)
          (MvPolynomial.pderiv (Fin.castLE hm i) (F j))
      rw [map_sub, MvPolynomial.pderiv_rename Sum.inl_injective,
        hz _ _ (fun t => hYX (Fin.castLE hm i) t) (G j), sub_zero]
    have h22 : M.toBlocks₂₂.det = MvPolynomial.rename (Sum.inl : Fin N → Fin N ⊕ τ ⊕ Unit) J.det := by
      rw [Matrix.det_unique]
      show MvPolynomial.pderiv (Sum.inr (Sum.inr ()) : Fin N ⊕ τ ⊕ Unit)
        (MvPolynomial.X (Sum.inr (Sum.inr ()) : Fin N ⊕ τ ⊕ Unit) *
          MvPolynomial.rename (Sum.inl : Fin N → Fin N ⊕ τ ⊕ Unit) J.det - 1) =
        MvPolynomial.rename (Sum.inl : Fin N → Fin N ⊕ τ ⊕ Unit) J.det
      rw [map_sub, MvPolynomial.pderiv_mul, MvPolynomial.pderiv_X_self, hz _ _ hnU J.det]
      simp
    rw [← Matrix.fromBlocks_toBlocks M, h21, Matrix.det_fromBlocks_zero₂₁, h11, ← AlgHom.map_det,
      h22]

  have hu : IsUnit (Ideal.Quotient.mk (Ideal.span (Set.range v))
      (Matrix.of fun i j : Fin m ⊕ Unit => MvPolynomial.pderiv (a i) (v j)).det) := by
    rw [hdet, map_mul]
    have hrel : v (Sum.inr ()) ∈ Ideal.span (Set.range v) := Ideal.subset_span ⟨Sum.inr (), rfl⟩
    have h1 : Ideal.Quotient.mk (Ideal.span (Set.range v))
          (MvPolynomial.X (Sum.inr (Sum.inr ()) : Fin N ⊕ τ ⊕ Unit)) *
        Ideal.Quotient.mk (Ideal.span (Set.range v))
          (MvPolynomial.rename (Sum.inl : Fin N → Fin N ⊕ τ ⊕ Unit) J.det) = 1 := by
      rw [← map_mul, ← map_one (Ideal.Quotient.mk (Ideal.span (Set.range v))), Ideal.Quotient.eq]
      exact hrel
    have hΔu : IsUnit (Ideal.Quotient.mk (Ideal.span (Set.range v))
        (MvPolynomial.rename (Sum.inl : Fin N → Fin N ⊕ τ ⊕ Unit) J.det)) :=
      isUnit_iff_exists.mpr ⟨_, by rw [mul_comm]; exact h1, h1⟩
    exact hΔu.mul hΔu
  exact hgen (Fin N ⊕ τ ⊕ Unit) (Fin m ⊕ Unit) v a ha hu

theorem wc_pfc_sqa_lift_data : (∀ (R : Type u) [CommRing R] (D : Type u) [CommRing D] [Algebra R D] [Algebra.Smooth R D], ∃ (N c : ℕ) (hc : c ≤ N) (f : Fin c → MvPolynomial (Fin N) R) (α : D →ₐ[R] MvPolynomial (Fin N) R ⧸ Ideal.span (Set.range f)) (β : (MvPolynomial (Fin N) R ⧸ Ideal.span (Set.range f)) →ₐ[R] D), β.comp α = AlgHom.id R D ∧ IsUnit (Ideal.Quotient.mk (Ideal.span (Set.range f)) (Matrix.of fun i j : Fin c => MvPolynomial.pderiv (Fin.castLE hc i) (f j)).det)) → ∀ (A : Type u) [CommRing A] (Λ : Type u) [CommRing Λ] [Algebra A Λ] (I : Ideal A), I ^ 2 = ⊥ → (∀ (n : ℕ) (s : Finset (MvPolynomial (Fin n) (A ⧸ I))) (b : Fin n → Λ ⧸ I.map (algebraMap A Λ)), (∀ f ∈ s, MvPolynomial.aeval b f = 0) → ∃ (D : Type u) (_ : CommRing D) (_ : Algebra (A ⧸ I) D) (_ : Algebra.Smooth (A ⧸ I) D) (c : Fin n → D) (γ : D →ₐ[A ⧸ I] Λ ⧸ I.map (algebraMap A Λ)), (∀ f ∈ s, MvPolynomial.aeval c f = 0) ∧ ∀ i, γ (c i) = b i) → ∀ (n : ℕ) (s : Finset (MvPolynomial (Fin n) A)) (b : Fin n → Λ), (∀ f ∈ s, MvPolynomial.aeval b f = 0) → ∃ (N m : ℕ) (hm : m ≤ N) (F : Fin m → MvPolynomial (Fin N) A) (lam : Fin N → Λ) (h : Fin n → MvPolynomial (Fin N) A), (∀ j, MvPolynomial.aeval lam (F j) ∈ I.map (algebraMap A Λ)) ∧ IsUnit (MvPolynomial.aeval lam (Matrix.of fun i j : Fin m => MvPolynomial.pderiv (Fin.castLE hm i) (F j)).det) ∧ (∀ i, b i - MvPolynomial.aeval lam (h i) ∈ I.map (algebraMap A Λ)) ∧ ∀ f ∈ s, MvPolynomial.aeval h f ∈ Ideal.span (Set.range F) ⊔ Ideal.map (MvPolynomial.C : A →+* MvPolynomial (Fin N) A) I :=
by
  intro hS9 A _ Λ _ _ I hI2 hPT n s b hb
  classical

  have unitLift : ∀ x : Λ, IsUnit (Ideal.Quotient.mk (I.map (algebraMap A Λ)) x) → IsUnit x := by
    have hJ2 : (I.map (algebraMap A Λ)) ^ 2 = ⊥ := by
      rw [← Ideal.map_pow, hI2, Ideal.map_bot]
    intro x hx
    obtain ⟨w, hw⟩ := hx.exists_right_inv
    obtain ⟨z, rfl⟩ := Ideal.Quotient.mk_surjective w
    have hj : x * z - 1 ∈ I.map (algebraMap A Λ) := by
      rw [← Ideal.Quotient.eq, map_mul, hw, map_one]
    have hnil : IsNilpotent (x * z - 1) := by
      refine ⟨2, ?_⟩
      have h2 : (x * z - 1) ^ 2 ∈ (I.map (algebraMap A Λ)) ^ 2 := Ideal.pow_mem_pow hj 2
      rw [hJ2] at h2
      exact (Ideal.mem_bot).mp h2
    have hu : IsUnit (x * z) := by
      have h3 := hnil.isUnit_add_one
      rwa [sub_add_cancel] at h3
    exact isUnit_of_mul_isUnit_left hu

  have spanLift : ∀ (N m : ℕ) (F : Fin m → MvPolynomial (Fin N) A) (p : MvPolynomial (Fin N) A),
      MvPolynomial.map (Ideal.Quotient.mk I) p ∈
        Ideal.span (Set.range (fun j => MvPolynomial.map (Ideal.Quotient.mk I) (F j))) →
      p ∈ Ideal.span (Set.range F) ⊔ Ideal.map (MvPolynomial.C : A →+* MvPolynomial (Fin N) A) I := by
    intro N m F p hp
    have hsurj : Function.Surjective
        (MvPolynomial.map (σ := Fin N) (Ideal.Quotient.mk I)) :=
      MvPolynomial.map_surjective _ Ideal.Quotient.mk_surjective
    have hrange : Set.range (fun j => MvPolynomial.map (Ideal.Quotient.mk I) (F j)) =
        (MvPolynomial.map (Ideal.Quotient.mk I)) '' Set.range F := by
      rw [← Set.range_comp]
      rfl
    rw [hrange, ← Ideal.map_span, Ideal.mem_map_iff_of_surjective _ hsurj] at hp
    obtain ⟨q, hq, hqp⟩ := hp
    have hker : p - q ∈ RingHom.ker (MvPolynomial.map (σ := Fin N) (Ideal.Quotient.mk I)) := by
      rw [RingHom.mem_ker, map_sub, hqp, sub_self]
    rw [MvPolynomial.ker_map, Ideal.mk_ker] at hker
    exact Submodule.mem_sup.mpr ⟨q, hq, p - q, hker, by abel⟩

  have hbbar : ∀ g ∈ s.image (MvPolynomial.map (Ideal.Quotient.mk I)),
      MvPolynomial.aeval (fun i => Ideal.Quotient.mk (I.map (algebraMap A Λ)) (b i)) g = 0 := by
    intro g hg
    obtain ⟨g₀, hg₀, rfl⟩ := Finset.mem_image.mp hg
    rw [show MvPolynomial.map (Ideal.Quotient.mk I) g₀ =
        MvPolynomial.map (algebraMap A (A ⧸ I)) g₀ from rfl, MvPolynomial.aeval_map_algebraMap]
    exact (MvPolynomial.aeval_algebraMap_apply (Λ ⧸ I.map (algebraMap A Λ)) b g₀).trans
      (by rw [hb g₀ hg₀, map_zero])

  obtain ⟨D, _, _, _, c, γ, hc, hγ⟩ := hPT n (s.image (MvPolynomial.map (Ideal.Quotient.mk I)))
    (fun i => Ideal.Quotient.mk (I.map (algebraMap A Λ)) (b i)) hbbar
  obtain ⟨N, m, hm, f, α, β, hβα, hunit⟩ := hS9 (A ⧸ I) D
  obtain ⟨ξ, hξ⟩ : ∃ ξ : Fin N → Λ ⧸ I.map (algebraMap A Λ), ∀ k,
      ξ k = (γ.comp β) (Ideal.Quotient.mk (Ideal.span (Set.range f)) (MvPolynomial.X k)) :=
    ⟨_, fun _ => rfl⟩
  have hK' : ∀ p, (γ.comp β) (Ideal.Quotient.mk (Ideal.span (Set.range f)) p) =
      MvPolynomial.aeval ξ p := by
    intro p
    have e : (γ.comp β).comp (Ideal.Quotient.mkₐ (A ⧸ I) (Ideal.span (Set.range f))) =
        MvPolynomial.aeval ξ := by
      apply MvPolynomial.algHom_ext
      intro k
      rw [MvPolynomial.aeval_X, AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk, hξ]
    have e2 := AlgHom.congr_fun e p
    rwa [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk] at e2
  choose y hy using fun i => Ideal.Quotient.mk_surjective (I := Ideal.span (Set.range f)) (α (c i))
  have hf0 : ∀ j, MvPolynomial.aeval ξ (f j) = 0 := by
    intro j
    have hmem : f j ∈ Ideal.span (Set.range f) := Ideal.subset_span ⟨j, rfl⟩
    rw [← hK', Ideal.Quotient.eq_zero_iff_mem.mpr hmem, map_zero]
  have hΔ0 : IsUnit (MvPolynomial.aeval ξ
      (Matrix.of fun i j : Fin m => MvPolynomial.pderiv (Fin.castLE hm i) (f j)).det) := by
    rw [← hK']
    exact hunit.map _
  have hy0 : ∀ i, MvPolynomial.aeval ξ (y i) = Ideal.Quotient.mk (I.map (algebraMap A Λ)) (b i) := by
    intro i
    rw [← hK', hy i, AlgHom.comp_apply, ← AlgHom.comp_apply β α (c i), hβα, AlgHom.id_apply]
    exact hγ i
  have hs0 : ∀ g ∈ s, MvPolynomial.aeval y (MvPolynomial.map (Ideal.Quotient.mk I) g) ∈
      Ideal.span (Set.range f) := by
    intro g hg
    have hfun : (fun i => Ideal.Quotient.mkₐ (A ⧸ I) (Ideal.span (Set.range f)) (y i)) =
        fun i => α (c i) := by
      funext i
      rw [Ideal.Quotient.mkₐ_eq_mk, hy i]
    have e1 : Ideal.Quotient.mkₐ (A ⧸ I) (Ideal.span (Set.range f))
        (MvPolynomial.aeval y (MvPolynomial.map (Ideal.Quotient.mk I) g)) =
        α (MvPolynomial.aeval c (MvPolynomial.map (Ideal.Quotient.mk I) g)) := by
      rw [MvPolynomial.comp_aeval_apply, MvPolynomial.comp_aeval_apply, hfun]
    rw [hc _ (Finset.mem_image_of_mem _ hg), map_zero, Ideal.Quotient.mkₐ_eq_mk] at e1
    exact Ideal.Quotient.eq_zero_iff_mem.mp e1

  choose F hF using fun j => MvPolynomial.map_surjective (σ := Fin N) _
    (Ideal.Quotient.mk_surjective (I := I)) (f j)
  choose h hh using fun i => MvPolynomial.map_surjective (σ := Fin N) _
    (Ideal.Quotient.mk_surjective (I := I)) (y i)
  choose lam hlam using fun k => Ideal.Quotient.mk_surjective (I := I.map (algebraMap A Λ)) (ξ k)
  have hK : ∀ p : MvPolynomial (Fin N) A,
      Ideal.Quotient.mk (I.map (algebraMap A Λ)) (MvPolynomial.aeval lam p) =
        MvPolynomial.aeval ξ (MvPolynomial.map (Ideal.Quotient.mk I) p) := by
    intro p
    have e1 : (fun k => Ideal.Quotient.mk (I.map (algebraMap A Λ)) (lam k)) = ξ := funext hlam
    rw [show MvPolynomial.map (Ideal.Quotient.mk I) p =
        MvPolynomial.map (algebraMap A (A ⧸ I)) p from rfl, MvPolynomial.aeval_map_algebraMap, ← e1]
    exact (MvPolynomial.aeval_algebraMap_apply (Λ ⧸ I.map (algebraMap A Λ)) lam p).symm
  have ha : ∀ j, MvPolynomial.aeval lam (F j) ∈ I.map (algebraMap A Λ) := by
    intro j
    rw [← Ideal.Quotient.eq_zero_iff_mem, hK, hF j, hf0 j]
  have hcc : ∀ i, b i - MvPolynomial.aeval lam (h i) ∈ I.map (algebraMap A Λ) := by
    intro i
    rw [← Ideal.Quotient.eq, hK, hh i, hy0 i]
  have hdet : MvPolynomial.map (Ideal.Quotient.mk I)
      (Matrix.of fun i j : Fin m => MvPolynomial.pderiv (Fin.castLE hm i) (F j)).det =
      (Matrix.of fun i j : Fin m => MvPolynomial.pderiv (Fin.castLE hm i) (f j)).det := by
    rw [RingHom.map_det]
    congr 1
    ext i j
    simp only [RingHom.mapMatrix_apply, Matrix.map_apply, Matrix.of_apply]
    rw [← MvPolynomial.pderiv_map, hF j]
  have hb' : IsUnit (MvPolynomial.aeval lam
      (Matrix.of fun i j : Fin m => MvPolynomial.pderiv (Fin.castLE hm i) (F j)).det) := by
    apply unitLift
    rw [hK, hdet]
    exact hΔ0
  have hevmap : ∀ g : MvPolynomial (Fin n) A,
      MvPolynomial.map (Ideal.Quotient.mk I) (MvPolynomial.aeval h g) =
        MvPolynomial.aeval y (MvPolynomial.map (Ideal.Quotient.mk I) g) := by
    intro g
    induction g using MvPolynomial.induction_on with
    | C a => simp only [MvPolynomial.aeval_C, MvPolynomial.map_C, MvPolynomial.algebraMap_eq]
    | add p q hp hq => simp only [map_add, hp, hq]
    | mul_X p i hp => simp only [map_mul, hp, MvPolynomial.aeval_X, MvPolynomial.map_X, hh i]
  have hd : ∀ g ∈ s, MvPolynomial.aeval h g ∈
      Ideal.span (Set.range F) ⊔ Ideal.map (MvPolynomial.C : A →+* MvPolynomial (Fin N) A) I := by
    intro g hg
    apply spanLift N m F
    have e : (fun j => MvPolynomial.map (Ideal.Quotient.mk I) (F j)) = f := funext hF
    rw [e, hevmap]
    exact hs0 g hg
  exact ⟨N, m, hm, F, lam, h, ha, hb', hcc, hd⟩

theorem wc_pfc_sqa_construct : (∀ (A : Type u) [CommRing A] (N m : ℕ) (hm : m ≤ N) (τ : Type) [Fintype τ] [DecidableEq τ] (F : Fin m → MvPolynomial (Fin N) A) (G : Fin m → MvPolynomial τ A), Algebra.Smooth A (MvPolynomial (Fin N ⊕ τ ⊕ Unit) A ⧸ Ideal.span (Set.range (Sum.elim (fun j : Fin m => MvPolynomial.rename (Sum.inl : Fin N → Fin N ⊕ τ ⊕ Unit) (F j) - MvPolynomial.rename (fun t : τ => (Sum.inr (Sum.inl t) : Fin N ⊕ τ ⊕ Unit)) (G j)) (fun _ : Unit => MvPolynomial.X (Sum.inr (Sum.inr ()) : Fin N ⊕ τ ⊕ Unit) * MvPolynomial.rename (Sum.inl : Fin N → Fin N ⊕ τ ⊕ Unit) (Matrix.of fun i j : Fin m => MvPolynomial.pderiv (Fin.castLE hm i) (F j)).det - 1))))) → (∀ (A : Type u) [CommRing A] (Λ : Type u) [CommRing Λ] [Algebra A Λ] (I : Ideal A) (r : ℕ) (z : Fin r → Λ), (∀ k, z k ∈ I.map (algebraMap A Λ)) → ∃ (M : ℕ) (ε : Fin M → A) (μ : Fin r → Fin M → Λ), (∀ l, ε l ∈ I) ∧ ∀ k, z k = ∑ l, algebraMap A Λ (ε l) * μ k l) → ∀ (A : Type u) [CommRing A] (Λ : Type u) [CommRing Λ] [Algebra A Λ] (I : Ideal A) (n : ℕ) (s : Finset (MvPolynomial (Fin n) A)) (b : Fin n → Λ) (N m : ℕ) (hm : m ≤ N) (F : Fin m → MvPolynomial (Fin N) A) (lam : Fin N → Λ) (h : Fin n → MvPolynomial (Fin N) A), (∀ j, MvPolynomial.aeval lam (F j) ∈ I.map (algebraMap A Λ)) → IsUnit (MvPolynomial.aeval lam (Matrix.of fun i j : Fin m => MvPolynomial.pderiv (Fin.castLE hm i) (F j)).det) → (∀ i, b i - MvPolynomial.aeval lam (h i) ∈ I.map (algebraMap A Λ)) → (∀ f ∈ s, MvPolynomial.aeval h f ∈ Ideal.span (Set.range F) ⊔ Ideal.map (MvPolynomial.C : A →+* MvPolynomial (Fin N) A) I) → ∃ (B : Type u) (_ : CommRing B) (_ : Algebra A B) (_ : Algebra.Smooth A B) (c : Fin n → B) (ψ : B →ₐ[A] Λ), (∀ f ∈ s, MvPolynomial.aeval c f ∈ I.map (algebraMap A B)) ∧ ∀ i, ψ (c i) = b i :=
by
  intro hS1 combo A _ Λ _ _ I n s b N m hm F lam h ha hΔ hc hd
  classical
  obtain ⟨M₁, ε, μ, hεI, hμ⟩ := combo A Λ I m (fun j => MvPolynomial.aeval lam (F j)) ha
  obtain ⟨M₂, ε', ν, hε'I, hν⟩ := combo A Λ I n (fun i => b i - MvPolynomial.aeval lam (h i)) hc
  let τ : Type := (Fin m × Fin M₁) ⊕ (Fin n × Fin M₂)
  let G : Fin m → MvPolynomial τ A := fun j =>
    ∑ l, MvPolynomial.C (ε l) * MvPolynomial.X (Sum.inl (j, l))
  let 𝔯 : Ideal (MvPolynomial (Fin N ⊕ τ ⊕ Unit) A) := Ideal.span (Set.range (Sum.elim (fun j : Fin m => MvPolynomial.rename (Sum.inl : Fin N → Fin N ⊕ τ ⊕ Unit) (F j) - MvPolynomial.rename (fun t : τ => (Sum.inr (Sum.inl t) : Fin N ⊕ τ ⊕ Unit)) (G j)) (fun _ : Unit => MvPolynomial.X (Sum.inr (Sum.inr ()) : Fin N ⊕ τ ⊕ Unit) * MvPolynomial.rename (Sum.inl : Fin N → Fin N ⊕ τ ⊕ Unit) (Matrix.of fun i j : Fin m => MvPolynomial.pderiv (Fin.castLE hm i) (F j)).det - 1)))
  have hsm : Algebra.Smooth A (MvPolynomial (Fin N ⊕ τ ⊕ Unit) A ⧸ 𝔯) := hS1 A N m hm τ F G
  let v : Fin N ⊕ τ ⊕ Unit → Λ := Sum.elim lam (Sum.elim (Sum.elim (fun p => μ p.1 p.2)
    (fun q => ν q.1 q.2)) (fun _ => ((hΔ.unit⁻¹ : Λˣ) : Λ)))
  have hv1 : v ∘ Sum.inl = lam := rfl
  have hker : ∀ a ∈ 𝔯, MvPolynomial.aeval v a = 0 := by
    intro a ha'
    have hle : 𝔯 ≤ RingHom.ker (MvPolynomial.aeval v) := by
      rw [Ideal.span_le]
      rintro _ ⟨k, rfl⟩
      rcases k with j | ⟨⟩
      · simp only [Sum.elim_inl, SetLike.mem_coe, RingHom.mem_ker, map_sub,
          MvPolynomial.aeval_rename]
        rw [hv1, hμ j]
        simp [G, v, map_sum, MvPolynomial.aeval_X]
      · simp only [Sum.elim_inr, SetLike.mem_coe, RingHom.mem_ker, map_sub, map_mul,
          MvPolynomial.aeval_X, MvPolynomial.aeval_rename, map_one]
        rw [hv1]
        show ((hΔ.unit⁻¹ : Λˣ) : Λ) * _ - 1 = 0
        rw [IsUnit.val_inv_mul, sub_self]
    exact hle ha'
  obtain ⟨ψ, hψdef⟩ : ∃ ψ : (MvPolynomial (Fin N ⊕ τ ⊕ Unit) A ⧸ 𝔯) →ₐ[A] Λ,
      ∀ p, ψ (Ideal.Quotient.mkₐ A 𝔯 p) = MvPolynomial.aeval v p :=
    ⟨Ideal.Quotient.liftₐ 𝔯 (MvPolynomial.aeval v) hker, fun p => rfl⟩
  let e : MvPolynomial (Fin N) A →ₐ[A] (MvPolynomial (Fin N ⊕ τ ⊕ Unit) A ⧸ 𝔯) :=
    (Ideal.Quotient.mkₐ A 𝔯).comp (MvPolynomial.rename Sum.inl)
  let c : Fin n → (MvPolynomial (Fin N ⊕ τ ⊕ Unit) A ⧸ 𝔯) := fun i =>
    Ideal.Quotient.mkₐ A 𝔯 (MvPolynomial.rename Sum.inl (h i) +
      ∑ l, MvPolynomial.C (ε' l) * MvPolynomial.X (Sum.inr (Sum.inl (Sum.inr (i, l)))))
  have hψ : ∀ i, ψ (c i) = b i := by
    intro i
    simp only [c]
    rw [hψdef, map_add, MvPolynomial.aeval_rename, hv1, map_sum]
    simp only [map_mul, MvPolynomial.aeval_C, MvPolynomial.aeval_X]
    have := hν i
    show MvPolynomial.aeval lam (h i) + ∑ l, algebraMap A Λ (ε' l) * ν i l = b i
    rw [← this]
    ring
  set J := I.map (algebraMap A (MvPolynomial (Fin N ⊕ τ ⊕ Unit) A ⧸ 𝔯)) with hJ
  have hR : ∀ j, Ideal.Quotient.mkₐ A 𝔯 (MvPolynomial.rename (Sum.inl : Fin N → Fin N ⊕ τ ⊕ Unit) (F j) - MvPolynomial.rename (fun t : τ => (Sum.inr (Sum.inl t) : Fin N ⊕ τ ⊕ Unit)) (G j)) = 0 := by
    intro j
    rw [Ideal.Quotient.mkₐ_eq_mk, Ideal.Quotient.eq_zero_iff_mem]
    exact Ideal.subset_span ⟨Sum.inl j, rfl⟩
  have hF : ∀ j, e (F j) ∈ J := by
    intro j
    have h1 : e (F j) = Ideal.Quotient.mkₐ A 𝔯 (MvPolynomial.rename (Sum.inl : Fin N → Fin N ⊕ τ ⊕ Unit) (F j) - MvPolynomial.rename (fun t : τ => (Sum.inr (Sum.inl t) : Fin N ⊕ τ ⊕ Unit)) (G j)) + Ideal.Quotient.mkₐ A 𝔯 (MvPolynomial.rename (fun t : τ => (Sum.inr (Sum.inl t) : Fin N ⊕ τ ⊕ Unit)) (G j)) := by
      rw [← map_add, sub_add_cancel]
      rfl
    rw [h1, hR j, zero_add]
    simp only [G, map_sum, map_mul, MvPolynomial.rename_X, MvPolynomial.algHom_C]
    exact Ideal.sum_mem _ (fun l _ => Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ (hεI l)))
  have hC : ∀ i, c i - e (h i) ∈ J := by
    intro i
    have h1 : c i - e (h i) = Ideal.Quotient.mkₐ A 𝔯
        (∑ l, MvPolynomial.C (ε' l) * MvPolynomial.X (Sum.inr (Sum.inl (Sum.inr (i, l))))) := by
      simp only [c, e, AlgHom.comp_apply]
      rw [map_add, add_sub_cancel_left]
    rw [h1]
    simp only [map_sum, map_mul, MvPolynomial.algHom_C]
    exact Ideal.sum_mem _ (fun l _ => Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ (hε'I l)))
  refine ⟨MvPolynomial (Fin N ⊕ τ ⊕ Unit) A ⧸ 𝔯, inferInstance, inferInstance, hsm, c, ψ, ?_, hψ⟩
  intro f hf

  have transfer : ∀ (B : Type u) [CommRing B] [Algebra A B]
      (e : MvPolynomial (Fin N) A →ₐ[A] B) (c : Fin n → B),
      (∀ j, e (F j) ∈ I.map (algebraMap A B)) → (∀ i, c i - e (h i) ∈ I.map (algebraMap A B)) →
      ∀ f : MvPolynomial (Fin n) A, MvPolynomial.aeval h f ∈ Ideal.span (Set.range F) ⊔
        Ideal.map (MvPolynomial.C : A →+* MvPolynomial (Fin N) A) I →
      MvPolynomial.aeval c f ∈ I.map (algebraMap A B) := by
    intro B _ _ e c hF hC f hf
    set J := I.map (algebraMap A B) with hJ
    have hqc : ∀ i, Ideal.Quotient.mkₐ A J (c i) = Ideal.Quotient.mkₐ A J (e (h i)) := by
      intro i
      rw [Ideal.Quotient.mkₐ_eq_mk, Ideal.Quotient.eq]
      exact hC i
    have hle : Ideal.span (Set.range F) ⊔ Ideal.map (MvPolynomial.C : A →+* MvPolynomial (Fin N) A) I
        ≤ J.comap e := by
      refine sup_le ?_ ?_
      · rw [Ideal.span_le]
        rintro _ ⟨j, rfl⟩
        exact hF j
      · rw [Ideal.map_le_iff_le_comap]
        intro a ha'
        show e (MvPolynomial.C a) ∈ J
        rw [MvPolynomial.algHom_C]
        exact Ideal.mem_map_of_mem _ ha'
    have h1 : e (MvPolynomial.aeval h f) ∈ J := hle hf
    have e1 : Ideal.Quotient.mkₐ A J (MvPolynomial.aeval c f) =
        MvPolynomial.aeval (fun i => Ideal.Quotient.mkₐ A J (c i)) f :=
      MvPolynomial.comp_aeval_apply c (Ideal.Quotient.mkₐ A J) f
    have e2 : Ideal.Quotient.mkₐ A J (e (MvPolynomial.aeval h f)) =
        MvPolynomial.aeval (fun i => Ideal.Quotient.mkₐ A J (e (h i))) f := by
      rw [MvPolynomial.comp_aeval_apply h e f]
      exact MvPolynomial.comp_aeval_apply (fun i => e (h i)) (Ideal.Quotient.mkₐ A J) f
    have e3 : (fun i => Ideal.Quotient.mkₐ A J (c i)) =
        (fun i => Ideal.Quotient.mkₐ A J (e (h i))) := funext hqc
    have key : Ideal.Quotient.mkₐ A J (MvPolynomial.aeval c f) =
        Ideal.Quotient.mkₐ A J (e (MvPolynomial.aeval h f)) := by
      rw [e1, e2, e3]
    have h2 : Ideal.Quotient.mkₐ A J (e (MvPolynomial.aeval h f)) = 0 := by
      rw [Ideal.Quotient.mkₐ_eq_mk, Ideal.Quotient.eq_zero_iff_mem]
      exact h1
    have h3 := key.trans h2
    rw [Ideal.Quotient.mkₐ_eq_mk, Ideal.Quotient.eq_zero_iff_mem] at h3
    exact h3
  exact transfer _ e c hF hC f (hd f hf)

theorem wc_pfc_sq_zero_approx : (∀ (R : Type u) [CommRing R] (D : Type u) [CommRing D] [Algebra R D] [Algebra.Smooth R D], ∃ (N c : ℕ) (hc : c ≤ N) (f : Fin c → MvPolynomial (Fin N) R) (α : D →ₐ[R] MvPolynomial (Fin N) R ⧸ Ideal.span (Set.range f)) (β : (MvPolynomial (Fin N) R ⧸ Ideal.span (Set.range f)) →ₐ[R] D), β.comp α = AlgHom.id R D ∧ IsUnit (Ideal.Quotient.mk (Ideal.span (Set.range f)) (Matrix.of fun i j : Fin c => MvPolynomial.pderiv (Fin.castLE hc i) (f j)).det)) → ∀ (A : Type u) [CommRing A] (Λ : Type u) [CommRing Λ] [Algebra A Λ] (I : Ideal A), I ^ 2 = ⊥ → (∀ (n : ℕ) (s : Finset (MvPolynomial (Fin n) (A ⧸ I))) (b : Fin n → Λ ⧸ I.map (algebraMap A Λ)), (∀ f ∈ s, MvPolynomial.aeval b f = 0) → ∃ (D : Type u) (_ : CommRing D) (_ : Algebra (A ⧸ I) D) (_ : Algebra.Smooth (A ⧸ I) D) (c : Fin n → D) (γ : D →ₐ[A ⧸ I] Λ ⧸ I.map (algebraMap A Λ)), (∀ f ∈ s, MvPolynomial.aeval c f = 0) ∧ ∀ i, γ (c i) = b i) → ∀ (n : ℕ) (s : Finset (MvPolynomial (Fin n) A)) (b : Fin n → Λ), (∀ f ∈ s, MvPolynomial.aeval b f = 0) → ∃ (B : Type u) (_ : CommRing B) (_ : Algebra A B) (_ : Algebra.Smooth A B) (c : Fin n → B) (ψ : B →ₐ[A] Λ), (∀ f ∈ s, MvPolynomial.aeval c f ∈ I.map (algebraMap A B)) ∧ ∀ i, ψ (c i) = b i :=
by
  have combo : ∀ (A : Type u) [CommRing A] (Λ : Type u) [CommRing Λ] [Algebra A Λ] (I : Ideal A) (r : ℕ) (z : Fin r → Λ), (∀ k, z k ∈ I.map (algebraMap A Λ)) → ∃ (M : ℕ) (ε : Fin M → A) (μ : Fin r → Fin M → Λ), (∀ l, ε l ∈ I) ∧ ∀ k, z k = ∑ l, algebraMap A Λ (ε l) * μ k l := by
    intro A _ Λ _ _ I r z hz
    classical
    have hT : ∀ k, ∃ T : Finset Λ, (↑T : Set Λ) ⊆ algebraMap A Λ '' (I : Set A) ∧
        z k ∈ Submodule.span Λ (↑T : Set Λ) := fun k =>
      Submodule.mem_span_finite_of_mem_span
        (show z k ∈ Submodule.span Λ (algebraMap A Λ '' (I : Set A)) from hz k)
    choose T hTs hTz using hT
    let S : Finset Λ := Finset.univ.biUnion T
    have hS : (↑S : Set Λ) ⊆ algebraMap A Λ '' (I : Set A) := by
      intro x hx
      obtain ⟨k, -, hk⟩ := Finset.mem_biUnion.mp hx
      exact hTs k hk
    have hSz : ∀ k, z k ∈ Submodule.span Λ (↑S : Set Λ) := fun k =>
      Submodule.span_mono (fun x hx => Finset.mem_biUnion.mpr ⟨k, Finset.mem_univ _, hx⟩) (hTz k)
    have hpre : ∀ x : S, ∃ a : A, a ∈ I ∧ algebraMap A Λ a = x := fun x => hS x.2
    choose ε0 hε0I hε0 using hpre
    choose g hg using fun k => (Submodule.mem_span_finset.mp (hSz k))
    refine ⟨S.card, fun l => ε0 (S.equivFin.symm l), fun k l => g k (S.equivFin.symm l),
      fun l => hε0I _, fun k => ?_⟩
    obtain ⟨-, hgk⟩ := hg k
    rw [← hgk, ← Finset.sum_coe_sort S,
      ← Equiv.sum_comp S.equivFin.symm (fun x : S => g k ↑x • (↑x : Λ))]
    refine Finset.sum_congr rfl (fun l _ => ?_)
    rw [hε0, smul_eq_mul, mul_comm]
  intro hS9 A _ Λ _ _ I hI2 hPT n s b hb
  obtain ⟨N, m, hm, F, lam, h, ha, hΔ, hc, hd⟩ :=
    wc_pfc_sqa_lift_data hS9 A Λ I hI2 hPT n s b hb
  exact wc_pfc_sqa_construct wc_pfc_sqa_std_smooth_quot combo A Λ I n s b N m hm F lam h
    ha hΔ hc hd

theorem wc_pfc_sq_zero_exact : (∀ (A : Type u) [CommRing A] (Λ : Type u) [CommRing Λ] [Algebra A Λ] (I : Ideal A), I ^ 2 = ⊥ → (∀ (n : ℕ) (s : Finset (MvPolynomial (Fin n) (A ⧸ I))) (b : Fin n → Λ ⧸ I.map (algebraMap A Λ)), (∀ f ∈ s, MvPolynomial.aeval b f = 0) → ∃ (D : Type u) (_ : CommRing D) (_ : Algebra (A ⧸ I) D) (_ : Algebra.Smooth (A ⧸ I) D) (c : Fin n → D) (γ : D →ₐ[A ⧸ I] Λ ⧸ I.map (algebraMap A Λ)), (∀ f ∈ s, MvPolynomial.aeval c f = 0) ∧ ∀ i, γ (c i) = b i) → ∀ (n : ℕ) (s : Finset (MvPolynomial (Fin n) A)) (b : Fin n → Λ), (∀ f ∈ s, MvPolynomial.aeval b f = 0) → ∃ (B : Type u) (_ : CommRing B) (_ : Algebra A B) (_ : Algebra.Smooth A B) (c : Fin n → B) (ψ : B →ₐ[A] Λ), (∀ f ∈ s, MvPolynomial.aeval c f ∈ I.map (algebraMap A B)) ∧ ∀ i, ψ (c i) = b i) → ∀ (A : Type u) [CommRing A] (Λ : Type u) [CommRing Λ] [Algebra A Λ], Module.Flat A Λ → ∀ (I : Ideal A), I ^ 2 = ⊥ → (∀ (n : ℕ) (s : Finset (MvPolynomial (Fin n) (A ⧸ I))) (b : Fin n → Λ ⧸ I.map (algebraMap A Λ)), (∀ f ∈ s, MvPolynomial.aeval b f = 0) → ∃ (D : Type u) (_ : CommRing D) (_ : Algebra (A ⧸ I) D) (_ : Algebra.Smooth (A ⧸ I) D) (c : Fin n → D) (γ : D →ₐ[A ⧸ I] Λ ⧸ I.map (algebraMap A Λ)), (∀ f ∈ s, MvPolynomial.aeval c f = 0) ∧ ∀ i, γ (c i) = b i) → ∀ (n : ℕ) (s : Finset (MvPolynomial (Fin n) A)) (b : Fin n → Λ), (∀ f ∈ s, MvPolynomial.aeval b f = 0) → ∀ (B : Type u) [CommRing B] [Algebra A B] [Algebra.Smooth A B] (c : Fin n → B) (ψ : B →ₐ[A] Λ), (∀ f ∈ s, MvPolynomial.aeval c f ∈ I.map (algebraMap A B)) → (∀ i, ψ (c i) = b i) → ∃ (D : Type u) (_ : CommRing D) (_ : Algebra A D) (_ : Algebra.Smooth A D) (c' : Fin n → D) (γ : D →ₐ[A] Λ), (∀ f ∈ s, MvPolynomial.aeval c' f = 0) ∧ ∀ i, γ (c' i) = b i :=
by
  intro happrox A _ Λ _ _ hF I hI hPT n s b hb B _ _ _ c ψ hc hψ
  classical

  have S1 : ∀ (B : Type u) [CommRing B] [Algebra A B] (ψ : B →ₐ[A] Λ) (h : B),
      h ∈ I.map (algebraMap A B) → ψ h = 0 →
      ∃ (k m : ℕ) (ε : Fin k → A) (r : Fin k → B) (a : Fin k → Fin m → A) (lam : Fin m → Λ),
        (∀ i, ε i ∈ I) ∧ h = ∑ i, ε i • r i ∧ (∀ i, ψ (r i) = ∑ j, a i j • lam j) ∧
          ∀ j, ∑ i, ε i * a i j = 0 := by
    intro B _ _ ψ h hh hψh
    have hh' : h ∈ Submodule.span B (algebraMap A B '' (I : Set A)) := hh
    rw [Submodule.mem_span_set'] at hh'
    obtain ⟨k, g, y, hy⟩ := hh'
    have hy' := fun i => (Set.mem_image _ _ _).mp (y i).2
    choose ε hεI hε using hy'
    have hsum : h = ∑ i, ε i • g i := by
      rw [← hy]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [smul_eq_mul, ← hε i, Algebra.smul_def, mul_comm]
    have hrel : ∑ i, ε i • ψ (g i) = 0 := by
      rw [← hψh, hsum, map_sum]
      exact Finset.sum_congr rfl fun i _ => (map_smul ψ (ε i) (g i)).symm
    obtain ⟨m, a, lam, h1, h2⟩ := Module.Flat.isTrivialRelation_of_sum_smul_eq_zero
      (R := A) (M := Λ) (f := ε) (x := fun i => ψ (g i)) hrel
    exact ⟨k, m, ε, g, a, lam, hεI, hsum, h1, h2⟩

  have S2 : ∀ (B : Type u) [CommRing B] [Algebra A B] [Algebra.FormallySmooth A B]
      (E : Type u) [CommRing E] [Algebra A E] (N : ℕ) (P : MvPolynomial (Fin N) A →ₐ[A] B),
      Function.Surjective P → ∀ (ψ : B →ₐ[A] Λ) (β : E →ₐ[A] Λ) (J : Ideal E), J ^ 2 = ⊥ →
      (∀ x ∈ J, β x = 0) → ∀ (v : Fin N → E),
      (∀ p ∈ RingHom.ker P, MvPolynomial.aeval v p ∈ J) →
      (∀ l, β (v l) = ψ (P (MvPolynomial.X l))) →
      ∃ α : B →ₐ[A] E, β.comp α = ψ ∧ ∀ q, α (P q) - MvPolynomial.aeval v q ∈ J := by
    intro B _ _ _ E _ _ N P hP ψ β J hJ hβJ v hv hvl
    let Φ : MvPolynomial (Fin N) A →ₐ[A] E ⧸ J :=
      (Ideal.Quotient.mkₐ A J).comp (MvPolynomial.aeval v)
    have hΦ : ∀ p ∈ RingHom.ker P, Φ p = 0 := by
      intro p hp
      simp only [Φ, AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr (hv p hp)
    let αb : B →ₐ[A] E ⧸ J := (Ideal.Quotient.liftₐ (RingHom.ker P) Φ hΦ).comp
      (Ideal.quotientKerAlgEquivOfSurjective hP).symm.toAlgHom
    have hαb : ∀ q, αb (P q) = Ideal.Quotient.mk J (MvPolynomial.aeval v q) := by
      intro q
      have he2 : Ideal.quotientKerAlgEquivOfSurjective hP (Ideal.Quotient.mk (RingHom.ker P) q)
          = P q := rfl
      rw [← he2]
      show Ideal.Quotient.liftₐ (RingHom.ker P) Φ hΦ ((Ideal.quotientKerAlgEquivOfSurjective hP).symm
        ((Ideal.quotientKerAlgEquivOfSurjective hP) (Ideal.Quotient.mk (RingHom.ker P) q))) = _
      rw [AlgEquiv.symm_apply_apply]
      rfl
    have hnil : IsNilpotent J := ⟨2, hJ.trans Ideal.zero_eq_bot.symm⟩
    let α := Algebra.FormallySmooth.lift J hnil αb
    have hα : ∀ q, α (P q) - MvPolynomial.aeval v q ∈ J := by
      intro q
      rw [← Ideal.Quotient.eq, Algebra.FormallySmooth.mk_lift, hαb]
    refine ⟨α, ?_, hα⟩
    apply AlgHom.ext
    intro x
    obtain ⟨q, rfl⟩ := hP x
    have h1 := hβJ _ (hα q)
    rw [map_sub, sub_eq_zero] at h1
    have hfun : (fun i => β (v i)) = ⇑(ψ.comp P) ∘ MvPolynomial.X := funext fun l => hvl l
    rw [AlgHom.comp_apply, h1, MvPolynomial.comp_aeval_apply, hfun,
      ← MvPolynomial.aeval_unique, AlgHom.comp_apply]

  have S5 : ∀ (B : Type u) [CommRing B] [Algebra A B] (N : ℕ)
      (P : MvPolynomial (Fin N) A →ₐ[A] B), Function.Surjective P → (RingHom.ker P).FG →
      ∀ (ψ : B →ₐ[A] Λ) (k m : ℕ) (r : Fin k → B) (a : Fin k → Fin m → A) (lam : Fin m → Λ),
      (∀ i, ψ (r i) = ∑ j, a i j • lam j) →
      ∃ (s' : Finset (MvPolynomial (Fin (N + m)) A)) (b' : Fin (N + m) → Λ),
        (∀ f ∈ s', MvPolynomial.aeval b' f = 0) ∧
        (∀ l, b' (Fin.castAdd m l) = ψ (P (MvPolynomial.X l))) ∧
        ∀ (E : Type u) [CommRing E] [Algebra A E] (K : Ideal E) (w : Fin (N + m) → E),
          (∀ f ∈ s', MvPolynomial.aeval w f ∈ K) →
          (∀ p ∈ RingHom.ker P, MvPolynomial.aeval (w ∘ Fin.castAdd m) p ∈ K) ∧
          ∀ i, ∃ q, P q = r i ∧
            MvPolynomial.aeval (w ∘ Fin.castAdd m) q - ∑ j, a i j • w (Fin.natAdd N j) ∈ K := by
    intro B _ _ N P hP hFG ψ k m r a lam hr
    obtain ⟨G, hG⟩ := hFG
    choose q hq using fun i => hP (r i)
    let lin : Fin k → MvPolynomial (Fin (N + m)) A := fun i =>
      MvPolynomial.rename (Fin.castAdd m) (q i) -
        ∑ j, MvPolynomial.C (a i j) * MvPolynomial.X (Fin.natAdd N j)
    have hlin : ∀ (E : Type u) [CommRing E] [Algebra A E] (w : Fin (N + m) → E) (i : Fin k),
        MvPolynomial.aeval w (lin i) =
          MvPolynomial.aeval (w ∘ Fin.castAdd m) (q i) - ∑ j, a i j • w (Fin.natAdd N j) := by
      intro E _ _ w i
      simp only [lin, map_sub, map_sum, map_mul, MvPolynomial.aeval_rename,
        MvPolynomial.aeval_C, MvPolynomial.aeval_X, Algebra.smul_def]
    let b' : Fin (N + m) → Λ := Fin.append (fun l => ψ (P (MvPolynomial.X l))) lam
    have hb'l : ∀ l, b' (Fin.castAdd m l) = ψ (P (MvPolynomial.X l)) := fun l => by
      simp only [b', Fin.append_left]
    have hb'r : ∀ j, b' (Fin.natAdd N j) = lam j := fun j => by
      simp only [b', Fin.append_right]
    have hcomp : b' ∘ Fin.castAdd m = ⇑(ψ.comp P) ∘ MvPolynomial.X :=
      funext fun l => hb'l l
    have hev : ∀ p, MvPolynomial.aeval (b' ∘ Fin.castAdd m) p = ψ (P p) := fun p => by
      rw [hcomp, ← MvPolynomial.aeval_unique, AlgHom.comp_apply]
    refine ⟨G.image (MvPolynomial.rename (Fin.castAdd m)) ∪ Finset.univ.image lin, b', ?_,
      hb'l, ?_⟩
    · intro f hf
      rcases Finset.mem_union.mp hf with hf | hf
      · obtain ⟨g, hg, rfl⟩ := Finset.mem_image.mp hf
        rw [MvPolynomial.aeval_rename, hev]
        have hgk : g ∈ RingHom.ker P := by
          rw [← hG]; exact Submodule.subset_span hg
        rw [RingHom.mem_ker] at hgk
        change P g = 0 at hgk
        rw [hgk, map_zero]
      · obtain ⟨i, -, rfl⟩ := Finset.mem_image.mp hf
        rw [hlin, hev, hq i, hr i, sub_eq_zero]
        exact Finset.sum_congr rfl fun j _ => by rw [hb'r]
    · intro E _ _ K w hw
      have hker : RingHom.ker P ≤ K.comap (MvPolynomial.aeval (w ∘ Fin.castAdd m)) := by
        rw [← hG]
        apply Submodule.span_le.mpr
        intro g hg
        have := hw _ (Finset.mem_union_left _ (Finset.mem_image_of_mem _ hg))
        rw [MvPolynomial.aeval_rename] at this
        exact this
      refine ⟨fun p hp => hker hp, fun i => ⟨q i, hq i, ?_⟩⟩
      rw [← hlin]
      exact hw _ (Finset.mem_union_right _ (Finset.mem_image_of_mem _ (Finset.mem_univ i)))

  have single : ∀ (B : Type u) [CommRing B] [Algebra A B] [Algebra.Smooth A B]
      (ψ : B →ₐ[A] Λ) (h : B), h ∈ I.map (algebraMap A B) → ψ h = 0 →
      ∃ (B' : Type u) (_ : CommRing B') (_ : Algebra A B') (_ : Algebra.Smooth A B')
        (α : B →ₐ[A] B') (β : B' →ₐ[A] Λ), β.comp α = ψ ∧ α h = 0 := by
    intro B _ _ _ ψ h hh hψh
    obtain ⟨k, m, ε, r, a, lam, hεI, hsum, hr, hrel0⟩ := S1 B ψ h hh hψh
    obtain ⟨N, P, hP, hFG⟩ := Algebra.FinitePresentation.out (R := A) (A := B)
    obtain ⟨s', b', hs'b', hb'l, U⟩ := S5 B N P hP hFG ψ k m r a lam hr
    obtain ⟨B'', _, _, _, w, β, hw, hβw⟩ := happrox A Λ I hI hPT (N + m) s' b' hs'b'
    let K : Ideal B'' := I.map (algebraMap A B'')
    let J : Ideal B'' := Ideal.span ((fun f => MvPolynomial.aeval w f) ''
      (↑s' : Set (MvPolynomial (Fin (N + m)) A)))
    have hJK : J ≤ K := by
      apply Ideal.span_le.mpr
      rintro _ ⟨f, hf, rfl⟩
      exact hw f hf
    have hK2 : K ^ 2 = ⊥ := by
      simp only [K]
      rw [← Ideal.map_pow, hI, Ideal.map_bot]
    have hJ2 : J ^ 2 = ⊥ := by
      apply le_bot_iff.mp
      rw [← hK2, pow_two, pow_two]
      exact Ideal.mul_mono hJK hJK
    have hβw' : (fun i => β (w i)) = b' := funext hβw
    have hβJ : ∀ x ∈ J, β x = 0 := by
      have hle : J ≤ RingHom.ker β := by
        apply Ideal.span_le.mpr
        rintro _ ⟨f, hf, rfl⟩
        show β (MvPolynomial.aeval w f) = 0
        rw [MvPolynomial.comp_aeval_apply, hβw']
        exact hs'b' f hf
      intro x hx
      exact hle hx
    have hwJ : ∀ f ∈ s', MvPolynomial.aeval w f ∈ J := fun f hf =>
      Ideal.subset_span ⟨f, hf, rfl⟩
    obtain ⟨U1, U2⟩ := U B'' J w hwJ
    obtain ⟨α, hαβ, hαq⟩ := S2 B B'' N P hP ψ β J hJ2 hβJ (w ∘ Fin.castAdd m) U1
      (fun l => (hβw _).trans (hb'l l))
    choose qq hqq1 hqq2 using U2
    have hθ : ∀ i, ε i • α (r i) = ∑ j, (ε i * a i j) • w (Fin.natAdd N j) := by
      intro i
      have hmem : α (r i) - ∑ j, a i j • w (Fin.natAdd N j) ∈ J := by
        have := J.add_mem (hαq (qq i)) (hqq2 i)
        rw [hqq1 i] at this
        convert this using 1
        ring
      have hz : ε i • (α (r i) - ∑ j, a i j • w (Fin.natAdd N j)) = 0 := by
        rw [Algebra.smul_def]
        have hm2 : algebraMap A B'' (ε i) * (α (r i) - ∑ j, a i j • w (Fin.natAdd N j)) ∈
            K ^ 2 := by
          rw [pow_two]
          exact Ideal.mul_mem_mul (Ideal.mem_map_of_mem _ (hεI i)) (hJK hmem)
        rw [hK2] at hm2
        exact (Submodule.mem_bot _).mp hm2
      rw [smul_sub, sub_eq_zero] at hz
      rw [hz, Finset.smul_sum]
      simp only [smul_smul]
    have hαh : α h = 0 := by
      rw [hsum, map_sum]
      simp only [map_smul]
      rw [Finset.sum_congr rfl (fun i _ => hθ i), Finset.sum_comm]
      simp only [← Finset.sum_smul, hrel0, zero_smul, Finset.sum_const_zero]
    exact ⟨B'', inferInstance, inferInstance, inferInstance, α, β, hαβ, hαh⟩

  have multi : ∀ (S : Finset B), (∀ h ∈ S, h ∈ I.map (algebraMap A B) ∧ ψ h = 0) →
      ∃ (B' : Type u) (_ : CommRing B') (_ : Algebra A B') (_ : Algebra.Smooth A B')
        (α : B →ₐ[A] B') (β : B' →ₐ[A] Λ), β.comp α = ψ ∧ ∀ h ∈ S, α h = 0 := by
    intro S
    induction S using Finset.induction_on with
    | empty =>
      intro _
      exact ⟨B, inferInstance, inferInstance, inferInstance, AlgHom.id A B, ψ,
        AlgHom.comp_id ψ, fun h hh => absurd hh (Finset.notMem_empty h)⟩
    | insert h₀ S₀ _ ih =>
      intro hS
      obtain ⟨B₁, _, _, _, α₁, β₁, hβα₁, hα₁⟩ :=
        ih (fun h hh => hS h (Finset.mem_insert_of_mem hh))
      obtain ⟨hh₀I, hh₀ψ⟩ := hS h₀ (Finset.mem_insert_self _ _)
      have hmem : α₁ h₀ ∈ I.map (algebraMap A B₁) := by
        have := Ideal.mem_map_of_mem (α₁ : B →+* B₁) hh₀I
        rw [Ideal.map_map, AlgHom.comp_algebraMap] at this
        exact this
      have hψ₁ : β₁ (α₁ h₀) = 0 := by
        rw [← AlgHom.comp_apply, hβα₁]
        exact hh₀ψ
      obtain ⟨B₂, _, _, _, α₂, β₂, hβα₂, hα₂⟩ := single B₁ β₁ (α₁ h₀) hmem hψ₁
      refine ⟨B₂, inferInstance, inferInstance, inferInstance, α₂.comp α₁, β₂, ?_, ?_⟩
      · rw [← AlgHom.comp_assoc, hβα₂, hβα₁]
      · intro h hh
        rcases Finset.mem_insert.mp hh with rfl | hh
        · rw [AlgHom.comp_apply]
          exact hα₂
        · rw [AlgHom.comp_apply, hα₁ h hh, map_zero]

  obtain ⟨B', _, _, _, α, β, hβα, hα⟩ := multi (s.image fun f => MvPolynomial.aeval c f) (by
    intro h hh
    obtain ⟨f, hf, rfl⟩ := Finset.mem_image.mp hh
    refine ⟨hc f hf, ?_⟩
    rw [MvPolynomial.comp_aeval_apply, show (fun i => ψ (c i)) = b from funext hψ]
    exact hb f hf)
  refine ⟨B', inferInstance, inferInstance, inferInstance, fun i => α (c i), β, ?_, ?_⟩
  · intro f hf
    rw [← MvPolynomial.comp_aeval_apply]
    exact hα _ (Finset.mem_image_of_mem _ hf)
  · intro i
    rw [← AlgHom.comp_apply, hβα, hψ]

theorem wc_pfc_pt_finite_product : ∀ (Q : Type u) [CommRing Q] (Λ : Type u) [CommRing Λ] [Algebra Q Λ] (r : ℕ) (e : Fin r → Q), ∑ i, e i = 1 → (∀ i j, i ≠ j → e i * e j = 0) → (∀ i, e i * e i = e i) → (∀ i, ∀ (n : ℕ) (s : Finset (MvPolynomial (Fin n) (Q ⧸ Ideal.span {1 - e i}))) (b : Fin n → Λ ⧸ (Ideal.span {1 - e i}).map (algebraMap Q Λ)), (∀ f ∈ s, MvPolynomial.aeval b f = 0) → ∃ (D : Type u) (_ : CommRing D) (_ : Algebra (Q ⧸ Ideal.span {1 - e i}) D) (_ : Algebra.Smooth (Q ⧸ Ideal.span {1 - e i}) D) (c : Fin n → D) (γ : D →ₐ[Q ⧸ Ideal.span {1 - e i}] Λ ⧸ (Ideal.span {1 - e i}).map (algebraMap Q Λ)), (∀ f ∈ s, MvPolynomial.aeval c f = 0) ∧ ∀ k, γ (c k) = b k) → ∀ (n : ℕ) (s : Finset (MvPolynomial (Fin n) Q)) (b : Fin n → Λ), (∀ f ∈ s, MvPolynomial.aeval b f = 0) → ∃ (D : Type u) (_ : CommRing D) (_ : Algebra Q D) (_ : Algebra.Smooth Q D) (c : Fin n → D) (γ : D →ₐ[Q] Λ), (∀ f ∈ s, MvPolynomial.aeval c f = 0) ∧ ∀ k, γ (c k) = b k :=
by
  intro Q _ Λ _ _ r e hsum horth hidem H n s b hb
  classical

  have hJ : ∀ i (x : Λ), x ∈ (Ideal.span {1 - e i}).map (algebraMap Q Λ) →
      x * algebraMap Q Λ (e i) = 0 := by
    intro i x hx
    rw [Ideal.map_span, Set.image_singleton] at hx
    obtain ⟨a, rfl⟩ := Ideal.mem_span_singleton'.mp hx
    rw [mul_assoc, ← map_mul, sub_mul, one_mul, hidem i, sub_self, map_zero, mul_zero]

  have hE : ∀ i j, j ≠ i → algebraMap Q Λ (e j) ∈ (Ideal.span {1 - e i}).map (algebraMap Q Λ) := by
    intro i j hji
    apply Ideal.mem_map_of_mem
    exact Ideal.mem_span_singleton'.mpr ⟨e j, by rw [mul_sub, mul_one, horth j i hji, sub_zero]⟩
  have h1 : ∑ j, algebraMap Q Λ (e j) = 1 := by rw [← map_sum, hsum, map_one]

  let Φ := AlgHom.pi (fun i => Ideal.Quotient.mkₐ Q ((Ideal.span {1 - e i}).map (algebraMap Q Λ)))
  have hΦ : Function.Bijective Φ := by
    constructor
    · rw [injective_iff_map_eq_zero]
      intro x hx
      have hxi : ∀ i, x ∈ (Ideal.span {1 - e i}).map (algebraMap Q Λ) := by
        intro i
        have := congrFun hx i
        rw [AlgHom.pi_apply, Ideal.Quotient.mkₐ_eq_mk, Pi.zero_apply,
          Ideal.Quotient.eq_zero_iff_mem] at this
        exact this
      calc x = x * ∑ j, algebraMap Q Λ (e j) := by rw [h1, mul_one]
        _ = ∑ j, x * algebraMap Q Λ (e j) := by rw [Finset.mul_sum]
        _ = 0 := Finset.sum_eq_zero (fun j _ => hJ j x (hxi j))
    · intro y
      choose z hz using fun i => Ideal.Quotient.mk_surjective (y i)
      refine ⟨∑ j, algebraMap Q Λ (e j) * z j, ?_⟩
      funext i
      rw [AlgHom.pi_apply, Ideal.Quotient.mkₐ_eq_mk, ← hz i, Ideal.Quotient.eq]
      have hx : ∑ j, algebraMap Q Λ (e j) * z j - z i
          = ∑ j, algebraMap Q Λ (e j) * (z j - z i) := by
        simp only [mul_sub, Finset.sum_sub_distrib, ← Finset.sum_mul, h1, one_mul]
      rw [hx]
      apply Ideal.sum_mem
      intro j _
      by_cases hji : j = i
      · rw [hji, sub_self, mul_zero]
        exact Ideal.zero_mem _
      · exact Ideal.mul_mem_right _ _ (hE i j hji)

  haveI hloc : ∀ i, IsLocalization.Away (e i) (Q ⧸ Ideal.span {1 - e i}) := fun i =>
    IsLocalization.away_of_isIdempotentElem (hidem i)
      (by rw [Ideal.Quotient.algebraMap_eq, Ideal.mk_ker])
      (by rw [Ideal.Quotient.algebraMap_eq]; exact Ideal.Quotient.mk_surjective)
  haveI hsmQ : ∀ i, Algebra.Smooth Q (Q ⧸ Ideal.span {1 - e i}) := fun i =>
    Algebra.Smooth.of_isLocalization_Away (e i)

  have hred : ∀ i, ∀ g ∈ s.image (MvPolynomial.map (algebraMap Q (Q ⧸ Ideal.span {1 - e i}))),
      MvPolynomial.aeval (fun k => Ideal.Quotient.mk ((Ideal.span {1 - e i}).map (algebraMap Q Λ))
        (b k)) g = 0 := by
    intro i g hg
    obtain ⟨f, hf, rfl⟩ := Finset.mem_image.mp hg
    rw [MvPolynomial.aeval_map_algebraMap]
    have := MvPolynomial.comp_aeval_apply b
      (Ideal.Quotient.mkₐ Q ((Ideal.span {1 - e i}).map (algebraMap Q Λ))) f
    rw [hb f hf, map_zero] at this
    simpa only [Ideal.Quotient.mkₐ_eq_mk] using this.symm
  choose D instR instA instS c γ hc hγ using fun i => H i n _ _ (hred i)
  letI : ∀ i, CommRing (D i) := instR
  letI : ∀ i, Algebra (Q ⧸ Ideal.span {1 - e i}) (D i) := instA
  haveI : ∀ i, Algebra.Smooth (Q ⧸ Ideal.span {1 - e i}) (D i) := instS
  letI instQ : ∀ i, Algebra Q (D i) := fun i =>
    ((algebraMap (Q ⧸ Ideal.span {1 - e i}) (D i)).comp
      (algebraMap Q (Q ⧸ Ideal.span {1 - e i}))).toAlgebra
  haveI htow : ∀ i, IsScalarTower Q (Q ⧸ Ideal.span {1 - e i}) (D i) := fun i =>
    IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  haveI hsmD : ∀ i, Algebra.Smooth Q (D i) := fun i =>
    Algebra.Smooth.comp Q (Q ⧸ Ideal.span {1 - e i}) (D i)
  haveI hsmP : Algebra.Smooth Q ((i : Fin r) → D i) := by
    haveI : Algebra.FormallySmooth Q ((i : Fin r) → D i) :=
      (Algebra.FormallySmooth.pi_iff D).mpr (fun i => inferInstance)
    haveI : Algebra.FinitePresentation Q ((i : Fin r) → D i) := Algebra.FinitePresentation.pi D
    constructor <;> infer_instance
  let Γ : ((i : Fin r) → D i) →ₐ[Q]
      ((i : Fin r) → Λ ⧸ (Ideal.span {1 - e i}).map (algebraMap Q Λ)) :=
    AlgHom.pi (fun i => ((γ i).restrictScalars Q).comp (Pi.evalAlgHom Q D i))
  refine ⟨(i : Fin r) → D i, inferInstance, inferInstance, hsmP, fun k i => c i k,
    ((AlgEquiv.ofBijective Φ hΦ).symm : _ →ₐ[Q] Λ).comp Γ, ?_, ?_⟩
  · intro f hf
    funext i
    have h2 := MvPolynomial.comp_aeval_apply (fun k i => c i k) (Pi.evalAlgHom Q D i) f
    rw [Pi.evalAlgHom_apply] at h2
    rw [Pi.zero_apply, h2]
    simp only [Pi.evalAlgHom_apply]
    have h3 := hc i _ (Finset.mem_image_of_mem _ hf)
    rw [MvPolynomial.aeval_map_algebraMap] at h3
    exact h3
  · intro k
    rw [AlgHom.comp_apply, AlgEquiv.coe_algHom, AlgEquiv.symm_apply_eq, AlgEquiv.ofBijective_apply]
    funext i
    simp only [Γ, Φ, AlgHom.pi_apply, AlgHom.comp_apply, Pi.evalAlgHom_apply,
      AlgHom.restrictScalars_apply, Ideal.Quotient.mkₐ_eq_mk]
    exact hγ i k

theorem wc_pfc_total_fractions_factors : (∀ (k : Type u) [Field k] (Λ : Type u) [CommRing Λ] [IsNoetherianRing Λ] [Algebra k Λ], (∀ (L : Type u) [Field L] [Algebra k L] [FiniteDimensional k L] (𝔔 : Ideal (TensorProduct k L Λ)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) → ∀ (n : ℕ) (s : Finset (MvPolynomial (Fin n) k)) (b : Fin n → Λ), (∀ f ∈ s, MvPolynomial.aeval b f = 0) → ∃ (D : Type u) (_ : CommRing D) (_ : Algebra k D) (_ : Algebra.Smooth k D) (c : Fin n → D) (γ : D →ₐ[k] Λ), (∀ f ∈ s, MvPolynomial.aeval c f = 0) ∧ ∀ i, γ (c i) = b i) → ∀ (A : Type u) [CommRing A] [IsNoetherianRing A] [IsReduced A] (Λ : Type u) [CommRing Λ] [IsNoetherianRing Λ] [Algebra A Λ], Module.Flat A Λ → (∀ (𝔭 : Ideal A) [𝔭.IsPrime] (L : Type u) [Field L] [Algebra A L] [Algebra 𝔭.ResidueField L] [IsScalarTower A 𝔭.ResidueField L] [FiniteDimensional 𝔭.ResidueField L] (𝔔 : Ideal (TensorProduct A L Λ)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) → ∃ (r : ℕ) (e : Fin r → Localization (nonZeroDivisors A)), ∑ i, e i = 1 ∧ (∀ i j, i ≠ j → e i * e j = 0) ∧ (∀ i, e i * e i = e i) ∧ ∀ i, ∀ (n : ℕ) (s : Finset (MvPolynomial (Fin n) (Localization (nonZeroDivisors A) ⧸ Ideal.span {1 - e i}))) (b : Fin n → Localization (Algebra.algebraMapSubmonoid Λ (nonZeroDivisors A)) ⧸ (Ideal.span {1 - e i}).map (algebraMap (Localization (nonZeroDivisors A)) (Localization (Algebra.algebraMapSubmonoid Λ (nonZeroDivisors A))))), (∀ f ∈ s, MvPolynomial.aeval b f = 0) → ∃ (D : Type u) (_ : CommRing D) (_ : Algebra (Localization (nonZeroDivisors A) ⧸ Ideal.span {1 - e i}) D) (_ : Algebra.Smooth (Localization (nonZeroDivisors A) ⧸ Ideal.span {1 - e i}) D) (c : Fin n → D) (γ : D →ₐ[Localization (nonZeroDivisors A) ⧸ Ideal.span {1 - e i}] Localization (Algebra.algebraMapSubmonoid Λ (nonZeroDivisors A)) ⧸ (Ideal.span {1 - e i}).map (algebraMap (Localization (nonZeroDivisors A)) (Localization (Algebra.algebraMapSubmonoid Λ (nonZeroDivisors A))))), (∀ f ∈ s, MvPolynomial.aeval c f = 0) ∧ ∀ k, γ (c k) = b k :=
by
  intro FIELD A _ _ _ Λ _ _ _ _ hR
  classical

  have s1 : ∀ (R : Type u) [CommRing R] [IsNoetherianRing R] [IsReduced R] (𝔭 : Ideal R),
      𝔭.IsPrime → Disjoint (𝔭 : Set R) (nonZeroDivisors R : Set R) →
      ∀ 𝔮 : Ideal R, 𝔮.IsPrime → 𝔮 ≤ 𝔭 → 𝔮 = 𝔭 := by
    intro R _ _ _ 𝔭 h𝔭 hdisj 𝔮 h𝔮 hle
    have hfin : (⊥ : Ideal R).minimalPrimes.Finite :=
      Ideal.finite_minimalPrimes_of_isNoetherianRing R ⊥
    have hp : ∀ P ∈ hfin.toFinset, P ≠ ⊥ → P ≠ ⊥ → (id P : Ideal R).IsPrime := by
      intro P hP _ _
      exact (hfin.mem_toFinset.mp hP).1.1
    obtain ⟨P, hPs, hle'⟩ := (Ideal.subset_union_prime (s := hfin.toFinset) (f := id)
      (⊥ : Ideal R) (⊥ : Ideal R) hp (I := 𝔭)).mp (by
        intro x hx
        have hx' : x ∉ nonZeroDivisors R := fun h => Set.disjoint_left.mp hdisj hx h
        have hy : ∃ y : R, y ≠ 0 ∧ y * x = 0 := by
          by_contra hcon
          push_neg at hcon
          apply hx'
          rw [mem_nonZeroDivisors_iff_right]
          intro y hyx
          by_contra hy0
          exact hcon y hy0 hyx
        obtain ⟨y, hy0, hyx⟩ := hy
        have hyn : y ∉ sInf (⊥ : Ideal R).minimalPrimes := by
          rw [Ideal.sInf_minimalPrimes, Ideal.radical_bot_of_isReduced]
          exact hy0
        rw [Ideal.mem_sInf] at hyn
        push_neg at hyn
        obtain ⟨Q, hQ, hyQ⟩ := hyn
        have hmem : y * x ∈ Q := by rw [hyx]; exact Q.zero_mem
        have hxQ : x ∈ Q := (hQ.1.1.mem_or_mem hmem).resolve_left hyQ
        simp only [Set.mem_iUnion]
        exact ⟨Q, hfin.mem_toFinset.mpr hQ, hxQ⟩)
    have hP : Minimal (fun q : Ideal R => q.IsPrime ∧ ⊥ ≤ q) P := hfin.mem_toFinset.mp hPs
    have hqP : 𝔮 = P := hP.eq_of_le ⟨h𝔮, bot_le⟩ (hle.trans hle')
    exact le_antisymm hle (hle'.trans hqP.ge)

  have s2 : ∀ (R : Type u) [CommRing R] [IsNoetherianRing R] [IsReduced R],
      IsArtinianRing (Localization (nonZeroDivisors R)) ∧
        IsReduced (Localization (nonZeroDivisors R)) := by
    intro R _ _ _
    refine ⟨?_, isReduced_localizationPreserves (nonZeroDivisors R) _ ‹_›⟩
    haveI : IsNoetherianRing (Localization (nonZeroDivisors R)) :=
      IsLocalization.isNoetherianRing (nonZeroDivisors R) _ ‹_›
    have H : ∀ P : Ideal (Localization (nonZeroDivisors R)), P.IsPrime → P.IsMaximal := by
      intro P hP
      obtain ⟨M, hM, hPM⟩ := Ideal.exists_le_maximal P hP.ne_top
      have hMp := (IsLocalization.isPrime_iff_isPrime_disjoint (nonZeroDivisors R)
        (Localization (nonZeroDivisors R)) M).mp hM.isPrime
      have hPp := (IsLocalization.isPrime_iff_isPrime_disjoint (nonZeroDivisors R)
        (Localization (nonZeroDivisors R)) P).mp hP
      have heq := s1 R _ hMp.1 hMp.2.symm _ hPp.1 (Ideal.comap_mono hPM)
      have hPM' : P = M := by
        rw [← IsLocalization.map_comap (nonZeroDivisors R) (Localization (nonZeroDivisors R)) P,
          ← IsLocalization.map_comap (nonZeroDivisors R) (Localization (nonZeroDivisors R)) M, heq]
      rw [hPM']
      exact hM
    haveI : Ring.KrullDimLE 0 (Localization (nonZeroDivisors R)) := Ring.KrullDimLE.mk₀ H
    exact isArtinianRing_iff_isNoetherianRing_krullDimLE_zero.mpr ⟨inferInstance, inferInstance⟩

  have s3 : ∀ (R : Type u) [CommRing R] [IsArtinianRing R] [IsReduced R],
      ∃ (r : ℕ) (e : Fin r → R), ∑ i, e i = 1 ∧ (∀ i j, i ≠ j → e i * e j = 0) ∧
        (∀ i, e i * e i = e i) ∧ ∀ i, (Ideal.span {1 - e i}).IsMaximal := by
    intro R _ _ _
    let Φ := IsArtinianRing.equivPi R
    let σ := Finite.equivFin (MaximalSpectrum R)
    let e : Fin (Nat.card (MaximalSpectrum R)) → R :=
      fun k => Φ.symm (Pi.single (σ.symm k) 1)
    have hΦe : ∀ k J, Φ (e k) J = if J = σ.symm k then 1 else 0 := by
      intro k J
      simp only [e, AlgEquiv.apply_symm_apply]
      split_ifs with h
      · subst h
        exact Pi.single_eq_same _ _
      · exact Pi.single_eq_of_ne h _
    refine ⟨Nat.card (MaximalSpectrum R), e, ?_, ?_, ?_, ?_⟩
    · apply Φ.injective
      rw [map_sum, map_one]
      funext J
      rw [Finset.sum_apply]
      simp only [hΦe]
      rw [Finset.sum_eq_single (σ J)]
      · simp
      · intro k _ hk
        rw [if_neg]
        intro h
        apply hk
        rw [h, Equiv.apply_symm_apply]
      · intro h
        exact absurd (Finset.mem_univ _) h
    · intro i j hij
      apply Φ.injective
      rw [map_mul, map_zero]
      funext J
      rw [Pi.mul_apply, hΦe, hΦe, Pi.zero_apply]
      split_ifs with h1 h2
      · exact absurd (σ.symm.injective (h1.symm.trans h2)) hij
      · simp
      · simp
      · simp
    · intro i
      apply Φ.injective
      rw [map_mul]
      funext J
      rw [Pi.mul_apply, hΦe]
      split_ifs <;> simp
    · intro k
      have hspan : Ideal.span {1 - e k} = (σ.symm k).asIdeal := by
        apply le_antisymm
        · rw [Ideal.span_singleton_le_iff_mem, ← Ideal.Quotient.eq_zero_iff_mem,
            ← IsArtinianRing.equivPi_apply]
          change Φ (1 - e k) (σ.symm k) = 0
          rw [map_sub, map_one, Pi.sub_apply, hΦe, if_pos rfl, Pi.one_apply, sub_self]
        · intro x hx
          rw [Ideal.mem_span_singleton']
          refine ⟨x, ?_⟩
          apply Φ.injective
          funext J
          rw [map_mul, Pi.mul_apply, map_sub, map_one, Pi.sub_apply, hΦe]
          split_ifs with h
          · subst h
            have h0 : Φ x (σ.symm k) = 0 := by
              change IsArtinianRing.equivPi R x (σ.symm k) = 0
              rw [IsArtinianRing.equivPi_apply, Ideal.Quotient.eq_zero_iff_mem]
              exact hx
            rw [h0]
            simp
          · simp
      rw [hspan]
      exact (σ.symm k).isMaximal

  have s4 : ∀ (R : Type u) [CommRing R] (B : Type u) [CommRing B] [Algebra R B] (S : Submonoid R)
      (I : Ideal (Localization S)),
      Nonempty (TensorProduct R (Localization S ⧸ I) B ≃ₐ[Localization S ⧸ I]
        Localization (Algebra.algebraMapSubmonoid B S) ⧸
          I.map (algebraMap (Localization S) (Localization (Algebra.algebraMapSubmonoid B S)))) := by
    intro R _ B _ _ S I
    haveI : IsLocalizedModule S (IsScalarTower.toAlgHom R B
        (Localization (Algebra.algebraMapSubmonoid B S))).toLinearMap :=
      isLocalizedModule_iff_isLocalization.mpr inferInstance
    haveI : Algebra.IsPushout R (Localization S) B
        (Localization (Algebra.algebraMapSubmonoid B S)) :=
      (Algebra.isPushout_iff _ _ _ _).mpr (IsLocalizedModule.isBaseChange S (Localization S) _)
    let P := Algebra.IsPushout.equiv R (Localization S) B
      (Localization (Algebra.algebraMapSubmonoid B S))
    let E2 := AlgEquiv.extendScalarsOfSurjective (R := Localization S) (S := Localization S ⧸ I)
      Ideal.Quotient.mk_surjective
      (((Algebra.TensorProduct.quotIdealMapEquivTensorQuot
        (Localization (Algebra.algebraMapSubmonoid B S)) I).restrictScalars (Localization S)).trans
        (Algebra.TensorProduct.comm (Localization S)
          (Localization (Algebra.algebraMapSubmonoid B S)) (Localization S ⧸ I)))
    let E3 := Algebra.TensorProduct.congr
      (AlgEquiv.refl : (Localization S ⧸ I) ≃ₐ[Localization S ⧸ I] (Localization S ⧸ I)) P.symm
    let E4 := Algebra.TensorProduct.cancelBaseChange R (Localization S) (Localization S ⧸ I)
      (Localization S ⧸ I) B
    exact ⟨(E2.trans (E3.trans E4)).symm⟩

  have s5 : ∀ (R : Type u) [CommRing R] (S : Submonoid R) (𝔪 : Ideal (Localization S)) [𝔪.IsMaximal],
      ∃ ψ : (𝔪.comap (algebraMap R (Localization S))).ResidueField →+* Localization S ⧸ 𝔪,
        Function.Surjective ψ ∧ ∀ a : R,
          ψ (algebraMap R (𝔪.comap (algebraMap R (Localization S))).ResidueField a) =
            algebraMap R (Localization S ⧸ 𝔪) a := by
    intro R _ S 𝔪 _
    let μ := Ideal.ResidueField.map (𝔪.comap (algebraMap R (Localization S))) 𝔪
      (algebraMap R (Localization S)) rfl
    have hμ : Function.Bijective μ :=
      RingHom.SurjectiveOnStalks.residueFieldMap_bijective
        (RingHom.surjectiveOnStalks_of_isLocalization S (Localization S)) _ 𝔪 rfl
    have hβ : Function.Bijective (algebraMap (Localization S ⧸ 𝔪) 𝔪.ResidueField) :=
      Ideal.bijective_algebraMap_quotient_residueField 𝔪
    let β := RingEquiv.ofBijective (algebraMap (Localization S ⧸ 𝔪) 𝔪.ResidueField) hβ
    refine ⟨β.symm.toRingHom.comp μ, β.symm.surjective.comp hμ.2, fun a => ?_⟩
    apply β.injective
    simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingHom.coe_coe,
      RingEquiv.apply_symm_apply]
    rw [Ideal.ResidueField.map_algebraMap]
    rfl

  have s6 : ∀ (R : Type u) [CommRing R] (B : Type u) [CommRing B] [Algebra R B],
      (∀ (𝔭 : Ideal R) [𝔭.IsPrime] (L : Type u) [Field L] [Algebra R L] [Algebra 𝔭.ResidueField L]
        [IsScalarTower R 𝔭.ResidueField L] [FiniteDimensional 𝔭.ResidueField L]
        (𝔔 : Ideal (TensorProduct R L B)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) →
      ∀ (𝔭 : Ideal R) [𝔭.IsPrime] (k : Type u) [Field k] [Algebra R k] [Algebra 𝔭.ResidueField k]
        [IsScalarTower R 𝔭.ResidueField k] [FiniteDimensional 𝔭.ResidueField k]
        (B' : Type u) [CommRing B'] [Algebra k B'], Nonempty (TensorProduct R k B ≃ₐ[k] B') →
      ∀ (L : Type u) [Field L] [Algebra k L] [FiniteDimensional k L]
        (𝔔 : Ideal (TensorProduct k L B')) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔) := by
    intro R _ B _ _ hRB 𝔭 _ k _ _ _ _ _ B' _ _ hT L _ _ _ 𝔔 _
    obtain ⟨T⟩ := hT
    letI iAL : Algebra R L := ((algebraMap k L).comp (algebraMap R k)).toAlgebra
    letI iKL : Algebra 𝔭.ResidueField L :=
      ((algebraMap k L).comp (algebraMap 𝔭.ResidueField k)).toAlgebra
    haveI t1 : IsScalarTower R k L := IsScalarTower.of_algebraMap_eq' rfl
    haveI t0 : IsScalarTower 𝔭.ResidueField k L := IsScalarTower.of_algebraMap_eq' rfl
    haveI t2 : IsScalarTower R 𝔭.ResidueField L := by
      refine IsScalarTower.of_algebraMap_eq (fun a => ?_)
      show algebraMap k L (algebraMap R k a) = _
      rw [IsScalarTower.algebraMap_apply R 𝔭.ResidueField k a]
      rfl
    haveI t3 : FiniteDimensional 𝔭.ResidueField L := Module.Finite.trans k L
    let Ψ : TensorProduct R L B ≃+* TensorProduct k L B' :=
      ((Algebra.TensorProduct.cancelBaseChange R k k L B).symm.trans
        (Algebra.TensorProduct.congr (AlgEquiv.refl : L ≃ₐ[k] L) T)).toRingEquiv
    have hreg := hRB 𝔭 L (𝔔.comap Ψ)
    have H : Submonoid.map Ψ.toMonoidHom (𝔔.comap Ψ).primeCompl = 𝔔.primeCompl := by
      ext y
      constructor
      · rintro ⟨x, hx, rfl⟩
        exact hx
      · intro hy
        refine ⟨Ψ.symm y, ?_, ?_⟩
        · show Ψ (Ψ.symm y) ∉ 𝔔
          rw [RingEquiv.apply_symm_apply]
          exact hy
        · show Ψ (Ψ.symm y) = y
          exact RingEquiv.apply_symm_apply Ψ y
    haveI := hreg
    exact IsRegularLocalRing.of_ringEquiv
      (IsLocalization.ringEquivOfRingEquiv (Localization.AtPrime (𝔔.comap Ψ))
        (Localization.AtPrime 𝔔) Ψ H)

  have fin : ∀ (R : Type u) [CommRing R] (B : Type u) [CommRing B] [IsNoetherianRing B]
      [Algebra R B],
      (∀ (𝔭 : Ideal R) [𝔭.IsPrime] (L : Type u) [Field L] [Algebra R L] [Algebra 𝔭.ResidueField L]
        [IsScalarTower R 𝔭.ResidueField L] [FiniteDimensional 𝔭.ResidueField L]
        (𝔔 : Ideal (TensorProduct R L B)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) →
      ∀ (S : Submonoid R) (𝔪 : Ideal (Localization S)) [𝔪.IsMaximal],
      ∀ (n : ℕ) (s : Finset (MvPolynomial (Fin n) (Localization S ⧸ 𝔪)))
        (b : Fin n → Localization (Algebra.algebraMapSubmonoid B S) ⧸
          𝔪.map (algebraMap (Localization S) (Localization (Algebra.algebraMapSubmonoid B S)))),
        (∀ f ∈ s, MvPolynomial.aeval b f = 0) →
        ∃ (D : Type u) (_ : CommRing D) (_ : Algebra (Localization S ⧸ 𝔪) D)
          (_ : Algebra.Smooth (Localization S ⧸ 𝔪) D) (c : Fin n → D)
          (γ : D →ₐ[Localization S ⧸ 𝔪] Localization (Algebra.algebraMapSubmonoid B S) ⧸
            𝔪.map (algebraMap (Localization S) (Localization (Algebra.algebraMapSubmonoid B S)))),
          (∀ f ∈ s, MvPolynomial.aeval c f = 0) ∧ ∀ k, γ (c k) = b k := by
    intro R _ B _ _ _ hRB S 𝔪 _
    haveI : IsNoetherianRing (Localization (Algebra.algebraMapSubmonoid B S)) :=
      IsLocalization.isNoetherianRing (Algebra.algebraMapSubmonoid B S) _ ‹_›
    obtain ⟨ψ, hψs, hψc⟩ := s5 R S 𝔪
    obtain ⟨T⟩ := s4 R B S 𝔪
    letI : Field (Localization S ⧸ 𝔪) := Ideal.Quotient.field 𝔪
    letI : Algebra (𝔪.comap (algebraMap R (Localization S))).ResidueField (Localization S ⧸ 𝔪) :=
      ψ.toAlgebra
    haveI : IsScalarTower R (𝔪.comap (algebraMap R (Localization S))).ResidueField
        (Localization S ⧸ 𝔪) :=
      IsScalarTower.of_algebraMap_eq (fun a => (hψc a).symm)
    haveI : FiniteDimensional (𝔪.comap (algebraMap R (Localization S))).ResidueField
        (Localization S ⧸ 𝔪) :=
      RingHom.Finite.of_surjective ψ hψs
    have hreg := s6 R B hRB (𝔪.comap (algebraMap R (Localization S))) (Localization S ⧸ 𝔪)
      (Localization (Algebra.algebraMapSubmonoid B S) ⧸
        𝔪.map (algebraMap (Localization S) (Localization (Algebra.algebraMapSubmonoid B S)))) ⟨T⟩
    exact FIELD _ _ hreg
  obtain ⟨hArt, hRed⟩ := s2 A
  obtain ⟨r, e, h1, horth, hidem, hmax⟩ := @s3 (Localization (nonZeroDivisors A)) _ hArt hRed
  refine ⟨r, e, h1, horth, hidem, fun i => ?_⟩
  haveI := hmax i
  exact fin A Λ hR (nonZeroDivisors A) (Ideal.span {1 - e i})

theorem wc_pfc_smooth_std_retract : ∀ (R : Type u) [CommRing R] (D : Type u) [CommRing D] [Algebra R D] [Algebra.Smooth R D], ∃ (N c : ℕ) (hc : c ≤ N) (f : Fin c → MvPolynomial (Fin N) R) (α : D →ₐ[R] MvPolynomial (Fin N) R ⧸ Ideal.span (Set.range f)) (β : (MvPolynomial (Fin N) R ⧸ Ideal.span (Set.range f)) →ₐ[R] D), β.comp α = AlgHom.id R D ∧ IsUnit (Ideal.Quotient.mk (Ideal.span (Set.range f)) (Matrix.of fun i j : Fin c => MvPolynomial.pderiv (Fin.castLE hc i) (f j)).det) :=
by
  have wc_pfc_ssr_split_differentials : ∀ (R : Type u) [CommRing R] (D : Type u) [CommRing D] [Algebra R D] [Algebra.Smooth R D], ∃ (n : ℕ) (x : Fin n → D) (s : Ω[D⁄R] →ₗ[D] (Fin n → D)), ∀ ω : Ω[D⁄R], ∑ m, s ω m • KaehlerDifferential.D R D (x m) = ω := by
    intro R _ D _ _ _
    classical
    obtain ⟨t, ht⟩ := Algebra.FiniteType.out (R := R) (A := D)
    let x : Fin t.card → D := fun i => (t.equivFin.symm i : D)
    have hx : Set.range x = (t : Set D) := by
      ext a
      constructor
      · rintro ⟨i, rfl⟩
        exact (t.equivFin.symm i).2
      · intro ha
        exact ⟨t.equivFin ⟨a, ha⟩, by simp [x]⟩
    let π : (Fin t.card → D) →ₗ[D] Ω[D⁄R] :=
      Fintype.linearCombination D (fun m => KaehlerDifferential.D R D (x m))
    set M := Submodule.span D (Set.range fun m => KaehlerDifferential.D R D (x m)) with hM
    have hall : ∀ a : D, KaehlerDifferential.D R D a ∈ M := by
      intro a
      have ha : a ∈ Algebra.adjoin R (t : Set D) := by rw [ht]; trivial
      induction ha using Algebra.adjoin_induction with
      | mem a ha =>
        rw [← hx] at ha
        obtain ⟨i, rfl⟩ := ha
        exact Submodule.subset_span ⟨i, rfl⟩
      | algebraMap r =>
        rw [Derivation.map_algebraMap]
        exact M.zero_mem
      | add a b _ _ ha hb =>
        rw [map_add]
        exact M.add_mem ha hb
      | mul a b _ _ ha hb =>
        rw [Derivation.leibniz]
        exact M.add_mem (M.smul_mem _ hb) (M.smul_mem _ ha)
    have hsurj : Function.Surjective π := by
      rw [← LinearMap.range_eq_top, Fintype.range_linearCombination, ← hM, eq_top_iff,
        ← KaehlerDifferential.span_range_derivation, Submodule.span_le]
      rintro _ ⟨a, rfl⟩
      exact hall a
    obtain ⟨s, hs⟩ := Module.projective_lifting_property π LinearMap.id hsurj
    refine ⟨t.card, x, s, fun ω => ?_⟩
    have := LinearMap.congr_fun hs ω
    simpa [π, Fintype.linearCombination_apply] using this
  have wc_pfc_ssr_tubular_smooth : ∀ (R : Type u) [CommRing R] (D : Type u) [CommRing D] [Algebra R D] [Algebra.Smooth R D] (n : ℕ) (E : Matrix (Fin n) (Fin n) D), E * E = E → ∀ g : MvPolynomial (Fin n) D, Algebra.Smooth R (Localization.Away (Ideal.Quotient.mk (Ideal.span (Set.range fun k : Fin n => ∑ i, MvPolynomial.C (E i k) * MvPolynomial.X i)) g)) := by
    intro R _ D _ _ _ n E hE g
    classical
    set r : Fin n → MvPolynomial (Fin n) D := fun k => ∑ i, MvPolynomial.C (E i k) * MvPolynomial.X i
      with hr
    set I := Ideal.span (Set.range r) with hIdef

    let ι : MvPolynomial (Fin n) D →ₐ[D] MvPolynomial (Fin n) D :=
      MvPolynomial.aeval fun i => MvPolynomial.X i - r i
    have hιr : ∀ k, ι (r k) = 0 := by
      intro k
      have hEjk : ∀ j, ∑ i, E j i * E i k = E j k := by
        intro j
        have := congrFun (congrFun hE j) k
        rwa [Matrix.mul_apply] at this
      simp only [ι, hr, map_sum, map_mul, MvPolynomial.aeval_C, MvPolynomial.aeval_X,
        MvPolynomial.algebraMap_eq, mul_sub, Finset.sum_sub_distrib, Finset.mul_sum]
      rw [sub_eq_zero, Finset.sum_comm]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [← hEjk j, map_sum, Finset.sum_mul]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [map_mul]
      ring
    have hιI : ∀ a ∈ I, ι a = 0 := by
      intro a ha
      have hle : I ≤ RingHom.ker ι := by
        rw [hIdef, Ideal.span_le]
        rintro _ ⟨k, rfl⟩
        exact hιr k
      exact hle ha
    let i₀ : (MvPolynomial (Fin n) D ⧸ I) →ₐ[D] MvPolynomial (Fin n) D := Ideal.Quotient.liftₐ I ι hιI
    have hmki : (Ideal.Quotient.mkₐ D I).comp i₀ = AlgHom.id D _ := by
      apply Ideal.Quotient.algHom_ext
      apply MvPolynomial.algHom_ext
      intro j
      simp only [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk, AlgHom.id_apply]
      change Ideal.Quotient.mk I (ι (MvPolynomial.X j)) = Ideal.Quotient.mk I (MvPolynomial.X j)
      simp only [ι, MvPolynomial.aeval_X, map_sub, sub_eq_self]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨j, rfl⟩)
    haveI : Algebra.FormallySmooth D (MvPolynomial (Fin n) D ⧸ I) := by
      have hker : RingHom.ker (Ideal.Quotient.mkₐ D I) = I := Ideal.Quotient.mkₐ_ker D I
      refine Algebra.FormallySmooth.of_split (Ideal.Quotient.mkₐ D I)
        ((Ideal.Quotient.mkₐ D (RingHom.ker (Ideal.Quotient.mkₐ D I) ^ 2)).comp i₀) ?_
      apply Ideal.Quotient.algHom_ext
      apply MvPolynomial.algHom_ext
      intro j
      have := AlgHom.congr_fun hmki (Ideal.Quotient.mk I (MvPolynomial.X j))
      exact this
    haveI : Algebra.FinitePresentation D (MvPolynomial (Fin n) D ⧸ I) :=
      Algebra.FinitePresentation.quotient (Submodule.fg_span (Set.finite_range r))
    haveI : Algebra.Smooth D (MvPolynomial (Fin n) D ⧸ I) := ⟨inferInstance, inferInstance⟩
    haveI : Algebra.Smooth R (MvPolynomial (Fin n) D ⧸ I) := Algebra.Smooth.comp R D _
    exact Algebra.Smooth.comp R (MvPolynomial (Fin n) D ⧸ I) _
  have wc_pfc_ssr_tubular_derivation : ∀ (R : Type u) [CommRing R] (D : Type u) [CommRing D] [Algebra R D] (n : ℕ) (x : Fin n → D) (E : Matrix (Fin n) (Fin n) D) (T : Fin n → Fin n → Fin n → D) (d0 : Derivation R D (Fin n → D)) (g : MvPolynomial (Fin n) D), E * E = E → (∀ i m, d0 (x i) m = E m i) → (∀ j i, d0 (E j i) = T j i) → g = (1 - Matrix.of fun m i : Fin n => ∑ j, MvPolynomial.C (T j i m) * MvPolynomial.X j).det → ∃ δ : Derivation R (Localization.Away (Ideal.Quotient.mk (Ideal.span (Set.range fun k : Fin n => ∑ i, MvPolynomial.C (E i k) * MvPolynomial.X i)) g)) (Fin n → Localization.Away (Ideal.Quotient.mk (Ideal.span (Set.range fun k : Fin n => ∑ i, MvPolynomial.C (E i k) * MvPolynomial.X i)) g)), IsUnit (Matrix.of fun m i : Fin n => δ (algebraMap D (Localization.Away (Ideal.Quotient.mk (Ideal.span (Set.range fun k : Fin n => ∑ i, MvPolynomial.C (E i k) * MvPolynomial.X i)) g)) (x i) + algebraMap (MvPolynomial (Fin n) D ⧸ Ideal.span (Set.range fun k : Fin n => ∑ i, MvPolynomial.C (E i k) * MvPolynomial.X i)) (Localization.Away (Ideal.Quotient.mk (Ideal.span (Set.range fun k : Fin n => ∑ i, MvPolynomial.C (E i k) * MvPolynomial.X i)) g)) (Ideal.Quotient.mk (Ideal.span (Set.range fun k : Fin n => ∑ i, MvPolynomial.C (E i k) * MvPolynomial.X i)) (MvPolynomial.X i))) m).det := by
    intro R _ D _ _ n x E T d0 g hE hEd hTd hg
    classical
    set r : Fin n → MvPolynomial (Fin n) D := fun k => ∑ i, MvPolynomial.C (E i k) * MvPolynomial.X i
      with hr
    set I : Ideal (MvPolynomial (Fin n) D) := Ideal.span (Set.range r) with hI
    have main : ∀ (B : Type u) [CommRing B] [Algebra (MvPolynomial (Fin n) D ⧸ I) B]
        [IsLocalization.Away (Ideal.Quotient.mk I g) B] [Algebra D B]
        [IsScalarTower D (MvPolynomial (Fin n) D ⧸ I) B] [Algebra R B] [IsScalarTower R D B],
        ∃ δ : Derivation R B (Fin n → B), IsUnit (Matrix.of fun m i : Fin n =>
          δ (algebraMap D B (x i) + algebraMap (MvPolynomial (Fin n) D ⧸ I) B
            (Ideal.Quotient.mk I (MvPolynomial.X i))) m).det := by
      intro B _ _ _ _ _ _ _
      let can : MvPolynomial (Fin n) D →+* B :=
        (algebraMap (MvPolynomial (Fin n) D ⧸ I) B).comp (Ideal.Quotient.mk I)
      have hcanC : ∀ a, can (MvPolynomial.C a) = algebraMap D B a := by
        intro a
        rw [IsScalarTower.algebraMap_apply D (MvPolynomial (Fin n) D ⧸ I) B]
        rfl
      have hcanI : ∀ p ∈ I, can p = 0 := by
        intro p hp
        simp [can, Ideal.Quotient.eq_zero_iff_mem.mpr hp]
      let yb : Fin n → B := fun i => can (MvPolynomial.X i)
      let e : Fin n → Fin n → B := fun i k => algebraMap D B (E i k)
      let t : Fin n → Fin n → Fin n → B := fun j i m => algebraMap D B (T j i m)
      have F1 : ∀ m k, ∑ i, e m i * e i k = e m k := by
        intro m k
        have := congrFun (congrFun hE m) k
        rw [Matrix.mul_apply] at this
        simp only [e, ← map_mul, ← map_sum, this]
      have F2 : ∀ j k m, t j k m = ∑ i, e j i * t i k m + ∑ i, e i k * t j i m := by
        intro j k m
        have h0 : E j k = ∑ i, E j i * E i k := by
          have := congrFun (congrFun hE j) k
          rw [Matrix.mul_apply] at this
          exact this.symm
        have h1 : T j k = ∑ i, (E j i • T i k + E i k • T j i) := by
          rw [← hTd, h0, map_sum]
          refine Finset.sum_congr rfl fun i _ => ?_
          rw [Derivation.leibniz, hTd, hTd]
        have h2 := congrFun h1 m
        simp only [Finset.sum_apply, Pi.add_apply, Pi.smul_apply, smul_eq_mul] at h2
        simp only [t, e, h2, map_sum, map_add, map_mul, Finset.sum_add_distrib]
      have F3 : ∀ i, ∑ j, e j i * yb j = 0 := by
        intro i
        have h := hcanI (r i) (Ideal.subset_span ⟨i, rfl⟩)
        simp only [hr, map_sum, map_mul, hcanC] at h
        exact h
      let ub : Fin n → (Fin n → B) := fun i m =>
        (if m = i then 1 else 0) - e m i - ∑ j, yb j * t j i m
      have alg : ∀ k m, ∑ i, (e i k * ub i m + yb i * t i k m) = 0 := by
        intro k m
        have h1 : ∑ i, e i k * e m i = e m k := by
          rw [← F1 m k]
          exact Finset.sum_congr rfl fun i _ => mul_comm _ _
        have h2 : ∑ i, yb i * t i k m = ∑ i, e i k * ∑ j, yb j * t j i m := by
          calc ∑ i, yb i * t i k m
              = ∑ j, yb j * (∑ i, e j i * t i k m + ∑ i, e i k * t j i m) :=
                Finset.sum_congr rfl fun j _ => by rw [← F2]
            _ = ∑ i, (∑ j, e j i * yb j) * t i k m + ∑ i, e i k * ∑ j, yb j * t j i m := by
                simp only [mul_add, Finset.sum_add_distrib, Finset.mul_sum, Finset.sum_mul]
                congr 1
                · rw [Finset.sum_comm]
                  exact Finset.sum_congr rfl fun _ _ => Finset.sum_congr rfl fun _ _ => by ring
                · rw [Finset.sum_comm]
                  exact Finset.sum_congr rfl fun _ _ => Finset.sum_congr rfl fun _ _ => by ring
            _ = _ := by simp only [F3, zero_mul, Finset.sum_const_zero, zero_add]
        have h3 : ∑ i, e i k * (if m = i then (1 : B) else 0) = e m k := by
          simp
        have h4 : ∑ i, (e i k * ub i m + yb i * t i k m) =
            ∑ i, e i k * (if m = i then (1 : B) else 0) - ∑ i, e i k * e m i
              - ∑ i, e i k * ∑ j, yb j * t j i m + ∑ i, yb i * t i k m := by
          simp only [ub, mul_sub, Finset.sum_add_distrib, Finset.sum_sub_distrib]
        rw [h4, h1, h2, h3]
        ring
      let ιB : (Fin n → D) → (Fin n → B) := fun v m => algebraMap D B (v m)
      let mkT : B → (Fin n → B) → TrivSqZeroExt B (Fin n → B) :=
        fun a v => TrivSqZeroExt.inl a + TrivSqZeroExt.inr v
      have mkT_fst : ∀ a v, (mkT a v).fst = a := fun a v => by simp [mkT]
      have mkT_snd : ∀ a v, (mkT a v).snd = v := fun a v => by simp [mkT]
      let Φ0 : D →+* TrivSqZeroExt B (Fin n → B) :=
        { toFun := fun a => mkT (algebraMap D B a) (ιB (d0 a))
          map_one' := by
            refine TrivSqZeroExt.ext ?_ ?_
            · rw [mkT_fst, map_one, TrivSqZeroExt.fst_one]
            · rw [mkT_snd, TrivSqZeroExt.snd_one]
              funext m
              simp [ιB]
          map_mul' := by
            intro a b
            refine TrivSqZeroExt.ext ?_ ?_
            · rw [TrivSqZeroExt.fst_mul, mkT_fst, mkT_fst, mkT_fst, map_mul]
            · rw [TrivSqZeroExt.snd_mul, mkT_fst, mkT_fst, mkT_snd, mkT_snd, mkT_snd, op_smul_eq_smul]
              funext m
              simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul, ιB, Derivation.leibniz, map_add,
                map_mul]
          map_zero' := by
            refine TrivSqZeroExt.ext ?_ ?_
            · rw [mkT_fst, map_zero, TrivSqZeroExt.fst_zero]
            · rw [mkT_snd, TrivSqZeroExt.snd_zero]
              funext m
              simp [ιB]
          map_add' := by
            intro a b
            show mkT (algebraMap D B (a + b)) (ιB (d0 (a + b))) =
              mkT (algebraMap D B a) (ιB (d0 a)) + mkT (algebraMap D B b) (ιB (d0 b))
            refine TrivSqZeroExt.ext ?_ ?_
            · rw [mkT_fst, TrivSqZeroExt.fst_add, mkT_fst, mkT_fst, map_add]
            · rw [mkT_snd, TrivSqZeroExt.snd_add, mkT_snd, mkT_snd]
              funext m
              simp [ιB] }
      have hΦ0 : ∀ a, Φ0 a = mkT (algebraMap D B a) (ιB (d0 a)) :=
        fun a => rfl
      let Φ1 : MvPolynomial (Fin n) D →+* TrivSqZeroExt B (Fin n → B) :=
        MvPolynomial.eval₂Hom Φ0 (fun i => mkT (yb i) (ub i))
      have hΦ1C : ∀ a, Φ1 (MvPolynomial.C a) = Φ0 a := fun a => MvPolynomial.eval₂Hom_C _ _ _
      have hΦ1X : ∀ i, Φ1 (MvPolynomial.X i) = mkT (yb i) (ub i) :=
        fun i => MvPolynomial.eval₂Hom_X' _ _ _
      let fstR : TrivSqZeroExt B (Fin n → B) →+* B :=
        { toFun := TrivSqZeroExt.fst
          map_one' := TrivSqZeroExt.fst_one
          map_mul' := TrivSqZeroExt.fst_mul
          map_zero' := TrivSqZeroExt.fst_zero
          map_add' := TrivSqZeroExt.fst_add }
      have hΦ1fst : fstR.comp Φ1 = can := by
        apply MvPolynomial.ringHom_ext
        · intro a
          rw [RingHom.comp_apply, hΦ1C, hΦ0, hcanC]
          exact mkT_fst _ _
        · intro i
          rw [RingHom.comp_apply, hΦ1X]
          exact mkT_fst _ _
      have hΦ1r : ∀ k, Φ1 (r k) = 0 := by
        intro k
        refine TrivSqZeroExt.ext ?_ ?_
        · rw [TrivSqZeroExt.fst_zero]
          change (fstR.comp Φ1) (r k) = 0
          rw [hΦ1fst]
          exact hcanI _ (Ideal.subset_span ⟨k, rfl⟩)
        · rw [TrivSqZeroExt.snd_zero]
          funext m
          simp only [hr, map_sum, map_mul, hΦ1C, hΦ1X, hΦ0, TrivSqZeroExt.snd_sum,
            TrivSqZeroExt.snd_mul, mkT_fst, mkT_snd, op_smul_eq_smul,
            Finset.sum_apply, Pi.add_apply, Pi.smul_apply, smul_eq_mul, Pi.zero_apply]
          have := alg k m
          simp only [ιB, hTd]
          rw [← this]
      have hΦ1I : ∀ p ∈ I, Φ1 p = 0 := by
        intro p hp
        have hle : I ≤ RingHom.ker Φ1 := by
          rw [hI, Ideal.span_le]
          rintro _ ⟨k, rfl⟩
          exact hΦ1r k
        exact hle hp
      let Φ2 : (MvPolynomial (Fin n) D ⧸ I) →+* TrivSqZeroExt B (Fin n → B) :=
        Ideal.Quotient.lift I Φ1 hΦ1I
      have hΦ2fst : fstR.comp Φ2 = algebraMap (MvPolynomial (Fin n) D ⧸ I) B := by
        apply Ideal.Quotient.ringHom_ext
        rw [RingHom.comp_assoc, Ideal.Quotient.lift_comp_mk]
        exact hΦ1fst
      have hu : IsUnit (Φ2 (Ideal.Quotient.mk I g)) := by
        rw [TrivSqZeroExt.isUnit_iff_isUnit_fst]
        have h : (Φ2 (Ideal.Quotient.mk I g)).fst =
            algebraMap (MvPolynomial (Fin n) D ⧸ I) B (Ideal.Quotient.mk I g) :=
          RingHom.congr_fun hΦ2fst _
        rw [h]
        exact IsLocalization.Away.algebraMap_isUnit _
      let Ψ : B →+* TrivSqZeroExt B (Fin n → B) := IsLocalization.Away.lift (Ideal.Quotient.mk I g) hu
      have hΨP : Ψ.comp (algebraMap (MvPolynomial (Fin n) D ⧸ I) B) = Φ2 :=
        IsLocalization.Away.lift_comp _ hu
      have hfstΨ : ∀ b, (Ψ b).fst = b := by
        have h : fstR.comp Ψ = RingHom.id B := by
          apply IsLocalization.ringHom_ext (Submonoid.powers (Ideal.Quotient.mk I g))
          rw [RingHom.comp_assoc, hΨP, hΦ2fst, RingHom.id_comp]
        intro b
        exact RingHom.congr_fun h b
      have hΨD : ∀ a, Ψ (algebraMap D B a) = Φ0 a := by
        intro a
        rw [IsScalarTower.algebraMap_apply D (MvPolynomial (Fin n) D ⧸ I) B, ← RingHom.comp_apply Ψ,
          hΨP]
        rw [← hΦ1C]
        rfl
      have hΨy : ∀ i, Ψ (yb i) = mkT (yb i) (ub i) := by
        intro i
        change (Ψ.comp (algebraMap (MvPolynomial (Fin n) D ⧸ I) B))
          (Ideal.Quotient.mk I (MvPolynomial.X i)) = _
        rw [hΨP, ← hΦ1X]
        rfl
      have hsndR : ∀ c : R, (Ψ (algebraMap R B c)).snd = 0 := by
        intro c
        rw [IsScalarTower.algebraMap_apply R D B, hΨD, hΦ0, mkT_snd]
        funext m
        simp [ιB]
      let δl : B →ₗ[R] (Fin n → B) :=
        { toFun := fun b => (Ψ b).snd
          map_add' := fun a b => by simp only [map_add, TrivSqZeroExt.snd_add]
          map_smul' := fun c b => by
            simp only [RingHom.id_apply]
            rw [Algebra.smul_def, map_mul, TrivSqZeroExt.snd_mul]
            simp only [hfstΨ, hsndR, smul_zero, add_zero]
            rw [algebraMap_smul] }
      let δ : Derivation R B (Fin n → B) := Derivation.mk' δl (fun a b => by
        show (Ψ (a * b)).snd = a • (Ψ b).snd + b • (Ψ a).snd
        simp only [map_mul, TrivSqZeroExt.snd_mul, hfstΨ, op_smul_eq_smul])
      have hδ : ∀ b, δ b = (Ψ b).snd := fun b => rfl
      refine ⟨δ, ?_⟩
      have hval : (Matrix.of fun m i : Fin n => δ (algebraMap D B (x i) +
          algebraMap (MvPolynomial (Fin n) D ⧸ I) B (Ideal.Quotient.mk I (MvPolynomial.X i))) m) =
          can.mapMatrix (1 - Matrix.of fun m i : Fin n =>
            ∑ j, MvPolynomial.C (T j i m) * MvPolynomial.X j) := by
        ext m i
        have hy : algebraMap (MvPolynomial (Fin n) D ⧸ I) B (Ideal.Quotient.mk I (MvPolynomial.X i))
            = yb i := rfl
        rw [Matrix.of_apply, hy, map_add, Pi.add_apply, hδ, hδ, hΨD, hΨy, hΦ0, mkT_snd, mkT_snd]
        simp only [RingHom.mapMatrix_apply, Matrix.map_apply, Matrix.sub_apply, Matrix.of_apply,
          map_sub, map_sum, map_mul, hcanC, ιB, hEd, ub, e, t]
        by_cases hmi : m = i
        · subst hmi
          simp only [Matrix.one_apply_eq, if_true]
          simp only [yb]
          rw [map_one, Finset.sum_congr rfl fun (x : Fin n) _ =>
            mul_comm ((algebraMap D B) (T x m m)) (can (MvPolynomial.X x))]
          ring
        · simp only [Matrix.one_apply_ne hmi, hmi, if_false]
          simp only [yb]
          rw [map_zero, Finset.sum_congr rfl fun (x : Fin n) _ =>
            mul_comm ((algebraMap D B) (T x i m)) (can (MvPolynomial.X x))]
          ring
      rw [hval, ← RingHom.map_det, ← hg]
