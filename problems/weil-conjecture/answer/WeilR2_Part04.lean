theorem wc_pfc_p_csa_prescribed_section : ∀ (p : ℕ) [Fact p.Prime] (K : Type u) [Field K] [CharP K p] (R : Type u) [CommRing R], (p : R) = 0 → ∀ (π : R →+* K), Function.Surjective π → ∀ (n : ℕ), RingHom.ker π ^ n = ⊥ → ∀ (J : Type u) (s : J → K), LinearIndependent K (fun j => KaehlerDifferential.D ℤ K (s j)) → ∀ (t : J → R), (∀ j, π (t j) = s j) → ∃ σ : K →+* R, π.comp σ = RingHom.id K ∧ ∀ j, σ (s j) = t j :=
