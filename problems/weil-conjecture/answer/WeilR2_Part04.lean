    · omega
    · have h3 := hμ.natDegree_mul hν
      rw [← hfμν] at h3
      omega
  have s4 : (∀ (R : Type u) [CommRing R] [IsLocalRing R] (A : Type u) [CommRing A] [Algebra R A] [Algebra.IsIntegral R A], (1 : A) ∉ Ideal.map (algebraMap R A) (IsLocalRing.maximalIdeal R) → (∀ a : A, a ∉ Ideal.map (algebraMap R A) (IsLocalRing.maximalIdeal R) → ∃ b : A, a * b - 1 ∈ Ideal.map (algebraMap R A) (IsLocalRing.maximalIdeal R)) → ∀ a : A, a ∉ Ideal.map (algebraMap R A) (IsLocalRing.maximalIdeal R) → IsUnit a) → ∀ (Ω κ : Type u) [Field Ω] [Field κ] (G : Subring (Ω × κ)) [IsLocalRing G], (∀ g : G, IsUnit g ↔ (g : Ω × κ).2 ≠ 0) → ∀ (γ : Ω × κ) (f : Polynomial G), f.Monic → Polynomial.aeval γ f = 0 → (∀ h : Polynomial G, (Polynomial.aeval γ h).2 = 0 → ∃ r : Polynomial G, Polynomial.aeval γ h = Polynomial.aeval γ r ∧ ∀ i : ℕ, ((r.coeff i : G) : Ω × κ).2 = 0) → (∀ s : Polynomial G, (Polynomial.aeval γ s).2 ≠ 0 → ∃ s' : Polynomial G, (Polynomial.aeval γ s).2 * (Polynomial.aeval γ s').2 = 1) → ∀ s : Polynomial G, (Polynomial.aeval γ s).2 ≠ 0 → ∃ s' : Polynomial G, Polynomial.aeval γ s * Polynomial.aeval γ s' = 1 := by
    intro P5 Ω κ _ _ G _ hU γ f hf hfγ hK hV
