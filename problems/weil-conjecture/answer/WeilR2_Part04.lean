    Limits.preservesLimitsOfShape_of_reflects_of_preserves (wcEtBaseChange g) (Scheme.Etale.forget Z)⟩
  haveI := flat_of_preservesFiniteLimits (wcEtBaseChange g)
  haveI : (wcEtBaseChange g).IsContinuous (Scheme.smallEtaleTopology S)
      (Scheme.smallEtaleTopology Z) :=
    Functor.isContinuous_of_coverPreserving (compatiblePreservingOfFlat _ _) (hcov g)

  obtain ⟨ρ₀, huniv, hnatG⟩ := wc_et_adjoint_univ_transport g L hadj
  refine ⟨fun G U V α hα => (ρ₀ G).ρ V U α hα, ?_, ?_, ?_, ?_⟩
  ·
    intro G G' ψ U V α hα x
    exact hnatG G G' ψ V U α hα x
  ·
    intro G U V V' w α hα hα' x
    have hcond : α ≫ w.left = (𝟙 U : U ⟶ U).left ≫ (α ≫ w.left) := by
      show α ≫ w.left = 𝟙 U.left ≫ (α ≫ w.left)
      exact (Category.id_comp _).symm
    have e := (ρ₀ G).nat V' V w U U (𝟙 U) (α ≫ w.left) hα' α hα hcond x
    rw [op_id, CategoryTheory.Functor.map_id] at e
    exact e.symm
  ·
    intro G U U' u V α hα hα' x
    have hcond : (u.left ≫ α) ≫ (𝟙 V : V ⟶ V).left = u.left ≫ α := by
      show (u.left ≫ α) ≫ 𝟙 V.left = u.left ≫ α
      exact Category.comp_id _
    have e := (ρ₀ G).nat V V (𝟙 V) U U' u α hα (u.left ≫ α) hα' hcond x
    rw [op_id, CategoryTheory.Functor.map_id] at e
    exact e.symm
  ·
    intro U Λ _ _ D π hπ hc hlim hqc hqs haff hU hUqs
    refine ⟨fun G s => ?_, fun G l x hx => ?_⟩
    · exact wc_et_univ_transport_limit_surj g G (L.obj G) (ρ₀ G) (huniv G) U Λ D π hπ hc hlim
        hqc hqs haff hU s
    · have hx' : (ρ₀ G).ρ (D.obj l) U (π l) (hπ l) x = 0 := hx
      obtain ⟨l', t, ht⟩ := wc_et_univ_transport_limit_vanish g G (L.obj G) (ρ₀ G) (huniv G) U Λ D
        π hπ hc hlim haff l (D.obj l) (𝟙 _) (hqc l) x (by
