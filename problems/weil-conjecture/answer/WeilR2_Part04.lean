    obtain ⟨T, iT1, iT2, iT3, iT4, iT5, ι, τ, hι, hτι, -⟩ := hs13
      (R ⧸ J) (Localization M) (MvPolynomial (Fin d) P) (Localization.Away s) L κ lam₀ τ₀
      hlam hF1

    let f₀ : A' →+* T := ι.comp f'.toRingHom
    have hG1 : ∀ r, f₀ (algebraMap R A' r) = algebraMap (R ⧸ J) T (Ideal.Quotient.mk J r) := by
      intro r
      show ι (f' _) = _
      rw [hf'R, hι, IsScalarTower.algebraMap_apply (R ⧸ J) (Localization M) T,
        show κ (θ r) = _ from RingHom.congr_fun hκθ r]
      rfl
    have hG2 : Ideal.map (algebraMap R A') J ≤ RingHom.ker f₀ := by
      rw [Ideal.map_le_iff_le_comap]
      intro r hr
      rw [Ideal.mem_comap, RingHom.mem_ker, hG1, Ideal.Quotient.eq_zero_iff_mem.mpr hr, map_zero]
    let fb₀ := Ideal.Quotient.lift (Ideal.map (algebraMap R A') J) f₀ (fun a ha => hG2 ha)
    have hfb₀ : ∀ a, fb₀ (Ideal.Quotient.mk _ a) = f₀ a := fun a => Ideal.Quotient.lift_mk _ _ _
    let fb : (A' ⧸ Ideal.map (algebraMap R A') J) →ₐ[R ⧸ J] T :=
      { toRingHom := fb₀
        commutes' := fun x => by
          obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective x
          show fb₀ (algebraMap _ _ (Ideal.Quotient.mk J r)) = _
          rw [Ideal.Quotient.algebraMap_quotient_map_quotient, hfb₀]
          exact hG1 r }
    haveI : Algebra.FinitePresentation (R ⧸ J) (A' ⧸ Ideal.map (algebraMap R A') J) :=
      wc_pfc_cz_fp_quotient_base_change R A' J

    obtain ⟨Csm, iC1, iC2, iC3, g, h, hgh⟩ := wc_pfc_pd_smooth_descent
      (R ⧸ J) M (Localization M) T _ fb
    refine ⟨Csm, iC1, iC2, iC3, g, τ.comp h, ?_⟩
    apply AlgHom.ext
    intro z
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective z
    have e1 : h (g (Ideal.Quotient.mk _ a)) = ι (f' a) := by
      rw [← AlgHom.comp_apply, hgh]
      exact hfb₀ a
    have e3 : j (f' a) = χD a := AlgHom.congr_fun hfj a
    rw [AlgHom.comp_apply, AlgHom.comp_apply, e1, hτι]
    show τ' (j (f' a)) = _
    rw [e3, hΦ]
  revert hqp ρ hρ φbar hφbar
  generalize hJ : wcPfcPowIdeal (fun i =>
    (MvPolynomial.rename Sum.inl (π i) * MvPolynomial.X (Sum.inr i) :
      MvPolynomial (Fin m ⊕ Fin d) k) ^ c) = J
  intro hqp ρ hρ φbar hφbar
  set I : Ideal Λ := Ideal.map (algebraMap (MvPolynomial (Fin m ⊕ Fin d) k) Λ) J with hI

  have hren : ∀ q, algebraMap (MvPolynomial (Fin m ⊕ Fin d) k) Λ
      (MvPolynomial.rename Sum.inl q) = φ' q := by
    intro q
    have h : (IsScalarTower.toAlgHom k (MvPolynomial (Fin m ⊕ Fin d) k) Λ).comp
        (MvPolynomial.rename Sum.inl : MvPolynomial (Fin m) k →ₐ[k]
          MvPolynomial (Fin m ⊕ Fin d) k) = φ' := by
      apply MvPolynomial.algHom_ext
      intro j
      rw [AlgHom.comp_apply, MvPolynomial.rename_X, IsScalarTower.toAlgHom_apply]
      exact hRXl j
    exact AlgHom.congr_fun h q

  have hγΛ : ∀ i, algebraMap (MvPolynomial (Fin m ⊕ Fin d) k) Λ
      (MvPolynomial.rename Sum.inl (π i) * MvPolynomial.X (Sum.inr i)) = φ' (π i) * δ i := by
    intro i
    rw [map_mul, hren, hRXr]

  have hIq : I ≤ 𝔮 := by
    rw [hI, ← hJ]
    unfold wcPfcPowIdeal
    rw [Ideal.map_span, Ideal.span_le]
    rintro _ ⟨_, ⟨i, rfl⟩, rfl⟩
    simp only [map_pow]
    rw [hγΛ]
    exact Ideal.pow_mem_of_mem 𝔮 (Ideal.pow_mem_of_mem 𝔮
      (Ideal.mul_mem_right _ _ (Ideal.mem_comap.mp (hπ𝔭 i))) c (by omega)) 8 (by norm_num)

  have hunit : ∀ z : Λ, z ∉ 𝔮 → IsUnit (algebraMap (Λ ⧸ I)
      (Localization.AtPrime (𝔮.map (Ideal.Quotient.mk I))) (Ideal.Quotient.mk I z)) := by
