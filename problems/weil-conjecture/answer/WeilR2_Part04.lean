      congrArg (fun f => f.left) (hcomm a)
    have hside : (k a ≫ (p₁ a).left) ≫ (c a).left = (d a).left ≫ π l₀ := by
      rw [Category.assoc, e1, ← Category.assoc, hkc a, Category.assoc, hc (u ≫ t₁)]
    have E1 := ρ.nat (D.obj l₃) (Q a) (p₂ a) U (O a) (d a) (π l₃) (hπ l₃) (k a) (hkg a)
