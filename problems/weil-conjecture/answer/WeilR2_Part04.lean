    have hC := hDESC A' (AdicCompletion (IsLocalRing.maximalIdeal A') A')
      (AdicCompletion (IsLocalRing.maximalIdeal E) E) inferInstance hGRF
    exact hTRANS A' _ Λ e hC
  intro hPC hDESC hCOMP hTRANS hCFLAT hPB hML B _ _ hfg 𝔮 _

  have s1 : ∀ (R : Type u) [CommRing R] (S : Type u) [CommRing S] (g : R →+* S), g.Flat →
      (Polynomial.mapRingHom g).Flat := by
    intro R _ S _ g hg
    letI : Algebra R S := g.toAlgebra
