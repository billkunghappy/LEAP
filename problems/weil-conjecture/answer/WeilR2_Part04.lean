      rw [hy] at h1 ⊢
      have h2 := g0 y (by rw [← h1]; ring)
      rw [mul_comm]
      exact h2
    have hker : Ideal.span (Set.range (Fin.append K (fun j => MvPolynomial.aeval Z (f j)))) ≤ RingHom.ker Ψ := by
      rw [Ideal.span_le]
      rintro _ ⟨j, rfl⟩
      induction j using Fin.addCases with
      | left l => rw [SetLike.mem_coe, RingHom.mem_ker, Fin.append_left]; exact hΨK l
      | right j => rw [SetLike.mem_coe, RingHom.mem_ker, Fin.append_right]; exact hΨF j
    have hker' : ∀ a ∈ Ideal.span (Set.range (Fin.append K (fun j => MvPolynomial.aeval Z (f j)))), Ψ a = 0 :=
      fun a ha => RingHom.mem_ker.mp (hker ha)
    refine ⟨Ideal.Quotient.liftₐ _ Ψ hker', fun x => ?_, fun i => ?_⟩
    · rw [← Ideal.Quotient.mk_algebraMap, MvPolynomial.algebraMap_eq, Ideal.Quotient.liftₐ_apply]
      exact (Ideal.Quotient.lift_mk _ _ _).trans (hΨC x)
    · rw [Ideal.Quotient.liftₐ_apply]
      exact (Ideal.Quotient.lift_mk _ _ _).trans (hΨZ i)

  intro R _ _ Λ _ _ π hR hΛ A _ _ _ φ hss D _ _ _ χD σ hσ1 hσ2
  obtain ⟨n, m, c, hcm, f, e, a, STD1, STD2⟩ := hNorm R A π hss
  have hlamf : ∀ j, MvPolynomial.aeval
      (fun i => φ (e (Ideal.Quotient.mk (Ideal.span (Set.range f)) (MvPolynomial.X i)))) (f j) = 0 := by
    intro j
    have h1 : (MvPolynomial.aeval
        (fun i => φ (e (Ideal.Quotient.mk (Ideal.span (Set.range f)) (MvPolynomial.X i)))) :
          MvPolynomial (Fin n) R →ₐ[R] Λ) =
        (φ.comp (e : (MvPolynomial (Fin n) R ⧸ Ideal.span (Set.range f)) →ₐ[R] A)).comp
          (Ideal.Quotient.mkₐ R (Ideal.span (Set.range f))) := by
      apply MvPolynomial.algHom_ext
      intro i
      rw [MvPolynomial.aeval_X, AlgHom.comp_apply, AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk]
      rfl
    rw [h1, AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk,
      (Ideal.Quotient.eq_zero_iff_mem (I := Ideal.span (Set.range f))).mpr
        (Ideal.subset_span (Set.mem_range_self j)), map_zero]
  obtain ⟨d, hd1, hd2⟩ := hLift R A Λ φ π D χD σ hσ1 hσ2 n m f e
  obtain ⟨S, r, H, h4a, h4b⟩ := hSubst R D π n m c hcm f a d STD1 hd1
  obtain ⟨Z, hZ⟩ : ∃ Z : Fin n → MvPolynomial (Fin (n + c)) D, Z = fun i =>
      MvPolynomial.C (d i) + (MvPolynomial.C (algebraMap R D π) ^ 2 *
        ∑ k, MvPolynomial.C (S i k) * MvPolynomial.X (Fin.natAdd n k) +
        MvPolynomial.C (algebraMap R D π) ^ 3 * MvPolynomial.X (Fin.castAdd c i)) := ⟨_, rfl⟩
  obtain ⟨K, hK⟩ : ∃ K : Fin c → MvPolynomial (Fin (n + c)) D, K = fun l =>
      MvPolynomial.X (Fin.natAdd n l) + ∑ i, MvPolynomial.C (r l i) * MvPolynomial.X (Fin.castAdd c i) +
        MvPolynomial.C (algebraMap R D π) * H l := ⟨_, rfl⟩
  have h4a' : ∀ j, MvPolynomial.aeval Z (f j) ∈
      Ideal.span {MvPolynomial.C (algebraMap R D π) ^ 2} := by
    rw [hZ]; exact h4a
  have h4b' : ∀ l, MvPolynomial.aeval Z (f (Fin.castLE hcm l)) =
      MvPolynomial.C (algebraMap R D π) ^ 3 * K l := by
    rw [hZ, hK]; exact h4b
  have hne : ∀ (i : Fin n) (k : Fin c), (Fin.natAdd n k : Fin (n + c)) ≠ Fin.castAdd c i := by
    intro i k h
    have h1 := congrArg Fin.val h
    simp only [Fin.val_natAdd, Fin.val_castAdd] at h1
    have := i.isLt
    omega
  have hsum0 : ∀ (i : Fin n) (s : Fin c → D), MvPolynomial.pderiv (Fin.castAdd c i)
      (∑ k, MvPolynomial.C (s k) * MvPolynomial.X (Fin.natAdd n k) :
        MvPolynomial (Fin (n + c)) D) = 0 := by
    intro i s
    rw [map_sum]
    apply Finset.sum_eq_zero
    intro k _
    rw [MvPolynomial.pderiv_C_mul, MvPolynomial.pderiv_X_of_ne (hne i k), mul_zero]
  have hXw : ∀ i i' : Fin n, MvPolynomial.pderiv (Fin.castAdd c i)
      (MvPolynomial.X (Fin.castAdd c i') : MvPolynomial (Fin (n + c)) D) =
        if i = i' then 1 else 0 := by
    intro i i'
    split_ifs with h
    · subst h; exact MvPolynomial.pderiv_X_self _
    · exact MvPolynomial.pderiv_X_of_ne (fun h' => h ((Fin.castAdd_injective n c h').symm))
  have g4 : ∀ i i' : Fin n, MvPolynomial.pderiv (Fin.castAdd c i) (Z i') =
      if i = i' then MvPolynomial.C (algebraMap R D π) ^ 3 else 0 := by
    intro i i'
    simp only [hZ]
    rw [map_add, map_add, MvPolynomial.pderiv_C, ← MvPolynomial.C_pow, ← MvPolynomial.C_pow,
      MvPolynomial.pderiv_C_mul, MvPolynomial.pderiv_C_mul, hsum0, hXw]
    split_ifs <;> simp
  obtain ⟨STD1', STD2'⟩ := hTransport R D π n m c hcm f a Z K STD1 STD2 g4 h4b'
  have hXv : ∀ k l : Fin c, MvPolynomial.pderiv (Fin.natAdd n k)
      (MvPolynomial.X (Fin.natAdd n l) : MvPolynomial (Fin (n + c)) D) =
        if k = l then 1 else 0 := by
    intro k l
    split_ifs with h
    · subst h; exact MvPolynomial.pderiv_X_self _
    · exact MvPolynomial.pderiv_X_of_ne (fun h' => h ((Fin.natAdd_injective c n h').symm))
  have hsum0' : ∀ (k : Fin c) (s : Fin n → D), MvPolynomial.pderiv (Fin.natAdd n k)
      (∑ i, MvPolynomial.C (s i) * MvPolynomial.X (Fin.castAdd c i) :
        MvPolynomial (Fin (n + c)) D) = 0 := by
    intro k s
    rw [map_sum]
    apply Finset.sum_eq_zero
    intro i _
    rw [MvPolynomial.pderiv_C_mul, MvPolynomial.pderiv_X_of_ne (hne i k).symm, mul_zero]
  have g5 : ∀ k l : Fin c, MvPolynomial.pderiv (Fin.natAdd n k) (K l) - (if k = l then 1 else 0) ∈
      Ideal.span {MvPolynomial.C (algebraMap R D π)} := by
    intro k l
    simp only [hK]
    rw [map_add, map_add, hXv, hsum0', MvPolynomial.pderiv_C_mul,
      show ∀ x y : MvPolynomial (Fin (n + c)) D, x + 0 + y - x = y from fun x y => by ring]
    exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _)
  have hgenF : ∀ j, MvPolynomial.aeval Z (f j) ∈
      Ideal.span (Set.range (Fin.append K (fun j => MvPolynomial.aeval Z (f j)))) :=
    fun j => Ideal.subset_span ⟨Fin.natAdd c j, Fin.append_right _ _ j⟩
  have STD1'' : MvPolynomial.C (algebraMap R D π) ^ (3 * c + 1) - ∑ I,
      (MvPolynomial.C (algebraMap R D π) ^ (3 * c) * MvPolynomial.aeval Z (a I)) *
        (Matrix.of fun k l : Fin c => MvPolynomial.pderiv (Fin.castAdd c (I k)) (K l)).det ∈
      Ideal.span (Set.range (Fin.append K (fun j => MvPolynomial.aeval Z (f j)))) := by
    refine (Ideal.span_le.mpr ?_) STD1'
    rintro _ ⟨j, rfl⟩
    exact hgenF j
  haveI hfpD : Algebra.FinitePresentation D (MvPolynomial (Fin (n + c)) D ⧸
      Ideal.span (Set.range (Fin.append K (fun j => MvPolynomial.aeval Z (f j))))) :=
    Algebra.FinitePresentation.quotient (Submodule.fg_span (Set.finite_range _))
  haveI hfpR : Algebra.FinitePresentation R (MvPolynomial (Fin (n + c)) D ⧸
      Ideal.span (Set.range (Fin.append K (fun j => MvPolynomial.aeval Z (f j))))) :=
    Algebra.FinitePresentation.trans R D _
  have hcomp : (MvPolynomial.aeval (fun i => Ideal.Quotient.mk
      (Ideal.span (Set.range (Fin.append K (fun j => MvPolynomial.aeval Z (f j))))) (Z i)) :
        MvPolynomial (Fin n) R →ₐ[R] _) =
      (Ideal.Quotient.mkₐ R (Ideal.span (Set.range (Fin.append K
        (fun j => MvPolynomial.aeval Z (f j)))))).comp (MvPolynomial.aeval Z) := by
    apply MvPolynomial.algHom_ext
    intro i
    rw [MvPolynomial.aeval_X, AlgHom.comp_apply, MvPolynomial.aeval_X, Ideal.Quotient.mkₐ_eq_mk]
  have hlift : ∀ x ∈ Ideal.span (Set.range f), (MvPolynomial.aeval (fun i => Ideal.Quotient.mk
      (Ideal.span (Set.range (Fin.append K (fun j => MvPolynomial.aeval Z (f j))))) (Z i)) :
        MvPolynomial (Fin n) R →ₐ[R] _) x = 0 := by
    have hle : Ideal.span (Set.range f) ≤ RingHom.ker (MvPolynomial.aeval (fun i =>
        Ideal.Quotient.mk (Ideal.span (Set.range (Fin.append K
          (fun j => MvPolynomial.aeval Z (f j))))) (Z i)) : MvPolynomial (Fin n) R →ₐ[R] _) := by
      rw [Ideal.span_le]
      rintro _ ⟨j, rfl⟩
      rw [SetLike.mem_coe, RingHom.mem_ker, hcomp, AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk,
        Ideal.Quotient.eq_zero_iff_mem]
      exact hgenF j
    intro x hx
    exact (RingHom.mem_ker).mp (hle hx)
  obtain ⟨χ, hχ1, hχ2⟩ := hBuild R Λ π hΛ D χD n m c hcm f
    (fun i => φ (e (Ideal.Quotient.mk (Ideal.span (Set.range f)) (MvPolynomial.X i)))) d r Z K
    hlamf hd2
    (by
      intro i
      simp only [hZ]
      rw [show ∀ x y z : MvPolynomial (Fin (n + c)) D, x + (y + z) - (x + z) = y from
        fun x y z => by ring]
      apply Ideal.mul_mem_left
      apply Ideal.sum_mem
      intro k _
      exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨k, rfl⟩))
    (by
      intro l
      simp only [hK]
      rw [show ∀ x y z : MvPolynomial (Fin (n + c)) D, x + y + z - x - y = z from
        fun x y z => by ring]
      exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _))
    h4b'
  have hpoly : χ.comp (MvPolynomial.aeval (fun i => Ideal.Quotient.mk
      (Ideal.span (Set.range (Fin.append K (fun j => MvPolynomial.aeval Z (f j))))) (Z i))) =
      (φ.comp (e : (MvPolynomial (Fin n) R ⧸ Ideal.span (Set.range f)) →ₐ[R] A)).comp
        (Ideal.Quotient.mkₐ R (Ideal.span (Set.range f))) := by
    apply MvPolynomial.algHom_ext
    intro i
    rw [AlgHom.comp_apply, MvPolynomial.aeval_X, hχ2 i, AlgHom.comp_apply, AlgHom.comp_apply,
      Ideal.Quotient.mkₐ_eq_mk]
    rfl
  refine ⟨MvPolynomial (Fin (n + c)) D ⧸
      Ideal.span (Set.range (Fin.append K (fun j => MvPolynomial.aeval Z (f j)))),
    inferInstance, inferInstance, hfpR,
    (Ideal.Quotient.liftₐ _ (MvPolynomial.aeval (fun i => Ideal.Quotient.mk
      (Ideal.span (Set.range (Fin.append K (fun j => MvPolynomial.aeval Z (f j))))) (Z i)))
        hlift).comp (e.symm : A →ₐ[R] _),
    IsScalarTower.toAlgHom R D _, χ, ?_, ?_, ?_⟩
  · apply AlgHom.ext
    intro x
    obtain ⟨y, rfl⟩ := e.surjective x
    obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective y
    have h1 : (e.symm : A →ₐ[R] _) (e (Ideal.Quotient.mk (Ideal.span (Set.range f)) y)) =
        Ideal.Quotient.mk (Ideal.span (Set.range f)) y := e.symm_apply_apply _
    rw [AlgHom.comp_apply, AlgHom.comp_apply, h1]
    have := congrArg (fun g => g y) hpoly
    simp only [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk] at this
    exact this
  · apply AlgHom.ext
    intro x
    rw [AlgHom.comp_apply, IsScalarTower.toAlgHom_apply]
    exact hχ1 x
  · intro d0 hd0
    rw [Ideal.radical_eq_sInf, Submodule.mem_sInf]
    rintro Q ⟨hQle, hQprime⟩
    by_contra hnot
    have hd0Q : Ideal.Quotient.mk
        (Ideal.span (Set.range (Fin.append K (fun j => MvPolynomial.aeval Z (f j)))))
        (MvPolynomial.C d0) ∉ Q := hnot
    obtain ⟨t, htQ, ht⟩ : ∃ t, t ∉ Q ∧ Algebra.Smooth D (Localization.Away t) := by
      by_cases hpQ : Ideal.Quotient.mk
          (Ideal.span (Set.range (Fin.append K (fun j => MvPolynomial.aeval Z (f j)))))
          (MvPolynomial.C (algebraMap R D π)) ∈ Q
      · exact hAtPi R π hR D n m c hcm K
          (fun j => MvPolynomial.aeval Z (f j)) g5 h4b' h4a' STD2' d0 hd0 Q hQprime hpQ hd0Q
      · exact hAwayPi D (algebraMap R D π) n m c hcm K
          (fun j => MvPolynomial.aeval Z (f j))
          (fun I => MvPolynomial.C (algebraMap R D π) ^ (3 * c) * MvPolynomial.aeval Z (a I))
          (3 * c + 1) h4b' STD1'' STD2' Q hQprime hpQ
    have hsm := hAwayMul R D _ t d0 ht hd0
    have hmem := hQle (Ideal.subset_span hsm)
    rcases hQprime.mem_or_mem hmem with h | h
    · exact htQ h
    · exact hd0Q h

theorem wc_pfc_smooth_localization_quotient : ∀ (R : Type u) [CommRing R] (A : Type u) [CommRing A] [Algebra R A] (J : Ideal R) (a : A), Algebra.Smooth R (Localization.Away a) → Algebra.Smooth (R ⧸ J) (Localization.Away (Ideal.Quotient.mk (Ideal.map (algebraMap R A) J) a)) :=
by
  intro R _ A _ _ J a h
  have : Algebra.Smooth R (Localization.Away a) := h
  have hT : Algebra.Smooth (R ⧸ J) (TensorProduct R (R ⧸ J) (Localization.Away a)) :=
    Algebra.Smooth.baseChange R (Localization.Away a) (R ⧸ J)
  have hsurj : Function.Surjective (algebraMap R (R ⧸ J)) := by
    rw [Ideal.Quotient.algebraMap_eq]; exact Ideal.Quotient.mk_surjective
  let h₀ : A →ₐ[R] TensorProduct R (R ⧸ J) (Localization.Away a) :=
    (Algebra.TensorProduct.includeRight).comp (IsScalarTower.toAlgHom R A (Localization.Away a))
  have hker : ∀ x ∈ Ideal.map (algebraMap R A) J, h₀ x = 0 := by
    have hle : Ideal.map (algebraMap R A) J ≤ RingHom.ker (h₀ : A →+* TensorProduct R (R ⧸ J) (Localization.Away a)) := by
      rw [Ideal.map_le_iff_le_comap]
      intro r hr
      rw [Ideal.mem_comap, RingHom.mem_ker]
      change h₀ (algebraMap R A r) = 0
      rw [AlgHom.commutes, IsScalarTower.algebraMap_apply R (R ⧸ J),
        Ideal.Quotient.algebraMap_eq, Ideal.Quotient.eq_zero_iff_mem.mpr hr, map_zero]
    intro x hx
    exact hle hx
  let f₁ : (A ⧸ Ideal.map (algebraMap R A) J) →ₐ[R ⧸ J] TensorProduct R (R ⧸ J) (Localization.Away a) :=
    (Ideal.Quotient.liftₐ (Ideal.map (algebraMap R A) J) h₀ hker).extendScalarsOfSurjective hsurj
  have hf₁ : ∀ x : A, f₁ (Ideal.Quotient.mk _ x) = (1 : R ⧸ J) ⊗ₜ[R] algebraMap A (Localization.Away a) x := by
    intro x; rfl
  have hu1 : IsUnit (f₁ (Ideal.Quotient.mk (Ideal.map (algebraMap R A) J) a)) := by
    rw [hf₁]
    exact IsUnit.map (Algebra.TensorProduct.includeRight : Localization.Away a →ₐ[R] _)
      (IsLocalization.Away.algebraMap_isUnit a)
  let f : Localization.Away (Ideal.Quotient.mk (Ideal.map (algebraMap R A) J) a) →ₐ[R ⧸ J]
      TensorProduct R (R ⧸ J) (Localization.Away a) :=
    IsLocalization.Away.liftAlgHom (Ideal.Quotient.mk (Ideal.map (algebraMap R A) J) a) hu1
  have hf : ∀ y, f (algebraMap _ _ y) = f₁ y := by
    intro y
    simp [f, IsLocalization.Away.liftAlgHom_apply]
  let φA : A →ₐ[R] Localization.Away (Ideal.Quotient.mk (Ideal.map (algebraMap R A) J) a) :=
    (IsScalarTower.toAlgHom R (A ⧸ Ideal.map (algebraMap R A) J) _).comp
      (Ideal.Quotient.mkₐ R (Ideal.map (algebraMap R A) J))
  have hu2 : IsUnit (φA a) :=
    IsLocalization.Away.algebraMap_isUnit (Ideal.Quotient.mk (Ideal.map (algebraMap R A) J) a)
  let g₁ : Localization.Away a →ₐ[R] Localization.Away (Ideal.Quotient.mk (Ideal.map (algebraMap R A) J) a) :=
    IsLocalization.Away.liftAlgHom a hu2
  have hg₁ : ∀ x, g₁ (algebraMap A _ x) = algebraMap _ _ (Ideal.Quotient.mk (Ideal.map (algebraMap R A) J) x) := by
    intro x
    simp [g₁, φA, IsLocalization.Away.liftAlgHom_apply]
  let g : TensorProduct R (R ⧸ J) (Localization.Away a) →ₐ[R ⧸ J]
      Localization.Away (Ideal.Quotient.mk (Ideal.map (algebraMap R A) J) a) :=
    Algebra.TensorProduct.lift (Algebra.ofId (R ⧸ J) _) g₁ (fun _ _ => Commute.all _ _)
  have hg : ∀ x : A, g ((1 : R ⧸ J) ⊗ₜ[R] algebraMap A (Localization.Away a) x) =
      algebraMap _ _ (Ideal.Quotient.mk (Ideal.map (algebraMap R A) J) x) := by
    intro x
    simp only [g, Algebra.TensorProduct.lift_tmul, map_one, one_mul, hg₁]
  have e1 : g.comp f = AlgHom.id _ _ := by
    apply AlgHom.coe_ringHom_injective
    apply IsLocalization.ringHom_ext (Submonoid.powers (Ideal.Quotient.mk (Ideal.map (algebraMap R A) J) a))
    apply Ideal.Quotient.ringHom_ext
    ext x
    simp only [RingHom.comp_apply, AlgHom.coe_toRingHom, AlgHom.comp_apply, AlgHom.id_apply]
    rw [hf, hf₁, hg]
  have e2 : f.comp g = AlgHom.id _ _ := by
    apply Algebra.TensorProduct.ext
    · exact Subsingleton.elim _ _
    · apply AlgHom.coe_ringHom_injective
      apply IsLocalization.ringHom_ext (Submonoid.powers a)
      ext x
      simp only [RingHom.comp_apply, AlgHom.coe_toRingHom, AlgHom.comp_apply, AlgHom.id_apply,
        AlgHom.coe_restrictScalars', Algebra.TensorProduct.includeRight_apply]
      rw [hg, hf, hf₁]
  exact Algebra.Smooth.of_equiv (AlgEquiv.ofAlgHom g f e1 e2)

theorem wc_pfc_lift_one_step : ∀ (R : Type u) [CommRing R] [IsNoetherianRing R] (A : Type u) [CommRing A] [Algebra R A] [Algebra.FinitePresentation R A] (Λ : Type u) [CommRing Λ] [Algebra R Λ] (φ : A →ₐ[R] Λ) (𝔮 : Ideal Λ) [𝔮.IsPrime] (π : R), algebraMap R Λ π ∈ 𝔮 → (∀ y : R, y * π ^ 2 = 0 → y * π = 0) → (∀ y : Λ, y * algebraMap R Λ π ^ 2 = 0 → y * algebraMap R Λ π = 0) → wcPfcStrictStd R A (algebraMap R A π) → ∀ (φbar : (A ⧸ Ideal.map (algebraMap R A) (Ideal.span {π ^ 8})) →ₐ[R ⧸ Ideal.span {π ^ 8}] (Λ ⧸ Ideal.map (algebraMap R Λ) (Ideal.span {π ^ 8}))), (∀ a : A, φbar (Ideal.Quotient.mk _ a) = Ideal.Quotient.mk _ (φ a)) → wcPfcRes (R ⧸ Ideal.span {π ^ 8}) (A ⧸ Ideal.map (algebraMap R A) (Ideal.span {π ^ 8})) (Λ ⧸ Ideal.map (algebraMap R Λ) (Ideal.span {π ^ 8})) φbar (𝔮.map (Ideal.Quotient.mk (Ideal.map (algebraMap R Λ) (Ideal.span {π ^ 8})))) → wcPfcRes R A Λ φ 𝔮 :=
by
  intro R _ _ A _ _ _ Λ _ _ φ 𝔮 _ π hπ hannR hannΛ hss φbar hφbar hres

  have s1 : ∀ (R : Type u) [CommRing R] (M : Type u) [AddCommGroup M] [Module R M]
      [Module.Flat R M] (w : R), (∀ y : R, y * w ^ 2 = 0 → y * w = 0) →
      ∀ x : M, w ^ 2 • x = 0 → w • x = 0 := by
    intro R' _ M _ _ _ w hw x hx
    have h0 : ∑ i : Unit, (fun _ : Unit => w ^ 2) i • (fun _ : Unit => x) i = 0 := by
      simpa using hx
    obtain ⟨k, a, y, hxy, ha⟩ := Module.Flat.isTrivialRelation_of_sum_smul_eq_zero
      (R := R') (M := M) (f := fun _ : Unit => w ^ 2) (x := fun _ : Unit => x) h0
    have hx' : x = ∑ j, a () j • y j := hxy ()
    have ha' : ∀ j, a () j * w = 0 := by
      intro j
      have h1 := ha j
      simp only [Finset.univ_unique, Finset.sum_singleton] at h1
      exact hw _ (by rw [mul_comm]; exact h1)
    rw [hx', Finset.smul_sum]
    refine Finset.sum_eq_zero (fun j _ => ?_)
    rw [smul_smul, mul_comm, ha' j, zero_smul]

  unfold wcPfcRes at hres
  obtain ⟨C, iC, aC, fpC, ψbar, χbar, hψχ, hradC, hnotC⟩ := hres

  obtain ⟨D, iD, aD, fpD, χD, θ, hθ1, hθ2, hθ3, hθ4⟩ :=
    wc_pfc_elkik_lift wc_pfc_jacobian_localization_smooth wc_pfc_chart_local s1
      R Λ π hannR hannΛ C χbar

  let σ : A →+* (D ⧸ Ideal.map (algebraMap R D) (Ideal.span {π ^ 4})) :=
    θ.comp (ψbar.toRingHom.comp
      (Ideal.Quotient.mk (Ideal.map (algebraMap R A) (Ideal.span {π ^ 8}))))
  have hσ1 : ∀ r : R, σ (algebraMap R A r) = Ideal.Quotient.mk _ (algebraMap R D r) := by
    intro r
    show θ (ψbar (Ideal.Quotient.mk _ (algebraMap R A r))) = _
    rw [← Ideal.Quotient.algebraMap_quotient_map_quotient, AlgHom.commutes]
    exact hθ1 r
  have hσ2 : ∀ (a : A) (d : D), Ideal.Quotient.mk _ d = σ a →
      χD d - φ a ∈ Ideal.map (algebraMap R Λ) (Ideal.span {π ^ 4}) := by
    intro a d hd
    refine hθ2 (ψbar (Ideal.Quotient.mk _ a)) d (φ a) hd ?_
    rw [← hφbar a, ← hψχ]
    rfl

  obtain ⟨B, iB, aB, fpB, ψ, ψD, χ, hχψ, hχψD, hψD⟩ :=
    wc_pfc_merge_factorizations R Λ π hannR hannΛ A φ hss D χD σ hσ1 hσ2
  obtain ⟨𝔥, h𝔥⟩ : ∃ 𝔥 : Ideal Λ,
      (Ideal.span (χ '' {b : B | Algebra.Smooth R (Localization.Away b)})).radical = 𝔥 :=
    ⟨_, rfl⟩
  have key : ∀ b : B, b ∈ (Ideal.span {e : B | Algebra.Smooth R (Localization.Away e)}).radical →
      χ b ∈ 𝔥 := by
    intro b hb
    obtain ⟨n, hn⟩ := Ideal.mem_radical_iff.mp hb
    rw [← h𝔥]
    refine Ideal.mem_radical_iff.mpr ⟨n, ?_⟩
    rw [← map_pow]
    have h1 := Ideal.mem_map_of_mem χ hn
    rwa [Ideal.map_span] at h1

  have hπ𝔥 : algebraMap R Λ π ∈ 𝔥 := by
    have h1 := hψD (algebraMap R D π) hθ3
    have h2 := key _ h1
    rwa [← AlgHom.comp_apply, hχψD, AlgHom.commutes] at h2
  have hpow𝔥 : ∀ k : ℕ, 0 < k → Ideal.map (algebraMap R Λ) (Ideal.span {π ^ k}) ≤ 𝔥 := by
    intro k hk
    rw [Ideal.map_span, Set.image_singleton, Ideal.span_le, Set.singleton_subset_iff, map_pow]
    exact Ideal.pow_mem_of_mem _ hπ𝔥 k hk
  have hker : Ideal.map (algebraMap R Λ) (Ideal.span {π ^ 8}) ≤ 𝔥 := hpow𝔥 8 (by norm_num)

  have hK : ∀ c : C, Algebra.Smooth (R ⧸ Ideal.span {π ^ 8}) (Localization.Away c) →
      ∀ l : Λ, Ideal.Quotient.mk (Ideal.map (algebraMap R Λ) (Ideal.span {π ^ 8})) l = χbar c →
      l ∈ 𝔥 := by
    intro c hc l hl
    obtain ⟨d, hd⟩ := Ideal.Quotient.mk_surjective (θ c)
    have hdrad := hθ4 c hc d hd
    have hψdrad : ψD d ∈
        (Ideal.span {e : B | Algebra.Smooth R (Localization.Away e)}).radical := by
      obtain ⟨n, hn⟩ := Ideal.mem_radical_iff.mp hdrad
      have hle : Ideal.map ψD (Ideal.span {e : D | Algebra.Smooth R (Localization.Away e)}) ≤
          (Ideal.span {e : B | Algebra.Smooth R (Localization.Away e)}).radical := by
        rw [Ideal.map_span, Ideal.span_le]
        rintro _ ⟨e, he, rfl⟩
        exact hψD e he
      have h1 := hle (Ideal.mem_map_of_mem ψD hn)
      rw [map_pow] at h1
      exact Ideal.mem_radical_of_pow_mem h1
    have h1 : χD d ∈ 𝔥 := by
      have h2 := key _ hψdrad
      rwa [← AlgHom.comp_apply, hχψD] at h2
    have h2 := hθ2 c d l hd hl
    have h3 : χD d - l ∈ 𝔥 := hpow𝔥 4 (by norm_num) h2
    have h4 : l = χD d - (χD d - l) := by ring
    rw [h4]
    exact Ideal.sub_mem _ h1 h3
  have hspan : Ideal.span (χbar '' {c : C | Algebra.Smooth (R ⧸ Ideal.span {π ^ 8})
      (Localization.Away c)}) ≤
      Ideal.map (Ideal.Quotient.mk (Ideal.map (algebraMap R Λ) (Ideal.span {π ^ 8}))) 𝔥 := by
    rw [Ideal.span_le]
    rintro _ ⟨c, hc, rfl⟩
    obtain ⟨l, hl⟩ := Ideal.Quotient.mk_surjective (χbar c)
    rw [← hl]
    exact Ideal.mem_map_of_mem _ (hK c hc l hl)

  have hnot : ¬ 𝔥 ≤ 𝔮 := by
    intro h
    apply hnotC
    haveI hprime : (𝔮.map (Ideal.Quotient.mk
        (Ideal.map (algebraMap R Λ) (Ideal.span {π ^ 8})))).IsPrime :=
      Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective
        (by rw [Ideal.mk_ker]; exact hker.trans h)
    rw [Ideal.IsPrime.radical_le_iff hprime]
    exact hspan.trans (Ideal.map_mono h)

  have hle7 : (Ideal.span (φ '' {a : A | Algebra.Smooth R (Localization.Away a)})).radical ≤
      𝔥 := by
    have h𝔥rad : 𝔥.radical = 𝔥 := by rw [← h𝔥, Ideal.radical_idem]
    rw [← h𝔥rad, Ideal.radical_le_radical_iff, h𝔥rad, Ideal.span_le]
    rintro _ ⟨a, ha, rfl⟩
    have hs10 := wc_pfc_smooth_localization_quotient R A (Ideal.span {π ^ 8}) a ha
    have hmem := hradC (Ideal.le_radical (Ideal.subset_span ⟨_, hs10, rfl⟩))
    rw [hφbar] at hmem
    have hmem2 := Ideal.radical_mono hspan hmem
    rw [← Ideal.map_radical_of_surjective Ideal.Quotient.mk_surjective
      (by rw [Ideal.mk_ker]; exact hker), h𝔥rad] at hmem2
    have h3 : φ a ∈ Ideal.comap (Ideal.Quotient.mk
        (Ideal.map (algebraMap R Λ) (Ideal.span {π ^ 8}))) (Ideal.map (Ideal.Quotient.mk
        (Ideal.map (algebraMap R Λ) (Ideal.span {π ^ 8}))) 𝔥) := Ideal.mem_comap.mpr hmem2
    rwa [Ideal.comap_map_of_surjective' _ Ideal.Quotient.mk_surjective, Ideal.mk_ker,
      sup_eq_left.mpr hker] at h3

  unfold wcPfcRes
  refine ⟨B, iB, aB, fpB, ψ, χ, hχψ, ?_, ?_⟩
  · rw [h𝔥]; exact hle7
  · rw [h𝔥]; exact hnot

theorem wc_pfc_lifting_lemma : ∀ (R : Type u) [CommRing R] [IsNoetherianRing R] (A : Type u) [CommRing A] [Algebra R A] [Algebra.FinitePresentation R A] (Λ : Type u) [CommRing Λ] [Algebra R Λ] (φ : A →ₐ[R] Λ) (𝔮 : Ideal Λ) [𝔮.IsPrime] (r : ℕ) (π : Fin r → R), (∀ i, algebraMap R Λ (π i) ∈ 𝔮) → wcPfcAnnSeq π → wcPfcAnnSeq (fun i => algebraMap R Λ (π i)) → (∀ i, wcPfcStrictStd R A (algebraMap R A (π i))) → ∀ (φbar : (A ⧸ Ideal.map (algebraMap R A) (wcPfcPowIdeal π)) →ₐ[R ⧸ wcPfcPowIdeal π] (Λ ⧸ Ideal.map (algebraMap R Λ) (wcPfcPowIdeal π))), (∀ a : A, φbar (Ideal.Quotient.mk _ a) = Ideal.Quotient.mk _ (φ a)) → wcPfcRes (R ⧸ wcPfcPowIdeal π) (A ⧸ Ideal.map (algebraMap R A) (wcPfcPowIdeal π)) (Λ ⧸ Ideal.map (algebraMap R Λ) (wcPfcPowIdeal π)) φbar (𝔮.map (Ideal.Quotient.mk (Ideal.map (algebraMap R Λ) (wcPfcPowIdeal π)))) → wcPfcRes R A Λ φ 𝔮 :=
by
  intro R _ _ A _ _ _ Λ _ _ φ 𝔮 _ r

  have quotHom : ∀ (R₀ : Type u) [CommRing R₀] (A₀ : Type u) [CommRing A₀] [Algebra R₀ A₀]
      (Λ₀ : Type u) [CommRing Λ₀] [Algebra R₀ Λ₀] (φ₀ : A₀ →ₐ[R₀] Λ₀) (J : Ideal R₀),
      ∃ φJ : (A₀ ⧸ Ideal.map (algebraMap R₀ A₀) J) →ₐ[R₀ ⧸ J] (Λ₀ ⧸ Ideal.map (algebraMap R₀ Λ₀) J),
        ∀ a : A₀, φJ (Ideal.Quotient.mk _ a) = Ideal.Quotient.mk _ (φ₀ a) := by
    intro R₀ _ A₀ _ _ Λ₀ _ _ φ₀ J
    have hle : Ideal.map (algebraMap R₀ A₀) J ≤
        Ideal.comap φ₀ (Ideal.map (algebraMap R₀ Λ₀) J) := by
      rw [Ideal.map_le_iff_le_comap]
      intro x hx
      rw [Ideal.mem_comap, Ideal.mem_comap, AlgHom.commutes]
      exact Ideal.mem_map_of_mem _ hx
    have hsurj : Function.Surjective (algebraMap R₀ (R₀ ⧸ J)) := fun x =>
      Ideal.Quotient.mk_surjective x
    exact ⟨AlgHom.extendScalarsOfSurjective hsurj (Ideal.quotientMapₐ _ φ₀ hle), fun a => rfl⟩
  induction r with
  | zero =>
    intro π hπ hannR hannΛ hss φbar hφbar hres
    have h0 : wcPfcPowIdeal π = ⊥ := by
      unfold wcPfcPowIdeal
      rw [Set.range_eq_empty, Ideal.span_empty]
    have hA0 : Ideal.map (algebraMap R A) (wcPfcPowIdeal π) = ⊥ := by rw [h0, Ideal.map_bot]
    have hΛ0 : Ideal.map (algebraMap R Λ) (wcPfcPowIdeal π) = ⊥ := by rw [h0, Ideal.map_bot]
    let eR := (Ideal.quotEquivOfEq h0).trans (RingEquiv.quotientBot R)
    let eA := (Ideal.quotEquivOfEq hA0).trans (RingEquiv.quotientBot A)
    let eΛ := (Ideal.quotEquivOfEq hΛ0).trans (RingEquiv.quotientBot Λ)
    have heR : ∀ x : R, eR (Ideal.Quotient.mk _ x) = x := fun x => by
      show RingEquiv.quotientBot R (Ideal.quotEquivOfEq h0 (Ideal.Quotient.mk _ x)) = x
      rw [Ideal.quotEquivOfEq_mk, RingEquiv.quotientBot_mk]
    have heA : ∀ x : A, eA (Ideal.Quotient.mk _ x) = x := fun x => by
      show RingEquiv.quotientBot A (Ideal.quotEquivOfEq hA0 (Ideal.Quotient.mk _ x)) = x
      rw [Ideal.quotEquivOfEq_mk, RingEquiv.quotientBot_mk]
    have heΛ : ∀ x : Λ, eΛ (Ideal.Quotient.mk _ x) = x := fun x => by
      show RingEquiv.quotientBot Λ (Ideal.quotEquivOfEq hΛ0 (Ideal.Quotient.mk _ x)) = x
      rw [Ideal.quotEquivOfEq_mk, RingEquiv.quotientBot_mk]
    refine wc_pfc_res_ring_equiv_transport _ _ _ R A Λ eR eA eΛ φbar φ _ 𝔮 ?_ ?_ ?_ ?_ hres
    · intro x
      obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective x
      rw [Ideal.Quotient.algebraMap_quotient_map_quotient, heA, heR]
    · intro x
      obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective x
      rw [Ideal.Quotient.algebraMap_quotient_map_quotient, heΛ, heR]
    · intro a
      obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective a
      rw [hφbar, heA, heΛ]
    · ext y
      rw [Ideal.mem_map_of_equiv]
      constructor
      · intro hy
        exact ⟨Ideal.Quotient.mk _ y, Ideal.mem_map_of_mem _ hy, heΛ y⟩
      · rintro ⟨x, hx, rfl⟩
        obtain ⟨z, rfl⟩ := Ideal.Quotient.mk_surjective x
        rw [heΛ]
        exact (Ideal.mem_quotient_iff_mem (by rw [hΛ0]; exact bot_le)).mp hx
  | succ r ih =>
    intro π hπ hannR hannΛ hss φbar hφbar hres

    have K1 : ∀ {S : Type u} [CommRing S] (x : Fin (r + 1) → S) (i : Fin r),
        (fun j : Fin r => x j.castSucc ^ 8) '' {j | j < i} =
          (fun j : Fin (r + 1) => x j ^ 8) '' {j | j < i.castSucc} := by
      intro S _ x i
      ext y
      simp only [Set.mem_image, Set.mem_setOf_eq]
      constructor
      · rintro ⟨j, hj, rfl⟩
        exact ⟨j.castSucc, Fin.castSucc_lt_castSucc_iff.mpr hj, rfl⟩
      · rintro ⟨j, hj, rfl⟩
        have hne : j ≠ Fin.last r := ne_of_lt (lt_trans hj (Fin.castSucc_lt_last i))
        obtain ⟨j', rfl⟩ := Fin.exists_castSucc_eq.mpr hne
        exact ⟨j', Fin.castSucc_lt_castSucc_iff.mp hj, rfl⟩
    have K2 : ∀ {S : Type u} [CommRing S] (x : Fin (r + 1) → S),
        (fun j : Fin (r + 1) => x j ^ 8) '' {j | j < Fin.last r} =
          Set.range (fun j : Fin r => x j.castSucc ^ 8) := by
      intro S _ x
      ext y
      simp only [Set.mem_image, Set.mem_setOf_eq, Set.mem_range]
      constructor
      · rintro ⟨j, hj, rfl⟩
        obtain ⟨j', rfl⟩ := Fin.exists_castSucc_eq.mpr (ne_of_lt hj)
        exact ⟨j', rfl⟩
      · rintro ⟨j', rfl⟩
        exact ⟨j'.castSucc, Fin.castSucc_lt_last j', rfl⟩

    have hann0 : ∀ {S : Type u} [CommRing S] (x : Fin (r + 1) → S), wcPfcAnnSeq x →
        wcPfcAnnSeq (fun i : Fin r => x i.castSucc) := by
      intro S _ x hx i y hy
      have e := K1 x i
      have hy' : y * x i.castSucc ^ 2 ∈
          Ideal.span ((fun j : Fin (r + 1) => x j ^ 8) '' {j | j < i.castSucc}) := by
        rw [← e]; exact hy
      have h2 := hx i.castSucc y hy'
      rw [← e] at h2
      exact h2
    obtain ⟨I, hIdef⟩ : ∃ I : Ideal R, I = wcPfcPowIdeal (fun i : Fin r => π i.castSucc) :=
      ⟨_, rfl⟩
    have hJ : wcPfcPowIdeal π = I ⊔ Ideal.span {π (Fin.last r) ^ 8} := by
      rw [hIdef]
      unfold wcPfcPowIdeal
      have hrange : Set.range (fun i : Fin (r + 1) => π i ^ 8) =
          insert (π (Fin.last r) ^ 8) (Set.range fun i : Fin r => π i.castSucc ^ 8) := by
        ext y
        simp only [Set.mem_range, Set.mem_insert_iff]
        constructor
        · rintro ⟨i, rfl⟩
          rcases Fin.eq_castSucc_or_eq_last i with ⟨j, rfl⟩ | rfl
          · exact Or.inr ⟨j, rfl⟩
          · exact Or.inl rfl
        · rintro (rfl | ⟨j, rfl⟩)
          · exact ⟨Fin.last r, rfl⟩
          · exact ⟨j.castSucc, rfl⟩
      rw [hrange, Ideal.span_insert, sup_comm]

    have hIΛ : Ideal.map (algebraMap R Λ) I ≤ 𝔮 := by
      rw [hIdef]
      unfold wcPfcPowIdeal
      rw [Ideal.map_span, Ideal.span_le]
      rintro _ ⟨_, ⟨i, rfl⟩, rfl⟩
      rw [map_pow]
      exact Ideal.pow_mem_of_mem _ (hπ _) 8 (by norm_num)
    have h𝔮' : (𝔮.map (Ideal.Quotient.mk (Ideal.map (algebraMap R Λ) I))).IsPrime :=
      Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective
        (by rw [Ideal.mk_ker]; exact hIΛ)

    obtain ⟨φI, hφI⟩ := quotHom R A Λ φ I

    have hfpI : Algebra.FinitePresentation (R ⧸ I) (A ⧸ Ideal.map (algebraMap R A) I) :=
      wc_pfc_cz_fp_quotient_base_change R A I

    have f1 : algebraMap (R ⧸ I) (Λ ⧸ Ideal.map (algebraMap R Λ) I)
        (Ideal.Quotient.mk I (π (Fin.last r))) ∈
          𝔮.map (Ideal.Quotient.mk (Ideal.map (algebraMap R Λ) I)) := by
      rw [Ideal.Quotient.algebraMap_quotient_map_quotient]
      exact Ideal.mem_map_of_mem _ (hπ _)
    have f2 : ∀ y : R ⧸ I, y * Ideal.Quotient.mk I (π (Fin.last r)) ^ 2 = 0 →
        y * Ideal.Quotient.mk I (π (Fin.last r)) = 0 := by
      intro y hy
      obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective y
      rw [← map_pow, ← map_mul, Ideal.Quotient.eq_zero_iff_mem] at hy
      rw [← map_mul, Ideal.Quotient.eq_zero_iff_mem]
      have h := hannR (Fin.last r) y
      rw [K2 π] at h
      rw [hIdef] at hy ⊢
      exact h hy
    have hIΛspan : Ideal.map (algebraMap R Λ) I = Ideal.span
        ((fun j : Fin (r + 1) => algebraMap R Λ (π j) ^ 8) '' {j | j < Fin.last r}) := by
      rw [K2 (fun i => algebraMap R Λ (π i)), hIdef]
      unfold wcPfcPowIdeal
      rw [Ideal.map_span, ← Set.range_comp]
      congr 1
      congr 1
      funext i
      simp [Function.comp, map_pow]
    have f3 : ∀ y : Λ ⧸ Ideal.map (algebraMap R Λ) I,
        y * algebraMap (R ⧸ I) (Λ ⧸ Ideal.map (algebraMap R Λ) I)
          (Ideal.Quotient.mk I (π (Fin.last r))) ^ 2 = 0 →
        y * algebraMap (R ⧸ I) (Λ ⧸ Ideal.map (algebraMap R Λ) I)
          (Ideal.Quotient.mk I (π (Fin.last r))) = 0 := by
      intro y hy
      rw [Ideal.Quotient.algebraMap_quotient_map_quotient] at hy ⊢
      obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective y
      rw [← map_pow, ← map_mul, Ideal.Quotient.eq_zero_iff_mem] at hy
      rw [← map_mul, Ideal.Quotient.eq_zero_iff_mem]
      rw [hIΛspan] at hy ⊢
      exact hannΛ (Fin.last r) y hy
    have f4 : wcPfcStrictStd (R ⧸ I) (A ⧸ Ideal.map (algebraMap R A) I)
        (algebraMap (R ⧸ I) (A ⧸ Ideal.map (algebraMap R A) I)
          (Ideal.Quotient.mk I (π (Fin.last r)))) := by
      rw [Ideal.Quotient.algebraMap_quotient_map_quotient]
      exact wc_pfc_strict_std_quotient R A I _ (hss (Fin.last r))
    obtain ⟨φII, hφII⟩ := quotHom (R ⧸ I) (A ⧸ Ideal.map (algebraMap R A) I)
      (Λ ⧸ Ideal.map (algebraMap R Λ) I) φI
      (Ideal.span {Ideal.Quotient.mk I (π (Fin.last r)) ^ 8})
    have f6 := wc_pfc_res_quot_quot R A Λ φ 𝔮 I (wcPfcPowIdeal π) (π (Fin.last r)) hJ φbar hφbar
      φI hφI φII hφII hres

    have hresI := @wc_pfc_lift_one_step (R ⧸ I) _ _ (A ⧸ Ideal.map (algebraMap R A) I) _ _ hfpI
      (Λ ⧸ Ideal.map (algebraMap R Λ) I) _ _ φI
      (𝔮.map (Ideal.Quotient.mk (Ideal.map (algebraMap R Λ) I))) h𝔮'
      (Ideal.Quotient.mk I (π (Fin.last r))) f1 f2 f3 f4 φII hφII f6

    subst hIdef
    exact ih (fun i => π i.castSucc) (fun i => hπ i.castSucc) (hann0 π hannR)
      (hann0 (fun i => algebraMap R Λ (π i)) hannΛ) (fun i => hss i.castSucc) φI hφI hresI

theorem wc_pfc_lifting_mod_powers : ∀ (R : Type u) [CommRing R] [IsNoetherianRing R] (A : Type u) [CommRing A] [Algebra R A] [Algebra.FinitePresentation R A] (r : ℕ) (t : Fin r → R), (∀ i, Algebra.Smooth R (Localization.Away (algebraMap R A (t i)))) → ∃ e : ℕ, 0 < e ∧ ∀ (Λ : Type u) [CommRing Λ] [Algebra R Λ] (φ : A →ₐ[R] Λ) (𝔮 : Ideal Λ) [𝔮.IsPrime], (∀ i, algebraMap R Λ (t i) ∈ 𝔮) → (∀ (i : Fin r) (y : R), t i ^ 2 * y ∈ Ideal.span ((fun j => t j ^ e) '' {j | j < i}) → t i * y ∈ Ideal.span ((fun j => t j ^ e) '' {j | j < i})) → (∀ (i : Fin r) (y : Λ), algebraMap R Λ (t i) ^ 2 * y ∈ Ideal.span ((fun j => algebraMap R Λ (t j) ^ e) '' {j | j < i}) → algebraMap R Λ (t i) * y ∈ Ideal.span ((fun j => algebraMap R Λ (t j) ^ e) '' {j | j < i})) → (∀ (A' : Type u) [CommRing A'] [Algebra R A'] [Algebra.FinitePresentation R A'] (φ' : A' →ₐ[R] Λ) (φb : (A' ⧸ Ideal.map (algebraMap R A') (Ideal.span (Set.range fun i => t i ^ e))) →ₐ[R ⧸ Ideal.span (Set.range fun i => t i ^ e)] (Λ ⧸ Ideal.map (algebraMap R Λ) (Ideal.span (Set.range fun i => t i ^ e)))), (∀ x, φb (Ideal.Quotient.mk _ x) = Ideal.Quotient.mk _ (φ' x)) → ∃ (C : Type u) (_ : CommRing C) (_ : Algebra (R ⧸ Ideal.span (Set.range fun i => t i ^ e)) C) (_ : Algebra.FinitePresentation (R ⧸ Ideal.span (Set.range fun i => t i ^ e)) C) (ψ : (A' ⧸ Ideal.map (algebraMap R A') (Ideal.span (Set.range fun i => t i ^ e))) →ₐ[R ⧸ Ideal.span (Set.range fun i => t i ^ e)] C) (χ : C →ₐ[R ⧸ Ideal.span (Set.range fun i => t i ^ e)] (Λ ⧸ Ideal.map (algebraMap R Λ) (Ideal.span (Set.range fun i => t i ^ e)))), χ.comp ψ = φb ∧ (Ideal.span (φb '' {a | Algebra.Smooth (R ⧸ Ideal.span (Set.range fun i => t i ^ e)) (Localization.Away a)})).radical ≤ (Ideal.span (χ '' {b | Algebra.Smooth (R ⧸ Ideal.span (Set.range fun i => t i ^ e)) (Localization.Away b)})).radical ∧ ¬ (Ideal.span (χ '' {b | Algebra.Smooth (R ⧸ Ideal.span (Set.range fun i => t i ^ e)) (Localization.Away b)})).radical ≤ Ideal.map (Ideal.Quotient.mk _) 𝔮) → ∃ (B : Type u) (_ : CommRing B) (_ : Algebra R B) (_ : Algebra.FinitePresentation R B) (ψ : A →ₐ[R] B) (χ : B →ₐ[R] Λ), χ.comp ψ = φ ∧ (Ideal.span (φ '' {a : A | Algebra.Smooth R (Localization.Away a)})).radical ≤ (Ideal.span (χ '' {b : B | Algebra.Smooth R (Localization.Away b)})).radical ∧ ¬ (Ideal.span (χ '' {b : B | Algebra.Smooth R (Localization.Away b)})).radical ≤ 𝔮 :=
by
  intro R _ _ A _ _ _ r t ht
  classical

  obtain ⟨C, iC, aC, fpC, ι, ρ, hρι, hsm⟩ := wc_pfc_lmp_elkik_presentation R A
  have hCt : ∀ i, Algebra.Smooth R (Localization.Away (algebraMap R C (t i))) ∧
      Module.Free (Localization.Away (algebraMap R C (t i)))
        (Ω[Localization.Away (algebraMap R C (t i))⁄R]) := by
    intro i
    have h := hsm _ (ht i)
    rw [AlgHom.commutes] at h
    exact h

  have he₀ : ∀ i, ∃ e₀ : ℕ, ∀ e : ℕ, e₀ ≤ e → wcPfcStrictStd R C ((algebraMap R C (t i)) ^ e) :=
    fun i => wc_pfc_lmp_strictly_standard_powers R C _ (hCt i).1 (hCt i).2
  choose e₀ he₀ using he₀
  obtain ⟨c, hc1, hce⟩ : ∃ c : ℕ, 0 < c ∧ ∀ i, e₀ i ≤ c := by
    refine ⟨1 + ∑ i, e₀ i, by omega, fun i => ?_⟩
    have := Finset.single_le_sum (f := e₀) (fun j _ => Nat.zero_le _) (Finset.mem_univ i)
    omega
  refine ⟨c * 8, by omega, ?_⟩
  intro Λ _ _ φ 𝔮 _ hq hAnnR hAnnΛ hOracle

  have annpow : ∀ (S : Type u) [CommRing S] (K : Ideal S) (x : S),
      (∀ y : S, x ^ 2 * y ∈ K → x * y ∈ K) → ∀ y : S, y * (x ^ c) ^ 2 ∈ K → y * x ^ c ∈ K := by
    intro S _ K x hx y hy
    have step : ∀ k : ℕ, y * x ^ (k + 2) ∈ K → y * x ^ (k + 1) ∈ K := by
      intro k hk
      have h1 : x ^ 2 * (y * x ^ k) ∈ K := by
        have e : x ^ 2 * (y * x ^ k) = y * x ^ (k + 2) := by ring
        rw [e]; exact hk
      have h2 := hx (y * x ^ k) h1
      have e : x * (y * x ^ k) = y * x ^ (k + 1) := by ring
      rw [e] at h2; exact h2
    have key : ∀ j : ℕ, y * x ^ (c + j) ∈ K → y * x ^ c ∈ K := by
      intro j
      induction j with
      | zero => intro h; simpa using h
      | succ j ih =>
        intro h
        apply ih
        have e1 : c + (j + 1) = (c - 1 + j) + 2 := by omega
        rw [e1] at h
        have h3 := step _ h
        have e2 : c - 1 + j + 1 = c + j := by omega
        rw [e2] at h3
        exact h3
    apply key c
    rw [← pow_mul] at hy
    have e3 : c * 2 = c + c := by omega
    rw [e3] at hy
    exact hy

  have hfun : (fun j => t j ^ (c * 8)) = (fun j => (t j ^ c) ^ 8) :=
    funext fun j => pow_mul _ _ _
  have hfunΛ : (fun j => algebraMap R Λ (t j) ^ (c * 8)) = (fun j => (algebraMap R Λ (t j ^ c)) ^ 8) :=
    funext fun j => by rw [map_pow, ← pow_mul]
  have hJ : Ideal.span (Set.range fun i => t i ^ (c * 8)) = wcPfcPowIdeal (fun i => t i ^ c) := by
    unfold wcPfcPowIdeal
    rw [hfun]

  have hπq : ∀ i, algebraMap R Λ (t i ^ c) ∈ 𝔮 := fun i => by
    rw [map_pow]; exact Ideal.pow_mem_of_mem 𝔮 (hq i) c hc1
  have hAnnπ : wcPfcAnnSeq (fun i => t i ^ c) := by
    intro i y hy
    have hy' : y * (t i ^ c) ^ 2 ∈ Ideal.span ((fun j => t j ^ (c * 8)) '' {j | j < i}) := by
      rw [hfun]; exact hy
    have h := annpow R _ (t i) (hAnnR i) y hy'
    rw [hfun] at h
    exact h
  have hAnnπΛ : wcPfcAnnSeq (fun i => algebraMap R Λ (t i ^ c)) := by
    intro i y hy
    have hy' : y * (algebraMap R Λ (t i) ^ c) ^ 2 ∈
        Ideal.span ((fun j => algebraMap R Λ (t j) ^ (c * 8)) '' {j | j < i}) := by
      rw [hfunΛ, ← map_pow]; exact hy
    have h := annpow Λ _ (algebraMap R Λ (t i)) (hAnnΛ i) y hy'
    rw [hfunΛ, ← map_pow] at h
    exact h
  have hstd : ∀ i, wcPfcStrictStd R C (algebraMap R C (t i ^ c)) := fun i => by
    rw [map_pow]; exact he₀ i c (hce i)

  have hle : Ideal.map (algebraMap R C) (wcPfcPowIdeal (fun i => t i ^ c)) ≤
      Ideal.comap (φ.comp ρ) (Ideal.map (algebraMap R Λ) (wcPfcPowIdeal (fun i => t i ^ c))) := by
    refine Ideal.map_le_iff_le_comap.mpr (fun y hy => ?_)
    rw [Ideal.mem_comap, Ideal.mem_comap, AlgHom.commutes]
    exact Ideal.mem_map_of_mem _ hy
  have hsurj : Function.Surjective (algebraMap R (R ⧸ wcPfcPowIdeal (fun i => t i ^ c))) := by
    intro x
    obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective x
    exact ⟨y, rfl⟩
  let φbar : (C ⧸ Ideal.map (algebraMap R C) (wcPfcPowIdeal (fun i => t i ^ c))) →ₐ[R ⧸ wcPfcPowIdeal (fun i => t i ^ c)]
      (Λ ⧸ Ideal.map (algebraMap R Λ) (wcPfcPowIdeal (fun i => t i ^ c))) :=
    AlgHom.extendScalarsOfSurjective hsurj (Ideal.quotientMapₐ _ (φ.comp ρ) hle)
  have hφbar : ∀ a : C, φbar (Ideal.Quotient.mk _ a) = Ideal.Quotient.mk _ ((φ.comp ρ) a) :=
    fun a => rfl

  rw [hJ] at hOracle
  obtain ⟨Cb, iCb, aCb, fpCb, ψb, χb, h1, h2, h3⟩ := hOracle C (φ.comp ρ) φbar hφbar
  have hres : wcPfcRes (R ⧸ wcPfcPowIdeal (fun i => t i ^ c))
      (C ⧸ Ideal.map (algebraMap R C) (wcPfcPowIdeal (fun i => t i ^ c)))
      (Λ ⧸ Ideal.map (algebraMap R Λ) (wcPfcPowIdeal (fun i => t i ^ c))) φbar
      (𝔮.map (Ideal.Quotient.mk (Ideal.map (algebraMap R Λ) (wcPfcPowIdeal (fun i => t i ^ c))))) :=
    ⟨Cb, iCb, aCb, fpCb, ψb, χb, h1, h2, h3⟩

  obtain ⟨B, iB, aB, fpB, ψB, χ, hcomp, hrad, hnot⟩ :=
    wc_pfc_lifting_lemma R C Λ (φ.comp ρ) 𝔮 r (fun i => t i ^ c) hπq hAnnπ hAnnπΛ hstd φbar hφbar hres

  refine ⟨B, iB, aB, fpB, ψB.comp ι, χ, ?_, ?_, hnot⟩
  · rw [← AlgHom.comp_assoc, hcomp, AlgHom.comp_assoc, hρι, AlgHom.comp_id]
  · refine le_trans (Ideal.radical_mono (Ideal.span_mono ?_)) hrad
    rintro _ ⟨a, ha, rfl⟩
    refine ⟨ι a, (hsm a ha).1, ?_⟩
    show φ (ρ (ι a)) = φ a
    rw [← AlgHom.comp_apply ρ ι, hρι, AlgHom.id_apply]

theorem wc_pfc_artinian_localization : ∀ (R : Type u) [CommRing R] (A : Type u) [CommRing A] [Algebra R A] [Algebra.FinitePresentation R A] (Λ : Type u) [CommRing Λ] [IsNoetherianRing Λ] [Algebra R Λ] (φ : A →ₐ[R] Λ) (𝔮 : Ideal Λ) [𝔮.IsPrime], 𝔮 ∈ minimalPrimes Λ → (∃ (C : Type u) (_ : CommRing C) (_ : Algebra R C) (_ : Algebra.Smooth R C) (ψ : A →ₐ[R] C) (γ : C →ₐ[R] Localization.AtPrime 𝔮), γ.comp ψ = (IsScalarTower.toAlgHom R Λ (Localization.AtPrime 𝔮)).comp φ) → ∃ (B : Type u) (_ : CommRing B) (_ : Algebra R B) (_ : Algebra.FinitePresentation R B) (ψ : A →ₐ[R] B) (χ : B →ₐ[R] Λ), χ.comp ψ = φ ∧ (Ideal.span (φ '' {a : A | Algebra.Smooth R (Localization.Away a)})).radical ≤ (Ideal.span (χ '' {b : B | Algebra.Smooth R (Localization.Away b)})).radical ∧ ¬ (Ideal.span (χ '' {b : B | Algebra.Smooth R (Localization.Away b)})).radical ≤ 𝔮 :=
by
  intro R _ A _ _ _ Λ _ _ _ φ 𝔮 _ h𝔮 hC
  classical

  have s1 : ∀ (Λ : Type u) [CommRing Λ] (𝔮 : Ideal Λ) [𝔮.IsPrime], 𝔮 ∈ minimalPrimes Λ → ∀ (r : ℕ) (x : Fin r → Λ), (∀ i, x i ∈ 𝔮) → ∃ (l : Λ) (N : ℕ), l ∉ 𝔮 ∧ ∀ i, l * x i ^ N = 0 := by
    intro Λ _ 𝔮 _ h𝔮 r x hx
    have key : ∀ i, ∃ (m : Λ) (n : ℕ), m ∉ 𝔮 ∧ m * x i ^ n = 0 := by
      intro i
      have hnil : IsNilpotent (algebraMap Λ (Localization.AtPrime 𝔮) (x i)) := by
        rw [nilpotent_iff_mem_prime]
        intro J hJ
        have hJ' : (J.comap (algebraMap Λ (Localization.AtPrime 𝔮))).IsPrime := Ideal.comap_isPrime _ J
        have hle : J.comap (algebraMap Λ (Localization.AtPrime 𝔮)) ≤ 𝔮 := by
          intro y hy
          by_contra hy'
          have hu : IsUnit (algebraMap Λ (Localization.AtPrime 𝔮) y) :=
            IsLocalization.map_units _ (⟨y, hy'⟩ : 𝔮.primeCompl)
          exact hJ.ne_top (Ideal.eq_top_of_isUnit_mem J hy hu)
        have hge : 𝔮 ≤ J.comap (algebraMap Λ (Localization.AtPrime 𝔮)) :=
          h𝔮.2 ⟨hJ', bot_le⟩ hle
        exact hge (hx i)
      obtain ⟨n, hn⟩ := hnil
      rw [← map_pow] at hn
      obtain ⟨⟨m, hm⟩, hm0⟩ := (IsLocalization.map_eq_zero_iff 𝔮.primeCompl _ _).mp hn
      exact ⟨m, n, hm, hm0⟩
    choose m n hm hmn using key
    refine ⟨∏ i, m i, ∑ i, n i, ?_, fun i => ?_⟩
    · exact Submonoid.prod_mem 𝔮.primeCompl (fun i _ => hm i)
    · have hle : n i ≤ ∑ j, n j :=
        Finset.single_le_sum (f := n) (fun _ _ => Nat.zero_le _) (Finset.mem_univ i)
      obtain ⟨k, hk⟩ := Nat.exists_eq_add_of_le hle
      rw [hk, pow_add, ← Finset.mul_prod_erase _ m (Finset.mem_univ i)]
      have : m i * (∏ j ∈ Finset.univ.erase i, m j) * (x i ^ n i * x i ^ k)
          = (m i * x i ^ n i) * ((∏ j ∈ Finset.univ.erase i, m j) * x i ^ k) := by ring
      rw [this, hmn i, zero_mul]

  have s3 : ∀ (A : Type u) [CommRing A] (m : ℕ) (f : MvPolynomial (Fin m) A), ∃ (D : ℕ) (F : MvPolynomial (Fin (m + 1)) A), ∀ (T : Type u) [CommRing T] (ρ : A →+* T) (t₀ v : T), v * t₀ = 1 → ∀ (t : Fin m → T), MvPolynomial.eval₂ ρ (Fin.cons t₀ t) F = t₀ ^ D * MvPolynomial.eval₂ ρ (fun j => t j * v) f := by
    intro A _ m f
    induction f using MvPolynomial.induction_on with
    | C a =>
      refine ⟨0, MvPolynomial.C a, ?_⟩
      intro T _ ρ t₀ v hv t
      simp
    | add p q hp hq =>
      obtain ⟨Dp, Fp, hp⟩ := hp
      obtain ⟨Dq, Fq, hq⟩ := hq
      refine ⟨Dp + Dq, MvPolynomial.X 0 ^ Dq * Fp + MvPolynomial.X 0 ^ Dp * Fq, ?_⟩
      intro T _ ρ t₀ v hv t
      simp only [MvPolynomial.eval₂_add, MvPolynomial.eval₂_mul, MvPolynomial.eval₂_pow,
        MvPolynomial.eval₂_X, Fin.cons_zero, hp T ρ t₀ v hv t, hq T ρ t₀ v hv t]
      ring
    | mul_X p n hp =>
      obtain ⟨Dp, Fp, hp⟩ := hp
      refine ⟨Dp + 1, Fp * MvPolynomial.X n.succ, ?_⟩
      intro T _ ρ t₀ v hv t
      simp only [MvPolynomial.eval₂_mul, MvPolynomial.eval₂_X, Fin.cons_succ, hp T ρ t₀ v hv t]
      linear_combination (-(t₀ ^ Dp * MvPolynomial.eval₂ ρ (fun j => t j * v) p * t n)) * hv

  have s4 : ∀ (R : Type u) [CommRing R] (A : Type u) [CommRing A] [Algebra R A] [Algebra.FinitePresentation R A] (C : Type u) [CommRing C] [Algebra R C] [Algebra.FinitePresentation R C] (ψ : A →ₐ[R] C), ∃ (m c : ℕ) (f : Fin c → MvPolynomial (Fin m) A) (π : MvPolynomial (Fin m) A →ₐ[R] C), Function.Surjective π ∧ (∀ a, π (MvPolynomial.C a) = ψ a) ∧ RingHom.ker π = Ideal.span (Set.range f) := by
    intro R _ A _ _ _ C _ _ _ ψ
    letI : Algebra A C := ψ.toRingHom.toAlgebra
    haveI : IsScalarTower R A C := IsScalarTower.of_algebraMap_eq (fun x => (ψ.commutes x).symm)
    haveI : Algebra.FinitePresentation A C :=
      Algebra.FinitePresentation.of_restrict_scalars_finitePresentation R A C
    obtain ⟨n, g, hg, hker⟩ := Algebra.FinitePresentation.out (R := A) (A := C)
    obtain ⟨c, f, hf⟩ := Submodule.fg_iff_exists_fin_generating_family.mp hker
    refine ⟨n, c, f, g.restrictScalars R, hg, fun a => ?_, ?_⟩
    · rw [AlgHom.restrictScalars_apply, ← MvPolynomial.algebraMap_eq, AlgHom.commutes]
      rfl
    · ext p
      rw [RingHom.mem_ker, AlgHom.restrictScalars_apply]
      change _ ↔ p ∈ Submodule.span (MvPolynomial (Fin n) A) (Set.range f)
      rw [hf, RingHom.mem_ker]
      rfl

  have s5 : ∀ (R : Type u) [CommRing R] (A : Type u) [CommRing A] [Algebra R A] (Λ : Type u) [CommRing Λ] [Algebra R Λ] (φ : A →ₐ[R] Λ) (𝔮 : Ideal Λ) [𝔮.IsPrime] (C : Type u) [CommRing C] [Algebra R C] (ψ : A →ₐ[R] C) (γ : C →ₐ[R] Localization.AtPrime 𝔮), γ.comp ψ = (IsScalarTower.toAlgHom R Λ (Localization.AtPrime 𝔮)).comp φ → ∀ (m c : ℕ) (f : Fin c → MvPolynomial (Fin m) A) (π : MvPolynomial (Fin m) A →ₐ[R] C), (∀ a, π (MvPolynomial.C a) = ψ a) → (∀ l, π (f l) = 0) → ∀ (D : Fin c → ℕ) (F : Fin c → MvPolynomial (Fin (m + 1)) A), (∀ l (T : Type u) [CommRing T] (ρ : A →+* T) (t₀ v : T), v * t₀ = 1 → ∀ t : Fin m → T, MvPolynomial.eval₂ ρ (Fin.cons t₀ t) (F l) = t₀ ^ D l * MvPolynomial.eval₂ ρ (fun j => t j * v) (f l)) → ∃ (s : Λ) (μ : Fin m → Λ) (l₀ : Λ), s ∉ 𝔮 ∧ l₀ ∉ 𝔮 ∧ ∀ l, l₀ * MvPolynomial.eval₂ φ.toRingHom (Fin.cons s μ) (F l) = 0 := by
    intro R _ A _ _ Λ _ _ φ 𝔮 _ C _ _ ψ γ hγ m c f π hπC hf D F hF
    set ι := algebraMap Λ (Localization.AtPrime 𝔮) with hι
    obtain ⟨⟨b, hb⟩, hbint⟩ := IsLocalization.exist_integer_multiples 𝔮.primeCompl
      (Finset.univ : Finset (Fin m)) (fun j => γ (π (MvPolynomial.X j)))
    have hμ : ∀ j : Fin m, ∃ μ : Λ, ι μ = ι b * γ (π (MvPolynomial.X j)) := by
      intro j
      obtain ⟨μ, hμ⟩ := hbint j (Finset.mem_univ j)
      refine ⟨μ, ?_⟩
      rw [Algebra.smul_def] at hμ
      exact hμ
    choose μ hμ using hμ
    obtain ⟨u, hu⟩ := IsLocalization.map_units (Localization.AtPrime 𝔮) (⟨b, hb⟩ : 𝔮.primeCompl)
    have hγψ : ∀ a, γ (ψ a) = ι (φ a) := fun a => by
      have := congrArg (fun g => g a) hγ
      simpa using this
    have hev : ∀ p : MvPolynomial (Fin m) A,
        MvPolynomial.eval₂ (ι.comp φ.toRingHom) (fun j => γ (π (MvPolynomial.X j))) p = γ (π p) := by
      intro p
      induction p using MvPolynomial.induction_on with
      | C a => simp [hπC, hγψ]
      | add p q hp hq => rw [MvPolynomial.eval₂_add, hp, hq, map_add, map_add]
      | mul_X p n hp => rw [MvPolynomial.eval₂_mul, hp, MvPolynomial.eval₂_X, map_mul, map_mul]
    have hzero : ∀ l, ι (MvPolynomial.eval₂ φ.toRingHom (Fin.cons b μ) (F l)) = 0 := by
      intro l
      rw [MvPolynomial.eval₂_comp_left, Fin.comp_cons]
      have hv : (↑u⁻¹ : Localization.AtPrime 𝔮) * ι b = 1 := by
        rw [← hu]; exact Units.inv_mul u
      rw [hF l _ (ι.comp φ.toRingHom) (ι b) (↑u⁻¹) hv (ι ∘ μ)]
      have hfun : (fun j => (ι ∘ μ) j * ↑u⁻¹) = (fun j => γ (π (MvPolynomial.X j))) := by
        funext j
        simp only [Function.comp_apply]
        rw [hμ j, mul_comm (ι b), mul_assoc, ← hu, Units.mul_inv, mul_one]
      rw [hfun, hev, hf l, map_zero, mul_zero]
    have hann : ∀ l, ∃ n : Λ, n ∉ 𝔮 ∧ n * MvPolynomial.eval₂ φ.toRingHom (Fin.cons b μ) (F l) = 0 := by
      intro l
      obtain ⟨⟨n, hn⟩, hn0⟩ := (IsLocalization.map_eq_zero_iff 𝔮.primeCompl _ _).mp (hzero l)
      exact ⟨n, hn, hn0⟩
    choose n hn hn0 using hann
    refine ⟨b, μ, ∏ l, n l, hb, Submonoid.prod_mem 𝔮.primeCompl (fun l _ => hn l), fun l => ?_⟩
    rw [← Finset.mul_prod_erase _ n (Finset.mem_univ l), mul_comm (n l), mul_assoc, hn0 l, mul_zero]

  have s6 : ∀ (R : Type u) [CommRing R] (A : Type u) [CommRing A] [Algebra R A] (C : Type u) [CommRing C] [Algebra R C] [Algebra.Smooth R C] (m c r : ℕ) (f : Fin c → MvPolynomial (Fin m) A) (π : MvPolynomial (Fin m) A →ₐ[R] C), Function.Surjective π → RingHom.ker π = Ideal.span (Set.range f) → ∀ (D : Fin c → ℕ) (F : Fin c → MvPolynomial (Fin (m + 1)) A), (∀ l (T : Type u) [CommRing T] (ρ : A →+* T) (t₀ v : T), v * t₀ = 1 → ∀ t : Fin m → T, MvPolynomial.eval₂ ρ (Fin.cons t₀ t) (F l) = t₀ ^ D l * MvPolynomial.eval₂ ρ (fun j => t j * v) (f l)) → Algebra.Smooth R (Localization.Away (Ideal.Quotient.mk (Ideal.span (Set.range (fun l => (MvPolynomial.X (Sum.inr none) : MvPolynomial (Fin (m + 1) ⊕ Option (Fin r)) A) * MvPolynomial.rename Sum.inl (F l)) ∪ Set.range (fun i => (MvPolynomial.X (Sum.inr none) : MvPolynomial (Fin (m + 1) ⊕ Option (Fin r)) A) * MvPolynomial.X (Sum.inr (some i))))) (MvPolynomial.X (Sum.inr none) * MvPolynomial.X (Sum.inl 0)))) := by
    intro R _ A _ _ C _ _ _ m c r f π hsurj hker D F hF
    generalize hIdef : Ideal.span (Set.range (fun l => (MvPolynomial.X (Sum.inr none) : MvPolynomial (Fin (m + 1) ⊕ Option (Fin r)) A) * MvPolynomial.rename Sum.inl (F l)) ∪ Set.range (fun i => (MvPolynomial.X (Sum.inr none) : MvPolynomial (Fin (m + 1) ⊕ Option (Fin r)) A) * MvPolynomial.X (Sum.inr (some i)))) = I
    have hg1 : ∀ l, (MvPolynomial.X (Sum.inr none) : MvPolynomial (Fin (m + 1) ⊕ Option (Fin r)) A) *
        MvPolynomial.rename Sum.inl (F l) ∈ I := fun l => hIdef ▸ Ideal.subset_span (Or.inl ⟨l, rfl⟩)
    have hg2 : ∀ i, (MvPolynomial.X (Sum.inr none) : MvPolynomial (Fin (m + 1) ⊕ Option (Fin r)) A) *
        MvPolynomial.X (Sum.inr (some i)) ∈ I := fun i => hIdef ▸ Ideal.subset_span (Or.inr ⟨i, rfl⟩)
    generalize hb : Ideal.Quotient.mk I (MvPolynomial.X (Sum.inr none) * MvPolynomial.X (Sum.inl 0)) = b
    obtain ⟨xx, hxx⟩ : ∃ x : MvPolynomial (Fin 2) C, x = MvPolynomial.X 0 * MvPolynomial.X 1 := ⟨_, rfl⟩
    haveI : Algebra.Smooth C (Localization.Away xx) :=
      Algebra.Smooth.comp C (MvPolynomial (Fin 2) C) (Localization.Away xx)
    haveI : Algebra.Smooth R (Localization.Away xx) :=
      Algebra.Smooth.comp R C (Localization.Away xx)
    have hπf : ∀ l, π (f l) = 0 := fun l => by
      rw [← RingHom.mem_ker, hker]; exact Ideal.subset_span ⟨l, rfl⟩
    let αT : MvPolynomial (Fin 2) C →+* Localization.Away xx :=
      algebraMap (MvPolynomial (Fin 2) C) (Localization.Away xx)
    let πh : MvPolynomial (Fin m) A →+* Localization.Away xx :=
      αT.comp (MvPolynomial.C.comp π.toRingHom)
    let κ : A →+* Localization.Away xx := πh.comp MvPolynomial.C
    let u₀ : Localization.Away xx := αT (MvPolynomial.X 0)
    let w : Localization.Away xx := αT (MvPolynomial.X 1)
    have huw : IsUnit (u₀ * w) := by
      show IsUnit (αT (MvPolynomial.X 0) * αT (MvPolynomial.X 1))
      rw [← map_mul, ← hxx]
      exact IsLocalization.Away.algebraMap_isUnit xx
    have hu₀ : IsUnit u₀ := isUnit_of_mul_isUnit_left huw
    obtain ⟨U₀, hU₀⟩ := hu₀
    have hvu : (↑U₀⁻¹ : Localization.Away xx) * u₀ = 1 := by rw [← hU₀]; exact U₀.inv_mul
    have huv : u₀ * (↑U₀⁻¹ : Localization.Away xx) = 1 := by rw [← hU₀]; exact U₀.mul_inv
    have hπh : ∀ p, MvPolynomial.eval₂ κ (fun j => πh (MvPolynomial.X j)) p = πh p := by
      intro p
      conv_rhs => rw [← MvPolynomial.eval₂_eta p]
      rw [MvPolynomial.eval₂_comp_left]
      rfl
    let g : Fin (m + 1) ⊕ Option (Fin r) → Localization.Away xx :=
      Sum.elim (Fin.cons u₀ (fun j => u₀ * πh (MvPolynomial.X j))) (fun o => Option.elim o w (fun _ => 0))
    let Φ₀ : MvPolynomial (Fin (m + 1) ⊕ Option (Fin r)) A →+* Localization.Away xx :=
      MvPolynomial.eval₂Hom κ g
    have hΦ₀I : ∀ x ∈ I, Φ₀ x = 0 := by
      intro x hx
      rw [← RingHom.mem_ker]
      revert x
      rw [← SetLike.le_def, ← hIdef, Ideal.span_le]
      rintro _ (⟨l, rfl⟩ | ⟨i, rfl⟩)
      · rw [SetLike.mem_coe, RingHom.mem_ker]
        show MvPolynomial.eval₂ κ g _ = 0
        rw [MvPolynomial.eval₂_mul, MvPolynomial.eval₂_X, MvPolynomial.eval₂_rename]
        have hgc : g ∘ Sum.inl = Fin.cons u₀ (fun j => u₀ * πh (MvPolynomial.X j)) := rfl
        rw [hgc, hF l _ κ u₀ _ hvu]
        have hfun : (fun j => u₀ * πh (MvPolynomial.X j) * ↑U₀⁻¹) = fun j => πh (MvPolynomial.X j) := by
          funext j
          rw [mul_comm u₀, mul_assoc, huv, mul_one]
        rw [hfun, hπh]
        show _ * (_ * αT (MvPolynomial.C (π (f l)))) = 0
        rw [hπf, map_zero, map_zero, mul_zero, mul_zero]
      · rw [SetLike.mem_coe, RingHom.mem_ker]
        show MvPolynomial.eval₂ κ g _ = 0
        rw [MvPolynomial.eval₂_mul, MvPolynomial.eval₂_X, MvPolynomial.eval₂_X]
        show _ * 0 = 0
        exact mul_zero _
    let Φ₁ : (MvPolynomial (Fin (m + 1) ⊕ Option (Fin r)) A ⧸ I) →+* Localization.Away xx :=
      Ideal.Quotient.lift I Φ₀ hΦ₀I
    have hΦ₁b : IsUnit (Φ₁ b) := by
      rw [← hb]
      show IsUnit (MvPolynomial.eval₂ κ g (MvPolynomial.X (Sum.inr none) * MvPolynomial.X (Sum.inl 0)))
      rw [MvPolynomial.eval₂_mul, MvPolynomial.eval₂_X, MvPolynomial.eval₂_X]
      show IsUnit (w * u₀)
      rw [mul_comm]; exact huw
    let Φ₂ : Localization.Away b →+* Localization.Away xx := IsLocalization.Away.lift b hΦ₁b
    let q : MvPolynomial (Fin (m + 1) ⊕ Option (Fin r)) A →+* Localization.Away b :=
      (algebraMap (MvPolynomial (Fin (m + 1) ⊕ Option (Fin r)) A ⧸ I) (Localization.Away b)).comp
        (Ideal.Quotient.mk I)
    have hΦq : ∀ x, Φ₂ (q x) = MvPolynomial.eval₂ κ g x := by
      intro x
      show Φ₂ (algebraMap (MvPolynomial (Fin (m + 1) ⊕ Option (Fin r)) A ⧸ I) (Localization.Away b)
        (Ideal.Quotient.mk I x)) = _
      rw [IsLocalization.Away.lift_eq]
      rfl
    have hqI : ∀ x ∈ I, q x = 0 := fun x hx => by
      show algebraMap _ (Localization.Away b) (Ideal.Quotient.mk I x) = 0
      rw [Ideal.Quotient.eq_zero_iff_mem.mpr hx, map_zero]
    have hqb : IsUnit (q (MvPolynomial.X (Sum.inr none) * MvPolynomial.X (Sum.inl 0))) := by
      show IsUnit (algebraMap (MvPolynomial (Fin (m + 1) ⊕ Option (Fin r)) A ⧸ I) (Localization.Away b)
        (Ideal.Quotient.mk I _))
      rw [hb]
      exact IsLocalization.Away.algebraMap_isUnit b
    rw [map_mul] at hqb
    have hqW : IsUnit (q (MvPolynomial.X (Sum.inr none))) := isUnit_of_mul_isUnit_left hqb
    have hqx0 : IsUnit (q (MvPolynomial.X (Sum.inl 0))) := isUnit_of_mul_isUnit_right hqb
    obtain ⟨V₀, hV₀⟩ := hqx0
    have hV1 : (↑V₀⁻¹ : Localization.Away b) * q (MvPolynomial.X (Sum.inl 0)) = 1 := by
      rw [← hV₀]; exact V₀.inv_mul
    have hqy : ∀ i, q (MvPolynomial.X (Sum.inr (some i))) = 0 := by
      intro i
      have h0 := hqI _ (hg2 i)
      rw [map_mul] at h0
      exact (hqW.mul_right_eq_zero).mp h0
    have hqF : ∀ l, q (MvPolynomial.rename Sum.inl (F l)) = 0 := by
      intro l
      have h0 := hqI _ (hg1 l)
      rw [map_mul] at h0
      exact (hqW.mul_right_eq_zero).mp h0
    let θ : MvPolynomial (Fin m) A →+* Localization.Away b :=
      MvPolynomial.eval₂Hom (q.comp MvPolynomial.C)
        (fun j => q (MvPolynomial.X (Sum.inl j.succ)) * ↑V₀⁻¹)
    have hθf : ∀ l, θ (f l) = 0 := by
      intro l
      have h0 := hqF l
      have e : q (MvPolynomial.rename Sum.inl (F l)) =
          MvPolynomial.eval₂ (q.comp MvPolynomial.C)
            (Fin.cons (q (MvPolynomial.X (Sum.inl 0))) (fun j => q (MvPolynomial.X (Sum.inl j.succ))))
            (F l) := by
        conv_lhs => rw [← MvPolynomial.eval₂_eta (MvPolynomial.rename Sum.inl (F l))]
        rw [MvPolynomial.eval₂_comp_left, MvPolynomial.eval₂_rename]
        congr 1
        funext i
        refine Fin.cases ?_ (fun j => ?_) i
        · rfl
        · rfl
      rw [e, hF l _ (q.comp MvPolynomial.C) _ _ hV1] at h0
      have hu : IsUnit (q (MvPolynomial.X (Sum.inl 0)) ^ D l) :=
        ⟨V₀ ^ D l, by rw [Units.val_pow_eq_pow_val, hV₀]⟩
      exact (hu.mul_right_eq_zero).mp h0
    have hkerθ : RingHom.ker π.toRingHom ≤ RingHom.ker θ := by
      have hk : RingHom.ker π.toRingHom = Ideal.span (Set.range f) := hker
      rw [hk, Ideal.span_le]
      rintro _ ⟨l, rfl⟩
      exact hθf l
    let θb : C →+* Localization.Away b := (RingHom.liftOfSurjective π.toRingHom hsurj) ⟨θ, hkerθ⟩
    have hθb : ∀ p, θb (π p) = θ p := fun p =>
      RingHom.liftOfSurjective_comp_apply π.toRingHom hsurj ⟨θ, hkerθ⟩ p
    let Ψ' : MvPolynomial (Fin 2) C →+* Localization.Away b :=
      MvPolynomial.eval₂Hom θb ![q (MvPolynomial.X (Sum.inl 0)), q (MvPolynomial.X (Sum.inr none))]
    have hΨ'x : IsUnit (Ψ' xx) := by
      rw [hxx]
      show IsUnit (MvPolynomial.eval₂ θb _ (MvPolynomial.X 0 * MvPolynomial.X 1))
      rw [MvPolynomial.eval₂_mul, MvPolynomial.eval₂_X, MvPolynomial.eval₂_X]
      exact IsUnit.mul ⟨V₀, hV₀⟩ hqW
    let Ψ₀ : Localization.Away xx →+* Localization.Away b := IsLocalization.Away.lift xx hΨ'x
    have hΨ : ∀ x, Ψ₀ (αT x) = Ψ' x := fun x => IsLocalization.Away.lift_eq _ _ _
    have h1 : Ψ₀.comp Φ₂ = RingHom.id _ := by
      apply IsLocalization.ringHom_ext (Submonoid.powers b)
      apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext
      · intro a'
        change Ψ₀ (Φ₂ (q (MvPolynomial.C a'))) = q (MvPolynomial.C a')
        rw [hΦq, MvPolynomial.eval₂_C]
        show Ψ₀ (αT (MvPolynomial.C (π (MvPolynomial.C a')))) = _
        rw [hΨ]
        show MvPolynomial.eval₂ θb _ (MvPolynomial.C _) = _
        rw [MvPolynomial.eval₂_C, hθb]
        show MvPolynomial.eval₂ _ _ (MvPolynomial.C a') = _
        rw [MvPolynomial.eval₂_C]
        rfl
      · intro s
        change Ψ₀ (Φ₂ (q (MvPolynomial.X s))) = q (MvPolynomial.X s)
        rw [hΦq, MvPolynomial.eval₂_X]
        rcases s with i | (_ | i)
        · refine Fin.cases ?_ (fun j => ?_) i
          · show Ψ₀ (αT (MvPolynomial.X 0)) = _
            rw [hΨ]
            show MvPolynomial.eval₂ θb _ (MvPolynomial.X 0) = _
            rw [MvPolynomial.eval₂_X]
            rfl
          · show Ψ₀ (αT (MvPolynomial.X 0) * αT (MvPolynomial.C (π (MvPolynomial.X j)))) = _
            rw [map_mul, hΨ, hΨ]
            show MvPolynomial.eval₂ θb _ (MvPolynomial.X 0) * MvPolynomial.eval₂ θb _ (MvPolynomial.C _) = _
            rw [MvPolynomial.eval₂_X, MvPolynomial.eval₂_C, hθb]
            show q (MvPolynomial.X (Sum.inl 0)) * MvPolynomial.eval₂ _ _ (MvPolynomial.X j) = _
            rw [MvPolynomial.eval₂_X]
            rw [mul_comm, mul_assoc, hV1, mul_one]
        · show Ψ₀ (αT (MvPolynomial.X 1)) = _
          rw [hΨ]
          show MvPolynomial.eval₂ θb _ (MvPolynomial.X 1) = _
          rw [MvPolynomial.eval₂_X]
          rfl
        · show Ψ₀ 0 = _
          rw [map_zero, hqy]
    have hΦθ : Φ₂.comp θ = πh := by
      apply MvPolynomial.ringHom_ext
      · intro a'
        change Φ₂ (MvPolynomial.eval₂ _ _ (MvPolynomial.C a')) = _
        rw [MvPolynomial.eval₂_C]
        show Φ₂ (q (MvPolynomial.C a')) = _
        rw [hΦq, MvPolynomial.eval₂_C]
        rfl
      · intro j
        change Φ₂ (MvPolynomial.eval₂ _ _ (MvPolynomial.X j)) = _
        rw [MvPolynomial.eval₂_X, map_mul, hΦq, MvPolynomial.eval₂_X]
        have hinv : Φ₂ (↑V₀⁻¹) * u₀ = 1 := by
          have := congrArg Φ₂ hV1
          rw [map_mul, hΦq, MvPolynomial.eval₂_X, map_one] at this
          exact this
        show u₀ * πh (MvPolynomial.X j) * Φ₂ ↑V₀⁻¹ = _
        rw [mul_comm u₀, mul_assoc, mul_comm u₀, hinv, mul_one]
    have h2 : Φ₂.comp Ψ₀ = RingHom.id _ := by
      apply IsLocalization.ringHom_ext (Submonoid.powers xx)
      apply MvPolynomial.ringHom_ext
      · intro c'
        obtain ⟨p, rfl⟩ := hsurj c'
        change Φ₂ (Ψ₀ (αT (MvPolynomial.C (π p)))) = αT (MvPolynomial.C (π p))
        rw [hΨ]
        show Φ₂ (MvPolynomial.eval₂ θb _ (MvPolynomial.C _)) = _
        rw [MvPolynomial.eval₂_C, hθb]
        exact congrArg (fun h => h p) hΦθ
      · intro s
        change Φ₂ (Ψ₀ (αT (MvPolynomial.X s))) = αT (MvPolynomial.X s)
        rw [hΨ]
        show Φ₂ (MvPolynomial.eval₂ θb _ (MvPolynomial.X s)) = _
        rw [MvPolynomial.eval₂_X]
        refine Fin.cases ?_ (fun j => ?_) s
        · show Φ₂ (q (MvPolynomial.X (Sum.inl 0))) = _
          rw [hΦq, MvPolynomial.eval₂_X]
          rfl
        · refine Fin.cases ?_ (fun k => k.elim0) j
          show Φ₂ (q (MvPolynomial.X (Sum.inr none))) = _
          rw [hΦq, MvPolynomial.eval₂_X]
          rfl
    have hcΦ : ∀ x : R, Φ₂ (algebraMap R (Localization.Away b) x) = algebraMap R (Localization.Away xx) x := by
      intro x
      have e1 : algebraMap R (Localization.Away b) x = q (MvPolynomial.C (algebraMap R A x)) := by
        rw [IsScalarTower.algebraMap_apply R (MvPolynomial (Fin (m + 1) ⊕ Option (Fin r)) A ⧸ I)
            (Localization.Away b),
          IsScalarTower.algebraMap_apply R (MvPolynomial (Fin (m + 1) ⊕ Option (Fin r)) A)
            (MvPolynomial (Fin (m + 1) ⊕ Option (Fin r)) A ⧸ I),
          Ideal.Quotient.algebraMap_eq, MvPolynomial.algebraMap_apply]
        rfl
      have e2 : algebraMap R (Localization.Away xx) x = αT (MvPolynomial.C (π (MvPolynomial.C (algebraMap R A x)))) := by
        have hπc : π (MvPolynomial.C (algebraMap R A x)) = algebraMap R C x := by
          rw [← MvPolynomial.algebraMap_apply]
          exact π.commutes x
        rw [hπc, IsScalarTower.algebraMap_apply R C (Localization.Away xx),
          IsScalarTower.algebraMap_apply C (MvPolynomial (Fin 2) C) (Localization.Away xx),
          MvPolynomial.algebraMap_eq]
      rw [e1, e2, hΦq, MvPolynomial.eval₂_C]
      rfl
    let ΦA : Localization.Away b →ₐ[R] Localization.Away xx := { Φ₂ with commutes' := hcΦ }
    have hcΨ : ∀ x : R, Ψ₀ (algebraMap R (Localization.Away xx) x) = algebraMap R (Localization.Away b) x := by
      intro x
      have := congrArg (fun g => g (algebraMap R (Localization.Away b) x)) h1
      simp only [RingHom.comp_apply, RingHom.id_apply] at this
      rw [← hcΦ, this]
    let ΨA : Localization.Away xx →ₐ[R] Localization.Away b := { Ψ₀ with commutes' := hcΨ }
    let e : Localization.Away xx ≃ₐ[R] Localization.Away b :=
      AlgEquiv.ofAlgHom ΨA ΦA
        (AlgHom.ext fun x => congrArg (fun g => g x) h1)
        (AlgHom.ext fun x => congrArg (fun g => g x) h2)
    exact Algebra.Smooth.of_equiv e

  have s7 : ∀ (R : Type u) [CommRing R] (A : Type u) [CommRing A] [Algebra R A] (p r : ℕ) (I : Ideal (MvPolynomial (Fin p ⊕ Option (Fin r)) A)) (ℓ : Fin r) (a : A), I ≤ Ideal.span {MvPolynomial.X (Sum.inr none)} → MvPolynomial.X (Sum.inr none) * MvPolynomial.X (Sum.inr (some ℓ)) ∈ I → Algebra.Smooth R (Localization.Away a) → Algebra.Smooth R (Localization.Away (Ideal.Quotient.mk I (MvPolynomial.C a * MvPolynomial.X (Sum.inr (some ℓ))))) := by
    intro R _ A _ _ p r I ℓ a hI hWy hsm
    generalize hb : Ideal.Quotient.mk I (MvPolynomial.C a * MvPolynomial.X (Sum.inr (some ℓ))) = b
    obtain ⟨xℓ, hx⟩ : ∃ x : MvPolynomial (Fin p ⊕ Fin r) (Localization.Away a),
        x = MvPolynomial.X (Sum.inr ℓ) := ⟨_, rfl⟩
    haveI : Algebra.Smooth (Localization.Away a) (Localization.Away xℓ) :=
      Algebra.Smooth.comp (Localization.Away a) (MvPolynomial (Fin p ⊕ Fin r) (Localization.Away a))
        (Localization.Away xℓ)
    haveI : Algebra.Smooth R (Localization.Away xℓ) :=
      Algebra.Smooth.comp R (Localization.Away a) (Localization.Away xℓ)
    let κ' : Localization.Away a →+* Localization.Away xℓ :=
      (algebraMap (MvPolynomial (Fin p ⊕ Fin r) (Localization.Away a)) (Localization.Away xℓ)).comp
        MvPolynomial.C
    let κ : A →+* Localization.Away xℓ := κ'.comp (algebraMap A (Localization.Away a))
    let hv : Fin p ⊕ Option (Fin r) → Localization.Away xℓ :=
      Sum.elim (fun j => algebraMap (MvPolynomial (Fin p ⊕ Fin r) (Localization.Away a)) (Localization.Away xℓ) (MvPolynomial.X (Sum.inl j)))
        (fun o => Option.elim o 0 (fun i => algebraMap (MvPolynomial (Fin p ⊕ Fin r) (Localization.Away a)) (Localization.Away xℓ) (MvPolynomial.X (Sum.inr i))))
    let Φ₀ : MvPolynomial (Fin p ⊕ Option (Fin r)) A →+* Localization.Away xℓ :=
      MvPolynomial.eval₂Hom κ hv
    have hΦ₀I : ∀ x ∈ I, Φ₀ x = 0 := by
      intro x hx'
      obtain ⟨y, rfl⟩ := Ideal.mem_span_singleton'.mp (hI hx')
      show MvPolynomial.eval₂ κ hv (y * MvPolynomial.X (Sum.inr none)) = 0
      rw [MvPolynomial.eval₂_mul, MvPolynomial.eval₂_X]
      exact mul_zero _
    let Φ₁ : (MvPolynomial (Fin p ⊕ Option (Fin r)) A ⧸ I) →+* Localization.Away xℓ :=
      Ideal.Quotient.lift I Φ₀ hΦ₀I
    have hΦ₁b : IsUnit (Φ₁ b) := by
      rw [← hb]
      show IsUnit (MvPolynomial.eval₂ κ hv (MvPolynomial.C a * MvPolynomial.X (Sum.inr (some ℓ))))
      rw [MvPolynomial.eval₂_mul, MvPolynomial.eval₂_C, MvPolynomial.eval₂_X]
      refine IsUnit.mul ?_ ?_
      · exact (IsLocalization.Away.algebraMap_isUnit (S := Localization.Away a) a).map κ'
      · show IsUnit (algebraMap (MvPolynomial (Fin p ⊕ Fin r) (Localization.Away a)) (Localization.Away xℓ) (MvPolynomial.X (Sum.inr ℓ)))
        rw [← hx]
        exact IsLocalization.Away.algebraMap_isUnit xℓ
    let Φ₂ : Localization.Away b →+* Localization.Away xℓ := IsLocalization.Away.lift b hΦ₁b
    let q : MvPolynomial (Fin p ⊕ Option (Fin r)) A →+* Localization.Away b :=
      (algebraMap (MvPolynomial (Fin p ⊕ Option (Fin r)) A ⧸ I) (Localization.Away b)).comp (Ideal.Quotient.mk I)
    have hΦq : ∀ x, Φ₂ (q x) = MvPolynomial.eval₂ κ hv x := by
      intro x
      show Φ₂ (algebraMap (MvPolynomial (Fin p ⊕ Option (Fin r)) A ⧸ I) (Localization.Away b) (Ideal.Quotient.mk I x)) = _
      rw [IsLocalization.Away.lift_eq]
      rfl
    have hqb : IsUnit (q (MvPolynomial.C a * MvPolynomial.X (Sum.inr (some ℓ)))) := by
      show IsUnit (algebraMap (MvPolynomial (Fin p ⊕ Option (Fin r)) A ⧸ I) (Localization.Away b) (Ideal.Quotient.mk I _))
      rw [hb]
      exact IsLocalization.Away.algebraMap_isUnit b
    rw [map_mul] at hqb
    have hqa : IsUnit (q (MvPolynomial.C a)) := isUnit_of_mul_isUnit_left hqb
    have hqy : IsUnit (q (MvPolynomial.X (Sum.inr (some ℓ)))) := isUnit_of_mul_isUnit_right hqb
    have hqW : q (MvPolynomial.X (Sum.inr none)) = 0 := by
      have h0 : q (MvPolynomial.X (Sum.inr none) * MvPolynomial.X (Sum.inr (some ℓ))) = 0 := by
        simp only [q, RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem.mpr hWy, map_zero]
      rw [map_mul] at h0
      exact (hqy.mul_left_eq_zero).mp h0
    let ψA : Localization.Away a →+* Localization.Away b :=
      IsLocalization.Away.lift a (g := q.comp MvPolynomial.C) hqa
    have hψA : ∀ a', ψA (algebraMap A (Localization.Away a) a') = q (MvPolynomial.C a') :=
      fun a' => IsLocalization.Away.lift_eq _ _ _
    let ψQ : MvPolynomial (Fin p ⊕ Fin r) (Localization.Away a) →+* Localization.Away b :=
      MvPolynomial.eval₂Hom ψA
        (Sum.elim (fun j => q (MvPolynomial.X (Sum.inl j))) (fun i => q (MvPolynomial.X (Sum.inr (some i)))))
    have hψQX : ∀ s, ψQ (MvPolynomial.X s) =
        Sum.elim (fun j => q (MvPolynomial.X (Sum.inl j))) (fun i => q (MvPolynomial.X (Sum.inr (some i)))) s :=
      fun s => MvPolynomial.eval₂_X _ _ _
    have hψQC : ∀ c, ψQ (MvPolynomial.C c) = ψA c := fun c => MvPolynomial.eval₂_C _ _ _
    have hψQx : IsUnit (ψQ xℓ) := by
      rw [hx, hψQX]
      exact hqy
    let Ψ₀ : Localization.Away xℓ →+* Localization.Away b := IsLocalization.Away.lift xℓ hψQx
    have hΨ : ∀ x, Ψ₀ (algebraMap (MvPolynomial (Fin p ⊕ Fin r) (Localization.Away a)) (Localization.Away xℓ) x) = ψQ x :=
      fun x => IsLocalization.Away.lift_eq _ _ _
    have h1 : Ψ₀.comp Φ₂ = RingHom.id _ := by
      apply IsLocalization.ringHom_ext (Submonoid.powers b)
      apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext
      · intro a'
        change Ψ₀ (Φ₂ (q (MvPolynomial.C a'))) = q (MvPolynomial.C a')
        rw [hΦq, MvPolynomial.eval₂_C]
        show Ψ₀ (algebraMap (MvPolynomial (Fin p ⊕ Fin r) (Localization.Away a)) (Localization.Away xℓ) (MvPolynomial.C (algebraMap A (Localization.Away a) a'))) = _
        rw [hΨ, hψQC, hψA]
      · intro s
        change Ψ₀ (Φ₂ (q (MvPolynomial.X s))) = q (MvPolynomial.X s)
        rw [hΦq, MvPolynomial.eval₂_X]
        rcases s with j | (_ | i)
        · show Ψ₀ (algebraMap (MvPolynomial (Fin p ⊕ Fin r) (Localization.Away a)) (Localization.Away xℓ) (MvPolynomial.X (Sum.inl j))) = _
          rw [hΨ, hψQX]
          rfl
        · show Ψ₀ 0 = _
          rw [map_zero, hqW]
        · show Ψ₀ (algebraMap (MvPolynomial (Fin p ⊕ Fin r) (Localization.Away a)) (Localization.Away xℓ) (MvPolynomial.X (Sum.inr i))) = _
          rw [hΨ, hψQX]
          rfl
    have hA : Φ₂.comp ψA = (algebraMap (MvPolynomial (Fin p ⊕ Fin r) (Localization.Away a)) (Localization.Away xℓ)).comp MvPolynomial.C := by
      apply IsLocalization.ringHom_ext (Submonoid.powers a)
      apply RingHom.ext
      intro a'
      change Φ₂ (ψA (algebraMap A (Localization.Away a) a')) =
        algebraMap (MvPolynomial (Fin p ⊕ Fin r) (Localization.Away a)) (Localization.Away xℓ) (MvPolynomial.C (algebraMap A (Localization.Away a) a'))
      rw [hψA, hΦq, MvPolynomial.eval₂_C]
      rfl
    have h2 : Φ₂.comp Ψ₀ = RingHom.id _ := by
      apply IsLocalization.ringHom_ext (Submonoid.powers xℓ)
      apply MvPolynomial.ringHom_ext
      · intro c
        change Φ₂ (Ψ₀ (algebraMap (MvPolynomial (Fin p ⊕ Fin r) (Localization.Away a)) (Localization.Away xℓ) (MvPolynomial.C c))) =
          algebraMap (MvPolynomial (Fin p ⊕ Fin r) (Localization.Away a)) (Localization.Away xℓ) (MvPolynomial.C c)
        rw [hΨ, hψQC]
        exact congrArg (fun g => g c) hA
      · intro s
        change Φ₂ (Ψ₀ (algebraMap (MvPolynomial (Fin p ⊕ Fin r) (Localization.Away a)) (Localization.Away xℓ) (MvPolynomial.X s))) =
          algebraMap (MvPolynomial (Fin p ⊕ Fin r) (Localization.Away a)) (Localization.Away xℓ) (MvPolynomial.X s)
        rw [hΨ, hψQX]
        rcases s with j | i
        · show Φ₂ (q (MvPolynomial.X (Sum.inl j))) = _
          rw [hΦq, MvPolynomial.eval₂_X]
          rfl
        · show Φ₂ (q (MvPolynomial.X (Sum.inr (some i)))) = _
          rw [hΦq, MvPolynomial.eval₂_X]
          rfl
    have hcΦ : ∀ x : R, Φ₂ (algebraMap R (Localization.Away b) x) = algebraMap R (Localization.Away xℓ) x := by
      intro x
      have e1 : algebraMap R (Localization.Away b) x = q (MvPolynomial.C (algebraMap R A x)) := by
        rw [IsScalarTower.algebraMap_apply R (MvPolynomial (Fin p ⊕ Option (Fin r)) A ⧸ I) (Localization.Away b),
          IsScalarTower.algebraMap_apply R (MvPolynomial (Fin p ⊕ Option (Fin r)) A)
            (MvPolynomial (Fin p ⊕ Option (Fin r)) A ⧸ I),
          Ideal.Quotient.algebraMap_eq, MvPolynomial.algebraMap_apply]
        rfl
      have e2 : algebraMap R (Localization.Away xℓ) x = algebraMap (MvPolynomial (Fin p ⊕ Fin r) (Localization.Away a)) (Localization.Away xℓ)
          (MvPolynomial.C (algebraMap A (Localization.Away a) (algebraMap R A x))) := by
        rw [IsScalarTower.algebraMap_apply R (MvPolynomial (Fin p ⊕ Fin r) (Localization.Away a))
          (Localization.Away xℓ), MvPolynomial.algebraMap_apply,
          ← IsScalarTower.algebraMap_apply]
      rw [e1, e2, hΦq, MvPolynomial.eval₂_C]
      rfl
    let ΦA : Localization.Away b →ₐ[R] Localization.Away xℓ := { Φ₂ with commutes' := hcΦ }
    have hcΨ : ∀ x : R, Ψ₀ (algebraMap R (Localization.Away xℓ) x) = algebraMap R (Localization.Away b) x := by
      intro x
      have := congrArg (fun g => g (algebraMap R (Localization.Away b) x)) h1
      simp only [RingHom.comp_apply, RingHom.id_apply] at this
      rw [← hcΦ, this]
    let ΨA : Localization.Away xℓ →ₐ[R] Localization.Away b := { Ψ₀ with commutes' := hcΨ }
    let e : Localization.Away xℓ ≃ₐ[R] Localization.Away b :=
      AlgEquiv.ofAlgHom ΨA ΦA
        (AlgHom.ext fun x => congrArg (fun g => g x) h1)
        (AlgHom.ext fun x => congrArg (fun g => g x) h2)
    exact Algebra.Smooth.of_equiv e

  have s8 : ∀ (R : Type u) [CommRing R] (A : Type u) [CommRing A] [Algebra R A] (Λ : Type u) [CommRing Λ] [Algebra R Λ] (φ : A →ₐ[R] Λ) (m c r : ℕ) (F : Fin c → MvPolynomial (Fin (m + 1)) A) (w : Fin (m + 1) → Λ) (z : Λ) (e : Fin r → Λ), (∀ l, z * MvPolynomial.eval₂ φ.toRingHom w (F l) = 0) → (∀ i, z * e i = 0) → ∃ χ : (MvPolynomial (Fin (m + 1) ⊕ Option (Fin r)) A ⧸ Ideal.span (Set.range (fun l => (MvPolynomial.X (Sum.inr none) : MvPolynomial (Fin (m + 1) ⊕ Option (Fin r)) A) * MvPolynomial.rename Sum.inl (F l)) ∪ Set.range (fun i => (MvPolynomial.X (Sum.inr none) : MvPolynomial (Fin (m + 1) ⊕ Option (Fin r)) A) * MvPolynomial.X (Sum.inr (some i))))) →ₐ[R] Λ, ∀ p, χ (Ideal.Quotient.mk _ p) = MvPolynomial.eval₂ φ.toRingHom (Sum.elim w (fun o => Option.elim o z e)) p := by
    intro R _ A _ _ Λ _ _ φ m c r F w z e hF he
    let E : MvPolynomial (Fin (m + 1) ⊕ Option (Fin r)) A →ₐ[R] Λ :=
      { MvPolynomial.eval₂Hom φ.toRingHom (Sum.elim w (fun o => Option.elim o z e)) with
        commutes' := fun x => by
          simp }
    have hE : ∀ p, E p = MvPolynomial.eval₂ φ.toRingHom (Sum.elim w (fun o => Option.elim o z e)) p :=
      fun p => rfl
    refine ⟨Ideal.Quotient.liftₐ _ E ?_, fun p => ?_⟩
    · intro a ha
      rw [← RingHom.mem_ker]
      revert a
      rw [← SetLike.le_def]
      change Ideal.span _ ≤ RingHom.ker (E : MvPolynomial (Fin (m + 1) ⊕ Option (Fin r)) A →+* Λ)
      rw [Ideal.span_le]
      rintro _ (⟨l, rfl⟩ | ⟨i, rfl⟩)
      · rw [SetLike.mem_coe, RingHom.mem_ker]
        change E _ = 0
        rw [hE, MvPolynomial.eval₂_mul, MvPolynomial.eval₂_X, MvPolynomial.eval₂_rename]
        simpa using hF l
      · rw [SetLike.mem_coe, RingHom.mem_ker]
        change E _ = 0
        rw [hE, MvPolynomial.eval₂_mul, MvPolynomial.eval₂_X, MvPolynomial.eval₂_X]
        simpa using he i
    · exact hE p

  obtain ⟨C, iC, aC, hCsm, ψC, γ, hγ⟩ := hC

  obtain ⟨r, a, ha, h𝔥⟩ : ∃ (r : ℕ) (a : Fin r → A), (∀ j, Algebra.Smooth R (Localization.Away (a j))) ∧ Ideal.span (φ '' {a : A | Algebra.Smooth R (Localization.Away a)}) = Ideal.span (Set.range fun j => φ (a j)) := by
    set S : Set A := {a : A | Algebra.Smooth R (Localization.Away a)} with hSdef
    have hfg : (Submodule.span Λ (φ '' S)).FG := Ideal.fg_of_isNoetherianRing _
    obtain ⟨t, ht, hspan⟩ := (Submodule.fg_span_iff_fg_span_finset_subset (φ '' S)).mp hfg
    obtain ⟨u, huS, hut⟩ := (Finset.subset_set_image_iff (f := (φ : A → Λ))).mp ht
    have hmem : ∀ j : Fin u.card, ((u.equivFin.symm j : A)) ∈ S := fun j =>
      huS (Finset.mem_coe.mpr (u.equivFin.symm j).2)
    refine ⟨u.card, fun j => (u.equivFin.symm j : A), fun j => hmem j, ?_⟩
    apply le_antisymm
    · change Submodule.span Λ (φ '' S) ≤ _
      rw [hspan]
      apply Ideal.span_mono
      intro y hy
      rw [← hut, Finset.coe_image] at hy
      obtain ⟨x, hx, rfl⟩ := hy
      refine ⟨u.equivFin ⟨x, Finset.mem_coe.mp hx⟩, ?_⟩
      simp only [Equiv.symm_apply_apply]
    · rw [Ideal.span_le]
      rintro _ ⟨j, rfl⟩
      exact Ideal.subset_span ⟨_, hmem j, rfl⟩
  by_cases hcase : ∃ j, φ (a j) ∉ 𝔮
  · obtain ⟨j, hj⟩ := hcase
    refine ⟨A, inferInstance, inferInstance, inferInstance, AlgHom.id R A, φ, AlgHom.comp_id φ,
      le_rfl, ?_⟩
    intro hle
    apply hj
    apply hle
    apply Ideal.le_radical
    rw [h𝔥]
    exact Ideal.subset_span ⟨j, rfl⟩
  push_neg at hcase
  obtain ⟨lam, N, hlam, hlamN⟩ := s1 Λ 𝔮 h𝔮 r (fun j => φ (a j)) hcase
  haveI : Algebra.FinitePresentation R C := Algebra.Smooth.finitePresentation
  obtain ⟨m, c, f, π, hsurj, hπC, hker⟩ := s4 R A C ψC
  have hf0 : ∀ l, π (f l) = 0 := fun l => by
    rw [← RingHom.mem_ker, hker]; exact Ideal.subset_span ⟨l, rfl⟩
  have hFex := fun l => s3 A m (f l)
  choose D F hF using hFex
  obtain ⟨s, μ, l₀, hs, hl₀, hl₀F⟩ := s5 R A Λ φ 𝔮 C ψC γ hγ m c f π hπC hf0 D F hF
  have hIfg : (Ideal.span (Set.range (fun l => (MvPolynomial.X (Sum.inr none) : MvPolynomial (Fin (m + 1) ⊕ Option (Fin r)) A) * MvPolynomial.rename Sum.inl (F l)) ∪ Set.range (fun i => (MvPolynomial.X (Sum.inr none) : MvPolynomial (Fin (m + 1) ⊕ Option (Fin r)) A) * MvPolynomial.X (Sum.inr (some i))))).FG :=
    Submodule.fg_span ((Set.finite_range _).union (Set.finite_range _))
  haveI := Algebra.FinitePresentation.quotient (R := R) hIfg
  obtain ⟨χ, hχ⟩ := s8 R A Λ φ m c r F (Fin.cons s μ) (l₀ * lam) (fun i => φ (a i) ^ N)
    (fun l => by rw [mul_comm l₀, mul_assoc, hl₀F l, mul_zero])
    (fun i => by rw [mul_assoc, show lam * φ (a i) ^ N = 0 from hlamN i, mul_zero])
  have hIW : Ideal.span (Set.range (fun l => (MvPolynomial.X (Sum.inr none) : MvPolynomial (Fin (m + 1) ⊕ Option (Fin r)) A) * MvPolynomial.rename Sum.inl (F l)) ∪ Set.range (fun i => (MvPolynomial.X (Sum.inr none) : MvPolynomial (Fin (m + 1) ⊕ Option (Fin r)) A) * MvPolynomial.X (Sum.inr (some i)))) ≤ Ideal.span {MvPolynomial.X (Sum.inr none)} := by
    rw [Ideal.span_le]
    rintro _ (⟨l, rfl⟩ | ⟨i, rfl⟩)
    · exact Ideal.mem_span_singleton'.mpr ⟨_, mul_comm _ _⟩
    · exact Ideal.mem_span_singleton'.mpr ⟨_, mul_comm _ _⟩
  refine ⟨MvPolynomial (Fin (m + 1) ⊕ Option (Fin r)) A ⧸ Ideal.span (Set.range (fun l => (MvPolynomial.X (Sum.inr none) : MvPolynomial (Fin (m + 1) ⊕ Option (Fin r)) A) * MvPolynomial.rename Sum.inl (F l)) ∪ Set.range (fun i => (MvPolynomial.X (Sum.inr none) : MvPolynomial (Fin (m + 1) ⊕ Option (Fin r)) A) * MvPolynomial.X (Sum.inr (some i)))), inferInstance, inferInstance, inferInstance,
    (Ideal.Quotient.mkₐ R _).comp (IsScalarTower.toAlgHom R A (MvPolynomial (Fin (m + 1) ⊕ Option (Fin r)) A)),
    χ, ?_, ?_, ?_⟩
  · apply AlgHom.ext
    intro x
    show χ (Ideal.Quotient.mk _ (algebraMap A (MvPolynomial (Fin (m + 1) ⊕ Option (Fin r)) A) x)) = φ x
    rw [hχ, MvPolynomial.algebraMap_eq, MvPolynomial.eval₂_C]
    rfl
  · rw [Ideal.radical_le_radical_iff, h𝔥, Ideal.span_le]
    rintro _ ⟨ℓ, rfl⟩
    have hsm := s7 R A (m + 1) r _ ℓ (a ℓ) hIW (Ideal.subset_span (Or.inr ⟨ℓ, rfl⟩)) (ha ℓ)
    apply Ideal.mem_radical_of_pow_mem (m := N + 1)
    apply Ideal.le_radical
    apply Ideal.subset_span
    refine ⟨_, hsm, ?_⟩
    rw [hχ, MvPolynomial.eval₂_mul, MvPolynomial.eval₂_C, MvPolynomial.eval₂_X]
    show φ (a ℓ) * φ (a ℓ) ^ N = φ (a ℓ) ^ (N + 1)
    ring
  · intro hle
    have hsm := s6 R A C m c r f π hsurj hker D F hF
    have hmem := hle (Ideal.le_radical (Ideal.subset_span ⟨_, hsm, rfl⟩))
    rw [hχ, MvPolynomial.eval₂_mul, MvPolynomial.eval₂_X, MvPolynomial.eval₂_X] at hmem
    simp only [Sum.elim_inl, Sum.elim_inr, Option.elim_none, Fin.cons_zero] at hmem
    rcases (Ideal.IsPrime.mul_mem_iff_mem_or_mem inferInstance).mp hmem with h | h
    · rcases (Ideal.IsPrime.mul_mem_iff_mem_or_mem inferInstance).mp h with h' | h'
      · exact hl₀ h'
      · exact hlam h'
    · exact hs h

theorem wc_cz_ais_transcendence_reduction : ∀ (k : Type u) [Field k] (K : Type u) [Field K] [Algebra k K] (n : ℕ) (μ : Fin n → K), ∃ (r : ℕ) (t : Fin r → K), AlgebraicIndependent k t ∧ ∀ i, IsAlgebraic (Algebra.adjoin k (Set.range t)) (μ i) :=
by
  intro k _ K _ _ n
  induction n with
  | zero =>
    intro μ
    exact ⟨0, fun i => i.elim0, algebraicIndependent_empty_type, fun i => i.elim0⟩
  | succ n ih =>
    intro μ
    obtain ⟨r, t, ht, halg⟩ := ih (fun i => μ i.succ)
    by_cases h0 : _root_.IsAlgebraic (Algebra.adjoin k (Set.range t)) (μ 0)
    · refine ⟨r, t, ht, fun i => ?_⟩
      refine Fin.cases ?_ (fun j => ?_) i
      · exact h0
      · exact halg j
    · have hopt : AlgebraicIndependent k (fun o : Option (Fin r) => o.elim (μ 0) t) :=
        (ht.option_iff_transcendental (μ 0)).mpr h0
      set t' : Fin (r + 1) → K :=
        (fun o : Option (Fin r) => o.elim (μ 0) t) ∘ (finSuccEquiv r) with ht'
      have hind : AlgebraicIndependent k t' := hopt.comp _ (finSuccEquiv r).injective
      have ht'0 : t' 0 = μ 0 := by simp [ht']
      have ht's : ∀ m : Fin r, t' m.succ = t m := by intro m; simp [ht']
      have hrange : Set.range t ⊆ Set.range t' := by
        rintro _ ⟨m, rfl⟩
        exact ⟨m.succ, ht's m⟩
      have hle : Algebra.adjoin k (Set.range t) ≤ Algebra.adjoin k (Set.range t') :=
        Algebra.adjoin_mono hrange
      have hmem : μ 0 ∈ Algebra.adjoin k (Set.range t') :=
        Algebra.subset_adjoin ⟨0, ht'0⟩
      refine ⟨r + 1, t', hind, fun i => ?_⟩
      refine Fin.cases ?_ (fun j => ?_) i
      · exact isAlgebraic_algebraMap (⟨μ 0, hmem⟩ : Algebra.adjoin k (Set.range t'))
      · exact IsAlgebraic.tower_top_of_subalgebra_le hle (halg j)

theorem wc_cz_ais_primitive_integral : ∀ (k : Type u) [Field k] [CharZero k] (K : Type u) [Field K] [Algebra k K] (r : ℕ) (t : Fin r → K) (n : ℕ) (μ : Fin n → K), AlgebraicIndependent k t → (∀ i, IsAlgebraic (Algebra.adjoin k (Set.range t)) (μ i)) → ∃ (θ : K) (p : Polynomial (MvPolynomial (Fin r) k)), p.Monic ∧ Polynomial.eval₂ (MvPolynomial.aeval t).toRingHom θ p = 0 ∧ ∀ i, μ i ∈ IntermediateField.adjoin k (insert θ (Set.range t)) :=
by
  intro k _ _ K _ _ r t n μ ht halg
  classical

  have L1 : ∀ (F : Type u) [Field F] [CharZero F] [Algebra F K] (n : ℕ) (μ : Fin n → K),
      (∀ i, IsAlgebraic F (μ i)) →
      ∃ θ₀ : K, IsAlgebraic F θ₀ ∧ ∀ i, μ i ∈ IntermediateField.adjoin F {θ₀} := by
    intro F _ _ _ n μ hμ
    let E := IntermediateField.adjoin F (Set.range μ)
    have hfin : FiniteDimensional F E :=
      IntermediateField.finiteDimensional_adjoin (fun x hx => by
        obtain ⟨i, rfl⟩ := hx
        exact (hμ i).isIntegral)
    have : Algebra.IsIntegral F E := Algebra.IsIntegral.of_finite F E
    have : Algebra.IsSeparable F E := Algebra.IsSeparable.of_integral F E
    obtain ⟨α, hα⟩ := Field.exists_primitive_element F E
    refine ⟨(α : K), ?_, ?_⟩
    · exact IntermediateField.isAlgebraic_iff.mp (IsAlgebraic.of_finite F α)
    · have hmap : IntermediateField.adjoin F {(α : K)} = E := by
        have h1 := IntermediateField.adjoin_map F {α} E.val
        rw [hα, ← AlgHom.fieldRange_eq_map, IntermediateField.fieldRange_val,
          Set.image_singleton, IntermediateField.coe_val] at h1
        exact h1.symm
      intro i
      rw [hmap]
      exact IntermediateField.subset_adjoin F (Set.range μ) ⟨i, rfl⟩

  have L2 : ∀ x : K, IsAlgebraic (IntermediateField.adjoin k (Set.range t)) x →
      IsAlgebraic (Algebra.adjoin k (Set.range t)) x := by
    intro x hx
    have hle : Algebra.adjoin k (Set.range t) ≤
        (IntermediateField.adjoin k (Set.range t)).toSubalgebra :=
      IntermediateField.algebra_adjoin_le_adjoin k _
    letI : Algebra (Algebra.adjoin k (Set.range t)) (IntermediateField.adjoin k (Set.range t)) :=
      (Subalgebra.inclusion hle).toRingHom.toAlgebra
    have : IsScalarTower (Algebra.adjoin k (Set.range t))
        (IntermediateField.adjoin k (Set.range t)) K :=
      IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    have : Algebra.IsAlgebraic (Algebra.adjoin k (Set.range t))
        (IntermediateField.adjoin k (Set.range t)) := by
      rw [Algebra.isAlgebraic_def]
      intro z
      obtain ⟨a, ha, b, hb, hz⟩ := IntermediateField.mem_adjoin_iff_div.mp z.2
      have hA : IsAlgebraic (Algebra.adjoin k (Set.range t)) a :=
        isAlgebraic_algebraMap (⟨a, ha⟩ : Algebra.adjoin k (Set.range t))
      have hB : IsAlgebraic (Algebra.adjoin k (Set.range t)) b :=
        isAlgebraic_algebraMap (⟨b, hb⟩ : Algebra.adjoin k (Set.range t))
      have hz' : IsAlgebraic (Algebra.adjoin k (Set.range t)) (z : K) := by
        rw [hz, div_eq_mul_inv]
        exact hA.mul hB.inv
      exact (isAlgebraic_algebraMap_iff
        (algebraMap (IntermediateField.adjoin k (Set.range t)) K).injective).mp hz'
    exact hx.restrictScalars (Algebra.adjoin k (Set.range t))

  have hF : ∀ i, IsAlgebraic (IntermediateField.adjoin k (Set.range t)) (μ i) := fun i =>
    IsAlgebraic.tower_top_of_subalgebra_le (IntermediateField.algebra_adjoin_le_adjoin k _) (halg i)
  obtain ⟨θ₀, hθ₀, hμ⟩ := L1 (IntermediateField.adjoin k (Set.range t)) n μ hF
  obtain ⟨y, hy0, hyint⟩ := (L2 θ₀ hθ₀).exists_integral_multiple
  obtain ⟨q, hqm, hq⟩ := hyint
  let e := ht.aevalEquiv
  refine ⟨y • θ₀, q.map e.symm.toAlgHom.toRingHom, hqm.map _, ?_, ?_⟩
  · rw [Polynomial.eval₂_map]
    have hcomp : (MvPolynomial.aeval t).toRingHom.comp e.symm.toAlgHom.toRingHom =
        algebraMap (Algebra.adjoin k (Set.range t)) K := by
      refine RingHom.ext fun a => ?_
      show MvPolynomial.aeval t (e.symm a) = algebraMap (Algebra.adjoin k (Set.range t)) K a
      rw [← ht.algebraMap_aevalEquiv, AlgEquiv.apply_symm_apply]
    rw [hcomp]
    exact hq
  · intro i
    have hyF : (y : K) ∈ IntermediateField.adjoin k (Set.range t) :=
      IntermediateField.algebra_adjoin_le_adjoin k _ y.2
    have hyne : (y : K) ≠ 0 := fun h => hy0 (ZeroMemClass.coe_eq_zero.mp h)
    have hsm : y • θ₀ = (y : K) * θ₀ := Algebra.smul_def y θ₀
    have hFM : IntermediateField.adjoin k (Set.range t) ≤
        IntermediateField.adjoin k (insert (y • θ₀) (Set.range t)) :=
      IntermediateField.adjoin.mono k _ _ (Set.subset_insert _ _)
    have hθM : y • θ₀ ∈ IntermediateField.adjoin k (insert (y • θ₀) (Set.range t)) :=
      IntermediateField.subset_adjoin k _ (Set.mem_insert _ _)
    have hθ₀M : θ₀ ∈ IntermediateField.adjoin k (insert (y • θ₀) (Set.range t)) := by
      have h1 : θ₀ = (y : K)⁻¹ * (y • θ₀) := by
        rw [hsm]; exact (inv_mul_cancel_left₀ hyne θ₀).symm
      have h3 := IntermediateField.mul_mem _ (IntermediateField.inv_mem _ (hFM hyF)) hθM
      rwa [← h1] at h3
    have h2 : μ i ∈ (IntermediateField.adjoin (IntermediateField.adjoin k (Set.range t))
        {θ₀}).restrictScalars k :=
      hμ i
    rw [IntermediateField.restrictScalars_adjoin] at h2
    refine (IntermediateField.adjoin_le_iff.mpr ?_) h2
    exact Set.union_subset (fun z hz => hFM hz) (Set.singleton_subset_iff.mpr hθ₀M)

theorem wc_cz_ais_clear_denominators : ∀ (k : Type u) [Field k] (K : Type u) [Field K] [Algebra k K] (r : ℕ) (t : Fin r → K) (θ : K) (p : Polynomial (MvPolynomial (Fin r) k)), p.Monic → Polynomial.eval₂ (MvPolynomial.aeval t).toRingHom θ p = 0 → ∀ (n : ℕ) (μ : Fin n → K), (∀ i, μ i ∈ IntermediateField.adjoin k (insert θ (Set.range t))) → ∃ (δ : MvPolynomial (Fin r) k) (Q : Fin n → Polynomial (MvPolynomial (Fin r) k)), MvPolynomial.aeval t δ ≠ 0 ∧ ∀ i, Polynomial.eval₂ (MvPolynomial.aeval t).toRingHom θ (Q i) = MvPolynomial.aeval t δ * μ i :=
by
  classical
  intro k _ K _ _ r t θ p hp hpθ n μ hμ
  set φ : MvPolynomial (Fin r) k →+* K := (MvPolynomial.aeval t).toRingHom with hφ

  have s1 : ∀ (m : ℕ) (b : K) (g : Polynomial (MvPolynomial (Fin r) k)), g.natDegree ≤ m →
      g.Monic → Polynomial.eval₂ φ b g = 0 → b ≠ 0 →
      ∃ (c : MvPolynomial (Fin r) k) (h : Polynomial (MvPolynomial (Fin r) k)),
        φ c ≠ 0 ∧ φ c = b * Polynomial.eval₂ φ b h := by
    intro m
    induction m with
    | zero =>
      intro b g hdeg hg hgb hb
      have h1 : g = 1 := Polynomial.eq_one_of_monic_natDegree_zero hg (by omega)
      rw [h1, Polynomial.eval₂_one] at hgb
      exact absurd hgb one_ne_zero
    | succ m ih =>
      intro b g hdeg hg hgb hb
      have key : Polynomial.eval₂ φ b g.divX * b + φ (g.coeff 0) = 0 := by
        have h2 := congrArg (Polynomial.eval₂ φ b) (Polynomial.X_mul_divX_add g)
        rw [Polynomial.eval₂_add, Polynomial.eval₂_X_mul, Polynomial.eval₂_C, hgb] at h2
        exact h2
      by_cases hc : φ (g.coeff 0) = 0
      · rw [hc, add_zero] at key
        have hd0 : Polynomial.eval₂ φ b g.divX = 0 := (mul_eq_zero.mp key).resolve_right hb
        have hN : 1 ≤ g.natDegree := by
          by_contra hlt
          have h1 : g = 1 := Polynomial.eq_one_of_monic_natDegree_zero hg (by omega)
          rw [h1, Polynomial.eval₂_one] at hgb
          exact one_ne_zero hgb
        have hdeg' : g.divX.natDegree = g.natDegree - 1 :=
          Polynomial.natDegree_divX_eq_natDegree_tsub_one
        have hmon : g.divX.Monic := by
          apply Polynomial.monic_of_natDegree_le_of_coeff_eq_one (g.natDegree - 1) (le_of_eq hdeg')
          rw [Polynomial.coeff_divX, Nat.sub_add_cancel hN]
          exact hg.coeff_natDegree
        exact ih b g.divX (by omega) hmon hd0 hb
      · refine ⟨-(g.coeff 0), g.divX, by rwa [map_neg, neg_ne_zero], ?_⟩
        rw [map_neg]
        linear_combination (-1 : K) * key

  have s2 : ∀ B : Polynomial (MvPolynomial (Fin r) k), ∃ g : Polynomial (MvPolynomial (Fin r) k),
      g.Monic ∧ Polynomial.eval₂ φ (Polynomial.eval₂ φ θ B) g = 0 := by
    intro B
    letI : Algebra (MvPolynomial (Fin r) k) K := φ.toAlgebra
    have hθ : _root_.IsIntegral (MvPolynomial (Fin r) k) θ := ⟨p, hp, hpθ⟩
    have hmem : Polynomial.aeval θ B ∈ Algebra.adjoin (MvPolynomial (Fin r) k) {θ} :=
      Polynomial.aeval_mem_adjoin_singleton _ _
    have hint : _root_.IsIntegral (MvPolynomial (Fin r) k) (Polynomial.aeval θ B) :=
      adjoin_le_integralClosure hθ hmem
    obtain ⟨g, hg, hgB⟩ := hint
    exact ⟨g, hg, hgB⟩

  have s3 : ∀ x ∈ Algebra.adjoin k (insert θ (Set.range t)),
      ∃ Q : Polynomial (MvPolynomial (Fin r) k), Polynomial.eval₂ φ θ Q = x := by
    intro x hx
    induction hx using Algebra.adjoin_induction with
    | mem x hx =>
      rcases Set.mem_insert_iff.mp hx with rfl | ⟨j, rfl⟩
      · exact ⟨Polynomial.X, Polynomial.eval₂_X _ _⟩
      · refine ⟨Polynomial.C (MvPolynomial.X j), ?_⟩
        rw [Polynomial.eval₂_C]
        show MvPolynomial.aeval t (MvPolynomial.X j) = t j
        exact MvPolynomial.aeval_X _ _
    | algebraMap a =>
      refine ⟨Polynomial.C (MvPolynomial.C a), ?_⟩
      rw [Polynomial.eval₂_C]
      show MvPolynomial.aeval t (MvPolynomial.C a) = algebraMap k K a
      exact MvPolynomial.aeval_C _ _
    | add x y _ _ hx hy =>
      obtain ⟨Q1, h1⟩ := hx
      obtain ⟨Q2, h2⟩ := hy
      exact ⟨Q1 + Q2, by rw [Polynomial.eval₂_add, h1, h2]⟩
    | mul x y _ _ hx hy =>
      obtain ⟨Q1, h1⟩ := hx
      obtain ⟨Q2, h2⟩ := hy
      exact ⟨Q1 * Q2, by rw [Polynomial.eval₂_mul, h1, h2]⟩

  have s4 : ∀ x ∈ IntermediateField.adjoin k (insert θ (Set.range t)),
      ∃ (δ : MvPolynomial (Fin r) k) (Q : Polynomial (MvPolynomial (Fin r) k)),
        φ δ ≠ 0 ∧ Polynomial.eval₂ φ θ Q = φ δ * x := by
    intro x hx
    obtain ⟨a, ha, b, hb, rfl⟩ := IntermediateField.mem_adjoin_iff_div.mp hx
    obtain ⟨A, hA⟩ := s3 a ha
    obtain ⟨B, hB⟩ := s3 b hb
    by_cases hb0 : b = 0
    · refine ⟨1, 0, by rw [map_one]; exact one_ne_zero, ?_⟩
      rw [hb0, div_zero, mul_zero, Polynomial.eval₂_zero]
    · obtain ⟨g, hg, hgb⟩ := s2 B
      rw [hB] at hgb
      obtain ⟨c, h, hc, hch⟩ := s1 g.natDegree b g le_rfl hg hgb hb0
      refine ⟨c, A * h.comp B, hc, ?_⟩
      rw [Polynomial.eval₂_mul, Polynomial.eval₂_comp, hA, hB, hch]
      field_simp

  choose δ₀ Q₀ hδ₀ hQ₀ using fun i => s4 (μ i) (hμ i)
  refine ⟨∏ j, δ₀ j, fun i => Q₀ i * Polynomial.C (∏ j ∈ Finset.univ.erase i, δ₀ j), ?_, ?_⟩
  · show φ (∏ j, δ₀ j) ≠ 0
    rw [map_prod]
    exact Finset.prod_ne_zero_iff.mpr (fun j _ => hδ₀ j)
  · intro i
    show Polynomial.eval₂ φ θ (Q₀ i * Polynomial.C (∏ j ∈ Finset.univ.erase i, δ₀ j)) =
      φ (∏ j, δ₀ j) * μ i
    rw [Polynomial.eval₂_mul, Polynomial.eval₂_C, hQ₀ i,
      ← Finset.mul_prod_erase Finset.univ δ₀ (Finset.mem_univ i), map_mul]
    ring

theorem wc_cz_ais_minpoly_data : ∀ (k : Type u) [Field k] [CharZero k] (K : Type u) [Field K] [Algebra k K] (r : ℕ) (t : Fin r → K), AlgebraicIndependent k t → ∀ (θ : K) (p : Polynomial (MvPolynomial (Fin r) k)), p.Monic → Polynomial.eval₂ (MvPolynomial.aeval t).toRingHom θ p = 0 → ∃ f : Polynomial (MvPolynomial (Fin r) k), f.Monic ∧ Polynomial.eval₂ (MvPolynomial.aeval t).toRingHom θ f = 0 ∧ Polynomial.eval₂ (MvPolynomial.aeval t).toRingHom θ (Polynomial.derivative f) ≠ 0 ∧ ∀ q : Polynomial (MvPolynomial (Fin r) k), Polynomial.eval₂ (MvPolynomial.aeval t).toRingHom θ q = 0 → f ∣ q :=
by
  intro k _ _ K _ _ r t ht θ p hp hpθ
  letI : Algebra (MvPolynomial (Fin r) k) K := (MvPolynomial.aeval t).toRingHom.toAlgebra
  have hstar : ∀ q : Polynomial (MvPolynomial (Fin r) k),
      Polynomial.aeval θ q = Polynomial.eval₂ (MvPolynomial.aeval t).toRingHom θ q :=
    fun q => rfl
  have hint : _root_.IsIntegral (MvPolynomial (Fin r) k) θ := ⟨p, hp, hpθ⟩
  have hinj : Function.Injective (algebraMap (MvPolynomial (Fin r) k) K) :=
    algebraicIndependent_iff_injective_aeval.mp ht
  haveI : Module.IsTorsionFree (MvPolynomial (Fin r) k) K :=
    Module.isTorsionFree_iff_algebraMap_injective.mpr hinj
  have hmin : ∀ q : Polynomial (MvPolynomial (Fin r) k),
      Polynomial.eval₂ (MvPolynomial.aeval t).toRingHom θ q = 0 →
        minpoly (MvPolynomial (Fin r) k) θ ∣ q := by
    intro q hq
    exact minpoly.isIntegrallyClosed_dvd hint (by rw [hstar]; exact hq)
  have hmon := minpoly.monic hint
  refine ⟨minpoly (MvPolynomial (Fin r) k) θ, hmon, ?_, ?_, hmin⟩
  · rw [← hstar]; exact minpoly.aeval _ _
  · intro h
    have hd := hmin _ h
    have h0 := minpoly.natDegree_pos hint
    have hne : Polynomial.derivative (minpoly (MvPolynomial (Fin r) k) θ) ≠ 0 :=
      Polynomial.derivative_ne_zero.mpr h0.ne'
    exact Polynomial.Monic.not_dvd_of_natDegree_lt hmon hne
      (Polynomial.natDegree_derivative_lt h0.ne') hd

theorem wc_cz_ais_standard_etale_injective : ∀ (P : Type u) [CommRing P] (S : StandardEtalePair P) (K : Type u) [CommRing K] [Algebra P K] (θ : K) (hθ : S.HasMap θ), (∀ q : Polynomial P, Polynomial.aeval θ q = 0 → S.f ∣ q) → Function.Injective (S.lift θ hθ) :=
by
  intro P _ S K _ _ θ hθ hmin
  let m : Polynomial (Polynomial P) →+* S.Ring :=
    Ideal.Quotient.mk (Ideal.span {Polynomial.C S.f, Polynomial.X * Polynomial.C S.g - 1})
  have hX : m (Polynomial.C Polynomial.X) = S.X := rfl
  have hC : ∀ c : P, m (Polynomial.C (Polynomial.C c)) = algebraMap P S.Ring c := fun c => rfl
  have key : Polynomial.aeval S.X S.g * m Polynomial.X = 1 := S.aeval_X_g_mul_mk_X
  have surj : Function.Surjective m := Ideal.Quotient.mk_surjective
  clear_value m
  have s1 : ∀ a : Polynomial P, m (Polynomial.C a) = Polynomial.aeval S.X a := by
    intro a
    induction a using Polynomial.induction_on with
    | C c => rw [Polynomial.aeval_C, hC]
    | add p q hp hq => rw [Polynomial.C_add, map_add, hp, hq, map_add]
    | monomial n c ih =>
      rw [pow_succ, ← mul_assoc, Polynomial.C_mul, map_mul, ih, hX,
        map_mul (Polynomial.aeval S.X) _ Polynomial.X, Polynomial.aeval_X]
  have s2 : ∀ F : Polynomial (Polynomial P), ∃ (N : ℕ) (b : Polynomial P),
      Polynomial.aeval S.X S.g ^ N * m F = Polynomial.aeval S.X b := by
    intro F
    induction F using Polynomial.induction_on with
    | C a => exact ⟨0, a, by rw [pow_zero, one_mul, s1]⟩
    | add F₁ F₂ h₁ h₂ =>
      obtain ⟨N₁, b₁, e₁⟩ := h₁
      obtain ⟨N₂, b₂, e₂⟩ := h₂
      refine ⟨N₁ + N₂, S.g ^ N₂ * b₁ + S.g ^ N₁ * b₂, ?_⟩
      rw [map_add, map_add, map_mul, map_mul, map_pow, map_pow, ← e₁, ← e₂]
      ring
    | monomial n a ih =>
      obtain ⟨N, b, e⟩ := ih
      refine ⟨N + 1, b, ?_⟩
      rw [pow_succ (Polynomial.X : Polynomial (Polynomial P)), ← mul_assoc, map_mul, ← e]
      calc _ = Polynomial.aeval S.X S.g ^ N * m (Polynomial.C a * Polynomial.X ^ n) *
            (Polynomial.aeval S.X S.g * m Polynomial.X) := by ring
        _ = _ := by rw [key, mul_one]
  rw [injective_iff_map_eq_zero]
  intro z hz
  obtain ⟨F, rfl⟩ := surj z
  obtain ⟨N, b, e⟩ := s2 F
  have hb := congrArg (S.lift θ hθ) e
  rw [map_mul, hz, mul_zero, ← Polynomial.aeval_algHom_apply, StandardEtalePair.lift_X] at hb
  obtain ⟨c, rfl⟩ := hmin b hb.symm
  rw [map_mul, S.hasMap_X.1, zero_mul] at e
  exact (IsUnit.mul_right_eq_zero (S.hasMap_X.2.pow N)).mp e

theorem wc_cz_ais_field_smooth_factor : (∀ (P : Type u) [CommRing P] (S : StandardEtalePair P) (K : Type u) [CommRing K] [Algebra P K] (θ : K) (hθ : S.HasMap θ), (∀ q : Polynomial P, Polynomial.aeval θ q = 0 → S.f ∣ q) → Function.Injective (S.lift θ hθ)) → ∀ (k : Type u) [Field k] (P : Type u) [CommRing P] [Algebra k P] [Algebra.Smooth k P] (K : Type u) [Field K] [Algebra k K] (ι : P →ₐ[k] K) (θ : K) (f : Polynomial P), f.Monic → Polynomial.eval₂ ι.toRingHom θ f = 0 → Polynomial.eval₂ ι.toRingHom θ (Polynomial.derivative f) ≠ 0 → (∀ q : Polynomial P, Polynomial.eval₂ ι.toRingHom θ q = 0 → f ∣ q) → ∀ (δ : P), ι δ ≠ 0 → ∀ (n : ℕ) (μ : Fin n → K) (Q : Fin n → Polynomial P), (∀ i, Polynomial.eval₂ ι.toRingHom θ (Q i) = ι δ * μ i) → ∀ (s : Finset (MvPolynomial (Fin n) k)), (∀ g ∈ s, MvPolynomial.aeval μ g = 0) → ∃ (D : Type u) (_ : CommRing D) (_ : Algebra k D) (_ : Algebra.Smooth k D) (c : Fin n → D) (h : D →ₐ[k] K), (∀ g ∈ s, MvPolynomial.aeval c g = 0) ∧ ∀ i, h (c i) = μ i :=
by
  intro H5 k _ P _ _ _ K _ _ ι θ f hf hfθ hf' hmin δ hδ n μ Q hQ s hs
  letI algPK : Algebra P K := ι.toRingHom.toAlgebra
  haveI : IsScalarTower k P K :=
    IsScalarTower.of_algebraMap_eq (fun x => (ι.commutes x).symm)
  let S : StandardEtalePair P :=
    ⟨f, hf, Polynomial.C δ * Polynomial.derivative f, ⟨Polynomial.C δ, 0, 1, by ring⟩⟩
  have hg : Polynomial.aeval θ S.g = ι δ * Polynomial.aeval θ (Polynomial.derivative f) := by
    show Polynomial.aeval θ (Polynomial.C δ * Polynomial.derivative f) = _
    rw [Polynomial.aeval_mul, Polynomial.aeval_C]
    rfl
  have hθ : S.HasMap θ := by
    unfold StandardEtalePair.HasMap
    refine ⟨hfθ, ?_⟩
    rw [hg]
    exact (mul_ne_zero hδ hf').isUnit
  have hinj : Function.Injective (S.lift θ hθ) := H5 P S K θ hθ (fun q hq => hmin q hq)
  letI algKD : Algebra k S.Ring := ((algebraMap P S.Ring).comp (algebraMap k P)).toAlgebra
  haveI : IsScalarTower k P S.Ring := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  haveI smKD : Algebra.Smooth k S.Ring := Algebra.Smooth.comp k P S.Ring
  have hX : ∀ q : Polynomial P, S.lift θ hθ (Polynomial.aeval S.X q) = Polynomial.aeval θ q := by
    intro q
    rw [← Polynomial.aeval_algHom_apply, StandardEtalePair.lift_X]
  obtain ⟨u, hu⟩ := S.hasMap_X.2
  let c : Fin n → S.Ring := fun i =>
    Polynomial.aeval S.X (Q i) * Polynomial.aeval S.X (Polynomial.derivative f) * ↑u⁻¹
  have hw : ι δ * Polynomial.aeval θ (Polynomial.derivative f) * S.lift θ hθ ↑u⁻¹ = 1 := by
    rw [← hg, ← hX, ← hu, ← map_mul, Units.mul_inv, map_one]
  have hc : ∀ i, S.lift θ hθ (c i) = μ i := by
    intro i
    have hQi : Polynomial.aeval θ (Q i) = ι δ * μ i := hQ i
    simp only [c, map_mul, hX, hQi]
    linear_combination (μ i) * hw
  refine ⟨S.Ring, inferInstance, algKD, smKD, c, (S.lift θ hθ).restrictScalars k, ?_,
    fun i => hc i⟩
  intro g hgs
  apply hinj
  rw [map_zero]
  have key : ((S.lift θ hθ).restrictScalars k) (MvPolynomial.aeval c g) =
      MvPolynomial.aeval (fun i => ((S.lift θ hθ).restrictScalars k) (c i)) g :=
    MvPolynomial.comp_aeval_apply _ _ _
  have e : (fun i => ((S.lift θ hθ).restrictScalars k) (c i)) = μ := funext hc
  rw [e, hs g hgs] at key
  exact key

theorem wc_cz_ais_residue_approx : ∀ (k : Type u) [Field k] (R : Type u) [CommRing R] [Algebra k R] (𝔫 : Ideal R) (ε : R →ₐ[k] k), (∀ r : R, r - algebraMap k R (ε r) ∈ 𝔫) → ∀ (L : Type u) [CommRing L] [IsLocalRing L] [Algebra R L] [Algebra k L] [IsScalarTower k R L], Ideal.map (algebraMap R L) 𝔫 = IsLocalRing.maximalIdeal L → IsNilpotent (IsLocalRing.maximalIdeal L) → (∀ (n : ℕ) (s : Finset (MvPolynomial (Fin n) k)) (μ : Fin n → IsLocalRing.ResidueField L), (∀ g ∈ s, MvPolynomial.aeval μ g = 0) → ∃ (D : Type u) (_ : CommRing D) (_ : Algebra k D) (_ : Algebra.Smooth k D) (c : Fin n → D) (h : D →ₐ[k] IsLocalRing.ResidueField L), (∀ g ∈ s, MvPolynomial.aeval c g = 0) ∧ ∀ i, h (c i) = μ i) → ∀ (n : ℕ) (s : Finset (MvPolynomial (Fin n) R)) (v : Fin n → L), (∀ g ∈ s, MvPolynomial.aeval v g = 0) → ∃ (B : Type u) (_ : CommRing B) (_ : Algebra R B) (_ : Algebra.Smooth R B) (β : B →ₐ[R] L) (b : Fin n → B), (∀ g ∈ s, MvPolynomial.aeval b g ∈ Ideal.map (algebraMap R B) 𝔫) ∧ ∀ i, β (b i) = v i :=
by
  intro k _ R _ _ 𝔫 ε hε L _ _ _ _ _ hmax hnil oracle n s v hv
  classical

  have hρ : ∀ r : R, IsLocalRing.residue L (algebraMap R L r) =
      algebraMap k (IsLocalRing.ResidueField L) (ε r) := by
    intro r
    have h1 : algebraMap R L (r - algebraMap k R (ε r)) ∈ IsLocalRing.maximalIdeal L := by
      rw [← hmax]; exact Ideal.mem_map_of_mem _ (hε r)
    have h2 : IsLocalRing.residue L (algebraMap R L (r - algebraMap k R (ε r))) = 0 :=
      (IsLocalRing.residue_eq_zero_iff _).mpr h1
    rw [map_sub, map_sub, sub_eq_zero] at h2
    rw [h2, ← IsScalarTower.algebraMap_apply k R L,
      IsScalarTower.algebraMap_apply k L (IsLocalRing.ResidueField L),
      IsLocalRing.ResidueField.algebraMap_eq]

  have hsol : ∀ g ∈ s, MvPolynomial.aeval (fun i => IsLocalRing.residue L (v i))
      (MvPolynomial.map (ε : R →+* k) g) = 0 := by
    intro g hg
    have e : ((MvPolynomial.aeval (fun i => IsLocalRing.residue L (v i))).toRingHom.comp
        (MvPolynomial.map (ε : R →+* k))) =
        (IsLocalRing.residue L).comp (MvPolynomial.aeval v).toRingHom := by
      apply MvPolynomial.ringHom_ext
      · intro r
        simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
          MvPolynomial.map_C, MvPolynomial.aeval_C]
        rw [hρ]
      · intro i
        simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
          MvPolynomial.map_X, MvPolynomial.aeval_X]
    have := DFunLike.congr_fun e g
    simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe] at this
    rw [this, hv g hg, map_zero]

  obtain ⟨D, iD, aD, sD, c, h, hc, hh⟩ := oracle n (s.image (MvPolynomial.map (ε : R →+* k)))
    (fun i => IsLocalRing.residue L (v i)) (by
      intro g' hg'
      obtain ⟨g, hg, rfl⟩ := Finset.mem_image.mp hg'
      exact hsol g hg)
  have hc' : ∀ g ∈ s, MvPolynomial.aeval c (MvPolynomial.map (ε : R →+* k) g) = 0 :=
    fun g hg => hc _ (Finset.mem_image_of_mem _ hg)

  let q : L →ₐ[k] IsLocalRing.ResidueField L :=
    IsScalarTower.toAlgHom k L (IsLocalRing.ResidueField L)
  have hq : ∀ x, q x = IsLocalRing.residue L x := by
    intro x
    rw [IsScalarTower.toAlgHom_apply, IsLocalRing.ResidueField.algebraMap_eq]
  have hqsurj : Function.Surjective q := by
    intro y
    obtain ⟨x, rfl⟩ := IsLocalRing.residue_surjective y
    exact ⟨x, hq x⟩
  have hqker : RingHom.ker (q : L →+* IsLocalRing.ResidueField L) =
      IsLocalRing.maximalIdeal L := by
    ext x
    rw [RingHom.mem_ker, RingHom.coe_coe, hq, IsLocalRing.residue_eq_zero_iff]
  have hnil' : IsNilpotent (RingHom.ker (q : L →+* IsLocalRing.ResidueField L)) := by
    rw [hqker]; exact hnil
  let ht : D →ₐ[k] L := Algebra.FormallySmooth.liftOfSurjective h q hqsurj hnil'
  have hht : ∀ x, IsLocalRing.residue L (ht x) = h x := by
    intro x
    rw [← hq]
    exact Algebra.FormallySmooth.liftOfSurjective_apply h q hqsurj hnil' x

  have herr : ∀ i, v i - ht (c i) ∈ Ideal.span (algebraMap R L '' 𝔫) := by
    intro i
    have h1 : v i - ht (c i) ∈ IsLocalRing.maximalIdeal L := by
      rw [← IsLocalRing.residue_eq_zero_iff, map_sub, hht, hh, sub_self]
    rw [← hmax] at h1
    exact h1
  have hrep : ∀ i, ∃ (m : ℕ) (lam : Fin m → L) (a : Fin m → R), (∀ j, a j ∈ 𝔫) ∧
      v i - ht (c i) = ∑ j, lam j * algebraMap R L (a j) := by
    intro i
    obtain ⟨m, lam, g, hg⟩ := Submodule.mem_span_set'.mp (herr i)
    choose a ha hag using fun j => (g j).2
    refine ⟨m, lam, a, ha, ?_⟩
    rw [← hg]
    simp only [hag, smul_eq_mul]
  choose M lam a ha hrep using hrep

  let D' := MvPolynomial (Σ i : Fin n, Fin (M i)) D
  haveI : Algebra.Smooth k D' := Algebra.Smooth.comp k D D'
  let h' : D' →ₐ[k] L :=
    { MvPolynomial.eval₂Hom (ht : D →+* L) (fun p => lam p.1 p.2) with
      commutes' := fun x => by
        show MvPolynomial.eval₂Hom (ht : D →+* L) (fun p => lam p.1 p.2)
          (algebraMap k D' x) = algebraMap k L x
        rw [MvPolynomial.algebraMap_apply, MvPolynomial.eval₂Hom_C]
        exact ht.commutes x }
  have h'C : ∀ d, h' (MvPolynomial.C d) = ht d := fun d => MvPolynomial.eval₂Hom_C _ _ _
  have h'X : ∀ p, h' (MvPolynomial.X p) = lam p.1 p.2 := fun p => MvPolynomial.eval₂Hom_X' _ _ _

  let ιD : D' →ₐ[k] TensorProduct k R D' := Algebra.TensorProduct.includeRight
  let β : TensorProduct k R D' →ₐ[R] L :=
    Algebra.TensorProduct.productLeftAlgHom (Algebra.ofId R L) h'
  have hβ : ∀ d, β (ιD d) = h' d := by
    intro d
    show Algebra.TensorProduct.lift (Algebra.ofId R L) h' _ ((1 : R) ⊗ₜ d) = h' d
    rw [Algebra.TensorProduct.lift_tmul, map_one, one_mul]
  let b : Fin n → TensorProduct k R D' := fun i => ιD (MvPolynomial.C (c i)) +
    ∑ j, algebraMap R (TensorProduct k R D') (a i j) * ιD (MvPolynomial.X ⟨i, j⟩)
  refine ⟨TensorProduct k R D', inferInstance, inferInstance, inferInstance, β, b, ?_, ?_⟩
  · intro g hg
    rw [← Ideal.Quotient.eq_zero_iff_mem]
    have e : (Ideal.Quotient.mk (Ideal.map (algebraMap R (TensorProduct k R D')) 𝔫)).comp
        (MvPolynomial.aeval b).toRingHom =
        (Ideal.Quotient.mk (Ideal.map (algebraMap R (TensorProduct k R D')) 𝔫)).comp
          (((ιD : D' →+* TensorProduct k R D').comp (MvPolynomial.C : D →+* D')).comp
            ((MvPolynomial.aeval c).toRingHom.comp (MvPolynomial.map (ε : R →+* k)))) := by
      apply MvPolynomial.ringHom_ext
      · intro r
        have e1 : ιD (MvPolynomial.C (algebraMap k D (ε r))) =
            algebraMap R (TensorProduct k R D') (algebraMap k R (ε r)) := by
          rw [← MvPolynomial.algebraMap_apply, AlgHom.commutes,
            IsScalarTower.algebraMap_apply k R (TensorProduct k R D')]
        simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
          MvPolynomial.map_C, MvPolynomial.aeval_C]
        rw [e1, Ideal.Quotient.eq, ← map_sub]
        exact Ideal.mem_map_of_mem _ (hε r)
      · intro i
        simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
          MvPolynomial.map_X, MvPolynomial.aeval_X]
        rw [Ideal.Quotient.eq]
        simp only [b, add_sub_cancel_left]
        exact Ideal.sum_mem _ (fun j _ => Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ (ha i j)))
    have := DFunLike.congr_fun e g
    simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe] at this
    rw [this, hc' g hg, map_zero, map_zero, map_zero]
  · intro i
    simp only [b, map_add, map_sum, map_mul, AlgHom.commutes, hβ, h'C, h'X]
    rw [eq_comm, ← sub_eq_iff_eq_add', hrep i]
    exact Finset.sum_congr rfl (fun j _ => mul_comm _ _)

theorem wc_cz_ais_lift_through_approx : ∀ (R : Type u) [CommRing R] (I : Ideal R) (N : ℕ), I ^ N = ⊥ → ∀ (Λ : Type u) [CommRing Λ] [Algebra R Λ], (∀ (n : ℕ) (s : Finset (MvPolynomial (Fin n) R)) (v : Fin n → Λ), (∀ g ∈ s, MvPolynomial.aeval v g = 0) → ∃ (B : Type u) (_ : CommRing B) (_ : Algebra R B) (_ : Algebra.Smooth R B) (β : B →ₐ[R] Λ) (b : Fin n → B), (∀ g ∈ s, MvPolynomial.aeval b g ∈ Ideal.map (algebraMap R B) I) ∧ ∀ i, β (b i) = v i) → ∀ (B : Type u) [CommRing B] [Algebra R B] [Algebra.Smooth R B] (β : B →ₐ[R] Λ) (q p : ℕ) (a : Fin q → Fin p → R) (b : Fin q → B) (l : Fin p → Λ), (∀ i, β (b i) = ∑ j, a i j • l j) → ∃ (B' : Type u) (_ : CommRing B') (_ : Algebra R B') (_ : Algebra.Smooth R B') (α : B →ₐ[R] B') (β' : B' →ₐ[R] Λ) (ξ : Fin p → B'), β'.comp α = β ∧ ∀ i, α (b i) - ∑ j, a i j • ξ j ∈ Ideal.map (algebraMap R B') I :=
by
  classical
  intro R _ I N hI Λ _ _ AP B _ _ _ β q p a b l hrel
  obtain ⟨m, π, hπ, hker⟩ := Algebra.FinitePresentation.out (R := R) (A := B)
  obtain ⟨S, hS⟩ := hker
  choose P hP using fun i => hπ (b i)
  let y : Fin m → Fin (m + p) := Fin.castAdd p
  let w : Fin p → Fin (m + p) := Fin.natAdd m
  let v : Fin (m + p) → Λ := Fin.append (fun k => β (π (MvPolynomial.X k))) l
  let r : Fin q → MvPolynomial (Fin (m + p)) R := fun i =>
    MvPolynomial.rename y (P i) - ∑ j, MvPolynomial.C (a i j) * MvPolynomial.X (w j)
  let s : Finset (MvPolynomial (Fin (m + p)) R) :=
    S.image (MvPolynomial.rename y) ∪ Finset.univ.image r
  have hevr : ∀ (T : Type u) [CommRing T] [Algebra R T] (c : Fin (m + p) → T) (i : Fin q),
      MvPolynomial.aeval c (r i) = MvPolynomial.aeval (c ∘ y) (P i) - ∑ j, a i j • c (w j) := by
    intro T _ _ c i
    simp only [r, map_sub, map_sum, map_mul, MvPolynomial.aeval_C, MvPolynomial.aeval_X,
      MvPolynomial.aeval_rename, Algebra.smul_def]
  have hstar : ∀ x, MvPolynomial.aeval (v ∘ y) x = β (π x) := by
    intro x
    have h1 : v ∘ y = (β.comp π) ∘ MvPolynomial.X := by
      funext k
      simp [v, y, Fin.append_left]
    rw [h1]
    exact (DFunLike.congr_fun (MvPolynomial.aeval_unique (β.comp π)) x).symm
  have hkerS : ∀ x, π x = 0 → x ∈ Ideal.span (S : Set (MvPolynomial (Fin m) R)) := by
    intro x hx
    have hx' : x ∈ RingHom.ker π := RingHom.mem_ker.mpr hx
    rw [show Ideal.span (S : Set (MvPolynomial (Fin m) R)) = _ from hS]
    exact hx'
  have hSker : ∀ g₀ ∈ S, π g₀ = 0 := by
    intro g₀ hg₀
    have h1 : g₀ ∈ Ideal.span (S : Set (MvPolynomial (Fin m) R)) := Ideal.subset_span hg₀
    rw [show Ideal.span (S : Set (MvPolynomial (Fin m) R)) = _ from hS] at h1
    exact RingHom.mem_ker.mp h1
  have hvw : ∀ j, v (w j) = l j := fun j => by simp [v, w, Fin.append_right]
  have hsv : ∀ g ∈ s, MvPolynomial.aeval v g = 0 := by
    intro g hg
    rcases Finset.mem_union.mp hg with h | h
    · obtain ⟨g₀, hg₀, rfl⟩ := Finset.mem_image.mp h
      rw [MvPolynomial.aeval_rename, hstar, hSker g₀ hg₀, map_zero]
    · obtain ⟨i, _, rfl⟩ := Finset.mem_image.mp h
      rw [hevr, hstar, hP, hrel]
      simp only [hvw, sub_self]
  obtain ⟨B', _, _, _, β', c, hcI, hβc⟩ := AP (m + p) s v hsv
  let J : Ideal B' := Ideal.map (algebraMap R B') I ⊓ RingHom.ker β'
  have hJnil : IsNilpotent J := by
    refine ⟨N, ?_⟩
    have h1 : J ^ N ≤ (Ideal.map (algebraMap R B') I) ^ N := Ideal.pow_right_mono inf_le_left N
    rw [← Ideal.map_pow, hI, Ideal.map_bot] at h1
    rw [Ideal.zero_eq_bot]
    exact le_bot_iff.mp h1
  have hcJ : ∀ g ∈ s, MvPolynomial.aeval c g ∈ J := by
    intro g hg
    refine Ideal.mem_inf.mpr ⟨hcI g hg, ?_⟩
    rw [RingHom.mem_ker]
    have h1 := DFunLike.congr_fun (MvPolynomial.comp_aeval c β') g
    rw [AlgHom.comp_apply] at h1
    rw [h1]
    have : (fun i => β' (c i)) = v := funext hβc
    rw [this]
    exact hsv g hg
  have hθS : ∀ g₀ ∈ S, MvPolynomial.aeval (c ∘ y) g₀ ∈ J := by
    intro g₀ hg₀
    have := hcJ (MvPolynomial.rename y g₀)
      (Finset.mem_union_left _ (Finset.mem_image_of_mem _ hg₀))
    rwa [MvPolynomial.aeval_rename] at this
  have hθker : ∀ x, π x = 0 → MvPolynomial.aeval (c ∘ y) x ∈ J := by
    intro x hx
    have hle : Ideal.span (S : Set (MvPolynomial (Fin m) R)) ≤
        J.comap (MvPolynomial.aeval (c ∘ y)) :=
      Ideal.span_le.mpr (fun g hg => hθS g hg)
    exact hle (hkerS x hx)
  have : Algebra.FormallySmooth R B := inferInstance
  let ψ₀ : MvPolynomial (Fin m) R →ₐ[R] B' ⧸ J :=
    (Ideal.Quotient.mkₐ R J).comp (MvPolynomial.aeval (c ∘ y))
  have hψ₀ : ∀ x ∈ RingHom.ker π, ψ₀ x = 0 := by
    intro x hx
    show Ideal.Quotient.mk J (MvPolynomial.aeval (c ∘ y) x) = 0
    rw [Ideal.Quotient.eq_zero_iff_mem]
    exact hθker x (RingHom.mem_ker.mp hx)
  let ψ₁ := Ideal.Quotient.liftₐ (RingHom.ker π) ψ₀ hψ₀
  let e := Ideal.quotientKerAlgEquivOfSurjective hπ
  let ψ : B →ₐ[R] B' ⧸ J := ψ₁.comp e.symm.toAlgHom
  let α : B →ₐ[R] B' := Algebra.FormallySmooth.lift J hJnil ψ
  have hα : ∀ x, α (π x) - MvPolynomial.aeval (c ∘ y) x ∈ J := by
    intro x
    rw [← Ideal.Quotient.eq]
    have h1 := Algebra.FormallySmooth.mk_lift J hJnil ψ (π x)
    have h2 : e.symm (π x) = Ideal.Quotient.mk _ x :=
      Ideal.quotientKerAlgEquivOfSurjective_symm_apply hπ x
    have h3 : ψ (π x) = Ideal.Quotient.mk J (MvPolynomial.aeval (c ∘ y) x) := by
      show ψ₁ (e.symm (π x)) = _
      rw [h2]
      rfl
    rw [← h3]
    exact h1
  have hcomp : β'.comp α = β := by
    ext z
    obtain ⟨x, rfl⟩ := hπ z
    have h1 : α (π x) - MvPolynomial.aeval (c ∘ y) x ∈ RingHom.ker β' :=
      (inf_le_right : J ≤ _) (hα x)
    rw [RingHom.mem_ker, map_sub, sub_eq_zero] at h1
    rw [AlgHom.comp_apply, h1]
    have h2 := DFunLike.congr_fun (MvPolynomial.comp_aeval (c ∘ y) β') x
    rw [AlgHom.comp_apply] at h2
    rw [h2]
    have : (fun i => β' ((c ∘ y) i)) = v ∘ y := funext fun i => hβc (y i)
    rw [this, hstar]
  refine ⟨B', inferInstance, inferInstance, inferInstance, α, β', c ∘ w, hcomp, fun i => ?_⟩
  have h1 := hα (P i)
  have h2 := hcJ (r i) (Finset.mem_union_right _ (Finset.mem_image_of_mem _ (Finset.mem_univ i)))
  rw [hevr] at h2
  have key : α (b i) - ∑ j, a i j • (c ∘ w) j =
      (α (π (P i)) - MvPolynomial.aeval (c ∘ y) (P i)) +
        (MvPolynomial.aeval (c ∘ y) (P i) - ∑ j, a i j • c (w j)) := by
    rw [hP, sub_add_sub_cancel]
    rfl
  rw [key]
  exact (inf_le_left : J ≤ _) (J.add_mem h1 h2)

theorem wc_cz_ais_adic_step : ∀ (R : Type u) [CommRing R] (I : Ideal R) (Λ : Type u) [CommRing Λ] [Algebra R Λ] [Module.Flat R Λ], (∀ (B : Type u) [CommRing B] [Algebra R B] [Algebra.Smooth R B] (β : B →ₐ[R] Λ) (q p : ℕ) (a : Fin q → Fin p → R) (b : Fin q → B) (l : Fin p → Λ), (∀ i, β (b i) = ∑ j, a i j • l j) → ∃ (B' : Type u) (_ : CommRing B') (_ : Algebra R B') (_ : Algebra.Smooth R B') (α : B →ₐ[R] B') (β' : B' →ₐ[R] Λ) (ξ : Fin p → B'), β'.comp α = β ∧ ∀ i, α (b i) - ∑ j, a i j • ξ j ∈ Ideal.map (algebraMap R B') I) → ∀ (m : ℕ) (B : Type u) [CommRing B] [Algebra R B] [Algebra.Smooth R B] (β : B →ₐ[R] Λ) (h : B), h ∈ Ideal.map (algebraMap R B) (I ^ m) → β h = 0 → ∃ (B' : Type u) (_ : CommRing B') (_ : Algebra R B') (_ : Algebra.Smooth R B') (α : B →ₐ[R] B') (β' : B' →ₐ[R] Λ), β'.comp α = β ∧ α h ∈ Ideal.map (algebraMap R B') (I ^ (m + 1)) :=
by
  intro R _ I Λ _ _ _ H m B _ _ _ β h hh hβ
  classical
  have hh' : h ∈ Submodule.span B (algebraMap R B '' ((I ^ m : Ideal R) : Set R)) := hh
  obtain ⟨q, c, g, hsum⟩ := (Submodule.mem_span_set').mp hh'
  have hg : ∀ i, ∃ e, e ∈ I ^ m ∧ algebraMap R B e = (g i : B) := fun i => (g i).2
  choose ε hε hεg using hg
  have E1 : h = ∑ i, c i * algebraMap R B (ε i) := by
    rw [← hsum]
    simp only [smul_eq_mul, hεg]
  have s2 : ∑ i, ε i • β (c i) = 0 := by
    rw [← hβ, E1, map_sum]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [map_mul, AlgHom.commutes, Algebra.smul_def, mul_comm]
  obtain ⟨p, a, l, E2, E3⟩ := Module.Flat.isTrivialRelation_of_sum_smul_eq_zero (R := R) (M := Λ)
    (f := ε) (x := fun i => β (c i)) s2
  obtain ⟨B', i1, i2, i3, α, β', ξ, hcomp, hrel⟩ := H B β q p a c l E2
  refine ⟨B', i1, i2, i3, α, β', hcomp, ?_⟩
  have hzero : ∑ i, (∑ j, a i j • ξ j) * algebraMap R B' (ε i) = 0 := by
    have e : ∑ i, (∑ j, a i j • ξ j) * algebraMap R B' (ε i)
        = ∑ j, algebraMap R B' (∑ i, ε i * a i j) * ξ j := by
      simp only [Finset.sum_mul, map_sum, Algebra.smul_def, map_mul]
      rw [Finset.sum_comm]
      exact Finset.sum_congr rfl (fun j _ => Finset.sum_congr rfl (fun i _ => by ring))
    rw [e]
    simp [E3]
  have E4 : α h = ∑ i, (α (c i) - ∑ j, a i j • ξ j) * algebraMap R B' (ε i) := by
    have e : α h = ∑ i, (α (c i) - ∑ j, a i j • ξ j) * algebraMap R B' (ε i)
        + ∑ i, (∑ j, a i j • ξ j) * algebraMap R B' (ε i) := by
      rw [← Finset.sum_add_distrib, E1, map_sum]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [map_mul, AlgHom.commutes, ← add_mul, sub_add_cancel]
    rw [e, hzero, add_zero]
  rw [E4]
  refine Ideal.sum_mem _ (fun i _ => ?_)
  rw [pow_succ', Ideal.map_mul]
  exact Ideal.mul_mem_mul (hrel i) (Ideal.mem_map_of_mem _ (hε i))

theorem wc_pfc_cz_artinian_ind_smooth : ∀ (k : Type u) [Field k] [CharZero k] (d e : ℕ) (L : Type u) [CommRing L] [IsLocalRing L] [Algebra (MvPolynomial (Fin d) k ⧸ Ideal.span (Set.range fun i : Fin d => (MvPolynomial.X i : MvPolynomial (Fin d) k) ^ e)) L] [Module.Flat (MvPolynomial (Fin d) k ⧸ Ideal.span (Set.range fun i : Fin d => (MvPolynomial.X i : MvPolynomial (Fin d) k) ^ e)) L], IsLocalRing.maximalIdeal L = Ideal.span (Set.range fun i : Fin d => algebraMap (MvPolynomial (Fin d) k ⧸ Ideal.span (Set.range fun i : Fin d => (MvPolynomial.X i : MvPolynomial (Fin d) k) ^ e)) L (Ideal.Quotient.mk _ (MvPolynomial.X i))) → ∀ (E : Type u) [CommRing E] [Algebra (MvPolynomial (Fin d) k ⧸ Ideal.span (Set.range fun i : Fin d => (MvPolynomial.X i : MvPolynomial (Fin d) k) ^ e)) E] [Algebra.FinitePresentation (MvPolynomial (Fin d) k ⧸ Ideal.span (Set.range fun i : Fin d => (MvPolynomial.X i : MvPolynomial (Fin d) k) ^ e)) E] (f : E →ₐ[MvPolynomial (Fin d) k ⧸ Ideal.span (Set.range fun i : Fin d => (MvPolynomial.X i : MvPolynomial (Fin d) k) ^ e)] L), ∃ (C : Type u) (_ : CommRing C) (_ : Algebra (MvPolynomial (Fin d) k ⧸ Ideal.span (Set.range fun i : Fin d => (MvPolynomial.X i : MvPolynomial (Fin d) k) ^ e)) C) (_ : Algebra.Smooth (MvPolynomial (Fin d) k ⧸ Ideal.span (Set.range fun i : Fin d => (MvPolynomial.X i : MvPolynomial (Fin d) k) ^ e)) C) (g : E →ₐ[MvPolynomial (Fin d) k ⧸ Ideal.span (Set.range fun i : Fin d => (MvPolynomial.X i : MvPolynomial (Fin d) k) ^ e)] C) (h : C →ₐ[MvPolynomial (Fin d) k ⧸ Ideal.span (Set.range fun i : Fin d => (MvPolynomial.X i : MvPolynomial (Fin d) k) ^ e)] L), h.comp g = f :=
by
  intro k _ _ d e L _ _ _ _ hmax E _ _ _ f


  have key : ∀ (R : Type u) [CommRing R] [Algebra k R] (𝔫 : Ideal R) (ε : R →ₐ[k] k),
      (∀ r : R, r - algebraMap k R (ε r) ∈ 𝔫) → ∀ (N : ℕ), 𝔫 ^ N = ⊥ →
      ∀ (L : Type u) [CommRing L] [IsLocalRing L] [Algebra R L] [Module.Flat R L],
      IsLocalRing.maximalIdeal L = Ideal.map (algebraMap R L) 𝔫 →
      ∀ (E : Type u) [CommRing E] [Algebra R E] [Algebra.FinitePresentation R E] (f : E →ₐ[R] L),
      ∃ (C : Type u) (_ : CommRing C) (_ : Algebra R C) (_ : Algebra.Smooth R C) (g : E →ₐ[R] C)
        (h : C →ₐ[R] L), h.comp g = f := by
    intro R _ _ 𝔫 ε hε N hN L _ _ _ _ hmaxL E _ _ _ f
    letI : Algebra k L := ((algebraMap R L).comp (algebraMap k R)).toAlgebra
    haveI : IsScalarTower k R L := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    have hnil : IsNilpotent (IsLocalRing.maximalIdeal L) :=
      ⟨N, by rw [hmaxL, ← Ideal.map_pow, hN, Ideal.map_bot]; exact Ideal.zero_eq_bot.symm⟩

    have oracle : ∀ (n : ℕ) (s : Finset (MvPolynomial (Fin n) k))
        (μ : Fin n → IsLocalRing.ResidueField L), (∀ g ∈ s, MvPolynomial.aeval μ g = 0) →
        ∃ (D : Type u) (_ : CommRing D) (_ : Algebra k D) (_ : Algebra.Smooth k D) (c : Fin n → D)
          (h : D →ₐ[k] IsLocalRing.ResidueField L),
          (∀ g ∈ s, MvPolynomial.aeval c g = 0) ∧ ∀ i, h (c i) = μ i := by
      intro n s μ hs
      obtain ⟨r, t, ht, halg⟩ := wc_cz_ais_transcendence_reduction k (IsLocalRing.ResidueField L) n μ
      obtain ⟨θ, p, hp, hpθ, hμ⟩ := wc_cz_ais_primitive_integral k _ r t n μ ht halg
      obtain ⟨δ, Q, hδ, hQ⟩ := wc_cz_ais_clear_denominators k _ r t θ p hp hpθ n μ hμ
      obtain ⟨f₀, hf₀m, hf₀θ, hf₀', hf₀min⟩ := wc_cz_ais_minpoly_data k _ r t ht θ p hp hpθ
      exact wc_cz_ais_field_smooth_factor wc_cz_ais_standard_etale_injective k
        (MvPolynomial (Fin r) k) _ (MvPolynomial.aeval t) θ f₀ hf₀m hf₀θ hf₀' hf₀min δ hδ n μ Q hQ
        s hs

    have happrox := wc_cz_ais_residue_approx k R 𝔫 ε hε L hmaxL.symm hnil oracle
    have hlift := wc_cz_ais_lift_through_approx R 𝔫 N hN L happrox
    have hadic := wc_cz_ais_adic_step R 𝔫 L hlift

    have hone : ∀ (j : ℕ) (B : Type u) [CommRing B] [Algebra R B] [Algebra.Smooth R B]
        (β : B →ₐ[R] L) (h : B), β h = 0 →
        ∃ (B' : Type u) (_ : CommRing B') (_ : Algebra R B') (_ : Algebra.Smooth R B')
          (α : B →ₐ[R] B') (β' : B' →ₐ[R] L),
          β'.comp α = β ∧ α h ∈ Ideal.map (algebraMap R B') (𝔫 ^ j) := by
      intro j
      induction j with
      | zero =>
        intro B _ _ _ β h _
        refine ⟨B, inferInstance, inferInstance, inferInstance, AlgHom.id R B, β,
          AlgHom.comp_id β, ?_⟩
        rw [pow_zero, Ideal.one_eq_top, Ideal.map_top]
        exact Submodule.mem_top
      | succ j ih =>
        intro B _ _ _ β h hh
        obtain ⟨B₁, i1, a1, s1, α₁, β₁, hc1, hm1⟩ := ih B β h hh
        have hβ1 : β₁ (α₁ h) = 0 := by rw [← AlgHom.comp_apply, hc1, hh]
        obtain ⟨B₂, i2, a2, s2, α₂, β₂, hc2, hm2⟩ := hadic j B₁ β₁ (α₁ h) hm1 hβ1
        refine ⟨B₂, i2, a2, s2, α₂.comp α₁, β₂, ?_, hm2⟩
        rw [← AlgHom.comp_assoc, hc2, hc1]

    have hfam : ∀ (m : ℕ) (B : Type u) [CommRing B] [Algebra R B] [Algebra.Smooth R B]
        (β : B →ₐ[R] L) (t : Fin m → B), (∀ i, β (t i) = 0) →
        ∃ (B' : Type u) (_ : CommRing B') (_ : Algebra R B') (_ : Algebra.Smooth R B')
          (α : B →ₐ[R] B') (β' : B' →ₐ[R] L), β'.comp α = β ∧ ∀ i, α (t i) = 0 := by
      intro m
      induction m with
      | zero =>
        intro B _ _ _ β t _
        exact ⟨B, inferInstance, inferInstance, inferInstance, AlgHom.id R B, β,
          AlgHom.comp_id β, fun i => i.elim0⟩
      | succ m ih =>
        intro B _ _ _ β t ht
        obtain ⟨B₁, i1, a1, s1, α₁, β₁, hc1, hm1⟩ := hone N B β (t 0) (ht 0)
        rw [hN, Ideal.map_bot, Ideal.mem_bot] at hm1
        obtain ⟨B₂, i2, a2, s2, α₂, β₂, hc2, hm2⟩ := ih B₁ β₁ (fun i => α₁ (t i.succ))
          (fun i => by rw [← AlgHom.comp_apply, hc1, ht])
        refine ⟨B₂, i2, a2, s2, α₂.comp α₁, β₂, by rw [← AlgHom.comp_assoc, hc2, hc1], ?_⟩
        intro i
        rcases Fin.eq_zero_or_eq_succ i with rfl | ⟨j, rfl⟩
        · rw [AlgHom.comp_apply, hm1, map_zero]
        · exact hm2 j

    obtain ⟨n, π, hπs, hfg⟩ := Algebra.FinitePresentation.out (R := R) (A := E)
    obtain ⟨G, hG⟩ := hfg
    have hGk : ∀ t ∈ G, π t = 0 := by
      intro t ht
      have h1 : t ∈ RingHom.ker π.toRingHom := hG ▸ Ideal.subset_span ht
      exact RingHom.mem_ker.mp h1
    obtain ⟨B', i', a', s', α, β', hc, hα⟩ := hfam G.card (MvPolynomial (Fin n) R) (f.comp π)
      (fun i => (G.equivFin.symm i : MvPolynomial (Fin n) R))
      (fun i => by rw [AlgHom.comp_apply, hGk _ (G.equivFin.symm i).2, map_zero])
    have hαG : ∀ t ∈ G, α t = 0 := by
      intro t ht
      have := hα (G.equivFin ⟨t, ht⟩)
      simpa using this
    have hker : ∀ a : MvPolynomial (Fin n) R, a ∈ RingHom.ker π → α a = 0 := by
      intro a ha
      have hle : RingHom.ker π.toRingHom ≤ RingHom.ker α.toRingHom := by
        rw [← hG, Ideal.span_le]
        intro t ht
        exact RingHom.mem_ker.mpr (hαG t ht)
      exact RingHom.mem_ker.mp (hle ha)
    let eqv := Ideal.quotientKerAlgEquivOfSurjective hπs
    refine ⟨B', i', a', s', (Ideal.Quotient.liftₐ (RingHom.ker π) α hker).comp eqv.symm.toAlgHom,
      β', ?_⟩
    ext x
    obtain ⟨p, rfl⟩ := hπs x
    have h1 : eqv.symm (π p) = Ideal.Quotient.mk (RingHom.ker π) p := by
      rw [AlgEquiv.symm_apply_eq]
      rfl
    show β' ((Ideal.Quotient.liftₐ (RingHom.ker π) α hker) (eqv.symm (π p))) = f (π p)
    rw [h1]
    exact DFunLike.congr_fun hc p

  have hgen : ∀ i : Fin d, (0 : k) ^ e = 0 := by
    intro i
    rcases Nat.eq_zero_or_pos e with he | he
    · exfalso
      have hX1 : (MvPolynomial.X i : MvPolynomial (Fin d) k) ^ e = 1 := by rw [he, pow_zero]
      have h1 : (1 : MvPolynomial (Fin d) k) ∈ Ideal.span (Set.range fun i : Fin d =>
          (MvPolynomial.X i : MvPolynomial (Fin d) k) ^ e) := by
        rw [← hX1]
        exact Ideal.subset_span ⟨i, rfl⟩
      have h2 := Ideal.Quotient.eq_zero_iff_mem.mpr h1
      have h3 : (1 : L) = 0 := by
        rw [← map_one (algebraMap (MvPolynomial (Fin d) k ⧸ Ideal.span (Set.range fun i : Fin d =>
          (MvPolynomial.X i : MvPolynomial (Fin d) k) ^ e)) L), ← map_one (Ideal.Quotient.mk _), h2,
          map_zero]
      exact one_ne_zero h3
    · exact zero_pow he.ne'
  have hker0 : ∀ a ∈ Ideal.span (Set.range fun i : Fin d =>
      (MvPolynomial.X i : MvPolynomial (Fin d) k) ^ e),
      MvPolynomial.aeval (R := k) (fun _ : Fin d => (0 : k)) a = 0 := by
    intro a ha
    have hle : Ideal.span (Set.range fun i : Fin d =>
        (MvPolynomial.X i : MvPolynomial (Fin d) k) ^ e) ≤
        RingHom.ker (MvPolynomial.aeval (R := k) (fun _ : Fin d => (0 : k))) := by
      rw [Ideal.span_le]
      rintro _ ⟨i, rfl⟩
      simp [hgen i]
    exact RingHom.mem_ker.mp (hle ha)
  let ε := Ideal.Quotient.liftₐ _ (MvPolynomial.aeval (R := k) (fun _ : Fin d => (0 : k))) hker0
  have hε : ∀ r, r - algebraMap k _ (ε r) ∈ Ideal.span (Set.range fun i : Fin d =>
      Ideal.Quotient.mk (Ideal.span (Set.range fun i : Fin d =>
        (MvPolynomial.X i : MvPolynomial (Fin d) k) ^ e)) (MvPolynomial.X i)) := by
    intro r
    obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective r
    show Ideal.Quotient.mk _ p - algebraMap k _ (MvPolynomial.aeval (fun _ : Fin d => (0 : k)) p) ∈ _
    induction p using MvPolynomial.induction_on with
    | C a =>
      rw [MvPolynomial.aeval_C, Algebra.algebraMap_self, RingHom.id_apply]
      have : algebraMap k (MvPolynomial (Fin d) k ⧸ Ideal.span (Set.range fun i : Fin d =>
          (MvPolynomial.X i : MvPolynomial (Fin d) k) ^ e)) a =
          Ideal.Quotient.mk _ (MvPolynomial.C a) := rfl
      rw [this, sub_self]
      exact zero_mem _
    | add p q hp hq =>
      convert add_mem hp hq using 1
      simp only [map_add]
      ring
    | mul_X p i _ =>
      simp only [map_mul, MvPolynomial.aeval_X, mul_zero, map_zero, sub_zero]
      exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨i, rfl⟩)
  have hnilp : IsNilpotent (Ideal.span (Set.range fun i : Fin d =>
      Ideal.Quotient.mk (Ideal.span (Set.range fun i : Fin d =>
        (MvPolynomial.X i : MvPolynomial (Fin d) k) ^ e)) (MvPolynomial.X i))) := by
    rw [Ideal.FG.isNilpotent_iff_le_nilradical (Submodule.fg_span (Set.finite_range _))]
    rw [Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    rw [SetLike.mem_coe, mem_nilradical]
    refine ⟨e, ?_⟩
    rw [← map_pow, Ideal.Quotient.eq_zero_iff_mem]
    exact Ideal.subset_span ⟨i, rfl⟩
  obtain ⟨N, hN⟩ := hnilp
  refine key _ _ ε hε N (hN.trans Ideal.zero_eq_bot) L ?_ E f
  rw [hmax, Ideal.map_span, ← Set.range_comp]
  rfl

theorem wc_pfc_cz_pf_regular_any_order : ∀ (S : Type u) [CommRing S] [IsRegularLocalRing S], (∀ (T : Type u) [CommRing T] [IsRegularLocalRing T] (r : ℕ) (x : Fin r → IsLocalRing.maximalIdeal T), LinearIndependent (IsLocalRing.ResidueField T) (fun i => (IsLocalRing.maximalIdeal T).toCotangent (x i)) → IsRegularLocalRing (T ⧸ Ideal.span (Set.range (fun i => (x i : T)))) ∧ ringKrullDim (T ⧸ Ideal.span (Set.range (fun i => (x i : T)))) + r = ringKrullDim T) → (∀ (T : Type u) [CommRing T], IsRegularLocalRing T → IsDomain T) → ∀ (d : ℕ) (y : Fin d → S), Submodule.spanFinrank (IsLocalRing.maximalIdeal S) = d → Ideal.span (Set.range y) = IsLocalRing.maximalIdeal S → ∀ (U : Set (Fin d)) (j : Fin d), j ∉ U → ∀ s : S, y j * s ∈ Ideal.span (y '' U) → s ∈ Ideal.span (y '' U) :=
by
  intro S _ _ _HQ HD d y hd hy U j hj s hs
  classical
  set A : Finset S := (Finset.univ.filter (fun i => i ∈ U)).image y with hAdef
  set B : Finset S := (Finset.univ.filter (fun i => i ∉ U)).image y with hBdef
  have hA : (A : Set S) = y '' U := by
    rw [hAdef, Finset.coe_image, Finset.coe_filter]
    congr 1
    ext x
    simp
  have hB : (B : Set S) = y '' Uᶜ := by
    rw [hBdef, Finset.coe_image, Finset.coe_filter]
    congr 1
    ext x
    simp
  have hspan : Ideal.span ((A : Set S) ∪ (B : Set S)) = IsLocalRing.maximalIdeal S := by
    rw [hA, hB, Set.image_union_image_compl_eq_range]
    exact hy
  have hcard : A.card + B.card ≤ Submodule.spanFinrank (IsLocalRing.maximalIdeal S) := by
    have h1 : A.card + B.card ≤ (Finset.univ.filter (fun i => i ∈ U)).card +
        (Finset.univ.filter (fun i => i ∉ U)).card :=
      add_le_add Finset.card_image_le Finset.card_image_le
    rw [Finset.card_filter_add_card_filter_not, Finset.card_univ, Fintype.card_fin] at h1
    rw [hd]
    exact h1
  obtain ⟨hreg, -, hBA⟩ := wc_ogp_quotient_regular S A B hspan hcard
  have hjB : y j ∈ B := by
    rw [hBdef]
    exact Finset.mem_image_of_mem y (Finset.mem_filter.mpr ⟨Finset.mem_univ j, hj⟩)
  have hyj : y j ∉ Ideal.span (A : Set S) := hBA (y j) hjB
  haveI : IsDomain (S ⧸ Ideal.span (A : Set S)) := HD _ hreg
  rw [← hA] at hs ⊢
  have h0 : Ideal.Quotient.mk (Ideal.span (A : Set S)) (y j) *
      Ideal.Quotient.mk (Ideal.span (A : Set S)) s = 0 := by
    rw [← map_mul]
    exact Ideal.Quotient.eq_zero_iff_mem.mpr hs
  rcases mul_eq_zero.mp h0 with h | h
  · exact absurd (Ideal.Quotient.eq_zero_iff_mem.mp h) hyj
  · exact Ideal.Quotient.eq_zero_iff_mem.mp h

theorem wc_pfc_cz_pf_mixed_power_nzd : ∀ (A : Type u) [CommRing A] (d e : ℕ) (y : Fin d → A), (∀ (U : Set (Fin d)) (j : Fin d), j ∉ U → ∀ s : A, y j * s ∈ Ideal.span (y '' U) → s ∈ Ideal.span (y '' U)) → ∀ (i : Fin d) (s : A), y i * s ∈ Ideal.span ((fun j => y j ^ e) '' {j | j < i} ∪ y '' {j | i < j}) → s ∈ Ideal.span ((fun j => y j ^ e) '' {j | j < i} ∪ y '' {j | i < j}) :=
by
  intro A _ d e y hy i s hs

  have hcomb : ∀ (L : Ideal A) (u w z : A), (∀ c : A, u * c ∈ L → c ∈ L) →
      (∀ c : A, z * c ∈ Ideal.span {u} ⊔ L → c ∈ Ideal.span {u} ⊔ L) →
      (∀ c : A, z * c ∈ Ideal.span {w} ⊔ L → c ∈ Ideal.span {w} ⊔ L) →
      ∀ c : A, z * c ∈ Ideal.span {u * w} ⊔ L → c ∈ Ideal.span {u * w} ⊔ L := by
    intro L u w z h1 h2 h3 c hc
    have hle : Ideal.span {u * w} ⊔ L ≤ Ideal.span {u} ⊔ L :=
      sup_le_sup_right (Ideal.span_singleton_le_span_singleton.mpr (dvd_mul_right u w)) L
    obtain ⟨a, l, hl, hal⟩ := Ideal.mem_span_singleton_sup.mp (h2 c (hle hc))
    obtain ⟨b, l', hl', hbl⟩ := Ideal.mem_span_singleton_sup.mp hc
    have hb : z * a - b * w ∈ L := by
      apply h1
      have e1 : u * (z * a - b * w) = l' - z * l := by linear_combination z * hal - hbl
      rw [e1]
      exact sub_mem hl' (Ideal.mul_mem_left L z hl)
    have hza : z * a ∈ Ideal.span {w} ⊔ L :=
      Ideal.mem_span_singleton_sup.mpr ⟨b, z * a - b * w, hb, by ring⟩
    obtain ⟨a', l'', hl'', hal'⟩ := Ideal.mem_span_singleton_sup.mp (h3 a hza)
    exact Ideal.mem_span_singleton_sup.mpr ⟨a', u * l'' + l,
      add_mem (Ideal.mul_mem_left L u hl'') hl, by linear_combination u * hal' + hal⟩

  have hupd : ∀ (z : Fin d → A), (∀ (T : Set (Fin d)) (t : Fin d), t ∉ T → ∀ c : A,
      z t * c ∈ Ideal.span (z '' T) → c ∈ Ideal.span (z '' T)) →
      ∀ (i₀ : Fin d) (k : ℕ) (T : Set (Fin d)) (t : Fin d), t ∉ T → ∀ c : A,
      Function.update z i₀ (z i₀ ^ k) t * c ∈ Ideal.span (Function.update z i₀ (z i₀ ^ k) '' T) →
      c ∈ Ideal.span (Function.update z i₀ (z i₀ ^ k) '' T) := by
    intro z hP i₀ k T t ht
    by_cases hiT : i₀ ∈ T
    · have hti : t ≠ i₀ := fun h => ht (h ▸ hiT)
      rw [Function.update_of_ne hti]
      have hspan : ∀ v : A, Ideal.span (Function.update z i₀ v '' T) =
          Ideal.span {v} ⊔ Ideal.span (z '' (T \ {i₀})) := by
        intro v
        have himg : Function.update z i₀ v '' T = insert v (z '' (T \ {i₀})) := by
          ext w'
          simp only [Set.mem_image, Set.mem_insert_iff, Set.mem_diff, Set.mem_singleton_iff]
          constructor
          · rintro ⟨j, hj, rfl⟩
            by_cases hji : j = i₀
            · left; rw [hji, Function.update_self]
            · right; exact ⟨j, ⟨hj, hji⟩, (Function.update_of_ne hji _ _).symm⟩
          · rintro (rfl | ⟨j, ⟨hj, hji⟩, rfl⟩)
            · exact ⟨i₀, hiT, Function.update_self _ _ _⟩
            · exact ⟨j, hj, Function.update_of_ne hji _ _⟩
        rw [himg, Ideal.span_insert]
      have hold : Ideal.span (z '' T) = Ideal.span {z i₀} ⊔ Ideal.span (z '' (T \ {i₀})) := by
        have h := hspan (z i₀)
        rwa [Function.update_eq_self] at h
      have h1 : ∀ c : A, z i₀ * c ∈ Ideal.span (z '' (T \ {i₀})) →
          c ∈ Ideal.span (z '' (T \ {i₀})) :=
        hP (T \ {i₀}) i₀ (fun h => h.2 rfl)
      have h2 : ∀ c : A, z t * c ∈ Ideal.span {z i₀} ⊔ Ideal.span (z '' (T \ {i₀})) →
          c ∈ Ideal.span {z i₀} ⊔ Ideal.span (z '' (T \ {i₀})) := by
        rw [← hold]; exact hP T t ht
      have key : ∀ k : ℕ, ∀ c : A, z t * c ∈ Ideal.span {z i₀ ^ k} ⊔ Ideal.span (z '' (T \ {i₀})) →
          c ∈ Ideal.span {z i₀ ^ k} ⊔ Ideal.span (z '' (T \ {i₀})) := by
        intro k
        induction k with
        | zero =>
          intro c _
          rw [pow_zero, Ideal.span_singleton_one, top_sup_eq]
          exact Submodule.mem_top
        | succ k ih =>
          rw [pow_succ']
          exact hcomb _ (z i₀) (z i₀ ^ k) (z t) h1 h2 ih
      rw [hspan]
      exact key k
    · have himg : Function.update z i₀ (z i₀ ^ k) '' T = z '' T :=
        Set.image_congr (fun j hj => Function.update_of_ne
          (fun h : j = i₀ => hiT (by rw [← h]; exact hj)) _ _)
      rw [himg]
      by_cases hti : t = i₀
      · rw [hti, Function.update_self]
        have key : ∀ k : ℕ, ∀ c : A, z i₀ ^ k * c ∈ Ideal.span (z '' T) →
            c ∈ Ideal.span (z '' T) := by
          intro k
          induction k with
          | zero => intro c hc; simpa using hc
          | succ k ih =>
            intro c hc
            apply ih
            apply hP T i₀ hiT
            rw [← mul_assoc, ← pow_succ']
            exact hc
        exact key k
      · rw [Function.update_of_ne hti]
        exact hP T t ht

  have hfin : ∀ (S : Finset (Fin d)) (T : Set (Fin d)) (t : Fin d), t ∉ T → ∀ c : A,
      (fun j => if j ∈ S then y j ^ e else y j) t * c ∈
        Ideal.span ((fun j => if j ∈ S then y j ^ e else y j) '' T) →
      c ∈ Ideal.span ((fun j => if j ∈ S then y j ^ e else y j) '' T) := by
    intro S
    induction S using Finset.induction_on with
    | empty => simpa using hy
    | insert a S haS ih =>
      have hf : (fun j => if j ∈ insert a S then y j ^ e else y j) =
          Function.update (fun j => if j ∈ S then y j ^ e else y j) a
            ((fun j => if j ∈ S then y j ^ e else y j) a ^ e) := by
        funext j
        by_cases hja : j = a
        · subst hja; simp [haS]
        · simp [hja]
      rw [hf]
      exact hupd _ ih a e

  have hiT : i ∉ ({j | j < i} ∪ {j | i < j} : Set (Fin d)) := by
    rintro (h | h)
    · exact lt_irrefl i h
    · exact lt_irrefl i h
  have h := hfin (Finset.univ.filter (fun j => j < i)) ({j | j < i} ∪ {j | i < j}) i hiT s
  have h1 : (fun j => if j ∈ Finset.univ.filter (fun j => j < i) then y j ^ e else y j) i
      = y i := by
    simp
  have h2 : (fun j => if j ∈ Finset.univ.filter (fun j => j < i) then y j ^ e else y j) ''
      ({j | j < i} ∪ {j | i < j}) = (fun j => y j ^ e) '' {j | j < i} ∪ y '' {j | i < j} := by
    rw [Set.image_union]
    congr 1
    · exact Set.image_congr (fun j hj => by simp [show j < i from hj])
    · exact Set.image_congr (fun j hj => by simp [lt_asymm (show i < j from hj)])
  rw [h1, h2] at h
  exact h hs

theorem wc_pfc_cz_pf_localized_quotient_surj : ∀ (k : Type u) [Field k] (Λ : Type u) [CommRing Λ] (d e : ℕ) [Algebra (MvPolynomial (Fin d) k) Λ] (𝔮 : Ideal Λ) [𝔮.IsPrime], (∀ i, algebraMap (MvPolynomial (Fin d) k) Λ (MvPolynomial.X i) ^ e ∈ 𝔮) → ∀ [(Ideal.map (Ideal.Quotient.mk (Ideal.map (algebraMap (MvPolynomial (Fin d) k) Λ) (Ideal.span (Set.range fun i : Fin d => (MvPolynomial.X i : MvPolynomial (Fin d) k) ^ e)))) 𝔮).IsPrime], ∃ θ : Localization.AtPrime 𝔮 →+* Localization.AtPrime (Ideal.map (Ideal.Quotient.mk (Ideal.map (algebraMap (MvPolynomial (Fin d) k) Λ) (Ideal.span (Set.range fun i : Fin d => (MvPolynomial.X i : MvPolynomial (Fin d) k) ^ e)))) 𝔮), Function.Surjective θ ∧ (∀ i, θ (algebraMap Λ (Localization.AtPrime 𝔮) (algebraMap (MvPolynomial (Fin d) k) Λ (MvPolynomial.X i))) = algebraMap (MvPolynomial (Fin d) k ⧸ Ideal.span (Set.range fun i : Fin d => (MvPolynomial.X i : MvPolynomial (Fin d) k) ^ e)) (Localization.AtPrime (Ideal.map (Ideal.Quotient.mk (Ideal.map (algebraMap (MvPolynomial (Fin d) k) Λ) (Ideal.span (Set.range fun i : Fin d => (MvPolynomial.X i : MvPolynomial (Fin d) k) ^ e)))) 𝔮)) (Ideal.Quotient.mk _ (MvPolynomial.X i))) ∧ ∀ s, θ s = 0 → s ∈ Ideal.span (Set.range fun i => algebraMap Λ (Localization.AtPrime 𝔮) (algebraMap (MvPolynomial (Fin d) k) Λ (MvPolynomial.X i)) ^ e) :=
by
  intro k _ Λ _ d e _ 𝔮 _ hπe h𝔮'
  classical
  have hJq : Ideal.map (algebraMap (MvPolynomial (Fin d) k) Λ)
      (Ideal.span (Set.range fun i : Fin d => (MvPolynomial.X i : MvPolynomial (Fin d) k) ^ e))
      ≤ 𝔮 := by
    rw [Ideal.map_span, Ideal.span_le]
    rintro _ ⟨_, ⟨i, rfl⟩, rfl⟩
    rw [map_pow]
    exact hπe i
  set J := Ideal.map (algebraMap (MvPolynomial (Fin d) k) Λ)
    (Ideal.span (Set.range fun i : Fin d => (MvPolynomial.X i : MvPolynomial (Fin d) k) ^ e))
    with hJ
  set 𝔮' := Ideal.map (Ideal.Quotient.mk J) 𝔮 with h𝔮'def
  have h : 𝔮 = Ideal.comap (Ideal.Quotient.mk J) 𝔮' := by
    rw [h𝔮'def, Ideal.comap_map_of_surjective' _ Ideal.Quotient.mk_surjective, Ideal.mk_ker]
    exact (sup_eq_left.mpr hJq).symm
  have hnot : ∀ m : Λ, Ideal.Quotient.mk J m ∉ 𝔮' → m ∉ 𝔮 :=
    fun m hm hmq => hm (Ideal.mem_map_of_mem _ hmq)
  refine ⟨Localization.localRingHom 𝔮 𝔮' (Ideal.Quotient.mk J) h, ?_, ?_, ?_⟩
  · intro z
    obtain ⟨⟨abar, sbar⟩, rfl⟩ := IsLocalization.mk'_surjective 𝔮'.primeCompl z
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective abar
    obtain ⟨t, ht⟩ := Ideal.Quotient.mk_surjective (sbar : Λ ⧸ J)
    have htq : t ∈ 𝔮.primeCompl := hnot t (by rw [ht]; exact sbar.2)
    refine ⟨IsLocalization.mk' (Localization.AtPrime 𝔮) a ⟨t, htq⟩, ?_⟩
    rw [Localization.localRingHom_mk']
    congr 1
    exact Subtype.ext ht
  · intro i
    rw [Localization.localRingHom_to_map,
      IsScalarTower.algebraMap_apply (MvPolynomial (Fin d) k ⧸ Ideal.span (Set.range fun i : Fin d =>
        (MvPolynomial.X i : MvPolynomial (Fin d) k) ^ e)) (Λ ⧸ J) (Localization.AtPrime 𝔮'),
      Ideal.Quotient.algebraMap_quotient_map_quotient]
  · intro s hs
    obtain ⟨⟨a, t⟩, rfl⟩ := IsLocalization.mk'_surjective 𝔮.primeCompl s
    rw [Localization.localRingHom_mk', IsLocalization.mk'_eq_zero_iff] at hs
    obtain ⟨⟨mbar, hmbar⟩, hm⟩ := hs
    obtain ⟨m, rfl⟩ := Ideal.Quotient.mk_surjective mbar
    have hmq : m ∉ 𝔮 := hnot m hmbar
    have hma : m * a ∈ J := by
      rw [← Ideal.Quotient.eq_zero_iff_mem, map_mul]
      exact hm
    have hJI : Ideal.map (algebraMap Λ (Localization.AtPrime 𝔮)) J ≤
        Ideal.span (Set.range fun i => algebraMap Λ (Localization.AtPrime 𝔮)
          (algebraMap (MvPolynomial (Fin d) k) Λ (MvPolynomial.X i)) ^ e) := by
      rw [hJ, Ideal.map_map, Ideal.map_span, Ideal.span_le]
      rintro _ ⟨_, ⟨i, rfl⟩, rfl⟩
      apply Ideal.subset_span
      refine ⟨i, ?_⟩
      simp only [RingHom.comp_apply, map_pow]
    have hmem := hJI (Ideal.mem_map_of_mem (algebraMap Λ (Localization.AtPrime 𝔮)) hma)
    have hmt : m * t ∈ 𝔮.primeCompl := 𝔮.primeCompl.mul_mem hmq t.2
    have hunit : IsUnit (algebraMap Λ (Localization.AtPrime 𝔮) (m * t)) :=
      IsLocalization.map_units (Localization.AtPrime 𝔮) (⟨m * t, hmt⟩ : 𝔮.primeCompl)
    rw [← Ideal.mul_unit_mem_iff_mem _ hunit]
    have key : IsLocalization.mk' (Localization.AtPrime 𝔮) a t *
        algebraMap Λ (Localization.AtPrime 𝔮) (m * t) =
        algebraMap Λ (Localization.AtPrime 𝔮) (m * a) := by
      rw [map_mul, map_mul, mul_left_comm, IsLocalization.mk'_spec]
    rw [key]
    exact hmem

theorem wc_pfc_cz_pf_annihilator_transfer : ∀ (S L : Type u) [CommRing S] [CommRing L] (θ : S →+* L) (d e : ℕ) (y : Fin d → S) (p : Fin d → L), Function.Surjective θ → (∀ j, θ (y j) = p j) → (∀ j, p j ^ e = 0) → (∀ s, θ s = 0 → s ∈ Ideal.span (Set.range fun j => y j ^ e)) → (∀ (i : Fin d) (s : S), y i * s ∈ Ideal.span ((fun j => y j ^ e) '' {j | j < i} ∪ y '' {j | i < j}) → s ∈ Ideal.span ((fun j => y j ^ e) '' {j | j < i} ∪ y '' {j | i < j})) → ∀ (i : Fin d) (ℓ : L), p i ^ (e - 1) * ℓ ∈ Ideal.span (p '' {j | i < j}) → ℓ ∈ Ideal.span (p '' {j | i ≤ j}) :=
by
  intro S L _ _ θ d e y p hsurj hθy hpe hker hnzd i ℓ hℓ
  have hPle : Ideal.span (p '' {j | i < j}) ≤ Ideal.span (p '' {j | i ≤ j}) :=
    Ideal.span_mono (Set.image_mono (fun j (hj : i < j) => le_of_lt hj))
  rcases Nat.eq_zero_or_pos e with he | he
  · subst he
    simp only [Nat.zero_sub, pow_zero, one_mul] at hℓ
    exact hPle hℓ
  obtain ⟨n, rfl⟩ : ∃ n, e = n + 1 := ⟨e - 1, by omega⟩
  simp only [Nat.add_sub_cancel] at hℓ
  obtain ⟨s, rfl⟩ := hsurj ℓ
  have hmap : Ideal.span (p '' {j | i < j}) = Ideal.map θ (Ideal.span (y '' {j | i < j})) := by
    rw [Ideal.map_span, Set.image_image]
    congr 1
    exact Set.image_congr (fun j _ => (hθy j).symm)
  rw [hmap, Ideal.mem_map_iff_of_surjective θ hsurj] at hℓ
  obtain ⟨u, hu, hθu⟩ := hℓ
  have huK : u ∈ Ideal.span ((fun j => y j ^ (n + 1)) '' {j | j < i} ∪ y '' {j | i < j}) :=
    Ideal.span_mono Set.subset_union_right hu
  have h5 : y i ^ n * s - u ∈ Ideal.span (Set.range fun j => y j ^ (n + 1)) := by
    apply hker
    rw [map_sub, map_mul, map_pow, hθy, hθu, sub_self]
  have h6 : Ideal.span (Set.range fun j => y j ^ (n + 1)) ≤
      Ideal.span ((fun j => y j ^ (n + 1)) '' {j | j < i} ∪ y '' {j | i < j}) ⊔
        Ideal.span {y i ^ (n + 1)} := by
    rw [Ideal.span_le]
    rintro _ ⟨j, rfl⟩
    rcases lt_trichotomy j i with hj | rfl | hj
    · exact Ideal.mem_sup_left (Ideal.subset_span (Or.inl ⟨j, hj, rfl⟩))
    · exact Ideal.mem_sup_right (Ideal.mem_span_singleton_self _)
    · apply Ideal.mem_sup_left
      show y j ^ (n + 1) ∈ _
      rw [pow_succ]
      exact Ideal.mul_mem_left _ _ (Ideal.subset_span (Or.inr ⟨j, hj, rfl⟩))
  have h8 : y i ^ n * s ∈
      Ideal.span ((fun j => y j ^ (n + 1)) '' {j | j < i} ∪ y '' {j | i < j}) ⊔
        Ideal.span {y i ^ (n + 1)} := by
    have := Ideal.add_mem _ (h6 h5) (Ideal.mem_sup_left huK)
    simpa using this
  obtain ⟨κ, hκ, z, hz, hκz⟩ := Submodule.mem_sup.mp h8
  obtain ⟨w, rfl⟩ := Ideal.mem_span_singleton'.mp hz
  have h9 : ∀ (m : ℕ) (t : S), y i ^ m * t ∈
      Ideal.span ((fun j => y j ^ (n + 1)) '' {j | j < i} ∪ y '' {j | i < j}) →
      t ∈ Ideal.span ((fun j => y j ^ (n + 1)) '' {j | j < i} ∪ y '' {j | i < j}) := by
    intro m
    induction m with
    | zero => intro t ht; simpa using ht
    | succ m ih =>
      intro t ht
      apply hnzd i t
      apply ih
      rw [← mul_assoc, ← pow_succ]
      exact ht
  have hdiff : s - y i * w ∈
      Ideal.span ((fun j => y j ^ (n + 1)) '' {j | j < i} ∪ y '' {j | i < j}) := by
    apply h9 n
    have e1 : y i ^ n * (s - y i * w) = κ := by
      rw [← eq_sub_iff_add_eq] at hκz
      rw [hκz]; ring
    rw [e1]; exact hκ
  have h10 : Ideal.span ((fun j => y j ^ (n + 1)) '' {j | j < i} ∪ y '' {j | i < j}) ≤
      Ideal.comap θ (Ideal.span (p '' {j | i ≤ j})) := by
    rw [Ideal.span_le]
    rintro _ (⟨j, hj, rfl⟩ | ⟨j, hj, rfl⟩)
    · rw [SetLike.mem_coe, Ideal.mem_comap]
      show θ (y j ^ (n + 1)) ∈ _
      rw [map_pow, hθy, hpe]
      exact Ideal.zero_mem _
    · rw [SetLike.mem_coe, Ideal.mem_comap]
      rw [hθy]
      exact Ideal.subset_span (Set.mem_image_of_mem p (show i ≤ j from le_of_lt hj))
  have hpi : p i ∈ Ideal.span (p '' {j | i ≤ j}) := Ideal.subset_span ⟨i, le_refl i, rfl⟩
  have e2 : θ s = θ (s - y i * w) + p i * θ w := by
    rw [map_sub, map_mul, hθy]; ring
  rw [e2]
  exact Ideal.add_mem _ (h10 hdiff) (Ideal.mul_mem_right _ _ hpi)

theorem wc_pfc_cz_pf_layer_indep : ∀ (k : Type u) [Field k] (L : Type u) [CommRing L] [Algebra k L] (I : Ideal L) (q : L) (e : ℕ) (W : Type u) (g : W → L), (∀ (s : Finset W) (c : W → k), ∑ w ∈ s, c w • g w ∈ I ⊔ Ideal.span {q} → ∀ w ∈ s, c w = 0) → (∀ t < e, ∀ x : L, q ^ t * x ∈ I → x ∈ I ⊔ Ideal.span {q}) → ∀ (s : Finset (Fin e × W)) (c : Fin e × W → k), ∑ z ∈ s, c z • (q ^ (z.1 : ℕ) * g z.2) ∈ I → ∀ z ∈ s, c z = 0 :=
by
  intro k _ L _ _ I q e W g ha hb s c hsum
  classical
  by_contra hcon
  push_neg at hcon
  obtain ⟨z₁, hz₁s, hz₁c⟩ := hcon
  obtain ⟨s₀, hs₀⟩ : ∃ s₀ : Finset (Fin e × W), s₀ = s.filter (fun z => c z ≠ 0) := ⟨_, rfl⟩
  have hz₁ : z₁ ∈ s₀ := by rw [hs₀]; exact Finset.mem_filter.mpr ⟨hz₁s, hz₁c⟩
  obtain ⟨zs, hzs, hmin⟩ :=
    Finset.exists_min_image s₀ (fun z : Fin e × W => (z.1 : ℕ)) ⟨z₁, hz₁⟩
  have hzs' : zs ∈ s ∧ c zs ≠ 0 := by rw [hs₀] at hzs; exact Finset.mem_filter.mp hzs
  obtain ⟨t₀, ht₀⟩ : ∃ t : ℕ, t = (zs.1 : ℕ) := ⟨_, rfl⟩
  have ht₀e : t₀ < e := by rw [ht₀]; exact zs.1.isLt
  have hle : ∀ z ∈ s₀, t₀ ≤ (z.1 : ℕ) := by
    intro z hz; rw [ht₀]; exact hmin z hz

  have hsum₀ : ∑ z ∈ s₀, c z • (q ^ (z.1 : ℕ) * g z.2) ∈ I := by
    rw [hs₀, Finset.sum_filter_of_ne]
    · exact hsum
    · intro z _ h hc
      apply h
      rw [hc, zero_smul]

  obtain ⟨x, hx⟩ : ∃ x : L, x = ∑ z ∈ s₀, c z • (q ^ ((z.1 : ℕ) - t₀) * g z.2) := ⟨_, rfl⟩
  have hfac : ∑ z ∈ s₀, c z • (q ^ (z.1 : ℕ) * g z.2) = q ^ t₀ * x := by
    rw [hx, Finset.mul_sum]
    refine Finset.sum_congr rfl (fun z hz => ?_)
    rw [mul_smul_comm, ← mul_assoc, ← pow_add, Nat.add_sub_cancel' (hle z hz)]
  have hxI : x ∈ I ⊔ Ideal.span {q} := hb t₀ ht₀e x (by rw [← hfac]; exact hsum₀)

  have hsplit := Finset.sum_filter_add_sum_filter_not s₀
    (fun z : Fin e × W => (z.1 : ℕ) = t₀) (fun z => c z • (q ^ ((z.1 : ℕ) - t₀) * g z.2))
  have hAsum : ∑ z ∈ s₀.filter (fun z : Fin e × W => (z.1 : ℕ) = t₀),
      c z • (q ^ ((z.1 : ℕ) - t₀) * g z.2) =
      ∑ z ∈ s₀.filter (fun z : Fin e × W => (z.1 : ℕ) = t₀), c z • g z.2 := by
    refine Finset.sum_congr rfl (fun z hz => ?_)
    rw [(Finset.mem_filter.mp hz).2, Nat.sub_self, pow_zero, one_mul]
  have hBsum : ∑ z ∈ s₀.filter (fun z : Fin e × W => ¬ (z.1 : ℕ) = t₀),
      c z • (q ^ ((z.1 : ℕ) - t₀) * g z.2) ∈ Ideal.span {q} := by
    refine Ideal.sum_mem _ (fun z hz => ?_)
    obtain ⟨hz0, hne⟩ := Finset.mem_filter.mp hz
    have hl := hle z hz0
    have heq : (z.1 : ℕ) - t₀ = ((z.1 : ℕ) - t₀ - 1) + 1 := by omega
    rw [heq, pow_succ, Algebra.smul_def]
    have h2 : algebraMap k L (c z) * (q ^ ((z.1 : ℕ) - t₀ - 1) * q * g z.2) =
        (algebraMap k L (c z) * q ^ ((z.1 : ℕ) - t₀ - 1) * g z.2) * q := by ring
    rw [h2]
    exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self q)
  have hY : ∑ z ∈ s₀.filter (fun z : Fin e × W => (z.1 : ℕ) = t₀), c z • g z.2
      ∈ I ⊔ Ideal.span {q} := by
    have h1 : ∑ z ∈ s₀.filter (fun z : Fin e × W => (z.1 : ℕ) = t₀), c z • g z.2 =
        x - ∑ z ∈ s₀.filter (fun z : Fin e × W => ¬ (z.1 : ℕ) = t₀),
          c z • (q ^ ((z.1 : ℕ) - t₀) * g z.2) := by
      rw [eq_sub_iff_add_eq, ← hAsum, hsplit, hx]
    rw [h1]
    exact Submodule.sub_mem _ hxI (Ideal.mem_sup_right hBsum)

  have hinj : Set.InjOn Prod.snd
      ((s₀.filter (fun z : Fin e × W => (z.1 : ℕ) = t₀) : Finset (Fin e × W)) :
        Set (Fin e × W)) := by
    intro z hz z' hz' h
    have h1 := (Finset.mem_filter.mp hz).2
    have h2 := (Finset.mem_filter.mp hz').2
    exact Prod.ext (Fin.ext (h1.trans h2.symm)) h
  have heqs : ∑ z ∈ s₀.filter (fun z : Fin e × W => (z.1 : ℕ) = t₀), c (zs.1, z.2) • g z.2 =
      ∑ z ∈ s₀.filter (fun z : Fin e × W => (z.1 : ℕ) = t₀), c z • g z.2 := by
    refine Finset.sum_congr rfl (fun z hz => ?_)
    have h1 := (Finset.mem_filter.mp hz).2
    have h3 : (zs.1, z.2) = z := Prod.ext (Fin.ext (ht₀.symm.trans h1.symm)) rfl
    rw [h3]
  have hlayer : ∑ w ∈ (s₀.filter (fun z : Fin e × W => (z.1 : ℕ) = t₀)).image Prod.snd,
      c (zs.1, w) • g w ∈ I ⊔ Ideal.span {q} := by
    rw [Finset.sum_image hinj, heqs]
    exact hY
  have hzsA : zs ∈ s₀.filter (fun z : Fin e × W => (z.1 : ℕ) = t₀) :=
    Finset.mem_filter.mpr ⟨hzs, ht₀.symm⟩
  have h0 := ha _ (fun w => c (zs.1, w)) hlayer zs.2 (Finset.mem_image_of_mem _ hzsA)
  exact hzs'.2 h0

theorem wc_pfc_cz_pf_monomial_indep : (∀ (k : Type u) [Field k] (L : Type u) [CommRing L] [Algebra k L] (I : Ideal L) (q : L) (e : ℕ) (W : Type u) (g : W → L), (∀ (s : Finset W) (c : W → k), ∑ w ∈ s, c w • g w ∈ I ⊔ Ideal.span {q} → ∀ w ∈ s, c w = 0) → (∀ t < e, ∀ x : L, q ^ t * x ∈ I → x ∈ I ⊔ Ideal.span {q}) → ∀ (s : Finset (Fin e × W)) (c : Fin e × W → k), ∑ z ∈ s, c z • (q ^ (z.1 : ℕ) * g z.2) ∈ I → ∀ z ∈ s, c z = 0) → ∀ (k : Type u) [Field k] (d e : ℕ) (L : Type u) [CommRing L] [Algebra k L] (I₀ : Ideal L) (p : Fin d → L), (∀ (i : Fin d) (ℓ : L), p i ^ (e - 1) * ℓ ∈ I₀ ⊔ Ideal.span (p '' {j | i < j}) → ℓ ∈ I₀ ⊔ Ideal.span (p '' {j | i ≤ j})) → ∀ (ι : Type u) (b : ι → L), (∀ (s : Finset ι) (c : ι → k), ∑ l ∈ s, c l • b l ∈ I₀ ⊔ Ideal.span (Set.range p) → ∀ l ∈ s, c l = 0) → ∀ (s : Finset ((Fin d → Fin e) × ι)) (c : (Fin d → Fin e) × ι → k), ∑ z ∈ s, c z • ((∏ i, p i ^ (z.1 i : ℕ)) * b z.2) ∈ I₀ → ∀ z ∈ s, c z = 0 :=
by
  intro HL k _ d
  induction d with
  | zero =>
    intro e L _ _ I₀ p _ ι b hB s c hsum z hz
    classical
    have hprod : ∀ a : Fin 0 → Fin e, (∏ i, p i ^ (a i : ℕ)) = 1 := fun a => Fin.prod_univ_zero _
    have hspan : I₀ ⊔ Ideal.span (Set.range p) = I₀ := by
      rw [Set.range_eq_empty p, Ideal.span_empty, sup_bot_eq]
    have hz' : ∀ z : (Fin 0 → Fin e) × ι, z = (default, z.2) :=
      fun z => Prod.ext (Subsingleton.elim _ _) rfl
    have hinj : Set.InjOn Prod.snd (s : Set ((Fin 0 → Fin e) × ι)) := by
      intro x _ y _ h
      exact Prod.ext (Subsingleton.elim _ _) h
    have heq : ∑ x ∈ s, c (default, x.2) • b x.2
        = ∑ z ∈ s, c z • ((∏ i, p i ^ (z.1 i : ℕ)) * b z.2) := by
      apply Finset.sum_congr rfl
      intro x _
      rw [hprod x.1, one_mul, ← hz' x]
    have key := hB (s.image Prod.snd) (fun l => c (default, l)) (by
      show ∑ l ∈ s.image Prod.snd, c (default, l) • b l ∈ I₀ ⊔ Ideal.span (Set.range p)
      rw [hspan, Finset.sum_image hinj, heq]
      exact hsum) z.2 (Finset.mem_image_of_mem _ hz)
    rw [hz' z]
    exact key
  | succ d ih =>
    intro e L _ _ I₀ p hH ι b hB s c hsum
    classical

    have himg_lt : ∀ i : Fin d, p '' {j | Fin.castSucc i < j} =
        insert (p (Fin.last d)) ((fun j : Fin d => p (Fin.castSucc j)) '' {j | i < j}) := by
      intro i
      ext x
      simp only [Set.mem_image, Set.mem_setOf_eq, Set.mem_insert_iff]
      constructor
      · rintro ⟨j, hj, rfl⟩
        rcases Fin.eq_castSucc_or_eq_last j with ⟨j', rfl⟩ | rfl
        · exact Or.inr ⟨j', Fin.castSucc_lt_castSucc_iff.mp hj, rfl⟩
        · exact Or.inl rfl
      · rintro (rfl | ⟨j', hj', rfl⟩)
        · exact ⟨Fin.last d, Fin.castSucc_lt_last i, rfl⟩
        · exact ⟨Fin.castSucc j', Fin.castSucc_lt_castSucc_iff.mpr hj', rfl⟩
    have himg_le : ∀ i : Fin d, p '' {j | Fin.castSucc i ≤ j} =
        insert (p (Fin.last d)) ((fun j : Fin d => p (Fin.castSucc j)) '' {j | i ≤ j}) := by
      intro i
      ext x
      simp only [Set.mem_image, Set.mem_setOf_eq, Set.mem_insert_iff]
      constructor
      · rintro ⟨j, hj, rfl⟩
        rcases Fin.eq_castSucc_or_eq_last j with ⟨j', rfl⟩ | rfl
        · exact Or.inr ⟨j', Fin.castSucc_le_castSucc_iff.mp hj, rfl⟩
        · exact Or.inl rfl
      · rintro (rfl | ⟨j', hj', rfl⟩)
        · exact ⟨Fin.last d, le_of_lt (Fin.castSucc_lt_last i), rfl⟩
        · exact ⟨Fin.castSucc j', Fin.castSucc_le_castSucc_iff.mpr hj', rfl⟩
    have hH'' : ∀ (i : Fin d) (ℓ : L), (fun j : Fin d => p (Fin.castSucc j)) i ^ (e - 1) * ℓ ∈
        (I₀ ⊔ Ideal.span {p (Fin.last d)}) ⊔
          Ideal.span ((fun j : Fin d => p (Fin.castSucc j)) '' {j | i < j}) →
        ℓ ∈ (I₀ ⊔ Ideal.span {p (Fin.last d)}) ⊔
          Ideal.span ((fun j : Fin d => p (Fin.castSucc j)) '' {j | i ≤ j}) := by
      intro i ℓ h
      have h' := hH (Fin.castSucc i) ℓ
      rw [himg_lt i, himg_le i, Ideal.span_insert, Ideal.span_insert, ← sup_assoc,
        ← sup_assoc] at h'
      exact h' h
    have hspan : (I₀ ⊔ Ideal.span {p (Fin.last d)}) ⊔
        Ideal.span (Set.range fun j : Fin d => p (Fin.castSucc j)) =
        I₀ ⊔ Ideal.span (Set.range p) := by
      have hr : Set.range p =
          insert (p (Fin.last d)) (Set.range fun j : Fin d => p (Fin.castSucc j)) := by
        ext x
        simp only [Set.mem_range, Set.mem_insert_iff]
        constructor
        · rintro ⟨j, rfl⟩
          rcases Fin.eq_castSucc_or_eq_last j with ⟨j', rfl⟩ | rfl
          · exact Or.inr ⟨j', rfl⟩
          · exact Or.inl rfl
        · rintro (rfl | ⟨j', rfl⟩)
          · exact ⟨_, rfl⟩
          · exact ⟨_, rfl⟩
      rw [hr, Ideal.span_insert, sup_assoc]
    have hB'' : ∀ (s : Finset ι) (c : ι → k), ∑ l ∈ s, c l • b l ∈
        (I₀ ⊔ Ideal.span {p (Fin.last d)}) ⊔
          Ideal.span (Set.range fun j : Fin d => p (Fin.castSucc j)) → ∀ l ∈ s, c l = 0 := by
      intro s c h
      rw [hspan] at h
      exact hB s c h

    have hA := ih e L (I₀ ⊔ Ideal.span {p (Fin.last d)}) (fun j => p (Fin.castSucc j)) hH''
      ι b hB''

    have hLb : ∀ t < e, ∀ x : L, p (Fin.last d) ^ t * x ∈ I₀ →
        x ∈ I₀ ⊔ Ideal.span {p (Fin.last d)} := by
      intro t ht x hx
      have h1 : p (Fin.last d) ^ (e - 1) * x ∈ I₀ := by
        have hsplit : e - 1 = (e - 1 - t) + t := by omega
        rw [hsplit, pow_add, mul_assoc]
        exact Ideal.mul_mem_left _ _ hx
      have hlt : {j : Fin (d + 1) | Fin.last d < j} = ∅ := by
        ext j
        simp only [Set.mem_setOf_eq, Set.mem_empty_iff_false, iff_false, not_lt]
        exact Fin.le_last j
      have hle : {j : Fin (d + 1) | Fin.last d ≤ j} = {Fin.last d} := by
        ext j
        simp only [Set.mem_setOf_eq, Set.mem_singleton_iff]
        exact Fin.last_le_iff
      have h2 := hH (Fin.last d) x
      rw [hlt, hle, Set.image_empty, Set.image_singleton, Ideal.span_empty, sup_bot_eq] at h2
      exact h2 h1

    let φ : (Fin (d + 1) → Fin e) × ι → Fin e × ((Fin d → Fin e) × ι) :=
      fun z => (z.1 (Fin.last d), (Fin.init z.1, z.2))
    let ψ : Fin e × ((Fin d → Fin e) × ι) → (Fin (d + 1) → Fin e) × ι :=
      fun w => ((Fin.snoc (α := fun _ => Fin e) w.2.1 w.1 : Fin (d + 1) → Fin e), w.2.2)
    have hψφ : ∀ z, ψ (φ z) = z := fun z => Prod.ext (Fin.snoc_init_self z.1) rfl
    have hφinj : Set.InjOn φ (s : Set ((Fin (d + 1) → Fin e) × ι)) := by
      intro x _ y _ h
      have h2 := congrArg ψ h
      rwa [hψφ, hψφ] at h2
    have heq : ∑ z ∈ s, c (ψ (φ z)) • (p (Fin.last d) ^ ((φ z).1 : ℕ) *
        ((∏ i : Fin d, p (Fin.castSucc i) ^ ((φ z).2.1 i : ℕ)) * b (φ z).2.2)) =
        ∑ z ∈ s, c z • ((∏ i, p i ^ (z.1 i : ℕ)) * b z.2) := by
      apply Finset.sum_congr rfl
      intro z _
      rw [hψφ z]
      congr 1
      rw [Fin.prod_univ_castSucc]
      simp only [φ, Fin.init]
      ring
    have hall := HL k L I₀ (p (Fin.last d)) e ((Fin d → Fin e) × ι)
      (fun w => (∏ i : Fin d, p (Fin.castSucc i) ^ (w.1 i : ℕ)) * b w.2) hA hLb
      (s.image φ) (fun w => c (ψ w)) (by
        rw [Finset.sum_image hφinj]
        exact (congrArg (fun t => t ∈ I₀) heq).mpr hsum)
    intro z hz
    have h3 := hall (φ z) (Finset.mem_image_of_mem φ hz)
    simpa only [hψφ] using h3

theorem wc_pfc_cz_pf_quotient_monomial_span : ∀ (k : Type u) [Field k] (d e : ℕ) (f : MvPolynomial (Fin d) k ⧸ Ideal.span (Set.range fun i : Fin d => (MvPolynomial.X i : MvPolynomial (Fin d) k) ^ e)), ∃ κ : (Fin d → Fin e) → k, f = ∑ a, κ a • ∏ i, (Ideal.Quotient.mk (Ideal.span (Set.range fun i : Fin d => (MvPolynomial.X i : MvPolynomial (Fin d) k) ^ e)) (MvPolynomial.X i)) ^ (a i : ℕ) :=
by
  intro k _ d e f
  classical
  obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective f
  set I : Ideal (MvPolynomial (Fin d) k) :=
    Ideal.span (Set.range fun i : Fin d => (MvPolynomial.X i : MvPolynomial (Fin d) k) ^ e) with hI
  let v : (Fin d → Fin e) → MvPolynomial (Fin d) k ⧸ I :=
    fun a => ∏ i, (Ideal.Quotient.mk I (MvPolynomial.X i)) ^ (a i : ℕ)
  have key : ∀ G : MvPolynomial (Fin d) k,
      Ideal.Quotient.mk I G ∈ Submodule.span k (Set.range v) := by
    intro G
    induction G using MvPolynomial.induction_on' with
    | monomial u c =>
      have h1 : Ideal.Quotient.mk I (MvPolynomial.monomial u c) =
          c • ∏ i, (Ideal.Quotient.mk I (MvPolynomial.X i)) ^ (u i) := by
        rw [MvPolynomial.monomial_eq, Finsupp.prod_fintype _ _ (fun i => pow_zero _), map_mul,
          map_prod]
        simp only [map_pow]
        exact (Algebra.smul_def c _).symm
      rw [h1]
      apply Submodule.smul_mem
      by_cases h : ∀ i, u i < e
      · exact Submodule.subset_span ⟨fun i => ⟨u i, h i⟩, rfl⟩
      · push_neg at h
        obtain ⟨i₀, hi₀⟩ := h
        have hmem : (MvPolynomial.X i₀ : MvPolynomial (Fin d) k) ^ e ∈ I :=
          Ideal.subset_span ⟨i₀, rfl⟩
        have hz : (Ideal.Quotient.mk I (MvPolynomial.X i₀)) ^ (u i₀) = 0 := by
          rw [← pow_mul_pow_sub _ hi₀, ← map_pow,
            Ideal.Quotient.eq_zero_iff_mem.mpr hmem, zero_mul]
        rw [Finset.prod_eq_zero (Finset.mem_univ i₀) hz]
        exact Submodule.zero_mem _
    | add p q hp hq =>
      rw [map_add]
      exact Submodule.add_mem _ hp hq
  obtain ⟨κ, hκ⟩ := (Submodule.mem_span_range_iff_exists_fun k).mp (key F)
  exact ⟨κ, hκ.symm⟩

theorem wc_pfc_cz_pf_free_criterion : (∀ (k : Type u) [Field k] (d e : ℕ) (L : Type u) [CommRing L] [Algebra k L] (I₀ : Ideal L) (p : Fin d → L), (∀ (i : Fin d) (ℓ : L), p i ^ (e - 1) * ℓ ∈ I₀ ⊔ Ideal.span (p '' {j | i < j}) → ℓ ∈ I₀ ⊔ Ideal.span (p '' {j | i ≤ j})) → ∀ (ι : Type u) (b : ι → L), (∀ (s : Finset ι) (c : ι → k), ∑ l ∈ s, c l • b l ∈ I₀ ⊔ Ideal.span (Set.range p) → ∀ l ∈ s, c l = 0) → ∀ (s : Finset ((Fin d → Fin e) × ι)) (c : (Fin d → Fin e) × ι → k), ∑ z ∈ s, c z • ((∏ i, p i ^ (z.1 i : ℕ)) * b z.2) ∈ I₀ → ∀ z ∈ s, c z = 0) → (∀ (k : Type u) [Field k] (d e : ℕ) (f : MvPolynomial (Fin d) k ⧸ Ideal.span (Set.range fun i : Fin d => (MvPolynomial.X i : MvPolynomial (Fin d) k) ^ e)), ∃ κ : (Fin d → Fin e) → k, f = ∑ a, κ a • ∏ i, (Ideal.Quotient.mk (Ideal.span (Set.range fun i : Fin d => (MvPolynomial.X i : MvPolynomial (Fin d) k) ^ e)) (MvPolynomial.X i)) ^ (a i : ℕ)) → (∀ (R : Type u) [CommRing R] (M : Type u) [AddCommGroup M] [Module R M] (I : Ideal R) (N : Submodule R M) (n : ℕ), I ^ n = ⊥ → (⊤ : Submodule R M) ≤ N ⊔ I • (⊤ : Submodule R M) → N = ⊤) → ∀ (k : Type u) [Field k] (d e : ℕ) (L : Type u) [CommRing L] [Algebra (MvPolynomial (Fin d) k ⧸ Ideal.span (Set.range fun i : Fin d => (MvPolynomial.X i : MvPolynomial (Fin d) k) ^ e)) L], (∀ (i : Fin d) (ℓ : L), algebraMap (MvPolynomial (Fin d) k ⧸ Ideal.span (Set.range fun i : Fin d => (MvPolynomial.X i : MvPolynomial (Fin d) k) ^ e)) L (Ideal.Quotient.mk _ (MvPolynomial.X i)) ^ (e - 1) * ℓ ∈ Ideal.span ((fun j => algebraMap (MvPolynomial (Fin d) k ⧸ Ideal.span (Set.range fun i : Fin d => (MvPolynomial.X i : MvPolynomial (Fin d) k) ^ e)) L (Ideal.Quotient.mk _ (MvPolynomial.X j))) '' {j | i < j}) → ℓ ∈ Ideal.span ((fun j => algebraMap (MvPolynomial (Fin d) k ⧸ Ideal.span (Set.range fun i : Fin d => (MvPolynomial.X i : MvPolynomial (Fin d) k) ^ e)) L (Ideal.Quotient.mk _ (MvPolynomial.X j))) '' {j | i ≤ j})) → Module.Free (MvPolynomial (Fin d) k ⧸ Ideal.span (Set.range fun i : Fin d => (MvPolynomial.X i : MvPolynomial (Fin d) k) ^ e)) L :=
by
  intro hM hS hN k _ d e L _ _ hH
  classical

  have main : ∀ (R : Type u) [CommRing R] [Algebra k R] (L : Type u) [CommRing L] [Algebra R L]
      (x : Fin d → R),
      (∀ f : R, ∃ κ : (Fin d → Fin e) → k, f = ∑ a, κ a • ∏ i, x i ^ (a i : ℕ)) →
      (∃ n : ℕ, (Ideal.span (Set.range x)) ^ n = ⊥) →
      (∀ (i : Fin d) (ℓ : L), algebraMap R L (x i) ^ (e - 1) * ℓ ∈
          Ideal.span ((fun j => algebraMap R L (x j)) '' {j | i < j}) →
        ℓ ∈ Ideal.span ((fun j => algebraMap R L (x j)) '' {j | i ≤ j})) →
      Module.Free R L := by
    intro R _ _ L _ _ x hSx hnil hHx
    letI : Algebra k L := ((algebraMap R L).comp (algebraMap k R)).toAlgebra
    haveI : IsScalarTower k R L := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    let p : Fin d → L := fun j => algebraMap R L (x j)
    let P : Ideal L := Ideal.span (Set.range p)
    let Q : Submodule k L := P.restrictScalars k
    let ι : Type u := ↥(Module.Basis.ofVectorSpaceIndex k (L ⧸ Q))
    let Bv : Module.Basis ι k (L ⧸ Q) := Module.Basis.ofVectorSpace k (L ⧸ Q)
    let b : ι → L := fun l => Function.surjInv (Submodule.mkQ_surjective Q) (Bv l)
    have hb : ∀ l, Q.mkQ (b l) = Bv l := fun l =>
      Function.surjInv_eq (Submodule.mkQ_surjective Q) (Bv l)

    have hind : ∀ (s : Finset ι) (c : ι → k), ∑ l ∈ s, c l • b l ∈ P → ∀ l ∈ s, c l = 0 := by
      intro s c hsum
      have h0 : Q.mkQ (∑ l ∈ s, c l • b l) = 0 := by
        rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
        exact hsum
      rw [map_sum] at h0
      simp only [map_smul, hb] at h0
      exact linearIndependent_iff'.mp Bv.linearIndependent s c h0

    have happrox : ∀ ℓ : L, ∃ (s : Finset ι) (c : ι → k), ℓ - ∑ l ∈ s, c l • b l ∈ P := by
      intro ℓ
      refine ⟨(Bv.repr (Q.mkQ ℓ)).support, Bv.repr (Q.mkQ ℓ), ?_⟩
      have h1 : ∑ l ∈ (Bv.repr (Q.mkQ ℓ)).support, Bv.repr (Q.mkQ ℓ) l • Bv l = Q.mkQ ℓ := by
        have := Bv.linearCombination_repr (Q.mkQ ℓ)
        rw [Finsupp.linearCombination_apply, Finsupp.sum] at this
        exact this
      have h2 : Q.mkQ (ℓ - ∑ l ∈ (Bv.repr (Q.mkQ ℓ)).support, Bv.repr (Q.mkQ ℓ) l • b l) = 0 := by
        rw [map_sub, map_sum]
        simp only [map_smul, hb]
        rw [h1, sub_self]
      rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero] at h2
      exact h2

    have hMono : ∀ (s : Finset ((Fin d → Fin e) × ι)) (c : (Fin d → Fin e) × ι → k),
        ∑ z ∈ s, c z • ((∏ i, p i ^ (z.1 i : ℕ)) * b z.2) = 0 → ∀ z ∈ s, c z = 0 := by
      intro s c h
      refine hM k d e L ⊥ p ?_ ι b ?_ s c ?_
      · intro i ℓ h1
        rw [bot_sup_eq] at h1 ⊢
        exact hHx i ℓ h1
      · intro s' c' h'
        rw [bot_sup_eq] at h'
        exact hind s' c' h'
      · rw [h]; exact Submodule.zero_mem _

    have hli : LinearIndependent R b := by
      rw [linearIndependent_iff']
      intro s g hg l hl
      choose κ hκ using fun l => hSx (g l)
      have hterm : ∀ l, g l • b l = ∑ a, κ l a • ((∏ i, p i ^ (a i : ℕ)) * b l) := by
        intro l
        conv_lhs => rw [hκ l]
        rw [Finset.sum_smul]
        refine Finset.sum_congr rfl (fun a _ => ?_)
        rw [smul_assoc]
        congr 1
        rw [Algebra.smul_def, map_prod]
        simp only [map_pow]
        rfl
      have hsum0 : ∑ z ∈ (Finset.univ : Finset (Fin d → Fin e)) ×ˢ s,
          κ z.2 z.1 • ((∏ i, p i ^ (z.1 i : ℕ)) * b z.2) = 0 := by
        rw [Finset.sum_product, Finset.sum_comm]
        refine Eq.trans ?_ hg
        exact Finset.sum_congr rfl (fun l _ => (hterm l).symm)
      have hk : ∀ a, κ l a = 0 := fun a =>
        hMono _ (fun z => κ z.2 z.1) hsum0 (a, l)
          (Finset.mem_product.mpr ⟨Finset.mem_univ _, hl⟩)
      rw [hκ l]
      simp [hk]

    obtain ⟨n, hn⟩ := hnil
    have hPmap : P = Ideal.map (algebraMap R L) (Ideal.span (Set.range x)) := by
      rw [Ideal.map_span, ← Set.range_comp]
      rfl
    have hsp : (⊤ : Submodule R L) ≤ Submodule.span R (Set.range b) := by
      apply le_of_eq
      symm
      apply hN R L (Ideal.span (Set.range x)) _ n hn
      intro ℓ _
      obtain ⟨s, c, hsc⟩ := happrox ℓ
      have hx : ∑ l ∈ s, c l • b l ∈ Submodule.span R (Set.range b) := by
        refine Submodule.sum_mem _ (fun l _ => ?_)
        rw [← algebraMap_smul R (c l) (b l)]
        exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨l, rfl⟩)
      have hy : ℓ - ∑ l ∈ s, c l • b l ∈ (Ideal.span (Set.range x)) • (⊤ : Submodule R L) := by
        rw [Ideal.smul_top_eq_map, ← hPmap]
        exact hsc
      have := Submodule.add_mem_sup hx hy
      rwa [add_sub_cancel] at this
    exact Module.Free.of_basis (Module.Basis.mk hli hsp)

  have hnil : ∃ n : ℕ, (Ideal.span (Set.range fun i : Fin d => Ideal.Quotient.mk
      (Ideal.span (Set.range fun i : Fin d => (MvPolynomial.X i : MvPolynomial (Fin d) k) ^ e))
      (MvPolynomial.X i))) ^ n = ⊥ := by
    have hfg := Submodule.fg_span (R := MvPolynomial (Fin d) k ⧸ Ideal.span (Set.range fun i : Fin d => (MvPolynomial.X i : MvPolynomial (Fin d) k) ^ e))
      (Set.finite_range fun i : Fin d => Ideal.Quotient.mk
        (Ideal.span (Set.range fun i : Fin d => (MvPolynomial.X i : MvPolynomial (Fin d) k) ^ e))
        (MvPolynomial.X i))
    have hle : Ideal.span (Set.range fun i : Fin d => Ideal.Quotient.mk
        (Ideal.span (Set.range fun i : Fin d => (MvPolynomial.X i : MvPolynomial (Fin d) k) ^ e))
        (MvPolynomial.X i)) ≤ nilradical _ := by
      rw [Ideal.span_le, Set.range_subset_iff]
      intro i
      refine mem_nilradical.mpr ⟨e, ?_⟩
      rw [← map_pow]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨i, rfl⟩)
    obtain ⟨n, hn⟩ := (Ideal.FG.isNilpotent_iff_le_nilradical hfg).mpr hle
    exact ⟨n, hn.trans Ideal.zero_eq_bot⟩
  exact main _ L (fun i => Ideal.Quotient.mk _ (MvPolynomial.X i)) (hS k d e) hnil hH

theorem wc_pfc_cz_parameter_flat : ∀ (k : Type u) [Field k] (Λ : Type u) [CommRing Λ] [IsNoetherianRing Λ] (d e : ℕ) [Algebra (MvPolynomial (Fin d) k) Λ] (𝔮 : Ideal Λ) [𝔮.IsPrime] [IsRegularLocalRing (Localization.AtPrime 𝔮)], Submodule.spanFinrank (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮)) = d → Ideal.map (algebraMap Λ (Localization.AtPrime 𝔮)) (Ideal.span (Set.range fun i => algebraMap (MvPolynomial (Fin d) k) Λ (MvPolynomial.X i))) = IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) → ∀ [(Ideal.map (Ideal.Quotient.mk (Ideal.map (algebraMap (MvPolynomial (Fin d) k) Λ) (Ideal.span (Set.range fun i : Fin d => (MvPolynomial.X i : MvPolynomial (Fin d) k) ^ e)))) 𝔮).IsPrime], Module.Flat (MvPolynomial (Fin d) k ⧸ Ideal.span (Set.range fun i : Fin d => (MvPolynomial.X i : MvPolynomial (Fin d) k) ^ e)) (Localization.AtPrime (Ideal.map (Ideal.Quotient.mk (Ideal.map (algebraMap (MvPolynomial (Fin d) k) Λ) (Ideal.span (Set.range fun i : Fin d => (MvPolynomial.X i : MvPolynomial (Fin d) k) ^ e)))) 𝔮)) :=
by
  intro k _ Λ _ _ d e _ 𝔮 _ _ hd hgen h𝔮'
  classical

  have hπ : ∀ i, algebraMap (MvPolynomial (Fin d) k) Λ (MvPolynomial.X i) ∈ 𝔮 := by
    intro i
    have h1 : algebraMap Λ (Localization.AtPrime 𝔮)
        (algebraMap (MvPolynomial (Fin d) k) Λ (MvPolynomial.X i)) ∈
        IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) := by
      rw [← hgen]
      exact Ideal.mem_map_of_mem _ (Ideal.subset_span ⟨i, rfl⟩)
    exact (IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime 𝔮) 𝔮 _).mp h1
  have hπe : ∀ i, algebraMap (MvPolynomial (Fin d) k) Λ (MvPolynomial.X i) ^ e ∈ 𝔮 := by
    intro i
    rcases Nat.eq_zero_or_pos e with he | he
    · exfalso
      apply h𝔮'.ne_top
      rw [Ideal.eq_top_iff_one]
      have h1J : (1 : Λ) ∈ Ideal.map (algebraMap (MvPolynomial (Fin d) k) Λ)
          (Ideal.span (Set.range fun i : Fin d => (MvPolynomial.X i : MvPolynomial (Fin d) k) ^ e)) := by
        rw [← map_one (algebraMap (MvPolynomial (Fin d) k) Λ)]
        apply Ideal.mem_map_of_mem
        apply Ideal.subset_span
        exact ⟨i, by simp only [he, pow_zero]⟩
      have h0 : (Ideal.Quotient.mk (Ideal.map (algebraMap (MvPolynomial (Fin d) k) Λ)
          (Ideal.span (Set.range fun i : Fin d => (MvPolynomial.X i : MvPolynomial (Fin d) k) ^ e))))
          1 = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr h1J
      rw [← map_one (Ideal.Quotient.mk (Ideal.map (algebraMap (MvPolynomial (Fin d) k) Λ)
          (Ideal.span (Set.range fun i : Fin d => (MvPolynomial.X i : MvPolynomial (Fin d) k) ^ e)))),
        h0]
      exact zero_mem _
    · exact Ideal.pow_mem_of_mem 𝔮 (hπ i) e he

  obtain ⟨θ, hθs, hθX, hθker⟩ := wc_pfc_cz_pf_localized_quotient_surj k Λ d e 𝔮 hπe

  have hy : Ideal.span (Set.range fun i => algebraMap Λ (Localization.AtPrime 𝔮)
      (algebraMap (MvPolynomial (Fin d) k) Λ (MvPolynomial.X i))) =
      IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) := by
    rw [← hgen, Ideal.map_span, ← Set.range_comp]
    rfl

  have hreg := wc_pfc_cz_pf_regular_any_order (Localization.AtPrime 𝔮) wcpa_rs_quotient_regular
    (fun T _ h => wcpa_regular_isDomain T wcpa_rs_quotient_regular h) d _ hd hy

  have hnzd := wc_pfc_cz_pf_mixed_power_nzd (Localization.AtPrime 𝔮) d e _ hreg

  have hpe : ∀ j, (algebraMap (MvPolynomial (Fin d) k ⧸ Ideal.span (Set.range fun i : Fin d =>
      (MvPolynomial.X i : MvPolynomial (Fin d) k) ^ e))
      (Localization.AtPrime (Ideal.map (Ideal.Quotient.mk (Ideal.map
        (algebraMap (MvPolynomial (Fin d) k) Λ) (Ideal.span (Set.range fun i : Fin d =>
          (MvPolynomial.X i : MvPolynomial (Fin d) k) ^ e)))) 𝔮))
      (Ideal.Quotient.mk _ (MvPolynomial.X j))) ^ e = 0 := by
    intro j
    have hmem : (MvPolynomial.X j : MvPolynomial (Fin d) k) ^ e ∈
        Ideal.span (Set.range fun i : Fin d => (MvPolynomial.X i : MvPolynomial (Fin d) k) ^ e) :=
      Ideal.subset_span ⟨j, rfl⟩
    rw [← map_pow, ← map_pow, Ideal.Quotient.eq_zero_iff_mem.mpr hmem, map_zero]

  have hH := wc_pfc_cz_pf_annihilator_transfer (Localization.AtPrime 𝔮) _ θ d e _ _ hθs hθX hpe
    hθker hnzd

  have hnak : ∀ (R : Type u) [CommRing R] (M : Type u) [AddCommGroup M] [Module R M] (I : Ideal R)
      (N : Submodule R M) (n : ℕ), I ^ n = ⊥ → (⊤ : Submodule R M) ≤ N ⊔ I • (⊤ : Submodule R M) →
      N = ⊤ := by
    intro R _ M _ _ I N n hn htop
    have key : ∀ m : ℕ, (⊤ : Submodule R M) ≤ N ⊔ (I ^ m) • (⊤ : Submodule R M) := by
      intro m
      induction m with
      | zero =>
        rw [pow_zero, Ideal.one_eq_top, Submodule.top_smul]
        exact le_sup_right
      | succ m ih =>
        calc (⊤ : Submodule R M) ≤ N ⊔ (I ^ m) • (⊤ : Submodule R M) := ih
          _ ≤ N ⊔ (I ^ m) • (N ⊔ I • (⊤ : Submodule R M)) :=
            sup_le_sup_left (Submodule.smul_mono le_rfl htop) _
          _ = N ⊔ ((I ^ m) • N ⊔ (I ^ m) • I • (⊤ : Submodule R M)) := by
            rw [Submodule.smul_sup]
          _ ≤ N ⊔ (I ^ (m + 1)) • (⊤ : Submodule R M) := by
            rw [pow_succ, Submodule.mul_smul]
            exact sup_le le_sup_left
              (sup_le (le_trans Submodule.smul_le_right le_sup_left) le_sup_right)
    have h := key n
    rw [hn, Submodule.bot_smul, sup_bot_eq] at h
    exact eq_top_iff.mpr h

  haveI : Module.Free (MvPolynomial (Fin d) k ⧸ Ideal.span (Set.range fun i : Fin d =>
      (MvPolynomial.X i : MvPolynomial (Fin d) k) ^ e))
      (Localization.AtPrime (Ideal.map (Ideal.Quotient.mk (Ideal.map
        (algebraMap (MvPolynomial (Fin d) k) Λ) (Ideal.span (Set.range fun i : Fin d =>
          (MvPolynomial.X i : MvPolynomial (Fin d) k) ^ e)))) 𝔮)) :=
    wc_pfc_cz_pf_free_criterion (wc_pfc_cz_pf_monomial_indep wc_pfc_cz_pf_layer_indep)
      wc_pfc_cz_pf_quotient_monomial_span hnak k d e _ hH
  exact Module.Flat.of_free

theorem wc_pfc_cz_quotient_local_structure : ∀ (k : Type u) [Field k] (Λ : Type u) [CommRing Λ] (d e : ℕ) [Algebra (MvPolynomial (Fin d) k) Λ] (𝔮 : Ideal Λ) [𝔮.IsPrime], Ideal.map (algebraMap Λ (Localization.AtPrime 𝔮)) (Ideal.span (Set.range fun i => algebraMap (MvPolynomial (Fin d) k) Λ (MvPolynomial.X i))) = IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) → 0 < e → ∀ [(Ideal.map (Ideal.Quotient.mk (Ideal.map (algebraMap (MvPolynomial (Fin d) k) Λ) (Ideal.span (Set.range fun i : Fin d => (MvPolynomial.X i : MvPolynomial (Fin d) k) ^ e)))) 𝔮).IsPrime], Ideal.map (Ideal.Quotient.mk (Ideal.map (algebraMap (MvPolynomial (Fin d) k) Λ) (Ideal.span (Set.range fun i : Fin d => (MvPolynomial.X i : MvPolynomial (Fin d) k) ^ e)))) 𝔮 ∈ minimalPrimes (Λ ⧸ Ideal.map (algebraMap (MvPolynomial (Fin d) k) Λ) (Ideal.span (Set.range fun i : Fin d => (MvPolynomial.X i : MvPolynomial (Fin d) k) ^ e))) ∧ IsLocalRing.maximalIdeal (Localization.AtPrime (Ideal.map (Ideal.Quotient.mk (Ideal.map (algebraMap (MvPolynomial (Fin d) k) Λ) (Ideal.span (Set.range fun i : Fin d => (MvPolynomial.X i : MvPolynomial (Fin d) k) ^ e)))) 𝔮)) = Ideal.span (Set.range fun i : Fin d => algebraMap (MvPolynomial (Fin d) k ⧸ Ideal.span (Set.range fun i : Fin d => (MvPolynomial.X i : MvPolynomial (Fin d) k) ^ e)) (Localization.AtPrime (Ideal.map (Ideal.Quotient.mk (Ideal.map (algebraMap (MvPolynomial (Fin d) k) Λ) (Ideal.span (Set.range fun i : Fin d => (MvPolynomial.X i : MvPolynomial (Fin d) k) ^ e)))) 𝔮)) (Ideal.Quotient.mk _ (MvPolynomial.X i))) :=
by

  have s1 : ∀ (Λ : Type u) [CommRing Λ] (𝔮 : Ideal Λ) [𝔮.IsPrime] (d : ℕ) (π : Fin d → Λ),
      Ideal.map (algebraMap Λ (Localization.AtPrime 𝔮)) (Ideal.span (Set.range π)) =
        IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) →
      (∀ i, π i ∈ 𝔮) ∧ ∀ q ∈ 𝔮, ∃ s, s ∉ 𝔮 ∧ s * q ∈ Ideal.span (Set.range π) := by
    intro Λ _ 𝔮 _ d π h
    constructor
    · intro i
      have h1 : algebraMap Λ (Localization.AtPrime 𝔮) (π i) ∈
          IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) := by
        rw [← h]; exact Ideal.mem_map_of_mem _ (Ideal.subset_span ⟨i, rfl⟩)
      exact (IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime 𝔮) 𝔮 _).mp h1
    · intro q hq
      have h1 : algebraMap Λ (Localization.AtPrime 𝔮) q ∈
          Ideal.map (algebraMap Λ (Localization.AtPrime 𝔮)) (Ideal.span (Set.range π)) := by
        rw [h]
        exact (IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime 𝔮) 𝔮 _).mpr hq
      obtain ⟨⟨a, t⟩, hat⟩ :=
        (IsLocalization.mem_map_algebraMap_iff 𝔮.primeCompl (Localization.AtPrime 𝔮)).mp h1
      simp only at hat
      rw [← map_mul] at hat
      obtain ⟨c, hc⟩ := (IsLocalization.eq_iff_exists 𝔮.primeCompl (Localization.AtPrime 𝔮)).mp hat
      refine ⟨(c : Λ) * t, fun hct => ?_, ?_⟩
      · rcases Ideal.IsPrime.mem_or_mem inferInstance hct with h2 | h2
        · exact c.2 h2
        · exact t.2 h2
      · have e1 : (c : Λ) * t * q = c * a := by rw [← hc]; ring
        rw [e1]
        exact Ideal.mul_mem_left _ _ a.2

  have s2 : ∀ (Λ : Type u) [CommRing Λ] (𝔮 J : Ideal Λ) [𝔮.IsPrime] (d e : ℕ) (π : Fin d → Λ),
      J ≤ 𝔮 → (∀ i, π i ^ e ∈ J) →
      (∀ q ∈ 𝔮, ∃ s, s ∉ 𝔮 ∧ s * q ∈ Ideal.span (Set.range π)) →
      Ideal.map (Ideal.Quotient.mk J) 𝔮 ∈ minimalPrimes (Λ ⧸ J) := by
    intro Λ _ 𝔮 J _ d e π hJ hpow hmul
    have hprime : (Ideal.map (Ideal.Quotient.mk J) 𝔮).IsPrime :=
      Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective (by rw [Ideal.mk_ker]; exact hJ)
    have hmem : ∀ x, Ideal.Quotient.mk J x ∈ Ideal.map (Ideal.Quotient.mk J) 𝔮 ↔ x ∈ 𝔮 :=
      fun x => Ideal.mem_quotient_iff_mem hJ
    refine ⟨⟨hprime, bot_le⟩, fun P hP hle => ?_⟩
    obtain ⟨hPp, -⟩ := hP
    have hcp : (P.comap (Ideal.Quotient.mk J)).IsPrime := Ideal.IsPrime.comap _
    have hπP : ∀ i, π i ∈ P.comap (Ideal.Quotient.mk J) := by
      intro i
      apply hcp.mem_of_pow_mem e
      rw [Ideal.mem_comap, Ideal.Quotient.eq_zero_iff_mem.mpr (hpow i)]
      exact P.zero_mem
    have hspan : Ideal.span (Set.range π) ≤ P.comap (Ideal.Quotient.mk J) :=
      Ideal.span_le.mpr (Set.range_subset_iff.mpr hπP)
    have hq : 𝔮 ≤ P.comap (Ideal.Quotient.mk J) := by
      intro q hq
      obtain ⟨s, hs, hsq⟩ := hmul q hq
      rcases hcp.mem_or_mem (hspan hsq) with h | h
      · exact absurd ((hmem s).mp (hle h)) hs
      · exact h
    rw [Ideal.map_le_iff_le_comap]
    exact hq

  have s3 : ∀ (Λ : Type u) [CommRing Λ] (𝔮 J : Ideal Λ) [𝔮.IsPrime] (d : ℕ) (π : Fin d → Λ),
      J ≤ 𝔮 → (∀ i, π i ∈ 𝔮) →
      (∀ q ∈ 𝔮, ∃ s, s ∉ 𝔮 ∧ s * q ∈ Ideal.span (Set.range π)) →
      ∀ [(Ideal.map (Ideal.Quotient.mk J) 𝔮).IsPrime],
      IsLocalRing.maximalIdeal (Localization.AtPrime (Ideal.map (Ideal.Quotient.mk J) 𝔮)) =
        Ideal.span (Set.range fun i => algebraMap (Λ ⧸ J)
          (Localization.AtPrime (Ideal.map (Ideal.Quotient.mk J) 𝔮)) (Ideal.Quotient.mk J (π i))) := by
    intro Λ _ 𝔮 J _ d π hJ hπ hmul _
    have hmem : ∀ x, Ideal.Quotient.mk J x ∈ Ideal.map (Ideal.Quotient.mk J) 𝔮 ↔ x ∈ 𝔮 :=
      fun x => Ideal.mem_quotient_iff_mem hJ
    apply le_antisymm
    · rw [← Localization.AtPrime.map_eq_maximalIdeal, Ideal.map_le_iff_le_comap]
      intro y hy
      obtain ⟨q, hq, rfl⟩ := (Ideal.mem_map_iff_of_surjective _ Ideal.Quotient.mk_surjective).mp hy
      obtain ⟨s, hs, hsq⟩ := hmul q hq
      rw [Ideal.mem_comap]
      have hK : Ideal.map ((algebraMap (Λ ⧸ J)
          (Localization.AtPrime (Ideal.map (Ideal.Quotient.mk J) 𝔮))).comp (Ideal.Quotient.mk J))
          (Ideal.span (Set.range π)) ≤ Ideal.span (Set.range fun i => algebraMap (Λ ⧸ J)
          (Localization.AtPrime (Ideal.map (Ideal.Quotient.mk J) 𝔮)) (Ideal.Quotient.mk J (π i))) := by
        rw [Ideal.map_span, Ideal.span_le]
        rintro _ ⟨_, ⟨i, rfl⟩, rfl⟩
        exact Ideal.subset_span ⟨i, rfl⟩
      have h1 := hK (Ideal.mem_map_of_mem _ hsq)
      rw [RingHom.comp_apply, map_mul, map_mul] at h1
      have hunit : IsUnit (algebraMap (Λ ⧸ J)
          (Localization.AtPrime (Ideal.map (Ideal.Quotient.mk J) 𝔮)) (Ideal.Quotient.mk J s)) :=
        IsLocalization.map_units (Localization.AtPrime (Ideal.map (Ideal.Quotient.mk J) 𝔮))
          (⟨Ideal.Quotient.mk J s, fun h => hs ((hmem s).mp h)⟩ :
            (Ideal.map (Ideal.Quotient.mk J) 𝔮).primeCompl)
      exact (Ideal.unit_mul_mem_iff_mem _ hunit).mp h1
    · rw [Ideal.span_le]
      rintro _ ⟨i, rfl⟩
      exact (IsLocalization.AtPrime.to_map_mem_maximal_iff
        (Localization.AtPrime (Ideal.map (Ideal.Quotient.mk J) 𝔮))
        (Ideal.map (Ideal.Quotient.mk J) 𝔮) _).mpr ((hmem _).mpr (hπ i))

  intro k _ Λ _ d e _ 𝔮 _ hgen he _
  obtain ⟨hπ, hmul⟩ := s1 Λ 𝔮 d _ hgen
  have hJ : Ideal.map (algebraMap (MvPolynomial (Fin d) k) Λ)
      (Ideal.span (Set.range fun i : Fin d => (MvPolynomial.X i : MvPolynomial (Fin d) k) ^ e))
      ≤ 𝔮 := by
    rw [Ideal.map_le_iff_le_comap, Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    rw [SetLike.mem_coe, Ideal.mem_comap, map_pow]
    exact Ideal.pow_mem_of_mem 𝔮 (hπ i) e he
  have hpow : ∀ i, (fun i => algebraMap (MvPolynomial (Fin d) k) Λ (MvPolynomial.X i)) i ^ e ∈
      Ideal.map (algebraMap (MvPolynomial (Fin d) k) Λ)
      (Ideal.span (Set.range fun i : Fin d => (MvPolynomial.X i : MvPolynomial (Fin d) k) ^ e)) := by
    intro i
    simp only
    rw [← map_pow]
    exact Ideal.mem_map_of_mem _ (Ideal.subset_span ⟨i, rfl⟩)
  refine ⟨s2 Λ 𝔮 _ d e _ hJ hpow hmul, ?_⟩
  rw [s3 Λ 𝔮 _ d _ hJ hπ hmul]
  congr 1

theorem wc_pfc_resolve_char_zero : ∀ (k : Type u) [Field k] [CharZero k] (Λ : Type u) [CommRing Λ] [IsNoetherianRing Λ] [Algebra k Λ], (∀ (L : Type u) [Field L] [Algebra k L] [FiniteDimensional k L] (𝔔 : Ideal (TensorProduct k L Λ)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) → ∀ (A : Type u) [CommRing A] [Algebra k A] [Algebra.FinitePresentation k A] (φ : A →ₐ[k] Λ) (𝔮 : Ideal Λ), 𝔮 ∈ (Ideal.span (φ '' {a : A | Algebra.Smooth k (Localization.Away a)})).minimalPrimes → ∃ (B : Type u) (_ : CommRing B) (_ : Algebra k B) (_ : Algebra.FinitePresentation k B) (ψ : A →ₐ[k] B) (χ : B →ₐ[k] Λ), χ.comp ψ = φ ∧ (Ideal.span (φ '' {a : A | Algebra.Smooth k (Localization.Away a)})).radical ≤ (Ideal.span (χ '' {b : B | Algebra.Smooth k (Localization.Away b)})).radical ∧ ¬ (Ideal.span (χ '' {b : B | Algebra.Smooth k (Localization.Away b)})).radical ≤ 𝔮 :=
by
  intro k _ _ Λ _ _ _ hreg A _ _ _ φ 𝔮 h𝔮
  classical
  haveI h𝔮p : 𝔮.IsPrime := h𝔮.1.1
  have h𝔥q : Ideal.span (φ '' {a : A | Algebra.Smooth k (Localization.Away a)}) ≤ 𝔮 := h𝔮.1.2

  haveI hRL : IsRegularLocalRing (Localization.AtPrime 𝔮) :=
    wc_pfc_cz_localization_regular k Λ hreg 𝔮
  obtain ⟨d, hd⟩ : ∃ d, Submodule.spanFinrank
      (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮)) = d := ⟨_, rfl⟩

  obtain ⟨r, a, ha, h𝔥⟩ := wc_pfc_cz_smooth_locus_fg k A Λ φ

  obtain ⟨n, hn⟩ := wc_pfc_cz_minimal_prime_power Λ _ 𝔮 h𝔮

  obtain ⟨B, _, _, _, _, _, ι, hsmA, hsmX, huniv⟩ :=
    wc_pfc_cz_parameter_algebra k A r d n a ha

  obtain ⟨e, he, hlift⟩ :=
    wc_pfc_lifting_mod_powers (MvPolynomial (Fin d) k) B d MvPolynomial.X hsmX

  obtain ⟨π, hπgen, hπn, hπann⟩ := wc_pfc_cz_ogoma_parameters Λ _ 𝔮 d n e hd h𝔥q hn
  have hπq : ∀ i, π i ∈ 𝔮 := fun i => h𝔮p.mem_of_pow_mem n (h𝔥q (hπn i))

  letI iRΛ : Algebra (MvPolynomial (Fin d) k) Λ := (MvPolynomial.aeval π).toRingHom.toAlgebra
  haveI : IsScalarTower k (MvPolynomial (Fin d) k) Λ :=
    IsScalarTower.of_algebraMap_eq (fun x => ((MvPolynomial.aeval π).commutes x).symm)
  have hX : ∀ i, algebraMap (MvPolynomial (Fin d) k) Λ (MvPolynomial.X i) = π i :=
    fun i => MvPolynomial.aeval_X π i

  have hμ : ∀ i, ∃ c : Fin r → Λ, ∑ j, c j * φ (a j) = π i ^ n := fun i => by
    have h := hπn i
    rw [h𝔥] at h
    exact (Ideal.mem_span_range_iff_exists_fun).mp h
  choose μ hμ using hμ
  obtain ⟨χB, hχB⟩ := huniv Λ φ μ (fun i => by rw [hX, hμ i])

  have hJq : Ideal.map (algebraMap (MvPolynomial (Fin d) k) Λ)
      (Ideal.span (Set.range fun i : Fin d => (MvPolynomial.X i : MvPolynomial (Fin d) k) ^ e))
      ≤ 𝔮 := by
    rw [Ideal.map_span, Ideal.span_le]
    rintro _ ⟨_, ⟨i, rfl⟩, rfl⟩
    rw [map_pow, hX]
    exact Ideal.pow_mem_of_mem 𝔮 (hπq i) e he
  haveI h𝔮' : (Ideal.map (Ideal.Quotient.mk (Ideal.map (algebraMap (MvPolynomial (Fin d) k) Λ)
      (Ideal.span (Set.range fun i : Fin d => (MvPolynomial.X i : MvPolynomial (Fin d) k) ^ e))))
      𝔮).IsPrime :=
    Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective (by rw [Ideal.mk_ker]; exact hJq)
  have hgen : Ideal.map (algebraMap Λ (Localization.AtPrime 𝔮)) (Ideal.span (Set.range fun i =>
      algebraMap (MvPolynomial (Fin d) k) Λ (MvPolynomial.X i))) =
      IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) := by
    have : (fun i => algebraMap (MvPolynomial (Fin d) k) Λ (MvPolynomial.X i)) = π := funext hX
    rw [this]
    exact hπgen
  obtain ⟨hmin, hmax⟩ := wc_pfc_cz_quotient_local_structure k Λ d e 𝔮 hgen he
  haveI hflat := wc_pfc_cz_parameter_flat k Λ d e 𝔮 hd hgen
  have hannΛ : ∀ (i : Fin d) (y : Λ),
      algebraMap (MvPolynomial (Fin d) k) Λ (MvPolynomial.X i) ^ 2 * y ∈ Ideal.span
        ((fun j => algebraMap (MvPolynomial (Fin d) k) Λ (MvPolynomial.X j) ^ e) '' {j | j < i}) →
      algebraMap (MvPolynomial (Fin d) k) Λ (MvPolynomial.X i) * y ∈ Ideal.span
        ((fun j => algebraMap (MvPolynomial (Fin d) k) Λ (MvPolynomial.X j) ^ e) '' {j | j < i}) := by
    intro i y
    simp only [hX]
    exact hπann i y

  obtain ⟨B', _, _, _, ψ', χ', hcomp', hrad1, hnot⟩ := hlift Λ χB 𝔮
    (fun i => by rw [hX]; exact hπq i)
    (fun i y => wc_pfc_cz_monomial_annihilator k d e i y) hannΛ (by
      intro A' _ _ _ φ' φb hφb
      haveI := wc_pfc_cz_fp_quotient_base_change (MvPolynomial (Fin d) k) A'
        (Ideal.span (Set.range fun i : Fin d => (MvPolynomial.X i : MvPolynomial (Fin d) k) ^ e))
      obtain ⟨C, _, _, _, g, h, hgh⟩ := wc_pfc_cz_artinian_ind_smooth k d e
        (Localization.AtPrime (Ideal.map (Ideal.Quotient.mk (Ideal.map
          (algebraMap (MvPolynomial (Fin d) k) Λ) (Ideal.span (Set.range fun i : Fin d =>
            (MvPolynomial.X i : MvPolynomial (Fin d) k) ^ e)))) 𝔮)) hmax
        (A' ⧸ Ideal.map (algebraMap (MvPolynomial (Fin d) k) A') (Ideal.span (Set.range
          fun i : Fin d => (MvPolynomial.X i : MvPolynomial (Fin d) k) ^ e)))
        ((IsScalarTower.toAlgHom (MvPolynomial (Fin d) k ⧸ Ideal.span (Set.range
            fun i : Fin d => (MvPolynomial.X i : MvPolynomial (Fin d) k) ^ e))
          (Λ ⧸ Ideal.map (algebraMap (MvPolynomial (Fin d) k) Λ) (Ideal.span (Set.range
            fun i : Fin d => (MvPolynomial.X i : MvPolynomial (Fin d) k) ^ e)))
          (Localization.AtPrime (Ideal.map (Ideal.Quotient.mk (Ideal.map
            (algebraMap (MvPolynomial (Fin d) k) Λ) (Ideal.span (Set.range fun i : Fin d =>
              (MvPolynomial.X i : MvPolynomial (Fin d) k) ^ e)))) 𝔮))).comp φb)
      exact wc_pfc_artinian_localization _ _ _ φb _ hmin
        ⟨C, inferInstance, inferInstance, inferInstance, g, h, hgh⟩)

  letI iKB' : Algebra k B' := ((algebraMap (MvPolynomial (Fin d) k) B').comp
    (algebraMap k (MvPolynomial (Fin d) k))).toAlgebra
  haveI : IsScalarTower k (MvPolynomial (Fin d) k) B' := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  haveI : Algebra.FinitePresentation k B' := Algebra.FinitePresentation.trans k (MvPolynomial (Fin d) k) B'
  have hcomp : (χ'.restrictScalars k).comp ((ψ'.restrictScalars k).comp ι) = φ := by
    ext x
    show χ' (ψ' (ι x)) = φ x
    rw [← AlgHom.comp_apply, hcomp', hχB]

  have hS : χ' '' {b : B' | Algebra.Smooth (MvPolynomial (Fin d) k) (Localization.Away b)} ⊆
      (χ'.restrictScalars k) '' {b : B' | Algebra.Smooth k (Localization.Away b)} := by
    rintro _ ⟨b, hb, rfl⟩
    haveI : Algebra.Smooth (MvPolynomial (Fin d) k) (Localization.Away b) := hb
    exact ⟨b, Algebra.Smooth.comp k (MvPolynomial (Fin d) k) (Localization.Away b), rfl⟩
  have hle1 := Ideal.radical_mono (Ideal.span_mono hS)

  have hle0 : Ideal.span (φ '' {a : A | Algebra.Smooth k (Localization.Away a)}) ≤
      Ideal.span (χB '' {b : B | Algebra.Smooth (MvPolynomial (Fin d) k) (Localization.Away b)}) := by
    rw [h𝔥, Ideal.span_le]
    rintro _ ⟨j, rfl⟩
    exact Ideal.subset_span ⟨ι (a j), hsmA j, hχB (a j)⟩
  refine ⟨B', inferInstance, iKB', inferInstance, (ψ'.restrictScalars k).comp ι,
    χ'.restrictScalars k, hcomp, ?_, ?_⟩
  · exact ((Ideal.radical_mono hle0).trans hrad1).trans hle1
  · intro h
    exact hnot (hle1.trans h)

theorem wc_pfc_p_gdi_inj_of_dual_derivations : ∀ (k : Type u) [Field k] (A : Type u) [CommRing A] [IsLocalRing A] [Algebra k A], (∀ (s : ℕ) (a : Fin s → k), (∀ j, ∃ D : Derivation ℤ k k, ∀ l, D (a l) = if l = j then 1 else 0) → ∀ j, ∃ E : Derivation ℤ A (IsLocalRing.ResidueField A), ∀ l, E (algebraMap k A (a l)) = if l = j then 1 else 0) → ∀ (r : ℕ) (c : Fin r → IsLocalRing.ResidueField A) (a : Fin r → k), ∑ i, TensorProduct.tmul A (c i) (KaehlerDifferential.D ℤ A (algebraMap k A (a i))) = 0 → ∑ i, TensorProduct.tmul k (c i) (KaehlerDifferential.D ℤ k (a i)) = 0 :=
by
  classical
  intro k _ A _ _ _ H r c a hsum

  set v : Fin r → Ω[k⁄ℤ] := fun i => KaehlerDifferential.D ℤ k (a i) with hv
  obtain ⟨κ, ι, hinj, hspan, hli0⟩ := exists_linearIndependent' k v
  haveI : Fintype κ := Fintype.ofInjective ι hinj
  let e : κ ≃ Fin (Fintype.card κ) := Fintype.equivFin κ
  let b : Fin (Fintype.card κ) → k := fun l => a (ι (e.symm l))
  have hli : LinearIndependent k (fun l => KaehlerDifferential.D ℤ k (b l)) :=
    hli0.comp e.symm e.symm.injective
  have hrange : Set.range (fun l => KaehlerDifferential.D ℤ k (b l)) = Set.range (v ∘ ι) := by
    ext x
    constructor
    · rintro ⟨l, rfl⟩
      exact ⟨e.symm l, rfl⟩
    · rintro ⟨t, rfl⟩
      exact ⟨e t, by simp [b, v]⟩
  have hexp : ∀ i, ∃ μ : Fin (Fintype.card κ) → k,
      ∑ l, μ l • KaehlerDifferential.D ℤ k (b l) = KaehlerDifferential.D ℤ k (a i) := by
    intro i
    have hmem : v i ∈ Submodule.span k (Set.range (fun l => KaehlerDifferential.D ℤ k (b l))) := by
      rw [hrange, hspan]
      exact Submodule.subset_span ⟨i, rfl⟩
    exact (Submodule.mem_span_range_iff_exists_fun k).mp hmem
  choose μ hμ using hexp

  have hD : ∀ m, ∃ D : Derivation ℤ k k, ∀ l, D (b l) = if l = m then 1 else 0 := by
    intro m
    let f : Submodule.span k (Set.range (fun l => KaehlerDifferential.D ℤ k (b l))) →ₗ[k] k :=
      (Finsupp.lapply m) ∘ₗ hli.repr
    obtain ⟨g, hg⟩ := LinearMap.exists_extend f
    refine ⟨g.compDer (KaehlerDifferential.D ℤ k), fun l => ?_⟩
    have h1 : (g.compDer (KaehlerDifferential.D ℤ k)) (b l) = g (KaehlerDifferential.D ℤ k (b l)) :=
      rfl
    have h2 : g (KaehlerDifferential.D ℤ k (b l)) =
        f ⟨_, Submodule.subset_span ⟨l, rfl⟩⟩ := by
      rw [← hg]
      rfl
    rw [h1, h2]
    simp only [f, LinearMap.comp_apply, Finsupp.lapply_apply]
    rw [hli.repr_eq_single l _ rfl, Finsupp.single_apply]

  have hE := H (Fintype.card κ) b hD

  have hstar : ∀ m, ∑ i, algebraMap k (IsLocalRing.ResidueField A) (μ i m) * c i = 0 := by
    intro m
    obtain ⟨E, hEm⟩ := hE m
    have hval : ∀ i, E (algebraMap k A (a i)) =
        algebraMap k (IsLocalRing.ResidueField A) (μ i m) := by
      intro i
      let E' : Derivation ℤ k (IsLocalRing.ResidueField A) := E.compAlgebraMap k
      have h := congrArg E'.liftKaehlerDifferential (hμ i)
      rw [Derivation.liftKaehlerDifferential_comp_D, map_sum] at h
      simp only [map_smul, Derivation.liftKaehlerDifferential_comp_D] at h
      have e1 : ∀ z, E' z = E (algebraMap k A z) := fun z => rfl
      simp only [e1, hEm] at h
      rw [← h]
      simp [Finset.sum_ite_eq', Algebra.smul_def]
    have hpair := congrArg
      (LinearMap.liftBaseChange (IsLocalRing.ResidueField A) E.liftKaehlerDifferential) hsum
    rw [map_sum, map_zero] at hpair
    simp only [LinearMap.liftBaseChange_tmul, Derivation.liftKaehlerDifferential_comp_D,
      smul_eq_mul, hval] at hpair
    rw [← hpair]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    ring

  have hrw : ∀ i, TensorProduct.tmul k (c i) (KaehlerDifferential.D ℤ k (a i)) =
      ∑ l, TensorProduct.tmul k (algebraMap k (IsLocalRing.ResidueField A) (μ i l) * c i)
        (KaehlerDifferential.D ℤ k (b l)) := by
    intro i
    rw [← hμ i, TensorProduct.tmul_sum]
    refine Finset.sum_congr rfl (fun l _ => ?_)
    rw [← Algebra.smul_def, TensorProduct.smul_tmul]
  rw [Finset.sum_congr rfl (fun i _ => hrw i), Finset.sum_comm]
  refine Finset.sum_eq_zero (fun l _ => ?_)
  rw [← TensorProduct.sum_tmul, hstar l, TensorProduct.zero_tmul]

theorem wc_pfc_p_gdi_field_derivation : ∀ (p : ℕ) [Fact p.Prime] (K : Type u) [Field K] [CharP K p] (b : K), (∀ y : K, y ^ p ≠ b) → ∃ D : Derivation ℤ K K, D b = 1 :=
by
  intro p hp K _ _ b hb
  classical
  have hp' : p.Prime := hp.out

  let S : Set (Subfield K) := {N | (∀ z : K, z ^ p ∈ N) ∧ b ∉ N}
  have h0 : (frobenius K p).fieldRange ∈ S := by
    refine ⟨fun z => ⟨z, by rw [frobenius_def]⟩, ?_⟩
    rintro ⟨y, hy⟩
    exact hb y (by rw [← hy, frobenius_def])
  obtain ⟨M, -, hM⟩ := zorn_le_nonempty₀ S (fun c hcS hc y hy => by
    refine ⟨sSup c, ⟨fun z => (le_sSup hy) ((hcS hy).1 z), fun hbc => ?_⟩, fun N hN => le_sSup hN⟩
    obtain ⟨N, hN, hbN⟩ := (Subfield.mem_sSup_of_directedOn ⟨y, hy⟩ hc.directedOn).mp hbc
    exact (hcS hN).2 hbN) _ h0
  obtain ⟨⟨hpow, hbM⟩, hmax⟩ := hM
  have hmax' : ∀ N : Subfield K, M ≤ N → b ∉ N → N ≤ M := fun N hle hbN =>
    hmax ⟨fun z => hle (hpow z), hbN⟩ hle

  have hint : ∀ z : K, IsIntegral M z := fun z =>
    ⟨Polynomial.X ^ p - Polynomial.C (⟨z ^ p, hpow z⟩ : M),
      Polynomial.monic_X_pow_sub_C _ hp'.ne_zero, by
      rw [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C]; exact sub_self _⟩
  have hminpoly : ∀ z : K, z ∉ M →
      minpoly M z = Polynomial.X ^ p - Polynomial.C (⟨z ^ p, hpow z⟩ : M) := by
    intro z hz
    have hnr : ∀ y : M, y ^ p ≠ ⟨z ^ p, hpow z⟩ := by
      intro y hy
      apply hz
      have h1 : (y : K) ^ p = z ^ p := by
        have := congrArg Subtype.val hy
        simpa using this
      have hyz : (y : K) = z := frobenius_inj K p (by rw [frobenius_def, frobenius_def]; exact h1)
      exact hyz ▸ y.2
    exact (minpoly.eq_of_irreducible_of_monic (X_pow_sub_C_irreducible_of_prime hp' hnr)
      (by rw [Polynomial.aeval_sub, Polynomial.aeval_X_pow, Polynomial.aeval_C]; exact sub_self _)
      (Polynomial.monic_X_pow_sub_C _ hp'.ne_zero)).symm
  have hfin : ∀ z : K, z ∉ M → Module.finrank M (IntermediateField.adjoin M {z}) = p := by
    intro z hz
    rw [IntermediateField.adjoin.finrank (hint z), hminpoly z hz, Polynomial.natDegree_X_pow_sub_C]

  have hgen : ∀ x : K, x ∈ IntermediateField.adjoin M {b} := by
    intro x
    by_cases hx : x ∈ M
    · exact IntermediateField.algebraMap_mem _ (⟨x, hx⟩ : M)
    · have hbx : b ∈ IntermediateField.adjoin M {x} := by
        by_contra hbN
        have hle : M ≤ (IntermediateField.adjoin M {x}).toSubfield := fun m hm =>
          IntermediateField.algebraMap_mem _ (⟨m, hm⟩ : M)
        exact hx (hmax' _ hle hbN (IntermediateField.mem_adjoin_simple_self M x))
      have h1 : IntermediateField.adjoin M {b} ≤ IntermediateField.adjoin M {x} :=
        IntermediateField.adjoin_simple_le_iff.mpr hbx
      have hfx := hfin x hx
      have hfb := hfin b hbM
      have : FiniteDimensional M (IntermediateField.adjoin M {x}) :=
        Module.finite_of_finrank_pos (by rw [hfx]; exact hp'.pos)
      have h2 := IntermediateField.eq_of_le_of_finrank_eq h1 (by rw [hfx, hfb])
      rw [h2]
      exact IntermediateField.mem_adjoin_simple_self M x
  have hsurj : ∀ x : K, ∃ f : Polynomial M, Polynomial.aeval b f = x := by
    intro x
    have hx := hgen x
    rw [← IntermediateField.mem_toSubalgebra,
      IntermediateField.adjoin_simple_toSubalgebra_of_isAlgebraic (hint b).isAlgebraic,
      Algebra.adjoin_singleton_eq_range_aeval] at hx
    exact hx

  have hmin := hminpoly b hbM
  have hpM : (p : M) = 0 :=
    (algebraMap M K).injective (by rw [map_natCast, map_zero, CharP.cast_eq_zero])
  have hder0 : Polynomial.derivative (minpoly M b) = 0 := by
    rw [hmin, Polynomial.derivative_sub, Polynomial.derivative_C, sub_zero,
      Polynomial.derivative_X_pow, hpM, map_zero, zero_mul]
  have hkey : ∀ h : Polynomial M, Polynomial.aeval b h = 0 →
      Polynomial.aeval b (Polynomial.derivative h) = 0 := by
    intro h hh
    obtain ⟨q, rfl⟩ := minpoly.dvd M b hh
    rw [Polynomial.derivative_mul, hder0, zero_mul, zero_add, map_mul, minpoly.aeval, zero_mul]
  have hwd : ∀ f g : Polynomial M, Polynomial.aeval b f = Polynomial.aeval b g →
      Polynomial.aeval b (Polynomial.derivative f) = Polynomial.aeval b (Polynomial.derivative g) := by
    intro f g hfg
    have := hkey (f - g) (by rw [map_sub, hfg, sub_self])
    rwa [Polynomial.derivative_sub, map_sub, sub_eq_zero] at this
  choose σ hσ using hsurj
  obtain ⟨δ, hδdef⟩ : ∃ δ : K → K, ∀ x, δ x = Polynomial.aeval b (Polynomial.derivative (σ x)) :=
    ⟨_, fun _ => rfl⟩
  have hδ : ∀ f : Polynomial M, δ (Polynomial.aeval b f) =
      Polynomial.aeval b (Polynomial.derivative f) := fun f => by
    rw [hδdef]; exact hwd _ _ (hσ _)
  have hadd : ∀ x y, δ (x + y) = δ x + δ y := by
    intro x y
    have e : x + y = Polynomial.aeval b (σ x + σ y) := by rw [map_add, hσ, hσ]
    rw [e, hδ, Polynomial.derivative_add, map_add, hδdef, hδdef]
  have hmul : ∀ x y, δ (x * y) = x • δ y + y • δ x := by
    intro x y
    have e : x * y = Polynomial.aeval b (σ x * σ y) := by rw [map_mul, hσ, hσ]
    rw [e, hδ, Polynomial.derivative_mul, map_add, map_mul, map_mul, hδdef, hδdef, hσ, hσ,
      smul_eq_mul, smul_eq_mul]
    ring
  have hb1 : δ b = 1 := by
    have := hδ Polynomial.X
    rwa [Polynomial.aeval_X, Polynomial.derivative_X, map_one] at this
  let g : K →+ K := AddMonoidHom.mk' δ hadd
  exact ⟨Derivation.mk' g.toIntLinearMap (fun x y => hmul x y), hb1⟩

theorem wc_pfc_p_gdi_root_field : ∀ (p : ℕ) [Fact p.Prime] (k : Type u) [Field k] [CharP k p] (s : ℕ) (a : Fin s → k), (∀ m, ∃ D : Derivation ℤ k k, ∀ l, D (a l) = if l = m then 1 else 0) → ∀ j, ∃ (k₁ : Type u) (_ : Field k₁) (_ : Algebra k k₁) (_ : FiniteDimensional k k₁) (D₁ : Derivation ℤ k₁ k₁), D₁ (algebraMap k k₁ (a j)) = 1 ∧ ∀ l, l ≠ j → ∃ y : k₁, y ^ p = algebraMap k k₁ (a l) :=
by
  intro p _ k _ _ s a hdual j
  classical
  obtain ⟨D, hD⟩ := hdual j
  have hp0 : (p : k) = 0 := CharP.cast_eq_zero k p
  haveI : CharP (AlgebraicClosure k) p :=
    charP_of_injective_algebraMap (algebraMap k (AlgebraicClosure k)).injective p
  have hroot : ∀ l : {l : Fin s // l ≠ j}, ∃ x : AlgebraicClosure k,
      x ^ p = algebraMap k (AlgebraicClosure k) (a l) := fun l =>
    IsAlgClosed.exists_pow_nat_eq _ (Fact.out : p.Prime).pos
  choose β hβ using hroot
  have hDp : ∀ r : k, D (r ^ p) = 0 := by
    intro r
    rw [Derivation.leibniz_pow, nsmul_eq_mul, hp0, zero_mul]

  have hclos : ∀ x ∈ IntermediateField.adjoin k (Set.range β),
      ∃ c : k, x ^ p = algebraMap k (AlgebraicClosure k) c ∧ D c = 0 := by
    intro x hx
    induction hx using IntermediateField.adjoin_induction with
    | mem x hx =>
      obtain ⟨l, rfl⟩ := hx
      refine ⟨a l, hβ l, ?_⟩
      rw [hD, if_neg l.2]
    | algebraMap r =>
      exact ⟨r ^ p, (map_pow _ _ _).symm, hDp r⟩
    | add x y _ _ hx hy =>
      obtain ⟨c₁, h₁, d₁⟩ := hx
      obtain ⟨c₂, h₂, d₂⟩ := hy
      exact ⟨c₁ + c₂, by rw [add_pow_char, h₁, h₂, map_add], by rw [map_add, d₁, d₂, add_zero]⟩
    | inv x _ hx =>
      obtain ⟨c, h, d⟩ := hx
      refine ⟨c⁻¹, by rw [inv_pow, h, map_inv₀], ?_⟩
      simp [Derivation.leibniz_inv, d]
    | mul x y _ _ hx hy =>
      obtain ⟨c₁, h₁, d₁⟩ := hx
      obtain ⟨c₂, h₂, d₂⟩ := hy
      exact ⟨c₁ * c₂, by rw [mul_pow, h₁, h₂, map_mul],
        by simp [Derivation.leibniz, d₁, d₂]⟩
  haveI : FiniteDimensional k (IntermediateField.adjoin k (Set.range β)) :=
    IntermediateField.finiteDimensional_adjoin (fun x _ => Algebra.IsIntegral.isIntegral x)
  haveI : CharP (IntermediateField.adjoin k (Set.range β)) p :=
    charP_of_injective_algebraMap
      (algebraMap k (IntermediateField.adjoin k (Set.range β))).injective p
  have hnot : ∀ y : IntermediateField.adjoin k (Set.range β),
      y ^ p ≠ algebraMap k (IntermediateField.adjoin k (Set.range β)) (a j) := by
    intro y hy
    obtain ⟨c, hc, hdc⟩ := hclos y.1 y.2
    have h1 : (y : AlgebraicClosure k) ^ p = algebraMap k (AlgebraicClosure k) (a j) := by
      have := congrArg (fun z : IntermediateField.adjoin k (Set.range β) =>
        (z : AlgebraicClosure k)) hy
      simpa using this
    rw [h1] at hc
    have hca := (algebraMap k (AlgebraicClosure k)).injective hc
    rw [← hca, hD, if_pos rfl] at hdc
    exact one_ne_zero hdc
  obtain ⟨D₁, hD₁⟩ := wc_pfc_p_gdi_field_derivation p (IntermediateField.adjoin k (Set.range β))
    (algebraMap k (IntermediateField.adjoin k (Set.range β)) (a j)) hnot
  refine ⟨IntermediateField.adjoin k (Set.range β), inferInstance, inferInstance, inferInstance,
    D₁, hD₁, fun l hl => ?_⟩
  refine ⟨⟨β ⟨l, hl⟩, IntermediateField.subset_adjoin k _ ⟨⟨l, hl⟩, rfl⟩⟩, ?_⟩
  apply Subtype.ext
  simpa using hβ ⟨l, hl⟩

theorem wc_pfc_p_gdi_gr_basechange : ∀ (k k₁ Λ : Type u) [Field k] [Field k₁] [CommRing Λ] [IsNoetherianRing Λ] [Algebra k k₁] [Algebra k Λ] [FiniteDimensional k k₁], (∀ (L : Type u) [Field L] [Algebra k L] [FiniteDimensional k L] (𝔔 : Ideal (TensorProduct k L Λ)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) → IsNoetherianRing (TensorProduct k k₁ Λ) ∧ ∀ (L : Type u) [Field L] [Algebra k₁ L] [FiniteDimensional k₁ L] (𝔔 : Ideal (TensorProduct k₁ L (TensorProduct k k₁ Λ))) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔) :=
by
  intro k k₁ Λ _ _ _ _ _ _ _ hreg
  have transport : ∀ (R R' : Type u) [CommRing R] [CommRing R'] (e : R ≃+* R')
      (𝔔 : Ideal R') [𝔔.IsPrime],
      IsRegularLocalRing (Localization.AtPrime (Ideal.comap e 𝔔)) →
      IsRegularLocalRing (Localization.AtPrime 𝔔) := by
    intro R R' _ _ e 𝔔 _ h
    have hmap : Submonoid.map e.toMonoidHom (Ideal.comap e 𝔔).primeCompl = 𝔔.primeCompl := by
      ext y
      rw [Submonoid.mem_map]
      constructor
      · rintro ⟨x, hx, rfl⟩
        exact hx
      · intro hy
        refine ⟨e.symm y, ?_, ?_⟩
        · show e.symm y ∉ Ideal.comap e 𝔔
          rw [Ideal.mem_comap, RingEquiv.apply_symm_apply]
          exact hy
        · exact RingEquiv.apply_symm_apply e y
    haveI := h
    exact IsRegularLocalRing.of_ringEquiv
      (IsLocalization.ringEquivOfRingEquiv (Localization.AtPrime (Ideal.comap e 𝔔))
        (Localization.AtPrime 𝔔) e hmap)
  refine ⟨?_, ?_⟩
  · haveI : Module.Finite Λ (TensorProduct k Λ k₁) := Module.Finite.base_change k Λ k₁
    haveI : IsNoetherianRing (TensorProduct k Λ k₁) :=
      IsNoetherianRing.of_finite Λ (TensorProduct k Λ k₁)
    exact isNoetherianRing_of_ringEquiv (TensorProduct k Λ k₁)
      (Algebra.TensorProduct.comm k Λ k₁).toRingEquiv
  · intro L _ _ _ 𝔔 _
    letI : Algebra k L := ((algebraMap k₁ L).comp (algebraMap k k₁)).toAlgebra
    haveI : IsScalarTower k k₁ L := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    haveI : FiniteDimensional k L := Module.Finite.trans k₁ L
    let e₀ : TensorProduct k₁ L (TensorProduct k k₁ Λ) ≃+* TensorProduct k L Λ :=
      (Algebra.TensorProduct.cancelBaseChange k k₁ k₁ L Λ).toRingEquiv
    have h := hreg L (Ideal.comap e₀.symm 𝔔)
    exact transport _ _ e₀.symm 𝔔 h

theorem wc_pfc_p_gdi_derivation_transfer : ∀ (k k₁ Λ : Type u) [Field k] [Field k₁] [CommRing Λ] [Algebra k k₁] [Algebra k Λ] [FiniteDimensional k k₁] (𝔮 : Ideal Λ) [𝔮.IsPrime], ∃ (𝔔 : Ideal (TensorProduct k k₁ Λ)) (_ : 𝔔.IsPrime), ∀ E' : Derivation ℤ (Localization.AtPrime 𝔔) (IsLocalRing.ResidueField (Localization.AtPrime 𝔔)), ∃ E : Derivation ℤ (Localization.AtPrime 𝔮) (IsLocalRing.ResidueField (Localization.AtPrime 𝔮)), ∀ x : k, (E' (algebraMap k₁ (Localization.AtPrime 𝔔) (algebraMap k k₁ x)) = 0 → E (algebraMap k (Localization.AtPrime 𝔮) x) = 0) ∧ (E' (algebraMap k₁ (Localization.AtPrime 𝔔) (algebraMap k k₁ x)) = 1 → E (algebraMap k (Localization.AtPrime 𝔮) x) = 1) :=
by
  intro k k₁ Λ _ _ _ _ _ _ 𝔮 _
  classical
  have mkDer : ∀ (A M : Type u) [CommRing A] [AddCommGroup M] [Module A M] (iA : Algebra ℤ A)
      (iM : Module ℤ M) (g : A →+ M), (∀ x y, g (x * y) = x • g y + y • g x) →
      ∃ E : @Derivation ℤ A M _ _ _ iA _ iM, ∀ x, E x = g x := by
    intro A M _ _ _ iA iM g hg
    obtain rfl : iA = Ring.toIntAlgebra A := Subsingleton.elim _ _
    obtain rfl : iM = AddCommGroup.toIntModule M := Subsingleton.elim _ _
    refine ⟨Derivation.mk' { toFun := g, map_add' := g.map_add, map_smul' := ?_ } hg, fun x => rfl⟩
    intro n x
    simp only [RingHom.id_apply]
    rw [Algebra.smul_def, algebraMap_int_eq, eq_intCast, ← zsmul_eq_mul, map_zsmul]

  have s1 : ∃ 𝔔 : Ideal (TensorProduct k k₁ Λ), 𝔔.IsPrime ∧
      𝔮 = Ideal.comap (Algebra.TensorProduct.includeRight (R := k) (A := k₁) (B := Λ)).toRingHom 𝔔 := by
    letI iΛ : Algebra Λ (TensorProduct k k₁ Λ) :=
      (Algebra.TensorProduct.includeRight (R := k) (A := k₁) (B := Λ)).toRingHom.toAlgebra
    haveI : IsScalarTower k Λ (TensorProduct k k₁ Λ) := IsScalarTower.of_algebraMap_eq
      (fun x => ((Algebra.TensorProduct.includeRight (R := k) (A := k₁) (B := Λ)).commutes x).symm)
    haveI : Algebra.IsIntegral k k₁ := Algebra.IsIntegral.of_finite k k₁
    haveI : Algebra.IsIntegral Λ (TensorProduct k k₁ Λ) := by
      constructor
      intro z
      induction z using TensorProduct.induction_on with
      | zero => exact isIntegral_zero
      | tmul l μ =>
        have e : l ⊗ₜ[k] μ = (l ⊗ₜ[k] (1 : Λ)) * ((1 : k₁) ⊗ₜ[k] μ) := by
          rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
        have e2 : ((1 : k₁) ⊗ₜ[k] μ) = algebraMap Λ (TensorProduct k k₁ Λ) μ := rfl
        rw [e, e2]
        refine IsIntegral.mul ?_ isIntegral_algebraMap
        have hl : IsIntegral k ((Algebra.TensorProduct.includeLeft :
            k₁ →ₐ[k] TensorProduct k k₁ Λ) l) := (Algebra.IsIntegral.isIntegral l).map _
        rw [Algebra.TensorProduct.includeLeft_apply] at hl
        exact IsIntegral.tower_top hl
      | add a b ha hb => exact ha.add hb
    have hinj : Function.Injective (Algebra.TensorProduct.includeRight (R := k) (A := k₁) (B := Λ)) :=
      Algebra.TensorProduct.includeRight_injective (algebraMap k k₁).injective
    obtain ⟨Q, -, hQ, hQ𝔮⟩ := Ideal.exists_ideal_over_prime_of_isIntegral 𝔮
      (⊥ : Ideal (TensorProduct k k₁ Λ)) (by
        intro y hy
        change algebraMap Λ (TensorProduct k k₁ Λ) y ∈ (⊥ : Ideal (TensorProduct k k₁ Λ)) at hy
        rw [Ideal.mem_bot] at hy
        have hy0 : y = 0 := by
          apply hinj
          rw [map_zero]
          exact hy
        rw [hy0]
        exact Ideal.zero_mem _)
    exact ⟨Q, hQ, hQ𝔮.symm⟩
  obtain ⟨𝔔, h𝔔, h⟩ := s1
  refine ⟨𝔔, h𝔔, ?_⟩
  intro E'
  let θ : Localization.AtPrime 𝔮 →+* Localization.AtPrime 𝔔 := Localization.localRingHom 𝔮 𝔔
    (Algebra.TensorProduct.includeRight (R := k) (A := k₁) (B := Λ)).toRingHom h
  haveI hθ : IsLocalHom θ := Localization.isLocalHom_localRingHom _ _ _ _

  have s3 : ∀ x : k, θ (algebraMap k (Localization.AtPrime 𝔮) x) =
      algebraMap k₁ (Localization.AtPrime 𝔔) (algebraMap k k₁ x) := by
    intro x
    rw [IsScalarTower.algebraMap_apply k Λ (Localization.AtPrime 𝔮)]
    rw [Localization.localRingHom_to_map]
    rw [IsScalarTower.algebraMap_apply k₁ (TensorProduct k k₁ Λ) (Localization.AtPrime 𝔔)]
    congr 1
    rw [← IsScalarTower.algebraMap_apply k k₁ (TensorProduct k k₁ Λ)]
    exact (Algebra.TensorProduct.includeRight (R := k) (A := k₁) (B := Λ)).commutes x

  letI iκ : Algebra (IsLocalRing.ResidueField (Localization.AtPrime 𝔮))
      (IsLocalRing.ResidueField (Localization.AtPrime 𝔔)) :=
    (IsLocalRing.ResidueField.map θ).toAlgebra
  obtain ⟨f, hf⟩ : ∃ f : IsLocalRing.ResidueField (Localization.AtPrime 𝔔) →ₗ[IsLocalRing.ResidueField (Localization.AtPrime 𝔮)] IsLocalRing.ResidueField (Localization.AtPrime 𝔮), f 1 ≠ 0 := by
    by_contra hcon
    push_neg at hcon
    exact one_ne_zero ((Module.forall_dual_apply_eq_zero_iff _ _).mp hcon)
  let π := (f 1)⁻¹ • f
  have hπ1 : π 1 = 1 := by
    show (f 1)⁻¹ • f 1 = 1
    rw [smul_eq_mul, inv_mul_cancel₀ hf]
  have key : ∀ (a : Localization.AtPrime 𝔮) (m : IsLocalRing.ResidueField (Localization.AtPrime 𝔔)),
      π (θ a • m) = a • π m := by
    intro a m
    have e1 : θ a • m = (IsLocalRing.residue (Localization.AtPrime 𝔮) a) • m := by
      rw [Algebra.smul_def, Algebra.smul_def, IsLocalRing.ResidueField.algebraMap_eq,
        RingHom.algebraMap_toAlgebra, IsLocalRing.ResidueField.map_residue]
    have e2 : a • π m = IsLocalRing.residue (Localization.AtPrime 𝔮) a * π m := by
      rw [Algebra.smul_def, IsLocalRing.ResidueField.algebraMap_eq]
    rw [e1, map_smul, e2, smul_eq_mul]
  let g : Localization.AtPrime 𝔮 →+ IsLocalRing.ResidueField (Localization.AtPrime 𝔮) :=
    AddMonoidHom.mk' (fun a => π (E' (θ a))) (by intro a b; rw [map_add, map_add, map_add])
  have hg : ∀ x y, g (x * y) = x • g y + y • g x := by
    intro x y
    show π (E' (θ (x * y))) = x • π (E' (θ y)) + y • π (E' (θ x))
    rw [map_mul, Derivation.leibniz, map_add, key, key]
  obtain ⟨E, hE⟩ := mkDer (Localization.AtPrime 𝔮)
    (IsLocalRing.ResidueField (Localization.AtPrime 𝔮)) inferInstance inferInstance g hg
  refine ⟨E, fun x => ?_⟩
  have hEx : E (algebraMap k (Localization.AtPrime 𝔮) x) =
      π (E' (algebraMap k₁ (Localization.AtPrime 𝔔) (algebraMap k k₁ x))) := by
    rw [hE, ← s3 x]
    rfl
  rw [hEx]
  constructor
  · intro h0
    rw [h0, map_zero]
  · intro h1
    rw [h1, hπ1]

theorem wc_pfc_p_gdi_insep_regular : ∀ (k : Type u) [Field k] (p : ℕ) [Fact p.Prime] [CharP k p] (Λ : Type u) [CommRing Λ] [IsNoetherianRing Λ] [Algebra k Λ], (∀ (L : Type u) [Field L] [Algebra k L] [FiniteDimensional k L] (𝔔 : Ideal (TensorProduct k L Λ)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) → ∀ (𝔮 : Ideal Λ) [𝔮.IsPrime] (L : Type u) [Field L] [Algebra k L] [FiniteDimensional k L], (∀ l : L, ∃ c : k, l ^ p = algebraMap k L c) → IsRegularLocalRing (TensorProduct k L (Localization.AtPrime 𝔮)) :=
by
  intro k _ p _ _ Λ _ _ _ hreg 𝔮 h𝔮 L _ _ _ hL
  classical
  have hp : p.Prime := Fact.out
  have h1 : (1 : Λ) ∉ 𝔮 := (Ideal.ne_top_iff_one _).mp h𝔮.ne_top
  haveI : Nontrivial Λ := nontrivial_of_ne 1 0 (fun h => h1 (h ▸ 𝔮.zero_mem))

  let ι : Λ →ₐ[k] TensorProduct k L Λ := Algebra.TensorProduct.includeRight
  have hι : Function.Injective ι :=
    Algebra.TensorProduct.includeRight_injective (algebraMap k L).injective
  haveI : Nontrivial (TensorProduct k L Λ) := hι.nontrivial
  haveI : CharP (TensorProduct k L Λ) p :=
    charP_of_injective_ringHom (algebraMap k (TensorProduct k L Λ)).injective p
  have hpow : ∀ x : TensorProduct k L Λ, ∃ w : Λ, ι w = x ^ p := by
    intro x
    induction x using TensorProduct.induction_on with
    | zero => exact ⟨0, by rw [map_zero, zero_pow hp.ne_zero]⟩
    | tmul l w =>
      obtain ⟨c, hc⟩ := hL l
      refine ⟨algebraMap k Λ c * w ^ p, ?_⟩
      show (1 : L) ⊗ₜ[k] (algebraMap k Λ c * w ^ p) = (l ⊗ₜ[k] w) ^ p
      rw [Algebra.TensorProduct.tmul_pow, hc, Algebra.algebraMap_eq_smul_one (A := L),
        TensorProduct.smul_tmul, Algebra.smul_def]
    | add x y hx hy =>
      obtain ⟨a, ha⟩ := hx
      obtain ⟨b, hb⟩ := hy
      exact ⟨a + b, by rw [map_add, ha, hb, add_pow_char]⟩
  choose F₀ hF₀ using hpow
  have hFmul : ∀ x y, F₀ (x * y) = F₀ x * F₀ y := fun x y =>
    hι (by rw [map_mul, hF₀, hF₀, hF₀, mul_pow])
  have hFadd : ∀ x y, F₀ (x + y) = F₀ x + F₀ y := fun x y =>
    hι (by rw [map_add, hF₀, hF₀, hF₀, add_pow_char])
  let F : TensorProduct k L Λ →+* Λ :=
    { toFun := F₀
      map_one' := hι (by rw [hF₀, one_pow, map_one])
      map_mul' := hFmul
      map_zero' := hι (by rw [hF₀, map_zero, zero_pow hp.ne_zero])
      map_add' := hFadd }
  have hFι : ∀ w, F (ι w) = w ^ p := fun w => hι (by
    show ι (F₀ (ι w)) = ι (w ^ p)
    rw [hF₀, map_pow])

  let 𝔔 : Ideal (TensorProduct k L Λ) := Ideal.comap F 𝔮
  haveI : 𝔔.IsPrime := Ideal.comap_isPrime F 𝔮
  have hP1 : ∀ s, ι s ∈ 𝔔 ↔ s ∈ 𝔮 := by
    intro s
    rw [Ideal.mem_comap, hFι]
    exact h𝔮.pow_mem_iff_mem p hp.pos

  let Θ : TensorProduct k L Λ →ₐ[k] TensorProduct k L (Localization.AtPrime 𝔮) :=
    Algebra.TensorProduct.map (AlgHom.id k L) (IsScalarTower.toAlgHom k Λ (Localization.AtPrime 𝔮))
  let j : Localization.AtPrime 𝔮 →ₐ[k] TensorProduct k L (Localization.AtPrime 𝔮) :=
    Algebra.TensorProduct.includeRight
  have hbasic : ∀ w, Θ (ι w) = j (algebraMap Λ (Localization.AtPrime 𝔮) w) := by
    intro w
    show Θ ((1 : L) ⊗ₜ[k] w) = (1 : L) ⊗ₜ[k] (algebraMap Λ (Localization.AtPrime 𝔮) w)
    rw [Algebra.TensorProduct.map_tmul]
    rfl
  have hsurj : ∀ z : TensorProduct k L (Localization.AtPrime 𝔮), ∃ (x : TensorProduct k L Λ) (s : Λ),
      s ∉ 𝔮 ∧ z * j (algebraMap Λ (Localization.AtPrime 𝔮) s) = Θ x := by
    intro z
    induction z using TensorProduct.induction_on with
    | zero => exact ⟨0, 1, h1, by rw [zero_mul, map_zero]⟩
    | tmul l y =>
      obtain ⟨⟨a, s⟩, hs⟩ := IsLocalization.surj 𝔮.primeCompl y
      refine ⟨l ⊗ₜ[k] a, s, s.2, ?_⟩
      show (l ⊗ₜ[k] y) * ((1 : L) ⊗ₜ[k] (algebraMap Λ (Localization.AtPrime 𝔮) s)) = Θ (l ⊗ₜ[k] a)
      rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, hs, Algebra.TensorProduct.map_tmul]
      rfl
    | add z₁ z₂ h₁ h₂ =>
      obtain ⟨x₁, s₁, hs₁, e₁⟩ := h₁
      obtain ⟨x₂, s₂, hs₂, e₂⟩ := h₂
      refine ⟨x₁ * ι s₂ + x₂ * ι s₁, s₁ * s₂,
        fun h => (h𝔮.mem_or_mem h).elim hs₁ hs₂, ?_⟩
      rw [map_add Θ, map_mul Θ, map_mul Θ, hbasic, hbasic, ← e₁, ← e₂,
        map_mul (algebraMap Λ (Localization.AtPrime 𝔮)), map_mul j]
      ring
  have hker : ∀ x : TensorProduct k L Λ, Θ x = 0 → ∃ s : Λ, s ∉ 𝔮 ∧ ι s * x = 0 := by
    intro x hx
    let b := Module.Free.chooseBasis k L
    obtain ⟨μ, hμ⟩ : ∃ μ, μ = TensorProduct.equivFinsuppOfBasisLeft (N := Λ) b x := ⟨_, rfl⟩
    have hxμ : x = μ.sum (fun i n => b i ⊗ₜ[k] n) := by
      rw [← TensorProduct.equivFinsuppOfBasisLeft_symm_apply, hμ, LinearEquiv.symm_apply_apply]
    have h2 : (μ.mapRange (algebraMap Λ (Localization.AtPrime 𝔮)) (map_zero _)).sum
        (fun i n => b i ⊗ₜ[k] n) = 0 := by
      rw [Finsupp.sum_mapRange_index (fun i => TensorProduct.tmul_zero _ _), ← hx, hxμ]
      simp only [Finsupp.sum, map_sum]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [Algebra.TensorProduct.map_tmul]
      rfl
    have h3 := TensorProduct.sum_tmul_basis_left_eq_zero b _ h2
    have h4 : ∀ i, ∃ s : 𝔮.primeCompl, (s : Λ) * μ i = 0 := by
      intro i
      have h5 : algebraMap Λ (Localization.AtPrime 𝔮) (μ i) = 0 := by
        have := congrArg (fun f => f i) h3
        simpa using this
      exact (IsLocalization.map_eq_zero_iff 𝔮.primeCompl _ _).mp h5
    choose sf hsf using h4
    have hmem : (∏ i ∈ μ.support, (sf i : Λ)) ∈ 𝔮.primeCompl :=
      Submonoid.prod_mem _ (fun i _ => (sf i).2)
    refine ⟨∏ i ∈ μ.support, (sf i : Λ), hmem, ?_⟩
    rw [hxμ, Finsupp.sum, Finset.mul_sum]
    apply Finset.sum_eq_zero
    intro i hi
    show ((1 : L) ⊗ₜ[k] (∏ i ∈ μ.support, (sf i : Λ))) * (b i ⊗ₜ[k] μ i) = 0
    rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul, ← Finset.mul_prod_erase _ _ hi,
      mul_comm (sf i : Λ), mul_assoc, hsf i, mul_zero, TensorProduct.tmul_zero]

  letI : Algebra (TensorProduct k L Λ) (TensorProduct k L (Localization.AtPrime 𝔮)) :=
    Θ.toRingHom.toAlgebra
  haveI hloc : IsLocalization 𝔔.primeCompl (TensorProduct k L (Localization.AtPrime 𝔮)) := by
    rw [isLocalization_iff]
    refine ⟨?_, ?_, ?_⟩
    · rintro ⟨r, hr⟩
      change IsUnit (Θ r)
      have hr' : F₀ r ∈ 𝔮.primeCompl := hr
      have hu : IsUnit (Θ r ^ p) := by
        rw [← map_pow, ← hF₀, hbasic]
        exact (IsLocalization.map_units (Localization.AtPrime 𝔮) ⟨F₀ r, hr'⟩).map j
      exact (isUnit_pow_iff hp.ne_zero).mp hu
    · intro z
      obtain ⟨x, s, hs, hz⟩ := hsurj z
      refine ⟨(x, ⟨ι s, fun h => hs ((hP1 s).mp h)⟩), ?_⟩
      change z * Θ (ι s) = Θ x
      rw [hbasic]
      exact hz
    · intro x y hxy
      change Θ x = Θ y at hxy
      obtain ⟨s, hs, h⟩ := hker (x - y) (by rw [map_sub, hxy, sub_self])
      refine ⟨⟨ι s, fun h' => hs ((hP1 s).mp h')⟩, ?_⟩
      rw [← sub_eq_zero, ← mul_sub]
      exact h
  let e := IsLocalization.algEquiv 𝔔.primeCompl (TensorProduct k L (Localization.AtPrime 𝔮))
    (Localization.AtPrime 𝔔)
  haveI := hreg L 𝔔
  exact IsRegularLocalRing.of_ringEquiv e.symm.toRingEquiv

theorem wc_pfc_p_gdi_root_basis : ∀ (p : ℕ) [Fact p.Prime] (k : Type u) [Field k] [CharP k p] (A : Type u) [CommRing A] [Algebra k A] (a : k) (γ : A), ∃ t : TensorProduct k (AdjoinRoot (Polynomial.X ^ p - Polynomial.C a)) A, t ^ p = Algebra.TensorProduct.includeRight (algebraMap k A a - γ ^ p) ∧ (∀ b : TensorProduct k (AdjoinRoot (Polynomial.X ^ p - Polynomial.C a)) A, ∃! c : Fin p → A, b = ∑ i, Algebra.TensorProduct.includeRight (c i) * t ^ (i : ℕ)) ∧ ∀ l : AdjoinRoot (Polynomial.X ^ p - Polynomial.C a), ∃ c : k, l ^ p = algebraMap k _ c :=
by
  intro p _ k _ _ A _ _ a γ
  classical
  have hp : p.Prime := Fact.out

  have frob : ∀ (R : Type u) [CommRing R] [Algebra k R] (x y : R),
      (x + y) ^ p = x ^ p + y ^ p := by
    intro R _ _ x y
    obtain ⟨r, hr⟩ := exists_add_pow_prime_eq hp x y
    have h0 : (p : R) = 0 := by
      rw [← map_natCast (algebraMap k R), CharP.cast_eq_zero, map_zero]
    rw [hr, h0, zero_mul, zero_mul, zero_mul, add_zero]
  have hroot : ∀ (R : Type u) [CommRing R] (c : R),
      (AdjoinRoot.root (Polynomial.X ^ p - Polynomial.C c)) ^ p =
        AdjoinRoot.of (Polynomial.X ^ p - Polynomial.C c) c := by
    intro R _ c
    have h := AdjoinRoot.mk_self (f := Polynomial.X ^ p - Polynomial.C c)
    rw [map_sub, map_pow, AdjoinRoot.mk_X, AdjoinRoot.mk_C, sub_eq_zero] at h
    exact h
  have h3 : ∀ c : k, TensorProduct.tmul k (AdjoinRoot.of (Polynomial.X ^ p - Polynomial.C a) c)
      (1 : A) = TensorProduct.tmul k (1 : AdjoinRoot (Polynomial.X ^ p - Polynomial.C a))
      (algebraMap k A c) := by
    intro c
    rw [← AdjoinRoot.algebraMap_eq, Algebra.algebraMap_eq_smul_one, Algebra.algebraMap_eq_smul_one,
      TensorProduct.smul_tmul]

  obtain ⟨t, ht_def⟩ : ∃ t : TensorProduct k (AdjoinRoot (Polynomial.X ^ p - Polynomial.C a)) A,
      t = TensorProduct.tmul k (AdjoinRoot.root (Polynomial.X ^ p - Polynomial.C a)) (1 : A) -
        TensorProduct.tmul k (1 : AdjoinRoot (Polynomial.X ^ p - Polynomial.C a)) γ := ⟨_, rfl⟩
  have htadd : t + TensorProduct.tmul k (1 : AdjoinRoot (Polynomial.X ^ p - Polynomial.C a)) γ =
      TensorProduct.tmul k (AdjoinRoot.root (Polynomial.X ^ p - Polynomial.C a)) (1 : A) := by
    rw [ht_def, sub_add_cancel]
  have ht : t ^ p = Algebra.TensorProduct.includeRight (algebraMap k A a - γ ^ p) := by
    have h1 := frob (TensorProduct k (AdjoinRoot (Polynomial.X ^ p - Polynomial.C a)) A) t
      (TensorProduct.tmul k (1 : AdjoinRoot (Polynomial.X ^ p - Polynomial.C a)) γ)
    rw [htadd, Algebra.TensorProduct.tmul_pow, Algebra.TensorProduct.tmul_pow, one_pow, one_pow,
      hroot, h3] at h1
    rw [Algebra.TensorProduct.includeRight_apply, TensorProduct.tmul_sub, h1, add_sub_cancel_right]

  have hG3 : ∀ l : AdjoinRoot (Polynomial.X ^ p - Polynomial.C a), ∃ c : k,
      l ^ p = algebraMap k _ c := by
    intro l
    obtain ⟨P, rfl⟩ := AdjoinRoot.mk_surjective l
    refine Polynomial.induction_on' P ?_ ?_
    · intro P Q hP hQ
      obtain ⟨c, hc⟩ := hP
      obtain ⟨d, hd⟩ := hQ
      refine ⟨c + d, ?_⟩
      rw [map_add (AdjoinRoot.mk _), frob (AdjoinRoot (Polynomial.X ^ p - Polynomial.C a)), hc, hd,
        map_add (algebraMap k _)]
    · intro n c
      refine ⟨c ^ p * a ^ n, ?_⟩
      rw [← Polynomial.C_mul_X_pow_eq_monomial, map_mul (AdjoinRoot.mk _), map_pow (AdjoinRoot.mk _),
        AdjoinRoot.mk_C, AdjoinRoot.mk_X, mul_pow, ← pow_mul, pow_mul',
        hroot k a, AdjoinRoot.algebraMap_eq, map_mul, map_pow, map_pow]
  refine ⟨t, ht, ?_, hG3⟩

  obtain ⟨f, hf⟩ : ∃ f : A, f = algebraMap k A a - γ ^ p := ⟨_, rfl⟩
  rw [← hf] at ht
  have hev : Polynomial.eval₂ ((Algebra.TensorProduct.includeRight : A →ₐ[k]
      TensorProduct k (AdjoinRoot (Polynomial.X ^ p - Polynomial.C a)) A) : A →+*
      TensorProduct k (AdjoinRoot (Polynomial.X ^ p - Polynomial.C a)) A) t
      (Polynomial.X ^ p - Polynomial.C f) = 0 := by
    rw [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C, ht]
    exact sub_self _
  obtain ⟨φ, hφof, hφroot⟩ : ∃ φ : AdjoinRoot (Polynomial.X ^ p - Polynomial.C f) →+*
      TensorProduct k (AdjoinRoot (Polynomial.X ^ p - Polynomial.C a)) A,
      (∀ x, φ (AdjoinRoot.of _ x) = Algebra.TensorProduct.includeRight x) ∧
        φ (AdjoinRoot.root _) = t :=
    ⟨AdjoinRoot.lift _ t hev, fun x => AdjoinRoot.lift_of hev, AdjoinRoot.lift_root hev⟩
  have hev' : Polynomial.eval₂ ((Algebra.ofId k (AdjoinRoot (Polynomial.X ^ p - Polynomial.C f))) :
      k →+* AdjoinRoot (Polynomial.X ^ p - Polynomial.C f))
      (AdjoinRoot.root (Polynomial.X ^ p - Polynomial.C f) + AdjoinRoot.of _ γ)
      (Polynomial.X ^ p - Polynomial.C a) = 0 := by
    rw [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C,
      frob (AdjoinRoot (Polynomial.X ^ p - Polynomial.C f)), hroot A f]
    show _ - algebraMap k _ a = 0
    rw [AdjoinRoot.algebraMap_eq', RingHom.comp_apply, ← map_pow, ← map_add, ← map_sub, hf,
      sub_add_cancel, sub_self, map_zero]
  obtain ⟨g₁, hg₁of, hg₁root⟩ : ∃ g₁ : AdjoinRoot (Polynomial.X ^ p - Polynomial.C a) →ₐ[k]
      AdjoinRoot (Polynomial.X ^ p - Polynomial.C f),
      (∀ c, g₁ (AdjoinRoot.of _ c) = AdjoinRoot.of _ (algebraMap k A c)) ∧
        g₁ (AdjoinRoot.root _) = AdjoinRoot.root _ + AdjoinRoot.of _ γ := by
    refine ⟨AdjoinRoot.liftAlgHom _ _ _ hev', fun c => ?_, AdjoinRoot.liftAlgHom_root _ _ _ hev'⟩
    rw [AdjoinRoot.liftAlgHom_of, Algebra.ofId_apply, AdjoinRoot.algebraMap_eq', RingHom.comp_apply]
  obtain ⟨ψ, hψ⟩ : ∃ ψ : TensorProduct k (AdjoinRoot (Polynomial.X ^ p - Polynomial.C a)) A →+*
      AdjoinRoot (Polynomial.X ^ p - Polynomial.C f),
      ∀ x y, ψ (TensorProduct.tmul k x y) = g₁ x * AdjoinRoot.of _ y := by
    refine ⟨(Algebra.TensorProduct.productMap g₁
      (IsScalarTower.toAlgHom k A (AdjoinRoot (Polynomial.X ^ p - Polynomial.C f)))).toRingHom,
      fun x y => ?_⟩
    show Algebra.TensorProduct.productMap _ _ _ = _
    rw [Algebra.TensorProduct.productMap_apply_tmul, IsScalarTower.toAlgHom_apply,
      AdjoinRoot.algebraMap_eq]
  have hleft : ∀ r, ψ (φ r) = r := by
    have key : ψ.comp φ = RingHom.id _ := by
      apply AdjoinRoot.ringHom_ext
      · ext x
        simp only [RingHom.comp_apply, RingHom.id_apply, hφof,
          Algebra.TensorProduct.includeRight_apply, hψ, map_one, one_mul]
      · simp only [RingHom.comp_apply, RingHom.id_apply, hφroot, ht_def, map_sub, hψ, map_one,
          mul_one, one_mul, hg₁root, add_sub_cancel_right]
    intro r
    exact DFunLike.congr_fun key r
  have hg₁φ : ∀ x, φ (g₁ x) = TensorProduct.tmul k x (1 : A) := by
    have key : φ.comp (g₁ : AdjoinRoot (Polynomial.X ^ p - Polynomial.C a) →+*
        AdjoinRoot (Polynomial.X ^ p - Polynomial.C f)) =
        Algebra.TensorProduct.includeLeftRingHom := by
      apply AdjoinRoot.ringHom_ext
      · ext c
        simp only [RingHom.comp_apply, RingHom.coe_coe, hg₁of, hφof,
          Algebra.TensorProduct.includeRight_apply, Algebra.TensorProduct.includeLeftRingHom_apply]
        rw [h3]
      · simp only [RingHom.comp_apply, RingHom.coe_coe, hg₁root, map_add, hφroot, hφof,
          Algebra.TensorProduct.includeRight_apply, Algebra.TensorProduct.includeLeftRingHom_apply]
        exact htadd
    intro x
    have := DFunLike.congr_fun key x
    simpa only [RingHom.comp_apply, RingHom.coe_coe,
      Algebra.TensorProduct.includeLeftRingHom_apply] using this
  have hright : ∀ b, φ (ψ b) = b := by
    intro b
    induction b using TensorProduct.induction_on with
    | zero => rw [map_zero, map_zero]
    | tmul x y =>
      rw [hψ, map_mul, hg₁φ, hφof, Algebra.TensorProduct.includeRight_apply,
        Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
    | add x y hx hy => rw [map_add, map_add, hx, hy]
  intro b
  rcases subsingleton_or_nontrivial A with hA | hA
  · have : Subsingleton (TensorProduct k (AdjoinRoot (Polynomial.X ^ p - Polynomial.C a)) A) := by
      apply subsingleton_of_zero_eq_one
      rw [← map_zero (Algebra.TensorProduct.includeRight : A →ₐ[k]
          TensorProduct k (AdjoinRoot (Polynomial.X ^ p - Polynomial.C a)) A),
        ← map_one (Algebra.TensorProduct.includeRight : A →ₐ[k]
          TensorProduct k (AdjoinRoot (Polynomial.X ^ p - Polynomial.C a)) A),
        Subsingleton.elim (0 : A) 1]
    exact ⟨0, Subsingleton.elim _ _, fun _ _ => Subsingleton.elim _ _⟩
  · have hm := Polynomial.monic_X_pow_sub_C f hp.ne_zero
    have hdim : (AdjoinRoot.powerBasis' hm).dim = p := by
      rw [AdjoinRoot.powerBasis'_dim, Polynomial.natDegree_X_pow_sub_C]
    obtain ⟨bD, hb⟩ : ∃ bD : Module.Basis (Fin p) A (AdjoinRoot (Polynomial.X ^ p - Polynomial.C f)),
        ∀ i : Fin p, bD i = AdjoinRoot.root (Polynomial.X ^ p - Polynomial.C f) ^ (i : ℕ) := by
      refine ⟨(AdjoinRoot.powerBasis' hm).basis.reindex (finCongr hdim), fun i => ?_⟩
      rw [Module.Basis.reindex_apply, PowerBasis.coe_basis, AdjoinRoot.powerBasis'_gen]
      rfl
    have hsum : ∀ c : Fin p → A, φ (∑ i, c i • bD i) =
        ∑ i, Algebra.TensorProduct.includeRight (c i) * t ^ (i : ℕ) := by
      intro c
      rw [map_sum]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [hb, Algebra.smul_def, AdjoinRoot.algebraMap_eq, map_mul, map_pow, hφof, hφroot]
    refine ⟨bD.repr (ψ b), ?_, fun c hc => ?_⟩
    · show b = ∑ i, Algebra.TensorProduct.includeRight (bD.repr (ψ b) i) * t ^ (i : ℕ)
      rw [← hsum, bD.sum_repr, hright]
    · have hc' : b = ∑ i, Algebra.TensorProduct.includeRight (c i) * t ^ (i : ℕ) := hc
      have h1 : ∑ i, c i • bD i = ψ b := by
        rw [hc', ← hsum, hleft]
      rw [← h1, Module.Basis.repr_sum_self]

theorem wc_pfc_p_gdi_integral_dim_le : ∀ (A B : Type u) [CommRing A] [CommRing B] [Algebra A B] [Algebra.IsIntegral A B], ringKrullDim B ≤ ringKrullDim A :=
by
  intro A B _ _ _ _
  unfold ringKrullDim
  apply Order.krullDim_le_of_strictMono (PrimeSpectrum.comap (algebraMap A B))
  intro P Q hPQ
  have h : P.asIdeal < Q.asIdeal := hPQ
  have h2 := Ideal.IsIntegral.under_lt_under (R := A) h
  exact h2

theorem wc_pfc_p_gdi_embdim_contradiction : ∀ (p : ℕ) [Fact p.Prime] (A : Type u) [CommRing A] [IsNoetherianRing A] [IsRegularLocalRing A] (B : Type u) [CommRing B] [IsNoetherianRing B] [IsRegularLocalRing B] [Algebra A B] (f : A) (t : B), f ∈ IsLocalRing.maximalIdeal A → t ^ p = algebraMap A B f → (∀ b : B, ∃! c : Fin p → A, b = ∑ i, algebraMap A B (c i) * t ^ (i : ℕ)) → ringKrullDim B ≤ ringKrullDim A → f ∉ IsLocalRing.maximalIdeal A ^ 2 :=
by
  intro p _ A _ _ _ B _ _ _ _ f t hf ht hbasis hdim hf2
  classical
  have hp : p.Prime := Fact.out
  obtain ⟨q, rfl⟩ : ∃ q, p = q + 1 + 1 := ⟨p - 2, by have := hp.two_le; omega⟩

  have hcard : ∀ (R : Type u) [CommRing R] [IsLocalRing R] [IsNoetherianRing R] (N : ℕ)
      (y : Fin N → R), (∀ i, y i ∈ IsLocalRing.maximalIdeal R) →
      (∀ c : Fin N → R, ∑ i, c i * y i ∈ IsLocalRing.maximalIdeal R ^ 2 →
        ∀ i, c i ∈ IsLocalRing.maximalIdeal R) →
      N ≤ Submodule.spanFinrank (IsLocalRing.maximalIdeal R) := by
    intro R _ _ _ N y hy hind
    rw [IsLocalRing.spanFinrank_maximalIdeal_eq_finrank_cotangentSpace R]
    let v : Fin N → IsLocalRing.CotangentSpace R :=
      fun i => (IsLocalRing.maximalIdeal R).toCotangent ⟨y i, hy i⟩
    have hli : LinearIndependent (IsLocalRing.ResidueField R) v := by
      rw [Fintype.linearIndependent_iff]
      intro g hg
      choose c hc using fun i => IsLocalRing.residue_surjective (g i)
      have hsmul : ∀ i, g i • v i =
          (IsLocalRing.maximalIdeal R).toCotangent
            (c i • (⟨y i, hy i⟩ : IsLocalRing.maximalIdeal R)) := by
        intro i
        rw [map_smul, ← hc i, ← IsLocalRing.ResidueField.algebraMap_eq, algebraMap_smul]
      simp only [hsmul] at hg
      rw [← map_sum, Ideal.toCotangent_eq_zero] at hg
      have hz : ((∑ i, c i • (⟨y i, hy i⟩ : IsLocalRing.maximalIdeal R) :
          IsLocalRing.maximalIdeal R) : R) = ∑ i, c i * y i := by
        rw [Submodule.coe_sum]
        rfl
      rw [hz] at hg
      intro i
      rw [← hc i]
      exact (IsLocalRing.residue_eq_zero_iff _).mpr (hind c hg i)
    have := hli.fintype_card_le_finrank
    simpa using this

  let Φ : (Fin (q + 1 + 1) → A) →ₗ[A] B :=
    Fintype.linearCombination A (fun i : Fin (q + 1 + 1) => t ^ (i : ℕ))
  have hΦ : ∀ c, Φ c = ∑ i, algebraMap A B (c i) * t ^ (i : ℕ) := by
    intro c
    simp only [Φ, Fintype.linearCombination_apply, Algebra.smul_def]
  have hbij : Function.Bijective Φ := by
    constructor
    · intro c c' h
      obtain ⟨c0, _, huniq⟩ := hbasis (Φ c)
      have e1 := huniq c (hΦ c)
      have e2 := huniq c' (by rw [h, hΦ c'])
      rw [e1, e2]
    · intro b
      obtain ⟨c, hc, _⟩ := hbasis b
      exact ⟨c, by rw [hΦ, ← hc]⟩
  obtain ⟨κ, hsymm⟩ : ∃ κ : B ≃ₗ[A] (Fin (q + 1 + 1) → A),
      ∀ c, κ.symm c = ∑ i, algebraMap A B (c i) * t ^ (i : ℕ) :=
    ⟨(LinearEquiv.ofBijective Φ hbij).symm, fun c => by
      rw [LinearEquiv.symm_symm, LinearEquiv.ofBijective_apply]; exact hΦ c⟩

  have hi : ∀ a : A, κ (algebraMap A B a) = Pi.single 0 a := by
    intro a
    apply κ.symm.injective
    rw [LinearEquiv.symm_apply_apply, hsymm, Fin.sum_univ_succ]
    simp [Pi.single_apply]
  have hshift : ∀ b : B, κ (t * b) = (Fin.cons (f * κ b (Fin.last (q + 1)))
      (fun j : Fin (q + 1) => κ b j.castSucc) : Fin (q + 1 + 1) → A) := by
    intro b
    apply κ.symm.injective
    rw [LinearEquiv.symm_apply_apply, hsymm]
    conv_lhs => rw [← κ.symm_apply_apply b, hsymm]
    conv_lhs => rw [Fin.sum_univ_castSucc]
    conv_rhs => rw [Fin.sum_univ_succ]
    simp only [Fin.cons_zero, Fin.cons_succ, Fin.coe_castSucc, Fin.val_succ, Fin.val_last,
      Fin.val_zero, pow_zero, mul_one, map_mul]
    rw [mul_add, Finset.mul_sum, ← ht]
    have hsum : ∑ j : Fin (q + 1), t * (algebraMap A B (κ b j.castSucc) * t ^ (j : ℕ)) =
        ∑ j : Fin (q + 1), algebraMap A B (κ b j.castSucc) * t ^ ((j : ℕ) + 1) :=
      Finset.sum_congr rfl (fun j _ => by ring)
    rw [hsum]
    ring
  have h0 : ∀ b : B, κ (t * b) 0 = f * κ b (Fin.last (q + 1)) := by
    intro b; rw [hshift]; simp
  have h1 : ∀ b : B, κ (t * b) (0 : Fin (q + 1)).succ = κ b 0 := by
    intro b; rw [hshift]; simp
  have hsplit : ∀ b : B, ∃ w : B, b = algebraMap A B (κ b 0) + t * w := by
    intro b
    refine ⟨κ.symm (Fin.snoc (α := fun _ => A) (fun j : Fin (q + 1) => κ b j.succ) 0), ?_⟩
    apply κ.injective
    rw [map_add, hi, hshift, LinearEquiv.apply_symm_apply]
    funext i
    refine Fin.cases ?_ (fun j => ?_) i
    · simp
    · simp [Pi.single_apply]

  have hκ1 : κ 1 0 = 1 := by
    have := hi 1
    rw [map_one] at this
    rw [this, Pi.single_eq_same]
  have hmulalg : ∀ (a : A) (u : B), κ (algebraMap A B a * u) = a • κ u := by
    intro a u; rw [← Algebra.smul_def, map_smul]
  have halgmem : ∀ a : A, algebraMap A B a ∈ IsLocalRing.maximalIdeal B ↔
      a ∈ IsLocalRing.maximalIdeal A := by
    intro a
    constructor
    · intro h
      by_contra ha
      exact IsLocalRing.notMem_maximalIdeal.mpr
        ((IsLocalRing.notMem_maximalIdeal.mp ha).map (algebraMap A B)) h
    · intro ha
      by_contra h
      obtain ⟨u, hu⟩ := (IsLocalRing.notMem_maximalIdeal.mp h).exists_right_inv
      have e := congrArg (fun x => κ x 0) hu
      simp only [hmulalg, Pi.smul_apply, smul_eq_mul, hκ1] at e
      exact IsLocalRing.notMem_maximalIdeal.mpr (isUnit_iff_exists_inv.mpr ⟨_, e⟩) ha
  have htm : t ∈ IsLocalRing.maximalIdeal B := by
    by_contra h
    obtain ⟨u, hu⟩ := (IsLocalRing.notMem_maximalIdeal.mp h).exists_right_inv
    have e := congrArg (fun x => κ x 0) hu
    simp only [h0, hκ1] at e
    exact IsLocalRing.notMem_maximalIdeal.mpr (isUnit_iff_exists_inv.mpr ⟨_, e⟩) hf
  have hiff : ∀ b : B, b ∈ IsLocalRing.maximalIdeal B ↔ κ b 0 ∈ IsLocalRing.maximalIdeal A := by
    intro b
    obtain ⟨w, hw⟩ := hsplit b
    have htw : t * w ∈ IsLocalRing.maximalIdeal B :=
      (IsLocalRing.maximalIdeal B).mul_mem_right w htm
    constructor
    · intro hb
      rw [← halgmem]
      have e : algebraMap A B (κ b 0) = b - t * w := eq_sub_of_add_eq hw.symm
      rw [e]
      exact (IsLocalRing.maximalIdeal B).sub_mem hb htw
    · intro h
      have := (IsLocalRing.maximalIdeal B).add_mem ((halgmem _).mpr h) htw
      rwa [← hw] at this

  have hsq : ∀ z ∈ IsLocalRing.maximalIdeal B ^ 2, κ z 0 ∈ IsLocalRing.maximalIdeal A ^ 2 ∧
      κ z (0 : Fin (q + 1)).succ ∈ IsLocalRing.maximalIdeal A := by
    intro z hz
    rw [sq] at hz
    refine Submodule.mul_induction_on (C := fun z => κ z 0 ∈ IsLocalRing.maximalIdeal A ^ 2 ∧
      κ z (0 : Fin (q + 1)).succ ∈ IsLocalRing.maximalIdeal A) hz ?_ ?_
    · intro m hm n hn
      beta_reduce
      obtain ⟨w, hw⟩ := hsplit m
      have ha : κ m 0 ∈ IsLocalRing.maximalIdeal A := (hiff m).mp hm
      have hmn' := congrArg (· * n) hw
      have hmn : m * n = algebraMap A B (κ m 0) * n + t * (w * n) := by
        calc m * n = (algebraMap A B (κ m 0) + t * w) * n := by rw [← hw]
          _ = _ := by ring
      have e0 : κ (m * n) 0 = κ m 0 * κ n 0 + f * κ (w * n) (Fin.last (q + 1)) := by
        rw [hmn, map_add, Pi.add_apply, hmulalg, Pi.smul_apply, smul_eq_mul, h0]
      have e1 : κ (m * n) (0 : Fin (q + 1)).succ = κ m 0 * κ n (0 : Fin (q + 1)).succ +
          κ (w * n) 0 := by
        rw [hmn, map_add, Pi.add_apply, hmulalg, Pi.smul_apply, smul_eq_mul, h1]
      have hn0 := (hiff n).mp hn
      have hwn : κ (w * n) 0 ∈ IsLocalRing.maximalIdeal A :=
        (hiff _).mp ((IsLocalRing.maximalIdeal B).mul_mem_left w hn)
      constructor
      · rw [e0]
        refine Ideal.add_mem _ ?_ ?_
        · rw [sq]; exact Ideal.mul_mem_mul ha hn0
        · exact (IsLocalRing.maximalIdeal A ^ 2).mul_mem_right _ hf2
      · rw [e1]
        exact Ideal.add_mem _ ((IsLocalRing.maximalIdeal A).mul_mem_right _ ha) hwn
    · rintro x y ⟨hx0, hx1⟩ ⟨hy0, hy1⟩
      simp only [map_add, Pi.add_apply]
      exact ⟨Ideal.add_mem _ hx0 hy0, Ideal.add_mem _ hx1 hy1⟩

  obtain ⟨d, ⟨bA⟩⟩ : ∃ d, Nonempty (Module.Basis (Fin d) (IsLocalRing.ResidueField A)
      (IsLocalRing.CotangentSpace A)) := ⟨_, ⟨Module.finBasis _ _⟩⟩
  have hdA : Submodule.spanFinrank (IsLocalRing.maximalIdeal A) = d := by
    rw [IsLocalRing.spanFinrank_maximalIdeal_eq_finrank_cotangentSpace A,
      Module.finrank_eq_card_basis bA, Fintype.card_fin]
  choose y hy using fun i : Fin d => (IsLocalRing.maximalIdeal A).toCotangent_surjective (bA i)
  have hindA : ∀ c : Fin d → A, ∑ i, c i * (y i : A) ∈ IsLocalRing.maximalIdeal A ^ 2 →
      ∀ i, c i ∈ IsLocalRing.maximalIdeal A := by
    intro c hc
    have hz : ((∑ i, c i • y i : IsLocalRing.maximalIdeal A) : A) = ∑ i, c i * (y i : A) := by
      rw [Submodule.coe_sum]
      rfl
    rw [← hz, ← Ideal.toCotangent_eq_zero, map_sum] at hc
    simp only [map_smul, hy] at hc
    have hc' : ∑ i, IsLocalRing.residue A (c i) • bA i = 0 := by
      rw [← hc]
      apply Finset.sum_congr rfl
      intro i _
      rw [← IsLocalRing.ResidueField.algebraMap_eq, algebraMap_smul]
    have := Fintype.linearIndependent_iff.mp bA.linearIndependent _ hc'
    intro i
    exact (IsLocalRing.residue_eq_zero_iff _).mp (this i)

  obtain ⟨Y, hYc, hYl⟩ : ∃ Y : Fin (d + 1) → B,
      (∀ i, Y i.castSucc = algebraMap A B (y i : A)) ∧ Y (Fin.last d) = t :=
    ⟨Fin.snoc (α := fun _ => B) (fun i => algebraMap A B (y i : A)) t,
      fun i => by simp, by simp⟩
  have hYmem : ∀ j, Y j ∈ IsLocalRing.maximalIdeal B := by
    intro j
    refine Fin.lastCases ?_ (fun i => ?_) j
    · rw [hYl]; exact htm
    · rw [hYc]; exact (halgmem _).mpr (y i).2
  have hYind : ∀ C : Fin (d + 1) → B, ∑ j, C j * Y j ∈ IsLocalRing.maximalIdeal B ^ 2 →
      ∀ j, C j ∈ IsLocalRing.maximalIdeal B := by
    intro C hC
    rw [Fin.sum_univ_castSucc] at hC
    simp only [hYc, hYl] at hC
    obtain ⟨hz0, hz1⟩ := hsq _ hC
    have hk : ∀ k : Fin (q + 1 + 1),
        κ (∑ i, C i.castSucc * algebraMap A B (y i : A) + C (Fin.last d) * t) k =
        ∑ i, (y i : A) * κ (C i.castSucc) k + κ (t * C (Fin.last d)) k := by
      intro k
      rw [map_add, map_sum, mul_comm (C (Fin.last d)) t]
      simp only [Pi.add_apply, Finset.sum_apply]
      congr 1
      apply Finset.sum_congr rfl
      intro i _
      rw [mul_comm, hmulalg, Pi.smul_apply, smul_eq_mul]
    rw [hk, h0] at hz0
    rw [hk, h1] at hz1
    have hs0 : ∑ i, κ (C i.castSucc) 0 * (y i : A) ∈ IsLocalRing.maximalIdeal A ^ 2 := by
      have := (IsLocalRing.maximalIdeal A ^ 2).sub_mem hz0
        ((IsLocalRing.maximalIdeal A ^ 2).mul_mem_right (κ (C (Fin.last d)) (Fin.last (q + 1))) hf2)
      rw [add_sub_cancel_right] at this
      rw [show ∑ i, κ (C i.castSucc) 0 * (y i : A) = ∑ i, (y i : A) * κ (C i.castSucc) 0 from
        Finset.sum_congr rfl (fun i _ => mul_comm _ _)]
      exact this
    have hcast := hindA (fun i => κ (C i.castSucc) 0) hs0
    have hsum1 : ∑ i, (y i : A) * κ (C i.castSucc) (0 : Fin (q + 1)).succ ∈
        IsLocalRing.maximalIdeal A :=
      Ideal.sum_mem _ (fun i _ => (IsLocalRing.maximalIdeal A).mul_mem_right _ (y i).2)
    have hs1 : κ (C (Fin.last d)) 0 ∈ IsLocalRing.maximalIdeal A := by
      have := (IsLocalRing.maximalIdeal A).sub_mem hz1 hsum1
      rwa [add_sub_cancel_left] at this
    intro j
    refine Fin.lastCases ?_ (fun i => ?_) j
    · exact (hiff _).mpr hs1
    · exact (hiff _).mpr (hcast i)
  have hB := hcard B (d + 1) Y hYmem hYind

  have hAr := IsRegularLocalRing.spanFinrank_maximalIdeal (R := A)
  have hBr := IsRegularLocalRing.spanFinrank_maximalIdeal (R := B)
  have hle : (Submodule.spanFinrank (IsLocalRing.maximalIdeal B) : WithBot ℕ∞) ≤
      (Submodule.spanFinrank (IsLocalRing.maximalIdeal A) : WithBot ℕ∞) := by
    rw [hAr, hBr]; exact hdim
  have hle' : Submodule.spanFinrank (IsLocalRing.maximalIdeal B) ≤
      Submodule.spanFinrank (IsLocalRing.maximalIdeal A) := by
    exact_mod_cast hle
  omega

theorem wc_pfc_p_gdi_conormal_derivation : ∀ (p : ℕ) [Fact p.Prime] (A : Type u) [CommRing A] [IsLocalRing A] [CharP A p] (f : A), f ∈ IsLocalRing.maximalIdeal A → f ∉ IsLocalRing.maximalIdeal A ^ 2 → ∃ E : Derivation ℤ A (IsLocalRing.ResidueField A), E f = 1 :=
by
  classical
  intro p hpf A _ _ _ f hfm hf2
  have hp : p.Prime := hpf.out
  have hp0 : p ≠ 0 := hp.ne_zero
  have hp2 : 2 ≤ p := hp.two_le
  haveI hKp : CharP (IsLocalRing.ResidueField A) p := by
    rw [CharP.charP_iff_prime_eq_zero hp, ← map_natCast (IsLocalRing.residue A),
      CharP.cast_eq_zero, map_zero]

  have F1 : ∀ (L : Subring (IsLocalRing.ResidueField A)),
      (∀ c : IsLocalRing.ResidueField A, c ^ p ∈ L) → ∀ x : IsLocalRing.ResidueField A, x ∉ L →
      ∀ Q : Polynomial (IsLocalRing.ResidueField A), (∀ i, Q.coeff i ∈ L) →
      Q.degree < p → Q.eval x = 0 → Q = 0 := by
    intro L hL x hx Q hQ hdeg hev
    have hinv : ∀ y ∈ L.carrier, y⁻¹ ∈ L.carrier := by
      intro y hy
      by_cases h0 : y = 0
      · rw [h0, inv_zero]; exact L.zero_mem
      · have e : y⁻¹ = y ^ (p - 1) * (y⁻¹) ^ p := by
          rw [inv_pow, ← pow_sub_one_mul hp0 y, mul_inv, ← mul_assoc,
            mul_inv_cancel₀ (pow_ne_zero _ h0), one_mul]
        rw [e]; exact L.mul_mem (L.pow_mem hy _) (hL _)
    let F : Subfield (IsLocalRing.ResidueField A) := Subfield.mk L hinv
    have ha : x ^ p ∈ F := hL x
    have hnp : ∀ b : F, b ^ p ≠ ⟨x ^ p, ha⟩ := by
      intro b hb
      have h1 : (b : IsLocalRing.ResidueField A) ^ p = x ^ p := by
        have := congrArg Subtype.val hb
        simpa using this
      have h2 : ((b : IsLocalRing.ResidueField A) - x) ^ p = 0 := by
        rw [sub_pow_char, h1, sub_self]
      have h3 : (b : IsLocalRing.ResidueField A) = x := sub_eq_zero.mp ((pow_eq_zero_iff hp0).mp h2)
      exact hx (h3 ▸ b.2)
    have hirr : Irreducible (Polynomial.X ^ p - Polynomial.C (⟨x ^ p, ha⟩ : F)) :=
      X_pow_sub_C_irreducible_of_prime hp hnp
    have hmon : (Polynomial.X ^ p - Polynomial.C (⟨x ^ p, ha⟩ : F)).Monic :=
      Polynomial.monic_X_pow_sub_C _ hp0
    have hroot : Polynomial.aeval x (Polynomial.X ^ p - Polynomial.C (⟨x ^ p, ha⟩ : F)) = 0 := by
      simp only [map_sub, map_pow, Polynomial.aeval_X, Polynomial.aeval_C]
      rw [sub_eq_zero]; rfl
    have hmin := minpoly.eq_of_irreducible_of_monic hirr hroot hmon
    have hmindeg : (minpoly F x).degree = p := by
      rw [← hmin, Polynomial.degree_X_pow_sub_C (Nat.pos_of_ne_zero hp0)]
    have hlift : Q ∈ Polynomial.lifts F.subtype := by
      rw [Polynomial.lifts_iff_coeff_lifts]
      intro n
      exact ⟨⟨Q.coeff n, hQ n⟩, rfl⟩
    obtain ⟨q, hq⟩ := (Polynomial.mem_lifts Q).mp hlift
    have hqdeg : q.degree = Q.degree := by rw [← hq, Polynomial.degree_map]
    have hqx : Polynomial.aeval x q = 0 := by
      rw [Polynomial.aeval_def, ← hev, ← hq, Polynomial.eval_map]; rfl
    by_contra hQ0
    have hq0 : q ≠ 0 := by rintro rfl; apply hQ0; rw [← hq, Polynomial.map_zero]
    have := minpoly.degree_le_of_ne_zero F x hq0 hqx
    rw [hmindeg, hqdeg] at this
    exact absurd (lt_of_le_of_lt this hdeg) (lt_irrefl _)
  have hres0 : ∀ a : A, IsLocalRing.residue A a = 0 ↔ a ∈ IsLocalRing.maximalIdeal A :=
    fun a => IsLocalRing.residue_eq_zero_iff a

  let S : Set (Subring A) := {R | (∀ a : A, a ^ p ∈ R) ∧
    ∀ r ∈ R, r ∈ IsLocalRing.maximalIdeal A → r ∈ IsLocalRing.maximalIdeal A ^ 2}
  have hpow2 : ∀ a ∈ IsLocalRing.maximalIdeal A, a ^ p ∈ IsLocalRing.maximalIdeal A ^ 2 :=
    fun a ha => Ideal.pow_le_pow_right hp2 (Ideal.pow_mem_pow ha p)
  haveI : ExpChar A p := ExpChar.prime hp
  have hseed : (frobenius A p).range ∈ S := by
    refine ⟨fun a => ⟨a, frobenius_def p a⟩, ?_⟩
    rintro r ⟨a, rfl⟩ hr
    rw [frobenius_def] at hr ⊢
    exact hpow2 a ((Ideal.IsMaximal.isPrime inferInstance).mem_of_pow_mem p hr)
  have hchain : ∀ c ⊆ S, IsChain (· ≤ ·) c → ∀ y ∈ c, ∃ ub ∈ S, ∀ z ∈ c, z ≤ ub := by
    intro c hcS hc y hy
    refine ⟨sSup c, ⟨fun a => le_sSup hy ((hcS hy).1 a), fun r hr hrm => ?_⟩,
      fun z hz => le_sSup hz⟩
    obtain ⟨s, hs, hrs⟩ := (Subring.mem_sSup_of_directedOn ⟨y, hy⟩ hc.directedOn).mp hr
    exact (hcS hs).2 r hrs hrm
  obtain ⟨M, -, hM⟩ := zorn_le_nonempty₀ S hchain _ hseed
  obtain ⟨hMp, hMm⟩ := hM.prop

  have hsurj : ∀ a : A, ∃ s ∈ M, IsLocalRing.residue A s = IsLocalRing.residue A a := by
    intro ξ
    by_contra hcon
    push_neg at hcon
    let ev := Polynomial.eval₂RingHom M.subtype ξ
    have hMM' : M ≤ ev.range := fun r hr => ⟨Polynomial.C ⟨r, hr⟩, by simp [ev]⟩
    have hξ : ξ ∈ ev.range := ⟨Polynomial.X, by simp [ev]⟩
    have hM'S : ev.range ∈ S := by
      refine ⟨fun a => hMM' (hMp a), ?_⟩
      rintro z ⟨P, rfl⟩ hz
      have hqm : (Polynomial.X ^ p - Polynomial.C (⟨ξ ^ p, hMp ξ⟩ : M)).Monic :=
        Polynomial.monic_X_pow_sub_C _ hp0
      have hqev : ev (Polynomial.X ^ p - Polynomial.C (⟨ξ ^ p, hMp ξ⟩ : M)) = 0 := by
        simp [ev]
      have hPR : ev P = ev (P %ₘ (Polynomial.X ^ p - Polynomial.C (⟨ξ ^ p, hMp ξ⟩ : M))) := by
        conv_lhs => rw [← Polynomial.modByMonic_add_div P
          (Polynomial.X ^ p - Polynomial.C (⟨ξ ^ p, hMp ξ⟩ : M))]
        rw [map_add, map_mul, hqev, zero_mul, add_zero]
      have hRdeg : (P %ₘ (Polynomial.X ^ p - Polynomial.C (⟨ξ ^ p, hMp ξ⟩ : M))).degree < p := by
        have := Polynomial.degree_modByMonic_lt P hqm
        rwa [Polynomial.degree_X_pow_sub_C (Nat.pos_of_ne_zero hp0)] at this
      set R := P %ₘ (Polynomial.X ^ p - Polynomial.C (⟨ξ ^ p, hMp ξ⟩ : M)) with hR
      have hQ0 : R.map ((IsLocalRing.residue A).comp M.subtype) = 0 := by
        apply F1 (M.map (IsLocalRing.residue A)) ?_ (IsLocalRing.residue A ξ) ?_ _ ?_ ?_ ?_
        · intro c
          obtain ⟨a, rfl⟩ := IsLocalRing.residue_surjective c
          exact ⟨a ^ p, hMp a, by simp⟩
        · rintro ⟨s, hs, hsξ⟩
          exact hcon s hs hsξ
        · intro i
          rw [Polynomial.coeff_map]
          exact ⟨(R.coeff i : A), (R.coeff i).2, rfl⟩
        · exact lt_of_le_of_lt Polynomial.degree_map_le hRdeg
        · rw [Polynomial.eval_map, ← Polynomial.hom_eval₂]
          rw [hres0]
          have : R.eval₂ M.subtype ξ = ev P := hPR.symm
          rw [this]
          exact hz
      have hcoef : ∀ i, ((R.coeff i : M) : A) ∈ IsLocalRing.maximalIdeal A ^ 2 := by
        intro i
        apply hMm _ (R.coeff i).2
        rw [← hres0]
        have := congrArg (fun Q => Q.coeff i) hQ0
        simpa [Polynomial.coeff_map] using this
      show ev P ∈ IsLocalRing.maximalIdeal A ^ 2
      rw [hPR]
      show R.eval₂ M.subtype ξ ∈ IsLocalRing.maximalIdeal A ^ 2
      rw [Polynomial.eval₂_eq_sum_range]
      exact Ideal.sum_mem _ (fun i _ => Ideal.mul_mem_right _ _ (hcoef i))
    exact hcon ξ (hM.2 hM'S hMM' hξ) rfl

  choose σ hσM hσres using hsurj
  have hσd : ∀ a, a - σ a ∈ IsLocalRing.maximalIdeal A := fun a => by
    rw [← hres0, map_sub, hσres, sub_self]
  have hMm2 : ∀ r ∈ M, IsLocalRing.residue A r = 0 → r ∈ IsLocalRing.maximalIdeal A ^ 2 :=
    fun r hr h => hMm r hr ((hres0 r).mp h)
  have hv0 : (IsLocalRing.maximalIdeal A).toCotangent ⟨f, hfm⟩ ≠ 0 := by
    rw [Ne, Ideal.toCotangent_eq_zero]; exact hf2
  obtain ⟨φ, hφ⟩ : ∃ φ : Module.Dual (IsLocalRing.ResidueField A) (IsLocalRing.CotangentSpace A),
      φ ((IsLocalRing.maximalIdeal A).toCotangent ⟨f, hfm⟩) ≠ 0 := by
    by_contra h
    push_neg at h
    exact hv0 ((Module.forall_dual_apply_eq_zero_iff _ _).mp h)
  set lam := (φ ((IsLocalRing.maximalIdeal A).toCotangent ⟨f, hfm⟩))⁻¹ • φ with hlam_def
  have hlam : lam ((IsLocalRing.maximalIdeal A).toCotangent ⟨f, hfm⟩) = 1 := by
    rw [hlam_def, LinearMap.smul_apply, smul_eq_mul, inv_mul_cancel₀ hφ]
  have hsmulA : ∀ (a : A) (v : IsLocalRing.CotangentSpace A),
      lam (a • v) = IsLocalRing.residue A a * lam v := by
    intro a v
    rw [← algebraMap_smul (IsLocalRing.ResidueField A) a v, map_smul, smul_eq_mul]
    rfl
  let g : A → IsLocalRing.ResidueField A :=
    fun a => lam ((IsLocalRing.maximalIdeal A).toCotangent ⟨a - σ a, hσd a⟩)
  have hadd : ∀ a b, g (a + b) = g a + g b := by
    intro a b
    simp only [g]
    rw [← map_add, ← map_add]
    congr 1
    rw [Ideal.toCotangent_eq]
    have e : ((⟨a + b - σ (a + b), hσd _⟩ : IsLocalRing.maximalIdeal A) : A) -
        ((⟨a - σ a, hσd a⟩ + ⟨b - σ b, hσd b⟩ : IsLocalRing.maximalIdeal A) : A) =
        σ a + σ b - σ (a + b) := by
      simp only [Submodule.coe_add]; ring
    rw [e]
    apply hMm2 _ (M.sub_mem (M.add_mem (hσM a) (hσM b)) (hσM _))
    rw [map_sub, map_add, hσres, hσres, hσres, map_add, sub_self]
  have hmul : ∀ a b, g (a * b) = IsLocalRing.residue A a * g b + IsLocalRing.residue A b * g a := by
    intro a b
    have e : (IsLocalRing.maximalIdeal A).toCotangent ⟨a * b - σ (a * b), hσd _⟩ =
        a • (IsLocalRing.maximalIdeal A).toCotangent ⟨b - σ b, hσd b⟩ +
        σ b • (IsLocalRing.maximalIdeal A).toCotangent ⟨a - σ a, hσd a⟩ := by
      rw [← map_smul, ← map_smul, ← map_add, Ideal.toCotangent_eq]
      have e2 : ((⟨a * b - σ (a * b), hσd _⟩ : IsLocalRing.maximalIdeal A) : A) -
          ((a • ⟨b - σ b, hσd b⟩ + σ b • ⟨a - σ a, hσd a⟩ : IsLocalRing.maximalIdeal A) : A) =
          σ a * σ b - σ (a * b) := by
        simp only [Submodule.coe_add, Submodule.coe_smul, smul_eq_mul]; ring
      rw [e2]
      apply hMm2 _ (M.sub_mem (M.mul_mem (hσM a) (hσM b)) (hσM _))
      rw [map_sub, map_mul, hσres, hσres, hσres, map_mul, sub_self]
    simp only [g]
    rw [e, map_add, hsmulA, hsmulA, hσres]
  have hgf : g f = 1 := by
    simp only [g]
    have e : (IsLocalRing.maximalIdeal A).toCotangent ⟨f - σ f, hσd f⟩ =
        (IsLocalRing.maximalIdeal A).toCotangent ⟨f, hfm⟩ := by
      rw [Ideal.toCotangent_eq]
      show f - σ f - f ∈ IsLocalRing.maximalIdeal A ^ 2
      have e3 : f - σ f - f = -σ f := by ring
      rw [e3]
      exact (IsLocalRing.maximalIdeal A ^ 2).neg_mem
        (hMm2 _ (hσM f) (by rw [hσres, (hres0 f).mpr hfm]))
    rw [e, hlam]
  let G : A →+ IsLocalRing.ResidueField A := AddMonoidHom.mk' g hadd
  refine ⟨Derivation.mk' G.toIntLinearMap (fun a b => ?_), ?_⟩
  · show g (a * b) = a • g b + b • g a
    rw [hmul, Algebra.smul_def, Algebra.smul_def]
    rfl
  · exact hgf

theorem wc_pfc_p_geomreg_diff_injective : ∀ (k : Type u) [Field k] (p : ℕ) [Fact p.Prime] [CharP k p] (Λ : Type u) [CommRing Λ] [IsNoetherianRing Λ] [Algebra k Λ], (∀ (L : Type u) [Field L] [Algebra k L] [FiniteDimensional k L] (𝔔 : Ideal (TensorProduct k L Λ)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) → ∀ (𝔮 : Ideal Λ) [𝔮.IsPrime] (r : ℕ) (c : Fin r → IsLocalRing.ResidueField (Localization.AtPrime 𝔮)) (a : Fin r → k), ∑ i, TensorProduct.tmul (Localization.AtPrime 𝔮) (c i) (KaehlerDifferential.D ℤ (Localization.AtPrime 𝔮) (algebraMap k (Localization.AtPrime 𝔮) (a i))) = 0 → ∑ i, TensorProduct.tmul k (c i) (KaehlerDifferential.D ℤ k (a i)) = 0 :=
by
  classical

  have conv : ∀ (A M : Type u) [CommRing A] [AddCommGroup M] [Module A M]
      (i1 i2 : Algebra ℤ A) (iM1 iM2 : Module ℤ M) (E : @Derivation ℤ A M _ _ _ i1 _ iM1),
      ∃ E' : @Derivation ℤ A M _ _ _ i2 _ iM2, ∀ x, E' x = E x := by
    intro A M _ _ _ i1 i2 iM1 iM2 E
    obtain rfl : i1 = i2 := Subsingleton.elim _ _
    obtain rfl : iM1 = iM2 := Subsingleton.elim _ _
    exact ⟨E, fun _ => rfl⟩
  have mkDer : ∀ (A M : Type u) [CommRing A] [AddCommGroup M] [Module A M] (iA : Algebra ℤ A)
      (iM : Module ℤ M) (g : A →+ M), (∀ x y, g (x * y) = x • g y + y • g x) →
      ∃ E : @Derivation ℤ A M _ _ _ iA _ iM, ∀ x, E x = g x := by
    intro A M _ _ _ iA iM g hg
    obtain rfl : iA = Ring.toIntAlgebra A := Subsingleton.elim _ _
    obtain rfl : iM = AddCommGroup.toIntModule M := Subsingleton.elim _ _
    refine ⟨Derivation.mk' { toFun := g, map_add' := g.map_add, map_smul' := ?_ } hg, fun x => rfl⟩
    intro n x
    simp only [RingHom.id_apply]
    rw [Algebra.smul_def, algebraMap_int_eq, eq_intCast, ← zsmul_eq_mul, map_zsmul]
  have killp : ∀ (p : ℕ) (A M : Type u) [CommRing A] [AddCommGroup M] [Module A M]
      (iA : Algebra ℤ A) (iM : Module ℤ M) (D : @Derivation ℤ A M _ _ _ iA _ iM) (x y : A),
      (∀ m : M, p • m = 0) → D (y ^ p) = 0 ∧ D (x + y ^ p) = D x := by
    intro p A M _ _ _ iA iM D x y hp
    obtain rfl : iA = Ring.toIntAlgebra A := Subsingleton.elim _ _
    obtain rfl : iM = AddCommGroup.toIntModule M := Subsingleton.elim _ _
    have h1 : D (y ^ p) = 0 := by rw [Derivation.leibniz_pow, hp]
    exact ⟨h1, by rw [map_add, h1, add_zero]⟩
  have leib : ∀ (K : Type u) [Field K] (D : Derivation ℤ K K) (x y : K),
      D (x * y) = x * D y + y * D x := by
    intro K _ D x y
    rw [Derivation.leibniz, smul_eq_mul, smul_eq_mul]

  have s11 : ∀ (k : Type u) [Field k] (p : ℕ) [Fact p.Prime] [CharP k p] (Λ : Type u)
      [CommRing Λ] [IsNoetherianRing Λ] [Algebra k Λ],
      (∀ (L : Type u) [Field L] [Algebra k L] [FiniteDimensional k L]
        (𝔔 : Ideal (TensorProduct k L Λ)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) →
      ∀ (𝔮 : Ideal Λ) [𝔮.IsPrime] (a : k), (∃ D : Derivation ℤ k k, D a = 1) →
      ∃ E : Derivation ℤ (Localization.AtPrime 𝔮) (IsLocalRing.ResidueField (Localization.AtPrime 𝔮)),
        E (algebraMap k (Localization.AtPrime 𝔮) a) = 1 := by
    intro k _ p _ _ Λ _ _ _ hreg 𝔮 _ a hDex
    obtain ⟨D, hD⟩ := hDex
    have hp0 : (p : k) = 0 := CharP.cast_eq_zero k p
    have hnp : ∀ y : k, y ^ p ≠ a := by
      intro y hy
      have h1 := D.leibniz_pow y p
      rw [hy, hD, nsmul_eq_mul, hp0, zero_mul] at h1
      exact one_ne_zero h1
    haveI hA : CharP (Localization.AtPrime 𝔮) p :=
      charP_of_injective_ringHom (algebraMap k (Localization.AtPrime 𝔮)).injective p
    haveI hK : CharP (IsLocalRing.ResidueField (Localization.AtPrime 𝔮)) p :=
      charP_of_injective_ringHom ((IsLocalRing.residue (Localization.AtPrime 𝔮)).comp
        (algebraMap k (Localization.AtPrime 𝔮))).injective p
    by_cases hcase : ∀ z : IsLocalRing.ResidueField (Localization.AtPrime 𝔮),
        z ^ p ≠ IsLocalRing.residue (Localization.AtPrime 𝔮) (algebraMap k (Localization.AtPrime 𝔮) a)
    · obtain ⟨D₀, hD₀⟩ := wc_pfc_p_gdi_field_derivation p
        (IsLocalRing.ResidueField (Localization.AtPrime 𝔮)) _ hcase
      let g : Localization.AtPrime 𝔮 →+ IsLocalRing.ResidueField (Localization.AtPrime 𝔮) :=
        (D₀ : IsLocalRing.ResidueField (Localization.AtPrime 𝔮) →ₗ[ℤ]
          IsLocalRing.ResidueField (Localization.AtPrime 𝔮)).toAddMonoidHom.comp
          (IsLocalRing.residue (Localization.AtPrime 𝔮)).toAddMonoidHom
      have hg : ∀ x y, g (x * y) = x • g y + y • g x := by
        intro x y
        show D₀ (IsLocalRing.residue _ (x * y)) =
          IsLocalRing.residue _ x * D₀ (IsLocalRing.residue _ y) +
            IsLocalRing.residue _ y * D₀ (IsLocalRing.residue _ x)
        rw [map_mul]
        exact leib _ D₀ _ _
      obtain ⟨E2, hE2⟩ := mkDer (Localization.AtPrime 𝔮)
        (IsLocalRing.ResidueField (Localization.AtPrime 𝔮)) inferInstance inferInstance g hg
      refine ⟨E2, ?_⟩
      rw [hE2]
      exact hD₀
    · push_neg at hcase
      obtain ⟨z, hz⟩ := hcase
      obtain ⟨γ, hγ⟩ := IsLocalRing.residue_surjective z
      obtain ⟨f, hf⟩ : ∃ f : Localization.AtPrime 𝔮,
          f = algebraMap k (Localization.AtPrime 𝔮) a - γ ^ p := ⟨_, rfl⟩
      have hfm : f ∈ IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) := by
        rw [← IsLocalRing.residue_eq_zero_iff, hf, map_sub, map_pow, hγ, hz, sub_self]
      haveI : IsNoetherianRing (Localization.AtPrime 𝔮) :=
        IsLocalization.isNoetherianRing 𝔮.primeCompl _ inferInstance
      haveI hAreg : IsRegularLocalRing (Localization.AtPrime 𝔮) :=
        wc_pfc_cz_localization_regular k Λ hreg 𝔮
      have hirr : Irreducible (Polynomial.X ^ p - Polynomial.C a) :=
        X_pow_sub_C_irreducible_of_prime (Fact.out : p.Prime) hnp
      haveI : Fact (Irreducible (Polynomial.X ^ p - Polynomial.C a)) := ⟨hirr⟩
      haveI : FiniteDimensional k (AdjoinRoot (Polynomial.X ^ p - Polynomial.C a)) :=
        (AdjoinRoot.powerBasis' (Polynomial.monic_X_pow_sub_C a
          (Fact.out : p.Prime).ne_zero)).finite
      obtain ⟨t, ht, hbasis, hfrob⟩ := wc_pfc_p_gdi_root_basis p k (Localization.AtPrime 𝔮) a γ
      haveI hBreg := wc_pfc_p_gdi_insep_regular k p Λ hreg 𝔮
        (AdjoinRoot (Polynomial.X ^ p - Polynomial.C a)) hfrob
      letI iAB : Algebra (Localization.AtPrime 𝔮)
          (TensorProduct k (AdjoinRoot (Polynomial.X ^ p - Polynomial.C a)) (Localization.AtPrime 𝔮)) :=
        (Algebra.TensorProduct.includeRight : Localization.AtPrime 𝔮 →ₐ[k]
          TensorProduct k (AdjoinRoot (Polynomial.X ^ p - Polynomial.C a))
            (Localization.AtPrime 𝔮)).toRingHom.toAlgebra
      have ht' : t ^ p = algebraMap (Localization.AtPrime 𝔮)
          (TensorProduct k (AdjoinRoot (Polynomial.X ^ p - Polynomial.C a)) (Localization.AtPrime 𝔮)) f := by
        rw [hf]; exact ht
      have hbasis' : ∀ b : TensorProduct k (AdjoinRoot (Polynomial.X ^ p - Polynomial.C a))
          (Localization.AtPrime 𝔮), ∃! c : Fin p → Localization.AtPrime 𝔮,
          b = ∑ i, algebraMap (Localization.AtPrime 𝔮) (TensorProduct k
            (AdjoinRoot (Polynomial.X ^ p - Polynomial.C a)) (Localization.AtPrime 𝔮)) (c i) *
            t ^ (i : ℕ) := hbasis
      haveI hfin : Module.Finite (Localization.AtPrime 𝔮)
          (TensorProduct k (AdjoinRoot (Polynomial.X ^ p - Polynomial.C a))
            (Localization.AtPrime 𝔮)) := by
        refine Module.finite_def.mpr ⟨Finset.univ.image (fun i : Fin p => t ^ (i : ℕ)), ?_⟩
        refine eq_top_iff.mpr (fun b _ => ?_)
        obtain ⟨c', hc', -⟩ := hbasis' b
        rw [hc']
        refine Submodule.sum_mem _ (fun i _ => ?_)
        rw [← Algebra.smul_def]
        refine Submodule.smul_mem _ _ (Submodule.subset_span ?_)
        rw [Finset.coe_image]
        exact ⟨i, Finset.mem_coe.mpr (Finset.mem_univ i), rfl⟩
      haveI : Algebra.IsIntegral (Localization.AtPrime 𝔮)
          (TensorProduct k (AdjoinRoot (Polynomial.X ^ p - Polynomial.C a))
            (Localization.AtPrime 𝔮)) := Algebra.IsIntegral.of_finite _ _
      haveI : IsNoetherianRing (TensorProduct k (AdjoinRoot (Polynomial.X ^ p - Polynomial.C a))
            (Localization.AtPrime 𝔮)) :=
        isNoetherian_of_tower (Localization.AtPrime 𝔮) inferInstance
      have hdim := wc_pfc_p_gdi_integral_dim_le (Localization.AtPrime 𝔮)
        (TensorProduct k (AdjoinRoot (Polynomial.X ^ p - Polynomial.C a)) (Localization.AtPrime 𝔮))
      have hf2 := wc_pfc_p_gdi_embdim_contradiction p (Localization.AtPrime 𝔮)
        (TensorProduct k (AdjoinRoot (Polynomial.X ^ p - Polynomial.C a)) (Localization.AtPrime 𝔮))
        f t hfm ht' hbasis' hdim
      obtain ⟨E, hE⟩ := wc_pfc_p_gdi_conormal_derivation p (Localization.AtPrime 𝔮) f hfm hf2
      obtain ⟨E2, hE2⟩ := conv (Localization.AtPrime 𝔮)
        (IsLocalRing.ResidueField (Localization.AtPrime 𝔮)) _ inferInstance _ inferInstance E
      refine ⟨E2, ?_⟩
      have hsplit : algebraMap k (Localization.AtPrime 𝔮) a = f + γ ^ p := by
        rw [hf]; ring
      have hpK : ∀ m : IsLocalRing.ResidueField (Localization.AtPrime 𝔮), p • m = 0 := fun m => by
        rw [nsmul_eq_mul, CharP.cast_eq_zero, zero_mul]
      rw [hE2, hsplit, (killp p _ _ _ _ E f γ hpK).2, hE]

  intro k _ p _ _ Λ _ _ _ hreg 𝔮 _ r c a hsum
  have key : ∀ i : Algebra ℤ (Localization.AtPrime 𝔮),
      (letI := i; ∑ j, TensorProduct.tmul (Localization.AtPrime 𝔮) (c j)
        (KaehlerDifferential.D ℤ (Localization.AtPrime 𝔮)
          (algebraMap k (Localization.AtPrime 𝔮) (a j))) = 0) := by
    intro i
    obtain rfl : i = OreLocalization.instAlgebra := Subsingleton.elim _ _
    exact hsum
  refine wc_pfc_p_gdi_inj_of_dual_derivations k (Localization.AtPrime 𝔮) ?_ r c a (key _)

  intro s a' hdual j
  obtain ⟨k₁, _, _, _, D₁, hD₁, hroots⟩ := wc_pfc_p_gdi_root_field p k s a' hdual j
  haveI : CharP k₁ p := charP_of_injective_ringHom (algebraMap k k₁).injective p
  obtain ⟨hnoeth, hreg₁⟩ := wc_pfc_p_gdi_gr_basechange k k₁ Λ hreg
  haveI := hnoeth
  obtain ⟨𝔔, h𝔔, htrans⟩ := wc_pfc_p_gdi_derivation_transfer k k₁ Λ 𝔮
  haveI := h𝔔
  obtain ⟨E', hE'⟩ := s11 k₁ p (TensorProduct k k₁ Λ) hreg₁ 𝔔 (algebraMap k k₁ (a' j)) ⟨D₁, hD₁⟩
  haveI : CharP (IsLocalRing.ResidueField (Localization.AtPrime 𝔔)) p :=
    charP_of_injective_ringHom ((IsLocalRing.residue (Localization.AtPrime 𝔔)).comp
      (algebraMap k₁ (Localization.AtPrime 𝔔))).injective p
  have hpK' : ∀ m : IsLocalRing.ResidueField (Localization.AtPrime 𝔔), p • m = 0 := fun m => by
    rw [nsmul_eq_mul, CharP.cast_eq_zero, zero_mul]
  obtain ⟨E, hE⟩ := htrans E'
  obtain ⟨E2, hE2⟩ := conv (Localization.AtPrime 𝔮)
    (IsLocalRing.ResidueField (Localization.AtPrime 𝔮)) _ (Ring.toIntAlgebra _) _
    (AddCommGroup.toIntModule _) E
  refine ⟨E2, fun l => ?_⟩
  rw [hE2]
  by_cases hl : l = j
  · subst hl
    rw [if_pos rfl]
    exact (hE (a' l)).2 hE'
  · rw [if_neg hl]
    apply (hE (a' l)).1
    obtain ⟨y, hy⟩ := hroots l hl
    rw [← hy, map_pow]
    exact (killp p _ _ _ _ E' 0 _ hpK').1

theorem wc_pfc_p_kernel_finite : ∀ (k : Type u) [Field k] (Λ : Type u) [CommRing Λ] [IsNoetherianRing Λ] [Algebra k Λ] (𝔮 : Ideal Λ) [𝔮.IsPrime], (∀ (r : ℕ) (c : Fin r → IsLocalRing.ResidueField (Localization.AtPrime 𝔮)) (a : Fin r → k), ∑ i, TensorProduct.tmul (Localization.AtPrime 𝔮) (c i) (KaehlerDifferential.D ℤ (Localization.AtPrime 𝔮) (algebraMap k (Localization.AtPrime 𝔮) (a i))) = 0 → ∑ i, TensorProduct.tmul k (c i) (KaehlerDifferential.D ℤ k (a i)) = 0) → FiniteDimensional (IsLocalRing.ResidueField (Localization.AtPrime 𝔮)) (LinearMap.ker (KaehlerDifferential.mapBaseChange ℤ k (IsLocalRing.ResidueField (Localization.AtPrime 𝔮)))) :=
by
  intro k _ Λ _ _ _ 𝔮 _ H
  classical

  have repr : ∀ x : TensorProduct k (IsLocalRing.ResidueField (Localization.AtPrime 𝔮)) Ω[k⁄ℤ],
      ∃ (r : ℕ) (c : Fin r → IsLocalRing.ResidueField (Localization.AtPrime 𝔮)) (a : Fin r → k),
        x = ∑ i, TensorProduct.tmul k (c i) (KaehlerDifferential.D ℤ k (a i)) := by
    have h0 : ∃ (r : ℕ) (c : Fin r → IsLocalRing.ResidueField (Localization.AtPrime 𝔮)) (a : Fin r → k),
        (0 : TensorProduct k (IsLocalRing.ResidueField (Localization.AtPrime 𝔮)) Ω[k⁄ℤ]) =
          ∑ i, TensorProduct.tmul k (c i) (KaehlerDifferential.D ℤ k (a i)) :=
      ⟨0, Fin.elim0, Fin.elim0, by simp⟩
    have hadd : ∀ x y : TensorProduct k (IsLocalRing.ResidueField (Localization.AtPrime 𝔮)) Ω[k⁄ℤ],
        (∃ (r : ℕ) (c : Fin r → IsLocalRing.ResidueField (Localization.AtPrime 𝔮)) (a : Fin r → k),
          x = ∑ i, TensorProduct.tmul k (c i) (KaehlerDifferential.D ℤ k (a i))) →
        (∃ (r : ℕ) (c : Fin r → IsLocalRing.ResidueField (Localization.AtPrime 𝔮)) (a : Fin r → k),
          y = ∑ i, TensorProduct.tmul k (c i) (KaehlerDifferential.D ℤ k (a i))) →
        ∃ (r : ℕ) (c : Fin r → IsLocalRing.ResidueField (Localization.AtPrime 𝔮)) (a : Fin r → k),
          x + y = ∑ i, TensorProduct.tmul k (c i) (KaehlerDifferential.D ℤ k (a i)) := by
      rintro x y ⟨r, c, a, rfl⟩ ⟨r', c', a', rfl⟩
      refine ⟨r + r', Fin.append c c', Fin.append a a', ?_⟩
      rw [Fin.sum_univ_add]
      simp only [Fin.append_left, Fin.append_right]
    have hpure : ∀ (ω : Ω[k⁄ℤ]) (c : IsLocalRing.ResidueField (Localization.AtPrime 𝔮)),
        ∃ (r : ℕ) (c' : Fin r → IsLocalRing.ResidueField (Localization.AtPrime 𝔮)) (a : Fin r → k),
          TensorProduct.tmul k c ω = ∑ i, TensorProduct.tmul k (c' i) (KaehlerDifferential.D ℤ k (a i)) := by
      intro ω
      have hω : ω ∈ Submodule.span k (Set.range (KaehlerDifferential.D ℤ k)) := by
        rw [KaehlerDifferential.span_range_derivation]; trivial
      induction hω using Submodule.span_induction with
      | mem x hx =>
        obtain ⟨a, rfl⟩ := hx
        intro c
        exact ⟨1, fun _ => c, fun _ => a, by simp⟩
      | zero =>
        intro c
        rw [TensorProduct.tmul_zero]
        exact h0
      | add x y _ _ hx hy =>
        intro c
        rw [TensorProduct.tmul_add]
        exact hadd _ _ (hx c) (hy c)
      | smul b x _ hx =>
        intro c
        rw [← TensorProduct.smul_tmul]
        exact hx (b • c)
    intro x
    induction x using TensorProduct.induction_on with
    | zero => exact h0
    | tmul c ω => exact hpure ω c
    | add x y hx hy => exact hadd _ _ hx hy

  let ι := LinearMap.liftBaseChange (IsLocalRing.ResidueField (Localization.AtPrime 𝔮))
    ((((TensorProduct.mk (Localization.AtPrime 𝔮) (IsLocalRing.ResidueField (Localization.AtPrime 𝔮))
      Ω[Localization.AtPrime 𝔮⁄ℤ]) 1).restrictScalars k).comp
        (KaehlerDifferential.map ℤ ℤ k (Localization.AtPrime 𝔮)))
  have hι : ∀ (c : IsLocalRing.ResidueField (Localization.AtPrime 𝔮)) (a : k),
      ι (TensorProduct.tmul k c (KaehlerDifferential.D ℤ k a)) =
        TensorProduct.tmul (Localization.AtPrime 𝔮) c
          (KaehlerDifferential.D ℤ (Localization.AtPrime 𝔮) (algebraMap k (Localization.AtPrime 𝔮) a)) := by
    intro c a
    simp only [ι, LinearMap.liftBaseChange_tmul, LinearMap.comp_apply,
      LinearMap.restrictScalars_apply, TensorProduct.mk_apply, KaehlerDifferential.map_D]
    rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]

  have hinj : Function.Injective ι := by
    rw [injective_iff_map_eq_zero]
    intro x hx
    obtain ⟨r, c, a, rfl⟩ := repr x
    rw [map_sum] at hx
    simp only [hι] at hx
    exact H r c a hx

  have hfac : ∀ x, KaehlerDifferential.mapBaseChange ℤ k (IsLocalRing.ResidueField (Localization.AtPrime 𝔮)) x =
      KaehlerDifferential.mapBaseChange ℤ (Localization.AtPrime 𝔮)
        (IsLocalRing.ResidueField (Localization.AtPrime 𝔮)) (ι x) := by
    intro x
    obtain ⟨r, c, a, rfl⟩ := repr x
    simp only [map_sum, hι, KaehlerDifferential.mapBaseChange_tmul, KaehlerDifferential.map_D]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [IsScalarTower.algebraMap_apply k (Localization.AtPrime 𝔮)
      (IsLocalRing.ResidueField (Localization.AtPrime 𝔮))]

  have hsurj : Function.Surjective
      (algebraMap (Localization.AtPrime 𝔮) (IsLocalRing.ResidueField (Localization.AtPrime 𝔮))) := by
    rw [IsLocalRing.ResidueField.algebraMap_eq]
    exact IsLocalRing.residue_surjective
  have hex := KaehlerDifferential.exact_kerCotangentToTensor_mapBaseChange ℤ (Localization.AtPrime 𝔮)
    (IsLocalRing.ResidueField (Localization.AtPrime 𝔮)) hsurj
  have hfg : (Submodule.map ((KaehlerDifferential.kerCotangentToTensor ℤ (Localization.AtPrime 𝔮)
      (IsLocalRing.ResidueField (Localization.AtPrime 𝔮))).comp
        (RingHom.ker (algebraMap (Localization.AtPrime 𝔮)
          (IsLocalRing.ResidueField (Localization.AtPrime 𝔮)))).toCotangent) ⊤).FG :=
    Submodule.FG.map _ Module.Finite.fg_top
  obtain ⟨G, hG⟩ := hfg
  have hle : LinearMap.ker (KaehlerDifferential.mapBaseChange ℤ (Localization.AtPrime 𝔮)
      (IsLocalRing.ResidueField (Localization.AtPrime 𝔮))) ≤
      Submodule.span (IsLocalRing.ResidueField (Localization.AtPrime 𝔮)) (G : Set _) := by
    intro y hy
    rw [LinearMap.mem_ker] at hy
    obtain ⟨z, rfl⟩ := (hex y).mp hy
    obtain ⟨x, rfl⟩ := Ideal.toCotangent_surjective _ z
    have hx : (KaehlerDifferential.kerCotangentToTensor ℤ (Localization.AtPrime 𝔮)
        (IsLocalRing.ResidueField (Localization.AtPrime 𝔮))) (Ideal.toCotangent _ x) ∈
        Submodule.span (Localization.AtPrime 𝔮) (G : Set _) := by
      rw [hG]
      exact Submodule.mem_map_of_mem (f := (KaehlerDifferential.kerCotangentToTensor ℤ
        (Localization.AtPrime 𝔮) (IsLocalRing.ResidueField (Localization.AtPrime 𝔮))).comp
          (RingHom.ker (algebraMap (Localization.AtPrime 𝔮)
            (IsLocalRing.ResidueField (Localization.AtPrime 𝔮)))).toCotangent) Submodule.mem_top
    exact Submodule.span_le_restrictScalars (Localization.AtPrime 𝔮)
      (IsLocalRing.ResidueField (Localization.AtPrime 𝔮)) _ hx
  haveI := FiniteDimensional.span_finset (IsLocalRing.ResidueField (Localization.AtPrime 𝔮)) G
  haveI : FiniteDimensional (IsLocalRing.ResidueField (Localization.AtPrime 𝔮))
      (LinearMap.ker (KaehlerDifferential.mapBaseChange ℤ (Localization.AtPrime 𝔮)
        (IsLocalRing.ResidueField (Localization.AtPrime 𝔮)))) :=
    Submodule.finiteDimensional_of_le hle

  have hmaps : ∀ x ∈ LinearMap.ker (KaehlerDifferential.mapBaseChange ℤ k
      (IsLocalRing.ResidueField (Localization.AtPrime 𝔮))),
      ι x ∈ LinearMap.ker (KaehlerDifferential.mapBaseChange ℤ (Localization.AtPrime 𝔮)
        (IsLocalRing.ResidueField (Localization.AtPrime 𝔮))) := by
    intro x hx
    rw [LinearMap.mem_ker] at hx ⊢
    rw [← hfac]
    exact hx
  have hmaple : Submodule.map ι (LinearMap.ker (KaehlerDifferential.mapBaseChange ℤ k
      (IsLocalRing.ResidueField (Localization.AtPrime 𝔮)))) ≤
      LinearMap.ker (KaehlerDifferential.mapBaseChange ℤ (Localization.AtPrime 𝔮)
        (IsLocalRing.ResidueField (Localization.AtPrime 𝔮))) := by
    rintro _ ⟨x, hx, rfl⟩
    exact hmaps x hx
  haveI : FiniteDimensional (IsLocalRing.ResidueField (Localization.AtPrime 𝔮))
      (Submodule.map ι (LinearMap.ker (KaehlerDifferential.mapBaseChange ℤ k
        (IsLocalRing.ResidueField (Localization.AtPrime 𝔮))))) :=
    Submodule.finiteDimensional_of_le hmaple
  exact Module.Finite.equiv (Submodule.equivMapOfInjective ι hinj _).symm

theorem wc_pfc_p_csa_eval_surjective : ∀ (K : Type u) [Field K] (R : Type u) [CommRing R] (π : R →+* K) (σ : K →+* R), π.comp σ = RingHom.id K → ∀ (n : ℕ), RingHom.ker π ^ n = ⊥ → ∀ (d : ℕ) (lam' : Fin d → R), Ideal.span (Set.range lam') = RingHom.ker π → Function.Surjective (MvPolynomial.eval₂Hom σ lam') :=
by
  intro K _ R _ π σ hσ n hn d lam' hspan
  set I := RingHom.ker π with hI
  set Ψ := MvPolynomial.eval₂Hom σ lam' with hΨ
  have F2 : ∀ r : R, r - σ (π r) ∈ I := by
    intro r
    rw [hI, RingHom.mem_ker, map_sub, ← RingHom.comp_apply π σ, hσ, RingHom.id_apply, sub_self]
  have F3 : ∀ i, lam' i ∈ I := by
    intro i
    rw [← hspan]
    exact Ideal.subset_span ⟨i, rfl⟩
  have step : ∀ (m : ℕ) (y : R), y ∈ I ^ m →
      ∃ P : MvPolynomial (Fin d) K, y - Ψ P ∈ I ^ (m + 1) := by
    intro m
    induction m with
    | zero =>
      intro y _
      refine ⟨MvPolynomial.C (π y), ?_⟩
      rw [zero_add, pow_one, hΨ, MvPolynomial.eval₂Hom_C]
      exact F2 y
    | succ m ih =>
      intro y hy
      rw [pow_succ] at hy
      refine Submodule.mul_induction_on hy ?_ ?_
      · intro a ha b hb
        obtain ⟨P₁, hP₁⟩ := ih a ha
        have hb' : b ∈ Ideal.span (Set.range lam') := by rw [hspan]; exact hb
        obtain ⟨c, hc⟩ := (Ideal.mem_span_range_iff_exists_fun).mp hb'
        have hΨQ : Ψ (∑ i, MvPolynomial.C (π (c i)) * MvPolynomial.X i) =
            ∑ i, σ (π (c i)) * lam' i := by
          rw [map_sum]
          refine Finset.sum_congr rfl (fun i _ => ?_)
          rw [map_mul, hΨ, MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_X']
        have ht : Ψ (∑ i, MvPolynomial.C (π (c i)) * MvPolynomial.X i) ∈ I := by
          rw [hΨQ]
          exact Ideal.sum_mem _ (fun i _ => Ideal.mul_mem_left _ _ (F3 i))
        have hbt : b - Ψ (∑ i, MvPolynomial.C (π (c i)) * MvPolynomial.X i) ∈ I ^ 2 := by
          rw [hΨQ, ← hc, ← Finset.sum_sub_distrib, pow_two]
          refine Ideal.sum_mem _ (fun i _ => ?_)
          rw [← sub_mul]
          exact Ideal.mul_mem_mul (F2 (c i)) (F3 i)
        refine ⟨P₁ * ∑ i, MvPolynomial.C (π (c i)) * MvPolynomial.X i, ?_⟩
        have e : a * b - Ψ (P₁ * ∑ i, MvPolynomial.C (π (c i)) * MvPolynomial.X i) =
            (a - Ψ P₁) * Ψ (∑ i, MvPolynomial.C (π (c i)) * MvPolynomial.X i) +
              a * (b - Ψ (∑ i, MvPolynomial.C (π (c i)) * MvPolynomial.X i)) := by
          rw [map_mul]; ring
        rw [e]
        refine Ideal.add_mem _ ?_ ?_
        · rw [pow_succ I (m + 1)]
          exact Ideal.mul_mem_mul hP₁ ht
        · rw [show m + 1 + 1 = m + 2 from rfl, pow_add]
          exact Ideal.mul_mem_mul ha hbt
      · intro x z hx hz
        obtain ⟨P₁, h₁⟩ := hx
        obtain ⟨P₂, h₂⟩ := hz
        refine ⟨P₁ + P₂, ?_⟩
        have e : x + z - Ψ (P₁ + P₂) = (x - Ψ P₁) + (z - Ψ P₂) := by rw [map_add]; ring
        rw [e]
        exact Ideal.add_mem _ h₁ h₂
  have approx : ∀ (m : ℕ) (x : R), ∃ P : MvPolynomial (Fin d) K, x - Ψ P ∈ I ^ m := by
    intro m x
    induction m with
    | zero => exact ⟨0, by rw [pow_zero, Ideal.one_eq_top]; exact Submodule.mem_top⟩
    | succ m ih =>
      obtain ⟨P, hP⟩ := ih
      obtain ⟨P', hP'⟩ := step m _ hP
      refine ⟨P + P', ?_⟩
      have e : x - Ψ (P + P') = x - Ψ P - Ψ P' := by rw [map_add]; ring
      rw [e]; exact hP'
  intro x
  obtain ⟨P, hP⟩ := approx n x
  rw [hn, Ideal.mem_bot, sub_eq_zero] at hP
  exact ⟨P, hP.symm⟩

theorem wc_pfc_p_csa_frobenius_generation : ∀ (p : ℕ) [Fact p.Prime] (k : Type u) [Field k] [CharP k p] (ι : Type u) (β : ι → k), Submodule.span k (Set.range fun i => KaehlerDifferential.D ℤ k (β i)) = ⊤ → ∀ e : ℕ, Subring.closure (Set.range (fun y : k => y ^ (p ^ e)) ∪ Set.range β) = ⊤ :=
by
  intro p hp k _ _ ι β hspan
  classical
  have hp' : p.Prime := hp.out

  have h1 : Subring.closure (Set.range (fun y : k => y ^ p) ∪ Set.range β) = ⊤ := by
    set T := Subring.closure (Set.range (fun y : k => y ^ p) ∪ Set.range β) with hTdef
    have hpow : ∀ y : k, y ^ p ∈ T := fun y => Subring.subset_closure (Or.inl ⟨y, rfl⟩)
    have hβT : ∀ i, β i ∈ T := fun i => Subring.subset_closure (Or.inr ⟨i, rfl⟩)
    have hinv : ∀ x ∈ T.carrier, x⁻¹ ∈ T.carrier := by
      intro x hx
      by_cases hx0 : x = 0
      · rw [hx0, inv_zero]; exact T.zero_mem
      · have hxp : x ^ p = x ^ (p - 1) * x := by
          rw [← pow_succ, Nat.sub_add_cancel hp'.one_lt.le]
        have e : x⁻¹ = x ^ (p - 1) * (x⁻¹) ^ p := by
          rw [inv_pow, hxp, mul_inv, ← mul_assoc, mul_inv_cancel₀ (pow_ne_zero _ hx0), one_mul]
        rw [e]
        exact T.mul_mem (T.pow_mem hx _) (hpow _)
    let S : Subfield k := { T with inv_mem' := hinv }
    have hST : ∀ x, x ∈ S ↔ x ∈ T := fun x => Iff.rfl
    rw [eq_top_iff]
    intro b _
    by_contra hbT
    have hbS : b ∉ S := fun h => hbT ((hST b).mp h)

    let 𝒮 : Set (Subfield k) := {N | b ∉ N}
    obtain ⟨M, hSM, hM⟩ := zorn_le_nonempty₀ 𝒮 (fun c hcS hc y hy => by
      refine ⟨sSup c, fun hbc => ?_, fun N hN => le_sSup hN⟩
      obtain ⟨N, hN, hbN⟩ := (Subfield.mem_sSup_of_directedOn ⟨y, hy⟩ hc.directedOn).mp hbc
      exact hcS hN hbN) S hbS
    have hbM : b ∉ M := hM.1
    have hmax' : ∀ N : Subfield k, M ≤ N → b ∉ N → N ≤ M := fun N hle hbN =>
      hM.2 hbN hle
    have hpowM : ∀ z : k, z ^ p ∈ M := fun z => hSM ((hST _).mpr (hpow z))
    have hβM : ∀ i, β i ∈ M := fun i => hSM ((hST _).mpr (hβT i))

    have hint : ∀ z : k, IsIntegral M z := fun z =>
      ⟨Polynomial.X ^ p - Polynomial.C (⟨z ^ p, hpowM z⟩ : M),
        Polynomial.monic_X_pow_sub_C _ hp'.ne_zero, by
        rw [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C]; exact sub_self _⟩
    have hminpoly : ∀ z : k, z ∉ M →
        minpoly M z = Polynomial.X ^ p - Polynomial.C (⟨z ^ p, hpowM z⟩ : M) := by
      intro z hz
      have hnr : ∀ y : M, y ^ p ≠ ⟨z ^ p, hpowM z⟩ := by
        intro y hy
        apply hz
        have h1 : (y : k) ^ p = z ^ p := by
          have := congrArg Subtype.val hy
          simpa using this
        have hyz : (y : k) = z := frobenius_inj k p (by rw [frobenius_def, frobenius_def]; exact h1)
        exact hyz ▸ y.2
      exact (minpoly.eq_of_irreducible_of_monic (X_pow_sub_C_irreducible_of_prime hp' hnr)
        (by rw [Polynomial.aeval_sub, Polynomial.aeval_X_pow, Polynomial.aeval_C]; exact sub_self _)
        (Polynomial.monic_X_pow_sub_C _ hp'.ne_zero)).symm
    have hfin : ∀ z : k, z ∉ M → Module.finrank M (IntermediateField.adjoin M {z}) = p := by
      intro z hz
      rw [IntermediateField.adjoin.finrank (hint z), hminpoly z hz, Polynomial.natDegree_X_pow_sub_C]

    have hgen : ∀ x : k, x ∈ IntermediateField.adjoin M {b} := by
      intro x
      by_cases hx : x ∈ M
      · exact IntermediateField.algebraMap_mem _ (⟨x, hx⟩ : M)
      · have hbx : b ∈ IntermediateField.adjoin M {x} := by
          by_contra hbN
          have hle : M ≤ (IntermediateField.adjoin M {x}).toSubfield := fun m hm =>
            IntermediateField.algebraMap_mem _ (⟨m, hm⟩ : M)
          exact hx (hmax' _ hle hbN (IntermediateField.mem_adjoin_simple_self M x))
        have h1 : IntermediateField.adjoin M {b} ≤ IntermediateField.adjoin M {x} :=
          IntermediateField.adjoin_simple_le_iff.mpr hbx
        have hfx := hfin x hx
        have hfb := hfin b hbM
        have : FiniteDimensional M (IntermediateField.adjoin M {x}) :=
          Module.finite_of_finrank_pos (by rw [hfx]; exact hp'.pos)
        have h2 := IntermediateField.eq_of_le_of_finrank_eq h1 (by rw [hfx, hfb])
        rw [h2]
        exact IntermediateField.mem_adjoin_simple_self M x
    have hsurj : ∀ x : k, ∃ f : Polynomial M, Polynomial.aeval b f = x := by
      intro x
      have hx := hgen x
      rw [← IntermediateField.mem_toSubalgebra,
        IntermediateField.adjoin_simple_toSubalgebra_of_isAlgebraic (hint b).isAlgebraic,
        Algebra.adjoin_singleton_eq_range_aeval] at hx
      exact hx

    have hmin := hminpoly b hbM
    have hpM : (p : M) = 0 :=
      (algebraMap M k).injective (by rw [map_natCast, map_zero, CharP.cast_eq_zero])
    have hder0 : Polynomial.derivative (minpoly M b) = 0 := by
      rw [hmin, Polynomial.derivative_sub, Polynomial.derivative_C, sub_zero,
        Polynomial.derivative_X_pow, hpM, map_zero, zero_mul]
    have hkey : ∀ h : Polynomial M, Polynomial.aeval b h = 0 →
        Polynomial.aeval b (Polynomial.derivative h) = 0 := by
      intro h hh
      obtain ⟨q, rfl⟩ := minpoly.dvd M b hh
      rw [Polynomial.derivative_mul, hder0, zero_mul, zero_add, map_mul, minpoly.aeval, zero_mul]
    have hwd : ∀ f g : Polynomial M, Polynomial.aeval b f = Polynomial.aeval b g →
        Polynomial.aeval b (Polynomial.derivative f) =
          Polynomial.aeval b (Polynomial.derivative g) := by
      intro f g hfg
      have := hkey (f - g) (by rw [map_sub, hfg, sub_self])
      rwa [Polynomial.derivative_sub, map_sub, sub_eq_zero] at this
    choose σ hσ using hsurj
    obtain ⟨δ, hδdef⟩ : ∃ δ : k → k, ∀ x, δ x = Polynomial.aeval b (Polynomial.derivative (σ x)) :=
      ⟨_, fun _ => rfl⟩
    have hδ : ∀ f : Polynomial M, δ (Polynomial.aeval b f) =
        Polynomial.aeval b (Polynomial.derivative f) := fun f => by
      rw [hδdef]; exact hwd _ _ (hσ _)
    have hadd : ∀ x y, δ (x + y) = δ x + δ y := by
      intro x y
      have e : x + y = Polynomial.aeval b (σ x + σ y) := by rw [map_add, hσ, hσ]
      rw [e, hδ, Polynomial.derivative_add, map_add, hδdef, hδdef]
    have hmul : ∀ x y, δ (x * y) = x • δ y + y • δ x := by
      intro x y
      have e : x * y = Polynomial.aeval b (σ x * σ y) := by rw [map_mul, hσ, hσ]
      rw [e, hδ, Polynomial.derivative_mul, map_add, map_mul, map_mul, hδdef, hδdef, hσ, hσ,
        smul_eq_mul, smul_eq_mul]
      ring
    have hb1 : δ b = 1 := by
      have := hδ Polynomial.X
      rwa [Polynomial.aeval_X, Polynomial.derivative_X, map_one] at this
    have hδM : ∀ m ∈ M, δ m = 0 := by
      intro m hm
      have := hδ (Polynomial.C (⟨m, hm⟩ : M))
      rw [Polynomial.aeval_C, Polynomial.derivative_C, map_zero] at this
      exact this
    let g : k →+ k := AddMonoidHom.mk' δ hadd
    let D : Derivation ℤ k k := Derivation.mk' g.toIntLinearMap (fun x y => hmul x y)
    have hDapp : ∀ x, D x = δ x := fun x => rfl

    let L := D.liftKaehlerDifferential
    have hL : ∀ y, L (KaehlerDifferential.D ℤ k y) = D y := fun y =>
      Derivation.liftKaehlerDifferential_comp_D D y
    have hker : Submodule.span k (Set.range fun i => KaehlerDifferential.D ℤ k (β i)) ≤
        LinearMap.ker L := by
      rw [Submodule.span_le]
      rintro _ ⟨i, rfl⟩
      rw [SetLike.mem_coe, LinearMap.mem_ker, hL, hDapp]
      exact hδM _ (hβM i)
    rw [hspan] at hker
    have h0 : L (KaehlerDifferential.D ℤ k b) = 0 := hker Submodule.mem_top
    rw [hL, hDapp, hb1] at h0
    exact one_ne_zero h0

  intro e
  induction e with
  | zero =>
    rw [eq_top_iff]
    intro x _
    exact Subring.subset_closure (Or.inl ⟨x, by simp⟩)
  | succ e ih =>
    have hall : ∀ x : k, x ^ (p ^ e) ∈
        Subring.closure (Set.range (fun y : k => y ^ (p ^ (e + 1))) ∪ Set.range β) := by
      intro x
      have hV : Subring.closure (Set.range (fun y : k => y ^ p) ∪ Set.range β) ≤
          Subring.comap (iterateFrobenius k p e)
            (Subring.closure (Set.range (fun y : k => y ^ (p ^ (e + 1))) ∪ Set.range β)) := by
        apply Subring.closure_le.mpr
        rintro _ (⟨y, rfl⟩ | ⟨i, rfl⟩)
        · rw [SetLike.mem_coe, Subring.mem_comap, iterateFrobenius_def, ← pow_mul, ← pow_succ']
          exact Subring.subset_closure (Or.inl ⟨y, rfl⟩)
        · rw [SetLike.mem_coe, Subring.mem_comap, iterateFrobenius_def]
          have hbi : β i ∈ Subring.closure
              (Set.range (fun y : k => y ^ (p ^ (e + 1))) ∪ Set.range β) :=
            Subring.subset_closure (Or.inr ⟨i, rfl⟩)
          exact pow_mem hbi _
      rw [h1] at hV
      have := hV (Subring.mem_top x)
      rwa [Subring.mem_comap, iterateFrobenius_def] at this
    rw [eq_top_iff, ← ih]
    apply Subring.closure_le.mpr
    rintro _ (⟨y, rfl⟩ | ⟨i, rfl⟩)
    · exact hall y
    · exact Subring.subset_closure (Or.inr ⟨i, rfl⟩)

theorem wc_pfc_p_csa_exceptional_finite : ∀ (k : Type u) [Field k] (K : Type u) [Field K] [Algebra k K], FiniteDimensional K (LinearMap.ker (KaehlerDifferential.mapBaseChange ℤ k K)) → ∀ (ι : Type u) (β : ι → k), LinearIndependent k (fun i => KaehlerDifferential.D ℤ k (β i)) → Submodule.span k (Set.range fun i => KaehlerDifferential.D ℤ k (β i)) = ⊤ → ∃ B₀ : Finset ι, LinearIndependent K (fun i : {i // i ∉ B₀} => KaehlerDifferential.D ℤ K (algebraMap k K (β i.1))) :=
by
  classical
  intro k _ K _ _ hfin ι β hLI hSP
  let f := KaehlerDifferential.mapBaseChange ℤ k K
  let TB₀ := Module.Basis.mk hLI (le_of_eq hSP.symm)
  let TB := Algebra.TensorProduct.basis K TB₀
  have hTB : ∀ i, f (TB i) = KaehlerDifferential.D ℤ K (algebraMap k K (β i)) := by
    intro i
    simp only [f, TB, Algebra.TensorProduct.basis_apply, TB₀, Module.Basis.mk_apply]
    rw [KaehlerDifferential.mapBaseChange_tmul, one_smul, KaehlerDifferential.map_D]
  haveI : Module.Finite K (LinearMap.ker f) := hfin
  obtain ⟨S, hS⟩ := (Module.Finite.fg_top : (⊤ : Submodule K (LinearMap.ker f)).FG)
  let B₀ : Finset ι := S.biUnion (fun s => (TB.repr s.1).support)
  refine ⟨B₀, ?_⟩
  have h5 : LinearMap.ker f ≤ Submodule.span K (TB '' (B₀ : Set ι)) := by
    have key : ∀ y : LinearMap.ker f, y ∈ Submodule.span K (S : Set (LinearMap.ker f)) →
        y.1 ∈ Submodule.span K (TB '' (B₀ : Set ι)) := by
      intro y hy
      induction hy using Submodule.span_induction with
      | mem y hy =>
        refine Submodule.span_mono (Set.image_mono ?_) (TB.mem_span_repr_support _)
        intro i hi
        exact Finset.mem_coe.mpr (Finset.mem_biUnion.mpr ⟨y, Finset.mem_coe.mp hy, hi⟩)
      | zero => exact Submodule.zero_mem _
      | add y z _ _ hy hz => exact Submodule.add_mem _ hy hz
      | smul a y _ hy => exact Submodule.smul_mem _ a hy
    intro x hx
    exact key ⟨x, hx⟩ (by rw [hS]; exact Submodule.mem_top)
  have h6 := TB.linearIndependent.disjoint_span_image (s := {i | i ∉ B₀}) (t := (B₀ : Set ι))
    (by rw [Set.disjoint_left]; intro i hi hi'; exact hi hi')
  have hw : LinearIndependent K (TB ∘ (Subtype.val : {i // i ∉ B₀} → ι)) :=
    TB.linearIndependent.comp _ Subtype.val_injective
  have h7 : Disjoint (Submodule.span K (Set.range (TB ∘ (Subtype.val : {i // i ∉ B₀} → ι))))
      (LinearMap.ker f) := by
    have hr : Set.range (TB ∘ (Subtype.val : {i // i ∉ B₀} → ι)) = TB '' {i | i ∉ B₀} := by
      rw [Set.range_comp, Subtype.range_coe_subtype]
    rw [hr]
    exact h6.mono_right h5
  have h8 := hw.map h7
  have hfun : (f ∘ (TB ∘ (Subtype.val : {i // i ∉ B₀} → ι))) =
