  have hroot : ∀ e : Fin n →₀ ℕ, ∃ y : k, y ^ p = MvPowerSeries.coeff e N :=
    fun e => hint _ (fun i => (hN i e).1)
  choose y hy using hroot
  have hsupp : ∀ e : Fin n →₀ ℕ, MvPowerSeries.coeff e N ≠ 0 → ∀ j, p ∣ e j :=
    fun e => (hN (Classical.arbitrary ι) e).2
  let M : MvPowerSeries (Fin n) k := fun e => y (p • e)
  have hM : ∀ e : Fin n →₀ ℕ, MvPowerSeries.coeff e M = y (p • e) := fun e => rfl
  refine ⟨M, MvPowerSeries.ext fun m => ?_⟩
  by_cases hm : ∀ j, p ∣ m j
  · set e : Fin n →₀ ℕ := Finsupp.mapRange (fun t => t / p) (Nat.zero_div p) m with he_def
    have he : p • e = m := by
      ext j
      simp only [he_def, Finsupp.smul_apply, Finsupp.mapRange_apply, smul_eq_mul]
      exact Nat.mul_div_cancel' (hm j)
    calc MvPowerSeries.coeff m (M ^ p) = MvPowerSeries.coeff (p • e) (M ^ p) := by rw [he]
      _ = (MvPowerSeries.coeff e M) ^ p := (H8 p n k hp M).1 e
      _ = y m ^ p := by rw [hM, he]
      _ = MvPowerSeries.coeff m N := hy m
  · have h0 : MvPowerSeries.coeff m N = 0 := by
      by_contra h
      exact hm (hsupp m h)
    rw [(H8 p n k hp M).2 m hm, h0]

theorem wc_hnas_pfc_gcl_de_frac_pth_root : (∀ (p n : ℕ) (k : Type u) [Field k] [CharP k p], p.Prime → ∀ (ι : Type u) [Nonempty ι] (F : ι → Subfield k), (∀ i, ∀ y : k, y ^ p ∈ F i) → (∀ c : k, (∀ i, c ∈ F i) → ∃ y : k, y ^ p = c) → ∀ N : MvPowerSeries (Fin n) k, (∀ i, ∃ d : MvPowerSeries (Fin n) k, d ≠ 0 ∧ (∀ e : Fin n →₀ ℕ, MvPowerSeries.coeff e d ∈ F i ∧ (MvPowerSeries.coeff e d ≠ 0 → ∀ j, p ∣ e j)) ∧ (∀ e : Fin n →₀ ℕ, MvPowerSeries.coeff e (N * d) ∈ F i ∧ (MvPowerSeries.coeff e (N * d) ≠ 0 → ∀ j, p ∣ e j))) → ∃ M : MvPowerSeries (Fin n) k, M ^ p = N) → (∀ (p n : ℕ) (k : Type u) [Field k] [CharP k p], p.Prime → ∀ (M : MvPowerSeries (Fin n) k), (∀ e : Fin n →₀ ℕ, MvPowerSeries.coeff (p • e) (M ^ p) = (MvPowerSeries.coeff e M) ^ p) ∧ ∀ m : Fin n →₀ ℕ, (¬ ∀ j, p ∣ m j) → MvPowerSeries.coeff m (M ^ p) = 0) → (∀ (p n : ℕ) (k : Type u) [Field k] (k' : Subfield k), ∃ S : Subring (MvPowerSeries (Fin n) k), ∀ G : MvPowerSeries (Fin n) k, G ∈ S ↔ (∀ e : Fin n →₀ ℕ, MvPowerSeries.coeff e G ∈ k' ∧ (MvPowerSeries.coeff e G ≠ 0 → ∀ j, p ∣ e j))) → ∀ (p n : ℕ) (k : Type u) [Field k] [CharP k p], p.Prime → ∀ (L : Type u) [Field L] (φ : MvPowerSeries (Fin n) k →+* L), Function.Injective φ → ∀ (ι : Type u) [Nonempty ι] (F : ι → Subfield k), (∀ i, ∀ y : k, y ^ p ∈ F i) → (∀ c : k, (∀ i, c ∈ F i) → ∃ y : k, y ^ p = c) → ∀ x ∈ Subfield.closure (Set.range φ), (∀ i, x ∈ Subfield.closure (φ '' {G : MvPowerSeries (Fin n) k | (∀ e : Fin n →₀ ℕ, MvPowerSeries.coeff e G ∈ F i ∧ (MvPowerSeries.coeff e G ≠ 0 → ∀ j, p ∣ e j))})) → ∃ y ∈ Subfield.closure (Set.range φ), y ^ p = x :=
