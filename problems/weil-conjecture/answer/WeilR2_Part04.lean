    · intro y
      show τ₁ ((1 : L₀) ⊗ₜ[P'] y) = _
      rw [hτ₁, map_one, one_mul]
    · intro z
      show τ₁ (algebraMap L₀ _ z) = _
      rw [hal, hτ₁, map_one, mul_one]

  have core : ∀ (R : Type u) [CommRing R] (J : Ideal R) (M : Submonoid (R ⧸ J)) (L : Type u)
      [CommRing L] [Algebra (R ⧸ J) L] (lam₀ : Localization M →+* L),
      (∀ r, lam₀ (algebraMap (R ⧸ J) (Localization M) r) = algebraMap (R ⧸ J) L r) →
      ∀ (A' : Type u) [CommRing A'] [Algebra R A'] [Algebra.FinitePresentation R A']
      (P : Type u) [CommRing P] (S : Type u) [CommRing S] [Algebra P S] [Algebra.Smooth P S]
      (D : Type u) [CommRing D] [Algebra S D] (N : Submonoid S) [IsLocalization N D] (d : ℕ)
      (θ : R →+* MvPolynomial (Fin d) P) (κ : MvPolynomial (Fin d) P →+* Localization M),
      κ.comp θ = (algebraMap (R ⧸ J) (Localization M)).comp (Ideal.Quotient.mk J) →
      ∀ (χD : A' →+* MvPolynomial (Fin d) D),
      χD.comp (algebraMap R A') =
        (MvPolynomial.map (algebraMap S D)).comp ((MvPolynomial.map (algebraMap P S)).comp θ) →
      ∀ (τ' : MvPolynomial (Fin d) D →+* L),
      τ'.comp ((MvPolynomial.map (algebraMap S D)).comp (MvPolynomial.map (algebraMap P S))) =
