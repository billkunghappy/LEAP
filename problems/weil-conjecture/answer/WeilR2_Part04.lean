      have hdet : ∀ I : Fin c ↪ Fin n, (MvPolynomial.C (algebraMap R D π) ^ 3) ^ c *
          (MvPolynomial.aeval Z : MvPolynomial (Fin n) R →ₐ[R] MvPolynomial (Fin (n + c)) D)
            (Matrix.of fun j l : Fin c => MvPolynomial.pderiv (I l) (f (Fin.castLE hcm j))).det =
