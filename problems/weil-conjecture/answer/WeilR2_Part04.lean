  have hs9 : ∀ (π : Fin d → MvPolynomial (Fin m) k) (i : Fin d), (∀ f : MvPolynomial (Fin d) (MvPolynomial (Fin m) k), (MvPolynomial.C (π i) * MvPolynomial.X i) ^ 2 * f ∈ Ideal.span ((fun j => (MvPolynomial.C (π j) * MvPolynomial.X j) ^ e) '' {j | j < i}) → MvPolynomial.C (π i) * MvPolynomial.X i * f ∈ Ideal.span ((fun j => (MvPolynomial.C (π j) * MvPolynomial.X j) ^ e) '' {j | j < i})) → ∀ y : MvPolynomial (Fin m ⊕ Fin d) k, (MvPolynomial.rename Sum.inl (π i) * MvPolynomial.X (Sum.inr i) : MvPolynomial (Fin m ⊕ Fin d) k) ^ 2 * y ∈ Ideal.span ((fun j => (MvPolynomial.rename Sum.inl (π j) * MvPolynomial.X (Sum.inr j) : MvPolynomial (Fin m ⊕ Fin d) k) ^ e) '' {j | j < i}) → (MvPolynomial.rename Sum.inl (π i) * MvPolynomial.X (Sum.inr i) : MvPolynomial (Fin m ⊕ Fin d) k) * y ∈ Ideal.span ((fun j => (MvPolynomial.rename Sum.inl (π j) * MvPolynomial.X (Sum.inr j) : MvPolynomial (Fin m ⊕ Fin d) k) ^ e) '' {j | j < i}) := by
    intro π i H y hy
