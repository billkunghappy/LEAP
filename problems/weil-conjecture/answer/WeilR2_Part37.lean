    intro X hX
    by_contra hX0
    obtain ⟨K, hK'⟩ := hR1 X hX0 ϖ hϖm
    have h1 : ϖ ^ K * ϖ ∣ ϖ ^ K * 1 := by
      rw [mul_one, ← pow_succ]; exact (hX (K+1)).trans hK'
    have h2 : ϖ ∣ 1 := (mul_dvd_mul_iff_left (pow_ne_zero K hϖ0)).mp h1
    exact (mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal _).mp hϖm)) (isUnit_of_dvd_one h2)

  have hpt : ∀ x : A, ∃ Y : W, (Y : Ω) = ∑ j, (lam j : Ω) * ψ j (algebraMap A (wcGubGen W A) x) := by
    intro x
    refine ⟨∑ j, lam j * ⟨ψ j (algebraMap A (wcGubGen W A) x), (hpts j).2.1 x⟩, ?_⟩
    rw [← hcoe, map_sum]
    exact Finset.sum_congr rfl (fun j _ => map_mul (algebraMap W Ω) _ _)

  have hA : ∀ a : A, ∑ j, (lam j : Ω) * ψ j (algebraMap A (wcGubGen W A) a) = 0 := by
    intro a
    obtain ⟨X, hXc⟩ := hpt a
    have hdiv : ∀ L : ℕ, ϖ ^ L ∣ X := by
      intro L
      obtain ⟨p, s, hps⟩ := hspan L a
      obtain ⟨Y, hYc⟩ := hpt s
      have hj : ∀ j, ψ j (algebraMap A (wcGubGen W A) a) =
          ∑ i, ((Polynomial.eval t (p i) : W) : Ω) * ψ j (algebraMap A (wcGubGen W A) (b i)) +
            (ϖ : Ω) ^ L * ψ j (algebraMap A (wcGubGen W A) s) := by
        intro j
        conv_lhs => rw [hps]
        simp only [map_add, map_sum, map_mul, map_pow, hEV, (hpts j).1]
      have e1 : ∑ j, (lam j : Ω) * ∑ i, ((Polynomial.eval t (p i) : W) : Ω) *
            ψ j (algebraMap A (wcGubGen W A) (b i)) =
          ∑ i, ((Polynomial.eval t (p i) : W) : Ω) *
            ∑ j, (lam j : Ω) * ψ j (algebraMap A (wcGubGen W A) (b i)) := by
        simp only [Finset.mul_sum]
        rw [Finset.sum_comm]
        exact Finset.sum_congr rfl (fun i _ => Finset.sum_congr rfl (fun j _ => by ring))
      have e2 : ∑ i, ((Polynomial.eval t (p i) : W) : Ω) *
            ∑ j, (lam j : Ω) * ψ j (algebraMap A (wcGubGen W A) (b i)) = 0 := by
