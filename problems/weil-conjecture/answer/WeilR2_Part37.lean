by
  intro Ω _ _ W hW hWt C γ hcov hgal X uX ι _ _ hM y₀ hy₀ hSm σ a hP hExh X' r ι' _ _ hbl hι'
    hM' V hV hiso y' hb hi σ'' a'' hP'' hExh'' X₂ r₂ ι₂ _ _ hbl₂ hι₂ hM₂ V₂ hV₂ hiso₂
    X₁ r₁ ι₁ _ _ hbl₁ hι₁ hM₁ V₁ hV₁ hiso₁ y₁ hb₁ hi₁ hns
  classical

  have split : ∀ {T : Type u} (G H K : T → ℕ∞), (∀ y, G y = H y + K y) →
      (⨆ s : Finset T, ∑ y ∈ s, G y) =
        (⨆ s : Finset T, ∑ y ∈ s, H y) + (⨆ s : Finset T, ∑ y ∈ s, K y) := by
    intro T G H K h
    apply le_antisymm
    · refine iSup_le fun s => ?_
      rw [Finset.sum_congr rfl (fun y _ => h y), Finset.sum_add_distrib]
      exact add_le_add (le_iSup (fun s : Finset T => ∑ y ∈ s, H y) s)
        (le_iSup (fun s : Finset T => ∑ y ∈ s, K y) s)
    · refine ENat.iSup_add_iSup_le fun s₁ s₂ => ?_
      refine le_trans ?_ (le_iSup _ (s₁ ∪ s₂))
      rw [Finset.sum_congr rfl (fun y _ => h y), Finset.sum_add_distrib]
      exact add_le_add (Finset.sum_le_sum_of_subset Finset.subset_union_left)
        (Finset.sum_le_sum_of_subset Finset.subset_union_right)
  have tle : ∀ {T T' : Type u} (F : T → ℕ∞) (F' : T' → ℕ∞) (P : T → Prop)
      (P' : T' → Prop) (e : {y' // P' y'} ≃ {y // P y}), (∀ y', ¬ P' y' → F' y' = 0) →
      (∀ z : {y' // P' y'}, F' z.1 = F (e z).1) →
      (⨆ s : Finset T', ∑ y ∈ s, F' y) ≤ ⨆ s : Finset T, ∑ y ∈ s, F y := by
    intro T T' F F' P P' e h0 h1
    refine iSup_le fun s => ?_
    have hinj : Function.Injective (fun z : {y' // P' y'} => (e z).1) := by
      intro z z' hzz
      exact e.injective (Subtype.ext hzz)
    calc ∑ y ∈ s, F' y = ∑ y ∈ s.filter P', F' y :=
          (Finset.sum_filter_of_ne fun y _ hy =>
            Classical.byContradiction fun hP => hy (h0 y hP)).symm
      _ = ∑ z ∈ s.subtype P', F' z.1 := by rw [Finset.sum_subtype_eq_sum_filter]
      _ = ∑ z ∈ s.subtype P', F (e z).1 := Finset.sum_congr rfl (fun z _ => h1 z)
      _ = ∑ y ∈ (s.subtype P').image (fun z => (e z).1), F y :=
          (Finset.sum_image (fun z _ z' _ h => hinj h)).symm
      _ ≤ ⨆ s : Finset T, ∑ y ∈ s, F y := le_iSup (fun s : Finset T => ∑ y ∈ s, F y) _
  have teq : ∀ {T T' : Type u} (P : T → Prop) (P' : T' → Prop) (F : T → ℕ∞) (F' : T' → ℕ∞)
      (e : {y // P y} ≃ {y // P' y}), (∀ z, F z.1 = F' (e z).1) →
      (⨆ s : Finset T, ∑ y ∈ s, if P y then F y else 0) =
        ⨆ s : Finset T', ∑ y ∈ s, if P' y then F' y else 0 := by
    intro T T' P P' F F' e h
    apply le_antisymm
    · refine tle (fun y => if P' y then F' y else 0) (fun y => if P y then F y else 0) P' P e
        (fun y hy => by simp only [hy, ite_false]) (fun z => ?_)
      simp only [z.2, (e z).2, ite_true]
      exact h z
    · refine tle (fun y => if P y then F y else 0) (fun y => if P' y then F' y else 0) P P' e.symm
        (fun y hy => by simp only [hy, ite_false]) (fun z => ?_)
      simp only [z.2, (e.symm z).2, ite_true]
      rw [h (e.symm z), Equiv.apply_symm_apply]
  have ite3 : ∀ {p₁ p₂ p₃ : Prop} [Decidable p₁] [Decidable p₂] [Decidable p₃] (a : ℕ∞),
      (p₁ ↔ p₂ ∨ p₃) → (p₂ → ¬ p₃) →
      (if p₁ then a else 0) = (if p₂ then a else 0) + (if p₃ then a else 0) := by
    intro p₁ p₂ p₃ _ _ _ a h hd
    by_cases h2 : p₂
    · rw [if_pos (h.mpr (Or.inl h2)), if_pos h2, if_neg (hd h2), add_zero]
    · by_cases h3 : p₃
      · rw [if_pos (h.mpr (Or.inr h3)), if_neg h2, if_pos h3, zero_add]
      · rw [if_neg (fun h1 => (h.mp h1).elim h2 h3), if_neg h2, if_neg h3, add_zero]
  have G3 : ∀ {T : Type u} (P : T → Prop) (G : T → ℕ∞) (c : ℕ∞), (∀ y, P y → G y = c) →
      (∀ y, ¬ P y → G y = 0) →
      (⨆ s : Finset T, ∑ y ∈ s, G y) = {y | P y}.encard * c := by
    intro T P G c hc h0
    have hs : ∀ s : Finset T, (∑ y ∈ s, G y) = ((s.filter P).card : ℕ∞) * c := by
