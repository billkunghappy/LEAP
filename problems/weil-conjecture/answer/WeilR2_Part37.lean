        | last =>
          have h3 := (ht i).neg
          rw [neg_sub] at h3
          simpa [Fin.snoc_last, Fin.snoc_castSucc] using h3
        | cast j =>
          have hij' : i ≠ j := fun h => hij (by rw [h])
          simpa [Fin.snoc_castSucc] using hs i j hij'

