theorem wcpa_dj_lr1k_nsr_gub_bdb_split_element : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [Algebra ↥W A] (ϖ : ↥W) (𝔪 : Ideal A) (g : Fin 2 → A),
