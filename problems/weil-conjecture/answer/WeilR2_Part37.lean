by
  intro Ω _ _ W C _ γ X uX ι _ _ y₀ τ _hH σ₀ a₀ hLB X₀ r₀ ι₀ _ _ hbl hι₀ hM₀ A hLim


  have centre : ∀ {C Y N : Scheme.{u}} [AlgebraicGeometry.IsIntegral C]
