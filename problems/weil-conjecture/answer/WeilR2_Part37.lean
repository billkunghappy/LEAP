            RingHom.id _ := by
          rw [← CommRingCat.hom_comp, IsIso.inv_hom_id]; rfl
        rw [this]
        exact ValuationSubring.ext _ _ (fun x => by rw [ValuationSubring.mem_comap]; rfl)
      rw [← key V₁, hV, key V₂]
    have himage : Φ '' {p : Σ ξ : A, ValuationSubring ↥(A.residueField ξ) |
          closure ({p.1} : Set A) ∈ irreducibleComponents A ∧ ¬ Q p.1 ∧
          ∃ y', Q y' ∧ wcLlncDom A p.1 y' p.2} =
        {p : Σ ξ : B, ValuationSubring ↥(B.residueField ξ) |
          closure ({p.1} : Set B) ∈ irreducibleComponents B ∧
          ∃ y, P y ∧ wcLlncDom B p.1 y p.2} := by
      ext ⟨ξ, U⟩
      constructor
      · rintro ⟨⟨ξ', V'⟩, ⟨hc, hne, y', hy', hD⟩, he⟩
        rw [← he]
        have hO' := (hL ξ').mp hne
