    intro y _
    rcases hcov y with ⟨t, rfl⟩ | ⟨t, rfl⟩ | ⟨t, rfl⟩
    · exact hUmax _ d₂ hd₂o (by rw [hR₂]; exact P₂) t
    · exact hUmax _ d₀ hd₀o (by rw [hR₀]; exact P₀) t
    · exact hUmax _ d₁ hd₁o (by rw [hR₁]; exact P₁) t
  subst hUtop
  haveI hiso : IsIso (⊤ : M₂.Opens).ι := by
    rw [← Scheme.topIso_hom]; infer_instance
  have hInv : wcCsdInvPull G R := by
    have := wcpa_dj_lr1k_ebd_invpull_flat_pre _ _ _ G _ (inv (⊤ : M₂.Opens).ι) inferInstance hU
    rwa [IsIso.inv_hom_id_assoc] at this
  obtain ⟨q₀, hq₀, -⟩ := hbl.2 M₂ R hInv



  have H₂ : ∀ p ∈ Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 -
      MvPolynomial.C (a * a'') : MvPolynomial (Fin 2) ↥W)},
      MvPolynomial.eval₂Hom ((Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
        MvPolynomial.C a})).comp MvPolynomial.C)
        ![wcLlccmcX W a 0, wcLlccmcCst W a a'' * wcLlccmcX W a 1] p = 0 := by
    intro p hp
    obtain ⟨q, rfl⟩ := Ideal.mem_span_singleton'.mp hp
    rw [map_mul, map_sub, map_mul, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_X',
      MvPolynomial.eval₂Hom_C, RingHom.comp_apply]
    simp only [Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons]
    have : wcLlccmcX W a 0 * (wcLlccmcCst W a a'' * wcLlccmcX W a 1) -
        wcLlccmcCst W a (a * a'') = 0 := by
      rw [hCstmul]
      linear_combination (wcLlccmcCst W a a'') * hrel a
    rw [show Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
        MvPolynomial.C a}) (MvPolynomial.C (a * a'')) = wcLlccmcCst W a (a * a'') from rfl,
      this, mul_zero]
  have H₀ : ∀ p ∈ Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 -
      MvPolynomial.C (a * a'') : MvPolynomial (Fin 2) ↥W)},
      MvPolynomial.eval₂Hom ((Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
        MvPolynomial.C a''})).comp MvPolynomial.C)
        ![wcLlccmcCst W a'' a * wcLlccmcX W a'' 0, wcLlccmcX W a'' 1] p = 0 := by
    intro p hp
    obtain ⟨q, rfl⟩ := Ideal.mem_span_singleton'.mp hp
    rw [map_mul, map_sub, map_mul, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_X',
      MvPolynomial.eval₂Hom_C, RingHom.comp_apply]
    simp only [Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons]
    have : wcLlccmcCst W a'' a * wcLlccmcX W a'' 0 * wcLlccmcX W a'' 1 -
        wcLlccmcCst W a'' (a * a'') = 0 := by
      rw [hCstmul]
      linear_combination (wcLlccmcCst W a'' a) * hrel a''
    rw [show Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
        MvPolynomial.C a''}) (MvPolynomial.C (a * a'')) = wcLlccmcCst W a'' (a * a'') from rfl,
      this, mul_zero]
  obtain ⟨φ₂, hφ₂⟩ : ∃ φ₂ : wcLlccmcB W (a * a'') →+* wcLlccmcB W a, ∀ p,
      φ₂ (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
        MvPolynomial.C (a * a'')}) p) =
      MvPolynomial.eval₂Hom ((Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
        MvPolynomial.C a})).comp MvPolynomial.C)
        ![wcLlccmcX W a 0, wcLlccmcCst W a a'' * wcLlccmcX W a 1] p :=
    ⟨Ideal.Quotient.lift _ _ H₂, fun p => Ideal.Quotient.lift_mk _ _ _⟩
  obtain ⟨φ₀, hφ₀⟩ : ∃ φ₀ : wcLlccmcB W (a * a'') →+* wcLlccmcB W a'', ∀ p,
      φ₀ (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
        MvPolynomial.C (a * a'')}) p) =
      MvPolynomial.eval₂Hom ((Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
        MvPolynomial.C a''})).comp MvPolynomial.C)
        ![wcLlccmcCst W a'' a * wcLlccmcX W a'' 0, wcLlccmcX W a'' 1] p :=
    ⟨Ideal.Quotient.lift _ _ H₀, fun p => Ideal.Quotient.lift_mk _ _ _⟩
  have g2C : ∀ w : ↥W, φ₂ (wcLlccmcCst W (a * a'') w) = wcLlccmcCst W a w := fun w =>
    (hφ₂ (MvPolynomial.C w)).trans (by rw [MvPolynomial.eval₂Hom_C, RingHom.comp_apply])
  have g2X0 : φ₂ (wcLlccmcX W (a * a'') 0) = wcLlccmcX W a 0 :=
    (hφ₂ (MvPolynomial.X 0)).trans (by rw [MvPolynomial.eval₂Hom_X']; rfl)
  have g2X1 : φ₂ (wcLlccmcX W (a * a'') 1) = wcLlccmcCst W a a'' * wcLlccmcX W a 1 :=
    (hφ₂ (MvPolynomial.X 1)).trans (by rw [MvPolynomial.eval₂Hom_X']; rfl)
  have g0C : ∀ w : ↥W, φ₀ (wcLlccmcCst W (a * a'') w) = wcLlccmcCst W a'' w := fun w =>
    (hφ₀ (MvPolynomial.C w)).trans (by rw [MvPolynomial.eval₂Hom_C, RingHom.comp_apply])
  have g0X0 : φ₀ (wcLlccmcX W (a * a'') 0) = wcLlccmcCst W a'' a * wcLlccmcX W a'' 0 :=
    (hφ₀ (MvPolynomial.X 0)).trans (by rw [MvPolynomial.eval₂Hom_X']; rfl)
  have g0X1 : φ₀ (wcLlccmcX W (a * a'') 1) = wcLlccmcX W a'' 1 :=
    (hφ₀ (MvPolynomial.X 1)).trans (by rw [MvPolynomial.eval₂Hom_X']; rfl)

  have hS2 : φ₂.comp (θs (a * a'')) = θs a := by
    apply MvPolynomial.ringHom_ext
    · intro w; rw [RingHom.comp_apply, hθC, hθC, g2C]
    · intro i
      obtain rfl : i = 0 := Subsingleton.elim i 0
      rw [RingHom.comp_apply, hθX, hθX, g2X0]
  have hS0 : φ₀.comp (θs (a * a'')) = (θs a'').comp (gs a) := by
    apply MvPolynomial.ringHom_ext
    · intro w; rw [RingHom.comp_apply, RingHom.comp_apply, hθC, hgC, hθC, g0C]
    · intro i
      obtain rfl : i = 0 := Subsingleton.elim i 0
      rw [RingHom.comp_apply, RingHom.comp_apply, hθX, hgX, g0X0]
      simp only [map_mul, hθC, hθX]
  have hSH : gs (a * a'') = (gs a'').comp (gs a) := by
    apply MvPolynomial.ringHom_ext
    · intro w; rw [RingHom.comp_apply, hgC, hgC, hgC]
    · intro i
      obtain rfl : i = 0 := Subsingleton.elim i 0
      simp only [RingHom.comp_apply, hgX, map_mul, hgC, MvPolynomial.C_mul]
      ring
  have hSp2 : Spec.map (CommRingCat.ofHom φ₂) ≫ wcLlccmcTheta W (a * a'') = wcLlccmcTheta W a := by
    rw [hΘ (a * a''), hΘ a, ← Spec.map_comp, ← CommRingCat.ofHom_comp, hS2]
  have hSp0 : Spec.map (CommRingCat.ofHom φ₀) ≫ wcLlccmcTheta W (a * a'') =
      wcLlccmcTheta W a'' ≫ wcLlccmcH W a := by
    rw [hΘ0, hΘ (a * a''), ← Spec.map_comp, ← CommRingCat.ofHom_comp, hS0]
  have hSpH : wcLlccmcH W (a * a'') = wcLlccmcH W a'' ≫ wcLlccmcH W a := by
    rw [hH1, hHs (a * a''), hSH]



  refine ⟨q₀, φ₂, φ₀, g2C, g2X0, g2X1, g0C, g0X0, g0X1, hq₀, ?_, ?_, ?_⟩
  · exact (hbl.2 _ _ P₂).unique (by rw [Category.assoc, hq₀, hR₂])
      (by rw [Category.assoc, he₀, hSp2])
  · exact (hbl.2 _ _ P₀).unique (by rw [Category.assoc, hq₀, hR₀])
      (by rw [Category.assoc, he₀, hSp0])
  · exact (hbl.2 _ _ P₁).unique (by rw [Category.assoc, hq₀, hR₁])
      (by rw [he₁, hSpH])

theorem wcpa_dj_lr1k_llccmc_chart_smooth : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω)
    (Y : Scheme.{u}) (u : Y ⟶ Spec (.of ↥W)),
    (∀ (c : ↥W) (e : Spec (.of (wcLlccmcB W c)) ⟶ Y), IsOpenImmersion e →
      e ≫ u = wcLlccmcTheta W c ≫
        Spec.map (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W)) →
      ∀ q : ↥(Spec (.of (wcLlccmcB W c))),
        (wcLlccmcX W c 0 ∉ q.asIdeal ∨ wcLlccmcX W c 1 ∉ q.asIdeal) →
        ∃ O : Y.Opens, e q ∈ O ∧ SmoothOfRelativeDimension 1 (O.ι ≫ u)) ∧
    (∀ (c : ↥W) (e : Spec (.of (wcLlccmcB W c)) ⟶ Y), IsOpenImmersion e →
      e ≫ u = wcLlccmcTheta W c ≫
        Spec.map (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W)) →
      ∀ q : ↥(Spec (.of (wcLlccmcB W c))),
        wcLlccmcX W c 0 ∈ q.asIdeal → wcLlccmcX W c 1 ∈ q.asIdeal →
        ¬ ∃ O : Y.Opens, e q ∈ O ∧ SmoothOfRelativeDimension 1 (O.ι ≫ u)) ∧
    (∀ (d : Spec (.of (MvPolynomial (Fin 1) ↥W)) ⟶ Y), IsOpenImmersion d →
      d ≫ u = Spec.map (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W)) →
      ∀ p : ↥(Spec (.of (MvPolynomial (Fin 1) ↥W))),
        ∃ O : Y.Opens, d p ∈ O ∧ SmoothOfRelativeDimension 1 (O.ι ≫ u)) :=
by
  intro Ω _ W Y u
  have hθC : ∀ c : ↥W, wcLlccmcTheta W c ≫
      Spec.map (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W)) =
      Spec.map (CommRingCat.ofHom (algebraMap ↥W (MvPolynomial (Fin 2) ↥W ⧸
        Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c}))) := by
    intro c
    rw [← Spec.map_comp]
    congr 1
    apply CommRingCat.hom_ext
    apply RingHom.ext
    intro w
    simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply,
      MvPolynomial.eval₂Hom_C]
    rfl
  have hθH : ∀ c : ↥W, wcLlccmcTheta W c = wcEbdHX W c := by
    intro c
    show Spec.map _ = Spec.map _
    congr 1
    apply CommRingCat.hom_ext
    apply MvPolynomial.ringHom_ext
    · intro w
      simp only [CommRingCat.hom_ofHom, RingHom.comp_apply, MvPolynomial.eval₂Hom_C,
        AlgHom.toRingHom_eq_coe, RingHom.coe_coe, MvPolynomial.rename_C]
    · intro i
      fin_cases i
      simp only [CommRingCat.hom_ofHom, RingHom.comp_apply, MvPolynomial.eval₂Hom_X',
        AlgHom.toRingHom_eq_coe, RingHom.coe_coe, MvPolynomial.rename_X]
  have hqsm : SmoothOfRelativeDimension 1
      (Spec.map (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W))) := by
    rw [HasRingHomProperty.Spec_iff (P := @SmoothOfRelativeDimension 1)]
    apply RingHom.locally_of RingHom.isStandardSmoothOfRelativeDimension_respectsIso
    rw [CommRingCat.hom_ofHom, ← MvPolynomial.algebraMap_eq]
    rw [RingHom.isStandardSmoothOfRelativeDimension_algebraMap]
    have := Algebra.IsStandardSmoothOfRelativeDimension.mvPolynomial (↥W) (Fin 1)
    simpa using this
  refine ⟨?_, ?_, ?_⟩
  · intro c e he heu q hq
    haveI := he
    have key : ∀ i : Fin 2, wcLlccmcX W c i ∉ q.asIdeal →
        ∃ O : Y.Opens, e q ∈ O ∧ SmoothOfRelativeDimension 1 (O.ι ≫ u) := by
      intro i hi
      refine ⟨e ''ᵁ ((Spec (.of (MvPolynomial (Fin 2) ↥W ⧸
        Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c}))).basicOpen
          ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 2) ↥W ⧸
            Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c}))).inv.hom
            (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c})
              (MvPolynomial.X i)))), ?_, ?_⟩
      · show e q ∈ ((e ''ᵁ _ : Y.Opens) : Set Y)
        rw [Scheme.Hom.coe_image]
        refine ⟨q, ?_, rfl⟩
        have e1 := basicOpen_eq_of_affine (R := CommRingCat.of (MvPolynomial (Fin 2) ↥W ⧸
          Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c}))
          (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c})
            (MvPolynomial.X i))
        have hp : q ∈ PrimeSpectrum.basicOpen (Ideal.Quotient.mk
            (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c})
            (MvPolynomial.X i)) := (PrimeSpectrum.mem_basicOpen _ _).mpr hi
        rw [← e1] at hp
        exact hp
      · rw [← Scheme.Hom.isoImage_inv_ι e]
        simp only [Category.assoc]
        rw [heu, hθC]
        haveI := wcpa_dj_ncmb_basicOpen_smooth (↥W) c i
        exact smoothOfRelativeDimension_comp 0 1 _ _
    rcases hq with h | h
    · exact key 0 h
    · exact key 1 h
  · intro c e he heu q h0 h1
    have hv : e ≫ u = 𝟙 (wcEbdQ W c) ≫ (wcEbdHX W c ≫ wcEbdStr W) := by
      rw [Category.id_comp, heu, hθH]
    exact wcpa_dj_lr1k_ebd_quad_node Ω W c (wcEbdQ W c) (wcEbdQ W c) Y (𝟙 _) (𝟙 _)
      (wcEbdHX W c ≫ wcEbdStr W) e u q q inferInstance inferInstance he (Category.id_comp _)
      hv rfl h0 h1
  · intro d hd hdu p
    haveI := hd
    refine ⟨d.opensRange, Scheme.Hom.mem_opensRange.mpr ⟨p, rfl⟩, ?_⟩
    have e0' : d.isoOpensRange.inv ≫ d = d.opensRange.ι :=
      (Iso.inv_comp_eq _).mpr (Scheme.Hom.isoOpensRange_hom_ι d).symm
    have e : d.opensRange.ι ≫ u = d.isoOpensRange.inv ≫
        Spec.map (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W)) := by
      rw [← e0', Category.assoc, hdu]
    rw [e]
    exact smoothOfRelativeDimension_comp 0 1 _ _

theorem wcpa_dj_lr1k_llccmc_node_prime : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (c : ↥W),
    c ∈ IsLocalRing.maximalIdeal ↥W →
    (∃ n : ↥(Spec (.of (wcLlccmcB W c))), n.asIdeal = wcLlccmcN W c) ∧
    (∃ e : ↥(Spec (.of (wcLlccmcB W c))), e.asIdeal = wcLlccmcE W c) ∧
    (∃ f : ↥(Spec (.of (wcLlccmcB W c))), f.asIdeal = wcLlccmcF W c) ∧
    (∃ p : ↥(Spec (.of (MvPolynomial (Fin 1) ↥W))),
      p.asIdeal = Ideal.map (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W)
        (IsLocalRing.maximalIdeal ↥W)) ∧
    wcLlccmcX W c 0 ∈ wcLlccmcN W c ∧ wcLlccmcX W c 1 ∈ wcLlccmcN W c ∧
    (∀ n : ↥(Spec (.of (wcLlccmcB W c))), n.asIdeal = wcLlccmcN W c →
      IsClosed ({n} : Set ↥(Spec (.of (wcLlccmcB W c))))) ∧
    (∀ q : ↥(Spec (.of (wcLlccmcB W c))), wcLlccmcX W c 0 ∈ q.asIdeal →
      wcLlccmcX W c 1 ∈ q.asIdeal →
      (wcLlccmcTheta W c ≫
        Spec.map (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W))) q =
        IsLocalRing.closedPoint ↥W →
      q.asIdeal = wcLlccmcN W c) ∧
    (∀ q : ↥(Spec (.of (wcLlccmcB W c))), q.asIdeal = wcLlccmcN W c ∨ q.asIdeal = wcLlccmcE W c →
      wcLlccmcTheta W c q = Spec.map (CommRingCat.ofHom
        (MvPolynomial.eval (fun _ : Fin 1 => (0 : ↥W)))) (IsLocalRing.closedPoint ↥W)) ∧
    (∀ (q : ↥(Spec (.of (wcLlccmcB W c)))) (p : ↥(Spec (.of (MvPolynomial (Fin 1) ↥W)))),
      q.asIdeal = wcLlccmcF W c →
      p.asIdeal = Ideal.map (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W)
        (IsLocalRing.maximalIdeal ↥W) →
      wcLlccmcTheta W c q = p) :=
by
  intro Ω _ W c hc
  classical
  set I : Ideal (MvPolynomial (Fin 2) ↥W) :=
    Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c} with hIdef
  have hc0 : IsLocalRing.residue ↥W c = 0 := (IsLocalRing.residue_eq_zero_iff c).mpr hc

  have hvan : ∀ {S : Type u} [CommRing S] (f : MvPolynomial (Fin 2) ↥W →+* S),
      f (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c) = 0 → ∀ a ∈ I, f a = 0 := by
    intro S _ f hf a ha
    obtain ⟨t, rfl⟩ := Ideal.mem_span_singleton'.mp ha
    rw [map_mul, hf, mul_zero]

  have hK : ∀ (ψ : MvPolynomial (Fin 2) ↥W →+* MvPolynomial (Fin 2) ↥W)
      (J : Ideal (MvPolynomial (Fin 2) ↥W)),
      (∀ w, ψ (MvPolynomial.C w) = MvPolynomial.C w) →
      (∀ i, MvPolynomial.X i - ψ (MvPolynomial.X i) ∈ J) → ∀ r, r - ψ r ∈ J := by
    intro ψ J hC hX r
    induction r using MvPolynomial.induction_on with
    | C a => rw [hC, sub_self]; exact J.zero_mem
    | add p q hp hq =>
      rw [map_add]
      have e : p + q - (ψ p + ψ q) = (p - ψ p) + (q - ψ q) := by ring
      rw [e]; exact J.add_mem hp hq
    | mul_X p n hp =>
      rw [map_mul]
      have e : p * MvPolynomial.X n - ψ p * ψ (MvPolynomial.X n) =
          (p - ψ p) * MvPolynomial.X n + ψ p * (MvPolynomial.X n - ψ (MvPolynomial.X n)) := by
        ring
      rw [e]
      exact J.add_mem (J.mul_mem_right _ hp) (J.mul_mem_left _ (hX n))

  have hf0 : ((IsLocalRing.residue ↥W).comp
      (MvPolynomial.constantCoeff : MvPolynomial (Fin 2) ↥W →+* ↥W))
      (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c) = 0 := by
    simp [hc0]
  set νN := Ideal.Quotient.lift I ((IsLocalRing.residue ↥W).comp
    (MvPolynomial.constantCoeff : MvPolynomial (Fin 2) ↥W →+* ↥W)) (hvan _ hf0) with hνN
  have hνNmk : ∀ r, νN (Ideal.Quotient.mk I r) =
      IsLocalRing.residue ↥W (MvPolynomial.constantCoeff r) := fun r =>
    Ideal.Quotient.lift_mk _ _ _
  have hkerN : RingHom.ker νN = Ideal.span {Ideal.Quotient.mk I (MvPolynomial.X 0),
      Ideal.Quotient.mk I (MvPolynomial.X 1)} ⊔
      Ideal.map ((Ideal.Quotient.mk I).comp MvPolynomial.C) (IsLocalRing.maximalIdeal ↥W) := by
    apply le_antisymm
    · intro b hb
      obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective b
      rw [RingHom.mem_ker, hνNmk] at hb
      have h0 : MvPolynomial.constantCoeff r ∈ IsLocalRing.maximalIdeal ↥W :=
        (IsLocalRing.residue_eq_zero_iff _).mp hb
      have hJ : r - (MvPolynomial.C.comp MvPolynomial.constantCoeff) r ∈
          Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} := by
        refine hK (MvPolynomial.C.comp MvPolynomial.constantCoeff) _ (fun w => by simp)
          (fun i => ?_) r
        simp only [RingHom.comp_apply, MvPolynomial.constantCoeff_X, map_zero, sub_zero]
        apply Ideal.subset_span
        fin_cases i <;> simp
      have e : Ideal.Quotient.mk I r =
          Ideal.Quotient.mk I (r - (MvPolynomial.C.comp MvPolynomial.constantCoeff) r) +
          ((Ideal.Quotient.mk I).comp MvPolynomial.C) (MvPolynomial.constantCoeff r) := by
        simp only [RingHom.comp_apply]
        rw [← map_add, sub_add_cancel]
      rw [e]
      refine Ideal.add_mem _ (Ideal.mem_sup_left ?_)
        (Ideal.mem_sup_right (Ideal.mem_map_of_mem _ h0))
      have := Ideal.mem_map_of_mem (Ideal.Quotient.mk I) hJ
      rwa [Ideal.map_span, Set.image_pair] at this
    · refine sup_le ?_ ?_
      · rw [Ideal.span_le]
        intro x hx
        rcases hx with rfl | rfl
        · rw [SetLike.mem_coe, RingHom.mem_ker, hνNmk, MvPolynomial.constantCoeff_X, map_zero]
        · rw [SetLike.mem_coe, RingHom.mem_ker, hνNmk, MvPolynomial.constantCoeff_X, map_zero]
      · rw [Ideal.map_le_iff_le_comap]
        intro w hw
        rw [Ideal.mem_comap, RingHom.mem_ker, RingHom.comp_apply, hνNmk,
          MvPolynomial.constantCoeff_C]
        exact (IsLocalRing.residue_eq_zero_iff w).mpr hw
  have hNmax : (Ideal.span {Ideal.Quotient.mk I (MvPolynomial.X 0),
      Ideal.Quotient.mk I (MvPolynomial.X 1)} ⊔
      Ideal.map ((Ideal.Quotient.mk I).comp MvPolynomial.C)
        (IsLocalRing.maximalIdeal ↥W)).IsMaximal := by
    rw [← hkerN]
    apply RingHom.ker_isMaximal_of_surjective
    intro y
    obtain ⟨w, rfl⟩ := IsLocalRing.residue_surjective y
    exact ⟨Ideal.Quotient.mk I (MvPolynomial.C w), by rw [hνNmk, MvPolynomial.constantCoeff_C]⟩

  have hEF : ∀ j : Fin 2, ∃ ν : (MvPolynomial (Fin 2) ↥W ⧸ I) →+*
      MvPolynomial (Fin 2) (IsLocalRing.ResidueField ↥W),
      (∀ w, ν (Ideal.Quotient.mk I (MvPolynomial.C w)) =
        MvPolynomial.C (IsLocalRing.residue ↥W w)) ∧
      (∀ i, ν (Ideal.Quotient.mk I (MvPolynomial.X i)) = if i = j then 0 else MvPolynomial.X i) ∧
      RingHom.ker ν = Ideal.span {Ideal.Quotient.mk I (MvPolynomial.X j)} ⊔
        Ideal.map ((Ideal.Quotient.mk I).comp MvPolynomial.C) (IsLocalRing.maximalIdeal ↥W) := by
    intro j
    set ψ : MvPolynomial (Fin 2) ↥W →+* MvPolynomial (Fin 2) ↥W :=
      MvPolynomial.eval₂Hom MvPolynomial.C (fun i => if i = j then 0 else MvPolynomial.X i)
      with hψ
    have hψC : ∀ w, ψ (MvPolynomial.C w) = MvPolynomial.C w := fun w =>
      MvPolynomial.eval₂Hom_C _ _ _
    have hψX : ∀ i, ψ (MvPolynomial.X i) = if i = j then 0 else MvPolynomial.X i := fun i =>
      MvPolynomial.eval₂Hom_X' _ _ _
    have hf : ((MvPolynomial.map (IsLocalRing.residue ↥W)).comp ψ)
        (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c) = 0 := by
      rw [RingHom.comp_apply, map_sub, map_mul, hψX, hψX, hψC]
      fin_cases j <;> simp [hc0]
    refine ⟨Ideal.Quotient.lift I ((MvPolynomial.map (IsLocalRing.residue ↥W)).comp ψ)
      (hvan _ hf), ?_, ?_, ?_⟩
    · intro w
      rw [Ideal.Quotient.lift_mk, RingHom.comp_apply, hψC, MvPolynomial.map_C]
    · intro i
      rw [Ideal.Quotient.lift_mk, RingHom.comp_apply, hψX]
      split_ifs <;> simp
    · apply le_antisymm
      · intro b hb
        obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective b
        rw [RingHom.mem_ker, Ideal.Quotient.lift_mk, RingHom.comp_apply] at hb
        have h1 : ψ r ∈ Ideal.map MvPolynomial.C (IsLocalRing.maximalIdeal ↥W) := by
          rw [← IsLocalRing.ker_residue, ← MvPolynomial.ker_map]
          exact hb
        have hJ : r - ψ r ∈ Ideal.span {MvPolynomial.X j} := by
          refine hK ψ _ hψC (fun i => ?_) r
          rw [hψX]
          split_ifs with h
          · subst h; rw [sub_zero]; exact Ideal.subset_span rfl
          · rw [sub_self]; exact Ideal.zero_mem _
        have e : Ideal.Quotient.mk I r =
            Ideal.Quotient.mk I (r - ψ r) + Ideal.Quotient.mk I (ψ r) := by
          rw [← map_add, sub_add_cancel]
        rw [e]
        refine Ideal.add_mem _ (Ideal.mem_sup_left ?_) (Ideal.mem_sup_right ?_)
        · have := Ideal.mem_map_of_mem (Ideal.Quotient.mk I) hJ
          rwa [Ideal.map_span, Set.image_singleton] at this
        · have := Ideal.mem_map_of_mem (Ideal.Quotient.mk I) h1
          rwa [Ideal.map_map] at this
      · refine sup_le ?_ ?_
        · rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker,
            Ideal.Quotient.lift_mk, RingHom.comp_apply, hψX, if_pos rfl, map_zero]
        · rw [Ideal.map_le_iff_le_comap]
          intro w hw
          rw [Ideal.mem_comap, RingHom.mem_ker, RingHom.comp_apply, Ideal.Quotient.lift_mk,
            RingHom.comp_apply, hψC, MvPolynomial.map_C,
            (IsLocalRing.residue_eq_zero_iff w).mpr hw, map_zero]
  obtain ⟨νE, hνEC, hνEX, hkerE⟩ := hEF 0
  obtain ⟨νF, hνFC, hνFX, hkerF⟩ := hEF 1
  have hEp : (Ideal.span {Ideal.Quotient.mk I (MvPolynomial.X 0)} ⊔
      Ideal.map ((Ideal.Quotient.mk I).comp MvPolynomial.C)
        (IsLocalRing.maximalIdeal ↥W)).IsPrime := by
    rw [← hkerE]; exact RingHom.ker_isPrime νE
  have hFp : (Ideal.span {Ideal.Quotient.mk I (MvPolynomial.X 1)} ⊔
      Ideal.map ((Ideal.Quotient.mk I).comp MvPolynomial.C)
        (IsLocalRing.maximalIdeal ↥W)).IsPrime := by
    rw [← hkerF]; exact RingHom.ker_isPrime νF

  have hA : RingHom.ker (MvPolynomial.map (IsLocalRing.residue ↥W) :
      MvPolynomial (Fin 1) ↥W →+* MvPolynomial (Fin 1) (IsLocalRing.ResidueField ↥W)) =
      Ideal.map MvPolynomial.C (IsLocalRing.maximalIdeal ↥W) := by
    rw [MvPolynomial.ker_map, IsLocalRing.ker_residue]
  have hAp : (Ideal.map (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W)
      (IsLocalRing.maximalIdeal ↥W)).IsPrime := by
    rw [← hA]; exact RingHom.ker_isPrime _

  set θs : MvPolynomial (Fin 1) ↥W →+* MvPolynomial (Fin 2) ↥W ⧸ I :=
    MvPolynomial.eval₂Hom ((Ideal.Quotient.mk I).comp MvPolynomial.C)
      (fun _ : Fin 1 => Ideal.Quotient.mk I (MvPolynomial.X 0)) with hθs
  have hθC : ∀ w, θs (MvPolynomial.C w) = Ideal.Quotient.mk I (MvPolynomial.C w) := fun w =>
    MvPolynomial.eval₂Hom_C _ _ _
  have hθX : ∀ i, θs (MvPolynomial.X i) = Ideal.Quotient.mk I (MvPolynomial.X 0) := fun i =>
    MvPolynomial.eval₂Hom_X' _ _ _
  set ev0 : MvPolynomial (Fin 1) ↥W →+* ↥W := MvPolynomial.eval (fun _ : Fin 1 => (0 : ↥W))
    with hev0
  refine ⟨⟨(⟨_, hNmax.isPrime⟩ : PrimeSpectrum (MvPolynomial (Fin 2) ↥W ⧸ I)), rfl⟩,
    ⟨(⟨_, hEp⟩ : PrimeSpectrum (MvPolynomial (Fin 2) ↥W ⧸ I)), rfl⟩,
    ⟨(⟨_, hFp⟩ : PrimeSpectrum (MvPolynomial (Fin 2) ↥W ⧸ I)), rfl⟩,
    ⟨(⟨_, hAp⟩ : PrimeSpectrum (MvPolynomial (Fin 1) ↥W)), rfl⟩,
    Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _)),
    Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert_of_mem _ rfl)), ?_, ?_, ?_, ?_⟩
  · intro n hn
    refine (PrimeSpectrum.isClosed_singleton_iff_isMaximal n).mpr ?_
    rw [hn]
    exact hNmax
  · intro q h0 h1 hq
    have hq2 : Ideal.comap MvPolynomial.C (Ideal.comap θs q.asIdeal) =
        IsLocalRing.maximalIdeal ↥W := by
      have := congrArg PrimeSpectrum.asIdeal hq
      exact this
    have hle : Ideal.span {Ideal.Quotient.mk I (MvPolynomial.X 0),
        Ideal.Quotient.mk I (MvPolynomial.X 1)} ⊔
        Ideal.map ((Ideal.Quotient.mk I).comp MvPolynomial.C)
          (IsLocalRing.maximalIdeal ↥W) ≤ q.asIdeal := by
      refine sup_le ?_ ?_
      · rw [Ideal.span_le]
        intro x hx
        rcases hx with rfl | rfl
        · exact h0
        · exact h1
      · rw [Ideal.map_le_iff_le_comap]
        intro w hw
        rw [← hq2, Ideal.mem_comap, Ideal.mem_comap, hθC] at hw
        exact hw
    exact (hNmax.eq_of_le q.isPrime.ne_top hle).symm
  · intro q hq
    apply PrimeSpectrum.ext
    change Ideal.comap θs q.asIdeal = Ideal.comap ev0 (IsLocalRing.maximalIdeal ↥W)
    rcases hq with hq | hq
    · have hq' : q.asIdeal = RingHom.ker νN := hq.trans hkerN.symm
      have hcomp : νN.comp θs = (IsLocalRing.residue ↥W).comp ev0 := by
        apply MvPolynomial.ringHom_ext
        · intro w
          simp only [RingHom.comp_apply]
          rw [hθC, hνNmk, MvPolynomial.constantCoeff_C, hev0, MvPolynomial.eval_C]
        · intro i
          simp only [RingHom.comp_apply]
          rw [hθX, hνNmk, MvPolynomial.constantCoeff_X, hev0, MvPolynomial.eval_X, map_zero]
      rw [hq', RingHom.comap_ker, hcomp, ← RingHom.comap_ker, IsLocalRing.ker_residue]
    · have hq' : q.asIdeal = RingHom.ker νE := hq.trans hkerE.symm
      have hcomp : νE.comp θs = MvPolynomial.C.comp ((IsLocalRing.residue ↥W).comp ev0) := by
        apply MvPolynomial.ringHom_ext
        · intro w
          simp only [RingHom.comp_apply]
          rw [hθC, hνEC, hev0, MvPolynomial.eval_C]
        · intro i
          simp only [RingHom.comp_apply]
          rw [hθX, hνEX, if_pos rfl, hev0, MvPolynomial.eval_X, map_zero, map_zero]
      rw [hq', RingHom.comap_ker, hcomp,
        RingHom.ker_comp_of_injective _ (MvPolynomial.C_injective _ _),
        ← RingHom.comap_ker, IsLocalRing.ker_residue]
  · intro q p hq hp
    apply PrimeSpectrum.ext
    change Ideal.comap θs q.asIdeal = p.asIdeal
    have hq' : q.asIdeal = RingHom.ker νF := hq.trans hkerF.symm
    have hcomp : νF.comp θs = (MvPolynomial.rename (fun _ : Fin 1 => (0 : Fin 2))).toRingHom.comp
        (MvPolynomial.map (IsLocalRing.residue ↥W)) := by
      apply MvPolynomial.ringHom_ext
      · intro w
        simp only [RingHom.comp_apply]
        rw [hθC, hνFC, MvPolynomial.map_C]
        simp
      · intro i
        simp only [RingHom.comp_apply]
        rw [hθX, hνFX, if_neg (by decide), MvPolynomial.map_X]
        simp
    rw [hq', hp, RingHom.comap_ker, hcomp, RingHom.ker_comp_of_injective, hA]
    exact MvPolynomial.rename_injective _ (fun a b _ => Subsingleton.elim a b)

theorem wcpa_dj_lr1k_llccmc_contract_prime : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω)
    (a a'' : ↥W), a ∈ IsLocalRing.maximalIdeal ↥W → a'' ∈ IsLocalRing.maximalIdeal ↥W →
    ∀ (φ₂ : wcLlccmcB W (a * a'') →+* wcLlccmcB W a)
      (φ₀ : wcLlccmcB W (a * a'') →+* wcLlccmcB W a''),
      (∀ w : ↥W, φ₂ (wcLlccmcCst W (a * a'') w) = wcLlccmcCst W a w) →
      φ₂ (wcLlccmcX W (a * a'') 0) = wcLlccmcX W a 0 →
      φ₂ (wcLlccmcX W (a * a'') 1) = wcLlccmcCst W a a'' * wcLlccmcX W a 1 →
      (∀ w : ↥W, φ₀ (wcLlccmcCst W (a * a'') w) = wcLlccmcCst W a'' w) →
      φ₀ (wcLlccmcX W (a * a'') 0) = wcLlccmcCst W a'' a * wcLlccmcX W a'' 0 →
      φ₀ (wcLlccmcX W (a * a'') 1) = wcLlccmcX W a'' 1 →
      (∀ q : ↥(Spec (.of (wcLlccmcB W a))), q.asIdeal = wcLlccmcN W a ∨ q.asIdeal = wcLlccmcE W a →
        (Spec.map (CommRingCat.ofHom φ₂) q : ↥(Spec (.of (wcLlccmcB W (a * a''))))).asIdeal =
          wcLlccmcN W (a * a'')) ∧
      (∀ q : ↥(Spec (.of (wcLlccmcB W a''))), q.asIdeal = wcLlccmcN W a'' →
        (Spec.map (CommRingCat.ofHom φ₀) q : ↥(Spec (.of (wcLlccmcB W (a * a''))))).asIdeal =
          wcLlccmcN W (a * a'')) ∧
      (∀ q e : ↥(Spec (.of (wcLlccmcB W a))), e.asIdeal = wcLlccmcE W a →
        (Spec.map (CommRingCat.ofHom φ₂) q : ↥(Spec (.of (wcLlccmcB W (a * a''))))).asIdeal =
          wcLlccmcN W (a * a'') → e ⤳ q) ∧
      (∀ q g : ↥(Spec (.of (wcLlccmcB W a''))), g.asIdeal = wcLlccmcF W a'' →
        (Spec.map (CommRingCat.ofHom φ₀) q : ↥(Spec (.of (wcLlccmcB W (a * a''))))).asIdeal =
          wcLlccmcN W (a * a'') → g ⤳ q) :=
by
  intro Ω _ W a a'' ham ha''m φ₂ φ₀ h2C h2X0 h2X1 h0C h0X0 h0X1

  have s1 : ∀ p : MvPolynomial (Fin 2) ↥W,
      p - MvPolynomial.C (MvPolynomial.constantCoeff p) ∈
        Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 2) ↥W), MvPolynomial.X 1} := by
    intro p
    induction p using MvPolynomial.induction_on
    · rename_i r
      rw [MvPolynomial.constantCoeff_C, sub_self]
      exact Ideal.zero_mem _
    · rename_i p q hp hq
      have e : p + q - MvPolynomial.C (MvPolynomial.constantCoeff (p + q)) =
          (p - MvPolynomial.C (MvPolynomial.constantCoeff p)) +
          (q - MvPolynomial.C (MvPolynomial.constantCoeff q)) := by
        rw [map_add, map_add]; ring
      rw [e]
      exact Ideal.add_mem _ hp hq
    · rename_i p n _
      have hX : (MvPolynomial.X n : MvPolynomial (Fin 2) ↥W) ∈
          Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 2) ↥W), MvPolynomial.X 1} := by
        fin_cases n
        · exact Ideal.subset_span (Set.mem_insert _ _)
        · exact Ideal.subset_span (Set.mem_insert_of_mem _ rfl)
      rw [map_mul, MvPolynomial.constantCoeff_X, mul_zero, map_zero, sub_zero]
      exact Ideal.mul_mem_left _ p hX

  have memN0 : ∀ c : ↥W, wcLlccmcX W c 0 ∈ wcLlccmcN W c := fun c =>
    Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _))
  have memN1 : ∀ c : ↥W, wcLlccmcX W c 1 ∈ wcLlccmcN W c := fun c =>
    Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert_of_mem _ rfl))
  have memNC : ∀ c w : ↥W, w ∈ IsLocalRing.maximalIdeal ↥W →
      wcLlccmcCst W c w ∈ wcLlccmcN W c := fun c w hw =>
    Ideal.mem_sup_right (Ideal.mem_map_of_mem _ hw)
  have memE0 : ∀ c : ↥W, wcLlccmcX W c 0 ∈ wcLlccmcE W c := fun c =>
    Ideal.mem_sup_left (Ideal.mem_span_singleton_self _)
  have memEC : ∀ c w : ↥W, w ∈ IsLocalRing.maximalIdeal ↥W →
      wcLlccmcCst W c w ∈ wcLlccmcE W c := fun c w hw =>
    Ideal.mem_sup_right (Ideal.mem_map_of_mem _ hw)

  have s2 : ∀ (c : ↥W) (P : Ideal (wcLlccmcB W c)), P ≠ ⊤ → wcLlccmcX W c 0 ∈ P →
      wcLlccmcX W c 1 ∈ P →
      (∀ w : ↥W, w ∈ IsLocalRing.maximalIdeal ↥W → wcLlccmcCst W c w ∈ P) →
      P = wcLlccmcN W c := by
    intro c P hP h0 h1 hC
    have hI0 : Ideal.span {wcLlccmcX W c 0, wcLlccmcX W c 1} ≤ P := by
      rw [Ideal.span_le]
      intro x hx
      rcases hx with rfl | rfl
      · exact h0
      · exact h1
    have hmap : Ideal.map ((Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
        MvPolynomial.C c})).comp MvPolynomial.C) (IsLocalRing.maximalIdeal ↥W) ≤ P := by
      rw [Ideal.map_le_iff_le_comap]
      intro w hw
      exact hC w hw
    apply le_antisymm
    · intro b hb
      obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective b
      have hd : Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
          MvPolynomial.C c}) p - wcLlccmcCst W c (MvPolynomial.constantCoeff p) ∈
          Ideal.span {wcLlccmcX W c 0, wcLlccmcX W c 1} := by
        have h := Ideal.mem_map_of_mem (Ideal.Quotient.mk (Ideal.span
          {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c})) (s1 p)
        rw [Ideal.map_span, Set.image_pair, map_sub] at h
        exact h
      have hwP : wcLlccmcCst W c (MvPolynomial.constantCoeff p) ∈ P := by
        have h := P.sub_mem hb (hI0 hd)
        rwa [sub_sub_cancel] at h
      have hwm : MvPolynomial.constantCoeff p ∈ IsLocalRing.maximalIdeal ↥W := by
        by_contra hn
        have hu : IsUnit (MvPolynomial.constantCoeff p) :=
          IsLocalRing.notMem_maximalIdeal.mp hn
        exact hP (Ideal.eq_top_of_isUnit_mem P hwP (hu.map ((Ideal.Quotient.mk (Ideal.span
          {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c})).comp MvPolynomial.C)))
      have hdN : Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
          MvPolynomial.C c}) p - wcLlccmcCst W c (MvPolynomial.constantCoeff p) ∈
          wcLlccmcN W c := Ideal.mem_sup_left hd
      have h := Ideal.add_mem _ hdN (memNC c _ hwm)
      rwa [sub_add_cancel] at h
    · exact sup_le hI0 hmap
  refine ⟨?_, ?_, ?_, ?_⟩
  ·
    intro q hq
    show Ideal.comap φ₂ q.asIdeal = wcLlccmcN W (a * a'')
    haveI hqp : q.asIdeal.IsPrime := q.isPrime
    apply s2 (a * a'') _ (Ideal.comap_isPrime φ₂ q.asIdeal).ne_top
    · rw [Ideal.mem_comap, h2X0]
      rcases hq with h | h <;> rw [h]
      · exact memN0 a
      · exact memE0 a
    · rw [Ideal.mem_comap, h2X1]
      rcases hq with h | h <;> rw [h]
      · exact Ideal.mul_mem_left _ _ (memN1 a)
      · have e : wcLlccmcCst W a a'' * wcLlccmcX W a 1 =
            wcLlccmcX W a 1 * wcLlccmcCst W a a'' := @mul_comm (wcLlccmcB W a) _ _ _
        rw [e]
        exact Ideal.mul_mem_left _ _ (memEC a a'' ha''m)
    · intro w hw
      rw [Ideal.mem_comap, h2C]
      rcases hq with h | h <;> rw [h]
      · exact memNC a w hw
      · exact memEC a w hw
  ·
    intro q hq
    show Ideal.comap φ₀ q.asIdeal = wcLlccmcN W (a * a'')
    haveI hqp : q.asIdeal.IsPrime := q.isPrime
    apply s2 (a * a'') _ (Ideal.comap_isPrime φ₀ q.asIdeal).ne_top
    · rw [Ideal.mem_comap, h0X0, hq]
      exact Ideal.mul_mem_left _ _ (memN0 a'')
    · rw [Ideal.mem_comap, h0X1, hq]
      exact memN1 a''
    · intro w hw
      rw [Ideal.mem_comap, h0C, hq]
      exact memNC a'' w hw
  ·
    intro q e he hqN
    change Ideal.comap φ₂ q.asIdeal = wcLlccmcN W (a * a'') at hqN
    apply (PrimeSpectrum.le_iff_specializes e q).mp
    apply (PrimeSpectrum.asIdeal_le_asIdeal e q).mp
    rw [he]
    apply sup_le
    · rw [Ideal.span_singleton_le_iff_mem]
      have h := memN0 (a * a'')
      rw [← hqN, Ideal.mem_comap, h2X0] at h
      exact h
    · rw [Ideal.map_le_iff_le_comap]
      intro w hw
      have h := memNC (a * a'') w hw
      rw [← hqN, Ideal.mem_comap, h2C] at h
      exact h
  ·
    intro q g hg hqN
    change Ideal.comap φ₀ q.asIdeal = wcLlccmcN W (a * a'') at hqN
    apply (PrimeSpectrum.le_iff_specializes g q).mp
    apply (PrimeSpectrum.asIdeal_le_asIdeal g q).mp
    rw [hg]
    apply sup_le
    · rw [Ideal.span_singleton_le_iff_mem]
      have h := memN1 (a * a'')
      rw [← hqN, Ideal.mem_comap, h0X1] at h
      exact h
    · rw [Ideal.map_le_iff_le_comap]
      intro w hw
      have h := memNC (a * a'') w hw
      rw [← hqN, Ideal.mem_comap, h0C] at h
      exact h

theorem wcpa_dj_lr1k_llcc_model_contract : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (a a'' : ↥W), a ≠ 0 → a ∈ IsLocalRing.maximalIdeal ↥W →
      a'' ≠ 0 → a'' ∈ IsLocalRing.maximalIdeal ↥W →
    ∃ (M' : Scheme.{u}) (r₀ : M' ⟶ Spec (.of (MvPolynomial (Fin 1) ↥W)))
