    have hNpos : 0 < S.card := Finset.card_pos.mpr ⟨y₀, hfin.mem_toFinset.mpr hI₀⟩
    have hNB : 1 ≤ S.card * B := Nat.one_le_iff_ne_zero.mpr (Nat.mul_ne_zero (by omega) (by omega))
    have hlt1 : ((S.card * B - 1 : ℕ) : ℕ∞) < ((S.card * B : ℕ) : ℕ∞) := by
      exact_mod_cast (show S.card * B - 1 < S.card * B by omega)
    refine lt_of_le_of_lt (iSup_le fun s' => ?_) (lt_of_lt_of_le hlt1 (le_iSup_of_le S (le_of_eq ?_)))
    ·
      set T₁ := s'.filter (fun y => ¬(δ' y = 0 ∨ (δ' y = 1 ∧ m' y = 2)) ∧ I' y) with hT₁
      have hfacts : ∀ y ∈ T₁, ((δ' y).toNat : ℕ∞) = δ' y ∧ ((m' y).toNat : ℕ∞) = m' y ∧
          1 ≤ (δ' y).toNat ∧ 1 ≤ (m' y).toNat ∧
