theorem wcpa_dj_lr1k_llcc_dominate : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (C : Scheme.{u}) (γ : C ⟶ wcProjK Ω 1), wcpaDjLkCov Ω γ → wcpaDjLkGalois γ →
    ∀ (X : Scheme.{u}) (uX : X ⟶ Spec (.of ↥W)) (ι : wcProjK Ω 1 ⟶ X)
      [QuasiCompact (γ ≫ ι)] [QuasiSeparated (γ ≫ ι)],
    wcpaDjLkModel W uX ι →
    ∀ y₀ : ↥(wcpaDjLkFib W (γ ≫ ι) uX),
      wcpaDjLkBad ((wcpaDjLkFib W (γ ≫ ι) uX).presheaf.stalk y₀) →
      wcpaDjLkSmAt W uX (wcpaDjLkPi W (γ ≫ ι) uX y₀) →
    ∀ (σ : Spec (.of ↥W) ⟶ X) (a : ↥W),
      wcpaDjLlPair W uX (wcpaDjLkImg W (γ ≫ ι) uX y₀) σ a →
      wcpaDjLlExh W γ uX ι (wcpaDjLkImg W (γ ≫ ι) uX y₀) σ a →
    ∀ (X' : Scheme.{u}) (r : X' ⟶ X) (ι' : wcProjK Ω 1 ⟶ X')
      [QuasiCompact (γ ≫ ι')] [QuasiSeparated (γ ≫ ι')],
      wcCsdIsBlowup (σ.ker ⊔ wcNcPrincipal (.of ↥W) X uX a) r → ι' ≫ r = ι →
      wcpaDjLkModel W (r ≫ uX) ι' →
      ∀ V : X.Opens, (V : Set X) = {wcpaDjLkImg W (γ ≫ ι) uX y₀}ᶜ → IsIso (r ∣_ V) →
      ∀ y' : ↥(wcpaDjLkFib W (γ ≫ ι') (r ≫ uX)),
        wcpaDjLkBad ((wcpaDjLkFib W (γ ≫ ι') (r ≫ uX)).presheaf.stalk y') →
        r (wcpaDjLkImg W (γ ≫ ι') (r ≫ uX) y') = wcpaDjLkImg W (γ ≫ ι) uX y₀ →
      ∀ (σ'' : Spec (.of ↥W) ⟶ X') (a'' : ↥W),
        wcpaDjLlPair W (r ≫ uX) (wcpaDjLkImg W (γ ≫ ι') (r ≫ uX) y') σ'' a'' →
        wcpaDjLlExh W γ (r ≫ uX) ι' (wcpaDjLkImg W (γ ≫ ι') (r ≫ uX) y') σ'' a'' →
      ∀ (X₂ : Scheme.{u}) (r₂ : X₂ ⟶ X') (ι₂ : wcProjK Ω 1 ⟶ X₂)
        [QuasiCompact (γ ≫ ι₂)] [QuasiSeparated (γ ≫ ι₂)],
        wcCsdIsBlowup (σ''.ker ⊔ wcNcPrincipal (.of ↥W) X' (r ≫ uX) a'') r₂ → ι₂ ≫ r₂ = ι' →
        wcpaDjLkModel W (r₂ ≫ r ≫ uX) ι₂ →
        ∀ V₂ : X'.Opens, (V₂ : Set X') = {wcpaDjLkImg W (γ ≫ ι') (r ≫ uX) y'}ᶜ →
          IsIso (r₂ ∣_ V₂) →
      ∀ (X₁ : Scheme.{u}) (r₁ : X₁ ⟶ X) (ι₁ : wcProjK Ω 1 ⟶ X₁)
        [QuasiCompact (γ ≫ ι₁)] [QuasiSeparated (γ ≫ ι₁)],
        wcCsdIsBlowup ((σ'' ≫ r).ker ⊔ wcNcPrincipal (.of ↥W) X uX (a * a'')) r₁ → ι₁ ≫ r₁ = ι →
        wcpaDjLkModel W (r₁ ≫ uX) ι₁ →
        ∀ V₁ : X.Opens, (V₁ : Set X) = {wcpaDjLkImg W (γ ≫ ι) uX y₀}ᶜ → IsIso (r₁ ∣_ V₁) →
      ∃ q : X₂ ⟶ X₁, q ≫ r₁ = r₂ ≫ r ∧ ι₂ ≫ q = ι₁ :=
by
  intro Ω _ _ W hW hWt C γ hcov hgal X uX ι _ _ hM y₀ hy₀ hSm σ a hP hExh X' r ι' _ _ hbl hι' hM'
    V hV hiso y' hb hi σ'' a'' hP'' hExh'' X₂ r₂ ι₂ _ _ hbl₂ hι₂ hM₂ V₂ hV₂ hiso₂
    X₁ r₁ ι₁ _ _ hbl₁ hι₁ hM₁ V₁ hV₁ hiso₁
  classical

  have idLE : ∀ {Y : Scheme.{u}} (f : Y ⟶ Y), f = 𝟙 Y → ∀ (e : (⊤ : Y.Opens) ≤ f ⁻¹ᵁ ⊤)
      (t : Γ(Y, ⊤)), (f.appLE ⊤ ⊤ e).hom t = t := by
    intro Y f hf e t
    subst hf
    simp only [Scheme.Hom.appLE, Scheme.Hom.id_app]
    show (Y.presheaf.map (𝟙 (Opposite.op (⊤ : Y.Opens)))).hom t = t
    rw [CategoryTheory.Functor.map_id]
    rfl

  have gm : ∀ {Y : Scheme.{u}} (f : Spec (.of ↥W) ⟶ Y) (U : Y.Opens)
      (hU : f (IsLocalRing.closedPoint ↥W) ∈ U) (t : Γ(Y, U)),
      (Scheme.stalkClosedPointTo f).hom ((Y.presheaf.germ U _ hU).hom t) =
        (Scheme.ΓSpecIso (.of ↥W)).hom.hom
          ((f.appLE U ⊤ (Scheme.preimage_eq_top_of_closedPoint_mem f hU).ge).hom t) := by
    intro Y f U hU t
    have h := congrArg (fun φ => φ.hom t) (Scheme.germ_stalkClosedPointTo f U hU)
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at h
    rw [h, Scheme.Hom.appLE]
    simp only [CommRingCat.hom_comp, RingHom.comp_apply]
    rfl

  have top_off : ∀ (Y : Scheme.{u}) (I : Y.IdealSheafData) (x : ↥Y) (U : Y.affineOpens),
      (∀ z : ↥Y, z ∈ (I.support : Set Y) → z = x) → x ∉ U.1 → I.ideal U = ⊤ := by
    intro Y I x U hsupp hxU
    by_contra hne
    obtain ⟨M, hM, hIM⟩ := Ideal.exists_le_maximal _ hne
    let p : PrimeSpectrum Γ(Y, U.1) := ⟨M, hM.isPrime⟩
    have hzU : U.2.fromSpec p ∈ (U.1 : Set Y) := by
      rw [← U.2.range_fromSpec]; exact ⟨p, rfl⟩
    have hz : U.2.fromSpec p ∈ (I.support : Set Y) := by
      refine (Scheme.IdealSheafData.mem_support_iff_of_mem hzU).mpr ?_
      rw [Scheme.mem_zeroLocus_iff]
      intro f hf hb
      have h1 : p ∈ U.2.fromSpec ⁻¹ᵁ Y.basicOpen f := hb
      rw [U.2.fromSpec_preimage_basicOpen] at h1
      exact (PrimeSpectrum.mem_basicOpen _ _).mp h1 (hIM hf)
    exact hxU (hsupp _ hz ▸ hzU)

  have alg : ∀ (A : Type u) [CommRing A] (φ₁ φ₂ : A →+* ↥W) (ψ : ↥W →+* A),
      (∀ c, φ₂ (ψ c) = c) → (∀ g, φ₁ g = 0 → ∃ e, φ₂ g = a * e) →
      RingHom.ker φ₁ ⊔ Ideal.span {ψ a} ≤ RingHom.ker φ₂ ⊔ Ideal.span {ψ a} := by
    intro A _ φ₁ φ₂ ψ h2 H
    refine sup_le ?_ le_sup_right
    intro g hg
    obtain ⟨e, he⟩ := H g (RingHom.mem_ker.mp hg)
    have hk : g - ψ a * ψ e ∈ RingHom.ker φ₂ := by
      rw [RingHom.mem_ker, map_sub, map_mul, h2, h2, he, sub_self]
    have hp : ψ e * ψ a ∈ Ideal.span {ψ a} := Ideal.mul_mem_left _ _ (Ideal.subset_span rfl)
    have hg' : g = (g - ψ a * ψ e) + ψ e * ψ a := by ring
    rw [hg']
