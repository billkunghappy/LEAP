      ((IsLocalRing.maximalIdeal _).comap (C.presheaf.stalkSpecializes (hjx y)).hom).primeCompl s
    have hspec := IsLocalization.mk'_spec (C.presheaf.stalk (C.fromSpecStalk x y)) a ⟨b, hb⟩
    refine ⟨a, b, ?_, ?_⟩
    · rw [CommRingCat.hom_comp, RingHom.comp_apply]
      intro h0
      apply hb
      exact (IsLocalRing.residue_eq_zero_iff ((C.presheaf.stalkSpecializes (hjx y)).hom b)).mp h0
    · rw [CommRingCat.hom_comp, RingHom.comp_apply, RingHom.comp_apply, ← map_mul, ← hab]
      exact congrArg _ hspec

theorem wcpa_dj_lr1k_llnc_bv_generic_kernel : ∀ (F : Scheme.{u}) (y ξ ξ' : ↥F) (h : ξ ⤳ y) (h' : ξ' ⤳ y), (closure ({ξ} : Set ↥F) ∈ irreducibleComponents ↥F → RingHom.ker (F.presheaf.stalkSpecializes h ≫ F.residue ξ).hom ∈ minimalPrimes ↥(F.presheaf.stalk y)) ∧ (RingHom.ker (F.presheaf.stalkSpecializes h ≫ F.residue ξ).hom = RingHom.ker (F.presheaf.stalkSpecializes h' ≫ F.residue ξ').hom → ξ = ξ') :=
by
  intro F y ξ ξ' h h'
  have s1 : ∀ (η : ↥F) (hη : η ⤳ y), ∃ p : PrimeSpectrum ↥(F.presheaf.stalk y),
      p.asIdeal = RingHom.ker (F.presheaf.stalkSpecializes hη ≫ F.residue η).hom ∧
      F.fromSpecStalk y p = η := by
    intro η hη
    set s : ↥(Spec (F.residueField η)) := IsLocalRing.closedPoint ↥(F.residueField η) with hs
    refine ⟨Spec.map (F.presheaf.stalkSpecializes hη ≫ F.residue η) s, ?_, ?_⟩
    · rw [Spec.map_apply, PrimeSpectrum.comap_asIdeal]
      have hbot : s.asIdeal = ⊥ := by
        rw [hs]
        exact IsLocalRing.maximalIdeal_eq_bot
      rw [hbot, RingHom.ker_eq_comap_bot]
    · rw [← Scheme.Hom.comp_apply, Spec.map_comp, Category.assoc,
        Scheme.SpecMap_stalkSpecializes_fromSpecStalk, Scheme.Hom.comp_apply,
        Scheme.SpecMap_residue_apply, Scheme.fromSpecStalk_closedPoint]
  have s2 : ∀ P : PrimeSpectrum ↥(F.presheaf.stalk y),
      closure ({F.fromSpecStalk y P} : Set ↥F) ∈ irreducibleComponents ↥F →
      P.asIdeal ∈ minimalPrimes ↥(F.presheaf.stalk y) := by
    intro P hP
    have hind : Topology.IsInducing (F.fromSpecStalk y) :=
      (Scheme.Hom.isEmbedding (F.fromSpecStalk y)).isInducing
    rw [← PrimeSpectrum.isMin_iff]
    intro Q hQ
    have h1 : Q ⤳ P := (PrimeSpectrum.le_iff_specializes Q P).mp hQ
    have h2 : F.fromSpecStalk y Q ⤳ F.fromSpecStalk y P :=
      h1.map (Scheme.Hom.continuous _)
    have h3 := specializes_iff_closure_subset.mp h2
    have h4 : closure ({F.fromSpecStalk y Q} : Set ↥F) ⊆ closure {F.fromSpecStalk y P} :=
      hP.le_of_ge isIrreducible_singleton.closure h3
    have h5 : F.fromSpecStalk y P ⤳ F.fromSpecStalk y Q :=
      specializes_iff_mem_closure.mpr (h4 (subset_closure rfl))
    exact (PrimeSpectrum.le_iff_specializes P Q).mpr (hind.specializes_iff.mp h5)
  refine ⟨fun hc => ?_, fun hk => ?_⟩
  · obtain ⟨p, hp, hpξ⟩ := s1 ξ h
    rw [← hpξ] at hc
    rw [← hp]
    exact s2 p hc
  · obtain ⟨p, hp, hpξ⟩ := s1 ξ h
    obtain ⟨p', hp', hpξ'⟩ := s1 ξ' h'
    have hpp : p = p' := PrimeSpectrum.ext (hp.trans (hk.trans hp'.symm))
    rw [← hpξ, ← hpξ', hpp]

theorem wcpa_dj_lr1k_llnc_bv_frac_pi : ∀ (R : Type u) [CommRing R] [_root_.IsReduced R] [IsNoetherianRing R] (ι : Type u) (K : ι → Type u) [∀ i, Field (K i)] [∀ i, Algebra R (K i)], Function.Injective (fun i => RingHom.ker (algebraMap R (K i))) → (∀ i, RingHom.ker (algebraMap R (K i)) ∈ minimalPrimes R) → (∀ p ∈ minimalPrimes R, ∃ i, RingHom.ker (algebraMap R (K i)) = p) → (∀ (i : ι) (f : K i), ∃ a b : R, algebraMap R (K i) b ≠ 0 ∧ f * algebraMap R (K i) b = algebraMap R (K i) a) → Finite ι ∧ Nonempty (FractionRing R ≃ₐ[R] ((i : ι) → K i)) :=
by
  intro R _ _ _ ι K _ _ H1 H2 H3 H4
  classical

  have hfin : Finite ι := by
    have hmf : (minimalPrimes R).Finite := minimalPrimes.finite_of_isNoetherianRing R
    haveI := hmf.to_subtype
    exact Finite.of_injective
      (fun i => (⟨RingHom.ker (algebraMap R (K i)), H2 i⟩ : minimalPrimes R))
      (fun i j h => H1 (congrArg Subtype.val h))
  haveI := hfin
  letI : Fintype ι := Fintype.ofFinite ι

  have hker : ∀ w : R, (∀ i, algebraMap R (K i) w = 0) → w = 0 := by
    intro w hw
    have hmem : ∀ J : Ideal R, J.IsPrime → w ∈ J := by
      intro J hJ
      obtain ⟨p, hp, hpJ⟩ := Ideal.exists_minimalPrimes_le (I := ⊥) (J := J) bot_le
      obtain ⟨i, hi⟩ := H3 p hp
      apply hpJ
      rw [← hi, RingHom.mem_ker]
      exact hw i
    exact IsNilpotent.eq_zero (nilpotent_iff_mem_prime.mpr hmem)

  have hsep : ∀ i, ∃ e : R, algebraMap R (K i) e ≠ 0 ∧
      ∀ j, j ≠ i → algebraMap R (K j) e = 0 := by
    intro i
    have hf : ∀ j, j ≠ i → ∃ f : R, algebraMap R (K j) f = 0 ∧ algebraMap R (K i) f ≠ 0 := by
      intro j hji
      have hnle : ¬ RingHom.ker (algebraMap R (K j)) ≤ RingHom.ker (algebraMap R (K i)) := by
        intro hle
        have hmin : Minimal Ideal.IsPrime (RingHom.ker (algebraMap R (K i))) := by
          have := H2 i
          rwa [minimalPrimes_eq_minimals] at this
        have heq := hmin.eq_of_le (RingHom.ker_isPrime _) hle
        exact hji (H1 heq)
      obtain ⟨f, hf1, hf2⟩ := SetLike.not_le_iff_exists.mp hnle
      exact ⟨f, RingHom.mem_ker.mp hf1, fun h => hf2 (RingHom.mem_ker.mpr h)⟩
    choose! f hf using hf
    refine ⟨∏ j, (if j = i then 1 else f j), ?_, ?_⟩
    · rw [map_prod, Finset.prod_ne_zero_iff]
      intro j _
      split_ifs with h
      · simp
      · exact (hf j h).2
    · intro j hji
      rw [map_prod]
      apply Finset.prod_eq_zero (Finset.mem_univ j)
      rw [if_neg hji]
      exact (hf j hji).1

  have hloc : IsLocalization (nonZeroDivisors R) ((i : ι) → K i) := by
    rw [isLocalization_iff]
    refine ⟨?_, ?_, ?_⟩
    · intro t
      rw [Pi.isUnit_iff]
      intro i
      rw [Pi.algebraMap_apply]
      apply Ne.isUnit
      intro h0
      have hd := Ideal.disjoint_nonZeroDivisors_of_mem_minimalPrimes (H2 i)
      exact Set.disjoint_left.mp hd (RingHom.mem_ker.mpr h0) t.2
    · intro z
      choose a b hb hab using fun i => H4 i (z i)
      choose e he1 he2 using hsep
      have hcomp : ∀ (c : ι → R) (i : ι), algebraMap R (K i) (∑ j, e j * c j) =
          algebraMap R (K i) (e i) * algebraMap R (K i) (c i) := by
        intro c i
        rw [map_sum, Finset.sum_eq_single i]
        · rw [map_mul]
        · intro j _ hji
          rw [map_mul, he2 j i (Ne.symm hji), zero_mul]
        · intro h
          exact absurd (Finset.mem_univ i) h
      have hs : (∑ j, e j * b j) ∈ nonZeroDivisors R := by
        rw [mem_nonZeroDivisors_iff_right]
        intro y hy
        apply hker
        intro i
        have h1 : algebraMap R (K i) y * algebraMap R (K i) (∑ j, e j * b j) = 0 := by
          rw [← map_mul, hy, map_zero]
        rw [hcomp] at h1
        exact (mul_eq_zero.mp h1).resolve_right (mul_ne_zero (he1 i) (hb i))
      refine ⟨(∑ j, e j * a j, ⟨∑ j, e j * b j, hs⟩), ?_⟩
      funext i
      simp only [Pi.mul_apply, Pi.algebraMap_apply]
      rw [hcomp, hcomp, mul_left_comm, hab]
    · intro x y h
      refine ⟨1, ?_⟩
      have hxy : x - y = 0 := by
        apply hker
        intro i
        have := congrFun h i
        simp only [Pi.algebraMap_apply] at this
        rw [map_sub, this, sub_self]
      rw [sub_eq_zero.mp hxy]
  exact ⟨hfin, ⟨IsLocalization.algEquiv (nonZeroDivisors R) (FractionRing R) ((i : ι) → K i)⟩⟩

theorem wcpa_dj_lr1k_llnc_bv_intclosure_pi : ∀ (R : Type u) [CommRing R] (A : Type u) [CommRing A] [Algebra R A] (ι : Type u) [Finite ι] (B : ι → Type u) [∀ i, CommRing (B i)] [∀ i, Algebra R (B i)], (A ≃ₐ[R] ((i : ι) → B i)) → Nonempty (MaximalSpectrum ↥(integralClosure R A) ≃ (Σ i : ι, MaximalSpectrum ↥(integralClosure R (B i)))) ∧ (Module.Finite R ↥(integralClosure R A) → ∀ i, Module.Finite R ↥(integralClosure R (B i))) :=
by
  intro R _ A _ _ ι _ B _ _ e
  classical
  haveI := Fintype.ofFinite ι

  have hint : ∀ x : (i : ι) → B i, (∀ i, _root_.IsIntegral R (x i)) → _root_.IsIntegral R x := by
    intro x hx
    have hx' : ∀ i, ∃ p : Polynomial R, p.Monic ∧ Polynomial.aeval (x i) p = 0 := fun i => hx i
    choose p hpm hp using hx'
    refine ⟨∏ i, p i, Polynomial.monic_prod_of_monic _ _ (fun i _ => hpm i), ?_⟩
    show Polynomial.aeval x (∏ i, p i) = 0
    rw [map_prod]
    funext j
    rw [Finset.prod_apply]
    refine Finset.prod_eq_zero (Finset.mem_univ j) ?_
    exact (Polynomial.aeval_algHom_apply (Pi.evalAlgHom R B j) x (p j)).symm.trans (hp j)

  let Φ : ↥(integralClosure R ((i : ι) → B i)) →ₐ[R] ((i : ι) → ↥(integralClosure R (B i))) :=
    Pi.algHom R _ (fun i => ((Pi.evalAlgHom R B i).comp
      (integralClosure R ((i : ι) → B i)).val).codRestrict (integralClosure R (B i))
      (fun x => _root_.IsIntegral.map (Pi.evalAlgHom R B i) x.2))
  have hΦ : Function.Bijective Φ := by
    constructor
    · intro x y h
      apply Subtype.ext
      funext i
      exact congrArg Subtype.val (congrFun h i)
    · intro y
      refine ⟨⟨fun i => (y i).1, hint _ (fun i => (y i).2)⟩, ?_⟩
      funext i
      exact Subtype.ext rfl
  let E : ↥(integralClosure R A) ≃ₐ[R] ((i : ι) → ↥(integralClosure R (B i))) :=
    (AlgEquiv.mapIntegralClosure e).trans (AlgEquiv.ofBijective Φ hΦ)
  refine ⟨?_, ?_⟩
  ·
    let C : ι → Type u := fun i => ↥(integralClosure R (B i))

    let T : MaximalSpectrum ↥(integralClosure R A) ≃ MaximalSpectrum ((i : ι) → C i) :=
      { toFun := fun m => ⟨Ideal.comap E.symm.toRingEquiv m.asIdeal,
          by haveI := m.isMaximal; exact Ideal.comap_isMaximal_of_equiv _⟩
        invFun := fun n => ⟨Ideal.comap E.toRingEquiv n.asIdeal,
          by haveI := n.isMaximal; exact Ideal.comap_isMaximal_of_equiv _⟩
        left_inv := fun m => by
          apply MaximalSpectrum.ext
          ext x
          simp
        right_inv := fun n => by
          apply MaximalSpectrum.ext
          ext x
          simp }

    let g : (Σ i : ι, MaximalSpectrum (C i)) → MaximalSpectrum ((i : ι) → C i) :=
      fun a => ⟨Ideal.comap (Pi.evalRingHom C a.1) a.2.asIdeal,
        Ideal.IsMaximal.comap_piEvalRingHom a.2.isMaximal⟩
    have hσ := PrimeSpectrum.sigmaToPi_bijective C
    have hσapp : ∀ (i : ι) (p : PrimeSpectrum (C i)),
        (PrimeSpectrum.sigmaToPi C ⟨i, p⟩).asIdeal = Ideal.comap (Pi.evalRingHom C i) p.asIdeal :=
      fun i p => rfl
    have hg : Function.Bijective g := by
      constructor
      · rintro ⟨i, m⟩ ⟨j, n⟩ h
        have h1 : PrimeSpectrum.sigmaToPi C ⟨i, ⟨m.asIdeal, m.isMaximal.isPrime⟩⟩ =
            PrimeSpectrum.sigmaToPi C ⟨j, ⟨n.asIdeal, n.isMaximal.isPrime⟩⟩ := by
          apply PrimeSpectrum.ext
          rw [hσapp, hσapp]
          exact congrArg MaximalSpectrum.asIdeal h
        have h2 := hσ.1 h1
        rcases Sigma.mk.inj_iff.mp h2 with ⟨rfl, h3⟩
        have h4 := eq_of_heq h3
        have h5 : m = n := MaximalSpectrum.ext (congrArg PrimeSpectrum.asIdeal h4)
        rw [h5]
      · intro M
        obtain ⟨⟨i, p⟩, hp⟩ := hσ.2 ⟨M.asIdeal, M.isMaximal.isPrime⟩
        have hM : M.asIdeal = Ideal.comap (Pi.evalRingHom C i) p.asIdeal := by
          rw [← hσapp, hp]
        have hsurj : Function.Surjective (Pi.evalRingHom C i) := fun c =>
          ⟨Pi.single i c, Pi.single_eq_same i c⟩
        have hmap : Ideal.map (Pi.evalRingHom C i) M.asIdeal = p.asIdeal := by
          rw [hM, Ideal.map_comap_of_surjective _ hsurj]
        have hmax : p.asIdeal.IsMaximal := by
          rcases Ideal.map_eq_top_or_isMaximal_of_surjective _ hsurj M.isMaximal with h | h
          · rw [hmap] at h
            exact absurd h p.isPrime.ne_top
          · rwa [hmap] at h
        refine ⟨⟨i, ⟨p.asIdeal, hmax⟩⟩, ?_⟩
        apply MaximalSpectrum.ext
        exact hM.symm
    exact ⟨T.trans (Equiv.ofBijective g hg).symm⟩
  · intro hfin i
    let L : ↥(integralClosure R A) →ₗ[R] ↥(integralClosure R (B i)) :=
      ((Pi.evalAlgHom R (fun i => ↥(integralClosure R (B i))) i).comp E.toAlgHom).toLinearMap
    have hL : Function.Surjective L := by
      intro c
      refine ⟨E.symm (Pi.single i c), ?_⟩
      show (E (E.symm (Pi.single i c))) i = c
      rw [AlgEquiv.apply_symm_apply, Pi.single_eq_same]
    exact Module.Finite.of_surjective L hL

theorem wcpa_dj_lr1k_llnc_bv_dedekind : ∀ (R : Type u) [CommRing R] [IsLocalRing R] [IsNoetherianRing R] (K : Type u) [Field K] [Algebra R K], ringKrullDim R ≤ ((1 : ℕ) : WithBot ℕ∞) → (∀ f : K, ∃ a b : R, algebraMap R K b ≠ 0 ∧ f * algebraMap R K b = algebraMap R K a) → Module.Finite R ↥(integralClosure R K) → IsDedekindDomain ↥(integralClosure R K) ∧ IsFractionRing ↥(integralClosure R K) K :=
by
  intro R _ _ _ K _ _ hdim hfrac hfin
  haveI : Module.Finite R ↥(integralClosure R K) := hfin
  haveI hFS : FaithfulSMul ↥(integralClosure R K) K :=
    (faithfulSMul_iff_algebraMap_injective _ _).mpr Subtype.val_injective
  haveI hFR : IsFractionRing ↥(integralClosure R K) K := by
    refine IsFractionRing.of_field _ K ?_
    intro z
    obtain ⟨a, b, hb, hab⟩ := hfrac z
    refine ⟨algebraMap R _ a, algebraMap R _ b, ?_⟩
    rw [← IsScalarTower.algebraMap_apply, ← IsScalarTower.algebraMap_apply]
    rw [eq_div_iff hb]
    exact hab
  haveI hNoeth : IsNoetherianRing ↥(integralClosure R K) := IsNoetherianRing.of_finite R _
  have hdim1 : Ring.DimensionLEOne ↥(integralClosure R K) := by
    have h1 : Ring.KrullDimLE 1 R := Ring.krullDimLE_iff.mpr hdim
    refine ⟨fun {P} hP0 hP => ?_⟩
    haveI := hP
    haveI : (⊥ : Ideal ↥(integralClosure R K)).IsPrime := Ideal.isPrime_bot
    have hlt : Ideal.under R (⊥ : Ideal ↥(integralClosure R K)) < Ideal.under R P :=
      Ideal.IsIntegral.under_lt_under (bot_lt_iff_ne_bot.mpr hP0)
    have hQ : (Ideal.under R P).IsPrime := Ideal.IsPrime.under R P
    have hQ0 : (Ideal.under R (⊥ : Ideal ↥(integralClosure R K))).IsPrime :=
      Ideal.IsPrime.under R ⊥
    rcases Ring.krullDimLE_one_iff.mp h1 (Ideal.under R P) hQ with hmin | hmax
    · rw [minimalPrimes_eq_minimals] at hmin
      exact absurd (hmin.2 hQ0 hlt.le) hlt.not_ge
    · exact Ideal.isMaximal_of_isIntegral_of_isMaximal_under P hmax
  refine ⟨(isDedekindDomain_iff _ K).mpr ⟨inferInstance, hNoeth, hdim1, ?_⟩, hFR⟩
  intro x hx
  exact IsIntegralClosure.isIntegral_iff (R := R).mp (isIntegral_trans (R := R) x hx)

theorem wcpa_dj_lr1k_llnc_bv_val_maxspec : ∀ (R : Type u) [CommRing R] [IsLocalRing R] (K : Type u) [Field K] [Algebra R K], IsDedekindDomain ↥(integralClosure R K) → IsFractionRing ↥(integralClosure R K) K → Nonempty (↥{V : ValuationSubring K | ∀ s : R, ∃ hs : algebraMap R K s ∈ V, s ∈ IsLocalRing.maximalIdeal R → (⟨algebraMap R K s, hs⟩ : V) ∈ IsLocalRing.maximalIdeal V} ≃ MaximalSpectrum ↥(integralClosure R K)) :=
by
  intro R _ _ K _ _ hDed hFrac
  classical

  have dedLocal : ∀ (A : Subring K) [IsDedekindDomain ↥A] [IsFractionRing (↥A) K]
      (V : ValuationSubring K), A ≤ V.toSubring → V ≠ ⊤ →
      ∀ x : K, x ∈ V → ∃ a s : K, a ∈ A ∧ s ∈ A ∧ s ≠ 0 ∧ s⁻¹ ∈ V ∧ x = a / s := by
    intro A _ _ V hAV hV
    have hcoe : ∀ y : ↥A, algebraMap (↥A) K y = (y : K) := fun _ => rfl
    let ι : ↥A →+* ↥V :=
      { toFun := fun a => ⟨(a : K), hAV a.2⟩
        map_one' := rfl
        map_mul' := fun _ _ => rfl
        map_zero' := rfl
        map_add' := fun _ _ => rfl }
    have hU : ∀ (y : K) (hy : y ∈ V), IsUnit (⟨y, hy⟩ : ↥V) ↔ (y ≠ 0 ∧ y⁻¹ ∈ V) := by
      intro y hy
      constructor
      · rintro ⟨u, hu⟩
        have h1 : y * (((u⁻¹ : (↥V)ˣ) : ↥V) : K) = 1 := by
          have := congrArg Subtype.val u.mul_inv
          rw [hu] at this
          exact this
        have hy0 : y ≠ 0 := left_ne_zero_of_mul_eq_one h1
        refine ⟨hy0, ?_⟩
        rw [← eq_inv_of_mul_eq_one_right h1]
        exact (((u⁻¹ : (↥V)ˣ) : ↥V)).2
      · rintro ⟨hy0, hyi⟩
        exact isUnit_iff_exists_inv.mpr ⟨⟨y⁻¹, hyi⟩, Subtype.ext (mul_inv_cancel₀ hy0)⟩
    set P : Ideal ↥A := Ideal.comap ι (IsLocalRing.maximalIdeal ↥V) with hPdef
    have hPprime : P.IsPrime := Ideal.comap_isPrime ι _
    have hP : ∀ s : ↥A, s ∉ P ↔ ((s : K) ≠ 0 ∧ (s : K)⁻¹ ∈ V) := by
      intro s
      rw [hPdef, Ideal.mem_comap, IsLocalRing.notMem_maximalIdeal]
      exact hU (s : K) (hAV s.2)
    have hP0 : P ≠ ⊥ := by
      intro hbot
      apply hV
      ext x
      simp only [ValuationSubring.mem_top, iff_true]
      obtain ⟨a, b, hb, rfl⟩ := IsFractionRing.div_surjective (A := ↥A) x
      have hb0 : b ≠ 0 := nonZeroDivisors.ne_zero hb
      have hbP : b ∉ P := by rw [hbot, Ideal.mem_bot]; exact hb0
      obtain ⟨_, hbinv⟩ := (hP b).1 hbP
      rw [hcoe, hcoe, div_eq_mul_inv]
      exact V.mul_mem _ _ (hAV a.2) hbinv
    have : IsDiscreteValuationRing (Localization.AtPrime P) :=
      IsLocalization.AtPrime.isDiscreteValuationRing_of_dedekind_domain ↥A hP0 _
    intro x hx
    by_cases hx0 : x = 0
    · exact ⟨0, 1, A.zero_mem, A.one_mem, one_ne_zero, by rw [inv_one]; exact V.one_mem,
        by rw [hx0, zero_div]⟩
    obtain ⟨a, b, hb, rfl⟩ := IsFractionRing.div_surjective (A := ↥A) x
    rw [hcoe, hcoe] at hx hx0 ⊢
    have hb0 : (b : K) ≠ 0 := by
      have := IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors (K := K) hb
      rwa [hcoe] at this
    set j := algebraMap (↥A) (Localization.AtPrime P) with hjdef
    have hj : Function.Injective j :=
      IsLocalization.injective (Localization.AtPrime P) (Ideal.primeCompl_le_nonZeroDivisors P)
    obtain ⟨c, hc⟩ := ValuationRing.cond (j a) (j b)
    obtain ⟨⟨r, t⟩, rfl⟩ := IsLocalization.mk'_surjective P.primeCompl c
    have hspec := IsLocalization.mk'_spec (Localization.AtPrime P) r t
    have htP : (t : ↥A) ∉ P := t.2
    obtain ⟨ht0, htinv⟩ := (hP t).1 htP
    rcases hc with hc | hc
    · have e : a * r = b * (t : ↥A) := hj (by
        rw [map_mul, map_mul, ← hc, mul_assoc, hspec])
      have eF : (a : K) * (r : K) = (b : K) * ((t : ↥A) : K) := congrArg Subtype.val e
      have hr0 : (r : K) ≠ 0 := by
        intro h
        rw [h, mul_zero] at eF
        exact mul_ne_zero hb0 ht0 eF.symm
      by_cases hr : r ∈ P
      · exfalso
        apply (hP r).2 _ hr
        refine ⟨hr0, ?_⟩
        have : (r : K)⁻¹ = (a : K) / (b : K) * ((t : ↥A) : K)⁻¹ := by
          field_simp
          linear_combination -eF
        rw [this]
        exact V.mul_mem _ _ hx htinv
      · obtain ⟨_, hrinv⟩ := (hP r).1 hr
        refine ⟨((t : ↥A) : K), (r : K), (t : ↥A).2, r.2, hr0, hrinv, ?_⟩
        rw [div_eq_div_iff hb0 hr0]
        linear_combination eF
    · have e : b * r = a * (t : ↥A) := hj (by
        rw [map_mul, map_mul, ← hc, mul_assoc, hspec])
      have eF : (b : K) * (r : K) = (a : K) * ((t : ↥A) : K) := congrArg Subtype.val e
      refine ⟨(r : K), ((t : ↥A) : K), r.2, (t : ↥A).2, ht0, htinv, ?_⟩
      rw [div_eq_div_iff hb0 ht0]
      linear_combination -eF

  have domVal : ∀ (Q : Ideal ↥(integralClosure R K)), Q.IsPrime →
      ∃ V : ValuationSubring K, (∀ x : ↥(integralClosure R K), (x : K) ∈ V) ∧
        ∀ x : ↥(integralClosure R K), x ∈ Q ↔ V.valuation (x : K) < 1 := by
    intro Q hQ
    let S0 : Subring K := (integralClosure R K).toSubring
    let φ : S0 →+* ↥(integralClosure R K) :=
      { toFun := fun x => ⟨(x : K), x.2⟩
        map_one' := rfl
        map_mul' := fun _ _ => rfl
        map_zero' := rfl
        map_add' := fun _ _ => rfl }
    let Q' : Ideal S0 := Q.comap φ
    have : Q'.IsPrime := Ideal.comap_isPrime φ Q
    let P := LocalSubring.ofPrime S0 Q'
    obtain ⟨B, hle⟩ := LocalSubring.exists_le_valuationSubring P
    obtain ⟨hPB, hloc⟩ := LocalSubring.le_def.mp hle
    refine ⟨B, ?_, ?_⟩
    · intro x
      exact hPB (LocalSubring.le_ofPrime S0 Q' x.2)
    · intro x
      let x' : S0 := ⟨(x : K), x.2⟩
      let y : P.toSubring := algebraMap S0 P.toSubring x'
      let z : B := Subring.inclusion hPB y
      have hz : (z : K) = (x : K) := rfl
      have h1 : x ∈ Q ↔ y ∈ IsLocalRing.maximalIdeal P.toSubring := by
        rw [IsLocalization.AtPrime.to_map_mem_maximal_iff P.toSubring Q' x']
        rfl
      have h2 : y ∈ IsLocalRing.maximalIdeal P.toSubring ↔ z ∈ IsLocalRing.maximalIdeal B := by
        rw [IsLocalRing.mem_maximalIdeal, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff,
          mem_nonunits_iff]
        constructor
        · intro h hu
          exact h (hloc.map_nonunit y hu)
        · intro h hu
          exact h (hu.map (Subring.inclusion hPB))
      rw [h1, h2, B.valuation_lt_one_iff z, hz]

  have s1 : ∀ V : ValuationSubring K, (∀ s : R, algebraMap R K s ∈ V) →
      ∀ x : ↥(integralClosure R K), (x : K) ∈ V := by
    intro V hV x
    have hx : IsIntegral R (x : K) := x.2
    obtain ⟨p, hpm, hp⟩ := hx
    let f : R →+* V := (algebraMap R K).codRestrict V hV
    have hcomp : (algebraMap V K).comp f = algebraMap R K := RingHom.ext fun _ => rfl
    have hint : IsIntegral V (x : K) :=
      ⟨p.map f, hpm.map f, by rw [Polynomial.eval₂_map, hcomp]; exact hp⟩
    obtain ⟨y, hy⟩ := IsIntegrallyClosed.isIntegral_iff.mp hint
    rw [← hy]
    exact y.2

  let P : (V : ValuationSubring K) → (∀ x : ↥(integralClosure R K), (x : K) ∈ V) →
      Ideal ↥(integralClosure R K) := fun V hA =>
    Ideal.comap ((algebraMap (integralClosure R K) K).codRestrict V hA)
      (IsLocalRing.maximalIdeal V)
  have hPmem : ∀ (V : ValuationSubring K) (hA : ∀ x : ↥(integralClosure R K), (x : K) ∈ V)
      (x : ↥(integralClosure R K)), x ∈ P V hA ↔ V.valuation (x : K) < 1 := by
    intro V hA x
    exact ValuationSubring.valuation_lt_one_iff V
      ((algebraMap (integralClosure R K) K).codRestrict V hA x)
  have hPprime : ∀ (V : ValuationSubring K) (hA : ∀ x : ↥(integralClosure R K), (x : K) ∈ V),
      (P V hA).IsPrime := fun V hA => Ideal.IsPrime.comap _

  have s3 : ∀ Q : Ideal ↥(integralClosure R K), Q.IsPrime →
      (∀ s ∈ IsLocalRing.maximalIdeal R, algebraMap R ↥(integralClosure R K) s ∈ Q) →
      Q.IsMaximal := by
    intro Q hQ hlo
    have hJ : Ideal.comap (algebraMap R ↥(integralClosure R K)) Q =
        IsLocalRing.maximalIdeal R := by
      apply le_antisymm
      · apply IsLocalRing.le_maximalIdeal
        intro htop
        apply hQ.ne_top
        rw [Ideal.eq_top_iff_one] at htop ⊢
        simpa using htop
      · intro s hs
        exact hlo s hs
    exact Ideal.isMaximal_of_isIntegral_of_isMaximal_comap
      (algebraMap R ↥(integralClosure R K)) (fun b => Algebra.IsIntegral.isIntegral b) Q
      (by rw [hJ]; exact IsLocalRing.maximalIdeal.isMaximal R)

  have s3' : ∀ M : Ideal ↥(integralClosure R K), M.IsMaximal →
      ∀ s ∈ IsLocalRing.maximalIdeal R, algebraMap R ↥(integralClosure R K) s ∈ M := by
    intro M hM s hs
    have h2 := IsLocalRing.eq_maximalIdeal (Ideal.IsMaximal.under R M)
    rw [← h2] at hs
    exact hs

  have hU : ∀ (V : ValuationSubring K) (s : K), s ∈ V → s⁻¹ ∈ V → s ≠ 0 →
      ¬ V.valuation s < 1 := by
    intro V s hs hsi hs0 hlt
    have hu : IsUnit (⟨s, hs⟩ : V) :=
      ⟨⟨⟨s, hs⟩, ⟨s⁻¹, hsi⟩, Subtype.ext (mul_inv_cancel₀ hs0),
        Subtype.ext (inv_mul_cancel₀ hs0)⟩, rfl⟩
    have h1 := (V.valuation_eq_one_iff _).mp hu
    have h2 : V.valuation s = 1 := h1
    rw [h2] at hlt
    exact lt_irrefl _ hlt

  have s2 : ∀ V : ValuationSubring K, (∀ x : ↥(integralClosure R K), (x : K) ∈ V) →
      ∀ x ∈ V, ∃ a s : ↥(integralClosure R K), (s : K) ≠ 0 ∧
        ¬ V.valuation (s : K) < 1 ∧ x = (a : K) / (s : K) := by
    intro V hA x hx
    by_cases hVtop : V = ⊤
    · obtain ⟨a, y, hy, hxy⟩ := IsFractionRing.div_surjective (A := ↥(integralClosure R K)) x
      have hy0 : algebraMap (integralClosure R K) K y ≠ 0 :=
        IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors hy
      refine ⟨a, y, hy0, ?_, hxy.symm⟩
      apply hU V _ (by rw [hVtop]; exact ValuationSubring.mem_top _)
        (by rw [hVtop]; exact ValuationSubring.mem_top _) hy0
    · haveI : IsDedekindDomain ↥(integralClosure R K).toSubring := hDed
      haveI : IsFractionRing ↥(integralClosure R K).toSubring K := hFrac
      obtain ⟨a', s', ha', hs', hs0, hsi, hxe⟩ := dedLocal (integralClosure R K).toSubring V
        (fun z hz => hA ⟨z, hz⟩) hVtop x hx
      exact ⟨⟨a', ha'⟩, ⟨s', hs'⟩, hs0, hU V s' (hA ⟨s', hs'⟩) hsi hs0, hxe⟩

  have incl : ∀ (V₁ V₂ : ValuationSubring K) (h₁ : ∀ x : ↥(integralClosure R K), (x : K) ∈ V₁)
      (h₂ : ∀ x : ↥(integralClosure R K), (x : K) ∈ V₂), P V₁ h₁ = P V₂ h₂ →
      ∀ x ∈ V₁, x ∈ V₂ := by
    intro V₁ V₂ h₁ h₂ hP x hx
    obtain ⟨a, s, hs0, hs1, hxe⟩ := s2 V₁ h₁ x hx
    have hs2 : ¬ V₂.valuation (s : K) < 1 := by
      rw [← hPmem V₂ h₂, ← hP, hPmem V₁ h₁]
      exact hs1
    have hsle : V₂.valuation (s : K) ≤ 1 := (V₂.valuation_le_one_iff _).mpr (h₂ s)
    have hse : V₂.valuation (s : K) = 1 := le_antisymm hsle (not_lt.mp hs2)
    have hale : V₂.valuation (a : K) ≤ 1 := (V₂.valuation_le_one_iff _).mpr (h₂ a)
    rw [hxe, ← V₂.valuation_le_one_iff, map_div₀, hse, div_one]
    exact hale

  have hlo : ∀ (V : ValuationSubring K) (hV : ∀ s : R, ∃ hs : algebraMap R K s ∈ V,
      s ∈ IsLocalRing.maximalIdeal R → (⟨algebraMap R K s, hs⟩ : V) ∈ IsLocalRing.maximalIdeal V),
      ∀ s ∈ IsLocalRing.maximalIdeal R,
        algebraMap R ↥(integralClosure R K) s ∈ P V (s1 V (fun s => (hV s).1)) := by
    intro V hV s hs
    obtain ⟨hs', hm⟩ := hV s
    have h1 := (ValuationSubring.valuation_lt_one_iff V _).mp (hm hs)
    exact (hPmem V _ _).mpr h1
  refine ⟨Equiv.ofBijective (fun V => ⟨P V.1 (s1 V.1 (fun s => (V.2 s).1)),
    s3 _ (hPprime _ _) (hlo V.1 V.2)⟩) ⟨?_, ?_⟩⟩
  · intro V₁ V₂ hEq
    have hP := congrArg MaximalSpectrum.asIdeal hEq
    apply Subtype.ext
    apply ValuationSubring.ext
    intro x
    exact ⟨incl V₁.1 V₂.1 _ _ hP x, incl V₂.1 V₁.1 _ _ hP.symm x⟩
  · intro M
    obtain ⟨V, hAV, hM⟩ := domVal M.asIdeal M.isMaximal.isPrime
    have hVD : ∀ s : R, ∃ hs : algebraMap R K s ∈ V,
        s ∈ IsLocalRing.maximalIdeal R →
          (⟨algebraMap R K s, hs⟩ : V) ∈ IsLocalRing.maximalIdeal V := by
      intro s
      refine ⟨hAV (algebraMap R (integralClosure R K) s), fun hs => ?_⟩
      have h1 := (hM _).mp (s3' M.asIdeal M.isMaximal s hs)
      exact (V.valuation_lt_one_iff _).mpr h1
    refine ⟨⟨V, hVD⟩, MaximalSpectrum.ext (Ideal.ext fun x => ?_)⟩
    exact (hPmem V _ x).trans (hM x).symm

theorem wcpa_dj_lr1k_llnc_branches_eq_valuations : ∀ (F : Scheme.{u}) (y : ↥F),
    _root_.IsReduced ↥(F.presheaf.stalk y) → IsNoetherianRing ↥(F.presheaf.stalk y) →
    ringKrullDim ↥(F.presheaf.stalk y) ≤ ((1 : ℕ) : WithBot ℕ∞) →
    Module.Finite ↥(F.presheaf.stalk y)
      ↥(integralClosure ↥(F.presheaf.stalk y) (FractionRing ↥(F.presheaf.stalk y))) →
    {p : Σ ξ : ↥F, ValuationSubring ↥(F.residueField ξ) |
        closure ({p.1} : Set ↥F) ∈ irreducibleComponents ↥F ∧ wcLlncDom F p.1 y p.2}.encard =
      wcpaDjLkBranches ↥(F.presheaf.stalk y) :=
by
  intro F y hred hnoeth hdim hfin
  classical
  haveI := hred
  haveI := hnoeth
  let ι : Type u := {ξ : ↥F // closure ({ξ} : Set ↥F) ∈ irreducibleComponents ↥F ∧ ξ ⤳ y}
  let K : ι → Type u := fun i => ↥(F.residueField i.1)
  letI instK : ∀ i : ι, Field (K i) := fun i => inferInstanceAs (Field ↥(F.residueField i.1))
  letI instA : ∀ i : ι, Algebra ↥(F.presheaf.stalk y) (K i) := fun i =>
    (F.presheaf.stalkSpecializes i.2.2 ≫ F.residue i.1).hom.toAlgebra
  have hmin : ∀ i : ι, RingHom.ker (algebraMap ↥(F.presheaf.stalk y) (K i)) ∈
      minimalPrimes ↥(F.presheaf.stalk y) := fun i =>
    (wcpa_dj_lr1k_llnc_bv_generic_kernel F y i.1 i.1 i.2.2 i.2.2).1 i.2.1
  have hinj : Function.Injective
      (fun i : ι => RingHom.ker (algebraMap ↥(F.presheaf.stalk y) (K i))) := by
    intro i j hij
    exact Subtype.ext ((wcpa_dj_lr1k_llnc_bv_generic_kernel F y i.1 j.1 i.2.2 j.2.2).2 hij)
  have hcov : ∀ p ∈ minimalPrimes ↥(F.presheaf.stalk y),
      ∃ i : ι, RingHom.ker (algebraMap ↥(F.presheaf.stalk y) (K i)) = p := by
    intro p hp
    obtain ⟨ξ, h, hc, hk, -⟩ := wcpa_dj_fva_tg_minimal_prime_generic F y p hp
    exact ⟨⟨ξ, hc, h⟩, hk⟩
  have hfrac : ∀ (i : ι) (f : K i), ∃ a b : ↥(F.presheaf.stalk y),
      algebraMap ↥(F.presheaf.stalk y) (K i) b ≠ 0 ∧
        f * algebraMap ↥(F.presheaf.stalk y) (K i) b =
          algebraMap ↥(F.presheaf.stalk y) (K i) a := by
    intro i
    obtain ⟨ξ', h', hc', hk', hf'⟩ :=
      wcpa_dj_fva_tg_minimal_prime_generic F y _ (hmin i)
    have heq : ξ' = i.1 :=
      (wcpa_dj_lr1k_llnc_bv_generic_kernel F y ξ' i.1 h' i.2.2).2 hk'
    obtain ⟨ξ, hc, h⟩ := i
    subst heq
    exact hf'
  obtain ⟨hfinι, ⟨eF⟩⟩ := wcpa_dj_lr1k_llnc_bv_frac_pi ↥(F.presheaf.stalk y) ι K hinj hmin
    hcov hfrac
  haveI := hfinι
  obtain ⟨⟨e3⟩, hfin3⟩ := wcpa_dj_lr1k_llnc_bv_intclosure_pi ↥(F.presheaf.stalk y)
    (FractionRing ↥(F.presheaf.stalk y)) ι K eF
  have h4 := fun i : ι => wcpa_dj_lr1k_llnc_bv_dedekind ↥(F.presheaf.stalk y) (K i) hdim
    (hfrac i) (hfin3 hfin i)
  have e5 := fun i : ι => Classical.choice
    (wcpa_dj_lr1k_llnc_bv_val_maxspec ↥(F.presheaf.stalk y) (K i) (h4 i).1 (h4 i).2)
  unfold Set.encard wcpaDjLkBranches
  refine ENat.card_congr (Equiv.trans ?_ ((Equiv.sigmaCongrRight e5).trans e3.symm))
  exact
    { toFun := fun p => ⟨⟨p.1.1, p.2.1, p.2.2.fst⟩, ⟨p.1.2, p.2.2.snd⟩⟩
      invFun := fun q => ⟨⟨q.1.1, q.2.1⟩, q.1.2.1, q.1.2.2, q.2.2⟩
      left_inv := fun p => rfl
      right_inv := fun q => rfl }

theorem wcpa_dj_lr1k_llnc_strict_centre_nonsmooth : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (C : Scheme.{u}) (γ : C ⟶ wcProjK Ω 1), wcpaDjLkCov Ω γ →
    ∀ (X : Scheme.{u}) (uX : X ⟶ Spec (.of ↥W)) (ι : wcProjK Ω 1 ⟶ X)
      [QuasiCompact (γ ≫ ι)] [QuasiSeparated (γ ≫ ι)], wcpaDjLkModel W uX ι →
    ∀ y₀ : ↥(wcpaDjLkFib W (γ ≫ ι) uX), wcpaDjLkSmAt W uX (wcpaDjLkPi W (γ ≫ ι) uX y₀) →
    ∀ (σ : Spec (.of ↥W) ⟶ X) (a : ↥W),
      wcpaDjLlPair W uX (wcpaDjLkImg W (γ ≫ ι) uX y₀) σ a →
    ∀ (X' : Scheme.{u}) (r : X' ⟶ X) (ι' : wcProjK Ω 1 ⟶ X')
      [QuasiCompact (γ ≫ ι')] [QuasiSeparated (γ ≫ ι')],
      wcCsdIsBlowup (σ.ker ⊔ wcNcPrincipal (.of ↥W) X uX a) r → ι' ≫ r = ι →
      wcpaDjLkModel W (r ≫ uX) ι' →
      ∀ V : X.Opens, (V : Set X) = {wcpaDjLkImg W (γ ≫ ι) uX y₀}ᶜ → IsIso (r ∣_ V) →
      ∀ (y' ξ : ↥(wcpaDjLkFib W (γ ≫ ι') (r ≫ uX))),
        closure ({ξ} : Set ↥(wcpaDjLkFib W (γ ≫ ι') (r ≫ uX))) ∈
          irreducibleComponents ↥(wcpaDjLkFib W (γ ≫ ι') (r ≫ uX)) →
        ξ ⤳ y' →
        r (wcpaDjLkImg W (γ ≫ ι') (r ≫ uX) y') = wcpaDjLkImg W (γ ≫ ι) uX y₀ →
        r (wcpaDjLkImg W (γ ≫ ι') (r ≫ uX) ξ) ≠ wcpaDjLkImg W (γ ≫ ι) uX y₀ →
        ¬ wcpaDjLkSmAt W (r ≫ uX) (wcpaDjLkPi W (γ ≫ ι') (r ≫ uX) y') :=
by
  intro Ω _ _ W hW hWt C γ hcov X uX ι _ _ hM y₀ hSm σ a hP X' r ι' _ _ hbl hι' hM' V hV hiso
    y' ξ _hcomp hξy hrz hrη hsm
  classical

  have hs₀pt : ∀ t : ↥(Spec (.of (IsLocalRing.ResidueField ↥W))),
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) t =
        IsLocalRing.closedPoint ↥W := by
    intro t
    apply PrimeSpectrum.ext
    show Ideal.comap (algebraMap ↥W (IsLocalRing.ResidueField ↥W)) t.asIdeal =
      IsLocalRing.maximalIdeal ↥W
    rw [@Ideal.eq_bot_of_prime _ _ t.asIdeal t.isPrime, ← RingHom.ker_eq_comap_bot,
      IsLocalRing.ResidueField.algebraMap_eq, IsLocalRing.ker_residue]

  have hspec : ∀ (Y : Scheme.{u}) (v : Y ⟶ Spec (.of ↥W))
      (w : ↥(Limits.pullback v
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))))),
      v (Limits.pullback.fst v
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) w) =
        IsLocalRing.closedPoint ↥W := by
    intro Y v w
    rw [← Scheme.Hom.comp_apply, Limits.pullback.condition, Scheme.Hom.comp_apply]
    exact hs₀pt _

  haveI hs₀ci : IsClosedImmersion
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) :=
    IsClosedImmersion.spec_of_surjective _ (by
      show Function.Surjective (algebraMap ↥W (IsLocalRing.ResidueField ↥W))
      rw [IsLocalRing.ResidueField.algebraMap_eq]
      exact IsLocalRing.residue_surjective)

  obtain ⟨hflat, hprop, -⟩ := hM'.1
  haveI : IsProper (r ≫ uX) := hprop
  haveI : CompactSpace ↥X' := QuasiCompact.compactSpace_of_compactSpace (r ≫ uX)
  have hdim := (wcpa_dj_lus_cvs_ct_closed_fibre_dim Ω W (wcpa_dj_nc_residue_algclosed Ω W) X'
    (r ≫ uX) hM'.1).2
  rw [topologicalKrullDim.eq_1, Nat.cast_one] at hdim

  have hclosed : ∀ η z : ↥X', (r ≫ uX) η = IsLocalRing.closedPoint ↥W →
      (r ≫ uX) z = IsLocalRing.closedPoint ↥W → η ⤳ z → η ≠ z →
      IsClosed ({z} : Set ↥X') := by
    intro η z hη hz hηz hne
    by_contra hnc
    obtain ⟨c, hc, hcc⟩ := IsClosed.exists_closed_singleton
      (isClosed_closure : IsClosed (closure ({z} : Set ↥X'))) ⟨z, subset_closure rfl⟩
    have hzc : z ⤳ c := specializes_iff_mem_closure.mpr hc
    have hcz : z ≠ c := fun h => hnc (h ▸ hcc)
    have hcs : (r ≫ uX) c = IsLocalRing.closedPoint ↥W := by
      have h1 := hzc.map (r ≫ uX).continuous
      rw [hz] at h1
      exact h1.mem_closed (IsLocalRing.isClosed_singleton_closedPoint ↥W) rfl
    have hlift : ∀ p : ↥X', (r ≫ uX) p = IsLocalRing.closedPoint ↥W →
        ∃ p' : ↥(Limits.pullback (r ≫ uX)
          (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))),
          Limits.pullback.fst (r ≫ uX)
            (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) p' = p := by
      intro p hp
      obtain ⟨p', hp', -⟩ := Scheme.Pullback.exists_preimage_pullback (f := r ≫ uX)
        (g := Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))
        p (IsLocalRing.closedPoint (IsLocalRing.ResidueField ↥W))
        (by rw [hp]; exact (hs₀pt _).symm)
      exact ⟨p', hp'⟩
    obtain ⟨η', rfl⟩ := hlift η hη
    obtain ⟨z', rfl⟩ := hlift z hz
    obtain ⟨c', rfl⟩ := hlift c hcs
    have hind := (Scheme.Hom.isClosedEmbedding (Limits.pullback.fst (r ≫ uX)
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))))).isInducing
    have h1 : η' ⤳ z' := hind.specializes_iff.mp hηz
    have h2 : z' ⤳ c' := hind.specializes_iff.mp hzc
    have hne1 : η' ≠ z' := fun h => hne (by rw [h])
    have hne2 : z' ≠ c' := fun h => hcz (by rw [h])
    have key : ∀ p q : ↥(Limits.pullback (r ≫ uX)
          (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))),
        p ⤳ q → p ≠ q →
        (⟨closure {q}, isIrreducible_singleton.closure, isClosed_closure⟩ :
          TopologicalSpace.IrreducibleCloseds _) <
        ⟨closure {p}, isIrreducible_singleton.closure, isClosed_closure⟩ := by
      intro p q hpq hne'
      refine lt_of_le_of_ne ?_ ?_
      · exact SetLike.coe_subset_coe.mp (specializes_iff_closure_subset.mp hpq)
