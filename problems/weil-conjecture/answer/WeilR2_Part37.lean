    fun σ a hP hEx => ((hτ3 σ a σs b₀ hP hb₀.1).1 (hb₀.2 σ a hP hEx)).2
  have hPairS : ∀ a : ↥W, a ≠ 0 → a ∈ IsLocalRing.maximalIdeal ↥W →
