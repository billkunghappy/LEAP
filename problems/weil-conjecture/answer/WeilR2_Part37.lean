    (∀ (a : ℕ) (g : A), 1 ≤ a → g ∈ F a → wcIaResOrd W A ζ D a g) →
    ∃ (D r₁ r₀ : ℕ) (f₁ : Fin r₁ → A) (f₀ : Fin r₀ → A) (o₁ : Fin r₁ → ℕ)
      (o₀ : Fin r₀ → ℕ), 1 ≤ D ∧
      (∀ j, wcIaResOrd W A ζ D (o₁ j) (f₁ j)) ∧ (∀ j, wcIaResOrd W A ζ D (o₀ j) (f₀ j)) ∧
      (∀ (c : (ℕ × Fin r₁) ⊕ Fin r₀ →₀ ↥W) (α : ℕ),
        (∀ i ∈ c.support, wcIaOrd D r₁ r₀ o₁ o₀ i = α) → (∃ i, IsUnit (c i)) →
        ∀ N : ℕ, 1 ≤ N →
          ¬ wcIaResOrd W A ζ (D * N) (N * α + 1) (wcIaSum W A ζ r₁ r₀ f₁ f₀ c)) ∧
      (∀ (n : ℕ) (a : A), ∃ c : (ℕ × Fin r₁) ⊕ Fin r₀ →₀ ↥W,
        (∀ i ∈ c.support, wcIaGrad r₁ r₀ i < n) ∧
        a - wcIaSum W A ζ r₁ r₀ f₁ f₀ c ∈
          Ideal.span {ζ ^ n} ⊔ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)) :=
by
  intro Ω _ W A _ _ ζ D F hD hF0 _hFa hI hmul hinj hstab hfin hres1 hres2
  classical
  obtain ⟨a₀, ha₀, hst⟩ := hstab

  have s1 : ∀ (P Q : Ideal A), (∃ (r : ℕ) (h : Fin r → A), (∀ j, h j ∈ P) ∧
      ∀ g ∈ P, ∃ c : Fin r → ↥W, g - ∑ j, algebraMap ↥W A (c j) * h j ∈ Q) →
      ∃ (r : ℕ) (h : Fin r → A), (∀ j, h j ∈ P) ∧
        (∀ g ∈ P, ∃ c : Fin r → ↥W, g - ∑ j, algebraMap ↥W A (c j) * h j ∈ Q) ∧
        (∀ c : Fin r → ↥W, ∑ j, algebraMap ↥W A (c j) * h j ∈ Q →
          ∀ j, c j ∈ IsLocalRing.maximalIdeal ↥W) := by
    intro P Q hex
    have key : ∀ (N : ℕ) (h : Fin N → A), (∀ j, h j ∈ P) →
        (∀ g ∈ P, ∃ c : Fin N → ↥W, g - ∑ j, algebraMap ↥W A (c j) * h j ∈ Q) →
        ∀ c : Fin N → ↥W, ∑ j, algebraMap ↥W A (c j) * h j ∈ Q →
        ∀ j₀ : Fin N, IsUnit (c j₀) →
        ∃ N' < N, ∃ (h : Fin N' → A), (∀ j, h j ∈ P) ∧
          ∀ g ∈ P, ∃ c : Fin N' → ↥W, g - ∑ j, algebraMap ↥W A (c j) * h j ∈ Q := by
      intro N
      cases N with
      | zero => intro _ _ _ _ _ j₀; exact j₀.elim0
      | succ N =>
        intro h hP hS c hc j₀ hu
        refine ⟨N, Nat.lt_succ_self N, fun j => h (j₀.succAbove j), fun j => hP _, ?_⟩
        intro g hg
        obtain ⟨c', hc'⟩ := hS g hg
        set lam : ↥W := c' j₀ * ↑hu.unit⁻¹ with hlam
        have hlu : algebraMap ↥W A lam * algebraMap ↥W A (c j₀) = algebraMap ↥W A (c' j₀) := by
          rw [← map_mul, hlam, mul_assoc, hu.val_inv_mul, mul_one]
        refine ⟨fun j => c' (j₀.succAbove j) - lam * c (j₀.succAbove j), ?_⟩
        have hmem := Q.add_mem hc' (Q.mul_mem_left (algebraMap ↥W A lam) hc)
        have e1 := Fin.sum_univ_succAbove (fun j => algebraMap ↥W A (c' j) * h j) j₀
        have e2 := Fin.sum_univ_succAbove (fun j => algebraMap ↥W A (c j) * h j) j₀
        have e3 : ∑ j : Fin N, algebraMap ↥W A (c' (j₀.succAbove j) - lam * c (j₀.succAbove j)) *
            h (j₀.succAbove j) = ∑ j : Fin N, algebraMap ↥W A (c' (j₀.succAbove j)) *
            h (j₀.succAbove j) - algebraMap ↥W A lam * ∑ j : Fin N,
              algebraMap ↥W A (c (j₀.succAbove j)) * h (j₀.succAbove j) := by
          rw [Finset.mul_sum, ← Finset.sum_sub_distrib]
          refine Finset.sum_congr rfl (fun j _ => ?_)
          rw [map_sub, map_mul]; ring
        convert hmem using 1
        rw [e1, e2, e3]
        linear_combination (-(h j₀)) * hlu
    obtain ⟨h, hP, hS⟩ := Nat.find_spec hex
    refine ⟨Nat.find hex, h, hP, hS, ?_⟩
    intro c hc j
    by_contra hj
    have hu : IsUnit (c j) := by
      by_contra hnu
      exact hj ((IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr hnu))
    obtain ⟨N', hN', h', hP', hS'⟩ := key _ h hP hS c hc j hu
    exact Nat.find_min hex hN' ⟨h', hP', hS'⟩

  have hM : ∀ (a ν : ℕ) (g : A), g ∈ F a → ζ ^ ν * g ∈ F (a + D * ν) := by
    intro a ν
    induction ν with
    | zero => intro g hg; simpa using hg
    | succ ν ih =>
      intro g hg
      have := hmul _ _ (ih g hg)
      rw [pow_succ', mul_assoc, show a + D * (ν + 1) = a + D * ν + D by ring]
      exact this
  have hS : ∀ (a ν : ℕ) (g : A), a₀ ≤ a → g ∈ F (a + D * ν) →
      ∃ g' ∈ F a, g - ζ ^ ν * g' ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) := by
    intro a ν
    induction ν with
    | zero => intro g _ hg; exact ⟨g, by simpa using hg, by simp⟩
    | succ ν ih =>
      intro g ha hg
      rw [show a + D * (ν + 1) = (a + D * ν) + D by ring] at hg
      obtain ⟨g1, hg1, h1⟩ := hst _ _ (by omega) hg
      obtain ⟨g', hg', h2⟩ := ih g1 ha hg1
      refine ⟨g', hg', ?_⟩
      have := Ideal.add_mem _ h1 (Ideal.mul_mem_left _ ζ h2)
      convert this using 1
      ring
  have hJ : ∀ (a ν : ℕ) (x : A), 1 ≤ a → x ∈ F a → ζ ^ ν * x ∈ F (a + D * ν + 1) →
      x ∈ F (a + 1) := by
    intro a ν
    induction ν with
    | zero => intro x _ _ h; simpa using h
    | succ ν ih =>
      intro x ha hx h
      apply ih x ha hx
      have hy := hM a ν x hx
      apply hinj _ _ (by omega) hy
      rw [← mul_assoc, ← pow_succ', show a + D * ν + D + 1 = a + D * (ν + 1) + 1 by ring]
      exact h

  choose r H hHm hHs hHi using fun a => s1 (F a) (F (a + 1)) (hfin a)

  obtain ⟨r₁, ⟨e₁⟩⟩ : ∃ r₁ : ℕ, Nonempty ((Σ i : Fin D, Fin (r (a₀ + i))) ≃ Fin r₁) :=
    ⟨_, ⟨finSigmaFinEquiv⟩⟩
  obtain ⟨r₀, ⟨e₀⟩⟩ : ∃ r₀ : ℕ, Nonempty ((Σ i : Fin a₀, Fin (r i)) ≃ Fin r₀) :=
    ⟨_, ⟨finSigmaFinEquiv⟩⟩
  obtain ⟨f₁, o₁, hf₁, ho₁⟩ : ∃ (f₁ : Fin r₁ → A) (o₁ : Fin r₁ → ℕ),
      (∀ k, f₁ k = H (a₀ + ↑(e₁.symm k).1) (e₁.symm k).2) ∧
      (∀ k, o₁ k = a₀ + ↑(e₁.symm k).1) := ⟨_, _, fun _ => rfl, fun _ => rfl⟩
  obtain ⟨f₀, o₀, hf₀, ho₀⟩ : ∃ (f₀ : Fin r₀ → A) (o₀ : Fin r₀ → ℕ),
      (∀ k, f₀ k = H ↑(e₀.symm k).1 (e₀.symm k).2) ∧
      (∀ k, o₀ k = ↑(e₀.symm k).1) := ⟨_, _, fun _ => rfl, fun _ => rfl⟩
  have ho₁a : ∀ k, a₀ ≤ o₁ k := fun k => by rw [ho₁]; omega
  have ho₀a : ∀ k, o₀ k < a₀ := fun k => by rw [ho₀]; exact (e₀.symm k).1.isLt
  have block : ∀ b : ℕ, ∃ (s : ℕ) (κ : Fin s → (ℕ × Fin r₁) ⊕ Fin r₀) (G : Fin s → A),
      Function.Injective κ ∧
      (∀ j, Sum.elim (fun p : ℕ × Fin r₁ => ζ ^ p.1 * f₁ p.2) f₀ (κ j) = G j) ∧
      (∀ j, wcIaOrd D r₁ r₀ o₁ o₀ (κ j) = b) ∧
      (∀ i, wcIaOrd D r₁ r₀ o₁ o₀ i = b → ∃ j, κ j = i) ∧
      (∀ g ∈ F b, ∃ d : Fin s → ↥W, g - ∑ j, algebraMap ↥W A (d j) * G j ∈ F (b + 1)) ∧
      (∀ d : Fin s → ↥W, ∑ j, algebraMap ↥W A (d j) * G j ∈ F (b + 1) →
        ∀ j, d j ∈ IsLocalRing.maximalIdeal ↥W) := by
    intro b
    by_cases hb : b < a₀
    · refine ⟨r b, fun j => Sum.inr (e₀ ⟨⟨b, hb⟩, j⟩), H b, ?_, ?_, ?_, ?_, hHs b, hHi b⟩
      · intro j j' hjj
        exact eq_of_heq (Sigma.mk.inj_iff.mp (e₀.injective (Sum.inr_injective hjj))).2
      · intro j
        show f₀ _ = _
        rw [hf₀, Equiv.symm_apply_apply]
      · intro j
        simp only [wcIaOrd, Sum.elim_inr, ho₀, Equiv.symm_apply_apply]
      · intro i hi
        cases i with
        | inl p =>
          exfalso
          simp only [wcIaOrd, Sum.elim_inl] at hi
          have := ho₁a p.2
          omega
        | inr k =>
          simp only [wcIaOrd, Sum.elim_inr, ho₀] at hi
          obtain ⟨⟨i', j⟩, hij⟩ : ∃ x, e₀.symm k = x := ⟨_, rfl⟩
          rw [hij] at hi
          obtain rfl : i' = ⟨b, hb⟩ := Fin.ext hi
          refine ⟨j, ?_⟩
          show Sum.inr (e₀ ⟨⟨b, hb⟩, j⟩) = Sum.inr k
          rw [← hij, Equiv.apply_symm_apply]
    · have hb : a₀ ≤ b := Nat.le_of_not_lt hb
      obtain ⟨ν, i, hiD, hb'⟩ : ∃ ν i : ℕ, i < D ∧ b = a₀ + i + D * ν :=
        ⟨(b - a₀) / D, (b - a₀) % D, Nat.mod_lt _ (by omega),
          by have := Nat.mod_add_div (b - a₀) D; omega⟩
      subst hb'
      refine ⟨r (a₀ + i), fun j => Sum.inl (ν, e₁ ⟨⟨i, hiD⟩, j⟩),
        fun j => ζ ^ ν * H (a₀ + i) j, ?_, ?_, ?_, ?_, ?_, ?_⟩
      · intro j j' hjj
        have h1 := congrArg Prod.snd (Sum.inl_injective hjj)
        exact eq_of_heq (Sigma.mk.inj_iff.mp (e₁.injective h1)).2
      · intro j
        show ζ ^ ν * f₁ _ = _
        rw [hf₁, Equiv.symm_apply_apply]
      · intro j
        simp only [wcIaOrd, Sum.elim_inl, ho₁, Equiv.symm_apply_apply]
        omega
      · intro x hx
        cases x with
        | inr k =>
          exfalso
          simp only [wcIaOrd, Sum.elim_inr] at hx
          have := ho₀a k
          omega
        | inl p =>
          obtain ⟨ν', k⟩ := p
          simp only [wcIaOrd, Sum.elim_inl, ho₁] at hx
          obtain ⟨⟨i', j⟩, hij⟩ : ∃ x, e₁.symm k = x := ⟨_, rfl⟩
          rw [hij] at hx
          have hi' : (i' : ℕ) < D := i'.isLt
          have h1 : (i' : ℕ) + D * ν' = i + D * ν := by simp only at hx; omega
          have h2 : (i' : ℕ) = i := by
            have := congrArg (· % D) h1
            simp only [Nat.add_mul_mod_self_left, Nat.mod_eq_of_lt hi', Nat.mod_eq_of_lt hiD]
              at this
            exact this
          have h3 : ν' = ν := Nat.eq_of_mul_eq_mul_left (n := D) (by omega) (by omega)
          subst h3
          obtain rfl : i' = ⟨i, hiD⟩ := Fin.ext h2
          refine ⟨j, ?_⟩
          show Sum.inl (ν', e₁ ⟨⟨i, hiD⟩, j⟩) = Sum.inl (ν', k)
          rw [← hij, Equiv.apply_symm_apply]
      · intro g hg
        obtain ⟨g', hg', h1⟩ := hS (a₀ + i) ν g (by omega) hg
        obtain ⟨d, hd⟩ := hHs (a₀ + i) g' hg'
        refine ⟨d, ?_⟩
        have e : g - ∑ j, algebraMap ↥W A (d j) * (ζ ^ ν * H (a₀ + i) j) =
            (g - ζ ^ ν * g') + ζ ^ ν * (g' - ∑ j, algebraMap ↥W A (d j) * H (a₀ + i) j) := by
          rw [mul_sub, Finset.mul_sum]
          have : ∀ j, algebraMap ↥W A (d j) * (ζ ^ ν * H (a₀ + i) j) =
              ζ ^ ν * (algebraMap ↥W A (d j) * H (a₀ + i) j) := fun j => by ring
          rw [Finset.sum_congr rfl (fun j _ => this j)]
          ring
        rw [e]
        refine Ideal.add_mem _ (hI _ h1) ?_
        have := hM _ ν _ hd
        rwa [show a₀ + i + 1 + D * ν = a₀ + i + D * ν + 1 by ring] at this
      · intro d hd
        have hx : ∑ j, algebraMap ↥W A (d j) * H (a₀ + i) j ∈ F (a₀ + i) :=
          Ideal.sum_mem _ (fun j _ => Ideal.mul_mem_left _ _ (hHm _ j))
        have e : ∑ j, algebraMap ↥W A (d j) * (ζ ^ ν * H (a₀ + i) j) =
            ζ ^ ν * ∑ j, algebraMap ↥W A (d j) * H (a₀ + i) j := by
          rw [Finset.mul_sum]
          exact Finset.sum_congr rfl (fun j _ => by ring)
        rw [e] at hd
        exact hHi _ d (hJ _ ν _ (by omega) hx hd)

  have hsum0 : ∀ (i : (ℕ × Fin r₁) ⊕ Fin r₀),
      algebraMap ↥W A 0 * Sum.elim (fun p : ℕ × Fin r₁ => ζ ^ p.1 * f₁ p.2) f₀ i = 0 :=
    fun i => by rw [map_zero, zero_mul]
  have hsumadd : ∀ (i : (ℕ × Fin r₁) ⊕ Fin r₀) (b₁ b₂ : ↥W),
      algebraMap ↥W A (b₁ + b₂) * Sum.elim (fun p : ℕ × Fin r₁ => ζ ^ p.1 * f₁ p.2) f₀ i =
        algebraMap ↥W A b₁ * Sum.elim (fun p : ℕ × Fin r₁ => ζ ^ p.1 * f₁ p.2) f₀ i +
        algebraMap ↥W A b₂ * Sum.elim (fun p : ℕ × Fin r₁ => ζ ^ p.1 * f₁ p.2) f₀ i :=
    fun i b₁ b₂ => by rw [map_add, add_mul]

  have hSPAN : ∀ (b : ℕ), ∀ g ∈ F b, ∃ c : (ℕ × Fin r₁) ⊕ Fin r₀ →₀ ↥W,
      (∀ i ∈ c.support, wcIaOrd D r₁ r₀ o₁ o₀ i = b) ∧
      g - wcIaSum W A ζ r₁ r₀ f₁ f₀ c ∈ F (b + 1) := by
    intro b g hg
    obtain ⟨s, κ, G, _, hbas, hord, _, hsp, _⟩ := block b
    obtain ⟨d, hd⟩ := hsp g hg
    refine ⟨∑ j, Finsupp.single (κ j) (d j), ?_, ?_⟩
    · intro i hi
      have := Finsupp.support_finsetSum hi
      rw [Finset.mem_biUnion] at this
      obtain ⟨j, _, hj⟩ := this
      have := Finsupp.support_single_subset hj
      rw [Finset.mem_singleton] at this
      rw [this]
      exact hord j
    · have e : wcIaSum W A ζ r₁ r₀ f₁ f₀ (∑ j, Finsupp.single (κ j) (d j)) =
          ∑ j, algebraMap ↥W A (d j) * G j := by
        unfold wcIaSum
        rw [← Finsupp.sum_finsetSum_index hsum0 hsumadd]
        refine Finset.sum_congr rfl (fun j _ => ?_)
        rw [Finsupp.sum_single_index (hsum0 _), hbas]
      rw [e]
      exact hd

  have hIND : ∀ (c : (ℕ × Fin r₁) ⊕ Fin r₀ →₀ ↥W) (α : ℕ),
      (∀ i ∈ c.support, wcIaOrd D r₁ r₀ o₁ o₀ i = α) → (∃ i, IsUnit (c i)) →
      wcIaSum W A ζ r₁ r₀ f₁ f₀ c ∉ F (α + 1) := by
    intro c α hα ⟨i₀, hu⟩ hmem
    obtain ⟨s, κ, G, hinjκ, hbas, _, henum, _, hind⟩ := block α
    have hsub : c.support ⊆ Finset.univ.map ⟨κ, hinjκ⟩ := by
      intro i hi
      obtain ⟨j, hj⟩ := henum i (hα i hi)
      rw [Finset.mem_map]
      exact ⟨j, Finset.mem_univ _, hj⟩
    have e : wcIaSum W A ζ r₁ r₀ f₁ f₀ c = ∑ j, algebraMap ↥W A (c (κ j)) * G j := by
      unfold wcIaSum
      rw [Finsupp.sum_of_support_subset c hsub _ (fun i _ => hsum0 i), Finset.sum_map]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      simp only [Function.Embedding.coeFn_mk]
      rw [hbas]
    rw [e] at hmem
    have hall := hind _ hmem
    have hi₀ : i₀ ∈ c.support := Finsupp.mem_support_iff.mpr hu.ne_zero
    obtain ⟨j₀, hj₀⟩ := henum i₀ (hα i₀ hi₀)
    have := hall j₀
    rw [hj₀] at this
    exact (mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal _).mp this)) hu

  have hP : ∀ (a : A) (b : ℕ), ∃ c : (ℕ × Fin r₁) ⊕ Fin r₀ →₀ ↥W,
      (∀ i ∈ c.support, wcIaOrd D r₁ r₀ o₁ o₀ i < b) ∧
      a - wcIaSum W A ζ r₁ r₀ f₁ f₀ c ∈ F b := by
    intro a b
    induction b with
    | zero => exact ⟨0, by simp, by rw [hF0]; exact Submodule.mem_top⟩
    | succ b ih =>
      obtain ⟨c, hc, hcm⟩ := ih
      obtain ⟨d, hd, hdm⟩ := hSPAN b _ hcm
      refine ⟨c + d, ?_, ?_⟩
      · intro i hi
        rcases Finset.mem_union.mp (Finsupp.support_add hi) with h | h
        · have := hc i h; omega
        · have := hd i h; omega
      · have e : wcIaSum W A ζ r₁ r₀ f₁ f₀ (c + d) =
            wcIaSum W A ζ r₁ r₀ f₁ f₀ c + wcIaSum W A ζ r₁ r₀ f₁ f₀ d := by
          unfold wcIaSum
          exact Finsupp.sum_add_index' hsum0 hsumadd
        rw [e, ← sub_sub]
        exact hdm
  refine ⟨D, r₁, r₀, f₁, f₀, o₁, o₀, hD, ?_, ?_, ?_, ?_⟩
  · intro j
    exact hres2 (o₁ j) (f₁ j) (le_trans ha₀ (ho₁a j)) (by rw [hf₁, ho₁]; exact hHm _ _)
  · intro j
    rcases Nat.eq_zero_or_pos (o₀ j) with h | h
    · rw [h]
      refine ⟨1, fun _ => -(f₀ j) ^ D, Nat.one_pos, ?_, ?_⟩
      · intro i
        rw [zero_mul, pow_zero, Ideal.span_singleton_one]
        exact Ideal.mem_sup_left Submodule.mem_top
      · simp
    · exact hres2 _ _ h (by rw [hf₀, ho₀]; exact hHm _ _)
  · intro c α hα hu N hN hR
    apply hIND c α hα hu
    refine hres1 (D * N) (N * α + 1) _ (α + 1) (le_trans (by norm_num) (Nat.mul_le_mul hD hN))
      (by omega) ?_ hR
    rw [Nat.add_sub_cancel, show D * (N * α + 1) = α * (D * N) + D by ring]
    omega
  · intro n a
    rcases Nat.eq_zero_or_pos n with rfl | hn
    · refine ⟨0, by simp, ?_⟩
      rw [pow_zero, Ideal.span_singleton_one]
      exact Ideal.mem_sup_left Submodule.mem_top
    · obtain ⟨c, hc, hcm⟩ := hP a (a₀ + D * n)
      refine ⟨c, ?_, ?_⟩
      · intro i hi
        have := hc i hi
        cases i with
        | inl p =>
          simp only [wcIaOrd, Sum.elim_inl] at this
          simp only [wcIaGrad, Sum.elim_inl]
          have := ho₁a p.2
          exact Nat.lt_of_mul_lt_mul_left (a := D) (by omega)
        | inr k =>
          simp only [wcIaGrad, Sum.elim_inr]
          exact hn
      · obtain ⟨x', -, hx'⟩ := hS a₀ n _ le_rfl hcm
        have e : a - wcIaSum W A ζ r₁ r₀ f₁ f₀ c =
            ζ ^ n * x' + (a - wcIaSum W A ζ r₁ r₀ f₁ f₀ c - ζ ^ n * x') := by ring
        rw [e]
        exact Ideal.add_mem _ (Ideal.mem_sup_left (Ideal.mem_span_singleton'.mpr
          ⟨x', mul_comm _ _⟩)) (Ideal.mem_sup_right hx')

theorem wcpa_dj_lr1k_nsr_gub_bff_dc_ia_os_residue_basis : ∀ (Ω : Type u) [Field Ω]
    [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) →
    W ≠ ⊤ → ∀ (A : Type u) [CommRing A] [Algebra ↥W A] (ϖ : ↥W) (ζ : A),
      wcBffBase W A ϖ → wcBffNoether W A ζ →
    ∃ (D r₁ r₀ : ℕ) (f₁ : Fin r₁ → A) (f₀ : Fin r₀ → A) (o₁ : Fin r₁ → ℕ)
      (o₀ : Fin r₀ → ℕ), 1 ≤ D ∧
      (∀ j, wcIaResOrd W A ζ D (o₁ j) (f₁ j)) ∧ (∀ j, wcIaResOrd W A ζ D (o₀ j) (f₀ j)) ∧
      (∀ (c : (ℕ × Fin r₁) ⊕ Fin r₀ →₀ ↥W) (α : ℕ),
        (∀ i ∈ c.support, wcIaOrd D r₁ r₀ o₁ o₀ i = α) → (∃ i, IsUnit (c i)) →
        ∀ N : ℕ, 1 ≤ N →
          ¬ wcIaResOrd W A ζ (D * N) (N * α + 1) (wcIaSum W A ζ r₁ r₀ f₁ f₀ c)) ∧
      (∀ (n : ℕ) (a : A), ∃ c : (ℕ × Fin r₁) ⊕ Fin r₀ →₀ ↥W,
        (∀ i ∈ c.support, wcIaGrad r₁ r₀ i < n) ∧
        a - wcIaSum W A ζ r₁ r₀ f₁ f₀ c ∈
          Ideal.span {ζ ^ n} ⊔ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)) :=
by
  intro Ω _ _ W _ _ A _ _ ϖ ζ hbase hN
  obtain ⟨-, -, -, -, -, -, hrad, -⟩ := hbase
  obtain ⟨D, F, hD, hF0, hFa, hI, hmul, hinj, hstab, hfin, hres1, hres2⟩ :=
    wcpa_dj_lr1k_nsr_gub_bff_dc_ia_os_rb_filtration Ω W
      wcpa_dj_lr1k_nsr_gub_bff_dc_ia_os_rb_norm_finite
      wcpa_dj_lr1k_nsr_gub_bff_dc_ia_os_rb_conductor
      wcpa_dj_lr1k_nsr_gub_bff_dc_ia_os_rb_graded_prod A ζ hrad hN
  exact wcpa_dj_lr1k_nsr_gub_bff_dc_ia_os_rb_assembly Ω W A ζ D F hD hF0 hFa hI hmul hinj
    hstab hfin hres1 hres2

theorem wcpa_dj_lr1k_nsr_gub_bff_dc_ia_os_upper_bound : ∀ (Ω : Type u) [Field Ω]
    [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) →
    W ≠ ⊤ → ∀ (A : Type u) [CommRing A] [Algebra ↥W A] (ζ g : A) (D k : ℕ),
      wcIaResOrd W A ζ D k g →
    ∃ e₁ : ↥W, e₁ ≠ 0 ∧ e₁ ∈ IsLocalRing.maximalIdeal ↥W ∧
      ∀ e : ↥W, e ≠ 0 → e ∣ e₁ → ∀ ψ : wcGubGen W A →+* Ω, wcIaPt W A ζ e ψ →
        ∃ x : ↥W, (x : Ω) = ψ (algebraMap A (wcGubGen W A) g) ∧ e ^ k ∣ x ^ D :=
by
  intro Ω _ _ W _ hWt A _ _ ζ g D k hRes
  classical

  have hcore : ∀ (m k : ℕ) (e z X τ c : ↥W) (a b : Fin m → ↥W), 0 < m → e ∣ z →
      e ^ (k * m) ∣ τ →
      X ^ m + ∑ i : Fin m, (a i * z ^ (k * (i.1 + 1)) + τ * b i) * X ^ (m - 1 - i.1) = τ * c →
      e ^ k ∣ X := by
    intro m k e z X τ c a b hm hez heτ hrel
    by_contra hX
    have hX0 : X ≠ 0 := by rintro rfl; exact hX (dvd_zero _)
    obtain ⟨u, hu⟩ : X ∣ e ^ k := (ValuationRing.dvd_total X (e ^ k)).resolve_right hX
    have hunit : ¬ IsUnit u := by
      intro hu'
      apply hX
      exact ⟨↑hu'.unit⁻¹, by rw [hu, mul_assoc, IsUnit.mul_val_inv, mul_one]⟩
    have hXm0 : X ^ m ≠ 0 := pow_ne_zero _ hX0
    have hdvd_u : ∀ j, 1 ≤ j → X ^ m * u ∣ X ^ m * u ^ j :=
      fun j hj => mul_dvd_mul_left _ (dvd_pow_self u (by omega))
    have hτd : X ^ m * u ∣ τ :=
      (hdvd_u m (by omega)).trans (by rw [← mul_pow, ← hu, ← pow_mul]; exact heτ)
    have hterm : ∀ i : Fin m,
        X ^ m * u ∣ (a i * z ^ (k * (i.1 + 1)) + τ * b i) * X ^ (m - 1 - i.1) := by
      intro i
      have hi := i.2
      rw [add_mul]
      apply dvd_add
      · have h1 : e ^ (k * (i.1 + 1)) ∣ z ^ (k * (i.1 + 1)) := pow_dvd_pow_of_dvd hez _
        have hXs : X ^ m = X ^ (i.1 + 1) * X ^ (m - 1 - i.1) := by
          rw [← pow_add]; congr 1; omega
        have h2 : e ^ (k * (i.1 + 1)) * X ^ (m - 1 - i.1) = X ^ m * u ^ (i.1 + 1) := by
          rw [pow_mul, hu, mul_pow, hXs]; ring
        calc X ^ m * u ∣ X ^ m * u ^ (i.1 + 1) := hdvd_u _ (by omega)
          _ = e ^ (k * (i.1 + 1)) * X ^ (m - 1 - i.1) := h2.symm
          _ ∣ z ^ (k * (i.1 + 1)) * X ^ (m - 1 - i.1) := mul_dvd_mul_right h1 _
          _ ∣ a i * z ^ (k * (i.1 + 1)) * X ^ (m - 1 - i.1) :=
            mul_dvd_mul_right (dvd_mul_left _ _) _
      · exact (hτd.trans (dvd_mul_right _ _)).trans (dvd_mul_right _ _)
    have hsum : X ^ m * u ∣
        ∑ i : Fin m, (a i * z ^ (k * (i.1 + 1)) + τ * b i) * X ^ (m - 1 - i.1) :=
      Finset.dvd_sum fun i _ => hterm i
    have hτd' : X ^ m * u ∣ τ * c := hτd.trans (dvd_mul_right _ _)
    have e1 : τ * c - (∑ i : Fin m, (a i * z ^ (k * (i.1 + 1)) + τ * b i) * X ^ (m - 1 - i.1))
        = X ^ m := by rw [← hrel]; ring
    have hXm : X ^ m * u ∣ X ^ m := by
      have h := dvd_sub hτd' hsum
      rwa [e1] at h
    obtain ⟨v, hv⟩ := hXm
    apply hunit
    refine isUnit_of_dvd_one ⟨v, ?_⟩
    apply mul_left_cancel₀ hXm0
    rw [mul_one, ← mul_assoc]
    exact hv

  obtain ⟨τ₀, hτ₀0, hτ₀m⟩ : ∃ τ₀ : ↥W, τ₀ ≠ 0 ∧ τ₀ ∈ IsLocalRing.maximalIdeal ↥W := by
    obtain ⟨ω, hω⟩ : ∃ ω : Ω, ω ∉ W := by
      by_contra h
      push_neg at h
      exact hWt (eq_top_iff.mpr fun x _ => h x)
    have hω0 : ω ≠ 0 := fun h => hω (h ▸ W.zero_mem)
    have hinv : ω⁻¹ ∈ W := (W.mem_or_inv_mem ω).resolve_left hω
    refine ⟨⟨ω⁻¹, hinv⟩, ?_, ?_⟩
    · intro h
      have h' := congrArg Subtype.val h
      exact (inv_ne_zero hω0) h'
    · rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      rintro ⟨u, hu⟩
      apply hω
      have h1 : (u : ↥W) * ((u⁻¹ : (↥W)ˣ) : ↥W) = 1 := u.mul_inv
      rw [hu] at h1
      have h2 : ω⁻¹ * (((u⁻¹ : (↥W)ˣ) : ↥W) : Ω) = 1 := congrArg Subtype.val h1
      have h3 : (((u⁻¹ : (↥W)ˣ) : ↥W) : Ω) = ω := by
        field_simp at h2
        exact h2
      rw [← h3]
      exact ((u⁻¹ : (↥W)ˣ) : ↥W).2

  have hmap : ∀ x : A, x ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) →
      ∃ τ : ↥W, τ ≠ 0 ∧ τ ∈ IsLocalRing.maximalIdeal ↥W ∧
        ∃ b : A, x = algebraMap ↥W A τ * b := by
    intro x hx
    induction hx using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨t, ht, rfl⟩ := hx
      by_cases ht0 : t = 0
      · exact ⟨τ₀, hτ₀0, hτ₀m, 0, by rw [ht0, map_zero, mul_zero]⟩
      · exact ⟨t, ht0, ht, 1, (mul_one _).symm⟩
    | zero => exact ⟨τ₀, hτ₀0, hτ₀m, 0, (mul_zero _).symm⟩
    | add x y _ _ hx hy =>
      obtain ⟨τ₁, h1, h1m, b₁, rfl⟩ := hx
      obtain ⟨τ₂, h2, h2m, b₂, rfl⟩ := hy
      rcases ValuationRing.dvd_total τ₁ τ₂ with ⟨s, hs⟩ | ⟨s, hs⟩
      · exact ⟨τ₁, h1, h1m, b₁ + algebraMap ↥W A s * b₂, by rw [hs, map_mul]; ring⟩
      · exact ⟨τ₂, h2, h2m, algebraMap ↥W A s * b₁ + b₂, by rw [hs, map_mul]; ring⟩
    | smul a x _ hx =>
      obtain ⟨τ, h, hm, b, rfl⟩ := hx
      exact ⟨τ, h, hm, a * b, by rw [smul_eq_mul]; ring⟩

  have hcomb : ∀ x y : ↥W, x ≠ 0 → x ∈ IsLocalRing.maximalIdeal ↥W → y ≠ 0 →
      y ∈ IsLocalRing.maximalIdeal ↥W →
      ∃ z : ↥W, z ≠ 0 ∧ z ∈ IsLocalRing.maximalIdeal ↥W ∧ z ∣ x ∧ z ∣ y := by
    intro x y hx hxm hy hym
    rcases ValuationRing.dvd_total x y with h | h
    · exact ⟨x, hx, hxm, dvd_rfl, h⟩
    · exact ⟨y, hy, hym, h, dvd_rfl⟩
  have hfold : ∀ (r : ℕ) (t : Fin r → ↥W), (∀ j, t j ≠ 0) →
      (∀ j, t j ∈ IsLocalRing.maximalIdeal ↥W) →
      ∀ x : ↥W, x ≠ 0 → x ∈ IsLocalRing.maximalIdeal ↥W →
      ∃ z : ↥W, z ≠ 0 ∧ z ∈ IsLocalRing.maximalIdeal ↥W ∧ z ∣ x ∧ ∀ j, z ∣ t j := by
    intro r
    induction r with
    | zero =>
      intro t _ _ x hx hxm
      exact ⟨x, hx, hxm, dvd_rfl, fun j => j.elim0⟩
    | succ r ih =>
      intro t ht0 htm x hx hxm
      obtain ⟨z, hz0, hzm, hzx, hzt⟩ :=
        ih (fun j => t j.succ) (fun j => ht0 _) (fun j => htm _) x hx hxm
      obtain ⟨z', hz'0, hz'm, hz'z, hz't⟩ := hcomb z (t 0) hz0 hzm (ht0 0) (htm 0)
      refine ⟨z', hz'0, hz'm, hz'z.trans hzx, fun j => ?_⟩
      exact Fin.cases hz't (fun j => hz'z.trans (hzt j)) j

  obtain ⟨m, y, hm, hy, hP⟩ := hRes
  have hy' : ∀ i : Fin m, ∃ (a : A) (τ : ↥W) (b : A), τ ≠ 0 ∧
      τ ∈ IsLocalRing.maximalIdeal ↥W ∧
      y i = a * ζ ^ (k * (i.1 + 1)) + algebraMap ↥W A τ * b := by
    intro i
    obtain ⟨s, hs, t, ht, hst⟩ := Submodule.mem_sup.mp (hy i)
    obtain ⟨a, rfl⟩ := Ideal.mem_span_singleton'.mp hs
    obtain ⟨τ, h0, hmm, b, rfl⟩ := hmap t ht
    exact ⟨a, τ, b, h0, hmm, hst.symm⟩
  choose a τ' b' hτ'0 hτ'm hyab using hy'
  obtain ⟨τP, hτP0, hτPm, bP, hPeq⟩ := hmap _ hP
  obtain ⟨τ, hτ0, hτm, hτP, hτ'⟩ := hfold m τ' hτ'0 hτ'm τP hτP0 hτPm
  obtain ⟨sP, hsP⟩ := hτP
  choose s' hs' using hτ'

  obtain ⟨β, hβ⟩ := IsAlgClosed.exists_pow_nat_eq (τ : Ω) (Nat.succ_pos (k * m))
  have hβ0 : β ≠ 0 := by
    rintro rfl
    rw [zero_pow (Nat.succ_ne_zero _)] at hβ
    exact hτ0 (Subtype.ext hβ.symm)
  have hτnu : ¬ IsUnit τ := mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal τ).mp hτm)
  have hβW : β ∈ W := by
    rcases W.mem_or_inv_mem β with h | h
    · exact h
    · exfalso
      apply hτnu
      refine isUnit_of_dvd_one ⟨(⟨β⁻¹ ^ (k * m + 1), pow_mem h _⟩ : ↥W), (Subtype.ext ?_).symm⟩
      show (τ : Ω) * β⁻¹ ^ (k * m + 1) = 1
      rw [← hβ, ← mul_pow, mul_inv_cancel₀ hβ0, one_pow]
  obtain ⟨e₁, he₁⟩ : ∃ e₁ : ↥W, (e₁ : Ω) = β := ⟨⟨β, hβW⟩, rfl⟩
  have hpow : e₁ ^ (k * m + 1) = τ := Subtype.ext (by push_cast; rw [he₁]; exact hβ)
  have he₁0 : e₁ ≠ 0 := by
    intro h
    apply hβ0
    rw [← he₁, h]
    rfl
  have he₁m : e₁ ∈ IsLocalRing.maximalIdeal ↥W := by
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    intro hu
    exact hτnu (hpow ▸ hu.pow _)
  refine ⟨e₁, he₁0, he₁m, ?_⟩

  intro e he0 hee₁ ψ hψ
  obtain ⟨hP1, hP2, hP3⟩ := hψ
  let ψh : A →+* ↥W := (ψ.comp (algebraMap A (wcGubGen W A))).codRestrict W hP2
  have hψW : ∀ w : ↥W, ψh (algebraMap ↥W A w) = w := fun w => Subtype.ext (hP1 w)
  have hU : IsUnit (algebraMap A (wcGubGen W A) (algebraMap ↥W A e)) :=
    IsLocalization.map_units (wcGubGen W A)
      (⟨algebraMap ↥W A e, Submonoid.mem_map_of_mem _ (mem_nonZeroDivisors_of_ne_zero he0)⟩ :
        Submonoid.map (algebraMap ↥W A) (nonZeroDivisors ↥W))
  have hz : e ∣ ψh ζ := by
    refine ⟨⟨_, hP3⟩, Subtype.ext ?_⟩
    show ψ (algebraMap A (wcGubGen W A) ζ) = (e : Ω) * ψ (algebraMap A (wcGubGen W A) ζ *
      Ring.inverse (algebraMap A (wcGubGen W A) (algebraMap ↥W A e)))
    have h1 : algebraMap A (wcGubGen W A) ζ = (algebraMap A (wcGubGen W A) ζ *
        Ring.inverse (algebraMap A (wcGubGen W A) (algebraMap ↥W A e))) *
          algebraMap A (wcGubGen W A) (algebraMap ↥W A e) := by
      rw [mul_assoc, Ring.inverse_mul_cancel _ hU, mul_one]
    conv_lhs => rw [h1]
    rw [map_mul, hP1 e, mul_comm]
  have heτ : e ^ (k * m) ∣ τ := by
    rw [← hpow]
    exact (pow_dvd_pow e (Nat.le_succ _)).trans (pow_dvd_pow_of_dvd hee₁ _)

  have hrel : (ψh g ^ D) ^ m + ∑ i : Fin m, (ψh (a i) * ψh ζ ^ (k * (i.1 + 1)) +
      τ * (s' i * ψh (b' i))) * (ψh g ^ D) ^ (m - 1 - i.1) = τ * (sP * ψh bP) := by
    calc _ = ψh g ^ (D * m) + ∑ i : Fin m, ψh (y i) * ψh g ^ (D * (m - 1 - i.1)) := by
            rw [← pow_mul]
            congr 1
            refine Finset.sum_congr rfl fun i _ => ?_
            rw [hyab i, ← pow_mul]
            simp only [map_add, map_mul, map_pow, hψW, hs']
            ring
      _ = ψh (algebraMap ↥W A τP * bP) := by
            rw [← hPeq]
            simp only [map_add, map_sum, map_mul, map_pow]
      _ = _ := by rw [map_mul, hψW, hsP]; ring
  exact ⟨ψh g, rfl, hcore m k e (ψh ζ) (ψh g ^ D) τ (sP * ψh bP) (fun i => ψh (a i))
    (fun i => s' i * ψh (b' i)) hm hz heτ hrel⟩

theorem wcpa_dj_lr1k_nsr_gub_bff_dc_ia_os_lb_gauss : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω) (p : Polynomial ↥W) (e : ↥W) (l : ℕ), e ≠ 0 →
    IsUnit (p.coeff l) → ∃ s : ↥W, p.eval (e * s) ∣ e ^ l :=
by
  intro Ω _ _ W p e l he hu
  classical

  have s1 : IsAlgClosed (IsLocalRing.ResidueField W) := by
    apply IsAlgClosed.of_exists_root
    intro pb hmon hirr
    obtain ⟨g, hgs⟩ := Polynomial.map_surjective (IsLocalRing.residue W)
      IsLocalRing.residue_surjective pb
    have hlift : pb ∈ Polynomial.lifts (IsLocalRing.residue W) :=
      (Polynomial.lifts_iff_set_range pb).mpr ⟨g, hgs⟩
    obtain ⟨f, hf, hfdeg, hfmon⟩ := Polynomial.lifts_and_natDegree_eq_and_monic hlift hmon
    have hpos : 0 < pb.natDegree :=
      hmon.natDegree_pos.mpr (fun h => hirr.not_isUnit (h ▸ isUnit_one))
    have hdeg : (f.map (algebraMap W Ω)).degree ≠ 0 := by
      rw [hfmon.degree_map, Polynomial.degree_eq_natDegree hfmon.ne_zero]
      exact_mod_cast (by omega : f.natDegree ≠ 0)
    obtain ⟨β, hβ⟩ := IsAlgClosed.exists_root _ hdeg
    have hint : IsIntegral W β :=
      ⟨f, hfmon, by rwa [Polynomial.IsRoot, Polynomial.eval_map] at hβ⟩
    obtain ⟨y, hy⟩ := (IsIntegrallyClosed.isIntegral_iff (R := W) (K := Ω)).mp hint
    have hfy : f.eval y = 0 := by
      apply IsFractionRing.injective W Ω
      rw [map_zero, ← Polynomial.eval₂_at_apply, hy, ← Polynomial.eval_map]
      exact hβ
    refine ⟨IsLocalRing.residue W y, ?_⟩
    rw [← hf, Polynomial.eval_map, Polynomial.eval₂_at_apply, hfy, map_zero]
  have : Infinite (IsLocalRing.ResidueField W) := inferInstance

  have s2 : ∀ (q : Polynomial W) (j : ℕ), IsUnit (q.coeff j) → ∃ s : W, IsUnit (q.eval s) := by
    intro q j hq
    have hne : q.map (IsLocalRing.residue W) ≠ 0 := by
      intro h
      have h2 := congrArg (fun r => r.coeff j) h
      simp only [Polynomial.coeff_map, Polynomial.coeff_zero] at h2
      exact (IsLocalRing.residue_ne_zero_iff_isUnit _).mpr hq h2
    by_contra hcon
    push Not at hcon
    apply hne
    apply Polynomial.funext
    intro x
    obtain ⟨s, rfl⟩ := IsLocalRing.residue_surjective x
    rw [Polynomial.eval_map, Polynomial.eval₂_at_apply, Polynomial.eval_zero]
    by_contra h
    exact hcon s ((IsLocalRing.residue_ne_zero_iff_isUnit _).mp h)

  have s3 : ∀ (c : ℕ → W) (N : ℕ), ∃ j ≤ N, ∀ i ≤ N, c j ∣ c i := by
    intro c N
    induction N with
    | zero => exact ⟨0, le_rfl, fun i hi => by rw [Nat.le_zero.mp hi]⟩
    | succ N ih =>
      obtain ⟨j, hj, hjd⟩ := ih
      rcases ValuationRing.dvd_total (c j) (c (N+1)) with h | h
      · refine ⟨j, by omega, fun i hi => ?_⟩
        rcases Nat.lt_or_ge i (N+1) with h' | h'
        · exact hjd i (by omega)
        · rw [show i = N+1 by omega]; exact h
      · refine ⟨N+1, le_rfl, fun i hi => ?_⟩
        rcases Nat.lt_or_ge i (N+1) with h' | h'
        · exact h.trans (hjd i (by omega))
        · rw [show i = N+1 by omega]

  have hpl0 : p.coeff l ≠ 0 := hu.ne_zero
  have hlN : l ≤ p.natDegree := Polynomial.le_natDegree_of_ne_zero hpl0
  obtain ⟨j, hjN, hj⟩ := s3 (fun i => p.coeff i * e ^ i) p.natDegree
  have hδl : p.coeff j * e ^ j ∣ e ^ l := hu.dvd_mul_left.mp (hj l hlN)
  have hδ0 : p.coeff j * e ^ j ≠ 0 := by
    intro h0
    have h1 := hj l hlN
    rw [h0, zero_dvd_iff] at h1
    exact mul_ne_zero hpl0 (pow_ne_zero _ he) h1
  have hq : Polynomial.C (p.coeff j * e ^ j) ∣ p.comp (Polynomial.C e * Polynomial.X) := by
    rw [Polynomial.C_dvd_iff_dvd_coeff]
    intro i
    rw [Polynomial.comp_C_mul_X_coeff]
    by_cases hi : i ≤ p.natDegree
    · exact hj i hi
    · rw [Polynomial.coeff_eq_zero_of_natDegree_lt (p := p) (n := i) (by omega), zero_mul]
      exact dvd_zero _
  obtain ⟨q₁, hq₁⟩ := hq
  have hq1j : q₁.coeff j = 1 := by
    have h1 := congrArg (fun r => r.coeff j) hq₁
    simp only [Polynomial.comp_C_mul_X_coeff, Polynomial.coeff_C_mul] at h1
    exact mul_left_cancel₀ hδ0 (h1.symm.trans (mul_one _).symm)
  obtain ⟨s, hs⟩ := s2 q₁ j (by rw [hq1j]; exact isUnit_one)
  refine ⟨s, ?_⟩
  have heval : p.eval (e * s) = (p.coeff j * e ^ j) * q₁.eval s := by
    have h1 := congrArg (Polynomial.eval s) hq₁
    rw [Polynomial.eval_comp, Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_X,
      Polynomial.eval_mul, Polynomial.eval_C] at h1
    exact h1
  rw [heval]
  exact (hs.mul_right_dvd.mpr dvd_rfl).trans hδl

theorem wcpa_dj_lr1k_nsr_gub_bff_dc_ia_os_lb_power_trick : ∀ (R : Type u) [CommRing R]
    (J : Ideal R) (x z : R) (r D' k : ℕ) (a : Fin r → R) (n : Fin r → ℕ), 1 ≤ D' →
    (∀ i : Fin r, (i.1 + 1) * k ≤ D' * n i) → (∀ i, a i ∈ Ideal.span {z ^ n i} ⊔ J) →
    x ^ r + ∑ i : Fin r, a i * x ^ (r - 1 - i.1) ∈ J →
    ∃ c : Fin r → R, (∀ j : Fin r, c j ∈ Ideal.span {z ^ (k * (j.1 + 1))} ⊔ J) ∧
      x ^ (D' * r) + ∑ j : Fin r, c j * x ^ (D' * (r - 1 - j.1)) ∈ J :=
by
  intro R _

  have pt_ceil : ∀ (J : Ideal R) (z : R) (D' : ℕ), 1 ≤ D' →
      ∀ (G : ℤ → Ideal R), (∀ L : ℤ, G L = Ideal.span {z ^ ((L.toNat + D' - 1) / D')} ⊔ J) →
      G 0 = ⊤ ∧ (∀ L M : ℤ, G L * G M ≤ G (L + M)) ∧
      (∀ (m : ℕ) (L : ℤ), L ≤ (D' : ℤ) * m → Ideal.span {z ^ m} ⊔ J ≤ G L) ∧
      (∀ t : ℕ, G ((D' : ℤ) * t) ≤ Ideal.span {z ^ t} ⊔ J) := by
    intro J z D' hD G hG
    have anti : ∀ m m' : ℕ, m ≤ m' → Ideal.span {z ^ m'} ⊔ J ≤ Ideal.span {z ^ m} ⊔ J := by
      intro m m' h
      apply sup_le_sup_right
      rw [Ideal.span_singleton_le_span_singleton]
      exact pow_dvd_pow z h
    have mulF : ∀ a b : ℕ, (Ideal.span {z ^ a} ⊔ J) * (Ideal.span {z ^ b} ⊔ J) ≤
        Ideal.span {z ^ (a + b)} ⊔ J := by
      intro a b
      rw [Ideal.sup_mul, Ideal.mul_sup, Ideal.mul_sup, Ideal.span_singleton_mul_span_singleton,
        ← pow_add]
      have h1 : Ideal.span {z ^ a} * J ≤ J := Ideal.mul_le_right
      have h2 : J * Ideal.span {z ^ b} ≤ J := Ideal.mul_le_left
      have h3 : J * J ≤ J := Ideal.mul_le_left
      exact sup_le (sup_le le_sup_left (h1.trans le_sup_right))
        (sup_le (h2.trans le_sup_right) (h3.trans le_sup_right))
    have hDpos : 0 < D' := by omega
    refine ⟨?_, ?_, ?_, ?_⟩
    · rw [hG]
      have : ((0 : ℤ).toNat + D' - 1) / D' = 0 := Nat.div_eq_of_lt (by simp; omega)
      rw [this, pow_zero, Ideal.span_singleton_one, top_sup_eq]
    · intro L M
      rw [hG L, hG M, hG (L + M)]
      refine le_trans (mulF _ _) (anti _ _ ?_)
      have hw : (L + M).toNat ≤ L.toNat + M.toNat := by omega
      have h1 := Nat.lt_div_mul_add (a := L.toNat + D' - 1) hDpos
      have h2 := Nat.lt_div_mul_add (a := M.toNat + D' - 1) hDpos
      rw [← Nat.lt_succ_iff, Nat.div_lt_iff_lt_mul hDpos]
      rw [Nat.succ_eq_add_one, add_mul, add_mul, one_mul]
      omega
    · intro m L hL
      rw [hG L]
      apply anti
      have hu : L.toNat ≤ D' * m := Int.toNat_le.mpr (by push_cast; exact hL)
      rw [← Nat.lt_succ_iff, Nat.div_lt_iff_lt_mul hDpos]
      rw [Nat.succ_eq_add_one, add_mul, one_mul, mul_comm m D']
      omega
    · intro t
      rw [hG]
      apply anti
      have e : ((D' : ℤ) * (t : ℤ)).toNat = D' * t := by
        rw [show (D' : ℤ) * (t : ℤ) = ((D' * t : ℕ) : ℤ) by push_cast; ring, Int.toNat_natCast]
      rw [e, Nat.le_div_iff_mul_le hDpos, mul_comm t D']
      omega

  have pt_pow : ∀ (G : ℤ → Ideal R) (r : ℕ) (C : Matrix (Fin r) (Fin r) R) (κ δ : ℤ),
      G 0 = ⊤ → (∀ L M : ℤ, G L * G M ≤ G (L + M)) →
      (∀ p q : Fin r, C p q ∈ G (κ * ((p.1 : ℤ) - (q.1 : ℤ)) + δ)) →
      ∀ (m : ℕ) (p q : Fin r), (C ^ m) p q ∈ G (κ * ((p.1 : ℤ) - (q.1 : ℤ)) + δ * (m : ℤ)) := by
    intro G r C κ δ h0 hmul hC m
    induction m with
    | zero =>
      intro p q
      rw [pow_zero, Matrix.one_apply]
      split_ifs with h
      · subst h; simp [h0]
      · exact Submodule.zero_mem _
    | succ m ih =>
      intro p q
      rw [pow_succ, Matrix.mul_apply]
      refine Ideal.sum_mem _ (fun l _ => ?_)
      have := hmul _ _ (Ideal.mul_mem_mul (ih p l) (hC l q))
      convert this using 2
      push_cast; ring

  have pt_charpoly_weight : ∀ (G : ℤ → Ideal R) (r : ℕ) (N : Matrix (Fin r) (Fin r) R)
      (κ δ : ℤ), G 0 = ⊤ → (∀ L M : ℤ, G L * G M ≤ G (L + M)) →
      (∀ p q : Fin r, N p q ∈ G (κ * ((p.1 : ℤ) - (q.1 : ℤ)) + δ)) →
      ∀ d : ℕ, N.charpoly.coeff d ∈ G (δ * ((r : ℤ) - (d : ℤ))) := by
    intro G r N κ δ h0 hmul hN
    classical
    have g_add : ∀ (L : ℤ) (f g : Polynomial R), (∀ d : ℕ, f.coeff d ∈ G (L - δ * d)) →
        (∀ d : ℕ, g.coeff d ∈ G (L - δ * d)) → ∀ d : ℕ, (f + g).coeff d ∈ G (L - δ * d) := by
      intro L f g hf hg d
      rw [Polynomial.coeff_add]
      exact Ideal.add_mem _ (hf d) (hg d)
    have g_sum : ∀ (L : ℤ) (s : Finset (Equiv.Perm (Fin r)))
        (F : Equiv.Perm (Fin r) → Polynomial R),
        (∀ σ ∈ s, ∀ d : ℕ, (F σ).coeff d ∈ G (L - δ * d)) →
        ∀ d : ℕ, (∑ σ ∈ s, F σ).coeff d ∈ G (L - δ * d) := by
      intro L s F hF
      induction s using Finset.induction_on with
      | empty => intro d; simp
      | insert a s ha ih =>
        rw [Finset.sum_insert ha]
        exact g_add _ _ _ (hF a (Finset.mem_insert_self _ _))
          (ih (fun σ hσ => hF σ (Finset.mem_insert_of_mem hσ)))
    have g_zsmul : ∀ (L : ℤ) (f : Polynomial R) (u : ℤˣ),
        (∀ d : ℕ, f.coeff d ∈ G (L - δ * d)) → ∀ d : ℕ, (u • f).coeff d ∈ G (L - δ * d) := by
      intro L f u hf d
      rcases Int.units_eq_one_or u with rfl | rfl
      · rw [one_smul]; exact hf d
      · rw [Units.neg_smul, one_smul, Polynomial.coeff_neg]
        exact (G _).neg_mem (hf d)
    have g_one : ∀ d : ℕ, (1 : Polynomial R).coeff d ∈ G (0 - δ * d) := by
      intro d
      rw [Polynomial.coeff_one]
      split_ifs with h
      · subst h; simp [h0]
      · exact Submodule.zero_mem _
    have g_mul : ∀ (L M : ℤ) (f g : Polynomial R), (∀ d : ℕ, f.coeff d ∈ G (L - δ * d)) →
        (∀ d : ℕ, g.coeff d ∈ G (M - δ * d)) →
        ∀ d : ℕ, (f * g).coeff d ∈ G (L + M - δ * d) := by
      intro L M f g hf hg d
      rw [Polynomial.coeff_mul]
      refine Ideal.sum_mem _ (fun ij hij => ?_)
      have hij' : ij.1 + ij.2 = d := by simpa using hij
      have := hmul _ _ (Ideal.mul_mem_mul (hf ij.1) (hg ij.2))
      convert this using 2
      rw [← hij']; push_cast; ring
    have g_fac : ∀ (σ : Equiv.Perm (Fin r)) (i : Fin r) (d : ℕ),
        (N.charmatrix (σ i) i).coeff d ∈ G (κ * (((σ i).1 : ℤ) - (i.1 : ℤ)) + δ - δ * d) := by
      intro σ i d
      rw [Matrix.charmatrix_apply, Polynomial.coeff_sub, Matrix.diagonal_apply]
      refine Ideal.sub_mem _ ?_ ?_
      · split_ifs with hs
        · rw [Polynomial.coeff_X]
          split_ifs with hd
          · subst hd
            have : κ * (((σ i).1 : ℤ) - (i.1 : ℤ)) + δ - δ * ((1 : ℕ) : ℤ) = 0 := by
              rw [hs]; push_cast; ring
            rw [this, h0]; exact Submodule.mem_top
          · exact Submodule.zero_mem _
        · rw [Polynomial.coeff_zero]; exact Submodule.zero_mem _
      · rw [Polynomial.coeff_C]
        split_ifs with hd
        · subst hd
          convert hN (σ i) i using 2
          push_cast; ring
        · exact Submodule.zero_mem _
    have g_prod : ∀ (σ : Equiv.Perm (Fin r)) (s : Finset (Fin r)) (d : ℕ),
        (∏ i ∈ s, N.charmatrix (σ i) i).coeff d ∈
          G ((∑ i ∈ s, (κ * (((σ i).1 : ℤ) - (i.1 : ℤ)) + δ)) - δ * d) := by
      intro σ s
      induction s using Finset.induction_on with
      | empty => intro d; simpa using g_one d
      | insert a s ha ih =>
        rw [Finset.prod_insert ha, Finset.sum_insert ha]
        exact g_mul _ _ _ _ (g_fac σ a) ih
    have g_total : ∀ σ : Equiv.Perm (Fin r),
        ∑ i : Fin r, (κ * (((σ i).1 : ℤ) - (i.1 : ℤ)) + δ) = (r : ℤ) * δ := by
      intro σ
      have hc : ∑ i : Fin r, (((σ i).1 : ℕ) : ℤ) = ∑ i : Fin r, ((i.1 : ℕ) : ℤ) :=
        Equiv.sum_comp σ (fun j : Fin r => ((j.1 : ℕ) : ℤ))
      rw [Finset.sum_add_distrib, ← Finset.mul_sum, Finset.sum_sub_distrib, hc, sub_self,
        mul_zero, zero_add, Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
    have hgood : ∀ d : ℕ, N.charpoly.coeff d ∈ G ((r : ℤ) * δ - δ * d) := by
      rw [Matrix.charpoly, Matrix.det_apply]
      apply g_sum
      intro σ _
      apply g_zsmul
      intro d
      have := g_prod σ Finset.univ d
      rw [g_total σ] at this
      exact this
    intro d
    convert hgood d using 2
    ring

  have pt_eval : ∀ (r : ℕ) (N : Matrix (Fin r) (Fin r) R) (y : R),
      N.charpoly.eval y =
        y ^ r + ∑ j : Fin r, N.charpoly.coeff (r - 1 - j.1) * y ^ (r - 1 - j.1) := by
    intro r N y
    rcases subsingleton_or_nontrivial R with hR | hR
    · exact Subsingleton.elim _ _
    have hdeg : N.charpoly.natDegree = r := by
      rw [Matrix.charpoly_natDegree_eq_dim, Fintype.card_fin]
    have hmon := Matrix.charpoly_monic N
    rw [Polynomial.eval_eq_sum_range, hdeg, Finset.sum_range_succ]
    have hr : N.charpoly.coeff r = 1 := by
      have := hmon.coeff_natDegree
      rwa [hdeg] at this
    rw [hr, one_mul, add_comm]
    congr 1
    rw [Fin.sum_univ_eq_sum_range (fun d => N.charpoly.coeff (r - 1 - d) * y ^ (r - 1 - d)) r]
    exact (Finset.sum_range_reflect (fun d => N.charpoly.coeff d * y ^ d) r).symm

  have pt_comp : ∀ (J : Ideal R) (x : R) (r : ℕ) (a : Fin r → R),
      x ^ r + ∑ i : Fin r, a i * x ^ (r - 1 - i.1) ∈ J → ∀ p : Fin r,
      (Matrix.of (fun p q : Fin r => if p.1 = r - 1 then -a (Fin.rev q)
        else if q.1 = p.1 + 1 then (1 : R) else 0)).mulVec (fun q : Fin r => x ^ q.1) p
        - x * x ^ p.1 ∈ J := by
    intro J x r a hP p
    simp only [Matrix.mulVec, dotProduct, Matrix.of_apply]
    by_cases hp : p.1 = r - 1
    · have e1 : ∀ q : Fin r, (if p.1 = r - 1 then -a (Fin.rev q)
          else if q.1 = p.1 + 1 then (1 : R) else 0) * x ^ q.1 = -a (Fin.rev q) * x ^ q.1 :=
        fun q => by rw [if_pos hp]
      simp only [e1]
      have hsum : ∑ q : Fin r, -a (Fin.rev q) * x ^ q.1
          = -∑ i : Fin r, a i * x ^ (r - 1 - i.1) := by
        rw [← Equiv.sum_comp Fin.revPerm, ← Finset.sum_neg_distrib]
        refine Finset.sum_congr rfl (fun i _ => ?_)
        rw [Fin.revPerm_apply, Fin.rev_rev, Fin.val_rev, neg_mul]
        congr 3
        omega
      have hr : x * x ^ p.1 = x ^ r := by
        rw [← pow_succ']; congr 1; have := p.2; omega
      rw [hr, hsum]
      have : -∑ i : Fin r, a i * x ^ (r - 1 - i.1) - x ^ r
          = -(x ^ r + ∑ i : Fin r, a i * x ^ (r - 1 - i.1)) := by ring
      rw [this]
      exact J.neg_mem hP
    · have hlt : p.1 + 1 < r := by have := p.2; omega
      rw [Finset.sum_eq_single ⟨p.1 + 1, hlt⟩]
      · simp only [if_neg hp, if_true, one_mul]
        rw [pow_succ', sub_self]
        exact J.zero_mem
      · intro q _ hq
        rw [if_neg hp, if_neg, zero_mul]
        intro h; apply hq; exact Fin.ext h
      · intro h; exact absurd (Finset.mem_univ _) h

  have pt_cayley : ∀ (J : Ideal R) (x : R) (r : ℕ) (C : Matrix (Fin r) (Fin r) R)
      (v : Fin r → R) (D : ℕ) (p₀ : Fin r), v p₀ = 1 →
      (∀ p : Fin r, C.mulVec v p - x * v p ∈ J) → ((C ^ D).charpoly).eval (x ^ D) ∈ J := by
    intro J x r C v D p₀ hv hC
    set π := Ideal.Quotient.mk J with hπ
    set w : Fin r → R ⧸ J := fun p => π (v p) with hw
    have hCw : (C.map π).mulVec w = π x • w := by
      ext p
      have := (Ideal.Quotient.eq_zero_iff_mem).mpr (hC p)
      rw [map_sub, map_mul, sub_eq_zero] at this
      rw [Pi.smul_apply, smul_eq_mul, ← this, RingHom.map_mulVec]
      rfl
    have hCm : ∀ m : ℕ, ((C.map π) ^ m).mulVec w = π x ^ m • w := by
      intro m
      induction m with
      | zero => rw [pow_zero, pow_zero, Matrix.one_mulVec, one_smul]
      | succ m ih =>
        rw [pow_succ', ← Matrix.mulVec_mulVec, ih, Matrix.mulVec_smul, hCw, smul_smul, pow_succ]
    set N := (C ^ D).map π with hN
    set y := π (x ^ D) with hy
    have hNw : N.mulVec w = y • w := by
      rw [hN, Matrix.map_pow, hCm, hy, map_pow]
    have hpoly : ∀ f : Polynomial (R ⧸ J), (Polynomial.aeval N f).mulVec w = f.eval y • w := by
      intro f
      induction f using Polynomial.induction_on with
      | C a =>
        rw [Polynomial.aeval_C, Polynomial.eval_C, Algebra.algebraMap_eq_smul_one,
          Matrix.smul_mulVec, Matrix.one_mulVec]
      | add p q hp hq =>
        rw [map_add, Matrix.add_mulVec, hp, hq, Polynomial.eval_add, add_smul]
      | monomial n a ih =>
        rw [pow_succ, ← mul_assoc, map_mul, Polynomial.aeval_X, ← Matrix.mulVec_mulVec, hNw,
          Matrix.mulVec_smul, ih, smul_smul]
        congr 1
        simp only [Polynomial.eval_mul, Polynomial.eval_X, Polynomial.eval_pow, Polynomial.eval_C]
        ring
    have h0 := hpoly N.charpoly
    rw [Matrix.aeval_self_charpoly, Matrix.zero_mulVec] at h0
    have h1 := congrFun h0 p₀
    rw [Pi.zero_apply, Pi.smul_apply, smul_eq_mul, hw] at h1
    simp only [hv, map_one, mul_one] at h1
    rw [hN, Matrix.charpoly_map, Polynomial.eval_map, hy, Polynomial.eval₂_at_apply] at h1
    exact (Ideal.Quotient.eq_zero_iff_mem).mp h1.symm

  intro J x z r D' k a n hD hn ha hP
  rcases Nat.eq_zero_or_pos r with hr | hr
  · subst hr
    refine ⟨fun j => j.elim0, fun j => j.elim0, ?_⟩
    simpa using hP
  · let C : Matrix (Fin r) (Fin r) R := Matrix.of (fun p q : Fin r => if p.1 = r - 1 then
      -a (Fin.rev q) else if q.1 = p.1 + 1 then (1 : R) else 0)
    let v : Fin r → R := fun q => x ^ q.1
    have h6 := pt_comp J x r a hP
    have h1 := pt_cayley J x r C v D' ⟨0, hr⟩ (by simp [v]) h6
    refine ⟨fun j => (C ^ D').charpoly.coeff (r - 1 - j.1), ?_, ?_⟩
    · obtain ⟨G, hG⟩ : ∃ G : ℤ → Ideal R,
          ∀ L : ℤ, G L = Ideal.span {z ^ ((L.toNat + D' - 1) / D')} ⊔ J := ⟨_, fun L => rfl⟩
      obtain ⟨hG0, hGmul, hGle, hGt⟩ := pt_ceil J z D' hD G hG
      have hCw : ∀ p q : Fin r, C p q ∈ G ((k : ℤ) * ((p.1 : ℤ) - (q.1 : ℤ)) + (k : ℤ)) := by
        intro p q
        simp only [C, Matrix.of_apply]
        split_ifs with hp hq
        · refine (G _).neg_mem ?_
          refine hGle (n (Fin.rev q)) _ ?_ (ha _)
          have h := hn (Fin.rev q)
          rw [Fin.val_rev] at h
          have e : ((r - (q.1 + 1) + 1 : ℕ) : ℤ) = (p.1 : ℤ) - q.1 + 1 := by
            have := q.2; have := p.2; omega
          have e2 : (k : ℤ) * ((p.1 : ℤ) - (q.1 : ℤ)) + k
              = (((r - (q.1 + 1) + 1) * k : ℕ) : ℤ) := by
            rw [Nat.cast_mul, e]; ring
          rw [e2]
          exact_mod_cast h
        · have : (k : ℤ) * ((p.1 : ℤ) - (q.1 : ℤ)) + k = 0 := by rw [hq]; push_cast; ring
          rw [this, hG0]; exact Submodule.mem_top
        · exact (G _).zero_mem
      have h4 := pt_pow G r C k k hG0 hGmul hCw D'
      have h2 := pt_charpoly_weight G r (C ^ D') k ((k : ℤ) * (D' : ℤ)) hG0 hGmul h4
      intro j
      have hj := h2 (r - 1 - j.1)
      have hidx : (k : ℤ) * (D' : ℤ) * ((r : ℤ) - ((r - 1 - j.1 : ℕ) : ℤ))
          = (D' : ℤ) * ((k * (j.1 + 1) : ℕ) : ℤ) := by
        have : ((r - 1 - j.1 : ℕ) : ℤ) = (r : ℤ) - 1 - j.1 := by have := j.2; omega
        rw [this]; push_cast; ring
      rw [hidx] at hj
      exact hGt _ hj
    · have h5 := pt_eval r (C ^ D') (x ^ D')
      rw [h5] at h1
      simp only [← pow_mul] at h1
      exact h1

theorem wcpa_dj_lr1k_nsr_gub_bff_dc_ia_os_lower_bound : ∀ (Ω : Type u) [Field Ω]
    [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) →
    W ≠ ⊤ → ∀ (A : Type u) [CommRing A] [Algebra ↥W A] (ϖ : ↥W) (ζ : A),
      wcBffBase W A ϖ → wcBffNoether W A ζ →
    ∃ e_c : ↥W, e_c ≠ 0 ∧ e_c ∈ IsLocalRing.maximalIdeal ↥W ∧
      ∀ (D' k : ℕ) (g : A) (e w : ↥W), 1 ≤ D' → e ≠ 0 → e ∈ IsLocalRing.maximalIdeal ↥W →
        e ∣ e_c →
        (∀ ψ : wcGubGen W A →+* Ω, wcIaPt W A ζ e ψ →
          ∃ u : ↥W, ψ (algebraMap A (wcGubGen W A) g) = (w : Ω) * (u : Ω)) →
        e ^ k ∣ w ^ D' → wcIaResOrd W A ζ D' k g :=
by
  intro Ω _ _ W hdimW hWt A _ _ ϖ ζ hbase hN
  classical
  have hb := hbase
  obtain ⟨hϖ0, hϖm, hdom, _, hfp, htf, hred, _⟩ := hb
  set J : Ideal A := (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) with hJ

  have hunitE : ∀ e : ↥W, e ≠ 0 → IsUnit (algebraMap A (wcGubGen W A) (algebraMap ↥W A e)) := by
    intro e he
    exact IsLocalization.map_units (M := Submonoid.map (algebraMap ↥W A) (nonZeroDivisors ↥W))
      (wcGubGen W A)
      ⟨algebraMap ↥W A e, Submonoid.mem_map_of_mem _ (mem_nonZeroDivisors_of_ne_zero he)⟩

  have hpt : ∀ (e s : ↥W) (ψ : wcGubGen W A →+* Ω), e ≠ 0 →
      ψ (algebraMap A (wcGubGen W A) (algebraMap ↥W A e)) = (e : Ω) →
      ψ (algebraMap A (wcGubGen W A) ζ) = (e : Ω) * (s : Ω) →
      ψ (algebraMap A (wcGubGen W A) ζ *
        Ring.inverse (algebraMap A (wcGubGen W A) (algebraMap ↥W A e))) ∈ W := by
    intro e s ψ he hψe hψz
    obtain ⟨v, hv⟩ := hunitE e he
    have he' : (e : Ω) ≠ 0 := fun h => he (by simpa using h)
    have hinv : ψ ((v⁻¹ : (wcGubGen W A)ˣ) : wcGubGen W A) = (e : Ω)⁻¹ := by
      apply eq_inv_of_mul_eq_one_right
      rw [← hψe, ← hv, ← map_mul, Units.mul_inv, map_one]
    rw [← hv, Ring.inverse_unit, map_mul, hψz, hinv, mul_comm, ← mul_assoc, inv_mul_cancel₀ he',
      one_mul]
    exact s.2

  have hm1 : ∀ (D' k : ℕ) (g y : A), y ∈ Ideal.span {ζ ^ (k * (0 + 1))} ⊔ J →
      g ^ D' + y ∈ J → wcIaResOrd W A ζ D' k g := by
    intro D' k g y hy hs
    unfold wcIaResOrd
    refine ⟨1, fun _ => y, Nat.one_pos, fun i => ?_, ?_⟩
    · have hi : i.1 = 0 := by have := i.isLt; omega
      rw [hi]; exact hy
    · simpa using hs
  rcases dc_bt_dichotomy Ω W A ζ hdom hfp htf hred hN with hI | hII
  ·
    have hinj : Function.Injective (algebraMap ↥W A) := by
      intro x y hxy
      by_contra hne
      have h0 : algebraMap ↥W A (x - y) * 1 = 0 := by rw [map_sub, hxy, sub_self, zero_mul]
      exact one_ne_zero (htf (x - y) 1 (sub_ne_zero.mpr hne) h0)
    obtain ⟨z, hz⟩ := hI ζ
    let eqv : ↥W ≃+* A := RingEquiv.ofBijective (algebraMap ↥W A)
      ⟨hinj, fun a => (hI a).imp fun _ hw => hw.symm⟩
    have heqv : ∀ w : ↥W, eqv.symm (algebraMap ↥W A w) = w := fun w => eqv.symm_apply_apply w
