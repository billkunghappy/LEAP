      IsLocalization.integerNormalization_spec (nonZeroDivisors P) (r x)
    have hclaim : ∀ x : A, algebraMap P A (b x) * x =
        Polynomial.aeval a (IsLocalization.integerNormalization (nonZeroDivisors P) (r x)) := by
      intro x
      apply IsFractionRing.injective A K
      have hbr : b x • r x = Polynomial.C (algebraMap P F₀ (b x)) * r x := by
        ext i
        rw [Polynomial.coeff_smul, Polynomial.coeff_C_mul, Algebra.smul_def]
