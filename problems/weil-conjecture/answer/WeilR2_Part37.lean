        (fun y' => wcpaDjLkImg W (γ ≫ ι') (r ≫ uX) y' ∈ r ⁻¹ᵁ V) e ?_ ?_
      · intro y' hy'
        have h1 : wcpaDjLkImg W (γ ≫ ι') (r ≫ uX) y' ∉ (⇑r ⁻¹' (V : Set X)) :=
          fun h => hy' ((Scheme.Hom.mem_preimage r).mpr h)
        show (if wcpaDjLkImg W (γ ≫ ι') (r ≫ uX) y' ∈ (⇑r ⁻¹' (V : Set X)) then
          wcpaDjLkTerm W (γ ≫ ι') (r ≫ uX) y' else 0) = 0
        rw [if_neg h1]
      · intro z
        have h1 : wcpaDjLkImg W (γ ≫ ι') (r ≫ uX) z.1 ∈ (⇑r ⁻¹' (V : Set X)) :=
          (Scheme.Hom.mem_preimage r).mp z.2
        have h2 : wcpaDjLkImg W (γ ≫ ι) uX (e z).1 ∈ (V : Set X) := (e z).2
        show (if wcpaDjLkImg W (γ ≫ ι') (r ≫ uX) z.1 ∈ (⇑r ⁻¹' (V : Set X)) then
          wcpaDjLkTerm W (γ ≫ ι') (r ≫ uX) z.1 else 0) =
          (if wcpaDjLkImg W (γ ≫ ι) uX (e z).1 ∈ (V : Set X) then
          wcpaDjLkTerm W (γ ≫ ι) uX (e z).1 else 0)
        rw [if_pos h1, if_pos h2]
        exact hterm z
    · refine transport _ _ (fun y' => wcpaDjLkImg W (γ ≫ ι') (r ≫ uX) y' ∈ r ⁻¹ᵁ V)
        (fun y => wcpaDjLkImg W (γ ≫ ι) uX y ∈ V) e.symm ?_ ?_
      · intro y hy
        have h1 : wcpaDjLkImg W (γ ≫ ι) uX y ∉ (V : Set X) := hy
        show (if wcpaDjLkImg W (γ ≫ ι) uX y ∈ (V : Set X) then
          wcpaDjLkTerm W (γ ≫ ι) uX y else 0) = 0
        rw [if_neg h1]
      · intro z
        have h1 : wcpaDjLkImg W (γ ≫ ι) uX z.1 ∈ (V : Set X) := z.2
        have h2 : wcpaDjLkImg W (γ ≫ ι') (r ≫ uX) (e.symm z).1 ∈ (⇑r ⁻¹' (V : Set X)) :=
          (Scheme.Hom.mem_preimage r).mp (e.symm z).2
        show (if wcpaDjLkImg W (γ ≫ ι) uX z.1 ∈ (V : Set X) then
          wcpaDjLkTerm W (γ ≫ ι) uX z.1 else 0) =
          (if wcpaDjLkImg W (γ ≫ ι') (r ≫ uX) (e.symm z).1 ∈ (⇑r ⁻¹' (V : Set X)) then
          wcpaDjLkTerm W (γ ≫ ι') (r ≫ uX) (e.symm z).1 else 0)
        rw [if_pos h1, if_pos h2]
        have := hterm (e.symm z)
        rw [Equiv.apply_symm_apply] at this
        exact this.symm
  have hfin := wcpa_dj_lr1k_imp_measure_finite Ω W hW hWt C γ hcov X uX ι hM
  have hc : wcpaDjLkLocM W (γ ≫ ι) uX (V : Set X) ≠ ⊤ :=
    ne_top_of_le_ne_top hfin.ne (hsplitX ▸ le_add_self)
  refine ⟨X', r ≫ uX, ι', inferInstance, inferInstance, hM', hA', ?_⟩
  rw [hsplitX', hsplitX, htr]
  exact (ENat.add_lt_add_iff_right hc).mpr H'.2

theorem wcpa_dj_lr1k_ndgq_ff_prime_count : ∀ (Ω A B K L : Type u) [Field Ω] [IsAlgClosed Ω] [CommRing A] [IsDomain A] [IsIntegrallyClosed A] [CommRing B] [IsDomain B] [Field K] [Field L] [Algebra Ω A] [Algebra Ω B] [Algebra A B] [IsScalarTower Ω A B] [Algebra A K] [IsFractionRing A K] [Algebra B L] [IsFractionRing B L] [Algebra K L] [Algebra A L] [IsScalarTower A K L] [IsScalarTower A B L] [Module.Finite A B] [Algebra.FiniteType Ω B] [FiniteDimensional K L] [Algebra.IsSeparable K L], ∃ Q : Fin (Module.finrank K L) → Ideal B, (∀ i, (Q i).IsPrime) ∧ Function.Injective Q ∧ ∀ i j, (Q i).comap (algebraMap A B) = (Q j).comap (algebraMap A B) :=
by
  intro Ω A B K L
  intros
  classical

  have hBL : Function.Injective (algebraMap B L) := IsFractionRing.injective B L
  have hinj : Function.Injective (algebraMap A B) := by
    have h1 : Function.Injective (algebraMap A L) := by
      rw [IsScalarTower.algebraMap_eq A K L]
      exact (algebraMap K L).injective.comp (IsFractionRing.injective A K)
    rw [IsScalarTower.algebraMap_eq A B L] at h1
    exact Function.Injective.of_comp h1
  haveI : Algebra.IsIntegral A B := Algebra.IsIntegral.of_finite A B

  obtain ⟨c, hcdeg, hcsep⟩ : ∃ c : B, (minpoly A c).natDegree = Module.finrank K L ∧
      ((minpoly A c).map (algebraMap A K)).Separable := by
    obtain ⟨α, hα⟩ := Field.exists_primitive_element K L
    obtain ⟨x, y, hy, hxy⟩ := IsFractionRing.div_surjective (A := B) α
    have hy0 : y ≠ 0 := nonZeroDivisors.ne_zero hy
    obtain ⟨c, d, hd, hdc⟩ := Algebra.IsAlgebraic.exists_smul_eq_mul A x hy0
    have hc : _root_.IsIntegral A c := Algebra.IsIntegral.isIntegral c
    refine ⟨c, ?_⟩
    have hdK : algebraMap A K d ≠ 0 := by
      rwa [Ne, IsFractionRing.to_map_eq_zero_iff]
    have hdL : algebraMap K L (algebraMap A K d) ≠ 0 := (map_ne_zero _).mpr hdK
    have hyL : algebraMap B L y ≠ 0 := (map_ne_zero_iff _ hBL).mpr hy0
    have hcomp : ∀ a : A, algebraMap B L (algebraMap A B a) =
        algebraMap K L (algebraMap A K a) := by
      intro a
      rw [← IsScalarTower.algebraMap_apply A B L, ← IsScalarTower.algebraMap_apply A K L]
    have heq : algebraMap K L (algebraMap A K d) * algebraMap B L x =
        algebraMap B L y * algebraMap B L c := by
      rw [← hcomp, ← map_mul, ← map_mul, ← Algebra.smul_def, hdc]
    have hαc : α = (algebraMap K L (algebraMap A K d))⁻¹ * algebraMap B L c := by
      rw [← hxy, eq_inv_mul_iff_mul_eq₀ hdL, mul_div_assoc', div_eq_iff hyL, heq]
      ring
    have hprim : IntermediateField.adjoin K {algebraMap B L c} = ⊤ := by
      rw [eq_top_iff, ← hα, IntermediateField.adjoin_simple_le_iff, hαc]
      exact IntermediateField.mul_mem _ (IntermediateField.inv_mem _
        (IntermediateField.algebraMap_mem _ _)) (IntermediateField.mem_adjoin_simple_self K _)
    have hmin : minpoly K (algebraMap B L c) = (minpoly A c).map (algebraMap A K) :=
      minpoly.isIntegrallyClosed_eq_field_fractions K L hc
    constructor
    · rw [← (minpoly.monic hc).natDegree_map (algebraMap A K), ← hmin]
      exact (Field.primitive_element_iff_minpoly_natDegree_eq K _).mp hprim
    · rw [← hmin]; exact Algebra.IsSeparable.isSeparable K _
  have hc : _root_.IsIntegral A c := Algebra.IsIntegral.isIntegral c
  have hfmon : (minpoly A c).Monic := minpoly.monic hc
  have hf0 : Polynomial.aeval c (minpoly A c) = 0 := minpoly.aeval A c
  haveI : Module.IsTorsionFree A B := Module.isTorsionFree_iff_algebraMap_injective.mpr hinj
  have hfdvd : ∀ g : Polynomial A, Polynomial.aeval c g = 0 → minpoly A c ∣ g :=
    fun g hg => minpoly.isIntegrallyClosed_dvd hc hg
  generalize minpoly A c = f at hfmon hf0 hfdvd hcdeg hcsep

  obtain ⟨δ, hδ0, U, V, hUV⟩ : ∃ δ : A, δ ≠ 0 ∧ ∃ U V : Polynomial A,
      U * f + V * Polynomial.derivative f = Polynomial.C δ := by
    obtain ⟨u, v, huv⟩ := (Polynomial.separable_def' _).mp hcsep
    obtain ⟨b₁, hb₁M, hb₁⟩ := IsLocalization.integerNormalization_spec (nonZeroDivisors A) u
    obtain ⟨b₂, hb₂M, hb₂⟩ := IsLocalization.integerNormalization_spec (nonZeroDivisors A) v
    have hU₁ : (IsLocalization.integerNormalization (nonZeroDivisors A) u).map (algebraMap A K) =
        Polynomial.C (algebraMap A K b₁) * u := by
      ext i
      rw [hb₁, Polynomial.coeff_smul, Polynomial.coeff_C_mul, Algebra.smul_def]
    have hV₁ : (IsLocalization.integerNormalization (nonZeroDivisors A) v).map (algebraMap A K) =
        Polynomial.C (algebraMap A K b₂) * v := by
      ext i
      rw [hb₂, Polynomial.coeff_smul, Polynomial.coeff_C_mul, Algebra.smul_def]
    refine ⟨b₁ * b₂, mul_ne_zero (nonZeroDivisors.ne_zero hb₁M)
      (nonZeroDivisors.ne_zero hb₂M),
      Polynomial.C b₂ * IsLocalization.integerNormalization (nonZeroDivisors A) u,
      Polynomial.C b₁ * IsLocalization.integerNormalization (nonZeroDivisors A) v, ?_⟩
    apply Polynomial.map_injective (algebraMap A K) (IsFractionRing.injective A K)
    simp only [Polynomial.map_add, Polynomial.map_mul, Polynomial.map_C, hU₁, hV₁]
    rw [← Polynomial.derivative_map, map_mul, Polynomial.C_mul]
    linear_combination (Polynomial.C (algebraMap A K b₁) * Polynomial.C (algebraMap A K b₂)) * huv

  have hbδ : algebraMap A B δ ≠ 0 := (map_ne_zero_iff _ hinj).mpr hδ0
  obtain ⟨φ, hφδ, hφΩ⟩ : ∃ φ : A →+* Ω, φ δ ≠ 0 ∧ ∀ x : Ω, φ (algebraMap Ω A x) = x := by
    haveI : IsJacobsonRing B := isJacobsonRing_of_finiteType (A := Ω)
    have hjac : (⊥ : Ideal B).jacobson = ⊥ :=
      IsJacobsonRing.out ‹_› Ideal.isPrime_bot.isRadical
    obtain ⟨J, hJmax, hbJ⟩ : ∃ J : Ideal B, J.IsMaximal ∧ algebraMap A B δ ∉ J := by
      by_contra hcon
      push_neg at hcon
      have hmem : algebraMap A B δ ∈ (⊥ : Ideal B).jacobson := by
        rw [Ideal.jacobson, Ideal.mem_sInf]
        rintro J ⟨-, hJ⟩
        exact hcon J hJ
      rw [hjac, Submodule.mem_bot] at hmem
      exact hbδ hmem
    haveI := hJmax
    letI := Ideal.Quotient.field J
    haveI : Algebra.FiniteType Ω (B ⧸ J) := Algebra.FiniteType.of_surjective
      (Ideal.Quotient.mkₐ Ω J) (Ideal.Quotient.mkₐ_surjective Ω J)
    haveI : Module.Finite Ω (B ⧸ J) := finite_of_finite_type_of_isJacobsonRing Ω (B ⧸ J)
    haveI : Algebra.IsIntegral Ω (B ⧸ J) := Algebra.IsIntegral.of_finite Ω (B ⧸ J)
    have hbij := IsAlgClosed.algebraMap_bijective_of_isIntegral (k := Ω) (K := B ⧸ J)
    let e := AlgEquiv.ofBijective (Algebra.ofId Ω (B ⧸ J)) hbij
    let ψ : B →ₐ[Ω] Ω := e.symm.toAlgHom.comp (Ideal.Quotient.mkₐ Ω J)
    refine ⟨(ψ : B →+* Ω).comp (algebraMap A B), ?_, ?_⟩
    · intro h
      apply hbJ
      rw [← Ideal.Quotient.eq_zero_iff_mem]
      have h' : e.symm (Ideal.Quotient.mk J (algebraMap A B δ)) = 0 := h
      exact (map_eq_zero_iff _ e.symm.injective).mp h'
    · intro x
      show ψ (algebraMap A B (algebraMap Ω A x)) = x
      rw [← IsScalarTower.algebraMap_apply Ω A B, ψ.commutes]
      rfl

  obtain ⟨r, hrinj, hr⟩ : ∃ r : Fin (Module.finrank K L) → Ω, Function.Injective r ∧
      ∀ i, Polynomial.eval₂ φ (r i) f = 0 := by
    have hmapUV := congrArg (Polynomial.map φ) hUV
    simp only [Polynomial.map_add, Polynomial.map_mul, Polynomial.map_C,
      ← Polynomial.derivative_map] at hmapUV
    have hgsep : (f.map φ).Separable := by
      rw [Polynomial.separable_def']
      refine ⟨Polynomial.C (φ δ)⁻¹ * U.map φ, Polynomial.C (φ δ)⁻¹ * V.map φ, ?_⟩
      calc Polynomial.C (φ δ)⁻¹ * U.map φ * f.map φ +
            Polynomial.C (φ δ)⁻¹ * V.map φ * Polynomial.derivative (f.map φ)
          = Polynomial.C (φ δ)⁻¹ * (U.map φ * f.map φ +
              V.map φ * Polynomial.derivative (f.map φ)) := by ring
        _ = 1 := by rw [hmapUV, ← Polynomial.C_mul, inv_mul_cancel₀ hφδ, Polynomial.C_1]
    have hg0 : f.map φ ≠ 0 := (hfmon.map φ).ne_zero
    have hgdeg : (f.map φ).natDegree = Module.finrank K L := by
      rw [hfmon.natDegree_map, hcdeg]
    have hcard : (f.map φ).roots.toFinset.card = Module.finrank K L := by
      rw [Multiset.toFinset_card_of_nodup (Polynomial.nodup_roots hgsep),
        ← (IsAlgClosed.splits _).natDegree_eq_card_roots, hgdeg]
    refine ⟨fun i => ((f.map φ).roots.toFinset.equivFin.symm (Fin.cast hcard.symm i) : Ω), ?_, ?_⟩
    · intro i j hij
      have := Subtype.val_injective hij
      exact Fin.cast_injective _ ((f.map φ).roots.toFinset.equivFin.symm.injective this)
    · intro i
      have hmem := ((f.map φ).roots.toFinset.equivFin.symm (Fin.cast hcard.symm i)).2
      rw [Multiset.mem_toFinset, Polynomial.mem_roots hg0, Polynomial.IsRoot,
        Polynomial.eval_map] at hmem
      exact hmem

  have h0 : Polynomial.eval₂ (algebraMap A B) c f = 0 := by rwa [Polynomial.aeval_def] at hf0
  have s5 : ∀ ρ : Ω, Polynomial.eval₂ φ ρ f = 0 → ∃ Q : Ideal B, Q.IsPrime ∧
      Q.comap (algebraMap A B) = RingHom.ker φ ∧ c - algebraMap Ω B ρ ∈ Q := by
    intro ρ hρ
    let α : AdjoinRoot f →+* B := AdjoinRoot.lift (algebraMap A B) c h0
    let χ : AdjoinRoot f →+* Ω := AdjoinRoot.lift φ ρ hρ
    have hαof : ∀ a : A, α (AdjoinRoot.of f a) = algebraMap A B a := fun a => AdjoinRoot.lift_of h0
    have hχof : ∀ a : A, χ (AdjoinRoot.of f a) = φ a := fun a => AdjoinRoot.lift_of hρ
    have hαroot : α (AdjoinRoot.root f) = c := AdjoinRoot.lift_root h0
    have hχroot : χ (AdjoinRoot.root f) = ρ := AdjoinRoot.lift_root hρ
    have hαinj : Function.Injective α := by
      rw [injective_iff_map_eq_zero]
      intro x hx
      obtain ⟨g, rfl⟩ := AdjoinRoot.mk_surjective x
      have hmk : α (AdjoinRoot.mk f g) = Polynomial.eval₂ (algebraMap A B) c g :=
        AdjoinRoot.lift_mk h0 g
      rw [hmk] at hx
      exact AdjoinRoot.mk_eq_zero.mpr (hfdvd g (by rwa [Polynomial.aeval_def]))
    letI : Algebra (AdjoinRoot f) B := α.toAlgebra
    haveI : IsScalarTower A (AdjoinRoot f) B :=
      IsScalarTower.of_algebraMap_eq' (RingHom.ext fun a => (hαof a).symm)
    haveI : Algebra.IsIntegral (AdjoinRoot f) B := Algebra.IsIntegral.tower_top A
    haveI : (RingHom.ker χ).IsPrime := RingHom.ker_isPrime χ
    obtain ⟨Q, -, hQp, hQ⟩ := Ideal.exists_ideal_over_prime_of_isIntegral (RingHom.ker χ)
      (⊥ : Ideal B) (by
        intro x hx
        have hx' : α x ∈ (⊥ : Ideal B) := hx
        rw [Submodule.mem_bot] at hx'
        rw [hαinj (hx'.trans (map_zero α).symm)]
        exact zero_mem _)
    have key : ∀ x : AdjoinRoot f, α x ∈ Q ↔ χ x = 0 := by
      intro x
      have h1 : x ∈ Ideal.under (AdjoinRoot f) Q ↔ x ∈ RingHom.ker χ := by rw [hQ]
      exact h1
    refine ⟨Q, hQp, ?_, ?_⟩
    · ext a
      rw [Ideal.mem_comap, RingHom.mem_ker, ← hαof, ← hχof]
      exact key _
    · have h2 := (key (AdjoinRoot.root f - AdjoinRoot.of f (algebraMap Ω A ρ))).mpr (by
        rw [map_sub, hχof, hφΩ, hχroot, sub_self])
      rwa [map_sub, hαof, hαroot, ← IsScalarTower.algebraMap_apply] at h2

  choose Q hQp hQc hQmem using fun i => s5 (r i) (hr i)
  refine ⟨Q, hQp, ?_, fun i j => by rw [hQc i, hQc j]⟩
  intro i j hij
  by_contra hne
  have hrne : r i ≠ r j := fun h => hne (hrinj h)
  have h1 := hQmem i
  have h2 := hQmem j
  rw [← hij] at h2
  have h3 : algebraMap Ω B (r j - r i) ∈ Q i := by
    have := Ideal.sub_mem _ h1 h2
    rw [map_sub]
    convert this using 1
    ring
  have hunit : IsUnit (algebraMap Ω B (r j - r i)) :=
    (sub_ne_zero.mpr hrne.symm).isUnit.map _
  exact (hQp i).ne_top (Ideal.eq_top_of_isUnit_mem _ h3 hunit)

theorem wcpa_dj_lr1k_ndgq_ff_fibre_count : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (S C : Scheme.{u}) [AlgebraicGeometry.IsIntegral S] [AlgebraicGeometry.IsIntegral C] (sS : S ⟶ Spec (.of Ω)) (γ : C ⟶ S), IsFinite γ → LocallyOfFiniteType (γ ≫ sS) → (∀ x : S, IsIntegrallyClosed (S.presheaf.stalk x)) → ∀ (hgen : γ (genericPoint C) = genericPoint S), letI : Algebra (S.presheaf.stalk (genericPoint S)) (C.presheaf.stalk (genericPoint C)) := (wcpaDjGslTr γ (genericPoint C) (genericPoint S) hgen).toAlgebra; FiniteDimensional (S.presheaf.stalk (genericPoint S)) (C.presheaf.stalk (genericPoint C)) → Algebra.IsSeparable (S.presheaf.stalk (genericPoint S)) (C.presheaf.stalk (genericPoint C)) → ∃ T : Finset C, T.card = Module.finrank (S.presheaf.stalk (genericPoint S)) (C.presheaf.stalk (genericPoint C)) ∧ ∀ c ∈ T, ∀ c' ∈ T, γ c = γ c' :=
by
  intro Ω _ _ S C _ _ sS γ hγf hlft hnorm hgen hFD hSep
  letI algKL : Algebra (S.presheaf.stalk (genericPoint S)) (C.presheaf.stalk (genericPoint C)) :=
    (wcpaDjGslTr γ (genericPoint C) (genericPoint S) hgen).toAlgebra
  classical
  haveI := hγf
  haveI := hlft
  obtain ⟨U, hU, hηU, -⟩ :=
    exists_isAffineOpen_mem_and_subset (x := genericPoint S) (U := ⊤) trivial
  have hV : IsAffineOpen (γ ⁻¹ᵁ U) := hU.preimage γ
  have hηV : genericPoint C ∈ γ ⁻¹ᵁ U := by
    show γ (genericPoint C) ∈ U
    rw [hgen]; exact hηU
  haveI hUne : Nonempty U := ⟨⟨_, hηU⟩⟩
  haveI hVne : Nonempty (γ ⁻¹ᵁ U) := ⟨⟨_, hηV⟩⟩

  letI algAB : Algebra Γ(S, U) Γ(C, γ ⁻¹ᵁ U) := (γ.app U).hom.toAlgebra
  haveI hfin : Module.Finite Γ(S, U) Γ(C, γ ⁻¹ᵁ U) := IsFinite.finite_app γ U hU

  letI algAK : Algebra Γ(S, U) (S.presheaf.stalk (genericPoint S)) :=
    (S.presheaf.germ U _ hηU).hom.toAlgebra
  letI algBL : Algebra Γ(C, γ ⁻¹ᵁ U) (C.presheaf.stalk (genericPoint C)) :=
    (C.presheaf.germ (γ ⁻¹ᵁ U) _ hηV).hom.toAlgebra
  haveI hfrA : IsFractionRing Γ(S, U) (S.presheaf.stalk (genericPoint S)) :=
    functionField_isFractionRing_of_isAffineOpen S U hU
  haveI hfrB : IsFractionRing Γ(C, γ ⁻¹ᵁ U) (C.presheaf.stalk (genericPoint C)) :=
    functionField_isFractionRing_of_isAffineOpen C (γ ⁻¹ᵁ U) hV

  letI algAL : Algebra Γ(S, U) (C.presheaf.stalk (genericPoint C)) :=
    ((algebraMap Γ(C, γ ⁻¹ᵁ U) (C.presheaf.stalk (genericPoint C))).comp
      (algebraMap Γ(S, U) Γ(C, γ ⁻¹ᵁ U))).toAlgebra
  haveI : IsScalarTower Γ(S, U) Γ(C, γ ⁻¹ᵁ U) (C.presheaf.stalk (genericPoint C)) :=
    IsScalarTower.of_algebraMap_eq' rfl
  have hgerm : (wcpaDjGslTr γ (genericPoint C) (genericPoint S) hgen).comp
      (S.presheaf.germ U _ hηU).hom =
      (C.presheaf.germ (γ ⁻¹ᵁ U) _ hηV).hom.comp (γ.app U).hom := by
    unfold wcpaDjGslTr
    rw [← CommRingCat.hom_comp, ← CommRingCat.hom_comp]
    congr 1
    rw [← Category.assoc, TopCat.Presheaf.germ_stalkSpecializes, Scheme.Hom.germ_stalkMap]
  haveI : IsScalarTower Γ(S, U) (S.presheaf.stalk (genericPoint S))
      (C.presheaf.stalk (genericPoint C)) :=
    IsScalarTower.of_algebraMap_eq' hgerm.symm

  have eU : U ≤ sS ⁻¹ᵁ ⊤ := by simp
  have eV : γ ⁻¹ᵁ U ≤ (γ ≫ sS) ⁻¹ᵁ ⊤ := by simp
  letI algΩA : Algebra Ω Γ(S, U) :=
    RingHom.toAlgebra ((Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫ sS.appLE ⊤ U eU).hom
  letI algΩB : Algebra Ω Γ(C, γ ⁻¹ᵁ U) :=
    RingHom.toAlgebra
      ((Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫ (γ ≫ sS).appLE ⊤ (γ ⁻¹ᵁ U) eV).hom
  haveI : IsScalarTower Ω Γ(S, U) Γ(C, γ ⁻¹ᵁ U) := by
    apply IsScalarTower.of_algebraMap_eq'
    show ((Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫ (γ ≫ sS).appLE ⊤ (γ ⁻¹ᵁ U) eV).hom =
      (γ.app U).hom.comp ((Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫ sS.appLE ⊤ U eU).hom
    rw [← CommRingCat.hom_comp]
    congr 1
    rw [Category.assoc, Scheme.Hom.app_eq_appLE, Scheme.Hom.appLE_comp_appLE]
  have hft : ((Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
      (γ ≫ sS).appLE ⊤ (γ ⁻¹ᵁ U) eV).hom.FiniteType := by
    rw [CommRingCat.hom_comp]
    refine RingHom.FiniteType.comp ?_ ?_
    · exact LocallyOfFiniteType.finiteType_appLE (γ ≫ sS) (isAffineOpen_top _) hV eV
    · apply RingHom.FiniteType.of_surjective
      intro x
      exact ⟨(Scheme.ΓSpecIso (CommRingCat.of Ω)).hom.hom x, by simp⟩
  haveI : Algebra.FiniteType Ω Γ(C, γ ⁻¹ᵁ U) := hft
  haveI : IsIntegrallyClosed Γ(S, U) := wc_fsus_affine_sections_intclosed S hnorm U hU hUne

  obtain ⟨Q, hQp, hQinj, hQc⟩ := wcpa_dj_lr1k_ndgq_ff_prime_count Ω Γ(S, U) Γ(C, γ ⁻¹ᵁ U)
    (S.presheaf.stalk (genericPoint S)) (C.presheaf.stalk (genericPoint C))

  let c : Fin (Module.finrank (S.presheaf.stalk (genericPoint S))
      (C.presheaf.stalk (genericPoint C))) → C := fun i => hV.fromSpec ⟨Q i, hQp i⟩
  have hcinj : Function.Injective c := by
    intro i j hij
    apply hQinj
    have h1 := (Scheme.Hom.isOpenEmbedding hV.fromSpec).injective hij
    exact congrArg PrimeSpectrum.asIdeal h1
  have himg : ∀ q, γ (hV.fromSpec q) = hU.fromSpec (PrimeSpectrum.comap (γ.app U).hom q) := by
    intro q
    have h := IsAffineOpen.SpecMap_appLE_fromSpec γ hU hV (le_refl _)
    calc γ (hV.fromSpec q) = (hV.fromSpec ≫ γ) q := by rw [Scheme.Hom.comp_apply]
      _ = (Spec.map (γ.appLE U _ (le_refl _)) ≫ hU.fromSpec) q := by rw [h]
      _ = hU.fromSpec (Spec.map (γ.appLE U _ (le_refl _)) q) := by rw [Scheme.Hom.comp_apply]
      _ = _ := by rw [Spec.map_apply, Scheme.Hom.app_eq_appLE]
  refine ⟨Finset.univ.image c, ?_, ?_⟩
  · rw [Finset.card_image_of_injective _ hcinj, Finset.card_univ, Fintype.card_fin]
  · intro x hx x' hx'
    obtain ⟨i, -, rfl⟩ := Finset.mem_image.mp hx
    obtain ⟨j, -, rfl⟩ := Finset.mem_image.mp hx'
    refine (himg ⟨Q i, hQp i⟩).trans (Eq.trans ?_ (himg ⟨Q j, hQp j⟩).symm)
    congr 1
    apply PrimeSpectrum.ext
    exact hQc i j

theorem wcpa_dj_lr1k_ndgq_fixed_field : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (Ct C : Scheme.{u}) (φ : Ct ⟶ wcProjK Ω 1) (π : C ⟶ Ct), wcpaDjLkCov Ω φ →
    wcpaDjLkCov Ω (π ≫ φ) → wcpaDjLkGalois (π ≫ φ) → IsFinite π → Surjective π →
    ∀ [IrreducibleSpace C] [IrreducibleSpace Ct] (hπ : π (genericPoint C) = genericPoint Ct)
      (x : ↥(C.presheaf.stalk (genericPoint C))),
      (∀ (a : C ≅ C) (ha : a.hom (genericPoint C) = genericPoint C), a.hom ≫ π = π →
        wcpaDjGslTr a.hom (genericPoint C) (genericPoint C) ha x = x) →
      ∃ z : ↥(Ct.presheaf.stalk (genericPoint Ct)),
        wcpaDjGslTr π (genericPoint C) (genericPoint Ct) hπ z = x :=
by
  intro Ω _ _ Ct C φ π hcov hcovC hgal hπf hπs _ _ hπ x hx
  classical

  have s1 : ∀ {X Y Z : Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ Z) (x : X) (y : Y) (z : Z)
      (hxy : f x = y) (hyz : g y = z) (hxz : (f ≫ g) x = z),
      wcpaDjGslTr (f ≫ g) x z hxz = (wcpaDjGslTr f x y hxy).comp (wcpaDjGslTr g y z hyz) := by
    intro X Y Z f g x y z hxy hyz hxz
    subst hxy hyz
    simp only [wcpaDjGslTr, TopCat.Presheaf.stalkSpecializes_refl, Category.id_comp,
      Scheme.Hom.stalkMap_comp]
    erw [TopCat.Presheaf.stalkSpecializes_refl, Category.id_comp]
    rfl
  have gcongr' : ∀ {X Y : Scheme.{u}} (f g : X ⟶ Y), f = g → ∀ (x : X) (y : Y)
      (hf : f x = y) (hg : g x = y), wcpaDjGslTr f x y hf = wcpaDjGslTr g x y hg := by
    intro X Y f g hfg x y hf hg
    subst hfg
    rfl


  have s2 : ∀ (C Y Z : Scheme.{u}) [AlgebraicGeometry.IsReduced C] [IrreducibleSpace C]
      (f g : C ⟶ Y) (s : Y ⟶ Z) [IsSeparated s] (y : Y) (hf : f (genericPoint C) = y)
      (hg : g (genericPoint C) = y), f ≫ s = g ≫ s →
      wcpaDjGslTr f (genericPoint C) y hf = wcpaDjGslTr g (genericPoint C) y hg → f = g := by
    intro C Y Z _ _ f g s _ y hf hg hs he
    have star : ∀ (h : C ⟶ Y) (hh : h (genericPoint C) = y),
        Spec.map (CommRingCat.ofHom (wcpaDjGslTr h (genericPoint C) y hh)) ≫ Y.fromSpecStalk y =
          C.fromSpecStalk (genericPoint C) ≫ h := by
      intro h hh
      simp only [wcpaDjGslTr, CommRingCat.ofHom_hom, Spec.map_comp, Category.assoc,
        Scheme.SpecMap_stalkSpecializes_fromSpecStalk, Scheme.SpecMap_stalkMap_fromSpecStalk]
    haveI hdom : IsDominant (C.fromSpecStalk (genericPoint C)) := by
      rw [isDominant_iff]
      apply Dense.mono (s₁ := {genericPoint C})
      · rintro _ rfl
        exact ⟨IsLocalRing.closedPoint _, Scheme.fromSpecStalk_closedPoint⟩
      · rw [dense_iff_closure_eq]
        exact genericPoint_spec C
    refine ext_of_isDominant_of_isSeparated s hs (C.fromSpecStalk (genericPoint C)) ?_
    rw [← star f hf, ← star g hg, he]

  have s5 : ∀ (K F L : Type u) [Field K] [Field F] [Field L] [Algebra K F] [Algebra F L]
      [Algebra K L] [IsScalarTower K F L] [FiniteDimensional K L]
      (σ : Fin (Module.finrank K L) → (L ≃ₐ[K] L)), Function.Injective σ → ∀ x : L,
      (∀ i, (∀ y : F, σ i (algebraMap F L y) = algebraMap F L y) → σ i x = x) →
      ∃ z : F, algebraMap F L z = x := by
    intro K F L _ _ _ _ _ _ _ _ σ hσ x hx
    have h1 : Fintype.card (L ≃ₐ[K] L) ≤ Module.finrank K L := AlgEquiv.card_le
    have h2 : Module.finrank K L ≤ Fintype.card (L ≃ₐ[K] L) := by
      simpa using Fintype.card_le_of_injective σ hσ
    have hcard : Fintype.card (Fin (Module.finrank K L)) = Fintype.card (L ≃ₐ[K] L) := by
      simp only [Fintype.card_fin]; omega
    have hbij : Function.Bijective σ :=
      (Fintype.bijective_iff_injective_and_card σ).mpr ⟨hσ, hcard⟩
    haveI : IsGalois K L := IsGalois.of_card_aut_eq_finrank K L (by
      rw [Nat.card_eq_fintype_card]; omega)
    haveI : IsGalois F L := IsGalois.tower_top_of_isGalois K F L
    haveI : FiniteDimensional F L := FiniteDimensional.right K F L
    have hfix : ∀ τ : L ≃ₐ[F] L, τ x = x := by
      intro τ
      obtain ⟨i, hi⟩ := hbij.2 (τ.restrictScalars K)
      have : σ i x = x := hx i (fun y => by rw [hi]; exact τ.commutes y)
      rw [hi] at this
      exact this
    have hmem : x ∈ (⊥ : IntermediateField F L) := (IsGalois.mem_bot_iff_fixed x).mpr hfix
    obtain ⟨z, hz⟩ := IntermediateField.mem_bot.mp hmem
    exact ⟨z, hz⟩

  have gpf : ∀ (X : Scheme.{u}) [IrreducibleSpace X] (z : X), z ⤳ genericPoint X →
      z = genericPoint X := fun X _ z hz => (hz.antisymm (genericPoint_specializes z)).eq

  unfold wcpaDjLkCov at hcov hcovC
  unfold wcpaDjLkGalois at hgal
  obtain ⟨_, hsmC, _, hγf, hgenC⟩ := hcovC
  obtain ⟨_, hsmCt, _, hφf, _⟩ := hcov
  haveI := hγf
  haveI := hφf
  haveI hstC : ∀ c : C, _root_.IsReduced (C.presheaf.stalk c) := fun c => by
    haveI := wcpa_smooth_stalk_isDomain Ω C ((π ≫ φ) ≫ wcProjKStr Ω 1) 1 c
    infer_instance
  haveI : IsReduced C := isReduced_of_isReduced_stalk C
  haveI : AlgebraicGeometry.IsIntegral C := isIntegral_of_irreducibleSpace_of_isReduced C
  haveI hstCt : ∀ c : Ct, _root_.IsReduced (Ct.presheaf.stalk c) := fun c => by
    haveI := wcpa_smooth_stalk_isDomain Ω Ct (φ ≫ wcProjKStr Ω 1) 1 c
    infer_instance
  haveI : IsReduced Ct := isReduced_of_isReduced_stalk Ct
  haveI : AlgebraicGeometry.IsIntegral Ct := isIntegral_of_irreducibleSpace_of_isReduced Ct
  obtain ⟨hPint, hPnorm, -, -⟩ := wc_projK_integral_normal Ω 1
  haveI := hPint

  obtain ⟨hspec, hFD, hSep⟩ :=
    wcpa_dj_lr1k_gc_function_field_separable (wcProjK Ω 1) C (π ≫ φ) hγf hgenC
  have hγ : (π ≫ φ) (genericPoint C) = genericPoint (wcProjK Ω 1) := gpf _ _ hspec
  have hφ : φ (genericPoint Ct) = genericPoint (wcProjK Ω 1) := by
    rw [← hπ]; exact hγ

  letI algKL : Algebra ↥((wcProjK Ω 1).presheaf.stalk (genericPoint (wcProjK Ω 1)))
      ↥(C.presheaf.stalk (genericPoint C)) :=
    (wcpaDjGslTr (π ≫ φ) (genericPoint C) (genericPoint (wcProjK Ω 1)) hγ).toAlgebra
  letI algKF : Algebra ↥((wcProjK Ω 1).presheaf.stalk (genericPoint (wcProjK Ω 1)))
      ↥(Ct.presheaf.stalk (genericPoint Ct)) :=
    (wcpaDjGslTr φ (genericPoint Ct) (genericPoint (wcProjK Ω 1)) hφ).toAlgebra
  letI algFL : Algebra ↥(Ct.presheaf.stalk (genericPoint Ct))
      ↥(C.presheaf.stalk (genericPoint C)) :=
    (wcpaDjGslTr π (genericPoint C) (genericPoint Ct) hπ).toAlgebra
  haveI hFD' : FiniteDimensional ↥((wcProjK Ω 1).presheaf.stalk (genericPoint (wcProjK Ω 1)))
      ↥(C.presheaf.stalk (genericPoint C)) := hFD
  haveI hSep' : Algebra.IsSeparable ↥((wcProjK Ω 1).presheaf.stalk (genericPoint (wcProjK Ω 1)))
      ↥(C.presheaf.stalk (genericPoint C)) := hSep
  haveI : IsScalarTower ↥((wcProjK Ω 1).presheaf.stalk (genericPoint (wcProjK Ω 1)))
      ↥(Ct.presheaf.stalk (genericPoint Ct)) ↥(C.presheaf.stalk (genericPoint C)) :=
    IsScalarTower.of_algebraMap_eq' (s1 π φ _ _ _ hπ hφ hγ)

  have hfixη : ∀ a : C ≅ C, a.hom (genericPoint C) = genericPoint C := by
    intro a
    apply gpf C
    have h1 := (genericPoint_specializes (a.inv (genericPoint C))).map a.hom.continuous
    have h2 : a.hom (a.inv (genericPoint C)) = genericPoint C := by
      rw [← Scheme.Hom.comp_apply, Iso.inv_hom_id]; rfl
    rwa [h2] at h1
  have hcomm : ∀ (a : C ≅ C), a.hom ≫ (π ≫ φ) = π ≫ φ →
      ∀ r : ↥((wcProjK Ω 1).presheaf.stalk (genericPoint (wcProjK Ω 1))),
      wcpaDjGslTr a.hom (genericPoint C) (genericPoint C) (hfixη a)
        (algebraMap _ ↥(C.presheaf.stalk (genericPoint C)) r) =
        algebraMap _ ↥(C.presheaf.stalk (genericPoint C)) r := by
    intro a ha' r
    have hxz : (a.hom ≫ (π ≫ φ)) (genericPoint C) = genericPoint (wcProjK Ω 1) := by
      rw [ha']; exact hγ
    have e1 := s1 a.hom (π ≫ φ) (genericPoint C) (genericPoint C) _ (hfixη a) hγ hxz
    have e2 := gcongr' _ _ ha' (genericPoint C) _ hxz hγ
    rw [e2] at e1
    exact (congrArg (fun f => f r) e1).symm
  let σA : {a : C ≅ C // a.hom ≫ (π ≫ φ) = π ≫ φ} →
      (↥(C.presheaf.stalk (genericPoint C)) ≃ₐ[↥((wcProjK Ω 1).presheaf.stalk
        (genericPoint (wcProjK Ω 1)))] ↥(C.presheaf.stalk (genericPoint C))) := fun a =>
    AlgEquiv.ofBijective
      { toRingHom := wcpaDjGslTr a.1.hom (genericPoint C) (genericPoint C) (hfixη a.1)
        commutes' := hcomm a.1 a.2 } (AlgHom.bijective _)

  have hlft : LocallyOfFiniteType ((π ≫ φ) ≫ wcProjKStr Ω 1) := by
    haveI := hsmC
    haveI : Smooth ((π ≫ φ) ≫ wcProjKStr Ω 1) := by
      first
        | exact SmoothOfRelativeDimension.smooth (n := 1) ((π ≫ φ) ≫ wcProjKStr Ω 1)
        | exact SmoothOfRelativeDimension.smooth 1 ((π ≫ φ) ≫ wcProjKStr Ω 1)
        | exact SmoothOfRelativeDimension.smooth (n := 1)
    infer_instance
  obtain ⟨T, hTcard, hTeq⟩ := wcpa_dj_lr1k_ndgq_ff_fibre_count Ω (wcProjK Ω 1) C
    (wcProjKStr Ω 1) (π ≫ φ) hγf hlft hPnorm hγ hFD' hSep'
  have hd : 0 < Module.finrank ↥((wcProjK Ω 1).presheaf.stalk (genericPoint (wcProjK Ω 1)))
      ↥(C.presheaf.stalk (genericPoint C)) := Module.finrank_pos

  let c : Fin (Module.finrank ↥((wcProjK Ω 1).presheaf.stalk (genericPoint (wcProjK Ω 1)))
      ↥(C.presheaf.stalk (genericPoint C))) → C := fun i =>
    (T.equivFin.symm (Fin.cast hTcard.symm i) : C)
  have hcT : ∀ i, c i ∈ T := fun i => (T.equivFin.symm (Fin.cast hTcard.symm i)).2
  have hex : ∀ i, ∃ a : C ≅ C, a.hom ≫ (π ≫ φ) = π ≫ φ ∧ a.hom (c ⟨0, hd⟩) = c i :=
    fun i => hgal _ _ (hTeq _ (hcT _) _ (hcT i))
  choose A hA1 hA2 using hex
  let σ := fun i => σA ⟨A i, hA1 i⟩

  have hσinj : Function.Injective σ := by
    intro i j hij
    have hring : wcpaDjGslTr (A i).hom (genericPoint C) (genericPoint C) (hfixη _) =
        wcpaDjGslTr (A j).hom (genericPoint C) (genericPoint C) (hfixη _) :=
      RingHom.ext fun t => congrArg (fun s => s t) hij
    have hAij : (A i).hom = (A j).hom :=
      s2 C C (wcProjK Ω 1) (A i).hom (A j).hom (π ≫ φ) (genericPoint C) _ _
        ((hA1 i).trans (hA1 j).symm) hring
    have hcij : c i = c j := by rw [← hA2 i, ← hA2 j, hAij]
    have h1 := T.equivFin.symm.injective (Subtype.coe_injective hcij)
    exact Fin.ext (by have := congrArg Fin.val h1; simpa using this)

  obtain ⟨z, hz⟩ := s5 _ _ _ σ hσinj x (by
    intro i hi

    have hxz : ((A i).hom ≫ π) (genericPoint C) = genericPoint Ct := by
      rw [Scheme.Hom.comp_apply, hfixη]; exact hπ
    have e1 := s1 (A i).hom π (genericPoint C) (genericPoint C) (genericPoint Ct) (hfixη _) hπ hxz
    have e2 : (wcpaDjGslTr (A i).hom (genericPoint C) (genericPoint C) (hfixη _)).comp
        (wcpaDjGslTr π (genericPoint C) (genericPoint Ct) hπ) =
        wcpaDjGslTr π (genericPoint C) (genericPoint Ct) hπ := RingHom.ext fun y => hi y
    have hAπ : (A i).hom ≫ π = π :=
      s2 C Ct (wcProjK Ω 1) ((A i).hom ≫ π) π φ (genericPoint Ct) hxz hπ
        (by rw [Category.assoc, hA1 i]) (e1.trans e2)

    exact hx (A i) (hfixη _) hAπ)
  exact ⟨z, hz⟩

theorem wcpa_dj_lr1k_ndgq_cm_aut_finite : ∀ (A B : Type u) [CommRing A] [CommRing B] [IsDomain B]
    (i : A →+* B), i.Finite → ∀ (H : Subgroup (B ≃+* B)), (∀ h ∈ H, ∀ a, h (i a) = i a) →
    Finite ↥H :=
by
  intro A B _ _ _ i hi H hfix
  classical
  letI : Algebra A B := i.toAlgebra
  haveI : Module.Finite A B := hi
  obtain ⟨n, s, hs⟩ := Module.Finite.exists_fin (R := A) (M := B)
  have hG : ∀ b : B, ∃ c : Fin n → A, b = ∑ j, i (c j) * s j := by
    intro b
    have hb : b ∈ Submodule.span A (Set.range s) := by rw [hs]; trivial
    obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun A).mp hb
    exact ⟨c, by rw [← hc]; rfl⟩
  have hint : i.IsIntegral := RingHom.IsIntegral.of_finite hi
  have hint' : ∀ j, ∃ q : Polynomial A, q.Monic ∧ q.eval₂ i (s j) = 0 := fun j => hint (s j)
  choose p hpm hpe using hint'
  have hroot : ∀ h ∈ H, ∀ j, ((p j).map i).IsRoot (h (s j)) := by
    intro h hh j
    have hc : (h : B →+* B).comp i = i := RingHom.ext fun a => hfix h hh a
    have e := Polynomial.hom_eval₂ (p j) i (h : B →+* B) (s j)
    rw [hpe j, map_zero, hc] at e
    rw [Polynomial.IsRoot, ← Polynomial.eval₂_eq_eval_map]
    exact e.symm
  let R : Fin n → Set B := fun j => {x | ((p j).map i).IsRoot x}
  have hR : ∀ j, (R j).Finite := fun j =>
    Polynomial.finite_setOfPred_isRoot ((hpm j).map i).ne_zero
  haveI : ∀ j, Finite ↥(R j) := fun j => (hR j).to_subtype
  let Φ : ↥H → ((j : Fin n) → ↥(R j)) := fun h j => ⟨h.1 (s j), hroot h.1 h.2 j⟩
  refine Finite.of_injective Φ ?_
  intro h h' hΦ
  have hs' : ∀ j, h.1 (s j) = h'.1 (s j) := fun j => congrArg Subtype.val (congrFun hΦ j)
  apply Subtype.ext
  apply RingEquiv.ext
  intro b
  obtain ⟨c, rfl⟩ := hG b
  simp only [map_sum, map_mul, hfix h.1 h.2, hfix h'.1 h'.2, hs']

theorem wcpa_dj_lr1k_ndgq_cm_descend_integral : ∀ (D R R' K K' : Type u) [CommRing D]
    [CommRing R] [IsDomain R] [IsIntegrallyClosed R] [CommRing R'] [CommRing K] [CommRing K']
    [Algebra R K] [IsFractionRing R K] (δ : D →+* R) (ρ : R →+* R') (κ : R' →+* K')
    (τ : K →+* K'), Function.Injective κ → Function.Injective τ →
    τ.comp (algebraMap R K) = κ.comp ρ → ∀ (b : R'), (ρ.comp δ).IsIntegralElem b →
    ∀ z : K, τ z = κ b → ∃ r : R, δ.IsIntegralElem r ∧ ρ r = b :=
by
  intro D R R' K K' _ _ _ _ _ _ _ _ _ δ ρ κ τ hκ hτ hsq b hb z hz
  obtain ⟨p, hpm, hpb⟩ := hb
  have h2 : τ (Polynomial.eval₂ ((algebraMap R K).comp δ) z p) = 0 := by
    rw [Polynomial.hom_eval₂, ← RingHom.comp_assoc, hsq, RingHom.comp_assoc, hz,
      ← Polynomial.hom_eval₂, hpb, map_zero]
  have hz0 : Polynomial.eval₂ ((algebraMap R K).comp δ) z p = 0 :=
    hτ (h2.trans (map_zero τ).symm)
  have hint : IsIntegral R z :=
    ⟨p.map δ, hpm.map δ, by rw [Polynomial.eval₂_map]; exact hz0⟩
  obtain ⟨r, hr⟩ := IsIntegrallyClosed.algebraMap_eq_of_integral hint
  refine ⟨r, ⟨p, hpm, ?_⟩, ?_⟩
  · apply IsFractionRing.injective R K
    rw [map_zero, Polynomial.hom_eval₂, hr]
    exact hz0
  · apply hκ
    rw [← RingHom.comp_apply κ ρ, ← hsq, RingHom.comp_apply, hr, hz]

theorem wcpa_dj_lr1k_ndgq_cm_norm_chart : ∀ {P X : Scheme.{u}} (f : P ⟶ X) [QuasiCompact f]
    [QuasiSeparated f] (B : Type u) [CommRing B] (uX : X ⟶ Spec (.of B)) (U : X.Opens)
    (hU : IsAffineOpen U),
    letI : Algebra Γ(X, U) Γ(P, f ⁻¹ᵁ U) := (f.app U).hom.toAlgebra
    ∃ Φ : PrimeSpectrum ↥(integralClosure Γ(X, U) Γ(P, f ⁻¹ᵁ U)) → ↥f.normalization,
      (∀ 𝔮, hU.fromSpec (PrimeSpectrum.comap
          (algebraMap Γ(X, U) ↥(integralClosure Γ(X, U) Γ(P, f ⁻¹ᵁ U))) 𝔮) =
        f.fromNormalization (Φ 𝔮)) ∧
      (∀ z : ↥f.normalization, f.fromNormalization z ∈ U → ∃ 𝔮, Φ 𝔮 = z) ∧
      (∀ 𝔮, IsClosed ({Φ 𝔮} : Set ↥f.normalization) → 𝔮.asIdeal.IsMaximal) ∧
      (∀ 𝔮, 𝔮.asIdeal.IsMaximal → IsClosed ({f.fromNormalization (Φ 𝔮)} : Set ↥X) →
        IsClosed ({Φ 𝔮} : Set ↥f.normalization)) ∧
      (∀ 𝔮 (z : ↥f.normalization), Φ 𝔮 = z →
        ∃ e : ↥(integralClosure Γ(X, U) Γ(P, f ⁻¹ᵁ U)) →+* ↥(f.normalization.presheaf.stalk z),
          @IsLocalization _ _ (@Ideal.primeCompl _ _ 𝔮.asIdeal 𝔮.isPrime) _ _ e.toAlgebra ∧
          ∀ c : B, e (algebraMap Γ(X, U) _ (wcCnSigma uX U c)) =
            wcNdSig (f.fromNormalization ≫ uX) z c) :=
by
  intro P X f _ _ B _ uX U hU
  letI : Algebra Γ(X, U) Γ(P, f ⁻¹ᵁ U) := (f.app U).hom.toAlgebra
  have hUN : IsAffineOpen (f.fromNormalization ⁻¹ᵁ U) := hU.preimage f.fromNormalization
  let e := Scheme.Hom.normalizationObjIso f hU
  let a : Γ(f.normalization, f.fromNormalization ⁻¹ᵁ U) →+*
      ↥(integralClosure Γ(X, U) Γ(P, f ⁻¹ᵁ U)) := e.hom.hom
  let b : ↥(integralClosure Γ(X, U) Γ(P, f ⁻¹ᵁ U)) →+*
      Γ(f.normalization, f.fromNormalization ⁻¹ᵁ U) := e.inv.hom
  have hba : ∀ r, b (a r) = r := fun r => CommRingCat.inv_hom_apply e r
  have hab : ∀ s, a (b s) = s := fun s => CommRingCat.hom_inv_apply e s
  have FA : ∀ y, (f.fromNormalization.app U).hom y =
      b (algebraMap Γ(X, U) ↥(integralClosure Γ(X, U) Γ(P, f ⁻¹ᵁ U)) y) := by
    intro y
    rw [Scheme.Hom.fromNormalization_app f hU]
    rfl
  have hmemF : ∀ P0 : ↥(Spec Γ(f.normalization, f.fromNormalization ⁻¹ᵁ U)),
      hUN.fromSpec P0 ∈ f.fromNormalization ⁻¹ᵁ U := by
    intro P0
    rw [← SetLike.mem_coe, ← hUN.range_fromSpec]
