  have hzmp := Algebra.ZariskisMainProperty.of_finiteType (R := MvPolynomial (Fin s) ↥W) 𝔫
  obtain ⟨r, hr𝔫, hrint, hrx⟩ := Algebra.zariskisMainProperty_iff.mp hzmp

  have hinjB : Function.Injective (algebraMap (MvPolynomial (Fin s) ↥W)
      ↥(integralClosure (MvPolynomial (Fin s) ↥W) R)) := by
    intro a b hab
