      rw [← map_mul, hc]
      simp
    · rintro ⟨c, rfl⟩
      rw [map_mul]
      have h0 : (wcLldfEv R t).appTop.hom
          ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) R))).inv.hom
