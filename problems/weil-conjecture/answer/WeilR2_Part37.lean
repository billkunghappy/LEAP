  obtain ⟨σ₁U, hσ₁U⟩ : ∃ σ₁U : Spec (.of ↥W) ⟶ U.toScheme, σ₁U ≫ U.ι = σ'' ≫ r :=
    ⟨IsOpenImmersion.lift U.ι (σ'' ≫ r) hrange1, IsOpenImmersion.lift_fac _ _ _⟩

  obtain ⟨m, hm, hmq, hmP, hmpt, hmsec⟩ := chart_morphism ↥W X uX V hV hle g' hg' hg'C U hUV
  have hmq' : m ≫ wcLldfPiA ↥W = U.ι ≫ uX := by
    have hPi : wcLldfPiA ↥W =
        Spec.map (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W)) := by
      show Spec.map (CommRingCat.ofHom (algebraMap ↥W (MvPolynomial (Fin 1) ↥W))) = _
      rw [MvPolynomial.algebraMap_eq]
    rw [hPi]; exact hmq
  have hσUm : σU ≫ m = wcLldfEv ↥W 0 := by
    rw [hmsec σ σU eσ hσ hσU, hθ0]
  have hσ₁Um : σ₁U ≫ m = wcLldfEv ↥W (a * c) := by
    rw [hmsec (σ'' ≫ r) σ₁U e₁ hσ₁ hσ₁U, hθ1]

  have hK0 := K₀ (r₁ * h) U hUV hUdef σU hσU
  simp only [map_zero, sub_zero] at hK0
  rw [← hmP (MvPolynomial.X 0)] at hK0
  have hK1 := K₁ (r₀ * h) U hUV hU1 σ₁U hσ₁U
  rw [← map_sub, ← hmP] at hK1

  have hσUpt : (σU (IsLocalRing.closedPoint ↥W)).1 = σ (IsLocalRing.closedPoint ↥W) := by
    have h1 : (σU ≫ U.ι) (IsLocalRing.closedPoint ↥W) = σ (IsLocalRing.closedPoint ↥W) := by
      rw [hσU]
    exact (Scheme.Opens.ι_apply U _).symm.trans
      ((Scheme.Hom.comp_apply σU U.ι _).symm.trans h1)
  have clause10 : ∀ p : ↥U.toScheme, m p = m (σU (IsLocalRing.closedPoint ↥W)) →
      p = σU (IsLocalRing.closedPoint ↥W) := by
    intro p hp
    rw [hmpt, hmpt] at hp
    apply Subtype.ext
    rw [hσUpt]
    have hph : p.1 ∈ X.basicOpen h := hUh p.2
    have hq : hV.primeIdealOf ⟨(σU (IsLocalRing.closedPoint ↥W)).1,
        hUV (σU (IsLocalRing.closedPoint ↥W)).2⟩ =
        hV.primeIdealOf ⟨σ (IsLocalRing.closedPoint ↥W), hxV⟩ := by
      congr 1
      exact Subtype.ext hσUpt
    rw [hq] at hp
    exact hIso p.1 (hUV p.2) hph hp
  exact ⟨U, m, σU, σ₁U, c, hUaff, hm, hmq', hσU, hσ₁U, hσUm, hσ₁Um, hK0, hK1, clause10⟩

theorem wcpa_dj_lr1k_lldf_std_model (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (e b : ↥W)
    (hb : b ≠ 0) (B : Scheme.{u}) (r : B ⟶ wcLldfA ↥W)
    (hr : wcCsdIsBlowup ((wcLldfEv ↥W e).ker ⊔
      wcNcPrincipal (.of ↥W) (wcLldfA ↥W) (wcLldfPiA ↥W) b) r) :
    ∃ (j : wcLldfA ↥W ⟶ B) (k : Spec (.of (wcNcRing W b)) ⟶ B),
      IsOpenImmersion j ∧ IsOpenImmersion k ∧
      j ≫ r = Spec.map (CommRingCat.ofHom (wcLldmLam W e b)) ∧
      k ≫ r = Spec.map (CommRingCat.ofHom (wcLldmH W e b)) ∧
      (∀ p : ↥B, p ∈ Set.range ⇑j ∨ p ∈ Set.range ⇑k) ∧
      ∀ y : ↥(Spec (.of (wcNcRing W b))),
        Ideal.Quotient.mk (wcNcIdeal W b) (MvPolynomial.X 1) ∉ y.asIdeal → k y ∈ Set.range ⇑j :=
by
  classical

  have hinvhom : ∀ (R : CommRingCat.{u}) (x : R),
      (Scheme.ΓSpecIso R).hom.hom ((Scheme.ΓSpecIso R).inv.hom x) = x := by
    intro R x
    have := congrArg (fun g => g.hom x) (Scheme.ΓSpecIso R).inv_hom_id
    simpa only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_id,
      RingHom.id_apply] using this
  have hhominv : ∀ (R : CommRingCat.{u}) (x : Γ(Spec R, ⊤)),
      (Scheme.ΓSpecIso R).inv.hom ((Scheme.ΓSpecIso R).hom.hom x) = x := by
    intro R x
    have := congrArg (fun g => g.hom x) (Scheme.ΓSpecIso R).hom_inv_id
    simpa only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_id,
      RingHom.id_apply] using this
  have key : ∀ (S : Type u) [CommRing S] (f : MvPolynomial (Fin 1) ↥W →+* S)
      (z : MvPolynomial (Fin 1) ↥W),
      (Spec.map (CommRingCat.ofHom f)).appTop.hom
        ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom z) =
      (Scheme.ΓSpecIso (.of S)).inv.hom (f z) := by
    intro S _ f z
    have e2 := congrArg (fun φ => CommRingCat.Hom.hom φ z)
      (Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom f))
    simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at e2
    exact e2.symm
  have happTop : ∀ {T X : Scheme.{u}} (f : T ⟶ X) (e : (⊤ : T.Opens) ≤ f ⁻¹ᵁ ⊤) (z : Γ(X, ⊤)),
      (f.appLE ⊤ ⊤ e).hom z = f.appTop.hom z := by
    intro T X f e z
    exact congrArg (fun φ => CommRingCat.Hom.hom φ z) (Scheme.Hom.appLE_eq_app f (U := ⊤))

  have hQ : ∀ p : MvPolynomial (Fin 1) ↥W,
      p - MvPolynomial.C (MvPolynomial.eval (fun _ : Fin 1 => e) p) ∈
        Ideal.span {MvPolynomial.X 0 - MvPolynomial.C e} := by
    intro p
    induction p using MvPolynomial.induction_on with
    | C a => simp
    | add p q hp hq =>
      have h : p + q - MvPolynomial.C (MvPolynomial.eval (fun _ : Fin 1 => e) (p + q)) =
          (p - MvPolynomial.C (MvPolynomial.eval (fun _ : Fin 1 => e) p)) +
          (q - MvPolynomial.C (MvPolynomial.eval (fun _ : Fin 1 => e) q)) := by
        rw [map_add, map_add]; ring
      rw [h]
      exact Ideal.add_mem _ hp hq
    | mul_X p n hp =>
      have hn : n = 0 := Subsingleton.elim n 0
      subst hn
      have h : p * MvPolynomial.X 0 -
          MvPolynomial.C (MvPolynomial.eval (fun _ : Fin 1 => e) (p * MvPolynomial.X 0)) =
          (p - MvPolynomial.C (MvPolynomial.eval (fun _ : Fin 1 => e) p)) * MvPolynomial.X 0 +
          MvPolynomial.C (MvPolynomial.eval (fun _ : Fin 1 => e) p) *
            (MvPolynomial.X 0 - MvPolynomial.C e) := by
        rw [map_mul, MvPolynomial.eval_X, map_mul]; ring
      rw [h]
      exact Ideal.add_mem _ (Ideal.mul_mem_right _ _ hp)
        (Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _))
  have hkerE : RingHom.ker (MvPolynomial.eval (fun _ : Fin 1 => e)) =
      Ideal.span {MvPolynomial.X 0 - MvPolynomial.C e} := by
    ext p
    rw [RingHom.mem_ker]
    constructor
    · intro h
      have h1 := hQ p
      rwa [h, MvPolynomial.C_0, sub_zero] at h1
    · intro h
      obtain ⟨q, rfl⟩ := Ideal.mem_span_singleton'.mp h
      simp
  have hkerSpec : ∀ (A B : Type u) [CommRing A] [CommRing B] (f : A →+* B) (a : A),
      RingHom.ker f = Ideal.span {a} →
      Scheme.Hom.ker (Spec.map (CommRingCat.ofHom f)) =
        Scheme.IdealSheafData.ofIdealTop (Ideal.span {(Scheme.ΓSpecIso (.of A)).inv.hom a}) := by
    intro A B _ _ f a hf
    rw [Scheme.ker_of_isAffine]
    congr 1
    ext x
    have nat := congrArg (fun g => g.hom x) (Scheme.ΓSpecIso_naturality (CommRingCat.ofHom f))
    simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at nat
    rw [RingHom.mem_ker, Ideal.mem_span_singleton']
    constructor
    · intro hx
      have h1 : f ((Scheme.ΓSpecIso (.of A)).hom.hom x) = 0 := by rw [← nat, hx, map_zero]
      rw [← RingHom.mem_ker, hf, Ideal.mem_span_singleton'] at h1
      obtain ⟨y, hy⟩ := h1
      refine ⟨(Scheme.ΓSpecIso (.of A)).inv.hom y, ?_⟩
      rw [← map_mul, hy, hhominv]
    · rintro ⟨y, rfl⟩
      have hfa : f a = 0 := by
        rw [← RingHom.mem_ker, hf]; exact Ideal.mem_span_singleton_self a
      have h1 : (Scheme.ΓSpecIso (.of B)).hom.hom ((Spec.map (CommRingCat.ofHom f)).appTop.hom
          (y * (Scheme.ΓSpecIso (.of A)).inv.hom a)) = 0 := by
        rw [nat, map_mul, map_mul, hinvhom, hfa, mul_zero]
      have h2 := congrArg (Scheme.ΓSpecIso (.of B)).inv.hom h1
      rwa [hhominv, map_zero] at h2
  have hprinc : wcNcPrincipal (.of ↥W) (wcLldfA ↥W) (wcLldfPiA ↥W) b =
      Scheme.IdealSheafData.ofIdealTop (Ideal.span
        {(Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.C b)}) := by
    unfold wcNcPrincipal
    have h1 := congrArg (fun g => g.hom b) (Scheme.ΓSpecIso_inv_naturality
      (CommRingCat.ofHom (algebraMap ↥W (MvPolynomial (Fin 1) ↥W))))
    simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at h1
    exact congrArg (fun z => Scheme.IdealSheafData.ofIdealTop (Ideal.span {z})) h1.symm
  have hsup : ∀ (X : Scheme.{u}) (I J : Ideal Γ(X, ⊤)),
      Scheme.IdealSheafData.ofIdealTop I ⊔ Scheme.IdealSheafData.ofIdealTop J =
        Scheme.IdealSheafData.ofIdealTop (I ⊔ J) := by
    intro X I J
    apply Scheme.IdealSheafData.ext
    rw [Scheme.IdealSheafData.ideal_sup]
    funext V
    rw [Pi.sup_apply, Scheme.IdealSheafData.ofIdealTop_ideal,
      Scheme.IdealSheafData.ofIdealTop_ideal, Scheme.IdealSheafData.ofIdealTop_ideal,
      Ideal.map_sup]
  have hJ : (wcLldfEv ↥W e).ker ⊔ wcNcPrincipal (.of ↥W) (wcLldfA ↥W) (wcLldfPiA ↥W) b =
      Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range
        ![(Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom
            (MvPolynomial.X 0 - MvPolynomial.C e),
          (Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.C b)])) := by
    have hk : (wcLldfEv ↥W e).ker = Scheme.IdealSheafData.ofIdealTop (Ideal.span
        {(Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom
          (MvPolynomial.X 0 - MvPolynomial.C e)}) :=
      hkerSpec (MvPolynomial (Fin 1) ↥W) ↥W _ _ hkerE
    rw [hk, hprinc, hsup]
    congr 1
    rw [Matrix.range_cons, Matrix.range_cons, Matrix.range_empty, Set.union_empty,
      Set.singleton_union, Ideal.span_insert]
  rw [hJ] at hr

  obtain ⟨U, t, hU⟩ := wc_bp_blowup_charts _ r hr
  have H3 := hU.2.2.1
  have H4 := hU.2.2.2.1
  have H6 := hU.2.2.2.2.2
  have hsplit : (MvPolynomial.X 0 : MvPolynomial (Fin 1) ↥W) =
      (MvPolynomial.X 0 - MvPolynomial.C e) + MvPolynomial.C e := by ring
  have hsplitU : ∀ (V : B.Opens) (hV : V ≤ r ⁻¹ᵁ ⊤),
      (r.appLE ⊤ V hV).hom ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom
        (MvPolynomial.X 0)) =
      (r.appLE ⊤ V hV).hom ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom
        (MvPolynomial.X 0 - MvPolynomial.C e)) +
      (r.appLE ⊤ V hV).hom ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom
        (MvPolynomial.C e)) := by
    intro V hV
    conv_lhs => rw [hsplit]
    rw [map_add, map_add]
  have hsplit1 := hsplitU (U 1) (by simp)
  have hsplit0 := hsplitU (U 0) (by simp)

  have hΛC : ∀ w : ↥W, wcLldmLam W e b (MvPolynomial.C w) = MvPolynomial.C w := by
    intro w; simp [wcLldmLam]
  have hΛX : wcLldmLam W e b (MvPolynomial.X 0) =
      MvPolynomial.C e + MvPolynomial.C b * MvPolynomial.X 0 := by
    simp [wcLldmLam]
  have hΛg0 : wcLldmLam W e b (MvPolynomial.X 0 - MvPolynomial.C e) =
      MvPolynomial.C b * MvPolynomial.X 0 := by
    rw [map_sub, hΛX, hΛC]; ring
  have hγne : (Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.C b) ≠ 0 := by
    intro h0
    apply hb
    have := congrArg (Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).hom.hom h0
    rw [hinvhom, map_zero] at this
    exact MvPolynomial.C_injective (Fin 1) ↥W (by rw [this, map_zero])
  have ht11 : t 1 1 = 1 := by
    have h311 : (r.appLE ⊤ (U 1) (by simp)).hom
        ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.C b)) =
        t 1 1 * (r.appLE ⊤ (U 1) (by simp)).hom
          ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.C b)) :=
      H3 1 1
    have h4 : (r.appLE ⊤ (U 1) (by simp)).hom
        ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.C b)) ∈
        nonZeroDivisors Γ(B, U 1) := H4 1
    have h5 : (t 1 1 - 1) * (r.appLE ⊤ (U 1) (by simp)).hom
        ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.C b)) = 0 := by
      rw [sub_mul, one_mul, ← h311, sub_self]
    exact sub_eq_zero.mp ((mul_right_mem_nonZeroDivisors_eq_zero_iff h4).mp h5)
  have h310 : (r.appLE ⊤ (U 1) (by simp)).hom
      ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom
        (MvPolynomial.X 0 - MvPolynomial.C e)) =
      t 1 0 * (r.appLE ⊤ (U 1) (by simp)).hom
        ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.C b)) :=
    H3 1 0
  have hΦΛ : (MvPolynomial.eval₂Hom ((r.appLE ⊤ (U 1) (by simp)).hom.comp
      ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom.comp MvPolynomial.C))
      (fun _ => t 1 0)).comp (wcLldmLam W e b) =
      (r.appLE ⊤ (U 1) (by simp)).hom.comp
        (Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom := by
    apply MvPolynomial.ringHom_ext
    · intro w
      rw [RingHom.comp_apply, RingHom.comp_apply, hΛC, MvPolynomial.eval₂Hom_C]
      rfl
    · intro i
      obtain rfl := Fin.fin_one_eq_zero i
      rw [RingHom.comp_apply, RingHom.comp_apply, hΛX, map_add, map_mul, MvPolynomial.eval₂Hom_C,
        MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_X']
      simp only [RingHom.comp_apply]
      rw [hsplit1, h310]
      ring
  obtain ⟨c₁, hc₁r, hc₁o, hc₁range⟩ := wcpa_dj_ncmb_chart_open_imm _ r U t hr hU 1 _
    (Spec.map (CommRingCat.ofHom (wcLldmLam W e b)))
    ![(Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.X 0), 1]
    (by
      intro j
      fin_cases j
      · show (Spec.map (CommRingCat.ofHom (wcLldmLam W e b))).appTop.hom
            ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom
              (MvPolynomial.X 0 - MvPolynomial.C e)) =
          (Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.X 0) *
            (Spec.map (CommRingCat.ofHom (wcLldmLam W e b))).appTop.hom
              ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.C b))
        rw [key, key, hΛg0, hΛC, map_mul, mul_comm]
      · show (Spec.map (CommRingCat.ofHom (wcLldmLam W e b))).appTop.hom
            ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.C b)) =
          1 * (Spec.map (CommRingCat.ofHom (wcLldmLam W e b))).appTop.hom
              ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.C b))
        rw [one_mul])
    (by
      show (Spec.map (CommRingCat.ofHom (wcLldmLam W e b))).appTop.hom
        ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.C b)) ∈ _
      rw [key, hΛC]
      exact mem_nonZeroDivisors_of_ne_zero hγne)
    (by
      intro s
      obtain ⟨p, rfl⟩ : ∃ p, (Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom p = s :=
        ⟨_, hhominv _ s⟩
      induction p using MvPolynomial.induction_on with
      | C w =>
        apply Subring.subset_closure
        left
        exact ⟨(Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.C w),
          by rw [key, hΛC]⟩
      | add p q hp hq =>
        rw [map_add]
        exact Subring.add_mem _ hp hq
      | mul_X p n hp =>
        obtain rfl := Fin.fin_one_eq_zero n
        rw [map_mul]
        exact Subring.mul_mem _ hp (Subring.subset_closure (Or.inr ⟨0, rfl⟩)))
    (by
      refine ⟨(MvPolynomial.eval₂Hom ((r.appLE ⊤ (U 1) (by simp)).hom.comp
        ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom.comp MvPolynomial.C))
        (fun _ => t 1 0)).comp (Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).hom.hom, ?_, ?_⟩
      · apply RingHom.ext
        intro x
        obtain ⟨p, rfl⟩ : ∃ p, (Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom p = x :=
          ⟨_, hhominv _ x⟩
        rw [RingHom.comp_apply, RingHom.comp_apply, key, hinvhom]
        exact RingHom.congr_fun hΦΛ p
      · intro j
        fin_cases j
        · show (MvPolynomial.eval₂Hom ((r.appLE ⊤ (U 1) (by simp)).hom.comp
            ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom.comp MvPolynomial.C))
            (fun _ => t 1 0)) ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).hom.hom
              ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.X 0))) =
              t 1 0
          rw [hinvhom, MvPolynomial.eval₂Hom_X']
        · show (MvPolynomial.eval₂Hom ((r.appLE ⊤ (U 1) (by simp)).hom.comp
            ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom.comp MvPolynomial.C))
            (fun _ => t 1 0)) ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).hom.hom 1) =
              t 1 1
          rw [map_one, map_one, ht11])

  let HH : CommRingCat.of (MvPolynomial (Fin 1) ↥W) ⟶ CommRingCat.of (wcNcRing W b) :=
    CommRingCat.ofHom (wcLldmH W e b)
  let hS : Spec (.of (wcNcRing W b)) ⟶ Spec (.of (MvPolynomial (Fin 1) ↥W)) := Spec.map HH
  have hHH : ∀ z, HH.hom z = wcLldmH W e b z := fun z => rfl
  have hHC : ∀ w : ↥W, wcLldmH W e b (MvPolynomial.C w) =
      Ideal.Quotient.mk (wcNcIdeal W b) (MvPolynomial.C w) := by
    intro w; simp [wcLldmH]
  have hHX0 : wcLldmH W e b (MvPolynomial.X 0) =
      Ideal.Quotient.mk (wcNcIdeal W b) (MvPolynomial.X 0) +
        Ideal.Quotient.mk (wcNcIdeal W b) (MvPolynomial.C e) := by
    simp [wcLldmH]
  have hHg0 : wcLldmH W e b (MvPolynomial.X 0 - MvPolynomial.C e) =
      Ideal.Quotient.mk (wcNcIdeal W b) (MvPolynomial.X 0) := by
    rw [map_sub, hHX0, hHC]; ring
  have hAB : Ideal.Quotient.mk (wcNcIdeal W b) (MvPolynomial.X 0) *
      Ideal.Quotient.mk (wcNcIdeal W b) (MvPolynomial.X 1) =
      Ideal.Quotient.mk (wcNcIdeal W b) (MvPolynomial.C b) := by
    rw [← map_mul, Ideal.Quotient.eq]
    exact Ideal.subset_span rfl
  have e2 : (Ideal.Quotient.mk (wcNcIdeal W b) (MvPolynomial.C b) : wcNcRing W b) =
      Ideal.Quotient.mk (wcNcIdeal W b) (MvPolynomial.X 1) *
        Ideal.Quotient.mk (wcNcIdeal W b) (MvPolynomial.X 0) := by
    rw [← hAB]; ring
  have hnatQ : ∀ z, hS.appTop.hom
      ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom z) =
      (Scheme.ΓSpecIso (.of (wcNcRing W b))).inv.hom (wcLldmH W e b z) := by
    intro z
    have e3 := congrArg (fun φ => CommRingCat.Hom.hom φ z) (Scheme.ΓSpecIso_inv_naturality HH)
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at e3
    rw [← hHH z]
    exact e3.symm
  have hmemC : ∀ w : ↥W, (Scheme.ΓSpecIso (.of (wcNcRing W b))).inv.hom
      (Ideal.Quotient.mk (wcNcIdeal W b) (MvPolynomial.C w)) ∈ Set.range hS.appTop.hom := by
    intro w
    refine ⟨(Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.C w), ?_⟩
    rw [hnatQ, hHC]
  have hmemX0 : (Scheme.ΓSpecIso (.of (wcNcRing W b))).inv.hom
      (Ideal.Quotient.mk (wcNcIdeal W b) (MvPolynomial.X 0)) ∈ Set.range hS.appTop.hom := by
    refine ⟨(Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom
      (MvPolynomial.X 0 - MvPolynomial.C e), ?_⟩
    rw [hnatQ, hHg0]
  have hAnzd : ∀ y : wcNcRing W b,
      y * Ideal.Quotient.mk (wcNcIdeal W b) (MvPolynomial.X 0) = 0 → y = 0 := by
    intro y hy
    obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective y
    rw [← map_mul, Ideal.Quotient.eq_zero_iff_mem] at hy
    obtain ⟨g, hg⟩ := Ideal.mem_span_singleton'.mp hy
    obtain ⟨σ₀, hσ0, hσ1, hσC⟩ : ∃ σ₀ : MvPolynomial (Fin 2) ↥W →+* MvPolynomial (Fin 2) ↥W,
        σ₀ (MvPolynomial.X 0) = 0 ∧ σ₀ (MvPolynomial.X 1) = MvPolynomial.X 1 ∧
        ∀ r, σ₀ (MvPolynomial.C r) = MvPolynomial.C r :=
      ⟨MvPolynomial.eval₂Hom MvPolynomial.C ![0, MvPolynomial.X 1], by simp, by simp, by simp⟩
    have hdvd : ∀ f : MvPolynomial (Fin 2) ↥W, MvPolynomial.X 0 ∣ f - σ₀ f := by
      intro f
      induction f using MvPolynomial.induction_on with
      | C r => rw [hσC, sub_self]; exact dvd_zero _
      | add f g hf hg => rw [map_add, add_sub_add_comm]; exact dvd_add hf hg
      | mul_X f n hf =>
        rw [map_mul]
        have e : f * MvPolynomial.X n - σ₀ f * σ₀ (MvPolynomial.X n) =
            (f - σ₀ f) * MvPolynomial.X n + σ₀ f * (MvPolynomial.X n - σ₀ (MvPolynomial.X n)) := by
          ring
        rw [e]
        refine dvd_add (dvd_mul_of_dvd_left hf _) (dvd_mul_of_dvd_right ?_ _)
        fin_cases n
        · show MvPolynomial.X 0 ∣ MvPolynomial.X 0 - σ₀ (MvPolynomial.X 0)
          rw [hσ0, sub_zero]
        · show MvPolynomial.X 0 ∣ MvPolynomial.X 1 - σ₀ (MvPolynomial.X 1)
