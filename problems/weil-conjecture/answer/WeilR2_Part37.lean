  obtain ⟨t, ht⟩ := hc m ⟨_, hx⟩ (fun ψ hψ => ha r₀' hrP ψ hψ)
  refine ⟨a, ?_⟩
  intro r hr
  have h2 : r₀' - r ∈ wcGubIdl W A (fun _ : Fin 2 => ζ) ϖ e ^ m := by
    rw [← Ideal.Quotient.eq, hrm, hr]
  rw [Ideal.span_singleton_pow, Ideal.mem_span_singleton'] at h2
  obtain ⟨t', ht'⟩ := h2
  refine ⟨t + t', ?_⟩
  have h3 := congrArg Subtype.val ht'
  simp only [Subalgebra.coe_mul, Subalgebra.coe_pow, Subalgebra.coe_algebraMap,
    Subalgebra.coe_sub] at h3
  simp only [Subalgebra.coe_add]
  have ht2 : algebraMap A (wcGubGen W A) (algebraMap ↥W A ϖ) ^ l e *
      algebraMap A (wcGubGen W A) a - (r₀' : wcGubGen W A) =
        algebraMap A (wcGubGen W A) (algebraMap ↥W A ϖ) ^ m * (t : wcGubGen W A) := ht
