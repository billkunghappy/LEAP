      ∀ x : FractionRing R, IsIntegral R x → ∃ p : Fin n → Polynomial k,
        x = ∑ i, algebraMap R (FractionRing R) (algebraMap (Polynomial k) R (p i)) * b i) →
    ∃ (S : Type u) (_ : CommRing S) (_ : IsDedekindDomain S) (φ : R →+* S),
      Function.Injective φ ∧
      ∃ (n : ℕ) (b : Fin n → S), ∀ x : S, ∃ c : Fin n → R, x = ∑ l, φ (c l) * b l :=
by
  intro k _ R _ _ _ hfin hH
  obtain ⟨n, b, hb, hspan⟩ := hH
  classical
  let b' : Fin n → ↥(integralClosure R (FractionRing R)) :=
    fun i => ⟨b i, (mem_integralClosure_iff R _).2 (hb i)⟩
  have hspan' : ∀ x : ↥(integralClosure R (FractionRing R)), ∃ c : Fin n → R,
      x = ∑ l, algebraMap R ↥(integralClosure R (FractionRing R)) (c l) * b' l := by
    intro x
    obtain ⟨p, hp⟩ := hspan (x : FractionRing R) ((mem_integralClosure_iff R _).1 x.2)
    refine ⟨fun i => algebraMap (Polynomial k) R (p i), ?_⟩
    apply Subtype.ext
    rw [hp]
    simp [b']
  have hinj : Function.Injective (algebraMap R ↥(integralClosure R (FractionRing R))) := by
    intro a a' h
    apply IsFractionRing.injective R (FractionRing R)
    have := congrArg (fun y : ↥(integralClosure R (FractionRing R)) => (y : FractionRing R)) h
    simpa using this
  have : Module.Finite R ↥(integralClosure R (FractionRing R)) := by
    refine ⟨⟨Finset.univ.image b', ?_⟩⟩
    rw [Finset.coe_image, Finset.coe_univ, Set.image_univ, eq_top_iff]
    intro x _
    obtain ⟨c, hc⟩ := hspan' x
    rw [Submodule.mem_span_range_iff_exists_fun]
    exact ⟨c, by rw [hc]; simp [Algebra.smul_def]⟩
  have : IsNoetherianRing R := IsNoetherianRing.of_finite (Polynomial k) R
  have : IsNoetherianRing ↥(integralClosure R (FractionRing R)) :=
    IsNoetherianRing.of_finite R _
  have : Algebra.IsIntegral (Polynomial k) R := Algebra.IsIntegral.of_finite _ _
  have : Ring.DimensionLEOne R := Ring.DimensionLEOne.of_isIntegral (Polynomial k) R
  have : Ring.DimensionLEOne ↥(integralClosure R (FractionRing R)) :=
    Ring.DimensionLEOne.of_isIntegral R _
  have : IsIntegrallyClosed ↥(integralClosure R (FractionRing R)) :=
    integralClosure.isIntegrallyClosedOfFiniteExtension (FractionRing R)
  have hDed : IsDedekindDomain ↥(integralClosure R (FractionRing R)) :=
    (isDedekindDomain_iff ↥(integralClosure R (FractionRing R))
      (FractionRing ↥(integralClosure R (FractionRing R)))).2
      ⟨inferInstance, inferInstance, inferInstance,
        fun h => IsIntegrallyClosed.isIntegral_iff.1 h⟩
  exact ⟨_, inferInstance, hDed, algebraMap R _, hinj, n, b', hspan'⟩

theorem wcpa_dj_lr1k_nsr_gub_bff_dc_ia_os_rbf_dedekind_branches : ∀ (S : Type u) [CommRing S]
    [IsDedekindDomain S] (τ : S), τ ≠ 0 →
    ∃ (L : ℕ) (w : Fin L → AddValuation S ℕ∞) (e : Fin L → ℕ),
      (∀ l, w l τ = (e l : ℕ∞) ∧ 1 ≤ e l) ∧
      ∀ (p : S) (a : ℕ), (∀ l, w l (τ ^ a) ≤ w l p) → τ ^ a ∣ p :=
by
  classical
  intro S _ _ τ hτ
  have s1 : ∀ P : Ideal S, Prime P →
      ∃ w : AddValuation S ℕ∞, ∀ x : S, w x = emultiplicity P (Ideal.span {x}) := by
    intro P hP
    refine ⟨AddValuation.of (fun x => emultiplicity P (Ideal.span {x})) ?_ ?_ ?_ ?_, fun x => rfl⟩
    · show emultiplicity P (Ideal.span {(0 : S)}) = ⊤
      rw [Ideal.span_singleton_eq_bot.mpr rfl, ← Ideal.zero_eq_bot, emultiplicity_zero_right]
    · show emultiplicity P (Ideal.span {(1 : S)}) = 0
      rw [Ideal.span_singleton_one, ← Ideal.one_eq_top, emultiplicity_eq_zero]
      exact fun h => hP.not_isUnit (isUnit_of_dvd_one h)
    · intro x y
      show min (emultiplicity P (Ideal.span {x})) (emultiplicity P (Ideal.span {y})) ≤
        emultiplicity P (Ideal.span {x + y})
      rw [← ENat.forall_natCast_le_iff_le]
      intro n hn
      have hx : (n : ℕ∞) ≤ emultiplicity P (Ideal.span {x}) := hn.trans (min_le_left _ _)
      have hy : (n : ℕ∞) ≤ emultiplicity P (Ideal.span {y}) := hn.trans (min_le_right _ _)
      rw [← pow_dvd_iff_le_emultiplicity, Ideal.dvd_iff_le, Ideal.span_singleton_le_iff_mem] at hx hy ⊢
      exact Ideal.add_mem _ hx hy
    · intro x y
      show emultiplicity P (Ideal.span {x * y}) =
        emultiplicity P (Ideal.span {x}) + emultiplicity P (Ideal.span {y})
      rw [← Ideal.span_singleton_mul_span_singleton]
      exact emultiplicity_mul hP
  have s2 : ∀ (p : S) (a : ℕ), (∀ Q ∈ UniqueFactorizationMonoid.normalizedFactors (Ideal.span {τ}),
      emultiplicity Q (Ideal.span {τ ^ a}) ≤ emultiplicity Q (Ideal.span {p})) → τ ^ a ∣ p := by
    intro p a H
    by_cases hp : p = 0
    · rw [hp]; exact dvd_zero _
    have hI : Ideal.span {τ ^ a} ≠ 0 := by
      rw [Ne, Ideal.zero_eq_bot, Ideal.span_singleton_eq_bot]; exact pow_ne_zero _ hτ
    have hJ : Ideal.span {p} ≠ 0 := by
      rw [Ne, Ideal.zero_eq_bot, Ideal.span_singleton_eq_bot]; exact hp
    rw [← Ideal.span_singleton_le_span_singleton, ← Ideal.dvd_iff_le,
      UniqueFactorizationMonoid.dvd_iff_normalizedFactors_le_normalizedFactors hI hJ,
      Multiset.le_iff_count]
    intro Q
    by_cases hQ : Q ∈ UniqueFactorizationMonoid.normalizedFactors (Ideal.span {τ ^ a})
    · have hQ' : Q ∈ UniqueFactorizationMonoid.normalizedFactors (Ideal.span {τ}) := by
        rw [← Ideal.span_singleton_pow, UniqueFactorizationMonoid.normalizedFactors_pow,
          Multiset.mem_nsmul] at hQ
        exact hQ.2
      have hirr : Irreducible Q :=
        (UniqueFactorizationMonoid.prime_of_normalized_factor Q hQ').irreducible
      have hn : normalize Q = Q := UniqueFactorizationMonoid.normalize_normalized_factor Q hQ'
      have h := H Q hQ'
      rw [UniqueFactorizationMonoid.emultiplicity_eq_count_normalizedFactors hirr hI,
        UniqueFactorizationMonoid.emultiplicity_eq_count_normalizedFactors hirr hJ, hn] at h
      exact_mod_cast h
    · rw [Multiset.count_eq_zero.mpr hQ]; exact Nat.zero_le _
  have hspan : Ideal.span {τ} ≠ 0 := by
    rw [Ne, Ideal.zero_eq_bot, Ideal.span_singleton_eq_bot]; exact hτ
  have hprime : ∀ Q ∈ UniqueFactorizationMonoid.normalizedFactors (Ideal.span {τ}), Prime Q :=
    fun Q hQ => UniqueFactorizationMonoid.prime_of_normalized_factor Q hQ
  choose W hW using fun (Q : (UniqueFactorizationMonoid.normalizedFactors (Ideal.span {τ})).toFinset) =>
    s1 Q.1 (hprime Q.1 (Multiset.mem_toFinset.mp Q.2))
  let ε := (UniqueFactorizationMonoid.normalizedFactors (Ideal.span {τ})).toFinset.equivFin
  refine ⟨(UniqueFactorizationMonoid.normalizedFactors (Ideal.span {τ})).toFinset.card,
    fun l => W (ε.symm l),
    fun l => (UniqueFactorizationMonoid.normalizedFactors (Ideal.span {τ})).count (ε.symm l).1, ?_, ?_⟩
  · intro l
    have hQ : ((ε.symm l) : Ideal S) ∈ UniqueFactorizationMonoid.normalizedFactors (Ideal.span {τ}) :=
      Multiset.mem_toFinset.mp (ε.symm l).2
    refine ⟨?_, Nat.succ_le_of_lt (Multiset.count_pos.mpr hQ)⟩
    rw [hW, UniqueFactorizationMonoid.emultiplicity_eq_count_normalizedFactors
      (hprime _ hQ).irreducible hspan, UniqueFactorizationMonoid.normalize_normalized_factor _ hQ]
  · intro p a H
    apply s2 p a
    intro Q hQ
    have hQ' : Q ∈ (UniqueFactorizationMonoid.normalizedFactors (Ideal.span {τ})).toFinset :=
      Multiset.mem_toFinset.mpr hQ
    have h := H (ε ⟨Q, hQ'⟩)
    simp only [Equiv.symm_apply_apply, hW] at h
    exact h

theorem wcpa_dj_lr1k_nsr_gub_bff_dc_ia_os_rbf_ffin : ∀ (R : Type u) [CommRing R] [IsLocalRing R]
    (A : Type u) [CommRing A] [Algebra R A] (ζ : A) (n : ℕ) (s : Fin n → A),
    (∀ a : A, ∃ p : Fin n → Polynomial R,
      a - ∑ i, Polynomial.aeval ζ (p i) * s i ∈ (IsLocalRing.maximalIdeal R).map (algebraMap R A)) →
    ∀ (P : Ideal A) (b : ℕ), ∃ (r : ℕ) (h : Fin r → A), (∀ j, h j ∈ P) ∧
      ∀ g ∈ P, ∃ c : Fin r → R, g - ∑ j, algebraMap R A (c j) * h j ∈
        Ideal.span {ζ ^ b} ⊔ (IsLocalRing.maximalIdeal R).map (algebraMap R A) :=
by
  intro R _ _ A _ _ ζ n s hs P b
  set I := (IsLocalRing.maximalIdeal R).map (algebraMap R A) with hI
  set Q := Ideal.span {ζ ^ b} ⊔ I with hQ
  have hIQ : I ≤ Q := le_sup_right
  have hbQ : ∀ k, b ≤ k → ζ ^ k ∈ Q := by
    intro k hk
    apply Ideal.mem_sup_left
    rw [Ideal.mem_span_singleton]
    exact pow_dvd_pow ζ hk
  set mk := Ideal.Quotient.mkₐ R Q with hmk
  have hsmul : ∀ (r : R) (x : A), r • mk x = mk (algebraMap R A r * x) := by
    intro r x
    rw [map_mul, AlgHom.commutes, ← Algebra.smul_def]

  set S : Submodule R (A ⧸ Q) :=
    Submodule.span R (Set.range (fun x : Fin n × Fin b => mk (ζ ^ (x.2 : ℕ) * s x.1))) with hS
  have hpoly : ∀ (i : Fin n) (p : Polynomial R), mk (Polynomial.aeval ζ p * s i) ∈ S := by
    intro i p
    induction p using Polynomial.induction_on' with
    | add p q hp hq =>
      rw [map_add, add_mul, map_add]
      exact S.add_mem hp hq
    | monomial k c =>
      rw [Polynomial.aeval_monomial, mul_assoc, ← hsmul]
      by_cases hk : k < b
      · apply S.smul_mem
        exact Submodule.subset_span ⟨(i, ⟨k, hk⟩), rfl⟩
      · have : mk (ζ ^ k * s i) = 0 := by
          rw [hmk, Ideal.Quotient.mkₐ_eq_mk, Ideal.Quotient.eq_zero_iff_mem]
          exact Q.mul_mem_right _ (hbQ k (by omega))
        rw [this, smul_zero]
        exact S.zero_mem
  have hStop : S = ⊤ := by
    rw [eq_top_iff]
    rintro y -
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mkₐ_surjective R Q y
    obtain ⟨p, hp⟩ := hs a
    have e : mk a = mk (∑ i, Polynomial.aeval ζ (p i) * s i) := by
      rw [hmk, Ideal.Quotient.mkₐ_eq_mk, Ideal.Quotient.mk_eq_mk_iff_sub_mem]
      exact hIQ hp
    rw [e, map_sum]
    exact S.sum_mem (fun i _ => hpoly i (p i))
  haveI hfin : Module.Finite R (A ⧸ Q) := by
    rw [Module.finite_def, ← hStop]
    exact Submodule.fg_span (Set.finite_range _)

  have hM : Module.IsTorsionBySet R (A ⧸ Q) (IsLocalRing.maximalIdeal R : Set R) := by
    intro y r
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mkₐ_surjective R Q y
    show (r : R) • mk a = 0
    rw [hsmul, hmk, Ideal.Quotient.mkₐ_eq_mk, Ideal.Quotient.eq_zero_iff_mem]
    exact Q.mul_mem_right _ (hIQ (Ideal.mem_map_of_mem _ r.2))
  letI : Field (R ⧸ IsLocalRing.maximalIdeal R) := Ideal.Quotient.field _
  letI := hM.module
  haveI : IsScalarTower R (R ⧸ IsLocalRing.maximalIdeal R) (A ⧸ Q) := hM.isScalarTower (S := R)
  haveI : Module.Finite (R ⧸ IsLocalRing.maximalIdeal R) (A ⧸ Q) :=
    Module.Finite.of_restrictScalars_finite R _ _
  haveI : IsNoetherian (R ⧸ IsLocalRing.maximalIdeal R) (A ⧸ Q) :=
    isNoetherian_of_isNoetherianRing_of_finite _ _
  let l : (A ⧸ Q) →ₛₗ[Ideal.Quotient.mk (IsLocalRing.maximalIdeal R)] (A ⧸ Q) :=
    { toFun := id
      map_add' := fun _ _ => rfl
      map_smul' := fun r x => (hM.mk_smul r x).symm }
  haveI hN : IsNoetherian R (A ⧸ Q) :=
    (LinearMap.isNoetherian_iff_of_bijective l Function.bijective_id).mpr inferInstance

  set N : Submodule R (A ⧸ Q) := (P.restrictScalars R).map mk.toLinearMap with hNdef
  obtain ⟨r, v, hv⟩ := (Submodule.fg_iff_exists_fin_generating_family).mp (IsNoetherian.noetherian N)
  have hvN : ∀ j, ∃ h ∈ P, mk h = v j := by
    intro j
    have : v j ∈ N := hv ▸ Submodule.subset_span ⟨j, rfl⟩
    obtain ⟨h, hh, e⟩ := Submodule.mem_map.mp this
    exact ⟨h, hh, e⟩
  choose h hhP hhv using hvN
  refine ⟨r, h, hhP, ?_⟩
  intro g hg
  have hgN : mk g ∈ N := Submodule.mem_map_of_mem (p := P.restrictScalars R) (f := mk.toLinearMap) hg
  rw [← hv] at hgN
  obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun R).mp hgN
  refine ⟨c, ?_⟩
  have e : mk g = mk (∑ j, algebraMap R A (c j) * h j) := by
    rw [← hc, map_sum]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    rw [← hsmul, hhv]
  rw [hmk, Ideal.Quotient.mkₐ_eq_mk, Ideal.Quotient.mk_eq_mk_iff_sub_mem] at e
  exact e

theorem wcpa_dj_lr1k_nsr_gub_bff_dc_ia_os_rbf_integral_rel : ∀ (A T : Type u) [CommRing A]
    [CommRing T] [IsDomain T] (π : A →+* T),
    (∃ (n : ℕ) (b : Fin n → T), ∀ x : T, ∃ c : Fin n → A, x = ∑ l, π (c l) * b l) →
    ∀ x : T, ∃ (m : ℕ) (r : Fin m → A), 0 < m ∧
      x ^ m + ∑ l : Fin m, π (r l) * x ^ (m - 1 - l.1) = 0 :=
by
  intro A T _ _ _ π ⟨n, b, hb⟩ x
  letI : Algebra A T := π.toAlgebra
  have halg : algebraMap A T = π := RingHom.algebraMap_toAlgebra π
  haveI hfin : Module.Finite A T := by
    refine Module.Finite.of_surjective (Fintype.linearCombination A b) ?_
    intro y
    obtain ⟨c, hc⟩ := hb y
    refine ⟨c, ?_⟩
    rw [Fintype.linearCombination_apply, hc]
    refine Finset.sum_congr rfl (fun l _ => ?_)
    rw [Algebra.smul_def, halg]
  have hint : _root_.IsIntegral A x := _root_.IsIntegral.of_finite A x
  obtain ⟨p, hpm, hp⟩ := hint
  rw [halg] at hp
  set m := p.natDegree with hm
  have hm0 : 0 < m := by
    rw [hm, Polynomial.Monic.natDegree_pos hpm]
    rintro rfl
    rw [Polynomial.eval₂_one] at hp
    exact one_ne_zero hp
  refine ⟨m, fun l => p.coeff (m - 1 - l.1), hm0, ?_⟩
  have hstar : x ^ m + ∑ i ∈ Finset.range m, π (p.coeff i) * x ^ i = 0 := by
    rw [Polynomial.eval₂_eq_sum_range, Finset.sum_range_succ, ← hm,
      Polynomial.Monic.coeff_natDegree hpm, map_one, one_mul] at hp
    rw [add_comm]; exact hp
  have hre : ∑ l : Fin m, π (p.coeff (m - 1 - l.1)) * x ^ (m - 1 - l.1)
      = ∑ i ∈ Finset.range m, π (p.coeff i) * x ^ i := by
    rw [Fin.sum_univ_eq_sum_range (fun j => π (p.coeff (m - 1 - j)) * x ^ (m - 1 - j)) m]
    exact Finset.sum_range_reflect (fun i => π (p.coeff i) * x ^ i) m
  rw [hre]; exact hstar

theorem wcpa_dj_lr1k_nsr_gub_bff_dc_ia_os_rbf_components : ∀ (Ω : Type u) [Field Ω]
    (W : ValuationSubring Ω),
    (∀ (k : Type u) [Field k] [PerfectField k] (R : Type u) [CommRing R] [IsDomain R]
      [Algebra (Polynomial k) R], Module.Finite (Polynomial k) R →
      ∃ (n : ℕ) (b : Fin n → FractionRing R), (∀ i, IsIntegral R (b i)) ∧
        ∀ x : FractionRing R, IsIntegral R x → ∃ p : Fin n → Polynomial k,
          x = ∑ i, algebraMap R (FractionRing R) (algebraMap (Polynomial k) R (p i)) * b i) →
    (∀ (k : Type u) [Field k] (R : Type u) [CommRing R] [IsDomain R]
      [Algebra (Polynomial k) R], Module.Finite (Polynomial k) R →
      (∃ (n : ℕ) (b : Fin n → FractionRing R), (∀ i, IsIntegral R (b i)) ∧
        ∀ x : FractionRing R, IsIntegral R x → ∃ p : Fin n → Polynomial k,
          x = ∑ i, algebraMap R (FractionRing R) (algebraMap (Polynomial k) R (p i)) * b i) →
      ∃ (S : Type u) (_ : CommRing S) (_ : IsDedekindDomain S) (φ : R →+* S),
        Function.Injective φ ∧
        ∃ (n : ℕ) (b : Fin n → S), ∀ x : S, ∃ c : Fin n → R, x = ∑ l, φ (c l) * b l) →
    ∀ (A : Type u) [CommRing A] [Algebra ↥W A],
    PerfectField (IsLocalRing.ResidueField ↥W) →
    (∀ J : Ideal A, (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) ≤ J →
      ∃ (_ : Algebra (Polynomial (IsLocalRing.ResidueField ↥W)) (A ⧸ J)),
        Module.Finite (Polynomial (IsLocalRing.ResidueField ↥W)) (A ⧸ J)) →
    (∀ (a : A) (j : ℕ), a ^ j ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) →
      a ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)) →
    ∃ (N : ℕ) (T : Fin N → Type u) (_ : ∀ k, CommRing (T k)) (_ : ∀ k, IsDedekindDomain (T k))
      (π : ∀ k, A →+* T k),
      IsNoetherianRing (A ⧸ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)) ∧
      (∀ k, ∀ g ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A), π k g = 0) ∧
      (∀ g : A, (∀ k, π k g = 0) → g ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)) ∧
      (∀ k, ∃ (n : ℕ) (b : Fin n → T k), ∀ x : T k, ∃ c : Fin n → A,
        x = ∑ l, π k (c l) * b l) :=
by
  intro Ω _ W H1 H2 A _ _ hperf hquot hrad
  classical
  haveI := hperf

  have hNoeth : IsNoetherianRing
      (A ⧸ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)) := by
    obtain ⟨inst, hfin⟩ := hquot _ le_rfl
    letI := inst
    haveI : IsNoetherian (Polynomial (IsLocalRing.ResidueField ↥W))
        (A ⧸ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)) :=
      isNoetherian_of_isNoetherianRing_of_finite _ _
    exact isNoetherian_of_tower (Polynomial (IsLocalRing.ResidueField ↥W)) this

  have hfin : ((IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)).minimalPrimes.Finite := by
    rw [Ideal.minimalPrimes_eq_comap]
    exact (minimalPrimes.finite_of_isNoetherianRing _).image _
  let 𝔭 : Fin hfin.toFinset.card → Ideal A := fun k => (hfin.toFinset.equivFin.symm k).1
  have h𝔭mem : ∀ k, 𝔭 k ∈ ((IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)).minimalPrimes :=
    fun k => hfin.mem_toFinset.mp (hfin.toFinset.equivFin.symm k).2
  have hprime : ∀ k, (𝔭 k).IsPrime := fun k => (h𝔭mem k).isPrime
  have hle : ∀ k, (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) ≤ 𝔭 k :=
    fun k => (h𝔭mem k).le
  have hint : ∀ g : A, (∀ k, g ∈ 𝔭 k) →
      g ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) := by
    intro g hg
    have hmem : g ∈ sInf ((IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)).minimalPrimes := by
      rw [Ideal.mem_sInf]
      intro p hp
      have h1 := hg (hfin.toFinset.equivFin ⟨p, hfin.mem_toFinset.mpr hp⟩)
      simpa [𝔭] using h1
    rw [Ideal.sInf_minimalPrimes] at hmem
    obtain ⟨n, hn⟩ := hmem
    exact hrad g n hn

  have hper : ∀ j, ∃ (T : Type u) (_ : CommRing T) (_ : IsDedekindDomain T) (π : A →+* T),
      (∀ g, π g = 0 ↔ g ∈ 𝔭 j) ∧
      ∃ (n : ℕ) (b : Fin n → T), ∀ x : T, ∃ c : Fin n → A, x = ∑ l, π (c l) * b l := by
    intro j
    haveI := hprime j
    obtain ⟨inst, hfinj⟩ := hquot (𝔭 j) (hle j)
    letI := inst
    obtain ⟨S, iS, hS, φ, hinj, n, b, hb⟩ :=
      H2 _ (A ⧸ 𝔭 j) hfinj (H1 _ (A ⧸ 𝔭 j) hfinj)
    refine ⟨S, iS, hS, φ.comp (Ideal.Quotient.mk _), ?_, n, b, ?_⟩
    · intro g
      rw [RingHom.comp_apply, map_eq_zero_iff φ hinj, Ideal.Quotient.eq_zero_iff_mem]
    · intro x
      obtain ⟨c, hc⟩ := hb x
      refine ⟨fun l => (Ideal.Quotient.mk_surjective (c l)).choose, ?_⟩
      rw [hc]
      refine Finset.sum_congr rfl fun l _ => ?_
      rw [RingHom.comp_apply, (Ideal.Quotient.mk_surjective (c l)).choose_spec]
  choose T iT iD π hker hspan using hper
  refine ⟨hfin.toFinset.card, T, iT, iD, π, hNoeth, ?_, ?_, hspan⟩
  · intro k g hg
