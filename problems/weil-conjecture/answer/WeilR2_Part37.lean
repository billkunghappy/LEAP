  have hle : (⊤ : (Spec (.of (wcNcRing W b))).Opens) ≤ c₀ ⁻¹ᵁ (U 0) := by
    intro z _
    have hz : c₀ z ∈ Set.range c₀ := ⟨z, rfl⟩
    rw [hc₀range] at hz
    exact hz
  have hcomp : ∀ z, (c₀.appLE (U 0) ⊤ hle).hom ((r.appLE ⊤ (U 0) (by simp)).hom z) =
      hS.appTop.hom z := by
    intro z
    have e1 := congrArg (fun φ => CommRingCat.Hom.hom φ z)
      (Scheme.Hom.appLE_comp_appLE c₀ r ⊤ (U 0) ⊤ (by simp) hle)
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at e1
    rw [e1, happTop, hc₀r]
  have hu : (c₀.appLE (U 0) ⊤ hle).hom (t 0 1) =
      (Scheme.ΓSpecIso (.of (wcNcRing W b))).inv.hom
        (Ideal.Quotient.mk (wcNcIdeal W b) (MvPolynomial.X 1)) := by
    have e1 := congrArg (c₀.appLE (U 0) ⊤ hle).hom h01
    rw [map_mul, hcomp, hcomp, hnatQ, hnatQ, hHC, hHg0, e2, map_mul] at e1
    exact ((mul_cancel_right_mem_nonZeroDivisors hnzQ).mp e1).symm
  have hover : ∀ y : ↥(Spec (.of (wcNcRing W b))),
      Ideal.Quotient.mk (wcNcIdeal W b) (MvPolynomial.X 1) ∉ y.asIdeal → c₀ y ∈ U 1 := by
    intro y hx1
    have hy1 : y ∈ (Spec (.of (wcNcRing W b))).basicOpen
        ((Scheme.ΓSpecIso (.of (wcNcRing W b))).inv.hom
          (Ideal.Quotient.mk (wcNcIdeal W b) (MvPolynomial.X 1))) := by
      rw [basicOpen_eq_of_affine]
      exact (PrimeSpectrum.mem_basicOpen _ _).mpr hx1
    rw [← hu] at hy1
    have hres : (c₀.appLE (U 0) ⊤ hle).hom (t 0 1) =
