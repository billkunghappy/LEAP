        have e : ψ b = (r.appLE ⊤ (U 0) (by simp)).hom
            ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.C b)) := rfl
        rw [e, h01]
        simp only [map_sub]
        ring
      rw [map_mul, hF, mul_zero]
    refine ⟨Ideal.Quotient.lift (wcNcIdeal W b) Φt hΦt, ?_, ?_, ?_⟩
    · rw [Ideal.Quotient.lift_mk]
      simp [Φt]
    · rw [Ideal.Quotient.lift_mk]
      simp [Φt]
    · intro w
      rw [Ideal.Quotient.lift_mk]
      simp only [Φt, MvPolynomial.eval₂Hom_C]
      rfl
  have hkeyQ : Φ.comp (wcLldmH W e b) = (r.appLE ⊤ (U 0) (by simp)).hom.comp
      (Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom := by
    apply MvPolynomial.ringHom_ext
    · intro w
      simp only [RingHom.comp_apply]
      rw [hHC, hΦC]
    · intro i
      obtain rfl := Fin.fin_one_eq_zero i
      simp only [RingHom.comp_apply]
      rw [hHX0, map_add, hΦX0, hΦC, hsplit0]
  obtain ⟨c₀, hc₀r, hc₀o, hc₀range⟩ := wcpa_dj_ncmb_chart_open_imm _ r U t hr hU 0 _
    hS
    ![1, (Scheme.ΓSpecIso (.of (wcNcRing W b))).inv.hom
      (Ideal.Quotient.mk (wcNcIdeal W b) (MvPolynomial.X 1))]
    (by
      intro j
      fin_cases j
      · exact (one_mul _).symm
      · show hS.appTop.hom
            ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.C b)) =
          (Scheme.ΓSpecIso (.of (wcNcRing W b))).inv.hom
            (Ideal.Quotient.mk (wcNcIdeal W b) (MvPolynomial.X 1)) *
          hS.appTop.hom
            ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom
              (MvPolynomial.X 0 - MvPolynomial.C e))
        rw [hnatQ, hnatQ, hHC, hHg0, e2, map_mul])
    (by
      show hS.appTop.hom
        ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom
          (MvPolynomial.X 0 - MvPolynomial.C e)) ∈ _
      rw [hnatQ, hHg0]
