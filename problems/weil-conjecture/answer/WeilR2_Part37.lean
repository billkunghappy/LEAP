          ⟨(hcomp ξ' hO').mp hc, G y', (hQ y').mp hy', s4 A B G ξ' y' V' hD⟩
      · rintro ⟨hc, y, hy, hD⟩
        have hξO := hgen ξ hc
        obtain ⟨ξ', hξ', -⟩ := hpt ξ hξO
        subst hξ'
        obtain ⟨y', V', hy', hD', hcm⟩ := s5 A B G hUC ξ' (hres ξ' hξO) y U hD
        refine ⟨⟨ξ', V'⟩, Set.mem_setOf.mpr ⟨(hcomp ξ' hξO).mpr hc, (hL ξ').mpr hξO, y',
          (hQ y').mpr (by rw [hy']; exact hy), hD'⟩, ?_⟩
        show (⟨G ξ', V'.comap (G.residueFieldMap ξ').hom⟩ :
          Σ ξ : B, ValuationSubring ↥(B.residueField ξ)) = ⟨G ξ', U⟩
        rw [hcm]
    rw [← Set.InjOn.encard_image hinj, himage]

  intro Ω _ _ W hW hWt C γ hcov X uX ι _ _ hM y₀ hSm σ a hP X' r ι' _ _ hbl hι' hM' V hV hiso
  have hf : (γ ≫ ι') ≫ r = γ ≫ ι := by rw [Category.assoc, hι']
  obtain ⟨G, O, hGs, hImg, hO, hGiso⟩ := s1 Ω W X X' C uX r (γ ≫ ι) (γ ≫ ι') hf V hiso
  obtain ⟨N, j, hj, hjeq⟩ := hM.2.1
  haveI := hj
  haveI hsepX : IsSeparated uX := by rw [← hjeq]; infer_instance
  have hsem := hM'.1
  unfold wcpaDjSemistable at hsem
  haveI hpropX' : IsProper (r ≫ uX) := hsem.2.1
  have hUC : UniversallyClosed G := by
    haveI : UniversallyClosed (G ≫ Limits.pullback.snd ((γ ≫ ι).fromNormalization ≫ uX)
