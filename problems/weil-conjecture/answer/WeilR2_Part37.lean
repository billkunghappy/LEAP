theorem wcpa_dj_lr1k_lldf_smat_iff : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω)
    (Y : Scheme.{u}) (uY : Y ⟶ Spec (.of ↥W)), wcpaDjSemistable uY →
