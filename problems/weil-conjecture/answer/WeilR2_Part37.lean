      intro a ha
      rw [Ch A a, Ch B (G a)]
      constructor
      · intro H b hb
        have hbO : b ∈ O := hb.mem_open O.isOpen ha
        obtain ⟨w, hw, -⟩ := hpt b hbO
        subst hw
        rw [H w (hrefl a w ha hb)]
