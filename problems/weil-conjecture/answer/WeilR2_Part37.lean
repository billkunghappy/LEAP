    intro R Z N0 K1 N' E hR hZ h
    have h5 : (K1 + N') + R = (N0 + Z) + R := by
      calc (K1 + N') + R = K1 + (R + N') := by ring
        _ = (R + Z) + N0 := h.symm
        _ = (N0 + Z) + R := by ring
    exact ((ENat.add_le_add_iff_right hR).mp h5.le).trans (add_le_add le_rfl hZ)
