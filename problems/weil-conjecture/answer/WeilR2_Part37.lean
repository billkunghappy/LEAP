    have h3 := smPi (l (D n)) _ _ _ (hAn n)
    have h4 := smSub _ _ _ _ (smAdd _ _ _ _ h2 h1) h3
    have h5 : wcBffDcSm W A ϖ ζ (l (D n) + l (D n) + N₁ n) (D n)
