  choose e₁ N₁ he₁0 he₁m he₁ using
    wcpa_dj_lr1k_nsr_gub_bff_dc_box_topology Ω W hdimW hWt A ϖ ζ hbase hN
  choose β hβp using hβ
  have hβ0 : ∀ n, β n ≠ 0 := by
