  · exact MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension 1)
      ((isPullback_morphismRestrict _ U).paste_vert (IsPullback.of_hasPullback g _)) hsm

theorem wcpa_dj_lr1k_nsr_na_lb_ratio_smooth : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (X : Scheme.{u}) (uX : X ⟶ Spec (.of ↥W)) (O : X.Opens) (m : O.toScheme ⟶ Spec (.of (MvPolynomial (Fin 1) ↥W))) (a : ↥W), IsAffineOpen O → Etale m → m ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W)) = O.ι ≫ uX → a ≠ 0 → ∀ (I : X.IdealSheafData), I.comap O.ι = (Scheme.Hom.ker (Spec.map (CommRingCat.ofHom (MvPolynomial.eval (fun _ : Fin 1 => (0 : ↥W))))) ⊔ wcNcPrincipal (.of ↥W) (Spec (.of (MvPolynomial (Fin 1) ↥W))) (Spec.map (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W))) a).comap m → ∀ (X₁ : Scheme.{u}) (r : X₁ ⟶ X), wcCsdIsBlowup I r → ∀ (z : X₁) (hz : z ∈ r ⁻¹ᵁ O) (v : X₁.presheaf.stalk z), (X₁.presheaf.germ (r ⁻¹ᵁ O) z hz).hom ((r.app O).hom (O.topIso.hom.hom (m.appTop.hom ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.X 0))))) = v * (X₁.presheaf.germ (r ⁻¹ᵁ O) z hz).hom ((r.app O).hom ((uX.appLE ⊤ O le_top).hom ((Scheme.ΓSpecIso (.of ↥W)).inv.hom a))) → (X₁.presheaf.germ (r ⁻¹ᵁ O) z hz).hom ((r.app O).hom ((uX.appLE ⊤ O le_top).hom ((Scheme.ΓSpecIso (.of ↥W)).inv.hom a))) ∈ nonZeroDivisors (X₁.presheaf.stalk z) → ∃ U : X₁.Opens, z ∈ U ∧ SmoothOfRelativeDimension 1 (U.ι ≫ r ≫ uX) :=
by
  intro Ω _ W X uX O m a hO hm hmq ha I hI X₁ r hbl z hz v hrel hnzd
  classical
  haveI : Etale m := hm

  have hinvhom : ∀ (R : CommRingCat.{u}) (x : R),
      (Scheme.ΓSpecIso R).hom.hom ((Scheme.ΓSpecIso R).inv.hom x) = x := by
    intro R x
    have := congrArg (fun g => g.hom x) (Scheme.ΓSpecIso R).inv_hom_id
    simpa only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_id,
      RingHom.id_apply] using this
  have hhominv : ∀ (R : CommRingCat.{u}) (x : Γ(Spec R, ⊤)),
      (Scheme.ΓSpecIso R).inv.hom ((Scheme.ΓSpecIso R).hom.hom x) = x := by
    intro R x
    have := congrArg (fun g => g.hom x) (Scheme.ΓSpecIso R).hom_inv_id
    simpa only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_id,
      RingHom.id_apply] using this

  have hker0 : RingHom.ker (MvPolynomial.eval (fun _ : Fin 1 => (0 : ↥W))) =
      Ideal.span {MvPolynomial.X 0} := by
    ext p
    rw [RingHom.mem_ker]
    constructor
    · intro h
      have hs : Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 1) ↥W)} =
          Ideal.span (MvPolynomial.X '' Set.univ) := by
        rw [Set.image_univ, Set.range_unique]
        rfl
      rw [hs, MvPolynomial.mem_ideal_span_X_image]
      intro m hm
      refine ⟨0, Set.mem_univ _, ?_⟩
      intro hm0
      have hm' : m = 0 := by
        refine Finsupp.ext (fun i => ?_)
        rw [Fin.fin_one_eq_zero i]
        exact hm0
      subst hm'
      rw [MvPolynomial.mem_support_iff] at hm
      apply hm
      rw [MvPolynomial.eval_zero'] at h
      rw [← h, MvPolynomial.constantCoeff_eq]
    · intro h
      obtain ⟨q, rfl⟩ := Ideal.mem_span_singleton'.mp h
      simp
  have hkerSpec : ∀ (A B : Type u) [CommRing A] [CommRing B] (f : A →+* B) (a : A),
      RingHom.ker f = Ideal.span {a} →
      Scheme.Hom.ker (Spec.map (CommRingCat.ofHom f)) =
        Scheme.IdealSheafData.ofIdealTop (Ideal.span {(Scheme.ΓSpecIso (.of A)).inv.hom a}) := by
    intro A B _ _ f a hf
    rw [Scheme.ker_of_isAffine]
    congr 1
    ext x
    have nat := congrArg (fun g => g.hom x) (Scheme.ΓSpecIso_naturality (CommRingCat.ofHom f))
    simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at nat
    rw [RingHom.mem_ker, Ideal.mem_span_singleton']
    constructor
    · intro hx
      have h1 : f ((Scheme.ΓSpecIso (.of A)).hom.hom x) = 0 := by rw [← nat, hx, map_zero]
      rw [← RingHom.mem_ker, hf, Ideal.mem_span_singleton'] at h1
      obtain ⟨y, hy⟩ := h1
      refine ⟨(Scheme.ΓSpecIso (.of A)).inv.hom y, ?_⟩
      rw [← map_mul, hy, hhominv]
    · rintro ⟨y, rfl⟩
      have hfa : f a = 0 := by
        rw [← RingHom.mem_ker, hf]; exact Ideal.mem_span_singleton_self a
      have h1 : (Scheme.ΓSpecIso (.of B)).hom.hom ((Spec.map (CommRingCat.ofHom f)).appTop.hom
          (y * (Scheme.ΓSpecIso (.of A)).inv.hom a)) = 0 := by
        rw [nat, map_mul, map_mul, hinvhom, hfa, mul_zero]
      have h2 := congrArg (Scheme.ΓSpecIso (.of B)).inv.hom h1
      rwa [hhominv, map_zero] at h2
  have hprinc : wcNcPrincipal (.of ↥W) (Spec (.of (MvPolynomial (Fin 1) ↥W)))
      (Spec.map (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W))) a =
      Scheme.IdealSheafData.ofIdealTop (Ideal.span
        {(Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.C a)}) := by
    unfold wcNcPrincipal
    have := congrArg (fun g => g.hom a) (Scheme.ΓSpecIso_inv_naturality
      (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W)))
    simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at this
    rw [this]
  have hsup : ∀ (Y : Scheme.{u}) (I J : Ideal Γ(Y, ⊤)),
      Scheme.IdealSheafData.ofIdealTop I ⊔ Scheme.IdealSheafData.ofIdealTop J =
        Scheme.IdealSheafData.ofIdealTop (I ⊔ J) := by
    intro Y I J
    apply Scheme.IdealSheafData.ext
    rw [Scheme.IdealSheafData.ideal_sup]
    funext V
    rw [Pi.sup_apply, Scheme.IdealSheafData.ofIdealTop_ideal,
      Scheme.IdealSheafData.ofIdealTop_ideal, Scheme.IdealSheafData.ofIdealTop_ideal,
      Ideal.map_sup]
  have hJ : Scheme.Hom.ker (Spec.map (CommRingCat.ofHom (MvPolynomial.eval (fun _ : Fin 1 => (0 : ↥W))))) ⊔
      wcNcPrincipal (.of ↥W) (Spec (.of (MvPolynomial (Fin 1) ↥W)))
        (Spec.map (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W))) a =
      Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range
        ![(Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.X 0),
          (Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.C a)])) := by
    rw [hkerSpec (MvPolynomial (Fin 1) ↥W) ↥W _ _ hker0, hprinc, hsup]
    congr 1
    rw [Matrix.range_cons, Matrix.range_cons, Matrix.range_empty, Set.union_empty,
      Set.singleton_union, Ideal.span_insert]

  obtain ⟨hJ0FG, -⟩ := wcpa_dj_mscc_model_centre Ω W a ha
  obtain ⟨M', r₀, hr₀⟩ := wcpa_dj_ms_blowup_exists_ft _ _ hJ0FG

  have hb1 := wcpa_dj_nc_blowup_flat_basechange X X₁ O.toScheme _ r O.ι inferInstance hbl
  have hb2 := wcpa_dj_nc_blowup_flat_basechange _ M' O.toScheme _ r₀ m inferInstance hr₀
  rw [← hI] at hb2
  obtain ⟨θ, hθ, -⟩ := hb2.2 _ (Limits.pullback.snd r O.ι) hb1.1
  obtain ⟨θ', hθ', -⟩ := hb1.2 _ (Limits.pullback.snd r₀ m) hb2.1
  have hθθ' : θ ≫ θ' = 𝟙 _ := by
    obtain ⟨_, _, huniq⟩ := hb1.2 _ (Limits.pullback.snd r O.ι) hb1.1
    exact (huniq _ (by show (θ ≫ θ') ≫ _ = _; rw [Category.assoc, hθ', hθ])).trans
      (huniq _ (Category.id_comp _)).symm
  have hθ'θ : θ' ≫ θ = 𝟙 _ := by
    obtain ⟨_, _, huniq⟩ := hb2.2 _ (Limits.pullback.snd r₀ m) hb2.1
    exact (huniq _ (by show (θ' ≫ θ) ≫ _ = _; rw [Category.assoc, hθ, hθ'])).trans
      (huniq _ (Category.id_comp _)).symm
  haveI : IsIso θ := ⟨θ', hθθ', hθ'θ⟩
  obtain ⟨e, he⟩ : ∃ e : Limits.pullback r O.ι ⟶ M', e = θ ≫ Limits.pullback.fst r₀ m :=
    ⟨_, rfl⟩
  haveI : Etale e := by rw [he]; infer_instance
  have her : e ≫ r₀ = Limits.pullback.snd r O.ι ≫ m := by
    rw [he, Category.assoc, Limits.pullback.condition, ← Category.assoc, hθ]
  have hsq : Limits.pullback.fst r O.ι ≫ r = Limits.pullback.snd r O.ι ≫ O.ι :=
    Limits.pullback.condition

  obtain ⟨p, hp1, -⟩ := Scheme.exists_preimage_of_isPullback (IsPullback.of_hasPullback r O.ι)
    z ⟨r z, hz⟩ rfl
  subst hp1

  have hconst : (uX.appLE ⊤ O le_top).hom ((Scheme.ΓSpecIso (.of ↥W)).inv.hom a) =
      O.topIso.hom.hom (m.appTop.hom
        ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.C a))) := by
    have e1 := congrArg (fun g => g.hom a) (Scheme.ΓSpecIso_inv_naturality
      (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W)))
    simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at e1
    rw [e1]
    have e2 : m.appTop.hom ((Spec.map (CommRingCat.ofHom
        (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W))).appTop.hom
          ((Scheme.ΓSpecIso (.of ↥W)).inv.hom a)) =
        O.ι.appTop.hom (uX.appTop.hom ((Scheme.ΓSpecIso (.of ↥W)).inv.hom a)) := by
      have := congrArg (fun f => f.appTop.hom ((Scheme.ΓSpecIso (.of ↥W)).inv.hom a)) hmq
      simpa only [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply] using this
    rw [e2]
    have e3 : O.ι.appTop ≫ O.topIso.hom = X.presheaf.map (homOfLE (le_top : O ≤ ⊤)).op := by
      rw [Scheme.Opens.ι_appTop, Scheme.Opens.topIso_hom]
      exact (X.presheaf.map_comp _ _).symm
    have e4 := congrArg (fun f => f.hom (uX.appTop.hom ((Scheme.ΓSpecIso (.of ↥W)).inv.hom a))) e3
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at e4
    rw [e4]
    rfl
  rw [hconst] at hrel hnzd

  have KG : ∀ y : Γ(O.toScheme, ⊤),
      (Scheme.Hom.stalkMap (Limits.pullback.fst r O.ι) p).hom
        ((X₁.presheaf.germ (r ⁻¹ᵁ O) (Limits.pullback.fst r O.ι p) hz).hom
          ((r.app O).hom (O.topIso.hom.hom y))) =
      ((Limits.pullback r O.ι).presheaf.germ ⊤ p trivial).hom
        ((Limits.pullback.snd r O.ι).appTop.hom y) := by
    intro y
    rw [Scheme.Hom.germ_stalkMap_apply]
    have hB1 : ∀ (k : Limits.pullback r O.ι ⟶ X) (hk : k = Limits.pullback.snd r O.ι ≫ O.ι)
        (W' : (Limits.pullback r O.ι).Opens) (hW : W' ≤ k ⁻¹ᵁ O) (hp' : p ∈ W'),
        ((Limits.pullback r O.ι).presheaf.germ W' p hp').hom
          ((k.appLE O W' hW).hom (O.topIso.hom.hom y)) =
        ((Limits.pullback r O.ι).presheaf.germ ⊤ p trivial).hom
          ((Limits.pullback.snd r O.ι).appTop.hom y) := by
      intro k hk W' hW hp'
      subst hk
      have hA : O.topIso.hom ≫ O.ι.app O =
          O.toScheme.presheaf.map (homOfLE (le_top : O.ι ⁻¹ᵁ O ≤ ⊤)).op := by
        rw [Scheme.Opens.ι_app_self, Scheme.Opens.topIso_hom]
        exact (X.presheaf.map_comp _ _).symm
      have hB : O.topIso.hom ≫ (Limits.pullback.snd r O.ι ≫ O.ι).appLE O W' hW =
          (Limits.pullback.snd r O.ι).appTop ≫
            (Limits.pullback r O.ι).presheaf.map (homOfLE (le_top : W' ≤ ⊤)).op := by
        rw [Scheme.Hom.comp_appLE, ← Category.assoc, hA]
        erw [Scheme.Hom.map_appLE]
        rfl
      have hC := congrArg (fun φ => φ.hom y) hB
      simp only [CommRingCat.hom_comp, RingHom.comp_apply] at hC
      rw [hC]
      exact TopCat.Presheaf.germ_res_apply _ _ _ _ _
    have e5 : ((Limits.pullback.fst r O.ι).app (r ⁻¹ᵁ O)).hom ((r.app O).hom (O.topIso.hom.hom y)) =
        ((Limits.pullback.fst r O.ι ≫ r).app O).hom (O.topIso.hom.hom y) := by
      rw [Scheme.Hom.comp_app]; rfl
    rw [e5]
    have e6 := hB1 _ hsq ((Limits.pullback.fst r O.ι ≫ r) ⁻¹ᵁ O) le_rfl hz
    rw [Scheme.Hom.appLE_eq_app] at e6
    exact e6
  have hNZDiso : ∀ (R S : CommRingCat.{u}) (φ : R ⟶ S) [IsIso φ] (b : R),
      b ∈ nonZeroDivisors R → φ.hom b ∈ nonZeroDivisors S := by
    intro R S φ _ b hb
    have hbij := ConcreteCategory.bijective_of_isIso φ
    rw [mem_nonZeroDivisors_iff_right] at hb ⊢
    intro x hx
    obtain ⟨x', rfl⟩ := hbij.2 x
    have h1 : φ.hom (x' * b) = φ.hom 0 := by rw [map_mul, map_zero]; exact hx
    have h2 := hb x' (hbij.1 h1)
    rw [h2]
    exact map_zero _
  have hsm : ∀ y, (Limits.pullback.snd r O.ι).appTop.hom (m.appTop.hom y) =
      (e ≫ r₀).appTop.hom y := by
    intro y
    rw [her, Scheme.Hom.comp_appTop]
    rfl
  have hw := congrArg (Scheme.Hom.stalkMap (Limits.pullback.fst r O.ι) p).hom hrel
  rw [map_mul, KG, KG, hsm, hsm] at hw
  have hwnzd := hNZDiso _ _ (Scheme.Hom.stalkMap (Limits.pullback.fst r O.ι) p) _ hnzd
  rw [KG, hsm] at hwnzd
  set w := (Scheme.Hom.stalkMap (Limits.pullback.fst r O.ι) p).hom v with hwdef

  rw [hJ] at hr₀

  obtain ⟨U, t, hU⟩ := wc_bp_blowup_charts _ r₀ hr₀
  obtain ⟨h₁, τ₁, ρ₀, ρc, hh₁s, hτ₁, hnzd₁, hgen₁, hφ₁, -, -, -⟩ :=
    wcpa_dj_mscm_chart_data_c Ω W a ha M' r₀ U t hU
  obtain ⟨c₁, hc₁r, hc₁o, hc₁range⟩ :=
    wcpa_dj_ncmb_chart_open_imm _ r₀ U t hr₀ hU 1 _ h₁ τ₁ hτ₁ hnzd₁ hgen₁ hφ₁
  haveI := hc₁o
  have hg₁ : c₁ ≫ r₀ ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W)) =
      Spec.map (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W)) := by
    rw [← Category.assoc, hc₁r, hh₁s]
  have hqsm : SmoothOfRelativeDimension 1
      (Spec.map (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W))) := by
    rw [HasRingHomProperty.Spec_iff (P := @SmoothOfRelativeDimension 1)]
    apply RingHom.locally_of RingHom.isStandardSmoothOfRelativeDimension_respectsIso
    rw [CommRingCat.hom_ofHom, ← MvPolynomial.algebraMap_eq]
    rw [RingHom.isStandardSmoothOfRelativeDimension_algebraMap]
