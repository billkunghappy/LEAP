      have h1 : Ideal.comap (algebraMap ↥W Ω) (x : PrimeSpectrum Ω).asIdeal = ⊥ := by
        rw [hx]
        exact (RingHom.injective_iff_ker_eq_bot _).mp Subtype.val_injective
