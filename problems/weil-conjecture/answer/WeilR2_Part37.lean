            (Scheme.ΓSpecIso (.of ↥(N.presheaf.stalk n))).inv.hom)) c := by
      intro c
      rw [hθ]
      have s₂ : ((ρ ≫ Limits.pullback.fst p (N.fromSpecStalk n)) ≫ p) (genericPoint R) ⤳ n :=
        hcond ▸ s'
      rw [← hψ s' c, hcongr _ _ hcond.symm s' s₂ c]
      refine Eq.trans ?_ (congrArg (fun φ => CommRingCat.Hom.hom φ
        ((N.presheaf.stalkSpecializes s₂).hom c))
        (Scheme.Hom.stalkMap_comp (ρ ≫ Limits.pullback.fst p (N.fromSpecStalk n)) p
          (genericPoint R))).symm
      rfl

    have F2gen : ∀ (x : Y) (hx : x = h (genericPoint C)) (hxs : h (genericPoint C) ⤳ x)
        (sx : p x ⤳ n) (c : N.presheaf.stalk n),
        (wcLr1uGerm h x hxs).hom ((p.stalkMap x).hom ((N.presheaf.stalkSpecializes sx).hom c)) =
          (wcLr1uGerm (h ≫ p) n hn).hom c := by
      rintro x rfl hxs sx c
      unfold wcLr1uGerm
      rw [TopCat.Presheaf.stalkSpecializes_refl, Scheme.Hom.stalkMap_comp]
      simp only [Category.id_comp, CommRingCat.hom_comp, RingHom.comp_apply]
      rfl
    have F2 : ∀ c, (wcLr1uGerm h _ hxsp).hom (θ c) = (wcLr1uGerm (h ≫ p) n hn).hom c := by
      intro c
      rw [hθ]
      exact F2gen _ hx hxsp s c

    have F3gen : ∀ (y : Y), y = genericPoint Y → ∀ (T : CommRingCat.{u}) [Nontrivial T]
        (φ : Y.presheaf.stalk y ⟶ T), Function.Injective φ.hom := by
      intro y hy T _ φ
      subst hy
      exact RingHom.injective (φ.hom : Y.functionField →+* T)
    have F3 := F3gen _ (hx.trans hηY.symm) _
      ((ρ ≫ Limits.pullback.fst p (N.fromSpecStalk n)).stalkMap (genericPoint R))

    obtain ⟨k, hk⟩ := Scheme.Hom.stalkMap_surjective
      (ρ ≫ Limits.pullback.fst p (N.fromSpecStalk n)) (genericPoint R) f
    obtain ⟨P, hPm, hPe⟩ := hf
    have hκθ : ((ρ ≫ Limits.pullback.fst p (N.fromSpecStalk n)).stalkMap
        (genericPoint R)).hom.comp θ =
        ((R.presheaf.germ ⊤ (genericPoint ↥R) trivial).hom.comp
          ((ρ ≫ Limits.pullback.snd p (N.fromSpecStalk n)).appTop.hom.comp
            (Scheme.ΓSpecIso (.of ↥(N.presheaf.stalk n))).inv.hom)) := RingHom.ext F1
    have hιθ : (wcLr1uGerm h _ hxsp).hom.comp θ = (wcLr1uGerm (h ≫ p) n hn).hom := RingHom.ext F2
    have h0 : P.eval₂ θ k = 0 := by
      apply F3
      rw [map_zero, Polynomial.hom_eval₂, hκθ, hk]
      exact hPe
    have h1 : P.eval₂ (wcLr1uGerm (h ≫ p) n hn).hom ((wcLr1uGerm h _ hxsp).hom k) = 0 := by
      rw [← hιθ, ← Polynomial.hom_eval₂, h0, map_zero]
    obtain ⟨a, ha⟩ := hB _ ⟨P, hPm, h1⟩
    have hθa : θ a = k := hιinj (by rw [F2 a, ha])
    refine ⟨a, ?_⟩
    rw [← F1 a, hθa, hk]
  have hf1 : ∀ r : ↥R, (ρ ≫ Limits.pullback.snd p (N.fromSpecStalk n)) r =
      IsLocalRing.closedPoint ↥(N.presheaf.stalk n) →
      p ((ρ ≫ Limits.pullback.fst p (N.fromSpecStalk n)) r) = n := by
    intro r hr
    have e : ((ρ ≫ Limits.pullback.fst p (N.fromSpecStalk n)) ≫ p) r =
        ((ρ ≫ Limits.pullback.snd p (N.fromSpecStalk n)) ≫ N.fromSpecStalk n) r := by rw [hcond]
    simp only [Scheme.Hom.comp_apply] at e hr ⊢
    rw [e, hr]
    exact Scheme.fromSpecStalk_closedPoint
  have hf2 : ∀ y : ↥Y, p y = n → ∃ r : ↥R, (ρ ≫ Limits.pullback.fst p (N.fromSpecStalk n)) r = y ∧
      (ρ ≫ Limits.pullback.snd p (N.fromSpecStalk n)) r =
        IsLocalRing.closedPoint ↥(N.presheaf.stalk n) := by
    intro y hy
    obtain ⟨z, hz1, hz2⟩ := Scheme.Pullback.exists_preimage_pullback (f := p)
      (g := N.fromSpecStalk n) y (IsLocalRing.closedPoint _)
      (by rw [hy, Scheme.fromSpecStalk_closedPoint])
    obtain ⟨r, hr⟩ : z ∈ Set.range ρ := by rw [hρr]; trivial
    exact ⟨r, by rw [Scheme.Hom.comp_apply, hr, hz1], by rw [Scheme.Hom.comp_apply, hr, hz2]⟩
  have hpc := @s1 ↥(N.presheaf.stalk n) _ hNloc R hRint
    (ρ ≫ Limits.pullback.snd p (N.fromSpecStalk n)) inferInstance hint
  have hT : ⇑p ⁻¹' {n} =
      ⇑(ρ ≫ Limits.pullback.fst p (N.fromSpecStalk n)) ''
        (⇑(ρ ≫ Limits.pullback.snd p (N.fromSpecStalk n)) ⁻¹'
          {IsLocalRing.closedPoint ↥(N.presheaf.stalk n)}) := by
    ext y
    constructor
    · intro hy
      obtain ⟨r, hr1, hr2⟩ := hf2 y hy
      exact ⟨r, hr2, hr1⟩
    · rintro ⟨r, hr, rfl⟩
      exact hf1 r hr
  rw [hT]
  exact hpc.image _ (ρ ≫ Limits.pullback.fst p (N.fromSpecStalk n)).continuous.continuousOn

theorem wcpa_dj_lr1k_nsr_nafc_nn_sections_closed : ∀ (C : Scheme.{u}) [AlgebraicGeometry.IsIntegral C] (W : C.Opens) (hW : genericPoint ↥C ∈ W), (∀ c : ↥C, c ∈ W → IsIntegrallyClosed ↥(C.presheaf.stalk c)) → ∀ w : ↥C.functionField, (∃ q : Polynomial ↥Γ(C, W), q.Monic ∧ q.eval₂ (C.presheaf.germ W (genericPoint ↥C) hW).hom w = 0) → ∃ b : ↥Γ(C, W), (C.presheaf.germ W (genericPoint ↥C) hW).hom b = w :=
by
  intro C _ W hW hN w hq
  obtain ⟨q, hqm, hq⟩ := hq
  have key : ∀ (U V' : C.Opens) (i : V' ⟶ U) (x : C) (hx : x ∈ V') (t : Γ(C, U)),
      (C.presheaf.germ V' x hx).hom ((C.presheaf.map i.op).hom t) =
        (C.presheaf.germ U x (i.le hx)).hom t := by
    intro U V' i x hx t
    rw [← TopCat.Presheaf.germ_res C.presheaf i x hx]
    rfl
  have hloc : ∀ i : ↥W, ∃ (V : C.Opens) (hV : genericPoint ↥C ∈ V) (s : ↥Γ(C, V)),
      i.1 ∈ V ∧ V ≤ W ∧ (C.presheaf.germ V (genericPoint ↥C) hV).hom s = w := by
    rintro ⟨c, hc⟩
    have := hN c hc
    have hsp : genericPoint C ⤳ c := (genericPoint_spec C).specializes (Set.mem_univ c)
    have hcomp : ∀ (U : C.Opens) (hcU : c ∈ U) (x : Γ(C, U)),
        algebraMap (C.presheaf.stalk c) C.functionField ((C.presheaf.germ U c hcU).hom x) =
          (C.presheaf.germ U (genericPoint C) (hsp.mem_open U.isOpen hcU)).hom x := by
      intro U hcU x
      show (C.presheaf.stalkSpecializes hsp).hom ((C.presheaf.germ U c hcU).hom x) = _
      rw [← TopCat.Presheaf.germ_stalkSpecializes C.presheaf hcU hsp]
      rfl
    have hint : IsIntegral (C.presheaf.stalk c) w := by
      refine ⟨q.map (C.presheaf.germ W c hc).hom, hqm.map _, ?_⟩
      rw [Polynomial.eval₂_map]
      have : (algebraMap (C.presheaf.stalk c) C.functionField).comp (C.presheaf.germ W c hc).hom
          = (C.presheaf.germ W (genericPoint C) hW).hom := RingHom.ext (hcomp W hc)
      rw [this]
      exact hq
    obtain ⟨e, he⟩ := IsIntegrallyClosed.algebraMap_eq_of_integral hint
    obtain ⟨U, hcU, s₀, hs₀⟩ := TopCat.Presheaf.exists_germ_eq C.presheaf e
    have hηV : genericPoint C ∈ U ⊓ W := hsp.mem_open (U ⊓ W).isOpen ⟨hcU, hc⟩
    refine ⟨U ⊓ W, hηV, (C.presheaf.map (homOfLE (inf_le_left : U ⊓ W ≤ U)).op).hom s₀,
      ⟨hcU, hc⟩, inf_le_right, ?_⟩
    rw [key, ← hcomp U hcU s₀]
    exact (congrArg _ hs₀).trans he
  choose V hV s hcV hVW hs using hloc
  have hcompat : TopCat.Presheaf.IsCompatible C.sheaf.obj V s := by
    intro i j
    have hη : genericPoint C ∈ V i ⊓ V j := ⟨hV i, hV j⟩
    apply germ_injective_of_isIntegral C (genericPoint C) hη
    change (C.presheaf.germ _ _ hη).hom ((C.presheaf.map _).hom (s i)) =
      (C.presheaf.germ _ _ hη).hom ((C.presheaf.map _).hom (s j))
    rw [key, key, hs i, hs j]
  have hcover : W ≤ iSup V := by
    intro x hx
    exact TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨x, hx⟩, hcV ⟨x, hx⟩⟩
  obtain ⟨b, hb, -⟩ := TopCat.Sheaf.existsUnique_gluing' C.sheaf V W
    (fun i => homOfLE (hVW i)) hcover s hcompat
  let i0 : ↥W := ⟨genericPoint C, hW⟩
  have h1 : (C.presheaf.map (homOfLE (hVW i0)).op).hom b = s i0 := hb i0
  refine ⟨b, ?_⟩
  have h2 := key W (V i0) (homOfLE (hVW i0)) (genericPoint C) (hV i0) b
  rw [h1, hs i0] at h2
  exact h2.symm

theorem wcpa_dj_lr1k_nsr_nafc_nn_localization : ∀ (A O L : Type u) [CommRing A] [CommRing O] [Field L] [Algebra A O] (p : Ideal A) [p.IsPrime] [IsLocalization.AtPrime O p] (g : O →+* L), Function.Injective (g.comp (algebraMap A O)) → (∀ w : L, (∃ q : Polynomial A, q.Monic ∧ q.eval₂ (g.comp (algebraMap A O)) w = 0) → ∃ a : A, g (algebraMap A O a) = w) → Function.Injective g ∧ ∀ z : L, (∃ q : Polynomial O, q.Monic ∧ q.eval₂ g z = 0) → ∃ e : O, g e = z :=
by
  intro A O L _ _ _ _ p _ _ g hφ hH
  refine ⟨?_, ?_⟩
  · apply IsLocalization.injective_of_map_algebraMap_zero (M := p.primeCompl) O g
    intro x hx
    have h0 : x = 0 := hφ (by simpa using hx)
    rw [h0, map_zero]
  · rintro z ⟨q, hqm, hq⟩
    letI : Algebra O L := g.toAlgebra
    letI : Algebra A L := (g.comp (algebraMap A O)).toAlgebra
    haveI : IsScalarTower A O L := IsScalarTower.of_algebraMap_eq' rfl
    have hz : IsIntegral O z := ⟨q, hqm, hq⟩
    obtain ⟨⟨s, hs⟩, hint⟩ :=
      IsIntegral.exists_multiple_integral_of_isLocalization p.primeCompl z hz
    obtain ⟨Q, hQm, hQ⟩ := hint
    have hsm : ((⟨s, hs⟩ : p.primeCompl) • z) = g (algebraMap A O s) * z := by
      rw [Submonoid.smul_def, Algebra.smul_def]
      rfl
    rw [hsm] at hQ
    obtain ⟨a, ha⟩ := hH _ ⟨Q, hQm, hQ⟩
    refine ⟨IsLocalization.mk' O a (⟨s, hs⟩ : p.primeCompl), ?_⟩
    have hspec := IsLocalization.mk'_spec O a (⟨s, hs⟩ : p.primeCompl)
    have hu : IsUnit (g (algebraMap A O s)) :=
      (IsLocalization.map_units O (⟨s, hs⟩ : p.primeCompl)).map g
    apply hu.mul_left_inj.mp
    rw [← map_mul]
    simp only at hspec
    rw [hspec, ha, mul_comm]

theorem wcpa_dj_lr1k_nsr_nafc_nn_normalization_sections : ∀ (C Z : Scheme.{u}) [AlgebraicGeometry.IsIntegral C] (f : C ⟶ Z) [QuasiCompact f] [QuasiSeparated f] (U : Z.Opens), IsAffineOpen U → ∀ (hη : genericPoint ↥C ∈ f ⁻¹ᵁ U) (hle : f ⁻¹ᵁ U ≤ f.toNormalization ⁻¹ᵁ (f.fromNormalization ⁻¹ᵁ U)), (∀ w : ↥C.functionField, (∃ q : Polynomial ↥Γ(C, f ⁻¹ᵁ U), q.Monic ∧ q.eval₂ (C.presheaf.germ (f ⁻¹ᵁ U) (genericPoint ↥C) hη).hom w = 0) → ∃ b : ↥Γ(C, f ⁻¹ᵁ U), (C.presheaf.germ (f ⁻¹ᵁ U) (genericPoint ↥C) hη).hom b = w) → Function.Injective ((C.presheaf.germ (f ⁻¹ᵁ U) (genericPoint ↥C) hη).hom.comp (f.toNormalization.appLE (f.fromNormalization ⁻¹ᵁ U) (f ⁻¹ᵁ U) hle).hom) ∧ ∀ w : ↥C.functionField, (∃ q : Polynomial ↥Γ(f.normalization, f.fromNormalization ⁻¹ᵁ U), q.Monic ∧ q.eval₂ ((C.presheaf.germ (f ⁻¹ᵁ U) (genericPoint ↥C) hη).hom.comp (f.toNormalization.appLE (f.fromNormalization ⁻¹ᵁ U) (f ⁻¹ᵁ U) hle).hom) w = 0) → ∃ a : ↥Γ(f.normalization, f.fromNormalization ⁻¹ᵁ U), (C.presheaf.germ (f ⁻¹ᵁ U) (genericPoint ↥C) hη).hom ((f.toNormalization.appLE (f.fromNormalization ⁻¹ᵁ U) (f ⁻¹ᵁ U) hle).hom a) = w :=
by
  intro C Z _ f _ _ U hU hη hle hH
  classical
