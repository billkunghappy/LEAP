    obtain ⟨n, b, hb⟩ := Submodule.fg_iff_exists_fin_generating_family.mp hC
    have hbC : ∀ i, b i ∈ (integralClosure (Polynomial k) (FractionRing R)).toSubmodule :=
      fun i => hb ▸ Submodule.subset_span ⟨i, rfl⟩
    refine ⟨n, b, fun i => IsIntegral.tower_top (A := R) (hbC i), ?_⟩
    intro x hx
    have hx' : x ∈ (integralClosure (Polynomial k) (FractionRing R)).toSubmodule :=
      isIntegral_trans (R := Polynomial k) x hx
    rw [← hb, Submodule.mem_span_range_iff_exists_fun] at hx'
