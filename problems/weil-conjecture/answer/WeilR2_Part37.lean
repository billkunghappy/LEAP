    have hj : ∀ j, ψ j z * (w : Ω) = ψ j (algebraMap A (wcGubGen W A) a) := by
      intro j
      have h := congrArg (ψ j) hz'
      rw [map_mul, ← hwμ, (hpts j).1] at h
