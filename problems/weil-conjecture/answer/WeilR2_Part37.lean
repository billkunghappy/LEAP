        AdicCompletion.evalₐ (wcGubIdl W A (fun _ : Fin 2 => ζ) ϖ e) M (z e) →
      wcBffDcSm W A ϖ ζ M e ((r : wcGubGen W A) * (r : wcGubGen W A) -
        algebraMap A (wcGubGen W A) (algebraMap ↥W A ϖ) ^ l e * (r : wcGubGen W A)) := by
    intro e he hem M r hr
