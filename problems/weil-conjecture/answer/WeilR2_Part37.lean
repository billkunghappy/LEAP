    push_neg at hall
    apply hcancel
    have hev : ϖ ^ (K + 1) ∣ δ.eval t₀ := by
      rw [Polynomial.eval_eq_sum_range]
      exact Finset.dvd_sum (fun i _ => hall i)
    have := dvd_sub hev hD
    rwa [sub_sub_cancel] at this
  obtain ⟨k, hk⟩ := hesc
  refine ⟨k, ?_⟩
  have hkK : k ≤ K₁ := by
    by_contra hlt
    push_neg at hlt
    apply hk
    exact Dvd.dvd.mul_left (hK₁.trans (pow_dvd_pow t₀ hlt.le)) _
  have ha : δ.coeff k ∣ ϖ ^ (K + 1) := by
    rcases ValuationRing.dvd_total (δ.coeff k) (ϖ ^ (K + 1)) with h | h
    · exact h
    · exact absurd (Dvd.dvd.mul_right h _) hk
