    intro D o K π Θ Θ' c c' δ u β' E' hD hΘ hΘ' hδ hδm hK hβ hE' h1 h2
    have hc0 : c ≠ 0 := by rintro rfl; exact hΘ (by rw [hδ, zero_mul])
    have hδ0 : δ ≠ 0 := by rintro rfl; exact hΘ (by rw [hδ, mul_zero])
    have hδu : ¬ IsUnit δ := hnu δ hδm
