      obtain ⟨P₁, hP₁⟩ := hr1
      have hemb : Topology.IsEmbedding (Z.fromSpecStalk t) := Scheme.Hom.isEmbedding _
      have s01 : P₀ ⤳ P₁ := hemb.isInducing.specializes_iff.mp (by rw [hP₀, hP₁]; exact hξζ)
      have s12 : P₁ ⤳ IsLocalRing.closedPoint (Z.presheaf.stalk t) :=
