        wcpaDjLkBranches ((wcpaDjLkFib W (γ ≫ ι) uX).presheaf.stalk y) =
          wcpaDjLkBranches ((wcpaDjLkFib W (γ ≫ ι) uX).presheaf.stalk y') :=
by
  intro Ω _ _ W hW hWt C γ hcov hgal X uX ι _ _ hM y y' hImg
  obtain ⟨hss, hXp, hpb⟩ := hM
  obtain ⟨hXint, hXnorm⟩ := wcpa_dj_lr1u_model_normal Ω W hW hWt X uX ι hss hXp hpb
  obtain ⟨hGfin, hdesc⟩ :=
