      ⟨(N.presheaf.stalkSpecializes s ≫ p.stalkMap
        ((ρ ≫ Limits.pullback.fst p (N.fromSpecStalk n)) (genericPoint R))).hom, fun c => rfl⟩

    have F1 : ∀ c, ((ρ ≫ Limits.pullback.fst p (N.fromSpecStalk n)).stalkMap
        (genericPoint R)).hom (θ c) =
        ((R.presheaf.germ ⊤ (genericPoint ↥R) trivial).hom.comp
