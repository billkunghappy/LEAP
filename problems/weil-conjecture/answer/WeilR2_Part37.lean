theorem wcpa_dj_lr1k_nsr_na_lb_chart_comap : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (X : Scheme.{u}) (uX : X ⟶ Spec (.of ↥W)) (σ : Spec (.of ↥W) ⟶ X) (O : X.Opens) (m : O.toScheme ⟶ Spec (.of (MvPolynomial (Fin 1) ↥W))) (σO : Spec (.of ↥W) ⟶ O.toScheme) (a : ↥W), IsAffineOpen O → IsClosedImmersion σ → m ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W)) = O.ι ≫ uX → σO ≫ O.ι = σ → σO ≫ m = Spec.map (CommRingCat.ofHom (MvPolynomial.eval (fun _ : Fin 1 => (0 : ↥W)))) → RingHom.ker σO.appTop.hom = Ideal.span {m.appTop.hom ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.X 0))} → (Scheme.Hom.ker σ ⊔ wcNcPrincipal (.of ↥W) X uX a).comap O.ι = (Scheme.Hom.ker (Spec.map (CommRingCat.ofHom (MvPolynomial.eval (fun _ : Fin 1 => (0 : ↥W))))) ⊔ wcNcPrincipal (.of ↥W) (Spec (.of (MvPolynomial (Fin 1) ↥W))) (Spec.map (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W))) a).comap m :=
