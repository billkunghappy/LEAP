  · rw [Category.assoc, Limits.pullback.condition, ← Category.assoc, he0]
  · rw [Category.assoc, Limits.pullback.condition, ← Category.assoc, he1]
  · intro y
    rcases hcov (r₂₀ y) with h | ⟨p, hp⟩
    · left
      obtain ⟨u, rfl⟩ := hpre y h
      refine ⟨c₀.isoOpensRange.inv ((r₂₀ ∣_ c₀.opensRange) u), ?_⟩
      have hm : ((r₂₀ ∣_ c₀.opensRange) ≫ c₀.isoOpensRange.inv) ≫
