      rw [map_mul, map_one, Hfix] at this
      exact this
    · rw [Hlt, Hfix]
      exact hlt s hs

  obtain ⟨hc, e1, e2⟩ := hC
  have hn : g' (wcNdPt W (γ ≫ ι₀) u₀ w) ⤳ wcNdPt W (γ ≫ ι₀) u₀ w := by
    rw [hg'3]
  have h' : ((γ ≫ ι₀).toNormalization ≫ g') (genericPoint C) ⤳ wcNdPt W (γ ≫ ι₀) u₀ w := by
    rw [Scheme.Hom.comp_apply]
