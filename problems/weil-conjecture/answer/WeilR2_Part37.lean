  obtain ⟨Ψ, hΨiso, hΨν, hΨz⟩ :=
    wcpa_dj_lr1k_llfi_norm_transitive C (wcProjK Ω 1) X γ ι hGfin hinv
      (Limits.pullback.fst ((γ ≫ ι).fromNormalization ≫ uX)
