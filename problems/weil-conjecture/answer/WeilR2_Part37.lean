    have hN' : (N.restrictScalars A').FG := hN.restrictScalars
    let P : Submodule A' L :=
      { carrier := {y | ∃ x ∈ C, x ^ p ^ e = y}
        add_mem' := by
          rintro _ _ ⟨x₁, h₁, rfl⟩ ⟨x₂, h₂, rfl⟩
          exact ⟨x₁ + x₂, C.add_mem h₁ h₂, add_pow_expChar_pow x₁ x₂ p e⟩
        zero_mem' := ⟨0, C.zero_mem, zero_pow hq.ne'⟩
        smul_mem' := by
          rintro ⟨_, a, rfl⟩ _ ⟨x, hx, rfl⟩
          refine ⟨a • x, C.smul_mem a hx, ?_⟩
          rw [Subring.smul_def]
          simp only [Algebra.smul_def, mul_pow, map_pow, iterateFrobenius_def] }
