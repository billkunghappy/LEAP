      have key : ∑ j, (lam j : Ω) * ψ j (algebraMap A (wcGubGen W A) a) =
          (ϖ : Ω) ^ L * ∑ j, (lam j : Ω) * ψ j (algebraMap A (wcGubGen W A) s) := by
        calc ∑ j, (lam j : Ω) * ψ j (algebraMap A (wcGubGen W A) a)
