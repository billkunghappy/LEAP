          S.card * B - 1 := by
        rcases Nat.eq_zero_or_pos T₁.card with h0 | hpos
        · rw [Finset.card_eq_zero.mp h0, Finset.sum_empty]; exact Nat.zero_le _
        · have hcomm : B * (S.card * d) = d * (S.card * B) := by ring
