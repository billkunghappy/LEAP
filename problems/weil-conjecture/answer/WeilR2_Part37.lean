  have s6 : ∀ (P A F₀ K : Type u) [CommRing P] [IsDomain P] [CommRing A] [IsDomain A] [Field F₀]
      [Field K] [Algebra P A] [Algebra P F₀] [IsFractionRing P F₀] [Algebra A K]
      [IsFractionRing A K] [Algebra P K] [Algebra F₀ K] [IsScalarTower P F₀ K]
      [IsScalarTower P A K], Algebra.FiniteType P A → ∀ (g : Polynomial P) (a : A), g.Monic →
      1 ≤ g.natDegree → Polynomial.aeval a g = 0 →
      IntermediateField.adjoin F₀ {algebraMap A K a} = ⊤ →
      ∃ c : P, c ≠ 0 ∧ ∀ x : A, ∃ (k : ℕ) (Q : Fin g.natDegree → P),
