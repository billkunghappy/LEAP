        have hsplit : ∑ i ∈ Finset.range (N + 1 + 1), c i * f ^ i * b ^ (N + 1 - i) =
            b * S + c (N + 1) * f ^ (N + 1) := by
          rw [Finset.sum_range_succ, hS, Finset.mul_sum]
          congr 1
          · apply Finset.sum_congr rfl
            intro i hi
            have := Finset.mem_range.mp hi
            rw [show N + 1 - i = (N - i) + 1 by omega, pow_succ]
            ring
          · simp
        rw [hsplit] at hc
        have h1 : f ^ (N + 1) * c (N + 1) ∈ Ideal.span {b} := by
          rw [Ideal.mem_span_singleton']
          exact ⟨-S, by linear_combination -hc⟩
        obtain ⟨d, hd⟩ := Ideal.mem_span_singleton'.mp (hfk (N + 1) _ h1)
        have h2 : S + d * f ^ (N + 1) = 0 := by
          apply hbreg
          linear_combination hc + f ^ (N + 1) * hd
        set c' : ℕ → A := fun i => if i = N then c N + d * f else c i with hc'
        have h3 : ∑ i ∈ Finset.range (N + 1), c' i * f ^ i * b ^ (N - i) = 0 := by
          rw [← h2, hS, Finset.sum_range_succ, Finset.sum_range_succ]
          have e : ∑ i ∈ Finset.range N, c' i * f ^ i * b ^ (N - i) =
              ∑ i ∈ Finset.range N, c i * f ^ i * b ^ (N - i) := by
            apply Finset.sum_congr rfl
            intro i hi
            have : i ≠ N := by have := Finset.mem_range.mp hi; omega
            simp [hc', this]
          rw [e]
          simp only [hc', if_pos rfl, Nat.sub_self, pow_zero, mul_one]
          ring
        intro i hi
        rcases Nat.lt_or_ge i N with hiN | hiN
        · have := ih c' h3 i hiN.le
          simpa [hc', show i ≠ N by omega] using this
        · rcases Nat.eq_or_lt_of_le hiN with hiN' | hiN'
          · rw [← hiN']
            have := ih c' h3 N le_rfl
            simp only [hc', if_pos rfl] at this
            have e : c N = (c N + d * f) - d * f := by ring
            rw [e]
            exact p.sub_mem this (p.mul_mem_left _ hf)
          · have : i = N + 1 := by omega
            rw [this, ← hd]
            exact p.mul_mem_left _ hb
    set N := q.natDegree
    have hsum : κ (∑ i ∈ Finset.range (N + 1), q.coeff i * f ^ i * b ^ (N - i)) = 0 := by
      have e : κ (∑ i ∈ Finset.range (N + 1), q.coeff i * f ^ i * b ^ (N - i)) =
          κ b ^ N * Polynomial.eval₂ κ u q := by
        rw [Polynomial.eval₂_eq_sum_range, map_sum, Finset.mul_sum]
        apply Finset.sum_congr rfl
        intro i hi
        have hi' : i ≤ N := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
        rw [map_mul, map_mul, map_pow, map_pow, ← hu, mul_pow, ← pow_mul_pow_sub (κ b) hi']
        ring
      rw [e, hq, mul_zero]
    have hsum' := hκ (hsum.trans (map_zero κ).symm)
    intro n
    rcases Nat.lt_or_ge N n with hn | hn
    · rw [Polynomial.coeff_eq_zero_of_natDegree_lt hn]
      exact p.zero_mem
    · exact claim N (fun i => q.coeff i) hsum' n hn

  have primeval : ∀ (A : Type u) [CommRing A] (K : Type u) [Field K] (κ : A →+* K)
      (p : Ideal A) [p.IsPrime] (u : K),
      (∀ q : Polynomial A, Polynomial.eval₂ κ u q = 0 → ∀ n : ℕ, q.coeff n ∈ p) →
      ∃ B : ValuationSubring K, (∀ h : A, B.valuation (κ h) ≤ 1) ∧
        (∀ h ∈ p, B.valuation (κ h) < 1) ∧ (∀ h : A, h ∉ p → B.valuation (κ h) = 1) ∧
        B.valuation u = 1 := by
    intro A _ K _ κ p _ u H
    set φ : Polynomial A →+* K := Polynomial.eval₂RingHom κ u with hφ
    set R : Subring K := φ.range with hR
    set φ' : Polynomial A →+* R := φ.rangeRestrict with hφ'
    have hsurj : Function.Surjective φ' := RingHom.rangeRestrict_surjective φ
    set P : Ideal (Polynomial A) := Ideal.map Polynomial.C p with hP
    have : P.IsPrime := Ideal.isPrime_map_C_of_isPrime
    have hker : RingHom.ker φ' ≤ P := by
      intro r hr
      rw [RingHom.mem_ker] at hr
      rw [hP, Ideal.mem_map_C_iff]
      apply H
      have := congrArg Subtype.val hr
      exact this
    set Q : Ideal R := Ideal.map φ' P with hQ
    have hQp : Q.IsPrime := Ideal.map_isPrime_of_surjective hsurj hker
    have hQiff : ∀ r : Polynomial A, φ' r ∈ Q ↔ r ∈ P := by
      intro r
      rw [← Ideal.mem_comap, hQ, Ideal.comap_map_of_surjective' φ' hsurj, sup_eq_left.mpr hker]
    set L := LocalSubring.ofPrime R Q with hL
    obtain ⟨B, hB⟩ := LocalSubring.exists_le_valuationSubring L
    obtain ⟨hLB, hloc⟩ := LocalSubring.le_def.mp hB
    have hRL : R ≤ L.toSubring := LocalSubring.le_ofPrime R Q
    have hle : ∀ r : R, B.valuation (r : K) ≤ 1 := by
      intro r
      rw [ValuationSubring.valuation_le_one_iff]
      exact hLB (hRL r.2)
    have hone : ∀ r : R, r ∉ Q → B.valuation (r : K) = 1 := by
      intro r hr
      have hu : IsUnit (algebraMap R L.toSubring r) :=
        (IsLocalization.AtPrime.isUnit_to_map_iff L.toSubring Q r).mpr hr
      have hu' := hu.map (Subring.inclusion hLB)
      exact (ValuationSubring.valuation_eq_one_iff B _).mp hu'
    have hlt : ∀ r : R, r ∈ Q → B.valuation (r : K) < 1 := by
      intro r hr
      have hnu : ¬ IsUnit (algebraMap R L.toSubring r) := by
        rw [IsLocalization.AtPrime.isUnit_to_map_iff L.toSubring Q r]
        exact fun h => h hr
      have hnu' : ¬ IsUnit (Subring.inclusion hLB (algebraMap R L.toSubring r)) :=
        fun h => hnu (IsUnit.of_map _ _ h)
      have h1 : B.valuation (r : K) ≤ 1 := hle r
      have h2 : B.valuation (r : K) ≠ 1 := by
        intro h
        apply hnu'
        exact (ValuationSubring.valuation_eq_one_iff B _).mpr h
      exact lt_of_le_of_ne h1 h2
    have hCval : ∀ h : A, ((φ' (Polynomial.C h) : R) : K) = κ h := by
      intro h
      change Polynomial.eval₂ κ u (Polynomial.C h) = κ h
      exact Polynomial.eval₂_C _ _
    have hXval : ((φ' Polynomial.X : R) : K) = u := by
      change Polynomial.eval₂ κ u Polynomial.X = u
      exact Polynomial.eval₂_X _ _
    have hCmem : ∀ h : A, φ' (Polynomial.C h) ∈ Q ↔ h ∈ p := by
      intro h
      rw [hQiff, hP, Ideal.mem_map_C_iff]
      constructor
      · intro H0; simpa using H0 0
      · intro H0 n
        rw [Polynomial.coeff_C]
        split_ifs
        · exact H0
        · exact p.zero_mem
    refine ⟨B, fun h => ?_, fun h hh => ?_, fun h hh => ?_, ?_⟩
    · rw [← hCval]; exact hle _
    · rw [← hCval]; exact hlt _ ((hCmem h).mpr hh)
    · rw [← hCval]; exact hone _ (fun H0 => hh ((hCmem h).mp H0))
    · rw [← hXval]
      apply hone
      rw [hQiff, hP, Ideal.mem_map_C_iff]
      intro H0
      have := H0 1
      rw [Polynomial.coeff_X_one] at this
      exact (Ideal.IsPrime.ne_top inferInstance) ((Ideal.eq_top_iff_one p).mpr this)

  have regpair : ∀ (W : Type u) [CommRing W] [IsDomain W] (A : Type u) [CommRing A]
      (g : MvPolynomial (Fin 1) W →+* A), g.Etale → ∀ (β θ : W), β ≠ 0 →
      (∀ y : A, g (MvPolynomial.C β) * y = 0 → y = 0) ∧
      (∀ y : A, (g (MvPolynomial.X 0) - g (MvPolynomial.C θ)) * y ∈
        Ideal.span {g (MvPolynomial.C β)} → y ∈ Ideal.span {g (MvPolynomial.C β)}) := by
    intro W _ _ A _ g hg β θ hβ
    letI := g.toAlgebra
    haveI : Algebra.Etale (MvPolynomial (Fin 1) W) A := hg
    haveI : Module.Flat (MvPolynomial (Fin 1) W) A := inferInstance
    have hb₀ : IsSMulRegular (MvPolynomial (Fin 1) W)
        (MvPolynomial.C β : MvPolynomial (Fin 1) W) := by
      intro y z h
      have hb0 : (MvPolynomial.C β : MvPolynomial (Fin 1) W) ≠ 0 := by
        rw [Ne, MvPolynomial.C_eq_zero]; exact hβ
      exact mul_left_cancel₀ hb0 h
    have key : ∀ (R : Type u) [CommRing R] (c : R) (z : MvPolynomial (Fin 1) R),
        (MvPolynomial.X 0 - MvPolynomial.C c) * z = 0 → z = 0 := by
      intro R _ c z hz
      let e := MvPolynomial.finSuccEquiv R 0
      have h1 : e ((MvPolynomial.X 0 - MvPolynomial.C c) * z) = 0 := by rw [hz, map_zero]
      have hC : e (MvPolynomial.C c) = Polynomial.C (MvPolynomial.C c) := by
        rw [← MvPolynomial.algebraMap_eq, e.commutes, Polynomial.algebraMap_apply,
          MvPolynomial.algebraMap_eq]
      rw [map_mul, map_sub, MvPolynomial.finSuccEquiv_X_zero, hC] at h1
      have h2 : e z = 0 :=
        (Polynomial.monic_X_sub_C (MvPolynomial.C c)).isRegular.left
          (show (Polynomial.X - Polynomial.C (MvPolynomial.C c)) * e z =
            (Polynomial.X - Polynomial.C (MvPolynomial.C c)) * 0 by rw [h1, mul_zero])
      exact (map_eq_zero_iff e e.injective).mp h2
    have hf₀ : ∀ y : MvPolynomial (Fin 1) W,
        (MvPolynomial.X 0 - MvPolynomial.C θ) * y ∈
          Ideal.span {(MvPolynomial.C β : MvPolynomial (Fin 1) W)} →
        y ∈ Ideal.span {(MvPolynomial.C β : MvPolynomial (Fin 1) W)} := by
      intro y hy
      let π : MvPolynomial (Fin 1) W →+* MvPolynomial (Fin 1) (W ⧸ Ideal.span {β}) :=
        MvPolynomial.map (Ideal.Quotient.mk (Ideal.span {β}))
      have hker : RingHom.ker π =
          Ideal.span {(MvPolynomial.C β : MvPolynomial (Fin 1) W)} := by
        rw [MvPolynomial.ker_map, Ideal.mk_ker, Ideal.map_span, Set.image_singleton]
      rw [← hker, RingHom.mem_ker] at hy ⊢
      rw [map_mul, map_sub, MvPolynomial.map_X, MvPolynomial.map_C] at hy
      exact key _ _ _ hy
    open Pointwise in
    have hmem : ∀ (M : Type u) [CommRing M] (r x : M),
        x ∈ r • (⊤ : Submodule M M) ↔ x ∈ Ideal.span {r} := by
      intro M _ r x
      rw [Submodule.mem_smul_pointwise_iff_exists, Ideal.mem_span_singleton']
      constructor
      · rintro ⟨b, -, hb⟩; exact ⟨b, by rw [← hb, smul_eq_mul, mul_comm]⟩
      · rintro ⟨b, hb⟩; exact ⟨b, trivial, by rw [← hb, smul_eq_mul, mul_comm]⟩
    have hreg : RingTheory.Sequence.IsWeaklyRegular (MvPolynomial (Fin 1) W)
        [(MvPolynomial.C β : MvPolynomial (Fin 1) W), MvPolynomial.X 0 - MvPolynomial.C θ] := by
      rw [RingTheory.Sequence.isWeaklyRegular_cons_iff]
      refine ⟨hb₀, ?_⟩
      rw [RingTheory.Sequence.isWeaklyRegular_cons_iff]
      refine ⟨?_, RingTheory.Sequence.IsWeaklyRegular.nil _ _⟩
      intro y z hyz
      obtain ⟨y, rfl⟩ := Submodule.Quotient.mk_surjective _ y
      obtain ⟨z, rfl⟩ := Submodule.Quotient.mk_surjective _ z
      simp only [← Submodule.Quotient.mk_smul] at hyz
      rw [Submodule.Quotient.eq, hmem] at hyz ⊢
      apply hf₀
      rw [smul_eq_mul, smul_eq_mul, ← mul_sub] at hyz
      exact hyz
    have hregA := hreg.of_flat (S := A)
    simp only [List.map_cons, List.map_nil, RingHom.algebraMap_toAlgebra, map_sub] at hregA
    rw [RingTheory.Sequence.isWeaklyRegular_cons_iff,
      RingTheory.Sequence.isWeaklyRegular_cons_iff] at hregA
    obtain ⟨hA1, hA2, -⟩ := hregA
    refine ⟨fun y hy => hA1 (show g (MvPolynomial.C β) • y = g (MvPolynomial.C β) • (0 : A) by
      rw [smul_eq_mul, smul_eq_mul, hy, mul_zero]), fun y hy => ?_⟩
    have h : ((g (MvPolynomial.X 0) - g (MvPolynomial.C θ)) • (Submodule.Quotient.mk y :
        QuotSMulTop (g (MvPolynomial.C β)) A)) =
        (g (MvPolynomial.X 0) - g (MvPolynomial.C θ)) •
          (0 : QuotSMulTop (g (MvPolynomial.C β)) A) := by
      rw [smul_zero, ← Submodule.Quotient.mk_smul, ← Submodule.Quotient.mk_zero,
        Submodule.Quotient.eq, sub_zero, hmem, smul_eq_mul]
      exact hy
    have h2 := hA2 h
    rw [← Submodule.Quotient.mk_zero, Submodule.Quotient.eq, sub_zero, hmem] at h2
    exact h2

  unfold wcNsrNaHyp wcpaDjLkModel at hH
  obtain ⟨hW, -, -, -, ⟨hss, -, hpb⟩, -⟩ := hH
  unfold wcNsrNaChart at hch
  unfold wcNsrNaDom wcNsrNaOm wcNsrNaS
  generalize hxdef : wcpaDjLkImg W (γ ≫ ι) uX y₀ = x at hch hσx ⊢
  obtain ⟨hVa, hxV, hg, hgC, -, hθ⟩ := hch

  haveI : Ring.KrullDimLE 1 ↥W := Ring.krullDimLE_iff.mpr hW
  have hprimes : ∀ I : Ideal ↥W, I.IsPrime → I = ⊥ ∨ I = IsLocalRing.maximalIdeal ↥W := by
    intro I hI
    rcases Ring.krullDimLE_one_iff.mp inferInstance I hI with h | h
    · exact Or.inl (le_bot_iff.mp (h.2 ⟨Ideal.isPrime_bot, bot_le⟩ bot_le))
    · exact Or.inr (IsLocalRing.eq_maximalIdeal h)
  have hβΩ : (β : Ω) ≠ 0 := fun h => hβ0 (Subtype.ext h)
  have hloc : IsLocalization.Away β Ω := by
    refine ⟨?_, ?_, ?_⟩
    · rintro ⟨y, n, rfl⟩
      simp only [map_pow]
      apply IsUnit.pow
      exact isUnit_iff_ne_zero.mpr (by
        show (β : Ω) ≠ 0
        exact hβΩ)
    · intro x
      by_cases hx : x ∈ W
      · exact ⟨(⟨x, hx⟩, 1), by simp⟩
      · have hx0 : x ≠ 0 := fun h => hx (h ▸ W.zero_mem)
        have hxi : x⁻¹ ∈ W := (W.mem_or_inv_mem x).resolve_left hx
        obtain ⟨y, hy⟩ : ∃ y : ↥W, y = ⟨x⁻¹, hxi⟩ := ⟨_, rfl⟩
        have hyv : (y : Ω) = x⁻¹ := by rw [hy]
        have hy0 : y ≠ 0 := fun h => inv_ne_zero hx0 (by rw [← hyv, h]; rfl)
        have hamem : β ∈ (Ideal.span {y}).radical := by
          rw [Ideal.radical_eq_sInf, Submodule.mem_sInf]
          rintro J ⟨hyJ, hJ⟩
          rcases hprimes J hJ with h | h
          · exfalso
            apply hy0
            have : y ∈ J := hyJ (Ideal.mem_span_singleton_self y)
            rw [h] at this
            simpa using this
          · rw [h]; exact hβm
        obtain ⟨n, hn⟩ := hamem
        obtain ⟨w, hw⟩ := Ideal.mem_span_singleton'.mp hn
        refine ⟨(w, ⟨β ^ n, n, rfl⟩), ?_⟩
        have hw' : (w : Ω) * x⁻¹ = (β : Ω) ^ n := by
          rw [← hyv]
          have := congrArg Subtype.val hw
          simpa using this
        show x * algebraMap ↥W Ω (β ^ n) = algebraMap ↥W Ω w
        simp only [map_pow]
        show x * (β : Ω) ^ n = (w : Ω)
        rw [← hw', mul_comm (w : Ω), ← mul_assoc, mul_inv_cancel₀ hx0, one_mul]
    · intro x y hxy
      exact ⟨1, by simpa using Subtype.val_injective hxy⟩
  haveI heW : IsOpenImmersion (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) :=
    IsOpenImmersion.of_isLocalization β
  have hra : ∀ z : ↥(Spec (.of ↥W)),
      z ∈ Set.range ⇑(Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) ↔ β ∉ z.asIdeal := by
    intro z
    constructor
    · rintro ⟨x, rfl⟩ hz
      have hx : (x : PrimeSpectrum Ω).asIdeal = ⊥ :=
