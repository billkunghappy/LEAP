  let v : Fin r → (wcGubGen W A →* Ω) := fun j => (ψ j).toMonoidHom
  have hv : Function.Injective v := by
    intro j k hjk
    apply hinj
    ext x
    exact DFunLike.congr_fun hjk x
  have hli := (linearIndependent_monoidHom (wcGubGen W A) Ω).comp v hv
  rw [Fintype.linearIndependent_iff] at hli
  have h0 := hli (fun j => (lam j : Ω)) (by
    funext z
    simp only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul, Function.comp_apply, Pi.zero_apply]
    exact hGen z)
  apply hlam0
  funext j
  exact Subtype.ext (h0 j)

theorem wcpa_dj_lr1k_nsr_gub_bff_dc_ia_pbc_tb_gram : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A] [Algebra ↥W A] (ϖ : ↥W) (η : A) (r : ℕ) (b : Fin r → A), (∀ (L : ℕ) (a : A), ∃ (p : Fin r → Polynomial ↥W) (s : A), a = ∑ i, Polynomial.aeval η (p i) * b i + algebraMap ↥W A ϖ ^ L * s) → ∀ L : ℕ, ∃ G : Matrix (Fin r) (Fin r) (Polynomial ↥W), ∀ (t : ↥W) (ψ : Fin r → (wcGubGen W A →+* Ω)), (∀ (a : A) (L' : ℕ) (M : Matrix (Fin r) (Fin r) (Polynomial ↥W)), (∀ i, a * b i - ∑ j, Polynomial.aeval η (M i j) * b j ∈ Ideal.span {algebraMap ↥W A ϖ ^ L'}) → ∀ n : ℕ, ∃ u : ↥W, ((M.map (Polynomial.evalRingHom t)).charpoly.map (algebraMap ↥W Ω)).coeff n - (∏ j, (Polynomial.X - Polynomial.C (ψ j (algebraMap A (wcGubGen W A) a)))).coeff n = (ϖ : Ω) ^ L' * (u : Ω)) → ∀ i k, ∃ u : ↥W, ((Polynomial.eval t (G i k) : ↥W) : Ω) = ∑ j, ψ j (algebraMap A (wcGubGen W A) (b i)) * ψ j (algebraMap A (wcGubGen W A) (b k)) + (ϖ : Ω) ^ L * (u : Ω) :=
