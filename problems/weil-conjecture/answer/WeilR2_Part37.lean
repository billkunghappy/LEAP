        algebraMap ↥W A w * wcIaSum W A ζ r₁ r₀ f₁ f₀ c' -
          algebraMap ↥W A w' * wcIaSum W A ζ r₁ r₀ f₁ f₀ c := by
    intro c c' w w'
    unfold wcIaSum
    rw [Finsupp.sum_sub_index, Finsupp.sum_smul_index', Finsupp.sum_smul_index', Finsupp.mul_sum,
      Finsupp.mul_sum]
    · simp only [smul_eq_mul, map_mul, mul_assoc]
    all_goals (intros; simp only [map_sub, sub_mul, map_zero, zero_mul])

  have L5 : ∀ x : ↥W, x ≠ 0 → x ∈ IsLocalRing.maximalIdeal ↥W → ∀ P : ℕ, 2 * l x + 1 ≤ P →
      ∀ r : ↥(wcGubBox W A (fun _ : Fin 2 => ζ) x),
        Ideal.Quotient.mk (wcGubIdl W A (fun _ : Fin 2 => ζ) ϖ x ^ P) r =
          AdicCompletion.evalₐ (wcGubIdl W A (fun _ : Fin 2 => ζ) ϖ x) P (z x) →
      ∀ ψ : wcGubGen W A →+* Ω, wcIaPt W A ζ x ψ →
        ∃ u : ↥W, ψ (r : wcGubGen W A) = (ϖ : Ω) ^ l x * (u : Ω) := by
    intro x hx hxm P hP r hr ψ hψ
