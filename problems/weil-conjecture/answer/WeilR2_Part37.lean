    rcases hgood with h0 | ⟨h1, h2⟩
    · left
      exact wcpa_dj_lr1k_gn_regular_closed_smooth (IsLocalRing.ResidueField ↥W) _ _ 1 _ hw
        (wcpa_dj_lr1k_gn_delta_zero_regular _ hdle h0) (le_antisymm hdle hdge)
    · right
      exact wcpa_dj_lr1k_gn_node_completion (IsLocalRing.ResidueField ↥W) _ _ hres hdle h1 h2
  · left
    exact wcpa_dj_lr1k_gn_generic_smooth Ω W hW hWt Ct φ hcov X uX ι hM w hw

theorem wcpa_dj_lr1k_simultaneous_model : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ → ∀ (Ct : Scheme.{u}) (ct : Ct ⟶ Spec (.of Ω)) (φ : Ct ⟶ wcProjK Ω 1), wcpaDjIsProjOver Ω ct → SmoothOfRelativeDimension 1 ct → IrreducibleSpace Ct → IsFinite φ → φ ≫ wcProjKStr Ω 1 = ct → (∃ V : Ct.Opens, Dense (V : Set Ct) ∧ Etale (V.ι ≫ φ)) → ∃ (X₀ : Scheme.{u}) (uX₀ : X₀ ⟶ Spec (.of ↥W)) (ι₀ : wcProjK Ω 1 ⟶ X₀) (_ : QuasiCompact (φ ≫ ι₀)) (_ : QuasiSeparated (φ ≫ ι₀)), wcpaDjSemistable uX₀ ∧ (∃ (N : ℕ) (j : X₀ ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W) MvPolynomial.gradedAlgebra), IsClosedImmersion j ∧ j ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W) MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥W ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W 0))) = uX₀) ∧ IsPullback ι₀ (wcProjKStr Ω 1) uX₀ (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) ∧ (∀ w : ↥(Limits.pullback ((φ ≫ ι₀).fromNormalization ≫ uX₀) (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))), (∃ U : (Limits.pullback ((φ ≫ ι₀).fromNormalization ≫ uX₀) (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))).Opens, w ∈ U ∧ SmoothOfRelativeDimension 1 (U.ι ≫ Limits.pullback.snd ((φ ≫ ι₀).fromNormalization ≫ uX₀) (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))))) ∨ (∃ e : AdicCompletion (IsLocalRing.maximalIdeal ((Limits.pullback ((φ ≫ ι₀).fromNormalization ≫ uX₀) (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))).presheaf.stalk w)) ((Limits.pullback ((φ ≫ ι₀).fromNormalization ≫ uX₀) (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))).presheaf.stalk w) ≃+* (MvPowerSeries (Fin 2) (IsLocalRing.ResidueField ↥W) ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}), (e.toRingHom.comp ((algebraMap ((Limits.pullback ((φ ≫ ι₀).fromNormalization ≫ uX₀) (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))).presheaf.stalk w) (AdicCompletion (IsLocalRing.maximalIdeal ((Limits.pullback ((φ ≫ ι₀).fromNormalization ≫ uX₀) (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))).presheaf.stalk w)) ((Limits.pullback ((φ ≫ ι₀).fromNormalization ≫ uX₀) (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))).presheaf.stalk w))).comp ((Scheme.ΓSpecIso (.of (IsLocalRing.ResidueField ↥W))).inv ≫ (Limits.pullback.snd ((φ ≫ ι₀).fromNormalization ≫ uX₀) (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))).appTop ≫ (Limits.pullback ((φ ≫ ι₀).fromNormalization ≫ uX₀) (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))).presheaf.germ ⊤ w trivial).hom)) = (Ideal.Quotient.mk _).comp MvPowerSeries.C)) :=
by
  intro Ω _ _ W hW hWt Ct ct φ hproj hsm hirr hφf hφ hgen

  have hcov : wcpaDjLkCov Ω φ := by
    subst hφ
    exact ⟨hproj, hsm, hirr, hφf, hgen⟩

  obtain ⟨C, π, hπf, hπs, hcovC, hgal⟩ := wcpa_dj_lr1k_galois_closure_cover Ω Ct φ hcov

  have hι : ∀ {X : Scheme.{u}} (uX : X ⟶ Spec (.of ↥W)) (ι : wcProjK Ω 1 ⟶ X),
      wcpaDjLkModel W uX ι → QuasiCompact ι ∧ QuasiSeparated ι := by
    intro X uX ι hM
    have hpb := hM.2.2
    exact ⟨MorphismProperty.of_isPullback (P := @QuasiCompact) hpb.flip inferInstance,
      MorphismProperty.of_isPullback (P := @QuasiSeparated) hpb.flip inferInstance⟩
  haveI hγf : IsFinite (π ≫ φ) := hcovC.2.2.2.1

  have key : ∀ (n : ℕ∞) (X : Scheme.{u}) (uX : X ⟶ Spec (.of ↥W)) (ι : wcProjK Ω 1 ⟶ X)
      [QuasiCompact ((π ≫ φ) ≫ ι)] [QuasiSeparated ((π ≫ φ) ≫ ι)],
      wcpaDjLkMeasure W ((π ≫ φ) ≫ ι) uX = n →
      wcpaDjLkModel W uX ι → wcpaDjLkAdmissible W ((π ≫ φ) ≫ ι) uX →
      ∃ (X₀ : Scheme.{u}) (uX₀ : X₀ ⟶ Spec (.of ↥W)) (ι₀ : wcProjK Ω 1 ⟶ X₀)
        (_ : QuasiCompact ((π ≫ φ) ≫ ι₀)) (_ : QuasiSeparated ((π ≫ φ) ≫ ι₀)),
        wcpaDjLkModel W uX₀ ι₀ ∧ wcpaDjLkAllGood W ((π ≫ φ) ≫ ι₀) uX₀ := by
    intro n
    induction n using WellFoundedLT.induction with
    | _ n ih =>
      intro X uX ι i1 i2 hn hM hA
      by_cases hG : wcpaDjLkAllGood W ((π ≫ φ) ≫ ι) uX
      · exact ⟨X, uX, ι, i1, i2, hM, hG⟩
      · obtain ⟨X', uX', ι', i1', i2', hM', hA', hlt⟩ :=
          wcpa_dj_lr1k_improvement Ω W hW hWt C (π ≫ φ) hcovC hgal X uX ι hM hA hG
        exact @ih _ (hn ▸ hlt) X' uX' ι' i1' i2' rfl hM' hA'

  obtain ⟨X₁, u₁, ι₁, hM₁, hsm₁⟩ := wcpa_dj_lr1k_base_model Ω W
  obtain ⟨qc1, qs1⟩ := hι u₁ ι₁ hM₁
  have hA₁ : wcpaDjLkAdmissible W ((π ≫ φ) ≫ ι₁) u₁ := fun y _ => hsm₁ _
  obtain ⟨X₀, uX₀, ι₀, i10, i20, hM₀, hG₀⟩ := key _ X₁ u₁ ι₁ rfl hM₁ hA₁

  obtain ⟨qc0, qs0⟩ := hι uX₀ ι₀ hM₀
  have hG : wcpaDjLkAllGood W (φ ≫ ι₀) uX₀ :=
    wcpa_dj_lr1k_nodal_descent Ω W hW hWt Ct C φ π hcov hcovC hgal hπf hπs X₀ uX₀ ι₀ hM₀ hG₀
  have hN := wcpa_dj_lr1k_good_nodal Ω W hW hWt Ct φ hcov X₀ uX₀ ι₀ hM₀ hG
  exact ⟨X₀, uX₀, ι₀, inferInstance, inferInstance, hM₀.1, hM₀.2.1, hM₀.2.2, hN⟩

theorem wcpa_dj_lus_am_component_points : ∀ (κ : Type u) [Field κ] [IsAlgClosed κ] (Y : Scheme.{u}) (c : Y ⟶ Spec (.of κ)), wcpaDjSemistable c → ∀ (N : ℕ) (x : Fin N → (Spec (.of κ) ⟶ Y)), (∀ i, x i ≫ c = 𝟙 _) → ∀ D ∈ irreducibleComponents Y, ∃ t : Fin 3 → (Spec (.of κ) ⟶ Y), (∀ b, t b ≫ c = 𝟙 _) ∧ Function.Injective (fun b => t b (IsLocalRing.closedPoint κ)) ∧ (∀ b, t b (IsLocalRing.closedPoint κ) ∈ D) ∧ (∀ b, ∀ D' ∈ irreducibleComponents Y, D' ≠ D → t b (IsLocalRing.closedPoint κ) ∉ D') ∧ (∀ b i, t b (IsLocalRing.closedPoint κ) ≠ x i (IsLocalRing.closedPoint κ)) ∧ (∀ b, ∃ V : Y.Opens, t b (IsLocalRing.closedPoint κ) ∈ V ∧ SmoothOfRelativeDimension 1 (V.ι ≫ c)) :=
by
  intro κ _ _ Y c hss N x hx D hD
  classical

  have s2 : ∀ (O : Type u) [CommRing O] [IsLocalRing O] [IsNoetherianRing O],
      Subsingleton (PrimeSpectrum O) → ∀ (K : Type u) [Field K],
      ¬ Nonempty (AdicCompletion (IsLocalRing.maximalIdeal O) O ≃+*
        (MvPowerSeries (Fin 2) K ⧸ Ideal.span
          {(MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin 2) K)})) := by
    intro O _ _ _ hsub K _
    rintro ⟨e⟩
    have hnil : ∀ a ∈ IsLocalRing.maximalIdeal O, IsNilpotent a := by
      intro a ha
      rw [← mem_nilradical, nilradical_eq_sInf, Ideal.mem_sInf]
      intro J hJ
      have h1 : (⟨J, hJ⟩ : PrimeSpectrum O) = IsLocalRing.closedPoint O := Subsingleton.elim _ _
      have h2 : J = IsLocalRing.maximalIdeal O := congrArg PrimeSpectrum.asIdeal h1
      rw [h2]; exact ha
    have hmeq : IsLocalRing.maximalIdeal O = nilradical O :=
      le_antisymm (fun a ha => mem_nilradical.mpr (hnil a ha)) (nilradical_le_prime _)
    obtain ⟨k, hk⟩ := IsNoetherianRing.isNilpotent_nilradical O
    have hk' : IsLocalRing.maximalIdeal O ^ k = ⊥ := by rw [hmeq]; exact hk
    haveI hpre : IsPrecomplete (IsLocalRing.maximalIdeal O) O := by
      refine IsPrecomplete.mk ?_
      intro f hf
      refine ⟨f k, fun n => ?_⟩
      rcases le_total n k with h | h
      · exact hf h
      · have h1 := hf h
        rw [hk', Submodule.bot_smul, SModEq.bot] at h1
        rw [h1]
    have hdich : ∀ z : AdicCompletion (IsLocalRing.maximalIdeal O) O,
        IsUnit z ∨ IsNilpotent z := by
      intro z
      obtain ⟨a, rfl⟩ := AdicCompletion.of_surjective (IsLocalRing.maximalIdeal O) O z
      have ha : AdicCompletion.of (IsLocalRing.maximalIdeal O) O a =
          algebraMap O (AdicCompletion (IsLocalRing.maximalIdeal O) O) a := by
        rw [AdicCompletion.algebraMap_apply]; rfl
      rw [ha]
      by_cases hu : IsUnit a
      · exact Or.inl (hu.map _)
      · have ham : a ∈ IsLocalRing.maximalIdeal O := (IsLocalRing.mem_maximalIdeal a).mpr hu
        exact Or.inr ((hnil a ham).map _)
    set x0 : MvPowerSeries (Fin 2) K ⧸ Ideal.span
        {(MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin 2) K)} :=
      Ideal.Quotient.mk _ (MvPowerSeries.X 0) with hx0
    have hnu : ¬ IsUnit x0 := by
      intro hu
      obtain ⟨b, hb⟩ := hu.exists_right_inv
      obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective b
      rw [hx0, ← map_mul, ← map_one (Ideal.Quotient.mk _), Ideal.Quotient.eq,
        Ideal.mem_span_singleton] at hb
      obtain ⟨q, hq⟩ := hb
      have h := congrArg MvPowerSeries.constantCoeff hq
      simp at h
    have hnn : ¬ IsNilpotent x0 := by
      rintro ⟨j, hj⟩
      rw [hx0, ← map_pow, Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton] at hj
      have h1 : (MvPowerSeries.X 1 : MvPowerSeries (Fin 2) K) ∣ MvPowerSeries.X 0 ^ j :=
        dvd_trans (dvd_mul_left _ _) hj
      have h2 := MvPowerSeries.X_dvd_iff.mp h1 (Finsupp.single 0 j) (by simp)
      rw [MvPowerSeries.coeff_X_pow] at h2
      simp at h2
    rcases hdich (e.symm x0) with h | h
    · apply hnu
      have := h.map e
      rwa [RingEquiv.apply_symm_apply] at this
    · apply hnn
      have := h.map e
      rwa [RingEquiv.apply_symm_apply] at this

  haveI hprop : IsProper c := hss.2.1
  haveI : LocallyOfFiniteType c := IsProper.toLocallyOfFiniteType
  haveI : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian c
  haveI : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace c
  haveI : IsNoetherian Y := {}
  have hfin : (irreducibleComponents Y).Finite :=
    TopologicalSpace.NoetherianSpace.finite_irreducibleComponents
  haveI : JacobsonSpace Y := LocallyOfFiniteType.jacobsonSpace c

  have hDm : Maximal (fun s : Set Y => IsClosed s ∧ IsIrreducible s) D := by
    have hD' := hD
    rw [irreducibleComponents_eq_maximals_closed] at hD'; exact hD'
  have hDc : IsClosed D := hDm.prop.1
  have hDi : IsIrreducible D := hDm.prop.2
  obtain ⟨η, hη⟩ : ∃ η : Y, closure ({η} : Set Y) = D :=
    ⟨hDi.genericPoint, isGenericPoint_def.mp (hDi.isGenericPoint_genericPoint hDc)⟩

  have hsub : Subsingleton (PrimeSpectrum (Y.presheaf.stalk η)) := by
    have key : ∀ p : PrimeSpectrum (Y.presheaf.stalk η), p = IsLocalRing.closedPoint _ := by
      intro p
      have hy : Y.fromSpecStalk η p ⤳ η := by
        have : Y.fromSpecStalk η p ∈ Set.range (Y.fromSpecStalk η) := ⟨p, rfl⟩
        rw [Scheme.range_fromSpecStalk] at this
        exact this
      have h1 : D ⊆ closure {Y.fromSpecStalk η p} := by
        rw [← hη]
        exact closure_minimal (Set.singleton_subset_iff.mpr (specializes_iff_mem_closure.mp hy))
          isClosed_closure
      have h2 : D = closure {Y.fromSpecStalk η p} :=
        hDm.eq_of_le ⟨isClosed_closure, isIrreducible_singleton.closure⟩ h1
      have h3 : Y.fromSpecStalk η p = η := by
        have g1 : IsGenericPoint (Y.fromSpecStalk η p) D := by
          rw [isGenericPoint_def]; exact h2.symm
        have g2 : IsGenericPoint η D := by rw [isGenericPoint_def]; exact hη
        exact g1.eq g2
      apply (Y.fromSpecStalk η).isEmbedding.injective
      rw [Scheme.fromSpecStalk_closedPoint]
      exact h3
    exact ⟨fun a b => (key a).trans (key b).symm⟩

  have hΦ : (asIso (Limits.pullback.fst c (𝟙 (Spec (.of κ))))).symm.hom ≫
      Limits.pullback.snd c (𝟙 (Spec (.of κ))) = c := by
    simp only [Iso.symm_hom, asIso_inv]
    rw [IsIso.inv_comp_eq, Limits.pullback.condition, Category.comp_id]
  have hdich := wcpa_dj_ssp_bw_ns_transport κ (asIso (Limits.pullback.fst c (𝟙 (Spec (.of κ))))).symm
    c (Limits.pullback.snd c (𝟙 (Spec (.of κ)))) hΦ η (hss.2.2 κ (𝟙 _) _)
  obtain ⟨V₀, hηV₀, hV₀⟩ : ∃ W : Y.Opens, η ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ c) := by
    rcases hdich with h | ⟨e, -⟩
    · exact h
    · exact absurd ⟨e⟩ (s2 _ hsub κ)

  have hηnc : ¬ IsClosed ({η} : Set Y) := by
    intro hcl
    set η' : V₀ := ⟨η, hηV₀⟩ with hη'
    have hcl' : IsClosed ({η'} : Set V₀) := by
      have : (V₀.ι : V₀.toScheme ⟶ Y) ⁻¹' {η} = {η'} := by
        ext z
        constructor
        · intro h
          have h' : V₀.ι z = η := h
          exact Subtype.ext h'
        · intro h
          have h' : z = η' := h
          show V₀.ι z = η
          rw [h']
          rfl
      rw [← this]
      exact hcl.preimage V₀.ι.continuous
    have h1 := wc_lfi_smooth_stalk_dim κ V₀ (V₀.ι ≫ c) 1 η' hcl'
    have h2 : ringKrullDim (Y.presheaf.stalk η) = 1 := by
      rw [← ringKrullDim_eq_of_ringEquiv (V₀.stalkIso η').commRingCatIsoToRingEquiv]
      exact_mod_cast h1
    haveI : Unique (PrimeSpectrum (Y.presheaf.stalk η)) :=
      @uniqueOfSubsingleton _ hsub (IsLocalRing.closedPoint _)
    have h3 : ringKrullDim (Y.presheaf.stalk η) = 0 := Order.krullDim_eq_zero_of_unique
    rw [h2] at h3
    exact one_ne_zero h3

  set S : Set Y := Set.range (fun i : Fin N => x i (IsLocalRing.closedPoint κ)) with hS
  have hSf : S.Finite := Set.finite_range _
  have hScl : ∀ s ∈ S, IsClosed ({s} : Set Y) := by
    rintro s ⟨i, rfl⟩
    exact wc_pfam_mc_rational_point_closed κ Y c (x i) (hx i)
  have hηS : η ∉ S := by
    rintro ⟨i, hi⟩
    apply hηnc
    rw [← hi]
    exact wc_pfam_mc_rational_point_closed κ Y c (x i) (hx i)

  obtain ⟨U, hUo, hηU, hUV, hUprop⟩ : ∃ U : Set Y, IsOpen U ∧ η ∈ U ∧ U ⊆ (V₀ : Set Y) ∧
      ∀ y ∈ U, y ∈ D ∧ (∀ D' ∈ irreducibleComponents Y, D' ≠ D → y ∉ D') ∧ y ∉ S := by
    set C : Set (Set Y) := {D' | D' ∈ irreducibleComponents Y ∧ D' ≠ D} with hC
    have hCcl : IsClosed (⋃₀ C) :=
      (hfin.subset (fun D' h => h.1)).isClosed_sUnion
        (fun D' h => isClosed_of_mem_irreducibleComponents D' h.1)
    have hScl' : IsClosed S := by
      have : S = ⋃ s ∈ S, ({s} : Set Y) := by simp
      rw [this]
      exact hSf.isClosed_biUnion hScl
    refine ⟨(V₀ : Set Y) ∩ (⋃₀ C)ᶜ ∩ Sᶜ,
      (V₀.isOpen.inter hCcl.isOpen_compl).inter hScl'.isOpen_compl, ?_, fun y hy => hy.1.1, ?_⟩
    · refine ⟨⟨hηV₀, ?_⟩, hηS⟩
      rintro ⟨D', ⟨hD', hne⟩, hηD'⟩
      apply hne
      have hD'm : Maximal (fun s : Set Y => IsClosed s ∧ IsIrreducible s) D' := by
        rw [irreducibleComponents_eq_maximals_closed] at hD'; exact hD'
      have hsub' : D ⊆ D' := by
        rw [← hη]
        exact closure_minimal (Set.singleton_subset_iff.mpr hηD') hD'm.prop.1
      exact (hDm.eq_of_le hD'm.prop hsub').symm
    · intro y hy
      obtain ⟨⟨_, hyC⟩, hyS⟩ := hy
      refine ⟨?_, ?_, hyS⟩
      · have : y ∈ ⋃₀ irreducibleComponents Y := by
          rw [sUnion_irreducibleComponents]; exact Set.mem_univ y
        obtain ⟨E, hE, hyE⟩ := this
        by_contra hyD
        exact hyC ⟨E, ⟨hE, fun h => hyD (h ▸ hyE)⟩, hyE⟩
      · intro D' hD' hne hyD'
        exact hyC ⟨D', ⟨hD', hne⟩, hyD'⟩

  obtain ⟨y, hyinj, hy⟩ : ∃ y : Fin 3 → Y, Function.Injective y ∧
      ∀ b, y b ∈ U ∧ IsClosed ({y b} : Set Y) := by
    have star : ∀ O : Set Y, IsOpen O → η ∈ O → ∃ z ∈ O, IsClosed ({z} : Set Y) := by
      intro O hO hηO
      have h1 : η ∈ closure (closure ({η} : Set Y) ∩ closedPoints Y) := by
        rw [closure_inter_closedPoints isClosed_closure]
        exact subset_closure rfl
      obtain ⟨z, hzO, hz⟩ := mem_closure_iff.mp h1 O hO hηO
      exact ⟨z, hzO, mem_closedPoints_iff.mp hz.2⟩
    have hne : ∀ z, IsClosed ({z} : Set Y) → η ≠ z := by
      intro z hz h; exact hηnc (h ▸ hz)
    obtain ⟨y0, hy0U, hy0⟩ := star U hUo hηU
    obtain ⟨y1, ⟨hy1U, hy10⟩, hy1⟩ := star (U ∩ {y0}ᶜ) (hUo.inter hy0.isOpen_compl)
      ⟨hηU, hne y0 hy0⟩
    obtain ⟨y2, ⟨⟨hy2U, hy20⟩, hy21⟩, hy2⟩ := star (U ∩ {y0}ᶜ ∩ {y1}ᶜ)
      ((hUo.inter hy0.isOpen_compl).inter hy1.isOpen_compl) ⟨⟨hηU, hne y0 hy0⟩, hne y1 hy1⟩
    simp only [Set.mem_compl_iff, Set.mem_singleton_iff] at hy10 hy20 hy21
    refine ⟨![y0, y1, y2], ?_, ?_⟩
    · intro i j hij
      fin_cases i <;> fin_cases j <;> simp at hij ⊢
      all_goals first | exact hy10 hij | exact hy10 hij.symm | exact hy20 hij | exact hy20 hij.symm | exact hy21 hij | exact hy21 hij.symm
    · intro b
      fin_cases b
      · exact ⟨hy0U, hy0⟩
      · exact ⟨hy1U, hy1⟩
      · exact ⟨hy2U, hy2⟩

  have hsec : ∀ b, ∃ t : Spec (.of κ) ⟶ Y, t ≫ c = 𝟙 _ ∧ t (IsLocalRing.closedPoint κ) = y b :=
    fun b => wc_glc_closed_point_section κ Y c (y b) (hy b).2
  choose t ht1 ht2 using hsec
  refine ⟨t, ht1, ?_, ?_, ?_, ?_, ?_⟩
  · intro b b' h
    have h' : t b (IsLocalRing.closedPoint κ) = t b' (IsLocalRing.closedPoint κ) := h
    rw [ht2, ht2] at h'
    exact hyinj h'
  · intro b
    rw [ht2]
    exact (hUprop (y b) (hy b).1).1
  · intro b D' hD' hne
    rw [ht2]
    exact (hUprop (y b) (hy b).1).2.1 D' hD' hne
  · intro b i h
    rw [ht2] at h
    exact (hUprop (y b) (hy b).1).2.2 ⟨i, h.symm⟩
  · intro b
    refine ⟨V₀, ?_, hV₀⟩
    rw [ht2]
    exact hUV (hy b).1

theorem wcpa_dj_lus_am_smooth_spread : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (Z₀ : Scheme.{u}) (u₀ : Z₀ ⟶ Spec (.of ↥W)), wcpaDjSemistable u₀ → ∀ (y : ↥(Limits.pullback u₀ (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))))) (V : (Limits.pullback u₀ (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))).Opens), y ∈ V → SmoothOfRelativeDimension 1 (V.ι ≫ Limits.pullback.snd u₀ (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) → ∃ V' : Z₀.Opens, Limits.pullback.fst u₀ (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) y ∈ V' ∧ SmoothOfRelativeDimension 1 (V'.ι ≫ u₀) :=
by
  intro Ω _ W Z₀ u₀ hss y V hy hV
  haveI : IsProper u₀ := hss.2.1
  have hlft : LocallyOfFiniteType u₀ := inferInstance
  have hfp : LocallyOfFinitePresentation u₀ :=
    wcpa_dj_mn_flat_fp (Spec (.of ↥W)) Z₀ u₀ hss.1 hlft
  exact wcpa_dj_bsc_smooth_descend (Spec (.of ↥W)) Z₀ u₀ (IsLocalRing.ResidueField ↥W)
    (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) y hss.1 hfp
    ⟨V, hy, hV⟩

theorem wcpa_dj_lus_am_append_sections : ∀ (A : Type u) [CommRing A] [IsLocalRing A] (Z : Scheme.{u}) (u : Z ⟶ Spec (.of A)), IsSeparated u → ∀ (n m : ℕ) (τ₀ : Fin n → (Spec (.of A) ⟶ Z)) (ε : Fin m → (Spec (.of A) ⟶ Z)), wcpaDjSections u n τ₀ → (∀ j, ε j ≫ u = 𝟙 _) → (∀ j, ∃ V : Z.Opens, ε j (IsLocalRing.closedPoint A) ∈ V ∧ SmoothOfRelativeDimension 1 (V.ι ≫ u)) → (∀ j k, j ≠ k → ε j (IsLocalRing.closedPoint A) ≠ ε k (IsLocalRing.closedPoint A)) → (∀ i j, τ₀ i (IsLocalRing.closedPoint A) ≠ ε j (IsLocalRing.closedPoint A)) → wcpaDjSections u (n + m) (Fin.append τ₀ ε) :=
by
  intro A _ _ Z u hsep n m τ₀ ε hsec hε1 hε2 hεne hτε
  haveI := hsep

  have s1 : ∀ (σ' : Spec (.of A) ⟶ Z), σ' ≫ u = 𝟙 _ → ∀ p, u (σ' p) = p := by
    intro σ' h p
    rw [← Scheme.Hom.comp_apply, h]; rfl

  have s2 : ∀ (σ' : Spec (.of A) ⟶ Z), σ' ≫ u = 𝟙 _ → IsClosed (Set.range σ') := by
    intro σ' h
    haveI : IsClosedImmersion (σ' ≫ u) := by rw [h]; infer_instance
    haveI : IsClosedImmersion σ' := IsClosedImmersion.of_comp σ' u
    exact (IsClosedImmersion.isClosedEmbedding σ').isClosed_range

  have SA : ∀ (σ₁ σ₂ : Spec (.of A) ⟶ Z), σ₁ ≫ u = 𝟙 _ → σ₂ ≫ u = 𝟙 _ →
      ∀ p q, σ₁ p = σ₂ q →
        σ₁ (IsLocalRing.closedPoint A) = σ₂ (IsLocalRing.closedPoint A) := by
    intro σ₁ σ₂ h1 h2 p q heq
    have hpq : p = q := by
      rw [← s1 σ₁ h1 p, ← s1 σ₂ h2 q, heq]
    subst hpq
    have hsp : σ₂ p ⤳ σ₂ (IsLocalRing.closedPoint A) :=
      (IsLocalRing.specializes_closedPoint p).map σ₂.continuous
    have hmem : σ₂ (IsLocalRing.closedPoint A) ∈ Set.range σ₁ :=
      hsp.mem_closed (s2 σ₁ h1) ⟨p, heq⟩
    obtain ⟨q', hq'⟩ := hmem
    have hq'm : q' = IsLocalRing.closedPoint A := by
      rw [← s1 σ₁ h1 q', hq']
      exact s1 σ₂ h2 _
    rw [← hq', hq'm]
  refine ⟨?_, ?_, ?_⟩
  · intro a
    induction a using Fin.addCases with
    | left i => rw [Fin.append_left]; exact hsec.1 i
    | right j => rw [Fin.append_right]; exact hε1 j
  · intro a b p q hab heq
    induction a using Fin.addCases with
    | left i =>
      induction b using Fin.addCases with
      | left i' =>
        rw [Fin.append_left, Fin.append_left] at heq
        have hi : i ≠ i' := by
          rintro rfl
          exact hab rfl
        exact hsec.2.1 i i' p q hi heq
      | right j =>
        rw [Fin.append_left, Fin.append_right] at heq
        exact hτε i j (SA (τ₀ i) (ε j) (hsec.1 i) (hε1 j) p q heq)
    | right j =>
      induction b using Fin.addCases with
      | left i =>
        rw [Fin.append_right, Fin.append_left] at heq
        exact hτε i j (SA (ε j) (τ₀ i) (hε1 j) (hsec.1 i) p q heq).symm
      | right j' =>
        rw [Fin.append_right, Fin.append_right] at heq
        have hj : j ≠ j' := by
          rintro rfl
          exact hab rfl
        exact hεne j j' hj (SA (ε j) (ε j') (hε1 j) (hε1 j') p q heq)
  · intro a p
    induction a using Fin.addCases with
    | left i => rw [Fin.append_left]; exact hsec.2.2 i p
    | right j =>
      rw [Fin.append_right]
      obtain ⟨V, hV, hVsm⟩ := hε2 j
      refine ⟨V, ?_, hVsm⟩
      have hsp : ε j p ⤳ ε j (IsLocalRing.closedPoint A) :=
        (IsLocalRing.specializes_closedPoint p).map (ε j).continuous
      exact hsp.mem_open V.isOpen hV

theorem wcpa_dj_lq_vanishing_reduced : ∀ (X : Scheme.{u}) (Z : TopologicalSpace.Closeds X), IsReduced (Scheme.IdealSheafData.vanishingIdeal Z).subscheme :=
by
  intro X Z
  set I := Scheme.IdealSheafData.vanishingIdeal Z with hI
  have hrad : ∀ U : X.affineOpens, _root_.IsReduced (Γ(X, U) ⧸ I.ideal U) := fun U =>
    (Ideal.isRadical_iff_quotient_reduced _).mp
      (by rw [hI, Scheme.IdealSheafData.vanishingIdeal_ideal]; exact PrimeSpectrum.isRadical_vanishingIdeal _)
  have hcov : ∀ i, IsReduced (I.subschemeCover.openCover.X i) := by
    intro i
    haveI : _root_.IsReduced (I.subschemeCover.X i) := hrad i
    have h2 : IsReduced (Spec (I.subschemeCover.X i)) := inferInstance
    exact h2
  exact IsReduced.of_openCover _ I.subschemeCover.openCover

theorem wcpa_dj_lus_am_three_marks_ineq : ∀ (κ : Type u) [Field κ] [IsAlgClosed κ] (Y : Scheme.{u}) (c : Y ⟶ Spec (.of κ)), IsProper c → ∀ (N : ℕ) (τ : Fin N → (Spec (.of κ) ⟶ Y)), (∀ i, τ i ≫ c = 𝟙 _) → (∀ D ∈ irreducibleComponents Y, ∃ f : Fin 3 → Fin N, Function.Injective f ∧ ∀ b, τ (f b) (IsLocalRing.closedPoint κ) ∈ D) → ∀ (K : Type u) [Field K] (s : Spec (.of K) ⟶ Spec (.of κ)) (E : Set ↥(Limits.pullback c s)), E ∈ irreducibleComponents ↥(Limits.pullback c s) → 3 ≤ Nat.card {i : Fin N // ∃ x ∈ E, ∃ p : ↥(Spec (.of K)), Limits.pullback.fst c s x = τ i (s p)} :=
by
  intro κ _ _ Y c hc N τ hτ hcov K _ s E hE
  classical
  haveI := hc
  set F := Limits.pullback.fst c s with hF

  have hfin : (irreducibleComponents Y).Finite := by
    have : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian c
    have : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace c
    have : IsNoetherian Y := {}
    exact TopologicalSpace.NoetherianSpace.finite_irreducibleComponents

  have hirr : ∀ D ∈ irreducibleComponents Y, IsIrreducible (F ⁻¹' D) := by
    intro D hD
    have hDc : IsClosed D := isClosed_of_mem_irreducibleComponents D hD
    have hDi : IsIrreducible D := hD.prop
    let Dc : TopologicalSpace.Closeds Y := ⟨D, hDc⟩
    let I := Scheme.IdealSheafData.vanishingIdeal Dc
    have hrange : Set.range I.subschemeι = D := by
      rw [Scheme.IdealSheafData.range_subschemeι, Scheme.IdealSheafData.coe_support_vanishingIdeal]
      rfl
    haveI : IsReduced I.subscheme := wcpa_dj_lq_vanishing_reduced Y Dc
    haveI : IrreducibleSpace I.subscheme := by
      have hemb := I.subschemeι.isClosedEmbedding.isEmbedding
      let h := hemb.toHomeomorph
      haveI : IrreducibleSpace (Set.range I.subschemeι) :=
        Subtype.irreducibleSpace (by rw [hrange]; exact hDi)
      have h2 := (IrreducibleSpace.isIrreducible_univ (Set.range I.subschemeι)).image h.symm
        h.symm.continuous.continuousOn
      rw [Set.image_univ_of_surjective h.symm.surjective] at h2
      exact (irreducibleSpace_def _).mpr h2
    haveI : AlgebraicGeometry.IsIntegral I.subscheme :=
      isIntegral_of_irreducibleSpace_of_isReduced _
    haveI : LocallyOfFiniteType (I.subschemeι ≫ c) := inferInstance
    haveI hgi : GeometricallyIrreducible (I.subschemeι ≫ c) :=
      wc_geometricallyIrreducible_of_isAlgClosed κ I.subscheme (I.subschemeι ≫ c)
    have h1 : IrreducibleSpace (Limits.pullback (I.subschemeι ≫ c) s : Scheme.{u}) :=
      GeometricallyIrreducible.geometrically_irreducibleSpace s
        (Limits.pullback.fst (I.subschemeι ≫ c) s) (Limits.pullback.snd (I.subschemeι ≫ c) s)
        (IsPullback.of_hasPullback (I.subschemeι ≫ c) s)
    have hq : Set.range (Limits.pullback.map (I.subschemeι ≫ c) s c s I.subschemeι (𝟙 _) (𝟙 _)
        (by simp) (by simp)) = F ⁻¹' D := by
      rw [Scheme.Pullback.range_map, hrange]
      ext x
      simp only [Set.mem_inter_iff, Set.mem_preimage, Set.mem_range]
      exact ⟨fun h => h.1, fun h => ⟨h, _, rfl⟩⟩
    rw [← hq, ← Set.image_univ]
    exact (IrreducibleSpace.isIrreducible_univ _).image _ (Scheme.Hom.continuous _).continuousOn

  have hE' : ∃ D ∈ irreducibleComponents Y, E = F ⁻¹' D := by
    have hEm : Maximal IsIrreducible E := hE
    have hEi : IsIrreducible E := hEm.prop
    let t : Finset (Set ↥(Limits.pullback c s)) :=
      hfin.toFinset.image (fun D : Set ↥Y => ⇑F ⁻¹' D)
    have hcl : ∀ z ∈ t, IsClosed z := by
      intro z hz
      obtain ⟨D, hD, rfl⟩ := Finset.mem_image.mp hz
      exact (isClosed_of_mem_irreducibleComponents D (hfin.mem_toFinset.mp hD)).preimage
        (Scheme.Hom.continuous _)
    have hcv : E ⊆ ⋃₀ ↑t := by
      intro x _
      have : F x ∈ ⋃₀ irreducibleComponents Y := by
        rw [sUnion_irreducibleComponents]; trivial
      obtain ⟨D, hD, hxD⟩ := this
      exact ⟨F ⁻¹' D, Finset.mem_coe.mpr (Finset.mem_image.mpr ⟨D, hfin.mem_toFinset.mpr hD, rfl⟩),
        hxD⟩
    obtain ⟨z, hz, hEz⟩ := (isIrreducible_iff_sUnion_isClosed.mp hEi) t hcl hcv
    obtain ⟨D, hD, rfl⟩ := Finset.mem_image.mp hz
    have hD' := hfin.mem_toFinset.mp hD
    exact ⟨D, hD', hEm.eq_of_le (hirr D hD') hEz⟩

  obtain ⟨D, hD, rfl⟩ := hE'
  obtain ⟨f, hf, hfD⟩ := hcov D hD
  have hpt : ∀ b : Fin 3, ∃ x ∈ F ⁻¹' D, ∃ p : ↥(Spec (.of K)), F x = τ (f b) (s p) := by
    intro b
    let g : Spec (.of K) ⟶ Limits.pullback c s := Limits.pullback.lift (s ≫ τ (f b)) (𝟙 _)
      (by rw [Category.assoc, hτ, Category.comp_id, Category.id_comp])
    let pK : ↥(Spec (.of K)) := IsLocalRing.closedPoint K
    have heq : F (g pK) = τ (f b) (s pK) := by
      have hg : g ≫ F = s ≫ τ (f b) := Limits.pullback.lift_fst _ _ _
      rw [← Scheme.Hom.comp_apply, hg, Scheme.Hom.comp_apply]
    refine ⟨g pK, ?_, pK, heq⟩
    show F (g pK) ∈ D
    rw [heq, Subsingleton.elim (s pK) (IsLocalRing.closedPoint κ)]
    exact hfD b
  choose x hx p hp using hpt
  let φ : Fin 3 → {i : Fin N // ∃ x ∈ F ⁻¹' D, ∃ p : ↥(Spec (.of K)), F x = τ i (s p)} :=
    fun b => ⟨f b, x b, hx b, p b, hp b⟩
  have hφ : Function.Injective φ := fun b b' h => hf (congrArg Subtype.val h)
  have h3 := Nat.card_le_card_of_injective φ hφ
  simpa using h3

theorem wcpa_dj_lus_sm_aux_marking : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω) (Z₀ : Scheme.{u}) (u₀ : Z₀ ⟶ Spec (.of ↥W)) (n : ℕ)
    (τ₀ : Fin n → (Spec (.of ↥W) ⟶ Z₀)), wcpaDjSemistable u₀ → wcpaDjSections u₀ n τ₀ →
    ∃ (m : ℕ) (ε : Fin m → (Spec (.of ↥W) ⟶ Z₀))
      (τκ : Fin (n + m) → (Spec (.of (IsLocalRing.ResidueField ↥W)) ⟶ Limits.pullback u₀
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))))),
      wcpaDjSections u₀ (n + m) (Fin.append τ₀ ε) ∧
      (∀ i, τκ i ≫ Limits.pullback.snd u₀
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) = 𝟙 _) ∧
      (∀ i, τκ i ≫ Limits.pullback.fst u₀
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) =
        Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))) ≫
          Fin.append τ₀ ε i) ∧
      wcpaDjStablePtd (Limits.pullback.snd u₀
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) (n + m) τκ :=
by
  intro Ω _ _ W Z₀ u₀ n τ₀ hss hsec
  classical
  have hpt : ∀ {A B C : Scheme.{u}} {a : A ⟶ B} {b : B ⟶ C} {c : A ⟶ C}, a ≫ b = c →
      ∀ x, b (a x) = c x := by
    intro A B C a b c h x
    rw [← Scheme.Hom.comp_apply, h]

  have hres_surj : Function.Surjective (algebraMap ↥W (IsLocalRing.ResidueField ↥W)) := by
    rw [IsLocalRing.ResidueField.algebraMap_eq]; exact IsLocalRing.residue_surjective
  haveI hκac : IsAlgClosed (IsLocalRing.ResidueField ↥W) := by
    apply IsAlgClosed.of_exists_root
    intro p hmon hirr
    obtain ⟨q, hq, hqdeg, hqmon⟩ :=
      Polynomial.lifts_and_degree_eq_and_monic (Polynomial.map_surjective _ hres_surj p) hmon
    have hdeg : (q.map (algebraMap ↥W Ω)).degree ≠ 0 := by
      rw [hqmon.degree_map, hqdeg]
      exact (Polynomial.degree_pos_of_irreducible hirr).ne'
    obtain ⟨θ, hθ⟩ := IsAlgClosed.exists_root (q.map (algebraMap ↥W Ω)) hdeg
    have hint : IsIntegral ↥W θ := by
      refine ⟨q, hqmon, ?_⟩
      rw [← Polynomial.eval_map]
      exact hθ
    obtain ⟨w, hw⟩ := IsIntegrallyClosed.isIntegral_iff.mp hint
    refine ⟨algebraMap ↥W (IsLocalRing.ResidueField ↥W) w, ?_⟩
    have hqw : q.eval w = 0 := by
      apply IsFractionRing.injective ↥W Ω
      rw [map_zero, ← Polynomial.eval₂_at_apply, ← Polynomial.eval_map, hw]
      exact hθ
    rw [← hq, Polynomial.eval_map, Polynomial.eval₂_at_apply, hqw, map_zero]

  have hρci : IsClosedImmersion
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) :=
    IsClosedImmersion.spec_of_surjective _ hres_surj
  have hρpt : Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))
      (IsLocalRing.closedPoint (IsLocalRing.ResidueField ↥W)) = IsLocalRing.closedPoint ↥W := by
    have : IsLocalHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)) := by
      rw [IsLocalRing.ResidueField.algebraMap_eq]; infer_instance
    exact AlgebraicGeometry.Spec_closedPoint
  have hbc := wcpa_dj_mm_semistable_basechange _ _ _
    (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) u₀ hss
  have hspread := wcpa_dj_lus_am_smooth_spread Ω W Z₀ u₀ hss
  have hhens := wcpa_dj_lus_sm_hensel_section Ω W Z₀ u₀
  generalize Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))) = ρ
    at hρci hρpt hbc hspread hhens ⊢
  haveI := hρci
  haveI hprop : IsProper u₀ := hss.2.1
  haveI hpropκ : IsProper (Limits.pullback.snd u₀ ρ) := hbc.2.1
  have hfst_inj : Function.Injective (Limits.pullback.fst u₀ ρ) :=
    (Limits.pullback.fst u₀ ρ).isClosedEmbedding.injective
  have hfinC : (irreducibleComponents ↥(Limits.pullback u₀ ρ)).Finite := by
    have : IsLocallyNoetherian (Limits.pullback u₀ ρ) :=
      LocallyOfFiniteType.isLocallyNoetherian (Limits.pullback.snd u₀ ρ)
    have : CompactSpace ↥(Limits.pullback u₀ ρ) :=
      QuasiCompact.compactSpace_of_compactSpace (Limits.pullback.snd u₀ ρ)
    have : IsNoetherian (Limits.pullback u₀ ρ) := {}
    exact TopologicalSpace.NoetherianSpace.finite_irreducibleComponents
  haveI : Finite (irreducibleComponents ↥(Limits.pullback u₀ ρ)) := hfinC.to_subtype

  let x : Fin n → (Spec (.of (IsLocalRing.ResidueField ↥W)) ⟶ Limits.pullback u₀ ρ) := fun i =>
    Limits.pullback.lift (ρ ≫ τ₀ i) (𝟙 _)
      (by rw [Category.assoc, hsec.1 i, Category.comp_id, Category.id_comp])
  have hx1 : ∀ i, x i ≫ Limits.pullback.snd u₀ ρ = 𝟙 _ := fun i => Limits.pullback.lift_snd _ _ _
  have hx2 : ∀ i, x i ≫ Limits.pullback.fst u₀ ρ = ρ ≫ τ₀ i := fun i =>
    Limits.pullback.lift_fst _ _ _

  have hpts := fun D : irreducibleComponents ↥(Limits.pullback u₀ ρ) =>
    wcpa_dj_lus_am_component_points (IsLocalRing.ResidueField ↥W) _ (Limits.pullback.snd u₀ ρ)
      hbc n x hx1 D.1 D.2
  choose t ht1 ht2 ht3 ht4 ht5 ht6 using hpts
  obtain ⟨m, ⟨e⟩⟩ : ∃ m : ℕ,
      Nonempty (irreducibleComponents ↥(Limits.pullback u₀ ρ) × Fin 3 ≃ Fin m) :=
    ⟨_, ⟨Finite.equivFin _⟩⟩
  obtain ⟨T, hT⟩ : ∃ T : Fin m → (Spec (.of (IsLocalRing.ResidueField ↥W)) ⟶ Limits.pullback u₀ ρ),
      ∀ j, T j = t (e.symm j).1 (e.symm j).2 := ⟨_, fun _ => rfl⟩

  have hεex : ∀ j : Fin m, ∃ σ : Spec (.of ↥W) ⟶ Z₀, σ ≫ u₀ = 𝟙 _ ∧
      ρ ≫ σ = T j ≫ Limits.pullback.fst u₀ ρ ∧
      ∃ V' : Z₀.Opens, σ (IsLocalRing.closedPoint ↥W) ∈ V' ∧
        SmoothOfRelativeDimension 1 (V'.ι ≫ u₀) := by
    intro j
    obtain ⟨V, hV, hVsm⟩ := ht6 (e.symm j).1 (e.symm j).2
    obtain ⟨V', hV'1, hV'2⟩ := hspread _ V hV hVsm
    obtain ⟨σ, hσ1, hσ2⟩ := hhens V' hV'2 (T j ≫ Limits.pullback.fst u₀ ρ)
      (by rw [hT]; exact hV'1)
      (by rw [Category.assoc, Limits.pullback.condition, ← Category.assoc, hT, ht1,
        Category.id_comp])
    refine ⟨σ, hσ1, hσ2, V', ?_, hV'2⟩
    have h := hpt hσ2 (IsLocalRing.closedPoint (IsLocalRing.ResidueField ↥W))
    rw [hρpt] at h
    rw [h, hT]
    exact hV'1
  choose ε hε1 hε2 hε3 using hεex

  have hεpt : ∀ j, ε j (IsLocalRing.closedPoint ↥W) =
      Limits.pullback.fst u₀ ρ (T j (IsLocalRing.closedPoint (IsLocalRing.ResidueField ↥W))) := by
    intro j
    have h := hpt (hε2 j) (IsLocalRing.closedPoint (IsLocalRing.ResidueField ↥W))
    rw [hρpt] at h
    rw [h]
    exact (hpt rfl _).symm
  have hτpt : ∀ i, τ₀ i (IsLocalRing.closedPoint ↥W) =
      Limits.pullback.fst u₀ ρ (x i (IsLocalRing.closedPoint (IsLocalRing.ResidueField ↥W))) := by
    intro i
    have h1 := hpt (hx2 i) (IsLocalRing.closedPoint (IsLocalRing.ResidueField ↥W))
    have h2 := hpt (a := ρ) (b := τ₀ i) rfl (IsLocalRing.closedPoint (IsLocalRing.ResidueField ↥W))
    rw [hρpt] at h2
    rw [h1, ← h2]
  have hTne : ∀ j k, j ≠ k → T j (IsLocalRing.closedPoint (IsLocalRing.ResidueField ↥W)) ≠
      T k (IsLocalRing.closedPoint (IsLocalRing.ResidueField ↥W)) := by
    intro j k hjk heq
    rw [hT, hT] at heq
    by_cases hD : (e.symm j).1 = (e.symm k).1
    · have hb : (e.symm j).2 ≠ (e.symm k).2 := by
        intro hb
        exact hjk (e.symm.injective (Prod.ext hD hb))
      rw [hD] at heq
      exact hb (ht2 (e.symm k).1 heq)
    · apply ht4 (e.symm j).1 (e.symm j).2 (e.symm k).1.1 (e.symm k).1.2
        (fun h => hD (Subtype.ext h).symm)
      rw [heq]
      exact ht3 (e.symm k).1 (e.symm k).2
  have hεne : ∀ j k, j ≠ k →
      ε j (IsLocalRing.closedPoint ↥W) ≠ ε k (IsLocalRing.closedPoint ↥W) := by
    intro j k hjk h
    rw [hεpt, hεpt] at h
    exact hTne j k hjk (hfst_inj h)
  have hτεne : ∀ i j, τ₀ i (IsLocalRing.closedPoint ↥W) ≠ ε j (IsLocalRing.closedPoint ↥W) := by
    intro i j h
    rw [hτpt, hεpt, hT] at h
    exact ht5 (e.symm j).1 (e.symm j).2 i (hfst_inj h).symm

  have hA : wcpaDjSections u₀ (n + m) (Fin.append τ₀ ε) :=
    wcpa_dj_lus_am_append_sections ↥W Z₀ u₀ inferInstance n m τ₀ ε hsec hε1 hε3 hεne hτεne

  let τκ : Fin (n + m) → (Spec (.of (IsLocalRing.ResidueField ↥W)) ⟶ Limits.pullback u₀ ρ) :=
    fun i => Limits.pullback.lift (ρ ≫ Fin.append τ₀ ε i) (𝟙 _)
      (by rw [Category.assoc, hA.1 i, Category.comp_id, Category.id_comp])
  have hB : ∀ i, τκ i ≫ Limits.pullback.snd u₀ ρ = 𝟙 _ := fun i => Limits.pullback.lift_snd _ _ _
  have hC : ∀ i, τκ i ≫ Limits.pullback.fst u₀ ρ = ρ ≫ Fin.append τ₀ ε i := fun i =>
    Limits.pullback.lift_fst _ _ _
  refine ⟨m, ε, τκ, hA, hB, hC, hbc, ?_, ?_⟩
  ·
    refine ⟨hB, ?_, ?_⟩
    · intro i j p q hij h
      apply hA.2.1 i j (ρ p) (ρ q) hij
      have h1 := congrArg (Limits.pullback.fst u₀ ρ) h
      rw [hpt (hC i) p, hpt (hC j) q, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at h1
      exact h1
    · intro i p
      obtain ⟨V, hV, hVsm⟩ := hA.2.2 i (ρ p)
      refine ⟨Limits.pullback.fst u₀ ρ ⁻¹ᵁ V, ?_, ?_⟩
      · show Limits.pullback.fst u₀ ρ (τκ i p) ∈ V
        rw [hpt (hC i) p, Scheme.Hom.comp_apply]
        exact hV
      · have h1 : IsPullback (Limits.pullback.fst u₀ ρ ∣_ V) (Limits.pullback.fst u₀ ρ ⁻¹ᵁ V).ι
            V.ι (Limits.pullback.fst u₀ ρ) := isPullback_morphismRestrict _ V
        have h2 := h1.paste_vert (IsPullback.of_hasPullback u₀ ρ)
        exact MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension 1) h2 hVsm
  ·
    intro K _ _ s E hE _
    have hcover : ∀ D ∈ irreducibleComponents ↥(Limits.pullback u₀ ρ), ∃ f : Fin 3 → Fin (n + m),
        Function.Injective f ∧
          ∀ b, τκ (f b) (IsLocalRing.closedPoint (IsLocalRing.ResidueField ↥W)) ∈ D := by
      intro D hD
      refine ⟨fun b => Fin.natAdd n (e (⟨D, hD⟩, b)), ?_, ?_⟩
      · intro b b' hbb'
        have h1 := e.injective (Fin.natAdd_injective m n hbb')
        exact congrArg Prod.snd h1
      · intro b
        have hτT : τκ (Fin.natAdd n (e (⟨D, hD⟩, b))) = T (e (⟨D, hD⟩, b)) := by
          apply Limits.pullback.hom_ext
          · rw [hC, Fin.append_right, hε2]
          · rw [hB, hT, ht1]
        show τκ (Fin.natAdd n (e (⟨D, hD⟩, b))) _ ∈ D
        rw [hτT, hT, Equiv.symm_apply_apply]
        exact ht3 ⟨D, hD⟩ b
    have h3 := wcpa_dj_lus_am_three_marks_ineq (IsLocalRing.ResidueField ↥W) _
      (Limits.pullback.snd u₀ ρ) inferInstance (n + m) τκ hB hcover K s E hE
    exact le_trans h3 (Nat.le_add_left _ _)

theorem wcpa_dj_lus_cvs_fibre_topology : ∀ (K : Type u) [Field K] [IsAlgClosed K] (R : ValuationSubring K) (Y : Scheme.{u}) (v : Y ⟶ Spec (.of ↥R)), wcpaDjSemistable v → (∀ E ∈ irreducibleComponents ↥(Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K)))), (E ∩ closure Eᶜ).Finite ∧ ∀ x ∈ E ∩ closure Eᶜ, IsClosed {x}) ∧ (Topology.IsEmbedding (Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K)))) ∧ Set.range (Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K)))) = v ⁻¹' {genericPoint (Spec (.of ↥R))}) ∧ (Topology.IsClosedEmbedding (Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R))))) ∧ Set.range (Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R))))) = v ⁻¹' {IsLocalRing.closedPoint ↥R}) ∧ (irreducibleComponents ↥(Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R)))))).Finite :=
by
  intro K _ _ R Y v hss
  classical
  obtain ⟨_hflat, hprop, hfib⟩ := hss

  have s3 : ∀ (L : Type u) [Field L] (s : Spec (.of L) ⟶ Spec (.of ↥R)),
      TopologicalSpace.NoetherianSpace ↥(Limits.pullback v s) := by
    intro L _ s
    haveI := hprop
    haveI : IsProper (Limits.pullback.snd v s) := inferInstance
    haveI : LocallyOfFiniteType (Limits.pullback.snd v s) := inferInstance
    haveI : QuasiCompact (Limits.pullback.snd v s) := inferInstance
    haveI : IsLocallyNoetherian (Limits.pullback v s) :=
      LocallyOfFiniteType.isLocallyNoetherian (Limits.pullback.snd v s)
    haveI : CompactSpace ↥(Limits.pullback v s) :=
      QuasiCompact.compactSpace_of_compactSpace (Limits.pullback.snd v s)
    haveI : AlgebraicGeometry.IsNoetherian (Limits.pullback v s) := {}
    exact IsNoetherian.noetherianSpace

  have hB : Topology.IsEmbedding (Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K)))) ∧ Set.range (Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K)))) = v ⁻¹' {genericPoint (Spec (.of ↥R))} := by
    haveI : IsPreimmersion (Spec.map (CommRingCat.ofHom (algebraMap ↥R K))) :=
      IsPreimmersion.of_isLocalization (nonZeroDivisors ↥R)
    refine ⟨IsPreimmersion.isEmbedding _, ?_⟩
    have key : ∀ q : ↥(Spec (.of K)), Spec.map (CommRingCat.ofHom (algebraMap ↥R K)) q =
        genericPoint (Spec (.of ↥R)) := by
      intro q
      rw [genericPoint_eq_bot_of_affine]
      apply PrimeSpectrum.ext
      change Ideal.comap (algebraMap ↥R K) q.asIdeal = ⊥
      rw [@Ideal.eq_bot_of_prime _ _ q.asIdeal q.isPrime,
        Ideal.comap_bot_of_injective _ (IsFractionRing.injective ↥R K)]
    have hrange : Set.range (Spec.map (CommRingCat.ofHom (algebraMap ↥R K))) =
        {genericPoint (Spec (.of ↥R))} := by
      ext p
      constructor
      · rintro ⟨q, rfl⟩
        exact key q
      · intro hp
        replace hp : p = _ := hp
        exact ⟨(IsLocalRing.closedPoint K : PrimeSpectrum K), (key _).trans hp.symm⟩
    rw [Scheme.Pullback.range_fst, hrange]

  have hC : Topology.IsClosedEmbedding (Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R))))) ∧ Set.range (Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R))))) = v ⁻¹' {IsLocalRing.closedPoint ↥R} := by
    have hsurj : Function.Surjective (algebraMap ↥R (IsLocalRing.ResidueField ↥R)) := by
      rw [IsLocalRing.ResidueField.algebraMap_eq]
      exact IsLocalRing.residue_surjective
    haveI : IsClosedImmersion
        (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R)))) :=
      IsClosedImmersion.spec_of_surjective _ hsurj
    refine ⟨IsClosedImmersion.isClosedEmbedding _, ?_⟩
    have key : ∀ q : ↥(Spec (.of (IsLocalRing.ResidueField ↥R))),
        Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R))) q =
        IsLocalRing.closedPoint ↥R := by
      intro q
      apply PrimeSpectrum.ext
      change Ideal.comap (algebraMap ↥R (IsLocalRing.ResidueField ↥R)) q.asIdeal =
        IsLocalRing.maximalIdeal ↥R
      rw [@Ideal.eq_bot_of_prime _ _ q.asIdeal q.isPrime, ← RingHom.ker_eq_comap_bot,
        IsLocalRing.ResidueField.algebraMap_eq, IsLocalRing.ker_residue]
    have hrange : Set.range
        (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R)))) =
        {IsLocalRing.closedPoint ↥R} := by
      ext p
      constructor
      · rintro ⟨q, rfl⟩
        exact key q
      · intro hp
        replace hp : p = _ := hp
        exact ⟨(IsLocalRing.closedPoint (IsLocalRing.ResidueField ↥R) :
          PrimeSpectrum (IsLocalRing.ResidueField ↥R)), (key _).trans hp.symm⟩
    rw [Scheme.Pullback.range_fst, hrange]

  have hD : (irreducibleComponents ↥(Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R)))))).Finite := by
    haveI := s3 (IsLocalRing.ResidueField ↥R)
      (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R))))
    exact TopologicalSpace.NoetherianSpace.finite_irreducibleComponents

  have hA : ∀ E ∈ irreducibleComponents ↥(Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K)))), (E ∩ closure Eᶜ).Finite ∧ ∀ x ∈ E ∩ closure Eᶜ, IsClosed {x} := by
    set j := Spec.map (CommRingCat.ofHom (algebraMap ↥R K)) with hj
    haveI := s3 K j
    intro E hE
    have hEcl := isClosed_of_mem_irreducibleComponents E hE

    have hother : ∀ x ∈ closure Eᶜ, ∃ E' ∈ irreducibleComponents ↥(Limits.pullback v j),
        E' ≠ E ∧ x ∈ E' := by
      intro x hx
      have hU : IsClosed (⋃ D' ∈ {D' | D' ∈ irreducibleComponents ↥(Limits.pullback v j) ∧
          D' ≠ E}, D') :=
        (TopologicalSpace.NoetherianSpace.finite_irreducibleComponents.subset
          (fun D' hD' => hD'.1)).isClosed_biUnion
          (fun D' hD' => isClosed_of_mem_irreducibleComponents D' hD'.1)
      have hsubU : Eᶜ ⊆ ⋃ D' ∈ {D' | D' ∈ irreducibleComponents ↥(Limits.pullback v j) ∧
          D' ≠ E}, D' := by
        intro y hy
        obtain ⟨D'', hD'', hyD''⟩ :=
          exists_mem_irreducibleComponents_subset_of_isIrreducible {y} isIrreducible_singleton
        refine Set.mem_biUnion (x := D'') ⟨hD'', ?_⟩ (hyD'' (Set.mem_singleton y))
        intro h
        apply hy
        rw [← h]
        exact hyD'' (Set.mem_singleton y)
      have hxU := closure_minimal hsubU hU hx
      obtain ⟨D', ⟨hD'c, hD'ne⟩, hxD'⟩ := Set.mem_iUnion₂.mp hxU
      exact ⟨D', hD'c, hD'ne, hxD'⟩

    have s6 : ∀ x : ↥(Limits.pullback v j), IsDomain ((Limits.pullback v j).presheaf.stalk x) →
        ∀ E₁ ∈ irreducibleComponents ↥(Limits.pullback v j),
        ∀ E₂ ∈ irreducibleComponents ↥(Limits.pullback v j), x ∈ E₁ → x ∈ E₂ → E₁ = E₂ := by
      intro x hdom E₁ hE₁ E₂ hE₂ hx₁ hx₂
      haveI := hdom
      have claim : ∀ E ∈ irreducibleComponents ↥(Limits.pullback v j), x ∈ E →
          E = closure {(Limits.pullback v j).fromSpecStalk x (genericPoint _)} := by
        intro E hE hxE
        have hEcl := isClosed_of_mem_irreducibleComponents E hE
        have hg := hE.1.isGenericPoint_genericPoint_closure
        rw [hEcl.closure_eq] at hg
        have hgE : closure {hE.1.genericPoint} = E := hg
        have hgx : hE.1.genericPoint ⤳ x := hg.specializes hxE
        have h1 : hE.1.genericPoint ∈ Set.range ((Limits.pullback v j).fromSpecStalk x) := by
          rw [Scheme.range_fromSpecStalk]
          exact hgx
        obtain ⟨q, hq⟩ := h1
        have hξg : (Limits.pullback v j).fromSpecStalk x (genericPoint _) ⤳
            hE.1.genericPoint := by
          rw [← hq]
          exact (genericPoint_specializes q).map ((Limits.pullback v j).fromSpecStalk x).continuous
        have hsub : E ⊆ closure {(Limits.pullback v j).fromSpecStalk x (genericPoint _)} := by
          have h2 := specializes_iff_closure_subset.mp hξg
          rwa [hgE] at h2
        exact ((hE.2 isIrreducible_singleton.closure hsub).antisymm hsub).symm
      rw [claim E₁ hE₁ hx₁, claim E₂ hE₂ hx₂]

    have hclosed : ∀ x ∈ E ∩ closure Eᶜ, IsClosed ({x} : Set ↥(Limits.pullback v j)) := by
      rintro x ⟨hxE, hxcl⟩
      obtain ⟨E', hE', hne, hxE'⟩ := hother x hxcl
      rcases hfib K j x with ⟨W, hW, hWsm⟩ | ⟨e, he⟩
      · exfalso
        haveI := hWsm
        haveI hdomW := wcpa_smooth_stalk_isDomain K W.toScheme (W.ι ≫ Limits.pullback.snd v j) 1
          (⟨x, hW⟩ : W)
        haveI hdom : IsDomain ((Limits.pullback v j).presheaf.stalk x) :=
          MulEquiv.isDomain _ (W.stalkIso (⟨x, hW⟩ : W)).symm.commRingCatIsoToRingEquiv.toMulEquiv
        exact hne (s6 x hdom E' hE' E hE hxE' hxE)
      · have hres := wcpa_dj_nf_node_residue K ((Limits.pullback v j).presheaf.stalk x)
          ((Scheme.ΓSpecIso (.of K)).inv ≫ (Limits.pullback.snd v j).appTop ≫
            (Limits.pullback v j).presheaf.germ ⊤ x trivial).hom ⟨e, he⟩
        have hspec : ∀ y, x ⤳ y → x = y := fun y hxy =>
          wcpa_dj_sfi_rational_generization K _ (Limits.pullback.snd v j) x y hxy hres
        rw [← closure_subset_iff_isClosed]
        intro y hy
        exact (hspec y (specializes_iff_mem_closure.mpr hy)).symm

    have hScl : IsClosed (E ∩ closure Eᶜ) := hEcl.inter isClosed_closure
    obtain ⟨𝒮, h𝒮fin, h𝒮cl, h𝒮irr, h𝒮eq⟩ :=
      TopologicalSpace.NoetherianSpace.exists_finite_set_isClosed_irreducible hScl
    have hsing : ∀ t ∈ 𝒮, t.Finite := by
      intro t ht
      have hg0 := (h𝒮irr t ht).isGenericPoint_genericPoint_closure
      rw [(h𝒮cl t ht).closure_eq] at hg0
      obtain ⟨g, hg⟩ : ∃ g, IsGenericPoint g t := ⟨_, hg0⟩
      have hgS : g ∈ E ∩ closure Eᶜ := by
        rw [h𝒮eq]
        exact Set.mem_sUnion_of_mem hg.mem ht
      have hgcl := hclosed g hgS
      have htg : t = {g} := (show closure {g} = t from hg).symm.trans hgcl.closure_eq
      rw [htg]
      exact Set.finite_singleton g
    refine ⟨?_, hclosed⟩
    rw [h𝒮eq]
    exact h𝒮fin.sUnion hsing
  exact ⟨hA, hB, hC, hD⟩

theorem wcpa_dj_lfc_afc_fibre_nodes_finite : ∀ (S Z : Scheme.{u}) (u : Z ⟶ S),
    wcpaDjSemistable u → ∀ (K : Type u) [Field K] [IsAlgClosed K] (s : Spec (.of K) ⟶ S),
