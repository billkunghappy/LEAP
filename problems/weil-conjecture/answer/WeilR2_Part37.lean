    · rw [Ideal.map_le_iff_le_comap]
      intro w hw
      have : MvPolynomial.C w ∈ 𝔫.comap (algebraMap (MvPolynomial (Fin s) ↥W) R) := by
        rw [Ideal.mem_comap, hSR, MvPolynomial.aeval_C]; exact hI𝔫 (Ideal.mem_map_of_mem _ hw)
      rw [← hQc, Ideal.mem_comap, hSR, MvPolynomial.aeval_C] at this
