      intro x
      rw [e1]
      rfl
    ext y
    rw [RingHom.mem_ker, Ideal.mem_span_singleton']
    have hy : y = U.topIso.inv.hom (U.topIso.hom.hom y) :=
      (CategoryTheory.Iso.hom_inv_id_apply U.topIso y).symm
    constructor
    · intro h0
      have h1 : U.topIso.hom.hom y ∈ RingHom.ker ((ΔU ≫ U.ι).app U).hom := by
        rw [RingHom.mem_ker, key, ← hy, h0]
        exact map_zero _
      rw [hker, Ideal.mem_span_singleton'] at h1
      obtain ⟨b, hb⟩ := h1
