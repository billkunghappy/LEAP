      induction ha using Algebra.adjoin_induction with
      | mem x hx =>
        exact Algebra.subset_adjoin
          (Finset.mem_coe.mpr (Finset.mem_image_of_mem _ (Finset.mem_coe.mp hx)))
      | algebraMap r =>
        rw [← IsScalarTower.algebraMap_apply ↥W A (wcGubGen W A),
          IsScalarTower.algebraMap_apply ↥W Ω (wcGubGen W A)]
        exact Subalgebra.algebraMap_mem _ _
      | add x y _ _ hx hy => rw [map_add]; exact add_mem hx hy
      | mul x y _ _ hx hy => rw [map_mul]; exact mul_mem hx hy
    rw [eq_top_iff]
    intro z _
    obtain ⟨⟨a, m⟩, hz⟩ :=
      IsLocalization.surj (Submonoid.map (algebraMap ↥W A) (nonZeroDivisors ↥W)) z
    obtain ⟨w, hw, hwm⟩ := Submonoid.mem_map.mp m.2
    have hw0 : (w : Ω) ≠ 0 := by
      intro h
      exact nonZeroDivisors.ne_zero hw (Subtype.ext h)
    have hm : algebraMap A (wcGubGen W A) (m : A) = algebraMap Ω (wcGubGen W A) (w : Ω) := by
      rw [← hwm, ← IsScalarTower.algebraMap_apply ↥W A (wcGubGen W A),
        IsScalarTower.algebraMap_apply ↥W Ω (wcGubGen W A)]
      rfl
    have hz' : z = algebraMap A (wcGubGen W A) a * algebraMap Ω (wcGubGen W A) (w : Ω)⁻¹ := by
      rw [← hz, hm, mul_assoc, ← map_mul, mul_inv_cancel₀ hw0, map_one, mul_one]
    rw [hz']
    exact mul_mem (hA a) (Subalgebra.algebraMap_mem _ _)
  have hgen : ∀ b : wcGubGen W A, ∃ n : ℕ, ∃ a : ↥(wcGubBox W A g c),
      algebraMap ↥W (wcGubGen W A) ϖ ^ n * b =
        algebraMap ↥(wcGubBox W A g c) (wcGubGen W A) a := by
    intro b
    obtain ⟨⟨a₀, m⟩, hb⟩ :=
      IsLocalization.surj (Submonoid.map (algebraMap ↥W A) (nonZeroDivisors ↥W)) b
    obtain ⟨w, hw, hwm⟩ := Submonoid.mem_map.mp m.2
    obtain ⟨N, v, hv⟩ := hdiv w (nonZeroDivisors.ne_zero hw)
    refine ⟨N, algebraMap A ↥(wcGubBox W A g c) (algebraMap ↥W A v * a₀), ?_⟩
    have e1 : algebraMap ↥(wcGubBox W A g c) (wcGubGen W A)
        (algebraMap A ↥(wcGubBox W A g c) (algebraMap ↥W A v * a₀)) =
        algebraMap A (wcGubGen W A) (algebraMap ↥W A v * a₀) := rfl
    have e2 : algebraMap A (wcGubGen W A) (m : A) = algebraMap ↥W (wcGubGen W A) w := by
      rw [← hwm, ← IsScalarTower.algebraMap_apply ↥W A (wcGubGen W A)]
    rw [e1, map_mul, ← hb, ← IsScalarTower.algebraMap_apply ↥W A (wcGubGen W A), e2,
