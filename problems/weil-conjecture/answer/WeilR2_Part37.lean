      · rw [hy, add_top] at h; exact ENat.coe_ne_top n h.symm
    obtain ⟨a0, rfl⟩ := ENat.ne_top_iff_exists.mp (fin _ _ _ e0).1
    obtain ⟨k1, rfl⟩ := ENat.ne_top_iff_exists.mp (fin _ _ _ e0).2
    obtain ⟨a', rfl⟩ := ENat.ne_top_iff_exists.mp (fin _ _ _ e').1
    obtain ⟨a1, rfl⟩ := ENat.ne_top_iff_exists.mp (fin _ _ _ e1).1
    obtain ⟨k2, rfl⟩ := ENat.ne_top_iff_exists.mp (fin _ _ _ e1).2
    obtain ⟨a2, rfl⟩ := ENat.ne_top_iff_exists.mp (fin _ _ _ e2).1
    have f0 : a0 + k1 = (c0 - c).toNat := by exact_mod_cast e0
    have f' : a' + k1 = (c' - c).toNat := by exact_mod_cast e'
    have f1 : a1 + k2 = (c1 - c).toNat := by exact_mod_cast e1
    have f2 : a2 + k2 = (c2 - c).toNat := by exact_mod_cast e2
    have t0 : (((c0 - c).toNat : ℕ) : ℤ) = c0 - c := Int.toNat_of_nonneg (by omega)
    have t' : (((c' - c).toNat : ℕ) : ℤ) = c' - c := Int.toNat_of_nonneg (by omega)
    have t1 : (((c1 - c).toNat : ℕ) : ℤ) = c1 - c := Int.toNat_of_nonneg (by omega)
    have t2 : (((c2 - c).toNat : ℕ) : ℤ) = c2 - c := Int.toNat_of_nonneg (by omega)
    have key : a2 + a0 = a1 + a' := by omega
    exact_mod_cast key
  exact arith _ _ _ _ Kr Kq c ct₀ ct' ct₁ ct₂ hcle₀ hcle' hcle₁ hcle₂ hbalχ
    (hr0.symm.trans htot₀) (hr'.symm.trans htot') (hq1.symm.trans htot₁) (hq2.symm.trans htot₂)

