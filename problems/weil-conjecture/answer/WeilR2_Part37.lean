      (RingHom.injective _) p
    let CS := integralClosure (Polynomial k) S
    haveI : Module.Finite (Polynomial k) CS :=
      IsIntegralClosure.finite (Polynomial k) (FractionRing (Polynomial k)) S CS
    let f : CS →ₗ[Polynomial k] FractionRing R :=
      (IsScalarTower.toAlgHom (Polynomial k) S (FractionRing R)).toLinearMap ∘ₗ
        CS.val.toLinearMap
    refine ⟨IsPurelyInseparable.exponent S (FractionRing R), Submodule.map f ⊤,
      Submodule.FG.map f Module.Finite.fg_top, ?_⟩
    intro x hx
