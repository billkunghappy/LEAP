        ext a
        simp [hz]
      have e : Ideal.Quotient.mk I₀ (x - ∑ j, c j • mm j) = Ideal.Quotient.mk I₀ x - ∑ j, cb j • mb j := by
        rw [map_sub, map_sum]
        congr 1
        refine Finset.sum_congr rfl (fun j _ => ?_)
        rw [Algebra.smul_def, Algebra.smul_def, map_mul, hmm j, ← hc j, halg]
      have h1 : Ideal.Quotient.mk I₀ (x - ∑ j, c j • mm j) ∈ (Ideal.span (Set.range z) ⊔ I₀).map (Ideal.Quotient.mk I₀) := by
        rw [e]
        refine Ideal.map_mono le_sup_left ?_
        rw [← hmap]
