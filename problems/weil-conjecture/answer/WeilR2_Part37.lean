      have hg := hE.1.isGenericPoint_genericPoint_closure
      rw [hEcl.closure_eq] at hg
      have hgE : closure {hE.1.genericPoint} = E := hg
      have hgx : hE.1.genericPoint ⤳ x := hg.specializes hxE
      have h1 : hE.1.genericPoint ∈ Set.range ((Limits.pullback u s).fromSpecStalk x) := by
        rw [Scheme.range_fromSpecStalk]
        exact hgx
      obtain ⟨q, hq⟩ := h1
      have hξg : (Limits.pullback u s).fromSpecStalk x (genericPoint _) ⤳
          hE.1.genericPoint := by
        rw [← hq]
        exact (genericPoint_specializes q).map ((Limits.pullback u s).fromSpecStalk x).continuous
      have hsub : E ⊆ closure {(Limits.pullback u s).fromSpecStalk x (genericPoint _)} := by
        have h2 := specializes_iff_closure_subset.mp hξg
        rwa [hgE] at h2
      exact ((hE.2 isIrreducible_singleton.closure hsub).antisymm hsub).symm
    rw [claim E₁ hE₁ hx₁, claim E₂ hE₂ hx₂]
  refine ⟨hfin, ?_⟩
  intro E hE
  have hEcl := isClosed_of_mem_irreducibleComponents E hE

  have hother : ∀ x ∈ closure Eᶜ, ∃ E' ∈ irreducibleComponents ↥(Limits.pullback u s),
      E' ≠ E ∧ x ∈ E' := by
    intro x hx
    have hU : IsClosed (⋃ D' ∈ {D' | D' ∈ irreducibleComponents ↥(Limits.pullback u s) ∧
        D' ≠ E}, D') :=
      (hfin.subset (fun D' hD' => hD'.1)).isClosed_biUnion
        (fun D' hD' => isClosed_of_mem_irreducibleComponents D' hD'.1)
    have hsubU : Eᶜ ⊆ ⋃ D' ∈ {D' | D' ∈ irreducibleComponents ↥(Limits.pullback u s) ∧
        D' ≠ E}, D' := by
      intro y hy
      obtain ⟨D'', hD'', hyD''⟩ :=
        exists_mem_irreducibleComponents_subset_of_isIrreducible {y} isIrreducible_singleton
      refine Set.mem_biUnion (x := D'') ⟨hD'', ?_⟩ (hyD'' (Set.mem_singleton y))
      intro h
      apply hy
      rw [← h]
      exact hyD'' (Set.mem_singleton y)
    have hxU := closure_minimal hsubU hU hx
    obtain ⟨D', ⟨hD'c, hD'ne⟩, hxD'⟩ := Set.mem_iUnion₂.mp hxU
    exact ⟨D', hD'c, hD'ne, hxD'⟩

  have hclosed : ∀ x ∈ E ∩ closure Eᶜ, IsClosed ({x} : Set ↥(Limits.pullback u s)) := by
    rintro x ⟨hxE, hxcl⟩
    obtain ⟨E', hE', hne, hxE'⟩ := hother x hxcl
    rcases hfib K s x with ⟨W, hW, hWsm⟩ | ⟨e, he⟩
    · exfalso
      haveI := hWsm
      haveI hdomW := wcpa_smooth_stalk_isDomain K W.toScheme (W.ι ≫ Limits.pullback.snd u s) 1
        (⟨x, hW⟩ : W)
      haveI hdom : IsDomain ((Limits.pullback u s).presheaf.stalk x) :=
        MulEquiv.isDomain _ (W.stalkIso (⟨x, hW⟩ : W)).symm.commRingCatIsoToRingEquiv.toMulEquiv
      exact hne (s6 x hdom E' hE' E hE hxE' hxE)
    · have hres := wcpa_dj_nf_node_residue K ((Limits.pullback u s).presheaf.stalk x)
        ((Scheme.ΓSpecIso (.of K)).inv ≫ (Limits.pullback.snd u s).appTop ≫
