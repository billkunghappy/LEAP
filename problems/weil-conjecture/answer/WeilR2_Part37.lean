      obtain ⟨w, hw, hwm⟩ := Submonoid.mem_map.mp m.2
      have hc : algebraMap (↥W) Ω w ≠ 0 := IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors hw
      have hmk : IsLocalization.mk' (wcGubGen W A) a m = algebraMap A (wcGubGen W A) a *
