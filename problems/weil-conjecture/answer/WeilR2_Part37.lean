theorem wcpa_dj_lr1k_llcc_rt_residue_iso : ∀ (U A : Scheme.{u}) (R : Type u) [CommRing R] [IsLocalRing R]
    (m : U ⟶ A) (Δ : Spec (.of R) ⟶ U) (π : A ⟶ Spec (.of R)),
    Δ ≫ m ≫ π = 𝟙 _ → IsIso (m.residueFieldMap (Δ (IsLocalRing.closedPoint R))) :=
by
  intro U A R _ _ m Δ π h
  suffices H : ∀ p : ↥(Spec (.of R)), IsIso (m.residueFieldMap (Δ p)) from H _
  intro p
  have hI : IsIso ((Δ ≫ m ≫ π).residueFieldMap p) := by
    generalize Δ ≫ m ≫ π = f at h
    subst h
    rw [Scheme.residueFieldMap_id]
    exact IsIso.id _
  have e1 := Scheme.residueFieldMap_comp Δ (m ≫ π) p
  have e2 := Scheme.residueFieldMap_comp m π (Δ.base p)
  rw [e1, e2] at hI
  have hb := (ConcreteCategory.isIso_iff_bijective _).mp hI
  have i3 : Function.Injective (Δ.residueFieldMap p).hom := RingHom.injective _
  have i2 : Function.Injective (m.residueFieldMap (Δ.base p)).hom := RingHom.injective _
  apply (ConcreteCategory.isIso_iff_bijective _).mpr
  refine ⟨i2, fun w => ?_⟩
  obtain ⟨z, hz⟩ := hb.2 ((Δ.residueFieldMap p).hom w)
  refine ⟨(π.residueFieldMap (m.base (Δ.base p))).hom z, i3 ?_⟩
  exact hz

