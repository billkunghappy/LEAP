      (∀ y', ¬(δ' y' = 0 ∨ (δ' y' = 1 ∧ m' y' = 2)) → I' y' →
        δ' y' ≠ ⊤ ∧ 1 ≤ m' y' ∧ m' y' ≤ δ' y' + 1) →
      (∀ y', ¬(δ' y' = 0 ∨ (δ' y' = 1 ∧ m' y' = 2)) → I' y' →
        δ' y' < δ y₀ ∨ (δ' y' = δ y₀ ∧ m y₀ < m' y')) →
      ((⨆ s : Finset T', ∑ y ∈ s,
