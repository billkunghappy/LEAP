    rw [Algebra.smul_def, ← IsScalarTower.algebraMap_apply]
  · have hR : IsField R := s1 k R hfin hinj
    have hsurj : Function.Surjective (algebraMap R (FractionRing R)) :=
      IsFractionRing.surjective_iff_isField.mpr hR
    obtain ⟨n, s, hs⟩ := Module.Finite.exists_fin (R := Polynomial k) (M := R)
    refine ⟨n, fun i => algebraMap R (FractionRing R) (s i), fun i => isIntegral_algebraMap, ?_⟩
    intro x _
    obtain ⟨r, rfl⟩ := hsurj x
    have hr : r ∈ Submodule.span (Polynomial k) (Set.range s) := hs ▸ Submodule.mem_top
    rw [Submodule.mem_span_range_iff_exists_fun] at hr
    obtain ⟨c, hc⟩ := hr
    refine ⟨c, ?_⟩
    rw [← hc, map_sum]
