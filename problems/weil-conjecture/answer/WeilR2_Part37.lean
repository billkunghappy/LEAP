        haveI : IsIso (ι.app (X.basicOpen (wcCnSigma uX U β))) := Scheme.Hom.isIso_app ι _ hD
        haveI hDred : _root_.IsReduced Γ(X, X.basicOpen (wcCnSigma uX U β)) :=
          isReduced_of_injective (ι.app (X.basicOpen (wcCnSigma uX U β))).hom
            (ConcreteCategory.bijective_of_isIso _).1
        haveI hBred : _root_.IsReduced Γ(X, U) := by
          constructor
          rintro f ⟨n, hn⟩
          have h1 : (X.presheaf.map (homOfLE (X.basicOpen_le (wcCnSigma uX U β))).op).hom f = 0 := by
            apply IsNilpotent.eq_zero
            exact ⟨n, by rw [← map_pow, hn, map_zero]⟩
          obtain ⟨N, hN⟩ :=
            exists_pow_mul_eq_zero_of_res_basicOpen_eq_zero_of_isAffineOpen X hU f
              (wcCnSigma uX U β) h1
          clear h1 hn
          induction N with
          | zero => simpa using hN
          | succ N ih =>
            apply ih
            apply hcan
            rw [← mul_assoc, ← pow_succ']
            exact hN
        letI := TopCat.Presheaf.algebra_section_stalk X.presheaf (⟨x, hxU⟩ : U)
        haveI := hU.isLocalization_stalk ⟨x, hxU⟩
        exact isReduced_localizationPreserves (hU.primeIdealOf ⟨x, hxU⟩).asIdeal.primeCompl _
          inferInstance
      exact isReduced_of_isReduced_stalk X
    exact isIntegral_of_irreducibleSpace_of_isReduced X

  set κ := wcNsrNaKg ι V hη with hκdef
  have hηX : ∀ y : X, ι (genericPoint ↥(wcProjK Ω 1)) ⤳ y := by
    intro y
    have hgen : genericPoint X ∈ Set.range ⇑ι := by
      rw [(genericPoint_spec X).mem_open_set_iff ι.isOpenEmbedding.isOpen_range, Set.univ_inter]
      exact ⟨_, ⟨genericPoint ↥(wcProjK Ω 1), rfl⟩⟩
    obtain ⟨p, hp⟩ := hgen
    have h2 : ι (genericPoint ↥(wcProjK Ω 1)) ⤳ ι p :=
      (genericPoint_specializes p).map ι.continuous
    rw [hp] at h2
    exact h2.trans (genericPoint_specializes y)
  have hgerm : ∀ (y : X) (hyV : y ∈ V) (hy : ι (genericPoint ↥(wcProjK Ω 1)) ⤳ y)
      (h : Γ(X, V)), (wcLr1uGerm ι y hy).hom ((X.presheaf.germ V y hyV).hom h) = κ h := by
    intro y hyV hy h
    have e : X.presheaf.germ V y hyV ≫ wcLr1uGerm ι y hy =
        ι.app V ≫ (wcProjK Ω 1).presheaf.germ (ι ⁻¹ᵁ V) _ hη := by
      unfold wcLr1uGerm
      rw [← Category.assoc, TopCat.Presheaf.germ_stalkSpecializes, Scheme.Hom.germ_stalkMap]
    have := congrArg (fun φ => φ.hom h) e
    exact this
  have hιηV : ι (genericPoint ↥(wcProjK Ω 1)) ∈ V := hη
  have hκinj : Function.Injective κ := by
    have e : ∀ h : Γ(X, V), (ι.stalkMap (genericPoint ↥(wcProjK Ω 1))).hom
        ((X.presheaf.germ V _ hιηV).hom h) = κ h := by
      intro h
      have := congrArg (fun φ => φ.hom h)
        (Scheme.Hom.germ_stalkMap ι V (genericPoint ↥(wcProjK Ω 1)) hη)
      exact this
    intro h1 h2 h12
    apply germ_injective_of_isIntegral X _ hιηV
    apply (ConcreteCategory.bijective_of_isIso (ι.stalkMap (genericPoint ↥(wcProjK Ω 1)))).1
    exact (e h1).trans (h12.trans (e h2).symm)

  let p : Ideal Γ(X, V) :=
    Ideal.comap (X.presheaf.germ V x hxV).hom (IsLocalRing.maximalIdeal (X.presheaf.stalk x))
  haveI hpprime : p.IsPrime := Ideal.comap_isPrime _ _
  have hσV : σ (IsLocalRing.closedPoint ↥W) ∈ V := by rw [hσx]; exact hxV
  have eσ : ⊤ ≤ σ ⁻¹ᵁ V := (Scheme.preimage_eq_top_of_closedPoint_mem σ hσV).ge
  let evR : Γ(X, V) →+* ↥W := (Scheme.ΓSpecIso (.of ↥W)).hom.hom.comp (σ.appLE V ⊤ eσ).hom
  have hbo : ∀ h : Γ(X, V), σ (IsLocalRing.closedPoint ↥W) ∈ X.basicOpen h ↔ IsUnit (evR h) := by
    intro h
    have key := Scheme.basicOpen_appLE σ ⊤ V eσ h
    rw [top_inf_eq] at key
    have H : ∀ z : Spec (.of ↥W), σ z ∈ X.basicOpen h ↔
        z ∈ (Spec (.of ↥W)).basicOpen ((σ.appLE V ⊤ eσ).hom h) := by
      intro z
      rw [key, Scheme.Hom.mem_preimage]
    refine (H (IsLocalRing.closedPoint ↥W)).trans ?_
    rw [basicOpen_eq_of_affine']
    exact (PrimeSpectrum.mem_basicOpen _ _).trans IsLocalRing.notMem_maximalIdeal
  have hmemp : ∀ h : Γ(X, V), evR h ∈ IsLocalRing.maximalIdeal ↥W → h ∈ p := by
    intro h hh
    have h1 : ¬ σ (IsLocalRing.closedPoint ↥W) ∈ X.basicOpen h := by
      rw [hbo]
      exact hh
    rw [hσx, Scheme.mem_basicOpen X h x hxV] at h1
    show (X.presheaf.germ V x hxV).hom h ∈ IsLocalRing.maximalIdeal (X.presheaf.stalk x)
    exact (IsLocalRing.mem_maximalIdeal _).mpr h1
  have hthphi : ∀ w : ↥W,
      evR ((uX.appLE ⊤ V hle).hom ((Scheme.ΓSpecIso (.of ↥W)).inv.hom w)) = w := by
    intro w
    have key : ∀ (Y : Scheme.{u}) (f : Y ⟶ Y), f = 𝟙 Y → ∀ h : (⊤ : Y.Opens) ≤ f ⁻¹ᵁ ⊤,
        f.appLE ⊤ ⊤ h = 𝟙 _ := by
      intro Y f hf h
      subst hf
      exact (Scheme.Hom.appLE_eq_app (𝟙 Y) (U := ⊤)).trans (Scheme.Hom.id_app (X := Y) ⊤)
    have h2 : uX.appLE ⊤ V hle ≫ σ.appLE V ⊤ eσ = 𝟙 _ := by
      rw [Scheme.Hom.appLE_comp_appLE]
      exact key _ _ hσ _
    have h3 := congrArg (fun φ => φ.hom ((Scheme.ΓSpecIso (.of ↥W)).inv.hom w)) h2
    simp only [CommRingCat.hom_comp, CommRingCat.hom_id, RingHom.comp_apply,
      RingHom.id_apply] at h3
    show (Scheme.ΓSpecIso (.of ↥W)).hom.hom ((σ.appLE V ⊤ eσ).hom ((uX.appLE ⊤ V hle).hom
      ((Scheme.ΓSpecIso (.of ↥W)).inv.hom w))) = w
    rw [h3]
    exact (Scheme.ΓSpecIso (.of ↥W)).inv_hom_id_apply w
  have hgCw : ∀ w : ↥W, g (MvPolynomial.C w) =
      (uX.appLE ⊤ V hle).hom ((Scheme.ΓSpecIso (.of ↥W)).inv.hom w) :=
    fun w => congrArg (fun φ => φ w) hgC
  have hevC : ∀ w : ↥W, evR (g (MvPolynomial.C w)) = w := fun w => by
    rw [hgCw]; exact hthphi w
  have hevX : evR (g (MvPolynomial.X 0)) = τ' σ + c := hθ σ eσ hσ hσx

  have hb : g (MvPolynomial.C β) ∈ p := hmemp _ (by rw [hevC]; exact hβm)
  have hf : g (MvPolynomial.X 0) - g (MvPolynomial.C (τ' σ + c)) ∈ p := hmemp _ (by
    rw [map_sub, hevX, hevC, sub_self]; exact Ideal.zero_mem _)
  obtain ⟨hbreg, hfreg⟩ := regpair ↥W Γ(X, V) g hg β (τ' σ + c) hβ0
  haveI : Nontrivial Γ(X, V) := RingHom.domain_nontrivial (X.presheaf.germ V x hxV).hom
  have hb0 : g (MvPolynomial.C β) ≠ 0 := by
    intro h0
    exact one_ne_zero (hbreg 1 (by rw [h0, zero_mul]))
  have hκb0 : κ (g (MvPolynomial.C β)) ≠ 0 :=
    fun h => hb0 (hκinj (h.trans (map_zero κ).symm))
  set u : ↑(wcProjK Ω 1).functionField :=
    κ (g (MvPolynomial.X 0) - g (MvPolynomial.C (τ' σ + c))) / κ (g (MvPolynomial.C β)) with hudef
  have hu : κ (g (MvPolynomial.C β)) * u =
      κ (g (MvPolynomial.X 0) - g (MvPolynomial.C (τ' σ + c))) := mul_div_cancel₀ _ hκb0
  have hcoef := koszul Γ(X, V) _ κ hκinj _ _ p hb hf hbreg hfreg u hu
  obtain ⟨B, hB1, hB2, hB3, hBu⟩ := primeval Γ(X, V) _ κ p u hcoef

  have hy := hηX x
  let xV : V := ⟨x, hxV⟩
  letI : Algebra Γ(X, V) (X.presheaf.stalk (xV : X)) :=
    TopCat.Presheaf.algebra_section_stalk X.presheaf xV
  haveI := hVa.isLocalization_stalk xV
  have hφ : ∀ h : Γ(X, V), (wcLr1uGerm ι x hy).hom
      (algebraMap Γ(X, V) (X.presheaf.stalk (xV : X)) h) = κ h := fun h => hgerm x hxV hy h
  have hdom : ∀ s : X.presheaf.stalk (xV : X),
      B.valuation ((wcLr1uGerm ι x hy).hom s) ≤ 1 ∧
      (s ∈ IsLocalRing.maximalIdeal (X.presheaf.stalk (xV : X)) →
        B.valuation ((wcLr1uGerm ι x hy).hom s) < 1) := by
    intro s
    obtain ⟨⟨a, t⟩, hat⟩ := IsLocalization.surj (hVa.primeIdealOf xV).asIdeal.primeCompl s
    have htu : IsUnit (algebraMap Γ(X, V) (X.presheaf.stalk (xV : X)) (t : Γ(X, V))) :=
      IsLocalization.map_units _ t
    have htp : (t : Γ(X, V)) ∉ p := fun h => (IsLocalRing.mem_maximalIdeal _).mp h htu
    have hvt : B.valuation (κ t) = 1 := hB3 _ htp
    have hsa : B.valuation ((wcLr1uGerm ι x hy).hom s) = B.valuation (κ a) := by
      have := congrArg (fun z => B.valuation ((wcLr1uGerm ι x hy).hom z)) hat
      simp only [map_mul, hφ, hvt, mul_one] at this
      exact this
    refine ⟨?_, fun hs => ?_⟩
    · rw [hsa]; exact hB1 a
    · rw [hsa]
      apply hB2
      show algebraMap Γ(X, V) (X.presheaf.stalk (xV : X)) a ∈
        IsLocalRing.maximalIdeal (X.presheaf.stalk (xV : X))
      rw [← hat]
      exact Ideal.mul_mem_right _ _ hs
  have hκf : κ (g (MvPolynomial.X 0) - g (MvPolynomial.C (τ' σ + c))) =
      κ (g (MvPolynomial.C β)) * u := hu.symm
  refine ⟨B, ⟨hy, fun s => (hdom s).1, fun s hs => (hdom s).2 hs⟩, ?_, ?_, ?_, ?_⟩
  · intro w hw
    exact hB2 (g (MvPolynomial.C w)) (hmemp _ (by rw [hevC]; exact hw))
  · intro h0
    rw [hκf] at h0
    have hu0 : u = 0 := (mul_eq_zero.mp h0).resolve_left hκb0
    rw [hu0, map_zero] at hBu
    exact zero_ne_one hBu
  · exact hκb0
  · show B.valuation (κ (g (MvPolynomial.X 0) - g (MvPolynomial.C (τ' σ + c)))) =
      B.valuation (κ (g (MvPolynomial.C β)))
    rw [hκf, map_mul, hBu, mul_one]

theorem wcpa_dj_lr1k_nsr_na_cut_valuation : ∀ {K O IB IA : Type u} [Field K] [CommRing O]
    [IsLocalRing O] (φ : O →+* K) (bb : IB → K) (aa : IA → K) (s : K),
    (∀ (SB : Finset IB) (SA : Finset IA), ∃ V : ValuationSubring K,
      (∀ o : O, V.valuation (φ o) ≤ 1) ∧
      (∀ o ∈ IsLocalRing.maximalIdeal O, V.valuation (φ o) < 1) ∧
      (∀ i ∈ SB, V.valuation (bb i / s) < 1) ∧ (∀ j ∈ SA, V.valuation (s / aa j) < 1)) →
    ∃ A : ValuationSubring K,
      (∀ o : O, A.valuation (φ o) ≤ 1) ∧
      (∀ o ∈ IsLocalRing.maximalIdeal O, A.valuation (φ o) < 1) ∧
      (∀ i, A.valuation (bb i / s) < 1) ∧ (∀ j, A.valuation (s / aa j) < 1) :=
by
  classical
  intro K O IB IA _ _ _ φ bb aa s h
  choose V hV using h
  let V' : Finset IB × Finset IA → ValuationSubring K := fun d => V d.1 d.2
  let U : Ultrafilter (Finset IB × Finset IA) := Ultrafilter.of Filter.atTop
  have hUle : (U : Filter (Finset IB × Finset IA)) ≤ Filter.atTop := Ultrafilter.of_le _

  have crit : ∀ (W : ValuationSubring K) (x : K), W.valuation x < 1 ↔ (x = 0 ∨ x⁻¹ ∉ W) := by
    intro W x
    by_cases hx : x = 0
    · subst hx; simp
    · rw [Valuation.val_lt_one_iff _ hx, ← not_le, W.valuation_le_one_iff]
      simp [hx]

  let S : Subring K :=
    { carrier := {x | ∀ᶠ d in (U : Filter (Finset IB × Finset IA)), x ∈ V' d}
      mul_mem' := fun {a b} ha hb => (ha.and hb).mono (fun d h => (V' d).mul_mem _ _ h.1 h.2)
      one_mem' := Filter.Eventually.of_forall (fun d => (V' d).one_mem)
      add_mem' := fun {a b} ha hb => (ha.and hb).mono (fun d h => (V' d).add_mem _ _ h.1 h.2)
      zero_mem' := Filter.Eventually.of_forall (fun d => (V' d).zero_mem)
      neg_mem' := fun {a} ha => ha.mono (fun d h => (V' d).neg_mem _ h) }
  let A : ValuationSubring K :=
    { S with
      mem_or_inv_mem' := fun x => (Ultrafilter.eventually_or).mp
        (Filter.Eventually.of_forall (fun d => (V' d).mem_or_inv_mem x)) }
  have hA : ∀ x, x ∈ A ↔ ∀ᶠ d in (U : Filter (Finset IB × Finset IA)), x ∈ V' d :=
    fun x => Iff.rfl

  have T : ∀ x : K, (∀ᶠ d in (U : Filter (Finset IB × Finset IA)), (V' d).valuation x < 1) →
      A.valuation x < 1 := by
    intro x hx
    rw [crit]
    by_cases h0 : x = 0
    · exact Or.inl h0
    · right
      intro hinv
      have h1 : ∀ᶠ d in (U : Filter (Finset IB × Finset IA)), x⁻¹ ∉ V' d :=
        hx.mono (fun d hd => ((crit _ x).mp hd).resolve_left h0)
      obtain ⟨d, hd1, hd2⟩ := (((hA _).mp hinv).and h1).exists
      exact hd2 hd1
  refine ⟨A, ?_, ?_, ?_, ?_⟩
  · intro o
    rw [A.valuation_le_one_iff, hA]
    exact Filter.Eventually.of_forall
      (fun d => ((V' d).valuation_le_one_iff _).mp ((hV d.1 d.2).1 o))
  · intro o ho
    exact T _ (Filter.Eventually.of_forall (fun d => (hV d.1 d.2).2.1 o ho))
  · intro i
    apply T
    have he : ∀ᶠ d in (U : Filter (Finset IB × Finset IA)),
        (({i}, ∅) : Finset IB × Finset IA) ≤ d :=
      Filter.Eventually.filter_mono hUle (Filter.eventually_ge_atTop _)
    refine he.mono (fun d hd => ?_)
    exact (hV d.1 d.2).2.2.1 i (Finset.singleton_subset_iff.mp hd.1)
  · intro j
    apply T
    have he : ∀ᶠ d in (U : Filter (Finset IB × Finset IA)),
        ((∅, {j}) : Finset IB × Finset IA) ≤ d :=
      Filter.Eventually.filter_mono hUle (Filter.eventually_ge_atTop _)
    refine he.mono (fun d hd => ?_)
    exact (hV d.1 d.2).2.2.2 j (Finset.singleton_subset_iff.mp hd.2)

theorem wcpa_dj_lr1k_nsr_na_node_centre : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    [AlgebraicGeometry.IsIntegral (wcProjK Ω 1)]
    (W : ValuationSubring Ω) (C : Scheme.{u}) (γ : C ⟶ wcProjK Ω 1) (X : Scheme.{u})
    (uX : X ⟶ Spec (.of ↥W)) (ι : wcProjK Ω 1 ⟶ X) [QuasiCompact (γ ≫ ι)] [QuasiSeparated (γ ≫ ι)]
    (y₀ : ↥(wcpaDjLkFib W (γ ≫ ι) uX)) (τ : (Spec (.of ↥W) ⟶ X) → ↥W),
    wcNsrNaHyp W γ uX ι y₀ τ →
    ∀ (V : X.Opens) (hle : V ≤ uX ⁻¹ᵁ ⊤) (g : MvPolynomial (Fin 1) ↥W →+* Γ(X, V))
      (τ' : (Spec (.of ↥W) ⟶ X) → ↥W) (c : ↥W),
      wcNsrNaChart W uX (wcpaDjLkImg W (γ ≫ ι) uX y₀) V hle g τ' c →
    ∀ (hη : genericPoint ↥(wcProjK Ω 1) ∈ ι ⁻¹ᵁ V) (σ : Spec (.of ↥W) ⟶ X) (a : ↥W),
      wcpaDjLlPair W uX (wcpaDjLkImg W (γ ≫ ι) uX y₀) σ a →
    ∀ (X₀ : Scheme.{u}) (r₀ : X₀ ⟶ X) (ι₀ : wcProjK Ω 1 ⟶ X₀),
      wcCsdIsBlowup (σ.ker ⊔ wcNcPrincipal (.of ↥W) X uX a) r₀ → ι₀ ≫ r₀ = ι →
      wcpaDjLkModel W (r₀ ≫ uX) ι₀ →
    ∀ B : ValuationSubring (wcProjK Ω 1).functionField,
      wcNsrNaDom B ι (wcpaDjLkImg W (γ ≫ ι) uX y₀) →
      wcNsrNaS ι V hη g (τ' σ + c) ≠ 0 →
      B.valuation (wcNsrNaOm ι V hη g a / wcNsrNaS ι V hη g (τ' σ + c)) < 1 →
      ∃ z : ↥X₀, r₀ z = wcpaDjLkImg W (γ ≫ ι) uX y₀ ∧ wcNsrNaDom B ι₀ z ∧
        ∀ p : ↥(Limits.pullback (r₀ ≫ uX)
            (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))),
          Limits.pullback.fst (r₀ ≫ uX)
            (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) p = z →
          ¬ wcpaDjLkSmAt W (r₀ ≫ uX) p :=
by
  intro Ω _ _ _ W C γ X uX ι _ _ y₀ τ hH V hle g τ' c hch hη σ a hP X₀ r₀ ι₀ hbl hι₀ hM₀ B hDom
    hs0 hlt
  obtain ⟨hW, -, -, -, hM, -, hSm, -⟩ := hH
  obtain ⟨-, hxV, -, hgC, -, hth⟩ := hch
  have hσ : σ ≫ uX = 𝟙 _ := hP.1
  have hσx : σ (IsLocalRing.closedPoint ↥W) = wcpaDjLkImg W (γ ≫ ι) uX y₀ := hP.2.1

  have centre : ∀ {Y N : Scheme.{u}}
      (f : wcProjK Ω 1 ⟶ Y) (j : wcProjK Ω 1 ⟶ N) (ν : N ⟶ Y)
      [UniversallyClosed ν], j ≫ ν = f → ∀ z : ↥Y, wcNsrNaDom B f z →
      ∃ n : ↥N, ν n = z ∧ wcNsrNaDom B j n := by
    intro Y N f j ν _ hjν z hz
    obtain ⟨hy, h1, h2⟩ := hz
    have hmem : ∀ s, (wcLr1uGerm f z hy).hom s ∈ B := fun s =>
      (ValuationSubring.valuation_le_one_iff B _).mp (h1 s)
    let φ : (Y.presheaf.stalk z) →+* B := (wcLr1uGerm f z hy).hom.codRestrict B hmem
    have hφ : ∀ s, ((φ s : B) : (wcProjK Ω 1).functionField) = (wcLr1uGerm f z hy).hom s :=
      fun s => rfl
    have hloc : IsLocalHom φ := by
      refine ⟨fun a ha => ?_⟩
      by_contra hna
      have hm : a ∈ IsLocalRing.maximalIdeal (Y.presheaf.stalk z) :=
        (IsLocalRing.mem_maximalIdeal a).mpr hna
      have h3 : φ a ∈ IsLocalRing.maximalIdeal B :=
        (ValuationSubring.valuation_lt_one_iff B (φ a)).mpr (by rw [hφ]; exact h2 a hm)
      exact ((IsLocalRing.mem_maximalIdeal _).mp h3) ha
    let g : Spec (.of B) ⟶ Y := Spec.map (CommRingCat.ofHom φ) ≫ Y.fromSpecStalk z
    have hgc : g (IsLocalRing.closedPoint B) = z := by
      have : IsLocalHom (CommRingCat.ofHom φ).hom := hloc
      show (Y.fromSpecStalk z) ((Spec.map (CommRingCat.ofHom φ)) (IsLocalRing.closedPoint B)) = z
      rw [Spec_closedPoint, Scheme.fromSpecStalk_closedPoint]
    have hgw : Spec.map (CommRingCat.ofHom (algebraMap B (wcProjK Ω 1).functionField)) ≫ g =
        (wcProjK Ω 1).fromSpecStalk (genericPoint ↥(wcProjK Ω 1)) ≫ f := by
      have e : CommRingCat.ofHom φ ≫ CommRingCat.ofHom (algebraMap B (wcProjK Ω 1).functionField) =
          wcLr1uGerm f z hy := by
        ext s; rfl
      calc Spec.map (CommRingCat.ofHom (algebraMap B (wcProjK Ω 1).functionField)) ≫ g
          = Spec.map (CommRingCat.ofHom φ ≫
              CommRingCat.ofHom (algebraMap B (wcProjK Ω 1).functionField)) ≫
              Y.fromSpecStalk z := by
            rw [Spec.map_comp, Category.assoc]
        _ = Spec.map (Y.presheaf.stalkSpecializes hy ≫ f.stalkMap (genericPoint ↥(wcProjK Ω 1))) ≫
              Y.fromSpecStalk z := by rw [e]; rfl
        _ = (wcProjK Ω 1).fromSpecStalk (genericPoint ↥(wcProjK Ω 1)) ≫ f := by
            rw [Spec.map_comp, Category.assoc, Scheme.SpecMap_stalkSpecializes_fromSpecStalk,
              Scheme.SpecMap_stalkMap_fromSpecStalk]
    have hE : ValuativeCriterion.Existence ν := by
      have h : (ValuativeCriterion.Existence ⊓ @QuasiCompact) ν := by
        rw [← UniversallyClosed.eq_valuativeCriterion]; infer_instance
      exact h.1
    let i₁ : Spec (.of (wcProjK Ω 1).functionField) ⟶ N :=
      (wcProjK Ω 1).fromSpecStalk (genericPoint ↥(wcProjK Ω 1)) ≫ j
    have hsq : i₁ ≫ ν =
        Spec.map (CommRingCat.ofHom (algebraMap B (wcProjK Ω 1).functionField)) ≫ g := by
      rw [hgw]
      show ((wcProjK Ω 1).fromSpecStalk (genericPoint ↥(wcProjK Ω 1)) ≫ j) ≫ ν = _
      rw [Category.assoc, hjν]
    let S : ValuativeCommSq ν := ⟨B, (wcProjK Ω 1).functionField, i₁, g, ⟨hsq⟩⟩
    have := hE S
    let l : Spec (.of B) ⟶ N := S.commSq.lift
    have hl1 : Spec.map (CommRingCat.ofHom (algebraMap B (wcProjK Ω 1).functionField)) ≫ l = i₁ :=
      S.commSq.fac_left
    have hl2 : l ≫ ν = g := S.commSq.fac_right
    refine ⟨l (IsLocalRing.closedPoint B), ?_, ?_⟩
    · have key : ∀ x, (l ≫ ν) x = g x := fun x => by rw [hl2]
      exact (Scheme.Hom.comp_apply l ν _).symm.trans ((key _).trans hgc)
    · have hsp : j (genericPoint ↥(wcProjK Ω 1)) ⤳ l (IsLocalRing.closedPoint B) := by
        let pt : ↥(Spec (.of (wcProjK Ω 1).functionField)) :=
