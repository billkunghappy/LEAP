    have h1 : a - s N ∈ I ^ n := Ideal.pow_le_pow_right hnN ha
    have h2 := s.2 hnN
    rw [SModEq.sub_mem] at h2
    have h3 : s n - s N ∈ I ^ n := by simpa [smul_eq_mul, Ideal.mul_top] using h2
