    intro π X t l P hπ hπm hP h
    rcases ValuationRing.dvd_total (π ^ l) X with h1 | ⟨w, hw⟩
    · exact h1
    · by_cases hwu : IsUnit w
      · obtain ⟨v, rfl⟩ := hwu
        exact ⟨↑v⁻¹, by rw [hw, mul_assoc, Units.mul_inv, mul_one]⟩
      · exfalso
        have h1w : IsUnit (1 - w) :=
