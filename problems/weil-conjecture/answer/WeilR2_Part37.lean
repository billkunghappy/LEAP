theorem wcpa_dj_lr1k_lldf_centre_comap : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (X : Scheme.{u}) (uX : X ⟶ Spec (.of ↥W)) (U : X.Opens) (m : U.toScheme ⟶ wcLldfA ↥W) (τ : Spec (.of ↥W) ⟶ X) (τU : Spec (.of ↥W) ⟶ U.toScheme) (t b : ↥W), IsSeparated uX → τ ≫ uX = 𝟙 _ → IsAffineOpen U → m ≫ wcLldfPiA ↥W = U.ι ≫ uX → τU ≫ U.ι = τ → τU ≫ m = wcLldfEv ↥W t → RingHom.ker τU.appTop.hom = Ideal.span {m.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.X 0 - MvPolynomial.C t))} → (τ.ker ⊔ wcNcPrincipal (.of ↥W) X uX b).comap U.ι = ((wcLldfEv ↥W t).ker ⊔ wcNcPrincipal (.of ↥W) (wcLldfA ↥W) (wcLldfPiA ↥W) b).comap m :=
