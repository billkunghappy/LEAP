        Ideal.map (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W)
          (IsLocalRing.maximalIdeal ↥W) := by
      apply le_antisymm
      · intro f hf
        rw [Ideal.mem_comap] at hf
        have h1 := hPker _ hf
        rw [hcomp] at h1
        have h2 : MvPolynomial.map (IsLocalRing.residue ↥W) f = 0 :=
          IsFractionRing.injective (MvPolynomial (Fin 1) κ) K (h1.trans (map_zero _).symm)
        rw [← IsLocalRing.ker_residue, ← MvPolynomial.ker_map]
        exact h2
      · rw [Ideal.map_le_iff_le_comap]
        intro w hw
        rw [Ideal.mem_comap, Ideal.mem_comap, hβC]
        apply Ideal.mem_map_of_mem
        rw [hq]
        exact Ideal.mem_sup_right (Ideal.mem_map_of_mem _ hw)
    let Q' : ↥(Spec (.of L)) := ⟨Ideal.map lam q.asIdeal, hPprime⟩
    have h1 : Spec.map (CommRingCat.ofHom lam) Q' = q :=
      PrimeSpectrum.ext (by rw [Spec.map_apply]; exact hcomapL)
    have h2 : Spec.map (CommRingCat.ofHom β) Q' = p :=
      PrimeSpectrum.ext (by rw [Spec.map_apply]; exact hcomapβ.trans hp.symm)
    rw [← h1, ← h2, ← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, hf]

theorem wcpa_dj_lr1k_llccmc_second_blowup : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω),
    ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) →
    ∀ (a a'' : ↥W), a ≠ 0 → a ∈ IsLocalRing.maximalIdeal ↥W →
      a'' ≠ 0 → a'' ∈ IsLocalRing.maximalIdeal ↥W →
    ∀ (M' : Scheme.{u}) (r₀ : M' ⟶ Spec (.of (MvPolynomial (Fin 1) ↥W)))
      (c₀ : Spec (.of (wcLlccmcB W a)) ⟶ M') (c₁ : Spec (.of (MvPolynomial (Fin 1) ↥W)) ⟶ M'),
      wcCsdIsBlowup (Scheme.Hom.ker (Spec.map (CommRingCat.ofHom
          (MvPolynomial.eval (fun _ : Fin 1 => (0 : ↥W))))) ⊔
        wcNcPrincipal (.of ↥W) (Spec (.of (MvPolynomial (Fin 1) ↥W)))
          (Spec.map (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W))) a) r₀ →
      IsOpenImmersion c₀ → IsOpenImmersion c₁ →
      c₀ ≫ r₀ = wcLlccmcTheta W a → c₁ ≫ r₀ = wcLlccmcH W a →
      (∀ y : ↥M', y ∈ Set.range c₀ ∨ y ∈ Set.range c₁) →
      (∀ g : ↥(Spec (.of (MvPolynomial (Fin 1) ↥W))),
        g.asIdeal = Ideal.span {MvPolynomial.X 0} → c₁ g ∉ Set.range c₀) →
    ∃ (M₂ : Scheme.{u}) (r₂₀ : M₂ ⟶ M') (d₂ : Spec (.of (wcLlccmcB W a)) ⟶ M₂)
      (d₀ : Spec (.of (wcLlccmcB W a'')) ⟶ M₂) (d₁ : Spec (.of (MvPolynomial (Fin 1) ↥W)) ⟶ M₂),
      wcCsdIsBlowup (Scheme.Hom.ker (Spec.map (CommRingCat.ofHom
          (MvPolynomial.eval (fun _ : Fin 1 => (0 : ↥W)))) ≫ c₁) ⊔ wcNcPrincipal (.of ↥W) M'
        (r₀ ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W))) a'')
        r₂₀ ∧
      IsOpenImmersion d₂ ∧ IsOpenImmersion d₀ ∧ IsOpenImmersion d₁ ∧
      d₂ ≫ r₂₀ = c₀ ∧ d₀ ≫ r₂₀ = wcLlccmcTheta W a'' ≫ c₁ ∧ d₁ ≫ r₂₀ = wcLlccmcH W a'' ≫ c₁ ∧
      (∀ y : ↥M₂, y ∈ Set.range d₂ ∨ y ∈ Set.range d₀ ∨ y ∈ Set.range d₁) ∧
      (∀ y y' : ↥M₂, r₂₀ y = r₂₀ y' → r₂₀ y ∈ Set.range c₀ → y = y') :=
by
  intro Ω _ W hdim a a'' ha0 ham ha''0 ha''m M' r₀ c₀ c₁ hbl0 hc0o hc1o hc0 hc1 hcov hgen
  classical
  haveI := hc0o
  haveI := hc1o

  have hinvhom : ∀ (R : CommRingCat.{u}) (x : R),
      (Scheme.ΓSpecIso R).hom.hom ((Scheme.ΓSpecIso R).inv.hom x) = x := by
    intro R x
    have := congrArg (fun g => g.hom x) (Scheme.ΓSpecIso R).inv_hom_id
    simpa only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_id,
      RingHom.id_apply] using this
  have hhominv : ∀ (R : CommRingCat.{u}) (x : Γ(Spec R, ⊤)),
      (Scheme.ΓSpecIso R).inv.hom ((Scheme.ΓSpecIso R).hom.hom x) = x := by
    intro R x
    have := congrArg (fun g => g.hom x) (Scheme.ΓSpecIso R).hom_inv_id
    simpa only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_id,
      RingHom.id_apply] using this
  have hker0 : RingHom.ker (MvPolynomial.eval (fun _ : Fin 1 => (0 : ↥W))) =
      Ideal.span {MvPolynomial.X 0} := by
    ext p
    rw [RingHom.mem_ker]
    constructor
    · intro h
      have hs : Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 1) ↥W)} =
          Ideal.span (MvPolynomial.X '' Set.univ) := by
        rw [Set.image_univ, Set.range_unique]
        rfl
      rw [hs, MvPolynomial.mem_ideal_span_X_image]
      intro m hm
      refine ⟨0, Set.mem_univ _, ?_⟩
      intro hm0
      have hm' : m = 0 := by
        refine Finsupp.ext (fun i => ?_)
        rw [Fin.fin_one_eq_zero i]
        exact hm0
      subst hm'
      rw [MvPolynomial.mem_support_iff] at hm
      apply hm
      rw [MvPolynomial.eval_zero'] at h
      rw [← h, MvPolynomial.constantCoeff_eq]
    · intro h
      obtain ⟨q, rfl⟩ := Ideal.mem_span_singleton'.mp h
      simp
  have hkerSpec : ∀ (A B : Type u) [CommRing A] [CommRing B] (f : A →+* B) (a : A),
      RingHom.ker f = Ideal.span {a} →
      Scheme.Hom.ker (Spec.map (CommRingCat.ofHom f)) =
        Scheme.IdealSheafData.ofIdealTop (Ideal.span {(Scheme.ΓSpecIso (.of A)).inv.hom a}) := by
    intro A B _ _ f a hf
    rw [Scheme.ker_of_isAffine]
    congr 1
    ext x
    have nat := congrArg (fun g => g.hom x) (Scheme.ΓSpecIso_naturality (CommRingCat.ofHom f))
    simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at nat
    rw [RingHom.mem_ker, Ideal.mem_span_singleton']
    constructor
    · intro hx
      have h1 : f ((Scheme.ΓSpecIso (.of A)).hom.hom x) = 0 := by rw [← nat, hx, map_zero]
      rw [← RingHom.mem_ker, hf, Ideal.mem_span_singleton'] at h1
      obtain ⟨y, hy⟩ := h1
      refine ⟨(Scheme.ΓSpecIso (.of A)).inv.hom y, ?_⟩
