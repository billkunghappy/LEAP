      wcpaDjLlMinExh W γ uX ι (wcpaDjLkImg W (γ ≫ ι) uX y₀) σ a →
    ∀ (X' : Scheme.{u}) (r : X' ⟶ X) (ι' : wcProjK Ω 1 ⟶ X')
      [QuasiCompact (γ ≫ ι')] [QuasiSeparated (γ ≫ ι')],
      wcCsdIsBlowup (σ.ker ⊔ wcNcPrincipal (.of ↥W) X uX a) r → ι' ≫ r = ι →
      wcpaDjLkModel W (r ≫ uX) ι' →
      ∀ V : X.Opens, (V : Set X) = {wcpaDjLkImg W (γ ≫ ι) uX y₀}ᶜ → IsIso (r ∣_ V) →
      ∀ y' : ↥(wcpaDjLkFib W (γ ≫ ι') (r ≫ uX)),
        wcpaDjLkBad ((wcpaDjLkFib W (γ ≫ ι') (r ≫ uX)).presheaf.stalk y') →
        r (wcpaDjLkImg W (γ ≫ ι') (r ≫ uX) y') = wcpaDjLkImg W (γ ≫ ι) uX y₀ →
        wcpaDjLkDelta ((wcpaDjLkFib W (γ ≫ ι') (r ≫ uX)).presheaf.stalk y') <
            wcpaDjLkDelta ((wcpaDjLkFib W (γ ≫ ι) uX).presheaf.stalk y₀) ∨
          (wcpaDjLkDelta ((wcpaDjLkFib W (γ ≫ ι') (r ≫ uX)).presheaf.stalk y') =
              wcpaDjLkDelta ((wcpaDjLkFib W (γ ≫ ι) uX).presheaf.stalk y₀) ∧
            wcpaDjLkBranches ((wcpaDjLkFib W (γ ≫ ι) uX).presheaf.stalk y₀) <
              wcpaDjLkBranches ((wcpaDjLkFib W (γ ≫ ι') (r ≫ uX)).presheaf.stalk y')) :=
by
  intro Ω _ _ W hW hWt C γ hcov hgal X uX ι _ _ hM y₀ hy₀ hSm σ a hP hMin X' r ι' _ _ hbl hι' hM'
    V hV hiso y' hb hi
  by_contra hnot

  have hSm' : wcpaDjLkSmAt W (r ≫ uX) (wcpaDjLkPi W (γ ≫ ι') (r ≫ uX) y') :=
    hMin.1 X' r ι' hbl hι' hM' V hV hiso y' hb hi
  obtain ⟨σ'', a'', hP'', hMin''⟩ :=
    wcpa_dj_lr1k_ll_minimal_exhausting Ω W hW hWt C γ hcov hgal X' (r ≫ uX) ι' hM' y' hb hSm'

  have hP₁ : wcpaDjLlPair W uX (wcpaDjLkImg W (γ ≫ ι) uX y₀) (σ'' ≫ r) (a * a'') := by
    refine ⟨?_, ?_, mul_ne_zero hP.2.2.1 hP''.2.2.1, Ideal.mul_mem_right _ _ hP.2.2.2⟩
    · rw [Category.assoc]; exact hP''.1
    · show r (σ'' (IsLocalRing.closedPoint ↥W)) = _
      rw [hP''.2.1]; exact hi

  have hle := wcpa_dj_lr1k_llmi_compose_le Ω W hW hWt X uX ι hM σ hP.1 a hP.2.2.1 hP.2.2.2
    (wcpaDjLkPi W (γ ≫ ι) uX y₀) hP.2.1.symm hSm X' r ι' hbl hι' hM'
    (wcpaDjLkPi W (γ ≫ ι') (r ≫ uX) y') hSm' (hi.trans hP.2.1.symm) σ'' hP''.1 hP''.2.1 a''

  have hE₁ := wcpa_dj_lr1k_llmi_compose_exhausting Ω W hW hWt C γ hcov hgal X uX ι hM y₀ hy₀ hSm
    σ a hP hMin.1 X' r ι' hbl hι' hM' V hV hiso y' hb hi hnot σ'' a'' hP'' hMin''.1

  have heq := hMin.2 (σ'' ≫ r) (a * a'') hP₁ hle hE₁

  have hunit : IsUnit a'' := by
    have hσ₁ : (σ'' ≫ r) ≫ uX = 𝟙 _ := hP₁.1
    have ha₀ : a ≠ 0 := hP.2.2.1
    generalize σ'' ≫ r = σ₁ at hσ₁ heq
    obtain ⟨U, hU, hxU, -⟩ := exists_isAffineOpen_mem_and_subset
      (x := σ₁ (IsLocalRing.closedPoint ↥W)) (U := ⊤) trivial
    have htop : σ₁ ⁻¹ᵁ U = ⊤ := IsLocalRing.closed_point_mem_iff.mp hxU
    let Ua : X.affineOpens := ⟨U, hU⟩
    let φ := (σ₁.appLE U ⊤ htop.ge).hom
    let ψ := (Scheme.ΓSpecIso (CommRingCat.of ↥W)).inv.hom
    let res := (X.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom
    have hid : ∀ (Y : Scheme.{u}) (e : (⊤ : Y.Opens) ≤ ⊤) z,
        (Y.presheaf.map (homOfLE e).op).hom z = z := by
      intro Y e z
      simp
    have hres : ∀ y, φ (res y) = σ₁.appTop.hom y := by
      intro y
      have := Scheme.Hom.map_appLE σ₁ htop.ge (homOfLE (le_top : U ≤ ⊤)).op
      have h2 := congrArg (fun f => f.hom y) this
      simp only [CommRingCat.hom_comp, RingHom.comp_apply] at h2
      refine h2.trans ?_
      simp only [Scheme.Hom.appLE, Scheme.Hom.appTop, CommRingCat.hom_comp, RingHom.comp_apply]
      exact hid _ _ _
    have htopid : ∀ y, σ₁.appTop.hom (uX.appTop.hom y) = y := by
      intro y
      have h := congrArg Scheme.Hom.appTop hσ₁
      rw [Scheme.Hom.comp_appTop, Scheme.Hom.id_appTop] at h
      have h2 := congrArg (fun f => f.hom y) h
      simpa only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_id,
        RingHom.id_apply] using h2
    have hgen : ∀ c : ↥W, φ (res (uX.appTop.hom (ψ c))) = ψ c := by
      intro c
      rw [hres, htopid]
    have hker : ∀ k ∈ σ₁.ker.ideal Ua, φ k = 0 := by
      intro k hk
      have := Scheme.Hom.ideal_ker_le σ₁ Ua hk
      rw [RingHom.mem_ker] at this
      show (σ₁.app U ≫ (Spec (.of ↥W)).presheaf.map (homOfLE htop.ge).op).hom k = 0
      rw [CommRingCat.hom_comp, RingHom.comp_apply, this, map_zero]
    have hmem : res (uX.appTop.hom (ψ a)) ∈
        (σ₁.ker ⊔ wcNcPrincipal (.of ↥W) X uX (a * a'')).ideal Ua := by
      rw [heq, Scheme.IdealSheafData.ideal_sup]
      apply Ideal.mem_sup_right
      rw [wcNcPrincipal, Scheme.IdealSheafData.ofIdealTop_ideal]
      exact Ideal.mem_map_of_mem _ (Ideal.mem_span_singleton_self _)
    rw [Scheme.IdealSheafData.ideal_sup, Pi.sup_apply, Submodule.mem_sup] at hmem
    obtain ⟨k, hk, s, hs, hks⟩ := hmem
    rw [wcNcPrincipal, Scheme.IdealSheafData.ofIdealTop_ideal, Ideal.map_span, Set.image_singleton,
      Ideal.mem_span_singleton'] at hs
    obtain ⟨t, rfl⟩ := hs
    have h1 := congrArg φ hks
    rw [map_add, hker k hk, zero_add, map_mul] at h1
    change φ t * φ (res (uX.appTop.hom (ψ (a * a'')))) = φ (res (uX.appTop.hom (ψ a))) at h1
    rw [hgen, hgen] at h1
    have h2 := congrArg (Scheme.ΓSpecIso (CommRingCat.of ↥W)).hom.hom h1
    rw [map_mul] at h2
    have hinv : ∀ z : ↥W, (Scheme.ΓSpecIso (CommRingCat.of ↥W)).hom.hom (ψ z) = z := by
      intro z
      show ((Scheme.ΓSpecIso (CommRingCat.of ↥W)).inv ≫
        (Scheme.ΓSpecIso (CommRingCat.of ↥W)).hom).hom z = z
      rw [Iso.inv_hom_id]
      rfl
    rw [hinv, hinv] at h2
    set c := (Scheme.ΓSpecIso (CommRingCat.of ↥W)).hom.hom (φ t)
    have h3 : a * (a'' * c) = a * 1 := by rw [mul_one]; nth_rewrite 2 [← h2]; ring
    have h4 : a'' * c = 1 := mul_left_cancel₀ ha₀ h3
    exact ⟨⟨a'', c, h4, by rw [mul_comm]; exact h4⟩, rfl⟩
  exact (IsLocalRing.mem_maximalIdeal a'').mp hP''.2.2.2 hunit

theorem wcpa_dj_lr1k_ll_gcn_ff_genus_unique : ∀ (κ A₁ A₂ : Type u) [Field κ] [CommRing A₁]
    [IsDomain A₁] [CommRing A₂] [IsDomain A₂] (k₁ : κ →+* A₁) (k₂ : κ →+* A₂) (φ : A₁ ≃+* A₂),
    (∀ a, φ (k₁ a) = k₂ a) → ∀ g₁ g₂ : ℕ,
    (letI : Algebra κ (FractionRing A₁) := ((algebraMap A₁ (FractionRing A₁)).comp k₁).toAlgebra
     wcGcFFGenus κ (FractionRing A₁) g₁) →
    (letI : Algebra κ (FractionRing A₂) := ((algebraMap A₂ (FractionRing A₂)).comp k₂).toAlgebra
     wcGcFFGenus κ (FractionRing A₂) g₂) → g₁ = g₂ :=
by
  classical
  intro κ A₁ A₂ _ _ _ _ _ k₁ k₂ φ hφ g₁ g₂ H₁ H₂

  have s1 : ∀ (K I : Type u) [Field K] [Algebra κ K] (w : I → Additive Kˣ →+ ℤ),
      wcValFamily κ K I w → ∀ (i : I) (c : κ) (hc : algebraMap κ K c ≠ 0),
      w i (Additive.ofMul (Units.mk0 _ hc)) = 0 := by
    intro K I _ _ w hV i c hc
    obtain ⟨-, -, -, hV4⟩ := hV
    have hc0 : c ≠ 0 := by
      rintro rfl
      exact hc (map_zero _)
    have h1 := (hV4 (Units.mk0 _ hc)).mpr ⟨c, rfl⟩ i
    have h2 := (hV4 (Units.mk0 _ hc)⁻¹).mpr ⟨c⁻¹, by simp [map_inv₀]⟩ i
    rw [ofMul_inv, map_neg] at h2
    omega

  have hdir : ∀ (K₁ K₂ I₁ I₂ : Type u) [Field K₁] [Field K₂] [Algebra κ K₁] [Algebra κ K₂]
      (Φ : K₁ ≃ₐ[κ] K₂) (w₁ : I₁ → Additive K₁ˣ →+ ℤ) (w₂ : I₂ → Additive K₂ˣ →+ ℤ),
      wcValFamily κ K₁ I₁ w₁ →
      (∀ μ : Additive K₂ˣ →+ ℤ,
        (∀ a b h : K₂ˣ, (h : K₂) = (a : K₂) + (b : K₂) →
          min (μ (Additive.ofMul a)) (μ (Additive.ofMul b)) ≤ μ (Additive.ofMul h)) →
        (∃ t, μ t = 1) →
        (∀ (c : κ) (hc : algebraMap κ K₂ c ≠ 0), μ (Additive.ofMul (Units.mk0 _ hc)) = 0) →
        ∃ z, μ = w₂ z) →
      ∀ i : I₁, ∃ j : I₂, ∀ x : K₁ˣ,
        w₂ j (Additive.ofMul (Units.map (Φ : K₁ →* K₂) x)) = w₁ i (Additive.ofMul x) := by
    intro K₁ K₂ I₁ I₂ _ _ _ _ Φ w₁ w₂ hV hC i
    have hconst := s1 K₁ I₁ w₁ hV i
    obtain ⟨hV1, -, hV3, -⟩ := hV
    have hUU : ∀ x : K₁ˣ, Units.map (Φ.symm : K₂ →* K₁) (Units.map (Φ : K₁ →* K₂) x) = x := by
      intro x
      ext
      show Φ.symm (Φ (x : K₁)) = x
      exact Φ.symm_apply_apply _
    let μ : Additive K₂ˣ →+ ℤ :=
      (w₁ i).comp (MonoidHom.toAdditive (Units.map (Φ.symm : K₂ →* K₁)))
    have hμ : ∀ y : K₂ˣ, μ (Additive.ofMul y) =
        w₁ i (Additive.ofMul (Units.map (Φ.symm : K₂ →* K₁) y)) := fun y => rfl
    have hmin : ∀ a b h : K₂ˣ, (h : K₂) = (a : K₂) + (b : K₂) →
        min (μ (Additive.ofMul a)) (μ (Additive.ofMul b)) ≤ μ (Additive.ofMul h) := by
      intro a b h hh
      rw [hμ, hμ, hμ]
      apply hV1 i
      show Φ.symm (h : K₂) = Φ.symm (a : K₂) + Φ.symm (b : K₂)
      rw [hh, map_add]
    have hunif : ∃ t, μ t = 1 := by
      obtain ⟨t, ht⟩ := hV3 i
      exact ⟨Additive.ofMul (Units.map (Φ : K₁ →* K₂) t), by rw [hμ, hUU, ht]⟩
    have hcst : ∀ (c : κ) (hc : algebraMap κ K₂ c ≠ 0),
        μ (Additive.ofMul (Units.mk0 _ hc)) = 0 := by
      intro c hc
      have h' : algebraMap κ K₁ c ≠ 0 := by
        intro h0
        apply hc
        rw [← Φ.commutes c, h0, map_zero]
      have he : Units.map (Φ.symm : K₂ →* K₁) (Units.mk0 _ hc) = Units.mk0 _ h' := by
        ext
        show Φ.symm (algebraMap κ K₂ c) = algebraMap κ K₁ c
        exact Φ.symm.commutes c
      rw [hμ, he]
      exact hconst c h'
    obtain ⟨z, hz⟩ := hC μ hmin hunif hcst
    refine ⟨z, fun x => ?_⟩
    rw [← hz, hμ, hUU]

  letI i₁ : Algebra κ (FractionRing A₁) := ((algebraMap A₁ (FractionRing A₁)).comp k₁).toAlgebra
  letI i₂ : Algebra κ (FractionRing A₂) := ((algebraMap A₂ (FractionRing A₂)).comp k₂).toAlgebra
  change wcGcFFGenus κ (FractionRing A₁) g₁ at H₁
  change wcGcFFGenus κ (FractionRing A₂) g₂ at H₂
  let Φ₀ : FractionRing A₁ ≃+* FractionRing A₂ := IsFractionRing.ringEquivOfRingEquiv φ
  have hcomm : ∀ x : κ, Φ₀ (algebraMap κ (FractionRing A₁) x) =
      algebraMap κ (FractionRing A₂) x := by
    intro x
    show Φ₀ (algebraMap A₁ (FractionRing A₁) (k₁ x)) = algebraMap A₂ (FractionRing A₂) (k₂ x)
    rw [IsFractionRing.ringEquivOfRingEquiv_algebraMap, hφ]
  let Φ : FractionRing A₁ ≃ₐ[κ] FractionRing A₂ := AlgEquiv.ofRingEquiv hcomm
  obtain ⟨I₁, w₁, hV₁, hinj₁, hne₁, hC₁, c₁, hRR₁⟩ := H₁
  obtain ⟨I₂, w₂, hV₂, hinj₂, hne₂, hC₂, c₂, hRR₂⟩ := H₂
  have hτex := hdir _ _ I₁ I₂ Φ w₁ w₂ hV₁ hC₂
  have hτ'ex := hdir _ _ I₂ I₁ Φ.symm w₂ w₁ hV₂ hC₁
  choose τ hτ using hτex
  choose τ' hτ' using hτ'ex
  have hUU₁ : ∀ x : (FractionRing A₁)ˣ,
      Units.map (Φ.symm : FractionRing A₂ →* FractionRing A₁)
        (Units.map (Φ : FractionRing A₁ →* FractionRing A₂) x) = x := by
    intro x
    ext
    show Φ.symm (Φ (x : FractionRing A₁)) = x
    exact Φ.symm_apply_apply _
  have hUU₂ : ∀ y : (FractionRing A₂)ˣ,
      Units.map (Φ : FractionRing A₁ →* FractionRing A₂)
        (Units.map (Φ.symm : FractionRing A₂ →* FractionRing A₁) y) = y := by
    intro y
    ext
    show Φ (Φ.symm (y : FractionRing A₂)) = y
    exact Φ.apply_symm_apply _
  have linv : ∀ i, τ' (τ i) = i := by
    intro i
    apply hinj₁
    refine AddMonoidHom.ext fun a => ?_
    obtain ⟨x, rfl⟩ : ∃ x : (FractionRing A₁)ˣ, Additive.ofMul x = a := ⟨Additive.toMul a, rfl⟩
    have h := hτ' (τ i) (Units.map (Φ : FractionRing A₁ →* FractionRing A₂) x)
    rw [hUU₁, hτ] at h
    exact h
  have rinv : ∀ j, τ (τ' j) = j := by
    intro j
    apply hinj₂
    refine AddMonoidHom.ext fun a => ?_
    obtain ⟨y, rfl⟩ : ∃ y : (FractionRing A₂)ˣ, Additive.ofMul y = a := ⟨Additive.toMul a, rfl⟩
    have h := hτ (τ' j) (Units.map (Φ.symm : FractionRing A₂ →* FractionRing A₁) y)
    rw [hUU₂, hτ'] at h
    exact h
  let e : I₁ ≃ I₂ := ⟨τ, τ', linv, rinv⟩

  have hL : ∀ D : I₁ →₀ ℤ, wcRRL κ (FractionRing A₂) I₂ w₂ (Finsupp.equivMapDomain e D) =
      Submodule.map (Φ.toLinearEquiv : FractionRing A₁ →ₗ[κ] FractionRing A₂)
        (wcRRL κ (FractionRing A₁) I₁ w₁ D) := by
    intro D
    unfold wcRRL
    rw [Submodule.map_span]
    congr 1
    ext f'
    constructor
    · rintro ⟨hf', H⟩
      have hf : Φ.symm f' ≠ 0 := (map_ne_zero Φ.symm).mpr hf'
      refine ⟨Φ.symm f', ⟨hf, fun i => ?_⟩, ?_⟩
      · have h1 := H (τ i)
        have hU : Units.map (Φ : FractionRing A₁ →* FractionRing A₂) (Units.mk0 _ hf) =
            Units.mk0 f' hf' := by
          ext
          show Φ (Φ.symm f') = f'
          exact Φ.apply_symm_apply f'
        have h2 := hτ i (Units.mk0 _ hf)
        rw [hU] at h2
        have h3 : (Finsupp.equivMapDomain e D) (τ i) = D i := by
          rw [Finsupp.equivMapDomain_apply]
          exact congrArg D (linv i)
        rw [h2, h3] at h1
        exact h1
      · show Φ (Φ.symm f') = f'
        exact Φ.apply_symm_apply f'
    · rintro ⟨f, ⟨hf, H⟩, rfl⟩
      have hf' : Φ f ≠ 0 := (map_ne_zero Φ).mpr hf
      show ∃ hf' : Φ f ≠ 0, ∀ j, 0 ≤ w₂ j (Additive.ofMul (Units.mk0 (Φ f) hf')) +
        (Finsupp.equivMapDomain e D) j
      refine ⟨hf', fun j => ?_⟩
      have h1 := H (τ' j)
      have hU : Units.map (Φ : FractionRing A₁ →* FractionRing A₂) (Units.mk0 f hf) =
          Units.mk0 (Φ f) hf' := by
        ext
        rfl
      have h2 := hτ (τ' j) (Units.mk0 f hf)
      rw [rinv j, hU] at h2
      rw [Finsupp.equivMapDomain_apply, h2]
      exact h1

  rcases isEmpty_or_nonempty I₁ with hI | ⟨⟨i₀⟩⟩
  · have h1 : g₁ = 0 := hne₁.resolve_left (fun h => h.elim fun i => hI.false i)
    have h2 : g₂ = 0 := hne₂.resolve_left (fun h => h.elim fun j => hI.false (τ' j))
    omega
  · obtain ⟨D, hD⟩ : ∃ D : I₁ →₀ ℤ, D = Finsupp.single i₀ ((max c₁ c₂ : ℕ) : ℤ) := ⟨_, rfl⟩
    have hdeg : D.sum (fun _ k => k) = ((max c₁ c₂ : ℕ) : ℤ) := by
      rw [hD, Finsupp.sum_single_index rfl]
    have hdeg' : (Finsupp.equivMapDomain e D).sum (fun _ k => k) = ((max c₁ c₂ : ℕ) : ℤ) := by
      rw [hD, Finsupp.equivMapDomain_single, Finsupp.sum_single_index rfl]
    obtain ⟨-, h1⟩ := hRR₁ D (by rw [hdeg]; exact_mod_cast le_max_left c₁ c₂)
    obtain ⟨-, h2⟩ := hRR₂ (Finsupp.equivMapDomain e D)
      (by rw [hdeg']; exact_mod_cast le_max_right c₁ c₂)
    rw [hL, LinearEquiv.finrank_map_eq, hdeg'] at h2
    rw [hdeg] at h1
    omega

theorem wcpa_dj_lr1k_ll_gcn_component_genus : ∀ (κ : Type u) [Field κ] [IsAlgClosed κ]
    (Z : Scheme.{u}) (s : Z ⟶ Spec (.of κ)) [IsProper s],
    (∀ z : Z, IsDomain (Z.presheaf.stalk z) ∧ IsIntegrallyClosed (Z.presheaf.stalk z)) →
    topologicalKrullDim Z ≤ ((1 : ℕ) : WithBot ℕ∞) →
    ∀ T ∈ irreducibleComponents Z, ∃ g : ℕ,
      (∀ η : Z, closure {η} = T → wcGcStalkGenus s η g) ∧ ((∃ p, T = {p}) → g = 0) :=
by
  have T1 : ∀ (Z : Scheme.{u}), TopologicalSpace.NoetherianSpace Z → (∀ z : Z, IsDomain (Z.presheaf.stalk z)) → ∀ T ∈ irreducibleComponents Z, IsOpen T := (by
  intro Z hN hdom T hT
  classical
  have hfin := TopologicalSpace.NoetherianSpace.finite_irreducibleComponents (α := Z)
  have hdisj : ∀ T' ∈ irreducibleComponents Z, T' ≠ T → ∀ x ∈ T, x ∉ T' := by
    intro T' hT' hne x hxT hxT'
    obtain ⟨P, hPinj, hPmin⟩ := wcpa_dj_lr1k_ll_db_components_minimal_primes Z x 2 ![T, T']
      (by
        intro i j hij
        fin_cases i <;> fin_cases j
        · rfl
        · exact absurd hij.symm hne
        · exact absurd hij hne
        · rfl)
      (by intro i; fin_cases i; exact hT; exact hT')
      (by intro i; fin_cases i; exact hxT; exact hxT')
    haveI := hdom x
    have h0 := hPmin 0
    have h1 := hPmin 1
    rw [IsDomain.minimalPrimes_eq_singleton_bot] at h0 h1
    exact absurd (hPinj ((Set.mem_singleton_iff.mp h0).trans (Set.mem_singleton_iff.mp h1).symm))
      (by decide)
  have hcl : IsClosed (⋃ T' ∈ {T' ∈ irreducibleComponents Z | T' ≠ T}, T') :=
    (hfin.subset (fun _ h => h.1)).isClosed_biUnion
      (fun T' h => isClosed_of_mem_irreducibleComponents T' h.1)
  have heq : T = (⋃ T' ∈ {T' ∈ irreducibleComponents Z | T' ≠ T}, T')ᶜ := by
    apply Set.Subset.antisymm
    · intro x hxT hxU
      obtain ⟨T', ⟨hT', hne⟩, hxT'⟩ := Set.mem_iUnion₂.mp hxU
      exact hdisj T' hT' hne x hxT hxT'
    · intro x hx
      by_contra hxT
      apply hx
      refine Set.mem_iUnion₂.mpr ⟨irreducibleComponent x,
        ⟨irreducibleComponent_mem_irreducibleComponents x, ?_⟩, mem_irreducibleComponent⟩
      intro h
      apply hxT
      rw [← h]
      exact mem_irreducibleComponent
  rw [heq]
  exact hcl.isOpen_compl)

  have T2 : ∀ (Z : Scheme.{u}) (O : Z.Opens) [IrreducibleSpace O.toScheme], (∀ z : Z, IsDomain (Z.presheaf.stalk z) ∧ IsIntegrallyClosed (Z.presheaf.stalk z)) → IsClosed (O : Set Z) → AlgebraicGeometry.IsIntegral O.toScheme ∧ IsClosedImmersion O.ι ∧ (∀ x : O.toScheme, IsDomain (O.toScheme.presheaf.stalk x) ∧ IsIntegrallyClosed (O.toScheme.presheaf.stalk x)) ∧ closure {O.ι (genericPoint O.toScheme)} = (O : Set Z) ∧ IsField (Z.presheaf.stalk (O.ι (genericPoint O.toScheme))) := (by
  intro Z O _ hst hcl
  have hOst : ∀ x : O.toScheme, IsDomain (O.toScheme.presheaf.stalk x) ∧
      IsIntegrallyClosed (O.toScheme.presheaf.stalk x) := by
    intro x
    let e := (O.stalkIso x).commRingCatIsoToRingEquiv
    haveI := (hst x.1).1
    haveI := (hst x.1).2
    exact ⟨MulEquiv.isDomain _ e.toMulEquiv, IsIntegrallyClosed.of_equiv e.symm⟩
  haveI : ∀ x : O.toScheme, _root_.IsReduced (O.toScheme.presheaf.stalk x) := fun x => by
    haveI := (hOst x).1
    infer_instance
  haveI : AlgebraicGeometry.IsReduced O.toScheme := isReduced_of_isReduced_stalk _
  haveI hint : AlgebraicGeometry.IsIntegral O.toScheme := isIntegral_of_irreducibleSpace_of_isReduced _
  refine ⟨hint, ?_, hOst, ?_, ?_⟩
  · exact IsClosedImmersion.of_isPreimmersion O.ι (by rw [Scheme.Opens.range_ι]; exact hcl)
  · apply Set.Subset.antisymm
    · exact closure_minimal (Set.singleton_subset_iff.mpr (genericPoint O.toScheme).2) hcl
    · intro y hy
      have hg : closure ({genericPoint O.toScheme} : Set O.toScheme) = Set.univ :=
        genericPoint_spec O.toScheme
      have h1 : (⟨y, hy⟩ : O.toScheme) ∈ closure ({genericPoint O.toScheme} : Set O.toScheme) := by
        rw [hg]; trivial
      have h2 := image_closure_subset_closure_image (f := O.ι) O.ι.continuous ⟨_, h1, rfl⟩
      rw [Set.image_singleton] at h2
      exact h2
  · let e := (O.stalkIso (genericPoint O.toScheme)).commRingCatIsoToRingEquiv
    have hF : IsField (O.toScheme.presheaf.stalk (genericPoint O.toScheme)) :=
      Field.toIsField O.toScheme.functionField
    first
      | exact MulEquiv.isField hF e.symm.toMulEquiv
      | exact MulEquiv.isField hF e.toMulEquiv
      | exact MulEquiv.isField e.toMulEquiv hF
      | exact MulEquiv.isField e.symm.toMulEquiv hF
      | exact MulEquiv.isField _ hF e.toMulEquiv)

  have T3 : ∀ (Z : Scheme.{u}) (O : Z.Opens) [IrreducibleSpace O.toScheme], topologicalKrullDim Z ≤ ((1 : ℕ) : WithBot ℕ∞) → (∃ x y : O.toScheme, x ≠ y) → topologicalKrullDim O.toScheme = ((1 : ℕ) : WithBot ℕ∞) := (by
  intro Z O _ hdim ⟨x, y, hxy⟩
  apply le_antisymm
  · exact (topologicalKrullDim_subspace_le Z (O : Set Z)).trans hdim
  · obtain ⟨z, hz⟩ : ∃ z : O.toScheme, z ≠ genericPoint O.toScheme := by
      by_cases h : x = genericPoint O.toScheme
      · exact ⟨y, fun h' => hxy (h.trans h'.symm)⟩
      · exact ⟨x, h⟩
    let a : TopologicalSpace.IrreducibleCloseds O.toScheme :=
      ⟨closure {z}, isIrreducible_singleton.closure, isClosed_closure⟩
    let t : TopologicalSpace.IrreducibleCloseds O.toScheme :=
      ⟨Set.univ, IrreducibleSpace.isIrreducible_univ _, isClosed_univ⟩
    have hat : a < t := lt_of_le_of_ne (Set.subset_univ _) (fun h => hz (by
      have h1 : closure ({z} : Set O.toScheme) = Set.univ :=
        congrArg TopologicalSpace.IrreducibleCloseds.carrier h
      exact (show IsGenericPoint z ⊤ from h1).eq (genericPoint_spec O.toScheme)))
    have h1 : (1 : WithBot ℕ∞) ≤ Order.krullDim (TopologicalSpace.IrreducibleCloseds O.toScheme) :=
      Order.one_le_krullDim_iff.mpr ⟨a, t, hat⟩
    rw [Nat.cast_one]
    exact h1)

  have T4 : ∀ (κ K : Type u) [Field κ] [Field K] (a : κ →+* K), Function.Surjective a → (letI : Algebra κ K := a.toAlgebra; wcGcFFGenus κ K 0) := (by
  intro κ K _ _ a ha
  letI : Algebra κ K := a.toAlgebra
  have hK1 : Module.finrank κ K = 1 := by
    let e : κ ≃ₗ[κ] K := LinearEquiv.ofBijective (Algebra.linearMap κ K) ⟨a.injective, ha⟩
    rw [← e.finrank_eq, Module.finrank_self]
  have hKfd : FiniteDimensional κ K := Module.finite_of_finrank_eq_succ hK1
  refine ⟨PEmpty, fun i => i.elim, ⟨fun i => i.elim, fun f => Set.toFinite _, fun i => i.elim,
    fun f => ⟨fun _ => ?_, fun _ i => i.elim⟩⟩, fun i => i.elim, Or.inr rfl, ?_, 0, ?_⟩
  · obtain ⟨c, hc⟩ := ha (f : K)
    exact ⟨c, hc⟩
  · intro μ _ ⟨t, ht⟩ hc
    exfalso
    obtain ⟨c, hcu⟩ := ha ((Additive.toMul t : Kˣ) : K)
    have hne : algebraMap κ K c ≠ 0 := by
      change a c ≠ 0
      rw [hcu]
      exact (Additive.toMul t).ne_zero
    have h1 := hc c hne
    have h2 : Units.mk0 (algebraMap κ K c) hne = Additive.toMul t := Units.ext hcu
    rw [h2] at h1
    have h3 : μ t = 0 := h1
    rw [ht] at h3
    exact one_ne_zero h3
  · intro D _
    have hD : D = 0 := by ext i; exact i.elim
    have htop : wcRRL κ K PEmpty (fun i => i.elim) D = ⊤ := by
      rw [eq_top_iff]
      intro f _
      by_cases hf : f = 0
      · rw [hf]; exact Submodule.zero_mem _
      · exact Submodule.subset_span ⟨hf, fun i => i.elim⟩
    rw [htop, finrank_top, hK1, hD]
    refine ⟨inferInstance, ?_⟩
    simp)

  have T7 : ∀ (κ : Type u) [Field κ] (Z : Scheme.{u})
    (s : Z ⟶ Spec (.of κ)) (O : Z.Opens) [AlgebraicGeometry.IsIntegral O.toScheme]
    (U : O.toScheme.Opens) [IsDedekindDomain Γ(O.toScheme, U)], IsAffineOpen U → Nonempty U →
    ∃ e : FractionRing Γ(O.toScheme, U) ≃+*
        FractionRing (Z.presheaf.stalk (O.ι (genericPoint O.toScheme))),
      ∀ c : κ, e (wcCurveConst κ O.toScheme (O.ι ≫ s) U c) =
        algebraMap (Z.presheaf.stalk (O.ι (genericPoint O.toScheme)))
          (FractionRing (Z.presheaf.stalk (O.ι (genericPoint O.toScheme))))
          (wcGcKappa s (O.ι (genericPoint O.toScheme)) c) := (by
  intro κ _ Z s O _ U _ hU hUne
  haveI := hUne
  haveI := functionField_isFractionRing_of_isAffineOpen O.toScheme U hU
  have hgU : genericPoint O.toScheme ∈ U := by
    obtain ⟨⟨y, hy⟩⟩ := hUne
    exact ((genericPoint_spec O.toScheme).mem_open_set_iff U.isOpen).mpr ⟨y, trivial, hy⟩
  let e₁ : FractionRing Γ(O.toScheme, U) ≃+* O.toScheme.functionField :=
    (FractionRing.algEquiv Γ(O.toScheme, U) O.toScheme.functionField).toRingEquiv
  let e₂ : O.toScheme.presheaf.stalk (genericPoint O.toScheme) ≃+*
      Z.presheaf.stalk (O.ι (genericPoint O.toScheme)) :=
    (O.stalkIso (genericPoint O.toScheme)).commRingCatIsoToRingEquiv
  haveI : IsDomain (O.toScheme.presheaf.stalk (genericPoint O.toScheme)) :=
    inferInstanceAs (IsDomain O.toScheme.functionField)
  haveI : IsDomain (Z.presheaf.stalk (O.ι (genericPoint O.toScheme))) :=
    MulEquiv.isDomain _ e₂.symm.toMulEquiv
  have hF0 : IsField (O.toScheme.presheaf.stalk (genericPoint O.toScheme)) :=
    Field.toIsField O.toScheme.functionField
  have hF : IsField (Z.presheaf.stalk (O.ι (genericPoint O.toScheme))) := by
    first
      | exact MulEquiv.isField hF0 e₂.symm.toMulEquiv
      | exact MulEquiv.isField hF0 e₂.toMulEquiv
      | exact MulEquiv.isField e₂.toMulEquiv hF0
      | exact MulEquiv.isField e₂.symm.toMulEquiv hF0
      | exact MulEquiv.isField _ hF0 e₂.toMulEquiv
  let e₃ : Z.presheaf.stalk (O.ι (genericPoint O.toScheme)) ≃+*
      FractionRing (Z.presheaf.stalk (O.ι (genericPoint O.toScheme))) :=
    RingEquiv.ofBijective (algebraMap _ _)
      ⟨IsFractionRing.injective _ _, IsFractionRing.surjective_iff_isField.mpr hF⟩
  refine ⟨e₁.trans (e₂.trans e₃), fun c => ?_⟩
  set a : Γ(O.toScheme, U) := (O.toScheme.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom
    (((O.ι ≫ s).appTop.hom.comp (Scheme.ΓSpecIso (CommRingCat.of κ)).inv.hom) c) with ha
  have h0 : wcCurveConst κ O.toScheme (O.ι ≫ s) U c =
      algebraMap Γ(O.toScheme, U) (FractionRing Γ(O.toScheme, U)) a := rfl
  have h1 : e₁ (algebraMap Γ(O.toScheme, U) (FractionRing Γ(O.toScheme, U)) a) =
      algebraMap Γ(O.toScheme, U) O.toScheme.functionField a :=
    (FractionRing.algEquiv Γ(O.toScheme, U) O.toScheme.functionField).commutes a
  have h2 : e₂ (algebraMap Γ(O.toScheme, U) O.toScheme.functionField a) =
      wcGcKappa s (O.ι (genericPoint O.toScheme)) c := by
    apply e₂.symm.injective
    rw [RingEquiv.symm_apply_apply]
    have hinv : (O.stalkIso (genericPoint O.toScheme)).inv = O.ι.stalkMap (genericPoint O.toScheme) :=
      Scheme.Opens.stalkIso_inv _ _
    have hk : wcGcKappa s (O.ι (genericPoint O.toScheme)) c =
        (Z.presheaf.germ ⊤ (O.ι (genericPoint O.toScheme)) trivial).hom
          (s.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of κ)).inv.hom c)) := rfl
    have key := Scheme.Hom.germ_stalkMap_apply O.ι ⊤ (genericPoint O.toScheme) trivial
      (s.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of κ)).inv.hom c))
    show (O.toScheme.presheaf.germ U (genericPoint O.toScheme) hgU).hom a =
      (O.stalkIso (genericPoint O.toScheme)).inv.hom (wcGcKappa s (O.ι (genericPoint O.toScheme)) c)
    rw [hinv, hk]
    erw [key]
    rw [ha, TopCat.Presheaf.germ_res_apply]
    first
      | rfl
      | (rw [Scheme.Hom.comp_appTop]; rfl)
  rw [RingEquiv.trans_apply, RingEquiv.trans_apply, h0, h1, h2]
  rfl)

  have T5 : ∀ (κ : Type u) [Field κ] [IsAlgClosed κ]
    (Z : Scheme.{u}) (s : Z ⟶ Spec (.of κ)) [LocallyOfFiniteType s] (p : Z),
    IsClosed ({p} : Set Z) → IsField (Z.presheaf.stalk p) → Function.Surjective (wcGcKappa s p) := (by
  intro κ _ _ Z s _ p hcl hF
  classical
  obtain ⟨U, hUaff, hpU, -⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp Z.isBasis_affineOpens)
    (show p ∈ (⊤ : Z.Opens) from trivial)
  have hU : IsAffineOpen U := hUaff
  let ψ : κ →+* Γ(Z, U) :=
    (s.appLE ⊤ U le_top).hom.comp (Scheme.ΓSpecIso (CommRingCat.of κ)).inv.hom
  have hft : ψ.FiniteType := by
    have h1 := HasRingHomProperty.appLE @LocallyOfFiniteType s inferInstance
      ⟨⊤, isAffineOpen_top _⟩ ⟨U, hU⟩ le_top
    refine RingHom.FiniteType.comp h1 (RingHom.FiniteType.of_surjective _ ?_)
    intro x
    refine ⟨(Scheme.ΓSpecIso (CommRingCat.of κ)).hom.hom x, ?_⟩
    show ((Scheme.ΓSpecIso (CommRingCat.of κ)).hom ≫ (Scheme.ΓSpecIso (CommRingCat.of κ)).inv).hom x = x
    rw [Iso.hom_inv_id]
    rfl
  letI : Algebra Γ(Z, U) (Z.presheaf.stalk p) := (Z.presheaf.germ U p hpU).hom.toAlgebra
  have hfac : ∀ c, wcGcKappa s p c = algebraMap Γ(Z, U) (Z.presheaf.stalk p) (ψ c) := by
    intro c
    show _ = (Z.presheaf.germ U p hpU).hom
      ((s.app ⊤ ≫ Z.presheaf.map (homOfLE (show U ≤ s ⁻¹ᵁ ⊤ from le_top)).op).hom
        ((Scheme.ΓSpecIso (CommRingCat.of κ)).inv.hom c))
    rw [CommRingCat.hom_comp, RingHom.comp_apply, TopCat.Presheaf.germ_res_apply]
    rfl
  set q := hU.primeIdealOf ⟨p, hpU⟩ with hq
  have hqcl : IsClosed ({q} : Set (PrimeSpectrum Γ(Z, U))) := by
    have : (hU.fromSpec : Spec Γ(Z, U) → Z) ⁻¹' {p} = {q} := by
      ext y
      simp only [Set.mem_preimage, Set.mem_singleton_iff]
      constructor
      · intro hy
        apply hU.fromSpec.isOpenEmbedding.isEmbedding.injective
        rw [hy, hq, hU.fromSpec_primeIdealOf]
      · rintro rfl
        exact hU.fromSpec_primeIdealOf _
    have h2 := hcl.preimage hU.fromSpec.continuous
    rw [this] at h2
    exact h2
  haveI hqmax : q.asIdeal.IsMaximal := (PrimeSpectrum.isClosed_singleton_iff_isMaximal q).mp hqcl
  haveI hloc : IsLocalization.AtPrime (Z.presheaf.stalk p) q.asIdeal :=
    hU.isLocalization_stalk ⟨p, hpU⟩
  have hzero : ∀ a ∈ q.asIdeal, algebraMap Γ(Z, U) (Z.presheaf.stalk p) a = 0 := by
    intro a ha
    by_contra hne
    obtain ⟨b, hb⟩ := hF.mul_inv_cancel hne
    have hu : IsUnit (algebraMap Γ(Z, U) (Z.presheaf.stalk p) a) :=
      ⟨⟨_, b, hb, by rw [mul_comm]; exact hb⟩, rfl⟩
    rw [IsLocalization.AtPrime.isUnit_to_map_iff (Z.presheaf.stalk p) q.asIdeal a] at hu
    exact hu ha

  have hres : ∀ a : Γ(Z, U), ∃ c : κ, a - ψ c ∈ q.asIdeal := by
    let f : κ →+* Γ(Z, U) ⧸ q.asIdeal := (Ideal.Quotient.mk q.asIdeal).comp ψ
    have hf : f.FiniteType := hft.comp_surjective Ideal.Quotient.mk_surjective
    letI : Field (Γ(Z, U) ⧸ q.asIdeal) := Ideal.Quotient.field q.asIdeal
    letI : Algebra κ (Γ(Z, U) ⧸ q.asIdeal) := f.toAlgebra
    haveI : Algebra.FiniteType κ (Γ(Z, U) ⧸ q.asIdeal) := hf
    haveI : Module.Finite κ (Γ(Z, U) ⧸ q.asIdeal) :=
      finite_of_finite_type_of_isJacobsonRing κ (Γ(Z, U) ⧸ q.asIdeal)
    haveI : Algebra.IsIntegral κ (Γ(Z, U) ⧸ q.asIdeal) := Algebra.IsIntegral.of_finite _ _
    have hbij := IsAlgClosed.algebraMap_bijective_of_isIntegral (k := κ) (K := Γ(Z, U) ⧸ q.asIdeal)
    intro a
    obtain ⟨c, hc⟩ := hbij.2 (Ideal.Quotient.mk q.asIdeal a)
    refine ⟨c, ?_⟩
    have : Ideal.Quotient.mk q.asIdeal (ψ c) = Ideal.Quotient.mk q.asIdeal a := hc
    exact Ideal.Quotient.eq.mp this.symm
  have hmap : ∀ a : Γ(Z, U), ∃ c : κ,
      algebraMap Γ(Z, U) (Z.presheaf.stalk p) a = wcGcKappa s p c := by
    intro a
    obtain ⟨c, hc⟩ := hres a
    refine ⟨c, ?_⟩
    rw [hfac c]
    have := hzero _ hc
    rw [map_sub, sub_eq_zero] at this
    exact this
  intro y
  obtain ⟨⟨a, t⟩, hat⟩ := IsLocalization.surj q.asIdeal.primeCompl y
  obtain ⟨c, hc⟩ := hmap a
  obtain ⟨d, hd⟩ := hmap t
  have htu : IsUnit (algebraMap Γ(Z, U) (Z.presheaf.stalk p) (t : Γ(Z, U))) :=
    IsLocalization.map_units (Z.presheaf.stalk p) t
  have hkd : wcGcKappa s p d ≠ 0 := by
    rw [← hd]; exact htu.ne_zero
  have hd0 : d ≠ 0 := by
    rintro rfl; exact hkd (map_zero _)
  refine ⟨c * d⁻¹, ?_⟩
  simp only at hat
  rw [hc, hd] at hat
  rw [map_mul, ← hat, mul_assoc, ← map_mul, mul_inv_cancel₀ hd0, map_one, mul_one])

  have T6 : ∀ (κ K L : Type u) [Field κ] [Field K] [Field L]
