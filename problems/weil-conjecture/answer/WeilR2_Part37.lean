        {y | i0 y = i0 y₀}.encard * d0 y₀ + {y | rr2 (i2 y) = i' y' ∧ ns2 y}.encard := by
    intro T0 T' T1 T2 PX PX' PX1 PX2 i0 i' i1 i2 rr rr2 qq d0 d' d1 d2 ns2 y₀ y' y₁
      F2 F0 F1 FB FU Q2 Q3 Q2' Q3' e2 e3 hi hQ2 hQ2' hQ3 hQ3' hd2 hd3 hF2a hF2b hF0a hF0b
      hF1a hF1b hFBa hFBb hFU hfin hinv0 hinv' hinv1 hbd hfib hbal
    have eF2 := fext F2 d2 _ hF2a hF2b
    have eF0 := fext F0 d0 _ hF0a hF0b
    have eF1 := fext F1 d1 _ hF1a hF1b
    have eFB := fext FB d' _ hFBa hFBb
    have eFU : FU = d' := funext hFU
    rw [eFU] at hfin
    subst eF2 eF0 eF1 eFB
    beta_reduce at hbal
    have key1 : ∀ w : PX', w ≠ i' y' ↔ (rr w = i0 y₀ ∧ w ≠ i' y') ∨ rr w ≠ i0 y₀ := by
      intro w
      constructor
      · intro hw
        by_cases h : rr w = i0 y₀
        · exact Or.inl ⟨h, hw⟩
        · exact Or.inr h
      · rintro (⟨-, h⟩ | h)
        · exact h
        · rintro rfl; exact h hi
    have key2 : ∀ w : PX', rr w = i0 y₀ ↔ (rr w = i0 y₀ ∧ w ≠ i' y') ∨ w = i' y' := by
      intro w
      constructor
      · intro hw
        by_cases h : w = i' y'
        · exact Or.inr h
        · exact Or.inl ⟨hw, h⟩
      · rintro (h | rfl)
        · exact h.1
        · exact hi
    have mono : ∀ (P : T' → Prop), (⨆ s : Finset T', ∑ y ∈ s, if P y then d' y else 0) ≤
