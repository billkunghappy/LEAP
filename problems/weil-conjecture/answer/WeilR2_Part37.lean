    wcpa_dj_lr1s_normalization_finite Ω W hW hWt Ct (φ ≫ wcProjKStr Ω 1) φ hp hsm hirr hfin rfl
      hgen X uX ι hss hXp hpb
  haveI : IsProper uX := hss.2.1
  haveI hq : LocallyOfFiniteType (Limits.pullback.snd ((φ ≫ ι).fromNormalization ≫ uX)
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) :=
    inferInstance
  haveI : IsLocallyNoetherian (Limits.pullback ((φ ≫ ι).fromNormalization ≫ uX)
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) :=
    LocallyOfFiniteType.isLocallyNoetherian (Limits.pullback.snd ((φ ≫ ι).fromNormalization ≫ uX)
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))))
  intro w
  by_cases hw : IsClosed ({w} : Set ↥(Limits.pullback ((φ ≫ ι).fromNormalization ≫ uX)
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))))
  · obtain ⟨x₁, hx₁, hsp⟩ := wc_rational_closed_specialization (IsLocalRing.ResidueField ↥W) _
      (Limits.pullback.snd ((φ ≫ ι).fromNormalization ≫ uX)
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) w
    have hx : x₁ (IsLocalRing.closedPoint (IsLocalRing.ResidueField ↥W)) = w :=
      hsp.mem_closed hw rfl
    have hres := wcpa_dj_lqr_section_residue (IsLocalRing.ResidueField ↥W) _ _ x₁ hx₁
    have hdle := wcpa_dj_lr1k_gn_fibre_dim_le Ω W hW hWt Ct φ hcov X uX ι hM w
    have hdge := wcpa_dj_lr1k_gn_closed_dim_ge Ω W hW hWt Ct φ hcov X uX ι hM w hw
    haveI := wcpa_dj_lr1k_gn_fibre_reduced Ω W hW hWt Ct φ hcov X uX ι hM w
    have hgood := not_not.mp (hG w)
