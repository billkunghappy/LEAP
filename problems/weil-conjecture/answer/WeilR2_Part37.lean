  have hF4 : ∀ (e : ↥W), e ≠ 0 → e ∈ IsLocalRing.maximalIdeal ↥W → ∀ (M : ℕ)
      (r : ↥(wcGubBox W A (fun _ : Fin 2 => ζ) e)),
