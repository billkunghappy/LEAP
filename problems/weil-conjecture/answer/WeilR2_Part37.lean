  have hterm : ∀ i, Ideal.Quotient.mk ((IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A))
      (Polynomial.aeval ζ (p i) * sA i) =
      Polynomial.aeval (Polynomial.aeval t (μ ^ (N + 1))) (q i) * s' i := by
    intro i
    rw [map_mul, hsA i, ← hmkζ, ← hp i, Polynomial.aeval_map_algebraMap]
    congr 1
    exact (Polynomial.aeval_algHom_apply (Ideal.Quotient.mkₐ (↥W)
      ((IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A))) ζ (p i)).symm
  rw [Finset.sum_congr rfl (fun i _ => hterm i), ← hq, sub_self]

theorem dc_bt_dichotomy : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω)
    (A : Type u) [CommRing A] [Algebra ↥W A] (ζ : A),
    IsDomain A → Algebra.FinitePresentation ↥W A →
    (∀ (w : ↥W) (a : A), w ≠ 0 → algebraMap ↥W A w * a = 0 → a = 0) →
    (∀ (a : A) (j : ℕ), a ^ j ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) →
      a ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)) →
    wcBffNoether W A ζ →
    (∀ a : A, ∃ w : ↥W, a = algebraMap ↥W A w) ∨
    (∀ (f : Polynomial ↥W) (y : A), (∃ k, f.coeff k ∉ IsLocalRing.maximalIdeal ↥W) →
      Polynomial.aeval ζ f * y ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) →
      y ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)) :=
by
  intro Ω _ _ W A _ _ ζ hdom hfp hTF hRed hNoe
  classical
  haveI := hdom
  haveI := hfp
  have hft : Algebra.FiniteType ↥W A := inferInstance

  have s3 : ∀ x : A, IsIntegral ↥W x → ∃ w : ↥W, x = algebraMap ↥W A w := by
    intro x hx
    have hinjA : Function.Injective (algebraMap A (FractionRing A)) :=
      IsFractionRing.injective A (FractionRing A)
    have hg : Function.Injective ((algebraMap A (FractionRing A)).comp (algebraMap ↥W A)) := by
      intro a b hab
      by_contra hne
      have h1 : algebraMap ↥W A (a - b) = 0 := by
        apply hinjA
        rw [map_sub, map_sub, map_zero]
        have : ((algebraMap A (FractionRing A)).comp (algebraMap ↥W A)) a =
            ((algebraMap A (FractionRing A)).comp (algebraMap ↥W A)) b := hab
        simp only [RingHom.comp_apply] at this
        rw [this, sub_self]
      have := hTF (a - b) 1 (sub_ne_zero.mpr hne) (by rw [h1, zero_mul])
      exact one_ne_zero this
    have hφ := IsFractionRing.lift_algebraMap (K := Ω) hg
    obtain ⟨F, hFm, hFx⟩ := hx
    have hFΩm : (F.map (algebraMap ↥W Ω)).Monic := hFm.map _
    have hsplit := Polynomial.Splits.eq_prod_roots_of_monic
      (IsAlgClosed.splits (F.map (algebraMap ↥W Ω))) hFΩm
    have hcomp : (IsFractionRing.lift (K := Ω) hg).comp (algebraMap ↥W Ω) =
        (algebraMap A (FractionRing A)).comp (algebraMap ↥W A) := RingHom.ext hφ
    have h0 : Polynomial.eval₂ (IsFractionRing.lift (K := Ω) hg) (algebraMap A (FractionRing A) x)
        (F.map (algebraMap ↥W Ω)) = 0 := by
      rw [Polynomial.eval₂_map, hcomp, ← Polynomial.hom_eval₂, hFx, map_zero]
    rw [hsplit, Polynomial.eval₂_multiset_prod, Multiset.prod_eq_zero_iff, Multiset.map_map] at h0
    obtain ⟨α, hα, hαe⟩ := Multiset.mem_map.mp h0
    simp only [Function.comp_apply, Polynomial.eval₂_sub, Polynomial.eval₂_X,
      Polynomial.eval₂_C] at hαe
    have hαint : IsIntegral ↥W α := by
      refine ⟨F, hFm, ?_⟩
      have := (Polynomial.mem_roots'.mp hα).2
      rw [Polynomial.IsRoot, Polynomial.eval_map] at this
      exact this
    obtain ⟨w, hw⟩ := IsIntegrallyClosed.isIntegral_iff.mp hαint
    refine ⟨w, hinjA ?_⟩
    rw [sub_eq_zero] at hαe
    rw [hαe, ← hw, hφ, RingHom.comp_apply]

  have s2 : ∀ P : Ideal A, P ∈ ((IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)).minimalPrimes →
      P.IsMaximal →
      ∃ r : A, r ∉ P ∧ IsIntegral ↥W r ∧ ∀ x : A, ∃ m : ℕ, IsIntegral ↥W (r ^ m * x) := by
    intro P hP hPm
    set I := (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) with hI
    have hPp : P.IsPrime := hP.1.1
    have hIP : I ≤ P := hP.1.2
    have hfin : I.minimalPrimes.Finite := by
      haveI : Algebra.FiniteType ↥W (A ⧸ I) := Algebra.FiniteType.of_surjective
        (Ideal.Quotient.mkₐ ↥W I) (Ideal.Quotient.mkₐ_surjective ↥W I)
      haveI : Algebra.FiniteType (↥W ⧸ IsLocalRing.maximalIdeal ↥W) (A ⧸ I) :=
        Algebra.FiniteType.of_restrictScalars_finiteType ↥W _ _
      haveI : IsNoetherianRing (↥W ⧸ IsLocalRing.maximalIdeal ↥W) := by
        letI := Ideal.Quotient.field (IsLocalRing.maximalIdeal ↥W)
        infer_instance
      haveI : IsNoetherianRing (A ⧸ I) :=
        Algebra.FiniteType.isNoetherianRing (↥W ⧸ IsLocalRing.maximalIdeal ↥W) _
      rw [Ideal.minimalPrimes_eq_comap]
      exact (minimalPrimes.finite_of_isNoetherianRing _).image _
    have hQ : ∀ Q ∈ hfin.toFinset.erase P, ∃ g, g ∈ Q ∧ g ∉ P := by
      intro Q hQ
      rw [Finset.mem_erase, Set.Finite.mem_toFinset] at hQ
      by_contra hcon
      push_neg at hcon
      have hQP : Q ≤ P := hcon
      have hPQ : P ≤ Q := hP.2 hQ.2.1 hQP
      exact hQ.1 (le_antisymm hQP hPQ)
    choose! gs hgsQ hgsP using hQ
    set g := ∏ Q ∈ hfin.toFinset.erase P, gs Q with hgdef
    have hgP : g ∉ P := by
      intro h
      obtain ⟨Q, hQ, hQP⟩ := (Ideal.IsPrime.prod_mem_iff (hp := hPp)).mp h
      exact hgsP Q hQ hQP
    have hgQ : ∀ Q ∈ hfin.toFinset.erase P, g ∈ Q := by
      intro Q hQ
      rw [hgdef, ← Finset.mul_prod_erase _ gs hQ]
      exact Q.mul_mem_right _ (hgsQ Q hQ)
    have hcomap : P.comap (algebraMap ↥W A) = IsLocalRing.maximalIdeal ↥W := by
      have h1 : IsLocalRing.maximalIdeal ↥W ≤ P.comap (algebraMap ↥W A) :=
        Ideal.map_le_iff_le_comap.mp hIP
      exact ((IsLocalRing.maximalIdeal.isMaximal ↥W).eq_of_le
        (Ideal.comap_ne_top _ hPp.ne_top) h1).symm
    have hqf : Algebra.QuasiFiniteAt ↥W P := by
      refine Algebra.QuasiFiniteAt.of_isOpen_singleton_fiber (R := ↥W) ⟨P, hPp⟩ ?_
      convert (PrimeSpectrum.isOpen_basicOpen (a := g)).preimage continuous_subtype_val
      ext z
      simp only [Set.mem_singleton_iff, Set.mem_preimage, SetLike.mem_coe,
        PrimeSpectrum.mem_basicOpen]
      constructor
      · rintro rfl
        exact hgP
      · intro hz
        have hz2 := congrArg PrimeSpectrum.asIdeal z.2
        have hzc : z.1.asIdeal.comap (algebraMap ↥W A) = IsLocalRing.maximalIdeal ↥W := by
          rw [← hcomap]
          exact hz2
        have hIz : I ≤ z.1.asIdeal := Ideal.map_le_iff_le_comap.mpr hzc.ge
        obtain ⟨Q₀, hQ₀, hQ₀z⟩ := Ideal.exists_minimalPrimes_le hIz
        have hQ₀P : Q₀ = P := by
          by_contra hne
          apply hz
          apply hQ₀z
          apply hgQ
          rw [Finset.mem_erase, Set.Finite.mem_toFinset]
          exact ⟨hne, hQ₀⟩
        rw [hQ₀P] at hQ₀z
        have := hPm.eq_of_le z.1.isPrime.ne_top hQ₀z
        apply Subtype.ext
        apply PrimeSpectrum.ext
        exact this.symm
    exact Algebra.zariskisMainProperty_iff.mp (Algebra.ZariskisMainProperty.of_finiteType P)

  have s1 : ∀ (f : Polynomial ↥W) (y : A), (∃ k, f.coeff k ∉ IsLocalRing.maximalIdeal ↥W) →
      Polynomial.aeval ζ f * y ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) →
      y ∉ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) →
      ∃ P : Ideal A, P ∈ ((IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)).minimalPrimes ∧
        P.IsMaximal := by
    intro f y hk hfy hy
    set I := (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) with hI
    have hrad : I.radical = I :=
      le_antisymm (fun x ⟨j, hj⟩ => hRed x j hj) Ideal.le_radical
    have hyI : y ∉ sInf I.minimalPrimes := by rw [Ideal.sInf_minimalPrimes, hrad]; exact hy
    rw [Ideal.mem_sInf] at hyI
    push_neg at hyI
    obtain ⟨P, hP, hyP⟩ := hyI
    have hPp : P.IsPrime := hP.1.1
    have hIP : I ≤ P := hP.1.2
    have hfP : Polynomial.aeval ζ f ∈ P := (hPp.mem_or_mem (hIP hfy)).resolve_right hyP
    refine ⟨P, hP, ?_⟩
    let π : Polynomial ↥W →+* A ⧸ P := (Ideal.Quotient.mk P).comp (Polynomial.aeval ζ).toRingHom
    have hπ : ∀ p, π p = Ideal.Quotient.mk P (Polynomial.aeval ζ p) := fun p => rfl
    have hπC : ∀ w ∈ IsLocalRing.maximalIdeal ↥W, π (Polynomial.C w) = 0 := by
      intro w hw
      rw [hπ, Polynomial.aeval_C, Ideal.Quotient.eq_zero_iff_mem]
      exact hIP (Ideal.mem_map_of_mem _ hw)
    have hπf : π f = 0 := by rw [hπ, Ideal.Quotient.eq_zero_iff_mem]; exact hfP
    have hfinite : π.Finite := by
      letI := π.toAlgebra
      obtain ⟨n, s, hs⟩ := hNoe
      have key : ∀ z : A ⧸ P, z ∈ Submodule.span (Polynomial ↥W)
          (Set.range (fun i => Ideal.Quotient.mk P (s i))) := by
        intro z
        obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective z
        obtain ⟨p, hp⟩ := hs a
        have e : Ideal.Quotient.mk P a = ∑ i, π (p i) • Ideal.Quotient.mk P (s i) := by
          rw [← sub_eq_zero]
          have h0 : Ideal.Quotient.mk P (a - ∑ i, Polynomial.aeval ζ (p i) * s i) = 0 :=
            Ideal.Quotient.eq_zero_iff_mem.mpr (hIP hp)
          rw [← h0, map_sub, map_sum]
          congr 1
        rw [e]
        exact Submodule.sum_mem _ fun i _ => Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, rfl⟩)
      refine ⟨⟨Finset.univ.image (fun i => Ideal.Quotient.mk P (s i)), ?_⟩⟩
      rw [Finset.coe_image, Finset.coe_univ, Set.image_univ]
      exact eq_top_iff.mpr (fun z _ => key z)
    have hρs : Function.Surjective (Polynomial.mapRingHom (IsLocalRing.residue ↥W)) :=
      Polynomial.map_surjective _ IsLocalRing.residue_surjective
    have hkerρ : RingHom.ker (Polynomial.mapRingHom (IsLocalRing.residue ↥W)) ≤ RingHom.ker π := by
      rw [Polynomial.ker_mapRingHom, IsLocalRing.ker_residue, Ideal.map_le_iff_le_comap]
      intro w hw
      exact hπC w hw
    haveI : IsDomain (A ⧸ P) := Ideal.Quotient.isDomain P
    haveI hkp : (RingHom.ker π).IsPrime := RingHom.ker_isPrime π
    haveI hQp : (Ideal.map (Polynomial.mapRingHom (IsLocalRing.residue ↥W))
        (RingHom.ker π)).IsPrime :=
      Ideal.map_isPrime_of_surjective hρs hkerρ
    have hQne : Ideal.map (Polynomial.mapRingHom (IsLocalRing.residue ↥W)) (RingHom.ker π) ≠ ⊥ := by
      intro h
      have hm : Polynomial.mapRingHom (IsLocalRing.residue ↥W) f ∈
          Ideal.map (Polynomial.mapRingHom (IsLocalRing.residue ↥W)) (RingHom.ker π) :=
        Ideal.mem_map_of_mem _ (RingHom.mem_ker.mpr hπf)
      rw [h, Ideal.mem_bot] at hm
      obtain ⟨k, hk⟩ := hk
      apply hk
      have := congrArg (fun p => Polynomial.coeff p k) hm
      simp only [Polynomial.coe_mapRingHom, Polynomial.coeff_map, Polynomial.coeff_zero] at this
      exact (IsLocalRing.residue_eq_zero_iff _).mp this
    haveI hQm := Ideal.IsPrime.isMaximal hQp hQne
    have hkm : (RingHom.ker π).IsMaximal := by
      have := Ideal.comap_isMaximal_of_surjective _ hρs
        (K := Ideal.map (Polynomial.mapRingHom (IsLocalRing.residue ↥W)) (RingHom.ker π))
      rwa [Ideal.comap_map_of_surjective' _ hρs, sup_eq_left.mpr hkerρ] at this
    have hbot : (⊥ : Ideal (A ⧸ P)).IsMaximal := by
      apply Ideal.isMaximal_of_isIntegral_of_isMaximal_comap π hfinite.to_isIntegral
      rw [← RingHom.ker_eq_comap_bot]
      exact hkm
    exact Ideal.Quotient.maximal_of_isField P (Ring.isField_iff_maximal_bot.mpr hbot)

  by_cases h : ∀ (f : Polynomial ↥W) (y : A), (∃ k, f.coeff k ∉ IsLocalRing.maximalIdeal ↥W) →
      Polynomial.aeval ζ f * y ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) →
      y ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)
  · exact Or.inr h
  left
  push_neg at h
  obtain ⟨f, y, hk, hfy, hy⟩ := h
  obtain ⟨P, hP, hPm⟩ := s1 f y hk hfy hy
  obtain ⟨r, hrP, hr, hx⟩ := s2 P hP hPm
  obtain ⟨w₁, hw₁⟩ := s3 r hr
  have hu : IsUnit w₁ := by
    rw [← IsLocalRing.notMem_maximalIdeal]
    intro hm
    apply hrP
    rw [hw₁]
    exact hP.1.2 (Ideal.mem_map_of_mem _ hm)
  intro a
  obtain ⟨m, hm⟩ := hx a
  obtain ⟨w', hw'⟩ := s3 _ hm
  refine ⟨(↑hu.unit⁻¹ : ↥W) ^ m * w', ?_⟩
  rw [map_mul, ← hw', hw₁, map_pow, ← mul_assoc, ← mul_pow, ← map_mul, hu.val_inv_mul, map_one,
    one_pow, one_mul]

theorem dc_bt_basis : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω)
    (A : Type u) [CommRing A] [Algebra ↥W A] (ζ : A),
    wcBffNoether W A ζ →
    (∀ (f : Polynomial ↥W) (y : A), (∃ k, f.coeff k ∉ IsLocalRing.maximalIdeal ↥W) →
      Polynomial.aeval ζ f * y ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) →
      y ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)) →
    ∃ (r : ℕ) (b : Fin r → A),
      (∀ a : A, ∃ p : Fin r → Polynomial ↥W,
        a - ∑ i, Polynomial.aeval ζ (p i) * b i ∈
          (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)) ∧
      (∀ p : Fin r → Polynomial ↥W,
        ∑ i, Polynomial.aeval ζ (p i) * b i ∈
          (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) →
        ∀ i k, (p i).coeff k ∈ IsLocalRing.maximalIdeal ↥W) :=
by
  intro Ω _ W A _ _ ζ hN hT
  classical

  have pid : ∀ (k : Type u) [Field k] (B : Type u) [CommRing B] (ψ : Polynomial k →+* B),
      (∃ (n : ℕ) (s : Fin n → B), ∀ x : B, ∃ g : Fin n → Polynomial k,
        x = ∑ i, ψ (g i) * s i) →
      (∀ (g : Polynomial k) (y : B), g ≠ 0 → ψ g * y = 0 → y = 0) →
      ∃ (r : ℕ) (β : Fin r → B),
        (∀ x : B, ∃ g : Fin r → Polynomial k, x = ∑ i, ψ (g i) * β i) ∧
        (∀ g : Fin r → Polynomial k, ∑ i, ψ (g i) * β i = 0 → ∀ i, g i = 0) := by
    intro k _ B _ ψ hfin htf
    letI : Algebra (Polynomial k) B := ψ.toAlgebra
    have hsm : ∀ (g : Polynomial k) (x : B), g • x = ψ g * x := fun g x => by
      rw [Algebra.smul_def, RingHom.algebraMap_toAlgebra]
    obtain ⟨n, s, hs⟩ := hfin
    have hspan : Submodule.span (Polynomial k) (Set.range s) = ⊤ := by
      rw [Submodule.eq_top_iff']
      intro x
      rw [Submodule.mem_span_range_iff_exists_fun]
      obtain ⟨g, hg⟩ := hs x
      exact ⟨g, by simp only [hsm]; exact hg.symm⟩
    haveI : Module.IsTorsionFree (Polynomial k) B := by
      rw [Module.isTorsionFree_iff_smul_eq_zero]
      intro g y h
      by_cases hg : g = 0
      · exact Or.inl hg
      · exact Or.inr (htf g y hg (by rw [← hsm]; exact h))
    obtain ⟨r, β⟩ := Module.basisOfFiniteTypeTorsionFree hspan
    refine ⟨r, β, ?_, ?_⟩
    · intro x
      refine ⟨fun i => β.repr x i, ?_⟩
      conv_lhs => rw [← β.sum_repr x]
      simp only [hsm]
    · intro g hg
      apply Fintype.linearIndependent_iff.mp β.linearIndependent g
      simp only [hsm]
      exact hg
  obtain ⟨n₀, s, hs⟩ := hN
  generalize hmA : (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) = mA at *

  let ρ : ↥W →+* A ⧸ mA := (Ideal.Quotient.mk mA).comp (algebraMap ↥W A)
  have hρ : ∀ a ∈ IsLocalRing.maximalIdeal ↥W, ρ a = 0 := fun a ha =>
    Ideal.Quotient.eq_zero_iff_mem.mpr (hmA ▸ Ideal.mem_map_of_mem _ ha)
  let ρbar : IsLocalRing.ResidueField ↥W →+* A ⧸ mA := Ideal.Quotient.lift _ ρ hρ
  let ψ : Polynomial (IsLocalRing.ResidueField ↥W) →+* A ⧸ mA :=
    Polynomial.eval₂RingHom ρbar (Ideal.Quotient.mk mA ζ)
  have hψ : ∀ p : Polynomial ↥W, ψ (p.map (IsLocalRing.residue ↥W)) =
      Ideal.Quotient.mk mA (Polynomial.aeval ζ p) := by
    intro p
    rw [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_map, Polynomial.aeval_def,
      Polynomial.hom_eval₂]
    rfl

  have hfin : ∃ (n : ℕ) (s' : Fin n → A ⧸ mA), ∀ x : A ⧸ mA,
      ∃ g : Fin n → Polynomial (IsLocalRing.ResidueField ↥W), x = ∑ i, ψ (g i) * s' i := by
    refine ⟨n₀, fun i => Ideal.Quotient.mk mA (s i), ?_⟩
    intro x
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective x
    obtain ⟨p, hp⟩ := hs a
    refine ⟨fun i => (p i).map (IsLocalRing.residue ↥W), ?_⟩
    rw [Ideal.Quotient.eq.mpr hp, map_sum]
    simp only [map_mul, hψ]

  have htf : ∀ (g : Polynomial (IsLocalRing.ResidueField ↥W)) (y : A ⧸ mA),
      g ≠ 0 → ψ g * y = 0 → y = 0 := by
    intro g y hg hgy
    obtain ⟨f, rfl⟩ :=
      Polynomial.map_surjective (IsLocalRing.residue ↥W) IsLocalRing.residue_surjective g
    obtain ⟨y₀, rfl⟩ := Ideal.Quotient.mk_surjective y
    have hcoef : ∃ k, f.coeff k ∉ IsLocalRing.maximalIdeal ↥W := by
      by_contra hcon
      push_neg at hcon
      apply hg
      ext k
      rw [Polynomial.coeff_map, Polynomial.coeff_zero, IsLocalRing.residue_eq_zero_iff]
      exact hcon k
    have h1 : Polynomial.aeval ζ f * y₀ ∈ mA := by
      rw [← Ideal.Quotient.eq_zero_iff_mem, map_mul, ← hψ]
      exact hgy
    exact Ideal.Quotient.eq_zero_iff_mem.mpr (hT f y₀ hcoef h1)

  obtain ⟨r, β, hβs, hβi⟩ := pid (IsLocalRing.ResidueField ↥W) (A ⧸ mA) ψ hfin htf
  choose b hb using fun i => Ideal.Quotient.mk_surjective (I := mA) (β i)
  refine ⟨r, b, ?_, ?_⟩
  · intro a
    obtain ⟨g, hg⟩ := hβs (Ideal.Quotient.mk mA a)
    choose p hp using fun i =>
      Polynomial.map_surjective (IsLocalRing.residue ↥W) IsLocalRing.residue_surjective (g i)
    refine ⟨p, ?_⟩
    rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, map_sum, hg]
    simp only [map_mul, ← hψ, hp, hb, sub_self]
  · intro p hp i k
    have h0 : ∑ i, ψ ((p i).map (IsLocalRing.residue ↥W)) * β i = 0 := by
      rw [← Ideal.Quotient.eq_zero_iff_mem, map_sum] at hp
      simpa only [map_mul, ← hψ, hb] using hp
    have h2 := hβi _ h0 i
    rw [← IsLocalRing.residue_eq_zero_iff, ← Polynomial.coeff_map, h2, Polynomial.coeff_zero]

theorem dc_bt_content : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω)
    (A : Type u) [CommRing A] [Algebra ↥W A] (ζ : A) (r : ℕ) (b : Fin r → A),
    (∀ (w : ↥W) (a : A), w ≠ 0 → algebraMap ↥W A w * a = 0 → a = 0) →
    (∀ p : Fin r → Polynomial ↥W,
      ∑ i, Polynomial.aeval ζ (p i) * b i ∈
        (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) →
      ∀ i k, (p i).coeff k ∈ IsLocalRing.maximalIdeal ↥W) →
    ∀ (w : ↥W) (P : Fin r → Polynomial ↥W) (y : A),
      ∑ i, Polynomial.aeval ζ (P i) * b i = algebraMap ↥W A w * y →
      ∀ i k, w ∣ (P i).coeff k :=
by
  intro Ω _ W A _ _ ζ r b hTF hind w P y H i₀ k₀
  classical
  by_contra hn
  have ha : (P i₀).coeff k₀ ≠ 0 := fun h => hn (h ▸ dvd_zero w)
  have hmin : ∀ (T : Finset (Σ _ : Fin r, ℕ)), T.Nonempty →
      ∃ t ∈ T, ∀ t' ∈ T, (P t.1).coeff t.2 ∣ (P t'.1).coeff t'.2 := by
    intro T hT
    induction hT using Finset.Nonempty.cons_induction with
    | singleton a =>
      refine ⟨a, Finset.mem_singleton_self a, fun t' ht' => ?_⟩
      obtain rfl := Finset.mem_singleton.mp ht'
      exact dvd_refl _
    | cons a s has hs ih =>
      obtain ⟨t, ht, htd⟩ := ih
      rcases ValuationRing.dvd_total ((P a.1).coeff a.2) ((P t.1).coeff t.2) with h | h
      · refine ⟨a, Finset.mem_cons_self a s, fun t' ht' => ?_⟩
        rcases Finset.mem_cons.mp ht' with h' | h'
        · subst h'; exact dvd_refl _
        · exact h.trans (htd t' h')
      · refine ⟨t, Finset.mem_cons_of_mem ht, fun t' ht' => ?_⟩
        rcases Finset.mem_cons.mp ht' with h' | h'
        · subst h'; exact h
        · exact htd t' h'
  have hmem : (⟨i₀, k₀⟩ : Σ _ : Fin r, ℕ) ∈ Finset.univ.sigma (fun i => (P i).support) :=
    Finset.mem_sigma.mpr ⟨Finset.mem_univ _, Polynomial.mem_support_iff.mpr ha⟩
  obtain ⟨⟨i₁, k₁⟩, ht₁, hdiv⟩ := hmin _ ⟨_, hmem⟩
  have hc0 : (P i₁).coeff k₁ ≠ 0 :=
    Polynomial.mem_support_iff.mp (Finset.mem_sigma.mp ht₁).2
  have hcall : ∀ i k, (P i₁).coeff k₁ ∣ (P i).coeff k := by
    intro i k
    by_cases hk : k ∈ (P i).support
    · exact hdiv ⟨i, k⟩ (Finset.mem_sigma.mpr ⟨Finset.mem_univ _, hk⟩)
    · rw [Polynomial.notMem_support_iff.mp hk]; exact dvd_zero _
  generalize hcdef : (P i₁).coeff k₁ = c at hc0 hcall
  have hwc : ¬ w ∣ c := fun h => hn (h.trans (hcall i₀ k₀))
  obtain ⟨u, hu⟩ : c ∣ w := (ValuationRing.dvd_total c w).resolve_right hwc
  have huM : u ∈ IsLocalRing.maximalIdeal W := by
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    intro hunit
    apply hwc
    exact ⟨↑hunit.unit⁻¹, by rw [hu, mul_assoc, IsUnit.mul_val_inv, mul_one]⟩
  have hQ : ∀ i, ∃ q : Polynomial W, P i = Polynomial.C c * q := fun i =>
    (Polynomial.C_dvd_iff_dvd_coeff c (P i)).mpr (hcall i)
  choose Q hQ using hQ
  have hsum : ∑ i, Polynomial.aeval ζ (P i) * b i =
      algebraMap W A c * ∑ i, Polynomial.aeval ζ (Q i) * b i := by
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [hQ i, Polynomial.aeval_mul, Polynomial.aeval_C, mul_assoc]
  have hS : ∑ i, Polynomial.aeval ζ (Q i) * b i = algebraMap W A u * y := by
    apply sub_eq_zero.mp
    apply hTF c _ hc0
    rw [mul_sub, ← hsum, H, hu, map_mul, mul_assoc, sub_self]
  have hSM : ∑ i, Polynomial.aeval ζ (Q i) * b i ∈
      (IsLocalRing.maximalIdeal W).map (algebraMap W A) := by
    rw [hS]
    exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ huM)
  have hq1 := hind Q hSM i₁ k₁
  have e : (P i₁).coeff k₁ = c * (Q i₁).coeff k₁ := by
    rw [hQ i₁, Polynomial.coeff_C_mul]
  rw [hcdef] at e
  have h1 : (Q i₁).coeff k₁ = 1 := mul_left_cancel₀ hc0 (e.symm.trans (mul_one c).symm)
  rw [h1] at hq1
  exact (IsLocalRing.notMem_maximalIdeal.mpr isUnit_one) hq1

theorem dc_bt_span_pow : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω),
    ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) →
    ∀ (A : Type u) [CommRing A] [Algebra ↥W A], Algebra.FiniteType ↥W A →
    ∀ (ϖ : ↥W), ϖ ≠ 0 → ϖ ∈ IsLocalRing.maximalIdeal ↥W →
    ∀ (ζ : A) (r : ℕ) (b : Fin r → A),
    (∀ a : A, ∃ p : Fin r → Polynomial ↥W,
      a - ∑ i, Polynomial.aeval ζ (p i) * b i ∈
        (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)) →
    ∀ (L : ℕ) (a : A), ∃ (p : Fin r → Polynomial ↥W) (s : A),
      a = ∑ i, Polynomial.aeval ζ (p i) * b i + algebraMap ↥W A ϖ ^ L * s :=
by
  intro Ω _ W hdimW A _ _ hft ϖ hϖ0 _ ζ r b hspan
  classical

  have s1 : ∀ x ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A),
      ∃ (w : ↥W) (y : A), w ∈ IsLocalRing.maximalIdeal ↥W ∧ x = algebraMap ↥W A w * y := by
    intro x hx
    change x ∈ Submodule.span A
      (⇑(algebraMap ↥W A) '' (IsLocalRing.maximalIdeal ↥W : Set ↥W)) at hx
    induction hx using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨w, hw, rfl⟩ := hx
      exact ⟨w, 1, hw, (mul_one _).symm⟩
    | zero => exact ⟨0, 0, Ideal.zero_mem _, by simp⟩
    | add x x' _ _ hx hx' =>
      obtain ⟨w, y, hw, rfl⟩ := hx
      obtain ⟨w', y', hw', rfl⟩ := hx'
      rcases ValuationRing.dvd_total w w' with ⟨c, rfl⟩ | ⟨c, rfl⟩
      · exact ⟨w, y + algebraMap ↥W A c * y', hw, by rw [map_mul]; ring⟩
      · exact ⟨w', algebraMap ↥W A c * y + y', hw', by rw [map_mul]; ring⟩
    | smul a x _ hx =>
      obtain ⟨w, y, hw, rfl⟩ := hx
      exact ⟨w, a * y, hw, by rw [smul_eq_mul]; ring⟩

  have hpow : ∀ w ∈ IsLocalRing.maximalIdeal ↥W, ∃ K : ℕ, ∃ u : ↥W, w ^ K = u * ϖ := by
    intro w hw
    haveI : Ring.KrullDimLE 1 ↥W := Ring.krullDimLE_iff.mpr hdimW
    have hle : IsLocalRing.maximalIdeal ↥W ≤ (Ideal.span {ϖ}).radical := by
      rw [Ideal.radical_eq_sInf]
      refine le_sInf ?_
      rintro P ⟨hPϖ, hPp⟩
      have hP0 : P ≠ ⊥ := by
        intro h
        apply hϖ0
        have : ϖ ∈ P := hPϖ (Ideal.mem_span_singleton_self ϖ)
        rw [h] at this
        exact (Submodule.mem_bot _).mp this
      haveI := hPp
      have hPmax : P.IsMaximal := Ideal.isMaximal_of_isPrime_of_ne_bot P hP0
      exact le_of_eq (IsLocalRing.eq_maximalIdeal hPmax).symm
    obtain ⟨K, hK⟩ := hle hw
    obtain ⟨u, hu⟩ := Ideal.mem_span_singleton'.mp hK
    exact ⟨K, u, hu.symm⟩

  have s3 : ∀ G : Finset A, (∀ g ∈ G, ∃ (p : Fin r → Polynomial ↥W) (w : ↥W) (y : A),
      w ∈ IsLocalRing.maximalIdeal ↥W ∧
        g = ∑ i, Polynomial.aeval ζ (p i) * b i + algebraMap ↥W A w * y) →
      ∃ w₀ : ↥W, w₀ ∈ IsLocalRing.maximalIdeal ↥W ∧ ∀ g ∈ G,
        ∃ (p : Fin r → Polynomial ↥W) (s : A),
          g = ∑ i, Polynomial.aeval ζ (p i) * b i + algebraMap ↥W A w₀ * s := by
    intro G
    induction G using Finset.induction_on with
    | empty => intro _; exact ⟨0, Ideal.zero_mem _, fun g hg => by simp at hg⟩
    | insert g G' hg ih =>
      intro H
      obtain ⟨w₁, hw₁, H₁⟩ := ih (fun g' hg' => H g' (Finset.mem_insert_of_mem hg'))
      obtain ⟨p, w, y, hw, hgeq⟩ := H g (Finset.mem_insert_self g G')
      rcases ValuationRing.dvd_total w w₁ with ⟨c, hc⟩ | ⟨c, hc⟩
      · refine ⟨w, hw, fun g' hg' => ?_⟩
        rcases Finset.mem_insert.mp hg' with h | h
        · exact ⟨p, y, h ▸ hgeq⟩
        · obtain ⟨p', s', hs'⟩ := H₁ g' h
          exact ⟨p', algebraMap ↥W A c * s', by rw [hs', hc, map_mul, mul_assoc]⟩
      · refine ⟨w₁, hw₁, fun g' hg' => ?_⟩
        rcases Finset.mem_insert.mp hg' with h | h
        · exact ⟨p, algebraMap ↥W A c * y, by rw [h, hgeq, hc, map_mul, mul_assoc]⟩
        · exact H₁ g' h

  obtain ⟨G₀, hG₀⟩ := hft.out
  set G : Finset A := insert 1 (G₀ ∪ Finset.univ.image
    (fun ij : Fin r × Fin r => b ij.1 * b ij.2)) with hG
  obtain ⟨w₀, hw₀, hw₀G⟩ := s3 G (fun g _ => by
    obtain ⟨p, hp⟩ := hspan g
    obtain ⟨w, y, hw, hxy⟩ := s1 _ hp
    exact ⟨p, w, y, hw, sub_eq_iff_eq_add'.mp hxy⟩)

  let N : A → Prop := fun x => ∃ (p : Fin r → Polynomial ↥W) (s : A),
    x = ∑ i, Polynomial.aeval ζ (p i) * b i + algebraMap ↥W A w₀ * s
  have N0 : N 0 := ⟨0, 0, by simp⟩
  have Nadd : ∀ x y : A, N x → N y → N (x + y) := by
    rintro x y ⟨p, s, rfl⟩ ⟨p', s', rfl⟩
    refine ⟨p + p', s + s', ?_⟩
    have e : ∑ i, Polynomial.aeval ζ ((p + p') i) * b i =
        ∑ i, Polynomial.aeval ζ (p i) * b i + ∑ i, Polynomial.aeval ζ (p' i) * b i := by
      simp only [Pi.add_apply, map_add, add_mul, Finset.sum_add_distrib]
    rw [e]; ring
  have Npoly : ∀ (q : Polynomial ↥W) (x : A), N x → N (Polynomial.aeval ζ q * x) := by
    rintro q x ⟨p, s, rfl⟩
    refine ⟨fun i => q * p i, Polynomial.aeval ζ q * s, ?_⟩
    have e : ∑ i, Polynomial.aeval ζ (q * p i) * b i =
        Polynomial.aeval ζ q * ∑ i, Polynomial.aeval ζ (p i) * b i := by
      simp only [map_mul, Finset.mul_sum, mul_assoc]
    rw [e]; ring
  have Nw : ∀ z : A, N (algebraMap ↥W A w₀ * z) := fun z => ⟨0, z, by simp⟩
  have hbb : ∀ i j : Fin r, N (b i * b j) := fun i j =>
    hw₀G _ (Finset.mem_insert_of_mem (Finset.mem_union_right _
      (Finset.mem_image_of_mem _ (Finset.mem_univ (i, j)))))

  have hall : ∀ x : A, N x := by
    intro x
    have hx : x ∈ Algebra.adjoin ↥W (G₀ : Set A) := by rw [hG₀]; exact Algebra.mem_top
    induction hx using Algebra.adjoin_induction with
    | mem x hx => exact hw₀G x (Finset.mem_insert_of_mem (Finset.mem_union_left _ hx))
    | algebraMap c =>
      have h1 := Npoly (Polynomial.C c) 1 (hw₀G 1 (Finset.mem_insert_self _ _))
      rwa [Polynomial.aeval_C, mul_one] at h1
    | add x y _ _ hx hy => exact Nadd x y hx hy
    | mul x y _ _ hx hy =>
      obtain ⟨p, s, rfl⟩ := hx
      obtain ⟨q, t, rfl⟩ := hy
      have hXY : N ((∑ i, Polynomial.aeval ζ (p i) * b i) *
          (∑ j, Polynomial.aeval ζ (q j) * b j)) := by
        rw [Finset.sum_mul_sum]
        refine Finset.sum_induction _ N Nadd N0 (fun i _ => ?_)
        refine Finset.sum_induction _ N Nadd N0 (fun j _ => ?_)
        have e : Polynomial.aeval ζ (p i) * b i * (Polynomial.aeval ζ (q j) * b j) =
            Polynomial.aeval ζ (p i * q j) * (b i * b j) := by
          rw [map_mul]; ring
        rw [e]
        exact Npoly _ _ (hbb i j)
      have e2 : (∑ i, Polynomial.aeval ζ (p i) * b i + algebraMap ↥W A w₀ * s) *
          (∑ j, Polynomial.aeval ζ (q j) * b j + algebraMap ↥W A w₀ * t) =
          (∑ i, Polynomial.aeval ζ (p i) * b i) * (∑ j, Polynomial.aeval ζ (q j) * b j) +
            algebraMap ↥W A w₀ * (s * (∑ j, Polynomial.aeval ζ (q j) * b j) +
              (∑ i, Polynomial.aeval ζ (p i) * b i) * t + algebraMap ↥W A w₀ * s * t) := by
        ring
      rw [e2]
      exact Nadd _ _ hXY (Nw _)

  have hiter : ∀ k : ℕ, ∀ a : A, ∃ (p : Fin r → Polynomial ↥W) (s : A),
      a = ∑ i, Polynomial.aeval ζ (p i) * b i + algebraMap ↥W A w₀ ^ k * s := by
    intro k
    induction k with
    | zero => intro a; exact ⟨0, a, by simp⟩
    | succ k ih =>
      intro a
      obtain ⟨p, y, hy⟩ := ih a
      obtain ⟨q, y', hy'⟩ := hall y
      refine ⟨fun i => p i + Polynomial.C (w₀ ^ k) * q i, y', ?_⟩
      have e : ∑ i, Polynomial.aeval ζ (p i + Polynomial.C (w₀ ^ k) * q i) * b i =
          ∑ i, Polynomial.aeval ζ (p i) * b i +
            algebraMap ↥W A w₀ ^ k * ∑ i, Polynomial.aeval ζ (q i) * b i := by
        simp only [map_add, map_mul, Polynomial.aeval_C, map_pow, add_mul,
          Finset.sum_add_distrib, Finset.mul_sum, mul_assoc]
      rw [e, hy, hy']
      ring

  intro L a
  obtain ⟨K, u, hK⟩ := hpow w₀ hw₀
  obtain ⟨p, s, hs⟩ := hiter (K * L) a
  refine ⟨p, algebraMap ↥W A u ^ L * s, ?_⟩
  have e : algebraMap ↥W A w₀ ^ (K * L) = algebraMap ↥W A ϖ ^ L * algebraMap ↥W A u ^ L := by
    rw [pow_mul, ← map_pow (algebraMap ↥W A) w₀ K, hK, map_mul, mul_pow]
    ring
  rw [hs, e]
  ring

theorem dc_bt_free_estimate : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω)
    (A : Type u) [CommRing A] [Algebra ↥W A] (ϖ : ↥W), ϖ ≠ 0 →
    ∀ (ζ : A) (r : ℕ) (b : Fin r → A),
    (∀ (w : ↥W) (a : A), w ≠ 0 → algebraMap ↥W A w * a = 0 → a = 0) →
    (∀ (L : ℕ) (a : A), ∃ (p : Fin r → Polynomial ↥W) (s : A),
      a = ∑ i, Polynomial.aeval ζ (p i) * b i + algebraMap ↥W A ϖ ^ L * s) →
    (∀ (w : ↥W) (P : Fin r → Polynomial ↥W) (y : A),
      ∑ i, Polynomial.aeval ζ (P i) * b i = algebraMap ↥W A w * y →
      ∀ i k, w ∣ (P i).coeff k) →
    ∀ (n : ℕ) (a : A),
      (∃ t : ↥(wcGubBox W A (fun _ : Fin 2 => ζ) ϖ),
        algebraMap A (wcGubGen W A) a =
          algebraMap A (wcGubGen W A) (algebraMap ↥W A ϖ) ^ n * (t : wcGubGen W A)) →
      a ∈ Ideal.span {algebraMap ↥W A ϖ, ζ} ^ n :=
by
  intro Ω _ W A _ _ ϖ hϖ ζ r b hTF hSp hCt n a ha
  classical
  have hϖJ : algebraMap ↥W A ϖ ∈ Ideal.span {algebraMap ↥W A ϖ, ζ} :=
    Ideal.subset_span (Set.mem_insert _ _)
  have hζJ : ζ ∈ Ideal.span {algebraMap ↥W A ϖ, ζ} :=
    Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _))

  have s2 : ∀ (p : Polynomial ↥W), (∀ k : ℕ, k < n → ϖ ^ (n - k) ∣ p.coeff k) →
      Polynomial.aeval ζ p ∈ Ideal.span {algebraMap ↥W A ϖ, ζ} ^ n := by
    intro p hp
    rw [Polynomial.aeval_eq_sum_range]
    apply Ideal.sum_mem
    intro k _
    rw [Algebra.smul_def]
    by_cases hk : k < n
    · obtain ⟨g, hg⟩ := hp k hk
      have e : algebraMap ↥W A (p.coeff k) * ζ ^ k =
          algebraMap ↥W A g * (algebraMap ↥W A ϖ ^ (n - k) * ζ ^ k) := by
        rw [hg, map_mul, map_pow]; ring
      rw [e]
      apply Ideal.mul_mem_left
      have h1 := Ideal.mul_mem_mul (Ideal.pow_mem_pow hϖJ (n - k)) (Ideal.pow_mem_pow hζJ k)
      rw [← pow_add, Nat.sub_add_cancel hk.le] at h1
      exact h1
    · exact Ideal.mul_mem_left _ _
        (Ideal.pow_le_pow_right (by omega) (Ideal.pow_mem_pow hζJ k))

  obtain ⟨t, hta⟩ := ha
  have ht := t.2
  have hM : Submonoid.map (algebraMap ↥W A) (nonZeroDivisors ↥W) ≤ nonZeroDivisors A := by
    rintro _ ⟨w, hw, rfl⟩
    rw [mem_nonZeroDivisors_iff_right]
    intro y hy
    apply hTF w y (nonZeroDivisors.ne_zero hw)
    first | exact hy | (rw [mul_comm]; exact hy)
  have hinj : Function.Injective (algebraMap A (wcGubGen W A)) :=
    IsLocalization.injective (M := Submonoid.map (algebraMap ↥W A) (nonZeroDivisors ↥W))
      (wcGubGen W A) hM
  have hunit : IsUnit (algebraMap A (wcGubGen W A) (algebraMap ↥W A ϖ)) :=
    IsLocalization.map_units (wcGubGen W A)
      (⟨algebraMap (↥W) A ϖ, Submonoid.mem_map_of_mem _ (mem_nonZeroDivisors_of_ne_zero hϖ)⟩ :
        Submonoid.map (algebraMap (↥W) A) (nonZeroDivisors ↥W))
  have hU : algebraMap A (wcGubGen W A) (algebraMap ↥W A ϖ) *
      Ring.inverse (algebraMap A (wcGubGen W A) (algebraMap ↥W A ϖ)) = 1 :=
    Ring.mul_inverse_cancel _ hunit
  set x : wcGubGen W A := algebraMap A (wcGubGen W A) ζ *
      Ring.inverse (algebraMap A (wcGubGen W A) (algebraMap ↥W A ϖ)) with hx
  change (t : wcGubGen W A) ∈ Algebra.adjoin A (Set.range fun _ : Fin 2 => x) at ht
  rw [Set.range_const, Algebra.adjoin_singleton_eq_range_aeval, AlgHom.mem_range] at ht
  obtain ⟨Q, hQ⟩ := ht
  set d := Q.natDegree with hd
  have hkey : ∀ j, j ≤ d →
      algebraMap A (wcGubGen W A) (algebraMap ↥W A ϖ) ^ d * x ^ j =
        algebraMap A (wcGubGen W A) ζ ^ j *
          algebraMap A (wcGubGen W A) (algebraMap ↥W A ϖ) ^ (d - j) := by
    intro j hj
    have e1 : algebraMap A (wcGubGen W A) (algebraMap ↥W A ϖ) ^ d =
        algebraMap A (wcGubGen W A) (algebraMap ↥W A ϖ) ^ (d - j) *
          algebraMap A (wcGubGen W A) (algebraMap ↥W A ϖ) ^ j := by
      rw [← pow_add, Nat.sub_add_cancel hj]
    have e2 : algebraMap A (wcGubGen W A) (algebraMap ↥W A ϖ) * x =
        algebraMap A (wcGubGen W A) ζ := by
      rw [hx, mul_left_comm, hU, mul_one]
    rw [e1, mul_assoc, ← mul_pow, e2, mul_comm]
  have hstar : algebraMap ↥W A ϖ ^ d * a = algebraMap ↥W A ϖ ^ n *
      ∑ j ∈ Finset.range (d + 1), Q.coeff j * ζ ^ j * algebraMap ↥W A ϖ ^ (d - j) := by
    apply hinj
    simp only [map_mul, map_pow, map_sum]
    rw [hta, ← hQ, Polynomial.aeval_eq_sum_range, Finset.mul_sum, Finset.mul_sum, Finset.mul_sum]
    refine Finset.sum_congr rfl fun j hj => ?_
    have hj' : j ≤ d := Nat.lt_succ_iff.mp (Finset.mem_range.mp hj)
    rw [Algebra.smul_def]
    linear_combination (algebraMap A (wcGubGen W A) (algebraMap ↥W A ϖ) ^ n *
      algebraMap A (wcGubGen W A) (Q.coeff j)) * hkey j hj'

  obtain ⟨p, s, hps⟩ := hSp (n + d) a
  choose q s' hqs using fun j => hSp (n + d) (Q.coeff j)
  obtain ⟨P, hPdef⟩ : ∃ P : Fin r → Polynomial ↥W, ∀ i, P i =
      Polynomial.C (ϖ ^ d) * p i - ∑ j ∈ Finset.range (d + 1),
        Polynomial.C (ϖ ^ (n + d - j)) * (Polynomial.X ^ j * q j i) := ⟨_, fun i => rfl⟩
  have h1 : ∀ i, Polynomial.aeval ζ (P i) * b i =
      algebraMap ↥W A ϖ ^ d * (Polynomial.aeval ζ (p i) * b i) -
        ∑ j ∈ Finset.range (d + 1), algebraMap ↥W A ϖ ^ (n + d - j) * ζ ^ j *
          (Polynomial.aeval ζ (q j i) * b i) := by
    intro i
    simp only [hPdef, map_sub, map_mul, map_sum, Polynomial.aeval_C,
      Polynomial.aeval_X, map_pow, sub_mul, Finset.sum_mul]
    congr 1
    · ring
    · exact Finset.sum_congr rfl fun j _ => by ring
  have e1 : ∑ i, Polynomial.aeval ζ (P i) * b i =
      algebraMap ↥W A ϖ ^ d * (∑ i, Polynomial.aeval ζ (p i) * b i) -
        ∑ j ∈ Finset.range (d + 1), algebraMap ↥W A ϖ ^ (n + d - j) * ζ ^ j *
          (∑ i, Polynomial.aeval ζ (q j i) * b i) := by
    rw [Finset.sum_congr rfl fun i _ => h1 i, Finset.sum_sub_distrib, Finset.mul_sum]
    congr 1
    rw [Finset.sum_comm]
    exact Finset.sum_congr rfl fun j _ => by rw [Finset.mul_sum]
  have hT : ∑ j ∈ Finset.range (d + 1), algebraMap ↥W A ϖ ^ (n + d - j) * ζ ^ j * Q.coeff j =
      algebraMap ↥W A ϖ ^ n *
        ∑ j ∈ Finset.range (d + 1), Q.coeff j * ζ ^ j * algebraMap ↥W A ϖ ^ (d - j) := by
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl fun j hj => ?_
    have hj' : j ≤ d := Nat.lt_succ_iff.mp (Finset.mem_range.mp hj)
    rw [show n + d - j = n + (d - j) by omega, pow_add]
    ring
  have hP : ∑ i, Polynomial.aeval ζ (P i) * b i = algebraMap ↥W A (ϖ ^ (n + d)) *
      (∑ j ∈ Finset.range (d + 1), algebraMap ↥W A ϖ ^ (n + d - j) * ζ ^ j * s' j -
        algebraMap ↥W A ϖ ^ d * s) := by
    rw [e1]
    have hp' : ∑ i, Polynomial.aeval ζ (p i) * b i = a - algebraMap ↥W A ϖ ^ (n + d) * s := by
      rw [hps]; ring
    have hq' : ∀ j, ∑ i, Polynomial.aeval ζ (q j i) * b i =
        Q.coeff j - algebraMap ↥W A ϖ ^ (n + d) * s' j := by
      intro j; rw [hqs j]; ring
    simp only [hq']
    rw [hp']
    have hsplit : ∑ j ∈ Finset.range (d + 1), algebraMap ↥W A ϖ ^ (n + d - j) * ζ ^ j *
        (Q.coeff j - algebraMap ↥W A ϖ ^ (n + d) * s' j) =
        ∑ j ∈ Finset.range (d + 1), algebraMap ↥W A ϖ ^ (n + d - j) * ζ ^ j * Q.coeff j -
          algebraMap ↥W A ϖ ^ (n + d) *
            ∑ j ∈ Finset.range (d + 1), algebraMap ↥W A ϖ ^ (n + d - j) * ζ ^ j * s' j := by
      rw [Finset.mul_sum, ← Finset.sum_sub_distrib]
      exact Finset.sum_congr rfl fun j _ => by ring
    rw [hsplit, map_pow]
    linear_combination hstar - hT
  have hcoef := hCt (ϖ ^ (n + d)) P _ hP
  have hbound : ∀ (i : Fin r) (k : ℕ), k < n → ϖ ^ (n - k) ∣ (p i).coeff k := by
    intro i k hk
    have hc : (P i).coeff k = ϖ ^ d * (p i).coeff k -
        ∑ j ∈ Finset.range (d + 1),
          ϖ ^ (n + d - j) * (if j ≤ k then (q j i).coeff (k - j) else 0) := by
      rw [hPdef, Polynomial.coeff_sub, Polynomial.coeff_C_mul, Polynomial.finsetSum_coeff]
      congr 1
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow_mul']
    have hTd : ϖ ^ (n + d - k) ∣ ∑ j ∈ Finset.range (d + 1),
        ϖ ^ (n + d - j) * (if j ≤ k then (q j i).coeff (k - j) else 0) := by
      apply Finset.dvd_sum
      intro j _
      split_ifs with hjk
      · exact Dvd.dvd.mul_right (pow_dvd_pow ϖ (by omega)) _
      · rw [mul_zero]; exact dvd_zero _
    have hPd : ϖ ^ (n + d - k) ∣ (P i).coeff k :=
      dvd_trans (pow_dvd_pow ϖ (by omega)) (hcoef i k)
    have h2 : ϖ ^ (n + d - k) ∣ ϖ ^ d * (p i).coeff k := by
      have h3 := dvd_add hPd hTd
      rw [hc, sub_add_cancel] at h3
      exact h3
    rw [show n + d - k = d + (n - k) by omega, pow_add] at h2
    exact (mul_dvd_mul_iff_left (pow_ne_zero d hϖ)).mp h2

  have hfin : a = ∑ i, Polynomial.aeval ζ (p i) * b i +
      algebraMap ↥W A ϖ ^ n * (algebraMap ↥W A ϖ ^ d * s) := by
    rw [hps, pow_add, mul_assoc]
  rw [hfin]
  apply Ideal.add_mem
  · apply Ideal.sum_mem
    intro i _
    exact Ideal.mul_mem_right _ _ (s2 (p i) (hbound i))
  · exact Ideal.mul_mem_right _ _ (Ideal.pow_mem_pow hϖJ n)

theorem wcpa_dj_lr1k_nsr_gub_bff_dc_box_topology : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [Algebra ↥W A] (ϖ : ↥W) (ζ : A),
      wcBffBase W A ϖ → wcBffNoether W A ζ →
    ∀ n : ℕ, ∃ (e : ↥W) (N : ℕ), e ≠ 0 ∧ e ∈ IsLocalRing.maximalIdeal ↥W ∧
      ∀ a : A, (∃ t : ↥(wcGubBox W A (fun _ : Fin 2 => ζ) e),
          algebraMap A (wcGubGen W A) a =
            algebraMap A (wcGubGen W A) (algebraMap ↥W A ϖ) ^ N * (t : wcGubGen W A)) →
        a ∈ Ideal.span {algebraMap ↥W A ϖ, ζ} ^ n :=
by
  intro Ω _ _ W hdimW hWt A _ _ ϖ ζ hbase hN n
  classical
  obtain ⟨hϖ0, hϖm, hdom, -, hfp, hTF, hRed, -⟩ := hbase
  haveI := hdom
  haveI := hfp
  have hft : Algebra.FiniteType ↥W A := inferInstance
  rcases dc_bt_dichotomy Ω W A ζ hdom hfp hTF hRed hN with hsurj | htf
  ·
    have hne : ∀ w : ↥W, w ≠ 0 → algebraMap ↥W A w ≠ 0 := by
      intro w hw h
      apply one_ne_zero (α := A)
      exact hTF w 1 hw (by rw [h, zero_mul])
    have hunitW : ∀ w : ↥W, w ≠ 0 →
        IsUnit (algebraMap A (wcGubGen W A) (algebraMap ↥W A w)) := by
      intro w hw
      exact IsLocalization.map_units (wcGubGen W A)
        (⟨algebraMap (↥W) A w, Submonoid.mem_map_of_mem _ (mem_nonZeroDivisors_of_ne_zero hw)⟩ :
          Submonoid.map (algebraMap (↥W) A) (nonZeroDivisors ↥W))
    have hinj : Function.Injective (algebraMap A (wcGubGen W A)) := by
      apply IsLocalization.injective (M := Submonoid.map (algebraMap ↥W A) (nonZeroDivisors ↥W))
      rintro _ ⟨w, hw, rfl⟩
      exact mem_nonZeroDivisors_of_ne_zero (hne w (nonZeroDivisors.ne_zero hw))
    obtain ⟨wz, hwz⟩ := hsurj ζ
    by_cases hu : IsUnit wz
    · refine ⟨ϖ, 0, hϖ0, hϖm, fun a _ => ?_⟩
      have hJ : Ideal.span {algebraMap ↥W A ϖ, ζ} = ⊤ := by
        have hmem : ζ ∈ Ideal.span {algebraMap ↥W A ϖ, ζ} :=
          Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton ζ))
        have hζu : IsUnit ζ := by rw [hwz]; exact hu.map _
        exact Ideal.eq_top_of_isUnit_mem _ hmem hζu
      rw [hJ, Ideal.top_pow]
      trivial
    · have hwzm : wz ∈ IsLocalRing.maximalIdeal ↥W := (IsLocalRing.mem_maximalIdeal _).mpr hu
      obtain ⟨e, he0, hem, u, hu'⟩ : ∃ e : ↥W, e ≠ 0 ∧ e ∈ IsLocalRing.maximalIdeal ↥W ∧
          ∃ u, wz = e * u := by
        by_cases h0 : wz = 0
        · exact ⟨ϖ, hϖ0, hϖm, 0, by rw [h0, mul_zero]⟩
        · exact ⟨wz, h0, hwzm, 1, (mul_one _).symm⟩
      refine ⟨e, n, he0, hem, fun a ⟨t, ht⟩ => ?_⟩
      have hgen : algebraMap A (wcGubGen W A) ζ *
          Ring.inverse (algebraMap A (wcGubGen W A) (algebraMap ↥W A e)) =
          algebraMap A (wcGubGen W A) (algebraMap ↥W A u) := by
        rw [hwz, hu', map_mul, map_mul, mul_comm (algebraMap A _ (algebraMap ↥W A e)), mul_assoc,
          Ring.mul_inverse_cancel _ (hunitW e he0), mul_one]
      have hbot : wcGubBox W A (fun _ : Fin 2 => ζ) e ≤ ⊥ := by
        apply Algebra.adjoin_le
        rintro _ ⟨i, rfl⟩
        have h1 := Subalgebra.algebraMap_mem (⊥ : Subalgebra A (wcGubGen W A))
          (algebraMap ↥W A u)
        rw [← hgen] at h1
        exact h1
      obtain ⟨a', ha'⟩ := Algebra.mem_bot.mp (hbot t.2)
      have hae : a = algebraMap ↥W A ϖ ^ n * a' := hinj (by rw [ht, map_mul, map_pow, ha'])
      rw [hae]
      apply Ideal.mul_mem_right
      apply Ideal.pow_mem_pow
      exact Ideal.subset_span (Set.mem_insert _ _)
  ·
    obtain ⟨r, b, hspan, hind⟩ := dc_bt_basis Ω W A ζ hN htf
    have hCt := dc_bt_content Ω W A ζ r b hTF hind
    have hSp := dc_bt_span_pow Ω W hdimW A hft ϖ hϖ0 hϖm ζ r b hspan
    exact ⟨ϖ, n, hϖ0, hϖm, fun a ha => dc_bt_free_estimate Ω W A ϖ hϖ0 ζ r b hTF hSp hCt n a ha⟩

theorem wcpa_dj_lr1k_nsr_gub_bff_dc_ia_pb_section_lift : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (R : Type u) [CommRing R] [IsDomain R] [Algebra ↥W R], Algebra.FiniteType ↥W R →
      (∀ w : ↥W, w ≠ 0 → algebraMap ↥W R w ≠ 0) →
      ringKrullDim (Localization (Submonoid.map (algebraMap ↥W R) (nonZeroDivisors ↥W))) ≤ 1 →
    ∀ t : R, Ideal.span {t} ⊔ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W R) ≠ ⊤ →
      ∃ χ : R →ₐ[↥W] ↥W, χ t ∈ IsLocalRing.maximalIdeal ↥W :=
by
  have t_root : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω) (p : Polynomial ↥W)
      (hp : p.Monic) (hd : p.natDegree ≠ 0),
        ∃ y : ↥W, p.IsRoot y := by
    intro Ω _ _ W p hp hd
    set q := p.map (algebraMap ↥W Ω) with hq
    have hqm : q.Monic := hp.map _
    have hqd : q.degree ≠ 0 := by
      rw [hq, Polynomial.degree_map_eq_of_injective (IsFractionRing.injective ↥W Ω)]
      intro h
      exact hd (Polynomial.natDegree_eq_of_degree_eq_some h)
    obtain ⟨α, hα⟩ := IsAlgClosed.exists_root q hqd
    have hint : IsIntegral ↥W α := ⟨p, hp, by rw [← Polynomial.eval_map]; exact hα⟩
    obtain ⟨y, hy⟩ := IsIntegrallyClosed.isIntegral_iff.mp hint
    refine ⟨y, ?_⟩
    apply IsFractionRing.injective ↥W Ω
    rw [map_zero, ← Polynomial.eval₂_at_apply, ← Polynomial.eval_map, hy]
    exact hα
  have t_split : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω) (C : Type u)
      [CommRing C] [IsDomain C] [Algebra ↥W C],
        Algebra.IsIntegral ↥W C →
      Function.Surjective (algebraMap ↥W C) := by
    intro Ω _ _ W C _ _ _
    intro hI c
    obtain ⟨p, hp, hpc⟩ := hI.isIntegral c
    have key : ∀ n : ℕ, ∀ p : Polynomial ↥W, p.Monic → p.natDegree = n → Polynomial.eval₂ (algebraMap ↥W C) c p = 0 →
        ∃ y : ↥W, algebraMap ↥W C y = c := by
      intro n
      induction n with
      | zero =>
        intro p hp hn hpc
        rw [hp.natDegree_eq_zero] at hn
        rw [hn, Polynomial.eval₂_one] at hpc
        exact absurd hpc one_ne_zero
      | succ n ih =>
        intro p hp hn hpc
        obtain ⟨y, hy⟩ := t_root Ω W p hp (by omega)
        have hfac := Polynomial.mul_divByMonic_eq_iff_isRoot.mpr hy
        rw [← hfac, Polynomial.eval₂_mul] at hpc
        rcases mul_eq_zero.mp hpc with h | h
        · refine ⟨y, ?_⟩
          rw [Polynomial.eval₂_sub, Polynomial.eval₂_X, Polynomial.eval₂_C, sub_eq_zero] at h
          exact h.symm
        · have hm2 : (p /ₘ (Polynomial.X - Polynomial.C y)).Monic :=
            Polynomial.Monic.of_mul_monic_left (Polynomial.monic_X_sub_C y) (hfac.symm ▸ hp)
          refine ih _ hm2 ?_ h
          have := Polynomial.Monic.natDegree_mul (Polynomial.monic_X_sub_C y) hm2
          rw [hfac, hn, Polynomial.natDegree_X_sub_C] at this
          omega
    exact key _ p hp rfl hpc
  have t_res : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω),
        IsAlgClosed (IsLocalRing.ResidueField ↥W) := by
    intro Ω _ _ W
    apply IsAlgClosed.of_exists_root
    intro p hpm hirr
    have hlift : p ∈ Polynomial.lifts (IsLocalRing.residue ↥W) := by
      rw [Polynomial.lifts_iff_coeff_lifts]
      intro n
      exact IsLocalRing.residue_surjective _
    obtain ⟨q, hqp, hqd, hqm⟩ := Polynomial.lifts_and_degree_eq_and_monic hlift hpm
    have hd : q.natDegree ≠ 0 := by
      intro h
      have h1 : p.degree = 0 := by
        rw [← hqd, Polynomial.degree_eq_natDegree hqm.ne_zero, h]; rfl
      exact (Polynomial.degree_pos_of_irreducible hirr).ne' h1
    obtain ⟨y, hy⟩ := t_root Ω W q hqm hd
    refine ⟨IsLocalRing.residue ↥W y, ?_⟩
    rw [← hqp, Polynomial.eval_map, Polynomial.eval₂_at_apply, hy.eq_zero, map_zero]
  have t_mvic : ∀ (A : Type u) [CommRing A] [IsDomain A] [IsIntegrallyClosed A] (n : ℕ),
        IsIntegrallyClosed (MvPolynomial (Fin n) A) := by
    intro A _ _ _ n
    induction n with
    | zero => exact IsIntegrallyClosed.of_equiv (MvPolynomial.isEmptyAlgEquiv A (Fin 0)).symm.toRingEquiv
    | succ n ih =>
      haveI := ih
      exact IsIntegrallyClosed.of_equiv (MvPolynomial.finSuccEquiv A n).symm.toRingEquiv
  have t_content : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (s : ℕ)
      (f : MvPolynomial (Fin s) ↥W),
        f ≠ 0 → ∃ (c : ↥W) (g : MvPolynomial (Fin s) ↥W),
        f = MvPolynomial.C c * g ∧ ∃ m, IsUnit (g.coeff m) := by
    intro Ω _ W s f
    classical
    intro hf
    have hmin : ∀ T : Finset (Fin s →₀ ℕ), T.Nonempty → ∃ m₀ ∈ T, ∀ m ∈ T, f.coeff m₀ ∣ f.coeff m := by
      intro T
      induction T using Finset.induction_on with
      | empty => intro h; exact absurd h Finset.not_nonempty_empty
      | insert a T haT ih =>
        intro _
        rcases T.eq_empty_or_nonempty with hT | hT
        · refine ⟨a, Finset.mem_insert_self _ _, ?_⟩
          intro m hm
          rw [hT] at hm
          rw [Finset.mem_insert] at hm
          rcases hm with hm | hm
          · rw [hm]
          · simp at hm
        · obtain ⟨m₀, hm₀, hdiv⟩ := ih hT
          rcases ValuationRing.dvd_total (f.coeff a) (f.coeff m₀) with h | h
          · refine ⟨a, Finset.mem_insert_self _ _, ?_⟩
            intro m hm
            rcases Finset.mem_insert.mp hm with hm | hm
            · rw [hm]
            · exact h.trans (hdiv m hm)
          · refine ⟨m₀, Finset.mem_insert_of_mem hm₀, ?_⟩
            intro m hm
            rcases Finset.mem_insert.mp hm with hm | hm
            · rw [hm]; exact h
            · exact hdiv m hm
    obtain ⟨m₀, hm₀, hdiv⟩ := hmin f.support (MvPolynomial.support_nonempty.mpr hf)
    have hc0 : f.coeff m₀ ≠ 0 := MvPolynomial.mem_support_iff.mp hm₀
    choose d hd using hdiv
    set g : MvPolynomial (Fin s) ↥W := ∑ m ∈ f.support.attach, MvPolynomial.monomial m.1 (d m.1 m.2) with hg
    have hgc : ∀ m (hm : m ∈ f.support), g.coeff m = d m hm := by
      intro m hm
      rw [hg, MvPolynomial.coeff_sum]
      rw [Finset.sum_eq_single ⟨m, hm⟩]
      · rw [MvPolynomial.coeff_monomial, if_pos rfl]
      · intro b _ hb
        rw [MvPolynomial.coeff_monomial, if_neg]
        intro h
        exact hb (Subtype.ext h)
      · intro h
        exact absurd (Finset.mem_attach _ _) h
    have hgc' : ∀ m, m ∉ f.support → g.coeff m = 0 := by
      intro m hm
      rw [hg, MvPolynomial.coeff_sum]
      apply Finset.sum_eq_zero
      intro b _
      rw [MvPolynomial.coeff_monomial, if_neg]
      intro h
      exact hm (h ▸ b.2)
    refine ⟨f.coeff m₀, g, ?_, m₀, ?_⟩
    · refine MvPolynomial.ext _ _ (fun m => ?_)
      rw [MvPolynomial.coeff_C_mul]
      by_cases hm : m ∈ f.support
      · rw [hgc m hm]; exact hd m hm
      · rw [hgc' m hm, mul_zero]
        exact MvPolynomial.notMem_support_iff.mp hm
    · rw [hgc m₀ hm₀]
      have h1 := hd m₀ hm₀
      have h2 : d m₀ hm₀ = 1 := by
        have : f.coeff m₀ * (d m₀ hm₀ - 1) = 0 := by rw [mul_sub, ← h1, mul_one, sub_self]
        rcases mul_eq_zero.mp this with h | h
        · exact absurd h hc0
        · exact sub_eq_zero.mp h
      rw [h2]; exact isUnit_one
  have t_artin : ∀ (W' R : Type u) [CommRing W'] [CommRing R] [Algebra W' R] (𝔪 : Ideal W') [𝔪.IsMaximal]
      (I : Ideal R),
        𝔪.map (algebraMap W' R) ≤ I →
      (∃ (N : ℕ) (m : Fin N → R), ∀ x : R, ∃ c : Fin N → W', x - ∑ j, c j • m j ∈ I) →
      (∀ Q : Ideal R, Q.IsPrime → I ≤ Q → Q.IsMaximal) ∧ {Q : Ideal R | Q.IsPrime ∧ I ≤ Q}.Finite := by
    intro W' R _ _ _ 𝔪 _ I
    intro hI ⟨N, m, hm⟩
    letI : Field (W' ⧸ 𝔪) := Ideal.Quotient.field 𝔪
    have h : 𝔪 ≤ I.comap (algebraMap W' R) := Ideal.map_le_iff_le_comap.mp hI
    letI alg : Algebra (W' ⧸ 𝔪) (R ⧸ I) := Ideal.Quotient.algebraQuotientOfLEComap h
    have halg : ∀ c : W', algebraMap (W' ⧸ 𝔪) (R ⧸ I) (Ideal.Quotient.mk 𝔪 c) =
        Ideal.Quotient.mk I (algebraMap W' R c) := fun c => rfl
    haveI : Module.Finite (W' ⧸ 𝔪) (R ⧸ I) := by
      classical
      refine ⟨⟨Finset.univ.image (fun j => Ideal.Quotient.mk I (m j)), ?_⟩⟩
      rw [eq_top_iff]
      intro y _
      obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective y
      obtain ⟨c, hc⟩ := hm x
      have e : Ideal.Quotient.mk I x = ∑ j, Ideal.Quotient.mk 𝔪 (c j) • Ideal.Quotient.mk I (m j) := by
        rw [Ideal.Quotient.eq.mpr hc, map_sum]
        refine Finset.sum_congr rfl (fun j _ => ?_)
        rw [Algebra.smul_def, Algebra.smul_def, map_mul, halg]
      rw [e]
      refine Submodule.sum_mem _ (fun j _ => Submodule.smul_mem _ _ (Submodule.subset_span ?_))
      exact Finset.mem_image_of_mem _ (Finset.mem_univ j)
    haveI : IsArtinianRing (R ⧸ I) := IsArtinianRing.of_finite (W' ⧸ 𝔪) (R ⧸ I)
    have hcm : ∀ Q : Ideal R, Q.IsPrime → I ≤ Q →
        (Q.map (Ideal.Quotient.mk I)).IsPrime ∧ (Q.map (Ideal.Quotient.mk I)).comap (Ideal.Quotient.mk I) = Q := by
      intro Q hQ hIQ
      refine ⟨Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective (by rw [Ideal.mk_ker]; exact hIQ), ?_⟩
      rw [Ideal.comap_map_of_surjective' _ Ideal.Quotient.mk_surjective, Ideal.mk_ker]
      exact sup_eq_left.mpr hIQ
    refine ⟨fun Q hQ hIQ => ?_, ?_⟩
    · obtain ⟨hP, hc⟩ := hcm Q hQ hIQ
      haveI := hP
      haveI : (Q.map (Ideal.Quotient.mk I)).IsMaximal := IsArtinianRing.isMaximal_of_isPrime _
      rw [← hc]
      exact Ideal.comap_isMaximal_of_surjective _ Ideal.Quotient.mk_surjective
    · refine ((IsArtinianRing.setOf_isPrime_finite (R ⧸ I)).image (Ideal.comap (Ideal.Quotient.mk I))).subset ?_
      rintro Q ⟨hQ, hIQ⟩
      obtain ⟨hP, hc⟩ := hcm Q hQ hIQ
      exact ⟨_, hP, hc⟩
  have t_qf : ∀ (S R : Type u) [CommRing S] [CommRing R] [Algebra S R],
        Algebra.FiniteType S R →
      ∀ (𝔫 : Ideal R) [𝔫.IsPrime],
      (∀ Q : Ideal R, Q.IsPrime → Q.comap (algebraMap S R) = 𝔫.comap (algebraMap S R) → Q.IsMaximal) →
      {Q : Ideal R | Q.IsPrime ∧ Q.comap (algebraMap S R) = 𝔫.comap (algebraMap S R)}.Finite →
      Algebra.QuasiFiniteAt S 𝔫 := by
    intro S R _ _ _
    intro hft 𝔫 h𝔫 hmax hfin
    set q : PrimeSpectrum R := ⟨𝔫, h𝔫⟩ with hq
    have := Algebra.QuasiFiniteAt.of_isOpen_singleton_fiber (R := S) q
    apply this
    rw [← isClosed_compl_iff]
    set T : Set (PrimeSpectrum R) := {x | x ≠ q ∧ x.asIdeal.comap (algebraMap S R) = 𝔫.comap (algebraMap S R)}
      with hT
    have hTfin : T.Finite := by
      refine (hfin.preimage (f := PrimeSpectrum.asIdeal) ?_).subset ?_
      · intro a _ b _ hab; exact PrimeSpectrum.ext hab
      · rintro x ⟨_, hx⟩; exact ⟨x.2, hx⟩
    have hTcl : IsClosed (⋃ x ∈ T, ({x} : Set (PrimeSpectrum R))) := by
      refine hTfin.isClosed_biUnion (fun x hx => ?_)
      rw [PrimeSpectrum.isClosed_singleton_iff_isMaximal]
      exact hmax x.asIdeal x.2 hx.2
    convert hTcl.preimage continuous_subtype_val using 1
    ext y
    simp only [Set.mem_compl_iff, Set.mem_singleton_iff, Set.mem_preimage, Set.mem_iUnion, exists_prop]
    constructor
    · intro hy
      refine ⟨y.1, ⟨fun h => hy (Subtype.ext h), congrArg PrimeSpectrum.asIdeal y.2⟩, rfl⟩
    · rintro ⟨x, ⟨hxq, _⟩, hx⟩ h
      apply hxq
      rw [← hx, h]
  have t_extend : ∀ (W S R : Type u) [CommRing W] [CommRing S] [CommRing R] [Algebra W S]
      [Algebra S R] [Algebra W R] [IsScalarTower W S R] (r : R) (hr : IsIntegral S r),
        (∀ x : R, ∃ m : ℕ, IsIntegral S (r ^ m * x)) →
      ∀ χB : ↥(integralClosure S R) →ₐ[W] W, IsUnit (χB ⟨r, hr⟩) →
      ∃ χ : R →ₐ[W] W, ∀ b : ↥(integralClosure S R), χ (b : R) = χB b := by
    intro W S R _ _ _ _ _ _ _ r hr
    intro hx χB hu
    choose mf hmf using hx
    set v : W := ↑(hu.unit⁻¹) with hv
    have huv : χB ⟨r, hr⟩ * v = 1 := by rw [hv]; exact hu.mul_val_inv
    let F : R → W := fun x => χB ⟨r ^ mf x * x, hmf x⟩ * v ^ mf x
    have key : ∀ (x : R) (m : ℕ) (hm : IsIntegral S (r ^ m * x)),
        F x = χB ⟨r ^ m * x, hm⟩ * v ^ m := by
      intro x m hm
      have e : (⟨r, hr⟩ : ↥(integralClosure S R)) ^ m * ⟨r ^ mf x * x, hmf x⟩ =
          (⟨r, hr⟩ : ↥(integralClosure S R)) ^ mf x * ⟨r ^ m * x, hm⟩ := by
        apply Subtype.ext
        simp only [Subalgebra.coe_mul, SubmonoidClass.coe_pow]
        ring
      have hrel := congrArg χB e
      rw [map_mul, map_mul, map_pow, map_pow] at hrel
      have hpm : (χB ⟨r, hr⟩ * v) ^ m = 1 := by rw [huv, one_pow]
      have hpm0 : (χB ⟨r, hr⟩ * v) ^ mf x = 1 := by rw [huv, one_pow]
      show χB ⟨r ^ mf x * x, hmf x⟩ * v ^ mf x = χB ⟨r ^ m * x, hm⟩ * v ^ m
      linear_combination (v ^ mf x * v ^ m) * hrel + (-(χB ⟨r ^ mf x * x, hmf x⟩ * v ^ mf x)) * hpm
        + (χB ⟨r ^ m * x, hm⟩ * v ^ m) * hpm0
    have hpowint : ∀ (x : R) (a : ℕ), IsIntegral S (r ^ (a + mf x) * x) := by
      intro x a
      have : r ^ (a + mf x) * x = r ^ a * (r ^ mf x * x) := by ring
      rw [this]
      exact (hr.pow a).mul (hmf x)
    have hzero : ∀ x : R, IsIntegral S x → IsIntegral S (r ^ 0 * x) := by
      intro x hx; simpa using hx
    have hres : ∀ b : ↥(integralClosure S R), F (b : R) = χB b := by
      intro b
      rw [key (b : R) 0 (hzero _ b.2)]
      simp only [pow_zero, mul_one]
      congr 1
      apply Subtype.ext
      simp
    have h1 : F 1 = 1 := by
      have := hres 1
      rw [map_one] at this
      simpa using this
    have h2 : ∀ x y : R, F (x * y) = F x * F y := by
      intro x y
      have hxy : IsIntegral S (r ^ (mf x + mf y) * (x * y)) := by
        have : r ^ (mf x + mf y) * (x * y) = (r ^ mf x * x) * (r ^ mf y * y) := by ring
        rw [this]; exact (hmf x).mul (hmf y)
      rw [key (x * y) _ hxy]
      have e : (⟨r ^ (mf x + mf y) * (x * y), hxy⟩ : ↥(integralClosure S R)) =
          ⟨r ^ mf x * x, hmf x⟩ * ⟨r ^ mf y * y, hmf y⟩ := by
        apply Subtype.ext
        simp only [Subalgebra.coe_mul]
        ring
      rw [e, map_mul]
      show _ = (χB ⟨r ^ mf x * x, hmf x⟩ * v ^ mf x) * (χB ⟨r ^ mf y * y, hmf y⟩ * v ^ mf y)
      ring
    have h3 : F 0 = 0 := by
      have := hres 0
      rw [map_zero] at this
      simpa using this
    have h4 : ∀ x y : R, F (x + y) = F x + F y := by
      intro x y
      have hx' := hpowint x (mf y)
      have hy' : IsIntegral S (r ^ (mf y + mf x) * y) := by
        rw [add_comm]; exact hpowint y (mf x)
      have hxy : IsIntegral S (r ^ (mf y + mf x) * (x + y)) := by
        rw [mul_add]; exact hx'.add hy'
      rw [key (x + y) _ hxy, key x _ hx', key y _ hy']
      have e : (⟨r ^ (mf y + mf x) * (x + y), hxy⟩ : ↥(integralClosure S R)) =
          ⟨r ^ (mf y + mf x) * x, hx'⟩ + ⟨r ^ (mf y + mf x) * y, hy'⟩ := by
        apply Subtype.ext
        simp only [Subalgebra.coe_add]
        ring
      rw [e, map_add, add_mul]
    have h5 : ∀ w : W, F (algebraMap W R w) = w := by
      intro w
      have := hres (algebraMap W ↥(integralClosure S R) w)
      rw [AlgHom.commutes, Algebra.algebraMap_self, RingHom.id_apply] at this
      exact this
    let φ : R →+* W := { toFun := F, map_one' := h1, map_mul' := h2, map_zero' := h3, map_add' := h4 }
    exact ⟨{ φ with commutes' := h5 }, hres⟩
  have t_intpt : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω) (hW : W ≠ ⊤) (s : ℕ)
      (B : Type u) [CommRing B] [IsDomain B] [Algebra (MvPolynomial (Fin s) ↥W) B] [Algebra ↥W B]
      [IsScalarTower ↥W (MvPolynomial (Fin s) ↥W) B]
      (hinj : Function.Injective (algebraMap (MvPolynomial (Fin s) ↥W) B))
      (hint : Algebra.IsIntegral (MvPolynomial (Fin s) ↥W) B) (𝔮 : Ideal B) (h𝔮 : 𝔮.IsPrime)
      (hX : ∀ i : Fin s, algebraMap (MvPolynomial (Fin s) ↥W) B (MvPolynomial.X i) ∈ 𝔮)
      (hm : ∀ w ∈ IsLocalRing.maximalIdeal ↥W, algebraMap ↥W B w ∈ 𝔮),
        ∃ χ : B →ₐ[↥W] ↥W, (∀ b ∈ 𝔮, χ b ∈ IsLocalRing.maximalIdeal ↥W) ∧
        (∀ b ∉ 𝔮, IsUnit (χ b)) := by
    intro Ω _ _ W hW s B _ _ _ _ _ hinj hint 𝔮 h𝔮 hX hm
    classical
    set S := MvPolynomial (Fin s) ↥W with hS
    set κ : S →+* ↥W := MvPolynomial.constantCoeff with hκ

    obtain ⟨ϖ, hϖm, hϖ0⟩ : ∃ ϖ : ↥W, ϖ ∈ IsLocalRing.maximalIdeal ↥W ∧ ϖ ≠ 0 := by
      obtain ⟨x, hx⟩ : ∃ x : Ω, x ∉ W := by
        by_contra h
        push_neg at h
        exact hW (eq_top_iff.mpr (fun x _ => h x))
      have hx0 : x ≠ 0 := fun h => hx (h ▸ W.zero_mem)
      have hxi : x⁻¹ ∈ W := (W.mem_or_inv_mem x).resolve_left hx
      refine ⟨⟨x⁻¹, hxi⟩, ?_, ?_⟩
      · rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
        intro hu
        apply hx
        have h1 : x⁻¹ * (((hu.unit⁻¹ : (↥W)ˣ) : ↥W) : Ω) = 1 := congrArg Subtype.val hu.mul_val_inv
        have h2 : x = (((hu.unit⁻¹ : (↥W)ˣ) : ↥W) : Ω) := by
          have := congrArg (fun a => x * a) h1
          simp only [mul_one, ← mul_assoc, mul_inv_cancel₀ hx0, one_mul] at this
          exact this.symm
        rw [h2]; exact (((hu.unit⁻¹ : (↥W)ˣ) : ↥W)).2
      · intro h
        exact inv_ne_zero hx0 (congrArg Subtype.val h)

    have hcomp : ∀ J : Ideal B, (∀ i, algebraMap S B (MvPolynomial.X i) ∈ J) →
        (Ideal.Quotient.mk J).comp (algebraMap S B) =
          (Ideal.Quotient.mk J).comp ((algebraMap ↥W B).comp κ) := by
      intro J hJ
      apply MvPolynomial.ringHom_ext
      · intro w
        simp only [RingHom.comp_apply, hκ, MvPolynomial.constantCoeff_C]
        rw [IsScalarTower.algebraMap_apply ↥W S B w]
        rfl
      · intro i
        simp only [RingHom.comp_apply, hκ, MvPolynomial.constantCoeff_X, map_zero]
        exact Ideal.Quotient.eq_zero_iff_mem.mpr (hJ i)
    have hAWS : ∀ w : ↥W, algebraMap S B (MvPolynomial.C w) = algebraMap ↥W B w := by
      intro w
      rw [IsScalarTower.algebraMap_apply ↥W S B w]
      rfl
    set p : Ideal S := RingHom.ker κ with hp
    haveI hpp : p.IsPrime := RingHom.ker_isPrime κ
    have hlt : p < Ideal.under S 𝔮 := by
      rw [SetLike.lt_iff_le_and_exists]
      refine ⟨fun f hf => ?_, MvPolynomial.C ϖ, ?_, ?_⟩
      · have h1 := congrArg (fun φ => φ f) (hcomp 𝔮 hX)
        simp only [RingHom.comp_apply] at h1
        rw [RingHom.mem_ker.mp hf, map_zero, map_zero] at h1
        show algebraMap S B f ∈ 𝔮
        exact (Ideal.Quotient.eq_zero_iff_mem (I := 𝔮)).mp h1
      · show algebraMap S B (MvPolynomial.C ϖ) ∈ 𝔮
        rw [hAWS]; exact hm ϖ hϖm
      · intro h
        rw [hp, RingHom.mem_ker, hκ, MvPolynomial.constantCoeff_C] at h
        exact hϖ0 h
    haveI : IsIntegrallyClosed S := t_mvic ↥W s
    haveI : FaithfulSMul S B := (faithfulSMul_iff_algebraMap_injective S B).mpr hinj
    haveI := hint
    haveI := h𝔮
    obtain ⟨P, hPq, hP, hPlies⟩ := Algebra.HasGoingDown.exists_ideal_le_liesOver_of_lt (p := p) 𝔮 hlt
    haveI := hP
    have hunder : p = Ideal.under S P := hPlies.over
    have hXP : ∀ i, algebraMap S B (MvPolynomial.X i) ∈ P := by
      intro i
      have : MvPolynomial.X i ∈ Ideal.under S P := by
        rw [← hunder, hp, RingHom.mem_ker, hκ, MvPolynomial.constantCoeff_X]
      exact this
    have hcompP := hcomp P hXP
    have hintC : Algebra.IsIntegral ↥W (B ⧸ P) := by
      constructor
      intro c
      obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective c
      obtain ⟨f, hfm, hf⟩ := hint.isIntegral b
      refine ⟨f.map κ, hfm.map κ, ?_⟩
      rw [Polynomial.eval₂_map]
      have e : (algebraMap ↥W (B ⧸ P)).comp κ = (Ideal.Quotient.mk P).comp (algebraMap S B) := by
        rw [hcompP]; rfl
      rw [e, ← Polynomial.hom_eval₂, hf, map_zero]
    have hsurj := t_split Ω W (B ⧸ P) hintC
    have hinjC : Function.Injective (algebraMap ↥W (B ⧸ P)) := by
      rw [injective_iff_map_eq_zero]
      intro w hw
      have h1 : algebraMap ↥W B w ∈ P := by
        rw [← Ideal.Quotient.eq_zero_iff_mem]
        exact hw
      rw [← hAWS] at h1
      have h2 : MvPolynomial.C w ∈ Ideal.under S P := h1
      rw [← hunder, hp, RingHom.mem_ker, hκ, MvPolynomial.constantCoeff_C] at h2
      exact h2
    set e := AlgEquiv.ofBijective (Algebra.ofId ↥W (B ⧸ P)) ⟨hinjC, hsurj⟩ with he
    set χ : B →ₐ[↥W] ↥W := e.symm.toAlgHom.comp (Ideal.Quotient.mkₐ ↥W P) with hχ
    have hstar : ∀ b : B, b - algebraMap ↥W B (χ b) ∈ 𝔮 := by
      intro b
      apply hPq
      rw [← Ideal.Quotient.eq]
      have h1 : e (χ b) = Ideal.Quotient.mk P b := by
        rw [hχ]
        exact e.apply_symm_apply (Ideal.Quotient.mk P b)
      rw [← h1]
      rfl
    refine ⟨χ, fun b hb => ?_, fun b hb => ?_⟩
    · by_contra hc
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, not_not] at hc
      apply h𝔮.ne_top
      apply Ideal.eq_top_of_isUnit_mem _ _ (hc.map (algebraMap ↥W B))
      have := 𝔮.sub_mem hb (hstar b)
      simpa using this
    · by_contra hc
      have hc' : χ b ∈ IsLocalRing.maximalIdeal ↥W := by
        rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]; exact hc
      apply hb
      have := 𝔮.add_mem (hstar b) (hm _ hc')
      simpa using this
  have t_nn : ∀ (k Rb : Type u) [Field k] [IsAlgClosed k] [CommRing Rb] [Algebra k Rb],
        Algebra.FiniteType k Rb → ∀ 𝔫 : Ideal Rb, 𝔫.IsMaximal → ∃ (s : ℕ) (y : Fin s → Rb),
        (∀ i, y i ∈ 𝔫) ∧ Function.Injective (MvPolynomial.aeval y : MvPolynomial (Fin s) k →ₐ[k] Rb) ∧
        ∃ (N : ℕ) (m : Fin N → Rb), ∀ x : Rb, ∃ c : Fin N → k,
          x - ∑ j, c j • m j ∈ Ideal.span (Set.range y) := by
    intro k Rb _ _ _ _
    intro hft 𝔫 hmax
    haveI : Nontrivial Rb := ⟨⟨0, 1, fun h => hmax.ne_top ((Ideal.eq_top_iff_one _).mpr (h ▸ 𝔫.zero_mem))⟩⟩
    obtain ⟨s, g, hginj, hgfin⟩ := exists_finite_inj_algHom_of_fg k Rb

    letI : Field (Rb ⧸ 𝔫) := Ideal.Quotient.field 𝔫
    haveI : Algebra.FiniteType k (Rb ⧸ 𝔫) := Algebra.FiniteType.quotient k 𝔫
    haveI : Module.Finite k (Rb ⧸ 𝔫) := finite_of_finite_type_of_isJacobsonRing k (Rb ⧸ 𝔫)
    haveI : Algebra.IsIntegral k (Rb ⧸ 𝔫) := Algebra.IsIntegral.of_finite k (Rb ⧸ 𝔫)
    have hbij : Function.Bijective (algebraMap k (Rb ⧸ 𝔫)) :=
      IsAlgClosed.algebraMap_bijective_of_isIntegral
    choose c hc using fun i : Fin s => hbij.2 (Ideal.Quotient.mk 𝔫 (g (MvPolynomial.X i)))
    set y : Fin s → Rb := fun i => g (MvPolynomial.X i) - algebraMap k Rb (c i) with hy
    have hy𝔫 : ∀ i, y i ∈ 𝔫 := by
      intro i
      rw [← Ideal.Quotient.eq_zero_iff_mem, hy]
      simp only [map_sub]
      rw [Ideal.Quotient.mk_algebraMap, hc i, sub_self]
    set τ : MvPolynomial (Fin s) k →ₐ[k] MvPolynomial (Fin s) k :=
      MvPolynomial.aeval (fun i => MvPolynomial.X i - MvPolynomial.C (c i)) with hτ
    set τ' : MvPolynomial (Fin s) k →ₐ[k] MvPolynomial (Fin s) k :=
      MvPolynomial.aeval (fun i => MvPolynomial.X i + MvPolynomial.C (c i)) with hτ'
    have hτC : ∀ a : k, τ (MvPolynomial.C a) = MvPolynomial.C a := by
      intro a; rw [hτ, MvPolynomial.aeval_C, MvPolynomial.algebraMap_eq]
    have hτ'C : ∀ a : k, τ' (MvPolynomial.C a) = MvPolynomial.C a := by
      intro a; rw [hτ', MvPolynomial.aeval_C, MvPolynomial.algebraMap_eq]
    have hττ' : τ.comp τ' = AlgHom.id k _ := by
      apply MvPolynomial.algHom_ext
      intro i
      rw [AlgHom.comp_apply, hτ', MvPolynomial.aeval_X, map_add, hτC, hτ, MvPolynomial.aeval_X]
      simp
    have hτ'τ : τ'.comp τ = AlgHom.id k _ := by
      apply MvPolynomial.algHom_ext
      intro i
      rw [AlgHom.comp_apply, hτ, MvPolynomial.aeval_X, map_sub, hτ'C, hτ', MvPolynomial.aeval_X]
      simp
    have hgC : ∀ a : k, g (MvPolynomial.C a) = algebraMap k Rb a := by
      intro a; rw [← MvPolynomial.algebraMap_eq, AlgHom.commutes]
    have hay : (MvPolynomial.aeval y : MvPolynomial (Fin s) k →ₐ[k] Rb) = g.comp τ := by
      apply MvPolynomial.algHom_ext
      intro i
      rw [MvPolynomial.aeval_X, AlgHom.comp_apply, hτ, MvPolynomial.aeval_X, map_sub, hgC]
    have hayτ' : (MvPolynomial.aeval y : MvPolynomial (Fin s) k →ₐ[k] Rb).comp τ' = g := by
      rw [hay, AlgHom.comp_assoc, hττ', AlgHom.comp_id]
    refine ⟨s, y, hy𝔫, ?_, ?_⟩
    · rw [hay]
      intro a b hab
      have h1 := hginj hab
      have e1 : τ' (τ a) = a := by rw [← AlgHom.comp_apply, hτ'τ, AlgHom.id_apply]
      have e2 : τ' (τ b) = b := by rw [← AlgHom.comp_apply, hτ'τ, AlgHom.id_apply]
      have h1' : τ a = τ b := h1
      rw [← e1, ← e2, h1']
    ·
      have hgen : ∃ (N : ℕ) (m : Fin N → Rb), ∀ x : Rb, ∃ a : Fin N → MvPolynomial (Fin s) k,
          x = ∑ j, g (a j) * m j := by
        letI : Algebra (MvPolynomial (Fin s) k) Rb := g.toRingHom.toAlgebra
        haveI : Module.Finite (MvPolynomial (Fin s) k) Rb := hgfin
        obtain ⟨N, m, hm⟩ := Module.Finite.exists_fin (R := MvPolynomial (Fin s) k) (M := Rb)
        refine ⟨N, m, fun x => ?_⟩
        have hx : x ∈ Submodule.span (MvPolynomial (Fin s) k) (Set.range m) := by
          rw [hm]; exact Submodule.mem_top
        obtain ⟨a, ha⟩ := (Submodule.mem_span_range_iff_exists_fun _).mp hx
        exact ⟨a, ha.symm⟩
      obtain ⟨N, m, hm⟩ := hgen
      have hcc : ∀ b : MvPolynomial (Fin s) k,
          MvPolynomial.aeval y b - algebraMap k Rb (MvPolynomial.constantCoeff b) ∈
            Ideal.span (Set.range y) := by
        intro b
        induction b using MvPolynomial.induction_on with
        | C a =>
          rw [MvPolynomial.aeval_C, MvPolynomial.constantCoeff_C, sub_self]
          exact Ideal.zero_mem _
        | add p q hp hq =>
          rw [map_add, map_add, map_add]
          have := Ideal.add_mem _ hp hq
          convert this using 1
          ring
        | mul_X p i hp =>
          rw [map_mul, map_mul, MvPolynomial.aeval_X, MvPolynomial.constantCoeff_X, mul_zero,
            map_zero, sub_zero]
          exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨i, rfl⟩)
      refine ⟨N, m, fun x => ?_⟩
      obtain ⟨a, ha⟩ := hm x
      refine ⟨fun j => MvPolynomial.constantCoeff (τ' (a j)), ?_⟩
      have e : x - ∑ j, (MvPolynomial.constantCoeff (τ' (a j))) • m j =
          ∑ j, (MvPolynomial.aeval y (τ' (a j)) -
            algebraMap k Rb (MvPolynomial.constantCoeff (τ' (a j)))) * m j := by
        rw [ha, ← Finset.sum_sub_distrib]
        refine Finset.sum_congr rfl (fun j _ => ?_)
        rw [Algebra.smul_def, sub_mul]
        congr 2
        rw [← AlgHom.comp_apply, hayτ']
      rw [e]
      exact Ideal.sum_mem _ (fun j _ => Ideal.mul_mem_right _ _ (hcc _))
  have t_param : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω),
        IsAlgClosed (IsLocalRing.ResidueField ↥W) →
      (∀ (k Rb : Type u) [Field k] [IsAlgClosed k] [CommRing Rb] [Algebra k Rb],
        Algebra.FiniteType k Rb → ∀ 𝔫 : Ideal Rb, 𝔫.IsMaximal → ∃ (s : ℕ) (y : Fin s → Rb),
        (∀ i, y i ∈ 𝔫) ∧ Function.Injective (MvPolynomial.aeval y : MvPolynomial (Fin s) k →ₐ[k] Rb) ∧
        ∃ (N : ℕ) (m : Fin N → Rb), ∀ x : Rb, ∃ c : Fin N → k,
          x - ∑ j, c j • m j ∈ Ideal.span (Set.range y)) →
      ∀ (R : Type u) [CommRing R] [Algebra ↥W R], Algebra.FiniteType ↥W R →
      ∀ 𝔫 : Ideal R, 𝔫.IsMaximal → (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W R) ≤ 𝔫 →
      ∃ (s : ℕ) (z : Fin s → R), (∀ i, z i ∈ 𝔫) ∧
        (∀ g : MvPolynomial (Fin s) ↥W, MvPolynomial.aeval z g ∈
          (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W R) →
          ∀ m, g.coeff m ∈ IsLocalRing.maximalIdeal ↥W) ∧
        ∃ (N : ℕ) (mm : Fin N → R), ∀ x : R, ∃ c : Fin N → ↥W,
          x - ∑ j, c j • mm j ∈ Ideal.span (Set.range z) ⊔
            (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W R) := by
    intro Ω _ _ W
    intro hres hnn R _ _ hft 𝔫 hmax hI𝔫
    set mW := IsLocalRing.maximalIdeal ↥W with hmW
    set I₀ := mW.map (algebraMap ↥W R) with hI₀
    letI kF : Field (↥W ⧸ mW) := Ideal.Quotient.field mW
    haveI hkac : IsAlgClosed (↥W ⧸ mW) := hres
    haveI : Algebra.FiniteType ↥W (R ⧸ I₀) := Algebra.FiniteType.quotient ↥W I₀
    haveI : Algebra.FiniteType (↥W ⧸ mW) (R ⧸ I₀) :=
      Algebra.FiniteType.of_restrictScalars_finiteType ↥W (↥W ⧸ mW) (R ⧸ I₀)
    have halg : ∀ w : ↥W, algebraMap (↥W ⧸ mW) (R ⧸ I₀) (Ideal.Quotient.mk mW w) =
        Ideal.Quotient.mk I₀ (algebraMap ↥W R w) := by
      intro w
      rw [Ideal.Quotient.mk_algebraMap, IsScalarTower.algebraMap_apply ↥W (↥W ⧸ mW) (R ⧸ I₀),
        Ideal.Quotient.algebraMap_eq]
    have hker : RingHom.ker (Ideal.Quotient.mk I₀) = I₀ := Ideal.mk_ker
    have hcm : ∀ J : Ideal R, I₀ ≤ J → (J.map (Ideal.Quotient.mk I₀)).comap (Ideal.Quotient.mk I₀) = J := by
      intro J hJ
      rw [Ideal.comap_map_of_surjective' _ Ideal.Quotient.mk_surjective, hker]
      exact sup_eq_left.mpr hJ
    have hmax' : (𝔫.map (Ideal.Quotient.mk I₀)).IsMaximal := by
      rcases Ideal.map_eq_top_or_isMaximal_of_surjective (Ideal.Quotient.mk I₀) Ideal.Quotient.mk_surjective hmax with h | h
      · exfalso
        apply hmax.ne_top
        rw [← hcm 𝔫 hI𝔫, h, Ideal.comap_top]
      · exact h
    obtain ⟨s, y, hy𝔫, hinj, N, mb, hspan⟩ := hnn (↥W ⧸ mW) (R ⧸ I₀) inferInstance _ hmax'
    choose z hz using fun i => Ideal.Quotient.mk_surjective (I := I₀) (y i)
    choose mm hmm using fun j => Ideal.Quotient.mk_surjective (I := I₀) (mb j)
    refine ⟨s, z, ?_, ?_, N, mm, ?_⟩
    · intro i
      rw [← hcm 𝔫 hI𝔫, Ideal.mem_comap, hz i]
      exact hy𝔫 i
    · intro g hg m
      have hext : (Ideal.Quotient.mk I₀).comp (MvPolynomial.aeval z : MvPolynomial (Fin s) ↥W →ₐ[↥W] R).toRingHom =
          (MvPolynomial.aeval y : MvPolynomial (Fin s) (↥W ⧸ mW) →ₐ[↥W ⧸ mW] R ⧸ I₀).toRingHom.comp
            (MvPolynomial.map (Ideal.Quotient.mk mW)) := by
        apply MvPolynomial.ringHom_ext
        · intro w
          simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe, MvPolynomial.aeval_C,
            MvPolynomial.map_C]
          rw [halg]
        · intro i
          simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe, MvPolynomial.aeval_X,
            MvPolynomial.map_X]
          exact hz i
      have h1 := congrArg (fun φ => φ g) hext
      simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe] at h1
      rw [Ideal.Quotient.eq_zero_iff_mem.mpr hg] at h1
      have h2 : MvPolynomial.map (Ideal.Quotient.mk mW) g = 0 := by
        apply hinj
        rw [← h1, map_zero]
      have h3 := congrArg (fun p : MvPolynomial (Fin s) (↥W ⧸ mW) => p.coeff m) h2
      simp only [MvPolynomial.coeff_map, MvPolynomial.coeff_zero] at h3
      exact Ideal.Quotient.eq_zero_iff_mem.mp h3
    · intro x
      obtain ⟨cb, hcb⟩ := hspan (Ideal.Quotient.mk I₀ x)
      choose c hc using fun j => Ideal.Quotient.mk_surjective (I := mW) (cb j)
      refine ⟨c, ?_⟩
      have hmap : Ideal.span (Set.range y) = (Ideal.span (Set.range z)).map (Ideal.Quotient.mk I₀) := by
        rw [Ideal.map_span, ← Set.range_comp]
