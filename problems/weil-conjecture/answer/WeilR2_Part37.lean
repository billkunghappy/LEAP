theorem wcpa_dj_lr1k_nsr_gub_bff_dc_ia_pbc_tb_pointwise : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A] [Algebra ↥W A] (ϖ : ↥W) (η : A) (r : ℕ) (b : Fin r → A) (L N : ℕ) (G : Matrix (Fin r) (Fin r) (Polynomial ↥W)) (a s : A) (p : Fin r → Polynomial ↥W) (t : ↥W) (ψ : Fin r → (wcGubGen W A →+* Ω)), N ≤ L → a = ∑ k, Polynomial.aeval η (p k) * b k + algebraMap ↥W A ϖ ^ L * s → (∀ j, (∀ w : ↥W, ψ j (algebraMap A (wcGubGen W A) (algebraMap ↥W A w)) = (w : Ω)) ∧ (∀ x : A, ψ j (algebraMap A (wcGubGen W A) x) ∈ W) ∧ ψ j (algebraMap A (wcGubGen W A) η) = (t : Ω)) → (∀ i k, ∃ u : ↥W, ((Polynomial.eval t (G i k) : ↥W) : Ω) = ∑ j, ψ j (algebraMap A (wcGubGen W A) (b i)) * ψ j (algebraMap A (wcGubGen W A) (b k)) + (ϖ : Ω) ^ L * (u : Ω)) → (∀ j i, ∃ u : ↥W, ψ j (algebraMap A (wcGubGen W A) (a * b i)) = (ϖ : Ω) ^ N * (u : Ω)) → ∀ k, ϖ ^ N ∣ Polynomial.eval t (G.det * p k) :=
by
  intro Ω _ W A _ _ ϖ η r b L N G a s p t ψ hNL ha hpts hG hval k
  classical

  have s1 : ∀ (M : Matrix (Fin r) (Fin r) ↥W) (x : Fin r → ↥W) (d : ↥W),
      (∀ i, d ∣ ∑ k, x k * M k i) → ∀ k, d ∣ M.det * x k := by
