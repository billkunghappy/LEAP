      exact hxq
    refine ⟨⟨s, hsint⟩, trivial, ?_⟩
    simp only [f, LinearMap.coe_comp, Function.comp_apply, AlgHom.toLinearMap_apply,
      Subalgebra.coe_val, IsScalarTower.toAlgHom_apply]
    exact hs

  intro k _ _ R _ _ _ hfin
  have hRint : Algebra.IsIntegral (Polynomial k) R := Algebra.IsIntegral.of_finite (Polynomial k) R
  by_cases hinj : Function.Injective (algebraMap (Polynomial k) R)
  · set p := ringExpChar k
    haveI : ExpChar k p := ringExpChar.expChar k
    obtain ⟨e, N, hN, hpow⟩ := s3 k R hfin hinj
    haveI : ExpChar (FractionRing R) p := expChar_of_injective_ringHom
