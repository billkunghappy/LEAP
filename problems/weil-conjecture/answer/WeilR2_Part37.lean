        calc (n : ℕ∞) = ∑ _i : Fin n, (1 : ℕ∞) := by simp
          _ ≤ _ := Finset.sum_le_sum (fun i _ => this i)
      calc (n : ℕ∞) ≤ Module.length R ((i : Fin n) → A ⧸ M i) := hP
        _ = _ := hadd
