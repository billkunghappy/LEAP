      simp only [CommRingCat.hom_comp, RingHom.comp_apply] at this
      exact this
    have hfu : IsUnit (algebraMap Γ(X, W) Γ(X, X.basicOpen f) f) :=
      IsLocalization.Away.algebraMap_isUnit f
    have halg : ∀ a, (X.presheaf.map (homOfLE (X.basicOpen_le f)).op).hom a =
        algebraMap Γ(X, W) Γ(X, X.basicOpen f) a := fun a => rfl
    rw [halg]
    refine le_antisymm ?_ ?_
    · intro x' hx'
      rw [RingHom.mem_ker] at hx'
      obtain ⟨⟨x0, ⟨_, n, rfl⟩⟩, hx0⟩ := IsLocalization.surj (Submonoid.powers f) x'
      simp only at hx0
      have h1 : (Y.presheaf.map (homOfLE hle').op).hom ((τ.app W).hom x0) = 0 := by
        rw [← nat, ← hx0, map_mul, hx', zero_mul]
