theorem wcpa_dj_lr1k_nsr_na_invariance : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω)
    (C : Scheme.{u}) [AlgebraicGeometry.IsIntegral C] (γ : C ⟶ wcProjK Ω 1)
    (X : Scheme.{u}) (uX : X ⟶ Spec (.of ↥W)) (ι : wcProjK Ω 1 ⟶ X) (x : ↥X)
    (X₀ : Scheme.{u}) (r₀ : X₀ ⟶ X) (ι₀ : wcProjK Ω 1 ⟶ X₀)
    [QuasiCompact (γ ≫ ι₀)] [QuasiSeparated (γ ≫ ι₀)]
    (w : ↥(wcpaDjLkFib W (γ ≫ ι₀) (r₀ ≫ uX))) (A : ValuationSubring C.functionField),
    wcNsrNaLim W γ uX ι x A →
    wcNsrNaDom A (γ ≫ ι₀).toNormalization (wcNdPt W (γ ≫ ι₀) (r₀ ≫ uX) w) →
    (∀ A' : ValuationSubring C.functionField, wcNsrNaLim W γ uX ι x A' →
      wcNsrNaDom A' (γ ≫ ι₀).toNormalization (wcNdPt W (γ ≫ ι₀) (r₀ ≫ uX) w) → A' = A) →
    ∀ g : Aut C, wcpaDjLlFixes W γ ι₀ (r₀ ≫ uX) w g →
    ∀ (V : C.Opens) (t : Γ(C, V)) (hV : genericPoint ↥C ∈ V)
      (hV' : genericPoint ↥C ∈ g.hom ⁻¹ᵁ V),
      (A.valuation ((C.presheaf.germ V (genericPoint ↥C) hV).hom t) ≤ 1 ↔
        A.valuation ((C.presheaf.germ (g.hom ⁻¹ᵁ V) (genericPoint ↥C) hV').hom
          ((g.hom.app V).hom t)) ≤ 1) :=
by
  intro Ω _ W C _ γ X uX ι x X₀ r₀ ι₀ _ _ w A hLim hDom hU g hFix V t hV hV'

  have hgen : g.hom (genericPoint C) ⤳ genericPoint C := by
    have h1 := (genericPoint_specializes (g.inv (genericPoint C))).map g.hom.continuous
    have e0 : g.hom (g.inv (genericPoint C)) = genericPoint C :=
      Scheme.inv_hom_apply (X := C) (Y := C) g _
    rwa [e0] at h1

  have G : ∀ {S T : Scheme.{u}} (f : S ⟶ T) (x' : S) (z : T) (hz : f x' ⤳ z) (U : T.Opens)
      (hzU : z ∈ U) (a : Γ(T, U)) (hxU : x' ∈ f ⁻¹ᵁ U),
      (T.presheaf.stalkSpecializes hz ≫ f.stalkMap x').hom ((T.presheaf.germ U z hzU).hom a) =
        (S.presheaf.germ (f ⁻¹ᵁ U) x' hxU).hom ((f.app U).hom a) := by
    intro S T f x' z hz U hzU a hxU
    have hm : T.presheaf.germ U z hzU ≫ T.presheaf.stalkSpecializes hz ≫ f.stalkMap x' =
        f.app U ≫ S.presheaf.germ (f ⁻¹ᵁ U) x' hxU := by
      rw [TopCat.Presheaf.germ_stalkSpecializes_assoc, Scheme.Hom.germ_stalkMap]
    have := congrArg (fun φ => φ.hom a) hm
    simpa only [CommRingCat.hom_comp, RingHom.comp_apply] using this

  obtain ⟨φ, hgerm⟩ : ∃ φ : C.functionField →+* C.functionField,
      ∀ (U : C.Opens) (a : Γ(C, U)) (h1 : genericPoint C ∈ U)
        (h2 : genericPoint C ∈ g.hom ⁻¹ᵁ U),
        (C.presheaf.germ (g.hom ⁻¹ᵁ U) (genericPoint C) h2).hom ((g.hom.app U).hom a) =
          φ ((C.presheaf.germ U (genericPoint C) h1).hom a) := by
    refine ⟨(C.presheaf.stalkSpecializes hgen ≫ g.hom.stalkMap (genericPoint C)).hom, ?_⟩
    intro U a h1 h2
    exact (G g.hom (genericPoint C) (genericPoint C) hgen U h1 a h2).symm

  have key : ∀ (R : ValuationSubring C.functionField) (f : C.functionField), f ≠ 0 →
      (R.valuation f < 1 ↔ f⁻¹ ∉ R) := by
    intro R f hf
    rw [← R.valuation_le_one_iff, map_inv₀, inv_le_one₀ ((Valuation.pos_iff _).2 hf), not_le]
  have hle : ∀ f, (A.comap φ).valuation f ≤ 1 ↔ A.valuation (φ f) ≤ 1 := by
    intro f
    rw [ValuationSubring.valuation_le_one_iff, ValuationSubring.valuation_le_one_iff,
      ValuationSubring.mem_comap]
  have hlt : ∀ f, (A.comap φ).valuation f < 1 ↔ A.valuation (φ f) < 1 := by
    intro f
    by_cases hf : f = 0
    · subst hf; simp
    · have hφf : φ f ≠ 0 := (map_ne_zero φ).2 hf
      rw [key _ f hf, key _ _ hφf, ValuationSubring.mem_comap, map_inv₀]

  have hdom : ∀ (Y : Scheme.{u}) (h : C ⟶ Y) (β : Y ⟶ Y) (y : Y), g.hom ≫ h = h ≫ β →
      β y = y → wcNsrNaDom A h y → wcNsrNaDom (A.comap φ) h y := by
    intro Y h β y e hβ hD
    obtain ⟨hy, D1, D2⟩ := hD
    have hβ' : β y ⤳ y := specializes_of_eq hβ
    haveI : IsLocalHom (Y.presheaf.stalkSpecializes hβ').hom := by
      have := isLocalHom_of_iso (Y.presheaf.stalkCongr (Inseparable.of_eq hβ.symm))
      rwa [TopCat.Presheaf.stalkCongr_hom] at this
    haveI hloc : IsLocalHom (Y.presheaf.stalkSpecializes hβ' ≫ β.stalkMap y).hom := by
      rw [CommRingCat.hom_comp]; infer_instance
    have hψm : ∀ s ∈ IsLocalRing.maximalIdeal (Y.presheaf.stalk y),
        (Y.presheaf.stalkSpecializes hβ' ≫ β.stalkMap y).hom s ∈
          IsLocalRing.maximalIdeal (Y.presheaf.stalk y) := by
      intro s hs
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hs ⊢
      exact fun hu => hs (IsLocalHom.map_nonunit s hu)
    have hI : ∀ s, φ ((wcLr1uGerm h y hy).hom s) =
        (wcLr1uGerm h y hy).hom ((Y.presheaf.stalkSpecializes hβ' ≫ β.stalkMap y).hom s) := by
      intro s
      obtain ⟨U, hyU, a, rfl⟩ := Y.presheaf.germ_exist s
      have hηU : genericPoint C ∈ h ⁻¹ᵁ U := hy.mem_open U.isOpen hyU
      have hηU' : genericPoint C ∈ g.hom ⁻¹ᵁ (h ⁻¹ᵁ U) := hgen.mem_open (h ⁻¹ᵁ U).isOpen hηU
      have hyβU : y ∈ β ⁻¹ᵁ U := by
        show β y ∈ U
        rw [hβ]; exact hyU
      have hηβU : genericPoint C ∈ h ⁻¹ᵁ (β ⁻¹ᵁ U) := hy.mem_open (β ⁻¹ᵁ U).isOpen hyβU
      unfold wcLr1uGerm
      rw [G h (genericPoint C) y hy U hyU a hηU, ← hgerm (h ⁻¹ᵁ U) _ hηU hηU',
        G β y y hβ' U hyU a hyβU, G h (genericPoint C) y hy (β ⁻¹ᵁ U) hyβU _ hηβU]
      have hk : ∀ (f f' : C ⟶ Y), f = f' → ∀ (m : genericPoint C ∈ f ⁻¹ᵁ U)
          (m' : genericPoint C ∈ f' ⁻¹ᵁ U),
          (C.presheaf.germ (f ⁻¹ᵁ U) _ m).hom ((f.app U).hom a) =
            (C.presheaf.germ (f' ⁻¹ᵁ U) _ m').hom ((f'.app U).hom a) := by
        rintro f _ rfl m m'
        rfl
      have := hk (g.hom ≫ h) (h ≫ β) e hηU' hηβU
      simp only [Scheme.Hom.comp_app, CommRingCat.hom_comp, RingHom.comp_apply] at this
      exact this
    refine ⟨hy, fun s => ?_, fun s hs => ?_⟩
    · rw [hle, hI]; exact D1 _
    · rw [hlt, hI]; exact D2 _ (hψm s hs)

  have hlim : ∀ A' : ValuationSubring C.functionField,
      (∀ (Y : Scheme.{u}) (ι' : wcProjK Ω 1 ⟶ Y) (y : Y),
        wcNsrNaDom A (γ ≫ ι') y → wcNsrNaDom A' (γ ≫ ι') y) →
      wcNsrNaLim W γ uX ι x A → wcNsrNaLim W γ uX ι x A' := by
    intro A' H hL
    unfold wcNsrNaLim at hL ⊢
    obtain ⟨L1, L2⟩ := hL
    refine ⟨fun σ₀ a₀ hLB X₂ r₂ ι₂ hbl hι hM => ?_,
      fun σ a b hP hE hLB X₁ r₁ ι₁ hbl hι hM σ' hσ' =>
        H _ _ _ (L2 σ a b hP hE hLB X₁ r₁ ι₁ hbl hι hM σ' hσ')⟩
    obtain ⟨z, hz, hD, hns⟩ := L1 σ₀ a₀ hLB X₂ r₂ ι₂ hbl hι hM
    exact ⟨z, hz, H _ _ _ hD, hns⟩

  unfold wcpaDjLlFixes at hFix
  obtain ⟨hγ, g', e1, e2, e3⟩ := hFix
  have hLim' : wcNsrNaLim W γ uX ι x (A.comap φ) :=
    hlim _ (fun Y ι' y hD => hdom Y (γ ≫ ι') (𝟙 Y) y
      (by rw [← Category.assoc, hγ, Category.comp_id]) rfl hD) hLim
  have hDom' := hdom _ _ g' _ e1.symm e3 hDom
  have hEq := hU _ hLim' hDom'
  have hmem : ∀ f, φ f ∈ A ↔ f ∈ A := fun f => by
    have h1 : f ∈ A.comap φ ↔ φ f ∈ A := ValuationSubring.mem_comap
    rw [hEq] at h1
    exact h1.symm
  rw [hgerm V t hV hV', ValuationSubring.valuation_le_one_iff,
    ValuationSubring.valuation_le_one_iff, hmem]

theorem wcpa_dj_lr1k_nsr_nonaffinoid_case : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (C : Scheme.{u}) (γ : C ⟶ wcProjK Ω 1), wcpaDjLkCov Ω γ → wcpaDjLkGalois γ →
    ∀ (X : Scheme.{u}) (uX : X ⟶ Spec (.of ↥W)) (ι : wcProjK Ω 1 ⟶ X)
      [QuasiCompact (γ ≫ ι)] [QuasiSeparated (γ ≫ ι)],
    wcpaDjLkModel W uX ι →
    ∀ y₀ : ↥(wcpaDjLkFib W (γ ≫ ι) uX),
      wcpaDjLkBad ((wcpaDjLkFib W (γ ≫ ι) uX).presheaf.stalk y₀) →
      wcpaDjLkSmAt W uX (wcpaDjLkPi W (γ ≫ ι) uX y₀) →
    ∀ τ : (Spec (.of ↥W) ⟶ X) → ↥W,
      wcpaDjLlDiscParam W uX (wcpaDjLkImg W (γ ≫ ι) uX y₀) τ →
      wcpaDjLlExhBasic W γ uX ι (wcpaDjLkImg W (γ ≫ ι) uX y₀) →
      (¬ ∃ (σ : Spec (.of ↥W) ⟶ X) (a : ↥W),
        wcpaDjLlPair W uX (wcpaDjLkImg W (γ ≫ ι) uX y₀) σ a ∧
        wcpaDjLlMinExh W γ uX ι (wcpaDjLkImg W (γ ≫ ι) uX y₀) σ a) →
      (∃ (σ₀ : Spec (.of ↥W) ⟶ X) (a₀ : ↥W),
        wcNsrLB W γ uX ι (wcpaDjLkImg W (γ ≫ ι) uX y₀) σ₀ a₀) →
      (¬ ∃ (σ₀ : Spec (.of ↥W) ⟶ X) (a₀ : ↥W),
        wcNsrLB W γ uX ι (wcpaDjLkImg W (γ ≫ ι) uX y₀) σ₀ a₀ ∧
        ∀ (σ' : Spec (.of ↥W) ⟶ X) (a' : ↥W),
          wcNsrLB W γ uX ι (wcpaDjLkImg W (γ ≫ ι) uX y₀) σ' a' →
          σ'.ker ⊔ wcNcPrincipal (.of ↥W) X uX a' ≤ σ₀.ker ⊔ wcNcPrincipal (.of ↥W) X uX a₀) →
      ∃ (σ₀ : Spec (.of ↥W) ⟶ X) (a₀ : ↥W),
        wcNsrLB W γ uX ι (wcpaDjLkImg W (γ ≫ ι) uX y₀) σ₀ a₀ ∧
        wcNsrNodeVal W γ uX ι (wcpaDjLkImg W (γ ≫ ι) uX y₀) σ₀ a₀ :=
by
  intro Ω _ _ W hW hWt C γ hcov hgal X uX ι _ _ hM y₀ hy₀ hSm τ hτ hE hnM hLB hnG
  have hH : wcNsrNaHyp W γ uX ι y₀ τ :=
    ⟨hW, hWt, hcov, hgal, hM, hy₀, hSm, hτ, hE, hnM, hLB, hnG⟩

  haveI : IrreducibleSpace C := hcov.2.2.1
  haveI : SmoothOfRelativeDimension 1 (γ ≫ wcProjKStr Ω 1) := hcov.2.1
  haveI hstred : ∀ c : C, _root_.IsReduced (C.presheaf.stalk c) := fun c => by
    haveI := wcpa_smooth_stalk_isDomain Ω C (γ ≫ wcProjKStr Ω 1) 1 c
    infer_instance
  haveI : IsReduced C := isReduced_of_isReduced_stalk C
  haveI hint : AlgebraicGeometry.IsIntegral C := isIntegral_of_irreducibleSpace_of_isReduced C

  obtain ⟨A, hA⟩ := wcpa_dj_lr1k_nsr_na_limit_valuation Ω W C γ X uX ι y₀ τ hH

  obtain ⟨σ₀, a₀, hLB₀, huniq⟩ := wcpa_dj_lr1k_nsr_na_unique_extension Ω W C γ X uX ι y₀ τ hH
  refine ⟨σ₀, a₀, hLB₀, ?_⟩
  intro X₀ r₀ ι₀ _ _ hbl hι₀ hM₀

  obtain ⟨w, hDom, hx, hns⟩ := wcpa_dj_lr1k_nsr_na_centre_on_normalisation Ω W C γ X uX ι y₀ τ
    hH σ₀ a₀ hLB₀ X₀ r₀ ι₀ hbl hι₀ hM₀ A hA

  obtain ⟨hR1, hR2⟩ := wcpa_dj_lr1k_nsr_na_extension_residue Ω W C γ X uX ι y₀ τ hH A hA
  refine ⟨w, hx, hns, ?_⟩
  unfold wcNsrInvVal

  exact ⟨hint, A, hR1, hR2, wcpa_dj_lr1k_nsr_na_invariance Ω W C γ X uX ι
    (wcpaDjLkImg W (γ ≫ ι) uX y₀) X₀ r₀ ι₀ w A hA hDom
    (fun A' hA' hD' => huniq X₀ r₀ ι₀ hbl hι₀ hM₀ A' A _ hA' hA hD' hDom)⟩

theorem wcpa_dj_lr1k_ll_nonsolvable_reduction : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (C : Scheme.{u}) (γ : C ⟶ wcProjK Ω 1), wcpaDjLkCov Ω γ → wcpaDjLkGalois γ →
    ∀ (X : Scheme.{u}) (uX : X ⟶ Spec (.of ↥W)) (ι : wcProjK Ω 1 ⟶ X)
      [QuasiCompact (γ ≫ ι)] [QuasiSeparated (γ ≫ ι)],
    wcpaDjLkModel W uX ι →
    ∀ y₀ : ↥(wcpaDjLkFib W (γ ≫ ι) uX),
      wcpaDjLkBad ((wcpaDjLkFib W (γ ≫ ι) uX).presheaf.stalk y₀) →
      wcpaDjLkSmAt W uX (wcpaDjLkPi W (γ ≫ ι) uX y₀) →
    ∀ τ : (Spec (.of ↥W) ⟶ X) → ↥W,
      wcpaDjLlDiscParam W uX (wcpaDjLkImg W (γ ≫ ι) uX y₀) τ →
      wcpaDjLlExhBasic W γ uX ι (wcpaDjLkImg W (γ ≫ ι) uX y₀) →
      wcpaDjLlSolvMin W γ uX ι y₀ →
    ∃ (σ : Spec (.of ↥W) ⟶ X) (a : ↥W),
      wcpaDjLlPair W uX (wcpaDjLkImg W (γ ≫ ι) uX y₀) σ a ∧
      wcpaDjLlMinExh W γ uX ι (wcpaDjLkImg W (γ ≫ ι) uX y₀) σ a :=
by
  intro Ω _ _ W hW hWt C γ hcov hgal X uX ι _ _ hM y₀ hy₀ hSm τ hτ hE hS
  classical
  have hsolv := wcpa_dj_lr1k_nsr_solvstab_of_valuation wcpa_dj_lr1k_nsr_decomp_solvable
    Ω C γ hcov
  by_cases hmin : ∃ (σ : Spec (.of ↥W) ⟶ X) (a : ↥W),
      wcpaDjLlPair W uX (wcpaDjLkImg W (γ ≫ ι) uX y₀) σ a ∧
      wcpaDjLlMinExh W γ uX ι (wcpaDjLkImg W (γ ≫ ι) uX y₀) σ a
  · exact hmin
  by_cases hLB : ∃ (σ₀ : Spec (.of ↥W) ⟶ X) (a₀ : ↥W),
      wcNsrLB W γ uX ι (wcpaDjLkImg W (γ ≫ ι) uX y₀) σ₀ a₀
  swap
  ·
    have hV := wcpa_dj_lr1k_nsr_no_lower_bound Ω W hW hWt C γ hcov hgal X uX ι hM y₀ hy₀ hSm
      τ hτ hE hLB
    have hSy : wcpaDjLlSolvStab W γ ι uX y₀ := by
      intro H hH
      exact hsolv (wcpaDjLlFixes W γ ι uX y₀) (fun g hg => hg.1) hV H hH
    exact hS.1 hSy

  obtain ⟨σ₀, a₀, hLB₀, hNV⟩ : ∃ (σ₀ : Spec (.of ↥W) ⟶ X) (a₀ : ↥W),
      wcNsrLB W γ uX ι (wcpaDjLkImg W (γ ≫ ι) uX y₀) σ₀ a₀ ∧
      wcNsrNodeVal W γ uX ι (wcpaDjLkImg W (γ ≫ ι) uX y₀) σ₀ a₀ := by
    by_cases hG : ∃ (σ₀ : Spec (.of ↥W) ⟶ X) (a₀ : ↥W),
        wcNsrLB W γ uX ι (wcpaDjLkImg W (γ ≫ ι) uX y₀) σ₀ a₀ ∧
        ∀ (σ' : Spec (.of ↥W) ⟶ X) (a' : ↥W),
          wcNsrLB W γ uX ι (wcpaDjLkImg W (γ ≫ ι) uX y₀) σ' a' →
          σ'.ker ⊔ wcNcPrincipal (.of ↥W) X uX a' ≤ σ₀.ker ⊔ wcNcPrincipal (.of ↥W) X uX a₀
    · obtain ⟨σ₀, a₀, h1, h2⟩ := hG
      exact ⟨σ₀, a₀, h1, wcpa_dj_lr1k_nsr_glb_case Ω W hW hWt C γ hcov hgal X uX ι hM y₀ hy₀
        hSm τ hτ hE hmin σ₀ a₀ h1 h2⟩
    · exact wcpa_dj_lr1k_nsr_nonaffinoid_case Ω W hW hWt C γ hcov hgal X uX ι hM y₀ hy₀ hSm
        τ hτ hE hmin hLB hG
  obtain ⟨hP₀, hlow⟩ := hLB₀
  obtain ⟨X₀, r₀, hbl, ⟨ι₀, hι₀, hM₀⟩, -, -, -⟩ :=
    wcpa_dj_lr1k_imp_blowup_model Ω W hW hWt X uX ι hM σ₀ hP₀.1 (wcpaDjLkPi W (γ ≫ ι) uX y₀)
      hP₀.2.1.symm hSm a₀ hP₀.2.2.1 hP₀.2.2.2
  haveI : IsFinite γ := hcov.2.2.2.1
  haveI : QuasiCompact ι₀ :=
    MorphismProperty.of_isPullback (P := @QuasiCompact) hM₀.2.2.flip inferInstance
  haveI : QuasiSeparated ι₀ :=
    MorphismProperty.of_isPullback (P := @QuasiSeparated) hM₀.2.2.flip inferInstance
  obtain ⟨w, hw, hns, hVw⟩ := hNV X₀ r₀ ι₀ hbl hι₀ hM₀
  have hSw : wcpaDjLlSolvStab W γ ι₀ (r₀ ≫ uX) w := by
    intro H hH
    exact hsolv (wcpaDjLlFixes W γ ι₀ (r₀ ≫ uX) w) (fun g hg => hg.1) hVw H hH
  obtain ⟨σ, a, hP, -, hExh, hint⟩ := hS.2 σ₀ a₀ hP₀ X₀ r₀ ι₀ hbl hι₀ hM₀ w hw hns hSw
  refine ⟨σ, a, hP, hExh, ?_⟩
  intro σ' a' hP' hle' hExh'
  exact hint σ' a' hP' (hlow σ' a' hP' hExh') hle' hExh'

theorem wcpa_dj_lr1k_ll_minimal_exhausting : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (C : Scheme.{u}) (γ : C ⟶ wcProjK Ω 1), wcpaDjLkCov Ω γ → wcpaDjLkGalois γ →
    ∀ (X : Scheme.{u}) (uX : X ⟶ Spec (.of ↥W)) (ι : wcProjK Ω 1 ⟶ X)
      [QuasiCompact (γ ≫ ι)] [QuasiSeparated (γ ≫ ι)],
    wcpaDjLkModel W uX ι →
    ∀ y₀ : ↥(wcpaDjLkFib W (γ ≫ ι) uX),
      wcpaDjLkBad ((wcpaDjLkFib W (γ ≫ ι) uX).presheaf.stalk y₀) →
      wcpaDjLkSmAt W uX (wcpaDjLkPi W (γ ≫ ι) uX y₀) →
    ∃ (σ : Spec (.of ↥W) ⟶ X) (a : ↥W),
      wcpaDjLlPair W uX (wcpaDjLkImg W (γ ≫ ι) uX y₀) σ a ∧
      wcpaDjLlMinExh W γ uX ι (wcpaDjLkImg W (γ ≫ ι) uX y₀) σ a :=
by
  intro Ω _ _ W hW hWt C γ hcov hgal X uX ι _ _ hM y₀ hy₀ hSm
  obtain ⟨τ, hτ⟩ :=
    wcpa_dj_lr1k_ll_disc_param Ω W hW hWt C γ hcov hgal X uX ι hM y₀ hy₀ hSm
  exact wcpa_dj_lr1k_ll_nonsolvable_reduction Ω W hW hWt C γ hcov hgal X uX ι hM y₀ hy₀ hSm
