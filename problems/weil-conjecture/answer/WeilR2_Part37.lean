  have s4 : ∀ (P A F₀ K : Type u) [CommRing P] [IsDomain P] [CommRing A] [IsDomain A] [Field F₀]
      [Field K] [Algebra P A] [Algebra P F₀] [IsFractionRing P F₀] [Algebra A K]
      [IsFractionRing A K] [Algebra P K] [Algebra F₀ K] [IsScalarTower P F₀ K]
