  have hft : Algebra.FiniteType ↥W A := by haveI := hfp; infer_instance
  obtain ⟨n₀, s₀, hs₀⟩ := hN

  have SP : ∀ (ζ : A) (r : ℕ) (b : Fin r → A),
      (∀ a : A, ∃ p : Fin r → Polynomial ↥W,
        a - ∑ i, Polynomial.aeval ζ (p i) * b i ∈
          (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)) →
      ∀ (L : ℕ) (a : A), ∃ (p : Fin r → Polynomial ↥W) (s : A),
        a = ∑ i, Polynomial.aeval ζ (p i) * b i + algebraMap ↥W A ϖ ^ L * s := by
    intro ζ r b hspan
    classical

    have s1 : ∀ x ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A),
        ∃ (w : ↥W) (y : A), w ∈ IsLocalRing.maximalIdeal ↥W ∧ x = algebraMap ↥W A w * y := by
      intro x hx
      change x ∈ Submodule.span A
        (⇑(algebraMap ↥W A) '' (IsLocalRing.maximalIdeal ↥W : Set ↥W)) at hx
      induction hx using Submodule.span_induction with
      | mem x hx =>
        obtain ⟨w, hw, rfl⟩ := hx
        exact ⟨w, 1, hw, (mul_one _).symm⟩
      | zero => exact ⟨0, 0, Ideal.zero_mem _, by simp⟩
      | add x x' _ _ hx hx' =>
        obtain ⟨w, y, hw, rfl⟩ := hx
        obtain ⟨w', y', hw', rfl⟩ := hx'
        rcases ValuationRing.dvd_total w w' with ⟨c, rfl⟩ | ⟨c, rfl⟩
        · exact ⟨w, y + algebraMap ↥W A c * y', hw, by rw [map_mul]; ring⟩
        · exact ⟨w', algebraMap ↥W A c * y + y', hw', by rw [map_mul]; ring⟩
      | smul a x _ hx =>
        obtain ⟨w, y, hw, rfl⟩ := hx
        exact ⟨w, a * y, hw, by rw [smul_eq_mul]; ring⟩

    have hpow : ∀ w ∈ IsLocalRing.maximalIdeal ↥W, ∃ K : ℕ, ∃ u : ↥W, w ^ K = u * ϖ := by
      intro w hw
      haveI : Ring.KrullDimLE 1 ↥W := Ring.krullDimLE_iff.mpr hdimW
      have hle : IsLocalRing.maximalIdeal ↥W ≤ (Ideal.span {ϖ}).radical := by
        rw [Ideal.radical_eq_sInf]
        refine le_sInf ?_
        rintro P ⟨hPϖ, hPp⟩
        have hP0 : P ≠ ⊥ := by
          intro h
          apply hϖ0
          have : ϖ ∈ P := hPϖ (Ideal.mem_span_singleton_self ϖ)
          rw [h] at this
          exact (Submodule.mem_bot _).mp this
        haveI := hPp
        have hPmax : P.IsMaximal := Ideal.isMaximal_of_isPrime_of_ne_bot P hP0
        exact le_of_eq (IsLocalRing.eq_maximalIdeal hPmax).symm
      obtain ⟨K, hK⟩ := hle hw
      obtain ⟨u, hu⟩ := Ideal.mem_span_singleton'.mp hK
      exact ⟨K, u, hu.symm⟩

    have s3 : ∀ G : Finset A, (∀ g ∈ G, ∃ (p : Fin r → Polynomial ↥W) (w : ↥W) (y : A),
        w ∈ IsLocalRing.maximalIdeal ↥W ∧
          g = ∑ i, Polynomial.aeval ζ (p i) * b i + algebraMap ↥W A w * y) →
        ∃ w₀ : ↥W, w₀ ∈ IsLocalRing.maximalIdeal ↥W ∧ ∀ g ∈ G,
          ∃ (p : Fin r → Polynomial ↥W) (s : A),
            g = ∑ i, Polynomial.aeval ζ (p i) * b i + algebraMap ↥W A w₀ * s := by
      intro G
      induction G using Finset.induction_on with
      | empty => intro _; exact ⟨0, Ideal.zero_mem _, fun g hg => by simp at hg⟩
      | insert g G' hg ih =>
        intro H
        obtain ⟨w₁, hw₁, H₁⟩ := ih (fun g' hg' => H g' (Finset.mem_insert_of_mem hg'))
        obtain ⟨p, w, y, hw, hgeq⟩ := H g (Finset.mem_insert_self g G')
        rcases ValuationRing.dvd_total w w₁ with ⟨c, hc⟩ | ⟨c, hc⟩
        · refine ⟨w, hw, fun g' hg' => ?_⟩
          rcases Finset.mem_insert.mp hg' with h | h
          · exact ⟨p, y, h ▸ hgeq⟩
          · obtain ⟨p', s', hs'⟩ := H₁ g' h
            exact ⟨p', algebraMap ↥W A c * s', by rw [hs', hc, map_mul, mul_assoc]⟩
        · refine ⟨w₁, hw₁, fun g' hg' => ?_⟩
          rcases Finset.mem_insert.mp hg' with h | h
          · exact ⟨p, algebraMap ↥W A c * y, by rw [h, hgeq, hc, map_mul, mul_assoc]⟩
          · exact H₁ g' h

    obtain ⟨G₀, hG₀⟩ := hft.out
    set G : Finset A := insert 1 (G₀ ∪ Finset.univ.image
      (fun ij : Fin r × Fin r => b ij.1 * b ij.2)) with hG
    obtain ⟨w₀, hw₀, hw₀G⟩ := s3 G (fun g _ => by
      obtain ⟨p, hp⟩ := hspan g
      obtain ⟨w, y, hw, hxy⟩ := s1 _ hp
      exact ⟨p, w, y, hw, sub_eq_iff_eq_add'.mp hxy⟩)

    let N : A → Prop := fun x => ∃ (p : Fin r → Polynomial ↥W) (s : A),
      x = ∑ i, Polynomial.aeval ζ (p i) * b i + algebraMap ↥W A w₀ * s
    have N0 : N 0 := ⟨0, 0, by simp⟩
    have Nadd : ∀ x y : A, N x → N y → N (x + y) := by
      rintro x y ⟨p, s, rfl⟩ ⟨p', s', rfl⟩
      refine ⟨p + p', s + s', ?_⟩
      have e : ∑ i, Polynomial.aeval ζ ((p + p') i) * b i =
          ∑ i, Polynomial.aeval ζ (p i) * b i + ∑ i, Polynomial.aeval ζ (p' i) * b i := by
        simp only [Pi.add_apply, map_add, add_mul, Finset.sum_add_distrib]
      rw [e]; ring
    have Npoly : ∀ (q : Polynomial ↥W) (x : A), N x → N (Polynomial.aeval ζ q * x) := by
      rintro q x ⟨p, s, rfl⟩
      refine ⟨fun i => q * p i, Polynomial.aeval ζ q * s, ?_⟩
      have e : ∑ i, Polynomial.aeval ζ (q * p i) * b i =
          Polynomial.aeval ζ q * ∑ i, Polynomial.aeval ζ (p i) * b i := by
        simp only [map_mul, Finset.mul_sum, mul_assoc]
      rw [e]; ring
    have Nw : ∀ z : A, N (algebraMap ↥W A w₀ * z) := fun z => ⟨0, z, by simp⟩
    have hbb : ∀ i j : Fin r, N (b i * b j) := fun i j =>
      hw₀G _ (Finset.mem_insert_of_mem (Finset.mem_union_right _
        (Finset.mem_image_of_mem _ (Finset.mem_univ (i, j)))))

    have hall : ∀ x : A, N x := by
      intro x
      have hx : x ∈ Algebra.adjoin ↥W (G₀ : Set A) := by rw [hG₀]; exact Algebra.mem_top
      induction hx using Algebra.adjoin_induction with
      | mem x hx => exact hw₀G x (Finset.mem_insert_of_mem (Finset.mem_union_left _ hx))
      | algebraMap c =>
        have h1 := Npoly (Polynomial.C c) 1 (hw₀G 1 (Finset.mem_insert_self _ _))
        rwa [Polynomial.aeval_C, mul_one] at h1
      | add x y _ _ hx hy => exact Nadd x y hx hy
      | mul x y _ _ hx hy =>
        obtain ⟨p, s, rfl⟩ := hx
        obtain ⟨q, t, rfl⟩ := hy
        have hXY : N ((∑ i, Polynomial.aeval ζ (p i) * b i) *
            (∑ j, Polynomial.aeval ζ (q j) * b j)) := by
          rw [Finset.sum_mul_sum]
          refine Finset.sum_induction _ N Nadd N0 (fun i _ => ?_)
          refine Finset.sum_induction _ N Nadd N0 (fun j _ => ?_)
          have e : Polynomial.aeval ζ (p i) * b i * (Polynomial.aeval ζ (q j) * b j) =
              Polynomial.aeval ζ (p i * q j) * (b i * b j) := by
            rw [map_mul]; ring
          rw [e]
          exact Npoly _ _ (hbb i j)
        have e2 : (∑ i, Polynomial.aeval ζ (p i) * b i + algebraMap ↥W A w₀ * s) *
            (∑ j, Polynomial.aeval ζ (q j) * b j + algebraMap ↥W A w₀ * t) =
            (∑ i, Polynomial.aeval ζ (p i) * b i) * (∑ j, Polynomial.aeval ζ (q j) * b j) +
              algebraMap ↥W A w₀ * (s * (∑ j, Polynomial.aeval ζ (q j) * b j) +
                (∑ i, Polynomial.aeval ζ (p i) * b i) * t + algebraMap ↥W A w₀ * s * t) := by
          ring
        rw [e2]
        exact Nadd _ _ hXY (Nw _)

    have hiter : ∀ k : ℕ, ∀ a : A, ∃ (p : Fin r → Polynomial ↥W) (s : A),
        a = ∑ i, Polynomial.aeval ζ (p i) * b i + algebraMap ↥W A w₀ ^ k * s := by
      intro k
      induction k with
      | zero => intro a; exact ⟨0, a, by simp⟩
      | succ k ih =>
        intro a
        obtain ⟨p, y, hy⟩ := ih a
        obtain ⟨q, y', hy'⟩ := hall y
        refine ⟨fun i => p i + Polynomial.C (w₀ ^ k) * q i, y', ?_⟩
        have e : ∑ i, Polynomial.aeval ζ (p i + Polynomial.C (w₀ ^ k) * q i) * b i =
            ∑ i, Polynomial.aeval ζ (p i) * b i +
              algebraMap ↥W A w₀ ^ k * ∑ i, Polynomial.aeval ζ (q i) * b i := by
          simp only [map_add, map_mul, Polynomial.aeval_C, map_pow, add_mul,
            Finset.sum_add_distrib, Finset.mul_sum, mul_assoc]
        rw [e, hy, hy']
        ring

    intro L a
    obtain ⟨K, u, hK⟩ := hpow w₀ hw₀
    obtain ⟨p, s, hs⟩ := hiter (K * L) a
    refine ⟨p, algebraMap ↥W A u ^ L * s, ?_⟩
    have e : algebraMap ↥W A w₀ ^ (K * L) = algebraMap ↥W A ϖ ^ L * algebraMap ↥W A u ^ L := by
      rw [pow_mul, ← map_pow (algebraMap ↥W A) w₀ K, hK, map_mul, mul_pow]
      ring
    rw [hs, e]
    ring

  classical
  intro n M a
  let P : Submodule (↥W) A :=
    (Ideal.span {ζ₀ ^ n} ⊔ Ideal.span {algebraMap ↥W A ϖ ^ M}).restrictScalars ↥W
  let N' : Submodule (↥W) A :=
    Submodule.span ↥W (Set.range (fun q : Fin n × Fin n₀ => ζ₀ ^ (q.1 : ℕ) * s₀ q.2))
  let h : (ℕ × Fin r₁) ⊕ Fin r₀ → A := Sum.elim (fun p : ℕ × Fin r₁ => ζ₀ ^ p.1 * f₁ p.2) f₀
  let NH : Submodule (↥W) A :=
    Submodule.span ↥W (h '' {l : (ℕ × Fin r₁) ⊕ Fin r₀ | wcIaGrad r₁ r₀ l < n})
  have hPζ : ∀ y : A, ζ₀ ^ n * y ∈ P := fun y =>
    Ideal.mem_sup_left (Ideal.mul_mem_right y _ (Ideal.mem_span_singleton_self _))
  have hPϖ : ∀ y : A, algebraMap ↥W A ϖ ^ M * y ∈ P := fun y =>
    Ideal.mem_sup_right (Ideal.mul_mem_right y _ (Ideal.mem_span_singleton_self _))

  have cover : ∀ x : A, x ∈ N' ⊔ P := by
    intro x
    obtain ⟨p, t, hx⟩ := SP ζ₀ n₀ s₀ hs₀ M x
    rw [hx]
    refine add_mem (Submodule.sum_mem _ fun i _ => ?_) (Submodule.mem_sup_right (hPϖ t))
    rw [Polynomial.aeval_eq_sum_range, Finset.sum_mul]
    refine Submodule.sum_mem _ fun k _ => ?_
    rw [smul_mul_assoc]
    refine Submodule.smul_mem _ _ ?_
    by_cases hk : k < n
    · exact Submodule.mem_sup_left (Submodule.subset_span ⟨(⟨k, hk⟩, i), rfl⟩)
    · apply Submodule.mem_sup_right
      have e : ζ₀ ^ k * s₀ i = ζ₀ ^ n * (ζ₀ ^ (k - n) * s₀ i) := by
        rw [← mul_assoc, ← pow_add, Nat.add_sub_cancel' (not_lt.mp hk)]
      rw [e]
      exact hPζ _

  have hmA : ∀ z ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A),
      z ∈ IsLocalRing.maximalIdeal ↥W • N' ⊔ P := by
    intro z hz
    have hz' : z ∈ IsLocalRing.maximalIdeal ↥W • (⊤ : Submodule (↥W) A) := by
      rw [Ideal.smul_top_eq_map]; exact hz
    refine (Submodule.smul_le.mpr ?_) hz'
    intro r hr y _
    obtain ⟨y₁, hy₁, y₂, hy₂, rfl⟩ := Submodule.mem_sup.mp (cover y)
    rw [smul_add]
    exact add_mem (Submodule.mem_sup_left (Submodule.smul_mem_smul hr hy₁))
      (Submodule.mem_sup_right (Submodule.smul_mem _ _ hy₂))

  have hsum : ∀ l : (ℕ × Fin r₁) ⊕ Fin r₀ →₀ ↥W,
      Finsupp.linearCombination ↥W h l = wcIaSum W A ζ₀ r₁ r₀ f₁ f₀ l := by
    intro l
    rw [Finsupp.linearCombination_apply]
    unfold wcIaSum
    exact Finsupp.sum_congr (fun i _ => Algebra.smul_def _ _)
  have hspanH : ∀ y : A, y ∈ NH ↔ ∃ l : (ℕ × Fin r₁) ⊕ Fin r₀ →₀ ↥W,
      (∀ i ∈ l.support, wcIaGrad r₁ r₀ i < n) ∧ wcIaSum W A ζ₀ r₁ r₀ f₁ f₀ l = y := by
    intro y
    rw [Finsupp.mem_span_image_iff_linearCombination]
    constructor
    · rintro ⟨l, hl, rfl⟩
      rw [Finsupp.mem_supported] at hl
      exact ⟨l, fun i hi => hl hi, (hsum l).symm⟩
    · rintro ⟨l, hl, rfl⟩
      refine ⟨l, ?_, hsum l⟩
      rw [Finsupp.mem_supported]
      exact fun i hi => hl i hi

  have key : N' ≤ (NH ⊔ P) ⊔ IsLocalRing.maximalIdeal ↥W • N' := by
    intro x _
    obtain ⟨c, hc, hxc⟩ := hO3 n x
    obtain ⟨y, hy, z, hz, hyz⟩ := Submodule.mem_sup.mp hxc
    have hx : x = wcIaSum W A ζ₀ r₁ r₀ f₁ f₀ c + y + z := by rw [add_assoc, hyz]; ring
    rw [hx]
    have h1 : wcIaSum W A ζ₀ r₁ r₀ f₁ f₀ c ∈ NH := (hspanH _).mpr ⟨c, hc, rfl⟩
    have h2 : y ∈ P := Ideal.mem_sup_left hy
    obtain ⟨z₁, hz₁, z₂, hz₂, rfl⟩ := Submodule.mem_sup.mp (hmA z hz)
    have e : wcIaSum W A ζ₀ r₁ r₀ f₁ f₀ c + y + (z₁ + z₂) =
        (wcIaSum W A ζ₀ r₁ r₀ f₁ f₀ c + (y + z₂)) + z₁ := by ring
    rw [e]
    exact add_mem (Submodule.mem_sup_left (add_mem (Submodule.mem_sup_left h1)
      (Submodule.mem_sup_right (add_mem h2 hz₂)))) (Submodule.mem_sup_right hz₁)

  have hN'le : N' ≤ NH ⊔ P :=
    Submodule.le_of_le_smul_of_le_jacobson_bot (Submodule.fg_span (Set.finite_range _))
      (IsLocalRing.maximalIdeal_le_jacobson ⊥) key

  obtain ⟨u, hu, v, hv, rfl⟩ := Submodule.mem_sup.mp (cover a)
  obtain ⟨u₁, hu₁, v₁, hv₁, rfl⟩ := Submodule.mem_sup.mp (hN'le hu)
  obtain ⟨l, hl, hlu⟩ := (hspanH u₁).mp hu₁
  have hv' : v₁ + v ∈ Ideal.span {ζ₀ ^ n} ⊔ Ideal.span {algebraMap ↥W A ϖ ^ M} := add_mem hv₁ hv
  obtain ⟨y₁, hy₁, y₂, hy₂, hy⟩ := Submodule.mem_sup.mp hv'
  obtain ⟨b, rfl⟩ := Ideal.mem_span_singleton'.mp hy₁
  obtain ⟨b', rfl⟩ := Ideal.mem_span_singleton'.mp hy₂
  refine ⟨l, b, b', hl, ?_⟩
  rw [hlu]
  linear_combination -hy

theorem wcpa_dj_lr1k_nsr_gub_bff_dc_ia_os_nf_assembly : ∀ (Ω : Type u) [Field Ω]
    [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) →
    W ≠ ⊤ → ∀ (A : Type u) [CommRing A] [Algebra ↥W A] (ζ : A) (D r₁ r₀ : ℕ)
      (f₁ : Fin r₁ → A) (f₀ : Fin r₀ → A) (o₁ : Fin r₁ → ℕ) (o₀ : Fin r₀ → ℕ) (E : ↥W),
      1 ≤ D →
      (∀ (c : (ℕ × Fin r₁) ⊕ Fin r₀ →₀ ↥W) (α : ℕ),
        (∀ i ∈ c.support, wcIaOrd D r₁ r₀ o₁ o₀ i = α) → (∃ i, IsUnit (c i)) →
        ∀ N : ℕ, 1 ≤ N →
          ¬ wcIaResOrd W A ζ (D * N) (N * α + 1) (wcIaSum W A ζ r₁ r₀ f₁ f₀ c)) →
      E ≠ 0 → E ∈ IsLocalRing.maximalIdeal ↥W →
      (∀ e : ↥W, e ≠ 0 → e ∣ E → ∀ ψ : wcGubGen W A →+* Ω, wcIaPt W A ζ e ψ →
        (∀ j, ∃ x : ↥W, (x : Ω) = ψ (algebraMap A (wcGubGen W A) (f₁ j)) ∧ e ^ o₁ j ∣ x ^ D) ∧
        (∀ j, ∃ x : ↥W, (x : Ω) = ψ (algebraMap A (wcGubGen W A) (f₀ j)) ∧ e ^ o₀ j ∣ x ^ D)) →
      (∀ (D' k : ℕ) (g : A) (e w : ↥W), 1 ≤ D' → e ≠ 0 → e ∈ IsLocalRing.maximalIdeal ↥W →
        e ∣ E →
        (∀ ψ : wcGubGen W A →+* Ω, wcIaPt W A ζ e ψ →
          ∃ u : ↥W, ψ (algebraMap A (wcGubGen W A) g) = (w : Ω) * (u : Ω)) →
        e ^ k ∣ w ^ D' → wcIaResOrd W A ζ D' k g) →
      ∃ e₀ : ↥W, e₀ ≠ 0 ∧ e₀ ∈ IsLocalRing.maximalIdeal ↥W ∧
        ∀ e : ↥W, e ∣ e₀ → wcIaNF W A ζ D r₁ r₀ f₁ f₀ o₁ o₀ e :=
by
  intro Ω _ _ W hdim hWt A _ _ ζ D r₁ r₀ f₁ f₀ o₁ o₀ E hD hO2 hE0 hEm hUp hLow
  classical

  have hroot : ∀ (y : ↥W) (n : ℕ), 1 ≤ n → ∃ z : ↥W, z ^ n = y := by
    intro y n hn
    obtain ⟨x, hx⟩ := IsAlgClosed.exists_pow_nat_eq (y : Ω) (by omega : 0 < n)
    rcases W.mem_or_inv_mem x with h | h
    · exact ⟨⟨x, h⟩, Subtype.ext (by rw [SubmonoidClass.coe_pow]; exact hx)⟩
    · by_cases hx0 : x = 0
      · refine ⟨0, Subtype.ext ?_⟩
        rw [SubmonoidClass.coe_pow, ← hx, hx0, ZeroMemClass.coe_zero]
      · obtain ⟨n', rfl⟩ : ∃ n', n = n' + 1 := ⟨n - 1, by omega⟩
        have hmem : x ∈ W := by
          have hxe : x = (y : Ω) * (x⁻¹) ^ n' := by
            rw [← hx, inv_pow, pow_succ, mul_comm (x ^ n') x, mul_assoc,
              mul_inv_cancel₀ (pow_ne_zero _ hx0), mul_one]
          rw [hxe]
          exact mul_mem y.2 (pow_mem h n')
        exact ⟨⟨x, hmem⟩, Subtype.ext (by rw [SubmonoidClass.coe_pow]; exact hx)⟩

  have harch : ∀ e β : ↥W, e ≠ 0 → β ∈ IsLocalRing.maximalIdeal ↥W → ∃ K : ℕ, e ∣ β ^ K := by
    intro e β he hβ
    haveI : Ring.KrullDimLE 1 ↥W := Ring.krullDimLE_iff.mpr hdim
    have hle : IsLocalRing.maximalIdeal ↥W ≤ (Ideal.span {e}).radical := by
      rw [Ideal.radical_eq_sInf]
      refine le_sInf ?_
      rintro P ⟨hPe, hPp⟩
      have hP0 : P ≠ ⊥ := by
        intro h
        apply he
        have : e ∈ P := hPe (Ideal.mem_span_singleton_self e)
        rw [h] at this
        exact (Submodule.mem_bot _).mp this
      haveI := hPp
      have hPmax : P.IsMaximal := Ideal.isMaximal_of_isPrime_of_ne_bot P hP0
      exact le_of_eq (IsLocalRing.eq_maximalIdeal hPmax).symm
    obtain ⟨K, hK⟩ := hle hβ
    obtain ⟨a, ha⟩ := Ideal.mem_span_singleton'.mp hK
    exact ⟨K, ⟨a, by rw [← ha, mul_comm]⟩⟩
  have hunitW : ∀ w : ↥W, w ≠ 0 →
      IsUnit (algebraMap A (wcGubGen W A) (algebraMap ↥W A w)) := by
    intro w hw
    exact IsLocalization.map_units (wcGubGen W A)
      (⟨algebraMap (↥W) A w, Submonoid.mem_map_of_mem _ (mem_nonZeroDivisors_of_ne_zero hw)⟩ :
        Submonoid.map (algebraMap (↥W) A) (nonZeroDivisors ↥W))

  have hptz : ∀ (e : ↥W) (ψ : wcGubGen W A →+* Ω), e ≠ 0 → wcIaPt W A ζ e ψ →
      ∃ t : ↥W, ψ (algebraMap A (wcGubGen W A) ζ) = (e : Ω) * (t : Ω) := by
    intro e ψ he hψ
    refine ⟨⟨_, hψ.2.2⟩, ?_⟩
    have hu := hunitW e he
    have h1 : algebraMap A (wcGubGen W A) ζ = algebraMap A (wcGubGen W A) (algebraMap ↥W A e) *
        (algebraMap A (wcGubGen W A) ζ *
          Ring.inverse (algebraMap A (wcGubGen W A) (algebraMap ↥W A e))) := by
      rw [mul_left_comm, Ring.mul_inverse_cancel _ hu, mul_one]
    show ψ (algebraMap A (wcGubGen W A) ζ) = (e : Ω) * ψ (algebraMap A (wcGubGen W A) ζ *
          Ring.inverse (algebraMap A (wcGubGen W A) (algebraMap ↥W A e)))
    conv_lhs => rw [h1]
    rw [map_mul, hψ.1 e]

  have hptm : ∀ (e e' : ↥W) (ψ : wcGubGen W A →+* Ω), e ≠ 0 → e' ≠ 0 → e ∣ e' →
      wcIaPt W A ζ e' ψ → wcIaPt W A ζ e ψ := by
    rintro e e' ψ he he' ⟨s, rfl⟩ hψ
    refine ⟨hψ.1, hψ.2.1, ?_⟩
    have hu := hunitW e he
    have hu' := hunitW (e * s) he'
    have hE : algebraMap A (wcGubGen W A) (algebraMap ↥W A (e * s)) =
        algebraMap A (wcGubGen W A) (algebraMap ↥W A e) *
          algebraMap A (wcGubGen W A) (algebraMap ↥W A s) := by
      rw [map_mul, map_mul]
    have key : Ring.inverse (algebraMap A (wcGubGen W A) (algebraMap ↥W A e)) =
        algebraMap A (wcGubGen W A) (algebraMap ↥W A s) *
          Ring.inverse (algebraMap A (wcGubGen W A) (algebraMap ↥W A (e * s))) := by
      apply hu.mul_left_cancel
      rw [Ring.mul_inverse_cancel _ hu, ← mul_assoc, ← hE, Ring.mul_inverse_cancel _ hu']
    rw [key, mul_left_comm, map_mul, hψ.1 s]
    exact mul_mem s.2 hψ.2.2

  have hupper : ∀ (e t : ↥W) (ψ : wcGubGen W A →+* Ω),
      (∀ w : ↥W, ψ (algebraMap A (wcGubGen W A) (algebraMap ↥W A w)) = (w : Ω)) →
      ψ (algebraMap A (wcGubGen W A) ζ) = (e : Ω) * (t : Ω) →
      (∀ j, ∃ x : ↥W, (x : Ω) = ψ (algebraMap A (wcGubGen W A) (f₁ j)) ∧ e ^ o₁ j ∣ x ^ D) →
      (∀ j, ∃ x : ↥W, (x : Ω) = ψ (algebraMap A (wcGubGen W A) (f₀ j)) ∧ e ^ o₀ j ∣ x ^ D) →
      ∀ (c : (ℕ × Fin r₁) ⊕ Fin r₀ →₀ ↥W) (w : ↥W),
      (∀ i, w ^ D ∣ c i ^ D * e ^ wcIaOrd D r₁ r₀ o₁ o₀ i) →
      ∃ u : ↥W, ψ (algebraMap A (wcGubGen W A) (wcIaSum W A ζ r₁ r₀ f₁ f₀ c)) =
        (w : Ω) * (u : Ω) := by
    intro e t ψ hW hζ h₁ h₀ c w hdiv
    choose x₁ hx₁ hx₁d using h₁
    choose x₀ hx₀ hx₀d using h₀
    let y : (ℕ × Fin r₁) ⊕ Fin r₀ → ↥W := Sum.elim (fun p => (e * t) ^ p.1 * x₁ p.2) x₀
    have hy : ∀ i, (y i : Ω) = ψ (algebraMap A (wcGubGen W A)
        (Sum.elim (fun p : ℕ × Fin r₁ => ζ ^ p.1 * f₁ p.2) f₀ i)) := by
      rintro (⟨n, j⟩ | j)
      · simp only [y, Sum.elim_inl, map_mul, map_pow, hζ, ← hx₁ j, MulMemClass.coe_mul,
          SubmonoidClass.coe_pow]
      · simp only [y, Sum.elim_inr, hx₀ j]
    have hyd : ∀ i, e ^ wcIaOrd D r₁ r₀ o₁ o₀ i ∣ y i ^ D := by
      rintro (⟨n, j⟩ | j)
      · show e ^ (D * n + o₁ j) ∣ ((e * t) ^ n * x₁ j) ^ D
        have h1 : ((e * t) ^ n * x₁ j) ^ D = e ^ (D * n) * (t ^ (D * n) * x₁ j ^ D) := by ring
        rw [h1, pow_add]
        exact mul_dvd_mul_left _ ((hx₁d j).mul_left _)
      · exact hx₀d j
    have hk : ∀ i, ∃ k : ↥W, c i * y i = w * k := by
      intro i
      have h1 : w ^ D ∣ (c i * y i) ^ D := by
        rw [mul_pow]
        exact (hdiv i).trans (mul_dvd_mul_left _ (hyd i))
      exact (IsIntegrallyClosed.pow_dvd_pow_iff (by omega : D ≠ 0)).mp h1
    choose k hk using hk
    refine ⟨∑ i ∈ c.support, k i, ?_⟩
    unfold wcIaSum
    rw [Finsupp.sum, map_sum, map_sum, AddSubmonoidClass.coe_finsetSum, Finset.mul_sum]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [map_mul, map_mul, hW, ← hy i, ← MulMemClass.coe_mul, ← MulMemClass.coe_mul, hk i]

  have hmin : ∀ (s : Finset ((ℕ × Fin r₁) ⊕ Fin r₀)) (q : (ℕ × Fin r₁) ⊕ Fin r₀ → ↥W),
      s.Nonempty → ∃ m ∈ s, ∀ i ∈ s, q m ∣ q i := by
    intro s q
    induction s using Finset.induction_on with
    | empty => intro h; exact absurd h Finset.not_nonempty_empty
    | insert a s' ha ih =>
      intro _
      rcases s'.eq_empty_or_nonempty with h | h
      · subst h
        refine ⟨a, Finset.mem_insert_self _ _, fun i hi => ?_⟩
        rcases Finset.mem_insert.mp hi with rfl | hi
        · exact dvd_rfl
        · exact absurd hi (Finset.notMem_empty i)
      · obtain ⟨m, hm, hm'⟩ := ih h
        rcases ValuationRing.dvd_total (q a) (q m) with h1 | h1
        · refine ⟨a, Finset.mem_insert_self _ _, fun i hi => ?_⟩
          rcases Finset.mem_insert.mp hi with rfl | hi
          · exact dvd_rfl
          · exact h1.trans (hm' i hi)
        · refine ⟨m, Finset.mem_insert_of_mem hm, fun i hi => ?_⟩
          rcases Finset.mem_insert.mp hi with rfl | hi
          · exact h1
          · exact hm' i hi
  have hcomb : ∀ x y : ↥W, x ≠ 0 → x ∈ IsLocalRing.maximalIdeal ↥W → y ≠ 0 →
      y ∈ IsLocalRing.maximalIdeal ↥W →
      ∃ z : ↥W, z ≠ 0 ∧ z ∈ IsLocalRing.maximalIdeal ↥W ∧ z ∣ x ∧ z ∣ y := by
    intro x y hx hxm hy hym
    rcases ValuationRing.dvd_total x y with h | h
    · exact ⟨x, hx, hxm, dvd_rfl, h⟩
    · exact ⟨y, hy, hym, h, dvd_rfl⟩

  have hlin_add : ∀ f g : (ℕ × Fin r₁) ⊕ Fin r₀ →₀ ↥W,
      wcIaSum W A ζ r₁ r₀ f₁ f₀ (f + g) =
        wcIaSum W A ζ r₁ r₀ f₁ f₀ f + wcIaSum W A ζ r₁ r₀ f₁ f₀ g := by
    intro f g
    unfold wcIaSum
    exact Finsupp.sum_add_index' (fun i => by simp) (fun i a b => by simp only [map_add, add_mul])
  have hlin_smul : ∀ (b : ↥W) (f : (ℕ × Fin r₁) ⊕ Fin r₀ →₀ ↥W),
      wcIaSum W A ζ r₁ r₀ f₁ f₀ (b • f) = algebraMap ↥W A b * wcIaSum W A ζ r₁ r₀ f₁ f₀ f := by
    intro b f
    unfold wcIaSum
    rw [Finsupp.sum_smul_index (fun i => by simp), Finsupp.mul_sum]
    refine Finsupp.sum_congr (fun i _ => ?_)
    simp only [map_mul, mul_assoc]

  obtain ⟨e₀, hz⟩ := hroot E 2 (by norm_num)
  have he₀0 : e₀ ≠ 0 := by
    rintro rfl
    apply hE0
    rw [← hz]
    ring
  have he₀m : e₀ ∈ IsLocalRing.maximalIdeal ↥W := by
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    intro h
    have : IsUnit E := hz ▸ h.pow 2
    exact mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal _).mp hEm) this
  refine ⟨e₀, he₀0, he₀m, fun e he => ?_⟩
  have he0 : e ≠ 0 := by
    rintro rfl
    exact he₀0 (zero_dvd_iff.mp he)
  have heE : e ∣ E := he.trans ⟨e₀, by rw [← hz, pow_two]⟩
  unfold wcIaNF
  intro c w
  constructor
  swap
  ·
    intro hdiv ψ hψ
    obtain ⟨t, ht⟩ := hptz e ψ he0 hψ
    obtain ⟨h1, h0⟩ := hUp e he0 heE ψ hψ
    exact hupper e t ψ hψ.1 ht h1 h0 c w hdiv

  intro H
  by_contra hneg
  push_neg at hneg
  obtain ⟨i₀, hi₀⟩ := hneg
  obtain ⟨q, hq⟩ : ∃ q : (ℕ × Fin r₁) ⊕ Fin r₀ → ↥W,
      ∀ i, q i = c i ^ D * e ^ wcIaOrd D r₁ r₀ o₁ o₀ i := ⟨_, fun i => rfl⟩
  have hi₀s : i₀ ∈ c.support := by
    by_contra hi
    apply hi₀
    rw [Finsupp.notMem_support_iff.mp hi, zero_pow (by omega), zero_mul]
    exact dvd_zero _
  have hq0 : ∀ i ∈ c.support, q i ≠ 0 := by
    intro i hi
    rw [hq i]
    exact mul_ne_zero (pow_ne_zero _ (Finsupp.mem_support_iff.mp hi)) (pow_ne_zero _ he0)

  obtain ⟨m₁, hm₁, hm₁'⟩ := hmin c.support q ⟨i₀, hi₀s⟩
  obtain ⟨i₁, hi₁S, hi₁min⟩ := Finset.exists_min_image
    (c.support.filter (fun i => q i ∣ q m₁)) (wcIaOrd D r₁ r₀ o₁ o₀)
    ⟨m₁, Finset.mem_filter.mpr ⟨hm₁, dvd_rfl⟩⟩
  obtain ⟨hi₁s, hi₁q⟩ := Finset.mem_filter.mp hi₁S
  have ha : ∀ i ∈ c.support, q i₁ ∣ q i := fun i hi => hi₁q.trans (hm₁' i hi)
  have hb : ∀ i ∈ c.support, q i ∣ q i₁ →
      wcIaOrd D r₁ r₀ o₁ o₀ i₁ ≤ wcIaOrd D r₁ r₀ o₁ o₀ i :=
    fun i hi h => hi₁min i (Finset.mem_filter.mpr ⟨hi, h.trans hi₁q⟩)
  have hγ0 : c i₁ ≠ 0 := Finsupp.mem_support_iff.mp hi₁s
  have hh : ¬ w ^ D ∣ q i₁ := by
    intro h
    apply hi₀
    rw [← hq i₀]
    exact h.trans (ha i₀ hi₀s)

  obtain ⟨u, hu⟩ : q i₁ ∣ w ^ D := (ValuationRing.dvd_total (w ^ D) (q i₁)).resolve_left hh
  have hum : u ∈ IsLocalRing.maximalIdeal ↥W := by
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    intro hu'
    apply hh
    obtain ⟨v, rfl⟩ := hu'
    exact ⟨↑v⁻¹, by rw [hu, mul_assoc, Units.mul_inv, mul_one]⟩
  have hgap : ∀ i, ∃ g : ↥W, g ≠ 0 ∧ g ∈ IsLocalRing.maximalIdeal ↥W ∧
      (i ∈ c.support → (q i ∣ q i₁ ∨ q i₁ * g ∣ q i)) := by
    intro i
    by_cases hi : i ∈ c.support
    · by_cases hqd : q i ∣ q i₁
      · exact ⟨e₀, he₀0, he₀m, fun _ => Or.inl hqd⟩
      · obtain ⟨t, ht⟩ := ha i hi
        refine ⟨t, ?_, ?_, fun _ => Or.inr (dvd_of_eq ht.symm)⟩
        · rintro rfl
          exact hq0 i hi (by rw [ht, mul_zero])
        · rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
          rintro ⟨v, rfl⟩
          exact hqd ⟨↑v⁻¹, by rw [ht, mul_assoc, Units.mul_inv, mul_one]⟩
    · exact ⟨e₀, he₀0, he₀m, fun h => absurd h hi⟩
  choose g hg0 hgm hg using hgap
  obtain ⟨gu, hgu0, hgum, hgu⟩ : ∃ gu : ↥W, gu ≠ 0 ∧ gu ∈ IsLocalRing.maximalIdeal ↥W ∧
      gu ∣ u := by
    by_cases hu0 : u = 0
    · exact ⟨e₀, he₀0, he₀m, by rw [hu0]; exact dvd_zero _⟩
    · exact ⟨u, hu0, hum, dvd_rfl⟩
  obtain ⟨m₀, hm₀, hm₀'⟩ := hmin c.support g ⟨i₀, hi₀s⟩
  obtain ⟨z₁, hz₁0, hz₁m, hz₁e, hz₁u⟩ := hcomb e₀ gu he₀0 he₀m hgu0 hgum
  obtain ⟨τ, hτ0, hτm, hτz, hτg⟩ := hcomb z₁ (g m₀) hz₁0 hz₁m (hg0 m₀) (hgm m₀)
  have hτe₀ : τ ∣ e₀ := hτz.trans hz₁e
  have hτu : τ ∣ u := hτz.trans (hz₁u.trans hgu)
  have hτgi : ∀ i ∈ c.support, τ ∣ g i := fun i hi => hτg.trans (hm₀' i hi)
  obtain ⟨β, hβ⟩ := hroot τ (wcIaOrd D r₁ r₀ o₁ o₀ i₁ + 1) (by omega)
  have hβ0 : β ≠ 0 := by
    rintro rfl
    apply hτ0
    rw [← hβ, zero_pow (Nat.succ_ne_zero _)]
  have hβm : β ∈ IsLocalRing.maximalIdeal ↥W := by
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    intro h
    exact mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal _).mp hτm) (hβ ▸ h.pow _)
  have hβτ : β ∣ τ := ⟨β ^ wcIaOrd D r₁ r₀ o₁ o₀ i₁, by rw [← hβ, pow_succ']⟩
  have hβe₀ : β ∣ e₀ := hβτ.trans hτe₀
  obtain ⟨K, hK⟩ := harch e β he0 hβm
  have hDN0 : D * (K + 1) ≠ 0 := mul_ne_zero (by omega) (by omega)
  have hDN : 1 ≤ D * (K + 1) := Nat.pos_of_ne_zero hDN0
  obtain ⟨w₀, hw₀⟩ := hroot ((e * β) ^ ((K + 1) * wcIaOrd D r₁ r₀ o₁ o₀ i₁ + 1)) (D * (K + 1)) hDN
  have hF : e * β ^ ((K + 1) * wcIaOrd D r₁ r₀ o₁ o₀ i₁ + 1) ∣ τ ^ (K + 1) := by
    rw [← hβ]
    have h1 : (β ^ (wcIaOrd D r₁ r₀ o₁ o₀ i₁ + 1)) ^ (K + 1) =
        β ^ K * β ^ ((K + 1) * wcIaOrd D r₁ r₀ o₁ o₀ i₁ + 1) := by ring
    rw [h1]
    exact mul_dvd_mul_right hK _
  have hI : (c i₁ * w₀) ^ (D * (K + 1)) =
      q i₁ ^ (K + 1) * (e * β ^ ((K + 1) * wcIaOrd D r₁ r₀ o₁ o₀ i₁ + 1)) := by
    rw [mul_pow, hw₀, hq i₁]
    ring
  have hγw : c i₁ * w₀ ∣ w := by
    apply (IsIntegrallyClosed.pow_dvd_pow_iff hDN0).mp
    rw [hI, pow_mul, hu, mul_pow]
    exact mul_dvd_mul_left _ (hF.trans (pow_dvd_pow_of_dvd hτu _))
  have hsub : ∀ i ∈ c.support, wcIaOrd D r₁ r₀ o₁ o₀ i ≠ wcIaOrd D r₁ r₀ o₁ o₀ i₁ →
      (c i₁ * w₀) ^ D ∣ c i ^ D * (e * β) ^ wcIaOrd D r₁ r₀ o₁ o₀ i := by
    intro i hi hne
    have hclaim : q i₁ * τ ∣ q i * β ^ wcIaOrd D r₁ r₀ o₁ o₀ i := by
      rcases hg i hi with h | h
      · have hle : wcIaOrd D r₁ r₀ o₁ o₀ i₁ + 1 ≤ wcIaOrd D r₁ r₀ o₁ o₀ i := by
          have := hb i hi h
          omega
        rw [← hβ]
        exact mul_dvd_mul (ha i hi) (pow_dvd_pow β hle)
      · exact (mul_dvd_mul_left (q i₁) (hτgi i hi)).trans (h.trans (dvd_mul_right _ _))
    apply (IsIntegrallyClosed.pow_dvd_pow_iff (n := K + 1) (by omega)).mp
    have hci : c i ^ D * (e * β) ^ wcIaOrd D r₁ r₀ o₁ o₀ i =
        q i * β ^ wcIaOrd D r₁ r₀ o₁ o₀ i := by
      rw [hq i]
      ring
    rw [← pow_mul, hI, hci]
    calc q i₁ ^ (K + 1) * (e * β ^ ((K + 1) * wcIaOrd D r₁ r₀ o₁ o₀ i₁ + 1))
        ∣ q i₁ ^ (K + 1) * τ ^ (K + 1) := mul_dvd_mul_left _ hF
      _ = (q i₁ * τ) ^ (K + 1) := (mul_pow _ _ _).symm
      _ ∣ (q i * β ^ wcIaOrd D r₁ r₀ o₁ o₀ i) ^ (K + 1) := pow_dvd_pow_of_dvd hclaim _

  have he'0 : e * β ≠ 0 := mul_ne_zero he0 hβ0
  have he'm : e * β ∈ IsLocalRing.maximalIdeal ↥W := Ideal.mul_mem_left _ e hβm
  have he'E : e * β ∣ E := by
    rw [← hz, pow_two]
    exact mul_dvd_mul he hβe₀

  have hdivγ : ∀ i, wcIaOrd D r₁ r₀ o₁ o₀ i = wcIaOrd D r₁ r₀ o₁ o₀ i₁ → c i₁ ∣ c i := by
    intro i hi
    by_cases his : i ∈ c.support
    · have h1 := ha i his
      rw [hq, hq, hi] at h1
      have h2 : c i₁ ^ D ∣ c i ^ D := (mul_dvd_mul_iff_right (pow_ne_zero _ he0)).mp h1
      exact (IsIntegrallyClosed.pow_dvd_pow_iff (by omega)).mp h2
    · rw [Finsupp.notMem_support_iff.mp his]
      exact dvd_zero _
  have hvex : ∀ i, ∃ v : ↥W, wcIaOrd D r₁ r₀ o₁ o₀ i = wcIaOrd D r₁ r₀ o₁ o₀ i₁ →
      c i = c i₁ * v := by
    intro i
    by_cases h : wcIaOrd D r₁ r₀ o₁ o₀ i = wcIaOrd D r₁ r₀ o₁ o₀ i₁
    · obtain ⟨v, hv⟩ := hdivγ i h
      exact ⟨v, fun _ => hv⟩
    · exact ⟨0, fun h' => absurd h' h⟩
  choose v hv using hvex
  obtain ⟨c', hc'⟩ : ∃ c' : (ℕ × Fin r₁) ⊕ Fin r₀ →₀ ↥W, ∀ i,
      c' i = if wcIaOrd D r₁ r₀ o₁ o₀ i = wcIaOrd D r₁ r₀ o₁ o₀ i₁ then v i else 0 := by
    refine ⟨Finsupp.onFinset c.support
      (fun i => if wcIaOrd D r₁ r₀ o₁ o₀ i = wcIaOrd D r₁ r₀ o₁ o₀ i₁ then v i else 0) ?_,
      fun i => rfl⟩
    intro i hi
    rw [Finsupp.mem_support_iff]
    intro hci
    apply hi
    split_ifs with h
    · have h1 := hv i h
      rw [hci] at h1
      exact (mul_eq_zero.mp h1.symm).resolve_left hγ0
    · rfl
  have hv1 : v i₁ = 1 := mul_left_cancel₀ hγ0 ((hv i₁ rfl).symm.trans (mul_one _).symm)
  have hsupp : ∀ i ∈ c'.support, wcIaOrd D r₁ r₀ o₁ o₀ i = wcIaOrd D r₁ r₀ o₁ o₀ i₁ := by
    intro i hi
    rw [Finsupp.mem_support_iff] at hi
    by_contra h
    apply hi
    rw [hc' i, if_neg h]
  have hunit : IsUnit (c' i₁) := by
    rw [hc' i₁, if_pos rfl, hv1]
    exact isUnit_one
  have hc''apply : ∀ i, (c - c i₁ • c') i = c i - c i₁ * c' i := by
    intro i
    rw [Finsupp.sub_apply, Finsupp.smul_apply, smul_eq_mul]
  have hsum : wcIaSum W A ζ r₁ r₀ f₁ f₀ c = algebraMap ↥W A (c i₁) * wcIaSum W A ζ r₁ r₀ f₁ f₀ c' +
      wcIaSum W A ζ r₁ r₀ f₁ f₀ (c - c i₁ • c') := by
    rw [← hlin_smul, ← hlin_add]
    congr 1
    abel

  have hpt : ∀ ψ : wcGubGen W A →+* Ω, wcIaPt W A ζ (e * β) ψ →
      ∃ u : ↥W, ψ (algebraMap A (wcGubGen W A) (wcIaSum W A ζ r₁ r₀ f₁ f₀ c')) =
        (w₀ : Ω) * (u : Ω) := by
    intro ψ hψ
    have hψe := hptm e (e * β) ψ he0 he'0 (dvd_mul_right e β) hψ
    obtain ⟨u₁, hu₁⟩ := H ψ hψe
    obtain ⟨kk, hkk⟩ := hγw
    obtain ⟨t', ht'⟩ := hptz (e * β) ψ he'0 hψ
    obtain ⟨hw1, hw0⟩ := hUp (e * β) he'0 he'E ψ hψ
    obtain ⟨u₂, hu₂⟩ := hupper (e * β) t' ψ hψ.1 ht' hw1 hw0 (c - c i₁ • c') (c i₁ * w₀) (by
      intro i
      rw [hc''apply]
      by_cases hi : wcIaOrd D r₁ r₀ o₁ o₀ i = wcIaOrd D r₁ r₀ o₁ o₀ i₁
      · rw [hc' i, if_pos hi, ← hv i hi, sub_self, zero_pow (by omega), zero_mul]
        exact dvd_zero _
      · rw [hc' i, if_neg hi, mul_zero, sub_zero]
        by_cases his : i ∈ c.support
        · exact hsub i his hi
        · rw [Finsupp.notMem_support_iff.mp his, zero_pow (by omega), zero_mul]
          exact dvd_zero _)
    have hs := congrArg (fun x => ψ (algebraMap A (wcGubGen W A) x)) hsum
    simp only [map_add, map_mul, hψ.1] at hs
    rw [hu₁, hu₂, MulMemClass.coe_mul] at hs
    have hwΩ : (w : Ω) = (c i₁ : Ω) * (w₀ : Ω) * (kk : Ω) := by
      rw [hkk, MulMemClass.coe_mul, MulMemClass.coe_mul]
    have hγΩ : (c i₁ : Ω) ≠ 0 := fun h => hγ0 (Subtype.ext h)
    refine ⟨kk * u₁ - u₂, ?_⟩
    rw [AddSubgroupClass.coe_sub, MulMemClass.coe_mul]
    apply mul_left_cancel₀ hγΩ
    linear_combination -hs + (u₁ : Ω) * hwΩ

  have hres := hLow (D * (K + 1)) ((K + 1) * wcIaOrd D r₁ r₀ o₁ o₀ i₁ + 1)
    (wcIaSum W A ζ r₁ r₀ f₁ f₀ c') (e * β) w₀ hDN he'0 he'm he'E hpt (dvd_of_eq hw₀.symm)
  exact hO2 c' (wcIaOrd D r₁ r₀ o₁ o₀ i₁) hsupp ⟨i₁, hunit⟩ (K + 1) (by omega) hres

