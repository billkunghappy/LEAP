      IsOpenImmersion p ∧ (∀ x' : ↥X', r x' ∈ U → x' ∈ Set.range p) ∧ p ≫ r = sU ≫ U.ι ∧
      Etale κ ∧ IsPullback κ sU r₀ m :=
by
  intro Ω _ W X uX σ b hσ U m ΔU hUaff hmet hmC hΔU hΔm hker X' r hr M' r₀ hr₀
  haveI : IsAffine U.toScheme := hUaff
  have hJeq : (σ.ker ⊔ wcNcPrincipal (.of ↥W) X uX b).comap U.ι =
      (Scheme.Hom.ker (Spec.map (CommRingCat.ofHom
          (MvPolynomial.eval (fun _ : Fin 1 => (0 : ↥W))))) ⊔
        wcNcPrincipal (.of ↥W) (Spec (.of (MvPolynomial (Fin 1) ↥W)))
          (Spec.map (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W)))
