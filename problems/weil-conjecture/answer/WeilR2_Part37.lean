  haveI : 𝔫.IsPrime := h𝔫max.isPrime
  haveI hqf : Algebra.QuasiFiniteAt (MvPolynomial (Fin s) ↥W) 𝔫 :=
    t_qf _ R hftS 𝔫 (fun Q hQ hQc => hallmax Q hQ (hfibre Q hQ hQc))
