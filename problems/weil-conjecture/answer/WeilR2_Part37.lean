    intro T F d P h1 h0
    funext y
    by_cases h : P y
    · rw [h1 y h, if_pos h]
    · rw [h0 y h, if_neg h]

  have Abs : ∀ {T0 T' T1 T2 PX PX' PX1 PX2 : Type u}
      (i0 : T0 → PX) (i' : T' → PX') (i1 : T1 → PX1) (i2 : T2 → PX2)
      (rr : PX' → PX) (rr2 : PX2 → PX') (qq : PX2 → PX1)
      (d0 : T0 → ℕ∞) (d' : T' → ℕ∞) (d1 : T1 → ℕ∞) (d2 : T2 → ℕ∞)
      (ns2 : T2 → Prop) (y₀ : T0) (y' : T') (y₁ : T1)
      {F2 : T2 → ℕ∞} {F0 : T0 → ℕ∞} {F1 : T1 → ℕ∞} {FB FU : T' → ℕ∞}
      {Q2 Q3 : T2 → Prop} {Q2' Q3' : T' → Prop}
      (e2 : {y // Q2 y} ≃ {y // Q2' y}) (e3 : {y // Q3 y} ≃ {y // Q3' y}),
      rr (i' y') = i0 y₀ →
      (∀ y, Q2 y ↔ rr2 (i2 y) ≠ i' y') → (∀ y, Q2' y ↔ i' y ≠ i' y') →
      (∀ y, Q3 y ↔ rr (rr2 (i2 y)) ≠ i0 y₀) → (∀ y, Q3' y ↔ rr (i' y) ≠ i0 y₀) →
      (∀ z, d2 z.1 = d' (e2 z).1) → (∀ z, d2 z.1 = d' (e3 z).1) →
      (∀ y, qq (i2 y) = i1 y₁ → F2 y = d2 y) → (∀ y, ¬ qq (i2 y) = i1 y₁ → F2 y = 0) →
      (∀ y, i0 y = i0 y₀ → F0 y = d0 y) → (∀ y, ¬ i0 y = i0 y₀ → F0 y = 0) →
      (∀ y, i1 y = i1 y₁ → F1 y = d1 y) → (∀ y, ¬ i1 y = i1 y₁ → F1 y = 0) →
      (∀ y, rr (i' y) = i0 y₀ → FB y = d' y) → (∀ y, ¬ rr (i' y) = i0 y₀ → FB y = 0) →
      (∀ y, FU y = d' y) →
      (⨆ s : Finset T', ∑ y ∈ s, FU y) ≠ ⊤ →
      (∀ y, i0 y = i0 y₀ → d0 y = d0 y₀) → (∀ y, i' y = i' y' → d' y = d' y') →
      (∀ y, i1 y = i1 y₁ → d1 y = d1 y₁) →
      (∀ y, rr2 (i2 y) = i' y' → ns2 y → d2 y ≤ 1) →
      (∀ y, qq (i2 y) = i1 y₁ ↔ ((rr (rr2 (i2 y)) = i0 y₀ ∧ rr2 (i2 y) ≠ i' y') ∨
        (rr2 (i2 y) = i' y' ∧ ns2 y))) →
      (⨆ s : Finset T2, ∑ y ∈ s, F2 y) + (⨆ s : Finset T0, ∑ y ∈ s, F0 y) =
        (⨆ s : Finset T1, ∑ y ∈ s, F1 y) + (⨆ s : Finset T', ∑ y ∈ s, FB y) →
