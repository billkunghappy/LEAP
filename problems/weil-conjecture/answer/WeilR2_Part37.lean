    ext z
    obtain ⟨w, rfl⟩ := hsurj z
    rw [← ValuationSubring.mem_comap, hVV, ValuationSubring.mem_comap]

  have hdim1 : ∀ (Z : Scheme.{u}) (ζ t : Z), ζ ⤳ t → ζ ≠ t →
      ringKrullDim (Z.presheaf.stalk t) ≤ ((1 : ℕ) : WithBot ℕ∞) →
