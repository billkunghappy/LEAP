    have h1 : e ^ k ∣ (ϖ ^ Ke) ^ k := pow_dvd_pow_of_dvd hKe k
    rw [← pow_mul] at h1
    exact h1.trans (pow_dvd_pow ϖ (Nat.mul_le_mul_left Ke hkK))
