      exact (hspec y (specializes_iff_mem_closure.mpr hy)).symm

  have hScl : IsClosed (E ∩ closure Eᶜ) := hEcl.inter isClosed_closure
  obtain ⟨𝒮, h𝒮fin, h𝒮cl, h𝒮irr, h𝒮eq⟩ :=
    TopologicalSpace.NoetherianSpace.exists_finite_set_isClosed_irreducible hScl
  have hsing : ∀ t ∈ 𝒮, t.Finite := by
    intro t ht
    have hg0 := (h𝒮irr t ht).isGenericPoint_genericPoint_closure
    rw [(h𝒮cl t ht).closure_eq] at hg0
    obtain ⟨g, hg⟩ : ∃ g, IsGenericPoint g t := ⟨_, hg0⟩
    have hgS : g ∈ E ∩ closure Eᶜ := by
      rw [h𝒮eq]
      exact Set.mem_sUnion_of_mem hg.mem ht
    have hgcl := hclosed g hgS
    have htg : t = {g} := (show closure {g} = t from hg).symm.trans hgcl.closure_eq
    rw [htg]
    exact Set.finite_singleton g
  refine ⟨?_, hclosed⟩
  rw [h𝒮eq]
  exact h𝒮fin.sUnion hsing

theorem wcpa_dj_lus_cvs_ct_dim_one_topology : ∀ (X : Type u) [TopologicalSpace X] [TopologicalSpace.NoetherianSpace X] [QuasiSober X] [T0Space X], topologicalKrullDim X ≤ ((1 : ℕ) : WithBot ℕ∞) → ∀ T : Set X, IsClosed T → ∀ y ∈ T, (∀ D ∈ irreducibleComponents X, y ∈ D → ¬ D ⊆ T) → ∃ U : Set X, IsOpen U ∧ y ∈ U ∧ U ∩ T = {y} :=
by
  intro X _ _ _ _ hdim T hT y hyT hcomp

  have hchain : ∀ A B C : Set X, IsIrreducible A → IsClosed A → IsIrreducible B → IsClosed B →
      IsIrreducible C → IsClosed C → A ⊂ B → B ⊂ C → False := by
    intro A B C hA hAc hB hBc hC hCc hAB hBC
    have h1 : Order.krullDim (TopologicalSpace.IrreducibleCloseds X) ≤ 1 := by
      have := hdim
      rw [Nat.cast_one] at this
      exact this
    rw [Order.krullDim_le_one_iff] at h1
    let A' : TopologicalSpace.IrreducibleCloseds X := ⟨A, hA, hAc⟩
    let B' : TopologicalSpace.IrreducibleCloseds X := ⟨B, hB, hBc⟩
    let C' : TopologicalSpace.IrreducibleCloseds X := ⟨C, hC, hCc⟩
    have hAB' : A' < B' := by
      rw [← SetLike.coe_ssubset_coe]; exact hAB
    have hBC' : B' < C' := by
      rw [← SetLike.coe_ssubset_coe]; exact hBC
    rcases h1 B' with h | h
    · exact h.not_lt hAB'
    · exact h.not_lt hBC'
  obtain ⟨S, hSfin, hScl, hSirr, hTS⟩ :=
    TopologicalSpace.NoetherianSpace.exists_finite_set_isClosed_irreducible hT
  have hs4 : ∀ t ∈ S, y ∈ t → t ⊆ {y} := by
    intro t ht hyt
    have htT : t ⊆ T := hTS ▸ Set.subset_sUnion_of_mem ht
    obtain ⟨D, hD, htD⟩ := exists_mem_irreducibleComponents_subset_of_isIrreducible t (hSirr t ht)
    have hDT := hcomp D hD (htD hyt)
    have htD' : t ⊂ D := ⟨htD, fun h => hDT (h.trans htT)⟩
    have hDcl : IsClosed D := isClosed_of_mem_irreducibleComponents D hD
    have hDirr : IsIrreducible D := hD.1
    have hcl : ∀ w ∈ t, closure {w} = t := by
      intro w hw
      by_contra hne
      have hsub : closure {w} ⊆ t := closure_minimal (Set.singleton_subset_iff.2 hw) (hScl t ht)
      exact hchain (closure {w}) t D isIrreducible_singleton.closure isClosed_closure
        (hSirr t ht) (hScl t ht) hDirr hDcl (HasSubset.Subset.ssubset_of_ne hsub hne) htD'
    intro w hw
    have h1 := hcl w hw
    have h2 := hcl y hyt
    have : Inseparable w y := by
      rw [inseparable_iff_closure_eq, h1, h2]
    exact this.eq
  let Z : Set X := ⋃ t ∈ {t ∈ S | y ∉ t}, t
  have hZ : IsClosed Z :=
    Set.Finite.isClosed_biUnion (hSfin.subset (Set.sep_subset _ _)) (fun t ht => hScl t ht.1)
  have hyZ : y ∉ Z := by
    intro h
    obtain ⟨t, ht, hyt⟩ := Set.mem_iUnion₂.1 h
    exact ht.2 hyt
  refine ⟨Zᶜ, hZ.isOpen_compl, hyZ, ?_⟩
  ext x
  constructor
  · rintro ⟨hxU, hxT⟩
    rw [hTS] at hxT
    obtain ⟨t, ht, hxt⟩ := Set.mem_sUnion.1 hxT
    by_cases hyt : y ∈ t
    · exact hs4 t ht hyt hxt
    · exact absurd (Set.mem_iUnion₂.2 ⟨t, ⟨ht, hyt⟩, hxt⟩) hxU
  · intro hx
    rw [Set.mem_singleton_iff] at hx
    subst hx
    exact ⟨hyZ, hyT⟩

theorem wcpa_dj_lus_cvs_ct_closed_isolated_spread : ∀ (X S : Scheme.{u}) (q : X ⟶ S), LocallyOfFiniteType q → ∀ F : Set X, IsClosed F → ∀ x ∈ F, (∃ U : Set X, IsOpen U ∧ x ∈ U ∧ ∀ x' ∈ U ∩ F, q x' = q x → x' = x) → ∃ U : Set X, IsOpen U ∧ x ∈ U ∧ ∀ x' ∈ U ∩ F, ∃ U' : Set X, IsOpen U' ∧ x' ∈ U' ∧ ∀ x'' ∈ U' ∩ F, q x'' = q x' → x'' = x' :=
by
  intro X S q hq F hF x hxF hiso
  haveI := hq

  have s2 : ∀ (Z : Scheme.{u}) (g : Z ⟶ S), LocallyOfFiniteType g → ∀ z : Z,
      (g.QuasiFiniteAt z ↔ ∃ V : Set Z, IsOpen V ∧ z ∈ V ∧ ∀ z' ∈ V, g z' = g z → z' = z) := by
    intro Z g hg z
    haveI := hg
    rw [Scheme.Hom.quasiFiniteAt_iff_isOpen_singleton_asFiber,
      ← (g.fiberHomeo (g z)).isOpen_image]
    simp only [Set.image_singleton, Scheme.Hom.asFiber, Homeomorph.apply_symm_apply]
    rw [isOpen_induced_iff]
    constructor
    · rintro ⟨t, ht, hpre⟩
      refine ⟨t, ht, ?_, ?_⟩
      · have : (⟨z, rfl⟩ : ↥(g ⁻¹' {g z})) ∈ Subtype.val ⁻¹' t := by
          rw [hpre]; exact Set.mem_singleton _
        exact this
      · intro z' hz' hgz
        have hmem : (⟨z', hgz⟩ : ↥(g ⁻¹' {g z})) ∈ Subtype.val ⁻¹' t := hz'
        rw [hpre] at hmem
        exact congrArg Subtype.val (Set.mem_singleton_iff.mp hmem)
    · rintro ⟨V, hV, hzV, hiso⟩
      refine ⟨V, hV, ?_⟩
      ext ⟨w, hw⟩
      simp only [Set.mem_preimage, Set.mem_singleton_iff]
      constructor
      · intro hwV
        apply Subtype.ext
        exact hiso w hwV hw
      · intro h
        have : w = z := congrArg Subtype.val h
        subst this
        exact hzV

  have s1 : ∀ {Z : Type u} [TopologicalSpace Z] (ι : Z → X), Topology.IsEmbedding ι → ∀ z : Z,
      ((∃ V : Set Z, IsOpen V ∧ z ∈ V ∧ ∀ z' ∈ V, q (ι z') = q (ι z) → z' = z) ↔
        (∃ U : Set X, IsOpen U ∧ ι z ∈ U ∧ ∀ x'' ∈ U ∩ Set.range ι, q x'' = q (ι z) → x'' = ι z)) := by
    intro Z _ ι hι z
    constructor
    · rintro ⟨V, hV, hzV, hV'⟩
      obtain ⟨U, hU, hUV⟩ := hι.isInducing.isOpen_iff.mp hV
      refine ⟨U, hU, ?_, ?_⟩
      · have : z ∈ ι ⁻¹' U := by rw [hUV]; exact hzV
        exact this
      · rintro _ ⟨hxU, ⟨z', rfl⟩⟩ hqz
        have : z' ∈ ι ⁻¹' U := hxU
        rw [hUV] at this
        rw [hV' z' this hqz]
    · rintro ⟨U, hU, hzU, hU'⟩
      refine ⟨ι ⁻¹' U, hU.preimage hι.continuous, hzU, ?_⟩
      intro z' hz' hqz
      exact hι.injective (hU' (ι z') ⟨hz', ⟨z', rfl⟩⟩ hqz)

  set Fc : TopologicalSpace.Closeds X := ⟨F, hF⟩ with hFc
  set I := Scheme.IdealSheafData.vanishingIdeal Fc with hI
  set ι := I.subschemeι with hι
  have hrange : Set.range ι = F := by
    rw [hι, Scheme.IdealSheafData.range_subschemeι, hI,
      Scheme.IdealSheafData.coe_support_vanishingIdeal]
    rfl
  have hemb : Topology.IsEmbedding ι := ι.isClosedEmbedding.isEmbedding
  set g := ι ≫ q with hg
  haveI hgl : LocallyOfFiniteType g := inferInstance
  have hgapp : ∀ w, g w = q (ι w) := fun w => Scheme.Hom.comp_apply ι q w
  obtain ⟨z, hz⟩ : x ∈ Set.range ι := by rw [hrange]; exact hxF
  have hzqf : g.QuasiFiniteAt z := by
    rw [s2 _ g hgl z]
    obtain ⟨V, hV, hzV, hV'⟩ := (s1 ι hemb z).mpr (by rw [hrange, hz]; exact hiso)
    exact ⟨V, hV, hzV, fun z' hz' h => hV' z' hz' (by rw [← hgapp, ← hgapp]; exact h)⟩
  obtain ⟨U, hU, hUW⟩ := hemb.isInducing.isOpen_iff.mp (Scheme.Hom.isOpen_quasiFiniteAt g)
  refine ⟨U, hU, ?_, ?_⟩
  · have : z ∈ ι ⁻¹' U := by rw [hUW]; exact hzqf
    rw [← hz]; exact this
  · rintro x' ⟨hx'U, hx'F⟩
    obtain ⟨z', rfl⟩ : x' ∈ Set.range ι := by rw [hrange]; exact hx'F
    have hz'W : z' ∈ ι ⁻¹' U := hx'U
    rw [hUW] at hz'W
    obtain ⟨V', hV', hz'V', hV''⟩ := (s2 _ g hgl z').mp hz'W
    obtain ⟨U', hU', hU'z, hU''⟩ := (s1 ι hemb z').mp
      ⟨V', hV', hz'V', fun w hw h => hV'' w hw (by rw [hgapp, hgapp]; exact h)⟩
    refine ⟨U', hU', hU'z, ?_⟩
    rintro x'' ⟨hx''U', hx''F⟩ hq''
    rw [← hrange] at hx''F
    exact hU'' x'' ⟨hx''U', hx''F⟩ hq''

theorem wcpa_dj_lus_cvs_ct_P1_no_open_point : ∀ (K : Type u) [Field K] [Infinite K] (x : ↥(@Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K) MvPolynomial.gradedAlgebra)), ¬ IsOpen ({x} : Set ↥(@Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K) MvPolynomial.gradedAlgebra)) :=
by
  intro K _ _ x hx
  classical
  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin 2) K) := MvPolynomial.gradedAlgebra
  let x' : ProjectiveSpectrum (MvPolynomial.homogeneousSubmodule (Fin 2) K) := x
  have hx' : IsOpen ({x'} : Set (ProjectiveSpectrum (MvPolynomial.homogeneousSubmodule (Fin 2) K))) := hx
  clear_value x'
  clear hx

  have s1 : ∀ w : Fin 2 → K, w ≠ 0 →
      ∃ y : ProjectiveSpectrum (MvPolynomial.homogeneousSubmodule (Fin 2) K),
        (∀ g ∈ y.asHomogeneousIdeal, MvPolynomial.eval w g = 0) ∧
        (∀ (g : MvPolynomial (Fin 2) K) (n : ℕ),
          g ∈ MvPolynomial.homogeneousSubmodule (Fin 2) K n →
          MvPolynomial.eval w g = 0 → g ∈ y.asHomogeneousIdeal) := by
    intro w hw
    have hI : (RingHom.ker (MvPolynomial.eval w)).IsPrime := RingHom.ker_isPrime _
    have hJ : (Ideal.homogeneousCore (MvPolynomial.homogeneousSubmodule (Fin 2) K)
        (RingHom.ker (MvPolynomial.eval w))).toIdeal.IsPrime := hI.homogeneousCore
    obtain ⟨i, hi⟩ : ∃ i, w i ≠ 0 := by
      by_contra h
      push_neg at h
      exact hw (funext h)
    have hrel : ¬ HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin 2) K) ≤
        Ideal.homogeneousCore (MvPolynomial.homogeneousSubmodule (Fin 2) K)
          (RingHom.ker (MvPolynomial.eval w)) := by
      intro hle
      have hXi : (MvPolynomial.X i : MvPolynomial (Fin 2) K) ∈
          HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin 2) K) := by
        rw [HomogeneousIdeal.mem_irrelevant_iff, GradedRing.proj_apply]
        exact DirectSum.decompose_of_mem_ne _
          ((MvPolynomial.mem_homogeneousSubmodule _ _).mpr (MvPolynomial.isHomogeneous_X K i))
          one_ne_zero
      have h2 := Ideal.toIdeal_homogeneousCore_le (MvPolynomial.homogeneousSubmodule (Fin 2) K)
        (RingHom.ker (MvPolynomial.eval w)) (hle hXi)
      rw [RingHom.mem_ker, MvPolynomial.eval_X] at h2
      exact hi h2
    refine ⟨⟨_, hJ, hrel⟩, ?_, ?_⟩
    · intro g hg
      exact Ideal.toIdeal_homogeneousCore_le (MvPolynomial.homogeneousSubmodule (Fin 2) K)
        (RingHom.ker (MvPolynomial.eval w)) hg
    · intro g n hgn hev
      exact Ideal.mem_homogeneousCore_of_homogeneous_of_mem ⟨n, hgn⟩ hev
  choose P hPa hPb using s1

  obtain ⟨s, hs⟩ := (ProjectiveSpectrum.isOpen_iff _ _).mp hx'
  have hxs : ¬ s ⊆ x'.asHomogeneousIdeal := by
    intro h
    have h1 : x' ∈ ProjectiveSpectrum.zeroLocus (MvPolynomial.homogeneousSubmodule (Fin 2) K) s :=
      (ProjectiveSpectrum.mem_zeroLocus _ _ _).mpr h
    rw [← hs] at h1
    exact h1 rfl
  obtain ⟨f, hfs, hfx⟩ := Set.not_subset.mp hxs
  have hfy : ∀ y : ProjectiveSpectrum (MvPolynomial.homogeneousSubmodule (Fin 2) K),
      y ≠ x' → f ∈ y.asHomogeneousIdeal := by
    intro y hy
    have h1 : y ∈ ({x'} : Set _)ᶜ := hy
    rw [hs] at h1
    exact (ProjectiveSpectrum.mem_zeroLocus _ _ _).mp h1 hfs

  have finish : ∀ ℓ : MvPolynomial (Fin 2) K, ℓ ≠ 0 →
      (∀ w, MvPolynomial.eval w f * MvPolynomial.eval w ℓ = 0) → False := by
    intro ℓ hℓ H
    have h1 : f * ℓ = 0 := MvPolynomial.funext (fun w => by simpa using H w)
    rcases mul_eq_zero.mp h1 with h | h
    · exact hfx (h ▸ x'.asHomogeneousIdeal.toIdeal.zero_mem)
    · exact hℓ h
  by_cases hA : ∃ (u : Fin 2 → K) (hu : u ≠ 0), P u hu = x'
  · obtain ⟨u, hu, hPu⟩ := hA
    set ℓ : MvPolynomial (Fin 2) K :=
      MvPolynomial.C (u 1) * MvPolynomial.X 0 - MvPolynomial.C (u 0) * MvPolynomial.X 1 with hℓdef
    have hev : ∀ w : Fin 2 → K, MvPolynomial.eval w ℓ = u 1 * w 0 - u 0 * w 1 := by
      intro w
      simp [hℓdef]
    have hℓhom : ℓ ∈ MvPolynomial.homogeneousSubmodule (Fin 2) K 1 := by
      rw [MvPolynomial.mem_homogeneousSubmodule]
      exact ((MvPolynomial.isHomogeneous_X K 0).C_mul _).sub
        ((MvPolynomial.isHomogeneous_X K 1).C_mul _)
    have hℓne : ℓ ≠ 0 := by
      intro h0
      have e1 := hev ![1, 0]
      have e2 := hev ![0, 1]
      rw [h0, map_zero] at e1 e2
      simp at e1 e2
      apply hu
      funext j
      fin_cases j
      · simpa using e2
      · simpa using e1.symm
    have hℓx : ℓ ∈ x'.asHomogeneousIdeal := by
      rw [← hPu]
      exact hPb u hu ℓ 1 hℓhom (by rw [hev]; ring)
    apply finish ℓ hℓne
    intro w
    by_cases hw : w = 0
    · subst hw
      rw [hev]
      simp
    · by_cases hPw : P w hw = x'
      · rw [hPa w hw ℓ (hPw ▸ hℓx), mul_zero]
      · rw [hPa w hw f (hfy _ hPw), zero_mul]
  · push_neg at hA
    apply finish (MvPolynomial.X 0)
    · intro h0
      have := congrArg (MvPolynomial.eval ![(1 : K), 0]) h0
      simp at this
    · intro w
      by_cases hw : w = 0
      · subst hw
        simp
      · rw [hPa w hw f (hfy _ (hA w hw)), zero_mul]

theorem wcpa_dj_lsp_generic_smooth : ∀ (K : Type u) [Field K] [IsAlgClosed K] (C : Scheme.{u}) (q : C ⟶ Spec (.of K)), wcpaDjSemistable q → ∀ ξ : C, closure {ξ} ∈ irreducibleComponents C → ¬ IsClosed ({ξ} : Set C) ∧ ∃ U : C.Opens, ξ ∈ U ∧ SmoothOfRelativeDimension 1 (U.ι ≫ q) :=
by
  intro K _ _ C q hss ξ hξ
  classical
  haveI : IsProper q := hss.2.1
  haveI : IsLocallyNoetherian C := LocallyOfFiniteType.isLocallyNoetherian q

  have hgen : ∀ y : C, y ⤳ ξ → y = ξ := by
    intro y hy
    have h1 : closure {ξ} ⊆ closure ({y} : Set C) := specializes_iff_closure_subset.mp hy
    rw [irreducibleComponents_eq_maximals_closed] at hξ
    have hξ' : Maximal (fun x : Set C => IsClosed x ∧ IsIrreducible x) (closure {ξ}) := hξ
    have h2 : closure {ξ} = closure ({y} : Set C) :=
      Maximal.eq_of_le hξ' ⟨isClosed_closure, isIrreducible_singleton.closure⟩ h1
    exact (inseparable_iff_closure_eq.mpr h2.symm).eq

  have hpt : ∀ p : PrimeSpectrum (C.presheaf.stalk ξ), p = IsLocalRing.closedPoint _ := by
    intro p
    apply (C.fromSpecStalk ξ).isEmbedding.injective
    rw [Scheme.fromSpecStalk_closedPoint]
    apply hgen
    have := (IsLocalRing.specializes_closedPoint p).map (C.fromSpecStalk ξ).continuous
    rwa [Scheme.fromSpecStalk_closedPoint] at this
  have hnil : ∀ a ∈ IsLocalRing.maximalIdeal (C.presheaf.stalk ξ), IsNilpotent a := by
    intro a ha
    rw [nilpotent_iff_mem_prime]
    intro J hJ
    have hJ' : J = IsLocalRing.maximalIdeal (C.presheaf.stalk ξ) :=
      congrArg PrimeSpectrum.asIdeal (hpt ⟨J, hJ⟩)
    rw [hJ']
    exact ha
  have hdim0 : ringKrullDim (C.presheaf.stalk ξ) = 0 := by
    haveI : Unique (PrimeSpectrum (C.presheaf.stalk ξ)) := ⟨⟨IsLocalRing.closedPoint _⟩, hpt⟩
    exact Order.krullDim_eq_zero_of_unique

  have hsurj : Function.Surjective (algebraMap (C.presheaf.stalk ξ)
      (AdicCompletion (IsLocalRing.maximalIdeal (C.presheaf.stalk ξ)) (C.presheaf.stalk ξ))) := by
    obtain ⟨N, hN⟩ := IsNoetherianRing.isNilpotent_nilradical (C.presheaf.stalk ξ)
    have hle : IsLocalRing.maximalIdeal (C.presheaf.stalk ξ) ≤ nilradical _ :=
      fun a ha => mem_nilradical.mpr (hnil a ha)
    have hmN : IsLocalRing.maximalIdeal (C.presheaf.stalk ξ) ^ N = ⊥ := by
      apply le_bot_iff.mp
      calc IsLocalRing.maximalIdeal (C.presheaf.stalk ξ) ^ N
          ≤ nilradical (C.presheaf.stalk ξ) ^ N := Ideal.pow_right_mono hle N
        _ = ⊥ := by rw [hN]; rfl
    have hpre : IsPrecomplete (IsLocalRing.maximalIdeal (C.presheaf.stalk ξ))
        (C.presheaf.stalk ξ) := by
      refine IsPrecomplete.mk ?_
      intro f hf
      refine ⟨f N, fun n => ?_⟩
      rcases le_total n N with h | h
      · exact hf h
      · have h1 := hf h
        rw [hmN, Submodule.bot_smul, SModEq.bot] at h1
        exact SModEq.mono bot_le (SModEq.bot.mpr h1.symm)
    have hof := AdicCompletion.of_surjective_iff.mpr hpre
    intro x
    obtain ⟨a, ha⟩ := hof x
    refine ⟨a, ?_⟩
    rw [AdicCompletion.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply]
    exact ha

  have hX0 : ¬ IsNilpotent (Ideal.Quotient.mk (Ideal.span {(MvPowerSeries.X 0 * MvPowerSeries.X 1 :
      MvPowerSeries (Fin 2) K)}) (MvPowerSeries.X 0 : MvPowerSeries (Fin 2) K)) := by
    rintro ⟨n, hn⟩
    rw [← map_pow, Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton'] at hn
    obtain ⟨G, hG⟩ := hn
    have hXX : (MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin 2) K) =
        MvPowerSeries.monomial (Finsupp.single 0 1 + Finsupp.single 1 1) 1 := by
      rw [MvPowerSeries.X_def, MvPowerSeries.X_def, MvPowerSeries.monomial_mul_monomial, mul_one]
    have hc := congrArg (MvPowerSeries.coeff (Finsupp.single (0 : Fin 2) n)) hG
    rw [hXX, MvPowerSeries.coeff_mul_monomial, MvPowerSeries.X_pow_eq,
      MvPowerSeries.coeff_monomial_same] at hc
    rw [if_neg] at hc
    · exact zero_ne_one hc
    · intro hle
      have h1 := (Finsupp.le_def.1 hle) 1
      simp [Finsupp.single_apply] at h1
  have hX0u : ¬ IsUnit (Ideal.Quotient.mk (Ideal.span {(MvPowerSeries.X 0 * MvPowerSeries.X 1 :
      MvPowerSeries (Fin 2) K)}) (MvPowerSeries.X 0 : MvPowerSeries (Fin 2) K)) := by
    intro hu
    have hker : ∀ a ∈ Ideal.span {(MvPowerSeries.X 0 * MvPowerSeries.X 1 :
        MvPowerSeries (Fin 2) K)}, MvPowerSeries.constantCoeff (σ := Fin 2) (R := K) a = 0 := by
      intro a ha
      obtain ⟨G, rfl⟩ := Ideal.mem_span_singleton'.mp ha
      simp [MvPowerSeries.constantCoeff_X]
    have h1 := hu.map (Ideal.Quotient.lift _ (MvPowerSeries.constantCoeff (σ := Fin 2) (R := K)) hker)
    rw [Ideal.Quotient.lift_mk, MvPowerSeries.constantCoeff_X] at h1
    exact not_isUnit_zero h1

  have hΦ : (asIso (Limits.pullback.fst q (𝟙 (Spec (.of K))))).symm.hom ≫
      Limits.pullback.snd q (𝟙 (Spec (.of K))) = q := by
    simp only [Iso.symm_hom, asIso_inv]
    rw [IsIso.inv_comp_eq, Limits.pullback.condition, Category.comp_id]
  have hdich := wcpa_dj_ssp_bw_ns_transport K (asIso (Limits.pullback.fst q (𝟙 (Spec (.of K))))).symm
    q (Limits.pullback.snd q (𝟙 (Spec (.of K)))) hΦ ξ (hss.2.2 K (𝟙 _) _)
  rcases hdich with ⟨U, hξU, hU⟩ | ⟨e, -⟩
  · refine ⟨fun hcl => ?_, U, hξU, hU⟩
    have hpre : (U.ι : U.toScheme ⟶ C) ⁻¹' {ξ} = {(⟨ξ, hξU⟩ : U)} := by
      ext x
      simp only [Set.mem_preimage, Set.mem_singleton_iff]
      constructor
      · intro h
        apply Subtype.ext
        exact h
      · intro h
        subst h
        simp
    have hcl' : IsClosed ({(⟨ξ, hξU⟩ : U)} : Set U.toScheme) := by
      rw [← hpre]
      exact hcl.preimage U.ι.continuous
    haveI : SmoothOfRelativeDimension 1 (U.ι ≫ q) := hU
    have h1 := wc_lfi_smooth_stalk_dim K U.toScheme (U.ι ≫ q) 1 ⟨ξ, hξU⟩ hcl'
    have h2 := ringKrullDim_eq_of_ringEquiv (U.stalkIso ⟨ξ, hξU⟩).commRingCatIsoToRingEquiv
    have h3 : (0 : WithBot ℕ∞) = ((1 : ℕ) : WithBot ℕ∞) := hdim0.symm.trans (h2.symm.trans h1)
    norm_num at h3
  · exfalso
    let Ψ := e.toRingHom.comp (algebraMap (C.presheaf.stalk ξ)
      (AdicCompletion (IsLocalRing.maximalIdeal (C.presheaf.stalk ξ)) (C.presheaf.stalk ξ)))
    have hΨ : Function.Surjective Ψ := e.surjective.comp hsurj
    obtain ⟨a, ha⟩ := hΨ (Ideal.Quotient.mk _ (MvPowerSeries.X 0))
    by_cases ham : a ∈ IsLocalRing.maximalIdeal (C.presheaf.stalk ξ)
    · exact hX0 (ha ▸ (hnil a ham).map Ψ)
    · have hau : IsUnit a := by
        rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, not_not] at ham
        exact ham
      exact hX0u (ha ▸ hau.map Ψ)

theorem wcpa_dj_cdp_residue_ff1 (K : Type u) [Field K] [IsAlgClosed K] (C : Scheme.{u})
    (q : C ⟶ Spec (.of K)) (hss : wcpaDjSemistable q) (ξ : C)
    (hξ : closure {ξ} ∈ irreducibleComponents C)
    [Algebra K (C.residueField ξ)] (hA : algebraMap K (C.residueField ξ) = wcpaDjFK K q ξ) :
    wcpaDjFF1 K (C.residueField ξ) :=
by
  classical
  obtain ⟨-, W, hξW, hWsm⟩ := wcpa_dj_lsp_generic_smooth K C q hss ξ hξ
  haveI : IsProper q := hss.2.1
  haveI := hWsm

  haveI : IsLocallyNoetherian C := LocallyOfFiniteType.isLocallyNoetherian q
  haveI : CompactSpace C := QuasiCompact.compactSpace_of_compactSpace q
  haveI : AlgebraicGeometry.IsNoetherian C := {}
  have hfinS : (irreducibleComponents C).Finite :=
    TopologicalSpace.NoetherianSpace.finite_irreducibleComponents

  set E : Set C := closure {ξ} with hEdef
  set U₀ : Set C := (⋃ E' ∈ irreducibleComponents C \ {E}, E')ᶜ with hU₀def
  have hU₀open : IsOpen U₀ := by
    refine isOpen_compl_iff.mpr ?_
    exact (hfinS.diff).isClosed_biUnion
      (fun E' hE' => isClosed_of_mem_irreducibleComponents E' hE'.1)
  have hξU₀ : ξ ∈ U₀ := by
    rw [hU₀def, Set.mem_compl_iff, Set.mem_iUnion₂]
    rintro ⟨E', ⟨hE'S, hE'ne⟩, hξE'⟩
    have hsub : E ⊆ E' := closure_minimal (Set.singleton_subset_iff.mpr hξE')
      (isClosed_of_mem_irreducibleComponents E' hE'S)
    exact hE'ne (hξ.eq_of_subset hE'S.prop hsub).symm
  have hU₀E : U₀ ⊆ E := by
    intro x hx
    by_contra hxE
    rw [hU₀def, Set.mem_compl_iff, Set.mem_iUnion₂] at hx
    apply hx
    refine ⟨irreducibleComponent x, ⟨irreducibleComponent_mem_irreducibleComponents x, ?_⟩,
      mem_irreducibleComponent⟩
    intro h
    rw [Set.mem_singleton_iff] at h
    exact hxE (h ▸ mem_irreducibleComponent)

  set U : C.Opens := W ⊓ ⟨U₀, hU₀open⟩ with hUdef
  have hUW : U ≤ W := inf_le_left
  have hξU : ξ ∈ U := ⟨hξW, hξU₀⟩
  have hUE : (U : Set C) ⊆ E := fun x hx => hU₀E hx.2
  haveI hUsm : SmoothOfRelativeDimension 1 (U.ι ≫ q) := by
    have h := smoothOfRelativeDimension_comp 0 1 (C.homOfLE hUW) (W.ι ≫ q)
    rw [← Category.assoc, Scheme.homOfLE_ι] at h
    exact h
  have hEirr : IsIrreducible E := isIrreducible_singleton.closure
  have hUirr : IsIrreducible (U : Set C) :=
    ⟨⟨ξ, hξU⟩, hEirr.isPreirreducible.open_subset U.isOpen hUE⟩
  haveI : IrreducibleSpace U.toScheme := isIrreducible_iff_irreducibleSpace.mp hUirr

  have hdimle : topologicalKrullDim ↥(closure ({ξ} : Set C)) ≤ ((1 : ℕ) : WithBot ℕ∞) := by
    have h1 := wc_dim_le_dim_dense_open_part K C q E (U : Set C) isClosed_closure U.isOpen
      (closure_mono (Set.singleton_subset_iff.mpr ⟨subset_closure rfl, hξU⟩))
    have h2 : topologicalKrullDim ↥(E ∩ (U : Set C)) ≤ topologicalKrullDim ↥(U : Set C) :=
      (Topology.IsEmbedding.inclusion Set.inter_subset_right).isInducing.topologicalKrullDim_le
    have h3 : topologicalKrullDim U.toScheme ≤ ((1 : ℕ) : WithBot ℕ∞) :=
      wc_smooth_alg_closed_dim_le K U.toScheme (U.ι ≫ q) 1
    exact h1.trans (h2.trans h3)
  have hdimge : ((1 : ℕ) : WithBot ℕ∞) ≤ topologicalKrullDim ↥(closure ({ξ} : Set C)) := by
    have h1 : ((1 : ℕ) : WithBot ℕ∞) ≤ topologicalKrullDim U.toScheme :=
      wc_smooth_irreducible_dim_ge K U.toScheme (U.ι ≫ q) 1
    have h2 : topologicalKrullDim ↥(U : Set C) ≤ topologicalKrullDim ↥E :=
      (Topology.IsEmbedding.inclusion hUE).isInducing.topologicalKrullDim_le
    exact h1.trans h2

  have hpre : (Spec.preimage (C.fromSpecResidueField ξ ≫ q)).hom = wcpaDjFK K q ξ := by
    have h1 : C.fromSpecResidueField ξ ≫ q ≫ (Spec (.of K)).toSpecΓ =
        Spec.map (q.appTop ≫ C.presheaf.germ ⊤ ξ trivial ≫ C.residue ξ) := by
      rw [Scheme.toSpecΓ_naturality, Scheme.fromSpecResidueField, Category.assoc,
        ← Category.assoc (C.fromSpecStalk ξ), Scheme.fromSpecStalk_toSpecΓ]
      simp only [Spec.map_comp, Category.assoc]
    have h2 : (Spec (.of K)).toSpecΓ = Spec.map (Scheme.ΓSpecIso (.of K)).hom :=
      Scheme.isoSpec_Spec_hom _
    have h3 : (Spec (.of K)).toSpecΓ ≫ Spec.map (Scheme.ΓSpecIso (.of K)).inv = 𝟙 _ := by
      rw [h2, ← Spec.map_comp, Iso.inv_hom_id, Spec.map_id]
    have key : C.fromSpecResidueField ξ ≫ q = Spec.map ((Scheme.ΓSpecIso (.of K)).inv ≫ q.appTop ≫
        C.presheaf.germ ⊤ ξ trivial ≫ C.residue ξ) := by
      have e : C.fromSpecResidueField ξ ≫ q =
          (C.fromSpecResidueField ξ ≫ q ≫ (Spec (.of K)).toSpecΓ) ≫
          Spec.map (Scheme.ΓSpecIso (.of K)).inv := by
        rw [Category.assoc, Category.assoc, h3, Category.comp_id]
      rw [e, h1]
      exact (Spec.map_comp _ _).symm
    rw [key, Spec.preimage_map]
    rfl
  have hinst : ‹Algebra K (C.residueField ξ)› =
      (Spec.preimage (C.fromSpecResidueField ξ ≫ q)).hom.toAlgebra :=
    Algebra.algebra_ext _ _ (fun r => by rw [hA, ← hpre]; rfl)
  subst hinst
  letI : Algebra K (C.residueField ξ) := (Spec.preimage (C.fromSpecResidueField ξ ≫ q)).hom.toAlgebra

  have hfg : ∃ S : Finset (C.residueField ξ),
      IntermediateField.adjoin K (S : Set (C.residueField ξ)) = ⊤ := by
    obtain ⟨V, hV, hξV, -⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp C.isBasis_affineOpens)
      (show ξ ∈ (⊤ : C.Opens) from trivial)
    have eV : V ≤ q ⁻¹ᵁ (⊤ : (Spec (.of K)).Opens) := fun x _ => trivial
    have hft : RingHom.FiniteType (q.appLE ⊤ V eV).hom :=
      HasRingHomProperty.appLE (P := @LocallyOfFiniteType) q inferInstance
        ⟨⊤, isAffineOpen_top _⟩ ⟨V, hV⟩ eV
    have hiso : RingHom.FiniteType (Scheme.ΓSpecIso (.of K)).inv.hom :=
      RingHom.FiniteType.of_surjective _ (fun y => ⟨(Scheme.ΓSpecIso (.of K)).hom y,
        Iso.hom_inv_id_apply _ _⟩)
    set ψ0 : K →+* Γ(C, V) := ((Scheme.ΓSpecIso (.of K)).inv ≫ q.appLE ⊤ V eV).hom with hψ0
    have hψft : ψ0.FiniteType := hft.comp hiso
    set ρ : Γ(C, V) →+* C.residueField ξ := (C.presheaf.germ V ξ hξV ≫ C.residue ξ).hom with hρ
    have hcompat : ∀ c : K, ρ (ψ0 c) = algebraMap K (C.residueField ξ) c := by
      intro c
      rw [hA]
      unfold wcpaDjFK
      rw [← TopCat.Presheaf.germ_res C.presheaf (homOfLE (le_top : V ≤ ⊤)) ξ hξV]
      rfl
    letI : Algebra K Γ(C, V) := ψ0.toAlgebra
    obtain ⟨s, hs⟩ := hψft.out
    refine ⟨s.image ρ, ?_⟩
    set F' := IntermediateField.adjoin K ((s.image ρ : Finset _) : Set (C.residueField ξ)) with hF'
    let ρa : Γ(C, V) →ₐ[K] C.residueField ξ :=
      { ρ with commutes' := fun c => hcompat c }
    have hρF' : ∀ b : Γ(C, V), ρ b ∈ F' := by
      have hle : Algebra.adjoin K (s : Set Γ(C, V)) ≤ F'.toSubalgebra.comap ρa := by
        rw [Algebra.adjoin_le_iff]
        intro b hb
        show ρ b ∈ F'
        apply IntermediateField.subset_adjoin
        rw [Finset.coe_image]
        exact Set.mem_image_of_mem _ hb
      intro b
      have hb : b ∈ Algebra.adjoin K (s : Set Γ(C, V)) := by rw [hs]; trivial
      exact hle hb
    letI : Algebra Γ(C, V) (C.presheaf.stalk ξ) :=
      TopCat.Presheaf.algebra_section_stalk C.presheaf ⟨ξ, hξV⟩
    haveI := hV.isLocalization_stalk ⟨ξ, hξV⟩
    rw [eq_top_iff]
    intro z _
    obtain ⟨y, rfl⟩ := C.residue_surjective ξ z
    obtain ⟨⟨b, t⟩, hy⟩ := IsLocalization.mk'_surjective
      (hV.primeIdealOf ⟨ξ, hξV⟩).asIdeal.primeCompl y
    simp only at hy
    have hspec := IsLocalization.mk'_spec (C.presheaf.stalk ξ) b t
    rw [hy] at hspec
    have hunit := IsLocalization.map_units (C.presheaf.stalk ξ) t
    have e1 : (C.residue ξ).hom y * ρ t = ρ b := by
      have := congrArg (C.residue ξ).hom hspec
      rw [map_mul] at this
      exact this
    have hne : ρ t ≠ 0 := (hunit.map (C.residue ξ).hom).ne_zero
    have e2 : (C.residue ξ).hom y = ρ b * (ρ t)⁻¹ := by
      rw [← e1, mul_assoc, mul_inv_cancel₀ hne, mul_one]
    rw [e2]
    exact F'.mul_mem (hρF' b) (F'.inv_mem (hρF' t))

  obtain ⟨g, hg⟩ := wc_lft_point_closure_algIndep K C q ξ 1 hdimge
  have hnotalg : ¬ Algebra.IsAlgebraic K (C.residueField ξ) :=
    fun h => hg.transcendental 0 (h.isAlgebraic (g 0))
  obtain ⟨n, t, hn, halg⟩ := wc_lft_residue_algebraic_over_poly K C q ξ 1 hdimle
  have hex : ∃ i, Transcendental K (t i) := by
    by_contra hcon
    push_neg at hcon
    apply hnotalg
    have hint : ∀ x ∈ Set.range t, IsIntegral K x := by
      rintro x ⟨i, rfl⟩
      exact (not_not.mp (hcon i)).isIntegral
    haveI := IntermediateField.isAlgebraic_adjoin hint
    exact Algebra.IsAlgebraic.trans K (IntermediateField.adjoin K (Set.range t)) _
  obtain ⟨i, hti⟩ := hex
  have hrange : Set.range t = {t i} := by
    ext y
    constructor
    · rintro ⟨j, rfl⟩
      have : j = i := Fin.ext (by have := j.isLt; have := i.isLt; omega)
      rw [this]; rfl
    · intro hy
      rw [Set.mem_singleton_iff] at hy
      exact ⟨i, hy.symm⟩
  rw [hrange] at halg
  obtain ⟨S, hS⟩ := hfg
  refine ⟨t i, hti, ?_⟩
  set L := IntermediateField.adjoin K ({t i} : Set (C.residueField ξ)) with hL
  have hLS : IntermediateField.adjoin L (S : Set (C.residueField ξ)) = ⊤ := by
    rw [eq_top_iff]
    intro x _
    have hx : x ∈ IntermediateField.adjoin K (S : Set (C.residueField ξ)) := by rw [hS]; trivial
    have hle : IntermediateField.adjoin K (S : Set (C.residueField ξ)) ≤
        (IntermediateField.adjoin L (S : Set (C.residueField ξ))).restrictScalars K := by
      rw [IntermediateField.adjoin_le_iff]
      intro y hy
      exact IntermediateField.subset_adjoin L _ hy
    exact hle hx
  have hfd : FiniteDimensional L (IntermediateField.adjoin L (S : Set (C.residueField ξ))) :=
    IntermediateField.finiteDimensional_adjoin
      (fun x _ => (halg.isAlgebraic x).isIntegral)
  rw [hLS] at hfd
  exact LinearEquiv.finiteDimensional (IntermediateField.topEquiv (F := L)).toLinearEquiv

theorem cp1rr_proj_generic_rational : ∀ (K : Type u) [Field K] (p : ↥(@Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K) MvPolynomial.gradedAlgebra)), (∀ w : ↥(@Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K) MvPolynomial.gradedAlgebra), p ⤳ w) → ∀ [Algebra K ((@Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K) MvPolynomial.gradedAlgebra).residueField p)], algebraMap K ((@Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K) MvPolynomial.gradedAlgebra).residueField p) = wcpaDjFK K (@Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K) MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin 2) K 0)))) p → ∃ t : (@Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K) MvPolynomial.gradedAlgebra).residueField p, Transcendental K t ∧ IntermediateField.adjoin K {t} = ⊤ :=
by
  intro K _ p hgen _ hA
  classical
  obtain ⟨strP, hstrP⟩ : ∃ s : (@Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
      MvPolynomial.gradedAlgebra) ⟶ Spec (.of K),
      s = @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
        MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
          (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin 2) K 0))) := ⟨_, rfl⟩
  rw [← hstrP] at hA
  obtain ⟨e, he⟩ := wc_projK_one_affine_chart K 0
  obtain ⟨h, hh⟩ : ∃ h : Spec (.of (Polynomial K)) ⟶ (@Proj _ _ _ _ _
      (MvPolynomial.homogeneousSubmodule (Fin 2) K) MvPolynomial.gradedAlgebra),
      h = e.inv ≫ (@Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K)
        MvPolynomial.gradedAlgebra (MvPolynomial.X 0)).ι := ⟨_, rfl⟩
  haveI : IsOpenImmersion h := by rw [hh]; infer_instance

  have hstr : h ≫ strP = Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))) := by
    have h1 : e.inv ≫ e.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))) =
        Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))) := e.inv_hom_id_assoc _
    rw [he] at h1
    rw [hh, hstrP, Category.assoc]
    exact h1

  have hrange : IsOpen (Set.range h) := h.isOpenEmbedding.isOpen_range
  let η : Spec (.of (Polynomial K)) := (⟨⊥, Ideal.isPrime_bot⟩ : PrimeSpectrum (Polynomial K))
  have hpη := hgen (h η)
  obtain ⟨x, rfl⟩ : p ∈ Set.range h := hpη.mem_open hrange ⟨η, rfl⟩
  have hsp : x ⤳ η := h.isOpenEmbedding.isInducing.specializes_iff.mp hpη
  have hle : x.asIdeal ≤ (⊥ : Ideal (Polynomial K)) := (PrimeSpectrum.le_iff_specializes x η).mpr hsp
  have hx0 : x.asIdeal = ⊥ := le_bot_iff.mp hle

  obtain ⟨ev, hev⟩ : ∃ ev : Polynomial K →+* (Spec (.of (Polynomial K))).residueField x,
      ev = ((Scheme.ΓSpecIso (.of (Polynomial K))).inv ≫
        (Spec (.of (Polynomial K))).presheaf.germ ⊤ x trivial ≫
          (Spec (.of (Polynomial K))).residue x).hom := ⟨_, rfl⟩

  have hinj : Function.Injective ev := by
    rw [injective_iff_map_eq_zero]
    intro a ha
    rw [hev] at ha
    have h1 : (ConcreteCategory.hom ((Spec (.of (Polynomial K))).evaluation ⊤ x trivial))
        ((ConcreteCategory.hom (Scheme.ΓSpecIso (.of (Polynomial K))).inv) a) = 0 := ha
    have h2 := ((Spec (.of (Polynomial K))).evaluation_eq_zero_iff_notMem_basicOpen x
      (U := ⊤) trivial ((ConcreteCategory.hom (Scheme.ΓSpecIso (.of (Polynomial K))).inv) a)).mp h1
    rw [basicOpen_eq_of_affine] at h2
    have h3 : a ∈ x.asIdeal := by
      by_contra hc
      exact h2 ((PrimeSpectrum.mem_basicOpen a x).mpr hc)
    rw [hx0] at h3
    exact (Ideal.mem_bot).mp h3

  have hinvhom : ∀ a : Γ(Spec (.of (Polynomial K)), ⊤),
      (Scheme.ΓSpecIso (.of (Polynomial K))).inv.hom
        ((Scheme.ΓSpecIso (.of (Polynomial K))).hom.hom a) = a := fun a =>
    congrArg (fun f => CommRingCat.Hom.hom f a) (Scheme.ΓSpecIso (.of (Polynomial K))).hom_inv_id
  have hev2 : ∀ a : Γ(Spec (.of (Polynomial K)), ⊤),
      ev ((Scheme.ΓSpecIso (.of (Polynomial K))).hom.hom a) =
        ((Spec (.of (Polynomial K))).residue x).hom
          (((Spec (.of (Polynomial K))).presheaf.germ ⊤ x trivial).hom a) := by
    intro a
    rw [hev]
    change ((Spec (.of (Polynomial K))).residue x).hom
        (((Spec (.of (Polynomial K))).presheaf.germ ⊤ x trivial).hom
          ((Scheme.ΓSpecIso (.of (Polynomial K))).inv.hom
            ((Scheme.ΓSpecIso (.of (Polynomial K))).hom.hom a))) = _
    rw [hinvhom]
  have hfrac : ∀ z : (Spec (.of (Polynomial K))).residueField x,
      ∃ a b : Polynomial K, ev b ≠ 0 ∧ z * ev b = ev a := by
    intro z
    obtain ⟨s, rfl⟩ := Scheme.residue_surjective _ x z
    have hU := isAffineOpen_top (Spec (.of (Polynomial K)))
    letI : Algebra Γ(Spec (.of (Polynomial K)), ⊤) ((Spec (.of (Polynomial K))).presheaf.stalk x) :=
      ((Spec (.of (Polynomial K))).presheaf.germ ⊤ x trivial).hom.toAlgebra
    haveI hloc : IsLocalization.AtPrime ((Spec (.of (Polynomial K))).presheaf.stalk x)
        (hU.primeIdealOf ⟨x, trivial⟩).asIdeal := hU.isLocalization_stalk ⟨x, trivial⟩
    obtain ⟨⟨a', m⟩, hs⟩ := IsLocalization.mk'_surjective
      (hU.primeIdealOf ⟨x, trivial⟩).asIdeal.primeCompl s
    simp only at hs
    have hspec := IsLocalization.mk'_spec ((Spec (.of (Polynomial K))).presheaf.stalk x) a' m
    have hunit := IsLocalization.map_units ((Spec (.of (Polynomial K))).presheaf.stalk x) m
    rw [hs] at hspec
    refine ⟨(Scheme.ΓSpecIso (.of (Polynomial K))).hom.hom a',
      (Scheme.ΓSpecIso (.of (Polynomial K))).hom.hom (m : Γ(Spec (.of (Polynomial K)), ⊤)), ?_, ?_⟩
    · rw [hev2]
      exact (hunit.map ((Spec (.of (Polynomial K))).residue x).hom).ne_zero
    · rw [hev2, hev2]
      have h2 := congrArg ((Spec (.of (Polynomial K))).residue x).hom hspec
      rw [map_mul] at h2
      exact h2

  have hC : ∀ c : K, wcpaDjFK K (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) x c =
      ev (Polynomial.C c) := by
    intro c
    have h1 := Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom (algebraMap K (Polynomial K)))
    have h2 := congrArg (fun g => (g ≫ (Spec (.of (Polynomial K))).presheaf.germ ⊤ x trivial ≫
      (Spec (.of (Polynomial K))).residue x).hom c) h1
    simp only [Category.assoc] at h2
    rw [hev, ← Polynomial.algebraMap_eq]
    unfold wcpaDjFK
    exact h2.symm

  have hcompat : ∀ c : K, (h.residueFieldMap x).hom (wcpaDjFK K strP (h x) c) =
      wcpaDjFK K (h ≫ strP) x c := by
    intro c
    unfold wcpaDjFK
    rw [Scheme.Hom.comp_appTop]
    have e1 := Scheme.residue_residueFieldMap h x
    have e2 := Scheme.Hom.germ_stalkMap h ⊤ x trivial
    change ((Scheme.ΓSpecIso (.of K)).inv ≫ strP.appTop ≫
      (@Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
        MvPolynomial.gradedAlgebra).presheaf.germ ⊤ (h x) trivial ≫
      (@Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
        MvPolynomial.gradedAlgebra).residue (h x) ≫ h.residueFieldMap x).hom c = _
    rw [e1, ← Category.assoc ((@Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
        MvPolynomial.gradedAlgebra).presheaf.germ ⊤ (h x) trivial), e2]
    simp only [Category.assoc]
    rfl

  let φ := RingEquiv.ofBijective (h.residueFieldMap x).hom
    (ConcreteCategory.bijective_of_isIso (h.residueFieldMap x))
  have hφ : ∀ y, φ y = (h.residueFieldMap x).hom y := fun y => rfl
  obtain ⟨ψ, hψ⟩ : ∃ ψ : Polynomial K →+* (@Proj _ _ _ _ _
      (MvPolynomial.homogeneousSubmodule (Fin 2) K) MvPolynomial.gradedAlgebra).residueField (h x),
      ∀ q, ψ q = φ.symm (ev q) := ⟨(φ.symm : _ →+* _).comp ev, fun q => rfl⟩
  have hψC : ∀ c : K, ψ (Polynomial.C c) = algebraMap K _ c := by
    intro c
    rw [hψ, φ.symm_apply_eq, hA, hφ, hcompat, hstr, hC]
  have hψinj : Function.Injective ψ := by
    intro a b hab
    rw [hψ, hψ] at hab
    exact hinj (φ.symm.injective hab)
  have hfracψ : ∀ z, ∃ a b : Polynomial K, ψ b ≠ 0 ∧ z * ψ b = ψ a := by
    intro z
    obtain ⟨a, b, hb, hab⟩ := hfrac (φ z)
    refine ⟨a, b, ?_, ?_⟩
    · rw [hψ]
      intro h0
      exact hb (φ.symm.injective (h0.trans (map_zero _).symm))
    · rw [hψ, hψ, ← hab, map_mul, RingEquiv.symm_apply_apply]

  have haeval : ∀ q : Polynomial K, Polynomial.aeval (ψ Polynomial.X) q = ψ q := by
    have : (Polynomial.aeval (ψ Polynomial.X)).toRingHom = ψ := by
      apply Polynomial.ringHom_ext
      · intro c
        rw [AlgHom.toRingHom_eq_coe, RingHom.coe_coe, Polynomial.aeval_C, hψC]
      · rw [AlgHom.toRingHom_eq_coe, RingHom.coe_coe, Polynomial.aeval_X]
    intro q
    exact congrArg (fun f : Polynomial K →+* _ => f q) this
  have htr : Transcendental K (ψ Polynomial.X) := by
    rw [transcendental_iff_injective]
    intro a b hab
    rw [haeval, haeval] at hab
    exact hψinj hab
  refine ⟨ψ Polynomial.X, htr, ?_⟩
  rw [eq_top_iff]
  intro z _
  have hmem : ∀ q, ψ q ∈ IntermediateField.adjoin K {ψ Polynomial.X} := by
    intro q
    rw [← haeval q]
    exact IntermediateField.algebra_adjoin_le_adjoin K _ (Polynomial.aeval_mem_adjoin_singleton K _)
  obtain ⟨a, b, hb, hab⟩ := hfracψ z
  have hz : z = ψ a * (ψ b)⁻¹ := by rw [← hab, mul_inv_cancel_right₀ hb]
  rw [hz]
  exact IntermediateField.mul_mem _ (hmem a) (IntermediateField.inv_mem _ (hmem b))

theorem cp1rr_generic_rational : ∀ (K : Type u) [Field K] (R : ValuationSubring K) (Y : Scheme.{u}) (v : Y ⟶ Spec (.of ↥R)), (∀ (p : ↥(@Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K) MvPolynomial.gradedAlgebra)), (∀ w : ↥(@Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K) MvPolynomial.gradedAlgebra), p ⤳ w) → ∀ [Algebra K ((@Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K) MvPolynomial.gradedAlgebra).residueField p)], algebraMap K ((@Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K) MvPolynomial.gradedAlgebra).residueField p) = wcpaDjFK K (@Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K) MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin 2) K 0)))) p → ∃ t : (@Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K) MvPolynomial.gradedAlgebra).residueField p, Transcendental K t ∧ IntermediateField.adjoin K {t} = ⊤) → ∀ (E : Set ↥(Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K))))), (∃ (Er : Scheme.{u}) (ι : Er ⟶ Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K)))) (θ : Er ≅ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K) MvPolynomial.gradedAlgebra), IsClosedImmersion ι ∧ IsReduced Er ∧ Set.range ι = E ∧ θ.hom ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K) MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin 2) K 0))) = ι ≫ Limits.pullback.snd v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K)))) → ∀ z : ↥(Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K)))), closure {z} = E → ∃ (φ : K →+* Y.residueField (Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K))) z)) (t₀ : Y.residueField (Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K))) z)), (∀ r : ↥R, φ (r : K) = ((Scheme.ΓSpecIso (.of ↥R)).inv ≫ v.appTop ≫ Y.presheaf.germ ⊤ (Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K))) z) trivial ≫ Y.residue (Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K))) z)).hom r) ∧ (letI := φ.toAlgebra; Transcendental K t₀ ∧ IntermediateField.adjoin K {t₀} = ⊤) :=
by
  intro K _ R Y v hProj
  classical

  have s1 : ∀ {X X' : Scheme.{u}} (h : X ⟶ X') (x : X) (hx' : h x ∈ (⊤ : X'.Opens))
      (hx : x ∈ (⊤ : X.Opens)),
      X'.presheaf.germ ⊤ (h x) hx' ≫ X'.residue (h x) ≫ h.residueFieldMap x =
        h.appTop ≫ X.presheaf.germ ⊤ x hx ≫ X.residue x := by
    intro X X' h x hx' hx
    rw [Scheme.residue_residueFieldMap, Scheme.Hom.germ_stalkMap_assoc]
    rfl
  have s1' : ∀ {X X' : Scheme.{u}} (h : X ⟶ X') (x : X) (hx' : h x ∈ (⊤ : X'.Opens))
      (hx : x ∈ (⊤ : X.Opens)) {Z : CommRingCat.{u}} (k : X.residueField x ⟶ Z),
      X'.presheaf.germ ⊤ (h x) hx' ≫ X'.residue (h x) ≫ h.residueFieldMap x ≫ k =
        h.appTop ≫ X.presheaf.germ ⊤ x hx ≫ X.residue x ≫ k := by
    intro X X' h x hx' hx Z k
    rw [Scheme.residue_residueFieldMap_assoc, Scheme.Hom.germ_stalkMap_assoc]
    rfl

  have s2 : ∀ (q : ↥(Spec (.of K))), Function.Surjective ((Scheme.ΓSpecIso (.of K)).inv ≫
      (Spec (.of K)).presheaf.germ ⊤ q trivial ≫ (Spec (.of K)).residue q).hom := by
    intro q w
    obtain ⟨τ, rfl⟩ := Scheme.residue_surjective _ q w
    obtain ⟨U, hq, s, rfl⟩ := TopCat.Presheaf.exists_germ_eq _ τ
    have hU : U = ⊤ := eq_top_iff.mpr (fun y _ => by rw [Subsingleton.elim y q]; exact hq)
    subst hU
    refine ⟨(Scheme.ΓSpecIso (.of K)).hom s, ?_⟩
    have hre : ((Scheme.ΓSpecIso (.of K)).inv ≫ (Spec (.of K)).presheaf.germ ⊤ q trivial ≫
        (Spec (.of K)).residue q).hom ((Scheme.ΓSpecIso (.of K)).hom s) =
        ((Scheme.ΓSpecIso (.of K)).hom ≫ (Scheme.ΓSpecIso (.of K)).inv ≫
          (Spec (.of K)).presheaf.germ ⊤ q trivial ≫ (Spec (.of K)).residue q).hom s := rfl
    rw [hre, Iso.hom_inv_id_assoc]
    rfl

  have s3 : ∀ {X X' S : Scheme.{u}} (f : X ⟶ S) (g : X' ⟶ S) (t : ↥(Limits.pullback f g)),
      Set.range ((Limits.pullback.snd f g).residueFieldMap t).hom ⊆
        Set.range ((Limits.pullback.fst f g).residueFieldMap t).hom →
      Function.Bijective ((Limits.pullback.fst f g).residueFieldMap t).hom := by
    intro X Y S f g t hsub
    have hinj : Function.Injective ((Limits.pullback.fst f g).residueFieldMap t).hom :=
      ((Limits.pullback.fst f g).residueFieldMap t).hom.injective
    have hch : ∀ a, ∃ b, ((Limits.pullback.fst f g).residueFieldMap t).hom b =
        ((Limits.pullback.snd f g).residueFieldMap t).hom a := fun a => hsub ⟨a, rfl⟩
    choose α'f hα'f using hch
    let α' : Y.residueField (Limits.pullback.snd f g t) →+*
        X.residueField (Limits.pullback.fst f g t) :=
      { toFun := α'f
        map_one' := hinj (by rw [hα'f, map_one, map_one])
        map_mul' := fun a b => hinj (by rw [hα'f, map_mul, map_mul, hα'f, hα'f])
        map_zero' := hinj (by rw [hα'f, map_zero, map_zero])
        map_add' := fun a b => hinj (by rw [hα'f, map_add, map_add, hα'f, hα'f]) }
    let A' : Y.residueField (Limits.pullback.snd f g t) ⟶
        X.residueField (Limits.pullback.fst f g t) := CommRingCat.ofHom α'
    have hA'pt : ∀ a, ((Limits.pullback.fst f g).residueFieldMap t).hom (A'.hom a) =
        ((Limits.pullback.snd f g).residueFieldMap t).hom a := fun a => hα'f a
    have hA' : A' ≫ (Limits.pullback.fst f g).residueFieldMap t =
        (Limits.pullback.snd f g).residueFieldMap t := by
      ext a
      exact hA'pt a
    have e : g (Limits.pullback.snd f g t) = f (Limits.pullback.fst f g t) := by
      rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, Limits.pullback.condition]
    have hcomm : g.residueFieldMap (Limits.pullback.snd f g t) ≫
        (Limits.pullback.snd f g).residueFieldMap t =
        (S.residueFieldCongr e).hom ≫ f.residueFieldMap (Limits.pullback.fst f g t) ≫
          (Limits.pullback.fst f g).residueFieldMap t := by
      have h1 := Scheme.Hom.residueFieldMap_congr (Limits.pullback.condition (f := f) (g := g)).symm t
      rw [Scheme.residueFieldMap_comp, Scheme.residueFieldMap_comp] at h1
      exact h1
    have hcomp' : g.residueFieldMap (Limits.pullback.snd f g t) ≫ A' =
        (S.residueFieldCongr e).hom ≫ f.residueFieldMap (Limits.pullback.fst f g t) := by
      ext c
      apply hinj
      have h2 := congrArg (fun φ => φ.hom c) hcomm
      simp only [CommRingCat.hom_comp, RingHom.comp_apply] at h2 ⊢
      rw [hA'pt]
      exact h2
    have hab : (Spec.map A' ≫ Y.fromSpecResidueField (Limits.pullback.snd f g t)) ≫ g =
        X.fromSpecResidueField (Limits.pullback.fst f g t) ≫ f := by
      rw [Category.assoc, ← Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField,
        ← Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField,
        ← Scheme.residueFieldCongr_fromSpecResidueField e, ← Category.assoc, ← Category.assoc,
        ← Spec.map_comp, ← Spec.map_comp, hcomp']
    let u := Limits.pullback.lift _ _ hab.symm
    have hu : Spec.map ((Limits.pullback.fst f g).residueFieldMap t) ≫ u =
        (Limits.pullback f g).fromSpecResidueField t := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, Limits.pullback.lift_fst,
          Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField]
      · rw [Category.assoc, Limits.pullback.lift_snd,
          ← Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField, ← hA', Spec.map_comp,
          Category.assoc]
    obtain ⟨p, hp⟩ : ∃ p, Scheme.SpecToEquivOfField
        (X.residueField (Limits.pullback.fst f g t)) (Limits.pullback f g) u = p := ⟨_, rfl⟩
    obtain ⟨t', σ⟩ := p
    have hu' : u = Spec.map σ ≫ (Limits.pullback f g).fromSpecResidueField t' := by
      have h0 := congrArg (Scheme.SpecToEquivOfField
        (X.residueField (Limits.pullback.fst f g t)) (Limits.pullback f g)).symm hp
      rw [Equiv.symm_apply_apply, Scheme.SpecToEquivOfField_symm_apply] at h0
      exact h0
    have heq : (Scheme.SpecToEquivOfField ((Limits.pullback f g).residueField t)
        (Limits.pullback f g)).symm ⟨t', σ ≫ ((Limits.pullback.fst f g).residueFieldMap t)⟩ =
        (Scheme.SpecToEquivOfField ((Limits.pullback f g).residueField t)
        (Limits.pullback f g)).symm ⟨t, 𝟙 _⟩ := by
      rw [Scheme.SpecToEquivOfField_symm_apply, Scheme.SpecToEquivOfField_symm_apply,
        Spec.map_comp, Category.assoc, ← hu', hu, Spec.map_id]
      exact (Category.id_comp _).symm
    obtain ⟨e', h'⟩ := Scheme.SpecToEquivOfField_eq_iff.mp
      ((Scheme.SpecToEquivOfField _ _).symm.injective heq)
    have hsurj : Function.Surjective ((Limits.pullback.fst f g).residueFieldMap t).hom := by
      intro w
      refine ⟨σ.hom ((Scheme.residueFieldCongr e').inv.hom w), ?_⟩
      have h3 := congrArg (fun φ => φ.hom ((Scheme.residueFieldCongr e').inv.hom w)) h'
      simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_id,
        RingHom.id_apply] at h3
      rw [h3, ← RingHom.comp_apply, ← CommRingCat.hom_comp, Iso.inv_hom_id, CommRingCat.hom_id,
        RingHom.id_apply]
    exact ⟨hinj, hsurj⟩

  have s5 : ∀ {X X' : Scheme.{u}} (f : X ⟶ X'), IsClosedImmersion f → ∀ x : X,
      Function.Bijective (f.residueFieldMap x).hom := by
    intro X X' f hf x
    haveI := hf
    haveI : SurjectiveOnStalks f := inferInstance
    refine ⟨RingHom.injective _, ?_⟩
    intro w
    obtain ⟨s, rfl⟩ := Scheme.residue_surjective _ x w
    obtain ⟨t, rfl⟩ := f.stalkMap_surjective x s
    refine ⟨(X'.residue _).hom t, ?_⟩
    rw [← CommRingCat.comp_apply, Scheme.residue_residueFieldMap, CommRingCat.comp_apply]

  have s6 : ∀ (A B : Type u) [Field A] [Field B] [Algebra K A] (Φ : A ≃+* B) (φ : K →+* B),
      (∀ k : K, φ k = Φ (algebraMap K A k)) → ∀ t : A, Transcendental K t →
      IntermediateField.adjoin K {t} = ⊤ →
      (letI := φ.toAlgebra; Transcendental K (Φ t) ∧ IntermediateField.adjoin K {Φ t} = ⊤) := by
    intro A B _ _ _ Φ φ hφ t ht hadj
    letI := φ.toAlgebra
    let Ψ : A ≃ₐ[K] B := AlgEquiv.ofRingEquiv (f := Φ) (fun k => (hφ k).symm)
    refine ⟨?_, ?_⟩
    · show ¬ IsAlgebraic K (Φ t)
      intro halg
      exact ht ((isAlgebraic_algHom_iff Ψ.toAlgHom Ψ.injective).mp halg)
    · have h1 := IntermediateField.adjoin_map K {t} Ψ.toAlgHom
      rw [hadj, Set.image_singleton] at h1
      have hmap : IntermediateField.map Ψ.toAlgHom ⊤ = ⊤ := by
        rw [eq_top_iff]
        intro x _
        rw [IntermediateField.mem_map]
        exact ⟨Ψ.symm x, IntermediateField.mem_top, Ψ.apply_symm_apply x⟩
      exact h1.symm.trans hmap

  have s4 : ∀ z : ↥(Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K)))),
      Function.Bijective ((Limits.pullback.fst v
        (Spec.map (CommRingCat.ofHom (algebraMap ↥R K)))).residueFieldMap z).hom := by
    intro z
    apply s3
    have hc : (Spec.map (CommRingCat.ofHom (algebraMap ↥R K))).appTop ≫
        (Limits.pullback.snd v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K)))).appTop =
        v.appTop ≫ (Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K)))).appTop := by
      rw [← Scheme.Hom.comp_appTop, ← Scheme.Hom.comp_appTop, Limits.pullback.condition]
    have hmor : CommRingCat.ofHom (algebraMap ↥R K) ≫ (Scheme.ΓSpecIso (.of K)).inv ≫
        (Limits.pullback.snd v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K)))).appTop ≫
        (Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K)))).presheaf.germ ⊤ z
          trivial ≫
        (Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K)))).residue z =
        (Scheme.ΓSpecIso (.of ↥R)).inv ≫ v.appTop ≫
        Y.presheaf.germ ⊤ (Limits.pullback.fst v
          (Spec.map (CommRingCat.ofHom (algebraMap ↥R K))) z) trivial ≫
        Y.residue (Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K))) z) ≫
        (Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K)))).residueFieldMap z := by
      rw [s1 _ z trivial trivial, Scheme.ΓSpecIso_inv_naturality_assoc, reassoc_of% hc]
    have hF : ∀ r : ↥R, wcpaDjFK K (Limits.pullback.snd v
        (Spec.map (CommRingCat.ofHom (algebraMap ↥R K)))) z (r : K) =
        ((Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K)))).residueFieldMap z).hom
          (((Scheme.ΓSpecIso (.of ↥R)).inv ≫ v.appTop ≫
            Y.presheaf.germ ⊤ (Limits.pullback.fst v
              (Spec.map (CommRingCat.ofHom (algebraMap ↥R K))) z) trivial ≫
            Y.residue (Limits.pullback.fst v
              (Spec.map (CommRingCat.ofHom (algebraMap ↥R K))) z)).hom r) := by
      intro r
      exact congrArg (fun φ => φ.hom r) hmor
    have hrange : ∀ k : K, wcpaDjFK K (Limits.pullback.snd v
        (Spec.map (CommRingCat.ofHom (algebraMap ↥R K)))) z k ∈
        Set.range ((Limits.pullback.fst v
          (Spec.map (CommRingCat.ofHom (algebraMap ↥R K)))).residueFieldMap z).hom := by
      intro k
      rcases R.mem_or_inv_mem k with hk | hk
      · exact ⟨_, (hF ⟨k, hk⟩).symm⟩
      · refine ⟨(((Scheme.ΓSpecIso (.of ↥R)).inv ≫ v.appTop ≫
            Y.presheaf.germ ⊤ (Limits.pullback.fst v
              (Spec.map (CommRingCat.ofHom (algebraMap ↥R K))) z) trivial ≫
            Y.residue (Limits.pullback.fst v
              (Spec.map (CommRingCat.ofHom (algebraMap ↥R K))) z)).hom ⟨k⁻¹, hk⟩)⁻¹, ?_⟩
        have h2 : wcpaDjFK K (Limits.pullback.snd v
            (Spec.map (CommRingCat.ofHom (algebraMap ↥R K)))) z k⁻¹ = _ := hF ⟨k⁻¹, hk⟩
        rw [map_inv₀, ← h2, ← map_inv₀, inv_inv]
    rintro y ⟨w, rfl⟩
    obtain ⟨k, rfl⟩ := s2 _ w
    obtain ⟨a, ha⟩ := hrange k
    refine ⟨a, ha.trans ?_⟩
    exact (congrArg (fun φ => φ.hom k) (congrArg ((Scheme.ΓSpecIso (.of K)).inv ≫ ·)
      (s1 (Limits.pullback.snd v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K)))) z
        trivial trivial))).symm

  have sR : ∀ {Er P YK Y' : Scheme.{u}} (θh : Er ⟶ P) (ι : Er ⟶ YK) (fst : YK ⟶ Y')
      (strP : P ⟶ Spec (.of K)) (v' : Y' ⟶ Spec (.of ↥R)) (e₀ : Er),
      (θh ≫ strP) ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥R K)) = (ι ≫ fst) ≫ v' →
      ∀ r : ↥R, (θh.residueFieldMap e₀).hom (wcpaDjFK K strP (θh e₀) (r : K)) =
        (ι.residueFieldMap e₀).hom ((fst.residueFieldMap (ι e₀)).hom
          (((Scheme.ΓSpecIso (.of ↥R)).inv ≫ v'.appTop ≫ Y'.presheaf.germ ⊤ (fst (ι e₀)) trivial ≫
            Y'.residue (fst (ι e₀))).hom r)) := by
    intro Er P YK Y' θh ι fst strP v' e₀ hmor r
    have hcat : CommRingCat.ofHom (algebraMap ↥R K) ≫ (Scheme.ΓSpecIso (.of K)).inv ≫
        strP.appTop ≫ P.presheaf.germ ⊤ (θh e₀) trivial ≫ P.residue (θh e₀) ≫
        θh.residueFieldMap e₀ =
        (Scheme.ΓSpecIso (.of ↥R)).inv ≫ v'.appTop ≫ Y'.presheaf.germ ⊤ (fst (ι e₀)) trivial ≫
        Y'.residue (fst (ι e₀)) ≫ fst.residueFieldMap (ι e₀) ≫ ι.residueFieldMap e₀ := by
      rw [s1 θh e₀ trivial trivial, s1' fst (ι e₀) trivial trivial, s1 ι e₀ trivial trivial,
        Scheme.ΓSpecIso_inv_naturality_assoc]
      have hΓ := congrArg Scheme.Hom.appTop hmor
      rw [Scheme.Hom.comp_appTop (θh ≫ strP) (Spec.map (CommRingCat.ofHom (algebraMap ↥R K))),
        Scheme.Hom.comp_appTop θh strP, Scheme.Hom.comp_appTop (ι ≫ fst) v',
        Scheme.Hom.comp_appTop ι fst] at hΓ
      rw [reassoc_of% hΓ]
    exact congrArg (fun φ => φ.hom r) hcat

  rintro E ⟨Er, ι, θ, hι, -, hrange, hθ⟩ z hzE
  generalize (@Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
    MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
      (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin 2) K 0)))) = strP at hProj hθ
  have hzmem : z ∈ Set.range ι := by
    rw [hrange, ← hzE]
    exact subset_closure rfl
  obtain ⟨e₀, rfl⟩ := hzmem
  have hgen : ∀ w, θ.hom e₀ ⤳ w := by
    intro w
    have h1 : ι e₀ ⤳ ι (θ.inv w) := by
      rw [specializes_iff_mem_closure, hzE, ← hrange]
      exact ⟨_, rfl⟩
    haveI := hι
    have h2 : e₀ ⤳ θ.inv w := (ι.isClosedEmbedding.isInducing.specializes_iff).mp h1
    have h3 := h2.map θ.hom.continuous
    rwa [Scheme.inv_hom_apply] at h3
  letI alg := (wcpaDjFK K strP (θ.hom e₀)).toAlgebra
  obtain ⟨t₁, ht₁tr, ht₁adj⟩ := hProj (θ.hom e₀) hgen rfl
  have bθ : Function.Bijective (θ.hom.residueFieldMap e₀).hom :=
    ConcreteCategory.bijective_of_isIso _
  have bι := s5 ι hι e₀
  have bf := s4 (ι e₀)
  let eθ := RingEquiv.ofBijective _ bθ
  let eι := RingEquiv.ofBijective _ bι
  let ef := RingEquiv.ofBijective _ bf
  let Φ := eθ.trans (eι.symm.trans ef.symm)
  have hmor : (θ.hom ≫ strP) ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥R K)) =
      (ι ≫ Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K)))) ≫ v := by
    rw [hθ, Category.assoc, Category.assoc, Limits.pullback.condition]
  refine ⟨Φ.toRingHom.comp (wcpaDjFK K strP (θ.hom e₀)), Φ t₁, ?_, ?_⟩
  · intro r
    show ef.symm (eι.symm (eθ (wcpaDjFK K strP (θ.hom e₀) (r : K)))) = _
    rw [RingEquiv.symm_apply_eq, RingEquiv.symm_apply_eq]
    exact sR θ.hom ι (Limits.pullback.fst v _) strP v e₀ hmor r
  · exact s6 _ _ Φ _ (fun k => rfl) t₁ ht₁tr ht₁adj

theorem cp1rr_special_valuation : ∀ (K : Type u) [Field K] (R : ValuationSubring K) (Y : Scheme.{u}) (v : Y ⟶ Spec (.of ↥R)) (g : Y) (ξ : ↥(Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R)))))), g ⤳ Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R)))) ξ → ∃ (V : ValuationSubring (Y.residueField g)) (ψ : (Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R))))).residueField ξ →+* IsLocalRing.ResidueField ↥V), ∀ r : ↥R, ∃ h : ((Scheme.ΓSpecIso (.of ↥R)).inv ≫ v.appTop ≫ Y.presheaf.germ ⊤ g trivial ≫ Y.residue g).hom r ∈ V, ψ (wcpaDjFK (IsLocalRing.ResidueField ↥R) (Limits.pullback.snd v (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R))))) ξ (IsLocalRing.residue ↥R r)) = IsLocalRing.residue ↥V ⟨((Scheme.ΓSpecIso (.of ↥R)).inv ≫ v.appTop ≫ Y.presheaf.germ ⊤ g trivial ≫ Y.residue g).hom r, h⟩ :=
by
  intro K _ R Y v g ξ h
  classical

  haveI hci : IsClosedImmersion
      (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R)))) := by
    apply IsClosedImmersion.spec_of_surjective
    show Function.Surjective (algebraMap ↥R (IsLocalRing.ResidueField ↥R))
    rw [IsLocalRing.ResidueField.algebraMap_eq]
    exact IsLocalRing.residue_surjective
  haveI : IsClosedImmersion (Limits.pullback.fst v
      (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R))))) :=
    inferInstance
  haveI : SurjectiveOnStalks (Limits.pullback.fst v
      (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R))))) :=
    inferInstance

  have hα : Function.Bijective (Scheme.Hom.residueFieldMap (Limits.pullback.fst v
      (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R))))) ξ).hom := by
    refine ⟨RingHom.injective _, ?_⟩
    intro w
    obtain ⟨s, rfl⟩ := Scheme.residue_surjective _ ξ w
    obtain ⟨t, rfl⟩ := (Limits.pullback.fst v
      (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R))))).stalkMap_surjective ξ s
    refine ⟨(Y.residue _).hom t, ?_⟩
    rw [← CommRingCat.comp_apply, Scheme.residue_residueFieldMap, CommRingCat.comp_apply]
  let e := RingEquiv.ofBijective _ hα

  let sp : Y.presheaf.stalk (Limits.pullback.fst v
      (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R)))) ξ) →+*
      Y.residueField g := (Y.presheaf.stalkSpecializes h ≫ Y.residue g).hom
  obtain ⟨A, hA, hloc⟩ := IsLocalRing.exists_factor_valuationRing sp
  let σ := sp.codRestrict A (fun x => hA x)
  haveI hσ : IsLocalHom σ := by
    refine ⟨fun t ht => ?_⟩
    obtain ⟨u, hu⟩ := ht
    have hu' : ((u : A) : Y.residueField g) = sp t := congrArg Subtype.val hu
    have ht' : IsUnit (sp.codRestrict A.toSubring hA t) := by
      refine isUnit_iff_exists_inv.mpr ⟨⟨((u⁻¹ : Aˣ) : A), ((u⁻¹ : Aˣ) : A).2⟩, ?_⟩
      apply Subtype.ext
      show sp t * (((u⁻¹ : Aˣ) : A) : Y.residueField g) = 1
      rw [← hu']
      exact congrArg Subtype.val u.mul_inv
    exact hloc.map_nonunit t ht'
  let β := IsLocalRing.ResidueField.map σ
  let β' : Y.residueField (Limits.pullback.fst v
      (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R)))) ξ) →+*
      IsLocalRing.ResidueField ↥A := β
  let ψ : (Limits.pullback v (Spec.map (CommRingCat.ofHom
      (algebraMap ↥R (IsLocalRing.ResidueField ↥R))))).residueField ξ →+*
      IsLocalRing.ResidueField ↥A := β'.comp e.symm.toRingHom
  have hg : g ∈ (⊤ : Y.Opens) := trivial
  have hy : Limits.pullback.fst v
      (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R)))) ξ ∈
      (⊤ : Y.Opens) := trivial
  have hξ : ξ ∈ (⊤ : (Limits.pullback v (Spec.map (CommRingCat.ofHom
      (algebraMap ↥R (IsLocalRing.ResidueField ↥R))))).Opens) := trivial

  have hmor : (Scheme.ΓSpecIso (.of ↥R)).inv ≫ v.appTop ≫ Y.presheaf.germ ⊤ g hg ≫
      Y.residue g = (Scheme.ΓSpecIso (.of ↥R)).inv ≫ v.appTop ≫
      Y.presheaf.germ ⊤ (Limits.pullback.fst v
        (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R)))) ξ) hy ≫
      Y.presheaf.stalkSpecializes h ≫ Y.residue g := by
    rw [TopCat.Presheaf.germ_stalkSpecializes_assoc]

  have hc : (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R)))).appTop ≫
      (Limits.pullback.snd v (Spec.map (CommRingCat.ofHom
        (algebraMap ↥R (IsLocalRing.ResidueField ↥R))))).appTop =
      v.appTop ≫ (Limits.pullback.fst v (Spec.map (CommRingCat.ofHom
        (algebraMap ↥R (IsLocalRing.ResidueField ↥R))))).appTop := by
    rw [← Scheme.Hom.comp_appTop, ← Scheme.Hom.comp_appTop, Limits.pullback.condition]
  have hmor2 : CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R)) ≫
      (Scheme.ΓSpecIso (.of (IsLocalRing.ResidueField ↥R))).inv ≫
      (Limits.pullback.snd v (Spec.map (CommRingCat.ofHom
        (algebraMap ↥R (IsLocalRing.ResidueField ↥R))))).appTop ≫
      (Limits.pullback v (Spec.map (CommRingCat.ofHom
        (algebraMap ↥R (IsLocalRing.ResidueField ↥R))))).presheaf.germ ⊤ ξ hξ ≫
      (Limits.pullback v (Spec.map (CommRingCat.ofHom
        (algebraMap ↥R (IsLocalRing.ResidueField ↥R))))).residue ξ =
      (Scheme.ΓSpecIso (.of ↥R)).inv ≫ v.appTop ≫
      Y.presheaf.germ ⊤ (Limits.pullback.fst v
        (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R)))) ξ) hy ≫
      Y.residue (Limits.pullback.fst v
        (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R)))) ξ) ≫
      Scheme.Hom.residueFieldMap (Limits.pullback.fst v
        (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R))))) ξ := by
    rw [Scheme.residue_residueFieldMap, Scheme.Hom.germ_stalkMap_assoc,
      Scheme.ΓSpecIso_inv_naturality_assoc, reassoc_of% hc]
    rfl
  refine ⟨A, ψ, fun r => ?_⟩
  have key1 := congrArg (fun φ => φ.hom r) hmor
  have key2 := congrArg (fun φ => φ.hom r) hmor2
  simp only at key1 key2
  have hmem : ((Scheme.ΓSpecIso (.of ↥R)).inv ≫ v.appTop ≫ Y.presheaf.germ ⊤ g trivial ≫
      Y.residue g).hom r ∈ A := by
    rw [key1]
    exact hA _
  refine ⟨hmem, ?_⟩
  have hFK : wcpaDjFK (IsLocalRing.ResidueField ↥R) (Limits.pullback.snd v
      (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R))))) ξ
      (IsLocalRing.residue ↥R r) = e ((Y.residue _).hom
        ((Y.presheaf.germ ⊤ (Limits.pullback.fst v
        (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R)))) ξ) trivial).hom
          (((Scheme.ΓSpecIso (.of ↥R)).inv ≫ v.appTop).hom r))) := by
    unfold wcpaDjFK
    exact key2
  rw [hFK]
  show β' (e.symm (e _)) = _
  rw [RingEquiv.symm_apply_apply]
  refine (IsLocalRing.ResidueField.map_residue σ _).trans ?_
  congr 1
  apply Subtype.ext
  exact key1.symm

theorem cp1rr_linear_factorization : ∀ (K F : Type u) [Field K] [IsAlgClosed K] [Field F] [Algebra K F] (t₀ : F), IntermediateField.adjoin K {t₀} = ⊤ → ∀ f : F, f ≠ 0 → ∃ (n : ℕ) (c : K) (a : Fin n → K) (e : Fin n → ℤ), c ≠ 0 ∧ f = algebraMap K F c * ∏ i, (t₀ - algebraMap K F (a i)) ^ (e i) :=
by
  intro K F _ _ _ _ t₀ hadj f hf
  classical
  have hms : ∀ s : Multiset K, ∃ (n : ℕ) (a : Fin n → K),
      (s.map (fun b => t₀ - algebraMap K F b)).prod = ∏ i, (t₀ - algebraMap K F (a i)) := by
    intro s
    induction s using Multiset.induction_on with
    | empty => exact ⟨0, Fin.elim0, by simp⟩
    | cons b s ih =>
      obtain ⟨n, a, ha⟩ := ih
      refine ⟨n + 1, Fin.cons b a, ?_⟩
      rw [Multiset.map_cons, Multiset.prod_cons, Fin.prod_univ_succ, Fin.cons_zero, ha]
      simp only [Fin.cons_succ]
  have hsplit : ∀ p : Polynomial K, ∃ (n : ℕ) (a : Fin n → K),
      Polynomial.aeval t₀ p = algebraMap K F p.leadingCoeff * ∏ i, (t₀ - algebraMap K F (a i)) := by
    intro p
    obtain ⟨n, a, ha⟩ := hms p.roots
    refine ⟨n, a, ?_⟩
    have hp := Polynomial.C_leadingCoeff_mul_prod_multiset_X_sub_C (p := p)
      (IsAlgClosed.card_roots_eq_natDegree (k := K) (p := p))
    conv_lhs => rw [← hp]
    rw [map_mul, Polynomial.aeval_C, map_multiset_prod, Multiset.map_map, ← ha]
    congr 2
    apply Multiset.map_congr rfl
    intro x _
    simp
  have hmem : f ∈ IntermediateField.adjoin K {t₀} := by rw [hadj]; exact IntermediateField.mem_top
  obtain ⟨r, s, hrs⟩ := (IntermediateField.mem_adjoin_simple_iff K f).mp hmem
  have hs0 : Polynomial.aeval t₀ s ≠ 0 := by
    intro h; apply hf; rw [hrs, h, div_zero]
  have hr0 : Polynomial.aeval t₀ r ≠ 0 := by
    intro h; apply hf; rw [hrs, h, zero_div]
  have hr : r ≠ 0 := by rintro rfl; exact hr0 (map_zero _)
  have hs : s ≠ 0 := by rintro rfl; exact hs0 (map_zero _)
  obtain ⟨n₁, a₁, h₁⟩ := hsplit r
  obtain ⟨n₂, a₂, h₂⟩ := hsplit s
  refine ⟨n₁ + n₂, r.leadingCoeff / s.leadingCoeff, Fin.append a₁ a₂,
    Fin.append (fun _ => (1 : ℤ)) (fun _ => (-1 : ℤ)),
    div_ne_zero (Polynomial.leadingCoeff_ne_zero.mpr hr) (Polynomial.leadingCoeff_ne_zero.mpr hs), ?_⟩
  rw [Fin.prod_univ_add]
  simp only [Fin.append_left, Fin.append_right, zpow_one, zpow_neg_one, Finset.prod_inv_distrib]
  rw [hrs, h₁, h₂, map_div₀]
  ring

theorem cp1rr_ruled_residue_attained : ∀ (K F : Type u) [Field K] [Field F] [Algebra K F] (t₀ : F), Transcendental K t₀ → (∀ f : F, f ≠ 0 → ∃ (n : ℕ) (c : K) (a : Fin n → K) (e : Fin n → ℤ), c ≠ 0 ∧ f = algebraMap K F c * ∏ i, (t₀ - algebraMap K F (a i)) ^ (e i)) → ∀ (V : ValuationSubring F) (a₀ b : K), b ≠ 0 → (∀ a : K, V.valuation (t₀ - algebraMap K F a₀) ≤ V.valuation (t₀ - algebraMap K F a)) → V.valuation (t₀ - algebraMap K F a₀) = V.valuation (algebraMap K F b) → ∃ s : IsLocalRing.ResidueField ↥V, ∀ w : IsLocalRing.ResidueField ↥V, w ∈ Subfield.closure (insert s {w' | ∃ (x : K) (hx : algebraMap K F x ∈ V), w' = IsLocalRing.residue ↥V ⟨algebraMap K F x, hx⟩}) :=
by
  intro K F _ _ _ t₀ _ hfac V a₀ b hb hmin hval
  classical
  have hβ : algebraMap K F b ≠ 0 := (map_ne_zero _).mpr hb
  have hvβ : V.valuation (algebraMap K F b) ≠ 0 := (Valuation.ne_zero_iff _).mpr hβ
  set u : F := (t₀ - algebraMap K F a₀) / algebraMap K F b with hu
  have hvu : V.valuation u = 1 := by
    rw [hu, map_div₀, hval, div_self hvβ]
  have huV : u ∈ V := (V.valuation_le_one_iff u).mp hvu.le
  have hueq : u * algebraMap K F b = t₀ - algebraMap K F a₀ := div_mul_cancel₀ _ hβ
  refine ⟨IsLocalRing.residue V ⟨u, huV⟩, ?_⟩
  set L := Subfield.closure (insert (IsLocalRing.residue V ⟨u, huV⟩)
    {w' | ∃ (x : K) (hx : algebraMap K F x ∈ V), w' = IsLocalRing.residue ↥V ⟨algebraMap K F x, hx⟩})
    with hL
  have hKL : ∀ (x : K) (hx : algebraMap K F x ∈ V),
      IsLocalRing.residue V ⟨algebraMap K F x, hx⟩ ∈ L :=
    fun x hx => Subfield.subset_closure (Set.mem_insert_of_mem _ ⟨x, hx, rfl⟩)
  have huL : IsLocalRing.residue V ⟨u, huV⟩ ∈ L := Subfield.subset_closure (Set.mem_insert _ _)
  have hmemV : ∀ g : F, V.valuation g = 1 → g ∈ V := fun g hg => (V.valuation_le_one_iff g).mp hg.le
  let Q : F → Prop := fun x => ∃ κ : K, κ ≠ 0 ∧ ∃ g : F, V.valuation g = 1 ∧
    (∀ hg : g ∈ V, IsLocalRing.residue ↥V ⟨g, hg⟩ ∈ L) ∧ x = algebraMap K F κ * g

  have hlin : ∀ a : K, Q (t₀ - algebraMap K F a) := by
    intro a
    set d : K := (a₀ - a) / b with hd
    have hdeq : algebraMap K F d * algebraMap K F b = algebraMap K F a₀ - algebraMap K F a := by
      rw [← map_mul, hd, div_mul_cancel₀ _ hb, map_sub]
    have hstar : t₀ - algebraMap K F a = (u + algebraMap K F d) * algebraMap K F b := by
      rw [add_mul, hueq, hdeq]; ring
    by_cases hdV : algebraMap K F d ∈ V
    · refine ⟨b, hb, u + algebraMap K F d, ?_, ?_, by rw [hstar, mul_comm]⟩
      · have hgV : u + algebraMap K F d ∈ V := V.add_mem _ _ huV hdV
        have h1 : V.valuation (u + algebraMap K F d) ≤ 1 := (V.valuation_le_one_iff _).mpr hgV
        have h2 := hmin a
        rw [hstar, ← hueq, map_mul, map_mul, hvu, one_mul] at h2
        have h3 : V.valuation (algebraMap K F b) * 1 ≤
            V.valuation (algebraMap K F b) * V.valuation (u + algebraMap K F d) := by
          rw [mul_one, mul_comm]; exact h2
        have hpos : 0 < V.valuation (algebraMap K F b) := zero_lt_iff.mpr hvβ
        exact le_antisymm h1 (le_of_mul_le_mul_left h3 hpos)
      · intro hg
        have : (⟨u + algebraMap K F d, hg⟩ : V) = ⟨u, huV⟩ + ⟨algebraMap K F d, hdV⟩ :=
          Subtype.ext rfl
        rw [this, map_add]
        exact L.add_mem huL (hKL d hdV)
    · have hdgt : 1 < V.valuation (algebraMap K F d) := by
        rw [← V.valuation_le_one_iff] at hdV; exact lt_of_not_ge hdV
      have hd0 : algebraMap K F d ≠ 0 := by
        intro h; rw [h, map_zero] at hdgt; exact absurd hdgt (not_lt.mpr zero_le')
      have hd0' : d ≠ 0 := by rintro h; exact hd0 (by rw [h, map_zero])
      have hsmall : V.valuation (u / algebraMap K F d) < 1 := by
        rw [map_div₀, hvu, one_div]; exact inv_lt_one_of_one_lt₀ hdgt
      have hsV : u / algebraMap K F d ∈ V := (V.valuation_le_one_iff _).mp hsmall.le
      refine ⟨b * d, mul_ne_zero hb hd0', 1 + u / algebraMap K F d,
        Valuation.map_one_add_of_lt _ hsmall, ?_, ?_⟩
      · intro hg
        have : (⟨1 + u / algebraMap K F d, hg⟩ : V) = 1 + ⟨u / algebraMap K F d, hsV⟩ :=
          Subtype.ext rfl
        have hm : (⟨u / algebraMap K F d, hsV⟩ : V) ∈ IsLocalRing.maximalIdeal V :=
          (V.valuation_lt_one_iff _).mpr hsmall
        rw [this, map_add, map_one, (IsLocalRing.residue_eq_zero_iff _).mpr hm, add_zero]
        exact L.one_mem
      · rw [hstar, map_mul]; field_simp; ring

  have hQ1 : Q 1 := ⟨1, one_ne_zero, 1, map_one _, fun hg => by
      have : (⟨1, hg⟩ : V) = 1 := rfl
      rw [this, map_one]; exact L.one_mem, by simp⟩
  have hQmul : ∀ x y, Q x → Q y → Q (x * y) := by
    rintro x y ⟨κ₁, hκ₁, g₁, hv₁, hr₁, rfl⟩ ⟨κ₂, hκ₂, g₂, hv₂, hr₂, rfl⟩
    have hg₁ : g₁ ∈ V := hmemV g₁ hv₁
    have hg₂ : g₂ ∈ V := hmemV g₂ hv₂
    refine ⟨κ₁ * κ₂, mul_ne_zero hκ₁ hκ₂, g₁ * g₂, by rw [map_mul, hv₁, hv₂, one_mul],
      fun hg => ?_, by rw [map_mul]; ring⟩
    have : (⟨g₁ * g₂, hg⟩ : V) = ⟨g₁, hg₁⟩ * ⟨g₂, hg₂⟩ := Subtype.ext rfl
    rw [this, map_mul]; exact L.mul_mem (hr₁ hg₁) (hr₂ hg₂)
  have hQinv : ∀ x, Q x → Q x⁻¹ := by
    rintro x ⟨κ, hκ, g, hv, hr, rfl⟩
    have hgV : g ∈ V := hmemV g hv
    have hg0 : g ≠ 0 := by rintro rfl; rw [map_zero] at hv; exact zero_ne_one hv
    have hv' : V.valuation g⁻¹ = 1 := by rw [map_inv₀, hv, inv_one]
    refine ⟨κ⁻¹, inv_ne_zero hκ, g⁻¹, hv', fun hg => ?_, by rw [mul_inv, map_inv₀]⟩
    have hprod : IsLocalRing.residue V ⟨g, hgV⟩ * IsLocalRing.residue V ⟨g⁻¹, hg⟩ = 1 := by
      rw [← map_mul]
      have : (⟨g, hgV⟩ : V) * ⟨g⁻¹, hg⟩ = 1 := Subtype.ext (mul_inv_cancel₀ hg0)
      rw [this, map_one]
    rw [← inv_eq_of_mul_eq_one_right hprod]
    exact L.inv_mem (hr hgV)
  have hQpow : ∀ x, Q x → ∀ m : ℕ, Q (x ^ m) := by
    intro x hx m
    induction m with
    | zero => rw [pow_zero]; exact hQ1
    | succ m ih => rw [pow_succ]; exact hQmul _ _ ih hx
  have hQzpow : ∀ x, Q x → ∀ e : ℤ, Q (x ^ e) := by
    intro x hx e
    cases e with
    | ofNat m => rw [Int.ofNat_eq_coe, zpow_natCast]; exact hQpow x hx m
    | negSucc m => rw [zpow_negSucc]; exact hQinv _ (hQpow x hx (m + 1))

  intro w
  obtain ⟨r, rfl⟩ := IsLocalRing.residue_surjective w
  by_cases hr0 : (r : F) = 0
  · have : r = 0 := Subtype.ext hr0
    rw [this, map_zero]; exact L.zero_mem
  obtain ⟨n, c, a, e, hc, hf⟩ := hfac r hr0
  have hprod : Q (∏ i, (t₀ - algebraMap K F (a i)) ^ (e i)) :=
    Finset.prod_induction _ Q hQmul hQ1 (fun i _ => hQzpow _ (hlin (a i)) (e i))
  obtain ⟨κ, _, g, hv, hres, heq⟩ := hprod
  have hgV : g ∈ V := hmemV g hv
  have hf' : (r : F) = algebraMap K F (c * κ) * g := by rw [hf, heq, map_mul, mul_assoc]
  have hκV : algebraMap K F (c * κ) ∈ V := by
    rw [← V.valuation_le_one_iff]
    have := (V.valuation_le_one_iff _).mpr r.2
    rw [hf', map_mul, hv, mul_one] at this
    exact this
  have : r = ⟨algebraMap K F (c * κ), hκV⟩ * ⟨g, hgV⟩ := Subtype.ext hf'
  rw [this, map_mul]
  exact L.mul_mem (hKL _ hκV) (hres hgV)

theorem cp1rr_ruled_residue_unattained : ∀ (K F : Type u) [Field K] [IsAlgClosed K] [Field F] [Algebra K F] (t₀ : F), Transcendental K t₀ → (∀ f : F, f ≠ 0 → ∃ (n : ℕ) (c : K) (a : Fin n → K) (e : Fin n → ℤ), c ≠ 0 ∧ f = algebraMap K F c * ∏ i, (t₀ - algebraMap K F (a i)) ^ (e i)) → ∀ V : ValuationSubring F, (¬ ∃ a₀ b : K, b ≠ 0 ∧ (∀ a : K, V.valuation (t₀ - algebraMap K F a₀) ≤ V.valuation (t₀ - algebraMap K F a)) ∧ V.valuation (t₀ - algebraMap K F a₀) = V.valuation (algebraMap K F b)) → ∀ w : IsLocalRing.ResidueField ↥V, w ∈ Subfield.closure {w' | ∃ (x : K) (hx : algebraMap K F x ∈ V), w' = IsLocalRing.residue ↥V ⟨algebraMap K F x, hx⟩} :=
by
  intro K F _ _ _ _ t₀ htr hfac V hno w
  classical
  set L := Subfield.closure {w' | ∃ (x : K) (hx : algebraMap K F x ∈ V),
    w' = IsLocalRing.residue ↥V ⟨algebraMap K F x, hx⟩} with hL

  have hlin0 : ∀ a : K, t₀ - algebraMap K F a ≠ 0 := by
    intro a h
    apply htr
    rw [sub_eq_zero.mp h]
    exact isAlgebraic_algebraMap a

  let PU : F → Prop := fun U => V.valuation (U - 1) < 1
  have hPUv : ∀ U, PU U → V.valuation U = 1 := by
    intro U hU
    have h := Valuation.map_one_add_of_lt V.valuation hU
    have e : (1 : F) + (U - 1) = U := by ring
    rwa [e] at h
  have hPU1 : PU 1 := by
    show V.valuation (1 - 1) < 1
    rw [sub_self, map_zero]; exact zero_lt_one
  have hPUmul : ∀ u U, PU u → PU U → PU (u * U) := by
    intro u U hu hU
    show V.valuation (u * U - 1) < 1
    have e : u * U - 1 = u * (U - 1) + (u - 1) := by ring
    rw [e]
    refine lt_of_le_of_lt (Valuation.map_add _ _ _) (max_lt ?_ hu)
    rw [map_mul, hPUv u hu, one_mul]; exact hU
  have hPUinv : ∀ u, PU u → PU u⁻¹ := by
    intro u hu
    have hv := hPUv u hu
    have hu0 : u ≠ 0 := by rintro rfl; rw [map_zero] at hv; exact zero_ne_one hv
    show V.valuation (u⁻¹ - 1) < 1
    have e : u⁻¹ - 1 = -((u - 1) * u⁻¹) := by
      rw [sub_mul, mul_inv_cancel₀ hu0, one_mul, neg_sub]
    rw [e, Valuation.map_neg, map_mul, map_inv₀, hv, inv_one, mul_one]; exact hu

  let Q : F → F → Prop := fun Y x => ∃ κ : K, κ ≠ 0 ∧ ∃ m : ℤ, ∃ U : F, PU U ∧
    x = algebraMap K F κ * Y ^ m * U
  have hQ1 : ∀ Y, Q Y 1 := fun Y => ⟨1, one_ne_zero, 0, 1, hPU1, by simp⟩
  have hQmul : ∀ Y, Y ≠ 0 → ∀ x y, Q Y x → Q Y y → Q Y (x * y) := by
    rintro Y hY x y ⟨κ₁, h₁, m₁, U₁, hU₁, rfl⟩ ⟨κ₂, h₂, m₂, U₂, hU₂, rfl⟩
    refine ⟨κ₁ * κ₂, mul_ne_zero h₁ h₂, m₁ + m₂, U₁ * U₂, hPUmul _ _ hU₁ hU₂, ?_⟩
    rw [map_mul, zpow_add₀ hY]; ring
  have hQinv : ∀ Y x, Q Y x → Q Y x⁻¹ := by
    rintro Y x ⟨κ, hκ, m, U, hU, rfl⟩
    refine ⟨κ⁻¹, inv_ne_zero hκ, -m, U⁻¹, hPUinv U hU, ?_⟩
    rw [mul_inv, mul_inv, map_inv₀, zpow_neg]
  have hQzpow : ∀ Y, Y ≠ 0 → ∀ x, Q Y x → ∀ e : ℤ, Q Y (x ^ e) := by
    intro Y hY x hx e
    have hpow : ∀ k : ℕ, Q Y (x ^ k) := by
      intro k
      induction k with
      | zero => rw [pow_zero]; exact hQ1 Y
      | succ k ih => rw [pow_succ]; exact hQmul Y hY _ _ ih hx
    cases e with
    | ofNat k => rw [Int.ofNat_eq_coe, zpow_natCast]; exact hpow k
    | negSucc k => rw [zpow_negSucc]; exact hQinv _ _ (hpow (k + 1))
  have hQprod : ∀ Y, Y ≠ 0 → ∀ (n : ℕ) (g : Fin n → F) (e : Fin n → ℤ),
      (∀ i, Q Y (g i)) → Q Y (∏ i, g i ^ e i) := by
    intro Y hY n g e hg
    exact Finset.prod_induction _ (Q Y) (hQmul Y hY) (hQ1 Y)
      (fun i _ => hQzpow Y hY _ (hg i) (e i))

  have hA : ∀ (Y X : F) (d : K), V.valuation X < V.valuation (algebraMap K F d) →
      Q Y (X + algebraMap K F d) := by
    intro Y X d hlt
    have hD0 : algebraMap K F d ≠ 0 := by
      intro h; rw [h, map_zero] at hlt; exact not_lt.mpr zero_le' hlt
    have hd0 : d ≠ 0 := by rintro rfl; exact hD0 (map_zero _)
    refine ⟨d, hd0, 0, 1 + X / algebraMap K F d, ?_, ?_⟩
    · show V.valuation (1 + X / algebraMap K F d - 1) < 1
      rw [add_sub_cancel_left, map_div₀]
      exact (div_lt_one₀ (lt_of_le_of_lt zero_le' hlt)).mpr hlt
    · rw [zpow_zero, mul_one, mul_add, mul_one, mul_comm (algebraMap K F d) (X / _),
        div_mul_cancel₀ _ hD0, add_comm]

  have hB : ∀ (X : F) (d : K), X ≠ 0 → V.valuation (algebraMap K F d) < V.valuation X →
      Q X (X + algebraMap K F d) := by
    intro X d hX hlt
    refine ⟨1, one_ne_zero, 1, 1 + algebraMap K F d / X, ?_, ?_⟩
    · show V.valuation (1 + algebraMap K F d / X - 1) < 1
      rw [add_sub_cancel_left, map_div₀]
      exact (div_lt_one₀ (lt_of_le_of_lt zero_le' hlt)).mpr hlt
    · rw [map_one, one_mul, zpow_one, mul_add, mul_one, mul_comm X (algebraMap K F d / X),
        div_mul_cancel₀ _ hX]

  have hclose : ∀ (r : V) (κ : K) (U : F), PU U → (r : F) = algebraMap K F κ * U →
      IsLocalRing.residue V r ∈ L := by
    intro r κ U hU hr
    have hUv := hPUv U hU
    have hκv : V.valuation (algebraMap K F κ) ≤ 1 := by
      have h := (V.valuation_le_one_iff _).mpr r.2
      rwa [hr, map_mul, hUv, mul_one] at h
    have hκV : algebraMap K F κ ∈ V := (V.valuation_le_one_iff _).mp hκv
    have hdiff : r - ⟨algebraMap K F κ, hκV⟩ ∈ IsLocalRing.maximalIdeal V := by
      rw [V.valuation_lt_one_iff]
      have e : ((r - ⟨algebraMap K F κ, hκV⟩ : V) : F) = algebraMap K F κ * (U - 1) := by
        show (r : F) - algebraMap K F κ = _
        rw [hr]; ring
      rw [e, map_mul]
      exact lt_of_le_of_lt (mul_le_of_le_one_left' hκv) hU
    have hres : IsLocalRing.residue V r = IsLocalRing.residue V ⟨algebraMap K F κ, hκV⟩ := by
      rw [← sub_eq_zero, ← map_sub, IsLocalRing.residue_eq_zero_iff]; exact hdiff
    rw [hres]
    exact Subfield.subset_closure ⟨κ, hκV, rfl⟩

  obtain ⟨r, rfl⟩ := IsLocalRing.residue_surjective w
  rcases V.valuation_lt_one_or_eq_one r with hlt | hr1
  · have h0 : IsLocalRing.residue V r = 0 :=
      (IsLocalRing.residue_eq_zero_iff r).mpr ((V.valuation_lt_one_iff r).mpr hlt)
    rw [h0]; exact L.zero_mem
  have hr0 : (r : F) ≠ 0 := by intro h; rw [h, map_zero] at hr1; exact zero_ne_one hr1
  obtain ⟨n, c, a, e, hc, hf⟩ := hfac r hr0
  by_cases hmin : ∃ a₀ : K, ∀ a : K,
      V.valuation (t₀ - algebraMap K F a₀) ≤ V.valuation (t₀ - algebraMap K F a)
  ·
    obtain ⟨as, has⟩ := hmin
    have hX0 : t₀ - algebraMap K F as ≠ 0 := hlin0 as
    have hnoX : ∀ b : K, b ≠ 0 →
        V.valuation (t₀ - algebraMap K F as) ≠ V.valuation (algebraMap K F b) :=
      fun b hb heq => hno ⟨as, b, hb, has, heq⟩
    have hfacQ : ∀ i, Q (t₀ - algebraMap K F as) (t₀ - algebraMap K F (a i)) := by
      intro i
      have e1 : t₀ - algebraMap K F (a i) =
          (t₀ - algebraMap K F as) + algebraMap K F (as - a i) := by
        rw [map_sub]; ring
      rw [e1]
      rcases lt_trichotomy (V.valuation (t₀ - algebraMap K F as))
          (V.valuation (algebraMap K F (as - a i))) with h | h | h
      · exact hA _ _ _ h
      · exfalso
        by_cases hd : as - a i = 0
        · rw [hd, map_zero, map_zero] at h
          exact hX0 ((Valuation.zero_iff _).mp h)
        · exact hnoX _ hd h
      · exact hB _ _ hX0 h
    obtain ⟨κ, hκ, m, U, hU, hprod⟩ := hQprod _ hX0 n _ e hfacQ
    have hr : (r : F) = algebraMap K F (c * κ) * (t₀ - algebraMap K F as) ^ m * U := by
      rw [hf, hprod, map_mul]; ring
    have hcκ : c * κ ≠ 0 := mul_ne_zero hc hκ
    have hm : m = 0 := by
      by_contra hm0
      have hval : V.valuation (algebraMap K F (c * κ)) *
          V.valuation (t₀ - algebraMap K F as) ^ m = 1 := by
        have h := congrArg V.valuation hr
        rw [map_mul, map_mul, hPUv U hU, mul_one, map_zpow₀, hr1] at h
        exact h.symm
      obtain ⟨N, hN | hN⟩ := Int.eq_nat_or_neg m
      · have hNpos : N ≠ 0 := by rintro rfl; exact hm0 (by simp [hN])
        obtain ⟨b, hb⟩ := IsAlgClosed.exists_pow_nat_eq (c * κ)⁻¹ (Nat.pos_of_ne_zero hNpos)
        have hb0 : b ≠ 0 := by
          rintro rfl; rw [zero_pow hNpos] at hb; exact inv_ne_zero hcκ hb.symm
        apply hnoX b hb0
        have h1 : V.valuation (algebraMap K F b) ^ N =
            (V.valuation (algebraMap K F (c * κ)))⁻¹ := by
          rw [← Valuation.map_pow, ← map_pow, hb, map_inv₀, map_inv₀]
        have h2 : V.valuation (t₀ - algebraMap K F as) ^ N =
            (V.valuation (algebraMap K F (c * κ)))⁻¹ := by
          rw [hN, zpow_natCast] at hval
          exact eq_inv_of_mul_eq_one_left (by rw [mul_comm]; exact hval)
        exact (pow_left_inj₀ zero_le' zero_le' hNpos).mp (h2.trans h1.symm)
      · have hNpos : N ≠ 0 := by rintro rfl; exact hm0 (by simp [hN])
        obtain ⟨b, hb⟩ := IsAlgClosed.exists_pow_nat_eq (c * κ) (Nat.pos_of_ne_zero hNpos)
        have hb0 : b ≠ 0 := by
          rintro rfl; rw [zero_pow hNpos] at hb; exact hcκ hb.symm
        apply hnoX b hb0
        have h1 : V.valuation (algebraMap K F b) ^ N =
            V.valuation (algebraMap K F (c * κ)) := by
          rw [← Valuation.map_pow, ← map_pow, hb]
        have h2 : V.valuation (t₀ - algebraMap K F as) ^ N =
            V.valuation (algebraMap K F (c * κ)) := by
          rw [hN, zpow_neg, zpow_natCast] at hval
          have hne : V.valuation (t₀ - algebraMap K F as) ^ N ≠ 0 :=
            pow_ne_zero _ ((Valuation.ne_zero_iff _).mpr hX0)
          exact ((mul_inv_eq_one₀ hne).mp hval).symm
        exact (pow_left_inj₀ zero_le' zero_le' hNpos).mp (h2.trans h1.symm)
    rw [hm, zpow_zero, mul_one] at hr
    exact hclose r (c * κ) U hU hr
  ·
    push_neg at hmin
    have hbetter : ∃ as : K, ∀ i, V.valuation (t₀ - algebraMap K F as) <
        V.valuation (t₀ - algebraMap K F (a i)) := by
      rcases Nat.eq_zero_or_pos n with hn | hn
      · subst hn; exact ⟨0, fun i => i.elim0⟩
      · obtain ⟨i₀, -, hi₀⟩ := Finset.exists_min_image Finset.univ
          (fun i => V.valuation (t₀ - algebraMap K F (a i)))
          (⟨⟨0, hn⟩, Finset.mem_univ _⟩ : (Finset.univ : Finset (Fin n)).Nonempty)
        obtain ⟨a', ha'⟩ := hmin (a i₀)
        exact ⟨a', fun i => lt_of_lt_of_le ha' (hi₀ i (Finset.mem_univ i))⟩
    obtain ⟨as, has⟩ := hbetter
    have hfacQ : ∀ i, Q 1 (t₀ - algebraMap K F (a i)) := by
      intro i
      have e1 : t₀ - algebraMap K F (a i) =
          (t₀ - algebraMap K F as) + algebraMap K F (as - a i) := by
        rw [map_sub]; ring
      have hi := has i
      rw [e1] at hi ⊢
      apply hA 1 (t₀ - algebraMap K F as)
      by_contra hle
      push_neg at hle
      have h := Valuation.map_add V.valuation (t₀ - algebraMap K F as) (algebraMap K F (as - a i))
      rw [max_eq_left hle] at h
      exact lt_irrefl _ (lt_of_lt_of_le hi h)
    obtain ⟨κ, hκ, m, U, hU, hprod⟩ := hQprod 1 one_ne_zero n _ e hfacQ
    have hr : (r : F) = algebraMap K F (c * κ) * U := by
      rw [hf, hprod, map_mul, one_zpow]; ring
    exact hclose r (c * κ) U hU hr

theorem cp1rr_luroth_transport : ∀ (κ M N : Type u) [Field κ] [Field M] [Algebra κ M] [Field N] (ψ : M →+* N) (s : N), (∃ x : M, Transcendental κ x) → (∀ m : M, ψ m ∈ Subfield.closure (insert s (Set.range (ψ.comp (algebraMap κ M))))) → ∃ t : M, IntermediateField.adjoin κ {t} = ⊤ :=
by
  intro κ M N _ _ _ _ ψ s ⟨x, hx⟩ hψ
  letI : Algebra κ N := (ψ.comp (algebraMap κ M)).toAlgebra
  let ψ' : M →ₐ[κ] N := { ψ with commutes' := fun r => rfl }
  have hinj : Function.Injective ψ' := ψ.injective
  set S : IntermediateField κ N := IntermediateField.adjoin κ ({s} : Set N) with hSdef
  have h3 : ∀ m, ψ' m ∈ S := by
    intro m
    rw [← IntermediateField.mem_toSubfield, hSdef, IntermediateField.adjoin_toSubfield,
      Set.union_singleton]
    exact hψ m
  have hs : Transcendental κ s := by
    intro halg
    haveI : Algebra.IsAlgebraic κ S :=
      IntermediateField.isAlgebraic_adjoin_simple halg.isIntegral
    have hy : IsAlgebraic κ (⟨ψ' x, h3 x⟩ : S) := Algebra.IsAlgebraic.isAlgebraic _
    have hy' : IsAlgebraic κ (ψ' x) := IntermediateField.isAlgebraic_iff.mp hy
    exact hx ((isAlgebraic_algHom_iff ψ' hinj).mp hy')
  let ε : RatFunc κ ≃ₐ[κ] S := RatFunc.algEquivOfTranscendental s hs
  let ψS : M →ₐ[κ] S := ψ'.codRestrict S.toSubalgebra h3
  let χ : M →ₐ[κ] RatFunc κ := ε.symm.toAlgHom.comp ψS
  set G := RatFunc.Luroth.generator χ.fieldRange with hGdef
  have hG : χ.fieldRange = IntermediateField.adjoin κ {G} := RatFunc.Luroth.eq_adjoin_generator
  obtain ⟨t, ht⟩ := (AlgHom.mem_fieldRange (f := χ)).mp (RatFunc.Luroth.generator_mem (E := χ.fieldRange))
  refine ⟨t, IntermediateField.map_injective χ ?_⟩
  rw [IntermediateField.adjoin_map, Set.image_singleton, ht, ← hG, AlgHom.fieldRange_eq_map]

theorem wcpa_dj_lus_cvs_ct_cp1_rational_residue : ∀ (K : Type u) [Field K] [IsAlgClosed K] (R : ValuationSubring K), IsAlgClosed (IsLocalRing.ResidueField ↥R) → ∀ (Y : Scheme.{u}) (v : Y ⟶ Spec (.of ↥R)), wcpaDjSemistable v → ∀ E ∈ irreducibleComponents ↥(Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K)))), (∃ (Er : Scheme.{u}) (ι : Er ⟶ Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K)))) (θ : Er ≅ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K) MvPolynomial.gradedAlgebra), IsClosedImmersion ι ∧ IsReduced Er ∧ Set.range ι = E ∧ θ.hom ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K) MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin 2) K 0))) = ι ≫ Limits.pullback.snd v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K)))) → ∀ D ∈ irreducibleComponents ↥(Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R))))), (Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R))))) '' D ⊆ closure ((Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K)))) '' E) → ∀ (ξ : ↥(Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R)))))), closure {ξ} = D → ∀ [Algebra (IsLocalRing.ResidueField ↥R) ((Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R))))).residueField ξ)], algebraMap (IsLocalRing.ResidueField ↥R) ((Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R))))).residueField ξ) = wcpaDjFK (IsLocalRing.ResidueField ↥R) (Limits.pullback.snd v (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R))))) ξ → ∃ t : (Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R))))).residueField ξ, IntermediateField.adjoin (IsLocalRing.ResidueField ↥R) {t} = ⊤ :=
by
  intro K _ _ R hκ Y v hss E hE hP1E D hD hsub ξ hξD _ hA

  have hssq : wcpaDjSemistable (Limits.pullback.snd v
      (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R))))) :=
    wcpa_dj_mm_semistable_basechange _ _ _ _ v hss
  have hξ : closure {ξ} ∈ irreducibleComponents ↥(Limits.pullback v
      (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R))))) := by
    rw [hξD]; exact hD
  have hff := wcpa_dj_cdp_residue_ff1 (IsLocalRing.ResidueField ↥R) _ _ hssq ξ hξ hA
  unfold wcpaDjFF1 at hff
  obtain ⟨x, hx, -⟩ := hff

  obtain ⟨z, hzE⟩ : ∃ z, closure {z} = E := by
    refine ⟨hE.1.genericPoint, ?_⟩
    have h1 := hE.1.isGenericPoint_genericPoint_closure
    rw [(isClosed_of_mem_irreducibleComponents E hE).closure_eq] at h1
    exact h1
  have hgy : Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K))) z ⤳
      Limits.pullback.fst v (Spec.map (CommRingCat.ofHom
        (algebraMap ↥R (IsLocalRing.ResidueField ↥R)))) ξ := by
    rw [specializes_iff_mem_closure]
    have hξmem : ξ ∈ D := by rw [← hξD]; exact subset_closure (Set.mem_singleton ξ)
    have h1 := hsub ⟨ξ, hξmem, rfl⟩
    refine closure_minimal ?_ isClosed_closure h1
    rw [← hzE]
    refine (image_closure_subset_closure_image
      (Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K)))).continuous).trans ?_
    rw [Set.image_singleton]

  obtain ⟨φ, t₀, hφR, htr, hadj⟩ :=
    cp1rr_generic_rational K R Y v (cp1rr_proj_generic_rational K) E hP1E z hzE

  obtain ⟨V, ψ, hψ⟩ := cp1rr_special_valuation K R Y v _ ξ hgy
  letI := φ.toAlgebra

  have hfac := cp1rr_linear_factorization K _ t₀ hadj
  have hres : ∃ s : IsLocalRing.ResidueField ↥V, ∀ w : IsLocalRing.ResidueField ↥V,
      w ∈ Subfield.closure (insert s {w' | ∃ (x : K) (hx : algebraMap K
        (Y.residueField (Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K))) z))
          x ∈ V), w' = IsLocalRing.residue ↥V ⟨algebraMap K _ x, hx⟩}) := by
    by_cases hc : ∃ a₀ b : K, b ≠ 0 ∧ (∀ a : K, V.valuation (t₀ - algebraMap K _ a₀) ≤
        V.valuation (t₀ - algebraMap K _ a)) ∧
        V.valuation (t₀ - algebraMap K _ a₀) = V.valuation (algebraMap K _ b)
    · obtain ⟨a₀, b, hb, hmin, hval⟩ := hc
      exact cp1rr_ruled_residue_attained K _ t₀ htr hfac V a₀ b hb hmin hval
    · exact ⟨0, fun w => Subfield.closure_mono (Set.subset_insert _ _)
        (cp1rr_ruled_residue_unattained K _ t₀ htr hfac V hc w)⟩
  obtain ⟨s, hs⟩ := hres

  have hKSET : {w' | ∃ (x : K) (hx : algebraMap K
        (Y.residueField (Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K))) z))
          x ∈ V), w' = IsLocalRing.residue ↥V ⟨algebraMap K _ x, hx⟩} ⊆
      Set.range (ψ.comp (algebraMap (IsLocalRing.ResidueField ↥R) _)) := by
    rintro w' ⟨x', hx', rfl⟩
    have hx'R : x' ∈ R := by
      by_contra hn
      have hinv : x'⁻¹ ∈ R := (R.mem_or_inv_mem x').resolve_left hn
      have hm : (⟨x'⁻¹, hinv⟩ : R) ∈ IsLocalRing.maximalIdeal R := by
        rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
        rintro ⟨u, hu⟩
        apply hn
        have h1 : ((u⁻¹ : Rˣ) : R) * (u : R) = 1 := u.inv_mul
        rw [hu] at h1
        have h2 : ((((u⁻¹ : Rˣ) : R)) : K) * x'⁻¹ = 1 := by
          have := congrArg Subtype.val h1
          simpa using this
        have hx0 : x' ≠ 0 := by
          rintro rfl
          simp at h2
        have h3 : (((u⁻¹ : Rˣ) : R) : K) = x' := by
          field_simp at h2
          exact h2
        rw [← h3]
        exact SetLike.coe_mem _
      obtain ⟨h, hψr⟩ := hψ ⟨x'⁻¹, hinv⟩
      rw [(IsLocalRing.residue_eq_zero_iff _).mpr hm, map_zero, map_zero] at hψr
      have hmV := (IsLocalRing.residue_eq_zero_iff _).mp hψr.symm
      have hφinv : φ x'⁻¹ = ((Scheme.ΓSpecIso (.of ↥R)).inv ≫ v.appTop ≫
          Y.presheaf.germ ⊤ (Limits.pullback.fst v (Spec.map (CommRingCat.ofHom
            (algebraMap ↥R K))) z) trivial ≫ Y.residue (Limits.pullback.fst v (Spec.map
              (CommRingCat.ofHom (algebraMap ↥R K))) z)).hom ⟨x'⁻¹, hinv⟩ := hφR ⟨x'⁻¹, hinv⟩
      have hx0 : x' ≠ 0 := by rintro rfl; exact hn R.zero_mem
      have hunit : IsUnit (⟨_, h⟩ : V) := by
        refine isUnit_iff_exists_inv.mpr ⟨(⟨φ x', hx'⟩ : V), ?_⟩
        have hprod : φ x'⁻¹ * φ x' = 1 := by
          rw [← map_mul, inv_mul_cancel₀ hx0, map_one]
        rw [hφinv] at hprod
        exact Subtype.ext hprod
      exact hmV hunit
    obtain ⟨h, hψr⟩ := hψ ⟨x', hx'R⟩
    refine ⟨IsLocalRing.residue R ⟨x', hx'R⟩, ?_⟩
    rw [RingHom.comp_apply, hA, hψr]
    congr 1
    apply Subtype.ext
    exact (hφR ⟨x', hx'R⟩).symm

  refine cp1rr_luroth_transport (IsLocalRing.ResidueField ↥R) _ _ ψ s ⟨x, hx⟩ ?_
  intro m
  exact Subfield.closure_mono (Set.insert_subset_insert hKSET) (hs (ψ m))

