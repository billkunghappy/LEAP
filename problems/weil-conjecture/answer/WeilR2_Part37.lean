  obtain ⟨n, f, hf⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp hFT
  obtain ⟨F, hFC, hFX⟩ : ∃ F : MvPolynomial (Fin n) Ω →+* wcGubGen W A,
      (∀ a : Ω, F (MvPolynomial.C a) = θ a) ∧
      ∀ i, F (MvPolynomial.X i) = algebraMap A (wcGubGen W A) (f (MvPolynomial.X i)) :=
    ⟨MvPolynomial.eval₂Hom θ (fun i => algebraMap A (wcGubGen W A) (f (MvPolynomial.X i))),
      fun a => MvPolynomial.eval₂Hom_C _ _ _, fun i => MvPolynomial.eval₂Hom_X' _ _ _⟩
  have hFmap : ∀ P : MvPolynomial (Fin n) ↥W,
      F (MvPolynomial.map (algebraMap ↥W Ω) P) = algebraMap A (wcGubGen W A) (f P) := by
    have hcomp : F.comp (MvPolynomial.map (algebraMap ↥W Ω)) =
        (algebraMap A (wcGubGen W A)).comp (f : MvPolynomial (Fin n) ↥W →+* A) := by
      apply MvPolynomial.ringHom_ext
      · intro r
        rw [RingHom.comp_apply, RingHom.comp_apply, MvPolynomial.map_C, hFC]
        show θ (r : Ω) = algebraMap A (wcGubGen W A) (f (MvPolynomial.C r))
        rw [hθ, MvPolynomial.algHom_C]
      · intro i
        rw [RingHom.comp_apply, RingHom.comp_apply, MvPolynomial.map_X, hFX]
        rfl
    intro P
    exact RingHom.congr_fun hcomp P
  have hFsurj : Function.Surjective F := by
    intro x
    obtain ⟨⟨a, s⟩, rfl⟩ :=
      IsLocalization.mk'_surjective (Submonoid.map (algebraMap ↥W A) (nonZeroDivisors ↥W)) x
    obtain ⟨w, hw, hws⟩ := Submonoid.mem_map.mp s.2
    obtain ⟨P, rfl⟩ := hf a
    have hw0 : (w : Ω) ≠ 0 := by
      intro h
      exact nonZeroDivisors.ne_zero hw (Subtype.ext h)
    refine ⟨MvPolynomial.map (algebraMap ↥W Ω) P * MvPolynomial.C ((w : Ω)⁻¹), ?_⟩
    rw [map_mul, hFmap, hFC]
    show _ = IsLocalization.mk' (wcGubGen W A) (f P) s
    rw [IsLocalization.mk'_eq_mul_mk'_one]
    congr 1
    have hu : IsUnit (algebraMap A (wcGubGen W A) (s : A)) := IsLocalization.map_units _ s
    apply hu.mul_left_inj.mp
    rw [IsLocalization.mk'_spec, map_one, ← hws, ← hθ, ← map_mul, inv_mul_cancel₀ hw0, map_one]
  refine ⟨isNoetherianRing_of_surjective _ _ F hFsurj, ?_⟩

  intro 𝔫 h𝔫
  haveI := h𝔫
  letI : Field (wcGubGen W A ⧸ 𝔫) := Ideal.Quotient.field 𝔫
  letI : Algebra Ω (wcGubGen W A ⧸ 𝔫) :=
    ((Ideal.Quotient.mk 𝔫).comp (F.comp MvPolynomial.C)).toAlgebra
  let Φ : MvPolynomial (Fin n) Ω →ₐ[Ω] (wcGubGen W A ⧸ 𝔫) :=
    { toRingHom := (Ideal.Quotient.mk 𝔫).comp F
      commutes' := fun a => by
        rw [MvPolynomial.algebraMap_eq]
        rfl }
  have hΦ : Function.Surjective Φ := by
    intro z
    obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective z
    obtain ⟨q, rfl⟩ := hFsurj p
    exact ⟨q, rfl⟩
  haveI : Algebra.FiniteType Ω (wcGubGen W A ⧸ 𝔫) := Algebra.FiniteType.of_surjective Φ hΦ
  haveI : Module.Finite Ω (wcGubGen W A ⧸ 𝔫) :=
    finite_of_finite_type_of_isJacobsonRing Ω (wcGubGen W A ⧸ 𝔫)
  haveI : Algebra.IsIntegral Ω (wcGubGen W A ⧸ 𝔫) := Algebra.IsIntegral.of_finite Ω _
  have hbij : Function.Bijective (algebraMap Ω (wcGubGen W A ⧸ 𝔫)) :=
    IsAlgClosed.algebraMap_bijective_of_isIntegral
  let e : Ω ≃+* (wcGubGen W A ⧸ 𝔫) := RingEquiv.ofBijective (algebraMap Ω _) hbij
  refine ⟨(e.symm : (wcGubGen W A ⧸ 𝔫) →+* Ω).comp (Ideal.Quotient.mk 𝔫), ?_, ?_⟩
  · intro w
    rw [← hθ, ← hFC]
    show e.symm (e (w : Ω)) = (w : Ω)
    exact e.symm_apply_apply _
  · ext z
    rw [RingHom.mem_ker, RingHom.comp_apply]
    constructor
    · intro hz
      have h1 : Ideal.Quotient.mk 𝔫 z = 0 := by
        have := congrArg e hz
        rw [map_zero] at this
        simpa using this
      exact Ideal.Quotient.eq_zero_iff_mem.mp h1
    · intro hz
      rw [Ideal.Quotient.eq_zero_iff_mem.mpr hz, map_zero]

theorem wcpa_dj_lr1k_nsr_gub_ita_prime_power : ∀ (R : Type u) [CommRing R] [IsDomain R]
    [IsNoetherianRing R],
    ringKrullDim R ≤ ((1 : ℕ) : WithBot ℕ∞) → ∀ D : Ideal R, D ≠ ⊥ →
    ∃ (s : List (Ideal R)) (N : ℕ), (∀ 𝔫 ∈ s, 𝔫.IsMaximal ∧ D ≤ 𝔫) ∧ s.prod ^ N ≤ D :=
by
  intro R _ _ _ hdim D hD
  classical
  haveI : Ring.KrullDimLE 1 R := Ring.krullDimLE_iff.mpr hdim
  have hS := Ideal.finite_minimalPrimes_of_isNoetherianRing R D
  have hmem : ∀ 𝔫 ∈ hS.toFinset.toList, 𝔫 ∈ D.minimalPrimes := by
    intro 𝔫 h
    rwa [Finset.mem_toList, Set.Finite.mem_toFinset] at h
  have hlist : ∀ (l : List (Ideal R)) (p : Ideal R), p ∈ l → l.prod ≤ p := by
    intro l
    induction l with
    | nil => intro p hp; simp at hp
    | cons a t ih =>
      intro p hp
      rw [List.prod_cons]
      rcases List.mem_cons.mp hp with h | h
      · rw [h]; exact Ideal.mul_le_inf.trans inf_le_left
      · exact (Ideal.mul_le_inf.trans inf_le_right).trans (ih p h)
  have hle : hS.toFinset.toList.prod ≤ D.radical := by
    rw [← Ideal.sInf_minimalPrimes]
    apply le_sInf
    intro p hp
    apply hlist
    rw [Finset.mem_toList, Set.Finite.mem_toFinset]
    exact hp
  obtain ⟨N, hN⟩ := Ideal.exists_pow_le_of_le_radical_of_fg hle
    (Ideal.fg_of_isNoetherianRing _)
  refine ⟨hS.toFinset.toList, N, ?_, hN⟩
  intro 𝔫 h𝔫
  have hm := hmem 𝔫 h𝔫
  have hprime : 𝔫.IsPrime := hm.1.1
  have hD𝔫 : D ≤ 𝔫 := hm.1.2
  have hne : 𝔫 ≠ ⊥ := by
    intro h0
    apply hD
    rw [h0] at hD𝔫
    exact le_bot_iff.mp hD𝔫
  exact ⟨Ideal.IsPrime.isMaximal_of_ne_bot hprime hne, hD𝔫⟩

theorem wcpa_dj_lr1k_nsr_gub_itapb_germ_inj : ∀ (C N : Scheme.{u}) [AlgebraicGeometry.IsIntegral C]
    [AlgebraicGeometry.IsIntegral N] (t : C ⟶ N) [IsDominant t] (n : N)
    (h : t (genericPoint C) ⤳ n),
    Function.Injective (N.presheaf.stalkSpecializes h ≫ t.stalkMap (genericPoint C)).hom :=
by
  intro C N _ _ t _ n h
  rw [injective_iff_map_eq_zero]
  intro s hs
  obtain ⟨U, hn, a, rfl⟩ := TopCat.Presheaf.germ_exist N.presheaf s
  have hU : t (genericPoint C) ∈ U := h.mem_open U.isOpen hn
  have h1 : (C.presheaf.germ (t ⁻¹ᵁ U) (genericPoint C) hU).hom ((t.app U).hom a) = 0 := by
    rw [CommRingCat.comp_apply, TopCat.Presheaf.germ_stalkSpecializes_apply] at hs
    rw [← Scheme.Hom.germ_stalkMap_apply]
    exact hs
  have h2 : (t.app U).hom a = 0 :=
    germ_injective_of_isIntegral C (genericPoint C) hU (h1.trans (map_zero _).symm)
  have h3 : N.basicOpen a = ⊥ := by
    by_contra hne
    obtain ⟨c, hc⟩ := t.denseRange.exists_mem_open (N.basicOpen a).isOpen
      ((TopologicalSpace.Opens.ne_bot_iff_nonempty _).mp hne)
    have hc' : c ∈ t ⁻¹ᵁ N.basicOpen a := hc
    rw [Scheme.Hom.preimage_basicOpen, h2, Scheme.basicOpen_zero] at hc'
    exact hc'
  rw [(basicOpen_eq_bot_iff a).mp h3, map_zero]

theorem wcpa_dj_lr1k_nsr_gub_itapb_dvr_total : ∀ (R : Type u) [CommRing R] [IsDomain R]
    [IsNoetherianRing R] [IsIntegrallyClosed R],
    ringKrullDim R ≤ ((1 : ℕ) : WithBot ℕ∞) → ∀ 𝔫 : Ideal R, 𝔫.IsMaximal → 𝔫 ≠ ⊥ →
    ∀ p q : R, ∃ p' q' : R, q' ∉ 𝔫 ∧ (p * q' = p' * q ∨ q * q' = p' * p) :=
by
  intro R _ _ _ _ hdim 𝔫 h𝔫max h𝔫 p q
  classical
  haveI : 𝔫.IsPrime := h𝔫max.isPrime
  haveI hK : Ring.KrullDimLE 1 R := Ring.krullDimLE_iff.mpr (by exact_mod_cast hdim)
  have hmax : ∀ I : Ideal R, I ≠ ⊥ → I.IsPrime → I.IsMaximal :=
    Ring.krullDimLE_one_iff_of_isPrime_bot.mp hK
  haveI hD1 : Ring.DimensionLEOne R := ⟨fun {I} hI hIp => hmax I hI hIp⟩
  haveI hDed : IsDedekindDomain R :=
    (isDedekindDomain_iff R (FractionRing R)).mpr
      ⟨inferInstance, inferInstance, hD1,
        fun {x} hx => (isIntegrallyClosed_iff (FractionRing R)).mp inferInstance hx⟩
  haveI hDVR : IsDiscreteValuationRing (Localization.AtPrime 𝔫) :=
    IsLocalization.AtPrime.isDiscreteValuationRing_of_dedekind_domain R h𝔫
      (Localization.AtPrime 𝔫)
  obtain ⟨c, hc⟩ := ValuationRing.cond (algebraMap R (Localization.AtPrime 𝔫) p)
    (algebraMap R (Localization.AtPrime 𝔫) q)
  obtain ⟨⟨r, s⟩, hrs⟩ := IsLocalization.surj 𝔫.primeCompl c
  have hinj : Function.Injective (algebraMap R (Localization.AtPrime 𝔫)) :=
    IsLocalization.injective (Localization.AtPrime 𝔫) (Ideal.primeCompl_le_nonZeroDivisors 𝔫)
  simp only at hrs
  refine ⟨r, (s : R), s.2, ?_⟩
  rcases hc with hA | hB
  · right
    apply hinj
    rw [map_mul, map_mul, ← hA, mul_assoc, hrs, mul_comm]
  · left
    apply hinj
    rw [map_mul, map_mul, ← hB, mul_assoc, hrs, mul_comm]

theorem wcpa_dj_lr1k_nsr_gub_itapb_ratio_valuation : ∀ (R L Ω : Type u) [CommRing R] [Field L]
    [Field Ω] (ψ : R →+* L) (y : R →+* Ω),
    Function.Injective ψ → (∀ z : L, ∃ p q : R, ψ q ≠ 0 ∧ z * ψ q = ψ p) →
    (∀ p q : R, ∃ p' q' : R, y q' ≠ 0 ∧ (p * q' = p' * q ∨ q * q' = p' * p)) →
    ∃ (O : ValuationSubring L) (ev : ↥O →+* Ω),
      (∀ z : L, z ∈ O ↔ ∃ p q : R, y q ≠ 0 ∧ z * ψ q = ψ p) ∧
      (∀ (z : ↥O) (p q : R), y q ≠ 0 → (z : L) * ψ q = ψ p → ev z = y p * (y q)⁻¹) ∧
      (∀ z : ↥O, IsUnit z ↔ ev z ≠ 0) :=
by
  intro R L Ω _ _ _ ψ y hψ H2 H3
  classical
  let S : Subring L :=
    { carrier := {z | ∃ p q : R, y q ≠ 0 ∧ z * ψ q = ψ p}
      zero_mem' := ⟨0, 1, by simp, by simp⟩
      one_mem' := ⟨1, 1, by simp, by simp⟩
      add_mem' := by
        rintro a b ⟨p, q, hq, ha⟩ ⟨p', q', hq', hb⟩
        refine ⟨p * q' + p' * q, q * q', by rw [map_mul]; exact mul_ne_zero hq hq', ?_⟩
        rw [map_add, map_mul, map_mul, map_mul, ← ha, ← hb]; ring
      mul_mem' := by
        rintro a b ⟨p, q, hq, ha⟩ ⟨p', q', hq', hb⟩
        refine ⟨p * p', q * q', by rw [map_mul]; exact mul_ne_zero hq hq', ?_⟩
        rw [map_mul, map_mul, ← ha, ← hb]; ring
      neg_mem' := by
        rintro a ⟨p, q, hq, ha⟩
        exact ⟨-p, q, hq, by rw [map_neg, ← ha]; ring⟩ }
  have memS : ∀ z : L, z ∈ S ↔ ∃ p q : R, y q ≠ 0 ∧ z * ψ q = ψ p := fun z => Iff.rfl
  have hval : ∀ z : L, z ∈ S ∨ z⁻¹ ∈ S := by
    intro z
    by_cases hz : z = 0
    · left; rw [hz]; exact S.zero_mem
    obtain ⟨p₀, q₀, hq₀, h₀⟩ := H2 z
    obtain ⟨p', q', hq', h | h⟩ := H3 p₀ q₀
    · left
      refine (memS z).2 ⟨p', q', hq', ?_⟩
      have e := congrArg ψ h
      rw [map_mul, map_mul, ← h₀] at e
      apply mul_right_cancel₀ hq₀
      rw [← e]; ring
    · right
      refine (memS z⁻¹).2 ⟨p', q', hq', ?_⟩
      have e := congrArg ψ h
      rw [map_mul, map_mul, ← h₀] at e
      have e2 : ψ q' = z * ψ p' := by
        apply mul_left_cancel₀ hq₀
        rw [e]; ring
      rw [e2, ← mul_assoc, inv_mul_cancel₀ hz, one_mul]
  let O : ValuationSubring L := ValuationSubring.ofSubring S hval
  have memO : ∀ z : L, z ∈ O ↔ ∃ p q : R, y q ≠ 0 ∧ z * ψ q = ψ p := fun z => Iff.rfl
  have indep : ∀ (z : L) (p q p₁ q₁ : R), y q ≠ 0 → z * ψ q = ψ p → y q₁ ≠ 0 →
      z * ψ q₁ = ψ p₁ → y p * (y q)⁻¹ = y p₁ * (y q₁)⁻¹ := by
    intro z p q p₁ q₁ hq h hq₁ h₁
    have e : p * q₁ = p₁ * q := hψ (by rw [map_mul, map_mul, ← h, ← h₁]; ring)
    have e' := congrArg y e
    rw [map_mul, map_mul] at e'
    rw [← div_eq_mul_inv, ← div_eq_mul_inv, div_eq_div_iff hq hq₁]
    exact e'
  let wp : O → R := fun z => Classical.choose ((memO z).1 z.2)
  let wq : O → R := fun z => Classical.choose (Classical.choose_spec ((memO z).1 z.2))
  have wspec : ∀ z : O, y (wq z) ≠ 0 ∧ (z : L) * ψ (wq z) = ψ (wp z) := fun z =>
    Classical.choose_spec (Classical.choose_spec ((memO z).1 z.2))
  let evf : O → Ω := fun z => y (wp z) * (y (wq z))⁻¹
  have key : ∀ (z : O) (p q : R), y q ≠ 0 → (z : L) * ψ q = ψ p → evf z = y p * (y q)⁻¹ :=
    fun z p q hq h => indep z _ _ p q (wspec z).1 (wspec z).2 hq h
  have c1 : ((1 : O) : L) = 1 := rfl
  have c0 : ((0 : O) : L) = 0 := rfl
  have cmul : ∀ a b : O, ((a * b : O) : L) = a * b := fun _ _ => rfl
  have cadd : ∀ a b : O, ((a + b : O) : L) = a + b := fun _ _ => rfl
  let ev : O →+* Ω :=
    { toFun := evf
      map_one' := by
        show evf 1 = 1
        rw [key 1 1 1 (by simp) (by rw [c1, one_mul])]; simp
      map_mul' := by
        intro a b
        show evf (a * b) = evf a * evf b
        obtain ⟨ha1, ha2⟩ := wspec a
        obtain ⟨hb1, hb2⟩ := wspec b
        rw [key (a * b) (wp a * wp b) (wq a * wq b)
          (by rw [map_mul]; exact mul_ne_zero ha1 hb1)
          (by rw [map_mul, map_mul, ← ha2, ← hb2, cmul]; ring)]
        show y (wp a * wp b) * (y (wq a * wq b))⁻¹ =
          y (wp a) * (y (wq a))⁻¹ * (y (wp b) * (y (wq b))⁻¹)
        rw [map_mul, map_mul, mul_inv]; ring
      map_zero' := by
        show evf 0 = 0
        rw [key 0 0 1 (by simp) (by rw [c0, zero_mul, map_zero])]; simp
      map_add' := by
        intro a b
        show evf (a + b) = evf a + evf b
        obtain ⟨ha1, ha2⟩ := wspec a
        obtain ⟨hb1, hb2⟩ := wspec b
        rw [key (a + b) (wp a * wq b + wp b * wq a) (wq a * wq b)
          (by rw [map_mul]; exact mul_ne_zero ha1 hb1)
          (by rw [map_add, map_mul, map_mul, map_mul, ← ha2, ← hb2, cadd]; ring)]
        show y (wp a * wq b + wp b * wq a) * (y (wq a * wq b))⁻¹ =
          y (wp a) * (y (wq a))⁻¹ + y (wp b) * (y (wq b))⁻¹
        rw [map_add, map_mul, map_mul, map_mul]
        field_simp }
  refine ⟨O, ev, memO, fun z p q hq h => key z p q hq h, ?_⟩
  intro z
  constructor
  · intro hu
    exact (hu.map ev).ne_zero
  · intro hne
    obtain ⟨hq, h⟩ := wspec z
    have hk : ev z = y (wp z) * (y (wq z))⁻¹ := key z _ _ hq h
    have hyp : y (wp z) ≠ 0 := by
      intro h0; apply hne; rw [hk, h0, zero_mul]
    have hp0 : ψ (wp z) ≠ 0 := by
      intro h0
      apply hyp
      have : wp z = 0 := hψ (by rw [h0, map_zero])
      rw [this, map_zero]
    have hz0 : (z : L) ≠ 0 := by
      intro h0; apply hp0; rw [← h, h0, zero_mul]
    have hinv : (z : L)⁻¹ ∈ O := (memO _).2 ⟨wq z, wp z, hyp, by
      rw [← h, ← mul_assoc, inv_mul_cancel₀ hz0, one_mul]⟩
    refine isUnit_iff_exists_inv.mpr ⟨⟨(z : L)⁻¹, hinv⟩, ?_⟩
    apply Subtype.ext
    show (z : L) * (z : L)⁻¹ = 1
    exact mul_inv_cancel₀ hz0

theorem wcpa_dj_lr1k_nsr_gub_itapb_residue_cut : ∀ (L Ω : Type u) [Field L] [Field Ω]
    (O : ValuationSubring L) (ev : ↥O →+* Ω),
    (∀ z : ↥O, IsUnit z ↔ ev z ≠ 0) → ∀ W : ValuationSubring Ω,
    ∃ V : ValuationSubring L, ∀ f : L, f ∈ V ↔ ∃ h : f ∈ O, ev ⟨f, h⟩ ∈ W :=
by
  intro L Ω _ _ O ev hev W
  have key : ∀ (g : L) (hg : g ∈ O),
      ev ⟨g, hg⟩ ∈ W ∨ ∃ hg' : g⁻¹ ∈ O, ev ⟨g⁻¹, hg'⟩ ∈ W := by
    intro g hg
    by_cases hu : IsUnit (⟨g, hg⟩ : O)
    · obtain ⟨u, hu1⟩ := hu.exists_right_inv
      have hgu : g * (u : L) = 1 := by
        have h1 := congrArg (fun x : O => (x : L)) hu1
        exact h1
      have hinv : g⁻¹ = (u : L) := inv_eq_of_mul_eq_one_right hgu
      have hinvO : g⁻¹ ∈ O := hinv ▸ u.2
      have hsub : (⟨g⁻¹, hinvO⟩ : O) = u := Subtype.ext hinv
      have hev1 : ev ⟨g, hg⟩ * ev u = 1 := by rw [← map_mul, hu1, map_one]
      have hevinv : (ev ⟨g, hg⟩)⁻¹ = ev u := inv_eq_of_mul_eq_one_right hev1
      rcases W.mem_or_inv_mem (ev ⟨g, hg⟩) with h | h
      · exact Or.inl h
      · right
        refine ⟨hinvO, ?_⟩
        rw [hsub, ← hevinv]
        exact h
    · left
      have h0 : ev ⟨g, hg⟩ = 0 := by
        by_contra hne
        exact hu ((hev _).mpr hne)
      rw [h0]
      exact W.zero_mem
  let S : Subring L :=
    { carrier := {f | ∃ h : f ∈ O, ev ⟨f, h⟩ ∈ W}
      zero_mem' := ⟨O.zero_mem, by
        have e : (⟨0, O.zero_mem⟩ : O) = 0 := rfl
        rw [e, map_zero]; exact W.zero_mem⟩
      one_mem' := ⟨O.one_mem, by
        have e : (⟨1, O.one_mem⟩ : O) = 1 := rfl
        rw [e, map_one]; exact W.one_mem⟩
      add_mem' := by
        rintro a b ⟨ha, hwa⟩ ⟨hb, hwb⟩
        refine ⟨O.add_mem _ _ ha hb, ?_⟩
        have e : (⟨a + b, O.add_mem _ _ ha hb⟩ : O) = ⟨a, ha⟩ + ⟨b, hb⟩ := rfl
        rw [e, map_add]
        exact W.add_mem _ _ hwa hwb
      mul_mem' := by
        rintro a b ⟨ha, hwa⟩ ⟨hb, hwb⟩
        refine ⟨O.mul_mem _ _ ha hb, ?_⟩
        have e : (⟨a * b, O.mul_mem _ _ ha hb⟩ : O) = ⟨a, ha⟩ * ⟨b, hb⟩ := rfl
        rw [e, map_mul]
        exact W.mul_mem _ _ hwa hwb
      neg_mem' := by
        rintro a ⟨ha, hwa⟩
        refine ⟨O.neg_mem _ ha, ?_⟩
        have e : (⟨-a, O.neg_mem _ ha⟩ : O) = -⟨a, ha⟩ := rfl
        rw [e, map_neg]
        exact W.neg_mem _ hwa }
  have hS : ∀ f : L, f ∈ S ↔ ∃ h : f ∈ O, ev ⟨f, h⟩ ∈ W := fun f => Iff.rfl
