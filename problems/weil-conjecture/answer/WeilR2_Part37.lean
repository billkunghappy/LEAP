    rw [Algebra.smul_def, map_mul]

theorem wcpa_dj_lr1k_nsr_gub_bff_dc_ia_os_rb_conductor : ∀ (R S : Type u) [CommRing R]
    [CommRing S] [Algebra R S] [IsNoetherianRing R], Module.Finite R S → ∀ t : R,
    ∃ c : ℕ, ∀ x : S, (∃ n : ℕ, algebraMap R S t ^ n * x ∈ Set.range (algebraMap R S)) →
      (∃ y : S, x = algebraMap R S t ^ c * y) → x ∈ Set.range (algebraMap R S) :=
by
  intro R S _ _ _ _ hfin t
  haveI := hfin
  haveI hNoeth : IsNoetherian R S := isNoetherian_of_isNoetherianRing_of_finite R S
  let K : ℕ → Submodule R S := fun n =>
    { carrier := {y : S | ∃ r : R, algebraMap R S r = algebraMap R S t ^ n * y}
      add_mem' := by
        rintro a b ⟨r₁, h₁⟩ ⟨r₂, h₂⟩
        exact ⟨r₁ + r₂, by rw [map_add, h₁, h₂, mul_add]⟩
      zero_mem' := ⟨0, by simp⟩
      smul_mem' := by
        rintro a y ⟨r, h⟩
        refine ⟨a * r, ?_⟩
        rw [map_mul, h, Algebra.smul_def]
        ring }
  have hmem : ∀ n y, y ∈ K n ↔ ∃ r : R, algebraMap R S r = algebraMap R S t ^ n * y :=
    fun n y => Iff.rfl
  have hmono : Monotone K := by
    intro n m hnm y hy
    obtain ⟨r, h⟩ := (hmem n y).mp hy
    obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le hnm
    refine (hmem _ y).mpr ⟨t ^ k * r, ?_⟩
    rw [map_mul, map_pow, h, pow_add]
    ring
  obtain ⟨N, hNst⟩ :=
    (monotone_stabilizes_iff_noetherian (R := R) (M := S)).mpr hNoeth ⟨K, hmono⟩
  refine ⟨N, ?_⟩
  rintro x ⟨n, r, hr⟩ ⟨y, rfl⟩
  have hy : y ∈ K (N + n) := by
    refine (hmem _ y).mpr ⟨r, ?_⟩
    rw [hr, pow_add]
    ring
  have hKeq : K N = K (N + n) := hNst (N + n) (Nat.le_add_right N n)
  rw [← hKeq] at hy
  obtain ⟨r', hr'⟩ := (hmem N y).mp hy
  exact ⟨r', hr'⟩

theorem wcpa_dj_lr1k_nsr_gub_bff_dc_ia_os_rb_graded_prod : ∀ (R : Type u) [CommRing R]
    (J : Ideal R) (s : ℕ) (m : Fin s → ℕ) (y : (j : Fin s) → Fin (m j) → R),
    (∀ j i, y j i ∈ J ^ (i.1 + 1)) →
    ∃ z : Fin (∑ j, m j) → R, (∀ i, z i ∈ J ^ (i.1 + 1)) ∧
      ∀ X : R, X ^ (∑ j, m j) + ∑ i, z i * X ^ ((∑ j, m j) - 1 - i.1) =
        ∏ j, (X ^ m j + ∑ i, y j i * X ^ (m j - 1 - i.1)) :=
by
  classical
  intro R _ J s m y hy
  have gp_mul : ∀ (a b : ℕ) (P Q : Polynomial R),
      P.natDegree ≤ a → P.coeff a = 1 → (∀ k : ℕ, P.coeff k ∈ J ^ (a - k)) →
      Q.natDegree ≤ b → Q.coeff b = 1 → (∀ k : ℕ, Q.coeff k ∈ J ^ (b - k)) →
      (P * Q).natDegree ≤ a + b ∧ (P * Q).coeff (a + b) = 1 ∧
        ∀ k : ℕ, (P * Q).coeff k ∈ J ^ (a + b - k) := by
    intro a b P Q hPd hPc hPk hQd hQc hQk
    refine ⟨Polynomial.natDegree_mul_le_of_le hPd hQd, ?_, ?_⟩
    · rw [Polynomial.coeff_mul_add_eq_of_natDegree_le hPd hQd, hPc, hQc, one_mul]
    · intro k
      rw [Polynomial.coeff_mul]
      apply Ideal.sum_mem
      intro x hx
      rw [Finset.HasAntidiagonal.mem_antidiagonal] at hx
      have h1 := Ideal.mul_mem_mul (hPk x.1) (hQk x.2)
      rw [← pow_add] at h1
      exact Ideal.pow_le_pow_right (by omega) h1
  have gp_factor : ∀ (n : ℕ) (w : Fin n → R), (∀ i, w i ∈ J ^ (i.1 + 1)) →
      (Polynomial.X ^ n + ∑ i : Fin n,
        Polynomial.C (w i) * Polynomial.X ^ (n - 1 - i.1)).natDegree ≤ n ∧
      (Polynomial.X ^ n + ∑ i : Fin n,
        Polynomial.C (w i) * Polynomial.X ^ (n - 1 - i.1)).coeff n = 1 ∧
      ∀ k : ℕ, (Polynomial.X ^ n + ∑ i : Fin n,
        Polynomial.C (w i) * Polynomial.X ^ (n - 1 - i.1)).coeff k ∈ J ^ (n - k) := by
    intro n w hw
    refine ⟨?_, ?_, ?_⟩
    · apply Polynomial.natDegree_add_le_of_degree_le (Polynomial.natDegree_X_pow_le n)
      apply Polynomial.natDegree_sum_le_of_forall_le
      intro i _
      exact (Polynomial.natDegree_C_mul_X_pow_le (w i) _).trans (by omega)
    · rw [Polynomial.coeff_add, Polynomial.coeff_X_pow, Polynomial.finsetSum_coeff,
        Finset.sum_eq_zero]
      · simp
      · intro i _
        rw [Polynomial.coeff_C_mul_X_pow]
        have := i.2
        rw [if_neg (by omega)]
    · intro k
      rw [Polynomial.coeff_add, Polynomial.coeff_X_pow, Polynomial.finsetSum_coeff]
      apply Ideal.add_mem
      · split_ifs with h
        · simp [h]
        · exact zero_mem _
      · apply Ideal.sum_mem
        intro i _
        rw [Polynomial.coeff_C_mul_X_pow]
        split_ifs with h
        · have := i.2
          have e : n - k = i.1 + 1 := by omega
          rw [e]; exact hw i
        · exact zero_mem _
  have gp_eval : ∀ (M : ℕ) (P : Polynomial R),
      P.natDegree ≤ M → P.coeff M = 1 → (∀ k : ℕ, P.coeff k ∈ J ^ (M - k)) →
      ∃ z : Fin M → R, (∀ i, z i ∈ J ^ (i.1 + 1)) ∧
        ∀ X : R, X ^ M + ∑ i, z i * X ^ (M - 1 - i.1) = P.eval X := by
    intro M P hd hc hk
    refine ⟨fun i => P.coeff (M - 1 - i.1), ?_, ?_⟩
    · intro i
      have := i.2
      have e : i.1 + 1 = M - (M - 1 - i.1) := by omega
      show P.coeff (M - 1 - i.1) ∈ J ^ (i.1 + 1)
      rw [e]; exact hk _
    · intro X
      show X ^ M + ∑ i : Fin M, P.coeff (M - 1 - i.1) * X ^ (M - 1 - i.1) = P.eval X
      rw [Polynomial.eval_eq_sum_range' (n := M + 1) (by omega), Finset.sum_range_succ, hc,
        one_mul, ← Finset.sum_range_reflect (fun k => P.coeff k * X ^ k) M,
        Fin.sum_univ_eq_sum_range (fun k => P.coeff (M - 1 - k) * X ^ (M - 1 - k)) M]
      ring
  obtain ⟨Fac, hFac⟩ : ∃ Fac : Fin s → Polynomial R, ∀ j, Fac j =
      Polynomial.X ^ m j + ∑ i : Fin (m j),
        Polynomial.C (y j i) * Polynomial.X ^ (m j - 1 - i.1) := ⟨_, fun j => rfl⟩
  have hprod : ∀ t : Finset (Fin s),
      (∏ j ∈ t, Fac j).natDegree ≤ ∑ j ∈ t, m j ∧
      (∏ j ∈ t, Fac j).coeff (∑ j ∈ t, m j) = 1 ∧
      ∀ k, (∏ j ∈ t, Fac j).coeff k ∈ J ^ (∑ j ∈ t, m j - k) := by
    intro t
    induction t using Finset.induction_on with
    | empty =>
      rw [Finset.prod_empty, Finset.sum_empty]
      refine ⟨by simp, by simp, fun k => ?_⟩
      simp
    | insert a t hat ih =>
      rw [Finset.prod_insert hat, Finset.sum_insert hat]
      obtain ⟨h1, h2, h3⟩ := gp_factor (m a) (y a) (hy a)
      rw [← hFac a] at h1 h2 h3
      exact gp_mul _ _ _ _ h1 h2 h3 ih.1 ih.2.1 ih.2.2
  obtain ⟨h1, h2, h3⟩ := hprod Finset.univ
  obtain ⟨z, hz, hzX⟩ := gp_eval _ _ h1 h2 h3
  refine ⟨z, hz, fun X => ?_⟩
  rw [hzX, Polynomial.eval_prod]
  apply Finset.prod_congr rfl
  intro j _
  rw [hFac]
  simp only [Polynomial.eval_add, Polynomial.eval_pow, Polynomial.eval_X,
    Polynomial.eval_finsetSum, Polynomial.eval_mul, Polynomial.eval_C]

