    · intro y hy hyh heq
      rw [← hq] at heq
      have hyq : hV.primeIdealOf ⟨y, hy⟩ = q := by
        by_contra hne
        have hcomap : PrimeSpectrum.comap (algebraMap P Γ(Z, V)) (hV.primeIdealOf ⟨y, hy⟩) =
