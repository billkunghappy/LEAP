        ext m
        rw [MvPolynomial.coeff_map, MvPolynomial.coeff_C_mul, hQWc]
        split_ifs with hm
        · exact hc m
        · have hm0 : Q.coeff m = 0 := by
            by_contra h; exact hm (MvPolynomial.mem_support_iff.mpr h)
