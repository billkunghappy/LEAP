    ((γ ≫ ι).fromNormalization ≫ uX)
    (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))
    Ψ (𝟙 _) (𝟙 _) (by rw [Category.comp_id, ← Category.assoc, hΨν])
    (by rw [Category.comp_id, Category.id_comp])
  haveI : IsIso Φ := inferInstance
  have hΦp : Φ ≫ Limits.pullback.fst ((γ ≫ ι).fromNormalization ≫ uX)
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) =
      Limits.pullback.fst ((γ ≫ ι).fromNormalization ≫ uX)
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) ≫ Ψ :=
    Limits.pullback.lift_fst _ _ _
  haveI : IsClosedImmersion (Spec.map (CommRingCat.ofHom
      (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) :=
    IsClosedImmersion.spec_of_surjective _ IsLocalRing.residue_surjective
  have hpinj : Function.Injective (Limits.pullback.fst ((γ ≫ ι).fromNormalization ≫ uX)
