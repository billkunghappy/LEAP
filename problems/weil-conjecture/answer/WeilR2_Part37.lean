    have h2 := mul_left_cancel₀ (pow_ne_zero K hϖ0) h1
    exact (IsLocalRing.mem_maximalIdeal ϖ).mp hϖm (isUnit_iff_exists_inv.mpr ⟨_, h2.symm⟩)

  have s2 : ∀ (lam : Fin r → Ω),
      (∀ n : ℕ, n + 1 < r → (∏ j, (Polynomial.X - Polynomial.C (lam j))).coeff n = 0) →
      ∀ i k : Fin r, i ≠ k → lam i = lam k → lam i = 0 := by
    intro lam h i k hik he
    classical
    by_contra hl
    set P := ∏ j, (Polynomial.X - Polynomial.C (lam j)) with hP
    have hmon : P.Monic :=
      Polynomial.monic_prod_of_monic _ _ (fun j _ => Polynomial.monic_X_sub_C (lam j))
    have hdeg : P.natDegree = r := by
      rw [hP, Polynomial.natDegree_prod_of_monic _ _ (fun j _ => Polynomial.monic_X_sub_C (lam j))]
      simp
    have hr : 2 ≤ r := by
      have := i.isLt
      have := k.isLt
      have : i.val ≠ k.val := fun h => hik (Fin.ext h)
      omega
    have h1 : Polynomial.X ^ (r - 1) ∣ P := by
      rw [Polynomial.X_pow_dvd_iff]
      intro d hd
      exact h d (by omega)
    have h2 : (Polynomial.X - Polynomial.C (lam i)) ^ 2 ∣ P := by
      have hk : k ∈ Finset.univ.erase i := Finset.mem_erase.mpr ⟨hik.symm, Finset.mem_univ _⟩
      refine ⟨∏ j ∈ (Finset.univ.erase i).erase k, (Polynomial.X - Polynomial.C (lam j)), ?_⟩
      have e1 := Finset.mul_prod_erase Finset.univ (fun j => Polynomial.X - Polynomial.C (lam j))
        (Finset.mem_univ i)
      have e2 := Finset.mul_prod_erase (Finset.univ.erase i)
        (fun j => Polynomial.X - Polynomial.C (lam j)) hk
      rw [hP, ← e1, ← e2, he]
      ring
    have hcop : IsCoprime (Polynomial.X ^ (r - 1) : Polynomial Ω)
        ((Polynomial.X - Polynomial.C (lam i)) ^ 2) := by
      apply IsCoprime.pow
      have := Polynomial.isCoprime_X_sub_C_of_isUnit_sub (R := Ω) (a := 0) (b := lam i)
        (isUnit_iff_ne_zero.mpr (by simpa using hl))
      simpa using this
    have h3 := hcop.mul_dvd h1 h2
    have h4 := Polynomial.natDegree_le_of_dvd h3 hmon.ne_zero
    rw [Polynomial.natDegree_mul (pow_ne_zero _ Polynomial.X_ne_zero)
      (pow_ne_zero _ (Polynomial.X_sub_C_ne_zero _)), Polynomial.natDegree_X_pow,
      Polynomial.natDegree_pow, Polynomial.natDegree_X_sub_C, hdeg] at h4
    omega

  have s3 : ∀ (g h : A) (Q : Fin r → ↥W → Prop),
      (∀ l : Fin r, ∃ (w β : ↥W) (f : A), w ≠ 0 ∧ Q l β ∧
        algebraMap ↥W A w * (b l - algebraMap ↥W A β) * g = h * f) →
      ∃ (w₁ : ↥W) (β : Fin r → ↥W) (f : Fin r → A), w₁ ≠ 0 ∧ ∀ l : Fin r, Q l (β l) ∧
        algebraMap ↥W A w₁ * (b l - algebraMap ↥W A (β l)) * g = h * f l := by
    intro g h Q H
    choose w β f' hw hQ heq using H
    refine ⟨∏ l, w l, β, fun l => algebraMap ↥W A (∏ l' ∈ Finset.univ.erase l, w l') * f' l,
      Finset.prod_ne_zero_iff.mpr (fun l _ => hw l), fun l => ⟨hQ l, ?_⟩⟩
    have e := Finset.prod_erase_mul Finset.univ w (Finset.mem_univ l)
    rw [← e, map_mul]
    linear_combination (algebraMap ↥W A (∏ l' ∈ Finset.univ.erase l, w l')) * heq l

  have s4 : ∀ (β u : Fin r → ↥W) (n : ℕ), n + 1 < r →
      (Matrix.vecMulVec β u).charpoly.coeff n = 0 := by
    intro β u n hn
    rw [Matrix.charpoly_vecMulVec, Fintype.card_fin, Polynomial.coeff_sub, Polynomial.coeff_smul,
      Polynomial.coeff_X_pow, Polynomial.coeff_X_pow, if_neg (by omega), if_neg (by omega)]
    simp

  have s5 : ∀ (a : A) (β : Fin r → ↥W) (f : Fin r → A),
      (∀ l : Fin r, a * b l = algebraMap ↥W A (β l) * a + (η - algebraMap ↥W A t₀) * f l) →
      ∀ L : ℕ, ∃ (M : Matrix (Fin r) (Fin r) (Polynomial ↥W)) (u : Fin r → ↥W),
        (∀ i, a * b i - ∑ j, Polynomial.aeval η (M i j) * b j ∈
          Ideal.span {algebraMap ↥W A ϖ ^ L}) ∧
        M.map (Polynomial.evalRingHom t₀) = Matrix.vecMulVec β u := by
    intro a β f hab L
    obtain ⟨p, s, hps⟩ := hspan L a
    choose pp ss hpp using fun l => hspan L (f l)
    refine ⟨Matrix.of fun l j => Polynomial.C (β l) * p j + (Polynomial.X - Polynomial.C t₀) * pp l j,
      fun j => (p j).eval t₀, ?_, ?_⟩
    · intro l
      rw [Ideal.mem_span_singleton']
      refine ⟨algebraMap ↥W A (β l) * s + (η - algebraMap ↥W A t₀) * ss l, ?_⟩
      have hsum : ∑ j, Polynomial.aeval η ((Matrix.of fun l j => Polynomial.C (β l) * p j +
          (Polynomial.X - Polynomial.C t₀) * pp l j) l j) * b j =
          algebraMap ↥W A (β l) * ∑ j, Polynomial.aeval η (p j) * b j +
            (η - algebraMap ↥W A t₀) * ∑ j, Polynomial.aeval η (pp l j) * b j := by
        rw [Finset.mul_sum, Finset.mul_sum, ← Finset.sum_add_distrib]
        refine Finset.sum_congr rfl fun j _ => ?_
        simp only [Matrix.of_apply, map_add, map_mul, Polynomial.aeval_C, map_sub,
          Polynomial.aeval_X]
        ring
      linear_combination (-1 : A) * hab l + hsum - algebraMap ↥W A (β l) * hps -
        (η - algebraMap ↥W A t₀) * hpp l
    · ext l j
      simp [Matrix.vecMulVec_apply]

  intro i k hψ
  by_contra hne
  obtain ⟨hp1, hp2, hp3⟩ := hpts i
  obtain ⟨g, hg0, H⟩ := hRED (ψ i) hp1 hp2 hp3
  obtain ⟨w₁, β, f, hw₁, hQ⟩ := s3 g (η - algebraMap ↥W A t₀)
    (fun l β => (β : Ω) = ψ i (algebraMap A (wcGubGen W A) (b l))) (fun l => H (b l))
  set a := algebraMap ↥W A w₁ * g with ha
  have hab : ∀ l, a * b l = algebraMap ↥W A (β l) * a + (η - algebraMap ↥W A t₀) * f l := by
    intro l
    rw [ha]
    linear_combination (hQ l).2
  have hw₁' : (w₁ : Ω) ≠ 0 := by
    intro h
    apply hw₁
    exact_mod_cast h
  have hlam0 : ψ i (algebraMap A (wcGubGen W A) a) ≠ 0 := by
    rw [ha, map_mul, map_mul, hp1]
    exact mul_ne_zero hw₁' hg0
  have hcoef : ∀ n : ℕ, n + 1 < r →
      (∏ j, (Polynomial.X - Polynomial.C (ψ j (algebraMap A (wcGubGen W A) a)))).coeff n = 0 := by
    intro n hn
    have hall : ∀ L : ℕ, ∃ v : ↥W,
        (∏ j, (Polynomial.X - Polynomial.C (ψ j (algebraMap A (wcGubGen W A) a)))).coeff n =
          (ϖ : Ω) ^ L * (v : Ω) := by
      intro L
      obtain ⟨M, u, hM, hMe⟩ := s5 a β f hab L
      obtain ⟨u', hu'⟩ := hsplit a L M hM n
      rw [hMe, Polynomial.coeff_map, s4 β u n hn, map_zero, zero_sub] at hu'
      refine ⟨-u', ?_⟩
      push_cast
      linear_combination (-1 : Ω) * hu'
    obtain ⟨v0, hv0⟩ := hall 0
    have hv0' : v0 = 0 := by
      apply s1 v0
      intro L
      obtain ⟨v, hv⟩ := hall L
      refine ⟨v, Subtype.ext ?_⟩
      simp only [MulMemClass.coe_mul, SubmonoidClass.coe_pow]
      rw [← hv]
      simpa using hv0.symm
    simpa [hv0'] using hv0
  exact hlam0 (s2 (fun j => ψ j (algebraMap A (wcGubGen W A) a)) hcoef i k hne
    (by show ψ i (algebraMap A (wcGubGen W A) a) = ψ k (algebraMap A (wcGubGen W A) a); rw [hψ]))

theorem wcpa_dj_lr1k_nsr_gub_bff_dc_ia_pbc_sp_generic_red : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω) (A : Type u) [CommRing A] [Algebra ↥W A] (η : A),
    (∃ (n : ℕ) (a : A) (μ : Fin n → Polynomial ↥W) (c D : Polynomial ↥W)
        (U V : Polynomial (Polynomial ↥W)),
      a ^ n + ∑ i, Polynomial.aeval η (μ i) * a ^ (i : ℕ) = 0 ∧
      c ≠ 0 ∧ D ≠ 0 ∧
      (∀ x : A, ∃ (k : ℕ) (w : ↥W) (P : Fin n → Polynomial ↥W), w ≠ 0 ∧
        algebraMap ↥W A w * Polynomial.aeval η c ^ k * x =
          ∑ i, Polynomial.aeval η (P i) * a ^ (i : ℕ)) ∧
      U * (Polynomial.X ^ n + ∑ i, Polynomial.C (μ i) * Polynomial.X ^ (i : ℕ)) +
        V * Polynomial.derivative
          (Polynomial.X ^ n + ∑ i, Polynomial.C (μ i) * Polynomial.X ^ (i : ℕ)) =
        Polynomial.C D) →
    ∃ S : Finset Ω, ∀ t : ↥W, (t : Ω) ∉ S →
      ∀ χ : wcGubGen W A →+* Ω,
        (∀ w : ↥W, χ (algebraMap A (wcGubGen W A) (algebraMap ↥W A w)) = (w : Ω)) →
        (∀ a : A, χ (algebraMap A (wcGubGen W A) a) ∈ W) →
        χ (algebraMap A (wcGubGen W A) η) = (t : Ω) →
        ∃ g : A, χ (algebraMap A (wcGubGen W A) g) ≠ 0 ∧ ∀ a : A, ∃ (w β : ↥W) (f : A), w ≠ 0 ∧
          (β : Ω) = χ (algebraMap A (wcGubGen W A) a) ∧
          algebraMap ↥W A w * (a - algebraMap ↥W A β) * g = (η - algebraMap ↥W A t) * f :=
by
  intro Ω _ _ W A _ _ η hsep
  obtain ⟨n, θ, μ, c, D, U, V, hrel, hc, hD, hgen, hbez⟩ := hsep
  classical

  have s1 : ∀ (φ : A →+* Ω), (∀ w : ↥W, φ (algebraMap ↥W A w) = (w : Ω)) →
      ∀ (y : A) (s : ↥W), φ y = (s : Ω) → ∀ p : Polynomial ↥W,
        φ (Polynomial.aeval y p) = ((Polynomial.eval s p : ↥W) : Ω) := by
    intro φ hφ y s hy p
    rw [Polynomial.aeval_def, Polynomial.hom_eval₂]
    have hcomp : φ.comp (algebraMap ↥W A) = algebraMap ↥W Ω := RingHom.ext hφ
    rw [hcomp, hy]
    exact Polynomial.eval₂_at_apply (algebraMap ↥W Ω) s

  have s2 : ∀ (y : A) (s : ↥W) (p : Polynomial ↥W),
      Polynomial.aeval y p - algebraMap ↥W A (Polynomial.eval s p) ∈
        Ideal.span {y - algebraMap ↥W A s} := by
    intro y s p
    obtain ⟨q, hq⟩ := Polynomial.X_sub_C_dvd_sub_C_eval (a := s) (p := p)
    rw [Ideal.mem_span_singleton']
    refine ⟨Polynomial.aeval y q, ?_⟩
    have h := congrArg (Polynomial.aeval y) hq
    simp only [map_sub, map_mul, Polynomial.aeval_X, Polynomial.aeval_C] at h
    linear_combination -h

  refine ⟨((c * D).map (algebraMap ↥W Ω)).roots.toFinset, ?_⟩
  intro t ht χ h1 h2 h3
  obtain ⟨Φ, hΦdef⟩ : ∃ Φ : A →+* Ω, ∀ a, Φ a = χ (algebraMap A (wcGubGen W A) a) :=
    ⟨χ.comp (algebraMap A (wcGubGen W A)), fun _ => rfl⟩
  have hΦ1 : ∀ w : ↥W, Φ (algebraMap ↥W A w) = (w : Ω) := fun w => by rw [hΦdef]; exact h1 w
  have hΦ2 : ∀ a : A, Φ a ∈ W := fun a => by rw [hΦdef]; exact h2 a
  have hΦ3 : Φ η = (t : Ω) := by rw [hΦdef]; exact h3
  have hcD : c * D ≠ 0 := mul_ne_zero hc hD
  have hp0 : (c * D).map (algebraMap ↥W Ω) ≠ 0 := by
    rw [Ne, Polynomial.map_eq_zero_iff (f := algebraMap ↥W Ω) Subtype.val_injective]
    exact hcD
  have hctD : Polynomial.eval t c ≠ 0 ∧ Polynomial.eval t D ≠ 0 := by
    have hne : Polynomial.eval t (c * D) ≠ 0 := by
      intro h0
      apply ht
      rw [Multiset.mem_toFinset, Polynomial.mem_roots hp0, Polynomial.IsRoot.def,
        Polynomial.eval_map, show ((t : Ω)) = algebraMap ↥W Ω t from rfl,
        Polynomial.eval₂_at_apply, h0, map_zero]
    rw [Polynomial.eval_mul] at hne
    exact ⟨left_ne_zero_of_mul hne, right_ne_zero_of_mul hne⟩

  obtain ⟨F, hF⟩ : ∃ F : Polynomial (Polynomial ↥W),
      F = Polynomial.X ^ n + ∑ i, Polynomial.C (μ i) * Polynomial.X ^ (i : ℕ) := ⟨_, rfl⟩
  rw [← hF] at hbez
  obtain ⟨μt, hμt⟩ : ∃ q : Polynomial ↥W, q = F.map (Polynomial.evalRingHom t) := ⟨_, rfl⟩
  have hE0 : μt = Polynomial.X ^ n +
      ∑ i : Fin n, Polynomial.C (Polynomial.eval t (μ i)) * Polynomial.X ^ (i : ℕ) := by
    rw [hμt, hF]
    simp [Polynomial.map_sum]
  have hE0a : ∀ z : A, Polynomial.aeval z μt =
      z ^ n + ∑ i : Fin n, algebraMap ↥W A (Polynomial.eval t (μ i)) * z ^ (i : ℕ) := by
    intro z
    rw [hE0]
    simp only [map_add, map_sum, map_mul, map_pow, Polynomial.aeval_X, Polynomial.aeval_C]

  obtain ⟨α, hαc⟩ : ∃ α : ↥W, (α : Ω) = Φ θ := ⟨⟨Φ θ, hΦ2 θ⟩, rfl⟩
  have hΦη : ∀ p, Φ (Polynomial.aeval η p) = ((Polynomial.eval t p : ↥W) : Ω) :=
    s1 Φ hΦ1 η t hΦ3
  have hΦθ : ∀ p, Φ (Polynomial.aeval θ p) = ((Polynomial.eval α p : ↥W) : Ω) :=
    s1 Φ hΦ1 θ α hαc.symm
  have hA : Polynomial.eval α μt = 0 := by
    apply Subtype.ext
    rw [← hΦθ, hE0a]
    have h0 := congrArg Φ hrel
    simp only [map_add, map_sum, map_mul, map_pow, map_zero, hΦη] at h0
    simp only [map_add, map_sum, map_mul, map_pow, hΦ1, ZeroMemClass.coe_zero]
    exact h0

  have hB : Polynomial.eval α (Polynomial.derivative μt) ≠ 0 := by
    intro h0
    have e1 := congrArg (Polynomial.map (Polynomial.evalRingHom t)) hbez
    rw [Polynomial.map_add, Polynomial.map_mul, Polynomial.map_mul, Polynomial.map_C,
      ← Polynomial.derivative_map, ← hμt] at e1
    have e2 := congrArg (Polynomial.eval α) e1
    rw [Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_mul, Polynomial.eval_C, hA, h0,
      mul_zero, mul_zero, add_zero, Polynomial.coe_evalRingHom] at e2
    exact hctD.2 e2.symm

  obtain ⟨Q, hC1⟩ : ∃ Q : Polynomial ↥W, (Polynomial.X - Polynomial.C α) * Q = μt :=
    ⟨_, Polynomial.mul_divByMonic_eq_iff_isRoot.mpr hA⟩
  have hC2 : Polynomial.eval α Q = Polynomial.eval α (Polynomial.derivative μt) := by
    rw [← hC1]
    simp [Polynomial.derivative_mul]

  have hgne : Φ (Polynomial.aeval θ Q) ≠ 0 := by
    rw [hΦθ, hC2]
    intro h
    exact hB (by exact_mod_cast h)

  obtain ⟨I, hI⟩ : ∃ I : Ideal A, I = Ideal.span {η - algebraMap ↥W A t} := ⟨_, rfl⟩
  have hmk : ∀ p, Ideal.Quotient.mk I (Polynomial.aeval η p) =
      Ideal.Quotient.mk I (algebraMap ↥W A (Polynomial.eval t p)) := by
    intro p
    rw [Ideal.Quotient.eq, hI]
    exact s2 η t p
  have hE : Ideal.Quotient.mk I ((θ - algebraMap ↥W A α) * Polynomial.aeval θ Q) = 0 := by
    have e : (θ - algebraMap ↥W A α) * Polynomial.aeval θ Q = Polynomial.aeval θ μt := by
      rw [← hC1, map_mul, map_sub, Polynomial.aeval_X, Polynomial.aeval_C]
    rw [e, hE0a]
    have h0 := congrArg (Ideal.Quotient.mk I) hrel
    simp only [map_add, map_sum, map_mul, map_pow, map_zero, hmk] at h0 ⊢
    exact h0
  refine ⟨Polynomial.aeval θ Q, by rw [← hΦdef]; exact hgne, ?_⟩

  intro x
  obtain ⟨k, w, P, hw, hx⟩ := hgen x
  have hN : w * Polynomial.eval t c ^ k ≠ 0 := mul_ne_zero hw (pow_ne_zero _ hctD.1)
  obtain ⟨β, hβc⟩ : ∃ β : ↥W, (β : Ω) = Φ x := ⟨⟨Φ x, hΦ2 x⟩, rfl⟩
  obtain ⟨R, hR⟩ : ∃ R : Polynomial ↥W,
      R = ∑ i : Fin n, Polynomial.C (Polynomial.eval t (P i)) * Polynomial.X ^ (i : ℕ) :=
    ⟨_, rfl⟩
  have hRa : ∀ z : A, Polynomial.aeval z R =
      ∑ i : Fin n, algebraMap ↥W A (Polynomial.eval t (P i)) * z ^ (i : ℕ) := by
    intro z
    rw [hR]
    simp only [map_sum, map_mul, map_pow, Polynomial.aeval_X, Polynomial.aeval_C]
  have hF1 : Ideal.Quotient.mk I (algebraMap ↥W A (w * Polynomial.eval t c ^ k) * x) =
      Ideal.Quotient.mk I (Polynomial.aeval θ R) := by
    have h0 := congrArg (Ideal.Quotient.mk I) hx
    simp only [map_mul, map_pow, map_sum, hmk] at h0
    rw [hRa]
    simp only [map_mul, map_pow, map_sum]
    exact h0
  have hF2 : w * Polynomial.eval t c ^ k * β = Polynomial.eval α R := by
    apply Subtype.ext
    have h0 := congrArg Φ hx
    rw [← hΦθ, hRa]
    simp only [map_mul, map_pow, map_sum, hΦ1, hΦη] at h0 ⊢
    refine Eq.trans ?_ h0
    push_cast [hβc]
    rfl
  obtain ⟨R₁, hR₁⟩ := Polynomial.X_sub_C_dvd_sub_C_eval (a := α) (p := R)
  have hF3 : Polynomial.aeval θ R - algebraMap ↥W A (Polynomial.eval α R) =
      (θ - algebraMap ↥W A α) * Polynomial.aeval θ R₁ := by
    have h := congrArg (Polynomial.aeval θ) hR₁
    simpa only [map_sub, map_mul, Polynomial.aeval_X, Polynomial.aeval_C] using h
  have hmem : algebraMap ↥W A (w * Polynomial.eval t c ^ k) * (x - algebraMap ↥W A β) *
      Polynomial.aeval θ Q ∈ I := by
    rw [← Ideal.Quotient.eq_zero_iff_mem]
    have e2 : algebraMap ↥W A (w * Polynomial.eval t c ^ k) * algebraMap ↥W A β =
        algebraMap ↥W A (Polynomial.eval α R) := by
      rw [← map_mul, hF2]
    have e : algebraMap ↥W A (w * Polynomial.eval t c ^ k) * (x - algebraMap ↥W A β) *
        Polynomial.aeval θ Q =
        (algebraMap ↥W A (w * Polynomial.eval t c ^ k) * x - Polynomial.aeval θ R) *
          Polynomial.aeval θ Q +
        Polynomial.aeval θ R₁ * ((θ - algebraMap ↥W A α) * Polynomial.aeval θ Q) := by
      linear_combination (-(Polynomial.aeval θ Q)) * e2 + (Polynomial.aeval θ Q) * hF3
    have k1 : Ideal.Quotient.mk I
        ((algebraMap ↥W A (w * Polynomial.eval t c ^ k) * x - Polynomial.aeval θ R) *
          Polynomial.aeval θ Q) = 0 := by
      rw [map_mul, map_sub, hF1, sub_self, zero_mul]
    have k2 : Ideal.Quotient.mk I
        (Polynomial.aeval θ R₁ * ((θ - algebraMap ↥W A α) * Polynomial.aeval θ Q)) = 0 := by
      rw [map_mul, hE, mul_zero]
    rw [e, map_add, k1, k2, add_zero]
  rw [hI] at hmem
  obtain ⟨f', hf'⟩ := Ideal.mem_span_singleton'.mp hmem
  refine ⟨w * Polynomial.eval t c ^ k, β, f', hN, ?_, ?_⟩
  · rw [← hΦdef, hβc]
  · rw [← hf', mul_comm]

theorem wcpa_dj_lr1k_nsr_gub_bff_dc_ia_pbc_sp_alg_dep : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [Algebra ↥W A] (ϖ : ↥W), wcBffBase W A ϖ →
    ∀ η : A, (∀ f : Polynomial ↥W, (∃ k, f.coeff k ∉ IsLocalRing.maximalIdeal ↥W) →
        Polynomial.aeval η f ≠ 0) →
    ∀ x : A, ∃ (d : ℕ) (F : Fin (d + 1) → Polynomial ↥W),
      (∃ i k, (F i).coeff k ∉ IsLocalRing.maximalIdeal ↥W) ∧
      ∑ i, Polynomial.aeval η (F i) * x ^ (i : ℕ) = 0 :=
by
  have t_dim_mono : ∀ (R S : Type u) [CommRing R] [CommRing S] (f : R →+* S), f.IsIntegral →
      Function.Injective f → ringKrullDim R ≤ ringKrullDim S := by
    intro R S _ _ f hint hinj
