        have hD : X.basicOpen (wcCnSigma uX U β) ≤ ι.opensRange := by
          intro y hy
          have e : X.basicOpen (wcCnSigma uX U β) = U ⊓ uX ⁻¹ᵁ (Spec (.of ↥W)).basicOpen
              ((Scheme.ΓSpecIso (.of ↥W)).inv.hom β) :=
            Scheme.basicOpen_appLE uX U ⊤ le_top _
