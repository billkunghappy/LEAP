        _ = D + 1 := add_comm _ _
    rw [← ENat.forall_natCast_le_iff_le]
    intro a ha
    obtain ⟨e⟩ : Nonempty (Fin a ↪ MaximalSpectrum A) := by
      rcases finite_or_infinite (MaximalSpectrum A) with hf | hf
      · haveI := Fintype.ofFinite (MaximalSpectrum A)
        rw [ENat.card_eq_coe_fintype_card] at ha
        have ha' : a ≤ Fintype.card (MaximalSpectrum A) := by exact_mod_cast ha
        exact ⟨(Fin.castLEEmb ha').trans (Fintype.equivFin _).symm.toEmbedding⟩
      · exact ⟨Fin.valEmbedding.trans (Infinite.natEmbedding _)⟩
    refine hfin a (fun i => (e i).asIdeal) ?_ (fun i => (e i).isMaximal)
    intro i j hij
