theorem wcpa_dj_lr1k_nsr_gub_itmp_sup_integral : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [Algebra ↥W A] (ϖ : ↥W) (𝔪 : Ideal A) (g : Fin 2 → A),
      wcGubAdm W A ϖ 𝔪 g →
    ∀ c : ↥W, c ≠ 0 → c ∈ IsLocalRing.maximalIdeal ↥W →
    ∀ (a : ↥(wcGubBox W A g c)) (j : ℕ),
      (∀ θ : ↥(wcGubBox W A g c) →+* ↥W,
        (∀ w : ↥W, θ (algebraMap A ↥(wcGubBox W A g c) (algebraMap ↥W A w)) = w) →
          ∃ s : ↥W, θ a = ϖ ^ j * s) →
      ∃ x : Localization.Away (algebraMap ↥(wcGubBox W A g c) (wcGubCpl W A g ϖ c)
          (algebraMap A ↥(wcGubBox W A g c) (algebraMap ↥W A ϖ))),
        IsIntegral (wcGubCpl W A g ϖ c) x ∧
        algebraMap (wcGubCpl W A g ϖ c) _ (algebraMap ↥(wcGubBox W A g c) (wcGubCpl W A g ϖ c)
          (algebraMap A ↥(wcGubBox W A g c) (algebraMap ↥W A ϖ))) ^ j * x =
          algebraMap (wcGubCpl W A g ϖ c) _ (algebraMap ↥(wcGubBox W A g c)
            (wcGubCpl W A g ϖ c) a) :=
by
  intro Ω _ _ W hW _ A _ _ ϖ 𝔪 g hAdm c _ _ a j hpt
  classical

  have min_primes : ∀ (R B : Type u) [CommRing R] [CommRing B] [Algebra R B],
      (minimalPrimes B).Finite →
      ∀ x : B, (∀ 𝔮 ∈ minimalPrimes B, IsIntegral R (Ideal.Quotient.mk 𝔮 x)) → IsIntegral R x := by
    intro R B _ _ _ hfin x hx
    have hx' : ∀ 𝔮 ∈ minimalPrimes B, ∃ p : Polynomial R, p.Monic ∧
        Ideal.Quotient.mk 𝔮 (Polynomial.aeval x p) = 0 := by
      intro 𝔮 h𝔮
      obtain ⟨p, hp, hp0⟩ := hx 𝔮 h𝔮
      refine ⟨p, hp, ?_⟩
      rw [← Ideal.Quotient.mkₐ_eq_mk R 𝔮, ← Polynomial.aeval_algHom_apply,
        Ideal.Quotient.mkₐ_eq_mk, Polynomial.aeval_def]
      exact hp0
    choose f hfm hf using hx'
    let F : Ideal B → Polynomial R := fun 𝔮 => if h : 𝔮 ∈ minimalPrimes B then f 𝔮 h else 1
    have hFm : ∀ 𝔮, (F 𝔮).Monic := by
      intro 𝔮
      by_cases h : 𝔮 ∈ minimalPrimes B
      · simp only [F, dif_pos h]; exact hfm 𝔮 h
      · simp only [F, dif_neg h]; exact Polynomial.monic_one
    let P : Polynomial R := ∏ 𝔮 ∈ hfin.toFinset, F 𝔮
    have hPm : P.Monic := Polynomial.monic_prod_of_monic _ _ (fun 𝔮 _ => hFm 𝔮)
    have key : ∀ 𝔮 ∈ minimalPrimes B, Polynomial.aeval x P ∈ 𝔮 := by
      intro 𝔮 h𝔮
      have hmem : Polynomial.aeval x (F 𝔮) ∈ 𝔮 := by
        simp only [F, dif_pos h𝔮]
        exact Ideal.Quotient.eq_zero_iff_mem.mp (hf 𝔮 h𝔮)
      show Polynomial.aeval x (∏ 𝔮 ∈ hfin.toFinset, F 𝔮) ∈ 𝔮
      rw [map_prod, ← Finset.prod_erase_mul _ _ (hfin.mem_toFinset.mpr h𝔮)]
      exact Ideal.mul_mem_left _ _ hmem
    have hrad : Polynomial.aeval x P ∈ (⊥ : Ideal B).radical := by
      rw [← Ideal.sInf_minimalPrimes]
      exact Ideal.mem_sInf.mpr (fun I hI => key I hI)
    obtain ⟨k, hk⟩ := hrad
    refine ⟨P ^ k, hPm.pow k, ?_⟩
    rw [← Polynomial.aeval_def, map_pow]
    exact Ideal.mem_bot.mp hk

  have hϖ0 : ϖ ≠ 0 := hAdm.1
  have hϖm : ϖ ∈ IsLocalRing.maximalIdeal ↥W := hAdm.2.1
  have hϖnu : ¬ IsUnit ϖ := (IsLocalRing.mem_maximalIdeal ϖ).mp hϖm
  haveI : IsDomain A := hAdm.2.2.1
  haveI : Algebra.FinitePresentation ↥W A := hAdm.2.2.2.2.1
  haveI hftA : Algebra.FiniteType ↥W A := Algebra.FiniteType.of_finitePresentation
  have htors : ∀ (w : ↥W) (a : A), w ≠ 0 → algebraMap ↥W A w * a = 0 → a = 0 :=
    hAdm.2.2.2.2.2.1
  have hdim : ringKrullDim (wcGubGen W A) ≤ 1 := hAdm.2.2.2.2.2.2.2.1
  have hdiv : ∀ c' : ↥W, c' ≠ 0 → ∃ n : ℕ, c' ∣ ϖ ^ n := by
    intro c' hc'
    by_cases hu : IsUnit c'
    · exact ⟨0, by rw [pow_zero]; exact hu.dvd⟩
    · exact wcpa_dj_lr1k_nsr_gub_it_rank_one_pow W hW c' ϖ hc'
        ((IsLocalRing.mem_maximalIdeal c').mpr hu) hϖm
  have hunitW : ∀ y : nonZeroDivisors ↥W, IsUnit (algebraMap ↥W (wcGubGen W A) y) := by
    intro y
    rw [IsScalarTower.algebraMap_apply ↥W A (wcGubGen W A)]
    exact IsLocalization.map_units (wcGubGen W A)
      (⟨algebraMap ↥W A y, Submonoid.mem_map_of_mem _ y.2⟩ :
        Submonoid.map (algebraMap ↥W A) (nonZeroDivisors ↥W))
  haveI hGdom : IsDomain (wcGubGen W A) := by
    apply IsLocalization.isDomain_localization
    intro m hm
    obtain ⟨w, hw, hwm⟩ := Submonoid.mem_map.mp hm
    rw [mem_nonZeroDivisors_iff_right]
    intro z hz
    rw [← hwm] at hz
    exact htors w z (nonZeroDivisors.ne_zero hw) (by rw [mul_comm]; exact hz)
  letI : Algebra Ω (wcGubGen W A) :=
    (IsLocalization.lift (M := nonZeroDivisors ↥W) (S := Ω) hunitW).toAlgebra
  haveI : IsScalarTower ↥W Ω (wcGubGen W A) :=
    IsScalarTower.of_algebraMap_eq (fun x => (IsLocalization.lift_eq hunitW x).symm)
  have hinj : Function.Injective (algebraMap ↥(wcGubBox W A g c) (wcGubGen W A)) :=
    Subtype.val_injective
  haveI : Algebra.FiniteType A ↥(wcGubBox W A g c) :=
    (Subalgebra.fg_iff_finiteType _).mp (Subalgebra.fg_def.mpr ⟨_, Set.finite_range _, rfl⟩)
  have hftR : Algebra.FiniteType ↥W ↥(wcGubBox W A g c) :=
    Algebra.FiniteType.trans (S := A) hftA inferInstance
  have hftG : Algebra.FiniteType Ω (wcGubGen W A) := by
    obtain ⟨s, hs⟩ := hftA.out
    refine ⟨⟨s.image (algebraMap A (wcGubGen W A)), ?_⟩⟩
    have hA : ∀ a : A, algebraMap A (wcGubGen W A) a ∈ Algebra.adjoin Ω
        ((s.image (algebraMap A (wcGubGen W A)) : Finset (wcGubGen W A)) :
          Set (wcGubGen W A)) := by
