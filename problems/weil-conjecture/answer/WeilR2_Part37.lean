theorem wcpa_dj_lr1k_nsr_gub_bff_dc_ia_pb_point_integral : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    (∀ (R : Type u) [CommRing R] [IsDomain R] [Algebra ↥W R], Algebra.FiniteType ↥W R →
      (∀ w : ↥W, w ≠ 0 → algebraMap ↥W R w ≠ 0) →
      ringKrullDim (Localization (Submonoid.map (algebraMap ↥W R) (nonZeroDivisors ↥W))) ≤ 1 →
    ∀ t : R, Ideal.span {t} ⊔ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W R) ≠ ⊤ →
      ∃ χ : R →ₐ[↥W] ↥W, χ t ∈ IsLocalRing.maximalIdeal ↥W) →
    ∀ (A : Type u) [CommRing A] [Algebra ↥W A] (ϖ : ↥W) (ζ : A),
      wcBffBase W A ϖ →
    ∀ e : ↥W, e ≠ 0 → ∀ y : wcGubGen W A,
      (∀ ψ : wcGubGen W A →+* Ω, wcIaPt W A ζ e ψ → ψ y ∈ W) →
      IsIntegral ↥(wcGubBox W A (fun _ : Fin 2 => ζ) e) y :=
by
  intro Ω _ _ W hdimW _hWt hlift A _ _ ϖ ζ hbase e he y hy

  have s2 : ∀ (G S : Type u) [CommRing G] [CommRing S] (φ : G →+* S) (x : G), IsUnit (φ x) →
      (∀ s : S, ∃ (n : ℕ) (g : G), φ x ^ n * s = φ g) → ringKrullDim S ≤ ringKrullDim G := by
    intro G S _ _ φ x hx h
    apply Order.krullDim_le_of_strictMono (PrimeSpectrum.comap φ)
    apply Monotone.strictMono_of_injective
    · intro P Q hPQ
      exact Ideal.comap_mono hPQ
    · intro P Q hPQ
      have key : ∀ P Q : PrimeSpectrum S, PrimeSpectrum.comap φ P = PrimeSpectrum.comap φ Q →
          P.asIdeal ≤ Q.asIdeal := by
        intro P Q hPQ s hs
        obtain ⟨n, g, hg⟩ := h s
        have hgP : g ∈ (PrimeSpectrum.comap φ P).asIdeal := by
          show φ g ∈ P.asIdeal
          rw [← hg]
          exact P.asIdeal.mul_mem_left _ hs
        rw [hPQ] at hgP
        have h2 : φ x ^ n * s ∈ Q.asIdeal := by
          rw [hg]
          exact hgP
        rcases Q.isPrime.mem_or_mem h2 with h1 | h1
        · exact absurd (Ideal.eq_top_of_isUnit_mem _ h1 (hx.pow n)) Q.isPrime.ne_top
        · exact h1
      exact PrimeSpectrum.ext (le_antisymm (key P Q hPQ) (key Q P hPQ.symm))

  have s3 : ∀ (R₀ G : Type u) [CommRing R₀] [CommRing G] [IsDomain G] [Algebra R₀ G]
      (B : Subalgebra R₀ G) (y : G), ¬ IsIntegral ↥B y →
      ∃ V : ValuationSubring (FractionRing G), (∀ b ∈ B, algebraMap G (FractionRing G) b ∈ V) ∧
        algebraMap G (FractionRing G) y ∉ V := by
    intro R₀ G _ _ _ _ B y hni
    classical
    set f := algebraMap G (FractionRing G) with hf
    have finj : Function.Injective f := IsFractionRing.injective G (FractionRing G)
    by_contra hcon
    push_neg at hcon
    set T : Subring (FractionRing G) := B.toSubring.map f with hT
    have hI := iInf_valuationSubring_superset (K := FractionRing G)
      (s := (T : Set (FractionRing G)))
    have hmem : f y ∈ (integralClosure ↥(Subring.closure (T : Set (FractionRing G)))
        (FractionRing G)).toSubring := by
      rw [← hI, Subring.mem_iInf]
      intro V
      apply hcon V.1
      intro b hb
      exact V.2 ⟨b, hb, rfl⟩
    have hint : IsIntegral ↥(Subring.closure (T : Set (FractionRing G))) (f y) := hmem
    obtain ⟨p, hpm, hp⟩ := hint
    let g : ↥B →+* ↥(Subring.closure (T : Set (FractionRing G))) :=
      { toFun := fun b => ⟨f b, Subring.subset_closure ⟨b, b.2, rfl⟩⟩
        map_one' := by ext; simp
        map_mul' := by intro a b; ext; simp
        map_zero' := by ext; simp
        map_add' := by intro a b; ext; simp }
    have hgs : ∀ z, z ∈ Set.range g := by
      rintro ⟨z, hz⟩
      have hz' : z ∈ T := Subring.closure_le.mpr subset_rfl hz
      obtain ⟨b, hb, rfl⟩ := hz'
      exact ⟨⟨b, hb⟩, rfl⟩
    have hlift' : p ∈ Polynomial.lifts g :=
      (Polynomial.lifts_iff_coeff_lifts p).mpr (fun n => hgs _)
    obtain ⟨P, hPp, -, hPm⟩ := Polynomial.lifts_and_degree_eq_and_monic hlift' hpm
    apply hni
    refine ⟨P, hPm, ?_⟩
    apply finj
    rw [Polynomial.hom_eval₂, map_zero, ← hp, ← hPp, Polynomial.eval₂_map]
    rfl

  have s4 : ∀ (R : Type u) [CommRing R] [Algebra ↥W R] (j : A →+* R)
      (q t : R) (y : wcGubGen W A) (a : A) (w₀ : ↥W) (χ : R →ₐ[↥W] ↥W), w₀ ≠ 0 →
      (∀ w : ↥W, j (algebraMap ↥W A w) = algebraMap ↥W R w) →
      j ζ = q * algebraMap ↥W R e → t * j a = algebraMap ↥W R w₀ →
      y * algebraMap A (wcGubGen W A) (algebraMap ↥W A w₀) = algebraMap A (wcGubGen W A) a →
      χ t ∈ IsLocalRing.maximalIdeal ↥W →
      ∃ ψ : wcGubGen W A →+* Ω, wcIaPt W A ζ e ψ ∧ ψ y ∉ W := by
    intro R _ _ j q t y a w₀ χ hw0 hj hq hta hya hχ
    let χA : A →+* Ω := W.subtype.comp (χ.toRingHom.comp j)
    have hχA : ∀ x, χA x = ((χ (j x) : W) : Ω) := fun x => rfl
    have hχAw : ∀ w : W, χA (algebraMap W A w) = (w : Ω) := by
      intro w
      rw [hχA, hj, AlgHom.commutes]
      rfl
    have hunits : ∀ m : Submonoid.map (algebraMap ↥W A) (nonZeroDivisors ↥W),
        IsUnit (χA m) := by
      rintro ⟨m, hm⟩
      obtain ⟨w, hw, rfl⟩ := Submonoid.mem_map.mp hm
      show IsUnit (χA (algebraMap W A w))
      rw [hχAw]
      apply isUnit_iff_ne_zero.mpr
      intro h0
      apply nonZeroDivisors.ne_zero hw
      exact Subtype.ext h0
    let ψ : wcGubGen W A →+* Ω :=
      IsLocalization.lift (M := Submonoid.map (algebraMap ↥W A) (nonZeroDivisors ↥W))
        (S := wcGubGen W A) hunits
    have hψ : ∀ x : A, ψ (algebraMap A (wcGubGen W A) x) = χA x := fun x =>
      IsLocalization.lift_eq hunits x
    have hEu : IsUnit (algebraMap A (wcGubGen W A) (algebraMap ↥W A e)) :=
      IsLocalization.map_units (wcGubGen W A)
        (⟨_, Submonoid.mem_map_of_mem _ (mem_nonZeroDivisors_of_ne_zero he)⟩ :
          Submonoid.map (algebraMap ↥W A) (nonZeroDivisors ↥W))
    refine ⟨ψ, ⟨fun w => by rw [hψ, hχAw], fun x => by rw [hψ, hχA]; exact (χ (j x)).2, ?_⟩, ?_⟩
    · have h1 : ψ (Ring.inverse (algebraMap A (wcGubGen W A) (algebraMap ↥W A e))) * (e : Ω) =
          1 := by
        rw [← hχAw, ← hψ, ← map_mul, Ring.inverse_mul_cancel _ hEu, map_one]
      have h2 : ψ (algebraMap A (wcGubGen W A) ζ) = ((χ q : W) : Ω) * (e : Ω) := by
        rw [hψ, hχA, hq, map_mul, AlgHom.commutes]
        rfl
      rw [map_mul, h2, mul_assoc, mul_comm (e : Ω), h1, mul_one]
      exact (χ q).2
    · intro hyW
      have h1 : ψ y * (w₀ : Ω) = ((χ (j a) : W) : Ω) := by
        rw [← hχAw, ← hψ, ← map_mul, hya, hψ, hχA]
      have h2 : χ t * χ (j a) = w₀ := by
        rw [← map_mul, hta, AlgHom.commutes]
        rfl
      have h3 : ((χ t : W) : Ω) * ψ y = 1 := by
        have hw0' : (w₀ : Ω) ≠ 0 := fun h => hw0 (Subtype.ext h)
        apply mul_right_cancel₀ hw0'
        rw [mul_assoc, h1, one_mul]
        exact congrArg Subtype.val h2
      have hu : IsUnit (χ t) := isUnit_iff_exists_inv.mpr ⟨⟨ψ y, hyW⟩, Subtype.ext h3⟩
      exact (IsLocalRing.mem_maximalIdeal _).mp hχ hu

  have s7 : ∀ (K : Type u) [Field K] [Algebra (wcGubGen W A) K] (V : ValuationSubring K)
      (y : wcGubGen W A),
      (∀ a : A, algebraMap (wcGubGen W A) K (algebraMap A (wcGubGen W A) a) ∈ V) →
      algebraMap (wcGubGen W A) K y ∉ V →
      ∀ w : ↥W, w ∈ IsLocalRing.maximalIdeal ↥W → w ≠ 0 →
        (algebraMap (wcGubGen W A) K (algebraMap A (wcGubGen W A) (algebraMap ↥W A w)))⁻¹ ∉ V := by
    intro K _ _ V y hA hyV w hwm hw0 hinv
    set ιW : W →+* K := (algebraMap (wcGubGen W A) K).comp
      ((algebraMap A (wcGubGen W A)).comp (algebraMap W A)) with hιW
    have hne : ∀ w' : W, w' ≠ 0 → ιW w' ≠ 0 := by
      intro w' hw'
      have hu : IsUnit (algebraMap A (wcGubGen W A) (algebraMap ↥W A w')) :=
        IsLocalization.map_units (wcGubGen W A)
          (⟨_, Submonoid.mem_map_of_mem _ (mem_nonZeroDivisors_of_ne_zero hw')⟩ :
            Submonoid.map (algebraMap ↥W A) (nonZeroDivisors ↥W))
      exact (hu.map (algebraMap (wcGubGen W A) K)).ne_zero
    have : Ring.KrullDimLE 1 W := Ring.krullDimLE_iff.mpr hdimW
    have hpow : ∀ w' : W, w' ≠ 0 → ∃ (k : ℕ) (u : W), w ^ k = u * w' := by
      intro w' hw'
      have hrad : IsLocalRing.maximalIdeal W ≤ (Ideal.span {w'}).radical := by
        rw [Ideal.radical_eq_sInf]
        apply le_sInf
        rintro P ⟨hP1, hP2⟩
        have hne : P ≠ ⊥ := by
          intro h
          rw [h] at hP1
          apply hw'
          simpa using hP1 (Ideal.mem_span_singleton_self w')
        have hmax := Ideal.isMaximal_of_isPrime_of_ne_bot P hne
        rw [IsLocalRing.eq_maximalIdeal hmax]
      obtain ⟨k, hk⟩ := hrad hwm
      obtain ⟨u, hu⟩ := Ideal.mem_span_singleton'.mp hk
      exact ⟨k, u, hu.symm⟩
    obtain ⟨⟨a, m⟩, hya⟩ := IsLocalization.surj
      (Submonoid.map (algebraMap ↥W A) (nonZeroDivisors ↥W)) y
    obtain ⟨w₀, hw₀, hm⟩ := Submonoid.mem_map.mp m.2
    have hw00 : w₀ ≠ 0 := nonZeroDivisors.ne_zero hw₀
    obtain ⟨k, u, hk⟩ := hpow w₀ hw00
    have hstar : algebraMap (wcGubGen W A) K y * ιW w₀ =
        algebraMap (wcGubGen W A) K (algebraMap A (wcGubGen W A) a) := by
      rw [hιW, RingHom.comp_apply, RingHom.comp_apply, ← map_mul, hm]
      exact congrArg _ hya
    have hk' : ιW w ^ k = ιW u * ιW w₀ := by rw [← map_pow, hk, map_mul]
    have hwk0 : w ^ k ≠ 0 := pow_ne_zero _ hw0
    have hu0 : u ≠ 0 := by
      rintro rfl
      rw [zero_mul] at hk
      exact hwk0 hk
    have hyeq : algebraMap (wcGubGen W A) K y =
        algebraMap (wcGubGen W A) K (algebraMap A (wcGubGen W A) a) * ιW u * (ιW w)⁻¹ ^ k := by
      have h1 := hne w hw0
      have h2 := hne u hu0
      have h3 := hne w₀ hw00
      rw [inv_pow, ← hstar, hk']
      field_simp
    apply hyV
    rw [hyeq]
    exact mul_mem (mul_mem (hA a) (hA (algebraMap W A u))) (pow_mem hinv k)

  have s5 : ∀ (K : Type u) [Field K] [Algebra (wcGubGen W A) K]
      (V : ValuationSubring K) (y : wcGubGen W A), Algebra.FiniteType ↥W A →
      (∀ b ∈ wcGubBox W A (fun _ : Fin 2 => ζ) e, algebraMap (wcGubGen W A) K b ∈ V) →
      algebraMap (wcGubGen W A) K y ∉ V →
      (∀ w : ↥W, w ∈ IsLocalRing.maximalIdeal ↥W → w ≠ 0 →
        (algebraMap (wcGubGen W A) K (algebraMap A (wcGubGen W A) (algebraMap ↥W A w)))⁻¹ ∉ V) →
      ∃ (R : Type u) (_ : CommRing R) (_ : IsDomain R) (_ : Algebra ↥W R) (j : A →+* R)
        (q t : R) (a : A) (w₀ : ↥W), Algebra.FiniteType ↥W R ∧
        (∀ w : ↥W, w ≠ 0 → algebraMap ↥W R w ≠ 0) ∧
        Ideal.span {t} ⊔ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W R) ≠ ⊤ ∧
        (∀ w : ↥W, j (algebraMap ↥W A w) = algebraMap ↥W R w) ∧ j ζ = q * algebraMap ↥W R e ∧
        w₀ ≠ 0 ∧ t * j a = algebraMap ↥W R w₀ ∧
        y * algebraMap A (wcGubGen W A) (algebraMap ↥W A w₀) = algebraMap A (wcGubGen W A) a ∧
        (∀ r : R, ∃ (n : ℕ) (a' : A) (w' : ↥W), w' ≠ 0 ∧
          algebraMap ↥W R w' * r = t ^ n * j a') := by
    intro K _ _ V y hft hBV hyV hmV
    classical
    set MA := Submonoid.map (algebraMap ↥W A) (nonZeroDivisors ↥W) with hMA
    set f := algebraMap (wcGubGen W A) K with hf
    set ιA : A →+* K := f.comp (algebraMap A (wcGubGen W A)) with hιA
    set ιW : W →+* K := ιA.comp (algebraMap W A) with hιW
    have hAW : ∀ w : W, ιA (algebraMap W A w) = ιW w := fun _ => rfl
    have hAu : ∀ w : W, w ≠ 0 → IsUnit (algebraMap A (wcGubGen W A) (algebraMap W A w)) :=
      fun w hw => IsLocalization.map_units (wcGubGen W A)
        (⟨_, Submonoid.mem_map_of_mem _ (mem_nonZeroDivisors_of_ne_zero hw)⟩ : MA)
    have hne : ∀ w : W, w ≠ 0 → ιW w ≠ 0 := fun w hw => ((hAu w hw).map f).ne_zero
    have hy0 : f y ≠ 0 := fun h => hyV (h ▸ zero_mem V)
    set T : K := (f y)⁻¹ with hT
    have hTV : T ∈ V := (V.mem_or_inv_mem (f y)).resolve_left hyV
    have hTY : T * f y = 1 := inv_mul_cancel₀ hy0
    obtain ⟨⟨a, m⟩, hya⟩ := IsLocalization.surj MA y
    obtain ⟨w₀, hw₀, hm⟩ := Submonoid.mem_map.mp m.2
    have hw00 : w₀ ≠ 0 := nonZeroDivisors.ne_zero hw₀
    have hya' : y * algebraMap A (wcGubGen W A) (algebraMap ↥W A w₀) =
        algebraMap A (wcGubGen W A) a := by rw [hm]; exact hya
    have hstar : f y * ιW w₀ = ιA a := by
      rw [← hAW, hιA, RingHom.comp_apply, ← map_mul, hya']
      rfl
    set q₀ : wcGubGen W A := algebraMap A (wcGubGen W A) ζ *
      Ring.inverse (algebraMap A (wcGubGen W A) (algebraMap W A e)) with hq₀
    have hq₀B : q₀ ∈ wcGubBox W A (fun _ : Fin 2 => ζ) e := Algebra.subset_adjoin ⟨0, rfl⟩
    set Q : K := f q₀ with hQ
    have hQe : Q * ιW e = ιA ζ := by
      rw [hQ, ← hAW, hιA, RingHom.comp_apply, ← map_mul, hq₀, mul_assoc,
        Ring.inverse_mul_cancel _ (hAu e he), mul_one]
      rfl
    letI : Algebra W K := ιW.toAlgebra
    have hWK : ∀ w : W, algebraMap W K w = ιW w := fun _ => rfl
    obtain ⟨G₀, hG₀⟩ := hft.out
    set S : Set K := ιA '' (G₀ : Set A) ∪ {Q, T} with hS
    set Rsub : Subalgebra W K := Algebra.adjoin W S with hRsub
    have hSfin : S.Finite := (G₀.finite_toSet.image _).union (Set.toFinite _)
    have hRfg : Rsub.FG := Subalgebra.fg_def.mpr ⟨S, hSfin, rfl⟩
    let ιAalg : A →ₐ[W] K := { ιA with commutes' := fun w => rfl }
    have hmemA : ∀ x : A, ιA x ∈ Rsub := by
      intro x
      have hle : Algebra.adjoin W (G₀ : Set A) ≤ Rsub.comap ιAalg :=
        Algebra.adjoin_le (fun g hg => Algebra.subset_adjoin (Or.inl ⟨g, hg, rfl⟩))
      rw [hG₀] at hle
      exact hle Algebra.mem_top
    have hQR : Q ∈ Rsub := Algebra.subset_adjoin (Or.inr (Or.inl rfl))
    have hTR : T ∈ Rsub := Algebra.subset_adjoin (Or.inr (Or.inr rfl))
    let j : A →+* ↥Rsub := ιA.codRestrict Rsub hmemA
    let q : ↥Rsub := ⟨Q, hQR⟩
    let t : ↥Rsub := ⟨T, hTR⟩
    let VS : Subalgebra W K :=
      { V.toSubring.toSubsemiring with
        algebraMap_mem' := fun w => hBV _ (Subalgebra.algebraMap_mem _ (algebraMap W A w)) }
    have hRV : Rsub ≤ VS := by
      apply Algebra.adjoin_le
      rintro x (⟨g, -, rfl⟩ | hx | hx)
      · exact hBV _ (Subalgebra.algebraMap_mem _ g)
      · rw [hx]; exact hBV _ hq₀B
      · rw [Set.mem_singleton_iff.mp hx]; exact hTV
    let ρ : ↥Rsub →+* V :=
      { toFun := fun r => ⟨(r : K), hRV r.2⟩
        map_one' := rfl
        map_mul' := fun _ _ => rfl
        map_zero' := rfl
        map_add' := fun _ _ => rfl }
    have hgenK : ∀ x (hx : x ∈ Rsub), ∃ (n : ℕ) (a' : A) (w' : ↥W), w' ≠ 0 ∧
        ιW w' * x = T ^ n * ιA a' := by
      intro x hx
      induction hx using Algebra.adjoin_induction with
      | mem x hx =>
        rcases hx with ⟨g, -, rfl⟩ | hx | hx
        · exact ⟨0, g, 1, one_ne_zero, by simp⟩
        · rw [hx]
          exact ⟨0, ζ, e, he, by rw [pow_zero, one_mul, mul_comm, hQe]⟩
        · rw [Set.mem_singleton_iff.mp hx]
          exact ⟨1, 1, 1, one_ne_zero, by simp⟩
      | algebraMap c =>
        exact ⟨0, algebraMap W A c, 1, one_ne_zero, by
          rw [hWK, map_one, one_mul, pow_zero, one_mul]; rfl⟩
      | add x₁ x₂ _ _ h1 h2 =>
        obtain ⟨n₁, a₁, w₁, hw₁, h1⟩ := h1
        obtain ⟨n₂, a₂, w₂, hw₂, h2⟩ := h2
        refine ⟨n₁ + n₂, algebraMap W A (w₂ * w₀ ^ n₁) * a₁ * a ^ n₂ +
          algebraMap W A (w₁ * w₀ ^ n₂) * a₂ * a ^ n₁, w₁ * w₂ * w₀ ^ (n₁ + n₂),
          mul_ne_zero (mul_ne_zero hw₁ hw₂) (pow_ne_zero _ hw00), ?_⟩
        have hTYn : ∀ n : ℕ, T ^ n * f y ^ n = 1 := fun n => by rw [← mul_pow, hTY, one_pow]
        simp only [map_add, map_mul, map_pow, hAW]
        rw [← hstar]
        linear_combination (ιW w₂ * ιW w₀ ^ (n₁ + n₂)) * h1 + (ιW w₁ * ιW w₀ ^ (n₁ + n₂)) * h2 -
          (T ^ n₁ * ιW w₂ * ιW w₀ ^ (n₁ + n₂) * ιA a₁) * hTYn n₂ -
          (T ^ n₂ * ιW w₁ * ιW w₀ ^ (n₁ + n₂) * ιA a₂) * hTYn n₁
      | mul x₁ x₂ _ _ h1 h2 =>
        obtain ⟨n₁, a₁, w₁, hw₁, h1⟩ := h1
        obtain ⟨n₂, a₂, w₂, hw₂, h2⟩ := h2
        refine ⟨n₁ + n₂, a₁ * a₂, w₁ * w₂, mul_ne_zero hw₁ hw₂, ?_⟩
        simp only [map_mul]
        linear_combination (ιW w₂ * x₂) * h1 + (T ^ n₁ * ιA a₁) * h2
    refine ⟨↥Rsub, inferInstance, inferInstance, inferInstance, j, q, t, a, w₀,
      (Subalgebra.fg_iff_finiteType _).mp hRfg, ?_, ?_, ?_, ?_, hw00, ?_, hya', ?_⟩
    · intro w hw h
      exact hne w hw (congrArg Subtype.val h)
    · set I := Ideal.comap ρ (IsLocalRing.maximalIdeal V) with hI
      have hItop : I ≠ ⊤ := Ideal.comap_ne_top ρ (IsLocalRing.maximalIdeal.isMaximal V).ne_top
      have htI : t ∈ I := by
        show ρ t ∈ IsLocalRing.maximalIdeal V
        rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
        intro hu
        obtain ⟨v, hv⟩ := isUnit_iff_exists_inv.mp hu
        have h1 : T * (v : K) = 1 := congrArg Subtype.val hv
        have h2 : f y = (v : K) := (inv_mul_eq_one₀ hy0).mp h1
        exact hyV (h2 ▸ v.2)
      have hmapI : (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W ↥Rsub) ≤ I := by
        rw [Ideal.map_le_iff_le_comap]
        intro w hw
        show ρ (algebraMap W ↥Rsub w) ∈ IsLocalRing.maximalIdeal V
        by_cases hw0 : w = 0
        · rw [hw0, map_zero, map_zero]
          exact zero_mem _
        rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
        intro hu
        obtain ⟨v, hv⟩ := isUnit_iff_exists_inv.mp hu
        have h1 : ιW w * (v : K) = 1 := congrArg Subtype.val hv
        have h2 : (v : K) = (ιW w)⁻¹ := eq_inv_of_mul_eq_one_right h1
        exact hmV w hw hw0 (h2 ▸ v.2)
      intro htop
      apply hItop
      rw [eq_top_iff, ← htop]
      exact sup_le ((Ideal.span_singleton_le_iff_mem _).mpr htI) hmapI
    · intro w
      exact Subtype.ext rfl
    · apply Subtype.ext
      show ιA ζ = Q * ιW e
      rw [hQe]
    · apply Subtype.ext
      show T * ιA a = ιW w₀
      rw [← hstar, ← mul_assoc, hTY, one_mul]
    · intro r
      obtain ⟨n, a', w', hw', h⟩ := hgenK r r.2
      refine ⟨n, a', w', hw', Subtype.ext ?_⟩
      simp only [Subalgebra.coe_mul, Subalgebra.coe_pow]
      exact h

  have s6 : ∀ (R : Type u) [CommRing R] [Algebra ↥W R] (j : A →+* R) (t : R)
      (y : wcGubGen W A) (a : A) (w₀ : ↥W),
      ringKrullDim (wcGubGen W A) ≤ 1 →
      (∀ w : ↥W, j (algebraMap ↥W A w) = algebraMap ↥W R w) → w₀ ≠ 0 →
      t * j a = algebraMap ↥W R w₀ →
      y * algebraMap A (wcGubGen W A) (algebraMap ↥W A w₀) = algebraMap A (wcGubGen W A) a →
      (∀ r : R, ∃ (n : ℕ) (a' : A) (w' : ↥W), w' ≠ 0 ∧
        algebraMap ↥W R w' * r = t ^ n * j a') →
      ringKrullDim (Localization (Submonoid.map (algebraMap ↥W R) (nonZeroDivisors ↥W))) ≤ 1 := by
    intro R _ _ j t y a w₀ hdimG hj hw0 hta hya hgen
    set MR := Submonoid.map (algebraMap ↥W R) (nonZeroDivisors ↥W) with hMR
    set MA := Submonoid.map (algebraMap ↥W A) (nonZeroDivisors ↥W) with hMA
    set ι := algebraMap R (Localization MR) with hι
    have hRu : ∀ w : W, w ≠ 0 → IsUnit (ι (algebraMap W R w)) := fun w hw =>
      IsLocalization.map_units (Localization MR)
        (⟨_, Submonoid.mem_map_of_mem _ (mem_nonZeroDivisors_of_ne_zero hw)⟩ : MR)
    have hAu : ∀ w : W, w ≠ 0 → IsUnit (algebraMap A (wcGubGen W A) (algebraMap W A w)) :=
      fun w hw => IsLocalization.map_units (wcGubGen W A)
        (⟨_, Submonoid.mem_map_of_mem _ (mem_nonZeroDivisors_of_ne_zero hw)⟩ : MA)
    have hunits : ∀ m : MA, IsUnit ((ι.comp j) m) := by
      rintro ⟨m, hm⟩
      obtain ⟨w, hw, rfl⟩ := Submonoid.mem_map.mp hm
      show IsUnit (ι (j (algebraMap W A w)))
      rw [hj]
      exact hRu w (nonZeroDivisors.ne_zero hw)
    let φ : wcGubGen W A →+* Localization MR :=
      IsLocalization.lift (M := MA) (S := wcGubGen W A) hunits
    have hφ : ∀ x : A, φ (algebraMap A (wcGubGen W A) x) = ι (j x) := fun x =>
      IsLocalization.lift_eq hunits x
    have hφw : ∀ w : W, φ (algebraMap A _ (algebraMap W A w)) = ι (algebraMap W R w) := by
      intro w
      rw [hφ, hj]
    have hyt : φ y * ι t = 1 := by
      have h1 : φ y * ι (algebraMap W R w₀) = ι (j a) := by
        rw [← hφw, ← map_mul, hya, hφ]
      have h2 : ι t * ι (j a) = ι (algebraMap W R w₀) := by
        rw [← map_mul, hta]
      apply ((hRu w₀ hw0).mul_left_inj).mp
      linear_combination ι t * h1 + h2
    have hyu : IsUnit (φ y) := isUnit_iff_exists_inv.mpr ⟨ι t, hyt⟩
    have hden : ∀ s : Localization MR, ∃ (n : ℕ) (g : wcGubGen W A), φ y ^ n * s = φ g := by
      intro s
      obtain ⟨⟨r, m⟩, hs⟩ := IsLocalization.surj MR s
      obtain ⟨w₁, hw₁, hm⟩ := Submonoid.mem_map.mp m.2
      have hw10 : w₁ ≠ 0 := nonZeroDivisors.ne_zero hw₁
      obtain ⟨n, a', w', hw', hr⟩ := hgen r
      have hDu := hAu (w₁ * w') (mul_ne_zero hw10 hw')
      refine ⟨n, algebraMap A (wcGubGen W A) a' *
        Ring.inverse (algebraMap A (wcGubGen W A) (algebraMap W A (w₁ * w'))), ?_⟩
      have hs' : s * ι (algebraMap W R w₁) = ι r := by
        rw [hm]
        exact hs
      have hr' : ι (algebraMap W R w') * ι r = ι t ^ n * ι (j a') := by
        rw [← map_mul, hr, map_mul, map_pow]
      have hytn : φ y ^ n * ι t ^ n = 1 := by
        rw [← mul_pow, hyt, one_pow]
      have hg : φ (algebraMap A (wcGubGen W A) a' *
          Ring.inverse (algebraMap A (wcGubGen W A) (algebraMap W A (w₁ * w')))) *
          (ι (algebraMap W R w₁) * ι (algebraMap W R w')) = ι (j a') := by
        rw [← map_mul, ← map_mul, ← hφw, ← map_mul, mul_assoc, Ring.inverse_mul_cancel _ hDu,
          mul_one, hφ]
      have hU : IsUnit (ι (algebraMap W R w₁) * ι (algebraMap W R w')) :=
        (hRu w₁ hw10).mul (hRu w' hw')
      apply hU.mul_left_inj.mp
      linear_combination (φ y ^ n * ι (algebraMap W R w')) * hs' + φ y ^ n * hr' +
        ι (j a') * hytn - hg
    exact (s2 (wcGubGen W A) (Localization MR) φ y hyu hden).trans hdimG

  obtain ⟨_hϖ0, _hϖm, hdomA, _hicA, hfpA, htf, _hred, hdimGen⟩ := hbase
  haveI : IsDomain A := hdomA
  haveI : Algebra.FinitePresentation ↥W A := hfpA
  have hle : Submonoid.map (algebraMap ↥W A) (nonZeroDivisors ↥W) ≤ nonZeroDivisors A := by
    rintro m ⟨w, hw, rfl⟩
    apply mem_nonZeroDivisors_of_ne_zero
    intro h0
    have h1 := htf w 1 (nonZeroDivisors.ne_zero hw) (by rw [h0, zero_mul])
    exact one_ne_zero h1
  haveI : IsDomain (wcGubGen W A) := IsLocalization.isDomain_localization hle
  have hftA : Algebra.FiniteType ↥W A := inferInstance
  by_contra hni
  obtain ⟨V, hBV, hyV⟩ := s3 A (wcGubGen W A) _ y hni
  have hmV := s7 (FractionRing (wcGubGen W A)) V y
    (fun a => hBV _ (Subalgebra.algebraMap_mem _ a)) hyV
  obtain ⟨R, iR, dR, aR, j, q, t, a, w₀, hft, hinj, hideal, hj, hq, hw0, hta, hya, hgen⟩ :=
    s5 (FractionRing (wcGubGen W A)) V y hftA hBV hyV hmV
  have hdR := s6 R j t y a w₀ hdimGen hj hw0 hta hya hgen
  obtain ⟨χ, hχ⟩ := hlift R hft hinj hdR t hideal
  obtain ⟨ψ, hψ, hψy⟩ := s4 R j q t y a w₀ χ hw0 hj hq hta hya hχ
  exact hψy (hy ψ hψ)

theorem wcpa_dj_lr1k_nsr_gub_bff_dc_ia_pbc_const : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω),
    ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) →
    ∀ (A : Type u) [CommRing A] [Algebra ↥W A] (ϖ : ↥W) (ζ : A), wcBffBase W A ϖ →
    (∀ a : A, ∃ w : ↥W, a = algebraMap ↥W A w) →
    ∀ e : ↥W, e ≠ 0 → ∀ y : wcGubGen W A,
      IsIntegral ↥(wcGubBox W A (fun _ : Fin 2 => ζ) e) y →
      y ∈ wcGubBox W A (fun _ : Fin 2 => ζ) e :=
by
  intro Ω _ W hdimW A _ _ ϖ ζ hbase hconst e he y hy
  classical
  have hbase' := hbase
  obtain ⟨hϖ0, hϖm, hdom, hic, hfp, htf, hred, _hdim⟩ := hbase'
  have hunitW : ∀ w : ↥W, w ≠ 0 →
      IsUnit (algebraMap A (wcGubGen W A) (algebraMap ↥W A w)) := by
    intro w hw
    exact IsLocalization.map_units (wcGubGen W A)
      (⟨algebraMap (↥W) A w, Submonoid.mem_map_of_mem _ (mem_nonZeroDivisors_of_ne_zero hw)⟩ :
        Submonoid.map (algebraMap (↥W) A) (nonZeroDivisors ↥W))
  obtain ⟨z, hz⟩ := hconst ζ
  obtain ⟨T, hT⟩ : ∃ T : wcGubGen W A, T = algebraMap A (wcGubGen W A) ζ *
      Ring.inverse (algebraMap A (wcGubGen W A) (algebraMap ↥W A e)) := ⟨_, rfl⟩
  have hTmem : T ∈ wcGubBox W A (fun _ : Fin 2 => ζ) e := by
    rw [hT]; exact Algebra.subset_adjoin ⟨0, rfl⟩
  by_cases hez : e ∣ z
  ·
    obtain ⟨v, hv⟩ := hez
    haveI := hdom
    haveI := hic
    have hTv : T = algebraMap A (wcGubGen W A) (algebraMap ↥W A v) := by
      have h1 := Ring.mul_inverse_cancel _ (hunitW e he)
      rw [hT, hz, hv, map_mul, map_mul]
      linear_combination (algebraMap A (wcGubGen W A) (algebraMap ↥W A v)) * h1
    have hbox : wcGubBox W A (fun _ : Fin 2 => ζ) e ≤ ⊥ := by
      apply Algebra.adjoin_le
      rintro _ ⟨i, rfl⟩
      show algebraMap A (wcGubGen W A) ζ *
        Ring.inverse (algebraMap A (wcGubGen W A) (algebraMap ↥W A e)) ∈
          (⊥ : Subalgebra A (wcGubGen W A))
      rw [← hT, hTv]
      exact Subalgebra.algebraMap_mem _ _
    haveI hBint : Algebra.IsIntegral A ↥(wcGubBox W A (fun _ : Fin 2 => ζ) e) := by
      refine ⟨fun x => ?_⟩
      obtain ⟨a, ha⟩ := Algebra.mem_bot.mp (hbox x.2)
      have hx : x = algebraMap A ↥(wcGubBox W A (fun _ : Fin 2 => ζ) e) a :=
        Subtype.ext ha.symm
      rw [hx]
      exact isIntegral_algebraMap
    have hyA : IsIntegral A y := isIntegral_trans (R := A) y hy
    have hg : ∀ m : Submonoid.map (algebraMap ↥W A) (nonZeroDivisors ↥W),
        IsUnit (algebraMap A (FractionRing A) (m : A)) := by
      rintro ⟨_, w, hw, rfl⟩
      have hw0 : w ≠ 0 := nonZeroDivisors.ne_zero hw
      have ha0 : algebraMap ↥W A w ≠ 0 := fun h =>
        one_ne_zero (htf w 1 hw0 (by rw [h, zero_mul]))
      exact isUnit_iff_ne_zero.mpr (IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors
        (mem_nonZeroDivisors_of_ne_zero ha0))
    obtain ⟨f, hf⟩ : ∃ f : wcGubGen W A →+* FractionRing A,
        f = IsLocalization.lift (S := wcGubGen W A) hg := ⟨_, rfl⟩
    have hfι : ∀ a : A, f (algebraMap A (wcGubGen W A) a) = algebraMap A (FractionRing A) a := by
      intro a
      rw [hf]
      exact IsLocalization.lift_eq hg a
    have hfinj : Function.Injective f := by
      rw [injective_iff_map_eq_zero]
      intro x hx
      obtain ⟨⟨a, m⟩, hxm⟩ :=
        IsLocalization.surj (Submonoid.map (algebraMap ↥W A) (nonZeroDivisors ↥W)) x
      have h1 : algebraMap A (FractionRing A) a = 0 := by
        rw [← hfι a, ← hxm, map_mul, hx, zero_mul]
      have h2 : a = 0 := IsFractionRing.injective A (FractionRing A) (by rw [h1, map_zero])
      have h3 : x * algebraMap A (wcGubGen W A) (m : A) = 0 := by
        rw [hxm, h2, map_zero]
      exact (IsUnit.mul_left_eq_zero (IsLocalization.map_units (wcGubGen W A) m)).mp h3
    have hfy : IsIntegral A (f y) :=
      IsIntegral.map_of_comp_eq (RingHom.id A) f
        (RingHom.ext fun a => by rw [RingHom.comp_apply, RingHom.comp_apply, hfι]; rfl) hyA
    obtain ⟨a, ha⟩ := IsIntegrallyClosed.isIntegral_iff.mp hfy
    have hya : y = algebraMap A (wcGubGen W A) a := hfinj (by rw [hfι, ha])
    rw [hya]
    exact Subalgebra.algebraMap_mem _ a
  ·
    obtain ⟨u, hu⟩ : z ∣ e := (ValuationRing.dvd_total e z).resolve_left hez
    have hu0 : u ≠ 0 := by
      rintro rfl
      exact he (by rw [hu, mul_zero])
    have hum : u ∈ IsLocalRing.maximalIdeal ↥W := by
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      intro hunit
      apply hez
      obtain ⟨u', hu'⟩ := hunit.exists_right_inv
      exact ⟨u', by rw [hu, mul_assoc, hu', mul_one]⟩
    have hpowdvd : ∀ w : ↥W, w ≠ 0 → ∃ K : ℕ, w ∣ u ^ K := by
      intro w hw
      by_cases hwm : w ∈ IsLocalRing.maximalIdeal ↥W
      · haveI : Ring.KrullDimLE 1 ↥W := Ring.krullDimLE_iff.mpr hdimW
        have hle : IsLocalRing.maximalIdeal ↥W ≤ (Ideal.span {w}).radical := by
          rw [Ideal.radical_eq_sInf]
          refine le_sInf ?_
          rintro P ⟨hPw, hPp⟩
          have hP0 : P ≠ ⊥ := by
            intro h
            apply hw
            have : w ∈ P := hPw (Ideal.mem_span_singleton_self w)
            rw [h] at this
            exact (Submodule.mem_bot _).mp this
          haveI := hPp
          have hPmax : P.IsMaximal := Ideal.isMaximal_of_isPrime_of_ne_bot P hP0
          exact le_of_eq (IsLocalRing.eq_maximalIdeal hPmax).symm
        obtain ⟨K, hK⟩ := hle hum
        exact ⟨K, Ideal.mem_span_singleton.mp hK⟩
      · have hwu : IsUnit w := by
          by_contra h
          exact hwm ((IsLocalRing.mem_maximalIdeal w).mpr h)
        exact ⟨0, hwu.dvd⟩
    have H1 : T * algebraMap A (wcGubGen W A) (algebraMap ↥W A u) = 1 := by
      have h1 := Ring.inverse_mul_cancel _ (hunitW e he)
      have h2 : algebraMap A (wcGubGen W A) (algebraMap ↥W A e) =
          algebraMap A (wcGubGen W A) (algebraMap ↥W A z) *
            algebraMap A (wcGubGen W A) (algebraMap ↥W A u) := by
        rw [hu, map_mul, map_mul]
      rw [hT, hz]
      linear_combination h1 -
        Ring.inverse (algebraMap A (wcGubGen W A) (algebraMap ↥W A e)) * h2
    obtain ⟨⟨a, m⟩, hym⟩ :=
      IsLocalization.surj (Submonoid.map (algebraMap ↥W A) (nonZeroDivisors ↥W)) y
    obtain ⟨w, hw, hwm⟩ := Submonoid.mem_map.mp m.2
    have hw0 : w ≠ 0 := nonZeroDivisors.ne_zero hw
    obtain ⟨K, v, hv⟩ := hpowdvd w hw0
    have E1 : y * algebraMap A (wcGubGen W A) (algebraMap ↥W A w) =
        algebraMap A (wcGubGen W A) a := by
      rw [hwm]; exact hym
    have E2 : algebraMap A (wcGubGen W A) (algebraMap ↥W A w) *
        algebraMap A (wcGubGen W A) (algebraMap ↥W A v) * T ^ K = 1 := by
      have h0 : algebraMap A (wcGubGen W A) (algebraMap ↥W A w) *
          algebraMap A (wcGubGen W A) (algebraMap ↥W A v) =
          algebraMap A (wcGubGen W A) (algebraMap ↥W A u) ^ K := by
        rw [← map_mul, ← map_mul, ← hv, map_pow, map_pow]
      rw [h0, ← mul_pow, mul_comm _ T, H1, one_pow]
    have hyeq : y = algebraMap A (wcGubGen W A) a *
        algebraMap A (wcGubGen W A) (algebraMap ↥W A v) * T ^ K := by
      linear_combination (algebraMap A (wcGubGen W A) (algebraMap ↥W A v) * T ^ K) * E1 - y * E2
    rw [hyeq]
    exact Subalgebra.mul_mem _ (Subalgebra.mul_mem _ (Subalgebra.algebraMap_mem _ a)
      (Subalgebra.algebraMap_mem _ (algebraMap ↥W A v))) (Subalgebra.pow_mem _ hTmem K)

theorem wcpa_dj_lr1k_nsr_gub_bff_dc_ia_os_lb_fp_algebraic : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A] [Algebra ↥W A], IsDomain A → Algebra.FiniteType ↥W A → (∀ (w : ↥W) (a : A), w ≠ 0 → algebraMap ↥W A w * a = 0 → a = 0) → ringKrullDim (wcGubGen W A) ≤ 1 → ∀ z : A, z ≠ 0 → ∀ a : A, ∃ Q : Polynomial ↥W, Q ≠ 0 ∧ Polynomial.aeval a Q ∈ Ideal.span {z} :=
by
  intro Ω _ W A _ _ hdom hFT htf hdim z hz a
  classical

  have s1 : ∀ (B : Type u) [CommRing B] [IsDomain B], ringKrullDim B ≤ 1 → ∀ z : B, z ≠ 0 →
      Ring.KrullDimLE 0 (B ⧸ Ideal.span {z}) := by
    intro B _ _ hB z hz
    haveI : Ring.KrullDimLE 1 B := by
      rw [Ring.krullDimLE_iff]; exact_mod_cast hB
    refine Ring.KrullDimLE.mk₀ ?_
    intro 𝔮 h𝔮
    have hsurj : Function.Surjective (Ideal.Quotient.mk (Ideal.span {z})) :=
      Ideal.Quotient.mk_surjective
    haveI hP : (𝔮.comap (Ideal.Quotient.mk (Ideal.span {z}))).IsPrime := Ideal.comap_isPrime _ 𝔮
    have hzP : z ∈ 𝔮.comap (Ideal.Quotient.mk (Ideal.span {z})) := by
      rw [Ideal.mem_comap]
      have : Ideal.Quotient.mk (Ideal.span {z}) z = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self z)
      rw [this]; exact 𝔮.zero_mem
    have hPne : 𝔮.comap (Ideal.Quotient.mk (Ideal.span {z})) ≠ ⊥ := by
      intro h; rw [h] at hzP; exact hz ((Submodule.mem_bot _).mp hzP)
    have hPmax : (𝔮.comap (Ideal.Quotient.mk (Ideal.span {z}))).IsMaximal :=
      Ring.krullDimLE_one_iff_of_isPrime_bot.mp inferInstance _ hPne hP
    have hmap := Ideal.map_comap_of_surjective _ hsurj 𝔮
    rcases Ideal.map_eq_top_or_isMaximal_of_surjective _ hsurj hPmax with h | h
    · rw [hmap] at h; exact absurd h h𝔮.ne_top
    · rw [hmap] at h; exact h

  have s2 : ∀ (K B : Type u) [Field K] [CommRing B] (φ : K →+* B), φ.FiniteType →
      ∀ (I : Ideal B), Ring.KrullDimLE 0 (B ⧸ I) → ∀ x : B,
      ∃ q : Polynomial K, q.Monic ∧ Polynomial.eval₂ φ x q ∈ I := by
    intro K B _ _ φ hφ I hI x
    letI : Algebra K B := φ.toAlgebra
    haveI : Algebra.FiniteType K B := hφ
    haveI : Algebra.FiniteType K (B ⧸ I) :=
      Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ K I) (Ideal.Quotient.mkₐ_surjective K I)
    haveI : Module.Finite K (B ⧸ I) := (Module.finite_iff_krullDimLE_zero K (B ⧸ I)).mpr hI
    obtain ⟨q, hqm, hq⟩ := IsIntegral.of_finite K (Ideal.Quotient.mk I x)
    refine ⟨q, hqm, ?_⟩
    rw [← Ideal.Quotient.eq_zero_iff_mem, Polynomial.hom_eval₂]
    exact hq

  have hwne : ∀ w ∈ nonZeroDivisors ↥W, algebraMap ↥W A w ≠ 0 := by
    intro w hw h
    have := htf w 1 (nonZeroDivisors.ne_zero hw) (by rw [h, zero_mul])
    exact one_ne_zero this
  have hS : Submonoid.map (algebraMap ↥W A) (nonZeroDivisors ↥W) ≤ nonZeroDivisors A := by
    rintro s ⟨w, hw, rfl⟩
    exact mem_nonZeroDivisors_of_ne_zero (hwne w hw)
  haveI : IsDomain (wcGubGen W A) := IsLocalization.isDomain_of_le_nonZeroDivisors (wcGubGen W A) hS
  have hinj : Function.Injective (algebraMap A (wcGubGen W A)) :=
    IsLocalization.injective (wcGubGen W A) hS
  have hφ := RingHom.finiteType_localizationPreserves (algebraMap ↥W A) (nonZeroDivisors ↥W)
    (FractionRing ↥W) (wcGubGen W A) (RingHom.finiteType_algebraMap.mpr hFT)
  set φ : FractionRing ↥W →+* wcGubGen W A := IsLocalization.map (wcGubGen W A) (algebraMap ↥W A)
    (Submonoid.le_comap_map (nonZeroDivisors ↥W)) with hφdef
  have hcomp : φ.comp (algebraMap ↥W (FractionRing ↥W)) =
      (algebraMap A (wcGubGen W A)).comp (algebraMap ↥W A) := IsLocalization.map_comp _
  have hz' : algebraMap A (wcGubGen W A) z ≠ 0 := fun h => hz (hinj (h.trans (map_zero _).symm))
  have h0 := s1 (wcGubGen W A) hdim _ hz'
  obtain ⟨q, hqm, hq⟩ := s2 _ _ φ hφ _ h0 (algebraMap A (wcGubGen W A) a)
  obtain ⟨b, hb⟩ := IsLocalization.integerNormalization_spec (nonZeroDivisors ↥W) q
  have hQ₀ : IsLocalization.integerNormalization (nonZeroDivisors ↥W) q ≠ 0 := by
    intro h
    exact hqm.ne_zero ((IsLocalization.integerNormalization_eq_zero_iff le_rfl q).mp h)
  have hmap : (IsLocalization.integerNormalization (nonZeroDivisors ↥W) q).map
      (algebraMap ↥W (FractionRing ↥W)) = Polynomial.C (algebraMap ↥W (FractionRing ↥W) b) * q := by
    rw [hb.2]
    ext i
    rw [Polynomial.coeff_smul, Polynomial.coeff_C_mul, Algebra.smul_def]
  have key : algebraMap A (wcGubGen W A)
      (Polynomial.aeval a (IsLocalization.integerNormalization (nonZeroDivisors ↥W) q)) ∈
      Ideal.span {algebraMap A (wcGubGen W A) z} := by
    have e1 : algebraMap A (wcGubGen W A)
        (Polynomial.aeval a (IsLocalization.integerNormalization (nonZeroDivisors ↥W) q)) =
        Polynomial.eval₂ φ (algebraMap A (wcGubGen W A) a)
          ((IsLocalization.integerNormalization (nonZeroDivisors ↥W) q).map
            (algebraMap ↥W (FractionRing ↥W))) := by
      rw [Polynomial.eval₂_map, hcomp, Polynomial.aeval_def, Polynomial.hom_eval₂]
    rw [e1, hmap, Polynomial.eval₂_mul, Polynomial.eval₂_C]
    exact Ideal.mul_mem_left _ _ hq
  obtain ⟨g, hg⟩ := Ideal.mem_span_singleton'.mp key
  obtain ⟨⟨c, s⟩, hcs⟩ := IsLocalization.surj (Submonoid.map (algebraMap ↥W A) (nonZeroDivisors ↥W)) g
  obtain ⟨w, hw, hws⟩ := Submonoid.mem_map.mp s.2
  have hrel : Polynomial.aeval a (IsLocalization.integerNormalization (nonZeroDivisors ↥W) q) *
      algebraMap ↥W A w = c * z := by
    apply hinj
    rw [map_mul, map_mul, hws, ← hg]
    simp only at hcs
    rw [← hcs]
    ring
  refine ⟨Polynomial.C w * IsLocalization.integerNormalization (nonZeroDivisors ↥W) q,
    mul_ne_zero (Polynomial.C_ne_zero.mpr (nonZeroDivisors.ne_zero hw)) hQ₀, ?_⟩
  rw [Ideal.mem_span_singleton', Polynomial.aeval_mul, Polynomial.aeval_C, mul_comm, hrel]
  exact ⟨c, rfl⟩

theorem wcpa_dj_lr1k_nsr_gub_bff_dc_ia_os_lb_fp_integral : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), (∀ (v μ : ↥W), v ≠ 0 → μ ∈ IsLocalRing.maximalIdeal ↥W → ∃ n : ℕ, v ∣ μ ^ n) → ∀ (A : Type u) [CommRing A] [Algebra ↥W A] (N : Ideal A), (∀ (c : ↥W) (y : A), c ≠ 0 → algebraMap ↥W A c * y ∈ N → y ∈ N) → (∀ y : A, (∀ v : ↥W, v ≠ 0 → y ∈ N ⊔ Ideal.span {algebraMap ↥W A v}) → y ∈ N) → ∀ (a : A) (Q : Polynomial ↥W), Q ≠ 0 → Polynomial.aeval a Q ∈ N → ∃ P : Polynomial ↥W, P.Monic ∧ Polynomial.aeval a P ∈ N :=
by
  intro Ω _ _ W harch A _ _ N htf hsep a Q hQ0 hQ
  classical
  have ι_inj : Function.Injective (algebraMap ↥W Ω) := fun x y h => Subtype.ext h

  have absorb : ∀ (k : ↥W) (y : A), k ∈ IsLocalRing.maximalIdeal ↥W →
      (1 - algebraMap ↥W A k * a) * y ∈ N → y ∈ N := by
    intro k y hk hy
    have hiter : ∀ n : ℕ, y - (algebraMap ↥W A k * a) ^ n * y ∈ N := by
      intro n
      induction n with
      | zero => simp
      | succ n ih =>
        have e : y - (algebraMap ↥W A k * a) ^ (n + 1) * y
            = (y - (algebraMap ↥W A k * a) ^ n * y)
              + (algebraMap ↥W A k * a) ^ n * ((1 - algebraMap ↥W A k * a) * y) := by ring
        rw [e]
        exact N.add_mem ih (N.mul_mem_left _ hy)
    apply hsep
    intro v hv
    obtain ⟨n, x, hx⟩ := harch v k hv hk
    have e1 : (algebraMap ↥W A k * a) ^ n = algebraMap ↥W A v * algebraMap ↥W A x * a ^ n := by
      rw [mul_pow, ← map_pow, hx, map_mul]
    have e2 : y = (y - (algebraMap ↥W A k * a) ^ n * y)
        + algebraMap ↥W A v * (algebraMap ↥W A x * a ^ n * y) := by
      rw [e1]; ring
    rw [e2]
    exact Submodule.add_mem_sup (hiter n)
      (Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _))

  have one_sub : ∀ (Q : Polynomial ↥W) (l : Ω), l ∉ W →
      Polynomial.eval l (Q.map (algebraMap ↥W Ω)) = 0 →
      ∃ (k : ↥W) (G : Polynomial ↥W), k ∈ IsLocalRing.maximalIdeal ↥W ∧ (k : Ω) * l = 1 ∧
        Q = (1 - Polynomial.C k * Polynomial.X) * G := by
    intro Q l hl hroot
    have hl0 : l ≠ 0 := by rintro rfl; exact hl W.zero_mem
    have hinv : l⁻¹ ∈ W := (W.mem_or_inv_mem l).resolve_left hl
    obtain ⟨k, hk⟩ : ∃ k : ↥W, (k : Ω) = l⁻¹ := ⟨⟨l⁻¹, hinv⟩, rfl⟩
    have hkl : (k : Ω) * l = 1 := by rw [hk]; exact inv_mul_cancel₀ hl0
    have hkm : k ∈ IsLocalRing.maximalIdeal ↥W := by
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      rintro ⟨u, hu⟩
      apply hl
      have h0 : ((u⁻¹ : (↥W)ˣ) : ↥W) * k = 1 := by rw [← hu]; exact u.inv_mul
      have h1 : (((u⁻¹ : (↥W)ˣ) : ↥W) : Ω) * l⁻¹ = 1 := by
        rw [← hk]
        exact congrArg Subtype.val h0
      have h2 : (((u⁻¹ : (↥W)ˣ) : ↥W) : Ω) = l := by
        calc (((u⁻¹ : (↥W)ˣ) : ↥W) : Ω) = (((u⁻¹ : (↥W)ˣ) : ↥W) : Ω) * l⁻¹ * l := by
              rw [mul_assoc, inv_mul_cancel₀ hl0, mul_one]
          _ = l := by rw [h1, one_mul]
      rw [← h2]
      exact ((u⁻¹ : (↥W)ˣ) : ↥W).2
    have hdiv : (Polynomial.X - Polynomial.C l) * ((Q.map (algebraMap ↥W Ω)) /ₘ
        (Polynomial.X - Polynomial.C l)) = Q.map (algebraMap ↥W Ω) :=
      Polynomial.mul_divByMonic_eq_iff_isRoot.mpr hroot
    set H := (Q.map (algebraMap ↥W Ω)) /ₘ (Polynomial.X - Polynomial.C l) with hH
    set H' : Polynomial Ω := -(Polynomial.C l * H) with hH'
    have hC : Polynomial.C (algebraMap ↥W Ω k) * Polynomial.C l = 1 := by
      rw [← Polynomial.C_mul, show algebraMap ↥W Ω k * l = 1 from hkl, Polynomial.C_1]
    have hfac : Q.map (algebraMap ↥W Ω) =
        H' - Polynomial.C (algebraMap ↥W Ω k) * (Polynomial.X * H') := by
      rw [hH']
      linear_combination (-1 : Polynomial Ω) * hdiv - Polynomial.X * H * hC
    have hcoeff0 : (Q.map (algebraMap ↥W Ω)).coeff 0 = H'.coeff 0 := by
      rw [hfac, Polynomial.coeff_sub, Polynomial.coeff_C_mul, Polynomial.coeff_X_mul_zero,
        mul_zero, sub_zero]
    have hcoeffS : ∀ j : ℕ, (Q.map (algebraMap ↥W Ω)).coeff (j + 1) =
        H'.coeff (j + 1) - algebraMap ↥W Ω k * H'.coeff j := by
      intro j
      rw [hfac, Polynomial.coeff_sub, Polynomial.coeff_C_mul, Polynomial.coeff_X_mul]
    have hlift : ∀ j : ℕ, H'.coeff j ∈ Set.range (algebraMap ↥W Ω) := by
      intro j
      induction j with
      | zero =>
        refine ⟨Q.coeff 0, ?_⟩
        rw [← hcoeff0, Polynomial.coeff_map]
      | succ j ih =>
        obtain ⟨w, hw⟩ := ih
        refine ⟨Q.coeff (j + 1) + k * w, ?_⟩
        have := hcoeffS j
        rw [Polynomial.coeff_map] at this
        rw [map_add, map_mul, hw, this]
        ring
    obtain ⟨G, hG⟩ := (Polynomial.mem_lifts _).mp
      ((Polynomial.lifts_iff_coeff_lifts _).mpr hlift)
    refine ⟨k, G, hkm, hkl, ?_⟩
    apply Polynomial.map_injective _ ι_inj
    rw [Polynomial.map_mul, hG, Polynomial.map_sub, Polynomial.map_one, Polynomial.map_mul,
      Polynomial.map_C, Polynomial.map_X, hfac]
    ring

  have main : ∀ n : ℕ, ∀ M Q : Polynomial ↥W, M.Monic → Q ≠ 0 → Q.natDegree ≤ n →
      Polynomial.aeval a M * Polynomial.aeval a Q ∈ N →
      ∃ P : Polynomial ↥W, P.Monic ∧ Polynomial.aeval a P ∈ N := by
    intro n
    induction n with
    | zero =>
      intro M Q hM hQ0 hdeg hMQ
      have hQC := Polynomial.eq_C_of_natDegree_le_zero hdeg
      have hq : Q.coeff 0 ≠ 0 := by
        intro h; apply hQ0; rw [hQC, h, map_zero]
      refine ⟨M, hM, htf (Q.coeff 0) _ hq ?_⟩
      rw [hQC, Polynomial.aeval_C] at hMQ
      rwa [mul_comm] at hMQ
    | succ n ih =>
      intro M Q hM hQ0 hdeg hMQ
      by_cases hle : Q.natDegree ≤ n
      · exact ih M Q hM hQ0 hle hMQ
      have hdeq : Q.natDegree = n + 1 := by omega
      have hdegmap : (Q.map (algebraMap ↥W Ω)).degree ≠ 0 := by
        rw [Polynomial.degree_map_eq_of_injective ι_inj, Polynomial.degree_eq_natDegree hQ0, hdeq]
        exact_mod_cast (Nat.succ_ne_zero n)
      obtain ⟨l, hl⟩ := IsAlgClosed.exists_root _ hdegmap
      by_cases hlW : l ∈ W
      · obtain ⟨c, hc⟩ : ∃ c : ↥W, algebraMap ↥W Ω c = l := ⟨⟨l, hlW⟩, rfl⟩
        have hroot : Q.IsRoot c := by
          have h1 : algebraMap ↥W Ω (Q.eval c) = 0 := by
            rw [← Polynomial.eval₂_at_apply, ← Polynomial.eval_map, hc]
            exact hl
          exact ι_inj (h1.trans (map_zero _).symm)
        obtain ⟨Q₁, hdiv⟩ : ∃ Q₁, (Polynomial.X - Polynomial.C c) * Q₁ = Q :=
          ⟨_, Polynomial.mul_divByMonic_eq_iff_isRoot.mpr hroot⟩
        have hQ₁0 : Q₁ ≠ 0 := by intro h; apply hQ0; rw [← hdiv, h, mul_zero]
        have hQ₁deg : Q₁.natDegree ≤ n := by
          have := Polynomial.natDegree_mul (Polynomial.X_sub_C_ne_zero c) hQ₁0
          rw [hdiv, Polynomial.natDegree_X_sub_C, hdeq] at this
          omega
        refine ih (M * (Polynomial.X - Polynomial.C c)) Q₁
          (hM.mul (Polynomial.monic_X_sub_C c)) hQ₁0 hQ₁deg ?_
        rw [← hdiv, map_mul] at hMQ
        rw [map_mul]
        convert hMQ using 1
        ring
      · obtain ⟨k, G, hkm, hkl, hQG⟩ := one_sub Q l hlW hl
        have hk0 : k ≠ 0 := by
          rintro rfl
          simp at hkl
        have hG0 : G ≠ 0 := by
          rintro rfl; apply hQ0; rw [hQG, mul_zero]
        have hlindeg : (1 - Polynomial.C k * Polynomial.X : Polynomial ↥W).natDegree = 1 := by
          have e : (1 - Polynomial.C k * Polynomial.X : Polynomial ↥W)
              = Polynomial.C (-k) * Polynomial.X + Polynomial.C 1 := by
            simp only [map_neg, map_one]; ring
          rw [e, Polynomial.natDegree_linear (neg_ne_zero.mpr hk0)]
        have hlin0 : (1 - Polynomial.C k * Polynomial.X : Polynomial ↥W) ≠ 0 := by
          intro h; rw [h, Polynomial.natDegree_zero] at hlindeg; exact zero_ne_one hlindeg
        have hGdeg : G.natDegree ≤ n := by
