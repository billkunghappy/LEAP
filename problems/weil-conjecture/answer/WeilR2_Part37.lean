      let Q₂ : PrimeSpectrum (Z.presheaf.stalk t) := IsLocalRing.closedPoint (Z.presheaf.stalk t)
      have h01 : Q₀ < Q₁ := lt_of_le_of_ne ((PrimeSpectrum.le_iff_specializes Q₀ Q₁).mpr s01)
        (fun h => hξeq (by rw [← hP₀, ← hP₁]; exact congrArg (Z.fromSpecStalk t) h))
      have h12 : Q₁ < Q₂ :=
        lt_of_le_of_ne ((PrimeSpectrum.le_iff_specializes Q₁ Q₂).mpr s12)
          (fun h => hne (by
            rw [← hP₁]
            exact (congrArg (Z.fromSpecStalk t) h).trans Scheme.fromSpecStalk_closedPoint))
      have hmono : StrictMono ![Q₀, Q₁, Q₂] := by
        refine Fin.strictMono_iff_lt_succ.mpr ?_
        intro i
        fin_cases i
        · exact h01
        · exact h12
      let L : LTSeries (PrimeSpectrum (Z.presheaf.stalk t)) := LTSeries.mk 2 ![Q₀, Q₁, Q₂] hmono
      have hL := Order.LTSeries.length_le_krullDim L
      have h2 : ((2 : ℕ) : WithBot ℕ∞) ≤ ((1 : ℕ) : WithBot ℕ∞) := le_trans hL hdim
      norm_num at h2

  have count : ∀ {α β : Type u} (B : Set α) (S : Set β) (b₀ : β) (F : ∀ a ∈ B, β),
