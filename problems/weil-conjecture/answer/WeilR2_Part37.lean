  have hOx : ∀ y, y ∈ O ↔ ¬ (wcpaDjLkImg W (γ ≫ ι) uX y = wcpaDjLkImg W (γ ≫ ι) uX y₀) := by
    intro y
    rw [hO, ← SetLike.mem_coe, hV, Set.mem_compl_singleton_iff]
  have hQ : ∀ a, r (wcpaDjLkImg W (γ ≫ ι') (r ≫ uX) a) = wcpaDjLkImg W (γ ≫ ι) uX y₀ ↔
      wcpaDjLkImg W (γ ≫ ι) uX (G a) = wcpaDjLkImg W (γ ≫ ι) uX y₀ := by
    intro a
    rw [hImg]
  have hgen : ∀ ξ : ↥(wcpaDjLkFib W (γ ≫ ι) uX),
      closure ({ξ} : Set ↥(wcpaDjLkFib W (γ ≫ ι) uX)) ∈
        irreducibleComponents ↥(wcpaDjLkFib W (γ ≫ ι) uX) → ξ ∈ O := by
    intro ξ hξ
    rw [hOx]
    intro hx
    obtain ⟨y, hyE, hy⟩ := wcpa_dj_lr1k_ebcn_no_isolated Ω W hW hWt C γ hcov X uX ι hM
      (wcpaDjLkImg W (γ ≫ ι) uX y₀) _ hξ
    have hsp : ξ ⤳ y := specializes_iff_mem_closure.mpr hyE
    have hsp2 : wcpaDjLkImg W (γ ≫ ι) uX ξ ⤳ wcpaDjLkImg W (γ ≫ ι) uX y :=
      (hsp.map (Scheme.Hom.continuous _)).map (Scheme.Hom.continuous _)
    rw [hx] at hsp2
    have hmem : wcpaDjLkImg W (γ ≫ ι) uX y ∈ closure {wcpaDjLkImg W (γ ≫ ι) uX y₀} :=
      specializes_iff_mem_closure.mp hsp2
    rw [hxcl.closure_eq] at hmem
    exact hy (Set.mem_singleton_iff.mp hmem)
  exact glue _ _ G O (fun y => wcpaDjLkImg W (γ ≫ ι) uX y = wcpaDjLkImg W (γ ≫ ι) uX y₀)
    (fun a => r (wcpaDjLkImg W (γ ≫ ι') (r ≫ uX) a) = wcpaDjLkImg W (γ ≫ ι) uX y₀)
    hGiso hUC hOx hQ hgen

theorem wcpa_dj_lr1k_ll_fibre_invariants : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (C : Scheme.{u}) (γ : C ⟶ wcProjK Ω 1), wcpaDjLkCov Ω γ → wcpaDjLkGalois γ →
    ∀ (X : Scheme.{u}) (uX : X ⟶ Spec (.of ↥W)) (ι : wcProjK Ω 1 ⟶ X)
      [QuasiCompact (γ ≫ ι)] [QuasiSeparated (γ ≫ ι)],
    wcpaDjLkModel W uX ι →
    ∀ y y' : ↥(wcpaDjLkFib W (γ ≫ ι) uX),
      wcpaDjLkImg W (γ ≫ ι) uX y = wcpaDjLkImg W (γ ≫ ι) uX y' →
