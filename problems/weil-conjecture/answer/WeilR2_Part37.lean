      rw [← map_mul, hb, ← hy]
    · rintro ⟨b, hb⟩
      have h1 : U.topIso.hom.hom y ∈ RingHom.ker ((ΔU ≫ U.ι).app U).hom := by
        rw [hker, Ideal.mem_span_singleton']
