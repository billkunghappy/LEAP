  rw [map_mul]
  by_contra hge
  push_neg at hge
  have e1 : V.valuation ε = 1 :=
    le_antisymm hvε (le_trans hge (mul_le_of_le_one_right' hvε1))
  have e2 : V.valuation (ε - 1) = 1 := by
    rw [e1, one_mul] at hge
    exact le_antisymm hvε1 hge
  rw [e1, e2, one_pow, one_pow, one_mul] at hsmall
  exact lt_irrefl _ hsmall

theorem wcpa_dj_lr1k_nsr_nafc_dominated_residue : ∀ (R : Type u) [CommRing R] [IsLocalRing R]
    (L : Type u) [Field L] (j : R →+* L),
    (∀ z : L, (∃ q : Polynomial R, q.Monic ∧ q.eval₂ j z = 0) → ∃ e : R, j e = z) →
    ∀ x : L, (∀ V : ValuationSubring L, (∀ s : R, V.valuation (j s) ≤ 1) →
        (∀ s ∈ IsLocalRing.maximalIdeal R, V.valuation (j s) < 1) →
        x ∈ V ∧ V.valuation (x * (x - 1)) < 1) →
    ∃ e : R, j e = x ∧ e * (e - 1) ∈ IsLocalRing.maximalIdeal R :=
by
  intro R _ _ L _ j hint x hx
  classical

  have key : ∀ (S : Type u) [CommRing S] [IsLocalRing S] (ψ : S →+* L),
      ∃ V : ValuationSubring L, (∀ z, ψ z ∈ V) ∧
        (∀ z ∈ IsLocalRing.maximalIdeal S, V.valuation (ψ z) < 1) := by
    intro S _ _ ψ
    obtain ⟨V, hV, hloc⟩ := IsLocalRing.exists_factor_valuationRing ψ
    refine ⟨V, hV, ?_⟩
    intro z hz
    by_contra hlt
    have hle : V.valuation (ψ z) ≤ 1 := (V.valuation_le_one_iff _).mpr (hV z)
    have heq : V.valuation (ψ z) = 1 := le_antisymm hle (not_lt.mp hlt)
    have hne : ψ z ≠ 0 := by
      intro h0
      rw [h0, map_zero] at heq
      exact zero_ne_one heq
    have hinv : (ψ z)⁻¹ ∈ V := by
      rw [← V.valuation_le_one_iff, map_inv₀, heq, inv_one]
    have hu : IsUnit (ψ.codRestrict V.toSubring hV z) := by
      refine IsUnit.of_mul_eq_one (⟨(ψ z)⁻¹, hinv⟩ : V.toSubring) ?_
      apply Subtype.ext
      simp [mul_inv_cancel₀ hne]
    exact (IsLocalRing.mem_maximalIdeal _).mp hz (isUnit_of_map_unit _ _ hu)

  have hxint : ∃ q : Polynomial R, q.Monic ∧ q.eval₂ j x = 0 := by
    by_cases hx0 : x = 0
    · exact ⟨Polynomial.X, Polynomial.monic_X, by rw [Polynomial.eval₂_X, hx0]⟩
    by_cases hf : ∃ f : Polynomial R, f.eval₂ j x⁻¹ = 0 ∧
        f.coeff 0 ∉ IsLocalRing.maximalIdeal R
    · obtain ⟨f, hf0, hfm⟩ := hf
      have hu : IsUnit (f.coeff 0) := IsLocalRing.notMem_maximalIdeal.mp hfm
      have hne : f.coeff 0 ≠ 0 := hu.ne_zero
      refine ⟨Polynomial.C (↑hu.unit⁻¹ : R) * f.reverse, ?_, ?_⟩
      · apply Polynomial.monic_C_mul_of_mul_leadingCoeff_eq_one
        rw [Polynomial.reverse_leadingCoeff, Polynomial.trailingCoeff_eq_coeff_zero hne]
        exact hu.val_inv_mul
      · letI : Invertible (x⁻¹) := invertibleOfNonzero (inv_ne_zero hx0)
        have h2 := (Polynomial.eval₂_reverse_eq_zero_iff j x⁻¹ f).mpr hf0
        have h3 : (⅟(x⁻¹) : L) = x := by rw [invOf_eq_inv, inv_inv]
        rw [h3] at h2
        rw [Polynomial.eval₂_mul, h2, mul_zero]
    · push_neg at hf
      set J : Ideal (Polynomial R) :=
        Ideal.comap (Polynomial.constantCoeff : Polynomial R →+* R) (IsLocalRing.maximalIdeal R)
        with hJ
      have hJmem : ∀ t : Polynomial R, t ∈ J ↔ t.coeff 0 ∈ IsLocalRing.maximalIdeal R := by
        intro t
        rw [hJ, Ideal.mem_comap, Polynomial.constantCoeff_apply]
      haveI : J.IsPrime := Ideal.comap_isPrime _ _
      set φ : Polynomial R →+* L := Polynomial.eval₂RingHom j x⁻¹ with hφ
      have hφu : ∀ t : J.primeCompl, IsUnit (φ t) := by
        intro t
        apply isUnit_iff_ne_zero.mpr
        intro h0
        apply t.2
        show t.1 ∈ J
        rw [hJmem]
        exact hf t h0
      set ψ : Localization.AtPrime J →+* L :=
        IsLocalization.lift (M := J.primeCompl) (S := Localization.AtPrime J) hφu with hψ
      obtain ⟨V, hV, hVm⟩ := key (Localization.AtPrime J) ψ
      have hψe : ∀ t : Polynomial R, ψ (algebraMap (Polynomial R) (Localization.AtPrime J) t) = φ t :=
        fun t => IsLocalization.lift_eq hφu t
      have hK : ∀ t ∈ J, V.valuation (φ t) < 1 := by
        intro t ht
        rw [← hψe]
        apply hVm
        exact (IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime J) J t).mpr ht
      have h1 : ∀ s : R, V.valuation (j s) ≤ 1 := by
        intro s
        have : j s = ψ (algebraMap (Polynomial R) (Localization.AtPrime J) (Polynomial.C s)) := by
          rw [hψe, hφ, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
        rw [this, V.valuation_le_one_iff]
        exact hV _
      have h2 : ∀ s ∈ IsLocalRing.maximalIdeal R, V.valuation (j s) < 1 := by
        intro s hs
        have : j s = φ (Polynomial.C s) := by
          rw [hφ, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
        rw [this]
        apply hK
        rw [hJmem, Polynomial.coeff_C_zero]
        exact hs
      have h3 : V.valuation x⁻¹ < 1 := by
        have : x⁻¹ = φ Polynomial.X := by
          rw [hφ, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X]
        rw [this]
        apply hK
        rw [hJmem, Polynomial.coeff_X_zero]
        exact zero_mem _
      have hxV : V.valuation x ≤ 1 := (V.valuation_le_one_iff _).mpr (hx V h1 h2).1
      exfalso
      have : (1 : ValuationSubring.ValueGroup V) < 1 :=
        calc (1 : ValuationSubring.ValueGroup V) = V.valuation (x * x⁻¹) := by
              rw [mul_inv_cancel₀ hx0, map_one]
          _ = V.valuation x * V.valuation x⁻¹ := map_mul _ _ _
          _ ≤ 1 * V.valuation x⁻¹ := mul_le_mul' hxV le_rfl
          _ = V.valuation x⁻¹ := one_mul _
          _ < 1 := h3
      exact lt_irrefl _ this
  obtain ⟨e, he⟩ := hint x hxint
  refine ⟨e, he, ?_⟩
  obtain ⟨V, hV, hVm⟩ := key R j
  have h1 : ∀ s : R, V.valuation (j s) ≤ 1 := fun s => (V.valuation_le_one_iff _).mpr (hV s)
  have hlt := (hx V h1 hVm).2
  have hje : j (e * (e - 1)) = x * (x - 1) := by
    rw [map_mul, map_sub, map_one, he]
  rw [← hje] at hlt
  by_contra hm
  obtain ⟨w, hw⟩ := IsLocalRing.notMem_maximalIdeal.mp hm
  rw [← hw] at hlt
  have : (1 : ValuationSubring.ValueGroup V) < 1 :=
    calc (1 : ValuationSubring.ValueGroup V) = V.valuation (j (↑w * ↑w⁻¹)) := by
          rw [Units.mul_inv, map_one, map_one]
      _ = V.valuation (j ↑w) * V.valuation (j ↑w⁻¹) := by rw [map_mul, map_mul]
      _ ≤ V.valuation (j ↑w) * 1 := mul_le_mul' le_rfl (h1 _)
      _ = V.valuation (j ↑w) := mul_one _
      _ < 1 := hlt
  exact lt_irrefl _ this

theorem wcpa_dj_lr1k_nsr_nafc_constant_on_preconnected : ∀ (C Y : Scheme.{u})
    [AlgebraicGeometry.IsIntegral C] (h : C ⟶ Y) (T : Set ↥Y), _root_.IsPreconnected T →
    ∀ (ε : C.functionField) (hT : ∀ m ∈ T, h (genericPoint ↥C) ⤳ m),
    (∀ m (hm : m ∈ T), Function.Injective (wcLr1uGerm h m (hT m hm)).hom) →
    (∀ m (hm : m ∈ T), ∃ e : ↥(Y.presheaf.stalk m), (wcLr1uGerm h m (hT m hm)).hom e = ε ∧
        e * (e - 1) ∈ IsLocalRing.maximalIdeal ↥(Y.presheaf.stalk m)) →
    (∀ m (hm : m ∈ T), ∀ e : ↥(Y.presheaf.stalk m), (wcLr1uGerm h m (hT m hm)).hom e = ε →
        e ∈ IsLocalRing.maximalIdeal ↥(Y.presheaf.stalk m)) ∨
    (∀ m (hm : m ∈ T), ∀ e : ↥(Y.presheaf.stalk m), (wcLr1uGerm h m (hT m hm)).hom e = ε →
        e - 1 ∈ IsLocalRing.maximalIdeal ↥(Y.presheaf.stalk m)) :=
by
  intro C Y _ h T hTc ε hT hinj hreg
  classical
  choose e he1 he2 using hreg
  have hext : ∀ m (hm : m ∈ T), ∃ (U : Y.Opens) (hmU : m ∈ U) (s : Γ(Y, U)),
      (Y.presheaf.germ U m hmU).hom s = e m hm :=
    fun m hm => TopCat.Presheaf.exists_germ_eq _ (e m hm)
  choose U hmU s hs using hext
  have hindep : ∀ (V : Y.Opens) (t : Γ(Y, V)) (x : Y) (hx : x ∈ V)
      (hxs : h (genericPoint C) ⤳ x),
      (wcLr1uGerm h x hxs).hom ((Y.presheaf.germ V x hx).hom t) =
        (h.stalkMap (genericPoint C)).hom
          ((Y.presheaf.germ V (h (genericPoint C)) (hxs.mem_open V.isOpen hx)).hom t) := by
    intro V t x hx hxs
    simp only [wcLr1uGerm, CommRingCat.hom_comp, RingHom.comp_apply]
    rw [TopCat.Presheaf.germ_stalkSpecializes_apply]
  have hloc : ∀ m (hm : m ∈ T) m' (hm' : m' ∈ T) (hmU' : m' ∈ U m hm),
      (Y.presheaf.germ (U m hm) m' hmU').hom (s m hm) = e m' hm' := by
    intro m hm m' hm' hmU'
    apply hinj m' hm'
    rw [he1 m' hm', hindep _ _ _ hmU' (hT m' hm'), ← hindep _ _ _ (hmU m hm) (hT m hm), hs, he1]

  have hdich : ∀ (x : Y) (a : Y.presheaf.stalk x), a * (a - 1) ∈ IsLocalRing.maximalIdeal _ →
      a ∈ IsLocalRing.maximalIdeal _ ∨ a - 1 ∈ IsLocalRing.maximalIdeal _ :=
    fun x a ha => (IsLocalRing.maximalIdeal.isMaximal _).isPrime.mem_or_mem ha
  have hnboth : ∀ (x : Y) (a : Y.presheaf.stalk x), a ∈ IsLocalRing.maximalIdeal _ →
      a - 1 ∈ IsLocalRing.maximalIdeal _ → False := by
    intro x a h1 h2
    have h3 := (IsLocalRing.maximalIdeal (Y.presheaf.stalk x)).sub_mem h1 h2
    rw [sub_sub_cancel] at h3
    exact IsLocalRing.notMem_maximalIdeal.mpr isUnit_one h3
  have hunit : ∀ (x : Y) (a : Y.presheaf.stalk x), IsUnit a → a ∉ IsLocalRing.maximalIdeal _ :=
    fun x a ha => IsLocalRing.notMem_maximalIdeal.mpr ha
  have hnu : ∀ (x : Y) (a : Y.presheaf.stalk x), a ∉ IsLocalRing.maximalIdeal _ → IsUnit a :=
    fun x a ha => IsLocalRing.notMem_maximalIdeal.mp ha

  have hB1 : ∀ m (hm : m ∈ T) x (hx : x ∈ T), x ∈ Y.basicOpen (s m hm) → IsUnit (e x hx) := by
    intro m hm x hx hb
    have hxU : x ∈ U m hm := Y.basicOpen_le _ hb
    rw [Scheme.mem_basicOpen _ _ _ hxU] at hb
    rwa [hloc m hm x hx hxU] at hb
  have hB2 : ∀ m (hm : m ∈ T) x (hx : x ∈ T), x ∈ Y.basicOpen (s m hm - 1) →
      IsUnit (e x hx - 1) := by
    intro m hm x hx hb
    have hxU : x ∈ U m hm := Y.basicOpen_le _ hb
    rw [Scheme.mem_basicOpen _ _ _ hxU] at hb
    have : (Y.presheaf.germ (U m hm) x hxU).hom (s m hm - 1) = e x hx - 1 := by
      rw [map_sub, map_one, hloc m hm x hx hxU]
    rwa [this] at hb
  have hC1 : ∀ m (hm : m ∈ T), IsUnit (e m hm) → m ∈ Y.basicOpen (s m hm) := by
    intro m hm hu
    rw [Scheme.mem_basicOpen _ _ _ (hmU m hm), hs]
    exact hu
  have hC2 : ∀ m (hm : m ∈ T), IsUnit (e m hm - 1) → m ∈ Y.basicOpen (s m hm - 1) := by
    intro m hm hu
    rw [Scheme.mem_basicOpen _ _ _ (hmU m hm), map_sub, map_one, hs]
    exact hu
  set u : Set Y := ⋃ m, ⋃ (hm : m ∈ T), (Y.basicOpen (s m hm) : Set Y) with hu_def
  set v : Set Y := ⋃ m, ⋃ (hm : m ∈ T), (Y.basicOpen (s m hm - 1) : Set Y) with hv_def
  have hu : IsOpen u := isOpen_iUnion fun m => isOpen_iUnion fun hm => (Y.basicOpen _).isOpen
  have hv : IsOpen v := isOpen_iUnion fun m => isOpen_iUnion fun hm => (Y.basicOpen _).isOpen
  have hcover : T ⊆ u ∪ v := by
    intro m hm
    rcases hdich m _ (he2 m hm) with h1 | h1
    · right
      exact Set.mem_iUnion₂.mpr ⟨m, hm, hC2 m hm (hnu m _ fun h2 => hnboth m _ h1 h2)⟩
    · left
      exact Set.mem_iUnion₂.mpr ⟨m, hm, hC1 m hm (hnu m _ fun h2 => hnboth m _ h2 h1)⟩
  have hdisj : T ∩ (u ∩ v) = ∅ := by
    ext x
    simp only [Set.mem_inter_iff, Set.mem_empty_iff_false, iff_false]
    rintro ⟨hx, hxu, hxv⟩
    obtain ⟨a, ha, hxa⟩ := Set.mem_iUnion₂.mp hxu
    obtain ⟨b, hb, hxb⟩ := Set.mem_iUnion₂.mp hxv
    rcases hdich x _ (he2 x hx) with h1 | h1
    · exact hunit x _ (hB1 a ha x hx hxa) h1
    · exact hunit x _ (hB2 b hb x hx hxb) h1
  rcases isPreconnected_iff_subset_of_disjoint.mp hTc u v hu hv hcover hdisj with hTu | hTv
  · right
    intro m hm e' he'
    have hee : e' = e m hm := hinj m hm (he'.trans (he1 m hm).symm)
    subst hee
    obtain ⟨a, ha, hma⟩ := Set.mem_iUnion₂.mp (hTu hm)
    rcases hdich m _ (he2 m hm) with h1 | h1
    · exact absurd h1 (hunit m _ (hB1 a ha m hm hma))
    · exact h1
  · left
    intro m hm e' he'
    have hee : e' = e m hm := hinj m hm (he'.trans (he1 m hm).symm)
    subst hee
    obtain ⟨b, hb, hmb⟩ := Set.mem_iUnion₂.mp (hTv hm)
    rcases hdich m _ (he2 m hm) with h1 | h1
    · exact h1
    · exact absurd h1 (hunit m _ (hB2 b hb m hm hmb))

theorem wcpa_dj_lr1k_nsr_nafc_removal : ∀ (Z : Type u) [TopologicalSpace Z],
    _root_.IsPreconnected (Set.univ : Set Z) → (irreducibleComponents Z).Finite →
    ∀ O : Set Z, IsOpen O →
    (∀ q ∉ O, ∀ A ∈ irreducibleComponents Z, ∀ B ∈ irreducibleComponents Z,
      q ∈ A → q ∈ B → A = B) →
    _root_.IsPreconnected O :=
by
  intro Z _ hZ hfin O hO hU
  rw [isPreconnected_iff_subset_of_disjoint]
  intro u v hu hv hcov hdisj
  classical
  set 𝒜 : Set (Set Z) := {C | C ∈ irreducibleComponents Z ∧ (C ∩ O ∩ u).Nonempty} with h𝒜
  set ℬ : Set (Set Z) := {C | C ∈ irreducibleComponents Z ∧ ¬ (C ∩ O ∩ u).Nonempty} with hℬ
  have hAfin : 𝒜.Finite := hfin.subset (fun C hC => hC.1)
  have hBfin : ℬ.Finite := hfin.subset (fun C hC => hC.1)
  have hAcl : IsClosed (⋃₀ 𝒜) :=
    hAfin.isClosed_sUnion (fun C hC => isClosed_of_mem_irreducibleComponents C hC.1)
  have hBcl : IsClosed (⋃₀ ℬ) :=
    hBfin.isClosed_sUnion (fun C hC => isClosed_of_mem_irreducibleComponents C hC.1)
  have s3 : ∀ C ∈ 𝒜, C ∩ O ⊆ u := by
    rintro C ⟨hC, w, ⟨⟨hwC, hwO⟩, hwu⟩⟩ x ⟨hxC, hxO⟩
    rcases hcov hxO with hxu | hxv
    · exact hxu
    · exfalso
      obtain ⟨y, hyC, ⟨hyu, hyO⟩, ⟨hyv, _⟩⟩ :=
        hC.1.isPreirreducible (u ∩ O) (v ∩ O) (hu.inter hO) (hv.inter hO)
          ⟨w, hwC, hwu, hwO⟩ ⟨x, hxC, hxv, hxO⟩
      have hy : y ∈ O ∩ (u ∩ v) := ⟨hyO, hyu, hyv⟩
      rw [hdisj] at hy
      exact hy
  have s4 : ∀ C ∈ ℬ, C ∩ O ⊆ v := by
    rintro C ⟨_, hne⟩ x ⟨hxC, hxO⟩
    rcases hcov hxO with hxu | hxv
    · exact absurd ⟨x, ⟨hxC, hxO⟩, hxu⟩ hne
    · exact hxv
  have s5 : ∀ z : Z, z ∈ ⋃₀ 𝒜 ∨ z ∈ ⋃₀ ℬ := by
    intro z
    have hz : z ∈ ⋃₀ irreducibleComponents Z := by
      rw [sUnion_irreducibleComponents]; exact Set.mem_univ z
    obtain ⟨C, hC, hzC⟩ := hz
    by_cases h : (C ∩ O ∩ u).Nonempty
    · exact Or.inl ⟨C, ⟨hC, h⟩, hzC⟩
    · exact Or.inr ⟨C, ⟨hC, h⟩, hzC⟩
  have s6 : ∀ p, p ∈ ⋃₀ 𝒜 → p ∈ ⋃₀ ℬ → False := by
    rintro p ⟨C₁, h₁, hp₁⟩ ⟨C₂, h₂, hp₂⟩
    by_cases hpO : p ∈ O
    · have hp : p ∈ O ∩ (u ∩ v) := ⟨hpO, s3 C₁ h₁ ⟨hp₁, hpO⟩, s4 C₂ h₂ ⟨hp₂, hpO⟩⟩
      rw [hdisj] at hp
      exact hp
    · have hEq : C₁ = C₂ := hU p hpO C₁ h₁.1 C₂ h₂.1 hp₁ hp₂
      exact h₂.2 (hEq ▸ h₁.2)
  by_cases hA : (⋃₀ 𝒜).Nonempty
  · left
    have hB : ¬ (⋃₀ ℬ).Nonempty := by
      intro hB
      obtain ⟨p, _, hpA, hpB⟩ := isPreconnected_closed_iff.mp hZ _ _ hAcl hBcl
        (fun z _ => s5 z) (by simpa using hA) (by simpa using hB)
      exact s6 p hpA hpB
    intro o ho
    rcases s5 o with ⟨C, hC, hoC⟩ | hoB
    · exact s3 C hC ⟨hoC, ho⟩
    · exact absurd ⟨o, hoB⟩ hB
  · right
    intro o ho
    rcases s5 o with hoA | ⟨C, hC, hoC⟩
    · exact absurd ⟨o, hoA⟩ hA
    · exact s4 C hC ⟨hoC, ho⟩

theorem wcpa_dj_lr1k_nsr_nafc_zariski_fibre : ∀ (C Y N : Scheme.{u}) [AlgebraicGeometry.IsIntegral C]
    (h : C ⟶ Y) (p : Y ⟶ N) [IsProper p] (g : C ⟶ N), h ≫ p = g →
    (∀ y : ↥Y, ∃ hy : h (genericPoint ↥C) ⤳ y, Function.Injective (wcLr1uGerm h y hy).hom) →
    ∀ (n : ↥N) (hn : g (genericPoint ↥C) ⤳ n),
    (∀ z : C.functionField, (∃ q : Polynomial ↥(N.presheaf.stalk n), q.Monic ∧
        q.eval₂ (wcLr1uGerm g n hn).hom z = 0) → ∃ e, (wcLr1uGerm g n hn).hom e = z) →
    _root_.IsPreconnected (⇑p ⁻¹' {n}) :=
by
  intro C Y N _ h p _ g hcomp hA n hn hB
  haveI hNloc : IsLocalRing ↥(N.presheaf.stalk n) := by
    first
    | exact inferInstance
    | exact N.toLocallyRingedSpace.isLocalRing n
    | exact (N.presheaf.stalk n).isLocalRing
  subst hcomp
  classical

  have s1 (A : Type u) [CommRing A] [IsLocalRing A] (R : Scheme.{u})
      [AlgebraicGeometry.IsIntegral R] (g : R ⟶ Spec (.of A)) [IsProper g]
      (hint : ∀ f : ↥(R.presheaf.stalk (genericPoint ↥R)),
        ((R.presheaf.germ ⊤ (genericPoint ↥R) trivial).hom.comp
          (g.appTop.hom.comp (Scheme.ΓSpecIso (.of A)).inv.hom)).IsIntegralElem f →
        ∃ a : A, ((R.presheaf.germ ⊤ (genericPoint ↥R) trivial).hom.comp
          (g.appTop.hom.comp (Scheme.ΓSpecIso (.of A)).inv.hom)) a = f) :
      _root_.IsPreconnected (g ⁻¹' {IsLocalRing.closedPoint A}) := by
    have hunit : ∀ x : R, g x = IsLocalRing.closedPoint A → ∀ c : A,
        x ∈ R.basicOpen ((g.appTop.hom.comp (Scheme.ΓSpecIso (.of A)).inv.hom) c) ↔ IsUnit c := by
      intro x hx c
      have h1 := Scheme.preimage_basicOpen_top g ((Scheme.ΓSpecIso (.of A)).inv.hom c)
      rw [RingHom.comp_apply]
      change x ∈ R.basicOpen ((ConcreteCategory.hom g.appTop) _) ↔ _
      rw [← h1, Scheme.Hom.mem_preimage, hx]
      change IsLocalRing.closedPoint A ∈ (Spec (CommRingCat.of A)).basicOpen
        ((ConcreteCategory.hom (Scheme.ΓSpecIso (CommRingCat.of A)).inv) c) ↔ _
      rw [basicOpen_eq_of_affine]
      exact (PrimeSpectrum.mem_basicOpen c (IsLocalRing.closedPoint A)).trans
        IsLocalRing.notMem_maximalIdeal
    have hFcl : IsClosed (g ⁻¹' {IsLocalRing.closedPoint A}) :=
      (IsLocalRing.isClosed_singleton_closedPoint A).preimage g.continuous
    rw [isPreconnected_closed_iff]
    intro t t' ht ht' hsub hne hne'
    by_contra hdisj
    obtain ⟨β, hB1, hB2⟩ := wc_proper_local_closed_fibre_clopen_lift A R g
      (g ⁻¹' {IsLocalRing.closedPoint A} ∩ t) (g ⁻¹' {IsLocalRing.closedPoint A} ∩ t')
      (hFcl.inter ht) (hFcl.inter ht')
      (Set.disjoint_left.mpr fun x hx hx' => hdisj ⟨x, hx.1, hx.2, hx'.2⟩)
      (by rw [← Set.inter_union_distrib_left]; exact Set.inter_eq_left.mpr hsub)
    have hsurj : Function.Surjective (Scheme.ΓSpecIso (.of A)).inv.hom := by
      intro y
      exact ⟨(Scheme.ΓSpecIso (.of A)).hom.hom y, by simp⟩
    have hφint : (g.appTop.hom.comp (Scheme.ΓSpecIso (.of A)).inv.hom).IsIntegral :=
      RingHom.IsIntegral.trans _ _ (RingHom.isIntegral_of_surjective _ hsurj)
