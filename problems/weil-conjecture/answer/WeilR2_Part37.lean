    have hΦt : ∀ p ∈ wcNcIdeal W b, Φt p = 0 := by
      intro p hp
      obtain ⟨g, rfl⟩ := Ideal.mem_span_singleton'.mp hp
      have hF : Φt (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C b) = 0 := by
