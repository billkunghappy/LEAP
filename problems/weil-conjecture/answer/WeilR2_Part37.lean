      let ιP := Algebra.linearMap R ((i : Fin n) → A ⧸ M i)
      have hle : LinearMap.range ιA ≤ (LinearMap.range ιP).comap Φ := by
        rintro _ ⟨r, rfl⟩
        refine ⟨r, ?_⟩
        funext i
