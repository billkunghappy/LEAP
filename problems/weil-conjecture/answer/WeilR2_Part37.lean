    obtain ⟨q, rfl⟩ := lift y hy
    obtain ⟨q', rfl⟩ := lift y' hy'
    rw [e1.specializes_iff, ← e2.specializes_iff, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply]

theorem wcpa_dj_lr1k_llcc_rt_single_roof : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω)
