                ψ j (algebraMap A (wcGubGen W A) (b i)) +
                (ϖ : Ω) ^ L * ((lam j : Ω) * ψ j (algebraMap A (wcGubGen W A) s))) :=
              Finset.sum_congr rfl (fun j _ => by rw [hj j]; ring)
          _ = _ := by rw [Finset.sum_add_distrib, e1, e2, zero_add, Finset.mul_sum]
      refine ⟨Y, Subtype.ext ?_⟩
      rw [hXc, key, ← hYc]
      rw [← hcoe (ϖ ^ L * Y), map_mul, map_pow]
