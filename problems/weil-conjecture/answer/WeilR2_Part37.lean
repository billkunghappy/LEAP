  have s2 : ∀ (A B : Scheme.{u}) (φ : A ⟶ B) (O : B.Opens), IsIso (φ ∣_ O) →
      (∀ b : B, b ∈ O → ∃! a : A, φ a = b) ∧
      (∀ a : A, φ a ∈ O → IsIso (φ.residueFieldMap a)) ∧
      (∀ a w : A, φ a ∈ O → φ w ⤳ φ a → w ⤳ a) := by
