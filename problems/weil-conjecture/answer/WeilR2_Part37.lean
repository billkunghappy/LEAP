        rw [IsLocalization.mk'_eq_iff_eq_mul, mul_assoc, ← hwm, hφ w, ← map_mul,
          inv_mul_cancel₀ hc, map_one, mul_one]
      rw [hmk]
      exact mul_mem (hA a) (Subalgebra.algebraMap_mem _ _)
    · rw [algebraicIndependent_iff] at hy ⊢
      intro Q hQ
      obtain ⟨b, hb⟩ := IsLocalization.exist_integer_multiples_of_finset (nonZeroDivisors ↥W)
