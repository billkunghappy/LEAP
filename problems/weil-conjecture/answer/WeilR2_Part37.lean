    have hvy0 : 0 < A.valuation x⁻¹ := (Valuation.pos_iff _).mpr hy0
    have hv'y : A'.valuation x⁻¹ = 1 := by
      apply le_antisymm ((A'.valuation_le_one_iff _).mpr (hle hyA))
      have h1 : A'.valuation x ≤ 1 := (A'.valuation_le_one_iff x).mpr hx
      rw [map_inv₀]
      exact (one_le_inv₀ ((Valuation.pos_iff _).mpr hx0)).mpr h1
    have F1 : ∀ w : L, A'.valuation w < 1 → A.valuation w < 1 := by
      intro w hw
      by_cases hw0 : w = 0
      · rw [hw0, map_zero]; exact zero_lt_one
      · rw [← not_le]
        intro h
        have hwA : w⁻¹ ∈ A := (A.valuation_le_one_iff _).mp (by
          rw [map_inv₀]; exact inv_le_one_of_one_le₀ h)
        have h2 := (A'.valuation_le_one_iff _).mpr (hle hwA)
        rw [map_inv₀] at h2
        have hp : 0 < A'.valuation w := (Valuation.pos_iff _).mpr hw0
        exact absurd h2 (not_le.mpr ((one_lt_inv₀ hp).mpr hw))
    obtain ⟨p, ⟨i₁, hi₁⟩, hsum⟩ := H2 (fun i => x⁻¹ ^ (i : ℕ))
    obtain ⟨im, -, him⟩ := Finset.exists_max_image Finset.univ
      (fun i => A'.valuation ((p i).eval₂ φ s)) Finset.univ_nonempty
    have hM : 0 < A'.valuation ((p im).eval₂ φ s) :=
      lt_of_lt_of_le ((Valuation.pos_iff _).mpr (H1 _ hi₁)) (him i₁ (Finset.mem_univ _))
    set J := Finset.univ.filter
      (fun i => A'.valuation ((p i).eval₂ φ s) = A'.valuation ((p im).eval₂ φ s)) with hJ
    have hJne : J.Nonempty := ⟨im, by simp [hJ]⟩
    set j₁ := J.min' hJne with hj₁
    have hj₁J : j₁ ∈ J := Finset.min'_mem J hJne
    have hj₁eq : A'.valuation ((p j₁).eval₂ φ s) = A'.valuation ((p im).eval₂ φ s) :=
      (Finset.mem_filter.mp hj₁J).2
    have hc0 : (p j₁).eval₂ φ s ≠ 0 := by
      intro h; rw [h, map_zero] at hj₁eq; rw [← hj₁eq] at hM; exact lt_irrefl _ hM
    have hvc : 0 < A.valuation ((p j₁).eval₂ φ s) := (Valuation.pos_iff _).mpr hc0
    have hT0 : (p j₁).eval₂ φ s * x⁻¹ ^ (j₁ : ℕ) ≠ 0 := mul_ne_zero hc0 (pow_ne_zero _ hy0)
    have hT : 0 < A.valuation ((p j₁).eval₂ φ s * x⁻¹ ^ (j₁ : ℕ)) :=
      (Valuation.pos_iff _).mpr hT0
    have key := Valuation.map_sum_eq_of_lt A.valuation (s := Finset.univ)
      (f := fun i => (p i).eval₂ φ s * x⁻¹ ^ (i : ℕ)) (Finset.mem_univ j₁) ?_
    · have hsum' : ∑ i, (p i).eval₂ φ s * x⁻¹ ^ (i : ℕ) = 0 := hsum
      rw [hsum', map_zero] at key
      exact hT.ne key
    · intro i hi
      have hne : i ≠ j₁ := by simpa using hi
      show A.valuation ((p i).eval₂ φ s * x⁻¹ ^ (i : ℕ)) <
        A.valuation ((p j₁).eval₂ φ s * x⁻¹ ^ (j₁ : ℕ))
      by_cases hci : (p i).eval₂ φ s = 0
      · rw [hci, zero_mul, map_zero]; exact hT
      by_cases hiM : A'.valuation ((p i).eval₂ φ s) = A'.valuation ((p im).eval₂ φ s)
      · have hiJ : i ∈ J := Finset.mem_filter.mpr ⟨Finset.mem_univ _, hiM⟩
        have hle' : j₁ ≤ i := Finset.min'_le J i hiJ
        have hlt : (j₁ : ℕ) < (i : ℕ) := lt_of_le_of_ne hle' (fun h => hne (Fin.ext h).symm)
        have heq' : A'.valuation ((p i).eval₂ φ s) = A'.valuation ((p j₁).eval₂ φ s) :=
          hiM.trans hj₁eq.symm
        have heq : A.valuation ((p i).eval₂ φ s) = A.valuation ((p j₁).eval₂ φ s) :=
          le_antisymm ((hagr (p i) (p j₁)).mpr heq'.le) ((hagr (p j₁) (p i)).mpr heq'.ge)
        rw [map_mul, map_mul, map_pow, map_pow, heq]
        exact mul_lt_mul_of_pos_left (pow_lt_pow_right_of_lt_one₀ hvy0 hvy hlt) hvc
      · have hlt : A'.valuation ((p i).eval₂ φ s) < A'.valuation ((p j₁).eval₂ φ s) := by
          rw [hj₁eq]; exact lt_of_le_of_ne (him i (Finset.mem_univ _)) hiM
        have hw : A'.valuation ((p i).eval₂ φ s * x⁻¹ ^ (i : ℕ) /
            ((p j₁).eval₂ φ s * x⁻¹ ^ (j₁ : ℕ))) < 1 := by
          rw [Valuation.map_div, map_mul, map_mul, map_pow, map_pow, hv'y, one_pow, one_pow,
            mul_one, mul_one]
          exact (div_lt_one₀ (lt_of_lt_of_le hM (le_of_eq hj₁eq.symm))).mpr hlt
        have hw' := F1 _ hw
        have hdec : (p i).eval₂ φ s * x⁻¹ ^ (i : ℕ) =
            ((p i).eval₂ φ s * x⁻¹ ^ (i : ℕ) / ((p j₁).eval₂ φ s * x⁻¹ ^ (j₁ : ℕ))) *
              ((p j₁).eval₂ φ s * x⁻¹ ^ (j₁ : ℕ)) := (div_mul_cancel₀ _ hT0).symm
        rw [hdec, map_mul]
        exact mul_lt_of_lt_one_left hT hw'

  have s2 : ∀ (m : ℕ) (B : Fin m → ValuationSubring L), (∀ i j, i ≠ j → ¬ B i ≤ B j) →
      ∀ i, ∃ z : L, (B i).valuation z < 1 ∧ ∀ j, j ≠ i → 1 < (B j).valuation z := by
    intro m B hinc i
    have hpair : ∀ j, j ≠ i → ∃ u : L, (B i).valuation u < 1 ∧ 1 < (B j).valuation u := by
      intro j hji
      obtain ⟨a, ha, haj⟩ := SetLike.not_le_iff_exists.mp (hinc i j (Ne.symm hji))
      obtain ⟨b, hb, hbi⟩ := SetLike.not_le_iff_exists.mp (hinc j i hji)
      have hb0 : b ≠ 0 := by rintro rfl; exact hbi (B i).zero_mem
      refine ⟨a * b⁻¹, ?_, ?_⟩
      · rw [map_mul, map_inv₀]
        have h1 : (B i).valuation a ≤ 1 := ((B i).valuation_le_one_iff a).mpr ha
        have h2 : 1 < (B i).valuation b :=
          not_le.mp (fun h => hbi (((B i).valuation_le_one_iff b).mp h))
        calc _ ≤ 1 * ((B i).valuation b)⁻¹ := mul_le_mul_of_nonneg_right h1 zero_le'
          _ < 1 := by rw [one_mul]; exact inv_lt_one_of_one_lt₀ h2
      · rw [map_mul, map_inv₀]
        have h1 : 1 < (B j).valuation a :=
          not_le.mp (fun h => haj (((B j).valuation_le_one_iff a).mp h))
        have h2 : (B j).valuation b ≤ 1 := ((B j).valuation_le_one_iff b).mpr hb
        have hp : 0 < (B j).valuation b := (Valuation.pos_iff _).mpr hb0
        exact lt_of_lt_of_le h1 (le_mul_of_one_le_right' ((one_le_inv₀ hp).mpr h2))
    choose! u hu using hpair
    have claim : ∀ S : Finset (Fin m), i ∉ S →
        ∃ z : L, (B i).valuation z < 1 ∧ ∀ j ∈ S, 1 < (B j).valuation z := by
      intro S
      induction S using Finset.induction_on with
      | empty => intro _; exact ⟨0, by rw [map_zero]; exact zero_lt_one, by simp⟩
      | insert k S hkS ih =>
        intro hi
        have hik : k ≠ i := fun h => hi (h ▸ Finset.mem_insert_self k S)
        have hiS : i ∉ S := fun h => hi (Finset.mem_insert_of_mem h)
        obtain ⟨z, hz1, hz2⟩ := ih hiS
        have hu1 := (hu k hik).1
        have hu2 := (hu k hik).2
        have hu0 : u k ≠ 0 := by
          intro h; rw [h, map_zero] at hu2; exact not_lt.mpr zero_le' hu2
        let bad : Fin m → Finset ℕ := fun j => (Finset.Icc 1 (S.card + 2)).filter
          (fun r => (B j).valuation (u k) ^ r = (B j).valuation z)
        have hbad : ∀ j ∈ insert k S, (bad j).card ≤ 1 := by
          intro j hj
          rw [Finset.card_le_one]
          intro r₁ hr₁ r₂ hr₂
          simp only [bad, Finset.mem_filter] at hr₁ hr₂
          by_cases h1 : (B j).valuation (u k) = 1
          · exfalso
            have hjk : j ≠ k := by
              intro h; rw [h] at h1; rw [h1] at hu2; exact lt_irrefl _ hu2
            have hjS : j ∈ S := (Finset.mem_insert.mp hj).resolve_left hjk
            have := hz2 j hjS
            rw [← hr₁.2, h1, one_pow] at this
            exact lt_irrefl _ this
          · exact pow_right_injective₀ ((Valuation.pos_iff _).mpr hu0) h1
              (hr₁.2.trans hr₂.2.symm)
        have hcard : ((insert k S).biUnion bad).card < (Finset.Icc 1 (S.card + 2)).card := by
          calc _ ≤ (insert k S).card * 1 := Finset.card_biUnion_le_card_mul _ _ _ hbad
            _ = S.card + 1 := by rw [Finset.card_insert_of_notMem hkS, mul_one]
            _ < S.card + 2 := by omega
            _ = _ := by simp
        obtain ⟨r, hr, hrbad⟩ := Finset.exists_mem_notMem_of_card_lt_card hcard
        have hr1 : r ≠ 0 := by have := (Finset.mem_Icc.mp hr).1; omega
        have hne : ∀ j ∈ insert k S, (B j).valuation z ≠ (B j).valuation (u k ^ r) := by
          intro j hj heq
          apply hrbad
          rw [Finset.mem_biUnion]
          exact ⟨j, hj, Finset.mem_filter.mpr ⟨hr, by rw [map_pow] at heq; exact heq.symm⟩⟩
        refine ⟨z + u k ^ r, ?_, ?_⟩
        · apply Valuation.map_add_lt _ hz1
          rw [map_pow]; exact pow_lt_one₀ zero_le' hu1 hr1
        · intro j hj
          rw [Valuation.map_add_of_distinct_val _ (hne j hj)]
          rcases Finset.mem_insert.mp hj with h | hjS
          · rw [h]
            exact lt_of_lt_of_le (by rw [map_pow]; exact one_lt_pow₀ hu2 hr1) (le_max_right _ _)
          · exact lt_of_lt_of_le (hz2 j hjS) (le_max_left _ _)
    obtain ⟨z, hz1, hz2⟩ := claim (Finset.univ.erase i) (Finset.notMem_erase i _)
    exact ⟨z, hz1, fun j hj => hz2 j (Finset.mem_erase.mpr ⟨hj, Finset.mem_univ _⟩)⟩

  have s3 : ∀ B : Fin (N + 1) → ValuationSubring L, (∀ i j, ∀ P Q : Polynomial Ω,
      ((B i).valuation (P.eval₂ φ s) ≤ (B i).valuation (Q.eval₂ φ s) ↔
        (B j).valuation (P.eval₂ φ s) ≤ (B j).valuation (Q.eval₂ φ s))) →
      (∀ i, ∃ z : L, (B i).valuation z < 1 ∧ ∀ j, j ≠ i → 1 < (B j).valuation z) → False := by
    intro B hagr hsep
    choose z hz1 hz2 using hsep
    have he1 : ∀ i, (B i).valuation ((1 + z i)⁻¹) = 1 := by
      intro i
      rw [map_inv₀, Valuation.map_one_add_of_lt _ (hz1 i), inv_one]
    have he2 : ∀ i j, j ≠ i → (B j).valuation ((1 + z i)⁻¹) < 1 := by
      intro i j hji
      have h1 : (B j).valuation (1 : L) < (B j).valuation (z i) := by
        rw [map_one]; exact hz2 i j hji
      rw [map_inv₀, Valuation.map_add_eq_of_lt_right _ h1]
      exact inv_lt_one_of_one_lt₀ (hz2 i j hji)
    obtain ⟨p, ⟨i₁, hi₁⟩, hsum⟩ := H2 (fun i => (1 + z i)⁻¹)
    obtain ⟨i₀, -, hi₀⟩ := Finset.exists_max_image Finset.univ
      (fun i => (B 0).valuation ((p i).eval₂ φ s)) Finset.univ_nonempty
    have hmax : ∀ i, (B i₀).valuation ((p i).eval₂ φ s) ≤ (B i₀).valuation ((p i₀).eval₂ φ s) :=
      fun i => (hagr 0 i₀ (p i) (p i₀)).mp (hi₀ i (Finset.mem_univ _))
    have hc0 : (p i₀).eval₂ φ s ≠ 0 := by
      intro h0
      have h := hi₀ i₁ (Finset.mem_univ _)
      simp only [h0, map_zero] at h
      exact absurd h (not_le.mpr ((Valuation.pos_iff _).mpr (H1 _ hi₁)))
    have hpos : 0 < (B i₀).valuation ((p i₀).eval₂ φ s) := (Valuation.pos_iff _).mpr hc0
    have key := Valuation.map_sum_eq_of_lt (B i₀).valuation (s := Finset.univ)
      (f := fun i => (p i).eval₂ φ s * (1 + z i)⁻¹) (Finset.mem_univ i₀) ?_
    · have hsum' : ∑ i, (p i).eval₂ φ s * (1 + z i)⁻¹ = 0 := hsum
      rw [hsum', map_zero, map_mul, he1, mul_one] at key
      exact hpos.ne key
    · intro i hi
      have hne : i ≠ i₀ := by simpa using hi
      show (B i₀).valuation ((p i).eval₂ φ s * (1 + z i)⁻¹) <
        (B i₀).valuation ((p i₀).eval₂ φ s * (1 + z i₀)⁻¹)
      rw [map_mul, map_mul, he1, mul_one]
      by_cases hci : (p i).eval₂ φ s = 0
      · rw [hci, map_zero, zero_mul]; exact hpos
      · have hp : 0 < (B i₀).valuation ((p i).eval₂ φ s) := (Valuation.pos_iff _).mpr hci
        exact lt_of_lt_of_le (mul_lt_of_lt_one_right hp (he2 i i₀ (Ne.symm hne))) (hmax i)

  by_contra hfin
  have hinf : 𝒜.Infinite := hfin
  let f := hinf.natEmbedding
  let B : Fin (N + 1) → ValuationSubring L := fun i => (f (i : ℕ)).1
  have hagr : ∀ i j, ∀ P Q : Polynomial Ω,
      ((B i).valuation (P.eval₂ φ s) ≤ (B i).valuation (Q.eval₂ φ s) ↔
        (B j).valuation (P.eval₂ φ s) ≤ (B j).valuation (Q.eval₂ φ s)) :=
    fun i j P Q => H3 (B i) (f (i : ℕ)).2 (B j) (f (j : ℕ)).2 P Q
  have hinc : ∀ i j, i ≠ j → ¬ B i ≤ B j := by
    intro i j hij hle
    have h : B i = B j := le_antisymm hle (s1 (B i) (B j) (hagr i j) hle)
    apply hij
    apply Fin.val_injective
    apply f.injective
    exact Subtype.ext h
  exact s3 B hagr (fun i => s2 (N + 1) B hinc i)

theorem wcpa_dj_lr1k_nsr_na_lim_finite : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω) (C : Scheme.{u}) [AlgebraicGeometry.IsIntegral C]
    (γ : C ⟶ wcProjK Ω 1) (X : Scheme.{u}) (uX : X ⟶ Spec (.of ↥W)) (ι : wcProjK Ω 1 ⟶ X)
    [QuasiCompact (γ ≫ ι)] [QuasiSeparated (γ ≫ ι)]
    (y₀ : ↥(wcpaDjLkFib W (γ ≫ ι) uX)) (τ : (Spec (.of ↥W) ⟶ X) → ↥W),
    wcNsrNaHyp W γ uX ι y₀ τ →
    Set.Finite {A : ValuationSubring C.functionField |
      wcNsrNaLim W γ uX ι (wcpaDjLkImg W (γ ≫ ι) uX y₀) A} :=
by
  intro Ω _ _ W C _ γ X uX ι _ _ y₀ τ hH
  classical

  have halg : ∀ (L : Type u) [Field L] (φ : Ω →+* L) (A : ValuationSubring L) (s : L)
      (PL PE : ↥W → Prop) (b₀ a₁ : ↥W), PL b₀ → PE a₁ →
      (¬ ∃ β : ↥W, (∀ a', PL a' → β ∣ a') ∧ (∀ a, PE a → a ∣ β)) →
      (∀ b : Ω, A.valuation (φ b) ≤ 1 ↔ b ∈ W) →
      (∀ a', PL a' → A.valuation (φ (a' : Ω)) < A.valuation s) →
      (∀ a, PE a → A.valuation s < A.valuation (φ (a : Ω))) →
      (∀ n : ℕ, 1 ≤ n → ∀ b : Ω, A.valuation (s ^ n) ≠ A.valuation (φ b)) ∧
      (∀ (c : Ω) (k : ℕ), 1 ≤ k → (A.valuation (s ^ k) < A.valuation (φ c) ↔
        ∃ a : ↥W, PE a ∧ c ≠ 0 ∧ (a : Ω) ^ k / c ∈ W)) := by
    intro L _ φ A s PL PE b₀ a₁ hb₀ ha₁ hcut hcst hL hE
    have hv0 : ∀ c : Ω, c ≠ 0 → A.valuation (φ c) ≠ 0 := fun c hc => by
      rw [Valuation.ne_zero_iff]; exact (map_ne_zero φ).mpr hc
    have hquot : ∀ z c : Ω, c ≠ 0 → (z / c ∈ W ↔ A.valuation (φ z) ≤ A.valuation (φ c)) := by
      intro z c hc
      rw [← hcst, map_div₀, map_div₀, div_le_one₀ (zero_lt_iff.mpr (hv0 c hc))]
    have hdiv : ∀ x y : ↥W, x ≠ 0 → A.valuation (φ (y : Ω)) ≤ A.valuation (φ (x : Ω)) →
        x ∣ y := by
      intro x y hx hle
      have hx' : (x : Ω) ≠ 0 := fun h => hx (Subtype.ext h)
      have hq : (y : Ω) / (x : Ω) ∈ W := (hquot _ _ hx').mpr hle
      refine ⟨⟨(y : Ω) / (x : Ω), hq⟩, Subtype.ext ?_⟩
      show (y : Ω) = (x : Ω) * ((y : Ω) / (x : Ω))
      field_simp
    have hne0 : ∀ a : ↥W, 0 < A.valuation (φ (a : Ω)) → a ≠ 0 := by
      rintro a ha rfl
      simp at ha
    have hs0 : 0 < A.valuation s := lt_of_le_of_lt zero_le' (hL b₀ hb₀)
    have ha₁1 : A.valuation (φ (a₁ : Ω)) ≤ 1 := (hcst _).mpr a₁.2
    refine ⟨?_, ?_⟩
    · intro n hn b h
      rw [map_pow] at h
      have hb : b ≠ 0 := by
        rintro rfl
        rw [map_zero, map_zero] at h
        exact (pow_pos hs0 n).ne' h
      obtain ⟨β, hβ⟩ := IsAlgClosed.exists_pow_nat_eq b (n := n) (by omega)
      have hβ0 : β ≠ 0 := by rintro rfl; rw [zero_pow (by omega)] at hβ; exact hb hβ.symm
      have hvβ : A.valuation (φ β) = A.valuation s := by
        have : A.valuation (φ β) ^ n = A.valuation s ^ n := by
          rw [← map_pow, ← map_pow, hβ, h]
        exact (pow_left_inj₀ zero_le' zero_le' (by omega)).mp this
      have hβW : β ∈ W :=
        (hcst β).mp (by rw [hvβ]; exact le_of_lt (lt_of_lt_of_le (hE a₁ ha₁) ha₁1))
      apply hcut
      refine ⟨⟨β, hβW⟩, fun a' ha' => ?_, fun a ha => ?_⟩
      · refine hdiv _ _ (fun h0 => hβ0 (congrArg Subtype.val h0)) ?_
        show A.valuation (φ (a' : Ω)) ≤ A.valuation (φ β)
        rw [hvβ]; exact le_of_lt (hL a' ha')
      · refine hdiv _ _ (hne0 a (lt_trans hs0 (hE a ha))) ?_
        show A.valuation (φ β) ≤ A.valuation (φ (a : Ω))
        rw [hvβ]; exact le_of_lt (hE a ha)
    · intro c k hk
      constructor
      · intro h
        rw [map_pow] at h
        have hc : c ≠ 0 := by
          rintro rfl
          rw [map_zero, map_zero] at h
          exact (not_lt.mpr zero_le') h
        by_contra hR
        have hR' : ∀ a : ↥W, PE a → A.valuation (φ c) < A.valuation (φ (a : Ω)) ^ k := by
          intro a ha
          rw [← map_pow, ← map_pow]
          by_contra hle
          exact hR ⟨a, ha, hc, (hquot _ _ hc).mpr (not_lt.mp hle)⟩
        obtain ⟨β, hβ⟩ := IsAlgClosed.exists_pow_nat_eq c (n := k) (by omega)
        have hβ0 : β ≠ 0 := by rintro rfl; rw [zero_pow (by omega)] at hβ; exact hc hβ.symm
        have hck : A.valuation (φ c) = A.valuation (φ β) ^ k := by
          rw [← map_pow, ← map_pow, hβ]
        have hsβ : A.valuation s < A.valuation (φ β) := by
          rw [hck] at h
          exact lt_of_pow_lt_pow_left₀ k zero_le' h
        have hβa : ∀ a : ↥W, PE a → A.valuation (φ β) < A.valuation (φ (a : Ω)) := by
          intro a ha
          have := hR' a ha
          rw [hck] at this
          exact lt_of_pow_lt_pow_left₀ k zero_le' this
        have hβW : β ∈ W := (hcst β).mp (le_of_lt (lt_of_lt_of_le (hβa a₁ ha₁) ha₁1))
        apply hcut
        refine ⟨⟨β, hβW⟩, fun a' ha' => ?_, fun a ha => ?_⟩
        · refine hdiv _ _ (fun h0 => hβ0 (congrArg Subtype.val h0)) ?_
          exact le_of_lt (lt_trans (hL a' ha') hsβ)
        · refine hdiv _ _ (hne0 a (lt_of_le_of_lt zero_le' (hβa a ha))) ?_
          exact le_of_lt (hβa a ha)
      · rintro ⟨a, ha, hc, hq⟩
        rw [map_pow]
        have h1 := (hquot _ _ hc).mp hq
        rw [map_pow, map_pow] at h1
        exact lt_of_lt_of_le (pow_lt_pow_left₀ (hE a ha) zero_le' (by omega)) h1

  have hH' := hH
  obtain ⟨-, -, hcov, -, -, -, -, hDisc, hEB, -, hLBex, hnG⟩ := hH'
  obtain ⟨hD1, -, hD3⟩ := hDisc
  obtain ⟨hEB1, hEB2, -⟩ := hEB
  obtain ⟨σs, b₀, hLB₀⟩ := hLBex
  have hLB₀' := hLB₀
  obtain ⟨hPb₀, hL0⟩ := hLB₀'
  obtain ⟨hσs, hσx, hb₀0, hb₀m⟩ := hPb₀
