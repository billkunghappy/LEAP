      split_ifs <;> simp
    have ha := split (fun y => if qq (i2 y) = i1 y₁ then d2 y else 0)
      (fun y => if (rr (rr2 (i2 y)) = i0 y₀ ∧ rr2 (i2 y) ≠ i' y') then d2 y else 0)
      (fun y => if (rr2 (i2 y) = i' y' ∧ ns2 y) then d2 y else 0)
      (fun y => ite3 _ (hfib y) (fun h1 h2 => h1.2 h2.1))
