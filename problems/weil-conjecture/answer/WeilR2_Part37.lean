      fun p => ⟨G p.1, p.2.comap (G.residueFieldMap p.1).hom⟩
    have hinj : Set.InjOn Φ {p : Σ ξ : A, ValuationSubring ↥(A.residueField ξ) |
          closure ({p.1} : Set A) ∈ irreducibleComponents A ∧ ¬ Q p.1 ∧
          ∃ y', Q y' ∧ wcLlncDom A p.1 y' p.2} := by
      rintro ⟨ξ₁, V₁⟩ h1 ⟨ξ₂, V₂⟩ h2 heq
      have hξ : G ξ₁ = G ξ₂ := congrArg Sigma.fst heq
      have hO1 : G ξ₁ ∈ O := (hL ξ₁).mp h1.2.1
      obtain ⟨c, -, hu⟩ := hpt (G ξ₁) hO1
      have e : ξ₁ = ξ₂ := (hu ξ₁ rfl).trans (hu ξ₂ hξ.symm).symm
      subst e
      have hV : V₁.comap (G.residueFieldMap ξ₁).hom = V₂.comap (G.residueFieldMap ξ₁).hom :=
        eq_of_heq (Sigma.ext_iff.mp heq).2
