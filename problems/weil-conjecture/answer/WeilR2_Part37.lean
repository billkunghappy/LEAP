      have e := Finset.sum_filter_of_ne (s := s) (f := G) (p := P)
        (fun y _ hy => Classical.byContradiction fun hP => hy (h0 y hP))
      rw [← e, Finset.sum_congr rfl (fun y hy => hc y (Finset.mem_filter.mp hy).2),
