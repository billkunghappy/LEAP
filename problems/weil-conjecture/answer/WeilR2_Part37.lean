  intro Ω _ _ W _ hW R _ _ _ hft htf _ t ht
  classical

  obtain ⟨𝔫, h𝔫max, h𝔫⟩ := Ideal.exists_le_maximal _ ht
  have ht𝔫 : t ∈ 𝔫 := h𝔫 (Ideal.mem_sup_left (Ideal.mem_span_singleton_self t))
  have hI𝔫 : (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W R) ≤ 𝔫 := le_trans le_sup_right h𝔫

  obtain ⟨s, z, hz𝔫, hres, N, mm, hspan⟩ :=
    t_param Ω W (t_res Ω W) t_nn R hft 𝔫 h𝔫max hI𝔫

  letI algSR : Algebra (MvPolynomial (Fin s) ↥W) R := (MvPolynomial.aeval z).toRingHom.toAlgebra
  have hSR : ∀ f : MvPolynomial (Fin s) ↥W, algebraMap (MvPolynomial (Fin s) ↥W) R f =
      MvPolynomial.aeval z f := fun f => rfl
  haveI : IsScalarTower ↥W (MvPolynomial (Fin s) ↥W) R := IsScalarTower.of_algebraMap_eq (fun w => by
    rw [MvPolynomial.algebraMap_eq, hSR, MvPolynomial.aeval_C])
  haveI hftS : Algebra.FiniteType (MvPolynomial (Fin s) ↥W) R :=
    Algebra.FiniteType.of_restrictScalars_finiteType ↥W (MvPolynomial (Fin s) ↥W) R

  have hinjS : Function.Injective (algebraMap (MvPolynomial (Fin s) ↥W) R) := by
    rw [injective_iff_map_eq_zero]
    intro f hf
    by_contra hf0
    obtain ⟨c, g, hfg, m₀, hu⟩ := t_content Ω W s f hf0
    have hc0 : c ≠ 0 := by
      rintro rfl; apply hf0; rw [hfg, MvPolynomial.C_0, zero_mul]
    have h1 : algebraMap ↥W R c * MvPolynomial.aeval z g = 0 := by
      have : MvPolynomial.aeval z f = 0 := hf
      rw [hfg, map_mul, MvPolynomial.aeval_C] at this; exact this
    have h2 : MvPolynomial.aeval z g = 0 := (mul_eq_zero.mp h1).resolve_left (htf c hc0)
    have h3 := hres g (by rw [h2]; exact Ideal.zero_mem _) m₀
    exact (mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal _).mp h3)) hu

  have hfibre : ∀ Q : Ideal R, Q.IsPrime →
      Q.comap (algebraMap (MvPolynomial (Fin s) ↥W) R) = 𝔫.comap (algebraMap (MvPolynomial (Fin s) ↥W) R) →
      Ideal.span (Set.range z) ⊔ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W R) ≤ Q := by
    intro Q _ hQc
    apply sup_le
    · rw [Ideal.span_le]
      rintro _ ⟨i, rfl⟩
      have : MvPolynomial.X i ∈ 𝔫.comap (algebraMap (MvPolynomial (Fin s) ↥W) R) := by
        rw [Ideal.mem_comap, hSR, MvPolynomial.aeval_X]; exact hz𝔫 i
      rw [← hQc, Ideal.mem_comap, hSR, MvPolynomial.aeval_X] at this
