    have hσg : σ₀ g = 0 := by
      have h1 := congrArg σ₀ hg
      simp only [map_mul, map_sub, hσ0, hσ1, hσC] at h1
      have h2 : σ₀ g * MvPolynomial.C b = 0 := by linear_combination -h1
      exact (mul_eq_zero.mp h2).resolve_right (fun hc' => hb (MvPolynomial.C_eq_zero.mp hc'))
    obtain ⟨g', hg'⟩ := hdvd g
    rw [hσg, sub_zero] at hg'
    have hp : p * MvPolynomial.X 0 =
        (g' * (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C b)) * MvPolynomial.X 0 := by
      rw [← hg, hg']; ring
    have hp' := mul_right_cancel₀ (MvPolynomial.X_ne_zero 0) hp
