        ⟨⟨ψ.hom c, (ValuationSubring.mem_comap).mp c.2⟩, Subtype.ext key⟩
    · rw [ValuationSubring.comap_comap]
      have : ψ.hom.comp (G.residueFieldMap ξ').hom = RingHom.id _ := by
        rw [← CommRingCat.hom_comp, hφψ]; rfl
      rw [this]
      refine ValuationSubring.ext _ _ (fun x => ?_)
      rw [ValuationSubring.mem_comap]
      rfl

  have glue : ∀ (A B : Scheme.{u}) (G : A ⟶ B) (O : B.Opens) (P : B → Prop) (Q : A → Prop),
      IsIso (G ∣_ O) → UniversallyClosed G → (∀ y, y ∈ O ↔ ¬ P y) → (∀ a, Q a ↔ P (G a)) →
      (∀ ξ : B, closure ({ξ} : Set B) ∈ irreducibleComponents B → ξ ∈ O) →
      {p : Σ ξ : A, ValuationSubring ↥(A.residueField ξ) |
          closure ({p.1} : Set A) ∈ irreducibleComponents A ∧ ¬ Q p.1 ∧
          ∃ y', Q y' ∧ wcLlncDom A p.1 y' p.2}.encard =
        {p : Σ ξ : B, ValuationSubring ↥(B.residueField ξ) |
          closure ({p.1} : Set B) ∈ irreducibleComponents B ∧
          ∃ y, P y ∧ wcLlncDom B p.1 y p.2}.encard := by
    intro A B G O P Q hGiso hUC hO hQ hgen
    obtain ⟨hpt, hres, hrefl⟩ := s2 A B G O hGiso
