  haveI : Ring.KrullDimLE 1 ↥W := Ring.krullDimLE_iff.mpr hdim
  have hprime : ∀ p : PrimeSpectrum ↥W, p.asIdeal = ⊥ ∨ p = IsLocalRing.closedPoint ↥W := by
    intro p
