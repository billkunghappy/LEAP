  classical

  have hPη : P ≠ genericPoint C := by
    intro hP
    apply hOtop
    subst hP
    rw [TopCat.Presheaf.stalkSpecializes_refl] at hdom1
    refine top_le_iff.mp fun z _ => ?_
    simpa using hdom1 z

  have hdim : topologicalKrullDim C = ((1 : ℕ) : WithBot ℕ∞) :=
    le_antisymm (wc_smooth_alg_closed_dim_le Ω C sC 1) (wc_smooth_irreducible_dim_ge Ω C sC 1)

  have hclosed : ∀ y : C, y ≠ genericPoint C → IsClosed ({y} : Set C) := by
    intro y hy
    exact (wc_curve_points_closed_opens_compact Ω C sC hdim).1 {y} (Set.finite_singleton y)
      (by simpa [Set.mem_singleton_iff] using (Ne.symm hy))

  haveI : Smooth sC := SmoothOfRelativeDimension.smooth 1 sC
  have hnormal : ∀ x : C, IsIntegrallyClosed (C.presheaf.stalk x) :=
    fun x => (wc_fntame_smooth_stalk_normal Ω C sC x).2
  haveI hdvr : IsDiscreteValuationRing (C.presheaf.stalk P) :=
    wc_curve_stalk_dvr Ω C sC hnormal hclosed P hPη
  haveI : ValuationRing (C.presheaf.stalk P) := inferInstance
  refine ⟨hclosed P hPη, fun z => ⟨fun hz => ?_, fun ⟨g, hg⟩ => hg ▸ hdom1 g⟩⟩
  by_cases hz0 : z = 0
  · exact ⟨0, by rw [map_zero, hz0]⟩
  rcases ValuationRing.isInteger_or_isInteger (C.presheaf.stalk P) z with ⟨g, hg⟩ | ⟨g, hg⟩
  · exact ⟨g, hg⟩
  · change (C.presheaf.stalkSpecializes (genericPoint_specializes P)).hom g = z⁻¹ at hg
    by_cases hgm : g ∈ IsLocalRing.maximalIdeal (C.presheaf.stalk P)
    · exfalso
      have h1 := hdom2 g hgm
      rw [hg] at h1
      have h2 : O.valuation z ≤ 1 := (O.valuation_le_one_iff z).mpr hz
      have h3 : O.valuation z * O.valuation z⁻¹ = 1 := by
        rw [← Valuation.map_mul, mul_inv_cancel₀ hz0, Valuation.map_one]
      have h4 : O.valuation z * O.valuation z⁻¹ ≤ O.valuation z⁻¹ := mul_le_of_le_one_left' h2
      rw [h3] at h4
      exact lt_irrefl _ (lt_of_le_of_lt h4 h1)
    · obtain ⟨u, hu⟩ := IsLocalRing.notMem_maximalIdeal.mp hgm
      refine ⟨↑u⁻¹, ?_⟩
      have hmul : (C.presheaf.stalkSpecializes (genericPoint_specializes P)).hom (↑u⁻¹ : C.presheaf.stalk P) *
          (C.presheaf.stalkSpecializes (genericPoint_specializes P)).hom g = 1 := by
        rw [← map_mul, ← hu, Units.inv_mul, map_one]
      rw [hg] at hmul
      exact (eq_inv_of_mul_eq_one_left hmul).trans (inv_inv z)

theorem wcpa_dj_lr1k_nsr_gub_itapb_rigid_transfer : ∀ (L Ω : Type u) [Field L] [Field Ω]
    (W : ValuationSubring Ω) (S : Type u) [CommRing S]
    [IsLocalRing S] (ι : S →+* L) (κS : Ω →+* S) (O : ValuationSubring L) (ev : ↥O →+* Ω)
    (V : ValuationSubring L), Function.Injective ι → (∀ z : L, z ∈ O ↔ ∃ g : S, ι g = z) →
    (∀ z : ↥O, IsUnit z ↔ ev z ≠ 0) → (∀ (a : Ω) (z : ↥O), (z : L) = ι (κS a) → ev z = a) →
