      ext i
      rw [Polynomial.coeff_smul, Polynomial.coeff_C_mul, Algebra.smul_def]
    rw [hbq] at hm₁
    generalize IsLocalization.integerNormalization (nonZeroDivisors P)
      (minpoly F₀ (algebraMap A K θ)) = m₁ at hm₁ hm₁A
    have hφinj : Function.Injective (algebraMap P F₀) := IsFractionRing.injective P F₀
    have hdeg₁ : m₁.natDegree = (minpoly F₀ (algebraMap A K θ)).natDegree := by
