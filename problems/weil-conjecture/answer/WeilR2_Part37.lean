      rw [map_sub, map_one, hφa]
    rw [e1, hunit x₁ hx₁F] at n1
    rw [← hφa, hunit x₂ hx₂F] at n2
    rcases IsLocalRing.isUnit_or_isUnit_one_sub_self a with h | h
    · exact n2 h
    · exact n1 h

  have hgpY : IsGenericPoint (h (genericPoint C)) (Set.univ : Set Y) := by
    rw [isGenericPoint_iff_specializes]
    intro y
    simp only [Set.mem_univ, iff_true]
    obtain ⟨hy, -⟩ := hA y
    exact hy
  haveI hstred : ∀ y : Y, _root_.IsReduced (Y.presheaf.stalk y) := fun y => by
    obtain ⟨hy, hinj⟩ := hA y
    exact isReduced_of_injective (wcLr1uGerm h y hy).hom hinj
  haveI : IsReduced Y := isReduced_of_isReduced_stalk Y
  haveI : IrreducibleSpace Y := by rw [irreducibleSpace_def]; exact hgpY.isIrreducible
  haveI hYint : AlgebraicGeometry.IsIntegral Y := isIntegral_of_irreducibleSpace_of_isReduced Y
  have hηY : genericPoint Y = h (genericPoint C) := (genericPoint_spec Y).eq hgpY

  obtain ⟨R, ρ, hρc, hρr, hρred⟩ := wc_reduced_subscheme_exists (Limits.pullback p (N.fromSpecStalk n))
  haveI := hρc
  haveI := hρred
  have hηn : p (h (genericPoint C)) ∈ Set.range (N.fromSpecStalk n) := by
    rw [Scheme.range_fromSpecStalk]; exact hn
  have hξ : h (genericPoint C) ∈ Set.range (Limits.pullback.fst p (N.fromSpecStalk n)) := by
    rw [Scheme.Pullback.range_fst, Set.mem_preimage]; exact hηn
  obtain ⟨z₀, hz₀⟩ := hξ
  obtain ⟨r₀, hr₀⟩ : z₀ ∈ Set.range ρ := by rw [hρr]; trivial
  have hqr₀ : (ρ ≫ Limits.pullback.fst p (N.fromSpecStalk n)) r₀ = h (genericPoint C) := by
    rw [Scheme.Hom.comp_apply, hr₀, hz₀]
  have hgp : IsGenericPoint r₀ (Set.univ : Set R) := by
    rw [isGenericPoint_iff_specializes]
    intro r
    simp only [Set.mem_univ, iff_true]
    rw [← (ρ ≫ Limits.pullback.fst p (N.fromSpecStalk n)).isEmbedding.isInducing.specializes_iff,
      hqr₀]
    obtain ⟨hy, -⟩ := hA ((ρ ≫ Limits.pullback.fst p (N.fromSpecStalk n)) r)
    exact hy
  haveI : IrreducibleSpace R := by rw [irreducibleSpace_def]; exact hgp.isIrreducible
  haveI hRint : AlgebraicGeometry.IsIntegral R := isIntegral_of_irreducibleSpace_of_isReduced R
  have hηR : genericPoint R = r₀ := (genericPoint_spec R).eq hgp
  have hcond : (ρ ≫ Limits.pullback.fst p (N.fromSpecStalk n)) ≫ p =
      (ρ ≫ Limits.pullback.snd p (N.fromSpecStalk n)) ≫ N.fromSpecStalk n := by
    simp only [Category.assoc, Limits.pullback.condition]
  have hint : ∀ f : ↥(R.presheaf.stalk (genericPoint ↥R)),
      ((R.presheaf.germ ⊤ (genericPoint ↥R) trivial).hom.comp
        ((ρ ≫ Limits.pullback.snd p (N.fromSpecStalk n)).appTop.hom.comp
          (Scheme.ΓSpecIso (.of ↥(N.presheaf.stalk n))).inv.hom)).IsIntegralElem f →
      ∃ a : ↥(N.presheaf.stalk n), ((R.presheaf.germ ⊤ (genericPoint ↥R) trivial).hom.comp
        ((ρ ≫ Limits.pullback.snd p (N.fromSpecStalk n)).appTop.hom.comp
          (Scheme.ΓSpecIso (.of ↥(N.presheaf.stalk n))).inv.hom)) a = f := by
    intro f hf
    have hx : (ρ ≫ Limits.pullback.fst p (N.fromSpecStalk n)) (genericPoint R) =
        h (genericPoint C) := by rw [hηR, hqr₀]
    have s : p ((ρ ≫ Limits.pullback.fst p (N.fromSpecStalk n)) (genericPoint R)) ⤳ n := by
      rw [hx]; exact hn
    have s' : ((ρ ≫ Limits.pullback.snd p (N.fromSpecStalk n)) ≫ N.fromSpecStalk n)
        (genericPoint R) ⤳ n := by
      rw [← hcond]; exact s
    obtain ⟨hxsp, hιinj⟩ := hA ((ρ ≫ Limits.pullback.fst p (N.fromSpecStalk n)) (genericPoint R))

    have star : ∀ (s : Spec (N.presheaf.stalk n)) (hs : N.fromSpecStalk n s ⤳ n)
        (c : N.presheaf.stalk n),
        ((N.fromSpecStalk n).stalkMap s).hom ((N.presheaf.stalkSpecializes hs).hom c) =
          ((Spec (N.presheaf.stalk n)).presheaf.germ ⊤ s trivial).hom
            ((Scheme.ΓSpecIso (N.presheaf.stalk n)).inv.hom c) := by
      intro s hs c
      obtain ⟨U, hnU, f₀, rfl⟩ := N.presheaf.exists_germ_eq c
      rw [TopCat.Presheaf.germ_stalkSpecializes_apply, Scheme.Hom.germ_stalkMap_apply,
        Scheme.fromSpecStalk_app hnU]
      simp only [CategoryTheory.comp_apply]
      exact TopCat.Presheaf.germ_res_apply _ _ _ _ _
    have hψ : ∀ (s₀ : ((ρ ≫ Limits.pullback.snd p (N.fromSpecStalk n)) ≫ N.fromSpecStalk n)
        (genericPoint R) ⤳ n) (c : N.presheaf.stalk n),
        (((ρ ≫ Limits.pullback.snd p (N.fromSpecStalk n)) ≫ N.fromSpecStalk n).stalkMap
          (genericPoint R)).hom ((N.presheaf.stalkSpecializes s₀).hom c) =
        ((R.presheaf.germ ⊤ (genericPoint ↥R) trivial).hom.comp
          ((ρ ≫ Limits.pullback.snd p (N.fromSpecStalk n)).appTop.hom.comp
            (Scheme.ΓSpecIso (.of ↥(N.presheaf.stalk n))).inv.hom)) c := by
      intro s₀ c
      rw [Scheme.Hom.stalkMap_comp]
      erw [CommRingCat.hom_comp, RingHom.comp_apply, star _ s₀ c]
      exact Scheme.Hom.germ_stalkMap_apply _ ⊤ _ trivial _
    have hcongr : ∀ (φ₁ φ₂ : R ⟶ N), φ₁ = φ₂ → ∀ (s₁ : φ₁ (genericPoint R) ⤳ n)
        (s₂ : φ₂ (genericPoint R) ⤳ n) (c : N.presheaf.stalk n),
        (φ₁.stalkMap (genericPoint R)).hom ((N.presheaf.stalkSpecializes s₁).hom c) =
          (φ₂.stalkMap (genericPoint R)).hom ((N.presheaf.stalkSpecializes s₂).hom c) := by
      rintro φ₁ φ₂ rfl s₁ s₂ c
      rfl
    obtain ⟨θ, hθ⟩ : ∃ θ : N.presheaf.stalk n →+* Y.presheaf.stalk
        ((ρ ≫ Limits.pullback.fst p (N.fromSpecStalk n)) (genericPoint R)),
