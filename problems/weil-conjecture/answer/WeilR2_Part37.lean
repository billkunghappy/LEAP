  haveI : Finite ↥(Spec (.of ↥W)) := hfin
  have hQC : QuasiCompact (Spec.map (CommRingCat.ofHom
      (MvPolynomial.eval (fun _ : Fin 1 => (0 : ↥W)))) ≫ c₁) := by
