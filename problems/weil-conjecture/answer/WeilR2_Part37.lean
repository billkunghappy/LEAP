        ⨆ s : Finset T, ∑ y ∈ s, if I y then δ y else 0) →
      (⨆ s : Finset T', ∑ y ∈ s, if I' y then
          (if ¬(δ' y = 0 ∨ (δ' y = 1 ∧ m' y = 2)) then δ' y ^ 2 + 2 * δ' y - m' y else 0)
          else 0) <
        ⨆ s : Finset T, ∑ y ∈ s, if I y then
          (if ¬(δ y = 0 ∨ (δ y = 1 ∧ m y = 2)) then δ y ^ 2 + 2 * δ y - m y else 0)
          else 0 := by
    intro T T' I I' δ m δ' m' y₀ hI₀ hbad₀ hfin hinv hb₀ hb' himp hbud
    obtain ⟨hδ₀, -, hm₀⟩ := hb₀
    obtain ⟨d, hd⟩ := ENat.ne_top_iff_exists.mp hδ₀
    have hmtop : m y₀ ≠ ⊤ := ne_top_of_le_ne_top (by simp [hδ₀]) hm₀
    obtain ⟨μ, hμ⟩ := ENat.ne_top_iff_exists.mp hmtop
