    ∀ ζ : A, ζ ∈ Ideal.span (Set.range g) → wcBffNoether W A ζ →
    ∃ (E : A) (N : ℕ), 1 ≤ N ∧ 1 - E ∈ 𝔪 ∧
      (E * (1 - E)) ^ N ∈ Ideal.span {algebraMap ↥W A ϖ, ζ} ∧
      ∀ i : Fin 2, (E * g i) ^ N ∈ Ideal.span {algebraMap ↥W A ϖ, ζ} :=
by
  intro Ω _ _ W hdimW _ A _ _ ϖ 𝔪 g hAdm ζ hζg hζN
  classical
  obtain ⟨hϖ0, hϖm, _, _, _, _, _, _, h𝔪max, hm𝔪, hg𝔪, _⟩ := hAdm

  have s2 : ∀ (R : Type u) [CommRing R] [IsArtinianRing R] (𝔫 : Ideal R), 𝔫.IsMaximal →
      ∃ e : R, 1 - e ∈ 𝔫 ∧ IsNilpotent (e * (1 - e)) ∧ ∀ y ∈ 𝔫, IsNilpotent (e * y) := by
    intro R _ _ 𝔫 h𝔫
    have hS := IsArtinianRing.setOfPred_isMaximal_finite R
    set T := hS.toFinset.erase 𝔫 with hT
    have hcop : ∀ i ∈ T, 𝔫 ⊔ id i = ⊤ := by
      intro i hi
      rw [Finset.mem_erase, Set.Finite.mem_toFinset] at hi
      have hm : i.IsMaximal := hi.2
      exact Ideal.IsMaximal.coprime_of_ne h𝔫 hm (Ne.symm hi.1)
    have htop := Ideal.sup_iInf_eq_top hcop
    have h1 : (1 : R) ∈ 𝔫 ⊔ ⨅ i ∈ T, id i := by rw [htop]; exact Submodule.mem_top
    obtain ⟨a, ha, b, hb, hab⟩ := Submodule.mem_sup.mp h1
    have hbT : ∀ i ∈ T, b ∈ i := by
      intro i hi
      have := (Submodule.mem_iInf _).mp hb i
      exact (Submodule.mem_iInf _).mp this hi
    have h1b : 1 - b = a := by rw [← hab]; ring
    refine ⟨b, h1b ▸ ha, ?_, ?_⟩
    · rw [nilpotent_iff_mem_prime]
      intro P hP
