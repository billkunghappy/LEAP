    omega
  obtain ⟨K₁, hK₁⟩ := R1 (ϖ ^ (K + 1)) (pow_ne_zero _ hϖ0) t₀ ht₀
  obtain ⟨Ke, hKe⟩ := R1 e he ϖ hϖm
  refine ⟨K + 1 + Ke * K₁, K + 1, ?_⟩
  intro δ L hL hδ
  have hD : ϖ ^ (K + 1) ∣ δ.eval t₀ - d₀ := (pow_dvd_pow ϖ hL).trans hδ
