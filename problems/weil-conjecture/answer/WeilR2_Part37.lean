    H3 0 1
  have hnz0 : (r.appLE ⊤ (U 0) (by simp)).hom
      ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom
        (MvPolynomial.X 0 - MvPolynomial.C e)) ∈ nonZeroDivisors Γ(B, U 0) :=
