  apply hcut
  refine ⟨⟨β, hβW⟩, ?_, ?_⟩
  · intro a' ha'
    have hc : (a' : Ω) / β ∈ W := by
      rw [← hφ, map_div₀, Valuation.map_div, div_le_one₀ hβpos, hvβ]
      exact (hPL a' ha').le
    refine ⟨⟨(a' : Ω) / β, hc⟩, Subtype.ext ?_⟩
    show (a' : Ω) = β * ((a' : Ω) / β)
    rw [mul_div_cancel₀ _ hβ0]
  · intro b' hb'
    have hb'pos : 0 < A.valuation (φ (b' : Ω)) := lt_of_lt_of_le hs (hPE b' hb')
    have hb'0 : (b' : Ω) ≠ 0 := by
      intro h
      rw [h, map_zero, Valuation.map_zero] at hb'pos
      exact lt_irrefl _ hb'pos
    have hc : β / (b' : Ω) ∈ W := by
      rw [← hφ, map_div₀, Valuation.map_div, div_le_one₀ hb'pos, hvβ]
      exact hPE b' hb'
    refine ⟨⟨β / (b' : Ω), hc⟩, Subtype.ext ?_⟩
    show β = (b' : Ω) * (β / (b' : Ω))
    rw [mul_div_cancel₀ _ hb'0]

theorem wcpa_dj_lr1k_nsr_na_se_finite : ∀ (Ω : Type u) [Field Ω] (C : Scheme.{u})
    [AlgebraicGeometry.IsIntegral C] (γ : C ⟶ wcProjK Ω 1), wcpaDjLkCov Ω γ →
    ∀ s : C.functionField,
      (∀ P : Polynomial Ω, P ≠ 0 → P.eval₂ (wcLr1uConst (γ ≫ wcProjKStr Ω 1)) s ≠ 0) →
      FiniteDimensional
        ↥(Subfield.closure (Set.range (wcLr1uConst (γ ≫ wcProjKStr Ω 1)) ∪ {s}))
        C.functionField :=
by
  intro Ω _ C _ γ hcov s htr
  have key : ∀ (L : Type u) [Field L] (φ : Ω →+* L) (s : L) (S : Finset L),
      (letI := φ.toAlgebra; IntermediateField.adjoin Ω (S : Set L) = ⊤) →
      (∀ P : Polynomial Ω, P ≠ 0 → P.eval₂ φ s ≠ 0) →
      (∀ f : L, ∃ (n : ℕ) (p : Fin (n + 1) → Polynomial Ω), (∃ i, p i ≠ 0) ∧
        ∑ i, (p i).eval₂ φ s * f ^ (i : ℕ) = 0) →
      FiniteDimensional ↥(Subfield.closure (Set.range φ ∪ {s})) L := by
    intro L _ φ s S hS htr hrelx
    classical
    set K₀ : Subfield L := Subfield.closure (Set.range φ ∪ {s}) with hK₀
    have hconst : ∀ c : Ω, φ c ∈ K₀ :=
      fun c => Subfield.subset_closure (Set.mem_union_left _ ⟨c, rfl⟩)
    have hsK : s ∈ K₀ :=
      Subfield.subset_closure (Set.mem_union_right _ (Set.mem_singleton s))
    have hc : ∀ P : Polynomial Ω, P.eval₂ φ s ∈ K₀ := by
      intro P
      induction P using Polynomial.induction_on' with
      | add p q hp hq => rw [Polynomial.eval₂_add]; exact K₀.add_mem hp hq
      | monomial n a =>
        rw [Polynomial.eval₂_monomial]
        exact K₀.mul_mem (hconst a) (K₀.pow_mem hsK n)
    have halg : ∀ x : L, IsAlgebraic K₀ x := by
      intro x
      obtain ⟨n, p, ⟨i₀, hi₀⟩, hrel⟩ := hrelx x
      refine ⟨∑ i : Fin (n + 1), Polynomial.C
          (⟨(p i).eval₂ φ s, hc (p i)⟩ : K₀) * Polynomial.X ^ (i : ℕ), ?_, ?_⟩
      · intro hQ
        have h1 := congrArg (fun q => Polynomial.coeff q (i₀ : ℕ)) hQ
        simp only [Polynomial.finset_sum_coeff, Polynomial.coeff_C_mul_X_pow,
          Polynomial.coeff_zero] at h1
        rw [Finset.sum_eq_single i₀ (fun j _ hj => if_neg (fun h => hj (Fin.ext h).symm))
          (fun h => absurd (Finset.mem_univ _) h), if_pos rfl] at h1
        exact htr (p i₀) hi₀ (congrArg Subtype.val h1)
      · simp only [map_sum, map_mul, Polynomial.aeval_C, Polynomial.aeval_X_pow]
        exact Eq.trans (Finset.sum_congr rfl fun i _ => rfl) hrel
    have hint : ∀ x ∈ (S : Set L), IsIntegral K₀ x := fun x _ => (halg x).isIntegral
    haveI hE : FiniteDimensional K₀ ↥(IntermediateField.adjoin K₀ (S : Set L)) :=
      IntermediateField.finiteDimensional_adjoin hint
    letI : Algebra Ω L := φ.toAlgebra
    let T : IntermediateField Ω L :=
      (IntermediateField.adjoin K₀ (S : Set L)).toSubfield.toIntermediateField
        (fun c => IntermediateField.algebraMap_mem _ (⟨φ c, hconst c⟩ : K₀))
    have hle : IntermediateField.adjoin Ω (S : Set L) ≤ T :=
      IntermediateField.adjoin_le_iff.mpr
        (fun x hx => IntermediateField.subset_adjoin K₀ (S : Set L) hx)
    have hall : ∀ z : L, z ∈ IntermediateField.adjoin K₀ (S : Set L) := by
      intro z
      have hz : z ∈ IntermediateField.adjoin Ω (S : Set L) := by
        rw [hS]; exact IntermediateField.mem_top
      exact hle hz
    exact Module.Finite.of_surjective
      (IntermediateField.adjoin K₀ (S : Set L)).val.toLinearMap
      (fun z => ⟨⟨z, hall z⟩, rfl⟩)
  haveI : IsProper (γ ≫ wcProjKStr Ω 1) := wcpa_dj_proj_proper Ω _ hcov.1
  obtain ⟨⟨S, hS⟩, -⟩ := wcpa_dj_cf_sp_function_field_trdeg Ω C (γ ≫ wcProjKStr Ω 1)
  exact key C.functionField (wcLr1uConst (γ ≫ wcProjKStr Ω 1)) s S hS htr
    (wcpa_dj_lr1k_nsr_na_er_algebraic Ω C γ hcov s htr)

theorem wcpa_dj_lr1k_nsr_na_se_window : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω) (L : Type u) [Field L] (A : ValuationSubring L) (φ : Ω →+* L)
    (s : L) (PL PE : ↥W → Prop),
    (∀ b : Ω, A.valuation (φ b) ≤ 1 ↔ b ∈ W) →
    (∀ a' : ↥W, PL a' → a' ≠ 0 ∧ A.valuation (φ (a' : Ω)) < A.valuation s) →
    (∀ b : ↥W, PE b → A.valuation s ≤ A.valuation (φ (b : Ω))) →
    (∃ a' : ↥W, PL a') → (∃ b : ↥W, PE b) →
    (¬ ∃ β : ↥W, (∀ a' : ↥W, PL a' → β ∣ a') ∧ (∀ b : ↥W, PE b → b ∣ β)) →
    (∀ n : ℕ, 1 ≤ n → ∀ b : Ω, A.valuation (s ^ n) ≠ A.valuation (φ b)) →
    ∀ (m : ℕ) (c : Fin m → L),
      (∀ j, c j ∈ Subfield.closure (Set.range φ ∪ {s}) ∧ A.valuation (c j) ≤ 1) →
      ∃ (a b : ↥W), PL a ∧ PE b ∧ ∃ d : Fin m → ↥W,
        (∀ j, A.valuation (c j - φ (d j : Ω)) < 1) ∧
        ∀ V : ValuationSubring L, (∀ w : ↥W, V.valuation (φ (w : Ω)) ≤ 1) →
          (∀ w : ↥W, w ∈ IsLocalRing.maximalIdeal ↥W → V.valuation (φ (w : Ω)) < 1) →
          V.valuation (φ (a : Ω)) < V.valuation s → V.valuation s ≤ V.valuation (φ (b : Ω)) →
          ∀ j, c j ∈ V ∧ V.valuation (c j - φ (d j : Ω)) < 1 :=
by
  intro Ω _ _ W L _ A φ s PL PE hW hPL hPE hPLex hPEex hcut hNT m c hc
  classical

  have hs : A.valuation s ≠ 0 := by
    have h := hNT 1 le_rfl 0
    rwa [pow_one, map_zero, map_zero] at h
  have hs0 : s ≠ 0 := fun h => hs (by rw [h, map_zero])
  have hφ : ∀ β : Ω, β ≠ 0 → A.valuation (φ β) ≠ 0 := by
    intro β hβ
    rw [Valuation.ne_zero_iff]
    exact (map_ne_zero φ).mpr hβ
  have ht : ∀ (β : Ω) (i : ℕ), β ≠ 0 → A.valuation (φ β * s ^ i) ≠ 0 := by
    intro β i hβ
    rw [map_mul, map_pow]
    exact mul_ne_zero (hφ β hβ) (pow_ne_zero _ hs)
  have htV : ∀ (V : ValuationSubring L) (β : Ω) (i : ℕ), β ≠ 0 → 0 < V.valuation (φ β * s ^ i) :=
    fun V β i hβ => (Valuation.pos_iff _).mpr (mul_ne_zero ((map_ne_zero φ).mpr hβ)
      (pow_ne_zero _ hs0))

  have hdivW : ∀ x y : Ω, y ≠ 0 → A.valuation (φ x) ≤ A.valuation (φ y) → x / y ∈ W := by
    intro x y hy hle
    apply (hW _).mp
    rw [map_div₀, map_div₀]
    exact (div_le_one₀ (zero_lt_iff.mpr (hφ y hy))).mpr hle
  have hdvd : ∀ x y : ↥W, (y : Ω) ≠ 0 → A.valuation (φ (x : Ω)) ≤ A.valuation (φ (y : Ω)) →
      y ∣ x := by
    intro x y hy hle
    refine ⟨⟨(x : Ω) / y, hdivW _ _ hy hle⟩, Subtype.ext ?_⟩
    show (x : Ω) = (y : Ω) * ((x : Ω) / y)
    field_simp

  have hmonoV : ∀ x y : Ω, y ≠ 0 → A.valuation (φ x) ≤ A.valuation (φ y) →
      ∀ V : ValuationSubring L, (∀ w : ↥W, V.valuation (φ (w : Ω)) ≤ 1) →
        V.valuation (φ x) ≤ V.valuation (φ y) := by
    intro x y hy hle V hV1
    have hxy := hdivW x y hy hle
    have h1 : V.valuation (φ (x / y)) ≤ 1 := hV1 ⟨x / y, hxy⟩
    calc V.valuation (φ x) = V.valuation (φ (x / y)) * V.valuation (φ y) := by
          rw [← map_mul, ← map_mul, div_mul_cancel₀ x hy]
      _ ≤ V.valuation (φ y) := mul_le_of_le_one_left zero_le' h1

  have hmax : ∀ w : ↥W, A.valuation (φ (w : Ω)) < 1 → w ∈ IsLocalRing.maximalIdeal ↥W := by
    intro w hw
    by_contra hmem
    have hu : IsUnit w := by
      rwa [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, not_not] at hmem
    obtain ⟨u, hu'⟩ := hu.exists_right_inv
    have hwu : (w : Ω) * (u : Ω) = 1 := by
      have := congrArg Subtype.val hu'
      simpa using this
    have e : A.valuation (φ (w : Ω)) * A.valuation (φ (u : Ω)) = 1 := by
      rw [← map_mul, ← map_mul, hwu, map_one, map_one]
    have hu1 : A.valuation (φ (u : Ω)) ≤ 1 := (hW u).mpr u.2
    have hlt : A.valuation (φ (w : Ω)) * A.valuation (φ (u : Ω)) < 1 :=
      lt_of_le_of_lt (mul_le_of_le_one_right' hu1) hw
    rw [e] at hlt
    exact lt_irrefl _ hlt
  have hane : ∀ a : ↥W, PL a → (a : Ω) ≠ 0 := by
    intro a ha h
    apply (hPL a ha).1
    ext
    simpa using h
  have hbne : ∀ b : ↥W, PE b → (b : Ω) ≠ 0 := by
    intro b hb h
    have := hPE b hb
    rw [h, map_zero, map_zero] at this
    exact hs (le_antisymm this zero_le')
  obtain ⟨a₁, ha₁⟩ := hPLex
  obtain ⟨b₁, hb₁⟩ := hPEex

  have hwinTriv : ∀ Ψ : ValuationSubring L → Prop, (∀ V, Ψ V) → wcSewWin W φ s PL PE Ψ :=
    fun Ψ h => ⟨a₁, b₁, ha₁, hb₁, fun V _ _ _ _ => h V⟩
  have hwinMono : ∀ Φ Ψ : ValuationSubring L → Prop, wcSewWin W φ s PL PE Φ →
      (∀ V : ValuationSubring L, (∀ w : ↥W, V.valuation (φ (w : Ω)) ≤ 1) → Φ V → Ψ V) →
      wcSewWin W φ s PL PE Ψ := by
    rintro Φ Ψ ⟨a, b, ha, hb, h⟩ himp
    exact ⟨a, b, ha, hb, fun V h1 h2 h3 h4 => himp V h1 (h V h1 h2 h3 h4)⟩
  have hconj2 : ∀ Φ Ψ : ValuationSubring L → Prop, wcSewWin W φ s PL PE Φ →
      wcSewWin W φ s PL PE Ψ → wcSewWin W φ s PL PE (fun V => Φ V ∧ Ψ V) := by
    rintro Φ Ψ ⟨a1, b1, ha1, hb1, h1⟩ ⟨a2, b2, ha2, hb2, h2⟩
    obtain ⟨a, ha, haw⟩ : ∃ a : ↥W, PL a ∧ ∀ V : ValuationSubring L,
        (∀ w : ↥W, V.valuation (φ (w : Ω)) ≤ 1) → V.valuation (φ (a : Ω)) < V.valuation s →
        V.valuation (φ (a1 : Ω)) < V.valuation s ∧ V.valuation (φ (a2 : Ω)) < V.valuation s := by
      rcases le_total (A.valuation (φ (a1 : Ω))) (A.valuation (φ (a2 : Ω))) with h | h
      · exact ⟨a2, ha2, fun V hV1 hlt =>
          ⟨lt_of_le_of_lt (hmonoV _ _ (hane a2 ha2) h V hV1) hlt, hlt⟩⟩
      · exact ⟨a1, ha1, fun V hV1 hlt =>
          ⟨hlt, lt_of_le_of_lt (hmonoV _ _ (hane a1 ha1) h V hV1) hlt⟩⟩
    obtain ⟨b, hb, hbw⟩ : ∃ b : ↥W, PE b ∧ ∀ V : ValuationSubring L,
        (∀ w : ↥W, V.valuation (φ (w : Ω)) ≤ 1) → V.valuation s ≤ V.valuation (φ (b : Ω)) →
        V.valuation s ≤ V.valuation (φ (b1 : Ω)) ∧ V.valuation s ≤ V.valuation (φ (b2 : Ω)) := by
      rcases le_total (A.valuation (φ (b1 : Ω))) (A.valuation (φ (b2 : Ω))) with h | h
      · exact ⟨b1, hb1, fun V hV1 hle => ⟨hle, hle.trans (hmonoV _ _ (hbne b2 hb2) h V hV1)⟩⟩
      · exact ⟨b2, hb2, fun V hV1 hle => ⟨hle.trans (hmonoV _ _ (hbne b1 hb1) h V hV1), hle⟩⟩
    exact ⟨a, b, ha, hb, fun V hV1 hV2 hVa hVb =>
      ⟨h1 V hV1 hV2 (haw V hV1 hVa).1 (hbw V hV1 hVb).1,
        h2 V hV1 hV2 (haw V hV1 hVa).2 (hbw V hV1 hVb).2⟩⟩
  have hconjF : ∀ {ι : Type} (T : Finset ι) (Φ : ι → ValuationSubring L → Prop),
      (∀ t ∈ T, wcSewWin W φ s PL PE (Φ t)) →
      wcSewWin W φ s PL PE (fun V => ∀ t ∈ T, Φ t V) := by
    intro ι T Φ
    induction T using Finset.induction_on with
    | empty => intro _; exact hwinTriv _ (fun V t ht => absurd ht (Finset.notMem_empty t))
    | insert t T htT ih =>
      intro h
      have h' := hconj2 _ _ (h t (Finset.mem_insert_self t T))
        (ih (fun t' ht' => h t' (Finset.mem_insert_of_mem ht')))
      refine hwinMono _ _ h' (fun V _ hV t' ht' => ?_)
      rcases Finset.mem_insert.mp ht' with rfl | h''
      · exact hV.1
      · exact hV.2 t' h''

  have hmonomial : ∀ (p q : Ω) (i k : ℕ), q ≠ 0 →
      A.valuation (φ p * s ^ i) < A.valuation (φ q * s ^ k) →
      wcSewWin W φ s PL PE (fun V => V.valuation (φ p * s ^ i) < V.valuation (φ q * s ^ k)) := by
    intro p q i k hq hlt
    by_cases hp : p = 0
    · exact hwinTriv _ (fun V => by
        rw [hp, map_zero, zero_mul, map_zero]; exact htV V q k hq)
    obtain ⟨δ, hδ0, hpδ⟩ : ∃ δ : Ω, δ ≠ 0 ∧ φ p = φ δ * φ q :=
      ⟨p / q, div_ne_zero hp hq, by rw [← map_mul, div_mul_cancel₀ p hq]⟩
    have hδpos : 0 < A.valuation (φ δ) := zero_lt_iff.mpr (hφ δ hδ0)
    rcases le_or_gt k i with hki | hik
    · obtain ⟨j, rfl⟩ := Nat.exists_eq_add_of_le hki
      have hY : 0 < A.valuation (φ q * s ^ k) := zero_lt_iff.mpr (ht q k hq)
      have hstar : A.valuation (φ δ) * A.valuation s ^ j < 1 := by
        have e : A.valuation (φ p * s ^ (k + j)) =
            (A.valuation (φ δ) * A.valuation s ^ j) * A.valuation (φ q * s ^ k) := by
          rw [hpδ, pow_add]; simp only [map_mul, map_pow]; ac_rfl
        rw [e] at hlt
        exact lt_of_mul_lt_mul_right (by rwa [one_mul]) hY.le
      obtain ⟨b₀, hb₀, hb₀lt⟩ : ∃ b₀ : ↥W, PE b₀ ∧
          A.valuation (φ δ) * A.valuation (φ (b₀ : Ω)) ^ j < 1 := by
        rcases Nat.eq_zero_or_pos j with hj | hj
        · refine ⟨b₁, hb₁, ?_⟩
          rw [hj, pow_zero, mul_one]
          rw [hj, pow_zero, mul_one] at hstar
          exact hstar
        by_contra hcon
        push_neg at hcon
        obtain ⟨β, hβ⟩ := IsAlgClosed.exists_pow_nat_eq δ⁻¹ hj
        have hβ0 : β ≠ 0 := by
          rintro rfl
          rw [zero_pow hj.ne'] at hβ
          exact inv_ne_zero hδ0 hβ.symm
        have e1 : A.valuation (φ β) ^ j * A.valuation (φ δ) = 1 := by
          rw [← Valuation.map_pow, ← map_pow, ← Valuation.map_mul, ← map_mul, hβ,
            inv_mul_cancel₀ hδ0, map_one, Valuation.map_one]
        have hbβ : ∀ b : ↥W, PE b → A.valuation (φ β) ≤ A.valuation (φ (b : Ω)) := by
          intro b hb
          have h1 := hcon b hb
          rw [← e1, mul_comm (A.valuation (φ δ))] at h1
          exact le_of_pow_le_pow_left₀ hj.ne' zero_le' (le_of_mul_le_mul_right h1 hδpos)
        have hsβ : A.valuation s < A.valuation (φ β) := by
          rw [← e1, mul_comm (A.valuation (φ δ))] at hstar
          exact lt_of_pow_lt_pow_left₀ j zero_le' (lt_of_mul_lt_mul_right hstar hδpos.le)
        have hβW : β ∈ W := (hW β).mp ((hbβ b₁ hb₁).trans ((hW _).mpr b₁.2))
        apply hcut
        refine ⟨⟨β, hβW⟩, fun a' ha' => ?_, fun b hb => ?_⟩
        · exact hdvd a' ⟨β, hβW⟩ hβ0 ((hPL a' ha').2.trans hsβ).le
        · exact hdvd ⟨β, hβW⟩ b (hbne b hb) (hbβ b hb)
      have hw0v : A.valuation (φ (δ * (b₀ : Ω) ^ j)) < 1 := by
        rw [map_mul, map_pow, Valuation.map_mul, Valuation.map_pow]; exact hb₀lt
      have hw0W : δ * (b₀ : Ω) ^ j ∈ W := (hW _).mp hw0v.le
      have hw0m := hmax ⟨_, hw0W⟩ hw0v
      refine ⟨a₁, b₀, ha₁, hb₀, fun V hV1 hV2 hVa hVb => ?_⟩
      have hVw : V.valuation (φ (δ * (b₀ : Ω) ^ j)) < 1 := hV2 _ hw0m
      rw [map_mul, map_pow, Valuation.map_mul, Valuation.map_pow] at hVw
      have hsj : V.valuation (φ δ) * V.valuation s ^ j < 1 :=
        lt_of_le_of_lt (mul_le_mul_of_nonneg_left (pow_le_pow_left₀ zero_le' hVb j) zero_le') hVw
      have e : V.valuation (φ p * s ^ (k + j)) =
          (V.valuation (φ δ) * V.valuation s ^ j) * V.valuation (φ q * s ^ k) := by
        rw [hpδ, pow_add]; simp only [map_mul, map_pow]; ac_rfl
      show V.valuation (φ p * s ^ (k + j)) < V.valuation (φ q * s ^ k)
      rw [e]
      exact mul_lt_of_lt_one_left (htV V q k hq) hsj
    · obtain ⟨j, rfl⟩ := Nat.exists_eq_add_of_le hik.le
      have hj : 0 < j := by omega
      have hZ : 0 < A.valuation (φ q * s ^ i) := zero_lt_iff.mpr (ht q i hq)
      have hstar : A.valuation (φ δ) < A.valuation s ^ j := by
        have e1 : A.valuation (φ p * s ^ i) = A.valuation (φ δ) * A.valuation (φ q * s ^ i) := by
          rw [hpδ]; simp only [map_mul]; ac_rfl
        have e2 : A.valuation (φ q * s ^ (i + j)) =
            A.valuation s ^ j * A.valuation (φ q * s ^ i) := by
          rw [pow_add]; simp only [map_mul, map_pow]; ac_rfl
        rw [e1, e2] at hlt
        exact lt_of_mul_lt_mul_right hlt hZ.le
      obtain ⟨a₀, ha₀, ha₀le⟩ : ∃ a₀ : ↥W, PL a₀ ∧
          A.valuation (φ δ) ≤ A.valuation (φ (a₀ : Ω)) ^ j := by
        by_contra hcon
        push_neg at hcon
        obtain ⟨β, hβ⟩ := IsAlgClosed.exists_pow_nat_eq δ hj
        have hβ0 : β ≠ 0 := by
          rintro rfl
          rw [zero_pow hj.ne'] at hβ
          exact hδ0 hβ.symm
        have e1 : A.valuation (φ β) ^ j = A.valuation (φ δ) := by
          rw [← Valuation.map_pow, ← map_pow, hβ]
        have haβ : ∀ a : ↥W, PL a → A.valuation (φ (a : Ω)) < A.valuation (φ β) := by
          intro a ha
          have h1 := hcon a ha
          rw [← e1] at h1
          exact lt_of_pow_lt_pow_left₀ j zero_le' h1
        have hβs : A.valuation (φ β) < A.valuation s := by
          rw [← e1] at hstar
          exact lt_of_pow_lt_pow_left₀ j zero_le' hstar
        have hβb : ∀ b : ↥W, PE b → A.valuation (φ β) ≤ A.valuation (φ (b : Ω)) :=
          fun b hb => (hβs.trans_le (hPE b hb)).le
        have hβW : β ∈ W := (hW β).mp ((hβb b₁ hb₁).trans ((hW _).mpr b₁.2))
        apply hcut
        refine ⟨⟨β, hβW⟩, fun a' ha' => ?_, fun b hb => ?_⟩
        · exact hdvd a' ⟨β, hβW⟩ hβ0 (haβ a' ha').le
        · exact hdvd ⟨β, hβW⟩ b (hbne b hb) (hβb b hb)
      have ha0j : (a₀ : Ω) ^ j ≠ 0 := pow_ne_zero _ (hane a₀ ha₀)
      have hle' : A.valuation (φ δ) ≤ A.valuation (φ ((a₀ : Ω) ^ j)) := by
        rwa [map_pow, Valuation.map_pow]
      refine ⟨a₀, b₁, ha₀, hb₁, fun V hV1 hV2 hVa hVb => ?_⟩
      have h1 : V.valuation (φ δ) ≤ V.valuation (φ ((a₀ : Ω) ^ j)) := hmonoV _ _ ha0j hle' V hV1
      rw [map_pow, Valuation.map_pow] at h1
      have h2 : V.valuation (φ δ) < V.valuation s ^ j :=
        lt_of_le_of_lt h1 (pow_lt_pow_left₀ hVa zero_le' hj.ne')
      have e1 : V.valuation (φ p * s ^ i) = V.valuation (φ δ) * V.valuation (φ q * s ^ i) := by
        rw [hpδ]; simp only [map_mul]; ac_rfl
      have e2 : V.valuation (φ q * s ^ (i + j)) =
          V.valuation s ^ j * V.valuation (φ q * s ^ i) := by
        rw [pow_add]; simp only [map_mul, map_pow]; ac_rfl
      show V.valuation (φ p * s ^ i) < V.valuation (φ q * s ^ (i + j))
      rw [e1, e2]
      exact mul_lt_mul_of_pos_right h2 (htV V q i hq)

  have hD : ∀ (i j : ℕ) (β β' : Ω), i < j → β ≠ 0 → β' ≠ 0 →
      A.valuation (φ β * s ^ i) ≠ A.valuation (φ β' * s ^ j) := by
    intro i j β β' hij hβ hβ' heq
    obtain ⟨n, hn, rfl⟩ : ∃ n, 1 ≤ n ∧ j = i + n := ⟨j - i, by omega, by omega⟩
    apply hNT n hn (β / β')
    rw [map_mul, map_mul, map_pow, map_pow, pow_add] at heq
    rw [map_pow, map_div₀, map_div₀, eq_div_iff (hφ β' hβ')]
    apply mul_right_cancel₀ (pow_ne_zero i hs)
    rw [heq]
    ac_rfl
  have hD' : ∀ (i j : ℕ) (β β' : Ω), i ≠ j → β ≠ 0 →
      A.valuation (φ β * s ^ i) ≠ A.valuation (φ β' * s ^ j) := by
    intro i j β β' hij hβ
    by_cases hβ' : β' = 0
    · rw [hβ', map_zero, zero_mul, map_zero]
      exact ht β i hβ
    rcases lt_or_gt_of_ne hij with h | h
    · exact hD i j β β' h hβ hβ'
    · exact fun e => hD j i β' β h hβ' hβ e.symm
  have hdom : ∀ (P : Polynomial Ω) (N : ℕ), P ≠ 0 → P.natDegree < N →
      ∃ k ∈ Finset.range N, P.coeff k ≠ 0 ∧
        (∀ i ∈ Finset.range N, i ≠ k →
          A.valuation (φ (P.coeff i) * s ^ i) < A.valuation (φ (P.coeff k) * s ^ k)) ∧
        A.valuation (P.eval₂ φ s) = A.valuation (φ (P.coeff k) * s ^ k) := by
    intro P N hP hN
    have hne : (Finset.range N).Nonempty := ⟨P.natDegree, Finset.mem_range.mpr hN⟩
    obtain ⟨k, hk, hmx⟩ := Finset.exists_max_image (Finset.range N)
      (fun i => A.valuation (φ (P.coeff i) * s ^ i)) hne
    have hck : P.coeff k ≠ 0 := by
      intro h0
      have h1 : A.valuation (φ (P.coeff P.natDegree) * s ^ P.natDegree) ≤
          A.valuation (φ (P.coeff k) * s ^ k) := hmx P.natDegree (Finset.mem_range.mpr hN)
      rw [h0, map_zero, zero_mul, map_zero] at h1
      exact ht (P.coeff P.natDegree) P.natDegree (Polynomial.leadingCoeff_ne_zero.mpr hP)
        (le_antisymm h1 zero_le')
    have hstrict : ∀ i ∈ Finset.range N, i ≠ k →
        A.valuation (φ (P.coeff i) * s ^ i) < A.valuation (φ (P.coeff k) * s ^ k) := by
      intro i hi hik
      exact lt_of_le_of_ne (hmx i hi) (fun e => hD' k i _ _ (Ne.symm hik) hck e.symm)
    refine ⟨k, hk, hck, hstrict, ?_⟩
    rw [Polynomial.eval₂_eq_sum_range' φ hN]
    apply Valuation.map_sum_eq_of_lt A.valuation hk
    intro i hi
    rw [Finset.mem_sdiff, Finset.mem_singleton] at hi
    exact hstrict i hi.1 hi.2

  have hgauss : ∀ P₁ P₂ : Polynomial Ω, P₂.eval₂ φ s ≠ 0 →
      A.valuation (P₁.eval₂ φ s) ≤ A.valuation (P₂.eval₂ φ s) →
      ∃ b : ↥W, A.valuation (P₁.eval₂ φ s - φ b * P₂.eval₂ φ s) < A.valuation (P₂.eval₂ φ s) := by
    intro P₁ P₂ h2 hle
    have hM0 : A.valuation (P₂.eval₂ φ s) ≠ 0 := (Valuation.ne_zero_iff _).mpr h2
    rcases lt_or_eq_of_le hle with hlt | heq
    · refine ⟨0, ?_⟩
      rw [ZeroMemClass.coe_zero, map_zero, zero_mul, sub_zero]
      exact hlt
    · have hP2 : P₂ ≠ 0 := by
        rintro rfl
        exact h2 (Polynomial.eval₂_zero _ _)
      have hP1 : P₁ ≠ 0 := by
        rintro rfl
        rw [Polynomial.eval₂_zero, map_zero] at heq
        exact hM0 heq.symm
      have hN1 : P₁.natDegree < max P₁.natDegree P₂.natDegree + 1 := by omega
      have hN2 : P₂.natDegree < max P₁.natDegree P₂.natDegree + 1 := by omega
      obtain ⟨k₁, hk₁, hc₁, hs₁, hv₁⟩ := hdom P₁ _ hP1 hN1
      obtain ⟨k₂, hk₂, hc₂, hs₂, hv₂⟩ := hdom P₂ _ hP2 hN2
      have hkk : k₁ = k₂ := by
        by_contra hne
        exact hD' k₁ k₂ _ _ hne hc₁ (by rw [← hv₁, ← hv₂]; exact heq)
      subst hkk
      have hcv : A.valuation (φ (P₁.coeff k₁)) = A.valuation (φ (P₂.coeff k₁)) := by
        have e : A.valuation (φ (P₁.coeff k₁) * s ^ k₁) =
            A.valuation (φ (P₂.coeff k₁) * s ^ k₁) := by
          rw [← hv₁, ← hv₂]; exact heq
        rw [map_mul, map_mul] at e
        exact mul_right_cancel₀ (by rw [map_pow]; exact pow_ne_zero _ hs) e
      have hb1 : A.valuation (φ (P₁.coeff k₁ / P₂.coeff k₁)) = 1 := by
        rw [map_div₀, map_div₀, hcv, div_self (hφ _ hc₂)]
      have hbW : P₁.coeff k₁ / P₂.coeff k₁ ∈ W := (hW _).mp (le_of_eq hb1)
      refine ⟨⟨P₁.coeff k₁ / P₂.coeff k₁, hbW⟩, ?_⟩
      show A.valuation (P₁.eval₂ φ s - φ (P₁.coeff k₁ / P₂.coeff k₁) * P₂.eval₂ φ s) <
        A.valuation (P₂.eval₂ φ s)
      rw [Polynomial.eval₂_eq_sum_range' φ hN1 s, Polynomial.eval₂_eq_sum_range' φ hN2 s,
        Finset.mul_sum, ← Finset.sum_sub_distrib]
      rw [Polynomial.eval₂_eq_sum_range' φ hN2 s] at hM0 hv₂ heq
      apply Valuation.map_sum_lt _ hM0
      intro i hi
      by_cases hik : i = k₁
      · rw [hik]
        have e : φ (P₁.coeff k₁ / P₂.coeff k₁) * (φ (P₂.coeff k₁) * s ^ k₁) =
            φ (P₁.coeff k₁) * s ^ k₁ := by
          rw [← mul_assoc, ← map_mul, div_mul_cancel₀ _ hc₂]
        rw [e, sub_self, map_zero]
        exact zero_lt_iff.mpr hM0
      · refine lt_of_le_of_lt (Valuation.map_sub _ _ _) (max_lt ?_ ?_)
        · rw [← heq, hv₁]; exact hs₁ i hi hik
        · rw [map_mul, hb1, one_mul, hv₂]; exact hs₂ i hi hik

  have hpoly : ∀ R Q : Polynomial Ω, A.valuation (R.eval₂ φ s) < A.valuation (Q.eval₂ φ s) →
      wcSewWin W φ s PL PE (fun V => V.valuation (R.eval₂ φ s) < V.valuation (Q.eval₂ φ s)) := by
    intro R Q hlt
    have hQ0 : Q ≠ 0 := by
      rintro rfl
      rw [Polynomial.eval₂_zero, map_zero] at hlt
      exact not_lt_zero' hlt
    have hNR : R.natDegree < max R.natDegree Q.natDegree + 1 := by omega
    have hNQ : Q.natDegree < max R.natDegree Q.natDegree + 1 := by omega
    obtain ⟨k, hk, hck, hsQ, hvQ⟩ := hdom Q _ hQ0 hNQ
    have hRk : ∀ i ∈ Finset.range (max R.natDegree Q.natDegree + 1),
        A.valuation (φ (R.coeff i) * s ^ i) < A.valuation (φ (Q.coeff k) * s ^ k) := by
      intro i hi
      by_cases hR0 : R = 0
      · rw [hR0, Polynomial.coeff_zero, map_zero, zero_mul, map_zero]
        exact zero_lt_iff.mpr (ht _ k hck)
      obtain ⟨k', hk', hck', hsR, hvR⟩ := hdom R _ hR0 hNR
      have h1 : A.valuation (φ (R.coeff i) * s ^ i) ≤ A.valuation (φ (R.coeff k') * s ^ k') := by
        by_cases hik : i = k'
        · rw [hik]
        · exact (hsR i hi hik).le
      rw [← hvQ]
      rw [← hvR] at h1
      exact h1.trans_lt hlt
    have hwin := hconjF (Finset.range (max R.natDegree Q.natDegree + 1))
      (fun i V => V.valuation (φ (R.coeff i) * s ^ i) < V.valuation (φ (Q.coeff k) * s ^ k) ∧
        (i ≠ k → V.valuation (φ (Q.coeff i) * s ^ i) < V.valuation (φ (Q.coeff k) * s ^ k)))
      (fun i hi => hconj2 _ _ (hmonomial _ _ _ _ hck (hRk i hi)) (by
        by_cases hik : i = k
        · exact hwinTriv _ (fun V h => absurd hik h)
        · exact hwinMono _ _ (hmonomial _ _ _ _ hck (hsQ i hi hik)) (fun V _ h _ => h)))
    refine hwinMono _ _ hwin (fun V _ hV => ?_)
    have hY : V.valuation (φ (Q.coeff k) * s ^ k) ≠ 0 := (htV V _ k hck).ne'
    rw [Polynomial.eval₂_eq_sum_range' φ hNR, Polynomial.eval₂_eq_sum_range' φ hNQ]
    have hQV : V.valuation (∑ i ∈ Finset.range (max R.natDegree Q.natDegree + 1),
        φ (Q.coeff i) * s ^ i) = V.valuation (φ (Q.coeff k) * s ^ k) := by
      apply Valuation.map_sum_eq_of_lt V.valuation hk
      intro i hi
      rw [Finset.mem_sdiff, Finset.mem_singleton] at hi
      exact (hV i hi.1).2 hi.2
    rw [hQV]
    exact Valuation.map_sum_lt _ hY (fun i hi => (hV i hi).1)

  have hfrac : ∀ x : L, x ∈ Subfield.closure (Set.range φ ∪ {s}) →
      ∃ P Q : Polynomial Ω, Q.eval₂ φ s ≠ 0 ∧ x = P.eval₂ φ s / Q.eval₂ φ s := by
    intro x hx
    induction hx using Subfield.closure_induction with
    | mem x hx =>
      rcases hx with ⟨w, rfl⟩ | hx
      · exact ⟨Polynomial.C w, 1, by simp, by simp⟩
      · rw [Set.mem_singleton_iff] at hx
        rw [hx]
        exact ⟨Polynomial.X, 1, by simp, by simp⟩
    | one => exact ⟨1, 1, by simp, by simp⟩
    | add x y _ _ hx hy =>
      obtain ⟨P1, Q1, hQ1, rfl⟩ := hx
      obtain ⟨P2, Q2, hQ2, rfl⟩ := hy
      refine ⟨P1 * Q2 + Q1 * P2, Q1 * Q2, by simp [hQ1, hQ2], ?_⟩
      rw [div_add_div _ _ hQ1 hQ2]
      simp
    | neg x _ hx =>
      obtain ⟨P, Q, hQ, rfl⟩ := hx
      exact ⟨-P, Q, hQ, by simp [neg_div]⟩
    | inv x _ hx =>
      obtain ⟨P, Q, hQ, rfl⟩ := hx
      by_cases hP : P.eval₂ φ s = 0
      · exact ⟨0, 1, by simp, by simp [hP]⟩
      · exact ⟨Q, P, hP, by rw [inv_div]⟩
    | mul x y _ _ hx hy =>
      obtain ⟨P1, Q1, hQ1, rfl⟩ := hx
      obtain ⟨P2, Q2, hQ2, rfl⟩ := hy
      exact ⟨P1 * P2, Q1 * Q2, by simp [hQ1, hQ2], by rw [div_mul_div_comm]; simp⟩

  have hcj : ∀ j : Fin m, ∃ (dj : ↥W) (R Q : Polynomial Ω), Q.eval₂ φ s ≠ 0 ∧
      c j - φ (dj : Ω) = R.eval₂ φ s / Q.eval₂ φ s ∧
      A.valuation (R.eval₂ φ s) < A.valuation (Q.eval₂ φ s) := by
    intro j
    obtain ⟨P, Q, hQ, hPQ⟩ := hfrac (c j) (hc j).1
    have hQpos : 0 < A.valuation (Q.eval₂ φ s) := (Valuation.pos_iff _).mpr hQ
    have hle : A.valuation (P.eval₂ φ s) ≤ A.valuation (Q.eval₂ φ s) := by
      have := (hc j).2
      rw [hPQ, Valuation.map_div] at this
      exact (div_le_one₀ hQpos).mp this
    obtain ⟨dj, hdj⟩ := hgauss P Q hQ hle
    refine ⟨dj, P - Polynomial.C (dj : Ω) * Q, Q, hQ, ?_, ?_⟩
    · rw [hPQ, Polynomial.eval₂_sub, Polynomial.eval₂_mul, Polynomial.eval₂_C, sub_div,
        mul_div_cancel_right₀ _ hQ]
    · rw [Polynomial.eval₂_sub, Polynomial.eval₂_mul, Polynomial.eval₂_C]
      exact hdj
  choose d R Q hQ hdR hRQ using hcj
  obtain ⟨a, b, ha, hb, hwin⟩ := hconjF (Finset.univ : Finset (Fin m))
    (fun j V => V.valuation ((R j).eval₂ φ s) < V.valuation ((Q j).eval₂ φ s))
    (fun j _ => hpoly (R j) (Q j) (hRQ j))
  refine ⟨a, b, ha, hb, d, fun j => ?_, fun V hV1 hV2 hVa hVb j => ?_⟩
  · rw [hdR j, Valuation.map_div]
    exact (div_lt_one₀ ((Valuation.pos_iff _).mpr (hQ j))).mpr (hRQ j)
  · have h1 := hwin V hV1 hV2 hVa hVb j (Finset.mem_univ j)
    have h2 : V.valuation (c j - φ (d j : Ω)) < 1 := by
      rw [hdR j, Valuation.map_div]
      exact (div_lt_one₀ ((Valuation.pos_iff _).mpr (hQ j))).mpr h1
    refine ⟨?_, h2⟩
    have h3 : c j = φ (d j : Ω) + (c j - φ (d j : Ω)) := by ring
    rw [← V.valuation_le_one_iff, h3]
    exact (Valuation.map_add _ _ _).trans (max_le (hV1 (d j)) h2.le)

theorem wcpa_dj_lr1k_nsr_na_se_idempotent : ∀ (L : Type u) [Field L] (K₀ : Subfield L),
    FiniteDimensional ↥K₀ L → ∀ (A A' : ValuationSubring L), A ≠ A' →
    (∀ k ∈ K₀, k ∈ A ↔ k ∈ A') →
    ∃ (ε : L) (F : Polynomial L) (α β : ℕ), F.Monic ∧ F.natDegree = α + β ∧ F.eval ε = 0 ∧
      (∀ i, F.coeff i ∈ K₀ ∧ F.coeff i ∈ A) ∧
      (∀ i, A.valuation (F.coeff i -
        (Polynomial.X ^ α * (Polynomial.X - 1) ^ β : Polynomial L).coeff i) < 1) ∧
      A.valuation (ε - 1) < 1 ∧ A'.valuation ε < 1 :=
by
  intro L _ K₀ hfin A A' hne htr
  classical
  haveI := hfin

  have vt : ∀ B B' : ValuationSubring L, (∀ k ∈ K₀, k ∈ B ↔ k ∈ B') →
      ∀ o ∈ K₀, B.valuation o < 1 → B'.valuation o < 1 := by
    intro B B' hBB' o ho hlt
    by_cases ho0 : o = 0
    · rw [ho0, map_zero]; exact zero_lt_one
    have hoi0 : o⁻¹ ≠ 0 := inv_ne_zero ho0
    have h1 : o⁻¹ ∉ B := by
      intro hm
      have h2 : 1 < B.valuation o⁻¹ := by
        rw [Valuation.one_lt_val_iff _ hoi0, inv_inv]; exact hlt
      exact absurd ((B.valuation_le_one_iff _).mpr hm) (not_le.mpr h2)
    have h3 : o⁻¹ ∉ B' := fun hm => h1 ((hBB' _ (K₀.inv_mem ho)).mpr hm)
    have h4 : 1 < B'.valuation o⁻¹ :=
      not_le.mp (fun h => h3 ((B'.valuation_le_one_iff _).mp h))
    rw [Valuation.one_lt_val_iff _ hoi0, inv_inv] at h4
    exact h4

  have N1 : ∀ (B : ValuationSubring L) (w : L), ∃ (N j : ℕ) (d : ℕ → L), j ≤ N ∧
      (∀ i, d i ∈ K₀) ∧ (∀ i, B.valuation (d i) ≤ 1) ∧ d j = 1 ∧
      (∀ i < j, B.valuation (d i) < 1) ∧
      ∑ i ∈ Finset.range (N + 1), d i * w ^ i = 0 := by
    intro B w
    obtain ⟨p, hp0, hpw⟩ := (Algebra.IsAlgebraic.of_finite K₀ L).isAlgebraic w
    obtain ⟨c, hc⟩ : ∃ c : ℕ → L, ∀ i, c i = ((p.coeff i : K₀) : L) := ⟨_, fun _ => rfl⟩
    have hcK : ∀ i, c i ∈ K₀ := fun i => by rw [hc]; exact (p.coeff i).2
    have hcN : c p.natDegree ≠ 0 := by
      rw [hc]
      have : p.coeff p.natDegree ≠ 0 := Polynomial.leadingCoeff_ne_zero.mpr hp0
      exact_mod_cast this
    have hc0 : ∀ i, p.natDegree < i → c i = 0 := by
      intro i hi
      rw [hc, Polynomial.coeff_eq_zero_of_natDegree_lt hi]
      rfl
    have hrel : ∑ i ∈ Finset.range (p.natDegree + 1), c i * w ^ i = 0 := by
      rw [Polynomial.aeval_eq_sum_range] at hpw
      rw [← hpw]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [hc, Algebra.smul_def]
      rfl
    obtain ⟨i0, hi0, hmax⟩ := Finset.exists_max_image (Finset.range (p.natDegree + 1))
      (fun i => B.valuation (c i)) ⟨p.natDegree, Finset.self_mem_range_succ _⟩
    have hle : ∀ i, B.valuation (c i) ≤ B.valuation (c i0) := by
      intro i
      by_cases hi : i ∈ Finset.range (p.natDegree + 1)
      · exact hmax i hi
      · rw [hc0 i (by rw [Finset.mem_range] at hi; omega), map_zero]
        exact zero_le'
    have hpos : 0 < B.valuation (c i0) :=
      lt_of_lt_of_le (zero_lt_iff.mpr ((Valuation.ne_zero_iff _).mpr hcN)) (hle _)
    have hex : ∃ i, B.valuation (c i) = B.valuation (c i0) := ⟨i0, rfl⟩
    obtain ⟨j, hjdef⟩ : ∃ j, j = Nat.find hex := ⟨_, rfl⟩
    have hj : B.valuation (c j) = B.valuation (c i0) := by rw [hjdef]; exact Nat.find_spec hex
    have hji0 : j ≤ i0 := by rw [hjdef]; exact Nat.find_min' hex rfl
    have hjmin : ∀ i < j, B.valuation (c i) ≠ B.valuation (c i0) := by
      intro i hi
      rw [hjdef] at hi
      exact Nat.find_min hex hi
    have hcj : c j ≠ 0 := by
      intro h0
      rw [h0, map_zero] at hj
      rw [← hj] at hpos
      exact lt_irrefl _ hpos
    have hvj : 0 < B.valuation (c j) := by rw [hj]; exact hpos
    refine ⟨p.natDegree, j, fun i => c i / c j, ?_, fun i => K₀.div_mem (hcK i) (hcK j),
      ?_, div_self hcj, ?_, ?_⟩
    · have := Finset.mem_range.mp hi0; omega
    · intro i
      simp only
      rw [Valuation.map_div, div_le_one₀ hvj, hj]
      exact hle i
    · intro i hi
      simp only
      rw [Valuation.map_div, div_lt_one₀ hvj, hj]
      exact lt_of_le_of_ne (hle i) (hjmin i hi)
    · have e : ∑ i ∈ Finset.range (p.natDegree + 1), c i / c j * w ^ i =
          (∑ i ∈ Finset.range (p.natDegree + 1), c i * w ^ i) / c j := by
        rw [Finset.sum_div]
        exact Finset.sum_congr rfl (fun i _ => by ring)
      simp only
      rw [e, hrel, zero_div]

  have sep : ∀ B B' : ValuationSubring L, (∀ k ∈ K₀, k ∈ B ↔ k ∈ B') →
      ∀ w : L, w ≠ 0 → B.valuation w < 1 → w⁻¹ ∈ B' →
      ∃ y : L, B.valuation (y - 1) < 1 ∧ B'.valuation y < 1 ∧
        ∀ V : ValuationSubring L, (∀ x ∈ K₀, x ∈ B → x ∈ V) → y ∈ V := by
    intro B B' hBB' w hw0 hw hz
    obtain ⟨N, j, d, hjN, hdK, hdB, hdj, hdlt, hrel⟩ := N1 B w
    obtain ⟨z, hzdef⟩ : ∃ z : L, z = w⁻¹ := ⟨_, rfl⟩
    rw [← hzdef] at hz
    have hwz : w * z = 1 := by rw [hzdef]; exact mul_inv_cancel₀ hw0
    have hsplit := hrel
    rw [← Finset.sum_range_add_sum_Ico _ (show j ≤ N + 1 by omega),
      Finset.sum_eq_sum_Ico_succ_bot (show j < N + 1 by omega)] at hsplit
    have e1 : ∑ i ∈ Finset.range j, d i * z ^ (j - i) =
        z ^ j * ∑ i ∈ Finset.range j, d i * w ^ i := by
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl (fun i hi => ?_)
      have hij : i ≤ j := le_of_lt (Finset.mem_range.mp hi)
      have hzj : z ^ j = z ^ (j - i) * z ^ i := by rw [← pow_add, Nat.sub_add_cancel hij]
      have hwi : z ^ i * w ^ i = 1 := by rw [← mul_pow, mul_comm z w, hwz, one_pow]
      rw [hzj]
      linear_combination (-(d i * z ^ (j - i))) * hwi
    have e2 : ∑ i ∈ Finset.Ico (j + 1) (N + 1), d i * w ^ (i - j) =
        z ^ j * ∑ i ∈ Finset.Ico (j + 1) (N + 1), d i * w ^ i := by
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl (fun i hi => ?_)
      have hij : j ≤ i := by have := (Finset.mem_Ico.mp hi).1; omega
      have hwi : w ^ i = w ^ (i - j) * w ^ j := by rw [← pow_add, Nat.sub_add_cancel hij]
      have hwj : z ^ j * w ^ j = 1 := by rw [← mul_pow, mul_comm z w, hwz, one_pow]
      rw [hwi]
      linear_combination (-(d i * w ^ (i - j))) * hwj
    have e3 : z ^ j * (d j * w ^ j) = 1 := by
      rw [hdj, one_mul, ← mul_pow, mul_comm z w, hwz, one_pow]
    have hmul : ∑ i ∈ Finset.range j, d i * z ^ (j - i) + 1 +
        ∑ i ∈ Finset.Ico (j + 1) (N + 1), d i * w ^ (i - j) = 0 := by
      linear_combination e1 + e2 - e3 + z ^ j * hsplit
    have hdV : ∀ V : ValuationSubring L, (∀ x ∈ K₀, x ∈ B → x ∈ V) → ∀ i, d i ∈ V :=
      fun V hV i => hV _ (hdK i) ((B.valuation_le_one_iff _).mp (hdB i))
    refine ⟨-∑ i ∈ Finset.range j, d i * z ^ (j - i), ?_, ?_, ?_⟩
    · have hy1 : -∑ i ∈ Finset.range j, d i * z ^ (j - i) - 1 =
          ∑ i ∈ Finset.Ico (j + 1) (N + 1), d i * w ^ (i - j) := by
        linear_combination -hmul
      rw [hy1]
      apply Valuation.map_sum_lt _ one_ne_zero
      intro i hi
      have hij : i - j ≠ 0 := by have := (Finset.mem_Ico.mp hi).1; omega
      rw [map_mul, map_pow]
      exact lt_of_le_of_lt (mul_le_of_le_one_left' (hdB i)) (pow_lt_one₀ zero_le' hw hij)
    · rw [Valuation.map_neg]
      apply Valuation.map_sum_lt _ one_ne_zero
      intro i hi
      have hd' : B'.valuation (d i) < 1 :=
        vt B B' hBB' (d i) (hdK i) (hdlt i (Finset.mem_range.mp hi))
      have hzB' : B'.valuation z ≤ 1 := (B'.valuation_le_one_iff _).mpr hz
      rw [map_mul, map_pow]
      exact lt_of_le_of_lt (mul_le_of_le_one_right' (pow_le_one₀ zero_le' hzB')) hd'
    · intro V hV
      rcases V.mem_or_inv_mem w with hwV | hzV
      · have hy : -∑ i ∈ Finset.range j, d i * z ^ (j - i) =
            1 + ∑ i ∈ Finset.Ico (j + 1) (N + 1), d i * w ^ (i - j) := by
          linear_combination -hmul
        rw [hy]
        exact add_mem V.one_mem (sum_mem fun i _ => mul_mem (hdV V hV i) (pow_mem hwV _))
      · rw [← hzdef] at hzV
        exact neg_mem (sum_mem fun i _ => mul_mem (hdV V hV i) (pow_mem hzV _))

  have incomp : ∀ B B' : ValuationSubring L, (∀ k ∈ K₀, k ∈ B ↔ k ∈ B') → B ≤ B' → B' ≤ B := by
    intro B B' hBB' hle x hx
    by_contra hxB
    have hx0 : x ≠ 0 := fun h => hxB (h ▸ B.zero_mem)
    have hw : B.valuation x⁻¹ < 1 := by
      rw [← Valuation.one_lt_val_iff _ hx0]
      exact not_le.mp (fun h => hxB ((B.valuation_le_one_iff _).mp h))
    obtain ⟨y, hy1, hy', -⟩ :=
      sep B B' hBB' x⁻¹ (inv_ne_zero hx0) hw (by rw [inv_inv]; exact hx)
    have hyB : B.valuation y < 1 := by
      by_contra hge
      push_neg at hge
      have hy0 : y ≠ 0 := by
        rintro rfl
        rw [map_zero] at hge
        exact absurd hge (not_le.mpr zero_lt_one)
      have hinvB : y⁻¹ ∈ B := by
        rw [← B.valuation_le_one_iff]
        by_contra h
        push_neg at h
        rw [Valuation.one_lt_val_iff _ (inv_ne_zero hy0), inv_inv] at h
        exact absurd hge (not_le.mpr h)
      have h5 : 1 < B'.valuation y⁻¹ :=
        (Valuation.one_lt_val_iff _ (inv_ne_zero hy0)).mpr (by rw [inv_inv]; exact hy')
      exact absurd ((B'.valuation_le_one_iff _).mpr (hle hinvB)) (not_le.mpr h5)
    have h6 : B.valuation (y - (y - 1)) < 1 :=
      lt_of_le_of_lt (Valuation.map_sub _ _ _) (max_lt hyB hy1)
    rw [sub_sub_cancel, map_one] at h6
    exact lt_irrefl _ h6

  have hnle : ¬ A' ≤ A := fun h =>
    hne (le_antisymm (incomp A' A (fun k hk => (htr k hk).symm) h) h)
  obtain ⟨b, hbA', hbA⟩ := SetLike.not_le_iff_exists.mp hnle
  have hb0 : b ≠ 0 := fun h => hbA (h ▸ A.zero_mem)
  have hwb : A.valuation b⁻¹ < 1 := by
    rw [← Valuation.one_lt_val_iff _ hb0]
    exact not_le.mp (fun h => hbA ((A.valuation_le_one_iff _).mp h))
  obtain ⟨y, hy1, hy', hyV⟩ :=
    sep A A' htr b⁻¹ (inv_ne_zero hb0) hwb (by rw [inv_inv]; exact hbA')

  obtain ⟨O, hOdef⟩ : ∃ O : Subring L, O = K₀.toSubring ⊓ A.toSubring := ⟨_, rfl⟩
  have memO : ∀ x : L, x ∈ O ↔ x ∈ K₀ ∧ x ∈ A := by
    intro x; rw [hOdef]; exact Iff.rfl
  have hyint : _root_.IsIntegral O y := by
    have h : y ∈ (integralClosure (Subring.closure (O : Set L)) L).toSubring := by
      rw [← iInf_valuationSubring_superset, Subring.mem_iInf]
      intro V
      exact hyV V.1 (fun x hxK hxA => V.2 ((memO x).mpr ⟨hxK, hxA⟩))
    have h2 : _root_.IsIntegral (Subring.closure (O : Set L)) y := (mem_integralClosure_iff _ _).mp h
    rw [Subring.closure_eq] at h2
    exact h2
  have hyA' : y ∈ A' := (A'.valuation_le_one_iff _).mp hy'.le
  have hvy : A.valuation y = 1 := by
    have h := Valuation.map_add_eq_of_lt_left A.valuation (x := 1) (y := y - 1)
      (by rw [map_one]; exact hy1)
    have e : (1 : L) + (y - 1) = y := by ring
    rw [e, map_one] at h
    exact h

  have hyint' := hyint
  obtain ⟨g, hgm, hg⟩ := hyint'
  obtain ⟨γ, hγ⟩ : ∃ γ : ℕ → L, ∀ i, γ i = ((g.coeff i : O) : L) := ⟨_, fun _ => rfl⟩
  have hγO : ∀ i, γ i ∈ O := fun i => by rw [hγ]; exact (g.coeff i).2
  have hγK : ∀ i, γ i ∈ K₀ := fun i => ((memO _).mp (hγO i)).1
  have hγA : ∀ i, γ i ∈ A := fun i => ((memO _).mp (hγO i)).2
  have hγA' : ∀ i, γ i ∈ A' := fun i => (htr _ (hγK i)).mp (hγA i)
  have hγN : γ g.natDegree = 1 := by rw [hγ, hgm.coeff_natDegree]; rfl
  have hrel : ∑ i ∈ Finset.range (g.natDegree + 1), γ i * y ^ i = 0 := by
    rw [Polynomial.eval₂_eq_sum_range] at hg
    rw [← hg]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [hγ]
    rfl
  have hex : ∃ i, ¬ A.valuation (γ i) < 1 := ⟨g.natDegree, by rw [hγN, map_one]; exact lt_irrefl 1⟩
  obtain ⟨k, hkdef⟩ : ∃ k, k = Nat.find hex := ⟨_, rfl⟩
  have hk_spec : ¬ A.valuation (γ k) < 1 := by rw [hkdef]; exact Nat.find_spec hex
  have hk_min : ∀ i < k, A.valuation (γ i) < 1 := by
    intro i hi
    rw [hkdef] at hi
    exact not_not.mp (Nat.find_min hex hi)
  have hkN : k ≤ g.natDegree := by
    rw [hkdef]; exact Nat.find_min' hex (by rw [hγN, map_one]; exact lt_irrefl 1)
  have hvu : A.valuation (γ k) = 1 :=
    le_antisymm ((A.valuation_le_one_iff _).mpr (hγA k)) (not_lt.mp hk_spec)
  have hk1 : 1 ≤ k := by
    by_contra h0
    have hk0 : k = 0 := by omega
    apply hk_spec
    rw [hk0]
    apply vt A' A (fun x hx => (htr x hx).symm) (γ 0) (hγK 0)
    have hrel0 := hrel
    rw [Finset.range_eq_Ico, Finset.sum_eq_sum_Ico_succ_bot (by omega), pow_zero, mul_one]
      at hrel0
    have e : γ 0 = -∑ i ∈ Finset.Ico (0 + 1) (g.natDegree + 1), γ i * y ^ i := by
      linear_combination hrel0
    rw [e, Valuation.map_neg]
    apply Valuation.map_sum_lt _ one_ne_zero
    intro i hi
    have hi1 : i ≠ 0 := by have := (Finset.mem_Ico.mp hi).1; omega
    rw [map_mul, map_pow]
    exact lt_of_le_of_lt (mul_le_of_le_one_left' ((A'.valuation_le_one_iff _).mpr (hγA' i)))
      (pow_lt_one₀ zero_le' hy' hi1)
  obtain ⟨k', rfl⟩ : ∃ k', k = k' + 1 := ⟨k - 1, by omega⟩

  have hu0 : γ (k' + 1) ≠ 0 := fun h => by rw [h, map_zero] at hvu; exact zero_ne_one hvu
  obtain ⟨U, hUdef⟩ : ∃ U : L, U = (γ (k' + 1))⁻¹ := ⟨_, rfl⟩
  have hUK : U ∈ K₀ := by rw [hUdef]; exact K₀.inv_mem (hγK _)
  have hvU : A.valuation U = 1 := by rw [hUdef, map_inv₀, hvu, inv_one]
  have hUA : U ∈ A := (A.valuation_le_one_iff _).mp hvU.le
  have hUO : U ∈ O := (memO _).mpr ⟨hUK, hUA⟩
  have hUA' : U ∈ A' := (htr _ hUK).mp hUA
  have huU : γ (k' + 1) * U = 1 := by rw [hUdef]; exact mul_inv_cancel₀ hu0

  obtain ⟨r, hr⟩ : ∃ r : L, r = ∑ i ∈ Finset.range (k' + 1), γ i * y ^ i := ⟨_, rfl⟩
  obtain ⟨s, hs⟩ : ∃ s : L,
      s = ∑ i ∈ Finset.Ico (k' + 1 + 1) (g.natDegree + 1), γ i * y ^ (i - (k' + 1) - 1) :=
    ⟨_, rfl⟩
  obtain ⟨h, hh⟩ : ∃ h : L, h = γ (k' + 1) + y * s := ⟨_, rfl⟩
  have hkey : r + y ^ (k' + 1) * h = 0 := by
    have e : y ^ (k' + 1) * h = γ (k' + 1) * y ^ (k' + 1) +
        ∑ i ∈ Finset.Ico (k' + 1 + 1) (g.natDegree + 1), γ i * y ^ i := by
      rw [hh, hs, mul_add, Finset.mul_sum, Finset.mul_sum]
      congr 1
      · ring
      · refine Finset.sum_congr rfl (fun i hi => ?_)
        have hki : k' + 1 + 1 ≤ i := (Finset.mem_Ico.mp hi).1
        have hpow : y ^ i = y ^ (k' + 1) * y * y ^ (i - (k' + 1) - 1) := by
          rw [← pow_succ, ← pow_add]; congr 1; omega
        rw [hpow]; ring
    have hrel2 := hrel
    rw [← Finset.sum_range_add_sum_Ico _ (show k' + 1 ≤ g.natDegree + 1 by omega),
      Finset.sum_eq_sum_Ico_succ_bot (show k' + 1 < g.natDegree + 1 by omega)] at hrel2
    linear_combination hr + e + hrel2

  obtain ⟨ε, hεdef⟩ : ∃ ε : L, ε = -(y * s * U) := ⟨_, rfl⟩
  have hε1 : ε - 1 = -(h * U) := by
    rw [hεdef]; linear_combination huU + U * hh
  obtain ⟨m, hmdef⟩ : ∃ m : L, m = -(h ^ k' * s ^ (k' + 1) * U ^ (2 * (k' + 1))) := ⟨_, rfl⟩
  obtain ⟨t, htdef⟩ : ∃ t : L, t = (ε * (ε - 1)) ^ (k' + 1) := ⟨_, rfl⟩
  have ht : t = r * m := by
    rw [htdef, hε1, hmdef, hεdef]
    linear_combination (h ^ k' * s ^ (k' + 1) * U ^ (2 * (k' + 1))) * hkey

  have hvr : A.valuation r < 1 := by
    rw [hr]
    apply Valuation.map_sum_lt _ one_ne_zero
    intro i hi
    rw [map_mul, map_pow, hvy, one_pow, mul_one]
    exact hk_min i (Finset.mem_range.mp hi)
  have hvh : A.valuation h < 1 := by
    have e : y ^ (k' + 1) * h = -r := by linear_combination hkey
    have e2 := congrArg A.valuation e
    rw [map_mul, map_pow, hvy, one_pow, one_mul, Valuation.map_neg] at e2
    rw [e2]; exact hvr
  have hεA : A.valuation (ε - 1) < 1 := by
    rw [hε1, Valuation.map_neg, map_mul, hvU, mul_one]; exact hvh
  have hsA' : s ∈ A' := by
    rw [hs]; exact sum_mem fun i _ => mul_mem (hγA' i) (pow_mem hyA' _)
  have hεA' : A'.valuation ε < 1 := by
    rw [hεdef, Valuation.map_neg, mul_assoc, map_mul]
    have h7 : A'.valuation (s * U) ≤ 1 := (A'.valuation_le_one_iff _).mpr (mul_mem hsA' hUA')
    exact lt_of_le_of_lt (mul_le_of_le_one_right' h7) hy'

  let I : Ideal O :=
    { carrier := {o | A.valuation (o : L) < 1}
      add_mem' := fun {a b} ha hb => by
        show A.valuation ((a + b : O) : L) < 1
        rw [Subring.coe_add]
        exact lt_of_le_of_lt (Valuation.map_add _ (a : L) (b : L)) (max_lt ha hb)
      zero_mem' := by
        show A.valuation ((0 : O) : L) < 1
        rw [ZeroMemClass.coe_zero, map_zero]; exact zero_lt_one
      smul_mem' := fun c x hx => by
        show A.valuation ((c * x : O) : L) < 1
        rw [Subring.coe_mul, map_mul]
        exact lt_of_le_of_lt
          (mul_le_of_le_one_left' ((A.valuation_le_one_iff _).mpr ((memO _).mp c.2).2)) hx }
  have memI : ∀ o : O, o ∈ I ↔ A.valuation (o : L) < 1 := fun o => Iff.rfl

  let M := Algebra.adjoin O ({y} : Set L)
  haveI hMfin : Module.Finite O M := Algebra.finite_adjoin_simple_of_isIntegral hyint
  have hyM : y ∈ M := Algebra.self_mem_adjoin_singleton O y
  have hOM : ∀ c : O, (c : L) ∈ M := fun c => Subalgebra.algebraMap_mem M c
  have hγM : ∀ i, γ i ∈ M := fun i => by rw [hγ]; exact hOM _
  have hsM : s ∈ M := by
    rw [hs]; exact sum_mem fun i _ => mul_mem (hγM i) (pow_mem hyM _)
  have hhM : h ∈ M := by rw [hh]; exact add_mem (hγM _) (mul_mem hyM hsM)
  have hUM : U ∈ M := hOM ⟨U, hUO⟩
  have hmM : m ∈ M := by
    rw [hmdef]
    exact neg_mem (mul_mem (mul_mem (pow_mem hhM _) (pow_mem hsM _)) (pow_mem hUM _))
  have htM : t ∈ M := by
    rw [ht, hr]
    exact mul_mem (sum_mem fun i _ => mul_mem (hγM i) (pow_mem hyM _)) hmM
  let f : Module.End O M := Algebra.lmul O M ⟨t, htM⟩
  have hrange : LinearMap.range f ≤ I • ⊤ := by
    rintro _ ⟨x, rfl⟩
    have e : f x = ∑ i ∈ Finset.range (k' + 1),
        g.coeff i • ((⟨y ^ i * m, mul_mem (pow_mem hyM _) hmM⟩ : M) * x) := by
      apply Subtype.ext
      rw [AddSubmonoidClass.coe_finset_sum]
      show t * (x : L) = _
      rw [ht, hr, Finset.sum_mul, Finset.sum_mul]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [Subalgebra.coe_smul, Subalgebra.coe_mul, Algebra.smul_def]
      show γ i * y ^ i * m * (x : L) = ((g.coeff i : O) : L) * (y ^ i * m * (x : L))
      rw [hγ]; ring
    rw [e]
    exact Submodule.sum_mem _ (fun i hi => Submodule.smul_mem_smul
      ((memI _).mpr (by rw [← hγ]; exact hk_min i (Finset.mem_range.mp hi))) Submodule.mem_top)
  obtain ⟨q, hqm, -, hqI, hqf⟩ :=
    LinearMap.exists_monic_and_natDegree_eq_and_coeff_mem_pow_and_aeval_eq_zero O f I hrange
  have hqt : Polynomial.aeval t q = 0 := by
    have h1 : Algebra.lmul O M (Polynomial.aeval (⟨t, htM⟩ : M) q) = 0 := by
      rw [← Polynomial.aeval_algHom_apply]; exact hqf
    have h2 : (Polynomial.aeval (⟨t, htM⟩ : M) q) * 1 = 0 :=
      congrArg (fun φ : Module.End O M => φ 1) h1
    rw [mul_one] at h2
    have h4 : Polynomial.aeval ((⟨t, htM⟩ : M) : L) q = 0 := by
      rw [Subalgebra.aeval_coe, h2, ZeroMemClass.coe_zero]
    exact h4

  have hP1 : (Polynomial.X - 1 : Polynomial O).Monic := by
    simpa using Polynomial.monic_X_sub_C (1 : O)
  have hP1d : (Polynomial.X - 1 : Polynomial O).natDegree = 1 := by
    simpa using Polynomial.natDegree_X_sub_C (1 : O)
  have hP2 : (Polynomial.X * (Polynomial.X - 1) : Polynomial O).Monic :=
    Polynomial.monic_X.mul hP1
  have hP2d : (Polynomial.X * (Polynomial.X - 1) : Polynomial O).natDegree = 2 := by
    rw [Polynomial.monic_X.natDegree_mul hP1, Polynomial.natDegree_X, hP1d]
  obtain ⟨ψ, hψdef⟩ : ∃ ψ : Polynomial O, ψ = (Polynomial.X * (Polynomial.X - 1)) ^ (k' + 1) :=
    ⟨_, rfl⟩
  have hψm : ψ.Monic := by rw [hψdef]; exact hP2.pow _
  have hψd : ψ.natDegree = (k' + 1) * 2 := by rw [hψdef, hP2.natDegree_pow, hP2d]
  have hGm : (q.comp ψ).Monic := hqm.comp hψm (by rw [hψd]; omega)
  have hFm : ((q.comp ψ).map (algebraMap O L)).Monic := hGm.map _
  have hFdeg : ((q.comp ψ).map (algebraMap O L)).natDegree =
      q.natDegree * (k' + 1) + q.natDegree * (k' + 1) := by
    rw [hGm.natDegree_map, Polynomial.natDegree_comp, hψd]; ring
  have hFε : ((q.comp ψ).map (algebraMap O L)).eval ε = 0 := by
    rw [Polynomial.eval_map, ← Polynomial.aeval_def, Polynomial.aeval_comp]
    have hψε : Polynomial.aeval ε ψ = t := by
      rw [hψdef, htdef]; simp
    rw [hψε]; exact hqt
  have hq'I : ∀ n, (q - Polynomial.X ^ q.natDegree).coeff n ∈ I := by
    intro n
    rw [Polynomial.coeff_sub, Polynomial.coeff_X_pow]
    rcases lt_trichotomy n q.natDegree with hn | hn | hn
    · rw [if_neg (by omega), sub_zero]
      exact Ideal.pow_le_self (by omega) (hqI n)
    · rw [if_pos hn, hn, hqm.coeff_natDegree, sub_self]; exact I.zero_mem
    · rw [if_neg (by omega), Polynomial.coeff_eq_zero_of_natDegree_lt hn, sub_zero]
      exact I.zero_mem
  have hcompmem : (q - Polynomial.X ^ q.natDegree).comp ψ ∈ Ideal.map Polynomial.C I := by
    rw [Polynomial.comp_eq_sum_left, Polynomial.sum_def]
    exact Ideal.sum_mem _ (fun e _ => Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ (hq'I e)))
  have hcompI := Ideal.mem_map_C_iff.mp hcompmem
  have hFsplit : (q.comp ψ).map (algebraMap O L) =
      ((q - Polynomial.X ^ q.natDegree).comp ψ).map (algebraMap O L) +
        (Polynomial.X ^ (q.natDegree * (k' + 1)) *
          (Polynomial.X - 1) ^ (q.natDegree * (k' + 1)) : Polynomial L) := by
    have e : q.comp ψ = (q - Polynomial.X ^ q.natDegree).comp ψ + ψ ^ q.natDegree := by
      rw [Polynomial.sub_comp, Polynomial.X_pow_comp]; ring
    rw [e, Polynomial.map_add]
    congr 1
    rw [hψdef, ← pow_mul, mul_comm (k' + 1) q.natDegree, ← mul_pow]
    simp only [Polynomial.map_pow, Polynomial.map_mul, Polynomial.map_sub, Polynomial.map_X,
      Polynomial.map_one]
  refine ⟨ε, (q.comp ψ).map (algebraMap O L), q.natDegree * (k' + 1), q.natDegree * (k' + 1),
    hFm, hFdeg, hFε, fun i => ?_, fun i => ?_, hεA, hεA'⟩
  · rw [Polynomial.coeff_map]
    exact (memO _).mp ((q.comp ψ).coeff i).2
  · rw [hFsplit, Polynomial.coeff_add, add_sub_cancel_right, Polynomial.coeff_map]
    exact (memI _).mp (hcompI i)

theorem wcpa_dj_lr1k_nsr_na_separating_element : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω) (C : Scheme.{u}) [AlgebraicGeometry.IsIntegral C]
    (γ : C ⟶ wcProjK Ω 1) (X : Scheme.{u}) (uX : X ⟶ Spec (.of ↥W)) (ι : wcProjK Ω 1 ⟶ X)
    [QuasiCompact (γ ≫ ι)] [QuasiSeparated (γ ≫ ι)]
    (y₀ : ↥(wcpaDjLkFib W (γ ≫ ι) uX)) (τ : (Spec (.of ↥W) ⟶ X) → ↥W),
    wcNsrNaHyp W γ uX ι y₀ τ →
    ∀ (A A' : ValuationSubring C.functionField),
      wcNsrNaLim W γ uX ι (wcpaDjLkImg W (γ ≫ ι) uX y₀) A →
      wcNsrNaLim W γ uX ι (wcpaDjLkImg W (γ ≫ ι) uX y₀) A' → A ≠ A' →
    ∃ (σ : Spec (.of ↥W) ⟶ X) (a : ↥W),
