        have hb'deg : b'.natDegree = b.natDegree := by
          rw [← Polynomial.natDegree_map_eq_of_injective hι b', hb',
            Polynomial.natDegree_C_mul hιcb]
        have ha'0 : a' ≠ 0 := by
          rintro rfl; rw [Polynomial.map_zero] at ha'
          exact mul_ne_zero (Polynomial.C_ne_zero.mpr hιca) ha0 ha'.symm
        have hb'0 : b' ≠ 0 := by
          rintro rfl; rw [Polynomial.map_zero] at hb'
          exact mul_ne_zero (Polynomial.C_ne_zero.mpr hιcb) hb0 hb'.symm
        have hprod : a' * b' = Polynomial.C (ca * cb) * F := by
          apply hmapinj
          rw [Polynomial.map_mul, Polynomial.map_mul, ha', hb', Polynomial.map_C, ← hf, hab,
            map_mul, Polynomial.C_mul]
          ring
        have hev := congrArg (fun G => Polynomial.eval x (G.map φ)) hprod
        simp only [Polynomial.map_mul, Polynomial.eval_mul, Polynomial.map_C, Polynomial.eval_C,
          hFx, mul_zero] at hev
        rcases mul_eq_zero.mp hev with h | h
        · have := hmin a' ha'0 h; omega
        · have := hmin b' hb'0 h; omega
    have hf'eq : Polynomial.derivative f = (Polynomial.derivative F).map ι := by
      rw [hf, Polynomial.derivative_map]
    have hf'ne : Polynomial.derivative f ≠ 0 := by
      rw [hf'eq]; intro h; apply hF'; apply hmapinj; rw [h, Polynomial.map_zero]
    have hndvd : ¬ f ∣ Polynomial.derivative f := by
      intro hd
      have h1 := Polynomial.natDegree_le_of_dvd hd hf'ne
      have h2 := Polynomial.natDegree_derivative_lt (p := f) (by omega)
      omega
    obtain ⟨u, v, huv⟩ := (hirr.coprime_iff_not_dvd).mpr hndvd
    obtain ⟨cu, u', hcu, hu'⟩ := hclear u
    obtain ⟨cv, v', hcv, hv'⟩ := hclear v
    refine ⟨F, Polynomial.C cv * u', Polynomial.C cu * v', cu * cv, mul_ne_zero hcu hcv, hFx, ?_⟩
    apply hmapinj
    simp only [Polynomial.map_add, Polynomial.map_mul, Polynomial.map_C, hu', hv', ← hf'eq, ← hf]
    rw [map_mul, Polynomial.C_mul]
    calc Polynomial.C (ι cv) * (Polynomial.C (ι cu) * u) * f +
          Polynomial.C (ι cu) * (Polynomial.C (ι cv) * v) * Polynomial.derivative f
        = Polynomial.C (ι cu) * Polynomial.C (ι cv) * (u * f + v * Polynomial.derivative f) := by
          ring
      _ = Polynomial.C (ι cu) * Polynomial.C (ι cv) := by rw [huv, mul_one]
  rcases CharP.char_is_prime_or_zero ↥W p with hp | hp
  · haveI : Fact p.Prime := ⟨hp⟩
    haveI : ExpChar ↥W p := ExpChar.prime hp
    obtain ⟨r, b, hspan⟩ := hN

    have s1 : ∀ (N : ℕ) (y : Fin N → A), r < N → ∃ c : Fin N → Polynomial ↥W,
        (∃ j k, (c j).coeff k ∉ IsLocalRing.maximalIdeal ↥W) ∧
        ∑ j, Polynomial.aeval ζ (c j) * y j ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) := by
      intro N y hNr
      choose P hP using fun j => hspan (y j)
      let v : Fin N → (Fin r → Polynomial (IsLocalRing.ResidueField ↥W)) :=
        fun j i => (P j i).map (IsLocalRing.residue ↥W)
      have hnli : ¬ LinearIndependent (Polynomial (IsLocalRing.ResidueField ↥W)) v := by
        intro hli
        have := hli.fintype_card_le_finrank
        rw [Module.finrank_fin_fun, Fintype.card_fin] at this
        omega
      obtain ⟨g, hg, j0, hj0⟩ := Fintype.not_linearIndependent_iff.mp hnli
      choose c hc using fun j => Polynomial.map_surjective (IsLocalRing.residue ↥W)
        IsLocalRing.residue_surjective (g j)
      have hsub : ∀ Q : Polynomial ↥W, (∀ k, Q.coeff k ∈ IsLocalRing.maximalIdeal ↥W) →
          Polynomial.aeval ζ Q ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) := by
        intro Q hQ
        rw [Polynomial.aeval_eq_sum_range]
        refine Ideal.sum_mem _ (fun k _ => ?_)
        rw [Algebra.smul_def]
        exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ (hQ k))
      have hQ : ∀ i, ∀ k, (∑ j, c j * P j i).coeff k ∈ IsLocalRing.maximalIdeal ↥W := by
        intro i k
        rw [← IsLocalRing.residue_eq_zero_iff]
        have h1 : (∑ j, c j * P j i).map (IsLocalRing.residue ↥W) = 0 := by
          rw [Polynomial.map_sum]
          simp only [Polynomial.map_mul, hc]
          have := congrFun hg i
          simpa [v, Finset.sum_apply] using this
        have h2 := congrArg (fun q => Polynomial.coeff q k) h1
        simpa [Polynomial.coeff_map] using h2
      refine ⟨c, ?_, ?_⟩
      · obtain ⟨k0, hk0⟩ : ∃ k, (g j0).coeff k ≠ 0 := by
          by_contra h
          push_neg at h
          exact hj0 (Polynomial.ext (fun k => by rw [h k, Polynomial.coeff_zero]))
        refine ⟨j0, k0, fun hm => hk0 ?_⟩
        rw [← hc j0, Polynomial.coeff_map]
        exact (IsLocalRing.residue_eq_zero_iff _).mpr hm
      · have e : ∑ i, Polynomial.aeval ζ (∑ j, c j * P j i) * b i =
            ∑ j, Polynomial.aeval ζ (c j) * ∑ i, Polynomial.aeval ζ (P j i) * b i := by
          simp only [map_sum, map_mul, Finset.sum_mul, Finset.mul_sum]
          rw [Finset.sum_comm]
          refine Finset.sum_congr rfl (fun j _ => Finset.sum_congr rfl (fun i _ => by ring))
        have hsplit : ∑ j, Polynomial.aeval ζ (c j) * y j =
            ∑ j, Polynomial.aeval ζ (c j) * (y j - ∑ i, Polynomial.aeval ζ (P j i) * b i) +
            ∑ i, Polynomial.aeval ζ (∑ j, c j * P j i) * b i := by
          rw [e, ← Finset.sum_add_distrib]
          refine Finset.sum_congr rfl (fun j _ => by ring)
        rw [hsplit]
        refine Ideal.add_mem _ (Ideal.sum_mem _ (fun j _ => Ideal.mul_mem_left _ _ (hP j)))
          (Ideal.sum_mem _ (fun i _ => Ideal.mul_mem_right _ _ (hsub _ (hQ i))))

    have hbound : ∀ (n : ℕ) (y : A), y ^ (p ^ n) = ζ → p ^ n ≤ r := by
      intro n y hy
      by_contra hlt
      push_neg at hlt
      have hNpos : 0 < p ^ n := pow_pos hp.pos n
      obtain ⟨c, ⟨j0, k0, hk0⟩, hS⟩ := s1 (p ^ n) (fun j => y ^ (j : ℕ)) hlt
      set G : Polynomial ↥W := ∑ j : Fin (p ^ n), Polynomial.X ^ (j : ℕ) *
        Polynomial.expand ↥W (p ^ n) (c j) with hG
      have hGy : Polynomial.aeval y G =
          ∑ j : Fin (p ^ n), Polynomial.aeval ζ (c j) * y ^ (j : ℕ) := by
        rw [hG, map_sum]
        refine Finset.sum_congr rfl (fun j _ => ?_)
        rw [map_mul, map_pow, Polynomial.aeval_X, Polynomial.expand_aeval, hy, mul_comm]
      have hGc : G.coeff (p ^ n * k0 + j0) = (c j0).coeff k0 := by
        rw [hG, Polynomial.finset_sum_coeff, Finset.sum_eq_single j0]
        · rw [Polynomial.coeff_X_pow_mul', if_pos (by omega), Nat.add_sub_cancel,
            Polynomial.coeff_expand hNpos, if_pos (dvd_mul_right _ _),
            Nat.mul_div_cancel_left _ hNpos]
        · intro j _ hj
          rw [Polynomial.coeff_X_pow_mul']
          split_ifs with hle
          · rw [Polynomial.coeff_expand hNpos, if_neg]
            rintro ⟨t, ht⟩
            apply hj
            have hjlt := j.2
            have hj0lt := j0.2
            rcases lt_trichotomy t k0 with h | h | h
            · have hm : p ^ n * (t + 1) ≤ p ^ n * k0 := Nat.mul_le_mul_left _ h
              rw [mul_add, mul_one] at hm
              generalize p ^ n * k0 = X at *
              generalize p ^ n * t = Y at *
              omega
            · subst h
              apply Fin.ext
              generalize p ^ n * t = X at *
              omega
            · have hm : p ^ n * (k0 + 1) ≤ p ^ n * t := Nat.mul_le_mul_left _ h
              rw [mul_add, mul_one] at hm
              generalize p ^ n * k0 = X at *
              generalize p ^ n * t = Y at *
              omega
          · rfl
        · intro h; exact absurd (Finset.mem_univ j0) h
      have hcol : Polynomial.aeval ζ (G.map (iterateFrobenius ↥W p n)) =
          (Polynomial.aeval y G) ^ (p ^ n) := by
        rw [← hy, ← Polynomial.expand_aeval, ← Polynomial.map_expand,
          Polynomial.map_iterateFrobenius_expand, map_pow]
      apply h1
      apply hRR (G.map (iterateFrobenius ↥W p n)) 1
      · refine ⟨p ^ n * k0 + j0, ?_⟩
        rw [Polynomial.coeff_map, hGc, iterateFrobenius_def]
        intro hmem
        exact hk0 ((IsLocalRing.maximalIdeal.isMaximal ↥W).isPrime.mem_of_pow_mem _ hmem)
      · rw [mul_one, hcol, hGy]
        exact Ideal.pow_mem_of_mem _ hS _ hNpos

    let P : ℕ → Prop := fun n => ∃ y : A, y ^ (p ^ n) = ζ
    have hP0 : P 0 := ⟨ζ, by simp⟩
    have hPb : ∀ n, P n → n ≤ r := by
      rintro n ⟨y, hy⟩
      have h2 : n < p ^ n := Nat.lt_pow_self hp.one_lt
      have h3 := hbound n y hy
      omega
    obtain ⟨η, hη⟩ : P (Nat.findGreatest P r) := Nat.findGreatest_spec (Nat.zero_le r) hP0
    set m := Nat.findGreatest P r with hm
    have hnot : ∀ z : A, z ^ p ≠ η := by
      intro z hz
      have hPm1 : P (m + 1) := ⟨z, by rw [show p ^ (m + 1) = p * p ^ m from pow_succ' p m,
        pow_mul, hz, hη]⟩
      exact Nat.findGreatest_is_greatest (Nat.lt_succ_self m) (hPb _ hPm1) hPm1

    have hTη : ∀ f : Polynomial ↥W, (∃ k, f.coeff k ∉ IsLocalRing.maximalIdeal ↥W) →
        Polynomial.aeval η f ≠ 0 := by
      intro f ⟨k, hk⟩ h0
      apply hTζ (f.map (iterateFrobenius ↥W p m))
      · refine ⟨k, ?_⟩
        rw [Polynomial.coeff_map, iterateFrobenius_def]
        intro hmem
        exact hk ((IsLocalRing.maximalIdeal.isMaximal ↥W).isPrime.mem_of_pow_mem _ hmem)
      · rw [← hη, ← Polynomial.expand_aeval, ← Polynomial.map_expand,
          Polynomial.map_iterateFrobenius_expand, map_pow, h0, zero_pow (pow_pos hp.pos m).ne']
    have hINJ := s5 η hTη
    have hinjW : Function.Injective (algebraMap ↥W A) := by
      intro a c hac
      by_contra hne
      have h0 : algebraMap ↥W A (a - c) * 1 = 0 := by rw [map_sub, hac, sub_self, zero_mul]
      exact one_ne_zero (htf (a - c) 1 (sub_ne_zero.mpr hne) h0)
    haveI : CharP A p := charP_of_injective_algebraMap hinjW p
    haveI : ExpChar A p := ExpChar.prime hp

    have hind : ∀ c : Fin p → A, ∑ j, c j ^ p * η ^ (j : ℕ) = 0 → ∀ j, c j = 0 := by
      intro c hc
      have hinj : Function.Injective (algebraMap A (FractionRing A)) :=
        IsFractionRing.injective A (FractionRing A)
      haveI : CharP (FractionRing A) p := charP_of_injective_algebraMap hinj p
      haveI : ExpChar (FractionRing A) p := ExpChar.prime hp
      have hnotK : ∀ z : FractionRing A, z ^ p ≠ algebraMap A (FractionRing A) η := by
        intro z hz
        have hint : IsIntegral A z := by
          refine ⟨Polynomial.X ^ p - Polynomial.C η, Polynomial.monic_X_pow_sub_C η hp.ne_zero, ?_⟩
          rw [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C, hz, sub_self]
        obtain ⟨a, ha⟩ := IsIntegrallyClosed.isIntegral_iff.mp hint
        apply hnot a
        apply hinj
        rw [map_pow, ha, hz]
      have hirr : Irreducible (Polynomial.X ^ p - Polynomial.C (algebraMap A (FractionRing A) η)) :=
        X_pow_sub_C_irreducible_of_prime hp hnotK
      set Q : Polynomial (FractionRing A) :=
        ∑ j : Fin p, Polynomial.C (algebraMap A (FractionRing A) (c j)) * Polynomial.X ^ (j : ℕ)
        with hQdef
      have hQe : Polynomial.eval₂ (frobenius (FractionRing A) p)
          (algebraMap A (FractionRing A) η) Q = 0 := by
        rw [hQdef, Polynomial.eval₂_finset_sum]
        simp only [Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_X_pow, frobenius_def]
        rw [← map_zero (algebraMap A (FractionRing A)), ← hc, map_sum]
        simp only [map_mul, map_pow]
      have hPe : Polynomial.eval₂ (frobenius (FractionRing A) p) (algebraMap A (FractionRing A) η)
          (Polynomial.X ^ p - Polynomial.C (algebraMap A (FractionRing A) η)) = 0 := by
        rw [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C, frobenius_def,
          sub_self]
      have hQ0 : Q = 0 := by
        by_contra hQ
        have hdeg : Q.natDegree ≤ p - 1 := by
          rw [hQdef]
          apply Polynomial.natDegree_sum_le_of_forall_le
          intro j _
          exact (Polynomial.natDegree_C_mul_X_pow_le _ _).trans (by have := j.2; omega)
        have hndvd : ¬ (Polynomial.X ^ p - Polynomial.C (algebraMap A (FractionRing A) η)) ∣ Q := by
          intro hd
          have h1 := Polynomial.natDegree_le_of_dvd hd hQ
          rw [Polynomial.natDegree_X_pow_sub_C] at h1
          have := hp.pos
          omega
        obtain ⟨u, v, huv⟩ := (hirr.coprime_iff_not_dvd).mpr hndvd
        have h2 := congrArg (Polynomial.eval₂ (frobenius (FractionRing A) p)
          (algebraMap A (FractionRing A) η)) huv
        rw [Polynomial.eval₂_add, Polynomial.eval₂_mul, Polynomial.eval₂_mul, hPe, hQe,
          Polynomial.eval₂_one, mul_zero, mul_zero, add_zero] at h2
        exact zero_ne_one h2
      intro j
      have hcoeff := congrArg (fun P => Polynomial.coeff P (j : ℕ)) hQ0
      simp only [hQdef, Polynomial.finset_sum_coeff, Polynomial.coeff_C_mul_X_pow,
        Polynomial.coeff_zero] at hcoeff
      rw [Finset.sum_eq_single j] at hcoeff
      · rw [if_pos rfl] at hcoeff
        exact hinj (by rw [hcoeff, map_zero])
      · intro b _ hb
        rw [if_neg (fun h => hb (Fin.ext h.symm))]
      · intro h; exact absurd (Finset.mem_univ j) h

    have hperf : ∀ R : Polynomial ↥W, ∃ B : Fin p → Polynomial ↥W,
        R = ∑ j : Fin p, Polynomial.X ^ (j : ℕ) * B j ^ p := by
      haveI : ExpChar (Polynomial ↥W) p := ExpChar.prime hp
      have hroot : ∀ s : ↥W, ∃ t : ↥W, t ^ p = s := by
        intro s
        obtain ⟨s₀, hs₀⟩ := IsAlgClosed.exists_pow_nat_eq (s : Ω) hp.pos
        by_cases h0 : s₀ = 0
        · refine ⟨0, ?_⟩
          apply Subtype.ext
          rw [SubmonoidClass.coe_pow, ← hs₀, h0]
          rfl
        · have hmem : s₀ ∈ W := by
            rcases W.mem_or_inv_mem s₀ with h | h
            · exact h
            · have heq : (s : Ω) * (s₀⁻¹) ^ (p - 1) = s₀ := by
                obtain ⟨k, hk⟩ : ∃ k, p = k + 1 := ⟨p - 1, by have := hp.pos; omega⟩
                rw [← hs₀, hk, Nat.add_sub_cancel, pow_succ, mul_comm (s₀ ^ k) s₀, mul_assoc,
                  ← mul_pow, mul_inv_cancel₀ h0, one_pow, mul_one]
              rw [← heq]
              exact mul_mem s.2 (pow_mem h _)
          exact ⟨⟨s₀, hmem⟩, Subtype.ext (by rw [SubmonoidClass.coe_pow]; exact hs₀)⟩
      choose ρ hρ using hroot
      intro R
      induction R using Polynomial.induction_on' with
      | add R S hR hS =>
        obtain ⟨B, hB⟩ := hR
        obtain ⟨B', hB'⟩ := hS
        refine ⟨fun j => B j + B' j, ?_⟩
        rw [hB, hB', ← Finset.sum_add_distrib]
        refine Finset.sum_congr rfl (fun j _ => ?_)
        rw [add_pow_char, mul_add]
      | monomial n a =>
        let j₀ : Fin p := ⟨n % p, Nat.mod_lt _ hp.pos⟩
        refine ⟨fun j => if j = j₀ then Polynomial.C (ρ a) * Polynomial.X ^ (n / p) else 0, ?_⟩
        rw [Finset.sum_eq_single j₀]
        · simp only [↓reduceIte]
          rw [mul_pow, ← Polynomial.C_pow, hρ, ← pow_mul, ← Polynomial.C_mul_X_pow_eq_monomial]
          rw [mul_left_comm, ← pow_add]
          congr 2
          have := Nat.mod_add_div n p
          simp only [j₀]
          rw [mul_comm (n / p) p]
          omega
        · intro b _ hb
          simp only [if_neg hb]
          rw [zero_pow hp.ne_zero, mul_zero]
        · intro h; exact absurd (Finset.mem_univ j₀) h

    have hDESC : ∀ x : A, ∀ F : Polynomial (Polynomial ↥W), F ≠ 0 →
        Polynomial.eval x (F.map (Polynomial.aeval η).toRingHom) = 0 → Polynomial.derivative F = 0 →
        ∃ G : Polynomial (Polynomial ↥W), G ≠ 0 ∧
          Polynomial.eval x (G.map (Polynomial.aeval η).toRingHom) = 0 ∧
          G.natDegree < F.natDegree := by
      intro x F hF hFx hF'
      set φ : Polynomial ↥W →+* A := (Polynomial.aeval η).toRingHom with hφ
      have hφX : φ Polynomial.X = η := by simp [hφ]
      have hdeg0 : F.natDegree ≠ 0 := by
        intro h0
        rw [Polynomial.eq_C_of_natDegree_eq_zero h0] at hFx hF
        rw [Polynomial.map_C, Polynomial.eval_C] at hFx
        have hc : F.coeff 0 = 0 := hINJ _ hFx
        exact hF (by rw [hc, Polynomial.C_0])
      set G0 := Polynomial.contract p F with hG0
      have hexp : Polynomial.expand (Polynomial ↥W) p G0 = F :=
        Polynomial.expand_contract p hF' hp.ne_zero
      set D := G0.natDegree with hD
      have hFdeg : F.natDegree = D * p := by
        rw [← hexp, Polynomial.natDegree_expand]
      have hD1 : 1 ≤ D := by
        rcases Nat.eq_zero_or_pos D with h | h
        · exfalso; apply hdeg0; rw [hFdeg, h, zero_mul]
        · exact h
      choose B hB using fun i => hperf (G0.coeff i)
      let H : Fin p → Polynomial (Polynomial ↥W) := fun j =>
        ∑ i ∈ Finset.range (D + 1), Polynomial.C (B i j) * Polynomial.X ^ i
      have hHcoeff : ∀ j i, (H j).coeff i = if i ∈ Finset.range (D + 1) then B i j else 0 := by
        intro j i
        simp only [H, Polynomial.finset_sum_coeff, Polynomial.coeff_C_mul_X_pow]
        rw [Finset.sum_ite_eq]
      have hHeval : ∀ j, Polynomial.eval x ((H j).map φ) =
          ∑ i ∈ Finset.range (D + 1), φ (B i j) * x ^ i := by
        intro j
        simp only [H, Polynomial.map_sum, Polynomial.map_mul, Polynomial.map_C, Polynomial.map_pow,
          Polynomial.map_X, Polynomial.eval_finset_sum, Polynomial.eval_mul, Polynomial.eval_C,
          Polynomial.eval_pow, Polynomial.eval_X]
      have hsum : ∑ j : Fin p, (Polynomial.eval x ((H j).map φ)) ^ p * η ^ (j : ℕ) = 0 := by
        have e1 : Polynomial.eval x (F.map φ) =
            ∑ i ∈ Finset.range (D + 1), φ (G0.coeff i) * (x ^ p) ^ i := by
          rw [← hexp, Polynomial.map_expand, Polynomial.expand_eval,
            Polynomial.eval_eq_sum_range' (n := D + 1)]
          · simp only [Polynomial.coeff_map]
          · exact lt_of_le_of_lt (Polynomial.natDegree_map_le) (Nat.lt_succ_self D)
        rw [← hFx, e1]
        simp only [hHeval, sum_pow_char, mul_pow]
        simp only [Finset.sum_mul]
        rw [Finset.sum_comm]
        refine Finset.sum_congr rfl (fun i _ => ?_)
        rw [hB i, map_sum, Finset.sum_mul]
        refine Finset.sum_congr rfl (fun j _ => ?_)
        rw [map_mul, map_pow, map_pow, hφX, ← pow_mul, ← pow_mul, mul_comm p i]
        ring
      have hzero := hind _ hsum
      have hne : ∃ j, H j ≠ 0 := by
        by_contra hall
        push_neg at hall
        apply hF
        rw [← hexp]
        have : G0 = 0 := by
          refine Polynomial.ext (fun i => ?_)
          rw [Polynomial.coeff_zero]
          by_cases hi : i ∈ Finset.range (D + 1)
          · rw [hB i]
            refine Finset.sum_eq_zero (fun j _ => ?_)
            have := hHcoeff j i
            rw [hall j, Polynomial.coeff_zero, if_pos hi] at this
            rw [← this, zero_pow hp.ne_zero, mul_zero]
          · exact Polynomial.coeff_eq_zero_of_natDegree_lt (by
              simp only [Finset.mem_range] at hi; omega)
        rw [this, map_zero]
      obtain ⟨j, hj⟩ := hne
      refine ⟨H j, hj, hzero j, ?_⟩
      have hHdeg : (H j).natDegree ≤ D := by
        apply Polynomial.natDegree_sum_le_of_forall_le
        intro i hi
        exact (Polynomial.natDegree_C_mul_X_pow_le _ _).trans (by
          simp only [Finset.mem_range] at hi; omega)
      rw [hFdeg]
      have : D < D * p := by
        have := hp.two_le
        nlinarith
