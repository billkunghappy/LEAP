    obtain ⟨hs2, hm2⟩ := hD ((G.stalkMap v).hom s)
    have hmem : (F₁.presheaf.stalkSpecializes h' ≫ F₁.residue (G ζ)).hom s ∈
        Vv.comap (G.residueFieldMap ζ).hom := by
      rw [ValuationSubring.mem_comap, key]; exact hs2
    refine ⟨hmem, fun hs => ?_⟩
    have hs' : (G.stalkMap v).hom s ∈ IsLocalRing.maximalIdeal ↥(F₂.presheaf.stalk v) := by
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hs ⊢
      exact fun hu => hs (IsLocalHom.map_nonunit _ hu)
    have hm := hm2 hs'
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hm ⊢
    intro hu
    apply hm
    obtain ⟨b, hb⟩ := hu.exists_right_inv
    have hb' : (F₁.presheaf.stalkSpecializes h' ≫ F₁.residue (G ζ)).hom s * (b : _) = 1 := by
      exact congrArg Subtype.val hb
    apply isUnit_iff_exists_inv.mpr
    refine ⟨⟨(G.residueFieldMap ζ).hom b.1, b.2⟩, Subtype.ext ?_⟩
    show (F₂.presheaf.stalkSpecializes h ≫ F₂.residue ζ).hom ((G.stalkMap v).hom s) *
      (G.residueFieldMap ζ).hom b.1 = 1
