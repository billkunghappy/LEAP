        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) w) :=
by
  intro Ω _ W Y uY hss w
  constructor
  · intro hL
    have hflat : Flat uY := hss.1
    haveI : IsProper uY := hss.2.1
    have hfp : LocallyOfFinitePresentation uY :=
      wcpa_dj_mn_flat_fp (Spec (.of ↥W)) Y uY hflat inferInstance
    obtain ⟨U, hU, hsm⟩ := wcpa_dj_bsc_smooth_descend (Spec (.of ↥W)) Y uY
      (IsLocalRing.ResidueField ↥W)
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) w hflat hfp hL
    exact ⟨U, hU, hsm⟩
  · rintro ⟨U, hxU, hsm⟩
    have h1 := isPullback_morphismRestrict (Limits.pullback.fst uY
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) U
    have h0 := IsPullback.of_hasPullback uY
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))
    have h2 := h1.paste_vert h0
    refine ⟨Limits.pullback.fst uY
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) ⁻¹ᵁ U, hxU, ?_⟩
    exact MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension 1) h2 hsm

theorem wcpa_dj_lr1k_lldf_chart : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
