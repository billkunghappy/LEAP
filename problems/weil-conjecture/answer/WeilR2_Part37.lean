  have hgen' : ∀ b : wcGubGen W A, ∃ n : ℕ, ∃ a : ↥(wcGubBox W A g c),
      algebraMap ↥(wcGubBox W A g c) (wcGubGen W A) (algebraMap ↥W ↥(wcGubBox W A g c) ϖ) ^ n * b =
        algebraMap ↥(wcGubBox W A g c) (wcGubGen W A) a := by
    intro b
    obtain ⟨n, a', h⟩ := hgen b
    refine ⟨n, a', ?_⟩
    rw [← IsScalarTower.algebraMap_apply ↥W ↥(wcGubBox W A g c) (wcGubGen W A)]
    exact h
  have hunitπ : IsUnit (algebraMap ↥(wcGubBox W A g c) (wcGubGen W A)
      (algebraMap ↥W ↥(wcGubBox W A g c) ϖ)) := by
    rw [← IsScalarTower.algebraMap_apply ↥W ↥(wcGubBox W A g c) (wcGubGen W A)]
    exact hunitW ⟨ϖ, mem_nonZeroDivisors_of_ne_zero hϖ0⟩
  have hπnzd : ∀ x : ↥(wcGubBox W A g c), algebraMap ↥W ↥(wcGubBox W A g c) ϖ * x = 0 → x = 0 := by
    intro x hx
    apply hinj
    rw [map_zero]
    have h1 := congrArg (algebraMap ↥(wcGubBox W A g c) (wcGubGen W A)) hx
