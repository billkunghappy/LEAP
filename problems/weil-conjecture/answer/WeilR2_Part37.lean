          T₁.card ≤ B * (S.card * d) := by
        calc d * (∑ y ∈ T₁, ((δ' y).toNat ^ 2 + 2 * (δ' y).toNat - (m' y).toNat)) + T₁.card
            = ∑ y ∈ T₁, (d * ((δ' y).toNat ^ 2 + 2 * (δ' y).toNat - (m' y).toNat) + 1) := by
              rw [Finset.mul_sum, Finset.card_eq_sum_ones, ← Finset.sum_add_distrib]
