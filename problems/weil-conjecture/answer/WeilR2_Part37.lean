    Hloc _ _ hn hg'3
  have Hβ : ∀ a, ψ ((wcLr1uGerm (γ ≫ ι₀).toNormalization (wcNdPt W (γ ≫ ι₀) u₀ w) hc).hom a) =
      (wcLr1uGerm (γ ≫ ι₀).toNormalization (wcNdPt W (γ ≫ ι₀) u₀ w) hc).hom
