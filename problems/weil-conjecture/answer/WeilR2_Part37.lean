      exact_mod_cast this
    obtain ⟨B, hB⟩ : ∃ B, B = d ^ 2 + 2 * d - μ := ⟨_, rfl⟩
    have hdd : d ≤ d ^ 2 := by rw [sq]; exact Nat.le_mul_of_pos_left d hd1
    have hB1 : 1 ≤ B := by omega
