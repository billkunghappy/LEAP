    exact Ideal.mul_mem_left _ _ (Ideal.subset_span rfl)
  have hnzQ : (Scheme.ΓSpecIso (.of (wcNcRing W b))).inv.hom
      (Ideal.Quotient.mk (wcNcIdeal W b) (MvPolynomial.X 0)) ∈
      nonZeroDivisors Γ(Spec (.of (wcNcRing W b)), ⊤) := by
