    · rw [ValuationSubring.mem_comap, K5e]; exact (ψl.hom s).2
    · have hm : ψl.hom s ∈ IsLocalRing.maximalIdeal V := by
        rw [IsLocalRing.mem_maximalIdeal] at hs ⊢
