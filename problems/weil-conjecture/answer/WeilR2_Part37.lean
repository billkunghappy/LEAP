  obtain ⟨a, P, ha⟩ := wcpa_dj_lr1k_nsr_gub_bff_dc_ia_density Ω W hdimW hWt A ϖ ζ hbase hN z l
    hI hC e₀ D r₁ r₀ f₁ f₀ o₁ o₀ he₀ he₀m hD hNF hSP e he hem (m + c)

  have htransG : ∀ (R : Type u) [CommRing R] (I : Ideal R) (y : AdicCompletion I R)
