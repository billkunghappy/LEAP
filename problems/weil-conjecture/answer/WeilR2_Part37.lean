  obtain ⟨Φ, hΦX0, hΦX1, hΦC⟩ : ∃ Φ : wcNcRing W b →+* Γ(B, U 0),
      Φ (Ideal.Quotient.mk (wcNcIdeal W b) (MvPolynomial.X 0)) = (r.appLE ⊤ (U 0) (by simp)).hom
        ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom
          (MvPolynomial.X 0 - MvPolynomial.C e)) ∧
      Φ (Ideal.Quotient.mk (wcNcIdeal W b) (MvPolynomial.X 1)) = t 0 1 ∧
      ∀ w : ↥W, Φ (Ideal.Quotient.mk (wcNcIdeal W b) (MvPolynomial.C w)) =
        (r.appLE ⊤ (U 0) (by simp)).hom
          ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.C w)) := by
    let ψ : ↥W →+* Γ(B, U 0) := (r.appLE ⊤ (U 0) (by simp)).hom.comp
      ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom.comp MvPolynomial.C)
    let Φt : MvPolynomial (Fin 2) ↥W →+* Γ(B, U 0) := MvPolynomial.eval₂Hom ψ
      ![(r.appLE ⊤ (U 0) (by simp)).hom
        ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom
