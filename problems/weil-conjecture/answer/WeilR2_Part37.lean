by


  have translate : ∀ {R A : Type u} [CommRing R] [CommRing A]
      (g : MvPolynomial (Fin 1) R →+* A), g.Etale →
      ∀ b : R, ∃ g' : MvPolynomial (Fin 1) R →+* A, g'.Etale ∧
        g'.comp MvPolynomial.C = g.comp MvPolynomial.C ∧
        g' (MvPolynomial.X 0) = g (MvPolynomial.X 0) - g (MvPolynomial.C b) := by
    intro R A _ _ g hg b
    let φa : MvPolynomial (Fin 1) R →+* MvPolynomial (Fin 1) R :=
      MvPolynomial.eval₂Hom MvPolynomial.C (fun _ => MvPolynomial.X 0 - MvPolynomial.C b)
    let φb : MvPolynomial (Fin 1) R →+* MvPolynomial (Fin 1) R :=
      MvPolynomial.eval₂Hom MvPolynomial.C (fun _ => MvPolynomial.X 0 + MvPolynomial.C b)
    have hab : φa.comp φb = RingHom.id _ := by
      apply MvPolynomial.ringHom_ext
      · intro c; simp [φa, φb]
      · intro i
        rw [Subsingleton.elim i 0]
        simp [φa, φb]
    have hba : φb.comp φa = RingHom.id _ := by
      apply MvPolynomial.ringHom_ext
      · intro c; simp [φa, φb]
      · intro i
        rw [Subsingleton.elim i 0]
        simp [φa, φb]
    let Φ := RingEquiv.ofRingHom φa φb hab hba
    have hΦ : ∀ P, Φ P = φa P := fun P => rfl
    refine ⟨g.comp Φ.toRingHom, RingHom.Etale.respectsIso.2 g Φ hg, ?_, ?_⟩
    · ext c
      simp [hΦ, φa]
    · show g (Φ (MvPolynomial.X 0)) = _
      rw [hΦ]
      simp only [φa, MvPolynomial.eval₂Hom_X']
      rw [map_sub]

  have isolate : ∀ (P : Type u) [CommRing P] (Z : Scheme.{u}) (V : Z.Opens) (hV : IsAffineOpen V)
      (g : P →+* Γ(Z, V)), g.Etale → ∀ (x : ↥Z) (hx : x ∈ V), ∃ h : Γ(Z, V), x ∈ Z.basicOpen h ∧
      ∀ (y : ↥Z) (hy : y ∈ V), y ∈ Z.basicOpen h →
        Spec.map (CommRingCat.ofHom g) (hV.primeIdealOf ⟨y, hy⟩) =
          Spec.map (CommRingCat.ofHom g) (hV.primeIdealOf ⟨x, hx⟩) → y = x := by
    intro P _ Z V hV g hg x hx
    classical
    letI := g.toAlgebra
    haveI : Algebra.Etale P Γ(Z, V) := hg
    haveI : Algebra.QuasiFinite P Γ(Z, V) := inferInstance
    obtain ⟨q, hq⟩ : ∃ q, q = hV.primeIdealOf ⟨x, hx⟩ := ⟨_, rfl⟩
    have hF := Algebra.QuasiFinite.finite_comap_preimage_singleton (R := P) (S := Γ(Z, V))
      (PrimeSpectrum.comap (algebraMap P Γ(Z, V)) q)
    have hmem : ∀ (y : Z) (hy : y ∈ V) (f : Γ(Z, V)),
        y ∈ Z.basicOpen f ↔ f ∉ (hV.primeIdealOf ⟨y, hy⟩).asIdeal := by
      intro y hy f
      have h1 : hV.fromSpec (hV.primeIdealOf ⟨y, hy⟩) = y := hV.fromSpec_primeIdealOf ⟨y, hy⟩
      have h3 := hV.fromSpec_preimage_basicOpen f
      constructor
      · intro hyf
        have h4 : hV.primeIdealOf ⟨y, hy⟩ ∈ hV.fromSpec ⁻¹ᵁ Z.basicOpen f := by
          show hV.fromSpec (hV.primeIdealOf ⟨y, hy⟩) ∈ Z.basicOpen f
          rw [h1]; exact hyf
        rw [h3] at h4
        exact h4
      · intro hf
        have h4 : hV.primeIdealOf ⟨y, hy⟩ ∈ PrimeSpectrum.basicOpen f := hf
        rw [← h3] at h4
        have h5 : hV.fromSpec (hV.primeIdealOf ⟨y, hy⟩) ∈ Z.basicOpen f := h4
        rw [h1] at h5
        exact h5
    have hsep : ∀ q' : PrimeSpectrum Γ(Z, V),
        q' ∈ PrimeSpectrum.comap (algebraMap P Γ(Z, V)) ⁻¹'
          {PrimeSpectrum.comap (algebraMap P Γ(Z, V)) q} →
        q' ≠ q → ∃ f, f ∈ q'.asIdeal ∧ f ∉ q.asIdeal := by
      intro q' hq' hne
      by_contra hcon
      push_neg at hcon
      apply hne
      apply PrimeSpectrum.ext
      apply Algebra.QuasiFinite.eq_of_le_of_under_eq (R := P) q'.asIdeal q.asIdeal
        (fun f hf => hcon f hf)
      have h3 := congrArg PrimeSpectrum.asIdeal (Set.mem_singleton_iff.mp hq')
      exact h3
    choose! f hf using hsep
    refine ⟨∏ q' ∈ hF.toFinset.erase q, f q', ?_, ?_⟩
    · rw [hmem x hx, ← hq, Ideal.IsPrime.prod_mem_iff]
