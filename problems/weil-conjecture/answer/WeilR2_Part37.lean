            else 0) =
          ((∑ y ∈ T₁, ((δ' y).toNat ^ 2 + 2 * (δ' y).toNat - (m' y).toNat) : ℕ) : ℕ∞) := by
        rw [Nat.cast_sum, hT₁, Finset.sum_filter]
