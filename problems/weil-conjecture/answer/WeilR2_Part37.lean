      congr 1
      have nat : ∀ y, (Scheme.ΓSpecIso (.of R)).hom.hom
          ((Spec.map (CommRingCat.ofHom (MvPolynomial.eval (fun _ : Fin 1 => (0 : R))))).appTop.hom y) =
          (MvPolynomial.eval (fun _ : Fin 1 => (0 : R)))
            ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) R))).hom.hom y) := by
        intro y
        have := congrArg (fun h => h.hom y)
          (Scheme.ΓSpecIso_naturality (CommRingCat.ofHom (MvPolynomial.eval (fun _ : Fin 1 => (0 : R)))))
        exact this
      have inj : ∀ z, (Scheme.ΓSpecIso (.of R)).hom.hom z = 0 → z = 0 := by
        intro z hz
        have e : (Scheme.ΓSpecIso (.of R)).inv.hom ((Scheme.ΓSpecIso (.of R)).hom.hom z) = z := by
          simp
        rw [← e, hz, map_zero]
      ext y
      rw [RingHom.mem_ker, Ideal.mem_span_singleton']
      constructor
      · intro hy
        have h2 : (Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) R))).hom.hom y ∈
            RingHom.ker (MvPolynomial.eval (fun _ : Fin 1 => (0 : R))) := by
          rw [RingHom.mem_ker, ← nat, hy, map_zero]
        rw [s2] at h2
        obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp h2
        refine ⟨(Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) R))).inv.hom c, ?_⟩
        rw [← map_mul, hc]
        simp
      · rintro ⟨c, rfl⟩
        rw [map_mul]
        have h0 : (Spec.map (CommRingCat.ofHom (MvPolynomial.eval (fun _ : Fin 1 => (0 : R))))).appTop.hom
            ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) R))).inv.hom (MvPolynomial.X 0)) = 0 := by
          apply inj
          rw [nat]
          simp
        rw [h0, mul_zero]
    have : IsAffine U := hU
    rw [s3, Scheme.ker_of_isAffine ΔU, hker]
    have e1 : Scheme.IdealSheafData.ofIdealTop (Ideal.span
        {(Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) R))).inv.hom (MvPolynomial.X 0)}) =
        wcNcPrincipal (.of (MvPolynomial (Fin 1) R)) (Spec (.of (MvPolynomial (Fin 1) R))) (𝟙 _)
          (MvPolynomial.X 0) := by
      unfold wcNcPrincipal
      rw [Scheme.Hom.id_appTop]
      rfl
    rw [e1, comapL, Category.comp_id]
    rfl
  intro Ω _ W X uX σ O m σO a hO hσ hmq hσO hσO0 hker
  haveI hOa : IsAffine O.toScheme := hO
  have h1 : (Scheme.Hom.ker σ).comap O.ι = Scheme.Hom.ker σO :=
    restrictL X O (.of ↥W) σ σO hσ hσO
  have h2 : (Scheme.Hom.ker (Spec.map (CommRingCat.ofHom
      (MvPolynomial.eval (fun _ : Fin 1 => (0 : ↥W)))))).comap m = Scheme.Hom.ker σO :=
    chartL ↥W O.toScheme m σO hOa hσO0 hker
  have h3 : (wcNcPrincipal (.of ↥W) X uX a).comap O.ι =
      wcNcPrincipal (.of ↥W) O.toScheme (O.ι ≫ uX) a :=
    comapL (.of ↥W) X O.toScheme uX O.ι a
  have h4 : (wcNcPrincipal (.of ↥W) (Spec (.of (MvPolynomial (Fin 1) ↥W)))
      (Spec.map (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W))) a).comap m =
      wcNcPrincipal (.of ↥W) O.toScheme
        (m ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W))) a :=
    comapL (.of ↥W) _ O.toScheme _ m a
  rw [Scheme.IdealSheafData.comap_sup, Scheme.IdealSheafData.comap_sup, h1, h2, h3, h4, hmq]

theorem wcpa_dj_lr1k_nsr_na_lb_ratio_dichotomy : ∀ (X X₁ : Scheme.{u}) (I : X.IdealSheafData) (r : X₁ ⟶ X) (O : X.Opens) (hO : IsAffineOpen O) (t b : Γ(X, O)), I.ideal ⟨O, hO⟩ = Ideal.span {t, b} → wcCsdIsBlowup I r → ∀ (z : X₁) (hz : z ∈ r ⁻¹ᵁ O), (∃ v : X₁.presheaf.stalk z, (X₁.presheaf.germ (r ⁻¹ᵁ O) z hz).hom ((r.app O).hom t) = v * (X₁.presheaf.germ (r ⁻¹ᵁ O) z hz).hom ((r.app O).hom b) ∧ (X₁.presheaf.germ (r ⁻¹ᵁ O) z hz).hom ((r.app O).hom b) ∈ nonZeroDivisors (X₁.presheaf.stalk z)) ∨ (∃ Y ∈ IsLocalRing.maximalIdeal (X₁.presheaf.stalk z), (X₁.presheaf.germ (r ⁻¹ᵁ O) z hz).hom ((r.app O).hom b) = Y * (X₁.presheaf.germ (r ⁻¹ᵁ O) z hz).hom ((r.app O).hom t) ∧ (X₁.presheaf.germ (r ⁻¹ᵁ O) z hz).hom ((r.app O).hom t) ∈ nonZeroDivisors (X₁.presheaf.stalk z)) :=
by
  intro X X₁ I r O hO t b hI hbl z hz
  classical
  have wc_csd_invpull_generator_chart : ∀ (X T : Scheme.{u}) (I : X.IdealSheafData) (h : T ⟶ X), wcCsdInvPull I h → ∀ (U : X.affineOpens) (n : ℕ) (b : Fin n → Γ(X, U.1)), Ideal.span (Set.range b) = I.ideal U → ∀ t : T, h t ∈ U.1 → ∃ j : Fin n, wcCsdChartAt I h U (b j) t := by
    intro X T I h hP U n b hb t hU
    have LC : ∀ (U' : X.Opens) (V : T.Opens) (hV : IsAffineOpen V) (e : V ≤ h ⁻¹ᵁ U')
        (J : Ideal Γ(X, U')) (ε f : Γ(T, V)), ε ∈ nonZeroDivisors Γ(T, V) →
        Ideal.map (h.appLE U' V e).hom J = Ideal.span {ε} →
        ∃ (e' : T.basicOpen f ≤ h ⁻¹ᵁ U') (r : Γ(T, V) →+* Γ(T, T.basicOpen f)),
          r ε ∈ nonZeroDivisors Γ(T, T.basicOpen f) ∧ IsUnit (r f) ∧
          Ideal.map (h.appLE U' (T.basicOpen f) e').hom J = Ideal.span {r ε} ∧
          ∀ x : Γ(X, U'), (h.appLE U' (T.basicOpen f) e').hom x = r ((h.appLE U' V e).hom x) := by
      intro U' V hV e J ε f hε hJ
      have e' : T.basicOpen f ≤ h ⁻¹ᵁ U' := (T.basicOpen_le f).trans e
      have hform : ∀ x : Γ(X, U'), (h.appLE U' (T.basicOpen f) e').hom x =
          (T.presheaf.map (homOfLE (T.basicOpen_le f)).op).hom ((h.appLE U' V e).hom x) := by
        intro x
        rw [← Scheme.Hom.appLE_map h e (homOfLE (T.basicOpen_le f)).op]
        rfl
      refine ⟨e', (T.presheaf.map (homOfLE (T.basicOpen_le f)).op).hom, ?_, ?_, ?_, hform⟩
      · exact @IsLocalization.map_nonZeroDivisors_le _ _ (Submonoid.powers f) _ _ _
          (hV.isLocalization_basicOpen f) _ (Submonoid.mem_map_of_mem _ hε)
      · exact @IsLocalization.Away.algebraMap_isUnit _ _ _ _ _ f (hV.isLocalization_basicOpen f)
      · have hcomp : (h.appLE U' (T.basicOpen f) e').hom =
            (T.presheaf.map (homOfLE (T.basicOpen_le f)).op).hom.comp (h.appLE U' V e).hom :=
          RingHom.ext hform
        rw [hcomp, ← Ideal.map_map, hJ, Ideal.map_span, Set.image_singleton]
    have LD : ∀ (U₀ D : X.affineOpens) (W : T.Opens) (eU : W ≤ h ⁻¹ᵁ U₀.1) (eD : W ≤ h ⁻¹ᵁ D.1),
        D ≤ U₀ → Ideal.map (h.appLE U₀.1 W eU).hom (I.ideal U₀) =
          Ideal.map (h.appLE D.1 W eD).hom (I.ideal D) := by
      intro U₀ D W eU eD hDU
      rw [← I.map_ideal hDU, Ideal.map_map]
      congr 1
      rw [← CommRingCat.hom_comp, Scheme.Hom.map_appLE]
    obtain ⟨U₁, V₁, e₁, a₁, htV₁, -, hε₁, hJ₁⟩ := hP t
    have hU₁ : h t ∈ U₁.1 := e₁ htV₁
    obtain ⟨D₀, hD₀, hxD₀, hD₀sub⟩ :=
      exists_isAffineOpen_mem_and_subset (x := h t) (U := U.1 ⊓ U₁.1) ⟨hU, hU₁⟩
    let D : X.affineOpens := ⟨D₀, hD₀⟩
    have hDU : D ≤ U := show D₀ ≤ U.1 from fun x hx => (hD₀sub hx).1
    have hDU₁ : D ≤ U₁ := show D₀ ≤ U₁.1 from fun x hx => (hD₀sub hx).2
    have htVD : t ∈ V₁.1 ⊓ h ⁻¹ᵁ D.1 := ⟨htV₁, hxD₀⟩
    obtain ⟨f, hf, htf⟩ := V₁.2.exists_basicOpen_le (V := V₁.1 ⊓ h ⁻¹ᵁ D.1) ⟨t, htVD⟩ htV₁
    have htf' : t ∈ T.basicOpen f := htf
    have hV₂ : IsAffineOpen (T.basicOpen f) := V₁.2.basicOpen f
    have eD : T.basicOpen f ≤ h ⁻¹ᵁ D.1 := hf.trans inf_le_right
    have eU : T.basicOpen f ≤ h ⁻¹ᵁ U.1 := fun x hx => hDU (eD hx)
    obtain ⟨eU₁, r₁, hε₂, -, hJ₂, -⟩ := LC U₁.1 V₁.1 V₁.2 e₁ (I.ideal U₁) _ f hε₁ hJ₁
    generalize r₁ ((h.appLE U₁.1 V₁.1 e₁).hom a₁) = ε₂ at hε₂ hJ₂
    have hJ : Ideal.map (h.appLE U.1 (T.basicOpen f) eU).hom (I.ideal U) = Ideal.span {ε₂} := by
      rw [LD U D _ eU eD hDU, ← LD U₁ D _ eU₁ eD hDU₁, hJ₂]
    have hJb : Ideal.span (Set.range (fun j => (h.appLE U.1 (T.basicOpen f) eU).hom (b j))) =
        Ideal.span {ε₂} := by
      rw [← hJ, ← hb, Ideal.map_span, ← Set.range_comp]
      rfl
    have hy : ∀ j, ∃ y, y * ε₂ = (h.appLE U.1 (T.basicOpen f) eU).hom (b j) := by
      intro j
      apply Ideal.mem_span_singleton'.mp
      rw [← hJb]
      exact Ideal.subset_span ⟨j, rfl⟩
    choose y hy using hy
    have hεmem : ε₂ ∈ Ideal.span (Set.range (fun j => (h.appLE U.1 (T.basicOpen f) eU).hom (b j))) := by
      rw [hJb]; exact Ideal.mem_span_singleton_self ε₂
    obtain ⟨c, hc⟩ := Ideal.mem_span_range_iff_exists_fun.mp hεmem
    have hcy : ∑ j, c j * y j = 1 := by
      have h1 : (∑ j, c j * y j) * ε₂ = ε₂ := by
        rw [Finset.sum_mul]
        simp_rw [mul_assoc, hy]
        exact hc
      have h0 : (∑ j, c j * y j - 1) * ε₂ = 0 := by rw [sub_mul, h1, one_mul, sub_self]
      exact sub_eq_zero.mp ((mul_right_mem_nonZeroDivisors_eq_zero_iff hε₂).mp h0)
    obtain ⟨j, hj⟩ : ∃ j, t ∈ T.basicOpen (y j) := by
      by_contra hcon
      push_neg at hcon
      have hm : ∀ j, (T.presheaf.germ (T.basicOpen f) t htf').hom (c j * y j) ∈
          IsLocalRing.maximalIdeal (T.presheaf.stalk t) := by
        intro j
        rw [map_mul]
        apply Ideal.mul_mem_left
        rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, ← Scheme.mem_basicOpen T (y j) t htf']
        exact hcon j
      have h1 := Ideal.sum_mem (IsLocalRing.maximalIdeal (T.presheaf.stalk t))
        (t := Finset.univ) (fun j _ => hm j)
      rw [← map_sum, hcy, map_one] at h1
      exact (IsLocalRing.maximalIdeal.isMaximal _).ne_top
        (Ideal.eq_top_of_isUnit_mem _ h1 isUnit_one)
    obtain ⟨e'', r, hε₃, hu, hJ₃, hform⟩ :=
      LC U.1 (T.basicOpen f) hV₂ eU (I.ideal U) ε₂ (y j) hε₂ hJ
    refine ⟨j, ⟨T.basicOpen (y j), hV₂.basicOpen (y j)⟩, e'', hj, ?_, ?_⟩
    · show (h.appLE U.1 (T.basicOpen (y j)) e'').hom (b j) ∈ nonZeroDivisors Γ(T, T.basicOpen (y j))
      rw [hform, ← hy j, map_mul]
      exact mul_mem_nonZeroDivisors.mpr ⟨hu.mem_nonZeroDivisors, hε₃⟩
    · show Ideal.map (h.appLE U.1 (T.basicOpen (y j)) e'').hom (I.ideal U) =
        Ideal.span {(h.appLE U.1 (T.basicOpen (y j)) e'').hom (b j)}
      rw [hJ₃, hform, ← hy j, map_mul, Ideal.span_singleton_mul_left_unit hu]
  have hspan : Ideal.span (Set.range ![t, b]) = I.ideal ⟨O, hO⟩ := by
    rw [Matrix.range_cons_cons_empty, hI]
  have hrz : r z ∈ (⟨O, hO⟩ : X.affineOpens).1 := hz
  obtain ⟨j, V, e, hzV, hnzd, hmap⟩ :=
    wc_csd_invpull_generator_chart X X₁ I r hbl.1 ⟨O, hO⟩ 2 ![t, b] hspan z hrz

  have hGφ : ∀ f : Γ(X, O), (X₁.presheaf.germ V.1 z hzV).hom ((r.appLE O V.1 e).hom f) =
      (X₁.presheaf.germ (r ⁻¹ᵁ O) z hz).hom ((r.app O).hom f) := by
    intro f
    exact TopCat.Presheaf.germ_res_apply X₁.presheaf (homOfLE e) z hzV ((r.app O).hom f)

  have hGnzd : ∀ g ∈ nonZeroDivisors Γ(X₁, V.1),
      (X₁.presheaf.germ V.1 z hzV).hom g ∈ nonZeroDivisors (X₁.presheaf.stalk z) := by
    intro g hg
    letI : Algebra Γ(X₁, V.1) (X₁.presheaf.stalk z) :=
      TopCat.Presheaf.algebra_section_stalk X₁.presheaf ⟨z, hzV⟩
    haveI := V.2.isLocalization_stalk ⟨z, hzV⟩
    exact IsLocalization.nonZeroDivisors_le_comap
      (V.2.primeIdealOf ⟨z, hzV⟩).asIdeal.primeCompl (X₁.presheaf.stalk z) hg
  have hmem : ∀ f ∈ ({t, b} : Set Γ(X, O)),
      ∃ c, c * (r.appLE O V.1 e).hom (![t, b] j) = (r.appLE O V.1 e).hom f := by
    intro f hf
    rw [← Ideal.mem_span_singleton', ← hmap]
    apply Ideal.mem_map_of_mem
    rw [← hspan, Matrix.range_cons_cons_empty]
    exact Ideal.subset_span hf
  obtain ⟨c₁, hc₁⟩ := hmem t (by simp)
  obtain ⟨c₂, hc₂⟩ := hmem b (by simp)
  have hj : j = 0 ∨ j = 1 := by fin_cases j <;> simp
  rcases hj with rfl | rfl
  ·
    simp only [Matrix.cons_val_zero] at hc₂ hnzd
    have hts := hGφ t ▸ hGnzd _ hnzd
    have hbs : (X₁.presheaf.germ (r ⁻¹ᵁ O) z hz).hom ((r.app O).hom b) =
        (X₁.presheaf.germ V.1 z hzV).hom c₂ *
          (X₁.presheaf.germ (r ⁻¹ᵁ O) z hz).hom ((r.app O).hom t) := by
      rw [← hGφ b, ← hGφ t, ← hc₂, map_mul]
    by_cases hc : (X₁.presheaf.germ V.1 z hzV).hom c₂ ∈
        IsLocalRing.maximalIdeal (X₁.presheaf.stalk z)
    · exact Or.inr ⟨_, hc, hbs, hts⟩
    · have hu := IsLocalRing.notMem_maximalIdeal.mp hc
      obtain ⟨d, hd⟩ := hu.exists_left_inv
      refine Or.inl ⟨d, ?_, ?_⟩
      · rw [hbs, ← mul_assoc, hd, one_mul]
      · rw [hbs]
        exact mul_mem_nonZeroDivisors.mpr ⟨hu.mem_nonZeroDivisors, hts⟩
  ·
    simp only [Matrix.cons_val_one, Matrix.head_cons, Matrix.cons_val_zero] at hc₁ hnzd
    refine Or.inl ⟨(X₁.presheaf.germ V.1 z hzV).hom c₁, ?_, hGφ b ▸ hGnzd _ hnzd⟩
    rw [← hGφ b, ← hGφ t, ← hc₁, map_mul]

theorem wcpa_dj_lr1k_nsr_na_lb_section_lift : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (X : Scheme.{u}) (uX : X ⟶ Spec (.of ↥W)) (σ : Spec (.of ↥W) ⟶ X) (O : X.Opens) (hO : IsAffineOpen O) (t : Γ(X, O)) (a : ↥W), σ ≫ uX = 𝟙 _ → a ≠ 0 → ∀ (hσO : ⊤ ≤ σ ⁻¹ᵁ O), (σ.appLE O ⊤ hσO).hom t = 0 → ∀ (I : X.IdealSheafData), I.ideal ⟨O, hO⟩ = Ideal.span {t, (uX.appLE ⊤ O le_top).hom ((Scheme.ΓSpecIso (.of ↥W)).inv.hom a)} → ∀ (X₁ : Scheme.{u}) (r : X₁ ⟶ X), wcCsdIsBlowup I r → ∃ σ' : Spec (.of ↥W) ⟶ X₁, σ' ≫ r = σ :=
by
  intro Ω _ W X uX σ O hO t a hσ ha hσO ht I hI X₁ r hr
  have key : ∀ (g : Spec (.of ↥W) ⟶ Spec (.of ↥W)) (e : (⊤ : (Spec (.of ↥W)).Opens) ≤ g ⁻¹ᵁ ⊤)
      (y : Γ(Spec (.of ↥W), ⊤)), g = 𝟙 _ → (g.appLE ⊤ ⊤ e).hom y = y := by
    rintro g e y rfl
    have hid : (homOfLE e).op = 𝟙 (Opposite.op (⊤ : (Spec (.of ↥W)).Opens)) :=
      Subsingleton.elim _ _
    simp only [Scheme.Hom.appLE, Scheme.Hom.id_app]
    erw [hid, CategoryTheory.Functor.map_id, Category.id_comp]
    rfl
  have hb : (σ.appLE O ⊤ hσO).hom ((uX.appLE ⊤ O le_top).hom
      ((Scheme.ΓSpecIso (.of ↥W)).inv.hom a)) = (Scheme.ΓSpecIso (.of ↥W)).inv.hom a := by
    have h1 := congrArg (fun φ => φ.hom ((Scheme.ΓSpecIso (.of ↥W)).inv.hom a))
      (Scheme.Hom.appLE_comp_appLE σ uX ⊤ O ⊤ le_top hσO)
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at h1
    rw [h1]
    exact key _ _ _ hσ
  have hne : (Scheme.ΓSpecIso (.of ↥W)).inv.hom a ≠ 0 := by
    intro h
    apply ha
    have h2 := congrArg (Scheme.ΓSpecIso (.of ↥W)).hom.hom h
    simpa using h2
  have hnzd : (Scheme.ΓSpecIso (.of ↥W)).inv.hom a ∈
      nonZeroDivisors Γ(Spec (.of ↥W), ⊤) := mem_nonZeroDivisors_of_ne_zero hne
  have hmap : Ideal.map (σ.appLE O ⊤ hσO).hom (I.ideal ⟨O, hO⟩) =
      Ideal.span {(Scheme.ΓSpecIso (.of ↥W)).inv.hom a} := by
    rw [hI, Ideal.map_span, Set.image_pair, ht, hb, Ideal.span_insert_zero]
  have hInv : wcCsdInvPull I σ := by
    intro p
    refine ⟨⟨O, hO⟩, ⟨⊤, isAffineOpen_top _⟩, hσO,
      (uX.appLE ⊤ O le_top).hom ((Scheme.ΓSpecIso (.of ↥W)).inv.hom a), trivial, ?_, ?_, ?_⟩
    · rw [hI]
      exact Ideal.subset_span (Set.mem_insert_of_mem _ rfl)
    · show (σ.appLE O ⊤ hσO).hom ((uX.appLE ⊤ O le_top).hom
        ((Scheme.ΓSpecIso (.of ↥W)).inv.hom a)) ∈ nonZeroDivisors Γ(Spec (.of ↥W), ⊤)
      rw [hb]
      exact hnzd
    · show Ideal.map (σ.appLE O ⊤ hσO).hom (I.ideal ⟨O, hO⟩) =
        Ideal.span {(σ.appLE O ⊤ hσO).hom ((uX.appLE ⊤ O le_top).hom
          ((Scheme.ΓSpecIso (.of ↥W)).inv.hom a))}
      rw [hb]
      exact hmap
  obtain ⟨σ', hσ', -⟩ := hr.2 (Spec (.of ↥W)) σ hInv
  exact ⟨σ', hσ'⟩

theorem wcpa_dj_lr1k_nsr_na_lb_section_kills_ratio : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (X X₁ : Scheme.{u}) (uX : X ⟶ Spec (.of ↥W)) (σ : Spec (.of ↥W) ⟶ X) (r : X₁ ⟶ X) (σ' : Spec (.of ↥W) ⟶ X₁) (O : X.Opens) (t : Γ(X, O)) (a : ↥W), σ ≫ uX = 𝟙 _ → a ≠ 0 → σ' ≫ r = σ → ∀ (hσO : ⊤ ≤ σ ⁻¹ᵁ O), (σ.appLE O ⊤ hσO).hom t = 0 → ∀ (hz : σ' (IsLocalRing.closedPoint ↥W) ∈ r ⁻¹ᵁ O), (∀ Y : X₁.presheaf.stalk (σ' (IsLocalRing.closedPoint ↥W)), (X₁.presheaf.germ (r ⁻¹ᵁ O) _ hz).hom ((r.app O).hom ((uX.appLE ⊤ O le_top).hom ((Scheme.ΓSpecIso (.of ↥W)).inv.hom a))) ≠ Y * (X₁.presheaf.germ (r ⁻¹ᵁ O) _ hz).hom ((r.app O).hom t)) ∧ (∀ v : X₁.presheaf.stalk (σ' (IsLocalRing.closedPoint ↥W)), (X₁.presheaf.germ (r ⁻¹ᵁ O) _ hz).hom ((r.app O).hom t) = v * (X₁.presheaf.germ (r ⁻¹ᵁ O) _ hz).hom ((r.app O).hom ((uX.appLE ⊤ O le_top).hom ((Scheme.ΓSpecIso (.of ↥W)).inv.hom a))) → v ∈ IsLocalRing.maximalIdeal (X₁.presheaf.stalk (σ' (IsLocalRing.closedPoint ↥W)))) :=
by
  intro Ω _ W X X₁ uX σ r σ' O t a hσuX ha hσ hσO ht hz
  subst hσ
  have main : ∀ (p : ↥(Spec (.of ↥W))) (hp : σ' p ∈ r ⁻¹ᵁ O),
      (∀ Y : X₁.presheaf.stalk (σ' p), (X₁.presheaf.germ (r ⁻¹ᵁ O) _ hp).hom ((r.app O).hom
        ((uX.appLE ⊤ O le_top).hom ((Scheme.ΓSpecIso (.of ↥W)).inv.hom a))) ≠
        Y * (X₁.presheaf.germ (r ⁻¹ᵁ O) _ hp).hom ((r.app O).hom t)) ∧
      (∀ v : X₁.presheaf.stalk (σ' p), (X₁.presheaf.germ (r ⁻¹ᵁ O) _ hp).hom ((r.app O).hom t) =
        v * (X₁.presheaf.germ (r ⁻¹ᵁ O) _ hp).hom ((r.app O).hom
          ((uX.appLE ⊤ O le_top).hom ((Scheme.ΓSpecIso (.of ↥W)).inv.hom a))) →
        v ∈ IsLocalRing.maximalIdeal (X₁.presheaf.stalk (σ' p))) := by
    intro p hp
    have hmor : r.app O ≫ X₁.presheaf.germ (r ⁻¹ᵁ O) (σ' p) hp ≫ σ'.stalkMap p =
        (σ' ≫ r).appLE O ⊤ hσO ≫
          (Spec (.of ↥W)).presheaf.germ ⊤ p (TopologicalSpace.Opens.mem_top p) := by
      rw [Scheme.Hom.germ_stalkMap, Scheme.Hom.appLE, Category.assoc, TopCat.Presheaf.germ_res,
        Scheme.Hom.comp_app]
      rfl
    have key : ∀ s : Γ(X, O), (σ'.stalkMap p).hom
        ((X₁.presheaf.germ (r ⁻¹ᵁ O) _ hp).hom ((r.app O).hom s)) =
        ((Spec (.of ↥W)).presheaf.germ ⊤ p (TopologicalSpace.Opens.mem_top p)).hom
          (((σ' ≫ r).appLE O ⊤ hσO).hom s) := by
      intro s
      have := congrArg (fun f => f.hom s) hmor
      simpa only [CommRingCat.comp_apply] using this
    have hT : (σ'.stalkMap p).hom
        ((X₁.presheaf.germ (r ⁻¹ᵁ O) _ hp).hom ((r.app O).hom t)) = 0 := by
      rw [key, ht, map_zero]
    have hid : ∀ (g : Spec (.of ↥W) ⟶ Spec (.of ↥W)) (e : (⊤ : (Spec (.of ↥W)).Opens) ≤ g ⁻¹ᵁ ⊤)
        (c : Γ(Spec (.of ↥W), ⊤)), g = 𝟙 _ → (Scheme.Hom.appLE g ⊤ ⊤ e).hom c = c := by
      intro g e c hg
      subst hg
      simp only [Scheme.Hom.appLE, Scheme.Hom.id_app]
      rw [show (homOfLE e).op = 𝟙 (Opposite.op (⊤ : (Spec (.of ↥W)).Opens)) from
        Subsingleton.elim _ _]
      simp
    have hcomp : ∀ c, ((σ' ≫ r).appLE O ⊤ hσO).hom ((uX.appLE ⊤ O le_top).hom c) =
        (Scheme.Hom.appLE ((σ' ≫ r) ≫ uX) ⊤ ⊤ (by rw [hσuX]; exact le_rfl)).hom c := by
      intro c
      have := congrArg (fun f => f.hom c)
        (Scheme.Hom.appLE_comp_appLE (σ' ≫ r) uX ⊤ O ⊤ le_top hσO)
      simpa only [CommRingCat.comp_apply] using this
    have hA : (σ'.stalkMap p).hom
        ((X₁.presheaf.germ (r ⁻¹ᵁ O) _ hp).hom ((r.app O).hom
          ((uX.appLE ⊤ O le_top).hom ((Scheme.ΓSpecIso (.of ↥W)).inv.hom a)))) ≠ 0 := by
      rw [key, hcomp, hid _ _ _ hσuX]
      intro h0
      have hc : (Scheme.ΓSpecIso (.of ↥W)).inv.hom a = 0 := by
        apply germ_injective_of_isIntegral (Spec (.of ↥W)) p (TopologicalSpace.Opens.mem_top p)
        rw [h0, map_zero]
      apply ha
      have := congrArg (Scheme.ΓSpecIso (.of ↥W)).hom.hom hc
      rwa [map_zero, ← CommRingCat.comp_apply, Iso.inv_hom_id, CommRingCat.id_apply] at this
    refine ⟨?_, ?_⟩
    · intro Y hY
      apply hA
      rw [hY, map_mul, hT, mul_zero]
    · intro v hv
      have h1 := congrArg (σ'.stalkMap p).hom hv
      rw [hT, map_mul] at h1
      have hφv : (σ'.stalkMap p).hom v = 0 :=
        (mul_eq_zero.mp h1.symm).resolve_right hA
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      intro hu
      have := hu.map (σ'.stalkMap p).hom
      rw [hφv] at this
      exact not_isUnit_zero this
  exact main _ hz

theorem wcpa_dj_lr1k_nsr_na_lb_fibre_smat : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (Y : Scheme.{u}) (g : Y ⟶ Spec (.of ↥W)) (U : Y.Opens), SmoothOfRelativeDimension 1 (U.ι ≫ g) → ∀ z : Y, z ∈ U → g z = IsLocalRing.closedPoint ↥W → ∃ p : ↥(Limits.pullback g (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))), Limits.pullback.fst g (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) p = z ∧ wcpaDjLkSmAt W g p :=
by
  intro Ω _ W Y g U hsm z hzU hz
  have h1 : (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))
      (IsLocalRing.closedPoint (IsLocalRing.ResidueField ↥W)) = IsLocalRing.closedPoint ↥W :=
    (Spec.map_apply _ _).trans (IsLocalRing.PrimeSpectrum.comap_residue _ _)
  obtain ⟨p, hp, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := g)
    (g := Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))
