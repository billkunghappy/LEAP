    haveI : Module.Finite (IsLocalRing.ResidueField ↥W) (A ⧸ I) := by
      rw [Module.finite_def]
      have htop : (⊤ : Submodule (IsLocalRing.ResidueField ↥W) (A ⧸ I)) =
          Submodule.span (IsLocalRing.ResidueField ↥W) (Set.range (fun i => π (s i))) := by
        refine le_antisymm ?_ le_top
        rintro q -
        obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective q
        obtain ⟨p, hp⟩ := hs a
        have hclaim : ∀ i, Polynomial.aeval ζ (p i) - algebraMap ↥W A ((p i).coeff 0) ∈
            Ideal.span {ζ} := by
          intro i
          obtain ⟨r, hr⟩ := Polynomial.X_dvd_sub_C (p := p i)
          have := congrArg (Polynomial.aeval ζ) hr
          rw [map_sub, Polynomial.aeval_C, map_mul, Polynomial.aeval_X] at this
          rw [this]
          exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self ζ)
        have hmem : a - ∑ i, algebraMap ↥W A ((p i).coeff 0) * s i ∈ I := by
          have e : a - ∑ i, algebraMap ↥W A ((p i).coeff 0) * s i =
              (a - ∑ i, Polynomial.aeval ζ (p i) * s i) +
              ∑ i, (Polynomial.aeval ζ (p i) - algebraMap ↥W A ((p i).coeff 0)) * s i := by
            simp only [sub_mul, Finset.sum_sub_distrib]; ring
          rw [e]
          refine Ideal.add_mem _ (Ideal.mem_sup_left hp) ?_
          refine Ideal.sum_mem _ (fun i _ => ?_)
          exact Ideal.mem_sup_right (Ideal.mul_mem_right _ _ (hclaim i))
        have hq : Ideal.Quotient.mk I a =
            ∑ i, (IsLocalRing.residue ↥W ((p i).coeff 0)) • π (s i) := by
          have := (Ideal.Quotient.eq_zero_iff_mem (I := I)).mpr hmem
          rw [map_sub, sub_eq_zero] at this
          rw [this, map_sum]
          refine Finset.sum_congr rfl (fun i _ => ?_)
          rw [Algebra.smul_def, map_mul]
          rfl
        rw [hq]
        exact Submodule.sum_mem _
          (fun i _ => Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, rfl⟩))
      rw [htop]
      exact Submodule.fg_span (Set.finite_range _)
    exact IsArtinianRing.of_finite (IsLocalRing.ResidueField ↥W) (A ⧸ I)

  have s3 : I ≤ J.radical := by
    have hpow : ∀ w ∈ IsLocalRing.maximalIdeal ↥W, ∃ K : ℕ, ∃ u : ↥W, w ^ K = u * ϖ := by
      intro w hw
      haveI : Ring.KrullDimLE 1 ↥W := Ring.krullDimLE_iff.mpr hdimW
      have hle : IsLocalRing.maximalIdeal ↥W ≤ (Ideal.span {ϖ}).radical := by
        rw [Ideal.radical_eq_sInf]
        refine le_sInf ?_
        rintro P ⟨hPϖ, hPp⟩
        have hP0 : P ≠ ⊥ := by
          intro h
          apply hϖ0
          have : ϖ ∈ P := hPϖ (Ideal.mem_span_singleton_self ϖ)
          rw [h] at this
          exact (Submodule.mem_bot _).mp this
        haveI := hPp
        have hPmax : P.IsMaximal := Ideal.isMaximal_of_isPrime_of_ne_bot P hP0
        exact le_of_eq (IsLocalRing.eq_maximalIdeal hPmax).symm
      obtain ⟨K, hK⟩ := hle hw
      obtain ⟨u, hu⟩ := Ideal.mem_span_singleton'.mp hK
      exact ⟨K, u, hu.symm⟩
    have hϖJ : algebraMap ↥W A ϖ ∈ J := Ideal.subset_span (Set.mem_insert _ _)
    have hζJ : ζ ∈ J := Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _))
    refine sup_le ?_ ?_
    · rw [Ideal.map_le_iff_le_comap]
      intro w hw
      obtain ⟨K, u, hu⟩ := hpow w hw
      show algebraMap ↥W A w ∈ J.radical
      refine ⟨K, ?_⟩
      rw [← map_pow, hu, map_mul]
      exact Ideal.mul_mem_left _ _ hϖJ
    · rw [Ideal.span_le, Set.singleton_subset_iff]
      exact Ideal.le_radical hζJ

  have hζ𝔪 : ζ ∈ 𝔪 := by
    have : Ideal.span (Set.range g) ≤ 𝔪 := by
      rw [Ideal.span_le]; rintro _ ⟨i, rfl⟩; exact hg𝔪 i
    exact this hζg
  have hI𝔪 : I ≤ 𝔪 := sup_le hm𝔪 (by rw [Ideal.span_le, Set.singleton_subset_iff]; exact hζ𝔪)
  have hcomap : Ideal.comap π (Ideal.map π 𝔪) = 𝔪 := by
    rw [Ideal.comap_map_of_surjective' π Ideal.Quotient.mk_surjective 𝔪, hπ, Ideal.mk_ker]
    exact sup_eq_left.mpr hI𝔪
  have hstar : ∀ x : A, π x ∈ Ideal.map π 𝔪 ↔ x ∈ 𝔪 := by
    intro x
    rw [← Ideal.mem_comap, hcomap]
  have hmax : (Ideal.map π 𝔪).IsMaximal := by
    rcases Ideal.map_eq_top_or_isMaximal_of_surjective π Ideal.Quotient.mk_surjective h𝔪max
      with h | h
    · exfalso
      apply h𝔪max.ne_top
      rw [← hcomap, h, Ideal.comap_top]
    · exact h
  obtain ⟨e, he1, henil, hey⟩ := s2 (A ⧸ I) (Ideal.map π 𝔪) hmax
  obtain ⟨E, hE⟩ := Ideal.Quotient.mk_surjective e
  have hrad : ∀ x : A, IsNilpotent (π x) → x ∈ J.radical := by
    intro x ⟨k, hk⟩
    have : x ^ k ∈ I := by
      rw [← Ideal.Quotient.eq_zero_iff_mem, map_pow]
      exact hk
    exact Ideal.mem_radical_of_pow_mem (s3 this)
  have hE1 : 1 - E ∈ 𝔪 := by
    rw [← hstar, map_sub, map_one, hπ, hE]; exact he1
  have hx0 : E * (1 - E) ∈ J.radical := by
    apply hrad
    rw [map_mul, map_sub, map_one, hπ, hE]; exact henil
  have hxi : ∀ i, E * g i ∈ J.radical := by
    intro i
    apply hrad
    rw [map_mul, hπ, hE]
    exact hey _ (Ideal.mem_map_of_mem _ (hg𝔪 i))
  obtain ⟨N0, hN0⟩ := hx0
  obtain ⟨N1, hN1⟩ := hxi 0
  obtain ⟨N2, hN2⟩ := hxi 1
  refine ⟨E, N0 + N1 + N2 + 1, by omega, hE1,
    Ideal.pow_mem_of_pow_mem J hN0 (by omega), ?_⟩
  intro i
  fin_cases i
  · exact Ideal.pow_mem_of_pow_mem J hN1 (by omega)
  · exact Ideal.pow_mem_of_pow_mem J hN2 (by omega)

theorem wcBde_cpl_torsionfree : ∀ {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u)
    [CommRing A] [Algebra ↥W A] (ϖ : ↥W), ϖ ≠ 0 →
    (∀ w : ↥W, w ≠ 0 → ∃ (K : ℕ) (u : ↥W), ϖ ^ K = u * w) →
    ∀ (g : Fin 2 → A) (e : ↥W) (w : ↥W) (y : wcGubCpl W A g ϖ e), w ≠ 0 →
      algebraMap A (wcGubCpl W A g ϖ e) (algebraMap ↥W A w) * y = 0 → y = 0 :=
by
  intro Ω _ W A _ _ ϖ hϖ0 hdiv g e w y hw hy
  have hpu : IsUnit (algebraMap A (wcGubGen W A) (algebraMap ↥W A ϖ)) :=
    IsLocalization.map_units (wcGubGen W A)
      (⟨algebraMap (↥W) A ϖ, Submonoid.mem_map_of_mem _ (mem_nonZeroDivisors_of_ne_zero hϖ0)⟩ :
        Submonoid.map (algebraMap (↥W) A) (nonZeroDivisors ↥W))
  have hev : ∀ (n : ℕ) (a : A),
      AdicCompletion.evalₐ (wcGubIdl W A g ϖ e) n (algebraMap A (wcGubCpl W A g ϖ e) a) =
        Ideal.Quotient.mk (wcGubIdl W A g ϖ e ^ n) (algebraMap A ↥(wcGubBox W A g e) a) := by
    intro n a
    rw [IsScalarTower.algebraMap_apply A ↥(wcGubBox W A g e) (wcGubCpl W A g ϖ e),
      AlgHom.commutes, Ideal.Quotient.algebraMap_eq]
  have hcancel : ∀ (n : ℕ) (b t : ↥(wcGubBox W A g e)),
      t * algebraMap A ↥(wcGubBox W A g e) (algebraMap ↥W A ϖ) ^ (n + 1) =
        algebraMap A ↥(wcGubBox W A g e) (algebraMap ↥W A ϖ) * b →
      b ∈ wcGubIdl W A g ϖ e ^ n := by
    intro n b t h
    have hv := congrArg Subtype.val h
    simp only [Subalgebra.coe_mul, Subalgebra.coe_pow, Subalgebra.coe_algebraMap] at hv
    have hv2 : algebraMap A (wcGubGen W A) (algebraMap ↥W A ϖ) * (b : wcGubGen W A) =
        algebraMap A (wcGubGen W A) (algebraMap ↥W A ϖ) *
          ((t : wcGubGen W A) * algebraMap A (wcGubGen W A) (algebraMap ↥W A ϖ) ^ n) := by
      rw [← hv]; ring
    have hb : b = t * algebraMap A ↥(wcGubBox W A g e) (algebraMap ↥W A ϖ) ^ n := by
      apply Subtype.ext
      simp only [Subalgebra.coe_mul, Subalgebra.coe_pow, Subalgebra.coe_algebraMap]
      exact hpu.mul_left_cancel hv2
    have hsp : wcGubIdl W A g ϖ e ^ n =
        Ideal.span {algebraMap A ↥(wcGubBox W A g e) (algebraMap (↥W) A ϖ) ^ n} :=
      Ideal.span_singleton_pow _ n
    rw [hsp, hb]
    exact Ideal.mul_mem_left _ t (Ideal.mem_span_singleton_self _)
  have hstep : ∀ z : wcGubCpl W A g ϖ e,
      algebraMap A (wcGubCpl W A g ϖ e) (algebraMap ↥W A ϖ) * z = 0 → z = 0 := by
    intro z hz
    obtain ⟨s, rfl⟩ := AdicCompletion.mk_surjective (wcGubIdl W A g ϖ e) _ z
    apply AdicCompletion.ext_evalₐ
    intro n
    rw [map_zero, AdicCompletion.evalₐ_mk, Ideal.Quotient.eq_zero_iff_mem]
    have ha : (s : ℕ → ↥(wcGubBox W A g e)) (n + 1) ∈ wcGubIdl W A g ϖ e ^ n := by
      have h1 := congrArg (AdicCompletion.evalₐ (wcGubIdl W A g ϖ e) (n + 1)) hz
      rw [map_mul, map_zero, hev, AdicCompletion.evalₐ_mk, ← map_mul,
        Ideal.Quotient.eq_zero_iff_mem] at h1
      have hsp : wcGubIdl W A g ϖ e ^ (n + 1) =
          Ideal.span {algebraMap A ↥(wcGubBox W A g e) (algebraMap (↥W) A ϖ) ^ (n + 1)} :=
        Ideal.span_singleton_pow _ (n + 1)
      rw [hsp, Ideal.mem_span_singleton'] at h1
      obtain ⟨t, ht⟩ := h1
      exact hcancel n _ t ht
    have hb : (s : ℕ → ↥(wcGubBox W A g e)) n - s (n + 1) ∈ wcGubIdl W A g ϖ e ^ n := by
      have h2 := s.2 (Nat.le_succ n)
      rw [SModEq.sub_mem] at h2
      simpa [smul_eq_mul, Ideal.mul_top] using h2
    have h3 := Ideal.add_mem _ hb ha
    rwa [sub_add_cancel] at h3
  have hpowK : ∀ K : ℕ, ∀ z : wcGubCpl W A g ϖ e,
      algebraMap A (wcGubCpl W A g ϖ e) (algebraMap ↥W A ϖ) ^ K * z = 0 → z = 0 := by
    intro K
    induction K with
    | zero => intro z hz; rwa [pow_zero, one_mul] at hz
    | succ K ih =>
      intro z hz
      apply hstep
      apply ih
      rw [← mul_assoc, ← pow_succ]
      exact hz
  obtain ⟨K, u, hK⟩ := hdiv w hw
  apply hpowK K
  rw [← map_pow, ← map_pow, hK, map_mul, map_mul, mul_assoc, hy, mul_zero]

theorem wcBde_newton_idem : ∀ {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u)
    [CommRing A] [Algebra ↥W A] (ϖ : ↥W) (g : Fin 2 → A) (ζ E : A) (N : ℕ)
    (e δ π₁ π₂ : ↥W) (Ke : ℕ) (ue : ↥W),
    ϖ ≠ 0 → 1 ≤ N →
    (E * (1 - E)) ^ N ∈ Ideal.span {algebraMap ↥W A ϖ, ζ} →
    (∀ i : Fin 2, (E * g i) ^ N ∈ Ideal.span {algebraMap ↥W A ϖ, ζ}) →
    e ≠ 0 → e ^ Ke = ue * ϖ → δ ≠ 0 → ϖ = δ * π₁ → e = δ * π₂ →
    ∃ (ε : wcGubCpl W A (fun _ : Fin 2 => ζ) ϖ e)
      (v : Fin 2 → wcGubCpl W A (fun _ : Fin 2 => ζ) ϖ e),
      ε * ε = ε ∧
      (∀ i : Fin 2, algebraMap A (wcGubCpl W A (fun _ : Fin 2 => ζ) ϖ e) (algebraMap ↥W A δ) * v i =
        (ε * algebraMap A (wcGubCpl W A (fun _ : Fin 2 => ζ) ϖ e) (g i)) ^ N) ∧
      ∀ n : ℕ, ∃ K₀ : ℕ, ∀ K : ℕ, K₀ ≤ K →
        Ideal.Quotient.mk (wcGubIdl W A (fun _ : Fin 2 => ζ) ϖ e ^ n)
            (algebraMap A ↥(wcGubBox W A (fun _ : Fin 2 => ζ) e) (wcBdeNewt E K)) =
          AdicCompletion.evalₐ (wcGubIdl W A (fun _ : Fin 2 => ζ) ϖ e) n ε :=
by
  intro Ω _ W A _ _ ϖ g ζ E N e δ π₁ π₂ Ke ue hϖ0 hN1 hEE hEg he0 hKe hδ0 hϖδ heδ

  have hstep : ∀ {R : Type u} [CommRing R] (x : R) (K : ℕ),
      wcBdeNewt x (K + 1) = 3 * wcBdeNewt x K ^ 2 - 2 * wcBdeNewt x K ^ 3 :=
    fun x K => Function.iterate_succ_apply' _ _ _
  have hmap : ∀ {R S : Type u} [CommRing R] [CommRing S] (φ : R →+* S) (x : R) (K : ℕ),
      φ (wcBdeNewt x K) = wcBdeNewt (φ x) K := by
    intro R S _ _ φ x K
    induction K with
    | zero => rfl
    | succ K ih =>
      rw [hstep, hstep, map_sub, map_mul, map_mul, map_pow, map_pow, ih, map_ofNat, map_ofNat]
  have hfac : ∀ {R : Type u} [CommRing R] (x : R) (K : ℕ), ∃ P : R, wcBdeNewt x K = x * P := by
    intro R _ x K
    induction K with
    | zero => exact ⟨1, (mul_one x).symm⟩
    | succ K ih =>
      obtain ⟨P, hP⟩ := ih
      refine ⟨P * (3 * wcBdeNewt x K - 2 * wcBdeNewt x K ^ 2), ?_⟩
      rw [hstep]
      linear_combination (3 * wcBdeNewt x K - 2 * wcBdeNewt x K ^ 2) * hP

  have hadic : ∀ {R : Type u} [CommRing R] (I : Ideal R) (x : R) (c : ℕ),
      (x * (1 - x)) ^ c ∈ I → ∃ ε : AdicCompletion I R, ε * ε = ε ∧
        ∀ n K : ℕ, c * n ≤ K →
          Ideal.Quotient.mk (I ^ n) (wcBdeNewt x K) = AdicCompletion.evalₐ I n ε := by
    intro R _ I x c hc
    obtain ⟨T, hT⟩ : ∃ T : R, T = x * (1 - x) := ⟨_, rfl⟩
    rw [← hT] at hc
    have ha : ∀ K : ℕ, ∃ Q : R, wcBdeNewt x K * (1 - wcBdeNewt x K) = T ^ (2 ^ K) * Q := by
      intro K
      induction K with
      | zero =>
        refine ⟨1, ?_⟩
        show x * (1 - x) = T ^ (2 ^ 0) * 1
        rw [hT]
        ring
      | succ K ih =>
        obtain ⟨Q, hQ⟩ := ih
        refine ⟨Q ^ 2 * (3 - 2 * wcBdeNewt x K) * (1 + 2 * wcBdeNewt x K), ?_⟩
        rw [hstep, show T ^ (2 ^ (K + 1)) = (T ^ (2 ^ K)) ^ 2 by rw [← pow_mul, ← pow_succ]]
        linear_combination (wcBdeNewt x K * (1 - wcBdeNewt x K) + T ^ (2 ^ K) * Q) *
          (3 - 2 * wcBdeNewt x K) * (1 + 2 * wcBdeNewt x K) * hQ
    have hb : ∀ K : ℕ, wcBdeNewt x (K + 1) - wcBdeNewt x K =
        wcBdeNewt x K * (1 - wcBdeNewt x K) * (2 * wcBdeNewt x K - 1) := by
      intro K
      rw [hstep]
      ring
    have hsmall : ∀ m K : ℕ, c * m ≤ K → wcBdeNewt x K * (1 - wcBdeNewt x K) ∈ I ^ m := by
      intro m K hK
      obtain ⟨Q, hQ⟩ := ha K
      rw [hQ]
      apply Ideal.mul_mem_right
      have h1 : T ^ (c * m) ∈ I ^ m := by
        rw [pow_mul]
        exact Ideal.pow_mem_pow hc m
      have h2 : c * m ≤ 2 ^ K := le_trans hK Nat.lt_two_pow_self.le
      obtain ⟨j, hj⟩ := Nat.exists_eq_add_of_le h2
      rw [hj, pow_add]
      exact Ideal.mul_mem_right _ _ h1
    have hd : ∀ m K : ℕ, c * m ≤ K → wcBdeNewt x K - wcBdeNewt x (c * m) ∈ I ^ m := by
      intro m K hK
      induction K, hK using Nat.le_induction with
      | base => simp
      | succ K hK ih =>
        have e1 : wcBdeNewt x (K + 1) - wcBdeNewt x (c * m) =
            (wcBdeNewt x (K + 1) - wcBdeNewt x K) + (wcBdeNewt x K - wcBdeNewt x (c * m)) := by
          ring
        rw [e1, hb]
        exact Ideal.add_mem _ (Ideal.mul_mem_right _ _ (hsmall m K hK)) ih
    have hcau : ∀ n : ℕ, wcBdeNewt x (c * n) ≡ wcBdeNewt x (c * (n + 1))
        [SMOD (I ^ n • (⊤ : Submodule R R))] := by
      intro n
      rw [SModEq.sub_mem, Ideal.smul_eq_mul, Ideal.mul_top]
      have h := hd n (c * (n + 1)) (Nat.mul_le_mul le_rfl (by omega))
      rw [← neg_sub]
      exact neg_mem h
    refine ⟨AdicCompletion.mk I R (AdicCompletion.AdicCauchySequence.mk I R
      (fun n => wcBdeNewt x (c * n)) hcau), ?_, ?_⟩
    · apply AdicCompletion.ext_evalₐ
      intro n
      rw [map_mul, AdicCompletion.evalₐ_mk, ← map_mul, Ideal.Quotient.eq]
      have h := hsmall n (c * n) le_rfl
      have e1 : wcBdeNewt x (c * n) * wcBdeNewt x (c * n) - wcBdeNewt x (c * n) =
          -(wcBdeNewt x (c * n) * (1 - wcBdeNewt x (c * n))) := by ring
      show wcBdeNewt x (c * n) * wcBdeNewt x (c * n) - wcBdeNewt x (c * n) ∈ I ^ n
      rw [e1]
      exact neg_mem h
    · intro n K hK
      rw [AdicCompletion.evalₐ_mk, Ideal.Quotient.eq]
      exact hd n K hK

  have hgen : ∀ {R : Type u} [CommRing R] (p δ' π' x : R) (G : Fin 2 → R) (c : ℕ),
      p = δ' * π' → (∀ a b : R, δ' * a = δ' * b → a = b) →
      (x * (1 - x)) ^ c ∈ Ideal.span {p} → (∀ i, ∃ d : R, (x * G i) ^ N = δ' * d) →
      ∃ (ε : AdicCompletion (Ideal.span {p}) R) (v : Fin 2 → AdicCompletion (Ideal.span {p}) R),
        ε * ε = ε ∧
        (∀ i, algebraMap R (AdicCompletion (Ideal.span {p}) R) δ' * v i =
          (ε * algebraMap R (AdicCompletion (Ideal.span {p}) R) (G i)) ^ N) ∧
        ∀ n K : ℕ, c * n ≤ K →
          Ideal.Quotient.mk (Ideal.span {p} ^ n) (wcBdeNewt x K) =
            AdicCompletion.evalₐ (Ideal.span {p}) n ε := by
    intro R _ p δ' π' x G c hp hcancel hc hdiv
    obtain ⟨ε, hεε, hε⟩ := hadic (Ideal.span {p}) x c hc
    have hevA : ∀ (n : ℕ) (r : R), AdicCompletion.evalₐ (Ideal.span {p}) n
        (algebraMap R (AdicCompletion (Ideal.span {p}) R) r) =
        Ideal.Quotient.mk (Ideal.span {p} ^ n) r := by
      intro n r
      rw [AlgHom.commutes, Ideal.Quotient.algebraMap_eq]
    have hv : ∀ i, ∃ w : AdicCompletion (Ideal.span {p}) R,
        algebraMap R (AdicCompletion (Ideal.span {p}) R) δ' * w =
          (ε * algebraMap R (AdicCompletion (Ideal.span {p}) R) (G i)) ^ N := by
      intro i
      obtain ⟨d, hd⟩ := hdiv i
      choose P hP using fun n : ℕ => hfac x (c * (n + 1))
      obtain ⟨f, hf⟩ : ∃ f : ℕ → R, ∀ n, f n = wcBdeNewt x (c * (n + 1)) := ⟨_, fun _ => rfl⟩
      obtain ⟨V, hVd⟩ : ∃ V : ℕ → R, ∀ n, V n = d * P n ^ N := ⟨_, fun _ => rfl⟩
      have hV : ∀ n, δ' * V n = (f n * G i) ^ N := by
        intro n
        rw [hVd n, hf n, hP n]
        linear_combination (-(P n ^ N)) * hd
      have hfstep : ∀ n, f n - f (n + 1) ∈ Ideal.span {p} ^ (n + 1) := by
        intro n
        have h1 := hε (n + 1) (c * (n + 1)) le_rfl
        have h2 := hε (n + 1) (c * (n + 1 + 1)) (Nat.mul_le_mul le_rfl (by omega))
        rw [hf n, hf (n + 1)]
        exact Ideal.Quotient.eq.mp (h1.trans h2.symm)
      have hVcau : ∀ n : ℕ, V n ≡ V (n + 1) [SMOD (Ideal.span {p} ^ n • (⊤ : Submodule R R))] := by
        intro n
        rw [SModEq.sub_mem, Ideal.smul_eq_mul, Ideal.mul_top, Ideal.span_singleton_pow,
          Ideal.mem_span_singleton']
        have h := hfstep n
        rw [Ideal.span_singleton_pow, Ideal.mem_span_singleton'] at h
        obtain ⟨q, hq⟩ := h
        obtain ⟨s, hs⟩ := sub_dvd_pow_sub_pow (f n) (f (n + 1)) N
        refine ⟨π' * G i ^ N * q * s, ?_⟩
        apply hcancel
        linear_combination (-1 : R) * hV n + hV (n + 1) - G i ^ N * hs + G i ^ N * s * hq -
          G i ^ N * q * s * p ^ n * hp
      refine ⟨AdicCompletion.mk _ R (AdicCompletion.AdicCauchySequence.mk _ R V hVcau), ?_⟩
      apply AdicCompletion.ext_evalₐ
      intro n
      rw [map_mul, map_pow, map_mul, hevA, hevA, AdicCompletion.evalₐ_mk,
        ← hε n (c * (n + 1)) (Nat.mul_le_mul le_rfl (by omega)), ← hf n]
      show Ideal.Quotient.mk _ δ' * Ideal.Quotient.mk _ (V n) =
        (Ideal.Quotient.mk _ (f n) * Ideal.Quotient.mk _ (G i)) ^ N
      rw [← map_mul, ← map_mul, ← map_pow, hV n]
    choose v hv using hv
    exact ⟨ε, v, hεε, hv, hε⟩

  have hunit : ∀ w : ↥W, w ≠ 0 → IsUnit (algebraMap A (wcGubGen W A) (algebraMap ↥W A w)) :=
    fun w hw => IsLocalization.map_units (wcGubGen W A)
      (⟨algebraMap (↥W) A w, Submonoid.mem_map_of_mem _ (mem_nonZeroDivisors_of_ne_zero hw)⟩ :
        Submonoid.map (algebraMap (↥W) A) (nonZeroDivisors ↥W))
  obtain ⟨φ, hφ⟩ : ∃ φ : A →+* ↥(wcGubBox W A (fun _ : Fin 2 => ζ) e),
      φ = algebraMap A ↥(wcGubBox W A (fun _ : Fin 2 => ζ) e) := ⟨_, rfl⟩
  let Z : ↥(wcGubBox W A (fun _ : Fin 2 => ζ) e) :=
    ⟨algebraMap A (wcGubGen W A) ζ * Ring.inverse (algebraMap A (wcGubGen W A) (algebraMap ↥W A e)),
      Algebra.subset_adjoin ⟨0, rfl⟩⟩
  have hZ : φ ζ = φ (algebraMap ↥W A e) * Z := by
    rw [hφ]
    apply Subtype.ext
    simp only [Subalgebra.coe_mul, Subalgebra.coe_algebraMap, Z]
    rw [mul_left_comm, Ring.mul_inverse_cancel _ (hunit e he0), mul_one]
  have hcancel : ∀ a b : ↥(wcGubBox W A (fun _ : Fin 2 => ζ) e),
      φ (algebraMap ↥W A δ) * a = φ (algebraMap ↥W A δ) * b → a = b := by
    intro a b hab
    rw [hφ] at hab
    apply Subtype.ext
    have h := congrArg Subtype.val hab
    simp only [Subalgebra.coe_mul, Subalgebra.coe_algebraMap] at h
    exact (hunit δ hδ0).mul_left_cancel h
  have hϖ' : φ (algebraMap ↥W A ϖ) = φ (algebraMap ↥W A δ) * φ (algebraMap ↥W A π₁) := by
    rw [hϖδ, map_mul, map_mul]
  have he' : φ (algebraMap ↥W A e) = φ (algebraMap ↥W A δ) * φ (algebraMap ↥W A π₂) := by
    rw [← map_mul, ← map_mul, ← heδ]
  have hKe' : φ (algebraMap ↥W A e) ^ Ke = φ (algebraMap ↥W A ue) * φ (algebraMap ↥W A ϖ) := by
    rw [← map_pow, ← map_pow, hKe, map_mul, map_mul]
  have hJdiv : ∀ y ∈ Ideal.span {algebraMap ↥W A ϖ, ζ},
      ∃ d, φ y = φ (algebraMap ↥W A δ) * d := by
    intro y hy
    obtain ⟨a, b, hab⟩ := Ideal.mem_span_pair.mp hy
    refine ⟨φ a * φ (algebraMap ↥W A π₁) + φ b * φ (algebraMap ↥W A π₂) * Z, ?_⟩
    rw [← hab, map_add, map_mul, map_mul, hZ, hϖ', he']
    ring
  have hJpow : ∀ y ∈ Ideal.span {algebraMap ↥W A ϖ, ζ},
      φ y ^ Ke ∈ Ideal.span {φ (algebraMap ↥W A ϖ)} := by
    intro y hy
    obtain ⟨a, b, hab⟩ := Ideal.mem_span_pair.mp hy
    have hy' : φ y = φ a * φ (algebraMap ↥W A ϖ) + φ b * φ (algebraMap ↥W A e) * Z := by
      rw [← hab, map_add, map_mul, map_mul, hZ]
      ring
    obtain ⟨s, hs⟩ := sub_dvd_pow_sub_pow (φ y) (φ b * φ (algebraMap ↥W A e) * Z) Ke
    rw [Ideal.mem_span_singleton]
    refine ⟨φ a * s + (φ b * Z) ^ Ke * φ (algebraMap ↥W A ue), ?_⟩
    linear_combination hs + s * hy' + (φ b * Z) ^ Ke * hKe'

  have hc : (φ E * (1 - φ E)) ^ (N * Ke) ∈ Ideal.span {φ (algebraMap ↥W A ϖ)} := by
    have h := hJpow _ hEE
    rw [map_pow, map_mul, map_sub, map_one, ← pow_mul] at h
    exact h
  have hdiv : ∀ i, ∃ d, (φ E * φ (g i)) ^ N = φ (algebraMap ↥W A δ) * d := by
    intro i
    obtain ⟨d, hd⟩ := hJdiv _ (hEg i)
    refine ⟨d, ?_⟩
    rw [← hd, map_pow, map_mul]
  obtain ⟨ε, v, hεε, hv, hε⟩ := hgen (φ (algebraMap ↥W A ϖ)) (φ (algebraMap ↥W A δ))
    (φ (algebraMap ↥W A π₁)) (φ E) (fun i => φ (g i)) (N * Ke) hϖ' hcancel hc hdiv
  subst hφ
  refine ⟨ε, v, hεε, ?_, ?_⟩
  · intro i
    rw [IsScalarTower.algebraMap_apply A ↥(wcGubBox W A (fun _ : Fin 2 => ζ) e)
        (wcGubCpl W A (fun _ : Fin 2 => ζ) ϖ e) (algebraMap ↥W A δ),
      IsScalarTower.algebraMap_apply A ↥(wcGubBox W A (fun _ : Fin 2 => ζ) e)
        (wcGubCpl W A (fun _ : Fin 2 => ζ) ϖ e) (g i)]
    exact hv i
  · intro n
    refine ⟨N * Ke * n, fun K hK => ?_⟩
    rw [hmap]
    exact hε n K hK

theorem wcBde_newton_box_one : ∀ {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u)
    [CommRing A] [Algebra ↥W A] (ϖ : ↥W) (𝔪 : Ideal A) (g : Fin 2 → A),
    ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → wcGubAdm W A ϖ 𝔪 g →
    ∀ c : ↥W, c ≠ 0 → c ∈ IsLocalRing.maximalIdeal ↥W → ∀ E : A, 1 - E ∈ 𝔪 →
    ∀ n : ℕ, ∃ K₀ : ℕ, ∀ K : ℕ, K₀ ≤ K →
      algebraMap A ↥(wcGubBox W A g c) (wcBdeNewt E K) - 1 ∈ wcGubIdl W A g ϖ c ^ n :=
by
  intro Ω _ W A _ _ ϖ 𝔪 g hdimW hAdm c hc0 hcm E hE n
  obtain ⟨hϖ0, hϖm, hdom, hic, hfp, htf, hN1, hdim, h𝔪max, hm𝔪, hg𝔪, hrad⟩ := hAdm

  have hpow : ∀ w ∈ IsLocalRing.maximalIdeal ↥W, ∃ K : ℕ, ∃ u : ↥W, w ^ K = u * ϖ := by
    intro w hw
    haveI : Ring.KrullDimLE 1 ↥W := Ring.krullDimLE_iff.mpr hdimW
    have hle : IsLocalRing.maximalIdeal ↥W ≤ (Ideal.span {ϖ}).radical := by
      rw [Ideal.radical_eq_sInf]
      refine le_sInf ?_
      rintro P ⟨hPϖ, hPp⟩
      have hP0 : P ≠ ⊥ := by
        intro h
        apply hϖ0
        have : ϖ ∈ P := hPϖ (Ideal.mem_span_singleton_self ϖ)
        rw [h] at this
        exact (Submodule.mem_bot _).mp this
      haveI := hPp
      have hPmax : P.IsMaximal := Ideal.isMaximal_of_isPrime_of_ne_bot P hP0
      exact le_of_eq (IsLocalRing.eq_maximalIdeal hPmax).symm
    obtain ⟨K, hK⟩ := hle hw
    obtain ⟨u, hu⟩ := Ideal.mem_span_singleton'.mp hK
    exact ⟨K, u, hu.symm⟩

  have hQ : ∀ b ∈ 𝔪, ∃ L : ℕ,
      ∃ t : ↥(wcGubBox W A g c), algebraMap A ↥(wcGubBox W A g c) b ^ L =
        t * algebraMap A ↥(wcGubBox W A g c) (algebraMap (↥W) A ϖ) := by
    intro b hb
    set P : Ideal A := Ideal.comap (algebraMap A ↥(wcGubBox W A g c))
      (Ideal.span {algebraMap A ↥(wcGubBox W A g c) (algebraMap (↥W) A ϖ)}).radical with hPdef
    have hPrad : P.radical = P := by
      rw [hPdef, Ideal.comap_radical, Ideal.radical_idem]
    have hunit : IsUnit (algebraMap A (wcGubGen W A) (algebraMap (↥W) A c)) :=
      IsLocalization.map_units (wcGubGen W A)
        (⟨algebraMap (↥W) A c, Submonoid.mem_map_of_mem _ (mem_nonZeroDivisors_of_ne_zero hc0)⟩ :
          Submonoid.map (algebraMap (↥W) A) (nonZeroDivisors ↥W))
    have hgP : Ideal.span (Set.range g) ≤ P := by
      rw [Ideal.span_le]
      rintro _ ⟨i, rfl⟩
      obtain ⟨K, u, hu⟩ := hpow c hcm
      let q : ↥(wcGubBox W A g c) :=
        ⟨algebraMap A (wcGubGen W A) (g i) *
          Ring.inverse (algebraMap A (wcGubGen W A) (algebraMap (↥W) A c)),
          Algebra.subset_adjoin ⟨i, rfl⟩⟩
      have hq : algebraMap A ↥(wcGubBox W A g c) (g i) =
          algebraMap A ↥(wcGubBox W A g c) (algebraMap (↥W) A c) * q := by
        apply Subtype.ext
        simp only [Subalgebra.coe_mul, Subalgebra.coe_algebraMap, q]
        rw [← mul_assoc, mul_comm (algebraMap A (wcGubGen W A) (algebraMap (↥W) A c))
          (algebraMap A (wcGubGen W A) (g i)), mul_assoc, Ring.mul_inverse_cancel _ hunit,
          mul_one]
      have hcK : algebraMap A ↥(wcGubBox W A g c) (algebraMap (↥W) A c) ^ K =
          algebraMap A ↥(wcGubBox W A g c) (algebraMap (↥W) A u) *
            algebraMap A ↥(wcGubBox W A g c) (algebraMap (↥W) A ϖ) := by
        rw [← map_pow, ← map_pow, hu, map_mul, map_mul]
      show g i ∈ P
      rw [hPdef, Ideal.mem_comap]
      refine ⟨K, ?_⟩
      rw [hq, mul_pow, hcK]
      exact Ideal.mul_mem_right _ _ (Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _))
    have hmP : (IsLocalRing.maximalIdeal ↥W).map (algebraMap (↥W) A) ≤ P := by
      rw [Ideal.map_le_iff_le_comap]
      intro w hw
      obtain ⟨K, u, hu⟩ := hpow w hw
      rw [Ideal.mem_comap, hPdef, Ideal.mem_comap]
      refine ⟨K, ?_⟩
      rw [← map_pow, ← map_pow, hu, map_mul, map_mul]
      exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _)
    have h𝔪P : 𝔪 ≤ P := by
      calc 𝔪 = (Ideal.span (Set.range g) ⊔
            (IsLocalRing.maximalIdeal ↥W).map (algebraMap (↥W) A)).radical := hrad.symm
        _ ≤ P.radical := Ideal.radical_mono (sup_le hgP hmP)
        _ = P := hPrad
    have hb' := h𝔪P hb
    rw [hPdef, Ideal.mem_comap] at hb'
    obtain ⟨L, hL⟩ := hb'
    obtain ⟨t, ht⟩ := Ideal.mem_span_singleton'.mp hL
    exact ⟨L, t, ht.symm⟩

  have hs1 : ∀ K : ℕ, ∃ Q : A, 1 - wcBdeNewt E K = (1 - E) ^ (2 ^ K) * Q := by
    intro K
    induction K with
    | zero =>
      refine ⟨1, ?_⟩
      show 1 - E = (1 - E) ^ (2 ^ 0) * 1
      rw [pow_zero, pow_one, mul_one]
    | succ K ih =>
      obtain ⟨Q, hQK⟩ := ih
      refine ⟨Q ^ 2 * (1 + 2 * wcBdeNewt E K), ?_⟩
      have h : wcBdeNewt E (K + 1) =
          3 * (wcBdeNewt E K) ^ 2 - 2 * (wcBdeNewt E K) ^ 3 := by
        show (fun y : A => 3 * y ^ 2 - 2 * y ^ 3)^[K + 1] E =
          3 * ((fun y : A => 3 * y ^ 2 - 2 * y ^ 3)^[K] E) ^ 2 -
            2 * ((fun y : A => 3 * y ^ 2 - 2 * y ^ 3)^[K] E) ^ 3
        rw [Function.iterate_succ_apply']
      rw [h, show 2 ^ (K + 1) = 2 ^ K * 2 from pow_succ 2 K, pow_mul]
      linear_combination (1 + 2 * wcBdeNewt E K) *
        (1 - wcBdeNewt E K + (1 - E) ^ (2 ^ K) * Q) * hQK

  obtain ⟨L, t, ht⟩ := hQ (1 - E) hE
  refine ⟨L * n, fun K hK => ?_⟩
  have hKlt : K < 2 ^ K := Nat.lt_two_pow_self
  have hK2 : L * n ≤ 2 ^ K := le_trans hK hKlt.le
  obtain ⟨Q, hQK⟩ := hs1 K
  have h1 := congrArg (algebraMap A ↥(wcGubBox W A g c)) hQK
  rw [map_sub, map_one, map_mul, map_pow] at h1
  have hsplit : algebraMap A ↥(wcGubBox W A g c) (1 - E) ^ (2 ^ K) =
      (t ^ n * algebraMap A ↥(wcGubBox W A g c) (algebraMap (↥W) A ϖ) ^ n) *
        algebraMap A ↥(wcGubBox W A g c) (1 - E) ^ (2 ^ K - L * n) := by
    rw [← mul_pow, ← ht, ← pow_mul, ← pow_add, Nat.add_sub_cancel' hK2]
  show _ ∈ (Ideal.span {algebraMap A ↥(wcGubBox W A g c) (algebraMap (↥W) A ϖ)}) ^ n
  rw [Ideal.span_singleton_pow, Ideal.mem_span_singleton']
  refine ⟨-(t ^ n * algebraMap A ↥(wcGubBox W A g c) (1 - E) ^ (2 ^ K - L * n) *
    algebraMap A ↥(wcGubBox W A g c) Q), ?_⟩
  linear_combination h1 + algebraMap A ↥(wcGubBox W A g c) Q * hsplit

theorem wcBde_psi_exists : ∀ {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u)
    [CommRing A] [Algebra ↥W A] (ϖ : ↥W) (g : Fin 2 → A) (C : Type u) [CommRing C] [Algebra A C],
    (∀ (w : ↥W) (a : A), w ≠ 0 → algebraMap ↥W A w * a = 0 → a = 0) →
    (∀ (w : ↥W) (y : C), w ≠ 0 → algebraMap A C (algebraMap ↥W A w) * y = 0 → y = 0) →
    ∀ (γ p : ↥W) (N : ℕ), γ ≠ 0 → ϖ = γ * p → 1 ≤ N →
    ∀ (ε : C) (v : Fin 2 → C), ε * ε = ε →
      (∀ i : Fin 2, algebraMap A C (algebraMap ↥W A γ) ^ N * v i =
        (ε * algebraMap A C (g i)) ^ N) →
      ∃ Ψ : ↥(wcGubBox W A g γ) → C, wcBdeRel W A ϖ g γ C Ψ ε (2 * (N - 1)) :=
by
  intro Ω _ W A _ _ ϖ g C _ _ hA hC γ p N hγ hϖ hN ε v hεε hv

  have hεpow : ∀ k : ℕ, ε ^ k * ε = ε := by
    intro k
    induction k with
    | zero => simp
    | succ k ih => rw [pow_succ, mul_assoc, hεε, ih]

  have s1 : ∀ (Γ P G₀ G₁ v₀ v₁ : C) (m n : ℕ), Γ ^ N * v₀ = (ε * G₀) ^ N →
      Γ ^ N * v₁ = (ε * G₁) ^ N →
      ∃ Y : C, Γ ^ (m + n) * Y = (Γ * P) ^ (2 * (N - 1)) * ε * (G₀ ^ m * G₁ ^ n) := by
    intro Γ P G₀ G₁ v₀ v₁ m n h0 h1
    obtain ⟨q₀, a₁, ha₁, rfl⟩ : ∃ q a, a < N ∧ m = N * q + a :=
      ⟨m / N, m % N, Nat.mod_lt _ hN, (Nat.div_add_mod m N).symm⟩
    obtain ⟨q₁, b₁, hb₁, rfl⟩ : ∃ q b, b < N ∧ n = N * q + b :=
      ⟨n / N, n % N, Nat.mod_lt _ hN, (Nat.div_add_mod n N).symm⟩
    obtain ⟨t, ht⟩ : ∃ t, 2 * (N - 1) = t + (a₁ + b₁) := ⟨2 * (N - 1) - (a₁ + b₁), by omega⟩
    refine ⟨(Γ * P) ^ t * P ^ (a₁ + b₁) * G₀ ^ a₁ * G₁ ^ b₁ * v₀ ^ q₀ * v₁ ^ q₁ * ε, ?_⟩
    have key : ε ^ (N * q₀) * ε ^ (N * q₁) * ε = ε := by rw [← pow_add, hεpow]
    rw [ht]
    calc Γ ^ (N * q₀ + a₁ + (N * q₁ + b₁)) *
          ((Γ * P) ^ t * P ^ (a₁ + b₁) * G₀ ^ a₁ * G₁ ^ b₁ * v₀ ^ q₀ * v₁ ^ q₁ * ε)
        = (Γ * P) ^ (t + (a₁ + b₁)) * G₀ ^ a₁ * G₁ ^ b₁ * (Γ ^ N * v₀) ^ q₀ *
            (Γ ^ N * v₁) ^ q₁ * ε := by ring
      _ = (Γ * P) ^ (t + (a₁ + b₁)) * G₀ ^ a₁ * G₁ ^ b₁ * ((ε * G₀) ^ N) ^ q₀ *
            ((ε * G₁) ^ N) ^ q₁ * ε := by rw [h0, h1]
      _ = (Γ * P) ^ (t + (a₁ + b₁)) * (G₀ ^ (N * q₀ + a₁) * G₁ ^ (N * q₁ + b₁)) *
            (ε ^ (N * q₀) * ε ^ (N * q₁) * ε) := by ring
      _ = (Γ * P) ^ (t + (a₁ + b₁)) * ε * (G₀ ^ (N * q₀ + a₁) * G₁ ^ (N * q₁ + b₁)) := by
            rw [key]; ring
  have mono : ∀ m n : ℕ, ∃ Y : C, algebraMap A C (algebraMap ↥W A γ) ^ (m + n) * Y =
      algebraMap A C (algebraMap ↥W A ϖ) ^ (2 * (N - 1)) * ε *
        algebraMap A C (g 0 ^ m * g 1 ^ n) := by
    intro m n
    obtain ⟨Y, hY⟩ := s1 (algebraMap A C (algebraMap ↥W A γ)) (algebraMap A C (algebraMap ↥W A p))
      (algebraMap A C (g 0)) (algebraMap A C (g 1)) (v 0) (v 1) m n (hv 0) (hv 1)
    refine ⟨Y, ?_⟩
    rw [hY, hϖ]
    simp only [map_mul, map_pow]

  have hγu : IsUnit (algebraMap A (wcGubGen W A) (algebraMap ↥W A γ)) :=
    IsLocalization.map_units (wcGubGen W A)
      (⟨_, Submonoid.mem_map_of_mem _ (mem_nonZeroDivisors_of_ne_zero hγ)⟩ :
        Submonoid.map (algebraMap ↥W A) (nonZeroDivisors ↥W))
  obtain ⟨X, hXdef⟩ : ∃ X : Fin 2 → wcGubGen W A, X = fun i => algebraMap A (wcGubGen W A) (g i) *
      Ring.inverse (algebraMap A (wcGubGen W A) (algebraMap ↥W A γ)) := ⟨_, rfl⟩
  have hX : ∀ i, algebraMap A (wcGubGen W A) (algebraMap ↥W A γ) * X i =
      algebraMap A (wcGubGen W A) (g i) := by
    intro i
    simp only [hXdef]
    rw [mul_left_comm, Ring.mul_inverse_cancel _ hγu, mul_one]
  have hmem : ∀ r : ↥(wcGubBox W A g γ), (r : wcGubGen W A) ∈
      Submodule.span A (↑(Submonoid.closure (Set.range X)) : Set (wcGubGen W A)) := by
    intro r
    have h : (r : wcGubGen W A) ∈ Subalgebra.toSubmodule (Algebra.adjoin A (Set.range X)) := by
      rw [hXdef]; exact r.2
    rwa [Algebra.adjoin_eq_span] at h
  have hgen : ∀ i : Fin 2, ∃ m n : ℕ, X i = X 0 ^ m * X 1 ^ n := by
    rw [Fin.forall_fin_two]
    exact ⟨⟨1, 0, by simp⟩, ⟨0, 1, by simp⟩⟩
  have hmon : ∀ x ∈ Submonoid.closure (Set.range X), ∃ m n : ℕ, x = X 0 ^ m * X 1 ^ n := by
    intro x hx
    induction hx using Submonoid.closure_induction with
    | mem x hx =>
      obtain ⟨i, rfl⟩ := hx
      exact hgen i
    | one => exact ⟨0, 0, by simp⟩
    | mul x y _ _ hx hy =>
      obtain ⟨m, n, rfl⟩ := hx
      obtain ⟨m', n', rfl⟩ := hy
      exact ⟨m + m', n + n', by ring⟩

  have hwit : ∀ x ∈ Submodule.span A (↑(Submonoid.closure (Set.range X)) : Set (wcGubGen W A)),
      ∃ (w : ↥W) (a : A) (u : C), w ≠ 0 ∧
        algebraMap A (wcGubGen W A) (algebraMap ↥W A w) * x = algebraMap A (wcGubGen W A) a ∧
        algebraMap A C (algebraMap ↥W A w) * u =
          algebraMap A C (algebraMap ↥W A ϖ) ^ (2 * (N - 1)) * ε * algebraMap A C a := by
    intro x hx
    induction hx using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨m, n, rfl⟩ := hmon x hx
      obtain ⟨Y, hY⟩ := mono m n
      refine ⟨γ ^ (m + n), g 0 ^ m * g 1 ^ n, Y, pow_ne_zero _ hγ, ?_, ?_⟩
      · simp only [map_pow, map_mul]
        calc algebraMap A (wcGubGen W A) (algebraMap ↥W A γ) ^ (m + n) * (X 0 ^ m * X 1 ^ n)
            = (algebraMap A (wcGubGen W A) (algebraMap ↥W A γ) * X 0) ^ m *
                (algebraMap A (wcGubGen W A) (algebraMap ↥W A γ) * X 1) ^ n := by ring
          _ = _ := by rw [hX 0, hX 1]
      · rw [map_pow, map_pow]
        exact hY
    | zero => exact ⟨1, 0, 0, one_ne_zero, by simp, by simp⟩
    | add x y _ _ hx hy =>
      obtain ⟨w, a, u, hw, h1, h2⟩ := hx
      obtain ⟨w', a', u', hw', h1', h2'⟩ := hy
      refine ⟨w * w', algebraMap ↥W A w' * a + algebraMap ↥W A w * a', u + u',
        mul_ne_zero hw hw', ?_, ?_⟩
      · simp only [map_mul, map_add]
        linear_combination (algebraMap A (wcGubGen W A) (algebraMap ↥W A w')) * h1 +
          (algebraMap A (wcGubGen W A) (algebraMap ↥W A w)) * h1'
      · simp only [map_mul, map_add]
        linear_combination (algebraMap A C (algebraMap ↥W A w')) * h2 +
          (algebraMap A C (algebraMap ↥W A w)) * h2'
    | smul c x _ hx =>
      obtain ⟨w, a, u, hw, h1, h2⟩ := hx
      refine ⟨w, c * a, algebraMap A C c * u, hw, ?_, ?_⟩
      · rw [Algebra.smul_def, map_mul]
        linear_combination (algebraMap A (wcGubGen W A) c) * h1
      · rw [map_mul]
        linear_combination (algebraMap A C c) * h2

  have htr : ∀ (x : wcGubGen W A) (w w' : ↥W) (a a' : A) (u : C), w ≠ 0 → w' ≠ 0 →
      algebraMap A (wcGubGen W A) (algebraMap ↥W A w) * x = algebraMap A (wcGubGen W A) a →
      algebraMap A (wcGubGen W A) (algebraMap ↥W A w') * x = algebraMap A (wcGubGen W A) a' →
      algebraMap A C (algebraMap ↥W A w) * u =
        algebraMap A C (algebraMap ↥W A ϖ) ^ (2 * (N - 1)) * ε * algebraMap A C a →
      algebraMap A C (algebraMap ↥W A w') * u =
        algebraMap A C (algebraMap ↥W A ϖ) ^ (2 * (N - 1)) * ε * algebraMap A C a' := by
    intro x w w' a a' u hw _ h1 h1' h2
    have e1 : algebraMap A (wcGubGen W A) (algebraMap ↥W A w' * a) =
        algebraMap A (wcGubGen W A) (algebraMap ↥W A w * a') := by
      rw [map_mul, map_mul]
      linear_combination (algebraMap A (wcGubGen W A) (algebraMap ↥W A w)) * h1' -
        (algebraMap A (wcGubGen W A) (algebraMap ↥W A w')) * h1
    obtain ⟨c, hc⟩ := (IsLocalization.eq_iff_exists
      (Submonoid.map (algebraMap ↥W A) (nonZeroDivisors ↥W)) (wcGubGen W A)).mp e1
    obtain ⟨c0, hc0, hc0e⟩ := Submonoid.mem_map.mp c.2
    have hc0ne : c0 ≠ 0 := nonZeroDivisors.ne_zero hc0
    have e2 : algebraMap ↥W A w' * a = algebraMap ↥W A w * a' := by
      have := hA c0 (algebraMap ↥W A w' * a - algebraMap ↥W A w * a') hc0ne
        (by rw [hc0e, mul_sub, hc, sub_self])
      exact sub_eq_zero.mp this
    have e4 := congrArg (algebraMap A C) e2
    rw [map_mul, map_mul] at e4
    have e3 : algebraMap A C (algebraMap ↥W A w) * (algebraMap A C (algebraMap ↥W A w') * u -
        algebraMap A C (algebraMap ↥W A ϖ) ^ (2 * (N - 1)) * ε * algebraMap A C a') = 0 := by
      linear_combination (algebraMap A C (algebraMap ↥W A w')) * h2 +
        algebraMap A C (algebraMap ↥W A ϖ) ^ (2 * (N - 1)) * ε * e4
    exact sub_eq_zero.mp (hC w _ hw e3)

  choose wf af uf hwf h1f h2f using fun r : ↥(wcGubBox W A g γ) => hwit _ (hmem r)
  refine ⟨uf, ?_⟩
  intro r w a hw hra
  exact htr (r : wcGubGen W A) (wf r) w (af r) a (uf r) (hwf r) hw (h1f r) hra (h2f r)

theorem wcBde_psi_add : ∀ {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u)
    [CommRing A] [Algebra ↥W A] (ϖ : ↥W) (g : Fin 2 → A) (C : Type u) [CommRing C] [Algebra A C],
    (∀ (w : ↥W) (a : A), w ≠ 0 → algebraMap ↥W A w * a = 0 → a = 0) →
    (∀ (w : ↥W) (y : C), w ≠ 0 → algebraMap A C (algebraMap ↥W A w) * y = 0 → y = 0) →
    ∀ (γ : ↥W), γ ≠ 0 → ∀ (Ψ : ↥(wcGubBox W A g γ) → C) (ε : C) (L : ℕ),
    wcBdeRel W A ϖ g γ C Ψ ε L →
      (∀ r r' : ↥(wcGubBox W A g γ), Ψ (r + r') = Ψ r + Ψ r') :=
by
  intro Ω _ W A _ _ ϖ g C _ _ _hA hC γ _hγ Ψ ε L hrel
  classical
  have rep : ∀ z : wcGubGen W A, ∃ (w : ↥W) (a : A), w ≠ 0 ∧
      algebraMap A (wcGubGen W A) (algebraMap ↥W A w) * z = algebraMap A (wcGubGen W A) a := by
    intro z
    obtain ⟨⟨a, s⟩, hs⟩ :=
      IsLocalization.surj (Submonoid.map (algebraMap ↥W A) (nonZeroDivisors ↥W)) z
    obtain ⟨w, hw, hws⟩ := Submonoid.mem_map.mp s.2
    refine ⟨w, a, nonZeroDivisors.ne_zero hw, ?_⟩
    rw [hws, mul_comm]
    exact hs
  have canc : ∀ (w : ↥W) (X Y : C), w ≠ 0 →
      algebraMap A C (algebraMap ↥W A w) * X = algebraMap A C (algebraMap ↥W A w) * Y →
      X = Y := by
    intro w X Y hw hXY
    exact sub_eq_zero.mp (hC w (X - Y) hw (by rw [mul_sub, hXY, sub_self]))
  intro r r'
  obtain ⟨w, a, hw, hr⟩ := rep r
  obtain ⟨w', a', hw', hr'⟩ := rep r'
  have hG : algebraMap A (wcGubGen W A) (algebraMap ↥W A (w * w')) *
      ((r + r' : ↥(wcGubBox W A g γ)) : wcGubGen W A) =
      algebraMap A (wcGubGen W A) (algebraMap ↥W A w' * a + algebraMap ↥W A w * a') := by
    rw [Subalgebra.coe_add]
    simp only [map_mul, map_add]
    linear_combination algebraMap A (wcGubGen W A) (algebraMap ↥W A w') * hr +
      algebraMap A (wcGubGen W A) (algebraMap ↥W A w) * hr'
  have H := hrel (r + r') (w * w') _ (mul_ne_zero hw hw') hG
  have H1 := hrel r w a hw hr
  have H2 := hrel r' w' a' hw' hr'
  simp only [map_mul, map_add] at H
  apply canc (w * w') _ _ (mul_ne_zero hw hw')
  simp only [map_mul]
  linear_combination H - algebraMap A C (algebraMap ↥W A w') * H1 -
    algebraMap A C (algebraMap ↥W A w) * H2

theorem wcBde_psi_smul : ∀ {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u)
    [CommRing A] [Algebra ↥W A] (ϖ : ↥W) (g : Fin 2 → A) (C : Type u) [CommRing C] [Algebra A C],
    (∀ (w : ↥W) (a : A), w ≠ 0 → algebraMap ↥W A w * a = 0 → a = 0) →
    (∀ (w : ↥W) (y : C), w ≠ 0 → algebraMap A C (algebraMap ↥W A w) * y = 0 → y = 0) →
    ∀ (γ : ↥W), γ ≠ 0 → ∀ (Ψ : ↥(wcGubBox W A g γ) → C) (ε : C) (L : ℕ),
    wcBdeRel W A ϖ g γ C Ψ ε L →
      (∀ (a : A) (r : ↥(wcGubBox W A g γ)),
        Ψ (algebraMap A ↥(wcGubBox W A g γ) a * r) = algebraMap A C a * Ψ r) :=
by
  intro Ω _ W A _ _ ϖ g C _ _ _hA hC γ _hγ Ψ ε L hrel b r
  obtain ⟨⟨a, s⟩, hs⟩ := @IsLocalization.surj A _
    (Submonoid.map (algebraMap ↥W A) (nonZeroDivisors ↥W)) (wcGubGen W A) _ _
    Localization.isLocalization (r : wcGubGen W A)
  obtain ⟨w, hw0, hws⟩ := Submonoid.mem_map.mp s.2
  have hw : w ≠ 0 := nonZeroDivisors.ne_zero hw0
  have hr : algebraMap A (wcGubGen W A) (algebraMap ↥W A w) * (r : wcGubGen W A) =
      algebraMap A (wcGubGen W A) a := by
    rw [hws, mul_comm]; exact hs
  have hbr : algebraMap A (wcGubGen W A) (algebraMap ↥W A w) *
      ((algebraMap A ↥(wcGubBox W A g γ) b * r : ↥(wcGubBox W A g γ)) : wcGubGen W A) =
      algebraMap A (wcGubGen W A) (b * a) := by
    rw [Subalgebra.coe_mul, Subalgebra.coe_algebraMap, map_mul]
    linear_combination (algebraMap A (wcGubGen W A) b) * hr
  have H := hrel (algebraMap A ↥(wcGubBox W A g γ) b * r) w (b * a) hw hbr
  have H1 := hrel r w a hw hr
  rw [map_mul] at H
  have hz : algebraMap A C (algebraMap ↥W A w) *
      (Ψ (algebraMap A ↥(wcGubBox W A g γ) b * r) - algebraMap A C b * Ψ r) = 0 := by
    linear_combination H - (algebraMap A C b) * H1
  exact sub_eq_zero.mp (hC w _ hw hz)

theorem wcBde_psi_mul : ∀ {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u)
    [CommRing A] [Algebra ↥W A] (ϖ : ↥W) (g : Fin 2 → A) (C : Type u) [CommRing C] [Algebra A C],
    (∀ (w : ↥W) (a : A), w ≠ 0 → algebraMap ↥W A w * a = 0 → a = 0) →
    (∀ (w : ↥W) (y : C), w ≠ 0 → algebraMap A C (algebraMap ↥W A w) * y = 0 → y = 0) →
    ∀ (γ : ↥W), γ ≠ 0 → ∀ (Ψ : ↥(wcGubBox W A g γ) → C) (ε : C) (L : ℕ),
    wcBdeRel W A ϖ g γ C Ψ ε L →
      (ε * ε = ε → ∀ r r' : ↥(wcGubBox W A g γ),
        Ψ r * Ψ r' = algebraMap A C (algebraMap ↥W A ϖ) ^ L * Ψ (r * r')) :=
by
  intro Ω _ W A _ _ ϖ g C _ _ _hA hC γ _hγ Ψ ε L hrel hε r r'
  classical
  have rep : ∀ z : wcGubGen W A, ∃ (w : ↥W) (a : A), w ≠ 0 ∧
      algebraMap A (wcGubGen W A) (algebraMap ↥W A w) * z = algebraMap A (wcGubGen W A) a := by
    intro z
    obtain ⟨⟨a, s⟩, hs⟩ :=
      IsLocalization.surj (Submonoid.map (algebraMap ↥W A) (nonZeroDivisors ↥W)) z
    obtain ⟨w, hw, hws⟩ := Submonoid.mem_map.mp s.2
    refine ⟨w, a, nonZeroDivisors.ne_zero hw, ?_⟩
    rw [hws, mul_comm]
    exact hs
  have canc : ∀ (w : ↥W) (X Y : C), w ≠ 0 →
      algebraMap A C (algebraMap ↥W A w) * X = algebraMap A C (algebraMap ↥W A w) * Y →
      X = Y := by
    intro w X Y hw hXY
    exact sub_eq_zero.mp (hC w (X - Y) hw (by rw [mul_sub, hXY, sub_self]))
  obtain ⟨w, a, hw, hr⟩ := rep r
  obtain ⟨w', a', hw', hr'⟩ := rep r'
  have hG : algebraMap A (wcGubGen W A) (algebraMap ↥W A (w * w')) *
      ((r * r' : ↥(wcGubBox W A g γ)) : wcGubGen W A) =
      algebraMap A (wcGubGen W A) (a * a') := by
    rw [Subalgebra.coe_mul]
    simp only [map_mul]
    linear_combination (algebraMap A (wcGubGen W A) (algebraMap ↥W A w') *
        (r' : wcGubGen W A)) * hr + algebraMap A (wcGubGen W A) a * hr'
  have H := hrel (r * r') (w * w') (a * a') (mul_ne_zero hw hw') hG
  have H1 := hrel r w a hw hr
  have H2 := hrel r' w' a' hw' hr'
  simp only [map_mul] at H
  apply canc (w * w') _ _ (mul_ne_zero hw hw')
  simp only [map_mul]
  linear_combination (algebraMap A C (algebraMap ↥W A w') * Ψ r') * H1 +
    (algebraMap A C (algebraMap ↥W A ϖ) ^ L * ε * algebraMap A C a) * H2 -
    algebraMap A C (algebraMap ↥W A ϖ) ^ L * H +
    ((algebraMap A C (algebraMap ↥W A ϖ) ^ L) ^ 2 * algebraMap A C a *
      algebraMap A C a') * hε

theorem wcBde_psi_transport : ∀ {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u)
    [CommRing A] [Algebra ↥W A] (ϖ : ↥W) (g : Fin 2 → A) (C : Type u) [CommRing C] [Algebra A C],
    (∀ (w : ↥W) (a : A), w ≠ 0 → algebraMap ↥W A w * a = 0 → a = 0) →
    (∀ (w : ↥W) (y : C), w ≠ 0 → algebraMap A C (algebraMap ↥W A w) * y = 0 → y = 0) →
    ∀ (γ : ↥W), γ ≠ 0 → ∀ (Ψ : ↥(wcGubBox W A g γ) → C) (ε : C) (L : ℕ),
    wcBdeRel W A ϖ g γ C Ψ ε L →
      (∀ (C' : Type u) [CommRing C'] [Algebra A C'],
        (∀ (w : ↥W) (y : C'), w ≠ 0 → algebraMap A C' (algebraMap ↥W A w) * y = 0 → y = 0) →
        ∀ (φ : C →+* C'), (∀ a : A, φ (algebraMap A C a) = algebraMap A C' a) →
        ∀ (γ' : ↥W) (h : wcGubBox W A g γ ≤ wcGubBox W A g γ')
          (Ψ' : ↥(wcGubBox W A g γ') → C') (ε' : C'),
          wcBdeRel W A ϖ g γ' C' Ψ' ε' L → φ ε = ε' →
          ∀ r : ↥(wcGubBox W A g γ), φ (Ψ r) = Ψ' (Subalgebra.inclusion h r)) :=
by
  intro Ω _ W A _ _ ϖ g C _ _ _hA _hC γ _hγ Ψ ε L hrel C' _ _ hC' φ hφ γ' h Ψ' ε' hrel' hφε r
  have key : ∀ (B B' : Subalgebra A (wcGubGen W A)) (hBB : B ≤ B') (Ψ₀ : ↥B → C)
      (Ψ₀' : ↥B' → C'),
      (∀ (r₀ : ↥B) (w : ↥W) (a : A), w ≠ 0 →
        algebraMap A (wcGubGen W A) (algebraMap ↥W A w) * (r₀ : wcGubGen W A) =
          algebraMap A (wcGubGen W A) a →
        algebraMap A C (algebraMap ↥W A w) * Ψ₀ r₀ =
          algebraMap A C (algebraMap ↥W A ϖ) ^ L * ε * algebraMap A C a) →
      (∀ (r₀ : ↥B') (w : ↥W) (a : A), w ≠ 0 →
        algebraMap A (wcGubGen W A) (algebraMap ↥W A w) * (r₀ : wcGubGen W A) =
          algebraMap A (wcGubGen W A) a →
        algebraMap A C' (algebraMap ↥W A w) * Ψ₀' r₀ =
          algebraMap A C' (algebraMap ↥W A ϖ) ^ L * ε' * algebraMap A C' a) →
      ∀ r₀ : ↥B, φ (Ψ₀ r₀) = Ψ₀' (Subalgebra.inclusion hBB r₀) := by
    intro B B' hBB Ψ₀ Ψ₀' H0 H0' r₀
    obtain ⟨⟨a, s⟩, hs⟩ := IsLocalization.surj
      (Submonoid.map (algebraMap ↥W A) (nonZeroDivisors ↥W)) (r₀ : wcGubGen W A)
    obtain ⟨w, hw, hws⟩ := Submonoid.mem_map.mp s.2
    have hw0 : w ≠ 0 := nonZeroDivisors.ne_zero hw
    have hr : algebraMap A (wcGubGen W A) (algebraMap ↥W A w) * (r₀ : wcGubGen W A) =
        algebraMap A (wcGubGen W A) a := by
      rw [hws, mul_comm]
      exact hs
    have hr' : algebraMap A (wcGubGen W A) (algebraMap ↥W A w) *
        ((Subalgebra.inclusion hBB r₀ : ↥B') : wcGubGen W A) =
        algebraMap A (wcGubGen W A) a := by
      rw [Subalgebra.coe_inclusion]
      exact hr
    have H := H0 r₀ w a hw0 hr
    have H' := H0' (Subalgebra.inclusion hBB r₀) w a hw0 hr'
    have e1 : φ (algebraMap A C (algebraMap ↥W A w)) = algebraMap A C' (algebraMap ↥W A w) :=
      hφ _
    have e2 : φ (algebraMap A C (algebraMap ↥W A ϖ)) = algebraMap A C' (algebraMap ↥W A ϖ) :=
      hφ _
    have e3 : φ (algebraMap A C a) = algebraMap A C' a := hφ a
    have Hφ : algebraMap A C' (algebraMap ↥W A w) * φ (Ψ₀ r₀) =
        algebraMap A C' (algebraMap ↥W A ϖ) ^ L * ε' * algebraMap A C' a := by
      have h1 := congrArg φ H
      simp only [map_mul, map_pow, e1, e2, e3, hφε] at h1
      exact h1
    exact sub_eq_zero.mp (hC' w _ hw0 (by rw [mul_sub, Hφ, H', sub_self]))
  exact key _ _ h Ψ Ψ' hrel hrel' r

theorem wcBde_psi_calculus : ∀ {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u)
    [CommRing A] [Algebra ↥W A] (ϖ : ↥W) (g : Fin 2 → A) (C : Type u) [CommRing C] [Algebra A C],
    (∀ (w : ↥W) (a : A), w ≠ 0 → algebraMap ↥W A w * a = 0 → a = 0) →
    (∀ (w : ↥W) (y : C), w ≠ 0 → algebraMap A C (algebraMap ↥W A w) * y = 0 → y = 0) →
    ∀ (γ : ↥W), γ ≠ 0 → ∀ (Ψ : ↥(wcGubBox W A g γ) → C) (ε : C) (L : ℕ),
    wcBdeRel W A ϖ g γ C Ψ ε L →
      (∀ r r' : ↥(wcGubBox W A g γ), Ψ (r + r') = Ψ r + Ψ r') ∧
      (∀ (a : A) (r : ↥(wcGubBox W A g γ)),
        Ψ (algebraMap A ↥(wcGubBox W A g γ) a * r) = algebraMap A C a * Ψ r) ∧
      (ε * ε = ε → ∀ r r' : ↥(wcGubBox W A g γ),
        Ψ r * Ψ r' = algebraMap A C (algebraMap ↥W A ϖ) ^ L * Ψ (r * r')) ∧
      (∀ (C' : Type u) [CommRing C'] [Algebra A C'],
        (∀ (w : ↥W) (y : C'), w ≠ 0 → algebraMap A C' (algebraMap ↥W A w) * y = 0 → y = 0) →
        ∀ (φ : C →+* C'), (∀ a : A, φ (algebraMap A C a) = algebraMap A C' a) →
        ∀ (γ' : ↥W) (h : wcGubBox W A g γ ≤ wcGubBox W A g γ')
          (Ψ' : ↥(wcGubBox W A g γ') → C') (ε' : C'),
          wcBdeRel W A ϖ g γ' C' Ψ' ε' L → φ ε = ε' →
          ∀ r : ↥(wcGubBox W A g γ), φ (Ψ r) = Ψ' (Subalgebra.inclusion h r)) :=
by
  intro Ω _ W A _ _ ϖ g C _ _ hA hC γ hγ Ψ ε L hrel
  exact ⟨wcBde_psi_add W A ϖ g C hA hC γ hγ Ψ ε L hrel,
    wcBde_psi_smul W A ϖ g C hA hC γ hγ Ψ ε L hrel,
    wcBde_psi_mul W A ϖ g C hA hC γ hγ Ψ ε L hrel,
    wcBde_psi_transport W A ϖ g C hA hC γ hγ Ψ ε L hrel⟩

theorem wcBde_limit : ∀ {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u)
    [CommRing A] [Algebra ↥W A] (ϖ : ↥W) (g g' : Fin 2 → A) (e γ : ↥W)
    (x : wcGubCpl W A g ϖ γ) (Ψ : ↥(wcGubBox W A g γ) → wcGubCpl W A g' ϖ e),
    (∀ r r' : ↥(wcGubBox W A g γ), Ψ (r + r') = Ψ r + Ψ r') →
    (∀ (a : A) (r : ↥(wcGubBox W A g γ)), Ψ (algebraMap A ↥(wcGubBox W A g γ) a * r) =
      algebraMap A (wcGubCpl W A g' ϖ e) a * Ψ r) →
    ∃ z : wcGubCpl W A g' ϖ e, ∀ (n : ℕ) (r : ↥(wcGubBox W A g γ)),
      Ideal.Quotient.mk (wcGubIdl W A g ϖ γ ^ n) r =
        AdicCompletion.evalₐ (wcGubIdl W A g ϖ γ) n x →
      AdicCompletion.evalₐ (wcGubIdl W A g' ϖ e) n z =
        AdicCompletion.evalₐ (wcGubIdl W A g' ϖ e) n (Ψ r) :=
by
  intro Ω _ W A _ _ ϖ g g' e γ x Ψ hadd hlin
  classical
  have h1 : ∀ {S : Type u} [CommRing S] (J : Ideal S) (y : AdicCompletion J S) (n : ℕ) (s : S),
      Ideal.Quotient.mk (J ^ (n + 1)) s = AdicCompletion.evalₐ J (n + 1) y →
      Ideal.Quotient.mk (J ^ n) s = AdicCompletion.evalₐ J n y := by
    intro S _ J y n s hs
    obtain ⟨f, rfl⟩ := AdicCompletion.mk_surjective J S y
    rw [AdicCompletion.evalₐ_mk] at hs ⊢
    rw [Ideal.Quotient.eq] at hs ⊢
    have h2 : f n - f (n + 1) ∈ J ^ n := by
      have := SModEq.sub_mem.mp (f.2 (Nat.le_succ n))
      simpa [Ideal.smul_eq_mul, Ideal.mul_top] using this
    have h3 : s - f (n + 1) ∈ J ^ n := Ideal.pow_le_pow_right (Nat.le_succ n) hs
    have h4 : s - f n = (s - f (n + 1)) - (f n - f (n + 1)) := by ring
    rw [h4]
    exact sub_mem h3 h2
  have hlinp : ∀ (n : ℕ) (t : ↥(wcGubBox W A g γ)),
      Ψ (algebraMap A ↥(wcGubBox W A g γ) (algebraMap ↥W A ϖ) ^ n * t) =
        algebraMap A (wcGubCpl W A g' ϖ e) (algebraMap ↥W A ϖ) ^ n * Ψ t := by
    intro n t
    have := hlin (algebraMap ↥W A ϖ ^ n) t
    simp only [map_pow] at this
    exact this
  have hkill : ∀ (n : ℕ) (y : wcGubCpl W A g' ϖ e),
      AdicCompletion.evalₐ (wcGubIdl W A g' ϖ e) n
        (algebraMap A (wcGubCpl W A g' ϖ e) (algebraMap ↥W A ϖ) ^ n * y) = 0 := by
    intro n y
    rw [map_mul, map_pow,
      IsScalarTower.algebraMap_apply A ↥(wcGubBox W A g' e) (wcGubCpl W A g' ϖ e),
      AlgHom.commutes, Ideal.Quotient.algebraMap_eq, ← map_pow,
      Ideal.Quotient.eq_zero_iff_mem.mpr, zero_mul]
    exact Ideal.pow_mem_pow (Ideal.mem_span_singleton_self _) n
  have hK : ∀ (n : ℕ) (r r' : ↥(wcGubBox W A g γ)),
      Ideal.Quotient.mk (wcGubIdl W A g ϖ γ ^ n) r =
        AdicCompletion.evalₐ (wcGubIdl W A g ϖ γ) n x →
      Ideal.Quotient.mk (wcGubIdl W A g ϖ γ ^ n) r' =
        AdicCompletion.evalₐ (wcGubIdl W A g ϖ γ) n x →
      AdicCompletion.evalₐ (wcGubIdl W A g' ϖ e) n (Ψ r) =
        AdicCompletion.evalₐ (wcGubIdl W A g' ϖ e) n (Ψ r') := by
    intro n r r' hr hr'
    have hmem : r - r' ∈ wcGubIdl W A g ϖ γ ^ n := Ideal.Quotient.eq.mp (hr.trans hr'.symm)
    have hmem' : r - r' ∈ Ideal.span {algebraMap A ↥(wcGubBox W A g γ) (algebraMap ↥W A ϖ)} ^ n :=
      hmem
    rw [Ideal.span_singleton_pow, Ideal.mem_span_singleton'] at hmem'
    obtain ⟨t, ht⟩ := hmem'
    have hr_eq : r = algebraMap A ↥(wcGubBox W A g γ) (algebraMap ↥W A ϖ) ^ n * t + r' := by
      rw [mul_comm, ht]; ring
    rw [hr_eq, hadd, hlinp]
    refine ((AdicCompletion.evalₐ (wcGubIdl W A g' ϖ e) n).map_add' _ _).trans ?_
    show AdicCompletion.evalₐ (wcGubIdl W A g' ϖ e) n
        (algebraMap A (wcGubCpl W A g' ϖ e) (algebraMap ↥W A ϖ) ^ n * Ψ t) +
      AdicCompletion.evalₐ (wcGubIdl W A g' ϖ e) n (Ψ r') = _
    rw [hkill, zero_add]
  choose r hr using fun n =>
    Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ (wcGubIdl W A g ϖ γ) n x)
  choose s hs using fun n =>
    Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ (wcGubIdl W A g' ϖ e) n (Ψ (r n)))
  have hcau : ∀ n, s n ≡ s (n + 1)
      [SMOD (wcGubIdl W A g' ϖ e ^ n • (⊤ : Submodule ↥(wcGubBox W A g' e) ↥(wcGubBox W A g' e)))] := by
    intro n
    have e1 := hK n (r n) (r (n + 1)) (hr n) (h1 _ x n _ (hr (n + 1)))
    have e2 := h1 _ (Ψ (r (n + 1))) n _ (hs (n + 1))
    have e3 : Ideal.Quotient.mk (wcGubIdl W A g' ϖ e ^ n) (s n) =
        Ideal.Quotient.mk (wcGubIdl W A g' ϖ e ^ n) (s (n + 1)) := by
      rw [hs n, e1, e2]
    rw [SModEq.sub_mem, Ideal.smul_eq_mul, Ideal.mul_top]
    exact Ideal.Quotient.eq.mp e3
  refine ⟨AdicCompletion.mk _ _ (AdicCompletion.AdicCauchySequence.mk _ _ s hcau), ?_⟩
  intro n r' hr'
  rw [AdicCompletion.evalₐ_mk, AdicCompletion.AdicCauchySequence.mk_coe, hs n]
  exact hK n (r n) r' (hr n) hr'

theorem wcBde_idem_from_limit : ∀ {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u)
    [CommRing A] [Algebra ↥W A] (ϖ : ↥W) (g g' : Fin 2 → A) (e γ : ↥W) (k L : ℕ)
    (x : wcGubCpl W A g ϖ γ) (Ψ : ↥(wcGubBox W A g γ) → wcGubCpl W A g' ϖ e)
    (z : wcGubCpl W A g' ϖ e),
    (∀ r r' : ↥(wcGubBox W A g γ), Ψ (r + r') = Ψ r + Ψ r') →
    (∀ (a : A) (r : ↥(wcGubBox W A g γ)), Ψ (algebraMap A ↥(wcGubBox W A g γ) a * r) =
      algebraMap A (wcGubCpl W A g' ϖ e) a * Ψ r) →
    (∀ r r' : ↥(wcGubBox W A g γ),
      Ψ r * Ψ r' = algebraMap A (wcGubCpl W A g' ϖ e) (algebraMap ↥W A ϖ) ^ L * Ψ (r * r')) →
    x * x = algebraMap A (wcGubCpl W A g ϖ γ) (algebraMap ↥W A ϖ) ^ k * x →
    (∀ (n : ℕ) (r : ↥(wcGubBox W A g γ)),
      Ideal.Quotient.mk (wcGubIdl W A g ϖ γ ^ n) r =
        AdicCompletion.evalₐ (wcGubIdl W A g ϖ γ) n x →
      AdicCompletion.evalₐ (wcGubIdl W A g' ϖ e) n z =
        AdicCompletion.evalₐ (wcGubIdl W A g' ϖ e) n (Ψ r)) →
    z * z = algebraMap A (wcGubCpl W A g' ϖ e) (algebraMap ↥W A ϖ) ^ (L + k) * z :=
by
  intro Ω _ W A _ _ ϖ g g' e γ k L x Ψ z hadd hlin hmul hx hz
  have hevB : ∀ (m : ℕ) (a : A),
      AdicCompletion.evalₐ (wcGubIdl W A g ϖ γ) m (algebraMap A (wcGubCpl W A g ϖ γ) a) =
        Ideal.Quotient.mk (wcGubIdl W A g ϖ γ ^ m) (algebraMap A ↥(wcGubBox W A g γ) a) := by
    intro m a
    rw [IsScalarTower.algebraMap_apply A ↥(wcGubBox W A g γ) (wcGubCpl W A g ϖ γ),
      AlgHom.commutes, Ideal.Quotient.algebraMap_eq]
  have hevS : ∀ (m : ℕ) (a : A),
      AdicCompletion.evalₐ (wcGubIdl W A g' ϖ e) m (algebraMap A (wcGubCpl W A g' ϖ e) a) =
        Ideal.Quotient.mk (wcGubIdl W A g' ϖ e ^ m) (algebraMap A ↥(wcGubBox W A g' e) a) := by
    intro m a
    rw [IsScalarTower.algebraMap_apply A ↥(wcGubBox W A g' e) (wcGubCpl W A g' ϖ e),
      AlgHom.commutes, Ideal.Quotient.algebraMap_eq]
  apply AdicCompletion.ext_evalₐ
  intro n
  obtain ⟨r, hr⟩ :=
    Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ (wcGubIdl W A g ϖ γ) n x)
  have hsp : wcGubIdl W A g ϖ γ ^ n =
      Ideal.span {algebraMap A ↥(wcGubBox W A g γ) (algebraMap (↥W) A ϖ) ^ n} :=
    Ideal.span_singleton_pow _ n
  have h1 : Ideal.Quotient.mk (wcGubIdl W A g ϖ γ ^ n) (r * r) =
      Ideal.Quotient.mk (wcGubIdl W A g ϖ γ ^ n)
        (algebraMap A ↥(wcGubBox W A g γ) (algebraMap ↥W A ϖ) ^ k * r) := by
    have h := congrArg (AdicCompletion.evalₐ (wcGubIdl W A g ϖ γ) n) hx
    simp only [map_mul, map_pow, hevB, ← hr] at h
    simpa only [map_mul, map_pow] using h
  rw [Ideal.Quotient.eq, hsp, Ideal.mem_span_singleton'] at h1
  obtain ⟨t, ht⟩ := h1
  have hrr : r * r = algebraMap A ↥(wcGubBox W A g γ) (algebraMap ↥W A ϖ ^ k) * r +
      algebraMap A ↥(wcGubBox W A g γ) (algebraMap ↥W A ϖ ^ n) * t := by
    rw [map_pow, map_pow]
    linear_combination (-1 : ↥(wcGubBox W A g γ)) * ht
  have hΨrr : Ψ r * Ψ r =
      algebraMap A (wcGubCpl W A g' ϖ e) (algebraMap ↥W A ϖ) ^ (L + k) * Ψ r +
      algebraMap A (wcGubCpl W A g' ϖ e) (algebraMap ↥W A ϖ) ^ n *
        (algebraMap A (wcGubCpl W A g' ϖ e) (algebraMap ↥W A ϖ) ^ L * Ψ t) := by
    rw [hmul, hrr, hadd, hlin, hlin, map_pow, map_pow, pow_add]
    ring
  have hkill : ∀ y : wcGubCpl W A g' ϖ e, AdicCompletion.evalₐ (wcGubIdl W A g' ϖ e) n
      (algebraMap A (wcGubCpl W A g' ϖ e) (algebraMap ↥W A ϖ) ^ n * y) = 0 := by
    intro y
    rw [map_mul, map_pow, hevS, ← map_pow, Ideal.Quotient.eq_zero_iff_mem.mpr, zero_mul]
    exact Ideal.pow_mem_pow (Ideal.mem_span_singleton_self _) n
  have hzr := hz n r hr
  have h2 := congrArg (AdicCompletion.evalₐ (wcGubIdl W A g' ϖ e) n) hΨrr
  set_option synthInstance.maxHeartbeats 400000 in
  rw [map_add (AdicCompletion.evalₐ (wcGubIdl W A g' ϖ e) n), hkill, add_zero] at h2
  rw [map_mul, map_mul, hzr]
  simpa only [map_mul] using h2

theorem wcBde_restrict_identity : ∀ {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u)
    [CommRing A] [Algebra ↥W A] (ϖ : ↥W) (g gS gT : Fin 2 → A) (eS eT : ↥W)
    (hST : wcGubBox W A gS eS ≤ wcGubBox W A gT eT) (γ γ' : ↥W)
    (h : wcGubBox W A g γ ≤ wcGubBox W A g γ')
    (x : wcGubCpl W A g ϖ γ) (x' : wcGubCpl W A g ϖ γ') (k k' L₂ : ℕ)
    (Ψ : ↥(wcGubBox W A g γ) → wcGubCpl W A gS ϖ eS)
    (Ψ' : ↥(wcGubBox W A g γ') → wcGubCpl W A gT ϖ eT)
    (ρ : wcGubCpl W A gS ϖ eS →+* wcGubCpl W A gT ϖ eT)
    (z : wcGubCpl W A gS ϖ eS) (z' : wcGubCpl W A gT ϖ eT),
    (∀ r r' : ↥(wcGubBox W A g γ'), Ψ' (r + r') = Ψ' r + Ψ' r') →
    (∀ (a : A) (r : ↥(wcGubBox W A g γ')), Ψ' (algebraMap A ↥(wcGubBox W A g γ') a * r) =
      algebraMap A (wcGubCpl W A gT ϖ eT) a * Ψ' r) →
    (∀ (n : ℕ) (u : wcGubCpl W A gS ϖ eS) (s : ↥(wcGubBox W A gS eS)),
      Ideal.Quotient.mk (wcGubIdl W A gS ϖ eS ^ n) s =
        AdicCompletion.evalₐ (wcGubIdl W A gS ϖ eS) n u →
      Ideal.Quotient.mk (wcGubIdl W A gT ϖ eT ^ n) (Subalgebra.inclusion hST s) =
        AdicCompletion.evalₐ (wcGubIdl W A gT ϖ eT) n (ρ u)) →
    (∀ r : ↥(wcGubBox W A g γ), ρ (Ψ r) = Ψ' (Subalgebra.inclusion h r)) →
    (∀ (n : ℕ) (r : ↥(wcGubBox W A g γ)),
      Ideal.Quotient.mk (wcGubIdl W A g ϖ γ ^ n) r =
        AdicCompletion.evalₐ (wcGubIdl W A g ϖ γ) n x →
      AdicCompletion.evalₐ (wcGubIdl W A gS ϖ eS) n z =
        AdicCompletion.evalₐ (wcGubIdl W A gS ϖ eS) n (Ψ r)) →
    (∀ (n : ℕ) (r' : ↥(wcGubBox W A g γ')),
      Ideal.Quotient.mk (wcGubIdl W A g ϖ γ' ^ n) r' =
        AdicCompletion.evalₐ (wcGubIdl W A g ϖ γ') n x' →
      AdicCompletion.evalₐ (wcGubIdl W A gT ϖ eT) n
          (algebraMap A (wcGubCpl W A gT ϖ eT) (algebraMap ↥W A ϖ) ^ L₂ * z') =
        AdicCompletion.evalₐ (wcGubIdl W A gT ϖ eT) n (Ψ' r')) →
    (∀ (m : ℕ) (r : ↥(wcGubBox W A g γ)) (r' : ↥(wcGubBox W A g γ')),
      Ideal.Quotient.mk (wcGubIdl W A g ϖ γ ^ m) r =
        AdicCompletion.evalₐ (wcGubIdl W A g ϖ γ) m x →
      Ideal.Quotient.mk (wcGubIdl W A g ϖ γ' ^ m) r' =
        AdicCompletion.evalₐ (wcGubIdl W A g ϖ γ') m x' →
      ∃ t : ↥(wcGubBox W A g γ'),
        algebraMap A (wcGubGen W A) (algebraMap ↥W A ϖ) ^ k' * (r : wcGubGen W A) -
          algebraMap A (wcGubGen W A) (algebraMap ↥W A ϖ) ^ k * (r' : wcGubGen W A) =
        algebraMap A (wcGubGen W A) (algebraMap ↥W A ϖ) ^ m * (t : wcGubGen W A)) →
    algebraMap A (wcGubCpl W A gT ϖ eT) (algebraMap ↥W A ϖ) ^ k' * ρ z =
      algebraMap A (wcGubCpl W A gT ϖ eT) (algebraMap ↥W A ϖ) ^ (L₂ + k) * z' :=
by
  intro Ω _ W A _ _ ϖ g gS gT eS eT hST γ γ' h x x' k k' L₂ Ψ Ψ' ρ z z' hadd hlin hρ hρΨ hz hz' hX
  apply AdicCompletion.ext_evalₐ
  intro n
  have hevA : ∀ a : A, AdicCompletion.evalₐ (wcGubIdl W A gT ϖ eT) n
      (algebraMap A (wcGubCpl W A gT ϖ eT) a) =
      Ideal.Quotient.mk (wcGubIdl W A gT ϖ eT ^ n) (algebraMap A ↥(wcGubBox W A gT eT) a) := by
    intro a
    rw [IsScalarTower.algebraMap_apply A ↥(wcGubBox W A gT eT) (wcGubCpl W A gT ϖ eT),
      AlgHom.commutes, Ideal.Quotient.algebraMap_eq]
  have hkill : AdicCompletion.evalₐ (wcGubIdl W A gT ϖ eT) n
      (algebraMap A (wcGubCpl W A gT ϖ eT) (algebraMap ↥W A ϖ)) ^ n = 0 := by
    rw [hevA, ← map_pow, Ideal.Quotient.eq_zero_iff_mem]
    exact Ideal.pow_mem_pow (Ideal.mem_span_singleton_self _) n
  obtain ⟨r, hr⟩ := Ideal.Quotient.mk_surjective (I := wcGubIdl W A g ϖ γ ^ n)
    (AdicCompletion.evalₐ (wcGubIdl W A g ϖ γ) n x)
  obtain ⟨r', hr'⟩ := Ideal.Quotient.mk_surjective (I := wcGubIdl W A g ϖ γ' ^ n)
    (AdicCompletion.evalₐ (wcGubIdl W A g ϖ γ') n x')
  obtain ⟨s, hs⟩ := Ideal.Quotient.mk_surjective (I := wcGubIdl W A gS ϖ eS ^ n)
    (AdicCompletion.evalₐ (wcGubIdl W A gS ϖ eS) n z)
  have h5 : AdicCompletion.evalₐ (wcGubIdl W A gT ϖ eT) n (ρ z) =
      AdicCompletion.evalₐ (wcGubIdl W A gT ϖ eT) n (Ψ' (Subalgebra.inclusion h r)) := by
    rw [← hρ n z s hs, ← hρΨ r, ← hρ n (Ψ r) s (hs.trans (hz n r hr))]
  obtain ⟨t, ht⟩ := hX n r r' hr hr'
  have h6 : algebraMap A ↥(wcGubBox W A g γ') (algebraMap ↥W A ϖ ^ k') *
        Subalgebra.inclusion h r =
      algebraMap A ↥(wcGubBox W A g γ') (algebraMap ↥W A ϖ ^ k) * r' +
        algebraMap A ↥(wcGubBox W A g γ') (algebraMap ↥W A ϖ ^ n) * t := by
    apply Subtype.ext
    simp only [Subalgebra.coe_add, Subalgebra.coe_mul, Subalgebra.coe_algebraMap,
      Subalgebra.coe_inclusion, map_pow, Subalgebra.coe_pow]
    linear_combination ht
  have h7 : algebraMap A (wcGubCpl W A gT ϖ eT) (algebraMap ↥W A ϖ) ^ k' *
        Ψ' (Subalgebra.inclusion h r) =
      algebraMap A (wcGubCpl W A gT ϖ eT) (algebraMap ↥W A ϖ) ^ k * Ψ' r' +
        algebraMap A (wcGubCpl W A gT ϖ eT) (algebraMap ↥W A ϖ) ^ n * Ψ' t := by
    have h6' := congrArg Ψ' h6
    rw [hadd, hlin, hlin, hlin] at h6'
    simpa only [map_pow] using h6'
  have h8 := congrArg (AdicCompletion.evalₐ (wcGubIdl W A gT ϖ eT) n) h7
  have hEadd : ∀ a b : wcGubCpl W A gT ϖ eT,
      AdicCompletion.evalₐ (wcGubIdl W A gT ϖ eT) n (a + b) =
        AdicCompletion.evalₐ (wcGubIdl W A gT ϖ eT) n a +
          AdicCompletion.evalₐ (wcGubIdl W A gT ϖ eT) n b :=
    fun a b => (AdicCompletion.evalₐ (wcGubIdl W A gT ϖ eT) n).map_add' a b
  rw [hEadd] at h8
  simp only [map_mul, map_pow] at h8
  rw [hkill, zero_mul, add_zero] at h8
  have h9 := hz' n r' hr'
  simp only [map_mul, map_pow] at h9
  simp only [map_mul, map_pow]
  rw [h5, h8, ← h9, pow_add]
  ring

theorem wcpa_dj_lr1k_nsr_gub_bdb_disc_extension : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [Algebra ↥W A] (ϖ : ↥W) (𝔪 : Ideal A) (g : Fin 2 → A),
      wcGubAdm W A ϖ 𝔪 g →
    ∀ ζ : A, ζ ∈ Ideal.span (Set.range g) →
    ∀ (E : A) (N : ℕ), 1 ≤ N → 1 - E ∈ 𝔪 →
      (E * (1 - E)) ^ N ∈ Ideal.span {algebraMap ↥W A ϖ, ζ} →
      (∀ i : Fin 2, (E * g i) ^ N ∈ Ideal.span {algebraMap ↥W A ϖ, ζ}) →
    ∀ (x : ∀ c : ↥W, wcGubCpl W A g ϖ c) (k : ↥W → ℕ),
      wcGubIdem W A g ϖ x k → wcGubCompat W A g ϖ x k →
    ∃ (z : ∀ e : ↥W, wcGubCpl W A (fun _ : Fin 2 => ζ) ϖ e) (l : ↥W → ℕ),
      wcGubIdem W A (fun _ : Fin 2 => ζ) ϖ z l ∧ wcGubCompat W A (fun _ : Fin 2 => ζ) ϖ z l ∧
      ∀ c : ↥W, c ≠ 0 → c ∈ IsLocalRing.maximalIdeal ↥W → ∀ (m : ℕ)
        (s : ↥(wcGubBox W A (fun _ : Fin 2 => ζ) c)) (r : ↥(wcGubBox W A g c)),
        Ideal.Quotient.mk (wcGubIdl W A (fun _ : Fin 2 => ζ) ϖ c ^ m) s =
          AdicCompletion.evalₐ (wcGubIdl W A (fun _ : Fin 2 => ζ) ϖ c) m (z c) →
        Ideal.Quotient.mk (wcGubIdl W A g ϖ c ^ m) r =
          AdicCompletion.evalₐ (wcGubIdl W A g ϖ c) m (x c) →
        ∃ t : ↥(wcGubBox W A g c),
          algebraMap A (wcGubGen W A) (algebraMap ↥W A ϖ) ^ k c * (s : wcGubGen W A) -
            algebraMap A (wcGubGen W A) (algebraMap ↥W A ϖ) ^ l c * (r : wcGubGen W A) =
          algebraMap A (wcGubGen W A) (algebraMap ↥W A ϖ) ^ m * (t : wcGubGen W A) :=
by
  intro Ω _ _ W hdimW hWt A _ _ ϖ 𝔪 g hAdm ζ hζg E N hN1 hE𝔪 hEE hEg x k hI hC
  classical

  have wcBde_cpl_map : ∀ (W : ValuationSubring Ω) (A : Type u)
      [CommRing A] [Algebra ↥W A] (ϖ : ↥W) (g g' : Fin 2 → A) (e e' : ↥W)
      (h : wcGubBox W A g e ≤ wcGubBox W A g' e'),
      ∃ ρ : wcGubCpl W A g ϖ e →+* wcGubCpl W A g' ϖ e',
        (∀ a : A, ρ (algebraMap A (wcGubCpl W A g ϖ e) a) =
          algebraMap A (wcGubCpl W A g' ϖ e') a) ∧
        ∀ (n : ℕ) (u : wcGubCpl W A g ϖ e) (s : ↥(wcGubBox W A g e)),
          Ideal.Quotient.mk (wcGubIdl W A g ϖ e ^ n) s =
            AdicCompletion.evalₐ (wcGubIdl W A g ϖ e) n u →
          Ideal.Quotient.mk (wcGubIdl W A g' ϖ e' ^ n) (Subalgebra.inclusion h s) =
            AdicCompletion.evalₐ (wcGubIdl W A g' ϖ e') n (ρ u) := by
    intro W A _ _ ϖ g g' e e' h
    have H : ∀ n : ℕ, wcGubIdl W A g ϖ e ^ n ≤
        Ideal.comap (Subalgebra.inclusion h).toRingHom (wcGubIdl W A g' ϖ e' ^ n) := by
      intro n
      rw [Ideal.span_singleton_pow, Ideal.span_le, Set.singleton_subset_iff]
      show (Subalgebra.inclusion h) (algebraMap A ↥(wcGubBox W A g e) (algebraMap ↥W A ϖ) ^ n) ∈
        wcGubIdl W A g' ϖ e' ^ n
      rw [map_pow, (Subalgebra.inclusion h).commutes]
      exact Ideal.pow_mem_pow (Ideal.mem_span_singleton_self _) n
    let f : (n : ℕ) → wcGubCpl W A g ϖ e →+*
        ↥(wcGubBox W A g' e') ⧸ wcGubIdl W A g' ϖ e' ^ n := fun n =>
      (Ideal.quotientMap (wcGubIdl W A g' ϖ e' ^ n) (Subalgebra.inclusion h).toRingHom
        (H n)).comp (AdicCompletion.evalₐ (wcGubIdl W A g ϖ e) n).toRingHom
    have hf : ∀ {m n : ℕ} (hle : m ≤ n),
        (Ideal.Quotient.factorPow (wcGubIdl W A g' ϖ e') hle).comp (f n) = f m := by
      intro m n hle
      ext u
      obtain ⟨s, rfl⟩ := AdicCompletion.mk_surjective (wcGubIdl W A g ϖ e) _ u
      simp only [f, RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
        AdicCompletion.evalₐ_mk, Ideal.quotientMap_mk]
      have h2 := s.2 hle
      rw [SModEq.sub_mem] at h2
      have h3 : (s : ℕ → ↥(wcGubBox W A g e)) m - s n ∈ wcGubIdl W A g ϖ e ^ m := by
        simpa [smul_eq_mul, Ideal.mul_top] using h2
      rw [Ideal.Quotient.factorPow, Ideal.Quotient.factor_mk, Ideal.Quotient.eq]
      have h4 := H m h3
      rw [Ideal.mem_comap, map_sub] at h4
      have h5 := (wcGubIdl W A g' ϖ e' ^ m).neg_mem h4
      rwa [neg_sub] at h5
    refine ⟨AdicCompletion.liftRingHom (wcGubIdl W A g' ϖ e') f hf, ?_, ?_⟩
    · intro a
      apply AdicCompletion.ext_evalₐ
      intro n
      rw [AdicCompletion.evalₐ_liftRingHom]
      simp only [f, RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe]
      rw [IsScalarTower.algebraMap_apply A ↥(wcGubBox W A g e) (wcGubCpl W A g ϖ e),
        AlgHom.commutes, Ideal.Quotient.algebraMap_eq, Ideal.quotientMap_mk,
        IsScalarTower.algebraMap_apply A ↥(wcGubBox W A g' e') (wcGubCpl W A g' ϖ e'),
        AlgHom.commutes, Ideal.Quotient.algebraMap_eq]
      exact congrArg (Ideal.Quotient.mk (wcGubIdl W A g' ϖ e' ^ n))
        ((Subalgebra.inclusion h).commutes a)
    · intro n u s hs
      rw [AdicCompletion.evalₐ_liftRingHom]
      simp only [f, RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe]
      rw [← hs, Ideal.quotientMap_mk]
      rfl
  have hϖ0 : ϖ ≠ 0 := hAdm.1
  have hϖm : ϖ ∈ IsLocalRing.maximalIdeal ↥W := hAdm.2.1
  have htf : ∀ (w : ↥W) (a : A), w ≠ 0 → algebraMap ↥W A w * a = 0 → a = 0 :=
    hAdm.2.2.2.2.2.1
  have hnu : ∀ c : ↥W, c ∈ IsLocalRing.maximalIdeal ↥W → ¬ IsUnit c := fun c hc =>
    mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal c).mp hc)

  have hdivpow : ∀ b : ↥W, b ≠ 0 → ∀ a ∈ IsLocalRing.maximalIdeal ↥W,
      ∃ K : ℕ, ∃ u : ↥W, a ^ K = u * b := by
    intro b hb0 a ha
    haveI : Ring.KrullDimLE 1 ↥W := Ring.krullDimLE_iff.mpr hdimW
    have hle : IsLocalRing.maximalIdeal ↥W ≤ (Ideal.span {b}).radical := by
      rw [Ideal.radical_eq_sInf]
      refine le_sInf ?_
      rintro P ⟨hPb, hPp⟩
      have hP0 : P ≠ ⊥ := by
        intro h
        apply hb0
        have : b ∈ P := hPb (Ideal.mem_span_singleton_self b)
        rw [h] at this
        exact (Submodule.mem_bot _).mp this
      haveI := hPp
      have hPmax : P.IsMaximal := Ideal.isMaximal_of_isPrime_of_ne_bot P hP0
      exact le_of_eq (IsLocalRing.eq_maximalIdeal hPmax).symm
    obtain ⟨K, hK⟩ := hle ha
    obtain ⟨u, hu⟩ := Ideal.mem_span_singleton'.mp hK
    exact ⟨K, u, hu.symm⟩
  have hdivϖ : ∀ w : ↥W, w ≠ 0 → ∃ (K : ℕ) (u : ↥W), ϖ ^ K = u * w :=
    fun w hw => hdivpow w hw ϖ hϖm

  have hroot : ∀ δ : ↥W, δ ≠ 0 → δ ∈ IsLocalRing.maximalIdeal ↥W →
      ∃ γ : ↥W, γ ≠ 0 ∧ γ ∈ IsLocalRing.maximalIdeal ↥W ∧ γ ^ N = δ := by
    intro δ hδ0 hδm
    obtain ⟨M, hM⟩ : ∃ M, N = M + 1 := ⟨N - 1, by omega⟩
    obtain ⟨β, hβ⟩ := IsAlgClosed.exists_pow_nat_eq (δ : Ω) (by omega : 0 < N)
    have hβ0 : β ≠ 0 := by
      rintro rfl
      apply hδ0
      apply Subtype.ext
      rw [← hβ, zero_pow (by omega)]
      rfl
    have hβW : β ∈ W := by
      rcases W.mem_or_inv_mem β with h | h
      · exact h
      · have e : β = (δ : Ω) * β⁻¹ ^ M := by
          rw [← hβ, hM, pow_succ, mul_comm (β ^ M) β, mul_assoc, ← mul_pow,
            mul_inv_cancel₀ hβ0, one_pow, mul_one]
        rw [e]
        exact mul_mem δ.2 (pow_mem h M)
    have hγN : (⟨β, hβW⟩ : ↥W) ^ N = δ := by
      apply Subtype.ext
      rw [SubmonoidClass.coe_pow]
      exact hβ
    refine ⟨⟨β, hβW⟩, ?_, ?_, hγN⟩
    · intro h
      apply hβ0
      have := congrArg Subtype.val h
      simpa using this
    · rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      intro hu
      apply hnu δ hδm
      rw [← hγN]
      exact hu.pow N

  have hpowdvd : ∀ a b : ↥W, a ^ N ∣ b ^ N → a ∣ b := by
    intro a b hab
    rcases ValuationRing.dvd_total a b with h | ⟨t, ht⟩
    · exact h
    · by_cases hb : b = 0
      · rw [hb]; exact dvd_zero a
      · obtain ⟨s, hs⟩ := hab
        have h1 : b ^ N * (t ^ N * s) = b ^ N * 1 := by
          calc b ^ N * (t ^ N * s) = (b * t) ^ N * s := by ring
            _ = a ^ N * s := by rw [ht]
            _ = b ^ N := hs.symm
            _ = b ^ N * 1 := (mul_one _).symm
        have h2 : t ^ N * s = 1 := mul_left_cancel₀ (pow_ne_zero N hb) h1
        have htu : IsUnit t :=
          (isUnit_pow_iff (by omega : N ≠ 0)).mp (isUnit_of_dvd_one ⟨s, h2.symm⟩)
        rw [ht]
        exact (IsUnit.mul_right_dvd htu).mpr dvd_rfl

  have hCt : ∀ (g' : Fin 2 → A) (e w : ↥W) (y : wcGubCpl W A g' ϖ e), w ≠ 0 →
      algebraMap A (wcGubCpl W A g' ϖ e) (algebraMap ↥W A w) * y = 0 → y = 0 :=
    fun g' e w y hw h => wcBde_cpl_torsionfree W A ϖ hϖ0 hdivϖ g' e w y hw h

  have hunit : ∀ w : ↥W, w ≠ 0 → IsUnit (algebraMap A (wcGubGen W A) (algebraMap ↥W A w)) :=
    fun w hw => IsLocalization.map_units (wcGubGen W A)
      (⟨algebraMap (↥W) A w, Submonoid.mem_map_of_mem _ (mem_nonZeroDivisors_of_ne_zero hw)⟩ :
        Submonoid.map (algebraMap (↥W) A) (nonZeroDivisors ↥W))

  have hboxmono : ∀ (g' : Fin 2 → A) (a b : ↥W), a ≠ 0 → a ∣ b → b ≠ 0 →
      wcGubBox W A g' a ≤ wcGubBox W A g' b := by
    intro g' a b ha hab hb
    obtain ⟨q, rfl⟩ := hab
    have hq : q ≠ 0 := right_ne_zero_of_mul hb
    apply Algebra.adjoin_le
    rintro _ ⟨i, rfl⟩
    show algebraMap A (wcGubGen W A) (g' i) *
        Ring.inverse (algebraMap A (wcGubGen W A) (algebraMap (↥W) A a)) ∈ wcGubBox W A g' (a * q)
    have e1 : algebraMap A (wcGubGen W A) (g' i) *
        Ring.inverse (algebraMap A (wcGubGen W A) (algebraMap ↥W A a)) =
      algebraMap A (wcGubGen W A) (algebraMap ↥W A q) *
        (algebraMap A (wcGubGen W A) (g' i) *
          Ring.inverse (algebraMap A (wcGubGen W A) (algebraMap ↥W A (a * q)))) := by
      obtain ⟨ua, hua⟩ := hunit a ha
      obtain ⟨uq, huq⟩ := hunit q hq
      rw [map_mul (algebraMap ↥W A), map_mul (algebraMap A (wcGubGen W A)), ← hua, ← huq,
        ← Units.val_mul, Ring.inverse_unit, Ring.inverse_unit, mul_inv_rev, Units.val_mul]
      have := Units.mul_inv uq
      linear_combination (-(algebraMap A (wcGubGen W A) (g' i) * ↑ua⁻¹)) * this
    rw [e1]
    exact Subalgebra.mul_mem _ (Subalgebra.algebraMap_mem _ _) (Algebra.subset_adjoin ⟨i, rfl⟩)

  have hevA : ∀ (g' : Fin 2 → A) (e : ↥W) (m : ℕ) (a : A),
      AdicCompletion.evalₐ (wcGubIdl W A g' ϖ e) m (algebraMap A (wcGubCpl W A g' ϖ e) a) =
        Ideal.Quotient.mk (wcGubIdl W A g' ϖ e ^ m) (algebraMap A ↥(wcGubBox W A g' e) a) := by
    intro g' e m a
    rw [IsScalarTower.algebraMap_apply A ↥(wcGubBox W A g' e) (wcGubCpl W A g' ϖ e),
      AlgHom.commutes, Ideal.Quotient.algebraMap_eq]
  have htrans : ∀ (g' : Fin 2 → A) (e : ↥W) (p q m : ℕ) (y y' : wcGubCpl W A g' ϖ e)
      (s s' : ↥(wcGubBox W A g' e)),
      algebraMap A (wcGubCpl W A g' ϖ e) (algebraMap ↥W A ϖ) ^ p * y =
        algebraMap A (wcGubCpl W A g' ϖ e) (algebraMap ↥W A ϖ) ^ q * y' →
      Ideal.Quotient.mk (wcGubIdl W A g' ϖ e ^ m) s =
        AdicCompletion.evalₐ (wcGubIdl W A g' ϖ e) m y →
      Ideal.Quotient.mk (wcGubIdl W A g' ϖ e ^ m) s' =
        AdicCompletion.evalₐ (wcGubIdl W A g' ϖ e) m y' →
      ∃ t : ↥(wcGubBox W A g' e),
        algebraMap A (wcGubGen W A) (algebraMap ↥W A ϖ) ^ p * (s : wcGubGen W A) -
          algebraMap A (wcGubGen W A) (algebraMap ↥W A ϖ) ^ q * (s' : wcGubGen W A) =
        algebraMap A (wcGubGen W A) (algebraMap ↥W A ϖ) ^ m * (t : wcGubGen W A) := by
    intro g' e p q m y y' s s' hyy hs hs'
    have hsp : wcGubIdl W A g' ϖ e ^ m =
        Ideal.span {algebraMap A ↥(wcGubBox W A g' e) (algebraMap (↥W) A ϖ) ^ m} :=
      Ideal.span_singleton_pow _ m
    have h1 : Ideal.Quotient.mk (wcGubIdl W A g' ϖ e ^ m)
          (algebraMap A ↥(wcGubBox W A g' e) (algebraMap ↥W A ϖ) ^ p * s) =
        Ideal.Quotient.mk (wcGubIdl W A g' ϖ e ^ m)
          (algebraMap A ↥(wcGubBox W A g' e) (algebraMap ↥W A ϖ) ^ q * s') := by
      have h := congrArg (AdicCompletion.evalₐ (wcGubIdl W A g' ϖ e) m) hyy
      simp only [map_mul, map_pow, hevA, ← hs, ← hs'] at h
      simpa only [map_mul, map_pow] using h
    rw [Ideal.Quotient.eq, hsp, Ideal.mem_span_singleton'] at h1
    obtain ⟨t, ht⟩ := h1
    refine ⟨t, ?_⟩
    have hv := congrArg Subtype.val ht
    simp only [Subalgebra.coe_mul, Subalgebra.coe_pow, Subalgebra.coe_sub,
      Subalgebra.coe_algebraMap] at hv
    linear_combination -hv

  have key : ∀ e : ↥W, ∃ (δ γ : ↥W) (ε : wcGubCpl W A (fun _ : Fin 2 => ζ) ϖ e)
      (Ψ : ↥(wcGubBox W A g γ) → wcGubCpl W A (fun _ : Fin 2 => ζ) ϖ e)
      (z : wcGubCpl W A (fun _ : Fin 2 => ζ) ϖ e),
      e ≠ 0 → e ∈ IsLocalRing.maximalIdeal ↥W →
      (ϖ ∣ e → δ = ϖ) ∧ (¬ ϖ ∣ e → δ = e) ∧ γ ≠ 0 ∧ γ ∈ IsLocalRing.maximalIdeal ↥W ∧
      γ ^ N = δ ∧ ε * ε = ε ∧
      (∀ n : ℕ, ∃ K₀ : ℕ, ∀ K : ℕ, K₀ ≤ K →
        Ideal.Quotient.mk (wcGubIdl W A (fun _ : Fin 2 => ζ) ϖ e ^ n)
            (algebraMap A ↥(wcGubBox W A (fun _ : Fin 2 => ζ) e) (wcBdeNewt E K)) =
          AdicCompletion.evalₐ (wcGubIdl W A (fun _ : Fin 2 => ζ) ϖ e) n ε) ∧
      wcBdeRel W A ϖ g γ (wcGubCpl W A (fun _ : Fin 2 => ζ) ϖ e) Ψ ε (2 * (N - 1)) ∧
      (∀ (n : ℕ) (r : ↥(wcGubBox W A g γ)),
        Ideal.Quotient.mk (wcGubIdl W A g ϖ γ ^ n) r =
          AdicCompletion.evalₐ (wcGubIdl W A g ϖ γ) n (x γ) →
        AdicCompletion.evalₐ (wcGubIdl W A (fun _ : Fin 2 => ζ) ϖ e) n z =
          AdicCompletion.evalₐ (wcGubIdl W A (fun _ : Fin 2 => ζ) ϖ e) n (Ψ r)) ∧
      z * z = algebraMap A (wcGubCpl W A (fun _ : Fin 2 => ζ) ϖ e) (algebraMap ↥W A ϖ) ^
        (2 * (N - 1) + k γ) * z := by
    intro e
    by_cases hgood : e ≠ 0 ∧ e ∈ IsLocalRing.maximalIdeal ↥W
    swap
    · exact ⟨0, 0, 0, fun _ => 0, 0, fun h1 h2 => absurd ⟨h1, h2⟩ hgood⟩
    obtain ⟨he0, hem⟩ := hgood
    obtain ⟨δ, π₁, π₂, hδ0, hδm, hϖδ, heδ, hδ1, hδ2⟩ : ∃ δ π₁ π₂ : ↥W, δ ≠ 0 ∧
        δ ∈ IsLocalRing.maximalIdeal ↥W ∧ ϖ = δ * π₁ ∧ e = δ * π₂ ∧
        (ϖ ∣ e → δ = ϖ) ∧ (¬ ϖ ∣ e → δ = e) := by
      by_cases hϖe : ϖ ∣ e
      · obtain ⟨π₂, hπ₂⟩ := hϖe
        exact ⟨ϖ, 1, π₂, hϖ0, hϖm, (mul_one ϖ).symm, hπ₂, fun _ => rfl,
          fun h => absurd ⟨π₂, hπ₂⟩ h⟩
      · obtain ⟨π₁, hπ₁⟩ := (ValuationRing.dvd_total ϖ e).resolve_left hϖe
        exact ⟨e, π₁, 1, he0, hem, hπ₁, (mul_one e).symm, fun h => absurd h hϖe, fun _ => rfl⟩
    obtain ⟨Ke, ue, hKe⟩ := hdivpow ϖ hϖ0 e hem
    obtain ⟨γ, hγ0, hγm, hγN⟩ := hroot δ hδ0 hδm
    have hϖγ : ϖ = γ * (γ ^ (N - 1) * π₁) := by
      have h1 : γ ^ N = γ * γ ^ (N - 1) := by
        rw [← pow_succ']; congr 1; omega
      rw [hϖδ, ← hγN, h1, mul_assoc]
    obtain ⟨ε, v, hεε, hv, hεK⟩ := wcBde_newton_idem W A ϖ g ζ E N e δ π₁ π₂ Ke ue hϖ0 hN1
      hEE hEg he0 hKe hδ0 hϖδ heδ
    have hv' : ∀ i : Fin 2, algebraMap A (wcGubCpl W A (fun _ : Fin 2 => ζ) ϖ e)
        (algebraMap ↥W A γ) ^ N * v i =
        (ε * algebraMap A (wcGubCpl W A (fun _ : Fin 2 => ζ) ϖ e) (g i)) ^ N := by
      intro i
      rw [← map_pow, ← map_pow, hγN]
      exact hv i
    obtain ⟨Ψ, hΨ⟩ := wcBde_psi_exists W A ϖ g (wcGubCpl W A (fun _ : Fin 2 => ζ) ϖ e) htf
      (hCt (fun _ : Fin 2 => ζ) e) γ (γ ^ (N - 1) * π₁) N hγ0 hϖγ hN1 ε v hεε hv'
    obtain ⟨hadd, hlin, hmul, -⟩ := wcBde_psi_calculus W A ϖ g
      (wcGubCpl W A (fun _ : Fin 2 => ζ) ϖ e) htf (hCt (fun _ : Fin 2 => ζ) e) γ hγ0 Ψ ε
      (2 * (N - 1)) hΨ
    obtain ⟨z, hz⟩ := wcBde_limit W A ϖ g (fun _ : Fin 2 => ζ) e γ (x γ) Ψ hadd hlin
    have hzz := wcBde_idem_from_limit W A ϖ g (fun _ : Fin 2 => ζ) e γ (k γ) (2 * (N - 1))
      (x γ) Ψ z hadd hlin (hmul hεε) (hI γ hγ0 hγm) hz
    exact ⟨δ, γ, ε, Ψ, z, fun _ _ => ⟨hδ1, hδ2, hγ0, hγm, hγN, hεε, hεK, hΨ, hz, hzz⟩⟩
  choose δf γf εf Ψf zf hP using key
  refine ⟨zf, fun e => 2 * (N - 1) + k (γf e), ?_, ?_, ?_⟩
  ·
    intro e he0 hem
    obtain ⟨-, -, -, -, -, -, -, -, -, hzz⟩ := hP e he0 hem
    exact hzz
  ·
    intro c c' hc0 hcm hc'0 hc'm hcc' m s s' hs hs'
    obtain ⟨hδ1, hδ2, hγ0, hγm, hγN, -, hεK, hrel, hz, -⟩ := hP c hc0 hcm
    obtain ⟨hδ1', hδ2', hγ0', hγm', hγN', -, hεK', hrel', hz', -⟩ := hP c' hc'0 hc'm
    have hδdvd : δf c ∣ δf c' := by
      by_cases h1 : ϖ ∣ c
      · rw [hδ1 h1, hδ1' (dvd_trans h1 hcc')]
      · rw [hδ2 h1]
        by_cases h2 : ϖ ∣ c'
        · rw [hδ1' h2]; exact (ValuationRing.dvd_total ϖ c).resolve_left h1
        · rw [hδ2' h2]; exact hcc'
    have hγdvd : γf c ∣ γf c' := hpowdvd _ _ (by rw [hγN, hγN']; exact hδdvd)
    have hled : wcGubBox W A (fun _ : Fin 2 => ζ) c ≤ wcGubBox W A (fun _ : Fin 2 => ζ) c' :=
      hboxmono _ c c' hc0 hcc' hc'0
    have hleg : wcGubBox W A g (γf c) ≤ wcGubBox W A g (γf c') :=
      hboxmono g _ _ hγ0 hγdvd hγ0'
    obtain ⟨ρ, hρa, hρl⟩ :=
      wcBde_cpl_map W A ϖ (fun _ : Fin 2 => ζ) (fun _ : Fin 2 => ζ) c c' hled
    have hρε : ρ (εf c) = εf c' := by
      apply AdicCompletion.ext_evalₐ
      intro n
      obtain ⟨K₀, hK₀⟩ := hεK n
      obtain ⟨K₁, hK₁⟩ := hεK' n
      rw [← hρl n (εf c) _ (hK₀ (max K₀ K₁) (le_max_left _ _)),
        (Subalgebra.inclusion hled).commutes]
      exact hK₁ (max K₀ K₁) (le_max_right _ _)
    obtain ⟨-, -, -, htr⟩ := wcBde_psi_calculus W A ϖ g
      (wcGubCpl W A (fun _ : Fin 2 => ζ) ϖ c) htf (hCt (fun _ : Fin 2 => ζ) c) (γf c) hγ0
      (Ψf c) (εf c) _ hrel
    obtain ⟨hadd', hlin', -, -⟩ := wcBde_psi_calculus W A ϖ g
      (wcGubCpl W A (fun _ : Fin 2 => ζ) ϖ c') htf (hCt (fun _ : Fin 2 => ζ) c') (γf c') hγ0'
      (Ψf c') (εf c') _ hrel'
    have hρΨ := htr (wcGubCpl W A (fun _ : Fin 2 => ζ) ϖ c') (hCt (fun _ : Fin 2 => ζ) c') ρ hρa
      (γf c') hleg (Ψf c') (εf c') hrel' hρε
    have hz'0 : ∀ (n : ℕ) (r' : ↥(wcGubBox W A g (γf c'))),
        Ideal.Quotient.mk (wcGubIdl W A g ϖ (γf c') ^ n) r' =
          AdicCompletion.evalₐ (wcGubIdl W A g ϖ (γf c')) n (x (γf c')) →
        AdicCompletion.evalₐ (wcGubIdl W A (fun _ : Fin 2 => ζ) ϖ c') n
            (algebraMap A (wcGubCpl W A (fun _ : Fin 2 => ζ) ϖ c') (algebraMap ↥W A ϖ) ^ 0 *
              zf c') =
          AdicCompletion.evalₐ (wcGubIdl W A (fun _ : Fin 2 => ζ) ϖ c') n (Ψf c' r') := by
      intro n r' hr'
      rw [pow_zero, one_mul]
      exact hz' n r' hr'
    have hres := wcBde_restrict_identity W A ϖ g (fun _ : Fin 2 => ζ) (fun _ : Fin 2 => ζ) c c'
      hled (γf c) (γf c') hleg (x (γf c)) (x (γf c')) (k (γf c)) (k (γf c')) 0 (Ψf c) (Ψf c') ρ
      (zf c) (zf c') hadd' hlin' hρl hρΨ hz hz'0 (hC (γf c) (γf c') hγ0 hγm hγ0' hγm' hγdvd)
    have hres' : algebraMap A (wcGubCpl W A (fun _ : Fin 2 => ζ) ϖ c') (algebraMap ↥W A ϖ) ^
          (2 * (N - 1) + k (γf c')) * ρ (zf c) =
        algebraMap A (wcGubCpl W A (fun _ : Fin 2 => ζ) ϖ c') (algebraMap ↥W A ϖ) ^
          (2 * (N - 1) + k (γf c)) * zf c' := by
      rw [pow_add, pow_add, mul_assoc, mul_assoc, hres, zero_add]
    exact htrans (fun _ : Fin 2 => ζ) c' _ _ m (ρ (zf c)) (zf c') (Subalgebra.inclusion hled s) s'
      hres' (hρl m (zf c) s hs) hs'
  ·
    intro c hc0 hcm m s r hs hr
    obtain ⟨hδ1, hδ2, hγ0, hγm, hγN, -, hεK, hrel, hz, -⟩ := hP c hc0 hcm
    have hle : wcGubBox W A (fun _ : Fin 2 => ζ) c ≤ wcGubBox W A g c := by
      apply Algebra.adjoin_le
      rintro _ ⟨i, rfl⟩
      show algebraMap A (wcGubGen W A) ζ *
          Ring.inverse (algebraMap A (wcGubGen W A) (algebraMap (↥W) A c)) ∈ wcGubBox W A g c
      obtain ⟨b, hb⟩ := (Ideal.mem_span_range_iff_exists_fun).mp hζg
      rw [← hb, map_sum, Finset.sum_mul]
      refine Subalgebra.sum_mem _ (fun j _ => ?_)
      rw [map_mul, mul_assoc]
      exact Subalgebra.mul_mem _ (Subalgebra.algebraMap_mem _ _) (Algebra.subset_adjoin ⟨j, rfl⟩)
    have hγc : γf c ∣ c := by
      have h1 : γf c ∣ δf c := by rw [← hγN]; exact dvd_pow_self _ (by omega)
      refine dvd_trans h1 ?_
      by_cases h : ϖ ∣ c
      · rw [hδ1 h]; exact h
      · simp only [hδ2 h, dvd_refl]
    have hleg : wcGubBox W A g (γf c) ≤ wcGubBox W A g c := hboxmono g _ _ hγ0 hγc hc0
    obtain ⟨ρ, hρa, hρl⟩ := wcBde_cpl_map W A ϖ (fun _ : Fin 2 => ζ) g c c hle
    have hρε : ρ (εf c) = 1 := by
      apply AdicCompletion.ext_evalₐ
      intro n
      obtain ⟨K₀, hK₀⟩ := hεK n
      obtain ⟨K₁, hK₁⟩ := wcBde_newton_box_one W A ϖ 𝔪 g hdimW hAdm c hc0 hcm E hE𝔪 n
      rw [← hρl n (εf c) _ (hK₀ (max K₀ K₁) (le_max_left _ _)),
        (Subalgebra.inclusion hle).commutes, map_one,
        ← map_one (Ideal.Quotient.mk (wcGubIdl W A g ϖ c ^ n)), Ideal.Quotient.eq]
      exact hK₁ (max K₀ K₁) (le_max_right _ _)
    obtain ⟨Ψ', hΨ'⟩ : ∃ Ψ' : ↥(wcGubBox W A g c) → wcGubCpl W A g ϖ c, ∀ r,
        Ψ' r = algebraMap A (wcGubCpl W A g ϖ c) (algebraMap ↥W A ϖ) ^ (2 * (N - 1)) *
          algebraMap ↥(wcGubBox W A g c) (wcGubCpl W A g ϖ c) r := ⟨_, fun _ => rfl⟩
    have hrel' : wcBdeRel W A ϖ g c (wcGubCpl W A g ϖ c) Ψ' 1 (2 * (N - 1)) := by
      intro r' w a hw hra
      have hB : algebraMap A ↥(wcGubBox W A g c) (algebraMap ↥W A w) * r' =
          algebraMap A ↥(wcGubBox W A g c) a := by
        apply Subtype.ext
        simp only [Subalgebra.coe_mul, Subalgebra.coe_algebraMap]
        exact hra
      have hB' := congrArg (algebraMap ↥(wcGubBox W A g c) (wcGubCpl W A g ϖ c)) hB
      rw [map_mul, ← IsScalarTower.algebraMap_apply A ↥(wcGubBox W A g c) (wcGubCpl W A g ϖ c),
        ← IsScalarTower.algebraMap_apply A ↥(wcGubBox W A g c) (wcGubCpl W A g ϖ c)] at hB'
      rw [hΨ', mul_one, ← hB']
      ring
    obtain ⟨-, -, -, htr⟩ := wcBde_psi_calculus W A ϖ g
      (wcGubCpl W A (fun _ : Fin 2 => ζ) ϖ c) htf (hCt (fun _ : Fin 2 => ζ) c) (γf c) hγ0
      (Ψf c) (εf c) _ hrel
    obtain ⟨hadd', hlin', -, -⟩ := wcBde_psi_calculus W A ϖ g (wcGubCpl W A g ϖ c) htf
      (hCt g c) c hc0 Ψ' 1 _ hrel'
    have hρΨ := htr (wcGubCpl W A g ϖ c) (hCt g c) ρ hρa c hleg Ψ' 1 hrel' hρε
    have hzx : ∀ (n : ℕ) (r' : ↥(wcGubBox W A g c)),
        Ideal.Quotient.mk (wcGubIdl W A g ϖ c ^ n) r' =
          AdicCompletion.evalₐ (wcGubIdl W A g ϖ c) n (x c) →
        AdicCompletion.evalₐ (wcGubIdl W A g ϖ c) n
            (algebraMap A (wcGubCpl W A g ϖ c) (algebraMap ↥W A ϖ) ^ (2 * (N - 1)) * x c) =
          AdicCompletion.evalₐ (wcGubIdl W A g ϖ c) n (Ψ' r') := by
      intro n r' hr'
      rw [hΨ', map_mul, map_mul, AlgHom.commutes, Ideal.Quotient.algebraMap_eq, hr']
    have hres := wcBde_restrict_identity W A ϖ g (fun _ : Fin 2 => ζ) g c c hle (γf c) c hleg
      (x (γf c)) (x c) (k (γf c)) (k c) (2 * (N - 1)) (Ψf c) Ψ' ρ (zf c) (x c) hadd' hlin' hρl
      hρΨ hz hzx (hC (γf c) c hγ0 hγm hc0 hcm hγc)
    exact htrans g c (k c) (2 * (N - 1) + k (γf c)) m (ρ (zf c)) (x c)
      (Subalgebra.inclusion hle s) r hres (hρl m (zf c) s hs) hr

theorem wcpa_dj_lr1k_nsr_gub_bff_box_disc_bridge : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [Algebra ↥W A] (ϖ : ↥W) (𝔪 : Ideal A) (g : Fin 2 → A),
      wcGubAdm W A ϖ 𝔪 g →
    ∀ ζ : A, ζ ∈ Ideal.span (Set.range g) → wcBffNoether W A ζ →
    ∀ (x : ∀ c : ↥W, wcGubCpl W A g ϖ c) (k : ↥W → ℕ),
      wcGubIdem W A g ϖ x k → wcGubCompat W A g ϖ x k →
    ∃ (z : ∀ e : ↥W, wcGubCpl W A (fun _ : Fin 2 => ζ) ϖ e) (l : ↥W → ℕ),
      wcGubIdem W A (fun _ : Fin 2 => ζ) ϖ z l ∧ wcGubCompat W A (fun _ : Fin 2 => ζ) ϖ z l ∧
      ∀ y : AdicCompletion (Ideal.span {algebraMap ↥W A ϖ, ζ}) A, IsIdempotentElem y →
        wcBffRep W A ϖ (Ideal.span {algebraMap ↥W A ϖ, ζ}) (fun _ : Fin 2 => ζ) y z l →
        wcBffRep W A ϖ (Ideal.span {algebraMap ↥W A ϖ, ζ}) g y x k :=
by
  intro Ω _ _ W hdimW hWt A _ _ ϖ 𝔪 g hAdm ζ hζg hζN x k hI hC
  obtain ⟨E, N, hN1, hE𝔪, hEE, hEg⟩ :=
    wcpa_dj_lr1k_nsr_gub_bdb_split_element Ω W hdimW hWt A ϖ 𝔪 g hAdm ζ hζg hζN
  obtain ⟨z, l, hzI, hzC, hRI⟩ :=
    wcpa_dj_lr1k_nsr_gub_bdb_disc_extension Ω W hdimW hWt A ϖ 𝔪 g hAdm ζ hζg E N hN1 hE𝔪 hEE
      hEg x k hI hC
  refine ⟨z, l, hzI, hzC, ?_⟩
  intro y _hyid hyrep
  unfold wcBffRep at hyrep ⊢
  intro c hc0 hcm m
  have hϖ0 : ϖ ≠ 0 := hAdm.1
  have hpu : IsUnit (algebraMap A (wcGubGen W A) (algebraMap (↥W) A ϖ)) :=
    IsLocalization.map_units (wcGubGen W A)
      (⟨algebraMap (↥W) A ϖ, Submonoid.mem_map_of_mem _ (mem_nonZeroDivisors_of_ne_zero hϖ0)⟩ :
        Submonoid.map (algebraMap (↥W) A) (nonZeroDivisors ↥W))

  have hle : wcGubBox W A (fun _ : Fin 2 => ζ) c ≤ wcGubBox W A g c := by
    apply Algebra.adjoin_le
    rintro _ ⟨i, rfl⟩
    show algebraMap A (wcGubGen W A) ζ *
        Ring.inverse (algebraMap A (wcGubGen W A) (algebraMap (↥W) A c)) ∈ wcGubBox W A g c
    obtain ⟨b, hb⟩ := (Ideal.mem_span_range_iff_exists_fun).mp hζg
    rw [← hb, map_sum, Finset.sum_mul]
    refine Subalgebra.sum_mem _ (fun j _ => ?_)
    rw [map_mul, mul_assoc]
    exact Subalgebra.mul_mem _ (Subalgebra.algebraMap_mem _ _) (Algebra.subset_adjoin ⟨j, rfl⟩)
  obtain ⟨n, hn⟩ := hyrep c hc0 hcm (m + l c)
  refine ⟨n, fun a r ha hr => ?_⟩
  obtain ⟨s, hs⟩ := Ideal.Quotient.mk_surjective
    (AdicCompletion.evalₐ (wcGubIdl W A (fun _ : Fin 2 => ζ) ϖ c) (m + l c) (z c))
  obtain ⟨r', hr'⟩ := Ideal.Quotient.mk_surjective
    (AdicCompletion.evalₐ (wcGubIdl W A g ϖ c) (m + l c) (x c))
  obtain ⟨t₁, ht₁⟩ := hn a s ha hs
  obtain ⟨t₂, ht₂⟩ := hRI c hc0 hcm (m + l c) s r' hs hr'

  have h3 : ∃ t₃ : ↥(wcGubBox W A g c), (r' : wcGubGen W A) - (r : wcGubGen W A) =
      algebraMap A (wcGubGen W A) (algebraMap (↥W) A ϖ) ^ m * (t₃ : wcGubGen W A) := by
    obtain ⟨u, hu⟩ := AdicCompletion.mk_surjective (wcGubIdl W A g ϖ c) _ (x c)
    rw [← hu, AdicCompletion.evalₐ_mk, Ideal.Quotient.eq] at hr hr'
    have h2 := u.2 (Nat.le_add_right m (l c))
    rw [SModEq.sub_mem] at h2
    have h2' : u m - u (m + l c) ∈ wcGubIdl W A g ϖ c ^ m := by
      simpa [smul_eq_mul, Ideal.mul_top] using h2
    have h1 : r' - u (m + l c) ∈ wcGubIdl W A g ϖ c ^ m :=
      Ideal.pow_le_pow_right (Nat.le_add_right m (l c)) hr'
    have hsum : r' - r ∈ wcGubIdl W A g ϖ c ^ m := by
      have e : r' - r = (r' - u (m + l c)) - (r - u m) - (u m - u (m + l c)) := by ring
      rw [e]
      exact Ideal.sub_mem _ (Ideal.sub_mem _ h1 hr) h2'
    have hsum' : r' - r ∈ Ideal.span
        {algebraMap A ↥(wcGubBox W A g c) (algebraMap (↥W) A ϖ) ^ m} := by
      rw [← Ideal.span_singleton_pow]; exact hsum
    obtain ⟨a', ha'⟩ := Ideal.mem_span_singleton'.mp hsum'
    refine ⟨a', ?_⟩
    have hv := congrArg Subtype.val ha'
    simp only [Subalgebra.coe_mul, Subalgebra.coe_pow, Subalgebra.coe_sub,
      Subalgebra.coe_algebraMap] at hv
    rw [← hv]
    ring
  obtain ⟨t₃, ht₃⟩ := h3
  let t₁' : ↥(wcGubBox W A g c) := ⟨(t₁ : wcGubGen W A), hle t₁.2⟩
  have ht₁' : (t₁' : wcGubGen W A) = (t₁ : wcGubGen W A) := rfl
  refine ⟨algebraMap A ↥(wcGubBox W A g c) (algebraMap (↥W) A ϖ) ^ k c * t₁' + t₂ + t₃, ?_⟩
  apply (hpu.pow (l c)).mul_left_cancel
  simp only [Subalgebra.coe_mul, Subalgebra.coe_add, Subalgebra.coe_pow,
    Subalgebra.coe_algebraMap, ht₁']
  linear_combination algebraMap A (wcGubGen W A) (algebraMap (↥W) A ϖ) ^ k c * ht₁ + ht₂ +
    algebraMap A (wcGubGen W A) (algebraMap (↥W) A ϖ) ^ l c * ht₃

theorem wcpa_dj_lr1k_nsr_gub_bosch_formal_fibre : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [Algebra ↥W A] (ϖ : ↥W) (𝔪 : Ideal A) (g : Fin 2 → A),
      wcGubAdm W A ϖ 𝔪 g →
    ∀ (x : ∀ c : ↥W, wcGubCpl W A g ϖ c) (k : ↥W → ℕ),
      wcGubIdem W A g ϖ x k → wcGubCompat W A g ϖ x k → wcGubConst W A g ϖ x k :=
by
  intro Ω _ _ W hdimW hWt A _ _ ϖ 𝔪 g hAdm x k hI hC
  have hAdm' := hAdm
  obtain ⟨hϖ0, hϖm, hdom, hic, hfp, htf, hN1, hdim, h𝔪max, hm𝔪, hg𝔪, hrad⟩ := hAdm'
  have hbase : wcBffBase W A ϖ := ⟨hϖ0, hϖm, hdom, hic, hfp, htf, hN1, hdim⟩
  obtain ⟨ζ, hζg, hζN⟩ :=
    wcpa_dj_lr1k_nsr_gub_bff_noether_param Ω W hdimW hWt A ϖ 𝔪 g hAdm
  set J : Ideal A := Ideal.span {algebraMap (↥W) A ϖ, ζ} with hJ
  obtain ⟨z, l, hzI, hzC, hrep⟩ :=
    wcpa_dj_lr1k_nsr_gub_bff_box_disc_bridge Ω W hdimW hWt A ϖ 𝔪 g hAdm ζ hζg hζN x k hI hC
  obtain ⟨y, hyid, hyrep⟩ :=
    wcpa_dj_lr1k_nsr_gub_bff_disc_completion Ω W hdimW hWt A ϖ ζ hbase hζN z l hzI hzC
  have hxrep : wcBffRep W A ϖ J g y x k := hrep y hyid hyrep

  have hpow : ∀ w ∈ IsLocalRing.maximalIdeal ↥W, ∃ K : ℕ, ∃ u : ↥W, w ^ K = u * ϖ := by
    intro w hw
    haveI : Ring.KrullDimLE 1 ↥W := Ring.krullDimLE_iff.mpr hdimW
    have hle : IsLocalRing.maximalIdeal ↥W ≤ (Ideal.span {ϖ}).radical := by
      rw [Ideal.radical_eq_sInf]
      refine le_sInf ?_
      rintro P ⟨hPϖ, hPp⟩
      have hP0 : P ≠ ⊥ := by
        intro h
        apply hϖ0
        have : ϖ ∈ P := hPϖ (Ideal.mem_span_singleton_self ϖ)
        rw [h] at this
        exact (Submodule.mem_bot _).mp this
      haveI := hPp
      have hPmax : P.IsMaximal := Ideal.isMaximal_of_isPrime_of_ne_bot P hP0
      exact le_of_eq (IsLocalRing.eq_maximalIdeal hPmax).symm
    obtain ⟨K, hK⟩ := hle hw
    obtain ⟨u, hu⟩ := Ideal.mem_span_singleton'.mp hK
    exact ⟨K, u, hu.symm⟩

  have hQ : ∀ c : ↥W, c ≠ 0 → c ∈ IsLocalRing.maximalIdeal ↥W → ∀ b ∈ 𝔪, ∃ L : ℕ,
      ∃ t : ↥(wcGubBox W A g c), algebraMap A ↥(wcGubBox W A g c) b ^ L =
        t * algebraMap A ↥(wcGubBox W A g c) (algebraMap (↥W) A ϖ) := by
    intro c hc0 hcm b hb
    set P : Ideal A := Ideal.comap (algebraMap A ↥(wcGubBox W A g c))
      (Ideal.span {algebraMap A ↥(wcGubBox W A g c) (algebraMap (↥W) A ϖ)}).radical with hPdef
    have hPrad : P.radical = P := by
      rw [hPdef, Ideal.comap_radical, Ideal.radical_idem]
    have hunit : IsUnit (algebraMap A (wcGubGen W A) (algebraMap (↥W) A c)) :=
      IsLocalization.map_units (wcGubGen W A)
        (⟨algebraMap (↥W) A c, Submonoid.mem_map_of_mem _ (mem_nonZeroDivisors_of_ne_zero hc0)⟩ :
          Submonoid.map (algebraMap (↥W) A) (nonZeroDivisors ↥W))
    have hgP : Ideal.span (Set.range g) ≤ P := by
      rw [Ideal.span_le]
      rintro _ ⟨i, rfl⟩
      obtain ⟨K, u, hu⟩ := hpow c hcm
      let q : ↥(wcGubBox W A g c) :=
        ⟨algebraMap A (wcGubGen W A) (g i) *
          Ring.inverse (algebraMap A (wcGubGen W A) (algebraMap (↥W) A c)),
          Algebra.subset_adjoin ⟨i, rfl⟩⟩
      have hq : algebraMap A ↥(wcGubBox W A g c) (g i) =
          algebraMap A ↥(wcGubBox W A g c) (algebraMap (↥W) A c) * q := by
        apply Subtype.ext
        simp only [Subalgebra.coe_mul, Subalgebra.coe_algebraMap, q]
        rw [← mul_assoc, mul_comm (algebraMap A (wcGubGen W A) (algebraMap (↥W) A c))
          (algebraMap A (wcGubGen W A) (g i)), mul_assoc, Ring.mul_inverse_cancel _ hunit,
          mul_one]
      have hcK : algebraMap A ↥(wcGubBox W A g c) (algebraMap (↥W) A c) ^ K =
          algebraMap A ↥(wcGubBox W A g c) (algebraMap (↥W) A u) *
            algebraMap A ↥(wcGubBox W A g c) (algebraMap (↥W) A ϖ) := by
        rw [← map_pow, ← map_pow, hu, map_mul, map_mul]
      show g i ∈ P
      rw [hPdef, Ideal.mem_comap]
      refine ⟨K, ?_⟩
      rw [hq, mul_pow, hcK]
      exact Ideal.mul_mem_right _ _ (Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _))
    have hmP : (IsLocalRing.maximalIdeal ↥W).map (algebraMap (↥W) A) ≤ P := by
      rw [Ideal.map_le_iff_le_comap]
      intro w hw
      obtain ⟨K, u, hu⟩ := hpow w hw
      rw [Ideal.mem_comap, hPdef, Ideal.mem_comap]
      refine ⟨K, ?_⟩
      rw [← map_pow, ← map_pow, hu, map_mul, map_mul]
      exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _)
    have h𝔪P : 𝔪 ≤ P := by
      calc 𝔪 = (Ideal.span (Set.range g) ⊔
            (IsLocalRing.maximalIdeal ↥W).map (algebraMap (↥W) A)).radical := hrad.symm
        _ ≤ P.radical := Ideal.radical_mono (sup_le hgP hmP)
        _ = P := hPrad
    have hb' := h𝔪P hb
    rw [hPdef, Ideal.mem_comap] at hb'
    obtain ⟨L, hL⟩ := hb'
    obtain ⟨t, ht⟩ := Ideal.mem_span_singleton'.mp hL
    exact ⟨L, t, ht.symm⟩

  have htrans : ∀ (n N : ℕ), n ≤ N → ∀ a : A,
      Ideal.Quotient.mk (J ^ N) a = AdicCompletion.evalₐ J N y →
      Ideal.Quotient.mk (J ^ n) a = AdicCompletion.evalₐ J n y := by
    intro n N hnN a ha
    obtain ⟨s, hs⟩ := AdicCompletion.mk_surjective J A y
    rw [← hs, AdicCompletion.evalₐ_mk] at ha ⊢
    rw [Ideal.Quotient.eq] at ha ⊢
    have h1 : a - s N ∈ J ^ n := Ideal.pow_le_pow_right hnN ha
    have h2 := s.2 hnN
    rw [SModEq.sub_mem] at h2
    have h3 : s n - s N ∈ J ^ n := by simpa [smul_eq_mul, Ideal.mul_top] using h2
    have : a - s n = (a - s N) - (s n - s N) := by ring
    rw [this]
    exact Ideal.sub_mem _ h1 h3
  have hJ𝔪 : J ≤ 𝔪 := by
    rw [hJ, Ideal.span_le]
    intro w hw
    rcases hw with rfl | rfl
    · exact hm𝔪 (Ideal.mem_map_of_mem _ hϖm)
    · exact (Ideal.span_le.mpr (by rintro _ ⟨i, rfl⟩; exact hg𝔪 i)) hζg
  have hev : ∀ (c : ↥W) (m : ℕ) (w : A),
      AdicCompletion.evalₐ (wcGubIdl W A g ϖ c) m (algebraMap A (wcGubCpl W A g ϖ c) w) =
        Ideal.Quotient.mk (wcGubIdl W A g ϖ c ^ m) (algebraMap A ↥(wcGubBox W A g c) w) := by
    intro c m w
    rw [IsScalarTower.algebraMap_apply A ↥(wcGubBox W A g c) (wcGubCpl W A g ϖ c),
      AlgHom.commutes, Ideal.Quotient.algebraMap_eq]
  have hspan : ∀ (c : ↥W) (m : ℕ), wcGubIdl W A g ϖ c ^ m =
      Ideal.span {algebraMap A ↥(wcGubBox W A g c) (algebraMap (↥W) A ϖ) ^ m} :=
    fun c m => Ideal.span_singleton_pow _ m

  obtain ⟨a₁, ha₁⟩ := Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ J 1 y)
  have hidem1 : a₁ * a₁ - a₁ ∈ J := by
    have : Ideal.Quotient.mk (J ^ 1) (a₁ * a₁) = Ideal.Quotient.mk (J ^ 1) a₁ := by
      rw [map_mul, ha₁, ← map_mul, hyid.eq]
    rw [Ideal.Quotient.eq, pow_one] at this
    exact this
  have hmem : a₁ * (a₁ - 1) ∈ 𝔪 := by
    have := hJ𝔪 hidem1
    rwa [show a₁ * a₁ - a₁ = a₁ * (a₁ - 1) by ring] at this
  have hclose : ∀ (n : ℕ) (a : A),
      Ideal.Quotient.mk (J ^ max n 1) a = AdicCompletion.evalₐ J (max n 1) y → a - a₁ ∈ 𝔪 := by
    intro n a ha
    have h1 := htrans 1 (max n 1) (le_max_right _ _) a ha
    rw [← ha₁, Ideal.Quotient.eq, pow_one] at h1
    exact hJ𝔪 h1
  rcases h𝔪max.isPrime.mem_or_mem hmem with h | h
  ·
    left
    intro c hc0 hcm
    apply AdicCompletion.ext_evalₐ
    intro m
    rw [map_zero]
    obtain ⟨n, hn⟩ := hxrep c hc0 hcm m
    obtain ⟨a, ha⟩ := Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ J (max n 1) y)
    have haM : a ∈ 𝔪 := by
      have := Ideal.add_mem _ (hclose n a ha) h
      simpa using this
    obtain ⟨L, t, hLt⟩ := hQ c hc0 hcm a haM
    obtain ⟨r, hr⟩ := Ideal.Quotient.mk_surjective
      (AdicCompletion.evalₐ (wcGubIdl W A g ϖ c) m (x c))
    have hlift : Ideal.Quotient.mk (J ^ n) (a ^ (L * m + 1)) = AdicCompletion.evalₐ J n y := by
      rw [map_pow, htrans n (max n 1) (le_max_left _ _) a ha, ← map_pow, hyid.pow_succ_eq]
    obtain ⟨t', ht'⟩ := hn _ r hlift hr
    rw [← hr, Ideal.Quotient.eq_zero_iff_mem, hspan, Ideal.mem_span_singleton']
    refine ⟨algebraMap A ↥(wcGubBox W A g c) (algebraMap (↥W) A ϖ) ^ k c * t ^ m *
      algebraMap A ↥(wcGubBox W A g c) a - t', ?_⟩
    have hLG := congrArg Subtype.val hLt
    simp only [Subalgebra.coe_pow, Subalgebra.coe_mul, Subalgebra.coe_algebraMap] at hLG
    apply Subtype.ext
    simp only [Subalgebra.coe_mul, Subalgebra.coe_sub, Subalgebra.coe_pow,
      Subalgebra.coe_algebraMap]
    have hP : algebraMap A (wcGubGen W A) a ^ (L * m + 1) =
        ((t : wcGubGen W A) * algebraMap A (wcGubGen W A) (algebraMap (↥W) A ϖ)) ^ m *
          algebraMap A (wcGubGen W A) a := by
      rw [pow_succ, pow_mul, hLG]
    rw [map_pow] at ht'
    linear_combination ht' - algebraMap A (wcGubGen W A) (algebraMap (↥W) A ϖ) ^ k c * hP
  ·
    right
    intro c hc0 hcm
    apply AdicCompletion.ext_evalₐ
    intro m
    rw [map_pow, hev]
    obtain ⟨n, hn⟩ := hxrep c hc0 hcm m
    obtain ⟨a, ha⟩ := Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ J (max n 1) y)
    have hbM : 1 - a ∈ 𝔪 := by
      have := 𝔪.neg_mem (Ideal.add_mem _ (hclose n a ha) h)
      have e : -(a - a₁ + (a₁ - 1)) = 1 - a := by ring
      rwa [e] at this
    obtain ⟨L, t, hLt⟩ := hQ c hc0 hcm (1 - a) hbM
    obtain ⟨r, hr⟩ := Ideal.Quotient.mk_surjective
      (AdicCompletion.evalₐ (wcGubIdl W A g ϖ c) m (x c))
    have h1 : (1 - AdicCompletion.evalₐ J n y) ^ (L * m + 1) = 1 - AdicCompletion.evalₐ J n y := by
      have := congrArg (AdicCompletion.evalₐ J n) (hyid.one_sub.pow_succ_eq (L * m))
      rw [map_pow, map_sub, map_one] at this
      exact this
    have hlift : Ideal.Quotient.mk (J ^ n) (1 - (1 - a) ^ (L * m + 1)) =
        AdicCompletion.evalₐ J n y := by
      rw [map_sub, map_one, map_pow, map_sub, map_one,
        htrans n (max n 1) (le_max_left _ _) a ha, h1, sub_sub_cancel]
    obtain ⟨t', ht'⟩ := hn _ r hlift hr
    rw [← hr, ← map_pow]
    symm
    rw [Ideal.Quotient.eq, hspan, Ideal.mem_span_singleton']
    refine ⟨algebraMap A ↥(wcGubBox W A g c) (algebraMap (↥W) A ϖ) ^ k c * t ^ m *
      algebraMap A ↥(wcGubBox W A g c) (1 - a) + t', ?_⟩
    have hLG := congrArg Subtype.val hLt
    simp only [Subalgebra.coe_pow, Subalgebra.coe_mul, Subalgebra.coe_algebraMap] at hLG
    apply Subtype.ext
    simp only [Subalgebra.coe_mul, Subalgebra.coe_sub, Subalgebra.coe_add, Subalgebra.coe_pow,
      Subalgebra.coe_algebraMap]
    have hP : algebraMap A (wcGubGen W A) (1 - a) ^ (L * m + 1) =
        ((t : wcGubGen W A) * algebraMap A (wcGubGen W A) (algebraMap (↥W) A ϖ)) ^ m *
          algebraMap A (wcGubGen W A) (1 - a) := by
      rw [pow_succ, pow_mul, hLG]
    rw [map_sub (algebraMap A (wcGubGen W A)) 1, map_one, map_pow] at ht'
