theorem wcpa_dj_lr1k_lldf_fibre_dichotomy (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (b : ↥W)
    (hb : b ∈ IsLocalRing.maximalIdeal ↥W) (Y : Scheme.{u}) (g : Y ⟶ Spec (.of ↥W))
    (j : wcLldfA ↥W ⟶ Y) (k : Spec (.of (wcNcRing W b)) ⟶ Y) (n : ↥(Spec (.of (wcNcRing W b))))
    (P : ↥Y → Prop) (hj : IsOpenImmersion j) (hk : IsOpenImmersion k)
    (hjg : j ≫ g = wcLldfPiA ↥W) (hkg : k ≫ g = wcNcStr W b)
    (hn : ∀ y : ↥(Spec (.of (wcNcRing W b))),
      y = n ↔ (Ideal.Quotient.mk (wcNcIdeal W b) (MvPolynomial.X 0) ∈ y.asIdeal ∧
        Ideal.Quotient.mk (wcNcIdeal W b) (MvPolynomial.X 1) ∈ y.asIdeal ∧
        ∀ w ∈ IsLocalRing.maximalIdeal ↥W,
          Ideal.Quotient.mk (wcNcIdeal W b) (MvPolynomial.C w) ∈ y.asIdeal))
    (hov : ∀ y : ↥(Spec (.of (wcNcRing W b))),
      Ideal.Quotient.mk (wcNcIdeal W b) (MvPolynomial.X 1) ∉ y.asIdeal → k y ∈ Set.range ⇑j)
    (hcov : ∀ p : ↥Y, P p → p ∈ Set.range ⇑j ∨ p ∈ Set.range ⇑k)
    (hP : ∀ y : ↥(Spec (.of (wcNcRing W b))), P (k y) →
      Ideal.Quotient.mk (wcNcIdeal W b) (MvPolynomial.X 0) ∈ y.asIdeal ∧
        ∀ w ∈ IsLocalRing.maximalIdeal ↥W,
          Ideal.Quotient.mk (wcNcIdeal W b) (MvPolynomial.C w) ∈ y.asIdeal) :
    ∀ p : ↥Y, P p → (p ∈ Set.range ⇑j ↔ p ≠ k n) ∧ (wcLldfSm g p ↔ p ≠ k n) :=
by
  classical

  have hpiA : SmoothOfRelativeDimension 1 (wcLldfPiA ↥W) := by
    show SmoothOfRelativeDimension 1
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (MvPolynomial (Fin 1) ↥W))))
    rw [HasRingHomProperty.Spec_iff (P := @SmoothOfRelativeDimension 1)]
    apply RingHom.locally_of RingHom.isStandardSmoothOfRelativeDimension_respectsIso
    rw [CommRingCat.hom_ofHom, RingHom.isStandardSmoothOfRelativeDimension_algebraMap]
    have := Algebra.IsStandardSmoothOfRelativeDimension.mvPolynomial (↥W) (Fin 1)
    simpa using this

  have hsmj : ∀ x, wcLldfSm g (j x) := by
    intro x
    haveI := hj
    refine ⟨j.opensRange, ?_, ?_⟩
    · first
        | exact ⟨x, rfl⟩
        | exact Scheme.Hom.mem_opensRange.mpr ⟨x, rfl⟩
        | simp
    · have heq : j.opensRange.ι ≫ g = (Scheme.Hom.isoOpensRange j).inv ≫ wcLldfPiA ↥W := by
        rw [← Scheme.Hom.isoOpensRange_inv_comp j, Category.assoc, hjg]
      rw [heq]
      exact smoothOfRelativeDimension_comp 0 1 _ _

  have hnode_img : ∀ y : ↥(Spec (.of (wcNcRing W b))), (∀ w ∈ IsLocalRing.maximalIdeal ↥W,
      Ideal.Quotient.mk (wcNcIdeal W b) (MvPolynomial.C w) ∈ y.asIdeal) →
      wcNcStr W b y = IsLocalRing.closedPoint ↥W := by
    intro y hy
    apply PrimeSpectrum.ext
    show Ideal.comap (algebraMap ↥W (wcNcRing W b)) y.asIdeal = IsLocalRing.maximalIdeal ↥W
    symm
    apply Ideal.IsMaximal.eq_of_le (IsLocalRing.maximalIdeal.isMaximal ↥W)
      (Ideal.IsPrime.ne_top (by haveI := y.isPrime; exact Ideal.comap_isPrime _ _))
    intro w hw
    rw [Ideal.mem_comap]
    have e : algebraMap ↥W (wcNcRing W b) w =
        Ideal.Quotient.mk (wcNcIdeal W b) (MvPolynomial.C w) := by
      first
        | rfl
        | simp [Ideal.Quotient.algebraMap_eq, MvPolynomial.algebraMap_eq]
    rw [e]
    exact hy w hw

  have hlift : ∀ y : ↥Y, g y = IsLocalRing.closedPoint ↥W → wcLldfSm g y →
      ∃ w, Limits.pullback.fst g
          (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) w = y ∧
        wcpaDjLkSmAt W g w := by
    rintro y hy ⟨U, hyU, hU⟩
    have ht : (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))
        (IsLocalRing.closedPoint (IsLocalRing.ResidueField ↥W)) = IsLocalRing.closedPoint ↥W := by
      show PrimeSpectrum.comap (algebraMap ↥W (IsLocalRing.ResidueField ↥W)) _ = _
      rw [IsLocalRing.ResidueField.algebraMap_eq]
      exact IsLocalRing.comap_closedPoint (IsLocalRing.residue ↥W)
    obtain ⟨w, hw1, -⟩ := Scheme.Pullback.exists_preimage_pullback
      (f := g) (g := Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))
      y _ (hy.trans ht.symm)
    refine ⟨w, hw1, Limits.pullback.fst g
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) ⁻¹ᵁ U,
      by rw [Scheme.Hom.mem_preimage, hw1]; exact hyU, ?_⟩
    have hpb := (isPullback_morphismRestrict (Limits.pullback.fst g
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) U).paste_vert
      (IsPullback.of_hasPullback g
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))))
    exact MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension 1) hpb hU

  have hnotsm : ¬ wcLldfSm g (k n) := by
    intro hS
    obtain ⟨h0, h1, hC⟩ := (hn n).mp rfl
    have hgk : g (k n) = IsLocalRing.closedPoint ↥W := by
      rw [← Scheme.Hom.comp_apply, hkg]
      exact hnode_img n hC
    obtain ⟨w, hw, hwsm⟩ := hlift (k n) hgk hS
    haveI := hk
    have hy : k n ∈ k.opensRange := by
      first
        | exact ⟨n, rfl⟩
        | exact Scheme.Hom.mem_opensRange.mpr ⟨n, rfl⟩
        | simp
    have hpt : (Scheme.Hom.isoOpensRange k).inv ⟨k n, hy⟩ = n := by
      have hq : (Scheme.Hom.isoOpensRange k).hom n = ⟨k n, hy⟩ := by
        apply Subtype.ext
        have h2 := Scheme.Opens.ι_apply k.opensRange ((Scheme.Hom.isoOpensRange k).hom n)
        rw [← Scheme.Hom.comp_apply, Scheme.Hom.isoOpensRange_hom_ι] at h2
        exact h2.symm
      rw [← hq, ← Scheme.Hom.comp_apply, Iso.hom_inv_id]
      rfl
    have hcomm : (Scheme.Hom.isoOpensRange k).inv ≫ wcNcStr W b = k.opensRange.ι ≫ g := by
      rw [← hkg, ← Category.assoc, Scheme.Hom.isoOpensRange_inv_comp]
    exact wcpa_dj_lr1k_odfgl_node_not_smooth Ω W b Y g k.opensRange
      (Scheme.Hom.isoOpensRange k).inv inferInstance hcomm (k n) hy
      (by rw [hpt]; exact h0) (by rw [hpt]; exact h1) w hw hwsm

  have hkn : k n ∉ Set.range j := by
    rintro ⟨x, hx⟩
    apply hnotsm
    rw [← hx]
    exact hsmj x
  intro p hp
  by_cases hpj : p ∈ Set.range j
  · obtain ⟨x, rfl⟩ := hpj
    have hne : j x ≠ k n := fun h => hkn ⟨x, h⟩
    exact ⟨iff_of_true ⟨x, rfl⟩ hne, iff_of_true (hsmj x) hne⟩
  · obtain ⟨y, rfl⟩ := (hcov p hp).resolve_left hpj
    obtain ⟨h0, hC⟩ := hP y hp
    have h1 : Ideal.Quotient.mk (wcNcIdeal W b) (MvPolynomial.X 1) ∈ y.asIdeal := by
      by_contra hx1
      exact hpj (hov y hx1)
    have hyn : y = n := (hn y).mpr ⟨h0, h1, hC⟩
    subst hyn
    exact ⟨iff_of_false hpj (fun h => h rfl), iff_of_false hnotsm (fun h => h rfl)⟩

theorem wcpa_dj_lr1k_lldf_mprime_centre (Ω : Type u) [Field Ω] (W : ValuationSubring Ω)
    (a a'' c : ↥W) (ha : a ≠ 0) (M' : Scheme.{u}) (r0 : M' ⟶ wcLldfA ↥W)
    (ρ : Spec (.of ↥W) ⟶ M') (j' : wcLldfA ↥W ⟶ M')
    (hr0 : wcCsdIsBlowup ((wcLldfEv ↥W 0).ker ⊔
      wcNcPrincipal (.of ↥W) (wcLldfA ↥W) (wcLldfPiA ↥W) a) r0)
    (hρ : ρ ≫ r0 = wcLldfEv ↥W (a * c)) (hj' : IsOpenImmersion j')
    (hj'r : j' ≫ r0 = Spec.map (CommRingCat.ofHom (wcLldmLam W 0 a))) :
    ρ = wcLldfEv ↥W c ≫ j' ∧
      (ρ.ker ⊔ wcNcPrincipal (.of ↥W) M' (r0 ≫ wcLldfPiA ↥W) a'').comap j' =
        (wcLldfEv ↥W c).ker ⊔ wcNcPrincipal (.of ↥W) (wcLldfA ↥W) (wcLldfPiA ↥W) a'' :=
by
  classical
  haveI := hj'

  have hinvhom : ∀ (R : CommRingCat.{u}) (x : R),
      (Scheme.ΓSpecIso R).hom.hom ((Scheme.ΓSpecIso R).inv.hom x) = x := by
    intro R x
    have := congrArg (fun g => g.hom x) (Scheme.ΓSpecIso R).inv_hom_id
    simpa only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_id,
      RingHom.id_apply] using this
  have hhominv : ∀ (R : CommRingCat.{u}) (x : Γ(Spec R, ⊤)),
      (Scheme.ΓSpecIso R).inv.hom ((Scheme.ΓSpecIso R).hom.hom x) = x := by
    intro R x
    have := congrArg (fun g => g.hom x) (Scheme.ΓSpecIso R).hom_inv_id
    simpa only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_id,
      RingHom.id_apply] using this

  have hker0 : RingHom.ker (MvPolynomial.eval (fun _ : Fin 1 => (0 : ↥W))) =
      Ideal.span {MvPolynomial.X 0} := by
    ext p
    rw [RingHom.mem_ker]
    constructor
    · intro h
      have hs : Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 1) ↥W)} =
          Ideal.span (MvPolynomial.X '' Set.univ) := by
        rw [Set.image_univ, Set.range_unique]
        rfl
      rw [hs, MvPolynomial.mem_ideal_span_X_image]
      intro m hm
      refine ⟨0, Set.mem_univ _, ?_⟩
      intro hm0
      have hm' : m = 0 := by
        refine Finsupp.ext (fun i => ?_)
        rw [Fin.fin_one_eq_zero i]
        exact hm0
      subst hm'
      rw [MvPolynomial.mem_support_iff] at hm
      apply hm
      rw [MvPolynomial.eval_zero'] at h
      rw [← h, MvPolynomial.constantCoeff_eq]
    · intro h
      obtain ⟨q, rfl⟩ := Ideal.mem_span_singleton'.mp h
      simp
  have hkerSpec : ∀ (A B : Type u) [CommRing A] [CommRing B] (f : A →+* B) (x0 : A),
      RingHom.ker f = Ideal.span {x0} →
      Scheme.Hom.ker (Spec.map (CommRingCat.ofHom f)) =
        Scheme.IdealSheafData.ofIdealTop (Ideal.span {(Scheme.ΓSpecIso (.of A)).inv.hom x0}) := by
    intro A B _ _ f x0 hf
    rw [Scheme.ker_of_isAffine]
    congr 1
    ext x
    have nat := congrArg (fun g => g.hom x) (Scheme.ΓSpecIso_naturality (CommRingCat.ofHom f))
    simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at nat
    rw [RingHom.mem_ker, Ideal.mem_span_singleton']
    constructor
    · intro hx
      have h1 : f ((Scheme.ΓSpecIso (.of A)).hom.hom x) = 0 := by rw [← nat, hx, map_zero]
      rw [← RingHom.mem_ker, hf, Ideal.mem_span_singleton'] at h1
      obtain ⟨y, hy⟩ := h1
      refine ⟨(Scheme.ΓSpecIso (.of A)).inv.hom y, ?_⟩
      rw [← map_mul, hy, hhominv]
    · rintro ⟨y, rfl⟩
      have hfa : f x0 = 0 := by
        rw [← RingHom.mem_ker, hf]; exact Ideal.mem_span_singleton_self x0
      have h1 : (Scheme.ΓSpecIso (.of B)).hom.hom ((Spec.map (CommRingCat.ofHom f)).appTop.hom
          (y * (Scheme.ΓSpecIso (.of A)).inv.hom x0)) = 0 := by
        rw [nat, map_mul, map_mul, hinvhom, hfa, mul_zero]
      have h2 := congrArg (Scheme.ΓSpecIso (.of B)).inv.hom h1
      rwa [hhominv, map_zero] at h2
  have hprinc : wcNcPrincipal (.of ↥W) (wcLldfA ↥W) (wcLldfPiA ↥W) a =
      Scheme.IdealSheafData.ofIdealTop (Ideal.span
        {(Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.C a)}) := by
    have h1 : (Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.C a) =
        (wcLldfPiA ↥W).appTop.hom ((Scheme.ΓSpecIso (.of ↥W)).inv.hom a) := by
      have := congrArg (fun g => g.hom a) (Scheme.ΓSpecIso_inv_naturality
        (CommRingCat.ofHom (algebraMap ↥W (MvPolynomial (Fin 1) ↥W))))
      simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at this
      exact this
    unfold wcNcPrincipal
    rw [h1]
  have hsup : ∀ (X : Scheme.{u}) (I J : Ideal Γ(X, ⊤)),
      Scheme.IdealSheafData.ofIdealTop I ⊔ Scheme.IdealSheafData.ofIdealTop J =
        Scheme.IdealSheafData.ofIdealTop (I ⊔ J) := by
    intro X I J
    apply Scheme.IdealSheafData.ext
    rw [Scheme.IdealSheafData.ideal_sup]
    funext V
    rw [Pi.sup_apply, Scheme.IdealSheafData.ofIdealTop_ideal,
      Scheme.IdealSheafData.ofIdealTop_ideal, Scheme.IdealSheafData.ofIdealTop_ideal,
      Ideal.map_sup]
  have hJ : (wcLldfEv ↥W 0).ker ⊔ wcNcPrincipal (.of ↥W) (wcLldfA ↥W) (wcLldfPiA ↥W) a =
      Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range
        ![(Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.X 0),
          (Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.C a)])) := by
    rw [hkerSpec (MvPolynomial (Fin 1) ↥W) ↥W _ _ hker0, hprinc, hsup]
    congr 1
    rw [Matrix.range_cons, Matrix.range_cons, Matrix.range_empty, Set.union_empty,
      Set.singleton_union, Ideal.span_insert]
  rw [hJ] at hr0

  have key : ∀ (t : ↥W) (z : MvPolynomial (Fin 1) ↥W),
      (wcLldfEv ↥W t).appTop.hom ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom z) =
      (Scheme.ΓSpecIso (.of ↥W)).inv.hom (MvPolynomial.eval (fun _ : Fin 1 => t) z) :=
    fun t z => (congrArg (fun φ => φ.hom z)
      (Scheme.ΓSpecIso_inv_naturality
        (CommRingCat.ofHom (MvPolynomial.eval (fun _ : Fin 1 => t))))).symm
  have hγWne : (Scheme.ΓSpecIso (.of ↥W)).inv.hom a ≠ 0 := by
    intro h
    apply ha
    have := congrArg (Scheme.ΓSpecIso (.of ↥W)).hom.hom h
    rwa [hinvhom, map_zero] at this
  have hInv : wcCsdInvPull (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range
        ![(Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.X 0),
          (Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.C a)])))
      (wcLldfEv ↥W (a * c)) := by
    refine wcpa_dj_ncmb_invpull_affine _ _ 1 ![(Scheme.ΓSpecIso (.of ↥W)).inv.hom c, 1] ?_ ?_
    · intro j
      fin_cases j
      · show (wcLldfEv ↥W (a * c)).appTop.hom
            ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.X 0)) =
          (Scheme.ΓSpecIso (.of ↥W)).inv.hom c *
          (wcLldfEv ↥W (a * c)).appTop.hom
            ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.C a))
        rw [key, key, MvPolynomial.eval_X, MvPolynomial.eval_C, map_mul, mul_comm]
      · show (wcLldfEv ↥W (a * c)).appTop.hom
            ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.C a)) =
          1 * (wcLldfEv ↥W (a * c)).appTop.hom
            ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.C a))
        rw [one_mul]
    · show (wcLldfEv ↥W (a * c)).appTop.hom
          ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.C a)) ∈
          nonZeroDivisors Γ(Spec (.of ↥W), ⊤)
      rw [key, MvPolynomial.eval_C]
      exact mem_nonZeroDivisors_of_ne_zero hγWne
  have hσ : (wcLldfEv ↥W c ≫ j') ≫ r0 = wcLldfEv ↥W (a * c) := by
    rw [Category.assoc, hj'r]
    simp only [wcLldfEv]
    rw [← Spec.map_comp]
    congr 1
    ext x <;> simp [wcLldmLam]
  have hρj : ρ = wcLldfEv ↥W c ≫ j' := (hr0.2 _ _ hInv).unique hρ hσ

  obtain ⟨U, t, hCH⟩ := wc_bp_blowup_charts _ r0 hr0
  obtain ⟨-, hqs, -⟩ := wc_bp_charts_finiteness _ r0 U t hCH
  haveI := hqs
  haveI : QuasiSeparatedSpace M' := quasiSeparatedSpace_of_quasiSeparated r0
  haveI : QuasiCompact ρ := quasiCompact_of_compactSpace ρ

  have hker : (ρ.ker).comap j' = (wcLldfEv ↥W c).ker := by
    have H : Set.range ρ ⊆ Set.range j' := by
      rintro _ ⟨x, rfl⟩
      exact ⟨wcLldfEv ↥W c x, by rw [hρj, Scheme.Hom.comp_apply]⟩
    have hpb : IsPullback (wcLldfEv ↥W c) (𝟙 _) j' ρ := by
      have h1 := IsOpenImmersion.isPullback_lift_id ρ j' H
      rwa [← IsOpenImmersion.lift_uniq j' ρ H (wcLldfEv ↥W c) hρj.symm] at h1
    apply Scheme.IdealSheafData.ext
    funext V
    rw [Scheme.IdealSheafData.ideal_comap_of_isOpenImmersion,
      Scheme.ker_ideal_of_isPullback_of_isOpenImmersion ρ (wcLldfEv ↥W c) (𝟙 _) j' hpb V]

  have hprin := wcpa_dj_nc_ofIdealTop_comap (.of ↥W) M' (wcLldfA ↥W) (r0 ≫ wcLldfPiA ↥W) j' a''
  have hLπ : Spec.map (CommRingCat.ofHom (wcLldmLam W 0 a)) ≫ wcLldfPiA ↥W =
      wcLldfPiA ↥W := by
    rw [wcLldfPiA, ← Spec.map_comp]
    congr 1
    ext x
    simp [wcLldmLam, MvPolynomial.algebraMap_eq]
  refine ⟨hρj, ?_⟩
  rw [Scheme.IdealSheafData.comap_sup, hker, hprin, ← Category.assoc, hj'r, hLπ]

theorem wcpa_dj_lr1k_lldf_model : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (a a'' c : ↥W), a ≠ 0 → a ∈ IsLocalRing.maximalIdeal ↥W →
      a'' ≠ 0 → a'' ∈ IsLocalRing.maximalIdeal ↥W →
    ∀ (M' M₂ M₁ : Scheme.{u}) (r0 : M' ⟶ wcLldfA ↥W) (ρ : Spec (.of ↥W) ⟶ M')
      (r20 : M₂ ⟶ M') (r10 : M₁ ⟶ wcLldfA ↥W),
    wcLldfModelHyp W a a'' c r0 ρ r20 r10 →
    ∃ (z0 : ↥M₁) (z2 : ↥M₂),
      (r10 z0 = wcLldfEv ↥W 0 (IsLocalRing.closedPoint ↥W) ∧
        ∀ p : ↥M₁, r10 p = wcLldfEv ↥W 0 (IsLocalRing.closedPoint ↥W) →
          (wcLldfSm (r10 ≫ wcLldfPiA ↥W) p ↔ p ≠ z0)) ∧
      (r20 z2 = ρ (IsLocalRing.closedPoint ↥W) ∧
        ∀ p : ↥M₂, r20 p = ρ (IsLocalRing.closedPoint ↥W) →
          (wcLldfSm (r20 ≫ r0 ≫ wcLldfPiA ↥W) p ↔ p ≠ z2)) ∧
      ∀ (Z : Scheme.{u}) (e : Z ⟶ M₂) (f : Z ⟶ M₁), f ≫ r10 = e ≫ r20 ≫ r0 →
        Flat (e ≫ r20 ≫ r0 ≫ wcLldfPiA ↥W) →
        ∀ z : ↥Z, r0 (r20 (e z)) = wcLldfEv ↥W 0 (IsLocalRing.closedPoint ↥W) →
          (f z = z0 ↔ (r20 (e z) ≠ ρ (IsLocalRing.closedPoint ↥W) ∨ e z = z2)) :=
by
  intro Ω _ _ W hW hWt a a'' c ha ham ha'' ha''m M' M₂ M₁ r0 ρ r20 r10 hMH
  obtain ⟨hr0, hρ, hr20, hr10⟩ := hMH

  have hEv : ∀ (e : ↥W) (v : ↥(wcLldfA ↥W)),
      v = wcLldfEv ↥W e (IsLocalRing.closedPoint ↥W) ↔
        (MvPolynomial.X 0 - MvPolynomial.C e ∈ v.asIdeal ∧
          ∀ w ∈ IsLocalRing.maximalIdeal ↥W, MvPolynomial.C w ∈ v.asIdeal) := by
    intro e v
    have hpt : (wcLldfEv ↥W e (IsLocalRing.closedPoint ↥W)).asIdeal =
        Ideal.comap (MvPolynomial.eval (fun _ : Fin 1 => e)) (IsLocalRing.maximalIdeal ↥W) := rfl
    have hQ : ∀ p : MvPolynomial (Fin 1) ↥W,
        p - MvPolynomial.C (MvPolynomial.eval (fun _ : Fin 1 => e) p) ∈
          Ideal.span {MvPolynomial.X 0 - MvPolynomial.C e} := by
      intro p
      induction p using MvPolynomial.induction_on with
      | C a => simp
      | add p q hp hq =>
        have h : p + q - MvPolynomial.C (MvPolynomial.eval (fun _ : Fin 1 => e) (p + q)) =
            (p - MvPolynomial.C (MvPolynomial.eval (fun _ : Fin 1 => e) p)) +
            (q - MvPolynomial.C (MvPolynomial.eval (fun _ : Fin 1 => e) q)) := by
          rw [map_add, map_add]; ring
        rw [h]
        exact Ideal.add_mem _ hp hq
      | mul_X p n hp =>
        have hn : n = 0 := Subsingleton.elim n 0
        subst hn
        have h : p * MvPolynomial.X 0 -
            MvPolynomial.C (MvPolynomial.eval (fun _ : Fin 1 => e) (p * MvPolynomial.X 0)) =
            (p - MvPolynomial.C (MvPolynomial.eval (fun _ : Fin 1 => e) p)) * MvPolynomial.X 0 +
            MvPolynomial.C (MvPolynomial.eval (fun _ : Fin 1 => e) p) *
              (MvPolynomial.X 0 - MvPolynomial.C e) := by
          rw [map_mul, MvPolynomial.eval_X, map_mul]; ring
        rw [h]
        exact Ideal.add_mem _ (Ideal.mul_mem_right _ _ hp)
          (Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _))
    constructor
    · rintro rfl
      rw [hpt]
      refine ⟨?_, fun w hw => ?_⟩
      · rw [Ideal.mem_comap]
        simp
      · rw [Ideal.mem_comap]
        simpa using hw
    · rintro ⟨hX, hC⟩
      have hmax : (wcLldfEv ↥W e (IsLocalRing.closedPoint ↥W)).asIdeal.IsMaximal := by
        rw [hpt]
        exact Ideal.comap_isMaximal_of_surjective _
          (fun w => ⟨MvPolynomial.C w, by simp⟩)
      have hle : (wcLldfEv ↥W e (IsLocalRing.closedPoint ↥W)).asIdeal ≤ v.asIdeal := by
        intro p hp
        rw [hpt, Ideal.mem_comap] at hp
        have h1 := hQ p
        have h2 : Ideal.span {MvPolynomial.X 0 - MvPolynomial.C e} ≤ v.asIdeal :=
          (Ideal.span_singleton_le_iff_mem _).mpr hX
        have h3 := h2 h1
        have h4 := hC _ hp
        have h5 := Ideal.add_mem _ h3 h4
        rwa [sub_add_cancel] at h5
      exact (PrimeSpectrum.ext (hmax.eq_of_le v.isPrime.ne_top hle)).symm

  have hNode : ∀ b : ↥W, b ∈ IsLocalRing.maximalIdeal ↥W →
      ∃ n : ↥(Spec (.of (wcNcRing W b))), ∀ y : ↥(Spec (.of (wcNcRing W b))),
        y = n ↔ (Ideal.Quotient.mk (wcNcIdeal W b) (MvPolynomial.X 0) ∈ y.asIdeal ∧
          Ideal.Quotient.mk (wcNcIdeal W b) (MvPolynomial.X 1) ∈ y.asIdeal ∧
          ∀ w ∈ IsLocalRing.maximalIdeal ↥W,
            Ideal.Quotient.mk (wcNcIdeal W b) (MvPolynomial.C w) ∈ y.asIdeal) := by
    intro b hb
    set f : MvPolynomial (Fin 2) ↥W →+* IsLocalRing.ResidueField ↥W :=
      (IsLocalRing.residue ↥W).comp MvPolynomial.constantCoeff with hf
    have hfI : ∀ p ∈ wcNcIdeal W b, f p = 0 := by
      intro p hp
      obtain ⟨q, rfl⟩ := Ideal.mem_span_singleton'.mp hp
      simp only [hf, RingHom.comp_apply, map_mul, map_sub, MvPolynomial.constantCoeff_X,
        MvPolynomial.constantCoeff_C]
      rw [(IsLocalRing.residue_eq_zero_iff b).mpr hb]
      simp
    set N : wcNcRing W b →+* IsLocalRing.ResidueField ↥W := Ideal.Quotient.lift _ f hfI with hN
    have hNs : Function.Surjective N := by
      intro x
      obtain ⟨w, rfl⟩ := IsLocalRing.residue_surjective x
      refine ⟨Ideal.Quotient.mk _ (MvPolynomial.C w), ?_⟩
      simp [hN, hf]
    have hmax : (RingHom.ker N).IsMaximal := RingHom.ker_isMaximal_of_surjective N hNs
    refine ⟨⟨RingHom.ker N, hmax.isPrime⟩, fun y => ⟨?_, ?_⟩⟩
    · rintro rfl
      refine ⟨?_, ?_, fun w hw => ?_⟩
      · show N _ = 0
        simp [hN, hf]
      · show N _ = 0
        simp [hN, hf]
      · show N _ = 0
        simpa [hN, hf] using hw
    · rintro ⟨h0, h1, hC⟩
      have hQ : ∀ p : MvPolynomial (Fin 2) ↥W,
          Ideal.Quotient.mk (wcNcIdeal W b) p -
            Ideal.Quotient.mk (wcNcIdeal W b) (MvPolynomial.C (MvPolynomial.constantCoeff p)) ∈
              y.asIdeal := by
        intro p
        induction p using MvPolynomial.induction_on with
        | C a => simp
        | add p q hp hq =>
          have h : Ideal.Quotient.mk (wcNcIdeal W b) (p + q) -
              Ideal.Quotient.mk (wcNcIdeal W b)
                (MvPolynomial.C (MvPolynomial.constantCoeff (p + q))) =
              (Ideal.Quotient.mk (wcNcIdeal W b) p -
                Ideal.Quotient.mk (wcNcIdeal W b) (MvPolynomial.C (MvPolynomial.constantCoeff p))) +
              (Ideal.Quotient.mk (wcNcIdeal W b) q -
                Ideal.Quotient.mk (wcNcIdeal W b)
                  (MvPolynomial.C (MvPolynomial.constantCoeff q))) := by
            simp only [map_add]; ring
          rw [h]
          exact Ideal.add_mem _ hp hq
        | mul_X p i hp =>
          have h : Ideal.Quotient.mk (wcNcIdeal W b) (p * MvPolynomial.X i) -
              Ideal.Quotient.mk (wcNcIdeal W b)
                (MvPolynomial.C (MvPolynomial.constantCoeff (p * MvPolynomial.X i))) =
              Ideal.Quotient.mk (wcNcIdeal W b) p *
                Ideal.Quotient.mk (wcNcIdeal W b) (MvPolynomial.X i) := by
            simp
          rw [h]
          apply Ideal.mul_mem_left
          fin_cases i
          · exact h0
          · exact h1
      have hle : RingHom.ker N ≤ y.asIdeal := by
