    rw [Scheme.IdealSheafData.comap_sup, Scheme.IdealSheafData.comap_sup,
      wcpa_dj_nc_ofIdealTop_comap, wcpa_dj_nc_ofIdealTop_comap,
      wcpa_dj_mscc_ker_restrict_open X U (.of ↥W) σ ΔU hσ hΔU,
      wcpa_dj_mscc_ker_chart_comap ↥W U.toScheme m ΔU inferInstance hΔm hker, hmC]
  exact wcpa_dj_lr1k_ebd_roof X X' M' _ _ _ U m r r₀ hmet hJeq hr hr₀

theorem wcpa_dj_lr1k_llcc_rt_ker_flat_bc_affine : ∀ (S' S P M : Scheme.{u}) (i : S ⟶ M) (g : P ⟶ M) (i' : S' ⟶ P) (g' : S' ⟶ S), Flat g → IsAffineHom i → IsPullback i' g' g i → Scheme.Hom.ker i' = (Scheme.Hom.ker i).comap g :=
by
  intro S' S P M i g i' g' hg hi h
  haveI := hg
  haveI := hi
  haveI hi' : IsAffineHom i' := MorphismProperty.of_isPullback (P := @IsAffineHom) h.flip hi

  have alg : ∀ (A B C D : CommRingCat.{u}) (f : A ⟶ B) (α : A ⟶ C) (inl : B ⟶ D) (inr : C ⟶ D),
      f.hom.Flat → IsPushout f α inl inr →
      RingHom.ker inl.hom = Ideal.map f.hom (RingHom.ker α.hom) := by
    intro A B C D f α inl inr hf hpo
    letI := f.hom.toAlgebra
    letI := α.hom.toAlgebra
    haveI : Module.Flat A B := hf
    have h' : IsPushout f α
        (CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom :
          B →+* TensorProduct A B C))
        (CommRingCat.ofHom (Algebra.TensorProduct.includeRight :
          C →ₐ[A] TensorProduct A B C).toRingHom) :=
      CommRingCat.isPushout_tensorProduct A B C
    let φ := IsPushout.isoIsPushout B C hpo h'
    have hinl : inl ≫ φ.hom = CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom :
          B →+* TensorProduct A B C) := IsPushout.inl_isoIsPushout_hom _ _ _ _
    have key : ∀ b : B, inl.hom b = 0 ↔ (b ⊗ₜ[A] (1 : C) : TensorProduct A B C) = 0 := by
      intro b
      have hb : φ.hom.hom (inl.hom b) = b ⊗ₜ[A] (1 : C) := by
        change (inl ≫ φ.hom).hom b = _
        rw [hinl]
        rfl
      constructor
      · intro h0
        rw [← hb, h0, map_zero]
      · intro h0
        have : φ.inv.hom (φ.hom.hom (inl.hom b)) = inl.hom b := by
          change (φ.hom ≫ φ.inv).hom (inl.hom b) = _
          rw [φ.hom_inv_id]
          rfl
        rw [← this, hb, h0, map_zero]
    set I' := RingHom.ker (Algebra.ofId A C) with hI'
    have hII' : RingHom.ker α.hom = I' := by
      ext x
      rw [RingHom.mem_ker, RingHom.mem_ker, Algebra.ofId_apply]
      rfl
    rw [hII']
    ext b
    rw [RingHom.mem_ker, key]
    constructor
    · intro h0
      let κ : (A ⧸ I') →ₗ[A] C := (Ideal.kerLiftAlg (Algebra.ofId A C)).toLinearMap
      have hκ : Function.Injective κ := Ideal.kerLiftAlg_injective (Algebra.ofId A C)
      have hL := Module.Flat.lTensor_preserves_injective_linearMap (M := B) κ hκ
      have h1 : LinearMap.lTensor B κ (b ⊗ₜ[A] Ideal.Quotient.mk I' 1) =
          LinearMap.lTensor B κ 0 := by
        rw [LinearMap.lTensor_tmul, map_zero]
        have : κ (Ideal.Quotient.mk I' 1) = 1 := by
          simp only [κ, AlgHom.toLinearMap_apply, map_one]
        rw [this]
        exact h0
      have h2 : b ⊗ₜ[A] Ideal.Quotient.mk I' 1 = 0 := hL h1
      have h3 := congrArg (TensorProduct.tensorQuotEquivQuotSMul B I') h2
      rw [TensorProduct.tensorQuotEquivQuotSMul_tmul_mk, map_zero, one_smul,
        Submodule.Quotient.mk_eq_zero, Ideal.smul_top_eq_map] at h3
      exact (Submodule.restrictScalars_mem A _ b).mp h3
    · intro hb
      have hle : Ideal.map (algebraMap A B) I' ≤
          RingHom.ker (Algebra.TensorProduct.includeLeftRingHom :
            B →+* TensorProduct A B C) := by
        rw [Ideal.map_le_iff_le_comap]
        intro k hk
        rw [Ideal.mem_comap, RingHom.mem_ker, Algebra.TensorProduct.includeLeftRingHom_apply,
          Algebra.algebraMap_eq_smul_one, TensorProduct.smul_tmul, ← Algebra.algebraMap_eq_smul_one]
        have : algebraMap A C k = 0 := by
          rw [← Algebra.ofId_apply]
          exact hk
        rw [this, TensorProduct.tmul_zero]
      have := hle hb
      rw [RingHom.mem_ker, Algebra.TensorProduct.includeLeftRingHom_apply] at this
      exact this

  have R : ∀ (X Y : Scheme.{u}) (f : X ⟶ Y) (U : Y.Opens) (V : X.Opens) (e : V ≤ f ⁻¹ᵁ U),
      (f.resLE U V e).appTop ≫ V.topIso.hom = U.topIso.hom ≫ f.appLE U V e := by
    intro X Y f U V e
    have aux : ∀ (U1 : Y.Opens) (V1 : X.Opens) (e1 : V1 ≤ f ⁻¹ᵁ U1)
        (i : Opposite.op V1 ⟶ Opposite.op V) (j : Opposite.op U1 ⟶ Opposite.op U),
        f.appLE U1 V1 e1 ≫ X.presheaf.map i = Y.presheaf.map j ≫ f.appLE U V e := by
      intro U1 V1 e1 i j
      rw [Scheme.Hom.appLE_map, Scheme.Hom.map_appLE]
    rw [Scheme.Hom.appTop, Scheme.Hom.app_eq_appLE, Scheme.Hom.resLE_appLE,
      Scheme.Opens.topIso_hom, Scheme.Opens.topIso_hom]
    exact aux _ _ _ _ _

  have CI : ∀ (X Y : Scheme.{u}) (J : Y.IdealSheafData) (π : X ⟶ Y) (U : Y.affineOpens)
      (W : X.affineOpens) (e : W.1 ≤ π ⁻¹ᵁ U.1),
      (J.comap π).ideal W = Ideal.map (π.appLE U.1 W.1 e).hom (J.ideal U) := by
    intro X Y J π U W e
    rw [Scheme.IdealSheafData.comap, Scheme.Hom.ker_apply]
    apply le_antisymm
    · have hW : IsAffineOpen W.1 := W.2
      have hU : IsAffineOpen U.1 := U.2
      set IB := Ideal.map (π.appLE U.1 W.1 e).hom (J.ideal U) with hIB
      have H : J.ideal U ≤ Ideal.comap (π.appLE U.1 W.1 e).hom IB := Ideal.le_comap_map
      let ψ : (Γ(Y, U.1) ⧸ J.ideal U) →+* (Γ(X, W.1) ⧸ IB) :=
        Ideal.quotientMap IB (π.appLE U.1 W.1 e).hom H
      let t : Spec (CommRingCat.of (Γ(X, W.1) ⧸ IB)) ⟶ X :=
        Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk IB)) ≫ hW.fromSpec
      let g : Spec (CommRingCat.of (Γ(X, W.1) ⧸ IB)) ⟶ J.subscheme :=
        Spec.map (CommRingCat.ofHom ψ) ≫ J.subschemeCover.f U
      have hw : t ≫ π = g ≫ J.subschemeι := by
        show (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk IB)) ≫ hW.fromSpec) ≫ π =
          (Spec.map (CommRingCat.ofHom ψ) ≫ J.subschemeCover.f U) ≫ J.subschemeι
        have hc := J.subschemeCover_map_subschemeι U
        rw [J.glueDataObjι_ι U] at hc
        have hg : (Spec.map (CommRingCat.ofHom ψ) ≫ J.subschemeCover.f U) ≫ J.subschemeι =
            Spec.map (CommRingCat.ofHom ψ) ≫
              (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (J.ideal U))) ≫ hU.fromSpec) :=
          (Category.assoc _ _ _).trans (congrArg (Spec.map (CommRingCat.ofHom ψ) ≫ ·) hc)
        rw [hg, Category.assoc, ← IsAffineOpen.SpecMap_appLE_fromSpec π hU hW e]
        rw [← Category.assoc, ← Spec.map_comp, ← Category.assoc, ← Spec.map_comp]
        congr 2
      let l := Limits.pullback.lift t g hw
      have hl : l ≫ Limits.pullback.fst π J.subschemeι = t := Limits.pullback.lift_fst _ _ _
      intro b hb
      rw [RingHom.mem_ker] at hb
      have e0 : ⊤ ≤ t ⁻¹ᵁ W.1 := by
        intro p _
        show hW.fromSpec ((Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk IB))) p) ∈ (W.1 : Set X)
        rw [← hW.range_fromSpec]
        exact ⟨_, rfl⟩
      have h1 : ∀ (e : ⊤ ≤ (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk IB)) ≫ hW.fromSpec) ⁻¹ᵁ W.1),
          (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk IB)) ≫ hW.fromSpec).appLE W.1 ⊤ e =
            CommRingCat.ofHom (Ideal.Quotient.mk IB) ≫ (Scheme.ΓSpecIso _).inv := by
        have hb : ∀ (e₁ : (⊤ : (Spec Γ(X, W.1)).Opens) ≤ hW.fromSpec ⁻¹ᵁ W.1),
            hW.fromSpec.appLE W.1 ⊤ e₁ = (Scheme.ΓSpecIso Γ(X, W.1)).inv := by
          intro e₁
          rw [Scheme.Hom.appLE, IsAffineOpen.fromSpec_app_self, Category.assoc, ← Functor.map_comp]
          have hid : ∀ (f : Opposite.op (⊤ : (Spec Γ(X, W.1)).Opens) ⟶ Opposite.op ⊤),
              (Spec Γ(X, W.1)).presheaf.map f = 𝟙 _ := by
            intro f
            rw [show f = 𝟙 _ from Quiver.Hom.unop_inj (Subsingleton.elim _ _),
              CategoryTheory.Functor.map_id]
          rw [hid, Category.comp_id]
        intro e
        have e₁ : (⊤ : (Spec Γ(X, W.1)).Opens) ≤ hW.fromSpec ⁻¹ᵁ W.1 :=
          hW.fromSpec_preimage_self.ge
        have e₂ : (⊤ : (Spec (CommRingCat.of (Γ(X, W.1) ⧸ IB))).Opens) ≤
            (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk IB))) ⁻¹ᵁ ⊤ := le_top
        rw [← Scheme.Hom.appLE_comp_appLE _ hW.fromSpec W.1 ⊤ ⊤ e₁ e₂, hb e₁]
        have happ : (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk IB))).appLE ⊤ ⊤ e₂ =
            (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk IB))).appTop :=
          Scheme.Hom.appLE_eq_app _
        rw [happ, ← Scheme.ΓSpecIso_inv_naturality]
      have key : ∀ (s : Spec (CommRingCat.of (Γ(X, W.1) ⧸ IB)) ⟶ X) (hs : s = t)
          (e1 : ⊤ ≤ s ⁻¹ᵁ W.1), s.appLE W.1 ⊤ e1 =
            CommRingCat.ofHom (Ideal.Quotient.mk IB) ≫ (Scheme.ΓSpecIso _).inv := by
        rintro s rfl e1
        exact h1 e1
      have e2 : ⊤ ≤ (l ≫ Limits.pullback.fst π J.subschemeι) ⁻¹ᵁ W.1 := by
        rw [hl]; exact e0
      have h2 := key _ hl e2
      rw [Scheme.Hom.comp_appLE] at h2
      have h3 := congrArg (fun f => f.hom b) h2
      simp only [CommRingCat.comp_apply, hb, map_zero] at h3
      have h4 := congrArg (Scheme.ΓSpecIso (CommRingCat.of (Γ(X, W.1) ⧸ IB))).hom.hom h3
      simp only [map_zero, Iso.inv_hom_id_apply] at h4
      exact (Ideal.Quotient.eq_zero_iff_mem).mp h4.symm
    · rw [Ideal.map_le_iff_le_comap]
      intro a ha
      rw [Ideal.mem_comap, RingHom.mem_ker]
      have hP := Limits.pullback.condition (f := π) (g := J.subschemeι)
      have key : ∀ (s : Limits.pullback π J.subschemeι ⟶ Y)
          (hs : Limits.pullback.fst π J.subschemeι ≫ π = s)
          (e1 : (Limits.pullback.fst π J.subschemeι) ⁻¹ᵁ W.1 ≤ s ⁻¹ᵁ U.1),
          ((Limits.pullback.fst π J.subschemeι).app W.1).hom ((π.appLE U.1 W.1 e).hom a) =
            (s.appLE U.1 _ e1).hom a := by
        rintro s rfl e1
        rw [Scheme.Hom.app_eq_appLE, ← CommRingCat.comp_apply, Scheme.Hom.appLE_comp_appLE]
      have e1 : (Limits.pullback.fst π J.subschemeι) ⁻¹ᵁ W.1 ≤
          (Limits.pullback.snd π J.subschemeι ≫ J.subschemeι) ⁻¹ᵁ U.1 := by
        rw [← hP]; intro x hx; exact e hx
      rw [key _ hP e1, Scheme.Hom.comp_appLE, CommRingCat.comp_apply]
      have h0 : (J.subschemeι.app U.1).hom a = 0 := by
        rw [← RingHom.mem_ker, Scheme.IdealSheafData.ker_subschemeι_app]; exact ha
      rw [h0, map_zero]

  have sec : ∀ (V : M.Opens) (W' : P.Opens) (e : W' ≤ g ⁻¹ᵁ V)
      (e' : i' ⁻¹ᵁ W' ≤ g' ⁻¹ᵁ (i ⁻¹ᵁ V)), IsAffineOpen V → IsAffineOpen W' →
      IsPushout (g.appLE V W' e) (i.app V) (i'.app W') (g'.appLE (i ⁻¹ᵁ V) (i' ⁻¹ᵁ W') e') := by
    intro V W' e e' hV hW'
    have hY : IsAffineOpen (i ⁻¹ᵁ V) := hV.preimage i
    haveI : IsAffine V := hV
    haveI : IsAffine W' := hW'
    haveI : IsAffine (i ⁻¹ᵁ V) := hY
    have hpb := Scheme.Hom.isPullback_resLE h (US := V) (UT := i ⁻¹ᵁ V) (UX := W') le_rfl e
      (UY := i' ⁻¹ᵁ W') (inf_eq_left.mpr e').symm
    have hpo := isPushout_appTop_of_isPullback hpb
    refine hpo.of_iso V.topIso W'.topIso (i ⁻¹ᵁ V).topIso (i' ⁻¹ᵁ W').topIso ?_ ?_ ?_ ?_
    · exact R _ _ _ _ _ _
    · rw [R, Scheme.Hom.app_eq_appLE]
    · rw [R, Scheme.Hom.app_eq_appLE]
    · exact R _ _ _ _ _ _

  let ι := {p : M.affineOpens × P.affineOpens // (p.2 : P.Opens) ≤ g ⁻¹ᵁ (p.1 : M.Opens)}
  refine Scheme.IdealSheafData.ext_of_iSup_eq_top (ι := ι) (fun p => p.1.2) ?_ ?_
  · rw [eq_top_iff]
    intro x _
    rw [TopologicalSpace.Opens.mem_iSup]
    obtain ⟨V, hV, hgx, -⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp
      (Scheme.isBasis_affineOpens M)) (show g x ∈ (⊤ : M.Opens) from trivial)
    obtain ⟨W', hW', hxW', hle⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp
      (Scheme.isBasis_affineOpens P)) (show x ∈ g ⁻¹ᵁ V from hgx)
    exact ⟨⟨(⟨V, hV⟩, ⟨W', hW'⟩), hle⟩, hxW'⟩
  · rintro ⟨⟨V, W'⟩, e⟩
    have e' : i' ⁻¹ᵁ W'.1 ≤ g' ⁻¹ᵁ (i ⁻¹ᵁ V.1) := by
      intro x hx
      have h1 : g (i' x) ∈ (V.1 : Set M) := e hx
      have h2 : i (g' x) = g (i' x) := by
        rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, h.toCommSq.w]
      show i (g' x) ∈ V.1
      rw [h2]
      exact h1
    show (Scheme.Hom.ker i').ideal W' = ((Scheme.Hom.ker i).comap g).ideal W'
    rw [Scheme.Hom.ker_apply, CI P M _ g V W' e, Scheme.Hom.ker_apply]
    exact alg _ _ _ _ _ _ _ _ (g.flat_appLE V.2 W'.2 e) (sec V.1 W'.1 e e' V.2 W'.2)

theorem wcpa_dj_lr1k_llcc_rt_second_roof : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω),
    ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) →
    ∀ (a a'' : ↥W), a ≠ 0 → a ∈ IsLocalRing.maximalIdeal ↥W →
    ∀ (X : Scheme.{u}) (uX : X ⟶ Spec (.of ↥W)) (U : X.Opens)
      (m : U.toScheme ⟶ Spec (.of (MvPolynomial (Fin 1) ↥W))) (ΔU : Spec (.of ↥W) ⟶ U.toScheme),
      IsAffineOpen U → Etale m →
      m ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W)) =
        U.ι ≫ uX →
      ΔU ≫ m = Spec.map (CommRingCat.ofHom (MvPolynomial.eval (fun _ : Fin 1 => (0 : ↥W)))) →
      RingHom.ker ΔU.appTop.hom = Ideal.span {m.appTop.hom
        ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.X 0))} →
    ∀ (X' : Scheme.{u}) (r : X' ⟶ X) (σ'' : Spec (.of ↥W) ⟶ X'),
      IsClosedImmersion σ'' → ΔU ≫ U.ι = σ'' ≫ r →
    ∀ (M' : Scheme.{u}) (r₀ : M' ⟶ Spec (.of (MvPolynomial (Fin 1) ↥W)))
      (σ₀' : Spec (.of ↥W) ⟶ M'),
      wcCsdIsBlowup (Scheme.Hom.ker (Spec.map (CommRingCat.ofHom
          (MvPolynomial.eval (fun _ : Fin 1 => (0 : ↥W))))) ⊔
        wcNcPrincipal (.of ↥W) (Spec (.of (MvPolynomial (Fin 1) ↥W)))
          (Spec.map (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W))) a) r₀ →
      σ₀' ≫ r₀ = Spec.map (CommRingCat.ofHom (MvPolynomial.eval (fun _ : Fin 1 => (0 : ↥W)))) →
    ∀ (P : Scheme.{u}) (p : P ⟶ X') (sU : P ⟶ U.toScheme) (κ : P ⟶ M'),
      IsOpenImmersion p → (∀ x' : ↥X', r x' ∈ U → x' ∈ Set.range p) → p ≫ r = sU ≫ U.ι →
      Etale κ → IsPullback κ sU r₀ m →
    ∀ (X₂ : Scheme.{u}) (r₂ : X₂ ⟶ X'),
      wcCsdIsBlowup (σ''.ker ⊔ wcNcPrincipal (.of ↥W) X' (r ≫ uX) a'') r₂ →
    ∀ (M₂ : Scheme.{u}) (r₂₀ : M₂ ⟶ M'),
      wcCsdIsBlowup (Scheme.Hom.ker σ₀' ⊔ wcNcPrincipal (.of ↥W) M'
        (r₀ ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W))) a'')
        r₂₀ →
    ∃ (σP : Spec (.of ↥W) ⟶ P) (P₂ : Scheme.{u}) (p₂ : P₂ ⟶ X₂) (s₂ : P₂ ⟶ P) (κ₂ : P₂ ⟶ M₂),
      σP ≫ p = σ'' ∧ σP ≫ κ = σ₀' ∧ IsOpenImmersion p₂ ∧
      (∀ y : ↥X₂, r₂ y ∈ Set.range p → y ∈ Set.range p₂) ∧ p₂ ≫ r₂ = s₂ ≫ p ∧
      Etale κ₂ ∧ IsPullback κ₂ s₂ r₂₀ κ :=
by
  intro Ω _ W hW a a'' ha0 ham X uX U m ΔU hUaff hmet hmC hΔm hker X' r σ'' hσ'' hΔU
    M' r₀ σ₀' hr₀ hσ₀' P p sU κ hpo hpcov hpr hκet hsq X₂ r₂ hr₂ M₂ r₂₀ hr₂₀
  haveI : IsAffine U.toScheme := hUaff
  haveI := hpo
  haveI := hκet
  have ap : ∀ {A B : Scheme.{u}} {f g : A ⟶ B}, f = g → ∀ a : A, f a = g a := by
    intro A B f g h a; rw [h]

  have hrange : Set.range σ'' ⊆ Set.range p := by
    rintro _ ⟨t, rfl⟩
    apply hpcov
