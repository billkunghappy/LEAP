theorem wcpa_dj_lr1k_nsr_gub_bff_dc_ia_pbc_tb_uniform_content : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (ϖ : ↥W), ϖ ≠ 0 → ϖ ∈ IsLocalRing.maximalIdeal ↥W → (∀ w : ↥W, w ≠ 0 → ∀ x : ↥W, x ∈ IsLocalRing.maximalIdeal ↥W → ∃ K : ℕ, w ∣ x ^ K) → ∀ (t₀ e d₀ : ↥W), t₀ ∈ IsLocalRing.maximalIdeal ↥W → e ≠ 0 → d₀ ≠ 0 → ∃ (c L₀ : ℕ), ∀ (δ : Polynomial ↥W) (L : ℕ), L₀ ≤ L → ϖ ^ L ∣ δ.eval t₀ - d₀ → ∃ k : ℕ, δ.coeff k * e ^ k ∣ ϖ ^ c :=
