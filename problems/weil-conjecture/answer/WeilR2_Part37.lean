theorem wcpa_dj_lr1k_llcc_branch_bound : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (C : Scheme.{u}) (γ : C ⟶ wcProjK Ω 1), wcpaDjLkCov Ω γ → wcpaDjLkGalois γ →
    ∀ (X : Scheme.{u}) (uX : X ⟶ Spec (.of ↥W)) (ι : wcProjK Ω 1 ⟶ X)
      [QuasiCompact (γ ≫ ι)] [QuasiSeparated (γ ≫ ι)],
    wcpaDjLkModel W uX ι →
    ∀ y₀ : ↥(wcpaDjLkFib W (γ ≫ ι) uX),
      wcpaDjLkBad ((wcpaDjLkFib W (γ ≫ ι) uX).presheaf.stalk y₀) →
      wcpaDjLkSmAt W uX (wcpaDjLkPi W (γ ≫ ι) uX y₀) →
    ∀ (σ : Spec (.of ↥W) ⟶ X) (a : ↥W),
      wcpaDjLlPair W uX (wcpaDjLkImg W (γ ≫ ι) uX y₀) σ a →
      wcpaDjLlExh W γ uX ι (wcpaDjLkImg W (γ ≫ ι) uX y₀) σ a →
    ∀ (X' : Scheme.{u}) (r : X' ⟶ X) (ι' : wcProjK Ω 1 ⟶ X')
      [QuasiCompact (γ ≫ ι')] [QuasiSeparated (γ ≫ ι')],
      wcCsdIsBlowup (σ.ker ⊔ wcNcPrincipal (.of ↥W) X uX a) r → ι' ≫ r = ι →
      wcpaDjLkModel W (r ≫ uX) ι' →
      ∀ V : X.Opens, (V : Set X) = {wcpaDjLkImg W (γ ≫ ι) uX y₀}ᶜ → IsIso (r ∣_ V) →
      ∀ y' : ↥(wcpaDjLkFib W (γ ≫ ι') (r ≫ uX)),
        wcpaDjLkBad ((wcpaDjLkFib W (γ ≫ ι') (r ≫ uX)).presheaf.stalk y') →
        r (wcpaDjLkImg W (γ ≫ ι') (r ≫ uX) y') = wcpaDjLkImg W (γ ≫ ι) uX y₀ →
      ∀ (σ'' : Spec (.of ↥W) ⟶ X') (a'' : ↥W),
        wcpaDjLlPair W (r ≫ uX) (wcpaDjLkImg W (γ ≫ ι') (r ≫ uX) y') σ'' a'' →
        wcpaDjLlExh W γ (r ≫ uX) ι' (wcpaDjLkImg W (γ ≫ ι') (r ≫ uX) y') σ'' a'' →
      ∀ (X₂ : Scheme.{u}) (r₂ : X₂ ⟶ X') (ι₂ : wcProjK Ω 1 ⟶ X₂)
        [QuasiCompact (γ ≫ ι₂)] [QuasiSeparated (γ ≫ ι₂)],
        wcCsdIsBlowup (σ''.ker ⊔ wcNcPrincipal (.of ↥W) X' (r ≫ uX) a'') r₂ → ι₂ ≫ r₂ = ι' →
        wcpaDjLkModel W (r₂ ≫ r ≫ uX) ι₂ →
        ∀ V₂ : X'.Opens, (V₂ : Set X') = {wcpaDjLkImg W (γ ≫ ι') (r ≫ uX) y'}ᶜ →
          IsIso (r₂ ∣_ V₂) →
      ∀ (X₁ : Scheme.{u}) (r₁ : X₁ ⟶ X) (ι₁ : wcProjK Ω 1 ⟶ X₁)
        [QuasiCompact (γ ≫ ι₁)] [QuasiSeparated (γ ≫ ι₁)],
        wcCsdIsBlowup ((σ'' ≫ r).ker ⊔ wcNcPrincipal (.of ↥W) X uX (a * a'')) r₁ → ι₁ ≫ r₁ = ι →
        wcpaDjLkModel W (r₁ ≫ uX) ι₁ →
        ∀ V₁ : X.Opens, (V₁ : Set X) = {wcpaDjLkImg W (γ ≫ ι) uX y₀}ᶜ → IsIso (r₁ ∣_ V₁) →
      ∀ y₁ : ↥(wcpaDjLkFib W (γ ≫ ι₁) (r₁ ≫ uX)),
        wcpaDjLkBad ((wcpaDjLkFib W (γ ≫ ι₁) (r₁ ≫ uX)).presheaf.stalk y₁) →
        r₁ (wcpaDjLkImg W (γ ≫ ι₁) (r₁ ≫ uX) y₁) = wcpaDjLkImg W (γ ≫ ι) uX y₀ →
        ¬ wcpaDjLkSmAt W (r₁ ≫ uX) (wcpaDjLkPi W (γ ≫ ι₁) (r₁ ≫ uX) y₁) →
      ∀ q : X₂ ⟶ X₁, q ≫ r₁ = r₂ ≫ r → ι₂ ≫ q = ι₁ →
      ∀ Ψ : (γ ≫ ι₂).normalization ⟶ (γ ≫ ι₁).normalization,
        (γ ≫ ι₂).toNormalization ≫ Ψ = (γ ≫ ι₁).toNormalization →
        Ψ ≫ (γ ≫ ι₁).fromNormalization = (γ ≫ ι₂).fromNormalization ≫ q →
      ∀ y : ↥(wcpaDjLkFib W (γ ≫ ι₁) (r₁ ≫ uX)),
        wcpaDjLkImg W (γ ≫ ι₁) (r₁ ≫ uX) y = wcpaDjLkImg W (γ ≫ ι₁) (r₁ ≫ uX) y₁ →
        {v : ↥(wcpaDjLkFib W (γ ≫ ι₂) (r₂ ≫ r ≫ uX)) |
          Ψ (Limits.pullback.fst ((γ ≫ ι₂).fromNormalization ≫ r₂ ≫ r ≫ uX)
              (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) v) =
            Limits.pullback.fst ((γ ≫ ι₁).fromNormalization ≫ r₁ ≫ uX)
              (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) y ∧
          r (r₂ (wcpaDjLkImg W (γ ≫ ι₂) (r₂ ≫ r ≫ uX) v)) = wcpaDjLkImg W (γ ≫ ι) uX y₀ ∧
          ¬ wcpaDjLkSmAt W (r₂ ≫ r ≫ uX) (wcpaDjLkPi W (γ ≫ ι₂) (r₂ ≫ r ≫ uX) v)}.encard ≤
          wcpaDjLkBranches ((wcpaDjLkFib W (γ ≫ ι₁) (r₁ ≫ uX)).presheaf.stalk y) :=
by
  classical
  intro Ω _ _ W hW hWt C γ hcov hgal X uX ι _ _ hM y₀ hy₀ hSm σ a hP hExh X' r ι' _ _ hbl hι' hM'
    V hV hiso y' hb hi σ'' a'' hP'' hExh'' X₂ r₂ ι₂ _ _ hbl₂ hι₂ hM₂ V₂ hV₂ hiso₂
    X₁ r₁ ι₁ _ _ hbl₁ hι₁ hM₁ V₁ hV₁ hiso₁ y₁ hb₁ hi₁ hns q hq hqι Ψ hΨ1 hΨ2 y hy

  haveI hsci : IsClosedImmersion (Spec.map (CommRingCat.ofHom
      (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) :=
    IsClosedImmersion.spec_of_surjective _ IsLocalRing.residue_surjective
  have hinj : ∀ {Y : Scheme.{u}} (p : Y ⟶ Spec (.of ↥W)),
      Function.Injective (Limits.pullback.fst p (Spec.map (CommRingCat.ofHom
        (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) :=
    fun p => (Scheme.Hom.isClosedEmbedding _).toIsEmbedding.injective
  have hfst : ∀ {Y Z S T : Scheme.{u}} (p : Y ⟶ S) (t : T ⟶ S) (h : Z ⟶ Y)
      (y : ↥(Limits.pullback (h ≫ p) t)),
      Limits.pullback.fst p t (Limits.pullback.map (h ≫ p) t p t h (𝟙 _) (𝟙 _)
        (by simp) (by simp) y) = h (Limits.pullback.fst (h ≫ p) t y) := by
    intro Y Z S T p t h y
    have e : Limits.pullback.map (h ≫ p) t p t h (𝟙 _) (𝟙 _) (by simp) (by simp) ≫
        Limits.pullback.fst p t = Limits.pullback.fst (h ≫ p) t ≫ h :=
      Limits.pullback.lift_fst _ _ _
    rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, e]
  have himg : ∀ {Y Cc : Scheme.{u}} (f : Cc ⟶ Y) [QuasiCompact f] [QuasiSeparated f]
      (u : Y ⟶ Spec (.of ↥W)) (y : ↥(wcpaDjLkFib W f u)),
      wcpaDjLkImg W f u y = f.fromNormalization (Limits.pullback.fst (f.fromNormalization ≫ u)
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) y) := by
    intro Y Cc f _ _ u y
    exact hfst u (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))
      f.fromNormalization y
  have hcond : ∀ {Y Z S : Scheme.{u}} (f : Y ⟶ S) (g : Z ⟶ S) (z : ↥(Limits.pullback f g)),
      f (Limits.pullback.fst f g z) = g (Limits.pullback.snd f g z) := by
    intro Y Z S f g z
    rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, Limits.pullback.condition]

  have hpush : ∀ (F₂ F₁ : Scheme.{u}) (G : F₂ ⟶ F₁) (ζ v : ↥F₂)
      (Vv : ValuationSubring ↥(F₂.residueField ζ)), wcLlncDom F₂ ζ v Vv →
      wcLlncDom F₁ (G ζ) (G v) (Vv.comap (G.residueFieldMap ζ).hom) := by
    intro F₂ F₁ G ζ v Vv hdom
    obtain ⟨h, hD⟩ := hdom
    have h' : G ζ ⤳ G v := h.map G.continuous
    refine ⟨h', fun s => ?_⟩
    have key : (G.residueFieldMap ζ).hom
        ((F₁.presheaf.stalkSpecializes h' ≫ F₁.residue (G ζ)).hom s) =
        (F₂.presheaf.stalkSpecializes h ≫ F₂.residue ζ).hom ((G.stalkMap v).hom s) := by
      have e : (F₁.presheaf.stalkSpecializes h' ≫ F₁.residue (G ζ)) ≫ G.residueFieldMap ζ =
          G.stalkMap v ≫ F₂.presheaf.stalkSpecializes h ≫ F₂.residue ζ := by
        rw [Category.assoc, Scheme.residue_residueFieldMap, ← Category.assoc,
