    𝔫.comap (integralClosure (MvPolynomial (Fin s) ↥W) R).val with h𝔮
  have hX : ∀ i : Fin s, algebraMap (MvPolynomial (Fin s) ↥W)
      ↥(integralClosure (MvPolynomial (Fin s) ↥W) R) (MvPolynomial.X i) ∈ 𝔮 := by
    intro i
    show MvPolynomial.aeval z (MvPolynomial.X i) ∈ 𝔫
    rw [MvPolynomial.aeval_X]; exact hz𝔫 i
  have hm : ∀ w ∈ IsLocalRing.maximalIdeal ↥W,
      algebraMap ↥W ↥(integralClosure (MvPolynomial (Fin s) ↥W) R) w ∈ 𝔮 := by
    intro w hw
    show algebraMap ↥W R w ∈ 𝔫
    exact hI𝔫 (Ideal.mem_map_of_mem _ hw)
  obtain ⟨χB, hχBq, hχBu⟩ := t_intpt Ω W hW s ↥(integralClosure (MvPolynomial (Fin s) ↥W) R) hinjB
    inferInstance 𝔮 (Ideal.comap_isPrime _ _) hX hm

  have hr𝔮 : (⟨r, hrint⟩ : ↥(integralClosure (MvPolynomial (Fin s) ↥W) R)) ∉ 𝔮 := fun h => hr𝔫 h
  obtain ⟨χ, hχ⟩ := t_extend ↥W (MvPolynomial (Fin s) ↥W) R r hrint hrx χB (hχBu _ hr𝔮)

  obtain ⟨m, hmt⟩ := hrx t
  refine ⟨χ, ?_⟩
  have h1 : χ (r ^ m * t) = χB ⟨r ^ m * t, hmt⟩ := hχ ⟨r ^ m * t, hmt⟩
  have h2 : (⟨r ^ m * t, hmt⟩ : ↥(integralClosure (MvPolynomial (Fin s) ↥W) R)) ∈ 𝔮 := by
