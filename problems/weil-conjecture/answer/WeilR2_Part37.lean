        (algebraMap ↥W A ϖ) ^ l x * r ∈ wcGubIdl W A (fun _ : Fin 2 => ζ) ϖ x ^ P := by
      rw [← Ideal.Quotient.eq]
      simp only [map_mul, map_pow]
      exact h1
    rw [hspan, Ideal.mem_span_singleton'] at h2
    obtain ⟨t, ht⟩ := h2
    have h3 := congrArg Subtype.val ht
    simp only [Subalgebra.coe_mul, Subalgebra.coe_pow, Subalgebra.coe_algebraMap,
      Subalgebra.coe_sub] at h3
    have h4 := congrArg ψ h3
    simp only [map_mul, map_pow, map_sub, hψ.1] at h4
    obtain ⟨X, hX⟩ : ∃ X : ↥W, (X : Ω) = ψ (r : wcGubGen W A) :=
      ⟨⟨_, hptBox x ψ hψ _ r.2⟩, rfl⟩
    obtain ⟨T, hT⟩ : ∃ T : ↥W, (T : Ω) = ψ (t : wcGubGen W A) :=
      ⟨⟨_, hptBox x ψ hψ _ t.2⟩, rfl⟩
    rw [← hX, ← hT] at h4
    have h5 : X * X - ϖ ^ l x * X = ϖ ^ P * T := by
      apply Subtype.ext
      push_cast
      linear_combination -h4
    obtain ⟨u, hu⟩ := L2 ϖ X T (l x) P hϖ0 hϖm hP h5
    exact ⟨u, by rw [← hX, hu]; push_cast; ring⟩

  have hdivϖ : ∀ a : ↥W, a ≠ 0 → ∃ k : ℕ, a ∣ ϖ ^ k := by
    intro a ha
    by_cases ham : a ∈ IsLocalRing.maximalIdeal ↥W
    · obtain ⟨k, u, hk⟩ := hpowG a ha ϖ hϖm
      exact ⟨k, ⟨u, by rw [hk, mul_comm]⟩⟩
    · have hu : IsUnit a := by
        by_contra h
        exact ham ((IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr h))
      exact ⟨0, hu.dvd⟩
  have hdivx : ∀ a : ↥W, a ≠ 0 → ∀ x ∈ IsLocalRing.maximalIdeal ↥W, ∃ N : ℕ, a ∣ x ^ N := by
    intro a ha x hx
    obtain ⟨k, hk⟩ := hdivϖ a ha
    obtain ⟨K, u, hK⟩ := hpowG ϖ hϖ0 x hx
    refine ⟨K * k, dvd_trans hk ?_⟩
    rw [pow_mul, hK]
    exact ⟨u ^ k, by rw [mul_pow]; ring⟩

  by_contra hnd
  obtain ⟨o, ho⟩ : ∃ o : ℕ, o = wcIaOrd D r₁ r₀ o₁ o₀ i := ⟨_, rfl⟩
  rw [← ho] at hdiv
  obtain ⟨δ, hδ⟩ := (ValuationRing.dvd_total (E ^ K * ϖ ^ l E) (c i)).resolve_left hnd
  have hΘ0 : E ^ K * ϖ ^ l E ≠ 0 := mul_ne_zero (pow_ne_zero _ hE0) (pow_ne_zero _ hϖ0)
  have hδm : δ ∈ IsLocalRing.maximalIdeal ↥W := by
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    intro hu
    apply hnd
    obtain ⟨v, hv⟩ := hu
    exact ⟨↑v⁻¹, by rw [hδ, ← hv, mul_assoc, Units.mul_inv, mul_one]⟩
  obtain ⟨Kδ, uδ, hKδ⟩ := hpowG ϖ hϖ0 δ hδm
  obtain ⟨β', hβ'⟩ : ∃ β' : ↥W, β' ^ (Kδ * o + 1) = ϖ := by
    obtain ⟨x, hx⟩ := IsAlgClosed.exists_pow_nat_eq (ϖ : Ω) (Nat.succ_pos (Kδ * o))
    have hx0 : x ≠ 0 := by
      rintro rfl
      apply hϖ0
      apply Subtype.ext
      rw [← hx, zero_pow (Nat.succ_ne_zero _)]
      rfl
    rcases W.mem_or_inv_mem x with h | h
    · exact ⟨⟨x, h⟩, Subtype.ext (by rw [SubmonoidClass.coe_pow]; exact hx)⟩
    · exfalso
      apply hnu ϖ hϖm
      refine isUnit_of_dvd_one ⟨⟨x⁻¹, h⟩ ^ (Kδ * o + 1), ?_⟩
      apply Subtype.ext
      rw [MulMemClass.coe_mul, SubmonoidClass.coe_pow]
      show (1 : Ω) = (ϖ : Ω) * x⁻¹ ^ (Kδ * o + 1)
      rw [← hx, inv_pow, mul_inv_cancel₀ (pow_ne_zero _ hx0)]
  have hβ'0 : β' ≠ 0 := by
    intro h
    apply hϖ0
    rw [← hβ', h, zero_pow (Nat.succ_ne_zero _)]
  have hβ'm : β' ∈ IsLocalRing.maximalIdeal ↥W := by
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    intro h
    apply hnu ϖ hϖm
    rw [← hβ']
    exact h.pow _
  obtain ⟨E', hE'E, hE'β, hE'or⟩ : ∃ E' : ↥W, E' ∣ E ∧ E' ∣ β' ∧ (E' = E ∨ E' = β') := by
    by_cases h : E ∣ β'
    · exact ⟨E, dvd_rfl, h, Or.inl rfl⟩
    · exact ⟨β', (ValuationRing.dvd_total E β').resolve_left h, dvd_rfl, Or.inr rfl⟩
  have hE'0 : E' ≠ 0 := by
    rcases hE'or with h | h <;> rw [h]
    · exact hE0
    · exact hβ'0
  have hE'm : E' ∈ IsLocalRing.maximalIdeal ↥W := by
    rcases hE'or with h | h <;> rw [h]
    · exact hEm
    · exact hβ'm
  have hE'e₀ : E' ∣ e₀ := dvd_trans hE'E hEe₀
  obtain ⟨μ, hμ⟩ : ∃ μ : ℕ, μ = Q + 2 * l E' + 1 := ⟨_, rfl⟩
  obtain ⟨r', hr'⟩ := Ideal.Quotient.mk_surjective
    (AdicCompletion.evalₐ (wcGubIdl W A (fun _ : Fin 2 => ζ) ϖ E') μ (z E'))
  obtain ⟨K', R', hK'R'⟩ := hclear E' hE'0 (r' : wcGubGen W A) r'.2
  obtain ⟨N₁, hN₁⟩ := hdivx (ϖ ^ (Q + l E')) (pow_ne_zero _ hϖ0) E' hE'm
  obtain ⟨j', hj'⟩ := hdivϖ (E' ^ K') (pow_ne_zero _ hE'0)
  obtain ⟨n', hn'⟩ : ∃ n' : ℕ, n' = K' + N₁ := ⟨_, rfl⟩
  obtain ⟨M', hM'⟩ : ∃ M' : ℕ, M' = j' + (Q + l E') := ⟨_, rfl⟩
  obtain ⟨c', b₁, b₁', -, hR'⟩ := hSP n' M' R'
  have d1 : E' ^ K' * ϖ ^ l E' ∣ E' ^ n' := by
    rw [hn', pow_add]
    exact mul_dvd_mul_left _ (dvd_trans (pow_dvd_pow ϖ (by omega : l E' ≤ Q + l E')) hN₁)
  have d3 : E' ^ K' * ϖ ^ (Q + l E') ∣ E ^ n' := by
    rw [hn', pow_add E K' N₁]
    exact mul_dvd_mul (pow_dvd_pow_of_dvd hE'E K') (dvd_trans hN₁ (pow_dvd_pow_of_dvd hE'E N₁))
  have d4 : E' ^ K' * ϖ ^ (Q + l E') ∣ ϖ ^ M' := by
    rw [hM', pow_add ϖ j' (Q + l E')]
    exact mul_dvd_mul hj' dvd_rfl
  have d2 : E' ^ K' * ϖ ^ l E' ∣ ϖ ^ M' :=
    dvd_trans (mul_dvd_mul_left _ (pow_dvd_pow ϖ (by omega : l E' ≤ Q + l E'))) d4
  have hΘ'0 : E' ^ K' * ϖ ^ l E' ≠ 0 := mul_ne_zero (pow_ne_zero _ hE'0) (pow_ne_zero _ hϖ0)

  have HE' : ∀ ψ : wcGubGen W A →+* Ω, wcIaPt W A ζ E' ψ →
      ∃ u : ↥W, ψ (algebraMap A (wcGubGen W A) (wcIaSum W A ζ r₁ r₀ f₁ f₀ c')) =
        ((E' ^ K' * ϖ ^ l E' : ↥W) : Ω) * (u : Ω) := by
    intro ψ hψ
    obtain ⟨u₀, hu₀⟩ := L5 E' hE'0 hE'm μ (by omega) r' hr' ψ hψ
    obtain ⟨w, hw⟩ := hptZ E' hE'0 ψ hψ
    obtain ⟨a₁, ha₁⟩ := d1
    obtain ⟨a₂, ha₂⟩ := d2
    have ha₁' : (E' : Ω) ^ n' = (E' : Ω) ^ K' * (ϖ : Ω) ^ l E' * (a₁ : Ω) := by
      exact_mod_cast congrArg Subtype.val ha₁
    have ha₂' : (ϖ : Ω) ^ M' = (E' : Ω) ^ K' * (ϖ : Ω) ^ l E' * (a₂ : Ω) := by
      exact_mod_cast congrArg Subtype.val ha₂
    obtain ⟨B₁, hB₁⟩ : ∃ B : ↥W, (B : Ω) = ψ (algebraMap A (wcGubGen W A) b₁) :=
      ⟨⟨_, hψ.2.1 b₁⟩, rfl⟩
    obtain ⟨B₁', hB₁'⟩ : ∃ B : ↥W, (B : Ω) = ψ (algebraMap A (wcGubGen W A) b₁') :=
      ⟨⟨_, hψ.2.1 b₁'⟩, rfl⟩
    have hexp := congrArg ψ hK'R'
    rw [hR'] at hexp
    simp only [map_add, map_mul, map_pow, hψ.1] at hexp
    rw [hu₀, hw, ← hB₁, ← hB₁'] at hexp
    refine ⟨u₀ - a₁ * w ^ n' * B₁ - a₂ * B₁', ?_⟩
    push_cast
    linear_combination -hexp - (w : Ω) ^ n' * (B₁ : Ω) * ha₁' - (B₁' : Ω) * ha₂'
  have hi1 := (hNF E' hE'e₀ c' (E' ^ K' * ϖ ^ l E')).mp HE' i
  rw [← ho] at hi1

  obtain ⟨rp, hrp⟩ := Ideal.Quotient.mk_surjective
    (AdicCompletion.evalₐ (wcGubIdl W A (fun _ : Fin 2 => ζ) ϖ E) μ (z E))
  obtain ⟨t₁, ht₁⟩ := hC E' E hE'0 hE'm hE0 hEm hE'E μ r' rp hr' hrp
  have hrpQ := htransG _ _ _ _ _ (show Q ≤ μ by omega) _ hrp
  have hd2 : rp - r ∈ wcGubIdl W A (fun _ : Fin 2 => ζ) ϖ E ^ Q := by
    rw [← Ideal.Quotient.eq, hrpQ, hr]
  rw [hspan, Ideal.mem_span_singleton'] at hd2
  obtain ⟨t₂, ht₂⟩ := hd2
  have ht₂' := congrArg Subtype.val ht₂
  simp only [Subalgebra.coe_mul, Subalgebra.coe_pow, Subalgebra.coe_algebraMap,
    Subalgebra.coe_sub] at ht₂'
  obtain ⟨Xc, hXc⟩ : ∃ Xc : (ℕ × Fin r₁) ⊕ Fin r₀ →₀ ↥W,
      Xc = (E ^ K * ϖ ^ l E) • c' - (E' ^ K' * ϖ ^ l E') • c := ⟨_, rfl⟩
  have HE : ∀ ψ : wcGubGen W A →+* Ω, wcIaPt W A ζ E ψ →
      ∃ u : ↥W, ψ (algebraMap A (wcGubGen W A) (wcIaSum W A ζ r₁ r₀ f₁ f₀ Xc)) =
        ((E ^ K * E' ^ K' * ϖ ^ (Q + l E') : ↥W) : Ω) * (u : Ω) := by
    intro ψ hψ
    have hπ : ψ (algebraMap A (wcGubGen W A) (algebraMap ↥W A ϖ)) = (ϖ : Ω) := hψ.1 ϖ
    obtain ⟨w₀, hw₀⟩ := hptZ E hE0 ψ hψ
    obtain ⟨T₁, hT₁⟩ : ∃ T : ↥W, (T : Ω) = ψ (t₁ : wcGubGen W A) :=
      ⟨⟨_, hptBox E ψ hψ _ t₁.2⟩, rfl⟩
    obtain ⟨T₂, hT₂⟩ : ∃ T : ↥W, (T : Ω) = ψ (t₂ : wcGubGen W A) :=
      ⟨⟨_, hptBox E ψ hψ _ t₂.2⟩, rfl⟩
    obtain ⟨B, hB⟩ : ∃ B : ↥W, (B : Ω) = ψ (algebraMap A (wcGubGen W A) b) :=
      ⟨⟨_, hψ.2.1 b⟩, rfl⟩
    obtain ⟨B', hB'⟩ : ∃ B : ↥W, (B : Ω) = ψ (algebraMap A (wcGubGen W A) b') :=
      ⟨⟨_, hψ.2.1 b'⟩, rfl⟩
    obtain ⟨B₁, hB₁⟩ : ∃ B : ↥W, (B : Ω) = ψ (algebraMap A (wcGubGen W A) b₁) :=
      ⟨⟨_, hψ.2.1 b₁⟩, rfl⟩
    obtain ⟨B₁', hB₁'⟩ : ∃ B : ↥W, (B : Ω) = ψ (algebraMap A (wcGubGen W A) b₁') :=
      ⟨⟨_, hψ.2.1 b₁'⟩, rfl⟩
    obtain ⟨a₁, ha₁⟩ := d3
    obtain ⟨a₂, ha₂⟩ := d4
    obtain ⟨a₃, ha₃⟩ := hdn
    obtain ⟨a₄, ha₄⟩ := hdM
    have ha₁' : (E : Ω) ^ n' = (E' : Ω) ^ K' * (ϖ : Ω) ^ (Q + l E') * (a₁ : Ω) := by
      exact_mod_cast congrArg Subtype.val ha₁
    have ha₂' : (ϖ : Ω) ^ M' = (E' : Ω) ^ K' * (ϖ : Ω) ^ (Q + l E') * (a₂ : Ω) := by
      exact_mod_cast congrArg Subtype.val ha₂
    have ha₃' : (E : Ω) ^ n = (E : Ω) ^ K * (ϖ : Ω) ^ Q * (a₃ : Ω) := by
      exact_mod_cast congrArg Subtype.val ha₃
    have ha₄' : (ϖ : Ω) ^ M = (E : Ω) ^ K * (ϖ : Ω) ^ Q * (a₄ : Ω) := by
      exact_mod_cast congrArg Subtype.val ha₄
    have h1 := congrArg ψ ht₁
    simp only [map_sub, map_mul, map_pow, hπ] at h1
    rw [← hT₁] at h1
    have h2 := congrArg ψ ht₂'
    simp only [map_sub, map_mul, map_pow, hπ] at h2
    rw [← hT₂] at h2
    have hexpE := congrArg ψ hKR
    rw [hReq] at hexpE
    simp only [map_add, map_mul, map_pow, hψ.1] at hexpE
    rw [hw₀, ← hB, ← hB'] at hexpE
    have hexpE' := congrArg ψ hK'R'
    rw [hR'] at hexpE'
    simp only [map_add, map_mul, map_pow, hψ.1] at hexpE'
    rw [hw₀, ← hB₁, ← hB₁'] at hexpE'
    have hϖμ : (ϖ : Ω) ^ μ = (ϖ : Ω) ^ (Q + l E') * (ϖ : Ω) ^ (l E' + 1) := by
      rw [← pow_add, hμ]
      congr 1
      ring
    refine ⟨ϖ ^ (l E' + 1) * T₁ + T₂ - ϖ ^ l E * (a₁ * w₀ ^ n' * B₁ + a₂ * B₁') +
      (a₃ * w₀ ^ n * B + a₄ * B'), ?_⟩
    rw [hXc]
    simp only [hsum, map_sub, map_mul, map_pow, hψ.1]
    push_cast
    linear_combination ((E' : Ω) ^ K' * (ϖ : Ω) ^ l E') * hexpE -
      ((E : Ω) ^ K * (ϖ : Ω) ^ l E) * hexpE' + (E : Ω) ^ K * (E' : Ω) ^ K' * h1 -
      (E : Ω) ^ K * (E' : Ω) ^ K' * (ϖ : Ω) ^ l E' * h2 +
      (E : Ω) ^ K * (E' : Ω) ^ K' * (T₁ : Ω) * hϖμ -
      ((E : Ω) ^ K * (ϖ : Ω) ^ l E) * (w₀ : Ω) ^ n' * (B₁ : Ω) * ha₁' -
      ((E : Ω) ^ K * (ϖ : Ω) ^ l E) * (B₁' : Ω) * ha₂' +
      ((E' : Ω) ^ K' * (ϖ : Ω) ^ l E') * (w₀ : Ω) ^ n * (B : Ω) * ha₃' +
      ((E' : Ω) ^ K' * (ϖ : Ω) ^ l E') * (B' : Ω) * ha₄'
  have hX := (hNF E hEe₀ Xc (E ^ K * E' ^ K' * ϖ ^ (Q + l E'))).mp HE i
  rw [← ho] at hX
  have hΞ : E ^ K * E' ^ K' * ϖ ^ (Q + l E') =
      (E ^ K * ϖ ^ l E) * (E' ^ K' * ϖ ^ l E') * ϖ ^ (Q - l E) := by
    rw [show Q + l E' = l E + l E' + (Q - l E) by omega, pow_add, pow_add]
    ring
  have hY : (E ^ K * ϖ ^ l E) * (E' ^ K' * ϖ ^ l E') ∣ Xc i := by
    have h1 : ((E ^ K * ϖ ^ l E) * (E' ^ K' * ϖ ^ l E') * ϖ ^ (Q - l E)) ^ D =
        ((E ^ K * ϖ ^ l E) * (E' ^ K' * ϖ ^ l E')) ^ D * ϖ ^ (D * (Q - l E)) := by
      rw [mul_pow, ← pow_mul, mul_comm (Q - l E) D]
    rw [hΞ, h1] at hX
    have h2 := dvd_trans hX (mul_dvd_mul_left ((Xc i) ^ D) hdiv)
    have h3 := (mul_dvd_mul_iff_right (pow_ne_zero (D * (Q - l E)) hϖ0)).mp h2
    exact (IsIntegrallyClosed.pow_dvd_pow_iff (by omega : D ≠ 0)).mp h3
  rw [hXc] at hY
  simp only [Finsupp.coe_sub, Pi.sub_apply, Finsupp.smul_apply, smul_eq_mul] at hY
  exact L1 D o Kδ ϖ (E ^ K * ϖ ^ l E) (E' ^ K' * ϖ ^ l E') (c i) (c' i) δ uδ β' E' hD hΘ0
    hΘ'0 hδ hδm hKδ hβ' hE'β hi1 hY

theorem wcpa_dj_lr1k_nsr_gub_bff_dc_iad_truncate : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [Algebra ↥W A] (ϖ : ↥W) (ζ : A),
      wcBffBase W A ϖ → wcBffNoether W A ζ →
    ∀ (z : ∀ e : ↥W, wcGubCpl W A (fun _ : Fin 2 => ζ) ϖ e) (l : ↥W → ℕ),
      wcGubIdem W A (fun _ : Fin 2 => ζ) ϖ z l → wcGubCompat W A (fun _ : Fin 2 => ζ) ϖ z l →
    ∀ (e₀ : ↥W) (D r₁ r₀ : ℕ) (f₁ : Fin r₁ → A) (f₀ : Fin r₀ → A) (o₁ : Fin r₁ → ℕ)
      (o₀ : Fin r₀ → ℕ), e₀ ≠ 0 → e₀ ∈ IsLocalRing.maximalIdeal ↥W → 1 ≤ D →
      (∀ e : ↥W, e ∣ e₀ → wcIaNF W A ζ D r₁ r₀ f₁ f₀ o₁ o₀ e) →
      wcIaSP W A ϖ ζ r₁ r₀ f₁ f₀ →
    ∀ (E e ρ : ↥W), E ≠ 0 → E ∈ IsLocalRing.maximalIdeal ↥W → E ∣ e₀ → e ≠ 0 → e = E * ρ →
      ρ ∈ IsLocalRing.maximalIdeal ↥W →
    ∀ (Q : ℕ), 2 * l E + 1 ≤ Q →
    ∀ (r : ↥(wcGubBox W A (fun _ : Fin 2 => ζ) E)),
      Ideal.Quotient.mk (wcGubIdl W A (fun _ : Fin 2 => ζ) ϖ E ^ Q) r =
        AdicCompletion.evalₐ (wcGubIdl W A (fun _ : Fin 2 => ζ) ϖ E) Q (z E) →
    ∀ (K : ℕ) (R : A),
      algebraMap A (wcGubGen W A) (algebraMap ↥W A E) ^ K * (r : wcGubGen W A) =
        algebraMap A (wcGubGen W A) R →
    ∀ (c : (ℕ × Fin r₁) ⊕ Fin r₀ →₀ ↥W) (n M : ℕ) (b b' : A),
      (∀ i ∈ c.support, wcIaGrad r₁ r₀ i < n) →
      R = wcIaSum W A ζ r₁ r₀ f₁ f₀ c + ζ ^ n * b + algebraMap ↥W A ϖ ^ M * b' →
      E ^ K * ϖ ^ Q ∣ E ^ n → E ^ K * ϖ ^ Q ∣ ϖ ^ M →
    ∀ (s' j Kρ : ℕ) (uρ : ↥W) (omax L : ℕ), s' ≤ Q → E ∣ ϖ ^ j → ρ ^ Kρ = uρ * ϖ →
      (∀ k, o₁ k ≤ omax) → 1 ≤ L → Kρ * (D * s' + j * omax) ≤ L →
      (∀ i, wcIaGrad r₁ r₀ i < L → E ^ K * ϖ ^ l E ∣ c i) →
    ∃ a : A, ∀ ψ : wcGubGen W A →+* Ω, wcIaPt W A ζ e ψ →
      ∃ u : ↥W, ψ (algebraMap A (wcGubGen W A) (algebraMap ↥W A ϖ) ^ l E *
          algebraMap A (wcGubGen W A) a - (r : wcGubGen W A)) = (ϖ : Ω) ^ s' * (u : Ω) :=
by
  intro Ω _ _ W hdimW hWt A _ _ ϖ ζ hbase hN z l hI hC e₀ D r₁ r₀ f₁ f₀ o₁ o₀ he₀ he₀m hD hNF
    hSP E e ρ hE0 hEm hEe₀ he heρ hρm Q hQ r hrE K R hKR c n M b b' hcg hReq hdn hdM
    s' j Kρ uρ omax L hs'Q hEj hKρ ho₁ hL1 hLb hhead
  classical

  have hunitW : ∀ w : ↥W, w ≠ 0 →
      IsUnit (algebraMap A (wcGubGen W A) (algebraMap ↥W A w)) := by
    intro w hw
    exact IsLocalization.map_units (wcGubGen W A)
      (⟨algebraMap (↥W) A w, Submonoid.mem_map_of_mem _ (mem_nonZeroDivisors_of_ne_zero hw)⟩ :
        Submonoid.map (algebraMap (↥W) A) (nonZeroDivisors ↥W))

  have hptBox : ∀ (w : ↥W) (ψ : wcGubGen W A →+* Ω), wcIaPt W A ζ w ψ →
      ∀ y ∈ wcGubBox W A (fun _ : Fin 2 => ζ) w, ψ y ∈ W := by
    intro w ψ hψ y hy
    have hy' : y ∈ Algebra.adjoin A (Set.range fun _ : Fin 2 =>
        algebraMap A (wcGubGen W A) ζ *
          Ring.inverse (algebraMap A (wcGubGen W A) (algebraMap ↥W A w))) := hy
    clear hy
    induction hy' using Algebra.adjoin_induction with
    | mem x hx =>
      obtain ⟨i, rfl⟩ := hx
      exact hψ.2.2
    | algebraMap a => exact hψ.2.1 a
    | add x y _ _ hx hy => rw [map_add]; exact W.add_mem _ _ hx hy
    | mul x y _ _ hx hy => rw [map_mul]; exact W.mul_mem _ _ hx hy

  have hzeta : ∀ x : ↥W, x ≠ 0 → ∀ ψ : wcGubGen W A →+* Ω, wcIaPt W A ζ x ψ →
      ∃ w₀ : ↥W, ψ (algebraMap A (wcGubGen W A) ζ) = (x : Ω) * (w₀ : Ω) := by
    intro x hx ψ hψ
    have h2 : ψ (algebraMap A (wcGubGen W A) ζ) =
        ψ (algebraMap A (wcGubGen W A) ζ *
          Ring.inverse (algebraMap A (wcGubGen W A) (algebraMap ↥W A x))) *
        ψ (algebraMap A (wcGubGen W A) (algebraMap ↥W A x)) := by
      rw [← map_mul, mul_assoc, Ring.inverse_mul_cancel _ (hunitW x hx), mul_one]
    refine ⟨⟨_, hψ.2.2⟩, ?_⟩
    rw [h2, hψ.1 x]
    exact mul_comm _ _

  have hbound : ∀ i, (E ^ K) ^ D ∣ c i ^ D * E ^ wcIaOrd D r₁ r₀ o₁ o₀ i := by
    refine (hNF E hEe₀ c (E ^ K)).mp ?_
    intro ψ hψ
    obtain ⟨w₁, hw₁⟩ := hzeta E hE0 ψ hψ
    obtain ⟨d₁, hd₁⟩ := hdn
    obtain ⟨d₂, hd₂⟩ := hdM
    have hd₁' : ((E ^ n : ↥W) : Ω) = ((E ^ K * ϖ ^ Q * d₁ : ↥W) : Ω) := by rw [hd₁]
    have hd₂' : ((ϖ ^ M : ↥W) : Ω) = ((E ^ K * ϖ ^ Q * d₂ : ↥W) : Ω) := by rw [hd₂]
    push_cast at hd₁' hd₂'
    obtain ⟨yr, hyr⟩ : ∃ y : ↥W, (y : Ω) = ψ (r : wcGubGen W A) :=
      ⟨⟨_, hptBox E ψ hψ _ r.2⟩, rfl⟩
    obtain ⟨yb, hyb⟩ : ∃ y : ↥W, (y : Ω) = ψ (algebraMap A (wcGubGen W A) b) :=
      ⟨⟨_, hψ.2.1 b⟩, rfl⟩
    obtain ⟨yb', hyb'⟩ : ∃ y : ↥W, (y : Ω) = ψ (algebraMap A (wcGubGen W A) b') :=
      ⟨⟨_, hψ.2.1 b'⟩, rfl⟩
    have hR1 : ψ (algebraMap A (wcGubGen W A) R) = (E : Ω) ^ K * ψ (r : wcGubGen W A) := by
      rw [← hKR]; simp only [map_mul, map_pow, hψ.1]
    have hR2 : ψ (algebraMap A (wcGubGen W A) R) =
        ψ (algebraMap A (wcGubGen W A) (wcIaSum W A ζ r₁ r₀ f₁ f₀ c)) +
          ψ (algebraMap A (wcGubGen W A) ζ) ^ n * ψ (algebraMap A (wcGubGen W A) b) +
          (ϖ : Ω) ^ M * ψ (algebraMap A (wcGubGen W A) b') := by
      rw [hReq]; simp only [map_add, map_mul, map_pow, hψ.1]
    rw [hw₁] at hR2
    refine ⟨yr - ϖ ^ Q * d₁ * w₁ ^ n * yb - ϖ ^ Q * d₂ * yb', ?_⟩
    push_cast
    rw [hyr, hyb, hyb']
    linear_combination hR1 - hR2 - ((w₁ : Ω) ^ n * ψ (algebraMap A (wcGubGen W A) b)) * hd₁' -
      ψ (algebraMap A (wcGubGen W A) b') * hd₂'

  have tailDiv : ∀ (ν : ℕ) (k : Fin r₁), L ≤ ν →
      E ^ K * ϖ ^ s' ∣ c (Sum.inl (ν, k)) * e ^ ν := by
    intro ν k hν
    have hνD : ν ≤ D * ν := Nat.le_mul_of_pos_left ν hD
    have h1 : ϖ ^ (D * s' + j * omax) ∣ ρ ^ (D * ν) := by
      obtain ⟨t, ht⟩ : ∃ t, D * ν = Kρ * (D * s' + j * omax) + t :=
        ⟨D * ν - Kρ * (D * s' + j * omax), by omega⟩
      rw [ht, pow_add ρ, pow_mul ρ Kρ, hKρ, mul_pow]
      exact (dvd_mul_left _ _).mul_right _
    have h2 : E ^ o₁ k * ϖ ^ (D * s') ∣ ϖ ^ (D * s' + j * omax) := by
      obtain ⟨t, ht⟩ : ∃ t, j * omax = j * o₁ k + t :=
        ⟨j * omax - j * o₁ k, by have := Nat.mul_le_mul_left j (ho₁ k); omega⟩
      rw [ht, pow_add ϖ (D * s'), pow_add ϖ (j * o₁ k), pow_mul ϖ j (o₁ k),
        mul_comm (E ^ o₁ k)]
      exact mul_dvd_mul_left _ ((pow_dvd_pow_of_dvd hEj _).mul_right _)
    have hb := hbound (Sum.inl (ν, k))
    simp only [wcIaOrd, Sum.elim_inl] at hb
    rw [pow_add] at hb
    have h3 : (E ^ K * ϖ ^ s') ^ D ∣ (c (Sum.inl (ν, k)) * e ^ ν) ^ D := by
      have e1 : (E ^ K * ϖ ^ s') ^ D = (E ^ K) ^ D * ϖ ^ (D * s') := by ring
      have e2 : (c (Sum.inl (ν, k)) * e ^ ν) ^ D =
          c (Sum.inl (ν, k)) ^ D * E ^ (D * ν) * ρ ^ (D * ν) := by rw [heρ]; ring
      rw [e1, e2]
      calc (E ^ K) ^ D * ϖ ^ (D * s')
          ∣ c (Sum.inl (ν, k)) ^ D * E ^ (D * ν) * E ^ o₁ k * ϖ ^ (D * s') :=
            by convert mul_dvd_mul_right hb (ϖ ^ (D * s')) using 1; ring
        _ = c (Sum.inl (ν, k)) ^ D * E ^ (D * ν) * (E ^ o₁ k * ϖ ^ (D * s')) := by ring
        _ ∣ c (Sum.inl (ν, k)) ^ D * E ^ (D * ν) * ρ ^ (D * ν) :=
            mul_dvd_mul_left _ (h2.trans h1)
    exact (IsIntegrallyClosed.pow_dvd_pow_iff (by omega : D ≠ 0)).mp h3

  have hq' : ∀ i, ∃ q : ↥W, wcIaGrad r₁ r₀ i < L → c i = E ^ K * ϖ ^ l E * q := by
    intro i
    by_cases h : wcIaGrad r₁ r₀ i < L
    · obtain ⟨q, hq⟩ := hhead i h
      exact ⟨q, fun _ => hq⟩
    · exact ⟨0, fun h' => absurd h' h⟩
  choose q hq using hq'
  obtain ⟨a, ha⟩ : ∃ a : A, a = ∑ i ∈ c.support,
      algebraMap ↥W A (if wcIaGrad r₁ r₀ i < L then q i else 0) *
        Sum.elim (fun p : ℕ × Fin r₁ => ζ ^ p.1 * f₁ p.2) f₀ i := ⟨_, rfl⟩
  obtain ⟨T, hT⟩ : ∃ T : A, T = ∑ i ∈ c.support,
      algebraMap ↥W A (if wcIaGrad r₁ r₀ i < L then 0 else c i) *
        Sum.elim (fun p : ℕ × Fin r₁ => ζ ^ p.1 * f₁ p.2) f₀ i := ⟨_, rfl⟩
  have hsplit : wcIaSum W A ζ r₁ r₀ f₁ f₀ c =
      algebraMap ↥W A (E ^ K * ϖ ^ l E) * a + T := by
    rw [ha, hT, Finset.mul_sum, ← Finset.sum_add_distrib]
    unfold wcIaSum Finsupp.sum
    refine Finset.sum_congr rfl (fun i _ => ?_)
    dsimp only
    by_cases h : wcIaGrad r₁ r₀ i < L
    · rw [if_pos h, if_pos h, hq i h, map_mul (algebraMap ↥W A) (E ^ K * ϖ ^ l E) (q i),
        map_zero, zero_mul, add_zero, mul_assoc]
    · rw [if_neg h, if_neg h, map_zero, zero_mul, mul_zero, zero_add]

  have htail : ∀ ψ : wcGubGen W A →+* Ω, wcIaPt W A ζ e ψ → ∃ uT : ↥W,
      ψ (algebraMap A (wcGubGen W A) T) = (E : Ω) ^ K * (ϖ : Ω) ^ s' * (uT : Ω) := by
    intro ψ hψ
    obtain ⟨w₀, hw₀⟩ := hzeta e he ψ hψ
    rw [hT, map_sum, map_sum]
    refine Finset.sum_induction _
      (fun y => ∃ uT : ↥W, y = (E : Ω) ^ K * (ϖ : Ω) ^ s' * (uT : Ω)) ?_ ?_ ?_
    · rintro _ _ ⟨u₁, rfl⟩ ⟨u₂, rfl⟩
      exact ⟨u₁ + u₂, by push_cast; ring⟩
    · exact ⟨0, by simp⟩
    · intro i _
      beta_reduce
      rcases i with ⟨ν, k⟩ | k
      · by_cases h : wcIaGrad r₁ r₀ (Sum.inl (ν, k)) < L
        · rw [if_pos h]
          exact ⟨0, by simp⟩
        · rw [if_neg h]
          have hν : L ≤ ν := by
            simp only [wcIaGrad, Sum.elim_inl] at h
            omega
          obtain ⟨d, hd⟩ := tailDiv ν k hν
          have hd' : ((c (Sum.inl (ν, k)) * e ^ ν : ↥W) : Ω) =
              ((E ^ K * ϖ ^ s' * d : ↥W) : Ω) := by rw [hd]
          push_cast at hd'
          obtain ⟨y, hy⟩ : ∃ y : ↥W, (y : Ω) = ψ (algebraMap A (wcGubGen W A) (f₁ k)) :=
            ⟨⟨_, hψ.2.1 _⟩, rfl⟩
          refine ⟨d * w₀ ^ ν * y, ?_⟩
          simp only [Sum.elim_inl, map_mul, map_pow, hψ.1, hw₀]
          push_cast
          rw [hy]
          linear_combination ((w₀ : Ω) ^ ν * ψ (algebraMap A (wcGubGen W A) (f₁ k))) * hd'
      · have h : wcIaGrad r₁ r₀ (Sum.inr k) < L := by
          simp only [wcIaGrad, Sum.elim_inr]
          omega
        rw [if_pos h]
        exact ⟨0, by simp⟩

  refine ⟨a, ?_⟩
  intro ψ hψ
  obtain ⟨uT, huT⟩ := htail ψ hψ
  obtain ⟨w₀, hw₀⟩ := hzeta e he ψ hψ
  obtain ⟨d₁, hd₁⟩ := hdn
  obtain ⟨d₂, hd₂⟩ := hdM
  have hd₁' : ((E ^ n : ↥W) : Ω) = ((E ^ K * ϖ ^ Q * d₁ : ↥W) : Ω) := by rw [hd₁]
  have hd₂' : ((ϖ ^ M : ↥W) : Ω) = ((E ^ K * ϖ ^ Q * d₂ : ↥W) : Ω) := by rw [hd₂]
  push_cast at hd₁' hd₂'
  obtain ⟨yb, hyb⟩ : ∃ y : ↥W, (y : Ω) = ψ (algebraMap A (wcGubGen W A) b) :=
    ⟨⟨_, hψ.2.1 b⟩, rfl⟩
  obtain ⟨yb', hyb'⟩ : ∃ y : ↥W, (y : Ω) = ψ (algebraMap A (wcGubGen W A) b') :=
    ⟨⟨_, hψ.2.1 b'⟩, rfl⟩
  have hR1 : ψ (algebraMap A (wcGubGen W A) R) = (E : Ω) ^ K * ψ (r : wcGubGen W A) := by
    rw [← hKR]; simp only [map_mul, map_pow, hψ.1]
  have hR2 : ψ (algebraMap A (wcGubGen W A) R) =
      ψ (algebraMap A (wcGubGen W A) (wcIaSum W A ζ r₁ r₀ f₁ f₀ c)) +
        ψ (algebraMap A (wcGubGen W A) ζ) ^ n * ψ (algebraMap A (wcGubGen W A) b) +
        (ϖ : Ω) ^ M * ψ (algebraMap A (wcGubGen W A) b') := by
    rw [hReq]; simp only [map_add, map_mul, map_pow, hψ.1]
  have hS : ψ (algebraMap A (wcGubGen W A) (wcIaSum W A ζ r₁ r₀ f₁ f₀ c)) =
      (E : Ω) ^ K * (ϖ : Ω) ^ l E * ψ (algebraMap A (wcGubGen W A) a) +
        ψ (algebraMap A (wcGubGen W A) T) := by
    rw [hsplit]; simp only [map_add, map_mul, map_pow, hψ.1]
  have hEK : (E : Ω) ^ K ≠ 0 := pow_ne_zero _ (fun h => hE0 (Subtype.ext h))
  have heρΩ : (e : Ω) = (E : Ω) * (ρ : Ω) := by simp [heρ]
  have hQs : (ϖ : Ω) ^ Q = (ϖ : Ω) ^ s' * (ϖ : Ω) ^ (Q - s') := by
    rw [← pow_add, Nat.add_sub_cancel' hs'Q]
  rw [hw₀, heρΩ] at hR2
  refine ⟨-(uT + ϖ ^ (Q - s') * d₁ * ρ ^ n * w₀ ^ n * yb + ϖ ^ (Q - s') * d₂ * yb'), ?_⟩
  simp only [map_sub, map_mul, map_pow, hψ.1]
  push_cast
  rw [hyb, hyb']
  apply mul_left_cancel₀ hEK
  linear_combination hR1 - hR2 - hS - huT -
    ((ρ : Ω) ^ n * (w₀ : Ω) ^ n * ψ (algebraMap A (wcGubGen W A) b)) * hd₁' -
    ψ (algebraMap A (wcGubGen W A) b') * hd₂' -
    ((E : Ω) ^ K * (d₁ : Ω) * (ρ : Ω) ^ n * (w₀ : Ω) ^ n * ψ (algebraMap A (wcGubGen W A) b) +
      (E : Ω) ^ K * (d₂ : Ω) * ψ (algebraMap A (wcGubGen W A) b')) * hQs

theorem wcpa_dj_lr1k_nsr_gub_bff_dc_ia_density : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [Algebra ↥W A] (ϖ : ↥W) (ζ : A),
      wcBffBase W A ϖ → wcBffNoether W A ζ →
    ∀ (z : ∀ e : ↥W, wcGubCpl W A (fun _ : Fin 2 => ζ) ϖ e) (l : ↥W → ℕ),
      wcGubIdem W A (fun _ : Fin 2 => ζ) ϖ z l → wcGubCompat W A (fun _ : Fin 2 => ζ) ϖ z l →
    ∀ (e₀ : ↥W) (D r₁ r₀ : ℕ) (f₁ : Fin r₁ → A) (f₀ : Fin r₀ → A) (o₁ : Fin r₁ → ℕ)
      (o₀ : Fin r₀ → ℕ), e₀ ≠ 0 → e₀ ∈ IsLocalRing.maximalIdeal ↥W → 1 ≤ D →
      (∀ e : ↥W, e ∣ e₀ → wcIaNF W A ζ D r₁ r₀ f₁ f₀ o₁ o₀ e) →
      wcIaSP W A ϖ ζ r₁ r₀ f₁ f₀ →
    ∀ e : ↥W, e ≠ 0 → e ∈ IsLocalRing.maximalIdeal ↥W → ∀ s : ℕ, ∃ (a : A) (P : ℕ),
      ∀ r : ↥(wcGubBox W A (fun _ : Fin 2 => ζ) e),
        Ideal.Quotient.mk (wcGubIdl W A (fun _ : Fin 2 => ζ) ϖ e ^ P) r =
          AdicCompletion.evalₐ (wcGubIdl W A (fun _ : Fin 2 => ζ) ϖ e) P (z e) →
        ∀ ψ : wcGubGen W A →+* Ω, wcIaPt W A ζ e ψ →
          ∃ u : ↥W, ψ (algebraMap A (wcGubGen W A) (algebraMap ↥W A ϖ) ^ l e *
              algebraMap A (wcGubGen W A) a - (r : wcGubGen W A)) = (ϖ : Ω) ^ s * (u : Ω) :=
by
  intro Ω _ _ W hdimW hWt A _ _ ϖ ζ hbase hN z l hI hC e₀ D r₁ r₀ f₁ f₀ o₁ o₀ he₀ he₀m hD hNF
    hSP e he hem s
  classical
  have hbase' := hbase
  obtain ⟨hϖ0, hϖm, -, -, -, -, -, -⟩ := hbase'
  have hϖΩ : (ϖ : Ω) ≠ 0 := fun h => hϖ0 (Subtype.ext h)
  have hnu : ∀ w ∈ IsLocalRing.maximalIdeal ↥W, ¬ IsUnit w := fun w hw =>
    mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal _).mp hw)
  have hunitW : ∀ w : ↥W, w ≠ 0 →
      IsUnit (algebraMap A (wcGubGen W A) (algebraMap ↥W A w)) := by
    intro w hw
    exact IsLocalization.map_units (wcGubGen W A)
      (⟨algebraMap (↥W) A w, Submonoid.mem_map_of_mem _ (mem_nonZeroDivisors_of_ne_zero hw)⟩ :
        Submonoid.map (algebraMap (↥W) A) (nonZeroDivisors ↥W))

  have hpowG : ∀ x : ↥W, x ≠ 0 → ∀ y ∈ IsLocalRing.maximalIdeal ↥W,
      ∃ K : ℕ, ∃ u : ↥W, y ^ K = u * x := by
    intro x hx y hy
    haveI : Ring.KrullDimLE 1 ↥W := Ring.krullDimLE_iff.mpr hdimW
    have hle : IsLocalRing.maximalIdeal ↥W ≤ (Ideal.span {x}).radical := by
      rw [Ideal.radical_eq_sInf]
      refine le_sInf ?_
      rintro P ⟨hPx, hPp⟩
      have hP0 : P ≠ ⊥ := by
        intro h
        apply hx
        have : x ∈ P := hPx (Ideal.mem_span_singleton_self x)
        rw [h] at this
        exact (Submodule.mem_bot _).mp this
      haveI := hPp
      have hPmax : P.IsMaximal := Ideal.isMaximal_of_isPrime_of_ne_bot P hP0
      exact le_of_eq (IsLocalRing.eq_maximalIdeal hPmax).symm
    obtain ⟨K, hK⟩ := hle hy
    obtain ⟨u, hu⟩ := Ideal.mem_span_singleton'.mp hK
    exact ⟨K, u, hu.symm⟩

  have hptBox : ∀ (w : ↥W) (ψ : wcGubGen W A →+* Ω), wcIaPt W A ζ w ψ →
      ∀ y ∈ wcGubBox W A (fun _ : Fin 2 => ζ) w, ψ y ∈ W := by
    intro w ψ hψ y hy
    have hy' : y ∈ Algebra.adjoin A (Set.range fun _ : Fin 2 =>
        algebraMap A (wcGubGen W A) ζ *
          Ring.inverse (algebraMap A (wcGubGen W A) (algebraMap ↥W A w))) := hy
    clear hy
    induction hy' using Algebra.adjoin_induction with
    | mem x hx =>
      obtain ⟨i, rfl⟩ := hx
      exact hψ.2.2
    | algebraMap a => exact hψ.2.1 a
    | add x y _ _ hx hy => rw [map_add]; exact W.add_mem _ _ hx hy
    | mul x y _ _ hx hy => rw [map_mul]; exact W.mul_mem _ _ hx hy

  have hclear : ∀ (w : ↥W), w ≠ 0 → ∀ y ∈ wcGubBox W A (fun _ : Fin 2 => ζ) w,
      ∃ (K : ℕ) (R : A),
        algebraMap A (wcGubGen W A) (algebraMap ↥W A w) ^ K * y = algebraMap A (wcGubGen W A) R := by
    intro w hw y hy
    have hy' : y ∈ Algebra.adjoin A (Set.range fun _ : Fin 2 =>
        algebraMap A (wcGubGen W A) ζ *
          Ring.inverse (algebraMap A (wcGubGen W A) (algebraMap ↥W A w))) := hy
    clear hy
    induction hy' using Algebra.adjoin_induction with
    | mem x hx =>
      obtain ⟨i, rfl⟩ := hx
      refine ⟨1, ζ, ?_⟩
      rw [pow_one]
      show algebraMap A (wcGubGen W A) (algebraMap ↥W A w) *
          (algebraMap A (wcGubGen W A) ζ *
            Ring.inverse (algebraMap A (wcGubGen W A) (algebraMap ↥W A w))) =
        algebraMap A (wcGubGen W A) ζ
      rw [mul_left_comm, Ring.mul_inverse_cancel _ (hunitW w hw), mul_one]
    | algebraMap a => exact ⟨0, a, by simp⟩
    | add x y _ _ hx hy =>
      obtain ⟨K₁, R₁, h₁⟩ := hx
      obtain ⟨K₂, R₂, h₂⟩ := hy
      refine ⟨K₁ + K₂, algebraMap ↥W A w ^ K₂ * R₁ + algebraMap ↥W A w ^ K₁ * R₂, ?_⟩
      rw [map_add, map_mul, map_mul, map_pow, map_pow, ← h₁, ← h₂]
      ring
    | mul x y _ _ hx hy =>
      obtain ⟨K₁, R₁, h₁⟩ := hx
      obtain ⟨K₂, R₂, h₂⟩ := hy
      refine ⟨K₁ + K₂, R₁ * R₂, ?_⟩
      rw [map_mul, ← h₁, ← h₂]
      ring
  have htransG : ∀ (R : Type u) [CommRing R] (I : Ideal R) (y : AdicCompletion I R)
      (n N : ℕ), n ≤ N → ∀ a : R,
      Ideal.Quotient.mk (I ^ N) a = AdicCompletion.evalₐ I N y →
      Ideal.Quotient.mk (I ^ n) a = AdicCompletion.evalₐ I n y := by
    intro R _ I y n N hnN a ha
    obtain ⟨s, hs⟩ := AdicCompletion.mk_surjective I R y
    rw [← hs, AdicCompletion.evalₐ_mk] at ha ⊢
    rw [Ideal.Quotient.eq] at ha ⊢
    have h1 : a - s N ∈ I ^ n := Ideal.pow_le_pow_right hnN ha
    have h2 := s.2 hnN
    rw [SModEq.sub_mem] at h2
    have h3 : s n - s N ∈ I ^ n := by simpa [smul_eq_mul, Ideal.mul_top] using h2
    have : a - s n = (a - s N) - (s n - s N) := by ring
    rw [this]
    exact Ideal.sub_mem _ h1 h3

  obtain ⟨β, hβ⟩ : ∃ β : ↥W, β ^ 2 = e := by
    obtain ⟨x, hx⟩ := IsAlgClosed.exists_pow_nat_eq (e : Ω) (by norm_num : 0 < 2)
    have hx0 : x ≠ 0 := by
      rintro rfl
      apply he
      apply Subtype.ext
      rw [← hx]
      simp
    rcases W.mem_or_inv_mem x with h | h
    · exact ⟨⟨x, h⟩, Subtype.ext (by rw [SubmonoidClass.coe_pow]; exact hx)⟩
    · exfalso
      apply hnu e hem
      refine isUnit_of_dvd_one ⟨⟨x⁻¹, h⟩ ^ 2, ?_⟩
      apply Subtype.ext
      rw [MulMemClass.coe_mul, SubmonoidClass.coe_pow]
      show (1 : Ω) = (e : Ω) * x⁻¹ ^ 2
      rw [← hx, inv_pow, mul_inv_cancel₀ (pow_ne_zero _ hx0)]
  have hβ0 : β ≠ 0 := by
    rintro rfl
    apply he
    rw [← hβ]
    simp
  have hβm : β ∈ IsLocalRing.maximalIdeal ↥W := by
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    intro h
    apply hnu e hem
    rw [← hβ]
    exact h.pow 2
  obtain ⟨E, hEβ, hEe₀, hEor⟩ : ∃ E : ↥W, E ∣ β ∧ E ∣ e₀ ∧ (E = β ∨ E = e₀) := by
    by_cases h : β ∣ e₀
    · exact ⟨β, dvd_rfl, h, Or.inl rfl⟩
