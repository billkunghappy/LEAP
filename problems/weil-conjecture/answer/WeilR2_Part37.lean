  have b0 := wcpa_dj_lr1k_ll_bad_local_bounds Ω W hW hWt C γ hcov X uX ι hM y₀ hy₀
  have b' := wcpa_dj_lr1k_ll_bad_local_bounds Ω W hW hWt C γ hcov X' (r ≫ uX) ι' hM' y' hb
  have b1 := wcpa_dj_lr1k_ll_bad_local_bounds Ω W hW hWt C γ hcov X₁ (r₁ ≫ uX) ι₁ hM₁ y₁ hb₁
  have f0 := wcpa_dj_lr1k_ll_fibre_finite Ω W hW hWt C γ hcov X uX ι hM
    (wcpaDjLkImg W (γ ≫ ι) uX y₀)
  have f' := wcpa_dj_lr1k_ll_fibre_finite Ω W hW hWt C γ hcov X' (r ≫ uX) ι' hM'
    (wcpaDjLkImg W (γ ≫ ι') (r ≫ uX) y')
  have f1 := wcpa_dj_lr1k_ll_fibre_finite Ω W hW hWt C γ hcov X₁ (r₁ ≫ uX) ι₁ hM₁
    (wcpaDjLkImg W (γ ≫ ι₁) (r₁ ≫ uX) y₁)

  have o := wcpa_dj_lr1k_llce_orbit_le Ω W hW hWt C γ hcov hgal X uX ι hM y₀ X' r ι' hι' hM' y' hi
  have nc1 := wcpa_dj_lr1k_llce_node_count Ω W hW hWt C γ hcov hgal X uX ι hM y₀ hy₀ hSm σ a hP
    hExh X' r ι' hbl hι' hM' V hV hiso
  have nc2 := wcpa_dj_lr1k_llce_node_count Ω W hW hWt C γ hcov hgal X' (r ≫ uX) ι' hM' y' hb hSm'
    σ'' a'' hP'' hExh'' X₂ r₂ ι₂ hbl₂ hι₂ hM₂ V₂ hV₂' hiso₂
  have dl := wcpa_dj_lr1k_llce_delta_ineq Ω W hW hWt C γ hcov hgal X uX ι hM y₀ hy₀ hSm σ a hP
    hExh X' r ι' hbl hι' hM' V hV hiso y' hb hi σ'' a'' hP'' hExh'' X₂ r₂ ι₂ hbl₂ hι₂ hM₂
    V₂ hV₂' hiso₂ X₁ r₁ ι₁ hbl₁ hι₁ hM₁ V₁ hV₁ hiso₁ y₁ hb₁ hi₁ hns
  have cc := wcpa_dj_lr1k_llce_contraction_count Ω W hW hWt C γ hcov hgal X uX ι hM y₀ hy₀ hSm
