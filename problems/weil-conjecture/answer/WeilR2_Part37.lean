    rw [Subring.smul_def, ← ha j, iterateFrobenius_def, ← hcy j, Algebra.smul_def,
      Algebra.smul_def, mul_pow, map_pow]

  have s3 : ∀ (k : Type u) [Field k] (R : Type u) [CommRing R] [IsDomain R]
      [Algebra (Polynomial k) R], Module.Finite (Polynomial k) R →
      Function.Injective (algebraMap (Polynomial k) R) →
