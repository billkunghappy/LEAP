    intro k
    induction k with
    | zero =>
      intro s _ P hP hv
      have h0 := hv 0
      rw [Polynomial.eq_C_of_natDegree_le_zero hP, Polynomial.eval_C] at h0
      rw [Polynomial.eq_C_of_natDegree_le_zero hP]
      exact map_dvd Polynomial.C h0
    | succ k ih =>
      intro s hs P hP hv
      obtain ⟨a, ha⟩ : ∃ a, a = s (Fin.last (k + 1)) := ⟨_, rfl⟩
      obtain ⟨P₁, hP₁⟩ : ∃ P₁, P₁ = P /ₘ (Polynomial.X - Polynomial.C a) := ⟨_, rfl⟩
      have hid : P = Polynomial.C (P.eval a) + (Polynomial.X - Polynomial.C a) * P₁ := by
        rw [hP₁, ← Polynomial.modByMonic_X_sub_C_eq_C_eval,
          Polynomial.modByMonic_add_div P (Polynomial.X - Polynomial.C a)]
      have hdeg : P₁.natDegree ≤ k := by
        rw [hP₁, Polynomial.natDegree_divByMonic P (Polynomial.monic_X_sub_C a),
          Polynomial.natDegree_X_sub_C]
        omega
      have hva : d ∣ P.eval a := by rw [ha]; exact hv _
      have h1 : Polynomial.C d ∣ P₁ := by
        refine ih (fun i => s i.castSucc)
          (fun i j hij => hs _ _ (fun h => hij (Fin.castSucc_injective _ h))) P₁ hdeg ?_
        intro i
        have e : P.eval (s i.castSucc) = P.eval a + (s i.castSucc - a) * P₁.eval (s i.castSucc) := by
          conv_lhs => rw [hid]
          simp
        have hd : d ∣ (s i.castSucc - a) * P₁.eval (s i.castSucc) := by
          have h2 := dvd_sub (hv i.castSucc) hva
          rw [e, add_sub_cancel_left] at h2
