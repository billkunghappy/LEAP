          · exact Subring.subset_closure (Set.mem_union_left _ hmemX0)
          · exact Subring.subset_closure (Set.mem_union_right _ ⟨1, rfl⟩)
      intro s
      rw [← hhominv _ s]
      exact hgen _)
    (by
      refine ⟨Φ.comp (Scheme.ΓSpecIso (.of (wcNcRing W b))).hom.hom, ?_, ?_⟩
      · apply RingHom.ext
        intro x
        rw [← hhominv _ x]
        simp only [RingHom.comp_apply]
