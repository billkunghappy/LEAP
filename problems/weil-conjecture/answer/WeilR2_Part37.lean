theorem wcpa_dj_lr1k_nsr_na_er_gauss : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω)
    (L : Type u) [Field L] (A : ValuationSubring L) (φ : Ω →+* L),
    (∀ b : Ω, A.valuation (φ b) ≤ 1 ↔ b ∈ W) → ∀ s : L,
    (∀ n : ℕ, 1 ≤ n → ∀ b : Ω, A.valuation (s ^ n) ≠ A.valuation (φ b)) →
    (∀ P : Polynomial Ω, P ≠ 0 → P.eval₂ φ s ≠ 0) ∧
    ∀ P₁ P₂ : Polynomial Ω, P₂.eval₂ φ s ≠ 0 →
      A.valuation (P₁.eval₂ φ s) ≤ A.valuation (P₂.eval₂ φ s) →
      ∃ b : ↥W, A.valuation (P₁.eval₂ φ s - φ b * P₂.eval₂ φ s) < A.valuation (P₂.eval₂ φ s) :=
