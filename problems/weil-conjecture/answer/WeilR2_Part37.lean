      (RingHom.injective _) p
    have hC : (integralClosure (Polynomial k) (FractionRing R)).toSubmodule.FG := by
      refine s4 (Polynomial k) (FractionRing R) p e _ N hN ?_ ?_
      · intro x hx
        exact hpow x hx
      · exact ⟨p ^ e, fun r => Polynomial.X ^ (r : ℕ), fun a => by
