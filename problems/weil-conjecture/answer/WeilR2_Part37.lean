        (LinearMap.range ιP).mkQ (Submodule.injective_subtype _) (Submodule.mkQ_surjective _)
        (LinearMap.exact_subtype_mkQ _)
      have hN : Module.length R (LinearMap.range ιP) ≤ 1 := by
        have hker : IsLocalRing.maximalIdeal R ≤ LinearMap.ker ιP.rangeRestrict := by
          intro r hr
          rw [LinearMap.mem_ker]
          apply Subtype.ext
          funext i
