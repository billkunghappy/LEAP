    have h1 : (∑ j, (lam j : Ω) * ψ j z) * (w : Ω) = 0 := by
      rw [Finset.sum_mul, ← hA a]
      exact Finset.sum_congr rfl (fun j _ => by rw [← hj j]; ring)
    have hw0' : (w : Ω) ≠ 0 := fun h => hw0 (Subtype.ext h)
