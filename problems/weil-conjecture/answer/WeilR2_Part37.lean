            (q - MvPolynomial.C (MvPolynomial.eval (fun _ : Fin 1 => t) q)) := by
          rw [map_add, map_add]; ring
        rw [e]
        exact J.add_mem hp hq
      | mul_X p n hp =>
        have hn : n = 0 := Subsingleton.elim n 0
        subst hn
        have e : p * MvPolynomial.X 0 -
            MvPolynomial.C (MvPolynomial.eval (fun _ : Fin 1 => t) (p * MvPolynomial.X 0)) =
