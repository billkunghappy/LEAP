    (by
      have hgen : ∀ z : wcNcRing W b,
          (Scheme.ΓSpecIso (.of (wcNcRing W b))).inv.hom z ∈
          Subring.closure (Set.range hS.appTop.hom ∪
            Set.range ![1, (Scheme.ΓSpecIso (.of (wcNcRing W b))).inv.hom
              (Ideal.Quotient.mk (wcNcIdeal W b) (MvPolynomial.X 1))]) := by
        intro z
        obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective z
        induction p using MvPolynomial.induction_on with
        | C w =>
          exact Subring.subset_closure (Set.mem_union_left _ (hmemC w))
        | add f g hf hg =>
          have e : (Scheme.ΓSpecIso (.of (wcNcRing W b))).inv.hom
              (Ideal.Quotient.mk (wcNcIdeal W b) (f + g)) =
              (Scheme.ΓSpecIso (.of (wcNcRing W b))).inv.hom
                (Ideal.Quotient.mk (wcNcIdeal W b) f) +
              (Scheme.ΓSpecIso (.of (wcNcRing W b))).inv.hom
                (Ideal.Quotient.mk (wcNcIdeal W b) g) := by
            rw [map_add, map_add]
          rw [e]
          exact Subring.add_mem _ hf hg
        | mul_X f n hf =>
          have e : (Scheme.ΓSpecIso (.of (wcNcRing W b))).inv.hom
              (Ideal.Quotient.mk (wcNcIdeal W b) (f * MvPolynomial.X n)) =
              (Scheme.ΓSpecIso (.of (wcNcRing W b))).inv.hom
                (Ideal.Quotient.mk (wcNcIdeal W b) f) *
              (Scheme.ΓSpecIso (.of (wcNcRing W b))).inv.hom
                (Ideal.Quotient.mk (wcNcIdeal W b) (MvPolynomial.X n)) := by
            rw [map_mul, map_mul]
          rw [e]
          refine Subring.mul_mem _ hf ?_
          have hn : n = 0 ∨ n = 1 := by
            rcases n with ⟨_ | _ | k, hk⟩
            · exact Or.inl rfl
            · exact Or.inr rfl
            · omega
