    exact (hunitπ.mul_right_eq_zero).mp h1

  haveI hnoeth : IsNoetherianRing (Localization.Away (algebraMap ↥(wcGubBox W A g c)
      (wcGubCpl W A g ϖ c) (algebraMap A ↥(wcGubBox W A g c) (algebraMap ↥W A ϖ)))) :=
    wcpa_dj_lr1s_ncgr_completed_noetherian Ω W hW ϖ hϖ0 hϖnu hdiv
      (wcGubBox W A g c) (wcGubGen W A) hinj hftR hftG inferInstance hgen
  have hminfin := minimalPrimes.finite_of_isNoetherianRing (Localization.Away (algebraMap
    ↥(wcGubBox W A g c) (wcGubCpl W A g ϖ c) (algebraMap A ↥(wcGubBox W A g c) (algebraMap ↥W A ϖ))))

  refine ⟨algebraMap (wcGubCpl W A g ϖ c) _ (algebraMap ↥(wcGubBox W A g c)
      (wcGubCpl W A g ϖ c) a) * (IsLocalization.Away.invSelf (algebraMap ↥(wcGubBox W A g c)
        (wcGubCpl W A g ϖ c) (algebraMap A ↥(wcGubBox W A g c) (algebraMap ↥W A ϖ)))) ^ j, ?_, ?_⟩
  rotate_left
  · rw [mul_left_comm, ← mul_pow, IsLocalization.Away.mul_invSelf, one_pow, mul_one]
  have heq : algebraMap (wcGubCpl W A g ϖ c) (Localization.Away (algebraMap ↥(wcGubBox W A g c)
      (wcGubCpl W A g ϖ c) (algebraMap A ↥(wcGubBox W A g c) (algebraMap ↥W A ϖ))))
      (algebraMap ↥(wcGubBox W A g c) (wcGubCpl W A g ϖ c)
        (algebraMap A ↥(wcGubBox W A g c) (algebraMap ↥W A ϖ))) ^ j *
      (algebraMap (wcGubCpl W A g ϖ c) _ (algebraMap ↥(wcGubBox W A g c)
        (wcGubCpl W A g ϖ c) a) * (IsLocalization.Away.invSelf (algebraMap ↥(wcGubBox W A g c)
          (wcGubCpl W A g ϖ c) (algebraMap A ↥(wcGubBox W A g c) (algebraMap ↥W A ϖ)))) ^ j) =
      algebraMap (wcGubCpl W A g ϖ c) _ (algebraMap ↥(wcGubBox W A g c)
        (wcGubCpl W A g ϖ c) a) := by
    rw [mul_left_comm, ← mul_pow, IsLocalization.Away.mul_invSelf, one_pow, mul_one]
  generalize (algebraMap (wcGubCpl W A g ϖ c) _ (algebraMap ↥(wcGubBox W A g c)
      (wcGubCpl W A g ϖ c) a) * (IsLocalization.Away.invSelf (algebraMap ↥(wcGubBox W A g c)
        (wcGubCpl W A g ϖ c) (algebraMap A ↥(wcGubBox W A g c) (algebraMap ↥W A ϖ)))) ^ j :
      Localization.Away (algebraMap ↥(wcGubBox W A g c)
      (wcGubCpl W A g ϖ c) (algebraMap A ↥(wcGubBox W A g c) (algebraMap ↥W A ϖ)))) = x at heq ⊢

  by_contra hx
  have hq : ∃ 𝔮 ∈ minimalPrimes (Localization.Away (algebraMap ↥(wcGubBox W A g c)
      (wcGubCpl W A g ϖ c) (algebraMap A ↥(wcGubBox W A g c) (algebraMap ↥W A ϖ)))),
      ¬ IsIntegral (wcGubCpl W A g ϖ c) (Ideal.Quotient.mk 𝔮 x) := by
    by_contra h
    push_neg at h
    exact hx (min_primes _ _ hminfin x h)
  obtain ⟨𝔮, h𝔮, hbad⟩ := hq
  have h𝔮p : 𝔮.IsPrime := h𝔮.1.1

  obtain ⟨χ, χ₀, hχ, hWc, hχx⟩ := wcpa_dj_lr1k_nsr_gub_itmp_si_max_domain Ω W hW ϖ hϖ0 hϖnu hdiv
    (wcGubBox W A g c) hftR hπnzd 𝔮 h𝔮p x hbad

  let χ₁ : ↥(wcGubBox W A g c) →+* AdicCompletion (Ideal.span {ϖ}) ↥W :=
    χ₀.comp (algebraMap ↥(wcGubBox W A g c) (wcGubCpl W A g ϖ c))
  have hχ₁ : ∀ w : ↥W, χ₁ (algebraMap ↥W ↥(wcGubBox W A g c) w) =
      algebraMap ↥W (AdicCompletion (Ideal.span {ϖ}) ↥W) w := fun w => hWc w

  obtain ⟨θ, hθW, y, hy⟩ := wcpa_dj_lr1k_nsr_gub_itmp_si_density Ω W hW ϖ hϖ0 hϖnu hdiv
    (wcGubBox W A g c) hftR (wcGubGen W A) hinj hunitπ hgen' hdim χ₁ hχ₁ a j
  obtain ⟨s, hs⟩ := hpt θ (fun w => hθW w)
  have hχ₁a : χ₁ a = algebraMap ↥W (AdicCompletion (Ideal.span {ϖ}) ↥W) ϖ ^ j *
      (algebraMap ↥W (AdicCompletion (Ideal.span {ϖ}) ↥W) s - y) := by
    rw [hs, map_mul, map_pow] at hy
    linear_combination -hy

  have hW0 : ∀ z : ↥W, ϖ * z = 0 → z = 0 := fun z hz =>
    (mul_eq_zero.mp hz).resolve_left hϖ0
  have hϖnzd := (wcpa_dj_lr1s_nf_adic_completion_basics (↥W) ϖ hW0).1
  have hϖmem : algebraMap ↥W (AdicCompletion (Ideal.span {ϖ}) ↥W) ϖ ∈
      nonZeroDivisors (AdicCompletion (Ideal.span {ϖ}) ↥W) := by
    rw [mem_nonZeroDivisors_iff_right]
