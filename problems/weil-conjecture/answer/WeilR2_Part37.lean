  have hCA' : wcNsrCentred (γ ≫ ι₀).toNormalization (wcNdPt W (γ ≫ ι₀) u₀ w) (A.comap ψ) := by
    refine ⟨hc, fun a => ?_, fun a s hs hmul => ?_⟩
