  have hcinj : ∀ (F₂ F₁ : Scheme.{u}) (G : F₂ ⟶ F₁) (ζ : ↥F₂), IsIso (G.stalkMap ζ) →
      ∀ (Va Vb : ValuationSubring ↥(F₂.residueField ζ)),
      Va.comap (G.residueFieldMap ζ).hom = Vb.comap (G.residueFieldMap ζ).hom → Va = Vb := by
    intro F₂ F₁ G ζ hiso' Va Vb hVV
    have hsurj : Function.Surjective (G.residueFieldMap ζ).hom := by
