      show (Spec.map ψ ≫ A.fromSpecResidueField ξ') ≫ G = _
      rw [Category.assoc, ← Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField,
        ← Spec.map_comp_assoc, hφψ, Spec.map_id, Category.id_comp]
    let S : ValuativeCommSq G :=
      { R := V, K := B.residueField (G ξ'), i₁ := i₁, i₂ := i₂,
        commSq := ⟨e0.trans e1.symm⟩ }
    have : S.commSq.HasLift := hE S
    let l : Spec (CommRingCat.of V) ⟶ A := S.commSq.lift
    have hl1 : Spec.map ιV ≫ l = i₁ := S.commSq.fac_left
    have hl2 : l ≫ G = i₂ := S.commSq.fac_right
