      by_cases hPn : P = 𝔫
      · subst hPn; rw [h1b]; exact Ideal.mul_mem_left _ _ ha
      · have : P ∈ T := by
          rw [Finset.mem_erase, Set.Finite.mem_toFinset]; exact ⟨hPn, hPm⟩
        exact Ideal.mul_mem_right _ _ (hbT P this)
    · intro y hy
      rw [nilpotent_iff_mem_prime]
      intro P hP
      have hPm := IsArtinianRing.isMaximal_of_isPrime P
      by_cases hPn : P = 𝔫
      · subst hPn; exact Ideal.mul_mem_left _ _ hy
      · have : P ∈ T := by
          rw [Finset.mem_erase, Set.Finite.mem_toFinset]; exact ⟨hPn, hPm⟩
        exact Ideal.mul_mem_right _ _ (hbT P this)
  set I : Ideal A := (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) ⊔ Ideal.span {ζ}
    with hI
  set J : Ideal A := Ideal.span {algebraMap ↥W A ϖ, ζ} with hJ
  set π := Ideal.Quotient.mk I with hπ

  have s1 : IsArtinianRing (A ⧸ I) := by
    obtain ⟨n, s, hs⟩ := hζN
    have hker : ∀ a ∈ IsLocalRing.maximalIdeal ↥W, (π.comp (algebraMap ↥W A)) a = 0 := by
      intro a ha
      rw [RingHom.comp_apply, hπ, Ideal.Quotient.eq_zero_iff_mem]
      exact Ideal.mem_sup_left (Ideal.mem_map_of_mem _ ha)
    let φ : IsLocalRing.ResidueField ↥W →+* A ⧸ I :=
      Ideal.Quotient.lift (IsLocalRing.maximalIdeal ↥W) (π.comp (algebraMap ↥W A)) hker
