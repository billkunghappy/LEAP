theorem wcpa_dj_lr1k_nsr_gub_bff_dc_ia_pbc_tb_values_coeff : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω) (d : ↥W) (Q : Polynomial ↥W), (∀ s : ↥W, d ∣ Q.eval s) → ∀ n : ℕ, d ∣ Q.coeff n :=
by
  intro Ω _ _ W d Q hQ n
  classical

  have avoid : ∀ (m : ℕ) (s : Fin m → ↥W), ∃ t : ↥W, ∀ i, IsUnit (t - s i) := by
    intro m s
    obtain ⟨P, hP⟩ : ∃ P : Polynomial ↥W, P = ∏ i, (Polynomial.X - Polynomial.C (s i)) := ⟨_, rfl⟩
    have hPm : P.Monic := by
      rw [hP]
      exact Polynomial.monic_prod_of_monic _ _ (fun i _ => Polynomial.monic_X_sub_C (s i))
    have hXP : (Polynomial.X * P).Monic := Polynomial.monic_X.mul hPm
    have hdeg : (Polynomial.X * P).natDegree = P.natDegree + 1 := by
      rw [Polynomial.Monic.natDegree_mul Polynomial.monic_X hPm, Polynomial.natDegree_X]; ring
    obtain ⟨f, hf⟩ : ∃ f : Polynomial ↥W, f = Polynomial.X * P - 1 := ⟨_, rfl⟩
    have hlt : (1 : Polynomial ↥W).degree < (Polynomial.X * P).degree := by
      rw [Polynomial.degree_one]
      exact Polynomial.natDegree_pos_iff_degree_pos.mp (by omega)
    have hfm : f.Monic := by
      rw [hf]; exact hXP.sub_of_left hlt
    have hfdeg : f.natDegree = P.natDegree + 1 := by
      rw [hf, Polynomial.natDegree_sub_eq_left_of_natDegree_lt (by rw [Polynomial.natDegree_one]; omega), hdeg]
    have hgdeg : (f.map (algebraMap ↥W Ω)).degree ≠ 0 := by
      rw [hfm.degree_map, Polynomial.degree_eq_natDegree hfm.ne_zero, hfdeg]
      exact_mod_cast (Nat.succ_ne_zero P.natDegree)
    obtain ⟨τ, hτ⟩ := IsAlgClosed.exists_root _ hgdeg
    have hτ' : Polynomial.eval₂ (algebraMap ↥W Ω) τ f = 0 := by
      rw [← Polynomial.eval_map]; exact hτ
    have hint : _root_.IsIntegral ↥W τ := ⟨f, hfm, hτ'⟩
    obtain ⟨t, ht⟩ := IsIntegrallyClosed.isIntegral_iff.mp hint
    have hft : f.eval t = 0 := by
      have h1 : algebraMap ↥W Ω (f.eval t) = 0 := by
        rw [← Polynomial.eval₂_at_apply, ht]; exact hτ'
      exact (map_eq_zero_iff _ (IsFractionRing.injective ↥W Ω)).mp h1
    have h2 : t * ∏ i, (t - s i) = 1 := by
      rw [hf, hP] at hft
      simp only [Polynomial.eval_sub, Polynomial.eval_mul, Polynomial.eval_X, Polynomial.eval_prod,
        Polynomial.eval_C, Polynomial.eval_one] at hft
      exact sub_eq_zero.mp hft
    refine ⟨t, fun i => ?_⟩
    exact isUnit_of_dvd_one (dvd_trans
      (Finset.dvd_prod_of_mem (fun j => t - s j) (Finset.mem_univ i))
      (Dvd.intro_left t h2))

  have fam : ∀ k : ℕ, ∃ s : Fin k → ↥W, ∀ i j, i ≠ j → IsUnit (s i - s j) := by
    intro k
    induction k with
    | zero => exact ⟨Fin.elim0, fun i => Fin.elim0 i⟩
    | succ k ih =>
