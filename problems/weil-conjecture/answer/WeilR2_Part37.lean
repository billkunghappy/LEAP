      haveI : ∀ x : X, _root_.IsReduced (X.presheaf.stalk x) := by
        intro x
        obtain ⟨U, hU, hxU, -⟩ := exists_isAffineOpen_mem_and_subset (x := x) (U := ⊤) trivial
        have hσflat : (wcCnSigma uX U).Flat := by
