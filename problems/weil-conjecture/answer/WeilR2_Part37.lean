  intro L Ω _ _ W S _ _ ι κS O ev V hinj hO hunit hconst hV f
  have hmem : ∀ s : S, ι s ∈ O := fun s => (hO _).2 ⟨s, rfl⟩
  have key : ∀ s : S, s ∈ IsLocalRing.maximalIdeal S ↔ ev ⟨ι s, hmem s⟩ = 0 := by
    intro s
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    have hu : IsUnit s ↔ IsUnit (⟨ι s, hmem s⟩ : ↥O) := by
      constructor
      · rintro ⟨u, rfl⟩
        refine ⟨⟨⟨ι u, hmem _⟩, ⟨ι ↑u⁻¹, hmem _⟩, ?_, ?_⟩, rfl⟩
        · apply Subtype.ext
          show ι ↑u * ι ↑u⁻¹ = 1
          rw [← map_mul, Units.mul_inv, map_one]
        · apply Subtype.ext
          show ι ↑u⁻¹ * ι ↑u = 1
          rw [← map_mul, Units.inv_mul, map_one]
      · rintro ⟨w, hw⟩
        obtain ⟨t, ht⟩ := (hO _).1 ((↑w⁻¹ : ↥O)).2
        have hst : s * t = 1 := by
          apply hinj
          rw [map_mul, map_one, ht]
          have h1 : ((w : ↥O) : L) * ((↑w⁻¹ : ↥O) : L) = 1 := by
            have := congrArg (fun x : ↥O => (x : L)) w.mul_inv
            exact this
          have h2 : ((w : ↥O) : L) = ι s := by rw [hw]
          rw [← h2]
          exact h1
        exact ⟨⟨s, t, hst, by rw [mul_comm]; exact hst⟩, rfl⟩
    rw [hu, hunit, not_not]
  constructor
  · intro hf
    obtain ⟨hfO, hW⟩ := (hV f).1 hf
    obtain ⟨g, rfl⟩ := (hO _).1 hfO
    refine ⟨g, ⟨ev ⟨ι g, hfO⟩, hW⟩, rfl, ?_⟩
    rw [key]
    have e1 : (⟨ι (g - κS (ev ⟨ι g, hfO⟩)), hmem _⟩ : ↥O) =
        ⟨ι g, hfO⟩ - ⟨ι (κS (ev ⟨ι g, hfO⟩)), hmem _⟩ := Subtype.ext (by simp)
    rw [e1, map_sub, hconst (ev ⟨ι g, hfO⟩) ⟨ι (κS (ev ⟨ι g, hfO⟩)), hmem _⟩ rfl, sub_self]
  · rintro ⟨g, c, rfl, hgc⟩
    rw [hV]
    refine ⟨hmem g, ?_⟩
    rw [key] at hgc
    have e1 : (⟨ι (g - κS (c : Ω)), hmem _⟩ : ↥O) =
        ⟨ι g, hmem g⟩ - ⟨ι (κS (c : Ω)), hmem _⟩ := Subtype.ext (by simp)
    rw [e1, map_sub, hconst (c : Ω) ⟨ι (κS (c : Ω)), hmem _⟩ rfl, sub_eq_zero] at hgc
    rw [hgc]
    exact c.2

