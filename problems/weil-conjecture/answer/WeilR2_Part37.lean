    intro Z ζ t hζt hne hdim
    obtain ⟨E, hE, hsub⟩ :=
      exists_mem_irreducibleComponents_subset_of_isIrreducible _
        (isIrreducible_singleton (x := ζ)).closure
    have hEc : IsClosed E := isClosed_of_mem_irreducibleComponents E hE
    have hEi : IsIrreducible E := hE.1
    obtain ⟨ξ, hξ⟩ := QuasiSober.sober hEi hEc
    have hξζ : ξ ⤳ ζ := hξ.specializes (hsub (subset_closure rfl))
    by_cases hξeq : ξ = ζ
