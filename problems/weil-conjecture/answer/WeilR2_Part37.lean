    exact IsClosedImmersion.of_comp ρ uM
  have hιx₀ : V.ι (σV (IsLocalRing.closedPoint ↥W)) = σ (IsLocalRing.closedPoint ↥W) := by
    rw [← Scheme.Hom.comp_apply σV V.ι (IsLocalRing.closedPoint ↥W), hσV]

  have hsupp1 : ∀ z ∈ (((σ.ker ⊔ wcNcPrincipal (.of ↥W) Y uY b).comap V.ι).support :
      Set V.toScheme), z = σV (IsLocalRing.closedPoint ↥W) := by
    intro z hz
    rw [Scheme.IdealSheafData.support_comap] at hz
    have h1 := (wcpa_dj_nc_centre_props Ω W hW Y uY σ b hYlfp hYsep hσ hb0 hbm).2.1 (V.ι z) hz
    apply V.ι.isOpenEmbedding.injective
    rw [h1, hιx₀]
  have hsupp2 : ∀ z ∈ (((ρ.ker ⊔ wcNcPrincipal (.of ↥W) M uM b).comap h).support :
      Set V.toScheme), z = σV (IsLocalRing.closedPoint ↥W) := by
    intro z hz
    rw [Scheme.IdealSheafData.support_comap] at hz
    have h1 := (wcpa_dj_nc_centre_props Ω W hW M uM ρ b hMlfp hMsep hρs hb0 hbm).2.1 (h z) hz
    exact hfib z h1

  obtain ⟨O, hOrange, hO⟩ := wcpa_dj_nc_shrink_kernel _ M V.toScheme h ρ σV hh hρci hρ
  have hrange : Set.range σV ⊆ Set.range O.ι := by rw [Scheme.Opens.range_ι]; exact hOrange
  obtain ⟨ΔO, hΔOfac⟩ : ∃ s : Spec (.of ↥W) ⟶ O.toScheme, s ≫ O.ι = σV :=
    ⟨_, IsOpenImmersion.lift_fac _ _ hrange⟩
  have K1 := hO O ΔO le_rfl hΔOfac
  have K2 := wcpa_dj_mscc_ker_restrict_open Y V (.of ↥W) σ σV hσci hσV
  have K3 := wcpa_dj_mscc_ker_restrict_open V.toScheme O (.of ↥W) σV ΔO hσVci hΔOfac
  have LOC : ((σ.ker ⊔ wcNcPrincipal (.of ↥W) Y uY b).comap V.ι).comap O.ι =
      ((ρ.ker ⊔ wcNcPrincipal (.of ↥W) M uM b).comap h).comap O.ι := by
    rw [← Scheme.IdealSheafData.comap_comp, ← Scheme.IdealSheafData.comap_comp,
      Scheme.IdealSheafData.comap_sup, Scheme.IdealSheafData.comap_sup, K1,
      Scheme.IdealSheafData.comap_comp σ.ker O.ι V.ι, K2, K3, wcpa_dj_nc_ofIdealTop_comap,
      wcpa_dj_nc_ofIdealTop_comap, Category.assoc, Category.assoc, hcomm]

  obtain ⟨U', hU'aff, hU'mem, -⟩ := exists_isAffineOpen_mem_and_subset
    (x := ΔO (IsLocalRing.closedPoint ↥W)) (U := (⊤ : O.toScheme.Opens)) trivial
  have hV₀ : IsAffineOpen (O.ι ''ᵁ U') := hU'aff.image_of_isOpenImmersion O.ι
  have hx₀V₀ : σV (IsLocalRing.closedPoint ↥W) ∈ O.ι ''ᵁ U' := by
    have e : σV (IsLocalRing.closedPoint ↥W) = O.ι (ΔO (IsLocalRing.closedPoint ↥W)) := by
      rw [← Scheme.Hom.comp_apply ΔO O.ι (IsLocalRing.closedPoint ↥W), hΔOfac]
    rw [e]
    exact Set.mem_image_of_mem _ hU'mem
  have hsurj : Function.Surjective (O.ι.appIso U').inv.hom := by
    intro y
    refine ⟨(O.ι.appIso U').hom.hom y, ?_⟩
    rw [← CommRingCat.comp_apply, Iso.hom_inv_id, CommRingCat.id_apply]
  have EQ : ((σ.ker ⊔ wcNcPrincipal (.of ↥W) Y uY b).comap V.ι).ideal ⟨O.ι ''ᵁ U', hV₀⟩ =
      ((ρ.ker ⊔ wcNcPrincipal (.of ↥W) M uM b).comap h).ideal ⟨O.ι ''ᵁ U', hV₀⟩ := by
    have e1 := Scheme.IdealSheafData.ideal_comap_of_isOpenImmersion
      ((σ.ker ⊔ wcNcPrincipal (.of ↥W) Y uY b).comap V.ι) O.ι ⟨U', hU'aff⟩
    have e2 := Scheme.IdealSheafData.ideal_comap_of_isOpenImmersion
      ((ρ.ker ⊔ wcNcPrincipal (.of ↥W) M uM b).comap h) O.ι ⟨U', hU'aff⟩
    rw [LOC] at e1
    rw [e1] at e2
    exact Ideal.comap_injective_of_surjective _ hsurj e2

  apply le_antisymm
  · apply wcpa_dj_lr1k_ll_dp_local_le V.toScheme _ _ _ (O.ι ''ᵁ U') hV₀ hx₀V₀ hsupp2
    intro i hi
    refine ⟨1, ?_, ?_⟩
    · rw [Scheme.basicOpen_one]; exact hx₀V₀
    · rw [one_mul, ← EQ]; exact hi
  · apply wcpa_dj_lr1k_ll_dp_local_le V.toScheme _ _ _ (O.ι ''ᵁ U') hV₀ hx₀V₀ hsupp1
    intro i hi
    refine ⟨1, ?_, ?_⟩
    · rw [Scheme.basicOpen_one]; exact hx₀V₀
    · rw [one_mul, EQ]; exact hi

theorem wcpa_dj_lr1k_lldf_pullback_pt_inj : ∀ (X Y S : Scheme.{u}) (f : X ⟶ S) (g : Y ⟶ S), Etale g → ∀ z z' : ↥(Limits.pullback f g), Limits.pullback.fst f g z = Limits.pullback.fst f g z' → Limits.pullback.snd f g z = Limits.pullback.snd f g z' → IsSepClosed (S.residueField (g (Limits.pullback.snd f g z))) → z = z' :=
by
  intro X Y S f g hg z z' hfst hsnd hsep
  have s1 : ∀ y : Y, IsSepClosed (S.residueField (g y)) → IsIso (g.residueFieldMap y) := by
    intro y hy
    haveI : Etale g := hg
    letI := (g.stalkMap y).hom.toAlgebra
    haveI : Algebra.FormallyUnramified (S.presheaf.stalk (g y)) (Y.presheaf.stalk y) :=
      FormallyUnramified.stalkMap g y
    haveI : Algebra.EssFiniteType (S.presheaf.stalk (g y)) (Y.presheaf.stalk y) :=
      LocallyOfFiniteType.stalkMap g y
    haveI : IsLocalHom (algebraMap (S.presheaf.stalk (g y)) (Y.presheaf.stalk y)) :=
      inferInstanceAs (IsLocalHom (g.stalkMap y).hom)
    haveI : IsSepClosed (IsLocalRing.ResidueField (S.presheaf.stalk (g y))) := hy
    haveI : Algebra.IsSeparable (IsLocalRing.ResidueField (S.presheaf.stalk (g y)))
        (IsLocalRing.ResidueField (Y.presheaf.stalk y)) := inferInstance
    have hsurj : Function.Surjective (algebraMap (IsLocalRing.ResidueField (S.presheaf.stalk (g y)))
        (IsLocalRing.ResidueField (Y.presheaf.stalk y))) :=
      IsSepClosed.algebraMap_surjective _ _
    rw [ConcreteCategory.isIso_iff_bijective]
    exact ⟨RingHom.injective _, hsurj⟩
  have s2 : ∀ T : Scheme.Pullback.Triplet f g, IsIso (g.residueFieldMap T.y) →
      Subsingleton ↥(Spec T.tensor) := by
    intro T hT
    haveI : IsIso T.tensorInl := by
      show IsIso (Limits.pushout.inl _ _)
      exact Limits.pushout_inl_iso_of_right_iso _ _
    have hsurj : Function.Surjective T.tensorInl.hom :=
      (ConcreteCategory.bijective_of_isIso T.tensorInl).2
    have hinj := PrimeSpectrum.comap_injective_of_surjective T.tensorInl.hom hsurj
    exact hinj.subsingleton
  apply Scheme.Pullback.carrierEquiv.injective
  rw [Scheme.Pullback.carrierEquiv_eq_iff]
  have e : (Scheme.Pullback.carrierEquiv z).fst = (Scheme.Pullback.carrierEquiv z').fst := by
    show Scheme.Pullback.Triplet.ofPoint z = Scheme.Pullback.Triplet.ofPoint z'
    ext
    · rw [Scheme.Pullback.Triplet.ofPoint_x, Scheme.Pullback.Triplet.ofPoint_x, hfst]
    · rw [Scheme.Pullback.Triplet.ofPoint_y, Scheme.Pullback.Triplet.ofPoint_y, hsnd]
  refine ⟨e, ?_⟩
  have hy : Limits.pullback.snd f g z = (Scheme.Pullback.carrierEquiv z').fst.y := by
    show _ = (Scheme.Pullback.Triplet.ofPoint z').y
    rw [Scheme.Pullback.Triplet.ofPoint_y, hsnd]
  haveI := s2 _ (s1 _ (hy ▸ hsep))
  exact Subsingleton.elim _ _

theorem wcpa_dj_lr1k_lldf_residue_o : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), IsAlgClosed ((wcLldfA ↥W).residueField (wcLldfEv ↥W 0 (IsLocalRing.closedPoint ↥W))) ∧ ∀ t : ↥W, t ∈ IsLocalRing.maximalIdeal ↥W → wcLldfEv ↥W t (IsLocalRing.closedPoint ↥W) = wcLldfEv ↥W 0 (IsLocalRing.closedPoint ↥W) :=
by
  intro Ω _ _ W
  classical

  have hRes : IsAlgClosed (IsLocalRing.ResidueField ↥W) := by
    refine IsAlgClosed.of_exists_root _ ?_
    intro pb hmon hirr
    have hdeg : 0 < pb.degree := Polynomial.degree_pos_of_irreducible hirr
    have hlift : pb ∈ Polynomial.lifts (IsLocalRing.residue ↥W) := by
      rw [Polynomial.mem_lifts]
      exact Polynomial.map_surjective _ IsLocalRing.residue_surjective pb
    obtain ⟨p, hpmap, hpdeg, hpmon⟩ := Polynomial.lifts_and_degree_eq_and_monic hlift hmon
    have hPdeg : (p.map (algebraMap ↥W Ω)).degree ≠ 0 := by
      rw [hpmon.degree_map, hpdeg]
      exact ne_of_gt hdeg
    obtain ⟨x, hx⟩ := IsAlgClosed.exists_root _ hPdeg
    have hx' : Polynomial.eval x (p.map (algebraMap ↥W Ω)) = 0 := hx
    have hint : IsIntegral ↥W x := ⟨p, hpmon, by rw [← Polynomial.eval_map]; exact hx'⟩
    obtain ⟨y, hy⟩ := IsIntegrallyClosed.isIntegral_iff.mp hint
    have hpy : p.eval y = 0 := by
      apply IsFractionRing.injective ↥W Ω
      rw [map_zero, ← Polynomial.eval_map_apply, hy]
      exact hx'
    refine ⟨IsLocalRing.residue ↥W y, ?_⟩
    rw [← hpmap, Polynomial.eval_map_apply, hpy, map_zero]

  have hsec : wcLldfEv ↥W 0 ≫ wcLldfPiA ↥W = 𝟙 _ := by
    rw [← Spec.map_comp, ← Spec.map_id]
    congr 1
    ext r
    simp [MvPolynomial.algebraMap_eq]
  refine ⟨?_, ?_⟩
  · have hgen : ∀ (S X : Scheme.{u}) (s : S ⟶ X) (p : X ⟶ S), s ≫ p = 𝟙 S → ∀ x : ↥S,
        Function.Bijective (Scheme.Hom.residueFieldMap s x).hom := by
      intro S X s p hsp x
      have hcomp := Scheme.residueFieldMap_comp s p x
      have hcongr := Scheme.Hom.residueFieldMap_congr hsp x
      refine ⟨RingHom.injective _, ?_⟩
      have h1 : Function.Bijective (Scheme.Hom.residueFieldMap (s ≫ p) x).hom := by
        rw [hcongr]
        exact ConcreteCategory.bijective_of_isIso _
      rw [hcomp] at h1
      have h3 : Function.Surjective (⇑(Scheme.Hom.residueFieldMap s x).hom ∘
          ⇑(Scheme.Hom.residueFieldMap p (s x)).hom) := h1.2
      exact h3.of_comp
    let x : ↥(Spec (CommRingCat.of ↥W)) := IsLocalRing.closedPoint ↥W
    have hbij := hgen _ _ (wcLldfEv ↥W 0) (wcLldfPiA ↥W) hsec x
    let e₁ := RingEquiv.ofBijective _ hbij
    let e₂ : (Spec (CommRingCat.of ↥W)).presheaf.stalk x ≃+* ↥W :=
      (stalkClosedPointIso (CommRingCat.of ↥W)).commRingCatIsoToRingEquiv
    let e₃ : (Spec (CommRingCat.of ↥W)).residueField x ≃+* IsLocalRing.ResidueField ↥W :=
      IsLocalRing.ResidueField.mapEquiv e₂
    exact IsAlgClosed.of_ringEquiv _ _ (e₃.symm.trans e₁.symm)
  · intro t ht
    have key : ∀ s : ↥W, (wcLldfEv ↥W s (IsLocalRing.closedPoint ↥W)).asIdeal =
        Ideal.comap (MvPolynomial.eval fun _ : Fin 1 => s) (IsLocalRing.maximalIdeal ↥W) := by
      intro s
      rfl
    have hψ : (IsLocalRing.residue ↥W).comp (MvPolynomial.eval fun _ : Fin 1 => t) =
        (IsLocalRing.residue ↥W).comp (MvPolynomial.eval fun _ : Fin 1 => (0 : ↥W)) := by
      apply MvPolynomial.ringHom_ext
      · intro r; simp
      · intro i
        simp only [RingHom.comp_apply, MvPolynomial.eval_X, map_zero]
        exact (IsLocalRing.residue_eq_zero_iff t).mpr ht
    apply PrimeSpectrum.ext
    rw [key, key]
    ext f
    rw [Ideal.mem_comap, Ideal.mem_comap, ← IsLocalRing.residue_eq_zero_iff,
      ← IsLocalRing.residue_eq_zero_iff]
    rw [← RingHom.comp_apply, hψ, RingHom.comp_apply]

theorem wcpa_dj_lr1k_lldf_dictionary : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (C : Scheme.{u}) (γ : C ⟶ wcProjK Ω 1), wcpaDjLkCov Ω γ → wcpaDjLkGalois γ →
    ∀ (X : Scheme.{u}) (uX : X ⟶ Spec (.of ↥W)) (ι : wcProjK Ω 1 ⟶ X)
      [QuasiCompact (γ ≫ ι)] [QuasiSeparated (γ ≫ ι)],
    wcpaDjLkModel W uX ι →
    ∀ y₀ : ↥(wcpaDjLkFib W (γ ≫ ι) uX),
      wcpaDjLkBad ((wcpaDjLkFib W (γ ≫ ι) uX).presheaf.stalk y₀) →
      wcpaDjLkSmAt W uX (wcpaDjLkPi W (γ ≫ ι) uX y₀) →
    ∀ (σ : Spec (.of ↥W) ⟶ X) (a : ↥W),
      wcpaDjLlPair W uX (wcpaDjLkImg W (γ ≫ ι) uX y₀) σ a →
      wcpaDjLlExh W γ uX ι (wcpaDjLkImg W (γ ≫ ι) uX y₀) σ a →
    ∀ (X' : Scheme.{u}) (r : X' ⟶ X) (ι' : wcProjK Ω 1 ⟶ X')
      [QuasiCompact (γ ≫ ι')] [QuasiSeparated (γ ≫ ι')],
      wcCsdIsBlowup (σ.ker ⊔ wcNcPrincipal (.of ↥W) X uX a) r → ι' ≫ r = ι →
      wcpaDjLkModel W (r ≫ uX) ι' →
      ∀ V : X.Opens, (V : Set X) = {wcpaDjLkImg W (γ ≫ ι) uX y₀}ᶜ → IsIso (r ∣_ V) →
      ∀ y' : ↥(wcpaDjLkFib W (γ ≫ ι') (r ≫ uX)),
        wcpaDjLkBad ((wcpaDjLkFib W (γ ≫ ι') (r ≫ uX)).presheaf.stalk y') →
        r (wcpaDjLkImg W (γ ≫ ι') (r ≫ uX) y') = wcpaDjLkImg W (γ ≫ ι) uX y₀ →
      ∀ (σ'' : Spec (.of ↥W) ⟶ X') (a'' : ↥W),
        wcpaDjLlPair W (r ≫ uX) (wcpaDjLkImg W (γ ≫ ι') (r ≫ uX) y') σ'' a'' →
        wcpaDjLlExh W γ (r ≫ uX) ι' (wcpaDjLkImg W (γ ≫ ι') (r ≫ uX) y') σ'' a'' →
      ∀ (X₂ : Scheme.{u}) (r₂ : X₂ ⟶ X') (ι₂ : wcProjK Ω 1 ⟶ X₂)
        [QuasiCompact (γ ≫ ι₂)] [QuasiSeparated (γ ≫ ι₂)],
        wcCsdIsBlowup (σ''.ker ⊔ wcNcPrincipal (.of ↥W) X' (r ≫ uX) a'') r₂ → ι₂ ≫ r₂ = ι' →
        wcpaDjLkModel W (r₂ ≫ r ≫ uX) ι₂ →
        ∀ V₂ : X'.Opens, (V₂ : Set X') = {wcpaDjLkImg W (γ ≫ ι') (r ≫ uX) y'}ᶜ →
          IsIso (r₂ ∣_ V₂) →
      ∀ (X₁ : Scheme.{u}) (r₁ : X₁ ⟶ X) (ι₁ : wcProjK Ω 1 ⟶ X₁)
        [QuasiCompact (γ ≫ ι₁)] [QuasiSeparated (γ ≫ ι₁)],
        wcCsdIsBlowup ((σ'' ≫ r).ker ⊔ wcNcPrincipal (.of ↥W) X uX (a * a'')) r₁ → ι₁ ≫ r₁ = ι →
        wcpaDjLkModel W (r₁ ≫ uX) ι₁ →
        ∀ V₁ : X.Opens, (V₁ : Set X) = {wcpaDjLkImg W (γ ≫ ι) uX y₀}ᶜ → IsIso (r₁ ∣_ V₁) →
      ∀ y₁ : ↥(wcpaDjLkFib W (γ ≫ ι₁) (r₁ ≫ uX)),
        wcpaDjLkBad ((wcpaDjLkFib W (γ ≫ ι₁) (r₁ ≫ uX)).presheaf.stalk y₁) →
        r₁ (wcpaDjLkImg W (γ ≫ ι₁) (r₁ ≫ uX) y₁) = wcpaDjLkImg W (γ ≫ ι) uX y₀ →
        ¬ wcpaDjLkSmAt W (r₁ ≫ uX) (wcpaDjLkPi W (γ ≫ ι₁) (r₁ ≫ uX) y₁) →
      ∀ (q : X₂ ⟶ X₁), q ≫ r₁ = r₂ ≫ r → ι₂ ≫ q = ι₁ →
      ∀ (U : X.Opens) (m : U.toScheme ⟶ wcLldfA ↥W) (σU σ₁U : Spec (.of ↥W) ⟶ U.toScheme)
        (c : ↥W), wcLldfChart W uX σ (σ'' ≫ r) a U m σU σ₁U c →
      ∃ (M' M₂ M₁ : Scheme.{u}) (r0 : M' ⟶ wcLldfA ↥W) (ρ : Spec (.of ↥W) ⟶ M')
        (r20 : M₂ ⟶ M') (r10 : M₁ ⟶ wcLldfA ↥W) (Z : X₂.Opens) (e : Z.toScheme ⟶ M₂)
        (f : Z.toScheme ⟶ M₁) (φ' : ↥X' → ↥M') (φ₁ : ↥X₁ → ↥M₁),
        wcLldfModelHyp W a a'' c r0 ρ r20 r10 ∧
        (∀ w : ↥X₂, r (r₂ w) = wcpaDjLkImg W (γ ≫ ι) uX y₀ → ∃ wz : ↥Z.toScheme, Z.ι wz = w) ∧
        Flat (e ≫ r20 ≫ r0 ≫ wcLldfPiA ↥W) ∧
        f ≫ r10 = e ≫ r20 ≫ r0 ∧
        (∀ wz : ↥Z.toScheme, φ₁ (q (Z.ι wz)) = f wz ∧ φ' (r₂ (Z.ι wz)) = r20 (e wz)) ∧
        (∀ p p' : ↥X', r p = wcpaDjLkImg W (γ ≫ ι) uX y₀ →
          r p' = wcpaDjLkImg W (γ ≫ ι) uX y₀ → φ' p = φ' p' → p = p') ∧
        (∀ p p' : ↥X₁, r₁ p = wcpaDjLkImg W (γ ≫ ι) uX y₀ →
          r₁ p' = wcpaDjLkImg W (γ ≫ ι) uX y₀ → φ₁ p = φ₁ p' → p = p') ∧
        φ' (wcpaDjLkImg W (γ ≫ ι') (r ≫ uX) y') = ρ (IsLocalRing.closedPoint ↥W) ∧
        (∀ p : ↥X', r p = wcpaDjLkImg W (γ ≫ ι) uX y₀ →
          r0 (φ' p) = wcLldfEv ↥W 0 (IsLocalRing.closedPoint ↥W)) ∧
        (∀ p : ↥X₁, r₁ p = wcpaDjLkImg W (γ ≫ ι) uX y₀ →
          r10 (φ₁ p) = wcLldfEv ↥W 0 (IsLocalRing.closedPoint ↥W)) ∧
        (∀ wz : ↥Z.toScheme, wcLldfSm (r₂ ≫ r ≫ uX) (Z.ι wz) ↔
          wcLldfSm (r20 ≫ r0 ≫ wcLldfPiA ↥W) (e wz)) ∧
        (∀ p : ↥X₁, r₁ p = wcpaDjLkImg W (γ ≫ ι) uX y₀ →
          (wcLldfSm (r₁ ≫ uX) p ↔ wcLldfSm (r10 ≫ wcLldfPiA ↥W) (φ₁ p))) :=
by
  classical
  intro Ω _ _ W hW hWt C γ hcov hgal X uX ι _ _ hM y₀ hy₀ hSm σ a hP hExh X' r ι' _ _ hbl hι'
    hM' V hV hiso y' hb hi σ'' a'' hP'' hExh'' X₂ r₂ ι₂ _ _ hbl₂ hι₂ hM₂ V₂ hV₂ hiso₂
    X₁ r₁ ι₁ _ _ hbl₁ hι₁ hM₁ V₁ hV₁ hiso₁ y₁ hb₁ hi₁ hns q hq hιq U m σU σ₁U c hch
  obtain ⟨hUaff, hmet, hmπ, hσU, hσ₁U, hσUm, hσ₁Um, hkerU, hker₁U, hfibU⟩ := hch
  obtain ⟨hσπ, hσx, ha0, ham⟩ := hP
  obtain ⟨hσ''π, hσ''x, ha''0, ha''m⟩ := hP''
  rw [← hσx, ← hσ''x] at hi
  rw [← hσx] at hi₁
  rw [← hσx, ← hσ''x]
  haveI := hmet
  have hss : ∀ {A B : Scheme.{u}} (g : A ⟶ B), wcpaDjSemistable g → Flat g ∧ IsProper g := by
    intro A B g h
    unfold wcpaDjSemistable at h
    exact ⟨h.1, h.2.1⟩
  haveI : IsProper uX := (hss uX hM.1).2
  haveI : IsProper (r ≫ uX) := (hss _ hM'.1).2
  haveI : Flat (r ≫ uX) := (hss _ hM'.1).1

  have hxU : σ (IsLocalRing.closedPoint ↥W) ∈ U := by
    rw [← hσU, Scheme.Hom.comp_apply σU U.ι (IsLocalRing.closedPoint ↥W)]
    exact (σU (IsLocalRing.closedPoint ↥W)).2
  obtain ⟨hκ, hevm⟩ := wcpa_dj_lr1k_lldf_residue_o Ω W
  have hevac := hevm (a * c) (Ideal.mul_mem_right c _ ham)
  have hσ₁σ : σ₁U (IsLocalRing.closedPoint ↥W) = σU (IsLocalRing.closedPoint ↥W) := by
    apply hfibU
    rw [← Scheme.Hom.comp_apply σ₁U m (IsLocalRing.closedPoint ↥W), ← Scheme.Hom.comp_apply σU m (IsLocalRing.closedPoint ↥W), hσUm, hσ₁Um, hevac]

  have hkey : ∀ (P M : Scheme.{u}) (hh : P ⟶ M) (rr : P ⟶ U.toScheme) (r00 : M ⟶ wcLldfA ↥W),
      IsPullback hh rr r00 m → ∀ p p' : P, hh p = hh p' →
        rr p = σU (IsLocalRing.closedPoint ↥W) → rr p' = σU (IsLocalRing.closedPoint ↥W) →
        p = p' := by
