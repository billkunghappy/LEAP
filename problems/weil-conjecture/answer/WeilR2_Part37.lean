  have hunitK : IsUnit (algebraMap (AdicCompletion (Ideal.span {ϖ}) ↥W)
      (FractionRing (AdicCompletion (Ideal.span {ϖ}) ↥W))
      (algebraMap ↥W (AdicCompletion (Ideal.span {ϖ}) ↥W) ϖ)) :=
    IsLocalization.map_units (FractionRing (AdicCompletion (Ideal.span {ϖ}) ↥W)) ⟨_, hϖmem⟩
  have e1 : χ (algebraMap (wcGubCpl W A g ϖ c) (Localization.Away (algebraMap ↥(wcGubBox W A g c)
      (wcGubCpl W A g ϖ c) (algebraMap A ↥(wcGubBox W A g c) (algebraMap ↥W A ϖ))))
      (algebraMap ↥(wcGubBox W A g c) (wcGubCpl W A g ϖ c)
        (algebraMap A ↥(wcGubBox W A g c) (algebraMap ↥W A ϖ)))) =
      algebraMap (AdicCompletion (Ideal.span {ϖ}) ↥W)
        (FractionRing (AdicCompletion (Ideal.span {ϖ}) ↥W))
        (algebraMap ↥W (AdicCompletion (Ideal.span {ϖ}) ↥W) ϖ) := by
    rw [← hWc ϖ]
    exact hχ _
  have e2 : χ (algebraMap (wcGubCpl W A g ϖ c) (Localization.Away (algebraMap ↥(wcGubBox W A g c)
      (wcGubCpl W A g ϖ c) (algebraMap A ↥(wcGubBox W A g c) (algebraMap ↥W A ϖ))))
      (algebraMap ↥(wcGubBox W A g c) (wcGubCpl W A g ϖ c) a)) =
      algebraMap (AdicCompletion (Ideal.span {ϖ}) ↥W)
        (FractionRing (AdicCompletion (Ideal.span {ϖ}) ↥W)) (χ₁ a) := hχ _
  have h1 := congrArg χ heq
  rw [map_mul, map_pow, e1, e2, hχ₁a, map_mul, map_pow] at h1
  have h2 := (hunitK.pow j).mul_left_cancel h1
  exact hχx ⟨_, h2.symm⟩

theorem wcpa_dj_lr1k_nsr_gub_it_max_principle : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (C : Scheme.{u}) [AlgebraicGeometry.IsIntegral C] (γ : C ⟶ wcProjK Ω 1),
      wcpaDjLkCov Ω γ →
    ∀ (X' : Scheme.{u}) (u' : X' ⟶ Spec (.of ↥W)) (ι' : wcProjK Ω 1 ⟶ X')
      [QuasiCompact (γ ≫ ι')] [QuasiSeparated (γ ≫ ι')],
      wcpaDjLkModel W u' ι' →
    ∀ (n : ↥(γ ≫ ι').normalization) (f : Fin 2 → ((γ ≫ ι').normalization).presheaf.stalk n),
      wcTcRad W ((γ ≫ ι').fromNormalization ≫ u') n f →
    ∀ (A : Type u) [CommRing A] [Algebra ↥W A] (ϖ : ↥W) (𝔪 : Ideal A) (g : Fin 2 → A)
      (φ : A →+* ((γ ≫ ι').normalization).presheaf.stalk n),
      wcGubAdm W A ϖ 𝔪 g → wcGubChart W ((γ ≫ ι').fromNormalization ≫ u') n f A 𝔪 g φ →
    ∀ ψ : wcGubGen W A →+* C.functionField,
      (∀ (hn : (γ ≫ ι').toNormalization (genericPoint ↥C) ⤳ n) (a : A),
        ψ (algebraMap A (wcGubGen W A) a) =
          (wcLr1uGerm (γ ≫ ι').toNormalization n hn).hom (φ a)) →
    ∀ c : ↥W, c ≠ 0 → c ∈ IsLocalRing.maximalIdeal ↥W →
    ∃ K : ℕ, ∀ (a : ↥(wcGubBox W A g c)) (m : ℕ),
      (∀ V, wcGubBx W (γ ≫ wcProjKStr Ω 1) (γ ≫ ι').toNormalization n f (c : Ω) V →
        V.valuation (ψ (a : wcGubGen W A)) ≤
          V.valuation (wcLr1uConst (γ ≫ wcProjKStr Ω 1) (ϖ : Ω)) ^ (m + K)) →
      ∃ s : ↥(wcGubBox W A g c), (a : wcGubGen W A) =
        algebraMap A (wcGubGen W A) (algebraMap ↥W A ϖ) ^ m * (s : wcGubGen W A) :=
by
  intro Ω _ _ W hW hWt C _ γ hcov X' u' ι' _ _ hM n f hRad A _ _ ϖ 𝔪 g φ hAdm hChart ψ hψA
    c hc0 hcm
  classical

  set t := (γ ≫ ι').toNormalization with ht_def
  have hn₀ : t (genericPoint C) ⤳ n := by
    have hd : DenseRange t := t.denseRange
    have hsub : Set.range t ⊆ closure {t (genericPoint C)} := by
      rintro _ ⟨x, rfl⟩
      exact specializes_iff_mem_closure.mp
        (((genericPoint_spec C).specializes (Set.mem_univ x)).map t.continuous)
    have h2 : closure (Set.range t) ⊆ closure {t (genericPoint C)} :=
      closure_minimal hsub isClosed_closure
    rw [hd.closure_range] at h2
    exact specializes_iff_mem_closure.mpr (h2 (Set.mem_univ n))
  have hsq : t ≫ ((γ ≫ ι').fromNormalization ≫ u') =
      (γ ≫ wcProjKStr Ω 1) ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω)) := by
    rw [← Category.assoc, ht_def, Scheme.Hom.toNormalization_fromNormalization, Category.assoc,
      hM.2.2.w]
    exact (Category.assoc _ _ _).symm
  have hconst : ∀ w : ↥W, (wcLr1uGerm t n hn₀).hom
