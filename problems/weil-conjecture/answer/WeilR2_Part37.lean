  obtain ⟨s, hs⟩ := fam (Q.natDegree + 1)
  have hC := interp Q.natDegree s hs Q le_rfl (fun i => hQ (s i))
  exact (Polynomial.C_dvd_iff_dvd_coeff d Q).mp hC n

theorem wcpa_dj_lr1k_nsr_gub_bff_dc_ia_pbc_tb_gauss : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (f g : Polynomial ↥W) (d c : ↥W) (k₀ : ℕ), f.coeff k₀ ∣ c → (∀ n : ℕ, d ∣ (f * g).coeff n) → ∀ n : ℕ, d ∣ c * g.coeff n :=
by
  intro Ω _ W f g d c k₀ hfc hd n
  classical
  have content : ∀ p : Polynomial ↥W, ∃ (a : ↥W) (p' : Polynomial ↥W),
      p = Polynomial.C a * p' ∧ ∃ k : ℕ, IsUnit (p'.coeff k) := by
    intro p
    have hmin : ∀ M : ℕ, ∃ k ≤ M, ∀ j ≤ M, p.coeff k ∣ p.coeff j := by
      intro M
      induction M with
      | zero => exact ⟨0, le_rfl, fun j hj => by rw [Nat.le_zero.mp hj]⟩
      | succ M ih =>
        obtain ⟨k, hk, hkj⟩ := ih
        rcases ValuationRing.dvd_total (p.coeff k) (p.coeff (M + 1)) with h | h
        · refine ⟨k, by omega, fun j hj => ?_⟩
          rcases Nat.lt_or_ge j (M + 1) with hj' | hj'
          · exact hkj j (by omega)
          · rw [show j = M + 1 by omega]; exact h
        · refine ⟨M + 1, le_rfl, fun j hj => ?_⟩
          rcases Nat.lt_or_ge j (M + 1) with hj' | hj'
          · exact dvd_trans h (hkj j (by omega))
          · rw [show j = M + 1 by omega]
    obtain ⟨k, hk, hkj⟩ := hmin p.natDegree
    have hall : ∀ j, p.coeff k ∣ p.coeff j := by
      intro j
      by_cases hj : j ≤ p.natDegree
      · exact hkj j hj
      · rw [Polynomial.coeff_eq_zero_of_natDegree_lt (p := p) (n := j) (by omega)]
        exact dvd_zero _
    by_cases ha : p.coeff k = 0
    · refine ⟨0, 1, ?_, 0, by simp⟩
      ext j
      have := hall j
      rw [ha, zero_dvd_iff] at this
      simp [this]
    · obtain ⟨p', hp'⟩ := (Polynomial.C_dvd_iff_dvd_coeff (p.coeff k) p).mpr hall
      refine ⟨p.coeff k, p', hp', k, ?_⟩
      have h2 := congrArg (fun r => Polynomial.coeff r k) hp'
      simp only [Polynomial.coeff_C_mul] at h2
      have h3 : p'.coeff k = 1 := mul_left_cancel₀ ha (h2.symm.trans (mul_one _).symm)
      rw [h3]
      exact isUnit_one
  have prim : ∀ (p q : Polynomial ↥W) (k l : ℕ), IsUnit (p.coeff k) → IsUnit (q.coeff l) →
      ∃ m : ℕ, IsUnit ((p * q).coeff m) := by
    intro p q k l hk hl
    have hp : p.map (IsLocalRing.residue ↥W) ≠ 0 := by
      intro h
      have := congrArg (fun r => Polynomial.coeff r k) h
      simp only [Polynomial.coeff_map, Polynomial.coeff_zero] at this
      exact (IsLocalRing.residue_ne_zero_iff_isUnit _).mpr hk this
    have hq : q.map (IsLocalRing.residue ↥W) ≠ 0 := by
      intro h
      have := congrArg (fun r => Polynomial.coeff r l) h
      simp only [Polynomial.coeff_map, Polynomial.coeff_zero] at this
      exact (IsLocalRing.residue_ne_zero_iff_isUnit _).mpr hl this
    have hpq : (p * q).map (IsLocalRing.residue ↥W) ≠ 0 := by
      rw [Polynomial.map_mul]; exact mul_ne_zero hp hq
    by_contra hcon
    push_neg at hcon
    apply hpq
    ext m
    rw [Polynomial.coeff_map, Polynomial.coeff_zero]
    by_contra hm
    exact hcon m ((IsLocalRing.residue_ne_zero_iff_isUnit _).mp hm)
  obtain ⟨a, f', hf, k₁, hk₁⟩ := content f
  obtain ⟨b, g', hg, k₂, hk₂⟩ := content g
  obtain ⟨m, hm⟩ := prim f' g' k₁ k₂ hk₁ hk₂
  have hfg : f * g = Polynomial.C (a * b) * (f' * g') := by
    rw [hf, hg, Polynomial.C_mul]; ring
  have h1 : d ∣ a * b := by
    have := hd m
    rw [hfg, Polynomial.coeff_C_mul] at this
    exact (IsUnit.dvd_mul_right hm).mp this
  have h2 : a ∣ c := by
    refine dvd_trans ?_ hfc
    rw [hf, Polynomial.coeff_C_mul]; exact dvd_mul_right _ _
  have h3 : b ∣ g.coeff n := by
    rw [hg, Polynomial.coeff_C_mul]; exact dvd_mul_right _ _
  exact dvd_trans h1 (mul_dvd_mul h2 h3)

theorem wcpa_dj_lr1k_nsr_gub_bff_dc_ia_pbc_tb_box_values : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A] [Algebra ↥W A] (η : A) (e s : ↥W), e ≠ 0 → ∀ ψ : wcGubGen W A →+* Ω, (∀ w : ↥W, ψ (algebraMap A (wcGubGen W A) (algebraMap ↥W A w)) = (w : Ω)) → (∀ x : A, ψ (algebraMap A (wcGubGen W A) x) ∈ W) → ψ (algebraMap A (wcGubGen W A) η) = (e : Ω) * (s : Ω) → ∀ y : wcGubGen W A, IsIntegral ↥(wcGubBox W A (fun _ : Fin 2 => η) e) y → ψ y ∈ W :=
by
  intro Ω _ W A _ _ η e s he ψ h1 h2 h3 y hy
  have hu : IsUnit (algebraMap A (wcGubGen W A) (algebraMap ↥W A e)) :=
    IsLocalization.map_units (wcGubGen W A)
      (⟨algebraMap ↥W A e, Submonoid.mem_map_of_mem _ (mem_nonZeroDivisors_of_ne_zero he)⟩ :
        Submonoid.map (algebraMap ↥W A) (nonZeroDivisors ↥W))
  have hstar : ψ (Ring.inverse (algebraMap A (wcGubGen W A) (algebraMap ↥W A e))) * (e : Ω) = 1 := by
    rw [← h1 e, ← map_mul, Ring.inverse_mul_cancel _ hu, map_one]
  have hT : ψ (algebraMap A (wcGubGen W A) η *
      Ring.inverse (algebraMap A (wcGubGen W A) (algebraMap ↥W A e))) = (s : Ω) := by
    rw [map_mul, h3]
    linear_combination (s : Ω) * hstar
  let S : Subalgebra A (wcGubGen W A) :=
    { (W.toSubring.comap ψ) with
      algebraMap_mem' := fun x => h2 x }
  have hle : wcGubBox W A (fun _ : Fin 2 => η) e ≤ S := by
    unfold wcGubBox
    rw [Algebra.adjoin_le_iff]
    rintro _ ⟨i, rfl⟩
    show ψ _ ∈ W
    rw [hT]
    exact s.2
  let φ : ↥(wcGubBox W A (fun _ : Fin 2 => η) e) →+* ↥W :=
    { toFun := fun x => ⟨ψ x, hle x.2⟩
      map_one' := Subtype.ext (map_one ψ)
      map_mul' := fun a b => Subtype.ext (map_mul ψ (a : wcGubGen W A) b)
      map_zero' := Subtype.ext (map_zero ψ)
      map_add' := fun a b => Subtype.ext (map_add ψ (a : wcGubGen W A) b) }
  have hcomp : (algebraMap ↥W Ω).comp φ =
      ψ.comp (algebraMap ↥(wcGubBox W A (fun _ : Fin 2 => η) e) (wcGubGen W A)) :=
    RingHom.ext fun x => rfl
  have hint : IsIntegral ↥W (ψ y) := IsIntegral.map_of_comp_eq φ ψ hcomp hy
  obtain ⟨w, hw⟩ := (IsIntegrallyClosed.isIntegral_iff (R := ↥W) (K := Ω)).mp hint
  rw [← hw]
  exact w.2

theorem wcpa_dj_lr1k_nsr_gub_bff_dc_ia_pbc_tb_nondeg : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A] [Algebra ↥W A] (ϖ : ↥W) (η : A), ϖ ≠ 0 → ϖ ∈ IsLocalRing.maximalIdeal ↥W → (∀ w : ↥W, w ≠ 0 → ∀ x : ↥W, x ∈ IsLocalRing.maximalIdeal ↥W → ∃ K : ℕ, w ∣ x ^ K) → ∀ (r : ℕ) (b : Fin r → A), (∀ (L : ℕ) (a : A), ∃ (p : Fin r → Polynomial ↥W) (s : A), a = ∑ i, Polynomial.aeval η (p i) * b i + algebraMap ↥W A ϖ ^ L * s) → ∀ (t : ↥W) (ψ : Fin r → (wcGubGen W A →+* Ω)), (∀ j, (∀ w : ↥W, ψ j (algebraMap A (wcGubGen W A) (algebraMap ↥W A w)) = (w : Ω)) ∧ (∀ x : A, ψ j (algebraMap A (wcGubGen W A) x) ∈ W) ∧ ψ j (algebraMap A (wcGubGen W A) η) = (t : Ω)) → Function.Injective ψ → ∀ V : Matrix (Fin r) (Fin r) ↥W, (∀ j i, (V j i : Ω) = ψ j (algebraMap A (wcGubGen W A) (b i))) → V.det ≠ 0 :=
by
  classical
  intro Ω _ W A _ _ ϖ η hϖ0 hϖm hR1 r b hspan t ψ hpts hinj V hV hdet
  obtain ⟨lam, hlam0, hlamV⟩ := Matrix.exists_vecMul_eq_zero_iff.mpr hdet
  have hcoe : ∀ w : W, algebraMap W Ω w = (w : Ω) := fun _ => rfl

  have hK : ∀ i, ∑ j, (lam j : Ω) * ψ j (algebraMap A (wcGubGen W A) (b i)) = 0 := by
    intro i
    have h1 := congrFun hlamV i
    simp only [Matrix.vecMul, dotProduct, Pi.zero_apply] at h1
    have h2 : algebraMap W Ω (∑ j, lam j * V j i) = 0 := by rw [h1, map_zero]
    rw [← h2, map_sum]
    exact Finset.sum_congr rfl (fun j _ => by rw [map_mul, hcoe, hcoe, hV])

  have hEV : ∀ j (p : Polynomial W), ψ j (algebraMap A (wcGubGen W A) (Polynomial.aeval η p)) =
      ((Polynomial.eval t p : W) : Ω) := by
    intro j p
    have hc : ((ψ j).comp (algebraMap A (wcGubGen W A))).comp (algebraMap W A) = algebraMap W Ω := by
      ext w; exact (hpts j).1 w
    have h1 := Polynomial.hom_eval₂ p (algebraMap W A) ((ψ j).comp (algebraMap A (wcGubGen W A))) η
    have h2 : ((ψ j).comp (algebraMap A (wcGubGen W A))) η = algebraMap W Ω t := (hpts j).2.2
    rw [hc, h2, Polynomial.eval₂_at_apply] at h1
    rw [Polynomial.aeval_def]
    exact h1

