      exact mul_le_mul_of_nonneg_right (hcard s) (by simp)
    · by_cases hfin : {y | P y}.Finite
      · refine le_iSup_of_le hfin.toFinset (le_of_eq ?_)
        rw [hs, Finset.filter_true_of_mem (p := P) (fun y hy => hfin.mem_toFinset.mp hy),
          hfin.encard_eq_coe_toFinset_card]
      · rw [Set.encard_eq_top_iff.mpr hfin]
