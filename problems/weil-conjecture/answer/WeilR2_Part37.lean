    have hcard : ∀ s : Finset T, ((s.filter P).card : ℕ∞) ≤ {y | P y}.encard := by
      intro s
      rw [← Set.encard_coe_eq_coe_finsetCard]
      exact Set.encard_le_encard (fun y hy => (Finset.mem_filter.mp hy).2)
    apply le_antisymm
    · refine iSup_le fun s => ?_
