          rw [Nat.cast_sum, hT₁, Finset.sum_filter]
          refine Finset.sum_congr rfl (fun y hy => ?_)
          by_cases hP : (¬(δ' y = 0 ∨ (δ' y = 1 ∧ m' y = 2)) ∧ I' y)
          · rw [if_pos hP, if_pos hP, (hfacts y (Finset.mem_filter.mpr ⟨hy, hP⟩)).1]
          · rw [if_neg hP, if_neg hP]
        exact_mod_cast h3
