        (fun i => Ideal.Quotient.mk ((IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)) (y i)) →
      AlgebraicIndependent (↥W) y := by
    intro Ω _ W A _ _ htf y hind
    rw [algebraicIndependent_iff]
    intro P hP
    by_contra hP0
    have hne : P.support.Nonempty := by
      rw [Finset.nonempty_iff_ne_empty, Ne, MvPolynomial.support_eq_empty]; exact hP0
    have hmin : ∀ s : Finset (Fin 2 →₀ ℕ), s.Nonempty →
        ∃ m₀ ∈ s, ∀ m ∈ s, P.coeff m₀ ∣ P.coeff m := by
      intro s hs
      induction hs using Finset.Nonempty.cons_induction with
      | singleton a => exact ⟨a, Finset.mem_singleton_self a, fun m hm => by
          rw [Finset.mem_singleton.mp hm]⟩
      | cons a s ha hs ih =>
        obtain ⟨c, hc, hcd⟩ := ih
        rcases ValuationRing.dvd_total (P.coeff a) (P.coeff c) with h | h
        · refine ⟨a, Finset.mem_cons_self a s, fun m hm => ?_⟩
          rcases Finset.mem_cons.mp hm with rfl | hm
          · exact dvd_rfl
          · exact h.trans (hcd m hm)
        · refine ⟨c, Finset.mem_cons_of_mem hc, fun m hm => ?_⟩
          rcases Finset.mem_cons.mp hm with rfl | hm
          · exact h
          · exact hcd m hm
    obtain ⟨m₀, hm₀, hdiv⟩ := hmin P.support hne
    set c := P.coeff m₀ with hcdef
    have hc0 : c ≠ 0 := MvPolynomial.mem_support_iff.mp hm₀
    choose d hd using hdiv
    let d' : (Fin 2 →₀ ℕ) → ↥W := fun m => if h : m ∈ P.support then d m h else 0
    let P' : MvPolynomial (Fin 2) ↥W := ∑ m ∈ P.support, MvPolynomial.monomial m (d' m)
    have hPP' : P = MvPolynomial.C c * P' := by
      conv_lhs => rw [MvPolynomial.as_sum P]
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl (fun m hm => ?_)
      rw [MvPolynomial.C_mul_monomial]
      congr 1
      simp only [d', dif_pos hm]
      exact hd m hm
    have hP'0 : MvPolynomial.aeval y P' = 0 := by
      apply htf c _ hc0
      rw [← MvPolynomial.aeval_C (R := ↥W) y c, ← map_mul, ← hPP']
      exact hP
    have hd1 : d' m₀ = 1 := by
      have h1 : c * d' m₀ = c * 1 := by
        simp only [d', dif_pos hm₀]
        rw [mul_one, ← hd m₀ hm₀]
      exact mul_left_cancel₀ hc0 h1
    have hcoeff : P'.coeff m₀ = 1 := by
      simp only [P', MvPolynomial.coeff_sum, MvPolynomial.coeff_monomial]
      rw [Finset.sum_ite_eq' P.support m₀ (fun m => d' m), if_pos hm₀, hd1]
    haveI : Nontrivial (↥W ⧸ IsLocalRing.maximalIdeal ↥W) :=
      Ideal.Quotient.nontrivial_iff.mpr (IsLocalRing.maximalIdeal.isMaximal ↥W).ne_top
    have hmap0 : MvPolynomial.map (algebraMap ↥W (↥W ⧸ IsLocalRing.maximalIdeal ↥W)) P' ≠ 0 := by
      intro h
      have := congrArg (fun Q : MvPolynomial (Fin 2) (↥W ⧸ IsLocalRing.maximalIdeal ↥W) =>
        Q.coeff m₀) h
      simp only [MvPolynomial.coeff_map, hcoeff, map_one, MvPolynomial.coeff_zero] at this
      exact one_ne_zero this
    apply hmap0
    rw [algebraicIndependent_iff] at hind
    apply hind
    rw [MvPolynomial.aeval_map_algebraMap]
    have hcomp := congrArg (fun φ => φ P') (MvPolynomial.comp_aeval (R := ↥W) y
      (Ideal.Quotient.mkₐ (↥W) ((IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A))))
    simp only [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk] at hcomp
    rw [← hcomp, hP'0, map_zero]
  have wcbffnp_trdeg_two_dim : ∀ (K S : Type u) [Field K] [CommRing S] [IsDomain S] [Algebra K S]
      [Algebra.FiniteType K S], ringKrullDim S ≤ 1 → ∀ x : Fin 2 → S,
      ¬ AlgebraicIndependent K x := by
    intro K S _ _ _ _ _ hdS x hx
    obtain ⟨r, ν, hinj, hfin⟩ := exists_finite_inj_algHom_of_fg K S

    have hintP : ∀ s : S, ∃ f : Polynomial (MvPolynomial (Fin r) K), f.Monic ∧
        Polynomial.eval₂ ν.toRingHom s f = 0 := by
      intro s
      letI : Algebra (MvPolynomial (Fin r) K) S := ν.toRingHom.toAlgebra
      haveI : Module.Finite (MvPolynomial (Fin r) K) S := hfin
      obtain ⟨f, hfm, hf⟩ := Algebra.IsIntegral.isIntegral (R := MvPolynomial (Fin r) K) s
      exact ⟨f, hfm, hf⟩

    have hr1 : r ≤ 1 := by
      by_contra hr
      have hr2 : 2 ≤ r := by omega
      letI : Algebra (MvPolynomial (Fin r) K) S := ν.toRingHom.toAlgebra
      haveI : Module.Finite (MvPolynomial (Fin r) K) S := hfin
      haveI : Algebra.IsIntegral (MvPolynomial (Fin r) K) S := Algebra.IsIntegral.of_finite _ _
      have hdimP : ringKrullDim (MvPolynomial (Fin r) K) = (r : WithBot ℕ∞) := by
        rw [MvPolynomial.ringKrullDim_of_isNoetherianRing, ringKrullDim_eq_zero_of_field,
          ENat.card_eq_coe_fintype_card, Fintype.card_fin, zero_add]
        rfl
      have h2P : ((2 : ℕ) : WithBot ℕ∞) ≤ Order.krullDim (PrimeSpectrum (MvPolynomial (Fin r) K)) := by
        show ((2 : ℕ) : WithBot ℕ∞) ≤ ringKrullDim (MvPolynomial (Fin r) K)
        rw [hdimP]
        exact_mod_cast hr2
      obtain ⟨l, hl⟩ := Order.le_krullDim_iff.mp h2P
      have hlt01 : l 0 < l ⟨1, by omega⟩ := l.strictMono (by simp [Fin.lt_def])
      have hlt12 : l ⟨1, by omega⟩ < l ⟨2, by omega⟩ := l.strictMono (by simp [Fin.lt_def])
      have hker : RingHom.ker (algebraMap (MvPolynomial (Fin r) K) S) ≤ (l 0).asIdeal := by
        have : RingHom.ker (algebraMap (MvPolynomial (Fin r) K) S) = ⊥ :=
          (RingHom.injective_iff_ker_eq_bot _).mp hinj
        rw [this]; exact bot_le
      obtain ⟨Q0, hQ0, hQ0u⟩ :=
        Ideal.exists_ideal_over_prime_of_isIntegral_of_isDomain (S := S) (l 0).asIdeal hker
      obtain ⟨Q1, hQ01, hQ1, hQ1u⟩ :=
        Ideal.exists_ideal_over_prime_of_isIntegral_of_isPrime (S := S) (l ⟨1, by omega⟩).asIdeal Q0
          (by rw [hQ0u]; exact le_of_lt hlt01)
      obtain ⟨Q2, hQ12, hQ2, hQ2u⟩ :=
        Ideal.exists_ideal_over_prime_of_isIntegral_of_isPrime (S := S) (l ⟨2, by omega⟩).asIdeal Q1
          (by rw [hQ1u]; exact le_of_lt hlt12)
      have hs01 : (⟨Q0, hQ0⟩ : PrimeSpectrum S) < ⟨Q1, hQ1⟩ := by
        refine lt_of_le_of_ne hQ01 (fun h => ?_)
        have h' : Q0 = Q1 := congrArg PrimeSpectrum.asIdeal h
        have : (l 0).asIdeal = (l ⟨1, by omega⟩).asIdeal := by rw [← hQ0u, ← hQ1u, h']
        exact (ne_of_lt hlt01) (PrimeSpectrum.ext this)
      have hs12 : (⟨Q1, hQ1⟩ : PrimeSpectrum S) < ⟨Q2, hQ2⟩ := by
        refine lt_of_le_of_ne hQ12 (fun h => ?_)
        have h' : Q1 = Q2 := congrArg PrimeSpectrum.asIdeal h
        have : (l ⟨1, by omega⟩).asIdeal = (l ⟨2, by omega⟩).asIdeal := by rw [← hQ1u, ← hQ2u, h']
        exact (ne_of_lt hlt12) (PrimeSpectrum.ext this)
      let L : LTSeries (PrimeSpectrum S) := LTSeries.mk 2
        ![⟨Q0, hQ0⟩, ⟨Q1, hQ1⟩, ⟨Q2, hQ2⟩] (by
          rw [Fin.strictMono_iff_lt_succ]
          intro i
          fin_cases i
          · exact hs01
          · exact hs12)
      have hL : ((2 : ℕ) : WithBot ℕ∞) ≤ ringKrullDim S := Order.LTSeries.length_le_krullDim L
      have h21 : ((2 : ℕ) : WithBot ℕ∞) ≤ ((1 : ℕ) : WithBot ℕ∞) := le_trans hL hdS
      exact absurd (WithBot.coe_le_coe.mp (by exact_mod_cast h21) : ((2 : ℕ) : ℕ∞) ≤ ((1 : ℕ) : ℕ∞))
        (by norm_num)

    set e : Fin r → S := ⇑ν ∘ MvPolynomial.X with he
    have hmem : ∀ p, ν p ∈ Algebra.adjoin K (Set.range e) := by
      intro p
      rw [he, ← MvPolynomial.aeval_range, ← MvPolynomial.aeval_unique ν]
      exact AlgHom.mem_range_self ν p
    let φ : MvPolynomial (Fin r) K →ₐ[K] Algebra.adjoin K (Set.range e) := ν.codRestrict _ hmem
    haveI : Algebra.IsAlgebraic (Algebra.adjoin K (Set.range e)) S := by
      refine ⟨fun s => ?_⟩
      obtain ⟨f, hfm, hf⟩ := hintP s
      refine IsIntegral.isAlgebraic ⟨f.map (φ : MvPolynomial (Fin r) K →+* _), hfm.map _, ?_⟩
      rw [Polynomial.eval₂_map]
      exact hf
    have htr := Algebra.IsAlgebraic.trdeg_le_cardinalMk K (Set.range e)
    have hx2 := hx.lift_cardinalMk_le_trdeg
    have hrng := Cardinal.mk_range_le_lift (f := e)
    have hchain : Cardinal.lift.{u} (Cardinal.mk (Fin 2)) ≤ Cardinal.lift.{u} (Cardinal.mk (Fin r)) :=
      hx2.trans ((Cardinal.lift_le.mpr htr).trans hrng)
    rw [Cardinal.lift_le, Cardinal.mk_fin, Cardinal.mk_fin] at hchain
    have : 2 ≤ r := by exact_mod_cast hchain
    omega
  have wcbffnp_generic_fibre_transfer : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω)
      (A : Type u) [CommRing A] [Algebra ↥W A], IsDomain A → Algebra.FiniteType ↥W A →
      (∀ (w : ↥W) (a : A), w ≠ 0 → algebraMap ↥W A w * a = 0 → a = 0) → ∀ y : Fin 2 → A,
      AlgebraicIndependent (↥W) y → ∃ (_ : Algebra Ω (wcGubGen W A)), IsDomain (wcGubGen W A) ∧
        Algebra.FiniteType Ω (wcGubGen W A) ∧
        AlgebraicIndependent Ω (fun i => algebraMap A (wcGubGen W A) (y i)) := by
    intro Ω _ W A _ _ hdomA hFT htf y hy
    haveI := hdomA
    have hle : Submonoid.map (algebraMap (↥W) A) (nonZeroDivisors ↥W) ≤ nonZeroDivisors A := by
      rintro _ ⟨w, hw, rfl⟩
      apply mem_nonZeroDivisors_of_ne_zero
      intro h0
      have := htf w 1 (nonZeroDivisors.ne_zero hw) (by rw [h0, zero_mul])
      exact one_ne_zero this
    have hdomG : IsDomain (wcGubGen W A) :=
      IsLocalization.isDomain_of_le_nonZeroDivisors (wcGubGen W A) hle
    have hunit : ∀ w : ↥(nonZeroDivisors ↥W),
        IsUnit (((algebraMap A (wcGubGen W A)).comp (algebraMap (↥W) A)) (w : ↥W)) := fun w =>
      IsLocalization.map_units (wcGubGen W A)
        (⟨algebraMap (↥W) A w, Submonoid.mem_map_of_mem _ w.2⟩ :
          Submonoid.map (algebraMap (↥W) A) (nonZeroDivisors ↥W))
    let φ : Ω →+* wcGubGen W A := IsLocalization.lift (M := nonZeroDivisors ↥W) (S := Ω) hunit
    letI inst : Algebra Ω (wcGubGen W A) := φ.toAlgebra
    have hφ : ∀ w : ↥W, algebraMap A (wcGubGen W A) (algebraMap (↥W) A w) =
        algebraMap Ω (wcGubGen W A) (algebraMap (↥W) Ω w) := fun w =>
      (IsLocalization.lift_eq hunit w).symm
    have hcomp : (algebraMap Ω (wcGubGen W A)).comp (algebraMap (↥W) Ω) =
        (algebraMap A (wcGubGen W A)).comp (algebraMap (↥W) A) := IsLocalization.lift_comp hunit
    refine ⟨inst, hdomG, ?_, ?_⟩
    · obtain ⟨G, hG⟩ := hFT.out
      have hA : ∀ a : A, algebraMap A (wcGubGen W A) a ∈
          Algebra.adjoin Ω (algebraMap A (wcGubGen W A) '' (G : Set A)) := by
        intro a
        have ha : a ∈ Algebra.adjoin (↥W) (G : Set A) := by rw [hG]; trivial
        induction ha using Algebra.adjoin_induction with
        | mem x hx => exact Algebra.subset_adjoin ⟨x, hx, rfl⟩
