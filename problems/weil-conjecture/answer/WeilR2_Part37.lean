theorem wcpa_dj_lr1k_nsr_gub_itapb_dominating_centre : ∀ (Ω : Type u) [Field Ω] (C : Scheme.{u})
    [AlgebraicGeometry.IsIntegral C]
    (sC : C ⟶ Spec (.of Ω)) [IsProper sC] (O : ValuationSubring C.functionField),
    (∀ a : Ω, ((Scheme.ΓSpecIso (.of Ω)).inv ≫ sC.appTop ≫
        C.presheaf.germ ⊤ (genericPoint C) trivial).hom a ∈ O) →
    ∃ P : C,
      (∀ g : C.presheaf.stalk P,
        (C.presheaf.stalkSpecializes (genericPoint_specializes P)).hom g ∈ O) ∧
      (∀ g ∈ IsLocalRing.maximalIdeal (C.presheaf.stalk P),
        O.valuation ((C.presheaf.stalkSpecializes (genericPoint_specializes P)).hom g) < 1) :=
by
  intro Ω _ C _ sC _ O hO
  have hE : ValuativeCriterion.Existence sC := by
    have h : (ValuativeCriterion.Existence ⊓ @QuasiCompact) sC := by
      rw [← UniversallyClosed.eq_valuativeCriterion]; infer_instance
    exact h.1
  let χ : Ω →+* O := ((Scheme.ΓSpecIso (.of Ω)).inv ≫ sC.appTop ≫
        C.presheaf.germ ⊤ (genericPoint C) trivial).hom.codRestrict O hO
  let g : Spec (.of O) ⟶ Spec (.of Ω) := Spec.map (CommRingCat.ofHom χ)
  let i₁ : Spec (.of C.functionField) ⟶ C := C.fromSpecStalk (genericPoint C)
  have hspec : C.fromSpecStalk (genericPoint C) ≫ sC =
      Spec.map ((Scheme.ΓSpecIso (.of Ω)).inv ≫ sC.appTop ≫
        C.presheaf.germ ⊤ (genericPoint C) trivial) := by
    simp only [Spec.map_comp, Category.assoc]
    rw [← Scheme.fromSpecStalk_toSpecΓ_assoc, ← Scheme.toSpecΓ_naturality_assoc,
      toSpecΓ_SpecMap_ΓSpecIso_inv, Category.comp_id]
  have hsq : i₁ ≫ sC = Spec.map (CommRingCat.ofHom (algebraMap O C.functionField)) ≫ g := by
    have e : CommRingCat.ofHom χ ≫ CommRingCat.ofHom (algebraMap O C.functionField) =
        ((Scheme.ΓSpecIso (.of Ω)).inv ≫ sC.appTop ≫
          C.presheaf.germ ⊤ (genericPoint C) trivial) := by
      ext a; rfl
    show C.fromSpecStalk (genericPoint C) ≫ sC = _
    rw [hspec, ← e, Spec.map_comp]
  let S : ValuativeCommSq sC := ⟨O, C.functionField, i₁, g, ⟨hsq⟩⟩
  have := hE S
  let l : Spec (.of O) ⟶ C := S.commSq.lift
  have hl1 : Spec.map (CommRingCat.ofHom (algebraMap O C.functionField)) ≫ l = i₁ :=
    S.commSq.fac_left
  let ψ := Scheme.stalkClosedPointTo l
  have hψloc : IsLocalHom ψ.hom := Scheme.isLocalHom_stalkClosedPointTo l
  have hgerm : C.presheaf.stalkSpecializes
      (genericPoint_specializes (l (IsLocalRing.closedPoint O))) =
      ψ ≫ CommRingCat.ofHom (algebraMap O C.functionField) := by
    apply Spec.map_inj.mp
    apply (cancel_mono (C.fromSpecStalk (l (IsLocalRing.closedPoint O)))).mp
    rw [Spec.map_comp, Category.assoc, Scheme.Spec_stalkClosedPointTo_fromSpecStalk, hl1,
      Scheme.SpecMap_stalkSpecializes_fromSpecStalk]
  refine ⟨l (IsLocalRing.closedPoint O), fun s => ?_, fun s hs => ?_⟩
  · rw [hgerm]
    exact (ψ.hom s).2
  · rw [hgerm]
    have hns : ψ.hom s ∈ IsLocalRing.maximalIdeal O := by
      refine (IsLocalRing.mem_maximalIdeal _).mpr (fun hu => ?_)
      exact ((IsLocalRing.mem_maximalIdeal _).mp hs) (isUnit_of_map_unit ψ.hom s hu)
    exact (ValuationSubring.valuation_lt_one_iff O (ψ.hom s)).mp hns

theorem wcpa_dj_lr1k_nsr_gub_itapb_curve_dominated_eq : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (C : Scheme.{u}) [AlgebraicGeometry.IsIntegral C]
    (sC : C ⟶ Spec (.of Ω)) [IsProper sC] [SmoothOfRelativeDimension 1 sC]
    (O : ValuationSubring C.functionField) (P : C), O ≠ ⊤ →
    (∀ g : C.presheaf.stalk P,
        (C.presheaf.stalkSpecializes (genericPoint_specializes P)).hom g ∈ O) →
    (∀ g ∈ IsLocalRing.maximalIdeal (C.presheaf.stalk P),
        O.valuation ((C.presheaf.stalkSpecializes (genericPoint_specializes P)).hom g) < 1) →
    IsClosed ({P} : Set C) ∧ ∀ z : C.functionField, z ∈ O ↔
      ∃ g : C.presheaf.stalk P,
        (C.presheaf.stalkSpecializes (genericPoint_specializes P)).hom g = z :=
