    obtain ⟨c', hc'⟩ := wc_supp_unit_twist_isUnit EY
    have htw := wc_supp_hom_twist_formula EY hEY (wcSuppUnitMap EY) V
      (((Limits.kernel.ι (wcSuppUnitMap EY)).val.app (Opposite.op V)).hom p)
    rw [hk] at htw
    have h1 := congrArg
      (fun φ : C(↥(Limits.pullback V.hom iY), ULift.{u+1} ℚ_[ℓ]) => φ z) htw
    have h2 := congrArg (fun φ : C(↥ZY, ULift.{u+1} ℚ_[ℓ]) =>
      φ ((Limits.pullback.snd V.hom iY).base.hom z)) hc'
