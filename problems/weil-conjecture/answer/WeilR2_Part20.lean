  obtain ⟨τ, -, hτP⟩ := wc_qmbt_xspl_shens_closed_fibre_pushout hπ hx₀ hsh hπ' hπ'2 hgen _
    (ρ.comp θ) (algebraMap _ _)
    (fun p => by rw [RingHom.comp_apply, hθX p, hρX p])
    (fun a => by
      have e2 := RingHom.congr_fun hθA a
      have e3 := RingHom.congr_fun hρA (ιA a)
      simp only [RingHom.comp_apply] at e2 e3 ⊢
      rw [e2, e3])

  have hSpec : Spec.map (CommRingCat.ofHom (ρ.comp θ)) =
      eO.hom ≫ (Limits.pullback.fst (r₁ ≫ Spec.map (CommRingCat.ofHom
          (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA))))) (wcQmSp A') ⁻¹ᵁ
            e0.opensRange).ι ≫
        Limits.pullback.fst (r₁ ≫ Spec.map (CommRingCat.ofHom
          (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA))))) (wcQmSp A') ≫ r₁ ≫
          Spec.map (CommRingCat.ofHom θ) := by
    rw [CommRingCat.ofHom_comp, Spec.map_comp, ← heO]
    simp only [Category.assoc]
  rw [hSpec] at hτP

  obtain ⟨e₂⟩ := s5 hP _ eO _ hτP
  exact ⟨Xs'.isoOfEq hWeq ≪≫ e₂⟩

theorem wc_qmbt_xspl_sepclosed_quadric_et_h1 (K : Type u) [Field K] [IsSepClosed K]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓK : ((ℓ : ℕ) : K) ≠ 0) {n : ℕ} (hn : Even n) (hn4 : 4 ≤ n)
    (cb : Matrix (Fin n) (Fin n) K) (hcb : IsUnit (cb + cb.transpose).det) :
    Subsingleton (wcEtCoh (Spec (.of (wcQuadModelRing K n 1 cb))) ℓ 1) :=
by
  classical
  have hℓP : ℓ.Prime := Fact.out
  have hint : (algebraMap K (AlgebraicClosure K)).IsIntegral := by
    haveI := AlgebraicClosure.isAlgebraic K
    intro x
    exact Algebra.IsIntegral.isIntegral x
  have hℓΩ : ((ℓ : ℕ) : AlgebraicClosure K) ≠ 0 := by
    rw [← map_natCast (algebraMap K (AlgebraicClosure K))]
    exact (map_ne_zero _).mpr hℓK
  obtain ⟨e⟩ := wc_et_coh_purely_inseparable_invariance K (AlgebraicClosure K) hint
    (Spec (.of (wcQuadModelRing K n 1 cb))) (wcQuadModelStr K n 1 cb) ℓ 1
  obtain ⟨ψ⟩ := wc_quadric_model_generic_fibre_hyperbolic_iso K n hn (by omega) 1 cb hcb
    (AlgebraicClosure K) (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))
    (by rw [map_one]; exact one_ne_zero)
  haveI := (wc_hyperbolic_affine_quadric_low_vanishing (AlgebraicClosure K) ℓ hℓP hℓΩ n hn
    (by omega)).2 1 le_rfl (by omega)
  obtain ⟨E⟩ := wc_et_coh_iso_invariance ψ.hom ℓ 1
  haveI := E.symm.subsingleton
  exact e.symm.subsingleton

