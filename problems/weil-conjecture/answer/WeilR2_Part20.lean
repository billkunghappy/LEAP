    have e : ∀ φ : Limits.kernel (wcSuppUnitMap Dj) ⟶ N, (wcSliceRes V ℓ Vo).map φ =
        Φiso.inv.app _ ≫ Dw.Φ.map φ ≫ Φiso.hom.app N :=
      fun φ => (NatIso.naturality_1 Φiso φ).symm
    refine ⟨fun φ₁ φ₂ h => hinj ?_, fun g => ?_⟩
    · have h' : Dw.Φ.map φ₁ = Dw.Φ.map φ₂ := (cancel_epi ε).mp h
      show (wcSliceRes V ℓ Vo).map φ₁ = (wcSliceRes V ℓ Vo).map φ₂
      rw [e, e, h']
    · obtain ⟨φ, hφ⟩ := hsurj (Φiso.inv.app _ ≫
        ((Dw.Φ.map (Limits.kernel.ι (wcSuppUnitMap Dj)) ≫ Dw.μ.hom) ≫ g) ≫ Φiso.hom.app N)
      refine ⟨φ, ?_⟩
      have hφ' : (wcSliceRes V ℓ Vo).map φ = Φiso.inv.app _ ≫
          ((Dw.Φ.map (Limits.kernel.ι (wcSuppUnitMap Dj)) ≫ Dw.μ.hom) ≫ g) ≫
            Φiso.hom.app N := hφ
      have k0 := (e φ).symm.trans hφ'
      have k : Dw.Φ.map φ =
          (Dw.Φ.map (Limits.kernel.ι (wcSuppUnitMap Dj)) ≫ Dw.μ.hom) ≫ g :=
        (cancel_mono (Φiso.hom.app N)).mp ((cancel_epi (Φiso.inv.app _)).mp k0)
      show ε ≫ Dw.Φ.map φ = g
      rw [k, ← Category.assoc, h1, Category.id_comp]
  have hvan : ∀ (I : SheafOfModules.{u+1} (wcRingSheaf V ℓ)) [Injective I] (k : ℕ)
      (e : Abelian.Ext (SheafOfModules.unit (wcRingSheaf Wo.toScheme ℓ)) (Dw.Φ.obj I) (k + 1)),
      e = 0 := by
    intro I hI k e
    have hRI : Injective ((wcSliceRes V ℓ Vo).obj I) :=
      @wc_open_slice_res_preserves_injective V ℓ _ Vo hVo hG I hI
    haveI : Injective (Dw.Φ.obj I) := Injective.of_iso (Φiso.app I).symm hRI
    exact Abelian.Ext.eq_zero_of_injective e
  haveI : EnoughInjectives (SheafOfModules.{u+1} (wcRingSheaf V ℓ)) :=
    sheafOfModules_enoughInjectives (Scheme.ProEt.topology V) (wcRingSheaf V ℓ)
  have hT := ext_transfer_of_corep Dw.Φ (Limits.kernel (wcSuppUnitMap Dj))
    (SheafOfModules.unit (wcRingSheaf Wo.toScheme ℓ)) ε hhom hvan N q
  have hFy : (Abelian.Ext.mk₀ ε).comp (Abelian.Ext.mapExactFunctor Dw.Φ y) (zero_add q) = 0 :=
    hW1 _
  have hF0 : (Abelian.Ext.mk₀ ε).comp
      (Abelian.Ext.mapExactFunctor Dw.Φ (0 : Abelian.Ext (Limits.kernel (wcSuppUnitMap Dj)) N q))
      (zero_add q) = 0 := by
    rw [Abelian.Ext.mapExactFunctor_zero, Abelian.Ext.comp_zero]
  exact hT.1 (hFy.trans hF0.symm)

theorem wc_supp_ker_self_ext_vanish {S Z : Scheme.{u}} (i : Z ⟶ S) [IsClosedImmersion i]
    [IsLocallyNoetherian S] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (E : wcHMPullData i ℓ) (hE : wcHMPullCanonical E) :
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
    ∀ (q : ℕ) (x : Abelian.Ext (Limits.kernel (wcSuppUnitMap E)) (wcSuppObj E) q), x = 0 :=
by
  letI instS : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
  intro q x
  have hcl : IsClosed (Set.range i) := (Scheme.Hom.isClosedEmbedding i).isClosed_range
  let Wo : S.Opens := ⟨(Set.range i)ᶜ, hcl.isOpen_compl⟩
  have hW : (Wo : Set ↥S) = (Set.range i)ᶜ := rfl
  obtain ⟨Dw, hDw⟩ := wc_hm_pull_data_exists Wo.ι ℓ
  letI instW : HasExt (SheafOfModules.{u+1} (wcRingSheaf Wo.toScheme ℓ)) := HasExt.standard _
  haveI := Dw.additive
  haveI := Dw.presLim
  haveI := Dw.presColim
  have hdisj : ∀ (t : ↥Wo.toScheme) (z : ↥Z), Wo.ι t ≠ i z := by
    intro t z h
    have h1 : Wo.ι t ∈ (Wo : Set ↥S) := by
      rw [← Scheme.Opens.range_ι]
      exact ⟨t, rfl⟩
    rw [hW, h] at h1
    exact h1 ⟨z, rfl⟩
  have hempty : IsEmpty ↥(Limits.pullback Wo.ι i) := by
    refine ⟨fun p =>
      hdisj ((Limits.pullback.fst Wo.ι i) p) ((Limits.pullback.snd Wo.ι i) p) ?_⟩
    have h : (Limits.pullback.fst Wo.ι i ≫ Wo.ι) p = (Limits.pullback.snd Wo.ι i ≫ i) p := by
      rw [Limits.pullback.condition]
    rwa [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at h
  have hkey : Dw.μ.inv ≫ Dw.Φ.map (wcSuppUnitMap E) = 0 := by
    apply (SheafOfModules.unitHomEquiv _).injective
    apply Subtype.ext
    funext X
    rw [SheafOfModules.unitHomEquiv_apply_coe, SheafOfModules.unitHomEquiv_apply_coe]
    have h7 := wc_supp_pull_unit_vanish_off i Wo.ι (Limits.pullback.fst Wo.ι i)
      (Limits.pullback.snd Wo.ι i) (IsPullback.of_hasPullback Wo.ι i) ℓ E Dw (Opposite.unop X)
      (fun x hx => by
        obtain ⟨p, _⟩ := hx
        exact hempty.false p)
    refine Eq.trans h7 ?_
    first
      | rfl
      | simp
  haveI : Epi (wcSuppUnitMap E) := wc_supp_unit_epi_of_closed i ℓ E hE
  haveI : Epi (Dw.Φ.map (wcSuppUnitMap E)) := inferInstance
  haveI hf : Epi (Dw.μ.inv ≫ Dw.Φ.map (wcSuppUnitMap E)) := epi_comp _ _
  have hZ : Limits.IsZero (Dw.Φ.obj (wcSuppObj E)) :=
    Limits.IsZero.of_epi_eq_zero _ hkey
  refine wc_qmbt_xspl_supp_ker_ext_vanish i E hE Wo hW Dw hDw (wcSuppObj E) q ?_ x
  intro x'
  rw [← Abelian.Ext.comp_mk₀_id x', hZ.eq_of_src (𝟙 _) 0, Abelian.Ext.mk₀_zero,
    Abelian.Ext.comp_zero]

