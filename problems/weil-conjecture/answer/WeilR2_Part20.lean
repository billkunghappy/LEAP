        (DerivedCategory.Q.obj (CochainComplex.mappingCone φ)))
      (g₀ : DerivedCategory.Q.obj (CochainComplex.mappingCone φ) ⟶ DerivedCategory.Q.obj X),
      (∀ v : (P.rightDerivedFunctorPlus ⋙ DerivedCategory.Plus.ι).obj
