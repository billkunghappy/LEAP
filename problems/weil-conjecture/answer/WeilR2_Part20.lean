    rw [hblf]; exact hps'
  have sqF := wc_qmbt_sfp_fibre_paste hP bl (wcQmSp A') hps''
    (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B₀)))
    (Spec.map (CommRingCat.ofHom (algebraMap (IsLocalRing.ResidueField B₀)
        (AlgebraicClosure (IsLocalRing.ResidueField B₀)))))
    (Spec.map (CommRingCat.ofHom lam)) ν hν1 hν2
  have sqG₀ := sqF.paste_horiz sqT
  have hνg : ν ≫ gP = Spec.map (CommRingCat.ofHom ω) := by
    apply sq₁.hom_ext
    · rw [Category.assoc, hgP1, ← Category.assoc, hν1, ← Spec.map_preimage a₀]
      simp only [Category.assoc, ← Spec.map_comp]
      congr 1
      refine CommRingCat.hom_ext (RingHom.ext fun x => ?_)
      have h1 := RingHom.congr_fun hωθ x
      simp only [RingHom.comp_apply, ω₀] at h1
      simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply]
      first | exact h1.symm | exact h1
    · rw [Category.assoc, hgP2, hν2]
      simp only [wcQmSp, ← Spec.map_comp]
      congr 1
      refine CommRingCat.hom_ext (RingHom.ext fun x => ?_)
      have h1 := RingHom.congr_fun hωA x
      simp only [RingHom.comp_apply] at h1
      simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply]
      first | exact h1.symm | exact h1
  have sqG := sqG₀
  rw [hνg] at sqG
  have hE := sqG.isoPullback_hom_snd
  have hωπ : ω (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)) π') = 0 := by
    have h1 := RingHom.congr_fun hωA π'
    simp only [RingHom.comp_apply] at h1
    rw [h1, (IsLocalRing.residue_eq_zero_iff _).mpr hπm, map_zero]

  have hbig : IsPullback (gP ≫ Spec.map (CommRingCat.ofHom
        (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)))))
      (Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA)))
      (Spec.map (CommRingCat.ofHom ιA)) (a₀ ≫ wcQuadModelStr A n π c) := by
