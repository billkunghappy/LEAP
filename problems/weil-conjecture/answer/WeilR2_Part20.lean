    intro S hS hK e he
    let α := (DerivedCategory.singleFunctors
      (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))).shiftIso 1 0 1 (by norm_num)
    let g' := α.inv.app S.X₃ ≫
      (shiftFunctor (DerivedCategory (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))) (1 : ℤ)).map e
    have hg' : hS.singleTriangle.mor₂ ≫ g' = 0 := by
      change (DerivedCategory.singleFunctor (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)) 0).map S.g ≫
        α.inv.app S.X₃ ≫ _ = 0
      have nat := α.inv.naturality S.g
      rw [← Category.assoc, nat, Category.assoc, Functor.comp_map, ← Functor.map_comp, he,
        Functor.map_zero, Limits.comp_zero]
    obtain ⟨h, hh⟩ := Pretriangulated.Triangle.yoneda_exact₃ _
      hS.singleTriangle_distinguished g' hg'
    have h0 : h = 0 := by
      obtain ⟨h₀, rfl⟩ := (shiftFunctor (DerivedCategory (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)))
        (1 : ℤ)).map_surjective h
      let ι₂ := (DerivedCategory.singleFunctorIsoCompQ
        (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)) 0).app S.X₂
      have hx := hK (h₀ ≫ (shiftFunctor (DerivedCategory (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)))
        (1 : ℤ)).map ι₂.inv)
      have : h₀ = 0 := by
        calc h₀ = (h₀ ≫ (shiftFunctor (DerivedCategory (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)))
              (1 : ℤ)).map ι₂.inv) ≫
              (shiftFunctor (DerivedCategory (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)))
                (1 : ℤ)).map ι₂.hom := by
              rw [Category.assoc, ← Functor.map_comp, Iso.inv_hom_id,
                CategoryTheory.Functor.map_id, Category.comp_id]
          _ = 0 := by rw [hx, Limits.zero_comp]
      rw [this, Functor.map_zero]
    have hg0 : g' = 0 := by rw [hh, h0, Limits.comp_zero]
    have hse : (shiftFunctor (DerivedCategory (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)))
        (1 : ℤ)).map e = 0 := by
      have : (shiftFunctor (DerivedCategory (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)))
          (1 : ℤ)).map e = α.hom.app S.X₃ ≫ g' := by
        simp only [g', Iso.hom_inv_id_app_assoc]
      rw [this, hg0, Limits.comp_zero]
    exact (shiftFunctor (DerivedCategory (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)))
      (1 : ℤ)).map_injective (hse.trans (Functor.map_zero _ _ _).symm)

  haveI : Epi (wcSuppUnitMap E₁) := wc_supp_unit_epi_of_closed i₁ ℓ E₁ hE₁
  obtain ⟨hk, hS'⟩ := s1 (wcSuppUnitMap E₁) (wcSuppUnitMap E₂) ρ₁ ρ₂ hz hS

  let Wo : Xs'.Opens := ⟨(Set.range i₁)ᶜ,
    (IsClosedImmersion.isClosedEmbedding i₁).isClosed_range.isOpen_compl⟩
  have hW : (Wo : Set ↥Xs') = (Set.range i₁)ᶜ := rfl
  obtain ⟨Dw, hDw⟩ := wc_hm_pull_data_exists Wo.ι ℓ
  have hWsub : (Wo : Set ↥Xs') ⊆ Set.range i₂ := by
    intro z hz
    have hz' : z ∉ Set.range i₁ := hz
    rw [h₂]
    rw [h₁] at hz'
    by_contra hcon
    exact hz' (subset_closure hcon)

  haveI : IsIso (Dw.Φ.map (wcSuppUnitMap E₂)) :=
    wc_qmbt_xspl_supp_unit_open_isIso i₂ E₂ hE₂ Wo hWsub Dw hDw
  let φ : Dw.Φ.obj (wcSuppObj E₂) ≅ SheafOfModules.unit (wcRingSheaf Wo.toScheme ℓ) :=
    (asIso (Dw.Φ.map (wcSuppUnitMap E₂))).symm ≪≫ Dw.μ

  have hWo : (Wo : Set ↥Xs') = (closure ((fun z => (ι' ≫ bl ≫ Limits.pullback.fst
      (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))) z) ⁻¹'
        {IsLocalRing.closedPoint B₀})ᶜ)ᶜ := by
    rw [hW, h₁]
  obtain ⟨eW⟩ := wc_qmbt_xspl_exc_open_quadric_iso hℓ hn hn4 hπ hc hx₀ hsh hps hℓ' hπ' hπ'2
    hgen hφ' halg' hbl hblf hpb' hps' Wo hWo
  have hcb : IsUnit ((c.map (fun a => IsLocalRing.residue A' (ιA a))) +
      (c.map (fun a => IsLocalRing.residue A' (ιA a))).transpose).det := by
    have e1 : (c.map (fun a => IsLocalRing.residue A' (ιA a))) +
        (c.map (fun a => IsLocalRing.residue A' (ιA a))).transpose =
        ((IsLocalRing.residue A').comp ιA).mapMatrix (c + c.transpose) := by
      ext i j
      simp [Matrix.add_apply, Matrix.transpose_apply]
    rw [e1, ← RingHom.map_det]
    exact hc.map _
  have hℓk : ((ℓ : ℕ) : IsLocalRing.ResidueField A') ≠ 0 := by
    have h := hℓ'.map (IsLocalRing.residue A')
    rw [map_natCast] at h
    exact h.ne_zero
  haveI hsub := wc_qmbt_xspl_sepclosed_quadric_et_h1 (IsLocalRing.ResidueField A') ℓ hℓk hn hn4 _
