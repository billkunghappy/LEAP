  obtain ⟨η, hηinj, hηlin⟩ := wc_hm_line_of_et_tors_qcsep Wo.toScheme ℓ 1 hfin hcard
  obtain ⟨av, hav⟩ := hsurj v
  obtain ⟨aw, haw⟩ := hsurj w
  have hav0 : η av ≠ 0 := by
    intro h0
    apply hv
    have h00 : av = 0 := hηinj (h0.trans (map_zero η).symm)
    rw [← hav, h00, map_zero]
  obtain ⟨c, hc⟩ : ∃ c : ℚ_[ℓ], c = η aw / η av := ⟨_, rfl⟩
  refine ⟨c, ?_⟩
  have hsc : wcHMScalar Wo.toScheme ℓ 1 c av = aw := by
    apply hηinj
    rw [hηlin, hc, div_mul_cancel₀ _ hav0]
  calc w = δ aw := haw.symm
    _ = δ (wcHMScalar Wo.toScheme ℓ 1 c av) := by rw [hsc]
    _ = _ := by rw [hlin, hav]

