        (fun j => ((Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))) ≫ a₀).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A n π c))).inv.hom
            (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X j)))))))) bl)
    (hblf : bl ≫ Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA)) = f)
    {XE' : Scheme.{u}} {p' : XE' ⟶ Xm} {q' : XE' ⟶ Spec (.of L')}
    (hpb' : IsPullback p' q' f (Spec.map (CommRingCat.ofHom φ')))
    {Xs' : Scheme.{u}} {ι' : Xs' ⟶ Xm} {s' : Xs' ⟶ Spec (.of (IsLocalRing.ResidueField A'))}
    (hps' : IsPullback ι' s' f (wcQmSp A'))
    {βs : Xs' ⟶ Xs}
    (hβ : βs ≫ ι = ι' ≫ bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA)))
    (Dβ : wcHMPullData βs ℓ) (hDβ : wcHMPullCanonical Dβ)
    [EnoughInjectives (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))]
    (Dp' : wcHMPullData p' ℓ) (hDp' : wcHMPullCanonical Dp')
    (Di' : wcHMPullData ι' ℓ) (hDi' : wcHMPullCanonical Di')
    (I' : InjectiveResolution (SheafOfModules.unit (wcRingSheaf XE' ℓ)))
    {Z₁ Z₂ ZY : Scheme.{u}} (i₁ : Z₁ ⟶ Xs') (i₂ : Z₂ ⟶ Xs') (iY : ZY ⟶ Xs')
    [IsClosedImmersion i₁] [IsClosedImmersion i₂] [IsClosedImmersion iY]
    (h₁ : Set.range i₁ = closure ((fun z => (ι' ≫ bl ≫ Limits.pullback.fst
      (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))) z) ⁻¹'
        {IsLocalRing.closedPoint B₀})ᶜ)
    (h₂ : Set.range i₂ = (fun z => (ι' ≫ bl ≫ Limits.pullback.fst
      (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))) z) ⁻¹'
        {IsLocalRing.closedPoint B₀})
    (hY : Set.range iY = closure ((fun z => (ι' ≫ bl ≫ Limits.pullback.fst
      (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))) z) ⁻¹'
        {IsLocalRing.closedPoint B₀})ᶜ ∩ (fun z => (ι' ≫ bl ≫ Limits.pullback.fst
      (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))) z) ⁻¹'
        {IsLocalRing.closedPoint B₀})
    (V : Xs'.ProEt) (h1 : IsAffine V.left) (z : V.left)
    (hz5 : HenselianLocalRing (V.left.presheaf.stalk z) ∧ IsSepClosed (V.left.residueField z))
    (O : (Limits.pullback (V.left.fromSpecStalk z) (Limits.pullback.fst V.hom i₁)).Opens)
    (hO : (O : Set ↥(Limits.pullback (V.left.fromSpecStalk z) (Limits.pullback.fst V.hom i₁))) =
      ⇑(Limits.pullback.fst (V.left.fromSpecStalk z) (Limits.pullback.fst V.hom i₁)) ⁻¹'
        (Set.range ⇑(Limits.pullback.fst (V.left.fromSpecStalk z)
          (Limits.pullback.fst V.hom iY)))ᶜ) :
    Finite (wcEtCoh O.toScheme ℓ 1) ∧ Nat.card (wcEtCoh O.toScheme ℓ 1) ≤ ℓ :=
by
  classical
  have hp : ℓ.Prime := Fact.out

  have L3 : ∀ (D : Type u) [CommRing D] [IsDomain D] (w : D) (_ : Prime w) (N : ℕ) (_ : 0 < N)
      (_ : ∀ c : D, IsUnit c → ∃ d : D, d ^ N = c),
      Finite ((Localization.Away w)ˣ ⧸
        (powMonoidHom N : (Localization.Away w)ˣ →* (Localization.Away w)ˣ).range) ∧
      Nat.card ((Localization.Away w)ˣ ⧸
        (powMonoidHom N : (Localization.Away w)ˣ →* (Localization.Away w)ˣ).range) ≤ N := by
    intro D _ _ w hw N hN hdiv
    have hinj : Function.Injective (algebraMap D (Localization.Away w)) :=
      IsLocalization.injective (Localization.Away w)
        (powers_le_nonZeroDivisors_of_noZeroDivisors hw.ne_zero)
    let ω : (Localization.Away w)ˣ :=
      (IsLocalization.Away.algebraMap_isUnit (S := Localization.Away w) w).unit
    have hω : (ω : Localization.Away w) = algebraMap D (Localization.Away w) w :=
      IsUnit.unit_spec _
    have hfac : ∀ M : ℕ, ∀ x y : D, x * y = w ^ M → ∃ i : ℕ, ∃ ε : Dˣ, x = ε * w ^ i := by
      intro M
      induction M with
      | zero =>
        intro x y h
        have hu : IsUnit x := isUnit_of_mul_isUnit_left (x := x) (y := y)
          (by rw [h, pow_zero]; exact isUnit_one)
        exact ⟨0, hu.unit, by simp⟩
      | succ M ih =>
        intro x y h
        have hd : w ∣ x * y := ⟨w ^ M, by rw [h, pow_succ']⟩
        rcases hw.dvd_or_dvd hd with ⟨x', rfl⟩ | ⟨y', rfl⟩
        · have h' : x' * y = w ^ M := by
            apply mul_left_cancel₀ hw.ne_zero
            rw [← mul_assoc, h, pow_succ']
          obtain ⟨i, ε, hε⟩ := ih x' y h'
          exact ⟨i + 1, ε, by rw [hε, pow_succ']; ring⟩
        · have h' : x * y' = w ^ M := by
            apply mul_left_cancel₀ hw.ne_zero
            rw [show w * (x * y') = x * (w * y') by ring, h, pow_succ']
          exact ih x y' h'
    have hshape : ∀ u : (Localization.Away w)ˣ, ∃ ε : Dˣ, ∃ k : ℤ,
        u = Units.map (algebraMap D (Localization.Away w) : D →* Localization.Away w) ε *
          ω ^ k := by
      intro u
      obtain ⟨⟨r, ⟨_, n, rfl⟩⟩, hr⟩ := IsLocalization.surj (Submonoid.powers w)
        (u : Localization.Away w)
      obtain ⟨⟨r', ⟨_, m, rfl⟩⟩, hr'⟩ := IsLocalization.surj (Submonoid.powers w)
        ((u⁻¹ : (Localization.Away w)ˣ) : Localization.Away w)
      have hr2 : (u : Localization.Away w) * algebraMap D (Localization.Away w) (w ^ n) =
          algebraMap D (Localization.Away w) r := hr
      have hr2' : ((u⁻¹ : (Localization.Away w)ˣ) : Localization.Away w) *
          algebraMap D (Localization.Away w) (w ^ m) = algebraMap D (Localization.Away w) r' :=
        hr'
      have e1 : ((u : Localization.Away w) * algebraMap D (Localization.Away w) (w ^ n)) *
          (((u⁻¹ : (Localization.Away w)ˣ) : Localization.Away w) *
            algebraMap D (Localization.Away w) (w ^ m)) =
          algebraMap D (Localization.Away w) (w ^ (n + m)) := by
        rw [pow_add, map_mul]
        calc _ = ((u : Localization.Away w) *
              ((u⁻¹ : (Localization.Away w)ˣ) : Localization.Away w)) *
              (algebraMap D (Localization.Away w) (w ^ n) *
                algebraMap D (Localization.Away w) (w ^ m)) := by ring
          _ = _ := by rw [Units.mul_inv, one_mul]
      have hrr : r * r' = w ^ (n + m) := hinj (by rw [map_mul, ← hr2, ← hr2', e1])
      obtain ⟨i, ε, hε⟩ := hfac _ r r' hrr
      have key : u * ω ^ n =
          Units.map (algebraMap D (Localization.Away w) : D →* Localization.Away w) ε *
            ω ^ i := by
        apply Units.ext
        simp only [Units.val_mul, Units.val_pow_eq_pow_val, hω, Units.coe_map,
          MonoidHom.coe_coe]
        rw [← map_pow, hr2, hε, map_mul, map_pow]
      refine ⟨ε, (i : ℤ) - n, ?_⟩
      rw [zpow_sub, zpow_natCast, zpow_natCast, ← mul_assoc, ← key, mul_inv_cancel_right]
    have hNz : (0 : ℤ) < N := by exact_mod_cast hN
    let F : Fin N → (Localization.Away w)ˣ ⧸
        (powMonoidHom N : (Localization.Away w)ˣ →* (Localization.Away w)ˣ).range :=
      fun t => ((ω ^ (t : ℕ) : (Localization.Away w)ˣ) : (Localization.Away w)ˣ ⧸
        (powMonoidHom N : (Localization.Away w)ˣ →* (Localization.Away w)ˣ).range)
    have hF : Function.Surjective F := by
      intro q
      obtain ⟨u, rfl⟩ := QuotientGroup.mk_surjective q
      obtain ⟨ε, k, hu⟩ := hshape u
      obtain ⟨d, hd⟩ := hdiv ε ε.isUnit
      have hdu : IsUnit d := (isUnit_pow_iff hN.ne').1 (hd ▸ ε.isUnit)
      have hdN : (Units.map (algebraMap D (Localization.Away w) : D →* Localization.Away w)
          hdu.unit) ^ N =
          Units.map (algebraMap D (Localization.Away w) : D →* Localization.Away w) ε := by
        rw [← map_pow]
        congr 1
        apply Units.ext
        simp [hd]
      have hk0 : 0 ≤ k % (N : ℤ) := Int.emod_nonneg k hNz.ne'
      have hk1 : k % (N : ℤ) < N := Int.emod_lt_of_pos k hNz
      refine ⟨⟨(k % (N : ℤ)).toNat, by omega⟩, ?_⟩
      show ((ω ^ ((k % (N : ℤ)).toNat) : (Localization.Away w)ˣ) : (Localization.Away w)ˣ ⧸
        (powMonoidHom N : (Localization.Away w)ˣ →* (Localization.Away w)ˣ).range) = u
      apply QuotientGroup.eq.2
      refine ⟨Units.map (algebraMap D (Localization.Away w) : D →* Localization.Away w)
        hdu.unit * ω ^ (k / (N : ℤ)), ?_⟩
      have hωk : ω ^ k = (ω ^ (k / (N : ℤ))) ^ N * ω ^ (k % (N : ℤ)) := by
        rw [← zpow_natCast, ← zpow_mul, ← zpow_add]
        congr 1
        linarith [Int.mul_ediv_add_emod k (N : ℤ)]
      have hωt : ω ^ ((k % (N : ℤ)).toNat) = ω ^ (k % (N : ℤ)) := by
        rw [← zpow_natCast, Int.toNat_of_nonneg hk0]
      show (Units.map (algebraMap D (Localization.Away w) : D →* Localization.Away w) hdu.unit *
        ω ^ (k / (N : ℤ))) ^ N = _
      rw [hu, hωt, hωk, mul_pow, hdN, mul_comm _⁻¹, mul_assoc, mul_assoc, mul_inv_cancel,
        mul_one]
    haveI : Finite ((Localization.Away w)ˣ ⧸
        (powMonoidHom N : (Localization.Away w)ˣ →* (Localization.Away w)ˣ).range) :=
      Finite.of_surjective F hF
    refine ⟨inferInstance, ?_⟩
    calc _ ≤ Nat.card (Fin N) := Nat.card_le_card_of_surjective F hF
      _ = N := Nat.card_fin N

  have L2 : ∀ {S R T : CommRingCat.{u}} (φ : S ⟶ R) (θ : S ⟶ T)
      (_ : Function.Surjective θ.hom) (s : (S : Type u)) (_ : θ.hom s = 0)
      (ψ : T ⟶ CommRingCat.of ((R : Type u) ⧸ Ideal.span {φ.hom s}))
      (_ : θ ≫ ψ = φ ≫ CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {φ.hom s})))
      (_ : WeaklyEtale (Spec.map φ)), WeaklyEtale (Spec.map ψ) := by
    intro S R T φ θ hθ s hs ψ hψ hφ
    have hdesc : ∀ c : Limits.PushoutCocone φ θ, ∀ x ∈ Ideal.span {φ.hom s},
        c.inl.hom x = 0 := by
      intro c x hx
      obtain ⟨y, rfl⟩ := Ideal.mem_span_singleton'.1 hx
      have h : (φ ≫ c.inl).hom s = (θ ≫ c.inr).hom s := by rw [c.condition]
      have h2 : c.inl.hom (φ.hom s) = 0 := by
        refine h.trans ?_
        show c.inr.hom (θ.hom s) = 0
        rw [hs, map_zero]
      rw [map_mul, h2, mul_zero]
    have hpo : IsPushout φ θ (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {φ.hom s}))) ψ := by
      refine IsPushout.of_isColimit (c := Limits.PushoutCocone.mk _ ψ hψ.symm) ?_
      refine Limits.PushoutCocone.IsColimit.mk hψ.symm
        (fun c => CommRingCat.ofHom
          (Ideal.Quotient.lift (Ideal.span {φ.hom s}) c.inl.hom (hdesc c))) ?_ ?_ ?_
      · intro c
        apply CommRingCat.hom_ext
        apply RingHom.ext
        intro x
        show Ideal.Quotient.lift (Ideal.span {φ.hom s}) c.inl.hom (hdesc c)
          (Ideal.Quotient.mk (Ideal.span {φ.hom s}) x) = c.inl.hom x
        exact Ideal.Quotient.lift_mk _ _ _
      · intro c
        apply CommRingCat.hom_ext
        apply RingHom.ext
        intro t
        obtain ⟨x, rfl⟩ := hθ t
        have e1 : ψ.hom (θ.hom x) = Ideal.Quotient.mk (Ideal.span {φ.hom s}) (φ.hom x) := by
          have := congrArg (fun f => f.hom x) hψ
          simpa using this
        have e2 : c.inl.hom (φ.hom x) = c.inr.hom (θ.hom x) := by
          have := congrArg (fun f => f.hom x) c.condition
          simpa using this
        show Ideal.Quotient.lift (Ideal.span {φ.hom s}) c.inl.hom (hdesc c) (ψ.hom (θ.hom x)) =
          c.inr.hom (θ.hom x)
        rw [e1, Ideal.Quotient.lift_mk, e2]
      · intro c m hm1 _
        apply CommRingCat.hom_ext
        apply Ideal.Quotient.ringHom_ext
        apply RingHom.ext
        intro x
        show m.hom (Ideal.Quotient.mk (Ideal.span {φ.hom s}) x) =
          Ideal.Quotient.lift (Ideal.span {φ.hom s}) c.inl.hom (hdesc c) (Ideal.Quotient.mk _ x)
        rw [Ideal.Quotient.lift_mk]
        exact congrArg (fun f => f.hom x) hm1
    have hpb := isPullback_SpecMap_of_isPushout _ _ _ _ hpo
    exact MorphismProperty.of_isPullback (P := @WeaklyEtale) hpb hφ

  have LK : ∀ (K : Type u) [CommRing K] (n : ℕ),
      Function.Surjective (MvPolynomial.aeval (R := K)
        (Fin.cons (0 : MvPolynomial (Fin n) K) MvPolynomial.X :
          Fin (n + 1) → MvPolynomial (Fin n) K)) ∧
      RingHom.ker (MvPolynomial.aeval (R := K)
        (Fin.cons (0 : MvPolynomial (Fin n) K) MvPolynomial.X :
          Fin (n + 1) → MvPolynomial (Fin n) K)) =
        Ideal.span {MvPolynomial.X 0} := by
    intro K _ n
    set θ := (MvPolynomial.aeval (R := K)
        (Fin.cons (0 : MvPolynomial (Fin n) K) MvPolynomial.X :
          Fin (n + 1) → MvPolynomial (Fin n) K)) with hθ
    set σ : MvPolynomial (Fin n) K →ₐ[K] MvPolynomial (Fin (n + 1)) K :=
      MvPolynomial.rename Fin.succ
    have hθσ : ∀ g, θ (σ g) = g := by
      intro g
      rw [hθ, MvPolynomial.aeval_rename]
      have : ((Fin.cons (0 : MvPolynomial (Fin n) K) MvPolynomial.X :
          Fin (n + 1) → MvPolynomial (Fin n) K) ∘ Fin.succ) = MvPolynomial.X := by
        funext i; simp
      rw [this, MvPolynomial.aeval_X_left]; rfl
    have h0 : θ (MvPolynomial.X 0) = 0 := by rw [hθ, MvPolynomial.aeval_X]; rfl
    have hiii : ∀ f, f - σ (θ f) ∈
        Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin (n + 1)) K)} := by
      intro f
      induction f using MvPolynomial.induction_on with
      | C a => simp [σ, θ]
      | add p q hp hq =>
        have : p + q - σ (θ (p + q)) = (p - σ (θ p)) + (q - σ (θ q)) := by
          simp only [map_add]; ring
        rw [this]; exact Ideal.add_mem _ hp hq
      | mul_X p i hp =>
        refine Fin.cases ?_ (fun j => ?_) i
        · have : p * MvPolynomial.X 0 - σ (θ (p * MvPolynomial.X 0)) =
              p * MvPolynomial.X 0 := by
            rw [map_mul, h0, mul_zero, map_zero, sub_zero]
          rw [this]
          exact Ideal.mul_mem_left _ _ (Ideal.subset_span rfl)
        · have hX : σ (θ (MvPolynomial.X j.succ)) = MvPolynomial.X j.succ := by
            rw [hθ, MvPolynomial.aeval_X]
            simp [σ]
          have : p * MvPolynomial.X j.succ - σ (θ (p * MvPolynomial.X j.succ)) =
              (p - σ (θ p)) * MvPolynomial.X j.succ := by
            rw [map_mul, map_mul, hX]; ring
          rw [this]
          exact Ideal.mul_mem_right _ _ hp
    refine ⟨fun g => ⟨σ g, hθσ g⟩, ?_⟩
    apply le_antisymm
    · intro f hf
      rw [RingHom.mem_ker] at hf
      have := hiii f
      rw [show θ f = 0 from hf, map_zero, sub_zero] at this
      exact this
    · rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker]
      exact h0

  have L4 : ∀ (κ : Type u) [Field κ] (r : ℕ) (R₀ : CommRingCat.{u}) [HenselianLocalRing R₀]
      [IsSepClosed (IsLocalRing.ResidueField R₀)]
      (ψ : CommRingCat.of (MvPolynomial (Fin (r + 1)) κ) ⟶ R₀) (_ : WeaklyEtale (Spec.map ψ)),
      Subsingleton (CommRing.Pic (Localization.Away (ψ.hom (MvPolynomial.X 0)))) := by
    intro κ _ r R₀ _ _ ψ hψ
