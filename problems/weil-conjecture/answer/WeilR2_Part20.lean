    have hhom : ∀ N : SheafOfModules.{u+1} (wcRingSheaf V ℓ),
        Function.Bijective (fun φ : Limits.kernel (wcSuppUnitMap Dj) ⟶ N => ε ≫ Dw.Φ.map φ) := by
      intro N
