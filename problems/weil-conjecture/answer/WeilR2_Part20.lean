    obtain ⟨τ, hτσ, hτt⟩ : ∃ τ : (ι' ⁻¹ᵁ U).toScheme ⟶
        Spec (.of (wcQuadModelRing (IsLocalRing.ResidueField A') n 0 cb)),
        τ ≫ Spec.map (CommRingCat.ofHom ρ) = ι' ∣_ U ≫ g ∧
        τ ≫ Spec.map (CommRingCat.ofHom (algebraMap (IsLocalRing.ResidueField A')
          (wcQuadModelRing (IsLocalRing.ResidueField A') n 0 cb))) = (ι' ⁻¹ᵁ U).ι ≫ s' :=
      ⟨hL.lift _ _ e, hL.lift_fst _ _ _, hL.lift_snd _ _ _⟩
    have Qτ : IsPullback (ι' ∣_ U) τ g (Spec.map (CommRingCat.ofHom ρ)) := by
      refine IsPullback.of_bot ?_ hτσ.symm hL
      rw [hτt, hgf]
      exact Q21
    have hτwe : WeaklyEtale τ := MorphismProperty.of_isPullback (P := @WeaklyEtale) Qτ hg
    have H : Set.range cR ⊆ Set.range (ι' ⁻¹ᵁ U).ι := by
      rintro _ ⟨p, rfl⟩
      rw [Scheme.Opens.range_ι]
      exact hrange p
    obtain ⟨hV, hV1, hVwe⟩ : ∃ hV : Spec R ⟶ (ι' ⁻¹ᵁ U).toScheme,
        hV ≫ (ι' ⁻¹ᵁ U).ι = cR ∧ WeaklyEtale hV :=
      ⟨IsOpenImmersion.lift (ι' ⁻¹ᵁ U).ι cR H, IsOpenImmersion.lift_fac _ _ _,
        MorphismProperty.of_isPullback (P := @WeaklyEtale)
          (IsOpenImmersion.isPullback_lift_id cR (ι' ⁻¹ᵁ U).ι H).flip hcR⟩
    have hcswe : WeaklyEtale (hV ≫ τ) := by
      haveI := hVwe
      haveI := hτwe
      infer_instance
    have hcRp : ∀ p, cR p = (ι' ⁻¹ᵁ U).ι (hV p) := by
      intro p
      rw [← hV1, Scheme.Hom.comp_apply]

    have hstar : ∀ (w : (ι' ⁻¹ᵁ U).toScheme) (i : Fin n),
        Ideal.Quotient.mk (wcQuadModelIdeal (IsLocalRing.ResidueField A') n 0 cb)
          (MvPolynomial.X i) ∈ PrimeSpectrum.asIdeal (τ w) ↔
        Ideal.Quotient.mk (wcQuadModelIdeal A' n π' c') (MvPolynomial.X i) ∈
          PrimeSpectrum.asIdeal (g ((ι' ∣_ U) w)) := by
      intro w i
      have h1 : Spec.map (CommRingCat.ofHom ρ) (τ w) = g ((ι' ∣_ U) w) := by
        simp only [← Scheme.Hom.comp_apply, hτσ]
      rw [← h1]
      change _ ↔ ρ (Ideal.Quotient.mk (wcQuadModelIdeal A' n π' c') (MvPolynomial.X i)) ∈
        PrimeSpectrum.asIdeal (τ w)
      rw [hρX]

    have he1 : ∀ w : (ι' ⁻¹ᵁ U).toScheme, U.ι ((ι' ∣_ U) w) = ι' ((ι' ⁻¹ᵁ U).ι w) := by
      intro w
      simp only [← Scheme.Hom.comp_apply, morphismRestrict_ι]
    have hfib : ∀ w : (ι' ⁻¹ᵁ U).toScheme, f (U.ι ((ι' ∣_ U) w)) = IsLocalRing.closedPoint A' := by
      intro w
      rw [he1, ← Scheme.Hom.comp_apply, hps'.w, Scheme.Hom.comp_apply, wcQmSp, Spec.map_apply,
        CommRingCat.hom_ofHom]
      exact IsLocalRing.PrimeSpectrum.comap_residue A' _
    have hDD : ∀ w : (ι' ⁻¹ᵁ U).toScheme,
        Ideal.Quotient.mk (wcQuadModelIdeal (IsLocalRing.ResidueField A') n 0 cb)
          (MvPolynomial.X i1) ∈ PrimeSpectrum.asIdeal (τ w) ↔
        (ι' ≫ bb) ((ι' ⁻¹ᵁ U).ι w) = cp := by
      intro w
      rw [hstar, hadapt _ (hfib w), hO, he1, Scheme.Hom.comp_apply]

    have hcl : ∀ p : Spec R, cR p ∈ closure ((fun z => (ι' ≫ bb) z) ⁻¹' {cp})ᶜ ↔
        Ideal.Quotient.mk (wcQuadModelIdeal (IsLocalRing.ResidueField A') n 0 cb)
          (MvPolynomial.X i0) ∈ PrimeSpectrum.asIdeal ((hV ≫ τ) p) := by
      intro p
      constructor
      · intro hmem
        rw [Scheme.Hom.comp_apply]
        by_contra hn
        have hOopen : IsOpen ((ι' ⁻¹ᵁ U).ι '' (τ ⁻¹' (PrimeSpectrum.basicOpen
            (Ideal.Quotient.mk (wcQuadModelIdeal (IsLocalRing.ResidueField A') n 0 cb)
              (MvPolynomial.X i0)) : Set (PrimeSpectrum
                (wcQuadModelRing (IsLocalRing.ResidueField A') n 0 cb))))) :=
          (ι' ⁻¹ᵁ U).ι.isOpenEmbedding.isOpenMap _
            (τ.continuous.isOpen_preimage _ PrimeSpectrum.isOpen_basicOpen)
        have hpO : cR p ∈ (ι' ⁻¹ᵁ U).ι '' (τ ⁻¹' (PrimeSpectrum.basicOpen
            (Ideal.Quotient.mk (wcQuadModelIdeal (IsLocalRing.ResidueField A') n 0 cb)
              (MvPolynomial.X i0)) : Set (PrimeSpectrum
                (wcQuadModelRing (IsLocalRing.ResidueField A') n 0 cb)))) :=
          ⟨hV p, (PrimeSpectrum.mem_basicOpen _ _).mpr hn, (hcRp p).symm⟩
        obtain ⟨x, ⟨w, hw, rfl⟩, hxZ⟩ := mem_closure_iff.mp hmem _ hOopen hpO
        have hw' : Ideal.Quotient.mk (wcQuadModelIdeal (IsLocalRing.ResidueField A') n 0 cb)
            (MvPolynomial.X i0) ∉ PrimeSpectrum.asIdeal (τ w) :=
          (PrimeSpectrum.mem_basicOpen _ _).mp hw
        have hz : Ideal.Quotient.mk (wcQuadModelIdeal (IsLocalRing.ResidueField A') n 0 cb)
              (MvPolynomial.X i0) *
            Ideal.Quotient.mk (wcQuadModelIdeal (IsLocalRing.ResidueField A') n 0 cb)
              (MvPolynomial.X i1) ∈ PrimeSpectrum.asIdeal (τ w) := by
          rw [hL2a]
          exact zero_mem _
        have h1 := ((τ w).isPrime.mem_or_mem hz).resolve_left hw'
        exact hxZ ((hDD w).mp h1)
      · intro hmem
        have hle : (⟨Ideal.span {Ideal.Quotient.mk
            (wcQuadModelIdeal (IsLocalRing.ResidueField A') n 0 cb) (MvPolynomial.X i0)}, hL2b⟩ :
              PrimeSpectrum (wcQuadModelRing (IsLocalRing.ResidueField A') n 0 cb)) ⤳ (hV ≫ τ) p :=
          (PrimeSpectrum.le_iff_specializes _ _).mp ((Ideal.span_singleton_le_iff_mem _).mpr hmem)
        have hfl : GeneralizingMap (hV ≫ τ) := Flat.generalizingMap (hV ≫ τ)
        obtain ⟨p', hp', hcs⟩ := hfl hle
        have h1 : Ideal.Quotient.mk (wcQuadModelIdeal (IsLocalRing.ResidueField A') n 0 cb)
            (MvPolynomial.X i1) ∉ PrimeSpectrum.asIdeal ((hV ≫ τ) p') := by
          rw [hcs]
          exact hL2c
        have hp'Z : cR p' ∈ ((fun z => (ι' ≫ bb) z) ⁻¹' {cp})ᶜ := by
          intro hz
          apply h1
          rw [Scheme.Hom.comp_apply, hDD, ← hcRp]
          exact hz
        have hsp : cR p' ⤳ cR p := hp'.map cR.continuous
        exact closure_mono (Set.singleton_subset_iff.mpr hp'Z) (specializes_iff_mem_closure.mp hsp)
    refine ⟨hV ≫ τ, hcswe, fun p => ⟨?_, ?_⟩⟩
    · rw [h₁]
      exact hcl p
    · rw [hY, Set.mem_inter_iff, hcl p]
      refine and_congr Iff.rfl ?_
      show (ι' ≫ bb) (cR p) = cp ↔ _
      rw [Scheme.Hom.comp_apply hV τ, hDD, hcRp p]
  obtain ⟨hA, hB, hC⟩ := L2 (IsLocalRing.ResidueField A') r
    (Matrix.of fun i j : Fin (r + 2) =>
      if i.val = 0 ∧ j.val = 1 then (1 : IsLocalRing.ResidueField A') else 0) (fun _ _ => rfl)
  have hO := wc_qmbt_hl_b0_origin_fibre hπ hx₀ hsh
  exact core hπ' (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0)
    (Matrix.of fun i j : Fin (r + 2) =>
      if i.val = 0 ∧ j.val = 1 then (1 : IsLocalRing.ResidueField A') else 0)
    (fun p q => by simp only [Matrix.of_apply]; split_ifs <;> simp)
    ⟨0, by omega⟩ ⟨1, by omega⟩ hA hB hC
    (bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA)))
    (IsLocalRing.closedPoint B₀)
    (fun b => ∀ p : Fin n, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
      PrimeSpectrum.asIdeal (a₀ b))
    (fun b => ⟨hO.2 b, fun h => h ▸ hO.1⟩) hps' i₁ iY h₁ hY R cR hcR U g y hy hg hgf hadapt

theorem wc_smooth_divisor_compl_wcontr_et_vanish (k : Type u) [Field k]
    {Y Z : Scheme.{u}} (pY : Y ⟶ Spec (.of k)) (d : ℕ) [SmoothOfRelativeDimension (d + 1) pY]
    (i : Z ⟶ Y) [IsClosedImmersion i] [SmoothOfRelativeDimension d (i ≫ pY)]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : k) ≠ 0)
    (O : Y.Opens) (hO : (O : Set Y) = (Set.range i)ᶜ) (V : Y.ProEt)
    (hV : IsAffine V.left ∧ IsClosed {x : V.left | IsClosed ({x} : Set V.left)} ∧
      (∀ x : V.left, ∃! y : V.left, IsClosed ({y} : Set V.left) ∧ x ⤳ y) ∧
      ExtremallyDisconnected {x : V.left | IsClosed ({x} : Set V.left)} ∧
      (∀ x : V.left, IsClosed ({x} : Set V.left) →
        HenselianLocalRing (V.left.presheaf.stalk x) ∧ IsSepClosed (V.left.residueField x)))
    (t : V.left ⟶ Spec (.of (SeparableClosure k)))
    (ht : t ≫ Spec.map (CommRingCat.ofHom (algebraMap k (SeparableClosure k))) = V.hom ≫ pY)
    (j : ℕ) :
    Subsingleton (wcEtCoh (wcOpenRestr Y O V).left ℓ (j + 2)) :=
by
  classical
  obtain ⟨h1, h2, h3, h4, h5⟩ := hV
  haveI := h1
  haveI hVw : WeaklyEtale V.hom := V.prop

  have L2r : ∀ (A B : Type u) [CommRing A] [CommRing B] (φ : A →+* B), φ.IsIntegral →
      Function.Injective (PrimeSpectrum.comap φ) → ∀ (Q : Ideal B) [Q.IsPrime],
      (Localization.localRingHom (Ideal.comap φ Q) Q φ rfl).IsIntegral := by
    intro A B _ _ φ hφ hinj Q _
    have hK : ∀ s ∉ Q, ∃ a, a ∉ Ideal.comap φ Q ∧ ∃ c, φ a = s * c := by
      intro s hs
      by_contra hne
      push_neg at hne
      letI := φ.toAlgebra
      haveI : Algebra.IsIntegral A B := ⟨hφ⟩
      have hdisj : Disjoint (Ideal.span {s} : Set B)
          (Submonoid.map φ (Ideal.comap φ Q).primeCompl : Set B) := by
        rw [Set.disjoint_left]
        rintro y hy ⟨a, ha, rfl⟩
        obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp hy
        exact hne a ha c (by rw [← hc, mul_comm])
      obtain ⟨Q', hQ'p, hsQ', hQ'd⟩ := Ideal.exists_le_prime_disjoint _ _ hdisj
      have hle : Ideal.under A Q' ≤ Ideal.comap φ Q := by
        intro a ha
        by_contra haP
        exact Set.disjoint_left.mp hQ'd (show φ a ∈ (Q' : Set B) from ha) ⟨a, haP, rfl⟩
      obtain ⟨Q'', hQ''ge, hQ''p, hQ''u⟩ :=
        Ideal.exists_ideal_over_prime_of_isIntegral (Ideal.comap φ Q) Q' hle
      have heq : Q'' = Q := by
        have h0 := @hinj ⟨Q'', hQ''p⟩ ⟨Q, inferInstance⟩ (PrimeSpectrum.ext hQ''u)
        exact congrArg PrimeSpectrum.asIdeal h0
      exact hs (heq ▸ hQ''ge (hsQ' (Ideal.mem_span_singleton_self s)))
    have hMQ : ∀ x ∈ Submonoid.map φ (Ideal.comap φ Q).primeCompl,
        x ∈ Submonoid.comap (RingHom.id B) Q.primeCompl := by
      rintro _ ⟨a, ha, rfl⟩
      exact ha
    let g : Localization (Submonoid.map φ (Ideal.comap φ Q).primeCompl) →+*
        Localization.AtPrime Q :=
      IsLocalization.map (Localization.AtPrime Q) (RingHom.id B) hMQ
    have hg : Function.Surjective g := by
      intro z
      obtain ⟨⟨b, s⟩, rfl⟩ := IsLocalization.mk'_surjective Q.primeCompl z
      obtain ⟨a, ha, c, hc⟩ := hK s s.2
      refine ⟨IsLocalization.mk' (Localization (Submonoid.map φ (Ideal.comap φ Q).primeCompl))
        (b * c) (⟨φ a, Submonoid.mem_map.mpr ⟨a, (ha : a ∈ (Ideal.comap φ Q).primeCompl), rfl⟩⟩ :
          Submonoid.map φ (Ideal.comap φ Q).primeCompl), ?_⟩
      simp only [g]
      rw [IsLocalization.map_mk', IsLocalization.mk'_eq_iff_eq]
      congr 1
      simp only [RingHom.id_apply, hc]
      ring
    have h1' := isIntegral_localization' hφ (Ideal.comap φ Q).primeCompl
    have heq : Localization.localRingHom (Ideal.comap φ Q) Q φ rfl =
        g.comp (IsLocalization.map (M := (Ideal.comap φ Q).primeCompl)
          (S := Localization.AtPrime (Ideal.comap φ Q))
          (Localization (Submonoid.map φ (Ideal.comap φ Q).primeCompl))
          φ (Submonoid.le_comap_map _)) := by
      apply IsLocalization.ringHom_ext (Ideal.comap φ Q).primeCompl
      ext x
      simp only [RingHom.comp_apply, Localization.localRingHom_to_map, IsLocalization.map_eq, g,
        RingHom.id_apply]
    rw [heq]
    exact RingHom.IsIntegral.trans _ _ h1' (RingHom.isIntegral_of_surjective _ hg)

  have L2 : ∀ {X W : Scheme.{u}} [IsAffine X] [IsAffine W] (f : X ⟶ W) [IsIntegralHom f],
      Function.Injective f → ∀ x : X, (f.stalkMap x).hom.IsIntegral := by
    intro X W _ _ f _ hfinj x
    have hφ : (f.appTop).hom.IsIntegral :=
      ((isIntegralHom_iff f).1 inferInstance).2 ⊤ (isAffineOpen_top W)
    have hsq : ∀ y : X, (Spec.map f.appTop) (X.isoSpec.hom y) = W.isoSpec.hom (f y) := by
      intro y
      rw [← Scheme.Hom.comp_apply, Scheme.isoSpec_hom_naturality, Scheme.Hom.comp_apply]
    have hcomap : Function.Injective (PrimeSpectrum.comap f.appTop.hom) := by
      have h1 : Function.Injective (⇑(Spec.map f.appTop) ∘ ⇑X.isoSpec.hom) := by
        intro a b hab
        simp only [Function.comp_apply, hsq] at hab
        exact hfinj ((Scheme.homeoOfIso W.isoSpec).injective hab)
      exact Function.Injective.of_comp_right h1 (Scheme.homeoOfIso X.isoSpec).surjective
    have e := Scheme.Hom.stalkMap_congr_hom (f ≫ W.isoSpec.hom) (X.isoSpec.hom ≫ Spec.map f.appTop)
      (Scheme.isoSpec_hom_naturality f).symm x
    rw [Scheme.Hom.stalkMap_comp, Scheme.Hom.stalkMap_comp] at e
    have e' := congrArg CommRingCat.Hom.hom e
    simp only [CommRingCat.hom_comp] at e'
    have hiso : ∀ {A B : CommRingCat.{u}} (g : A ⟶ B) [IsIso g], g.hom.IsIntegral :=
      fun g _ => RingHom.isIntegral_of_surjective _ (ConcreteCategory.bijective_of_isIso g).2
    haveI := (X.isoSpec.hom x).isPrime
    have hS : ((Spec.map f.appTop).stalkMap (X.isoSpec.hom x)).hom.IsIntegral :=
      (RingHom.isIntegral_respectsIso.arrow_mk_iso_iff
        (Scheme.arrowStalkMapSpecIso f.appTop (X.isoSpec.hom x))).mpr
        (L2r _ _ f.appTop.hom hφ hcomap (X.isoSpec.hom x).asIdeal)
    apply RingHom.IsIntegral.tower_top ((W.isoSpec.hom).stalkMap (f x)).hom
    rw [e']
    exact RingHom.IsIntegral.trans _ _ (hiso _) (RingHom.IsIntegral.trans _ _ hS (hiso _))

  have L4 : ∀ {Yb Vl S S' : Scheme.{u}} (π : Yb ⟶ Y) (h : Vl ⟶ Y) (t' : Vl ⟶ S) (s' : S' ⟶ S)
      (g : Limits.pullback t' s' ⟶ Yb), g ≫ π = Limits.pullback.fst t' s' ≫ h →
      Nonempty (Limits.pullback g (π ⁻¹ᵁ O).ι ≅
        Limits.pullback (Limits.pullback.snd O.ι h ≫ t') s') := by
    intro Yb Vl S S' π h t' s' g hg
    have hrange : Set.range (Limits.pullback.fst g (π ⁻¹ᵁ O).ι) =
        Set.range (Limits.pullback.snd (Limits.pullback.snd O.ι h) (Limits.pullback.fst t' s')) := by
      rw [Scheme.Pullback.range_fst, Scheme.Pullback.range_snd, Scheme.Pullback.range_snd,
        Scheme.Opens.range_ι, Scheme.Opens.range_ι]
      ext z
      show π (g z) ∈ O ↔ h (Limits.pullback.fst t' s' z) ∈ O
      rw [← Scheme.Hom.comp_apply, hg, Scheme.Hom.comp_apply]
    exact ⟨IsOpenImmersion.isoOfRangeEq _ _ hrange ≪≫
      Limits.pullbackRightPullbackFstIso t' s' (Limits.pullback.snd O.ι h)⟩

  have hint : (algebraMap (SeparableClosure k) (AlgebraicClosure k)).IsIntegral :=
    fun x => Algebra.IsIntegral.isIntegral x
  haveI : IsPurelyInseparable (SeparableClosure k) (AlgebraicClosure k) :=
    Algebra.IsAlgebraic.isPurelyInseparable_of_isSepClosed
  haveI hsint : IsIntegralHom (Spec.map (CommRingCat.ofHom
      (algebraMap (SeparableClosure k) (AlgebraicClosure k)))) :=
    IsIntegralHom.SpecMap_iff.mpr hint
  have hsinj : UniversallyInjective (Spec.map (CommRingCat.ofHom
      (algebraMap (SeparableClosure k) (AlgebraicClosure k)))) := by
    rw [universallyInjective_eq_diagonal]
    change Surjective (Limits.pullback.diagonal (Spec.map (CommRingCat.ofHom
      (algebraMap (SeparableClosure k) (AlgebraicClosure k)))))
    have h1 : Subsingleton (PrimeSpectrum (TensorProduct (SeparableClosure k) (AlgebraicClosure k)
        (AlgebraicClosure k))) :=
      (PrimeSpectrum.isHomeomorph_comap_of_isPurelyInseparable (SeparableClosure k)
        (AlgebraicClosure k) (AlgebraicClosure k)).injective.subsingleton
    haveI : Subsingleton ↥(Spec (CommRingCat.of (TensorProduct (SeparableClosure k)
        (AlgebraicClosure k) (AlgebraicClosure k)))) := h1
    haveI : Subsingleton ↥(Limits.pullback (Spec.map (CommRingCat.ofHom
        (algebraMap (SeparableClosure k) (AlgebraicClosure k))))
        (Spec.map (CommRingCat.ofHom (algebraMap (SeparableClosure k) (AlgebraicClosure k))))) :=
      (Scheme.homeoOfIso (pullbackSpecIso (SeparableClosure k) (AlgebraicClosure k)
        (AlgebraicClosure k))).injective.subsingleton
    obtain ⟨x⟩ : Nonempty (PrimeSpectrum (AlgebraicClosure k)) := inferInstance
    exact ⟨fun z => ⟨x, Subsingleton.elim _ _⟩⟩

  have sbk : Spec.map (CommRingCat.ofHom (algebraMap (SeparableClosure k) (AlgebraicClosure k))) ≫
      Spec.map (CommRingCat.ofHom (algebraMap k (SeparableClosure k))) =
      Spec.map (CommRingCat.ofHom (algebraMap k (AlgebraicClosure k))) := by
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, ← IsScalarTower.algebraMap_eq]

  have hw : (Limits.pullback.fst t (Spec.map (CommRingCat.ofHom
        (algebraMap (SeparableClosure k) (AlgebraicClosure k)))) ≫ V.hom) ≫ pY =
      Limits.pullback.snd t (Spec.map (CommRingCat.ofHom
        (algebraMap (SeparableClosure k) (AlgebraicClosure k)))) ≫
        Spec.map (CommRingCat.ofHom (algebraMap k (AlgebraicClosure k))) := by
    simp only [Category.assoc]
    rw [← ht, Limits.pullback.condition_assoc, sbk]
  obtain ⟨g, hg1, hg2⟩ : ∃ g : Limits.pullback t (Spec.map (CommRingCat.ofHom
        (algebraMap (SeparableClosure k) (AlgebraicClosure k)))) ⟶
      Limits.pullback pY (Spec.map (CommRingCat.ofHom (algebraMap k (AlgebraicClosure k)))),
      g ≫ Limits.pullback.fst pY (Spec.map (CommRingCat.ofHom (algebraMap k (AlgebraicClosure k)))) =
        Limits.pullback.fst t (Spec.map (CommRingCat.ofHom
          (algebraMap (SeparableClosure k) (AlgebraicClosure k)))) ≫ V.hom ∧
      g ≫ Limits.pullback.snd pY (Spec.map (CommRingCat.ofHom (algebraMap k (AlgebraicClosure k)))) =
        Limits.pullback.snd t (Spec.map (CommRingCat.ofHom
          (algebraMap (SeparableClosure k) (AlgebraicClosure k)))) :=
    ⟨Limits.pullback.lift _ _ hw, Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩

  haveI hgw : WeaklyEtale g := by
    have hb : WeaklyEtale (Limits.pullback.snd
        (Spec.map (CommRingCat.ofHom (algebraMap k (SeparableClosure k))))
        (Spec.map (CommRingCat.ofHom (algebraMap k (AlgebraicClosure k))))) :=
      MorphismProperty.of_isPullback (P := @WeaklyEtale) (IsPullback.of_hasPullback _ _)
        (wc_fpe_sepClosure_weaklyEtale k)
    obtain ⟨μ, hμ1, hμ2⟩ : ∃ μ : Spec (.of (AlgebraicClosure k)) ⟶ Limits.pullback
        (Spec.map (CommRingCat.ofHom (algebraMap k (SeparableClosure k))))
        (Spec.map (CommRingCat.ofHom (algebraMap k (AlgebraicClosure k)))),
        μ ≫ Limits.pullback.fst _ _ =
          Spec.map (CommRingCat.ofHom (algebraMap (SeparableClosure k) (AlgebraicClosure k))) ∧
        μ ≫ Limits.pullback.snd _ _ = 𝟙 _ :=
      ⟨Limits.pullback.lift _ (𝟙 _) (by rw [Category.id_comp, sbk]),
        Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
    haveI : WeaklyEtale (μ ≫ Limits.pullback.snd
        (Spec.map (CommRingCat.ofHom (algebraMap k (SeparableClosure k))))
        (Spec.map (CommRingCat.ofHom (algebraMap k (AlgebraicClosure k))))) := by
      rw [hμ2]; infer_instance
    haveI hμ : WeaklyEtale μ := WeaklyEtale.of_comp μ (Limits.pullback.snd _ _)
    obtain ⟨θ, hθ1, hθ2⟩ : ∃ θ : Limits.pullback t (Spec.map (CommRingCat.ofHom
          (algebraMap (SeparableClosure k) (AlgebraicClosure k)))) ⟶
        Limits.pullback t (Limits.pullback.fst
          (Spec.map (CommRingCat.ofHom (algebraMap k (SeparableClosure k))))
          (Spec.map (CommRingCat.ofHom (algebraMap k (AlgebraicClosure k))))),
        θ ≫ Limits.pullback.fst _ _ = Limits.pullback.fst _ _ ∧
        θ ≫ Limits.pullback.snd _ _ = Limits.pullback.snd _ _ ≫ μ :=
      ⟨Limits.pullback.lift _ _ (by rw [Category.assoc, hμ1]; exact Limits.pullback.condition),
        Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
    have hout : IsPullback (θ ≫ Limits.pullback.fst _ _)
        (Limits.pullback.snd t (Spec.map (CommRingCat.ofHom
          (algebraMap (SeparableClosure k) (AlgebraicClosure k))))) t
        (μ ≫ Limits.pullback.fst _ _) := by
      rw [hθ1, hμ1]; exact IsPullback.of_hasPullback _ _
    have hθP := IsPullback.of_right hout hθ2 (IsPullback.of_hasPullback _ _)
    haveI hθw : WeaklyEtale θ := MorphismProperty.of_isPullback (P := @WeaklyEtale) hθP.flip hμ
    have hσc : (Limits.pullback.fst t (Limits.pullback.fst
          (Spec.map (CommRingCat.ofHom (algebraMap k (SeparableClosure k))))
          (Spec.map (CommRingCat.ofHom (algebraMap k (AlgebraicClosure k))))) ≫ V.hom) ≫ pY =
        (Limits.pullback.snd t (Limits.pullback.fst
          (Spec.map (CommRingCat.ofHom (algebraMap k (SeparableClosure k))))
          (Spec.map (CommRingCat.ofHom (algebraMap k (AlgebraicClosure k))))) ≫
          Limits.pullback.snd _ _) ≫
          Spec.map (CommRingCat.ofHom (algebraMap k (AlgebraicClosure k))) := by
      simp only [Category.assoc]
      rw [← ht, Limits.pullback.condition_assoc, Limits.pullback.condition]
    obtain ⟨σ, hσ1, hσ2⟩ : ∃ σ : Limits.pullback t (Limits.pullback.fst
          (Spec.map (CommRingCat.ofHom (algebraMap k (SeparableClosure k))))
          (Spec.map (CommRingCat.ofHom (algebraMap k (AlgebraicClosure k))))) ⟶
        Limits.pullback pY (Spec.map (CommRingCat.ofHom (algebraMap k (AlgebraicClosure k)))),
        σ ≫ Limits.pullback.fst _ _ = Limits.pullback.fst _ _ ≫ V.hom ∧
        σ ≫ Limits.pullback.snd _ _ = Limits.pullback.snd _ _ ≫ Limits.pullback.snd _ _ :=
      ⟨Limits.pullback.lift _ _ hσc, Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
    have hout2 : IsPullback (σ ≫ Limits.pullback.snd _ _)
        (Limits.pullback.fst t (Limits.pullback.fst
          (Spec.map (CommRingCat.ofHom (algebraMap k (SeparableClosure k))))
          (Spec.map (CommRingCat.ofHom (algebraMap k (AlgebraicClosure k))))))
        (Spec.map (CommRingCat.ofHom (algebraMap k (AlgebraicClosure k)))) (V.hom ≫ pY) := by
      rw [hσ2, ← ht]
      exact (IsPullback.of_hasPullback _ _).flip.paste_horiz (IsPullback.of_hasPullback _ _).flip
    have hσP := IsPullback.of_right hout2 hσ1 (IsPullback.of_hasPullback _ _).flip
    haveI hσw : WeaklyEtale σ := MorphismProperty.of_isPullback (P := @WeaklyEtale) hσP.flip hVw
    have hgθσ : g = θ ≫ σ := by
      apply Limits.pullback.hom_ext
      · rw [hg1, Category.assoc, hσ1, ← Category.assoc, hθ1]
      · rw [hg2, Category.assoc, hσ2, ← Category.assoc, hθ2, Category.assoc, hμ2, Category.comp_id]
    rw [hgθσ]; infer_instance

  haveI : UniversallyInjective (Limits.pullback.fst t (Spec.map (CommRingCat.ofHom
      (algebraMap (SeparableClosure k) (AlgebraicClosure k))))) :=
    MorphismProperty.of_isPullback (P := @UniversallyInjective)
      (IsPullback.of_hasPullback _ _).flip hsinj
  have hq : IsHomeomorph (Limits.pullback.fst t (Spec.map (CommRingCat.ofHom
      (algebraMap (SeparableClosure k) (AlgebraicClosure k))))) := by
    rw [isHomeomorph_iff_continuous_isClosedMap_bijective]
    exact ⟨Scheme.Hom.continuous _, Scheme.Hom.isClosedMap _,
      Scheme.Hom.injective _, Scheme.Hom.surjective _⟩
  haveI hDaff : IsAffine (Limits.pullback t (Spec.map (CommRingCat.ofHom
      (algebraMap (SeparableClosure k) (AlgebraicClosure k))))) := inferInstance
  have hst := L2 (Limits.pullback.fst t (Spec.map (CommRingCat.ofHom
      (algebraMap (SeparableClosure k) (AlgebraicClosure k))))) hq.injective
  obtain ⟨c2, c3, c4⟩ := wc_wl_conditions_homeomorph _ _ (IsHomeomorph.homeomorph _ hq).symm h2 h3 h4
  have c5 : ∀ x : ↥(Limits.pullback t (Spec.map (CommRingCat.ofHom
        (algebraMap (SeparableClosure k) (AlgebraicClosure k)))) : Scheme.{u}),
      IsClosed ({x} : Set ↥(Limits.pullback t (Spec.map (CommRingCat.ofHom
        (algebraMap (SeparableClosure k) (AlgebraicClosure k)))) : Scheme.{u})) →
      HenselianLocalRing ((Limits.pullback t (Spec.map (CommRingCat.ofHom
        (algebraMap (SeparableClosure k) (AlgebraicClosure k))))).presheaf.stalk x) ∧
        IsSepClosed ((Limits.pullback t (Spec.map (CommRingCat.ofHom
          (algebraMap (SeparableClosure k) (AlgebraicClosure k))))).residueField x) := by
    intro x hx
    have hfx := hq.isClosedMap _ hx
    rw [Set.image_singleton] at hfx
    obtain ⟨hh, hs⟩ := h5 _ hfx
    haveI := hh
    haveI : IsSepClosed (IsLocalRing.ResidueField (V.left.presheaf.stalk
        (Limits.pullback.fst t (Spec.map (CommRingCat.ofHom
          (algebraMap (SeparableClosure k) (AlgebraicClosure k)))) x))) := hs
    letI := ((Limits.pullback.fst t (Spec.map (CommRingCat.ofHom
          (algebraMap (SeparableClosure k) (AlgebraicClosure k))))).stalkMap x).hom.toAlgebra
    have hI : Algebra.IsIntegral (V.left.presheaf.stalk
        (Limits.pullback.fst t (Spec.map (CommRingCat.ofHom
          (algebraMap (SeparableClosure k) (AlgebraicClosure k)))) x))
        ((Limits.pullback t (Spec.map (CommRingCat.ofHom
          (algebraMap (SeparableClosure k) (AlgebraicClosure k))))).presheaf.stalk x) := ⟨hst x⟩
    exact wc_integral_over_strictly_henselian _ _ hI

  haveI : SmoothOfRelativeDimension (d + 1) (Limits.pullback.snd pY
      (Spec.map (CommRingCat.ofHom (algebraMap k (AlgebraicClosure k))))) :=
    MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension (d + 1))
      (IsPullback.of_hasPullback _ _) ‹_›
  haveI : SmoothOfRelativeDimension d (Limits.pullback.snd i (Limits.pullback.fst pY
      (Spec.map (CommRingCat.ofHom (algebraMap k (AlgebraicClosure k))))) ≫
      Limits.pullback.snd pY (Spec.map (CommRingCat.ofHom (algebraMap k (AlgebraicClosure k))))) :=
    MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension d)
      ((IsPullback.of_hasPullback _ _).paste_vert (IsPullback.of_hasPullback _ _)) ‹_›
  haveI : Smooth (Limits.pullback.snd pY
      (Spec.map (CommRingCat.ofHom (algebraMap k (AlgebraicClosure k))))) :=
    SmoothOfRelativeDimension.smooth (d + 1) _
  haveI : IsLocallyNoetherian (Limits.pullback pY
      (Spec.map (CommRingCat.ofHom (algebraMap k (AlgebraicClosure k))))) :=
    LocallyOfFiniteType.isLocallyNoetherian (Limits.pullback.snd pY
      (Spec.map (CommRingCat.ofHom (algebraMap k (AlgebraicClosure k)))))
  have hℓb : (ℓ : AlgebraicClosure k) ≠ 0 := by
    rw [← map_natCast (algebraMap k (AlgebraicClosure k)) ℓ]; exact (map_ne_zero _).2 hℓ
  have hOb : ((Limits.pullback.fst pY (Spec.map (CommRingCat.ofHom
        (algebraMap k (AlgebraicClosure k)))) ⁻¹ᵁ O : Scheme.Opens _) : Set _) =
      (Set.range (Limits.pullback.snd i (Limits.pullback.fst pY
        (Spec.map (CommRingCat.ofHom (algebraMap k (AlgebraicClosure k)))))))ᶜ := by
    rw [Scheme.Pullback.range_snd]
    ext z
    show Limits.pullback.fst pY (Spec.map (CommRingCat.ofHom
        (algebraMap k (AlgebraicClosure k)))) z ∈ (O : Set Y) ↔ _
    rw [hO]; rfl

  have H1 := wc_smooth_pair_compl_wstrictly_local_et_vanish (AlgebraicClosure k)
    (Limits.pullback.snd pY (Spec.map (CommRingCat.ofHom (algebraMap k (AlgebraicClosure k)))))
    (d + 1) d (Limits.pullback.snd i (Limits.pullback.fst pY
      (Spec.map (CommRingCat.ofHom (algebraMap k (AlgebraicClosure k)))))) ℓ hℓb _ hOb
    (Scheme.ProEt.mk g) ⟨hDaff, c2, c3, c4, c5⟩ (j + 2) (by omega) (by omega)
  have H2 : Subsingleton (wcEtCoh (Limits.pullback g (Limits.pullback.fst pY
      (Spec.map (CommRingCat.ofHom (algebraMap k (AlgebraicClosure k)))) ⁻¹ᵁ O).ι) ℓ (j + 2)) := by
    first
      | exact H1
      | (have hYeq : ((wcProEtBC (Limits.pullback.fst pY (Spec.map (CommRingCat.ofHom
              (algebraMap k (AlgebraicClosure k)))) ⁻¹ᵁ O).ι).obj (Scheme.ProEt.mk g)).left =
            Limits.pullback g (Limits.pullback.fst pY (Spec.map (CommRingCat.ofHom
              (algebraMap k (AlgebraicClosure k)))) ⁻¹ᵁ O).ι := by
           unfold wcProEtBC; erw [MorphismProperty.Over.pullback_obj_left]; rfl
         rw [← hYeq]; exact H1)

  obtain ⟨e⟩ := L4 _ V.hom t _ g hg1
  obtain ⟨E1⟩ := wc_et_coh_iso_invariance e.hom ℓ (j + 2)
  haveI := H2
  haveI : Subsingleton (wcEtCoh (Limits.pullback (Limits.pullback.snd O.ι V.hom ≫ t)
      (Spec.map (CommRingCat.ofHom (algebraMap (SeparableClosure k) (AlgebraicClosure k)))))
      ℓ (j + 2)) := E1.subsingleton
  obtain ⟨E2⟩ := wc_et_coh_purely_inseparable_invariance (SeparableClosure k) (AlgebraicClosure k)
    hint (Limits.pullback O.ι V.hom) (Limits.pullback.snd O.ι V.hom ≫ t) ℓ (j + 2)
  exact E2.symm.subsingleton

theorem wc_nc_strict_punct_et_vanish (κ : Type u) [Field κ] [IsSepClosed κ] (ℓ : ℕ)
    [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : κ) ≠ 0) (r : ℕ)
    (R : CommRingCat.{u}) [HenselianLocalRing R] [IsSepClosed (IsLocalRing.ResidueField R)]
    (cs : Spec R ⟶ Spec (.of (wcQuadModelRing κ (r + 2) 0
      (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : κ) else 0))))
    (hcs : WeaklyEtale cs) {Q P : Scheme.{u}} (o : Q ⟶ Spec R) [IsOpenImmersion o]
    (z : P ⟶ Q) [IsClosedImmersion z]
    (hrange : Set.range (z ≫ o) = {p | Ideal.Quotient.mk (wcQuadModelIdeal κ (r + 2) 0
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : κ) else 0))
        (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))) ∈ PrimeSpectrum.asIdeal (cs p) ∧
      Ideal.Quotient.mk (wcQuadModelIdeal κ (r + 2) 0
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : κ) else 0))
        (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2))) ∉ PrimeSpectrum.asIdeal (cs p)})
    (k : ℕ) (hk : 2 ≤ k) : Subsingleton (wcEtCoh P ℓ k) :=
by
  classical
  have hEmpty : ∀ (Y : Scheme.{u}), IsEmpty Y → ∀ m q, Subsingleton (wcEtCoh Y m q) := by
    intro Z hE m q
    obtain ⟨E⟩ := wc_et_zmodext_coh_equiv Z m q
    haveI : Subsingleton (wcEtZModExt Z m q) := by
      letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Z m)) := HasExt.standard _
      have hU := wc_et_zmod_modules_zero_of_isEmpty Z m hE
        (SheafOfModules.unit (wcEtZModRing Z m))
      have h0 : ∀ x : Abelian.Ext (SheafOfModules.unit (wcEtZModRing Z m))
          (SheafOfModules.unit (wcEtZModRing Z m)) q, x = 0 := by
        intro x
        rw [← Abelian.Ext.mk₀_id_comp x, hU.eq_of_src (𝟙 _) 0, Abelian.Ext.mk₀_zero,
          Abelian.Ext.zero_comp]
      exact ⟨fun a b => (h0 a).trans (h0 b).symm⟩
    exact E.symm.subsingleton
  have hNE : ∀ (Y : Scheme.{u}) m q, Nonempty (wcEtCoh Y m q) := by
    intro Z m q
    obtain ⟨E⟩ := wc_et_zmodext_coh_equiv Z m q
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Z m)) := HasExt.standard _
    exact ⟨E (0 : Abelian.Ext (SheafOfModules.unit (wcEtZModRing Z m))
      (SheafOfModules.unit (wcEtZModRing Z m)) q)⟩
  have HQ := wc_quot_strictly_henselian_of_ne_top.{u}

  have LK : ∀ (K : Type u) [CommRing K] (n : ℕ),
      Function.Surjective (MvPolynomial.aeval (R := K)
        (Fin.cons (0 : MvPolynomial (Fin n) K) MvPolynomial.X : Fin (n + 1) → MvPolynomial (Fin n) K)) ∧
      RingHom.ker (MvPolynomial.aeval (R := K)
        (Fin.cons (0 : MvPolynomial (Fin n) K) MvPolynomial.X : Fin (n + 1) → MvPolynomial (Fin n) K)) =
        Ideal.span {MvPolynomial.X 0} := by
    intro K _ n
    set θ := (MvPolynomial.aeval (R := K)
        (Fin.cons (0 : MvPolynomial (Fin n) K) MvPolynomial.X : Fin (n + 1) → MvPolynomial (Fin n) K))
      with hθ
    set σ : MvPolynomial (Fin n) K →ₐ[K] MvPolynomial (Fin (n + 1)) K := MvPolynomial.rename Fin.succ
    have hθσ : ∀ g, θ (σ g) = g := by
      intro g
      rw [hθ, MvPolynomial.aeval_rename]
      have : ((Fin.cons (0 : MvPolynomial (Fin n) K) MvPolynomial.X :
          Fin (n + 1) → MvPolynomial (Fin n) K) ∘ Fin.succ) = MvPolynomial.X := by
        funext i; simp
      rw [this, MvPolynomial.aeval_X_left]; rfl
    have h0 : θ (MvPolynomial.X 0) = 0 := by rw [hθ, MvPolynomial.aeval_X]; rfl
    have hiii : ∀ f, f - σ (θ f) ∈
        Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin (n + 1)) K)} := by
      intro f
      induction f using MvPolynomial.induction_on with
      | C a => simp [σ, θ]
      | add p q hp hq =>
        have : p + q - σ (θ (p + q)) = (p - σ (θ p)) + (q - σ (θ q)) := by
          simp only [map_add]; ring
        rw [this]; exact Ideal.add_mem _ hp hq
      | mul_X p i hp =>
        refine Fin.cases ?_ (fun j => ?_) i
        · have : p * MvPolynomial.X 0 - σ (θ (p * MvPolynomial.X 0)) = p * MvPolynomial.X 0 := by
            rw [map_mul, h0, mul_zero, map_zero, sub_zero]
          rw [this]
          exact Ideal.mul_mem_left _ _ (Ideal.subset_span rfl)
        · have hX : σ (θ (MvPolynomial.X j.succ)) = MvPolynomial.X j.succ := by
            rw [hθ, MvPolynomial.aeval_X]
            simp [σ]
          have : p * MvPolynomial.X j.succ - σ (θ (p * MvPolynomial.X j.succ)) =
              (p - σ (θ p)) * MvPolynomial.X j.succ := by
            rw [map_mul, map_mul, hX]; ring
          rw [this]
          exact Ideal.mul_mem_right _ _ hp
    refine ⟨fun g => ⟨σ g, hθσ g⟩, ?_⟩
    apply le_antisymm
    · intro f hf
      rw [RingHom.mem_ker] at hf
      have := hiii f
      rw [show θ f = 0 from hf, map_zero, sub_zero] at this
      exact this
    · rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker]
      exact h0

  have L1 : ∀ (R : CommRingCat.{u}) [HenselianLocalRing R]
      [IsSepClosed (IsLocalRing.ResidueField R)],
      IsAffine (Spec R) ∧ IsClosed {x : Spec R | IsClosed ({x} : Set (Spec R))} ∧
        (∀ x : Spec R, ∃! y : Spec R, IsClosed ({y} : Set (Spec R)) ∧ x ⤳ y) ∧
        ExtremallyDisconnected {x : Spec R | IsClosed ({x} : Set (Spec R))} ∧
        (∀ x : Spec R, IsClosed ({x} : Set (Spec R)) →
          HenselianLocalRing ((Spec R).presheaf.stalk x) ∧
            IsSepClosed ((Spec R).residueField x)) := by
    intro R _ _
    have T := wc_hte_sepClosed_henselian_transport.{u}
    have key0 : ∀ x : PrimeSpectrum R, IsClosed ({x} : Set (PrimeSpectrum R)) ↔
        x = IsLocalRing.closedPoint R := by
      intro x
      rw [PrimeSpectrum.isClosed_singleton_iff_isMaximal]
      constructor
      · intro h
        exact PrimeSpectrum.ext (IsLocalRing.eq_maximalIdeal h)
      · rintro rfl
        exact IsLocalRing.maximalIdeal.isMaximal R
    have key : ∀ x : Spec R, IsClosed ({x} : Set (Spec R)) ↔ x = IsLocalRing.closedPoint R :=
      fun x => key0 x
    have hset : {x : Spec R | IsClosed ({x} : Set (Spec R))} = {IsLocalRing.closedPoint R} := by
      ext x; exact key x
    refine ⟨inferInstance, ?_, ?_, ?_, ?_⟩
    · rw [hset]; exact IsLocalRing.isClosed_singleton_closedPoint R
    · intro x
      refine ⟨IsLocalRing.closedPoint R,
        ⟨(key _).2 rfl, IsLocalRing.specializes_closedPoint x⟩, ?_⟩
      rintro y ⟨hy, -⟩
      exact (key y).1 hy
    · have : Subsingleton {x : Spec R | IsClosed ({x} : Set (Spec R))} := by
        constructor
        rintro ⟨a, ha⟩ ⟨b, hb⟩
        apply Subtype.ext
        exact ((key a).1 ha).trans ((key b).1 hb).symm
      constructor
      intro U _
      exact Subsingleton.set_cases (p := fun s => IsOpen s) isOpen_empty isOpen_univ (closure U)
    · intro x hx
      have hx' := (key x).1 hx
      let e : (R : Type u) ≃+* (Spec R).presheaf.stalk x :=
        ((Spec R).presheaf.stalkCongr (Inseparable.of_eq hx') ≪≫
          stalkClosedPointIso R).symm.commRingCatIsoToRingEquiv
      refine ⟨T.2 _ _ e inferInstance, ?_⟩
      exact T.1 _ _ (IsLocalRing.ResidueField.mapEquiv e) inferInstance

  have LA : ∀ (R₀ : CommRingCat.{u}) [HenselianLocalRing R₀]
      [IsSepClosed (IsLocalRing.ResidueField R₀)]
      (ψ : CommRingCat.of (MvPolynomial (Fin (r + 1)) κ) ⟶ R₀) (hψ : WeaklyEtale (Spec.map ψ))
      (j : ℕ),
      Subsingleton (wcEtCoh (Limits.pullback
        (Scheme.Opens.ι (X := Spec (CommRingCat.of (MvPolynomial (Fin (r + 1)) κ)))
          (PrimeSpectrum.basicOpen (MvPolynomial.X 0 : MvPolynomial (Fin (r + 1)) κ)))
        (Spec.map ψ)) ℓ (j + 2)) := by
    intro R₀ _ _ ψ hψ j
    let pY : Spec (CommRingCat.of (MvPolynomial (Fin (r + 1)) κ)) ⟶ Spec (CommRingCat.of κ) :=
      Spec.map (CommRingCat.ofHom (algebraMap κ (MvPolynomial (Fin (r + 1)) κ)))
    haveI : SmoothOfRelativeDimension (r + 1) pY := wc_mvpoly_spec_smoothOfRelDim κ (r + 1)
    let θ : MvPolynomial (Fin (r + 1)) κ →+* MvPolynomial (Fin r) κ :=
      (MvPolynomial.aeval (R := κ) (Fin.cons (0 : MvPolynomial (Fin r) κ) MvPolynomial.X :
        Fin (r + 1) → MvPolynomial (Fin r) κ)).toRingHom
    obtain ⟨hsurj, hker⟩ := LK κ r
    let i : Spec (CommRingCat.of (MvPolynomial (Fin r) κ)) ⟶
        Spec (CommRingCat.of (MvPolynomial (Fin (r + 1)) κ)) := Spec.map (CommRingCat.ofHom θ)
    haveI : IsClosedImmersion i := IsClosedImmersion.spec_of_surjective _ hsurj
    have hip : i ≫ pY = Spec.map (CommRingCat.ofHom (algebraMap κ (MvPolynomial (Fin r) κ))) := by
      rw [← Spec.map_comp]
      congr 1
      apply CommRingCat.hom_ext
      refine RingHom.ext fun x => ?_
      show θ (algebraMap κ _ x) = algebraMap κ _ x
      exact AlgHom.commutes _ x
    haveI : SmoothOfRelativeDimension r (i ≫ pY) := by
      rw [hip]; exact wc_mvpoly_spec_smoothOfRelDim κ r
    let O : (Spec (CommRingCat.of (MvPolynomial (Fin (r + 1)) κ))).Opens :=
      PrimeSpectrum.basicOpen (MvPolynomial.X 0 : MvPolynomial (Fin (r + 1)) κ)
    have hO : (O : Set (Spec (CommRingCat.of (MvPolynomial (Fin (r + 1)) κ)))) = (Set.range i)ᶜ := by
      have hr : Set.range i = Set.range (PrimeSpectrum.comap θ) := by
        ext x
        simp only [Set.mem_range]
        constructor
        · rintro ⟨y, hy⟩; exact ⟨y, (Spec.map_apply (CommRingCat.ofHom θ) y).symm.trans hy⟩
        · rintro ⟨y, hy⟩; exact ⟨y, (Spec.map_apply (CommRingCat.ofHom θ) y).trans hy⟩
      have hθker : RingHom.ker θ = Ideal.span {MvPolynomial.X 0} := hker
      rw [hr, range_comap_of_surjective _ θ hsurj, hθker, PrimeSpectrum.zeroLocus_span]
      ext x
      show (MvPolynomial.X 0 ∉ x.asIdeal) ↔
        ¬ ({MvPolynomial.X 0} ⊆ (x.asIdeal : Set (MvPolynomial (Fin (r + 1)) κ)))
      rw [Set.singleton_subset_iff]
      rfl
    let V : (Spec (CommRingCat.of (MvPolynomial (Fin (r + 1)) κ))).ProEt :=
      MorphismProperty.Over.mk ⊤ (Spec.map ψ) hψ
    have hV := L1 R₀
    let e : κ ≃+* SeparableClosure κ := RingEquiv.ofBijective (algebraMap κ (SeparableClosure κ))
      ⟨(algebraMap κ (SeparableClosure κ)).injective,
        IsSepClosed.algebraMap_surjective κ (SeparableClosure κ)⟩
    let t : V.left ⟶ Spec (.of (SeparableClosure κ)) :=
      V.hom ≫ pY ≫ Spec.map (CommRingCat.ofHom (e.symm : SeparableClosure κ →+* κ))
    have hid : Spec.map (CommRingCat.ofHom (e.symm : SeparableClosure κ →+* κ)) ≫
        Spec.map (CommRingCat.ofHom (algebraMap κ (SeparableClosure κ))) = 𝟙 _ := by
      rw [← Spec.map_comp, ← Spec.map_id]
      congr 1
      apply CommRingCat.hom_ext
      refine RingHom.ext fun x => ?_
      show e.symm (algebraMap κ (SeparableClosure κ) x) = x
      exact e.symm_apply_apply x
    have ht : t ≫ Spec.map (CommRingCat.ofHom (algebraMap κ (SeparableClosure κ))) = V.hom ≫ pY := by
      simp only [t, Category.assoc, hid, Category.comp_id]
    exact wc_smooth_divisor_compl_wcontr_et_vanish κ pY r i ℓ hℓ O hO V hV t ht j

  have hhalf : ∀ {W Y : Scheme.{u}} (f : W ⟶ Y) [IsClosedImmersion f], Set.range f = Set.univ →
      ∀ m q, Nat.card (wcEtCoh W m q) = Nat.card (wcEtCoh Y m q) := by
    intro W Y f _ hf m q
    have h1 := wc_et_fibre_coh_reduced_invariance Y Y Y W (𝟙 Y) f hf (𝟙 Y) m q
    haveI : IsIso (Limits.pullback.fst (f ≫ 𝟙 Y) (𝟙 Y)) :=
      Limits.pullback_fst_iso_of_right_iso _ _
    haveI : IsIso (Limits.pullback.fst (𝟙 Y) (𝟙 Y)) := Limits.pullback_fst_iso_of_right_iso _ _
    obtain ⟨e1⟩ := wc_et_coh_iso_invariance (Limits.pullback.fst (f ≫ 𝟙 Y) (𝟙 Y)) m q
    obtain ⟨e2⟩ := wc_et_coh_iso_invariance (Limits.pullback.fst (𝟙 Y) (𝟙 Y)) m q
    rw [Nat.card_congr e1, h1, ← Nat.card_congr e2]
  have L2 : ∀ {X P₁ P₂ : Scheme.{u}} (j₁ : P₁ ⟶ X) (j₂ : P₂ ⟶ X) [IsImmersion j₁]
      [IsImmersion j₂], Set.range j₁ = Set.range j₂ →
      ∀ m q, Nat.card (wcEtCoh P₁ m q) = Nat.card (wcEtCoh P₂ m q) := by
    intro X P₁ P₂ j₁ j₂ _ _ h m q
    haveI : IsImmersion (Limits.pullback.fst j₁ j₂) := inferInstance
    haveI : IsImmersion (Limits.pullback.snd j₁ j₂) := inferInstance
    haveI : IsPreimmersion (Limits.pullback.fst j₁ j₂) := inferInstance
    haveI : IsPreimmersion (Limits.pullback.snd j₁ j₂) := inferInstance
    have hf : Set.range (Limits.pullback.fst j₁ j₂) = Set.univ := by
      rw [Scheme.Pullback.range_fst, ← h, Set.preimage_range]
    have hs : Set.range (Limits.pullback.snd j₁ j₂) = Set.univ := by
      rw [Scheme.Pullback.range_snd, h, Set.preimage_range]
    haveI : IsClosedImmersion (Limits.pullback.fst j₁ j₂) :=
      IsClosedImmersion.of_isPreimmersion _ (by rw [hf]; exact isClosed_univ)
    haveI : IsClosedImmersion (Limits.pullback.snd j₁ j₂) :=
      IsClosedImmersion.of_isPreimmersion _ (by rw [hs]; exact isClosed_univ)
    rw [← hhalf (Limits.pullback.fst j₁ j₂) hf m q, hhalf (Limits.pullback.snd j₁ j₂) hs m q]

  have LR : ∀ (a b : ↑R)
      (ψ : CommRingCat.of (MvPolynomial (Fin (r + 1)) κ) ⟶ CommRingCat.of (↑R ⧸ Ideal.span {a}))
      (hψ : ψ.hom (MvPolynomial.X 0) = Ideal.Quotient.mk (Ideal.span {a}) b),
      Set.range (Limits.pullback.snd
          (Scheme.Opens.ι (X := Spec (CommRingCat.of (MvPolynomial (Fin (r + 1)) κ)))
            (PrimeSpectrum.basicOpen (MvPolynomial.X 0 : MvPolynomial (Fin (r + 1)) κ)))
          (Spec.map ψ) ≫ Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {a})))) =
        {p : Spec R | a ∈ PrimeSpectrum.asIdeal p ∧ b ∉ PrimeSpectrum.asIdeal p} := by
    intro a b ψ hψ
    have e := Scheme.Opens.range_ι (X := Spec (CommRingCat.of (MvPolynomial (Fin (r + 1)) κ)))
      (PrimeSpectrum.basicOpen (MvPolynomial.X 0 : MvPolynomial (Fin (r + 1)) κ))
    have hO : ∀ x : Spec (CommRingCat.of (↑R ⧸ Ideal.span {a})),
        Spec.map ψ x ∈ Set.range (Scheme.Opens.ι
          (X := Spec (CommRingCat.of (MvPolynomial (Fin (r + 1)) κ)))
            (PrimeSpectrum.basicOpen (MvPolynomial.X 0 : MvPolynomial (Fin (r + 1)) κ))) ↔
          Ideal.Quotient.mk (Ideal.span {a}) b ∉ x.asIdeal := by
      intro x
      rw [e, Spec.map_apply, ← hψ]
      rfl
    have hμ : ∀ (x : Spec (CommRingCat.of (↑R ⧸ Ideal.span {a}))) (y : R),
        y ∈ (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {a}))) x).asIdeal ↔
          Ideal.Quotient.mk (Ideal.span {a}) y ∈ x.asIdeal := by
      intro x y
      rw [Spec.map_apply]
      rfl
    ext p
    constructor
    · rintro ⟨w, rfl⟩
      rw [Scheme.Hom.comp_apply]
      have hw : Limits.pullback.snd _ (Spec.map ψ) w ∈
          Set.range (Limits.pullback.snd (Scheme.Opens.ι
            (X := Spec (CommRingCat.of (MvPolynomial (Fin (r + 1)) κ)))
            (PrimeSpectrum.basicOpen (MvPolynomial.X 0 : MvPolynomial (Fin (r + 1)) κ)))
              (Spec.map ψ)) := ⟨w, rfl⟩
      rw [Scheme.Pullback.range_snd] at hw
      have hb := (hO _).1 hw
      refine ⟨(hμ _ _).2 ?_, fun h => hb ((hμ _ _).1 h)⟩
      rw [Ideal.Quotient.eq_zero_iff_mem.2 (Ideal.mem_span_singleton_self a)]
      exact Ideal.zero_mem _
    · rintro ⟨ha, hb⟩
      have hz := (PrimeSpectrum.mem_zeroLocus (R := R) p (↑(Ideal.span {a}) : Set R)).2
        (Ideal.span_le.2 (Set.singleton_subset_iff.2 ha))
      have hr := range_comap_of_surjective (R ⧸ Ideal.span {a})
        (Ideal.Quotient.mk (Ideal.span {a})) Ideal.Quotient.mk_surjective
      rw [Ideal.mk_ker] at hr
      obtain ⟨p', hpe⟩ : ∃ p' : Spec (CommRingCat.of (↑R ⧸ Ideal.span {a})),
          Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {a}))) p' = p := by
        have hp : p ∈ Set.range (PrimeSpectrum.comap (Ideal.Quotient.mk (Ideal.span {a}))) := by
          rw [hr]; exact hz
        obtain ⟨q, hq⟩ := hp
        exact ⟨q, (Spec.map_apply (R := R) (S := CommRingCat.of (↑R ⧸ Ideal.span {a}))
          (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {a}))) q).trans hq⟩
      have hb' : Ideal.Quotient.mk (Ideal.span {a}) b ∉ p'.asIdeal := by
        intro h
        have h2 := (hμ p' b).2 h
        rw [hpe] at h2
        exact hb h2
      obtain ⟨o, ho⟩ := (hO p').2 hb'
      obtain ⟨w, -, hw2⟩ := Scheme.Pullback.exists_preimage_pullback
        (f := Scheme.Opens.ι (X := Spec (CommRingCat.of (MvPolynomial (Fin (r + 1)) κ)))
            (PrimeSpectrum.basicOpen (MvPolynomial.X 0 : MvPolynomial (Fin (r + 1)) κ)))
        (g := Spec.map ψ) o p' ho
      exact ⟨w, by rw [Scheme.Hom.comp_apply, hw2, hpe]⟩

  obtain ⟨φ, rfl⟩ : ∃ φ, Spec.map φ = cs := ⟨_, Spec.map_preimage cs⟩
  set J := wcQuadModelIdeal κ (r + 2) 0
      (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : κ) else 0) with hJ
  set a : (R : Type u) := φ.hom (Ideal.Quotient.mk J
    (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)))) with ha_def
  set b : (R : Type u) := φ.hom (Ideal.Quotient.mk J
    (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2)))) with hb_def
  have hrange' : Set.range (z ≫ o) = {p : Spec R | a ∈ p.asIdeal ∧ b ∉ p.asIdeal} := by
    rw [hrange]; ext p; simp only [Set.mem_setOf_eq, Spec.map_apply]; rfl

  let θ : MvPolynomial (Fin (r + 2)) κ →+* MvPolynomial (Fin (r + 1)) κ :=
    (MvPolynomial.aeval (R := κ) (Fin.cons (0 : MvPolynomial (Fin (r + 1)) κ) MvPolynomial.X :
      Fin (r + 2) → MvPolynomial (Fin (r + 1)) κ)).toRingHom
  have hθX0 : θ (MvPolynomial.X 0) = 0 := by simp [θ]
  have hθXs : ∀ j : Fin (r + 1), θ (MvPolynomial.X j.succ) = MvPolynomial.X j := by
    intro j; simp [θ]
  have hθC : ∀ c : κ, θ (MvPolynomial.C c) = MvPolynomial.C c := by
    intro c; simp [θ, MvPolynomial.algebraMap_eq]
  have hJθ : ∀ x ∈ J, θ x = 0 := by
    intro x hx
    obtain ⟨g, rfl⟩ := Ideal.mem_span_singleton'.1 hx
    rw [map_mul]
    have hG : θ (∑ p : Fin (r + 2), ∑ q : Fin (r + 2), MvPolynomial.C
        ((Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : κ) else 0) p q) *
          MvPolynomial.X p * MvPolynomial.X q - MvPolynomial.C 0) = 0 := by
      rw [map_sub, map_sum, MvPolynomial.C_0, map_zero, sub_zero]
      apply Finset.sum_eq_zero
      intro p _
      rw [map_sum]
      apply Finset.sum_eq_zero
      intro q _
      simp only [Matrix.of_apply]
      split_ifs with h
      · have hp0 : p = 0 := Fin.ext h.1
        subst hp0
        rw [map_mul, map_mul, hθX0, mul_zero, zero_mul]
      · rw [MvPolynomial.C_0, zero_mul, zero_mul, map_zero]
    rw [hG, mul_zero]
  let θb : CommRingCat.of (wcQuadModelRing κ (r + 2) 0
      (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : κ) else 0)) ⟶
      CommRingCat.of (MvPolynomial (Fin (r + 1)) κ) :=
    CommRingCat.ofHom (Ideal.Quotient.lift J θ hJθ)
  have hθb : ∀ x, θb.hom (Ideal.Quotient.mk J x) = θ x := fun x => Ideal.Quotient.lift_mk _ _ _
  let base : κ →+* (R : Type u) ⧸ Ideal.span {a} :=
    (Ideal.Quotient.mk (Ideal.span {a})).comp (φ.hom.comp ((Ideal.Quotient.mk J).comp MvPolynomial.C))
  let ψ0 : MvPolynomial (Fin (r + 1)) κ →+* (R : Type u) ⧸ Ideal.span {a} :=
    MvPolynomial.eval₂Hom base (fun i => Ideal.Quotient.mk (Ideal.span {a})
      (φ.hom (Ideal.Quotient.mk J (MvPolynomial.X i.succ))))
  let ψ : CommRingCat.of (MvPolynomial (Fin (r + 1)) κ) ⟶
      CommRingCat.of ((R : Type u) ⧸ Ideal.span {a}) := CommRingCat.ofHom ψ0
  let inl : R ⟶ CommRingCat.of ((R : Type u) ⧸ Ideal.span {a}) :=
    CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {a}))
  have hmka : Ideal.Quotient.mk (Ideal.span {a}) a = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.2 (Ideal.mem_span_singleton_self a)
  have hψC : ∀ c : κ, ψ0 (MvPolynomial.C c) =
      Ideal.Quotient.mk (Ideal.span {a}) (φ.hom (Ideal.Quotient.mk J (MvPolynomial.C c))) := by
    intro c; simp [ψ0, base]
  have hψX : ∀ j : Fin (r + 1), ψ0 (MvPolynomial.X j) =
      Ideal.Quotient.mk (Ideal.span {a}) (φ.hom (Ideal.Quotient.mk J (MvPolynomial.X j.succ))) := by
    intro j; simp [ψ0]
  have hw : φ ≫ inl = θb ≫ ψ := by
    apply CommRingCat.hom_ext
    apply Ideal.Quotient.ringHom_ext
    apply MvPolynomial.ringHom_ext
    · intro c
      show Ideal.Quotient.mk (Ideal.span {a}) (φ.hom (Ideal.Quotient.mk J (MvPolynomial.C c))) =
        ψ0 (θb.hom (Ideal.Quotient.mk J (MvPolynomial.C c)))
      rw [hθb, hθC, hψC]
    · intro i
      show Ideal.Quotient.mk (Ideal.span {a}) (φ.hom (Ideal.Quotient.mk J (MvPolynomial.X i))) =
        ψ0 (θb.hom (Ideal.Quotient.mk J (MvPolynomial.X i)))
      rw [hθb]
      refine Fin.cases ?_ (fun j => ?_) i
      · rw [hθX0, map_zero]; exact hmka
      · rw [hθXs, hψX]
  have hdesc : ∀ s : Limits.PushoutCocone φ θb, ∀ x ∈ Ideal.span {a}, s.inl.hom x = 0 := by
    intro s x hx
    obtain ⟨y, rfl⟩ := Ideal.mem_span_singleton'.1 hx
    have h : (φ ≫ s.inl).hom (Ideal.Quotient.mk J (MvPolynomial.X 0)) =
        (θb ≫ s.inr).hom (Ideal.Quotient.mk J (MvPolynomial.X 0)) := by rw [s.condition]
    have h2 : s.inl.hom a = 0 := by
      refine h.trans ?_
      show s.inr.hom (θb.hom (Ideal.Quotient.mk J (MvPolynomial.X 0))) = 0
      rw [hθb, hθX0, map_zero]
    rw [map_mul, h2, mul_zero]
  have hsC : ∀ (s : Limits.PushoutCocone φ θb) (x), s.inl.hom (φ.hom (Ideal.Quotient.mk J x)) =
      s.inr.hom (θ x) := by
    intro s x
    have h : (φ ≫ s.inl).hom (Ideal.Quotient.mk J x) =
        (θb ≫ s.inr).hom (Ideal.Quotient.mk J x) := by rw [s.condition]
    refine h.trans ?_
    show s.inr.hom (θb.hom (Ideal.Quotient.mk J x)) = _
    rw [hθb]
  have hpo : IsPushout φ θb inl ψ := by
    refine IsPushout.of_isColimit (c := Limits.PushoutCocone.mk inl ψ hw) ?_
    refine Limits.PushoutCocone.IsColimit.mk hw
      (fun s => CommRingCat.ofHom (Ideal.Quotient.lift (Ideal.span {a}) s.inl.hom (hdesc s)))
      ?_ ?_ ?_
    · intro s
      apply CommRingCat.hom_ext
      apply RingHom.ext
      intro x
      show Ideal.Quotient.lift (Ideal.span {a}) s.inl.hom (hdesc s)
        (Ideal.Quotient.mk (Ideal.span {a}) x) = s.inl.hom x
      exact Ideal.Quotient.lift_mk _ _ _
    · intro s
      apply CommRingCat.hom_ext
      apply MvPolynomial.ringHom_ext
      · intro c
        show Ideal.Quotient.lift (Ideal.span {a}) s.inl.hom (hdesc s) (ψ0 (MvPolynomial.C c)) =
          s.inr.hom (MvPolynomial.C c)
        rw [hψC, Ideal.Quotient.lift_mk, hsC, hθC]
      · intro j
        show Ideal.Quotient.lift (Ideal.span {a}) s.inl.hom (hdesc s) (ψ0 (MvPolynomial.X j)) =
          s.inr.hom (MvPolynomial.X j)
        rw [hψX, Ideal.Quotient.lift_mk, hsC, hθXs]
    · intro s m hm1 _
      apply CommRingCat.hom_ext
      apply Ideal.Quotient.ringHom_ext
      apply RingHom.ext
      intro x
      show m.hom (Ideal.Quotient.mk (Ideal.span {a}) x) =
        Ideal.Quotient.lift (Ideal.span {a}) s.inl.hom (hdesc s) (Ideal.Quotient.mk _ x)
      rw [Ideal.Quotient.lift_mk]
      exact congrArg (fun f => f.hom x) hm1
  have hpb := isPullback_SpecMap_of_isPushout φ θb inl ψ hpo
  have hψ : WeaklyEtale (Spec.map ψ) := MorphismProperty.of_isPullback (P := @WeaklyEtale) hpb hcs
  have hψX0 : ψ.hom (MvPolynomial.X 0) = Ideal.Quotient.mk (Ideal.span {a}) b := by
    show ψ0 (MvPolynomial.X 0) = _
    rw [hψX]; rfl

  by_cases ha : IsUnit a
  · have hP : IsEmpty P := ⟨fun x => by
      have hx : (z ≫ o) x ∈ Set.range (z ≫ o) := ⟨x, rfl⟩
      rw [hrange'] at hx
      exact ((z ≫ o) x).isPrime.ne_top (Ideal.eq_top_of_isUnit_mem _ hx.1 ha)⟩
    exact hEmpty P hP ℓ k
  · have hI : Ideal.span {a} ≠ ⊤ := fun h => ha (Ideal.span_singleton_eq_top.1 h)
    obtain ⟨hH, hS⟩ := HQ (R : Type u) (Ideal.span {a}) hI
    obtain ⟨j, rfl⟩ : ∃ j, k = j + 2 := ⟨k - 2, by omega⟩
    have h₁ := @LA (CommRingCat.of ((R : Type u) ⧸ Ideal.span {a})) hH hS ψ hψ j
    haveI : IsImmersion (z ≫ o) := inferInstance
    have hιgen : ∀ {X : Scheme.{u}} (U : X.Opens), IsOpenImmersion U.ι := fun U => inferInstance
    haveI hsnd : IsOpenImmersion (Limits.pullback.snd
        (Scheme.Opens.ι (X := Spec (CommRingCat.of (MvPolynomial (Fin (r + 1)) κ)))
          (PrimeSpectrum.basicOpen (MvPolynomial.X 0 : MvPolynomial (Fin (r + 1)) κ)))
        (Spec.map ψ)) :=
      MorphismProperty.of_isPullback (P := @IsOpenImmersion) (IsPullback.of_hasPullback _ _)
        (hιgen (X := Spec (CommRingCat.of (MvPolynomial (Fin (r + 1)) κ)))
          (PrimeSpectrum.basicOpen (MvPolynomial.X 0 : MvPolynomial (Fin (r + 1)) κ)))
    haveI : IsImmersion (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {a})))) :=
      inferInstance
    haveI : IsImmersion (Limits.pullback.snd
        (Scheme.Opens.ι (X := Spec (CommRingCat.of (MvPolynomial (Fin (r + 1)) κ)))
          (PrimeSpectrum.basicOpen (MvPolynomial.X 0 : MvPolynomial (Fin (r + 1)) κ)))
        (Spec.map ψ) ≫ Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {a})))) :=
      inferInstance
    have hcard := L2 (z ≫ o) (Limits.pullback.snd
        (Scheme.Opens.ι (X := Spec (CommRingCat.of (MvPolynomial (Fin (r + 1)) κ)))
          (PrimeSpectrum.basicOpen (MvPolynomial.X 0 : MvPolynomial (Fin (r + 1)) κ)))
        (Spec.map ψ) ≫ Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {a}))))
      (by rw [hrange', LR a b ψ hψX0]) ℓ (j + 2)
    have h1 : Nat.card (wcEtCoh (Limits.pullback
        (Scheme.Opens.ι (X := Spec (CommRingCat.of (MvPolynomial (Fin (r + 1)) κ)))
          (PrimeSpectrum.basicOpen (MvPolynomial.X 0 : MvPolynomial (Fin (r + 1)) κ)))
        (Spec.map ψ)) ℓ (j + 2)) = 1 :=
      Nat.card_eq_one_iff_unique.2 ⟨h₁, hNE _ _ _⟩
    rw [h1] at hcard
    exact (Nat.card_eq_one_iff_unique.1 hcard).1

theorem wc_qmbt_xsp_ess_D1l_Y_compl_strict_stalk_high {A : Type u} [CommRing A] [IsDomain A]
    [IsDiscreteValuationRing A]
    [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (hℓ : IsUnit ((ℓ : ℕ) : A)) {n : ℕ} (hn : Even n) (hn4 : 4 ≤ n) {π : A}
    {c : Matrix (Fin n) (Fin n) A}
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π}) (hc : IsUnit (c + c.transpose).det)
    {x₀ : Spec (.of (wcQuadModelRing A n π c))}
    (hx₀ : ∀ p, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
      PrimeSpectrum.asIdeal x₀)
    {B₀ : Type u} [CommRing B₀] [HenselianLocalRing B₀] [IsSepClosed (IsLocalRing.ResidueField B₀)]
    {Λ₀ : Type u} [SmallCategory Λ₀] [IsCofiltered Λ₀]
    {W₀ : Λ₀ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (wcQuadModelRing A n π c))) x₀))
      (Scheme.Etale.forget (Spec (.of (wcQuadModelRing A n π c))))}
    {φ₀ : ∀ l, Spec (.of B₀) ⟶ (W₀.obj l).right.left}
    {a₀ : Spec (.of B₀) ⟶ Spec (.of (wcQuadModelRing A n π c))}
    (hsh : wcHalShData x₀ B₀ Λ₀ W₀ φ₀ a₀)
    {Xs : Scheme.{u}} {ι : Xs ⟶ Spec (.of B₀)} {s : Xs ⟶ Spec (.of (IsLocalRing.ResidueField A))}
    (hps : IsPullback ι s (a₀ ≫ wcQuadModelStr A n π c) (wcQmSp A))
    {A' : Type u} [CommRing A'] [IsDomain A'] [IsDiscreteValuationRing A'] [HenselianLocalRing A']
    [IsSepClosed (IsLocalRing.ResidueField A')] {ιA : A →+* A'} {π' : A'}
    (hℓ' : IsUnit ((ℓ : ℕ) : A')) (hπ' : IsLocalRing.maximalIdeal A' = Ideal.span {π'})
    (hπ'2 : π' ^ 2 = ιA π) (hgen : ∀ a' : A', ∃ x y : A, a' = ιA x + ιA y * π')
    {L' : Type u} [Field L'] [IsSepClosed L'] {φ' : A' →+* L'} (hφ' : Function.Injective φ')
    (halg' : letI := φ'.toAlgebra; Algebra.IsAlgebraic A' L')
    {Xm : Scheme.{u}} {f : Xm ⟶ Spec (.of A')}
    {bl : Xm ⟶ Limits.pullback (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))}
    (hbl : wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range
      (fun i : Option (Fin n) => Option.elim i
        ((Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of A')).inv.hom π'))
        (fun j => ((Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
