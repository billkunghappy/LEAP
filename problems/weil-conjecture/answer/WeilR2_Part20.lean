by
  have key : ∀ (X : Scheme.{u}) (f : X ⟶ S) (_ : WeaklyEtale f) (x : X),
      HenselianLocalRing (X.presheaf.stalk x) → IsSepClosed (X.residueField x) →
      IsNoetherianRing (X.presheaf.stalk x) := by
    intro X f hf x h1 h2
