  have bijP := fun n : ℕ => (wc_qmbt_pmv_ext_transfer_bij EP.Φ LP adjP pflP (wcSuppObj D)
    (SheafOfModules.unit (wcRingSheaf Y ℓ)) (wcSuppObj DP) (SheafOfModules.unit (wcRingSheaf P ℓ))
