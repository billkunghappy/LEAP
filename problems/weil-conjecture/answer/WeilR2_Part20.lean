          (MvPolynomial.X i : MvPolynomial (Fin n) K) ∈ (Limits.pullback.fst (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin n) K)))) (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) w).asIdeal ↔
            (MvPolynomial.X i.succ : MvPolynomial (Fin (n + 1)) K) ∈ (ι.hom w).asIdeal := by
        intro w i
        rw [← e₁, Scheme.Hom.comp_apply, star]
        simp [MvPolynomial.rename_X]
      have C2 : ∀ (w : ↥(Limits.pullback (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin n) K)))) (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))))),
          (Polynomial.X : Polynomial K) ∈ (Limits.pullback.snd (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin n) K)))) (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) w).asIdeal ↔
            (MvPolynomial.X 0 : MvPolynomial (Fin (n + 1)) K) ∈ (ι.hom w).asIdeal := by
        intro w
        rw [← e₂, Scheme.Hom.comp_apply, star]
        simp [Polynomial.aeval_X]
      refine ⟨W, A, B, rfl, rfl, rfl, ?_, ?_, ?_, ?_⟩
      · apply TopologicalSpace.Opens.ext
        rw [TopologicalSpace.Opens.coe_sup, hV]
        ext x
        rw [Set.mem_union, SetLike.mem_coe, SetLike.mem_coe, hA, hB, Set.mem_setOf_eq]
        constructor
        · rintro (h | ⟨i, hi, h⟩)
          · exact ⟨0, by simp, h⟩
          · refine ⟨i.succ, ?_, h⟩
            have := Fin.val_succ i
            omega
        · rintro ⟨i, hi, h⟩
          rcases (Fin.exists_fin_succ (P := fun i : Fin (n + 1) => i.val < k + 1 ∧
              (MvPolynomial.X i : MvPolynomial (Fin (n + 1)) K) ∉ x.asIdeal)).mp ⟨i, hi, h⟩ with
            ⟨_, h0⟩ | ⟨j, hj, hj'⟩
          · exact Or.inl h0
          · refine Or.inr ⟨j, ?_, hj'⟩
            have := Fin.val_succ j
            omega
      · obtain ⟨eA⟩ := s2 _ _ (𝟙 _) _ ι A (by
          intro w
          rw [hA, hjr, Set.mem_setOf_eq, C2]
          exact ⟨fun h => ⟨Scheme.Hom.surjective _ _, h⟩, fun h => h.2⟩)
        exact ⟨eA ≪≫ Limits.pullback.congrHom (Category.id_comp _) hjq⟩
      · obtain ⟨eB⟩ := s2 _ _ W.ι (𝟙 _) ι B (by
          intro w
          rw [hB, Scheme.Opens.range_ι, hW]
          simp only [C1]
          exact ⟨fun h => ⟨h, Scheme.Hom.surjective _ _⟩, fun h => h.1⟩)
        exact ⟨eB ≪≫ Limits.pullback.congrHom rfl (Category.id_comp _)⟩
      · obtain ⟨eAB⟩ := s2 _ _ W.ι _ ι (A ⊓ B) (by
          intro w
          rw [hAB, hA, hB, Scheme.Opens.range_ι, hW, hjr, Set.mem_setOf_eq, C2]
          simp only [C1]
          exact and_comm)
        exact ⟨eAB ≪≫ Limits.pullback.congrHom rfl hjq⟩

    have hLFT : ∀ n : ℕ,
        LocallyOfFiniteType (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin n) K)))) := by
      intro n
      rw [HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType)]
      exact RingHom.finiteType_algebraMap.mpr inferInstance
    have card1 : ∀ (X : Scheme.{u}) (q : ℕ), Subsingleton (wcEtCoh X ℓ q) →
        Nat.card (wcEtCoh X ℓ q) ≤ 1 := by
      intro X q h
      haveI := h
      exact Finite.card_le_one_iff_subsingleton.mpr h
    have transF : ∀ {X Y : Scheme.{u}} (e : X ≅ Y) (q : ℕ), Finite (wcEtCoh Y ℓ q) →
        Finite (wcEtCoh X ℓ q) ∧ Nat.card (wcEtCoh X ℓ q) = Nat.card (wcEtCoh Y ℓ q) := by
      intro X Y e q h
      obtain ⟨e'⟩ := wc_et_coh_iso_invariance e.hom ℓ q
      exact ⟨Finite.of_equiv _ e', (Nat.card_congr e').symm⟩

    have key : ∀ k' n : ℕ, k' + 1 ≤ n → ∀ (E : (Spec (.of (MvPolynomial (Fin n) K))).Opens),
        (E : Set (Spec (.of (MvPolynomial (Fin n) K)))) =
          {x | ∃ j : Fin n, j.val < k' + 1 ∧ (MvPolynomial.X j : MvPolynomial (Fin n) K) ∉ x.asIdeal} →
        Finite (wcEtCoh (E : Scheme.{u}) ℓ (2 * k' + 1)) ∧
          Nat.card (wcEtCoh (E : Scheme.{u}) ℓ (2 * k' + 1)) ≤ ℓ := by
      intro k'
      induction k' with
      | zero =>
        intro n' hk E hE
        obtain ⟨n, rfl⟩ : ∃ n, n' = n + 1 := ⟨n' - 1, by omega⟩
        obtain ⟨W, A, B, hW, _, hBs, hAB, ⟨eA⟩, ⟨eB⟩, ⟨eAB⟩⟩ := cover n 0 E hE
        haveI := hLFT n
        have hBe : IsEmpty (B : Scheme.{u}) := by
          refine ⟨fun y => ?_⟩
          obtain ⟨y, hy⟩ := y
          have hy' : y ∈ (B : Set (Spec (.of (MvPolynomial (Fin (n + 1)) K)))) := hy
          rw [hBs] at hy'
          obtain ⟨i, hi, _⟩ := hy'
          omega
        have hABe : IsEmpty ((A ⊓ B : (Spec (.of (MvPolynomial (Fin (n + 1)) K))).Opens) :
            Scheme.{u}) := by
          refine ⟨fun y => ?_⟩
          obtain ⟨y, hy⟩ := y
          have hy2 : y ∈ B := (show y ∈ A ∧ y ∈ B from hy).2
          have hy' : y ∈ (B : Set (Spec (.of (MvPolynomial (Fin (n + 1)) K)))) := hy2
          rw [hBs] at hy'
          obtain ⟨i, hi, _⟩ := hy'
          omega
        have hsA1 := wc_et_affine_space_coh_vanishing K ℓ hℓ hℓK n (0 + 1) (by omega)
        haveI := hsA1
        obtain ⟨hA0f, hA0c⟩ := wc_et_coh_zero_irreducible_card_le
          (Spec (.of (MvPolynomial (Fin n) K))) ℓ hℓ.ne_zero
        have hg := wc_et_coh_gm_product_card_le K ℓ hℓ hℓK _
          (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin n) K)))) 0
          Finite.of_subsingleton hA0f
        obtain ⟨hAf, hAc⟩ := transF eA (0 + 1) hg.1
        have hAc' : Nat.card (wcEtCoh (A : Scheme.{u}) ℓ (0 + 1)) ≤ ℓ := by
          rw [hAc]
          calc _ ≤ _ := hg.2
            _ ≤ 1 * ℓ := Nat.mul_le_mul (card1 _ _ hsA1) hA0c
            _ = ℓ := one_mul ℓ
        have h1 := hempty _ hABe ℓ 0
        have h3 := hempty _ hBe ℓ (0 + 1)
        haveI := h1
        haveI := h3
        have h := wc_et_zariski_mv_card_le _ E A B hAB ℓ 0 Finite.of_subsingleton hAf
          Finite.of_subsingleton
        have hc : Nat.card (wcEtCoh (E : Scheme.{u}) ℓ (0 + 1)) ≤ ℓ :=
          calc _ ≤ _ := h.2
            _ ≤ 1 * (ℓ * 1) := Nat.mul_le_mul (card1 _ _ h1) (Nat.mul_le_mul hAc' (card1 _ _ h3))
            _ = ℓ := by ring
        exact ⟨h.1, hc⟩
      | succ k ih =>
        intro n' hk E hE
        obtain ⟨n, rfl⟩ : ∃ n, n' = n + 1 := ⟨n' - 1, by omega⟩
        obtain ⟨W, A, B, hW, _, _, hAB, ⟨eA⟩, ⟨eB⟩, ⟨eAB⟩⟩ := cover n (k + 1) E hE
        haveI := hLFT n
        obtain ⟨hWf, hWc⟩ := ih n (by omega) W hW
        have hWs : ∀ r, 2 * (k + 1) ≤ r → Subsingleton (wcEtCoh (W : Scheme.{u}) ℓ r) :=
          fun r hr => wc_et_affine_partial_punct_vanishing K ℓ hℓ hℓK n (k + 1) (by omega) W hW r hr

        have hW2 := hWs (2 * k + 1 + 1) (by omega)
        haveI := hW2
        have hgAB := wc_et_coh_gm_product_card_le K ℓ hℓ hℓK (W : Scheme.{u})
          (W.ι ≫ Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin n) K)))) (2 * k + 1)
          Finite.of_subsingleton hWf
        obtain ⟨hABf, hABc⟩ := transF eAB (2 * k + 1 + 1) hgAB.1
        have hABc' : Nat.card (wcEtCoh ((A ⊓ B : (Spec (.of (MvPolynomial (Fin (n + 1)) K))).Opens) :
            Scheme.{u}) ℓ (2 * k + 1 + 1)) ≤ ℓ := by
          rw [hABc]
          calc _ ≤ _ := hgAB.2
            _ ≤ 1 * ℓ := Nat.mul_le_mul (card1 _ _ hW2) hWc
            _ = ℓ := one_mul ℓ

        have hA1 := wc_et_affine_space_coh_vanishing K ℓ hℓ hℓK n (2 * k + 1 + 1 + 1) (by omega)
        have hA2 := wc_et_affine_space_coh_vanishing K ℓ hℓ hℓK n (2 * k + 1 + 1) (by omega)
        haveI := hA1
        haveI := hA2
        have hgA := wc_et_coh_gm_product_card_le K ℓ hℓ hℓK _
          (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin n) K)))) (2 * k + 1 + 1)
          Finite.of_subsingleton Finite.of_subsingleton
        obtain ⟨hAf, hAc⟩ := transF eA (2 * k + 1 + 1 + 1) hgA.1
        have hAc' : Nat.card (wcEtCoh (A : Scheme.{u}) ℓ (2 * k + 1 + 1 + 1)) ≤ 1 := by
          rw [hAc]
          calc _ ≤ _ := hgA.2
            _ ≤ 1 * 1 := Nat.mul_le_mul (card1 _ _ hA1) (card1 _ _ hA2)

        obtain ⟨eBl⟩ := wc_et_coh_affine_line_invariance K ℓ hℓ hℓK (W : Scheme.{u})
          (W.ι ≫ Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin n) K))))
          (2 * k + 1 + 1 + 1)
        have hW3 := hWs (2 * k + 1 + 1 + 1) (by omega)
        haveI := hW3
        have hBl := eBl.subsingleton
        haveI := hBl
        obtain ⟨hBf, hBc⟩ := transF eB (2 * k + 1 + 1 + 1) Finite.of_subsingleton
        have hBc' : Nat.card (wcEtCoh (B : Scheme.{u}) ℓ (2 * k + 1 + 1 + 1)) ≤ 1 := by
          rw [hBc]; exact card1 _ _ hBl

        have h := wc_et_zariski_mv_card_le _ E A B hAB ℓ (2 * k + 1 + 1) hABf hAf hBf
        rw [show 2 * (k + 1) + 1 = 2 * k + 1 + 1 + 1 by omega]
        refine ⟨h.1, ?_⟩
        calc _ ≤ _ := h.2
          _ ≤ ℓ * (1 * 1) := Nat.mul_le_mul hABc' (Nat.mul_le_mul hAc' hBc')
          _ = ℓ := by ring
    intro n k hk1 hk E hE
    obtain ⟨k', rfl⟩ : ∃ k', k = k' + 1 := ⟨k - 1, by omega⟩
    rw [show 2 * (k' + 1) - 1 = 2 * k' + 1 by omega]
    exact key k' n hk E hE

  have hC2 : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (ℓ : ℕ), ℓ.Prime → (ℓ : Ω) ≠ 0 → ∀ (e : ℕ), 1 ≤ e → ∀ (Y : Scheme.{u}) [AlgebraicGeometry.IsReduced Y] (jY : Y ⟶ wcProjK Ω (2 * e + 2)), IsClosedImmersion jY → Set.range jY = wcXspVplus Ω (2 * e + 2) (wcXspSplitCoeff Ω e) → Finite (wcEtCoh Y ℓ (2 * e)) ∧ Nat.card (wcEtCoh Y ℓ (2 * e)) ≤ ℓ := by
    intro Ω _ _ ℓ hℓp hℓ e he1 Y _ jY hjY hY
    haveI : Fact (Nat.Prime ℓ) := ⟨hℓp⟩
    haveI := hjY
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω) :=
      MvPolynomial.gradedAlgebra

    have hsumite : ∀ c : MvPolynomial (Fin (2 * e + 2 + 1)) Ω,
        ∑ p : Fin (2 * e + 2 + 1), ∑ q : Fin (2 * e + 2 + 1),
          (if p.val = 2 * e + 2 then (if q.val = 2 * e + 2 then c else 0) else 0) = c := by
      intro c
      have h1 : ∀ p : Fin (2 * e + 2 + 1), p ≠ Fin.last (2 * e + 2) → p.val ≠ 2 * e + 2 := by
        intro p hp h
        exact hp (Fin.ext (by rw [h, Fin.val_last]))
      rw [Fintype.sum_eq_single (Fin.last (2 * e + 2))]
      · simp only [Fin.val_last, if_true]
        rw [Fintype.sum_eq_single (Fin.last (2 * e + 2))]
        · simp only [Fin.val_last, if_true]
        · intro q hq
          rw [if_neg (h1 q hq)]
      · intro p hp
        simp only [if_neg (h1 p hp), Finset.sum_const_zero]
    have hcover : ∀ p : wcProjK Ω (2 * e + 2),
        p ∈ wcXspVplus Ω (2 * e + 2) (wcXspSplitCoeff Ω e) →
        ∃ c : Fin (2 * e + 2 + 1), c.val ≤ 2 * e + 1 ∧ p ∈ wcSgD Ω (2 * e + 2) c := by
      intro p hp
      by_contra hno
      push_neg at hno
      have hodd : ∀ i : Fin (2 * e + 2 + 1), i.val ≤ 2 * e + 1 →
          MvPolynomial.X i ∈ p.asHomogeneousIdeal.toIdeal := by
        intro i hi
        have h8 := hno i hi
        rw [Proj.mem_basicOpen, not_not] at h8
        exact h8
      have hG : ((wcLdpQuad Ω (2 * e + 2) (wcXspSplitCoeff Ω e) :
          MvPolynomial (Fin (2 * e + 2 + 1)) Ω)) ∈ p.asHomogeneousIdeal.toIdeal := by
        have h := hp
        simp only [wcXspVplus, Set.mem_setOf_eq, Proj.mem_basicOpen, not_not] at h
        exact h
      have hterm : ∀ a b : Fin (2 * e + 2 + 1),
          MvPolynomial.C (wcXspSplitCoeff Ω e a b) * (MvPolynomial.X a * MvPolynomial.X b) -
            (if a.val = 2 * e + 2 then (if b.val = 2 * e + 2 then
              -(MvPolynomial.X (Fin.last (2 * e + 2)) * MvPolynomial.X (Fin.last (2 * e + 2))) else 0)
              else 0) ∈ p.asHomogeneousIdeal.toIdeal := by
        intro a b
        unfold wcXspSplitCoeff
        by_cases h1 : a.val % 2 = 0 ∧ b.val = a.val + 1 ∧ a.val < 2 * e + 2
        · rw [if_pos h1, if_neg (by omega), sub_zero]
          exact Ideal.mul_mem_left _ _ (Ideal.mul_mem_left _ _ (hodd b (by omega)))
        · rw [if_neg h1]
          by_cases h2 : a.val = 2 * e + 2 ∧ b.val = 2 * e + 2
          · have ha : a = Fin.last (2 * e + 2) := Fin.ext (by rw [h2.1, Fin.val_last])
            have hb : b = Fin.last (2 * e + 2) := Fin.ext (by rw [h2.2, Fin.val_last])
            rw [if_pos h2, if_pos h2.1, if_pos h2.2, ha, hb]
            have h0 : MvPolynomial.C (-1 : Ω) * (MvPolynomial.X (Fin.last (2 * e + 2)) *
                MvPolynomial.X (Fin.last (2 * e + 2))) -
                -(MvPolynomial.X (Fin.last (2 * e + 2)) * MvPolynomial.X (Fin.last (2 * e + 2)) :
                  MvPolynomial (Fin (2 * e + 2 + 1)) Ω) = 0 := by
              rw [map_neg, map_one]; ring
            rw [h0]
            exact zero_mem _
          · rw [if_neg h2, map_zero, zero_mul, zero_sub]
            by_cases h3 : a.val = 2 * e + 2
            · rw [if_pos h3, if_neg (by omega), neg_zero]
              exact zero_mem _
            · rw [if_neg h3, neg_zero]
              exact zero_mem _
      have hsum : ((wcLdpQuad Ω (2 * e + 2) (wcXspSplitCoeff Ω e) :
          MvPolynomial (Fin (2 * e + 2 + 1)) Ω)) -
          -(MvPolynomial.X (Fin.last (2 * e + 2)) * MvPolynomial.X (Fin.last (2 * e + 2))) ∈
            p.asHomogeneousIdeal.toIdeal := by
        have hmem := Ideal.sum_mem p.asHomogeneousIdeal.toIdeal
          (t := Finset.univ) (fun a _ => Ideal.sum_mem p.asHomogeneousIdeal.toIdeal
            (t := Finset.univ) (fun b _ => hterm a b))
        simp only [Finset.sum_sub_distrib] at hmem
        rw [hsumite] at hmem
        exact hmem
      have hsq : MvPolynomial.X (Fin.last (2 * e + 2)) * MvPolynomial.X (Fin.last (2 * e + 2)) ∈
          p.asHomogeneousIdeal.toIdeal := by
        have h := Ideal.sub_mem _ hsum hG
        have e1 : ((wcLdpQuad Ω (2 * e + 2) (wcXspSplitCoeff Ω e) :
            MvPolynomial (Fin (2 * e + 2 + 1)) Ω)) -
            -(MvPolynomial.X (Fin.last (2 * e + 2)) * MvPolynomial.X (Fin.last (2 * e + 2))) -
            ((wcLdpQuad Ω (2 * e + 2) (wcXspSplitCoeff Ω e) :
            MvPolynomial (Fin (2 * e + 2 + 1)) Ω)) =
            MvPolynomial.X (Fin.last (2 * e + 2)) * MvPolynomial.X (Fin.last (2 * e + 2)) := by ring
        rw [e1] at h
        exact h
      have hlast : MvPolynomial.X (Fin.last (2 * e + 2)) ∈ p.asHomogeneousIdeal.toIdeal := by
        rcases p.isPrime.mem_or_mem hsq with h | h <;> exact h
      have hall : ∀ i : Fin (2 * e + 2 + 1), MvPolynomial.X i ∈ p.asHomogeneousIdeal.toIdeal := by
        intro i
        by_cases hi : i.val ≤ 2 * e + 1
        · exact hodd i hi
        · have : i = Fin.last (2 * e + 2) := Fin.ext (by rw [Fin.val_last]; omega)
          rw [this]; exact hlast
      apply ProjectiveSpectrum.not_irrelevant_le p
      intro x hx
      have hx0 : x.coeff 0 = 0 := by
        rw [HomogeneousIdeal.mem_irrelevant_iff, GradedRing.proj_apply] at hx
        have h6 : ((DirectSum.decompose (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω)
            x 0 : MvPolynomial (Fin (2 * e + 2 + 1)) Ω)) = MvPolynomial.homogeneousComponent 0 x :=
          MvPolynomial.decomposition.decompose'_apply x 0
        rw [h6, MvPolynomial.homogeneousComponent_zero, MvPolynomial.C_eq_zero] at hx
        exact hx
      have hspan : x ∈ Ideal.span (MvPolynomial.X '' (Set.univ : Set (Fin (2 * e + 2 + 1)))) := by
        rw [MvPolynomial.mem_ideal_span_X_image]
        intro m hm
        rw [MvPolynomial.mem_support_iff] at hm
        have hm0 : m ≠ 0 := by
          rintro rfl
          exact hm hx0
        obtain ⟨i, hi⟩ := Finsupp.ne_iff.mp hm0
        exact ⟨i, Set.mem_univ _, hi⟩
      have hle : Ideal.span (MvPolynomial.X '' (Set.univ : Set (Fin (2 * e + 2 + 1)))) ≤
          p.asHomogeneousIdeal.toIdeal := by
        rw [Ideal.span_le, Set.image_subset_iff]
        intro i _
        exact hall i
      exact hle hspan

    haveI hsm : SmoothOfRelativeDimension (2 * e + 1) (jY ≫ wcProjKStr Ω (2 * e + 2)) := by
      apply wc_ldp_il_smooth_local
      intro z
      obtain ⟨c, hc, hz⟩ := hcover (jY z) (by rw [← hY]; exact ⟨z, rfl⟩)
      refine ⟨jY ⁻¹ᵁ wcSgD Ω (2 * e + 2) c, hz, ?_⟩
      obtain ⟨φ, hφ⟩ := wc_qxs_odd_chart_affine_iso Ω e Y jY hjY hY c hc
      haveI : IsZariskiLocalAtSource (@SmoothOfRelativeDimension (2 * e + 1)) :=
        HasRingHomProperty.instIsZariskiLocalAtSource
      have h := IsZariskiLocalAtSource.comp (wc_mvpoly_spec_smoothOfRelDim Ω (2 * e + 1)) φ.hom
      rw [hφ] at h
      exact h

    let W : ℕ → Y.Opens := fun k => jY ⁻¹ᵁ wcSgD Ω (2 * e + 2)
      ⟨if k ≤ e then 2 * k + 1 else 2 * e + 1, by split_ifs <;> omega⟩
    have hW1 : ∀ k, k ≤ e → ∀ q, 1 ≤ q →
        Subsingleton (wcEtCoh (W k : Scheme.{u}) ℓ q) := by
      intro k _ q hq
      obtain ⟨φ, -⟩ := wc_qxs_odd_chart_affine_iso Ω e Y jY hjY hY
        ⟨if k ≤ e then 2 * k + 1 else 2 * e + 1, by split_ifs <;> omega⟩
        (by show (if k ≤ e then 2 * k + 1 else 2 * e + 1) ≤ 2 * e + 1; split_ifs <;> omega)
      obtain ⟨E⟩ := wc_et_coh_iso_invariance φ.inv ℓ q
      haveI := wc_et_affine_space_coh_vanishing Ω ℓ hℓp hℓ (2 * e + 1) q hq
      exact E.subsingleton
    have hW2 : ∀ k, 1 ≤ k → k ≤ e → ∀ q, 2 * k ≤ q →
        Subsingleton (wcEtCoh ((W k ⊓ ⨆ (i : ℕ) (_ : i < k), W i : Y.Opens) : Scheme.{u}) ℓ q) := by
      intro k hk1 hk q hq
      obtain ⟨E, hE, ⟨φ⟩⟩ := wc_qxs_odd_chart_overlap_iso Ω e Y jY hjY hY k hk1 hk
      obtain ⟨Eq⟩ := wc_et_coh_iso_invariance φ.inv ℓ q
      haveI := wc_et_affine_partial_punct_vanishing Ω ℓ hℓp hℓ (2 * e + 1) k (by omega) E hE q hq
      exact Eq.subsingleton

    have hMV : ∀ m, m + 1 ≤ e → ∀ q, 2 * e - 1 ≤ q →
        Subsingleton (wcEtCoh ((⨆ (k : ℕ) (_ : k ≤ m), W k : Y.Opens) : Scheme.{u}) ℓ q) := by
      intro m
      induction m with
      | zero =>
        intro _ q hq
        have h0 : (⨆ (k : ℕ) (_ : k ≤ 0), W k) = W 0 := by
          apply le_antisymm
          · exact iSup₂_le (fun k hk => by rw [Nat.le_zero.mp hk])
          · exact le_iSup₂_of_le 0 le_rfl le_rfl
        rw [h0]
        exact hW1 0 (by omega) q (by omega)
      | succ m ih =>
