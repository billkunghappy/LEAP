  obtain ⟨fO, hfOdef⟩ : ∃ fO : O'.toScheme ⟶ (U0.toScheme.basicOpen s0).toScheme,
      fO = k''.resLE (U0.toScheme.basicOpen s0) O' hle' := ⟨_, rfl⟩
