    rw [Scheme.Pullback.range_fst, hrange]
    show t w = IsLocalRing.closedPoint A' ↔ _
    rw [htdef, Scheme.Hom.comp_apply]
    constructor
    · intro hq
      have h3 : π' ∈ (Spec.map (CommRingCat.ofHom
          (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)))) (r₁ w)).asIdeal := by
        rw [hq]; exact hπm
      exact h3
    · intro hq
      apply PrimeSpectrum.ext
      change Ideal.comap (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA))) (r₁ w).asIdeal =
        IsLocalRing.maximalIdeal A'
      apply le_antisymm
      · exact IsLocalRing.le_maximalIdeal (Ideal.comap_ne_top _ (r₁ w).isPrime.ne_top)
      · rw [hπ', Ideal.span_singleton_le_iff_mem]; exact hq

  haveI : WeaklyEtale a₀ := wc_shdata_weaklyEtale x₀ B₀ Λ₀ W₀ φ₀ a₀ hsh
  haveI : Flat a₀ := inferInstance
  have hps₂ : IsPullback ι' s' (ψ ≫ t) (wcQmSp A') := by
    rw [htdef, hrel, hblf]; exact hps'
  have hcond : (ι' ≫ ψ) ≫ t = s' ≫ wcQmSp A' := by
