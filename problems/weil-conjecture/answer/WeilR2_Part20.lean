      (Limits.pullback.fst V.hom i)) ℓ) (hDj₁ : wcHMPullCanonical Dj₁) :
    ∃ CT : (letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf V.left ℓ)) := HasExt.standard _
