          (((Limits.kernel.ι (wcSuppUnitMap EY)).val.app (Opposite.op V)).hom p)))
        ((Limits.pullback.fst ((wcProEtBC i₁).obj V).hom iY').base q) *
      (wcSuppTwist (wcSuppUnitMap EY'))
        ((Limits.pullback.snd ((wcProEtBC i₁).obj V).hom iY').base.hom q) = 0
    exact (congrArg (fun a : ULift.{u+1} ℚ_[ℓ] => a * (wcSuppTwist (wcSuppUnitMap EY'))
        ((Limits.pullback.snd ((wcProEtBC i₁).obj V).hom iY').base.hom q)) hs).trans
      (zero_mul _)
  exact ⟨Abelian.epiDesc (wcSuppUnitMap EY) _ hK, Abelian.comp_epiDesc _ _ _⟩

theorem wc_qmbt_dlyt_ct_closed_affine (R : CommRingCat.{u}) [IsLocalRing R] {P : Scheme.{u}}
    (j : P ⟶ Spec R) [IsClosedImmersion j] (hne : Nonempty P) :
    ∃ (I : Ideal R) (_ : I ≠ ⊤) (e : P ≅ Spec (CommRingCat.of (R ⧸ I))),
      e.hom ≫ Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)) = j ∧
      ∀ p : PrimeSpectrum (R ⧸ I), p.asIdeal.IsMaximal →
        Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)) p = IsLocalRing.closedPoint R :=
by
  obtain ⟨I, e, he⟩ := IsClosedImmersion.Spec_iff.mp ‹IsClosedImmersion j›
  have s2 : I ≠ ⊤ := by
    intro hI
    obtain ⟨x⟩ := hne
    haveI : Subsingleton (R ⧸ I) := Ideal.Quotient.subsingleton_iff.mpr hI
    have hE : IsEmpty (PrimeSpectrum (R ⧸ I)) := PrimeSpectrum.isEmpty_iff_subsingleton.mpr this
    exact @IsEmpty.false (PrimeSpectrum (R ⧸ I)) hE (e.hom x)
  have s3 : ∀ p : PrimeSpectrum (R ⧸ I), p.asIdeal.IsMaximal →
      Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)) p = IsLocalRing.closedPoint R := by
    intro p hp
    apply PrimeSpectrum.ext
    show Ideal.comap (Ideal.Quotient.mk I) p.asIdeal = IsLocalRing.maximalIdeal R
    haveI := hp
    have hmax : (Ideal.comap (Ideal.Quotient.mk I) p.asIdeal).IsMaximal :=
      Ideal.comap_isMaximal_of_surjective (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective
    exact IsLocalRing.eq_maximalIdeal hmax
  exact ⟨I, s2, e, he.symm, s3⟩

