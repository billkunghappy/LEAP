      ContinuousMap.one_apply] at h1 h2
    have h1' : (0 : ULift.{u+1} ℚ_[ℓ]) =
        (@id C(↥V.left, ULift.{u+1} ℚ_[ℓ])
          (((Limits.kernel.ι (wcSuppUnitMap EY)).val.app (Opposite.op V)).hom p))
            ((Limits.pullback.fst V.hom iY).base.hom z) *
          (wcSuppTwist (wcSuppUnitMap EY))
            ((Limits.pullback.snd V.hom iY).base.hom z) := h1
    show (@id C(↥V.left, ULift.{u+1} ℚ_[ℓ])
        (((Limits.kernel.ι (wcSuppUnitMap EY)).val.app (Opposite.op V)).hom p))
      ((Limits.pullback.fst V.hom iY).base.hom z) = 0
    linear_combination
      (-(c' ((Limits.pullback.snd V.hom iY).base.hom z))) * h1' -
      ((@id C(↥V.left, ULift.{u+1} ℚ_[ℓ])
        (((Limits.kernel.ι (wcSuppUnitMap EY)).val.app (Opposite.op V)).hom p))
        ((Limits.pullback.fst V.hom iY).base.hom z)) * h2

  have hK : Limits.kernel.ι (wcSuppUnitMap EY) ≫ (wcSuppUnitMap E₁ ≫
      (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i₁) _ _
        E₁.cont E₁.φ).map (wcSuppUnitMap EY')) = 0 := by
    apply SheafOfModules.hom_ext
    apply PresheafOfModules.hom_ext
    intro W
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro p
    induction W using Opposite.rec with
    | op V =>
    change ((wcSuppUnitMap EY').val.app (Opposite.op ((wcProEtBC i₁).obj V))).hom
      (((wcSuppUnitMap E₁).val.app (Opposite.op V)).hom
        (((Limits.kernel.ι (wcSuppUnitMap EY)).val.app (Opposite.op V)).hom p)) = 0
    have htw1 := wc_supp_hom_twist_formula E₁ hE₁ (wcSuppUnitMap E₁) V
