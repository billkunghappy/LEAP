    (halg' : letI := φ'.toAlgebra; Algebra.IsAlgebraic A' L')
    {Xm : Scheme.{u}} {f : Xm ⟶ Spec (.of A')}
    {bl : Xm ⟶ Limits.pullback (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))}
    (hbl : wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range
      (fun i : Option (Fin n) => Option.elim i
        ((Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of A')).inv.hom π'))
        (fun j => ((Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))) ≫ a₀).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A n π c))).inv.hom
            (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X j)))))))) bl)
    (hblf : bl ≫ Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA)) = f)
    {XE' : Scheme.{u}} {p' : XE' ⟶ Xm} {q' : XE' ⟶ Spec (.of L')}
    (hpb' : IsPullback p' q' f (Spec.map (CommRingCat.ofHom φ')))
    {Xs' : Scheme.{u}} {ι' : Xs' ⟶ Xm} {s' : Xs' ⟶ Spec (.of (IsLocalRing.ResidueField A'))}
    (hps' : IsPullback ι' s' f (wcQmSp A'))
    {βs : Xs' ⟶ Xs}
    (hβ : βs ≫ ι = ι' ≫ bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA)))
    (Dβ : wcHMPullData βs ℓ) (hDβ : wcHMPullCanonical Dβ)
    [EnoughInjectives (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))]
    (Dp' : wcHMPullData p' ℓ) (hDp' : wcHMPullCanonical Dp')
    (Di' : wcHMPullData ι' ℓ) (hDi' : wcHMPullCanonical Di')
    (I' : InjectiveResolution (SheafOfModules.unit (wcRingSheaf XE' ℓ)))
    {Z₁ Z₂ : Scheme.{u}} (i₁ : Z₁ ⟶ Xs') (i₂ : Z₂ ⟶ Xs')
    [IsClosedImmersion i₁] [IsClosedImmersion i₂]
    (h₁ : Set.range i₁ = closure ((fun z => (ι' ≫ bl ≫ Limits.pullback.fst
      (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))) z) ⁻¹'
        {IsLocalRing.closedPoint B₀})ᶜ)
    (h₂ : Set.range i₂ = (fun z => (ι' ≫ bl ≫ Limits.pullback.fst
      (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))) z) ⁻¹'
        {IsLocalRing.closedPoint B₀})
    (E₁ : wcHMPullData i₁ ℓ) (hE₁ : wcHMPullCanonical E₁)
    (E₂ : wcHMPullData i₂ ℓ) (hE₂ : wcHMPullCanonical E₂) :
    letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))
    ∀ T₀ T : (DerivedCategory.singleFunctor (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))
        ((n : ℤ) - 1)).obj (wcSuppObj E₂) ⟶
        (DerivedCategory.singleFunctor (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)) 1).obj
          (wcSuppObj E₁),
      T₀ ≠ 0 →
      ∃ e : (DerivedCategory.singleFunctor (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))
          ((n : ℤ) - 1)).obj (wcSuppObj E₂) ⟶
          (DerivedCategory.singleFunctor (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))
            ((n : ℤ) - 1)).obj (wcSuppObj E₂),
        T = e ≫ T₀ :=
by
  letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))
  intro T₀ T hT₀
  obtain ⟨Z2s, hZ2s⟩ : ∃ Z : Set Xs', Z = (fun z => (ι' ≫ bl ≫ Limits.pullback.fst
      (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))) z) ⁻¹'
        {IsLocalRing.closedPoint B₀} := ⟨_, rfl⟩
  have hZc : IsClosed Z2s := by
    rw [hZ2s]
    exact (IsLocalRing.isClosed_singleton_closedPoint B₀).preimage
      (Scheme.Hom.continuous (ι' ≫ bl ≫ Limits.pullback.fst
        (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))))
  obtain ⟨ZY, iY, hiY, hrY⟩ : ∃ (Z : Scheme.{u}) (i : Z ⟶ Xs'), IsClosedImmersion i ∧
      Set.range i = closure Z2sᶜ ∩ Z2s :=
    ⟨_, (Scheme.IdealSheafData.vanishingIdeal
      (⟨_, isClosed_closure.inter hZc⟩ : TopologicalSpace.Closeds Xs')).subschemeι, inferInstance,
      (Scheme.IdealSheafData.range_subschemeι _).trans
        (Scheme.IdealSheafData.coe_support_vanishingIdeal _)⟩
  haveI := hiY
  obtain ⟨EY, hEY⟩ := wc_hm_pull_data_exists iY ℓ
  have hcover : Set.range i₁ ∪ Set.range i₂ = Set.univ := by
    rw [h₁, h₂, ← hZ2s]
    apply Set.eq_univ_of_forall
    intro x
    by_cases hx : x ∈ Z2s
    · exact Or.inr hx
    · exact Or.inl (subset_closure hx)
  have hinter : Set.range iY = Set.range i₁ ∩ Set.range i₂ := by
    rw [hrY, h₁, h₂, hZ2s]
  have hY : Set.range iY = closure ((fun z => (ι' ≫ bl ≫ Limits.pullback.fst
      (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))) z) ⁻¹'
        {IsLocalRing.closedPoint B₀})ᶜ ∩ (fun z => (ι' ≫ bl ≫ Limits.pullback.fst
      (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))) z) ⁻¹'
        {IsLocalRing.closedPoint B₀} := by
    rw [hrY, hZ2s]
  obtain ⟨ρ₁, ρ₂, hz, hS⟩ := wc_qmbt_hl_mv_closed_cover i₁ i₂ iY ℓ hcover hinter
    E₁ hE₁ E₂ hE₂ EY hEY
  obtain ⟨TY, hTY⟩ := wc_qmbt_xsp_ess_D1l_Ysupp_lift_ne_zero hℓ hn hn4 hπ hc hx₀ hsh hps hℓ'
    hπ' hπ'2 hgen hφ' halg' hbl hblf hpb' hps' hβ Dβ hDβ Dp' hDp' Di' hDi' I' i₁ i₂ iY h₁ h₂ hY
    E₁ hE₁ E₂ hE₂ EY hEY ρ₁ ρ₂ hz hS
  have hgen' := wc_qmbt_xsp_ess_D1l_thom_generates hℓ hn hn4 hπ hc hx₀ hsh hps hℓ'
    hπ' hπ'2 hgen hφ' halg' hbl hblf hpb' hps' hβ Dβ hDβ Dp' hDp' Di' hDi' I' i₁ i₂ iY h₁ h₂ hY
    E₁ hE₁ E₂ hE₂ EY hEY ρ₁ ρ₂ hz hS _ hTY
  obtain ⟨x₀', hT0x⟩ := hgen' T₀
  obtain ⟨x, hx⟩ := hgen' T
  have hne : x₀' ≠ 0 := fun h => hT₀ (by rw [hT0x, h, Limits.zero_comp])
  obtain ⟨e, he⟩ := wc_qmbt_xsp_ess_Y_low_ext_cyclic hℓ hn hn4 hπ hc hx₀ hsh hps hℓ'
    hπ' hπ'2 hgen hφ' halg' hbl hblf hpb' hps' hβ Dβ hDβ Dp' hDp' Di' hDi' I' i₂ iY h₂ hY
    E₂ hE₂ EY hEY x₀' x hne
  exact ⟨e, by rw [hx, he, hT0x, Category.assoc]⟩

theorem wc_supp_ker_cross_ext_vanish {S Z₁ Z₂ : Scheme.{u}} (i₁ : Z₁ ⟶ S) (i₂ : Z₂ ⟶ S)
    [IsClosedImmersion i₁] [IsClosedImmersion i₂] [IsLocallyNoetherian S] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    [EnoughInjectives (SheafOfModules.{u+1} (wcRingSheaf S ℓ))]
    (hcover : Set.range i₁ ∪ Set.range i₂ = Set.univ)
    (E₁ : wcHMPullData i₁ ℓ) (hE₁ : wcHMPullCanonical E₁)
    (E₂ : wcHMPullData i₂ ℓ) (hE₂ : wcHMPullCanonical E₂) :
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
    ∀ (q : ℕ) (x : Abelian.Ext (Limits.kernel (wcSuppUnitMap E₂))
      (Limits.kernel (wcSuppUnitMap E₁)) q), x = 0 :=
by
  classical
  letI instS : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
  intro q x

  obtain ⟨Wo, hW⟩ : ∃ Wo : S.Opens, (Wo : Set ↥S) = (Set.range i₂)ᶜ :=
    ⟨⟨(Set.range i₂)ᶜ, i₂.isClosedEmbedding.isClosed_range.isOpen_compl⟩, rfl⟩
  obtain ⟨Dw, hDw⟩ := wc_hm_pull_data_exists Wo.ι ℓ
  letI instW : HasExt (SheafOfModules.{u+1} (wcRingSheaf Wo.toScheme ℓ)) := HasExt.standard _
  haveI := Dw.additive
  haveI := Dw.presLim
  haveI := Dw.presColim
  have hsub : (Wo : Set ↥S) ⊆ Set.range i₁ := by
    intro p hp
    rw [hW] at hp
    have hp' : p ∈ Set.range i₁ ∪ Set.range i₂ := by rw [hcover]; trivial
    exact hp'.resolve_right hp
  let Vo : S.ProEt := Scheme.ProEt.mk Wo.ι
  haveI hVo : IsOpenImmersion Vo.hom := (inferInstance : IsOpenImmersion Wo.ι)
  haveI hG : (wcSliceFunctor S Vo).IsContinuous (Scheme.ProEt.topology Vo.left)
      (Scheme.ProEt.topology S) := by
    haveI h1' := (wc_slice_over_sites_cont S Vo).1
    haveI h0 : (Over.forget Vo).IsContinuous ((Scheme.ProEt.topology S).over Vo)
        (Scheme.ProEt.topology S) := inferInstance
    have h3 : (wcSliceToOver S Vo ⋙ Over.forget Vo).IsContinuous (Scheme.ProEt.topology Vo.left)
        (Scheme.ProEt.topology S) :=
      Functor.isContinuous_comp _ _ _ ((Scheme.ProEt.topology S).over Vo) _
    exact h3
  have hVorange : Set.range Vo.hom = (Set.range i₂)ᶜ := by
    show Set.range Wo.ι = _
    rw [Scheme.Opens.range_ι, hW]
  obtain ⟨Φiso⟩ := wc_hm_pull_Phi_slice_iso S ℓ Vo Dw hDw

  have hsec : ∀ (T : S.ProEt), (∀ y : ↥T.left, T.hom y ∈ Set.range i₁) →
      ∀ k : (Limits.kernel (wcSuppUnitMap E₁)).val.obj (Opposite.op T), k = 0 := by
    intro T hT k
    let t : C(↥T.left, ULift.{u+1} ℚ_[ℓ]) :=
      ((Limits.kernel.ι (wcSuppUnitMap E₁)).val.app (Opposite.op T)).hom k
    have hk0 : ((wcSuppUnitMap E₁).val.app (Opposite.op T)).hom t = 0 := by
      have hk := congrArg (fun φ => (φ.val.app (Opposite.op T)).hom k)
        (Limits.kernel.condition (wcSuppUnitMap E₁))
      change ((wcSuppUnitMap E₁).val.app (Opposite.op T)).hom
        (((Limits.kernel.ι (wcSuppUnitMap E₁)).val.app (Opposite.op T)).hom k) = 0 at hk
      exact hk
    have vanish : ∀ y : ↥T.left, t y = 0 := by
      intro y
      have hy' : y ∈ Set.range (Limits.pullback.fst T.hom i₁) := by
        rw [Scheme.Pullback.range_fst]; exact hT y
      obtain ⟨z, rfl⟩ := hy'
      obtain ⟨c', hc'⟩ := wc_supp_unit_twist_isUnit E₁
      have htw := wc_supp_hom_twist_formula E₁ hE₁ (wcSuppUnitMap E₁) T t
      rw [hk0] at htw
      have h1 := congrArg
        (fun φ : C(↥(Limits.pullback T.hom i₁), ULift.{u+1} ℚ_[ℓ]) => φ z) htw
      have h2 := congrArg (fun φ : C(↥Z₁, ULift.{u+1} ℚ_[ℓ]) =>
        φ ((Limits.pullback.snd T.hom i₁).base.hom z)) hc'
      simp only [ContinuousMap.mul_apply, ContinuousMap.comp_apply,
        ContinuousMap.one_apply] at h1 h2
      have h1' : (0 : ULift.{u+1} ℚ_[ℓ]) =
          t ((Limits.pullback.fst T.hom i₁).base.hom z) *
            (wcSuppTwist (wcSuppUnitMap E₁)) ((Limits.pullback.snd T.hom i₁).base.hom z) := h1
      show t ((Limits.pullback.fst T.hom i₁).base.hom z) = 0
      linear_combination (-(c' ((Limits.pullback.snd T.hom i₁).base.hom z))) * h1' -
        (t ((Limits.pullback.fst T.hom i₁).base.hom z)) * h2
    have ht0 : t = 0 := by
      ext y
      exact congrArg ULift.down (vanish y)
    let G := SheafOfModules.forget (wcRingSheaf S ℓ) ⋙
      PresheafOfModules.evaluation _ (Opposite.op T)
    have hmono : Mono (G.map (Limits.kernel.ι (wcSuppUnitMap E₁))) := Functor.map_mono G _
    have hinj := (ModuleCat.mono_iff_injective _).mp hmono
    apply hinj
    refine Eq.trans ?_ (map_zero _).symm
    change t = 0
    exact ht0
  have hrange : ∀ (U0 : Vo.left.ProEt) (y : ↥((wcSliceFunctor S Vo).obj U0).left),
      ((wcSliceFunctor S Vo).obj U0).hom y ∈ Set.range i₁ := by
    intro U0 y
    apply hsub
    have hmem : ∀ z : ↥(Wo : Scheme.{u}), Wo.ι z ∈ (Wo : Set ↥S) := by
      intro z
      rw [← Scheme.Opens.range_ι]
      exact ⟨z, rfl⟩
    show (U0.hom ≫ Wo.ι) y ∈ (Wo : Set ↥S)
    exact hmem (U0.hom y)
  have hZR : Limits.IsZero ((wcSliceRes S ℓ Vo).obj (Limits.kernel (wcSuppUnitMap E₁))) := by
    rw [Limits.IsZero.iff_id_eq_zero]
    apply SheafOfModules.hom_ext
    apply PresheafOfModules.hom_ext
    intro U0
    ext m
    have hm : m = 0 := hsec ((wcSliceFunctor S Vo).obj U0.unop) (hrange U0.unop) m
    rw [hm]
    simp
  have hZ : Limits.IsZero (Dw.Φ.obj (Limits.kernel (wcSuppUnitMap E₁))) :=
    hZR.of_iso (Φiso.app _)

  have hker := fun U k W g hW => wc_supp_kernel_section_local_cover i₂ E₂ hE₂ U k W g hW
  have fin_covers : ∀ (U : S.ProEt) [QuasiSeparatedSpace U.left] (n : ℕ) (W : Fin n → S.ProEt)
      (h : ∀ i, W i ⟶ U), (∀ i, IsAffine (W i).left) →
      (∀ x : U.left, ∃ i, x ∈ Set.range (h i).left) →
      Sieve.generate (Presieve.ofArrows W h) ∈ Scheme.ProEt.topology S U := by
    intro U _ n W h hA hJ
    have hs : ∀ x : U.left, ∃ j y, (h j).left y = x := by
      intro x
      obtain ⟨j, y, hy⟩ := hJ x
      exact ⟨j, y, hy⟩
    have hq : ∀ i, QuasiCompact (h i).left := fun i => by
      haveI := hA i
      exact quasiCompact_of_compactSpace _
    have hw : ∀ i, WeaklyEtale (h i).left := fun i => by
      have h1 : WeaklyEtale ((h i).left ≫ U.hom) := by
        rw [MorphismProperty.Over.w (h i)]
        exact (W i).prop
      haveI := U.prop
      exact @WeaklyEtale.of_comp _ _ _ (h i).left U.hom h1 U.prop
    have H : Presieve.ofArrows (fun i => (W i).left) (fun i => (h i).left) ∈
        Scheme.proetalePrecoverage.coverings U.left :=
      ⟨Scheme.presieve₀_mem_qcPrecoverage_iff.mpr (@QuasiCompactCover.of_finite _ _
        (Scheme.Cover.mkOfCovers (P := ⊤) (Fin n) (fun i => (W i).left) (fun i => (h i).left)
          hs (fun _ => trivial)) _ hq
          (inferInstanceAs (Finite (Fin n)))),
        (Scheme.ofArrows_mem_precoverage_iff @WeaklyEtale).mpr
          ⟨fun x => by obtain ⟨j, y, hy⟩ := hs x; exact ⟨j, y, hy⟩, hw⟩⟩
    exact Precoverage.generate_mem_toGrothendieck
      (Precoverage.mem_comap_iff.mpr (by rw [Presieve.map_ofArrows]; exact H))
  have affine_local : ∀ (U : S.ProEt) (T' : Sieve U),
      (∀ (V' : S.ProEt) (f : V' ⟶ U), IsAffine V'.left →
        T'.pullback f ∈ Scheme.ProEt.topology S V') →
      T' ∈ Scheme.ProEt.topology S U := by
    intro U T' hT
    have hU : WeaklyEtale U.hom := U.prop
    let W : U.left.affineCover.I₀ → S.ProEt := fun i =>
      MorphismProperty.Over.mk ⊤ (U.left.affineCover.f i ≫ U.hom) inferInstance
    let e : ∀ i, W i ⟶ U := fun i =>
      MorphismProperty.Over.homMk (U.left.affineCover.f i) rfl trivial
    have hP : Presieve.ofArrows W e ∈ (Scheme.ProEt.precoverage S).coverings U := by
      show _ ∈ (Precoverage.comap (Scheme.ProEt.forget S ⋙ Over.forget S)
        Scheme.proetalePrecoverage).coverings U
      rw [Precoverage.mem_comap_iff, Presieve.map_ofArrows]
      change U.left.affineCover.presieve₀ ∈ Scheme.proetalePrecoverage.coverings U.left
      exact ⟨Scheme.zariskiPrecoverage_le_qcPrecoverage U.left U.left.affineCover.mem₀,
        U.left.affineCover.mem₀.1,
        MorphismProperty.ofArrows_mem_precoverage.mpr (fun i => inferInstance)⟩
    refine GrothendieckTopology.transitive _ (Precoverage.generate_mem_toGrothendieck hP) T' ?_
    intro Y₀ f hf
    obtain ⟨Y', h, g', hg', rfl⟩ := hf
    rcases hg' with ⟨i⟩
    rw [Sieve.pullback_comp]
    exact GrothendieckTopology.pullback_stable _ h
      (hT (W i) (e i) (show IsAffine (U.left.affineCover.X i) by infer_instance))
  have hcov : ∀ (U : S.ProEt) (k : (Limits.kernel (wcSuppUnitMap E₂)).val.obj (Opposite.op U))
      (R : Sieve U), (∀ (U' : S.ProEt) (a : U' ⟶ U),
        ((∀ x : ↥U'.left, U'.hom x ∉ Set.range i₂) ∨
          ((Limits.kernel (wcSuppUnitMap E₂)).val.map a.op).hom k = 0) → R.arrows a) →
      R ∈ Scheme.ProEt.topology S U := by
    intro U k R hR
    apply affine_local U R
    intro W' g hW'
    obtain ⟨n, W'', e, haff, hsurj, hdis⟩ := hker U k W' g hW'
    haveI : IsAffine W'.left := hW'
    refine GrothendieckTopology.superset_covering _ ?_ (fin_covers W' n W'' e haff hsurj)
    rw [Sieve.generate_le_iff]
    rintro _ _ ⟨m⟩
    exact hR _ _ (hdis m)
  have hhom : ∀ N : SheafOfModules.{u+1} (wcRingSheaf S ℓ),
      Function.Bijective (fun φ : Limits.kernel (wcSuppUnitMap E₂) ⟶ N =>
        𝟙 (Dw.Φ.obj (Limits.kernel (wcSuppUnitMap E₂))) ≫ Dw.Φ.map φ) := by
    intro N
    obtain ⟨hinj, hsurj⟩ := wc_supp_kernel_open_res_bijective i₂ E₂ Vo hVorange hcov N
    have e : ∀ φ : Limits.kernel (wcSuppUnitMap E₂) ⟶ N, (wcSliceRes S ℓ Vo).map φ =
        Φiso.inv.app _ ≫ Dw.Φ.map φ ≫ Φiso.hom.app N :=
      fun φ => (NatIso.naturality_1 Φiso φ).symm
    refine ⟨fun φ₁ φ₂ h => hinj ?_, fun g => ?_⟩
    · have h' : Dw.Φ.map φ₁ = Dw.Φ.map φ₂ := by
        simpa only [Category.id_comp] using h
      show (wcSliceRes S ℓ Vo).map φ₁ = (wcSliceRes S ℓ Vo).map φ₂
      rw [e, e, h']
    · obtain ⟨φ, hφ⟩ := hsurj (Φiso.inv.app _ ≫ g ≫ Φiso.hom.app N)
      refine ⟨φ, ?_⟩
      have hφ' : (wcSliceRes S ℓ Vo).map φ = Φiso.inv.app _ ≫ g ≫ Φiso.hom.app N := hφ
      have k0 := (e φ).symm.trans hφ'
      have k : Dw.Φ.map φ = g :=
        (cancel_mono (Φiso.hom.app N)).mp ((cancel_epi (Φiso.inv.app _)).mp k0)
      show 𝟙 _ ≫ Dw.Φ.map φ = g
      rw [k, Category.id_comp]
  have hvan : ∀ (I : SheafOfModules.{u+1} (wcRingSheaf S ℓ)) [Injective I] (k : ℕ)
      (e : Abelian.Ext (Dw.Φ.obj (Limits.kernel (wcSuppUnitMap E₂))) (Dw.Φ.obj I) (k + 1)),
      e = 0 := by
    intro I hI k e
    have hRI : Injective ((wcSliceRes S ℓ Vo).obj I) :=
      @wc_open_slice_res_preserves_injective S ℓ _ Vo hVo hG I hI
    haveI : Injective (Dw.Φ.obj I) := Injective.of_iso (Φiso.app I).symm hRI
    exact Abelian.Ext.eq_zero_of_injective e
  have hT := ext_transfer_of_corep Dw.Φ (Limits.kernel (wcSuppUnitMap E₂))
    (Dw.Φ.obj (Limits.kernel (wcSuppUnitMap E₂))) (𝟙 _) hhom hvan
    (Limits.kernel (wcSuppUnitMap E₁)) q

  have hzero : ∀ e : Abelian.Ext (Dw.Φ.obj (Limits.kernel (wcSuppUnitMap E₂)))
      (Dw.Φ.obj (Limits.kernel (wcSuppUnitMap E₁))) q, e = 0 := by
    intro e
    calc e = e.comp (Abelian.Ext.mk₀ (𝟙 (Dw.Φ.obj (Limits.kernel (wcSuppUnitMap E₁)))))
          (add_zero q) := (Abelian.Ext.comp_mk₀_id e).symm
      _ = 0 := by
        rw [(Limits.IsZero.iff_id_eq_zero _).mp hZ, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
  apply hT.1
  exact (hzero _).trans (hzero _).symm

theorem wc_proet_kernel_int_ext_vanish_below_of_zmod (S : Scheme.{u}) (V : S.ProEt) (C : Set S) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (FZ : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
    (ιZ : FZ ⟶ (SheafOfModules.toSheaf.{u+1} (wcIntRingSheaf S ℓ)).obj (SheafOfModules.unit (wcIntRingSheaf S ℓ)))
    (hZm : Mono ιZ)
    (hZ : ∀ (T : S.ProEt) (f : ((SheafOfModules.toSheaf.{u+1} (wcIntRingSheaf S ℓ)).obj (SheafOfModules.unit (wcIntRingSheaf S ℓ))).obj.obj (Opposite.op T)),
      (∃ k, (ιZ.hom.app (Opposite.op T)).hom k = f) ↔
        ∀ z : T.left, T.hom z ∈ C → (show C(↥T.left, ULift.{u+1} ℤ_[ℓ]) from f) z = 0)
    (FK : ℕ → Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
    (ιK : ∀ k, FK k ⟶ (SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf S (ℓ ^ (k + 1)))).obj
      (SheafOfModules.unit (wcZModRingSheaf S (ℓ ^ (k + 1)))))
    (hKm : ∀ k, Mono (ιK k))
    (hK : ∀ (k : ℕ) (T : S.ProEt) (f : ((SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf S (ℓ ^ (k + 1)))).obj
        (SheafOfModules.unit (wcZModRingSheaf S (ℓ ^ (k + 1))))).obj.obj (Opposite.op T)),
      (∃ x, ((ιK k).hom.app (Opposite.op T)).hom x = f) ↔
        ∀ z : T.left, T.hom z ∈ C → (show C(↥T.left, ULift.{u+1} (ZMod (ℓ ^ (k + 1)))) from f) z = 0)
    (M : ℕ) (h : ∀ (k i : ℕ), i < M → ∀ y : Abelian.Ext (wcFreeSheaf S V) (FK k) i, y = 0) :
    ∀ (i : ℕ), i < M → ∀ y : Abelian.Ext (wcFreeSheaf S V) FZ i, y = 0 :=
by
  classical
  haveI := wc_proet_products_exact S
  obtain ⟨r, c, hr, hc, hcs⟩ := wc_vanish_tower_reduction_maps S C ℓ FZ ιZ hZm hZ FK ιK hKm hK
  obtain ⟨hzero, hS⟩ := wc_vanish_tower_shortExact S C ℓ FZ ιZ hZm hZ FK ιK hKm hK r c hr hc hcs
  have hA : ∀ N' : ℕ, N' < M → ∀ x : Abelian.Ext (wcFreeSheaf S V) (∏ᶜ FK) N', x = 0 := by
    intro N' hN' x
    have hprod := wc_ext_prod_bijective (wcFreeSheaf S V) (∏ᶜ FK) FK (Limits.Pi.π FK)
      (Limits.productIsProduct FK) N'
    exact hprod.1 x (fun n => h n N' hN' _)
  intro i hi y
  have w : y.comp (Abelian.Ext.mk₀ (Limits.Pi.lift r)) (add_zero i) = 0 := hA i hi _
  cases i with
  | zero =>
    haveI : Mono (Limits.Pi.lift r) := hS.mono_f
    have e1 : y = Abelian.Ext.mk₀ (Abelian.Ext.homEquiv₀ y) :=
      (Abelian.Ext.mk₀_homEquiv₀_apply y).symm
    rw [e1, Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_eq_zero_iff] at w
    rw [e1, Limits.zero_of_comp_mono (Limits.Pi.lift r) w, Abelian.Ext.mk₀_zero]
  | succ n₀ =>
    obtain ⟨x₃, hx₃⟩ := Abelian.Ext.covariant_sequence_exact₁ (wcFreeSheaf S V) hS y w rfl
    rw [← hx₃, hA n₀ (by omega) x₃, Abelian.Ext.zero_comp]

theorem wc_hm_unit_supp_ker_ext_vanish_of_et {S Z : Scheme.{u}} (i : Z ⟶ S) [IsClosedImmersion i]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] [CompactSpace S] [QuasiSeparatedSpace S]
    (hsep : IsSeparated (Limits.terminal.from S))
    (E : wcHMPullData i ℓ) (hE : wcHMPullCanonical E) (M : ℕ)
    (het : ∀ k j : ℕ, j < M →
      Subsingleton (wcEtExt S (wcEtExtZero S (Set.range i)ᶜ (ℓ ^ (k + 1))) j)) :
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
    ∀ j < M, ∀ x : Abelian.Ext (SheafOfModules.unit (wcRingSheaf S ℓ))
      (Limits.kernel (wcSuppUnitMap E)) j, x = 0 :=
by
  classical
  intro j hj x
  obtain ⟨ιQ, hQm, hQ⟩ := wc_hm_kernel_toSheaf_vanSub i ℓ E hE
  obtain ⟨⟨FZ, ιZ, hZm, hZ⟩, hTor⟩ := wc_proet_vanishing_subsheaf_exists i ℓ
  choose FK ιK hKm hK using fun k' : ℕ => hTor (ℓ ^ (k' + 1))
  haveI hcptT : CompactSpace ↥(Scheme.ProEt.mk (𝟙 S)).left := ‹CompactSpace S›
  haveI hqsT : QuasiSeparatedSpace ↥(Scheme.ProEt.mk (𝟙 S)).left := ‹QuasiSeparatedSpace S›
  haveI hsepT' : IsSeparated (Limits.terminal.from (Scheme.ProEt.mk (𝟙 S)).left) := hsep
  have hC : IsClosed (Set.range i) := i.isClosedEmbedding.isClosed_range
  have hT : ∀ (k' i' : ℕ), i' < M → ∀ z : Abelian.Ext (wcFreeSheaf S
      (Scheme.ProEt.mk (𝟙 S))) (FK k') i', z = 0 := by
    intro k' i' hi z
    obtain ⟨eqv⟩ := wc_proet_vanSub_zmod_ext_equiv_et S
      (Scheme.ProEt.mk (𝟙 S)) (Set.range i) hC (ℓ ^ (k' + 1)) (FK k') (ιK k')
      (hKm k') (hK k') i'
    have hsub := het k' i' hi
    exact eqv.injective (@Subsingleton.elim _ hsub _ _)
  have hI := wc_proet_kernel_int_ext_vanish_below_of_zmod S
    (Scheme.ProEt.mk (𝟙 S)) (Set.range i) ℓ FZ ιZ hZm hZ FK ιK hKm hK M hT
  have hRat := wc_proet_kernel_rat_ext_vanish_of_int_deg S
    (Scheme.ProEt.mk (𝟙 S)) (Set.range i) ℓ _ ιQ hQm hQ FZ ιZ hZm hZ j (hI j hj)
  have hη := wc_hm_unit_ext_vanish_of_free_ext_vanish S ℓ _ j hRat
  have htw := wc_supp_unit_map_twist_factor E hE
  obtain ⟨c', hc'⟩ := wc_supp_unit_twist_isUnit E
  obtain ⟨h1, hmul⟩ := wc_hm_fun_one_mul Z ℓ
  haveI hiso : IsIso (wcHMFun Z ℓ (wcSuppTwist (wcSuppUnitMap E))) :=
    ⟨⟨wcHMFun Z ℓ c', by rw [← hmul, hc', h1], by rw [← hmul, mul_comm, hc', h1]⟩⟩
  haveI hmono : Mono ((@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC i) _ _ E.cont E.φ).map
      (wcHMFun Z ℓ (wcSuppTwist (wcSuppUnitMap E)))) := inferInstance
  let e : Limits.kernel (wcSuppUnitMap E) ≅
      Limits.kernel (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcProEtBC i) _ _
        E.cont E.φ) :=
    Limits.kernelIsoOfEq htw ≪≫ Limits.kernelCompMono
      (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcProEtBC i) _ _ E.cont E.φ)
      ((@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC i) _ _ E.cont E.φ).map
        (wcHMFun Z ℓ (wcSuppTwist (wcSuppUnitMap E))))
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
  have key : x = (x.comp (Abelian.Ext.mk₀ e.hom) (add_zero j)).comp
      (Abelian.Ext.mk₀ e.inv) (add_zero j) := by
    rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, e.hom_inv_id,
      Abelian.Ext.comp_mk₀_id]
  rw [key, hη (x.comp (Abelian.Ext.mk₀ e.hom) (add_zero j)), Abelian.Ext.zero_comp]

theorem wc_affine_open_finite_to_affine_space (K : Type u) [Field K] [IsAlgClosed K]
    (Y : Scheme.{u}) (f : Y ⟶ Spec (.of K)) [IsProper f] (N : ℕ) [SmoothOfRelativeDimension N f]
    (U : Y.Opens) (hU : IsAffineOpen U) :
    ∃ (r : ℕ) (π : (U : Scheme.{u}) ⟶ Spec (.of (MvPolynomial (Fin r) K))), r ≤ N ∧ IsFinite π :=
by
  classical
  let φ : K →+* Γ(Y, U) := (Y.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom.comp
    (f.appTop.hom.comp (Scheme.ΓSpecIso (.of K)).inv.hom)
  have s4 : ∀ (R : CommRingCat.{u}) (g : R ⟶ Γ(Y, U)), g.hom.Finite →
      ∃ π : (U : Scheme.{u}) ⟶ Spec R, IsFinite π := by
    intro R g hg
    haveI : IsFinite (Spec.map g) := (IsFinite.SpecMap_iff g).mpr hg
    exact ⟨hU.isoSpec.hom ≫ Spec.map g, inferInstance⟩
  rcases subsingleton_or_nontrivial Γ(Y, U) with hs | hn
  · let g₀ : MvPolynomial (Fin 0) K →+* Γ(Y, U) := MvPolynomial.eval₂Hom φ (fun _ => 0)
    have hsurj : Function.Surjective g₀ := fun y => ⟨0, Subsingleton.elim _ _⟩
    obtain ⟨π, hπ⟩ := s4 (CommRingCat.of (MvPolynomial (Fin 0) K)) (CommRingCat.ofHom g₀)
      (RingHom.Finite.of_surjective g₀ hsurj)
    exact ⟨0, π, Nat.zero_le _, hπ⟩
  · letI : Algebra K Γ(Y, U) := φ.toAlgebra
    have hft : φ.FiniteType := by
      have h1 : (f.appLE ⊤ U (by simp)).hom.FiniteType :=
        Scheme.Hom.finiteType_appLE f (isAffineOpen_top _) hU _
      have h2 : (Scheme.ΓSpecIso (.of K)).inv.hom.FiniteType :=
        RingHom.FiniteType.of_surjective _ (fun y => ⟨(Scheme.ΓSpecIso (.of K)).hom y, by simp⟩)
      have h3 : φ = (f.appLE ⊤ U (by simp)).hom.comp (Scheme.ΓSpecIso (.of K)).inv.hom := by
        simp only [φ, Scheme.Hom.appLE, Scheme.Hom.appTop, CommRingCat.hom_comp]
        rfl
      rw [h3]
      exact h1.comp h2
    haveI : Algebra.FiniteType K Γ(Y, U) := hft
    have hd : ringKrullDim Γ(Y, U) ≤ (N : WithBot ℕ∞) := by
      have e1 : ringKrullDim Γ(Y, U) = topologicalKrullDim (Spec Γ(Y, U)) :=
        (PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim _).symm
      have e2 : topologicalKrullDim (Spec Γ(Y, U)) ≤ topologicalKrullDim Y :=
        hU.fromSpec.isOpenEmbedding.isInducing.topologicalKrullDim_le
      rw [e1]
      exact e2.trans (wc_smooth_alg_closed_dim_le K Y f N)
    obtain ⟨e, g, heN, -, hg⟩ := wc_ldp_dtc_bd_noether_le K Γ(Y, U) N hd
    obtain ⟨π, hπ⟩ := s4 (CommRingCat.of (MvPolynomial (Fin e) K))
      (CommRingCat.ofHom g.toRingHom) hg
    exact ⟨e, π, heN, hπ⟩

theorem wc_castSucc_pullback_polynomial_iso : ∀ (k : Type u) [Field k] (n : ℕ) (A : Type u) [CommRing A] (a : Spec (.of A) ⟶ Spec (.of (MvPolynomial (Fin n) k))), Nonempty (Limits.pullback (Spec.map (CommRingCat.ofHom (MvPolynomial.rename (R := k) (Fin.castSucc : Fin n → Fin (n + 1))).toRingHom)) a ≅ Spec (.of (Polynomial A))) :=
by
  intro k _ n A _ a
  obtain ⟨φ, rfl⟩ : ∃ φ, Spec.map φ = a := ⟨_, Spec.map_preimage a⟩
  let Ψ : MvPolynomial (Fin (n + 1)) k ≃+* Polynomial (MvPolynomial (Fin n) k) :=
    ((MvPolynomial.renameEquiv k finSuccEquivLast).trans
      (MvPolynomial.optionEquivLeft k (Fin n))).toRingEquiv
  have hΨ : ∀ p : MvPolynomial (Fin n) k,
      Ψ (MvPolynomial.rename (R := k) (Fin.castSucc : Fin n → Fin (n + 1)) p) = Polynomial.C p := by
    intro p
    have h : (Ψ.toRingHom.comp
        (MvPolynomial.rename (R := k) (Fin.castSucc : Fin n → Fin (n + 1))).toRingHom) =
        Polynomial.C := by
      apply MvPolynomial.ringHom_ext
      · intro c
        change (MvPolynomial.optionEquivLeft k (Fin n))
            ((MvPolynomial.renameEquiv k finSuccEquivLast)
              ((MvPolynomial.rename (Fin.castSucc : Fin n → Fin (n + 1))) (MvPolynomial.C c))) =
            Polynomial.C (MvPolynomial.C c)
        rw [MvPolynomial.rename_C, MvPolynomial.renameEquiv_apply, MvPolynomial.rename_C,
          ← MvPolynomial.algebraMap_eq, AlgEquiv.commutes, Polynomial.algebraMap_apply,
          MvPolynomial.algebraMap_eq]
      · intro i
        change (MvPolynomial.optionEquivLeft k (Fin n))
            ((MvPolynomial.renameEquiv k finSuccEquivLast)
              ((MvPolynomial.rename (Fin.castSucc : Fin n → Fin (n + 1))) (MvPolynomial.X i))) =
            Polynomial.C (MvPolynomial.X i)
        rw [MvPolynomial.rename_X, MvPolynomial.renameEquiv_apply, MvPolynomial.rename_X,
          finSuccEquivLast_castSucc, MvPolynomial.optionEquivLeft_X_some]
    exact RingHom.congr_fun h p
  letI : Algebra (MvPolynomial (Fin n) k) A := φ.hom.toAlgebra
  letI : Algebra (Polynomial (MvPolynomial (Fin n) k)) (Polynomial A) :=
    Polynomial.algebra (MvPolynomial (Fin n) k) A
  have P0 := CommRingCat.isPushout_of_isPushout (MvPolynomial (Fin n) k)
    (Polynomial (MvPolynomial (Fin n) k)) A (Polynomial A)
  have P1 := IsPushout.of_iso P0 (Iso.refl _) Ψ.symm.toCommRingCatIso (Iso.refl _) (Iso.refl _)
      (f' := CommRingCat.ofHom
        (MvPolynomial.rename (R := k) (Fin.castSucc : Fin n → Fin (n + 1))).toRingHom)
      (g' := φ)
      (inl' := Ψ.symm.toCommRingCatIso.inv ≫
        CommRingCat.ofHom (algebraMap (Polynomial (MvPolynomial (Fin n) k)) (Polynomial A)))
      (inr' := CommRingCat.ofHom (algebraMap A (Polynomial A)))
      (by
        apply CommRingCat.hom_ext
        apply RingHom.ext
        intro p
        change Ψ.symm (algebraMap _ _ p) = MvPolynomial.rename _ p
        rw [Polynomial.algebraMap_eq, ← hΨ p]
        exact Ψ.symm_apply_apply _)
      (by
        apply CommRingCat.hom_ext
        apply RingHom.ext
        intro x
        rfl)
      (by rw [Iso.refl_hom, Category.comp_id, Iso.hom_inv_id_assoc])
      (by simp)
  exact ⟨(AlgebraicGeometry.isPullback_SpecMap_of_isPushout _ _ _ _ P1).isoPullback.symm⟩

theorem wc_hal_shdata_top_dim_isField : ∀ (k : Type u) [Field k] (n : ℕ) (y : Spec (.of (MvPolynomial (Fin n) k))), (n : WithBot ℕ∞) ≤ topologicalKrullDim ↥(closure ({y} : Set (Spec (.of (MvPolynomial (Fin n) k))))) → ∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (MvPolynomial (Fin n) k))) y)) (Scheme.Etale.forget (Spec (.of (MvPolynomial (Fin n) k))))) (φ : ∀ l, Spec (.of A) ⟶ (W'.obj l).right.left) (a : Spec (.of A) ⟶ Spec (.of (MvPolynomial (Fin n) k))), wcHalShData y A Λ W' φ a → IsField A :=
by
  classical
  intro k _ n y hdim A _ _ _ Λ _ _ W' φ a hsh

  have hbot : y.asIdeal = ⊥ := by
    by_contra hne
    let p : Ideal (MvPolynomial (Fin n) k) := y.asIdeal
    obtain ⟨r, hrp, hr0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hne
    have hsurj : Function.Surjective (Ideal.Quotient.mk p) := Ideal.Quotient.mk_surjective
    have hdrop := ringKrullDim_succ_le_of_surjective (Ideal.Quotient.mk p) hsurj
      (mem_nonZeroDivisors_of_ne_zero hr0) (Ideal.Quotient.eq_zero_iff_mem.mpr hrp)
    have hR : ringKrullDim (MvPolynomial (Fin n) k) = (n : WithBot ℕ∞) := by
      rw [MvPolynomial.ringKrullDim_of_isNoetherianRing, ringKrullDim_eq_zero_of_field, zero_add,
        ENat.card_eq_coe_fintype_card, Fintype.card_fin]
      try rfl
    have hemb := PrimeSpectrum.isClosedEmbedding_comap_of_surjective
      (MvPolynomial (Fin n) k ⧸ p) (Ideal.Quotient.mk p) hsurj
    have hrange : Set.range (PrimeSpectrum.comap (Ideal.Quotient.mk p)) =
        (closure ({y} : Set (Spec (.of (MvPolynomial (Fin n) k)))) : Set (PrimeSpectrum (MvPolynomial (Fin n) k))) := by
      rw [range_comap_of_surjective _ _ hsurj, Ideal.mk_ker]
      exact (PrimeSpectrum.closure_singleton y).symm
    have hdimeq : topologicalKrullDim ↥(closure ({y} : Set (Spec (.of (MvPolynomial (Fin n) k))))) =
        ringKrullDim (MvPolynomial (Fin n) k ⧸ p) := by
      rw [← PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim]
      exact (IsHomeomorph.topologicalKrullDim_eq _
        ((hemb.isEmbedding.toHomeomorph.trans (Homeomorph.setCongr hrange)).isHomeomorph)).symm
    rw [hdimeq] at hdim
    rw [hR] at hdrop
    have h1 : (n : WithBot ℕ∞) + 1 ≤ ringKrullDim (MvPolynomial (Fin n) k ⧸ p) + 1 := by gcongr
    have h2 : ((n + 1 : ℕ) : WithBot ℕ∞) ≤ ((n : ℕ) : WithBot ℕ∞) := by
      have := h1.trans hdrop
      exact_mod_cast this
    have h3 : n + 1 ≤ n := by exact_mod_cast h2
    omega

  have hres : ∀ t : Spec (.of (IsLocalRing.ResidueField A)),
      Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)) t = IsLocalRing.closedPoint A := by
    intro t
    rw [Spec.map_apply]
    apply PrimeSpectrum.ext
    show Ideal.comap (IsLocalRing.residue A) t.asIdeal = IsLocalRing.maximalIdeal A
    rw [@Ideal.eq_bot_of_prime _ _ t.asIdeal t.isPrime, ← RingHom.ker_eq_comap_bot,
      IsLocalRing.ker_residue]
  have hx : a (IsLocalRing.closedPoint A) = y := by
    have hsh' := hsh
    obtain ⟨-, -, -, -, -, e, -, heq⟩ := hsh'
    let ω : ↥(Spec (.of (AlgebraicClosure ((Spec (.of (MvPolynomial (Fin n) k))).residueField y)))) :=
      IsLocalRing.closedPoint _
    have h : (Spec.map (CommRingCat.ofHom e) ≫ Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)) ≫ a) ω =
        (wcEtGeomPt (Spec (.of (MvPolynomial (Fin n) k))) y) ω := by rw [heq]
    rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply, hres] at h
    rw [h]
    simp only [wcEtGeomPt, Scheme.Hom.comp_apply]
    exact Scheme.fromSpecResidueField_apply y _

  have hy : y = genericPoint ↥(Spec (.of (MvPolynomial (Fin n) k))) := by
    rw [genericPoint_eq_bot_of_affine]
    apply PrimeSpectrum.ext
    exact hbot
  have hfield : IsField ((Spec (.of (MvPolynomial (Fin n) k))).presheaf.stalk
      (a (IsLocalRing.closedPoint A))) := by
    rw [hx, hy]
    exact Field.toIsField ((Spec (.of (MvPolynomial (Fin n) k))).functionField)

  have hfac : ∃ a₀ : Spec (.of A) ⟶ Spec ((Spec (.of (MvPolynomial (Fin n) k))).residueField
      (a (IsLocalRing.closedPoint A))),
      a₀ ≫ (Spec (.of (MvPolynomial (Fin n) k))).fromSpecResidueField (a (IsLocalRing.closedPoint A)) = a := by
    have hσ := Scheme.Spec_stalkClosedPointTo_fromSpecStalk a
    haveI : IsIso ((Spec (.of (MvPolynomial (Fin n) k))).residue (a (IsLocalRing.closedPoint A))) := by
      rw [ConcreteCategory.isIso_iff_bijective]
      refine ⟨?_, Scheme.residue_surjective _ _⟩
      rw [injective_iff_map_eq_zero]
      intro s hs
      by_contra hne
      obtain ⟨b, hb⟩ := hfield.mul_inv_cancel hne
      have := congrArg (ConcreteCategory.hom
        ((Spec (.of (MvPolynomial (Fin n) k))).residue (a (IsLocalRing.closedPoint A)))) hb
      rw [map_mul, hs, zero_mul, map_one] at this
      exact zero_ne_one this
    refine ⟨Spec.map (inv ((Spec (.of (MvPolynomial (Fin n) k))).residue
      (a (IsLocalRing.closedPoint A))) ≫ Scheme.stalkClosedPointTo a), ?_⟩
    rw [Scheme.fromSpecResidueField.eq_1, Spec.map_comp, Category.assoc,
      ← Category.assoc (Spec.map (inv _)), ← Spec.map_comp, IsIso.hom_inv_id, Spec.map_id,
      Category.id_comp]
    exact hσ

  have key : ∀ (X : Scheme.{u}) (x : X) (b : Spec (.of A) ⟶ X)
      (b₀ : Spec (.of A) ⟶ Spec (X.residueField x)), b₀ ≫ X.fromSpecResidueField x = b →
      (∀ g : Γ(Limits.pullback (X.fromSpecResidueField x) b, ⊤),
        ∃ s : Γ(Limits.pullback (X.fromSpecResidueField x) b, ⊤), g * g * s = g) →
      ∀ g : A, ∃ s : A, g * g * s = g := by
    intro X x b b₀ hb hv g
    subst hb
    haveI : IsIso (Limits.pullback.snd (X.fromSpecResidueField x) (b₀ ≫ X.fromSpecResidueField x)) :=
      Limits.pullback_snd_iso_of_right_factors_mono b₀ _
    haveI hI : IsIso (Limits.pullback.snd (X.fromSpecResidueField x)
        (b₀ ≫ X.fromSpecResidueField x)).appTop :=
      Scheme.Hom.instIsIsoCommRingCatApp _ ⊤
    let E := ((Scheme.ΓSpecIso (.of A)).symm ≪≫ asIso (Limits.pullback.snd (X.fromSpecResidueField x)
        (b₀ ≫ X.fromSpecResidueField x)).appTop).commRingCatIsoToRingEquiv
    obtain ⟨s, hs⟩ := hv (E g)
    refine ⟨E.symm s, ?_⟩
    apply E.injective
    rw [map_mul, map_mul, RingEquiv.apply_symm_apply]
    exact hs
  obtain ⟨a₀, ha₀⟩ := hfac
  obtain ⟨-, hvnr⟩ := wc_et_shens_point_fibre_vnr (Spec (.of (MvPolynomial (Fin n) k)))
    (a (IsLocalRing.closedPoint A)) y A Λ W' φ a hsh
  have hA := key _ _ a a₀ ha₀ hvnr

  rw [IsLocalRing.isField_iff_maximalIdeal_eq, Submodule.eq_bot_iff]
  intro g hg
  obtain ⟨s, hs⟩ := hA g
  have hu : IsUnit (1 - g * s) := by
    by_contra hnu
    have h1 : 1 - g * s ∈ IsLocalRing.maximalIdeal A := (IsLocalRing.mem_maximalIdeal _).mpr hnu
    have h2 : g * s ∈ IsLocalRing.maximalIdeal A := Ideal.mul_mem_right s _ hg
    have h3 := Ideal.add_mem _ h1 h2
    rw [sub_add_cancel] at h3
    exact (IsLocalRing.maximalIdeal.isMaximal A).ne_top ((Ideal.eq_top_iff_one _).mpr h3)
  have h4 : g * (1 - g * s) = 0 := by rw [mul_sub, mul_one, ← mul_assoc, hs, sub_self]
  exact hu.mul_left_eq_zero.mp h4

theorem wc_et_open_imm_leray_bookkeeping : ∀ {U P : Scheme.{u}} (j : U ⟶ P) [IsOpenImmersion j] [IsAffineHom j] (ℓ N : ℕ), 2 ≤ N → (∀ (F : Sheaf (Scheme.smallEtaleTopology P) AddCommGrpCat.{u+1}), ℓ • 𝟙 F = 0 → ∀ p : ℕ, 3 ≤ p → Subsingleton (wcEtExt P F p)) → (∀ (F : Sheaf (Scheme.smallEtaleTopology P) AddCommGrpCat.{u+1}), (∀ x ∈ Set.range j, Subsingleton ((wcEtStalk P x).obj F)) → ∀ p : ℕ, Subsingleton (wcEtExt P F (p + 1))) → (∀ (x : P) (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt P x)) (Scheme.Etale.forget P)) (φ : ∀ l, Spec (.of B) ⟶ (W'.obj l).right.left) (ax : Spec (.of B) ⟶ P), wcHalShData x B Λ W' φ ax → ∀ (G : Sheaf (Scheme.smallEtaleTopology (Limits.pullback j ax)) AddCommGrpCat.{u+1}), ℓ • 𝟙 G = 0 → ∀ s : ℕ, (x ∈ Set.range j ∧ 1 ≤ s ∨ x ∉ Set.range j ∧ N < s) → Subsingleton (wcEtExt (Limits.pullback j ax) G s)) → ∀ (H : Sheaf (Scheme.smallEtaleTopology U) AddCommGrpCat.{u+1}), ℓ • 𝟙 H = 0 → ∀ q : ℕ, N < q → Subsingleton (wcEtExt U H q) :=
by
  classical
  intro U P j _ _ ℓ N hN h1 h2 h3 H hH q hq
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology U) AddCommGrpCat.{u+1}) := HasExt.standard _
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology P) AddCommGrpCat.{u+1}) := HasExt.standard _
  haveI : EnoughInjectives (Sheaf (Scheme.smallEtaleTopology U) AddCommGrpCat.{u+1}) :=
    wc_et_enough_injectives _
  haveI : EnoughInjectives (Sheaf (Scheme.smallEtaleTopology P) AddCommGrpCat.{u+1}) :=
    wc_et_enough_injectives _
  obtain ⟨Lg, ⟨adjg⟩, hLg, ⟨eg⟩⟩ := wc_et_push_left_adjoint j
  haveI := hLg
  haveI : Lg.IsLeftAdjoint := adjg.isLeftAdjoint
  haveI : Lg.PreservesZeroMorphisms := Functor.preservesZeroMorphisms_of_isLeftAdjoint _
  haveI : Lg.Additive := Functor.additive_of_preserves_binary_products _
  haveI : (wcEtPush j).Additive := Adjunction.right_adjoint_additive adjg
  have hstalk : ∀ (x : P) (s : ℕ), (x ∈ Set.range j ∧ 1 ≤ s ∨ x ∉ Set.range j ∧ N < s) →
      Subsingleton ((wcEtStalk P x).obj
        ((((wcEtPush j).mapHomologicalComplex (ComplexShape.up ℕ)).obj
          (injectiveResolution H).cocomplex).homology s)) := by
    intro x s hs
    obtain ⟨B, _, _, _, Λ, _, _, W', φ, a, e, hInit, hAff, hcomp, ha, hlim, he, heq⟩ :=
      wc_et_geom_strict_henselization x
    have hsh : wcHalShData x B Λ W' φ a := ⟨hInit, hAff, hcomp, ha, hlim, e, he, heq⟩
    obtain ⟨e1⟩ := wc_et_stalk_push_homology j x Λ W' hInit (injectiveResolution H).cocomplex s
    obtain ⟨L, ⟨adj⟩, hL, _⟩ := wc_et_push_left_adjoint (Limits.pullback.fst j a)
    haveI := hL
    obtain ⟨e2⟩ := wc_et_limit_push_homology_affine_gen j B Λ
      (W' ⋙ StructuredArrow.proj (Over.mk (wcEtGeomPt P x)) (Scheme.Etale.forget P)) φ a
      hAff hcomp ha hlim H (injectiveResolution H) L ⟨adj⟩ hL s
    haveI : L.IsLeftAdjoint := adj.isLeftAdjoint
    haveI : L.PreservesZeroMorphisms := Functor.preservesZeroMorphisms_of_isLeftAdjoint _
    haveI : L.Additive := Functor.additive_of_preserves_binary_products _
    have hT : ℓ • 𝟙 (L.obj H) = 0 := by
      rw [← L.map_id, ← Functor.map_nsmul, hH, Functor.map_zero]
    have hfib := h3 x B Λ W' φ a hsh (L.obj H) hT s hs
    exact @Function.Injective.subsingleton _ _ _ (e1.trans e2).injective hfib
  have hLer := wc_leray_ext_vanishing Lg (wcEtPush j) adjg
    ((constantSheaf (Scheme.smallEtaleTopology P) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} ℤ)))
    H (injectiveResolution H) N (by
      intro p b hpb y
      have htors := wc_rightDerived_homology_nsmul_zero (wcEtPush j)
        H (injectiveResolution H) ℓ hH b
      by_cases hb0 : b = 0
      · subst hb0
        have hs := h1 _ htors p (by omega)
        exact @Subsingleton.elim _ hs y (0 : type_of% y)
      by_cases hbN : b ≤ N
      · obtain ⟨p', rfl⟩ : ∃ p', p = p' + 1 := ⟨p - 1, by omega⟩
        have hs := h2 _ (fun x hx => hstalk x b (Or.inl ⟨hx, by omega⟩)) p'
        exact @Subsingleton.elim _ hs y (0 : type_of% y)
      · have hz := wc_et_stalks_zero _ (fun x => by
          by_cases hx : x ∈ Set.range j
          · exact hstalk x b (Or.inl ⟨hx, by omega⟩)
          · exact hstalk x b (Or.inr ⟨hx, by omega⟩))
        calc y = y.comp (Abelian.Ext.mk₀ (𝟙 _)) (add_zero p) := (Abelian.Ext.comp_mk₀_id y).symm
          _ = y.comp (Abelian.Ext.mk₀ 0) (add_zero p) := by rw [hz.eq_of_tgt (𝟙 _) 0]
          _ = 0 := by rw [Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero])
  have hw : ∀ w : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology U)
      AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) H q, w = 0 := by
    intro w
    have hq0 : (Abelian.Ext.mk₀ eg.hom).comp w (zero_add q) = 0 := hLer q hq _
    calc w = (Abelian.Ext.mk₀ (𝟙 _)).comp w (zero_add q) := (Abelian.Ext.mk₀_id_comp w).symm
      _ = ((Abelian.Ext.mk₀ eg.inv).comp (Abelian.Ext.mk₀ eg.hom) (add_zero 0)).comp w
            (zero_add q) := by rw [Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id]
      _ = (Abelian.Ext.mk₀ eg.inv).comp ((Abelian.Ext.mk₀ eg.hom).comp w (zero_add q))
            (zero_add q) := Abelian.Ext.comp_assoc _ _ _ (add_zero 0) (zero_add q) (by omega)
      _ = 0 := by rw [hq0, Abelian.Ext.comp_zero]
  exact ⟨fun w₁ w₂ => (hw w₁).trans (hw w₂).symm⟩

theorem wc_shens_P1_punct_chart_iso : ∀ (A : Type u) [CommRing A] (j c : Spec (.of (Polynomial A)) ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) A) MvPolynomial.gradedAlgebra), IsOpenImmersion j → IsOpenImmersion c → (∀ x, x ∈ Set.range j ∨ x ∈ Set.range c) → IsPullback (Spec.map (CommRingCat.ofHom (Polynomial.eval₂RingHom (algebraMap A (LaurentPolynomial A)) (LaurentPolynomial.T (-1))))) (Spec.map (CommRingCat.ofHom (Polynomial.toLaurent : Polynomial A →+* LaurentPolynomial A))) j c → ∀ (x : @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) A) MvPolynomial.gradedAlgebra), x ∉ Set.range j → ∀ (B : Type u) [CommRing B] [IsLocalRing B] (Λx : Type u) [SmallCategory Λx] [IsCofiltered Λx] (Wx : Λx ⥤ StructuredArrow (Over.mk (wcEtGeomPt _ x)) (Scheme.Etale.forget (@Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) A) MvPolynomial.gradedAlgebra))) (φx : ∀ l, Spec (.of B) ⟶ (Wx.obj l).right.left) (ax : Spec (.of B) ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) A) MvPolynomial.gradedAlgebra), wcHalShData x B Λx Wx φx ax → ∃ β : Polynomial A →+* B, Spec.map (CommRingCat.ofHom β) ≫ c = ax ∧ β Polynomial.X ∈ IsLocalRing.maximalIdeal B ∧ Nonempty (Limits.pullback j ax ≅ Spec (.of (Localization.Away (β Polynomial.X)))) :=
by
  intro A _ j c hj hc hcov hpb x hx B _ _ Λx _ _ Wx φx ax hshx
  obtain ⟨-, -, -, -, -, e, -, he⟩ := hshx
  have hgeom : ∀ z, wcEtGeomPt _ x z = x := by
    intro z
    rw [wcEtGeomPt, Scheme.Hom.comp_apply]
    exact Scheme.fromSpecResidueField_apply x _
  have hres : ∀ z, (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B))) z =
      IsLocalRing.closedPoint B :=
    fun z => IsLocalRing.PrimeSpectrum.comap_residue B z
  have ha : ax (IsLocalRing.closedPoint B) = x := by
    have h1 := congrArg (fun f => f (IsLocalRing.closedPoint (AlgebraicClosure
      ((@Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) A)
        MvPolynomial.gradedAlgebra).residueField x)))) he
    have h1' := (Scheme.Hom.comp_apply _ _ _).symm.trans
      ((Scheme.Hom.comp_apply _ _ _).symm.trans (h1.trans (hgeom _)))
    rw [hres] at h1'
    exact h1'
  have hxc : x ∈ Set.range c := (hcov x).resolve_left hx
  have hrange : Set.range ax ⊆ Set.range c := by
    rintro _ ⟨p, rfl⟩
    have hsp : p ⤳ IsLocalRing.closedPoint B := IsLocalRing.specializes_closedPoint p
    have hsp' : ax p ⤳ ax (IsLocalRing.closedPoint B) := hsp.map ax.continuous
    exact hsp'.mem_open (IsOpenImmersion.isOpen_range c) (ha ▸ hxc)
  obtain ⟨β, hβ⟩ : ∃ β : Polynomial A →+* B, Spec.map (CommRingCat.ofHom β) ≫ c = ax :=
    ⟨(Spec.preimage (IsOpenImmersion.lift c ax hrange)).hom, by
      rw [CommRingCat.ofHom_hom, Spec.map_preimage]; exact IsOpenImmersion.lift_fac c ax hrange⟩
  have hL : algebraMap (Polynomial A) (LaurentPolynomial A) = Polynomial.toLaurent :=
    RingHom.ext fun p => LaurentPolynomial.algebraMap_eq_toLaurent p
  refine ⟨β, hβ, ?_, ?_⟩
  · by_contra hX
    let z : PrimeSpectrum (Polynomial A) := PrimeSpectrum.comap β (IsLocalRing.closedPoint B)
    have hzb : z ∈ PrimeSpectrum.basicOpen (Polynomial.X : Polynomial A) := by
      rw [PrimeSpectrum.mem_basicOpen]; exact hX
    have hrng := PrimeSpectrum.localization_away_comap_range (LaurentPolynomial A)
      (Polynomial.X : Polynomial A)
    obtain ⟨w, hw⟩ : z ∈ Set.range
        (PrimeSpectrum.comap (algebraMap (Polynomial A) (LaurentPolynomial A))) := by
      rw [hrng]; exact hzb
    let w' : Spec (.of (LaurentPolynomial A)) := w
    have hw' : Spec.map (CommRingCat.ofHom (Polynomial.toLaurent : Polynomial A →+* LaurentPolynomial A)) w' =
        Spec.map (CommRingCat.ofHom β) (IsLocalRing.closedPoint B) := by
      rw [← hL]; exact hw
    have e1 : j (Spec.map (CommRingCat.ofHom (Polynomial.eval₂RingHom (algebraMap A (LaurentPolynomial A))
        (LaurentPolynomial.T (-1)))) w') =
        c (Spec.map (CommRingCat.ofHom (Polynomial.toLaurent : Polynomial A →+* LaurentPolynomial A)) w') :=
      (Scheme.Hom.comp_apply _ _ w').symm.trans
        ((congrArg (fun f => f w') hpb.toCommSq.w).trans (Scheme.Hom.comp_apply _ _ w'))
    have e2 : c (Spec.map (CommRingCat.ofHom β) (IsLocalRing.closedPoint B)) =
        ax (IsLocalRing.closedPoint B) :=
      (Scheme.Hom.comp_apply _ _ _).symm.trans
        (congrArg (fun f => f (IsLocalRing.closedPoint B)) hβ)
    exact hx ⟨_, e1.trans ((congrArg (fun p => c p) hw').trans (e2.trans ha))⟩
  · have : IsLocalization (Submonoid.map β (Submonoid.powers (Polynomial.X : Polynomial A)))
        (Localization.Away (β Polynomial.X)) := by
      rw [Submonoid.map_powers]; exact Localization.isLocalization
    have hle : Submonoid.powers (Polynomial.X : Polynomial A) ≤
        Submonoid.comap β (Submonoid.powers (β Polynomial.X)) := by
      rw [Submonoid.powers_le, Submonoid.mem_comap]; exact Submonoid.mem_powers _
    let fm : LaurentPolynomial A →+* Localization.Away (β Polynomial.X) :=
      IsLocalization.map (Localization.Away (β Polynomial.X)) β hle
    have hfm : fm.comp (algebraMap (Polynomial A) (LaurentPolynomial A)) =
        (algebraMap B (Localization.Away (β Polynomial.X))).comp β := IsLocalization.map_comp hle
    have hpo := CommRingCat.isPushout_of_isLocalization β fm hfm
      (Submonoid.powers (Polynomial.X : Polynomial A))
    have sq1 := isPullback_SpecMap_of_isPushout _ _ _ _ hpo
    rw [hL] at sq1
    have sq := sq1.paste_vert hpb.flip
    rw [hβ] at sq
    exact ⟨sq.flip.isoPullback.symm⟩

theorem wc_shens_P1_punct_residue_trdeg_le : ∀ (k : Type u) [Field k] (n : ℕ) (y : Spec (.of (MvPolynomial (Fin n) k))) (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (MvPolynomial (Fin n) k))) y)) (Scheme.Etale.forget (Spec (.of (MvPolynomial (Fin n) k))))) (φ : ∀ l, Spec (.of A) ⟶ (W'.obj l).right.left) (a : Spec (.of A) ⟶ Spec (.of (MvPolynomial (Fin n) k))), wcHalShData y A Λ W' φ a → ∀ (c : Spec (.of (Polynomial A)) ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) A) MvPolynomial.gradedAlgebra), IsOpenImmersion c → ∀ (x : @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) A) MvPolynomial.gradedAlgebra) (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)] (Λx : Type u) [SmallCategory Λx] [IsCofiltered Λx] (Wx : Λx ⥤ StructuredArrow (Over.mk (wcEtGeomPt _ x)) (Scheme.Etale.forget (@Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) A) MvPolynomial.gradedAlgebra))) (φx : ∀ l, Spec (.of B) ⟶ (Wx.obj l).right.left) (ax : Spec (.of B) ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) A) MvPolynomial.gradedAlgebra), wcHalShData x B Λx Wx φx ax → ∀ (β : Polynomial A →+* B), Spec.map (CommRingCat.ofHom β) ≫ c = ax → ∀ (P : Ideal (Localization.Away (β Polynomial.X))), P.IsPrime → letI : Algebra k (Localization.Away (β Polynomial.X) ⧸ P) := ((Ideal.Quotient.mk P).comp ((algebraMap B (Localization.Away (β Polynomial.X))).comp (β.comp (Polynomial.C.comp ((Spec.preimage a).hom.comp (algebraMap k (MvPolynomial (Fin n) k))))))).toAlgebra; Algebra.trdeg k (Localization.Away (β Polynomial.X) ⧸ P) ≤ ((n + 1 : ℕ) : Cardinal) :=
by
  have STEP0 : ∀ (k D E : Type u) [Field k] [CommRing D] [IsDomain D] [CommRing E] [IsDomain E]
      (iD : k →+* D) (iE : k →+* E) (j : D →+* E), j.comp iD = iE → Function.Injective j →
      (∀ e : E, ∃ q : Polynomial D, q ≠ 0 ∧ q.eval₂ j e = 0) →
      @Algebra.trdeg k E _ _ iE.toAlgebra ≤ @Algebra.trdeg k D _ _ iD.toAlgebra := by
    intro k D E _ _ _ _ _ iD iE j hc hj halg
    letI : Algebra k D := iD.toAlgebra
    letI : Algebra k E := iE.toAlgebra
    letI : Algebra D E := j.toAlgebra
    haveI : IsScalarTower k D E :=
      IsScalarTower.of_algebraMap_eq (fun r => (congrArg (fun f => f r) hc).symm)
    haveI : FaithfulSMul k D := (faithfulSMul_iff_algebraMap_injective k D).mpr iD.injective
    haveI : FaithfulSMul D E := (faithfulSMul_iff_algebraMap_injective D E).mpr hj
    haveI : Algebra.IsAlgebraic D E := ⟨fun e => by
      obtain ⟨q, hq, he⟩ := halg e
      exact ⟨q, hq, he⟩⟩
    have h := trdeg_add_eq k D (A := E)
    rw [trdeg_eq_zero (R := D) (A := E), add_zero] at h
    exact h.symm.le
  have STEP1 : ∀ (k D E : Type u) [Field k] [CommRing D] [IsDomain D] [CommRing E] [IsDomain E]
      (iD : k →+* D) (iE : k →+* E) (j : D →+* E) (t : E), j.comp iD = iE → Function.Injective j →
      (∀ e : E, ∃ q : Polynomial D, e = q.eval₂ j t) →
      @Algebra.trdeg k E _ _ iE.toAlgebra ≤ @Algebra.trdeg k D _ _ iD.toAlgebra + 1 := by
    intro k D E _ _ _ _ _ iD iE j t hc hj hgen
    letI : Algebra k D := iD.toAlgebra
    letI : Algebra k E := iE.toAlgebra
    letI : Algebra D E := j.toAlgebra
    haveI : IsScalarTower k D E :=
      IsScalarTower.of_algebraMap_eq (fun r => (congrArg (fun f => f r) hc).symm)
    haveI : FaithfulSMul k D := (faithfulSMul_iff_algebraMap_injective k D).mpr iD.injective
    haveI : FaithfulSMul D E := (faithfulSMul_iff_algebraMap_injective D E).mpr hj
    haveI : Algebra.IsAlgebraic (Algebra.adjoin D ({t} : Set E)) E := ⟨fun e => by
      obtain ⟨q, hq⟩ := hgen e
      have hm : e ∈ Algebra.adjoin D ({t} : Set E) := by
        rw [hq]
        exact Polynomial.aeval_mem_adjoin_singleton D t
      exact isAlgebraic_algebraMap (⟨e, hm⟩ : Algebra.adjoin D ({t} : Set E))⟩
    have h1 : Algebra.trdeg D E ≤ 1 :=
      (Algebra.IsAlgebraic.trdeg_le_cardinalMk D ({t} : Set E)).trans (Cardinal.mk_singleton t).le
    have h := trdeg_add_eq k D (A := E)
    rw [← h]
    exact add_le_add le_rfl h1
  have S7' : ∀ (k : Type u) [Field k] (n : ℕ) (I : Ideal (MvPolynomial (Fin n) k)), I.IsPrime →
      @Algebra.trdeg k (MvPolynomial (Fin n) k ⧸ I) _ _
        ((Ideal.Quotient.mk I).comp (algebraMap k (MvPolynomial (Fin n) k))).toAlgebra ≤
        (n : Cardinal) := by
    intro k _ n I hI
    letI : Algebra k (MvPolynomial (Fin n) k ⧸ I) :=
      ((Ideal.Quotient.mk I).comp (algebraMap k (MvPolynomial (Fin n) k))).toAlgebra
    haveI : IsDomain (MvPolynomial (Fin n) k ⧸ I) := Ideal.Quotient.isDomain I
    have hmem : ∀ p : MvPolynomial (Fin n) k, Ideal.Quotient.mk I p ∈
        Algebra.adjoin k (Set.range (fun i : Fin n => Ideal.Quotient.mk I (MvPolynomial.X i))) := by
      intro p
      induction p using MvPolynomial.induction_on with
      | C a => exact Subalgebra.algebraMap_mem _ a
      | add p q hp hq => rw [map_add]; exact add_mem hp hq
      | mul_X p i hp => rw [map_mul]; exact mul_mem hp (Algebra.subset_adjoin ⟨i, rfl⟩)
    haveI : Algebra.IsAlgebraic (Algebra.adjoin k
        (Set.range (fun i : Fin n => Ideal.Quotient.mk I (MvPolynomial.X i))))
        (MvPolynomial (Fin n) k ⧸ I) := ⟨fun z => by
      obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective z
      exact isAlgebraic_algebraMap (⟨_, hmem p⟩ : Algebra.adjoin k
        (Set.range (fun i : Fin n => Ideal.Quotient.mk I (MvPolynomial.X i))))⟩
    refine (Algebra.IsAlgebraic.trdeg_le_cardinalMk k
      (Set.range (fun i : Fin n => Ideal.Quotient.mk I (MvPolynomial.X i)))).trans ?_
    have := Cardinal.mk_range_le_lift (f := fun i : Fin n => Ideal.Quotient.mk I (MvPolynomial.X i))
    simpa using this
  have S8 : ∀ (B : Type u) [CommRing B] (g : B) (P : Ideal (Localization.Away g)), P.IsPrime →
      ∀ e : Localization.Away g ⧸ P, ∃ q : Polynomial (B ⧸ P.comap (algebraMap B (Localization.Away g))),
        q ≠ 0 ∧ q.eval₂ (Ideal.quotientMap P (algebraMap B (Localization.Away g)) le_rfl) e = 0 := by
    intro B _ g P hP e
    obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective e
    obtain ⟨⟨b, m⟩, hr⟩ := IsLocalization.surj (Submonoid.powers g) r
    refine ⟨Polynomial.C (Ideal.Quotient.mk _ (m : B)) * Polynomial.X -
      Polynomial.C (Ideal.Quotient.mk _ b), ?_, ?_⟩
    · intro h0
      have h1 : (Polynomial.C (Ideal.Quotient.mk (P.comap (algebraMap B (Localization.Away g))) (m : B)) *
          Polynomial.X - Polynomial.C (Ideal.Quotient.mk _ b)).coeff 1 =
          Ideal.Quotient.mk (P.comap (algebraMap B (Localization.Away g))) (m : B) := by
        rw [Polynomial.coeff_sub, Polynomial.coeff_C_mul_X, Polynomial.coeff_C]; simp
      rw [h0, Polynomial.coeff_zero, eq_comm, Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_comap] at h1
      have hu : IsUnit (algebraMap B (Localization.Away g) m) := IsLocalization.map_units _ m
      exact hP.ne_top (Ideal.eq_top_of_isUnit_mem _ h1 hu)
    · simp only [Polynomial.eval₂_sub, Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_X,
