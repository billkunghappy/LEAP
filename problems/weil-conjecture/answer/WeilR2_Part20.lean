    intro Y Z W g h p hp q' A C ρ hρ hZ B I J τ hτ c hc
    subst hp
    haveI := wc_et_basechange_isContinuous g
    haveI := wc_et_enough_injectives Z
    let Kz := InjectiveResolution.of C
    obtain ⟨σ, hσ, hσ0⟩ := wc_et_transport_comparison_exists h I Kz ρ
    have H0 : ∀ (V : W.Etale) (O : Y.Etale) (k : O.left ⟶ V.left)
        (hk : k ≫ V.hom = O.hom ≫ (g ≫ h)) (x : A.obj.obj (Opposite.op V)),
        ((J.cocomplex.d 0 1).hom.app (Opposite.op O)).hom
