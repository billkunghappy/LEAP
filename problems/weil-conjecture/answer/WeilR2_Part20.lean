  have calc3 := wc_qmbt_pmv_supp_calculus Y ℓ
  have hepi := wc_qmbt_pmv_desc_epi_of_cover ℓ jA jB hjs (wcSuppObj D) _ _
    (adjA.counit.app (wcSuppObj D)) (adjB.counit.app (wcSuppObj D))
    (surjA (wcSuppObj D)) (surjB (wcSuppObj D))
  have mA : ∀ (K G : SheafOfModules.{u+1} (wcRingSheaf Y ℓ)) (m : G ⟶ K), Mono m →
      wcPSuppIn Y ℓ (Set.range jA) K → wcPSuppIn Y ℓ (Set.range jA) G :=
    fun K G m hm hK => (calc3 (Set.range jA) (Set.range jA) K G).2.1 m hm hK
  have mB : ∀ (K G : SheafOfModules.{u+1} (wcRingSheaf Y ℓ)) (m : G ⟶ K), Mono m →
      wcPSuppIn Y ℓ (Set.range jB) K → wcPSuppIn Y ℓ (Set.range jB) G :=
    fun K G m hm hK => (calc3 (Set.range jB) (Set.range jB) K G).2.1 m hm hK
  have wA : ∀ K : SheafOfModules.{u+1} (wcRingSheaf Y ℓ),
      wcPSuppIn Y ℓ (Set.range (pA ≫ jA)) K → wcPSuppIn Y ℓ (Set.range jA) K :=
    fun K hK => (calc3 (Set.range (pA ≫ jA)) (Set.range jA) K K).1 hK hRA
  have wB : ∀ K : SheafOfModules.{u+1} (wcRingSheaf Y ℓ),
      wcPSuppIn Y ℓ (Set.range (pA ≫ jA)) K → wcPSuppIn Y ℓ (Set.range jB) K :=
    fun K hK => (calc3 (Set.range (pA ≫ jA)) (Set.range jB) K K).1 hK hRB
  have wAB : ∀ K : SheafOfModules.{u+1} (wcRingSheaf Y ℓ),
      wcPSuppIn Y ℓ (Set.range jA) K → wcPSuppIn Y ℓ (Set.range jB) K →
        wcPSuppIn Y ℓ (Set.range (pA ≫ jA)) K :=
    fun K hKA hKB => (calc3 (Set.range jA ∩ Set.range jB) (Set.range (pA ≫ jA)) K K).1
      ((calc3 (Set.range jA) (Set.range jB) K K).2.2 hKA hKB) hRAB
  obtain ⟨f, w, hS⟩ := wc_abelian_extzero_mv_ses LA EA.Φ LB EB.Φ LP EP.Φ adjA adjB adjP
    (fun K => wcPSuppIn Y ℓ (Set.range jA) K) (fun K => wcPSuppIn Y ℓ (Set.range jB) K)
    (fun K => wcPSuppIn Y ℓ (Set.range (pA ≫ jA)) K)
    monoA monoB monoP suppA suppB suppP epiA epiB epiP mA mB wA wB wAB (wcSuppObj D) hepi
  obtain ⟨u, v, hu, hv, Glue⟩ := wc_abelian_extzero_mv_ext_glue LA EA.Φ LB EB.Φ LP EP.Φ
    adjA adjB adjP
    (fun K => wcPSuppIn Y ℓ (Set.range jA) K) (fun K => wcPSuppIn Y ℓ (Set.range jB) K)
    (fun K => wcPSuppIn Y ℓ (Set.range (pA ≫ jA)) K)
    monoA monoB monoP suppA suppB suppP epiA epiB epiP mA mB wA wB wAB (wcSuppObj D) hepi

  haveI := EA.additive
  haveI := EA.presLim
  haveI := EA.presColim
  haveI := EB.additive
  haveI := EB.presLim
  haveI := EB.presColim
  haveI := EP.additive
  haveI := EP.presLim
  haveI := EP.presColim
  obtain ⟨bijA, formA⟩ := wc_qmbt_pmv_ext_transfer_bij EA.Φ LA adjA pflA (wcSuppObj D)
