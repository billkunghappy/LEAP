  have hτ' : ∀ (n : ℕ) (V : (Spec (.of ↥(Subring.closure (F : Set R)))).Etale)
      (O : (Spec (.of R)).Etale) (k' : O.left ⟶ V.left)
      (hk' : k' ≫ V.hom = O.hom ≫ Spec.map (CommRingCat.ofHom (Subring.closure (F : Set R)).subtype))
      (x : ((I F).cocomplex.X n).obj.obj (Opposite.op V)),
      (τ' (n + 1)).ρ V O k' hk' ((((I F).cocomplex.d n (n + 1)).hom.app (Opposite.op V)).hom x) =
        ((J.cocomplex.d n (n + 1)).hom.app (Opposite.op O)).hom ((τ' n).ρ V O k' hk' x) := by
    intro n V O k' hk' x
    show ((α.f (n + 1)).hom.app (Opposite.op O)).hom ((τ F (n + 1)).ρ V O k' hk' _) =
      ((J.cocomplex.d n (n + 1)).hom.app (Opposite.op O)).hom
        (((α.f n).hom.app (Opposite.op O)).hom ((τ F n).ρ V O k' hk' x))
    rw [hτ F n V O k' hk' x]
    exact (congrArg (fun φ => AddCommGrpCat.Hom.hom (φ.hom.app (Opposite.op O))
      ((τ F n).ρ V O k' hk' x)) (α.comm n (n + 1))).symm

  obtain ⟨C, ρ, hρ⟩ := wc_et_pullback_transport_exists (Spec.map (CommRingCat.ofHom ψ)) (A F)
  have hCt : ℓ • 𝟙 C = 0 := s2 _ (A F) C ρ hρ (hA F)
  have hCq : Subsingleton (wcEtExt (Spec (.of ↥(Algebra.adjoin K (F : Set R)))) C q) :=
    hyp F C hCt q hq

  obtain ⟨b', hb'⟩ := s3 (Spec.map (CommRingCat.ofHom j)) (Spec.map (CommRingCat.ofHom ψ))
    (Spec.map (CommRingCat.ofHom (Subring.closure (F : Set R)).subtype)) hp q (A F) C ρ hρ hCq G
    (I F) J τ' hτ' c hc
  refine ⟨b' + b, ?_⟩
  rw [map_add, hb', hzk]
  congr 1
  show ((α.f q).hom.app _).hom ((τ F q).ρ _ _ _ _ c) = _
  rw [hck]

theorem wc_et_shens_P1_punctured_cd : ∀ (k : Type u) [Field k] (ℓ : ℕ), ℓ.Prime → (ℓ : k) ≠ 0 → ∀ (n : ℕ), (∀ (k' : Type u) [Field k'] (c' : ℕ), (ℓ : k') ≠ 0 → (∀ (F : Sheaf (Scheme.smallEtaleTopology (Spec (.of k'))) AddCommGrpCat.{u+1}), ℓ • 𝟙 F = 0 → ∀ q : ℕ, c' < q → Subsingleton (wcEtExt (Spec (.of k')) F q)) → ∀ r' : ℕ, r' ≤ n → ∀ (G' : Sheaf (Scheme.smallEtaleTopology (Spec (.of (MvPolynomial (Fin r') k')))) AddCommGrpCat.{u+1}), ℓ • 𝟙 G' = 0 → ∀ q : ℕ, r' + c' < q → Subsingleton (wcEtExt (Spec (.of (MvPolynomial (Fin r') k'))) G' q)) → ∀ (y : Spec (.of (MvPolynomial (Fin n) k))) (D : ℕ), (D : WithBot ℕ∞) ≤ topologicalKrullDim ↥(closure ({y} : Set (Spec (.of (MvPolynomial (Fin n) k))))) → ∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (MvPolynomial (Fin n) k))) y)) (Scheme.Etale.forget (Spec (.of (MvPolynomial (Fin n) k))))) (φ : ∀ l, Spec (.of A) ⟶ (W'.obj l).right.left) (a : Spec (.of A) ⟶ Spec (.of (MvPolynomial (Fin n) k))), wcHalShData y A Λ W' φ a → ∀ (j c : Spec (.of (Polynomial A)) ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) A) MvPolynomial.gradedAlgebra), IsOpenImmersion j → IsOpenImmersion c → (∀ x, x ∈ Set.range j ∨ x ∈ Set.range c) → IsPullback (Spec.map (CommRingCat.ofHom (Polynomial.eval₂RingHom (algebraMap A (LaurentPolynomial A)) (LaurentPolynomial.T (-1))))) (Spec.map (CommRingCat.ofHom (Polynomial.toLaurent : Polynomial A →+* LaurentPolynomial A))) j c → ∀ (x : @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) A) MvPolynomial.gradedAlgebra), x ∉ Set.range j → ∀ (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)] (Λx : Type u) [SmallCategory Λx] [IsCofiltered Λx] (Wx : Λx ⥤ StructuredArrow (Over.mk (wcEtGeomPt _ x)) (Scheme.Etale.forget (@Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) A) MvPolynomial.gradedAlgebra))) (φx : ∀ l, Spec (.of B) ⟶ (Wx.obj l).right.left) (ax : Spec (.of B) ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) A) MvPolynomial.gradedAlgebra), wcHalShData x B Λx Wx φx ax → ∀ (G : Sheaf (Scheme.smallEtaleTopology (Limits.pullback j ax)) AddCommGrpCat.{u+1}), ℓ • 𝟙 G = 0 → ∀ s : ℕ, n + 1 < s + D → Subsingleton (wcEtExt (Limits.pullback j ax) G s) :=
by
  classical
  intro k _ ℓ hℓ hℓk n hIH y D hD A _ _ _ Λ _ _ W' φ a hsh j c hj hc hcov hpb x hx B _ _ _ Λx _ _ Wx φx ax hshx G hG s hs

  have hDn : D ≤ n := by
    have h1 := topologicalKrullDim_subspace_le (Spec (.of (MvPolynomial (Fin n) k)))
      (closure ({y} : Set (Spec (.of (MvPolynomial (Fin n) k)))))
    have h2 : topologicalKrullDim (Spec (.of (MvPolynomial (Fin n) k))) = (n : WithBot ℕ∞) := by
      rw [show topologicalKrullDim (Spec (.of (MvPolynomial (Fin n) k))) =
          topologicalKrullDim (PrimeSpectrum (MvPolynomial (Fin n) k)) from rfl,
        PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim,
        MvPolynomial.ringKrullDim_of_isNoetherianRing, ringKrullDim_eq_zero_of_field, zero_add,
        ENat.card_eq_coe_fintype_card, Fintype.card_fin]
      try rfl
    have h3 : (D : WithBot ℕ∞) ≤ (n : WithBot ℕ∞) := hD.trans (h1.trans h2.le)
    exact_mod_cast h3

  have hpushT : ∀ {W Y : Scheme.{u}} (π : W ⟶ Y)
      (H : Sheaf (Scheme.smallEtaleTopology W) AddCommGrpCat.{u+1}),
      ℓ • 𝟙 H = 0 → ℓ • 𝟙 ((wcEtPush π).obj H) = 0 := by
    intro W Y π H hH
    obtain ⟨Le, ⟨adje⟩, hLe, _⟩ := wc_et_push_left_adjoint π
    haveI := hLe
    haveI : Le.IsLeftAdjoint := adje.isLeftAdjoint
    haveI : Le.PreservesZeroMorphisms := Functor.preservesZeroMorphisms_of_isLeftAdjoint _
    haveI : Le.Additive := Functor.additive_of_preserves_binary_products _
    haveI : (wcEtPush π).Additive := Adjunction.right_adjoint_additive adje
    rw [← (wcEtPush π).map_id, ← Functor.map_nsmul, hH, Functor.map_zero]

  obtain ⟨β, hβc, hβX, ⟨e₀⟩⟩ :=
    wc_shens_P1_punct_chart_iso A j c hj hc hcov hpb x hx B Λx Wx φx ax hshx

  obtain ⟨F₀, _, _, ιF, κ, τ, hτ, hcomp⟩ :=
    wc_shens_point_sepclosed_indep_subfield k n y D hD A Λ W' φ a hsh
  have hℓF : (ℓ : F₀) ≠ 0 := fun h => hℓk (κ.injective (by rw [map_natCast, h, map_zero]))
  have hℓK : (ℓ : FractionRing (Polynomial F₀)) ≠ 0 := fun h => hℓF
    ((((algebraMap (Polynomial F₀) (FractionRing (Polynomial F₀))).comp Polynomial.C).injective)
      (by rw [map_natCast, h, map_zero]))

  have hcdK : ∀ (G' : Sheaf (Scheme.smallEtaleTopology (Spec (.of (FractionRing (Polynomial F₀)))))
      AddCommGrpCat.{u+1}), ℓ • 𝟙 G' = 0 → ∀ q : ℕ, 1 < q →
      Subsingleton (wcEtExt (Spec (.of (FractionRing (Polynomial F₀)))) G' q) := by
    intro G' hG' q hq
    have htr : Algebra.trdeg F₀ (FractionRing (Polynomial F₀)) ≤ ((1 : ℕ) : Cardinal) := by
      haveI : FaithfulSMul F₀ (Polynomial F₀) :=
        (faithfulSMul_iff_algebraMap_injective _ _).mpr Polynomial.C_injective
      haveI : FaithfulSMul (Polynomial F₀) (FractionRing (Polynomial F₀)) :=
        (faithfulSMul_iff_algebraMap_injective _ _).mpr (IsFractionRing.injective _ _)
      haveI : Algebra.IsAlgebraic (Polynomial F₀) (FractionRing (Polynomial F₀)) :=
        IsLocalization.isAlgebraic (FractionRing (Polynomial F₀)) (nonZeroDivisors (Polynomial F₀))
      have h1 := trdeg_add_eq F₀ (Polynomial F₀) (A := FractionRing (Polynomial F₀))
      rw [Polynomial.trdeg_of_isDomain, trdeg_eq_zero, add_zero] at h1
      rw [← h1, Nat.cast_one]
    have hz := wc_et_field_cd_le_trdeg F₀ (FractionRing (Polynomial F₀)) ℓ hℓ hℓF 1 htr G' hG' q hq
    exact ⟨fun a b => (hz a).trans (hz b).symm⟩

  have hunitB : ∀ u : Polynomial F₀, u.coeff 0 ≠ 0 →
      IsUnit (Polynomial.eval₂ (β.comp (Polynomial.C.comp ιF)) (β Polynomial.X) u) := by
    intro u hu
    obtain ⟨w, hw⟩ := (Polynomial.X_dvd_sub_C (p := u))
    have h1 : Polynomial.eval₂ (β.comp (Polynomial.C.comp ιF)) (β Polynomial.X) u =
        (β.comp (Polynomial.C.comp ιF)) (u.coeff 0) +
          β Polynomial.X * Polynomial.eval₂ (β.comp (Polynomial.C.comp ιF)) (β Polynomial.X) w := by
      have := congrArg (Polynomial.eval₂ (β.comp (Polynomial.C.comp ιF)) (β Polynomial.X)) hw
      rw [Polynomial.eval₂_sub, Polynomial.eval₂_C, Polynomial.eval₂_mul, Polynomial.eval₂_X] at this
      linear_combination this
    have h2 : IsUnit ((β.comp (Polynomial.C.comp ιF)) (u.coeff 0)) :=
      (isUnit_iff_ne_zero.mpr hu).map _
    by_contra hnu
    have hm : Polynomial.eval₂ (β.comp (Polynomial.C.comp ιF)) (β Polynomial.X) u ∈
        IsLocalRing.maximalIdeal B := (IsLocalRing.mem_maximalIdeal _).mpr hnu
    have hm2 : β Polynomial.X * Polynomial.eval₂ (β.comp (Polynomial.C.comp ιF)) (β Polynomial.X) w ∈
        IsLocalRing.maximalIdeal B := Ideal.mul_mem_right _ _ hβX
    have hm3 : (β.comp (Polynomial.C.comp ιF)) (u.coeff 0) ∈ IsLocalRing.maximalIdeal B := by
      have := Ideal.sub_mem _ hm hm2
      rwa [h1, add_sub_cancel_right] at this
    exact (IsLocalRing.mem_maximalIdeal _).mp hm3 h2
  obtain ⟨σ, hσ⟩ : ∃ σ : Polynomial F₀ →+* Localization.Away (β Polynomial.X), ∀ u, σ u =
      algebraMap B (Localization.Away (β Polynomial.X))
        (Polynomial.eval₂ (β.comp (Polynomial.C.comp ιF)) (β Polynomial.X) u) :=
    ⟨Polynomial.eval₂RingHom ((algebraMap B (Localization.Away (β Polynomial.X))).comp
        (β.comp (Polynomial.C.comp ιF))) (algebraMap B (Localization.Away (β Polynomial.X)) (β Polynomial.X)),
      fun u => by rw [Polynomial.coe_eval₂RingHom, Polynomial.hom_eval₂]⟩
  have hunit : ∀ p : nonZeroDivisors (Polynomial F₀), IsUnit (σ (p : Polynomial F₀)) := by
    rintro ⟨p, hp⟩
    have hp0 : p ≠ 0 := nonZeroDivisors.ne_zero hp
    obtain ⟨u, hpu, hu⟩ := Polynomial.exists_eq_pow_rootMultiplicity_mul_and_not_dvd p hp0 0
    have hu0 : u.coeff 0 ≠ 0 := by
      intro h
      apply hu
      rw [Polynomial.C_0, sub_zero]
      exact Polynomial.X_dvd_iff.mpr h
    show IsUnit (σ p)
    rw [hpu, map_mul, map_pow, Polynomial.C_0, sub_zero, hσ, hσ, Polynomial.eval₂_X]
    exact (IsUnit.pow _ (IsLocalization.Away.algebraMap_isUnit _)).mul ((hunitB u hu0).map _)
  obtain ⟨Φ, hΦ⟩ : ∃ Φ : FractionRing (Polynomial F₀) →+* Localization.Away (β Polynomial.X),
      ∀ p, Φ (algebraMap (Polynomial F₀) (FractionRing (Polynomial F₀)) p) = σ p :=
    ⟨IsLocalization.lift (M := nonZeroDivisors (Polynomial F₀))
        (S := FractionRing (Polynomial F₀)) hunit,
      IsLocalization.lift_eq (M := nonZeroDivisors (Polynomial F₀))
        (S := FractionRing (Polynomial F₀)) hunit⟩
  letI iKR : Algebra (FractionRing (Polynomial F₀)) (Localization.Away (β Polynomial.X)) :=
    Φ.toAlgebra
  letI iF : Algebra k F₀ := κ.toAlgebra
  letI ikK : Algebra k (FractionRing (Polynomial F₀)) :=
    ((algebraMap (Polynomial F₀) (FractionRing (Polynomial F₀))).comp
      (Polynomial.C.comp (algebraMap k F₀))).toAlgebra
  letI ikR : Algebra k (Localization.Away (β Polynomial.X)) :=
    ((algebraMap B (Localization.Away (β Polynomial.X))).comp (β.comp (Polynomial.C.comp
      ((Spec.preimage a).hom.comp (algebraMap k (MvPolynomial (Fin n) k)))))).toAlgebra
  have hST : @IsScalarTower k (FractionRing (Polynomial F₀)) (Localization.Away (β Polynomial.X))
      ikK.toSMul iKR.toSMul ikR.toSMul := by
    refine @IsScalarTower.of_algebraMap_eq k (FractionRing (Polynomial F₀))
      (Localization.Away (β Polynomial.X)) _ _ _ ikK iKR ikR (fun r => ?_)
    show (algebraMap B (Localization.Away (β Polynomial.X)))
        (β (Polynomial.C ((Spec.preimage a).hom (algebraMap k (MvPolynomial (Fin n) k) r)))) =
      Φ (algebraMap (Polynomial F₀) (FractionRing (Polynomial F₀)) (Polynomial.C (κ r)))
    rw [hΦ, hσ, Polynomial.eval₂_C]
    have h := congrArg (fun f : k →+* A => f r) hcomp
    simp only [RingHom.comp_apply] at h
    simp only [RingHom.comp_apply, h]

  have hτ' := wc_ratfunc_alg_indep_snoc k F₀ D τ hτ

  have hpiece : ∀ (Fs : Finset (Localization.Away (β Polynomial.X)))
      (G' : Sheaf (Scheme.smallEtaleTopology (Spec (.of ↥(Algebra.adjoin
        (FractionRing (Polynomial F₀)) (Fs : Set (Localization.Away (β Polynomial.X)))))))
        AddCommGrpCat.{u+1}), ℓ • 𝟙 G' = 0 → ∀ q : ℕ, n - D + 1 < q →
      Subsingleton (wcEtExt (Spec (.of ↥(Algebra.adjoin (FractionRing (Polynomial F₀))
        (Fs : Set (Localization.Away (β Polynomial.X)))))) G' q) := by
    intro Fs G' hG' q hq
    rcases subsingleton_or_nontrivial ↥(Algebra.adjoin (FractionRing (Polynomial F₀))
        (Fs : Set (Localization.Away (β Polynomial.X)))) with hT | hT
    · haveI hfin : IsFinite (Spec.map (CommRingCat.ofHom (algebraMap (FractionRing (Polynomial F₀))
          ↥(Algebra.adjoin (FractionRing (Polynomial F₀))
            (Fs : Set (Localization.Away (β Polynomial.X))))))) := by
        rw [IsFinite.SpecMap_iff, CommRingCat.hom_ofHom]
        exact RingHom.Finite.of_surjective _ (fun z => ⟨0, Subsingleton.elim _ _⟩)
      obtain ⟨E⟩ := wc_et_finite_push_ext_equiv (Spec.map (CommRingCat.ofHom
        (algebraMap (FractionRing (Polynomial F₀)) ↥(Algebra.adjoin (FractionRing (Polynomial F₀))
          (Fs : Set (Localization.Away (β Polynomial.X))))))) G' q
      haveI := hcdK _ (hpushT (Spec.map (CommRingCat.ofHom
        (algebraMap (FractionRing (Polynomial F₀)) ↥(Algebra.adjoin (FractionRing (Polynomial F₀))
          (Fs : Set (Localization.Away (β Polynomial.X))))))) G' hG') q (by omega)
      exact E.symm.injective.subsingleton
    · obtain ⟨e, g', hle, _, hfin⟩ := @wc_ft_subalg_noether_degree_le k
        (FractionRing (Polynomial F₀)) (Localization.Away (β Polynomial.X)) _ _ _ ikK iKR ikR hST
        (D + 1) (n + 1)
        (Fin.snoc (α := fun _ => FractionRing (Polynomial F₀))
          (fun i => algebraMap (Polynomial F₀) (FractionRing (Polynomial F₀)) (Polynomial.C (τ i)))
          (algebraMap (Polynomial F₀) (FractionRing (Polynomial F₀)) Polynomial.X)) hτ'
        (fun P hP => wc_shens_P1_punct_residue_trdeg_le k n y A Λ W' φ a hsh c hc x B Λx Wx φx ax
          hshx β hβc P hP) Fs hT
      haveI : IsFinite (Spec.map (CommRingCat.ofHom g'.toRingHom)) := by
        rw [IsFinite.SpecMap_iff, CommRingCat.hom_ofHom]
        exact hfin
      obtain ⟨E⟩ := wc_et_finite_push_ext_equiv (Spec.map (CommRingCat.ofHom g'.toRingHom)) G' q
      haveI := hIH (FractionRing (Polynomial F₀)) 1 hℓK hcdK e (by omega) _
        (hpushT (Spec.map (CommRingCat.ofHom g'.toRingHom)) G' hG') q (by omega)
      exact E.symm.injective.subsingleton

  have hR := wc_et_adjoin_union_torsion_cd (FractionRing (Polynomial F₀))
    (Localization.Away (β Polynomial.X)) ℓ (n - D + 1) hpiece

  obtain ⟨E⟩ := wc_et_finite_push_ext_equiv e₀.hom G s
  haveI := hR _ (hpushT e₀.hom G hG) s (by omega)
  exact E.symm.injective.subsingleton

theorem wc_et_affine_line_shens_cd (k : Type u) [Field k] (ℓ : ℕ) (hℓ : ℓ.Prime) (hℓk : (ℓ : k) ≠ 0) (n : ℕ)
    (hIH : ∀ (k' : Type u) [Field k'] (c' : ℕ), (ℓ : k') ≠ 0 →
      (∀ (F : Sheaf (Scheme.smallEtaleTopology (Spec (.of k'))) AddCommGrpCat.{u+1}), ℓ • 𝟙 F = 0 →
        ∀ q : ℕ, c' < q → Subsingleton (wcEtExt (Spec (.of k')) F q)) →
      ∀ r' : ℕ, r' ≤ n → ∀ (G' : Sheaf (Scheme.smallEtaleTopology (Spec (.of (MvPolynomial (Fin r') k')))) AddCommGrpCat.{u+1}),
        ℓ • 𝟙 G' = 0 → ∀ q : ℕ, r' + c' < q →
          Subsingleton (wcEtExt (Spec (.of (MvPolynomial (Fin r') k'))) G' q))
    (y : Spec (.of (MvPolynomial (Fin n) k))) (D : ℕ)
    (hD : (D : WithBot ℕ∞) ≤ topologicalKrullDim ↥(closure ({y} : Set (Spec (.of (MvPolynomial (Fin n) k))))))
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ]
    (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (MvPolynomial (Fin n) k))) y))
      (Scheme.Etale.forget (Spec (.of (MvPolynomial (Fin n) k)))))
    (φ : ∀ l, Spec (.of A) ⟶ (W'.obj l).right.left) (a : Spec (.of A) ⟶ Spec (.of (MvPolynomial (Fin n) k)))
    (hsh : wcHalShData y A Λ W' φ a)
    (H : Sheaf (Scheme.smallEtaleTopology (Limits.pullback (Spec.map (CommRingCat.ofHom
      (MvPolynomial.rename (R := k) (Fin.castSucc : Fin n → Fin (n + 1))).toRingHom)) a)) AddCommGrpCat.{u+1})
    (hH : ℓ • 𝟙 H = 0) :
    ∀ q : ℕ, n + 1 < q + D → Subsingleton (wcEtExt (Limits.pullback (Spec.map (CommRingCat.ofHom
      (MvPolynomial.rename (R := k) (Fin.castSucc : Fin n → Fin (n + 1))).toRingHom)) a) H q) :=
by
  classical

  have hDn : D ≤ n := by
    have h1 := topologicalKrullDim_subspace_le (Spec (.of (MvPolynomial (Fin n) k)))
      (closure ({y} : Set (Spec (.of (MvPolynomial (Fin n) k)))))
    have h2 : topologicalKrullDim (Spec (.of (MvPolynomial (Fin n) k))) = (n : WithBot ℕ∞) := by
      rw [show topologicalKrullDim (Spec (.of (MvPolynomial (Fin n) k))) =
          topologicalKrullDim (PrimeSpectrum (MvPolynomial (Fin n) k)) from rfl,
        PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim,
        MvPolynomial.ringKrullDim_of_isNoetherianRing, ringKrullDim_eq_zero_of_field, zero_add,
        ENat.card_eq_coe_fintype_card, Fintype.card_fin]
      try rfl
    have h3 : (D : WithBot ℕ∞) ≤ (n : WithBot ℕ∞) := hD.trans (h1.trans h2.le)
    exact_mod_cast h3

  have hℓA : IsUnit (ℓ : A) := by
    have hu : IsUnit (ℓ : k) := Ne.isUnit hℓk
    have hu2 : IsUnit (ℓ : MvPolynomial (Fin n) k) := by
      have := hu.map (MvPolynomial.C : k →+* MvPolynomial (Fin n) k)
      simpa using this
    have := hu2.map (Spec.preimage a).hom
    simpa using this
  intro q hq

  obtain ⟨e⟩ := wc_castSucc_pullback_polynomial_iso k n A a
  obtain ⟨Le, ⟨adje⟩, hLe, _⟩ := wc_et_push_left_adjoint e.hom
  haveI := hLe
  haveI : Le.IsLeftAdjoint := adje.isLeftAdjoint
  haveI : Le.PreservesZeroMorphisms := Functor.preservesZeroMorphisms_of_isLeftAdjoint _
  haveI : Le.Additive := Functor.additive_of_preserves_binary_products _
  haveI : (wcEtPush e.hom).Additive := Adjunction.right_adjoint_additive adje
  obtain ⟨E⟩ := wc_et_finite_push_ext_equiv e.hom H q
  have hT : ℓ • 𝟙 ((wcEtPush e.hom).obj H) = 0 := by
    rw [← (wcEtPush e.hom).map_id, ← Functor.map_nsmul, hH, Functor.map_zero]
  suffices hsuff : Subsingleton (wcEtExt (Spec (.of (Polynomial A))) ((wcEtPush e.hom).obj H) q) by
    exact E.symm.injective.subsingleton
  generalize (wcEtPush e.hom).obj H = H' at hT ⊢
  rcases Nat.lt_or_ge D n with hlt | hge
  ·
    obtain ⟨j, c, hj, hc, hjA, hcov, hpb⟩ := wc_P1_ring_charts A
    haveI := hj
    haveI := hjA
    refine wc_et_open_imm_leray_bookkeeping j ℓ (n + 1 - D) (by omega)
      (wc_P1_ring_strictly_henselian_cd_two A ℓ hℓ hℓA)
      (wc_P1_ring_section_supported_acyclic A j c hj hc hcov hpb)
      ?_ H' hT q (by omega)
    intro x B _ _ _ Λx _ _ Wx φx ax hshx G hG s hs
    rcases hs with ⟨hx, hs1⟩ | ⟨hx, hsN⟩
    · obtain ⟨s', rfl⟩ : ∃ s', s = s' + 1 := ⟨s - 1, by omega⟩
      exact wc_et_open_imm_shens_pullback_acyclic j x hx B Λx Wx φx ax hshx G s'
    · exact wc_et_shens_P1_punctured_cd k ℓ hℓ hℓk n hIH y D hD A Λ W' φ a hsh j c hj hc hcov
        hpb x hx B Λx Wx φx ax hshx G hG s (by omega)
  ·
    have hDeq : D = n := le_antisymm hDn hge
    have hDn' : (n : WithBot ℕ∞) ≤ topologicalKrullDim
        ↥(closure ({y} : Set (Spec (.of (MvPolynomial (Fin n) k))))) := hDeq ▸ hD
    have hF := wc_hal_shdata_top_dim_isField k n y hDn' A Λ W' φ a hsh
    exact wc_et_sepclosed_field_line_cd_one A hF ℓ hℓ hℓA H' hT q (by omega)

theorem wc_et_affine_space_low_support_cd (k : Type u) [Field k] (ℓ : ℕ) (hℓ : ℓ.Prime) (hℓk : (ℓ : k) ≠ 0) (c : ℕ)
    (hk : ∀ (F : Sheaf (Scheme.smallEtaleTopology (Spec (.of k))) AddCommGrpCat.{u+1}),
      ℓ • 𝟙 F = 0 → ∀ q : ℕ, c < q → Subsingleton (wcEtExt (Spec (.of k)) F q))
    (n : ℕ)
    (hIH : ∀ r' : ℕ, r' ≤ n → ∀ (G' : Sheaf (Scheme.smallEtaleTopology (Spec (.of (MvPolynomial (Fin r') k)))) AddCommGrpCat.{u+1}),
      ℓ • 𝟙 G' = 0 → ∀ q : ℕ, r' + c < q → Subsingleton (wcEtExt (Spec (.of (MvPolynomial (Fin r') k))) G' q))
    (a : ℕ) (H : Sheaf (Scheme.smallEtaleTopology (Spec (.of (MvPolynomial (Fin n) k)))) AddCommGrpCat.{u+1})
    (hH : ℓ • 𝟙 H = 0)
    (hsupp : ∀ y : Spec (.of (MvPolynomial (Fin n) k)),
      ((a + 1 : ℕ) : WithBot ℕ∞) ≤ topologicalKrullDim ↥(closure ({y} : Set (Spec (.of (MvPolynomial (Fin n) k))))) →
      Subsingleton ((wcEtStalk (Spec (.of (MvPolynomial (Fin n) k))) y).obj H)) :
    ∀ p : ℕ, a + c < p → Subsingleton (wcEtExt (Spec (.of (MvPolynomial (Fin n) k))) H p) :=
by
  classical
  intro p hp

  by_cases hna : n ≤ a
  · exact hIH n le_rfl H hH p (by omega)
  push_neg at hna
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology (Spec (.of (MvPolynomial (Fin n) k))))
    AddCommGrpCat.{u+1}) := HasExt.standard _

  haveI hLFT : LocallyOfFiniteType
      (Spec.map (CommRingCat.ofHom (algebraMap k (MvPolynomial (Fin n) k)))) := by
    first
    | infer_instance
    | (rw [HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType), CommRingCat.hom_ofHom]
       exact RingHom.finiteType_algebraMap.mpr inferInstance)
  haveI hQC : QuasiCompact
      (Spec.map (CommRingCat.ofHom (algebraMap k (MvPolynomial (Fin n) k)))) := by
    infer_instance

  have hdim_s : ∀ s : Spec (.of (MvPolynomial (Fin n) k)),
      topologicalKrullDim ↥(closure ({s} : Set (Spec (.of (MvPolynomial (Fin n) k))))) ≤ (a : WithBot ℕ∞) →
      Order.krullDim ↑(PrimeSpectrum.zeroLocus
        (↑(PrimeSpectrum.asIdeal (R := MvPolynomial (Fin n) k) s) : Set (MvPolynomial (Fin n) k)))
        ≤ (a : WithBot ℕ∞) := by
    intro s hs
    rw [← ringKrullDim_quotient, ← PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim]
    have hemb := PrimeSpectrum.isEmbedding_comap_of_surjective _
      (Ideal.Quotient.mk (PrimeSpectrum.asIdeal (R := MvPolynomial (Fin n) k) s))
      Ideal.Quotient.mk_surjective
    have hrng : Set.range (PrimeSpectrum.comap
        (Ideal.Quotient.mk (PrimeSpectrum.asIdeal (R := MvPolynomial (Fin n) k) s))) =
        closure ({s} : Set (Spec (.of (MvPolynomial (Fin n) k)))) := by
      rw [range_comap_of_surjective _ _ Ideal.Quotient.mk_surjective, Ideal.mk_ker]
      exact (PrimeSpectrum.closure_singleton s).symm
    have hmem : ∀ x, PrimeSpectrum.comap
        (Ideal.Quotient.mk (PrimeSpectrum.asIdeal (R := MvPolynomial (Fin n) k) s)) x ∈
        closure ({s} : Set (Spec (.of (MvPolynomial (Fin n) k)))) := by
      intro x
      rw [← hrng]
      exact Set.mem_range_self x
    have hsurj : Function.Surjective (Set.codRestrict _ _ hmem) := by
      rintro ⟨y, hy⟩
      rw [← hrng] at hy
      obtain ⟨x, rfl⟩ := hy
      exact ⟨x, rfl⟩
    rw [IsHomeomorph.topologicalKrullDim_eq _
      ((hemb.codRestrict _ hmem).toHomeomorphOfSurjective hsurj).isHomeomorph]
    exact hs

  have hred := wc_et_finite_generic_support_reduction k (Spec (.of (MvPolynomial (Fin n) k)))
    (Spec.map (CommRingCat.ofHom (algebraMap k (MvPolynomial (Fin n) k)))) (a + c) H ?_
  · exact ⟨fun x y => (hred p hp x).trans (hred p hp y).symm⟩
  intro G' j hj S hS1 hS2 q hq z

  have hG' : ℓ • 𝟙 G' = 0 := by
    have h1 : (ℓ • 𝟙 G') ≫ j = 0 ≫ j := by
      rw [Preadditive.nsmul_comp, Category.id_comp, Limits.zero_comp]
      calc ℓ • j = j ≫ (ℓ • 𝟙 H) := by rw [Preadditive.comp_nsmul, Category.comp_id]
        _ = 0 := by rw [hH, Limits.comp_zero]
    exact (cancel_mono j).mp h1

  have hinj : ∀ y : Spec (.of (MvPolynomial (Fin n) k)),
      Function.Injective ((wcEtStalk (Spec (.of (MvPolynomial (Fin n) k))) y).map j) := by
    intro y
    haveI := (wc_et_stalk_exact (Spec (.of (MvPolynomial (Fin n) k))) y).1
    rw [← AddCommGrpCat.mono_iff_injective]
    exact Functor.map_mono _ j

  have hdimS : ∀ s ∈ S,
      topologicalKrullDim ↥(closure ({s} : Set (Spec (.of (MvPolynomial (Fin n) k))))) ≤ (a : WithBot ℕ∞) := by
    intro s hs
    have h1 : ¬ ((a + 1 : ℕ) : WithBot ℕ∞) ≤
        topologicalKrullDim ↥(closure ({s} : Set (Spec (.of (MvPolynomial (Fin n) k))))) := by
      intro h
      apply hS1 s hs
      haveI := hsupp s h
      exact (hinj s).subsingleton
    rw [not_le] at h1
    generalize topologicalKrullDim ↥(closure ({s} : Set (Spec (.of (MvPolynomial (Fin n) k))))) = d at h1 ⊢
    induction d using WithBot.recBotCoe with
    | bot => exact bot_le
    | coe d =>
      induction d using ENat.recTopCoe with
      | top =>
        exfalso
        rw [← WithBot.coe_natCast, WithBot.coe_lt_coe] at h1
        exact not_top_lt h1
      | coe m =>
        rw [← WithBot.coe_natCast, WithBot.coe_lt_coe, Nat.cast_lt] at h1
        rw [← WithBot.coe_natCast, WithBot.coe_le_coe, Nat.cast_le]
        omega

  by_cases hSe : S = ∅
  · subst hSe
    have hz := wc_et_stalks_zero G' (fun y => by
      by_contra h
      obtain ⟨s, hs, _⟩ := hS2 y h
      simp at hs)
    calc z = z.comp (Abelian.Ext.mk₀ (𝟙 _)) (add_zero q) := (Abelian.Ext.comp_mk₀_id z).symm
      _ = z.comp (Abelian.Ext.mk₀ 0) (add_zero q) := by rw [hz.eq_of_tgt (𝟙 _) 0]
      _ = 0 := by rw [Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
  obtain ⟨s₀, hs₀⟩ := Finset.nonempty_iff_ne_empty.mpr hSe

  obtain ⟨J, hJdef⟩ : ∃ J : Ideal (MvPolynomial (Fin n) k),
      J = S.inf (fun s => PrimeSpectrum.asIdeal (R := MvPolynomial (Fin n) k) s) := ⟨_, rfl⟩
  have hJS : ∀ s ∈ S, J ≤ PrimeSpectrum.asIdeal (R := MvPolynomial (Fin n) k) s := by
    intro s hs
    rw [hJdef]
    exact Finset.inf_le hs
  have hJ : J ≠ ⊤ := by
    intro h
    have h1 := hJS s₀ hs₀
    rw [h, top_le_iff] at h1
    exact (PrimeSpectrum.isPrime (R := MvPolynomial (Fin n) k) s₀).ne_top h1

  have hrange : ∀ y : Spec (.of (MvPolynomial (Fin n) k)),
      (∃ s ∈ S, y ∈ closure ({s} : Set (Spec (.of (MvPolynomial (Fin n) k))))) →
      y ∈ Set.range (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J))) := by
    rintro y ⟨s, hs, hy⟩
    have h1 : PrimeSpectrum.asIdeal (R := MvPolynomial (Fin n) k) s ≤
        PrimeSpectrum.asIdeal (R := MvPolynomial (Fin n) k) y := by
      have h0 := (PrimeSpectrum.le_iff_mem_closure _ _).mpr hy
      first
      | exact h0
      | exact (PrimeSpectrum.asIdeal_le_asIdeal _ _).mpr h0
      | exact PrimeSpectrum.asIdeal_le_asIdeal.mpr h0
    have h2 : J ≤ PrimeSpectrum.asIdeal (R := MvPolynomial (Fin n) k) y :=
      le_trans (hJS s hs) h1
    have h3 : (y : PrimeSpectrum (MvPolynomial (Fin n) k)) ∈
        Set.range (PrimeSpectrum.comap (Ideal.Quotient.mk J)) := by
      rw [range_comap_of_surjective _ _ Ideal.Quotient.mk_surjective, Ideal.mk_ker]
      exact (PrimeSpectrum.mem_zeroLocus _ _).mpr h2
    obtain ⟨x, hx⟩ := h3
    first
    | exact ⟨x, hx⟩
    | exact ⟨x, by rw [← hx]; rfl⟩

  have hdimJ : ringKrullDim (MvPolynomial (Fin n) k ⧸ J) ≤ (a : WithBot ℕ∞) := by
    rw [ringKrullDim_quotient]
    unfold Order.krullDim
    refine iSup_le fun q => ?_
    have hJq : J ≤ (q.head : PrimeSpectrum (MvPolynomial (Fin n) k)).asIdeal :=
      SetLike.coe_subset_coe.mp ((PrimeSpectrum.mem_zeroLocus _ _).mp q.head.2)
    replace hJq := (le_of_eq hJdef.symm).trans hJq
    obtain ⟨s, hs, hsq⟩ := (Ideal.IsPrime.inf_le' (s := S)
      (f := fun s => PrimeSpectrum.asIdeal (R := MvPolynomial (Fin n) k) s)
      (q.head : PrimeSpectrum (MvPolynomial (Fin n) k)).isPrime).mp hJq
    have hmem : ∀ i, (q i : PrimeSpectrum (MvPolynomial (Fin n) k)) ∈ PrimeSpectrum.zeroLocus
        (↑(PrimeSpectrum.asIdeal (R := MvPolynomial (Fin n) k) s) : Set (MvPolynomial (Fin n) k)) := by
      intro i
      rw [PrimeSpectrum.mem_zeroLocus, SetLike.coe_subset_coe]
      have h0 : (q.head : PrimeSpectrum (MvPolynomial (Fin n) k)) ≤ (q i : PrimeSpectrum _) :=
        Subtype.coe_le_coe.mpr (q.strictMono.monotone (Fin.zero_le i))
      have h0' : (q.head : PrimeSpectrum (MvPolynomial (Fin n) k)).asIdeal ≤
          (q i : PrimeSpectrum (MvPolynomial (Fin n) k)).asIdeal := by
        first
        | exact h0
        | exact (PrimeSpectrum.asIdeal_le_asIdeal _ _).mpr h0
        | exact PrimeSpectrum.asIdeal_le_asIdeal.mpr h0
      exact le_trans hsq h0'
    let q' : LTSeries ↑(PrimeSpectrum.zeroLocus
        (↑(PrimeSpectrum.asIdeal (R := MvPolynomial (Fin n) k) s) : Set (MvPolynomial (Fin n) k))) :=
      LTSeries.mk q.length (fun i => ⟨q i, hmem i⟩) (fun i j hij => q.strictMono hij)
    have h1 := Order.LTSeries.length_le_krullDim q'
    exact le_trans h1 (hdim_s s (hdimS s hs))

  haveI hi : IsClosedImmersion (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J))) :=
    IsClosedImmersion.spec_of_surjective _ Ideal.Quotient.mk_surjective
  haveI hiF : IsFinite (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J))) := by
    rw [IsFinite.SpecMap_iff, CommRingCat.hom_ofHom]
    exact RingHom.Finite.of_surjective _ Ideal.Quotient.mk_surjective
  obtain ⟨L, ⟨adj⟩, hL, -⟩ := wc_et_push_left_adjoint
    (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J)))
  haveI := hL
  haveI : L.IsLeftAdjoint := adj.isLeftAdjoint
  haveI : L.PreservesZeroMorphisms := Functor.preservesZeroMorphisms_of_isLeftAdjoint _
  haveI : L.Additive := Functor.additive_of_preserves_binary_products _
  have hvan : ∀ y : Spec (.of (MvPolynomial (Fin n) k)),
      y ∉ Set.range (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J))) →
      Subsingleton ((wcEtStalk (Spec (.of (MvPolynomial (Fin n) k))) y).obj G') := by
    intro y hy
    by_contra h
    exact hy (hrange y (hS2 y h))
  haveI hU : IsIso (adj.unit.app G') :=
    (wc_et_closed_push_adj_isos _ L adj).2 G'
      (fun V s v hv => wc_et_vanish_off_of_stalks G' V s v (hvan _ hv))
  have hM : ℓ • 𝟙 (L.obj G') = 0 := by
    rw [← L.map_id, ← Functor.map_nsmul, hG', Functor.map_zero]
  haveI : Nontrivial (MvPolynomial (Fin n) k ⧸ J) := Ideal.Quotient.nontrivial_iff.mpr hJ
  haveI : Algebra.FiniteType k (MvPolynomial (Fin n) k ⧸ J) :=
    Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ k J) (Ideal.Quotient.mkₐ_surjective k J)
  obtain ⟨e, g, he, -, hgfin⟩ := wc_ldp_dtc_bd_noether_le k (MvPolynomial (Fin n) k ⧸ J) a hdimJ
  haveI hπ : IsFinite (Spec.map (CommRingCat.ofHom
      (g : MvPolynomial (Fin e) k →+* MvPolynomial (Fin n) k ⧸ J))) := by
    rw [IsFinite.SpecMap_iff, CommRingCat.hom_ofHom]
    exact hgfin
  have hP : ℓ • 𝟙 ((wcEtPush (Spec.map (CommRingCat.ofHom
      (g : MvPolynomial (Fin e) k →+* MvPolynomial (Fin n) k ⧸ J)))).obj (L.obj G')) = 0 := by
    rw [← (wcEtPush _).map_id, ← Functor.map_nsmul, hM, Functor.map_zero]
  haveI hPs := hIH e (by omega) _ hP q (by omega)
  obtain ⟨E₁⟩ := wc_et_finite_push_ext_equiv (Spec.map (CommRingCat.ofHom
      (g : MvPolynomial (Fin e) k →+* MvPolynomial (Fin n) k ⧸ J))) (L.obj G') q
  haveI hZs : Subsingleton (wcEtExt (Spec (.of (MvPolynomial (Fin n) k ⧸ J))) (L.obj G') q) :=
    E₁.symm.injective.subsingleton
  obtain ⟨E₂⟩ := wc_et_finite_push_ext_equiv (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J)))
    (L.obj G') q
  have hsub : Subsingleton (wcEtExt (Spec (.of (MvPolynomial (Fin n) k)))
      ((wcEtPush (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J)))).obj (L.obj G')) q) :=
    E₂.injective.subsingleton
  have hw : z.comp (Abelian.Ext.mk₀ (adj.unit.app G')) (add_zero q) = 0 :=
    @Subsingleton.elim _ hsub _ _
  calc z = z.comp (Abelian.Ext.mk₀ (𝟙 _)) (add_zero q) := (Abelian.Ext.comp_mk₀_id z).symm
    _ = z.comp (Abelian.Ext.mk₀ (adj.unit.app G' ≫ inv (adj.unit.app G'))) (add_zero q) := by
        rw [IsIso.hom_inv_id]
    _ = (z.comp (Abelian.Ext.mk₀ (adj.unit.app G')) (add_zero q)).comp
          (Abelian.Ext.mk₀ (inv (adj.unit.app G'))) (add_zero q) := by
        rw [← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.comp_assoc_of_third_deg_zero]
    _ = 0 := by rw [hw, Abelian.Ext.zero_comp]

theorem wc_et_affine_space_torsion_cd (k : Type u) [Field k] (ℓ : ℕ) (hℓ : ℓ.Prime)
    (hℓk : (ℓ : k) ≠ 0) (c : ℕ)
    (hk : ∀ (F : Sheaf (Scheme.smallEtaleTopology (Spec (.of k))) AddCommGrpCat.{u+1}),
      ℓ • 𝟙 F = 0 → ∀ q : ℕ, c < q → Subsingleton (wcEtExt (Spec (.of k)) F q))
    (r : ℕ) (G : Sheaf (Scheme.smallEtaleTopology (Spec (.of (MvPolynomial (Fin r) k)))) AddCommGrpCat.{u+1})
    (hG : ℓ • 𝟙 G = 0) :
    ∀ q : ℕ, r + c < q → Subsingleton (wcEtExt (Spec (.of (MvPolynomial (Fin r) k))) G q) :=
by
  classical
  suffices MAIN : ∀ r : ℕ, ∀ (K : Type u) [Field K] (c' : ℕ), (ℓ : K) ≠ 0 →
      (∀ (F : Sheaf (Scheme.smallEtaleTopology (Spec (.of K))) AddCommGrpCat.{u+1}),
        ℓ • 𝟙 F = 0 → ∀ q : ℕ, c' < q → Subsingleton (wcEtExt (Spec (.of K)) F q)) →
      ∀ (G' : Sheaf (Scheme.smallEtaleTopology (Spec (.of (MvPolynomial (Fin r) K)))) AddCommGrpCat.{u+1}),
        ℓ • 𝟙 G' = 0 → ∀ q : ℕ, r + c' < q →
          Subsingleton (wcEtExt (Spec (.of (MvPolynomial (Fin r) K))) G' q) from
    MAIN r k c hℓk hk G hG
  intro r
  induction r using Nat.strong_induction_on with
  | _ r IH =>
  rcases r with _ | n
  ·
    intro K _ c' _ hK G' hG' q hq
    haveI hfin : IsFinite (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin 0) K)))) := by
      rw [IsFinite.SpecMap_iff, CommRingCat.hom_ofHom]
      exact RingHom.Finite.of_surjective _
        (by rw [MvPolynomial.algebraMap_eq]; exact MvPolynomial.C_surjective (Fin 0))
    obtain ⟨e⟩ := wc_et_finite_push_ext_equiv
      (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin 0) K)))) G' q
    have hT : ℓ • 𝟙 ((wcEtPush (Spec.map (CommRingCat.ofHom
        (algebraMap K (MvPolynomial (Fin 0) K))))).obj G') = 0 := by
      rw [← (wcEtPush _).map_id, ← Functor.map_nsmul, hG', Functor.map_zero]
    haveI := hK _ hT q (by omega)
    exact e.symm.injective.subsingleton
  ·
    intro K _ c' hℓK hK G' hG' q hq
    have IH' : ∀ r' : ℕ, r' ≤ n → ∀ (G'' : Sheaf (Scheme.smallEtaleTopology
        (Spec (.of (MvPolynomial (Fin r') K)))) AddCommGrpCat.{u+1}),
        ℓ • 𝟙 G'' = 0 → ∀ q : ℕ, r' + c' < q →
          Subsingleton (wcEtExt (Spec (.of (MvPolynomial (Fin r') K))) G'' q) :=
      fun r' hr' => IH r' (by omega) K c' hℓK hK
    have hIH4 : ∀ (k' : Type u) [Field k'] (c'' : ℕ), (ℓ : k') ≠ 0 →
        (∀ (F : Sheaf (Scheme.smallEtaleTopology (Spec (.of k'))) AddCommGrpCat.{u+1}), ℓ • 𝟙 F = 0 →
          ∀ q : ℕ, c'' < q → Subsingleton (wcEtExt (Spec (.of k')) F q)) →
        ∀ r' : ℕ, r' ≤ n → ∀ (G'' : Sheaf (Scheme.smallEtaleTopology
          (Spec (.of (MvPolynomial (Fin r') k')))) AddCommGrpCat.{u+1}),
          ℓ • 𝟙 G'' = 0 → ∀ q : ℕ, r' + c'' < q →
            Subsingleton (wcEtExt (Spec (.of (MvPolynomial (Fin r') k'))) G'' q) :=
      fun k' _ c'' h1 h2 r' hr' => IH r' (by omega) k' c'' h1 h2
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology (Spec (.of (MvPolynomial (Fin n) K))))
      AddCommGrpCat.{u+1}) := HasExt.standard _
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology (Spec (.of (MvPolynomial (Fin (n + 1)) K))))
      AddCommGrpCat.{u+1}) := HasExt.standard _
    haveI : EnoughInjectives (Sheaf (Scheme.smallEtaleTopology
      (Spec (.of (MvPolynomial (Fin n) K)))) AddCommGrpCat.{u+1}) := wc_et_enough_injectives _
    haveI : EnoughInjectives (Sheaf (Scheme.smallEtaleTopology
      (Spec (.of (MvPolynomial (Fin (n + 1)) K)))) AddCommGrpCat.{u+1}) := wc_et_enough_injectives _
    obtain ⟨Lg, ⟨adjg⟩, hLg, ⟨eg⟩⟩ := wc_et_push_left_adjoint (Spec.map (CommRingCat.ofHom
      (MvPolynomial.rename (R := K) (Fin.castSucc : Fin n → Fin (n + 1))).toRingHom))
    haveI := hLg
    haveI : Lg.IsLeftAdjoint := adjg.isLeftAdjoint
    haveI : Lg.PreservesZeroMorphisms := Functor.preservesZeroMorphisms_of_isLeftAdjoint _
    haveI : Lg.Additive := Functor.additive_of_preserves_binary_products _
    haveI : (wcEtPush (Spec.map (CommRingCat.ofHom
        (MvPolynomial.rename (R := K) (Fin.castSucc : Fin n → Fin (n + 1))).toRingHom))).Additive :=
      Adjunction.right_adjoint_additive adjg

    have hstalk : ∀ (y : Spec (.of (MvPolynomial (Fin n) K))) (D : ℕ),
        (D : WithBot ℕ∞) ≤ topologicalKrullDim ↥(closure ({y} : Set (Spec (.of (MvPolynomial (Fin n) K))))) →
        ∀ b : ℕ, n + 1 < b + D →
        Subsingleton ((wcEtStalk (Spec (.of (MvPolynomial (Fin n) K))) y).obj
          ((((wcEtPush (Spec.map (CommRingCat.ofHom
            (MvPolynomial.rename (R := K) (Fin.castSucc : Fin n → Fin (n + 1))).toRingHom))).mapHomologicalComplex
              (ComplexShape.up ℕ)).obj (injectiveResolution G').cocomplex).homology b)) := by
      intro y D hD b hbD
      obtain ⟨A, _, _, _, Λ, _, _, W', φ, a, e, hInit, hAff, hcomp, ha, hlim, he, heq⟩ :=
        wc_et_geom_strict_henselization y
      have hsh : wcHalShData y A Λ W' φ a := ⟨hInit, hAff, hcomp, ha, hlim, e, he, heq⟩
      obtain ⟨e1⟩ := wc_et_stalk_push_homology (Spec.map (CommRingCat.ofHom
        (MvPolynomial.rename (R := K) (Fin.castSucc : Fin n → Fin (n + 1))).toRingHom)) y Λ W' hInit
        (injectiveResolution G').cocomplex b
      obtain ⟨L, ⟨adj⟩, hL, _⟩ := wc_et_push_left_adjoint (Limits.pullback.fst (Spec.map
        (CommRingCat.ofHom (MvPolynomial.rename (R := K) (Fin.castSucc : Fin n → Fin (n + 1))).toRingHom)) a)
      haveI := hL
      obtain ⟨e2⟩ := wc_et_limit_push_homology_affine_gen (Spec.map (CommRingCat.ofHom
        (MvPolynomial.rename (R := K) (Fin.castSucc : Fin n → Fin (n + 1))).toRingHom)) A Λ
        (W' ⋙ StructuredArrow.proj (Over.mk (wcEtGeomPt (Spec (.of (MvPolynomial (Fin n) K))) y))
          (Scheme.Etale.forget (Spec (.of (MvPolynomial (Fin n) K))))) φ a hAff hcomp ha hlim
        G' (injectiveResolution G') L ⟨adj⟩ hL b
      haveI : L.IsLeftAdjoint := adj.isLeftAdjoint
      haveI : L.PreservesZeroMorphisms := Functor.preservesZeroMorphisms_of_isLeftAdjoint _
      haveI : L.Additive := Functor.additive_of_preserves_binary_products _
      have hT : ℓ • 𝟙 (L.obj G') = 0 := by
        rw [← L.map_id, ← Functor.map_nsmul, hG', Functor.map_zero]
      have hfib := wc_et_affine_line_shens_cd K ℓ hℓ hℓK n hIH4 y D hD A Λ W' φ a hsh (L.obj G') hT b hbD
      exact @Function.Injective.subsingleton _ _ _ (e1.trans e2).injective hfib
    have h0 : ∀ y : Spec (.of (MvPolynomial (Fin n) K)),
        ((0 : ℕ) : WithBot ℕ∞) ≤ topologicalKrullDim ↥(closure ({y} : Set (Spec (.of (MvPolynomial (Fin n) K))))) := by
      intro y
      haveI : IrreducibleSpace ↥(closure ({y} : Set (Spec (.of (MvPolynomial (Fin n) K))))) :=
        Subtype.irreducibleSpace isIrreducible_singleton.closure
      haveI : Nonempty (TopologicalSpace.IrreducibleCloseds
          ↥(closure ({y} : Set (Spec (.of (MvPolynomial (Fin n) K)))))) :=
        ⟨⟨Set.univ, IrreducibleSpace.isIrreducible_univ _, isClosed_univ⟩⟩
      rw [Nat.cast_zero]
      exact Order.krullDim_nonneg

    have hLer := wc_leray_ext_vanishing Lg (wcEtPush (Spec.map (CommRingCat.ofHom
        (MvPolynomial.rename (R := K) (Fin.castSucc : Fin n → Fin (n + 1))).toRingHom))) adjg
      ((constantSheaf (Scheme.smallEtaleTopology (Spec (.of (MvPolynomial (Fin n) K))))
        AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)))
      G' (injectiveResolution G') (n + 1 + c') (by
        intro p b hpb y
        have htors := wc_rightDerived_homology_nsmul_zero (wcEtPush (Spec.map (CommRingCat.ofHom
          (MvPolynomial.rename (R := K) (Fin.castSucc : Fin n → Fin (n + 1))).toRingHom)))
          G' (injectiveResolution G') ℓ hG' b
        by_cases hb1 : b ≤ 1
        · have hs := IH' n le_rfl _ htors p (by omega)
          exact @Subsingleton.elim _ hs y (0 : type_of% y)
        by_cases hb2 : b ≤ n + 1
        · have hs := wc_et_affine_space_low_support_cd K ℓ hℓ hℓK c' hK n IH' (n + 1 - b) _ htors
            (fun y' hy' => hstalk y' (n + 1 - b + 1) hy' b (by omega)) p (by omega)
          exact @Subsingleton.elim _ hs y (0 : type_of% y)
        · have hz := wc_et_stalks_zero _ (fun y' => hstalk y' 0 (h0 y') b (by omega))
          calc y = y.comp (Abelian.Ext.mk₀ (𝟙 _)) (add_zero p) := (Abelian.Ext.comp_mk₀_id y).symm
            _ = y.comp (Abelian.Ext.mk₀ 0) (add_zero p) := by rw [hz.eq_of_tgt (𝟙 _) 0]
            _ = 0 := by rw [Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero])
    have hw : ∀ w : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology
        (Spec (.of (MvPolynomial (Fin (n + 1)) K)))) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} ℤ))) G' q, w = 0 := by
      intro w
      have hq0 : (Abelian.Ext.mk₀ eg.hom).comp w (zero_add q) = 0 := hLer q (by omega) _
      calc w = (Abelian.Ext.mk₀ (𝟙 _)).comp w (zero_add q) := (Abelian.Ext.mk₀_id_comp w).symm
        _ = ((Abelian.Ext.mk₀ eg.inv).comp (Abelian.Ext.mk₀ eg.hom) (add_zero 0)).comp w
              (zero_add q) := by rw [Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id]
        _ = (Abelian.Ext.mk₀ eg.inv).comp ((Abelian.Ext.mk₀ eg.hom).comp w (zero_add q))
              (zero_add q) := Abelian.Ext.comp_assoc _ _ _ (add_zero 0) (zero_add q) (by omega)
        _ = 0 := by rw [hq0, Abelian.Ext.comp_zero]
    exact ⟨fun w₁ w₂ => (hw w₁).trans (hw w₂).symm⟩

theorem wc_et_affine_open_artin_vanishing (K : Type u) [Field K] [IsAlgClosed K]
    (Y : Scheme.{u}) (f : Y ⟶ Spec (.of K)) [IsProper f] (N : ℕ) [SmoothOfRelativeDimension N f]
    (U : Y.Opens) (hU : IsAffineOpen U) (m : ℕ) (hm : (m : K) ≠ 0) :
    ∀ q : ℕ, N < q → Subsingleton (wcEtCoh (U : Scheme.{u}) m q) :=
by
  intro q hq
  have hm0 : m ≠ 0 := by
    rintro rfl
    exact hm Nat.cast_zero
  have hp : ∀ p : ℕ, p.Prime → p ∣ m → (p : K) ≠ 0 := by
    intro p _ hpm h0
    obtain ⟨t, rfl⟩ := hpm
    exact hm (by rw [Nat.cast_mul, h0, zero_mul])
  have hK0 : ∀ (F : Sheaf (Scheme.smallEtaleTopology (Spec (.of K))) AddCommGrpCat.{u+1})
      (q : ℕ), 0 < q → Subsingleton (wcEtExt (Spec (.of K)) F q) := by
    intro F q hq
    obtain ⟨q', rfl⟩ := Nat.exists_eq_succ_of_ne_zero hq.ne'
    have h := wc_field_alg_over_algclosed_acyclic K K (Algebra.IsAlgebraic.of_finite K K) F q'
    exact ⟨fun a b => (h a).trans (h b).symm⟩
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology (U : Scheme.{u})) AddCommGrpCat.{u+1}) :=
    HasExt.standard _
  have hstep : ∀ p : ℕ, p.Prime → p ∣ m →
      ∀ F : Sheaf (Scheme.smallEtaleTopology (U : Scheme.{u})) AddCommGrpCat.{u+1}, p • 𝟙 F = 0 →
      ∀ q : ℕ, N < q → ∀ x : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology
        (U : Scheme.{u})) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) F q,
        x = 0 := by
    intro p hpp hpm F hF q hq x
    obtain ⟨r, π, hrN, hπ⟩ := wc_affine_open_finite_to_affine_space K Y f N U hU
    haveI := hπ
    obtain ⟨e⟩ := wc_et_finite_push_ext_equiv π F q
    have hT : p • 𝟙 ((wcEtPush π).obj F) = 0 := by
      rw [← (wcEtPush π).map_id, ← Functor.map_nsmul, hF, Functor.map_zero]
    have hS := wc_et_affine_space_torsion_cd K p hpp (hp p hpp hpm) 0
      (fun F' _ q' hq' => hK0 F' q' hq') r ((wcEtPush π).obj F) hT q (by omega)
    have hsub : Subsingleton (wcEtExt (U : Scheme.{u}) F q) := e.symm.injective.subsingleton
    exact @Subsingleton.elim _ hsub x (0 : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology
        (U : Scheme.{u})) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) F q)
  have hall := wc_ext_torsion_prime_devissage
    ((constantSheaf (Scheme.smallEtaleTopology (U : Scheme.{u})) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} ℤ))) N m hm0 hstep
    ((constantSheaf (Scheme.smallEtaleTopology (U : Scheme.{u})) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))
    (wc_et_const_zmod_nsmul_zero (U : Scheme.{u}) m) q hq
  exact ⟨fun a b => (hall a).trans (hall b).symm⟩

theorem wc_qmbt_eop_blowup_fibre_divisor {A' : Type u} [CommRing A'] [IsDomain A']
    [IsDiscreteValuationRing A'] {π' : A'} (hπ' : IsLocalRing.maximalIdeal A' = Ideal.span {π'})
    {n : ℕ} (hn : 2 ≤ n) {c₁ : Matrix (Fin n) (Fin n) A'} (hc₁ : IsUnit (c₁ + c₁.transpose).det)
    {X₁ : Scheme.{u}} (r₁ : X₁ ⟶ Spec (.of (wcQuadModelRing A' n (π' ^ 2) c₁)))
    (hr : wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range fun k =>
      (Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) c₁))).inv.hom
        (wcQmbtGen A' n π' c₁ k)))) r₁)
    {K : Type u} [Field K] (ω : wcQuadModelRing A' n (π' ^ 2) c₁ →+* K)
    (hωX : ∀ p, ω (Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) c₁) (MvPolynomial.X p)) = 0)
    (hωπ : ω (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c₁) π') = 0) :
    ∃ W : X₁.Opens,
      (∀ w ∈ W, algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c₁) π' ∈ PrimeSpectrum.asIdeal (r₁ w) →
        ∀ k, wcQmbtGen A' n π' c₁ k ∈ PrimeSpectrum.asIdeal (r₁ w)) ∧
      (∀ w, w ∉ W → (∀ k, wcQmbtGen A' n π' c₁ k ∈ PrimeSpectrum.asIdeal (r₁ w)) →
        ∃ w', w' ⤳ w ∧
          algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c₁) π' ∈ PrimeSpectrum.asIdeal (r₁ w') ∧
          ∃ k, wcQmbtGen A' n π' c₁ k ∉ PrimeSpectrum.asIdeal (r₁ w')) ∧
      SmoothOfRelativeDimension (n - 1) (Limits.pullback.snd r₁ (Spec.map (CommRingCat.ofHom ω))) ∧
      ∃ (Y : Scheme.{u}) (i : Y ⟶ Limits.pullback r₁ (Spec.map (CommRingCat.ofHom ω))),
        IsClosedImmersion i ∧
        SmoothOfRelativeDimension (n - 2) (i ≫ Limits.pullback.snd r₁ (Spec.map (CommRingCat.ofHom ω))) ∧
        Set.range i = (Limits.pullback.fst r₁ (Spec.map (CommRingCat.ofHom ω))) ⁻¹' (W : Set X₁)ᶜ ∧
        IsAffineOpen ((Limits.pullback.fst r₁ (Spec.map (CommRingCat.ofHom ω))) ⁻¹ᵁ W) :=
by
  classical
  obtain ⟨φN, φ, eN, e, hNX, hNA, hNgen, hNup, hφX, hφA, hnzd, hgen, hNo, heo, hN, he, hcov⟩ :=
    wc_qmbt_bof_atlas hπ' r₁ hr
  haveI := hNo
  haveI : ∀ j, IsOpenImmersion (e j) := heo
  have hcompl := wc_qmbt_bof_chart_compl r₁ hr φN φ eN e hNgen hNup hφX hφA hnzd hgen hN he
  obtain ⟨Z₁, z, hz, hrange, hloc⟩ :=
    wc_qmbt_bof_divisor r₁ hr φN φ eN e hNX hNA hφX hφA hnzd hgen hN he hcov hcompl
  haveI := hz
  choose hj hsurj hker hs using hloc
  have sq : ∀ j, ∃ g : Spec (.of (wcQmbtChart A' n π' c₁ j ⧸ wcQmbtBofSIdeal A' n π' c₁ j)) ⟶ Z₁,
      IsPullback g (Spec.map (CommRingCat.ofHom
        (Ideal.Quotient.mk (wcQmbtBofSIdeal A' n π' c₁ j)))) z (e j) :=
    fun j => wc_qmbt_bof_closed_chart z (e j) _ (hj j) (hsurj j) (hker j) (hs j)
  choose g hg using sq
  obtain ⟨lam, hlam⟩ : ∃ lam : A' →+* K,
      ω.comp (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c₁)) = lam := ⟨_, rfl⟩
  have hdet : IsUnit ((c₁.map lam) + (c₁.map lam).transpose).det := by
    have h1 : (c₁.map lam) + (c₁.map lam).transpose = (c₁ + c₁.transpose).map lam := by
      ext i j; simp
    have h2 := RingHom.map_det lam (c₁ + c₁.transpose)
    rw [RingHom.mapMatrix_apply] at h2
    rw [h1, ← h2]
    exact hc₁.map lam
  obtain ⟨qN, hqN⟩ := wc_qmbt_bof_pushout_none ω hωX hωπ lam hlam φN hNX hNA
  choose qj hqj using fun j =>
    wc_qmbt_bof_pushout_chart ω hωX hωπ lam hlam j (φ j) (hφX j) (hφA j)
  choose qd hqd using fun j =>
    wc_qmbt_bof_pushout_divisor ω hωX hωπ lam hlam j (φ j) (hφX j) (hφA j)
  have pN : IsPullback (Spec.map (CommRingCat.ofHom qN))
      (Spec.map (CommRingCat.ofHom (algebraMap K (wcQuadModelRing K n 1 (c₁.map lam)))))
      (eN ≫ r₁) (Spec.map (CommRingCat.ofHom ω)) := by
    rw [hN]; exact isPullback_SpecMap_of_isPushout _ _ _ _ hqN
  have pC : ∀ j, IsPullback (Spec.map (CommRingCat.ofHom (qj j)))
      (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Option (Fin n)) K ⧸
        Ideal.span (Set.range (wcQmbtBofRelChart K n (c₁.map lam) j))))))
      (e j ≫ r₁) (Spec.map (CommRingCat.ofHom ω)) := by
    intro j; rw [he j]; exact isPullback_SpecMap_of_isPushout _ _ _ _ (hqj j)
  have hsmN : SmoothOfRelativeDimension (n - 1)
      (Spec.map (CommRingCat.ofHom (algebraMap K (wcQuadModelRing K n 1 (c₁.map lam))))) := by
    have h := wc_qmbt_bof_jacobian_cover_smooth K (wcQmbtBofRelNone K n (c₁.map lam))
      (wcQuadModelIdeal K n 1 (c₁.map lam)) (by unfold wcQmbtBofRelNone; rw [Set.range_const])
      (fun r : Fin n => fun _ : Fin 1 => r) (fun _ a b _ => Subsingleton.elim a b)
      (wc_qmbt_bof_minors_none (c₁.map lam) hdet)
    rw [Fintype.card_fin] at h
    exact h
  have hsmC : ∀ j, SmoothOfRelativeDimension (n - 1)
      (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Option (Fin n)) K ⧸
        Ideal.span (Set.range (wcQmbtBofRelChart K n (c₁.map lam) j)))))) := by
    intro j
    have hinj : ∀ w : {v : Option (Fin n) // v ≠ some j},
        Function.Injective (![some j, w.1] : Fin 2 → Option (Fin n)) := by
      rintro ⟨w, hw⟩ a b hab
      fin_cases a <;> fin_cases b <;> (try simp at hab ⊢) <;>
        first | exact absurd hab.symm hw | exact absurd hab hw | exact hab.elim | rfl
    have h := wc_qmbt_bof_jacobian_cover_smooth K (wcQmbtBofRelChart K n (c₁.map lam) j)
      _ rfl (fun w : {v : Option (Fin n) // v ≠ some j} => ![some j, w.1]) hinj
      (wc_qmbt_bof_minors_chart (c₁.map lam) hdet j)
    rw [Fintype.card_option, Fintype.card_fin, show n + 1 - 2 = n - 1 by omega] at h
    exact h
  have hsmD : ∀ j, SmoothOfRelativeDimension (n - 2)
      (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Option (Fin n)) K ⧸
        Ideal.span (Set.range (wcQmbtBofRelDiv K n (c₁.map lam) j)))))) := by
    intro j
    have hinj : ∀ w : {p : Fin n // p ≠ j},
        Function.Injective (![some j, none, some w.1] : Fin 3 → Option (Fin n)) := by
      rintro ⟨w, hw⟩ a b hab
      fin_cases a <;> fin_cases b <;> (try simp at hab ⊢) <;>
        first | exact absurd hab.symm hw | exact absurd hab hw | exact hab.elim | rfl
    have h := wc_qmbt_bof_jacobian_cover_smooth K (wcQmbtBofRelDiv K n (c₁.map lam) j)
      _ rfl (fun w : {p : Fin n // p ≠ j} => ![some j, none, some w.1]) hinj
      (wc_qmbt_bof_minors_divisor (c₁.map lam) hdet j)
    rw [Fintype.card_option, Fintype.card_fin, show n + 1 - 3 = n - 2 by omega] at h
    exact h

  have hptN : ∀ x, (r₁ (eN x)).asIdeal = Ideal.comap φN x.asIdeal := by
    intro x
    rw [← Scheme.Hom.comp_apply, hN]
    rfl
  have hptC : ∀ j x, (r₁ (e j x)).asIdeal = Ideal.comap (φ j) x.asIdeal := by
    intro j x
    rw [← Scheme.Hom.comp_apply, he j]
    rfl
  have hφjj : ∀ j, φ j (wcQmbtGen A' n π' c₁ (some j)) =
      Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c₁ j) (MvPolynomial.X (some j)) := by
    intro j
    show φ j (Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) c₁) (MvPolynomial.X j)) = _
    rw [hφX j j]
    simp [wcQmbtChartHat]
  refine ⟨eN.opensRange, ?_, ?_, ?_,
    Limits.pullback z (Limits.pullback.fst r₁ (Spec.map (CommRingCat.ofHom ω))),
    Limits.pullback.snd z (Limits.pullback.fst r₁ (Spec.map (CommRingCat.ofHom ω))), ?_, ?_,
    ?_, ?_⟩
  ·
    intro w hw hπw k
    obtain ⟨x, rfl⟩ := Scheme.Hom.mem_opensRange.mp hw
    rw [hptN, Ideal.mem_comap] at hπw ⊢
    have hπx : algebraMap A' (wcQmbtChartNone A' n c₁) π' ∈ x.asIdeal := by
      rw [← RingHom.congr_fun hNA π']; exact hπw
    cases k with
    | none => exact hπw
    | some p =>
      show φN (Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) c₁) (MvPolynomial.X p)) ∈
        x.asIdeal
      rw [hNX p, map_mul]
      apply Ideal.mul_mem_right
      rw [← MvPolynomial.algebraMap_eq, Ideal.Quotient.mk_algebraMap]
      exact hπx
  ·
    intro w hw hgenw
    have hw' : w ∉ Set.range eN := by
      intro h; apply hw; exact Scheme.Hom.mem_opensRange.mpr h
    rcases hcov w with h | ⟨j, q, rfl⟩
    · exact absurd h hw'
    have hsq : Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c₁ j) (MvPolynomial.X none) ∈
        q.asIdeal := not_not.mp (mt (hcompl j q).mpr hw')
    have hx : Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c₁ j) (MvPolynomial.X (some j)) ∈
        q.asIdeal := by
      have h1 := hgenw (some j)
      rw [hptC, Ideal.mem_comap, hφjj] at h1
      exact h1
    obtain ⟨q', hq'q, -, hπq', hxq'⟩ := wc_qmbt_hl_chart_generize π' c₁ j q hsq hx
    refine ⟨e j q', ?_, ?_, some j, ?_⟩
    · exact ((PrimeSpectrum.le_iff_specializes q' q).mp hq'q).map (e j).continuous
    · have h1 := hptC j q'
      rw [h1, Ideal.mem_comap, ← RingHom.comp_apply, hφA j]; exact hπq'
    · have h1 := hptC j q'
      rw [h1, Ideal.mem_comap, hφjj]; exact hxq'
  ·
    apply wc_qmbt_bof_chartwise_smooth r₁ _ (n - 1)
    intro x
    rcases hcov x with ⟨y, rfl⟩ | ⟨j, y, rfl⟩
    · exact ⟨_, _, eN, hNo, _, _, ⟨y, rfl⟩, pN, hsmN⟩
    · exact ⟨_, _, e j, heo j, _, _, ⟨y, rfl⟩, pC j, hsmC j⟩
  · first
      | infer_instance
      | exact MorphismProperty.pullback_snd _ _ hz
  · have hY : SmoothOfRelativeDimension (n - 2)
        (Limits.pullback.snd (z ≫ r₁) (Spec.map (CommRingCat.ofHom ω))) := by
      apply wc_qmbt_bof_chartwise_smooth (z ≫ r₁) _ (n - 2)
      intro ζ
      have hζ : z ζ ∉ Set.range eN := by
        rw [← Set.mem_compl_iff, ← hrange]; exact ⟨ζ, rfl⟩
      rcases hcov (z ζ) with h | ⟨j, y, hy⟩
      · exact absurd h hζ
      obtain ⟨p, hp1, -⟩ := Scheme.exists_preimage_of_isPullback (hg j) ζ y hy.symm
      haveI : IsOpenImmersion (g j) :=
        MorphismProperty.of_isPullback (P := @IsOpenImmersion) (hg j).flip (heo j)
      have hcomp : g j ≫ z ≫ r₁ = Spec.map (CommRingCat.ofHom
          ((Ideal.Quotient.mk (wcQmbtBofSIdeal A' n π' c₁ j)).comp (φ j))) := by
        rw [← Category.assoc, (hg j).w, Category.assoc, he j, ← Spec.map_comp,
          CommRingCat.ofHom_comp]
      have hpb : IsPullback (Spec.map (CommRingCat.ofHom
          (R := wcQmbtChart A' n π' c₁ j ⧸ wcQmbtBofSIdeal A' n π' c₁ j) (qd j)))
          (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Option (Fin n)) K ⧸
            Ideal.span (Set.range (wcQmbtBofRelDiv K n (c₁.map lam) j))))))
          (g j ≫ z ≫ r₁) (Spec.map (CommRingCat.ofHom ω)) := by
        rw [hcomp]
        exact isPullback_SpecMap_of_isPushout _ _ _ _ (hqd j)
      exact ⟨_, _, g j, inferInstance, _, _, ⟨p, hp1⟩, hpb, hsmD j⟩
    haveI := hY
    have h2 := smoothOfRelativeDimension_comp 0 (n - 2)
      (Limits.pullbackRightPullbackFstIso r₁ (Spec.map (CommRingCat.ofHom ω)) z).hom
      (Limits.pullback.snd (z ≫ r₁) (Spec.map (CommRingCat.ofHom ω)))
    rw [zero_add, Limits.pullbackRightPullbackFstIso_hom_snd] at h2
    exact h2
  ·
    rw [Scheme.Pullback.range_snd, hrange, Scheme.Hom.coe_opensRange]
  ·
    have hO : (Limits.pullback.fst r₁ (Spec.map (CommRingCat.ofHom ω))) ⁻¹ᵁ eN.opensRange =
        (Limits.pullback.snd eN
          (Limits.pullback.fst r₁ (Spec.map (CommRingCat.ofHom ω)))).opensRange := by
      apply TopologicalSpace.Opens.ext
      simp only [Scheme.Hom.coe_preimage, Scheme.Hom.coe_opensRange, Scheme.Pullback.range_snd]
    rw [hO]
    have hpaste := (IsPullback.of_hasPullback eN
      (Limits.pullback.fst r₁ (Spec.map (CommRingCat.ofHom ω)))).paste_vert
      (IsPullback.of_hasPullback r₁ (Spec.map (CommRingCat.ofHom ω)))
    haveI : IsAffine (Limits.pullback eN
        (Limits.pullback.fst r₁ (Spec.map (CommRingCat.ofHom ω)))) :=
      IsAffine.of_isIso (IsPullback.isoIsPullback _ _ hpaste pN).hom
    exact isAffineOpen_opensRange _

theorem wc_qmbt_eop_geom_fibre_divisor {A : Type u} [CommRing A] [IsDomain A]
    [IsDiscreteValuationRing A]
    [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (hℓ : IsUnit ((ℓ : ℕ) : A)) {n : ℕ} (hn : Even n) (hn4 : 4 ≤ n) {π : A}
    {c : Matrix (Fin n) (Fin n) A}
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π}) (hc : IsUnit (c + c.transpose).det)
    {x₀ : Spec (.of (wcQuadModelRing A n π c))}
    (hx₀ : ∀ p, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
      PrimeSpectrum.asIdeal x₀)
    {B₀ : Type u} [CommRing B₀] [HenselianLocalRing B₀] [IsSepClosed (IsLocalRing.ResidueField B₀)]
    {Λ₀ : Type u} [SmallCategory Λ₀] [IsCofiltered Λ₀]
    {W₀ : Λ₀ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (wcQuadModelRing A n π c))) x₀))
      (Scheme.Etale.forget (Spec (.of (wcQuadModelRing A n π c))))}
    {φ₀ : ∀ l, Spec (.of B₀) ⟶ (W₀.obj l).right.left}
    {a₀ : Spec (.of B₀) ⟶ Spec (.of (wcQuadModelRing A n π c))}
    (hsh : wcHalShData x₀ B₀ Λ₀ W₀ φ₀ a₀)
    {Xs : Scheme.{u}} {ι : Xs ⟶ Spec (.of B₀)} {s : Xs ⟶ Spec (.of (IsLocalRing.ResidueField A))}
    (hps : IsPullback ι s (a₀ ≫ wcQuadModelStr A n π c) (wcQmSp A))
    {A' : Type u} [CommRing A'] [IsDomain A'] [IsDiscreteValuationRing A'] [HenselianLocalRing A']
    [IsSepClosed (IsLocalRing.ResidueField A')] {ιA : A →+* A'} {π' : A'}
    (hℓ' : IsUnit ((ℓ : ℕ) : A')) (hπ' : IsLocalRing.maximalIdeal A' = Ideal.span {π'})
    (hπ'2 : π' ^ 2 = ιA π) (hgen : ∀ a' : A', ∃ x y : A, a' = ιA x + ιA y * π')
    {L' : Type u} [Field L'] [IsSepClosed L'] {φ' : A' →+* L'} (hφ' : Function.Injective φ')
    (halg' : letI := φ'.toAlgebra; Algebra.IsAlgebraic A' L')
    {Xm : Scheme.{u}} {f : Xm ⟶ Spec (.of A')}
    {bl : Xm ⟶ Limits.pullback (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))}
    (hbl : wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range
      (fun i : Option (Fin n) => Option.elim i
        ((Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of A')).inv.hom π'))
        (fun j => ((Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))) ≫ a₀).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A n π c))).inv.hom
            (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X j)))))))) bl)
    (hblf : bl ≫ Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA)) = f)
    {XE' : Scheme.{u}} {p' : XE' ⟶ Xm} {q' : XE' ⟶ Spec (.of L')}
    (hpb' : IsPullback p' q' f (Spec.map (CommRingCat.ofHom φ')))
    {Xs' : Scheme.{u}} {ι' : Xs' ⟶ Xm} {s' : Xs' ⟶ Spec (.of (IsLocalRing.ResidueField A'))}
    (hps' : IsPullback ι' s' f (wcQmSp A'))
    {βs : Xs' ⟶ Xs}
    (hβ : βs ≫ ι = ι' ≫ bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
