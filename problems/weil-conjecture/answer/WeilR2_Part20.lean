    (ρ₁ : wcSuppObj E₁ ⟶ wcSuppObj EY) (ρ₂ : wcSuppObj E₂ ⟶ wcSuppObj EY)
    (hz : Limits.biprod.lift (wcSuppUnitMap E₁) (wcSuppUnitMap E₂) ≫
      Limits.biprod.desc ρ₁ (-ρ₂) = 0)
    (hS : (ShortComplex.mk _ _ hz).ShortExact) (V : Xs'.ProEt)
    (h1 : IsAffine V.left) (h2 : IsClosed {x : V.left | IsClosed ({x} : Set V.left)})
    (h3 : ∀ x : V.left, ∃! y : V.left, IsClosed ({y} : Set V.left) ∧ x ⤳ y)
    (h4 : ExtremallyDisconnected {x : V.left | IsClosed ({x} : Set V.left)})
    (h5 : ∀ x : V.left, IsClosed ({x} : Set V.left) →
      HenselianLocalRing (V.left.presheaf.stalk x) ∧ IsSepClosed (V.left.residueField x))
    (O₁ : (Limits.pullback V.hom i₁).Opens)
    (hO₁ : (O₁ : Set ↥(Limits.pullback V.hom i₁)) =
      (Limits.pullback.fst V.hom i₁) ⁻¹' (Set.range ⇑(Limits.pullback.fst V.hom iY))ᶜ)
    (z : ↥(Limits.pullback V.hom i₁)) (hzc : IsClosed ({z} : Set ↥(Limits.pullback V.hom i₁)))
    (hzY : Limits.pullback.fst V.hom i₁ z ∈ Set.range ⇑(Limits.pullback.fst V.hom iY))
    (hnot : ∃ a : (Γ(Limits.pullback ((Limits.pullback V.hom i₁).fromSpecStalk z) O₁.ι, ⊤))ˣ,
      ¬ ∃ b : (Γ(Limits.pullback ((Limits.pullback V.hom i₁).fromSpecStalk z) O₁.ι, ⊤))ˣ,
        b ^ ℓ = a) :
    ∀ k : ℕ, 1 ≤ k →
      Finite (wcZModProEtExt (Limits.pullback ((Limits.pullback V.hom i₁).fromSpecStalk z) O₁.ι)
        (ℓ ^ k) 1) ∧
