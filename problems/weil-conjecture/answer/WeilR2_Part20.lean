  obtain ⟨eqv⟩ := wc_et_coh_iso_invariance eW.hom ℓ 1
  have hsubW : Subsingleton (wcEtCoh Wo.toScheme ℓ 1) := eqv.symm.subsingleton
  haveI : IsAffine Wo.toScheme := IsAffine.of_isIso eW.hom
  have hH1 := wc_qmbt_xspl_hm_vanish_of_et_affine_deg Wo.toScheme ℓ 0 hsubW
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf Wo.toScheme ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)) := HasExt.standard _
  have hWo1 : ∀ x : Abelian.Ext (SheafOfModules.unit (wcRingSheaf Wo.toScheme ℓ))
      (Dw.Φ.obj (wcSuppObj E₂)) 1, x = 0 := by
    intro x
    have h0 : x.comp (Abelian.Ext.mk₀ φ.hom) (add_zero 1) = 0 := hH1 _
    calc x = (x.comp (Abelian.Ext.mk₀ φ.hom) (add_zero 1)).comp (Abelian.Ext.mk₀ φ.inv)
          (add_zero 1) := by
          rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id,
            Abelian.Ext.comp_mk₀_id]
      _ = 0 := by rw [h0, Abelian.Ext.zero_comp]

  haveI := wc_qmbt_pn_xsp_locNoeth hℓ hn hn4 hπ hc hx₀ hsh hps hℓ' hπ' hπ'2 hgen hφ' halg' hbl hblf
    hpb' hps' hβ Dβ hDβ Dp' hDp' Di' hDi' I'
  have hExt1 := wc_qmbt_xspl_supp_ker_ext_vanish i₁ E₁ hE₁ Wo hW Dw hDw (wcSuppObj E₂) 1 hWo1
  have hK : ∀ x : (DerivedCategory.singleFunctor (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)) 0).obj
      (Limits.kernel (wcSuppUnitMap E₁)) ⟶
      ((DerivedCategory.singleFunctor (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)) 0).obj
        (wcSuppObj E₂))⟦(1 : ℤ)⟧, x = 0 := by
    intro x
    calc x = Abelian.Ext.homAddEquiv ((Abelian.Ext.homAddEquiv (n := 1)).symm x) :=
          (AddEquiv.apply_symm_apply _ x).symm
      _ = Abelian.Ext.homAddEquiv (0 : Abelian.Ext (Limits.kernel (wcSuppUnitMap E₁))
          (wcSuppObj E₂) 1) := by rw [hExt1 ((Abelian.Ext.homAddEquiv (n := 1)).symm x)]
      _ = 0 := map_zero _
  exact s2 hS' hK e he

theorem wc_xspl_split_oddq_S_chart : ∀ (Ω : Type u) [Field Ω] (e : ℕ) (Y : Scheme.{u}) [AlgebraicGeometry.IsReduced Y] (jY : Y ⟶ wcProjK Ω (2 * e + 2)), IsClosedImmersion jY → Set.range jY = wcXspVplus Ω (2 * e + 2) (wcXspSplitCoeff Ω e) → ∃ t : ((jY ⁻¹ᵁ wcSgD Ω (2 * e + 2) (Fin.last (2 * e + 2)) : Y.Opens) : Scheme.{u}) ⟶ Spec (.of (wcQuadModelRing Ω (2 * e + 2) 1 (Matrix.of fun p q : Fin (2 * e + 2) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : Ω) else 0))), IsClosedImmersion t ∧ Set.range t = Set.univ :=
by
  intro Ω _ e Y _ jY hjY hY
  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω) :=
    MvPolynomial.gradedAlgebra
  haveI := hjY

  have s5 : ∀ (W Z U : Scheme.{u}) [AlgebraicGeometry.IsReduced W] (g : W ⟶ U) (z : Z ⟶ U)
      [IsClosedImmersion g] [IsClosedImmersion z], Set.range g = Set.range z →
      ∃ t : W ⟶ Z, IsClosedImmersion t ∧ Set.range t = Set.univ := by
    intro W Z U _ g z _ _ h
    have H : z.ker ≤ g.ker := by
      show z.ker ≤ Scheme.IdealSheafData.ofIdeals
        (fun V : U.affineOpens => RingHom.ker (g.app V).hom)
      rw [Scheme.IdealSheafData.le_ofIdeals_iff]
      intro V s hs
      have hz : (z.app V).hom s = 0 :=
        Scheme.IdealSheafData.ideal_ofIdeals_le
          (I := fun V : U.affineOpens => RingHom.ker (z.app V).hom) V hs
      have hX : z ⁻¹ᵁ U.basicOpen s = ⊥ := by
        rw [Scheme.Hom.preimage_basicOpen]
        erw [hz]
        exact Scheme.basicOpen_zero _ _
      have hW : W.basicOpen ((g.app V).hom s) = ⊥ := by
        rw [← Scheme.Hom.preimage_basicOpen, eq_bot_iff]
        intro w hw
        obtain ⟨x, hx⟩ : g w ∈ Set.range z := h ▸ ⟨w, rfl⟩
        have hx' : x ∈ z ⁻¹ᵁ U.basicOpen s := by
          show z x ∈ U.basicOpen s
          rw [hx]; exact hw
        rw [hX] at hx'
        exact hx'.elim
      exact eq_zero_of_basicOpen_eq_bot _ hW
    have hg' : IsClosedImmersion.lift z g H ≫ z = g := IsClosedImmersion.lift_fac z g H
    have : IsClosedImmersion (IsClosedImmersion.lift z g H ≫ z) := by rw [hg']; infer_instance
    have hci : IsClosedImmersion (IsClosedImmersion.lift z g H) :=
      IsClosedImmersion.of_comp (IsClosedImmersion.lift z g H) z
    refine ⟨IsClosedImmersion.lift z g H, hci, Set.eq_univ_of_forall fun w' => ?_⟩
    obtain ⟨w, hw⟩ : z w' ∈ Set.range g := h ▸ ⟨w', rfl⟩
    refine ⟨w, z.injective ?_⟩
    rw [← Scheme.Hom.comp_apply, hg', hw]

  have s1 : ∀ (a : Fin (2 * e + 2 + 1)), ∃ E : MvPolynomial (Fin (2 * e + 2)) Ω ≃+*
      HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω)
        (MvPolynomial.X a),
      (∀ (n : ℕ) (F : MvPolynomial (Fin (2 * e + 2 + 1)) Ω)
        (hF : F ∈ MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω (n • 1)),
        E (MvPolynomial.eval₂Hom MvPolynomial.C
          (Fin.insertNth (α := fun _ => MvPolynomial (Fin (2 * e + 2)) Ω) a 1 MvPolynomial.X) F) =
        HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω)
          ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X Ω a))
          n F hF) := by
    intro a
    have scale : ∀ {S : Type u} [CommRing S] (φ : Ω →+* S) (x : Fin (2 * e + 2 + 1) → S) (t : S)
        (n : ℕ) (F : MvPolynomial (Fin (2 * e + 2 + 1)) Ω), F.IsHomogeneous n →
        MvPolynomial.eval₂ φ (fun j => t * x j) F = t ^ n * MvPolynomial.eval₂ φ x F := by
      intro S _ φ x t n F hF
      conv_lhs => rw [F.as_sum]
      conv_rhs => rw [F.as_sum]
      rw [MvPolynomial.eval₂_sum, MvPolynomial.eval₂_sum, Finset.mul_sum]
      refine Finset.sum_congr rfl (fun d hd => ?_)
      have hdeg : Finsupp.degree d = n := by
        by_contra h
        exact (MvPolynomial.mem_support_iff.mp hd) (hF.coeff_eq_zero h)
      rw [MvPolynomial.eval₂_monomial, MvPolynomial.eval₂_monomial]
      have hp : (d.prod fun i k => (t * x i) ^ k) = t ^ n * d.prod fun i k => x i ^ k := by
        simp only [mul_pow]
        rw [Finsupp.prod_mul]
        congr 1
        rw [← hdeg, Finsupp.degree_apply]
        unfold Finsupp.prod
        rw [Finset.prod_pow_eq_pow_sum]
      rw [hp]
      ring
    have hX : (MvPolynomial.X a : MvPolynomial (Fin (2 * e + 2 + 1)) Ω) ∈
        MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω 1 :=
      (MvPolynomial.mem_homogeneousSubmodule 1 _).2 (MvPolynomial.isHomogeneous_X Ω a)
    have hg : ∀ i : Fin (2 * e + 2), (MvPolynomial.X (a.succAbove i) :
        MvPolynomial (Fin (2 * e + 2 + 1)) Ω) ∈
        MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω (1 • 1) := fun i =>
      (MvPolynomial.mem_homogeneousSubmodule _ _).2 (MvPolynomial.isHomogeneous_X Ω _)
    obtain ⟨ψ, hψC, hψX⟩ : ∃ ψ : MvPolynomial (Fin (2 * e + 2)) Ω →+*
        HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω)
          (MvPolynomial.X a),
        (∀ c : Ω, ψ (MvPolynomial.C c) = HomogeneousLocalization.fromZeroRingHom
          (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω)
          (Submonoid.powers (MvPolynomial.X a))
          (algebraMap Ω ↥(MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω 0) c)) ∧
        (∀ i : Fin (2 * e + 2), ψ (MvPolynomial.X i) = HomogeneousLocalization.Away.mk
          (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω) hX 1
          (MvPolynomial.X (a.succAbove i)) (hg i)) :=
      ⟨MvPolynomial.eval₂Hom ((HomogeneousLocalization.fromZeroRingHom
          (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω)
          (Submonoid.powers (MvPolynomial.X a))).comp
          (algebraMap Ω ↥(MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω 0)))
        (fun i => HomogeneousLocalization.Away.mk
          (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω)
          hX 1 (MvPolynomial.X (a.succAbove i)) (hg i)),
        fun c => by rw [MvPolynomial.eval₂Hom_C, RingHom.comp_apply],
        fun i => by rw [MvPolynomial.eval₂Hom_X']⟩
    obtain ⟨ρt, hρC, hρa, hρs, hρdef⟩ : ∃ ρt : MvPolynomial (Fin (2 * e + 2 + 1)) Ω →+*
        MvPolynomial (Fin (2 * e + 2)) Ω,
        (∀ c : Ω, ρt (MvPolynomial.C c) = MvPolynomial.C c) ∧ ρt (MvPolynomial.X a) = 1 ∧
        (∀ i : Fin (2 * e + 2), ρt (MvPolynomial.X (a.succAbove i)) = MvPolynomial.X i) ∧
        ρt = MvPolynomial.eval₂Hom MvPolynomial.C
          (Fin.insertNth (α := fun _ => MvPolynomial (Fin (2 * e + 2)) Ω) a 1 MvPolynomial.X) :=
      ⟨MvPolynomial.eval₂Hom MvPolynomial.C
          (Fin.insertNth (α := fun _ => MvPolynomial (Fin (2 * e + 2)) Ω) a 1 MvPolynomial.X),
        fun c => by rw [MvPolynomial.eval₂Hom_C],
        by rw [MvPolynomial.eval₂Hom_X', Fin.insertNth_apply_same],
        fun i => by rw [MvPolynomial.eval₂Hom_X', Fin.insertNth_apply_succAbove], rfl⟩
    have hu : IsUnit (ρt (MvPolynomial.X a)) := by rw [hρa]; exact isUnit_one
    have hu1 : (Localization.mk 1 ⟨MvPolynomial.X a, Submonoid.mem_powers _⟩ :
        Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (2 * e + 2 + 1)) Ω)) *
        algebraMap (MvPolynomial (Fin (2 * e + 2 + 1)) Ω)
          (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (2 * e + 2 + 1)) Ω))
          (MvPolynomial.X a) = 1 := by
      rw [← Localization.mk_one_eq_algebraMap, Localization.mk_mul, one_mul, mul_one]
      exact Localization.mk_self (⟨MvPolynomial.X a, Submonoid.mem_powers _⟩ :
        Submonoid.powers (MvPolynomial.X a : MvPolynomial (Fin (2 * e + 2 + 1)) Ω))
    obtain ⟨ρ, hρ1, hρ2⟩ : ∃ ρ : HomogeneousLocalization.Away
        (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω) (MvPolynomial.X a) →+*
        MvPolynomial (Fin (2 * e + 2)) Ω,
        (∀ z y, algebraMap (HomogeneousLocalization.Away
          (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω) (MvPolynomial.X a))
          (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (2 * e + 2 + 1)) Ω)) z =
          algebraMap (MvPolynomial (Fin (2 * e + 2 + 1)) Ω)
            (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (2 * e + 2 + 1)) Ω)) y →
            ρ z = ρt y) ∧
        (∀ (n : ℕ) (F : MvPolynomial (Fin (2 * e + 2 + 1)) Ω)
          (hF : F ∈ MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω (n • 1)),
          ρ (HomogeneousLocalization.Away.mk
            (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω) hX n F hF) = ρt F) := by
      refine ⟨(IsLocalization.Away.lift (MvPolynomial.X a) hu :
          Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (2 * e + 2 + 1)) Ω) →+*
            MvPolynomial (Fin (2 * e + 2)) Ω).comp (algebraMap _ _), ?_, ?_⟩
      · intro z y hzy
        rw [RingHom.comp_apply, hzy, IsLocalization.Away.lift_eq]
      · intro n F hF
        rw [RingHom.comp_apply, HomogeneousLocalization.algebraMap_apply,
          HomogeneousLocalization.Away.val_mk]
        have hs := IsLocalization.mk'_spec
          (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (2 * e + 2 + 1)) Ω)) F
          (⟨MvPolynomial.X a ^ n, pow_mem (Submonoid.mem_powers _) n⟩ :
            Submonoid.powers (MvPolynomial.X a : MvPolynomial (Fin (2 * e + 2 + 1)) Ω))
        rw [← Localization.mk_eq_mk'_apply] at hs
        have hs2 := congrArg (IsLocalization.Away.lift (MvPolynomial.X a) hu :
          Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (2 * e + 2 + 1)) Ω) →+*
            MvPolynomial (Fin (2 * e + 2)) Ω) hs
        rw [map_mul, IsLocalization.Away.lift_eq, IsLocalization.Away.lift_eq] at hs2
        simp only [map_pow, hρa, one_pow, mul_one] at hs2
        exact hs2
    have hΨC : ∀ c : Ω, algebraMap (HomogeneousLocalization.Away
          (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω) (MvPolynomial.X a))
          (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (2 * e + 2 + 1)) Ω))
          (ψ (MvPolynomial.C c)) =
        algebraMap (MvPolynomial (Fin (2 * e + 2 + 1)) Ω)
          (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (2 * e + 2 + 1)) Ω))
          (MvPolynomial.C c) := by
      intro c
      rw [hψC, HomogeneousLocalization.algebraMap_apply, ← Localization.mk_one_eq_algebraMap]
      have h1 : ((algebraMap Ω ↥(MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω 0) c :
          ↥(MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω 0)) :
            MvPolynomial (Fin (2 * e + 2 + 1)) Ω) =
          MvPolynomial.C c := by
        rw [SetLike.GradeZero.coe_algebraMap, MvPolynomial.algebraMap_eq]
      rw [← h1]
      rfl
    have hΨX : ∀ i : Fin (2 * e + 2), algebraMap (HomogeneousLocalization.Away
          (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω) (MvPolynomial.X a))
          (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (2 * e + 2 + 1)) Ω))
          (ψ (MvPolynomial.X i)) =
        (Localization.mk 1 ⟨MvPolynomial.X a, Submonoid.mem_powers _⟩ :
          Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (2 * e + 2 + 1)) Ω)) *
        algebraMap (MvPolynomial (Fin (2 * e + 2 + 1)) Ω)
          (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (2 * e + 2 + 1)) Ω))
          (MvPolynomial.X (a.succAbove i)) := by
      intro i
      rw [hψX, HomogeneousLocalization.algebraMap_apply, HomogeneousLocalization.Away.val_mk,
        ← Localization.mk_one_eq_algebraMap, Localization.mk_mul, one_mul, mul_one]
      congr 1
      ext
      simp
    have hcomp : ((algebraMap (HomogeneousLocalization.Away
          (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω) (MvPolynomial.X a))
          (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (2 * e + 2 + 1)) Ω))).comp ψ).comp
          ρt =
        MvPolynomial.eval₂Hom ((algebraMap (MvPolynomial (Fin (2 * e + 2 + 1)) Ω)
          (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (2 * e + 2 + 1)) Ω))).comp
            MvPolynomial.C)
          (fun j => (Localization.mk 1 ⟨MvPolynomial.X a, Submonoid.mem_powers _⟩ :
            Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (2 * e + 2 + 1)) Ω)) *
            algebraMap (MvPolynomial (Fin (2 * e + 2 + 1)) Ω)
              (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (2 * e + 2 + 1)) Ω))
              (MvPolynomial.X j)) := by
      apply MvPolynomial.ringHom_ext
      · intro c
        rw [RingHom.comp_apply, RingHom.comp_apply, hρC, hΨC, MvPolynomial.eval₂Hom_C,
          RingHom.comp_apply]
      · intro j
        rw [MvPolynomial.eval₂Hom_X', RingHom.comp_apply, RingHom.comp_apply]
        rcases Fin.eq_self_or_eq_succAbove a j with h | ⟨i, h⟩
        · subst h
          rw [hρa, map_one, map_one, hu1]
        · subst h
          rw [hρs, hΨX]
    have hev : MvPolynomial.eval₂Hom ((algebraMap (MvPolynomial (Fin (2 * e + 2 + 1)) Ω)
          (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (2 * e + 2 + 1)) Ω))).comp
            MvPolynomial.C)
          (fun j => algebraMap (MvPolynomial (Fin (2 * e + 2 + 1)) Ω)
              (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (2 * e + 2 + 1)) Ω))
              (MvPolynomial.X j)) =
        algebraMap (MvPolynomial (Fin (2 * e + 2 + 1)) Ω)
          (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (2 * e + 2 + 1)) Ω)) := by
      apply MvPolynomial.ringHom_ext
      · intro c
        rw [MvPolynomial.eval₂Hom_C, RingHom.comp_apply]
      · intro j
        rw [MvPolynomial.eval₂Hom_X']
    have key : ∀ (n : ℕ) (F : MvPolynomial (Fin (2 * e + 2 + 1)) Ω), F.IsHomogeneous n →
        algebraMap (HomogeneousLocalization.Away
          (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω) (MvPolynomial.X a))
          (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (2 * e + 2 + 1)) Ω)) (ψ (ρt F)) *
          algebraMap (MvPolynomial (Fin (2 * e + 2 + 1)) Ω)
            (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (2 * e + 2 + 1)) Ω))
            (MvPolynomial.X a ^ n) =
        algebraMap (MvPolynomial (Fin (2 * e + 2 + 1)) Ω)
          (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (2 * e + 2 + 1)) Ω)) F := by
      intro n F hF
      have h1 := RingHom.congr_fun hcomp F
      rw [RingHom.comp_apply, RingHom.comp_apply] at h1
      rw [h1, MvPolynomial.coe_eval₂Hom]
      have hs := scale ((algebraMap (MvPolynomial (Fin (2 * e + 2 + 1)) Ω)
          (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (2 * e + 2 + 1)) Ω))).comp
            MvPolynomial.C)
        (fun j => algebraMap (MvPolynomial (Fin (2 * e + 2 + 1)) Ω)
              (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (2 * e + 2 + 1)) Ω))
              (MvPolynomial.X j))
        (Localization.mk 1 ⟨MvPolynomial.X a, Submonoid.mem_powers _⟩) n F hF
      rw [hs, ← MvPolynomial.coe_eval₂Hom, hev, map_pow]
      calc (Localization.mk 1 ⟨MvPolynomial.X a, Submonoid.mem_powers _⟩ :
            Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (2 * e + 2 + 1)) Ω)) ^ n *
            algebraMap (MvPolynomial (Fin (2 * e + 2 + 1)) Ω)
              (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (2 * e + 2 + 1)) Ω)) F *
            algebraMap (MvPolynomial (Fin (2 * e + 2 + 1)) Ω)
              (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (2 * e + 2 + 1)) Ω))
              (MvPolynomial.X a) ^ n
          = ((Localization.mk 1 ⟨MvPolynomial.X a, Submonoid.mem_powers _⟩ :
            Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (2 * e + 2 + 1)) Ω)) *
            algebraMap (MvPolynomial (Fin (2 * e + 2 + 1)) Ω)
              (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (2 * e + 2 + 1)) Ω))
              (MvPolynomial.X a)) ^ n *
            algebraMap (MvPolynomial (Fin (2 * e + 2 + 1)) Ω)
              (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (2 * e + 2 + 1)) Ω)) F := by
            ring
        _ = _ := by rw [hu1, one_pow, one_mul]
    have h1 : ψ.comp ρ = RingHom.id _ := by
      apply RingHom.ext
      intro z
      obtain ⟨n, F, hF, rfl⟩ := HomogeneousLocalization.Away.mk_surjective
        (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω) hX z
      rw [RingHom.comp_apply, hρ2, RingHom.id_apply]
      have hFh : F.IsHomogeneous n := by
        rw [smul_eq_mul, mul_one] at hF
        exact (MvPolynomial.mem_homogeneousSubmodule n F).1 hF
      apply HomogeneousLocalization.val_injective (Submonoid.powers (MvPolynomial.X a))
      rw [HomogeneousLocalization.Away.val_mk, ← HomogeneousLocalization.algebraMap_apply,
        Localization.mk_eq_mk'_apply, IsLocalization.eq_mk'_iff_mul_eq]
      exact key n F hFh
    have h2 : ρ.comp ψ = RingHom.id _ := by
      apply MvPolynomial.ringHom_ext
      · intro c
        rw [RingHom.comp_apply, hρ1 _ _ (hΨC c), hρC, RingHom.id_apply]
      · intro i
        rw [RingHom.comp_apply, hψX, hρ2, hρs, RingHom.id_apply]
    refine ⟨RingEquiv.ofRingHom ψ ρ h1 h2, fun n F hF => ?_⟩
    rw [RingEquiv.ofRingHom_apply, ← hρdef, ← hρ2 n F hF]
    exact RingHom.congr_fun h1 _

  have s3 : MvPolynomial.eval₂Hom MvPolynomial.C
        (Fin.insertNth (α := fun _ => MvPolynomial (Fin (2 * e + 2)) Ω) (Fin.last (2 * e + 2)) 1
          MvPolynomial.X)
        (wcLdpQuad Ω (2 * e + 2) (wcXspSplitCoeff Ω e) : MvPolynomial (Fin (2 * e + 2 + 1)) Ω) =
      ∑ p : Fin (2 * e + 2), ∑ q : Fin (2 * e + 2),
        MvPolynomial.C ((Matrix.of fun p q : Fin (2 * e + 2) =>
          if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : Ω) else 0) p q) *
          MvPolynomial.X p * MvPolynomial.X q - MvPolynomial.C 1 := by
    set y : Fin (2 * e + 2 + 1) → MvPolynomial (Fin (2 * e + 2)) Ω :=
      Fin.insertNth (α := fun _ => MvPolynomial (Fin (2 * e + 2)) Ω) (Fin.last (2 * e + 2)) 1
        MvPolynomial.X with hy
    have hyl : y (Fin.last (2 * e + 2)) = 1 := Fin.insertNth_apply_same _ _ _
    have hyc : ∀ s : Fin (2 * e + 2), y (Fin.castSucc s) = MvPolynomial.X s := by
      intro s
      have h := Fin.insertNth_apply_succAbove (α := fun _ => MvPolynomial (Fin (2 * e + 2)) Ω)
        (Fin.last (2 * e + 2)) (1 : MvPolynomial (Fin (2 * e + 2)) Ω) MvPolynomial.X s
      rw [Fin.succAbove_last] at h
      exact h
    have hsum : MvPolynomial.eval₂Hom MvPolynomial.C y
        (wcLdpQuad Ω (2 * e + 2) (wcXspSplitCoeff Ω e) : MvPolynomial (Fin (2 * e + 2 + 1)) Ω) =
        ∑ p : Fin (2 * e + 2 + 1), ∑ q : Fin (2 * e + 2 + 1),
          MvPolynomial.C (wcXspSplitCoeff Ω e p q) * (y p * y q) := by
      show MvPolynomial.eval₂Hom MvPolynomial.C y (∑ p : Fin (2 * e + 2 + 1),
        ∑ q : Fin (2 * e + 2 + 1),
        MvPolynomial.C (wcXspSplitCoeff Ω e p q) * (MvPolynomial.X p * MvPolynomial.X q)) = _
      simp only [map_sum, map_mul, MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_X']
    have k1 : ∀ p q : Fin (2 * e + 2), wcXspSplitCoeff Ω e (Fin.castSucc p) (Fin.castSucc q) =
        if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : Ω) else 0 := by
      intro p q
      have hp := p.isLt
      unfold wcXspSplitCoeff
      by_cases h : p.val % 2 = 0 ∧ q.val = p.val + 1
      · rw [if_pos h, if_pos (show (Fin.castSucc p).val % 2 = 0 ∧
          (Fin.castSucc q).val = (Fin.castSucc p).val + 1 ∧ (Fin.castSucc p).val < 2 * e + 2 from
            ⟨h.1, h.2, hp⟩)]
      · rw [if_neg h, if_neg (show ¬ ((Fin.castSucc p).val % 2 = 0 ∧
          (Fin.castSucc q).val = (Fin.castSucc p).val + 1 ∧ (Fin.castSucc p).val < 2 * e + 2) from
            fun h' => h ⟨h'.1, h'.2.1⟩),
          if_neg (show ¬ ((Fin.castSucc p).val = 2 * e + 2 ∧ (Fin.castSucc q).val = 2 * e + 2) from
            fun h' => by rw [Fin.val_castSucc] at h'; omega)]
    have k2 : ∀ p : Fin (2 * e + 2),
        wcXspSplitCoeff Ω e (Fin.castSucc p) (Fin.last (2 * e + 2)) = 0 := by
      intro p
      have hp := p.isLt
      unfold wcXspSplitCoeff
      rw [if_neg (show ¬ ((Fin.castSucc p).val % 2 = 0 ∧
          (Fin.last (2 * e + 2)).val = (Fin.castSucc p).val + 1 ∧
            (Fin.castSucc p).val < 2 * e + 2) from
            fun h' => by rw [Fin.val_castSucc, Fin.val_last] at h'; omega),
          if_neg (show ¬ ((Fin.castSucc p).val = 2 * e + 2 ∧
            (Fin.last (2 * e + 2)).val = 2 * e + 2) from
            fun h' => by rw [Fin.val_castSucc] at h'; omega)]
    have k3 : ∀ q : Fin (2 * e + 2),
        wcXspSplitCoeff Ω e (Fin.last (2 * e + 2)) (Fin.castSucc q) = 0 := by
      intro q
      have hq := q.isLt
      unfold wcXspSplitCoeff
      rw [if_neg (show ¬ ((Fin.last (2 * e + 2)).val % 2 = 0 ∧
          (Fin.castSucc q).val = (Fin.last (2 * e + 2)).val + 1 ∧
            (Fin.last (2 * e + 2)).val < 2 * e + 2) from
            fun h' => by rw [Fin.val_last] at h'; omega),
          if_neg (show ¬ ((Fin.last (2 * e + 2)).val = 2 * e + 2 ∧
            (Fin.castSucc q).val = 2 * e + 2) from
            fun h' => by rw [Fin.val_castSucc] at h'; omega)]
    have k4 : wcXspSplitCoeff Ω e (Fin.last (2 * e + 2)) (Fin.last (2 * e + 2)) = -1 := by
      unfold wcXspSplitCoeff
      rw [if_neg (show ¬ ((Fin.last (2 * e + 2)).val % 2 = 0 ∧
          (Fin.last (2 * e + 2)).val = (Fin.last (2 * e + 2)).val + 1 ∧
            (Fin.last (2 * e + 2)).val < 2 * e + 2) from
            fun h' => by rw [Fin.val_last] at h'; omega),
          if_pos (show ((Fin.last (2 * e + 2)).val = 2 * e + 2 ∧
            (Fin.last (2 * e + 2)).val = 2 * e + 2) from ⟨Fin.val_last _, Fin.val_last _⟩)]
    rw [hsum, Fin.sum_univ_castSucc (n := 2 * e + 2)]
    simp only [Fin.sum_univ_castSucc (n := 2 * e + 2), k1, k2, k3, k4, hyl, hyc, map_zero,
      zero_mul, Finset.sum_const_zero, add_zero, zero_add, map_neg, map_one, mul_one,
      Matrix.of_apply]
    simp only [mul_assoc]
    ring
  obtain ⟨E, hE⟩ := s1 (Fin.last (2 * e + 2))
  have hXc : (MvPolynomial.X (Fin.last (2 * e + 2)) : MvPolynomial (Fin (2 * e + 2 + 1)) Ω) ∈
      MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω 1 :=
    (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr
      (MvPolynomial.isHomogeneous_X Ω (Fin.last (2 * e + 2)))
  have heH := hE 2 _ (wcLdpQuad Ω (2 * e + 2) (wcXspSplitCoeff Ω e)).2
  rw [s3] at heH
  obtain ⟨π, hπ⟩ : ∃ π : HomogeneousLocalization.Away
      (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω)
        (MvPolynomial.X (Fin.last (2 * e + 2))) →+*
      wcQuadModelRing Ω (2 * e + 2) 1 (Matrix.of fun p q : Fin (2 * e + 2) =>
        if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : Ω) else 0),
      ∀ x, π x = Ideal.Quotient.mk (wcQuadModelIdeal Ω (2 * e + 2) 1
        (Matrix.of fun p q : Fin (2 * e + 2) =>
          if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : Ω) else 0)) (E.symm x) :=
    ⟨(Ideal.Quotient.mk _).comp E.symm.toRingHom, fun x => rfl⟩
  have hπs : Function.Surjective π := by
    intro b
    obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective b
    exact ⟨E p, by rw [hπ, RingEquiv.symm_apply_apply]⟩
  have hπk : RingHom.ker π = Ideal.span {HomogeneousLocalization.Away.mk
      (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω) hXc 2
      (wcLdpQuad Ω (2 * e + 2) (wcXspSplitCoeff Ω e) : MvPolynomial (Fin (2 * e + 2 + 1)) Ω)
      (wcLdpQuad Ω (2 * e + 2) (wcXspSplitCoeff Ω e)).2} := by
    ext x
    rw [RingHom.mem_ker, hπ, Ideal.Quotient.eq_zero_iff_mem]
    show E.symm x ∈ Ideal.span _ ↔ _
    rw [Ideal.mem_span_singleton', Ideal.mem_span_singleton']
    constructor
    · rintro ⟨a, ha⟩
      refine ⟨E a, ?_⟩
      rw [← heH, ← map_mul, ha, RingEquiv.apply_symm_apply]
    · rintro ⟨b, hb⟩
      refine ⟨E.symm b, ?_⟩
      rw [← hb, map_mul, ← heH, RingEquiv.symm_apply_apply]

  obtain ⟨iso, hiso⟩ : ∃ iso, iso = Proj.basicOpenIsoSpec
      (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω)
      (MvPolynomial.X (Fin.last (2 * e + 2))) hXc Nat.one_pos := ⟨_, rfl⟩
  have hstar : ∀ x : Spec (.of (HomogeneousLocalization.Away
      (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω)
        (MvPolynomial.X (Fin.last (2 * e + 2))))),
      ((wcSgD Ω (2 * e + 2) (Fin.last (2 * e + 2))).ι (iso.inv x) ∈ @Proj.basicOpen _ _ _ _ _
        (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω) MvPolynomial.gradedAlgebra
        (wcLdpQuad Ω (2 * e + 2) (wcXspSplitCoeff Ω e) : MvPolynomial (Fin (2 * e + 2 + 1)) Ω)) ↔
      HomogeneousLocalization.Away.mk
        (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω) hXc 2
        (wcLdpQuad Ω (2 * e + 2) (wcXspSplitCoeff Ω e) : MvPolynomial (Fin (2 * e + 2 + 1)) Ω)
        (wcLdpQuad Ω (2 * e + 2) (wcXspSplitCoeff Ω e)).2 ∉ x.asIdeal := by
    intro x
    have e1 : (wcSgD Ω (2 * e + 2) (Fin.last (2 * e + 2))).ι (iso.inv x) = Proj.awayι
        (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω)
        (MvPolynomial.X (Fin.last (2 * e + 2))) hXc Nat.one_pos x := by
      rw [← Scheme.Hom.comp_apply, hiso, Proj.basicOpenIsoSpec_inv_ι]
    have hpre := Proj.awayι_preimage_basicOpen
      (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω) hXc Nat.one_pos
      (wcLdpQuad Ω (2 * e + 2) (wcXspSplitCoeff Ω e)).2 (by norm_num : 0 < 2)
    have ha : HomogeneousLocalization.Away.isLocalizationElem hXc
        (wcLdpQuad Ω (2 * e + 2) (wcXspSplitCoeff Ω e)).2 =
        HomogeneousLocalization.Away.mk
          (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω) hXc 2
          (wcLdpQuad Ω (2 * e + 2) (wcXspSplitCoeff Ω e) : MvPolynomial (Fin (2 * e + 2 + 1)) Ω)
          (wcLdpQuad Ω (2 * e + 2) (wcXspSplitCoeff Ω e)).2 := by
      apply HomogeneousLocalization.val_injective
      simp [HomogeneousLocalization.Away.val_mk]
    rw [e1, ← Scheme.Hom.mem_preimage, hpre, ha]
    exact Iff.rfl
  obtain ⟨mz, hmz⟩ : ∃ mz, mz = Spec.map (CommRingCat.ofHom π) ≫ iso.inv := ⟨_, rfl⟩
  have : IsClosedImmersion (Spec.map (CommRingCat.ofHom π)) :=
    IsClosedImmersion.spec_of_surjective _ hπs
  have : IsClosedImmersion mz := by rw [hmz]; infer_instance
  have hrm : Set.range mz = {x | (wcSgD Ω (2 * e + 2) (Fin.last (2 * e + 2))).ι x ∉
      @Proj.basicOpen _ _ _ _ _
      (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω) MvPolynomial.gradedAlgebra
      (wcLdpQuad Ω (2 * e + 2) (wcXspSplitCoeff Ω e) : MvPolynomial (Fin (2 * e + 2 + 1)) Ω)} := by
    ext y
    constructor
    · rintro ⟨z, rfl⟩
      rw [Set.mem_setOf_eq, hmz, Scheme.Hom.comp_apply, hstar, not_not, Spec.map_apply]
      refine (Ideal.mem_comap (f := π) (K := z.asIdeal)).mpr ?_
      have h0 : π (HomogeneousLocalization.Away.mk
          (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω) hXc 2
          (wcLdpQuad Ω (2 * e + 2) (wcXspSplitCoeff Ω e) : MvPolynomial (Fin (2 * e + 2 + 1)) Ω)
          (wcLdpQuad Ω (2 * e + 2) (wcXspSplitCoeff Ω e)).2) = 0 := by
        rw [← RingHom.mem_ker, hπk]
        exact Ideal.mem_span_singleton_self _
      rw [h0]
      exact zero_mem _
    · intro hy
      have hy' : (wcSgD Ω (2 * e + 2) (Fin.last (2 * e + 2))).ι (iso.inv (iso.hom y)) ∉
          @Proj.basicOpen _ _ _ _ _
          (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω) MvPolynomial.gradedAlgebra
          (wcLdpQuad Ω (2 * e + 2) (wcXspSplitCoeff Ω e) :
            MvPolynomial (Fin (2 * e + 2 + 1)) Ω) := by
        rw [Scheme.hom_inv_apply]
        exact hy
      rw [hstar, not_not] at hy'
      have hm : (show PrimeSpectrum (HomogeneousLocalization.Away
          (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω)
            (MvPolynomial.X (Fin.last (2 * e + 2)))) from
          iso.hom y) ∈ PrimeSpectrum.zeroLocus (RingHom.ker π : Set _) := by
        rw [PrimeSpectrum.mem_zeroLocus, hπk]
        exact fun w hw => (Ideal.span_singleton_le_iff_mem _).mpr hy' hw
      rw [← range_comap_of_surjective _ π hπs] at hm
      obtain ⟨z, hz⟩ := hm
      let z' : Spec (.of (wcQuadModelRing Ω (2 * e + 2) 1 (Matrix.of fun p q : Fin (2 * e + 2) =>
        if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : Ω) else 0))) := z
      have e2 : (Spec.map (CommRingCat.ofHom π)) z' = iso.hom y := by
        rw [Spec.map_apply]
        exact hz
      refine ⟨z', ?_⟩
      rw [hmz, Scheme.Hom.comp_apply, e2, Scheme.hom_inv_apply]

  have hrf : Set.range (jY ∣_ wcSgD Ω (2 * e + 2) (Fin.last (2 * e + 2))) =
      {x | (wcSgD Ω (2 * e + 2) (Fin.last (2 * e + 2))).ι x ∉
      @Proj.basicOpen _ _ _ _ _
      (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω) MvPolynomial.gradedAlgebra
      (wcLdpQuad Ω (2 * e + 2) (wcXspSplitCoeff Ω e) : MvPolynomial (Fin (2 * e + 2 + 1)) Ω)} := by
    ext x
    constructor
    · rintro ⟨w, rfl⟩
      show (wcSgD Ω (2 * e + 2) (Fin.last (2 * e + 2))).ι
        ((jY ∣_ wcSgD Ω (2 * e + 2) (Fin.last (2 * e + 2))) w) ∉ _
      rw [← Scheme.Hom.comp_apply, morphismRestrict_ι, Scheme.Hom.comp_apply]
      have hmem : jY ((jY ⁻¹ᵁ wcSgD Ω (2 * e + 2) (Fin.last (2 * e + 2))).ι w) ∈
          Set.range jY := ⟨_, rfl⟩
      rw [hY] at hmem
      exact hmem
    · intro hx
      have hmem : (wcSgD Ω (2 * e + 2) (Fin.last (2 * e + 2))).ι x ∈ Set.range jY := by
        rw [hY]; exact hx
      obtain ⟨w, hw⟩ := hmem
      have hwU : w ∈ jY ⁻¹ᵁ wcSgD Ω (2 * e + 2) (Fin.last (2 * e + 2)) := by
        show jY w ∈ wcSgD Ω (2 * e + 2) (Fin.last (2 * e + 2))
        rw [hw]
        exact x.2
      refine ⟨⟨w, hwU⟩, ?_⟩
      apply (wcSgD Ω (2 * e + 2) (Fin.last (2 * e + 2))).ι.isOpenEmbedding.injective
      have e3 := Scheme.Hom.comp_apply (jY ∣_ wcSgD Ω (2 * e + 2) (Fin.last (2 * e + 2)))
        (wcSgD Ω (2 * e + 2) (Fin.last (2 * e + 2))).ι ⟨w, hwU⟩
      rw [morphismRestrict_ι] at e3
      exact e3.symm.trans hw
  exact s5 _ _ _ (jY ∣_ wcSgD Ω (2 * e + 2) (Fin.last (2 * e + 2))) mz (hrf.trans hrm.symm)

theorem wc_xspl_split_oddq_hyperplane : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (e : ℕ), 1 ≤ e → ∀ (Y : Scheme.{u}) (jY : Y ⟶ wcProjK Ω (2 * e + 2)), IsClosedImmersion jY → Set.range jY = wcXspVplus Ω (2 * e + 2) (wcXspSplitCoeff Ω e) → ∃ (Z : Scheme.{u}) (i : Z ⟶ Y), IsClosedImmersion i ∧ SmoothOfRelativeDimension (2 * e) (i ≫ jY ≫ wcProjKStr Ω (2 * e + 2)) ∧ ConnectedSpace Z ∧ Set.range i = ((jY ⁻¹ᵁ wcSgD Ω (2 * e + 2) (Fin.last (2 * e + 2)) : Y.Opens) : Set Y)ᶜ :=
by
  classical
  intro Ω _ _ e he1 Y jY hjY hY
  haveI := hjY

  have s4 : ∀ {A B σ τ : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A] [CommRing B]
      [SetLike τ B] [AddSubgroupClass τ B] {𝒜 : ℕ → σ} {ℬ : ℕ → τ} [GradedRing 𝒜] [GradedRing ℬ]
      (f : 𝒜 →+*ᵍ ℬ)
      (hf : HomogeneousIdeal.irrelevant ℬ ≤ HomogeneousIdeal.map f (HomogeneousIdeal.irrelevant 𝒜))
      {ι : Type} (s : ι → A) (d : ι → ℕ), (∀ i, s i ∈ 𝒜 (d i)) → (∀ i, 0 < d i) →
      (HomogeneousIdeal.irrelevant 𝒜).toIdeal ≤ Ideal.span (Set.range s) →
      (∀ i, Function.Surjective (HomogeneousLocalization.Away.map f (s i))) →
      IsClosedImmersion (Proj.map f hf) := by
    intro A B σ τ _ _ _ _ _ _ 𝒜 ℬ _ _ f hf ι s d hs hd hcov hsurj
    refine IsZariskiLocalAtTarget.of_iSup_eq_top (P := @IsClosedImmersion)
      (fun i => Proj.basicOpen 𝒜 (s i)) (Proj.iSup_basicOpen_eq_top 𝒜 s hcov) ?_
    intro i
    have hs' : f (s i) ∈ ℬ (d i) := f.map_mem (hs i)
    let iV := Proj.awayι 𝒜 (s i) (hs i) (hd i)
    let iU := Proj.awayι ℬ (f (s i)) hs' (hd i)
    let g := Spec.map (CommRingCat.ofHom (HomogeneousLocalization.Away.map f (s i)))
    have hc : iU ≫ Proj.map f hf = g ≫ iV := Proj.awayι_comp_map f hf (hd i) (s i) (hs i)
    have hpre : Proj.map f hf ⁻¹ᵁ iV.opensRange = iU.opensRange := by
      simp only [iV, iU, Proj.opensRange_awayι]
      exact Proj.map_preimage_basicOpen f hf (s i)
    have hpb : IsPullback g iU iV (Proj.map f hf) := IsOpenImmersion.isPullback g iU iV _ hc hpre
    have hg : IsClosedImmersion g :=
      IsClosedImmersion.spec_of_surjective _ (by simpa using hsurj i)
    have h1 : IsClosedImmersion (Limits.pullback.snd (Proj.map f hf) iV) :=
      (MorphismProperty.arrow_mk_iso_iff @IsClosedImmersion
        (Arrow.isoMk hpb.flip.isoPullback (Iso.refl _)
          (by
            dsimp only [Arrow.mk_hom, Iso.refl_hom]
            rw [Category.comp_id]
            exact IsPullback.isoPullback_hom_snd _))).mp hg
    have h2 : IsClosedImmersion (Proj.map f hf ∣_ iV.opensRange) :=
      (MorphismProperty.arrow_mk_iso_iff @IsClosedImmersion
        (morphismRestrictOpensRange _ iV)).mpr h1
    exact (MorphismProperty.arrow_mk_iso_iff @IsClosedImmersion
      (morphismRestrictEq _ (Proj.opensRange_awayι 𝒜 (s i) (hs i) (hd i)))).mp h2
  have s3 : ∀ {A B σ τ : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A] [CommRing B]
      [SetLike τ B] [AddSubgroupClass τ B] {𝒜 : ℕ → σ} {ℬ : ℕ → τ} [GradedRing 𝒜] [GradedRing ℬ]
      (f : 𝒜 →+*ᵍ ℬ), (∀ (n : ℕ) (b : B), b ∈ ℬ n → ∃ a ∈ 𝒜 n, f a = b) →
      ∀ (s : A) (d : ℕ), s ∈ 𝒜 d → Function.Surjective (HomogeneousLocalization.Away.map f s) := by
    intro A B σ τ _ _ _ _ _ _ 𝒜 ℬ _ _ f hsurj s d hs y
    obtain ⟨n, b, hb, rfl⟩ := HomogeneousLocalization.Away.mk_surjective ℬ (f.map_mem hs) y
    obtain ⟨a, ha, rfl⟩ := hsurj _ b hb
    exact ⟨_, HomogeneousLocalization.Away.map_mk f s hs n a ha⟩
  have s1 : ∀ (n : ℕ) (p : MvPolynomial (Fin n) Ω),
      letI : GradedRing (MvPolynomial.homogeneousSubmodule (Fin n) Ω) := MvPolynomial.gradedAlgebra
      p ∈ HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin n) Ω) ↔
        p.coeff 0 = 0 := by
    intro n p
    letI : GradedRing (MvPolynomial.homogeneousSubmodule (Fin n) Ω) := MvPolynomial.gradedAlgebra
    rw [HomogeneousIdeal.mem_irrelevant_iff, GradedRing.proj_apply]
    erw [MvPolynomial.decomposition.decompose'_apply]
    rw [MvPolynomial.homogeneousComponent_zero, MvPolynomial.C_eq_zero]
  letI iA : GradedRing (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω) :=
    MvPolynomial.gradedAlgebra
  letI iB : GradedRing (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 1 + 1)) Ω) :=
    MvPolynomial.gradedAlgebra

  let g : Fin (2 * e + 2 + 1) → MvPolynomial (Fin (2 * e + 1 + 1)) Ω := fun t =>
    if h : t.val < 2 * e + 1 + 1 then MvPolynomial.X ⟨t.val, h⟩ else 0
  let c : Fin (2 * e + 1 + 1) → Fin (2 * e + 2 + 1) := fun j => ⟨j.val, by have := j.isLt; omega⟩
  have hcinj : Function.Injective c := by
    intro a b h
    simp only [c, Fin.mk.injEq] at h
    exact Fin.ext h
  have hg : ∀ t, (g t).IsHomogeneous 1 := by
    intro t
    dsimp only [g]
    split_ifs
    · exact MvPolynomial.isHomogeneous_X Ω _
    · exact MvPolynomial.isHomogeneous_zero _ _ 1
  have hgc : ∀ j, g (c j) = MvPolynomial.X j := by
    intro j
    have h : (c j).val < 2 * e + 1 + 1 := j.isLt
    dsimp only [g]
    rw [dif_pos h]
  have hX0 : ∀ t, g t = 0 ↔ ¬ t.val < 2 * e + 1 + 1 := by
    intro t
    by_cases h : t.val < 2 * e + 1 + 1
    · have h' : g t = MvPolynomial.X ⟨t.val, h⟩ := by dsimp only [g]; rw [dif_pos h]
      rw [h']
      exact iff_of_false (MvPolynomial.X_ne_zero _) (not_not.mpr h)
    · have h' : g t = 0 := by dsimp only [g]; rw [dif_neg h]
      exact iff_of_true h' h
  have hsurjc : ∀ t, g t ≠ 0 → ∃ j, c j = t := by
    intro t ht
    have h : t.val < 2 * e + 1 + 1 := by
      by_contra h
      exact ht ((hX0 t).mpr h)
    exact ⟨⟨t.val, h⟩, Fin.ext rfl⟩
  have hgz : ∀ t, t ∉ Set.range c → g t = 0 := by
    intro t ht
    by_contra hne
    exact ht (hsurjc t hne)
  have hT : ∀ t : Fin (2 * e + 2 + 1), g t = 0 ↔ t = Fin.last (2 * e + 2) := by
    intro t
    rw [hX0]
    constructor
    · intro h
      exact Fin.ext (by rw [Fin.val_last]; have := t.isLt; omega)
    · intro h
      subst h
      rw [Fin.val_last]
      omega

  let φ : GradedRingHom (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω)
      (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 1 + 1)) Ω) :=
    ⟨(MvPolynomial.aeval g).toRingHom, fun {n x} hx => by
      rw [MvPolynomial.mem_homogeneousSubmodule] at hx ⊢
      have := hx.aeval g hg
      rw [one_mul] at this
      exact this⟩
  let ψ : GradedRingHom (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 1 + 1)) Ω)
      (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω) :=
    ⟨(MvPolynomial.rename c).toRingHom, fun {n x} hx => by
      rw [MvPolynomial.mem_homogeneousSubmodule] at hx ⊢
      exact hx.rename_isHomogeneous⟩
  have hφ : ∀ a, φ a = MvPolynomial.aeval g a := fun a => rfl
  have hψ : ∀ b, ψ b = MvPolynomial.rename c b := fun b => rfl
  have hφψ : ∀ b, φ (ψ b) = b := by
    intro b
    rw [hφ, hψ, MvPolynomial.aeval_rename]
    have hgc' : g ∘ c = MvPolynomial.X := funext hgc
    rw [hgc', MvPolynomial.aeval_X_left_apply]
  have hf : HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 1 + 1)) Ω) ≤
      HomogeneousIdeal.map φ
        (HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω)) := by
    intro b hb
    have hb0 : b.coeff 0 = 0 := (s1 (2 * e + 1 + 1) b).mp hb
    have hψb : ψ b ∈
        HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω) := by
      apply (s1 (2 * e + 2 + 1) (ψ b)).mpr
      rw [hψ]
      rw [← MvPolynomial.constantCoeff_eq] at hb0 ⊢
      exact (MvPolynomial.constantCoeff_rename c b).trans hb0
    rw [← HomogeneousIdeal.mem_iff, HomogeneousIdeal.toIdeal_map, ← hφψ b]
    exact Ideal.mem_map_of_mem φ (HomogeneousIdeal.mem_iff.mpr hψb)
  have hdeg : ∀ (n : ℕ) (b : MvPolynomial (Fin (2 * e + 1 + 1)) Ω),
      b ∈ MvPolynomial.homogeneousSubmodule (Fin (2 * e + 1 + 1)) Ω n →
      ∃ a ∈ MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω n, φ a = b :=
    fun n b hb => ⟨ψ b, ψ.map_mem hb, hφψ b⟩
  have hcov : (HomogeneousIdeal.irrelevant
      (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω)).toIdeal ≤
      Ideal.span (Set.range (MvPolynomial.X : Fin (2 * e + 2 + 1) → MvPolynomial (Fin (2 * e + 2 + 1)) Ω)) := by
    intro x hx
    have hx0 : x.coeff 0 = 0 := (s1 (2 * e + 2 + 1) x).mp (HomogeneousIdeal.mem_iff.mp hx)
    rw [← Set.image_univ, MvPolynomial.mem_ideal_span_X_image]
    intro m hm
    have hm0 : m ≠ 0 := by
      rintro rfl
      exact (MvPolynomial.mem_support_iff.mp hm) hx0
    obtain ⟨i, hi⟩ := Finsupp.ne_iff.mp hm0
    exact ⟨i, Set.mem_univ _, by simpa using hi⟩
  have hX : ∀ i : Fin (2 * e + 2 + 1),
      (MvPolynomial.X i : MvPolynomial (Fin (2 * e + 2 + 1)) Ω) ∈
        MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω 1 :=
    fun i => (MvPolynomial.mem_homogeneousSubmodule 1 _).2 (MvPolynomial.isHomogeneous_X Ω i)

  let L : wcProjK Ω (2 * e + 1) ⟶ wcProjK Ω (2 * e + 2) := Proj.map φ hf
  have hLci : IsClosedImmersion L := s4 φ hf (fun i : Fin (2 * e + 2 + 1) => MvPolynomial.X i)
    (fun _ => 1) hX (fun _ => Nat.one_pos) hcov (fun i => s3 φ hdeg _ 1 (hX i))
  haveI := hLci
  have hpre : ∀ a : MvPolynomial (Fin (2 * e + 2 + 1)) Ω,
      L ⁻¹ᵁ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω) a =
        Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 1 + 1)) Ω) (φ a) :=
    fun a => Proj.map_preimage_basicOpen φ hf a
  let f₀ : ↥(MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω 0) →+*
      ↥(MvPolynomial.homogeneousSubmodule (Fin (2 * e + 1 + 1)) Ω 0) :=
    { toFun := fun a => ⟨φ a, φ.map_mem a.2⟩
      map_one' := Subtype.ext (by
        show φ ((1 : ↥(MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω 0)) :
          MvPolynomial (Fin (2 * e + 2 + 1)) Ω) = _
        rw [SetLike.GradeZero.coe_one, SetLike.GradeZero.coe_one, map_one])
      map_mul' := fun a b => Subtype.ext (by
        show φ ((a * b : ↥(MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω 0)) :
          MvPolynomial (Fin (2 * e + 2 + 1)) Ω) = _
        rw [SetLike.GradeZero.coe_mul, SetLike.GradeZero.coe_mul, map_mul])
      map_zero' := Subtype.ext (by
        show φ ((0 : ↥(MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω 0)) :
          MvPolynomial (Fin (2 * e + 2 + 1)) Ω) = _
        rw [ZeroMemClass.coe_zero, ZeroMemClass.coe_zero, map_zero])
      map_add' := fun a b => Subtype.ext (by
        show φ ((a + b : ↥(MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω 0)) :
          MvPolynomial (Fin (2 * e + 2 + 1)) Ω) = _
        rw [AddMemClass.coe_add, AddMemClass.coe_add, map_add]) }
  have hLstr : L ≫ wcProjKStr Ω (2 * e + 2) = wcProjKStr Ω (2 * e + 1) := by
    have hb := wc_bc_proj_map_toSpecZero φ hf f₀ (fun a => rfl)
    have hcomp : f₀.comp (algebraMap Ω ↥(MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω 0)) =
        algebraMap Ω ↥(MvPolynomial.homogeneousSubmodule (Fin (2 * e + 1 + 1)) Ω 0) := by
      apply RingHom.ext
      intro r
      apply Subtype.ext
      show φ ((algebraMap Ω ↥(MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω 0) r :
        MvPolynomial (Fin (2 * e + 2 + 1)) Ω)) = _
      rw [SetLike.GradeZero.coe_algebraMap, SetLike.GradeZero.coe_algebraMap, hφ]
      exact (MvPolynomial.aeval g).commutes r
    show L ≫ (Proj.toSpecZero _ ≫ Spec.map _) = Proj.toSpecZero _ ≫ Spec.map _
    rw [← Category.assoc, hb, Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp, hcomp]

  have hret : ∀ a : MvPolynomial (Fin (2 * e + 2 + 1)) Ω,
      a - ψ (φ a) ∈ Ideal.span (MvPolynomial.X '' {t : Fin (2 * e + 2 + 1) | g t = 0}) := by
    intro a
    have key : (Ideal.Quotient.mkₐ Ω (Ideal.span (MvPolynomial.X '' {t : Fin (2 * e + 2 + 1) | g t = 0}))).comp
        ((MvPolynomial.rename c).comp (MvPolynomial.aeval g)) =
        Ideal.Quotient.mkₐ Ω (Ideal.span (MvPolynomial.X '' {t : Fin (2 * e + 2 + 1) | g t = 0})) := by
      apply MvPolynomial.algHom_ext
      intro t
      rw [AlgHom.comp_apply, AlgHom.comp_apply, MvPolynomial.aeval_X]
      by_cases ht : g t = 0
      · rw [ht, map_zero, map_zero, Ideal.Quotient.mkₐ_eq_mk, eq_comm, Ideal.Quotient.eq_zero_iff_mem]
        exact Ideal.subset_span ⟨t, ht, rfl⟩
      · obtain ⟨j, rfl⟩ := hsurjc t ht
        rw [hgc, MvPolynomial.rename_X]
    have h2 := congrArg (fun F => F a) key
    simp only [AlgHom.comp_apply] at h2
    rw [Ideal.Quotient.mkₐ_eq_mk] at h2
    rw [hφ, hψ]
    exact Ideal.Quotient.eq.mp h2.symm

  have hrange : ∀ p : wcProjK Ω (2 * e + 2), p ∈ Set.range L ↔
      ∀ t, g t = 0 → (MvPolynomial.X t : MvPolynomial (Fin (2 * e + 2 + 1)) Ω) ∈ p.asHomogeneousIdeal := by
    intro p
    constructor
    · rintro ⟨z, rfl⟩ t ht
      by_contra hn
      have h1 : L z ∈ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω)
          (MvPolynomial.X t) := (Proj.mem_basicOpen _ _ _).mpr hn
      have h2 := (Scheme.Hom.mem_preimage L).mpr h1
      rw [hpre, hφ, MvPolynomial.aeval_X, ht, Proj.basicOpen_zero] at h2
      exact TopologicalSpace.Opens.mem_bot.mp h2
    · intro H
      haveI hpr : p.asHomogeneousIdeal.toIdeal.IsPrime := p.isPrime
      have hK : Ideal.span (MvPolynomial.X '' {t : Fin (2 * e + 2 + 1) | g t = 0}) ≤
          p.asHomogeneousIdeal.toIdeal := by
        rw [Ideal.span_le]
        rintro _ ⟨t, ht, rfl⟩
        exact H t ht
      obtain ⟨i, hi⟩ : ∃ i : Fin (2 * e + 2 + 1),
          (MvPolynomial.X i : MvPolynomial (Fin (2 * e + 2 + 1)) Ω) ∉ p.asHomogeneousIdeal.toIdeal := by
        by_contra hno
        push_neg at hno
        apply ProjectiveSpectrum.not_irrelevant_le p
        intro x hx
        have h3 := hcov (HomogeneousIdeal.mem_iff.mpr hx)
        have hle : Ideal.span (Set.range (MvPolynomial.X : Fin (2 * e + 2 + 1) →
            MvPolynomial (Fin (2 * e + 2 + 1)) Ω)) ≤ p.asHomogeneousIdeal.toIdeal := by
          rw [Ideal.span_le]
          rintro _ ⟨j, rfl⟩
          exact hno j
        exact HomogeneousIdeal.mem_iff.mp (hle h3)
      have hgi : g i ≠ 0 := fun h0 => hi (hK (Ideal.subset_span ⟨i, h0, rfl⟩))
      obtain ⟨j, rfl⟩ := hsurjc i hgi
      let q := HomogeneousIdeal.comap ψ p.asHomogeneousIdeal
      have hq : q.toIdeal = Ideal.comap ψ p.asHomogeneousIdeal.toIdeal :=
        HomogeneousIdeal.toIdeal_comap ψ
      haveI hqp : q.toIdeal.IsPrime := by rw [hq]; exact Ideal.comap_isPrime ψ _
      have hqrel : ¬ HomogeneousIdeal.irrelevant
          (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 1 + 1)) Ω) ≤ q := by
        intro hle
        have hXj : (MvPolynomial.X j : MvPolynomial (Fin (2 * e + 1 + 1)) Ω) ∈ HomogeneousIdeal.irrelevant
            (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 1 + 1)) Ω) :=
          (s1 (2 * e + 1 + 1) _).mpr (MvPolynomial.coeff_zero_X j)
        have h1 : (MvPolynomial.X j : MvPolynomial (Fin (2 * e + 1 + 1)) Ω) ∈ q.toIdeal :=
          HomogeneousIdeal.mem_iff.mpr (hle hXj)
        rw [hq, Ideal.mem_comap, hψ, MvPolynomial.rename_X] at h1
        exact hi h1
      let z : (wcProjK Ω (2 * e + 1) : Scheme.{u}) :=
        (⟨q, hqp, hqrel⟩ : ProjectiveSpectrum (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 1 + 1)) Ω))
      refine ⟨z, ?_⟩
      apply ProjectiveSpectrum.ext
      apply HomogeneousIdeal.ext
      ext a
      have e1 : a ∈ (L z).asHomogeneousIdeal ↔ φ a ∈ z.asHomogeneousIdeal := by
        have h1 : L z ∈ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω) a ↔
            z ∈ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 1 + 1)) Ω) (φ a) := by
          rw [← hpre a]
          exact (Scheme.Hom.mem_preimage L).symm
        rw [Proj.mem_basicOpen, Proj.mem_basicOpen] at h1
        exact not_iff_not.mp h1
      rw [HomogeneousIdeal.mem_iff, e1]
      show φ a ∈ q ↔ _
      rw [← HomogeneousIdeal.mem_iff, hq, Ideal.mem_comap]
      have hd := hK (hret a)
      constructor
      · intro h
        have h4 := Ideal.add_mem _ hd h
        rwa [sub_add_cancel] at h4
      · intro h
        have h4 := Ideal.sub_mem _ h hd
        rwa [sub_sub_cancel] at h4
  have hLrange : ∀ p : wcProjK Ω (2 * e + 2), p ∈ Set.range L ↔
      p ∉ wcSgD Ω (2 * e + 2) (Fin.last (2 * e + 2)) := by
    intro p
    rw [hrange]
    constructor
    · intro H hmem
      exact (Proj.mem_basicOpen _ _ _).mp hmem (H _ ((hT _).mpr rfl))
    · intro H t ht
      rw [(hT t).mp ht]
      by_contra hn
      exact H ((Proj.mem_basicOpen _ _ _).mpr hn)

  obtain ⟨hypf, hhypf⟩ : ∃ a : Fin (2 * e + 1 + 1) → Fin (2 * e + 1 + 1) → Ω,
      a = fun (p q : Fin (2 * e + 1 + 1)) =>
        if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : Ω) else 0 := ⟨_, rfl⟩
  have hdet : (Matrix.of hypf + (Matrix.of hypf).transpose).det ≠ 0 := by
    rw [hhypf]
    let f : Fin (2 * e + 1 + 1) → Fin (2 * e + 1 + 1) := fun p =>
      ⟨if p.val % 2 = 0 then p.val + 1 else p.val - 1, by split_ifs <;> omega⟩
    have hf : Function.Involutive f := by
      intro p
      apply Fin.ext
      simp only [f]
      split_ifs <;> omega
    have hS : Matrix.of (fun p q : Fin (2 * e + 1 + 1) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : Ω) else 0) +
        (Matrix.of (fun p q : Fin (2 * e + 1 + 1) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : Ω) else 0)).transpose =
        Equiv.Perm.permMatrix Ω (Function.Involutive.toPerm f hf) := by
      ext p q
      simp only [Matrix.add_apply, Matrix.of_apply, Matrix.transpose_apply, Equiv.Perm.permMatrix,
        PEquiv.toMatrix_apply, Equiv.toPEquiv_apply, Option.mem_def, Option.some.injEq,
        Function.Involutive.coe_toPerm, f, Fin.ext_iff]
      split_ifs <;> first | omega | norm_num
    rw [hS, Matrix.det_permutation]
    rcases Int.units_eq_one_or (Equiv.Perm.sign (Function.Involutive.toPerm f hf)) with h | h <;>
      simp [h]

  obtain ⟨G, hGdef⟩ : ∃ G : MvPolynomial (Fin (2 * e + 2 + 1)) Ω,
      G = (wcLdpQuad Ω (2 * e + 2) (wcXspSplitCoeff Ω e) : MvPolynomial (Fin (2 * e + 2 + 1)) Ω) :=
    ⟨_, rfl⟩
  have hcoef : ∀ p' q' : Fin (2 * e + 1 + 1), hypf p' q' = wcXspSplitCoeff Ω e (c p') (c q') := by
    intro p' q'
    have hp := p'.isLt
    rw [hhypf]
    show (if p'.val % 2 = 0 ∧ q'.val = p'.val + 1 then (1 : Ω) else 0) =
      (if p'.val % 2 = 0 ∧ q'.val = p'.val + 1 ∧ p'.val < 2 * e + 2 then (1 : Ω) else
        if p'.val = 2 * e + 2 ∧ q'.val = 2 * e + 2 then -1 else 0)
    split_ifs <;> first | rfl | (exfalso; omega)
  have hpoly : MvPolynomial.aeval g G =
      (wcLdpQuad Ω (2 * e + 1) hypf : MvPolynomial (Fin (2 * e + 1 + 1)) Ω) := by
    rw [hGdef]
    show MvPolynomial.aeval g (∑ p : Fin (2 * e + 2 + 1), ∑ q : Fin (2 * e + 2 + 1),
      MvPolynomial.C (wcXspSplitCoeff Ω e p q) * (MvPolynomial.X p * MvPolynomial.X q)) =
      ∑ p : Fin (2 * e + 1 + 1), ∑ q : Fin (2 * e + 1 + 1),
        MvPolynomial.C (hypf p q) * (MvPolynomial.X p * MvPolynomial.X q)
    have hterm : ∀ p q : Fin (2 * e + 2 + 1), MvPolynomial.aeval g
        (MvPolynomial.C (wcXspSplitCoeff Ω e p q) * (MvPolynomial.X p * MvPolynomial.X q)) =
        MvPolynomial.C (wcXspSplitCoeff Ω e p q) * (g p * g q) := by
      intro p q
      rw [map_mul, map_mul, MvPolynomial.aeval_C, MvPolynomial.aeval_X, MvPolynomial.aeval_X,
        MvPolynomial.algebraMap_eq]
    simp only [map_sum, hterm]
    symm
    refine Fintype.sum_of_injective c hcinj _ _ ?_ ?_
    · intro p hp
      apply Finset.sum_eq_zero
      intro q _
      rw [hgz p hp, zero_mul, mul_zero]
    · intro p'
      refine Fintype.sum_of_injective c hcinj _ _ ?_ ?_
      · intro q hq
        rw [hgz q hq, mul_zero, mul_zero]
      · intro q'
        rw [hgc p', hgc q', hcoef p' q']

  have hLG : ∀ z : wcProjK Ω (2 * e + 1),
      L z ∈ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω) G ↔
      z ∈ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 1 + 1)) Ω)
        (wcLdpQuad Ω (2 * e + 1) hypf : MvPolynomial (Fin (2 * e + 1 + 1)) Ω) := by
    intro z
    rw [← hpoly, ← hφ G, ← hpre G]
    exact (Scheme.Hom.mem_preimage L).symm

  have hX1 : ∀ k : Fin (2 * e + 1 + 1), (MvPolynomial.X k : MvPolynomial (Fin (2 * e + 1 + 1)) Ω) ∈
      MvPolynomial.homogeneousSubmodule (Fin (2 * e + 1 + 1)) Ω 1 := fun k =>
    (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X _ k)
  have hcover1 : ∀ q : wcProjK Ω (2 * e + 1), ∃ a : Fin (2 * e + 1 + 1), q ∈ wcSgD Ω (2 * e + 1) a := by
    intro q
    by_contra hno
    push_neg at hno
    apply ProjectiveSpectrum.not_irrelevant_le q
    intro x hx
    have hx0 : x.coeff 0 = 0 := (s1 (2 * e + 1 + 1) x).mp hx
    have hspan : x ∈ Ideal.span (MvPolynomial.X '' (Set.univ : Set (Fin (2 * e + 1 + 1)))) := by
      rw [MvPolynomial.mem_ideal_span_X_image]
      intro m hm
      have hm0 : m ≠ 0 := by
        rintro rfl
        exact (MvPolynomial.mem_support_iff.mp hm) hx0
      obtain ⟨i, hi⟩ := Finsupp.ne_iff.mp hm0
      exact ⟨i, Set.mem_univ _, by simpa using hi⟩
    have hle : Ideal.span (MvPolynomial.X '' (Set.univ : Set (Fin (2 * e + 1 + 1)))) ≤
        q.asHomogeneousIdeal.toIdeal := by
      rw [Ideal.span_le, Set.image_subset_iff]
      intro i _
      have h8 := hno i
      rw [Proj.mem_basicOpen, not_not] at h8
      exact h8
    exact hle hspan
  have L1 : ∀ {σ : Type u} {A : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
      (𝒜 : ℕ → σ) [GradedRing 𝒜] (f g : A) (hf : f ∈ 𝒜 1) (hg : g ∈ 𝒜 2) (hg' : g ∈ 𝒜 (2 • 1)),
      Proj.basicOpen 𝒜 f ⊓ Proj.basicOpen 𝒜 g = (Proj 𝒜).basicOpen
        (Proj.awayToSection 𝒜 f (HomogeneousLocalization.Away.mk 𝒜 hf 2 g hg')) := by
    intro σ A _ _ _ 𝒜 _ f g hf hg hg'
    have ha : HomogeneousLocalization.Away.isLocalizationElem hf hg =
        HomogeneousLocalization.Away.mk 𝒜 hf 2 g hg' := by
      apply HomogeneousLocalization.val_injective
      simp [HomogeneousLocalization.Away.val_mk]
    have hb : (Proj.basicOpen 𝒜 f).ι ⁻¹ᵁ Proj.basicOpen 𝒜 g =
        (Proj.basicOpenIsoSpec 𝒜 f hf Nat.one_pos).hom ⁻¹ᵁ
          PrimeSpectrum.basicOpen (HomogeneousLocalization.Away.mk 𝒜 hf 2 g hg') := by
      have h1 := Proj.awayι_preimage_basicOpen 𝒜 hf Nat.one_pos hg (by norm_num : 0 < 2)
      rw [← Proj.basicOpenIsoSpec_inv_ι, Scheme.Hom.comp_preimage, ha] at h1
      rw [← h1, ← Scheme.Hom.comp_preimage, Iso.hom_inv_id, Scheme.Hom.id_preimage]
    have hd' : (Proj 𝒜).basicOpen (Proj.awayToSection 𝒜 f
          (HomogeneousLocalization.Away.mk 𝒜 hf 2 g hg')) =
        (Proj.basicOpen 𝒜 f).ι ''ᵁ ((Proj.basicOpenIsoSpec 𝒜 f hf Nat.one_pos).hom ⁻¹ᵁ
          PrimeSpectrum.basicOpen (HomogeneousLocalization.Away.mk 𝒜 hf 2 g hg')) := by
      have hsp := basicOpen_eq_of_affine (R := CommRingCat.of (HomogeneousLocalization.Away 𝒜 f))
        (HomogeneousLocalization.Away.mk 𝒜 hf 2 g hg')
      have h3 : (Proj.basicOpenIsoSpec 𝒜 f hf Nat.one_pos).hom ⁻¹ᵁ
          PrimeSpectrum.basicOpen (HomogeneousLocalization.Away.mk 𝒜 hf 2 g hg') =
          (Proj.basicOpenIsoSpec 𝒜 f hf Nat.one_pos).hom ⁻¹ᵁ
          (Spec _).basicOpen ((Scheme.ΓSpecIso _).inv
            (HomogeneousLocalization.Away.mk 𝒜 hf 2 g hg')) :=
