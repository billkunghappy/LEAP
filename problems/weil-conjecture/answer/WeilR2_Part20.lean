      Scheme.SpecMap_stalkMap_fromSpecStalk f
    haveI : WeaklyEtale (Spec.map (f.stalkMap x) ≫ S.fromSpecStalk (f x)) := by
      rw [hsq]; infer_instance
    haveI hθS : WeaklyEtale (Spec.map (f.stalkMap x)) :=
      WeaklyEtale.of_comp _ (S.fromSpecStalk (f x))
    have hWE := wc_lpkt_specMap_weaklyEtale_ring _ _ (f.stalkMap x).hom
      (by rwa [CommRingCat.ofHom_hom])
    haveI := h1
    haveI : IsSepClosed (IsLocalRing.ResidueField (X.presheaf.stalk x)) := h2
    exact (wc_tla_shens_noeth_unram _ _ (f.stalkMap x).hom inferInstance hWE).1
  exact key V.left V.hom V.prop z hz.1 hz.2

theorem wc_closed_supp_ext_closed_coeff_transfer {X T P : Scheme.{u}} [IsLocallyNoetherian X]
    {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (iT : T ⟶ X) (iP : P ⟶ X) [IsClosedImmersion iT] [IsClosedImmersion iP]
    (hTP : Set.range iT ⊆ Set.range iP)
    (DT : wcHMPullData iT ℓ) (hDT : wcHMPullCanonical DT)
    (DP : wcHMPullData iP ℓ) (hDP : wcHMPullCanonical DP)
    (Dj : wcHMPullData (Limits.pullback.fst iP iT) ℓ) (hDj : wcHMPullCanonical Dj) (q : ℕ) :
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf X ℓ)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf P ℓ)) := HasExt.standard _
    ∃ Θ : wcSuppExt Dj q ≃+ Abelian.Ext (wcSuppObj DT) (wcSuppObj DP) q,
      ∀ (c : ℚ_[ℓ]) (e : wcSuppExt Dj q),
        Θ (e.comp (Abelian.Ext.mk₀ (wcHMConst P ℓ c)) (add_zero q)) =
          (Abelian.Ext.mk₀ ((@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC iT) _ _
            DT.cont DT.φ).map (wcHMConst T ℓ c))).comp (Θ e) (zero_add q) :=
by
  classical
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf X ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf P ℓ)) := HasExt.standard _

  have hB : ∀ {S S' : Scheme.{u}} {f : S' ⟶ S} (D : wcHMPullData f ℓ), wcHMPullCanonical D →
      ∀ c : ℚ_[ℓ], wcSuppUnitMap D ≫
        (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC f) _ _ D.cont D.φ).map
          (wcHMConst S' ℓ c) = wcHMConst S ℓ c ≫ wcSuppUnitMap D := by
    intro S S' f D hD c
    have hst : D.μ.hom ≫ wcHMConst S' ℓ c = D.Φ.map (wcHMConst S ℓ c) ≫ D.μ.hom := by
      rw [← wc_hm_pull_const D hD c, Iso.hom_inv_id_assoc]
    have hnat := D.adj.unit_naturality (wcHMConst S ℓ c)
    unfold wcSuppUnitMap
    erw [Category.assoc, ← Functor.map_comp, hst, Functor.map_comp, ← Category.assoc, hnat,
      Category.assoc]

  haveI := DP.additive
  haveI : (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC iP) _ _ DP.cont DP.φ).Additive :=
    @Adjunction.right_adjoint_additive _ _ _ _ _ _ _ _ DP.adj DP.additive
  haveI : Limits.PreservesFiniteLimits
      (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC iP) _ _ DP.cont DP.φ) := by
    haveI := DP.adj.rightAdjoint_preservesLimits
    infer_instance
  haveI : Limits.PreservesFiniteColimits
      (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC iP) _ _ DP.cont DP.φ) :=
    wc_closed_pushforward_exact_of_noetherian iP ℓ DP
  haveI := DP.presLim
  haveI : EnoughInjectives (SheafOfModules.{u+1} (wcRingSheaf P ℓ)) :=
    sheafOfModules_enoughInjectives (Scheme.ProEt.topology P) (wcRingSheaf P ℓ)

  have key : ∀ (L : SheafOfModules.{u+1} (wcRingSheaf X ℓ) ⥤ SheafOfModules.{u+1} (wcRingSheaf P ℓ))
      (R : SheafOfModules.{u+1} (wcRingSheaf P ℓ) ⥤ SheafOfModules.{u+1} (wcRingSheaf X ℓ))
      (adj : L ⊣ R) [R.Additive] [Limits.PreservesFiniteLimits R]
      [Limits.PreservesFiniteColimits R] [L.PreservesMonomorphisms]
      (X₀ : SheafOfModules.{u+1} (wcRingSheaf X ℓ)) (M Y : SheafOfModules.{u+1} (wcRingSheaf P ℓ))
      [IsIso (adj.counit.app M)] (φ : R.obj M ⟶ X₀) (ψ : X₀ ⟶ R.obj M)
      (h1 : φ ≫ ψ = 𝟙 _) (h2 : ψ ≫ φ = 𝟙 _),
      ∃ Θ : Abelian.Ext M Y q ≃+ Abelian.Ext X₀ (R.obj Y) q,
        ∀ (σ : X₀ ⟶ X₀) (κ : M ⟶ M), ψ ≫ R.map κ ≫ φ = σ → ∀ e : Abelian.Ext M Y q,
          Θ ((Abelian.Ext.mk₀ κ).comp e (zero_add q)) =
            (Abelian.Ext.mk₀ σ).comp (Θ e) (zero_add q) := by
    intro L R adj _ _ _ _ X₀ M Y _ φ ψ h1 h2
    let ξ : L.obj X₀ ≅ M := L.mapIso ⟨ψ, φ, h2, h1⟩ ≪≫ asIso (adj.counit.app M)
    have hξh : ξ.hom = L.map ψ ≫ adj.counit.app M := rfl
    have hBij := wc_ext_adjoint_transfer L R adj X₀ Y q
    have hP : Function.Bijective
        (fun e : Abelian.Ext M Y q => (Abelian.Ext.mk₀ ξ.hom).comp e (zero_add q)) := by
      refine ⟨fun a b hab => ?_, fun b => ⟨(Abelian.Ext.mk₀ ξ.inv).comp b (zero_add q), ?_⟩⟩
      · have h := congrArg (fun x => (Abelian.Ext.mk₀ ξ.inv).comp x (zero_add q)) hab
        simp only [Abelian.Ext.mk₀_comp_mk₀_assoc, Iso.inv_hom_id, Abelian.Ext.mk₀_id_comp] at h
        exact h
      · simp only [Abelian.Ext.mk₀_comp_mk₀_assoc, Iso.hom_inv_id, Abelian.Ext.mk₀_id_comp]
    let f : Abelian.Ext M Y q →+ Abelian.Ext X₀ (R.obj Y) q :=
      AddMonoidHom.mk' (fun e => (Abelian.Ext.mk₀ (adj.unit.app X₀)).comp
        (Abelian.Ext.mapExactFunctor R ((Abelian.Ext.mk₀ ξ.hom).comp e (zero_add q))) (zero_add q))
        (fun a b => by
          rw [Abelian.Ext.comp_add, Abelian.Ext.mapExactFunctor_add, Abelian.Ext.comp_add])
    refine ⟨AddEquiv.ofBijective f (hBij.comp hP), ?_⟩
    intro σ κ hσκ e
    have hξ : ξ.hom ≫ κ = L.map σ ≫ ξ.hom := by
      rw [hξh, Category.assoc, ← adj.counit_naturality κ,
        ← Category.assoc (L.map ψ), ← Functor.map_comp, ← Functor.map_comp_assoc, ← hσκ,
        Category.assoc, Category.assoc, h1, Category.comp_id]
    show (Abelian.Ext.mk₀ (adj.unit.app X₀)).comp (Abelian.Ext.mapExactFunctor R
        ((Abelian.Ext.mk₀ ξ.hom).comp ((Abelian.Ext.mk₀ κ).comp e (zero_add q)) (zero_add q)))
          (zero_add q) =
      (Abelian.Ext.mk₀ σ).comp ((Abelian.Ext.mk₀ (adj.unit.app X₀)).comp
        (Abelian.Ext.mapExactFunctor R ((Abelian.Ext.mk₀ ξ.hom).comp e (zero_add q)))
          (zero_add q)) (zero_add q)
    rw [Abelian.Ext.mk₀_comp_mk₀_assoc ξ.hom κ, hξ,
      ← Abelian.Ext.mk₀_comp_mk₀_assoc (L.map σ) ξ.hom,
      Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
      Abelian.Ext.mk₀_comp_mk₀_assoc (adj.unit.app X₀) (R.map (L.map σ)),
      adj.unit_naturality σ, ← Abelian.Ext.mk₀_comp_mk₀_assoc σ (adj.unit.app X₀)]

  have alg : ∀ (sF tA a b ca cb : ULift.{u+1} ℚ_[ℓ]), sF * b = 0 → sF = tA * a → a * ca = 1 →
      b * cb = 1 → tA = 0 := by
    intro sF tA a b ca cb e1 e2 e3 e4
    linear_combination (-tA) * e3 + (-(tA * a * ca)) * e4 + (ca * cb) * e1 - (ca * cb * b) * e2
  have alg0 : ∀ a b c : ULift.{u+1} ℚ_[ℓ], a = 0 → a * b * c = 0 := by
    intro a b c h; rw [h, zero_mul, zero_mul]

  have s2 : ∀ {Q : SheafOfModules.{u+1} (wcRingSheaf X ℓ)}
      (g : Q ⟶ SheafOfModules.unit (wcRingSheaf X ℓ)),
      g ≫ wcSuppUnitMap DT = 0 ↔
        ∀ (V : X.ProEt) (p : Q.val.obj (Opposite.op V)) (x : ↥V.left),
          V.hom x ∈ Set.range iT →
          (@id C(↥V.left, ULift.{u+1} ℚ_[ℓ]) ((g.val.app (Opposite.op V)).hom p)) x = 0 := by
    intro Q g
    constructor
    · intro h0 V p x hx
      have hk := congrArg (fun φ => (φ.val.app (Opposite.op V)).hom p) h0
      change ((wcSuppUnitMap DT).val.app (Opposite.op V)).hom
        ((g.val.app (Opposite.op V)).hom p) = 0 at hk
      have hx' : x ∈ Set.range (Limits.pullback.fst V.hom iT) := by
        rw [Scheme.Pullback.range_fst]; exact hx
      obtain ⟨z, rfl⟩ := hx'
      obtain ⟨c', hc'⟩ := wc_supp_unit_twist_isUnit DT
      have htw := wc_supp_hom_twist_formula DT hDT (wcSuppUnitMap DT) V
        ((g.val.app (Opposite.op V)).hom p)
      rw [hk] at htw
      have h1 := congrArg
        (fun φ : C(↥(Limits.pullback V.hom iT), ULift.{u+1} ℚ_[ℓ]) => φ z) htw
      have h2 := congrArg (fun φ : C(↥T, ULift.{u+1} ℚ_[ℓ]) =>
        φ ((Limits.pullback.snd V.hom iT).base.hom z)) hc'
      simp only [ContinuousMap.mul_apply, ContinuousMap.comp_apply,
        ContinuousMap.one_apply] at h1 h2
      have h1' : (0 : ULift.{u+1} ℚ_[ℓ]) =
          (@id C(↥V.left, ULift.{u+1} ℚ_[ℓ]) ((g.val.app (Opposite.op V)).hom p))
              ((Limits.pullback.fst V.hom iT).base.hom z) *
            (wcSuppTwist (wcSuppUnitMap DT))
              ((Limits.pullback.snd V.hom iT).base.hom z) := h1
      show (@id C(↥V.left, ULift.{u+1} ℚ_[ℓ]) ((g.val.app (Opposite.op V)).hom p))
        ((Limits.pullback.fst V.hom iT).base.hom z) = 0
      linear_combination
        (-(c' ((Limits.pullback.snd V.hom iT).base.hom z))) * h1' -
        ((@id C(↥V.left, ULift.{u+1} ℚ_[ℓ]) ((g.val.app (Opposite.op V)).hom p))
          ((Limits.pullback.fst V.hom iT).base.hom z)) * h2
    · intro hv
      apply SheafOfModules.hom_ext
      apply PresheafOfModules.hom_ext
      intro W
      apply ModuleCat.hom_ext
      apply LinearMap.ext
      intro p
      induction W using Opposite.rec with
      | op W =>
      change ((wcSuppUnitMap DT).val.app (Opposite.op W)).hom
        ((g.val.app (Opposite.op W)).hom p) = 0
      have htw := wc_supp_hom_twist_formula DT hDT (wcSuppUnitMap DT) W
        ((g.val.app (Opposite.op W)).hom p)
      refine htw.trans (ContinuousMap.ext fun z => ?_)
      have hz : W.hom ((Limits.pullback.fst W.hom iT).base z) ∈ Set.range iT :=
        ⟨(Limits.pullback.snd W.hom iT).base z,
          (congrArg (fun φ => φ.base z) (Limits.pullback.condition (f := W.hom) (g := iT))).symm⟩
      have h0 := hv W p _ hz
      show (@id C(↥W.left, ULift.{u+1} ℚ_[ℓ]) ((g.val.app (Opposite.op W)).hom p))
          ((Limits.pullback.fst W.hom iT).base.hom z) *
        (wcSuppTwist (wcSuppUnitMap DT)) ((Limits.pullback.snd W.hom iT).base.hom z) = 0
      rw [h0, zero_mul]

  have s2' : ∀ {Q : SheafOfModules.{u+1} (wcRingSheaf X ℓ)}
      (g : Q ⟶ SheafOfModules.unit (wcRingSheaf X ℓ)),
      g ≫ (wcSuppUnitMap DP ≫ (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC iP) _ _
        DP.cont DP.φ).map (wcSuppUnitMap Dj)) = 0 ↔
        ∀ (V : X.ProEt) (p : Q.val.obj (Opposite.op V)) (x : ↥V.left),
          V.hom x ∈ Set.range iT →
          (@id C(↥V.left, ULift.{u+1} ℚ_[ℓ]) ((g.val.app (Opposite.op V)).hom p)) x = 0 := by
    intro Q g
    constructor
    · intro h0 V p x hx
      have hk := congrArg (fun φ => (φ.val.app (Opposite.op V)).hom p) h0
      change ((wcSuppUnitMap Dj).val.app (Opposite.op ((wcProEtBC iP).obj V))).hom
        (((wcSuppUnitMap DP).val.app (Opposite.op V)).hom
          ((g.val.app (Opposite.op V)).hom p)) = 0 at hk
      obtain ⟨t0, ht0⟩ := hx
      obtain ⟨p0, hp0⟩ := hTP ⟨t0, rfl⟩
      obtain ⟨y, hy1, hy2⟩ := Scheme.Pullback.exists_preimage_pullback (f := iP) (g := iT) p0 t0 hp0
      obtain ⟨w, hw1, hw2⟩ := Scheme.Pullback.exists_preimage_pullback (f := V.hom) (g := iP) x p0
        (ht0.symm.trans hp0.symm)
      obtain ⟨z, hz1, hz2⟩ := Scheme.Pullback.exists_preimage_pullback
        (f := ((wcProEtBC iP).obj V).hom) (g := Limits.pullback.fst iP iT) w y
        (hw2.trans hy1.symm)
      obtain ⟨cP, hcP⟩ := wc_supp_unit_twist_isUnit DP
      obtain ⟨cJ, hcJ⟩ := wc_supp_unit_twist_isUnit Dj
      have ht1 := wc_supp_hom_twist_formula Dj hDj (wcSuppUnitMap Dj) ((wcProEtBC iP).obj V)
        (((wcSuppUnitMap DP).val.app (Opposite.op V)).hom ((g.val.app (Opposite.op V)).hom p))
      have ht2 := wc_supp_hom_twist_formula DP hDP (wcSuppUnitMap DP) V
        ((g.val.app (Opposite.op V)).hom p)
      rw [hk] at ht1
      have h1 := congrArg (fun φ : C(↥(Limits.pullback ((wcProEtBC iP).obj V).hom
        (Limits.pullback.fst iP iT)), ULift.{u+1} ℚ_[ℓ]) => φ z) ht1
      have h2 := congrArg (fun φ : C(↥(Limits.pullback V.hom iP), ULift.{u+1} ℚ_[ℓ]) =>
        φ ((Limits.pullback.fst ((wcProEtBC iP).obj V).hom (Limits.pullback.fst iP iT)).base.hom z))
        ht2
      have h3 := congrArg (fun φ : C(↥P, ULift.{u+1} ℚ_[ℓ]) =>
        φ ((Limits.pullback.snd V.hom iP).base.hom
          ((Limits.pullback.fst ((wcProEtBC iP).obj V).hom
            (Limits.pullback.fst iP iT)).base.hom z))) hcP
      have h4 := congrArg (fun φ : C(↥(Limits.pullback iP iT), ULift.{u+1} ℚ_[ℓ]) =>
        φ ((Limits.pullback.snd ((wcProEtBC iP).obj V).hom
          (Limits.pullback.fst iP iT)).base.hom z)) hcJ
      simp only [ContinuousMap.mul_apply, ContinuousMap.comp_apply,
        ContinuousMap.one_apply, ContinuousMap.zero_apply] at h1 h2 h3 h4
      rw [← hw1, ← hz1]
      exact alg _ _ _ _ _ _ h1.symm h2 h3 h4
    · intro hv
      apply SheafOfModules.hom_ext
      apply PresheafOfModules.hom_ext
      intro V'
      apply ModuleCat.hom_ext
      apply LinearMap.ext
      intro p
      induction V' using Opposite.rec with
      | op V =>
      change ((wcSuppUnitMap Dj).val.app (Opposite.op ((wcProEtBC iP).obj V))).hom
        (((wcSuppUnitMap DP).val.app (Opposite.op V)).hom
          ((g.val.app (Opposite.op V)).hom p)) = 0
      have ht1 := wc_supp_hom_twist_formula Dj hDj (wcSuppUnitMap Dj) ((wcProEtBC iP).obj V)
        (((wcSuppUnitMap DP).val.app (Opposite.op V)).hom ((g.val.app (Opposite.op V)).hom p))
      have ht2 := wc_supp_hom_twist_formula DP hDP (wcSuppUnitMap DP) V
        ((g.val.app (Opposite.op V)).hom p)
      refine ht1.trans (ContinuousMap.ext fun z => ?_)
      have e1 : Limits.pullback.fst V.hom iP ≫ V.hom = Limits.pullback.snd V.hom iP ≫ iP :=
        Limits.pullback.condition
      have e2 : Limits.pullback.fst ((wcProEtBC iP).obj V).hom (Limits.pullback.fst iP iT) ≫
          Limits.pullback.snd V.hom iP =
          Limits.pullback.snd ((wcProEtBC iP).obj V).hom (Limits.pullback.fst iP iT) ≫
            Limits.pullback.fst iP iT :=
        Limits.pullback.condition
      have e3 : Limits.pullback.fst iP iT ≫ iP = Limits.pullback.snd iP iT ≫ iT :=
        Limits.pullback.condition
      have p1 := congrArg (fun φ => φ.base ((Limits.pullback.fst ((wcProEtBC iP).obj V).hom
        (Limits.pullback.fst iP iT)).base z)) e1
      have p2 := congrArg (fun φ => φ.base z) e2
      have p3 := congrArg (fun φ => φ.base ((Limits.pullback.snd ((wcProEtBC iP).obj V).hom
        (Limits.pullback.fst iP iT)).base z)) e3
      have hz : V.hom ((Limits.pullback.fst V.hom iP).base
          ((Limits.pullback.fst ((wcProEtBC iP).obj V).hom (Limits.pullback.fst iP iT)).base z)) ∈
          Set.range iT :=
        ⟨_, (p1.trans ((congrArg (fun y => iP.base y) p2).trans p3)).symm⟩
      have h0 := hv V p _ hz
      have h2z : (@id C(↥(Limits.pullback V.hom iP), ULift.{u+1} ℚ_[ℓ])
          (((wcSuppUnitMap DP).val.app (Opposite.op V)).hom ((g.val.app (Opposite.op V)).hom p)))
          ((Limits.pullback.fst ((wcProEtBC iP).obj V).hom (Limits.pullback.fst iP iT)).base.hom z) =
          (@id C(↥V.left, ULift.{u+1} ℚ_[ℓ]) ((g.val.app (Opposite.op V)).hom p))
            ((Limits.pullback.fst V.hom iP).base.hom
              ((Limits.pullback.fst ((wcProEtBC iP).obj V).hom
                (Limits.pullback.fst iP iT)).base.hom z)) *
          (wcSuppTwist (wcSuppUnitMap DP)) ((Limits.pullback.snd V.hom iP).base.hom
              ((Limits.pullback.fst ((wcProEtBC iP).obj V).hom
                (Limits.pullback.fst iP iT)).base.hom z)) :=
        congrArg (fun φ : C(↥(Limits.pullback V.hom iP), ULift.{u+1} ℚ_[ℓ]) =>
          φ ((Limits.pullback.fst ((wcProEtBC iP).obj V).hom
            (Limits.pullback.fst iP iT)).base.hom z)) ht2
      show (@id C(↥(Limits.pullback V.hom iP), ULift.{u+1} ℚ_[ℓ])
          (((wcSuppUnitMap DP).val.app (Opposite.op V)).hom ((g.val.app (Opposite.op V)).hom p)))
          ((Limits.pullback.fst ((wcProEtBC iP).obj V).hom (Limits.pullback.fst iP iT)).base.hom z) *
        (wcSuppTwist (wcSuppUnitMap Dj))
          ((Limits.pullback.snd ((wcProEtBC iP).obj V).hom (Limits.pullback.fst iP iT)).base.hom z)
          = 0
      exact (congrArg (fun a => a * (wcSuppTwist (wcSuppUnitMap Dj))
          ((Limits.pullback.snd ((wcProEtBC iP).obj V).hom
            (Limits.pullback.fst iP iT)).base.hom z)) h2z).trans (alg0 _ _ _ h0)

  haveI hepiT : Epi (wcSuppUnitMap DT) := wc_supp_unit_epi_of_closed iT ℓ DT hDT
  haveI hepi1 : Epi (wcSuppUnitMap DP ≫ (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _
      (wcProEtBC iP) _ _ DP.cont DP.φ).map (wcSuppUnitMap Dj)) := by
    haveI h1 := wc_supp_unit_epi_of_closed iP ℓ DP hDP
    haveI h2 := wc_supp_unit_epi_of_closed (Limits.pullback.fst iP iT) ℓ Dj hDj
    exact @epi_comp _ _ _ _ _ _ h1 _ (Functor.map_epi _ _)

  have hk : Limits.kernel.ι (wcSuppUnitMap DP ≫ (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _
      (wcProEtBC iP) _ _ DP.cont DP.φ).map (wcSuppUnitMap Dj)) ≫ wcSuppUnitMap DT = 0 :=
    (s2 _).2 ((s2' _).1 (Limits.kernel.condition _))
  have hk' : Limits.kernel.ι (wcSuppUnitMap DT) ≫ (wcSuppUnitMap DP ≫
      (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _
        (wcProEtBC iP) _ _ DP.cont DP.φ).map (wcSuppUnitMap Dj)) = 0 :=
    (s2' _).2 ((s2 _).1 (Limits.kernel.condition _))
  obtain ⟨φh, hφ⟩ : ∃ φh, (wcSuppUnitMap DP ≫ (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _
      (wcProEtBC iP) _ _ DP.cont DP.φ).map (wcSuppUnitMap Dj)) ≫ φh = wcSuppUnitMap DT :=
    ⟨_, Abelian.comp_epiDesc _ _ hk⟩
  obtain ⟨ψh, hψ⟩ : ∃ ψh, wcSuppUnitMap DT ≫ ψh = wcSuppUnitMap DP ≫
      (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _
        (wcProEtBC iP) _ _ DP.cont DP.φ).map (wcSuppUnitMap Dj) :=
    ⟨_, Abelian.comp_epiDesc _ _ hk'⟩
  have e1 : φh ≫ ψh = 𝟙 _ := by
    apply (cancel_epi (wcSuppUnitMap DP ≫ (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _
      (wcProEtBC iP) _ _ DP.cont DP.φ).map (wcSuppUnitMap Dj))).1
    rw [← Category.assoc, hφ, hψ, Category.comp_id]
  have e2 : ψh ≫ φh = 𝟙 _ := by
    apply (cancel_epi (wcSuppUnitMap DT)).1
    rw [← Category.assoc, hψ, hφ, Category.comp_id]

  have ha : ∀ c : ℚ_[ℓ], ψh ≫ (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _
      (wcProEtBC iP) _ _ DP.cont DP.φ).map
        ((@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC (Limits.pullback.fst iP iT)) _ _
          Dj.cont Dj.φ).map (wcHMConst (Limits.pullback iP iT) ℓ c)) ≫ φh =
      (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC iT) _ _
        DT.cont DT.φ).map (wcHMConst T ℓ c) := by
    intro c
    apply (cancel_epi (wcSuppUnitMap DT)).1
