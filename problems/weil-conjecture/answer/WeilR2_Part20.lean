    (γ : wcSuppObj Di ⟶ Df.Φ.obj (wcSuppObj D))
    (hγ : wcSuppUnitMap Di ≫ γ = Df.μ.inv ≫ Df.Φ.map (wcSuppUnitMap D))
    (hepi : Epi (wcSuppUnitMap Di)) : IsIso γ :=
by
  have hv : Epi (Df.μ.inv ≫ Df.Φ.map (wcSuppUnitMap D)) := by
    haveI := wc_supp_unit_epi_of_closed i ℓ D hD
    haveI : Df.Φ.IsLeftAdjoint := Df.adj.isLeftAdjoint
    haveI := Functor.preservesEpimorphisms_of_isLeftAdjoint Df.Φ
