    Scheme.Cover.mkOfCovers (P := @IsOpenImmersion) (Fin (N + 1)) _ c hcovU (fun i => inferInstance)
  let fρ : ∀ i, Spec (CommRingCat.of (HomogeneousLocalization.Away
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1 + 1)) K) (ψ (MvPolynomial.X i)))) ⟶ wcProjK K N :=
    fun i => Spec.map (CommRingCat.ofHom (HomogeneousLocalization.Away.map ψ (MvPolynomial.X i))) ≫
      Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X i) (hy i)
        one_pos
  have cocycle : ∀ i j, Spec.map (CommRingCat.ofHom (HomogeneousLocalization.awayMap _ (hℓ' j)
      (rfl : ψ (MvPolynomial.X i) * ψ (MvPolynomial.X j) = ψ (MvPolynomial.X i) * ψ (MvPolynomial.X j)))) ≫ fρ i =
      Spec.map (CommRingCat.ofHom (HomogeneousLocalization.awayMap _ (hℓ' i)
        (mul_comm (ψ (MvPolynomial.X i)) (ψ (MvPolynomial.X j))))) ≫ fρ j := by
    intro i j
    simp only [fρ]
    rw [← Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp,
      C4 i j _ _ rfl rfl (h₂ i j), CommRingCat.ofHom_comp, Spec.map_comp, Category.assoc,
      Proj.SpecMap_awayMap_awayι]
    rw [← Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp,
      C4 j i _ _ (mul_comm (MvPolynomial.X i) (MvPolynomial.X j))
        (mul_comm (ψ (MvPolynomial.X i)) (ψ (MvPolynomial.X j))) (h₂ i j),
      CommRingCat.ofHom_comp, Spec.map_comp, Category.assoc, Proj.SpecMap_awayMap_awayι]
  have hglue : ∀ i j, Limits.pullback.fst (𝒰.f i) (𝒰.f j) ≫ fρ i =
      Limits.pullback.snd (𝒰.f i) (𝒰.f j) ≫ fρ j := by
    intro i j
    change Limits.pullback.fst (c i) (c j) ≫ fρ i = Limits.pullback.snd (c i) (c j) ≫ fρ j
    have w : Limits.pullback.fst (c i) (c j) ≫ Proj.awayι _ (ψ (MvPolynomial.X i)) (hℓ' i) one_pos =
        Limits.pullback.snd (c i) (c j) ≫ Proj.awayι _ (ψ (MvPolynomial.X j)) (hℓ' j) one_pos := by
      rw [← K1 i, ← K1 j, ← Category.assoc, Limits.pullback.condition, Category.assoc]
    have e1 := Proj.pullbackAwayιIso_inv_fst
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1 + 1)) K) (hℓ' i) one_pos (hℓ' j) one_pos
      (rfl : ψ (MvPolynomial.X i) * ψ (MvPolynomial.X j) = ψ (MvPolynomial.X i) * ψ (MvPolynomial.X j))
    have e2 := Proj.pullbackAwayιIso_inv_snd
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1 + 1)) K) (hℓ' i) one_pos (hℓ' j) one_pos
      (rfl : ψ (MvPolynomial.X i) * ψ (MvPolynomial.X j) = ψ (MvPolynomial.X i) * ψ (MvPolynomial.X j))
    obtain ⟨t, ht1, ht2⟩ : ∃ t : Limits.pullback (c i) (c j) ⟶ Spec (CommRingCat.of
        (HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (N + 1 + 1)) K)
          (ψ (MvPolynomial.X i) * ψ (MvPolynomial.X j)))),
        Limits.pullback.fst (c i) (c j) = t ≫
          Spec.map (CommRingCat.ofHom (HomogeneousLocalization.awayMap _ (hℓ' j)
            (rfl : ψ (MvPolynomial.X i) * ψ (MvPolynomial.X j) = ψ (MvPolynomial.X i) * ψ (MvPolynomial.X j)))) ∧
        Limits.pullback.snd (c i) (c j) = t ≫
          Spec.map (CommRingCat.ofHom (HomogeneousLocalization.awayMap _ (hℓ' i)
            (mul_comm (ψ (MvPolynomial.X i)) (ψ (MvPolynomial.X j))))) := by
      refine ⟨Limits.pullback.lift _ _ w ≫
        (Proj.pullbackAwayιIso (MvPolynomial.homogeneousSubmodule (Fin (N + 1 + 1)) K) (hℓ' i)
          one_pos (hℓ' j) one_pos
          (rfl : ψ (MvPolynomial.X i) * ψ (MvPolynomial.X j) = ψ (MvPolynomial.X i) * ψ (MvPolynomial.X j))).hom, ?_, ?_⟩
      · rw [Category.assoc, ← e1, Iso.hom_inv_id_assoc, Limits.pullback.lift_fst]
      · rw [Category.assoc, ← e2, Iso.hom_inv_id_assoc, Limits.pullback.lift_snd]
    rw [ht1, ht2, Category.assoc, Category.assoc, cocycle i j]
  let ρ : (U : Scheme) ⟶ wcProjK K N := 𝒰.glueMorphisms fρ hglue
  have hρ : ∀ i, c i ≫ ρ = fρ i := fun i => 𝒰.ι_glueMorphisms fρ hglue i



  have hrange : Set.range (Proj.map φ hf) ⊆ Set.range U.ι := by
    rintro _ ⟨x, rfl⟩
    rw [Scheme.Opens.range_ι]
    obtain ⟨i, hi⟩ := hcovB x
    have h1 : x ∈ Proj.map φ hf ⁻¹ᵁ Proj.basicOpen
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1 + 1)) K) (ψ (MvPolynomial.X i)) := by
      rw [Proj.map_preimage_basicOpen, hφψ]; exact hi
    exact TopologicalSpace.Opens.mem_iSup.mpr ⟨i, h1⟩
  let ι' : wcProjK K N ⟶ (U : Scheme) := IsOpenImmersion.lift U.ι (Proj.map φ hf) hrange
  have hfac : ι' ≫ U.ι = Proj.map φ hf := IsOpenImmersion.lift_fac U.ι (Proj.map φ hf) hrange
  have T : ∀ (g' : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K →+*ᵍ
      MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K), g' = GradedRingHom.id _ →
      ∀ (t : MvPolynomial (Fin (N + 1)) K) (ht : t ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 1),
      Spec.map (CommRingCat.ofHom (HomogeneousLocalization.Away.map g' t)) ≫
        Proj.awayι _ t ht one_pos = Proj.awayι _ (g' t) (g'.map_mem ht) one_pos := by
    rintro g' rfl t ht
    have e : HomogeneousLocalization.Away.map
        (GradedRingHom.id (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)) t = RingHom.id _ :=
      HomogeneousLocalization.map_id _ _
    change Spec.map (CommRingCat.ofHom (HomogeneousLocalization.Away.map
        (GradedRingHom.id (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)) t :
          HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) t →+*
          HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) t)) ≫
        Proj.awayι _ t ht one_pos = Proj.awayι _ t ht one_pos
    first
      | (erw [e]; erw [CommRingCat.ofHom_id, Spec.map_id, Category.id_comp])
      | (convert Category.id_comp (Proj.awayι
            (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) t ht one_pos) using 2
         rw [← Spec.map_id]
         congr 1
         apply CommRingCat.hom_ext
         exact e)
      | (simp only [e, CommRingCat.ofHom_id, Spec.map_id, Category.id_comp])
  have hcomp : φ.comp ψ = GradedRingHom.id _ :=
    GradedRingHom.ext fun b => by
      rw [GradedRingHom.comp_apply, GradedRingHom.id_apply]; exact hφψ b
  have hsec : ι' ≫ ρ = 𝟙 _ := by
    refine Scheme.Cover.hom_ext 𝒱 _ _ (fun i => ?_)
    change Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
        (φ (ψ (MvPolynomial.X i))) (φ.map_mem (hℓ' i)) one_pos ≫ ι' ≫ ρ =
      Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
        (φ (ψ (MvPolynomial.X i))) (φ.map_mem (hℓ' i)) one_pos ≫ 𝟙 _
    have e1 : Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
        (φ (ψ (MvPolynomial.X i))) (φ.map_mem (hℓ' i)) one_pos ≫ ι' =
        Spec.map (CommRingCat.ofHom (HomogeneousLocalization.Away.map φ (ψ (MvPolynomial.X i)))) ≫
          c i := by
      rw [← cancel_mono U.ι, Category.assoc, hfac, Category.assoc, K1 i]
      exact Proj.awayι_comp_map φ hf one_pos (ψ (MvPolynomial.X i)) (hℓ' i)
    rw [← Category.assoc, e1, Category.assoc, hρ i]
    simp only [fρ]
    rw [← Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp,
      ← HomogeneousLocalization.Away.map_comp, Category.comp_id]
    exact T _ hcomp (MvPolynomial.X i) (hy i)
  exact ⟨Proj.map φ hf, p, U, ι', ρ, hcl, hover, hp, hcompl, hfac, hsec⟩

theorem wc_alg_closed_point_supp_low_vanish (K : Type u) [Field K] [IsAlgClosed K]
    {Y : Scheme.{u}} (pY : Y ⟶ Spec (.of K)) [IsProper pY] [IrreducibleSpace Y]
    (n : ℕ) [SmoothOfRelativeDimension n pY]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : K) ≠ 0)
    (y₀ : Spec (.of K) ⟶ Y) (hy₀ : y₀ ≫ pY = 𝟙 _)
    (Dy : wcHMPullData y₀ ℓ) (hDy : wcHMPullCanonical Dy) (q : ℕ) (hq : q < 2 * n) :
    ∀ θ : wcSuppExt Dy q, θ = 0 :=
by
  classical
  intro θ
  unfold wcSuppExt wcSuppObj at θ

  haveI : IsClosedImmersion (y₀ ≫ pY) := by rw [hy₀]; infer_instance
  haveI : IsClosedImmersion y₀ := IsClosedImmersion.of_comp y₀ pY
  haveI : SmoothOfRelativeDimension 0 (y₀ ≫ pY) := by rw [hy₀]; infer_instance
  haveI : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian pY

  haveI := Dy.additive
  haveI : (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC y₀) _ _ Dy.cont Dy.φ).Additive :=
    Adjunction.right_adjoint_additive Dy.adj
  haveI : (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC y₀) _ _ Dy.cont
      Dy.φ).IsRightAdjoint := Dy.adj.isRightAdjoint
  haveI : (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC y₀) _ _ Dy.cont
      Dy.φ).PreservesMonomorphisms := Functor.preservesMonomorphisms_of_isRightAdjoint _

  haveI := wc_proet_closed_push_isLeftAdjoint y₀ ℓ Dy hDy
  obtain ⟨Rs, ⟨adj⟩⟩ : ∃ Rs, Nonempty
      (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC y₀) _ _ Dy.cont Dy.φ ⊣ Rs) :=
    ⟨_, ⟨Adjunction.ofIsLeftAdjoint _⟩⟩
  haveI : Rs.Additive := Adjunction.right_adjoint_additive adj

  haveI := sheafOfModules_enoughInjectives (Scheme.ProEt.topology Y) (wcRingSheaf Y ℓ)
  let I := injectiveResolution (SheafOfModules.unit (wcRingSheaf Y ℓ))

  have hvan : ∀ j, j < 2 * n → Limits.IsZero
      (((Rs.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology j) :=
    fun j hj => wc_smooth_pair_proet_shriek_low_vanish K pY n 0 n (zero_add n) y₀ ℓ hℓ Dy hDy
      Rs adj I j hj

  have hinj : ∀ j, Injective
      (((Rs.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).X j) := by
    intro j
    haveI := I.injective j
    exact Injective.injective_of_adjoint adj (I.cocomplex.X j)

  set J := (Rs.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex with hJ
  have hstep : ∀ j, j < 2 * n → ∀ σ : J.X j ⟶ J.X (j - 1),
      J.d (j - 1) j ≫ σ ≫ J.d (j - 1) j = J.d (j - 1) j →
      ∃ h : J.X (j + 1) ⟶ J.X j, J.d j (j + 1) ≫ h = 𝟙 _ - σ ≫ J.d (j - 1) j := by
    intro j hj σ hσ
    have hprev : (ComplexShape.up ℕ).prev j = j - 1 := by
      rcases j with _ | i
      · exact CochainComplex.prev_nat_zero
      · exact CochainComplex.prev_nat_succ i
    have hex : (J.sc' (j - 1) j (j + 1)).Exact :=
      (J.exactAt_iff' (j - 1) j (j + 1) hprev (CochainComplex.next ℕ j)).mp
        ((J.exactAt_iff_isZero_homology j).mpr (hvan j hj))
    have hz : (J.sc' (j - 1) j (j + 1)).f ≫ (𝟙 (J.X j) - σ ≫ J.d (j - 1) j) = 0 := by
      show J.d (j - 1) j ≫ (𝟙 (J.X j) - σ ≫ J.d (j - 1) j) = 0
      rw [Preadditive.comp_sub, Category.comp_id, hσ, sub_self]
    haveI := hinj j
    exact ⟨hex.descToInjective _ hz, hex.comp_descToInjective _ hz⟩
  have hsig : ∀ k, k ≤ 2 * n → ∃ σ : J.X k ⟶ J.X (k - 1),
      J.d (k - 1) k ≫ σ ≫ J.d (k - 1) k = J.d (k - 1) k := by
    intro k
    induction k with
    | zero =>
      intro _
      refine ⟨0, ?_⟩
      have h0 : J.d (0 - 1) 0 = 0 := J.shape _ _ (by simp)
      rw [h0, Limits.zero_comp]
    | succ k ih =>
      intro hk
      obtain ⟨σ, hσ⟩ := ih (by omega)
      obtain ⟨h, hh⟩ := hstep k (by omega) σ hσ
      refine ⟨h, ?_⟩
      show J.d k (k + 1) ≫ h ≫ J.d k (k + 1) = J.d k (k + 1)
      rw [← Category.assoc, hh, Preadditive.sub_comp, Category.id_comp, Category.assoc,
        J.d_comp_d, Limits.comp_zero, sub_zero]
  have hlift : ∀ k, k < 2 * n → ∀ (P : SheafOfModules.{u+1} (wcRingSheaf (Spec (.of K)) ℓ))
      (c : P ⟶ J.X k), c ≫ J.d k (k + 1) = 0 →
      ∃ e : P ⟶ J.X (k - 1), e ≫ J.d (k - 1) k = c := by
    intro k hk P c hc
    obtain ⟨σ, hσ⟩ := hsig k hk.le
    obtain ⟨h, hh⟩ := hstep k hk σ hσ
    refine ⟨c ≫ σ, ?_⟩
    have h1 : c ≫ (𝟙 _ - σ ≫ J.d (k - 1) k) = 0 := by
      rw [← hh, ← Category.assoc, hc, Limits.zero_comp]
    rw [Preadditive.comp_sub, Category.comp_id, sub_eq_zero] at h1
    rw [Category.assoc]
    exact h1.symm

  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf Y ℓ)) := HasExt.standard _
  obtain ⟨f, hf, rfl⟩ := I.extMk_surjective θ (q + 1) rfl
  have hf' : (adj.homEquiv (SheafOfModules.unit (wcRingSheaf (Spec (.of K)) ℓ))
      (I.cocomplex.X q)) f ≫ J.d q (q + 1) = 0 := by
    show (adj.homEquiv _ _) f ≫ Rs.map (I.cocomplex.d q (q + 1)) = 0
    rw [← adj.homEquiv_naturality_right, hf, Adjunction.homEquiv_unit, Functor.map_zero,
      Limits.comp_zero]
  obtain ⟨e', he'⟩ := hlift q hq _ _ hf'
  have hg : (adj.homEquiv (SheafOfModules.unit (wcRingSheaf (Spec (.of K)) ℓ))
      (I.cocomplex.X (q - 1))).symm e' ≫ I.cocomplex.d (q - 1) q = f := by
    rw [← adj.homEquiv_naturality_right_symm]
    have he'' : e' ≫ Rs.map (I.cocomplex.d (q - 1) q) =
        (adj.homEquiv _ _) f := he'
    rw [he'', Equiv.symm_apply_apply]
  cases q with
  | zero =>
    have h0 : I.cocomplex.d (0 - 1) 0 = 0 := I.cocomplex.shape _ _ (by simp)
    have hf0 : f = 0 := by rw [← hg, h0]; exact Limits.comp_zero
    subst hf0
    exact I.extMk_zero 1 rfl
  | succ p =>
    exact (I.extMk_eq_zero_iff f (p + 2) rfl hf p rfl).mpr ⟨_, hg⟩

theorem wc_xspl_projK_top_cup (k : Type u) [Field k] [IsSepClosed k] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (hℓ : ((ℓ : ℕ) : k) ≠ 0) (n : ℕ) (hn : Even n) (hn4 : 4 ≤ n) :
    ∃ (a : wcHM (wcProjK k (n - 1)) ℓ (n - 2)) (b : wcHM (wcProjK k (n - 1)) ℓ 2)
      (c : wcHM (wcProjK k (n - 1)) ℓ (n - 2)),
      wcHMCup (wcProjK k (n - 1)) ℓ (n - 2 + 2) (n - 2) (2 * (n - 1)) (by omega)
        (wcHMCup (wcProjK k (n - 1)) ℓ (n - 2) 2 (n - 2 + 2) rfl a b) c ≠ 0 :=
by
  classical
  obtain ⟨m, rfl⟩ : ∃ m, n = 2 * m + 2 := by
    obtain ⟨t, ht⟩ := hn
    exact ⟨t - 1, by omega⟩

  have chain : ∀ (K : Type u) [Field K] [IsAlgClosed K], ((ℓ : ℕ) : K) ≠ 0 → ∀ (N M : ℕ), N ≤ M →
      ∃ ι : wcProjK K N ⟶ wcProjK K M, IsClosedImmersion ι ∧
        ι ≫ wcProjKStr K M = wcProjKStr K N ∧
        ∀ (D : wcHMPullData ι ℓ), wcHMPullCanonical D → ∀ q ≤ 2 * N,
          Function.Surjective (wcHMPull D q) := by
    intro K _ _ hℓK N M hNM
    induction M, hNM using Nat.le_induction with
    | base =>
      exact ⟨𝟙 _, inferInstance, Category.id_comp _,
        fun D hD q _ x => ⟨x, wc_hm_pull_id _ rfl D hD q x⟩⟩
    | succ M hNM ih =>
      obtain ⟨ιM, hιM, hstrM, hsurjM⟩ := ih
      obtain ⟨ι₁, p, O, ι', ρ, hι₁, hstr₁, hp, hO, hfac, hret⟩ :=
        wc_projK_hyperplane_point_retract K M
      haveI := hιM
      haveI := hι₁
      refine ⟨ιM ≫ ι₁, inferInstance, by rw [Category.assoc, hstr₁, hstrM], ?_⟩
      intro D hD q hq
      haveI := wc_proj_space_isProper K (M + 1)
      haveI := wc_proj_space_irreducible K (M + 1)
      haveI := wc_proj_space_smooth K (M + 1)
      haveI : IsClosedImmersion (p ≫ wcProjKStr K (M + 1)) := by rw [hp]; infer_instance
      haveI : IsClosedImmersion p := IsClosedImmersion.of_comp p (wcProjKStr K (M + 1))
      haveI : IsLocallyNoetherian (wcProjK K (M + 1)) :=
        LocallyOfFiniteType.isLocallyNoetherian (wcProjKStr K (M + 1))
      obtain ⟨Dp, hDp⟩ := wc_hm_pull_data_exists p ℓ
      obtain ⟨Do, hDo⟩ := wc_hm_pull_data_exists O.ι ℓ
      obtain ⟨D', hD'⟩ := wc_hm_pull_data_exists ι' ℓ
      obtain ⟨Dρ, hDρ⟩ := wc_hm_pull_data_exists ρ ℓ
      obtain ⟨Did, hDid⟩ := wc_hm_pull_data_exists (ι' ≫ ρ) ℓ
      obtain ⟨D1, hD1⟩ := wc_hm_pull_data_exists ι₁ ℓ
      obtain ⟨DM, hDM⟩ := wc_hm_pull_data_exists ιM ℓ
      have hv : ∀ θ : wcSuppExt Dp (q + 1), θ = 0 :=
        wc_alg_closed_point_supp_low_vanish K (wcProjKStr K (M + 1)) (M + 1) ℓ hℓK p hp Dp hDp
          (q + 1) (by omega)
      have hOs := wc_qcl_restrict_surj_of_supp_vanish p ℓ Dp hDp O hO q hv Do hDo
      have h' : Function.Surjective (wcHMPull D' q) := by
        intro y
        refine ⟨wcHMPull Dρ q y, ?_⟩
        rw [← wc_hm_pull_comp ρ ι' (ι' ≫ ρ) rfl Dρ hDρ D' hD' Did hDid q y]
        exact wc_hm_pull_id _ hret Did hDid q y
      have h1 : Function.Surjective (wcHMPull D1 q) := by
        intro y
        obtain ⟨z, rfl⟩ := h' y
        obtain ⟨w, rfl⟩ := hOs z
        exact ⟨w, wc_hm_pull_comp O.ι ι' ι₁ hfac Do hDo D' hD' D1 hD1 q w⟩
      intro y
      obtain ⟨z, rfl⟩ := hsurjM DM hDM q hq y
      obtain ⟨w, rfl⟩ := h1 z
      exact ⟨w, wc_hm_pull_comp ι₁ ιM (ιM ≫ ι₁) rfl D1 hD1 DM hDM D hD q w⟩

  have topK : ∀ (K : Type u) [Field K] [IsAlgClosed K], ((ℓ : ℕ) : K) ≠ 0 →
      ∃ (a : wcHM (wcProjK K (2 * m + 1)) ℓ (2 * m)) (b : wcHM (wcProjK K (2 * m + 1)) ℓ 2)
        (c : wcHM (wcProjK K (2 * m + 1)) ℓ (2 * m)),
        wcHMCup (wcProjK K (2 * m + 1)) ℓ (2 * m + 2) (2 * m) (2 * (2 * m + 1)) (by omega)
          (wcHMCup (wcProjK K (2 * m + 1)) ℓ (2 * m) 2 (2 * m + 2) rfl a b) c ≠ 0 := by
    intro K _ _ hℓK
    obtain ⟨J, hJ, hJstr, hJsurj⟩ := chain K hℓK (m + 1) (2 * m + 1) (by omega)
    obtain ⟨j, hj, hjstr, hjsurj⟩ := chain K hℓK m (m + 1) (by omega)
    haveI := hJ
    haveI := hj
    haveI := wc_proj_space_isProper K m
    haveI := wc_proj_space_isProper K (m + 1)
    haveI := wc_proj_space_isProper K (2 * m + 1)
    haveI := wc_proj_space_irreducible K m
    haveI := wc_proj_space_irreducible K (m + 1)
    haveI := wc_proj_space_irreducible K (2 * m + 1)
    haveI := wc_proj_space_smooth K m
    haveI := wc_proj_space_smooth K (m + 1)
    haveI := wc_proj_space_smooth K (2 * m + 1)
    haveI : SmoothOfRelativeDimension (m + 1) (J ≫ wcProjKStr K (2 * m + 1)) := by
      rw [hJstr]; infer_instance
    haveI : SmoothOfRelativeDimension m (j ≫ wcProjKStr K (m + 1)) := by
      rw [hjstr]; infer_instance
    obtain ⟨w₀, hw₀⟩ := wc_alg_closed_lft_section K (wcProjK K m) (wcProjKStr K m)
      IrreducibleSpace.toNonempty
    obtain ⟨Dw, hDw⟩ := wc_hm_pull_data_exists w₀ ℓ
    obtain ⟨θ, hθ⟩ :=
      wc_alg_closed_point_supp_class_nonzero K (wcProjKStr K m) m ℓ hℓK w₀ hw₀ Dw hDw
    obtain ⟨Dj, hDj⟩ := wc_hm_pull_data_exists j ℓ
    obtain ⟨zB, hzB⟩ := hjsurj Dj hDj (2 * m) le_rfl (wcSuppClass Dw (2 * m) θ)
    obtain ⟨τW, hτW⟩ := wc_smooth_pair_gysin_detect K (wcProjKStr K (m + 1)) (m + 1) m 1 rfl
      j ℓ hℓK Dj hDj 2 (2 * m) (2 * m + 2) (by omega) rfl rfl (by omega)
    have hyB := hτW zB (by rw [hzB]; exact hθ)
    obtain ⟨DJ, hDJ⟩ := wc_hm_pull_data_exists J ℓ
    obtain ⟨a, ha⟩ := hJsurj DJ hDJ (2 * m) (by omega) zB
    obtain ⟨b, hb⟩ := hJsurj DJ hDJ 2 (by omega) (wcSuppClass Dj 2 τW)
    obtain ⟨τZ, hτZ⟩ := wc_smooth_pair_gysin_detect K (wcProjKStr K (2 * m + 1)) (2 * m + 1)
      (m + 1) m (by omega) J ℓ hℓK DJ hDJ (2 * m) (2 * m + 2) (2 * (2 * m + 1)) rfl (by omega)
      (by omega) rfl
    refine ⟨a, b, wcSuppClass DJ (2 * m) τZ, hτZ _ ?_⟩
    rw [wc_hm_pull_cup DJ (2 * m) 2 (2 * m + 2) rfl a b, ha, hb]
    exact hyB

  suffices H : ∃ (a : wcHM (wcProjK k (2 * m + 1)) ℓ (2 * m))
      (b : wcHM (wcProjK k (2 * m + 1)) ℓ 2) (c : wcHM (wcProjK k (2 * m + 1)) ℓ (2 * m)),
      wcHMCup (wcProjK k (2 * m + 1)) ℓ (2 * m + 2) (2 * m) (2 * (2 * m + 1)) (by omega)
        (wcHMCup (wcProjK k (2 * m + 1)) ℓ (2 * m) 2 (2 * m + 2) rfl a b) c ≠ 0 by
    exact H
  have hℓK : ((ℓ : ℕ) : AlgebraicClosure k) ≠ 0 := by
    intro h
    apply hℓ
    apply (algebraMap k (AlgebraicClosure k)).injective
    rw [map_natCast, map_zero]
    exact h
  obtain ⟨a', b', c', habc'⟩ := topK (AlgebraicClosure k) hℓK
  haveI := wc_proj_space_isProper k (2 * m + 1)
  obtain ⟨Dβ, hDβ⟩ := wc_hm_pull_data_exists (wcLdpProjMap k (AlgebraicClosure k) (2 * m + 1)) ℓ
  have hbij : ∀ q, Function.Bijective (wcHMPull Dβ q) := fun q =>
    wc_hm_sepclosed_base_change_pull_bij k (AlgebraicClosure k) (algebraMap k (AlgebraicClosure k))
      (wcProjK k (2 * m + 1)) (wcProjKStr k (2 * m + 1)) (wcProjK (AlgebraicClosure k) (2 * m + 1))
      (wcLdpProjMap k (AlgebraicClosure k) (2 * m + 1)) (wcProjKStr (AlgebraicClosure k) (2 * m + 1))
      (wc_ldnm_di_projmap_pb k (AlgebraicClosure k) (2 * m + 1)) ℓ hℓ Dβ hDβ q
  obtain ⟨a, rfl⟩ := (hbij (2 * m)).2 a'
  obtain ⟨b, rfl⟩ := (hbij 2).2 b'
  obtain ⟨c, rfl⟩ := (hbij (2 * m)).2 c'
  refine ⟨a, b, c, fun h0 => habc' ?_⟩
  rw [← wc_hm_pull_cup Dβ (2 * m) 2 (2 * m + 2) rfl a b,
    ← wc_hm_pull_cup Dβ (2 * m + 2) (2 * m) (2 * (2 * m + 1)) _ _ c, h0, map_zero]

theorem wc_xspl_oddq_proj_finite_surj (k : Type u) [Field k] (n : ℕ) (hn : 1 ≤ n)
    (a0 : Fin n → Fin n → k) (R : Scheme.{u}) (j : R ⟶ wcProjK k n)
    (hj : IsClosedImmersion j) (hjr : Set.range j = wcXspVplus k n (wcXspExtCoeff a0)) :
    ∃ π : R ⟶ wcProjK k (n - 1), IsFinite π ∧ Surjective π :=
by
  classical

  have L3 : ∀ (K : Type u) [Field K] (M : ℕ) (ℓ : Fin (M + 1) → MvPolynomial (Fin (M + 1 + 1)) K),
      (∀ i, (ℓ i).IsHomogeneous 1) →
      ∃ π : ((⨆ i : Fin (M + 1), @Proj.basicOpen _ _ _ _ _
          (MvPolynomial.homogeneousSubmodule (Fin (M + 1 + 1)) K) MvPolynomial.gradedAlgebra (ℓ i) :
          (wcProjK K (M + 1)).Opens) : Scheme.{u}) ⟶ wcProjK K M,
        π ≫ wcProjKStr K M = Scheme.Opens.ι _ ≫ wcProjKStr K (M + 1) ∧
        ∀ (d : ℕ) (g : MvPolynomial (Fin (M + 1)) K), 0 < d → g.IsHomogeneous d →
          π ⁻¹ᵁ @Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) K)
            MvPolynomial.gradedAlgebra g =
          (Scheme.Opens.ι _) ⁻¹ᵁ @Proj.basicOpen _ _ _ _ _
            (MvPolynomial.homogeneousSubmodule (Fin (M + 1 + 1)) K) MvPolynomial.gradedAlgebra
            (MvPolynomial.aeval ℓ g) := by
    intro K _ M ℓ hℓ
    letI : GradedRing (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) K) :=
      MvPolynomial.gradedAlgebra
    letI : GradedRing (MvPolynomial.homogeneousSubmodule (Fin (M + 1 + 1)) K) :=
      MvPolynomial.gradedAlgebra
    let φ : MvPolynomial.homogeneousSubmodule (Fin (M + 1)) K →+*ᵍ
        MvPolynomial.homogeneousSubmodule (Fin (M + 1 + 1)) K :=
      GradedRingHom.mk (MvPolynomial.aeval ℓ).toRingHom (fun {i} {x} hx => by
        rw [MvPolynomial.mem_homogeneousSubmodule] at hx ⊢
        simpa using (hx.aeval ℓ hℓ))
    have hφ : ∀ a, φ a = MvPolynomial.aeval ℓ a := fun a => rfl
    have hy : ∀ i : Fin (M + 1), (MvPolynomial.X i : MvPolynomial (Fin (M + 1)) K) ∈
        MvPolynomial.homogeneousSubmodule (Fin (M + 1)) K 1 :=
      fun i => (MvPolynomial.mem_homogeneousSubmodule _ _).mpr (MvPolynomial.isHomogeneous_X K i)
    have hℓ' : ∀ i, ℓ i ∈ MvPolynomial.homogeneousSubmodule (Fin (M + 1 + 1)) K 1 :=
      fun i => (MvPolynomial.mem_homogeneousSubmodule _ _).mpr (hℓ i)
    have hφX : ∀ i, φ (MvPolynomial.X i) = ℓ i := fun i => MvPolynomial.aeval_X ℓ i
    have h : ∀ i, Submonoid.powers (MvPolynomial.X i : MvPolynomial (Fin (M + 1)) K) ≤
        Submonoid.comap φ (Submonoid.powers (ℓ i)) :=
      fun i => Submonoid.powers_le.mpr (Submonoid.mem_comap.mpr
        (by rw [hφX]; exact Submonoid.mem_powers _))
    have h₂ : ∀ i j, Submonoid.powers (MvPolynomial.X i * MvPolynomial.X j :
        MvPolynomial (Fin (M + 1)) K) ≤ Submonoid.comap φ (Submonoid.powers (ℓ i * ℓ j)) :=
      fun i j => Submonoid.powers_le.mpr (Submonoid.mem_comap.mpr (by
        rw [map_mul, hφX, hφX]; exact Submonoid.mem_powers _))
    have L1 : ∀ j (n : ℕ) (a : MvPolynomial (Fin (M + 1)) K)
        (ha : a ∈ MvPolynomial.homogeneousSubmodule (Fin (M + 1)) K (n • 1)),
        HomogeneousLocalization.map φ (h j) (HomogeneousLocalization.Away.mk _ (hy j) n a ha) =
        HomogeneousLocalization.Away.mk _ (hℓ' j) n (φ a) (φ.map_mem ha) := by
      intro j n a ha
      apply HomogeneousLocalization.val_injective
      rw [HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.Away.mk,
        HomogeneousLocalization.map_mk, HomogeneousLocalization.val_mk]
      congr 1
      apply Subtype.ext
      show φ (MvPolynomial.X j ^ n) = ℓ j ^ n
      rw [map_pow, hφX]
    have C4 : ∀ (a b : Fin (M + 1)) (x : MvPolynomial (Fin (M + 1)) K)
        (x' : MvPolynomial (Fin (M + 1 + 1)) K)
        (hx : x = MvPolynomial.X a * MvPolynomial.X b) (hx' : x' = ℓ a * ℓ b)
        (h₂ : Submonoid.powers x ≤ Submonoid.comap φ (Submonoid.powers x')),
        (HomogeneousLocalization.awayMap _ (hℓ' b) hx').comp (HomogeneousLocalization.map φ (h a)) =
          (HomogeneousLocalization.map φ h₂).comp (HomogeneousLocalization.awayMap _ (hy b) hx) := by
      intro a b x x' hx hx' h₂
      refine RingHom.ext fun z => ?_
      obtain ⟨n, z, hz, rfl⟩ := HomogeneousLocalization.Away.mk_surjective _ (hy a) z
      rw [RingHom.comp_apply, RingHom.comp_apply, L1, HomogeneousLocalization.awayMap_mk,
        HomogeneousLocalization.awayMap_mk]
      apply HomogeneousLocalization.val_injective
      rw [HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.Away.mk,
        HomogeneousLocalization.map_mk, HomogeneousLocalization.val_mk]
      subst hx hx'
      congr 1
      · show φ z * ℓ b ^ n = φ (z * MvPolynomial.X b ^ n)
        rw [map_mul, map_pow, hφX]
      · apply Subtype.ext
        show (ℓ a * ℓ b) ^ n = φ ((MvPolynomial.X a * MvPolynomial.X b) ^ n)
        rw [map_pow, map_mul, hφX, hφX]
    have C5 : ∀ i (r : K), HomogeneousLocalization.map φ (h i)
        (HomogeneousLocalization.fromZeroRingHom (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) K)
          (Submonoid.powers (MvPolynomial.X i)) (algebraMap K _ r)) =
        HomogeneousLocalization.fromZeroRingHom
          (MvPolynomial.homogeneousSubmodule (Fin (M + 1 + 1)) K)
          (Submonoid.powers (ℓ i)) (algebraMap K _ r) := by
      intro i r
      apply HomogeneousLocalization.val_injective
      change (HomogeneousLocalization.map φ (h i) (HomogeneousLocalization.mk
          ⟨0, algebraMap K _ r, 1, by rw [SetLike.GradeZero.coe_one]; exact Submonoid.one_mem _⟩)).val =
        (HomogeneousLocalization.mk
          ⟨0, algebraMap K _ r, 1, by rw [SetLike.GradeZero.coe_one]; exact Submonoid.one_mem _⟩ :
            HomogeneousLocalization (MvPolynomial.homogeneousSubmodule (Fin (M + 1 + 1)) K)
              (Submonoid.powers (ℓ i))).val
      rw [HomogeneousLocalization.map_mk, HomogeneousLocalization.val_mk,
        HomogeneousLocalization.val_mk]
      congr 1
      · show φ ((algebraMap K (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) K 0) r :
            MvPolynomial (Fin (M + 1)) K)) = _
        rw [SetLike.GradeZero.coe_algebraMap, SetLike.GradeZero.coe_algebraMap, hφ, AlgHom.commutes]
      · apply Subtype.ext
        show φ (((1 : MvPolynomial.homogeneousSubmodule (Fin (M + 1)) K 0)) :
          MvPolynomial (Fin (M + 1)) K) = ((1 : MvPolynomial.homogeneousSubmodule (Fin (M + 1 + 1)) K 0) :
            MvPolynomial (Fin (M + 1 + 1)) K)
        rw [SetLike.GradeZero.coe_one, SetLike.GradeZero.coe_one, map_one]
    have C6 : ∀ j (d : ℕ) (g : MvPolynomial (Fin (M + 1)) K)
        (hg : g ∈ MvPolynomial.homogeneousSubmodule (Fin (M + 1)) K d)
        (hg' : MvPolynomial.aeval ℓ g ∈ MvPolynomial.homogeneousSubmodule (Fin (M + 1 + 1)) K d),
        HomogeneousLocalization.map φ (h j)
          (HomogeneousLocalization.Away.isLocalizationElem (hy j) hg) =
        HomogeneousLocalization.Away.isLocalizationElem (hℓ' j) hg' := by
      intro j d g hg hg'
      unfold HomogeneousLocalization.Away.isLocalizationElem
      rw [L1]
      apply HomogeneousLocalization.val_injective
      rw [HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.Away.val_mk, map_pow]
      all_goals rfl
    let U : (wcProjK K (M + 1)).Opens :=
      ⨆ i, Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (M + 1 + 1)) K) (ℓ i)
    let c : ∀ i, Spec (CommRingCat.of (HomogeneousLocalization.Away
        (MvPolynomial.homogeneousSubmodule (Fin (M + 1 + 1)) K) (ℓ i))) ⟶ (U : Scheme) :=
      fun i => (Proj.basicOpenIsoSpec _ (ℓ i) (hℓ' i) one_pos).inv ≫
        (wcProjK K (M + 1)).homOfLE (le_iSup (fun i => Proj.basicOpen
          (MvPolynomial.homogeneousSubmodule (Fin (M + 1 + 1)) K) (ℓ i)) i)
    have K1 : ∀ i, c i ≫ U.ι = Proj.awayι _ (ℓ i) (hℓ' i) one_pos := by
      intro i
      simp only [c, Category.assoc, Scheme.homOfLE_ι, Proj.basicOpenIsoSpec_inv_ι]
    have hcov : ∀ z : (U : Scheme), ∃ i w, c i w = z := by
      intro z
      obtain ⟨i, hi⟩ := TopologicalSpace.Opens.mem_iSup.mp z.2
      refine ⟨i, (Proj.basicOpenIsoSpec _ (ℓ i) (hℓ' i) one_pos).hom ⟨z.1, hi⟩, ?_⟩
      apply Subtype.ext
      simp only [c, Scheme.Hom.comp_apply]
      have e := Scheme.hom_inv_apply (Proj.basicOpenIsoSpec _ (ℓ i) (hℓ' i) one_pos) ⟨z.1, hi⟩
      refine (Scheme.homOfLE_apply _ _).trans ?_
      rw [e]
    let 𝒰 : (U : Scheme).OpenCover :=
      Scheme.Cover.mkOfCovers (P := @IsOpenImmersion) (Fin (M + 1)) _ c hcov (fun i => inferInstance)
    let f : ∀ i, Spec (CommRingCat.of (HomogeneousLocalization.Away
        (MvPolynomial.homogeneousSubmodule (Fin (M + 1 + 1)) K) (ℓ i))) ⟶ wcProjK K M :=
      fun i => Spec.map (CommRingCat.ofHom (HomogeneousLocalization.map φ (h i))) ≫
        Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) K) (MvPolynomial.X i) (hy i)
          one_pos
    have cocycle : ∀ i j, Spec.map (CommRingCat.ofHom (HomogeneousLocalization.awayMap _ (hℓ' j)
        (rfl : ℓ i * ℓ j = ℓ i * ℓ j))) ≫ f i =
        Spec.map (CommRingCat.ofHom (HomogeneousLocalization.awayMap _ (hℓ' i)
          (mul_comm (ℓ i) (ℓ j)))) ≫ f j := by
      intro i j
      simp only [f]
      rw [← Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp,
        C4 i j _ _ rfl rfl (h₂ i j), CommRingCat.ofHom_comp, Spec.map_comp, Category.assoc,
        Proj.SpecMap_awayMap_awayι]
      rw [← Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp,
        C4 j i _ _ (mul_comm (MvPolynomial.X i) (MvPolynomial.X j)) (mul_comm (ℓ i) (ℓ j)) (h₂ i j),
        CommRingCat.ofHom_comp, Spec.map_comp, Category.assoc, Proj.SpecMap_awayMap_awayι]
    have hglue : ∀ i j, Limits.pullback.fst (𝒰.f i) (𝒰.f j) ≫ f i =
        Limits.pullback.snd (𝒰.f i) (𝒰.f j) ≫ f j := by
      intro i j
      change Limits.pullback.fst (c i) (c j) ≫ f i = Limits.pullback.snd (c i) (c j) ≫ f j
      have w : Limits.pullback.fst (c i) (c j) ≫ Proj.awayι _ (ℓ i) (hℓ' i) one_pos =
          Limits.pullback.snd (c i) (c j) ≫ Proj.awayι _ (ℓ j) (hℓ' j) one_pos := by
        rw [← K1 i, ← K1 j, ← Category.assoc, Limits.pullback.condition, Category.assoc]
      have e1 := Proj.pullbackAwayιIso_inv_fst
        (MvPolynomial.homogeneousSubmodule (Fin (M + 1 + 1)) K) (hℓ' i) one_pos (hℓ' j) one_pos
        (rfl : ℓ i * ℓ j = ℓ i * ℓ j)
      have e2 := Proj.pullbackAwayιIso_inv_snd
        (MvPolynomial.homogeneousSubmodule (Fin (M + 1 + 1)) K) (hℓ' i) one_pos (hℓ' j) one_pos
        (rfl : ℓ i * ℓ j = ℓ i * ℓ j)
      obtain ⟨t, ht1, ht2⟩ : ∃ t : Limits.pullback (c i) (c j) ⟶ Spec (CommRingCat.of
          (HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (M + 1 + 1)) K)
            (ℓ i * ℓ j))),
          Limits.pullback.fst (c i) (c j) = t ≫
            Spec.map (CommRingCat.ofHom (HomogeneousLocalization.awayMap _ (hℓ' j)
              (rfl : ℓ i * ℓ j = ℓ i * ℓ j))) ∧
          Limits.pullback.snd (c i) (c j) = t ≫
            Spec.map (CommRingCat.ofHom (HomogeneousLocalization.awayMap _ (hℓ' i)
              (mul_comm (ℓ i) (ℓ j)))) := by
        refine ⟨Limits.pullback.lift _ _ w ≫
          (Proj.pullbackAwayιIso (MvPolynomial.homogeneousSubmodule (Fin (M + 1 + 1)) K) (hℓ' i)
            one_pos (hℓ' j) one_pos (rfl : ℓ i * ℓ j = ℓ i * ℓ j)).hom, ?_, ?_⟩
        · rw [Category.assoc, ← e1, Iso.hom_inv_id_assoc, Limits.pullback.lift_fst]
        · rw [Category.assoc, ← e2, Iso.hom_inv_id_assoc, Limits.pullback.lift_snd]
      rw [ht1, ht2, Category.assoc, Category.assoc, cocycle i j]
    let π : (U : Scheme) ⟶ wcProjK K M := 𝒰.glueMorphisms f hglue
    have hπ : ∀ i, c i ≫ π = f i := fun i => 𝒰.ι_glueMorphisms f hglue i
    refine ⟨π, ?_, ?_⟩
    · apply 𝒰.hom_ext
      intro i
      change c i ≫ π ≫ _ = c i ≫ U.ι ≫ _
      rw [← Category.assoc, hπ i, ← Category.assoc (c i), K1 i]
      simp only [f, Category.assoc]
      rw [← Category.assoc (Proj.awayι _ _ _ _), Proj.awayι_toSpecZero,
        ← Category.assoc (Proj.awayι _ _ _ _), Proj.awayι_toSpecZero]
      simp only [← Spec.map_comp, ← CommRingCat.ofHom_comp]
      congr 2
      exact RingHom.ext fun r => C5 i r
    · intro d g hd hg
      have hgm : g ∈ MvPolynomial.homogeneousSubmodule (Fin (M + 1)) K d :=
        (MvPolynomial.mem_homogeneousSubmodule _ _).mpr hg
      have hgm' : MvPolynomial.aeval ℓ g ∈ MvPolynomial.homogeneousSubmodule (Fin (M + 1 + 1)) K d :=
        φ.map_mem hgm
      apply TopologicalSpace.Opens.ext
      refine Set.ext fun z => ?_
      obtain ⟨j, w, rfl⟩ := hcov z
      have key2 : (c j ≫ π) ⁻¹ᵁ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) K)
            g =
          (c j ≫ U.ι) ⁻¹ᵁ
            Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (M + 1 + 1)) K)
              (MvPolynomial.aeval ℓ g) := by
        rw [hπ j, K1 j]
        simp only [f]
        rw [Scheme.Hom.comp_preimage, Proj.awayι_preimage_basicOpen _ (hy j) one_pos hgm hd,
          Proj.awayι_preimage_basicOpen _ (hℓ' j) one_pos hgm' hd,
          SpecMap_preimage_basicOpen]
        congr 1
        exact C6 j d g hgm hgm'
      have hw := SetLike.ext_iff.mp key2 w
      simp only [Scheme.Hom.comp_preimage, Scheme.Hom.mem_preimage] at hw
      simp only [SetLike.mem_coe, Scheme.Hom.mem_preimage]
      exact hw

  have hprop : ∀ N : ℕ, IsProper (wcProjKStr k N) := by
    intro N
    letI := @MvPolynomial.gradedAlgebra (Fin (N+1)) k _
    letI : IsScalarTower k ((MvPolynomial.homogeneousSubmodule (Fin (N+1)) k) 0)
        (MvPolynomial (Fin (N+1)) k) :=
      IsScalarTower.of_algebraMap_eq (R := k)
        (S := (MvPolynomial.homogeneousSubmodule (Fin (N+1)) k) 0)
        (A := MvPolynomial (Fin (N+1)) k) (fun r => rfl)
    haveI : Algebra.FiniteType ((MvPolynomial.homogeneousSubmodule (Fin (N+1)) k) 0)
        (MvPolynomial (Fin (N+1)) k) :=
      Algebra.FiniteType.of_restrictScalars_finiteType k _ _
    haveI : IsProper (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (N+1)) k)) :=
      inferInstance
    have hbij : Function.Bijective
        (algebraMap k ((MvPolynomial.homogeneousSubmodule (Fin (N+1)) k) 0)) := by
      constructor
      · intro a b hab
        have h := congrArg (fun x : (MvPolynomial.homogeneousSubmodule (Fin (N+1)) k) 0 =>
          (x : MvPolynomial (Fin (N+1)) k)) hab
        simp only [SetLike.GradeZero.coe_algebraMap, MvPolynomial.algebraMap_eq] at h
        exact MvPolynomial.C_injective _ _ h
      · intro x
        have hx : (x : MvPolynomial (Fin (N+1)) k).IsHomogeneous 0 :=
          (MvPolynomial.mem_homogeneousSubmodule 0 _).mp x.2
        have ht : (x : MvPolynomial (Fin (N+1)) k).totalDegree = 0 :=
          Nat.le_zero.mp hx.totalDegree_le
        refine ⟨(x : MvPolynomial (Fin (N+1)) k).coeff 0, Subtype.ext ?_⟩
        simp only [SetLike.GradeZero.coe_algebraMap, MvPolynomial.algebraMap_eq]
        exact ((MvPolynomial.totalDegree_eq_zero_iff_eq_C).mp ht).symm
    haveI : IsIso (CommRingCat.ofHom
        (algebraMap k ((MvPolynomial.homogeneousSubmodule (Fin (N+1)) k) 0))) := by
      rw [ConcreteCategory.isIso_iff_bijective]
      exact hbij
    show IsProper (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (N+1)) k) ≫
      Spec.map (CommRingCat.ofHom
        (algebraMap k ((MvPolynomial.homogeneousSubmodule (Fin (N+1)) k) 0))))
    infer_instance

  have c4 : ∀ (N : ℕ) (x : wcProjK k N), ∃ i : Fin (N + 1), x ∈ @Proj.basicOpen _ _ _ _ _
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) MvPolynomial.gradedAlgebra
      (MvPolynomial.X i) := by
    intro N x
    letI : GradedRing (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) :=
      MvPolynomial.gradedAlgebra
    by_contra hx
    push_neg at hx
    apply x.not_irrelevant_le
    intro a ha
    have hi : ∀ i, MvPolynomial.X i ∈ x.asHomogeneousIdeal.toIdeal := fun i => by
      have := hx i
      rw [Proj.mem_basicOpen, not_not] at this
      exact HomogeneousIdeal.mem_iff.mpr this
    rw [HomogeneousIdeal.mem_irrelevant_iff, GradedRing.proj_apply] at ha
    have ha' : MvPolynomial.homogeneousComponent 0 a = 0 :=
      (MvPolynomial.decomposition.decompose'_apply a 0).symm.trans ha
    rw [MvPolynomial.homogeneousComponent_zero, MvPolynomial.C_eq_zero] at ha'
    have hspan : a ∈ Ideal.span (MvPolynomial.X '' (Set.univ : Set (Fin (N + 1)))) := by
      rw [MvPolynomial.mem_ideal_span_X_image]
      intro m hm
      by_contra hc
      push_neg at hc
      have hm0 : m = 0 := Finsupp.ext fun i => hc i (Set.mem_univ i)
      rw [hm0] at hm
      exact (MvPolynomial.mem_support_iff.mp hm) ha'
    have hle : Ideal.span (MvPolynomial.X '' (Set.univ : Set (Fin (N + 1)))) ≤
        x.asHomogeneousIdeal.toIdeal := by
      rw [Ideal.span_le]
      rintro _ ⟨i, _, rfl⟩
      exact hi i
    exact HomogeneousIdeal.mem_iff.mp (hle hspan)

  obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
  show ∃ π : R ⟶ wcProjK k m, IsFinite π ∧ Surjective π
  haveI := hj
  letI : GradedRing (MvPolynomial.homogeneousSubmodule (Fin (m + 1 + 1)) k) :=
    MvPolynomial.gradedAlgebra
  letI : GradedRing (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) k) :=
    MvPolynomial.gradedAlgebra
  obtain ⟨Qb, hQbdef⟩ : ∃ Qb : MvPolynomial (Fin (m + 1)) k, Qb = ∑ p : Fin (m + 1),
      ∑ q : Fin (m + 1), MvPolynomial.C (a0 p q) * (MvPolynomial.X p * MvPolynomial.X q) :=
    ⟨_, rfl⟩
  have hQ : Qb.IsHomogeneous 2 := by
    rw [hQbdef]
    apply MvPolynomial.IsHomogeneous.sum
    intro p _
    apply MvPolynomial.IsHomogeneous.sum
    intro q _
    exact ((MvPolynomial.isHomogeneous_X k p).mul (MvPolynomial.isHomogeneous_X k q)).C_mul _
  obtain ⟨F', hF'def⟩ : ∃ F' : MvPolynomial (Fin (m + 1 + 1)) k,
      F' = MvPolynomial.rename Fin.castSucc Qb - MvPolynomial.X (Fin.last (m + 1)) ^ 2 :=
    ⟨_, rfl⟩

  have hF : (wcLdpQuad k (m + 1) (wcXspExtCoeff a0) : MvPolynomial (Fin (m + 1 + 1)) k) = F' := by
    have he : ∀ p q : Fin (m + 1 + 1), wcXspExtCoeff a0 p q =
        if h : (p : ℕ) < m + 1 ∧ (q : ℕ) < m + 1 then a0 ⟨p, h.1⟩ ⟨q, h.2⟩
        else if (p : ℕ) = m + 1 ∧ (q : ℕ) = m + 1 then -1 else 0 := fun _ _ => rfl
    have he1 : ∀ p q : Fin (m + 1), wcXspExtCoeff a0 p.castSucc q.castSucc = a0 p q := by
      intro p q
      rw [he, dif_pos (by simp only [Fin.coe_castSucc]; exact ⟨p.isLt, q.isLt⟩)]
      rfl
    have he2 : ∀ p : Fin (m + 1), wcXspExtCoeff a0 p.castSucc (Fin.last (m + 1)) = 0 := by
      intro p
      have := p.isLt
      rw [he, dif_neg (by simp only [Fin.coe_castSucc, Fin.val_last]; omega),
        if_neg (by simp only [Fin.coe_castSucc, Fin.val_last]; omega)]
    have he3 : ∀ q : Fin (m + 1), wcXspExtCoeff a0 (Fin.last (m + 1)) q.castSucc = 0 := by
      intro q
      have := q.isLt
      rw [he, dif_neg (by simp only [Fin.coe_castSucc, Fin.val_last]; omega),
        if_neg (by simp only [Fin.coe_castSucc, Fin.val_last]; omega)]
    have he4 : wcXspExtCoeff a0 (Fin.last (m + 1)) (Fin.last (m + 1)) = -1 := by
      rw [he, dif_neg (by simp only [Fin.val_last]; omega),
        if_pos (⟨Fin.val_last _, Fin.val_last _⟩ : ((Fin.last (m + 1) : Fin (m + 1 + 1)) : ℕ) = m + 1 ∧
          ((Fin.last (m + 1) : Fin (m + 1 + 1)) : ℕ) = m + 1)]
    show (∑ p, ∑ q, MvPolynomial.C (wcXspExtCoeff a0 p q) *
      (MvPolynomial.X p * MvPolynomial.X q) : MvPolynomial (Fin (m + 1 + 1)) k) = F'
    rw [hF'def, hQbdef]
    simp only [Fin.sum_univ_castSucc (n := m + 1), he1, he2, he3, he4, map_zero, zero_mul,
      Finset.sum_const_zero, add_zero, zero_add, map_sum, map_mul, MvPolynomial.rename_C,
      MvPolynomial.rename_X, map_neg, map_one, neg_one_mul]
    ring
  have hF'hom : F'.IsHomogeneous 2 := by
    rw [← hF]
    exact (MvPolynomial.mem_homogeneousSubmodule _ _).mp (wcLdpQuad k (m + 1) (wcXspExtCoeff a0)).2
  have hrange : ∀ x, x ∈ Set.range j ↔
      x ∉ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (m + 1 + 1)) k) F' := by
    intro x
    rw [hjr, ← hF]
    rfl

  let ℓ : Fin (m + 1) → MvPolynomial (Fin (m + 1 + 1)) k := fun i => MvPolynomial.X (Fin.castSucc i)
  have hℓ : ∀ i, (ℓ i).IsHomogeneous 1 := fun i => MvPolynomial.isHomogeneous_X k _
  obtain ⟨π₀, hπstr, hπpre⟩ := L3 k m ℓ hℓ
  have hren : ∀ g : MvPolynomial (Fin (m + 1)) k,
      MvPolynomial.aeval ℓ g = MvPolynomial.rename Fin.castSucc g := by
    intro g
    rw [MvPolynomial.rename_eq_aeval]
    rfl

  have hrangeU : Set.range j ⊆ ((⨆ i : Fin (m + 1), Proj.basicOpen
      (MvPolynomial.homogeneousSubmodule (Fin (m + 1 + 1)) k) (ℓ i) :
        (wcProjK k (m + 1)).Opens) : Set _) := by
    rintro _ ⟨r, rfl⟩
    have hFx : F' ∈ (j r).asHomogeneousIdeal.toIdeal := by
      have := (hrange (j r)).mp ⟨r, rfl⟩
      rw [Proj.mem_basicOpen, not_not] at this
      exact this
    by_contra hx
    have hx' : ∀ i, ℓ i ∈ (j r).asHomogeneousIdeal.toIdeal := by
      intro i
      by_contra hi
      apply hx
      rw [SetLike.mem_coe, TopologicalSpace.Opens.mem_iSup]
      exact ⟨i, (Proj.mem_basicOpen _ _ _).mpr hi⟩
    have hspan : Qb ∈ Ideal.span (MvPolynomial.X '' (Set.univ : Set (Fin (m + 1)))) := by
      rw [MvPolynomial.mem_ideal_span_X_image]
      intro μ hμ
      by_contra hc
      push_neg at hc
      have hμ0 : μ = 0 := Finsupp.ext fun i => hc i (Set.mem_univ i)
      rw [hμ0] at hμ
      exact (MvPolynomial.mem_support_iff.mp hμ) (hQ.coeff_eq_zero (by simp))
    have hrenQ : MvPolynomial.rename Fin.castSucc Qb ∈ (j r).asHomogeneousIdeal.toIdeal := by
      have h1 := Ideal.mem_map_of_mem
        (MvPolynomial.rename (R := k) (Fin.castSucc : Fin (m + 1) → Fin (m + 1 + 1))) hspan
      rw [Ideal.map_span] at h1
      refine (Ideal.span_le.mpr ?_) h1
      rintro _ ⟨_, ⟨i, _, rfl⟩, rfl⟩
      rw [MvPolynomial.rename_X]
      exact hx' i
    have hlast : MvPolynomial.X (Fin.last (m + 1)) ∈ (j r).asHomogeneousIdeal.toIdeal := by
      have h2 : MvPolynomial.X (Fin.last (m + 1)) ^ 2 ∈ (j r).asHomogeneousIdeal.toIdeal := by
        have := Ideal.sub_mem _ hrenQ hFx
        rwa [hF'def, sub_sub_cancel] at this
      exact (j r).isPrime.mem_of_pow_mem 2 h2
    obtain ⟨i₀, hi₀⟩ := c4 (m + 1) (j r)
    rw [Proj.mem_basicOpen] at hi₀
    apply hi₀
    rcases Fin.eq_castSucc_or_eq_last i₀ with ⟨i, rfl⟩ | rfl
    · exact hx' i
    · exact hlast

  set h₀ := IsOpenImmersion.lift (Scheme.Opens.ι _) j
    (by rw [Scheme.Opens.range_ι]; exact hrangeU) with hh₀
  have hfac : h₀ ≫ Scheme.Opens.ι _ = j := IsOpenImmersion.lift_fac _ _ _
  refine ⟨h₀ ≫ π₀, ?_, ?_⟩

  · haveI := hprop m
    haveI := hprop (m + 1)
    have hcomp : (h₀ ≫ π₀) ≫ wcProjKStr k m = j ≫ wcProjKStr k (m + 1) := by
      rw [Category.assoc, hπstr, ← Category.assoc, hfac]
    haveI : IsProper ((h₀ ≫ π₀) ≫ wcProjKStr k m) := by rw [hcomp]; infer_instance
    haveI : IsProper (h₀ ≫ π₀) := IsProper.of_comp _ (wcProjKStr k m)
    haveI : IsAffineHom (h₀ ≫ π₀) := by
      apply isAffineHom_of_forall_exists_isAffineOpen
      intro y
      obtain ⟨i, hi⟩ := c4 m y
      refine ⟨_, hi, ?_, ?_⟩
      · exact Proj.isAffineOpen_basicOpen _ _
          ((MvPolynomial.mem_homogeneousSubmodule _ _).mpr (MvPolynomial.isHomogeneous_X k i)) one_pos
      · rw [Scheme.Hom.comp_preimage,
          hπpre 1 (MvPolynomial.X i) one_pos (MvPolynomial.isHomogeneous_X k i),
          MvPolynomial.aeval_X, ← Scheme.Hom.comp_preimage, hfac]
        exact IsAffineHom.isAffine_preimage _ (Proj.isAffineOpen_basicOpen _ _
          ((MvPolynomial.mem_homogeneousSubmodule _ _).mpr (hℓ i)) one_pos)
    exact IsFinite.iff_isProper_and_isAffineHom.mpr ⟨inferInstance, inferInstance⟩

  · refine ⟨fun y => ?_⟩
    obtain ⟨i, hi⟩ := c4 m y
    obtain ⟨P, hPdef⟩ : ∃ P : Ideal (MvPolynomial (Fin (m + 1)) k),
        P = y.asHomogeneousIdeal.toIdeal := ⟨_, rfl⟩
    haveI hPp : P.IsPrime := hPdef ▸ y.isPrime
    have hiP : MvPolynomial.X i ∉ P := by
      rw [hPdef]
      exact (Proj.mem_basicOpen _ _ _).mp hi

    let R₀ := MvPolynomial (Fin (m + 1)) k ⧸ P
    let Kf := FractionRing R₀
    let L := AlgebraicClosure Kf
    let θ : MvPolynomial (Fin (m + 1)) k →+* L :=
      (algebraMap Kf L).comp ((algebraMap R₀ Kf).comp (Ideal.Quotient.mk P))
    have hθ : ∀ a, θ a = 0 ↔ a ∈ P := by
      intro a
      simp only [θ, RingHom.comp_apply]
      rw [map_eq_zero_iff _ (algebraMap Kf L).injective,
        map_eq_zero_iff _ (IsFractionRing.injective R₀ Kf), Ideal.Quotient.eq_zero_iff_mem]
    obtain ⟨t, ht⟩ := IsAlgClosed.exists_eq_mul_self (θ Qb)
    let w : Fin (m + 1 + 1) → L := Fin.lastCases t (fun i => θ (MvPolynomial.X i))
    let Θ : MvPolynomial (Fin (m + 1 + 1)) k →+* L := MvPolynomial.eval₂Hom (θ.comp MvPolynomial.C) w
    have hΘ : ∀ a, Θ (MvPolynomial.rename Fin.castSucc a) = θ a := by
      intro a
      have : Θ.comp (MvPolynomial.rename Fin.castSucc).toRingHom = θ := by
        apply MvPolynomial.ringHom_ext
        · intro r
          simp [Θ]
        · intro i
          simp [Θ, w]
      exact RingHom.congr_fun this a
    have hP'prime : (RingHom.ker Θ).IsPrime := RingHom.ker_isPrime Θ
    have hFP' : F' ∈ RingHom.ker Θ := by
      rw [RingHom.mem_ker, hF'def, map_sub, map_pow, hΘ, ht]
      simp only [Θ, w, MvPolynomial.eval₂Hom_X', Fin.lastCases_last]
      ring
    have hcomap : ∀ a, MvPolynomial.rename Fin.castSucc a ∈ RingHom.ker Θ ↔ a ∈ P := by
      intro a
      rw [RingHom.mem_ker, hΘ, hθ]
    have hXP' : MvPolynomial.X (Fin.castSucc i) ∉ RingHom.ker Θ := by
      intro h
      apply hiP
      rw [← hcomap, MvPolynomial.rename_X]
      exact h

    have hHprime := hP'prime.homogeneousCore
      (𝒜 := MvPolynomial.homogeneousSubmodule (Fin (m + 1 + 1)) k)
    have hHrel : ¬ HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (m + 1 + 1)) k) ≤
        Ideal.homogeneousCore (MvPolynomial.homogeneousSubmodule (Fin (m + 1 + 1)) k)
          (RingHom.ker Θ) := by
      intro hle
      apply hXP'
      have h1 : MvPolynomial.X (Fin.castSucc i) ∈
          HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (m + 1 + 1)) k) :=
        HomogeneousIdeal.mem_irrelevant_of_mem _ one_pos
          ((MvPolynomial.mem_homogeneousSubmodule _ _).mpr (MvPolynomial.isHomogeneous_X k _))
      exact Ideal.toIdeal_homogeneousCore_le _ _ (HomogeneousIdeal.mem_iff.mpr (hle h1))
    let z : wcProjK k (m + 1) :=
      (ProjectiveSpectrum.mk _ hHprime hHrel :
        ProjectiveSpectrum (MvPolynomial.homogeneousSubmodule (Fin (m + 1 + 1)) k))
    have hz : ∀ (d : ℕ) (g : MvPolynomial (Fin (m + 1 + 1)) k), g.IsHomogeneous d →
        (z ∈ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (m + 1 + 1)) k) g ↔
          g ∉ RingHom.ker Θ) := by
      intro d g hg
      rw [Proj.mem_basicOpen]
      apply not_congr
      constructor
      · intro hgH
        exact Ideal.toIdeal_homogeneousCore_le _ _ (HomogeneousIdeal.mem_iff.mpr hgH)
      · intro hgP
        exact Ideal.mem_homogeneousCore_of_homogeneous_of_mem
          ⟨d, (MvPolynomial.mem_homogeneousSubmodule _ _).mpr hg⟩ hgP
    obtain ⟨r, hr⟩ := (hrange z).mpr (fun h => ((hz 2 F' hF'hom).mp h) hFP')
    refine ⟨r, ?_⟩

    have hmem : ∀ (d : ℕ) (g : MvPolynomial (Fin (m + 1)) k), 0 < d → g.IsHomogeneous d →
        ((h₀ ≫ π₀) r ∈ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) k) g ↔
          g ∉ P) := by
      intro d g hd hg
      have e1 := SetLike.ext_iff.mp (hπpre d g hd hg) (h₀ r)
      rw [Scheme.Hom.comp_apply, ← Scheme.Hom.mem_preimage, e1, Scheme.Hom.mem_preimage,
        ← Scheme.Hom.comp_apply, hfac, hr, hren, hz d _ hg.rename_isHomogeneous, hcomap]

    have hdec : ∀ (φ : MvPolynomial (Fin (m + 1)) k) (i : ℕ),
        ((DirectSum.decompose (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) k) φ) i :
          MvPolynomial (Fin (m + 1)) k) = MvPolynomial.homogeneousComponent i φ :=
      fun φ i => MvPolynomial.decomposition.decompose'_apply φ i
    have hcomp : ∀ (I : HomogeneousIdeal (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) k))
        (f : MvPolynomial (Fin (m + 1)) k),
        f ∈ I ↔ ∀ e, MvPolynomial.homogeneousComponent e f ∈ I := by
      intro I f
      rw [← HomogeneousIdeal.mem_iff, I.isHomogeneous.mem_iff]
      simp only [hdec, HomogeneousIdeal.mem_iff]
    have hconst : ∀ (x : wcProjK k m) (c : k),
        MvPolynomial.C c ∈ x.asHomogeneousIdeal ↔ c = 0 := by
      intro x c
      constructor
      · intro hc
        by_contra hc0
        apply x.isPrime.ne_top
        exact Ideal.eq_top_of_isUnit_mem _ (HomogeneousIdeal.mem_iff.mpr hc)
          ((isUnit_iff_ne_zero.mpr hc0).map MvPolynomial.C)
      · rintro rfl
        rw [map_zero]
        exact zero_mem _
    apply ProjectiveSpectrum.ext
    apply HomogeneousIdeal.toIdeal_injective
    ext a
    rw [HomogeneousIdeal.mem_iff, HomogeneousIdeal.mem_iff, hcomp, hcomp]
    apply forall_congr'
    intro e
    rcases Nat.eq_zero_or_pos e with rfl | he
    · rw [MvPolynomial.homogeneousComponent_zero, hconst, hconst]
    · have := hmem e _ he (MvPolynomial.homogeneousComponent_isHomogeneous e a)
      rw [Proj.mem_basicOpen, hPdef] at this
      exact not_iff_not.mp this

theorem wc_xspl_oddq_R_integral (k : Type u) [Field k] (n : ℕ) (hn : 2 ≤ n)
    (a0 : Fin n → Fin n → k) (ha : (Matrix.of a0 + (Matrix.of a0).transpose).det ≠ 0)
    (R : Scheme.{u}) [AlgebraicGeometry.IsReduced R] (j : R ⟶ wcProjK k n)
    (hj : IsClosedImmersion j) (hjr : Set.range j = wcXspVplus k n (wcXspExtCoeff a0)) :
    AlgebraicGeometry.IsIntegral R :=
by
  set Qb : MvPolynomial (Fin n) k := ∑ p : Fin n, ∑ q : Fin n,
    MvPolynomial.C (a0 p q) * (MvPolynomial.X p * MvPolynomial.X q) with hQb

  have hE : ((wcLdpQuad k n (wcXspExtCoeff a0) : MvPolynomial (Fin (n + 1)) k)) =
      MvPolynomial.rename Fin.castSucc Qb - MvPolynomial.X (Fin.last n) ^ 2 := by
    have h1 : ∀ p q : Fin n, wcXspExtCoeff a0 p.castSucc q.castSucc = a0 p q := by
      intro p q
      unfold wcXspExtCoeff
      rw [dif_pos ⟨p.isLt, q.isLt⟩]
      rfl
    have h2 : ∀ p : Fin n, wcXspExtCoeff a0 p.castSucc (Fin.last n) = 0 := by
      intro p
      unfold wcXspExtCoeff
      rw [dif_neg (fun h => lt_irrefl n h.2), if_neg (fun h => p.isLt.ne h.1)]
    have h3 : ∀ q : Fin n, wcXspExtCoeff a0 (Fin.last n) q.castSucc = 0 := by
      intro q
      unfold wcXspExtCoeff
      rw [dif_neg (fun h => lt_irrefl n h.1), if_neg (fun h => q.isLt.ne h.2)]
    have h4 : wcXspExtCoeff a0 (Fin.last n) (Fin.last n) = (-1 : k) := by
      unfold wcXspExtCoeff
      rw [dif_neg (fun h => lt_irrefl n h.1), if_pos ⟨rfl, rfl⟩]
    show (∑ p : Fin (n + 1), ∑ q : Fin (n + 1), MvPolynomial.C (wcXspExtCoeff a0 p q) *
      (MvPolynomial.X p * MvPolynomial.X q) : MvPolynomial (Fin (n + 1)) k) = _
    rw [hQb]
    simp only [map_sum, map_mul, MvPolynomial.rename_C, MvPolynomial.rename_X,
      Fin.sum_univ_castSucc, h1, h2, h3, h4, map_zero, zero_mul, Finset.sum_const_zero,
      add_zero, zero_add, map_neg, map_one]
    ring

  have hQ : ∀ c : MvPolynomial (Fin n) k, c * c ≠ Qb := by
    intro c hc
    have hcc0 : MvPolynomial.constantCoeff Qb = 0 := by
      simp [hQb]
    have hc0 : MvPolynomial.constantCoeff c = 0 := by
      have : MvPolynomial.constantCoeff c * MvPolynomial.constantCoeff c = 0 := by
        rw [← map_mul, hc, hcc0]
      exact mul_self_eq_zero.mp this
    have hS0 : ∀ (i j p : Fin n),
        MvPolynomial.pderiv i ((Pi.single j 1 : Fin n → MvPolynomial (Fin n) k) p) = 0 := by
      intro i j p
      rw [Pi.single_apply]
      split_ifs <;> simp
    have hS1 : ∀ (j p : Fin n), MvPolynomial.constantCoeff
        ((Pi.single j 1 : Fin n → MvPolynomial (Fin n) k) p) = if p = j then (1 : k) else 0 := by
      intro j p
      rw [Pi.single_apply]
      split_ifs <;> simp
    have hterm : ∀ (i j p q : Fin n) (a : k),
        MvPolynomial.constantCoeff (MvPolynomial.pderiv i (MvPolynomial.pderiv j
          (MvPolynomial.C a * (MvPolynomial.X p * MvPolynomial.X q)))) =
        a * ((if p = j then (1 : k) else 0) * (if q = i then (1 : k) else 0) +
          (if p = i then (1 : k) else 0) * (if q = j then (1 : k) else 0)) := by
      intro i j p q a
      simp only [MvPolynomial.pderiv_mul, MvPolynomial.pderiv_C, MvPolynomial.pderiv_X,
        zero_mul, zero_add, map_add, hS0, mul_zero, add_zero, map_mul,
        MvPolynomial.constantCoeff_C, hS1]
      try ring
    have hHQ : ∀ i j : Fin n, MvPolynomial.constantCoeff
        (MvPolynomial.pderiv i (MvPolynomial.pderiv j Qb)) = a0 j i + a0 i j := by
      intro i j
      rw [hQb]
      simp only [map_sum, hterm]
      simp [mul_add, Finset.sum_add_distrib, mul_ite, ite_mul, Finset.sum_ite_eq,
        Finset.sum_ite_eq']
    have hHc : ∀ i j : Fin n, MvPolynomial.constantCoeff
        (MvPolynomial.pderiv i (MvPolynomial.pderiv j (c * c))) =
        2 * MvPolynomial.constantCoeff (MvPolynomial.pderiv i c) *
          MvPolynomial.constantCoeff (MvPolynomial.pderiv j c) := by
      intro i j
      simp only [MvPolynomial.pderiv_mul, map_add, map_mul, hc0, mul_zero, zero_mul,
        zero_add, add_zero]
      ring
    have hmat : Matrix.of a0 + (Matrix.of a0).transpose =
        Matrix.vecMulVec (fun i => 2 * MvPolynomial.constantCoeff (MvPolynomial.pderiv i c))
          (fun i => MvPolynomial.constantCoeff (MvPolynomial.pderiv i c)) := by
      ext i j
      have e1 := hHQ i j
      rw [← hc, hHc] at e1
      simp only [Matrix.add_apply, Matrix.of_apply, Matrix.transpose_apply,
        Matrix.vecMulVec_apply]
      linear_combination -e1
    haveI : Nontrivial (Fin n) := Fin.nontrivial_iff_two_le.mpr hn
    exact ha (by rw [hmat]; exact Matrix.det_vecMulVec _ _)

  have hP : Prime (MvPolynomial.rename Fin.castSucc Qb - MvPolynomial.X (Fin.last n) ^ 2 :
      MvPolynomial (Fin (n + 1)) k) := by
    let Ψ : MvPolynomial (Fin (n + 1)) k ≃ₐ[k] Polynomial (MvPolynomial (Fin n) k) :=
      (MvPolynomial.renameEquiv k finSuccEquivLast).trans (MvPolynomial.optionEquivLeft k (Fin n))
    have hΨX : ∀ i : Fin n, Ψ (MvPolynomial.X i.castSucc) = Polynomial.C (MvPolynomial.X i) := by
      intro i
      simp [Ψ, MvPolynomial.renameEquiv_apply, MvPolynomial.rename_X, finSuccEquivLast_castSucc,
        MvPolynomial.optionEquivLeft_X_some]
    have hΨren : Ψ (MvPolynomial.rename Fin.castSucc Qb) = Polynomial.C Qb := by
      have hh : (Ψ.toAlgHom.comp (MvPolynomial.rename Fin.castSucc)) =
          (Polynomial.CAlgHom : MvPolynomial (Fin n) k →ₐ[k] Polynomial (MvPolynomial (Fin n) k)) := by
        apply MvPolynomial.algHom_ext
        intro i
        rw [AlgHom.comp_apply, MvPolynomial.rename_X, Polynomial.CAlgHom_apply]
        exact hΨX i
      have := DFunLike.congr_fun hh Qb
      rw [AlgHom.comp_apply, Polynomial.CAlgHom_apply] at this
      exact this
    have hΨlast : Ψ (MvPolynomial.X (Fin.last n)) = Polynomial.X := by
      simp [Ψ, MvPolynomial.renameEquiv_apply, finSuccEquivLast_last,
        MvPolynomial.optionEquivLeft_X_none]
    have hΨF : Ψ (MvPolynomial.rename Fin.castSucc Qb - MvPolynomial.X (Fin.last n) ^ 2) =
        -(Polynomial.X ^ 2 - Polynomial.C Qb) := by
      rw [map_sub, map_pow, hΨren, hΨlast]
      ring
    have hirr : Irreducible (Polynomial.X ^ 2 - Polynomial.C Qb :
        Polynomial (MvPolynomial (Fin n) k)) := by
      by_contra h
      have hm : (Polynomial.X ^ 2 - Polynomial.C Qb :
          Polynomial (MvPolynomial (Fin n) k)).Monic :=
        Polynomial.monic_X_pow_sub_C _ (by norm_num)
      obtain ⟨c₁, c₂, h0, h1⟩ :=
        (hm.not_irreducible_iff_exists_add_mul_eq_coeff Polynomial.natDegree_X_pow_sub_C).mp h
      have e0 : (Polynomial.X ^ 2 - Polynomial.C Qb :
          Polynomial (MvPolynomial (Fin n) k)).coeff 0 = -Qb := by
        simp
      have e1 : (Polynomial.X ^ 2 - Polynomial.C Qb :
          Polynomial (MvPolynomial (Fin n) k)).coeff 1 = 0 := by
        simp [Polynomial.coeff_X_pow, Polynomial.coeff_C]
      rw [e0] at h0
      rw [e1] at h1
      exact hQ c₁ (by linear_combination h0 - c₁ * h1)
    have hprime : Prime (-(Polynomial.X ^ 2 - Polynomial.C Qb) :
        Polynomial (MvPolynomial (Fin n) k)) :=
      (UniqueFactorizationMonoid.irreducible_iff_prime.mp hirr).neg
    rw [← hΨF] at hprime
    exact (MulEquiv.prime_iff Ψ).mp hprime

  set F : MvPolynomial (Fin (n + 1)) k :=
    (wcLdpQuad k n (wcXspExtCoeff a0) : MvPolynomial (Fin (n + 1)) k) with hFdef
  have hFp : Prime F := by rw [hE]; exact hP
  have hFmem : F ∈ MvPolynomial.homogeneousSubmodule (Fin (n + 1)) k 2 :=
    (wcLdpQuad k n (wcXspExtCoeff a0)).2
  have hIhom : (Ideal.span {F}).IsHomogeneous (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) k) :=
    Ideal.homogeneous_span _ _ (by
      intro x hx
      rw [Set.mem_singleton_iff] at hx
      rw [hx]
      exact ⟨2, hFmem⟩)
  have hF0 : F ≠ 0 := hFp.ne_zero
  have hIprime : (Ideal.span {F}).IsPrime := (Ideal.span_singleton_prime hF0).mpr hFp
  let I : HomogeneousIdeal (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) k) :=
    ⟨Ideal.span {F}, hIhom⟩
  have hrel : ¬ HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) k)
      ≤ I := by
    intro hle
    have hX : (MvPolynomial.X 0 : MvPolynomial (Fin (n + 1)) k) ∈
        HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) k) :=
      HomogeneousIdeal.mem_irrelevant_of_mem _ one_pos
        ((MvPolynomial.mem_homogeneousSubmodule _ _).mpr (MvPolynomial.isHomogeneous_X k 0))
    have hXI : (MvPolynomial.X 0 : MvPolynomial (Fin (n + 1)) k) ∈ I.toIdeal :=
      HomogeneousIdeal.mem_iff.mpr (hle hX)
    change _ ∈ Ideal.span {F} at hXI
    obtain ⟨h, hh⟩ := Ideal.mem_span_singleton.mp hXI
    have hX0 : (MvPolynomial.X 0 : MvPolynomial (Fin (n + 1)) k) ≠ 0 := MvPolynomial.X_ne_zero _
    have hh0 : h ≠ 0 := by
      rintro rfl
      rw [mul_zero] at hh
      exact hX0 hh
    have hdeg := congrArg MvPolynomial.totalDegree hh
    rw [MvPolynomial.totalDegree_mul_of_isDomain hF0 hh0, MvPolynomial.totalDegree_X,
      ((MvPolynomial.mem_homogeneousSubmodule _ _).mp hFmem).totalDegree hF0] at hdeg
    omega
  let η : ProjectiveSpectrum (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) k) :=
    ⟨I, hIprime, hrel⟩
  have hrange : Set.range j = closure ({η} : Set (ProjectiveSpectrum
      (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) k))) := by
    rw [hjr]
    have key : ∀ y : ProjectiveSpectrum (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) k),
        F ∈ y.asHomogeneousIdeal ↔ y ∈ closure ({η} : Set (ProjectiveSpectrum
          (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) k))) := by
      intro x
      rw [← ProjectiveSpectrum.le_iff_mem_closure, ← ProjectiveSpectrum.as_ideal_le_as_ideal]
      constructor
      · intro hFx y hy
        have hy' : y ∈ Ideal.span {F} :=
          (HomogeneousIdeal.mem_iff (I := η.asHomogeneousIdeal)).mpr hy
        have h2 : Ideal.span {F} ≤ x.asHomogeneousIdeal.toIdeal :=
          (Ideal.span_singleton_le_iff_mem _).mpr (HomogeneousIdeal.mem_iff.mpr hFx)
        exact HomogeneousIdeal.mem_iff.mp (h2 hy')
      · intro hle
        exact hle ((HomogeneousIdeal.mem_iff (I := η.asHomogeneousIdeal)).mp
          (Ideal.mem_span_singleton_self F))
    ext x
    change x ∉ Proj.basicOpen _ F ↔ _
    rw [Proj.mem_basicOpen, not_not]
    exact key x
  have hirr : IsIrreducible (Set.range j) := by
    rw [hrange]
    exact isIrreducible_singleton.closure
  haveI : IrreducibleSpace (Set.range j) := Subtype.irreducibleSpace hirr
  haveI := hj
  let he := (j.isClosedEmbedding.isEmbedding).toHomeomorph
  haveI : IrreducibleSpace R :=
    Function.Surjective.irreducibleSpace he.symm.continuous he.symm.surjective
  exact isIntegral_of_irreducibleSpace_of_isReduced R

theorem wc_finite_surj_unit_split_normal_base (k : Type u) [Field k] [Infinite k]
    (S : Scheme.{u}) [AlgebraicGeometry.IsIntegral S] [QuasiSeparatedSpace ↥S]
    (sk : S ⟶ Spec (.of k)) (hS : ∀ x : ↥S, IsIntegrallyClosed (S.presheaf.stalk x))
    (Z : Scheme.{u}) [AlgebraicGeometry.IsIntegral Z] (g : Z ⟶ S) [IsFinite g]
    (hg : Surjective g) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (Dg : wcHMPullData g ℓ)
    (hDg : wcHMPullCanonical Dg) :
    ∃ r : wcSuppObj Dg ⟶ SheafOfModules.unit (wcRingSheaf S ℓ), wcSuppUnitMap Dg ≫ r = 𝟙 _ :=
by
  classical

  have hA := wc_fsus_affine_sections_intclosed S hS

  obtain ⟨M, _, _, _, _, e, he⟩ := wc_fsus_normal_closure_point g hg

  have hL3 := wc_fsus_intclosure_geom_transitive wc_fsus_alg_geom_transitive wc_fsus_fixed_pow_mem

  obtain ⟨Zt, πt, q, G, _, _, act, hq, hUC, hS', hact, hmul, htr⟩ :=
    wc_fsus_galois_cover g M e he (by
      intro f _ _ hf act' h₁ h₂ Ω _ z₁ z₂ h
      exact wc_fsus_normalization_geom_transitive hL3 k S sk hA M f hf act' h₁ h₂ Ω z₁ z₂ h)
  haveI := hUC
  haveI := hS'

  obtain ⟨T, hTa, hTl, hTn, hT1⟩ := wc_fsus_galois_average ℓ g πt q hq G act hact hmul
    (fun v w₁ w₂ h => wc_fsus_point_transitive πt G act hact htr v w₁ w₂ h)

  obtain ⟨u, hu, hσ⟩ := wc_supp_unit_section Dg hDg
  obtain ⟨w, hw⟩ : ∃ w : C(↥Z, ULift.{u+1} ℚ_[ℓ]), ∀ x, u x * w x = 1 :=
    ⟨_, fun x => DFunLike.congr_fun hu.mul_val_inv x⟩

  obtain ⟨T', hT'⟩ : ∃ T' : ∀ V : S.ProEt,
      C(↥(Limits.pullback V.hom g), ULift.{u+1} ℚ_[ℓ]) → C(↥V.left, ULift.{u+1} ℚ_[ℓ]),
      ∀ V f, T' V f = T V.left V.hom (f * w.comp (Limits.pullback.snd V.hom g).base.hom) :=
    ⟨_, fun _ _ => rfl⟩
  have hadd : ∀ (V : S.ProEt) (f h : C(↥(Limits.pullback V.hom g), ULift.{u+1} ℚ_[ℓ])),
      T' V (f + h) = T' V f + T' V h := by
    intro V f h
    rw [hT', hT', hT', add_mul, hTa]
  have hlin : ∀ (V : S.ProEt) (s : C(↥V.left, ULift.{u+1} ℚ_[ℓ]))
      (f : C(↥(Limits.pullback V.hom g), ULift.{u+1} ℚ_[ℓ])),
      T' V ((s.comp (Limits.pullback.fst V.hom g).base.hom) * f) = s * T' V f := by
    intro V s f
    rw [hT', hT', mul_assoc, hTl]
  have hnat : ∀ {W V : S.ProEt} (e : W ⟶ V)
      (f : C(↥(Limits.pullback V.hom g), ULift.{u+1} ℚ_[ℓ])),
      T' W (f.comp ((wcProEtBC g).map e).left.base.hom) = (T' V f).comp e.left.base.hom := by
    intro W V e f
    have hβs : ((wcProEtBC g).map e).left ≫ Limits.pullback.snd V.hom g =
        Limits.pullback.snd W.hom g := Limits.pullback.lift_snd _ _ _
    have hβf : ((wcProEtBC g).map e).left ≫ Limits.pullback.fst V.hom g =
        Limits.pullback.fst W.hom g ≫ e.left := Limits.pullback.lift_fst _ _ _
    have key : ((f.comp ((wcProEtBC g).map e).left.base.hom :
          C(↥(Limits.pullback W.hom g), ULift.{u+1} ℚ_[ℓ])) *
          w.comp (Limits.pullback.snd W.hom g).base.hom :
          C(↥(Limits.pullback W.hom g), ULift.{u+1} ℚ_[ℓ])) =
        (f * w.comp (Limits.pullback.snd V.hom g).base.hom).comp
          ((wcProEtBC g).map e).left.base.hom := by
      refine ContinuousMap.ext fun x => ?_
      have hpt : (Limits.pullback.snd V.hom g).base.hom
          (((wcProEtBC g).map e).left.base.hom x) = (Limits.pullback.snd W.hom g).base.hom x :=
        congrArg (fun h => h.base.hom x) hβs
      show f (((wcProEtBC g).map e).left.base.hom x) * w ((Limits.pullback.snd W.hom g).base.hom x) =
        f (((wcProEtBC g).map e).left.base.hom x) *
          w ((Limits.pullback.snd V.hom g).base.hom (((wcProEtBC g).map e).left.base.hom x))
      rw [hpt]
    refine (hT' W _).trans ?_
    refine (congrArg (T W.left W.hom) key).trans ?_
    refine Eq.trans ?_ (congrArg (fun t => t.comp e.left.base.hom) (hT' V f)).symm
    exact hTn V.left W.left V.hom W.hom e.left (MorphismProperty.Over.w e) _ hβf hβs _

  refine ⟨⟨PresheafOfModules.homMk
    { app := fun X => AddCommGrpCat.ofHom (AddMonoidHom.mk' (T' X.unop) (hadd X.unop))
      naturality := fun X X' e => by
        ext x
        exact hnat e.unop x } ?_⟩, ?_⟩
  · intro X r x
    have h1 := hlin X.unop r x
    rw [← hDg X.unop r] at h1
    exact h1
  · apply (SheafOfModules.unitHomEquiv _).injective
    rw [SheafOfModules.unitHomEquiv_comp_apply]
    apply Subtype.ext
    funext X
    obtain ⟨V⟩ := X
    show T' V ((SheafOfModules.unitHomEquiv _ (wcSuppUnitMap Dg)).1 (Opposite.op V) :
        C(↥(Limits.pullback V.hom g), ULift.{u+1} ℚ_[ℓ])) = (1 : C(↥V.left, ULift.{u+1} ℚ_[ℓ]))
    have e1 : u.comp (Limits.pullback.snd V.hom g).base.hom *
          w.comp (Limits.pullback.snd V.hom g).base.hom =
        (1 : C(↥V.left, ULift.{u+1} ℚ_[ℓ])).comp (Limits.pullback.fst V.hom g).base.hom := by
      refine ContinuousMap.ext fun x => ?_
      simp only [ContinuousMap.mul_apply, ContinuousMap.comp_apply, ContinuousMap.one_apply]
      exact hw _
    refine (congrArg (T' V) (hσ V)).trans ?_
    refine (hT' V _).trans ?_
    refine (congrArg (T V.left V.hom) e1).trans ?_
    exact hT1 V.left V.hom 1

theorem wc_finite_lfp_pushforward_exact {S Z : Scheme.{u}} (g : Z ⟶ S) [IsFinite g]
    [LocallyOfFinitePresentation g] (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (Dg : wcHMPullData g ℓ) :
    Limits.PreservesFiniteColimits
      (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC g) _ _ Dg.cont Dg.φ) :=
by
  classical
  haveI hcont := Dg.cont

  have hsplit : ∀ (V : S.ProEt) (T : Sieve ((wcProEtBC g).obj V)),
      T ∈ Scheme.ProEt.topology Z ((wcProEtBC g).obj V) →
      ∃ R : Presieve V, Sieve.generate R ∈ Scheme.ProEt.topology S V ∧
        ∀ ⦃W : S.ProEt⦄ (f : W ⟶ V), R f →
          ∃ (n : ℕ) (P : Fin n → Z.ProEt) (ι : ∀ k, P k ⟶ (wcProEtBC g).obj W),
            (∀ k, IsOpenImmersion (ι k).left) ∧
            (∀ x : ((wcProEtBC g).obj W).left, ∃! k, x ∈ Set.range ⇑(ι k).left) ∧
            ∀ k, T (ι k ≫ (wcProEtBC g).map f) := by
    intro V T hT
    refine ⟨fun (W : S.ProEt) (_ : W ⟶ V) => IsAffine W.left ∧
        (IsClosed {x : W.left | IsClosed ({x} : Set W.left)} ∧
        (∀ x : W.left, ∃! y : W.left, IsClosed ({y} : Set W.left) ∧ x ⤳ y) ∧
        ExtremallyDisconnected {x : W.left | IsClosed ({x} : Set W.left)} ∧
        (∀ x : W.left, IsClosed ({x} : Set W.left) →
          HenselianLocalRing (W.left.presheaf.stalk x) ∧ IsSepClosed (W.left.residueField x))),
      wc_proet_cover_of_affine_local (fun Δ => IsClosed {x : Δ | IsClosed ({x} : Set Δ)} ∧
        (∀ x : Δ, ∃! y : Δ, IsClosed ({y} : Set Δ) ∧ x ⤳ y) ∧
        ExtremallyDisconnected {x : Δ | IsClosed ({x} : Set Δ)} ∧
        (∀ x : Δ, IsClosed ({x} : Set Δ) →
          HenselianLocalRing (Δ.presheaf.stalk x) ∧ IsSepClosed (Δ.residueField x)))
        (fun V₀ hV₀ => wc_exists_wcontractible_cover V₀ hV₀) V, ?_⟩
    intro W f hRf
    obtain ⟨hWa, q1, q2, q3, q4⟩ := hRf
    haveI : IsAffine W.left := hWa
    haveI : IsAffine ((𝟭 Scheme.{u}).obj W.left) := hWa

    have hUa : IsAffine (Limits.pullback W.hom g) :=
      isAffine_of_isAffineHom (Limits.pullback.fst W.hom g)
    obtain ⟨r1, r2, r3, r4⟩ :=
      wc_wlocal_strictHensel_finite_stable (Limits.pullback.fst W.hom g) hWa q1 q2 q3 q4
    have hRET := wc_wlocal_strictHensel_retraction (Limits.pullback W.hom g) hUa r1 r2 r3 r4
    have hT' : T.pullback ((wcProEtBC g).map f) ∈
        Scheme.ProEt.topology Z ((wcProEtBC g).obj W) :=
      (Scheme.ProEt.topology Z).pullback_stable _ hT
    obtain ⟨n, P, fk, hPa, hTfk, hsurj⟩ :=
      wc_proet_cover_affine_finite_refine ((wcProEtBC g).obj W) hUa _ hT'
    obtain ⟨m, Q, ι, hopen, huniq, hfac⟩ :=
      wc_ret_disjoint_open_refine ((wcProEtBC g).obj W) hUa hRET n P fk hPa hsurj
    refine ⟨m, Q, ι, hopen, huniq, fun j => ?_⟩
    obtain ⟨k, h, hh⟩ := hfac j
    have hj := (T.pullback ((wcProEtBC g).map f)).downward_closed (hTfk k) h
    rw [hh] at hj
    exact hj

  haveI hepi := wc_sheafPushforward_preservesEpi_of_split (wcProEtBC g) hsplit

  haveI hlim : Limits.PreservesFiniteLimits ((wcProEtBC g).sheafPushforwardContinuous
      AddCommGrpCat.{u+1} (Scheme.ProEt.topology S) (Scheme.ProEt.topology Z)) :=
    inferInstance
  haveI : ((wcProEtBC g).sheafPushforwardContinuous AddCommGrpCat.{u+1}
      (Scheme.ProEt.topology S) (Scheme.ProEt.topology Z)).PreservesZeroMorphisms :=
    Functor.preservesZeroMorphisms_of_preserves_terminal_object
  haveI : ((wcProEtBC g).sheafPushforwardContinuous AddCommGrpCat.{u+1}
      (Scheme.ProEt.topology S) (Scheme.ProEt.topology Z)).Additive :=
    Functor.additive_of_preserves_binary_products _
  haveI : ((wcProEtBC g).sheafPushforwardContinuous AddCommGrpCat.{u+1}
      (Scheme.ProEt.topology S) (Scheme.ProEt.topology Z)).PreservesHomology :=
    Functor.preservesHomology_of_preservesEpis_and_kernels _
  haveI hcolim : Limits.PreservesFiniteColimits ((wcProEtBC g).sheafPushforwardContinuous
      AddCommGrpCat.{u+1} (Scheme.ProEt.topology S) (Scheme.ProEt.topology Z)) :=
    Functor.preservesFiniteColimits_of_preservesHomology _

  haveI := sheafOfModules_toSheaf_preservesFiniteColimits
    (Scheme.ProEt.topology S) (wcRingSheaf S ℓ)
  haveI := sheafOfModules_toSheaf_preservesFiniteColimits
    (Scheme.ProEt.topology Z) (wcRingSheaf Z ℓ)
  exact (sheafOfModules_pushforward_exact (wcProEtBC g) (wcRingSheaf S ℓ)
    (wcRingSheaf Z ℓ) Dg.φ).2.2

theorem wc_projK_integral_normal (K : Type u) [Field K] (m : ℕ) :
    AlgebraicGeometry.IsIntegral (wcProjK K m) ∧
      (∀ x : ↥(wcProjK K m), IsIntegrallyClosed ((wcProjK K m).presheaf.stalk x)) ∧
      QuasiSeparatedSpace ↥(wcProjK K m) ∧ IsLocallyNoetherian (wcProjK K m) :=
by
  haveI := wc_proj_space_smooth K m
  haveI := wc_proj_space_isProper K m
  haveI := wc_proj_space_irreducible K m
  haveI : Smooth (wcProjKStr K m) := SmoothOfRelativeDimension.smooth m (wcProjKStr K m)
  have hst : ∀ x : ↥(wcProjK K m), IsDomain ((wcProjK K m).presheaf.stalk x) ∧
      IsIntegrallyClosed ((wcProjK K m).presheaf.stalk x) := fun x =>
    wc_fntame_smooth_stalk_normal K (wcProjK K m) (wcProjKStr K m) x
  haveI : ∀ x : ↥(wcProjK K m), IsDomain ((wcProjK K m).presheaf.stalk x) := fun x => (hst x).1
  haveI : ∀ x : ↥(wcProjK K m), _root_.IsReduced ((wcProjK K m).presheaf.stalk x) :=
    fun x => inferInstance
  haveI : AlgebraicGeometry.IsReduced (wcProjK K m) := isReduced_of_isReduced_stalk _
  exact ⟨isIntegral_of_irreducibleSpace_of_isReduced _, fun x => (hst x).2,
    quasiSeparatedSpace_of_quasiSeparated (wcProjKStr K m),
    LocallyOfFiniteType.isLocallyNoetherian (wcProjKStr K m)⟩

theorem wc_xspl_oddq_proj_pull_inj (k : Type u) [Field k] [IsSepClosed k] (ℓ : ℕ)
    [Fact (Nat.Prime ℓ)] (hℓ : ((ℓ : ℕ) : k) ≠ 0) (n : ℕ) (hn : Even n) (hn4 : 4 ≤ n)
    (a0 : Fin n → Fin n → k) (ha : (Matrix.of a0 + (Matrix.of a0).transpose).det ≠ 0)
    (R : Scheme.{u}) [AlgebraicGeometry.IsReduced R] (j : R ⟶ wcProjK k n)
    (hj : IsClosedImmersion j) (hjr : Set.range j = wcXspVplus k n (wcXspExtCoeff a0)) :
    ∃ π : R ⟶ wcProjK k (n - 1), ∀ (D : wcHMPullData π ℓ), wcHMPullCanonical D →
      Function.Injective (wcHMPull D (2 * (n - 1))) :=
by

  haveI hinf : Infinite k := by
    by_contra hfin
    rw [not_infinite_iff_finite] at hfin
    letI := Fintype.ofFinite k
    have hq : 1 < Fintype.card k := Fintype.one_lt_card
    let p : Polynomial k := Polynomial.X ^ Fintype.card k - Polynomial.X - 1
    have hder : Polynomial.derivative p = -1 := by
      simp [p, Polynomial.derivative_X_pow, FiniteField.cast_card_eq_zero]
    have hsep : p.Separable := by
      rw [Polynomial.Separable, hder]
      exact (isCoprime_one_right (x := p)).neg_right
    have hdeg : p.natDegree = Fintype.card k := by
      have h1 : (Polynomial.X + 1 : Polynomial k).natDegree < (Polynomial.X ^ Fintype.card k :
          Polynomial k).natDegree := by
        have h11 : (Polynomial.X + 1 : Polynomial k).natDegree = 1 := by
          simpa using Polynomial.natDegree_X_add_C (1 : k)
        rw [Polynomial.natDegree_X_pow, h11]
        exact hq
      have e : p = Polynomial.X ^ Fintype.card k - (Polynomial.X + 1) := by
        simp only [p]; ring
      rw [e, Polynomial.natDegree_sub_eq_left_of_natDegree_lt h1, Polynomial.natDegree_X_pow]
    have hdeg' : p.degree ≠ 0 := by
      intro h0
      have h2 : p.natDegree = 0 := Polynomial.natDegree_eq_of_degree_eq_some h0
      omega
    obtain ⟨x, hx⟩ := IsSepClosed.exists_root p hdeg' hsep
    have hpow : x ^ Fintype.card k = x := FiniteField.pow_card x
    simp only [p, Polynomial.IsRoot, Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X,
      Polynomial.eval_one, hpow, sub_self, zero_sub, neg_eq_zero, one_ne_zero] at hx
  obtain ⟨π, hπfin, hπsurj⟩ := wc_xspl_oddq_proj_finite_surj k n (by omega) a0 R j hj hjr
  refine ⟨π, fun D hD => ?_⟩
  haveI := hπfin
  obtain ⟨hSi, hSn, hSq, hSln⟩ := wc_projK_integral_normal k (n - 1)
  haveI := hSi
  haveI := hSq
  haveI := hSln
  haveI : AlgebraicGeometry.IsIntegral R :=
    wc_xspl_oddq_R_integral k n (by omega) a0 ha R j hj hjr
  haveI : LocallyOfFinitePresentation π := inferInstance
  obtain ⟨r, hr⟩ := wc_finite_surj_unit_split_normal_base k (wcProjK k (n - 1))
    (wcProjKStr k (n - 1)) hSn R π hπsurj ℓ D hD
  have hex := wc_finite_lfp_pushforward_exact π ℓ D
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf (wcProjK k (n - 1)) ℓ)) := HasExt.standard _
  rw [injective_iff_map_eq_zero]
  intro x hx
  have h1 := wc_closed_supp_class_restriction_zero_of_exact π ℓ D hex 0 (2 * (n - 1))
    (2 * (n - 1)) (add_zero _) (Abelian.Ext.mk₀ r) x hx
  have h2 : wcSuppClass D 0 (Abelian.Ext.mk₀ r) = Abelian.Ext.mk₀ (𝟙 _) := by
    unfold wcSuppClass
    rw [Abelian.Ext.mk₀_comp_mk₀, hr]
  rw [h2] at h1
  simpa only [wcHMCup, Abelian.Ext.bilinearComp_apply_apply, Abelian.Ext.comp_mk₀_id] using h1

theorem wc_xspl_oddq_cup_nonzero (k : Type u) [Field k] [IsSepClosed k] (ℓ : ℕ)
    [Fact (Nat.Prime ℓ)]
    (hℓ : ((ℓ : ℕ) : k) ≠ 0) (n : ℕ) (hn : Even n) (hn4 : 4 ≤ n)
    (a0 : Fin n → Fin n → k) (ha : (Matrix.of a0 + (Matrix.of a0).transpose).det ≠ 0)
    (R : Scheme.{u}) [AlgebraicGeometry.IsReduced R] (j : R ⟶ wcProjK k n)
    (hj : IsClosedImmersion j) (hjr : Set.range j = wcXspVplus k n (wcXspExtCoeff a0)) :
    ∃ (x₀ : wcHM R ℓ (n - 2)) (y₀ : wcHM R ℓ 2),
      wcHMCup R ℓ (n - 2) 2 (n - 2 + 2) rfl x₀ y₀ ≠ 0 :=
by
  obtain ⟨a, b, c, habc⟩ := wc_xspl_projK_top_cup k ℓ hℓ n hn hn4
  obtain ⟨π, hπ⟩ := wc_xspl_oddq_proj_pull_inj k ℓ hℓ n hn hn4 a0 ha R j hj hjr
  obtain ⟨D, hD⟩ := wc_hm_pull_data_exists π ℓ
  refine ⟨wcHMPull D (n - 2) a, wcHMPull D 2 b, fun h0 => habc (hπ D hD ?_)⟩
  rw [map_zero, wc_hm_pull_cup D (n - 2 + 2) (n - 2) (2 * (n - 1)) _ _ c,
    wc_hm_pull_cup D (n - 2) 2 (n - 2 + 2) rfl a b, h0, map_zero, AddMonoidHom.zero_apply]

theorem wc_qmbt_xspl_exc_cup_h_inj {A : Type u} [CommRing A] [IsDomain A]
    [IsDiscreteValuationRing A]
    [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (hℓ : IsUnit ((ℓ : ℕ) : A)) {n : ℕ} (hn : Even n) (hn4 : 4 ≤ n) {π : A}
    {c : Matrix (Fin n) (Fin n) A}
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π}) (hc : IsUnit (c + c.transpose).det)
    {x₀ : Spec (.of (wcQuadModelRing A n π c))}
    (hx₀ : ∀ p, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
      PrimeSpectrum.asIdeal x₀)
    {B₀ : Type u} [CommRing B₀] [HenselianLocalRing B₀] [IsSepClosed (IsLocalRing.ResidueField B₀)]
    {Λ₀ : Type u} [SmallCategory Λ₀] [IsCofiltered Λ₀]
    {W₀ : Λ₀ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (wcQuadModelRing A n π c))) x₀))
      (Scheme.Etale.forget (Spec (.of (wcQuadModelRing A n π c))))}
    {φ₀ : ∀ l, Spec (.of B₀) ⟶ (W₀.obj l).right.left}
    {a₀ : Spec (.of B₀) ⟶ Spec (.of (wcQuadModelRing A n π c))}
    (hsh : wcHalShData x₀ B₀ Λ₀ W₀ φ₀ a₀)
    {Xs : Scheme.{u}} {ι : Xs ⟶ Spec (.of B₀)} {s : Xs ⟶ Spec (.of (IsLocalRing.ResidueField A))}
    (hps : IsPullback ι s (a₀ ≫ wcQuadModelStr A n π c) (wcQmSp A))
    {A' : Type u} [CommRing A'] [IsDomain A'] [IsDiscreteValuationRing A'] [HenselianLocalRing A']
    [IsSepClosed (IsLocalRing.ResidueField A')] {ιA : A →+* A'} {π' : A'}
    (hℓ' : IsUnit ((ℓ : ℕ) : A')) (hπ' : IsLocalRing.maximalIdeal A' = Ideal.span {π'})
    (hπ'2 : π' ^ 2 = ιA π) (hgen : ∀ a' : A', ∃ x y : A, a' = ιA x + ιA y * π')
    {L' : Type u} [Field L'] [IsSepClosed L'] {φ' : A' →+* L'} (hφ' : Function.Injective φ')
    (halg' : letI := φ'.toAlgebra; Algebra.IsAlgebraic A' L')
    {Xm : Scheme.{u}} {f : Xm ⟶ Spec (.of A')}
    {bl : Xm ⟶ Limits.pullback (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))}
    (hbl : wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range
      (fun i : Option (Fin n) => Option.elim i
        ((Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of A')).inv.hom π'))
        (fun j => ((Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))) ≫ a₀).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A n π c))).inv.hom
            (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X j)))))))) bl)
    (hblf : bl ≫ Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA)) = f)
    {XE' : Scheme.{u}} {p' : XE' ⟶ Xm} {q' : XE' ⟶ Spec (.of L')}
    (hpb' : IsPullback p' q' f (Spec.map (CommRingCat.ofHom φ')))
    {Xs' : Scheme.{u}} {ι' : Xs' ⟶ Xm} {s' : Xs' ⟶ Spec (.of (IsLocalRing.ResidueField A'))}
    (hps' : IsPullback ι' s' f (wcQmSp A'))
    {βs : Xs' ⟶ Xs}
    (hβ : βs ≫ ι = ι' ≫ bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA)))
    (Dβ : wcHMPullData βs ℓ) (hDβ : wcHMPullCanonical Dβ)
    [EnoughInjectives (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))]
    (Dp' : wcHMPullData p' ℓ) (hDp' : wcHMPullCanonical Dp')
    (Di' : wcHMPullData ι' ℓ) (hDi' : wcHMPullCanonical Di')
    (I' : InjectiveResolution (SheafOfModules.unit (wcRingSheaf XE' ℓ)))
    {Z₂ : Scheme.{u}} (i₂ : Z₂ ⟶ Xs') [IsClosedImmersion i₂]
    (h₂ : Set.range i₂ = (fun z => (ι' ≫ bl ≫ Limits.pullback.fst
      (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))) z) ⁻¹'
        {IsLocalRing.closedPoint B₀})
    (E₂ : wcHMPullData i₂ ℓ) (hE₂ : wcHMPullCanonical E₂) :
    letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))
    ∀ (w : (DerivedCategory.singleFunctor (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)) 1).obj
          (wcSuppObj E₂) ⟶
          (DerivedCategory.Q.obj ((HomologicalComplex.single
            (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)) (ComplexShape.up ℤ) 0).obj
              (wcSuppObj E₂)))⟦(1 : ℤ)⟧)
      (r : (DerivedCategory.singleFunctor (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))
          ((n : ℤ) - 1)).obj (SheafOfModules.unit (wcRingSheaf Xs' ℓ)) ⟶
          (DerivedCategory.singleFunctor (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)) 1).obj
            (wcSuppObj E₂)),
      w ≠ 0 → r ≫ w = 0 → r = 0 :=
by
  classical
  letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)) := HasExt.standard _
  intro w r hw hrw

  have s2 : ∀ {𝒮 : Type (u+2)} [Category.{u+1} 𝒮] [Abelian 𝒮] {_e1 : HasExt 𝒮}
      {𝒵 : Type (u+2)} [Category.{u+1} 𝒵] [Abelian 𝒵] {_e2 : HasExt 𝒵} [EnoughInjectives 𝒵]
      (L : 𝒮 ⥤ 𝒵) (R : 𝒵 ⥤ 𝒮) (adj : L ⊣ R) [R.Additive] [Limits.PreservesFiniteLimits R]
      [Limits.PreservesFiniteColimits R] [L.PreservesMonomorphisms] [R.Full] [R.Faithful]
      (ΛS : 𝒮) (ΛZ : 𝒵) (μ : L.obj ΛS ≅ ΛZ) (k : ℕ),
      (∀ (x : Abelian.Ext ΛZ ΛZ k) (y : Abelian.Ext ΛZ ΛZ 2), y ≠ 0 → x.comp y rfl = 0 → x = 0) →
      ∀ (a : Abelian.Ext ΛS (R.obj ΛZ) k) (b : Abelian.Ext (R.obj ΛZ) (R.obj ΛZ) 2),
        b ≠ 0 → a.comp b rfl = 0 → a = 0 := by
    intro 𝒮 _ _ _e1 𝒵 _ _ _e2 _ L R adj _ _ _ _ _ _ ΛS ΛZ μ k H a b hb hab
    let T : ∀ m : ℕ, Abelian.Ext ΛZ ΛZ m → Abelian.Ext ΛS (R.obj ΛZ) m := fun m x =>
      (Abelian.Ext.mk₀ (adj.unit.app ΛS ≫ R.map μ.hom)).comp (Abelian.Ext.mapExactFunctor R x)
        (zero_add m)
    have hT : ∀ m, Function.Bijective (T m) := by
      intro m
      have hA := wc_ext_adjoint_transfer L R adj ΛS ΛZ m
      have hM : Function.Bijective (fun x : Abelian.Ext ΛZ ΛZ m =>
          (Abelian.Ext.mk₀ μ.hom).comp x (zero_add m)) := by
        refine ⟨fun x y hxy => ?_, fun z => ⟨(Abelian.Ext.mk₀ μ.inv).comp z (zero_add m), ?_⟩⟩
        · have := congrArg (fun t => (Abelian.Ext.mk₀ μ.inv).comp t (zero_add m)) hxy
          simpa only [Abelian.Ext.mk₀_comp_mk₀_assoc, Iso.inv_hom_id, Abelian.Ext.mk₀_id_comp]
            using this
        · simp only [Abelian.Ext.mk₀_comp_mk₀_assoc, Iso.hom_inv_id, Abelian.Ext.mk₀_id_comp]
      have heq : T m = (fun e : Abelian.Ext (L.obj ΛS) ΛZ m =>
          (Abelian.Ext.mk₀ (adj.unit.app ΛS)).comp (Abelian.Ext.mapExactFunctor R e) (zero_add m)) ∘
          (fun x : Abelian.Ext ΛZ ΛZ m => (Abelian.Ext.mk₀ μ.hom).comp x (zero_add m)) := by
        funext x
        simp only [T, Function.comp_apply]
        rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
          ← Abelian.Ext.mk₀_comp_mk₀_assoc]
      rw [heq]
      exact hA.comp hM
    have hU : Function.Bijective (Abelian.Ext.mapExactFunctor R (X := ΛZ) (Y := ΛZ) (n := 2)) := by
      refine wc_ext_transfer_exact R ΛZ (fun Y => ⟨R.map_injective, R.map_surjective⟩) ?_ ΛZ 2
      intro I _ m e
      have : Injective (R.obj I) := Injective.injective_of_adjoint adj I
      exact Abelian.Ext.eq_zero_of_injective e
    obtain ⟨x, rfl⟩ := (hT k).2 a
    obtain ⟨y, rfl⟩ := hU.2 b
    have hy : y ≠ 0 := by
      rintro rfl
      exact hb (Abelian.Ext.mapExactFunctor_zero _ _ _ _)
    have hmul : (T k x).comp (Abelian.Ext.mapExactFunctor R y) rfl = T (k + 2) (x.comp y rfl) := by
      simp only [T]
      rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.comp_assoc]
      omega
    have hxy : x.comp y rfl = 0 := by
      apply (hT (k + 2)).1
      rw [← hmul, hab]
      simp only [T]
      rw [Abelian.Ext.mapExactFunctor_zero, Abelian.Ext.comp_zero]
    rw [H x y hy hxy]
    simp only [T]
    rw [Abelian.Ext.mapExactFunctor_zero, Abelian.Ext.comp_zero]

  have transport : ∀ {Y Y' : SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)} (φ : Y ≅ Y') (k : ℕ),
      (∀ (a : Abelian.Ext (SheafOfModules.unit (wcRingSheaf Xs' ℓ)) Y' k)
        (b : Abelian.Ext Y' Y' 2), b ≠ 0 → a.comp b rfl = 0 → a = 0) →
      ∀ (a : Abelian.Ext (SheafOfModules.unit (wcRingSheaf Xs' ℓ)) Y k) (b : Abelian.Ext Y Y 2),
        b ≠ 0 → a.comp b rfl = 0 → a = 0 := by
    intro Y Y' φ k H a b hb hab
    have hb' : ((Abelian.Ext.mk₀ φ.inv).comp b (zero_add 2)).comp (Abelian.Ext.mk₀ φ.hom)
        (add_zero 2) ≠ 0 := by
      intro h0
      apply hb
      have e : b = (Abelian.Ext.mk₀ φ.hom).comp ((((Abelian.Ext.mk₀ φ.inv).comp b (zero_add 2)).comp
          (Abelian.Ext.mk₀ φ.hom) (add_zero 2)).comp (Abelian.Ext.mk₀ φ.inv) (add_zero 2))
          (zero_add 2) := by
        rw [Abelian.Ext.comp_assoc_of_third_deg_zero ((Abelian.Ext.mk₀ φ.inv).comp b (zero_add 2))
            (Abelian.Ext.mk₀ φ.hom) (Abelian.Ext.mk₀ φ.inv), Abelian.Ext.mk₀_comp_mk₀, φ.hom_inv_id,
          Abelian.Ext.comp_mk₀_id, Abelian.Ext.mk₀_comp_mk₀_assoc, φ.hom_inv_id,
          Abelian.Ext.mk₀_id_comp]
      rw [e, h0, Abelian.Ext.zero_comp, Abelian.Ext.comp_zero]
    have h := H (a.comp (Abelian.Ext.mk₀ φ.hom) (add_zero _)) _ hb' (by
      rw [Abelian.Ext.comp_assoc_of_second_deg_zero,
        Abelian.Ext.comp_assoc_of_third_deg_zero (Abelian.Ext.mk₀ φ.inv) b (Abelian.Ext.mk₀ φ.hom),
        Abelian.Ext.mk₀_comp_mk₀_assoc, φ.hom_inv_id, Abelian.Ext.mk₀_id_comp,
        ← Abelian.Ext.comp_assoc_of_third_deg_zero, hab, Abelian.Ext.zero_comp])
    have e2 : a = (a.comp (Abelian.Ext.mk₀ φ.hom) (add_zero _)).comp (Abelian.Ext.mk₀ φ.inv)
        (add_zero _) := by
      rw [Abelian.Ext.comp_assoc_of_second_deg_zero, Abelian.Ext.mk₀_comp_mk₀, φ.hom_inv_id,
        Abelian.Ext.comp_mk₀_id]
    rw [e2, h, Abelian.Ext.zero_comp]

  have hF := IsPullback.of_hasPullback (ι' ≫ bl ≫ Limits.pullback.fst
    (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))) (wcQmSp B₀)
  obtain ⟨a0, R₀, hred, r₀, j₀, ha, hr₀, hr₀u, hj₀, -, hjr⟩ :=
    wc_qxs_exc_fibre_quadric hn hn4 hπ hc hx₀ hsh hπ' hπ'2 hgen hbl hblf hps' hF
  haveI := hred
  haveI := hr₀
  haveI : IsClosedImmersion (wcQmSp B₀) :=
    IsClosedImmersion.spec_of_surjective _ IsLocalRing.residue_surjective
  obtain ⟨i', hi'def⟩ : ∃ i' : R₀ ⟶ Xs', i' = r₀ ≫ Limits.pullback.fst (ι' ≫ bl ≫
      Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA)))
      (wcQmSp B₀) := ⟨_, rfl⟩
  haveI : IsClosedImmersion i' := by rw [hi'def]; infer_instance
  have hres : Set.range (wcQmSp B₀) = {IsLocalRing.closedPoint B₀} := by
    ext z
    simp only [Set.mem_range]
    constructor
    · rintro ⟨x, rfl⟩
      exact IsLocalRing.PrimeSpectrum.comap_residue _ x
    · rintro rfl
      exact ⟨IsLocalRing.closedPoint (IsLocalRing.ResidueField B₀),
        IsLocalRing.PrimeSpectrum.comap_residue _ _⟩
  have hsurjr : Set.range (r₀ ≫ Limits.pullback.fst (ι' ≫ bl ≫
      Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA)))
      (wcQmSp B₀)) = Set.range (Limits.pullback.fst (ι' ≫ bl ≫
      Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA)))
      (wcQmSp B₀)) := by
    ext z; constructor
    · rintro ⟨x, rfl⟩
      exact ⟨r₀ x, rfl⟩
    · rintro ⟨y, rfl⟩
      obtain ⟨x, rfl⟩ : y ∈ Set.range r₀ := by rw [hr₀u]; trivial
      exact ⟨x, rfl⟩
  have hrange : Set.range i₂ = Set.range i' := by
    rw [h₂, hi'def, hsurjr, Scheme.Pullback.range_fst, hres]
  obtain ⟨E', hE'⟩ := wc_hm_pull_data_exists i' ℓ
  obtain ⟨φ, -⟩ := wc_qmbt_xsp_supp_same_range_iso i₂ i' hrange E₂ hE₂ E' hE'
  haveI := wc_qmbt_pn_xsp_locNoeth hℓ hn hn4 hπ hc hx₀ hsh hps hℓ' hπ' hπ'2 hgen hφ' halg' hbl
    hblf hpb' hps' hβ Dβ hDβ Dp' hDp' Di' hDi' I'

  have hℓk : ((ℓ : ℕ) : IsLocalRing.ResidueField B₀) ≠ 0 := by
    have h1 := hℓ.map (Spec.preimage (a₀ ≫ wcQuadModelStr A n π c)).hom
    rw [map_natCast] at h1
    have h2 := h1.map (IsLocalRing.residue B₀)
    rw [map_natCast] at h2
    exact h2.ne_zero

  have Hcup : ∀ (x : wcHM R₀ ℓ (n - 2)) (y : wcHM R₀ ℓ 2), y ≠ 0 →
      wcHMCup R₀ ℓ (n - 2) 2 (n - 2 + 2) rfl x y = 0 → x = 0 := by
    obtain ⟨g, hg⟩ := wc_xspl_oddq_h2_line (IsLocalRing.ResidueField B₀) ℓ hℓk n hn hn4 a0 ha R₀
      j₀ hj₀ hjr
    obtain ⟨g', hg'⟩ := wc_xspl_oddq_mid_line (IsLocalRing.ResidueField B₀) ℓ hℓk n hn hn4 a0 ha
      R₀ j₀ hj₀ hjr
    obtain ⟨x₀, y₀, hxy₀⟩ := wc_xspl_oddq_cup_nonzero (IsLocalRing.ResidueField B₀) ℓ hℓk n hn
      hn4 a0 ha R₀ j₀ hj₀ hjr
    have sc0 : ∀ (m : ℕ) (z : wcHM R₀ ℓ m), wcHMScalar R₀ ℓ m 0 z = 0 := by
      intro m z
      have h := (wc_hmScalar_laws R₀ ℓ m).2.2.1 0 0 z
      rw [add_zero] at h
      exact add_left_cancel (h.symm.trans (add_zero _).symm)
    have hcomp : ∀ c d : ℚ_[ℓ], wcHMCup R₀ ℓ (n - 2) 2 (n - 2 + 2) rfl
        (wcHMScalar R₀ ℓ (n - 2) c g') (wcHMScalar R₀ ℓ 2 d g) =
        wcHMScalar R₀ ℓ (n - 2 + 2) d (wcHMScalar R₀ ℓ (n - 2 + 2) c
          (wcHMCup R₀ ℓ (n - 2) 2 (n - 2 + 2) rfl g' g)) := by
      intro c d
      rw [(wc_hm_cup_scalar R₀ ℓ (n - 2) 2 (n - 2 + 2) rfl d _ g).2,
        (wc_hm_cup_scalar R₀ ℓ (n - 2) 2 (n - 2 + 2) rfl c g' g).1]
    have hcancel : ∀ (c : ℚ_[ℓ]) (z : wcHM R₀ ℓ (n - 2 + 2)), c ≠ 0 →
        wcHMScalar R₀ ℓ (n - 2 + 2) c z = 0 → z = 0 := by
      intro c z hc hz
      have h := congrArg (wcHMScalar R₀ ℓ (n - 2 + 2) c⁻¹) hz
      rw [(wc_hmScalar_laws R₀ ℓ (n - 2 + 2)).1, mul_inv_cancel₀ hc,
        (wc_hmScalar_laws R₀ ℓ (n - 2 + 2)).2.1, map_zero] at h
      exact h
    have hG : wcHMCup R₀ ℓ (n - 2) 2 (n - 2 + 2) rfl g' g ≠ 0 := by
      intro h0
      apply hxy₀
      obtain ⟨c₀, rfl⟩ := hg' x₀
      obtain ⟨d₀, rfl⟩ := hg y₀
      rw [hcomp, h0, map_zero, map_zero]
    intro x y hy hxy
    obtain ⟨c, rfl⟩ := hg' x
    obtain ⟨d, rfl⟩ := hg y
    have hd : d ≠ 0 := by
      rintro rfl
      exact hy (sc0 2 g)
    by_contra hx
    have hc : c ≠ 0 := by
      rintro rfl
      exact hx (sc0 _ g')
    rw [hcomp] at hxy
    exact hG (hcancel c _ hc (hcancel d _ hd hxy))

  haveI := sheafOfModules_enoughInjectives (Scheme.ProEt.topology R₀) (wcRingSheaf R₀ ℓ)
  haveI := E'.additive
  haveI := E'.presLim
