      show ((ℓ • 𝟙 C).hom.app (Opposite.op O)).hom (ρ.ρ V O h hh x) = 0
      rw [hev, ← map_nsmul (ρ.ρ V O h hh) ℓ x, ← hev A V x, hA]
      simp)
