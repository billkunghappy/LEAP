theorem wc_qmbt_dlyt_semipurity_low {A : Type u} [CommRing A] [IsDomain A]
    [IsDiscreteValuationRing A]
    [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (hℓ : IsUnit ((ℓ : ℕ) : A)) {n : ℕ} (hn : Even n) (hn4 : 4 ≤ n) {π : A}
    {c : Matrix (Fin n) (Fin n) A}
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π}) (hc : IsUnit (c + c.transpose).det)
    {x₀ : Spec (.of (wcQuadModelRing A n π c))}
    (hx₀ : ∀ p, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
      PrimeSpectrum.asIdeal x₀)
    {B₀ : Type u} [CommRing B₀] [HenselianLocalRing B₀] [IsSepClosed (IsLocalRing.ResidueField B₀)]
    {Λ₀ : Type u} [SmallCategory Λ₀] [IsCofiltered Λ₀]
    {W₀ : Λ₀ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (wcQuadModelRing A n π c))) x₀))
      (Scheme.Etale.forget (Spec (.of (wcQuadModelRing A n π c))))}
    {φ₀ : ∀ l, Spec (.of B₀) ⟶ (W₀.obj l).right.left}
    {a₀ : Spec (.of B₀) ⟶ Spec (.of (wcQuadModelRing A n π c))}
    (hsh : wcHalShData x₀ B₀ Λ₀ W₀ φ₀ a₀)
    {Xs : Scheme.{u}} {ι : Xs ⟶ Spec (.of B₀)} {s : Xs ⟶ Spec (.of (IsLocalRing.ResidueField A))}
    (hps : IsPullback ι s (a₀ ≫ wcQuadModelStr A n π c) (wcQmSp A))
    {A' : Type u} [CommRing A'] [IsDomain A'] [IsDiscreteValuationRing A'] [HenselianLocalRing A']
    [IsSepClosed (IsLocalRing.ResidueField A')] {ιA : A →+* A'} {π' : A'}
    (hℓ' : IsUnit ((ℓ : ℕ) : A')) (hπ' : IsLocalRing.maximalIdeal A' = Ideal.span {π'})
    (hπ'2 : π' ^ 2 = ιA π) (hgen : ∀ a' : A', ∃ x y : A, a' = ιA x + ιA y * π')
    {L' : Type u} [Field L'] [IsSepClosed L'] {φ' : A' →+* L'} (hφ' : Function.Injective φ')
    (halg' : letI := φ'.toAlgebra; Algebra.IsAlgebraic A' L')
    {Xm : Scheme.{u}} {f : Xm ⟶ Spec (.of A')}
    {bl : Xm ⟶ Limits.pullback (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))}
    (hbl : wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range
      (fun i : Option (Fin n) => Option.elim i
        ((Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of A')).inv.hom π'))
        (fun j => ((Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))) ≫ a₀).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A n π c))).inv.hom
            (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X j)))))))) bl)
    (hblf : bl ≫ Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA)) = f)
    {XE' : Scheme.{u}} {p' : XE' ⟶ Xm} {q' : XE' ⟶ Spec (.of L')}
    (hpb' : IsPullback p' q' f (Spec.map (CommRingCat.ofHom φ')))
    {Xs' : Scheme.{u}} {ι' : Xs' ⟶ Xm} {s' : Xs' ⟶ Spec (.of (IsLocalRing.ResidueField A'))}
    (hps' : IsPullback ι' s' f (wcQmSp A'))
    {βs : Xs' ⟶ Xs}
    (hβ : βs ≫ ι = ι' ≫ bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA)))
    (Dβ : wcHMPullData βs ℓ) (hDβ : wcHMPullCanonical Dβ)
    [EnoughInjectives (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))]
    (Dp' : wcHMPullData p' ℓ) (hDp' : wcHMPullCanonical Dp')
    (Di' : wcHMPullData ι' ℓ) (hDi' : wcHMPullCanonical Di')
    (I' : InjectiveResolution (SheafOfModules.unit (wcRingSheaf XE' ℓ)))
    {Z₁ Z₂ ZY : Scheme.{u}} (i₁ : Z₁ ⟶ Xs') (i₂ : Z₂ ⟶ Xs') (iY : ZY ⟶ Xs')
    [IsClosedImmersion i₁] [IsClosedImmersion i₂] [IsClosedImmersion iY]
    (h₁ : Set.range i₁ = closure ((fun z => (ι' ≫ bl ≫ Limits.pullback.fst
      (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))) z) ⁻¹'
        {IsLocalRing.closedPoint B₀})ᶜ)
    (h₂ : Set.range i₂ = (fun z => (ι' ≫ bl ≫ Limits.pullback.fst
      (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))) z) ⁻¹'
        {IsLocalRing.closedPoint B₀})
    (hY : Set.range iY = closure ((fun z => (ι' ≫ bl ≫ Limits.pullback.fst
      (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))) z) ⁻¹'
        {IsLocalRing.closedPoint B₀})ᶜ ∩ (fun z => (ι' ≫ bl ≫ Limits.pullback.fst
      (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))) z) ⁻¹'
        {IsLocalRing.closedPoint B₀})
    (E₁ : wcHMPullData i₁ ℓ) (hE₁ : wcHMPullCanonical E₁)
    (E₂ : wcHMPullData i₂ ℓ) (hE₂ : wcHMPullCanonical E₂)
    (EY : wcHMPullData iY ℓ) (hEY : wcHMPullCanonical EY)
    (ρ₁ : wcSuppObj E₁ ⟶ wcSuppObj EY) (ρ₂ : wcSuppObj E₂ ⟶ wcSuppObj EY)
    (hz : Limits.biprod.lift (wcSuppUnitMap E₁) (wcSuppUnitMap E₂) ≫
      Limits.biprod.desc ρ₁ (-ρ₂) = 0)
    (hS : (ShortComplex.mk _ _ hz).ShortExact)
    {Y' : Scheme.{u}} (iY' : Y' ⟶ Z₁) [IsClosedImmersion iY'] (gY : Y' ⟶ ZY)
    (hYsq : IsPullback gY iY' iY i₁) :
    ∀ (O : Z₁.Opens) (EO : wcHMPullData (Limits.pullback.fst O.ι iY') ℓ),
      wcHMPullCanonical EO → ∀ (q : ℕ), q ≤ 1 → ∀ x : wcSuppExt EO q, x = 0 :=
by
  classical
  intro O EO hEO q hq x
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf O.toScheme ℓ)) := HasExt.standard _



  have s1 : ∀ {C E : Type (u+2)} [Category.{u+1} C] [Category.{u+1} E] [Abelian C] [Abelian E]
      [EnoughInjectives E] (Φ : C ⥤ E) (G : E ⥤ C) [Φ.Additive] [Limits.PreservesFiniteLimits Φ]
      (adj : Φ ⊣ G) (M : C) (_hM : Limits.IsZero (Φ.obj M)) (N : E),
      letI := HasExt.standard C
      ∀ q : ℕ, q ≤ 1 → ∀ x : Abelian.Ext M (G.obj N) q, x = 0 := by
    intro C E _ _ _ _ _ Φ G _ _ adj M hM N
    letI := HasExt.standard C
    haveI : G.Additive := adj.right_adjoint_additive
    have hom0 : ∀ (Y : E) (f : M ⟶ G.obj Y), f = 0 := by
      intro Y f
      have h1 : (adj.homEquiv M Y).symm f = 0 := hM.eq_of_src _ _
      rw [← (adj.homEquiv M Y).apply_symm_apply f, h1, Adjunction.homEquiv_unit, Functor.map_zero,
        Limits.comp_zero]
    intro q hq x
    rcases (by omega : q = 0 ∨ q = 1) with rfl | rfl
    · obtain ⟨f, rfl⟩ := (Abelian.Ext.mk₀_bijective M (G.obj N)).2 x
      rw [hom0 N f, Abelian.Ext.mk₀_zero]
    · haveI : G.IsRightAdjoint := ⟨_, ⟨adj⟩⟩
      haveI : Limits.PreservesLimitsOfSize.{0, 0} G := adj.rightAdjoint_preservesLimits
      haveI : Injective (G.obj (Injective.under N)) := Injective.injective_of_adjoint adj _
      haveI : Mono (G.map (Injective.ι N)) := inferInstance
      let S := ShortComplex.mk (G.map (Injective.ι N)) (Limits.cokernel.π (G.map (Injective.ι N)))
        (Limits.cokernel.condition _)
      have hS : S.ShortExact :=
        ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel (G.map (Injective.ι N)))
          inferInstance inferInstance
      have h0 : x.comp (Abelian.Ext.mk₀ S.f) (add_zero 1) = 0 :=
        Abelian.Ext.eq_zero_of_injective (n := 0) _
      obtain ⟨x₃, hx₃⟩ := Abelian.Ext.covariant_sequence_exact₁ M hS x h0 (zero_add 1)
      obtain ⟨h, rfl⟩ := (Abelian.Ext.mk₀_bijective _ _).2 x₃
      let T := ShortComplex.mk (Injective.ι N) (Limits.cokernel.π (Injective.ι N))
        (Limits.cokernel.condition _)
      have hT : T.Exact := ShortComplex.exact_cokernel (Injective.ι N)
      have hT' : (T.map G).Exact := hT.map_of_mono_of_preservesKernel G inferInstance inferInstance
      haveI hκ := hT'.mono_cokernelDesc
      have hh : h ≫ Limits.cokernel.desc (T.map G).f (T.map G).g (T.map G).zero = 0 := hom0 _ _
      have h00 : h = 0 := Limits.zero_of_comp_mono _ hh
      rw [← hx₃, h00, Abelian.Ext.mk₀_zero, Abelian.Ext.zero_comp]



  have hclP : ∀ (R : Type u) [CommRing R] (S' : Set (PrimeSpectrum R)), IsCompact S' →
      IsOpen S' → ∀ y' ∈ closure S', ∃ x' ∈ S', x' ⤳ y' := by
    intro R _ S' hc ho y' hy'
    obtain ⟨t, ht⟩ := PrimeSpectrum.isCompact_isOpen_iff.mp ⟨hc, ho⟩
    have hU : S' = ⋃ a ∈ t, (PrimeSpectrum.basicOpen a : Set (PrimeSpectrum R)) := by
      rw [← ht]
      ext p
      simp only [Set.mem_compl_iff, PrimeSpectrum.mem_zeroLocus, Set.not_subset,
        Set.mem_iUnion, SetLike.mem_coe, PrimeSpectrum.mem_basicOpen, exists_prop]
    rw [hU, Finset.closure_biUnion] at hy'
    obtain ⟨a, hat, hya⟩ := Set.mem_iUnion₂.mp hy'
    by_cases h0 : (0 : R) ∈ y'.asIdeal.primeCompl ⊔ Submonoid.powers a
    · exfalso
      obtain ⟨s, hs, w, hw, hsw⟩ := Submonoid.mem_sup.mp h0
      obtain ⟨n, rfl⟩ := (Submonoid.mem_powers_iff _ _).mp hw
      rw [mem_closure_iff] at hya
      have hs' : y' ∈ (PrimeSpectrum.basicOpen s : Set (PrimeSpectrum R)) := by
        rw [SetLike.mem_coe, PrimeSpectrum.mem_basicOpen]
        exact Ideal.mem_primeCompl_iff.mp hs
      obtain ⟨q, hqs, hqa⟩ := hya _ (PrimeSpectrum.basicOpen s).isOpen hs'
      rw [SetLike.mem_coe, PrimeSpectrum.mem_basicOpen] at hqs hqa
      have hmem : s * a ^ n ∈ q.asIdeal := by rw [hsw]; exact q.asIdeal.zero_mem
      rcases q.isPrime.mem_or_mem hmem with h | h
      · exact hqs h
      · exact hqa (q.isPrime.mem_of_pow_mem n h)
    · obtain ⟨p, hp, -, hdisj⟩ := Ideal.exists_le_prime_disjoint (⊥ : Ideal R)
        (y'.asIdeal.primeCompl ⊔ Submonoid.powers a) (by
          rw [Set.disjoint_left]
          intro r hr hrM
          rw [SetLike.mem_coe, Ideal.mem_bot] at hr
          subst hr
          exact h0 hrM)
      rw [hU]
      refine ⟨⟨p, hp⟩, Set.mem_iUnion₂.mpr ⟨a, hat, ?_⟩, ?_⟩
      · rw [SetLike.mem_coe, PrimeSpectrum.mem_basicOpen]
        intro hap
        exact Set.disjoint_left.mp hdisj hap (Submonoid.mem_sup_right (Submonoid.mem_powers a))
      · rw [← PrimeSpectrum.le_iff_specializes]
        intro r hr
        by_contra hry
        exact Set.disjoint_left.mp hdisj hr
          (Submonoid.mem_sup_left (Ideal.mem_primeCompl_iff.mpr hry))
  have c4 : ∀ (T : Scheme.{u}) [IsAffine T],
      (∀ z : T, IsClosed ({z} : Set T) → ∃ e : T, ∀ y : T, y ⤳ z → e ⤳ y) →
      ∀ (O : Set T), IsOpen O → IsCompact O →
      (∀ z : T, IsClosed ({z} : Set T) → ∃ x ∈ O, x ⤳ z) →
      ∀ (f : C(O, ULift.{u+1} ℚ_[ℓ])), ∃ g : C(T, ULift.{u+1} ℚ_[ℓ]), ∀ x : O, g x = f x := by
    intro T _ hirr O hOo hOc hgen0 f
    have hcl : ∀ S : Set T, IsCompact S → IsOpen S → ∀ y ∈ closure S, ∃ x ∈ S, x ⤳ y := by
      intro S hSc hSo y hy
      let e : T ≃ₜ PrimeSpectrum Γ(T, ⊤) := Scheme.homeoOfIso T.isoSpec
      obtain ⟨x', hx', hxy⟩ := hclP Γ(T, ⊤) (e '' S) (hSc.image e.continuous)
        (e.isOpenMap S hSo) (e y) (by rw [← e.image_closure]; exact Set.mem_image_of_mem e hy)
      obtain ⟨x, hx, rfl⟩ := hx'
      exact ⟨x, hx, e.isInducing.specializes_iff.mp hxy⟩
    have hT : ∀ W : Set (ULift.{u+1} ℚ_[ℓ]), IsOpen W → ∀ t ∈ W,
        ∃ B : Set (ULift.{u+1} ℚ_[ℓ]), IsClopen B ∧ t ∈ B ∧ B ⊆ W := by
      intro W hW t ht
      let h : ULift.{u+1} ℚ_[ℓ] ≃ₜ ℚ_[ℓ] := Homeomorph.ulift
      obtain ⟨ε, hε, hball⟩ := Metric.isOpen_iff.mp (h.isOpenMap W hW) (h t)
        (Set.mem_image_of_mem h ht)
      refine ⟨h ⁻¹' Metric.ball (h t) ε,
        IsClopen.preimage ⟨IsUltrametricDist.isClosed_ball _ _, Metric.isOpen_ball⟩ h.continuous,
        Metric.mem_ball_self hε, ?_⟩
      intro b hb
      obtain ⟨w, hw, hwb⟩ := hball hb
      rw [h.injective hwb] at hw
      exact hw
    have hcs : ∀ x : T, ∃ y : T, IsClosed ({y} : Set T) ∧ x ⤳ y := by
      intro x
      obtain ⟨y, hy, hyc⟩ := (isClosed_closure (s := ({x} : Set T))).exists_closed_singleton
        ⟨x, subset_closure rfl⟩
      exact ⟨y, hyc, specializes_iff_mem_closure.mpr hy⟩
    choose cc hcc using hcs
    choose η hη using hirr
    let e : T → T := fun x => η (cc x) (hcc x).1
    have he2 : ∀ x x', x' ⤳ x → e x ⤳ x' := fun x x' hx' =>
      hη (cc x) (hcc x).1 x' (hx'.trans (hcc x).2)
    have he1 : ∀ x, e x ∈ O := by
      intro x
      obtain ⟨w, hwO, hwz⟩ := hgen0 (cc x) (hcc x).1
      exact (hη _ _ w hwz).mem_open hOo hwO
    have he0 : ∀ x, e x ⤳ x := fun x => he2 x x specializes_rfl
    let G : T → ULift.{u+1} ℚ_[ℓ] := fun x => f ⟨e x, he1 x⟩
    have hext : ∀ x : O, G x.1 = f x := by
      intro x
      have h1 : (⟨e x.1, he1 x.1⟩ : O) ⤳ x :=
        Topology.IsInducing.subtypeVal.specializes_iff.mp (he0 x.1)
      exact (h1.map f.continuous).eq
    have hpre : ∀ B : Set (ULift.{u+1} ℚ_[ℓ]), IsClopen B → IsOpen (G ⁻¹' B) := by
      intro B hB
      have hAc : IsClopen (f ⁻¹' Bᶜ) := hB.compl.preimage f.continuous
      have hSo : IsOpen (Subtype.val '' (f ⁻¹' Bᶜ) : Set T) :=
        hOo.isOpenMap_subtype_val _ hAc.isOpen
      haveI : CompactSpace O := isCompact_iff_compactSpace.mp hOc
      have hSc : IsCompact (Subtype.val '' (f ⁻¹' Bᶜ) : Set T) :=
        hAc.isClosed.isCompact.image continuous_subtype_val
      have hmem : ∀ x, e x ∈ (Subtype.val '' (f ⁻¹' Bᶜ) : Set T) ↔ G x ∉ B := by
        intro x
        constructor
        · rintro ⟨a, ha, hae⟩
          have : a = ⟨e x, he1 x⟩ := Subtype.ext hae
          subst this
          exact ha
        · intro h
          exact ⟨⟨e x, he1 x⟩, h, rfl⟩
      have hS : G ⁻¹' B = (closure (Subtype.val '' (f ⁻¹' Bᶜ) : Set T))ᶜ := by
        ext x
        simp only [Set.mem_preimage, Set.mem_compl_iff]
        constructor
        · intro hGx hxS
          obtain ⟨x', hx'S, hx'x⟩ := hcl _ hSc hSo x hxS
          exact (hmem x).mp ((he2 x x' hx'x).mem_open hSo hx'S) hGx
        · intro hxS
          by_contra hGx
          exact hxS (closure_mono (Set.singleton_subset_iff.mpr ((hmem x).mpr hGx))
            (specializes_iff_mem_closure.mp (he0 x)))
      rw [hS]
      exact isClosed_closure.isOpen_compl
    have hGc : Continuous G := by
      rw [continuous_def]
      intro W hW
      rw [isOpen_iff_forall_mem_open]
      intro x hx
      obtain ⟨B, hB, hxB, hBW⟩ := hT W hW (G x) hx
      exact ⟨G ⁻¹' B, Set.preimage_mono hBW, hpre B hB, hxB⟩
    exact ⟨⟨G, hGc⟩, hext⟩



  have s4core : ∀ (Vt : Scheme.{u}) (vh : Vt ⟶ Xs') [IsAffine Vt],
      (∀ x : Vt, IsClosed ({x} : Set Vt) →
        x ∈ Set.range (Limits.pullback.fst vh (O.ι ≫ i₁))) →
      IsIso (Limits.pullback.lift (Limits.pullback.fst vh (O.ι ≫ i₁))
        (Limits.pullback.snd vh (O.ι ≫ i₁) ≫ O.ι)
        (by rw [Limits.pullback.condition, Category.assoc]) :
          Limits.pullback vh (O.ι ≫ i₁) ⟶ Limits.pullback vh i₁) := by
    intro Vt vh _ hcl
    set m := (Limits.pullback.lift (Limits.pullback.fst vh (O.ι ≫ i₁))
        (Limits.pullback.snd vh (O.ι ≫ i₁) ≫ O.ι)
        (by rw [Limits.pullback.condition, Category.assoc]) :
          Limits.pullback vh (O.ι ≫ i₁) ⟶ Limits.pullback vh i₁) with hm
    have hm1 : m ≫ Limits.pullback.fst vh i₁ = Limits.pullback.fst vh (O.ι ≫ i₁) :=
      Limits.pullback.lift_fst _ _ _
    have hm2 : m ≫ Limits.pullback.snd vh i₁ = Limits.pullback.snd vh (O.ι ≫ i₁) ≫ O.ι :=
      Limits.pullback.lift_snd _ _ _
    have hbig : IsPullback (m ≫ Limits.pullback.fst vh i₁) (Limits.pullback.snd vh (O.ι ≫ i₁))
        vh (O.ι ≫ i₁) := by
      rw [hm1]; exact IsPullback.of_hasPullback vh (O.ι ≫ i₁)
    have hsq : IsPullback m (Limits.pullback.snd vh (O.ι ≫ i₁)) (Limits.pullback.snd vh i₁) O.ι :=
      IsPullback.of_right hbig hm2 (IsPullback.of_hasPullback vh i₁)
    haveI hoi : IsOpenImmersion m :=
      MorphismProperty.of_isPullback (P := @IsOpenImmersion) hsq.flip inferInstance
    haveI : IsAffine (Limits.pullback vh i₁) :=
      isAffine_of_isAffineHom (Limits.pullback.fst vh i₁)
    have hsurj : Function.Surjective m := by
      intro p
      obtain ⟨c, hc, hcc⟩ :=
        (isClosed_closure (s := ({p} : Set ↥(Limits.pullback vh i₁)))).exists_closed_singleton
          ⟨p, subset_closure rfl⟩
      have hpc : p ⤳ c := specializes_iff_mem_closure.mpr hc
      have hfc : IsClosed ({Limits.pullback.fst vh i₁ c} : Set Vt) := by
        have := (Limits.pullback.fst vh i₁).isClosedEmbedding.isClosedMap _ hcc
        rwa [Set.image_singleton] at this
      obtain ⟨w, hw⟩ := hcl _ hfc
      have hmw : m w = c := by
        apply (Limits.pullback.fst vh i₁).isClosedEmbedding.injective
        rw [← hw, ← Scheme.Hom.comp_apply, hm1]
      have hcr : c ∈ Set.range m := ⟨w, hmw⟩
      exact hpc.mem_open m.isOpenEmbedding.isOpen_range hcr
