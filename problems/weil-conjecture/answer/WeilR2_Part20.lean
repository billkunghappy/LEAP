by
  letI := HasDerivedCategory.standard C
  letI : HasExt C := HasExt.standard C
  intro hH τ hτ a
  have hinj : ∀ (p q k : ℤ) (hk : q + k = p) (X Y : C),
      Function.Injective (wcDSingleTransport (C := C) p q k hk (X := X) (Y := Y)) := by
    intro p q k hk X Y f g h
    dsimp only [wcDSingleTransport] at h
    rw [cancel_epi] at h
    simp only [← Category.assoc, cancel_mono] at h
    exact (shiftFunctor (DerivedCategory C) p).map_injective h
  have hsurj : ∀ (p q k : ℤ) (hk : q + k = p) (X Y : C),
      Function.Surjective (wcDSingleTransport (C := C) p q k hk (X := X) (Y := Y)) := by
    intro p q k hk X Y y
    refine ⟨(shiftFunctor (DerivedCategory C) p).preimage
      ((((DerivedCategory.singleFunctors C).shiftIso p 0 p (add_zero p)).app X).hom ≫ y ≫
        inv ((shiftFunctor (DerivedCategory C) k).map
          (((DerivedCategory.singleFunctors C).shiftIso q 0 q (add_zero q)).app Y).hom) ≫
        inv ((shiftFunctorAdd' (DerivedCategory C) q k p hk).hom.app
          ((DerivedCategory.singleFunctor C q).obj Y))), ?_⟩
    dsimp only [wcDSingleTransport]
    simp only [Functor.map_preimage, Category.assoc, IsIso.inv_hom_id_assoc, IsIso.inv_hom_id,
      Category.comp_id, Iso.inv_hom_id_assoc]
  have hzero : ∀ (p q k : ℤ) (hk : q + k = p) (X Y : C),
      wcDSingleTransport (C := C) p q k hk (X := X) (Y := Y) 0 = 0 := by
    intro p q k hk X Y
    simp [wcDSingleTransport]
  have hcomp : ∀ (p q r k j c : ℤ) (hk : q + k = p) (hj : r + j = q) (hc : r + c = p)
      (hjkc : j + k = c) (X Y Z : C)
      (f : (DerivedCategory.singleFunctor C p).obj X ⟶ (DerivedCategory.singleFunctor C q).obj Y)
      (g : (DerivedCategory.singleFunctor C q).obj Y ⟶ (DerivedCategory.singleFunctor C r).obj Z),
      wcDSingleTransport (C := C) p r c hc (f ≫ g) =
        (wcDSingleTransport (C := C) p q k hk f).comp
          (wcDSingleTransport (C := C) q r j hj g) hjkc := by
    intro p q r k j c hk hj hc hjkc X Y Z f g
    have h1 := ((shiftFunctorAdd' (DerivedCategory C) q k p hk).hom.naturality g).symm
    have h2 := (shiftFunctorAdd' (DerivedCategory C) j k c hjkc).inv.naturality
      (((DerivedCategory.singleFunctors C).shiftIso r 0 r (add_zero r)).app Z).hom
    have h3 := shiftFunctorAdd'_assoc_hom_app (C := DerivedCategory C) r j k q c p hj hjkc
