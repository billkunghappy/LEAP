theorem wc_ysi_ker_supp_ext_vanish {S Z₂ ZY : Scheme.{u}} (i₂ : Z₂ ⟶ S) (iY : ZY ⟶ S)
    [IsClosedImmersion i₂] [IsClosedImmersion iY] [IsLocallyNoetherian S]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hsub : Set.range iY ⊆ Set.range i₂)
    (E₂ : wcHMPullData i₂ ℓ) (hE₂ : wcHMPullCanonical E₂)
    (EY : wcHMPullData iY ℓ) (hEY : wcHMPullCanonical EY) :
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
    ∀ (q : ℕ) (x : Abelian.Ext (Limits.kernel (wcSuppUnitMap E₂)) (wcSuppObj EY) q), x = 0 :=
by
  intro q x
  have hC₂ : IsClosed (Set.range i₂) := i₂.isClosedEmbedding.isClosed_range
  have hCY : IsClosed (Set.range iY) := iY.isClosedEmbedding.isClosed_range
  let Wo : S.Opens := ⟨(Set.range i₂)ᶜ, hC₂.isOpen_compl⟩
  let V : S.Opens := ⟨(Set.range iY)ᶜ, hCY.isOpen_compl⟩
  have hle : Wo ≤ V := by
    intro z hz
    exact Set.compl_subset_compl.mpr hsub hz
  obtain ⟨Dw, hDw⟩ := wc_hm_pull_data_exists Wo.ι ℓ
  obtain ⟨DV, hDV⟩ := wc_hm_pull_data_exists V.ι ℓ
  obtain ⟨Dκ, hDκ⟩ := wc_hm_pull_data_exists (S.homOfLE hle) ℓ
  have hZV : Limits.IsZero (DV.Φ.obj (wcSuppObj EY)) :=
    wc_proet_open_pull_closed_push_isZero iY ℓ V rfl EY DV hDV
      (SheafOfModules.unit (wcRingSheaf ZY ℓ))
  obtain ⟨φ⟩ := wc_hm_pull_data_comp_Phi_iso V.ι (S.homOfLE hle) Wo.ι
    (Scheme.homOfLE_ι S hle) DV hDV Dκ hDκ Dw hDw
  haveI := Dκ.additive
  have hZκ : Limits.IsZero (Dκ.Φ.obj (DV.Φ.obj (wcSuppObj EY))) := Functor.map_isZero Dκ.Φ hZV
  have hZw : Limits.IsZero (Dw.Φ.obj (wcSuppObj EY)) := hZκ.of_iso (φ.app (wcSuppObj EY))
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf Wo.toScheme ℓ)) := HasExt.standard _
  have s9 : ∀ z : Abelian.Ext (SheafOfModules.unit (wcRingSheaf Wo.toScheme ℓ))
      (Dw.Φ.obj (wcSuppObj EY)) q, z = 0 := by
    intro z
    rw [← Abelian.Ext.comp_mk₀_id z,
      show 𝟙 (Dw.Φ.obj (wcSuppObj EY)) = 0 from hZw.eq_of_tgt _ _,
      Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
  exact wc_qmbt_xspl_supp_ker_ext_vanish (j := i₂) E₂ hE₂ Wo rfl Dw hDw (wcSuppObj EY) q s9 x

theorem wc_ysi_closed_ext_hm_transfer {S Z : Scheme.{u}} (i : Z ⟶ S) [IsClosedImmersion i]
    [IsLocallyNoetherian S] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (D : wcHMPullData i ℓ) (hD : wcHMPullCanonical D) (k : ℕ) :
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
    ∃ Ψ : wcHM Z ℓ k →+ Abelian.Ext (SheafOfModules.unit (wcRingSheaf S ℓ)) (wcSuppObj D) k,
      Function.Bijective Ψ ∧ ∀ (c : ℚ_[ℓ]) (z : wcHM Z ℓ k),
        Ψ (wcHMScalar Z ℓ k c z) = (Abelian.Ext.mk₀ (wcHMConst S ℓ c)).comp (Ψ z) (zero_add k) :=
by
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf Z ℓ)) := HasExt.standard _
  haveI := D.additive
  haveI := D.presLim
  haveI := D.presColim
  haveI : (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC i) _ _ D.cont D.φ).Additive :=
    D.adj.right_adjoint_additive
  haveI := D.adj.rightAdjoint_preservesLimits
  haveI : Limits.PreservesFiniteLimits
      (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC i) _ _ D.cont D.φ) := inferInstance
  haveI : Limits.PreservesFiniteColimits
      (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC i) _ _ D.cont D.φ) :=
    wc_closed_pushforward_exact_of_noetherian i ℓ D
  haveI : D.Φ.PreservesMonomorphisms := inferInstance
  haveI : EnoughInjectives (SheafOfModules.{u+1} (wcRingSheaf Z ℓ)) :=
    sheafOfModules_enoughInjectives (Scheme.ProEt.topology Z) (wcRingSheaf Z ℓ)
  set R := (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC i) _ _ D.cont D.φ) with hR
  set ΛS := SheafOfModules.unit (wcRingSheaf S ℓ) with hΛS
  set ΛZ := SheafOfModules.unit (wcRingSheaf Z ℓ) with hΛZ
  let M : Abelian.Ext ΛZ ΛZ k →+ Abelian.Ext (D.Φ.obj ΛS) ΛZ k :=
    (Abelian.Ext.mk₀ D.μ.hom).precomp ΛZ (zero_add k)
  let T : Abelian.Ext (D.Φ.obj ΛS) ΛZ k →+ Abelian.Ext ΛS (R.obj ΛZ) k :=
    ((Abelian.Ext.mk₀ (D.adj.unit.app ΛS)).precomp (R.obj ΛZ) (zero_add k)).comp
      (R.mapExtAddHom (D.Φ.obj ΛS) ΛZ k)
  have hMapp : ∀ z, M z = (Abelian.Ext.mk₀ D.μ.hom).comp z (zero_add k) := fun z => rfl
  have hTapp : ∀ w, T w = (Abelian.Ext.mk₀ (D.adj.unit.app ΛS)).comp
      (Abelian.Ext.mapExactFunctor R w) (zero_add k) := fun w => rfl
  have hT : Function.Bijective T := by
    have := wc_ext_adjoint_transfer D.Φ R D.adj ΛS ΛZ k
    exact this
  have hM : Function.Bijective M := by
    refine Function.bijective_iff_has_inverse.mpr
      ⟨fun w => (Abelian.Ext.mk₀ D.μ.inv).comp w (zero_add k), ?_, ?_⟩
    · intro z
      simp only [hMapp]
      rw [Abelian.Ext.mk₀_comp_mk₀_assoc, Iso.inv_hom_id, Abelian.Ext.mk₀_id_comp]
    · intro w
      simp only [hMapp]
      rw [Abelian.Ext.mk₀_comp_mk₀_assoc, Iso.hom_inv_id, Abelian.Ext.mk₀_id_comp]
  let Ψ : wcHM Z ℓ k →+ Abelian.Ext (SheafOfModules.unit (wcRingSheaf S ℓ)) (wcSuppObj D) k :=
    T.comp M
  have hΨ : ∀ z, Ψ z = T (M z) := fun z => rfl
  refine ⟨Ψ, ?_, ?_⟩
  · exact hT.comp hM
  · intro c z
    have hkey : D.μ.hom ≫ wcHMConst Z ℓ c = D.Φ.map (wcHMConst S ℓ c) ≫ D.μ.hom := by
      rw [← wc_hm_pull_const D hD c, Iso.hom_inv_id_assoc]
    have hsc : wcHMScalar Z ℓ k c z = (Abelian.Ext.mk₀ (wcHMConst Z ℓ c)).comp z (zero_add k) := by
      rw [wc_hm_unit_end_central Z ℓ (wcHMConst Z ℓ c) k z]
      rfl
    have hM' : M ((Abelian.Ext.mk₀ (wcHMConst Z ℓ c)).comp z (zero_add k)) =
        (Abelian.Ext.mk₀ (D.Φ.map (wcHMConst S ℓ c))).comp (M z) (zero_add k) := by
      rw [hMapp, hMapp, Abelian.Ext.mk₀_comp_mk₀_assoc, Abelian.Ext.mk₀_comp_mk₀_assoc, hkey]
    have hnat : D.adj.unit.app ΛS ≫ R.map (D.Φ.map (wcHMConst S ℓ c)) =
        wcHMConst S ℓ c ≫ D.adj.unit.app ΛS := D.adj.unit_naturality _
    have hT' : ∀ w, T ((Abelian.Ext.mk₀ (D.Φ.map (wcHMConst S ℓ c))).comp w (zero_add k)) =
        (Abelian.Ext.mk₀ (wcHMConst S ℓ c)).comp (T w) (zero_add k) := by
      intro w
      rw [hTapp, hTapp, Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
        Abelian.Ext.mk₀_comp_mk₀_assoc, Abelian.Ext.mk₀_comp_mk₀_assoc, hnat]
    rw [hΨ, hΨ, hsc, hM', hT']
    rfl

theorem wc_ysi_split_quadric_range (Ω : Type u) [Field Ω] (d : ℕ) (hd : Even d) (hd2 : 2 ≤ d)
    (Y : Scheme.{u}) (fY : Y ⟶ Spec (.of Ω)) [IsProper fY] [SmoothOfRelativeDimension d fY]
    [Nonempty Y] (jY : Y ⟶ wcProjK Ω (d + 1)) (hjY : IsClosedImmersion jY)
    (hjf : jY ≫ wcProjKStr Ω (d + 1) = fY)
    (hEG : ∀ (x : Y) (c : Fin (d + 1 + 1)) (hx : x ∈ jY ⁻¹ᵁ wcSgD Ω (d + 1) c),
      wcLdpGerm Ω (d + 1) jY (wcLdpQuad Ω (d + 1) (fun p q : Fin (d + 1 + 1) =>
        if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : Ω) else 0)) c x hx ∈
        IsLocalRing.maximalIdeal (Y.presheaf.stalk x)) :
    Set.range jY = {p | p ∉ @Proj.basicOpen _ _ _ _ _
      (MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) Ω) MvPolynomial.gradedAlgebra
      (wcLdpQuad Ω (d + 1) (fun p q : Fin (d + 1 + 1) =>
        if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : Ω) else 0) :
        MvPolynomial (Fin (d + 1 + 1)) Ω)} :=
by
  classical
  obtain ⟨t, ht⟩ := hd
  have hdet : (Matrix.of (fun p q : Fin (d + 1 + 1) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : Ω) else 0) +
      (Matrix.of (fun p q : Fin (d + 1 + 1) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : Ω) else 0)).transpose).det ≠ 0 := by
    let f : Fin (d + 1 + 1) → Fin (d + 1 + 1) := fun p =>
      ⟨if p.val % 2 = 0 then p.val + 1 else p.val - 1, by split_ifs <;> omega⟩
    have hf : Function.Involutive f := by
      intro p
      apply Fin.ext
      simp only [f]
      split_ifs <;> omega
    have hS : Matrix.of (fun p q : Fin (d + 1 + 1) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : Ω) else 0) +
        (Matrix.of (fun p q : Fin (d + 1 + 1) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : Ω) else 0)).transpose =
        Equiv.Perm.permMatrix Ω (Function.Involutive.toPerm f hf) := by
      ext p q
      simp only [Matrix.add_apply, Matrix.of_apply, Matrix.transpose_apply, Equiv.Perm.permMatrix,
        PEquiv.toMatrix_apply, Equiv.toPEquiv_apply, Option.mem_def, Option.some.injEq,
        Function.Involutive.coe_toPerm, f, Fin.ext_iff]
      split_ifs <;> first | omega | norm_num
    rw [hS, Matrix.det_permutation]
    rcases Int.units_eq_one_or (Equiv.Perm.sign (Function.Involutive.toPerm f hf)) with h | h <;>
      simp [h]
  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) Ω) :=
    MvPolynomial.gradedAlgebra
  have hX : ∀ k : Fin (d + 1 + 1), (MvPolynomial.X k : MvPolynomial (Fin (d + 1 + 1)) Ω) ∈
      MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) Ω 1 := fun k =>
    (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X _ k)
  have hcover : ∀ q : wcProjK Ω (d + 1), ∃ c : Fin (d + 1 + 1), q ∈ wcSgD Ω (d + 1) c := by
    intro q
    by_contra hno
    push_neg at hno
    have hall : ∀ i : Fin (d + 1 + 1), MvPolynomial.X i ∈ q.asHomogeneousIdeal.toIdeal := by
      intro i
      have h8 := hno i
      rw [Proj.mem_basicOpen, not_not] at h8
      exact h8
    apply ProjectiveSpectrum.not_irrelevant_le q
    intro x hx
    have hx0 : x.coeff 0 = 0 := by
      rw [HomogeneousIdeal.mem_irrelevant_iff, GradedRing.proj_apply] at hx
      have h6 : ((DirectSum.decompose (MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) Ω) x 0 :
          MvPolynomial (Fin (d + 1 + 1)) Ω)) = MvPolynomial.homogeneousComponent 0 x :=
        MvPolynomial.decomposition.decompose'_apply x 0
      rw [h6, MvPolynomial.homogeneousComponent_zero, MvPolynomial.C_eq_zero] at hx
      exact hx
    have hspan : x ∈ Ideal.span (MvPolynomial.X '' (Set.univ : Set (Fin (d + 1 + 1)))) := by
      rw [MvPolynomial.mem_ideal_span_X_image]
      intro m hm
      rw [MvPolynomial.mem_support_iff] at hm
      have hm0 : m ≠ 0 := by
        rintro rfl
        exact hm hx0
      obtain ⟨i, hi⟩ := Finsupp.ne_iff.mp hm0
      exact ⟨i, Set.mem_univ _, hi⟩
    have hle : Ideal.span (MvPolynomial.X '' (Set.univ : Set (Fin (d + 1 + 1)))) ≤
        q.asHomogeneousIdeal.toIdeal := by
      rw [Ideal.span_le, Set.image_subset_iff]
      intro i _
      exact hall i
    exact hle hspan
  have L1 : ∀ {σ : Type u} {A : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
      (𝒜 : ℕ → σ) [GradedRing 𝒜] (f g : A) (hf : f ∈ 𝒜 1) (hg : g ∈ 𝒜 2) (hg' : g ∈ 𝒜 (2 • 1)),
      Proj.basicOpen 𝒜 f ⊓ Proj.basicOpen 𝒜 g = (Proj 𝒜).basicOpen
        (Proj.awayToSection 𝒜 f (HomogeneousLocalization.Away.mk 𝒜 hf 2 g hg')) := by
    intro σ A _ _ _ 𝒜 _ f g hf hg hg'
    have ha : HomogeneousLocalization.Away.isLocalizationElem hf hg =
        HomogeneousLocalization.Away.mk 𝒜 hf 2 g hg' := by
      apply HomogeneousLocalization.val_injective
      simp [HomogeneousLocalization.Away.val_mk]
    have hb : (Proj.basicOpen 𝒜 f).ι ⁻¹ᵁ Proj.basicOpen 𝒜 g =
        (Proj.basicOpenIsoSpec 𝒜 f hf Nat.one_pos).hom ⁻¹ᵁ
          PrimeSpectrum.basicOpen (HomogeneousLocalization.Away.mk 𝒜 hf 2 g hg') := by
      have h1 := Proj.awayι_preimage_basicOpen 𝒜 hf Nat.one_pos hg (by norm_num : 0 < 2)
      rw [← Proj.basicOpenIsoSpec_inv_ι, Scheme.Hom.comp_preimage, ha] at h1
      rw [← h1, ← Scheme.Hom.comp_preimage, Iso.hom_inv_id, Scheme.Hom.id_preimage]
    have hd' : (Proj 𝒜).basicOpen (Proj.awayToSection 𝒜 f
          (HomogeneousLocalization.Away.mk 𝒜 hf 2 g hg')) =
        (Proj.basicOpen 𝒜 f).ι ''ᵁ ((Proj.basicOpenIsoSpec 𝒜 f hf Nat.one_pos).hom ⁻¹ᵁ
          PrimeSpectrum.basicOpen (HomogeneousLocalization.Away.mk 𝒜 hf 2 g hg')) := by
      have hsp := basicOpen_eq_of_affine (R := CommRingCat.of (HomogeneousLocalization.Away 𝒜 f))
        (HomogeneousLocalization.Away.mk 𝒜 hf 2 g hg')
      have h3 : (Proj.basicOpenIsoSpec 𝒜 f hf Nat.one_pos).hom ⁻¹ᵁ
          PrimeSpectrum.basicOpen (HomogeneousLocalization.Away.mk 𝒜 hf 2 g hg') =
          (Proj.basicOpenIsoSpec 𝒜 f hf Nat.one_pos).hom ⁻¹ᵁ
          (Spec _).basicOpen ((Scheme.ΓSpecIso _).inv
            (HomogeneousLocalization.Away.mk 𝒜 hf 2 g hg')) :=
        congrArg (fun V => (Proj.basicOpenIsoSpec 𝒜 f hf Nat.one_pos).hom ⁻¹ᵁ V) hsp.symm
      rw [h3, ← Scheme.Opens.ι_image_basicOpen_topIso_inv, Scheme.preimage_basicOpen_top]
      congr 2
      rw [Proj.basicOpenIsoSpec_hom]
      change _ = ConcreteCategory.hom (Scheme.Hom.app (Proj.basicOpenToSpec 𝒜 f) ⊤) _
      rw [Proj.basicOpenToSpec_app_top]
      exact congrArg (fun y => ConcreteCategory.hom (Proj.basicOpen 𝒜 f).topIso.inv
        (ConcreteCategory.hom (Proj.awayToSection 𝒜 f) y))
        (Iso.inv_hom_id_apply (Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away 𝒜 f)))
          (HomogeneousLocalization.Away.mk 𝒜 hf 2 g hg')).symm
    rw [hd', ← hb, Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι]
  have hkey : ∀ (G : MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) Ω 2) (c : Fin (d + 1 + 1)),
      (wcProjK Ω (d + 1)).basicOpen (wcLdpSec Ω (d + 1) G c) = wcSgD Ω (d + 1) c ⊓
        @Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) Ω)
          MvPolynomial.gradedAlgebra (G : MvPolynomial (Fin (d + 1 + 1)) Ω) := by
    intro G c
    exact (L1 _ (MvPolynomial.X c) (G : MvPolynomial (Fin (d + 1 + 1)) Ω) (hX c) G.2 G.2).symm
  have hgerm : ∀ (G : MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) Ω 2)
      (c : Fin (d + 1 + 1)) (q : wcProjK Ω (d + 1)) (hq : q ∈ wcSgD Ω (d + 1) c),
      ((wcProjK Ω (d + 1)).presheaf.germ (wcSgD Ω (d + 1) c) q hq).hom
          (wcLdpSec Ω (d + 1) G c) ∈
        IsLocalRing.maximalIdeal ((wcProjK Ω (d + 1)).presheaf.stalk q) ↔
        q ∉ @Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) Ω)
          MvPolynomial.gradedAlgebra (G : MvPolynomial (Fin (d + 1 + 1)) Ω) := by
    intro G c q hq
    have e1 := Scheme.mem_basicOpen (wcProjK Ω (d + 1)) (wcLdpSec Ω (d + 1) G c) q hq
    rw [hkey G c, TopologicalSpace.Opens.mem_inf] at e1
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    constructor
    · intro h h'
      exact h (e1.mp ⟨hq, h'⟩)
    · intro h h'
      exact h (e1.mpr h').2
  have hpull : ∀ (G : MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) Ω 2)
      (x : Y) (c : Fin (d + 1 + 1)) (hx : x ∈ jY ⁻¹ᵁ wcSgD Ω (d + 1) c),
      wcLdpGerm Ω (d + 1) jY G c x hx ∈ IsLocalRing.maximalIdeal (Y.presheaf.stalk x) →
      ((wcProjK Ω (d + 1)).presheaf.germ (wcSgD Ω (d + 1) c) (jY x) hx).hom
          (wcLdpSec Ω (d + 1) G c) ∈
        IsLocalRing.maximalIdeal ((wcProjK Ω (d + 1)).presheaf.stalk (jY x)) := by
    intro G x c hx h
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at h ⊢
    intro hu
    apply h
    have e := Scheme.Hom.germ_stalkMap_apply jY (wcSgD Ω (d + 1) c) x hx (wcLdpSec Ω (d + 1) G c)
    have hu' : IsUnit ((jY.stalkMap x).hom
        (((wcProjK Ω (d + 1)).presheaf.germ (wcSgD Ω (d + 1) c) (jY x) hx).hom
          (wcLdpSec Ω (d + 1) G c))) := (isUnit_map_iff (jY.stalkMap x).hom _).mpr hu
    have e' : (jY.stalkMap x).hom
        (((wcProjK Ω (d + 1)).presheaf.germ (wcSgD Ω (d + 1) c) (jY x) hx).hom
          (wcLdpSec Ω (d + 1) G c)) = wcLdpGerm Ω (d + 1) jY G c x hx := e
    rw [e'] at hu'
    exact hu'
  ext p
  constructor
  · rintro ⟨x, rfl⟩
    obtain ⟨c, hc⟩ := hcover (jY x)
    exact (hgerm _ c (jY x) hc).mp (hpull _ x c hc (hEG x c hc))
  · intro hp
    haveI : IsProper (Over.mk fY).hom := ‹IsProper fY›
    haveI : SmoothOfRelativeDimension d (Over.mk fY).hom := ‹SmoothOfRelativeDimension d fY›
    haveI : Nonempty (Over.mk fY).left := ‹Nonempty Y›
    exact wc_quadric_section_full Ω d (by omega) (Over.mk fY) jY hjY hjf _ hdet
      (fun x c hx => hEG x c hx) p (fun c hc => (hgerm _ c p hc).mpr hp)

theorem wc_ysi_split_quadric_irreducible (Ω : Type u) [Field Ω] (d : ℕ) (hd : Even d)
    (hd1 : 1 ≤ d) (Y : Scheme.{u}) (jY : Y ⟶ wcProjK Ω (d + 1)) (hjY : IsClosedImmersion jY)
    (hR : Set.range jY = {p | p ∉ @Proj.basicOpen _ _ _ _ _
      (MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) Ω) MvPolynomial.gradedAlgebra
      (wcLdpQuad Ω (d + 1) (fun p q : Fin (d + 1 + 1) =>
        if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : Ω) else 0) :
        MvPolynomial (Fin (d + 1 + 1)) Ω)}) :
    IrreducibleSpace Y :=
by
  classical
  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) Ω) :=
    MvPolynomial.gradedAlgebra

  have hdet : (Matrix.of (fun p q : Fin (d + 1 + 1) =>
        if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : Ω) else 0) +
      (Matrix.of (fun p q : Fin (d + 1 + 1) =>
        if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : Ω) else 0)).transpose).det ≠ 0 := by
    obtain ⟨t, ht⟩ := hd
    let f : Fin (d + 1 + 1) → Fin (d + 1 + 1) := fun p =>
      ⟨if p.val % 2 = 0 then p.val + 1 else p.val - 1, by split_ifs <;> omega⟩
    have hf : Function.Involutive f := by
      intro p
      apply Fin.ext
      simp only [f]
      split_ifs <;> omega
    have hS : Matrix.of (fun p q : Fin (d + 1 + 1) =>
          if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : Ω) else 0) +
        (Matrix.of (fun p q : Fin (d + 1 + 1) =>
          if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : Ω) else 0)).transpose =
        Equiv.Perm.permMatrix Ω (Function.Involutive.toPerm f hf) := by
      ext p q
      simp only [Matrix.add_apply, Matrix.of_apply, Matrix.transpose_apply, Equiv.Perm.permMatrix,
        PEquiv.toMatrix_apply, Equiv.toPEquiv_apply, Option.mem_def, Option.some.injEq,
        Function.Involutive.coe_toPerm, f, Fin.ext_iff]
      split_ifs <;> first | omega | norm_num
    rw [hS, Matrix.det_permutation]
    rcases Int.units_eq_one_or (Equiv.Perm.sign (Function.Involutive.toPerm f hf)) with h | h <;>
      simp [h]

  set G := wcLdpQuad Ω (d + 1) (fun p q : Fin (d + 1 + 1) =>
        if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : Ω) else 0) with hGdef
  have hprime : Prime (G : MvPolynomial (Fin (d + 1 + 1)) Ω) :=
    wc_qsf_quad_prime Ω d hd1 _ hdet

  have hX : ∀ k : Fin (d + 1 + 1), (MvPolynomial.X k : MvPolynomial (Fin (d + 1 + 1)) Ω) ∈
      MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) Ω 1 := fun k =>
    (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X _ k)
  have hXirr : ∀ k : Fin (d + 1 + 1), (MvPolynomial.X k : MvPolynomial (Fin (d + 1 + 1)) Ω) ∈
      HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) Ω) := by
    intro k
    rw [HomogeneousIdeal.mem_irrelevant_iff, GradedRing.proj_apply]
    have h6 : ((DirectSum.decompose (MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) Ω)
        (MvPolynomial.X k) 0 : MvPolynomial (Fin (d + 1 + 1)) Ω)) =
        MvPolynomial.homogeneousComponent 0 (MvPolynomial.X k) :=
      MvPolynomial.decomposition.decompose'_apply _ 0
    rw [h6, MvPolynomial.homogeneousComponent_of_mem (hX k)]
    simp
  have hGh : (G : MvPolynomial (Fin (d + 1 + 1)) Ω).IsHomogeneous 2 :=
    (MvPolynomial.mem_homogeneousSubmodule 2 _).mp G.2
  have hG0 : (G : MvPolynomial (Fin (d + 1 + 1)) Ω) ≠ 0 := hprime.ne_zero
  have hIhom : Ideal.IsHomogeneous (MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) Ω)
      (Ideal.span {(G : MvPolynomial (Fin (d + 1 + 1)) Ω)}) := by
    apply Ideal.homogeneous_span
    intro x hx
    rw [Set.mem_singleton_iff] at hx
    subst hx
    exact ⟨2, G.2⟩
  have hIprime : (Ideal.span {(G : MvPolynomial (Fin (d + 1 + 1)) Ω)}).IsPrime :=
    (Ideal.span_singleton_prime hG0).mpr hprime
  have hnirr : ¬ HomogeneousIdeal.irrelevant
      (MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) Ω) ≤
      (⟨Ideal.span {(G : MvPolynomial (Fin (d + 1 + 1)) Ω)}, hIhom⟩ :
        HomogeneousIdeal (MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) Ω)) := by
    intro hle
    have h1 : (MvPolynomial.X 0 : MvPolynomial (Fin (d + 1 + 1)) Ω) ∈
        Ideal.span {(G : MvPolynomial (Fin (d + 1 + 1)) Ω)} := hle (hXirr 0)
    rw [Ideal.mem_span_singleton] at h1
    obtain ⟨h, hh⟩ := h1
    have hh0 : h ≠ 0 := by
      rintro rfl
      rw [mul_zero] at hh
      exact MvPolynomial.X_ne_zero _ hh
    have h2 := congrArg MvPolynomial.totalDegree hh
    rw [MvPolynomial.totalDegree_X, MvPolynomial.totalDegree_mul_of_isDomain hG0 hh0,
      hGh.totalDegree hG0] at h2
    omega
  let η : wcProjK Ω (d + 1) := ProjectiveSpectrum.mk
    (⟨Ideal.span {(G : MvPolynomial (Fin (d + 1 + 1)) Ω)}, hIhom⟩ :
      HomogeneousIdeal (MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) Ω)) hIprime hnirr
  have hZeq : {q : wcProjK Ω (d + 1) | q ∉ @Proj.basicOpen _ _ _ _ _
      (MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) Ω) MvPolynomial.gradedAlgebra
      (G : MvPolynomial (Fin (d + 1 + 1)) Ω)} = closure {η} := by
    ext q
    simp only [Set.mem_setOf_eq]
    rw [Proj.mem_basicOpen, not_not]
    have key := (ProjectiveSpectrum.le_iff_mem_closure
      (MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) Ω) η q)
    refine Iff.trans ?_ ((ProjectiveSpectrum.as_ideal_le_as_ideal _ η q).trans key)
    constructor
    · intro hq x hx
      have hle : Ideal.span {(G : MvPolynomial (Fin (d + 1 + 1)) Ω)} ≤
          q.asHomogeneousIdeal.toIdeal :=
        Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hq)
      exact hle hx
    · intro hle
      exact hle (Ideal.subset_span (Set.mem_singleton _))
  have hZirr : IsIrreducible {q : wcProjK Ω (d + 1) | q ∉ @Proj.basicOpen _ _ _ _ _
      (MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) Ω) MvPolynomial.gradedAlgebra
      (G : MvPolynomial (Fin (d + 1 + 1)) Ω)} := by
    rw [hZeq]
    exact isIrreducible_singleton.closure

  have hirr : IsIrreducible (Set.range jY) := by
    rw [hR]
    exact hZirr
  haveI := hjY
  haveI : IrreducibleSpace (Set.range jY) := Subtype.irreducibleSpace hirr
  exact Function.Surjective.irreducibleSpace
    (jY.isClosedEmbedding.isEmbedding.toHomeomorph).symm.continuous
    (jY.isClosedEmbedding.isEmbedding.toHomeomorph).symm.surjective

theorem wc_ysi_split_quadric_planes (Ω : Type u) [Field Ω] (d m : ℕ) (hdm : d = 2 * m)
    (hm : 1 ≤ m) (Y : Scheme.{u}) (fY : Y ⟶ Spec (.of Ω)) (jY : Y ⟶ wcProjK Ω (d + 1))
    (hjY : IsClosedImmersion jY) (hjf : jY ≫ wcProjKStr Ω (d + 1) = fY)
    (hR : Set.range jY = {p | p ∉ @Proj.basicOpen _ _ _ _ _
      (MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) Ω) MvPolynomial.gradedAlgebra
      (wcLdpQuad Ω (d + 1) (fun p q : Fin (d + 1 + 1) =>
        if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : Ω) else 0) :
        MvPolynomial (Fin (d + 1 + 1)) Ω)}) :
    ∃ (i i' : wcProjK Ω m ⟶ Y) (O O' : Y.Opens) (π : (O : Scheme.{u}) ⟶ wcProjK Ω m)
      (s : wcProjK Ω m ⟶ (O : Scheme.{u})) (π' : (O' : Scheme.{u}) ⟶ wcProjK Ω m)
      (s' : wcProjK Ω m ⟶ (O' : Scheme.{u})),
      IsClosedImmersion i ∧ IsClosedImmersion i' ∧
      i ≫ fY = wcProjKStr Ω m ∧ i' ≫ fY = wcProjKStr Ω m ∧
      (O : Set Y) = (Set.range i)ᶜ ∧ (O' : Set Y) = (Set.range i')ᶜ ∧
      s ≫ O.ι = i' ∧ s ≫ π = 𝟙 _ ∧ s' ≫ O'.ι = i ∧ s' ≫ π' = 𝟙 _ :=
by
  classical
  subst hdm
  haveI := hjY
  obtain ⟨Hp, hHpdef⟩ : ∃ Hp : MvPolynomial (Fin (2 * m + 1 + 1)) Ω, Hp =
      (wcLdpQuad Ω (2 * m + 1) (fun p q : Fin (2 * m + 1 + 1) =>
        if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : Ω) else 0) :
        MvPolynomial (Fin (2 * m + 1 + 1)) Ω) := ⟨_, rfl⟩
  rw [← hHpdef] at hR

  have s4 : ∀ {A B σ τ : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A] [CommRing B]
      [SetLike τ B] [AddSubgroupClass τ B] {𝒜 : ℕ → σ} {ℬ : ℕ → τ} [GradedRing 𝒜] [GradedRing ℬ]
      (f : 𝒜 →+*ᵍ ℬ)
      (hf : HomogeneousIdeal.irrelevant ℬ ≤ HomogeneousIdeal.map f (HomogeneousIdeal.irrelevant 𝒜))
      {ι : Type} (s : ι → A) (d : ι → ℕ), (∀ i, s i ∈ 𝒜 (d i)) → (∀ i, 0 < d i) →
      (HomogeneousIdeal.irrelevant 𝒜).toIdeal ≤ Ideal.span (Set.range s) →
      (∀ i, Function.Surjective (HomogeneousLocalization.Away.map f (s i))) →
      IsClosedImmersion (Proj.map f hf) := by
    intro A B σ τ _ _ _ _ _ _ 𝒜 ℬ _ _ f hf ι s d hs hd hcov hsurj
    refine IsZariskiLocalAtTarget.of_iSup_eq_top (P := @IsClosedImmersion)
      (fun i => Proj.basicOpen 𝒜 (s i)) (Proj.iSup_basicOpen_eq_top 𝒜 s hcov) ?_
    intro i
    have hs' : f (s i) ∈ ℬ (d i) := f.map_mem (hs i)
    let iV := Proj.awayι 𝒜 (s i) (hs i) (hd i)
    let iU := Proj.awayι ℬ (f (s i)) hs' (hd i)
    let g := Spec.map (CommRingCat.ofHom (HomogeneousLocalization.Away.map f (s i)))
    have hc : iU ≫ Proj.map f hf = g ≫ iV := Proj.awayι_comp_map f hf (hd i) (s i) (hs i)
    have hpre : Proj.map f hf ⁻¹ᵁ iV.opensRange = iU.opensRange := by
      simp only [iV, iU, Proj.opensRange_awayι]
      exact Proj.map_preimage_basicOpen f hf (s i)
    have hpb : IsPullback g iU iV (Proj.map f hf) := IsOpenImmersion.isPullback g iU iV _ hc hpre
    have hg : IsClosedImmersion g :=
      IsClosedImmersion.spec_of_surjective _ (by simpa using hsurj i)
    have h1 : IsClosedImmersion (Limits.pullback.snd (Proj.map f hf) iV) :=
      (MorphismProperty.arrow_mk_iso_iff @IsClosedImmersion
        (Arrow.isoMk hpb.flip.isoPullback (Iso.refl _)
          (by
            dsimp only [Arrow.mk_hom, Iso.refl_hom]
            rw [Category.comp_id]
            exact IsPullback.isoPullback_hom_snd _))).mp hg
    have h2 : IsClosedImmersion (Proj.map f hf ∣_ iV.opensRange) :=
      (MorphismProperty.arrow_mk_iso_iff @IsClosedImmersion
        (morphismRestrictOpensRange _ iV)).mpr h1
    exact (MorphismProperty.arrow_mk_iso_iff @IsClosedImmersion
      (morphismRestrictEq _ (Proj.opensRange_awayι 𝒜 (s i) (hs i) (hd i)))).mp h2
  have s3 : ∀ {A B σ τ : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A] [CommRing B]
      [SetLike τ B] [AddSubgroupClass τ B] {𝒜 : ℕ → σ} {ℬ : ℕ → τ} [GradedRing 𝒜] [GradedRing ℬ]
      (f : 𝒜 →+*ᵍ ℬ), (∀ (n : ℕ) (b : B), b ∈ ℬ n → ∃ a ∈ 𝒜 n, f a = b) →
      ∀ (s : A) (d : ℕ), s ∈ 𝒜 d → Function.Surjective (HomogeneousLocalization.Away.map f s) := by
    intro A B σ τ _ _ _ _ _ _ 𝒜 ℬ _ _ f hsurj s d hs y
    obtain ⟨n, b, hb, rfl⟩ := HomogeneousLocalization.Away.mk_surjective ℬ (f.map_mem hs) y
    obtain ⟨a, ha, rfl⟩ := hsurj _ b hb
    exact ⟨_, HomogeneousLocalization.Away.map_mk f s hs n a ha⟩
  have s1 : ∀ (n : ℕ) (p : MvPolynomial (Fin n) Ω),
      letI : GradedRing (MvPolynomial.homogeneousSubmodule (Fin n) Ω) := MvPolynomial.gradedAlgebra
      p ∈ HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin n) Ω) ↔
        p.coeff 0 = 0 := by
    intro n p
    letI : GradedRing (MvPolynomial.homogeneousSubmodule (Fin n) Ω) := MvPolynomial.gradedAlgebra
    rw [HomogeneousIdeal.mem_irrelevant_iff, GradedRing.proj_apply]
    erw [MvPolynomial.decomposition.decompose'_apply]
    rw [MvPolynomial.homogeneousComponent_zero, MvPolynomial.C_eq_zero]
  have hcovG : ∀ n : ℕ,
      letI : GradedRing (MvPolynomial.homogeneousSubmodule (Fin n) Ω) := MvPolynomial.gradedAlgebra
      (HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin n) Ω)).toIdeal ≤
        Ideal.span (Set.range (MvPolynomial.X : Fin n → MvPolynomial (Fin n) Ω)) := by
    intro n x hx
    have hx0 : x.coeff 0 = 0 := (s1 n x).mp (HomogeneousIdeal.mem_iff.mp hx)
    rw [← Set.image_univ, MvPolynomial.mem_ideal_span_X_image]
    intro mm hmm
    have hm0 : mm ≠ 0 := by
      rintro rfl
      exact (MvPolynomial.mem_support_iff.mp hmm) hx0
    obtain ⟨i, hi⟩ := Finsupp.ne_iff.mp hm0
    exact ⟨i, Set.mem_univ _, by simpa using hi⟩
  letI iA : GradedRing (MvPolynomial.homogeneousSubmodule (Fin (2 * m + 1 + 1)) Ω) :=
    MvPolynomial.gradedAlgebra
  letI iB : GradedRing (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) Ω) :=
    MvPolynomial.gradedAlgebra



  have plane : ∀ (c c' : ℕ) (hc : c + c' = 1),
      ∃ (φ' : MvPolynomial.homogeneousSubmodule (Fin (2 * m + 1 + 1)) Ω →+*ᵍ
          MvPolynomial.homogeneousSubmodule (Fin (m + 1)) Ω)
        (hφ' : HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) Ω) ≤
          HomogeneousIdeal.map φ'
            (HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (2 * m + 1 + 1)) Ω))),
        (∀ r : Ω, φ' (MvPolynomial.C r) = MvPolynomial.C r) ∧
        (∀ k : Fin (m + 1), φ' (MvPolynomial.X
          (⟨2 * k.val + c', by have := k.isLt; omega⟩ : Fin (2 * m + 1 + 1))) = MvPolynomial.X k) ∧
        IsClosedImmersion (Proj.map φ' hφ') ∧
        Proj.map φ' hφ' ≫ wcProjKStr Ω (2 * m + 1) = wcProjKStr Ω m ∧
        (∀ p, p ∈ Set.range (Proj.map φ' hφ') ↔ ∀ k : Fin (m + 1),
          (MvPolynomial.X (⟨2 * k.val + c, by have := k.isLt; omega⟩ : Fin (2 * m + 1 + 1)) :
            MvPolynomial (Fin (2 * m + 1 + 1)) Ω) ∈ p.asHomogeneousIdeal) ∧
        Set.range (Proj.map φ' hφ') ⊆ Set.range jY := by
    intro c c' hc
    let g : Fin (2 * m + 1 + 1) → MvPolynomial (Fin (m + 1)) Ω := fun t =>
      if h : t.val % 2 = c' then MvPolynomial.X ⟨t.val / 2, by have := t.isLt; omega⟩ else 0
    let ob : Fin (m + 1) → Fin (2 * m + 1 + 1) := fun k => ⟨2 * k.val + c', by have := k.isLt; omega⟩
    let ev : Fin (m + 1) → Fin (2 * m + 1 + 1) := fun k => ⟨2 * k.val + c, by have := k.isLt; omega⟩
    have hg : ∀ t, (g t).IsHomogeneous 1 := by
      intro t
      dsimp only [g]
      split_ifs
      · exact MvPolynomial.isHomogeneous_X Ω _
      · exact MvPolynomial.isHomogeneous_zero _ _ 1
    have hgob : ∀ k, g (ob k) = MvPolynomial.X k := by
      intro k
      have h : (ob k).val % 2 = c' := by show (2 * k.val + c') % 2 = c'; omega
      dsimp only [g]
      rw [dif_pos h]
      congr 1
      exact Fin.ext (by show (2 * k.val + c') / 2 = k.val; omega)
    have hgz : ∀ t : Fin (2 * m + 1 + 1), ¬ t.val % 2 = c' → g t = 0 := by
      intro t ht
      dsimp only [g]
      rw [dif_neg ht]
    have hgev : ∀ k, g (ev k) = 0 := fun k => hgz _ (by show ¬ (2 * k.val + c) % 2 = c'; omega)
