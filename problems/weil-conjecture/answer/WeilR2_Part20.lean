  have hBl : ∀ a b : (V.left.presheaf.stalk x), ∃ l : (V.left.presheaf.stalk x),
      ∀ z : (V.left.presheaf.stalk x), (a ∣ z ∧ b ∣ z ↔ l ∣ z) := by
    intro a b
    obtain ⟨l, hl⟩ := hRl (Φ.symm a) (Φ.symm b)
    refine ⟨Φ l, fun z => ?_⟩
    have e1 : ∀ c w : (V.left.presheaf.stalk x), c ∣ w ↔ Φ.symm c ∣ Φ.symm w :=
      fun c w => (map_dvd_iff Φ.symm).symm
    have e2 : Φ l ∣ z ↔ l ∣ Φ.symm z := by
      conv_lhs => rw [← Φ.apply_symm_apply z]
      exact map_dvd_iff Φ
    rw [e1 a z, e1 b z, e2]
    exact hl _

  generalize (V.left.presheaf.germ ⊤ x trivial).hom f = g
  by_cases hg : g = 0
  · subst hg
    haveI : Unique (Localization.Away (0 : (V.left.presheaf.stalk x))) :=
      IsLocalization.uniqueOfZeroMem (M := Submonoid.powers (0 : (V.left.presheaf.stalk x)))
        ⟨1, pow_one 0⟩
    rw [CommRing.Pic.subsingleton_iff]
    intro M _ _ _
    exact Module.Free.of_subsingleton' _ _
  · obtain ⟨hd, hl⟩ := lcm2 _ hBl g hg
    haveI := hd
    exact pic1 _ hl

theorem wc_qmbt_xsp_ess_D1l_Y_strict_punct_h1_card {A : Type u} [CommRing A] [IsDomain A]
    [IsDiscreteValuationRing A]
