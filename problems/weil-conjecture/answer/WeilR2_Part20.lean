    exact (h3 (Abelian.Ext.mapExactFunctor (Df.Φ ⋙ Df'.Φ) x) (Df'.Φ.map Df.μ.hom ≫ Df'.μ.hom)
      (m.app (SheafOfModules.unit (wcRingSheaf V'' ℓ)))).symm.trans (hcen m _).symm
  rw [hmove, h2, ha']

theorem wc_qmbt_dlyt_proet_mv_two {Y Z A B P ZA ZB ZP : Scheme.{u}} {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (i : Z ⟶ Y) [IsClosedImmersion i] [IsLocallyNoetherian Y]
    (jA : A ⟶ Y) (jB : B ⟶ Y) [IsOpenImmersion jA] [IsOpenImmersion jB]
    (hjs : ∀ y : Y, y ∈ Set.range jA ∨ y ∈ Set.range jB)
    (pA : P ⟶ A) (pB : P ⟶ B) (hP : IsPullback pA pB jA jB)
    (iA : ZA ⟶ A) (iB : ZB ⟶ B) (iP : ZP ⟶ P) (gA : ZA ⟶ Z) (gB : ZB ⟶ Z)
    (gPA : ZP ⟶ ZA) (gPB : ZP ⟶ ZB)
    (hA : IsPullback gA iA i jA) (hB : IsPullback gB iB i jB)
    (hPA : IsPullback gPA iP iA pA) (hPB : IsPullback gPB iP iB pB)
    (D : wcHMPullData i ℓ) (DA : wcHMPullData iA ℓ) (DB : wcHMPullData iB ℓ)
    (DP : wcHMPullData iP ℓ) (EA : wcHMPullData jA ℓ) (EB : wcHMPullData jB ℓ)
    (EPA : wcHMPullData pA ℓ) (EPB : wcHMPullData pB ℓ)
    (hD : wcHMPullCanonical D) (hDA : wcHMPullCanonical DA) (hDB : wcHMPullCanonical DB)
    (hDP : wcHMPullCanonical DP) (hEA : wcHMPullCanonical EA) (hEB : wcHMPullCanonical EB)
    (hEPA : wcHMPullCanonical EPA) (hEPB : wcHMPullCanonical EPB)
    (eD : Epi (wcSuppUnitMap D)) (eDA : Epi (wcSuppUnitMap DA)) (eDB : Epi (wcSuppUnitMap DB))
    (eDP : Epi (wcSuppUnitMap DP))
    (γA : wcSuppObj DA ⟶ EA.Φ.obj (wcSuppObj D)) (γB : wcSuppObj DB ⟶ EB.Φ.obj (wcSuppObj D))
    (γPA : wcSuppObj DP ⟶ EPA.Φ.obj (wcSuppObj DA))
    (γPB : wcSuppObj DP ⟶ EPB.Φ.obj (wcSuppObj DB))
    (hγA : wcSuppUnitMap DA ≫ γA = EA.μ.inv ≫ EA.Φ.map (wcSuppUnitMap D))
    (hγB : wcSuppUnitMap DB ≫ γB = EB.μ.inv ≫ EB.Φ.map (wcSuppUnitMap D))
    (hγPA : wcSuppUnitMap DP ≫ γPA = EPA.μ.inv ≫ EPA.Φ.map (wcSuppUnitMap DA))
    (hγPB : wcSuppUnitMap DP ≫ γPB = EPB.μ.inv ≫ EPB.Φ.map (wcSuppUnitMap DB))
    (q : ℕ) :
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf A ℓ)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf B ℓ)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf P ℓ)) := HasExt.standard _
    (∀ (θA : wcSuppExt DA q) (θB : wcSuppExt DB q),
      (Abelian.Ext.mk₀ γPA).comp (wcSuppPullExt DA EPA q θA) (zero_add _) =
        (Abelian.Ext.mk₀ γPB).comp (wcSuppPullExt DB EPB q θB) (zero_add _) →
      ∃ θ : wcSuppExt D q,
        (Abelian.Ext.mk₀ γA).comp (wcSuppPullExt D EA q θ) (zero_add _) = θA ∧
        (Abelian.Ext.mk₀ γB).comp (wcSuppPullExt D EB q θ) (zero_add _) = θB) ∧
    (∀ q' : ℕ, q' + 1 = q → (∀ t : wcSuppExt DP q', t = 0) → ∀ θ : wcSuppExt D q,
      (Abelian.Ext.mk₀ γA).comp (wcSuppPullExt D EA q θ) (zero_add _) = 0 →
      (Abelian.Ext.mk₀ γB).comp (wcSuppPullExt D EB q θ) (zero_add _) = 0 → θ = 0) :=
by
  classical
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf Y ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf A ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf B ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf P ℓ)) := HasExt.standard _

  haveI hpAo : IsOpenImmersion pA :=
    MorphismProperty.of_isPullback (P := @IsOpenImmersion) hP.flip inferInstance
  haveI : IsLocallyNoetherian P := isLocallyNoetherian_of_isOpenImmersion (pA ≫ jA)
  have sqP : IsPullback (gPA ≫ gA) iP i (pA ≫ jA) := hPA.paste_horiz hA
  obtain ⟨EP, hEP⟩ := wc_hm_pull_data_exists (pA ≫ jA) ℓ
  have kk := wc_supp_kernel_kill_of_noetherian i (pA ≫ jA) iP (gPA ≫ gA) sqP.flip ℓ D hD DP hDP
    EP hEP
  obtain ⟨γP, hγP⟩ : ∃ γP : wcSuppObj DP ⟶ EP.Φ.obj (wcSuppObj D),
      wcSuppUnitMap DP ≫ γP = EP.μ.inv ≫ EP.Φ.map (wcSuppUnitMap D) :=
    ⟨_, Abelian.comp_epiDesc _ _ kk⟩
  have isoA := wc_qmbt_pmv_open_gamma_iso jA i iA gA hA D hD eD DA hDA eDA EA hEA γA hγA
  have isoB := wc_qmbt_pmv_open_gamma_iso jB i iB gB hB D hD eD DB hDB eDB EB hEB γB hγB
  have isoP := wc_qmbt_pmv_open_gamma_iso (pA ≫ jA) i iP (gPA ≫ gA) sqP D hD eD DP hDP eDP
    EP hEP γP hγP
  obtain ⟨LA, adjA, pflA, monoA, suppA, epiA, surjA⟩ :=
    wc_qmbt_pmv_open_extzero_package jA ℓ EA hEA
  obtain ⟨LB, adjB, pflB, monoB, suppB, epiB, surjB⟩ :=
    wc_qmbt_pmv_open_extzero_package jB ℓ EB hEB
  obtain ⟨LP, adjP, pflP, monoP, suppP, epiP, surjP⟩ :=
    wc_qmbt_pmv_open_extzero_package (pA ≫ jA) ℓ EP hEP

  have hRA : Set.range (pA ≫ jA) ⊆ Set.range jA := by
    rintro _ ⟨p, rfl⟩
    exact ⟨pA p, (Scheme.Hom.comp_apply pA jA p).symm⟩
  have hRB : Set.range (pA ≫ jA) ⊆ Set.range jB := by
    rintro _ ⟨p, rfl⟩
    exact ⟨pB p, (Scheme.Hom.comp_apply pB jB p).symm.trans
      (congrArg (fun h : P ⟶ Y => h p) hP.w.symm)⟩
  have hRAB : Set.range jA ∩ Set.range jB ⊆ Set.range (pA ≫ jA) := by
    rintro _ ⟨⟨a, rfl⟩, hb⟩
    have ha : a ∈ Set.range (Limits.pullback.fst jA jB) := by
      rw [Scheme.Pullback.range_fst]
      exact hb
    obtain ⟨z, rfl⟩ := ha
    refine ⟨hP.isoPullback.inv z, ?_⟩
    have e : pA (hP.isoPullback.inv z) = Limits.pullback.fst jA jB z :=
      (Scheme.Hom.comp_apply hP.isoPullback.inv pA z).symm.trans
        (by rw [IsPullback.isoPullback_inv_fst])
