    ext x
    have hk0 : ((Df.μ.inv ≫ Df.Φ.map (wcSuppUnitMap D)).val.app (Opposite.op W)).hom
        (((Limits.kernel.ι (Df.μ.inv ≫ Df.Φ.map (wcSuppUnitMap D))).val.app
          (Opposite.op W)).hom x) = 0 :=
      congrArg (fun g => (g.val.app (Opposite.op W)).hom x)
        (Limits.kernel.condition (Df.μ.inv ≫ Df.Φ.map (wcSuppUnitMap D)))
    have hk := wc_closed_supp_bc_unit_ker_le i ℓ D hD (Scheme.ProEt.mk f) Df hDf Di hDi W _ hk0
    have hz : ((0 : Limits.kernel (Df.μ.inv ≫ Df.Φ.map (wcSuppUnitMap D)) ⟶
        wcSuppObj Di).val.app (Opposite.op W)).hom x = 0 := rfl
    refine Eq.trans ?_ hz.symm
