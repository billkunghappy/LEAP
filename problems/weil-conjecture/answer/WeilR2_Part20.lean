        (shiftFunctor (DerivedCategory (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)))
          (-1 : ℤ)).map ((DerivedCategory.singleFunctor
            (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)) 0).map S.g)
      let g' : P ⟶ (shiftFunctor (DerivedCategory (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)))
          (-1 : ℤ)).obj ((DerivedCategory.singleFunctor
