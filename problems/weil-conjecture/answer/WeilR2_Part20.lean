    exact (IsLocalRing.isClosed_singleton_closedPoint B₀).preimage
      (Scheme.Hom.continuous (ι' ≫ bl ≫ Limits.pullback.fst
        (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))))
  obtain ⟨ZY, iY, hiY, hrY⟩ : ∃ (Z : Scheme.{u}) (i : Z ⟶ Xs'), IsClosedImmersion i ∧
      Set.range i = closure Z2sᶜ ∩ Z2s :=
    ⟨_, (Scheme.IdealSheafData.vanishingIdeal
      (⟨_, isClosed_closure.inter hZc⟩ : TopologicalSpace.Closeds Xs')).subschemeι, inferInstance,
      (Scheme.IdealSheafData.range_subschemeι _).trans
        (Scheme.IdealSheafData.coe_support_vanishingIdeal _)⟩
  haveI := hiY
  obtain ⟨EY, hEY⟩ := wc_hm_pull_data_exists iY ℓ
  have hcover : Set.range i₁ ∪ Set.range i₂ = Set.univ := by
    rw [h₁, h₂, ← hZ2s]
    apply Set.eq_univ_of_forall
    intro x
    by_cases hx : x ∈ Z2s
    · exact Or.inr hx
    · exact Or.inl (subset_closure hx)
  have hinter : Set.range iY = Set.range i₁ ∩ Set.range i₂ := by
    rw [hrY, h₁, h₂, hZ2s]
  have hY : Set.range iY = closure ((fun z => (ι' ≫ bl ≫ Limits.pullback.fst
      (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))) z) ⁻¹'
        {IsLocalRing.closedPoint B₀})ᶜ ∩ (fun z => (ι' ≫ bl ≫ Limits.pullback.fst
      (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))) z) ⁻¹'
        {IsLocalRing.closedPoint B₀} := by
    rw [hrY, hZ2s]
  obtain ⟨ρ₁, ρ₂, hz, hS⟩ := wc_qmbt_hl_mv_closed_cover i₁ i₂ iY ℓ hcover hinter
    E₁ hE₁ E₂ hE₂ EY hEY

  have hmv : wcSuppUnitMap E₁ ≫ ρ₁ = wcSuppUnitMap E₂ ≫ ρ₂ := by
    rw [Limits.biprod.lift_desc, Preadditive.comp_neg, ← sub_eq_add_neg] at hz
    exact sub_eq_zero.mp hz

  obtain ⟨c₀, hc₀⟩ := wc_qmbt_xsp_ess_exc_supp_hits_D2 hℓ hn hn4 hπ hc hx₀ hsh hps hℓ' hπ' hπ'2
    hgen hφ' halg' hbl hblf hpb' hps' hβ Dβ hDβ Dp' hDp' Di' hDi' I' i₂ h₂ E₂ hE₂
  have hT₀ : c₀ ≫ (DerivedCategory.singleFunctor (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)) 1).map
      (wcSuppUnitMap E₁) ≠ 0 := by
    intro h0
    apply hc₀
    apply wc_qmbt_xsp_ess_exc_restr_inj hℓ hn hn4 hπ hc hx₀ hsh hps hℓ' hπ' hπ'2
      hgen hφ' halg' hbl hblf hpb' hps' hβ Dβ hDβ Dp' hDp' Di' hDi' I' i₁ i₂ iY h₁ h₂ hY
      E₁ hE₁ E₂ hE₂ EY hEY ρ₁ ρ₂ hz hS
    rw [Category.assoc, ← Functor.map_comp, ← hmv, Functor.map_comp, ← Category.assoc, h0,
      Limits.zero_comp]
  obtain ⟨e, he⟩ := wc_qmbt_xsp_ess_strict_rank_one hℓ hn hn4 hπ hc hx₀ hsh hps hℓ' hπ' hπ'2
    hgen hφ' halg' hbl hblf hpb' hps' hβ Dβ hDβ Dp' hDp' Di' hDi' I' i₁ i₂ h₁ h₂
    E₁ hE₁ E₂ hE₂ _ T hT₀
  exact ⟨e ≫ c₀, by rw [he, Category.assoc]⟩

theorem wc_qmbt_xsp_strict_gysin_in_exc {A : Type u} [CommRing A] [IsDomain A]
    [IsDiscreteValuationRing A]
    [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (hℓ : IsUnit ((ℓ : ℕ) : A)) {n : ℕ} (hn : Even n) (hn4 : 4 ≤ n) {π : A}
    {c : Matrix (Fin n) (Fin n) A}
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π}) (hc : IsUnit (c + c.transpose).det)
    {x₀ : Spec (.of (wcQuadModelRing A n π c))}
    (hx₀ : ∀ p, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
      PrimeSpectrum.asIdeal x₀)
    {B₀ : Type u} [CommRing B₀] [HenselianLocalRing B₀] [IsSepClosed (IsLocalRing.ResidueField B₀)]
    {Λ₀ : Type u} [SmallCategory Λ₀] [IsCofiltered Λ₀]
    {W₀ : Λ₀ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (wcQuadModelRing A n π c))) x₀))
      (Scheme.Etale.forget (Spec (.of (wcQuadModelRing A n π c))))}
    {φ₀ : ∀ l, Spec (.of B₀) ⟶ (W₀.obj l).right.left}
    {a₀ : Spec (.of B₀) ⟶ Spec (.of (wcQuadModelRing A n π c))}
    (hsh : wcHalShData x₀ B₀ Λ₀ W₀ φ₀ a₀)
    {Xs : Scheme.{u}} {ι : Xs ⟶ Spec (.of B₀)} {s : Xs ⟶ Spec (.of (IsLocalRing.ResidueField A))}
    (hps : IsPullback ι s (a₀ ≫ wcQuadModelStr A n π c) (wcQmSp A))
    {A' : Type u} [CommRing A'] [IsDomain A'] [IsDiscreteValuationRing A'] [HenselianLocalRing A']
    [IsSepClosed (IsLocalRing.ResidueField A')] {ιA : A →+* A'} {π' : A'}
    (hℓ' : IsUnit ((ℓ : ℕ) : A')) (hπ' : IsLocalRing.maximalIdeal A' = Ideal.span {π'})
    (hπ'2 : π' ^ 2 = ιA π) (hgen : ∀ a' : A', ∃ x y : A, a' = ιA x + ιA y * π')
    {L' : Type u} [Field L'] [IsSepClosed L'] {φ' : A' →+* L'} (hφ' : Function.Injective φ')
    (halg' : letI := φ'.toAlgebra; Algebra.IsAlgebraic A' L')
    {Xm : Scheme.{u}} {f : Xm ⟶ Spec (.of A')}
    {bl : Xm ⟶ Limits.pullback (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))}
    (hbl : wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range
      (fun i : Option (Fin n) => Option.elim i
        ((Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of A')).inv.hom π'))
        (fun j => ((Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))) ≫ a₀).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A n π c))).inv.hom
            (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X j)))))))) bl)
    (hblf : bl ≫ Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA)) = f)
    {XE' : Scheme.{u}} {p' : XE' ⟶ Xm} {q' : XE' ⟶ Spec (.of L')}
    (hpb' : IsPullback p' q' f (Spec.map (CommRingCat.ofHom φ')))
    {Xs' : Scheme.{u}} {ι' : Xs' ⟶ Xm} {s' : Xs' ⟶ Spec (.of (IsLocalRing.ResidueField A'))}
    (hps' : IsPullback ι' s' f (wcQmSp A'))
    {βs : Xs' ⟶ Xs}
    (hβ : βs ≫ ι = ι' ≫ bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA)))
    (Dβ : wcHMPullData βs ℓ) (hDβ : wcHMPullCanonical Dβ)
    [EnoughInjectives (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))]
    (Dp' : wcHMPullData p' ℓ) (hDp' : wcHMPullCanonical Dp')
    (Di' : wcHMPullData ι' ℓ) (hDi' : wcHMPullCanonical Di')
    (I' : InjectiveResolution (SheafOfModules.unit (wcRingSheaf XE' ℓ)))
    {Z₁ Z₂ ZY : Scheme.{u}} (i₁ : Z₁ ⟶ Xs') (i₂ : Z₂ ⟶ Xs') (iY : ZY ⟶ Xs')
    [IsClosedImmersion i₁] [IsClosedImmersion i₂] [IsClosedImmersion iY]
    (h₁ : Set.range i₁ = closure ((fun z => (ι' ≫ bl ≫ Limits.pullback.fst
      (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))) z) ⁻¹'
        {IsLocalRing.closedPoint B₀})ᶜ)
    (h₂ : Set.range i₂ = (fun z => (ι' ≫ bl ≫ Limits.pullback.fst
      (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))) z) ⁻¹'
        {IsLocalRing.closedPoint B₀})
    (hY : Set.range iY = closure ((fun z => (ι' ≫ bl ≫ Limits.pullback.fst
      (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))) z) ⁻¹'
        {IsLocalRing.closedPoint B₀})ᶜ ∩ (fun z => (ι' ≫ bl ≫ Limits.pullback.fst
      (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))) z) ⁻¹'
        {IsLocalRing.closedPoint B₀})
    (E₁ : wcHMPullData i₁ ℓ) (hE₁ : wcHMPullCanonical E₁)
    (E₂ : wcHMPullData i₂ ℓ) (hE₂ : wcHMPullCanonical E₂)
    (EY : wcHMPullData iY ℓ) (hEY : wcHMPullCanonical EY)
    (ρ₁ : wcSuppObj E₁ ⟶ wcSuppObj EY) (ρ₂ : wcSuppObj E₂ ⟶ wcSuppObj EY)
    (hz : Limits.biprod.lift (wcSuppUnitMap E₁) (wcSuppUnitMap E₂) ≫
      Limits.biprod.desc ρ₁ (-ρ₂) = 0)
    (hS : (ShortComplex.mk _ _ hz).ShortExact) :
    letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))
    ∀ T₁ : (DerivedCategory.singleFunctor (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))
        ((n : ℤ) - 1)).obj (wcSuppObj E₂) ⟶
        (DerivedCategory.singleFunctor (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)) 1).obj
          (wcSuppObj E₁),
      ∃ R : (DerivedCategory.singleFunctor (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))
          ((n : ℤ) - 1)).obj (wcSuppObj E₂) ⟶
          (DerivedCategory.singleFunctor (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)) 1).obj
            (wcSuppObj E₂),
        (DerivedCategory.singleFunctor (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))
            ((n : ℤ) - 1)).map (wcSuppUnitMap E₂) ≫ T₁ ≫
          (DerivedCategory.singleFunctor (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)) 1).map ρ₁ =
        (DerivedCategory.singleFunctor (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))
            ((n : ℤ) - 1)).map (wcSuppUnitMap E₂) ≫ R ≫
          (DerivedCategory.singleFunctor (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)) 1).map ρ₂ :=
by
  letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))
  intro T₁
  have hmv : wcSuppUnitMap E₁ ≫ ρ₁ = wcSuppUnitMap E₂ ≫ ρ₂ := by
    rw [Limits.biprod.lift_desc, Preadditive.comp_neg, ← sub_eq_add_neg] at hz
    exact sub_eq_zero.mp hz
  obtain ⟨g, hg⟩ := wc_qmbt_xsp_exc_supp_surj_strict hℓ hn hn4 hπ hc hx₀ hsh hps hℓ' hπ' hπ'2
    hgen hφ' halg' hbl hblf hpb' hps' hβ Dβ hDβ Dp' hDp' Di' hDi' I' i₁ i₂ h₁ h₂ E₁ hE₁ E₂ hE₂ T₁
  refine ⟨g ≫ (DerivedCategory.singleFunctor (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)) 1).map
    (wcSuppUnitMap E₂), ?_⟩
  rw [hg]
  simp only [Category.assoc, ← Functor.map_comp, hmv]

theorem wc_qmbt_xspl_supp_unit_open_isIso {Y Z : Scheme.{u}} {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (i : Z ⟶ Y) [IsClosedImmersion i] (D : wcHMPullData i ℓ) (hD : wcHMPullCanonical D)
    (Wo : Y.Opens) (hW : (Wo : Set ↥Y) ⊆ Set.range i)
    (Dw : wcHMPullData Wo.ι ℓ) (hDw : wcHMPullCanonical Dw) :
    IsIso (Dw.Φ.map (wcSuppUnitMap D)) :=
by
  classical
  obtain ⟨c', hc'⟩ := wc_supp_unit_twist_isUnit D
  set uu := wcSuppUnitMap D with huu
  let Vo : Y.ProEt := Scheme.ProEt.mk Wo.ι
  haveI hG : (wcSliceFunctor Y Vo).IsContinuous (Scheme.ProEt.topology Vo.left)
      (Scheme.ProEt.topology Y) := by
    haveI h1' := (wc_slice_over_sites_cont Y Vo).1
    haveI h0 : (Over.forget Vo).IsContinuous ((Scheme.ProEt.topology Y).over Vo)
        (Scheme.ProEt.topology Y) := inferInstance
    have h3 : (wcSliceToOver Y Vo ⋙ Over.forget Vo).IsContinuous (Scheme.ProEt.topology Vo.left)
        (Scheme.ProEt.topology Y) :=
      Functor.isContinuous_comp _ _ _ ((Scheme.ProEt.topology Y).over Vo) _
    exact h3
  obtain ⟨Φiso⟩ := wc_hm_pull_Phi_slice_iso Y ℓ Vo Dw hDw

  have crit : ∀ {M M' : SheafOfModules.{u+1} (wcRingSheaf Vo.left ℓ)} (φ : M ⟶ M'),
      (∀ X, Function.Bijective (φ.val.app X).hom) → IsIso φ := by
    intro M M' φ h
    have h2 : ∀ X, IsIso (((PresheafOfModules.toPresheaf (wcRingSheaf Vo.left ℓ).val).map
        ((SheafOfModules.forget (wcRingSheaf Vo.left ℓ)).map φ)).app X) := by
      intro X
      rw [ConcreteCategory.isIso_iff_bijective]
      exact h X
    have : IsIso ((PresheafOfModules.toPresheaf (wcRingSheaf Vo.left ℓ).val).map
        ((SheafOfModules.forget (wcRingSheaf Vo.left ℓ)).map φ)) := NatIso.isIso_of_isIso_app _
    have : IsIso ((SheafOfModules.forget (wcRingSheaf Vo.left ℓ)).map φ) :=
      isIso_of_reflects_iso _ (PresheafOfModules.toPresheaf (wcRingSheaf Vo.left ℓ).val)
    exact isIso_of_reflects_iso φ (SheafOfModules.forget (wcRingSheaf Vo.left ℓ))

  have hbijW : ∀ W' : Vo.left.ProEt,
      Function.Bijective (uu.val.app (Opposite.op ((wcSliceFunctor Y Vo).obj W'))).hom := by
    intro W'
    set W := (wcSliceFunctor Y Vo).obj W' with hWdef
    have hWhom : W.hom = W'.hom ≫ Wo.ι := rfl
    have hr : ∀ x, W.hom x ∈ Set.range i := by
      intro x
      have hx : Wo.ι (W'.hom x) ∈ Set.range Wo.ι := ⟨_, rfl⟩
      rw [Scheme.Opens.range_ι] at hx
      rw [hWhom]
      exact hW hx
    have hsurj : Function.Surjective (Limits.pullback.fst W.hom i) := by
      intro x
      have hx : x ∈ Set.range (Limits.pullback.fst W.hom i) := by
        rw [Scheme.Pullback.range_fst]
        exact hr x
      exact hx
    have hemb : Topology.IsEmbedding (Limits.pullback.fst W.hom i) :=
      (Scheme.Hom.isClosedEmbedding (Limits.pullback.fst W.hom i)).isEmbedding
    let e := hemb.toHomeomorphOfSurjective hsurj
    have hFe : ∀ x, (Limits.pullback.fst W.hom i).base.hom (e.symm x) = x :=
      fun x => e.apply_symm_apply x
    have hFe' : ∀ p, e.symm ((Limits.pullback.fst W.hom i).base.hom p) = p :=
      fun p => e.symm_apply_apply p
    have hgc : ∀ z : ↥Z, (wcSuppTwist uu) z * c' z = 1 := by
      intro z
      have := congrArg (fun f : C(↥Z, ULift.{u+1} ℚ_[ℓ]) => f z) hc'
      simpa [ContinuousMap.mul_apply] using this
    have hfun : (⇑(uu.val.app (Opposite.op W)).hom :
        C(↥W.left, ULift.{u+1} ℚ_[ℓ]) → C(↥(Limits.pullback W.hom i), ULift.{u+1} ℚ_[ℓ])) =
        (fun t : C(↥W.left, ULift.{u+1} ℚ_[ℓ]) =>
          t.comp (Limits.pullback.fst W.hom i).base.hom *
            (wcSuppTwist uu).comp (Limits.pullback.snd W.hom i).base.hom) :=
      funext (fun t => wc_supp_hom_twist_formula D hD uu W t)
    have hb : Function.Bijective (fun t : C(↥W.left, ULift.{u+1} ℚ_[ℓ]) =>
          t.comp (Limits.pullback.fst W.hom i).base.hom *
            (wcSuppTwist uu).comp (Limits.pullback.snd W.hom i).base.hom) := by
      refine ⟨fun a b hab => ?_, fun s => ⟨(s * c'.comp (Limits.pullback.snd W.hom i).base.hom).comp
        ⟨e.symm, e.symm.continuous⟩, ?_⟩⟩
      · apply ContinuousMap.ext
        intro x
        have h1 := congrArg (fun g : C(↥(Limits.pullback W.hom i), ULift.{u+1} ℚ_[ℓ]) =>
          g (e.symm x) * c' ((Limits.pullback.snd W.hom i).base.hom (e.symm x))) hab
        simp only [ContinuousMap.mul_apply, ContinuousMap.comp_apply] at h1
        rw [mul_assoc, mul_assoc, hgc, mul_one, mul_one, hFe] at h1
        exact h1
      · apply ContinuousMap.ext
        intro p
        simp only [ContinuousMap.mul_apply, ContinuousMap.comp_apply, ContinuousMap.coe_mk, hFe']
        rw [mul_assoc, mul_comm (c' _), hgc, mul_one]
    exact hfun ▸ hb
  haveI key : IsIso ((wcSliceRes Y ℓ Vo).map uu) := by
    apply crit
    intro X
    exact hbijW X.unop
  rw [← NatIso.naturality_2 Φiso uu]
  have h1 : IsIso (Φiso.hom.app (SheafOfModules.unit (wcRingSheaf Y ℓ))) :=
    (Φiso.app (SheafOfModules.unit (wcRingSheaf Y ℓ))).isIso_hom
  have h2 : IsIso (Φiso.inv.app (wcSuppObj D)) := (Φiso.app (wcSuppObj D)).isIso_inv
  have h3 : IsIso ((wcSliceRes Y ℓ Vo).map uu ≫ Φiso.inv.app (wcSuppObj D)) :=
    @IsIso.comp_isIso _ _ _ _ _ _ _ key h2
  exact @IsIso.comp_isIso _ _ _ _ _ _ _ h1 h3

theorem wc_qmbt_xspl_model_interior_chart_none {A' : Type u} [CommRing A'] [IsDomain A']
    [IsDiscreteValuationRing A'] {π' : A'} (hπ' : IsLocalRing.maximalIdeal A' = Ideal.span {π'})
    {n : ℕ} (c' : Matrix (Fin n) (Fin n) A') {X₁ : Scheme.{u}}
    {r₁ : X₁ ⟶ Spec (.of (wcQuadModelRing A' n (π' ^ 2) c'))}
    (hr : wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range fun k =>
        (Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) c'))).inv.hom
          (wcQmbtGen A' n π' c' k)))) r₁)
    {o : Spec (.of (wcQuadModelRing A' n (π' ^ 2) c'))}
    (ho : ∀ k, wcQmbtGen A' n π' c' k ∈ o.asIdeal) :
    ∃ (φ0 : wcQuadModelRing A' n (π' ^ 2) c' →+* wcQmbtChartNone A' n c')
      (e0 : Spec (.of (wcQmbtChartNone A' n c')) ⟶ X₁),
      (∀ p, φ0 (Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) c') (MvPolynomial.X p)) =
        Ideal.Quotient.mk (wcQmbtChartNoneIdeal A' n c') (MvPolynomial.C π' * MvPolynomial.X p)) ∧
      φ0.comp (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c')) =
        algebraMap A' (wcQmbtChartNone A' n c') ∧
      IsOpenImmersion e0 ∧ e0 ≫ r₁ = Spec.map (CommRingCat.ofHom φ0) ∧
      (closure ((fun z => (Limits.pullback.fst (r₁ ≫ Spec.map (CommRingCat.ofHom
          (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c')))) (wcQmSp A') ≫ r₁) z) ⁻¹' {o})ᶜ)ᶜ =
        (fun z => (Limits.pullback.fst (r₁ ≫ Spec.map (CommRingCat.ofHom
          (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c')))) (wcQmSp A')) z) ⁻¹' Set.range e0 :=
by
  classical

  obtain ⟨φ, φ0, e, e0, hpkg⟩ := wc_qmdl_charts_exist hπ' c' hr
  obtain ⟨h1, h2, h3, h4, h5, h6, h7, h8, h9, h10, h11⟩ := id hpkg
  haveI := h8

  obtain ⟨φ0', hX', hA', -, -, hup'⟩ := wc_qmbt_bm_chart_algebra_none hπ' c'
  have heq : φ0 = φ0' := by
    apply Ideal.Quotient.ringHom_ext
    apply MvPolynomial.ringHom_ext
    · intro a
      have e1 := RingHom.congr_fun h6 a
      have e2 := RingHom.congr_fun hA' a
      simp only [RingHom.comp_apply] at e1 e2 ⊢
      have hC : Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) c') (MvPolynomial.C a) =
          algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c') a := rfl
      rw [hC, e1, e2]
    · intro p
      simp only [RingHom.comp_apply]
      rw [h5 p, hX' p]
  have hup : ∀ (B : CommRingCat.{u}) (ρ : CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) c') ⟶ B),
      ρ.hom (wcQmbtGen A' n π' c' none) ∈ nonZeroDivisors B →
      Ideal.map ρ.hom (Ideal.span (Set.range (wcQmbtGen A' n π' c'))) =
        Ideal.span {ρ.hom (wcQmbtGen A' n π' c' none)} →
      ∃! ψ : CommRingCat.of (wcQmbtChartNone A' n c') ⟶ B, CommRingCat.ofHom φ0 ≫ ψ = ρ := by
    rw [heq]; exact hup'

  obtain ⟨-, -, -, hJ⟩ := wc_qmdl_gen_ideal_maximal hπ' n c'
  have hoJ : Ideal.span (Set.range (wcQmbtGen A' n π' c')) = o.asIdeal :=
    hJ.eq_of_le o.isPrime.ne_top (Ideal.span_le.mpr (by rintro _ ⟨k, rfl⟩; exact ho k))

  haveI : IsClosedImmersion (wcQmSp A') :=
    IsClosedImmersion.spec_of_surjective _ IsLocalRing.residue_surjective
  set g := r₁ ≫ Spec.map (CommRingCat.ofHom (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c')))
    with hg
  set fstS := Limits.pullback.fst g (wcQmSp A') with hfstS
  haveI hci : IsClosedImmersion fstS := by rw [hfstS]; infer_instance
  have hind : Topology.IsInducing fstS := (IsClosedImmersion.isClosedEmbedding fstS).isInducing

  have hs1 : ∀ w : X₁, w ∈ Set.range fstS ↔
      algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c') π' ∈ (r₁ w).asIdeal := by
    intro w
    rw [hfstS, Scheme.Pullback.range_fst]
    have hgw : (g w).asIdeal =
        Ideal.comap (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c')) (r₁ w).asIdeal := by
      rw [hg, Scheme.Hom.comp_apply]; rfl
    have hsp : ∀ t : Spec (.of (IsLocalRing.ResidueField A')),
        (wcQmSp A' t).asIdeal = IsLocalRing.maximalIdeal A' := by
      intro t
      have ht : t.asIdeal = ⊥ :=
        @Ideal.eq_bot_of_prime (IsLocalRing.ResidueField A') _ t.asIdeal t.isPrime
      show Ideal.comap (IsLocalRing.residue A') t.asIdeal = _
      rw [ht, ← RingHom.ker_eq_comap_bot, IsLocalRing.ker_residue]
    constructor
    · rintro ⟨t, ht⟩
      have hm : π' ∈ (g w).asIdeal := by
        rw [← ht, hsp, hπ']; exact Ideal.mem_span_singleton_self π'
      rw [hgw] at hm
      exact Ideal.mem_comap.mp hm
    · intro h
      obtain ⟨t⟩ : Nonempty (Spec (.of (IsLocalRing.ResidueField A'))) :=
        ⟨IsLocalRing.closedPoint _⟩
      refine ⟨t, ?_⟩
      apply PrimeSpectrum.ext
      rw [hsp t, hgw]
      apply le_antisymm
      · rw [hπ', Ideal.span_le, Set.singleton_subset_iff]; exact h
      · apply IsLocalRing.le_maximalIdeal
        intro htop
        apply (r₁ w).isPrime.ne_top
        rw [Ideal.eq_top_iff_one] at htop ⊢
        simpa [Ideal.mem_comap] using htop

  have hs2 : ∀ w : X₁, w ∈ Set.range e0 →
      algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c') π' ∈ (r₁ w).asIdeal → r₁ w = o := by
    rintro w ⟨y, rfl⟩ hπw
    have hry : (r₁ (e0 y)).asIdeal = Ideal.comap φ0 y.asIdeal := by
      have : r₁ (e0 y) = (e0 ≫ r₁) y := (Scheme.Hom.comp_apply _ _ _).symm
      rw [this, h10]; rfl
    apply PrimeSpectrum.ext
    rw [← hoJ]
    symm
    apply hJ.eq_of_le (r₁ (e0 y)).isPrime.ne_top
    rw [Ideal.span_le]
    rintro _ ⟨k, rfl⟩
    cases k with
    | none => exact hπw
    | some p =>
      rw [hry]
      show φ0 (Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) c') (MvPolynomial.X p)) ∈ y.asIdeal
      rw [h5 p, map_mul]
      have hc : Ideal.Quotient.mk (wcQmbtChartNoneIdeal A' n c') (MvPolynomial.C π') =
          φ0 (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c') π') := by
        have := RingHom.congr_fun h6 π'
        simp only [RingHom.comp_apply] at this
        rw [this]; rfl
      rw [hc]
      apply Ideal.mul_mem_right
      rw [hry] at hπw
      exact Ideal.mem_comap.mp hπw

  have hs3 : ∀ w : X₁, r₁ w = o → w ∉ Set.range e0 → ∃ w' : X₁, w' ⤳ w ∧ r₁ w' ≠ o ∧
      algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c') π' ∈ (r₁ w').asIdeal := by
    intro w hwo hw
    rcases h11 w with ⟨y, hy⟩ | ⟨j, y, rfl⟩
    · exact (hw ⟨y, hy⟩).elim
    have hry : ∀ y' : Spec (.of (wcQmbtChart A' n π' c' j)),
        (r₁ (e j y')).asIdeal = Ideal.comap (φ j) y'.asIdeal := by
      intro y'
      have : r₁ (e j y') = (e j ≫ r₁) y' := (Scheme.Hom.comp_apply _ _ _).symm
      rw [this, h9 j]; rfl
    have hxj : ∀ y' : Spec (.of (wcQmbtChart A' n π' c' j)),
        φ j (Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) c') (MvPolynomial.X j)) ∈ y'.asIdeal ↔
        Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j) (MvPolynomial.X (some j)) ∈ y'.asIdeal := by
      intro y'
      rw [h1 j j]
      simp [wcQmbtChartHat]
    have hs : Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j) (MvPolynomial.X none) ∈ y.asIdeal := by
      by_contra hnot
      obtain ⟨y0, hy0⟩ := wc_qmbt_hlsc_chart_overlap r₁ hr j (φ j) (h1 j) (h2 j) (h3 j) (h4 j)
        φ0 hup (e j) (h9 j) e0 h10 y hnot
      exact hw ⟨y0, hy0⟩
    have hx : Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j) (MvPolynomial.X (some j)) ∈
        y.asIdeal := by
      rw [← hxj]
      have := ho (some j)
      rw [← hwo, hry] at this
      exact Ideal.mem_comap.mp this
    obtain ⟨y'0, hle, -, hπy'0, hxy'0⟩ := wc_qmbt_hl_chart_generize π' c' j y hs hx
    obtain ⟨y', hπy', hxy', hsp⟩ : ∃ y' : Spec (.of (wcQmbtChart A' n π' c' j)),
        algebraMap A' (wcQmbtChart A' n π' c' j) π' ∈ y'.asIdeal ∧
        Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j) (MvPolynomial.X (some j)) ∉ y'.asIdeal ∧
        y' ⤳ y :=
      ⟨y'0, hπy'0, hxy'0, (PrimeSpectrum.le_iff_specializes y'0 y).mp hle⟩
    refine ⟨e j y', hsp.map (e j).continuous, ?_, ?_⟩
    · intro heo
      apply hxy'
      rw [← hxj]
      have := ho (some j)
      rw [← heo, hry] at this
      exact Ideal.mem_comap.mp this
    · rw [hry, Ideal.mem_comap]
      have := RingHom.congr_fun (h2 j) π'
      simp only [RingHom.comp_apply] at this
      rw [this]; exact hπy'

  refine ⟨φ0, e0, h5, h6, h8, h10, ?_⟩
  have hZ : ∀ z, z ∈ (fun z => (fstS ≫ r₁) z) ⁻¹' {o} ↔ r₁ (fstS z) = o := by
    intro z
    simp only [Set.mem_preimage, Set.mem_singleton_iff, Scheme.Hom.comp_apply]
  have hO : IsOpen ((fun z => fstS z) ⁻¹' Set.range e0) :=
    fstS.continuous.isOpen_preimage _ (IsOpenImmersion.isOpen_range e0)
  have hOZ : (fun z => fstS z) ⁻¹' Set.range e0 ⊆ (fun z => (fstS ≫ r₁) z) ⁻¹' {o} := by
    intro z hz
    rw [hZ]
    exact hs2 _ hz ((hs1 _).mp ⟨z, rfl⟩)
  ext z
  constructor
  · intro hz
    have hzZ : z ∈ (fun z => (fstS ≫ r₁) z) ⁻¹' {o} := by
      by_contra h
      exact hz (subset_closure h)
    by_contra hzO
    obtain ⟨w', hsp, hne, hπ⟩ := hs3 (fstS z) ((hZ z).mp hzZ) hzO
    obtain ⟨z', hz'⟩ := (hs1 w').mpr hπ
    have hsp' : fstS z' ⤳ fstS z := by rw [hz']; exact hsp
    have hz'z : z' ⤳ z := hind.specializes_iff.mp hsp'
    have hz'Z : z' ∈ ((fun z => (fstS ≫ r₁) z) ⁻¹' {o})ᶜ := by
      intro h
      apply hne
      rw [← hz']
      exact (hZ z').mp h
    exact hz (hz'z.mem_closed isClosed_closure (subset_closure hz'Z))
  · intro hz hcl
    have hdisj : Disjoint ((fun z => fstS z) ⁻¹' Set.range e0)
        ((fun z => (fstS ≫ r₁) z) ⁻¹' {o})ᶜ :=
      Set.disjoint_compl_right_iff_subset.mpr hOZ
    exact Set.disjoint_left.mp (hdisj.closure_right hO) hz hcl

theorem wc_qmbt_xspl_model_chart_none_special_fibre {A' : Type u} [CommRing A'] [IsLocalRing A']
    {π' : A'} (hπ' : IsLocalRing.maximalIdeal A' = Ideal.span {π'}) {n : ℕ}
    (c' : Matrix (Fin n) (Fin n) A') (cb : Matrix (Fin n) (Fin n) (IsLocalRing.ResidueField A'))
    (hcb : ∀ p q, cb p q = IsLocalRing.residue A' (c' p q))
    {X₁ : Scheme.{u}} (r₁ : X₁ ⟶ Spec (.of (wcQuadModelRing A' n (π' ^ 2) c')))
    (φ0 : wcQuadModelRing A' n (π' ^ 2) c' →+* wcQmbtChartNone A' n c')
    (hφ0X : ∀ p, φ0 (Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) c') (MvPolynomial.X p)) =
      Ideal.Quotient.mk (wcQmbtChartNoneIdeal A' n c') (MvPolynomial.C π' * MvPolynomial.X p))
    (hφ0A : φ0.comp (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c')) =
      algebraMap A' (wcQmbtChartNone A' n c'))
    (e0 : Spec (.of (wcQmbtChartNone A' n c')) ⟶ X₁) [IsOpenImmersion e0]
    (he0 : e0 ≫ r₁ = Spec.map (CommRingCat.ofHom φ0)) :
    ∃ (ρ : wcQuadModelRing A' n (π' ^ 2) c' →+*
        wcQuadModelRing (IsLocalRing.ResidueField A') n 1 cb)
      (eO : Spec (.of (wcQuadModelRing (IsLocalRing.ResidueField A') n 1 cb)) ≅
        (Limits.pullback.fst (r₁ ≫ Spec.map (CommRingCat.ofHom
          (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c')))) (wcQmSp A') ⁻¹ᵁ
            e0.opensRange).toScheme),
      (∀ p, ρ (Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) c') (MvPolynomial.X p)) = 0) ∧
      ρ.comp (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c')) =
        (algebraMap (IsLocalRing.ResidueField A')
          (wcQuadModelRing (IsLocalRing.ResidueField A') n 1 cb)).comp (IsLocalRing.residue A') ∧
      eO.hom ≫ (Limits.pullback.fst (r₁ ≫ Spec.map (CommRingCat.ofHom
          (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c')))) (wcQmSp A') ⁻¹ᵁ e0.opensRange).ι ≫
        Limits.pullback.fst (r₁ ≫ Spec.map (CommRingCat.ofHom
          (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c')))) (wcQmSp A') ≫ r₁ =
        Spec.map (CommRingCat.ofHom ρ) :=
by
  classical

  have hres0 : IsLocalRing.residue A' π' = 0 :=
    (IsLocalRing.residue_eq_zero_iff π').mpr (hπ' ▸ Ideal.mem_span_singleton_self π')
  have hgI : Ideal.Quotient.mk (wcQmbtChartNoneIdeal A' n c')
      (∑ p, ∑ q, MvPolynomial.C (c' p q) * MvPolynomial.X p * MvPolynomial.X q - 1) = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _)
  have hgJ : Ideal.Quotient.mk (wcQuadModelIdeal (IsLocalRing.ResidueField A') n 1 cb)
      (∑ p, ∑ q, MvPolynomial.C (cb p q) * MvPolynomial.X p * MvPolynomial.X q -
        MvPolynomial.C 1) = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _)
  have hmapg : MvPolynomial.map (IsLocalRing.residue A')
      (∑ p, ∑ q, MvPolynomial.C (c' p q) * MvPolynomial.X p * MvPolynomial.X q - 1 :
        MvPolynomial (Fin n) A') =
      ∑ p, ∑ q, MvPolynomial.C (cb p q) * MvPolynomial.X p * MvPolynomial.X q -
        MvPolynomial.C 1 := by
    simp only [map_sub, map_sum, map_mul, MvPolynomial.map_C, MvPolynomial.map_X, map_one, hcb]
  have hfI : ∀ a ∈ wcQmbtChartNoneIdeal A' n c',
      ((Ideal.Quotient.mk (wcQuadModelIdeal (IsLocalRing.ResidueField A') n 1 cb)).comp
        (MvPolynomial.map (IsLocalRing.residue A'))) a = 0 := by
    intro a ha
    obtain ⟨b, rfl⟩ := Ideal.mem_span_singleton'.mp ha
    rw [map_mul, RingHom.comp_apply, RingHom.comp_apply, hmapg, hgJ, mul_zero]

  obtain ⟨κ, hκX, hκC⟩ : ∃ κ : wcQmbtChartNone A' n c' →+*
      wcQuadModelRing (IsLocalRing.ResidueField A') n 1 cb,
      (∀ p, κ (Ideal.Quotient.mk (wcQmbtChartNoneIdeal A' n c') (MvPolynomial.X p)) =
        Ideal.Quotient.mk (wcQuadModelIdeal (IsLocalRing.ResidueField A') n 1 cb)
          (MvPolynomial.X p)) ∧
      (∀ a, κ (Ideal.Quotient.mk (wcQmbtChartNoneIdeal A' n c') (MvPolynomial.C a)) =
        Ideal.Quotient.mk (wcQuadModelIdeal (IsLocalRing.ResidueField A') n 1 cb)
          (MvPolynomial.C (IsLocalRing.residue A' a))) :=
    ⟨Ideal.Quotient.lift _ _ hfI,
      fun p => by rw [Ideal.Quotient.lift_mk, RingHom.comp_apply, MvPolynomial.map_X],
      fun a => by rw [Ideal.Quotient.lift_mk, RingHom.comp_apply, MvPolynomial.map_C]⟩
  have hC : ∀ a : A', algebraMap A' (wcQmbtChartNone A' n c') a =
      Ideal.Quotient.mk (wcQmbtChartNoneIdeal A' n c') (MvPolynomial.C a) := fun a => by
    rw [← MvPolynomial.algebraMap_eq, Ideal.Quotient.mk_algebraMap]
  have hD : ∀ r, algebraMap (IsLocalRing.ResidueField A')
      (wcQuadModelRing (IsLocalRing.ResidueField A') n 1 cb) r =
      Ideal.Quotient.mk (wcQuadModelIdeal (IsLocalRing.ResidueField A') n 1 cb)
        (MvPolynomial.C r) := fun r => by
    rw [← MvPolynomial.algebraMap_eq, Ideal.Quotient.mk_algebraMap]
  have hκA : κ.comp (algebraMap A' (wcQmbtChartNone A' n c')) =
      (algebraMap (IsLocalRing.ResidueField A')
        (wcQuadModelRing (IsLocalRing.ResidueField A') n 1 cb)).comp (IsLocalRing.residue A') := by
    refine RingHom.ext fun a => ?_
    rw [RingHom.comp_apply, RingHom.comp_apply, hC, hκC, hD]

  have hst : ∀ s : Limits.PushoutCocone
      (CommRingCat.ofHom (algebraMap A' (wcQmbtChartNone A' n c')))
      (CommRingCat.ofHom (IsLocalRing.residue A')), ∀ a : A',
      s.inl.hom (Ideal.Quotient.mk (wcQmbtChartNoneIdeal A' n c') (MvPolynomial.C a)) =
        s.inr.hom (IsLocalRing.residue A' a) := by
    intro s a
    have h := congrArg (fun h => h.hom a) s.condition
    simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply] at h
    rw [← hC]
    exact h
  have Hdesc : ∀ (T : Type u) [CommRing T] (u' : wcQmbtChartNone A' n c' →+* T)
      (v : IsLocalRing.ResidueField A' →+* T),
      (∀ a, u' (Ideal.Quotient.mk (wcQmbtChartNoneIdeal A' n c') (MvPolynomial.C a)) =
        v (IsLocalRing.residue A' a)) →
      ∀ a ∈ wcQuadModelIdeal (IsLocalRing.ResidueField A') n 1 cb,
        MvPolynomial.eval₂Hom v (fun p => u' (Ideal.Quotient.mk (wcQmbtChartNoneIdeal A' n c')
          (MvPolynomial.X p))) a = 0 := by
    intro T _ u' v huv a ha
    obtain ⟨b, rfl⟩ := Ideal.mem_span_singleton'.mp ha
    have key : MvPolynomial.eval₂Hom v (fun p => u' (Ideal.Quotient.mk
          (wcQmbtChartNoneIdeal A' n c') (MvPolynomial.X p)))
        (∑ p, ∑ q, MvPolynomial.C (cb p q) * MvPolynomial.X p * MvPolynomial.X q -
          MvPolynomial.C 1) =
        u' (Ideal.Quotient.mk (wcQmbtChartNoneIdeal A' n c')
          (∑ p, ∑ q, MvPolynomial.C (c' p q) * MvPolynomial.X p * MvPolynomial.X q - 1)) := by
      simp only [map_sub, map_sum, map_mul, MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_X',
        map_one, hcb, huv]
    rw [map_mul, key, hgI, map_zero, mul_zero]

  have hPO : IsPushout (CommRingCat.ofHom (algebraMap A' (wcQmbtChartNone A' n c')))
      (CommRingCat.ofHom (IsLocalRing.residue A')) (CommRingCat.ofHom κ)
      (CommRingCat.ofHom (algebraMap (IsLocalRing.ResidueField A')
        (wcQuadModelRing (IsLocalRing.ResidueField A') n 1 cb))) := by
    have heq : CommRingCat.ofHom (algebraMap A' (wcQmbtChartNone A' n c')) ≫
        CommRingCat.ofHom κ =
        CommRingCat.ofHom (IsLocalRing.residue A') ≫
          CommRingCat.ofHom (algebraMap (IsLocalRing.ResidueField A')
            (wcQuadModelRing (IsLocalRing.ResidueField A') n 1 cb)) := by
      rw [← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp, hκA]
    refine IsPushout.of_isColimit (Limits.PushoutCocone.IsColimit.mk heq
      (fun s => CommRingCat.ofHom (Ideal.Quotient.lift _
        (MvPolynomial.eval₂Hom s.inr.hom (fun p => s.inl.hom
          (Ideal.Quotient.mk (wcQmbtChartNoneIdeal A' n c') (MvPolynomial.X p))))
        (Hdesc s.pt s.inl.hom s.inr.hom (hst s)))) ?_ ?_ ?_)
    · intro s
      apply CommRingCat.hom_ext
      apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext
      · intro a
        simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply, hκC,
          Ideal.Quotient.lift_mk, MvPolynomial.eval₂Hom_C, hst]
      · intro p
        simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply, hκX,
          Ideal.Quotient.lift_mk, MvPolynomial.eval₂Hom_X']
    · intro s
      apply CommRingCat.hom_ext
      refine RingHom.ext fun r => ?_
      simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply, hD,
        Ideal.Quotient.lift_mk, MvPolynomial.eval₂Hom_C]
    · intro s m h1 h2
      apply CommRingCat.hom_ext
      apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext
      · intro r
        have h := congrArg (fun h => h.hom r) h2
        simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply, hD] at h
        simp only [CommRingCat.hom_ofHom, RingHom.comp_apply, Ideal.Quotient.lift_mk,
          MvPolynomial.eval₂Hom_C]
        exact h
      · intro p
        have h := congrArg (fun h => h.hom
          (Ideal.Quotient.mk (wcQmbtChartNoneIdeal A' n c') (MvPolynomial.X p))) h1
        simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply, hκX] at h
        simp only [CommRingCat.hom_ofHom, RingHom.comp_apply, Ideal.Quotient.lift_mk,
          MvPolynomial.eval₂Hom_X']
        exact h

  have hSq := isPullback_SpecMap_of_isPushout _ _ _ _ hPO

  have hf : e0 ≫ (r₁ ≫ Spec.map (CommRingCat.ofHom
      (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c')))) =
      Spec.map (CommRingCat.ofHom (algebraMap A' (wcQmbtChartNone A' n c'))) := by
    rw [← Category.assoc, he0, ← Spec.map_comp, ← CommRingCat.ofHom_comp, hφ0A]
  have h1 := isPullback_morphismRestrict (Limits.pullback.fst (r₁ ≫ Spec.map (CommRingCat.ofHom
      (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c')))) (wcQmSp A')) e0.opensRange
  have h2 := IsPullback.of_hasPullback (r₁ ≫ Spec.map (CommRingCat.ofHom
      (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c')))) (wcQmSp A')
  have h3 := h1.paste_vert h2
  have hinv : e0.isoOpensRange.inv ≫ e0 ≫ (r₁ ≫ Spec.map (CommRingCat.ofHom
      (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c')))) =
      e0.opensRange.ι ≫ (r₁ ≫ Spec.map (CommRingCat.ofHom
      (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c')))) := by
    rw [← Category.assoc, Scheme.Hom.isoOpensRange_inv_comp]
  have hG := IsPullback.of_iso h3 (Iso.refl _) e0.isoOpensRange.symm (Iso.refl _) (Iso.refl _)
    (fst' := (Limits.pullback.fst (r₁ ≫ Spec.map (CommRingCat.ofHom
      (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c')))) (wcQmSp A') ∣_ e0.opensRange) ≫
        e0.isoOpensRange.inv)
    (snd' := (Limits.pullback.fst (r₁ ≫ Spec.map (CommRingCat.ofHom
      (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c')))) (wcQmSp A') ⁻¹ᵁ e0.opensRange).ι ≫
        Limits.pullback.snd (r₁ ≫ Spec.map (CommRingCat.ofHom
      (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c')))) (wcQmSp A'))
    (f' := Spec.map (CommRingCat.ofHom (algebraMap A' (wcQmbtChartNone A' n c'))))
    (g' := wcQmSp A')
    (by simp) (by simp) (by rw [Iso.refl_hom, Category.comp_id, Iso.symm_hom, ← hf, hinv]) (by simp)
  have hι : (Limits.pullback.fst (r₁ ≫ Spec.map (CommRingCat.ofHom
      (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c')))) (wcQmSp A') ⁻¹ᵁ e0.opensRange).ι ≫
      Limits.pullback.fst (r₁ ≫ Spec.map (CommRingCat.ofHom
        (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c')))) (wcQmSp A') =
      ((Limits.pullback.fst (r₁ ≫ Spec.map (CommRingCat.ofHom
        (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c')))) (wcQmSp A') ∣_ e0.opensRange) ≫
        e0.isoOpensRange.inv) ≫ e0 := by
    rw [Category.assoc, Scheme.Hom.isoOpensRange_inv_comp, morphismRestrict_ι]
  have hF := IsPullback.isoIsPullback_hom_fst _ _ hSq hG
  refine ⟨κ.comp φ0, IsPullback.isoIsPullback _ _ hSq hG, ?_, ?_, ?_⟩
  · intro p
    rw [RingHom.comp_apply, hφ0X]
    simp only [map_mul, hκC, hκX, hres0, map_zero, zero_mul]
  · rw [RingHom.comp_assoc, hφ0A, hκA]
  · rw [reassoc_of% hι, he0, reassoc_of% hF, ← Spec.map_comp, ← CommRingCat.ofHom_comp]

theorem wc_qmbt_xspl_shens_closed_fibre_pushout {A : Type u} [CommRing A] [IsDomain A]
    [IsDiscreteValuationRing A] [IsSepClosed (IsLocalRing.ResidueField A)] {n : ℕ} {π : A}
    {c : Matrix (Fin n) (Fin n) A} (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π})
    {x₀ : Spec (.of (wcQuadModelRing A n π c))}
    (hx₀ : ∀ p, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
      PrimeSpectrum.asIdeal x₀)
    {B₀ : Type u} [CommRing B₀] [HenselianLocalRing B₀] [IsSepClosed (IsLocalRing.ResidueField B₀)]
    {Λ₀ : Type u} [SmallCategory Λ₀] [IsCofiltered Λ₀]
    {W₀ : Λ₀ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (wcQuadModelRing A n π c))) x₀))
      (Scheme.Etale.forget (Spec (.of (wcQuadModelRing A n π c))))}
    {φ₀ : ∀ l, Spec (.of B₀) ⟶ (W₀.obj l).right.left}
    {a₀ : Spec (.of B₀) ⟶ Spec (.of (wcQuadModelRing A n π c))}
    (hsh : wcHalShData x₀ B₀ Λ₀ W₀ φ₀ a₀)
    {A' : Type u} [CommRing A'] [IsDomain A'] [IsDiscreteValuationRing A'] {ιA : A →+* A'}
    {π' : A'} (hπ' : IsLocalRing.maximalIdeal A' = Ideal.span {π'}) (hπ'2 : π' ^ 2 = ιA π)
    (hgen : ∀ a' : A', ∃ x y : A, a' = ιA x + ιA y * π')
    (D : Type u) [CommRing D] (ψD : wcQuadModelRing A n π c →+* D)
    (κD : IsLocalRing.ResidueField A' →+* D)
    (hψX : ∀ p, ψD (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p)) = 0)
    (hψA : ∀ a : A, ψD (algebraMap A (wcQuadModelRing A n π c) a) =
      κD (IsLocalRing.residue A' (ιA a))) :
    ∃ τ : B₀ →+* D, τ.comp (Spec.preimage a₀).hom = ψD ∧
      IsPullback (𝟙 (Spec (.of D))) (Spec.map (CommRingCat.ofHom τ))
        (Spec.map (CommRingCat.ofHom ψD)) a₀ :=
by
  classical
  obtain ⟨σ, hσ⟩ := wc_qmbt_qm_residue_equiv hπ hx₀ hsh hπ' hπ'2 hgen
  have hmax := (wc_qmbt_ecc_shens_maximal hπ hx₀ hsh).2.1
  let τ : B₀ →+* D := κD.comp ((σ.symm : IsLocalRing.ResidueField B₀ →+*
    IsLocalRing.ResidueField A').comp (IsLocalRing.residue B₀))
  have hτ : ∀ b, τ b = κD (σ.symm (IsLocalRing.residue B₀ b)) := fun b => rfl
  have F1 : ∀ p, (Spec.preimage a₀).hom
      (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p)) ∈
      IsLocalRing.maximalIdeal B₀ := by
    intro p
    rw [hmax]
    exact Ideal.subset_span ⟨p, rfl⟩
  have F2 : IsLocalRing.residue A' π' = 0 := by
    rw [IsLocalRing.residue_eq_zero_iff, hπ']
    exact Ideal.mem_span_singleton_self π'
  have F3 : ∀ b : B₀, ∃ x : A,
      b - (Spec.preimage a₀).hom (algebraMap A (wcQuadModelRing A n π c) x) ∈
        IsLocalRing.maximalIdeal B₀ ∧
      σ.symm (IsLocalRing.residue B₀ b) = IsLocalRing.residue A' (ιA x) := by
    intro b
    obtain ⟨a', ha'⟩ := IsLocalRing.residue_surjective (σ.symm (IsLocalRing.residue B₀ b))
    obtain ⟨x, y, hxy⟩ := hgen a'
    have e1 : IsLocalRing.residue A' a' = IsLocalRing.residue A' (ιA x) := by
      rw [hxy, map_add, map_mul, F2, mul_zero, add_zero]
    refine ⟨x, ?_, by rw [← ha', e1]⟩
    rw [← IsLocalRing.residue_eq_zero_iff, map_sub, ← hσ x, ← e1, ha',
      RingEquiv.apply_symm_apply, sub_self]
  have hcomm : τ.comp (Spec.preimage a₀).hom = ψD := by
    apply Ideal.Quotient.ringHom_ext
    apply MvPolynomial.ringHom_ext
    · intro r
      have e : Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.C r) =
          algebraMap A (wcQuadModelRing A n π c) r := rfl
      simp only [RingHom.comp_apply]
      rw [e, hτ, ← hσ r, RingEquiv.symm_apply_apply, hψA]
    · intro p
      simp only [RingHom.comp_apply]
      rw [hτ, (IsLocalRing.residue_eq_zero_iff _).mpr (F1 p), map_zero, map_zero, hψX]
  have heq : CommRingCat.ofHom ψD ≫ 𝟙 (CommRingCat.of D) =
      CommRingCat.ofHom (Spec.preimage a₀).hom ≫ CommRingCat.ofHom τ := by
    rw [Category.comp_id, ← CommRingCat.ofHom_comp, hcomm]
  have hpo : IsPushout (CommRingCat.ofHom ψD) (CommRingCat.ofHom (Spec.preimage a₀).hom)
      (𝟙 (CommRingCat.of D)) (CommRingCat.ofHom τ) := by
    refine IsPushout.of_isColimit (c := Limits.PushoutCocone.mk _ _ heq) ?_
    refine Limits.PushoutCocone.IsColimit.mk heq (fun s => s.inl) (fun s => Category.id_comp _)
      ?_ ?_
    · intro s
      have hC : ∀ r, s.inl.hom (ψD r) = s.inr.hom ((Spec.preimage a₀).hom r) := by
        intro r
        exact congrArg (fun f => f.hom r) s.condition
      have hK : ∀ m ∈ IsLocalRing.maximalIdeal B₀, s.inr.hom m = 0 := by
        intro m hm
        rw [hmax] at hm
        have hle : Ideal.span (Set.range fun p : Fin n =>
            (Spec.preimage a₀).hom (Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
              (MvPolynomial.X p))) ≤ RingHom.ker s.inr.hom := by
          rw [Ideal.span_le]
          rintro _ ⟨p, rfl⟩
          rw [SetLike.mem_coe, RingHom.mem_ker, ← hC, hψX, map_zero]
        exact hle hm
      ext b
      obtain ⟨x, hx1, hx2⟩ := F3 b
      have e := hK _ hx1
      rw [map_sub, sub_eq_zero] at e
      show s.inl.hom (τ b) = s.inr.hom b
      rw [e, ← hC, hψA, hτ, hx2]
    · intro s m h1 _
      exact (Category.id_comp m).symm.trans h1
  refine ⟨τ, hcomm, ?_⟩
  have hpb : IsPullback (Spec.map (𝟙 (CommRingCat.of D))) (Spec.map (CommRingCat.ofHom τ))
      (Spec.map (CommRingCat.ofHom ψD)) (Spec.map (CommRingCat.ofHom (Spec.preimage a₀).hom)) :=
    isPullback_SpecMap_of_isPushout _ _ _ _ hpo
  have hA : Spec.map (CommRingCat.ofHom (Spec.preimage a₀).hom) = a₀ := by
    rw [CommRingCat.ofHom_hom, Spec.map_preimage]
  rw [Spec.map_id, hA] at hpb
  exact hpb

theorem wc_qmbt_xspl_exc_open_quadric_iso {A : Type u} [CommRing A] [IsDomain A]
    [IsDiscreteValuationRing A]
    [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (hℓ : IsUnit ((ℓ : ℕ) : A)) {n : ℕ} (hn : Even n) (hn4 : 4 ≤ n) {π : A}
    {c : Matrix (Fin n) (Fin n) A}
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π}) (hc : IsUnit (c + c.transpose).det)
    {x₀ : Spec (.of (wcQuadModelRing A n π c))}
    (hx₀ : ∀ p, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
      PrimeSpectrum.asIdeal x₀)
    {B₀ : Type u} [CommRing B₀] [HenselianLocalRing B₀] [IsSepClosed (IsLocalRing.ResidueField B₀)]
    {Λ₀ : Type u} [SmallCategory Λ₀] [IsCofiltered Λ₀]
    {W₀ : Λ₀ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (wcQuadModelRing A n π c))) x₀))
      (Scheme.Etale.forget (Spec (.of (wcQuadModelRing A n π c))))}
    {φ₀ : ∀ l, Spec (.of B₀) ⟶ (W₀.obj l).right.left}
    {a₀ : Spec (.of B₀) ⟶ Spec (.of (wcQuadModelRing A n π c))}
    (hsh : wcHalShData x₀ B₀ Λ₀ W₀ φ₀ a₀)
    {Xs : Scheme.{u}} {ι : Xs ⟶ Spec (.of B₀)} {s : Xs ⟶ Spec (.of (IsLocalRing.ResidueField A))}
    (hps : IsPullback ι s (a₀ ≫ wcQuadModelStr A n π c) (wcQmSp A))
    {A' : Type u} [CommRing A'] [IsDomain A'] [IsDiscreteValuationRing A'] [HenselianLocalRing A']
    [IsSepClosed (IsLocalRing.ResidueField A')] {ιA : A →+* A'} {π' : A'}
    (hℓ' : IsUnit ((ℓ : ℕ) : A')) (hπ' : IsLocalRing.maximalIdeal A' = Ideal.span {π'})
    (hπ'2 : π' ^ 2 = ιA π) (hgen : ∀ a' : A', ∃ x y : A, a' = ιA x + ιA y * π')
    {L' : Type u} [Field L'] [IsSepClosed L'] {φ' : A' →+* L'} (hφ' : Function.Injective φ')
    (halg' : letI := φ'.toAlgebra; Algebra.IsAlgebraic A' L')
    {Xm : Scheme.{u}} {f : Xm ⟶ Spec (.of A')}
    {bl : Xm ⟶ Limits.pullback (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))}
    (hbl : wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range
      (fun i : Option (Fin n) => Option.elim i
        ((Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of A')).inv.hom π'))
        (fun j => ((Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))) ≫ a₀).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A n π c))).inv.hom
            (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X j)))))))) bl)
    (hblf : bl ≫ Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA)) = f)
    {XE' : Scheme.{u}} {p' : XE' ⟶ Xm} {q' : XE' ⟶ Spec (.of L')}
    (hpb' : IsPullback p' q' f (Spec.map (CommRingCat.ofHom φ')))
    {Xs' : Scheme.{u}} {ι' : Xs' ⟶ Xm} {s' : Xs' ⟶ Spec (.of (IsLocalRing.ResidueField A'))}
    (hps' : IsPullback ι' s' f (wcQmSp A'))
    (Wo : Xs'.Opens)
    (hWo : (Wo : Set ↥Xs') = (closure ((fun z => (ι' ≫ bl ≫ Limits.pullback.fst
      (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))) z) ⁻¹'
        {IsLocalRing.closedPoint B₀})ᶜ)ᶜ) :
    Nonempty (Wo.toScheme ≅ Spec (.of (wcQuadModelRing (IsLocalRing.ResidueField A') n 1
      (c.map (fun a => IsLocalRing.residue A' (ιA a)))))) :=
by
  classical

  have s1 : ∀ {X Y : Type u} [TopologicalSpace X] [TopologicalSpace Y] [QuasiSober Y]
      [TopologicalSpace.NoetherianSpace Y] {h : X → Y}, Continuous h → GeneralizingMap h →
      ∀ {O : Set Y}, IsOpen O → closure (h ⁻¹' O) = h ⁻¹' closure O := by
    intro X Y _ _ _ _ h hc hg O hO
    apply subset_antisymm (hc.closure_preimage_subset O)
    intro x hx
    obtain ⟨S, hSirr, hSeq⟩ := TopologicalSpace.NoetherianSpace.exists_finset_irreducible
      (⟨closure O, isClosed_closure⟩ : TopologicalSpace.Closeds Y)
    have hmemT : ∀ (T : Finset (TopologicalSpace.Closeds Y)) (z : Y),
        z ∈ ((T.sup id : TopologicalSpace.Closeds Y) : Set Y) ↔ ∃ k ∈ T, z ∈ (k : Set Y) := by
      intro T z
      induction T using Finset.induction_on with
      | empty => simp
      | insert a T haT ih =>
        rw [Finset.sup_insert, TopologicalSpace.Closeds.coe_sup, Set.mem_union, ih]
        simp
    have hmem : ∀ z, z ∈ closure O ↔ ∃ k ∈ S, z ∈ (k : Set Y) := by
      intro z
      rw [← hmemT S z, ← hSeq]
      rfl
    set S' := S.filter (fun k : TopologicalSpace.Closeds Y => ((k : Set Y) ∩ O).Nonempty)
      with hS'
    have hcl : IsClosed (⋃ (k : TopologicalSpace.Closeds Y) (_ : k ∈ S'), (k : Set Y)) :=
      isClosed_biUnion_finset (fun k _ => k.isClosed)
    have hsub : O ⊆ ⋃ (k : TopologicalSpace.Closeds Y) (_ : k ∈ S'), (k : Set Y) := by
      intro z hz
      obtain ⟨k, hk, hzk⟩ := (hmem z).mp (subset_closure hz)
      exact Set.mem_biUnion (Finset.mem_filter.mpr ⟨hk, ⟨z, hzk, hz⟩⟩) hzk
    have hy := closure_minimal hsub hcl hx
    obtain ⟨k, hk, hyk⟩ := Set.mem_iUnion₂.mp hy
    obtain ⟨hkS, hkO⟩ := Finset.mem_filter.mp hk
    obtain ⟨η, hη⟩ := QuasiSober.sober (hSirr ⟨k, hkS⟩) k.isClosed
    have hηO : η ∈ O := (hη.mem_open_set_iff hO).mpr hkO
    have hηy : η ⤳ h x := hη.specializes hyk
    obtain ⟨x', hx'x, hx'η⟩ := hg hηy
    have hx'O : x' ∈ h ⁻¹' O := by
      show h x' ∈ O
      rw [hx'η]; exact hηO
    exact hx'x.mem_closed isClosed_closure (subset_closure hx'O)

  have s5 : ∀ {X Y S Bs T : Scheme.{u}} {h : X ⟶ Y} {β : X ⟶ Bs}
      {g : Y ⟶ S} {a : Bs ⟶ S}, IsPullback h β g a → ∀ (O : Y.Opens) (eO : T ≅ O.toScheme)
      (τ : T ⟶ Bs), IsPullback (𝟙 T) τ (eO.hom ≫ O.ι ≫ g) a →
      Nonempty ((h ⁻¹ᵁ O).toScheme ≅ T) := by
    intro X Y S Bs T h β g a hP O eO τ hτ
    have h1 := isPullback_morphismRestrict h O
    have h2 := IsPullback.paste_vert h1 hP
    have h3 : IsPullback (h ∣_ O ≫ eO.inv) ((h ⁻¹ᵁ O).ι ≫ β) (eO.hom ≫ O.ι ≫ g) a :=
      IsPullback.of_iso h2 (Iso.refl _) eO.symm (Iso.refl _) (Iso.refl _)
        (by simp) (by simp) (by simp) (by simp)
    exact ⟨IsPullback.isoIsPullback _ _ h3 hτ⟩

  obtain ⟨θ, X₁, r₁, ψ, hθX, hθA, hr₁, hsq, hψ, hnoeth⟩ :=
    wc_qmbt_qm_model_square_ext hsh hπ'2 hbl

  obtain ⟨o, ho, hθo⟩ := wc_qmbt_hlsc_theta_fibre hπ hx₀ hπ' hπ'2 θ hθX hθA

  have hcond : (ι' ≫ ψ) ≫ (r₁ ≫ Spec.map (CommRingCat.ofHom
      (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA))))) = s' ≫ wcQmSp A' := by
    simp only [Category.assoc]
    rw [hψ, hblf]
    exact hps'.w
  obtain ⟨h, hh1, hh2⟩ : ∃ h : Xs' ⟶ Limits.pullback (r₁ ≫ Spec.map (CommRingCat.ofHom
      (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA))))) (wcQmSp A'),
      h ≫ Limits.pullback.fst _ _ = ι' ≫ ψ ∧ h ≫ Limits.pullback.snd _ _ = s' :=
    ⟨Limits.pullback.lift (ι' ≫ ψ) s' hcond, Limits.pullback.lift_fst _ _ _,
      Limits.pullback.lift_snd _ _ _⟩
  have hout : IsPullback ι' (h ≫ Limits.pullback.snd _ _)
      (ψ ≫ r₁ ≫ Spec.map (CommRingCat.ofHom
        (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA))))) (wcQmSp A') := by
    rw [hh2, hψ, hblf]
    exact hps'
  have htop : IsPullback ι' h ψ (Limits.pullback.fst _ _) :=
    IsPullback.of_bot hout hh1.symm (IsPullback.of_hasPullback _ _)
  have hP := IsPullback.paste_vert htop.flip hsq

  haveI : WeaklyEtale a₀ := wc_shdata_weaklyEtale x₀ B₀ Λ₀ W₀ φ₀ a₀ hsh
  haveI : Flat h := MorphismProperty.of_isPullback (P := @Flat) hP.flip
    (inferInstance : Flat a₀)
  have hgenh : GeneralizingMap h := Flat.generalizingMap h
  haveI := hnoeth

  have hs₀ : IsClosed ({x₀} : Set (Spec (.of (wcQuadModelRing A n π c)))) := by
    have hmax := wc_qmbt_bm_origin_maximal hπ n c
    have hle : Ideal.span (Set.range fun p : Fin n =>
        Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p)) ≤ x₀.asIdeal :=
      Ideal.span_le.mpr (by rintro _ ⟨p, rfl⟩; exact hx₀ p)
    have heq := hmax.eq_of_le x₀.isPrime.ne_top hle
    have hm : x₀.asIdeal.IsMaximal := heq ▸ hmax
    exact (PrimeSpectrum.isClosed_singleton_iff_isMaximal x₀).mpr hm
  obtain ⟨hx1, hx2, -⟩ := wc_qmbt_hlsc_x0_fibre hπ hx₀ hsh
  have ha : ∀ b, a₀ b = x₀ ↔ b = IsLocalRing.closedPoint B₀ :=
    fun b => ⟨hx2 b, fun e => e ▸ hx1⟩

  obtain ⟨φ0, e0, hφ0X, hφ0A, he0, he0r, hint⟩ :=
    wc_qmbt_xspl_model_interior_chart_none hπ' (c.map ιA) hr₁ ho
  haveI := he0

  have hGcl : IsClosed ((fun z => (Limits.pullback.fst (r₁ ≫ Spec.map (CommRingCat.ofHom
      (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA))))) (wcQmSp A') ≫ r₁) z) ⁻¹'
        {o}) := by
    have hpre : (fun z => (Limits.pullback.fst (r₁ ≫ Spec.map (CommRingCat.ofHom
        (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA))))) (wcQmSp A') ≫ r₁ ≫
          Spec.map (CommRingCat.ofHom θ)) z) ⁻¹' {x₀} =
        (fun z => (Limits.pullback.fst (r₁ ≫ Spec.map (CommRingCat.ofHom
        (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA))))) (wcQmSp A') ≫ r₁) z) ⁻¹'
          {o} := by
      ext z
      simp only [Set.mem_preimage, Set.mem_singleton_iff, Scheme.Hom.comp_apply]
      exact hθo _
    rw [← hpre]
    exact hs₀.preimage (Scheme.Hom.continuous _)
  have hβ : (fun z => (ι' ≫ bl ≫ Limits.pullback.fst
      (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))) z) ⁻¹'
        {IsLocalRing.closedPoint B₀} =
      h ⁻¹' ((fun z => (Limits.pullback.fst (r₁ ≫ Spec.map (CommRingCat.ofHom
      (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA))))) (wcQmSp A') ≫ r₁) z) ⁻¹'
        {o}) := by
    have hw := hP.w
    have e : ∀ y, ((ι' ≫ bl ≫ Limits.pullback.fst
        (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))) ≫ a₀) y =
        (h ≫ Limits.pullback.fst (r₁ ≫ Spec.map (CommRingCat.ofHom
          (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA))))) (wcQmSp A') ≫ r₁ ≫
          Spec.map (CommRingCat.ofHom θ)) y := fun y => by rw [hw]
    simp only [Scheme.Hom.comp_apply] at e
    ext y
    show (ι' ≫ bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
        (Spec.map (CommRingCat.ofHom ιA))) y = IsLocalRing.closedPoint B₀ ↔
      (Limits.pullback.fst (r₁ ≫ Spec.map (CommRingCat.ofHom
        (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA))))) (wcQmSp A') ≫ r₁) (h y) = o
    simp only [Scheme.Hom.comp_apply]
    rw [← hθo, ← e]
    exact (ha _).symm
  have hset : (closure ((fun z => (ι' ≫ bl ≫ Limits.pullback.fst
      (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))) z) ⁻¹'
        {IsLocalRing.closedPoint B₀})ᶜ)ᶜ =
      h ⁻¹' ((fun z => (Limits.pullback.fst (r₁ ≫ Spec.map (CommRingCat.ofHom
        (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA))))) (wcQmSp A')) z) ⁻¹'
          Set.range e0) := by
    rw [hβ, ← Set.preimage_compl, s1 h.continuous hgenh hGcl.isOpen_compl,
      ← Set.preimage_compl, hint]
  have hWeq : Wo = h ⁻¹ᵁ (Limits.pullback.fst (r₁ ≫ Spec.map (CommRingCat.ofHom
      (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA))))) (wcQmSp A') ⁻¹ᵁ
        e0.opensRange) := by
    apply TopologicalSpace.Opens.ext
