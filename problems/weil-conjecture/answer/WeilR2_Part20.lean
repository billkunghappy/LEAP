  obtain ⟨ERO, hERO⟩ := wc_int_rat_data_exists O'.toScheme ℓ

  have hnat := hN (Limits.pullback.fst U0.ι iY') E0 (U0.toScheme.basicOpen s0) Dw0 pre0
    iT' DT' O' DwO pre' k'' fO hfO Dk' hDk' γ' hγ' DfO hDfO
