    (Dv : wcHMPullData V.hom ℓ) (hDv : wcHMPullCanonical Dv)
    (DV : wcHMPullData (Limits.pullback.fst V.hom iY) ℓ) (hDV : wcHMPullCanonical DV)
    (hepi : Epi (wcSuppUnitMap DV))
    (H0 : ∀ z : V.left, IsClosed ({z} : Set V.left) →
      ∃ (Ez : wcHMPullData (V.left.fromSpecStalk z) ℓ) (_ : wcHMPullCanonical Ez)
        (Dz : wcHMPullData (Limits.pullback.fst (V.left.fromSpecStalk z)
          (Limits.pullback.fst V.hom iY)) ℓ) (_ : wcHMPullCanonical Dz)
        (γz : wcSuppObj Dz ⟶ Ez.Φ.obj (wcSuppObj DV)),
        wcSuppUnitMap Dz ≫ γz = Ez.μ.inv ≫ Ez.Φ.map (wcSuppUnitMap DV) ∧
        Epi (wcSuppUnitMap Dz))
    (y : letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf V.left ℓ)) := HasExt.standard _
      letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf ((𝟭 Scheme).obj V.left) ℓ)) :=
        HasExt.standard _
      Abelian.Ext (wcSuppObj DV) (Dv.Φ.obj (wcSuppObj E₁)) 2)
    (hy : ∀ z : V.left, IsClosed ({z} : Set V.left) →
      z ∈ Set.range ⇑(Limits.pullback.fst V.hom iY) →
      ∀ (Ez : wcHMPullData (V.left.fromSpecStalk z) ℓ) (_ : wcHMPullCanonical Ez)
        (Dz : wcHMPullData (Limits.pullback.fst (V.left.fromSpecStalk z)
          (Limits.pullback.fst V.hom iY)) ℓ) (_ : wcHMPullCanonical Dz)
        (γz : wcSuppObj Dz ⟶ Ez.Φ.obj (wcSuppObj DV)),
        wcSuppUnitMap Dz ≫ γz = Ez.μ.inv ≫ Ez.Φ.map (wcSuppUnitMap DV) →
        Epi (wcSuppUnitMap Dz) →
        letI : HasExt (SheafOfModules.{u+1}
          (wcRingSheaf (Spec (V.left.presheaf.stalk z)) ℓ)) := HasExt.standard _
        (Abelian.Ext.mk₀ γz).comp (wcPullExtGen Ez 2 y) (zero_add _) = 0) :
    y = 0 :=
by
  classical

  let O : V.left.Opens := ⟨(Set.range ⇑(Limits.pullback.fst V.hom iY))ᶜ,
    (Limits.pullback.fst V.hom iY).isClosedEmbedding.isClosed_range.isOpen_compl⟩

  obtain ⟨Do, hDo, α, hα0, hαz⟩ := wc_qmbt_xsp_ess_D1l_Y_chart_boundary_transfer hℓ hn hn4 hπ hc
    hx₀ hsh hps hℓ' hπ' hπ'2 hgen hφ' halg' hbl hblf hpb' hps' hβ Dβ hDβ Dp' hDp' Di' hDi' I'
    i₁ i₂ iY h₁ h₂ hY E₁ hE₁ E₂ hE₂ EY hEY ρ₁ ρ₂ hz hS V h1 h2 h3 h4 h5 Dv hDv DV hDV hepi H0
    y hy O rfl

  let O₁ : (Limits.pullback V.hom i₁).Opens :=
    ⟨(Limits.pullback.fst V.hom i₁) ⁻¹' (O : Set ↥V.left),
      O.isOpen.preimage (Limits.pullback.fst V.hom i₁).continuous⟩

  obtain ⟨hcpt, α', hα'0, hα'z⟩ := wc_qmbt_xsp_ess_D1l_Y_chart_punct_coeff_transfer hℓ hn hn4 hπ
    hc hx₀ hsh hps hℓ' hπ' hπ'2 hgen hφ' halg' hbl hblf hpb' hps' hβ Dβ hDβ Dp' hDp' Di' hDi' I'
    i₁ i₂ iY h₁ h₂ hY E₁ hE₁ E₂ hE₂ EY hEY ρ₁ ρ₂ hz hS V h1 h2 h3 h4 h5 Dv hDv DV hDV hepi
    O rfl Do hDo α hαz O₁ rfl

  have hce : Topology.IsClosedEmbedding (Limits.pullback.fst V.hom i₁) :=
    (Limits.pullback.fst V.hom i₁).isClosedEmbedding
  have hcl : ∀ x : ↥(Limits.pullback V.hom i₁),
      IsClosed ({x} : Set ↥(Limits.pullback V.hom i₁)) ↔
        IsClosed ({(Limits.pullback.fst V.hom i₁) x} : Set V.left) := by
    intro x
    rw [hce.isClosed_iff_image_isClosed, Set.image_singleton]
  have haff₁ : IsAffine (Limits.pullback V.hom i₁) := by
    haveI : IsAffine V.left := h1
    haveI : IsAffine ((𝟭 Scheme).obj V.left) := h1
    exact isAffine_of_isAffineHom (Limits.pullback.fst V.hom i₁)
  have hc₁ : IsClosed {x : ↥(Limits.pullback V.hom i₁) |
      IsClosed ({x} : Set ↥(Limits.pullback V.hom i₁))} := by
    have hset : {x : ↥(Limits.pullback V.hom i₁) |
        IsClosed ({x} : Set ↥(Limits.pullback V.hom i₁))} =
        (Limits.pullback.fst V.hom i₁) ⁻¹' {x : V.left | IsClosed ({x} : Set V.left)} := by
      ext x
      exact hcl x
    rw [hset]
    exact h2.preimage (Limits.pullback.fst V.hom i₁).continuous
  have hu₁ : ∀ x : ↥(Limits.pullback V.hom i₁), ∃! y : ↥(Limits.pullback V.hom i₁),
      IsClosed ({y} : Set ↥(Limits.pullback V.hom i₁)) ∧ x ⤳ y := by
    intro x
    obtain ⟨w, ⟨hwc, hxw⟩, huniq⟩ := h3 ((Limits.pullback.fst V.hom i₁) x)
    obtain ⟨w', rfl⟩ : w ∈ Set.range ⇑(Limits.pullback.fst V.hom i₁) :=
      hxw.mem_closed hce.isClosed_range ⟨x, rfl⟩
    refine ⟨w', ⟨(hcl w').mpr hwc, hce.isInducing.specializes_iff.mp hxw⟩, ?_⟩
    rintro v ⟨hvc, hxv⟩
    apply hce.injective
    exact huniq _ ⟨(hcl v).mp hvc, hxv.map (Limits.pullback.fst V.hom i₁).continuous⟩

  exact hα0 (hα'0 (wc_wlocal_open_deg1_ladic_separation haff₁ hc₁ hu₁ O₁ hcpt ℓ α' hα'z))

theorem wc_closed_stalk_strictly_henselian {X Y : Scheme.{u}} (p : Y ⟶ X) [IsClosedImmersion p]
    (y : Y) (hX : HenselianLocalRing (X.presheaf.stalk (p y)))
    (hXs : IsSepClosed (X.residueField (p y))) :
    HenselianLocalRing (Y.presheaf.stalk y) ∧ IsSepClosed (Y.residueField y) :=
by
  classical
  have henselOfSurj : ∀ {R S : Type u} [CommRing R] [CommRing S] [HenselianLocalRing R]
      [IsLocalRing S] (f : R →+* S), Function.Surjective f → HenselianLocalRing S := by
    intro R S _ _ _ _ f hf
    haveI : IsLocalHom f := hf.isLocalHom f
    refine { is_henselian := ?_ }
    intro g hg a₀ h₁ h₂
    obtain ⟨G, hGmap, -, hGmon⟩ :=
      Polynomial.lifts_and_natDegree_eq_and_monic (Polynomial.map_surjective f hf g) hg
    obtain ⟨b₀, rfl⟩ := hf a₀
    have e1 : f (G.eval b₀) = g.eval (f b₀) := by rw [← hGmap, Polynomial.eval_map_apply]
    have e2 : f ((Polynomial.derivative G).eval b₀) = (Polynomial.derivative g).eval (f b₀) := by
      rw [← hGmap, Polynomial.derivative_map, Polynomial.eval_map_apply]
    have hb1 : G.eval b₀ ∈ IsLocalRing.maximalIdeal R := by
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      intro hu
      have hu' := hu.map f
      rw [e1] at hu'
      exact ((IsLocalRing.mem_maximalIdeal _).mp h₁) hu'
    have hb2 : IsUnit ((Polynomial.derivative G).eval b₀) := by
      apply isUnit_of_map_unit f
      rw [e2]; exact h₂
    obtain ⟨b, hbroot, hbm⟩ := HenselianLocalRing.is_henselian G hGmon b₀ hb1 hb2
    refine ⟨f b, ?_, ?_⟩
    · show Polynomial.eval (f b) g = 0
      rw [← hGmap, Polynomial.eval_map_apply, hbroot.eq_zero, map_zero]
    · rw [← map_sub]; exact map_nonunit f _ hbm
  have sepOfEquiv : ∀ {k k' : Type u} [Field k] [Field k'] (e : k ≃+* k'),
      IsSepClosed k → IsSepClosed k' := by
    intro k k' _ _ e hk
    apply IsSepClosed.of_exists_root
    intro P hmon hirr hsep
    set Q := P.map (e.symm : k' →+* k) with hQ
    have hQsep : Q.Separable := hsep.map
    have hdeg : Q.degree ≠ 0 := by
      rw [hQ, Polynomial.degree_map_eq_of_injective e.symm.injective]
      intro h0
      apply hirr.not_isUnit
      rw [hmon.isUnit_iff]
      exact Polynomial.eq_one_of_monic_natDegree_zero hmon
        (Polynomial.natDegree_eq_of_degree_eq_some h0)
    obtain ⟨z, hz⟩ := IsSepClosed.exists_root Q hdeg hQsep
    refine ⟨e z, ?_⟩
    have hPQ : Q.map (e : k →+* k') = P := by
      rw [hQ, Polynomial.map_map]
      simp
    rw [← hPQ]
    have := Polynomial.eval_map_apply (e : k →+* k') (p := Q) (x := z)
    simp only [RingHom.coe_coe] at this
    rw [this, hz.eq_zero, map_zero]
  have hsurj : Function.Surjective (p.stalkMap y).hom := p.stalkMap_surjective y
  refine ⟨?_, ?_⟩
  · haveI := hX
    exact henselOfSurj (p.stalkMap y).hom hsurj
  have hnt : Nontrivial (Y.residueField y) :=
    (inferInstance : Field (Y.residueField y)).toNontrivial
  have hinj : Function.Injective (p.residueFieldMap y).hom :=
    (p.residueFieldMap y).hom.injective
  have hsurj2 : Function.Surjective (p.residueFieldMap y).hom := by
    intro t
    obtain ⟨s, rfl⟩ := Y.residue_surjective y t
    obtain ⟨r, rfl⟩ := hsurj s
    refine ⟨X.residue (p y) r, ?_⟩
    have := congrArg (fun φ => φ.hom r) (Scheme.residue_residueFieldMap p y)
    simpa using this
  exact sepOfEquiv (RingEquiv.ofBijective _ ⟨hinj, hsurj2⟩) hXs

theorem wc_wcontr_closed_pullback_hm_vanish {S Z : Scheme.{u}} [IsLocallyNoetherian S]
    (i : Z ⟶ S) [IsClosedImmersion i] (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (V : S.ProEt)
    (h1 : IsAffine V.left) (h2 : IsClosed {x : V.left | IsClosed ({x} : Set V.left)})
    (h3 : ∀ x : V.left, ∃! y : V.left, IsClosed ({y} : Set V.left) ∧ x ⤳ y)
    (h4 : ExtremallyDisconnected {x : V.left | IsClosed ({x} : Set V.left)})
    (h5 : ∀ x : V.left, IsClosed ({x} : Set V.left) →
      HenselianLocalRing (V.left.presheaf.stalk x) ∧ IsSepClosed (V.left.residueField x))
    (k : ℕ) (hk : 1 ≤ k) (x : wcHM (Limits.pullback V.hom i) ℓ k) : x = 0 :=
by
  classical
  obtain ⟨k', rfl⟩ : ∃ k', k = k' + 1 := ⟨k - 1, by omega⟩
  obtain ⟨P, ev, hnat, hadd⟩ :=
    sheafOfModules_free_yoneda (Scheme.ProEt.topology Z) (wcRingSheaf Z ℓ) ((wcProEtBC i).obj V)
  obtain ⟨D, -⟩ := wc_hm_pull_data_exists i ℓ
  haveI hpres : Limits.PreservesFiniteColimits
      (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ D.cont D.φ) :=
    wc_closed_pushforward_exact_of_noetherian i ℓ D
  have hW : Projective (wcFreeSheaf S V) :=
    wc_proet_free_projective_wcontractible S V ⟨h1, h2, h3, h4, h5⟩
  obtain ⟨e, he, -⟩ := proet_free_sheaf_hom_equiv S V
  haveI : Limits.PreservesFiniteColimits (SheafOfModules.toSheaf.{u+1} (wcRingSheaf S ℓ)) :=
    sheafOfModules_toSheaf_preservesFiniteColimits (Scheme.ProEt.topology S) (wcRingSheaf S ℓ)

  have hsurjV : ∀ {M N : SheafOfModules.{u+1} (wcRingSheaf S ℓ)} (q : M ⟶ N) [Epi q]
      (n : N.val.obj (Opposite.op V)), ∃ m : M.val.obj (Opposite.op V),
        (q.val.app (Opposite.op V)).hom m = n := by
    intro M N q _ n
    haveI : Epi ((SheafOfModules.toSheaf (wcRingSheaf S ℓ)).map q) := Functor.map_epi _ q
    obtain ⟨n', hn'⟩ : ∃ n' : ((SheafOfModules.toSheaf (wcRingSheaf S ℓ)).obj N).obj.obj
        (Opposite.op V), n' = n := ⟨n, rfl⟩
    obtain ⟨φ', hφ'⟩ := Projective.factors
      ((e ((SheafOfModules.toSheaf (wcRingSheaf S ℓ)).obj N)).symm n')
      ((SheafOfModules.toSheaf (wcRingSheaf S ℓ)).map q)
    have hh := he _ _ ((SheafOfModules.toSheaf (wcRingSheaf S ℓ)).map q) φ'
    rw [hφ', Equiv.apply_symm_apply] at hh
    obtain ⟨m, hm⟩ : ∃ m : M.val.obj (Opposite.op V),
        m = e ((SheafOfModules.toSheaf (wcRingSheaf S ℓ)).obj M) φ' := ⟨_, rfl⟩
    refine ⟨m, ?_⟩
    subst hm hn'
    exact hh.symm

  have hP : Projective P := by
    refine ⟨fun {E X} g p _ => ?_⟩
    haveI : Epi ((@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _
        D.cont D.φ).map p) := Functor.map_epi _ p
    obtain ⟨m, hm⟩ := hsurjV ((@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _
        D.cont D.φ).map p) (ev X g)
    obtain ⟨m', hm'⟩ : ∃ m' : E.val.obj (Opposite.op ((wcProEtBC i).obj V)), m' = m :=
      ⟨m, rfl⟩
    refine ⟨(ev E).symm m', ?_⟩
    apply (ev X).injective
    rw [hnat, Equiv.apply_symm_apply]
    subst hm'
    exact hm
  haveI := hP
  obtain ⟨DV, hDV⟩ := wc_hm_pull_data_exists ((wcProEtBC i).obj V).hom ℓ
  obtain ⟨Θ, -⟩ := wc_proet_free_slice_module_ext Z ℓ ((wcProEtBC i).obj V) P ev hnat hadd
    DV hDV (k' + 1)
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf Z ℓ)) := HasExt.standard _
  obtain ⟨y, hy⟩ : ∃ y : wcHM ((wcProEtBC i).obj V).left ℓ (k' + 1), y = x := ⟨x, rfl⟩
  subst hy
  have h0 : Θ.symm y = 0 := Abelian.Ext.eq_zero_of_projective _
  have h := Θ.apply_symm_apply y
  rw [h0, map_zero] at h
  exact h.symm

theorem wc_supp_open_h1_boundary_section {Y T : Scheme.{u}} {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    [IsAffine Y] (j : T ⟶ Y) [IsClosedImmersion j] (Dj : wcHMPullData j ℓ)
    (hDj : wcHMPullCanonical Dj)
    (Wo : Y.Opens) (hW : (Wo : Set ↥Y) = (Set.range ⇑j)ᶜ) (hWc : IsCompact (Wo : Set ↥Y))
    (hv2 : ∀ x : wcHM Y ℓ 2, x = 0) :
    ∃ κ : wcSuppExt Dj 2 → wcHM Wo.toScheme ℓ 1,
      ∀ y : Y, IsClosed ({y} : Set Y) →
      HenselianLocalRing (Y.presheaf.stalk y) → IsSepClosed (Y.residueField y) →
      ∀ (Df : wcHMPullData (Y.fromSpecStalk y) ℓ) (_ : wcHMPullCanonical Df)
        (Dj' : wcHMPullData (Limits.pullback.fst (Y.fromSpecStalk y) j) ℓ)
        (_ : wcHMPullCanonical Dj')
        (γ : wcSuppObj Dj' ⟶ Df.Φ.obj (wcSuppObj Dj)),
        wcSuppUnitMap Dj' ≫ γ = Df.μ.inv ≫ Df.Φ.map (wcSuppUnitMap Dj) →
        Epi (wcSuppUnitMap Dj') →
      ∀ (Dg : wcHMPullData (Limits.pullback.snd (Y.fromSpecStalk y) Wo.ι) ℓ),
        wcHMPullCanonical Dg →
      letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf (Spec (Y.presheaf.stalk y)) ℓ)) :=
        HasExt.standard _
      ∃ η : wcSuppExt Dj' 2 →+ wcHM (Limits.pullback (Y.fromSpecStalk y) Wo.ι) ℓ 1,
        Function.Injective η ∧
        (∀ θ : wcSuppExt Dj 2,
          η ((Abelian.Ext.mk₀ γ).comp (wcSuppPullExt Dj Df 2 θ) (zero_add _)) =
            wcHMPull Dg 1 (κ θ)) ∧
        ∀ (c : ℚ_[ℓ]) (X : wcSuppExt Dj' 2),
          η (X.comp (Abelian.Ext.mk₀ (wcHMConst (Spec (Y.presheaf.stalk y)) ℓ c)) (add_zero 2)) =
            wcHMScalar _ ℓ 1 c (η X) :=
by
  classical
  have GEN : ∀ {T V : Scheme.{u}} (j : T ⟶ V) [IsClosedImmersion j]
      (Dj : wcHMPullData j ℓ)
      (hker : ∀ (U : V.ProEt) (k : (Limits.kernel (wcSuppUnitMap Dj)).val.obj (Opposite.op U))
        (W : V.ProEt) (g : W ⟶ U), IsAffine W.left →
        ∃ (n : ℕ) (W' : Fin n → V.ProEt) (e : ∀ a, W' a ⟶ W),
          (∀ a, IsAffine (W' a).left) ∧ (∀ x : ↥W.left, ∃ a, x ∈ Set.range (e a).left) ∧
          ∀ a, (∀ x : ↥(W' a).left, (W' a).hom x ∉ Set.range j) ∨
            ((Limits.kernel (wcSuppUnitMap Dj)).val.map (e a ≫ g).op).hom k = 0)
      (Wo : V.Opens) (hW : (Wo : Set ↥V) = (Set.range j)ᶜ)
      (Dw : wcHMPullData Wo.ι ℓ) (hDw : wcHMPullCanonical Dw),
      ∃ ε : SheafOfModules.unit (wcRingSheaf Wo.toScheme ℓ) ⟶
          Dw.Φ.obj (Limits.kernel (wcSuppUnitMap Dj)),
        ε ≫ Dw.Φ.map (Limits.kernel.ι (wcSuppUnitMap Dj)) = Dw.μ.inv ∧
        ∀ n : ℕ,
          letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf V ℓ)) := HasExt.standard _
          letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf Wo.toScheme ℓ)) := HasExt.standard _
          haveI := Dw.additive; haveI := Dw.presLim; haveI := Dw.presColim
          Function.Bijective (fun x : Abelian.Ext (Limits.kernel (wcSuppUnitMap Dj))
              (SheafOfModules.unit (wcRingSheaf V ℓ)) n =>
            (Abelian.Ext.mk₀ ε).comp ((Abelian.Ext.mapExactFunctor Dw.Φ x).comp
              (Abelian.Ext.mk₀ Dw.μ.hom) (add_zero n)) (zero_add n)) := by
    intro T V j _ Dj hker Wo hW Dw hDw
    letI instV : HasExt (SheafOfModules.{u+1} (wcRingSheaf V ℓ)) := HasExt.standard _
    letI instW : HasExt (SheafOfModules.{u+1} (wcRingSheaf Wo.toScheme ℓ)) := HasExt.standard _
    haveI := Dw.additive
    haveI := Dw.presLim
    haveI := Dw.presColim
    have hdisj : ∀ (t : ↥Wo.toScheme) (z : ↥T), Wo.ι t ≠ j z := by
      intro t z h
      have h1 : Wo.ι t ∈ (Wo : Set ↥V) := by
        rw [← Scheme.Opens.range_ι]
        exact ⟨t, rfl⟩
      rw [hW, h] at h1
      exact h1 ⟨z, rfl⟩
    have hempty : IsEmpty ↥(Limits.pullback Wo.ι j) := by
      refine ⟨fun q => hdisj ((Limits.pullback.fst Wo.ι j) q) ((Limits.pullback.snd Wo.ι j) q) ?_⟩
      have h : (Limits.pullback.fst Wo.ι j ≫ Wo.ι) q = (Limits.pullback.snd Wo.ι j ≫ j) q := by
        rw [Limits.pullback.condition]
      rwa [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at h
    have hkey : Dw.μ.inv ≫ Dw.Φ.map (wcSuppUnitMap Dj) = 0 := by
      apply (SheafOfModules.unitHomEquiv _).injective
      apply Subtype.ext
      funext X
      rw [SheafOfModules.unitHomEquiv_apply_coe, SheafOfModules.unitHomEquiv_apply_coe]
      have h7 := wc_supp_pull_unit_vanish_off j Wo.ι (Limits.pullback.fst Wo.ι j)
        (Limits.pullback.snd Wo.ι j) (IsPullback.of_hasPullback Wo.ι j) ℓ Dj Dw (Opposite.unop X)
        (fun x hx => by
          obtain ⟨q, _⟩ := hx
          exact hempty.false q)
