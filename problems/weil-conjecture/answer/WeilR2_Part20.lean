  refine (wc_closed_supp_wetale_bc_iso (Limits.pullback.fst V.hom i)
    (Spec.map ((Limits.pullback.fst V.hom i).stalkMap z₁))
    (V.left.fromSpecStalk (Limits.pullback.fst V.hom i z₁))
    ((Limits.pullback V.hom i).fromSpecStalk z₁) hb Dp hDp Dq' hDq' Ez hEz).elim
    (fun ξ' _ => ?_)
  have hk' : Set.range ⇑(Limits.pullback.fst (V.left.fromSpecStalk (Limits.pullback.fst V.hom i z₁))
