    {XE' : Scheme.{u}} {p' : XE' ⟶ Xm} {q' : XE' ⟶ Spec (.of L')}
    (hpb' : IsPullback p' q' f (Spec.map (CommRingCat.ofHom φ')))
    {Xs' : Scheme.{u}} {ι' : Xs' ⟶ Xm} {s' : Xs' ⟶ Spec (.of (IsLocalRing.ResidueField A'))}
    (hps' : IsPullback ι' s' f (wcQmSp A'))
    {βs : Xs' ⟶ Xs}
    (hβ : βs ≫ ι = ι' ≫ bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA)))
    (Dβ : wcHMPullData βs ℓ) (hDβ : wcHMPullCanonical Dβ)
    [EnoughInjectives (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))]
    (Dp' : wcHMPullData p' ℓ) (hDp' : wcHMPullCanonical Dp')
    (Di' : wcHMPullData ι' ℓ) (hDi' : wcHMPullCanonical Di')
    (I' : InjectiveResolution (SheafOfModules.unit (wcRingSheaf XE' ℓ)))
    {Z₁ Z₂ ZY : Scheme.{u}} (i₁ : Z₁ ⟶ Xs') (i₂ : Z₂ ⟶ Xs') (iY : ZY ⟶ Xs')
    [IsClosedImmersion i₁] [IsClosedImmersion i₂] [IsClosedImmersion iY]
    (h₁ : Set.range i₁ = closure ((fun z => (ι' ≫ bl ≫ Limits.pullback.fst
      (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))) z) ⁻¹'
        {IsLocalRing.closedPoint B₀})ᶜ)
    (h₂ : Set.range i₂ = (fun z => (ι' ≫ bl ≫ Limits.pullback.fst
      (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))) z) ⁻¹'
        {IsLocalRing.closedPoint B₀})
    (hY : Set.range iY = closure ((fun z => (ι' ≫ bl ≫ Limits.pullback.fst
      (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))) z) ⁻¹'
        {IsLocalRing.closedPoint B₀})ᶜ ∩ (fun z => (ι' ≫ bl ≫ Limits.pullback.fst
      (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))) z) ⁻¹'
        {IsLocalRing.closedPoint B₀})
    (E₁ : wcHMPullData i₁ ℓ) (hE₁ : wcHMPullCanonical E₁)
    (E₂ : wcHMPullData i₂ ℓ) (hE₂ : wcHMPullCanonical E₂)
    (EY : wcHMPullData iY ℓ) (hEY : wcHMPullCanonical EY)
    (ρ₁ : wcSuppObj E₁ ⟶ wcSuppObj EY) (ρ₂ : wcSuppObj E₂ ⟶ wcSuppObj EY)
    (hz : Limits.biprod.lift (wcSuppUnitMap E₁) (wcSuppUnitMap E₂) ≫
      Limits.biprod.desc ρ₁ (-ρ₂) = 0)
    (hS : (ShortComplex.mk _ _ hz).ShortExact) :
    letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))
    ∀ e : (DerivedCategory.singleFunctor (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)) 1).obj
          (wcSuppObj EY) ⟶
        (DerivedCategory.Q.obj ((HomologicalComplex.single
          (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)) (ComplexShape.up ℤ) 0).obj
            (wcSuppObj E₂)))⟦(1 : ℤ)⟧,
      (DerivedCategory.singleFunctor (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)) 1).map ρ₂ ≫ e = 0 →
        e = 0 :=
by
  intro e he
  letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))

  have s1 : ∀ {L M₁ M₂ MY : SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)}
      (u₁ : L ⟶ M₁) (u₂ : L ⟶ M₂) (ρ₁ : M₁ ⟶ MY) (ρ₂ : M₂ ⟶ MY)
      (hz : Limits.biprod.lift u₁ u₂ ≫ Limits.biprod.desc ρ₁ (-ρ₂) = 0)
      (_ : (ShortComplex.mk _ _ hz).ShortExact) [Epi u₁],
      ∃ hk : (Limits.kernel.ι u₁ ≫ u₂) ≫ ρ₂ = 0, (ShortComplex.mk _ _ hk).ShortExact := by
    open Limits in
    intro L M₁ M₂ MY u₁ u₂ ρ₁ ρ₂ hz hS _
    have hmv : u₁ ≫ ρ₁ = u₂ ≫ ρ₂ := by
      have h := hz
      rw [biprod.lift_desc, Preadditive.comp_neg, add_neg_eq_zero] at h
      exact h
    have hk : (kernel.ι u₁ ≫ u₂) ≫ ρ₂ = 0 := by
      rw [Category.assoc, ← hmv, ← Category.assoc, kernel.condition, Limits.zero_comp]
    refine ⟨hk, ?_⟩
    have hmono : Mono (biprod.lift u₁ u₂) := hS.mono_f
    have hepi : Epi (biprod.desc ρ₁ (-ρ₂)) := hS.epi_g
    apply ShortComplex.ShortExact.mk'
    · rw [ShortComplex.exact_iff_exact_up_to_refinements]
      intro A x₂ hx₂
      have hx₂' : x₂ ≫ ρ₂ = 0 := hx₂
      have hy : biprod.lift 0 x₂ ≫ biprod.desc ρ₁ (-ρ₂) = 0 := by
        rw [biprod.lift_desc, Limits.zero_comp, zero_add, Preadditive.comp_neg, hx₂', neg_zero]
      have hw := hS.exact.lift_f (biprod.lift 0 x₂) hy
      set w := hS.exact.lift (biprod.lift 0 x₂) hy
      have hw' : w ≫ biprod.lift u₁ u₂ = biprod.lift 0 x₂ := hw
      have hw1 : w ≫ u₁ = 0 := by
        have := congrArg (· ≫ biprod.fst) hw'
        simpa using this
      have hw2 : w ≫ u₂ = x₂ := by
        have := congrArg (· ≫ biprod.snd) hw'
        simpa using this
      refine ⟨A, 𝟙 A, inferInstance, kernel.lift u₁ w hw1, ?_⟩
      show 𝟙 A ≫ x₂ = kernel.lift u₁ w hw1 ≫ kernel.ι u₁ ≫ u₂
      rw [Category.id_comp, ← Category.assoc, kernel.lift_ι, hw2]
    · apply Preadditive.mono_of_cancel_zero
      intro P a ha
      have ha' : a ≫ kernel.ι u₁ ≫ u₂ = 0 := ha
      have hb : (a ≫ kernel.ι u₁) ≫ biprod.lift u₁ u₂ = 0 := by
        apply biprod.hom_ext
        · rw [Category.assoc, biprod.lift_fst, Category.assoc, kernel.condition, Limits.comp_zero,
            Limits.zero_comp]
        · rw [Category.assoc, biprod.lift_snd, Category.assoc, ha', Limits.zero_comp]
      have hb0 : a ≫ kernel.ι u₁ = 0 := by
        rw [← cancel_mono (biprod.lift u₁ u₂), hb, Limits.zero_comp]
      rw [← cancel_mono (kernel.ι u₁), hb0, Limits.zero_comp]
    · apply Preadditive.epi_of_cancel_zero
      intro P t ht
      have ht' : ρ₂ ≫ t = 0 := ht
      have h1 : ρ₁ ≫ t = 0 := by
        rw [← cancel_epi u₁, ← Category.assoc, hmv, Category.assoc, ht', Limits.comp_zero,
          Limits.comp_zero]
      have h2 : biprod.desc ρ₁ (-ρ₂) ≫ t = 0 := by
        apply biprod.hom_ext'
        · rw [← Category.assoc, biprod.inl_desc, h1, Limits.comp_zero]
        · rw [← Category.assoc, biprod.inr_desc, Preadditive.neg_comp, ht', neg_zero,
            Limits.comp_zero]
      rw [← cancel_epi (biprod.desc ρ₁ (-ρ₂)), h2, Limits.comp_zero]

  have s2 : ∀ {S : ShortComplex (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))} (hS : S.ShortExact),
      (∀ x : (DerivedCategory.singleFunctor (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)) 0).obj S.X₁ ⟶
        ((DerivedCategory.singleFunctor (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)) 0).obj
          S.X₂)⟦(1 : ℤ)⟧, x = 0) →
      ∀ e : (DerivedCategory.singleFunctor (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)) 1).obj S.X₃ ⟶
          (DerivedCategory.Q.obj ((HomologicalComplex.single
            (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)) (ComplexShape.up ℤ) 0).obj S.X₂))⟦(1 : ℤ)⟧,
        (DerivedCategory.singleFunctor (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)) 1).map S.g ≫ e = 0 →
