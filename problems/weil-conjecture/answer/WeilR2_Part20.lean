  obtain ⟨W, hF1, hF2, hsm₂, Y₂, i₂, hi₂, hsmY₂, hrange₂, haff₂⟩ := hG1 r₁ hr ω hωX hωπ
  haveI := hsm₂
  haveI := hi₂

  obtain ⟨t, htdef⟩ : ∃ t : X₁ ⟶ Spec (.of A'), t = r₁ ≫ Spec.map (CommRingCat.ofHom
      (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)))) := ⟨_, rfl⟩
