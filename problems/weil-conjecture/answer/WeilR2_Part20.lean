        (Limits.pullback.snd W'.hom i₁) (by
          rw [Category.assoc]
          exact Limits.pullback.condition)
    have hc₁ : c ≫ Limits.pullback.fst W.hom i₁ = Limits.pullback.fst W'.hom i₁ ≫ b.left :=
      Limits.pullback.lift_fst _ _ _
    have hc₂ : c ≫ Limits.pullback.snd W.hom i₁ = Limits.pullback.snd W'.hom i₁ :=
      Limits.pullback.lift_snd _ _ _
    obtain ⟨Dc, hDc⟩ := wc_hm_pull_data_exists c ℓ
    have hΘ0 := hΘnat W' b PW' Pmb evW' hnatW' haddW' hpre c hc₁ hc₂ Dc hDc β hPβ
    obtain ⟨m, hm1, hm2⟩ := hm z₁
    have hmc : m ≫ c =
        Limits.pullback.snd ((Limits.pullback V.hom i₁).fromSpecStalk z₁) O₁.ι ≫ e := by
      apply Limits.pullback.hom_ext (f := W.hom) (g := i₁)
      · exact (Category.assoc _ _ _).trans ((congrArg (m ≫ ·) hc₁).trans
          (hm1.trans (Category.assoc _ _ _).symm))
      · exact (Category.assoc _ _ _).trans ((congrArg (m ≫ ·) hc₂).trans
          (hm2.trans (Category.assoc _ _ _).symm))
    obtain ⟨Dk, hDk⟩ := wc_hm_pull_data_exists
      (Limits.pullback.snd ((Limits.pullback V.hom i₁).fromSpecStalk z₁) O₁.ι ≫ e) ℓ
    obtain ⟨Dm, hDm⟩ := wc_hm_pull_data_exists m ℓ
    have k1 := wc_hm_pull_comp e
      (Limits.pullback.snd ((Limits.pullback V.hom i₁).fromSpecStalk z₁) O₁.ι) _ rfl
      De hDe D hD Dk hDk 1 (Θ β)
    have k2 := wc_hm_pull_comp c m _ hmc Dc hDc Dm hDm Dk hDk 1 (Θ β)
    exact k1.symm.trans (k2.trans ((congrArg (wcHMPull Dm 1) hΘ0).trans (map_zero _)))

theorem wc_wlocal_open_deg1_ladic_separation {W₀ : Scheme.{u}} (haff : IsAffine W₀)
    (hc : IsClosed {x : W₀ | IsClosed ({x} : Set W₀)})
    (hu : ∀ x : W₀, ∃! y : W₀, IsClosed ({y} : Set W₀) ∧ x ⤳ y)
    (O : W₀.Opens) (hOc : IsCompact (O : Set W₀)) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (α : wcHM O.toScheme ℓ 1)
    (hα : ∀ z : W₀, IsClosed ({z} : Set W₀) →
      ∀ D : wcHMPullData (Limits.pullback.snd (W₀.fromSpecStalk z) O.ι) ℓ,
        wcHMPullCanonical D → wcHMPull D 1 α = 0) : α = 0 :=
by

  have htf : ∀ (U : Scheme.{u}) (y : wcIntExt U ℓ 1), ℓ • y = 0 → y = 0 := by
    intro U y hy
    letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf U ℓ)) := HasExt.standard _
    have hmk : ∀ {A B : SheafOfModules.{u+1} (wcIntRingSheaf U ℓ)} (f : A ⟶ B) (c : ℕ),
        Abelian.Ext.mk₀ (c • f) = c • Abelian.Ext.mk₀ f := by
      intro A B f c
      induction c with
      | zero => rw [zero_nsmul, zero_nsmul, Abelian.Ext.mk₀_zero]
      | succ c ih => rw [succ_nsmul, succ_nsmul, Abelian.Ext.mk₀_add, ih]
    have hR' : ∀ {A B C : SheafOfModules.{u+1} (wcIntRingSheaf U ℓ)} {p q s : ℕ}
        (a : Abelian.Ext A B p) (b : Abelian.Ext B C q) (h : p + q = s) (c : ℕ),
        a.comp (c • b) h = c • a.comp b h := by
      intro A B C p q s a b h c
      induction c with
      | zero => rw [zero_nsmul, zero_nsmul]; exact Abelian.Ext.comp_zero _ _ _ _ _
      | succ c ih => rw [succ_nsmul, succ_nsmul, Abelian.Ext.comp_add, ih]
    haveI hmono := wc_int_unit_pow_mono U ℓ 1
    have hS₁ : (ShortComplex.mk ((ℓ ^ 1 : ℕ) • 𝟙 (wcIntUnit U ℓ))
        (Limits.cokernel.π ((ℓ ^ 1 : ℕ) • 𝟙 (wcIntUnit U ℓ)))
        (Limits.cokernel.condition _)).ShortExact :=
      ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel _) hmono inferInstance
    have hy' : y.comp (Abelian.Ext.mk₀ ((ℓ ^ 1 : ℕ) • 𝟙 (wcIntUnit U ℓ))) (add_zero _) = 0 := by
      rw [hmk, hR', Abelian.Ext.comp_mk₀_id, pow_one]
      exact hy
    obtain ⟨x₃, hx₃⟩ := Abelian.Ext.covariant_sequence_exact₁ _ hS₁ y hy'
      (n₀ := 0) (by omega)
    have hfac : ∃ x₂ : Abelian.Ext (wcIntUnit U ℓ) (wcIntUnit U ℓ) 0,
        x₂.comp (Abelian.Ext.mk₀ (Limits.cokernel.π ((ℓ ^ 1 : ℕ) • 𝟙 (wcIntUnit U ℓ))))
          (add_zero _) = x₃ := by
      obtain ⟨φ, rfl⟩ := (Abelian.Ext.mk₀_bijective _ _).2 x₃
      obtain ⟨w, ⟨hq⟩⟩ := wc_int_unitRestrict_tors_cokernel U ℓ 1
      let e := (Limits.cokernelIsCokernel ((ℓ ^ 1 : ℕ) • 𝟙 (wcIntUnit U ℓ))).coconePointUniqueUpToIso hq
      have he : Limits.cokernel.π ((ℓ ^ 1 : ℕ) • 𝟙 (wcIntUnit U ℓ)) ≫ e.hom =
          wcUnitRestrict (wcIntZModRingSheafMap U ℓ 1) := by
        have he0 := Limits.IsColimit.comp_coconePointUniqueUpToIso_hom
          (Limits.cokernelIsCokernel ((ℓ ^ 1 : ℕ) • 𝟙 (wcIntUnit U ℓ))) hq
          Limits.WalkingParallelPair.one
        first
          | exact he0
          | simpa [Limits.Cofork.ofπ, Limits.CokernelCofork.ofπ] using he0
      obtain ⟨ψ, hψ⟩ := wc_int_unitRestrict_hom_lift U ℓ 1 (φ ≫ e.hom)
      have hψπ : ψ ≫ Limits.cokernel.π ((ℓ ^ 1 : ℕ) • 𝟙 (wcIntUnit U ℓ)) = φ := by
        rw [← cancel_mono e.hom, Category.assoc, he, hψ]
      exact ⟨Abelian.Ext.mk₀ ψ, by rw [Abelian.Ext.mk₀_comp_mk₀, hψπ]⟩
    obtain ⟨x₂, hx₂⟩ := hfac
    rw [← hx₃, ← hx₂, Abelian.Ext.comp_assoc x₂ _ _ (add_zero _) (zero_add 1) (by omega),
      hS₁.comp_extClass, Abelian.Ext.comp_zero]

  haveI : IsAffine W₀ := haff
  haveI hOcs : CompactSpace O.toScheme := isCompact_iff_compactSpace.mp hOc
  haveI hOqs : QuasiSeparatedSpace O.toScheme := quasiSeparatedSpace_of_quasiSeparated O.ι
  haveI : QuasiCompact O.ι := quasiCompact_of_compactSpace O.ι
  let ι := {z : W₀ // IsClosed ({z} : Set W₀)}
  let U : ι → Scheme.{u} := fun a => Limits.pullback (W₀.fromSpecStalk a.1) O.ι
  let g : ∀ a, U a ⟶ O.toScheme := fun a => Limits.pullback.snd (W₀.fromSpecStalk a.1) O.ι
  have hUc : ∀ a, CompactSpace (U a) := fun a =>
    QuasiCompact.compactSpace_of_compactSpace (Limits.pullback.fst (W₀.fromSpecStalk a.1) O.ι)
  have hUq : ∀ a, QuasiSeparatedSpace (U a) := fun a =>
    quasiSeparatedSpace_of_quasiSeparated (Limits.pullback.fst (W₀.fromSpecStalk a.1) O.ι)
  have hlim := wc_zmod_deg0_lim1_zero O.toScheme ℓ
  exact @wc_qcqs_ladic_local_separation O.toScheme hOcs hOqs ℓ _ 1 le_rfl ι U g hUc hUq
    (fun a y' hy' => htf (U a) y' hy')
    (fun k _ h hh => wc_wlocal_open_zmod_closed_stalk_separation haff hc hu O hOc (ℓ ^ k) 1 h
      (fun z hz Dz hDz => hh ⟨z, hz⟩ Dz hDz))
    hlim α (fun a D hD => hα a.1 a.2 D hD)

theorem wc_qmbt_xsp_ess_D1l_Y_chart_stalk_separation {A : Type u} [CommRing A] [IsDomain A]
    [IsDiscreteValuationRing A]
    [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (hℓ : IsUnit ((ℓ : ℕ) : A)) {n : ℕ} (hn : Even n) (hn4 : 4 ≤ n) {π : A}
    {c : Matrix (Fin n) (Fin n) A}
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π}) (hc : IsUnit (c + c.transpose).det)
    {x₀ : Spec (.of (wcQuadModelRing A n π c))}
    (hx₀ : ∀ p, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
      PrimeSpectrum.asIdeal x₀)
    {B₀ : Type u} [CommRing B₀] [HenselianLocalRing B₀] [IsSepClosed (IsLocalRing.ResidueField B₀)]
    {Λ₀ : Type u} [SmallCategory Λ₀] [IsCofiltered Λ₀]
    {W₀ : Λ₀ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (wcQuadModelRing A n π c))) x₀))
      (Scheme.Etale.forget (Spec (.of (wcQuadModelRing A n π c))))}
    {φ₀ : ∀ l, Spec (.of B₀) ⟶ (W₀.obj l).right.left}
    {a₀ : Spec (.of B₀) ⟶ Spec (.of (wcQuadModelRing A n π c))}
    (hsh : wcHalShData x₀ B₀ Λ₀ W₀ φ₀ a₀)
    {Xs : Scheme.{u}} {ι : Xs ⟶ Spec (.of B₀)} {s : Xs ⟶ Spec (.of (IsLocalRing.ResidueField A))}
    (hps : IsPullback ι s (a₀ ≫ wcQuadModelStr A n π c) (wcQmSp A))
    {A' : Type u} [CommRing A'] [IsDomain A'] [IsDiscreteValuationRing A'] [HenselianLocalRing A']
    [IsSepClosed (IsLocalRing.ResidueField A')] {ιA : A →+* A'} {π' : A'}
    (hℓ' : IsUnit ((ℓ : ℕ) : A')) (hπ' : IsLocalRing.maximalIdeal A' = Ideal.span {π'})
    (hπ'2 : π' ^ 2 = ιA π) (hgen : ∀ a' : A', ∃ x y : A, a' = ιA x + ιA y * π')
    {L' : Type u} [Field L'] [IsSepClosed L'] {φ' : A' →+* L'} (hφ' : Function.Injective φ')
    (halg' : letI := φ'.toAlgebra; Algebra.IsAlgebraic A' L')
    {Xm : Scheme.{u}} {f : Xm ⟶ Spec (.of A')}
    {bl : Xm ⟶ Limits.pullback (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))}
    (hbl : wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range
      (fun i : Option (Fin n) => Option.elim i
        ((Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of A')).inv.hom π'))
        (fun j => ((Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))) ≫ a₀).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A n π c))).inv.hom
            (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X j)))))))) bl)
    (hblf : bl ≫ Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA)) = f)
    {XE' : Scheme.{u}} {p' : XE' ⟶ Xm} {q' : XE' ⟶ Spec (.of L')}
    (hpb' : IsPullback p' q' f (Spec.map (CommRingCat.ofHom φ')))
    {Xs' : Scheme.{u}} {ι' : Xs' ⟶ Xm} {s' : Xs' ⟶ Spec (.of (IsLocalRing.ResidueField A'))}
    (hps' : IsPullback ι' s' f (wcQmSp A'))
    {βs : Xs' ⟶ Xs}
    (hβ : βs ≫ ι = ι' ≫ bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA)))
    (Dβ : wcHMPullData βs ℓ) (hDβ : wcHMPullCanonical Dβ)
    [EnoughInjectives (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))]
    (Dp' : wcHMPullData p' ℓ) (hDp' : wcHMPullCanonical Dp')
    (Di' : wcHMPullData ι' ℓ) (hDi' : wcHMPullCanonical Di')
    (I' : InjectiveResolution (SheafOfModules.unit (wcRingSheaf XE' ℓ)))
    {Z₁ Z₂ ZY : Scheme.{u}} (i₁ : Z₁ ⟶ Xs') (i₂ : Z₂ ⟶ Xs') (iY : ZY ⟶ Xs')
    [IsClosedImmersion i₁] [IsClosedImmersion i₂] [IsClosedImmersion iY]
    (h₁ : Set.range i₁ = closure ((fun z => (ι' ≫ bl ≫ Limits.pullback.fst
      (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))) z) ⁻¹'
        {IsLocalRing.closedPoint B₀})ᶜ)
    (h₂ : Set.range i₂ = (fun z => (ι' ≫ bl ≫ Limits.pullback.fst
      (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))) z) ⁻¹'
        {IsLocalRing.closedPoint B₀})
    (hY : Set.range iY = closure ((fun z => (ι' ≫ bl ≫ Limits.pullback.fst
      (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))) z) ⁻¹'
        {IsLocalRing.closedPoint B₀})ᶜ ∩ (fun z => (ι' ≫ bl ≫ Limits.pullback.fst
      (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))) z) ⁻¹'
        {IsLocalRing.closedPoint B₀})
    (E₁ : wcHMPullData i₁ ℓ) (hE₁ : wcHMPullCanonical E₁)
    (E₂ : wcHMPullData i₂ ℓ) (hE₂ : wcHMPullCanonical E₂)
    (EY : wcHMPullData iY ℓ) (hEY : wcHMPullCanonical EY)
    (ρ₁ : wcSuppObj E₁ ⟶ wcSuppObj EY) (ρ₂ : wcSuppObj E₂ ⟶ wcSuppObj EY)
    (hz : Limits.biprod.lift (wcSuppUnitMap E₁) (wcSuppUnitMap E₂) ≫
      Limits.biprod.desc ρ₁ (-ρ₂) = 0)
    (hS : (ShortComplex.mk _ _ hz).ShortExact) (V : Xs'.ProEt)
    (h1 : IsAffine V.left) (h2 : IsClosed {x : V.left | IsClosed ({x} : Set V.left)})
    (h3 : ∀ x : V.left, ∃! y : V.left, IsClosed ({y} : Set V.left) ∧ x ⤳ y)
