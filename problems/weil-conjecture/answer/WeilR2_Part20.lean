      ∀ (DΛ : wcIntPullData (Limits.pullback.snd (W₀.fromSpecStalk z) O.ι) ℓ),
        wcIntPullCanonical DΛ →
        ∀ w : wcIntExt (Limits.pullback (W₀.fromSpecStalk z) O.ι) ℓ 1, ∃ e : ℤ_[ℓ],
          w = wcIntAct _ ℓ 1 (ContinuousMap.const _ (ULift.up e)) (wcIntPull DΛ 1 g))
    (hκ : ∀ z, P z → ∀ (D : wcHMPullData (Limits.pullback.snd (W₀.fromSpecStalk z) O.ι) ℓ),
        wcHMPullCanonical D → wcHMPull D 1 κ ≠ 0)
    (D₀ : wcHMPullData (Limits.pullback.snd (W₀.fromSpecStalk z₀) O.ι) ℓ)
    (hD₀ : wcHMPullCanonical D₀) (hα₀ : wcHMPull D₀ 1 α = 0) :
    ∀ ε : ℝ, 0 < ε → ∃ W : Set W₀, IsOpen W ∧ z₀ ∈ W ∧
      ∀ z ∈ W, P z → ∀ (D : wcHMPullData (Limits.pullback.snd (W₀.fromSpecStalk z) O.ι) ℓ),
        wcHMPullCanonical D → ∀ c : ℚ_[ℓ],
          wcHMPull D 1 α = wcHMScalar _ ℓ 1 c (wcHMPull D 1 κ) → ‖c‖ < ε :=
by
  classical
  intro ε hε

  haveI : IsAffine W₀ := haff
  haveI hOcs : CompactSpace O.toScheme := isCompact_iff_compactSpace.mp hOc
  haveI hOqs : QuasiSeparatedSpace O.toScheme := quasiSeparatedSpace_of_quasiSeparated O.ι
  haveI hOqc : QuasiCompact O.ι := quasiCompact_of_compactSpace O.ι
  have hUc : ∀ z : W₀,
      CompactSpace ↥(Limits.pullback (W₀.fromSpecStalk z) O.ι : Scheme.{u}) := fun z =>
    QuasiCompact.compactSpace_of_compactSpace (Limits.pullback.fst (W₀.fromSpecStalk z) O.ι)
  have hUq : ∀ z : W₀,
      QuasiSeparatedSpace ↥(Limits.pullback (W₀.fromSpecStalk z) O.ι : Scheme.{u}) :=
    fun z => quasiSeparatedSpace_of_quasiSeparated (Limits.pullback.fst (W₀.fromSpecStalk z) O.ι)

  have hσ0 : ∀ (S : Scheme.{u}) (x : wcHM S ℓ 1), wcHMScalar S ℓ 1 0 x = 0 := by
    intro S x
    have h := (wc_hmScalar_laws S ℓ 1).2.2.1 0 0 x
    rw [add_zero] at h
    calc wcHMScalar S ℓ 1 0 x
        = (wcHMScalar S ℓ 1 0 x + wcHMScalar S ℓ 1 0 x) - wcHMScalar S ℓ 1 0 x :=
          (add_sub_cancel_right _ _).symm
      _ = wcHMScalar S ℓ 1 0 x - wcHMScalar S ℓ 1 0 x := by rw [← h]
      _ = 0 := sub_self _
  have hσinv : ∀ (S : Scheme.{u}) (a : ℚ_[ℓ]) (y : wcHM S ℓ 1), a ≠ 0 →
      wcHMScalar S ℓ 1 a y = 0 → y = 0 := by
    intro S a y ha h
    have h1 := (wc_hmScalar_laws S ℓ 1).1 a⁻¹ a y
    rw [h, map_zero, mul_inv_cancel₀ ha, (wc_hmScalar_laws S ℓ 1).2.1] at h1
    exact h1.symm
  have hσsub : ∀ (S : Scheme.{u}) (a b : ℚ_[ℓ]) (x : wcHM S ℓ 1),
      wcHMScalar S ℓ 1 (a - b) x = wcHMScalar S ℓ 1 a x - wcHMScalar S ℓ 1 b x := by
    intro S a b x
    have h := (wc_hmScalar_laws S ℓ 1).2.2.1 (a - b) b x
    rw [sub_add_cancel] at h
    rw [h, add_sub_cancel_right]
  have hns : ∀ (S : Scheme.{u}) (m : ℕ) (x : wcHM S ℓ 1),
      m • x = wcHMScalar S ℓ 1 (m : ℚ_[ℓ]) x := fun S => (wc_hmScalar_laws S ℓ 1).2.2.2
  have hline : ∀ (S : Scheme.{u}) (A B eA eB c : ℚ_[ℓ]) (R κz αz : wcHM S ℓ 1),
      κz ≠ 0 → A ≠ 0 → wcHMScalar S ℓ 1 A κz = wcHMScalar S ℓ 1 eA R →
      wcHMScalar S ℓ 1 B αz = wcHMScalar S ℓ 1 eB R → αz = wcHMScalar S ℓ 1 c κz →
      c * B * eA = eB * A := by
    intro S A B eA eB c R κz αz hκz hA h1 h2 h3
    have L := wc_hmScalar_laws S ℓ 1
    have hR : R ≠ 0 := by
      intro h0
      apply hκz
      apply hσinv S A κz hA
      rw [h1, h0, map_zero]
    have hkey : wcHMScalar S ℓ 1 (eB * A) R = wcHMScalar S ℓ 1 (eA * (c * B)) R := by
      calc wcHMScalar S ℓ 1 (eB * A) R
          = wcHMScalar S ℓ 1 A (wcHMScalar S ℓ 1 eB R) := (L.1 _ _ _).symm
        _ = wcHMScalar S ℓ 1 A (wcHMScalar S ℓ 1 B αz) := by rw [h2]
        _ = wcHMScalar S ℓ 1 A (wcHMScalar S ℓ 1 B (wcHMScalar S ℓ 1 c κz)) := by rw [h3]
        _ = wcHMScalar S ℓ 1 (c * (B * A)) κz := by rw [L.1, L.1]
        _ = wcHMScalar S ℓ 1 (A * (c * B)) κz :=
          congrArg (fun t : ℚ_[ℓ] => wcHMScalar S ℓ 1 t κz) (by ring)
        _ = wcHMScalar S ℓ 1 (c * B) (wcHMScalar S ℓ 1 A κz) := (L.1 _ _ _).symm
        _ = wcHMScalar S ℓ 1 (c * B) (wcHMScalar S ℓ 1 eA R) := by rw [h1]
        _ = wcHMScalar S ℓ 1 (eA * (c * B)) R := L.1 _ _ _
    have hsub : wcHMScalar S ℓ 1 (eB * A - eA * (c * B)) R = 0 := by
      rw [hσsub, hkey, sub_self]
    have hz : eB * A - eA * (c * B) = 0 := by
      by_contra hne
      exact hR (hσinv S _ R hne hsub)
    linear_combination -hz

  have hℓne : ℓ ≠ 0 := (Fact.out : Nat.Prime ℓ).ne_zero
  have hℓ0 : (ℓ : ℚ_[ℓ]) ≠ 0 := Nat.cast_ne_zero.mpr hℓne
  have hρpos : 0 < ‖(ℓ : ℚ_[ℓ])‖ := norm_pos_iff.mpr hℓ0
  have hρlt : ‖(ℓ : ℚ_[ℓ])‖ < 1 := Padic.norm_p_lt_one

  obtain ⟨EO, hEO⟩ := wc_int_rat_data_exists O.toScheme ℓ
  obtain ⟨N, αΛ, hαΛ⟩ := (wc_int_rat_rationalization O.toScheme ℓ EO hEO 1).1 α
  obtain ⟨M, κΛ, hκΛ⟩ := (wc_int_rat_rationalization O.toScheme ℓ EO hEO 1).1 κ
  have hαΛ' : wcIntRho EO 1 αΛ = (ℓ ^ N : ℕ) • α := by
    rw [← hαΛ, hns, Nat.cast_pow]
  have hκΛ' : wcIntRho EO 1 κΛ = (ℓ ^ M : ℕ) • κ := by
    rw [← hκΛ, hns, Nat.cast_pow]

  have hz₀c : IsClosed ({z₀} : Set W₀) := hPc z₀ hz₀
  obtain ⟨DΛ₀, hDΛ₀⟩ := wc_int_pull_data_exists (Limits.pullback.snd (W₀.fromSpecStalk z₀) O.ι) ℓ
  obtain ⟨E₀, hE₀⟩ := wc_int_rat_data_exists (Limits.pullback (W₀.fromSpecStalk z₀) O.ι) ℓ
  have hαz₀ : wcIntRho E₀ 1 (wcIntPull DΛ₀ 1 αΛ) = 0 := by
    rw [wc_int_rat_pull_compat ℓ _ D₀ hD₀ DΛ₀ hDΛ₀ EO hEO E₀ hE₀ 1, hαΛ', map_nsmul, hα₀,
      smul_zero]
  haveI := hUc z₀
  haveI := hUq z₀
  obtain ⟨s, hs⟩ := (wc_int_rat_rationalization (Limits.pullback (W₀.fromSpecStalk z₀) O.ι) ℓ
    E₀ hE₀ 1).2 _ hαz₀
  have hα'z₀ : wcIntPull DΛ₀ 1 ((ℓ ^ s : ℕ) • αΛ) = 0 := by rw [map_nsmul, hs]
  have hα'O : wcIntRho EO 1 ((ℓ ^ s : ℕ) • αΛ) = (ℓ ^ (N + s) : ℕ) • α := by
    rw [map_nsmul, hαΛ', ← mul_nsmul, ← pow_add]

  obtain ⟨e₀, he₀⟩ := hgen z₀ hz₀G hz₀c DΛ₀ hDΛ₀ (wcIntPull DΛ₀ 1 κΛ)
  have hκz₀ : wcIntRho E₀ 1 (wcIntPull DΛ₀ 1 κΛ) = (ℓ ^ M : ℕ) • wcHMPull D₀ 1 κ := by
    rw [wc_int_rat_pull_compat ℓ _ D₀ hD₀ DΛ₀ hDΛ₀ EO hEO E₀ hE₀ 1, hκΛ', map_nsmul]
  have he0ne : (e₀ : ℚ_[ℓ]) ≠ 0 := by
    intro h0
    apply hκ z₀ hz₀ D₀ hD₀
    apply hσinv _ (((ℓ ^ M : ℕ) : ℚ_[ℓ])) _ (Nat.cast_ne_zero.mpr (pow_ne_zero M hℓne))
    rw [← hns, ← hκz₀, he₀, (wc_int_rho_act _ ℓ E₀ hE₀ 1).1, h0, hσ0]
  have he0pos : 0 < ‖(e₀ : ℚ_[ℓ])‖ := norm_pos_iff.mpr he0ne

  obtain ⟨K, hK⟩ := exists_pow_lt_of_lt_one he0pos hρlt
  obtain ⟨n₀, hn₀⟩ : ∃ n : ℕ, n = (PadicInt.toZModPow K e₀).val := ⟨_, rfl⟩
  haveI : NeZero (ℓ ^ K) := ⟨pow_ne_zero K hℓne⟩
  have hmem : e₀ - (n₀ : ℤ_[ℓ]) ∈ Ideal.span {(ℓ : ℤ_[ℓ]) ^ K} := by
    rw [← PadicInt.ker_toZModPow, RingHom.mem_ker, map_sub, map_natCast, hn₀,
      ZMod.natCast_zmod_val, sub_self]
  obtain ⟨a₀, ha₀⟩ := Ideal.mem_span_singleton'.mp hmem
  have ha₀q : (a₀ : ℚ_[ℓ]) * (ℓ : ℚ_[ℓ]) ^ K = (e₀ : ℚ_[ℓ]) - (n₀ : ℚ_[ℓ]) := by
    have h := congrArg (fun x : ℤ_[ℓ] => (x : ℚ_[ℓ])) ha₀
    simpa only [PadicInt.coe_mul, PadicInt.coe_sub, PadicInt.coe_pow, PadicInt.coe_natCast]
      using h
  obtain ⟨hTr₀, ht₀⟩ := wc_int_red_transfer (Limits.pullback (W₀.fromSpecStalk z₀) O.ι) ℓ
  have hκ'z₀ : wcIntRed (Limits.pullback (W₀.fromSpecStalk z₀) O.ι) ℓ K 1
      (wcIntPull DΛ₀ 1 (κΛ - n₀ • g)) = 0 := by
    rw [map_sub, map_nsmul, he₀, map_sub, map_nsmul, (wc_int_red_act _ ℓ hTr₀ ht₀ 1).1, hn₀,
      sub_self]

  obtain ⟨k, hk⟩ := exists_pow_lt_of_lt_one
    (div_pos (mul_pos (mul_pos hε he0pos) (pow_pos hρpos (N + s))) (pow_pos hρpos M)) hρlt
  have hα'z₀r : wcIntRed (Limits.pullback (W₀.fromSpecStalk z₀) O.ι) ℓ k 1
      (wcIntPull DΛ₀ 1 ((ℓ ^ s : ℕ) • αΛ)) = 0 := by
    rw [hα'z₀, map_zero]

  obtain ⟨W1, hW1o, hz₀W1, hW1⟩ := wc_wlocal_int_red_divisible_near haff hc hu O.ι hOqc
    inferInstance ℓ k 1 ((ℓ ^ s : ℕ) • αΛ) z₀ hz₀c DΛ₀ hDΛ₀ hα'z₀r
  obtain ⟨W2, hW2o, hz₀W2, hW2⟩ := wc_wlocal_int_red_divisible_near haff hc hu O.ι hOqc
    inferInstance ℓ K 1 (κΛ - n₀ • g) z₀ hz₀c DΛ₀ hDΛ₀ hκ'z₀
  refine ⟨G ∩ W1 ∩ W2, (hG.inter hW1o).inter hW2o, ⟨⟨hz₀G, hz₀W1⟩, hz₀W2⟩, ?_⟩

  intro z hzW hPz D hD c hcα
  have hzc := hPc z hPz
  obtain ⟨DΛ, hDΛ⟩ := wc_int_pull_data_exists (Limits.pullback.snd (W₀.fromSpecStalk z) O.ι) ℓ
  obtain ⟨Ez, hEz⟩ := wc_int_rat_data_exists (Limits.pullback (W₀.fromSpecStalk z) O.ι) ℓ
  obtain ⟨w₁, hw₁⟩ := hW1 z hzW.1.2 hzc DΛ hDΛ
  obtain ⟨w₂, hw₂⟩ := hW2 z hzW.2 hzc DΛ hDΛ
  obtain ⟨hc₁, hhc⟩ := hgen z hzW.1.1 hzc DΛ hDΛ w₁
  obtain ⟨fc, hf⟩ := hgen z hzW.1.1 hzc DΛ hDΛ w₂
  have hact := (wc_int_rho_act _ ℓ Ez hEz 1).1
  have hK1 : wcHMScalar _ ℓ 1 (((ℓ ^ M : ℕ) : ℚ_[ℓ])) (wcHMPull D 1 κ) =
      wcHMScalar _ ℓ 1 ((n₀ : ℚ_[ℓ]) + (fc : ℚ_[ℓ]) * ((ℓ ^ K : ℕ) : ℚ_[ℓ]))
        (wcIntRho Ez 1 (wcIntPull DΛ 1 g)) := by
    have e1 : wcIntPull DΛ 1 κΛ = n₀ • wcIntPull DΛ 1 g + (ℓ ^ K : ℕ) • w₂ := by
      rw [← hw₂, map_sub, map_nsmul]
      abel
    have e2 := congrArg (wcIntRho Ez 1) e1
    rw [wc_int_rat_pull_compat ℓ _ D hD DΛ hDΛ EO hEO Ez hEz 1, hκΛ', map_nsmul, map_add,
      map_nsmul, map_nsmul, hf, hact] at e2
    rw [← hns, e2, hns, hns, (wc_hmScalar_laws _ ℓ 1).1, ← (wc_hmScalar_laws _ ℓ 1).2.2.1]
  have hA1 : wcHMScalar _ ℓ 1 (((ℓ ^ (N + s) : ℕ) : ℚ_[ℓ])) (wcHMPull D 1 α) =
      wcHMScalar _ ℓ 1 ((hc₁ : ℚ_[ℓ]) * ((ℓ ^ k : ℕ) : ℚ_[ℓ]))
        (wcIntRho Ez 1 (wcIntPull DΛ 1 g)) := by
    have e2 := congrArg (wcIntRho Ez 1) hw₁
    rw [wc_int_rat_pull_compat ℓ _ D hD DΛ hDΛ EO hEO Ez hEz 1, hα'O, map_nsmul, map_nsmul,
      hhc, hact] at e2
    rw [← hns, e2, hns, (wc_hmScalar_laws _ ℓ 1).1]
  have hAne : (((ℓ ^ M : ℕ) : ℚ_[ℓ])) ≠ 0 := Nat.cast_ne_zero.mpr (pow_ne_zero M hℓne)
  have key2 := hline _ _ _ _ _ c _ _ _ (hκ z hPz D hD) hAne hK1 hA1 hcα
  have hident : (n₀ : ℚ_[ℓ]) + (fc : ℚ_[ℓ]) * ((ℓ ^ K : ℕ) : ℚ_[ℓ]) =
      (e₀ : ℚ_[ℓ]) + ((fc - a₀ : ℤ_[ℓ]) : ℚ_[ℓ]) * (ℓ : ℚ_[ℓ]) ^ K := by
    rw [PadicInt.coe_sub, Nat.cast_pow]
    linear_combination ha₀q
  rw [hident] at key2
  have hsmall : ‖((fc - a₀ : ℤ_[ℓ]) : ℚ_[ℓ]) * (ℓ : ℚ_[ℓ]) ^ K‖ < ‖(e₀ : ℚ_[ℓ])‖ := by
    rw [norm_mul, norm_pow]
    have hf1 : ‖((fc - a₀ : ℤ_[ℓ]) : ℚ_[ℓ])‖ ≤ 1 := by
      rw [PadicInt.padic_norm_e_of_padicInt]; exact PadicInt.norm_le_one _
    calc ‖((fc - a₀ : ℤ_[ℓ]) : ℚ_[ℓ])‖ * ‖(ℓ : ℚ_[ℓ])‖ ^ K ≤ 1 * ‖(ℓ : ℚ_[ℓ])‖ ^ K :=
          mul_le_mul_of_nonneg_right hf1 (pow_nonneg (norm_nonneg _) _)
      _ < ‖(e₀ : ℚ_[ℓ])‖ := by rw [one_mul]; exact hK
  have he0le : ‖(e₀ : ℚ_[ℓ])‖ ≤
      ‖(e₀ : ℚ_[ℓ]) + ((fc - a₀ : ℤ_[ℓ]) : ℚ_[ℓ]) * (ℓ : ℚ_[ℓ]) ^ K‖ := by
    have h := Padic.nonarchimedean
      ((e₀ : ℚ_[ℓ]) + ((fc - a₀ : ℤ_[ℓ]) : ℚ_[ℓ]) * (ℓ : ℚ_[ℓ]) ^ K)
      (-(((fc - a₀ : ℤ_[ℓ]) : ℚ_[ℓ]) * (ℓ : ℚ_[ℓ]) ^ K))
    rw [add_neg_cancel_right, norm_neg] at h
    rcases le_max_iff.mp h with h | h
    · exact h
    · exact absurd (h.trans_lt hsmall) (lt_irrefl _)
  have hn : ‖c‖ * ‖(ℓ : ℚ_[ℓ])‖ ^ (N + s) *
      ‖(e₀ : ℚ_[ℓ]) + ((fc - a₀ : ℤ_[ℓ]) : ℚ_[ℓ]) * (ℓ : ℚ_[ℓ]) ^ K‖ =
      ‖(hc₁ : ℚ_[ℓ])‖ * ‖(ℓ : ℚ_[ℓ])‖ ^ k * ‖(ℓ : ℚ_[ℓ])‖ ^ M := by
    simpa only [norm_mul, norm_pow, Nat.cast_pow] using congrArg norm key2
  have hg1 : ‖(hc₁ : ℚ_[ℓ])‖ ≤ 1 := by
    rw [PadicInt.padic_norm_e_of_padicInt]; exact PadicInt.norm_le_one _
  have hk' : ‖(ℓ : ℚ_[ℓ])‖ ^ k * ‖(ℓ : ℚ_[ℓ])‖ ^ M <
      ε * ‖(e₀ : ℚ_[ℓ])‖ * ‖(ℓ : ℚ_[ℓ])‖ ^ (N + s) :=
    (lt_div_iff₀ (pow_pos hρpos M)).mp hk
  have hA : ‖c‖ * (‖(ℓ : ℚ_[ℓ])‖ ^ (N + s) * ‖(e₀ : ℚ_[ℓ])‖) ≤
      ‖(ℓ : ℚ_[ℓ])‖ ^ k * ‖(ℓ : ℚ_[ℓ])‖ ^ M := by
    calc ‖c‖ * (‖(ℓ : ℚ_[ℓ])‖ ^ (N + s) * ‖(e₀ : ℚ_[ℓ])‖)
        ≤ ‖c‖ * ‖(ℓ : ℚ_[ℓ])‖ ^ (N + s) *
            ‖(e₀ : ℚ_[ℓ]) + ((fc - a₀ : ℤ_[ℓ]) : ℚ_[ℓ]) * (ℓ : ℚ_[ℓ]) ^ K‖ := by
          rw [← mul_assoc]
          exact mul_le_mul_of_nonneg_left he0le
            (mul_nonneg (norm_nonneg _) (pow_nonneg (norm_nonneg _) _))
      _ = ‖(hc₁ : ℚ_[ℓ])‖ * ‖(ℓ : ℚ_[ℓ])‖ ^ k * ‖(ℓ : ℚ_[ℓ])‖ ^ M := hn
      _ ≤ 1 * ‖(ℓ : ℚ_[ℓ])‖ ^ k * ‖(ℓ : ℚ_[ℓ])‖ ^ M :=
          mul_le_mul_of_nonneg_right
            (mul_le_mul_of_nonneg_right hg1 (pow_nonneg (norm_nonneg _) _))
            (pow_nonneg (norm_nonneg _) _)
      _ = ‖(ℓ : ℚ_[ℓ])‖ ^ k * ‖(ℓ : ℚ_[ℓ])‖ ^ M := by ring
  have hP : 0 < ‖(ℓ : ℚ_[ℓ])‖ ^ (N + s) * ‖(e₀ : ℚ_[ℓ])‖ := mul_pos (pow_pos hρpos _) he0pos
  have hfin : ‖c‖ * (‖(ℓ : ℚ_[ℓ])‖ ^ (N + s) * ‖(e₀ : ℚ_[ℓ])‖) <
      ε * (‖(ℓ : ℚ_[ℓ])‖ ^ (N + s) * ‖(e₀ : ℚ_[ℓ])‖) := by
    calc _ ≤ _ := hA
      _ < ε * ‖(e₀ : ℚ_[ℓ])‖ * ‖(ℓ : ℚ_[ℓ])‖ ^ (N + s) := hk'
      _ = _ := by ring
  exact lt_of_mul_lt_mul_right hfin hP.le

theorem wc_int_h1_gen_of_kummer_counts (L : Type u) [Field L] [IsSepClosed L] (ℓ : ℕ)
    [Fact (Nat.Prime ℓ)] (hℓL : ((ℓ : ℕ) : L) ≠ 0)
    (κt : ∀ (T : Scheme.{u}), (T ⟶ Spec (.of L)) → ∀ k : ℕ, (Γ(T, ⊤))ˣ → wcZModProEtExt T (ℓ ^ k) 1)
    (κΛ : ∀ (T : Scheme.{u}), (T ⟶ Spec (.of L)) → (Γ(T, ⊤))ˣ → wcIntExt T ℓ 1)
    (hK : wcYrcKummerPkg L ℓ κt κΛ) (T : Scheme.{u}) (qT : T ⟶ Spec (.of L))
    (a : (Γ(T, ⊤))ˣ) (hnot : ¬ ∃ b : (Γ(T, ⊤))ˣ, b ^ ℓ = a)
    (γ : wcIntExt T ℓ 1) (hγ : ∀ k : ℕ, 1 ≤ k → wcIntRed T ℓ k 1 γ = κt T qT k a)
    (hcnt : ∀ k : ℕ, 1 ≤ k → Finite (wcZModProEtExt T (ℓ ^ k) 1) ∧
      Nat.card (wcZModProEtExt T (ℓ ^ k) 0) = ℓ ^ k ∧
      Nat.card (wcZModProEtExt T (ℓ ^ k) 1) = ℓ ^ k) :
    ∀ w : wcIntExt T ℓ 1, ∃ e : ℤ_[ℓ],
      w = wcIntAct T ℓ 1 (ContinuousMap.const _ (ULift.up e)) γ :=
by
  classical
  have hp : ℓ.Prime := Fact.out

  have h0 := (hcnt 1 le_rfl).2.1
  obtain ⟨hnt, hidem⟩ := wc_zmod_h0_card_connected T (ℓ ^ 1)
    (by rw [pow_one]; exact hp.two_le) h0
  haveI := hnt
  let φ : L →+* Γ(T, ⊤) := qT.appTop.hom.comp (Scheme.ΓSpecIso (CommRingCat.of L)).inv.hom
  have hκ1 : ∀ k, κt T qT k 1 = 0 := by
    intro k
    have h := hK.1 T qT k 1 1
    rw [mul_one] at h
    exact left_eq_add.mp h
  have hpow : ∀ k (m : ℕ), κt T qT k (a ^ m) = m • κt T qT k a := by
    intro k m
    induction m with
    | zero => rw [pow_zero, zero_nsmul, hκ1]
    | succ m ih => rw [pow_succ, hK.1, ih, succ_nsmul]
  have hne : ∀ k, 1 ≤ k → ℓ ^ (k - 1) • wcIntRed T ℓ k 1 γ ≠ 0 := by
    intro k hk h
    rw [hγ k hk, ← hpow k (ℓ ^ (k - 1))] at h
    exact wc_yrc_unit_not_lpow_iter L _ φ ℓ hℓL hidem a hnot k hk
      ((hK.2.2.1 T qT k _ hk).mp h)

  have hcyc : ∀ k, 1 ≤ k → (∀ n : ℕ, n • wcIntRed T ℓ k 1 γ = 0 ↔ ℓ ^ k ∣ n) ∧
      ∀ x : wcZModProEtExt T (ℓ ^ k) 1, ∃ n : ℕ, x = n • wcIntRed T ℓ k 1 γ := by
    intro k hk
    obtain ⟨hfin, -, hcard⟩ := hcnt k hk
    haveI := hfin
    have hord : addOrderOf (wcIntRed T ℓ k 1 γ) = ℓ ^ k := by
      have hd : addOrderOf (wcIntRed T ℓ k 1 γ) ∣ ℓ ^ k := by
        have h := addOrderOf_dvd_natCard (wcIntRed T ℓ k 1 γ)
        rwa [hcard] at h
      obtain ⟨i, hi, hieq⟩ := (Nat.dvd_prime_pow hp).mp hd
      rcases Nat.lt_or_ge i k with hlt | hge
      · exfalso
        apply hne k hk
        apply addOrderOf_dvd_iff_nsmul_eq_zero.mp
        rw [hieq]
        exact Nat.pow_dvd_pow ℓ (by omega)
      · rw [hieq, le_antisymm hi hge]
    refine ⟨fun n => ?_, fun x => ?_⟩
    · rw [← addOrderOf_dvd_iff_nsmul_eq_zero, hord]
    · have htop : AddSubgroup.zmultiples (wcIntRed T ℓ k 1 γ) = ⊤ := by
        apply AddSubgroup.eq_top_of_card_eq
        rw [Nat.card_zmultiples, hord, hcard]
      have hx : x ∈ AddSubgroup.zmultiples (wcIntRed T ℓ k 1 γ) := by
        rw [htop]; exact AddSubgroup.mem_top x
      obtain ⟨n, hn⟩ :=
        (AddSubmonoid.mem_multiples_iff _ _).mp (mem_multiples_iff_mem_zmultiples.mpr hx)
      exact ⟨n, hn.symm⟩

  obtain ⟨hTr, ht⟩ := wc_int_red_transfer T ℓ
  obtain ⟨M1, -, M3, -⟩ := wc_int_red_milnor T ℓ hTr ht 1
  obtain ⟨A1, -, -⟩ := wc_int_red_act T ℓ hTr ht 1
  have hL := wc_zmod_deg0_lim1_zero T ℓ
  intro w
  have hex : ∀ k, ∃ n : ℕ, 1 ≤ k → wcIntRed T ℓ k 1 w = n • wcIntRed T ℓ k 1 γ := by
    intro k
    by_cases hk : 1 ≤ k
    · obtain ⟨n, hn⟩ := (hcyc k hk).2 (wcIntRed T ℓ k 1 w)
      exact ⟨n, fun _ => hn⟩
    · exact ⟨0, fun h => absurd h hk⟩
  choose n hn using hex
  have hord : ∀ k, 1 ≤ k → addOrderOf (wcIntRed T ℓ k 1 γ) = ℓ ^ k := by
    intro k hk
    apply Nat.dvd_antisymm
    · exact addOrderOf_dvd_iff_nsmul_eq_zero.mpr (((hcyc k hk).1 _).mpr dvd_rfl)
    · exact ((hcyc k hk).1 _).mp (addOrderOf_nsmul_eq_zero _)
  have hcompat : ∀ m : ℕ, ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ m)) (ZMod (ℓ ^ m))
      ((n (m + 1) : ℕ) : ZMod (ℓ ^ (m + 1))) = ((n m : ℕ) : ZMod (ℓ ^ m)) := by
    intro m
    rw [map_natCast]
    rcases Nat.eq_zero_or_pos m with hm | hm
    · subst hm
      haveI : Subsingleton (ZMod (ℓ ^ 0)) := ZMod.subsingleton_iff.mpr (pow_zero ℓ)
      exact Subsingleton.elim _ _
    · rw [ZMod.natCast_eq_natCast_iff']
      have e1 : n (m + 1) • wcIntRed T ℓ m 1 γ = n m • wcIntRed T ℓ m 1 γ := by
        rw [← hn m hm, ← M1 m w hm, hn (m + 1) (by omega), map_nsmul, M1 m γ hm]
      rw [nsmul_inj_mod, hord m hm] at e1
      exact e1
  obtain ⟨e, he⟩ := wc_padicInt_of_compatible ℓ (fun m => ((n m : ℕ) : ZMod (ℓ ^ m))) hcompat
  have he' : ∀ m, PadicInt.toZModPow m e = ((n m : ℕ) : ZMod (ℓ ^ m)) := he
  refine ⟨e, ?_⟩
  have hz : w - wcIntAct T ℓ 1 (ContinuousMap.const _ (ULift.up e)) γ = 0 := by
    apply M3 hL
    intro k hk
    rw [map_sub, A1, he' k, ZMod.val_natCast, hn k hk,
      show n k % ℓ ^ k = n k % addOrderOf (wcIntRed T ℓ k 1 γ) by rw [hord k hk],
      mod_addOrderOf_nsmul, sub_self]
  exact sub_eq_zero.mp hz

theorem wc_qmbt_D1l_chart_factor_hom {A : Type u} [CommRing A] [IsDomain A]
    [IsDiscreteValuationRing A]
    {n : ℕ} {π : A} {c : Matrix (Fin n) (Fin n) A}
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π})
    {x₀ : Spec (.of (wcQuadModelRing A n π c))}
    (hx₀ : ∀ p, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
      PrimeSpectrum.asIdeal x₀)
    {B₀ : Type u} [CommRing B₀] [HenselianLocalRing B₀] [IsSepClosed (IsLocalRing.ResidueField B₀)]
    {Λ₀ : Type u} [SmallCategory Λ₀] [IsCofiltered Λ₀]
    {W₀ : Λ₀ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (wcQuadModelRing A n π c))) x₀))
      (Scheme.Etale.forget (Spec (.of (wcQuadModelRing A n π c))))}
    {φ₀ : ∀ l, Spec (.of B₀) ⟶ (W₀.obj l).right.left}
    {a₀ : Spec (.of B₀) ⟶ Spec (.of (wcQuadModelRing A n π c))}
    (hsh : wcHalShData x₀ B₀ Λ₀ W₀ φ₀ a₀)
    {A' : Type u} [CommRing A'] [IsDomain A'] [IsDiscreteValuationRing A'] {ιA : A →+* A'}
    {π' : A'} (hπ' : IsLocalRing.maximalIdeal A' = Ideal.span {π'})
    {Xm : Scheme.{u}} {f : Xm ⟶ Spec (.of A')}
    {bl : Xm ⟶ Limits.pullback (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))}
    (hblf : bl ≫ Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA)) = f)
    {Xs' : Scheme.{u}} {ι' : Xs' ⟶ Xm} {s' : Xs' ⟶ Spec (.of (IsLocalRing.ResidueField A'))}
    (hps' : IsPullback ι' s' f (wcQmSp A'))
    (θ : wcQuadModelRing A n π c →+* wcQuadModelRing A' n (π' ^ 2) (c.map ιA))
    {X₁ : Scheme.{u}} (r₁ : X₁ ⟶ Spec (.of (wcQuadModelRing A' n (π' ^ 2) (c.map ιA))))
    (ψ : Xm ⟶ X₁)
    (hθX : ∀ p, θ (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p)) =
      Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) (c.map ιA)) (MvPolynomial.X p))
    (hpbψ : IsPullback ψ (bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA))) (r₁ ≫ Spec.map (CommRingCat.ofHom θ)) a₀)
    (hψf : ψ ≫ r₁ ≫ Spec.map (CommRingCat.ofHom
        (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)))) =
      bl ≫ Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA)))
    (φN : wcQuadModelRing A' n (π' ^ 2) (c.map ιA) →+* wcQmbtChartNone A' n (c.map ιA))
    (φ : ∀ j : Fin n,
      wcQuadModelRing A' n (π' ^ 2) (c.map ιA) →+* wcQmbtChart A' n π' (c.map ιA) j)
    (eN : Spec (.of (wcQmbtChartNone A' n (c.map ιA))) ⟶ X₁)
    (e : ∀ j : Fin n, Spec (.of (wcQmbtChart A' n π' (c.map ιA) j)) ⟶ X₁)
    [IsOpenImmersion eN] [∀ j, IsOpenImmersion (e j)]
    (hNX : ∀ p, φN (Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) (c.map ιA))
        (MvPolynomial.X p)) =
      Ideal.Quotient.mk (wcQmbtChartNoneIdeal A' n (c.map ιA))
        (MvPolynomial.C π' * MvPolynomial.X p))
    (hNA : φN.comp (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA))) =
      algebraMap A' (wcQmbtChartNone A' n (c.map ιA)))
    (hφX : ∀ j p, φ j (Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) (c.map ιA))
        (MvPolynomial.X p)) =
      Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' (c.map ιA) j)
        (MvPolynomial.X (some j) * wcQmbtChartHat j p))
    (hφA : ∀ j, (φ j).comp (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA))) =
      algebraMap A' (wcQmbtChart A' n π' (c.map ιA) j))
    (hN : eN ≫ r₁ = Spec.map (CommRingCat.ofHom φN))
    (he : ∀ j, e j ≫ r₁ = Spec.map (CommRingCat.ofHom (φ j)))
    (hcov : ∀ x : X₁, x ∈ Set.range eN ∨ ∃ j y, e j y = x) :
    ∀ (R : CommRingCat.{u}) [IsLocalRing R] (cR : Spec R ⟶ Xs'), WeaklyEtale cR →
    ∀ (j : Fin n) (y : Spec (.of (wcQmbtChart A' n π' (c.map ιA) j))),
      e j y = ψ (ι' (cR (IsLocalRing.closedPoint R))) →
      ∃ ρ : (wcQmbtChart A' n π' (c.map ιA) j ⧸
          Ideal.span {algebraMap A' (wcQmbtChart A' n π' (c.map ιA) j) π'}) →+* R,
        WeaklyEtale (Spec.map (CommRingCat.ofHom (R := wcQmbtChart A' n π' (c.map ιA) j ⧸
          Ideal.span {algebraMap A' (wcQmbtChart A' n π' (c.map ιA) j) π'}) (S := R) ρ)) ∧
        Spec.map (CommRingCat.ofHom (ρ.comp (Ideal.Quotient.mk
            (Ideal.span {algebraMap A' (wcQmbtChart A' n π' (c.map ιA) j) π'})))) ≫ e j =
          cR ≫ ι' ≫ ψ :=
by
  classical

  have La : ∀ {A₀ C₀ : Type u} [CommRing A₀] [IsLocalRing A₀] [CommRing C₀] [Algebra A₀ C₀]
      {π₀ : A₀}, IsLocalRing.maximalIdeal A₀ = Ideal.span {π₀} →
      ∃ ε : IsLocalRing.ResidueField A₀ →+* C₀ ⧸ Ideal.span {algebraMap A₀ C₀ π₀},
        IsPullback
          (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {algebraMap A₀ C₀ π₀}))))
          (Spec.map (CommRingCat.ofHom ε))
          (Spec.map (CommRingCat.ofHom (algebraMap A₀ C₀)))
          (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A₀))) := by
    intro A₀ C₀ _ _ _ _ π₀ hπ₀
    have hJ : Ideal.map (algebraMap A₀ C₀) (IsLocalRing.maximalIdeal A₀) =
        Ideal.span {algebraMap A₀ C₀ π₀} := by
      rw [hπ₀, Ideal.map_span, Set.image_singleton]
    have H : ∀ x ∈ IsLocalRing.maximalIdeal A₀,
        (Ideal.Quotient.mk (Ideal.span {algebraMap A₀ C₀ π₀})) (algebraMap A₀ C₀ x) = 0 := by
      intro x hx
      rw [Ideal.Quotient.eq_zero_iff_mem, ← hJ]
      exact Ideal.mem_map_of_mem _ hx
    let ε : IsLocalRing.ResidueField A₀ →+* C₀ ⧸ Ideal.span {algebraMap A₀ C₀ π₀} :=
      Ideal.Quotient.lift (IsLocalRing.maximalIdeal A₀)
        ((Ideal.Quotient.mk (Ideal.span {algebraMap A₀ C₀ π₀})).comp (algebraMap A₀ C₀)) H
    have hε : ∀ x, ε (IsLocalRing.residue A₀ x) =
        Ideal.Quotient.mk (Ideal.span {algebraMap A₀ C₀ π₀}) (algebraMap A₀ C₀ x) := fun x => rfl
    let Φ : TensorProduct A₀ C₀ (IsLocalRing.ResidueField A₀) ≃+*
        C₀ ⧸ Ideal.span {algebraMap A₀ C₀ π₀} :=
      ((Algebra.TensorProduct.quotIdealMapEquivTensorQuot C₀
        (IsLocalRing.maximalIdeal A₀)).toRingEquiv.symm).trans (Ideal.quotEquivOfEq hJ)
    have hΦ : ∀ c : C₀, Φ (c ⊗ₜ 1) = Ideal.Quotient.mk (Ideal.span {algebraMap A₀ C₀ π₀}) c := by
      intro c
      have h1 : (Algebra.TensorProduct.quotIdealMapEquivTensorQuot C₀
          (IsLocalRing.maximalIdeal A₀)).toRingEquiv.symm (c ⊗ₜ 1) =
          Ideal.Quotient.mk (Ideal.map (algebraMap A₀ C₀) (IsLocalRing.maximalIdeal A₀)) c := by
        rw [RingEquiv.symm_apply_eq]
        exact (Algebra.TensorProduct.quotIdealMapEquivTensorQuot_mk C₀ _ c).symm
      show Ideal.quotEquivOfEq hJ ((Algebra.TensorProduct.quotIdealMapEquivTensorQuot C₀
        (IsLocalRing.maximalIdeal A₀)).toRingEquiv.symm (c ⊗ₜ 1)) = _
      rw [h1, Ideal.quotEquivOfEq_mk]
    have P := CommRingCat.isPushout_tensorProduct A₀ C₀ (IsLocalRing.ResidueField A₀)
    have P' : IsPushout (CommRingCat.ofHom (algebraMap A₀ C₀))
        (CommRingCat.ofHom (IsLocalRing.residue A₀))
        (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {algebraMap A₀ C₀ π₀})))
        (CommRingCat.ofHom ε) := by
      refine IsPushout.of_iso P (Iso.refl _) (Iso.refl _) (Iso.refl _) Φ.toCommRingCatIso
        ?_ ?_ ?_ ?_
      · rw [Iso.refl_hom, Iso.refl_hom, Category.comp_id, Category.id_comp]
      · rw [Iso.refl_hom, Iso.refl_hom, Category.comp_id, Category.id_comp]
        rfl
      · rw [Iso.refl_hom, Category.id_comp, RingEquiv.toCommRingCatIso_hom]
        ext c
        simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply,
          Algebra.TensorProduct.includeLeftRingHom_apply, RingEquiv.coe_toRingHom]
        exact hΦ c
      · rw [Iso.refl_hom, Category.id_comp, RingEquiv.toCommRingCatIso_hom]
        ext κ
        obtain ⟨x, rfl⟩ := IsLocalRing.residue_surjective κ
        simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply,
          AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
          Algebra.TensorProduct.includeRight_apply]
        have e1 : (1 : C₀) ⊗ₜ[A₀] (IsLocalRing.residue A₀ x) = algebraMap A₀ C₀ x ⊗ₜ 1 :=
          (Algebra.TensorProduct.tmul_one_eq_one_tmul x).symm
        rw [e1, hΦ, hε]
    exact ⟨ε, isPullback_SpecMap_of_isPushout _ _ _ _ P'⟩


  have Lb : ∀ {M X S T Xs U Ub Z : Scheme.{u}}
      (ψ₀ : M ⟶ X) (F : X ⟶ S) (f₀ : M ⟶ S) (_hf : ψ₀ ≫ F = f₀)
      (t : T ⟶ S) (ι₀ : Xs ⟶ M) (s₀ : Xs ⟶ T) (_hps : IsPullback ι₀ s₀ f₀ t)
      (e₀ : U ⟶ X) (u₀ : U ⟶ S) (_hu : e₀ ≫ F = u₀)
      (m : Ub ⟶ U) (ε' : Ub ⟶ T) (_hU : IsPullback m ε' u₀ t)
      (c₀ : Z ⟶ Xs) (hb : Z ⟶ Ub)
      (_h1 : hb ≫ m ≫ e₀ = c₀ ≫ ι₀ ≫ ψ₀) (_h2 : hb ≫ ε' = c₀ ≫ s₀)
      (_hψ : WeaklyEtale ψ₀) (_he : WeaklyEtale e₀) (_hc : WeaklyEtale c₀),
      WeaklyEtale hb := by
    intro M X S T Xs U Ub Z ψ₀ F f₀ hf t ι₀ s₀ hps e₀ u₀ hu m ε' hU c₀ hb h1 h2 hψ he hc
    have Q := IsPullback.of_hasPullback F t
    have w₁ : (ι₀ ≫ ψ₀) ≫ F = s₀ ≫ t := by rw [Category.assoc, hf]; exact hps.toCommSq.w
    have w₂ : (m ≫ e₀) ≫ F = ε' ≫ t := by rw [Category.assoc, hu]; exact hU.toCommSq.w
    have hκ1 := Limits.pullback.lift_fst (ι₀ ≫ ψ₀) s₀ w₁
    have hκ2 := Limits.pullback.lift_snd (ι₀ ≫ ψ₀) s₀ w₁
    have he1 := Limits.pullback.lift_fst (m ≫ e₀) ε' w₂
    have he2 := Limits.pullback.lift_snd (m ≫ e₀) ε' w₂
    have Pκ : IsPullback (Limits.pullback.lift (ι₀ ≫ ψ₀) s₀ w₁) ι₀
        (Limits.pullback.fst F t) ψ₀ := by
      refine IsPullback.of_right ?_ hκ1 Q.flip
      rw [hκ2, hf]; exact hps.flip
    have Pe : IsPullback (Limits.pullback.lift (m ≫ e₀) ε' w₂) m
        (Limits.pullback.fst F t) e₀ := by
      refine IsPullback.of_right ?_ he1 Q.flip
      rw [he2, hu]; exact hU.flip
    haveI Wκ : WeaklyEtale (Limits.pullback.lift (ι₀ ≫ ψ₀) s₀ w₁) :=
      MorphismProperty.of_isPullback (P := @WeaklyEtale) Pκ.flip hψ
    haveI We : WeaklyEtale (Limits.pullback.lift (m ≫ e₀) ε' w₂) :=
      MorphismProperty.of_isPullback (P := @WeaklyEtale) Pe.flip he
    have hcomm : hb ≫ Limits.pullback.lift (m ≫ e₀) ε' w₂ =
        c₀ ≫ Limits.pullback.lift (ι₀ ≫ ψ₀) s₀ w₁ := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, he1, h1, Category.assoc, hκ1]
      · rw [Category.assoc, he2, h2, Category.assoc, hκ2]
    haveI : WeaklyEtale (hb ≫ Limits.pullback.lift (m ≫ e₀) ε' w₂) := by
      rw [hcomm]; infer_instance
    exact WeaklyEtale.of_comp hb (Limits.pullback.lift (m ≫ e₀) ε' w₂)
  intro R _ cR hcR j y hy

  have hA : WeaklyEtale a₀ := wc_shdata_weaklyEtale x₀ B₀ Λ₀ W₀ φ₀ a₀ hsh
  have hψ : WeaklyEtale ψ := MorphismProperty.of_isPullback (P := @WeaklyEtale) hpbψ.flip hA

  have hF : ψ ≫ r₁ ≫ Spec.map (CommRingCat.ofHom
      (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)))) = f := hψf.trans hblf
  have hu : e j ≫ r₁ ≫ Spec.map (CommRingCat.ofHom
      (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)))) =
      Spec.map (CommRingCat.ofHom (algebraMap A' (wcQmbtChart A' n π' (c.map ιA) j))) := by
    rw [← Category.assoc, he j, ← Spec.map_comp, ← CommRingCat.ofHom_comp, hφA j]

  have hrange : Set.range (cR ≫ ι' ≫ ψ) ⊆ Set.range (e j) := by
    rintro _ ⟨p, rfl⟩
    have hsp : (cR ≫ ι' ≫ ψ) p ⤳ (cR ≫ ι' ≫ ψ) (IsLocalRing.closedPoint R) :=
      (IsLocalRing.specializes_closedPoint p).map (cR ≫ ι' ≫ ψ).continuous
    refine hsp.mem_open (IsOpenImmersion.isOpen_range (e j)) ⟨y, ?_⟩
    first
    | exact hy.trans ((Scheme.Hom.comp_apply cR (ι' ≫ ψ) _).trans
        (Scheme.Hom.comp_apply ι' ψ _)).symm
    | exact hy
  obtain ⟨h, hh⟩ : ∃ h : Spec R ⟶ Spec (.of (wcQmbtChart A' n π' (c.map ιA) j)),
      h ≫ e j = cR ≫ ι' ≫ ψ := ⟨_, IsOpenImmersion.lift_fac _ _ hrange⟩

  obtain ⟨ε, hsq⟩ := La (A₀ := A') (C₀ := wcQmbtChart A' n π' (c.map ιA) j) hπ'
  have w : h ≫ Spec.map (CommRingCat.ofHom (algebraMap A' (wcQmbtChart A' n π' (c.map ιA) j))) =
      (cR ≫ s') ≫ Spec.map (CommRingCat.ofHom (IsLocalRing.residue A')) := by
    calc h ≫ Spec.map (CommRingCat.ofHom (algebraMap A' (wcQmbtChart A' n π' (c.map ιA) j)))
        = (h ≫ e j) ≫ r₁ ≫ Spec.map (CommRingCat.ofHom
            (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)))) := by
          rw [Category.assoc, hu]
      _ = cR ≫ ι' ≫ (ψ ≫ r₁ ≫ Spec.map (CommRingCat.ofHom
            (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA))))) := by
          rw [hh]; simp only [Category.assoc]
      _ = cR ≫ ι' ≫ f := by rw [hF]
      _ = (cR ≫ s') ≫ Spec.map (CommRingCat.ofHom (IsLocalRing.residue A')) := by
          rw [hps'.toCommSq.w, Category.assoc]
  obtain ⟨hb, hb1, hb2⟩ : ∃ hb : Spec R ⟶ Spec (.of (wcQmbtChart A' n π' (c.map ιA) j ⧸
        Ideal.span {algebraMap A' (wcQmbtChart A' n π' (c.map ιA) j) π'})),
      hb ≫ Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk
        (Ideal.span {algebraMap A' (wcQmbtChart A' n π' (c.map ιA) j) π'}))) = h ∧
      hb ≫ Spec.map (CommRingCat.ofHom ε) = cR ≫ s' :=
    ⟨hsq.lift h (cR ≫ s') w, hsq.lift_fst _ _ _, hsq.lift_snd _ _ _⟩
  have hρ : Spec.map (CommRingCat.ofHom (Spec.preimage hb).hom) = hb := Spec.map_preimage hb

  refine ⟨(Spec.preimage hb).hom, ?_, ?_⟩
  ·
    have hWb : WeaklyEtale hb :=
      Lb ψ _ f hF (wcQmSp A') ι' s' hps' (e j) _ hu _ _ hsq cR hb
        (by rw [← Category.assoc, hb1, hh]) hb2 hψ inferInstance hcR
    rw [hρ]
    exact hWb
  ·
    rw [CommRingCat.ofHom_comp, Spec.map_comp, hρ, Category.assoc, ← Category.assoc hb, hb1, hh]

theorem wc_qmbt_D1l_chart_quot_val {A' : Type u} [CommRing A'] [IsLocalRing A'] {π' : A'}
    (hπ' : IsLocalRing.maximalIdeal A' = Ideal.span {π'}) {n : ℕ}
    (c' : Matrix (Fin n) (Fin n) A') (j : Fin n) :
    ∃ τ : (wcQmbtChart A' n π' c' j ⧸
        Ideal.span {algebraMap A' (wcQmbtChart A' n π' c' j) π'}) →+*
      (MvPolynomial (Option (Fin n)) (IsLocalRing.ResidueField A') ⧸
        Ideal.span {MvPolynomial.X none, wcQmbtBofQhat (IsLocalRing.ResidueField A') n
          (c'.map (IsLocalRing.residue A')) j}),
      Function.Surjective τ ∧
      RingHom.ker τ = Ideal.span {Ideal.Quotient.mk _
        (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j) (MvPolynomial.X none))} ∧
      ∀ f : MvPolynomial (Option (Fin n)) A',
        τ (Ideal.Quotient.mk _ (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j) f)) =
          Ideal.Quotient.mk _ (MvPolynomial.map (IsLocalRing.residue A') f) :=
by
  classical
  set I := wcQmbtChartIdeal A' n π' c' j with hI
  set J : Ideal (wcQmbtChart A' n π' c' j) :=
    Ideal.span {algebraMap A' (wcQmbtChart A' n π' c' j) π'} with hJ
  set Qk := wcQmbtBofQhat (IsLocalRing.ResidueField A') n (c'.map (IsLocalRing.residue A')) j
    with hQk
  set ID : Ideal (MvPolynomial (Option (Fin n)) (IsLocalRing.ResidueField A')) :=
    Ideal.span {MvPolynomial.X none, Qk} with hID
  set Q : MvPolynomial (Option (Fin n)) A' :=
    ∑ p, ∑ q, MvPolynomial.C (c' p q) * wcQmbtChartHat j p * wcQmbtChartHat j q with hQ

  have s1 : MvPolynomial.map (IsLocalRing.residue A') Q = Qk := by
    simp only [hQ, hQk, wcQmbtBofQhat, map_sum, map_mul, MvPolynomial.map_C, Matrix.map_apply]
    refine Finset.sum_congr rfl (fun p _ => Finset.sum_congr rfl (fun q _ => ?_))
    simp only [wcQmbtChartHat]
    split_ifs <;> simp

  have s2 : IsLocalRing.residue A' π' = 0 :=
    (IsLocalRing.residue_eq_zero_iff π').mpr (hπ' ▸ Ideal.mem_span_singleton_self π')

  let μ : MvPolynomial (Option (Fin n)) A' →+*
      (MvPolynomial (Option (Fin n)) (IsLocalRing.ResidueField A') ⧸ ID) :=
    (Ideal.Quotient.mk ID).comp (MvPolynomial.map (IsLocalRing.residue A'))
  have hμ : ∀ f, μ f = Ideal.Quotient.mk ID (MvPolynomial.map (IsLocalRing.residue A') f) :=
    fun f => rfl
  have hμsurj : Function.Surjective μ :=
    Ideal.Quotient.mk_surjective.comp
      (MvPolynomial.map_surjective _ IsLocalRing.residue_surjective)
  have hXn : Ideal.Quotient.mk ID (MvPolynomial.X none) = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_insert _ _))
  have hQk0 : Ideal.Quotient.mk ID Qk = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.mpr
      (Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _)))

  have h1 : I ≤ RingHom.ker μ := by
    rw [hI, Ideal.span_le, Set.insert_subset_iff, Set.singleton_subset_iff]
    constructor
    · rw [SetLike.mem_coe, RingHom.mem_ker, hμ]
      simp only [map_sub, map_mul, MvPolynomial.map_X, MvPolynomial.map_C, s2, map_zero, hXn,
        mul_zero, sub_zero]
    · rw [SetLike.mem_coe, RingHom.mem_ker]
      show Ideal.Quotient.mk ID (MvPolynomial.map (IsLocalRing.residue A')
        (Q - MvPolynomial.X none ^ 2)) = 0
      rw [map_sub, s1, map_pow, MvPolynomial.map_X, map_sub, map_pow, hQk0, hXn]
      simp
  let μ₁ : wcQmbtChart A' n π' c' j →+*
      (MvPolynomial (Option (Fin n)) (IsLocalRing.ResidueField A') ⧸ ID) :=
    Ideal.Quotient.lift I μ (fun a ha => h1 ha)

  have ha : algebraMap A' (wcQmbtChart A' n π' c' j) π' =
      Ideal.Quotient.mk I (MvPolynomial.C π') := by
    rw [← MvPolynomial.algebraMap_eq, Ideal.Quotient.mk_algebraMap]
  have h2 : ∀ z ∈ J, μ₁ z = 0 := by
    intro z hz
    obtain ⟨b, rfl⟩ := Ideal.mem_span_singleton'.mp hz
    rw [map_mul, ha]
    show μ₁ b * μ (MvPolynomial.C π') = 0
    rw [hμ, MvPolynomial.map_C, s2, map_zero, map_zero, mul_zero]
  let τ : (wcQmbtChart A' n π' c' j ⧸ J) →+*
      (MvPolynomial (Option (Fin n)) (IsLocalRing.ResidueField A') ⧸ ID) :=
    Ideal.Quotient.lift J μ₁ h2
  have hτ : ∀ f, τ (Ideal.Quotient.mk J (Ideal.Quotient.mk I f)) = μ f := fun f => rfl
  refine ⟨τ, ?_, ?_, fun f => hτ f⟩
  · intro y
    obtain ⟨f, rfl⟩ := hμsurj y
    exact ⟨_, hτ f⟩
  · apply le_antisymm
    · intro z hz
      rw [RingHom.mem_ker] at hz
      obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective z
      obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective y
      rw [hτ, hμ] at hz
      have hf := Ideal.Quotient.eq_zero_iff_mem.mp hz
      obtain ⟨α, β, hαβ⟩ := Ideal.mem_span_pair.mp hf
      obtain ⟨α₀, rfl⟩ := MvPolynomial.map_surjective _ IsLocalRing.residue_surjective α
      obtain ⟨β₀, rfl⟩ := MvPolynomial.map_surjective _ IsLocalRing.residue_surjective β
      have hg : f - (α₀ * MvPolynomial.X none + β₀ * Q) ∈
          RingHom.ker (MvPolynomial.map (σ := Option (Fin n)) (IsLocalRing.residue A')) := by
        rw [RingHom.mem_ker, map_sub, map_add, map_mul, map_mul, MvPolynomial.map_X, s1, hαβ,
          sub_self]
      rw [MvPolynomial.ker_map, IsLocalRing.ker_residue, hπ', Ideal.map_span,
        Set.image_singleton] at hg
      obtain ⟨γ, hγ⟩ := Ideal.mem_span_singleton'.mp hg
      have hf' : f = α₀ * MvPolynomial.X none + β₀ * Q + γ * MvPolynomial.C π' := by
        rw [hγ]; ring
      have hQI : Ideal.Quotient.mk I Q = Ideal.Quotient.mk I (MvPolynomial.X none ^ 2) :=
        Ideal.Quotient.eq.mpr (Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _)))
      have hJa : Ideal.Quotient.mk J (algebraMap A' (wcQmbtChart A' n π' c' j) π') = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _)
      have hQI' := congrArg (Ideal.Quotient.mk J) hQI
      have hCa : Ideal.Quotient.mk J (Ideal.Quotient.mk I (MvPolynomial.C π')) = 0 := by
        rw [← ha]; exact hJa
      have key : Ideal.Quotient.mk J (Ideal.Quotient.mk I f) =
          (Ideal.Quotient.mk J (Ideal.Quotient.mk I α₀) +
            Ideal.Quotient.mk J (Ideal.Quotient.mk I β₀) *
              Ideal.Quotient.mk J (Ideal.Quotient.mk I (MvPolynomial.X none))) *
            Ideal.Quotient.mk J (Ideal.Quotient.mk I (MvPolynomial.X none)) := by
        rw [hf']
        simp only [map_add, map_mul, map_pow] at hQI' ⊢
        linear_combination (Ideal.Quotient.mk J (Ideal.Quotient.mk I β₀)) * hQI' +
          (Ideal.Quotient.mk J (Ideal.Quotient.mk I γ)) * hCa
      exact Ideal.mem_span_singleton'.mpr ⟨_, key.symm⟩
    · rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker, hτ, hμ,
        MvPolynomial.map_X, hXn]

theorem wc_shens_quot_two_step_prime {C D E K : Type u} [CommRing C] [CommRing D] [CommRing E]
    [Field K] [Algebra K D] [Algebra K E] (R : CommRingCat.{u}) [HenselianLocalRing R]
    [IsSepClosed (IsLocalRing.ResidueField R)] (ρ : C →+* R)
    (hρ : WeaklyEtale (Spec.map (CommRingCat.ofHom ρ))) (τ : C →+* D) (hτ : Function.Surjective τ)
    (x : C) (hker : RingHom.ker τ = Ideal.span {x}) (hx : ρ x ∈ IsLocalRing.maximalIdeal R)
    (σ : D →+* E) (hσ : Function.Surjective σ) (y : C)
    (hkerσ : RingHom.ker σ = Ideal.span {τ y}) (hy : ρ y ∈ IsLocalRing.maximalIdeal R)
    (hnzd : τ y ∈ nonZeroDivisors D) (m m' : ℕ)
    (hsm : SmoothOfRelativeDimension m (Spec.map (CommRingCat.ofHom (algebraMap K D))))
    (hsm' : SmoothOfRelativeDimension m' (Spec.map (CommRingCat.ofHom (algebraMap K E)))) :
    (Ideal.span {ρ x}).IsPrime ∧
      Prime (Ideal.Quotient.mk (Ideal.span {ρ x}) (ρ y)) :=
by
  classical
  set I : Ideal R := Ideal.span {ρ x} with hI

  have hIp : I.IsPrime := wc_shens_quot_prime_of_smooth_target R ρ hρ τ hτ x hker hx m hsm

  have hne : I ≠ ⊤ := by
    intro h
    rw [hI, Ideal.span_singleton_eq_top] at h
    exact (IsLocalRing.mem_maximalIdeal _).mp hx h
  have hIle : I ≤ IsLocalRing.maximalIdeal R :=
    Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hx)

  obtain ⟨hH, hS⟩ := wc_quot_strictly_henselian_of_ne_top R I hne

  have hτx : τ x = 0 := by
    rw [← RingHom.mem_ker, hker]
    exact Ideal.mem_span_singleton_self x
  have hkill : RingHom.ker τ ≤ RingHom.ker ((Ideal.Quotient.mk I).comp ρ) := by
    intro a ha
    rw [hker, Ideal.mem_span_singleton] at ha
    obtain ⟨b, rfl⟩ := ha
    rw [RingHom.mem_ker, RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem, map_mul]
    exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _)
  obtain ⟨σ₁, hσ₁⟩ : ∃ σ₁ : D →+* R ⧸ I, σ₁.comp τ = (Ideal.Quotient.mk I).comp ρ :=
    ⟨_, RingHom.liftOfRightInverse_comp τ (Function.surjInv hτ)
      (Function.rightInverse_surjInv hτ) ⟨(Ideal.Quotient.mk I).comp ρ, hkill⟩⟩
  have hσc : ∀ c, σ₁ (τ c) = Ideal.Quotient.mk I (ρ c) := fun c => RingHom.congr_fun hσ₁ c
  have hsq : CommRingCat.ofHom ρ ≫ CommRingCat.ofHom (Ideal.Quotient.mk I) =
      CommRingCat.ofHom τ ≫ CommRingCat.ofHom σ₁ := by
    rw [← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp, hσ₁]
  have hs : ∀ (s : Limits.PushoutCocone (CommRingCat.ofHom ρ) (CommRingCat.ofHom τ)) (c : C),
      s.inl.hom (ρ c) = s.inr.hom (τ c) := by
    intro s c
    have := congrArg (fun φ => φ.hom c) s.condition
    simpa using this
  have hk : ∀ (s : Limits.PushoutCocone (CommRingCat.ofHom ρ) (CommRingCat.ofHom τ)),
      ∀ a ∈ I, s.inl.hom a = 0 := by
    intro s a ha
    obtain ⟨b, rfl⟩ := Ideal.mem_span_singleton.mp ha
    rw [map_mul, hs s x, hτx, map_zero, zero_mul]
  have hpo : IsPushout (CommRingCat.ofHom ρ) (CommRingCat.ofHom τ)
      (CommRingCat.ofHom (Ideal.Quotient.mk I)) (CommRingCat.ofHom σ₁) := by
    refine IsPushout.of_isColimit (Limits.PushoutCocone.IsColimit.mk hsq
      (fun s => CommRingCat.ofHom (Ideal.Quotient.lift I s.inl.hom (hk s))) ?_ ?_ ?_)
    · intro s
      ext a
      simp
    · intro s
      ext d
      obtain ⟨c, rfl⟩ := hτ d
      simp [hσc, hs s c]
    · intro s m h1 _
      ext a
      have := congrArg (fun φ => φ.hom a) h1
      simpa using this
  have hpb := isPullback_SpecMap_of_isPushout _ _ _ _ hpo
  have hσet : WeaklyEtale (Spec.map (CommRingCat.ofHom σ₁)) :=
    MorphismProperty.of_isPullback (P := @WeaklyEtale) hpb hρ

  haveI := hH
  haveI := hS
  have hyb : Ideal.Quotient.mk I (ρ y) ∈ IsLocalRing.maximalIdeal (R ⧸ I) := by
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    intro hu
    obtain ⟨b, hb⟩ := hu.exists_right_inv
    obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective b
    rw [← map_mul, ← map_one (Ideal.Quotient.mk I), Ideal.Quotient.eq] at hb
    have h1 : ρ y * r - 1 ∈ IsLocalRing.maximalIdeal R := hIle hb
    have h2 : ρ y * r ∈ IsLocalRing.maximalIdeal R := Ideal.mul_mem_right _ _ hy
    have h3 : (1 : R) ∈ IsLocalRing.maximalIdeal R := by
      have := Ideal.sub_mem _ h2 h1
      simpa using this
    exact (IsLocalRing.maximalIdeal.isMaximal R).ne_top ((Ideal.eq_top_iff_one _).mpr h3)
  have hx₂ : σ₁ (τ y) ∈ IsLocalRing.maximalIdeal (CommRingCat.of (R ⧸ I)) := by
    rw [hσc]; exact hyb

  have hJp : (Ideal.span {σ₁ (τ y)}).IsPrime :=
    wc_shens_quot_prime_of_smooth_target (K := K) (CommRingCat.of (R ⧸ I)) σ₁ hσet σ hσ
      (τ y) hkerσ hx₂ m' hsm'

  have hy0 : Ideal.Quotient.mk I (ρ y) ≠ 0 := by
    intro h0
    have hfl : (CommRingCat.ofHom σ₁).hom.Flat := Flat.SpecMap_iff.mp hσet.flat
    letI := σ₁.toAlgebra
    haveI : Module.Flat D (R ⧸ I) := hfl
    have hreg : IsSMulRegular (R ⧸ I) (τ y) :=
      Module.Flat.isSMulRegular_of_nonZeroDivisors hnzd
    haveI : Nontrivial (R ⧸ I) := Ideal.Quotient.nontrivial_iff.mpr hne
    apply one_ne_zero (α := R ⧸ I)
    apply hreg
    show (τ y) • (1 : R ⧸ I) = (τ y) • (0 : R ⧸ I)
    rw [smul_zero, Algebra.smul_def, mul_one, RingHom.algebraMap_toAlgebra, hσc, h0]
  rw [hσc] at hJp
  exact ⟨hIp, (Ideal.span_singleton_prime hy0).mp hJp⟩

theorem wc_qmbt_D1Y_chart_xj_nzd (K : Type u) [CommRing K] (n : ℕ)
    (c : Matrix (Fin n) (Fin n) K) (j : Fin n) :
    Ideal.Quotient.mk (Ideal.span {MvPolynomial.X none, wcQmbtBofQhat K n c j})
        (MvPolynomial.X (some j)) ∈
      nonZeroDivisors (MvPolynomial (Option (Fin n)) K ⧸
        Ideal.span {MvPolynomial.X none, wcQmbtBofQhat K n c j}) :=
by
  classical
  let ε : MvPolynomial (Option (Fin n)) K →ₐ[K] MvPolynomial (Option (Fin n)) K :=
    MvPolynomial.aeval (fun k : Option (Fin n) =>
      if k = some j then (0 : MvPolynomial (Option (Fin n)) K) else MvPolynomial.X k)
  have hεX : ∀ k, ε (MvPolynomial.X k) = if k = some j then 0 else MvPolynomial.X k :=
    fun k => MvPolynomial.aeval_X _ k
  have hεC : ∀ r : K, ε (MvPolynomial.C r) = MvPolynomial.C r := fun r => by
    show MvPolynomial.aeval _ (MvPolynomial.C r) = _
    rw [MvPolynomial.aeval_C, MvPolynomial.algebraMap_eq]
  have hεN : ε (MvPolynomial.X none) = MvPolynomial.X none := by
    rw [hεX]; simp
  have hεj : ε (MvPolynomial.X (some j)) = 0 := by
    rw [hεX]; simp
  have hεhat : ∀ p, ε (wcQmbtChartHat (A' := K) j p) = wcQmbtChartHat (A' := K) j p := by
    intro p
    by_cases hp : p = j
    · rw [hp]; simp [wcQmbtChartHat]
    · simp [wcQmbtChartHat, hp, hεX]
  have hεQ : ε (wcQmbtBofQhat K n c j) = wcQmbtBofQhat K n c j := by
    simp only [wcQmbtBofQhat, map_sum, map_mul, hεC, hεhat]
  have hdiv : ∀ g, MvPolynomial.X (some j) ∣ g - ε g := by
    intro g
    induction g using MvPolynomial.induction_on with
    | C a => rw [hεC, sub_self]; exact dvd_zero _
    | add p q hp hq =>
      rw [map_add, add_sub_add_comm]; exact dvd_add hp hq
    | mul_X p k hp =>
      rw [map_mul, hεX]
      by_cases hk : k = some j
      · rw [if_pos hk, mul_zero, sub_zero, hk]; exact dvd_mul_left _ _
      · rw [if_neg hk, ← sub_mul]; exact hp.mul_right _
  rw [mem_nonZeroDivisors_iff_right]
  intro y hy
  obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective y
  rw [← map_mul, Ideal.Quotient.eq_zero_iff_mem] at hy
  rw [Ideal.Quotient.eq_zero_iff_mem]
  obtain ⟨a, b, hab⟩ := Ideal.mem_span_pair.mp hy
  have h2 := congrArg ε hab
  rw [map_add, map_mul, map_mul, map_mul, hεN, hεQ, hεj, mul_zero] at h2
  obtain ⟨a', ha'⟩ := hdiv a
  obtain ⟨b', hb'⟩ := hdiv b
  have key : MvPolynomial.X (some j) * f =
      MvPolynomial.X (some j) * (a' * MvPolynomial.X none + b' * wcQmbtBofQhat K n c j) := by
    linear_combination (-1 : MvPolynomial (Option (Fin n)) K) * hab + h2 +
      MvPolynomial.X none * ha' + wcQmbtBofQhat K n c j * hb'
  rw [MvPolynomial.X_mul_cancel_left_iff] at key
  exact Ideal.mem_span_pair.mpr ⟨a', b', key.symm⟩

theorem wc_qmbt_D1Y_chart_Y_quot (K : Type u) [Field K] {n : ℕ} (c : Matrix (Fin n) (Fin n) K)
    (hc : IsUnit (c + c.transpose).det) (j : Fin n) :
    ∃ σ : (MvPolynomial (Option (Fin n)) K ⧸
        Ideal.span {MvPolynomial.X none, wcQmbtBofQhat K n c j}) →+*
      (MvPolynomial (Option (Fin n)) K ⧸ Ideal.span (Set.range (wcQmbtBofRelDiv K n c j))),
      Function.Surjective σ ∧
      RingHom.ker σ = Ideal.span {Ideal.Quotient.mk
        (Ideal.span {MvPolynomial.X none, wcQmbtBofQhat K n c j}) (MvPolynomial.X (some j))} ∧
      SmoothOfRelativeDimension (n - 2) (Spec.map (CommRingCat.ofHom (algebraMap K
        (MvPolynomial (Option (Fin n)) K ⧸ Ideal.span (Set.range (wcQmbtBofRelDiv K n c j)))))) :=
by
  classical
  set I₀ : Ideal (MvPolynomial (Option (Fin n)) K) :=
    Ideal.span {MvPolynomial.X none, wcQmbtBofQhat K n c j} with hI₀
  set J : Ideal (MvPolynomial (Option (Fin n)) K) :=
    Ideal.span (Set.range (wcQmbtBofRelDiv K n c j)) with hJ
  have h0 : MvPolynomial.X (some j) ∈ J := Ideal.subset_span ⟨0, rfl⟩
  have h1 : MvPolynomial.X none ∈ J := Ideal.subset_span ⟨1, rfl⟩
  have h2 : wcQmbtBofQhat K n c j ∈ J := Ideal.subset_span ⟨2, rfl⟩
  have hle : I₀ ≤ J := by
    rw [hI₀, Ideal.span_le, Set.insert_subset_iff, Set.singleton_subset_iff]
    exact ⟨h1, h2⟩
  have hker : RingHom.ker (Ideal.Quotient.factor hle) =
      Ideal.span {Ideal.Quotient.mk I₀ (MvPolynomial.X (some j))} := by
    rw [Ideal.Quotient.factor_ker]
    apply le_antisymm
    · rw [hJ, Ideal.map_span, Ideal.span_le]
      rintro _ ⟨_, ⟨i, rfl⟩, rfl⟩
      fin_cases i
      · exact Ideal.subset_span rfl
      · have : Ideal.Quotient.mk I₀ (MvPolynomial.X none) = 0 :=
          Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_insert _ _))
        show Ideal.Quotient.mk I₀ (MvPolynomial.X none) ∈ _
        rw [this]
        exact Submodule.zero_mem _
      · have : Ideal.Quotient.mk I₀ (wcQmbtBofQhat K n c j) = 0 :=
          Ideal.Quotient.eq_zero_iff_mem.mpr
            (Ideal.subset_span (Set.mem_insert_of_mem _ rfl))
        show Ideal.Quotient.mk I₀ (wcQmbtBofQhat K n c j) ∈ _
        rw [this]
        exact Submodule.zero_mem _
    · rw [Ideal.span_le, Set.singleton_subset_iff]
      exact Ideal.mem_map_of_mem _ h0
  have hv : ∀ p : {p : Fin n // p ≠ j},
      Function.Injective (![some j, none, some p.1] : Fin 3 → Option (Fin n)) := by
    intro p a b h
    have hp := p.2
    fin_cases a <;> fin_cases b <;> simp_all [eq_comm]
  have hmain := wc_qmbt_bof_jacobian_cover_smooth K (wcQmbtBofRelDiv K n c j) J rfl
    (ι := {p : Fin n // p ≠ j}) (fun p => ![some j, none, some p.1]) hv
    (wc_qmbt_bof_minors_divisor c hc j)
  have hcard : Fintype.card (Option (Fin n)) - 3 = n - 2 := by
    rw [Fintype.card_option, Fintype.card_fin]; omega
  rw [hcard] at hmain
  exact ⟨Ideal.Quotient.factor hle, Ideal.Quotient.factor_surjective hle, hker, hmain⟩

theorem wc_away_prime_not_pow (D : Type u) [CommRing D] [IsDomain D] (w : D) (hw : Prime w)
    (ℓ : ℕ) (hℓ : 2 ≤ ℓ) :
    ¬ ∃ c : Localization.Away w, c ^ ℓ = algebraMap D (Localization.Away w) w :=
by
  rintro ⟨c, hc⟩
  have hw0 : w ≠ 0 := hw.ne_zero
  obtain ⟨k, rfl⟩ : ∃ k, ℓ = k + 2 := ⟨ℓ - 2, by omega⟩
  have core : ∀ n : ℕ, ∀ a : D, a ^ (k + 2) ≠ w ^ (n * (k + 2) + 1) := by
    intro n
    induction n with
    | zero =>
      intro a h
      have hdvd : w ∣ a ^ (k + 2) := by
        rw [h]; exact dvd_pow_self w (by omega)
      obtain ⟨b, rfl⟩ := hw.dvd_of_dvd_pow hdvd
      have e : w * (w * (w ^ k * b ^ (k + 2))) = w * 1 := by
        calc w * (w * (w ^ k * b ^ (k + 2))) = (w * b) ^ (k + 2) := by ring
          _ = w ^ (0 * (k + 2) + 1) := h
          _ = w * 1 := by ring
      have e2 : w * (w ^ k * b ^ (k + 2)) = 1 := mul_left_cancel₀ hw0 e
      exact hw.2.1 (isUnit_iff_exists_inv.mpr ⟨_, e2⟩)
    | succ n ih =>
      intro a h
      have hdvd : w ∣ a ^ (k + 2) := by
        rw [h]; exact dvd_pow_self w (by omega)
      obtain ⟨b, rfl⟩ := hw.dvd_of_dvd_pow hdvd
      have e : w ^ (k + 2) * b ^ (k + 2) = w ^ (k + 2) * w ^ (n * (k + 2) + 1) := by
        calc w ^ (k + 2) * b ^ (k + 2) = (w * b) ^ (k + 2) := by ring
          _ = w ^ ((n + 1) * (k + 2) + 1) := h
          _ = w ^ (k + 2) * w ^ (n * (k + 2) + 1) := by ring
      exact ih b (mul_left_cancel₀ (pow_ne_zero _ hw0) e)
  obtain ⟨n, a, ha⟩ := IsLocalization.Away.surj w c
  have hinj : Function.Injective (algebraMap D (Localization.Away w)) :=
    IsLocalization.injective (Localization.Away w) (powers_le_nonZeroDivisors_of_noZeroDivisors hw0)
  apply core n a
  apply hinj
  rw [map_pow, map_pow, ← ha, mul_pow, hc]
  ring

theorem wc_affine_clopen_patch_unit (X : Scheme.{u}) [IsAffine X] (C : Set X) (hC : IsClopen C)
    (f : Γ(X, ⊤)) (O : X.Opens) (hO : ∀ x ∈ C, x ∈ O → x ∈ X.basicOpen f) :
    ∃ s : Γ(X, ⊤), IsUnit (O.ι.appTop.hom s) ∧
      ∀ (T : Scheme.{u}) (κ : T ⟶ X), Set.range κ ⊆ C → κ.appTop.hom s = κ.appTop.hom f :=
by
  have hB : ∀ (g : Γ(X, ⊤)) (x : X), x ∈ X.basicOpen g ↔ g ∉ (X.toSpecΓ x).asIdeal := by
    intro g x
    rw [← Scheme.toSpecΓ_preimage_basicOpen]
    exact PrimeSpectrum.mem_basicOpen _ _
  have hU : ∀ (Y : Scheme.{u}) (g : Γ(Y, ⊤)), (∀ y, y ∈ Y.basicOpen g) → IsUnit g := by
    intro Y g h
    apply RingedSpace.isUnit_of_isUnit_germ Y.toRingedSpace ⊤ g
    intro y _
    exact (Scheme.mem_basicOpen_top Y g y).mp (h y)
  have hC' : IsClopen ((fun y => X.isoSpec.inv y) ⁻¹' C) := hC.preimage X.isoSpec.inv.continuous
  obtain ⟨ε, hε, hεC⟩ := PrimeSpectrum.exists_idempotent_basicOpen_eq_of_isClopen hC'
  have hCε : ∀ x : X, x ∈ C ↔ x ∈ X.basicOpen ε := by
    intro x
    rw [hB]
    have h1 : x ∈ C ↔ X.isoSpec.hom x ∈ (fun y => X.isoSpec.inv y) ⁻¹' C := by
      simp only [Set.mem_preimage, Scheme.hom_inv_apply]
    rw [h1, hεC, Scheme.isoSpec_hom]
    exact PrimeSpectrum.mem_basicOpen _ _
  have key : ∀ x : X, x ∈ O → (ε * f + (1 - ε)) ∉ (X.toSpecΓ x).asIdeal := by
    intro x hxO hs
    have hPp : (X.toSpecΓ x).asIdeal.IsPrime := (X.toSpecΓ x).isPrime
    by_cases he : ε ∈ (X.toSpecΓ x).asIdeal
    · apply hPp.ne_top
      rw [Ideal.eq_top_iff_one]
      have h1 : 1 - ε ∈ (X.toSpecΓ x).asIdeal := by
        have := Ideal.sub_mem _ hs (Ideal.mul_mem_right f _ he)
        simpa using this
      have := Ideal.add_mem _ he h1
      simpa using this
    · have hxC : x ∈ C := (hCε x).mpr ((hB ε x).mpr he)
      have hf : f ∉ (X.toSpecΓ x).asIdeal := (hB f x).mp (hO x hxC hxO)
      have h0 : ε * (1 - ε) ∈ (X.toSpecΓ x).asIdeal := by
        have : ε * (1 - ε) = 0 := by rw [mul_sub, mul_one, hε.eq, sub_self]
        rw [this]; exact Ideal.zero_mem _
      have h1 : 1 - ε ∈ (X.toSpecΓ x).asIdeal := (hPp.mem_or_mem h0).resolve_left he
      have h2 : ε * f ∈ (X.toSpecΓ x).asIdeal := by
        have := Ideal.sub_mem _ hs h1
        simpa using this
      rcases hPp.mem_or_mem h2 with h | h
      · exact he h
      · exact hf h
  refine ⟨ε * f + (1 - ε), ?_, ?_⟩
  · apply hU
    intro y
    rw [← Scheme.preimage_basicOpen_top]
    show O.ι y ∈ X.basicOpen _
    have hyO : O.ι y ∈ O := by
      rw [← SetLike.mem_coe, ← Scheme.Opens.range_ι]
      exact ⟨y, rfl⟩
    exact (hB _ _).mpr (key _ hyO)
  · intro T κ hκ
    have hidem : IsIdempotentElem (κ.appTop.hom ε) := hε.map κ.appTop.hom
    have hunit : IsUnit (κ.appTop.hom ε) := by
      apply hU
      intro t
      rw [← Scheme.preimage_basicOpen_top]
      show κ t ∈ X.basicOpen ε
      exact (hCε _).mp (hκ ⟨t, rfl⟩)
    have h1 : κ.appTop.hom ε = 1 := (IsIdempotentElem.iff_eq_one_of_isUnit hunit).mp hidem
    rw [map_add, map_mul, map_sub, map_one, h1]
    ring

theorem wc_closedImm_stalk_ker_le {X' X : Scheme.{u}} (p : X' ⟶ X) [IsClosedImmersion p] (z : X')
    (P : Spec (X.presheaf.stalk (p z))) (hP : X.fromSpecStalk (p z) P ∈ Set.range p) :
    RingHom.ker (p.stalkMap z).hom ≤ P.asIdeal :=
by
  have hy : X.fromSpecStalk (p z) P ⤳ p z := by
    have h : X.fromSpecStalk (p z) P ∈ Set.range ⇑(X.fromSpecStalk (p z)) := ⟨P, rfl⟩
    rw [Scheme.range_fromSpecStalk] at h
    exact h
  obtain ⟨w, hw⟩ := hP
  have hwz : w ⤳ z := by
    have h1 : p w ⤳ p z := by rw [hw]; exact hy
    exact (IsClosedImmersion.isClosedEmbedding p).isInducing.specializes_iff.mp h1
  have hwr : w ∈ Set.range ⇑(X'.fromSpecStalk z) := by
    rw [Scheme.range_fromSpecStalk]; exact hwz
  obtain ⟨Q, hQ⟩ := hwr
  have hsq := Scheme.SpecMap_stalkMap_fromSpecStalk p (x := z)
  have h5 : X.fromSpecStalk (p z) ((Spec.map (p.stalkMap z)) Q) = X.fromSpecStalk (p z) P := by
    have := congrArg (fun g => g Q) hsq
    simp only [Scheme.Hom.comp_apply] at this
    rw [this, hQ, hw]
  have h6 : (Spec.map (p.stalkMap z)) Q = P :=
    (Scheme.Hom.isEmbedding (X.fromSpecStalk (p z))).injective h5
  intro a ha
  rw [RingHom.mem_ker] at ha
  rw [← h6]
  show a ∈ Ideal.comap (p.stalkMap z).hom Q.asIdeal
  rw [Ideal.mem_comap, ha]
  exact Q.asIdeal.zero_mem

theorem wc_stalk_punct_section_map {X' : Scheme.{u}} (z : X') (O : X'.Opens) (B : CommRingCat.{u})
    (ϑ : X'.presheaf.stalk z ⟶ B)
    (hO : ∀ t : Spec B, X'.fromSpecStalk z (Spec.map ϑ t) ∈ O) :
    ∃ Λ : Γ(Limits.pullback (X'.fromSpecStalk z) O.ι, ⊤) →+* B, ∀ g : Γ(X', ⊤),
      Λ ((Limits.pullback.snd (X'.fromSpecStalk z) O.ι).appTop.hom (O.ι.appTop.hom g)) =
        (Scheme.ΓSpecIso B).hom.hom ((Spec.map ϑ ≫ X'.fromSpecStalk z).appTop.hom g) :=
by
  have hrange : Set.range (Spec.map ϑ ≫ X'.fromSpecStalk z) ⊆ Set.range O.ι := by
    rintro _ ⟨t, rfl⟩
    rw [Scheme.Opens.range_ι]
    exact hO t
  let h : Spec B ⟶ O.toScheme :=
    IsOpenImmersion.lift O.ι (Spec.map ϑ ≫ X'.fromSpecStalk z) hrange
  have hh : h ≫ O.ι = Spec.map ϑ ≫ X'.fromSpecStalk z := IsOpenImmersion.lift_fac _ _ _
  let k : Spec B ⟶ Limits.pullback (X'.fromSpecStalk z) O.ι :=
    Limits.pullback.lift (Spec.map ϑ) h hh.symm
  have hk : k ≫ Limits.pullback.snd (X'.fromSpecStalk z) O.ι = h := Limits.pullback.lift_snd _ _ _
  have e : k ≫ Limits.pullback.snd (X'.fromSpecStalk z) O.ι ≫ O.ι =
      Spec.map ϑ ≫ X'.fromSpecStalk z := by
    rw [← Category.assoc, hk, hh]
  refine ⟨(k.appTop ≫ (Scheme.ΓSpecIso B).hom).hom, fun g => ?_⟩
  rw [← e, Scheme.Hom.comp_appTop, Scheme.Hom.comp_appTop]
  rfl

