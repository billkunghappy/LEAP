      have w : Limits.pullback.fst (c i) (c j) ≫ Proj.awayι _ (ℓ i) (hℓ' i) one_pos =
          Limits.pullback.snd (c i) (c j) ≫ Proj.awayι _ (ℓ j) (hℓ' j) one_pos := by
        rw [← K1 i, ← K1 j, ← Category.assoc, Limits.pullback.condition, Category.assoc]
      have e1 := Proj.pullbackAwayιIso_inv_fst
        (MvPolynomial.homogeneousSubmodule (Fin (2 * m + 1 + 1)) Ω) (hℓ' i) one_pos (hℓ' j) one_pos
        (rfl : ℓ i * ℓ j = ℓ i * ℓ j)
      have e2 := Proj.pullbackAwayιIso_inv_snd
        (MvPolynomial.homogeneousSubmodule (Fin (2 * m + 1 + 1)) Ω) (hℓ' i) one_pos (hℓ' j) one_pos
        (rfl : ℓ i * ℓ j = ℓ i * ℓ j)
      obtain ⟨t, ht1, ht2⟩ : ∃ t : Limits.pullback (c i) (c j) ⟶ Spec (CommRingCat.of
          (HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (2 * m + 1 + 1)) Ω)
            (ℓ i * ℓ j))),
          Limits.pullback.fst (c i) (c j) = t ≫
            Spec.map (CommRingCat.ofHom (HomogeneousLocalization.awayMap _ (hℓ' j)
              (rfl : ℓ i * ℓ j = ℓ i * ℓ j))) ∧
          Limits.pullback.snd (c i) (c j) = t ≫
            Spec.map (CommRingCat.ofHom (HomogeneousLocalization.awayMap _ (hℓ' i)
              (mul_comm (ℓ i) (ℓ j)))) := by
        refine ⟨Limits.pullback.lift _ _ w ≫
          (Proj.pullbackAwayιIso (MvPolynomial.homogeneousSubmodule (Fin (2 * m + 1 + 1)) Ω) (hℓ' i)
            one_pos (hℓ' j) one_pos (rfl : ℓ i * ℓ j = ℓ i * ℓ j)).hom, ?_, ?_⟩
        · rw [Category.assoc, ← e1, Iso.hom_inv_id_assoc, Limits.pullback.lift_fst]
        · rw [Category.assoc, ← e2, Iso.hom_inv_id_assoc, Limits.pullback.lift_snd]
      rw [ht1, ht2, Category.assoc, Category.assoc, cocycle i j]
    let π : (U : Scheme) ⟶ wcProjK Ω m := 𝒰.glueMorphisms f hglue
    have hπ : ∀ i, c i ≫ π = f i := fun i => 𝒰.ι_glueMorphisms f hglue i

    have hcomp : ∀ y, φ' (φ y) = y := by
      intro y
      refine MvPolynomial.induction_on (motive := fun y => φ' (φ y) = y) y ?_ ?_ ?_
      · intro a
        rw [hφ, MvPolynomial.aeval_C, MvPolynomial.algebraMap_eq]
        exact hC a
      · intro p q hp hq
        rw [map_add, map_add, hp, hq]
      · intro p n hp
        rw [map_mul, map_mul, hp, hφX, hℓX]
    have hpre' : ∀ i, Proj.map φ' hφ' ⁻¹ᵁ
        Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (2 * m + 1 + 1)) Ω) (ℓ i) =
        Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) Ω) (MvPolynomial.X i) :=
      fun i => by rw [Proj.map_preimage_basicOpen, hℓX]
    have htopB : (⨆ i, Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) Ω)
        (MvPolynomial.X i) : (wcProjK Ω m).Opens) = ⊤ :=
      Proj.iSup_basicOpen_eq_top _ _ (hcovG (m + 1))
    have hrng : Set.range (Proj.map φ' hφ') ⊆ Set.range U.ι := by
      rintro _ ⟨x, rfl⟩
      rw [Scheme.Opens.range_ι]
      have hx : x ∈ (⨆ i, Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) Ω)
          (MvPolynomial.X i) : (wcProjK Ω m).Opens) := by
        rw [htopB]; trivial
      obtain ⟨i, hi⟩ := TopologicalSpace.Opens.mem_iSup.mp hx
      rw [← hpre' i] at hi
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨i, (Scheme.Hom.mem_preimage _).mp hi⟩
    let t : wcProjK Ω m ⟶ (U : Scheme) := IsOpenImmersion.lift U.ι (Proj.map φ' hφ') hrng
    have ht : t ≫ U.ι = Proj.map φ' hφ' := IsOpenImmersion.lift_fac _ _ _
    refine ⟨π, t, ht, ?_⟩
    let e : ∀ i, Spec (CommRingCat.of (HomogeneousLocalization.Away
        (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) Ω) (φ' (ℓ i)))) ⟶ wcProjK Ω m :=
      fun i => Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) Ω) (φ' (ℓ i))
        (φ'.map_mem (hℓ' i)) one_pos
    have hcovE : ∀ z : wcProjK Ω m, ∃ i w, e i w = z := by
      intro z
      have hz : z ∈ (⨆ i, Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) Ω)
          (MvPolynomial.X i) : (wcProjK Ω m).Opens) := by
        rw [htopB]; trivial
      obtain ⟨i, hi⟩ := TopologicalSpace.Opens.mem_iSup.mp hz
      have hz' : z ∈ (Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) Ω) (φ' (ℓ i))
          (φ'.map_mem (hℓ' i)) one_pos).opensRange := by
        rw [Proj.opensRange_awayι]
        show z ∈ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) Ω) (φ' (ℓ i))
        rw [hℓX i]
        exact hi
      obtain ⟨w, hw⟩ := Scheme.Hom.mem_opensRange.mp hz'
      exact ⟨i, w, hw⟩
    let 𝒱 : (wcProjK Ω m).OpenCover :=
      Scheme.Cover.mkOfCovers (P := @IsOpenImmersion) (Fin (m + 1)) _ e hcovE
        (fun i => inferInstance)
    refine 𝒱.hom_ext _ _ (fun (i : Fin (m + 1)) => ?_)
    change e i ≫ t ≫ π = e i ≫ 𝟙 _
    rw [Category.comp_id]
    have h1 : e i ≫ t = Spec.map (CommRingCat.ofHom
        (HomogeneousLocalization.Away.map φ' (ℓ i))) ≫ c i := by
      rw [← cancel_mono U.ι, Category.assoc, ht, Category.assoc, K1 i]
      exact Proj.awayι_comp_map φ' hφ' one_pos (ℓ i) (hℓ' i)
    have hx1 : φ' (ℓ i) = MvPolynomial.X i * 1 := by rw [hℓX, mul_one]
    have key : (HomogeneousLocalization.Away.map φ' (ℓ i)).comp
        (HomogeneousLocalization.map φ (h i)) =
        HomogeneousLocalization.awayMap (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) Ω)
          (SetLike.one_mem_graded _) hx1 := by
      refine RingHom.ext fun z => ?_
      obtain ⟨n, a, ha, rfl⟩ := HomogeneousLocalization.Away.mk_surjective _ (hy i) z
      rw [RingHom.comp_apply, L1, HomogeneousLocalization.Away.map_mk,
        HomogeneousLocalization.awayMap_mk]
      apply HomogeneousLocalization.val_injective
      rw [HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.Away.val_mk]
      congr 1
      rw [hcomp, one_pow, mul_one]
    rw [← Category.assoc, h1, Category.assoc, hπ i]
    simp only [f]
    rw [← Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp, key,
      Proj.SpecMap_awayMap_awayι]
    try rfl



  have transfer : ∀ {P Pm : Scheme.{u}} (i₁ i₂ : Pm ⟶ Y) (L₁ L₂ : Pm ⟶ P) (j : Y ⟶ P),
      IsClosedImmersion j → i₁ ≫ j = L₁ → i₂ ≫ j = L₂ → ∀ (U : P.Opens),
      (U : Set P) = (Set.range L₁)ᶜ → ∀ (π₀ : (U : Scheme.{u}) ⟶ Pm) (t : Pm ⟶ (U : Scheme.{u})),
      t ≫ U.ι = L₂ → t ≫ π₀ = 𝟙 _ →
      ∃ (O : Y.Opens) (π : (O : Scheme.{u}) ⟶ Pm) (s : Pm ⟶ (O : Scheme.{u})),
        (O : Set Y) = (Set.range i₁)ᶜ ∧ s ≫ O.ι = i₂ ∧ s ≫ π = 𝟙 _ := by
    intro P Pm i₁ i₂ L₁ L₂ j hj h₁ h₂ U hU π₀ t ht htπ
    haveI := hj
    have hinj : Function.Injective j := j.isClosedEmbedding.isEmbedding.injective
    have hr : Set.range i₂ ⊆ Set.range (j ⁻¹ᵁ U).ι := by
      rw [Scheme.Opens.range_ι]
      rintro _ ⟨x, rfl⟩
      have e1 : (i₂ ≫ j) x = (t ≫ U.ι) x := by rw [h₂, ht]
      have e2 : U.ι (t x) ∈ (U : Set P) := by rw [← Scheme.Opens.range_ι]; exact ⟨t x, rfl⟩
      rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at e1
      show i₂ x ∈ j ⁻¹ᵁ U
      rw [Scheme.Hom.mem_preimage, e1]
      exact e2
    refine ⟨j ⁻¹ᵁ U, morphismRestrict j U ≫ π₀, IsOpenImmersion.lift (j ⁻¹ᵁ U).ι i₂ hr, ?_,
      IsOpenImmersion.lift_fac _ _ _, ?_⟩
    · ext y
      rw [SetLike.mem_coe, Scheme.Hom.mem_preimage, ← SetLike.mem_coe, hU, Set.mem_compl_iff,
        Set.mem_compl_iff]
      apply not_congr
      constructor
      · rintro ⟨x, hx⟩
        have e2 : (i₁ ≫ j) x = L₁ x := by rw [h₁]
        rw [Scheme.Hom.comp_apply] at e2
        exact ⟨x, hinj (e2.trans hx)⟩
      · rintro ⟨x, rfl⟩
        exact ⟨x, by rw [← h₁, Scheme.Hom.comp_apply]⟩
    · have e3 : IsOpenImmersion.lift (j ⁻¹ᵁ U).ι i₂ hr ≫ morphismRestrict j U = t := by
        rw [← cancel_mono U.ι, Category.assoc, morphismRestrict_ι, ← Category.assoc,
          IsOpenImmersion.lift_fac, h₂, ht]
      rw [← Category.assoc, e3, htπ]



  obtain ⟨φE, hfE, hCE, hXE, hciE, hstrE, hrgE, hsubE⟩ := plane 1 0 rfl
  obtain ⟨φF, hfF, hCF, hXF, hciF, hstrF, hrgF, hsubF⟩ := plane 0 1 rfl
  haveI hsm : SmoothOfRelativeDimension m (wcProjKStr Ω m) := wc_proj_space_smooth Ω m
  haveI : ∀ x : wcProjK Ω m, _root_.IsReduced ((wcProjK Ω m).presheaf.stalk x) := fun x => by
    haveI := wcpa_smooth_stalk_isDomain Ω (wcProjK Ω m) (wcProjKStr Ω m) m x
    infer_instance
  haveI : IsReduced (wcProjK Ω m) := isReduced_of_isReduced_stalk _
  obtain ⟨i, hi⟩ := wc_ap_reduced_factor_closed_immersion (wcProjK Ω m) Y (wcProjK Ω (2 * m + 1))
    (Proj.map φE hfE) jY hsubE
  obtain ⟨i', hi'⟩ := wc_ap_reduced_factor_closed_immersion (wcProjK Ω m) Y (wcProjK Ω (2 * m + 1))
    (Proj.map φF hfF) jY hsubF
  have hici : IsClosedImmersion i := by
    haveI : IsClosedImmersion (i ≫ jY) := by rw [hi]; exact hciE
    exact IsClosedImmersion.of_comp i jY
  have hici' : IsClosedImmersion i' := by
    haveI : IsClosedImmersion (i' ≫ jY) := by rw [hi']; exact hciF
    exact IsClosedImmersion.of_comp i' jY

  obtain ⟨π₀, t, ht, htπ⟩ := proj
    (fun k => MvPolynomial.X (⟨2 * k.val + 1, by have := k.isLt; omega⟩ : Fin (2 * m + 1 + 1)))
    (fun k => MvPolynomial.isHomogeneous_X Ω _) φF hfF hCF hXF
  have hU : ((⨆ k : Fin (m + 1), Proj.basicOpen
      (MvPolynomial.homogeneousSubmodule (Fin (2 * m + 1 + 1)) Ω)
      (MvPolynomial.X (⟨2 * k.val + 1, by have := k.isLt; omega⟩ : Fin (2 * m + 1 + 1))) :
        (wcProjK Ω (2 * m + 1)).Opens) : Set (wcProjK Ω (2 * m + 1))) =
      (Set.range (Proj.map φE hfE))ᶜ := by
    ext p
    rw [Set.mem_compl_iff, hrgE p, SetLike.mem_coe, TopologicalSpace.Opens.mem_iSup, not_forall]
    simp only [Proj.mem_basicOpen]
  obtain ⟨O, π, s, hO, hs, hsπ⟩ := transfer i i' (Proj.map φE hfE) (Proj.map φF hfF) jY hjY hi hi'
    _ hU π₀ t ht htπ

  obtain ⟨π₀', t', ht', htπ'⟩ := proj
    (fun k => MvPolynomial.X (⟨2 * k.val + 0, by have := k.isLt; omega⟩ : Fin (2 * m + 1 + 1)))
    (fun k => MvPolynomial.isHomogeneous_X Ω _) φE hfE hCE hXE
  have hU' : ((⨆ k : Fin (m + 1), Proj.basicOpen
      (MvPolynomial.homogeneousSubmodule (Fin (2 * m + 1 + 1)) Ω)
      (MvPolynomial.X (⟨2 * k.val + 0, by have := k.isLt; omega⟩ : Fin (2 * m + 1 + 1))) :
        (wcProjK Ω (2 * m + 1)).Opens) : Set (wcProjK Ω (2 * m + 1))) =
      (Set.range (Proj.map φF hfF))ᶜ := by
    ext p
    rw [Set.mem_compl_iff, hrgF p, SetLike.mem_coe, TopologicalSpace.Opens.mem_iSup, not_forall]
    simp only [Proj.mem_basicOpen]
  obtain ⟨O', π', s', hO', hs', hsπ'⟩ := transfer i' i (Proj.map φF hfF) (Proj.map φE hfE) jY hjY
    hi' hi _ hU' π₀' t' ht' htπ'
  refine ⟨i, i', O, O', π, s, π', s', hici, hici', ?_, ?_, hO, hO', hs, hsπ, hs', hsπ'⟩
  · rw [← hjf, ← Category.assoc, hi, hstrE]
  · rw [← hjf, ← Category.assoc, hi', hstrF]

theorem wc_ysi_smooth_pair_supp_vanish_of_hm (K : Type u) [Field K] [IsAlgClosed K]
    {Y Z : Scheme.{u}} (pY : Y ⟶ Spec (.of K)) [IsSeparated pY] [CompactSpace Y]
    [IsLocallyNoetherian Y] [IrreducibleSpace Y]
    (n m r : ℕ) (hmr : m + r = n) [SmoothOfRelativeDimension n pY]
    (i : Z ⟶ Y) [IsClosedImmersion i] [IrreducibleSpace Z] [SmoothOfRelativeDimension m (i ≫ pY)]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : K) ≠ 0)
    (Di : wcHMPullData i ℓ) (hDi : wcHMPullCanonical Di)
    (j N : ℕ) (hN : j + 2 * r = N) (hZ : ∀ x : wcHM Z ℓ j, x = 0) :
    ∀ θ : wcSuppExt Di N, θ = 0 :=
by
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf Y ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf Z ℓ)) := HasExt.standard _
  let L := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ Di.cont Di.φ
  haveI hLadd : L.Additive := @Adjunction.right_adjoint_additive _ _ _ _ _ _ _ _ Di.adj Di.additive
  haveI hLlim : Limits.PreservesFiniteLimits L := by
    haveI : Limits.PreservesLimitsOfSize.{0, 0} L := Di.adj.rightAdjoint_preservesLimits
    first
      | exact Limits.PreservesLimitsOfSize.preservesFiniteLimits L
      | infer_instance
  haveI hLcolim : Limits.PreservesFiniteColimits L :=
    wc_closed_pushforward_exact_of_noetherian i ℓ Di
  haveI hLadj : L.IsLeftAdjoint := wc_proet_closed_push_isLeftAdjoint i ℓ Di hDi
  let R := L.rightAdjoint
  let adj : L ⊣ R := Adjunction.ofIsLeftAdjoint L
  haveI hRadd : R.Additive := Adjunction.right_adjoint_additive adj
  haveI := sheafOfModules_enoughInjectives (Scheme.ProEt.topology Y) (wcRingSheaf Y ℓ)
  let I := injectiveResolution (SheafOfModules.unit (wcRingSheaf Y ℓ))
  obtain ⟨ψ, hψ⟩ :=
    wc_smooth_pair_qcsep_proet_shriek_top_trivial K pY n m r hmr i ℓ hℓ Di hDi R adj I
  haveI := hψ
  have hvan : ∀ q : ℕ, q ≠ 2 * r →
      Limits.IsZero (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q) := by
    intro q hq
    rcases Nat.lt_or_gt_of_ne hq with h | h
    · exact wc_smooth_pair_qcsep_proet_shriek_low_vanish K pY n m r hmr i ℓ hℓ Di hDi R adj I q h
    · exact wc_smooth_pair_qcsep_proet_shriek_high_vanish K pY n m r hmr i ℓ hℓ Di hDi R adj I q h
  obtain ⟨τ, hτ⟩ := ext_shifted_degenerate_leray_bijective L R adj
    (SheafOfModules.unit (wcRingSheaf Y ℓ)) I (SheafOfModules.unit (wcRingSheaf Z ℓ)) (2 * r) ψ hvan
  intro θ
  obtain ⟨y, hy⟩ := (hτ (SheafOfModules.unit (wcRingSheaf Z ℓ)) j N hN).2 θ
  have hy0 : y = 0 := hZ y
  rw [← hy]
  show (Abelian.Ext.mapExactFunctor L y).comp τ hN = 0
  rw [hy0, Abelian.Ext.mapExactFunctor_zero, Abelian.Ext.zero_comp]

theorem wc_ysi_proj_space_hm_one_vanish (K : Type u) [Field K] [IsAlgClosed K] (ℓ : ℕ)
    [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : K) ≠ 0) (m : ℕ) :
    ∀ x : wcHM (wcProjK K m) ℓ 1, x = 0 :=
by
  haveI hpr : IsProper (wcProjKStr K m) := wc_proj_space_isProper K m
  haveI hc : CompactSpace (wcProjK K m) :=
    QuasiCompact.compactSpace_of_compactSpace (wcProjKStr K m)
  haveI hq : QuasiSeparatedSpace (wcProjK K m) :=
    quasiSeparatedSpace_of_quasiSeparated (wcProjKStr K m)
  haveI hs : IsSeparated (Limits.terminal.from (wcProjK K m)) := by
    have h : IsSeparated (wcProjKStr K m ≫ Limits.terminal.from (Spec (.of K))) :=
      inferInstance
    rwa [Limits.terminal.comp_from] at h
  haveI hc' : CompactSpace (Scheme.ProEt.mk (𝟙 (wcProjK K m))).left := hc
  haveI hs' : IsSeparated (Limits.terminal.from (Scheme.ProEt.mk (𝟙 (wcProjK K m))).left) := hs
  have h1 : Subsingleton (wcEtCoh (wcProjK K m) ℓ (0 + 1)) :=
    wc_et_proj_space_odd_vanish K ℓ hℓ m 1 odd_one
  have h2 : ∀ k : ℕ, ∀ y : Abelian.Ext (wcFreeSheaf (wcProjK K m)
      (Scheme.ProEt.mk (𝟙 (wcProjK K m))))
      (wcZModSheaf (wcProjK K m) (ℓ ^ (k + 1))) (0 + 1), y = 0 :=
    fun k y => wc_proet_free_zmod_ext_vanish_of_et_qcsep (wcProjK K m)
      (Scheme.ProEt.mk (𝟙 (wcProjK K m))) (ℓ ^ (k + 1)) (0 + 1)
      (wc_et_coh_zmod_prime_pow_of_prime (wcProjK K m) ℓ Fact.out (0 + 1) h1 k) y
  have h3 := wc_proet_int_ext_vanish_of_zmod_deg (wcProjK K m) ℓ
    (Scheme.ProEt.mk (𝟙 (wcProjK K m))) 0 h2
  exact wc_hm_vanish_of_int_ext_vanish (wcProjK K m) ℓ 0 h3

theorem wc_ysi_proj_space_top_ne_zero (K : Type u) [Field K] [IsAlgClosed K] (ℓ : ℕ)
