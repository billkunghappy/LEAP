theorem wc_ysi_two_plane_mid_two_indep (K : Type u) [Field K] [IsAlgClosed K] (ℓ : ℕ)
    [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : K) ≠ 0) (d m : ℕ) (hdm : d = 2 * m) {Y : Scheme.{u}}
    (pY : Y ⟶ Spec (.of K)) [IsProper pY] [IrreducibleSpace Y] [SmoothOfRelativeDimension d pY]
    (i i' : wcProjK K m ⟶ Y) [IsClosedImmersion i] [IsClosedImmersion i']
    (hi : i ≫ pY = wcProjKStr K m) (hi' : i' ≫ pY = wcProjKStr K m)
    (O O' : Y.Opens) (hO : (O : Set Y) = (Set.range i)ᶜ) (hO' : (O' : Set Y) = (Set.range i')ᶜ)
    (π : (O : Scheme.{u}) ⟶ wcProjK K m) (s : wcProjK K m ⟶ (O : Scheme.{u}))
    (hs : s ≫ O.ι = i') (hsπ : s ≫ π = 𝟙 _)
    (π' : (O' : Scheme.{u}) ⟶ wcProjK K m) (s' : wcProjK K m ⟶ (O' : Scheme.{u}))
    (hs' : s' ≫ O'.ι = i) (hsπ' : s' ≫ π' = 𝟙 _) :
    ∃ z₁ z₂ : wcHM Y ℓ d, z₁ ≠ 0 ∧ ∀ c : ℚ_[ℓ], z₂ ≠ wcHMScalar Y ℓ d c z₁ :=
by
  classical
  subst hdm
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf Y ℓ)) := HasExt.standard _

  haveI : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace pY
  haveI : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian pY
  haveI : IsLocallyNoetherian (O : Scheme.{u}) := isLocallyNoetherian_of_isOpenImmersion O.ι
  haveI : IsLocallyNoetherian (O' : Scheme.{u}) := isLocallyNoetherian_of_isOpenImmersion O'.ι
  haveI : IrreducibleSpace (wcProjK K m) := wc_proj_space_irreducible K m
  haveI : SmoothOfRelativeDimension m (i ≫ pY) := by rw [hi]; exact wc_proj_space_smooth K m
  haveI : SmoothOfRelativeDimension m (i' ≫ pY) := by rw [hi']; exact wc_proj_space_smooth K m
  obtain ⟨Di, hDi⟩ := wc_hm_pull_data_exists i ℓ
  obtain ⟨Di', hDi'⟩ := wc_hm_pull_data_exists i' ℓ
  obtain ⟨DO, hDO⟩ := wc_hm_pull_data_exists O.ι ℓ
  obtain ⟨DO', hDO'⟩ := wc_hm_pull_data_exists O'.ι ℓ
  obtain ⟨Dπ, hDπ⟩ := wc_hm_pull_data_exists π ℓ
  obtain ⟨Dπ', hDπ'⟩ := wc_hm_pull_data_exists π' ℓ
  obtain ⟨Ds, hDs⟩ := wc_hm_pull_data_exists s ℓ
  obtain ⟨Ds', hDs'⟩ := wc_hm_pull_data_exists s' ℓ
  obtain ⟨D1, hD1⟩ := wc_hm_pull_data_exists (𝟙 (wcProjK K m)) ℓ

  obtain ⟨ω₀, hω₀⟩ := wc_ysi_proj_space_top_ne_zero K ℓ hℓ m

  have hH1 := wc_ysi_proj_space_hm_one_vanish K ℓ hℓ m
  have hv : ∀ θ : wcSuppExt Di (2 * m + 1), θ = 0 :=
    wc_ysi_smooth_pair_supp_vanish_of_hm K pY (2 * m) m m (by omega) i ℓ hℓ Di hDi
      1 (2 * m + 1) (by omega) hH1
  have hv' : ∀ θ : wcSuppExt Di' (2 * m + 1), θ = 0 :=
    wc_ysi_smooth_pair_supp_vanish_of_hm K pY (2 * m) m m (by omega) i' ℓ hℓ Di' hDi'
      1 (2 * m + 1) (by omega) hH1

  have hsurj := wc_qcl_restrict_surj_of_supp_vanish i ℓ Di hDi O hO (2 * m) hv DO hDO
  have hsurj' := wc_qcl_restrict_surj_of_supp_vanish i' ℓ Di' hDi' O' hO' (2 * m) hv' DO' hDO'

  have hR : ∀ x : wcHM (wcProjK K m) ℓ (2 * m),
      wcHMPull Ds (2 * m) (wcHMPull Dπ (2 * m) x) = x := by
    intro x
    rw [← wc_hm_pull_comp π s (𝟙 _) hsπ Dπ hDπ Ds hDs D1 hD1 (2 * m) x]
    exact wc_hm_pull_id (𝟙 _) rfl D1 hD1 (2 * m) x
  have hR' : ∀ x : wcHM (wcProjK K m) ℓ (2 * m),
      wcHMPull Ds' (2 * m) (wcHMPull Dπ' (2 * m) x) = x := by
    intro x
    rw [← wc_hm_pull_comp π' s' (𝟙 _) hsπ' Dπ' hDπ' Ds' hDs' D1 hD1 (2 * m) x]
    exact wc_hm_pull_id (𝟙 _) rfl D1 hD1 (2 * m) x

  obtain ⟨ω, hω⟩ := hsurj (wcHMPull Dπ (2 * m) ω₀)
  obtain ⟨ω', hω'⟩ := hsurj' (wcHMPull Dπ' (2 * m) ω₀)
  have hiω' : wcHMPull Di (2 * m) ω' = ω₀ := by
    rw [wc_hm_pull_comp O'.ι s' i hs' DO' hDO' Ds' hDs' Di hDi (2 * m) ω', hω', hR']

  obtain ⟨τ, hτ⟩ := wc_smooth_pair_gysin_detect K pY (2 * m) m m (by omega) i ℓ hℓ Di hDi
    (2 * m) (2 * m) (2 * m + 2 * m) rfl rfl rfl (by omega)
  refine ⟨wcSuppClass Di (2 * m) τ, ω, ?_, ?_⟩
  · intro h0
    apply hτ ω' (by rw [hiω']; exact hω₀)
    rw [h0, map_zero]

  · intro c hc
    have hdisj : ∀ (t : ↥(O : Scheme.{u})) (z : ↥(wcProjK K m)), O.ι t ≠ i z := by
      intro t z h
      have h1 : O.ι t ∈ (O : Set Y) := by
        rw [← Scheme.Opens.range_ι]; exact ⟨t, rfl⟩
      rw [hO, h] at h1
      exact h1 ⟨z, rfl⟩
    have hcz : wcHMScalar Y ℓ (2 * m) c (wcSuppClass Di (2 * m) τ) =
        wcSuppClass Di (2 * m) (τ.comp (Abelian.Ext.mk₀ (wcHMConst Y ℓ c)) (add_zero _)) := by
      show ((Abelian.Ext.mk₀ (wcSuppUnitMap Di)).comp τ (zero_add _)).comp
          (Abelian.Ext.mk₀ (wcHMConst Y ℓ c)) (add_zero _) =
        (Abelian.Ext.mk₀ (wcSuppUnitMap Di)).comp
          (τ.comp (Abelian.Ext.mk₀ (wcHMConst Y ℓ c)) (add_zero _)) (zero_add _)
      exact Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ _
    have h0 := wc_supp_class_pull_zero_of_disjoint i O.ι hdisj Di hDi DO hDO (2 * m)
      (τ.comp (Abelian.Ext.mk₀ (wcHMConst Y ℓ c)) (add_zero _))
    rw [← hcz, ← hc, hω] at h0
    apply hω₀
    calc ω₀ = wcHMPull Ds (2 * m) (wcHMPull Dπ (2 * m) ω₀) := (hR ω₀).symm
      _ = 0 := by rw [h0, map_zero]

theorem wc_ysi_nonempty_even_quadric_mid_two_indep (k : Type u) [Field k] [IsSepClosed k] (ℓ : ℕ)
    [Fact (Nat.Prime ℓ)] (hℓ : ((ℓ : ℕ) : k) ≠ 0) (d : ℕ) (hd : Even d) (hd2 : 2 ≤ d)
    (E₀ : Over (Spec (.of k))) [IsProper E₀.hom] [SmoothOfRelativeDimension d E₀.hom]
    [Nonempty E₀.left]
    (jE : E₀.left ⟶ wcProjK k (d + 1)) (hjE : IsClosedImmersion jE)
    (hjEY : jE ≫ wcProjKStr k (d + 1) = E₀.hom)
    (a : Fin (d + 1 + 1) → Fin (d + 1 + 1) → k)
    (ha : (Matrix.of a + (Matrix.of a).transpose).det ≠ 0)
    (hEG : ∀ (x : E₀.left) (c : Fin (d + 1 + 1)) (hx : x ∈ jE ⁻¹ᵁ wcSgD k (d + 1) c),
      wcLdpGerm k (d + 1) jE (wcLdpQuad k (d + 1) a) c x hx ∈
        IsLocalRing.maximalIdeal (E₀.left.presheaf.stalk x)) :
    ∃ z₁ z₂ : wcHM E₀.left ℓ d, z₁ ≠ 0 ∧ ∀ c : ℚ_[ℓ], z₂ ≠ wcHMScalar E₀.left ℓ d c z₁ :=
by
  classical

  have L1 : ∀ {S S' : Scheme.{u}} {f : S' ⟶ S} (D : wcHMPullData f ℓ)
      (_hD : wcHMPullCanonical D) (n : ℕ) (c : ℚ_[ℓ]) (x : wcHM S ℓ n),
      wcHMPull D n (wcHMScalar S ℓ n c x) = wcHMScalar S' ℓ n c (wcHMPull D n x) := by
    intro S S' f D hD n c x
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S' ℓ)) := HasExt.standard _
    haveI := D.additive
    haveI := D.presLim
    haveI := D.presColim
    have hC : D.Φ.map (wcHMConst S ℓ c) ≫ D.μ.hom = D.μ.hom ≫ wcHMConst S' ℓ c := by
      rw [← wc_hm_pull_const D hD c, Iso.hom_inv_id_assoc]
    show (Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ
        (x.comp (Abelian.Ext.mk₀ (wcHMConst S ℓ c)) (add_zero n))).comp
          (Abelian.Ext.mk₀ D.μ.hom) (add_zero n)) (zero_add n) =
      ((Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ x).comp
          (Abelian.Ext.mk₀ D.μ.hom) (add_zero n)) (zero_add n)).comp
        (Abelian.Ext.mk₀ (wcHMConst S' ℓ c)) (add_zero n)
    rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
      Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, hC,
      ← Abelian.Ext.mk₀_comp_mk₀]
    simp only [Abelian.Ext.comp_assoc_of_third_deg_zero]

  obtain ⟨m, hm⟩ := hd
  have hdm : d = 2 * m := by omega
  have hm1 : 1 ≤ m := by omega
  have hde : Even d := ⟨m, hm⟩
  have hπ := IsPullback.of_hasPullback E₀.hom
    (Spec.map (CommRingCat.ofHom (algebraMap k (AlgebraicClosure k))))
  haveI : IsProper (Limits.pullback.snd E₀.hom
      (Spec.map (CommRingCat.ofHom (algebraMap k (AlgebraicClosure k))))) :=
    MorphismProperty.of_isPullback (P := @IsProper) hπ inferInstance
  haveI := smoothOfRelativeDimension_isStableUnderBaseChange d
  haveI : SmoothOfRelativeDimension d (Limits.pullback.snd E₀.hom
      (Spec.map (CommRingCat.ofHom (algebraMap k (AlgebraicClosure k))))) :=
    MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension d) hπ inferInstance
  haveI : Nonempty ↥(Limits.pullback E₀.hom
      (Spec.map (CommRingCat.ofHom (algebraMap k (AlgebraicClosure k))))) := by
    obtain ⟨x₀⟩ := (inferInstance : Nonempty E₀.left)
    obtain ⟨y₀⟩ := (inferInstance : Nonempty (PrimeSpectrum (AlgebraicClosure k)))
    obtain ⟨z, -, -⟩ := Scheme.Pullback.exists_preimage_pullback
      (f := E₀.hom) (g := Spec.map (CommRingCat.ofHom (algebraMap k (AlgebraicClosure k))))
      x₀ (y₀ : Spec (.of (AlgebraicClosure k))) (Subsingleton.elim (α := PrimeSpectrum k) _ _)
    exact ⟨z⟩
  have hℓΩ : (ℓ : AlgebraicClosure k) ≠ 0 := by
    rw [← map_natCast (algebraMap k (AlgebraicClosure k)) ℓ]
    exact (map_ne_zero _).mpr hℓ

  obtain ⟨jΩ, hjΩ, hjΩs, hEGΩ⟩ :=
    wc_quadric_germ_base_change k (AlgebraicClosure k) (d + 1) E₀ jE hjE hjEY a hEG

  set A : Matrix (Fin (d + 1 + 1)) (Fin (d + 1 + 1)) (AlgebraicClosure k) :=
    Matrix.of (fun p q => algebraMap k (AlgebraicClosure k) (a p q)) with hAdef
  have hA : (A + A.transpose).det ≠ 0 := by
    have h1 : A + A.transpose = (algebraMap k (AlgebraicClosure k)).mapMatrix
        (Matrix.of a + (Matrix.of a).transpose) := by
      ext p q
      simp [hAdef, Matrix.add_apply]
    rw [h1, ← RingHom.map_det]
    exact (map_ne_zero _).mpr ha

  obtain ⟨Pm, hPm, hnf⟩ :=
    wc_quadric_split_normal_form_alg_closed (AlgebraicClosure k) d hde A hA
  obtain ⟨jY, hjY, hjYs, hEGY⟩ := wc_quadric_germ_linear_change (AlgebraicClosure k) (d + 1)
    _ _ jΩ hjΩ hjΩs A hEGΩ Pm hPm
  rw [hnf] at hEGY

  have hR := wc_ysi_split_quadric_range (AlgebraicClosure k) d hde hd2 _ _ jY hjY hjYs hEGY
  haveI := wc_ysi_split_quadric_irreducible (AlgebraicClosure k) d hde (by omega) _ jY hjY hR
  obtain ⟨i, i', O, O', π, s, π', s', hi, hi', hif, hi'f, hO, hO', hs, hsπ, hs', hsπ'⟩ :=
    wc_ysi_split_quadric_planes (AlgebraicClosure k) d m hdm hm1 _ _ jY hjY hjYs hR
  haveI := hi
  haveI := hi'

  obtain ⟨z₁', z₂', hz₁', hz₂'⟩ := wc_ysi_two_plane_mid_two_indep (AlgebraicClosure k) ℓ hℓΩ
    d m hdm _ i i' hif hi'f O O' hO hO' π s hs hsπ π' s' hs' hsπ'

  obtain ⟨D, hD⟩ := wc_hm_pull_data_exists (Limits.pullback.fst E₀.hom
    (Spec.map (CommRingCat.ofHom (algebraMap k (AlgebraicClosure k))))) ℓ
  have B := wc_hm_sepclosed_base_change_pull_bij k (AlgebraicClosure k)
    (algebraMap k (AlgebraicClosure k)) E₀.left E₀.hom _ _ _ hπ ℓ hℓ D hD d
  obtain ⟨z₁, hz1⟩ := B.2 z₁'
  obtain ⟨z₂, hz2⟩ := B.2 z₂'
  refine ⟨z₁, z₂, ?_, ?_⟩
  · rintro rfl
    apply hz₁'
    rw [← hz1, map_zero]
  · intro c h
    apply hz₂' c
    rw [← hz2, ← hz1, h, L1 D hD]

theorem wc_ysi_Yset_nonempty {A : Type u} [CommRing A] [IsDomain A]
    [IsDiscreteValuationRing A]
    [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (hℓ : IsUnit ((ℓ : ℕ) : A)) {n : ℕ} (hn : Even n) (hn4 : 4 ≤ n) {π : A}
    {c : Matrix (Fin n) (Fin n) A}
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π}) (hc : IsUnit (c + c.transpose).det)
    {x₀ : Spec (.of (wcQuadModelRing A n π c))}
    (hx₀ : ∀ p, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
      PrimeSpectrum.asIdeal x₀)
    {B₀ : Type u} [CommRing B₀] [HenselianLocalRing B₀] [IsSepClosed (IsLocalRing.ResidueField B₀)]
    {Λ₀ : Type u} [SmallCategory Λ₀] [IsCofiltered Λ₀]
    {W₀ : Λ₀ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (wcQuadModelRing A n π c))) x₀))
      (Scheme.Etale.forget (Spec (.of (wcQuadModelRing A n π c))))}
    {φ₀ : ∀ l, Spec (.of B₀) ⟶ (W₀.obj l).right.left}
    {a₀ : Spec (.of B₀) ⟶ Spec (.of (wcQuadModelRing A n π c))}
    (hsh : wcHalShData x₀ B₀ Λ₀ W₀ φ₀ a₀)
    {Xs : Scheme.{u}} {ι : Xs ⟶ Spec (.of B₀)} {s : Xs ⟶ Spec (.of (IsLocalRing.ResidueField A))}
    (hps : IsPullback ι s (a₀ ≫ wcQuadModelStr A n π c) (wcQmSp A))
    {A' : Type u} [CommRing A'] [IsDomain A'] [IsDiscreteValuationRing A'] [HenselianLocalRing A']
    [IsSepClosed (IsLocalRing.ResidueField A')] {ιA : A →+* A'} {π' : A'}
    (hℓ' : IsUnit ((ℓ : ℕ) : A')) (hπ' : IsLocalRing.maximalIdeal A' = Ideal.span {π'})
    (hπ'2 : π' ^ 2 = ιA π) (hgen : ∀ a' : A', ∃ x y : A, a' = ιA x + ιA y * π')
    {Xm : Scheme.{u}} {f : Xm ⟶ Spec (.of A')}
    {bl : Xm ⟶ Limits.pullback (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))}
    (hbl : wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range
      (fun i : Option (Fin n) => Option.elim i
        ((Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of A')).inv.hom π'))
        (fun j => ((Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))) ≫ a₀).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A n π c))).inv.hom
            (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X j)))))))) bl)
    (hblf : bl ≫ Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA)) = f)
    {Xs' : Scheme.{u}} {ι' : Xs' ⟶ Xm} {s' : Xs' ⟶ Spec (.of (IsLocalRing.ResidueField A'))}
    (hps' : IsPullback ι' s' f (wcQmSp A')) :
    (closure ((fun z => (ι' ≫ bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
        (Spec.map (CommRingCat.ofHom ιA))) z) ⁻¹' {IsLocalRing.closedPoint B₀})ᶜ ∩
      (fun z => (ι' ≫ bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
        (Spec.map (CommRingCat.ofHom ιA))) z) ⁻¹' {IsLocalRing.closedPoint B₀}).Nonempty :=
by
  classical

  have hπ0 : π ≠ 0 := by
    intro h0
    apply IsDiscreteValuationRing.not_a_field A
    rw [hπ, h0]
    exact Ideal.span_singleton_eq_bot.mpr rfl
  have h3 : 3 ≤ n := by omega
  have hQmCI : IsClosedImmersion (wcQmSp A') :=
    IsClosedImmersion.spec_of_surjective _ IsLocalRing.residue_surjective

  obtain ⟨hNoeth, hm, hWE⟩ := wc_qmbt_ecc_shens_maximal hπ hx₀ hsh
  haveI : IsNoetherianRing B₀ := hNoeth
  letI : Algebra (wcQuadModelRing A n π c) B₀ := (Spec.preimage a₀).hom.toAlgebra
  haveI : Algebra.WeaklyEtale (wcQuadModelRing A n π c) B₀ := hWE
  haveI : Module.Flat (wcQuadModelRing A n π c) B₀ := Algebra.WeaklyEtale.flat

  have hmax : ∀ q : PrimeSpectrum B₀, (∀ p : Fin n, (Spec.preimage a₀).hom
        (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p)) ∈ q.asIdeal) →
      q = IsLocalRing.closedPoint B₀ := by
    intro q hq
    have hle : IsLocalRing.maximalIdeal B₀ ≤ q.asIdeal := by
      rw [hm, Ideal.span_le]
      rintro _ ⟨p, rfl⟩
      exact hq p
    apply PrimeSpectrum.ext
    exact ((IsLocalRing.maximalIdeal.isMaximal B₀).eq_of_le q.isPrime.ne_top hle).symm

  have hKR := wc_flat_koszul_regular_transfer (wcQuadModelRing A n π c) B₀ n
    (fun p => Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p))
    (wc_qm_koszul_regular_any_order n π hπ0 c)

  have hrel : Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
      (∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q -
        MvPolynomial.C π) = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_singleton _))
  have hcub0 : (Spec.preimage a₀).hom (algebraMap A (wcQuadModelRing A n π c) π) -
      ∑ a, ∑ b, (c.map ((Spec.preimage a₀).hom.comp
          (algebraMap A (wcQuadModelRing A n π c)))) a b *
        (Spec.preimage a₀).hom (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X a)) *
        (Spec.preimage a₀).hom (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X b))
      = 0 := by
    have key : (Spec.preimage a₀).hom (algebraMap A (wcQuadModelRing A n π c) π) -
        ∑ a, ∑ b, (c.map ((Spec.preimage a₀).hom.comp
            (algebraMap A (wcQuadModelRing A n π c)))) a b *
          (Spec.preimage a₀).hom (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X a)) *
          (Spec.preimage a₀).hom (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X b))
        = -(Spec.preimage a₀).hom (Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
          (∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q -
            MvPolynomial.C π)) := by
      simp only [map_sub, map_sum, map_mul, Matrix.map_apply, RingHom.comp_apply, neg_sub]
      try rfl
    rw [key, hrel, map_zero, neg_zero]
  have hdet : IsUnit ((c.map ((Spec.preimage a₀).hom.comp
        (algebraMap A (wcQuadModelRing A n π c)))) +
      (c.map ((Spec.preimage a₀).hom.comp
        (algebraMap A (wcQuadModelRing A n π c)))).transpose).det := by
    have e : (c.map ((Spec.preimage a₀).hom.comp (algebraMap A (wcQuadModelRing A n π c)))) +
        (c.map ((Spec.preimage a₀).hom.comp
          (algebraMap A (wcQuadModelRing A n π c)))).transpose =
        ((Spec.preimage a₀).hom.comp (algebraMap A (wcQuadModelRing A n π c))).mapMatrix
          (c + c.transpose) := by
      ext i j
      simp [RingHom.mapMatrix_apply, Matrix.add_apply, Matrix.transpose_apply]
    rw [e, ← RingHom.map_det]
    exact hc.map _
  have hprime := wc_qmbt_ecc_odp_prime_of_koszul (B := B₀) h3
    (fun p => (Spec.preimage a₀).hom
      (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p)))
    hm hKR ((Spec.preimage a₀).hom (algebraMap A (wcQuadModelRing A n π c) π))
    (c.map ((Spec.preimage a₀).hom.comp (algebraMap A (wcQuadModelRing A n π c))))
    (by rw [hcub0]; exact zero_mem _) hdet

  set t : Fin n → B₀ := fun p => (Spec.preimage a₀).hom
      (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p)) with ht_def
  set hB : B₀ := (Spec.preimage a₀).hom (algebraMap A (wcQuadModelRing A n π c) π) with hB_def
  have hKR' : ∀ (U : Set (Fin n)) (j : Fin n), j ∉ U → ∀ s : B₀,
      t j * s ∈ Ideal.span (t '' U) → s ∈ Ideal.span (t '' U) := hKR
  have hspan : Ideal.span {hB} ≠ IsLocalRing.maximalIdeal B₀ := by
    intro hEq
    have htm : ∀ a, t a ∈ IsLocalRing.maximalIdeal B₀ := fun a => by
      rw [hm]; exact Ideal.subset_span ⟨a, rfl⟩
    have hhmm : hB ∈ IsLocalRing.maximalIdeal B₀ * IsLocalRing.maximalIdeal B₀ := by
      have hh : hB = ∑ a, ∑ b, (c.map ((Spec.preimage a₀).hom.comp
          (algebraMap A (wcQuadModelRing A n π c)))) a b * t a * t b := sub_eq_zero.mp hcub0
      rw [hh]
      refine Ideal.sum_mem _ (fun a _ => Ideal.sum_mem _ (fun b _ => ?_))
      exact Ideal.mul_mem_mul (Ideal.mul_mem_left _ _ (htm a)) (htm b)
    rw [← hEq, Ideal.span_singleton_mul_span_singleton] at hhmm
    obtain ⟨r, hr⟩ := Ideal.mem_span_singleton'.mp hhmm
    have hrh : r * hB ∈ IsLocalRing.maximalIdeal B₀ := by
