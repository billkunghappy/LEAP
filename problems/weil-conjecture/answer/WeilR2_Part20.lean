  obtain ⟨h, hh1, hh2⟩ : ∃ h : Xs' ⟶ Limits.pullback t (wcQmSp A'),
      h ≫ Limits.pullback.fst t (wcQmSp A') = ι' ≫ ψ ∧
      h ≫ Limits.pullback.snd t (wcQmSp A') = s' :=
    ⟨Limits.pullback.lift _ _ hcond, Limits.pullback.lift_fst _ _ _,
      Limits.pullback.lift_snd _ _ _⟩
  have hout : IsPullback ι' (h ≫ Limits.pullback.snd t (wcQmSp A')) (ψ ≫ t) (wcQmSp A') := by
    rw [hh2]; exact hps₂
  have htop := IsPullback.of_bot hout hh1.symm (IsPullback.of_hasPullback t (wcQmSp A'))
  have hPf := htop.flip.paste_vert hsq
  haveI : Flat h := MorphismProperty.of_isPullback (P := @Flat) hPf.flip inferInstance
  have hgenh : GeneralizingMap h := Flat.generalizingMap h
  have hge : ∀ y : Xs', Limits.pullback.fst t (wcQmSp A') (h y) = ψ (ι' y) := by
    intro y
    have h1 : (h ≫ Limits.pullback.fst t (wcQmSp A')) y = (ι' ≫ ψ) y := by rw [hh1]
    simpa only [Scheme.Hom.comp_apply] using h1

  obtain ⟨o, ho, hθo⟩ := wc_qmbt_hlsc_theta_fibre hπ hx₀ hπ' hπ'2 θ hθX hθA
  obtain ⟨hx1, hx2, -⟩ := wc_qmbt_hlsc_x0_fibre hπ hx₀ hsh
  obtain ⟨_, -, -, hgmax⟩ := wc_qmdl_gen_ideal_maximal hπ' n (c.map ιA)
