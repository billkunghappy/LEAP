          ((n : ℤ) - 1)).map_comp _ _).symm.trans (congrArg _ hφ)
    have gen4 : ∀ {X₀ Y₀ Y₁ Z₁ ZX C₀ C₁ W₁ : DerivedCategory
        (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))}
        (a : X₀ ⟶ Y₀) (b : Y₀ ⟶ Y₁) (ab : X₀ ⟶ Y₁) (e' : Y₁ ⟶ Z₁) (eX : X₀ ⟶ ZX)
