    intro K _ d X jE _ G hprime hEG hsup
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) K) :=
      MvPolynomial.gradedAlgebra
    obtain ⟨DG, hDG⟩ : ∃ U : (wcProjK K (d + 1)).Opens, U = @Proj.basicOpen _ _ _ _ _
        (MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) K) MvPolynomial.gradedAlgebra
        (G : MvPolynomial (Fin (d + 1 + 1)) K) := ⟨_, rfl⟩
    have hX : ∀ k : Fin (d + 1 + 1), (MvPolynomial.X k : MvPolynomial (Fin (d + 1 + 1)) K) ∈
