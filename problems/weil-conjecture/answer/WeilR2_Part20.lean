          HasExt.standard _
        Abelian.Ext (wcSuppObj DV) (Dv.Φ.obj (wcSuppObj Di)) 2) → wcSuppExt Dj₁ 2,
      ∀ z : V.left, IsClosed ({z} : Set V.left) →
      z ∈ Set.range ⇑(Limits.pullback.fst V.hom iY) →
      ∀ (Ez : wcHMPullData (V.left.fromSpecStalk z) ℓ) (_ : wcHMPullCanonical Ez)
        (Dz : wcHMPullData (Limits.pullback.fst (V.left.fromSpecStalk z)
          (Limits.pullback.fst V.hom iY)) ℓ) (_ : wcHMPullCanonical Dz)
        (γz : wcSuppObj Dz ⟶ Ez.Φ.obj (wcSuppObj DV)),
        wcSuppUnitMap Dz ≫ γz = Ez.μ.inv ≫ Ez.Φ.map (wcSuppUnitMap DV) →
        Epi (wcSuppUnitMap Dz) →
      ∀ z₁ : ↥(Limits.pullback V.hom i), IsClosed ({z₁} : Set ↥(Limits.pullback V.hom i)) →
        Limits.pullback.fst V.hom i z₁ = z →
      ∀ (Df : wcHMPullData ((Limits.pullback V.hom i).fromSpecStalk z₁) ℓ)
        (_ : wcHMPullCanonical Df)
        (Dj' : wcHMPullData (Limits.pullback.fst ((Limits.pullback V.hom i).fromSpecStalk z₁)
          (Limits.pullback.snd (Limits.pullback.fst V.hom iY) (Limits.pullback.fst V.hom i))) ℓ)
        (_ : wcHMPullCanonical Dj')
        (γ₁ : wcSuppObj Dj' ⟶ Df.Φ.obj (wcSuppObj Dj₁)),
        wcSuppUnitMap Dj' ≫ γ₁ = Df.μ.inv ≫ Df.Φ.map (wcSuppUnitMap Dj₁) →
        Epi (wcSuppUnitMap Dj') →
      letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf V.left ℓ)) := HasExt.standard _
      letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf ((𝟭 Scheme).obj V.left) ℓ)) :=
        HasExt.standard _
      letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf (Spec (V.left.presheaf.stalk z)) ℓ)) :=
        HasExt.standard _
      letI : HasExt (SheafOfModules.{u+1}
          (wcRingSheaf (Spec ((Limits.pullback V.hom i).presheaf.stalk z₁)) ℓ)) :=
        HasExt.standard _
      ∃ CTz : Abelian.Ext (wcSuppObj Dz) (Ez.Φ.obj (Dv.Φ.obj (wcSuppObj Di))) 2 →+
          wcSuppExt Dj' 2,
        Function.Injective CTz ∧
        (∀ w, CTz ((Abelian.Ext.mk₀ γz).comp (wcPullExtGen Ez 2 w) (zero_add _)) =
          (Abelian.Ext.mk₀ γ₁).comp (wcSuppPullExt Dj₁ Df 2 (CT w)) (zero_add _)) ∧
        ∀ (c : ℚ_[ℓ]) u, CTz ((Abelian.Ext.mk₀ ((@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _
            (wcProEtBC (Limits.pullback.fst (V.left.fromSpecStalk z)
              (Limits.pullback.fst V.hom iY))) _ _ Dz.cont Dz.φ).map
