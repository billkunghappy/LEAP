theorem wc_wlocal_int_red_divisible_near {W₀ T : Scheme.{u}} (haff : IsAffine W₀)
    (hc : IsClosed {x : W₀ | IsClosed ({x} : Set W₀)})
    (hu : ∀ x : W₀, ∃! y : W₀, IsClosed ({y} : Set W₀) ∧ x ⤳ y)
    (g : T ⟶ W₀) (hqc : QuasiCompact g) (hqs : QuasiSeparated g) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (k q : ℕ) (x : wcIntExt T ℓ q) (z₀ : W₀) (hz₀ : IsClosed ({z₀} : Set W₀))
    (DΛ₀ : wcIntPullData (Limits.pullback.snd (W₀.fromSpecStalk z₀) g) ℓ)
    (hDΛ₀ : wcIntPullCanonical DΛ₀)
    (h0 : wcIntRed (Limits.pullback (W₀.fromSpecStalk z₀) g) ℓ k q (wcIntPull DΛ₀ q x) = 0) :
    ∃ W : Set W₀, IsOpen W ∧ z₀ ∈ W ∧
      ∀ z ∈ W, IsClosed ({z} : Set W₀) →
      ∀ (DΛ : wcIntPullData (Limits.pullback.snd (W₀.fromSpecStalk z) g) ℓ),
        wcIntPullCanonical DΛ →
        ∃ x' : wcIntExt (Limits.pullback (W₀.fromSpecStalk z) g) ℓ q,
          wcIntPull DΛ q x = (ℓ ^ k : ℕ) • x' :=
by
  classical
  letI iT : HasExt (SheafOfModules.{u+1} (wcZModRingSheaf T (ℓ ^ k))) := HasExt.standard _
  obtain ⟨hTrT, htT⟩ := wc_int_red_transfer T ℓ

  have RC : ∀ (z : W₀) (DΛ : wcIntPullData (Limits.pullback.snd (W₀.fromSpecStalk z) g) ℓ),
      wcIntPullCanonical DΛ →
      ∀ (Dk : ∀ k' : ℕ, wcZModPullData (Limits.pullback.snd (W₀.fromSpecStalk z) g) (ℓ ^ k')),
      (∀ k', wcZModPullCanonical (Dk k')) →
      wcIntRed (Limits.pullback (W₀.fromSpecStalk z) g) ℓ k q (wcIntPull DΛ q x) =
        wcZModPull (Dk k) q (wcIntRed T ℓ k q x) := by
    intro z DΛ hDΛ Dk hDk
    obtain ⟨hTrU, htU⟩ := wc_int_red_transfer (Limits.pullback (W₀.fromSpecStalk z) g) ℓ
    exact (wc_int_red_pull_compat ℓ (Limits.pullback.snd (W₀.fromSpecStalk z) g) DΛ Dk
      hTrT htT hTrU htU
      (fun k' => wc_int_zmod_pull_restrict_iso ℓ _ k' DΛ hDΛ (Dk k') (hDk k')) q).1 k x

  choose Dk₀ hDk₀ using fun k' : ℕ =>
    wc_zmod_pull_data_exists (Limits.pullback.snd (W₀.fromSpecStalk z₀) g) (ℓ ^ k')
  have hz0 : wcZModPull (Dk₀ k) q (wcIntRed T ℓ k q x) = 0 := by
    rw [← RC z₀ DΛ₀ hDΛ₀ Dk₀ hDk₀]
    exact h0
  obtain ⟨V, hV, hz₀V, hK⟩ := wc_zmod_wlocal_closed_point_continuity haff hc hu g hqc hqs
    (ℓ ^ k) q z₀ hz₀ (Dk₀ k) (hDk₀ k) (wcIntRed T ℓ k q x) hz0
  have hK' : (Abelian.Ext.mk₀ (wcZModFun T (ℓ ^ k)
      ((LocallyConstant.charFn (ULift.{u+1} (ZMod (ℓ ^ k))) hV).toContinuousMap.comp
        g.base.hom))).comp (wcIntRed T ℓ k q x) (zero_add q) = 0 := hK
  refine ⟨V, hV.isOpen, hz₀V, ?_⟩
  intro z hzV hz DΛ hDΛ
  choose Dk hDk using fun k' : ℕ =>
    wc_zmod_pull_data_exists (Limits.pullback.snd (W₀.fromSpecStalk z) g) (ℓ ^ k')
  letI iU : HasExt (SheafOfModules.{u+1}
    (wcZModRingSheaf (Limits.pullback (W₀.fromSpecStalk z) g) (ℓ ^ k))) := HasExt.standard _

  have hr : ((LocallyConstant.charFn (ULift.{u+1} (ZMod (ℓ ^ k))) hV).toContinuousMap.comp
      g.base.hom).comp (Limits.pullback.snd (W₀.fromSpecStalk z) g).base.hom = 1 := by
    apply ContinuousMap.ext
    intro t
    show (LocallyConstant.charFn (ULift.{u+1} (ZMod (ℓ ^ k))) hV)
      (g.base.hom ((Limits.pullback.snd (W₀.fromSpecStalk z) g).base.hom t)) = 1
    have e1 : g.base.hom ((Limits.pullback.snd (W₀.fromSpecStalk z) g).base.hom t) =
        (W₀.fromSpecStalk z) ((Limits.pullback.fst (W₀.fromSpecStalk z) g) t) := by
      show g ((Limits.pullback.snd (W₀.fromSpecStalk z) g) t) = _
      rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, Limits.pullback.condition]
    have hsp : (W₀.fromSpecStalk z) ((Limits.pullback.fst (W₀.fromSpecStalk z) g) t) ⤳ z := by
      have hmem : (W₀.fromSpecStalk z) ((Limits.pullback.fst (W₀.fromSpecStalk z) g) t) ∈
          Set.range (W₀.fromSpecStalk z) := ⟨_, rfl⟩
      rw [Scheme.range_fromSpecStalk] at hmem
      exact hmem
    have hmem : g.base.hom ((Limits.pullback.snd (W₀.fromSpecStalk z) g).base.hom t) ∈ V := by
      rw [e1]
      exact hsp.mem_open hV.isOpen hzV
    rw [LocallyConstant.coe_charFn, Set.indicator_of_mem hmem]
    rfl

  have F1 : wcZModFun (Limits.pullback (W₀.fromSpecStalk z) g) (ℓ ^ k) 1 = 𝟙 _ := by
    apply (SheafOfModules.unitHomEquiv _).injective
    apply Subtype.ext
    funext W
    rw [SheafOfModules.unitHomEquiv_apply_coe, SheafOfModules.unitHomEquiv_apply_coe]
    rw [← SheafOfModules.unitHomEquiv_apply_coe]
    simp only [wcZModFun, Equiv.apply_symm_apply]
    rfl
  have e : wcZModPull (Dk k) q ((Abelian.Ext.mk₀ (wcZModFun T (ℓ ^ k)
      ((LocallyConstant.charFn (ULift.{u+1} (ZMod (ℓ ^ k))) hV).toContinuousMap.comp
        g.base.hom))).comp (wcIntRed T ℓ k q x) (zero_add q)) =
      (Abelian.Ext.mk₀ (wcZModFun (Limits.pullback (W₀.fromSpecStalk z) g) (ℓ ^ k)
        (((LocallyConstant.charFn (ULift.{u+1} (ZMod (ℓ ^ k))) hV).toContinuousMap.comp
          g.base.hom).comp (Limits.pullback.snd (W₀.fromSpecStalk z) g).base.hom))).comp
        (wcZModPull (Dk k) q (wcIntRed T ℓ k q x)) (zero_add q) :=
    wc_zmod_pull_fun (Dk k) (hDk k) _ q (wcIntRed T ℓ k q x)
  rw [hK', map_zero, hr, F1, Abelian.Ext.mk₀_id_comp] at e
  have hred : wcIntRed (Limits.pullback (W₀.fromSpecStalk z) g) ℓ k q (wcIntPull DΛ q x) = 0 := by
    rw [RC z DΛ hDΛ Dk hDk]
    exact e.symm
  obtain ⟨hTrU, htU⟩ := wc_int_red_transfer (Limits.pullback (W₀.fromSpecStalk z) g) ℓ
  exact (wc_int_red_milnor _ ℓ hTrU htU q).2.2.2 k _ hred

