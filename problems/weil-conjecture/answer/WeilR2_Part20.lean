theorem wc_et_coh_zero_finite_of_noetherianSpace : ∀ (Y : Scheme.{u})
    [TopologicalSpace.NoetherianSpace Y] (m : ℕ), m ≠ 0 → Finite (wcEtCoh Y m 0) :=
by
  intro Y _ m hm
  haveI : NeZero m := ⟨hm⟩
  let T₀ : Y.Etale := Scheme.Etale.mk (𝟙 Y)
  have hT : Limits.IsTerminal T₀ :=
    Limits.IsTerminal.ofUniqueHom (fun V => MorphismProperty.Over.homMk V.hom)
      (fun V m => MorphismProperty.Over.Hom.ext
        ((Category.comp_id m.left).symm.trans (MorphismProperty.Over.w m)))
  obtain ⟨ε, -, -⟩ := wc_et_const_hom_sections_equiv Y T₀ hT
  obtain ⟨e, -⟩ := wc_et_const_zmod_sections_locallyConstant Y m
    (fun V S hS x hx => wc_et_locallyConstant_glue Y V S hS m x hx)
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
  let E₁ : wcEtCoh Y m 0 ≃ ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} ℤ)) ⟶
      (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) :=
    (Abelian.Ext.addEquiv₀).toEquiv
  let E := E₁.trans ((ε _).trans (e T₀).toEquiv)
  let S : Set (Set Y) := irreducibleComponents Y
  haveI : Finite S := (TopologicalSpace.NoetherianSpace.finite_irreducibleComponents).to_subtype
  have hne : ∀ C : S, (C : Set Y).Nonempty := fun C => by
    have hC : IsIrreducible (C : Set Y) := C.2.prop
    exact hC.nonempty
  let σ : S → Y := fun C => (hne C).some
  have hσ : ∀ C : S, σ C ∈ (C : Set Y) := fun C => (hne C).some_mem
  let Ψ : LocallyConstant Y (ZMod m) → (S → ZMod m) := fun f C => f (σ C)
  have hΨ : Function.Injective Ψ := by
    intro f g hfg
    apply LocallyConstant.ext
    intro x
    let K : S := ⟨irreducibleComponent x, irreducibleComponent_mem_irreducibleComponents x⟩
    have hpc : _root_.IsPreconnected (irreducibleComponent x) :=
      isIrreducible_irreducibleComponent.isPreirreducible.isPreconnected
    have h1 := LocallyConstant.apply_eq_of_isPreconnected f hpc
      (mem_irreducibleComponent) (hσ K)
    have h2 := LocallyConstant.apply_eq_of_isPreconnected g hpc
      (mem_irreducibleComponent) (hσ K)
    have h3 : f (σ K) = g (σ K) := congrFun hfg K
    exact h1.trans (h3.trans h2.symm)
  let Φ : wcEtCoh Y m 0 → (S → ZMod m) := fun x => Ψ (E x : LocallyConstant Y (ZMod m))
  have hΦ : Function.Injective Φ := hΨ.comp E.injective
  exact Finite.of_injective Φ hΦ

theorem wc_strict_closed_supp_ext_two_line_of_counts {R : CommRingCat.{u}} [HenselianLocalRing R]
    [IsSepClosed (IsLocalRing.ResidueField R)] [IsNoetherianRing R] {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    {P T₀ : Scheme.{u}} (iP : P ⟶ Spec R) [IsClosedImmersion iP]
