      rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id,
        Abelian.Ext.comp_mk₀_id]
    rw [h1, hU (x.comp (Abelian.Ext.mk₀ τ.hom) (add_zero _)), Abelian.Ext.zero_comp]

  have hX := wc_qmbt_xspl_supp_ker_ext_vanish i₂ E₂ hE₂ Wo hW Dw hDw
    (Limits.kernel (wcSuppUnitMap E₂)) (n - 3) hK

  haveI hepi := wc_supp_unit_epi_of_closed i₂ ℓ E₂ hE₂
  have hS₂ : (ShortComplex.mk (Limits.kernel.ι (wcSuppUnitMap E₂)) (wcSuppUnitMap E₂)
      (Limits.kernel.condition _)).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_kernel _) inferInstance hepi
  have hExt : ∀ x : Abelian.Ext (wcSuppObj E₂) (Limits.kernel (wcSuppUnitMap E₂)) (n - 2),
      x = 0 := by
    intro x
    obtain ⟨x₁, hx₁⟩ := Abelian.Ext.contravariant_sequence_exact₃ hS₂ _ x
      (hΛ (n - 2) (by omega) _) (n₀ := n - 3) (by omega)
    rw [← hx₁, hX x₁, Abelian.Ext.comp_zero]

  let σ₁ := ((DerivedCategory.singleFunctors (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))).shiftIso
    ((n : ℤ) - 1) 0 ((n : ℤ) - 1) (add_zero _)).app (wcSuppObj E₂)
  let σ₂ := ((DerivedCategory.singleFunctors (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))).shiftIso
    ((n : ℤ) - 1) (1 - ((n : ℤ) - 1)) 1 (by ring)).app (Limits.kernel (wcSuppUnitMap E₂))
  let σ₃ := ((DerivedCategory.singleFunctors (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))).shiftIso
    ((n - 2 : ℕ) : ℤ) (1 - ((n : ℤ) - 1)) 0 (by omega)).app (Limits.kernel (wcSuppUnitMap E₂))
  let sh : ShiftedHom
      ((DerivedCategory.singleFunctor (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)) 0).obj
        (wcSuppObj E₂))
      ((DerivedCategory.singleFunctor (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)) 0).obj
        (Limits.kernel (wcSuppUnitMap E₂))) ((n - 2 : ℕ) : ℤ) :=
    σ₁.inv ≫ (shiftFunctor _ ((n : ℤ) - 1)).map z ≫ σ₂.hom ≫ σ₃.inv
  have hs0 : sh = 0 := by
    have h0 : Abelian.Ext.homAddEquiv.symm sh = 0 := hExt _
    have h1 : sh = Abelian.Ext.homAddEquiv (Abelian.Ext.homAddEquiv.symm sh) :=
      (AddEquiv.apply_symm_apply _ sh).symm
    rw [h1, h0, map_zero]
  have h1 : (shiftFunctor _ ((n : ℤ) - 1)).map z ≫ σ₂.hom ≫ σ₃.inv = 0 := by
    rw [← cancel_epi σ₁.inv, Limits.comp_zero]
    exact hs0
  have h2 : (shiftFunctor _ ((n : ℤ) - 1)).map z = 0 := by
    rw [← cancel_mono (σ₂.hom ≫ σ₃.inv), Limits.zero_comp]
    exact h1
  exact (shiftFunctor _ ((n : ℤ) - 1)).map_injective (h2.trans (Functor.map_zero _ _ _).symm)

theorem wc_quad_cone_sepclosed_punct_coh_counts (k : Type u) [Field k] [IsSepClosed k] (ℓ : ℕ)
    [Fact (Nat.Prime ℓ)] (hℓ : ((ℓ : ℕ) : k) ≠ 0) (n : ℕ) (hn : Even n) (h4 : 4 ≤ n)
    (c : Matrix (Fin n) (Fin n) k) (hc : IsUnit (c + c.transpose).det)
    (Oc : (Spec (.of (wcQuadModelRing k n 0 c))).Opens)
    (hOc : (Oc : Set (Spec (.of (wcQuadModelRing k n 0 c)))) =
      {y | ∃ p, Ideal.Quotient.mk (wcQuadModelIdeal k n 0 c) (MvPolynomial.X p) ∉ y.asIdeal}) :
    (∀ q : ℕ, Finite (wcEtCoh (Oc : Scheme.{u}) ℓ q)) ∧
      Nat.card (wcEtCoh (Oc : Scheme.{u}) ℓ (n - 2)) = ℓ :=
by
  classical
  have hℓp : ℓ.Prime := Fact.out
  obtain ⟨e, rfl⟩ : ∃ e, n = 2 * e + 1 + 1 := by
    obtain ⟨r, hr⟩ := hn
    exact ⟨r - 1, by omega⟩
  have he : 1 ≤ e := by omega
  have hopen : ∀ {R : Type u} [CommRing R] {ι : Type} (f : ι → R),
      IsOpen ({y | ∃ i, f i ∉ y.asIdeal} : Set (Spec (.of R))) := by
    intro R _ ι f
    have hU : ({y | ∃ i, f i ∉ y.asIdeal} : Set (Spec (.of R))) =
        ⋃ i, (PrimeSpectrum.zeroLocus {f i})ᶜ := by
      ext y
      constructor
      · rintro ⟨i, hi⟩
        exact Set.mem_iUnion.mpr ⟨i, fun h => hi (h (Set.mem_singleton _))⟩
      · intro h
        obtain ⟨i, hi⟩ := Set.mem_iUnion.mp h
        exact ⟨i, fun h' => hi (Set.singleton_subset_iff.mpr h')⟩
    rw [hU]
    exact isOpen_iUnion fun i => (PrimeSpectrum.isClosed_zeroLocus _).isOpen_compl

  have L4 : ∀ (K : Type u) [Field K] [IsAlgClosed K], ((ℓ : ℕ) : K) ≠ 0 →
      ∀ (Oh : (Spec (.of (wcQuadModelRing K (2 * e + 1 + 1) 0 (Matrix.of fun p q : Fin (2 * e + 1 + 1) =>
        if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0)))).Opens),
      (Oh : Set (Spec (.of (wcQuadModelRing K (2 * e + 1 + 1) 0 (Matrix.of fun p q : Fin (2 * e + 1 + 1) =>
        if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0))))) =
        {y | ∃ p, Ideal.Quotient.mk (wcQuadModelIdeal K (2 * e + 1 + 1) 0
          (Matrix.of fun p q : Fin (2 * e + 1 + 1) =>
            if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0)) (MvPolynomial.X p) ∉ y.asIdeal} →
      ∀ q : ℕ, Finite (wcEtCoh (Oh : Scheme.{u}) ℓ q) := by
    intro K _ _ hℓK' Oh hOh q
    obtain ⟨Ou, hOu⟩ : ∃ Ou : (Spec (.of (wcQuadModelRing K (2 * e + 1 + 1) 0 (Matrix.of fun p q : Fin (2 * e + 1 + 1) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0)))).Opens, (Ou : Set (Spec (.of (wcQuadModelRing K (2 * e + 1 + 1) 0 (Matrix.of fun p q : Fin (2 * e + 1 + 1) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0))))) = {y | ∃ k : Fin (e + 1), Ideal.Quotient.mk (wcQuadModelIdeal K (2 * e + 1 + 1) 0 (Matrix.of fun p q : Fin (2 * e + 1 + 1) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0)) (MvPolynomial.X (⟨2 * k.val, by have := k.isLt; omega⟩ : Fin (2 * e + 1 + 1))) ∉ y.asIdeal} :=
      ⟨⟨_, hopen (fun k : Fin (e + 1) => Ideal.Quotient.mk (wcQuadModelIdeal K (2 * e + 1 + 1) 0 (Matrix.of fun p q : Fin (2 * e + 1 + 1) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0)) (MvPolynomial.X (⟨2 * k.val, by have := k.isLt; omega⟩ : Fin (2 * e + 1 + 1))))⟩, rfl⟩
    obtain ⟨W, hW0⟩ : ∃ W : (Spec (.of (MvPolynomial (Fin (e + 1)) K))).Opens, (W : Set (Spec (.of (MvPolynomial (Fin (e + 1)) K)))) = {y | ∃ t : Fin (e + 1), (MvPolynomial.X t : MvPolynomial (Fin (e + 1)) K) ∉ y.asIdeal} :=
      ⟨⟨_, hopen (fun t : Fin (e + 1) => (MvPolynomial.X t : MvPolynomial (Fin (e + 1)) K))⟩, rfl⟩
    have hW : (W : Set (Spec (.of (MvPolynomial (Fin (e + 1)) K)))) = (Set.range (Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff : MvPolynomial (Fin (e + 1)) K →+* K))))ᶜ := by
      rw [hW0]
      ext y
      rw [Set.mem_compl_iff, wc_affine_origin_range_iff, not_forall]
      exact Iff.rfl
    have hmem : (⟨⊥, inferInstance⟩ : PrimeSpectrum (MvPolynomial (Fin (e + 1)) K)) ∈
        (W : Set (Spec (.of (MvPolynomial (Fin (e + 1)) K)))) := by
      rw [hW0]
      exact ⟨0, fun h => MvPolynomial.X_ne_zero (R := K) (0 : Fin (e + 1)) (Ideal.mem_bot.mp h)⟩
    have hWne : Nonempty (W : Scheme.{u}) := ⟨⟨_, hmem⟩⟩
    haveI hWirr : IrreducibleSpace (W : Scheme.{u}) :=
      Subtype.irreducibleSpace ⟨⟨_, hmem⟩, (IrreducibleSpace.isIrreducible_univ _).isPreirreducible.open_subset
        W.isOpen (Set.subset_univ _)⟩
    obtain ⟨hsm, hcpt, hsep⟩ := wc_hyp_quad_cone_punct_smooth_qcsep K e Oh hOh
    obtain ⟨iZ, O', eO, πy, s, hci, hO', hstr, -⟩ :=
      wc_hyp_quad_cone_punct_strata K e Oh Ou hOh hOu W hW
    haveI := hsm
    haveI := hcpt
    haveI := hsep
    haveI := hci
    have hZsm : SmoothOfRelativeDimension (e + 1) (iZ ≫ Oh.ι ≫ wcQuadModelStr K (2 * e + 1 + 1) 0
        (Matrix.of fun p q : Fin (2 * e + 1 + 1) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0)) := by
      rw [hstr]
      haveI := wc_mvpoly_spec_smoothOfRelDim K (e + 1)
      simpa using (inferInstance : SmoothOfRelativeDimension (0 + (e + 1))
        (W.ι ≫ Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin (e + 1)) K)))))
    haveI := hZsm
    have hZsm' : SmoothOfRelativeDimension (2 * e + 1 - e) (iZ ≫ Oh.ι ≫ wcQuadModelStr K (2 * e + 1 + 1) 0
        (Matrix.of fun p q : Fin (2 * e + 1 + 1) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0)) := by
      rw [show 2 * e + 1 - e = e + 1 by omega]
      exact hZsm
    obtain ⟨D⟩ := wc_et_zmod_pull_data_exists iZ ℓ
    obtain ⟨Dj⟩ := wc_et_zmod_pull_data_exists O'.ι ℓ
    have chain : ∀ q : ℕ, Nonempty (wcEtZModExt (O' : Scheme.{u}) ℓ q ≃ wcEtCoh (W : Scheme.{u}) ℓ q) := by
      intro q
      obtain ⟨E1⟩ := wc_et_zmodext_coh_equiv (O' : Scheme.{u}) ℓ q
      obtain ⟨E2⟩ := wc_et_coh_iso_invariance eO.hom ℓ q
      obtain ⟨E3⟩ := wc_hyp_quad_cone_even_open_coh_equiv K ℓ hℓK' e Ou hOu W hW q
      exact ⟨E1.trans (E2.symm.trans E3)⟩

    have hWfin : ∀ j : ℕ, Finite (wcEtCoh (W : Scheme.{u}) ℓ j) := by
      intro j
      rcases (show j = 0 ∨ (1 ≤ j ∧ j + 2 ≤ 2 * (e + 1)) ∨ j = 2 * e + 1 ∨ 2 * (e + 1) ≤ j by omega)
        with h | h | h | h
      · subst h
        exact (wc_et_coh_zero_irreducible_card_le (W : Scheme.{u}) ℓ hℓp.ne_zero).1
      · haveI := wc_rpss_punct_affine_low_vanishing K (e + 1) ℓ hℓK' W hW j h.1 h.2
        exact Finite.of_subsingleton
      · have h1 := (wc_et_punctured_affine_coh_card_le K (e + 1) (by omega) ℓ hℓp hℓK' W hW).1
        rw [show 2 * (e + 1) - 1 = j by omega] at h1
        exact h1
      · have hE : (W : Set (Spec (.of (MvPolynomial (Fin (e + 1)) K)))) =
            {x | ∃ j : Fin (e + 1), j.val < e + 1 ∧
              (MvPolynomial.X j : MvPolynomial (Fin (e + 1)) K) ∉ x.asIdeal} := by
          rw [hW0]
          ext x
          constructor
          · rintro ⟨t, ht⟩
            exact ⟨t, t.isLt, ht⟩
          · rintro ⟨t, -, ht⟩
            exact ⟨t, ht⟩
        haveI := wc_et_affine_partial_punct_vanishing K ℓ hℓp hℓK' (e + 1) (e + 1) le_rfl W hE j h
        exact Finite.of_subsingleton

    have hO'fin : Finite (wcEtZModExt (O' : Scheme.{u}) ℓ q) := by
      obtain ⟨E⟩ := chain q
      haveI := hWfin q
      exact Finite.of_equiv _ E.symm

    have hAfin : Finite (wcEtSuppExt D q) := by
      rcases Nat.lt_or_ge q (2 * e) with hq | hq
      · have h0 : ∀ θ : wcEtSuppExt D q, θ = 0 := by
          haveI := hZsm'
          exact wc_et_supp_semipurity K (Oh : Scheme.{u}) (W : Scheme.{u})
            (Oh.ι ≫ wcQuadModelStr K (2 * e + 1 + 1) 0
              (Matrix.of fun p q : Fin (2 * e + 1 + 1) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0))
            (2 * e + 1) e iZ (by omega) ℓ hℓK' D q hq
        haveI : Subsingleton (wcEtSuppExt D q) := ⟨fun a b => (h0 a).trans (h0 b).symm⟩
        exact Finite.of_subsingleton
      · obtain ⟨j, hj⟩ : ∃ j, j + 2 * e = q := ⟨q - 2 * e, by omega⟩
        obtain ⟨E⟩ := wc_et_smooth_pair_purity_ext_equiv K (Oh.ι ≫ wcQuadModelStr K (2 * e + 1 + 1) 0
            (Matrix.of fun p q : Fin (2 * e + 1 + 1) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0))
          (2 * e + 1) (e + 1) e (by omega) iZ ℓ hℓK' hWne D j
        obtain ⟨EW⟩ := wc_et_zmodext_coh_equiv (W : Scheme.{u}) ℓ j
        haveI := hWfin j
        haveI : Finite (wcEtZModExt (W : Scheme.{u}) ℓ j) := Finite.of_equiv _ EW.symm
        rw [hj] at E
        exact Finite.of_equiv _ E

    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing (Oh : Scheme.{u}) ℓ)) := HasExt.standard _
    obtain ⟨C1, -, -⟩ := wc_et_supp_open_les iZ O' hO' ℓ D Dj
    have hBfin : Finite (wcEtZModExt (Oh : Scheme.{u}) ℓ q) := by
      obtain ⟨sec, hsec⟩ : ∃ sec : wcEtZModExt (O' : Scheme.{u}) ℓ q → wcEtZModExt (Oh : Scheme.{u}) ℓ q,
          ∀ g, wcEtPull Dj q (sec (wcEtPull Dj q g)) = wcEtPull Dj q g := by
        refine ⟨fun c => if h : ∃ b, wcEtPull Dj q b = c then h.choose else 0, fun g => ?_⟩
        have h : ∃ b, wcEtPull Dj q b = wcEtPull Dj q g := ⟨g, rfl⟩
        dsimp only
        rw [dif_pos h]
        exact h.choose_spec
      have hker : ∀ g, ∃ x : wcEtSuppExt D q,
          (Abelian.Ext.mk₀ (wcEtSuppUnitMap D)).comp x (zero_add q) = g - sec (wcEtPull Dj q g) := by
        intro g
        apply (C1 q _).mp
        rw [map_sub, hsec, sub_self]
      choose f hf using hker
      have hψ : Function.Injective (fun g => (wcEtPull Dj q g, f g)) := by
        intro g g' hgg
        simp only [Prod.mk.injEq] at hgg
        obtain ⟨h1, h2⟩ := hgg
        have e3 : g - sec (wcEtPull Dj q g) = g' - sec (wcEtPull Dj q g') := by
          rw [← hf g, ← hf g', h2]
        rw [h1] at e3
        exact sub_left_inj.mp e3
      haveI := hO'fin
      haveI := hAfin
      exact Finite.of_injective _ hψ

    obtain ⟨E0⟩ := wc_et_zmodext_coh_equiv (Oh : Scheme.{u}) ℓ q
    exact Finite.of_equiv _ E0

  have hint : (algebraMap k (AlgebraicClosure k)).IsIntegral := by
    haveI := AlgebraicClosure.isAlgebraic k
    intro x
    exact Algebra.IsIntegral.isIntegral x
  have hℓK : ((ℓ : ℕ) : AlgebraicClosure k) ≠ 0 := by
    rw [← map_natCast (algebraMap k (AlgebraicClosure k))]
    exact (map_ne_zero _).mpr hℓ
  have hcK : IsUnit ((c.map (algebraMap k (AlgebraicClosure k))) +
      (c.map (algebraMap k (AlgebraicClosure k))).transpose).det := by
    have e1 : (c.map (algebraMap k (AlgebraicClosure k))) +
        (c.map (algebraMap k (AlgebraicClosure k))).transpose =
        (algebraMap k (AlgebraicClosure k)).mapMatrix (c + c.transpose) := by
      ext i j
      simp [Matrix.add_apply, Matrix.transpose_apply]
    rw [e1, ← RingHom.map_det]
    exact hc.map _
  have key := wc_qmbt_bm_quad_pullback (algebraMap k (AlgebraicClosure k)) (2 * e + 1 + 1) 0 c
    (0 : AlgebraicClosure k) (by rw [map_zero]; exact zero_pow two_ne_zero)
  have h0 : (0 : AlgebraicClosure k) ^ 2 = 0 := zero_pow two_ne_zero
  rw [h0] at key
  obtain ⟨θ, hθX, -, hpb⟩ := key
  have hP := IsPullback.paste_vert (isPullback_morphismRestrict (Spec.map (CommRingCat.ofHom θ)) Oc)
    hpb
  have hOcK : ((Spec.map (CommRingCat.ofHom θ) ⁻¹ᵁ Oc :
      (Spec (.of (wcQuadModelRing (AlgebraicClosure k) (2 * e + 1 + 1) 0
        (c.map (algebraMap k (AlgebraicClosure k)))))).Opens) :
      Set (Spec (.of (wcQuadModelRing (AlgebraicClosure k) (2 * e + 1 + 1) 0
        (c.map (algebraMap k (AlgebraicClosure k))))))) =
      {y | ∃ p, Ideal.Quotient.mk (wcQuadModelIdeal (AlgebraicClosure k) (2 * e + 1 + 1) 0
        (c.map (algebraMap k (AlgebraicClosure k)))) (MvPolynomial.X p) ∉ y.asIdeal} := by
    rw [Scheme.Hom.coe_preimage, hOc]
    ext y
    simp only [Set.mem_preimage, Set.mem_setOf_eq]
    refine exists_congr (fun p => ?_)
    rw [← hθX p]
    rfl
  let Oh : (Spec (.of (wcQuadModelRing (AlgebraicClosure k) (2 * e + 1 + 1) 0
      (Matrix.of fun p q : Fin (2 * e + 1 + 1) =>
        if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : AlgebraicClosure k) else 0)))).Opens :=
    ⟨{y | ∃ p, Ideal.Quotient.mk (wcQuadModelIdeal (AlgebraicClosure k) (2 * e + 1 + 1) 0
        (Matrix.of fun p q : Fin (2 * e + 1 + 1) =>
          if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : AlgebraicClosure k) else 0))
        (MvPolynomial.X p) ∉ y.asIdeal},
      hopen (fun p : Fin (2 * e + 1 + 1) => Ideal.Quotient.mk (wcQuadModelIdeal (AlgebraicClosure k)
        (2 * e + 1 + 1) 0 (Matrix.of fun p q : Fin (2 * e + 1 + 1) =>
          if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : AlgebraicClosure k) else 0))
        (MvPolynomial.X p))⟩
  have Eq : ∀ q : ℕ, Nonempty (wcEtCoh (Oc : Scheme.{u}) ℓ q ≃ wcEtCoh (Oh : Scheme.{u}) ℓ q) := by
    intro q
    obtain ⟨e1⟩ := wc_et_coh_purely_inseparable_invariance k (AlgebraicClosure k) hint
      (Oc : Scheme.{u}) (Oc.ι ≫ wcQuadModelStr k (2 * e + 1 + 1) 0 c) ℓ q
    obtain ⟨e2⟩ := wc_et_coh_iso_invariance hP.isoPullback.hom ℓ q
    obtain ⟨e3⟩ := wc_quad_cone_punct_coh_hyperbolic_transport (AlgebraicClosure k) (2 * e + 1 + 1)
      hn (by omega) (c.map (algebraMap k (AlgebraicClosure k))) hcK _ hOcK Oh rfl ℓ q
    exact ⟨e1.symm.trans (e2.trans e3)⟩
  refine ⟨fun q => ?_, ?_⟩
  · obtain ⟨E⟩ := Eq q
    haveI := L4 (AlgebraicClosure k) hℓK Oh rfl q
    exact Finite.of_equiv _ E.symm
  · obtain ⟨E⟩ := Eq (2 * e + 1 + 1 - 2)
    rw [Nat.card_congr E]
    exact (wc_hyp_cone_punct_mid_coh_mod_ell (AlgebraicClosure k) ℓ hℓK (2 * e + 1 + 1) hn h4
      Oh rfl).2.2

theorem wc_qmbt_xsp_ess_D2_compl_ext_cyclic {A : Type u} [CommRing A] [IsDomain A]
    [IsDiscreteValuationRing A]
    [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (hℓ : IsUnit ((ℓ : ℕ) : A)) {n : ℕ} (hn : Even n) (hn4 : 4 ≤ n) {π : A}
    {c : Matrix (Fin n) (Fin n) A}
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π}) (hc : IsUnit (c + c.transpose).det)
    {x₀ : Spec (.of (wcQuadModelRing A n π c))}
    (hx₀ : ∀ p, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
      PrimeSpectrum.asIdeal x₀)
    {B₀ : Type u} [CommRing B₀] [HenselianLocalRing B₀] [IsSepClosed (IsLocalRing.ResidueField B₀)]
    {Λ₀ : Type u} [SmallCategory Λ₀] [IsCofiltered Λ₀]
    {W₀ : Λ₀ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (wcQuadModelRing A n π c))) x₀))
      (Scheme.Etale.forget (Spec (.of (wcQuadModelRing A n π c))))}
    {φ₀ : ∀ l, Spec (.of B₀) ⟶ (W₀.obj l).right.left}
    {a₀ : Spec (.of B₀) ⟶ Spec (.of (wcQuadModelRing A n π c))}
    (hsh : wcHalShData x₀ B₀ Λ₀ W₀ φ₀ a₀)
    {Xs : Scheme.{u}} {ι : Xs ⟶ Spec (.of B₀)} {s : Xs ⟶ Spec (.of (IsLocalRing.ResidueField A))}
    (hps : IsPullback ι s (a₀ ≫ wcQuadModelStr A n π c) (wcQmSp A))
    {A' : Type u} [CommRing A'] [IsDomain A'] [IsDiscreteValuationRing A'] [HenselianLocalRing A']
    [IsSepClosed (IsLocalRing.ResidueField A')] {ιA : A →+* A'} {π' : A'}
    (hℓ' : IsUnit ((ℓ : ℕ) : A')) (hπ' : IsLocalRing.maximalIdeal A' = Ideal.span {π'})
