  haveI : IsLocallyNoetherian P := LocallyOfFiniteType.isLocallyNoetherian iP
  haveI : IsAffine P := (IsClosedImmersion.isAffine_surjective_of_isAffine iP).1
  haveI : AlgebraicGeometry.IsNoetherian P := {}
  haveI : TopologicalSpace.NoetherianSpace P := AlgebraicGeometry.IsNoetherian.noetherianSpace
  haveI hWN : TopologicalSpace.NoetherianSpace Wo.toScheme :=
    TopologicalSpace.NoetherianSpace.set (Wo : Set P)
  haveI : CompactSpace Wo.toScheme :=
    isCompact_iff_compactSpace.mp (TopologicalSpace.NoetherianSpace.isCompact (Wo : Set P))
  haveI : QuasiSeparatedSpace Wo.toScheme := quasiSeparatedSpace_of_quasiSeparated Wo.ι
  haveI : IsSeparated (Limits.terminal.from Wo.toScheme) := by
    rw [show Limits.terminal.from Wo.toScheme = Wo.ι ≫ Limits.terminal.from P from
      Limits.terminal.hom_ext _ _]
    infer_instance
  have hetP : ∀ q : ℕ, Subsingleton (wcEtCoh P ℓ (q + 1)) :=
    fun q => wc_strict_closed_sub_et_vanish R iP ℓ q
  have hvanP : ∀ q : ℕ, ∀ x : wcHM P ℓ (q + 1), x = 0 :=
    wc_hm_vanish_of_et_vanish_affine P ℓ hetP
  have hepi := wc_supp_unit_epi_of_closed j ℓ Dj hDj
  have hqc : ∀ (W : Scheme.{u}) [IsAffine W] (p : W ⟶ P), ∃ (N : ℕ) (f : Fin N → Γ(W, ⊤)),
      ∀ x : ↥W, (p x ∉ Set.range j ↔ ∃ a, x ∈ W.basicOpen (f a)) :=
    fun W _ p => wc_affine_complement_basicOpen_cover j W p
  obtain ⟨Dw, hDw⟩ := wc_hm_pull_data_exists Wo.ι ℓ
  obtain ⟨δ, hlift, -, hlin⟩ := wc_supp_les_open_boundary_scalar j Dj hDj hepi
    (fun U' kk W g hW => wc_supp_kernel_section_local_cover_qc j hqc Dj hDj U' kk W g hW)
    Wo hWo Dw hDw 1 2 rfl
  have hsurj : ∀ θ : wcSuppExt Dj 2, ∃ α : wcHM Wo.toScheme ℓ 1, δ α = θ :=
    fun θ => hlift θ (hvanP 1 _)
  have hfin : ∀ q : ℕ, Finite (wcEtCoh Wo.toScheme ℓ q) := by
    intro q
    rcases q with _ | _ | q
    · exact wc_et_coh_zero_finite_of_noetherianSpace Wo.toScheme ℓ hℓ0
    · exact hfin1
    · haveI := hhigh (q + 2) (by omega)
