        (((Limits.kernel.ι (wcSuppUnitMap EY)).val.app (Opposite.op V)).hom p)) x = 0 := by
    intro V p x hx
    have hk := congrArg (fun φ => (φ.val.app (Opposite.op V)).hom p)
      (Limits.kernel.condition (wcSuppUnitMap EY))
    change ((wcSuppUnitMap EY).val.app (Opposite.op V)).hom
      (((Limits.kernel.ι (wcSuppUnitMap EY)).val.app (Opposite.op V)).hom p) = 0 at hk
    have hx' : x ∈ Set.range (Limits.pullback.fst V.hom iY) := by
      rw [Scheme.Pullback.range_fst]; exact hx
