          ((J.cocomplex.d q' (q' + 1)).hom.app (Opposite.op (Scheme.Etale.mk (𝟙 Y)))).hom z = 0 →
          ∃ b : (J.cocomplex.X (q' - 1)).obj.obj (Opposite.op (Scheme.Etale.mk (𝟙 Y))),
            ((J.cocomplex.d (q' - 1) q').hom.app (Opposite.op (Scheme.Etale.mk (𝟙 Y)))).hom b = z := by
