theorem wc_qmbt_dlyt_thom_strict_nz {Y' Z : Scheme.{u}} (iY' : Y' ⟶ Z) [IsClosedImmersion iY']
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (L : Type u) [Field L] (qZ : Z ⟶ Spec (.of L))
    (κΛ : ∀ (T : Scheme.{u}), (T ⟶ Spec (.of L)) → (Γ(T, ⊤))ˣ → wcIntExt T ℓ 1)
