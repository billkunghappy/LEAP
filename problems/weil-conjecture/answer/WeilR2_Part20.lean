theorem wc_punct_closed_open_compact {X Y ZY Z : Scheme.{u}} [IsAffine X] [IsLocallyNoetherian Y]
    (v : X ⟶ Y) (iY : ZY ⟶ Y) [IsClosedImmersion iY] (i : Z ⟶ Y) [IsClosedImmersion i]
    (O : X.Opens) (hO : (O : Set X) = (Set.range ⇑(Limits.pullback.fst v iY))ᶜ)
    (O₁ : (Limits.pullback v i).Opens)
    (hO₁ : (O₁ : Set ↥(Limits.pullback v i)) = (Limits.pullback.fst v i) ⁻¹' (O : Set X)) :
    IsCompact (O₁ : Set ↥(Limits.pullback v i)) :=
by
  have s1 : IsClosed (Set.range ⇑iY) := (Scheme.Hom.isClosedEmbedding iY).isClosed_range
  let U : Y.Opens := ⟨(Set.range ⇑iY)ᶜ, s1.isOpen_compl⟩
  have s2 : (O : Set X) = ⇑v ⁻¹' (U : Set Y) := by
    rw [hO, Scheme.Pullback.range_fst v iY]
    rfl
  have s3 : IsCompact (O : Set X) := by
    haveI : QuasiCompact (Limits.pullback.fst v U.ι) := inferInstance
    have h : IsCompact (⇑(Limits.pullback.fst v U.ι) ⁻¹' (Set.univ : Set X)) :=
      QuasiCompact.isCompact_preimage (f := Limits.pullback.fst v U.ι) Set.univ isOpen_univ
        isCompact_univ
    rw [Set.preimage_univ] at h
    have h2 := h.image (Scheme.Hom.continuous (Limits.pullback.fst v U.ι))
    rw [Set.image_univ, Scheme.Pullback.range_fst v U.ι, Scheme.Opens.range_ι] at h2
    rw [s2]
    exact h2
  rw [hO₁]
  exact QuasiCompact.isCompact_preimage (f := Limits.pullback.fst v i) (O : Set X) O.isOpen s3

theorem wc_open_pullback_stalk_factor {X Y Z : Scheme.{u}} (v : X ⟶ Y) (i : Z ⟶ Y)
    (O : X.Opens) (O₁ : (Limits.pullback v i).Opens)
    (hO₁ : (O₁ : Set ↥(Limits.pullback v i)) = (Limits.pullback.fst v i) ⁻¹' (O : Set X)) :
    ∃ e : O₁.toScheme ⟶ Limits.pullback (O.ι ≫ v) i, IsIso e ∧
      e ≫ Limits.pullback.fst (O.ι ≫ v) i ≫ O.ι = O₁.ι ≫ Limits.pullback.fst v i ∧
      e ≫ Limits.pullback.snd (O.ι ≫ v) i = O₁.ι ≫ Limits.pullback.snd v i ∧
      ∀ z₁ : ↥(Limits.pullback v i),
        ∃ m : Limits.pullback ((Limits.pullback v i).fromSpecStalk z₁) O₁.ι ⟶
            Limits.pullback (Limits.pullback.snd (X.fromSpecStalk ((Limits.pullback.fst v i) z₁)) O.ι ≫
              O.ι ≫ v) i,
          m ≫ Limits.pullback.fst _ i ≫
              Limits.pullback.snd (X.fromSpecStalk ((Limits.pullback.fst v i) z₁)) O.ι =
            Limits.pullback.snd ((Limits.pullback v i).fromSpecStalk z₁) O₁.ι ≫ e ≫
              Limits.pullback.fst (O.ι ≫ v) i ∧
          m ≫ Limits.pullback.snd _ i =
            Limits.pullback.snd ((Limits.pullback v i).fromSpecStalk z₁) O₁.ι ≫ e ≫
              Limits.pullback.snd (O.ι ≫ v) i :=
by
  have hO : O₁ = Limits.pullback.fst v i ⁻¹ᵁ O := TopologicalSpace.Opens.ext hO₁
  subst hO
  have H := (isPullback_morphismRestrict (Limits.pullback.fst v i) O).paste_vert
    (IsPullback.of_hasPullback v i)
  have E1 : H.isoPullback.hom ≫ Limits.pullback.fst (O.ι ≫ v) i ≫ O.ι =
      (Limits.pullback.fst v i ⁻¹ᵁ O).ι ≫ Limits.pullback.fst v i := by
    rw [IsPullback.isoPullback_hom_fst_assoc, morphismRestrict_ι]
  refine ⟨H.isoPullback.hom, inferInstance, E1, ?_, ?_⟩
  · rw [IsPullback.isoPullback_hom_snd]
  · intro z₁
    have h_u : (Limits.pullback.fst ((Limits.pullback v i).fromSpecStalk z₁)
          (Limits.pullback.fst v i ⁻¹ᵁ O).ι ≫
          Spec.map ((Limits.pullback.fst v i).stalkMap z₁)) ≫
          X.fromSpecStalk ((Limits.pullback.fst v i) z₁) =
        (Limits.pullback.snd ((Limits.pullback v i).fromSpecStalk z₁)
          (Limits.pullback.fst v i ⁻¹ᵁ O).ι ≫ H.isoPullback.hom ≫
          Limits.pullback.fst (O.ι ≫ v) i) ≫ O.ι := by
      rw [Category.assoc, Scheme.SpecMap_stalkMap_fromSpecStalk, ← Category.assoc,
        Limits.pullback.condition, Category.assoc, Category.assoc, Category.assoc, E1]
    refine ⟨Limits.pullback.lift (Limits.pullback.lift _ _ h_u)
      (Limits.pullback.snd ((Limits.pullback v i).fromSpecStalk z₁)
          (Limits.pullback.fst v i ⁻¹ᵁ O).ι ≫ H.isoPullback.hom ≫
          Limits.pullback.snd (O.ι ≫ v) i) ?_, ?_, ?_⟩
    · rw [Limits.pullback.lift_snd_assoc]
      simp only [Category.assoc]
      rw [Limits.pullback.condition]
    · rw [Limits.pullback.lift_fst_assoc, Limits.pullback.lift_snd]
    · rw [Limits.pullback.lift_snd]

theorem wc_slice_corep_ext_vanish_transfer (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (W : S.ProEt)
    [(wcSliceFunctor S W).IsContinuous (Scheme.ProEt.topology W.left) (Scheme.ProEt.topology S)]
    (PW : SheafOfModules.{u+1} (wcRingSheaf S ℓ))
    (evW : ∀ M : SheafOfModules.{u+1} (wcRingSheaf S ℓ), (PW ⟶ M) ≃ M.val.obj (Opposite.op W))
    (hnatW : ∀ (M N : SheafOfModules.{u+1} (wcRingSheaf S ℓ)) (ψ : M ⟶ N) (g : PW ⟶ M),
      evW N (g ≫ ψ) = (ψ.val.app (Opposite.op W)).hom (evW M g))
    (M : SheafOfModules.{u+1} (wcRingSheaf S ℓ)) (q : ℕ) :
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf W.left ℓ)) := HasExt.standard _
    ∃ Ψ : Abelian.Ext PW M q →+
        Abelian.Ext (SheafOfModules.unit (wcRingSheaf W.left ℓ)) ((wcSliceRes S ℓ W).obj M) q,
      Function.Bijective Ψ ∧
      ∀ (W' : S.ProEt) (b : W' ⟶ W) (PW' : SheafOfModules.{u+1} (wcRingSheaf S ℓ)) (Pmb : PW' ⟶ PW)
        (evW' : ∀ M : SheafOfModules.{u+1} (wcRingSheaf S ℓ), (PW' ⟶ M) ≃ M.val.obj (Opposite.op W'))
        (hnatW' : ∀ (M N : SheafOfModules.{u+1} (wcRingSheaf S ℓ)) (ψ : M ⟶ N) (g : PW' ⟶ M),
          evW' N (g ≫ ψ) = (ψ.val.app (Opposite.op W')).hom (evW' M g))
        (hpre : ∀ (N : SheafOfModules.{u+1} (wcRingSheaf S ℓ)) (g : PW ⟶ N),
          evW' N (Pmb ≫ g) = (N.val.map b.op).hom (evW N g))
        (Db : wcHMPullData b.left ℓ) (_ : wcHMPullCanonical Db) (β : Abelian.Ext PW M q),
        letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf W'.left ℓ)) := HasExt.standard _
        (Abelian.Ext.mk₀ Db.μ.inv).comp (wcPullExtGen Db q (Ψ β)) (zero_add q) = 0 →
        (Abelian.Ext.mk₀ Pmb).comp β (zero_add q) = 0 :=
by
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf W.left ℓ)) := HasExt.standard _

  obtain ⟨hA, hL, hC⟩ := wc_slice_res_exact S ℓ W
  haveI := hA
  haveI := hL
  haveI := hC
  haveI : EnoughInjectives (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) :=
    sheafOfModules_enoughInjectives (Scheme.ProEt.topology S) (wcRingSheaf S ℓ)

  obtain ⟨εW, hhomW, hεW⟩ := wc_slice_res_free_corep_val S ℓ W PW evW hnatW
  have hvanW : ∀ (I : SheafOfModules.{u+1} (wcRingSheaf S ℓ)) [Injective I] (n : ℕ)
      (e : Abelian.Ext (SheafOfModules.unit (wcRingSheaf W.left ℓ))
        ((wcSliceRes S ℓ W).obj I) (n + 1)), e = 0 := by
    intro I _ n e
    haveI := wc_slice_res_preserves_injective S ℓ W I
    exact Abelian.Ext.eq_zero_of_injective e

  let Ψ : Abelian.Ext PW M q →+
      Abelian.Ext (SheafOfModules.unit (wcRingSheaf W.left ℓ)) ((wcSliceRes S ℓ W).obj M) q :=
    AddMonoidHom.mk' (fun β => (Abelian.Ext.mk₀ εW).comp
        (Abelian.Ext.mapExactFunctor (wcSliceRes S ℓ W) β) (zero_add q))
      (fun a b => by rw [Abelian.Ext.mapExactFunctor_add, Abelian.Ext.comp_add])
  refine ⟨Ψ, ?_, ?_⟩
  · exact ext_transfer_of_corep (wcSliceRes S ℓ W) PW _ εW hhomW hvanW M q

  intro W' b PW' Pmb evW' hnatW' hpre Db hDb β hX
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf W'.left ℓ)) := HasExt.standard _
  haveI : WeaklyEtale W.hom := W.prop
  haveI : WeaklyEtale (b.left ≫ W.hom) := by
    rw [MorphismProperty.Over.w b]
    exact W'.prop
  haveI : WeaklyEtale b.left := WeaklyEtale.of_comp b.left W.hom
  obtain ⟨c1, -, -⟩ := wc_lpsc_site S W'
  haveI := c1
  obtain ⟨c2, -, -⟩ := wc_lpsc_site W.left (Scheme.ProEt.mk b.left)
  haveI := c2
  obtain ⟨hA', hL', hC'⟩ := wc_slice_res_exact S ℓ W'
  haveI := hA'
  haveI := hL'
  haveI := hC'
  obtain ⟨hA2, hL2, hC2⟩ := wc_slice_res_exact W.left ℓ (Scheme.ProEt.mk b.left)
  haveI := Db.additive
  haveI := Db.presLim
  haveI := Db.presColim
  obtain ⟨εW', hhomW', hεW'⟩ := wc_slice_res_free_corep_val S ℓ W' PW' evW' hnatW'
  obtain ⟨ρ, hρ⟩ := wc_slice_res_trans_iso S ℓ W W' b
  have hU := (wc_slice_trans_corep_unit_compat S ℓ W W' b PW PW' Pmb evW evW' hnatW' hpre ρ hρ
    εW hεW εW' hεW').1
  obtain ⟨τ⟩ := wc_hm_pull_Phi_slice_iso W.left ℓ (Scheme.ProEt.mk b.left) Db hDb

  have hvanW' : ∀ (I : SheafOfModules.{u+1} (wcRingSheaf S ℓ)) [Injective I] (n : ℕ)
      (e : Abelian.Ext (SheafOfModules.unit (wcRingSheaf W'.left ℓ))
        ((wcSliceRes S ℓ W').obj I) (n + 1)), e = 0 := by
    intro I _ n e
    haveI := wc_slice_res_preserves_injective S ℓ W' I
    exact Abelian.Ext.eq_zero_of_injective e
  have hbij' := ext_transfer_of_corep (wcSliceRes S ℓ W') PW' _ εW' hhomW' hvanW' M q
  have hinj : ∀ γ : Abelian.Ext PW' M q, (Abelian.Ext.mk₀ εW').comp
      (Abelian.Ext.mapExactFunctor (wcSliceRes S ℓ W') γ) (zero_add q) = 0 → γ = 0 := by
    intro γ hγ
    have h0 : (fun β : Abelian.Ext PW' M q => (Abelian.Ext.mk₀ εW').comp
          (Abelian.Ext.mapExactFunctor (wcSliceRes S ℓ W') β) (zero_add q)) γ =
        (fun β : Abelian.Ext PW' M q => (Abelian.Ext.mk₀ εW').comp
          (Abelian.Ext.mapExactFunctor (wcSliceRes S ℓ W') β) (zero_add q)) 0 := by
      simp only [hγ, Abelian.Ext.mapExactFunctor_zero, Abelian.Ext.comp_zero]
    exact hbij'.1 h0

  obtain ⟨α₁, hα₁⟩ : ∃ a : Abelian.Ext (SheafOfModules.unit (wcRingSheaf W.left ℓ))
      ((wcSliceRes S ℓ W).obj M) q,
      a = (Abelian.Ext.mk₀ εW).comp (Abelian.Ext.mapExactFunctor (wcSliceRes S ℓ W) β)
        (zero_add q) := ⟨_, rfl⟩
  have hX' : (Abelian.Ext.mk₀ Db.μ.inv).comp (Abelian.Ext.mapExactFunctor Db.Φ α₁)
      (zero_add q) = 0 := by
    rw [hα₁]
    exact hX
  have key : ∀ (Rb : SheafOfModules.{u+1} (wcRingSheaf W.left ℓ) ⥤
        SheafOfModules.{u+1} (wcRingSheaf W'.left ℓ))
      [Rb.Additive] [Limits.PreservesFiniteLimits Rb] [Limits.PreservesFiniteColimits Rb]
      (τ : Db.Φ ≅ Rb) (ρ : wcSliceRes S ℓ W ⋙ Rb ≅ wcSliceRes S ℓ W')
      (u : SheafOfModules.unit (wcRingSheaf W'.left ℓ) ⟶
        Rb.obj (SheafOfModules.unit (wcRingSheaf W.left ℓ))),
      u ≫ Rb.map εW ≫ ρ.hom.app PW = εW' ≫ (wcSliceRes S ℓ W').map Pmb →
      (Abelian.Ext.mk₀ Pmb).comp β (zero_add q) = 0 := by
    intro Rb i1 i2 i3 τ ρ u hU
    apply hinj

    have e1 := Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp α₁ τ.hom
    have hA0 : (Abelian.Ext.mk₀ (Db.μ.inv ≫
        τ.hom.app (SheafOfModules.unit (wcRingSheaf W.left ℓ)))).comp
        (Abelian.Ext.mapExactFunctor Rb α₁) (zero_add q) = 0 := by
      rw [← Abelian.Ext.mk₀_comp_mk₀_assoc, ← e1, ← Abelian.Ext.comp_assoc_of_third_deg_zero,
        hX', Abelian.Ext.zero_comp]

    have hd : (u ≫ τ.inv.app (SheafOfModules.unit (wcRingSheaf W.left ℓ)) ≫ Db.μ.hom) ≫
        (Db.μ.inv ≫ τ.hom.app (SheafOfModules.unit (wcRingSheaf W.left ℓ))) = u := by
      simp
    have hB : (Abelian.Ext.mk₀ u).comp (Abelian.Ext.mapExactFunctor Rb α₁) (zero_add q) = 0 := by
      rw [← hd, ← Abelian.Ext.mk₀_comp_mk₀_assoc, hA0, Abelian.Ext.comp_zero]

    have e2 := Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp β ρ.hom
    have hc1 : Abelian.Ext.mapExactFunctor Rb α₁ = (Abelian.Ext.mk₀ (Rb.map εW)).comp
        (Abelian.Ext.mapExactFunctor (wcSliceRes S ℓ W ⋙ Rb) β) (zero_add q) := by
      rw [hα₁, Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
        Abelian.Ext.comp_mapExactFunctor]
    have hc2 : ((Abelian.Ext.mk₀ u).comp (Abelian.Ext.mapExactFunctor Rb α₁) (zero_add q)).comp
        (Abelian.Ext.mk₀ (ρ.hom.app M)) (add_zero q) =
        (Abelian.Ext.mk₀ εW').comp (Abelian.Ext.mapExactFunctor (wcSliceRes S ℓ W')
          ((Abelian.Ext.mk₀ Pmb).comp β (zero_add q))) (zero_add q) := by
      rw [hc1, Abelian.Ext.mk₀_comp_mk₀_assoc, Abelian.Ext.comp_assoc_of_third_deg_zero, e2,
        Abelian.Ext.mk₀_comp_mk₀_assoc, Category.assoc, hU, Abelian.Ext.mapExactFunctor_comp,
        Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mk₀_comp_mk₀_assoc]
    rw [← hc2, hB, Abelian.Ext.zero_comp]
  exact @key (wcSliceRes W.left ℓ (Scheme.ProEt.mk b.left)) hA2 hL2 hC2 τ ρ
    (wcSliceUnit W.left ℓ (Scheme.ProEt.mk b.left)) hU

theorem wc_closed_corep_coeff_ext_transfer {S Z : Scheme.{u}} (i : Z ⟶ S) [IsClosedImmersion i]
    [IsLocallyNoetherian S] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (Di : wcHMPullData i ℓ) (hDi : wcHMPullCanonical Di) (W : S.ProEt)
    (PW : SheafOfModules.{u+1} (wcRingSheaf S ℓ))
    (evW : ∀ M : SheafOfModules.{u+1} (wcRingSheaf S ℓ), (PW ⟶ M) ≃ M.val.obj (Opposite.op W))
    (hnatW : ∀ (M N : SheafOfModules.{u+1} (wcRingSheaf S ℓ)) (ψ : M ⟶ N) (g : PW ⟶ M),
      evW N (g ≫ ψ) = (ψ.val.app (Opposite.op W)).hom (evW M g))
    (haddW : ∀ (M : SheafOfModules.{u+1} (wcRingSheaf S ℓ)) (g g' : PW ⟶ M),
      evW M (g + g') = evW M g + evW M g') (q : ℕ) :
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
    ∃ Θ : Abelian.Ext PW (wcSuppObj Di) q →+ wcHM (Limits.pullback W.hom i) ℓ q,
      Function.Injective Θ ∧
      ∀ (W' : S.ProEt) (b : W' ⟶ W) (PW' : SheafOfModules.{u+1} (wcRingSheaf S ℓ)) (Pmb : PW' ⟶ PW)
        (evW' : ∀ M : SheafOfModules.{u+1} (wcRingSheaf S ℓ), (PW' ⟶ M) ≃ M.val.obj (Opposite.op W'))
        (hnatW' : ∀ (M N : SheafOfModules.{u+1} (wcRingSheaf S ℓ)) (ψ : M ⟶ N) (g : PW' ⟶ M),
          evW' N (g ≫ ψ) = (ψ.val.app (Opposite.op W')).hom (evW' M g))
        (haddW' : ∀ (M : SheafOfModules.{u+1} (wcRingSheaf S ℓ)) (g g' : PW' ⟶ M),
          evW' M (g + g') = evW' M g + evW' M g')
        (hpre : ∀ (N : SheafOfModules.{u+1} (wcRingSheaf S ℓ)) (g : PW ⟶ N),
          evW' N (Pmb ≫ g) = (N.val.map b.op).hom (evW N g))
        (c : Limits.pullback W'.hom i ⟶ Limits.pullback W.hom i)
        (hc₁ : c ≫ Limits.pullback.fst W.hom i = Limits.pullback.fst W'.hom i ≫ b.left)
        (hc₂ : c ≫ Limits.pullback.snd W.hom i = Limits.pullback.snd W'.hom i)
        (Dc : wcHMPullData c ℓ) (_ : wcHMPullCanonical Dc) (β : Abelian.Ext PW (wcSuppObj Di) q),
        (Abelian.Ext.mk₀ Pmb).comp β (zero_add q) = 0 → wcHMPull Dc q (Θ β) = 0 :=
by
  classical
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf Z ℓ)) := HasExt.standard _
  haveI := Di.additive
  haveI := Di.presLim
  haveI := Di.presColim
  haveI := Di.cont

  haveI : (SheafOfModules.pushforward.{u+1} Di.φ).Additive := Di.adj.right_adjoint_additive
  haveI : Limits.PreservesLimitsOfSize.{0, 0} (SheafOfModules.pushforward.{u+1} Di.φ) :=
    Di.adj.rightAdjoint_preservesLimits
  haveI : Limits.PreservesFiniteLimits (SheafOfModules.pushforward.{u+1} Di.φ) :=
    Limits.PreservesLimitsOfSize.preservesFiniteLimits _
  haveI : Limits.PreservesFiniteColimits (SheafOfModules.pushforward.{u+1} Di.φ) :=
    wc_closed_pushforward_exact_of_noetherian i ℓ Di
  haveI : Limits.PreservesLimitsOfShape Limits.WalkingCospan Di.Φ :=
    Limits.PreservesFiniteLimits.preservesFiniteLimits _
  haveI : Di.Φ.PreservesMonomorphisms := preservesMonomorphisms_of_preservesLimitsOfShape _
  haveI : EnoughInjectives (SheafOfModules.{u+1} (wcRingSheaf Z ℓ)) :=
    sheafOfModules_enoughInjectives (Scheme.ProEt.topology Z) (wcRingSheaf Z ℓ)

  obtain ⟨fA, hfA⟩ : ∃ fA : ∀ X : SheafOfModules.{u+1} (wcRingSheaf S ℓ),
      Abelian.Ext (Di.Φ.obj X) (SheafOfModules.unit (wcRingSheaf Z ℓ)) q →+
        Abelian.Ext X (wcSuppObj Di) q,
      ∀ X e, fA X e = (Abelian.Ext.mk₀ (Di.adj.unit.app X)).comp
        (Abelian.Ext.mapExactFunctor (SheafOfModules.pushforward.{u+1} Di.φ) e) (zero_add q) :=
    ⟨fun X => ((Abelian.Ext.mk₀ (Di.adj.unit.app X)).precomp (wcSuppObj Di) (zero_add q)).comp
      ((SheafOfModules.pushforward.{u+1} Di.φ).mapExtAddHom (Di.Φ.obj X)
        (SheafOfModules.unit (wcRingSheaf Z ℓ)) q), fun X e => rfl⟩
  have hbij : ∀ X, Function.Bijective (fA X) := by
    intro X
    have h := wc_ext_adjoint_transfer Di.Φ (SheafOfModules.pushforward.{u+1} Di.φ) Di.adj X
      (SheafOfModules.unit (wcRingSheaf Z ℓ)) q
    have hfun : (⇑(fA X)) = (fun e => (Abelian.Ext.mk₀ (Di.adj.unit.app X)).comp
        (Abelian.Ext.mapExactFunctor (SheafOfModules.pushforward.{u+1} Di.φ) e) (zero_add q)) :=
      funext (hfA X)
    rw [hfun]
    exact h
  have hAnat : ∀ (X X' : SheafOfModules.{u+1} (wcRingSheaf S ℓ)) (f : X' ⟶ X)
      (e : Abelian.Ext (Di.Φ.obj X) (SheafOfModules.unit (wcRingSheaf Z ℓ)) q),
      fA X' ((Abelian.Ext.mk₀ (Di.Φ.map f)).comp e (zero_add q)) =
        (Abelian.Ext.mk₀ f).comp (fA X e) (zero_add q) := by
    intro X X' f e
    rw [hfA, hfA, Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
      Abelian.Ext.mk₀_comp_mk₀_assoc]
    exact (congrArg (fun g => (Abelian.Ext.mk₀ g).comp
      (Abelian.Ext.mapExactFunctor (SheafOfModules.pushforward.{u+1} Di.φ) e) (zero_add q))
      (Di.adj.unit_naturality f)).trans (Abelian.Ext.mk₀_comp_mk₀_assoc _ _ _).symm
  obtain ⟨Ainv, hAinv1, hAinv2⟩ : ∃ Ainv : Abelian.Ext PW (wcSuppObj Di) q →+
      Abelian.Ext (Di.Φ.obj PW) (SheafOfModules.unit (wcRingSheaf Z ℓ)) q,
      (∀ β, fA PW (Ainv β) = β) ∧ (∀ e, Ainv (fA PW e) = e) :=
    ⟨(AddEquiv.ofBijective (fA PW) (hbij PW)).symm.toAddMonoidHom,
      fun β => (AddEquiv.ofBijective (fA PW) (hbij PW)).apply_symm_apply β,
      fun e => (AddEquiv.ofBijective (fA PW) (hbij PW)).symm_apply_apply e⟩

  choose Q evQ hnatQ haddQ using fun T : Z.ProEt =>
    sheafOfModules_free_yoneda (Scheme.ProEt.topology Z) (wcRingSheaf Z ℓ) T
  obtain ⟨Qm, hQm⟩ : ∃ Qm : ∀ (T T' : Z.ProEt), (T' ⟶ T) → (Q T' ⟶ Q T),
      ∀ T T' (b' : T' ⟶ T), Qm T T' b' =
        (evQ T' (Q T)).symm (((Q T).val.map b'.op).hom (evQ T (Q T) (𝟙 (Q T)))) :=
    ⟨fun T T' b' => (evQ T' (Q T)).symm (((Q T).val.map b'.op).hom (evQ T (Q T) (𝟙 (Q T)))),
      fun _ _ _ => rfl⟩
  have hpreQ : ∀ (T T' : Z.ProEt) (b' : T' ⟶ T) (M : SheafOfModules.{u+1} (wcRingSheaf Z ℓ))
      (g : Q T ⟶ M), evQ T' M (Qm T T' b' ≫ g) = (M.val.map b'.op).hom (evQ T M g) := by
    intro T T' b' M g
    rw [hnatQ, hQm]
    have h0 := Equiv.apply_symm_apply (evQ T' (Q T))
      (((Q T).val.map b'.op).hom (evQ T (Q T) (𝟙 (Q T))))
    have h1 := PresheafOfModules.naturality_apply g.val b'.op (evQ T (Q T) (𝟙 (Q T)))
    have h2 : (g.val.app (Opposite.op T)).hom (evQ T (Q T) (𝟙 (Q T))) = evQ T M g :=
      (hnatQ T (Q T) M g (𝟙 _)).symm.trans (congrArg (evQ T M) (Category.id_comp g))
    exact (congrArg (g.val.app (Opposite.op T')).hom h0).trans
      (h1.trans (congrArg (M.val.map b'.op).hom h2))
  obtain ⟨Dw, hDw⟩ := wc_hm_pull_data_exists (𝟙 Z) ℓ
  obtain ⟨ΘQ, hΘQnat, -⟩ := wc_tsf_corep_theta_bc Z ℓ Dw hDw Q Qm evQ hnatQ hpreQ

  have hκ_ex : ∀ (W₀ : S.ProEt) (P₀ : SheafOfModules.{u+1} (wcRingSheaf S ℓ))
      (ev₀ : ∀ M : SheafOfModules.{u+1} (wcRingSheaf S ℓ), (P₀ ⟶ M) ≃ M.val.obj (Opposite.op W₀))
      (_ : ∀ (M N : SheafOfModules.{u+1} (wcRingSheaf S ℓ)) (ψ : M ⟶ N) (g : P₀ ⟶ M),
        ev₀ N (g ≫ ψ) = (ψ.val.app (Opposite.op W₀)).hom (ev₀ M g)),
      ∃ κ : Q ((wcProEtBC i).obj W₀) ≅ Di.Φ.obj P₀,
        ∀ (M : SheafOfModules.{u+1} (wcRingSheaf Z ℓ)) (g : Di.Φ.obj P₀ ⟶ M),
          evQ _ M (κ.hom ≫ g) =
            ev₀ ((SheafOfModules.pushforward.{u+1} Di.φ).obj M) (Di.adj.homEquiv P₀ M g) := by
    intro W₀ P₀ ev₀ hnat₀
    obtain ⟨ev', hev'⟩ : ∃ ev' : ∀ M : SheafOfModules.{u+1} (wcRingSheaf Z ℓ),
        (Di.Φ.obj P₀ ⟶ M) ≃ M.val.obj (Opposite.op ((wcProEtBC i).obj W₀)),
        ∀ M g, ev' M g =
          ev₀ ((SheafOfModules.pushforward.{u+1} Di.φ).obj M) (Di.adj.homEquiv P₀ M g) :=
      ⟨fun M => (Di.adj.homEquiv P₀ M).trans (ev₀ ((SheafOfModules.pushforward.{u+1} Di.φ).obj M)),
        fun _ _ => rfl⟩
    have hnat' : ∀ (M N : SheafOfModules.{u+1} (wcRingSheaf Z ℓ)) (ψ : M ⟶ N)
        (g : Di.Φ.obj P₀ ⟶ M),
        ev' N (g ≫ ψ) = (ψ.val.app (Opposite.op ((wcProEtBC i).obj W₀))).hom (ev' M g) := by
      intro M N ψ g
      rw [hev', hev', Di.adj.homEquiv_naturality_right, hnat₀]
      rfl
    obtain ⟨κh, hκh⟩ : ∃ k : Q ((wcProEtBC i).obj W₀) ⟶ Di.Φ.obj P₀,
