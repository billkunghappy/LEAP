theorem wc_qmbt_dlyt_ct_ext_transport {𝒜 ℬ 𝒞 𝒟 : Type*} [Category 𝒜] [Category ℬ] [Category 𝒞]
    [Category 𝒟] [Abelian 𝒜] [Abelian ℬ] [Abelian 𝒞] [Abelian 𝒟] [HasExt 𝒜] [HasExt ℬ] [HasExt 𝒞]
    [HasExt 𝒟] (G : ℬ ⥤ 𝒜) (L : 𝒜 ⥤ ℬ) (Φk : 𝒜 ⥤ 𝒞) (ΦJ : 𝒞 ⥤ 𝒟) (Φk' : ℬ ⥤ 𝒟)
    [G.Additive] [Limits.PreservesFiniteLimits G] [Limits.PreservesFiniteColimits G]
    [L.Additive] [Limits.PreservesFiniteLimits L] [Limits.PreservesFiniteColimits L]
    [Φk.Additive] [Limits.PreservesFiniteLimits Φk] [Limits.PreservesFiniteColimits Φk]
    [ΦJ.Additive] [Limits.PreservesFiniteLimits ΦJ] [Limits.PreservesFiniteColimits ΦJ]
    [Φk'.Additive] [Limits.PreservesFiniteLimits Φk'] [Limits.PreservesFiniteColimits Φk']
    (α : Φk ⋙ ΦJ ⟶ L ⋙ Φk') (ε : G ⋙ L ⟶ 𝟭 ℬ)
    {S oB : ℬ} {M : 𝒜} {P : 𝒞} {n : ℕ} (θ : Abelian.Ext S oB n) (ψ : M ⟶ G.obj S)
    (γk : P ⟶ Φk.obj M) :
    (Abelian.Ext.mapExactFunctor ΦJ ((Abelian.Ext.mk₀ γk).comp (Abelian.Ext.mapExactFunctor Φk
        ((Abelian.Ext.mk₀ ψ).comp (Abelian.Ext.mapExactFunctor G θ) (zero_add n))) (zero_add n))).comp
      (Abelian.Ext.mk₀ (α.app (G.obj oB) ≫ Φk'.map (ε.app oB))) (add_zero n) =
    (Abelian.Ext.mk₀ (ΦJ.map γk ≫ ΦJ.map (Φk.map ψ) ≫ α.app (G.obj S) ≫ Φk'.map (ε.app S))).comp
      (Abelian.Ext.mapExactFunctor Φk' θ) (zero_add n) :=
by
  let τ : G ⋙ Φk ⋙ ΦJ ⟶ Φk' :=
    { app := fun X => α.app (G.obj X) ≫ Φk'.map (ε.app X)
      naturality := by
        intro X Y f
        have h1 := α.naturality (G.map f)
        have h2 := ε.naturality f
        simp only [Functor.comp_map, Functor.id_map] at h1 h2 ⊢
        rw [← Category.assoc, h1, Category.assoc, ← Φk'.map_comp, h2, Φk'.map_comp,
          Category.assoc] }
  have key := Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp θ τ
  have hH : Abelian.Ext.mapExactFunctor ΦJ (Abelian.Ext.mapExactFunctor Φk
      (Abelian.Ext.mapExactFunctor G θ)) = Abelian.Ext.mapExactFunctor (G ⋙ Φk ⋙ ΦJ) θ := by
    rw [Abelian.Ext.comp_mapExactFunctor, Abelian.Ext.comp_mapExactFunctor]
  rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
    Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_comp,
    Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mapExactFunctor_mk₀, hH]
  rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.comp_assoc_of_third_deg_zero]
  erw [key]
  rw [← Abelian.Ext.comp_assoc_of_second_deg_zero, Abelian.Ext.mk₀_comp_mk₀,
    ← Abelian.Ext.comp_assoc_of_second_deg_zero, Abelian.Ext.mk₀_comp_mk₀, Category.assoc]
  try rfl

theorem wc_qmbt_dlyt_ct_unit_calc {𝒜 ℬ 𝒞 𝒟 : Type*} [Category 𝒜] [Category ℬ] [Category 𝒞]
    [Category 𝒟] (G : ℬ ⥤ 𝒜) (L : 𝒜 ⥤ ℬ) (adj : L ⊣ G) (Φk : 𝒜 ⥤ 𝒞) (ΦJ : 𝒞 ⥤ 𝒟)
    (Φk' : ℬ ⥤ 𝒟) (α : Φk ⋙ ΦJ ⟶ L ⋙ Φk') {oA M : 𝒜} {oB S : ℬ} {oC P : 𝒞} {oD : 𝒟}
    (μ₁ : L.obj oA ≅ oB) (μk : Φk.obj oA ≅ oC) (μJ : ΦJ.obj oC ≅ oD) (μk' : Φk'.obj oB ≅ oD)
    (uY : oA ⟶ M) (ψ : M ⟶ G.obj S) (uY' : oB ⟶ S) (uT : oC ⟶ P) (γk : P ⟶ Φk.obj M)
    (hψ : uY ≫ ψ = (adj.unit.app oA ≫ G.map μ₁.hom) ≫ G.map uY')
    (hγk : uT ≫ γk = μk.inv ≫ Φk.map uY) :
    μJ.inv ≫ ΦJ.map uT ≫ (ΦJ.map γk ≫ ΦJ.map (Φk.map ψ) ≫ α.app (G.obj S) ≫
        Φk'.map (adj.counit.app S)) =
      (μJ.inv ≫ ΦJ.map μk.inv ≫ α.app oA ≫ Φk'.map μ₁.hom ≫ μk'.hom) ≫ μk'.inv ≫ Φk'.map uY' :=
by
  have h1 : L.map (uY ≫ ψ) ≫ adj.counit.app S = μ₁.hom ≫ uY' := by
    rw [hψ]
    first
      | (simp; done)
      | (rw [Category.assoc, ← G.map_comp, L.map_comp, Category.assoc]
         erw [adj.counit_naturality]
         exact adj.left_triangle_components_assoc _)
  have e1 : ΦJ.map uT ≫ ΦJ.map γk = ΦJ.map μk.inv ≫ ΦJ.map (Φk.map uY) := by
    rw [← ΦJ.map_comp, hγk, ΦJ.map_comp]
  have e2 : ΦJ.map (Φk.map uY) ≫ ΦJ.map (Φk.map ψ) ≫ α.app (G.obj S) =
      α.app oA ≫ Φk'.map (L.map (uY ≫ ψ)) := by
    have h := α.naturality (uY ≫ ψ)
    simp only [Functor.comp_map] at h
    rw [← h]
    simp only [Functor.map_comp, Category.assoc]
  have key : Φk'.map (L.map (uY ≫ ψ)) ≫ Φk'.map (adj.counit.app S) =
      Φk'.map μ₁.hom ≫ Φk'.map uY' := by
    rw [← Φk'.map_comp, h1, Φk'.map_comp]
  simp only [Category.assoc, Iso.hom_inv_id_assoc]
  rw [reassoc_of% e1, reassoc_of% e2, key]

