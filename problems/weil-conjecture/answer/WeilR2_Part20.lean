    haveI hmonoΦι : Mono (Dw.Φ.map (Limits.kernel.ι (wcSuppUnitMap Dj))) := inferInstance
    have h1 : ε ≫ (Dw.Φ.map (Limits.kernel.ι (wcSuppUnitMap Dj)) ≫ Dw.μ.hom) = 𝟙 _ := by
      rw [← Category.assoc, hε, Iso.inv_hom_id]
    have h2 : (Dw.Φ.map (Limits.kernel.ι (wcSuppUnitMap Dj)) ≫ Dw.μ.hom) ≫ ε = 𝟙 _ := by
      rw [← cancel_mono (Dw.Φ.map (Limits.kernel.ι (wcSuppUnitMap Dj)))]
      simp only [Category.assoc, hε, Iso.hom_inv_id, Category.comp_id, Category.id_comp]
    haveI hεiso : IsIso ε := ⟨⟨_, h1, h2⟩⟩
    let Vo : V.ProEt := Scheme.ProEt.mk Wo.ι
    haveI hVo : IsOpenImmersion Vo.hom := (inferInstance : IsOpenImmersion Wo.ι)
    haveI hG : (wcSliceFunctor V Vo).IsContinuous (Scheme.ProEt.topology Vo.left)
        (Scheme.ProEt.topology V) := by
      haveI h1' := (wc_slice_over_sites_cont V Vo).1
      haveI h0 : (Over.forget Vo).IsContinuous ((Scheme.ProEt.topology V).over Vo)
          (Scheme.ProEt.topology V) := inferInstance
      have h3 : (wcSliceToOver V Vo ⋙ Over.forget Vo).IsContinuous (Scheme.ProEt.topology Vo.left)
          (Scheme.ProEt.topology V) :=
        Functor.isContinuous_comp _ _ _ ((Scheme.ProEt.topology V).over Vo) _
      exact h3
    have hVorange : Set.range Vo.hom = (Set.range j)ᶜ := by
      show Set.range Wo.ι = _
      rw [Scheme.Opens.range_ι, hW]
    obtain ⟨Φiso⟩ := wc_hm_pull_Phi_slice_iso V ℓ Vo Dw hDw
    have fin_covers : ∀ (U : V.ProEt) [QuasiSeparatedSpace U.left] (n : ℕ) (W : Fin n → V.ProEt)
        (h : ∀ i, W i ⟶ U), (∀ i, IsAffine (W i).left) →
        (∀ x : U.left, ∃ i, x ∈ Set.range (h i).left) →
        Sieve.generate (Presieve.ofArrows W h) ∈ Scheme.ProEt.topology V U := by
      intro U _ n W h hA hJ
      have hs : ∀ x : U.left, ∃ j y, (h j).left y = x := by
        intro x
