by
  have hcov := wc_qmbt_hl_cov hℓ hn hn4 hπ hc hx₀ hsh hℓ' hπ' hπ'2 hgen hbl hblf
  haveI hconn := wc_qmbt_sfh_closed_fibre_connected hℓ hn hn4 hπ hc hx₀ hsh hℓ' hπ' hπ'2 hgen
    hbl hblf hcov hps'
  have hg : Set.range (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B₀))) =
      {IsLocalRing.closedPoint B₀} := by
    have h : ∀ y, (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B₀))) y =
        IsLocalRing.closedPoint B₀ := by
      intro y
      exact IsLocalRing.PrimeSpectrum.comap_residue B₀ y
    exact Set.eq_singleton_iff_unique_mem.mpr
      ⟨⟨IsLocalRing.closedPoint _, h _⟩, fun _ ⟨y, hy⟩ => hy ▸ h y⟩
  have hr : Set.range i₂ = Set.range (Limits.pullback.fst (ι' ≫ bl ≫ Limits.pullback.fst
      (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA)))
      (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B₀)))) := by
    rw [Scheme.Pullback.range_fst, hg, h₂]
  have h5 : _root_.IsPreconnected (Set.range i₂) := by
    rw [hr]
    exact isPreconnected_range (Scheme.Hom.continuous _)
  rw [← Set.image_univ] at h5
