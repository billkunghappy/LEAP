    intro C D E _ _ _ _ _ _ P _ _ _ _ _ R _ adj Φ _ _ _ Pj _ adjj h6 h7 h8 A I m hm h2
    have K0 : ∀ {A' G : C} (f : A' ⟶ G), f ≫ adjj.unit.app G = 0 → Φ.map f = 0 := by
