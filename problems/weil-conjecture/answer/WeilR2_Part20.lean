        (P.rightDerivedFunctorPlus ⋙ DerivedCategory.Plus.ι).map
          (ObjectProperty.homMk (X := (⟨_, hY⟩ : DerivedCategory.Plus 𝒞))
            (Y := (⟨_, hX⟩ : DerivedCategory.Plus 𝒞))
            (DerivedCategory.Q.map (CochainComplex.mappingCone.inr φ) ≫ g₀)) ≫
        (P.rightDerivedFunctorPlus ⋙ DerivedCategory.Plus.ι).map
          (ObjectProperty.homMk (X := (⟨_, hX⟩ : DerivedCategory.Plus 𝒞))
            (Y := (⟨_, hY⟩ : DerivedCategory.Plus 𝒞)) (DerivedCategory.Q.map φ)) := by
      rw [← Functor.map_comp]
      congr 1
      ext
      simp
    obtain ⟨g, hg⟩ := Pretriangulated.Triangle.coyoneda_exact₂ _
      (Pretriangulated.inv_rot_of_distTriang _ hT)
      ((P.rightDerivedFunctorPlus ⋙ DerivedCategory.Plus.ι).map
          (ObjectProperty.homMk (X := (⟨_, hY⟩ : DerivedCategory.Plus 𝒞))
            (Y := (⟨_, hX⟩ : DerivedCategory.Plus 𝒞))
            (DerivedCategory.Q.map (CochainComplex.mappingCone.inr φ) ≫ g₀)))
      (by
        change _ ≫ (P.rightDerivedFunctorPlus ⋙ DerivedCategory.Plus.ι).map
