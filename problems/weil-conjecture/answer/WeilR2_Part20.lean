theorem wc_et_integral_push_ext_equiv : ∀ {W Y : Scheme.{u}} (π : W ⟶ Y) [IsIntegralHom π]
    (F : Sheaf (Scheme.smallEtaleTopology W) AddCommGrpCat.{u+1}) (q : ℕ),
    Nonempty (wcEtExt Y ((wcEtPush π).obj F) q ≃ wcEtExt W F q) :=
by
  intro W Y π _ F q
  obtain ⟨L, ⟨adj⟩, hPFL, ⟨e⟩⟩ := wc_et_push_left_adjoint π
  haveI := hPFL
  haveI hFc : Limits.PreservesFiniteColimits (wcEtPush π) := wc_et_integral_push_exact π
  haveI hFl : Limits.PreservesFiniteLimits (wcEtPush π) := by
    haveI := adj.rightAdjoint_preservesLimits.{0, 0}
    exact Limits.PreservesLimitsOfSize.preservesFiniteLimits.{0, 0} (wcEtPush π)
  haveI : (wcEtPush π).IsRightAdjoint := adj.isRightAdjoint
  haveI : (wcEtPush π).PreservesZeroMorphisms :=
    Functor.preservesZeroMorphisms_of_isRightAdjoint (wcEtPush π)
  haveI : (wcEtPush π).Additive := Functor.additive_of_preserves_binary_products (wcEtPush π)
  haveI : L.PreservesMonomorphisms := preservesMonomorphisms_of_preservesLimitsOfShape L
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology W) AddCommGrpCat.{u+1}) := HasExt.standard _
  haveI : EssentiallySmall.{u+1} W.Etale := inferInstance
  haveI : IsGrothendieckAbelian.{u+1} (Sheaf (Scheme.smallEtaleTopology W) AddCommGrpCat.{u+1}) :=
    Sheaf.isGrothendieckAbelian_of_essentiallySmall _ _
  haveI : EnoughInjectives (Sheaf (Scheme.smallEtaleTopology W) AddCommGrpCat.{u+1}) :=
    IsGrothendieckAbelian.enoughInjectives
  let ZY := (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
    (AddCommGrpCat.of (ULift.{u+1} ℤ))
  let ZW := (constantSheaf (Scheme.smallEtaleTopology W) AddCommGrpCat.{u+1}).obj
    (AddCommGrpCat.of (ULift.{u+1} ℤ))
  let Θ := Equiv.ofBijective _ (wc_ext_adjoint_transfer L (wcEtPush π) adj ZY F q)
  let E2 : Abelian.Ext (L.obj ZY) F q ≃ Abelian.Ext ZW F q :=
    { toFun := fun y => (Abelian.Ext.mk₀ e.inv).comp y (zero_add q)
      invFun := fun y => (Abelian.Ext.mk₀ e.hom).comp y (zero_add q)
      left_inv := fun y => by
        simp only
        rw [← Abelian.Ext.comp_assoc _ _ _ (add_zero 0) (zero_add q) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.mk₀_id_comp]
      right_inv := fun y => by
        simp only
        rw [← Abelian.Ext.comp_assoc _ _ _ (add_zero 0) (zero_add q) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.mk₀_id_comp] }
  change Nonempty (Abelian.Ext ZY ((wcEtPush π).obj F) q ≃ Abelian.Ext ZW F q)
  exact ⟨Θ.symm.trans E2⟩

theorem wc_qmbt_D1l_blowup_fibre_divisor_model {A' : Type u} [CommRing A'] [IsDomain A']
    [IsDiscreteValuationRing A'] {π' : A'} (hπ' : IsLocalRing.maximalIdeal A' = Ideal.span {π'})
    {n : ℕ} (hn : 2 ≤ n) {c₁ : Matrix (Fin n) (Fin n) A'} (hc₁ : IsUnit (c₁ + c₁.transpose).det)
    {X₁ : Scheme.{u}} (r₁ : X₁ ⟶ Spec (.of (wcQuadModelRing A' n (π' ^ 2) c₁)))
    (hr : wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range fun k =>
      (Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) c₁))).inv.hom
        (wcQmbtGen A' n π' c₁ k)))) r₁)
    {K : Type u} [Field K] (ω : wcQuadModelRing A' n (π' ^ 2) c₁ →+* K)
    (hωX : ∀ p, ω (Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) c₁) (MvPolynomial.X p)) = 0)
    (hωπ : ω (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c₁) π') = 0) :
    ∃ W : X₁.Opens,
      (∀ w ∈ W, algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c₁) π' ∈ PrimeSpectrum.asIdeal (r₁ w) →
        ∀ k, wcQmbtGen A' n π' c₁ k ∈ PrimeSpectrum.asIdeal (r₁ w)) ∧
      (∀ w, w ∉ W → (∀ k, wcQmbtGen A' n π' c₁ k ∈ PrimeSpectrum.asIdeal (r₁ w)) →
        ∃ w', w' ⤳ w ∧
          algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c₁) π' ∈ PrimeSpectrum.asIdeal (r₁ w') ∧
          ∃ k, wcQmbtGen A' n π' c₁ k ∉ PrimeSpectrum.asIdeal (r₁ w')) ∧
      SmoothOfRelativeDimension (n - 1) (Limits.pullback.snd r₁ (Spec.map (CommRingCat.ofHom ω))) ∧
      ∃ (Y : Scheme.{u}) (i : Y ⟶ Limits.pullback r₁ (Spec.map (CommRingCat.ofHom ω))),
        IsClosedImmersion i ∧
        SmoothOfRelativeDimension (n - 2) (i ≫ Limits.pullback.snd r₁ (Spec.map (CommRingCat.ofHom ω))) ∧
        Set.range i = (Limits.pullback.fst r₁ (Spec.map (CommRingCat.ofHom ω))) ⁻¹' (W : Set X₁)ᶜ ∧
        ∃ c' : Matrix (Fin n) (Fin n) K, IsUnit (c' + c'.transpose).det ∧
          Nonempty (((Limits.pullback.fst r₁ (Spec.map (CommRingCat.ofHom ω))) ⁻¹ᵁ W).toScheme ≅
            Spec (.of (wcQuadModelRing K n 1 c'))) :=
by
  classical
  obtain ⟨φN, φ, eN, e, hNX, hNA, hNgen, hNup, hφX, hφA, hnzd, hgen, hNo, heo, hN, he, hcov⟩ :=
    wc_qmbt_bof_atlas hπ' r₁ hr
  haveI := hNo
  haveI : ∀ j, IsOpenImmersion (e j) := heo
  have hcompl := wc_qmbt_bof_chart_compl r₁ hr φN φ eN e hNgen hNup hφX hφA hnzd hgen hN he
  obtain ⟨Z₁, z, hz, hrange, hloc⟩ :=
    wc_qmbt_bof_divisor r₁ hr φN φ eN e hNX hNA hφX hφA hnzd hgen hN he hcov hcompl
  haveI := hz
  choose hj hsurj hker hs using hloc
  have sq : ∀ j, ∃ g : Spec (.of (wcQmbtChart A' n π' c₁ j ⧸ wcQmbtBofSIdeal A' n π' c₁ j)) ⟶ Z₁,
      IsPullback g (Spec.map (CommRingCat.ofHom
        (Ideal.Quotient.mk (wcQmbtBofSIdeal A' n π' c₁ j)))) z (e j) :=
    fun j => wc_qmbt_bof_closed_chart z (e j) _ (hj j) (hsurj j) (hker j) (hs j)
  choose g hg using sq
  obtain ⟨lam, hlam⟩ : ∃ lam : A' →+* K,
      ω.comp (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c₁)) = lam := ⟨_, rfl⟩
  have hdet : IsUnit ((c₁.map lam) + (c₁.map lam).transpose).det := by
    have h1 : (c₁.map lam) + (c₁.map lam).transpose = (c₁ + c₁.transpose).map lam := by
      ext i j; simp
    have h2 := RingHom.map_det lam (c₁ + c₁.transpose)
    rw [RingHom.mapMatrix_apply] at h2
    rw [h1, ← h2]
    exact hc₁.map lam
  obtain ⟨qN, hqN⟩ := wc_qmbt_bof_pushout_none ω hωX hωπ lam hlam φN hNX hNA
  choose qj hqj using fun j =>
    wc_qmbt_bof_pushout_chart ω hωX hωπ lam hlam j (φ j) (hφX j) (hφA j)
  choose qd hqd using fun j =>
    wc_qmbt_bof_pushout_divisor ω hωX hωπ lam hlam j (φ j) (hφX j) (hφA j)
  have pN : IsPullback (Spec.map (CommRingCat.ofHom qN))
      (Spec.map (CommRingCat.ofHom (algebraMap K (wcQuadModelRing K n 1 (c₁.map lam)))))
      (eN ≫ r₁) (Spec.map (CommRingCat.ofHom ω)) := by
    rw [hN]; exact isPullback_SpecMap_of_isPushout _ _ _ _ hqN
  have pC : ∀ j, IsPullback (Spec.map (CommRingCat.ofHom (qj j)))
      (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Option (Fin n)) K ⧸
        Ideal.span (Set.range (wcQmbtBofRelChart K n (c₁.map lam) j))))))
      (e j ≫ r₁) (Spec.map (CommRingCat.ofHom ω)) := by
    intro j; rw [he j]; exact isPullback_SpecMap_of_isPushout _ _ _ _ (hqj j)
  have hsmN : SmoothOfRelativeDimension (n - 1)
      (Spec.map (CommRingCat.ofHom (algebraMap K (wcQuadModelRing K n 1 (c₁.map lam))))) := by
    have h := wc_qmbt_bof_jacobian_cover_smooth K (wcQmbtBofRelNone K n (c₁.map lam))
      (wcQuadModelIdeal K n 1 (c₁.map lam)) (by unfold wcQmbtBofRelNone; rw [Set.range_const])
      (fun r : Fin n => fun _ : Fin 1 => r) (fun _ a b _ => Subsingleton.elim a b)
      (wc_qmbt_bof_minors_none (c₁.map lam) hdet)
    rw [Fintype.card_fin] at h
    exact h
  have hsmC : ∀ j, SmoothOfRelativeDimension (n - 1)
      (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Option (Fin n)) K ⧸
        Ideal.span (Set.range (wcQmbtBofRelChart K n (c₁.map lam) j)))))) := by
    intro j
    have hinj : ∀ w : {v : Option (Fin n) // v ≠ some j},
        Function.Injective (![some j, w.1] : Fin 2 → Option (Fin n)) := by
      rintro ⟨w, hw⟩ a b hab
      fin_cases a <;> fin_cases b <;> (try simp at hab ⊢) <;>
        first | exact absurd hab.symm hw | exact absurd hab hw | exact hab.elim | rfl
    have h := wc_qmbt_bof_jacobian_cover_smooth K (wcQmbtBofRelChart K n (c₁.map lam) j)
      _ rfl (fun w : {v : Option (Fin n) // v ≠ some j} => ![some j, w.1]) hinj
      (wc_qmbt_bof_minors_chart (c₁.map lam) hdet j)
    rw [Fintype.card_option, Fintype.card_fin, show n + 1 - 2 = n - 1 by omega] at h
    exact h
  have hsmD : ∀ j, SmoothOfRelativeDimension (n - 2)
      (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Option (Fin n)) K ⧸
        Ideal.span (Set.range (wcQmbtBofRelDiv K n (c₁.map lam) j)))))) := by
    intro j
    have hinj : ∀ w : {p : Fin n // p ≠ j},
        Function.Injective (![some j, none, some w.1] : Fin 3 → Option (Fin n)) := by
      rintro ⟨w, hw⟩ a b hab
      fin_cases a <;> fin_cases b <;> (try simp at hab ⊢) <;>
        first | exact absurd hab.symm hw | exact absurd hab hw | exact hab.elim | rfl
    have h := wc_qmbt_bof_jacobian_cover_smooth K (wcQmbtBofRelDiv K n (c₁.map lam) j)
      _ rfl (fun w : {p : Fin n // p ≠ j} => ![some j, none, some w.1]) hinj
      (wc_qmbt_bof_minors_divisor (c₁.map lam) hdet j)
    rw [Fintype.card_option, Fintype.card_fin, show n + 1 - 3 = n - 2 by omega] at h
    exact h

  have hptN : ∀ q, (r₁ (eN q)).asIdeal = Ideal.comap φN q.asIdeal := by
    intro q
    rw [← Scheme.Hom.comp_apply, hN]
    rfl
  have hptC : ∀ j q, (r₁ (e j q)).asIdeal = Ideal.comap (φ j) q.asIdeal := by
    intro j q
    rw [← Scheme.Hom.comp_apply, he j]
    rfl
  have hφjj : ∀ j, φ j (Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) c₁)
      (MvPolynomial.X j)) =
      Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c₁ j) (MvPolynomial.X (some j)) := by
    intro j
    rw [hφX j j]
    simp [wcQmbtChartHat]
  have hmemW : ∀ w, w ∈ eN.opensRange ↔ w ∈ Set.range eN := by
    intro w
    rw [← SetLike.mem_coe, Scheme.Hom.coe_opensRange]

  have T1 : ∀ w ∈ eN.opensRange,
      algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c₁) π' ∈ PrimeSpectrum.asIdeal (r₁ w) →
        ∀ k, wcQmbtGen A' n π' c₁ k ∈ PrimeSpectrum.asIdeal (r₁ w) := by
    intro w hw hπw k
    obtain ⟨q, rfl⟩ := (hmemW w).mp hw
    rw [hptN] at hπw ⊢
    have hstar : algebraMap A' (wcQmbtChartNone A' n c₁) π' ∈ q.asIdeal := by
      rw [← RingHom.congr_fun hNA π']; exact hπw
    cases k with
