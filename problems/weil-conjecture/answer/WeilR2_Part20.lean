      letI : HasExt (SheafOfModules.{u+1} (wcZModRingSheaf S0 ℓ)) := HasExt.standard _
      (Abelian.Ext.mk₀ (wcZModFun S0 ℓ r)).comp h (zero_add k) =
        (Abelian.Ext.mk₀ (wcZModFun S0 ℓ r')).comp h (zero_add k) := by
    intro S0 r r' hr h
    subst hr
    rfl
  have G1 : ∀ (S0 : Scheme.{u}) (r : C(↥S0, ULift.{u+1} (ZMod ℓ))), r = 1 →
      ∀ h : wcZModProEtExt S0 ℓ k,
      letI : HasExt (SheafOfModules.{u+1} (wcZModRingSheaf S0 ℓ)) := HasExt.standard _
      (Abelian.Ext.mk₀ (wcZModFun S0 ℓ r)).comp h (zero_add k) = h := by
    intro S0 r hr h
    letI : HasExt (SheafOfModules.{u+1} (wcZModRingSheaf S0 ℓ)) := HasExt.standard _
    subst hr
    rw [hFunOne]
    exact Abelian.Ext.mk₀_id_comp h
  have G2 : ∀ (S0 : Scheme.{u}) (r r1 r2 : C(↥S0, ULift.{u+1} (ZMod ℓ))), r = r1 * r2 →
      ∀ h : wcZModProEtExt S0 ℓ k,
      letI : HasExt (SheafOfModules.{u+1} (wcZModRingSheaf S0 ℓ)) := HasExt.standard _
      (Abelian.Ext.mk₀ (wcZModFun S0 ℓ r)).comp h (zero_add k) =
        (Abelian.Ext.mk₀ (wcZModFun S0 ℓ r1)).comp
          ((Abelian.Ext.mk₀ (wcZModFun S0 ℓ r2)).comp h (zero_add k)) (zero_add k) := by
    intro S0 r r1 r2 hr h
    letI : HasExt (SheafOfModules.{u+1} (wcZModRingSheaf S0 ℓ)) := HasExt.standard _
    subst hr
    rw [hFunMul, ← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.comp_assoc_of_second_deg_zero]
  have G3 : ∀ (S0 : Scheme.{u}) (r r1 r2 : C(↥S0, ULift.{u+1} (ZMod ℓ))), r = r1 + r2 →
      ∀ h : wcZModProEtExt S0 ℓ k,
      letI : HasExt (SheafOfModules.{u+1} (wcZModRingSheaf S0 ℓ)) := HasExt.standard _
      (Abelian.Ext.mk₀ (wcZModFun S0 ℓ r)).comp h (zero_add k) =
        (Abelian.Ext.mk₀ (wcZModFun S0 ℓ r1)).comp h (zero_add k) +
          (Abelian.Ext.mk₀ (wcZModFun S0 ℓ r2)).comp h (zero_add k) := by
    intro S0 r r1 r2 hr h
    letI : HasExt (SheafOfModules.{u+1} (wcZModRingSheaf S0 ℓ)) := HasExt.standard _
    subst hr
    rw [hFunAdd, Abelian.Ext.mk₀_add, Abelian.Ext.add_comp]
  have he1 : ∀ h, e Set.univ isClopen_univ h = h := by
    intro h
    have hf : χ Set.univ isClopen_univ = 1 :=
      ContinuousMap.ext fun x => (hχ _ _ x).trans (congrFun (Set.indicator_univ _) _)
    exact (he _ _ h).trans (G1 _ _ hf h)
  have hei : ∀ (O O' : Set W₀) (hO : IsClopen O) (hO' : IsClopen O') h,
      e (O ∩ O') (hO.inter hO') h = e O hO (e O' hO' h) := by
    intro O O' hO hO' h
    have hf : χ (O ∩ O') (hO.inter hO') = χ O hO * χ O' hO' :=
      ContinuousMap.ext fun x => (hχ _ _ x).trans
        ((congrFun (Set.inter_indicator_one (M₀ := ULift.{u+1} (ZMod ℓ)) (s := O) (t := O')) _).trans
          (congrArg₂ (· * ·) (hχ O hO x) (hχ O' hO' x)).symm)
    exact (he _ _ h).trans ((G2 _ _ _ _ hf h).trans
      ((congrArg (fun y => (Abelian.Ext.mk₀ (wcZModFun T ℓ (χ O hO))).comp y
          (zero_add k)) (he O' hO' h).symm).trans (he O hO _).symm))
  have heu : ∀ (O O' : Set W₀) (hO : IsClopen O) (hO' : IsClopen O'), Disjoint O O' → ∀ h,
      e (O ∪ O') (hO.union hO') h = e O hO h + e O' hO' h := by
    intro O O' hO hO' hdisj h
    have hf : χ (O ∪ O') (hO.union hO') = χ O hO + χ O' hO' :=
      ContinuousMap.ext fun x => (hχ _ _ x).trans
        ((congrFun (Set.indicator_union_of_disjoint hdisj (1 : W₀ → ULift.{u+1} (ZMod ℓ))) _).trans
          (congrArg₂ (· + ·) (hχ O hO x) (hχ O' hO' x)).symm)
    exact (he _ _ h).trans ((G3 _ _ _ _ hf h).trans
      (congrArg₂ (· + ·) (he O hO h).symm (he O' hO' h).symm))
  have hZ : ∀ x : W₀, ∃ z ∈ {x : W₀ | IsClosed ({x} : Set W₀)}, x ⤳ z := by
    intro x
    obtain ⟨y, hy, _⟩ := hu x
    exact ⟨y, hy.1, hy.2⟩
  have hs : ∀ z ∈ {x : W₀ | IsClosed ({x} : Set W₀)},
      ∀ h : wcZModProEtExt T ℓ k,
      ∃ (a : PUnit.{1}) (O : Set W₀) (hO : IsClopen O), z ∈ O ∧
        e O hO h = e O hO ((0 : PUnit.{1} →+ wcZModProEtExt T ℓ k) a) := by
    intro z hz h
    haveI := hstalk z hz
    obtain ⟨Dz, hDz⟩ := wc_zmod_pull_data_exists (Limits.pullback.snd (W₀.fromSpecStalk z) g) ℓ
    have h0 : wcZModPull Dz k h = 0 := Subsingleton.elim _ _
    obtain ⟨O, hO, hzO, hO0⟩ := wc_zmod_wlocal_closed_point_continuity haff hc hu
      g hqc hqs ℓ k z hz Dz hDz h h0
    refine ⟨PUnit.unit, O, hO, hzO, ?_⟩
    rw [AddMonoidHom.zero_apply, map_zero]
    exact (he _ _ _).trans ((G0 _ _ _ (hχdef O hO) _).trans hO0)
  have hi : ∀ z ∈ {x : W₀ | IsClosed ({x} : Set W₀)}, ∀ (a : PUnit.{1}) (O : Set W₀)
      (hO : IsClopen O), z ∈ O →
      e O hO ((0 : PUnit.{1} →+ wcZModProEtExt T ℓ k) a) = 0 → a = 0 :=
    fun _ _ a _ _ _ _ => Subsingleton.elim _ _
  obtain ⟨Ξ, -⟩ := wc_lc_clopen_assembly e he1 hei heu
    (0 : PUnit.{1} →+ wcZModProEtExt T ℓ k)
    {x : W₀ | IsClosed ({x} : Set W₀)} hZ hs hi
  haveI : Subsingleton (LocallyConstant W₀ PUnit.{1}) :=
    ⟨fun f f' => LocallyConstant.ext (fun x => Subsingleton.elim _ _)⟩
  haveI hX1 : Subsingleton (wcZModProEtExt T ℓ k) := Ξ.symm.injective.subsingleton
  haveI : Subsingleton (wcEtZModExt T ℓ k) := (hΘ _ hTc hTq).1.subsingleton
  obtain ⟨E⟩ := wc_et_zmodext_coh_equiv T ℓ k
  exact E.symm.subsingleton

theorem wc_strict_closed_sub_et_vanish (R : CommRingCat.{u}) [HenselianLocalRing R]
    [IsSepClosed (IsLocalRing.ResidueField R)] {Z : Scheme.{u}} (i : Z ⟶ Spec R)
    [IsClosedImmersion i] (m q : ℕ) : Subsingleton (wcEtCoh Z m (q + 1)) :=
by
  obtain ⟨I, e, -⟩ := (IsClosedImmersion.Spec_iff (f := i)).1 inferInstance
  by_cases hI : I = ⊤
  · haveI : Subsingleton (R ⧸ I) := Ideal.Quotient.subsingleton_iff.2 hI
    have hE : IsEmpty Z :=
      ⟨fun z => (inferInstance : IsEmpty (PrimeSpectrum (R ⧸ I))).false (e.hom z)⟩
    obtain ⟨E⟩ := wc_et_zmodext_coh_equiv Z m (q + 1)
    haveI : Subsingleton (wcEtZModExt Z m (q + 1)) := by
      letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Z m)) := HasExt.standard _
      have hU := wc_et_zmod_modules_zero_of_isEmpty Z m hE
        (SheafOfModules.unit (wcEtZModRing Z m))
      have h0 : ∀ x : Abelian.Ext (SheafOfModules.unit (wcEtZModRing Z m))
          (SheafOfModules.unit (wcEtZModRing Z m)) (q + 1), x = 0 := by
        intro x
        rw [← Abelian.Ext.mk₀_id_comp x, hU.eq_of_src (𝟙 _) 0, Abelian.Ext.mk₀_zero,
          Abelian.Ext.zero_comp]
      exact ⟨fun a b => (h0 a).trans (h0 b).symm⟩
    exact E.symm.subsingleton
  · obtain ⟨hH, hS⟩ := wc_quot_strictly_henselian_of_ne_top R I hI
    haveI := hH
    haveI := hS
    haveI h0 : Subsingleton (wcEtCoh (Spec (.of (R ⧸ I))) m (q + 1)) :=
      wc_et_strictly_local_ext_vanishing (R ⧸ I) _ q
    obtain ⟨E⟩ := wc_et_coh_iso_invariance e.hom m (q + 1)
    exact E.symm.subsingleton

theorem wc_qmbt_xsp_adc_model {A : Type u} [CommRing A] [IsDomain A]
    [IsDiscreteValuationRing A]
    [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (hℓ : IsUnit ((ℓ : ℕ) : A)) {n : ℕ} (hn : Even n) (hn4 : 4 ≤ n) {π : A}
    {c : Matrix (Fin n) (Fin n) A}
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π}) (hc : IsUnit (c + c.transpose).det)
    {x₀ : Spec (.of (wcQuadModelRing A n π c))}
    (hx₀ : ∀ p, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
      PrimeSpectrum.asIdeal x₀)
    {B₀ : Type u} [CommRing B₀] [HenselianLocalRing B₀] [IsSepClosed (IsLocalRing.ResidueField B₀)]
    {Λ₀ : Type u} [SmallCategory Λ₀] [IsCofiltered Λ₀]
    {W₀ : Λ₀ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (wcQuadModelRing A n π c))) x₀))
      (Scheme.Etale.forget (Spec (.of (wcQuadModelRing A n π c))))}
    {φ₀ : ∀ l, Spec (.of B₀) ⟶ (W₀.obj l).right.left}
    {a₀ : Spec (.of B₀) ⟶ Spec (.of (wcQuadModelRing A n π c))}
    (hsh : wcHalShData x₀ B₀ Λ₀ W₀ φ₀ a₀)
    {A' : Type u} [CommRing A'] [IsDomain A'] [IsDiscreteValuationRing A'] [HenselianLocalRing A']
    [IsSepClosed (IsLocalRing.ResidueField A')] {ιA : A →+* A'} {π' : A'}
    (hℓ' : IsUnit ((ℓ : ℕ) : A')) (hπ' : IsLocalRing.maximalIdeal A' = Ideal.span {π'})
    (hπ'2 : π' ^ 2 = ιA π) (hgen : ∀ a' : A', ∃ x y : A, a' = ιA x + ιA y * π') :
    ∃ (Xm₀ : Scheme.{u}) (f₀ : Xm₀ ⟶ Spec (.of A'))
      (bl₀ : Xm₀ ⟶ Limits.pullback (a₀ ≫ wcQuadModelStr A n π c)
        (Spec.map (CommRingCat.ofHom ιA))),
      wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range
        (fun i : Option (Fin n) => Option.elim i
          ((Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
            (Spec.map (CommRingCat.ofHom ιA))).appTop.hom
            ((Scheme.ΓSpecIso (CommRingCat.of A')).inv.hom π'))
          (fun j => ((Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
            (Spec.map (CommRingCat.ofHom ιA))) ≫ a₀).appTop.hom
            ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A n π c))).inv.hom
              (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X j)))))))) bl₀ ∧
      bl₀ ≫ Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
        (Spec.map (CommRingCat.ofHom ιA)) = f₀ ∧
      ∀ x : Xm₀,
        (∃ (U : Xm₀.Opens) (r : ℕ)
          (g : U.toScheme ⟶ Spec (.of (wcQuadModelRing A' (r + 2) π'
            (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0))))
          (y : U.toScheme),
          U.ι y = x ∧ WeaklyEtale g ∧
          g ≫ wcQuadModelStr A' (r + 2) π'
            (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0) =
            U.ι ≫ f₀ ∧
          ∀ u : U.toScheme,
            (Ideal.Quotient.mk (wcQuadModelIdeal A' (r + 2) π'
                (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0))
                (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2))) ∈ PrimeSpectrum.asIdeal (g u) ↔
              ∀ p : Fin n, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
                PrimeSpectrum.asIdeal (a₀ ((bl₀ ≫ Limits.pullback.fst
                  (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))) (U.ι u))))) ∨
        (∃ N : Xm₀.Opens, x ∈ N ∧ ∀ x' : Xm₀, x' ∈ N → f₀ x' = IsLocalRing.closedPoint A' →
          ∀ p : Fin n, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
            PrimeSpectrum.asIdeal (a₀ ((bl₀ ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
              (Spec.map (CommRingCat.ofHom ιA))) x'))) :=
by
  classical
  have hn2 : 2 ≤ n := by omega

  obtain ⟨θ, hθX, hθA, sq₁⟩ := wc_qmbt_bm_quad_pullback ιA n π c π' hπ'2
  obtain ⟨gP, hgP1, hgP2⟩ : ∃ gP : Limits.pullback (a₀ ≫ wcQuadModelStr A n π c)
        (Spec.map (CommRingCat.ofHom ιA)) ⟶
        Spec (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) (c.map ιA))),
      gP ≫ Spec.map (CommRingCat.ofHom θ) = Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
        (Spec.map (CommRingCat.ofHom ιA)) ≫ a₀ ∧
      gP ≫ Spec.map (CommRingCat.ofHom
          (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)))) =
        Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA)) :=
    ⟨sq₁.lift _ _ (by rw [Category.assoc]; exact Limits.pullback.condition),
      sq₁.lift_fst _ _ _, sq₁.lift_snd _ _ _⟩
  have sqL : IsPullback (Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA))) gP a₀ (Spec.map (CommRingCat.ofHom θ)) := by
    refine IsPullback.of_bot ?_ hgP1.symm sq₁
    rw [hgP2]
    exact IsPullback.of_hasPullback _ _
  haveI ha₀ : WeaklyEtale a₀ := wc_shdata_weaklyEtale x₀ B₀ Λ₀ W₀ φ₀ a₀ hsh
  haveI hgPw : WeaklyEtale gP := MorphismProperty.of_isPullback (P := @WeaklyEtale) sqL ha₀

  haveI : IsNoetherian (Spec (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)))) :=
    inferInstance
  obtain ⟨X₁, r₁, hb₁, hX₁⟩ := wc_csd_blowup_exists_noeth
    (Spec (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) (c.map ιA))))
    (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range fun k =>
      (Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)))).inv.hom
        (wcQmbtGen A' n π' (c.map ιA) k))))
  haveI := hX₁
  haveI hfst : WeaklyEtale (Limits.pullback.fst r₁ gP) :=
    MorphismProperty.of_isPullback (P := @WeaklyEtale) (IsPullback.of_hasPullback r₁ gP).flip hgPw

  haveI hgPflat : Flat gP := hgPw.flat
  haveI hPaff : IsAffine (Limits.pullback (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA))) := by
    dsimp only [wcQuadModelStr]
    infer_instance
  have hbl := wc_qmbt_bm_flat_base_change
    (R := CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)))
    (wcQmbtGen A' n π' (c.map ιA)) r₁ gP hb₁

  have hc' : IsUnit (c.map ιA + (c.map ιA).transpose).det := by
    have h1 : c.map ιA + (c.map ιA).transpose = (c + c.transpose).map ιA := by
      ext i j
      simp [Matrix.map_apply, Matrix.transpose_apply]
    rw [h1, ← RingHom.mapMatrix_apply, ← RingHom.map_det]
    exact hc.map ιA
  choose φs hφs using fun j => wc_qmbt_bm_chart_algebra hπ' (c.map ιA) j
  obtain ⟨φ0, hφ0⟩ := wc_qmbt_bm_chart_algebra_none hπ' (c.map ιA)
  let Φ : ∀ k, CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)) ⟶
      wcQmbtCharts A' n π' (c.map ιA) k := fun k =>
    Option.rec (motive := fun k => CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)) ⟶
      wcQmbtCharts A' n π' (c.map ιA) k) (CommRingCat.ofHom φ0)
      (fun j => CommRingCat.ofHom (φs j)) k
  obtain ⟨e, he_open, he_comp, he_cover⟩ := wc_qmbt_bm_blowup_charts
    (R := CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)))
    (wcQmbtGen A' n π' (c.map ιA)) r₁ hb₁ (wcQmbtCharts A' n π' (c.map ιA)) Φ
    (fun k => by cases k with
      | none => exact hφ0.2.2.1
      | some j => exact (hφs j).2.2.1)
    (fun k => by cases k with
      | none => exact hφ0.2.2.2.1
      | some j => exact (hφs j).2.2.2.1)
    (fun k => by cases k with
      | none => exact hφ0.2.2.2.2
      | some j => exact (hφs j).2.2.2.2)

  have jac : ∀ (c' : Matrix (Fin n) (Fin n) A'), IsUnit (c' + c'.transpose).det →
      ∀ (j : Fin n) (𝔭 : PrimeSpectrum (wcQmbtChart A' n π' c' j)),
      Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j) (MvPolynomial.X none) ∈ 𝔭.asIdeal →
      ∃ i, i ≠ j ∧ Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j)
        (∑ q, MvPolynomial.C (c' i q + c' q i) * wcQmbtChartHat (A' := A') j q) ∉ 𝔭.asIdeal := by
    intro c' hc'₀ j 𝔭 hs
    by_contra H
    push_neg at H
    let κ := 𝔭.asIdeal.ResidueField
    let φ : wcQmbtChart A' n π' c' j →+* κ := algebraMap _ κ
    let ι : A' →+* κ :=
      φ.comp ((Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j)).comp MvPolynomial.C)
    let û : Fin n → κ := fun p =>
      φ (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j) (wcQmbtChartHat (A' := A') j p))
    let sb : κ := φ (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j) (MvPolynomial.X none))
    have hdet : ((c'.map ι) + (c'.map ι).transpose).det ≠ 0 := by
      have h1 : c'.map ι + (c'.map ι).transpose = (c' + c'.transpose).map ι := by
        ext a b
        simp [Matrix.map_apply, Matrix.transpose_apply]
      rw [h1, ← RingHom.mapMatrix_apply, ← RingHom.map_det]
      exact (hc'₀.map ι).ne_zero
    have hG : Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j)
        (∑ p, ∑ q, MvPolynomial.C (c' p q) * wcQmbtChartHat (A' := A') j p *
          wcQmbtChartHat (A' := A') j q - MvPolynomial.X none ^ 2) = 0 := by
      rw [Ideal.Quotient.eq_zero_iff_mem]
      exact Ideal.subset_span (Set.mem_insert_of_mem _ rfl)
    have hquad : ∑ p, ∑ q, (c'.map ι) p q * û p * û q = sb ^ 2 := by
      have := congrArg φ hG
      simp only [map_sub, map_sum, map_mul, map_pow, map_zero] at this
      exact sub_eq_zero.mp this
    have hmv : ∀ i, (Matrix.mulVec (c'.map ι + (c'.map ι).transpose) û) i =
        φ (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j)
          (∑ q, MvPolynomial.C (c' i q + c' q i) * wcQmbtChartHat (A' := A') j q)) := by
      intro i
      simp only [Matrix.mulVec, dotProduct, map_sum, map_mul, map_add, Matrix.add_apply,
        Matrix.transpose_apply, Matrix.map_apply, ι, û, RingHom.comp_apply]
    have hûj : û j = 1 := by
      simp [û, wcQmbtChartHat]
    have hsb : sb = 0 := Ideal.algebraMap_residueField_eq_zero.mpr hs
    have h2s : (2 : κ) * sb ^ 2 = 0 := by
      rw [hsb]
      ring
    have hzero_off : ∀ i, i ≠ j → (Matrix.mulVec (c'.map ι + (c'.map ι).transpose) û) i = 0 := by
      intro i hij
      rw [hmv i]
      exact Ideal.algebraMap_residueField_eq_zero.mpr (H i hij)
    have hsum1 : ∑ i, û i * (Matrix.mulVec (c'.map ι + (c'.map ι).transpose) û) i =
        (Matrix.mulVec (c'.map ι + (c'.map ι).transpose) û) j := by
      rw [Finset.sum_eq_single j]
      · rw [hûj, one_mul]
      · intro b _ hb
        rw [hzero_off b hb, mul_zero]
      · intro h
        exact absurd (Finset.mem_univ j) h
    have e3 : ∑ i, ∑ q, (c'.map ι) q i * û i * û q = ∑ p, ∑ q, (c'.map ι) p q * û p * û q := by
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl fun y _ => Finset.sum_congr rfl fun x _ => ?_
      ring
    have hsum2 : ∑ i, û i * (Matrix.mulVec (c'.map ι + (c'.map ι).transpose) û) i =
        2 * sb ^ 2 := by
      have e1 : ∑ i, û i * (Matrix.mulVec (c'.map ι + (c'.map ι).transpose) û) i =
          ∑ i, ∑ q, (c'.map ι) i q * û i * û q + ∑ i, ∑ q, (c'.map ι) q i * û i * û q := by
        rw [← Finset.sum_add_distrib]
        refine Finset.sum_congr rfl fun i _ => ?_
        simp only [Matrix.mulVec, dotProduct, Matrix.add_apply, Matrix.transpose_apply,
          Finset.mul_sum]
        rw [← Finset.sum_add_distrib]
        refine Finset.sum_congr rfl fun q _ => ?_
        ring
      rw [e1, e3, hquad]
      ring
    have hNu : Matrix.mulVec (c'.map ι + (c'.map ι).transpose) û = 0 := by
      funext i
      by_cases hij : i = j
      · rw [hij, ← hsum1, hsum2, h2s]
        rfl
      · exact hzero_off i hij
    have hû0 : û ≠ 0 := by
      intro h
      have := congrFun h j
      rw [hûj] at this
      exact one_ne_zero this
    exact hdet (Matrix.exists_mulVec_eq_zero_iff.mp ⟨û, hû0, hNu⟩)

  have adapted : ∀ (j : Fin n) (𝔭 : PrimeSpectrum (wcQmbtChart A' n π' (c.map ιA) j)),
      Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' (c.map ιA) j) (MvPolynomial.X none) ∈
        𝔭.asIdeal →
      ∃ (h : wcQmbtChart A' n π' (c.map ιA) j)
        (ψ : wcQmbtSSRing A' (n - 2) π' →+* Localization.Away h),
        h ∉ 𝔭.asIdeal ∧
        ψ.comp (algebraMap A' (wcQmbtSSRing A' (n - 2) π')) =
          algebraMap A' (Localization.Away h) ∧
        ψ.Etale ∧
        ψ (Ideal.Quotient.mk (wcQuadModelIdeal A' (n - 2 + 2) π'
            (Matrix.of fun a b : Fin (n - 2 + 2) => if a.val = 0 ∧ b.val = 1 then (1 : A') else 0))
            (MvPolynomial.X (⟨1, by omega⟩ : Fin (n - 2 + 2)))) =
          algebraMap (wcQmbtChart A' n π' (c.map ιA) j) (Localization.Away h)
            (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' (c.map ιA) j)
              (MvPolynomial.X (some j))) := by
    intro j 𝔭 hs
    obtain ⟨i, hij, hi⟩ := jac (c.map ιA) hc' j 𝔭 hs
    have hcompl : Nonempty (Fin (n - 2) ≃ {p : Fin n // p ≠ i ∧ p ≠ j}) := by
      refine ⟨Fintype.equivOfCardEq ?_⟩
      rw [Fintype.card_fin, Fintype.card_subtype]
      have e : (Finset.univ.filter fun p : Fin n => p ≠ i ∧ p ≠ j) = Finset.univ \ {i, j} := by
        ext p
        simp
      rw [e, Finset.card_univ_diff, Finset.card_pair hij, Fintype.card_fin]
    obtain ⟨τ⟩ := hcompl
    obtain ⟨ψ, hA, hE, -, h1⟩ := wc_qmbt_cc_case_a (π' := π') (c' := c.map ιA) hij τ
    exact ⟨_, ψ, hi, hA, hE, h1⟩

  have key : ∀ (C : Type u) [CommRing C] [Algebra A' C] (e₀ : Spec (CommRingCat.of C) ⟶ X₁)
      [IsOpenImmersion e₀] (φ : wcQuadModelRing A' n (π' ^ 2) (c.map ιA) →+* C),
      e₀ ≫ r₁ = Spec.map (CommRingCat.ofHom φ) →
      φ.comp (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA))) = algebraMap A' C →
      ∀ (y : Spec (CommRingCat.of C)) (h : C)
        (ψ : wcQmbtSSRing A' (n - 2) π' →+* Localization.Away h),
      h ∉ PrimeSpectrum.asIdeal y →
      ψ.comp (algebraMap A' (wcQmbtSSRing A' (n - 2) π')) = algebraMap A' (Localization.Away h) →
      ψ.Etale →
      ∃ (W : X₁.Opens) (gW : (W : Scheme.{u}) ⟶ Spec (CommRingCat.of (wcQmbtSSRing A' (n - 2) π'))),
        e₀ y ∈ W ∧ WeaklyEtale gW ∧
        gW ≫ Spec.map (CommRingCat.ofHom (algebraMap A' (wcQmbtSSRing A' (n - 2) π'))) =
          W.ι ≫ r₁ ≫ Spec.map (CommRingCat.ofHom
            (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)))) ∧
        ∀ w : W, ∃ q : Spec (CommRingCat.of (Localization.Away h)),
          (w : X₁) = e₀ (Spec.map (CommRingCat.ofHom (algebraMap C (Localization.Away h))) q) ∧
          gW w = Spec.map (CommRingCat.ofHom ψ) q := by
    intro C _ _ e₀ _ φ he hφ y h ψ hy hψ hψe
    let lh : Spec (CommRingCat.of (Localization.Away h)) ⟶ Spec (CommRingCat.of C) :=
      Spec.map (CommRingCat.ofHom (algebraMap C (Localization.Away h)))
    obtain ⟨q0, hq⟩ : y ∈ Set.range (PrimeSpectrum.comap (algebraMap C (Localization.Away h))) := by
      rw [PrimeSpectrum.localization_away_comap_range (Localization.Away h) h]
      exact (PrimeSpectrum.mem_basicOpen h y).mpr hy
    let q : Spec (CommRingCat.of (Localization.Away h)) := q0
    have hlq : lh q = y := hq
    have hWι : (lh ≫ e₀).isoOpensRange.inv ≫ (lh ≫ e₀) = (lh ≫ e₀).opensRange.ι := by
      rw [Iso.inv_comp_eq, Scheme.Hom.isoOpensRange_hom_ι]
    haveI : Etale (Spec.map (CommRingCat.ofHom ψ)) :=
      (HasRingHomProperty.Spec_iff (P := @Etale)).mpr hψe
    refine ⟨(lh ≫ e₀).opensRange, (lh ≫ e₀).isoOpensRange.inv ≫ Spec.map (CommRingCat.ofHom ψ),
      ?_, inferInstance, ?_, ?_⟩
    · exact Scheme.Hom.mem_opensRange.mpr
        ⟨q, (Scheme.Hom.comp_apply lh e₀ q).trans (congrArg e₀ hlq)⟩
    · have halg : algebraMap A' (Localization.Away h) =
          (algebraMap C (Localization.Away h)).comp
            (φ.comp (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)))) := by
        rw [hφ]
        exact IsScalarTower.algebraMap_eq _ _ _
      calc ((lh ≫ e₀).isoOpensRange.inv ≫ Spec.map (CommRingCat.ofHom ψ)) ≫
            Spec.map (CommRingCat.ofHom (algebraMap A' (wcQmbtSSRing A' (n - 2) π')))
          = (lh ≫ e₀).isoOpensRange.inv ≫ Spec.map (CommRingCat.ofHom
              (ψ.comp (algebraMap A' (wcQmbtSSRing A' (n - 2) π')))) := by
            rw [Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp]
        _ = (lh ≫ e₀).isoOpensRange.inv ≫ lh ≫ Spec.map (CommRingCat.ofHom φ) ≫
              Spec.map (CommRingCat.ofHom
                (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)))) := by
            rw [hψ, halg]
            simp only [CommRingCat.ofHom_comp, Spec.map_comp, Category.assoc, lh]
        _ = ((lh ≫ e₀).isoOpensRange.inv ≫ (lh ≫ e₀)) ≫ r₁ ≫
              Spec.map (CommRingCat.ofHom
                (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)))) := by
            rw [← he]
            simp only [Category.assoc]
        _ = _ := by rw [hWι]
    · intro w
      refine ⟨(lh ≫ e₀).isoOpensRange.inv w, ?_, Scheme.Hom.comp_apply _ _ _⟩
      have h1 : ((lh ≫ e₀).isoOpensRange.inv ≫ (lh ≫ e₀)) w = (lh ≫ e₀).opensRange.ι w := by
        rw [hWι]
      simp only [Scheme.Hom.comp_apply, Scheme.Opens.ι_apply] at h1
      exact h1.symm

  have nbhd : ∀ (C : Type u) [CommRing C] (e₀ : Spec (CommRingCat.of C) ⟶ X₁)
      [IsOpenImmersion e₀] (s : C) (y : Spec (CommRingCat.of C)), s ∉ PrimeSpectrum.asIdeal y →
      ∃ N : X₁.Opens, e₀ y ∈ N ∧ ∀ x : X₁, x ∈ N →
        ∃ 𝔭' : Spec (CommRingCat.of C), e₀ 𝔭' = x ∧ s ∉ PrimeSpectrum.asIdeal 𝔭' := by
    intro C _ e₀ _ s y hy
    let lh : Spec (CommRingCat.of (Localization.Away s)) ⟶ Spec (CommRingCat.of C) :=
      Spec.map (CommRingCat.ofHom (algebraMap C (Localization.Away s)))
    obtain ⟨q0, hq⟩ : y ∈ Set.range (PrimeSpectrum.comap (algebraMap C (Localization.Away s))) := by
      rw [PrimeSpectrum.localization_away_comap_range (Localization.Away s) s]
      exact (PrimeSpectrum.mem_basicOpen s y).mpr hy
    let q : Spec (CommRingCat.of (Localization.Away s)) := q0
    have hlq : lh q = y := hq
    refine ⟨(lh ≫ e₀).opensRange, Scheme.Hom.mem_opensRange.mpr
        ⟨q, (Scheme.Hom.comp_apply lh e₀ q).trans (congrArg e₀ hlq)⟩, ?_⟩
    intro x hx
    obtain ⟨q', hq'⟩ := Scheme.Hom.mem_opensRange.mp hx
    refine ⟨lh q', (Scheme.Hom.comp_apply lh e₀ q').symm.trans hq', ?_⟩
    have hmem : lh q' ∈ Set.range (PrimeSpectrum.comap (algebraMap C (Localization.Away s))) :=
      ⟨q', rfl⟩
    rw [PrimeSpectrum.localization_away_comap_range (Localization.Away s) s] at hmem
    exact (PrimeSpectrum.mem_basicOpen s _).mp hmem

  have CP : ∀ (C : Type u) [CommRing C] [Algebra A' C]
      (φ : wcQuadModelRing A' n (π' ^ 2) (c.map ιA) →+* C),
      φ.comp (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA))) = algebraMap A' C →
      ∀ 𝔭' : Spec (CommRingCat.of C),
      Spec.map (CommRingCat.ofHom (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA))))
        (Spec.map (CommRingCat.ofHom φ) 𝔭') = IsLocalRing.closedPoint A' →
      algebraMap A' C π' ∈ PrimeSpectrum.asIdeal 𝔭' := by
    intro C _ _ φ hφ 𝔭' hcl
    have h1 := congrArg PrimeSpectrum.asIdeal hcl
    change Ideal.comap (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)))
        (Ideal.comap φ (PrimeSpectrum.asIdeal 𝔭')) = IsLocalRing.maximalIdeal A' at h1
    rw [Ideal.comap_comap, hφ] at h1
    have hm : π' ∈ IsLocalRing.maximalIdeal A' := by
      rw [hπ']
      exact Ideal.mem_span_singleton_self π'
    rw [← h1] at hm
    exact Ideal.mem_comap.mp hm

  have s_off : ∀ (j : Fin n) (𝔭 : PrimeSpectrum (wcQmbtChart A' n π' (c.map ιA) j)),
      Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' (c.map ιA) j) (MvPolynomial.X none) ∉
        𝔭.asIdeal →
      algebraMap A' (wcQmbtChart A' n π' (c.map ιA) j) π' ∈ 𝔭.asIdeal →
      Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' (c.map ιA) j) (MvPolynomial.X (some j)) ∈
        𝔭.asIdeal := by
    intro j 𝔭 hs hπ𝔭
    have hrel : MvPolynomial.X (some j) * MvPolynomial.X none - MvPolynomial.C π' ∈
        wcQmbtChartIdeal A' n π' (c.map ιA) j :=
      Ideal.subset_span (Set.mem_insert _ _)
    have h0 := (Ideal.Quotient.eq_zero_iff_mem).mpr hrel
    rw [map_sub, map_mul, sub_eq_zero] at h0
    have hC : Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' (c.map ιA) j) (MvPolynomial.C π') =
        algebraMap A' (wcQmbtChart A' n π' (c.map ιA) j) π' := by
      rw [← MvPolynomial.algebraMap_eq]
      exact Ideal.Quotient.mk_algebraMap A' (wcQmbtChartIdeal A' n π' (c.map ιA) j) π'
    rw [hC] at h0
    have hprod : Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' (c.map ιA) j)
        (MvPolynomial.X (some j)) *
        Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' (c.map ιA) j) (MvPolynomial.X none) ∈
        𝔭.asIdeal := by
      rw [h0]
      exact hπ𝔭
    rcases 𝔭.isPrime.mem_or_mem hprod with h | h
    · exact h
    · exact absurd h hs

  have local_chart : ∀ x₁ : X₁,
      (∃ (W : X₁.Opens)
        (gW : (W : Scheme.{u}) ⟶ Spec (CommRingCat.of (wcQmbtSSRing A' (n - 2) π'))),
        x₁ ∈ W ∧ WeaklyEtale gW ∧
        gW ≫ Spec.map (CommRingCat.ofHom (algebraMap A' (wcQmbtSSRing A' (n - 2) π'))) =
          W.ι ≫ r₁ ≫ Spec.map (CommRingCat.ofHom
            (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)))) ∧
        ∀ w : W,
          (Ideal.Quotient.mk (wcQuadModelIdeal A' (n - 2 + 2) π'
              (Matrix.of fun a b : Fin (n - 2 + 2) => if a.val = 0 ∧ b.val = 1 then (1 : A') else 0))
              (MvPolynomial.X (⟨1, by omega⟩ : Fin (n - 2 + 2))) ∈ PrimeSpectrum.asIdeal (gW w) ↔
            ∀ p : Fin n, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
              PrimeSpectrum.asIdeal (Spec.map (CommRingCat.ofHom θ) (r₁ (W.ι w))))) ∨
      (∃ N₁ : X₁.Opens, x₁ ∈ N₁ ∧ ∀ x₁' : X₁, x₁' ∈ N₁ →
          Spec.map (CommRingCat.ofHom (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA))))
            (r₁ x₁') = IsLocalRing.closedPoint A' →
          ∀ p : Fin n, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
            PrimeSpectrum.asIdeal (Spec.map (CommRingCat.ofHom θ) (r₁ x₁'))) := by
    intro x₁
    obtain ⟨k, y, hy⟩ := he_cover x₁
    subst hy
    cases k with
    | none =>
      haveI := he_open none
      refine Or.inr ⟨(e none).opensRange, Scheme.Hom.mem_opensRange.mpr ⟨y, rfl⟩, ?_⟩
      intro x₁' hx₁' hcl p
      obtain ⟨𝔭', rfl⟩ := Scheme.Hom.mem_opensRange.mp hx₁'
      have hr' : r₁ (e none 𝔭') = Spec.map (CommRingCat.ofHom φ0) 𝔭' := by
        rw [← Scheme.Hom.comp_apply, he_comp none]
        rfl
      rw [hr'] at hcl ⊢
      have hπ𝔭 := CP (wcQmbtChartNone A' n (c.map ιA)) φ0 hφ0.2.1 𝔭' hcl
      show φ0 (θ (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p))) ∈
        PrimeSpectrum.asIdeal 𝔭'
      have hC : Ideal.Quotient.mk (wcQmbtChartNoneIdeal A' n (c.map ιA)) (MvPolynomial.C π') =
          algebraMap A' (wcQmbtChartNone A' n (c.map ιA)) π' := by
        rw [← MvPolynomial.algebraMap_eq]
        exact Ideal.Quotient.mk_algebraMap A' (wcQmbtChartNoneIdeal A' n (c.map ιA)) π'
      rw [hθX p, hφ0.1 p, map_mul, hC, mul_comm]
      exact Ideal.mul_mem_left _ _ hπ𝔭
    | some j =>
      haveI := he_open (some j)
      by_cases hs : Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' (c.map ιA) j)
          (MvPolynomial.X none) ∈ PrimeSpectrum.asIdeal y
      · refine Or.inl ?_
        obtain ⟨h, ψ, hh, hψA, hψE, hψ1⟩ := adapted j y hs
        obtain ⟨W, gW, h1, h2, h3, hall⟩ :=
          @key (wcQmbtChart A' n π' (c.map ιA) j) _ _ (e (some j)) (he_open (some j)) (φs j)
            (he_comp (some j)) (hφs j).2.1 y h ψ hh hψA hψE
        refine ⟨W, gW, h1, h2, h3, fun w => ?_⟩
        obtain ⟨q, hwq, hgq⟩ := hall w
        obtain ⟨y', hy'⟩ : ∃ y' : ↥(Spec (wcQmbtCharts A' n π' (c.map ιA) (some j))),
            y' = Spec.map (CommRingCat.ofHom (algebraMap (wcQmbtChart A' n π' (c.map ιA) j)
              (Localization.Away h))) q := ⟨_, rfl⟩
        have he' : e (some j) y' = W.ι w := by
          subst hy'
          exact ((Scheme.Opens.ι_apply W w).trans hwq).symm
        have hr' : r₁ (W.ι w) = Spec.map (CommRingCat.ofHom (φs j)) y' := by
          rw [← he', ← Scheme.Hom.comp_apply, he_comp (some j)]
          rfl
        have e0 : (Ideal.Quotient.mk (wcQuadModelIdeal A' (n - 2 + 2) π'
              (Matrix.of fun a b : Fin (n - 2 + 2) => if a.val = 0 ∧ b.val = 1 then (1 : A') else 0))
              (MvPolynomial.X (⟨1, by omega⟩ : Fin (n - 2 + 2))) ∈
              PrimeSpectrum.asIdeal (Spec.map (CommRingCat.ofHom ψ) q)) ↔
            Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' (c.map ιA) j) (MvPolynomial.X (some j)) ∈
              Ideal.comap (algebraMap (wcQmbtChart A' n π' (c.map ιA) j) (Localization.Away h))
                (PrimeSpectrum.asIdeal q) := by
          rw [Ideal.mem_comap, ← hψ1]
          exact Iff.rfl
        have e1 : ∀ p : Fin n, (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
            PrimeSpectrum.asIdeal (Spec.map (CommRingCat.ofHom θ) (r₁ (W.ι w)))) ↔
            Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' (c.map ιA) j)
              (MvPolynomial.X (some j) * wcQmbtChartHat j p) ∈
              Ideal.comap (algebraMap (wcQmbtChart A' n π' (c.map ιA) j) (Localization.Away h))
                (PrimeSpectrum.asIdeal q) := by
          intro p
          rw [hr']
          subst hy'
          rw [← (hφs j).1 p, ← hθX p]
          exact Iff.rfl
        rw [hgq]
        refine e0.trans (Iff.trans ?_ (forall_congr' fun p => (e1 p).symm))
        constructor
        · intro hx p
          rw [map_mul, mul_comm]
          exact Ideal.mul_mem_left _ _ hx
        · intro hallp
          have := hallp j
          rwa [show wcQmbtChartHat (A' := A') j j = 1 from if_pos rfl, mul_one] at this
      · refine Or.inr ?_
        obtain ⟨N₁, hxN₁, hN₁⟩ := @nbhd (wcQmbtChart A' n π' (c.map ιA) j) _ (e (some j))
          (he_open (some j)) _ y hs
        refine ⟨N₁, hxN₁, ?_⟩
        intro x₁' hx₁' hcl p
        obtain ⟨𝔭', h𝔭', hs'⟩ := hN₁ x₁' hx₁'
        let y' : ↥(Spec (wcQmbtCharts A' n π' (c.map ιA) (some j))) := 𝔭'
        have he' : e (some j) y' = x₁' := h𝔭'
        have hr' : r₁ x₁' = Spec.map (CommRingCat.ofHom (φs j)) y' := by
          rw [← he', ← Scheme.Hom.comp_apply, he_comp (some j)]
          rfl
        rw [hr'] at hcl ⊢
        have hπ𝔭 := CP (wcQmbtChart A' n π' (c.map ιA) j) (φs j) (hφs j).2.1 𝔭' hcl
        have hx' := s_off j 𝔭' hs' hπ𝔭
        show φs j (θ (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p))) ∈
          PrimeSpectrum.asIdeal 𝔭'
        rw [hθX p, (hφs j).1 p, map_mul, mul_comm]
        exact Ideal.mul_mem_left _ _ hx'

  have transfer : ∀ (W : X₁.Opens)
      (gW : (W : Scheme.{u}) ⟶ Spec (CommRingCat.of (wcQmbtSSRing A' (n - 2) π'))),
      WeaklyEtale gW →
      gW ≫ Spec.map (CommRingCat.ofHom (algebraMap A' (wcQmbtSSRing A' (n - 2) π'))) =
        W.ι ≫ r₁ ≫ Spec.map (CommRingCat.ofHom
          (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)))) →
      WeaklyEtale ((Limits.pullback.fst r₁ gP ∣_ W) ≫ gW) ∧
      ((Limits.pullback.fst r₁ gP ∣_ W) ≫ gW) ≫
          Spec.map (CommRingCat.ofHom (algebraMap A' (wcQmbtSSRing A' (n - 2) π'))) =
        (Limits.pullback.fst r₁ gP ⁻¹ᵁ W).ι ≫ (Limits.pullback.snd r₁ gP ≫
          Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))) := by
    intro W gW hgW hcomm
    refine ⟨inferInstance, ?_⟩
    rw [Category.assoc, hcomm, morphismRestrict_ι_assoc, Limits.pullback.condition_assoc, hgP2]
  have hpt : ∀ (W : X₁.Opens) (xU : ↥(Limits.pullback.fst r₁ gP ⁻¹ᵁ W).toScheme),
      W.ι ((Limits.pullback.fst r₁ gP ∣_ W) xU) =
        Limits.pullback.fst r₁ gP ((Limits.pullback.fst r₁ gP ⁻¹ᵁ W).ι xU) := by
    intro W xU
    have e1 := congrArg (fun φ => φ xU) (morphismRestrict_ι (Limits.pullback.fst r₁ gP) W)
    exact (Scheme.Hom.comp_apply _ _ _).symm.trans (e1.trans (Scheme.Hom.comp_apply _ _ _))

  have I1 : ∀ x : ↥(Limits.pullback r₁ gP : Scheme.{u}),
      a₀ ((Limits.pullback.snd r₁ gP ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
        (Spec.map (CommRingCat.ofHom ιA))) x) =
      Spec.map (CommRingCat.ofHom θ) (r₁ (Limits.pullback.fst r₁ gP x)) := by
    intro x
    have h : Limits.pullback.snd r₁ gP ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
