theorem wc_qmbt_dlyt_thom_agree {Y' Z : Scheme.{u}} (iY' : Y' ⟶ Z) [IsClosedImmersion iY']
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (L : Type u) [Field L] (qZ : Z ⟶ Spec (.of L))
    (κΛ : ∀ (T : Scheme.{u}), (T ⟶ Spec (.of L)) → (Γ(T, ⊤))ˣ → wcIntExt T ℓ 1)
    (δ : wcQdDelta.{u} ℓ 1 2) (hXK : wcQdDeltaXK δ) (hN : wcQdDeltaN δ)
    (hP : wcQdKumP L ℓ κΛ)
    (hM : ∀ (T : Scheme.{u}) (qT : T ⟶ Spec (.of L)) (a b : (Γ(T, ⊤))ˣ),
      κΛ T qT (a * b) = κΛ T qT a + κΛ T qT b)
    (hBO : wcQdBO iY' ℓ)
    (Ua Ub : Z.Opens) (xa : Γ(Z, Ua)) (xb : Γ(Z, Ub))
    (hza : ∀ z ∈ Ua, (z ∈ Set.range iY' ↔ z ∉ Z.basicOpen xa))
    (hzb : ∀ z ∈ Ub, (z ∈ Set.range iY' ↔ z ∉ Z.basicOpen xb))
    (hunit : ∀ (W : Z.Opens) (hWa : W ≤ Ua) (hWb : W ≤ Ub), IsAffineOpen W →
      ∃ v : (Γ(Z, W))ˣ, (Z.presheaf.map (homOfLE hWa).op).hom xa =
        (v : Γ(Z, W)) * (Z.presheaf.map (homOfLE hWb).op).hom xb)
    (Ea : wcHMPullData (Limits.pullback.fst Ua.ι iY') ℓ) (hEa : wcHMPullCanonical Ea)
    (hepia : Epi (wcSuppUnitMap Ea))
    (sa : Γ(Ua.toScheme, ⊤))
    (hsa : sa = (Ua.ι.appLE Ua ⊤ (Scheme.Opens.ι_preimage_self Ua).ge).hom xa)
    (Dwa : wcHMPullData (Ua.toScheme.basicOpen sa).ι ℓ) (hDwa : wcHMPullCanonical Dwa)
    (ERa : wcIntRatData (Ua.toScheme.basicOpen sa).toScheme ℓ)
    (hERa : ERa.adj.homEquiv _ _ ERa.μ.hom =
      wcUnitRestrict (wcIntRatRingSheafMap (Ua.toScheme.basicOpen sa).toScheme ℓ))
    (ua : (Γ((Ua.toScheme.basicOpen sa).toScheme, ⊤))ˣ)
    (hua : (ua : Γ((Ua.toScheme.basicOpen sa).toScheme, ⊤)) =
      (Ua.toScheme.basicOpen sa).ι.appTop.hom sa)
    (Eb : wcHMPullData (Limits.pullback.fst Ub.ι iY') ℓ) (hEb : wcHMPullCanonical Eb)
    (hepib : Epi (wcSuppUnitMap Eb))
    (sb : Γ(Ub.toScheme, ⊤))
    (hsb : sb = (Ub.ι.appLE Ub ⊤ (Scheme.Opens.ι_preimage_self Ub).ge).hom xb)
    (Dwb : wcHMPullData (Ub.toScheme.basicOpen sb).ι ℓ) (hDwb : wcHMPullCanonical Dwb)
    (ERb : wcIntRatData (Ub.toScheme.basicOpen sb).toScheme ℓ)
    (hERb : ERb.adj.homEquiv _ _ ERb.μ.hom =
      wcUnitRestrict (wcIntRatRingSheafMap (Ub.toScheme.basicOpen sb).toScheme ℓ))
    (ub : (Γ((Ub.toScheme.basicOpen sb).toScheme, ⊤))ˣ)
    (hub : (ub : Γ((Ub.toScheme.basicOpen sb).toScheme, ⊤)) =
      (Ub.toScheme.basicOpen sb).ι.appTop.hom sb) :
    ∀ (W : Z.Opens) (hWa : W ≤ Ua) (hWb : W ≤ Ub), IsAffineOpen W →
      ∀ (DW : wcHMPullData (Limits.pullback.fst W.ι iY') ℓ), wcHMPullCanonical DW →
        Epi (wcSuppUnitMap DW) →
      ∀ (Da : wcHMPullData (Z.homOfLE hWa) ℓ), wcHMPullCanonical Da →
      ∀ (Db : wcHMPullData (Z.homOfLE hWb) ℓ), wcHMPullCanonical Db →
      ∀ (γa : wcSuppObj DW ⟶ Da.Φ.obj (wcSuppObj Ea))
        (γb : wcSuppObj DW ⟶ Db.Φ.obj (wcSuppObj Eb)),
        wcSuppUnitMap DW ≫ γa = Da.μ.inv ≫ Da.Φ.map (wcSuppUnitMap Ea) →
        wcSuppUnitMap DW ≫ γb = Db.μ.inv ≫ Db.Φ.map (wcSuppUnitMap Eb) →
        letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf W.toScheme ℓ)) := HasExt.standard _
        (Abelian.Ext.mk₀ γa).comp (wcSuppPullExt Ea Da 2
          (δ (Limits.pullback.fst Ua.ι iY') Ea (Ua.toScheme.basicOpen sa) Dwa
            (wcIntRho ERa 1 (κΛ (Ua.toScheme.basicOpen sa).toScheme
              ((Ua.toScheme.basicOpen sa).ι ≫ Ua.ι ≫ qZ) ua)))) (zero_add _) =
          (Abelian.Ext.mk₀ γb).comp (wcSuppPullExt Eb Db 2
          (δ (Limits.pullback.fst Ub.ι iY') Eb (Ub.toScheme.basicOpen sb) Dwb
            (wcIntRho ERb 1 (κΛ (Ub.toScheme.basicOpen sb).toScheme
              ((Ub.toScheme.basicOpen sb).ι ≫ Ub.ι ≫ qZ) ub)))) (zero_add _) :=
by
  classical

  have s1 : ∀ {X Y Z' : Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ Z') (h : X ⟶ Z'), f ≫ g = h →
      ∀ (U : Z'.Opens) (e₁ : ⊤ ≤ g ⁻¹ᵁ U) (e₂ : ⊤ ≤ h ⁻¹ᵁ U) (x : Γ(Z', U)),
      f.appTop.hom ((g.appLE U ⊤ e₁).hom x) = (h.appLE U ⊤ e₂).hom x := by
    intro X Y Z' f g h hfg U e₁ e₂ x
    subst hfg
    have h1 := Scheme.Hom.appLE_comp_appLE f g U ⊤ ⊤ e₁ (by simp)
    have h4 := congrArg (fun φ => φ.hom x) h1
    simp only [CommRingCat.comp_apply] at h4
    rw [← h4]
    congr 1
    simp [Scheme.Hom.appLE, Scheme.Hom.appTop]
    rfl

  have kill : ∀ {T V : Scheme.{u}} (j : T ⟶ V) (Dj : wcHMPullData j ℓ) (Wo : V.Opens)
      (Dw : wcHMPullData Wo.ι ℓ), wcQdPre j Dj Wo Dw → ∀ (qV : V ⟶ Spec (.of L))
      (E : wcIntRatData Wo.toScheme ℓ),
      E.adj.homEquiv _ _ E.μ.hom = wcUnitRestrict (wcIntRatRingSheafMap Wo.toScheme ℓ) →
      ∀ (v : (Γ(V, ⊤))ˣ) (a b : (Γ(Wo.toScheme, ⊤))ˣ),
      (a : Γ(Wo.toScheme, ⊤)) = Wo.ι.appTop.hom (v : Γ(V, ⊤)) * (b : Γ(Wo.toScheme, ⊤)) →
      δ j Dj Wo Dw (wcIntRho E 1 (κΛ Wo.toScheme (Wo.ι ≫ qV) a)) =
        δ j Dj Wo Dw (wcIntRho E 1 (κΛ Wo.toScheme (Wo.ι ≫ qV) b)) := by
    intro T V j Dj Wo Dw hPre qV E hE v a b hab
    have ha : a = Units.map Wo.ι.appTop.hom.toMonoidHom v * b := by
      apply Units.ext
      rw [Units.val_mul, Units.coe_map, hab]
      try rfl
    obtain ⟨ER, hER⟩ := wc_int_rat_data_exists V ℓ
    have hp := hP V Wo.toScheme qV (Wo.ι ≫ qV) Wo.ι rfl Dw hPre.2.2.2.2.2 ER hER E hE v
    rw [ha, hM, map_add, map_add, ← hp, (hXK j Dj Wo Dw hPre).2, zero_add]

  have side : ∀ (Uc : Z.Opens) (xc : Γ(Z, Uc)),
      (∀ z ∈ Uc, (z ∈ Set.range iY' ↔ z ∉ Z.basicOpen xc)) →
      ∀ (Ec : wcHMPullData (Limits.pullback.fst Uc.ι iY') ℓ), wcHMPullCanonical Ec →
      Epi (wcSuppUnitMap Ec) →
      ∀ (sc : Γ(Uc.toScheme, ⊤)),
      sc = (Uc.ι.appLE Uc ⊤ (Scheme.Opens.ι_preimage_self Uc).ge).hom xc →
      ∀ (Dwc : wcHMPullData (Uc.toScheme.basicOpen sc).ι ℓ), wcHMPullCanonical Dwc →
      ∀ (ERc : wcIntRatData (Uc.toScheme.basicOpen sc).toScheme ℓ),
      ERc.adj.homEquiv _ _ ERc.μ.hom =
        wcUnitRestrict (wcIntRatRingSheafMap (Uc.toScheme.basicOpen sc).toScheme ℓ) →
      ∀ (uc : (Γ((Uc.toScheme.basicOpen sc).toScheme, ⊤))ˣ),
      (uc : Γ((Uc.toScheme.basicOpen sc).toScheme, ⊤)) =
        (Uc.toScheme.basicOpen sc).ι.appTop.hom sc →
      ∀ (W : Z.Opens) (hWc : W ≤ Uc) (hle : ⊤ ≤ W.ι ⁻¹ᵁ Uc)
        (DW : wcHMPullData (Limits.pullback.fst W.ι iY') ℓ) (WoW : W.toScheme.Opens)
        (DwW : wcHMPullData WoW.ι ℓ),
      wcQdPre (Limits.pullback.fst W.ι iY') DW WoW DwW →
      ∀ (ERW : wcIntRatData WoW.toScheme ℓ),
      ERW.adj.homEquiv _ _ ERW.μ.hom = wcUnitRestrict (wcIntRatRingSheafMap WoW.toScheme ℓ) →
      ∀ (u' : (Γ(WoW.toScheme, ⊤))ˣ),
      (u' : Γ(WoW.toScheme, ⊤)) = WoW.ι.appTop.hom ((W.ι.appLE Uc ⊤ hle).hom xc) →
      ∀ (Dc : wcHMPullData (Z.homOfLE hWc) ℓ), wcHMPullCanonical Dc →
      ∀ (γc : wcSuppObj DW ⟶ Dc.Φ.obj (wcSuppObj Ec)),
      wcSuppUnitMap DW ≫ γc = Dc.μ.inv ≫ Dc.Φ.map (wcSuppUnitMap Ec) →
      letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf W.toScheme ℓ)) := HasExt.standard _
      (Abelian.Ext.mk₀ γc).comp (wcSuppPullExt Ec Dc 2
          (δ (Limits.pullback.fst Uc.ι iY') Ec (Uc.toScheme.basicOpen sc) Dwc
            (wcIntRho ERc 1 (κΛ (Uc.toScheme.basicOpen sc).toScheme
              ((Uc.toScheme.basicOpen sc).ι ≫ Uc.ι ≫ qZ) uc)))) (zero_add _) =
        δ (Limits.pullback.fst W.ι iY') DW WoW DwW
          (wcIntRho ERW 1 (κΛ WoW.toScheme (WoW.ι ≫ W.ι ≫ qZ) u')) := by
    intro Uc xc hzc Ec hEc hepic sc hsc Dwc hDwc ERc hERc uc huc W hWc hle DW WoW DwW hPreW
      ERW hERW u' hu' Dc hDc γc hγc
    obtain ⟨hcar, -, hker⟩ := hBO Uc xc hzc (Limits.pullback Uc.ι iY') Uc.toScheme Uc.ι
      (Scheme.Opens.ι_preimage_self Uc).ge (Limits.pullback.fst Uc.ι iY') inferInstance
      (Scheme.Pullback.range_fst Uc.ι iY') sc hsc
    have hPrec : wcQdPre (Limits.pullback.fst Uc.ι iY') Ec (Uc.toScheme.basicOpen sc) Dwc :=
      ⟨inferInstance, hEc, hepic, hker Ec hEc, hcar, hDwc⟩
    have hO : WoW ≤ (Z.homOfLE hWc) ⁻¹ᵁ (Uc.toScheme.basicOpen sc) := by
      intro w hw
      have h1 : w ∈ ((WoW : W.toScheme.Opens) : Set W.toScheme) := hw
      rw [hPreW.2.2.2.2.1, Scheme.Pullback.range_fst] at h1
      rw [Scheme.Hom.mem_preimage, ← SetLike.mem_coe, hcar, Scheme.Pullback.range_fst]
      intro h2
      have e : Uc.ι ((Z.homOfLE hWc) w) = W.ι w := by
        rw [← Scheme.Hom.comp_apply, Scheme.homOfLE_ι]
      exact h1 (show W.ι w ∈ Set.range iY' by rw [← e]; exact h2)
    obtain ⟨fO, hfO⟩ : ∃ fO : WoW.toScheme ⟶ (Uc.toScheme.basicOpen sc).toScheme,
        fO ≫ (Uc.toScheme.basicOpen sc).ι = WoW.ι ≫ Z.homOfLE hWc :=
      ⟨_, Scheme.Hom.resLE_comp_ι _ hO⟩
    obtain ⟨DfO, hDfO⟩ := wc_hm_pull_data_exists fO ℓ
    have hNc := hN (Limits.pullback.fst Uc.ι iY') Ec (Uc.toScheme.basicOpen sc) Dwc hPrec
      (Limits.pullback.fst W.ι iY') DW WoW DwW hPreW (Z.homOfLE hWc) fO hfO Dc hDc γc hγc
      DfO hDfO (wcIntRho ERc 1 (κΛ (Uc.toScheme.basicOpen sc).toScheme
        ((Uc.toScheme.basicOpen sc).ι ≫ Uc.ι ≫ qZ) uc))
    have hf : fO ≫ (Uc.toScheme.basicOpen sc).ι ≫ Uc.ι ≫ qZ = WoW.ι ≫ W.ι ≫ qZ := by
      rw [← Category.assoc, hfO, Category.assoc, Scheme.homOfLE_ι_assoc]
    have hPc := hP (Uc.toScheme.basicOpen sc).toScheme WoW.toScheme
      ((Uc.toScheme.basicOpen sc).ι ≫ Uc.ι ≫ qZ) (WoW.ι ≫ W.ι ≫ qZ) fO hf DfO hDfO
      ERc hERc ERW hERW uc
    have hres : fO.appTop.hom ((Uc.toScheme.basicOpen sc).ι.appTop.hom sc) =
        WoW.ι.appTop.hom ((Z.homOfLE hWc).appTop.hom sc) := by
      rw [← CommRingCat.comp_apply, ← Scheme.Hom.comp_appTop, hfO, Scheme.Hom.comp_appTop,
        CommRingCat.comp_apply]
    have hu : Units.map fO.appTop.hom.toMonoidHom uc = u' := by
      apply Units.ext
      rw [Units.coe_map, hu']
      show fO.appTop.hom (uc : Γ((Uc.toScheme.basicOpen sc).toScheme, ⊤)) = _
      rw [huc, hres, hsc, s1 (Z.homOfLE hWc) Uc.ι W.ι (Scheme.homOfLE_ι Z hWc) Uc _ hle xc]
    refine Eq.trans hNc.symm ?_
    rw [hPc, hu]

  intro W hWa hWb hWaff DW hDW hepiW Da hDa Db hDb γa γb hγa hγb
  have hlW : ⊤ ≤ W.ι ⁻¹ᵁ W := (Scheme.Opens.ι_preimage_self W).ge
  have hla : ⊤ ≤ W.ι ⁻¹ᵁ Ua := hlW.trans (W.ι.preimage_mono hWa)
  have hlb : ⊤ ≤ W.ι ⁻¹ᵁ Ub := hlW.trans (W.ι.preimage_mono hWb)
  obtain ⟨hcarW, hunitW, hkerW⟩ := hBO Ua xa hza (Limits.pullback W.ι iY') W.toScheme W.ι hla
    (Limits.pullback.fst W.ι iY') inferInstance (Scheme.Pullback.range_fst W.ι iY')
    ((W.ι.appLE Ua ⊤ hla).hom xa) rfl
  obtain ⟨DwW, hDwW⟩ :=
    wc_hm_pull_data_exists (W.toScheme.basicOpen ((W.ι.appLE Ua ⊤ hla).hom xa)).ι ℓ
  obtain ⟨ERW, hERW⟩ :=
    wc_int_rat_data_exists (W.toScheme.basicOpen ((W.ι.appLE Ua ⊤ hla).hom xa)).toScheme ℓ
  have hPreW : wcQdPre (Limits.pullback.fst W.ι iY') DW
      (W.toScheme.basicOpen ((W.ι.appLE Ua ⊤ hla).hom xa)) DwW :=
    ⟨inferInstance, hDW, hepiW, hkerW DW hDW, hcarW, hDwW⟩
  obtain ⟨v, hv⟩ := hunit W hWa hWb hWaff
  have ea : (W.ι.appLE W ⊤ hlW).hom ((Z.presheaf.map (homOfLE hWa).op).hom xa) =
      (W.ι.appLE Ua ⊤ hla).hom xa := by
    rw [← CommRingCat.comp_apply, Scheme.Hom.map_appLE]
  have eb : (W.ι.appLE W ⊤ hlW).hom ((Z.presheaf.map (homOfLE hWb).op).hom xb) =
      (W.ι.appLE Ub ⊤ hlb).hom xb := by
    rw [← CommRingCat.comp_apply, Scheme.Hom.map_appLE]
  have hrel : (W.ι.appLE Ua ⊤ hla).hom xa =
      (W.ι.appLE W ⊤ hlW).hom (v : Γ(Z, W)) * (W.ι.appLE Ub ⊤ hlb).hom xb := by
    rw [← ea, ← eb, hv, map_mul]
  let vW : (Γ(W.toScheme, ⊤))ˣ := Units.map (W.ι.appLE W ⊤ hlW).hom.toMonoidHom v
  have hvW : (vW : Γ(W.toScheme, ⊤)) = (W.ι.appLE W ⊤ hlW).hom (v : Γ(Z, W)) := rfl
  have hrelO : (W.toScheme.basicOpen ((W.ι.appLE Ua ⊤ hla).hom xa)).ι.appTop.hom
        ((W.ι.appLE Ua ⊤ hla).hom xa) =
      (W.toScheme.basicOpen ((W.ι.appLE Ua ⊤ hla).hom xa)).ι.appTop.hom (vW : Γ(W.toScheme, ⊤)) *
        (W.toScheme.basicOpen ((W.ι.appLE Ua ⊤ hla).hom xa)).ι.appTop.hom
          ((W.ι.appLE Ub ⊤ hlb).hom xb) := by
    have h := congrArg (W.toScheme.basicOpen ((W.ι.appLE Ua ⊤ hla).hom xa)).ι.appTop.hom hrel
    rw [map_mul] at h
    rw [hvW]
    exact h
  have hxy : IsUnit
      ((W.toScheme.basicOpen ((W.ι.appLE Ua ⊤ hla).hom xa)).ι.appTop.hom (vW : Γ(W.toScheme, ⊤)) *
        (W.toScheme.basicOpen ((W.ι.appLE Ua ⊤ hla).hom xa)).ι.appTop.hom
          ((W.ι.appLE Ub ⊤ hlb).hom xb)) := by
    rw [← hrelO]; exact hunitW
  have hubW := isUnit_of_mul_isUnit_right hxy
  have hA := side Ua xa hza Ea hEa hepia sa hsa Dwa hDwa ERa hERa ua hua W hWa hla DW
    (W.toScheme.basicOpen ((W.ι.appLE Ua ⊤ hla).hom xa)) DwW hPreW ERW hERW hunitW.unit
    hunitW.unit_spec Da hDa γa hγa
  have hB := side Ub xb hzb Eb hEb hepib sb hsb Dwb hDwb ERb hERb ub hub W hWb hlb DW
    (W.toScheme.basicOpen ((W.ι.appLE Ua ⊤ hla).hom xa)) DwW hPreW ERW hERW hubW.unit
    hubW.unit_spec Db hDb γb hγb
  refine Eq.trans hA (Eq.trans ?_ (Eq.symm hB))
  exact kill (Limits.pullback.fst W.ι iY') DW _ DwW hPreW (W.ι ≫ qZ) ERW hERW vW
    hunitW.unit hubW.unit (by rw [hunitW.unit_spec, hubW.unit_spec]; exact hrelO)

theorem wc_qmbt_dlyt_kummer_thom_cover {Y' Z : Scheme.{u}} (iY' : Y' ⟶ Z) [IsClosedImmersion iY']
    [IsLocallyNoetherian Z] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (L : Type u) [Field L] [IsSepClosed L] (hℓL : ((ℓ : ℕ) : L) ≠ 0) (qZ : Z ⟶ Spec (.of L))
    (κt : ∀ (T : Scheme.{u}), (T ⟶ Spec (.of L)) → ∀ k : ℕ, (Γ(T, ⊤))ˣ → wcZModProEtExt T (ℓ ^ k) 1)
    (κΛ : ∀ (T : Scheme.{u}), (T ⟶ Spec (.of L)) → (Γ(T, ⊤))ˣ → wcIntExt T ℓ 1)
    (hK : wcYrcKummerPkg L ℓ κt κΛ)
    (N : ℕ) (U : Fin N → Z.Opens) (x : ∀ a, Γ(Z, U a))
    (hU : ∀ a, IsAffineOpen (U a))
    (hcov : Set.range iY' ⊆ ⋃ a, (U a : Set Z))
    (hzero : ∀ a, ∀ z ∈ U a, (z ∈ Set.range iY' ↔ z ∉ Z.basicOpen (x a)))
    (hunit : ∀ (a b : Fin N) (W : Z.Opens) (hWa : W ≤ U a) (hWb : W ≤ U b), IsAffineOpen W →
      ∃ v : (Γ(Z, W))ˣ, (Z.presheaf.map (homOfLE hWa).op).hom (x a) =
        (v : Γ(Z, W)) * (Z.presheaf.map (homOfLE hWb).op).hom (x b))
    (hne : ∀ (a : Fin N) (R' : CommRingCat.{u}) [HenselianLocalRing R']
      [IsSepClosed (IsLocalRing.ResidueField R')] (k' : Spec R' ⟶ Z), WeaklyEtale k' →
      ∀ (hle : ⊤ ≤ k' ⁻¹ᵁ U a), k' (IsLocalRing.closedPoint R') ∈ Set.range iY' →
      ∀ (O' : (Spec R').Opens), O' = (Spec R').basicOpen ((k'.appLE (U a) ⊤ hle).hom (x a)) →
      ∀ (u : (Γ(O'.toScheme, ⊤))ˣ),
        (u : Γ(O'.toScheme, ⊤)) = O'.ι.appTop.hom ((k'.appLE (U a) ⊤ hle).hom (x a)) →
      ∀ (E : wcIntRatData O'.toScheme ℓ),
        E.adj.homEquiv _ _ E.μ.hom = wcUnitRestrict (wcIntRatRingSheafMap O'.toScheme ℓ) →
        wcIntRho E 1 (κΛ O'.toScheme (O'.ι ≫ k' ≫ qZ) u) ≠ 0) :
    wcQmbtDlytLocCover iY' ℓ :=
by
  classical
  obtain ⟨δ, hXK, hN⟩ := wc_qmbt_dlyt_canon_bdry ℓ 1 2 rfl
    (fun j hj Dj hker Wo hW Dw hDw =>
      @wc_qmbt_dlyt_open_kernel_transfer _ _ ℓ _ j hj Dj hker Wo hW Dw hDw)
  have hP : wcQdKumP L ℓ κΛ := wc_qmbt_dlyt_kummer_rho_pull L ℓ κt κΛ hK
  have hM : ∀ (T : Scheme.{u}) (qT : T ⟶ Spec (.of L)) (a b : (Γ(T, ⊤))ˣ),
      κΛ T qT (a * b) = κΛ T qT a + κΛ T qT b := wc_qmbt_dlyt_kummer_int_mul L ℓ κt κΛ hK
  have hV : ∀ (R' : CommRingCat.{u}) [HenselianLocalRing R']
      [IsSepClosed (IsLocalRing.ResidueField R')] (y : wcHM (Spec R') ℓ 1), y = 0 :=
    fun R' _ _ y => wc_qmbt_dlyt_strict_hm_vanish ℓ R' 0 y
  have hBO : wcQdBO iY' ℓ := wc_qmbt_dlyt_basicOpen_data iY' ℓ
  choose E hE using fun a => wc_hm_pull_data_exists (Limits.pullback.fst (U a).ι iY') ℓ
  have hepi : ∀ a, Epi (wcSuppUnitMap (E a)) := fun a =>
    wc_supp_unit_epi_of_noetherian _ ℓ (E a) (hE a)
  let s : ∀ a, Γ((U a).toScheme, ⊤) := fun a =>
    ((U a).ι.appLE (U a) ⊤ (Scheme.Opens.ι_preimage_self (U a)).ge).hom (x a)
  choose Dw hDw using fun a => wc_hm_pull_data_exists ((U a).toScheme.basicOpen (s a)).ι ℓ
  choose ER hER using fun a =>
    wc_int_rat_data_exists ((U a).toScheme.basicOpen (s a)).toScheme ℓ
  have hunitU : ∀ a, IsUnit (((U a).toScheme.basicOpen (s a)).ι.appTop.hom (s a)) := fun a =>
    (hBO (U a) (x a) (hzero a) _ _ (U a).ι (Scheme.Opens.ι_preimage_self (U a)).ge
      (Limits.pullback.fst (U a).ι iY') inferInstance
      (Scheme.Pullback.range_fst _ _) (s a) rfl).2.1
  let u : ∀ a, (Γ(((U a).toScheme.basicOpen (s a)).toScheme, ⊤))ˣ := fun a => (hunitU a).unit
  refine ⟨N, U, hU, hcov, E, fun a => δ (Limits.pullback.fst (U a).ι iY') (E a)
    ((U a).toScheme.basicOpen (s a)) (Dw a) (wcIntRho (ER a) 1 (κΛ _
      (((U a).toScheme.basicOpen (s a)).ι ≫ (U a).ι ≫ qZ) (u a))), hE, ?_, ?_⟩
  · intro a
    exact wc_qmbt_dlyt_thom_strict_nz iY' ℓ L qZ κΛ δ hXK hN hP hV hBO (U a) (x a) (hzero a)
      (hne a) (E a) (hE a) (hepi a) (s a) rfl (Dw a) (hDw a) (ER a) (hER a) (u a)
      (IsUnit.unit_spec _)
  · intro a b
    exact wc_qmbt_dlyt_thom_agree iY' ℓ L qZ κΛ δ hXK hN hP hM hBO (U a) (U b) (x a) (x b)
      (hzero a) (hzero b) (hunit a b) (E a) (hE a) (hepi a) (s a) rfl (Dw a) (hDw a) (ER a)
      (hER a) (u a) (IsUnit.unit_spec _) (E b) (hE b) (hepi b) (s b) rfl (Dw b) (hDw b) (ER b)
      (hER b) (u b) (IsUnit.unit_spec _)

theorem wc_qmbt_dlyt_strict_kummer_ne_zero (L : Type u) [Field L] [IsSepClosed L] (ℓ : ℕ)
    [Fact (Nat.Prime ℓ)] (hℓL : ((ℓ : ℕ) : L) ≠ 0)
    (κt : ∀ (T : Scheme.{u}), (T ⟶ Spec (.of L)) → ∀ k : ℕ, (Γ(T, ⊤))ˣ → wcZModProEtExt T (ℓ ^ k) 1)
    (κΛ : ∀ (T : Scheme.{u}), (T ⟶ Spec (.of L)) → (Γ(T, ⊤))ˣ → wcIntExt T ℓ 1)
    (hK : wcYrcKummerPkg L ℓ κt κΛ)
    (R' : CommRingCat.{u}) [HenselianLocalRing R'] [IsSepClosed (IsLocalRing.ResidueField R')]
    (q : Spec R' ⟶ Spec (.of L)) (t : Γ(Spec R', ⊤))
    (hN : IsNoetherianRing (R' ⧸ nilradical R')) (hD : IsDomain (R' ⧸ nilradical R'))
    (ht0 : Ideal.Quotient.mk (nilradical R') ((Scheme.ΓSpecIso R').hom.hom t) ≠ 0)
    (htp : (Ideal.span {Ideal.Quotient.mk (nilradical R')
      ((Scheme.ΓSpecIso R').hom.hom t)}).IsPrime)
    (O' : (Spec R').Opens) (hO' : O' = (Spec R').basicOpen t)
    (u : (Γ(O'.toScheme, ⊤))ˣ) (hu : (u : Γ(O'.toScheme, ⊤)) = O'.ι.appTop.hom t)
    (E : wcIntRatData O'.toScheme ℓ)
    (hE : E.adj.homEquiv _ _ E.μ.hom = wcUnitRestrict (wcIntRatRingSheafMap O'.toScheme ℓ)) :
    wcIntRho E 1 (κΛ O'.toScheme (O'.ι ≫ q) u) ≠ 0 :=
by
  classical

  have s1 : ∀ {A B : Type u} [CommRing A] [CommRing B] (φ : A →+* B) (r : A),
      IsDomain (A ⧸ nilradical A) → Ideal.Quotient.mk (nilradical A) r ≠ 0 → IsUnit (φ r) →
      (∀ b : B, ∃ (n : ℕ) (a : A), b * φ r ^ n = φ a) →
      (∀ a : A, φ a = 0 → ∃ n : ℕ, r ^ n * a = 0) →
      Nontrivial B ∧ ∀ e : B, e * e = e → e = 0 ∨ e = 1 := by
    intro A B _ _ φ r hD hr hunit hsurj hker
    have hnil : ∀ x : A, Ideal.Quotient.mk (nilradical A) x = 0 →
        ∃ j : ℕ, 1 ≤ j ∧ x ^ j = 0 := by
      intro x hx
      rw [Ideal.Quotient.eq_zero_iff_mem] at hx
      obtain ⟨j, hj⟩ := hx
      refine ⟨j + 1, by omega, ?_⟩
      rw [pow_succ, hj, zero_mul]
    constructor
    · refine nontrivial_of_ne (1 : B) 0 ?_
      intro h1
      obtain ⟨n, hn⟩ := hker 1 (by rw [map_one]; exact h1)
      apply hr
      rw [Ideal.Quotient.eq_zero_iff_mem, mem_nilradical]
      exact ⟨n, by rw [← hn, mul_one]⟩
    · intro e he
      obtain ⟨n, a, hna⟩ := hsurj e
      have hk : φ (a * a - a * r ^ n) = 0 := by
        rw [map_sub, map_mul, map_mul, map_pow, ← hna]
        have : e * φ r ^ n * (e * φ r ^ n) = (e * e) * (φ r ^ n * φ r ^ n) := by ring
        rw [this, he]; ring
      obtain ⟨m, hm⟩ := hker _ hk
      set pr := Ideal.Quotient.mk (nilradical A) with hpr
      have hm' : pr r ^ m * (pr a * (pr a - pr r ^ n)) = 0 := by
        have := congrArg pr hm
        rw [map_zero, map_mul, map_pow, map_sub, map_mul, map_mul, map_pow] at this
        rw [← this]; ring
      have hrm : pr r ^ m ≠ 0 := pow_ne_zero _ hr
      have h2 := (mul_eq_zero.mp hm').resolve_left hrm
      have hepow : ∀ j : ℕ, 1 ≤ j → e ^ j = e := by
        intro j hj
        induction j with
        | zero => omega
        | succ j ih =>
          rcases Nat.eq_zero_or_pos j with h | h
          · subst h; simp
          · rw [pow_succ, ih h, he]
      rcases mul_eq_zero.mp h2 with h | h
      · left
        obtain ⟨j, hj1, hj⟩ := hnil a h
        have : φ (a ^ j) = 0 := by rw [hj, map_zero]
        rw [map_pow, ← hna, mul_pow, hepow j hj1, ← pow_mul] at this
        exact (IsUnit.mul_left_eq_zero (hunit.pow _)).mp this
      · right
        have h' : pr (a - r ^ n) = 0 := by rw [map_sub, map_pow]; exact h
        obtain ⟨j, hj1, hj⟩ := hnil _ h'
        set f := 1 - e with hf
        have hff : f * f = f := by rw [hf]; ring_nf; rw [sq, he]; ring
        have hfpow : ∀ j : ℕ, 1 ≤ j → f ^ j = f := by
          intro j hj
          induction j with
          | zero => omega
          | succ j ih =>
            rcases Nat.eq_zero_or_pos j with h | h
            · subst h; simp
            · rw [pow_succ, ih h, hff]
        have : φ ((a - r ^ n) ^ j) = 0 := by rw [hj, map_zero]
        rw [map_pow, map_sub, ← hna, map_pow] at this
        have e2 : e * φ r ^ n - φ r ^ n = (-1) * f * φ r ^ n := by rw [hf]; ring
        rw [e2, mul_pow, mul_pow, hfpow j hj1, ← pow_mul] at this
        have h3 : (-1 : B) ^ j * f = 0 :=
          (IsUnit.mul_left_eq_zero (hunit.pow _)).mp this
        have h4 : f = 0 := by
          have hu1 : IsUnit ((-1 : B) ^ j) := (isUnit_one.neg).pow _
          exact (IsUnit.mul_right_eq_zero hu1).mp h3
        rw [hf, sub_eq_zero] at h4
        exact h4.symm

  have s2 : ∀ {A B : Type u} [CommRing A] [CommRing B] (φ : A →+* B) (r : A),
      IsNoetherianRing (A ⧸ nilradical A) → IsDomain (A ⧸ nilradical A) →
      Ideal.Quotient.mk (nilradical A) r ≠ 0 →
      (Ideal.span {Ideal.Quotient.mk (nilradical A) r}).IsPrime →
      (∀ b : B, ∃ (n : ℕ) (a : A), b * φ r ^ n = φ a) →
      (∀ a : A, φ a = 0 → ∃ n : ℕ, r ^ n * a = 0) → ∀ ℓ : ℕ, 2 ≤ ℓ →
      ¬ ∃ b : B, b ^ ℓ = φ r := by
    intro A B _ _ φ r hN hD hr hp hsurj hker ℓ hℓ
    rintro ⟨b, hb⟩
    obtain ⟨n, a, hna⟩ := hsurj b
    have hk : φ (a ^ ℓ - r ^ (n * ℓ + 1)) = 0 := by
      rw [map_sub, map_pow, map_pow, ← hna, mul_pow, hb, ← pow_mul, pow_succ]; ring
    obtain ⟨m, hm⟩ := hker _ hk
    set pr := Ideal.Quotient.mk (nilradical A) with hpr
    set s := pr r with hs
    set N := n * ℓ + 1 with hNdef
    have hm' : s ^ m * (pr a ^ ℓ - s ^ N) = 0 := by
      have := congrArg pr hm
      rw [map_zero, map_mul, map_pow, map_sub, map_pow, map_pow] at this
      exact this
    have haN : pr a ^ ℓ = s ^ N :=
      sub_eq_zero.mp ((mul_eq_zero.mp hm').resolve_left (pow_ne_zero _ hr))
    have ha0 : pr a ≠ 0 := by
      intro h
      rw [h, zero_pow (by omega)] at haN
      exact pow_ne_zero _ hr haN.symm
    set P := Ideal.span {s} with hP
    have hPtop : P ≠ ⊤ := hp.ne_top
    have hKrull : ⨅ i : ℕ, P ^ i = ⊥ := Ideal.iInf_pow_eq_bot_of_isDomain P hPtop
    have hex : ∃ i : ℕ, ¬ s ^ i ∣ pr a := by
      by_contra hcon
      push_neg at hcon
      apply ha0
      have : pr a ∈ ⨅ i : ℕ, P ^ i := by
        rw [Ideal.mem_iInf]
        intro i
        rw [hP, Ideal.span_singleton_pow, Ideal.mem_span_singleton]
        exact hcon i
      rw [hKrull] at this
      exact (Ideal.mem_bot).mp this
    set i₀ := Nat.find hex with hi₀
    have hi₀spec : ¬ s ^ i₀ ∣ pr a := Nat.find_spec hex
    have hi₀pos : 1 ≤ i₀ := by
      by_contra h
      push_neg at h
      have : i₀ = 0 := by omega
      rw [this, pow_zero] at hi₀spec
      exact hi₀spec (one_dvd _)
    set j := i₀ - 1 with hj
    have hjdvd : s ^ j ∣ pr a := by
      have := Nat.find_min hex (show j < i₀ by omega)
      push_neg at this
      exact this
    obtain ⟨c, hc⟩ := hjdvd
    have hcP : ¬ s ∣ c := by
      rintro ⟨d, hd⟩
      apply hi₀spec
      refine ⟨d, ?_⟩
      rw [hc, hd, show i₀ = j + 1 by omega, pow_succ]; ring
    have heq : s ^ (j * ℓ) * c ^ ℓ = s ^ N := by
      rw [← haN, hc, mul_pow, ← pow_mul]
    rcases lt_trichotomy (j * ℓ) N with hlt | heq' | hgt
    · apply hcP
      have h1 : s ^ (j * ℓ) * c ^ ℓ = s ^ (j * ℓ) * s ^ (N - j * ℓ) := by
        rw [heq, ← pow_add]; congr 1; omega
      have h2 : c ^ ℓ = s ^ (N - j * ℓ) := mul_left_cancel₀ (pow_ne_zero _ hr) h1
      have h3 : c ^ ℓ ∈ P := by
        rw [h2, hP, Ideal.mem_span_singleton]
        exact dvd_pow_self s (by omega)
      have h4 := hp.mem_of_pow_mem ℓ h3
      rwa [hP, Ideal.mem_span_singleton] at h4
    · exfalso
      rcases le_or_gt j n with hjn | hjn
      · have : j * ℓ ≤ n * ℓ := Nat.mul_le_mul_right ℓ hjn
        omega
      · have : (n + 1) * ℓ ≤ j * ℓ := Nat.mul_le_mul_right ℓ hjn
        have : (n + 1) * ℓ = n * ℓ + ℓ := by ring
        omega
    · apply hPtop
      rw [hP, Ideal.span_singleton_eq_top]
      have h1 : s ^ N * (s ^ (j * ℓ - N) * c ^ ℓ) = s ^ N * 1 := by
        rw [mul_one, ← mul_assoc, ← pow_add, show N + (j * ℓ - N) = j * ℓ by omega]
        exact heq
      have h2 : s ^ (j * ℓ - N) * c ^ ℓ = 1 := mul_left_cancel₀ (pow_ne_zero _ hr) h1
      have h3 : s * (s ^ (j * ℓ - N - 1) * c ^ ℓ) = 1 := by
        rw [← h2, ← mul_assoc, ← pow_succ', show j * ℓ - N - 1 + 1 = j * ℓ - N by omega]
      exact ⟨⟨s, _, h3, by rw [mul_comm]; exact h3⟩, rfl⟩

  subst hO'
  obtain ⟨e, he⟩ : ∃ e : (Γ(Spec R', ⊤) : Type u) ≃+* (R' : Type u),
      ∀ x, e x = (Scheme.ΓSpecIso R').hom.hom x :=
    ⟨(Scheme.ΓSpecIso R').commRingCatIsoToRingEquiv, fun _ => rfl⟩
  rw [← he t] at ht0 htp
  haveI hloc : IsLocalization.Away t Γ(((Spec R').basicOpen t).toScheme, ⊤) :=
    Γ_restrict_isLocalization (Spec R') t
  obtain ⟨φ, hφ⟩ : ∃ φ : (R' : Type u) →+* Γ(((Spec R').basicOpen t).toScheme, ⊤),
      ∀ a', φ (e a') = algebraMap Γ(Spec R', ⊤) Γ(((Spec R').basicOpen t).toScheme, ⊤) a' :=
    ⟨(algebraMap Γ(Spec R', ⊤) Γ(((Spec R').basicOpen t).toScheme, ⊤)).comp e.symm.toRingHom,
      fun a' => by simp⟩
  have hunit : IsUnit (φ (e t)) := by
    rw [hφ]; exact IsLocalization.Away.algebraMap_isUnit t
  have hsurj : ∀ b : Γ(((Spec R').basicOpen t).toScheme, ⊤),
      ∃ (n : ℕ) (a : (R' : Type u)), b * φ (e t) ^ n = φ a := by
    intro b
    obtain ⟨n, a', h⟩ := IsLocalization.Away.surj t b
    exact ⟨n, e a', by rw [hφ, hφ]; exact h⟩
  have hker : ∀ a : (R' : Type u), φ a = 0 → ∃ n : ℕ, e t ^ n * a = 0 := by
    intro a ha
    rw [← e.apply_symm_apply a, hφ] at ha
    have ha' : algebraMap Γ(Spec R', ⊤) Γ(((Spec R').basicOpen t).toScheme, ⊤) (e.symm a) =
        algebraMap Γ(Spec R', ⊤) Γ(((Spec R').basicOpen t).toScheme, ⊤) 0 := by
      rw [map_zero]; exact ha
    obtain ⟨c, hc⟩ := (IsLocalization.eq_iff_exists (Submonoid.powers t) _).mp ha'
    obtain ⟨n, hn⟩ := (Submonoid.mem_powers_iff _ _).mp c.2
    refine ⟨n, ?_⟩
    have := congrArg e hc
    rw [mul_zero, map_zero, map_mul, ← hn, map_pow, e.apply_symm_apply] at this
    exact this
  obtain ⟨hnt, hidem⟩ := s1 φ (e t) hD ht0 hunit hsurj hker
  have hnp := s2 φ (e t) hN hD ht0 htp hsurj hker ℓ (Fact.out : ℓ.Prime).two_le
  have hφu : φ (e t) = (u : Γ(((Spec R').basicOpen t).toScheme, ⊤)) := by
    rw [hφ, hu]; rfl
  have hu' : ¬ ∃ b : (Γ(((Spec R').basicOpen t).toScheme, ⊤))ˣ, b ^ ℓ = u := by
    rintro ⟨b, hb⟩
    exact hnp ⟨b, by rw [hφu, ← hb, Units.val_pow_eq_pow_val]⟩

  have hord : ∀ k : ℕ, 1 ≤ k →
      addOrderOf (κt _ (((Spec R').basicOpen t).ι ≫ q) k u) = ℓ ^ k := by
    intro k hk
    have hpow : ∀ m : ℕ, κt _ (((Spec R').basicOpen t).ι ≫ q) k (u ^ m) =
        m • κt _ (((Spec R').basicOpen t).ι ≫ q) k u := by
      intro m
      induction m with
      | zero =>
        rw [pow_zero, zero_nsmul]
        have h1 := hK.1 _ (((Spec R').basicOpen t).ι ≫ q) k 1 1
        rw [mul_one] at h1
        exact left_eq_add.mp h1
      | succ m ih => rw [pow_succ, hK.1, ih, succ_nsmul]
    have h2 : ℓ ^ (k - 1 + 1) • κt _ (((Spec R').basicOpen t).ι ≫ q) k u = 0 := by
      rw [show k - 1 + 1 = k by omega, ← hpow]
      exact (hK.2.2.1 _ _ k _ hk).mpr ⟨u, rfl⟩
    have h1 : ¬ ℓ ^ (k - 1) • κt _ (((Spec R').basicOpen t).ι ≫ q) k u = 0 := by
      rw [← hpow]
      intro h0
      obtain ⟨b, hb⟩ := (hK.2.2.1 _ _ k _ hk).mp h0
      haveI := hnt
      exact wc_yrc_unit_not_lpow_iter L _
        ((((Spec R').basicOpen t).ι ≫ q).appTop.hom.comp
          (Scheme.ΓSpecIso (CommRingCat.of L)).inv.hom) ℓ hℓL hidem u hu' k hk ⟨b, hb⟩
    rw [addOrderOf_eq_prime_pow h1 h2, show k - 1 + 1 = k by omega]

  have hfin : ∀ k : ℕ, 1 ≤ k →
      letI : HasExt (SheafOfModules.{u+1}
        (wcZModRingSheaf ((Spec R').basicOpen t).toScheme (ℓ ^ k))) := HasExt.standard _
      Function.Injective (fun a : C(↥(Spec (CommRingCat.of L)), ULift.{u+1} (ZMod (ℓ ^ k))) =>
        (Abelian.Ext.mk₀ (wcZModFun ((Spec R').basicOpen t).toScheme (ℓ ^ k)
          (a.comp (((Spec R').basicOpen t).ι ≫ q).base.hom))).comp
          (wcIntRed ((Spec R').basicOpen t).toScheme ℓ k 1
            (κΛ _ (((Spec R').basicOpen t).ι ≫ q) u)) (zero_add 1)) := by
    intro k hk
    letI : HasExt (SheafOfModules.{u+1}
      (wcZModRingSheaf ((Spec R').basicOpen t).toScheme (ℓ ^ k))) := HasExt.standard _
    obtain ⟨hTr, ht⟩ := wc_int_red_transfer ((Spec R').basicOpen t).toScheme ℓ
    obtain ⟨act1, act2, -⟩ := wc_int_red_act ((Spec R').basicOpen t).toScheme ℓ hTr ht 1
    have himg : ∀ a : C(↥(Spec (CommRingCat.of L)), ULift.{u+1} (ZMod (ℓ ^ k))),
        (Abelian.Ext.mk₀ (wcZModFun ((Spec R').basicOpen t).toScheme (ℓ ^ k)
          (a.comp (((Spec R').basicOpen t).ι ≫ q).base.hom))).comp
          (wcIntRed ((Spec R').basicOpen t).toScheme ℓ k 1
            (κΛ _ (((Spec R').basicOpen t).ι ≫ q) u)) (zero_add 1) =
        (a default).down.val • κt _ (((Spec R').basicOpen t).ι ≫ q) k u := by
      intro a
      have hac : a.comp (((Spec R').basicOpen t).ι ≫ q).base.hom =
          ContinuousMap.const _ (a default) := by
        apply ContinuousMap.ext
        intro z
        show a ((((Spec R').basicOpen t).ι ≫ q).base.hom z) = a default
        rw [Subsingleton.elim ((((Spec R').basicOpen t).ι ≫ q).base.hom z) default]
      rw [hac, ← act2 k (ContinuousMap.const _ (ULift.up (((a default).down.val : ℕ) : ℤ_[ℓ])))
        (ContinuousMap.const _ (a default))
        (fun _ => by
          simp only [ContinuousMap.const_apply, map_natCast, ZMod.natCast_zmod_val]),
        act1, map_natCast, ZMod.natCast_zmod_val, hK.2.2.2 _ _ k _ hk]
    intro a₁ a₂ hEq
    have hEq' : (Abelian.Ext.mk₀ (wcZModFun ((Spec R').basicOpen t).toScheme (ℓ ^ k)
          (a₁.comp (((Spec R').basicOpen t).ι ≫ q).base.hom))).comp
          (wcIntRed ((Spec R').basicOpen t).toScheme ℓ k 1
            (κΛ _ (((Spec R').basicOpen t).ι ≫ q) u)) (zero_add 1) =
        (Abelian.Ext.mk₀ (wcZModFun ((Spec R').basicOpen t).toScheme (ℓ ^ k)
          (a₂.comp (((Spec R').basicOpen t).ι ≫ q).base.hom))).comp
          (wcIntRed ((Spec R').basicOpen t).toScheme ℓ k 1
            (κΛ _ (((Spec R').basicOpen t).ι ≫ q) u)) (zero_add 1) := hEq
    rw [himg, himg, nsmul_inj_mod, hord k hk, Nat.mod_eq_of_lt (ZMod.val_lt _),
      Nat.mod_eq_of_lt (ZMod.val_lt _)] at hEq'
    have hc := ZMod.val_injective _ hEq'
    apply ContinuousMap.ext
    intro z
    rw [Subsingleton.elim z default]
    exact ULift.ext _ _ hc

  have hinj := wc_yrc_ladic_h1_passage_inj ℓ (((Spec R').basicOpen t).ι ≫ q)
    (κΛ _ (((Spec R').basicOpen t).ι ≫ q) u) E hE hfin
  intro hρ
  have h01 := @hinj (ContinuousMap.const _ (ULift.up 1)) (ContinuousMap.const _ (ULift.up 0))
    (by
      letI : HasExt (SheafOfModules.{u+1}
        (wcRingSheaf ((Spec R').basicOpen t).toScheme ℓ)) := HasExt.standard _
      dsimp only
      rw [hρ]
      simp only [Abelian.Ext.comp_zero])
  have h10 := congrArg (fun f => (f (default : ↥(Spec (CommRingCat.of L)))).down) h01
  simp only [ContinuousMap.const_apply] at h10
  exact one_ne_zero h10

theorem wc_qmbt_dlyt_local_cover {A : Type u} [CommRing A] [IsDomain A]
    [IsDiscreteValuationRing A]
    [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (hℓ : IsUnit ((ℓ : ℕ) : A)) {n : ℕ} (hn : Even n) (hn4 : 4 ≤ n) {π : A}
    {c : Matrix (Fin n) (Fin n) A}
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π}) (hc : IsUnit (c + c.transpose).det)
    {x₀ : Spec (.of (wcQuadModelRing A n π c))}
    (hx₀ : ∀ p, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
      PrimeSpectrum.asIdeal x₀)
    {B₀ : Type u} [CommRing B₀] [HenselianLocalRing B₀] [IsSepClosed (IsLocalRing.ResidueField B₀)]
    {Λ₀ : Type u} [SmallCategory Λ₀] [IsCofiltered Λ₀]
    {W₀ : Λ₀ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (wcQuadModelRing A n π c))) x₀))
      (Scheme.Etale.forget (Spec (.of (wcQuadModelRing A n π c))))}
    {φ₀ : ∀ l, Spec (.of B₀) ⟶ (W₀.obj l).right.left}
    {a₀ : Spec (.of B₀) ⟶ Spec (.of (wcQuadModelRing A n π c))}
    (hsh : wcHalShData x₀ B₀ Λ₀ W₀ φ₀ a₀)
    {Xs : Scheme.{u}} {ι : Xs ⟶ Spec (.of B₀)} {s : Xs ⟶ Spec (.of (IsLocalRing.ResidueField A))}
    (hps : IsPullback ι s (a₀ ≫ wcQuadModelStr A n π c) (wcQmSp A))
    {A' : Type u} [CommRing A'] [IsDomain A'] [IsDiscreteValuationRing A'] [HenselianLocalRing A']
    [IsSepClosed (IsLocalRing.ResidueField A')] {ιA : A →+* A'} {π' : A'}
    (hℓ' : IsUnit ((ℓ : ℕ) : A')) (hπ' : IsLocalRing.maximalIdeal A' = Ideal.span {π'})
    (hπ'2 : π' ^ 2 = ιA π) (hgen : ∀ a' : A', ∃ x y : A, a' = ιA x + ιA y * π')
    {L' : Type u} [Field L'] [IsSepClosed L'] {φ' : A' →+* L'} (hφ' : Function.Injective φ')
    (halg' : letI := φ'.toAlgebra; Algebra.IsAlgebraic A' L')
    {Xm : Scheme.{u}} {f : Xm ⟶ Spec (.of A')}
    {bl : Xm ⟶ Limits.pullback (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))}
    (hbl : wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range
      (fun i : Option (Fin n) => Option.elim i
        ((Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of A')).inv.hom π'))
        (fun j => ((Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))) ≫ a₀).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A n π c))).inv.hom
            (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X j)))))))) bl)
    (hblf : bl ≫ Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA)) = f)
    {XE' : Scheme.{u}} {p' : XE' ⟶ Xm} {q' : XE' ⟶ Spec (.of L')}
    (hpb' : IsPullback p' q' f (Spec.map (CommRingCat.ofHom φ')))
    {Xs' : Scheme.{u}} {ι' : Xs' ⟶ Xm} {s' : Xs' ⟶ Spec (.of (IsLocalRing.ResidueField A'))}
    (hps' : IsPullback ι' s' f (wcQmSp A'))
    {βs : Xs' ⟶ Xs}
    (hβ : βs ≫ ι = ι' ≫ bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA)))
    (Dβ : wcHMPullData βs ℓ) (hDβ : wcHMPullCanonical Dβ)
    [EnoughInjectives (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))]
    (Dp' : wcHMPullData p' ℓ) (hDp' : wcHMPullCanonical Dp')
    (Di' : wcHMPullData ι' ℓ) (hDi' : wcHMPullCanonical Di')
    (I' : InjectiveResolution (SheafOfModules.unit (wcRingSheaf XE' ℓ)))
    {Z₁ Z₂ ZY : Scheme.{u}} (i₁ : Z₁ ⟶ Xs') (i₂ : Z₂ ⟶ Xs') (iY : ZY ⟶ Xs')
    [IsClosedImmersion i₁] [IsClosedImmersion i₂] [IsClosedImmersion iY]
    (h₁ : Set.range i₁ = closure ((fun z => (ι' ≫ bl ≫ Limits.pullback.fst
      (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))) z) ⁻¹'
        {IsLocalRing.closedPoint B₀})ᶜ)
    (h₂ : Set.range i₂ = (fun z => (ι' ≫ bl ≫ Limits.pullback.fst
      (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))) z) ⁻¹'
        {IsLocalRing.closedPoint B₀})
    (hY : Set.range iY = closure ((fun z => (ι' ≫ bl ≫ Limits.pullback.fst
      (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))) z) ⁻¹'
        {IsLocalRing.closedPoint B₀})ᶜ ∩ (fun z => (ι' ≫ bl ≫ Limits.pullback.fst
      (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))) z) ⁻¹'
        {IsLocalRing.closedPoint B₀})
    (E₁ : wcHMPullData i₁ ℓ) (hE₁ : wcHMPullCanonical E₁)
    (E₂ : wcHMPullData i₂ ℓ) (hE₂ : wcHMPullCanonical E₂)
    (EY : wcHMPullData iY ℓ) (hEY : wcHMPullCanonical EY)
    (ρ₁ : wcSuppObj E₁ ⟶ wcSuppObj EY) (ρ₂ : wcSuppObj E₂ ⟶ wcSuppObj EY)
    (hz : Limits.biprod.lift (wcSuppUnitMap E₁) (wcSuppUnitMap E₂) ≫
      Limits.biprod.desc ρ₁ (-ρ₂) = 0)
    (hS : (ShortComplex.mk _ _ hz).ShortExact)
    {Y' : Scheme.{u}} (iY' : Y' ⟶ Z₁) [IsClosedImmersion iY'] (gY : Y' ⟶ ZY)
    (hYsq : IsPullback gY iY' iY i₁) :
    wcQmbtDlytLocCover iY' ℓ :=
by
  haveI hloc : IsLocallyNoetherian Xs' := wc_qmbt_pn_xsp_locNoeth hℓ hn hn4 hπ hc hx₀ hsh hps
    hℓ' hπ' hπ'2 hgen hφ' halg' hbl hblf hpb' hps' hβ Dβ hDβ Dp' hDp' Di' hDi' I'
  haveI : IsLocallyNoetherian Z₁ := LocallyOfFiniteType.isLocallyNoetherian i₁
  have hℓL : ((ℓ : ℕ) : IsLocalRing.ResidueField A') ≠ 0 := by
    have h1 := hℓ'.map (IsLocalRing.residue A')
    rw [map_natCast] at h1
    exact h1.ne_zero
  obtain ⟨κt, κΛ, hK⟩ := wc_yrc_ladic_kummer_package (IsLocalRing.ResidueField A') ℓ hℓL
  obtain ⟨N, U, x, j, hU, hcov, hzero, hunit, hxv, hxvi⟩ := wc_qmbt_dlyt_eq_cover hℓ hn hn4 hπ hc
    hx₀ hsh hps hℓ' hπ' hπ'2 hgen hφ' halg' hbl hblf hpb' hps' hβ Dβ hDβ Dp' hDp' Di' hDi' I'
    i₁ i₂ iY h₁ h₂ hY E₁ hE₁ E₂ hE₂ EY hEY ρ₁ ρ₂ hz hS iY' gY hYsq
