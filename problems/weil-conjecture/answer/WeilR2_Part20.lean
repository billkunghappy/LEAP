      _ = (Abelian.Ext.mk₀ γ).comp (wcSuppPullExt Dj Df 2 (δ α)) (zero_add _) := rfl

  obtain ⟨De, hDe⟩ := wc_hm_pull_data_exists
    (pullbackRestrictIsoRestrict (Y.fromSpecStalk y) Wo).hom ℓ
  obtain ⟨De', hDe'⟩ := wc_hm_pull_data_exists
    (pullbackRestrictIsoRestrict (Y.fromSpecStalk y) Wo).inv ℓ
  obtain ⟨D₂, hD₂⟩ := wc_hm_pull_data_exists (𝟙 Wo'.toScheme) ℓ
  have hinjDe : Function.Injective (wcHMPull De 1) := by
    intro a b hab
    have hc := fun z => wc_hm_pull_comp (pullbackRestrictIsoRestrict (Y.fromSpecStalk y) Wo).hom
      (pullbackRestrictIsoRestrict (Y.fromSpecStalk y) Wo).inv (𝟙 Wo'.toScheme)
      (pullbackRestrictIsoRestrict (Y.fromSpecStalk y) Wo).inv_hom_id De hDe De' hDe' D₂ hD₂ 1 z
    calc a = wcHMPull D₂ 1 a := (wc_hm_pull_id (𝟙 Wo'.toScheme) rfl D₂ hD₂ 1 a).symm
      _ = wcHMPull De' 1 (wcHMPull De 1 a) := hc a
      _ = wcHMPull De' 1 (wcHMPull De 1 b) := by rw [hab]
      _ = wcHMPull D₂ 1 b := (hc b).symm
      _ = b := wc_hm_pull_id (𝟙 Wo'.toScheme) rfl D₂ hD₂ 1 b
  refine ⟨(wcHMPull De 1).comp δe'.symm.toAddMonoidHom, ?_, ?_, ?_⟩
  · exact hinjDe.comp δe'.symm.injective
  · intro θ
    have h := hn' (κ θ)
    rw [hκ θ] at h
    have h2 : δe'.symm ((Abelian.Ext.mk₀ γ).comp (wcSuppPullExt Dj Df 2 θ) (zero_add _)) =
        wcHMPull DfO 1 (κ θ) := by
      rw [AddEquiv.symm_apply_eq]
      exact h.symm
    show wcHMPull De 1 (δe'.symm _) = _
    rw [h2]
    exact (wc_hm_pull_comp (Y.fromSpecStalk y ∣_ Wo)
      (pullbackRestrictIsoRestrict (Y.fromSpecStalk y) Wo).hom
      (Limits.pullback.snd (Y.fromSpecStalk y) Wo.ι)
      (pullbackRestrictIsoRestrict_hom_morphismRestrict (Y.fromSpecStalk y) Wo)
      DfO hDfO De hDe Dg hDg 1 (κ θ)).symm
  · intro c X
    have h2 : δe'.symm (X.comp (Abelian.Ext.mk₀ (wcHMConst (Spec (Y.presheaf.stalk y)) ℓ c))
        (add_zero 2)) = wcHMScalar Wo'.toScheme ℓ 1 c (δe'.symm X) := by
      rw [AddEquiv.symm_apply_eq]
      show _ = δ' (wcHMScalar Wo'.toScheme ℓ 1 c (δe'.symm X))
      rw [hc']
      have hX : δ' (δe'.symm X) = X := δe'.apply_symm_apply X
      rw [hX]
    show wcHMPull De 1 (δe'.symm _) = wcHMScalar _ ℓ 1 c (wcHMPull De 1 (δe'.symm X))
    rw [h2]
    exact hpullsc De hDe c (δe'.symm X)

theorem wc_closed_supp_wetale_bc_iso {W W₁ W' W'₁ : Scheme.{u}} {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (q : W₁ ⟶ W) [IsClosedImmersion q] (q' : W'₁ ⟶ W') (b : W' ⟶ W) [WeaklyEtale b]
    [IsAffine W'] (b₁ : W'₁ ⟶ W₁) (hb : IsPullback q' b₁ b q)
    (Dq : wcHMPullData q ℓ) (hDq : wcHMPullCanonical Dq)
    (Dq' : wcHMPullData q' ℓ) (hDq' : wcHMPullCanonical Dq')
    (Db : wcHMPullData b ℓ) (hDb : wcHMPullCanonical Db) :
    ∃ ξ : wcSuppObj Dq' ≅ Db.Φ.obj (wcSuppObj Dq),
      wcSuppUnitMap Dq' ≫ ξ.hom = Db.μ.inv ≫ Db.Φ.map (wcSuppUnitMap Dq) :=
by
  classical

  haveI hq' : IsClosedImmersion q' :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion) hb.flip inferInstance
  have hrange : Set.range ⇑q' = ⇑b ⁻¹' Set.range ⇑q := by
    rw [← Scheme.Pullback.range_fst b q]
    ext x
    constructor
    · rintro ⟨y, rfl⟩
      exact ⟨hb.isoPullback.hom y, by rw [← Scheme.Hom.comp_apply, hb.isoPullback_hom_fst]⟩
    · rintro ⟨y, hy⟩
      exact ⟨hb.isoPullback.inv y, by rw [← hy, ← Scheme.Hom.comp_apply, hb.isoPullback_inv_fst]⟩

  haveI hE1 : Epi (wcSuppUnitMap Dq') := wc_supp_unit_epi_of_closed q' ℓ Dq' hDq'
  haveI : Epi (wcSuppUnitMap Dq) := wc_supp_unit_epi_of_closed q ℓ Dq hDq
  haveI : Db.Φ.IsLeftAdjoint := Db.adj.isLeftAdjoint
  haveI : Epi (Db.Φ.map (wcSuppUnitMap Dq)) := Db.Φ.map_epi _
  haveI hE2 : Epi (Db.μ.inv ≫ Db.Φ.map (wcSuppUnitMap Dq)) := epi_comp _ _

  have hU : ∀ (W₀ : W'.ProEt) (t : C(↥W₀.left, ULift.{u+1} ℚ_[ℓ])),
      ((wcSuppUnitMap Dq').val.app (Opposite.op W₀)).hom t = 0 ↔
        ∀ w : ↥W₀.left, b (W₀.hom w) ∈ Set.range ⇑q → t w = 0 := by
    intro W₀ t
    obtain ⟨c', hc'⟩ := wc_supp_unit_twist_isUnit Dq'
    have htw := wc_supp_hom_twist_formula Dq' hDq' (wcSuppUnitMap Dq') W₀ t
    constructor
    · intro h0 w hw
      have hw' : w ∈ Set.range ⇑(Limits.pullback.fst W₀.hom q') := by
        rw [Scheme.Pullback.range_fst, hrange]; exact hw
      obtain ⟨z, rfl⟩ := hw'
      have htw' := h0.symm.trans htw
      have h1 := congrArg
        (fun φ : C(↥(Limits.pullback W₀.hom q'), ULift.{u+1} ℚ_[ℓ]) => φ z) htw'
      have h2 := congrArg (fun φ : C(↥W'₁, ULift.{u+1} ℚ_[ℓ]) =>
        φ ((Limits.pullback.snd W₀.hom q').base.hom z)) hc'
      have h1' : (0 : ULift.{u+1} ℚ_[ℓ]) =
          t ((Limits.pullback.fst W₀.hom q').base.hom z) *
            (wcSuppTwist (wcSuppUnitMap Dq'))
              ((Limits.pullback.snd W₀.hom q').base.hom z) := h1
      have h2' : (wcSuppTwist (wcSuppUnitMap Dq'))
            ((Limits.pullback.snd W₀.hom q').base.hom z) *
          c' ((Limits.pullback.snd W₀.hom q').base.hom z) = 1 := h2
      show t ((Limits.pullback.fst W₀.hom q').base.hom z) = 0
      linear_combination
        (-(c' ((Limits.pullback.snd W₀.hom q').base.hom z))) * h1' -
        (t ((Limits.pullback.fst W₀.hom q').base.hom z)) * h2'
    · intro hv
      have hzero : (t.comp (Limits.pullback.fst W₀.hom q').base.hom *
          (wcSuppTwist (wcSuppUnitMap Dq')).comp (Limits.pullback.snd W₀.hom q').base.hom :
            C(↥(Limits.pullback W₀.hom q'), ULift.{u+1} ℚ_[ℓ])) = 0 := by
        refine ContinuousMap.ext fun z => ?_
        have hz' : W₀.hom ((Limits.pullback.fst W₀.hom q').base.hom z) ∈ Set.range ⇑q' :=
          ⟨(Limits.pullback.snd W₀.hom q').base.hom z,
            (congrArg (fun φ => φ.base z)
              (Limits.pullback.condition (f := W₀.hom) (g := q'))).symm⟩
        have hz : b (W₀.hom ((Limits.pullback.fst W₀.hom q').base.hom z)) ∈ Set.range ⇑q := by
          rw [hrange] at hz'; exact hz'
        have h0 : t ((Limits.pullback.fst W₀.hom q').base.hom z) = 0 := hv _ hz
        show t ((Limits.pullback.fst W₀.hom q').base.hom z) *
          (wcSuppTwist (wcSuppUnitMap Dq')) ((Limits.pullback.snd W₀.hom q').base.hom z) = 0
        rw [h0, zero_mul]
      exact htw.trans hzero

  let V : W.ProEt := MorphismProperty.Over.mk ⊤ b inferInstance
  obtain ⟨hc, -, -⟩ := wc_lpsc_site W V
  haveI := hc
  obtain ⟨θ⟩ := wc_hm_pull_Phi_slice_iso W ℓ V Db hDb
  have hcore : ∀ (μ' : SheafOfModules.unit (wcRingSheaf W' ℓ) ⟶
        (wcSliceRes W ℓ V).obj (SheafOfModules.unit (wcRingSheaf W ℓ)))
      (ν : (wcSliceRes W ℓ V).obj (SheafOfModules.unit (wcRingSheaf W ℓ)) ⟶
        SheafOfModules.unit (wcRingSheaf W' ℓ)), μ' ≫ ν = 𝟙 _ →
      ∀ (W₀ : W'.ProEt) (t : C(↥W₀.left, ULift.{u+1} ℚ_[ℓ])),
        (((wcSliceRes W ℓ V).map (wcSuppUnitMap Dq)).val.app (Opposite.op W₀)).hom
          ((μ'.val.app (Opposite.op W₀)).hom t) = 0 ↔
        ∀ w : ↥W₀.left, b (W₀.hom w) ∈ Set.range ⇑q → t w = 0 := by
    intro μ' ν hμν W₀ t
    set a : C(↥W₀.left, ULift.{u+1} ℚ_[ℓ]) :=
      (μ'.val.app (Opposite.op W₀)).hom (1 : C(↥W₀.left, ULift.{u+1} ℚ_[ℓ])) with ha
    set a' : C(↥W₀.left, ULift.{u+1} ℚ_[ℓ]) :=
      (ν.val.app (Opposite.op W₀)).hom (1 : C(↥W₀.left, ULift.{u+1} ℚ_[ℓ])) with ha'

    have hν1 : @Eq C(↥W₀.left, ULift.{u+1} ℚ_[ℓ]) ((ν.val.app (Opposite.op W₀)).hom a) 1 := by
      have h := congrArg (fun φ : SheafOfModules.unit (wcRingSheaf W' ℓ) ⟶
          SheafOfModules.unit (wcRingSheaf W' ℓ) =>
        (φ.val.app (Opposite.op W₀)).hom (1 : C(↥W₀.left, ULift.{u+1} ℚ_[ℓ]))) hμν
      first
        | exact h
        | (simp only [SheafOfModules.comp_val, PresheafOfModules.comp_app, ModuleCat.hom_comp,
            LinearMap.comp_apply, SheafOfModules.id_val, PresheafOfModules.id_app,
            ModuleCat.hom_id, LinearMap.id_apply] at h
           exact h)
    have hνa : ((ν.val.app (Opposite.op W₀)).hom a : C(↥W₀.left, ULift.{u+1} ℚ_[ℓ])) =
        a * a' :=
      (congrArg (ν.val.app (Opposite.op W₀)).hom (mul_one a).symm).trans
        ((ν.val.app (Opposite.op W₀)).hom.map_smul a (1 : C(↥W₀.left, ULift.{u+1} ℚ_[ℓ])))
    have hunit : a * a' = 1 := hνa.symm.trans hν1

    have hμt : ((μ'.val.app (Opposite.op W₀)).hom t : C(↥W₀.left, ULift.{u+1} ℚ_[ℓ])) =
        t * a :=
      (congrArg (μ'.val.app (Opposite.op W₀)).hom (mul_one t).symm).trans
        ((μ'.val.app (Opposite.op W₀)).hom.map_smul t (1 : C(↥W₀.left, ULift.{u+1} ℚ_[ℓ])))

    have hL : ((((wcSliceRes W ℓ V).map (wcSuppUnitMap Dq)).val.app (Opposite.op W₀)).hom
          ((μ'.val.app (Opposite.op W₀)).hom t) :
          C(↥(Limits.pullback ((wcSliceFunctor W V).obj W₀).hom q), ULift.{u+1} ℚ_[ℓ])) =
        (t * a).comp (Limits.pullback.fst ((wcSliceFunctor W V).obj W₀).hom q).base.hom *
          (wcSuppTwist (wcSuppUnitMap Dq)).comp
            (Limits.pullback.snd ((wcSliceFunctor W V).obj W₀).hom q).base.hom := by
      have e1 := wc_supp_hom_twist_formula Dq hDq (wcSuppUnitMap Dq)
        ((wcSliceFunctor W V).obj W₀) (t * a)
      refine Eq.trans ?_ e1
      exact congrArg (((wcSliceRes W ℓ V).map (wcSuppUnitMap Dq)).val.app (Opposite.op W₀)).hom
        hμt
    obtain ⟨c, hcc⟩ := wc_supp_unit_twist_isUnit Dq
    constructor
    · intro h0 w hw
      have hw' : w ∈ Set.range ⇑(Limits.pullback.fst ((wcSliceFunctor W V).obj W₀).hom q) := by
        rw [Scheme.Pullback.range_fst]; exact hw
      obtain ⟨z, rfl⟩ := hw'
      have hL' := h0.symm.trans hL
      have h1 := congrArg (fun φ : C(↥(Limits.pullback ((wcSliceFunctor W V).obj W₀).hom q),
        ULift.{u+1} ℚ_[ℓ]) => φ z) hL'
      have h2 := congrArg (fun φ : C(↥W₀.left, ULift.{u+1} ℚ_[ℓ]) =>
        φ ((Limits.pullback.fst ((wcSliceFunctor W V).obj W₀).hom q).base.hom z)) hunit
      have h3 := congrArg (fun φ : C(↥W₁, ULift.{u+1} ℚ_[ℓ]) =>
        φ ((Limits.pullback.snd ((wcSliceFunctor W V).obj W₀).hom q).base.hom z)) hcc
      have h1' : (0 : ULift.{u+1} ℚ_[ℓ]) =
          t ((Limits.pullback.fst ((wcSliceFunctor W V).obj W₀).hom q).base.hom z) *
            a ((Limits.pullback.fst ((wcSliceFunctor W V).obj W₀).hom q).base.hom z) *
            (wcSuppTwist (wcSuppUnitMap Dq))
              ((Limits.pullback.snd ((wcSliceFunctor W V).obj W₀).hom q).base.hom z) := h1
      have h2' : a ((Limits.pullback.fst ((wcSliceFunctor W V).obj W₀).hom q).base.hom z) *
          a' ((Limits.pullback.fst ((wcSliceFunctor W V).obj W₀).hom q).base.hom z) = 1 := h2
      have h3' : (wcSuppTwist (wcSuppUnitMap Dq))
            ((Limits.pullback.snd ((wcSliceFunctor W V).obj W₀).hom q).base.hom z) *
          c ((Limits.pullback.snd ((wcSliceFunctor W V).obj W₀).hom q).base.hom z) = 1 := h3
      show t ((Limits.pullback.fst ((wcSliceFunctor W V).obj W₀).hom q).base.hom z) = 0
      linear_combination
        (-(a' ((Limits.pullback.fst ((wcSliceFunctor W V).obj W₀).hom q).base.hom z) *
            c ((Limits.pullback.snd ((wcSliceFunctor W V).obj W₀).hom q).base.hom z))) * h1' -
        (t ((Limits.pullback.fst ((wcSliceFunctor W V).obj W₀).hom q).base.hom z) *
          (wcSuppTwist (wcSuppUnitMap Dq))
            ((Limits.pullback.snd ((wcSliceFunctor W V).obj W₀).hom q).base.hom z) *
          c ((Limits.pullback.snd ((wcSliceFunctor W V).obj W₀).hom q).base.hom z)) * h2' -
        t ((Limits.pullback.fst ((wcSliceFunctor W V).obj W₀).hom q).base.hom z) * h3'
    · intro hv
      have hzero : ((t * a).comp
            (Limits.pullback.fst ((wcSliceFunctor W V).obj W₀).hom q).base.hom *
          (wcSuppTwist (wcSuppUnitMap Dq)).comp
            (Limits.pullback.snd ((wcSliceFunctor W V).obj W₀).hom q).base.hom :
            C(↥(Limits.pullback ((wcSliceFunctor W V).obj W₀).hom q), ULift.{u+1} ℚ_[ℓ])) =
          0 := by
        refine ContinuousMap.ext fun z => ?_
        have hz : b (W₀.hom
            ((Limits.pullback.fst ((wcSliceFunctor W V).obj W₀).hom q).base.hom z)) ∈
            Set.range ⇑q :=
          ⟨(Limits.pullback.snd ((wcSliceFunctor W V).obj W₀).hom q).base.hom z,
            (congrArg (fun φ => φ.base z)
              (Limits.pullback.condition (f := ((wcSliceFunctor W V).obj W₀).hom)
                (g := q))).symm⟩
        have h0 : t ((Limits.pullback.fst ((wcSliceFunctor W V).obj W₀).hom q).base.hom z) =
            0 := hv _ hz
        show t ((Limits.pullback.fst ((wcSliceFunctor W V).obj W₀).hom q).base.hom z) *
            a ((Limits.pullback.fst ((wcSliceFunctor W V).obj W₀).hom q).base.hom z) *
            (wcSuppTwist (wcSuppUnitMap Dq))
              ((Limits.pullback.snd ((wcSliceFunctor W V).obj W₀).hom q).base.hom z) = 0
        rw [h0, zero_mul, zero_mul]
      exact hL.trans hzero
  have hnat : Db.Φ.map (wcSuppUnitMap Dq) =
      θ.hom.app _ ≫ (wcSliceRes W ℓ V).map (wcSuppUnitMap Dq) ≫ θ.inv.app _ := by
    rw [← Category.assoc, ← θ.hom.naturality, Category.assoc, Iso.hom_inv_id_app,
      Category.comp_id]
  have hμν : (Db.μ.inv ≫ θ.hom.app (SheafOfModules.unit (wcRingSheaf W ℓ))) ≫
      (θ.inv.app (SheafOfModules.unit (wcRingSheaf W ℓ)) ≫ Db.μ.hom) = 𝟙 _ :=
    (Category.assoc _ _ _).trans
      ((congrArg (fun k => Db.μ.inv ≫ k) (Iso.hom_inv_id_app_assoc θ _ Db.μ.hom)).trans
        Db.μ.inv_hom_id)
  have hinj : ∀ (W₀ : W'.ProEt) y,
      ((θ.inv.app (wcSuppObj Dq)).val.app (Opposite.op W₀)).hom y = 0 → y = 0 := by
    intro W₀ y hy
    have h := congrArg (fun φ => (φ.val.app (Opposite.op W₀)).hom y)
      (θ.inv_hom_id_app (wcSuppObj Dq))
    have h' : ((θ.hom.app (wcSuppObj Dq)).val.app (Opposite.op W₀)).hom
        (((θ.inv.app (wcSuppObj Dq)).val.app (Opposite.op W₀)).hom y) = y := h
    rw [hy, map_zero] at h'
    exact h'.symm
  have hV : ∀ (W₀ : W'.ProEt) (t : C(↥W₀.left, ULift.{u+1} ℚ_[ℓ])),
      ((Db.μ.inv ≫ Db.Φ.map (wcSuppUnitMap Dq)).val.app (Opposite.op W₀)).hom t = 0 ↔
        ∀ w : ↥W₀.left, b (W₀.hom w) ∈ Set.range ⇑q → t w = 0 := by
    intro W₀ t
    have e : ((Db.μ.inv ≫ Db.Φ.map (wcSuppUnitMap Dq)).val.app (Opposite.op W₀)).hom t =
        ((θ.inv.app (wcSuppObj Dq)).val.app (Opposite.op W₀)).hom
          ((((wcSliceRes W ℓ V).map (wcSuppUnitMap Dq)).val.app (Opposite.op W₀)).hom
            (((Db.μ.inv ≫ θ.hom.app (SheafOfModules.unit (wcRingSheaf W ℓ))).val.app
              (Opposite.op W₀)).hom t)) := by
      rw [hnat]; rfl
    have hc' := hcore _ _ hμν W₀ t
    rw [e]
    constructor
    · intro h
      exact hc'.mp (hinj W₀ _ h)
    · intro h
      exact (congrArg ((θ.inv.app (wcSuppObj Dq)).val.app (Opposite.op W₀)).hom
        (hc'.mpr h)).trans (map_zero _)

  have hiff : ∀ (W₀ : W'.ProEt) (t : C(↥W₀.left, ULift.{u+1} ℚ_[ℓ])),
      ((wcSuppUnitMap Dq').val.app (Opposite.op W₀)).hom t = 0 ↔
        ((Db.μ.inv ≫ Db.Φ.map (wcSuppUnitMap Dq)).val.app (Opposite.op W₀)).hom t = 0 :=
    fun W₀ t => (hU W₀ t).trans (hV W₀ t).symm
  have hK1 : Limits.kernel.ι (wcSuppUnitMap Dq') ≫
      (Db.μ.inv ≫ Db.Φ.map (wcSuppUnitMap Dq)) = 0 := by
    apply SheafOfModules.hom_ext
    apply PresheafOfModules.hom_ext
    intro W₀
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro x
    induction W₀ using Opposite.rec with
    | op W₀ =>
    have hk := congrArg (fun φ => (φ.val.app (Opposite.op W₀)).hom x)
      (Limits.kernel.condition (wcSuppUnitMap Dq'))
    change ((wcSuppUnitMap Dq').val.app (Opposite.op W₀)).hom
      (((Limits.kernel.ι (wcSuppUnitMap Dq')).val.app (Opposite.op W₀)).hom x) = 0 at hk
    have h1 := (hiff W₀ _).mp hk
    first
      | exact h1
      | (change ((Db.μ.inv ≫ Db.Φ.map (wcSuppUnitMap Dq)).val.app (Opposite.op W₀)).hom
            (((Limits.kernel.ι (wcSuppUnitMap Dq')).val.app (Opposite.op W₀)).hom x) = 0
         exact h1)
      | (simp only [SheafOfModules.comp_val, PresheafOfModules.comp_app, ModuleCat.hom_comp,
          LinearMap.comp_apply] at h1 ⊢
         rw [h1]
         rfl)
      | simp [h1]
  have hK2 : Limits.kernel.ι (Db.μ.inv ≫ Db.Φ.map (wcSuppUnitMap Dq)) ≫
      wcSuppUnitMap Dq' = 0 := by
    apply SheafOfModules.hom_ext
    apply PresheafOfModules.hom_ext
    intro W₀
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro x
    induction W₀ using Opposite.rec with
    | op W₀ =>
    have hk := congrArg (fun φ => (φ.val.app (Opposite.op W₀)).hom x)
      (Limits.kernel.condition (Db.μ.inv ≫ Db.Φ.map (wcSuppUnitMap Dq)))
    change ((Db.μ.inv ≫ Db.Φ.map (wcSuppUnitMap Dq)).val.app (Opposite.op W₀)).hom
      (((Limits.kernel.ι (Db.μ.inv ≫ Db.Φ.map (wcSuppUnitMap Dq))).val.app
        (Opposite.op W₀)).hom x) = 0 at hk
    have h1 := (hiff W₀ _).mpr hk
    first
      | exact h1
      | (change ((wcSuppUnitMap Dq').val.app (Opposite.op W₀)).hom
            (((Limits.kernel.ι (Db.μ.inv ≫ Db.Φ.map (wcSuppUnitMap Dq))).val.app
              (Opposite.op W₀)).hom x) = 0
         exact h1)
      | (simp only [SheafOfModules.comp_val, PresheafOfModules.comp_app, ModuleCat.hom_comp,
          LinearMap.comp_apply] at h1 ⊢
         rw [h1]
         rfl)
      | simp [h1]
  refine ⟨{ hom := Abelian.epiDesc (wcSuppUnitMap Dq')
              (Db.μ.inv ≫ Db.Φ.map (wcSuppUnitMap Dq)) hK1
            inv := Abelian.epiDesc (Db.μ.inv ≫ Db.Φ.map (wcSuppUnitMap Dq))
              (wcSuppUnitMap Dq') hK2
            hom_inv_id := ?_
            inv_hom_id := ?_ }, Abelian.comp_epiDesc _ _ _⟩
  · rw [← cancel_epi (wcSuppUnitMap Dq'), ← Category.assoc, Abelian.comp_epiDesc,
      Abelian.comp_epiDesc, Category.comp_id]
  · rw [← cancel_epi (Db.μ.inv ≫ Db.Φ.map (wcSuppUnitMap Dq)), ← Category.assoc,
      Abelian.comp_epiDesc, Abelian.comp_epiDesc, Category.comp_id]

theorem wc_closed_pushforward_exact_of_qc {W W₁ S ZS : Scheme.{u}} {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    [IsLocallyNoetherian S] (q : W₁ ⟶ W) [IsClosedImmersion q] (D : wcHMPullData q ℓ)
    (iS : ZS ⟶ S) [IsClosedImmersion iS] (v : W ⟶ S)
    (hq : Set.range ⇑q = ⇑v ⁻¹' Set.range ⇑iS) :
    Limits.PreservesFiniteColimits
      (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC q) _ _ D.cont D.φ) :=
by
  classical
  haveI hcont := D.cont


  have s1 : ∀ (U : W.ProEt) [IsAffine U.left],
      ∃ (n : ℕ) (Wf : Fin n → W.ProEt) (w : ∀ k, Wf k ⟶ U),
        (∀ k, IsAffine (Wf k).left) ∧
        (∀ k, IsEmpty ((wcProEtBC q).obj (Wf k)).left) ∧
        ∀ y : U.left, y ∉ Set.range (Limits.pullback.fst U.hom q) →
          ∃ k, y ∈ Set.range (w k).left := by
    intro U _
    haveI hU : WeaklyEtale U.hom := U.prop
    obtain ⟨O, hO⟩ : ∃ O : S.Opens, (O : Set S) = (Set.range iS)ᶜ :=
      ⟨⟨(Set.range iS)ᶜ, (IsClosedImmersion.isClosedEmbedding iS).isClosed_range.isOpen_compl⟩, rfl⟩
    have key : ∀ {Z : Scheme.{u}} (f : Z ⟶ S) [CompactSpace Z], IsCompact (f ⁻¹' (O : Set S)) := by
      intro Z f _
      haveI : QuasiCompact O.ι := inferInstance
      haveI : QuasiCompact (Limits.pullback.fst f O.ι) := inferInstance
      haveI : CompactSpace (Limits.pullback f O.ι : Scheme.{u}) :=
        QuasiCompact.compactSpace_of_compactSpace (Limits.pullback.fst f O.ι)
      have h1 := isCompact_range (Limits.pullback.fst f O.ι).continuous
      rw [Scheme.Pullback.range_fst, Scheme.Opens.range_ι] at h1
      exact h1
    have hqc : IsCompact ((U.hom ≫ v) ⁻¹' (O : Set S)) :=
      @key U.left (U.hom ≫ v) (inferInstanceAs (CompactSpace U.left))

    have hmem : ∀ y : U.left, y ∈ (U.hom ≫ v) ⁻¹' (O : Set S) ↔ U.hom y ∉ Set.range q := by
      intro y
      rw [hq, Set.mem_preimage, hO, Set.mem_compl_iff, Set.mem_preimage, Scheme.Hom.comp_apply]
    obtain ⟨K, hK⟩ : ∃ K : U.left.Opens, (K : Set U.left) = (U.hom ≫ v) ⁻¹' (O : Set S) :=
      ⟨⟨(U.hom ≫ v) ⁻¹' (O : Set S), O.isOpen.preimage (U.hom ≫ v).continuous⟩, rfl⟩
    have hKc : IsCompact (K : Set U.left) := by rw [hK]; exact hqc
    obtain ⟨s, hs, hKs⟩ := isCompact_iff_finite_and_eq_biUnion_affineOpens.mp hKc
    obtain ⟨t, ht⟩ : ∃ t : Finset U.left.affineOpens, ∀ a, a ∈ t ↔ a ∈ s :=
      ⟨hs.toFinset, fun a => hs.mem_toFinset⟩
    obtain ⟨V, hVt, hVsurj⟩ : ∃ (V : Fin t.card → U.left.affineOpens), (∀ k, V k ∈ t) ∧
        ∀ a ∈ t, ∃ k, V k = a :=
      ⟨fun k => (t.equivFin.symm k).1, fun k => (t.equivFin.symm k).2,
       fun a ha => ⟨t.equivFin ⟨a, ha⟩, by simp⟩⟩
    have hVK : ∀ k, ((V k : U.left.Opens) : Set U.left) ⊆ (K : Set U.left) := by
      intro k
      rw [hKs]
      intro x hx
      simp only [TopologicalSpace.Opens.coe_iSup, Set.mem_iUnion]
      exact ⟨V k, (ht _).mp (hVt k), hx⟩
    refine ⟨t.card, fun k => MorphismProperty.Over.mk ⊤ ((V k : U.left.Opens).ι ≫ U.hom) inferInstance,
      fun k => MorphismProperty.Over.homMk (V k : U.left.Opens).ι rfl trivial, ?_, ?_, ?_⟩
    · intro k
      exact (V k).2
    · intro k
      show IsEmpty (Limits.pullback (C := Scheme.{u}) ((V k : U.left.Opens).ι ≫ U.hom) q)
      apply Scheme.isEmpty_pullback
      rw [Set.disjoint_left]
      rintro a ⟨z, rfl⟩ ⟨x, hx⟩
      have h1 : ((V k : U.left.Opens).ι z) ∈ (K : Set U.left) :=
        hVK k (by rw [← Scheme.Opens.range_ι]; exact ⟨z, rfl⟩)
      rw [hK, hmem] at h1
      exact h1 ⟨x, by rw [hx]; rfl⟩
    · intro y hy
      rw [Scheme.Pullback.range_fst] at hy
      have hyK : y ∈ (K : Set U.left) := by
        rw [hK, hmem]; exact hy
      rw [hKs] at hyK
      simp only [TopologicalSpace.Opens.coe_iSup, Set.mem_iUnion] at hyK
      obtain ⟨a, ha, hya⟩ := hyK
      obtain ⟨k, rfl⟩ := hVsurj a ((ht a).mpr ha)
      refine ⟨k, ?_⟩
      show y ∈ Set.range (V k : U.left.Opens).ι
      rw [Scheme.Opens.range_ι]
      exact hya

  have affine_local : ∀ (U : W.ProEt) (R : Sieve U),
      (∀ (V : W.ProEt) (f : V ⟶ U), IsAffine V.left → R.pullback f ∈ Scheme.ProEt.topology W V) →
      R ∈ Scheme.ProEt.topology W U := by
    intro U R hR
    have hU : WeaklyEtale U.hom := U.prop
    let Wc : U.left.affineCover.I₀ → W.ProEt := fun j =>
      MorphismProperty.Over.mk ⊤ (U.left.affineCover.f j ≫ U.hom) inferInstance
    let e : ∀ j, Wc j ⟶ U := fun j =>
      MorphismProperty.Over.homMk (U.left.affineCover.f j) rfl trivial
    have hP : Presieve.ofArrows Wc e ∈ (Scheme.ProEt.precoverage W).coverings U := by
      show _ ∈ (Precoverage.comap (Scheme.ProEt.forget W ⋙ Over.forget W)
        Scheme.proetalePrecoverage).coverings U
      rw [Precoverage.mem_comap_iff, Presieve.map_ofArrows]
      change U.left.affineCover.presieve₀ ∈ Scheme.proetalePrecoverage.coverings U.left
      exact ⟨Scheme.zariskiPrecoverage_le_qcPrecoverage U.left U.left.affineCover.mem₀,
        U.left.affineCover.mem₀.1,
        MorphismProperty.ofArrows_mem_precoverage.mpr (fun j => inferInstance)⟩
    refine GrothendieckTopology.transitive _ (Precoverage.generate_mem_toGrothendieck hP) R ?_
    intro Z f hf
    obtain ⟨Z', h, g', hg', rfl⟩ := hf
    rcases hg' with ⟨j⟩
    rw [Sieve.pullback_comp]
    exact GrothendieckTopology.pullback_stable _ h
      (hR (Wc j) (e j) (show IsAffine (U.left.affineCover.X j) by infer_instance))

  have hepi : ∀ {F F' : Sheaf (Scheme.ProEt.topology W₁) AddCommGrpCat.{u+1}} (φ : F ⟶ F'),
      Epi φ → Epi ((@Functor.sheafPushforwardContinuous _ _ _ _ (wcProEtBC q) AddCommGrpCat.{u+1} _
        (Scheme.ProEt.topology W) (Scheme.ProEt.topology W₁) D.cont).map φ) := by
    intro F F' φ hφ
    have hF' : Presieve.IsSheaf (Scheme.ProEt.topology W₁) (F'.obj ⋙ forget AddCommGrpCat.{u+1}) :=
      (isSheaf_iff_isSheaf_of_type _ _).mp ((Presheaf.isSheaf_iff_isSheaf_forget
        (Scheme.ProEt.topology W₁) F'.obj (forget AddCommGrpCat.{u+1})).mp F'.property)
    have hloc : ∀ (V : W.ProEt), IsAffine V.left →
        ∀ (y' : F'.obj.obj (Opposite.op ((wcProEtBC q).obj V))),
        ∃ (n : ℕ) (Wf : Fin n → W.ProEt) (wf : ∀ k, Wf k ⟶ V),
          Sieve.generate (Presieve.ofArrows Wf wf) ∈ Scheme.ProEt.topology W V ∧
          ∀ k, ∃ x : F.obj.obj (Opposite.op ((wcProEtBC q).obj (Wf k))),
            φ.hom.app (Opposite.op ((wcProEtBC q).obj (Wf k))) x =
              F'.obj.map ((wcProEtBC q).map (wf k)).op y' := by
      intro V hV y'
      haveI : IsAffine V.left := hV
      haveI hGV : IsAffine ((wcProEtBC q).obj V).left := by
        show IsAffine (Limits.pullback V.hom q)
        exact (@IsClosedImmersion.isAffine_surjective_of_isAffine _ _ hV
          (Limits.pullback.fst V.hom q) _).1
      obtain ⟨V', g', x', hV', hg', hx'⟩ :=
        wc_proet_epi_affine_lift W₁ φ hφ ((wcProEtBC q).obj V) hGV y'
      obtain ⟨W₀, w₀, a, hW₀, ha, hcov₀⟩ := wc_closed_proet_cover_extension_affine q V V' g' hV' hg'
        wc_weaklyEtale_cover_lift_along_surjection
      obtain ⟨m, Wc, w, hWaff, hWempty, hcovW⟩ := s1 V
      refine ⟨m + 1, fun k => Fin.cases W₀ Wc k, fun k => Fin.cases w₀ w k, ?_, ?_⟩
      · apply proet_finite_affine_jointly_surjective_covers W V (m + 1)
        · intro k
          refine Fin.cases ?_ (fun j => ?_) k
          · exact hW₀
          · exact hWaff j
        · intro y
          by_cases hy : y ∈ Set.range (Limits.pullback.fst V.hom q)
          · exact ⟨0, hcov₀ y hy⟩
          · obtain ⟨j, hj⟩ := hcovW y hy
            exact ⟨j.succ, hj⟩
      · intro k
        refine Fin.cases ?_ (fun j => ?_) k
        · refine ⟨F.obj.map a.op x', ?_⟩
          show φ.hom.app (Opposite.op ((wcProEtBC q).obj W₀)) (F.obj.map a.op x') =
            F'.obj.map ((wcProEtBC q).map w₀).op y'
          rw [NatTrans.naturality_apply, hx', ← ha, op_comp, Functor.map_comp,
            ConcreteCategory.comp_apply]
        · haveI : IsEmpty ((wcProEtBC q).obj (Wc j)).left := hWempty j
          refine ⟨0, ?_⟩
          show φ.hom.app (Opposite.op ((wcProEtBC q).obj (Wc j))) 0 =
            F'.obj.map ((wcProEtBC q).map (w j)).op y'
          have hbot : Presieve.IsSheafFor (F'.obj ⋙ forget AddCommGrpCat.{u+1})
              (⊥ : Presieve ((wcProEtBC q).obj (Wc j))) :=
            hF'.isSheafFor ⊥ (by rw [Sieve.generate_bot]; exact Scheme.ProEt.bot_mem_topology _)
          exact hbot.isSeparatedFor (fun _ _ h => h.elim) _ _ (fun _ _ h => h.elim)
            (fun _ _ h => h.elim)
    refine (Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u+1} _).mp ⟨fun {U} y => ?_⟩
    apply affine_local U
    intro V f hV
    obtain ⟨n, Wf, wf, hcov, hx⟩ := hloc V hV (F'.obj.map ((wcProEtBC q).map f).op y)
    refine GrothendieckTopology.superset_covering _ ?_ hcov
    rw [Sieve.generate_le_iff]
    rintro _ _ ⟨k⟩
    obtain ⟨x, hxk⟩ := hx k
    show ∃ t, φ.hom.app (Opposite.op ((wcProEtBC q).obj (Wf k))) t =
      F'.obj.map ((wcProEtBC q).map (wf k ≫ f)).op y
    refine ⟨x, hxk.trans ?_⟩
    show (F'.obj.map ((wcProEtBC q).map (wf k)).op) ((F'.obj.map ((wcProEtBC q).map f).op) y) =
      (F'.obj.map ((wcProEtBC q).map (wf k ≫ f)).op) y
    rw [Functor.map_comp, op_comp, Functor.map_comp]
    rfl

  haveI hPE : (@Functor.sheafPushforwardContinuous _ _ _ _ (wcProEtBC q) AddCommGrpCat.{u+1} _
      (Scheme.ProEt.topology W) (Scheme.ProEt.topology W₁) D.cont).PreservesEpimorphisms :=
    ⟨by intro A B f hf; exact hepi f hf⟩
  haveI hPH : (@Functor.sheafPushforwardContinuous _ _ _ _ (wcProEtBC q) AddCommGrpCat.{u+1} _
      (Scheme.ProEt.topology W) (Scheme.ProEt.topology W₁) D.cont).PreservesHomology :=
    Functor.preservesHomology_of_preservesEpis_and_kernels _
  haveI hPA : (@Functor.sheafPushforwardContinuous _ _ _ _ (wcProEtBC q) AddCommGrpCat.{u+1} _
      (Scheme.ProEt.topology W) (Scheme.ProEt.topology W₁) D.cont).Additive :=
    Functor.additive_of_preserves_binary_products _
  haveI hPC : Limits.PreservesFiniteColimits
      (@Functor.sheafPushforwardContinuous _ _ _ _ (wcProEtBC q) AddCommGrpCat.{u+1} _
        (Scheme.ProEt.topology W) (Scheme.ProEt.topology W₁) D.cont) :=
    Functor.preservesFiniteColimits_of_preservesHomology _

  haveI := sheafOfModules_toSheaf_preservesFiniteColimits (Scheme.ProEt.topology W) (wcRingSheaf W ℓ)
  haveI := sheafOfModules_toSheaf_preservesFiniteColimits (Scheme.ProEt.topology W₁) (wcRingSheaf W₁ ℓ)
  exact (sheafOfModules_pushforward_exact (wcProEtBC q) (wcRingSheaf W ℓ) (wcRingSheaf W₁ ℓ)
    D.φ).2.2

theorem wc_closed_supp_closed_bc_iso {W W₁ T T₁ S ZS : Scheme.{u}} {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    [IsLocallyNoetherian S] (q : W₁ ⟶ W) [IsClosedImmersion q] (k : T ⟶ W)
    [IsClosedImmersion k] (k₁ : T₁ ⟶ W₁) [IsClosedImmersion k₁]
    (iS : ZS ⟶ S) [IsClosedImmersion iS] (v : W ⟶ S)
    (hk : Set.range ⇑k = ⇑v ⁻¹' Set.range ⇑iS) (hk₁ : Set.range ⇑k₁ = ⇑q ⁻¹' Set.range ⇑k)
    (Dq : wcHMPullData q ℓ) (hDq : wcHMPullCanonical Dq)
    (Dk : wcHMPullData k ℓ) (hDk : wcHMPullCanonical Dk)
    (Dk₁ : wcHMPullData k₁ ℓ) (hDk₁ : wcHMPullCanonical Dk₁) :
    ∃ β : wcSuppObj Dk₁ ≅ Dq.Φ.obj (wcSuppObj Dk),
      wcSuppUnitMap Dk₁ ≫ β.hom = Dq.μ.inv ≫ Dq.Φ.map (wcSuppUnitMap Dk) :=
by
  classical

  have hr : Set.range ⇑(Limits.pullback.fst q k) = Set.range ⇑k₁ :=
    (Scheme.Pullback.range_fst q k).trans hk₁.symm
  have hk₁S : ∀ y : ↥W₁, y ∈ Set.range ⇑k₁ ↔ v (q y) ∈ Set.range ⇑iS := by
    intro y
    rw [hk₁, Set.mem_preimage, hk, Set.mem_preimage]

  have kill : ∀ (N : SheafOfModules.{u+1} (wcRingSheaf W₁ ℓ))
      (w : SheafOfModules.unit (wcRingSheaf W₁ ℓ) ⟶ N),
      (∀ V : W₁.ProEt, (∀ x : ↥V.left, V.hom x ∉ Set.range k₁) →
        (w.val.app (Opposite.op V)).hom (1 : C(↥V.left, ULift.{u+1} ℚ_[ℓ])) = 0) →
      Limits.kernel.ι (wcSuppUnitMap Dk₁) ≫ w = 0 := by
    intro N w hw
    have vanish : ∀ (V : W₁.ProEt) (t : C(↥V.left, ULift.{u+1} ℚ_[ℓ])),
        ((wcSuppUnitMap Dk₁).val.app (Opposite.op V)).hom t = 0 →
        ∀ y : ↥V.left, V.hom y ∈ Set.range k₁ → t y = 0 := by
      intro V t h0 y hy
      have hy' : y ∈ Set.range (Limits.pullback.fst V.hom k₁) := by
        rw [Scheme.Pullback.range_fst]; exact hy
      obtain ⟨z, rfl⟩ := hy'
      obtain ⟨c', hc'⟩ := wc_supp_unit_twist_isUnit Dk₁
      have htw := wc_supp_hom_twist_formula Dk₁ hDk₁ (wcSuppUnitMap Dk₁) V t
      rw [h0] at htw
      have h1 := congrArg
        (fun φ : C(↥(Limits.pullback V.hom k₁), ULift.{u+1} ℚ_[ℓ]) => φ z) htw
      have h2 := congrArg (fun φ : C(↥T₁, ULift.{u+1} ℚ_[ℓ]) =>
        φ ((Limits.pullback.snd V.hom k₁).base.hom z)) hc'
      simp only [ContinuousMap.mul_apply, ContinuousMap.comp_apply,
        ContinuousMap.one_apply] at h1 h2
      have h1' : (0 : ULift.{u+1} ℚ_[ℓ]) =
          t ((Limits.pullback.fst V.hom k₁).base.hom z) *
            (wcSuppTwist (wcSuppUnitMap Dk₁)) ((Limits.pullback.snd V.hom k₁).base.hom z) := h1
      show t ((Limits.pullback.fst V.hom k₁).base.hom z) = 0
      linear_combination (-(c' ((Limits.pullback.snd V.hom k₁).base.hom z))) * h1' -
        (t ((Limits.pullback.fst V.hom k₁).base.hom z)) * h2
    have key : ∀ (V : W₁.ProEt) (t : C(↥V.left, ULift.{u+1} ℚ_[ℓ])),
        (∀ y : ↥V.left, V.hom y ∈ Set.range k₁ → t y = 0) →
        (w.val.app (Opposite.op V)).hom t = 0 := by
      intro V t ht
      apply wc_proet_module_section_eq_zero_of_affine_covers N V
      intro Wp gW hWaff
      haveI : IsAffine Wp.left := hWaff
      haveI : WeaklyEtale Wp.hom := Wp.prop
      have htW : ∀ x : ↥Wp.left, Wp.hom x ∈ Set.range k₁ →
          (t.comp gW.left.base.hom) x = 0 := by
        intro x hx
        apply ht
        have e : V.hom (gW.left x) = Wp.hom x := by
          rw [← MorphismProperty.Over.w gW]; rfl
        rw [e]; exact hx
      obtain ⟨W₀, qz, hW₀, hqz, hq0, hqr⟩ :=
        wc_affine_zero_locus_weaklyEtale Wp.left ℓ (t.comp gW.left.base.hom)
      obtain ⟨n, f, hf0⟩ := wc_affine_complement_basicOpen_cover iS Wp.left (Wp.hom ≫ q ≫ v)
      have hf : ∀ x : ↥Wp.left, (Wp.hom x ∉ Set.range k₁ ↔ ∃ j, x ∈ Wp.left.basicOpen (f j)) := by
        intro x
        rw [← hf0 x, hk₁S]
        simp only [Scheme.Hom.comp_apply]
      haveI := hqz
      let W' : Fin (n + 1) → W₁.ProEt :=
        Fin.cases (MorphismProperty.Over.mk ⊤ (qz ≫ Wp.hom) inferInstance)
          (fun j => MorphismProperty.Over.mk ⊤ ((Wp.left.basicOpen (f j)).ι ≫ Wp.hom)
            inferInstance)
      let e : ∀ j, W' j ⟶ Wp := Fin.cases (motive := fun j => W' j ⟶ Wp)
        (MorphismProperty.Over.homMk qz rfl trivial)
        (fun j => MorphismProperty.Over.homMk (Wp.left.basicOpen (f j)).ι rfl trivial)
      refine ⟨n + 1, W', e, ?_, ?_, ?_⟩
      · intro j
        induction j using Fin.cases with
        | zero => exact hW₀
        | succ j => exact (isAffineOpen_top Wp.left).basicOpen (f j)
      · intro x
        by_cases hx : Wp.hom x ∈ Set.range k₁
        · exact ⟨0, hqr x (htW x hx)⟩
        · obtain ⟨j, hj⟩ := (hf x).mp hx
          refine ⟨j.succ, ?_⟩
          show x ∈ Set.range (Wp.left.basicOpen (f j)).ι
          rw [Scheme.Opens.range_ι]
          exact hj
      · intro j
        refine (PresheafOfModules.naturality_apply w.val (e j ≫ gW).op t).symm.trans ?_
        induction j using Fin.cases with
        | zero =>
          have h0 : (t.comp ((e 0 ≫ gW).left.base.hom) :
              C(↥(W' 0).left, ULift.{u+1} ℚ_[ℓ])) = 0 := by
            ext x
            exact congrArg ULift.down (hq0 x)
          change (w.val.app (Opposite.op (W' 0))).hom
            (t.comp ((e 0 ≫ gW).left.base.hom)) = 0
          refine (congrArg (fun s => (w.val.app (Opposite.op (W' 0))).hom s) h0).trans ?_
          exact map_zero _
        | succ j =>
          have hV : ∀ x : ↥(W' j.succ).left, (W' j.succ).hom x ∉ Set.range k₁ := by
            intro x
            have hx : (Wp.left.basicOpen (f j)).ι x ∈
                (Wp.left.basicOpen (f j) : Set ↥Wp.left) := by
              rw [← Scheme.Opens.range_ι]; exact ⟨x, rfl⟩
            exact (hf _).mpr ⟨j, hx⟩
          have hs4 := hw (W' j.succ) hV
          have hsm := (w.val.app (Opposite.op (W' j.succ))).hom.map_smul
            (t.comp ((e j.succ ≫ gW).left.base.hom))
            (1 : C(↥(W' j.succ).left, ULift.{u+1} ℚ_[ℓ]))
          change (w.val.app (Opposite.op (W' j.succ))).hom
            (t.comp ((e j.succ ≫ gW).left.base.hom)) = 0
          refine (congrArg (fun s => (w.val.app (Opposite.op (W' j.succ))).hom s)
            (mul_one (t.comp ((e j.succ ≫ gW).left.base.hom))).symm).trans ?_
          refine hsm.trans ?_
          rw [hs4]
          exact smul_zero _
    apply SheafOfModules.hom_ext
    apply PresheafOfModules.hom_ext
    intro X
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro x
    induction X using Opposite.rec with
    | op V =>
    have hker := congrArg (fun φ => (φ.val.app (Opposite.op V)).hom x)
      (Limits.kernel.condition (wcSuppUnitMap Dk₁))
    change ((wcSuppUnitMap Dk₁).val.app (Opposite.op V)).hom
      (((Limits.kernel.ι (wcSuppUnitMap Dk₁)).val.app (Opposite.op V)).hom x) = 0 at hker
    change (w.val.app (Opposite.op V)).hom
      (((Limits.kernel.ι (wcSuppUnitMap Dk₁)).val.app (Opposite.op V)).hom x) = 0
    exact key V _ (vanish V _ hker)

  have hF : Limits.kernel.ι (wcSuppUnitMap Dk₁) ≫
      (Dq.μ.inv ≫ Dq.Φ.map (wcSuppUnitMap Dk)) = 0 := by
    apply kill
    intro V hV
    exact wc_supp_pull_unit_vanish_off k q (Limits.pullback.fst q k) (Limits.pullback.snd q k)
      (IsPullback.of_hasPullback q k) ℓ Dk Dq V (fun x hx => hV x (hr ▸ hx))

  obtain ⟨Dp, hDp⟩ := wc_hm_pull_data_exists (Limits.pullback.fst q k) ℓ
  have hR := wc_supp_reverse_kernel_kill k q (Limits.pullback.fst q k) (Limits.pullback.snd q k)
    Limits.pullback.condition ℓ Dk hDk Dp hDp Dq hDq
  haveI hek := wc_supp_unit_epi_of_closed k ℓ Dk hDk
  obtain ⟨ρ, hρ⟩ : ∃ ρ : wcSuppObj Dk ⟶
      (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC q) _ _ Dq.cont Dq.φ).obj (wcSuppObj Dp),
      wcSuppUnitMap Dk ≫ ρ = wcSuppUnitMap Dq ≫
        (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC q) _ _ Dq.cont Dq.φ).map
          (wcSuppUnitMap Dp) :=
    ⟨_, Abelian.comp_epiDesc _ _ hR⟩
  have e1 : wcSuppUnitMap Dq = Dq.adj.homEquiv _ _ Dq.μ.hom := by
    rw [Adjunction.homEquiv_unit]; rfl
  have h3 : (Dq.adj.homEquiv _ _).symm (wcSuppUnitMap Dq) = Dq.μ.hom := by
    rw [e1, Equiv.symm_apply_apply]
  have hδP : (Dq.μ.inv ≫ Dq.Φ.map (wcSuppUnitMap Dk)) ≫ (Dq.adj.homEquiv _ _).symm ρ =
      wcSuppUnitMap Dp := by
    calc (Dq.μ.inv ≫ Dq.Φ.map (wcSuppUnitMap Dk)) ≫ (Dq.adj.homEquiv _ _).symm ρ
        = Dq.μ.inv ≫ (Dq.adj.homEquiv _ _).symm (wcSuppUnitMap Dk ≫ ρ) := by
          rw [Category.assoc, Adjunction.homEquiv_naturality_left_symm]
      _ = Dq.μ.inv ≫ (Dq.adj.homEquiv _ _).symm (wcSuppUnitMap Dq ≫
            (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC q) _ _ Dq.cont Dq.φ).map
              (wcSuppUnitMap Dp)) := by rw [hρ]
      _ = Dq.μ.inv ≫ ((Dq.adj.homEquiv _ _).symm (wcSuppUnitMap Dq) ≫ wcSuppUnitMap Dp) := by
          exact congrArg (Dq.μ.inv ≫ ·)
            (Dq.adj.homEquiv_naturality_right_symm
              (wcSuppUnitMap Dq : SheafOfModules.unit (wcRingSheaf W ℓ) ⟶
                (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC q) _ _ Dq.cont Dq.φ).obj
                  (SheafOfModules.unit (wcRingSheaf W₁ ℓ)))
              (wcSuppUnitMap Dp))
      _ = Dq.μ.inv ≫ (Dq.μ.hom ≫ wcSuppUnitMap Dp) := by rw [h3]
      _ = wcSuppUnitMap Dp := Iso.inv_hom_id_assoc _ _
  obtain ⟨φ, hφ⟩ := wc_qmbt_xsp_supp_same_range_iso (Limits.pullback.fst q k) k₁ hr Dp hDp Dk₁ hDk₁
  obtain ⟨δ, hδ⟩ : ∃ δ : Dq.Φ.obj (wcSuppObj Dk) ⟶ wcSuppObj Dk₁,
      (Dq.μ.inv ≫ Dq.Φ.map (wcSuppUnitMap Dk)) ≫ δ = wcSuppUnitMap Dk₁ :=
    ⟨(Dq.adj.homEquiv _ _).symm ρ ≫ φ.hom,
      (Category.assoc _ _ _).symm.trans ((congrArg (· ≫ φ.hom) hδP).trans hφ)⟩

  have hv : Epi (Dq.μ.inv ≫ Dq.Φ.map (wcSuppUnitMap Dk)) := by
    haveI : Dq.Φ.IsLeftAdjoint := Dq.adj.isLeftAdjoint
    haveI := Functor.preservesEpimorphisms_of_isLeftAdjoint Dq.Φ
    infer_instance
  haveI := hv
  haveI hek₁ := wc_supp_unit_epi_of_closed k₁ ℓ Dk₁ hDk₁

  have hβ := Abelian.comp_epiDesc (wcSuppUnitMap Dk₁) (Dq.μ.inv ≫ Dq.Φ.map (wcSuppUnitMap Dk)) hF
  refine ⟨⟨Abelian.epiDesc (wcSuppUnitMap Dk₁) (Dq.μ.inv ≫ Dq.Φ.map (wcSuppUnitMap Dk)) hF,
    δ, ?_, ?_⟩, hβ⟩
  · rw [← cancel_epi (wcSuppUnitMap Dk₁), ← Category.assoc, hβ, hδ, Category.comp_id]
  · rw [← cancel_epi (Dq.μ.inv ≫ Dq.Φ.map (wcSuppUnitMap Dk)), ← Category.assoc, hδ, hβ,
      Category.comp_id]

theorem wc_stalk_closed_isPullback {X Y : Scheme.{u}} [IsAffine X] (p : Y ⟶ X)
    [IsClosedImmersion p] (y : Y) :
    IsPullback (Spec.map (p.stalkMap y)) (Y.fromSpecStalk y) (X.fromSpecStalk (p y)) p :=
by
  obtain ⟨hYaff, hsurj⟩ := IsClosedImmersion.isAffine_surjective_of_isAffine p
  haveI := hYaff
  have hcomm : X.presheaf.germ ⊤ (p y) trivial ≫ p.stalkMap y =
      p.appTop ≫ Y.presheaf.germ ⊤ y trivial :=
    Scheme.Hom.germ_stalkMap p ⊤ y trivial
  have hring : IsPushout p.appTop (X.presheaf.germ ⊤ (p y) trivial)
      (Y.presheaf.germ ⊤ y trivial) (p.stalkMap y) := by
    letI : Algebra Γ(X, ⊤) (X.presheaf.stalk (p y)) :=
      TopCat.Presheaf.algebra_section_stalk X.presheaf (⟨p y, trivial⟩ : (⊤ : X.Opens))
    letI : Algebra Γ(Y, ⊤) (Y.presheaf.stalk y) :=
      TopCat.Presheaf.algebra_section_stalk Y.presheaf (⟨y, trivial⟩ : (⊤ : Y.Opens))
    haveI hX := (isAffineOpen_top X).isLocalization_stalk ⟨p y, trivial⟩
    haveI hY := (isAffineOpen_top Y).isLocalization_stalk ⟨y, trivial⟩
    set P := ((isAffineOpen_top X).primeIdealOf ⟨p y, trivial⟩).asIdeal with hPdef
    set Q := ((isAffineOpen_top Y).primeIdealOf ⟨y, trivial⟩).asIdeal with hQdef
    have hgX : algebraMap Γ(X, ⊤) (X.presheaf.stalk (p y)) =
        (X.presheaf.germ ⊤ (p y) trivial).hom :=
      TopCat.Presheaf.stalk_open_algebraMap X.presheaf (⟨p y, trivial⟩ : (⊤ : X.Opens))
    have hgY : algebraMap Γ(Y, ⊤) (Y.presheaf.stalk y) =
        (Y.presheaf.germ ⊤ y trivial).hom :=
      TopCat.Presheaf.stalk_open_algebraMap Y.presheaf (⟨y, trivial⟩ : (⊤ : Y.Opens))
    have hcomm' : (p.stalkMap y).hom.comp (algebraMap Γ(X, ⊤) (X.presheaf.stalk (p y))) =
        (algebraMap Γ(Y, ⊤) (Y.presheaf.stalk y)).comp p.appTop.hom := by
      rw [hgX, hgY, ← CommRingCat.hom_comp, ← CommRingCat.hom_comp, hcomm]
    have hmax : (IsLocalRing.maximalIdeal (Y.presheaf.stalk y)).comap (p.stalkMap y).hom =
        IsLocalRing.maximalIdeal (X.presheaf.stalk (p y)) := by
      have htfae := IsLocalRing.local_hom_TFAE (p.stalkMap y).hom
      have hloc : IsLocalHom (p.stalkMap y).hom := inferInstance
      exact (htfae.out 1 5).mp hloc
    have hPQ : P = Q.comap p.appTop.hom := by
      have h1 := IsLocalization.AtPrime.under_maximalIdeal (X.presheaf.stalk (p y)) P
      have h2 := IsLocalization.AtPrime.under_maximalIdeal (Y.presheaf.stalk y) Q
      rw [← h1, ← h2]
      simp only [Ideal.under]
      rw [Ideal.comap_comap, ← hcomm', ← Ideal.comap_comap, hmax]
    have hM : Submonoid.map p.appTop.hom P.primeCompl = Q.primeCompl := by
      have hc : P.primeCompl = Submonoid.comap p.appTop.hom Q.primeCompl := by
        ext a
        simp only [Ideal.primeCompl, Submonoid.mem_mk, Subsemigroup.mem_mk,
          Submonoid.mem_comap, Set.mem_compl_iff, SetLike.mem_coe]
        rw [hPQ, Ideal.mem_comap]
      rw [hc, Submonoid.map_comap_eq_self_of_surjective hsurj]
    haveI : IsLocalization (Submonoid.map p.appTop.hom P.primeCompl) (Y.presheaf.stalk y) := by
      rw [hM]; exact hY
    have h := CommRingCat.isPushout_of_isLocalization p.appTop.hom (p.stalkMap y).hom hcomm'
      P.primeCompl
    rw [hgX, hgY] at h
    simpa only [CommRingCat.ofHom_hom] using h
  have h3 := (isPullback_SpecMap_of_isPushout _ _ _ _ hring).flip
  refine IsPullback.of_iso h3 (Iso.refl _) (Iso.refl _) Y.isoSpec.symm X.isoSpec.symm
    ?_ ?_ ?_ ?_
  · simp
  · simp only [Iso.symm_hom, Iso.refl_hom, Category.id_comp]
    rw [← Scheme.fromSpecStalk_toSpecΓ, ← Scheme.isoSpec_hom, Category.assoc, Iso.hom_inv_id,
      Category.comp_id]
  · simp only [Iso.symm_hom, Iso.refl_hom, Category.id_comp]
    rw [← Scheme.fromSpecStalk_toSpecΓ, ← Scheme.isoSpec_hom, Category.assoc, Iso.hom_inv_id,
      Category.comp_id]
  · simpa only [Iso.symm_hom] using Scheme.isoSpec_inv_naturality p

theorem wc_closed_adj_trade_scalar {W W₁ T T₁ : Scheme.{u}} {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (q : W₁ ⟶ W) [IsClosedImmersion q] (k : T ⟶ W) [IsClosedImmersion k]
    (k₁ : T₁ ⟶ W₁) [IsClosedImmersion k₁]
    (Dq : wcHMPullData q ℓ) (hDq : wcHMPullCanonical Dq)
    (Dk : wcHMPullData k ℓ) (hDk : wcHMPullCanonical Dk)
    (Dk₁ : wcHMPullData k₁ ℓ) (hDk₁ : wcHMPullCanonical Dk₁)
    (hex : Limits.PreservesFiniteColimits
      (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC q) _ _ Dq.cont Dq.φ))
    (β : wcSuppObj Dk₁ ≅ Dq.Φ.obj (wcSuppObj Dk))
    (hβ : wcSuppUnitMap Dk₁ ≫ β.hom = Dq.μ.inv ≫ Dq.Φ.map (wcSuppUnitMap Dk))
    (N : SheafOfModules.{u+1} (wcRingSheaf W ℓ)) (ψ : N ≅ wcSuppObj Dq) (n : ℕ) :
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf W ℓ)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf W₁ ℓ)) := HasExt.standard _
    Function.Bijective (wcClosedAdjTrade Dq Dk Dk₁ hex β.hom ψ.hom n) ∧
    (∀ x y : Abelian.Ext (wcSuppObj Dk) N n,
      wcClosedAdjTrade Dq Dk Dk₁ hex β.hom ψ.hom n (x + y) =
        wcClosedAdjTrade Dq Dk Dk₁ hex β.hom ψ.hom n x +
          wcClosedAdjTrade Dq Dk Dk₁ hex β.hom ψ.hom n y) ∧
    ∀ (c : ℚ_[ℓ]) (x : Abelian.Ext (wcSuppObj Dk) N n),
      wcClosedAdjTrade Dq Dk Dk₁ hex β.hom ψ.hom n
          ((Abelian.Ext.mk₀ ((@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _
            (wcProEtBC k) _ _ Dk.cont Dk.φ).map (wcHMConst T ℓ c))).comp x (zero_add n)) =
        (wcClosedAdjTrade Dq Dk Dk₁ hex β.hom ψ.hom n x).comp
          (Abelian.Ext.mk₀ (wcHMConst W₁ ℓ c)) (add_zero n) :=
by
  classical
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf W ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf W₁ ℓ)) := HasExt.standard _
  haveI := Dq.additive
  haveI := Dq.presLim
  haveI := Dq.presColim
  haveI := Dq.cont
  haveI : (SheafOfModules.pushforward.{u+1} Dq.φ).Additive := Dq.adj.right_adjoint_additive
  haveI : Limits.PreservesLimitsOfSize.{0, 0} (SheafOfModules.pushforward.{u+1} Dq.φ) :=
    Dq.adj.rightAdjoint_preservesLimits
  haveI : Limits.PreservesFiniteLimits (SheafOfModules.pushforward.{u+1} Dq.φ) :=
    Limits.PreservesLimitsOfSize.preservesFiniteLimits _
  haveI : Limits.PreservesFiniteColimits (SheafOfModules.pushforward.{u+1} Dq.φ) := hex
  haveI : Limits.PreservesLimitsOfShape Limits.WalkingCospan Dq.Φ :=
    Limits.PreservesFiniteLimits.preservesFiniteLimits _
  haveI : Dq.Φ.PreservesMonomorphisms := preservesMonomorphisms_of_preservesLimitsOfShape _
  haveI : EnoughInjectives (SheafOfModules.{u+1} (wcRingSheaf W₁ ℓ)) :=
    sheafOfModules_enoughInjectives (Scheme.ProEt.topology W₁) (wcRingSheaf W₁ ℓ)

  let a : Abelian.Ext (Dq.Φ.obj (wcSuppObj Dk)) (SheafOfModules.unit (wcRingSheaf W₁ ℓ)) n →
      Abelian.Ext (wcSuppObj Dk) (wcSuppObj Dq) n := fun e =>
    (Abelian.Ext.mk₀ (Dq.adj.unit.app (wcSuppObj Dk))).comp
      (Abelian.Ext.mapExactFunctor (SheafOfModules.pushforward.{u+1} Dq.φ) e) (zero_add n)
  have ha : Function.Bijective a :=
    wc_ext_adjoint_transfer Dq.Φ (SheafOfModules.pushforward.{u+1} Dq.φ) Dq.adj (wcSuppObj Dk)
      (SheafOfModules.unit (wcRingSheaf W₁ ℓ)) n
  have hG : ∀ x : Abelian.Ext (wcSuppObj Dk) N n,
      wcClosedAdjTrade Dq Dk Dk₁ hex β.hom ψ.hom n x =
        (Abelian.Ext.mk₀ β.hom).comp
          (Function.invFun a (x.comp (Abelian.Ext.mk₀ ψ.hom) (add_zero n))) (zero_add n) :=
    fun x => rfl
  have hR1 : ∀ y, a (Function.invFun a y) = y := Function.rightInverse_invFun ha.2
  have hR2 : ∀ e, Function.invFun a (a e) = e := Function.leftInverse_invFun ha.1
  have haadd : ∀ e e', a (e + e') = a e + a e' := by
    intro e e'
    show (Abelian.Ext.mk₀ (Dq.adj.unit.app (wcSuppObj Dk))).comp
      (Abelian.Ext.mapExactFunctor (SheafOfModules.pushforward.{u+1} Dq.φ) (e + e')) (zero_add n) =
      (Abelian.Ext.mk₀ (Dq.adj.unit.app (wcSuppObj Dk))).comp
        (Abelian.Ext.mapExactFunctor (SheafOfModules.pushforward.{u+1} Dq.φ) e) (zero_add n) +
      (Abelian.Ext.mk₀ (Dq.adj.unit.app (wcSuppObj Dk))).comp
        (Abelian.Ext.mapExactFunctor (SheafOfModules.pushforward.{u+1} Dq.φ) e') (zero_add n)
    rw [Abelian.Ext.mapExactFunctor_add, Abelian.Ext.comp_add]
  have hbadd : ∀ y y', Function.invFun a (y + y') = Function.invFun a y + Function.invFun a y' := by
    intro y y'
    apply ha.1
    rw [haadd, hR1, hR1, hR1]
  have hanat : ∀ (f : wcSuppObj Dk ⟶ wcSuppObj Dk)
      (e : Abelian.Ext (Dq.Φ.obj (wcSuppObj Dk)) (SheafOfModules.unit (wcRingSheaf W₁ ℓ)) n),
      a ((Abelian.Ext.mk₀ (Dq.Φ.map f)).comp e (zero_add n)) =
        (Abelian.Ext.mk₀ f).comp (a e) (zero_add n) := by
    intro f e
    show (Abelian.Ext.mk₀ (Dq.adj.unit.app (wcSuppObj Dk))).comp
      (Abelian.Ext.mapExactFunctor (SheafOfModules.pushforward.{u+1} Dq.φ)
        ((Abelian.Ext.mk₀ (Dq.Φ.map f)).comp e (zero_add n))) (zero_add n) =
      (Abelian.Ext.mk₀ f).comp ((Abelian.Ext.mk₀ (Dq.adj.unit.app (wcSuppObj Dk))).comp
        (Abelian.Ext.mapExactFunctor (SheafOfModules.pushforward.{u+1} Dq.φ) e) (zero_add n))
        (zero_add n)
    rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
      Abelian.Ext.mk₀_comp_mk₀_assoc, Abelian.Ext.mk₀_comp_mk₀_assoc]
    exact congrArg (fun g => (Abelian.Ext.mk₀ g).comp
      (Abelian.Ext.mapExactFunctor (SheafOfModules.pushforward.{u+1} Dq.φ) e) (zero_add n))
      (Dq.adj.unit_naturality f)
  have hbnat : ∀ (f : wcSuppObj Dk ⟶ wcSuppObj Dk) (y : Abelian.Ext (wcSuppObj Dk) (wcSuppObj Dq) n),
      Function.invFun a ((Abelian.Ext.mk₀ f).comp y (zero_add n)) =
        (Abelian.Ext.mk₀ (Dq.Φ.map f)).comp (Function.invFun a y) (zero_add n) := by
    intro f y
    apply ha.1
    rw [hR1, hanat, hR1]

  have hs3 : ∀ {X Y : Scheme.{u}} {i : X ⟶ Y} (D : wcHMPullData i ℓ), wcHMPullCanonical D →
      ∀ c : ℚ_[ℓ], wcSuppUnitMap D ≫
        (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ D.cont D.φ).map
          (wcHMConst X ℓ c) = wcHMConst Y ℓ c ≫ wcSuppUnitMap D := by
    intro X Y i D hD c
    haveI := D.cont
    have h1 : D.μ.hom ≫ wcHMConst X ℓ c = D.Φ.map (wcHMConst Y ℓ c) ≫ D.μ.hom := by
      rw [← wc_hm_pull_const D hD c, Iso.hom_inv_id_assoc]
    have e2 : (SheafOfModules.pushforward.{u+1} D.φ).map D.μ.hom ≫
        (SheafOfModules.pushforward.{u+1} D.φ).map (wcHMConst X ℓ c) =
        (SheafOfModules.pushforward.{u+1} D.φ).map (D.Φ.map (wcHMConst Y ℓ c)) ≫
          (SheafOfModules.pushforward.{u+1} D.φ).map D.μ.hom := by
      rw [← Functor.map_comp, h1, Functor.map_comp]
    have e1 := Category.assoc (D.adj.unit.app (SheafOfModules.unit (wcRingSheaf Y ℓ)))
      ((SheafOfModules.pushforward.{u+1} D.φ).map D.μ.hom)
      ((SheafOfModules.pushforward.{u+1} D.φ).map (wcHMConst X ℓ c))
    have e3 := D.adj.unit_naturality_assoc (wcHMConst Y ℓ c)
      ((SheafOfModules.pushforward.{u+1} D.φ).map D.μ.hom)
    exact e1.trans ((congrArg
      (fun g => D.adj.unit.app (SheafOfModules.unit (wcRingSheaf Y ℓ)) ≫ g) e2).trans e3)
  refine ⟨?_, ?_, ?_⟩
  ·
    have hb : Function.Bijective (Function.invFun a) :=
      ⟨fun y y' h => by rw [← hR1 y, h, hR1], fun e => ⟨a e, hR2 e⟩⟩
    have h1 : Function.Bijective (fun x : Abelian.Ext (wcSuppObj Dk) N n =>
        x.comp (Abelian.Ext.mk₀ ψ.hom) (add_zero n)) := by
      rw [Function.bijective_iff_has_inverse]
      refine ⟨fun y => y.comp (Abelian.Ext.mk₀ ψ.inv) (add_zero n), fun x => ?_, fun y => ?_⟩
      · show (x.comp (Abelian.Ext.mk₀ ψ.hom) (add_zero n)).comp (Abelian.Ext.mk₀ ψ.inv)
          (add_zero n) = x
        rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id,
          Abelian.Ext.comp_mk₀_id]
      · show (y.comp (Abelian.Ext.mk₀ ψ.inv) (add_zero n)).comp (Abelian.Ext.mk₀ ψ.hom)
          (add_zero n) = y
        rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id,
          Abelian.Ext.comp_mk₀_id]
    have h3 : Function.Bijective (fun e : Abelian.Ext (Dq.Φ.obj (wcSuppObj Dk))
        (SheafOfModules.unit (wcRingSheaf W₁ ℓ)) n => (Abelian.Ext.mk₀ β.hom).comp e (zero_add n)) := by
      rw [Function.bijective_iff_has_inverse]
      refine ⟨fun e => (Abelian.Ext.mk₀ β.inv).comp e (zero_add n), fun e => ?_, fun e => ?_⟩
      · show (Abelian.Ext.mk₀ β.inv).comp ((Abelian.Ext.mk₀ β.hom).comp e (zero_add n))
          (zero_add n) = e
        rw [Abelian.Ext.mk₀_comp_mk₀_assoc, Iso.inv_hom_id, Abelian.Ext.mk₀_id_comp]
      · show (Abelian.Ext.mk₀ β.hom).comp ((Abelian.Ext.mk₀ β.inv).comp e (zero_add n))
          (zero_add n) = e
        rw [Abelian.Ext.mk₀_comp_mk₀_assoc, Iso.hom_inv_id, Abelian.Ext.mk₀_id_comp]
    have hfun : wcClosedAdjTrade Dq Dk Dk₁ hex β.hom ψ.hom n =
        (fun e : Abelian.Ext (Dq.Φ.obj (wcSuppObj Dk))
          (SheafOfModules.unit (wcRingSheaf W₁ ℓ)) n => (Abelian.Ext.mk₀ β.hom).comp e (zero_add n)) ∘
        Function.invFun a ∘ (fun x : Abelian.Ext (wcSuppObj Dk) N n =>
          x.comp (Abelian.Ext.mk₀ ψ.hom) (add_zero n)) := funext hG
    rw [hfun]
    exact h3.comp (hb.comp h1)
  ·
    intro x y
    rw [hG, hG, hG, Abelian.Ext.add_comp, hbadd, Abelian.Ext.comp_add]
  ·
    intro c x
    have hq1 : Dq.μ.inv ≫ Dq.Φ.map (wcHMConst W ℓ c) = wcHMConst W₁ ℓ c ≫ Dq.μ.inv := by
      rw [← wc_hm_pull_const Dq hDq c]
      simp
    obtain ⟨s, hs⟩ : ∃ s : wcSuppObj Dk ⟶ wcSuppObj Dk,
        s = (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _
          (wcProEtBC k) _ _ Dk.cont Dk.φ).map (wcHMConst T ℓ c) := ⟨_, rfl⟩
    obtain ⟨s₁, hs₁⟩ : ∃ s₁ : wcSuppObj Dk₁ ⟶ wcSuppObj Dk₁,
        s₁ = (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _
          (wcProEtBC k₁) _ _ Dk₁.cont Dk₁.φ).map (wcHMConst T₁ ℓ c) := ⟨_, rfl⟩
    have hks : wcSuppUnitMap Dk ≫ s = wcHMConst W ℓ c ≫ wcSuppUnitMap Dk := by
      subst hs
      exact hs3 Dk hDk c
    have hks₁ : wcSuppUnitMap Dk₁ ≫ s₁ = wcHMConst W₁ ℓ c ≫ wcSuppUnitMap Dk₁ := by
      subst hs₁
      exact hs3 Dk₁ hDk₁ c
    have hβc : β.hom ≫ Dq.Φ.map s = s₁ ≫ β.hom := by
      haveI := wc_supp_unit_epi_of_closed k₁ ℓ Dk₁ hDk₁
      apply (cancel_epi (wcSuppUnitMap Dk₁)).mp
      calc wcSuppUnitMap Dk₁ ≫ β.hom ≫ Dq.Φ.map s
          = (wcSuppUnitMap Dk₁ ≫ β.hom) ≫ Dq.Φ.map s := (Category.assoc _ _ _).symm
        _ = Dq.μ.inv ≫ Dq.Φ.map (wcSuppUnitMap Dk ≫ s) := by
          rw [hβ, Category.assoc, Functor.map_comp]
        _ = Dq.μ.inv ≫ Dq.Φ.map (wcHMConst W ℓ c ≫ wcSuppUnitMap Dk) := by
          rw [hks]
        _ = wcHMConst W₁ ℓ c ≫ Dq.μ.inv ≫ Dq.Φ.map (wcSuppUnitMap Dk) := by
          rw [Functor.map_comp, ← Category.assoc, hq1, Category.assoc]
