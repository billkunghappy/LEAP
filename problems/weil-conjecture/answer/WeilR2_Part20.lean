        (𝟭 (SheafOfModules.{u+1} R) ⟶ 𝟭 (SheafOfModules.{u+1} R)) := fun a ha =>
      { app := fun M => ⟨PresheafOfModules.Hom.mk (fun X => ModuleCat.ofHom
            { toFun := fun x => a X • x
              map_add' := fun x y => smul_add _ _ _
              map_smul' := fun r x => by
                simp only [RingHom.id_apply, smul_smul]
                rw [hcomm X] })
          (by
            intro X Y g
            ext x
            show a Y • (M.val.map g).hom x = (M.val.map g).hom (a X • x)
            rw [PresheafOfModules.map_smul, ha])⟩
        naturality := by
          intro M N g
          apply SheafOfModules.hom_ext
          apply PresheafOfModules.hom_ext
          intro X
          ext x
          show a X • (g.val.app X).hom x = (g.val.app X).hom (a X • x)
          exact ((g.val.app X).hom.map_smul _ _).symm }
    have happ : (mulT σ hσ).app (SheafOfModules.unit R) = E.hom := by
      apply (SheafOfModules.unit R).unitHomEquiv.injective
      apply PresheafOfModules.sections_ext
      intro X
      rw [SheafOfModules.unitHomEquiv_apply_coe]
      show σ X • (1 : R.obj.obj X) = s.1 X
      rw [smul_eq_mul, mul_one]
    have happ' : (mulT σ' hσ').app (SheafOfModules.unit R) = E.inv := by
      apply (SheafOfModules.unit R).unitHomEquiv.injective
      apply PresheafOfModules.sections_ext
      intro X
      rw [SheafOfModules.unitHomEquiv_apply_coe]
      show σ' X • (1 : R.obj.obj X) = t.1 X
      rw [smul_eq_mul, mul_one]
    have hτσ : ∀ X, σ' X * σ X = 1 := by
      intro X
      have h : (((mulT σ hσ).app (SheafOfModules.unit R) ≫
          (mulT σ' hσ').app (SheafOfModules.unit R)).val.app X).hom (1 : R.obj.obj X) =
          ((𝟙 (SheafOfModules.unit R) : SheafOfModules.unit R ⟶ SheafOfModules.unit R).val.app
            X).hom (1 : R.obj.obj X) := by
        rw [happ, happ', E.hom_inv_id]
      change σ' X • σ X • (1 : R.obj.obj X) = (1 : R.obj.obj X) at h
      rw [smul_eq_mul, smul_eq_mul, mul_one] at h
      exact h
    have hστ : ∀ X, σ X * σ' X = 1 := by
      intro X
      have h : (((mulT σ' hσ').app (SheafOfModules.unit R) ≫
          (mulT σ hσ).app (SheafOfModules.unit R)).val.app X).hom (1 : R.obj.obj X) =
          ((𝟙 (SheafOfModules.unit R) : SheafOfModules.unit R ⟶ SheafOfModules.unit R).val.app
            X).hom (1 : R.obj.obj X) := by
        rw [happ, happ', E.inv_hom_id]
      change σ X • σ' X • (1 : R.obj.obj X) = (1 : R.obj.obj X) at h
      rw [smul_eq_mul, smul_eq_mul, mul_one] at h
      exact h
    refine ⟨{ hom := mulT σ hσ, inv := mulT σ' hσ', hom_inv_id := ?_, inv_hom_id := ?_ }, happ⟩
    · apply NatTrans.ext
      funext M
      apply SheafOfModules.hom_ext
      apply PresheafOfModules.hom_ext
      intro X
      ext x
      show σ' X • σ X • x = x
      rw [smul_smul, hτσ, one_smul]
    · apply NatTrans.ext
      funext M
      apply SheafOfModules.hom_ext
      apply PresheafOfModules.hom_ext
      intro X
      ext x
      show σ X • σ' X • x = x
      rw [smul_smul, hστ, one_smul]

  have hcen : ∀ (m : 𝟭 (SheafOfModules.{u+1} (wcRingSheaf V'' ℓ)) ⟶
      𝟭 (SheafOfModules.{u+1} (wcRingSheaf V'' ℓ)))
      {A B : SheafOfModules.{u+1} (wcRingSheaf V'' ℓ)} {a : ℕ} (z : Abelian.Ext A B a),
      (Abelian.Ext.mk₀ (m.app A)).comp z (zero_add a) =
        z.comp (Abelian.Ext.mk₀ (m.app B)) (add_zero a) := by
    intro m A B a z
    have h := Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp z m
    simp only [Abelian.Ext.id_mapExactFunctor] at h
    exact h.symm

  obtain ⟨ν, hν⟩ := hextIso (Dk.μ.symm ≪≫ ψ.app (SheafOfModules.unit (wcRingSheaf V ℓ)) ≪≫
    Df'.Φ.mapIso Df.μ ≪≫ Df'.μ)
  have hm : ν.hom.app (SheafOfModules.unit (wcRingSheaf V'' ℓ)) =
      Dk.μ.inv ≫ ψ.hom.app (SheafOfModules.unit (wcRingSheaf V ℓ)) ≫
        (Df'.Φ.map Df.μ.hom ≫ Df'.μ.hom) := hν
  have hB1 : ∀ {Z : SheafOfModules.{u+1} (wcRingSheaf V'' ℓ)}
      (h : Df'.Φ.obj (Df.Φ.obj (SheafOfModules.unit (wcRingSheaf V ℓ))) ⟶ Z),
      Df'.Φ.map Df.μ.hom ≫ Df'.μ.hom ≫ Df'.μ.inv ≫ Df'.Φ.map Df.μ.inv ≫ h = h := by
    intro Z h
    rw [Iso.hom_inv_id_assoc, ← CategoryTheory.Functor.map_comp_assoc, Iso.hom_inv_id,
      CategoryTheory.Functor.map_id, Category.id_comp]
  have hnat : Df'.μ.inv ≫ Df'.Φ.map Df.μ.inv ≫
      ν.hom.app ((Df.Φ ⋙ Df'.Φ).obj (SheafOfModules.unit (wcRingSheaf V ℓ))) =
      ν.hom.app (SheafOfModules.unit (wcRingSheaf V'' ℓ)) ≫ Df'.μ.inv ≫ Df'.Φ.map Df.μ.inv := by
    have h := ν.hom.naturality (Df'.μ.inv ≫ Df'.Φ.map Df.μ.inv)
    simp only [Functor.id_map, Category.assoc] at h
    exact h
  have hnatR : ∀ {Z : SheafOfModules.{u+1} (wcRingSheaf V'' ℓ)}
      (h : (Df.Φ ⋙ Df'.Φ).obj (SheafOfModules.unit (wcRingSheaf V ℓ)) ⟶ Z),
      Df'.μ.inv ≫ Df'.Φ.map Df.μ.inv ≫
        ν.hom.app ((Df.Φ ⋙ Df'.Φ).obj (SheafOfModules.unit (wcRingSheaf V ℓ))) ≫ h =
      ν.hom.app (SheafOfModules.unit (wcRingSheaf V'' ℓ)) ≫ Df'.μ.inv ≫
        Df'.Φ.map Df.μ.inv ≫ h := by
    intro Z h
    have := congrArg (fun t => t ≫ h) hnat
    simp only [Category.assoc] at this
    exact this

  obtain ⟨w, hw⟩ : ∃ w : wcSuppObj D'' ⟶ Dk.Φ.obj (wcSuppObj D),
      w = γ₂ ≫ Df'.Φ.map γ₁ ≫ ν.hom.app ((Df.Φ ⋙ Df'.Φ).obj (wcSuppObj D)) ≫
        ψ.inv.app (wcSuppObj D) := ⟨_, rfl⟩
  obtain ⟨e, he⟩ : ∃ e : Dk.Φ.obj N ≅ Df'.Φ.obj (Df.Φ.obj N),
      e.hom = ψ.hom.app N ≫ ν.inv.app ((Df.Φ ⋙ Df'.Φ).obj N) :=
    ⟨ψ.app N ≪≫ (ν.app ((Df.Φ ⋙ Df'.Φ).obj N)).symm, rfl⟩
  refine ⟨w, e, ?_, ?_⟩
  ·
    have n1 := ν.hom.naturality ((Df.Φ ⋙ Df'.Φ).map (wcSuppUnitMap D))
    simp only [Functor.id_map] at n1
    have n1R : ∀ {Z : SheafOfModules.{u+1} (wcRingSheaf V'' ℓ)}
        (h : (Df.Φ ⋙ Df'.Φ).obj (wcSuppObj D) ⟶ Z),
        (Df.Φ ⋙ Df'.Φ).map (wcSuppUnitMap D) ≫
          ν.hom.app ((Df.Φ ⋙ Df'.Φ).obj (wcSuppObj D)) ≫ h =
        ν.hom.app ((Df.Φ ⋙ Df'.Φ).obj (SheafOfModules.unit (wcRingSheaf V ℓ))) ≫
          (Df.Φ ⋙ Df'.Φ).map (wcSuppUnitMap D) ≫ h := by
      intro Z h
      have := congrArg (fun t => t ≫ h) n1
      simp only [Category.assoc] at this
      exact this
    have n2 : (Df.Φ ⋙ Df'.Φ).map (wcSuppUnitMap D) ≫ ψ.inv.app (wcSuppObj D) =
        ψ.inv.app (SheafOfModules.unit (wcRingSheaf V ℓ)) ≫ Dk.Φ.map (wcSuppUnitMap D) :=
      ψ.inv.naturality (wcSuppUnitMap D)
    have hstar : wcSuppUnitMap D'' ≫ γ₂ ≫ Df'.Φ.map γ₁ =
        Df'.μ.inv ≫ Df'.Φ.map Df.μ.inv ≫ (Df.Φ ⋙ Df'.Φ).map (wcSuppUnitMap D) := by
      rw [reassoc_of% hγ₂, ← CategoryTheory.Functor.map_comp, hγ₁,
        CategoryTheory.Functor.map_comp]
      rfl
    have hstarR : ∀ {Z : SheafOfModules.{u+1} (wcRingSheaf V'' ℓ)}
        (h : (Df.Φ ⋙ Df'.Φ).obj (wcSuppObj D) ⟶ Z),
        wcSuppUnitMap D'' ≫ γ₂ ≫ Df'.Φ.map γ₁ ≫ h =
        Df'.μ.inv ≫ Df'.Φ.map Df.μ.inv ≫ (Df.Φ ⋙ Df'.Φ).map (wcSuppUnitMap D) ≫ h := by
      intro Z h
      have := congrArg (fun t => t ≫ h) hstar
      simp only [Category.assoc] at this
      exact this
    rw [hw, hstarR, n1R, n2, hnatR, hm]
    simp only [Category.assoc]
    rw [hB1, Iso.hom_inv_id_app_assoc]
  ·
    intro n θ
    rw [he]
    show ((Abelian.Ext.mk₀ w).comp (Abelian.Ext.mapExactFunctor Dk.Φ θ) (zero_add n)).comp
        (Abelian.Ext.mk₀ (ψ.hom.app N ≫ ν.inv.app ((Df.Φ ⋙ Df'.Φ).obj N))) (add_zero n) =
      (Abelian.Ext.mk₀ γ₂).comp (Abelian.Ext.mapExactFunctor Df'.Φ
        ((Abelian.Ext.mk₀ γ₁).comp (Abelian.Ext.mapExactFunctor Df.Φ θ) (zero_add n)))
        (zero_add n)
    have nat' : (Abelian.Ext.mapExactFunctor Dk.Φ θ).comp
        (Abelian.Ext.mk₀ (ψ.hom.app N)) (add_zero n) =
        (Abelian.Ext.mk₀ (ψ.hom.app (wcSuppObj D))).comp
          (Abelian.Ext.mapExactFunctor (Df.Φ ⋙ Df'.Φ) θ) (zero_add n) :=
      Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp θ ψ.hom
    have hL : ((Abelian.Ext.mk₀ w).comp (Abelian.Ext.mapExactFunctor Dk.Φ θ) (zero_add n)).comp
        (Abelian.Ext.mk₀ (ψ.hom.app N ≫ ν.inv.app ((Df.Φ ⋙ Df'.Φ).obj N))) (add_zero n) =
        (Abelian.Ext.mk₀ (w ≫ ψ.hom.app (wcSuppObj D))).comp
          ((Abelian.Ext.mapExactFunctor (Df.Φ ⋙ Df'.Φ) θ).comp
            (Abelian.Ext.mk₀ (ν.inv.app ((Df.Φ ⋙ Df'.Φ).obj N))) (add_zero n)) (zero_add n) := by
      rw [h4, ← h3, nat', h4, h2]
    have hR : (Abelian.Ext.mk₀ γ₂).comp (Abelian.Ext.mapExactFunctor Df'.Φ
        ((Abelian.Ext.mk₀ γ₁).comp (Abelian.Ext.mapExactFunctor Df.Φ θ) (zero_add n)))
        (zero_add n) =
        (Abelian.Ext.mk₀ (γ₂ ≫ Df'.Φ.map γ₁)).comp
          (Abelian.Ext.mapExactFunctor (Df.Φ ⋙ Df'.Φ) θ) (zero_add n) := by
      rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
        ← Abelian.Ext.comp_mapExactFunctor, h2]
    rw [hL, hR]
    have hwψ : w ≫ ψ.hom.app (wcSuppObj D) =
        (γ₂ ≫ Df'.Φ.map γ₁) ≫ ν.hom.app ((Df.Φ ⋙ Df'.Φ).obj (wcSuppObj D)) := by
      rw [hw]
      simp only [Category.assoc, Iso.inv_hom_id_app]
      exact congrArg (fun t => γ₂ ≫ Df'.Φ.map γ₁ ≫ t) (Category.comp_id _)
    have key : (Abelian.Ext.mk₀ (ν.hom.app ((Df.Φ ⋙ Df'.Φ).obj (wcSuppObj D)))).comp
        ((Abelian.Ext.mapExactFunctor (Df.Φ ⋙ Df'.Φ) θ).comp
          (Abelian.Ext.mk₀ (ν.inv.app ((Df.Φ ⋙ Df'.Φ).obj N))) (add_zero n)) (zero_add n) =
        Abelian.Ext.mapExactFunctor (Df.Φ ⋙ Df'.Φ) θ := by
      rw [← h4, hcen ν.hom, h3, Iso.hom_inv_id_app]
      exact Abelian.Ext.comp_mk₀_id _
    rw [hwψ]
    exact (h2 _ _ _).symm.trans (congrArg (fun t => (Abelian.Ext.mk₀ (γ₂ ≫ Df'.Φ.map γ₁)).comp t
      (zero_add n)) key)

theorem wc_qmbt_dlyt_gamma_wet_affine {X Y Y' X' : Scheme.{u}} {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (i : X ⟶ Y) [IsClosedImmersion i] (f : Y' ⟶ Y) [WeaklyEtale f] [IsAffine Y']
    (i' : X' ⟶ Y') (g' : X' ⟶ X) (hsq : IsPullback i' g' f i)
    (D : wcHMPullData i ℓ) (hD : wcHMPullCanonical D)
    (Df : wcHMPullData f ℓ) (hDf : wcHMPullCanonical Df)
    (Di : wcHMPullData i' ℓ) (hDi : wcHMPullCanonical Di) (hepi : Epi (wcSuppUnitMap Di)) :
    ∃ γ : wcSuppObj Di ⟶ Df.Φ.obj (wcSuppObj D),
      wcSuppUnitMap Di ≫ γ = Df.μ.inv ≫ Df.Φ.map (wcSuppUnitMap D) :=
by
  classical
  haveI hE : Epi (wcSuppUnitMap Di) := hepi

  have s5 : ∀ y : ↥Y', f y ∈ Set.range i → y ∈ Set.range i' := by
    intro y hy
    have hy' : y ∈ Set.range (Limits.pullback.fst f i) := by
      rw [Scheme.Pullback.range_fst]; exact hy
    obtain ⟨p, rfl⟩ := hy'
    refine ⟨hsq.isoPullback.inv p, ?_⟩
    rw [← Scheme.Hom.comp_apply, IsPullback.isoPullback_inv_fst]
  let V : Y.ProEt := MorphismProperty.Over.mk ⊤ f inferInstance
  obtain ⟨hc, -, -⟩ := wc_lpsc_site Y V
  haveI := hc
  obtain ⟨θ⟩ := wc_hm_pull_Phi_slice_iso Y ℓ V Df hDf

  have hsec : ∀ (μ' : SheafOfModules.unit (wcRingSheaf Y' ℓ) ⟶
        (wcSliceRes Y ℓ V).obj (SheafOfModules.unit (wcRingSheaf Y ℓ)))
      (W : Y'.ProEt) (t : C(↥W.left, ULift.{u+1} ℚ_[ℓ])),
      ((wcSuppUnitMap Di).val.app (Opposite.op W)).hom t = 0 →
      (((wcSliceRes Y ℓ V).map (wcSuppUnitMap D)).val.app (Opposite.op W)).hom
        ((μ'.val.app (Opposite.op W)).hom t) = 0 := by
    intro μ' W t h0

    have hv : ∀ y : ↥W.left, W.hom y ∈ Set.range i' → t y = 0 := by
      intro y hy
      have hy' : y ∈ Set.range (Limits.pullback.fst W.hom i') := by
        rw [Scheme.Pullback.range_fst]; exact hy
      obtain ⟨z, rfl⟩ := hy'
      obtain ⟨c', hc'⟩ := wc_supp_unit_twist_isUnit Di
      have htw := wc_supp_hom_twist_formula Di hDi (wcSuppUnitMap Di) W t
      rw [h0] at htw
      have h1 := congrArg
        (fun φ : C(↥(Limits.pullback W.hom i'), ULift.{u+1} ℚ_[ℓ]) =>
          φ z) htw
      have h2 := congrArg (fun φ : C(↥X', ULift.{u+1} ℚ_[ℓ]) =>
        φ ((Limits.pullback.snd W.hom i').base.hom z)) hc'
      simp only [ContinuousMap.mul_apply, ContinuousMap.comp_apply,
        ContinuousMap.one_apply] at h1 h2
      have h1' : (0 : ULift.{u+1} ℚ_[ℓ]) =
          t ((Limits.pullback.fst W.hom i').base.hom z) *
            (wcSuppTwist (wcSuppUnitMap Di))
              ((Limits.pullback.snd W.hom i').base.hom z) := h1
      show t ((Limits.pullback.fst W.hom i').base.hom z) = 0
      linear_combination
        (-(c' ((Limits.pullback.snd W.hom i').base.hom z))) * h1' -
        (t ((Limits.pullback.fst W.hom i').base.hom z)) * h2

    have hsm1 := (μ'.val.app (Opposite.op W)).hom.map_smul t
      (1 : C(↥W.left, ULift.{u+1} ℚ_[ℓ]))
    have hsm2 := (((wcSliceRes Y ℓ V).map (wcSuppUnitMap D)).val.app (Opposite.op W)).hom.map_smul t
      ((μ'.val.app (Opposite.op W)).hom (1 : C(↥W.left, ULift.{u+1} ℚ_[ℓ])))
    refine ((congrArg (((wcSliceRes Y ℓ V).map (wcSuppUnitMap D)).val.app (Opposite.op W)).hom
      ((congrArg (μ'.val.app (Opposite.op W)).hom (mul_one t).symm).trans hsm1)).trans
        hsm2).trans ?_

    have hφ : (@id C(↥(Limits.pullback ((wcSliceFunctor Y V).obj W).hom i), ULift.{u+1} ℚ_[ℓ])
        ((D.φ.hom.app (Opposite.op ((wcSliceFunctor Y V).obj W))).hom t)) = 0 := by
      refine (hD ((wcSliceFunctor Y V).obj W) t).trans (ContinuousMap.ext fun z => ?_)
      have hz : W.hom ((Limits.pullback.fst ((wcSliceFunctor Y V).obj W).hom i).base z) ∈
          Set.range i' := by
        apply s5
        refine ⟨(Limits.pullback.snd ((wcSliceFunctor Y V).obj W).hom i).base z, ?_⟩
        have hcond := (congrArg (fun φ => φ.base z)
            (Limits.pullback.condition (f := ((wcSliceFunctor Y V).obj W).hom) (g := i))).symm
        exact hcond
      exact hv _ hz
    calc _ = (@id C(↥(Limits.pullback ((wcSliceFunctor Y V).obj W).hom i), ULift.{u+1} ℚ_[ℓ])
          ((D.φ.hom.app (Opposite.op ((wcSliceFunctor Y V).obj W))).hom t)) *
        (@id C(↥(Limits.pullback ((wcSliceFunctor Y V).obj W).hom i), ULift.{u+1} ℚ_[ℓ])
          ((((wcSliceRes Y ℓ V).map (wcSuppUnitMap D)).val.app (Opposite.op W)).hom
            ((μ'.val.app (Opposite.op W)).hom (1 : C(↥W.left, ULift.{u+1} ℚ_[ℓ]))))) := rfl
      _ = 0 := by rw [hφ, zero_mul]
  have hnat : Df.Φ.map (wcSuppUnitMap D) =
      θ.hom.app _ ≫ (wcSliceRes Y ℓ V).map (wcSuppUnitMap D) ≫ θ.inv.app _ := by
    rw [← Category.assoc, ← θ.hom.naturality, Category.assoc, Iso.hom_inv_id_app,
      Category.comp_id]
  have hK : Limits.kernel.ι (wcSuppUnitMap Di) ≫ Df.μ.inv ≫ Df.Φ.map (wcSuppUnitMap D) = 0 := by
    rw [hnat]
    apply SheafOfModules.hom_ext
    apply PresheafOfModules.hom_ext
    intro W
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro x
    induction W using Opposite.rec with
    | op W =>
    have hk := congrArg (fun φ => (φ.val.app (Opposite.op W)).hom x)
      (Limits.kernel.condition (wcSuppUnitMap Di))
    change ((wcSuppUnitMap Di).val.app (Opposite.op W)).hom
      (((Limits.kernel.ι (wcSuppUnitMap Di)).val.app (Opposite.op W)).hom x) = 0 at hk
    have h1 := hsec (Df.μ.inv ≫ θ.hom.app (SheafOfModules.unit (wcRingSheaf Y ℓ))) W _ hk
    first
      | (change ((Df.μ.inv ≫ θ.hom.app (SheafOfModules.unit (wcRingSheaf Y ℓ)) ≫
            (wcSliceRes Y ℓ V).map (wcSuppUnitMap D) ≫ θ.inv.app (wcSuppObj D)).val.app
              (Opposite.op W)).hom
            (((Limits.kernel.ι (wcSuppUnitMap Di)).val.app (Opposite.op W)).hom x) = 0
         change ((θ.inv.app (wcSuppObj D)).val.app (Opposite.op W)).hom
          ((((wcSliceRes Y ℓ V).map (wcSuppUnitMap D)).val.app (Opposite.op W)).hom
            (((Df.μ.inv ≫ θ.hom.app (SheafOfModules.unit (wcRingSheaf Y ℓ))).val.app
              (Opposite.op W)).hom
              (((Limits.kernel.ι (wcSuppUnitMap Di)).val.app (Opposite.op W)).hom x))) = 0
         rw [h1, map_zero])
      | (simp only [SheafOfModules.comp_val, PresheafOfModules.comp_app, ModuleCat.hom_comp,
          LinearMap.comp_apply] at h1 ⊢
         rw [h1, map_zero]
         rfl)
      | (simp only [SheafOfModules.comp_val, PresheafOfModules.comp_app, ModuleCat.hom_comp,
          LinearMap.comp_apply] at h1 ⊢
         rw [h1, map_zero])
      | simp [h1]
  exact ⟨Abelian.epiDesc (wcSuppUnitMap Di) (Df.μ.inv ≫ Df.Φ.map (wcSuppUnitMap D)) hK,
    Abelian.comp_epiDesc _ _ _⟩

theorem wc_qmbt_pmv_slice_presheaf_extzero (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (V : S.ProEt)
    [(wcSliceFunctor S V).IsContinuous (Scheme.ProEt.topology V.left) (Scheme.ProEt.topology S)] :
    ∃ (Lp : PresheafOfModules.{u+1} (wcRingSheaf V.left ℓ).obj ⥤
        PresheafOfModules.{u+1} (wcRingSheaf S ℓ).obj)
      (adjP : Lp ⊣ PresheafOfModules.pushforward.{u+1} (F := wcSliceFunctor S V)
        (𝟙 (wcRingSheaf V.left ℓ) : wcRingSheaf V.left ℓ ⟶
          ((wcSliceFunctor S V).sheafPushforwardContinuous RingCat.{u+1}
            (Scheme.ProEt.topology V.left) (Scheme.ProEt.topology S)).obj (wcRingSheaf S ℓ)).hom),
      Lp.PreservesMonomorphisms ∧
      (∀ (A : PresheafOfModules.{u+1} (wcRingSheaf V.left ℓ).obj) (X : S.ProEt),
        IsEmpty (X ⟶ V) → Subsingleton ((Lp.obj A).obj (Opposite.op X))) ∧
      (∀ (M : PresheafOfModules.{u+1} (wcRingSheaf S ℓ).obj) (X : S.ProEt),
        Subsingleton (X ⟶ V) → Nonempty (X ⟶ V) →
        Function.Bijective ((adjP.counit.app M).app (Opposite.op X)).hom) :=
by
  classical
  let j := wcSliceFunctor S V
  let RS := (wcRingSheaf S ℓ).obj
  let RT := (wcRingSheaf V.left ℓ).obj
  let φs : wcRingSheaf V.left ℓ ⟶ (j.sheafPushforwardContinuous RingCat.{u+1}
      (Scheme.ProEt.topology V.left) (Scheme.ProEt.topology S)).obj (wcRingSheaf S ℓ) := 𝟙 _
  let Rp := PresheafOfModules.pushforward.{u+1} (F := j) φs.hom

  have key : ∀ (A : PresheafOfModules.{u+1} RT) {Y : S.ProEt} {Z : V.left.ProEt}
      (b b' : Y ⟶ V) (_ : b = b') (m : wcXzObj S V b ⟶ Z) (m' : wcXzObj S V b' ⟶ Z)
      (_ : m.left = m'.left) (x : A.obj (Opposite.op Z)),
      DirectSum.of (fun c : Y ⟶ V => (A.obj (Opposite.op (wcXzObj S V c)) : Type (u+1))) b
        ((A.map m.op).hom x) =
      DirectSum.of (fun c : Y ⟶ V => (A.obj (Opposite.op (wcXzObj S V c)) : Type (u+1))) b'
        ((A.map m'.op).hom x) := by
    intro A Y Z b b' hb m m' hm x
    subst hb
    obtain rfl : m = m' := MorphismProperty.Over.Hom.ext hm
    rfl
  have hof : ∀ (A : PresheafOfModules.{u+1} RT) {X Y : S.ProEt} (g : Y ⟶ X) (a : X ⟶ V)
      (y : A.obj (Opposite.op (wcXzObj S V a))),
      wcXzMap S ℓ V A g
        (DirectSum.of (fun c : X ⟶ V => (A.obj (Opposite.op (wcXzObj S V c)) : Type (u+1))) a y) =
      DirectSum.of (fun c : Y ⟶ V => (A.obj (Opposite.op (wcXzObj S V c)) : Type (u+1))) (g ≫ a)
        ((A.map (wcXzRes S V g a).op).hom y) :=
    fun A X Y g a y => DirectSum.toAddMonoid_of _ _ _
  have hca : ∀ {X : S.ProEt} (a : X ⟶ V), wcXzC S V a ≫ wcXzPt S V (wcXzObj S V a) = a :=
    fun a => MorphismProperty.Over.Hom.ext (by exact Category.id_comp _)
  have hcpt : ∀ W : V.left.ProEt, wcXzC S V (wcXzPt S V W) = 𝟙 _ :=
    fun W => MorphismProperty.Over.Hom.ext rfl

  let sharpApp : ∀ (A : PresheafOfModules.{u+1} RT) (M : PresheafOfModules.{u+1} RS)
      (θ : A ⟶ Rp.obj M) (X : (S.ProEt)ᵒᵖ), wcXzSum S ℓ V A X.unop →+ M.obj X :=
    fun A M θ X => DirectSum.toAddMonoid (fun a =>
      (M.map (wcXzC S V a).op).hom.toAddMonoidHom.comp
        (θ.app (Opposite.op (wcXzObj S V a))).hom.toAddMonoidHom)
  have sharp_of : ∀ (A : PresheafOfModules.{u+1} RT) (M : PresheafOfModules.{u+1} RS)
      (θ : A ⟶ Rp.obj M) (X : (S.ProEt)ᵒᵖ) (a : X.unop ⟶ V)
      (y : A.obj (Opposite.op (wcXzObj S V a))),
      sharpApp A M θ X
        (DirectSum.of (fun c : X.unop ⟶ V => (A.obj (Opposite.op (wcXzObj S V c)) : Type (u+1))) a y) =
      (M.map (wcXzC S V a).op).hom ((θ.app (Opposite.op (wcXzObj S V a))).hom y) :=
    fun A M θ X a y => DirectSum.toAddMonoid_of _ _ _
  let sharpHom : ∀ (A : PresheafOfModules.{u+1} RT) (M : PresheafOfModules.{u+1} RS),
      (A ⟶ Rp.obj M) → (wcXzLp0 S ℓ V A ⟶ M) := fun A M θ =>
    PresheafOfModules.homMk
      { app := fun X => AddCommGrpCat.ofHom (sharpApp A M θ X)
        naturality := fun X Y f => by
          apply AddCommGrpCat.hom_ext
          apply DirectSum.addHom_ext
          intro a y
          show sharpApp A M θ Y (wcXzMap S ℓ V A f.unop (DirectSum.of _ a y)) =
            (M.map f).hom (sharpApp A M θ X (DirectSum.of _ a y))
          have hcc0 : wcXzC S V (f.unop ≫ a) ≫ j.map (wcXzRes S V f.unop a) =
              f.unop ≫ wcXzC S V a :=
            MorphismProperty.Over.Hom.ext
              (by exact (Category.id_comp _).trans (Category.comp_id _).symm)
          have hcc : (j.map (wcXzRes S V f.unop a)).op ≫ (wcXzC S V (f.unop ≫ a)).op =
              (wcXzC S V a).op ≫ f := by
            rw [← op_comp, hcc0, op_comp, Quiver.Hom.op_unop]
          rw [hof]
          refine (sharp_of A M θ Y (f.unop ≫ a) _).trans ?_
          refine Eq.trans ?_ (congrArg (M.map f).hom (sharp_of A M θ X a y)).symm
          refine (congrArg (M.map (wcXzC S V (f.unop ≫ a)).op).hom
            (PresheafOfModules.naturality_apply θ (wcXzRes S V f.unop a).op y)).trans ?_
          refine (PresheafOfModules.map_comp_apply M (j.map (wcXzRes S V f.unop a)).op
            (wcXzC S V (f.unop ≫ a)).op _).symm.trans ?_
          refine Eq.trans ?_ (PresheafOfModules.map_comp_apply M (wcXzC S V a).op f _)
          rw [hcc] }
      (by
        intro X r
        letI := wcXzSMod S ℓ V A X.unop
        show ∀ m : wcXzSum S ℓ V A X.unop, sharpApp A M θ X (r • m) = r • sharpApp A M θ X m
        intro m
        induction m using DirectSum.induction_on with
        | zero => rw [smul_zero, map_zero, smul_zero]
        | of a y =>
          have h2 : (r • DirectSum.of (fun b : X.unop ⟶ V =>
                (A.obj (Opposite.op (wcXzObj S V b)) : Type (u+1))) a y : wcXzSum S ℓ V A X.unop) =
              DirectSum.of (fun b : X.unop ⟶ V =>
                (A.obj (Opposite.op (wcXzObj S V b)) : Type (u+1))) a (r • y) :=
            (DirectSum.of_smul _ _ _ _).symm
          rw [h2, sharp_of, sharp_of]
          have h1 := (θ.app (Opposite.op (wcXzObj S V a))).hom.map_smul r y
          have h3 := PresheafOfModules.map_smul M (wcXzC S V a).op r
            ((θ.app (Opposite.op (wcXzObj S V a))).hom y)
          exact (congrArg (M.map (wcXzC S V a).op).hom h1).trans h3
        | add x y hx hy => rw [smul_add, map_add, map_add, hx, hy, smul_add])

  let flatHom : ∀ (A : PresheafOfModules.{u+1} RT) (M : PresheafOfModules.{u+1} RS),
      (wcXzLp0 S ℓ V A ⟶ M) → (A ⟶ Rp.obj M) := fun A M φ =>
    PresheafOfModules.homMk
      { app := fun W => AddCommGrpCat.ofHom
          ((φ.app (Opposite.op (j.obj W.unop))).hom.toAddMonoidHom.comp
            (DirectSum.of (fun c : j.obj W.unop ⟶ V =>
              (A.obj (Opposite.op (wcXzObj S V c)) : Type (u+1))) (wcXzPt S V W.unop)))
        naturality := fun W1 W2 g => by
          apply AddCommGrpCat.hom_ext
          apply AddMonoidHom.ext
          intro y
          show (φ.app (Opposite.op (j.obj W2.unop))).hom
              (DirectSum.of _ (wcXzPt S V W2.unop) ((A.map g).hom y)) =
            (M.map (j.map g.unop).op).hom ((φ.app (Opposite.op (j.obj W1.unop))).hom
              (DirectSum.of _ (wcXzPt S V W1.unop) y))
          refine Eq.trans ?_ (PresheafOfModules.naturality_apply φ (j.map g.unop).op _)
          refine congrArg (φ.app (Opposite.op (j.obj W2.unop))).hom ?_
          refine Eq.symm ((hof A (j.map g.unop) (wcXzPt S V W1.unop) y).trans ?_)
          have hb : j.map g.unop ≫ wcXzPt S V W1.unop = wcXzPt S V W2.unop :=
            MorphismProperty.Over.Hom.ext (by exact MorphismProperty.Over.w g.unop)
          exact key A (Z := W1.unop) _ _ hb (wcXzRes S V (j.map g.unop) (wcXzPt S V W1.unop))
            g.unop rfl y }
      (by
        intro W r y
        letI := wcXzSMod S ℓ V A (j.obj W.unop)
        exact (congrArg (φ.app (Opposite.op (j.obj W.unop))).hom
          (DirectSum.of_smul _ _ _ _)).trans
          ((φ.app (Opposite.op (j.obj W.unop))).hom.map_smul r _))

  have hmidM : ∀ (M : PresheafOfModules.{u+1} RS) {X : S.ProEt} (m : X ⟶ X), m = 𝟙 X →
      ∀ z : M.obj (Opposite.op X), (M.map m.op).hom z = z := by
    intro M X m hm z
    subst hm
    rw [op_id, ← PresheafOfModules.presheaf_map_apply_coe, M.presheaf.map_id]
    rfl
  have hmidA : ∀ (A : PresheafOfModules.{u+1} RT) {W : V.left.ProEt} (m : W ⟶ W), m = 𝟙 W →
      ∀ z : A.obj (Opposite.op W), (A.map m.op).hom z = z := by
    intro A W m hm z
    subst hm
    rw [op_id, ← PresheafOfModules.presheaf_map_apply_coe, A.presheaf.map_id]
    rfl
  have hcomp : ∀ (A : PresheafOfModules.{u+1} RT) {X : S.ProEt} (a : X ⟶ V)
      (z : A.obj (Opposite.op (wcXzObj S V a))),
      wcXzMap S ℓ V A (wcXzC S V a)
        (DirectSum.of (fun c : j.obj (wcXzObj S V a) ⟶ V =>
          (A.obj (Opposite.op (wcXzObj S V c)) : Type (u+1))) (wcXzPt S V (wcXzObj S V a)) z) =
      DirectSum.of (fun c : X ⟶ V => (A.obj (Opposite.op (wcXzObj S V c)) : Type (u+1))) a z := by
    intro A X a z
    refine (hof A (wcXzC S V a) (wcXzPt S V (wcXzObj S V a)) z).trans ?_
    refine (key A (Z := wcXzObj S V a) _ _ (hca a)
      (wcXzRes S V (wcXzC S V a) (wcXzPt S V (wcXzObj S V a))) (𝟙 (wcXzObj S V a)) rfl z).trans ?_
    exact congrArg _ (hmidA A (𝟙 _) rfl z)

  have hls : ∀ (A : PresheafOfModules.{u+1} RT) (M : PresheafOfModules.{u+1} RS)
      (φ : wcXzLp0 S ℓ V A ⟶ M), sharpHom A M (flatHom A M φ) = φ := by
    intro A M φ
    apply PresheafOfModules.hom_ext
    intro X
    apply ModuleCat.hom_ext
    apply LinearMap.toAddMonoidHom_injective
    apply DirectSum.addHom_ext
    intro a y
    show sharpApp A M (flatHom A M φ) X (DirectSum.of _ a y) = (φ.app X).hom (DirectSum.of _ a y)
    refine (sharp_of A M (flatHom A M φ) X a y).trans ?_
    show (M.map (wcXzC S V a).op).hom ((φ.app (Opposite.op (j.obj (wcXzObj S V a)))).hom
      (DirectSum.of _ (wcXzPt S V (wcXzObj S V a)) y)) = _
    refine (PresheafOfModules.naturality_apply φ (wcXzC S V a).op _).symm.trans ?_
    exact congrArg (φ.app X).hom (hcomp A a y)
  have hrs : ∀ (A : PresheafOfModules.{u+1} RT) (M : PresheafOfModules.{u+1} RS)
      (θ : A ⟶ Rp.obj M), flatHom A M (sharpHom A M θ) = θ := by
    intro A M θ
    apply PresheafOfModules.hom_ext
    intro W
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro y
    show sharpApp A M θ (Opposite.op (j.obj W.unop)) (DirectSum.of _ (wcXzPt S V W.unop) y) =
      (θ.app W).hom y
    refine (sharp_of A M θ (Opposite.op (j.obj W.unop)) (wcXzPt S V W.unop) y).trans ?_
    exact hmidM M (X := j.obj W.unop) (wcXzC S V (wcXzPt S V W.unop)) (hcpt W.unop) _
  let e : ∀ (A : PresheafOfModules.{u+1} RT) (M : PresheafOfModules.{u+1} RS),
      (wcXzLp0 S ℓ V A ⟶ M) ≃ (A ⟶ Rp.obj M) := fun A M =>
    { toFun := flatHom A M
      invFun := sharpHom A M
      left_inv := hls A M
      right_inv := hrs A M }
  have he : ∀ (A : PresheafOfModules.{u+1} RT) (M M' : PresheafOfModules.{u+1} RS)
      (g : M ⟶ M') (h : wcXzLp0 S ℓ V A ⟶ M), e A M' (h ≫ g) = e A M h ≫ Rp.map g := by
    intro A M M' g h
    apply PresheafOfModules.hom_ext
    intro W
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro y
    rfl
  let Lp := Adjunction.leftAdjointOfEquiv (G := Rp) (F_obj := wcXzLp0 S ℓ V) e he
  let adjP : Lp ⊣ Rp := Adjunction.adjunctionOfEquivLeft e he
  haveI hmono : Lp.PreservesMonomorphisms := ⟨fun {A A'} f hf => by
    have hf' := (PresheafOfModules.mono_iff_surjective f).1 hf
    apply PresheafOfModules.mono_of_injective
    intro X
    have hLmap : Lp.map f = sharpHom A (wcXzLp0 S ℓ V A')
        (f ≫ flatHom A' (wcXzLp0 S ℓ V A') (𝟙 _)) :=
      Adjunction.leftAdjointOfEquiv_map e he f
    have hEq : ((Lp.map f).app X).hom.toAddMonoidHom =
        DirectSum.map (fun a : X.unop ⟶ V =>
          (f.app (Opposite.op (wcXzObj S V a))).hom.toAddMonoidHom) := by
      apply DirectSum.addHom_ext
      intro a y
      refine Eq.trans ?_ (DirectSum.map_of (fun a : X.unop ⟶ V =>
          (f.app (Opposite.op (wcXzObj S V a))).hom.toAddMonoidHom) a y).symm
      rw [hLmap]
      show sharpApp A (wcXzLp0 S ℓ V A') (f ≫ flatHom A' (wcXzLp0 S ℓ V A') (𝟙 _)) X
        (DirectSum.of _ a y) = _
      refine (sharp_of A _ _ X a y).trans ?_
      exact hcomp A' a ((f.app (Opposite.op (wcXzObj S V a))).hom y)
    intro x y hxy
    have h2 : (DirectSum.map (fun a : X.unop ⟶ V =>
        (f.app (Opposite.op (wcXzObj S V a))).hom.toAddMonoidHom)) x =
        (DirectSum.map (fun a : X.unop ⟶ V =>
        (f.app (Opposite.op (wcXzObj S V a))).hom.toAddMonoidHom)) y := by
      rw [← hEq]
      exact hxy
    exact (DirectSum.map_injective _).2 (fun a => hf' (X := Opposite.op (wcXzObj S V a))) h2⟩

  have hVan : ∀ (A : PresheafOfModules.{u+1} RT) (X : S.ProEt), IsEmpty (X ⟶ V) →
      Subsingleton ((Lp.obj A).obj (Opposite.op X)) := by
    intro A X _
    exact (show Subsingleton (wcXzSum S ℓ V A X) from
      ⟨fun _x _y => DirectSum.ext (fun i => isEmptyElim i)⟩)

  have hC : ∀ (M : PresheafOfModules.{u+1} RS) (X : S.ProEt) (a : X ⟶ V)
      (y : (Rp.obj M).obj (Opposite.op (wcXzObj S V a))),
      ((adjP.counit.app M).app (Opposite.op X)).hom
        (DirectSum.of (fun c : X ⟶ V =>
          ((Rp.obj M).obj (Opposite.op (wcXzObj S V c)) : Type (u+1))) a y) =
      (M.map (wcXzC S V a).op).hom y := by
    intro M X a y
    show sharpApp (Rp.obj M) M (𝟙 _) (Opposite.op X) (DirectSum.of _ a y) = _
    exact sharp_of (Rp.obj M) M (𝟙 _) (Opposite.op X) a y

  have hBij : ∀ (M : PresheafOfModules.{u+1} RS) (X : S.ProEt),
      Subsingleton (X ⟶ V) → Nonempty (X ⟶ V) →
      Function.Bijective ((adjP.counit.app M).app (Opposite.op X)).hom := by
    intro M X hs hn
    obtain ⟨a₀⟩ := hn
    have hsa : ∀ i : X ⟶ V, i = a₀ := fun i => @Subsingleton.elim _ hs i a₀
    clear hs
    have hG : ∀ x : wcXzSum S ℓ V (Rp.obj M) X,
        x = DirectSum.of (fun c : X ⟶ V =>
          ((Rp.obj M).obj (Opposite.op (wcXzObj S V c)) : Type (u+1))) a₀ (x a₀) := by
      intro x
      refine DirectSum.ext (fun i => ?_)
      obtain rfl : i = a₀ := hsa i
      exact (DirectSum.of_eq_same (β := fun c : X ⟶ V =>
        ((Rp.obj M).obj (Opposite.op (wcXzObj S V c)) : Type (u+1))) i (x i)).symm
    let ι : j.obj (wcXzObj S V a₀) ⟶ X :=
      MorphismProperty.Over.homMk (𝟙 X.left)
        ((Category.id_comp _).trans (MorphismProperty.Over.w a₀).symm) trivial
    have hI1 : ι ≫ wcXzC S V a₀ = 𝟙 _ :=
      MorphismProperty.Over.Hom.ext (Category.comp_id (𝟙 X.left))
    have hI2 : wcXzC S V a₀ ≫ ι = 𝟙 X :=
      MorphismProperty.Over.Hom.ext (Category.comp_id (𝟙 X.left))
    have hM1 : ∀ m : M.obj (Opposite.op X),
        (M.map (wcXzC S V a₀).op).hom ((M.map ι.op).hom m) = m := fun m =>
      (PresheafOfModules.map_comp_apply M ι.op (wcXzC S V a₀).op m).symm.trans
        (hmidM M (wcXzC S V a₀ ≫ ι) hI2 m)
    have hM2 : ∀ y : M.obj (Opposite.op (j.obj (wcXzObj S V a₀))),
        (M.map ι.op).hom ((M.map (wcXzC S V a₀).op).hom y) = y := fun y =>
      (PresheafOfModules.map_comp_apply M (wcXzC S V a₀).op ι.op y).symm.trans
        (hmidM M (X := j.obj (wcXzObj S V a₀)) (ι ≫ wcXzC S V a₀) hI1 y)
    constructor
    · intro (x : wcXzSum S ℓ V (Rp.obj M) X) (x' : wcXzSum S ℓ V (Rp.obj M) X) hxx'
      have e1 : (M.map (wcXzC S V a₀).op).hom (x a₀) =
          (M.map (wcXzC S V a₀).op).hom (x' a₀) := by
        refine (hC M X a₀ (x a₀)).symm.trans ?_
        refine Eq.trans ?_ (hC M X a₀ (x' a₀))
        refine (congrArg ((adjP.counit.app M).app (Opposite.op X)).hom (hG x).symm).trans ?_
        exact hxx'.trans (congrArg ((adjP.counit.app M).app (Opposite.op X)).hom (hG x'))
      have e2 : x a₀ = x' a₀ :=
        (hM2 (x a₀)).symm.trans ((congrArg (M.map ι.op).hom e1).trans (hM2 (x' a₀)))
      exact (hG x).trans ((congrArg (DirectSum.of (fun c : X ⟶ V =>
        ((Rp.obj M).obj (Opposite.op (wcXzObj S V c)) : Type (u+1))) a₀) e2).trans (hG x').symm)
    · intro m
      refine ⟨DirectSum.of (fun c : X ⟶ V =>
        ((Rp.obj M).obj (Opposite.op (wcXzObj S V c)) : Type (u+1))) a₀ ((M.map ι.op).hom m), ?_⟩
      exact (hC M X a₀ _).trans (hM1 m)
  exact ⟨Lp, adjP, hmono, hVan, hBij⟩

theorem wc_qmbt_pmv_sheafify_extzero_transfer : ∀ {C D : Type (u+1)} [Category.{u} C] [Category.{u} D] (J : GrothendieckTopology C)
    (K : GrothendieckTopology D) [HasSheafify K AddCommGrpCat.{u+1}]
    [K.WEqualsLocallyBijective AddCommGrpCat.{u+1}] (F : C ⥤ D) [F.IsContinuous J K]
    (S₀ : Sheaf J RingCat.{u+1}) (R₀ : Sheaf K RingCat.{u+1})
    (φ : S₀ ⟶ (F.sheafPushforwardContinuous RingCat.{u+1} J K).obj R₀)
    (Lp : PresheafOfModules.{u+1} S₀.obj ⥤ PresheafOfModules.{u+1} R₀.obj)
    (adjP : Lp ⊣ PresheafOfModules.pushforward.{u+1} (F := F) φ.hom) (Q : D → Prop),
    Limits.PreservesFiniteLimits Lp →
    (∀ (A : PresheafOfModules.{u+1} S₀.obj) (V : D), ¬ Q V →
      Subsingleton ((Lp.obj A).obj (Opposite.op V))) →
    (∀ (M : PresheafOfModules.{u+1} R₀.obj) (V : D), Q V →
      Function.Bijective ((adjP.counit.app M).app (Opposite.op V)).hom) →
    ∃ (L : SheafOfModules.{u+1} S₀ ⥤ SheafOfModules.{u+1} R₀)
      (adj : L ⊣ SheafOfModules.pushforward.{u+1} φ),
      Limits.PreservesFiniteLimits L ∧
      (∀ M : SheafOfModules.{u+1} R₀, Mono (adj.counit.app M)) ∧
      (∀ (N : SheafOfModules.{u+1} S₀) (V : D)
          (s : ((SheafOfModules.toSheaf R₀).obj (L.obj N)).obj.obj (Opposite.op V)),
        Sieve.generate (fun (V' : D) (g : V' ⟶ V) =>
          ((SheafOfModules.toSheaf R₀).obj (L.obj N)).obj.map g.op s = 0 ∨ Q V') ∈ K V) ∧
      (∀ M : SheafOfModules.{u+1} R₀,
        (∀ (V : D) (s : ((SheafOfModules.toSheaf R₀).obj M).obj.obj (Opposite.op V)),
          Sieve.generate (fun (V' : D) (g : V' ⟶ V) =>
            ((SheafOfModules.toSheaf R₀).obj M).obj.map g.op s = 0 ∨ Q V') ∈ K V) →
        Epi (adj.counit.app M)) ∧
      (∀ (M : SheafOfModules.{u+1} R₀) (V : D), Q V →
        Function.Surjective ((((SheafOfModules.toSheaf R₀).map (adj.counit.app M)).hom.app
          (Opposite.op V)).hom)) :=
by
  intro C D _ _ J K _ _ F _ S₀ R₀ φ Lp adjP Q hfl hvan hbij
  let Sh := PresheafOfModules.sheafification.{u+1} (𝟙 R₀.obj)
  let sa := PresheafOfModules.sheafificationAdjunction.{u+1} (𝟙 R₀.obj)
  let G' := SheafOfModules.forget R₀ ⋙ PresheafOfModules.restrictScalars.{u+1} (𝟙 R₀.obj)
  let L := SheafOfModules.forget S₀ ⋙ Lp ⋙ Sh
  let adj := Adjunction.restrictFullyFaithful
    (iC := SheafOfModules.forget S₀) (iD := 𝟭 (SheafOfModules.{u+1} R₀))
    (L := L) (R := SheafOfModules.pushforward.{u+1} φ)
    (adjP.comp sa) (SheafOfModules.fullyFaithfulForget _) (Functor.FullyFaithful.id _)
    (Iso.refl _) (Iso.refl _)

  have hcounit : ∀ M : SheafOfModules.{u+1} R₀, adj.counit.app M =
      Sh.map (adjP.counit.app (G'.obj M)) ≫ sa.counit.app M := by
    intro M
    have h := Adjunction.map_restrictFullyFaithful_counit_app
      (adjP.comp sa) (SheafOfModules.fullyFaithfulForget S₀) (Functor.FullyFaithful.id _)
      (L := L) (R := SheafOfModules.pushforward.{u+1} φ) (Iso.refl _) (Iso.refl _) M
    simp only [Functor.id_map, Iso.refl_inv, NatTrans.id_app,
      Adjunction.comp_counit_app] at h
    refine h.trans ?_
    erw [CategoryTheory.Functor.map_id, Category.id_comp, Category.id_comp]

  have hstar : ∀ M : SheafOfModules.{u+1} R₀,
      sa.unit.app (Lp.obj ((SheafOfModules.forget S₀).obj ((SheafOfModules.pushforward φ).obj M)))
        ≫ G'.map (adj.counit.app M) = adjP.counit.app (G'.obj M) := by
    intro M
    rw [hcounit M]
    erw [Functor.map_comp]
    rw [← Category.assoc]
    erw [sa.unit_naturality (adjP.counit.app (G'.obj M))]
    refine (Category.assoc _ _ _).trans ?_
    erw [sa.right_triangle_components M]
    exact Category.comp_id _

  have hsurj : ∀ (M : SheafOfModules.{u+1} R₀) (V : D), Q V →
      Function.Surjective ((((SheafOfModules.toSheaf R₀).map (adj.counit.app M)).hom.app
        (Opposite.op V)).hom) := by
    intro M V hV m
    obtain ⟨t, ht⟩ := (hbij (G'.obj M) V hV).2 m
    refine ⟨((sa.unit.app (Lp.obj ((SheafOfModules.forget S₀).obj
      ((SheafOfModules.pushforward φ).obj M)))).app (Opposite.op V)).hom t, ?_⟩
    have h2 := ConcreteCategory.congr_hom
      (congrArg (fun f => PresheafOfModules.Hom.app f (Opposite.op V)) (hstar M)) t
    refine Eq.trans ?_ (h2.trans ht)
    rfl
  refine ⟨L, adj, ?_, ?_, ?_, ?_, hsurj⟩
  · haveI := hfl
    show Limits.PreservesFiniteLimits (SheafOfModules.forget S₀ ⋙ Lp ⋙ Sh)
    haveI : Limits.PreservesFiniteLimits (Lp ⋙ Sh) := Limits.comp_preservesFiniteLimits _ _
    exact Limits.comp_preservesFiniteLimits _ _
  · intro M
    rw [hcounit M]
    haveI : Mono (adjP.counit.app (G'.obj M)) := PresheafOfModules.mono_of_injective (fun X => by
      by_cases hX : Q X.unop
      · exact (hbij _ X.unop hX).1
      · exact @Function.injective_of_subsingleton _ _ (hvan _ X.unop hX) _)
    exact @mono_comp _ _ _ _ _ _ (Functor.map_mono Sh _) _ (IsIso.mono_of_iso (sa.counit.app M))
  · intro N V s
    let P := Lp.obj ((SheafOfModules.forget S₀).obj N)
    let τ := (PresheafOfModules.toPresheaf R₀.obj).map (sa.unit.app P)
    have hτ : τ = toSheafify K P.presheaf :=
      PresheafOfModules.toPresheaf_map_sheafificationAdjunction_unit_app (𝟙 R₀.obj) P
    haveI : Presheaf.IsLocallySurjective K τ := by
      rw [hτ]
      exact GrothendieckTopology.instIsLocallySurjectiveToSheafify (J := K)
        (A := AddCommGrpCat.{u+1}) _
    have hI : Presheaf.imageSieve τ s ∈ K V := Presheaf.imageSieve_mem K τ s
    refine K.superset_covering ?_ hI
    intro V' g hg
    obtain ⟨t, ht⟩ := hg
    apply Sieve.le_generate
    by_cases hQ : Q V'
    · exact Or.inr hQ
    · left
      have hss := hvan ((SheafOfModules.forget S₀).obj N) V' hQ
      have : t = 0 := @Subsingleton.elim _ hss _ _
      subst this
      rw [map_zero] at ht
      exact ht.symm
  · intro M hM
    have hls : Sheaf.IsLocallySurjective ((SheafOfModules.toSheaf R₀).map (adj.counit.app M)) := by
      constructor
      intro U s
      refine K.superset_covering ?_ (hM _ s)
      rw [Sieve.generate_le_iff]
      intro V' g hg
      rcases hg with h0 | hQ
      · exact ⟨0, by rw [map_zero]; exact h0.symm⟩
      · obtain ⟨t, ht⟩ := hsurj M V' hQ (((SheafOfModules.toSheaf R₀).obj M).obj.map g.op s)
        exact ⟨t, ht⟩
    exact Functor.epi_of_epi_map (SheafOfModules.toSheaf R₀) (Sheaf.epi_of_isLocallySurjective _)

theorem wc_qmbt_pmv_open_extzero_package {Y A : Scheme.{u}} (j : A ⟶ Y) [IsOpenImmersion j]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (E : wcHMPullData j ℓ) (hE : wcHMPullCanonical E) :
    ∃ (L : SheafOfModules.{u+1} (wcRingSheaf A ℓ) ⥤ SheafOfModules.{u+1} (wcRingSheaf Y ℓ))
      (adj : L ⊣ E.Φ),
      Limits.PreservesFiniteLimits L ∧
      (∀ K : SheafOfModules.{u+1} (wcRingSheaf Y ℓ), Mono (adj.counit.app K)) ∧
      (∀ N : SheafOfModules.{u+1} (wcRingSheaf A ℓ), wcPSuppIn Y ℓ (Set.range j) (L.obj N)) ∧
      (∀ K : SheafOfModules.{u+1} (wcRingSheaf Y ℓ), wcPSuppIn Y ℓ (Set.range j) K →
        Epi (adj.counit.app K)) ∧
      (∀ (K : SheafOfModules.{u+1} (wcRingSheaf Y ℓ)) (W : Y.ProEt),
        (∀ x : ↥W.left, W.hom x ∈ Set.range j) →
        Function.Surjective ((((SheafOfModules.toSheaf (wcRingSheaf Y ℓ)).map
          (adj.counit.app K)).hom.app (Opposite.op W)).hom)) :=
by
  classical

  obtain ⟨hc, -, -⟩ := wc_lpsc_site Y (Scheme.ProEt.mk j)
  haveI := hc
  obtain ⟨θ⟩ := wc_hm_pull_Phi_slice_iso Y ℓ (Scheme.ProEt.mk j) E hE
  obtain ⟨Lp, adjP, hmonoP, hvanP, hbijP⟩ :=
    wc_qmbt_pmv_slice_presheaf_extzero Y ℓ (Scheme.ProEt.mk j)
  haveI := hmonoP

  have s4 : ∀ W : Y.ProEt, Subsingleton (W ⟶ Scheme.ProEt.mk j) ∧
      ((∀ x : ↥W.left, W.hom x ∈ Set.range j) ↔ Nonempty (W ⟶ Scheme.ProEt.mk j)) := by
    intro W
    refine ⟨⟨fun f g => ?_⟩, ⟨fun h => ?_, fun hf x => ?_⟩⟩
    · apply MorphismProperty.Over.Hom.ext
      have h1 : f.left ≫ j = g.left ≫ j :=
        (MorphismProperty.Over.w f).trans (MorphismProperty.Over.w g).symm
      exact (cancel_mono j).1 h1
    · have hr : Set.range W.hom ⊆ Set.range j := by
        rintro _ ⟨x, rfl⟩
        exact h x
      exact ⟨MorphismProperty.Over.homMk (@IsOpenImmersion.lift _ _ _ j W.hom ‹_› hr)
        (@IsOpenImmersion.lift_fac _ _ _ j W.hom ‹_› hr) trivial⟩
    · obtain ⟨f⟩ := hf
      refine ⟨f.left x, ?_⟩
      have hw : f.left ≫ j = W.hom := MorphismProperty.Over.w f
      exact (Scheme.Hom.comp_apply f.left j x).symm.trans
        (congrArg (fun φ : W.left ⟶ Y => φ x) hw)

  have flP : Limits.PreservesFiniteLimits Lp := by
    haveI := adjP.leftAdjoint_preservesColimits
    haveI := adjP.isLeftAdjoint
    haveI := Functor.preservesZeroMorphisms_of_isLeftAdjoint Lp
    haveI := Limits.preservesBinaryBiproducts_of_preservesBinaryCoproducts Lp
    haveI : Lp.Additive := Functor.additive_of_preservesBinaryBiproducts Lp
    haveI : Limits.PreservesFiniteColimits Lp := inferInstance
    rw [Functor.preservesFiniteLimits_iff_forall_exact_map_and_mono]
    intro S hS
    haveI := hS.mono_f
    exact ⟨((Functor.preservesFiniteColimits_iff_forall_exact_map_and_epi Lp).1 inferInstance
      S hS).1, Functor.map_mono Lp S.f⟩

  have van : ∀ (A' : PresheafOfModules.{u+1} (wcRingSheaf (Scheme.ProEt.mk j : Y.ProEt).left ℓ).obj)
      (W : Y.ProEt), ¬ (∀ x : ↥W.left, W.hom x ∈ Set.range j) →
      Subsingleton ((Lp.obj A').obj (Opposite.op W)) := by
    intro A' W hQ
    exact hvanP A' W ⟨fun f => hQ ((s4 W).2.2 ⟨f⟩)⟩
  have bij : ∀ (M : PresheafOfModules.{u+1} (wcRingSheaf Y ℓ).obj) (W : Y.ProEt),
      (∀ x : ↥W.left, W.hom x ∈ Set.range j) →
      Function.Bijective ((adjP.counit.app M).app (Opposite.op W)).hom := by
    intro M W hQ
    exact hbijP M W (s4 W).1 ((s4 W).2.1 hQ)

  obtain ⟨L, adj', fl, mono', supp', epi', surj'⟩ := wc_qmbt_pmv_sheafify_extzero_transfer
    (Scheme.ProEt.topology (Scheme.ProEt.mk j : Y.ProEt).left) (Scheme.ProEt.topology Y)
    (wcSliceFunctor Y (Scheme.ProEt.mk j))
    (wcRingSheaf (Scheme.ProEt.mk j : Y.ProEt).left ℓ) (wcRingSheaf Y ℓ)
    (𝟙 (wcRingSheaf (Scheme.ProEt.mk j : Y.ProEt).left ℓ) :
      wcRingSheaf (Scheme.ProEt.mk j : Y.ProEt).left ℓ ⟶
        ((wcSliceFunctor Y (Scheme.ProEt.mk j)).sheafPushforwardContinuous RingCat.{u+1}
          (Scheme.ProEt.topology (Scheme.ProEt.mk j : Y.ProEt).left)
          (Scheme.ProEt.topology Y)).obj (wcRingSheaf Y ℓ))
    Lp adjP (fun W : Y.ProEt => ∀ x : ↥W.left, W.hom x ∈ Set.range j) flP van bij

  let adj : L ⊣ E.Φ := (adj' : L ⊣ wcSliceRes Y ℓ (Scheme.ProEt.mk j)).ofNatIsoRight θ.symm
  have hcounit : ∀ K : SheafOfModules.{u+1} (wcRingSheaf Y ℓ),
      adj.counit.app K = L.map (θ.hom.app K) ≫ adj'.counit.app K := by
    intro K
    simp only [adj, Adjunction.ofNatIsoRight, Adjunction.mkOfHomEquiv_counit_app,
      Equiv.symm_trans_apply, Adjunction.equivHomsetRightOfNatIso_symm_apply, Category.id_comp,
      Adjunction.homEquiv_counit, Iso.symm_inv]
    rfl
  have hiso : ∀ K : SheafOfModules.{u+1} (wcRingSheaf Y ℓ), IsIso (L.map (θ.hom.app K)) :=
    fun K => (L.mapIso (θ.app K)).isIso_hom
  refine ⟨L, adj, fl, ?_, ?_, ?_, ?_⟩
  · intro K
    rw [hcounit K]
    exact @mono_comp _ _ _ _ _ _ (@IsIso.mono_of_iso _ _ _ _ _ (hiso K)) _ (mono' K)
  · intro N
    exact supp' N
  · intro K hK
    rw [hcounit K]
    exact @epi_comp _ _ _ _ _ _ (@IsIso.epi_of_iso _ _ _ _ _ (hiso K)) _ (epi' K hK)
  · intro K W hW
    let I := (SheafOfModules.toSheaf (wcRingSheaf Y ℓ)).mapIso (L.mapIso (θ.app K))
    have key : (SheafOfModules.toSheaf (wcRingSheaf Y ℓ)).map (adj.counit.app K) =
        I.hom ≫ (SheafOfModules.toSheaf (wcRingSheaf Y ℓ)).map (adj'.counit.app K) :=
      (congrArg (SheafOfModules.toSheaf (wcRingSheaf Y ℓ)).map (hcounit K)).trans
        ((SheafOfModules.toSheaf (wcRingSheaf Y ℓ)).map_comp _ _)
    intro y
    obtain ⟨z, hz⟩ := surj' K W hW y
    refine ⟨(I.inv.hom.app (Opposite.op W)).hom z, ?_⟩
    have e1 := congrArg (fun φ => (φ.hom.app (Opposite.op W)).hom
      ((I.inv.hom.app (Opposite.op W)).hom z)) key
    have e2 := congrArg (fun φ => (φ.hom.app (Opposite.op W)).hom z) I.inv_hom_id
    refine e1.trans ?_
    refine Eq.trans ?_ hz
    exact congrArg ((((SheafOfModules.toSheaf (wcRingSheaf Y ℓ)).map
      (adj'.counit.app K)).hom.app (Opposite.op W)).hom) e2

theorem wc_qmbt_pmv_desc_epi_of_cover {Y A B : Scheme.{u}} (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (jA : A ⟶ Y) (jB : B ⟶ Y) [IsOpenImmersion jA] [IsOpenImmersion jB]
    (hjs : ∀ y : Y, y ∈ Set.range jA ∨ y ∈ Set.range jB)
    (N K₁ K₂ : SheafOfModules.{u+1} (wcRingSheaf Y ℓ)) (c₁ : K₁ ⟶ N) (c₂ : K₂ ⟶ N)
    (h₁ : ∀ W : Y.ProEt, (∀ x : ↥W.left, W.hom x ∈ Set.range jA) →
      Function.Surjective ((((SheafOfModules.toSheaf (wcRingSheaf Y ℓ)).map c₁).hom.app
        (Opposite.op W)).hom))
    (h₂ : ∀ W : Y.ProEt, (∀ x : ↥W.left, W.hom x ∈ Set.range jB) →
      Function.Surjective ((((SheafOfModules.toSheaf (wcRingSheaf Y ℓ)).map c₂).hom.app
        (Opposite.op W)).hom)) :
    Epi (Limits.biprod.desc c₁ c₂) :=
by
  apply Preadditive.epi_of_cancel_zero
  intro P h hh
  have h1 : c₁ ≫ h = 0 := by
    rw [← Limits.biprod.inl_desc c₁ c₂, Category.assoc, hh, Limits.comp_zero]
  have h2 : c₂ ≫ h = 0 := by
    rw [← Limits.biprod.inr_desc c₁ c₂, Category.assoc, hh, Limits.comp_zero]
  set T := SheafOfModules.toSheaf (wcRingSheaf Y ℓ) with hT
  have hF1 : T.map c₁ ≫ T.map h = 0 := by rw [← T.map_comp, h1, T.map_zero]
  have hF2 : T.map c₂ ≫ T.map h = 0 := by rw [← T.map_comp, h2, T.map_zero]
  have z1 : ∀ (V' : Y.ProEt) (t : (T.obj K₁).obj.obj (Opposite.op V')),
      ((T.map h).hom.app (Opposite.op V')).hom
        (((T.map c₁).hom.app (Opposite.op V')).hom t) = 0 := by
    intro V' t
    have e : ((T.map h).hom.app (Opposite.op V')).hom
        (((T.map c₁).hom.app (Opposite.op V')).hom t) =
        ((T.map c₁ ≫ T.map h).hom.app (Opposite.op V')).hom t := rfl
    rw [e, hF1]
    rfl
  have z2 : ∀ (V' : Y.ProEt) (t : (T.obj K₂).obj.obj (Opposite.op V')),
      ((T.map h).hom.app (Opposite.op V')).hom
        (((T.map c₂).hom.app (Opposite.op V')).hom t) = 0 := by
    intro V' t
    have e : ((T.map h).hom.app (Opposite.op V')).hom
        (((T.map c₂).hom.app (Opposite.op V')).hom t) =
        ((T.map c₂ ≫ T.map h).hom.app (Opposite.op V')).hom t := rfl
    rw [e, hF2]
    rfl


  have hcov : ∀ (Q : Y.ProEt) (n : ℕ) (Wf : Fin n → Y.ProEt) (hf : ∀ k, Wf k ⟶ Q),
      (∀ k, IsOpenMap ⇑(hf k).left) → (∀ x : ↥Q.left, ∃ k, x ∈ Set.range ⇑(hf k).left) →
      Sieve.generate (Presieve.ofArrows Wf hf) ∈ Scheme.ProEt.topology Y Q := by
    intro Q n Wf hf hO hJ
    have hs : ∀ x : Q.left, ∃ j y, (hf j).left y = x := by
      intro x; obtain ⟨j, y, hy⟩ := hJ x; exact ⟨j, y, hy⟩
    have hw : ∀ i, WeaklyEtale (hf i).left := fun i => by
      have h1 : WeaklyEtale ((hf i).left ≫ Q.hom) := by
        rw [MorphismProperty.Over.w (hf i)]; exact (Wf i).prop
      exact @WeaklyEtale.of_comp _ _ _ (hf i).left Q.hom h1 Q.prop
    have H : Presieve.ofArrows (fun i => (Wf i).left) (fun i => (hf i).left) ∈
        Scheme.proetalePrecoverage.coverings Q.left :=
      ⟨Scheme.presieve₀_mem_qcPrecoverage_iff.mpr (QuasiCompactCover.of_isOpenMap
        (𝒰 := Scheme.Cover.mkOfCovers (P := ⊤) (Fin n) (fun i => (Wf i).left)
          (fun i => (hf i).left) hs (fun _ => trivial)) (fun i => hO i)),
        (Scheme.ofArrows_mem_precoverage_iff @WeaklyEtale).mpr
          ⟨fun x => by obtain ⟨j, y, hy⟩ := hs x; exact ⟨j, y, hy⟩, hw⟩⟩
    exact Precoverage.generate_mem_toGrothendieck
      (Precoverage.mem_comap_iff.mpr (by rw [Presieve.map_ofArrows]; exact H))
  apply T.map_injective
  rw [T.map_zero]
  apply Sheaf.hom_ext
  apply NatTrans.ext
  funext V
  obtain ⟨W⟩ := V
  apply AddCommGrpCat.ext
  intro s
  suffices key : ConcreteCategory.hom ((T.map h).hom.app (Opposite.op W)) s = 0 by
    rw [key]
    rfl
  haveI : WeaklyEtale W.hom := W.prop
  let OA : W.left.Opens := W.hom ⁻¹ᵁ jA.opensRange
  let OB : W.left.Opens := W.hom ⁻¹ᵁ jB.opensRange
  have memA : ∀ x : W.left, x ∈ OA ↔ W.hom x ∈ Set.range jA := by
    intro x
    rw [Scheme.Hom.mem_preimage, ← SetLike.mem_coe, Scheme.Hom.coe_opensRange]
  have memB : ∀ x : W.left, x ∈ OB ↔ W.hom x ∈ Set.range jB := by
    intro x
    rw [Scheme.Hom.mem_preimage, ← SetLike.mem_coe, Scheme.Hom.coe_opensRange]
  let O : Fin 2 → W.left.Opens := ![OA, OB]
  let Wk : Fin 2 → Y.ProEt := fun k =>
    MorphismProperty.Over.mk ⊤ ((O k).ι ≫ W.hom) inferInstance
  let hk : ∀ k, Wk k ⟶ W := fun k => MorphismProperty.Over.homMk (O k).ι rfl trivial
  have hcov0 : Sieve.generate (Presieve.ofArrows Wk hk) ∈ Scheme.ProEt.topology Y W := by
    refine hcov W 2 Wk hk (fun k => (O k).ι.isOpenEmbedding.isOpenMap) ?_
    intro x
    rcases hjs (W.hom x) with hx | hx
    · exact ⟨0, ⟨⟨x, (memA x).mpr hx⟩, Scheme.Opens.ι_apply _ _⟩⟩
    · exact ⟨1, ⟨⟨x, (memB x).mpr hx⟩, Scheme.Opens.ι_apply _ _⟩⟩
  let S : Sieve W :=
    { arrows := fun W' _ => (∀ x, W'.hom x ∈ Set.range jA) ∨ (∀ x, W'.hom x ∈ Set.range jB)
      downward_closed := by
        intro W' W'' g hg k
        have hw : k.left ≫ W'.hom = W''.hom := MorphismProperty.Over.w k
        rcases hg with hg | hg
        · left
          intro x
          rw [← hw, Scheme.Hom.comp_apply]
          exact hg _
        · right
          intro x
          rw [← hw, Scheme.Hom.comp_apply]
          exact hg _ }
  have hS : S ∈ Scheme.ProEt.topology Y W := by
    refine GrothendieckTopology.superset_covering _ ?_ hcov0
    rw [Sieve.generate_le_iff]
    rintro _ _ ⟨k⟩
    fin_cases k
    · left
      intro y
      let y' : OA := y
      have e : (OA.ι ≫ W.hom) y' = W.hom y'.1 :=
        (Scheme.Hom.comp_apply OA.ι W.hom y').trans
          (congrArg W.hom (Scheme.Opens.ι_apply OA y'))
      have h3 : (OA.ι ≫ W.hom) y' ∈ Set.range jA := e ▸ (memA y'.1).mp y'.2
      exact h3
    · right
      intro y
      let y' : OB := y
      have e : (OB.ι ≫ W.hom) y' = W.hom y'.1 :=
        (Scheme.Hom.comp_apply OB.ι W.hom y').trans
          (congrArg W.hom (Scheme.Opens.ι_apply OB y'))
      have h3 : (OB.ι ≫ W.hom) y' ∈ Set.range jB := e ▸ (memB y'.1).mp y'.2
      exact h3
  refine Sheaf.isSeparated (T.obj P) W S hS _ 0 ?_
  intro W' g hg
  rw [map_zero, ← NatTrans.naturality_apply (T.map h).hom g.op s]
  rcases hg with hg | hg
  · obtain ⟨t, ht⟩ := h₁ W' hg (ConcreteCategory.hom ((T.obj N).obj.map g.op) s)
    have := z1 W' t
    rw [ht] at this
    exact this
  · obtain ⟨t, ht⟩ := h₂ W' hg (ConcreteCategory.hom ((T.obj N).obj.map g.op) s)
    have := z2 W' t
    rw [ht] at this
    exact this

theorem wc_qmbt_pmv_supp_calculus (Y : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (S S' : Set Y)
    (F G : SheafOfModules.{u+1} (wcRingSheaf Y ℓ)) :
    (wcPSuppIn Y ℓ S F → S ⊆ S' → wcPSuppIn Y ℓ S' F) ∧
    (∀ m : G ⟶ F, Mono m → wcPSuppIn Y ℓ S F → wcPSuppIn Y ℓ S G) ∧
    (wcPSuppIn Y ℓ S F → wcPSuppIn Y ℓ S' F → wcPSuppIn Y ℓ (S ∩ S') F) :=
by
  unfold wcPSuppIn
  refine ⟨?_, ?_, ?_⟩
  · intro hF hSS' V s
    refine (Scheme.ProEt.topology Y).superset_covering ?_ (hF V s)
    apply Sieve.generate_mono
    intro V' g hg
    rcases hg with h0 | hland
    · exact Or.inl h0
    · exact Or.inr (fun x => hSS' (hland x))
  · intro m hm hF V s
    have hmono : Mono ((SheafOfModules.toSheaf (wcRingSheaf Y ℓ)).map m) :=
      Functor.map_mono _ m
    have hmono2 : Mono ((SheafOfModules.toSheaf (wcRingSheaf Y ℓ)).map m).hom :=
      (Sheaf.Hom.mono_iff_presheaf_mono _ _ _).mp hmono
    have hinj := fun V' : Y.ProEt => (AddCommGrpCat.mono_iff_injective _).mp
      ((NatTrans.mono_iff_mono_app _).mp hmono2 (Opposite.op V'))
    refine (Scheme.ProEt.topology Y).superset_covering ?_
      (hF V (((SheafOfModules.toSheaf (wcRingSheaf Y ℓ)).map m).hom.app (Opposite.op V) s))
    apply Sieve.generate_mono
    intro V' g hg
    rcases hg with h0 | hland
    · left
      apply hinj V'
      have hnat := NatTrans.naturality_apply
        ((SheafOfModules.toSheaf (wcRingSheaf Y ℓ)).map m).hom g.op s
      rw [hnat, map_zero]
      exact h0
    · exact Or.inr hland
  · intro h1 h2 V s
    refine (Scheme.ProEt.topology Y).superset_covering ?_
      ((Scheme.ProEt.topology Y).intersection_covering (h1 V s) (h2 V s))
    intro V'' g hg
    rw [Sieve.inter_apply] at hg
    obtain ⟨hA, hB⟩ := hg
    rw [Sieve.generate_apply] at hA hB
    obtain ⟨V1, k1, g1, hg1, e1⟩ := hA
    obtain ⟨V2, k2, g2, hg2, e2⟩ := hB
    apply Sieve.le_generate
    rcases hg1 with h0 | hl1
    · left
      subst e1
      rw [op_comp, Functor.map_comp, ConcreteCategory.comp_apply, h0, map_zero]
    · rcases hg2 with h0 | hl2
      · left
        subst e2
        rw [op_comp, Functor.map_comp, ConcreteCategory.comp_apply, h0, map_zero]
      · right
        intro x
        have hx1 : V''.hom x = V1.hom (k1.left x) := by
          rw [← Scheme.Hom.comp_apply, MorphismProperty.Over.w k1]
        have hx2 : V''.hom x = V2.hom (k2.left x) := by
          rw [← Scheme.Hom.comp_apply, MorphismProperty.Over.w k2]
        refine ⟨?_, ?_⟩
        · rw [hx1]; exact hl1 _
        · rw [hx2]; exact hl2 _

theorem wc_qmbt_pmv_open_gamma_iso {X Z U ZU : Scheme.{u}} {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (j : U ⟶ X) [IsOpenImmersion j] (i : Z ⟶ X) [IsClosedImmersion i] (iU : ZU ⟶ U)
    (gU : ZU ⟶ Z) (hsq : IsPullback gU iU i j)
    (D : wcHMPullData i ℓ) (hD : wcHMPullCanonical D) (eD : Epi (wcSuppUnitMap D))
    (DU : wcHMPullData iU ℓ) (hDU : wcHMPullCanonical DU) (eDU : Epi (wcSuppUnitMap DU))
    (E : wcHMPullData j ℓ) (hE : wcHMPullCanonical E)
    (γ : wcSuppObj DU ⟶ E.Φ.obj (wcSuppObj D))
    (hγ : wcSuppUnitMap DU ≫ γ = E.μ.inv ≫ E.Φ.map (wcSuppUnitMap D)) :
    IsIso γ :=
by
  classical
  haveI := eD
  haveI := eDU
  haveI := E.presColim
  haveI := E.additive
  haveI : Epi (E.Φ.map (wcSuppUnitMap D)) := inferInstance
  haveI : Epi (E.μ.inv ≫ E.Φ.map (wcSuppUnitMap D)) := epi_comp _ _

  have hk : Limits.kernel.ι (E.μ.inv ≫ E.Φ.map (wcSuppUnitMap D)) ≫ wcSuppUnitMap DU = 0 := by
    let V : X.ProEt := MorphismProperty.Over.mk ⊤ j inferInstance
    obtain ⟨hc, -, -⟩ := wc_lpsc_site X V
    haveI := hc
    obtain ⟨θ⟩ := wc_hm_pull_Phi_slice_iso X ℓ V E hE
    have hnat : E.Φ.map (wcSuppUnitMap D) =
        θ.hom.app _ ≫ (wcSliceRes X ℓ V).map (wcSuppUnitMap D) ≫ θ.inv.app _ := by
      rw [← Category.assoc, ← θ.hom.naturality, Category.assoc, Iso.hom_inv_id_app,
        Category.comp_id]
    obtain ⟨μ', hμ'⟩ : ∃ μ' : SheafOfModules.unit (wcRingSheaf U ℓ) ⟶
        (wcSliceRes X ℓ V).obj (SheafOfModules.unit (wcRingSheaf X ℓ)),
        μ' = E.μ.inv ≫ θ.hom.app (SheafOfModules.unit (wcRingSheaf X ℓ)) := ⟨_, rfl⟩
    obtain ⟨ν, hν⟩ : ∃ ν : (wcSliceRes X ℓ V).obj (SheafOfModules.unit (wcRingSheaf X ℓ)) ⟶
        SheafOfModules.unit (wcRingSheaf U ℓ),
        ν = θ.inv.app (SheafOfModules.unit (wcRingSheaf X ℓ)) ≫ E.μ.hom := ⟨_, rfl⟩
    have hμν : μ' ≫ ν = 𝟙 _ := by
      rw [hμ', hν]
      first
        | (rw [Category.assoc, ← Category.assoc (θ.hom.app _), Iso.hom_inv_id_app,
            Category.id_comp, Iso.inv_hom_id])
        | (erw [Category.assoc, ← Category.assoc (θ.hom.app _), Iso.hom_inv_id_app,
            Category.id_comp, Iso.inv_hom_id])
    have hρ : E.μ.inv ≫ E.Φ.map (wcSuppUnitMap D) =
        μ' ≫ (wcSliceRes X ℓ V).map (wcSuppUnitMap D) ≫ θ.inv.app (wcSuppObj D) := by
      rw [hμ', hnat]
      exact (Category.assoc _ _ _).symm
    have hsec : ∀ (W : U.ProEt) (t : C(↥W.left, ULift.{u+1} ℚ_[ℓ])),
        ((E.μ.inv ≫ E.Φ.map (wcSuppUnitMap D)).val.app (Opposite.op W)).hom t = 0 →
        ((wcSuppUnitMap DU).val.app (Opposite.op W)).hom t = 0 := by
      intro W t h0
      rw [hρ] at h0
      have h0' : ((θ.inv.app (wcSuppObj D)).val.app (Opposite.op W)).hom
          ((((wcSliceRes X ℓ V).map (wcSuppUnitMap D)).val.app (Opposite.op W)).hom
            ((μ'.val.app (Opposite.op W)).hom t)) = 0 := h0

      have hy : (((wcSliceRes X ℓ V).map (wcSuppUnitMap D)).val.app (Opposite.op W)).hom
          ((μ'.val.app (Opposite.op W)).hom t) = 0 := by
        have e : ((θ.inv.app (wcSuppObj D) ≫ θ.hom.app (wcSuppObj D)).val.app
            (Opposite.op W)).hom
            ((((wcSliceRes X ℓ V).map (wcSuppUnitMap D)).val.app (Opposite.op W)).hom
              ((μ'.val.app (Opposite.op W)).hom t)) =
            (((wcSliceRes X ℓ V).map (wcSuppUnitMap D)).val.app (Opposite.op W)).hom
              ((μ'.val.app (Opposite.op W)).hom t) := by
          rw [Iso.inv_hom_id_app]
          rfl
        refine e.symm.trans ?_
        show ((θ.hom.app (wcSuppObj D)).val.app (Opposite.op W)).hom
          (((θ.inv.app (wcSuppObj D)).val.app (Opposite.op W)).hom
            ((((wcSliceRes X ℓ V).map (wcSuppUnitMap D)).val.app (Opposite.op W)).hom
              ((μ'.val.app (Opposite.op W)).hom t))) = 0
        rw [h0', map_zero]

      obtain ⟨c, hcdef⟩ : ∃ c : C(↥W.left, ULift.{u+1} ℚ_[ℓ]),
          (μ'.val.app (Opposite.op W)).hom (1 : C(↥W.left, ULift.{u+1} ℚ_[ℓ])) = c := ⟨_, rfl⟩
      obtain ⟨d, hddef⟩ : ∃ d : C(↥W.left, ULift.{u+1} ℚ_[ℓ]),
          (ν.val.app (Opposite.op W)).hom (1 : C(↥W.left, ULift.{u+1} ℚ_[ℓ])) = d := ⟨_, rfl⟩
      have hsm : (μ'.val.app (Opposite.op W)).hom t = t * c := by
        rw [← hcdef]
        exact (congrArg (μ'.val.app (Opposite.op W)).hom (mul_one t).symm).trans
          ((μ'.val.app (Opposite.op W)).hom.map_smul t (1 : C(↥W.left, ULift.{u+1} ℚ_[ℓ])))
      have hν1 : (ν.val.app (Opposite.op W)).hom c = c * d := by
        rw [← hddef]
        exact (congrArg (ν.val.app (Opposite.op W)).hom (mul_one c).symm).trans
          ((ν.val.app (Opposite.op W)).hom.map_smul c (1 : C(↥W.left, ULift.{u+1} ℚ_[ℓ])))
      have hν2 : (ν.val.app (Opposite.op W)).hom c = (1 : C(↥W.left, ULift.{u+1} ℚ_[ℓ])) := by
        rw [← hcdef]
        exact congrArg (fun φ : SheafOfModules.unit (wcRingSheaf U ℓ) ⟶
            SheafOfModules.unit (wcRingSheaf U ℓ) =>
          (φ.val.app (Opposite.op W)).hom (1 : C(↥W.left, ULift.{u+1} ℚ_[ℓ]))) hμν
      have hcd : c * d = 1 := hν1.symm.trans hν2
      have hy2 : ((wcSuppUnitMap D).val.app
          (Opposite.op ((wcSliceFunctor X V).obj W))).hom (t * c) = 0 := by
        rw [hsm] at hy
        exact hy

      have hv : ∀ y : ↥W.left, ((wcSliceFunctor X V).obj W).hom y ∈ Set.range i → t y = 0 := by
        intro y hy3
        have hy' : y ∈ Set.range (Limits.pullback.fst ((wcSliceFunctor X V).obj W).hom i) := by
          rw [Scheme.Pullback.range_fst]; exact hy3
        obtain ⟨z, rfl⟩ := hy'
        obtain ⟨c', hc'⟩ := wc_supp_unit_twist_isUnit D
        have htw := wc_supp_hom_twist_formula D hD (wcSuppUnitMap D)
          ((wcSliceFunctor X V).obj W) (t * c)
        have h1 := congrArg
          (fun φ : C(↥(Limits.pullback ((wcSliceFunctor X V).obj W).hom i),
            ULift.{u+1} ℚ_[ℓ]) => φ z) (htw.symm.trans hy2)
        have h2 := congrArg (fun φ : C(↥Z, ULift.{u+1} ℚ_[ℓ]) =>
          φ ((Limits.pullback.snd ((wcSliceFunctor X V).obj W).hom i).base.hom z)) hc'
        have h3 : c ((Limits.pullback.fst ((wcSliceFunctor X V).obj W).hom i).base.hom z) *
            d ((Limits.pullback.fst ((wcSliceFunctor X V).obj W).hom i).base.hom z) =
            (1 : ULift.{u+1} ℚ_[ℓ]) := by
          have h3a := congrArg (fun φ : C(↥W.left, ULift.{u+1} ℚ_[ℓ]) =>
            φ ((Limits.pullback.fst ((wcSliceFunctor X V).obj W).hom i).base.hom z)) hcd
          exact h3a
        simp only [ContinuousMap.mul_apply, ContinuousMap.comp_apply,
          ContinuousMap.one_apply] at h2
        have h1' : t ((Limits.pullback.fst ((wcSliceFunctor X V).obj W).hom i).base.hom z) *
            c ((Limits.pullback.fst ((wcSliceFunctor X V).obj W).hom i).base.hom z) *
            (wcSuppTwist (wcSuppUnitMap D))
              ((Limits.pullback.snd ((wcSliceFunctor X V).obj W).hom i).base.hom z) =
            (0 : ULift.{u+1} ℚ_[ℓ]) := h1
        show t ((Limits.pullback.fst ((wcSliceFunctor X V).obj W).hom i).base.hom z) = 0
        linear_combination
          (d ((Limits.pullback.fst ((wcSliceFunctor X V).obj W).hom i).base.hom z) *
            c' ((Limits.pullback.snd ((wcSliceFunctor X V).obj W).hom i).base.hom z)) * h1' -
          (t ((Limits.pullback.fst ((wcSliceFunctor X V).obj W).hom i).base.hom z) *
            (wcSuppTwist (wcSuppUnitMap D))
              ((Limits.pullback.snd ((wcSliceFunctor X V).obj W).hom i).base.hom z) *
            c' ((Limits.pullback.snd ((wcSliceFunctor X V).obj W).hom i).base.hom z)) * h3 -
          (t ((Limits.pullback.fst ((wcSliceFunctor X V).obj W).hom i).base.hom z)) * h2

      have hmor : Limits.pullback.fst W.hom iU ≫ ((wcSliceFunctor X V).obj W).hom =
          (Limits.pullback.snd W.hom iU ≫ gU) ≫ i := by
        show Limits.pullback.fst W.hom iU ≫ W.hom ≫ j = _
        rw [← Category.assoc, Limits.pullback.condition, Category.assoc, ← hsq.w,
          Category.assoc]
      have hzero : t.comp (Limits.pullback.fst W.hom iU).base.hom *
          (wcSuppTwist (wcSuppUnitMap DU)).comp (Limits.pullback.snd W.hom iU).base.hom =
          (0 : C(↥(Limits.pullback W.hom iU), ULift.{u+1} ℚ_[ℓ])) := by
        refine ContinuousMap.ext fun z' => ?_
        have hz : t ((Limits.pullback.fst W.hom iU).base.hom z') = 0 :=
          hv _ ⟨(Limits.pullback.snd W.hom iU ≫ gU).base z',
            (congrArg (fun φ => φ.base z') hmor).symm⟩
        simp only [ContinuousMap.mul_apply, ContinuousMap.comp_apply,
          ContinuousMap.zero_apply, hz, zero_mul]
      exact (wc_supp_hom_twist_formula DU hDU (wcSuppUnitMap DU) W t).trans hzero
    apply SheafOfModules.hom_ext
    apply PresheafOfModules.hom_ext
    intro W
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro x
    induction W using Opposite.rec with
    | op W =>
    have hk0 := congrArg (fun φ => (φ.val.app (Opposite.op W)).hom x)
      (Limits.kernel.condition (E.μ.inv ≫ E.Φ.map (wcSuppUnitMap D)))
    change ((E.μ.inv ≫ E.Φ.map (wcSuppUnitMap D)).val.app (Opposite.op W)).hom
      (((Limits.kernel.ι (E.μ.inv ≫ E.Φ.map (wcSuppUnitMap D))).val.app
        (Opposite.op W)).hom x) = 0 at hk0
    have h1 := hsec W _ hk0
    change ((wcSuppUnitMap DU).val.app (Opposite.op W)).hom
        (((Limits.kernel.ι (E.μ.inv ≫ E.Φ.map (wcSuppUnitMap D))).val.app
          (Opposite.op W)).hom x) = 0
    exact h1

  haveI : Epi γ := epi_of_epi_fac hγ
  haveI : Mono γ := by
    apply Preadditive.mono_of_cancel_zero
    intro P h hh
    have hsnd : Epi (Limits.pullback.snd (wcSuppUnitMap DU) h) := inferInstance
    have hfst : Limits.pullback.fst (wcSuppUnitMap DU) h ≫
        (E.μ.inv ≫ E.Φ.map (wcSuppUnitMap D)) = 0 := by
      rw [← hγ, ← Category.assoc, Limits.pullback.condition, Category.assoc, hh,
        Limits.comp_zero]
    have e : Limits.pullback.fst (wcSuppUnitMap DU) h =
        Limits.kernel.lift _ _ hfst ≫ Limits.kernel.ι _ := (Limits.kernel.lift_ι _ _ hfst).symm
    have h2 : Limits.pullback.snd (wcSuppUnitMap DU) h ≫ h = 0 := by
      rw [← Limits.pullback.condition, e, Category.assoc, hk, Limits.comp_zero]
    exact (cancel_epi (Limits.pullback.snd (wcSuppUnitMap DU) h)).mp
      (h2.trans Limits.comp_zero.symm)
  exact isIso_of_mono_of_epi γ

theorem wc_qmbt_pmv_ext_transfer_bij {C : Type*} [Category C] [Abelian C] [HasExt C]
    {D : Type*} [Category D] [Abelian D] [HasExt D] (G : C ⥤ D) [G.Additive]
    [Limits.PreservesFiniteLimits G] [Limits.PreservesFiniteColimits G]
    (L : D ⥤ C) (adj : L ⊣ G) (hL : Limits.PreservesFiniteLimits L)
    (M Λ : C) (M' Λ' : D) (μ : G.obj Λ ≅ Λ') (γ : M' ⟶ G.obj M) (hγ : IsIso γ) (q : ℕ) :
    Function.Bijective (fun x : Abelian.Ext (L.obj (G.obj M)) Λ q =>
      (Abelian.Ext.mk₀ (γ ≫ adj.unit.app (G.obj M))).comp
        ((Abelian.Ext.mapExactFunctor G x).comp (Abelian.Ext.mk₀ μ.hom) (add_zero q))
        (zero_add q)) ∧
    ∀ θ : Abelian.Ext M Λ q,
      (Abelian.Ext.mk₀ (γ ≫ adj.unit.app (G.obj M))).comp
        ((Abelian.Ext.mapExactFunctor G ((Abelian.Ext.mk₀ (adj.counit.app M)).comp θ
          (zero_add q))).comp (Abelian.Ext.mk₀ μ.hom) (add_zero q)) (zero_add q) =
      (Abelian.Ext.mk₀ γ).comp ((Abelian.Ext.mapExactFunctor G θ).comp (Abelian.Ext.mk₀ μ.hom)
        (add_zero q)) (zero_add q) :=
by
  haveI : L.Additive := adj.left_adjoint_additive
  haveI : Limits.PreservesFiniteLimits L := hL
  haveI : Limits.PreservesFiniteColimits L := by
    haveI := adj.leftAdjoint_preservesColimits.{0, 0}
    exact Limits.PreservesColimitsOfSize.preservesFiniteColimits L
  haveI : IsIso γ := hγ
  let B : Abelian.Ext (L.obj (G.obj M)) Λ q → Abelian.Ext (G.obj M) (G.obj Λ) q :=
    fun x => (Abelian.Ext.mk₀ (adj.unit.app (G.obj M))).comp
      (Abelian.Ext.mapExactFunctor G x) (zero_add q)
  have hB : Function.Bijective B := by
    have e : B = adj.extEquiv := by
      funext x
      rw [Adjunction.extEquiv_apply]
    rw [e]
    exact adj.extEquiv.bijective
  let Q : Abelian.Ext (G.obj M) (G.obj Λ) q → Abelian.Ext (G.obj M) Λ' q :=
    fun z => z.comp (Abelian.Ext.mk₀ μ.hom) (add_zero q)
  have hQ : Function.Bijective Q := by
    rw [Function.bijective_iff_has_inverse]
    refine ⟨fun w => w.comp (Abelian.Ext.mk₀ μ.inv) (add_zero q), ?_, ?_⟩
    · intro z
      show (z.comp (Abelian.Ext.mk₀ μ.hom) (add_zero q)).comp (Abelian.Ext.mk₀ μ.inv)
        (add_zero q) = z
      rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id,
        Abelian.Ext.comp_mk₀_id]
    · intro w
      show (w.comp (Abelian.Ext.mk₀ μ.inv) (add_zero q)).comp (Abelian.Ext.mk₀ μ.hom)
        (add_zero q) = w
      rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id,
        Abelian.Ext.comp_mk₀_id]
  let P : Abelian.Ext (G.obj M) Λ' q → Abelian.Ext M' Λ' q :=
    fun z => (Abelian.Ext.mk₀ γ).comp z (zero_add q)
  have hP : Function.Bijective P := by
    rw [Function.bijective_iff_has_inverse]
    refine ⟨fun w => (Abelian.Ext.mk₀ (inv γ)).comp w (zero_add q), ?_, ?_⟩
    · intro z
      show (Abelian.Ext.mk₀ (inv γ)).comp ((Abelian.Ext.mk₀ γ).comp z (zero_add q)) (zero_add q) = z
      rw [Abelian.Ext.mk₀_comp_mk₀_assoc, IsIso.inv_hom_id]
      exact Abelian.Ext.mk₀_id_comp _
    · intro w
      show (Abelian.Ext.mk₀ γ).comp ((Abelian.Ext.mk₀ (inv γ)).comp w (zero_add q)) (zero_add q) = w
      rw [Abelian.Ext.mk₀_comp_mk₀_assoc, IsIso.hom_inv_id]
      exact Abelian.Ext.mk₀_id_comp _
  have hfac : ∀ x : Abelian.Ext (L.obj (G.obj M)) Λ q,
      (Abelian.Ext.mk₀ (γ ≫ adj.unit.app (G.obj M))).comp
        ((Abelian.Ext.mapExactFunctor G x).comp (Abelian.Ext.mk₀ μ.hom) (add_zero q))
        (zero_add q) = P (Q (B x)) := by
    intro x
    show _ = (Abelian.Ext.mk₀ γ).comp
      (((Abelian.Ext.mk₀ (adj.unit.app (G.obj M))).comp
        (Abelian.Ext.mapExactFunctor G x) (zero_add q)).comp (Abelian.Ext.mk₀ μ.hom)
          (add_zero q)) (zero_add q)
    rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀_assoc]
  refine ⟨?_, ?_⟩
  · have e : (fun x : Abelian.Ext (L.obj (G.obj M)) Λ q =>
        (Abelian.Ext.mk₀ (γ ≫ adj.unit.app (G.obj M))).comp
          ((Abelian.Ext.mapExactFunctor G x).comp (Abelian.Ext.mk₀ μ.hom) (add_zero q))
          (zero_add q)) = P ∘ Q ∘ B := funext hfac
    rw [e]
    exact hP.comp (hQ.comp hB)
  · intro θ
    have hc : B ((Abelian.Ext.mk₀ (adj.counit.app M)).comp θ (zero_add q)) =
        Abelian.Ext.mapExactFunctor G θ := by
      show (Abelian.Ext.mk₀ (adj.unit.app (G.obj M))).comp
        (Abelian.Ext.mapExactFunctor G
          ((Abelian.Ext.mk₀ (adj.counit.app M)).comp θ (zero_add q))) (zero_add q) = _
      rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
        Abelian.Ext.mk₀_comp_mk₀_assoc, adj.right_triangle_components]
      exact Abelian.Ext.mk₀_id_comp _
    rw [hfac, hc]

theorem wc_qmbt_pmv_restr_comp_sub {T V T' V' T'' V'' : Scheme.{u}} {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    {i : T ⟶ V} {i' : T' ⟶ V'} {i'' : T'' ⟶ V''}
    (f : V' ⟶ V) (f' : V'' ⟶ V') (k : V'' ⟶ V) (hk : f' ≫ f = k)
    (D : wcHMPullData i ℓ) (hD : wcHMPullCanonical D)
    (D' : wcHMPullData i' ℓ) (hD' : wcHMPullCanonical D')
    (D'' : wcHMPullData i'' ℓ) (hD'' : wcHMPullCanonical D'') (hepi : Epi (wcSuppUnitMap D''))
    (Df : wcHMPullData f ℓ) (hDf : wcHMPullCanonical Df)
    (Df' : wcHMPullData f' ℓ) (hDf' : wcHMPullCanonical Df')
    (Dk : wcHMPullData k ℓ) (hDk : wcHMPullCanonical Dk)
    (γ₁ : wcSuppObj D' ⟶ Df.Φ.obj (wcSuppObj D))
    (γ₂ : wcSuppObj D'' ⟶ Df'.Φ.obj (wcSuppObj D'))
    (γ₁₂ : wcSuppObj D'' ⟶ Dk.Φ.obj (wcSuppObj D))
    (hγ₁ : wcSuppUnitMap D' ≫ γ₁ = Df.μ.inv ≫ Df.Φ.map (wcSuppUnitMap D))
    (hγ₂ : wcSuppUnitMap D'' ≫ γ₂ = Df'.μ.inv ≫ Df'.Φ.map (wcSuppUnitMap D'))
    (hγ₁₂ : wcSuppUnitMap D'' ≫ γ₁₂ = Dk.μ.inv ≫ Dk.Φ.map (wcSuppUnitMap D))
    (N : SheafOfModules.{u+1} (wcRingSheaf V ℓ)) (c : N ⟶ wcSuppObj D) (hc : Mono c)
    (κ₁ : wcSuppObj D' ⟶ Df.Φ.obj N) (κ₁₂ : wcSuppObj D'' ⟶ Dk.Φ.obj N)
    (hκ₁ : κ₁ ≫ Df.Φ.map c = γ₁) (hκ₁₂ : κ₁₂ ≫ Dk.Φ.map c = γ₁₂) (n : ℕ) :
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf V ℓ)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf V' ℓ)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf V'' ℓ)) := HasExt.standard _
    letI : Df.Φ.Additive := Df.additive
    letI : Limits.PreservesFiniteLimits Df.Φ := Df.presLim
    letI : Limits.PreservesFiniteColimits Df.Φ := Df.presColim
    letI : Dk.Φ.Additive := Dk.additive
    letI : Limits.PreservesFiniteLimits Dk.Φ := Dk.presLim
    letI : Limits.PreservesFiniteColimits Dk.Φ := Dk.presColim
