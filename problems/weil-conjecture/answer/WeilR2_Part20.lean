      O' = (Spec R').basicOpen (((k'' ≫ U0.ι).appLE U0 ⊤ hle).hom x0) := ⟨_, rfl⟩
  obtain ⟨hO', -, hBT⟩ := hBO U0 x0 hzero0 T' (Spec R') (k'' ≫ U0.ι) hle iT' hiTcl hiT _ rfl
  rw [← hO'def] at hO'

  obtain ⟨hW0, -, hB0⟩ := hBO U0 x0 hzero0 (Limits.pullback U0.ι iY') U0.toScheme U0.ι
    (Scheme.Opens.ι_preimage_self U0).ge (Limits.pullback.fst U0.ι iY') inferInstance hrj0 s0 hs0

