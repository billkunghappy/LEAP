    erw [Iso.hom_inv_id_app_assoc]
  have e_τ : (1:ℤ) + ((2:ℕ):ℤ) = 3 := by norm_num
  have e_a : (1:ℤ) + ((n-2:ℕ):ℤ) = (n:ℤ) - 1 := by omega
  have e_x : (3:ℤ) + ((n-4:ℕ):ℤ) = (n:ℤ) - 1 := by omega
  have e_c : ((2:ℕ):ℤ) + ((n-4:ℕ):ℤ) = ((n-2:ℕ):ℤ) := by omega
  obtain ⟨τ', hτ'⟩ := (Abelian.Ext.homAddEquiv (X := X₃) (Y := X₁) (n := 2)).surjective
    (wcDSingleTransport (C := C) 3 1 ((2:ℕ):ℤ) e_τ τ)
