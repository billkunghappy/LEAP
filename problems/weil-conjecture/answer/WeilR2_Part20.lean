      (Abelian.Ext.mk₀ ((γP ≫ adjP.unit.app (EP.Φ.obj (wcSuppObj D))) ≫ EP.Φ.map g)).comp
        ((Abelian.Ext.mapExactFunctor EP.Φ x).comp (Abelian.Ext.mk₀ EP.μ.hom) (add_zero q))
