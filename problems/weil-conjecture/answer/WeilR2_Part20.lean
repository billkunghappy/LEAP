      · rw [Abelian.Ext.comp_zero, ← Abelian.Ext.comp_assoc_of_second_deg_zero,
          Abelian.Ext.mk₀_comp_mk₀, Limits.biprod.inr_desc, h0B]
    obtain ⟨x₁, hx₁⟩ := Abelian.Ext.contravariant_sequence_exact₃ hS
      (SheafOfModules.unit (wcRingSheaf Y ℓ)) θ hg (n₀ := q') (by omega)
    have hx : x₁ = 0 := (bijP q').1 ((hvan _).trans (hvan _).symm)
    rw [← hx₁, hx, Abelian.Ext.comp_zero]

theorem wc_qmbt_dlyt_supp_ext_empty {X Y : Scheme.{u}} {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (i : X ⟶ Y) (D : wcHMPullData i ℓ) (hX : IsEmpty X) (q : ℕ) (x : wcSuppExt D q) :
    x = 0 :=
by
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf Y ℓ)) := HasExt.standard _
  have hW : ∀ W : X.ProEt, IsEmpty W.left := fun W => ⟨fun w => hX.elim (W.hom w)⟩
  have hid : 𝟙 (wcSuppObj D) = 0 := by
    apply SheafOfModules.hom_ext
    apply PresheafOfModules.hom_ext
    intro V
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro a
    exact ContinuousMap.ext (fun w => (hW ((wcProEtBC i).obj (Opposite.unop V))).elim w)
  have : x = (Abelian.Ext.mk₀ (𝟙 (wcSuppObj D))).comp x (zero_add q) :=
    (Abelian.Ext.mk₀_id_comp x).symm
  rw [this, hid, Abelian.Ext.mk₀_zero, Abelian.Ext.zero_comp]

theorem wc_qmbt_dlyt_opens_cover_inj {Y' Z : Scheme.{u}} (iY' : Y' ⟶ Z) [IsClosedImmersion iY']
    [IsLocallyNoetherian Z] (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (q : ℕ)
    (hvanq : ∀ (O : Z.Opens) (EO : wcHMPullData (Limits.pullback.fst O.ι iY') ℓ),
      wcHMPullCanonical EO → ∀ x : wcSuppExt EO q, x = 0)
    (O : Z.Opens) (r : ℕ) (V : Fin r → Z.Opens) (hV : ∀ j, V j ≤ O)
    (hcovV : ∀ x ∈ O, ∃ j, x ∈ V j)
    (EO : wcHMPullData (Limits.pullback.fst O.ι iY') ℓ) (hEO : wcHMPullCanonical EO)
    (θ₁ θ₂ : wcSuppExt EO (q + 1))
    (hloc : ∀ (j : Fin r) (EV : wcHMPullData (Limits.pullback.fst (V j).ι iY') ℓ),
      wcHMPullCanonical EV → ∀ (Dj : wcHMPullData (Z.homOfLE (hV j)) ℓ), wcHMPullCanonical Dj →
      ∀ γ : wcSuppObj EV ⟶ Dj.Φ.obj (wcSuppObj EO),
        wcSuppUnitMap EV ≫ γ = Dj.μ.inv ≫ Dj.Φ.map (wcSuppUnitMap EO) →
        letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf (V j).toScheme ℓ)) := HasExt.standard _
        (Abelian.Ext.mk₀ γ).comp (wcSuppPullExt EO Dj (q + 1) θ₁) (zero_add _) =
          (Abelian.Ext.mk₀ γ).comp (wcSuppPullExt EO Dj (q + 1) θ₂) (zero_add _)) :
    θ₁ = θ₂ :=
by
  classical
  have adm : ∀ {Yb Zb Yb' Zb' : Scheme.{u}} (i : Zb ⟶ Yb) [IsClosedImmersion i]
      (g : Yb' ⟶ Yb) (i' : Zb' ⟶ Yb') [IsClosedImmersion i'] (g' : Zb' ⟶ Zb)
      [IsLocallyNoetherian Yb'], IsPullback i' g' g i →
      ∀ (Di : wcHMPullData i ℓ), wcHMPullCanonical Di →
      ∀ (Di' : wcHMPullData i' ℓ), wcHMPullCanonical Di' →
      ∀ (Dg : wcHMPullData g ℓ), wcHMPullCanonical Dg →
      ∃ γ : wcSuppObj Di' ⟶ Dg.Φ.obj (wcSuppObj Di),
        wcSuppUnitMap Di' ≫ γ = Dg.μ.inv ≫ Dg.Φ.map (wcSuppUnitMap Di) := by
    intro Yb Zb Yb' Zb' i _ g i' _ g' _ hsq Di hDi Di' hDi' Dg hDg
    haveI := wc_supp_unit_epi_of_noetherian i' ℓ Di' hDi'
    exact ⟨Abelian.epiDesc (wcSuppUnitMap Di') (Dg.μ.inv ≫ Dg.Φ.map (wcSuppUnitMap Di))
      (wc_supp_kernel_kill_of_noetherian i g i' g' hsq ℓ Di hDi Di' hDi' Dg hDg),
      Abelian.comp_epiDesc _ _ _⟩
  have gsq : ∀ {A' B T : Scheme.{u}} (a : A' ⟶ B) (b : B ⟶ Z) (c : A' ⟶ Z), a ≫ b = c →
      ∀ (g : T ⟶ Y') (t : T ⟶ A'), IsPullback g t iY' c →
      ∃ σ : T ⟶ Limits.pullback b iY', IsPullback σ t (Limits.pullback.fst b iY') a := by
    intro A' B T a b c hc g t hsq
    have hw : (t ≫ a) ≫ b = g ≫ iY' := by rw [Category.assoc, hc]; exact hsq.w.symm
    refine ⟨Limits.pullback.lift (t ≫ a) g hw, IsPullback.of_right ?_
      (Limits.pullback.lift_fst _ _ _) (IsPullback.of_hasPullback b iY').flip⟩
    rw [Limits.pullback.lift_snd, hc]
    exact hsq
  have pbsq : ∀ {O₁ O₂ : Z.Opens} (h : O₁ ≤ O₂),
      ∃ σ : Limits.pullback O₁.ι iY' ⟶ Limits.pullback O₂.ι iY',
        IsPullback σ (Limits.pullback.fst O₁.ι iY') (Limits.pullback.fst O₂.ι iY')
          (Z.homOfLE h) := fun {O₁ O₂} h =>
    gsq (Z.homOfLE h) O₂.ι O₁.ι (Z.homOfLE_ι h) _ _ (IsPullback.of_hasPullback O₁.ι iY').flip
  have admO : ∀ {O₁ O₂ : Z.Opens} (h : O₁ ≤ O₂)
      (E₂ : wcHMPullData (Limits.pullback.fst O₂.ι iY') ℓ), wcHMPullCanonical E₂ →
      ∀ (E₁ : wcHMPullData (Limits.pullback.fst O₁.ι iY') ℓ), wcHMPullCanonical E₁ →
      ∀ (D : wcHMPullData (Z.homOfLE h) ℓ), wcHMPullCanonical D →
      ∃ γ : wcSuppObj E₁ ⟶ D.Φ.obj (wcSuppObj E₂),
        wcSuppUnitMap E₁ ≫ γ = D.μ.inv ≫ D.Φ.map (wcSuppUnitMap E₂) := by
    intro O₁ O₂ h E₂ hE₂ E₁ hE₁ D hD
    obtain ⟨σ, hσ⟩ := pbsq h
    exact adm (Limits.pullback.fst O₂.ι iY') (Z.homOfLE h) (Limits.pullback.fst O₁.ι iY') σ
      hσ.flip E₂ hE₂ E₁ hE₁ D hD
  have epiO : ∀ (O₁ : Z.Opens) (E₁ : wcHMPullData (Limits.pullback.fst O₁.ι iY') ℓ),
      wcHMPullCanonical E₁ → Epi (wcSuppUnitMap E₁) :=
    fun O₁ E₁ hE₁ => wc_supp_unit_epi_of_noetherian _ ℓ E₁ hE₁
  have hrange : ∀ {O₁ O₂ : Z.Opens} (h : O₁ ≤ O₂) (y : O₂.toScheme), y.1 ∈ O₁ →
      y ∈ Set.range (Z.homOfLE h) := fun {O₁ O₂} h y hy =>
    ⟨⟨y.1, hy⟩, by apply Subtype.ext; rw [Scheme.homOfLE_apply]⟩

  have rsub : ∀ {X₁ Y₁ Y₂ X₂ : Scheme.{u}} {i₁ : X₁ ⟶ Y₁} {f : Y₂ ⟶ Y₁} {i₂ : X₂ ⟶ Y₂}
      (D : wcHMPullData i₁ ℓ) (D' : wcHMPullData i₂ ℓ) (Df : wcHMPullData f ℓ)
      (γ : wcSuppObj D' ⟶ Df.Φ.obj (wcSuppObj D)) (n : ℕ) (a b : wcSuppExt D n),
      letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf Y₂ ℓ)) := HasExt.standard _
      (Abelian.Ext.mk₀ γ).comp (wcSuppPullExt D Df n (a - b)) (zero_add _) =
        (Abelian.Ext.mk₀ γ).comp (wcSuppPullExt D Df n a) (zero_add _) -
          (Abelian.Ext.mk₀ γ).comp (wcSuppPullExt D Df n b) (zero_add _) := by
    intro X₁ Y₁ Y₂ X₂ i₁ f i₂ D D' Df γ n a b
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf Y₁ ℓ)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf Y₂ ℓ)) := HasExt.standard _
    have hadd : ∀ x y : wcSuppExt D n,
        (Abelian.Ext.mk₀ γ).comp (wcSuppPullExt D Df n (x + y)) (zero_add _) =
          (Abelian.Ext.mk₀ γ).comp (wcSuppPullExt D Df n x) (zero_add _) +
            (Abelian.Ext.mk₀ γ).comp (wcSuppPullExt D Df n y) (zero_add _) := by
      intro x y
      haveI := Df.additive
      haveI := Df.presLim
      haveI := Df.presColim
      unfold wcSuppPullExt
      rw [Abelian.Ext.mapExactFunctor_add, Abelian.Ext.add_comp, Abelian.Ext.comp_add]
    exact map_sub (AddMonoidHom.mk'
      (fun x => (Abelian.Ext.mk₀ γ).comp (wcSuppPullExt D Df n x) (zero_add _)) hadd) a b

  obtain ⟨Wf, hWf⟩ : ∃ Wf : ℕ → Z.Opens, ∀ s x, x ∈ Wf s ↔ ∃ j : Fin r, j.val < s ∧ x ∈ V j :=
    ⟨fun s => ⨆ (j : Fin r) (_ : j.val < s), V j, fun s x => by
      simp only [TopologicalSpace.Opens.mem_iSup, exists_prop]⟩

  have C : ∀ s : ℕ, ∀ (Y : Z.Opens) (hYO : Y ≤ O), (∀ x ∈ Y, ∃ j : Fin r, j.val < s ∧ x ∈ V j) →
      ∀ (EY : wcHMPullData (Limits.pullback.fst Y.ι iY') ℓ), wcHMPullCanonical EY →
      ∀ (D : wcHMPullData (Z.homOfLE hYO) ℓ), wcHMPullCanonical D →
      ∀ γ : wcSuppObj EY ⟶ D.Φ.obj (wcSuppObj EO),
        wcSuppUnitMap EY ≫ γ = D.μ.inv ≫ D.Φ.map (wcSuppUnitMap EO) →
        letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf Y.toScheme ℓ)) := HasExt.standard _
        (Abelian.Ext.mk₀ γ).comp (wcSuppPullExt EO D (q + 1) (θ₁ - θ₂)) (zero_add _) = 0 := by
    intro s
    induction s with
    | zero =>
      intro Y hYO hYs EY hEY D hD γ hγ
      have hPempty : IsEmpty ↥(Limits.pullback Y.ι iY' : Scheme.{u}) := ⟨fun w => by
        obtain ⟨j, hj, _⟩ := hYs _ (Limits.pullback.fst Y.ι iY' w).2
        exact absurd hj (Nat.not_lt_zero _)⟩
      exact wc_qmbt_dlyt_supp_ext_empty _ EY hPempty (q + 1) _
    | succ s ih =>
      intro Y hYO hYs EY hEY D hD γ hγ
      by_cases hsr : s < r
      swap
      · exact ih Y hYO (fun x hx => by
          obtain ⟨j, _, hj⟩ := hYs x hx
          exact ⟨j, lt_of_lt_of_le j.isLt (not_lt.mp hsr), hj⟩) EY hEY D hD γ hγ
      have hA : Y ⊓ Wf s ≤ Y := inf_le_left
      have hB : Y ⊓ V ⟨s, hsr⟩ ≤ Y := inf_le_left
      have hBV : Y ⊓ V ⟨s, hsr⟩ ≤ V ⟨s, hsr⟩ := inf_le_right
      have hAO : Y ⊓ Wf s ≤ O := hA.trans hYO
      have hBO : Y ⊓ V ⟨s, hsr⟩ ≤ O := hB.trans hYO
      have hPA : (Y ⊓ Wf s) ⊓ (Y ⊓ V ⟨s, hsr⟩) ≤ Y ⊓ Wf s := inf_le_left
      have hPB : (Y ⊓ Wf s) ⊓ (Y ⊓ V ⟨s, hsr⟩) ≤ Y ⊓ V ⟨s, hsr⟩ := inf_le_right
      obtain ⟨EA, hEA⟩ := wc_hm_pull_data_exists (Limits.pullback.fst (Y ⊓ Wf s).ι iY') ℓ
      obtain ⟨EB, hEB⟩ := wc_hm_pull_data_exists
        (Limits.pullback.fst (Y ⊓ V ⟨s, hsr⟩).ι iY') ℓ
      obtain ⟨EP, hEP⟩ := wc_hm_pull_data_exists
        (Limits.pullback.fst ((Y ⊓ Wf s) ⊓ (Y ⊓ V ⟨s, hsr⟩)).ι iY') ℓ
      obtain ⟨DA, hDA⟩ := wc_hm_pull_data_exists (Z.homOfLE hA) ℓ
      obtain ⟨DB, hDB⟩ := wc_hm_pull_data_exists (Z.homOfLE hB) ℓ
      obtain ⟨DPA, hDPA⟩ := wc_hm_pull_data_exists (Z.homOfLE hPA) ℓ
      obtain ⟨DPB, hDPB⟩ := wc_hm_pull_data_exists (Z.homOfLE hPB) ℓ
      obtain ⟨γA, hγA⟩ := admO hA EY hEY EA hEA DA hDA
      obtain ⟨γB, hγB⟩ := admO hB EY hEY EB hEB DB hDB
      obtain ⟨γPA, hγPA⟩ := admO hPA EA hEA EP hEP DPA hDPA
      obtain ⟨γPB, hγPB⟩ := admO hPB EB hEB EP hEP DPB hDPB
      obtain ⟨σA, hσA⟩ := pbsq hA
      obtain ⟨σB, hσB⟩ := pbsq hB
      obtain ⟨σPA, hσPA⟩ := pbsq hPA
      obtain ⟨σPB, hσPB⟩ := pbsq hPB
      have hjs : ∀ y : Y.toScheme,
          y ∈ Set.range (Z.homOfLE hA) ∨ y ∈ Set.range (Z.homOfLE hB) := by
        intro y
        obtain ⟨j, hj, hyj⟩ := hYs y.1 y.2
        rcases Nat.lt_or_ge j.val s with hjl | hjl
        · exact Or.inl (hrange hA y
            (TopologicalSpace.Opens.mem_inf.2 ⟨y.2, (hWf s y.1).2 ⟨j, hjl, hyj⟩⟩))
        · have hjeq : j = ⟨s, hsr⟩ := Fin.ext (by simp only; omega)
          exact Or.inr (hrange hB y (TopologicalSpace.Opens.mem_inf.2 ⟨y.2, hjeq ▸ hyj⟩))
      have hMV := (wc_qmbt_dlyt_proet_mv_two (Limits.pullback.fst Y.ι iY')
        (Z.homOfLE hA) (Z.homOfLE hB) hjs (Z.homOfLE hPA) (Z.homOfLE hPB)
        (isPullback_opens_inf_le hA hB)
        (Limits.pullback.fst (Y ⊓ Wf s).ι iY') (Limits.pullback.fst (Y ⊓ V ⟨s, hsr⟩).ι iY')
        (Limits.pullback.fst ((Y ⊓ Wf s) ⊓ (Y ⊓ V ⟨s, hsr⟩)).ι iY') σA σB σPA σPB
        hσA hσB hσPA hσPB
        EY EA EB EP DA DB DPA DPB hEY hEA hEB hEP hDA hDB hDPA hDPB
        (epiO _ EY hEY) (epiO _ EA hEA) (epiO _ EB hEB) (epiO _ EP hEP)
        γA γB γPA γPB hγA hγB hγPA hγPB (q + 1)).2 q rfl (hvanq _ EP hEP)
      apply hMV
      · obtain ⟨DkA, hDkA⟩ := wc_hm_pull_data_exists (Z.homOfLE hAO) ℓ
        obtain ⟨γAO, hγAO⟩ := admO hAO EO hEO EA hEA DkA hDkA
        have e1 := wc_supp_pull_comp (Z.homOfLE hYO) (Z.homOfLE hA) (Z.homOfLE hAO)
          (Z.homOfLE_homOfLE _ _) EO hEO EY hEY EA hEA (epiO _ EA hEA) D hD DA hDA DkA hDkA
          γ hγ γA hγA γAO hγAO (q + 1) (θ₁ - θ₂)
        rw [← e1]
        exact ih (Y ⊓ Wf s) hAO
          (fun x hx => (hWf s x).1 (TopologicalSpace.Opens.mem_inf.1 hx).2)
          EA hEA DkA hDkA γAO hγAO
      · obtain ⟨DkB, hDkB⟩ := wc_hm_pull_data_exists (Z.homOfLE hBO) ℓ
        obtain ⟨EV, hEV⟩ := wc_hm_pull_data_exists
          (Limits.pullback.fst (V ⟨s, hsr⟩).ι iY') ℓ
        obtain ⟨Dj, hDj⟩ := wc_hm_pull_data_exists (Z.homOfLE (hV ⟨s, hsr⟩)) ℓ
        obtain ⟨DBV, hDBV⟩ := wc_hm_pull_data_exists (Z.homOfLE hBV) ℓ
        obtain ⟨γBO, hγBO⟩ := admO hBO EO hEO EB hEB DkB hDkB
        obtain ⟨γV, hγV⟩ := admO (hV ⟨s, hsr⟩) EO hEO EV hEV Dj hDj
        obtain ⟨γBV, hγBV⟩ := admO hBV EV hEV EB hEB DBV hDBV
        have e1 := wc_supp_pull_comp (Z.homOfLE hYO) (Z.homOfLE hB) (Z.homOfLE hBO)
          (Z.homOfLE_homOfLE _ _) EO hEO EY hEY EB hEB (epiO _ EB hEB) D hD DB hDB DkB hDkB
          γ hγ γB hγB γBO hγBO (q + 1) (θ₁ - θ₂)
        have e2 := wc_supp_pull_comp (Z.homOfLE (hV ⟨s, hsr⟩)) (Z.homOfLE hBV) (Z.homOfLE hBO)
          (Z.homOfLE_homOfLE _ _) EO hEO EV hEV EB hEB (epiO _ EB hEB) Dj hDj DBV hDBV DkB hDkB
          γV hγV γBV hγBV γBO hγBO (q + 1) (θ₁ - θ₂)
        have e4 := rsub EV EB DBV γBV (q + 1) 0 0
        rw [sub_self, sub_self] at e4
        rw [← e1, e2, rsub EO EV Dj γV (q + 1) θ₁ θ₂,
          hloc ⟨s, hsr⟩ EV hEV Dj hDj γV hγV, sub_self, e4]
  obtain ⟨Did, hDid⟩ := wc_hm_pull_data_exists (Z.homOfLE (le_refl O)) ℓ
  obtain ⟨γid, hγid⟩ := admO (le_refl O) EO hEO EO hEO Did hDid
  have h0 := C r O (le_refl O) (fun x hx => by
      obtain ⟨j, hj⟩ := hcovV x hx
      exact ⟨j, j.isLt, hj⟩) EO hEO Did hDid γid hγid
  rw [wc_supp_pull_id (Z.homOfLE (le_refl O)) (Scheme.homOfLE_rfl _ _) EO hEO (epiO _ EO hEO)
    Did hDid γid hγid (q + 1) (θ₁ - θ₂)] at h0
  exact sub_eq_zero.mp h0

theorem wc_qmbt_dlyt_affine_refine {Z : Scheme.{u}} [IsLocallyNoetherian Z] (A : Z.Opens)
    (hA : IsAffineOpen A) (O : Z.Opens) (hOA : O ≤ A) {ι : Type*} (U : ι → Z.Opens)
    (hU : ∀ x ∈ O, ∃ k, x ∈ U k) :
    ∃ (r : ℕ) (V : Fin r → Z.Opens) (κ : Fin r → ι), (∀ j, IsAffineOpen (V j)) ∧
      (∀ j, V j ≤ O) ∧ (∀ j, V j ≤ U (κ j)) ∧ ∀ x ∈ O, ∃ j, x ∈ V j :=
by
  classical
  have : IsNoetherianRing Γ(Z, A) :=
    IsLocallyNoetherian.component_noetherian (⟨A, hA⟩ : Z.affineOpens)
  have : TopologicalSpace.NoetherianSpace (A : Set Z) := noetherianSpace_of_isAffineOpen A hA
  have hOc : IsCompact (O : Set Z) := by
    have h1 : IsCompact (Subtype.val '' (Subtype.val ⁻¹' (O : Set Z) : Set (A : Set Z))) :=
      (TopologicalSpace.NoetherianSpace.isCompact _).image continuous_subtype_val
    have h2 : Subtype.val '' (Subtype.val ⁻¹' (O : Set Z) : Set (A : Set Z)) = (O : Set Z) := by
      rw [Subtype.image_preimage_coe]
      exact Set.inter_eq_right.mpr hOA
    rwa [h2] at h1
  have hW : ∀ x (hx : x ∈ (O : Set Z)), ∃ k : ι, ∃ W : Z.Opens,
      IsAffineOpen W ∧ x ∈ W ∧ W ≤ O ⊓ U k := by
    intro x hx
    obtain ⟨k, hk⟩ := hU x hx
    obtain ⟨W, hW, hxW, hWle⟩ :=
      (TopologicalSpace.Opens.isBasis_iff_nbhd.mp (Scheme.isBasis_affineOpens Z))
        (show x ∈ O ⊓ U k from ⟨hx, hk⟩)
    exact ⟨k, W, hW, hxW, hWle⟩
  choose k W hWaff hWmem hWle using hW
  obtain ⟨t, ht⟩ := hOc.elim_nhds_subcover' (fun x hx => (W x hx : Set Z))
    (fun x hx => (W x hx).isOpen.mem_nhds (hWmem x hx))
  let e := t.equivFin
  refine ⟨t.card, fun j => W (e.symm j).1.1 (e.symm j).1.2,
    fun j => k (e.symm j).1.1 (e.symm j).1.2, fun j => hWaff _ _,
    fun j => (hWle _ _).trans inf_le_left, fun j => (hWle _ _).trans inf_le_right, ?_⟩
  intro x hx
  have hx' := ht hx
  rw [Set.mem_iUnion₂] at hx'
  obtain ⟨p, hp, hxp⟩ := hx'
  refine ⟨e ⟨p, hp⟩, ?_⟩
  simp only [Equiv.symm_apply_apply]
  exact hxp

theorem wc_qmbt_dlyt_affine_glue {Y' Z : Scheme.{u}} (iY' : Y' ⟶ Z) [IsClosedImmersion iY']
    [IsLocallyNoetherian Z] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (EY' : wcHMPullData iY' ℓ) (hEY' : wcHMPullCanonical EY')
    (hcov : wcQmbtDlytLocCover iY' ℓ)
    (hvan : ∀ (O : Z.Opens) (EO : wcHMPullData (Limits.pullback.fst O.ι iY') ℓ),
      wcHMPullCanonical EO → ∀ (q : ℕ), q ≤ 1 → ∀ x : wcSuppExt EO q, x = 0) :
    ∃ θ : wcSuppExt EY' 2, wcQmbtDlytStrictNZ EY' θ :=
by
  classical
  obtain ⟨N, U, hUaff, hUcov, E, θ, hE, hθ, hagree⟩ := hcov

  have adm : ∀ {Yb Zb Yb' Zb' : Scheme.{u}} (i : Zb ⟶ Yb) [IsClosedImmersion i]
      (g : Yb' ⟶ Yb) (i' : Zb' ⟶ Yb') [IsClosedImmersion i'] (g' : Zb' ⟶ Zb)
      [IsLocallyNoetherian Yb'], IsPullback i' g' g i →
      ∀ (Di : wcHMPullData i ℓ), wcHMPullCanonical Di →
      ∀ (Di' : wcHMPullData i' ℓ), wcHMPullCanonical Di' →
      ∀ (Dg : wcHMPullData g ℓ), wcHMPullCanonical Dg →
      ∃ γ : wcSuppObj Di' ⟶ Dg.Φ.obj (wcSuppObj Di),
        wcSuppUnitMap Di' ≫ γ = Dg.μ.inv ≫ Dg.Φ.map (wcSuppUnitMap Di) := by
    intro Yb Zb Yb' Zb' i _ g i' _ g' _ hsq Di hDi Di' hDi' Dg hDg
    haveI := wc_supp_unit_epi_of_noetherian i' ℓ Di' hDi'
    exact ⟨Abelian.epiDesc (wcSuppUnitMap Di') (Dg.μ.inv ≫ Dg.Φ.map (wcSuppUnitMap Di))
      (wc_supp_kernel_kill_of_noetherian i g i' g' hsq ℓ Di hDi Di' hDi' Dg hDg),
      Abelian.comp_epiDesc _ _ _⟩

  have gsq : ∀ {A' B T : Scheme.{u}} (a : A' ⟶ B) (b : B ⟶ Z) (c : A' ⟶ Z), a ≫ b = c →
      ∀ (g : T ⟶ Y') (t : T ⟶ A'), IsPullback g t iY' c →
      ∃ σ : T ⟶ Limits.pullback b iY', IsPullback σ t (Limits.pullback.fst b iY') a := by
    intro A' B T a b c hc g t hsq
    have hw : (t ≫ a) ≫ b = g ≫ iY' := by rw [Category.assoc, hc]; exact hsq.w.symm
    refine ⟨Limits.pullback.lift (t ≫ a) g hw, IsPullback.of_right ?_
      (Limits.pullback.lift_fst _ _ _) (IsPullback.of_hasPullback b iY').flip⟩
    rw [Limits.pullback.lift_snd, hc]
    exact hsq
  have admO : ∀ {O O' : Z.Opens} (h : O ≤ O')
      (EO' : wcHMPullData (Limits.pullback.fst O'.ι iY') ℓ), wcHMPullCanonical EO' →
      ∀ (EO : wcHMPullData (Limits.pullback.fst O.ι iY') ℓ), wcHMPullCanonical EO →
      ∀ (D : wcHMPullData (Z.homOfLE h) ℓ), wcHMPullCanonical D →
      ∃ γ : wcSuppObj EO ⟶ D.Φ.obj (wcSuppObj EO'),
        wcSuppUnitMap EO ≫ γ = D.μ.inv ≫ D.Φ.map (wcSuppUnitMap EO') := by
    intro O O' h EO' hEO' EO hEO D hD
    obtain ⟨σ, hσ⟩ := gsq (Z.homOfLE h) O'.ι O.ι (Z.homOfLE_ι h) _ _
      (IsPullback.of_hasPullback O.ι iY').flip
    exact adm (Limits.pullback.fst O'.ι iY') (Z.homOfLE h) (Limits.pullback.fst O.ι iY') σ
      hσ.flip EO' hEO' EO hEO D hD
  have admZ : ∀ (O : Z.Opens) (EO : wcHMPullData (Limits.pullback.fst O.ι iY') ℓ),
      wcHMPullCanonical EO → ∀ (D : wcHMPullData O.ι ℓ), wcHMPullCanonical D →
      ∃ γ : wcSuppObj EO ⟶ D.Φ.obj (wcSuppObj EY'),
        wcSuppUnitMap EO ≫ γ = D.μ.inv ≫ D.Φ.map (wcSuppUnitMap EY') := fun O EO hEO D hD =>
    adm iY' O.ι (Limits.pullback.fst O.ι iY') (Limits.pullback.snd O.ι iY')
      (IsPullback.of_hasPullback O.ι iY') EY' hEY' EO hEO D hD
  have epiO : ∀ (O : Z.Opens) (EO : wcHMPullData (Limits.pullback.fst O.ι iY') ℓ),
      wcHMPullCanonical EO → Epi (wcSuppUnitMap EO) :=
    fun O EO hEO => wc_supp_unit_epi_of_noetherian _ ℓ EO hEO
  have hrange : ∀ {O O' : Z.Opens} (h : O ≤ O') (y : O'.toScheme), y.1 ∈ O →
      y ∈ Set.range (Z.homOfLE h) := fun {O O'} h y hy =>
    ⟨⟨y.1, hy⟩, by apply Subtype.ext; rw [Scheme.homOfLE_apply]⟩

  obtain ⟨Wf, hWf⟩ : ∃ Wf : Finset (Fin N) → Z.Opens, ∀ S x, x ∈ Wf S ↔ ∃ a ∈ S, x ∈ U a :=
    ⟨fun S => ⨆ a ∈ S, U a, fun S x => by simp only [TopologicalSpace.Opens.mem_iSup, exists_prop]⟩
  have hUle : ∀ S a, a ∈ S → U a ≤ Wf S := fun S a ha x hx => (hWf S x).2 ⟨a, ha, hx⟩

  have Q : ∀ S : Finset (Fin N), ∀ (ES : wcHMPullData (Limits.pullback.fst (Wf S).ι iY') ℓ),
      wcHMPullCanonical ES → ∃ θS : wcSuppExt ES 2, ∀ (a : Fin N) (ha : a ∈ S)
        (D : wcHMPullData (Z.homOfLE (hUle S a ha)) ℓ), wcHMPullCanonical D →
        ∀ γ : wcSuppObj (E a) ⟶ D.Φ.obj (wcSuppObj ES),
          wcSuppUnitMap (E a) ≫ γ = D.μ.inv ≫ D.Φ.map (wcSuppUnitMap ES) →
          letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf (U a).toScheme ℓ)) :=
            HasExt.standard _
          (Abelian.Ext.mk₀ γ).comp (wcSuppPullExt ES D 2 θS) (zero_add _) = θ a := by
    intro S
    induction S using Finset.induction_on with
    | empty =>
      intro ES _
      exact ⟨0, fun a ha => by simp at ha⟩
    | insert b S hbS ih =>
      intro E' hE'
      have hW : Wf S ≤ Wf (insert b S) := fun x hx => by
        obtain ⟨a, ha, hxa⟩ := (hWf S x).1 hx
        exact (hWf _ x).2 ⟨a, Finset.mem_insert_of_mem ha, hxa⟩
      have hU : U b ≤ Wf (insert b S) := hUle _ b (Finset.mem_insert_self b S)
      have hPW : Wf S ⊓ U b ≤ Wf S := inf_le_left
      have hPU : Wf S ⊓ U b ≤ U b := inf_le_right
      letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf (Wf S ⊓ U b).toScheme ℓ)) :=
        HasExt.standard _
      obtain ⟨EW, hEW⟩ := wc_hm_pull_data_exists (Limits.pullback.fst (Wf S).ι iY') ℓ
      obtain ⟨θW, hθW⟩ := ih EW hEW
      obtain ⟨EP, hEP⟩ := wc_hm_pull_data_exists (Limits.pullback.fst (Wf S ⊓ U b).ι iY') ℓ
      obtain ⟨EA, hEA⟩ := wc_hm_pull_data_exists (Z.homOfLE hW) ℓ
      obtain ⟨EB, hEB⟩ := wc_hm_pull_data_exists (Z.homOfLE hU) ℓ
      obtain ⟨EPA, hEPA⟩ := wc_hm_pull_data_exists (Z.homOfLE hPW) ℓ
      obtain ⟨EPB, hEPB⟩ := wc_hm_pull_data_exists (Z.homOfLE hPU) ℓ
      obtain ⟨γA, hγA⟩ := admO hW E' hE' EW hEW EA hEA
      obtain ⟨γB, hγB⟩ := admO hU E' hE' (E b) (hE b) EB hEB
      obtain ⟨γPA, hγPA⟩ := admO hPW EW hEW EP hEP EPA hEPA
      obtain ⟨γPB, hγPB⟩ := admO hPU (E b) (hE b) EP hEP EPB hEPB

      obtain ⟨r, V, κ, hVaff, hVP, hVU, hVcov⟩ := wc_qmbt_dlyt_affine_refine (U b) (hUaff b)
        (Wf S ⊓ U b) hPU (fun k : {a // a ∈ S} => U k.1) (fun x hx => by
          obtain ⟨a, ha, hxa⟩ := (hWf S x).1 (TopologicalSpace.Opens.mem_inf.1 hx).1
          exact ⟨⟨a, ha⟩, hxa⟩)
      have hagP := wc_qmbt_dlyt_opens_cover_inj iY' ℓ 1
        (fun O EO hEO x => hvan O EO hEO 1 le_rfl x)
        (Wf S ⊓ U b) r V hVP hVcov EP hEP
        ((Abelian.Ext.mk₀ γPA).comp (wcSuppPullExt EW EPA 2 θW) (zero_add _))
        ((Abelian.Ext.mk₀ γPB).comp (wcSuppPullExt (E b) EPB 2 (θ b)) (zero_add _)) (by
          intro j EV hEV Dj hDj γ hγ
          have hVk : V j ≤ U (κ j).1 := hVU j
          have hk : (κ j).1 ∈ S := (κ j).2
          have hVW : V j ≤ Wf S := (hVP j).trans hPW
          have hkW : U (κ j).1 ≤ Wf S := hUle S _ hk
          have hVUb : V j ≤ U b := (hVP j).trans hPU
          obtain ⟨D1, hD1⟩ := wc_hm_pull_data_exists (Z.homOfLE hVW) ℓ
          obtain ⟨D2, hD2⟩ := wc_hm_pull_data_exists (Z.homOfLE hVk) ℓ
          obtain ⟨D3, hD3⟩ := wc_hm_pull_data_exists (Z.homOfLE hkW) ℓ
          obtain ⟨D4, hD4⟩ := wc_hm_pull_data_exists (Z.homOfLE hVUb) ℓ
          obtain ⟨γ1, hγ1⟩ := admO hVW EW hEW EV hEV D1 hD1
          obtain ⟨γ2, hγ2⟩ := admO hVk (E _) (hE _) EV hEV D2 hD2
          obtain ⟨γ3, hγ3⟩ := admO hkW EW hEW (E _) (hE _) D3 hD3
          obtain ⟨γ4, hγ4⟩ := admO hVUb (E b) (hE b) EV hEV D4 hD4
          have epiV := epiO (V j) EV hEV
          have e1 := wc_supp_pull_comp (Z.homOfLE hPW) (Z.homOfLE (hVP j)) (Z.homOfLE hVW)
            (Z.homOfLE_homOfLE _ _) EW hEW EP hEP EV hEV epiV EPA hEPA Dj hDj D1 hD1
            γPA hγPA γ hγ γ1 hγ1 2 θW
          have e2 := wc_supp_pull_comp (Z.homOfLE hkW) (Z.homOfLE hVk) (Z.homOfLE hVW)
            (Z.homOfLE_homOfLE _ _) EW hEW (E _) (hE _) EV hEV epiV D3 hD3 D2 hD2 D1 hD1
            γ3 hγ3 γ2 hγ2 γ1 hγ1 2 θW
          have e3 := hθW _ hk D3 hD3 γ3 hγ3
          have e4 := wc_supp_pull_comp (Z.homOfLE hPU) (Z.homOfLE (hVP j)) (Z.homOfLE hVUb)
            (Z.homOfLE_homOfLE _ _) (E b) (hE b) EP hEP EV hEV epiV EPB hEPB Dj hDj D4 hD4
            γPB hγPB γ hγ γ4 hγ4 2 (θ b)
          have e5 := hagree _ b (V j) hVk hVUb (hVaff j) EV hEV epiV D2 hD2 D4 hD4 γ2 γ4 hγ2 hγ4
          rw [e3] at e2
          exact e1.symm.trans (e2.trans (e5.trans e4)))

      obtain ⟨σA, hσA⟩ := gsq (Z.homOfLE hW) (Wf (insert b S)).ι (Wf S).ι (Z.homOfLE_ι hW) _ _
        (IsPullback.of_hasPullback (Wf S).ι iY').flip
      obtain ⟨σB, hσB⟩ := gsq (Z.homOfLE hU) (Wf (insert b S)).ι (U b).ι (Z.homOfLE_ι hU) _ _
        (IsPullback.of_hasPullback (U b).ι iY').flip
      obtain ⟨σPA, hσPA⟩ := gsq (Z.homOfLE hPW) (Wf S).ι (Wf S ⊓ U b).ι (Z.homOfLE_ι hPW) _ _
        (IsPullback.of_hasPullback (Wf S ⊓ U b).ι iY').flip
      obtain ⟨σPB, hσPB⟩ := gsq (Z.homOfLE hPU) (U b).ι (Wf S ⊓ U b).ι (Z.homOfLE_ι hPU) _ _
        (IsPullback.of_hasPullback (Wf S ⊓ U b).ι iY').flip
      have hjs : ∀ y : (Wf (insert b S)).toScheme,
          y ∈ Set.range (Z.homOfLE hW) ∨ y ∈ Set.range (Z.homOfLE hU) := by
        intro y
        obtain ⟨a, ha, hya⟩ := (hWf _ y.1).1 y.2
        rcases Finset.mem_insert.1 ha with hab | ha'
        · exact Or.inr (hrange hU y (hab ▸ hya))
        · exact Or.inl (hrange hW y ((hWf S y.1).2 ⟨a, ha', hya⟩))
      obtain ⟨θ', hθ'A, hθ'B⟩ := (wc_qmbt_dlyt_proet_mv_two
        (Limits.pullback.fst (Wf (insert b S)).ι iY')
        (Z.homOfLE hW) (Z.homOfLE hU) hjs (Z.homOfLE hPW) (Z.homOfLE hPU)
        (isPullback_opens_inf_le hW hU)
        (Limits.pullback.fst (Wf S).ι iY') (Limits.pullback.fst (U b).ι iY')
        (Limits.pullback.fst (Wf S ⊓ U b).ι iY') σA σB σPA σPB hσA hσB hσPA hσPB
        E' EW (E b) EP EA EB EPA EPB hE' hEW (hE b) hEP hEA hEB hEPA hEPB
        (epiO _ E' hE') (epiO _ EW hEW) (epiO _ (E b) (hE b)) (epiO _ EP hEP)
        γA γB γPA γPB hγA hγB hγPA hγPB 2).1 θW (θ b) hagP

      refine ⟨θ', ?_⟩
      intro a ha D hD γ hγ
      rcases Finset.mem_insert.1 ha with hab | ha'
      · subst hab
        obtain ⟨Did, hDid⟩ := wc_hm_pull_data_exists (𝟙 (U a).toScheme) ℓ
        obtain ⟨γid, hγid⟩ := adm (Limits.pullback.fst (U a).ι iY') (𝟙 _)
          (Limits.pullback.fst (U a).ι iY') (𝟙 _) IsPullback.of_id_snd (E a) (hE a) (E a) (hE a)
          Did hDid
        have e1 := wc_supp_pull_comp (Z.homOfLE hU) (𝟙 _) (Z.homOfLE (hUle _ a ha))
          (Category.id_comp _) E' hE' (E a) (hE a) (E a) (hE a) (epiO _ (E a) (hE a)) EB hEB
          Did hDid D hD γB hγB γid hγid γ hγ 2 θ'
        rw [e1, hθ'B]
        exact wc_supp_pull_id (𝟙 _) rfl (E a) (hE a) (epiO _ (E a) (hE a)) Did hDid γid hγid 2
          (θ a)
      · have hUaW : U a ≤ Wf S := hUle S a ha'
        obtain ⟨D2, hD2⟩ := wc_hm_pull_data_exists (Z.homOfLE hUaW) ℓ
        obtain ⟨γ2, hγ2⟩ := admO hUaW EW hEW (E a) (hE a) D2 hD2
        have e1 := wc_supp_pull_comp (Z.homOfLE hW) (Z.homOfLE hUaW) (Z.homOfLE (hUle _ a ha))
          (Z.homOfLE_homOfLE _ _) E' hE' EW hEW (E a) (hE a) (epiO _ (E a) (hE a)) EA hEA
          D2 hD2 D hD γA hγA γ2 hγ2 γ hγ 2 θ'
        rw [e1, hθ'A]
        exact hθW a ha' D2 hD2 γ2 hγ2

  obtain ⟨EN, hEN⟩ := wc_hm_pull_data_exists (Limits.pullback.fst (Wf Finset.univ).ι iY') ℓ
  obtain ⟨θN, hθN⟩ := Q Finset.univ EN hEN
  obtain ⟨Bc, hBc⟩ : ∃ Bc : Z.Opens, ∀ x, x ∈ Bc ↔ x ∉ Set.range iY' :=
    ⟨⟨(Set.range iY')ᶜ, iY'.isClosedEmbedding.isClosed_range.isOpen_compl⟩, fun x => Iff.rfl⟩
  have hNB : Wf Finset.univ ⊓ Bc ≤ Wf Finset.univ := inf_le_left
  have hNB' : Wf Finset.univ ⊓ Bc ≤ Bc := inf_le_right
  obtain ⟨EB0, hEB0⟩ := wc_hm_pull_data_exists (Limits.pullback.fst Bc.ι iY') ℓ
  obtain ⟨EP, hEP⟩ := wc_hm_pull_data_exists (Limits.pullback.fst (Wf Finset.univ ⊓ Bc).ι iY') ℓ
  obtain ⟨EA, hEA⟩ := wc_hm_pull_data_exists (Wf Finset.univ).ι ℓ
  obtain ⟨EB, hEB⟩ := wc_hm_pull_data_exists Bc.ι ℓ
  obtain ⟨EPA, hEPA⟩ := wc_hm_pull_data_exists (Z.homOfLE hNB) ℓ
  obtain ⟨EPB, hEPB⟩ := wc_hm_pull_data_exists (Z.homOfLE hNB') ℓ
  obtain ⟨γA, hγA⟩ := admZ _ EN hEN EA hEA
  obtain ⟨γB, hγB⟩ := admZ _ EB0 hEB0 EB hEB
  obtain ⟨γPA, hγPA⟩ := admO hNB EN hEN EP hEP EPA hEPA
  obtain ⟨γPB, hγPB⟩ := admO hNB' EB0 hEB0 EP hEP EPB hEPB
  obtain ⟨σPA, hσPA⟩ := gsq (Z.homOfLE hNB) (Wf Finset.univ).ι (Wf Finset.univ ⊓ Bc).ι
    (Z.homOfLE_ι hNB) _ _ (IsPullback.of_hasPullback (Wf Finset.univ ⊓ Bc).ι iY').flip
  obtain ⟨σPB, hσPB⟩ := gsq (Z.homOfLE hNB') Bc.ι (Wf Finset.univ ⊓ Bc).ι
    (Z.homOfLE_ι hNB') _ _ (IsPullback.of_hasPullback (Wf Finset.univ ⊓ Bc).ι iY').flip
  have hPempty : IsEmpty ↥(Limits.pullback (Wf Finset.univ ⊓ Bc).ι iY' : Scheme.{u}) :=
    ⟨fun w => by
    have h1 : (Limits.pullback.fst (Wf Finset.univ ⊓ Bc).ι iY' ≫ (Wf Finset.univ ⊓ Bc).ι) w =
        (Limits.pullback.snd (Wf Finset.univ ⊓ Bc).ι iY' ≫ iY') w := by
      rw [Limits.pullback.condition]
    rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at h1
    have h1' : (Limits.pullback.fst (Wf Finset.univ ⊓ Bc).ι iY' w).1 =
        iY' (Limits.pullback.snd (Wf Finset.univ ⊓ Bc).ι iY' w) :=
      (Scheme.Opens.ι_apply _ _).symm.trans h1
    have h2 := (Limits.pullback.fst (Wf Finset.univ ⊓ Bc).ι iY' w).2
    have h3 := (hBc _).1 (TopologicalSpace.Opens.mem_inf.1 h2).2
    exact h3 ⟨_, h1'.symm⟩⟩
  have hjsZ : ∀ z : Z, z ∈ Set.range (Wf Finset.univ).ι ∨ z ∈ Set.range Bc.ι := by
    intro z
    rw [Scheme.Opens.range_ι, Scheme.Opens.range_ι]
    by_cases hz : z ∈ Set.range iY'
    · obtain ⟨a, ha⟩ := Set.mem_iUnion.1 (hUcov hz)
      exact Or.inl (hUle _ a (Finset.mem_univ a) ha)
    · exact Or.inr ((hBc z).2 hz)
  obtain ⟨θZ, hθZA, -⟩ := (wc_qmbt_dlyt_proet_mv_two iY' (Wf Finset.univ).ι Bc.ι hjsZ
    (Z.homOfLE hNB) (Z.homOfLE hNB') (isPullback_opens_inf _ _)
    (Limits.pullback.fst (Wf Finset.univ).ι iY') (Limits.pullback.fst Bc.ι iY')
    (Limits.pullback.fst (Wf Finset.univ ⊓ Bc).ι iY')
    (Limits.pullback.snd (Wf Finset.univ).ι iY') (Limits.pullback.snd Bc.ι iY') σPA σPB
    (IsPullback.of_hasPullback (Wf Finset.univ).ι iY').flip
    (IsPullback.of_hasPullback Bc.ι iY').flip hσPA hσPB
    EY' EN EB0 EP EA EB EPA EPB hEY' hEN hEB0 hEP hEA hEB hEPA hEPB
    (wc_supp_unit_epi_of_noetherian iY' ℓ EY' hEY') (epiO _ EN hEN) (epiO _ EB0 hEB0)
    (epiO _ EP hEP) γA γB γPA γPB hγA hγB hγPA hγPB 2).1 θN 0 (by
      apply (wc_qmbt_dlyt_supp_ext_empty _ EP hPempty 2 _).trans
      exact (wc_qmbt_dlyt_supp_ext_empty _ EP hPempty 2 _).symm)

  have hb : ∀ (a : Fin N) (DUa : wcHMPullData (U a).ι ℓ), wcHMPullCanonical DUa →
      ∀ (γ₁ : wcSuppObj (E a) ⟶ DUa.Φ.obj (wcSuppObj EY')),
        wcSuppUnitMap (E a) ≫ γ₁ = DUa.μ.inv ≫ DUa.Φ.map (wcSuppUnitMap EY') →
        letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf (U a).toScheme ℓ)) := HasExt.standard _
        (Abelian.Ext.mk₀ γ₁).comp (wcSuppPullExt EY' DUa 2 θZ) (zero_add _) = θ a := by
    intro a DUa hDUa γ₁ hγ₁
    have haN := hUle Finset.univ a (Finset.mem_univ a)
    obtain ⟨D3, hD3⟩ := wc_hm_pull_data_exists (Z.homOfLE haN) ℓ
    obtain ⟨γ3, hγ3⟩ := admO haN EN hEN (E a) (hE a) D3 hD3
    have e1 := wc_supp_pull_comp (Wf Finset.univ).ι (Z.homOfLE haN) (U a).ι (Z.homOfLE_ι haN)
      EY' hEY' EN hEN (E a) (hE a) (epiO _ (E a) (hE a)) EA hEA D3 hD3 DUa hDUa γA hγA γ3 hγ3
      γ₁ hγ₁ 2 θZ
    rw [e1, hθZA]
    exact hθN a (Finset.mem_univ a) D3 hD3 γ3 hγ3

  refine ⟨θZ, ?_⟩
  unfold wcQmbtDlytStrictNZ
  intro R' _ _ k' hk' hcp T' iT' g' hsq Dk' hDk' DT' hDT' hepi γ' hγ' h0
  obtain ⟨a, ha⟩ := Set.mem_iUnion.1 (hUcov hcp)
  have hrng : Set.range k' ⊆ Set.range (U a).ι := by
    rintro _ ⟨p, rfl⟩
    rw [Scheme.Opens.range_ι]
    exact ((IsLocalRing.specializes_closedPoint (R := R') p).map k'.continuous).mem_open
      (U a).isOpen ha
  obtain ⟨ka, hka⟩ : ∃ ka, ka ≫ (U a).ι = k' := ⟨_, IsOpenImmersion.lift_fac _ _ hrng⟩
  haveI hwka : WeaklyEtale ka := by
    haveI : WeaklyEtale (ka ≫ (U a).ι) := by rw [hka]; exact hk'
    exact WeaklyEtale.of_comp ka (U a).ι
  have hcpa : ka (IsLocalRing.closedPoint R') ∈ Set.range (Limits.pullback.fst (U a).ι iY') := by
    rw [Scheme.Pullback.range_fst]
    show (U a).ι (ka (IsLocalRing.closedPoint R')) ∈ Set.range iY'
    have e : (U a).ι (ka (IsLocalRing.closedPoint R')) = k' (IsLocalRing.closedPoint R') :=
      (Scheme.Hom.comp_apply ka (U a).ι _).symm.trans (by rw [hka])
    obtain ⟨y, hy⟩ := hcp
    exact ⟨y, hy.trans e.symm⟩
  obtain ⟨g'', sq''⟩ := gsq ka (U a).ι k' hka g' iT' hsq
  obtain ⟨Dka, hDka⟩ := wc_hm_pull_data_exists ka ℓ
  obtain ⟨DUa, hDUa⟩ := wc_hm_pull_data_exists (U a).ι ℓ
  obtain ⟨γ₁, hγ₁⟩ := admZ (U a) (E a) (hE a) DUa hDUa
  obtain ⟨γ₂, hγ₂⟩ := wc_qmbt_dlyt_gamma_wet_affine (Limits.pullback.fst (U a).ι iY') ka iT' g''
    sq''.flip (E a) (hE a) Dka hDka DT' hDT' hepi
  have e1 := wc_supp_pull_comp (U a).ι ka k' hka EY' hEY' (E a) (hE a) DT' hDT' hepi DUa hDUa
    Dka hDka Dk' hDk' γ₁ hγ₁ γ₂ hγ₂ γ' hγ' 2 θZ
  rw [hb a DUa hDUa γ₁ hγ₁] at e1
  exact hθ a R' ka hwka hcpa T' iT' g'' sq'' Dka hDka DT' hDT' hepi γ₂ hγ₂ (e1.symm.trans h0)

theorem wc_qmbt_dlyt_eq_cover {A : Type u} [CommRing A] [IsDomain A]
    [IsDiscreteValuationRing A]
    [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (hℓ : IsUnit ((ℓ : ℕ) : A)) {n : ℕ} (hn : Even n) (hn4 : 4 ≤ n) {π : A}
    {c : Matrix (Fin n) (Fin n) A}
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π}) (hc : IsUnit (c + c.transpose).det)
    {x₀ : Spec (.of (wcQuadModelRing A n π c))}
    (hx₀ : ∀ p, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
      PrimeSpectrum.asIdeal x₀)
    {B₀ : Type u} [CommRing B₀] [HenselianLocalRing B₀] [IsSepClosed (IsLocalRing.ResidueField B₀)]
    {Λ₀ : Type u} [SmallCategory Λ₀] [IsCofiltered Λ₀]
    {W₀ : Λ₀ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (wcQuadModelRing A n π c))) x₀))
      (Scheme.Etale.forget (Spec (.of (wcQuadModelRing A n π c))))}
    {φ₀ : ∀ l, Spec (.of B₀) ⟶ (W₀.obj l).right.left}
    {a₀ : Spec (.of B₀) ⟶ Spec (.of (wcQuadModelRing A n π c))}
    (hsh : wcHalShData x₀ B₀ Λ₀ W₀ φ₀ a₀)
    {Xs : Scheme.{u}} {ι : Xs ⟶ Spec (.of B₀)} {s : Xs ⟶ Spec (.of (IsLocalRing.ResidueField A))}
    (hps : IsPullback ι s (a₀ ≫ wcQuadModelStr A n π c) (wcQmSp A))
    {A' : Type u} [CommRing A'] [IsDomain A'] [IsDiscreteValuationRing A'] [HenselianLocalRing A']
    [IsSepClosed (IsLocalRing.ResidueField A')] {ιA : A →+* A'} {π' : A'}
    (hℓ' : IsUnit ((ℓ : ℕ) : A')) (hπ' : IsLocalRing.maximalIdeal A' = Ideal.span {π'})
    (hπ'2 : π' ^ 2 = ιA π) (hgen : ∀ a' : A', ∃ x y : A, a' = ιA x + ιA y * π')
    {L' : Type u} [Field L'] [IsSepClosed L'] {φ' : A' →+* L'} (hφ' : Function.Injective φ')
    (halg' : letI := φ'.toAlgebra; Algebra.IsAlgebraic A' L')
    {Xm : Scheme.{u}} {f : Xm ⟶ Spec (.of A')}
    {bl : Xm ⟶ Limits.pullback (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))}
    (hbl : wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range
      (fun i : Option (Fin n) => Option.elim i
        ((Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of A')).inv.hom π'))
        (fun j => ((Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))) ≫ a₀).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A n π c))).inv.hom
            (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X j)))))))) bl)
    (hblf : bl ≫ Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA)) = f)
    {XE' : Scheme.{u}} {p' : XE' ⟶ Xm} {q' : XE' ⟶ Spec (.of L')}
    (hpb' : IsPullback p' q' f (Spec.map (CommRingCat.ofHom φ')))
    {Xs' : Scheme.{u}} {ι' : Xs' ⟶ Xm} {s' : Xs' ⟶ Spec (.of (IsLocalRing.ResidueField A'))}
    (hps' : IsPullback ι' s' f (wcQmSp A'))
    {βs : Xs' ⟶ Xs}
    (hβ : βs ≫ ι = ι' ≫ bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA)))
    (Dβ : wcHMPullData βs ℓ) (hDβ : wcHMPullCanonical Dβ)
    [EnoughInjectives (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))]
    (Dp' : wcHMPullData p' ℓ) (hDp' : wcHMPullCanonical Dp')
    (Di' : wcHMPullData ι' ℓ) (hDi' : wcHMPullCanonical Di')
    (I' : InjectiveResolution (SheafOfModules.unit (wcRingSheaf XE' ℓ)))
    {Z₁ Z₂ ZY : Scheme.{u}} (i₁ : Z₁ ⟶ Xs') (i₂ : Z₂ ⟶ Xs') (iY : ZY ⟶ Xs')
    [IsClosedImmersion i₁] [IsClosedImmersion i₂] [IsClosedImmersion iY]
    (h₁ : Set.range i₁ = closure ((fun z => (ι' ≫ bl ≫ Limits.pullback.fst
      (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))) z) ⁻¹'
        {IsLocalRing.closedPoint B₀})ᶜ)
    (h₂ : Set.range i₂ = (fun z => (ι' ≫ bl ≫ Limits.pullback.fst
      (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))) z) ⁻¹'
        {IsLocalRing.closedPoint B₀})
    (hY : Set.range iY = closure ((fun z => (ι' ≫ bl ≫ Limits.pullback.fst
      (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))) z) ⁻¹'
        {IsLocalRing.closedPoint B₀})ᶜ ∩ (fun z => (ι' ≫ bl ≫ Limits.pullback.fst
      (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))) z) ⁻¹'
        {IsLocalRing.closedPoint B₀})
    (E₁ : wcHMPullData i₁ ℓ) (hE₁ : wcHMPullCanonical E₁)
    (E₂ : wcHMPullData i₂ ℓ) (hE₂ : wcHMPullCanonical E₂)
    (EY : wcHMPullData iY ℓ) (hEY : wcHMPullCanonical EY)
    (ρ₁ : wcSuppObj E₁ ⟶ wcSuppObj EY) (ρ₂ : wcSuppObj E₂ ⟶ wcSuppObj EY)
    (hz : Limits.biprod.lift (wcSuppUnitMap E₁) (wcSuppUnitMap E₂) ≫
      Limits.biprod.desc ρ₁ (-ρ₂) = 0)
    (hS : (ShortComplex.mk _ _ hz).ShortExact)
    {Y' : Scheme.{u}} (iY' : Y' ⟶ Z₁) [IsClosedImmersion iY'] (gY : Y' ⟶ ZY)
    (hYsq : IsPullback gY iY' iY i₁) :
    ∃ (N : ℕ) (U : Fin N → Z₁.Opens) (x : ∀ a, Γ(Z₁, U a)) (j : Fin N → Fin n),
      (∀ a, IsAffineOpen (U a)) ∧
      Set.range iY' ⊆ ⋃ a, (U a : Set Z₁) ∧
      (∀ a, ∀ z ∈ U a, (z ∈ Set.range iY' ↔ z ∉ Z₁.basicOpen (x a))) ∧
      (∀ (a b : Fin N) (W : Z₁.Opens) (hWa : W ≤ U a) (hWb : W ≤ U b), IsAffineOpen W →
        ∃ v : (Γ(Z₁, W))ˣ, (Z₁.presheaf.map (homOfLE hWa).op).hom (x a) =
          (v : Γ(Z₁, W)) * (Z₁.presheaf.map (homOfLE hWb).op).hom (x b)) ∧
      (∀ a, x a = (Z₁.presheaf.map (homOfLE (le_top : U a ≤ ⊤)).op).hom
        (wcDlytXi (i₁ ≫ ι' ≫ bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA)) ≫ a₀) (j a))) ∧
      (∀ a (i : Fin n), ∃ b : Γ(Z₁, U a),
        (Z₁.presheaf.map (homOfLE (le_top : U a ≤ ⊤)).op).hom
          (wcDlytXi (i₁ ≫ ι' ≫ bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
            (Spec.map (CommRingCat.ofHom ιA)) ≫ a₀) i) = x a * b) :=
by
  classical

  have resres : ∀ {Z : Scheme.{u}} {U V W : Z.Opens} (h1 : U ≤ V) (h2 : V ≤ W) (s : Γ(Z, W)),
      (Z.presheaf.map (homOfLE h1).op).hom ((Z.presheaf.map (homOfLE h2).op).hom s) =
        (Z.presheaf.map (homOfLE (h1.trans h2)).op).hom s := by
    intro Z U V W h1 h2 s
    rw [← CommRingCat.comp_apply, ← Functor.map_comp]
    rfl

  have natkey : ∀ {X Z : Scheme.{u}} (φ : Z ⟶ X) (O : X.Opens) (s : Γ(X, ⊤)),
      (φ.app O).hom ((X.presheaf.map (homOfLE (le_top : O ≤ ⊤)).op).hom s) =
        (Z.presheaf.map (homOfLE (le_top : φ ⁻¹ᵁ O ≤ ⊤)).op).hom (φ.appTop.hom s) := by
    intro X Z φ O s
    have := congrArg (fun f => f.hom s) (φ.naturality (homOfLE (le_top : O ≤ ⊤)).op)
    simp only [CommRingCat.comp_apply] at this
    exact this

  have crit : ∀ {T : Scheme.{u}} {R : CommRingCat.{u}} (h : T ⟶ Spec R) (r : R) (t : T),
      t ∈ T.basicOpen (h.appTop.hom ((Scheme.ΓSpecIso R).inv.hom r)) ↔ r ∉ (h t).asIdeal := by
    intro T R h r t
    have := Scheme.preimage_basicOpen h ((Scheme.ΓSpecIso R).inv.hom r)
    change t ∈ T.basicOpen ((h.app ⊤).hom _) ↔ _
    rw [← this, Scheme.Hom.mem_preimage, basicOpen_eq_of_affine]
    exact PrimeSpectrum.mem_basicOpen r (h t)

  have s1 : ∀ {Z : Scheme.{u}} (K : Set Z), IsCompact K → ∀ {m : ℕ}
      (ξ : Fin m → Γ(Z, ⊤)) (V : Fin m → Z.Opens),
      (∀ j i : Fin m, ∃ b : Γ(Z, V j),
        (Z.presheaf.map (homOfLE (le_top : V j ≤ ⊤)).op).hom (ξ i) =
          (Z.presheaf.map (homOfLE (le_top : V j ≤ ⊤)).op).hom (ξ j) * b) →
      (∀ j j' : Fin m, ∃ v : (Γ(Z, V j ⊓ V j'))ˣ,
        (Z.presheaf.map (homOfLE (le_top : V j ⊓ V j' ≤ ⊤)).op).hom (ξ j) =
          (v : Γ(Z, V j ⊓ V j')) *
            (Z.presheaf.map (homOfLE (le_top : V j ⊓ V j' ≤ ⊤)).op).hom (ξ j')) →
      K ⊆ ⋃ j, (V j : Set Z) →
      (∀ z : Z, z ∈ K ↔ ∀ p : Fin m, z ∉ Z.basicOpen (ξ p)) →
      ∃ (N : ℕ) (U : Fin N → Z.Opens) (x : ∀ a, Γ(Z, U a)) (j : Fin N → Fin m),
        (∀ a, IsAffineOpen (U a)) ∧
        K ⊆ ⋃ a, (U a : Set Z) ∧
        (∀ a, ∀ z ∈ U a, (z ∈ K ↔ z ∉ Z.basicOpen (x a))) ∧
        (∀ (a b : Fin N) (W : Z.Opens) (hWa : W ≤ U a) (hWb : W ≤ U b), IsAffineOpen W →
          ∃ v : (Γ(Z, W))ˣ, (Z.presheaf.map (homOfLE hWa).op).hom (x a) =
            (v : Γ(Z, W)) * (Z.presheaf.map (homOfLE hWb).op).hom (x b)) ∧
        (∀ a, x a = (Z.presheaf.map (homOfLE (le_top : U a ≤ ⊤)).op).hom (ξ (j a))) ∧
        (∀ a (i : Fin m), ∃ b : Γ(Z, U a),
          (Z.presheaf.map (homOfLE (le_top : U a ≤ ⊤)).op).hom (ξ i) = x a * b) := by
    intro Z K hK m ξ V hdiv hunit hcov hchar
    have key : ∀ (W : Z.Opens) (s : Γ(Z, ⊤)) (z : Z),
        z ∈ Z.basicOpen ((Z.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op).hom s) ↔
          z ∈ W ∧ z ∈ Z.basicOpen s := by
      intro W s z
      rw [Scheme.basicOpen_res, ← SetLike.mem_coe, TopologicalSpace.Opens.coe_inf]
      exact Iff.rfl
    have hloc : ∀ z : K, ∃ (J : Fin m) (O : Z.Opens), IsAffineOpen O ∧ (z : Z) ∈ O ∧ O ≤ V J := by
      intro z
      obtain ⟨J, hJ⟩ := Set.mem_iUnion.mp (hcov z.2)
      obtain ⟨O, hO, hzO, hOV⟩ :=
        (TopologicalSpace.Opens.isBasis_iff_nbhd.mp (Scheme.isBasis_affineOpens Z)) hJ
      exact ⟨J, O, hO, hzO, hOV⟩
    choose J O hOa hzO hOV using hloc
    obtain ⟨t, ht⟩ := hK.elim_finite_subcover (fun z : K => (O z : Set Z))
      (fun z => (O z).isOpen) (fun z hz => Set.mem_iUnion.mpr ⟨⟨z, hz⟩, hzO ⟨z, hz⟩⟩)
    let e := t.equivFin
    let zz : Fin t.card → K := fun a => (e.symm a : K)
    refine ⟨t.card, fun a => O (zz a),
      fun a => (Z.presheaf.map (homOfLE (le_top : O (zz a) ≤ ⊤)).op).hom (ξ (J (zz a))),
      fun a => J (zz a), ?_, ?_, ?_, ?_, ?_, ?_⟩
    · intro a; exact hOa _
    · intro y hy
      obtain ⟨z, hz, hyz⟩ := Set.mem_iUnion₂.mp (ht hy)
      refine Set.mem_iUnion.mpr ⟨e ⟨z, hz⟩, ?_⟩
      simp only [zz, Equiv.symm_apply_apply]
      exact hyz
    · intro a z hz
      constructor
      · intro hzK hb
        exact (hchar z).mp hzK (J (zz a)) ((key _ _ _).mp hb).2
      · intro hnb
        apply (hchar z).mpr
        intro p hp
        obtain ⟨b, hb⟩ := hdiv (J (zz a)) p
        have h1 : z ∈ Z.basicOpen
            ((Z.presheaf.map (homOfLE (le_top : V (J (zz a)) ≤ ⊤)).op).hom (ξ p)) :=
          (key _ _ _).mpr ⟨hOV _ hz, hp⟩
        rw [hb, Scheme.basicOpen_mul, ← SetLike.mem_coe, TopologicalSpace.Opens.coe_inf] at h1
        have h2 := ((key _ _ _).mp h1.1).2
        exact hnb ((key _ _ _).mpr ⟨hz, h2⟩)
    · intro a b W hWa hWb _
      have hW : W ≤ V (J (zz a)) ⊓ V (J (zz b)) :=
        le_inf (hWa.trans (hOV _)) (hWb.trans (hOV _))
      obtain ⟨v0, hv0⟩ := hunit (J (zz a)) (J (zz b))
      refine ⟨Units.map (Z.presheaf.map (homOfLE hW).op).hom.toMonoidHom v0, ?_⟩
      have e1 : (Z.presheaf.map (homOfLE hWa).op).hom
          ((Z.presheaf.map (homOfLE (le_top : O (zz a) ≤ ⊤)).op).hom (ξ (J (zz a)))) =
          (Z.presheaf.map (homOfLE hW).op).hom
            ((Z.presheaf.map (homOfLE (le_top : V (J (zz a)) ⊓ V (J (zz b)) ≤ ⊤)).op).hom
              (ξ (J (zz a)))) := by
        rw [resres, resres]
      have e2 : (Z.presheaf.map (homOfLE hWb).op).hom
          ((Z.presheaf.map (homOfLE (le_top : O (zz b) ≤ ⊤)).op).hom (ξ (J (zz b)))) =
          (Z.presheaf.map (homOfLE hW).op).hom
            ((Z.presheaf.map (homOfLE (le_top : V (J (zz a)) ⊓ V (J (zz b)) ≤ ⊤)).op).hom
              (ξ (J (zz b)))) := by
        rw [resres, resres]
      rw [e1, e2, hv0, map_mul]
      rfl
    · intro a; rfl
    · intro a i
      obtain ⟨b, hb⟩ := hdiv (J (zz a)) i
      refine ⟨(Z.presheaf.map (homOfLE (hOV (zz a))).op).hom b, ?_⟩
      rw [← resres (hOV (zz a)) le_top (ξ i), hb, map_mul, resres]

  have s4 : ∀ {B : Type u} [CommRing B] [IsLocalRing B] {R : CommRingCat.{u}} {m : ℕ}
      (β : Xs' ⟶ Spec (.of B)) (a : Spec (.of B) ⟶ Spec R) (G : Fin m → R)
      (g : Z₁ ⟶ Spec R), (∀ z, g z = a (β (i₁ z))) →
      IsLocalRing.maximalIdeal B = Ideal.span (Set.range fun p => (Spec.preimage a).hom (G p)) →
      Set.range i₁ = closure ((fun z => β z) ⁻¹' {IsLocalRing.closedPoint B})ᶜ →
      Set.range iY = closure ((fun z => β z) ⁻¹' {IsLocalRing.closedPoint B})ᶜ ∩
        (fun z => β z) ⁻¹' {IsLocalRing.closedPoint B} →
      ∀ z : Z₁, z ∈ Set.range iY' ↔
        ∀ p, z ∉ Z₁.basicOpen (g.appTop.hom ((Scheme.ΓSpecIso R).inv.hom (G p))) := by
    intro B _ _ R m β a G g hg hmax h₁' hY' z
    have hpt : ∀ y : Spec (.of B),
        (a y).asIdeal = Ideal.comap (Spec.preimage a).hom y.asIdeal := by
      intro y
      have h := congrArg (fun m : Spec (.of B) ⟶ Spec R => (m y).asIdeal) (Spec.map_preimage a)
      simp only at h
      rw [← h]; rfl
    have step1 : z ∈ Set.range iY' ↔ i₁ z ∈ Set.range iY := by
      constructor
      · rintro ⟨y, rfl⟩
        refine ⟨gY y, ?_⟩
        have := congrArg (fun m : Y' ⟶ Xs' => m y) hYsq.w
        simpa only [Scheme.Hom.comp_apply] using this
      · intro h
        have h' : z ∈ Set.range (Limits.pullback.snd iY i₁) := by
          rw [Scheme.Pullback.range_snd]; exact h
        obtain ⟨q, rfl⟩ := h'
        refine ⟨hYsq.isoPullback.inv q, ?_⟩
        rw [← Scheme.Hom.comp_apply, IsPullback.isoPullback_inv_snd]
    have step2 : i₁ z ∈ Set.range iY ↔ β (i₁ z) = IsLocalRing.closedPoint B := by
      rw [hY']
      constructor
      · intro h; exact h.2
      · intro h
        refine ⟨?_, h⟩
        rw [← h₁']; exact ⟨z, rfl⟩
    have step3 : ∀ y : Spec (.of B), y = IsLocalRing.closedPoint B ↔
        ∀ p, (Spec.preimage a).hom (G p) ∈ y.asIdeal := by
      intro y
      constructor
      · rintro rfl p
        show _ ∈ IsLocalRing.maximalIdeal B
        rw [hmax]; exact Ideal.subset_span ⟨p, rfl⟩
      · intro h
        apply PrimeSpectrum.ext
        apply le_antisymm
        · exact IsLocalRing.le_maximalIdeal y.isPrime.ne_top
        · show IsLocalRing.maximalIdeal B ≤ y.asIdeal
          rw [hmax, Ideal.span_le]
          rintro _ ⟨p, rfl⟩; exact h p
    rw [step1, step2, step3]
    apply forall_congr'; intro p
    rw [crit, not_not, hg, hpt, Ideal.mem_comap]

  obtain ⟨V, hE1, -, hE3, hE4⟩ := wc_qmbt_yrc_E_cover hℓ hn hn4 hπ hc hx₀ hsh hℓ' hπ' hπ'2
    hgen hbl hblf hps' iY hY
  have hmax := (wc_qmbt_ecc_shens_maximal hπ hx₀ hsh).2.1
  haveI hprop := wc_qmbt_nt_beta_proper hgen hbl
  haveI hι' : IsClosedImmersion ι' :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion) hps'.flip
      (IsClosedImmersion.spec_of_surjective (CommRingCat.ofHom (IsLocalRing.residue A'))
        IsLocalRing.residue_surjective)

  have hK : IsCompact (Set.range iY') := by
    haveI : CompactSpace Xm := QuasiCompact.compactSpace_of_compactSpace
      (bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA)))
    haveI : CompactSpace Z₁ := QuasiCompact.compactSpace_of_compactSpace (i₁ ≫ ι')
    exact (IsClosedImmersion.isClosedEmbedding iY').isClosed_range.isCompact

  have hξ : ∀ p : Fin n, wcDlytXi (i₁ ≫ ι' ≫ bl ≫ Limits.pullback.fst
      (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA)) ≫ a₀) p =
      (i₁ ≫ ι').appTop.hom ((bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
        (Spec.map (CommRingCat.ofHom ιA)) ≫ a₀).appTop.hom
        ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A n π c))).inv.hom
          (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p)))) := by
    intro p
    unfold wcDlytXi
    rw [← Category.assoc i₁ ι', Scheme.Hom.comp_appTop]
    rfl
  have hdiv : ∀ j i : Fin n, ∃ b : Γ(Z₁, (i₁ ≫ ι') ⁻¹ᵁ V j),
      (Z₁.presheaf.map (homOfLE (le_top : (i₁ ≫ ι') ⁻¹ᵁ V j ≤ ⊤)).op).hom
        (wcDlytXi (i₁ ≫ ι' ≫ bl ≫ Limits.pullback.fst
          (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA)) ≫ a₀) i) =
      (Z₁.presheaf.map (homOfLE (le_top : (i₁ ≫ ι') ⁻¹ᵁ V j ≤ ⊤)).op).hom
        (wcDlytXi (i₁ ≫ ι' ≫ bl ≫ Limits.pullback.fst
          (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA)) ≫ a₀) j) * b := by
    intro j i
    obtain ⟨b, hb⟩ := hE1 j i
    refine ⟨((i₁ ≫ ι').app (V j)).hom b, ?_⟩
    rw [hξ, hξ, ← natkey, ← natkey, hb, map_mul]
  have hunit : ∀ j j' : Fin n, ∃ v : (Γ(Z₁, (i₁ ≫ ι') ⁻¹ᵁ V j ⊓ (i₁ ≫ ι') ⁻¹ᵁ V j'))ˣ,
      (Z₁.presheaf.map (homOfLE (le_top : (i₁ ≫ ι') ⁻¹ᵁ V j ⊓ (i₁ ≫ ι') ⁻¹ᵁ V j' ≤ ⊤)).op).hom
        (wcDlytXi (i₁ ≫ ι' ≫ bl ≫ Limits.pullback.fst
          (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA)) ≫ a₀) j) =
      (v : Γ(Z₁, (i₁ ≫ ι') ⁻¹ᵁ V j ⊓ (i₁ ≫ ι') ⁻¹ᵁ V j')) *
      (Z₁.presheaf.map (homOfLE (le_top : (i₁ ≫ ι') ⁻¹ᵁ V j ⊓ (i₁ ≫ ι') ⁻¹ᵁ V j' ≤ ⊤)).op).hom
        (wcDlytXi (i₁ ≫ ι' ≫ bl ≫ Limits.pullback.fst
          (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA)) ≫ a₀) j') := by
    intro j j'
    obtain ⟨v, hv⟩ := hE3 j j'
    refine ⟨Units.map ((i₁ ≫ ι').app (V j ⊓ V j')).hom.toMonoidHom v, ?_⟩
    have := congrArg ((i₁ ≫ ι').app (V j ⊓ V j')).hom hv
    rw [map_mul, natkey, natkey] at this
    rw [hξ, hξ]
    exact this

  have hcov : Set.range iY' ⊆ ⋃ j, (((i₁ ≫ ι') ⁻¹ᵁ V j : Z₁.Opens) : Set Z₁) := by
    rintro _ ⟨y, rfl⟩
    have hw := congrArg (fun m : Y' ⟶ Xs' => m y) hYsq.w
    simp only [Scheme.Hom.comp_apply] at hw
    obtain ⟨j, hj⟩ := Set.mem_iUnion.mp (hE4 ⟨gY y, rfl⟩)
    have hj' : ι' (iY (gY y)) ∈ (V j : Set Xm) := by simpa only [Scheme.Hom.comp_apply] using hj
    refine Set.mem_iUnion.mpr ⟨j, ?_⟩
    rw [SetLike.mem_coe, Scheme.Hom.mem_preimage, Scheme.Hom.comp_apply, ← hw]
    exact hj'

  have hchar : ∀ z : Z₁, z ∈ Set.range iY' ↔ ∀ p : Fin n, z ∉ Z₁.basicOpen
      (wcDlytXi (i₁ ≫ ι' ≫ bl ≫ Limits.pullback.fst
        (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA)) ≫ a₀) p) :=
    s4 (ι' ≫ bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
        (Spec.map (CommRingCat.ofHom ιA))) a₀
      (fun p => Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p))
      (i₁ ≫ ι' ≫ bl ≫ Limits.pullback.fst
        (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA)) ≫ a₀)
      (fun z => by simp only [Scheme.Hom.comp_apply]) hmax h₁ hY
  obtain ⟨N, U, x, j, c1, c2, c3, c4, c5, c6⟩ := s1 (Set.range iY') hK
    (fun p => wcDlytXi (i₁ ≫ ι' ≫ bl ≫ Limits.pullback.fst
        (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA)) ≫ a₀) p)
    (fun j => (i₁ ≫ ι') ⁻¹ᵁ V j) hdiv hunit hcov hchar
  exact ⟨N, U, x, j, c1, c2, c3, c4, c5, c6⟩

theorem wc_strict_closed_lift {Z X : Scheme.{u}} (i : Z ⟶ X) [IsClosedImmersion i]
    (R' : CommRingCat.{u}) [HenselianLocalRing R'] [IsSepClosed (IsLocalRing.ResidueField R')]
    (k' : Spec R' ⟶ Z) (hk : WeaklyEtale k') :
    ∃ (R₀ : CommRingCat.{u}) (_ : HenselianLocalRing R₀)
      (_ : IsSepClosed (IsLocalRing.ResidueField R₀)) (cR : Spec R₀ ⟶ X) (ρ₀ : R₀ ⟶ R'),
      WeaklyEtale cR ∧ IsLocalHom ρ₀.hom ∧ Spec.map ρ₀ ≫ cR = k' ≫ i ∧
      Function.Surjective ρ₀.hom ∧
      ∀ p : Spec R₀, (RingHom.ker ρ₀.hom ≤ p.asIdeal ↔ cR p ∈ Set.range i) :=
by

  have L1 : ∀ (S O R A : Type u) [CommRing S] [CommRing O] [CommRing R]
      [CommRing A] [HenselianLocalRing R] [IsSepClosed (IsLocalRing.ResidueField R)] [IsLocalRing A]
      (π : S →+* O) (g : O →+* A) (σ : S →+* R) (ρ : R →+* A),
      Function.Surjective π → @Algebra.WeaklyEtale S R _ _ σ.toAlgebra →
      @Algebra.WeaklyEtale O A _ _ g.toAlgebra → IsLocalHom ρ → ρ.comp σ = g.comp π →
      Function.Surjective ρ ∧ RingHom.ker ρ = Ideal.map σ (RingHom.ker π) := by
    intro S O R A _ _ _ _ _ _ _ π g σ ρ hπ hσW hgW hρ hc
    letI : Algebra S O := π.toAlgebra
    letI : Algebra S R := σ.toAlgebra
    letI : Algebra S A := (ρ.comp σ).toAlgebra
    let f₂ : R →ₐ[S] A := { ρ with commutes' := fun s => rfl }
    let f₁ : O →ₐ[S] A := { g with commutes' := fun s => (RingHom.congr_fun hc s).symm }
    let Φa := Algebra.TensorProduct.productMap f₁ f₂
    have hsurjR : Function.Surjective
        (Algebra.TensorProduct.includeRight : R →ₐ[S] TensorProduct S O R) :=
      Algebra.TensorProduct.includeRight_surjective R hπ
    have hΦr : ∀ r : R, Φa (1 ⊗ₜ[S] r) = ρ r := fun r =>
      Algebra.TensorProduct.productMap_right_apply f₁ f₂ r
    have hΦl : ∀ o : O, Φa (o ⊗ₜ[S] 1) = g o := fun o =>
      Algebra.TensorProduct.productMap_left_apply f₁ f₂ o
    haveI : Nontrivial (TensorProduct S O R) := RingHom.domain_nontrivial Φa.toRingHom
    let q : R →+* TensorProduct S O R :=
      (Algebra.TensorProduct.includeRight : R →ₐ[S] TensorProduct S O R).toRingHom
    have hq : Function.Surjective q := hsurjR
    have hker : RingHom.ker q ≠ ⊤ := by
      intro h
      have h1 : (1 : R) ∈ RingHom.ker q := h ▸ Submodule.mem_top
      rw [RingHom.mem_ker, map_one] at h1
      exact one_ne_zero h1
    obtain ⟨h₀, hs₀⟩ := wc_quot_strictly_henselian_of_ne_top R (RingHom.ker q) hker
    let e := RingHom.quotientKerEquivOfSurjective hq
    have hT : HenselianLocalRing (TensorProduct S O R) :=
      wc_henselian_sepClosed_transfer.1 _ _ e h₀
    letI : IsLocalRing (TensorProduct S O R) := hT.toIsLocalRing
    letI : IsLocalRing (R ⧸ RingHom.ker q) := h₀.toIsLocalRing
    have hTs : IsSepClosed (IsLocalRing.ResidueField (TensorProduct S O R)) :=
      wc_henselian_sepClosed_transfer.2 _ _ (IsLocalRing.ResidueField.mapEquiv e) hs₀
    have hΦloc : IsLocalHom Φa.toRingHom := IsLocalHom.mk (fun t ht => by
      obtain ⟨r, rfl⟩ := hsurjR t
      change IsUnit (Φa (Algebra.TensorProduct.includeRight r)) at ht
      rw [Algebra.TensorProduct.includeRight_apply, hΦr] at ht
      exact (isUnit_of_map_unit ρ r ht).map _)
    letI : Algebra O A := g.toAlgebra
    letI : Algebra (TensorProduct S O R) A := Φa.toRingHom.toAlgebra
    haveI : IsScalarTower O (TensorProduct S O R) A := IsScalarTower.of_algebraMap_eq (fun o => by
      show g o = Φa (algebraMap O (TensorProduct S O R) o)
      rw [Algebra.TensorProduct.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply]
      exact (hΦl o).symm)
    haveI := hσW
    have hOT : Algebra.WeaklyEtale O (TensorProduct S O R) := inferInstance
    have hTA : Algebra.WeaklyEtale (TensorProduct S O R) A :=
      wc_weaklyEtale_cancel O _ A hOT hgW
    have hloc : IsLocalHom (algebraMap (TensorProduct S O R) A) := hΦloc
    have hbij := wc_olivier (TensorProduct S O R) A hT hTs hloc hTA
    have hΦq : ∀ r : R, Φa (q r) = ρ r := fun r => by
      show Φa (Algebra.TensorProduct.includeRight r) = ρ r
      rw [Algebra.TensorProduct.includeRight_apply, hΦr]
    refine ⟨fun a => ?_, ?_⟩
    · obtain ⟨t, ht⟩ := hbij.2 a
      obtain ⟨r, rfl⟩ := hq t
      exact ⟨r, (hΦq r).symm.trans ht⟩
    · apply le_antisymm
      · intro r hr
        rw [RingHom.mem_ker] at hr
        have hle : RingHom.ker π ≤
            RingHom.ker ((Ideal.Quotient.mk (Ideal.map σ (RingHom.ker π))).comp σ) := by
          intro x hx
          rw [RingHom.mem_ker, RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem]
          exact Ideal.mem_map_of_mem σ hx
        let f₁' : O →ₐ[S] R ⧸ Ideal.map σ (RingHom.ker π) :=
          { (π.liftOfSurjective hπ) ⟨(Ideal.Quotient.mk (Ideal.map σ (RingHom.ker π))).comp σ, hle⟩ with
            commutes' := fun s => by
              show (π.liftOfSurjective hπ)
                ⟨(Ideal.Quotient.mk (Ideal.map σ (RingHom.ker π))).comp σ, hle⟩ (π s) = _
              rw [RingHom.liftOfSurjective_comp_apply]
              rfl }
        let ψ := Algebra.TensorProduct.productMap f₁'
          (Ideal.Quotient.mkₐ S (Ideal.map σ (RingHom.ker π)))
        have hψq : ∀ r : R, ψ (q r) = Ideal.Quotient.mk (Ideal.map σ (RingHom.ker π)) r :=
          fun r => by
            show ψ (Algebra.TensorProduct.includeRight r) = _
            rw [Algebra.TensorProduct.includeRight_apply,
              Algebra.TensorProduct.productMap_right_apply, Ideal.Quotient.mkₐ_eq_mk]
        have hq0 : q r = 0 := by
          apply hbij.1
          show Φa (q r) = Φa 0
          rw [hΦq, hr, map_zero]
        rw [← Ideal.Quotient.eq_zero_iff_mem, ← hψq, hq0, map_zero]
      · rw [Ideal.map_le_iff_le_comap]
        intro x hx
        rw [Ideal.mem_comap, RingHom.mem_ker]
        rw [RingHom.mem_ker] at hx
        have h := RingHom.congr_fun hc x
        simp only [RingHom.comp_apply] at h
        rw [h, hx, map_zero]

  have L2 : ∀ (z : Z) (q : Spec (X.presheaf.stalk (i z))),
      X.fromSpecStalk (i z) q ∈ Set.range i ↔ RingHom.ker (i.stalkMap z).hom ≤ q.asIdeal := by
    intro z q
    have hπz : Function.Surjective (i.stalkMap z).hom := Scheme.Hom.stalkMap_surjective i z
    have hsq : ∀ q' : Spec (Z.presheaf.stalk z),
        X.fromSpecStalk (i z) (Spec.map (i.stalkMap z) q') = i (Z.fromSpecStalk z q') := by
      intro q'
      rw [← Scheme.Hom.comp_apply, Scheme.SpecMap_stalkMap_fromSpecStalk, Scheme.Hom.comp_apply]
    constructor
    · rintro ⟨z', hz'⟩
      have hsp : X.fromSpecStalk (i z) q ⤳ i z := by
        have h : X.fromSpecStalk (i z) q ∈ Set.range (X.fromSpecStalk (i z)) := ⟨q, rfl⟩
        rw [Scheme.range_fromSpecStalk] at h
        exact h
      rw [← hz'] at hsp
      have hsp' : z' ⤳ z := ((Scheme.Hom.isClosedEmbedding i).isInducing.specializes_iff).mp hsp
      have hz'r : z' ∈ Set.range (Z.fromSpecStalk z) := by
        rw [Scheme.range_fromSpecStalk]; exact hsp'
      obtain ⟨q', hq'⟩ := hz'r
      have heq : Spec.map (i.stalkMap z) q' = q := by
        apply (Scheme.Hom.isEmbedding (X.fromSpecStalk (i z))).injective
        rw [hsq, hq', hz']
      subst heq
      show RingHom.ker (i.stalkMap z).hom ≤ Ideal.comap (i.stalkMap z).hom q'.asIdeal
      rw [RingHom.ker_eq_comap_bot]
      exact Ideal.comap_mono bot_le
    · intro hker
      haveI : q.asIdeal.IsPrime := q.isPrime
      have hP := Ideal.map_isPrime_of_surjective hπz hker
      let q' : Spec (Z.presheaf.stalk z) := ⟨_, hP⟩
      have heq : Spec.map (i.stalkMap z) q' = q := by
        apply PrimeSpectrum.ext
        show Ideal.comap (i.stalkMap z).hom (Ideal.map (i.stalkMap z).hom q.asIdeal) = q.asIdeal
        rw [Ideal.comap_map_of_surjective' _ hπz, sup_eq_left.mpr hker]
      exact ⟨Z.fromSpecStalk z q', (hsq q').symm.trans
        (congrArg (fun y => X.fromSpecStalk (i z) y) heq)⟩

  have hgW : @Algebra.WeaklyEtale (Z.presheaf.stalk (k' (IsLocalRing.closedPoint R'))) R' _ _
      (Scheme.stalkClosedPointTo k').hom.toAlgebra := by
    haveI := wc_fromSpecStalk_weaklyEtale Z (k' (IsLocalRing.closedPoint R'))
    haveI : WeaklyEtale (Spec.map (Scheme.stalkClosedPointTo k') ≫
        Z.fromSpecStalk (k' (IsLocalRing.closedPoint R'))) := by
      rw [Scheme.Spec_stalkClosedPointTo_fromSpecStalk]; exact hk
    have h3 : WeaklyEtale (Spec.map (Scheme.stalkClosedPointTo k')) :=
      WeaklyEtale.of_comp _ (Z.fromSpecStalk (k' (IsLocalRing.closedPoint R')))
    exact wc_lpkt_specMap_weaklyEtale_ring _ _ _ h3
  have hκ : (Scheme.stalkClosedPointTo (k' ≫ i)).hom =
      (Scheme.stalkClosedPointTo k').hom.comp (i.stalkMap (k' (IsLocalRing.closedPoint R'))).hom :=
    (congrArg CommRingCat.Hom.hom (Scheme.stalkClosedPointTo_comp k' i)).trans
      (CommRingCat.hom_comp _ _)

  letI : Algebra (X.presheaf.stalk ((k' ≫ i) (IsLocalRing.closedPoint R'))) R' :=
    (Scheme.stalkClosedPointTo (k' ≫ i)).hom.toAlgebra
  obtain ⟨R, _, σ, ρ, _, hρσ, hRh, hRs, hρloc, hσ⟩ :=
    wc_strict_hull (X.presheaf.stalk ((k' ≫ i) (IsLocalRing.closedPoint R'))) R'
      ‹IsSepClosed (IsLocalRing.ResidueField R')›
  haveI := hRh
  have hσW : @Algebra.WeaklyEtale _ _ _ _ σ.toAlgebra := wc_indEtale_weaklyEtale σ hσ
  have hc : ρ.comp σ = (Scheme.stalkClosedPointTo k').hom.comp
      (i.stalkMap (k' (IsLocalRing.closedPoint R'))).hom := hρσ.trans hκ
  obtain ⟨hsurj, hkerρ⟩ := L1 (X.presheaf.stalk ((k' ≫ i) (IsLocalRing.closedPoint R')))
    (Z.presheaf.stalk (k' (IsLocalRing.closedPoint R'))) R R'
    (i.stalkMap (k' (IsLocalRing.closedPoint R'))).hom (Scheme.stalkClosedPointTo k').hom σ ρ
    (Scheme.Hom.stalkMap_surjective i _) hσW hgW hρloc hc
  refine ⟨CommRingCat.of R, hRh, hRs,
    Spec.map (CommRingCat.ofHom σ) ≫ X.fromSpecStalk ((k' ≫ i) (IsLocalRing.closedPoint R')),
    CommRingCat.ofHom ρ, ?_, ?_, ?_, ?_, ?_⟩
  · haveI := wc_fromSpecStalk_weaklyEtale X ((k' ≫ i) (IsLocalRing.closedPoint R'))
    letI : Algebra (X.presheaf.stalk ((k' ≫ i) (IsLocalRing.closedPoint R'))) R := σ.toAlgebra
    haveI : WeaklyEtale (Spec.map (CommRingCat.ofHom σ)) := wc_lfi_specMap_weaklyEtale _ R hσW
    infer_instance
  · exact hρloc
  · rw [← Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp, hρσ]
    exact Scheme.Spec_stalkClosedPointTo_fromSpecStalk (k' ≫ i)
  · exact hsurj
  · intro p
    have hL2 := L2 (k' (IsLocalRing.closedPoint R')) (Spec.map (CommRingCat.ofHom σ) p)
    have e1 : RingHom.ker (CommRingCat.ofHom ρ).hom ≤ p.asIdeal ↔
        RingHom.ker (i.stalkMap (k' (IsLocalRing.closedPoint R'))).hom ≤
          (Spec.map (CommRingCat.ofHom σ) p).asIdeal := by
      rw [CommRingCat.hom_ofHom, hkerρ]
      exact Ideal.map_le_iff_le_comap
    exact e1.trans hL2.symm

theorem wc_shens_quot_double_prime {C D E K : Type u} [CommRing C] [CommRing D] [CommRing E]
    [Field K] [Algebra K D] [Algebra K E] (R : CommRingCat.{u}) [HenselianLocalRing R]
    [IsSepClosed (IsLocalRing.ResidueField R)] (ρ : C →+* R)
    (hρ : WeaklyEtale (Spec.map (CommRingCat.ofHom ρ)))
    (τ : C →+* D) (hτ : Function.Surjective τ) (x : C) (hker : RingHom.ker τ = Ideal.span {x})
    (τ₂ : D →+* E) (hτ₂ : Function.Surjective τ₂) (y : C)
    (hker₂ : RingHom.ker τ₂ = Ideal.span {τ y}) (hy : τ y ∈ nonZeroDivisors D)
    (hx : ρ x ∈ IsLocalRing.maximalIdeal R) (hyR : ρ y ∈ IsLocalRing.maximalIdeal R)
    (m m' : ℕ) (hsm : SmoothOfRelativeDimension m (Spec.map (CommRingCat.ofHom (algebraMap K D))))
    (hsm' : SmoothOfRelativeDimension m' (Spec.map (CommRingCat.ofHom (algebraMap K E)))) :
    (Ideal.span {ρ x}).IsPrime ∧ Ideal.Quotient.mk (Ideal.span {ρ x}) (ρ y) ≠ 0 ∧
      (Ideal.span {Ideal.Quotient.mk (Ideal.span {ρ x}) (ρ y)}).IsPrime :=
by
  classical
  set I : Ideal R := Ideal.span {ρ x} with hI
  have h1 : I.IsPrime := wc_shens_quot_prime_of_smooth_target R ρ hρ τ hτ x hker hx m hsm
  have hne : I ≠ ⊤ := by
    intro h
    rw [hI, Ideal.span_singleton_eq_top] at h
    exact (IsLocalRing.mem_maximalIdeal _).mp hx h
  obtain ⟨hH, hS⟩ := wc_quot_strictly_henselian_of_ne_top R I hne
  have hnt : Nontrivial (R ⧸ I) := Ideal.Quotient.nontrivial_iff.mpr hne
  have hτx : τ x = 0 := by
    rw [← RingHom.mem_ker, hker]
    exact Ideal.mem_span_singleton_self x
  have hkill : RingHom.ker τ ≤ RingHom.ker ((Ideal.Quotient.mk I).comp ρ) := by
    intro a ha
    rw [hker, Ideal.mem_span_singleton] at ha
    obtain ⟨b, rfl⟩ := ha
    rw [RingHom.mem_ker, RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem, map_mul]
    exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _)
  obtain ⟨σ, hσ⟩ : ∃ σ : D →+* R ⧸ I, σ.comp τ = (Ideal.Quotient.mk I).comp ρ :=
    ⟨_, RingHom.liftOfRightInverse_comp τ (Function.surjInv hτ)
      (Function.rightInverse_surjInv hτ) ⟨(Ideal.Quotient.mk I).comp ρ, hkill⟩⟩
  have hσc : ∀ c, σ (τ c) = Ideal.Quotient.mk I (ρ c) := fun c => RingHom.congr_fun hσ c
  have hsq : CommRingCat.ofHom ρ ≫ CommRingCat.ofHom (Ideal.Quotient.mk I) =
      CommRingCat.ofHom τ ≫ CommRingCat.ofHom σ := by
    rw [← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp, hσ]
  have hs : ∀ (s : Limits.PushoutCocone (CommRingCat.ofHom ρ) (CommRingCat.ofHom τ)) (c : C),
      s.inl.hom (ρ c) = s.inr.hom (τ c) := by
    intro s c
    have := congrArg (fun φ => φ.hom c) s.condition
    simpa using this
  have hk : ∀ (s : Limits.PushoutCocone (CommRingCat.ofHom ρ) (CommRingCat.ofHom τ)),
      ∀ a ∈ I, s.inl.hom a = 0 := by
    intro s a ha
    obtain ⟨b, rfl⟩ := Ideal.mem_span_singleton.mp ha
    rw [map_mul, hs s x, hτx, map_zero, zero_mul]
  have hpo : IsPushout (CommRingCat.ofHom ρ) (CommRingCat.ofHom τ)
      (CommRingCat.ofHom (Ideal.Quotient.mk I)) (CommRingCat.ofHom σ) := by
    refine IsPushout.of_isColimit (Limits.PushoutCocone.IsColimit.mk hsq
      (fun s => CommRingCat.ofHom (Ideal.Quotient.lift I s.inl.hom (hk s))) ?_ ?_ ?_)
    · intro s
      ext a
      simp
    · intro s
      ext d
      obtain ⟨c, rfl⟩ := hτ d
      simp [hσc, hs s c]
    · intro s m h1 _
      ext a
      have := congrArg (fun φ => φ.hom a) h1
      simpa using this
  have hpb := isPullback_SpecMap_of_isPushout _ _ _ _ hpo
  have hσet : WeaklyEtale (Spec.map (CommRingCat.ofHom σ)) :=
    MorphismProperty.of_isPullback (P := @WeaklyEtale) hpb hρ

  have h2 : Ideal.Quotient.mk I (ρ y) ≠ 0 := by
    intro h0
    letI := σ.toAlgebra
    haveI : Algebra.WeaklyEtale D (R ⧸ I) := wc_lpkt_specMap_weaklyEtale_ring D (R ⧸ I) σ hσet
    haveI : Module.Flat D (R ⧸ I) := Algebra.WeaklyEtale.flat
    have hreg : IsSMulRegular (R ⧸ I) (τ y) := Module.Flat.isSMulRegular_of_nonZeroDivisors hy
    apply one_ne_zero (α := R ⧸ I)
    apply hreg
    show (τ y) • (1 : R ⧸ I) = (τ y) • (0 : R ⧸ I)
    rw [smul_zero, Algebra.smul_def, mul_one, RingHom.algebraMap_toAlgebra, hσc, h0]

  haveI := hH
  haveI := hS
  have hx₂ : σ (τ y) ∈ IsLocalRing.maximalIdeal (CommRingCat.of (R ⧸ I)) := by
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, hσc]
    rintro ⟨u, hu⟩
    obtain ⟨r, hr⟩ := Ideal.Quotient.mk_surjective (↑(u⁻¹) : R ⧸ I)
    have h3 : Ideal.Quotient.mk I (ρ y * r - 1) = 0 := by
      rw [map_sub, map_mul, map_one, hr]
      change Ideal.Quotient.mk I (ρ y) * ↑(u⁻¹) - 1 = 0
      rw [← hu, Units.mul_inv, sub_self]
    rw [Ideal.Quotient.eq_zero_iff_mem] at h3
    have hIm : I ≤ IsLocalRing.maximalIdeal R := by
      rw [hI, Ideal.span_le, Set.singleton_subset_iff]
      exact hx
    have h4 : ρ y * r ∈ IsLocalRing.maximalIdeal R := Ideal.mul_mem_right _ _ hyR
    have h5 : (1 : R) ∈ IsLocalRing.maximalIdeal R := by
      have := (IsLocalRing.maximalIdeal R).sub_mem h4 (hIm h3)
      simpa using this
    exact (IsLocalRing.maximalIdeal.isMaximal R).ne_top
      ((Ideal.eq_top_iff_one _).mpr h5)
  have h3 := wc_shens_quot_prime_of_smooth_target (C := D) (D := E) (K := K)
    (CommRingCat.of (R ⧸ I)) σ hσet τ₂ hτ₂ (τ y) hker₂ hx₂ m' hsm'
  rw [hσc] at h3
  exact ⟨h1, h2, h3⟩

theorem wc_qmbt_dlyt_div_nzd {K : Type u} [CommRing K] {n : ℕ} (c : Matrix (Fin n) (Fin n) K)
    (j : Fin n) :
    Ideal.Quotient.mk (Ideal.span {MvPolynomial.X none, wcQmbtBofQhat K n c j})
        (MvPolynomial.X (some j)) ∈
      nonZeroDivisors (MvPolynomial (Option (Fin n)) K ⧸
        Ideal.span {MvPolynomial.X none, wcQmbtBofQhat K n c j}) :=
by
  classical
  set I : Ideal (MvPolynomial (Option (Fin n)) K) :=
    Ideal.span {MvPolynomial.X none, wcQmbtBofQhat K n c j} with hI
  let g : Option (Fin n) → Polynomial (MvPolynomial (Option (Fin n)) K ⧸ I) := fun i =>
    if i = some j then Polynomial.X else Polynomial.C (Ideal.Quotient.mk I (MvPolynomial.X i))
  let Ψ' : MvPolynomial (Option (Fin n)) K →+* Polynomial (MvPolynomial (Option (Fin n)) K ⧸ I) :=
    MvPolynomial.eval₂Hom (Polynomial.C.comp ((Ideal.Quotient.mk I).comp MvPolynomial.C)) g
  have hC : ∀ r, Ψ' (MvPolynomial.C r) =
      Polynomial.C (Ideal.Quotient.mk I (MvPolynomial.C r)) := by
    intro r
    simp only [Ψ', MvPolynomial.eval₂Hom_C, RingHom.comp_apply]
  have hXj : Ψ' (MvPolynomial.X (some j)) = Polynomial.X := by
    simp only [Ψ', MvPolynomial.eval₂Hom_X', g]
    exact if_pos trivial
  have hXi : ∀ i, i ≠ some j →
      Ψ' (MvPolynomial.X i) = Polynomial.C (Ideal.Quotient.mk I (MvPolynomial.X i)) := by
    intro i hi
    simp only [Ψ', MvPolynomial.eval₂Hom_X', g, if_neg hi]
  have hhat : ∀ p : Fin n, Ψ' (wcQmbtChartHat (A' := K) j p) =
      Polynomial.C (Ideal.Quotient.mk I (wcQmbtChartHat (A' := K) j p)) := by
    intro p
    by_cases hp : p = j
    · simp only [wcQmbtChartHat, if_pos hp, map_one]
    · simp only [wcQmbtChartHat, if_neg hp]
      exact hXi _ (fun h => hp (Option.some_injective _ h))
  have hQ : Ψ' (wcQmbtBofQhat K n c j) =
      Polynomial.C (Ideal.Quotient.mk I (wcQmbtBofQhat K n c j)) := by
    unfold wcQmbtBofQhat
    rw [map_sum, map_sum, map_sum]
    refine Finset.sum_congr rfl (fun p _ => ?_)
    rw [map_sum, map_sum, map_sum]
    refine Finset.sum_congr rfl (fun q _ => ?_)
    rw [map_mul, map_mul, map_mul, map_mul, map_mul, map_mul, hC, hhat, hhat]
  have hx0 : MvPolynomial.X none ∈ I := Ideal.subset_span (Set.mem_insert _ _)
  have hQI : wcQmbtBofQhat K n c j ∈ I :=
    Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _))
  have hker : ∀ a ∈ I, Ψ' a = 0 := by
    have hle : I ≤ RingHom.ker Ψ' := by
      refine Ideal.span_le.mpr ?_
      intro x hx
      rcases hx with rfl | hx
      · rw [SetLike.mem_coe, RingHom.mem_ker, hXi none (by simp),
          Ideal.Quotient.eq_zero_iff_mem.mpr hx0, map_zero]
      · rw [Set.mem_singleton_iff] at hx
        subst hx
        rw [SetLike.mem_coe, RingHom.mem_ker, hQ, Ideal.Quotient.eq_zero_iff_mem.mpr hQI, map_zero]
    intro a ha
    exact hle ha
  let Ψ : (MvPolynomial (Option (Fin n)) K ⧸ I) →+*
      Polynomial (MvPolynomial (Option (Fin n)) K ⧸ I) := Ideal.Quotient.lift I Ψ' hker
  have hΨmk : ∀ a, Ψ (Ideal.Quotient.mk I a) = Ψ' a := fun a => Ideal.Quotient.lift_mk I Ψ' hker
  have hev : ∀ r : MvPolynomial (Option (Fin n)) K ⧸ I,
      Polynomial.eval (Ideal.Quotient.mk I (MvPolynomial.X (some j))) (Ψ r) = r := by
    intro r
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective r
    rw [hΨmk]
    induction a using MvPolynomial.induction_on with
    | C r => rw [hC, Polynomial.eval_C]
    | add p q hp hq => rw [map_add, Polynomial.eval_add, hp, hq, map_add]
    | mul_X p i hp =>
      rw [map_mul, Polynomial.eval_mul, hp, map_mul (Ideal.Quotient.mk I)]
      congr 1
      by_cases hi : i = some j
      · subst hi
        rw [hXj, Polynomial.eval_X]
      · rw [hXi i hi, Polynomial.eval_C]
  rw [mem_nonZeroDivisors_iff_right]
  intro x hx
  have h1 : Ψ x * Polynomial.X = 0 := by
    rw [← hXj, ← hΨmk, ← map_mul, hx, map_zero]
  have h2 : Ψ x = 0 := mem_nonZeroDivisors_iff_right.mp Polynomial.X_mem_nonzeroDivisors _ h1
  rw [← hev x, h2, Polynomial.eval_zero]

theorem wc_qmbt_dlyt_strict_prime {A : Type u} [CommRing A] [IsDomain A]
    [IsDiscreteValuationRing A]
    [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (hℓ : IsUnit ((ℓ : ℕ) : A)) {n : ℕ} (hn : Even n) (hn4 : 4 ≤ n) {π : A}
    {c : Matrix (Fin n) (Fin n) A}
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π}) (hc : IsUnit (c + c.transpose).det)
    {x₀ : Spec (.of (wcQuadModelRing A n π c))}
    (hx₀ : ∀ p, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
      PrimeSpectrum.asIdeal x₀)
    {B₀ : Type u} [CommRing B₀] [HenselianLocalRing B₀] [IsSepClosed (IsLocalRing.ResidueField B₀)]
    {Λ₀ : Type u} [SmallCategory Λ₀] [IsCofiltered Λ₀]
    {W₀ : Λ₀ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (wcQuadModelRing A n π c))) x₀))
      (Scheme.Etale.forget (Spec (.of (wcQuadModelRing A n π c))))}
    {φ₀ : ∀ l, Spec (.of B₀) ⟶ (W₀.obj l).right.left}
    {a₀ : Spec (.of B₀) ⟶ Spec (.of (wcQuadModelRing A n π c))}
    (hsh : wcHalShData x₀ B₀ Λ₀ W₀ φ₀ a₀)
    {Xs : Scheme.{u}} {ι : Xs ⟶ Spec (.of B₀)} {s : Xs ⟶ Spec (.of (IsLocalRing.ResidueField A))}
    (hps : IsPullback ι s (a₀ ≫ wcQuadModelStr A n π c) (wcQmSp A))
    {A' : Type u} [CommRing A'] [IsDomain A'] [IsDiscreteValuationRing A'] [HenselianLocalRing A']
    [IsSepClosed (IsLocalRing.ResidueField A')] {ιA : A →+* A'} {π' : A'}
    (hℓ' : IsUnit ((ℓ : ℕ) : A')) (hπ' : IsLocalRing.maximalIdeal A' = Ideal.span {π'})
    (hπ'2 : π' ^ 2 = ιA π) (hgen : ∀ a' : A', ∃ x y : A, a' = ιA x + ιA y * π')
    {L' : Type u} [Field L'] [IsSepClosed L'] {φ' : A' →+* L'} (hφ' : Function.Injective φ')
    (halg' : letI := φ'.toAlgebra; Algebra.IsAlgebraic A' L')
    {Xm : Scheme.{u}} {f : Xm ⟶ Spec (.of A')}
    {bl : Xm ⟶ Limits.pullback (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))}
    (hbl : wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range
      (fun i : Option (Fin n) => Option.elim i
        ((Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of A')).inv.hom π'))
        (fun j => ((Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))) ≫ a₀).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A n π c))).inv.hom
            (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X j)))))))) bl)
    (hblf : bl ≫ Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA)) = f)
    {XE' : Scheme.{u}} {p' : XE' ⟶ Xm} {q' : XE' ⟶ Spec (.of L')}
    (hpb' : IsPullback p' q' f (Spec.map (CommRingCat.ofHom φ')))
    {Xs' : Scheme.{u}} {ι' : Xs' ⟶ Xm} {s' : Xs' ⟶ Spec (.of (IsLocalRing.ResidueField A'))}
    (hps' : IsPullback ι' s' f (wcQmSp A'))
    {βs : Xs' ⟶ Xs}
    (hβ : βs ≫ ι = ι' ≫ bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA)))
    (Dβ : wcHMPullData βs ℓ) (hDβ : wcHMPullCanonical Dβ)
    [EnoughInjectives (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))]
    (Dp' : wcHMPullData p' ℓ) (hDp' : wcHMPullCanonical Dp')
    (Di' : wcHMPullData ι' ℓ) (hDi' : wcHMPullCanonical Di')
    (I' : InjectiveResolution (SheafOfModules.unit (wcRingSheaf XE' ℓ)))
    {Z₁ Z₂ ZY : Scheme.{u}} (i₁ : Z₁ ⟶ Xs') (i₂ : Z₂ ⟶ Xs') (iY : ZY ⟶ Xs')
    [IsClosedImmersion i₁] [IsClosedImmersion i₂] [IsClosedImmersion iY]
    (h₁ : Set.range i₁ = closure ((fun z => (ι' ≫ bl ≫ Limits.pullback.fst
      (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))) z) ⁻¹'
        {IsLocalRing.closedPoint B₀})ᶜ)
    (h₂ : Set.range i₂ = (fun z => (ι' ≫ bl ≫ Limits.pullback.fst
      (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))) z) ⁻¹'
        {IsLocalRing.closedPoint B₀})
    (hY : Set.range iY = closure ((fun z => (ι' ≫ bl ≫ Limits.pullback.fst
      (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))) z) ⁻¹'
        {IsLocalRing.closedPoint B₀})ᶜ ∩ (fun z => (ι' ≫ bl ≫ Limits.pullback.fst
      (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))) z) ⁻¹'
        {IsLocalRing.closedPoint B₀})
    (E₁ : wcHMPullData i₁ ℓ) (hE₁ : wcHMPullCanonical E₁)
    (E₂ : wcHMPullData i₂ ℓ) (hE₂ : wcHMPullCanonical E₂)
    (EY : wcHMPullData iY ℓ) (hEY : wcHMPullCanonical EY)
    (ρ₁ : wcSuppObj E₁ ⟶ wcSuppObj EY) (ρ₂ : wcSuppObj E₂ ⟶ wcSuppObj EY)
    (hz : Limits.biprod.lift (wcSuppUnitMap E₁) (wcSuppUnitMap E₂) ≫
      Limits.biprod.desc ρ₁ (-ρ₂) = 0)
    (hS : (ShortComplex.mk _ _ hz).ShortExact)
    {Y' : Scheme.{u}} (iY' : Y' ⟶ Z₁) [IsClosedImmersion iY'] (gY : Y' ⟶ ZY)
    (hYsq : IsPullback gY iY' iY i₁)
    (U : Z₁.Opens) (x : Γ(Z₁, U)) (j : Fin n)
    (hxv : x = (Z₁.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom
      (wcDlytXi (i₁ ≫ ι' ≫ bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
        (Spec.map (CommRingCat.ofHom ιA)) ≫ a₀) j))
    (hxvi : ∀ i : Fin n, ∃ b : Γ(Z₁, U),
      (Z₁.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom
        (wcDlytXi (i₁ ≫ ι' ≫ bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA)) ≫ a₀) i) = x * b)
    (R' : CommRingCat.{u}) [HenselianLocalRing R'] [IsSepClosed (IsLocalRing.ResidueField R')]
    (k' : Spec R' ⟶ Z₁) (hk : WeaklyEtale k') (hle : ⊤ ≤ k' ⁻¹ᵁ U)
    (hy : k' (IsLocalRing.closedPoint R') ∈ Set.range iY') :
    IsNoetherianRing (R' ⧸ nilradical R') ∧ IsDomain (R' ⧸ nilradical R') ∧
      Ideal.Quotient.mk (nilradical R')
        ((Scheme.ΓSpecIso R').hom.hom ((k'.appLE U ⊤ hle).hom x)) ≠ 0 ∧
      (Ideal.span {Ideal.Quotient.mk (nilradical R')
        ((Scheme.ΓSpecIso R').hom.hom ((k'.appLE U ⊤ hle).hom x))}).IsPrime :=
by
  classical


  have La : ∀ {A₀ C₀ : Type u} [CommRing A₀] [IsLocalRing A₀] [CommRing C₀] [Algebra A₀ C₀]
      {π₀ : A₀}, IsLocalRing.maximalIdeal A₀ = Ideal.span {π₀} →
      ∃ ε : IsLocalRing.ResidueField A₀ →+* C₀ ⧸ Ideal.span {algebraMap A₀ C₀ π₀},
        IsPullback
          (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {algebraMap A₀ C₀ π₀}))))
          (Spec.map (CommRingCat.ofHom ε))
          (Spec.map (CommRingCat.ofHom (algebraMap A₀ C₀)))
          (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A₀))) := by
    intro A₀ C₀ _ _ _ _ π₀ hπ₀
    have hJ : Ideal.map (algebraMap A₀ C₀) (IsLocalRing.maximalIdeal A₀) =
        Ideal.span {algebraMap A₀ C₀ π₀} := by
      rw [hπ₀, Ideal.map_span, Set.image_singleton]
    have H : ∀ x ∈ IsLocalRing.maximalIdeal A₀,
        (Ideal.Quotient.mk (Ideal.span {algebraMap A₀ C₀ π₀})) (algebraMap A₀ C₀ x) = 0 := by
      intro x hx
      rw [Ideal.Quotient.eq_zero_iff_mem, ← hJ]
      exact Ideal.mem_map_of_mem _ hx
    let ε : IsLocalRing.ResidueField A₀ →+* C₀ ⧸ Ideal.span {algebraMap A₀ C₀ π₀} :=
      Ideal.Quotient.lift (IsLocalRing.maximalIdeal A₀)
        ((Ideal.Quotient.mk (Ideal.span {algebraMap A₀ C₀ π₀})).comp (algebraMap A₀ C₀)) H
    have hε : ∀ x, ε (IsLocalRing.residue A₀ x) =
        Ideal.Quotient.mk (Ideal.span {algebraMap A₀ C₀ π₀}) (algebraMap A₀ C₀ x) := fun x => rfl
    let Φ : TensorProduct A₀ C₀ (IsLocalRing.ResidueField A₀) ≃+*
        C₀ ⧸ Ideal.span {algebraMap A₀ C₀ π₀} :=
      ((Algebra.TensorProduct.quotIdealMapEquivTensorQuot C₀
        (IsLocalRing.maximalIdeal A₀)).toRingEquiv.symm).trans (Ideal.quotEquivOfEq hJ)
    have hΦ : ∀ c : C₀, Φ (c ⊗ₜ 1) = Ideal.Quotient.mk (Ideal.span {algebraMap A₀ C₀ π₀}) c := by
      intro c
      have h1 : (Algebra.TensorProduct.quotIdealMapEquivTensorQuot C₀
          (IsLocalRing.maximalIdeal A₀)).toRingEquiv.symm (c ⊗ₜ 1) =
          Ideal.Quotient.mk (Ideal.map (algebraMap A₀ C₀) (IsLocalRing.maximalIdeal A₀)) c := by
        rw [RingEquiv.symm_apply_eq]
        exact (Algebra.TensorProduct.quotIdealMapEquivTensorQuot_mk C₀ _ c).symm
      show Ideal.quotEquivOfEq hJ ((Algebra.TensorProduct.quotIdealMapEquivTensorQuot C₀
        (IsLocalRing.maximalIdeal A₀)).toRingEquiv.symm (c ⊗ₜ 1)) = _
      rw [h1, Ideal.quotEquivOfEq_mk]
    have P := CommRingCat.isPushout_tensorProduct A₀ C₀ (IsLocalRing.ResidueField A₀)
    have P' : IsPushout (CommRingCat.ofHom (algebraMap A₀ C₀))
        (CommRingCat.ofHom (IsLocalRing.residue A₀))
        (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {algebraMap A₀ C₀ π₀})))
        (CommRingCat.ofHom ε) := by
      refine IsPushout.of_iso P (Iso.refl _) (Iso.refl _) (Iso.refl _) Φ.toCommRingCatIso
        ?_ ?_ ?_ ?_
      · rw [Iso.refl_hom, Iso.refl_hom, Category.comp_id, Category.id_comp]
      · rw [Iso.refl_hom, Iso.refl_hom, Category.comp_id, Category.id_comp]
        rfl
      · rw [Iso.refl_hom, Category.id_comp, RingEquiv.toCommRingCatIso_hom]
        ext c
        simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply,
          Algebra.TensorProduct.includeLeftRingHom_apply, RingEquiv.coe_toRingHom]
        exact hΦ c
      · rw [Iso.refl_hom, Category.id_comp, RingEquiv.toCommRingCatIso_hom]
        ext κ
        obtain ⟨x, rfl⟩ := IsLocalRing.residue_surjective κ
        simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply,
          AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
          Algebra.TensorProduct.includeRight_apply]
        have e1 : (1 : C₀) ⊗ₜ[A₀] (IsLocalRing.residue A₀ x) = algebraMap A₀ C₀ x ⊗ₜ 1 :=
          (Algebra.TensorProduct.tmul_one_eq_one_tmul x).symm
        rw [e1, hΦ, hε]
    exact ⟨ε, isPullback_SpecMap_of_isPushout _ _ _ _ P'⟩

  have Lb : ∀ {M X S T Xs U Ub Z : Scheme.{u}}
      (ψ₀ : M ⟶ X) (F : X ⟶ S) (f₀ : M ⟶ S) (_hf : ψ₀ ≫ F = f₀)
      (t : T ⟶ S) (ι₀ : Xs ⟶ M) (s₀ : Xs ⟶ T) (_hps : IsPullback ι₀ s₀ f₀ t)
      (e₀ : U ⟶ X) (u₀ : U ⟶ S) (_hu : e₀ ≫ F = u₀)
      (m : Ub ⟶ U) (ε' : Ub ⟶ T) (_hU : IsPullback m ε' u₀ t)
      (c₀ : Z ⟶ Xs) (hb : Z ⟶ Ub)
      (_h1 : hb ≫ m ≫ e₀ = c₀ ≫ ι₀ ≫ ψ₀) (_h2 : hb ≫ ε' = c₀ ≫ s₀)
      (_hψ : WeaklyEtale ψ₀) (_he : WeaklyEtale e₀) (_hc : WeaklyEtale c₀),
      WeaklyEtale hb := by
    intro M X S T Xs U Ub Z ψ₀ F f₀ hf t ι₀ s₀ hps e₀ u₀ hu m ε' hU c₀ hb h1 h2 hψ he hc
    have Q := IsPullback.of_hasPullback F t
    have w₁ : (ι₀ ≫ ψ₀) ≫ F = s₀ ≫ t := by rw [Category.assoc, hf]; exact hps.toCommSq.w
    have w₂ : (m ≫ e₀) ≫ F = ε' ≫ t := by rw [Category.assoc, hu]; exact hU.toCommSq.w
    have hκ1 := Limits.pullback.lift_fst (ι₀ ≫ ψ₀) s₀ w₁
    have hκ2 := Limits.pullback.lift_snd (ι₀ ≫ ψ₀) s₀ w₁
    have he1 := Limits.pullback.lift_fst (m ≫ e₀) ε' w₂
    have he2 := Limits.pullback.lift_snd (m ≫ e₀) ε' w₂
    have Pκ : IsPullback (Limits.pullback.lift (ι₀ ≫ ψ₀) s₀ w₁) ι₀
        (Limits.pullback.fst F t) ψ₀ := by
      refine IsPullback.of_right ?_ hκ1 Q.flip
      rw [hκ2, hf]; exact hps.flip
    have Pe : IsPullback (Limits.pullback.lift (m ≫ e₀) ε' w₂) m
        (Limits.pullback.fst F t) e₀ := by
      refine IsPullback.of_right ?_ he1 Q.flip
      rw [he2, hu]; exact hU.flip
    haveI Wκ : WeaklyEtale (Limits.pullback.lift (ι₀ ≫ ψ₀) s₀ w₁) :=
      MorphismProperty.of_isPullback (P := @WeaklyEtale) Pκ.flip hψ
    haveI We : WeaklyEtale (Limits.pullback.lift (m ≫ e₀) ε' w₂) :=
      MorphismProperty.of_isPullback (P := @WeaklyEtale) Pe.flip he
    have hcomm : hb ≫ Limits.pullback.lift (m ≫ e₀) ε' w₂ =
        c₀ ≫ Limits.pullback.lift (ι₀ ≫ ψ₀) s₀ w₁ := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, he1, h1, Category.assoc, hκ1]
      · rw [Category.assoc, he2, h2, Category.assoc, hκ2]
    haveI : WeaklyEtale (hb ≫ Limits.pullback.lift (m ≫ e₀) ε' w₂) := by
      rw [hcomm]; infer_instance
    exact WeaklyEtale.of_comp hb (Limits.pullback.lift (m ≫ e₀) ε' w₂)

  have Lq : ∀ (c' : Matrix (Fin n) (Fin n) A') (j : Fin n),
      ∃ τ : (wcQmbtChart A' n π' c' j ⧸
          Ideal.span {algebraMap A' (wcQmbtChart A' n π' c' j) π'}) →+*
        (MvPolynomial (Option (Fin n)) (IsLocalRing.ResidueField A') ⧸
          Ideal.span {MvPolynomial.X none, wcQmbtBofQhat (IsLocalRing.ResidueField A') n
            (c'.map (IsLocalRing.residue A')) j}),
        Function.Surjective τ ∧
        RingHom.ker τ = Ideal.span {Ideal.Quotient.mk _
          (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j) (MvPolynomial.X none))} ∧
        ∀ v : Option (Fin n), τ (Ideal.Quotient.mk _
            (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j) (MvPolynomial.X v))) =
          Ideal.Quotient.mk _ (MvPolynomial.X v) := by
    intro c' j
    set I := wcQmbtChartIdeal A' n π' c' j with hI
    set J : Ideal (wcQmbtChart A' n π' c' j) :=
      Ideal.span {algebraMap A' (wcQmbtChart A' n π' c' j) π'} with hJ
    set Qk := wcQmbtBofQhat (IsLocalRing.ResidueField A') n (c'.map (IsLocalRing.residue A')) j
      with hQk
    set ID : Ideal (MvPolynomial (Option (Fin n)) (IsLocalRing.ResidueField A')) :=
      Ideal.span {MvPolynomial.X none, Qk} with hID
    set Q : MvPolynomial (Option (Fin n)) A' :=
      ∑ p, ∑ q, MvPolynomial.C (c' p q) * wcQmbtChartHat j p * wcQmbtChartHat j q with hQ
    have s1 : MvPolynomial.map (IsLocalRing.residue A') Q = Qk := by
      simp only [hQ, hQk, wcQmbtBofQhat, map_sum, map_mul, MvPolynomial.map_C, Matrix.map_apply]
      refine Finset.sum_congr rfl (fun p _ => Finset.sum_congr rfl (fun q _ => ?_))
      simp only [wcQmbtChartHat]
      split_ifs <;> simp
    have s2 : IsLocalRing.residue A' π' = 0 :=
      (IsLocalRing.residue_eq_zero_iff π').mpr (hπ' ▸ Ideal.mem_span_singleton_self π')
    let μ : MvPolynomial (Option (Fin n)) A' →+*
        (MvPolynomial (Option (Fin n)) (IsLocalRing.ResidueField A') ⧸ ID) :=
      (Ideal.Quotient.mk ID).comp (MvPolynomial.map (IsLocalRing.residue A'))
    have hμ : ∀ f, μ f = Ideal.Quotient.mk ID (MvPolynomial.map (IsLocalRing.residue A') f) :=
      fun f => rfl
    have hμsurj : Function.Surjective μ :=
      Ideal.Quotient.mk_surjective.comp
        (MvPolynomial.map_surjective _ IsLocalRing.residue_surjective)
    have hXn : Ideal.Quotient.mk ID (MvPolynomial.X none) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_insert _ _))
    have hQk0 : Ideal.Quotient.mk ID Qk = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr
        (Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _)))
    have h1 : I ≤ RingHom.ker μ := by
      rw [hI, Ideal.span_le, Set.insert_subset_iff, Set.singleton_subset_iff]
      constructor
      · rw [SetLike.mem_coe, RingHom.mem_ker, hμ]
        simp only [map_sub, map_mul, MvPolynomial.map_X, MvPolynomial.map_C, s2, map_zero, hXn,
          mul_zero, sub_zero]
      · rw [SetLike.mem_coe, RingHom.mem_ker]
        show Ideal.Quotient.mk ID (MvPolynomial.map (IsLocalRing.residue A')
          (Q - MvPolynomial.X none ^ 2)) = 0
        rw [map_sub, s1, map_pow, MvPolynomial.map_X, map_sub, map_pow, hQk0, hXn]
        simp
