      apply Limits.biprod.hom_ext'
      · rw [← Category.assoc, Limits.biprod.inl_desc, h1, Limits.comp_zero]
      · rw [← Category.assoc, Limits.biprod.inr_desc, Preadditive.neg_comp, ht, neg_zero,
