by
  classical

  have hπm : π' ∈ IsLocalRing.maximalIdeal A' := by
    rw [hπ']; exact Ideal.mem_span_singleton_self π'
  have hP := IsPullback.of_hasPullback (a₀ ≫ wcQuadModelStr A n π c)
    (Spec.map (CommRingCat.ofHom ιA))
  obtain ⟨θ, X₁, r₁, gP, ψ, hθX, hθA, sq₁, hr, hgP1, hgP2, sqT⟩ :=
    wc_qmbt_sfp_model_square_P hsh hπ'2 hbl
  have hmax := (wc_qmbt_ecc_shens_maximal hπ hx₀ hsh).2.1
  let ω₀ : wcQuadModelRing A n π c →+* AlgebraicClosure (IsLocalRing.ResidueField B₀) :=
    (algebraMap (IsLocalRing.ResidueField B₀) (AlgebraicClosure (IsLocalRing.ResidueField B₀))).comp
      ((IsLocalRing.residue B₀).comp (Spec.preimage a₀).hom)
  have hω₀ : ∀ p, ω₀ (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p)) = 0 := by
    intro p
    have hm : (Spec.preimage a₀).hom (Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
        (MvPolynomial.X p)) ∈ IsLocalRing.maximalIdeal B₀ := by
      rw [hmax]; exact Ideal.subset_span ⟨p, rfl⟩
    simp only [ω₀, RingHom.comp_apply, (IsLocalRing.residue_eq_zero_iff _).mpr hm, map_zero]
  obtain ⟨lam, ω, hωX, hωA, hlamι, hωθ'⟩ :=
    wc_qmbt_sfp_origin_char hπ hπ' hπ'2 hgen ω₀ hω₀
  have hωθ := hωθ' θ hθX hθA
  have key : CommRingCat.ofHom (algebraMap A (wcQuadModelRing A n π c)) ≫ Spec.preimage a₀ ≫
      CommRingCat.ofHom (IsLocalRing.residue B₀) ≫
      CommRingCat.ofHom (algebraMap (IsLocalRing.ResidueField B₀)
        (AlgebraicClosure (IsLocalRing.ResidueField B₀))) =
      CommRingCat.ofHom ιA ≫ CommRingCat.ofHom (IsLocalRing.residue A') ≫
        CommRingCat.ofHom lam := by
    ext a
    have h1 := RingHom.congr_fun hlamι a
    simp only [RingHom.comp_apply, ω₀] at h1
    simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply]
    exact h1.symm
  have E0 : (Spec.map (CommRingCat.ofHom (algebraMap (IsLocalRing.ResidueField B₀)
        (AlgebraicClosure (IsLocalRing.ResidueField B₀)))) ≫
      Spec.map (CommRingCat.ofHom (IsLocalRing.residue B₀))) ≫ a₀ ≫ wcQuadModelStr A n π c =
      (Spec.map (CommRingCat.ofHom lam) ≫ wcQmSp A') ≫ Spec.map (CommRingCat.ofHom ιA) := by
    rw [← Spec.map_preimage a₀]
    simp only [wcQuadModelStr, wcQmSp, Category.assoc, ← Spec.map_comp]
    rw [key]
  let ν := hP.lift _ _ E0
  have hν1 : ν ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA)) =
      Spec.map (CommRingCat.ofHom (algebraMap (IsLocalRing.ResidueField B₀)
        (AlgebraicClosure (IsLocalRing.ResidueField B₀)))) ≫
      Spec.map (CommRingCat.ofHom (IsLocalRing.residue B₀)) := hP.lift_fst _ _ _
  have hν2 : ν ≫ Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA)) =
      Spec.map (CommRingCat.ofHom lam) ≫ wcQmSp A' := hP.lift_snd _ _ _
  haveI hmono : Mono (wcQmSp A' ≫ Spec.map (CommRingCat.ofHom ιA)) := by
    have hsurj : Function.Surjective ((IsLocalRing.residue A').comp ιA) := by
      intro z
      obtain ⟨a', rfl⟩ := IsLocalRing.residue_surjective z
      obtain ⟨x, y, rfl⟩ := hgen a'
      refine ⟨x, ?_⟩
      have h0 : IsLocalRing.residue A' (ιA y * π') = 0 :=
