theorem wc_derived_single_ext_comp_bridge {C : Type*} [Category C] [Abelian C]
    (n : ℕ) (hn4 : 4 ≤ n) (X₂ X₃ X₁ : C) :
    letI := HasDerivedCategory.standard C
    letI : HasExt C := HasExt.standard C
    (∀ τ' : Abelian.Ext X₃ X₁ 2, τ' ≠ 0 → ∀ a' : Abelian.Ext X₂ X₁ (n - 2),
      ∃ x' : Abelian.Ext X₂ X₃ (n - 4), a' = x'.comp τ' (by omega)) →
    ∀ τ : (DerivedCategory.singleFunctor C 3).obj X₃ ⟶ (DerivedCategory.singleFunctor C 1).obj X₁,
      τ ≠ 0 →
      ∀ a : (DerivedCategory.singleFunctor C ((n : ℤ) - 1)).obj X₂ ⟶
          (DerivedCategory.singleFunctor C 1).obj X₁,
        ∃ x : (DerivedCategory.singleFunctor C ((n : ℤ) - 1)).obj X₂ ⟶
            (DerivedCategory.singleFunctor C 3).obj X₃,
