by
  classical


  have main : ∀ (K : Type u) [Field K] (d : ℕ) {X : Scheme.{u}} (jE : X ⟶ wcProjK K (d + 1))
      [IsClosedImmersion jE] (G : MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) K 2),
      Prime (G : MvPolynomial (Fin (d + 1 + 1)) K) →
      (∀ (x : X) (k : Fin (d + 1 + 1)) (hx : x ∈ jE ⁻¹ᵁ wcSgD K (d + 1) k),
        wcLdpGerm K (d + 1) jE G k x hx ∈ IsLocalRing.maximalIdeal (X.presheaf.stalk x)) →
      (∀ p : wcProjK K (d + 1), (∀ (k : Fin (d + 1 + 1)) (hp : p ∈ wcSgD K (d + 1) k),
          ((wcProjK K (d + 1)).presheaf.germ (wcSgD K (d + 1) k) p hp).hom
              (wcLdpSec K (d + 1) G k) ∈
            IsLocalRing.maximalIdeal ((wcProjK K (d + 1)).presheaf.stalk p)) →
