    (f : Γ(V.left, ⊤)) (hf : V.left.basicOpen f = V.hom ⁻¹ᵁ O) (x : V.left)
    (hx : HenselianLocalRing (V.left.presheaf.stalk x) ∧ IsSepClosed (V.left.residueField x)) :
    Subsingleton (CommRing.Pic (Localization.Away ((V.left.presheaf.germ ⊤ x trivial).hom f))) :=
by
  classical

  have pic1 : ∀ (D : Type u) [CommRing D] [IsDomain D],
      (∀ a b : D, ∃ l : D, ∀ z : D, (a ∣ z ∧ b ∣ z ↔ l ∣ z)) → Subsingleton (CommRing.Pic D) := by
    intro D _ _ hl
    classical

    have hinj : Function.Injective (algebraMap D (FractionRing D)) := IsFractionRing.injective D (FractionRing D)

    have memS : ∀ (w x : (FractionRing D)), w ∈ (Submodule.span D {x} : Submodule D (FractionRing D)) ↔
        ∃ d : D, algebraMap D (FractionRing D) d * x = w := by
      intro w x
      rw [Submodule.mem_span_singleton]
      simp only [Algebra.smul_def]

    have pair : ∀ x y : (FractionRing D), x ≠ 0 → y ≠ 0 → ∃ z : (FractionRing D), z ≠ 0 ∧ ∀ w : (FractionRing D),
        (w ∈ (Submodule.span D {x} : Submodule D (FractionRing D)) ∧ w ∈ (Submodule.span D {y} : Submodule D (FractionRing D))) ↔
          w ∈ (Submodule.span D {z} : Submodule D (FractionRing D)) := by
      intro x y hx hy
      obtain ⟨p, q, hq, rfl⟩ := IsFractionRing.div_surjective (A := D) x
      obtain ⟨r, t, ht, rfl⟩ := IsFractionRing.div_surjective (A := D) y
      have hq0 : q ≠ 0 := nonZeroDivisors.ne_zero hq
      have ht0 : t ≠ 0 := nonZeroDivisors.ne_zero ht
      have hqK : algebraMap D (FractionRing D) q ≠ 0 := by
        intro h; apply hq0; apply hinj; rw [h, map_zero]
      have htK : algebraMap D (FractionRing D) t ≠ 0 := by
        intro h; apply ht0; apply hinj; rw [h, map_zero]
      have hp0 : p ≠ 0 := by
        rintro rfl; apply hx; rw [map_zero, zero_div]
      have hr0 : r ≠ 0 := by
        rintro rfl; apply hy; rw [map_zero, zero_div]
      obtain ⟨l, hlz⟩ := hl (p * t) (r * q)
      have hl0 : l ≠ 0 := by
        rintro rfl
        have h := (hlz (p * t * (r * q))).mp ⟨dvd_mul_right _ _, dvd_mul_left _ _⟩
        rw [zero_dvd_iff] at h
        exact mul_ne_zero (mul_ne_zero hp0 ht0) (mul_ne_zero hr0 hq0) h
      have hlK : algebraMap D (FractionRing D) l ≠ 0 := by
        intro h; apply hl0; apply hinj; rw [h, map_zero]
      obtain ⟨n₁, hn₁⟩ := ((hlz l).mpr dvd_rfl).1
      obtain ⟨n₂, hn₂⟩ := ((hlz l).mpr dvd_rfl).2
      refine ⟨algebraMap D (FractionRing D) l / (algebraMap D (FractionRing D) q * algebraMap D (FractionRing D) t),
        div_ne_zero hlK (mul_ne_zero hqK htK), fun w => ?_⟩
      rw [memS, memS, memS]
      constructor
      · rintro ⟨⟨d₁, hd₁⟩, ⟨d₂, hd₂⟩⟩
        have he : d₁ * (p * t) = d₂ * (r * q) := by
          apply hinj
          have e1 : algebraMap D (FractionRing D) (d₁ * (p * t)) = w * (algebraMap D (FractionRing D) q * algebraMap D (FractionRing D) t) := by
            rw [← hd₁]; simp only [map_mul]; field_simp
          have e2 : algebraMap D (FractionRing D) (d₂ * (r * q)) = w * (algebraMap D (FractionRing D) q * algebraMap D (FractionRing D) t) := by
            rw [← hd₂]; simp only [map_mul]; field_simp
          rw [e1, e2]
        obtain ⟨m, hm⟩ := (hlz (d₁ * (p * t))).mp ⟨dvd_mul_left _ _, he ▸ dvd_mul_left _ _⟩
        refine ⟨m, ?_⟩
        rw [← hd₁]
        have e3 : algebraMap D (FractionRing D) (d₁ * (p * t)) = algebraMap D (FractionRing D) (l * m) := by rw [hm]
        simp only [map_mul] at e3
        field_simp
        linear_combination -e3
      · rintro ⟨m, hm⟩
        refine ⟨⟨m * n₁, ?_⟩, ⟨m * n₂, ?_⟩⟩
        · rw [← hm]
          have e3 : algebraMap D (FractionRing D) l = algebraMap D (FractionRing D) (p * t * n₁) := by rw [← hn₁]
          simp only [map_mul] at e3 ⊢
          rw [e3]
          field_simp
        · rw [← hm]
          have e3 : algebraMap D (FractionRing D) l = algebraMap D (FractionRing D) (r * q * n₂) := by rw [← hn₂]
          simp only [map_mul] at e3 ⊢
          rw [e3]
          field_simp

    have fin : ∀ T : Finset (FractionRing D), (∀ s ∈ T, s ≠ 0) → T.Nonempty →
        ∃ z : FractionRing D, z ≠ 0 ∧ ∀ w : FractionRing D,
          (∀ s ∈ T, w ∈ (Submodule.span D {s⁻¹} : Submodule D (FractionRing D))) ↔
            w ∈ (Submodule.span D {z} : Submodule D (FractionRing D)) := by
      intro T
      induction T using Finset.induction_on with
      | empty => intro _ h; exact absurd h Finset.not_nonempty_empty
      | insert a T' haT ih =>
        intro h0 _
        have ha : a ≠ 0 := h0 a (Finset.mem_insert_self a T')
        rcases T'.eq_empty_or_nonempty with hT' | hT'
        · subst hT'
          refine ⟨a⁻¹, inv_ne_zero ha, fun w => ?_⟩
          simp
        · obtain ⟨z', hz', hw'⟩ := ih (fun s hs => h0 s (Finset.mem_insert_of_mem hs)) hT'
          obtain ⟨z, hz, hw⟩ := pair a⁻¹ z' (inv_ne_zero ha) hz'
          refine ⟨z, hz, fun w => ?_⟩
          rw [← hw, ← hw', Finset.forall_mem_insert]

    have unitP : ∀ I : (Submodule D (FractionRing D))ˣ,
        I ∈ (Units.map (Submodule.spanSingleton D : FractionRing D →*₀ Submodule D (FractionRing D)).toMonoidHom).range := by
      intro I
      have hIJ : (I : Submodule D (FractionRing D)) * ↑I⁻¹ = 1 := I.mul_inv
      have hJI : (↑I⁻¹ : Submodule D (FractionRing D)) * ↑I = 1 := I.inv_mul
      obtain ⟨S, hS⟩ := Submodule.fg_of_isUnit I.isUnit
      let T := S.filter (· ≠ 0)
      have hT : Submodule.span D (T : Set (FractionRing D)) = I := by
        rw [← hS]
        apply le_antisymm
        · apply Submodule.span_mono
          intro s hs
          exact (Finset.mem_filter.mp hs).1
        · rw [Submodule.span_le]
          intro s hs
          by_cases h : s = 0
          · rw [h]; exact Submodule.zero_mem _
          · exact Submodule.subset_span (Finset.mem_filter.mpr ⟨hs, h⟩)
      have hT0 : ∀ s ∈ T, s ≠ 0 := fun s hs => (Finset.mem_filter.mp hs).2
      have hTne : T.Nonempty := by
        rcases T.eq_empty_or_nonempty with h | h
        · exfalso
          rw [h, Finset.coe_empty, Submodule.span_empty] at hT
          rw [← hT, Submodule.bot_mul] at hIJ
          have h1 : (1 : FractionRing D) ∈ (1 : Submodule D (FractionRing D)) := Submodule.mem_one.mpr ⟨1, map_one _⟩
          rw [← hIJ, Submodule.mem_bot] at h1
          exact one_ne_zero h1
        · exact h
      obtain ⟨z, hz, hzw⟩ := fin T hT0 hTne
      have hJ : (↑I⁻¹ : Submodule D (FractionRing D)) = Submodule.span D {z} := by
        ext w
        rw [← hzw]
        constructor
        · intro hw s hs
          have h1 : w * s ∈ (1 : Submodule D (FractionRing D)) := by
            rw [← hJI]
            refine Submodule.mul_mem_mul hw ?_
            rw [← hT]
            exact Submodule.subset_span hs
          obtain ⟨d, hd⟩ := Submodule.mem_one.mp h1
          rw [memS]
          refine ⟨d, ?_⟩
          rw [hd, mul_assoc, mul_inv_cancel₀ (hT0 s hs), mul_one]
        · intro hw
          have h2 : ∀ v ∈ (I : Submodule D (FractionRing D)), w * v ∈ (1 : Submodule D (FractionRing D)) := by
            intro v hv
            rw [← hT] at hv
            induction hv using Submodule.span_induction with
            | mem v hv =>
              obtain ⟨d, hd⟩ := (memS w _).mp (hw v hv)
              rw [← hd, mul_assoc, inv_mul_cancel₀ (hT0 v hv), mul_one]
              exact Submodule.mem_one.mpr ⟨d, rfl⟩
            | zero => rw [mul_zero]; exact Submodule.zero_mem _
            | add v₁ v₂ _ _ h₁ h₂ => rw [mul_add]; exact Submodule.add_mem _ h₁ h₂
            | smul d v _ h => rw [mul_smul_comm]; exact Submodule.smul_mem _ d h
          have h1 : (1 : FractionRing D) ∈ (I : Submodule D (FractionRing D)) * ↑I⁻¹ := by
            rw [hIJ]; exact Submodule.mem_one.mpr ⟨1, map_one _⟩
          have h3 : w * 1 ∈ (↑I⁻¹ : Submodule D (FractionRing D)) := by
            refine Submodule.mul_induction_on (C := fun r => w * r ∈ (↑I⁻¹ : Submodule D (FractionRing D))) h1 ?_ ?_
            · intro m hm n hn
              obtain ⟨d, hd⟩ := Submodule.mem_one.mp (h2 m hm)
              rw [← mul_assoc, ← hd, ← Algebra.smul_def]
              exact Submodule.smul_mem _ d hn
            · intro a b ha hb
              rw [mul_add]; exact Submodule.add_mem _ ha hb
          rwa [mul_one] at h3
      refine ⟨Units.mk0 z⁻¹ (inv_ne_zero hz), ?_⟩
      apply Units.ext
      rw [Units.coe_map]
      show Submodule.spanSingleton D z⁻¹ = (I : Submodule D (FractionRing D))
      have e1 : Submodule.spanSingleton D z * Submodule.spanSingleton D z⁻¹ =
          (1 : Submodule D (FractionRing D)) := by
        rw [← map_mul, mul_inv_cancel₀ hz, map_one]
      have e2 : (I : Submodule D (FractionRing D)) * Submodule.spanSingleton D z = 1 := by
        rw [Submodule.spanSingleton_apply, ← hJ, hIJ]
      calc Submodule.spanSingleton D z⁻¹ = 1 * Submodule.spanSingleton D z⁻¹ := (one_mul _).symm
        _ = (I : Submodule D (FractionRing D)) * Submodule.spanSingleton D z * Submodule.spanSingleton D z⁻¹ := by rw [e2]
        _ = I := by rw [mul_assoc, e1, mul_one]

    have hall : ∀ P : CommRing.Pic D, P = 1 := by
      intro P
      have hP : P ∈ CommRing.relPic D (FractionRing D) := by
        rw [CommRing.relPic_eq_top]; trivial
      rw [← Submodule.range_unitsToPic] at hP
      obtain ⟨I, rfl⟩ := hP
      have hk : I ∈ (Submodule.unitsToPic D (FractionRing D)).ker := by
        rw [Submodule.ker_unitsToPic]; exact unitP I
      exact hk
    exact ⟨fun a b => (hall a).trans (hall b).symm⟩


  have lcm2 : ∀ (D : Type u) [CommRing D] [IsDomain D],
      (∀ a b : D, ∃ l : D, ∀ z : D, (a ∣ z ∧ b ∣ z ↔ l ∣ z)) → ∀ (s : D), s ≠ 0 →
      IsDomain (Localization.Away s) ∧ ∀ a b : Localization.Away s, ∃ l : Localization.Away s,
        ∀ z : Localization.Away s, (a ∣ z ∧ b ∣ z ↔ l ∣ z) := by
    intro D _ _ hl s hs
    have hle : Submonoid.powers s ≤ nonZeroDivisors D := powers_le_nonZeroDivisors_of_noZeroDivisors hs
    have hinj : Function.Injective (algebraMap D (Localization.Away s)) :=
      IsLocalization.injective (Localization.Away s) hle
    have hu : IsUnit (algebraMap D (Localization.Away s) s) := IsLocalization.Away.algebraMap_isUnit s
    refine ⟨IsLocalization.isDomain_of_le_nonZeroDivisors (Localization.Away s) hle, fun a b => ?_⟩
    obtain ⟨n, a₀, ha₀⟩ := IsLocalization.Away.surj s a
    obtain ⟨m, b₀, hb₀⟩ := IsLocalization.Away.surj s b
    obtain ⟨l₀, hl₀⟩ := hl a₀ b₀
    refine ⟨algebraMap D (Localization.Away s) l₀, fun z => ?_⟩
    have hA : Associated a (algebraMap D (Localization.Away s) a₀) := by
      rw [← ha₀]; exact associated_mul_unit_right a _ (hu.pow n)
    have hB : Associated b (algebraMap D (Localization.Away s) b₀) := by
      rw [← hb₀]; exact associated_mul_unit_right b _ (hu.pow m)
    rw [hA.dvd_iff_dvd_left, hB.dvd_iff_dvd_left]
    constructor
    · rintro ⟨⟨w₁, hw₁⟩, ⟨w₂, hw₂⟩⟩
      obtain ⟨n₁, c₁, hc₁⟩ := IsLocalization.Away.surj s w₁
      obtain ⟨n₂, c₂, hc₂⟩ := IsLocalization.Away.surj s w₂
      have he : a₀ * c₁ * s ^ n₂ = b₀ * c₂ * s ^ n₁ := by
        apply hinj
        simp only [map_mul, map_pow]
        rw [← hc₁, ← hc₂]
        calc algebraMap D (Localization.Away s) a₀ * (w₁ * algebraMap D (Localization.Away s) s ^ n₁) *
              algebraMap D (Localization.Away s) s ^ n₂
            = (algebraMap D (Localization.Away s) a₀ * w₁) * (algebraMap D (Localization.Away s) s ^ n₁ *
              algebraMap D (Localization.Away s) s ^ n₂) := by ring
          _ = (algebraMap D (Localization.Away s) b₀ * w₂) * (algebraMap D (Localization.Away s) s ^ n₁ *
              algebraMap D (Localization.Away s) s ^ n₂) := by rw [← hw₁, ← hw₂]
          _ = _ := by ring
      have hdvd : l₀ ∣ a₀ * c₁ * s ^ n₂ :=
        (hl₀ _).mp ⟨by rw [mul_assoc]; exact dvd_mul_right _ _, by rw [he, mul_assoc]; exact dvd_mul_right _ _⟩
      have h2 := map_dvd (algebraMap D (Localization.Away s)) hdvd
      have h3 : algebraMap D (Localization.Away s) (a₀ * c₁ * s ^ n₂) =
          z * algebraMap D (Localization.Away s) (s ^ (n₁ + n₂)) := by
        simp only [map_mul, map_pow]
        rw [← hc₁, hw₁]
        ring
      rw [h3] at h2
      exact (IsUnit.dvd_mul_right (by rw [map_pow]; exact hu.pow _)).mp h2
    · intro h
      have h1 := (hl₀ l₀).mpr dvd_rfl
      exact ⟨(map_dvd _ h1.1).trans h, (map_dvd _ h1.2).trans h⟩


  have lcm3 : ∀ (S R : Type u) [CommRing S] [CommRing R] [IsLocalRing R] (σ : S →+* R),
      wcIndEtale σ →
      (∀ (E : Type u) [CommRing E] [Algebra S E], Algebra.Etale S E → ∀ (q : Ideal E) [q.IsPrime],
        IsDomain (Localization.AtPrime q) ∧ UniqueFactorizationMonoid (Localization.AtPrime q)) →
      IsDomain R ∧ ∀ a b : R, ∃ l : R, ∀ z : R, (a ∣ z ∧ b ∣ z ↔ l ∣ z) := by
    intro S R _ _ _ σ hσ H
    classical
    letI : Algebra S R := σ.toAlgebra
    have hWE : Algebra.WeaklyEtale S R := wc_indEtale_weaklyEtale σ hσ

    have F : ∀ a b : R, ∃ (E : Type u) (_ : CommRing E) (_ : Algebra S E) (_ : Algebra.Etale S E)
        (β : E →ₐ[S] R) (e₀ e₁ : E), β e₀ = a ∧ β e₁ = b := by
      intro a b
      obtain ⟨E, _, _, hEt, α, β, hβα⟩ := hσ (MvPolynomial (Fin 2) S) (MvPolynomial.aeval ![a, b])
      refine ⟨E, _, _, hEt, β, α (MvPolynomial.X 0), α (MvPolynomial.X 1), ?_, ?_⟩
      · rw [← AlgHom.comp_apply, hβα]; simp
      · rw [← AlgHom.comp_apply, hβα]; simp

    have K : ∀ (E : Type u) [CommRing E] [Algebra S E] [Algebra.Etale S E] (β : E →ₐ[S] R),
        ∃ (L : Type u) (_ : CommRing L) (_ : IsDomain L) (_ : UniqueFactorizationMonoid L)
          (ι : E →+* L) (β' : L →+* R), (∀ e, β' (ι e) = β e) ∧
          ∀ (n : ℕ) (f : Fin n → E) (x : Fin n → R), ∑ i, β (f i) * x i = 0 →
            ∃ (k : ℕ) (A : Fin n → Fin k → E) (y : Fin k → R),
              (∀ i, x i = ∑ j, β (A i j) * y j) ∧ ∀ j, ∑ i, f i * A i j = 0 := by
      intro E _ _ _ β
      letI : Algebra E R := (β : E →+* R).toAlgebra
      haveI : IsScalarTower S E R := IsScalarTower.of_algebraMap_eq' β.comp_algebraMap.symm
      haveI hER : Algebra.WeaklyEtale E R := wc_weaklyEtale_cancel S E R inferInstance hWE
      haveI : Module.Flat E R := inferInstance
      let q : Ideal E := Ideal.comap (β : E →+* R) (IsLocalRing.maximalIdeal R)
      haveI : q.IsPrime := Ideal.comap_isPrime _ _
      obtain ⟨hLd, hLu⟩ := H E inferInstance q
      have hunit : ∀ s : q.primeCompl, IsUnit ((β : E →+* R) (s : E)) := by
        intro s
        exact IsLocalRing.notMem_maximalIdeal.mp
          (fun hm => (Ideal.mem_primeCompl_iff.mp s.2) (Ideal.mem_comap.mpr hm))
      refine ⟨Localization.AtPrime q, inferInstance, hLd, hLu, algebraMap E _,
        IsLocalization.lift (M := q.primeCompl) (S := Localization.AtPrime q) hunit,
        fun e => IsLocalization.lift_eq hunit e, ?_⟩
      intro n f x hfx
      have h0 : ∑ i, f i • x i = 0 := hfx
      have h3 : Module.IsTrivialRelation f x :=
        @Module.Flat.isTrivialRelation_of_sum_smul_eq_zero E R _ _ _ inferInstance (Fin n) _ f x h0
      unfold Module.IsTrivialRelation at h3
      obtain ⟨k, A, y, h1, h2⟩ := h3
      exact ⟨k, A, y, fun i => (h1 i).trans (Finset.sum_congr rfl (fun j _ => Algebra.smul_def _ _)), h2⟩

    have hnzd : NoZeroDivisors R := by
      refine ⟨fun {a b} hab => ?_⟩
      obtain ⟨E, _, _, _, β, e₀, e₁, he₀, he₁⟩ := F a b
      obtain ⟨L, _, _, _, ι, β', hβ', hflat⟩ := K E β
      obtain ⟨k, A, y, h1, h2⟩ := hflat 1 ![e₀] ![b] (by simp [he₀, hab])
      by_cases h : ι e₀ = 0
      · left; rw [← he₀, ← hβ', h, map_zero]
      · right
        have hb := h1 0
        simp only [Matrix.cons_val_zero] at hb
        rw [hb]
        apply Finset.sum_eq_zero
        intro j _
        have hj := h2 j
        simp only [Finset.univ_unique, Fin.default_eq_zero, Finset.sum_singleton,
          Matrix.cons_val_zero] at hj
        have hj' : ι e₀ * ι (A 0 j) = 0 := by rw [← map_mul, hj, map_zero]
        have hA : ι (A 0 j) = 0 := (mul_eq_zero.mp hj').resolve_left h
        rw [← hβ', hA, map_zero, zero_mul]
    refine ⟨NoZeroDivisors.to_isDomain R, fun a b => ?_⟩
    obtain ⟨E, _, _, _, β, e₀, e₁, he₀, he₁⟩ := F a b
    obtain ⟨L, _, _, _, ι, β', hβ', hflat⟩ := K E β
    letI : GCDMonoid L := UniqueFactorizationMonoid.toGCDMonoid L
    refine ⟨β' (lcm (ι e₀) (ι e₁)), fun z => ⟨?_, ?_⟩⟩
    · rintro ⟨⟨r₁, hr₁⟩, ⟨r₂, hr₂⟩⟩
      obtain ⟨k, A, y, h1, h2⟩ := hflat 2 ![e₀, -e₁] ![r₁, r₂] (by
        simp only [Fin.sum_univ_two, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons,
          map_neg, he₀, he₁]
        rw [← hr₁, neg_mul, ← hr₂, add_neg_cancel])
      have hr := h1 0
      simp only [Matrix.cons_val_zero] at hr
      rw [hr₁, hr, Finset.mul_sum]
      apply Finset.dvd_sum
      intro j _
      have hj := h2 j
      simp only [Fin.sum_univ_two, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons,
        neg_mul] at hj
      have hj' : e₀ * A 0 j = e₁ * A 1 j := by rw [← sub_eq_zero, sub_eq_add_neg]; exact hj
      have hd : lcm (ι e₀) (ι e₁) ∣ ι (e₀ * A 0 j) := by
        rw [lcm_dvd_iff]
        constructor
        · rw [map_mul]; exact dvd_mul_right _ _
        · rw [hj', map_mul]; exact dvd_mul_right _ _
      have hd' := map_dvd β' hd
      rw [hβ', map_mul, he₀] at hd'
      rw [← mul_assoc]
      exact dvd_mul_of_dvd_left hd' _
    · intro h
      constructor
      · refine dvd_trans ?_ h
        rw [← he₀, ← hβ']
        exact map_dvd β' (dvd_lcm_left _ _)
      · refine dvd_trans ?_ h
        rw [← he₁, ← hβ']
        exact map_dvd β' (dvd_lcm_right _ _)


  have hF : ∀ (K : Type u) [Field K], IsRegularLocalRing K := fun _ _ => inferInstance
  have s9 : ∀ (R S : Type u) [CommRing R] [CommRing S] (e : R ≃+* S) (Q : Ideal R) [Q.IsPrime]
      (Q' : Ideal S) [Q'.IsPrime], Q' = Q.map e →
      Nonempty (Localization.AtPrime Q ≃+* Localization.AtPrime Q') := by
    intro R S _ _ e Q _ Q' _ hQ
    refine ⟨IsLocalization.ringEquivOfRingEquiv (M := Q.primeCompl) (T := Q'.primeCompl)
      (Localization.AtPrime Q) (Localization.AtPrime Q') e ?_⟩
    subst hQ
    ext s
    rw [Submonoid.mem_map]
    constructor
    · rintro ⟨t, ht, hts⟩
      refine Ideal.mem_primeCompl_iff.mpr (fun hmem => ?_)
      rw [Ideal.mem_map_of_equiv] at hmem
      obtain ⟨t', ht', h⟩ := hmem
      have htt : t' = t := e.injective (h.trans hts.symm)
      exact (Ideal.mem_primeCompl_iff.mp ht) (htt ▸ ht')
    · intro hs
      refine ⟨e.symm s, Ideal.mem_primeCompl_iff.mpr (fun h => ?_), ?_⟩
      · apply Ideal.mem_primeCompl_iff.mp hs
        rw [Ideal.mem_map_of_equiv]
