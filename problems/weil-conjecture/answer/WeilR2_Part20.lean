theorem wc_et_split_quadric_high_card_le : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (ℓ : ℕ) [Fact (Nat.Prime ℓ)], (ℓ : Ω) ≠ 0 → ∀ (d : ℕ), Even d → 2 ≤ d → ∀ (Y : Scheme.{u}) (fY : Y ⟶ Spec (.of Ω)) [IsProper fY] [SmoothOfRelativeDimension d fY] (jY : Y ⟶ wcProjK Ω (d + 1)), IsClosedImmersion jY → jY ≫ wcProjKStr Ω (d + 1) = fY → (∀ (x : Y) (c : Fin (d + 1 + 1)) (hx : x ∈ jY ⁻¹ᵁ wcSgD Ω (d + 1) c), wcLdpGerm Ω (d + 1) jY (wcLdpQuad Ω (d + 1) (fun p q : Fin (d + 1 + 1) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : Ω) else 0)) c x hx ∈ IsLocalRing.maximalIdeal (Y.presheaf.stalk x)) → Finite (wcEtZModExt Y ℓ (d + 2)) ∧ Nat.card (wcEtZModExt Y ℓ (d + 2)) ≤ ℓ :=
by
  classical
  intro Ω _ _ ℓ _ hℓ d hd hd2 Y fY _ _ jY hjY hjYfY hEG
  have hℓp : ℓ.Prime := Fact.out
  obtain ⟨t, ht⟩ := hd
  have hN : d + 2 = 0 + 2 * (d / 2 + 1) := by omega
  rw [hN]

  by_cases hYe : IsEmpty Y
  · have hdim : topologicalKrullDim Y ≤ ((0 : ℕ) : WithBot ℕ∞) := by
      have h0 : topologicalKrullDim Y = ⊥ := by
        unfold topologicalKrullDim
        rw [Order.krullDim_eq_bot_iff]
        constructor
        intro s
        obtain ⟨x, -⟩ := s.isIrreducible.nonempty
        exact hYe.false x
      rw [h0]; exact bot_le
    haveI hS := wc_et_zero_dim_vanishing Ω Y fY hdim ℓ hℓp.ne_zero (0 + 2 * (d / 2 + 1)) (by omega)
    obtain ⟨eN⟩ := wc_et_zmodext_coh_equiv Y ℓ (0 + 2 * (d / 2 + 1))
    haveI hS' : Subsingleton (wcEtZModExt Y ℓ (0 + 2 * (d / 2 + 1))) := eN.subsingleton
    haveI hF : Finite (wcEtZModExt Y ℓ (0 + 2 * (d / 2 + 1))) := Finite.of_subsingleton
    exact ⟨hF, (Finite.card_le_one_iff_subsingleton.mpr hS').trans hℓp.one_lt.le⟩
  rw [not_isEmpty_iff] at hYe

  haveI hstalkred : ∀ x : Y, _root_.IsReduced (Y.presheaf.stalk x) := by
    intro x
    haveI := wcpa_smooth_stalk_isDomain Ω Y fY d x
    infer_instance
  haveI hYred : AlgebraicGeometry.IsReduced Y := isReduced_of_isReduced_stalk Y

  have hdet : (Matrix.of (fun p q : Fin (d + 1 + 1) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : Ω) else 0) +
      (Matrix.of (fun p q : Fin (d + 1 + 1) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : Ω) else 0)).transpose).det ≠ 0 := by
    let f : Fin (d + 1 + 1) → Fin (d + 1 + 1) := fun p =>
      ⟨if p.val % 2 = 0 then p.val + 1 else p.val - 1, by split_ifs <;> omega⟩
    have hf : Function.Involutive f := by
      intro p
      apply Fin.ext
      simp only [f]
      split_ifs <;> omega
    have hS : Matrix.of (fun p q : Fin (d + 1 + 1) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : Ω) else 0) +
        (Matrix.of (fun p q : Fin (d + 1 + 1) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : Ω) else 0)).transpose =
        Equiv.Perm.permMatrix Ω (Function.Involutive.toPerm f hf) := by
      ext p q
      simp only [Matrix.add_apply, Matrix.of_apply, Matrix.transpose_apply, Equiv.Perm.permMatrix,
        PEquiv.toMatrix_apply, Equiv.toPEquiv_apply, Option.mem_def, Option.some.injEq,
        Function.Involutive.coe_toPerm, f, Fin.ext_iff]
      split_ifs <;> first | omega | norm_num
    rw [hS, Matrix.det_permutation]
    rcases Int.units_eq_one_or (Equiv.Perm.sign (Function.Involutive.toPerm f hf)) with h | h <;>
