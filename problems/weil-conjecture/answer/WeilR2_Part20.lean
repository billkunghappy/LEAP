import WeilR2_Part19
set_option maxHeartbeats 4000000

open CategoryTheory AlgebraicGeometry

theorem wc_et_smooth_divisor_supp_pairing_left : ∀ (K : Type u) [Field K] [IsAlgClosed K] (Y : Scheme.{u}) (f : Y ⟶ Spec (.of K)) [IsProper f] (N : ℕ) [SmoothOfRelativeDimension N f], 1 ≤ N → ∀ (Z : Scheme.{u}) (ι : Z ⟶ Y) [IsClosedImmersion ι] [SmoothOfRelativeDimension (N - 1) (ι ≫ f)] (m : ℕ), (m : K) ≠ 0 → ∀ (D : wcEtPullData ι m) (p q : ℕ) (h : p + q = 2 * N), letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Y m)) := HasExt.standard _; ∀ b : Abelian.Ext (SheafOfModules.unit (wcEtZModRing Y m)) (wcEtSuppObj D) p, (∀ θ : wcEtSuppExt D q, b.comp θ h = 0) → b = 0 :=
by
  intro K _ _ Y f _ N _ hN Z ι _ _ m hm D p q h
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Y m)) := HasExt.standard _
  intro b hb
  haveI : IsProper (ι ≫ f) := inferInstance
  obtain ⟨T, M, hT, hmul⟩ := wc_et_supp_unit_ext_transfer ι m D
  obtain ⟨c, rfl⟩ := (hT p).2 b
  by_cases hp : p ≤ 2 * (N - 1)
  · obtain ⟨r, hr⟩ : ∃ r, p + r = 2 * (N - 1) := ⟨2 * (N - 1) - p, by omega⟩
    obtain rfl : q = r + 2 := by omega
    have h' : 2 * (N - 1) + 2 = 2 * N := by omega
    have hA : ∀ w : wcEtZModExt Z m r, wcEtZModCup Z m p r (2 * (N - 1)) hr c w = 0 := by
      intro w
      have hb' := wc_et_smooth_divisor_supp_pairing_top K Y f N hN Z ι m hm D h'
        (T (2 * (N - 1)) (wcEtZModCup Z m p r (2 * (N - 1)) hr c w)) (by
          intro θ'
          have e1 := hmul p r (2 * (N - 1)) hr c w
          have e2 := Abelian.Ext.comp_assoc (T p c) (M r w) θ' hr rfl
            (show p + r + 2 = 2 * N by omega)
          rw [← e1, e2]
          exact hb _)
      apply (hT (2 * (N - 1))).1
      rw [hb', map_zero]
    obtain ⟨tr, hl, -⟩ := wc_et_zmod_poincare_trace_perfect K Z (ι ≫ f) (N - 1) m hm
    have hc : c = 0 := hl p r hr c (fun w => by rw [hA w, map_zero])
    rw [hc, map_zero]
  · have hc : c = 0 :=
      wc_et_zmodext_proper_smooth_vanish_above K Z (ι ≫ f) (N - 1) m hm p (by omega) c
    rw [hc, map_zero]

theorem wc_et_extzero_vanish_of_smooth_divisor_dual_vanish (K : Type u) [Field K] [IsAlgClosed K]
    (Y : Scheme.{u}) (f : Y ⟶ Spec (.of K)) [IsProper f] (N : ℕ) [SmoothOfRelativeDimension N f]
    (hN : 1 ≤ N) (Z : Scheme.{u}) (ι : Z ⟶ Y) [IsClosedImmersion ι]
    [SmoothOfRelativeDimension (N - 1) (ι ≫ f)]
    (U : Y.Opens) (hU : (U : Set Y) = (Set.range ι)ᶜ) (m : ℕ) (hm : (m : K) ≠ 0)
    (i : ℕ) (hi : i ≤ 2 * N) (h : Subsingleton (wcEtCoh (U : Scheme.{u}) m (2 * N - i))) :
    Subsingleton (wcEtExt Y (wcEtExtZero Y (U : Set Y) m) i) :=
by
  classical
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Y m)) := HasExt.standard _
  have hm0 : 0 < m := Nat.pos_of_ne_zero (fun h0 => hm (by rw [h0, Nat.cast_zero]))
  obtain ⟨D⟩ := wc_et_zmod_pull_data_exists ι m
  set u' := wcEtSuppUnitMap D with hu'
  haveI hepi : Epi u' := wc_et_supp_unit_epi ι D
  have hS : (ShortComplex.mk (Limits.kernel.ι u') u' (Limits.kernel.condition u')).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_kernel u') inferInstance hepi

  have he₀ : Nonempty ((SheafOfModules.toSheaf (wcEtZModRing Y m)).obj (Limits.kernel u') ≅
      wcEtExtZero Y (U : Set Y) m) := by
    rw [hU]; exact wc_et_supp_unit_ker_extZero_iso ι m D

  haveI := h
  obtain ⟨E4⟩ := wc_et_extzero_module_ext_open_coh Y U m hm0 (Limits.kernel u') he₀ (2 * N - i)
  have hV1 : Subsingleton (Abelian.Ext (Limits.kernel u')
      (SheafOfModules.unit (wcEtZModRing Y m)) (2 * N - i)) := E4.subsingleton

  have G1 : ∀ w : Abelian.Ext (SheafOfModules.unit (wcEtZModRing Y m))
      (SheafOfModules.unit (wcEtZModRing Y m)) (2 * N - i),
      ∃ θ : Abelian.Ext (wcEtSuppObj D) (SheafOfModules.unit (wcEtZModRing Y m)) (2 * N - i),
        (Abelian.Ext.mk₀ u').comp θ (zero_add _) = w := by
    intro w
    exact Abelian.Ext.contravariant_sequence_exact₂ hS _ w (@Subsingleton.elim _ hV1 _ _)

  have G2 : ∀ θ : Abelian.Ext (wcEtSuppObj D) (SheafOfModules.unit (wcEtZModRing Y m))
      (2 * N - i + 1), (Abelian.Ext.mk₀ u').comp θ (zero_add _) = 0 → θ = 0 := by
    intro θ hθ
    obtain ⟨x₁, hx₁⟩ :=
      Abelian.Ext.contravariant_sequence_exact₃ hS _ θ hθ (add_comm 1 (2 * N - i))
    rw [← hx₁, @Subsingleton.elim _ hV1 x₁ 0, Abelian.Ext.comp_zero]

  obtain ⟨tr, htr1, htr2⟩ := wc_et_zmod_poincare_trace_perfect K Y f N m hm
  have hcup : ∀ (p q : ℕ) (h' : p + q = 2 * N) (α : wcEtZModExt Y m p) (w : wcEtZModExt Y m q),
      wcEtZModCup Y m p q (2 * N) h' α w = α.comp w h' := by
    intros; rfl
  have hk : i + (2 * N - i) = 2 * N := by omega

  have s8 : ∀ α : Abelian.Ext (SheafOfModules.unit (wcEtZModRing Y m))
      (SheafOfModules.unit (wcEtZModRing Y m)) i,
      α.comp (Abelian.Ext.mk₀ u') (add_zero i) = 0 → α = 0 := by
    intro α hα
    apply htr1 i (2 * N - i) hk α
    intro w
    obtain ⟨θ, rfl⟩ := G1 w
    rw [hcup, ← Abelian.Ext.comp_assoc α (Abelian.Ext.mk₀ u') θ (add_zero i) (zero_add _)
      (show i + 0 + (2 * N - i) = 2 * N by omega), hα, Abelian.Ext.zero_comp, map_zero]

  have s9 : ∀ (j : ℕ), j + 1 = i → ∀ b : Abelian.Ext (SheafOfModules.unit (wcEtZModRing Y m))
      (wcEtSuppObj D) j,
      ∃ α : Abelian.Ext (SheafOfModules.unit (wcEtZModRing Y m))
        (SheafOfModules.unit (wcEtZModRing Y m)) j,
        α.comp (Abelian.Ext.mk₀ u') (add_zero j) = b := by
    intro j hj b
    have hjk : j + (2 * N - i + 1) = 2 * N := by omega
    let G : Abelian.Ext (wcEtSuppObj D) (SheafOfModules.unit (wcEtZModRing Y m)) (2 * N - i + 1) →+
        Abelian.Ext (SheafOfModules.unit (wcEtZModRing Y m))
          (SheafOfModules.unit (wcEtZModRing Y m)) (2 * N - i + 1) :=
      (Abelian.Ext.mk₀ u').precomp _ (zero_add _)
    have hGinj : Function.Injective G := by
      rw [injective_iff_map_eq_zero]
      intro θ hθ
      exact G2 θ hθ
    let ψ : Abelian.Ext (wcEtSuppObj D) (SheafOfModules.unit (wcEtZModRing Y m)) (2 * N - i + 1) →+
        AddCircle (1 : ℚ) :=
      tr.comp (b.precomp _ hjk)
    obtain ⟨φ, hφ⟩ := CharacterModule.dual_surjective_of_injective (R := ℤ) G.toIntLinearMap
      hGinj ψ
    have hφθ : ∀ θ', φ (G θ') = tr (b.comp θ' hjk) := fun θ' => DFunLike.congr_fun hφ θ'
    obtain ⟨α, hα⟩ := htr2 j (2 * N - i + 1) hjk φ
    refine ⟨α, ?_⟩
    rw [← sub_eq_zero]
    have key : ∀ θ' : Abelian.Ext (wcEtSuppObj D) (SheafOfModules.unit (wcEtZModRing Y m))
        (2 * N - i + 1), tr ((α.comp (Abelian.Ext.mk₀ u') (add_zero j) - b).comp θ' hjk) = 0 := by
      intro θ'
      have hsub : (α.comp (Abelian.Ext.mk₀ u') (add_zero j) - b).comp θ' hjk =
          (α.comp (Abelian.Ext.mk₀ u') (add_zero j)).comp θ' hjk - b.comp θ' hjk := by
        have e := congrArg (fun F => F θ') (map_sub (Abelian.Ext.bilinearComp
          (SheafOfModules.unit (wcEtZModRing Y m)) (wcEtSuppObj D)
          (SheafOfModules.unit (wcEtZModRing Y m)) j (2 * N - i + 1) (2 * N) hjk)
          (α.comp (Abelian.Ext.mk₀ u') (add_zero j)) b)
        first
          | exact e
          | simpa using e
      rw [hsub, map_sub,
        Abelian.Ext.comp_assoc α (Abelian.Ext.mk₀ u') θ' (add_zero j) (zero_add _)
          (show j + 0 + (2 * N - i + 1) = 2 * N by omega)]
      have e1 := hα (G θ')
      rw [hcup] at e1
      rw [sub_eq_zero]
      exact e1.trans (hφθ θ')
    apply wc_et_smooth_divisor_supp_pairing_left K Y f N hN Z ι m hm D j (2 * N - i + 1) hjk
    intro θ
    apply htr1 (2 * N) 0 (add_zero _)
    intro c
    rw [hcup, Abelian.Ext.comp_assoc _ θ c hjk (add_zero _)
      (show j + (2 * N - i + 1) + 0 = 2 * N by omega)]
    exact key _

  have s10 : ∀ x : Abelian.Ext (SheafOfModules.unit (wcEtZModRing Y m)) (Limits.kernel u') i,
      x = 0 := by
    intro x
    have hy : x.comp (Abelian.Ext.mk₀ (Limits.kernel.ι u')) (add_zero i) = 0 := by
      apply s8
      rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀,
        Limits.kernel.condition, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
    rcases Nat.eq_zero_or_pos i with hi0 | hi0
    · subst hi0
      obtain ⟨g, rfl⟩ := (Abelian.Ext.mk₀_bijective _ _).2 x
      rw [Abelian.Ext.mk₀_comp_mk₀] at hy
      have hg : g ≫ Limits.kernel.ι u' = 0 :=
        (Abelian.Ext.mk₀_bijective _ _).1 (hy.trans (Abelian.Ext.mk₀_zero _ _).symm)
      have hg0 : g = 0 := (cancel_mono (Limits.kernel.ι u')).1 (hg.trans Limits.zero_comp.symm)
      rw [hg0, Abelian.Ext.mk₀_zero]
    · obtain ⟨x₃, hx₃⟩ := Abelian.Ext.covariant_sequence_exact₁ _ hS x hy (Nat.sub_add_cancel hi0)
      obtain ⟨α, hα⟩ := s9 (i - 1) (Nat.sub_add_cancel hi0) x₃
      rw [← hx₃, ← hα, Abelian.Ext.comp_assoc α (Abelian.Ext.mk₀ u') hS.extClass (add_zero _)
        (zero_add _) (show i - 1 + 0 + 1 = i by omega), hS.comp_extClass, Abelian.Ext.comp_zero]

  haveI hsubK : Subsingleton (Abelian.Ext (SheafOfModules.unit (wcEtZModRing Y m))
      (Limits.kernel u') i) := ⟨fun a b => (s10 a).trans (s10 b).symm⟩
  obtain ⟨e₀⟩ := he₀
  obtain ⟨E11⟩ := wc_et_zmod_modext_toSheaf_equiv Y m hm0 (Limits.kernel u') i
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
  haveI hsub1 : Subsingleton (Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y)
      AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)))
      ((SheafOfModules.toSheaf (wcEtZModRing Y m)).obj (Limits.kernel u')) i) :=
    E11.symm.subsingleton
  show Subsingleton (Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y)
      AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)))
      (wcEtExtZero Y (U : Set Y) m) i)
  have key : ∀ a : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y)
      AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)))
      (wcEtExtZero Y (U : Set Y) m) i,
      a = (a.comp (Abelian.Ext.mk₀ e₀.inv) (add_zero i)).comp (Abelian.Ext.mk₀ e₀.hom)
        (add_zero i) := by
    intro a
    rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id,
      Abelian.Ext.comp_mk₀_id]
  constructor
  intro a b
  rw [key a, key b]
  congr 1
  exact Subsingleton.elim _ _

theorem wc_et_push_extZero_iso_of_univ_inj : ∀ {T Y : Scheme.{u}} (τ : T ⟶ Y) [IsIntegralHom τ]
    [UniversallyInjective τ] (S : Set Y), IsOpen S → S ⊆ Set.range τ → ∀ m : ℕ,
    Nonempty ((wcEtPush τ).obj (wcEtExtZero T (τ ⁻¹' S) m) ≅ wcEtExtZero Y S m) :=
by
  intro T Y τ _ _ S hS hSsub m

  have hcov : ∀ (Z : Scheme.{u}) (V : Z.Etale) (R : Sieve V), (∀ v : V.left, ∃ (V₁ : Z.Etale)
      (c : V₁ ⟶ V), R.arrows c ∧ v ∈ Set.range c.left) → R ∈ Scheme.smallEtaleTopology Z V := by
    intro Z V R hR
    change R ∈ Scheme.smallGrothendieckTopology @Etale Z V
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Z
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
    apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Z
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
    intro x
    obtain ⟨V₁, c, hc, y, hy⟩ := hR x
    have hw : c.left ≫ V.hom = V₁.hom := MorphismProperty.Over.w c
    have hEt : Etale c.left := by
      have h1 : Etale V.hom := V.prop
      have h2 : Etale (c.left ≫ V.hom) := by rw [hw]; exact V₁.prop
      exact Etale.of_comp c.left V.hom
    exact ⟨V₁, c, y, hc, hEt, hy⟩
  have hcovR : ∀ (Z : Scheme.{u}) (V : Z.Etale) (R : Sieve V), R ∈ Scheme.smallEtaleTopology Z V →
      ∀ v : V.left, ∃ (V₁ : Z.Etale) (c : V₁ ⟶ V), R.arrows c ∧ v ∈ Set.range c.left := by
    intro Z V R hR v
    change R ∈ Scheme.smallGrothendieckTopology @Etale Z V at hR
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Z
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hR
    obtain ⟨V₁, c, y, hc, _, hy⟩ := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Z
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mp hR v
    exact ⟨V₁, c, hc, y, hy⟩
  have hEtArr : ∀ (Z : Scheme.{u}) (A B : Z.Etale) (c : A ⟶ B), Etale c.left := by
    intro Z A B c
    have hw : c.left ≫ B.hom = A.hom := MorphismProperty.Over.w c
    have h1 : Etale B.hom := B.prop
    have h2 : Etale (c.left ≫ B.hom) := by rw [hw]; exact A.prop
    exact Etale.of_comp c.left B.hom

  have s2 : ∀ (Z : Scheme.{u}) (G : Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1})
      (U : Z.Etale) (s : G.obj.obj (Opposite.op U)), (∀ p : U.left, ∃ (T : Z.Etale) (h : T ⟶ U)
        (t : T.left), h.left t = p ∧ (G.obj.map h.op).hom s = 0) → s = 0 := by
    intro Z G U s hloc
    have hsep := G.isSeparated
    rw [Presheaf.IsSeparated.eq_1] at hsep
    refine hsep U (Presheaf.equalizerSieve (F := G.obj) (X := Opposite.op U) s 0) ?_ s 0 ?_
    · apply hcov
      intro p
      obtain ⟨T, h, t, ht, hs⟩ := hloc p
      refine ⟨T, h, ?_, t, ht⟩
      rw [Presheaf.equalizerSieve_apply, map_zero]
      exact hs
    · intro T f hf
      rw [Presheaf.equalizerSieve_apply] at hf
      exact hf

  have s3 : ∀ (Z : Scheme.{u}) (G : Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1})
      {U U' : Z.Etale} (k : U' ⟶ U) (s : G.obj.obj (Opposite.op U)) (p' : U'.left),
      (∃ (T : Z.Etale) (h : T ⟶ U) (t : T.left), h.left t = k.left p' ∧
        (G.obj.map h.op).hom s = 0) →
      ∃ (T' : Z.Etale) (h' : T' ⟶ U') (t' : T'.left), h'.left t' = p' ∧
        (G.obj.map h'.op).hom ((G.obj.map k.op).hom s) = 0 := by
    intro Z G U U' k s p' hex
    obtain ⟨T, h, t, ht, hs⟩ := hex
    haveI := hEtArr Z T U h
    haveI : Etale U'.hom := U'.prop
    let T' : Z.Etale := MorphismProperty.Over.mk ⊤
      (Limits.pullback.snd h.left k.left ≫ U'.hom) inferInstance
    let h' : T' ⟶ U' := MorphismProperty.Over.homMk (Limits.pullback.snd h.left k.left) rfl trivial
    let f₁ : T' ⟶ T := MorphismProperty.Over.homMk (Limits.pullback.fst h.left k.left) (by
      change Limits.pullback.fst h.left k.left ≫ T.hom = Limits.pullback.snd h.left k.left ≫ U'.hom
      rw [← MorphismProperty.Over.w h, ← MorphismProperty.Over.w k, ← Category.assoc,
        Limits.pullback.condition, Category.assoc]) trivial
    obtain ⟨t', _, ht'⟩ :=
      Scheme.Pullback.exists_preimage_pullback (f := h.left) (g := k.left) t p' ht
    refine ⟨T', h', t', ht', ?_⟩
    have heq : h' ≫ k = f₁ ≫ h := by
      apply MorphismProperty.Over.Hom.ext
      exact (MorphismProperty.Comma.comp_left h' k).trans
        ((Limits.pullback.condition (f := h.left) (g := k.left)).symm.trans
          (MorphismProperty.Comma.comp_left f₁ h).symm)
    have h2 := congrArg (fun φ => (G.obj.map φ.op).hom s) heq
    simp only [op_comp, Functor.map_comp, AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply] at h2
    rw [h2, hs, map_zero]

  have s4 : ∀ (Z : Scheme.{u}) (P : (Z.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1}),
      (∀ (A B : Z.Etale) (f : A ⟶ B), Function.Injective (P.map f.op).hom) →
      ∀ (U : Z.Etale) (x : P.obj (Opposite.op U)),
      ((toSheafify (Scheme.smallEtaleTopology Z) P).app (Opposite.op U)).hom x = 0 →
      ∀ u : U.left, x = 0 := by
    intro Z P hinj U x hx u
    haveI := Presheaf.isLocallyInjective_toSheafify' (Scheme.smallEtaleTopology Z) P
    have hmem := Presheaf.equalizerSieve_mem (Scheme.smallEtaleTopology Z)
      (toSheafify (Scheme.smallEtaleTopology Z) P) x 0 (by rw [map_zero]; exact hx)
    obtain ⟨V₁, c, hc, _⟩ := hcovR Z U _ hmem u
    rw [Presheaf.equalizerSieve_apply, map_zero] at hc
    apply hinj V₁ U c
    rw [map_zero]
    exact hc

  have s5 : ∀ (Z : Scheme.{u}) (T : Set Z) (P : (Z.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1}),
      (∀ (V₁ : Z.Etale) (x₁ : V₁.left), V₁.hom x₁ ∉ T → ∀ a : P.obj (Opposite.op V₁), a = 0) →
      ∀ (U : Z.Etale) (s : ((presheafToSheaf (Scheme.smallEtaleTopology Z)
        AddCommGrpCat.{u+1}).obj P).obj.obj (Opposite.op U)) (p : U.left), U.hom p ∉ T →
      ∃ (U₁ : Z.Etale) (h : U₁ ⟶ U) (x₁ : U₁.left), h.left x₁ = p ∧
        (((presheafToSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).obj P).obj.map
          h.op).hom s = 0 := by
    intro Z T P hP U s p hp
    haveI := Presheaf.isLocallySurjective_toSheafify' (Scheme.smallEtaleTopology Z) P
    have hmem := Presheaf.imageSieve_mem (Scheme.smallEtaleTopology Z)
      (toSheafify (Scheme.smallEtaleTopology Z) P) (U := Opposite.op U) s
    obtain ⟨U₁, h, hh, x₁, hx₁⟩ := hcovR Z U _ hmem p
    rw [Presheaf.imageSieve_apply] at hh
    obtain ⟨a, ha⟩ := hh
    refine ⟨U₁, h, x₁, hx₁, ?_⟩
    have hx1T : U₁.hom x₁ ∉ T := by
      rw [← MorphismProperty.Over.w h, Scheme.Hom.comp_apply, hx₁]
      exact hp
    rw [hP U₁ x₁ hx1T a, map_zero] at ha
    exact ha.symm

  have s8 : ∀ (Z : Scheme.{u}) (G : Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1})
      (U : Z.Etale) (s : G.obj.obj (Opposite.op U)), IsOpen {p : U.left | ∃ (T : Z.Etale)
        (h : T ⟶ U) (t : T.left), h.left t = p ∧ (G.obj.map h.op).hom s = 0} := by
    intro Z G U s
    rw [isOpen_iff_forall_mem_open]
    rintro p ⟨T, h, t, ht, hs⟩
    haveI := hEtArr Z T U h
    refine ⟨Set.range h.left, ?_, (Scheme.Hom.isOpenMap h.left).isOpen_range, ⟨t, ht⟩⟩
    rintro _ ⟨t'', rfl⟩
    exact ⟨T, h, t'', rfl, hs⟩

