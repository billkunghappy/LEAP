  have NatA : ∀ x : Abelian.Ext (LA.obj (EA.Φ.obj (wcSuppObj D)))
      (SheafOfModules.unit (wcRingSheaf Y ℓ)) q,
      (Abelian.Ext.mk₀ (γP ≫ adjP.unit.app (EP.Φ.obj (wcSuppObj D)))).comp
        ((Abelian.Ext.mapExactFunctor EP.Φ ((Abelian.Ext.mk₀ u).comp x (zero_add q))).comp
