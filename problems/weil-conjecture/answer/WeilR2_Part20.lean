          (Iso.inv_hom_id_apply (Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away 𝒜 f)))
            (HomogeneousLocalization.Away.mk 𝒜 hf 2 g hg')).symm
      rw [hd, ← hb, Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι]
    have hkey : ∀ k : Fin (d + 1 + 1),
        (wcProjK K (d + 1)).basicOpen (wcLdpSec K (d + 1) G k) = wcSgD K (d + 1) k ⊓ DG := by
      intro k
      rw [hDG]
      exact (L1 _ (MvPolynomial.X k) (G : MvPolynomial (Fin (d + 1 + 1)) K) (hX k) G.2 G.2).symm
    have hgerm : ∀ (k : Fin (d + 1 + 1)) (q : wcProjK K (d + 1)) (hq : q ∈ wcSgD K (d + 1) k),
        ((wcProjK K (d + 1)).presheaf.germ (wcSgD K (d + 1) k) q hq).hom
            (wcLdpSec K (d + 1) G k) ∈
          IsLocalRing.maximalIdeal ((wcProjK K (d + 1)).presheaf.stalk q) ↔ q ∉ DG := by
      intro k q hq
      have e1 := Scheme.mem_basicOpen (wcProjK K (d + 1)) (wcLdpSec K (d + 1) G k) q hq
      rw [hkey k, TopologicalSpace.Opens.mem_inf] at e1
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      constructor
      · intro h h'
        exact h (e1.mp ⟨hq, h'⟩)
      · intro h h'
        exact h (e1.mpr h').2

    have hpull : ∀ (x : X) (k : Fin (d + 1 + 1)) (hx : x ∈ jE ⁻¹ᵁ wcSgD K (d + 1) k),
        wcLdpGerm K (d + 1) jE G k x hx ∈ IsLocalRing.maximalIdeal (X.presheaf.stalk x) →
        ((wcProjK K (d + 1)).presheaf.germ (wcSgD K (d + 1) k) (jE x) hx).hom
            (wcLdpSec K (d + 1) G k) ∈
          IsLocalRing.maximalIdeal ((wcProjK K (d + 1)).presheaf.stalk (jE x)) := by
      intro x k hx h
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at h ⊢
      intro hu
      apply h
      have e := Scheme.Hom.germ_stalkMap_apply jE (wcSgD K (d + 1) k) x hx (wcLdpSec K (d + 1) G k)
      have hu' : IsUnit ((jE.stalkMap x).hom
          (((wcProjK K (d + 1)).presheaf.germ (wcSgD K (d + 1) k) (jE x) hx).hom
            (wcLdpSec K (d + 1) G k))) := (isUnit_map_iff (jE.stalkMap x).hom _).mpr hu
      have e' : (jE.stalkMap x).hom
          (((wcProjK K (d + 1)).presheaf.germ (wcSgD K (d + 1) k) (jE x) hx).hom
            (wcLdpSec K (d + 1) G k)) = wcLdpGerm K (d + 1) jE G k x hx := e
      rw [e'] at hu'
      exact hu'

    have hGh : (G : MvPolynomial (Fin (d + 1 + 1)) K).IsHomogeneous 2 :=
      (MvPolynomial.mem_homogeneousSubmodule 2 _).mp G.2
    have hG0 : (G : MvPolynomial (Fin (d + 1 + 1)) K) ≠ 0 := hprime.ne_zero

    have hIhom : Ideal.IsHomogeneous (MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) K)
        (Ideal.span {(G : MvPolynomial (Fin (d + 1 + 1)) K)}) := by
      apply Ideal.homogeneous_span
      intro x hx
      rw [Set.mem_singleton_iff] at hx
      subst hx
      exact ⟨2, G.2⟩
    have hIprime : (Ideal.span {(G : MvPolynomial (Fin (d + 1 + 1)) K)}).IsPrime :=
      (Ideal.span_singleton_prime hG0).mpr hprime
    have hnirr : ¬ HomogeneousIdeal.irrelevant
        (MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) K) ≤
        (⟨Ideal.span {(G : MvPolynomial (Fin (d + 1 + 1)) K)}, hIhom⟩ :
          HomogeneousIdeal (MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) K)) := by
      intro hle
      have h1 : (MvPolynomial.X 0 : MvPolynomial (Fin (d + 1 + 1)) K) ∈
          Ideal.span {(G : MvPolynomial (Fin (d + 1 + 1)) K)} := hle (hXirr 0)
      rw [Ideal.mem_span_singleton] at h1
      obtain ⟨h, hh⟩ := h1
      have hh0 : h ≠ 0 := by
        rintro rfl
        rw [mul_zero] at hh
        exact MvPolynomial.X_ne_zero _ hh
      have h2 := congrArg MvPolynomial.totalDegree hh
      rw [MvPolynomial.totalDegree_X, MvPolynomial.totalDegree_mul_of_isDomain hG0 hh0,
        hGh.totalDegree hG0] at h2
      omega
    let η : wcProjK K (d + 1) := ProjectiveSpectrum.mk
      (⟨Ideal.span {(G : MvPolynomial (Fin (d + 1 + 1)) K)}, hIhom⟩ :
        HomogeneousIdeal (MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) K)) hIprime hnirr
    have hZeq : {q : wcProjK K (d + 1) | q ∉ DG} = closure {η} := by
      ext q
      simp only [Set.mem_setOf_eq]
      rw [hDG, Proj.mem_basicOpen, not_not]
      have key := (ProjectiveSpectrum.le_iff_mem_closure
        (MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) K) η q)
      refine Iff.trans ?_ ((ProjectiveSpectrum.as_ideal_le_as_ideal _ η q).trans key)
      constructor
      · intro hq x hx
        have hle : Ideal.span {(G : MvPolynomial (Fin (d + 1 + 1)) K)} ≤
            q.asHomogeneousIdeal.toIdeal :=
          Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hq)
        exact hle hx
      · intro hle
        exact hle (Ideal.subset_span (Set.mem_singleton _))
    have hZirr : IsIrreducible {q : wcProjK K (d + 1) | q ∉ DG} := by
      rw [hZeq]
      exact isIrreducible_singleton.closure

    have hW : Set.range jE = {q : wcProjK K (d + 1) | q ∉ DG} := by
      ext q
      constructor
      · rintro ⟨x, rfl⟩
        obtain ⟨k, hk⟩ := hcover (jE x)
        exact (hgerm k (jE x) hk).mp (hpull x k hk (hEG x k hk))
      · intro hq
        exact hsup q (fun k hk => (hgerm k q hk).mpr hq)
    have hpc : _root_.IsPreconnected (jE '' Set.univ) := by
      rw [Set.image_univ, hW]
      exact hZirr.isPreirreducible.isPreconnected
    exact (jE.isClosedEmbedding.isInducing.isPreconnected_image).mp hpc

  obtain ⟨E₀, hprop, hsm, jE, a, hjE, hjEY, ha, hEG, e, he, hre⟩ :=
    wc_qmbt_csz_Y_quadric_model hℓ hn hn4 hπ hc hx₀ hsh hps hℓ' hπ' hπ'2 hgen hbl hblf hps'
  haveI := hprop
  haveI := hsm
  haveI := hjE
  haveI := he
  have hd1 : 1 ≤ n - 2 := by omega
  have hR : Set.range iY = Set.range e := hY.trans hre.symm
  have hE : _root_.IsPreconnected (Set.univ : Set E₀.left) := by
    rcases isEmpty_or_nonempty E₀.left with h | h
    · rw [Set.univ_eq_empty_iff.mpr h]
      exact isPreconnected_empty
    · haveI : Nonempty E₀.left := h
      exact main (IsLocalRing.ResidueField B₀) (n - 2) jE
        (wcLdpQuad (IsLocalRing.ResidueField B₀) (n - 2 + 1) a)
        (wc_qsf_quad_prime (IsLocalRing.ResidueField B₀) (n - 2) hd1 a ha) hEG
        (wc_quadric_section_full (IsLocalRing.ResidueField B₀) (n - 2) hd1 E₀ jE hjE hjEY a ha hEG)
  have hRe : _root_.IsPreconnected (Set.range e) := by
    rw [← Set.image_univ]
    exact hE.image e e.continuous.continuousOn
  have hpY : _root_.IsPreconnected (iY '' Set.univ) := by
    rw [Set.image_univ, hR]
    exact hRe
  exact ⟨(iY.isClosedEmbedding.isInducing.isPreconnected_image).mp hpY⟩

theorem wc_proet_open_unit_supp_mono_of_dense {S Z : Scheme.{u}} (i : Z ⟶ S) [IsClosedImmersion i]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (E : wcHMPullData i ℓ) (hE : wcHMPullCanonical E)
    (V : S.Opens) (Dj : wcHMPullData V.ι ℓ) (hDj : wcHMPullCanonical Dj)
    (hdense : ∀ (W : S.ProEt) (x : ↥(Limits.pullback W.hom i)), ∃ x' : ↥(Limits.pullback W.hom i),
      x' ⤳ x ∧ W.hom (Limits.pullback.fst W.hom i x') ∈ (V : Set ↥S)) :
    Mono (Dj.adj.unit.app (wcSuppObj E)) :=
by
  obtain ⟨EV, hEV⟩ := wc_hm_pull_data_exists (Limits.pullback.fst V.ι i) ℓ

  let m : ∀ W : S.ProEt, Limits.pullback (Limits.pullback.snd W.hom V.ι)
      (Limits.pullback.fst V.ι i) ⟶ Limits.pullback W.hom i := fun W =>
    Limits.pullback.map (Limits.pullback.snd W.hom V.ι) (Limits.pullback.fst V.ι i) W.hom i
      (Limits.pullback.fst W.hom V.ι) (Limits.pullback.snd V.ι i) V.ι
      Limits.pullback.condition.symm Limits.pullback.condition
  have hm1 : ∀ W : S.ProEt, m W ≫ Limits.pullback.fst W.hom i =
      Limits.pullback.fst _ _ ≫ Limits.pullback.fst W.hom V.ι := fun W =>
    Limits.pullback.lift_fst _ _ _
  have hm2 : ∀ W : S.ProEt, m W ≫ Limits.pullback.snd W.hom i =
      Limits.pullback.snd _ _ ≫ Limits.pullback.snd V.ι i := fun W =>
    Limits.pullback.lift_snd _ _ _

  let ψapp : ∀ W : S.ProEt, C(↥(Limits.pullback W.hom i), ULift.{u+1} ℚ_[ℓ]) →+
      C(↥(Limits.pullback (Limits.pullback.snd W.hom V.ι) (Limits.pullback.fst V.ι i)),
        ULift.{u+1} ℚ_[ℓ]) := fun W =>
    { toFun := fun s => s.comp (m W).base.hom
      map_zero' := rfl
      map_add' := fun _ _ => rfl }

  have hinj : ∀ W : S.ProEt, Function.Injective (ψapp W) := by
    intro W s t hst
    refine ContinuousMap.ext fun x => ?_
    obtain ⟨x', hx'x, hx'V⟩ := hdense W x
    have hr : x' ∈ Set.range (m W) := by
      rw [Scheme.Pullback.range_map]
      refine ⟨?_, ?_⟩
      · show Limits.pullback.fst W.hom i x' ∈ Set.range (Limits.pullback.fst W.hom V.ι)
        rw [Scheme.Pullback.range_fst, Scheme.Opens.range_ι]
        exact hx'V
      · show Limits.pullback.snd W.hom i x' ∈ Set.range (Limits.pullback.snd V.ι i)
        rw [Scheme.Pullback.range_snd, Scheme.Opens.range_ι]
        show i (Limits.pullback.snd W.hom i x') ∈ (V : Set ↥S)
        rw [← Scheme.Hom.comp_apply, ← Limits.pullback.condition, Scheme.Hom.comp_apply]
        exact hx'V
    obtain ⟨y, rfl⟩ := hr
    have e1 : s (m W y) = t (m W y) := congrArg (fun f => f y) hst
    have e2 : s (m W y) = s x := (hx'x.map s.continuous).eq
    have e3 : t (m W y) = t x := (hx'x.map t.continuous).eq
    rw [← e2, ← e3, e1]

  have hA : ∀ {T T' : Scheme.{u}} (f : T' ⟶ T) {W₁ W₂ : T.ProEt} (g : W₁ ⟶ W₂),
      ((wcProEtBC f).map g).left ≫ Limits.pullback.fst W₂.hom f =
        Limits.pullback.fst W₁.hom f ≫ g.left := by
    intro T T' f W₁ W₂ g
    exact Limits.pullback.lift_fst _ _ _
  have hB : ∀ {T T' : Scheme.{u}} (f : T' ⟶ T) {W₁ W₂ : T.ProEt} (g : W₁ ⟶ W₂),
      ((wcProEtBC f).map g).left ≫ Limits.pullback.snd W₂.hom f =
        Limits.pullback.snd W₁.hom f := by
    intro T T' f W₁ W₂ g
    exact Limits.pullback.lift_snd _ _ _
  have key : ∀ {W₁ W₂ : S.ProEt} (g : W₁ ⟶ W₂), m W₁ ≫ ((wcProEtBC i).map g).left =
      ((wcProEtBC (Limits.pullback.fst V.ι i)).map ((wcProEtBC V.ι).map g)).left ≫ m W₂ := by
    intro W₁ W₂ g
    have a1 := hA i g
    have a2 := hB i g
    have b1 := hA (Limits.pullback.fst V.ι i) ((wcProEtBC V.ι).map g)
    have b2 := hB (Limits.pullback.fst V.ι i) ((wcProEtBC V.ι).map g)
    have c1 := hA V.ι g
    apply Limits.pullback.hom_ext
    · exact (Category.assoc _ _ _).trans ((whisker_eq _ a1).trans ((Category.assoc _ _ _).symm.trans
        ((eq_whisker (hm1 W₁) _).trans ((Category.assoc _ _ _).trans ((whisker_eq _ c1.symm).trans
        ((Category.assoc _ _ _).symm.trans ((eq_whisker b1.symm _).trans ((Category.assoc _ _ _).trans
        ((whisker_eq _ (hm1 W₂).symm).trans (Category.assoc _ _ _).symm)))))))))
    · exact (Category.assoc _ _ _).trans ((whisker_eq _ a2).trans ((hm2 W₁).trans
        ((eq_whisker b2 _).symm.trans ((Category.assoc _ _ _).trans
        ((whisker_eq _ (hm2 W₂)).symm.trans (Category.assoc _ _ _).symm)))))
  let φ : (wcSuppObj E).val.presheaf ⟶
      ((@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC V.ι) _ _ Dj.cont Dj.φ).obj
        (wcSuppObj EV)).val.presheaf :=
    { app := fun X => AddCommGrpCat.ofHom (ψapp X.unop)
      naturality := by
        intro X Y g
        apply AddCommGrpCat.hom_ext
        apply AddMonoidHom.ext
        intro s
        let s' : C(↥(Limits.pullback X.unop.hom i), ULift.{u+1} ℚ_[ℓ]) := s
        change (s'.comp (((wcProEtBC i).map g.unop).left).base.hom).comp (m Y.unop).base.hom =
          (s'.comp (m X.unop).base.hom).comp
            (((wcProEtBC (Limits.pullback.fst V.ι i)).map ((wcProEtBC V.ι).map g.unop)).left).base.hom
        refine ContinuousMap.ext fun y => ?_
        exact congrArg (fun f => s' (f.base y)) (key g.unop) }
  let ψ : wcSuppObj E ⟶
      (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC V.ι) _ _ Dj.cont Dj.φ).obj
        (wcSuppObj EV) :=
    ⟨PresheafOfModules.homMk φ (fun X r s => by
      obtain ⟨W⟩ := X
      let s' : C(↥(Limits.pullback W.hom i), ULift.{u+1} ℚ_[ℓ]) := s
      let A : C(↥(Limits.pullback W.hom i), ULift.{u+1} ℚ_[ℓ]) := (E.φ.hom.app (Opposite.op W)).hom r
      let B : C(↥(Limits.pullback (Limits.pullback.snd W.hom V.ι) (Limits.pullback.fst V.ι i)),
          ULift.{u+1} ℚ_[ℓ]) :=
        (EV.φ.hom.app (Opposite.op ((wcProEtBC V.ι).obj W))).hom
          ((Dj.φ.hom.app (Opposite.op W)).hom r)
      have h1 := hE W r
      have h2 := hDj W r
      have h3 := hEV ((wcProEtBC V.ι).obj W) ((Dj.φ.hom.app (Opposite.op W)).hom r)
      change (A * s').comp (m W).base.hom = B * s'.comp (m W).base.hom
      refine ContinuousMap.ext fun y => ?_
      let r' : C(↥W.left, ULift.{u+1} ℚ_[ℓ]) := r
      have e1 : A ((m W).base y) = r' ((Limits.pullback.fst W.hom i).base ((m W).base y)) :=
        congrArg (fun f : C(↥(Limits.pullback W.hom i), ULift.{u+1} ℚ_[ℓ]) => f ((m W).base y)) h1
      have e3 : B y = r' ((Limits.pullback.fst W.hom V.ι).base
          ((Limits.pullback.fst (Limits.pullback.snd W.hom V.ι) (Limits.pullback.fst V.ι i)).base y)) :=
        (congrArg (fun f : C(↥(Limits.pullback (Limits.pullback.snd W.hom V.ι)
          (Limits.pullback.fst V.ι i)), ULift.{u+1} ℚ_[ℓ]) => f y) h3).trans
        (congrArg (fun f : C(↥(Limits.pullback W.hom V.ι), ULift.{u+1} ℚ_[ℓ]) =>
          f ((Limits.pullback.fst (Limits.pullback.snd W.hom V.ι) (Limits.pullback.fst V.ι i)).base y))
          h2)
      have e2 : r' ((Limits.pullback.fst W.hom i).base ((m W).base y)) =
          r' ((Limits.pullback.fst W.hom V.ι).base
            ((Limits.pullback.fst (Limits.pullback.snd W.hom V.ι)
              (Limits.pullback.fst V.ι i)).base y)) :=
        congrArg (fun f => r' (f.base y)) (hm1 W)
      change A ((m W).base y) * s' ((m W).base y) = B y * s' ((m W).base y)
      rw [e1, e3, e2])⟩
  have hmono : Mono ψ := by
    constructor
    intro T a b hab
    apply SheafOfModules.hom_ext
    apply PresheafOfModules.hom_ext
    intro X
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro u
    have h := congrArg (fun f => (f.val.app X).hom u) hab
    simp only [SheafOfModules.comp_val, PresheafOfModules.comp_app, ModuleCat.hom_comp,
      LinearMap.comp_apply] at h
    have h' : ψapp X.unop ((a.val.app X).hom u) = ψapp X.unop ((b.val.app X).hom u) := h
    exact hinj X.unop h'

  have hfac := Adjunction.homEquiv_unit Dj.adj (wcSuppObj E) (wcSuppObj EV)
    ((Dj.adj.homEquiv (wcSuppObj E) (wcSuppObj EV)).symm ψ)
  rw [Equiv.apply_symm_apply] at hfac
  exact mono_of_mono_fac hfac.symm

theorem wc_proet_open_unit_supp_epi_of_local_extend {S Z : Scheme.{u}} (i : Z ⟶ S)
    [IsClosedImmersion i] (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (E : wcHMPullData i ℓ)
    (hE : wcHMPullCanonical E) (V : S.Opens) (Dj : wcHMPullData V.ι ℓ) (hDj : wcHMPullCanonical Dj)
    (hext : ∀ W : S.ProEt, Sieve.generate (fun (W' : S.ProEt) (_ : W' ⟶ W) =>
      ∀ f : C({x : ↥(Limits.pullback W'.hom i) //
          W'.hom (Limits.pullback.fst W'.hom i x) ∈ (V : Set ↥S)}, ULift.{u+1} ℚ_[ℓ]),
        ∃ g : C(↥(Limits.pullback W'.hom i), ULift.{u+1} ℚ_[ℓ]), ∀ x, g x.1 = f x)
      ∈ Scheme.ProEt.topology S W) :
    Epi (Dj.adj.unit.app (wcSuppObj E)) :=
by
  classical

  have gen : ∀ (Vo : S.ProEt)
      (hj : (wcSliceFunctor S Vo).IsContinuous (Scheme.ProEt.topology Vo.left)
        (Scheme.ProEt.topology S))
      (D : wcHMPullData Vo.hom ℓ), wcHMPullCanonical D → IsOpenImmersion Vo.hom →
      Set.range Vo.hom = (V : Set S) →
      Epi (D.adj.unit.app (wcSuppObj E)) := by
    intro Vo hj D hD hT hVr
    haveI hj' : (wcSliceFunctor S Vo).IsContinuous (Scheme.ProEt.topology ((𝟭 Scheme.{u}).obj Vo.left))
        (Scheme.ProEt.topology ((Functor.fromPUnit S).obj Vo.right)) := hj
    letI : MorphismProperty.HasPullbacksAlong (@WeaklyEtale : MorphismProperty Scheme.{u}) Vo.hom :=
      ⟨fun _ _ => inferInstance⟩
    letI : MorphismProperty.IsStableUnderBaseChangeAlong
        (@WeaklyEtale : MorphismProperty Scheme.{u}) Vo.hom :=
      (fun (P : MorphismProperty Scheme.{u}) [P.IsStableUnderBaseChange] =>
        (inferInstance : P.IsStableUnderBaseChangeAlong Vo.hom)) (@WeaklyEtale : MorphismProperty Scheme.{u})
    let adj₀ : wcSliceFunctor S Vo ⊣ wcProEtBC Vo.hom :=
      @MorphismProperty.Over.mapPullbackAdj Scheme.{u} _ @WeaklyEtale ⊤ _ Vo.left S
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ Vo.hom _ _ _ Vo.prop trivial
    have hc : ∀ W : S.ProEt, (adj₀.counit.app W).left = Limits.pullback.fst W.hom Vo.hom :=
      fun W => rfl
    have hu : ∀ W' : Vo.left.ProEt, (adj₀.unit.app W').left ≫
        Limits.pullback.fst ((wcSliceFunctor S Vo).obj W').hom Vo.hom = 𝟙 W'.left :=
      fun W' => Limits.pullback.lift_fst _ _ _
    letI := D.cont
    have H1 : Functor.whiskerRight (NatTrans.op adj₀.counit) (wcRingSheaf S ℓ).obj =
        D.φ.hom ≫ (wcProEtBC Vo.hom).op.whiskerLeft
          (𝟙 (wcRingSheaf Vo.left ℓ) : wcRingSheaf Vo.left ℓ ⟶
            ((wcSliceFunctor S Vo).sheafPushforwardContinuous RingCat.{u+1}
              (Scheme.ProEt.topology Vo.left) (Scheme.ProEt.topology S)).obj
              (wcRingSheaf S ℓ)).hom := by
      ext V' s
      obtain ⟨W⟩ := V'
      show s.comp (adj₀.counit.app W).left.base.hom = (D.φ.hom.app (Opposite.op W)).hom s
      rw [hD W s, hc W]
      rfl
    have H2 : (𝟙 (wcRingSheaf Vo.left ℓ) : wcRingSheaf Vo.left ℓ ⟶
            ((wcSliceFunctor S Vo).sheafPushforwardContinuous RingCat.{u+1}
              (Scheme.ProEt.topology Vo.left) (Scheme.ProEt.topology S)).obj
              (wcRingSheaf S ℓ)).hom ≫
        (wcSliceFunctor S Vo).op.whiskerLeft D.φ.hom ≫
        Functor.whiskerRight (NatTrans.op adj₀.unit) (wcRingSheaf Vo.left ℓ).obj =
        𝟙 (wcRingSheaf Vo.left ℓ).obj := by
      ext V' t
      obtain ⟨W'⟩ := V'
      show ((D.φ.hom.app (Opposite.op ((wcSliceFunctor S Vo).obj W'))).hom t).comp
          (adj₀.unit.app W').left.base.hom = t
      refine (congrArg (fun g => ContinuousMap.comp g (adj₀.unit.app W').left.base.hom)
        (hD ((wcSliceFunctor S Vo).obj W') t)).trans ?_
      have key : ∀ t : C(↥W'.left, ULift.{u+1} ℚ_[ℓ]),
          ContinuousMap.comp (ContinuousMap.comp t (Limits.pullback.fst
            ((wcSliceFunctor S Vo).obj W').hom Vo.hom).base.hom)
            (adj₀.unit.app W').left.base.hom = t := by
        intro t
        first
        | (refine ContinuousMap.ext fun x => ?_
           change t _ = t x
           congr 1
           exact congrArg (fun k : W'.left ⟶ W'.left => k.base x) (hu W'))
        | (refine ContinuousMap.ext fun x => ?_
           change t _ = t x
           congr 1
           have e := congrArg (fun k : W'.left ⟶ W'.left => k x) (hu W')
           simpa only [Scheme.Hom.comp_apply, Scheme.Hom.id_apply] using e)
      exact key t

    have hres : ∀ W' : S.ProEt,
        (∀ f : C({x : ↥(Limits.pullback W'.hom i) //
          W'.hom (Limits.pullback.fst W'.hom i x) ∈ (V : Set ↥S)}, ULift.{u+1} ℚ_[ℓ]),
          ∃ g : C(↥(Limits.pullback W'.hom i), ULift.{u+1} ℚ_[ℓ]), ∀ x, g x.1 = f x) →
        Function.Surjective
          (((SheafOfModules.toSheaf (wcRingSheaf S ℓ)).obj (wcSuppObj E)).obj.map
            (adj₀.counit.app W').op).hom := by
      intro W' hW'

      have hco : IsOpenImmersion (adj₀.counit.app W').left := by
        rw [hc]
        exact MorphismProperty.of_isPullback (P := @IsOpenImmersion)
          (IsPullback.of_hasPullback _ _).flip hT
      have hrange : Set.range (adj₀.counit.app W').left = W'.hom ⁻¹' (V : Set S) := by
        have h0 := Scheme.Pullback.range_fst W'.hom Vo.hom
        rw [hVr] at h0
        exact h0
      have hw : (adj₀.counit.app W').left ≫ W'.hom =
          ((wcSliceFunctor S Vo).obj ((wcProEtBC Vo.hom).obj W')).hom :=
        MorphismProperty.Over.w (adj₀.counit.app W')

      let κ : Limits.pullback ((wcSliceFunctor S Vo).obj ((wcProEtBC Vo.hom).obj W')).hom i ⟶
          Limits.pullback W'.hom i := ((wcProEtBC i).map (adj₀.counit.app W')).left
      have hκ1 : κ ≫ Limits.pullback.fst W'.hom i =
          Limits.pullback.fst ((wcSliceFunctor S Vo).obj ((wcProEtBC Vo.hom).obj W')).hom i ≫
            (adj₀.counit.app W').left :=
        Limits.pullback.lift_fst _ _ _
      have hκ2 : κ ≫ Limits.pullback.snd W'.hom i =
          Limits.pullback.snd ((wcSliceFunctor S Vo).obj ((wcProEtBC Vo.hom).obj W')).hom i :=
        Limits.pullback.lift_snd _ _ _

      have sq0 : IsPullback κ
          (Limits.pullback.fst ((wcSliceFunctor S Vo).obj ((wcProEtBC Vo.hom).obj W')).hom i)
          (Limits.pullback.fst W'.hom i) (adj₀.counit.app W').left := by
        refine IsPullback.of_right (h₁₂ := Limits.pullback.snd W'.hom i) (h₂₂ := W'.hom)
          (v₁₃ := i) ?_ hκ1 (IsPullback.of_hasPullback W'.hom i).flip
        rw [hκ2, hw]
        exact (IsPullback.of_hasPullback _ _).flip
      have sq := sq0.flip
      haveI hκo : IsOpenImmersion κ :=
        MorphismProperty.of_isPullback (P := @IsOpenImmersion) sq hco
      have hκr : ∀ b, b ∈ Set.range κ ↔
          W'.hom (Limits.pullback.fst W'.hom i b) ∈ (V : Set S) := by
        intro b
        constructor
        · rintro ⟨y, rfl⟩
          have e : Limits.pullback.fst W'.hom i (κ y) = (adj₀.counit.app W').left
              (Limits.pullback.fst ((wcSliceFunctor S Vo).obj ((wcProEtBC Vo.hom).obj W')).hom i y) :=
            (Scheme.Hom.comp_apply _ _ _).symm.trans
              ((congrArg (fun k => k y) hκ1).trans (Scheme.Hom.comp_apply _ _ _))
          have hm : (adj₀.counit.app W').left
              (Limits.pullback.fst ((wcSliceFunctor S Vo).obj ((wcProEtBC Vo.hom).obj W')).hom i y)
              ∈ W'.hom ⁻¹' (V : Set S) := by
            rw [← hrange]; exact ⟨_, rfl⟩
          exact (congrArg (fun p => W'.hom p ∈ (V : Set S)) e).mpr hm
        · intro hb
          have hb' : Limits.pullback.fst W'.hom i b ∈ Set.range (adj₀.counit.app W').left := by
            rw [hrange]; exact hb
          have hb2 : b ∈ Set.range (Limits.pullback.snd (adj₀.counit.app W').left
              (Limits.pullback.fst W'.hom i)) := by
            rw [Scheme.Pullback.range_snd]; exact hb'
          obtain ⟨z, hz⟩ := hb2
          have he : sq.isoPullback.inv ≫ κ = Limits.pullback.snd _ _ := by
            first
            | exact sq.isoPullback_inv_snd
            | (rw [Iso.inv_comp_eq]; exact sq.isoPullback_hom_snd.symm)
          refine ⟨sq.isoPullback.inv z, ?_⟩
          exact (Scheme.Hom.comp_apply _ _ _).symm.trans ((congrArg (fun k => k z) he).trans hz)
      have hemb : Topology.IsEmbedding κ := κ.isOpenEmbedding.isEmbedding
      intro y
      change C(↥(Limits.pullback ((wcSliceFunctor S Vo).obj ((wcProEtBC Vo.hom).obj W')).hom i),
        ULift.{u+1} ℚ_[ℓ]) at y
      let e := hemb.toHomeomorph
      let h : {b : ↥(Limits.pullback W'.hom i) //
          W'.hom (Limits.pullback.fst W'.hom i b) ∈ (V : Set ↥S)} → Set.range κ :=
        fun b => ⟨b.1, (hκr b.1).2 b.2⟩
      have hh : Continuous h := continuous_subtype_val.subtype_mk _
      let f : C({b : ↥(Limits.pullback W'.hom i) //
          W'.hom (Limits.pullback.fst W'.hom i b) ∈ (V : Set ↥S)}, ULift.{u+1} ℚ_[ℓ]) :=
        ⟨fun b => y (e.symm (h b)), y.continuous.comp (e.symm.continuous.comp hh)⟩
      obtain ⟨g, hg⟩ := hW' f
      have hgκ : ∀ a, g (κ a) = y a := by
        intro a
        have pa := (hκr (κ a)).1 ⟨a, rfl⟩
        refine (hg ⟨κ a, pa⟩).trans ?_
        show y (e.symm ⟨κ a, _⟩) = y a
        rw [Topology.IsEmbedding.toHomeomorph_symm_apply]
      refine ⟨g, ?_⟩
      change g.comp κ.base.hom = y
      exact ContinuousMap.ext fun a => hgκ a
    let adjP := @SheafOfModules.pushforwardPushforwardAdj _ _ _ _ _ _ _ _ _ _ hj D.cont adj₀ _
      D.φ H1 H2
    have hepiP : Epi (adjP.unit.app (wcSuppObj E)) := by
      haveI := Functor.reflectsEpimorphisms_of_faithful
        (SheafOfModules.toSheaf (wcRingSheaf S ℓ))
      apply Functor.epi_of_epi_map (SheafOfModules.toSheaf (wcRingSheaf S ℓ))
      haveI : Sheaf.IsLocallySurjective
          ((SheafOfModules.toSheaf (wcRingSheaf S ℓ)).map (adjP.unit.app (wcSuppObj E))) := by
        apply Presheaf.IsLocallySurjective.mk
        intro U s
        refine GrothendieckTopology.superset_covering _ ?_ (hext U)
        rw [Sieve.generate_le_iff]
        intro W' g hW'
        obtain ⟨t, ht⟩ := hres W' hW' _
        exact ⟨t, (SheafOfModules.pushforwardPushforwardAdj_unit_app_val_app adj₀ _ D.φ H1 H2
          (wcSuppObj E) (Opposite.op W') t).trans ht⟩
      exact Sheaf.epi_of_isLocallySurjective _
    have hst := Adjunction.unit_leftAdjointUniq_hom_app D.adj adjP (wcSuppObj E)
    rw [← hst] at hepiP
    have cancel : ∀ {A B C : SheafOfModules.{u+1} (wcRingSheaf S ℓ)} (f : A ⟶ B) (g : B ⟶ C)
        [IsIso g], Epi (f ≫ g) → Epi f := by
      intro A B C f g _ h
      have hf : f = (f ≫ g) ≫ inv g := by simp
      rw [hf]
      exact epi_comp _ _
    exact cancel _ _ hepiP

  have slice_over_cont : ∀ (S : Scheme.{u}) (U : S.ProEt),
      (wcSliceToOver S U).IsContinuous (Scheme.ProEt.topology U.left)
        ((Scheme.ProEt.topology S).over U) := by
    intro S U
    have hmem : ∀ (T : Scheme.{u}) (V : T.ProEt) (R : Sieve V),
        R ∈ Scheme.ProEt.topology T V ↔
          Sieve.functorPushforward (Scheme.ProEt.forget T ⋙ Over.forget T) R ∈
            Scheme.proetaleTopology V.left := by
      intro T V R
      letI := MorphismProperty.IsMultiplicative.toIsStableUnderComposition (W := @WeaklyEtale)
      have hT : Scheme.ProEt.topology T =
          (Scheme.ProEt.forget T).restrictedTopology (Scheme.proetaleTopology.over T) :=
        MorphismProperty.toGrothendieck_comap_forget_eq_restrictedTopology (S := T)
          (P := @WeaklyEtale) Scheme.proetalePrecoverage
          Scheme.proetalePrecoverage_le_precoverage_weaklyEtale
      rw [hT, Functor.mem_restrictedTopology_iff, GrothendieckTopology.mem_over_iff,
        Sieve.overEquiv_apply, ← Sieve.functorPushforward_comp]
      rfl
    let εapp : ∀ V : Over U, (wcOverToSlice S U ⋙ wcSliceToOver S U).obj V ≅ V := fun V =>
      Over.isoMk (MorphismProperty.Over.isoMk (Iso.refl V.left.left)
          ((Category.id_comp _).trans (MorphismProperty.Over.w V.hom).symm))
        (MorphismProperty.Over.Hom.ext (Category.id_comp V.hom.left))
    let ε : wcOverToSlice S U ⋙ wcSliceToOver S U ≅ 𝟭 (Over U) :=
      NatIso.ofComponents εapp (fun {V V'} g => by
        apply Over.OverMorphism.ext
        apply MorphismProperty.Over.Hom.ext
        exact (Category.comp_id g.left.left).trans (Category.id_comp g.left.left).symm)
    have hmemD : ∀ (V : Over U) (R : Sieve V), R ∈ (Scheme.ProEt.topology S).over U V ↔
        Sieve.functorPushforward (Over.forget U ⋙ Scheme.ProEt.forget S ⋙ Over.forget S) R ∈
          Scheme.proetaleTopology V.left.left := by
      intro V R
      rw [GrothendieckTopology.mem_over_iff, Sieve.overEquiv_apply, hmem S V.left,
        ← Sieve.functorPushforward_comp]
    have hFc : (wcSliceToOver S U).IsCocontinuous (Scheme.ProEt.topology U.left)
        ((Scheme.ProEt.topology S).over U) := by
      constructor
      intro W T hT
      rw [hmem U.left W]
      rw [hmemD] at hT
      refine GrothendieckTopology.superset_covering _ ?_ hT
      rintro Z f ⟨V', t, a, ht, rfl⟩
      refine ⟨(wcOverToSlice S U).obj V', (wcOverToSlice S U).map t, a, ?_, rfl⟩
      show T.arrows ((wcSliceToOver S U).map ((wcOverToSlice S U).map t))
      have hft : (wcSliceToOver S U).map ((wcOverToSlice S U).map t) = (εapp V').hom ≫ t := by
        apply Over.OverMorphism.ext
        apply MorphismProperty.Over.Hom.ext
        exact (Category.id_comp t.left.left).symm
      exact (congrArg (fun g => T.arrows g) hft).mpr (T.downward_closed ht _)
    have hGc : (wcOverToSlice S U).IsCocontinuous ((Scheme.ProEt.topology S).over U)
        (Scheme.ProEt.topology U.left) := by
      constructor
      intro V T hT
      rw [hmemD]
      rw [hmem U.left] at hT
      refine GrothendieckTopology.superset_covering _ ?_ hT
      rintro Z f ⟨W', t, a, ht, rfl⟩
      refine ⟨(wcSliceToOver S U).obj W', (wcSliceToOver S U).map t ≫ (εapp V).hom, a, ?_, ?_⟩
      · show T.arrows ((wcOverToSlice S U).map ((wcSliceToOver S U).map t ≫ (εapp V).hom))
        have hgt : (wcOverToSlice S U).map ((wcSliceToOver S U).map t ≫ (εapp V).hom) = t := by
          apply MorphismProperty.Over.Hom.ext
          exact Category.comp_id t.left
        exact (congrArg (fun g => T.arrows g) hgt).mpr ht
      · exact (congrArg (a ≫ ·) (Category.comp_id t.left)).symm
    let eqv : U.left.ProEt ≌ Over U :=
      Equivalence.mk' (wcSliceToOver S U) (wcOverToSlice S U) (Iso.refl _) ε (fun W => by
        apply Over.OverMorphism.ext
        apply MorphismProperty.Over.Hom.ext
        exact Category.comp_id (𝟙 W.left))
    haveI : eqv.functor.IsCocontinuous (Scheme.ProEt.topology U.left)
        ((Scheme.ProEt.topology S).over U) := hFc
    haveI : eqv.inverse.IsCocontinuous ((Scheme.ProEt.topology S).over U)
        (Scheme.ProEt.topology U.left) := hGc
    haveI := Equivalence.isDenseSubsite_functor_of_isCocontinuous (Scheme.ProEt.topology U.left)
      ((Scheme.ProEt.topology S).over U) eqv
    haveI := Equivalence.isDenseSubsite_inverse_of_isCocontinuous (Scheme.ProEt.topology U.left)
      ((Scheme.ProEt.topology S).over U) eqv
    exact (inferInstance : eqv.functor.IsContinuous (Scheme.ProEt.topology U.left)
      ((Scheme.ProEt.topology S).over U))
  haveI hσ : (wcSliceToOver S (Scheme.ProEt.mk V.ι)).IsContinuous
      (Scheme.ProEt.topology (Scheme.ProEt.mk V.ι).left)
      ((Scheme.ProEt.topology S).over (Scheme.ProEt.mk V.ι)) :=
    slice_over_cont S (Scheme.ProEt.mk V.ι)
  have hj : (wcSliceFunctor S (Scheme.ProEt.mk V.ι)).IsContinuous
      (Scheme.ProEt.topology (Scheme.ProEt.mk V.ι).left) (Scheme.ProEt.topology S) :=
    Functor.isContinuous_comp (wcSliceToOver S (Scheme.ProEt.mk V.ι))
      (Over.forget (Scheme.ProEt.mk V.ι))
      (Scheme.ProEt.topology (Scheme.ProEt.mk V.ι).left)
      ((Scheme.ProEt.topology S).over (Scheme.ProEt.mk V.ι)) (Scheme.ProEt.topology S)
  exact gen (Scheme.ProEt.mk V.ι) hj Dj hDj (show IsOpenImmersion V.ι from inferInstance)
    (show Set.range V.ι = (V : Set S) from Scheme.Opens.range_ι V)

theorem wc_qmbt_D1l_chart_smooth {K : Type u} [Field K] {n : ℕ} (c : Matrix (Fin n) (Fin n) K)
    (hc : IsUnit (c + c.transpose).det) (j : Fin n) :
    SmoothOfRelativeDimension (n - 1) (Spec.map (CommRingCat.ofHom (algebraMap K
      (MvPolynomial (Option (Fin n)) K ⧸
        Ideal.span {MvPolynomial.X none, wcQmbtBofQhat K n c j})))) :=
by
  classical
  set I := Ideal.span {MvPolynomial.X none, wcQmbtBofQhat K n c j} with hIdef

  have hd : ∀ r : Fin n, r ≠ j → ∀ q : Fin n,
      MvPolynomial.pderiv (some r) (wcQmbtChartHat (A' := K) j q) = if q = r then 1 else 0 := by
    intro r hr q
    by_cases hqj : q = j
    · subst hqj
      rw [if_neg (Ne.symm hr)]
      simp only [wcQmbtChartHat, if_pos rfl]
      exact (MvPolynomial.pderiv (some r)).map_one_eq_zero
    · simp only [wcQmbtChartHat, if_neg hqj]
      by_cases hqr : q = r
      · subst hqr
        rw [if_pos rfl]
        exact MvPolynomial.pderiv_X_self _
      · rw [if_neg hqr]
        exact MvPolynomial.pderiv_X_of_ne (fun h => hqr (Option.some_injective _ h))

  have s2 : ∀ r : Fin n, r ≠ j → MvPolynomial.pderiv (some r) (wcQmbtBofQhat K n c j) =
      ∑ q, MvPolynomial.C ((c + c.transpose) r q) * wcQmbtChartHat (A' := K) j q := by
    intro r hr
    have hterm : ∀ p q : Fin n, MvPolynomial.pderiv (some r)
        (MvPolynomial.C (c p q) * wcQmbtChartHat (A' := K) j p * wcQmbtChartHat (A' := K) j q) =
        (if p = r then MvPolynomial.C (c p q) * wcQmbtChartHat (A' := K) j q else 0) +
        (if q = r then MvPolynomial.C (c p q) * wcQmbtChartHat (A' := K) j p else 0) := by
      intro p q
      rw [MvPolynomial.pderiv_mul, MvPolynomial.pderiv_mul, MvPolynomial.pderiv_C, hd r hr p,
        hd r hr q]
      split_ifs <;> ring
    have hA : ∀ p : Fin n, ∑ q : Fin n,
        (if p = r then MvPolynomial.C (c p q) * wcQmbtChartHat (A' := K) j q else 0) =
        if p = r then ∑ q : Fin n, MvPolynomial.C (c p q) * wcQmbtChartHat (A' := K) j q
        else 0 := by
      intro p
      split_ifs <;> simp
    have hB : ∀ p : Fin n, ∑ q : Fin n,
        (if q = r then MvPolynomial.C (c p q) * wcQmbtChartHat (A' := K) j p else 0) =
        MvPolynomial.C (c p r) * wcQmbtChartHat (A' := K) j p := by
      intro p
      rw [Finset.sum_ite_eq']
      simp
    have hsum : MvPolynomial.pderiv (some r) (wcQmbtBofQhat K n c j) =
        ∑ p : Fin n, ∑ q : Fin n, ((if p = r then MvPolynomial.C (c p q) *
          wcQmbtChartHat (A' := K) j q else 0) +
        (if q = r then MvPolynomial.C (c p q) * wcQmbtChartHat (A' := K) j p else 0)) := by
      simp only [wcQmbtBofQhat, map_sum, hterm]
    rw [hsum]
    simp only [Finset.sum_add_distrib, hA, hB]
    rw [Finset.sum_ite_eq']
    simp only [Finset.mem_univ, ite_true]
    rw [← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun q _ => ?_
    simp only [Matrix.add_apply, Matrix.transpose_apply, map_add]
    ring

  have s1 : ∀ p : Fin n, p ≠ j →
      (Matrix.of fun a b : Fin 2 => MvPolynomial.pderiv (![none, some p] a)
        (![MvPolynomial.X none, wcQmbtBofQhat K n c j] b)).det =
      ∑ q, MvPolynomial.C ((c + c.transpose) p q) * wcQmbtChartHat (A' := K) j q := by
    intro p hp
    rw [← s2 p hp]
    have hnp : (none : Option (Fin n)) ≠ some p := (Option.some_ne_none p).symm
    have a00 : MvPolynomial.pderiv none (MvPolynomial.X (R := K) (none : Option (Fin n))) = 1 :=
      MvPolynomial.pderiv_X_self _
    have a10 : MvPolynomial.pderiv (some p) (MvPolynomial.X (R := K) (none : Option (Fin n))) = 0 :=
      MvPolynomial.pderiv_X_of_ne hnp
    rw [Matrix.det_fin_two]
    simp only [Matrix.of_apply, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons]
    rw [a00, a10]
    ring

  have s3 : ∀ w : Fin n → MvPolynomial (Option (Fin n)) K,
      ∑ r, w r * ∑ q, MvPolynomial.C ((c + c.transpose) r q) * w q =
        2 * ∑ p, ∑ q, MvPolynomial.C (c p q) * w p * w q := by
    intro w
    have e1 : ∀ r, w r * ∑ q, MvPolynomial.C ((c + c.transpose) r q) * w q =
        ∑ q, MvPolynomial.C (c r q) * w r * w q + ∑ q, MvPolynomial.C (c q r) * w q * w r := by
      intro r
      rw [Finset.mul_sum, ← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl fun q _ => ?_
      simp only [Matrix.add_apply, Matrix.transpose_apply, map_add]
      ring
    rw [Finset.sum_congr rfl fun r _ => e1 r, Finset.sum_add_distrib,
      Finset.sum_comm (f := fun r q => MvPolynomial.C (c q r) * w q * w r)]
    ring

  have s4 : ∀ (M : Matrix (Fin n) (Fin n) K), IsUnit M.det →
      ∀ (w : Fin n → MvPolynomial (Option (Fin n)) K) (q : Fin n),
      ∑ r, MvPolynomial.C (M⁻¹ q r) * ∑ s, MvPolynomial.C (M r s) * w s = w q := by
    intro M hM w q
    have hinv := Matrix.nonsing_inv_mul M hM
    calc ∑ r, MvPolynomial.C (M⁻¹ q r) * ∑ s, MvPolynomial.C (M r s) * w s
        = ∑ s, MvPolynomial.C ((M⁻¹ * M) q s) * w s := by
          simp only [Finset.mul_sum, Matrix.mul_apply, map_sum, Finset.sum_mul]
          rw [Finset.sum_comm]
          refine Finset.sum_congr rfl fun s _ => Finset.sum_congr rfl fun r _ => ?_
          rw [map_mul]; ring
      _ = w q := by
          rw [hinv]
          simp [Matrix.one_apply, apply_ite MvPolynomial.C]

  have hspan : Ideal.span (Set.range fun p : {p : Fin n // p ≠ j} =>
      Ideal.Quotient.mk I
        (∑ q, MvPolynomial.C ((c + c.transpose) p.1 q) * wcQmbtChartHat (A' := K) j q)) = ⊤ := by
    set J := Ideal.span (Set.range fun p : {p : Fin n // p ≠ j} =>
      Ideal.Quotient.mk I
        (∑ q, MvPolynomial.C ((c + c.transpose) p.1 q) * wcQmbtChartHat (A' := K) j q)) with hJ
    have hQ : Ideal.Quotient.mk I (wcQmbtBofQhat K n c j) = 0 := by
      rw [Ideal.Quotient.eq_zero_iff_mem]
      exact Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _))
    have hhj : wcQmbtChartHat (A' := K) j j = 1 := if_pos rfl
    have hLr : ∀ r : Fin n, r ≠ j → Ideal.Quotient.mk I
        (∑ q, MvPolynomial.C ((c + c.transpose) r q) * wcQmbtChartHat (A' := K) j q) ∈ J := by
      intro r hr
      exact Ideal.subset_span ⟨⟨r, hr⟩, rfl⟩
    have hLj : Ideal.Quotient.mk I
        (∑ q, MvPolynomial.C ((c + c.transpose) j q) * wcQmbtChartHat (A' := K) j q) ∈ J := by
      have e := s3 (wcQmbtChartHat (A' := K) j)
      rw [← Finset.add_sum_erase _ _ (Finset.mem_univ j), hhj, one_mul] at e
      have e2 := eq_sub_of_add_eq e
      rw [e2, map_sub, map_mul]
      have hQ' : Ideal.Quotient.mk I (∑ p, ∑ q, MvPolynomial.C (c p q) *
          wcQmbtChartHat (A' := K) j p * wcQmbtChartHat (A' := K) j q) = 0 := hQ
      rw [hQ', mul_zero, zero_sub]
      refine J.neg_mem ?_
      rw [map_sum]
      refine J.sum_mem fun r hr => ?_
      rw [map_mul]
      exact J.mul_mem_left _ (hLr r (Finset.ne_of_mem_erase hr))
    rw [Ideal.eq_top_iff_one]
    have e := s4 (c + c.transpose) hc (wcQmbtChartHat (A' := K) j) j
    rw [hhj] at e
    rw [← map_one (Ideal.Quotient.mk I), ← e, map_sum]
    refine J.sum_mem fun r _ => ?_
    rw [map_mul]
    refine J.mul_mem_left _ ?_
    by_cases hr : r = j
    · subst hr; exact hLj
    · exact hLr r hr

  have hcard : Fintype.card (Option (Fin n)) - 2 = n - 1 := by
    rw [Fintype.card_option, Fintype.card_fin]; omega
  have hmain := wc_qmbt_bof_jacobian_cover_smooth K
    (![MvPolynomial.X none, wcQmbtBofQhat K n c j] : Fin 2 → MvPolynomial (Option (Fin n)) K) I
    (by rw [Matrix.range_cons_cons_empty])
    (ι := {p : Fin n // p ≠ j}) (fun p => ![none, some p.1])
    (by
      intro p a b h
      fin_cases a <;> fin_cases b <;> simp_all)
    (by
      have hfun : (fun i : {p : Fin n // p ≠ j} => Ideal.Quotient.mk I
          (Matrix.of fun a b : Fin 2 => MvPolynomial.pderiv ((fun p : {p : Fin n // p ≠ j} =>
            (![none, some p.1] : Fin 2 → Option (Fin n))) i a)
            ((![MvPolynomial.X none, wcQmbtBofQhat K n c j] :
              Fin 2 → MvPolynomial (Option (Fin n)) K) b)).det) =
          (fun p : {p : Fin n // p ≠ j} => Ideal.Quotient.mk I
            (∑ q, MvPolynomial.C ((c + c.transpose) p.1 q) * wcQmbtChartHat (A' := K) j q)) := by
        funext i
        rw [← s1 i.1 i.2]
      rw [hfun]
      exact hspan)
  rw [hcard] at hmain
  exact hmain

theorem wc_qmbt_D1l_chart_quot {A' : Type u} [CommRing A'] [IsLocalRing A'] {π' : A'}
    (hπ' : IsLocalRing.maximalIdeal A' = Ideal.span {π'}) {n : ℕ}
    (c' : Matrix (Fin n) (Fin n) A') (j : Fin n) :
    ∃ τ : (wcQmbtChart A' n π' c' j ⧸
        Ideal.span {algebraMap A' (wcQmbtChart A' n π' c' j) π'}) →+*
      (MvPolynomial (Option (Fin n)) (IsLocalRing.ResidueField A') ⧸
        Ideal.span {MvPolynomial.X none, wcQmbtBofQhat (IsLocalRing.ResidueField A') n
          (c'.map (IsLocalRing.residue A')) j}),
      Function.Surjective τ ∧
      RingHom.ker τ = Ideal.span {Ideal.Quotient.mk _
        (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j) (MvPolynomial.X none))} :=
by
  classical
  set I := wcQmbtChartIdeal A' n π' c' j with hI
  set J : Ideal (wcQmbtChart A' n π' c' j) :=
    Ideal.span {algebraMap A' (wcQmbtChart A' n π' c' j) π'} with hJ
  set Qk := wcQmbtBofQhat (IsLocalRing.ResidueField A') n (c'.map (IsLocalRing.residue A')) j
    with hQk
  set ID : Ideal (MvPolynomial (Option (Fin n)) (IsLocalRing.ResidueField A')) :=
    Ideal.span {MvPolynomial.X none, Qk} with hID
  set Q : MvPolynomial (Option (Fin n)) A' :=
    ∑ p, ∑ q, MvPolynomial.C (c' p q) * wcQmbtChartHat j p * wcQmbtChartHat j q with hQ

  have s1 : MvPolynomial.map (IsLocalRing.residue A') Q = Qk := by
    simp only [hQ, hQk, wcQmbtBofQhat, map_sum, map_mul, MvPolynomial.map_C, Matrix.map_apply]
    refine Finset.sum_congr rfl (fun p _ => Finset.sum_congr rfl (fun q _ => ?_))
    simp only [wcQmbtChartHat]
    split_ifs <;> simp

  have s2 : IsLocalRing.residue A' π' = 0 :=
    (IsLocalRing.residue_eq_zero_iff π').mpr (hπ' ▸ Ideal.mem_span_singleton_self π')

  let μ : MvPolynomial (Option (Fin n)) A' →+*
      (MvPolynomial (Option (Fin n)) (IsLocalRing.ResidueField A') ⧸ ID) :=
    (Ideal.Quotient.mk ID).comp (MvPolynomial.map (IsLocalRing.residue A'))
  have hμ : ∀ f, μ f = Ideal.Quotient.mk ID (MvPolynomial.map (IsLocalRing.residue A') f) :=
    fun f => rfl
  have hμsurj : Function.Surjective μ :=
    Ideal.Quotient.mk_surjective.comp
      (MvPolynomial.map_surjective _ IsLocalRing.residue_surjective)
  have hXn : Ideal.Quotient.mk ID (MvPolynomial.X none) = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_insert _ _))
  have hQk0 : Ideal.Quotient.mk ID Qk = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.mpr
      (Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _)))

  have h1 : I ≤ RingHom.ker μ := by
    rw [hI, Ideal.span_le, Set.insert_subset_iff, Set.singleton_subset_iff]
    constructor
    · rw [SetLike.mem_coe, RingHom.mem_ker, hμ]
      simp only [map_sub, map_mul, MvPolynomial.map_X, MvPolynomial.map_C, s2, map_zero, hXn,
        mul_zero, sub_zero]
    · rw [SetLike.mem_coe, RingHom.mem_ker]
      show Ideal.Quotient.mk ID (MvPolynomial.map (IsLocalRing.residue A')
        (Q - MvPolynomial.X none ^ 2)) = 0
      rw [map_sub, s1, map_pow, MvPolynomial.map_X, map_sub, map_pow, hQk0, hXn]
      simp
  let μ₁ : wcQmbtChart A' n π' c' j →+*
      (MvPolynomial (Option (Fin n)) (IsLocalRing.ResidueField A') ⧸ ID) :=
    Ideal.Quotient.lift I μ (fun a ha => h1 ha)

  have ha : algebraMap A' (wcQmbtChart A' n π' c' j) π' =
      Ideal.Quotient.mk I (MvPolynomial.C π') := by
    rw [← MvPolynomial.algebraMap_eq, Ideal.Quotient.mk_algebraMap]
  have h2 : ∀ z ∈ J, μ₁ z = 0 := by
    intro z hz
    obtain ⟨b, rfl⟩ := Ideal.mem_span_singleton'.mp hz
    rw [map_mul, ha]
    show μ₁ b * μ (MvPolynomial.C π') = 0
    rw [hμ, MvPolynomial.map_C, s2, map_zero, map_zero, mul_zero]
  let τ : (wcQmbtChart A' n π' c' j ⧸ J) →+*
      (MvPolynomial (Option (Fin n)) (IsLocalRing.ResidueField A') ⧸ ID) :=
    Ideal.Quotient.lift J μ₁ h2
  have hτ : ∀ f, τ (Ideal.Quotient.mk J (Ideal.Quotient.mk I f)) = μ f := fun f => rfl
  refine ⟨τ, ?_, ?_⟩
  · intro y
    obtain ⟨f, rfl⟩ := hμsurj y
    exact ⟨_, hτ f⟩
  · apply le_antisymm
    · intro z hz
      rw [RingHom.mem_ker] at hz
      obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective z
      obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective y
      rw [hτ, hμ] at hz
      have hf := Ideal.Quotient.eq_zero_iff_mem.mp hz
      obtain ⟨α, β, hαβ⟩ := Ideal.mem_span_pair.mp hf
      obtain ⟨α₀, rfl⟩ := MvPolynomial.map_surjective _ IsLocalRing.residue_surjective α
      obtain ⟨β₀, rfl⟩ := MvPolynomial.map_surjective _ IsLocalRing.residue_surjective β
      have hg : f - (α₀ * MvPolynomial.X none + β₀ * Q) ∈
          RingHom.ker (MvPolynomial.map (σ := Option (Fin n)) (IsLocalRing.residue A')) := by
        rw [RingHom.mem_ker, map_sub, map_add, map_mul, map_mul, MvPolynomial.map_X, s1, hαβ,
          sub_self]
      rw [MvPolynomial.ker_map, IsLocalRing.ker_residue, hπ', Ideal.map_span,
        Set.image_singleton] at hg
      obtain ⟨γ, hγ⟩ := Ideal.mem_span_singleton'.mp hg
      have hf' : f = α₀ * MvPolynomial.X none + β₀ * Q + γ * MvPolynomial.C π' := by
        rw [hγ]; ring
      have hQI : Ideal.Quotient.mk I Q = Ideal.Quotient.mk I (MvPolynomial.X none ^ 2) :=
        Ideal.Quotient.eq.mpr (Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _)))
      have hJa : Ideal.Quotient.mk J (algebraMap A' (wcQmbtChart A' n π' c' j) π') = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _)
      have hQI' := congrArg (Ideal.Quotient.mk J) hQI
      have hCa : Ideal.Quotient.mk J (Ideal.Quotient.mk I (MvPolynomial.C π')) = 0 := by
        rw [← ha]; exact hJa
      have key : Ideal.Quotient.mk J (Ideal.Quotient.mk I f) =
          (Ideal.Quotient.mk J (Ideal.Quotient.mk I α₀) +
            Ideal.Quotient.mk J (Ideal.Quotient.mk I β₀) *
              Ideal.Quotient.mk J (Ideal.Quotient.mk I (MvPolynomial.X none))) *
            Ideal.Quotient.mk J (Ideal.Quotient.mk I (MvPolynomial.X none)) := by
        rw [hf']
        simp only [map_add, map_mul, map_pow] at hQI' ⊢
        linear_combination (Ideal.Quotient.mk J (Ideal.Quotient.mk I β₀)) * hQI' +
          (Ideal.Quotient.mk J (Ideal.Quotient.mk I γ)) * hCa
      exact Ideal.mem_span_singleton'.mpr ⟨_, key.symm⟩
    · rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker, hτ, hμ,
        MvPolynomial.map_X, hXn]

theorem wc_qmbt_D1l_chart_locus {A : Type u} [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
    {n : ℕ} {π : A} {c : Matrix (Fin n) (Fin n) A}
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π})
    {x₀ : Spec (.of (wcQuadModelRing A n π c))}
    (hx₀ : ∀ p, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
      PrimeSpectrum.asIdeal x₀)
    {B₀ : Type u} [CommRing B₀] [HenselianLocalRing B₀] [IsSepClosed (IsLocalRing.ResidueField B₀)]
    {Λ₀ : Type u} [SmallCategory Λ₀] [IsCofiltered Λ₀]
    {W₀ : Λ₀ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (wcQuadModelRing A n π c))) x₀))
      (Scheme.Etale.forget (Spec (.of (wcQuadModelRing A n π c))))}
    {φ₀ : ∀ l, Spec (.of B₀) ⟶ (W₀.obj l).right.left}
    {a₀ : Spec (.of B₀) ⟶ Spec (.of (wcQuadModelRing A n π c))}
    (hsh : wcHalShData x₀ B₀ Λ₀ W₀ φ₀ a₀)
    {A' : Type u} [CommRing A'] [IsDomain A'] [IsDiscreteValuationRing A'] {ιA : A →+* A'}
    {π' : A'} (hπ' : IsLocalRing.maximalIdeal A' = Ideal.span {π'})
    {Xm : Scheme.{u}} {f : Xm ⟶ Spec (.of A')}
    {bl : Xm ⟶ Limits.pullback (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))}
    (hblf : bl ≫ Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA)) = f)
    {Xs' : Scheme.{u}} {ι' : Xs' ⟶ Xm} {s' : Xs' ⟶ Spec (.of (IsLocalRing.ResidueField A'))}
    (hps' : IsPullback ι' s' f (wcQmSp A'))
    (θ : wcQuadModelRing A n π c →+* wcQuadModelRing A' n (π' ^ 2) (c.map ιA))
    {X₁ : Scheme.{u}} (r₁ : X₁ ⟶ Spec (.of (wcQuadModelRing A' n (π' ^ 2) (c.map ιA))))
    (ψ : Xm ⟶ X₁)
    (hθX : ∀ p, θ (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p)) =
      Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) (c.map ιA)) (MvPolynomial.X p))
    (hpbψ : IsPullback ψ (bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA))) (r₁ ≫ Spec.map (CommRingCat.ofHom θ)) a₀)
    (hψf : ψ ≫ r₁ ≫ Spec.map (CommRingCat.ofHom
        (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)))) =
      bl ≫ Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA)))
    (φN : wcQuadModelRing A' n (π' ^ 2) (c.map ιA) →+* wcQmbtChartNone A' n (c.map ιA))
    (φ : ∀ j : Fin n,
      wcQuadModelRing A' n (π' ^ 2) (c.map ιA) →+* wcQmbtChart A' n π' (c.map ιA) j)
    (eN : Spec (.of (wcQmbtChartNone A' n (c.map ιA))) ⟶ X₁)
    (e : ∀ j : Fin n, Spec (.of (wcQmbtChart A' n π' (c.map ιA) j)) ⟶ X₁)
    [IsOpenImmersion eN] [∀ j, IsOpenImmersion (e j)]
    (hNX : ∀ p, φN (Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) (c.map ιA))
        (MvPolynomial.X p)) =
      Ideal.Quotient.mk (wcQmbtChartNoneIdeal A' n (c.map ιA))
        (MvPolynomial.C π' * MvPolynomial.X p))
    (hNA : φN.comp (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA))) =
      algebraMap A' (wcQmbtChartNone A' n (c.map ιA)))
    (hφX : ∀ j p, φ j (Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) (c.map ιA))
        (MvPolynomial.X p)) =
      Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' (c.map ιA) j)
        (MvPolynomial.X (some j) * wcQmbtChartHat j p))
    (hφA : ∀ j, (φ j).comp (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA))) =
      algebraMap A' (wcQmbtChart A' n π' (c.map ιA) j))
    (hN : eN ≫ r₁ = Spec.map (CommRingCat.ofHom φN))
    (he : ∀ j, e j ≫ r₁ = Spec.map (CommRingCat.ofHom (φ j)))
    (hcov : ∀ x : X₁, x ∈ Set.range eN ∨ ∃ j y, e j y = x) :
    (∀ z : Xs', z ∈ closure ((fun z => (ι' ≫ bl ≫ Limits.pullback.fst
        (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))) z) ⁻¹'
          {IsLocalRing.closedPoint B₀})ᶜ → ∃ j y, e j y = ψ (ι' z)) ∧
    ∀ (z : Xs') (j : Fin n) (y : Spec (.of (wcQmbtChart A' n π' (c.map ιA) j))),
      e j y = ψ (ι' z) →
      algebraMap A' (wcQmbtChart A' n π' (c.map ιA) j) π' ∈ PrimeSpectrum.asIdeal y ∧
      (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' (c.map ιA) j) (MvPolynomial.X none) ∈
          PrimeSpectrum.asIdeal y ↔
        z ∈ closure ((fun z => (ι' ≫ bl ≫ Limits.pullback.fst
          (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))) z) ⁻¹'
            {IsLocalRing.closedPoint B₀})ᶜ) :=
by
  obtain ⟨O1, O2⟩ := wc_qmbt_hl_b0_origin_fibre hπ hx₀ hsh
  have hWE : WeaklyEtale a₀ := wc_shdata_weaklyEtale x₀ B₀ Λ₀ W₀ φ₀ a₀ hsh
  have hf' := hψf.trans hblf
  generalize bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
    (Spec.map (CommRingCat.ofHom ιA)) = G at hpbψ ⊢

  have specmem : ∀ {R S : Type u} [CommRing R] [CommRing S] (g : R →+* S) (q : Spec (.of S))
      (x : R), x ∈ (Spec.map (CommRingCat.ofHom g) q).asIdeal ↔ g x ∈ q.asIdeal := by
    intro R S _ _ g q x
    rw [Spec.map_apply]
    exact Iff.rfl
  have hw : ψ ≫ r₁ ≫ Spec.map (CommRingCat.ofHom θ) = G ≫ a₀ := hpbψ.toCommSq.w

  have K1 : ∀ (m : Xm) (j : Fin n) (y : Spec (.of (wcQmbtChart A' n π' (c.map ιA) j))), e j y = ψ m →
      ∀ x, x ∈ (a₀ (G m)).asIdeal ↔ φ j (θ x) ∈ y.asIdeal := by
    intro m j y hy x
    have h2 : (e j ≫ r₁) y = r₁ (ψ m) := by rw [Scheme.Hom.comp_apply, hy]
    rw [he] at h2
    have h3 : a₀ (G m) = Spec.map (CommRingCat.ofHom θ) (r₁ (ψ m)) := by
      rw [← Scheme.Hom.comp_apply G a₀, ← hw]
      simp only [Scheme.Hom.comp_apply]
    rw [h3, ← h2, specmem, specmem]
  have KN : ∀ (m : Xm) (y : Spec (.of (wcQmbtChartNone A' n (c.map ιA)))), eN y = ψ m →
      ∀ x, x ∈ (a₀ (G m)).asIdeal ↔ φN (θ x) ∈ y.asIdeal := by
    intro m y hy x
    have h2 : (eN ≫ r₁) y = r₁ (ψ m) := by rw [Scheme.Hom.comp_apply, hy]
    rw [hN] at h2
    have h3 : a₀ (G m) = Spec.map (CommRingCat.ofHom θ) (r₁ (ψ m)) := by
      rw [← Scheme.Hom.comp_apply G a₀, ← hw]
      simp only [Scheme.Hom.comp_apply]
    rw [h3, ← h2, specmem, specmem]

  have C1 : ∀ (m : Xm) (j : Fin n) (y : Spec (.of (wcQmbtChart A' n π' (c.map ιA) j))), e j y = ψ m →
      (G m = IsLocalRing.closedPoint B₀ ↔
        Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' (c.map ιA) j) (MvPolynomial.X (some j)) ∈
          PrimeSpectrum.asIdeal y) := by
    intro m j y hy
    constructor
    · intro hG
      have h1 := O1 j
      rw [← hG, K1 m j y hy, hθX, hφX] at h1
      simpa [wcQmbtChartHat] using h1
    · intro hx
      apply O2
      intro p
      rw [K1 m j y hy, hθX, hφX, map_mul]
      exact Ideal.mul_mem_right _ _ hx
  have CN : ∀ (m : Xm) (y : Spec (.of (wcQmbtChartNone A' n (c.map ιA)))), eN y = ψ m →
      algebraMap A' (wcQmbtChartNone A' n (c.map ιA)) π' ∈ PrimeSpectrum.asIdeal y →
      G m = IsLocalRing.closedPoint B₀ := by
    intro m y hy hπy
    apply O2
    intro p
    rw [KN m y hy, hθX, hNX, map_mul]
    have hC : Ideal.Quotient.mk (wcQmbtChartNoneIdeal A' n (c.map ιA)) (MvPolynomial.C π') =
        algebraMap A' (wcQmbtChartNone A' n (c.map ιA)) π' := rfl
    rw [hC]
    exact Ideal.mul_mem_right _ _ hπy

  have P0 : ∀ q : Spec (.of (IsLocalRing.ResidueField A')),
      wcQmSp A' q = IsLocalRing.closedPoint A' := by
    intro q
    apply PrimeSpectrum.ext
    ext x
    show x ∈ (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A')) q).asIdeal ↔ _
    rw [specmem]
    have hq : q.asIdeal = ⊥ := (Ideal.eq_bot_or_top _).resolve_right q.isPrime.ne_top
    rw [hq, Ideal.mem_bot, IsLocalRing.residue_eq_zero_iff]
    exact Iff.rfl
  have Sa : ∀ z : Xs', f (ι' z) = IsLocalRing.closedPoint A' := by
    intro z
    rw [← Scheme.Hom.comp_apply, hps'.toCommSq.w, Scheme.Hom.comp_apply, P0]
  have Sb : ∀ m : Xm, f m = IsLocalRing.closedPoint A' → ∃ z : Xs', ι' z = m := by
    intro m hm
    obtain ⟨w, hw1, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := f) (g := wcQmSp A') m
      (IsLocalRing.closedPoint _) (hm.trans (P0 _).symm)
    refine ⟨hps'.isoPullback.inv w, ?_⟩
    rw [← Scheme.Hom.comp_apply, hps'.isoPullback_inv_fst, hw1]
  have Sc : ∀ z z' : Xs', ι' z ⤳ ι' z' → z ⤳ z' := by
    haveI : IsClosedImmersion (wcQmSp A') :=
      IsClosedImmersion.spec_of_surjective _ IsLocalRing.residue_surjective
    haveI : IsClosedImmersion ι' :=
      MorphismProperty.of_isPullback (P := @IsClosedImmersion) hps'.flip ‹_›
    intro z z' h
    exact ι'.isClosedEmbedding.isInducing.specializes_iff.1 h
  have K2 : ∀ (m : Xm) (j : Fin n) (y : Spec (.of (wcQmbtChart A' n π' (c.map ιA) j))), e j y = ψ m →
      ∀ x, x ∈ (f m).asIdeal ↔ algebraMap A' (wcQmbtChart A' n π' (c.map ιA) j) x ∈ y.asIdeal := by
    intro m j y hy x
    have h2 : (e j ≫ r₁) y = r₁ (ψ m) := by rw [Scheme.Hom.comp_apply, hy]
    rw [he] at h2
    have h3 : f m = Spec.map (CommRingCat.ofHom
        (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)))) (r₁ (ψ m)) := by
      rw [← hf']
      simp only [Scheme.Hom.comp_apply]
    rw [h3, ← h2, specmem, specmem, ← hφA j, RingHom.comp_apply]
  have K2N : ∀ (m : Xm) (y : Spec (.of (wcQmbtChartNone A' n (c.map ιA)))), eN y = ψ m →
      ∀ x, x ∈ (f m).asIdeal ↔ algebraMap A' (wcQmbtChartNone A' n (c.map ιA)) x ∈ y.asIdeal := by
    intro m y hy x
    have h2 : (eN ≫ r₁) y = r₁ (ψ m) := by rw [Scheme.Hom.comp_apply, hy]
    rw [hN] at h2
    have h3 : f m = Spec.map (CommRingCat.ofHom
        (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)))) (r₁ (ψ m)) := by
      rw [← hf']
      simp only [Scheme.Hom.comp_apply]
    rw [h3, ← h2, specmem, specmem, ← hNA, RingHom.comp_apply]

  have cpcrit : ∀ (P : Spec (.of A')), (P = IsLocalRing.closedPoint A' ↔ π' ∈ P.asIdeal) := by
    intro P
    constructor
    · rintro rfl
      show π' ∈ IsLocalRing.maximalIdeal A'
      rw [hπ']
      exact Ideal.mem_span_singleton_self π'
    · intro h
      apply PrimeSpectrum.ext
      apply le_antisymm
      · exact IsLocalRing.le_maximalIdeal P.isPrime.ne_top
      · show IsLocalRing.maximalIdeal A' ≤ P.asIdeal
        rw [hπ', Ideal.span_singleton_le_iff_mem]
        exact h
  have Sd : ∀ (m : Xm) (j : Fin n) (y : Spec (.of (wcQmbtChart A' n π' (c.map ιA) j))), e j y = ψ m →
      (f m = IsLocalRing.closedPoint A' ↔
        algebraMap A' (wcQmbtChart A' n π' (c.map ιA) j) π' ∈ PrimeSpectrum.asIdeal y) := by
    intro m j y hy
    exact (cpcrit (f m)).trans (K2 m j y hy π')
  have Se : ∀ (m : Xm) (y : Spec (.of (wcQmbtChartNone A' n (c.map ιA)))), eN y = ψ m →
      (f m = IsLocalRing.closedPoint A' ↔
        algebraMap A' (wcQmbtChartNone A' n (c.map ιA)) π' ∈ PrimeSpectrum.asIdeal y) := by
    intro m y hy
    exact (cpcrit (f m)).trans (K2N m y hy π')

  haveI hψWE : WeaklyEtale ψ := MorphismProperty.of_isPullback (P := @WeaklyEtale) hpbψ.flip hWE
  have hgen := Flat.generalizingMap ψ

  have hrel : ∀ j, Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' (c.map ιA) j) (MvPolynomial.X (some j)) *
      Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' (c.map ιA) j) (MvPolynomial.X none) =
      algebraMap A' (wcQmbtChart A' n π' (c.map ιA) j) π' := by
    intro j
    have h1 : Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' (c.map ιA) j)
        (MvPolynomial.X (some j) * MvPolynomial.X none) =
        Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' (c.map ιA) j) (MvPolynomial.C π') := by
      rw [Ideal.Quotient.eq]
      exact Ideal.subset_span (Set.mem_insert _ _)
    rw [← map_mul, h1]
    rfl

  have S3 : ∀ (z : Xs') (j : Fin n) (y : Spec (.of (wcQmbtChart A' n π' (c.map ιA) j))),
      e j y = ψ (ι' z) → G (ι' z) ≠ IsLocalRing.closedPoint B₀ →
      Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' (c.map ιA) j) (MvPolynomial.X none) ∈
        PrimeSpectrum.asIdeal y := by
    intro z j y hy hG
    have hx : Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' (c.map ιA) j) (MvPolynomial.X (some j)) ∉
        PrimeSpectrum.asIdeal y := fun h => hG ((C1 (ι' z) j y hy).2 h)
    have hπy := (Sd (ι' z) j y hy).1 (Sa z)
    rw [← hrel j] at hπy
    exact (y.isPrime.mem_or_mem hπy).resolve_left hx
  refine ⟨?_, ?_⟩
  ·
    intro z hz
    rcases hcov (ψ (ι' z)) with ⟨y0, hy0⟩ | h
    · exfalso
      obtain ⟨z', hz'O, hz'D⟩ := mem_closure_iff.1 hz _
        ((IsOpenImmersion.isOpen_range eN).preimage (ι' ≫ ψ).continuous)
        (by show (ι' ≫ ψ) z ∈ Set.range eN; rw [Scheme.Hom.comp_apply]; exact ⟨y0, hy0⟩)
      obtain ⟨y', hy'⟩ : (ι' ≫ ψ) z' ∈ Set.range eN := hz'O
      rw [Scheme.Hom.comp_apply] at hy'
      apply hz'D
      show (ι' ≫ G) z' = IsLocalRing.closedPoint B₀
      rw [Scheme.Hom.comp_apply]
      exact CN (ι' z') y' hy' ((Se (ι' z') y' hy').1 (Sa z'))
    · exact h
  · intro z j y hy
    refine ⟨(Sd (ι' z) j y hy).1 (Sa z), ?_, ?_⟩
    · intro hs
      by_cases hxj : Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' (c.map ιA) j) (MvPolynomial.X (some j)) ∈
          PrimeSpectrum.asIdeal y
      · obtain ⟨y', hy'le, -, hπ'', hx'⟩ := wc_qmbt_hl_chart_generize π' (c.map ιA) j y hs hxj
        have hsp : e j y' ⤳ ψ (ι' z) := by
          rw [← hy]
          exact ((PrimeSpectrum.le_iff_specializes y' y).1 hy'le).map (e j).continuous
        obtain ⟨m', hm'1, hm'2⟩ := hgen hsp
        have hfm' : f m' = IsLocalRing.closedPoint A' := (Sd m' j y' hm'2.symm).2 hπ''
        obtain ⟨z', rfl⟩ := Sb m' hfm'
        have hzz : z' ⤳ z := Sc z' z hm'1
        have hz'D : z' ∈ ((fun z => (ι' ≫ G) z) ⁻¹' {IsLocalRing.closedPoint B₀})ᶜ := by
          intro h
          have h' : G (ι' z') = IsLocalRing.closedPoint B₀ := by
            rw [← Scheme.Hom.comp_apply]; exact h
          exact hx' ((C1 (ι' z') j y' hm'2.symm).1 h')
        exact closure_mono (Set.singleton_subset_iff.2 hz'D) (specializes_iff_mem_closure.1 hzz)
      · apply subset_closure
        intro h
        have h' : G (ι' z) = IsLocalRing.closedPoint B₀ := by
          rw [← Scheme.Hom.comp_apply]; exact h
        exact hxj ((C1 (ι' z) j y hy).1 h')
    · intro hz
      by_contra hs
      have hU : IsOpen ((e j) '' ((PrimeSpectrum.basicOpen (Ideal.Quotient.mk
          (wcQmbtChartIdeal A' n π' (c.map ιA) j) (MvPolynomial.X none)) :
            Set (PrimeSpectrum (wcQmbtChart A' n π' (c.map ιA) j))))) :=
        (e j).isOpenEmbedding.isOpenMap _ PrimeSpectrum.isOpen_basicOpen
      obtain ⟨z', hz'V, hz'D⟩ := mem_closure_iff.1 hz _ (hU.preimage (ι' ≫ ψ).continuous)
        (by
          rw [Set.mem_preimage, Scheme.Hom.comp_apply, ← hy]
          exact ⟨y, (PrimeSpectrum.mem_basicOpen _ _).2 hs, rfl⟩)
      obtain ⟨y'', hy''s, hy''e⟩ : (ι' ≫ ψ) z' ∈ (e j) '' ((PrimeSpectrum.basicOpen
          (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' (c.map ιA) j) (MvPolynomial.X none)) :
            Set (PrimeSpectrum (wcQmbtChart A' n π' (c.map ιA) j)))) := hz'V
      rw [Scheme.Hom.comp_apply] at hy''e
      refine (PrimeSpectrum.mem_basicOpen _ _).1 hy''s (S3 z' j y'' hy''e ?_)
      intro h
      apply hz'D
      show (ι' ≫ G) z' = IsLocalRing.closedPoint B₀
      rw [Scheme.Hom.comp_apply]
      exact h

theorem wc_qmbt_D1l_chart_factor {A : Type u} [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
    {n : ℕ} {π : A} {c : Matrix (Fin n) (Fin n) A}
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π})
    {x₀ : Spec (.of (wcQuadModelRing A n π c))}
    (hx₀ : ∀ p, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
      PrimeSpectrum.asIdeal x₀)
    {B₀ : Type u} [CommRing B₀] [HenselianLocalRing B₀] [IsSepClosed (IsLocalRing.ResidueField B₀)]
    {Λ₀ : Type u} [SmallCategory Λ₀] [IsCofiltered Λ₀]
    {W₀ : Λ₀ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (wcQuadModelRing A n π c))) x₀))
      (Scheme.Etale.forget (Spec (.of (wcQuadModelRing A n π c))))}
    {φ₀ : ∀ l, Spec (.of B₀) ⟶ (W₀.obj l).right.left}
    {a₀ : Spec (.of B₀) ⟶ Spec (.of (wcQuadModelRing A n π c))}
    (hsh : wcHalShData x₀ B₀ Λ₀ W₀ φ₀ a₀)
    {A' : Type u} [CommRing A'] [IsDomain A'] [IsDiscreteValuationRing A'] {ιA : A →+* A'}
    {π' : A'} (hπ' : IsLocalRing.maximalIdeal A' = Ideal.span {π'})
    {Xm : Scheme.{u}} {f : Xm ⟶ Spec (.of A')}
    {bl : Xm ⟶ Limits.pullback (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))}
    (hblf : bl ≫ Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA)) = f)
    {Xs' : Scheme.{u}} {ι' : Xs' ⟶ Xm} {s' : Xs' ⟶ Spec (.of (IsLocalRing.ResidueField A'))}
    (hps' : IsPullback ι' s' f (wcQmSp A'))
    (θ : wcQuadModelRing A n π c →+* wcQuadModelRing A' n (π' ^ 2) (c.map ιA))
    {X₁ : Scheme.{u}} (r₁ : X₁ ⟶ Spec (.of (wcQuadModelRing A' n (π' ^ 2) (c.map ιA))))
    (ψ : Xm ⟶ X₁)
    (hθX : ∀ p, θ (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p)) =
      Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) (c.map ιA)) (MvPolynomial.X p))
    (hpbψ : IsPullback ψ (bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA))) (r₁ ≫ Spec.map (CommRingCat.ofHom θ)) a₀)
    (hψf : ψ ≫ r₁ ≫ Spec.map (CommRingCat.ofHom
        (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)))) =
      bl ≫ Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA)))
    (φN : wcQuadModelRing A' n (π' ^ 2) (c.map ιA) →+* wcQmbtChartNone A' n (c.map ιA))
    (φ : ∀ j : Fin n,
      wcQuadModelRing A' n (π' ^ 2) (c.map ιA) →+* wcQmbtChart A' n π' (c.map ιA) j)
    (eN : Spec (.of (wcQmbtChartNone A' n (c.map ιA))) ⟶ X₁)
    (e : ∀ j : Fin n, Spec (.of (wcQmbtChart A' n π' (c.map ιA) j)) ⟶ X₁)
    [IsOpenImmersion eN] [∀ j, IsOpenImmersion (e j)]
    (hNX : ∀ p, φN (Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) (c.map ιA))
        (MvPolynomial.X p)) =
      Ideal.Quotient.mk (wcQmbtChartNoneIdeal A' n (c.map ιA))
        (MvPolynomial.C π' * MvPolynomial.X p))
    (hNA : φN.comp (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA))) =
      algebraMap A' (wcQmbtChartNone A' n (c.map ιA)))
    (hφX : ∀ j p, φ j (Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) (c.map ιA))
        (MvPolynomial.X p)) =
      Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' (c.map ιA) j)
        (MvPolynomial.X (some j) * wcQmbtChartHat j p))
    (hφA : ∀ j, (φ j).comp (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA))) =
      algebraMap A' (wcQmbtChart A' n π' (c.map ιA) j))
    (hN : eN ≫ r₁ = Spec.map (CommRingCat.ofHom φN))
    (he : ∀ j, e j ≫ r₁ = Spec.map (CommRingCat.ofHom (φ j)))
    (hcov : ∀ x : X₁, x ∈ Set.range eN ∨ ∃ j y, e j y = x) :
    ∀ (R : CommRingCat.{u}) [IsLocalRing R] (cR : Spec R ⟶ Xs'), WeaklyEtale cR →
    ∀ (j : Fin n) (y : Spec (.of (wcQmbtChart A' n π' (c.map ιA) j))),
      e j y = ψ (ι' (cR (IsLocalRing.closedPoint R))) →
      ∃ ρ : (wcQmbtChart A' n π' (c.map ιA) j ⧸
          Ideal.span {algebraMap A' (wcQmbtChart A' n π' (c.map ιA) j) π'}) →+* R,
        WeaklyEtale (Spec.map (CommRingCat.ofHom (R := wcQmbtChart A' n π' (c.map ιA) j ⧸
          Ideal.span {algebraMap A' (wcQmbtChart A' n π' (c.map ιA) j) π'}) (S := R) ρ)) ∧
        ∀ p : Spec R, e j (PrimeSpectrum.comap (ρ.comp (Ideal.Quotient.mk _)) p) =
          ψ (ι' (cR p)) :=
by
  classical

  have La : ∀ {A₀ C₀ : Type u} [CommRing A₀] [IsLocalRing A₀] [CommRing C₀] [Algebra A₀ C₀]
      {π₀ : A₀}, IsLocalRing.maximalIdeal A₀ = Ideal.span {π₀} →
      ∃ ε : IsLocalRing.ResidueField A₀ →+* C₀ ⧸ Ideal.span {algebraMap A₀ C₀ π₀},
        IsPullback
          (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {algebraMap A₀ C₀ π₀}))))
          (Spec.map (CommRingCat.ofHom ε))
          (Spec.map (CommRingCat.ofHom (algebraMap A₀ C₀)))
          (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A₀))) := by
    intro A₀ C₀ _ _ _ _ π₀ hπ₀
    have hJ : Ideal.map (algebraMap A₀ C₀) (IsLocalRing.maximalIdeal A₀) =
        Ideal.span {algebraMap A₀ C₀ π₀} := by
      rw [hπ₀, Ideal.map_span, Set.image_singleton]
    have H : ∀ x ∈ IsLocalRing.maximalIdeal A₀,
        (Ideal.Quotient.mk (Ideal.span {algebraMap A₀ C₀ π₀})) (algebraMap A₀ C₀ x) = 0 := by
      intro x hx
      rw [Ideal.Quotient.eq_zero_iff_mem, ← hJ]
      exact Ideal.mem_map_of_mem _ hx
    let ε : IsLocalRing.ResidueField A₀ →+* C₀ ⧸ Ideal.span {algebraMap A₀ C₀ π₀} :=
      Ideal.Quotient.lift (IsLocalRing.maximalIdeal A₀)
        ((Ideal.Quotient.mk (Ideal.span {algebraMap A₀ C₀ π₀})).comp (algebraMap A₀ C₀)) H
    have hε : ∀ x, ε (IsLocalRing.residue A₀ x) =
        Ideal.Quotient.mk (Ideal.span {algebraMap A₀ C₀ π₀}) (algebraMap A₀ C₀ x) := fun x => rfl
    let Φ : TensorProduct A₀ C₀ (IsLocalRing.ResidueField A₀) ≃+*
        C₀ ⧸ Ideal.span {algebraMap A₀ C₀ π₀} :=
      ((Algebra.TensorProduct.quotIdealMapEquivTensorQuot C₀
        (IsLocalRing.maximalIdeal A₀)).toRingEquiv.symm).trans (Ideal.quotEquivOfEq hJ)
    have hΦ : ∀ c : C₀, Φ (c ⊗ₜ 1) = Ideal.Quotient.mk (Ideal.span {algebraMap A₀ C₀ π₀}) c := by
      intro c
      have h1 : (Algebra.TensorProduct.quotIdealMapEquivTensorQuot C₀
          (IsLocalRing.maximalIdeal A₀)).toRingEquiv.symm (c ⊗ₜ 1) =
          Ideal.Quotient.mk (Ideal.map (algebraMap A₀ C₀) (IsLocalRing.maximalIdeal A₀)) c := by
        rw [RingEquiv.symm_apply_eq]
        exact (Algebra.TensorProduct.quotIdealMapEquivTensorQuot_mk C₀ _ c).symm
      show Ideal.quotEquivOfEq hJ ((Algebra.TensorProduct.quotIdealMapEquivTensorQuot C₀
        (IsLocalRing.maximalIdeal A₀)).toRingEquiv.symm (c ⊗ₜ 1)) = _
      rw [h1, Ideal.quotEquivOfEq_mk]
    have P := CommRingCat.isPushout_tensorProduct A₀ C₀ (IsLocalRing.ResidueField A₀)
    have P' : IsPushout (CommRingCat.ofHom (algebraMap A₀ C₀))
        (CommRingCat.ofHom (IsLocalRing.residue A₀))
        (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {algebraMap A₀ C₀ π₀})))
        (CommRingCat.ofHom ε) := by
      refine IsPushout.of_iso P (Iso.refl _) (Iso.refl _) (Iso.refl _) Φ.toCommRingCatIso
        ?_ ?_ ?_ ?_
      · rw [Iso.refl_hom, Iso.refl_hom, Category.comp_id, Category.id_comp]
      · rw [Iso.refl_hom, Iso.refl_hom, Category.comp_id, Category.id_comp]
        rfl
      · rw [Iso.refl_hom, Category.id_comp, RingEquiv.toCommRingCatIso_hom]
        ext c
        simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply,
          Algebra.TensorProduct.includeLeftRingHom_apply, RingEquiv.coe_toRingHom]
        exact hΦ c
      · rw [Iso.refl_hom, Category.id_comp, RingEquiv.toCommRingCatIso_hom]
        ext κ
        obtain ⟨x, rfl⟩ := IsLocalRing.residue_surjective κ
        simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply,
          AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
          Algebra.TensorProduct.includeRight_apply]
        have e1 : (1 : C₀) ⊗ₜ[A₀] (IsLocalRing.residue A₀ x) = algebraMap A₀ C₀ x ⊗ₜ 1 :=
          (Algebra.TensorProduct.tmul_one_eq_one_tmul x).symm
        rw [e1, hΦ, hε]
    exact ⟨ε, isPullback_SpecMap_of_isPushout _ _ _ _ P'⟩


  have Lb : ∀ {M X S T Xs U Ub Z : Scheme.{u}}
      (ψ₀ : M ⟶ X) (F : X ⟶ S) (f₀ : M ⟶ S) (_hf : ψ₀ ≫ F = f₀)
      (t : T ⟶ S) (ι₀ : Xs ⟶ M) (s₀ : Xs ⟶ T) (_hps : IsPullback ι₀ s₀ f₀ t)
      (e₀ : U ⟶ X) (u₀ : U ⟶ S) (_hu : e₀ ≫ F = u₀)
      (m : Ub ⟶ U) (ε' : Ub ⟶ T) (_hU : IsPullback m ε' u₀ t)
      (c₀ : Z ⟶ Xs) (hb : Z ⟶ Ub)
      (_h1 : hb ≫ m ≫ e₀ = c₀ ≫ ι₀ ≫ ψ₀) (_h2 : hb ≫ ε' = c₀ ≫ s₀)
      (_hψ : WeaklyEtale ψ₀) (_he : WeaklyEtale e₀) (_hc : WeaklyEtale c₀),
      WeaklyEtale hb := by
    intro M X S T Xs U Ub Z ψ₀ F f₀ hf t ι₀ s₀ hps e₀ u₀ hu m ε' hU c₀ hb h1 h2 hψ he hc
    have Q := IsPullback.of_hasPullback F t
    have w₁ : (ι₀ ≫ ψ₀) ≫ F = s₀ ≫ t := by rw [Category.assoc, hf]; exact hps.toCommSq.w
    have w₂ : (m ≫ e₀) ≫ F = ε' ≫ t := by rw [Category.assoc, hu]; exact hU.toCommSq.w
    have hκ1 := Limits.pullback.lift_fst (ι₀ ≫ ψ₀) s₀ w₁
    have hκ2 := Limits.pullback.lift_snd (ι₀ ≫ ψ₀) s₀ w₁
    have he1 := Limits.pullback.lift_fst (m ≫ e₀) ε' w₂
    have he2 := Limits.pullback.lift_snd (m ≫ e₀) ε' w₂
    have Pκ : IsPullback (Limits.pullback.lift (ι₀ ≫ ψ₀) s₀ w₁) ι₀
        (Limits.pullback.fst F t) ψ₀ := by
      refine IsPullback.of_right ?_ hκ1 Q.flip
      rw [hκ2, hf]; exact hps.flip
    have Pe : IsPullback (Limits.pullback.lift (m ≫ e₀) ε' w₂) m
        (Limits.pullback.fst F t) e₀ := by
      refine IsPullback.of_right ?_ he1 Q.flip
      rw [he2, hu]; exact hU.flip
    haveI Wκ : WeaklyEtale (Limits.pullback.lift (ι₀ ≫ ψ₀) s₀ w₁) :=
      MorphismProperty.of_isPullback (P := @WeaklyEtale) Pκ.flip hψ
    haveI We : WeaklyEtale (Limits.pullback.lift (m ≫ e₀) ε' w₂) :=
      MorphismProperty.of_isPullback (P := @WeaklyEtale) Pe.flip he
    have hcomm : hb ≫ Limits.pullback.lift (m ≫ e₀) ε' w₂ =
        c₀ ≫ Limits.pullback.lift (ι₀ ≫ ψ₀) s₀ w₁ := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, he1, h1, Category.assoc, hκ1]
      · rw [Category.assoc, he2, h2, Category.assoc, hκ2]
    haveI : WeaklyEtale (hb ≫ Limits.pullback.lift (m ≫ e₀) ε' w₂) := by
      rw [hcomm]; infer_instance
    exact WeaklyEtale.of_comp hb (Limits.pullback.lift (m ≫ e₀) ε' w₂)
  intro R _ cR hcR j y hy

  have hA : WeaklyEtale a₀ := wc_shdata_weaklyEtale x₀ B₀ Λ₀ W₀ φ₀ a₀ hsh
  have hψ : WeaklyEtale ψ := MorphismProperty.of_isPullback (P := @WeaklyEtale) hpbψ.flip hA

  have hF : ψ ≫ r₁ ≫ Spec.map (CommRingCat.ofHom
      (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)))) = f := hψf.trans hblf
  have hu : e j ≫ r₁ ≫ Spec.map (CommRingCat.ofHom
      (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)))) =
      Spec.map (CommRingCat.ofHom (algebraMap A' (wcQmbtChart A' n π' (c.map ιA) j))) := by
    rw [← Category.assoc, he j, ← Spec.map_comp, ← CommRingCat.ofHom_comp, hφA j]

  have hrange : Set.range (cR ≫ ι' ≫ ψ) ⊆ Set.range (e j) := by
    rintro _ ⟨p, rfl⟩
    have hsp : (cR ≫ ι' ≫ ψ) p ⤳ (cR ≫ ι' ≫ ψ) (IsLocalRing.closedPoint R) :=
      (IsLocalRing.specializes_closedPoint p).map (cR ≫ ι' ≫ ψ).continuous
    refine hsp.mem_open (IsOpenImmersion.isOpen_range (e j)) ⟨y, ?_⟩
    first
    | exact hy.trans ((Scheme.Hom.comp_apply cR (ι' ≫ ψ) _).trans
        (Scheme.Hom.comp_apply ι' ψ _)).symm
    | exact hy
  obtain ⟨h, hh⟩ : ∃ h : Spec R ⟶ Spec (.of (wcQmbtChart A' n π' (c.map ιA) j)),
      h ≫ e j = cR ≫ ι' ≫ ψ := ⟨_, IsOpenImmersion.lift_fac _ _ hrange⟩

  obtain ⟨ε, hsq⟩ := La (A₀ := A') (C₀ := wcQmbtChart A' n π' (c.map ιA) j) hπ'
  have w : h ≫ Spec.map (CommRingCat.ofHom (algebraMap A' (wcQmbtChart A' n π' (c.map ιA) j))) =
      (cR ≫ s') ≫ Spec.map (CommRingCat.ofHom (IsLocalRing.residue A')) := by
    calc h ≫ Spec.map (CommRingCat.ofHom (algebraMap A' (wcQmbtChart A' n π' (c.map ιA) j)))
        = (h ≫ e j) ≫ r₁ ≫ Spec.map (CommRingCat.ofHom
            (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)))) := by
          rw [Category.assoc, hu]
      _ = cR ≫ ι' ≫ (ψ ≫ r₁ ≫ Spec.map (CommRingCat.ofHom
            (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA))))) := by
          rw [hh]; simp only [Category.assoc]
      _ = cR ≫ ι' ≫ f := by rw [hF]
      _ = (cR ≫ s') ≫ Spec.map (CommRingCat.ofHom (IsLocalRing.residue A')) := by
          rw [hps'.toCommSq.w, Category.assoc]
  obtain ⟨hb, hb1, hb2⟩ : ∃ hb : Spec R ⟶ Spec (.of (wcQmbtChart A' n π' (c.map ιA) j ⧸
        Ideal.span {algebraMap A' (wcQmbtChart A' n π' (c.map ιA) j) π'})),
      hb ≫ Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk
        (Ideal.span {algebraMap A' (wcQmbtChart A' n π' (c.map ιA) j) π'}))) = h ∧
      hb ≫ Spec.map (CommRingCat.ofHom ε) = cR ≫ s' :=
    ⟨hsq.lift h (cR ≫ s') w, hsq.lift_fst _ _ _, hsq.lift_snd _ _ _⟩

  refine ⟨(Spec.preimage hb).hom, ?_, ?_⟩
  ·
    have hWb : WeaklyEtale hb :=
      Lb ψ _ f hF (wcQmSp A') ι' s' hps' (e j) _ hu _ _ hsq cR hb
        (by rw [← Category.assoc, hb1, hh]) hb2 hψ inferInstance hcR
    have hρ : Spec.map (CommRingCat.ofHom (Spec.preimage hb).hom) = hb := Spec.map_preimage hb
    rw [hρ]
    exact hWb
  ·
    intro p
    have hρ : Spec.map (CommRingCat.ofHom (Spec.preimage hb).hom) = hb := Spec.map_preimage hb
    have key : (Spec.map (CommRingCat.ofHom (Spec.preimage hb).hom) ≫
        Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk
          (Ideal.span {algebraMap A' (wcQmbtChart A' n π' (c.map ιA) j) π'}))) ≫ e j) p =
        (cR ≫ ι' ≫ ψ) p := by
      rw [hρ, ← Category.assoc, hb1, hh]
    first
    | exact key
    | (simp only [Scheme.Hom.comp_apply] at key
       rw [PrimeSpectrum.comap_comp_apply]
       exact key)

theorem wc_shens_quot_prime_of_smooth_target {C D K : Type u} [CommRing C] [CommRing D] [Field K]
    [Algebra K D] (R : CommRingCat.{u}) [HenselianLocalRing R]
    [IsSepClosed (IsLocalRing.ResidueField R)] (ρ : C →+* R)
    (hρ : WeaklyEtale (Spec.map (CommRingCat.ofHom ρ))) (τ : C →+* D) (hτ : Function.Surjective τ)
    (x : C) (hker : RingHom.ker τ = Ideal.span {x}) (hx : ρ x ∈ IsLocalRing.maximalIdeal R)
    (m : ℕ) (hsm : SmoothOfRelativeDimension m (Spec.map (CommRingCat.ofHom (algebraMap K D)))) :
    (Ideal.span {ρ x}).IsPrime :=
by
  classical
  set I : Ideal R := Ideal.span {ρ x} with hI

  have hne : I ≠ ⊤ := by
    intro h
    rw [hI, Ideal.span_singleton_eq_top] at h
    exact (IsLocalRing.mem_maximalIdeal _).mp hx h

  obtain ⟨hH, hS⟩ := wc_quot_strictly_henselian_of_ne_top R I hne

  have hτx : τ x = 0 := by
    rw [← RingHom.mem_ker, hker]
    exact Ideal.mem_span_singleton_self x
  have hkill : RingHom.ker τ ≤ RingHom.ker ((Ideal.Quotient.mk I).comp ρ) := by
    intro a ha
    rw [hker, Ideal.mem_span_singleton] at ha
    obtain ⟨b, rfl⟩ := ha
    rw [RingHom.mem_ker, RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem, map_mul]
    exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _)
  obtain ⟨σ, hσ⟩ : ∃ σ : D →+* R ⧸ I, σ.comp τ = (Ideal.Quotient.mk I).comp ρ :=
    ⟨_, RingHom.liftOfRightInverse_comp τ (Function.surjInv hτ)
      (Function.rightInverse_surjInv hτ) ⟨(Ideal.Quotient.mk I).comp ρ, hkill⟩⟩
  have hσc : ∀ c, σ (τ c) = Ideal.Quotient.mk I (ρ c) := fun c => RingHom.congr_fun hσ c
  have hsq : CommRingCat.ofHom ρ ≫ CommRingCat.ofHom (Ideal.Quotient.mk I) =
      CommRingCat.ofHom τ ≫ CommRingCat.ofHom σ := by
    rw [← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp, hσ]
  have hs : ∀ (s : Limits.PushoutCocone (CommRingCat.ofHom ρ) (CommRingCat.ofHom τ)) (c : C),
      s.inl.hom (ρ c) = s.inr.hom (τ c) := by
    intro s c
    have := congrArg (fun φ => φ.hom c) s.condition
    simpa using this
  have hk : ∀ (s : Limits.PushoutCocone (CommRingCat.ofHom ρ) (CommRingCat.ofHom τ)),
      ∀ a ∈ I, s.inl.hom a = 0 := by
    intro s a ha
    obtain ⟨b, rfl⟩ := Ideal.mem_span_singleton.mp ha
    rw [map_mul, hs s x, hτx, map_zero, zero_mul]
  have hpo : IsPushout (CommRingCat.ofHom ρ) (CommRingCat.ofHom τ)
      (CommRingCat.ofHom (Ideal.Quotient.mk I)) (CommRingCat.ofHom σ) := by
    refine IsPushout.of_isColimit (Limits.PushoutCocone.IsColimit.mk hsq
      (fun s => CommRingCat.ofHom (Ideal.Quotient.lift I s.inl.hom (hk s))) ?_ ?_ ?_)
    · intro s
      ext a
      simp
    · intro s
      ext d
      obtain ⟨c, rfl⟩ := hτ d
      simp [hσc, hs s c]
    · intro s m h1 _
      ext a
      have := congrArg (fun φ => φ.hom a) h1
      simpa using this

  have hpb := isPullback_SpecMap_of_isPushout _ _ _ _ hpo
  have hσet : WeaklyEtale (Spec.map (CommRingCat.ofHom σ)) :=
    MorphismProperty.of_isPullback (P := @WeaklyEtale) hpb hρ

  haveI := hH
  haveI := hS
  haveI := hsm
  have hdom : IsDomain (CommRingCat.of (R ⧸ I)) :=
    wc_strictHensel_weaklyEtale_smooth_isDomain K
      (Spec.map (CommRingCat.ofHom (algebraMap K D))) m (CommRingCat.of (R ⧸ I))
      (Spec.map (CommRingCat.ofHom σ)) hσet

  exact (Ideal.Quotient.isDomain_iff_prime I).mp hdom

theorem wc_qmbt_xsp_ess_D1l_strict_locally_irreducible {A : Type u} [CommRing A] [IsDomain A]
    [IsDiscreteValuationRing A]
    [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (hℓ : IsUnit ((ℓ : ℕ) : A)) {n : ℕ} (hn : Even n) (hn4 : 4 ≤ n) {π : A}
    {c : Matrix (Fin n) (Fin n) A}
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π}) (hc : IsUnit (c + c.transpose).det)
    {x₀ : Spec (.of (wcQuadModelRing A n π c))}
    (hx₀ : ∀ p, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
      PrimeSpectrum.asIdeal x₀)
    {B₀ : Type u} [CommRing B₀] [HenselianLocalRing B₀] [IsSepClosed (IsLocalRing.ResidueField B₀)]
    {Λ₀ : Type u} [SmallCategory Λ₀] [IsCofiltered Λ₀]
    {W₀ : Λ₀ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (wcQuadModelRing A n π c))) x₀))
      (Scheme.Etale.forget (Spec (.of (wcQuadModelRing A n π c))))}
    {φ₀ : ∀ l, Spec (.of B₀) ⟶ (W₀.obj l).right.left}
    {a₀ : Spec (.of B₀) ⟶ Spec (.of (wcQuadModelRing A n π c))}
    (hsh : wcHalShData x₀ B₀ Λ₀ W₀ φ₀ a₀)
    {Xs : Scheme.{u}} {ι : Xs ⟶ Spec (.of B₀)} {s : Xs ⟶ Spec (.of (IsLocalRing.ResidueField A))}
    (hps : IsPullback ι s (a₀ ≫ wcQuadModelStr A n π c) (wcQmSp A))
    {A' : Type u} [CommRing A'] [IsDomain A'] [IsDiscreteValuationRing A'] [HenselianLocalRing A']
    [IsSepClosed (IsLocalRing.ResidueField A')] {ιA : A →+* A'} {π' : A'}
    (hℓ' : IsUnit ((ℓ : ℕ) : A')) (hπ' : IsLocalRing.maximalIdeal A' = Ideal.span {π'})
    (hπ'2 : π' ^ 2 = ιA π) (hgen : ∀ a' : A', ∃ x y : A, a' = ιA x + ιA y * π')
    {L' : Type u} [Field L'] [IsSepClosed L'] {φ' : A' →+* L'} (hφ' : Function.Injective φ')
    (halg' : letI := φ'.toAlgebra; Algebra.IsAlgebraic A' L')
    {Xm : Scheme.{u}} {f : Xm ⟶ Spec (.of A')}
    {bl : Xm ⟶ Limits.pullback (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))}
    (hbl : wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range
      (fun i : Option (Fin n) => Option.elim i
        ((Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of A')).inv.hom π'))
        (fun j => ((Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))) ≫ a₀).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A n π c))).inv.hom
            (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X j)))))))) bl)
    (hblf : bl ≫ Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA)) = f)
    {XE' : Scheme.{u}} {p' : XE' ⟶ Xm} {q' : XE' ⟶ Spec (.of L')}
    (hpb' : IsPullback p' q' f (Spec.map (CommRingCat.ofHom φ')))
    {Xs' : Scheme.{u}} {ι' : Xs' ⟶ Xm} {s' : Xs' ⟶ Spec (.of (IsLocalRing.ResidueField A'))}
    (hps' : IsPullback ι' s' f (wcQmSp A'))
    {βs : Xs' ⟶ Xs}
    (hβ : βs ≫ ι = ι' ≫ bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA)))
    (Dβ : wcHMPullData βs ℓ) (hDβ : wcHMPullCanonical Dβ)
    [EnoughInjectives (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))]
    (Dp' : wcHMPullData p' ℓ) (hDp' : wcHMPullCanonical Dp')
    (Di' : wcHMPullData ι' ℓ) (hDi' : wcHMPullCanonical Di')
    (I' : InjectiveResolution (SheafOfModules.unit (wcRingSheaf XE' ℓ)))
    {Z₁ : Scheme.{u}} (i₁ : Z₁ ⟶ Xs') [IsClosedImmersion i₁]
    (h₁ : Set.range i₁ = closure ((fun z => (ι' ≫ bl ≫ Limits.pullback.fst
      (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))) z) ⁻¹'
        {IsLocalRing.closedPoint B₀})ᶜ) :
    ∀ W : Xs'.ProEt, IsAffine W.left →
      (∀ x : W.left, IsClosed ({x} : Set W.left) →
        HenselianLocalRing (W.left.presheaf.stalk x) ∧ IsSepClosed (W.left.residueField x)) →
      ∀ t : ↥(Limits.pullback W.hom i₁), IsClosed ({t} : Set ↥(Limits.pullback W.hom i₁)) →
        ∃ e : ↥(Limits.pullback W.hom i₁), ∀ y, y ⤳ t → e ⤳ y :=
by
  classical
  intro W hWa hW t ht

  obtain ⟨θ, X₁, r₁, ψ, hθX, -, hr, hpbψ, hψf, -⟩ :=
    wc_qmbt_qm_model_square_ext hsh hπ'2 hbl
  obtain ⟨φN, φ, eN, e, hNX, hNA, -, -, hφX, hφA, -, -, hNo, heo, hN, he, hcov⟩ :=
    wc_qmbt_bof_atlas hπ' r₁ hr
  haveI := hNo
  haveI := heo
  have hL := wc_qmbt_D1l_chart_locus hπ hx₀ hsh hπ' hblf hps' θ r₁ ψ hθX hpbψ hψf φN φ eN e
    hNX hNA hφX hφA hN he hcov
  have hF := wc_qmbt_D1l_chart_factor hπ hx₀ hsh hπ' hblf hps' θ r₁ ψ hθX hpbψ hψf φN φ eN e
    hNX hNA hφX hφA hN he hcov

  have hcomm : ∀ x : ↥(Limits.pullback W.hom i₁),
      W.hom (Limits.pullback.fst W.hom i₁ x) = i₁ (Limits.pullback.snd W.hom i₁ x) := by
    intro x
    rw [← Scheme.Hom.comp_apply, Limits.pullback.condition, Scheme.Hom.comp_apply]
  have hwc : IsClosed ({Limits.pullback.fst W.hom i₁ t} : Set W.left) := by
    have := (Limits.pullback.fst W.hom i₁).isClosedEmbedding.isClosedMap _ ht
    rwa [Set.image_singleton] at this
  obtain ⟨hHens, hSep⟩ := hW _ hwc
  haveI := hHens
  haveI : IsSepClosed (IsLocalRing.ResidueField
      (W.left.presheaf.stalk (Limits.pullback.fst W.hom i₁ t))) := hSep
  have hWet : WeaklyEtale W.hom := W.prop
  have hcR : WeaklyEtale (W.left.fromSpecStalk (Limits.pullback.fst W.hom i₁ t) ≫ W.hom) := by
    haveI := wc_fromSpecStalk_weaklyEtale W.left (Limits.pullback.fst W.hom i₁ t)
    haveI := hWet
    first
    | infer_instance
    | exact @MorphismProperty.comp_mem _ _ @WeaklyEtale
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ ‹_› ‹_›

  have hcp : (W.left.fromSpecStalk (Limits.pullback.fst W.hom i₁ t) ≫ W.hom)
      (IsLocalRing.closedPoint (W.left.presheaf.stalk (Limits.pullback.fst W.hom i₁ t))) ∈
      Set.range i₁ := by
    refine ⟨Limits.pullback.snd W.hom i₁ t, ?_⟩
    rw [← hcomm]
    exact (congrArg W.hom Scheme.fromSpecStalk_closedPoint).symm.trans
      (Scheme.Hom.comp_apply _ _ _).symm
  have hcp' := hcp
  rw [h₁] at hcp'
  obtain ⟨j, y, hy⟩ := hL.1 _ hcp'
  obtain ⟨ρ, hρ, hρc⟩ := hF (W.left.presheaf.stalk (Limits.pullback.fst W.hom i₁ t))
    (W.left.fromSpecStalk (Limits.pullback.fst W.hom i₁ t) ≫ W.hom) hcR j y hy

  have key : ∀ p : Spec (W.left.presheaf.stalk (Limits.pullback.fst W.hom i₁ t)),
      ρ (Ideal.Quotient.mk _ (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' (c.map ιA) j)
        (MvPolynomial.X none))) ∈ p.asIdeal ↔
      (W.left.fromSpecStalk (Limits.pullback.fst W.hom i₁ t) ≫ W.hom) p ∈ Set.range i₁ := by
    intro p
    rw [h₁]
    exact (hL.2 _ j _ (hρc p)).2
  have hx : ρ (Ideal.Quotient.mk _ (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' (c.map ιA) j)
        (MvPolynomial.X none))) ∈
      IsLocalRing.maximalIdeal (W.left.presheaf.stalk (Limits.pullback.fst W.hom i₁ t)) :=
    (key _).2 hcp

  obtain ⟨τ, hτ, hker⟩ := wc_qmbt_D1l_chart_quot hπ' (c.map ιA) j
  have hc' : IsUnit (((c.map ιA).map (IsLocalRing.residue A')) +
      ((c.map ιA).map (IsLocalRing.residue A')).transpose).det := by
    have e1 : ((c.map ιA).map (IsLocalRing.residue A')) +
        ((c.map ιA).map (IsLocalRing.residue A')).transpose =
        (c + c.transpose).map ((IsLocalRing.residue A').comp ιA) := by
      ext a b
      simp [Matrix.map_apply, Matrix.transpose_apply]
    rw [e1]
    have h2 := hc.map ((IsLocalRing.residue A').comp ιA)
    rw [RingHom.map_det] at h2
    exact h2
  have hsm := wc_qmbt_D1l_chart_smooth ((c.map ιA).map (IsLocalRing.residue A')) hc' j
  have hprime := wc_shens_quot_prime_of_smooth_target
    (C := wcQmbtChart A' n π' (c.map ιA) j ⧸
      Ideal.span {algebraMap A' (wcQmbtChart A' n π' (c.map ιA) j) π'})
    (D := MvPolynomial (Option (Fin n)) (IsLocalRing.ResidueField A') ⧸
        Ideal.span {MvPolynomial.X none, wcQmbtBofQhat (IsLocalRing.ResidueField A') n
          ((c.map ιA).map (IsLocalRing.residue A')) j})
    (K := IsLocalRing.ResidueField A')
    (W.left.presheaf.stalk (Limits.pullback.fst W.hom i₁ t)) ρ hρ τ hτ
    (Ideal.Quotient.mk _ (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' (c.map ιA) j)
        (MvPolynomial.X none))) hker (by convert hx using 2) (n - 1) hsm

  let e₀ : Spec (W.left.presheaf.stalk (Limits.pullback.fst W.hom i₁ t)) := ⟨_, hprime⟩
  have he₀ : (W.left.fromSpecStalk (Limits.pullback.fst W.hom i₁ t) ≫ W.hom) e₀ ∈
      Set.range i₁ := (key e₀).1 (Ideal.subset_span (Set.mem_singleton _))
  obtain ⟨z, hz⟩ := he₀
  obtain ⟨E, hE1, -⟩ := Scheme.Pullback.exists_preimage_pullback
    (f := W.hom) (g := i₁) (W.left.fromSpecStalk (Limits.pullback.fst W.hom i₁ t) e₀) z
    (hz.trans (Scheme.Hom.comp_apply _ _ _)).symm
  refine ⟨E, fun y' hyt => ?_⟩
  have h1 : Limits.pullback.fst W.hom i₁ y' ⤳ Limits.pullback.fst W.hom i₁ t :=
    hyt.map (Limits.pullback.fst W.hom i₁).continuous
  have h2 : Limits.pullback.fst W.hom i₁ y' ∈
      Set.range (W.left.fromSpecStalk (Limits.pullback.fst W.hom i₁ t)) := by
    rw [Scheme.range_fromSpecStalk]
    exact h1
  obtain ⟨p, hp⟩ := h2
  have h3 : (W.left.fromSpecStalk (Limits.pullback.fst W.hom i₁ t) ≫ W.hom) p ∈
      Set.range i₁ := by
    refine ⟨Limits.pullback.snd W.hom i₁ y', ?_⟩
    rw [← hcomm]
    exact (congrArg W.hom hp).symm.trans (Scheme.Hom.comp_apply _ _ _).symm
  have h4 := (key p).2 h3
  have h5 : e₀ ⤳ p := (PrimeSpectrum.le_iff_specializes e₀ p).1
    ((Ideal.span_singleton_le_iff_mem _).2 h4)
  have h6 : Limits.pullback.fst W.hom i₁ E ⤳ Limits.pullback.fst W.hom i₁ y' := by
    rw [hE1, ← hp]
    exact h5.map (W.left.fromSpecStalk (Limits.pullback.fst W.hom i₁ t)).continuous
  exact (Limits.pullback.fst W.hom i₁).isClosedEmbedding.isInducing.specializes_iff.1 h6

theorem wc_qmbt_xsp_ess_D1l_Y_shriek_low {A : Type u} [CommRing A] [IsDomain A]
    [IsDiscreteValuationRing A]
    [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (hℓ : IsUnit ((ℓ : ℕ) : A)) {n : ℕ} (hn : Even n) (hn4 : 4 ≤ n) {π : A}
    {c : Matrix (Fin n) (Fin n) A}
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π}) (hc : IsUnit (c + c.transpose).det)
    {x₀ : Spec (.of (wcQuadModelRing A n π c))}
    (hx₀ : ∀ p, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
      PrimeSpectrum.asIdeal x₀)
    {B₀ : Type u} [CommRing B₀] [HenselianLocalRing B₀] [IsSepClosed (IsLocalRing.ResidueField B₀)]
    {Λ₀ : Type u} [SmallCategory Λ₀] [IsCofiltered Λ₀]
    {W₀ : Λ₀ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (wcQuadModelRing A n π c))) x₀))
      (Scheme.Etale.forget (Spec (.of (wcQuadModelRing A n π c))))}
    {φ₀ : ∀ l, Spec (.of B₀) ⟶ (W₀.obj l).right.left}
    {a₀ : Spec (.of B₀) ⟶ Spec (.of (wcQuadModelRing A n π c))}
    (hsh : wcHalShData x₀ B₀ Λ₀ W₀ φ₀ a₀)
    {Xs : Scheme.{u}} {ι : Xs ⟶ Spec (.of B₀)} {s : Xs ⟶ Spec (.of (IsLocalRing.ResidueField A))}
    (hps : IsPullback ι s (a₀ ≫ wcQuadModelStr A n π c) (wcQmSp A))
    {A' : Type u} [CommRing A'] [IsDomain A'] [IsDiscreteValuationRing A'] [HenselianLocalRing A']
    [IsSepClosed (IsLocalRing.ResidueField A')] {ιA : A →+* A'} {π' : A'}
    (hℓ' : IsUnit ((ℓ : ℕ) : A')) (hπ' : IsLocalRing.maximalIdeal A' = Ideal.span {π'})
    (hπ'2 : π' ^ 2 = ιA π) (hgen : ∀ a' : A', ∃ x y : A, a' = ιA x + ιA y * π')
    {L' : Type u} [Field L'] [IsSepClosed L'] {φ' : A' →+* L'} (hφ' : Function.Injective φ')
    (halg' : letI := φ'.toAlgebra; Algebra.IsAlgebraic A' L')
    {Xm : Scheme.{u}} {f : Xm ⟶ Spec (.of A')}
    {bl : Xm ⟶ Limits.pullback (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))}
    (hbl : wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range
      (fun i : Option (Fin n) => Option.elim i
        ((Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of A')).inv.hom π'))
        (fun j => ((Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))) ≫ a₀).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A n π c))).inv.hom
            (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X j)))))))) bl)
    (hblf : bl ≫ Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA)) = f)
    {XE' : Scheme.{u}} {p' : XE' ⟶ Xm} {q' : XE' ⟶ Spec (.of L')}
    (hpb' : IsPullback p' q' f (Spec.map (CommRingCat.ofHom φ')))
    {Xs' : Scheme.{u}} {ι' : Xs' ⟶ Xm} {s' : Xs' ⟶ Spec (.of (IsLocalRing.ResidueField A'))}
    (hps' : IsPullback ι' s' f (wcQmSp A'))
    {βs : Xs' ⟶ Xs}
    (hβ : βs ≫ ι = ι' ≫ bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA)))
    (Dβ : wcHMPullData βs ℓ) (hDβ : wcHMPullCanonical Dβ)
    [EnoughInjectives (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))]
    (Dp' : wcHMPullData p' ℓ) (hDp' : wcHMPullCanonical Dp')
    (Di' : wcHMPullData ι' ℓ) (hDi' : wcHMPullCanonical Di')
    (I' : InjectiveResolution (SheafOfModules.unit (wcRingSheaf XE' ℓ)))
    {Z₁ Z₂ ZY : Scheme.{u}} (i₁ : Z₁ ⟶ Xs') (i₂ : Z₂ ⟶ Xs') (iY : ZY ⟶ Xs')
