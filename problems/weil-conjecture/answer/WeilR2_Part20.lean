        ζ ≫ DerivedCategory.Q.map (CochainComplex.mappingCone.inr eΨ') ≫ Θ.hom := by
    have nat2 := (DerivedCategory.singleFunctorIsoCompQ (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))
      ((n : ℤ) - 1)).hom.naturality (wcSuppUnitMap E₂')
    have hcompφ : (DerivedCategory.singleFunctor (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))
        ((n : ℤ) - 1)).map (wcSuppUnitMap E₂) ≫
        (DerivedCategory.singleFunctor (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))
