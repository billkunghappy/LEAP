    rw [hs, hRf, hRf, Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
      ← Abelian.Ext.comp_assoc_of_third_deg_zero (Abelian.Ext.mk₀ τ.inv),
      Abelian.Ext.comp_assoc_of_third_deg_zero _
        (Abelian.Ext.mk₀ (Dw.Φ.map ((mt t).app (Limits.kernel (wcSuppUnitMap E₂))))),
      Abelian.Ext.mk₀_comp_mk₀, hτnat t, ← Abelian.Ext.mk₀_comp_mk₀,
      ← Abelian.Ext.comp_assoc_of_third_deg_zero]

  haveI hι : IsClosedImmersion ι :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion) hps.flip
      (IsClosedImmersion.spec_of_surjective (CommRingCat.ofHom (IsLocalRing.residue A))
        IsLocalRing.residue_surjective)
  let O : Xs.Opens := ⟨(ι ⁻¹' ({IsLocalRing.closedPoint B₀} : Set (Spec (.of B₀))))ᶜ,
    ((IsLocalRing.isClosed_singleton_closedPoint B₀).preimage ι.continuous).isOpen_compl⟩
  haveI hiso := wc_qmbt_pnst_beta_iso_off_pt hℓ hn hn4 hπ hc hx₀ hsh hps hℓ' hπ' hπ'2 hgen hbl
    hblf hps' hβ O rfl
  have hWo : Wo = βs ⁻¹ᵁ O := by
    apply TopologicalSpace.Opens.ext
    rw [Scheme.Hom.coe_preimage, hW]
    ext x
    show x ∈ (Set.range ⇑i₂)ᶜ ↔ βs x ∈ (ι ⁻¹' ({IsLocalRing.closedPoint B₀} : Set (Spec (.of B₀))))ᶜ
    rw [h₂]
    simp only [Set.mem_compl_iff, Set.mem_preimage, Set.mem_singleton_iff]
    rw [← hβ]
