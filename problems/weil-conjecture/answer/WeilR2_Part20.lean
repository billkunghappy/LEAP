        O₁.ι.appTop.hom s0 := IsUnit.unit_spec hsu
    have hiso : ∀ x : Localization.Away (Ideal.Quotient.mk I (ρ yc)),
        (Scheme.ΓSpecIso (CommRingCat.of (Localization.Away (Ideal.Quotient.mk I (ρ yc))))).hom.hom
          ((Scheme.ΓSpecIso (CommRingCat.of
            (Localization.Away (Ideal.Quotient.mk I (ρ yc))))).inv.hom x) = x :=
      fun x => congrArg (fun g : CommRingCat.of (Localization.Away (Ideal.Quotient.mk I (ρ yc))) ⟶
          CommRingCat.of (Localization.Away (Ideal.Quotient.mk I (ρ yc))) => g.hom x)
        (Iso.inv_hom_id (Scheme.ΓSpecIso
          (CommRingCat.of (Localization.Away (Ideal.Quotient.mk I (ρ yc))))))
    exact ((congrArg Λ (ha.trans (congrArg _ hu1))).trans (hΛ s0)).trans
