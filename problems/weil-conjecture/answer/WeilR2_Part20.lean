    rw [e1, ← RingHom.map_det]
    exact hc.map _
  let Oc : (Spec (.of (wcQuadModelRing (IsLocalRing.ResidueField A) n 0
      (c.map (IsLocalRing.residue A))))).Opens :=
    ⟨{y | ∃ p, Ideal.Quotient.mk (wcQuadModelIdeal (IsLocalRing.ResidueField A) n 0
        (c.map (IsLocalRing.residue A))) (MvPolynomial.X p) ∉ y.asIdeal}, by
      rw [Set.setOf_exists]
      exact isOpen_iUnion (fun p : Fin n => (PrimeSpectrum.basicOpen
        (Ideal.Quotient.mk (wcQuadModelIdeal (IsLocalRing.ResidueField A) n 0
          (c.map (IsLocalRing.residue A))) (MvPolynomial.X p))).isOpen)⟩
  obtain ⟨hfinC, hcardC⟩ := wc_quad_cone_sepclosed_punct_coh_counts
    (IsLocalRing.ResidueField A) ℓ hℓk n hn hn4 _ hcbar Oc rfl
  have hWcpt : CompactSpace (Wo : Set Xs') :=
    isCompact_iff_compactSpace.mp (TopologicalSpace.NoetherianSpace.isCompact _)
  haveI hWcpt' : CompactSpace Wo.toScheme := hWcpt
  haveI : QuasiSeparatedSpace Wo.toScheme := quasiSeparatedSpace_of_quasiSeparated Wo.ι
  have hsepW : IsSeparated (Limits.terminal.from Wo.toScheme) := by
    rw [show Limits.terminal.from Wo.toScheme = Wo.ι ≫ f₀ ≫ Limits.terminal.from (Spec (.of B₀))
      from Limits.terminal.hom_ext _ _]
