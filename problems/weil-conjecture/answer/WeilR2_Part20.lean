theorem wc_closed_coeff_stalk_trade {S Z ZY : Scheme.{u}} [IsLocallyNoetherian S] {ℓ : ℕ}
    [Fact (Nat.Prime ℓ)] (i : Z ⟶ S) [IsClosedImmersion i] (iY : ZY ⟶ S) [IsClosedImmersion iY]
    (Di : wcHMPullData i ℓ) (hDi : wcHMPullCanonical Di) (V : S.ProEt) (h1 : IsAffine V.left)
    (Dv : wcHMPullData V.hom ℓ) (hDv : wcHMPullCanonical Dv)
    (DV : wcHMPullData (Limits.pullback.fst V.hom iY) ℓ) (hDV : wcHMPullCanonical DV)
