      (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X _ k)
    have hXirr : ∀ k : Fin (d + 1 + 1), (MvPolynomial.X k : MvPolynomial (Fin (d + 1 + 1)) K) ∈
        HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) K) := by
      intro k
      rw [HomogeneousIdeal.mem_irrelevant_iff, GradedRing.proj_apply]
      have h6 : ((DirectSum.decompose (MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) K)
          (MvPolynomial.X k) 0 : MvPolynomial (Fin (d + 1 + 1)) K)) =
