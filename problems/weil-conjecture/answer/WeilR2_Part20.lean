    (wcDSingleTransport (C := C) ((n:ℤ) - 1) 1 ((n-2:ℕ):ℤ) e_a a)
  rw [Abelian.Ext.homAddEquiv_apply] at ha'
  obtain ⟨x', hx'⟩ := hH τ' hτ'0 a'
  obtain ⟨x, hx⟩ := hsurj ((n:ℤ) - 1) 3 ((n-4:ℕ):ℤ) e_x X₂ X₃ x'.hom
  refine ⟨x, hinj ((n:ℤ) - 1) 1 _ e_a X₂ X₁ ?_⟩
  rw [hcomp ((n:ℤ) - 1) 3 1 ((n-4:ℕ):ℤ) ((2:ℕ):ℤ) ((n-2:ℕ):ℤ) e_x e_τ e_a e_c X₂ X₃ X₁ x τ,
    hx, ← hτ', ← ha', hx', Abelian.Ext.comp_hom]

