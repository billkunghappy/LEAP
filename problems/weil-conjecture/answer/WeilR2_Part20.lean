  haveI := hsepW
  haveI hWnoeth : TopologicalSpace.NoetherianSpace Wo.toScheme :=
    TopologicalSpace.NoetherianSpace.set (Wo : Set Xs')
  have hfin : ∀ j : ℕ, Finite (wcEtCoh Wo.toScheme ℓ j) := by
    intro j
    rcases Nat.eq_zero_or_pos j with hj | hj
    · subst hj
      exact wc_et_coh_zero_finite_of_noetherianSpace Wo.toScheme ℓ (Fact.out : ℓ.Prime).ne_zero
    · obtain ⟨G⟩ := wc_qmbt_d2c_germ_cone_coh_equiv hℓ hπ hx₀ hsh hps O rfl Oc rfl j (by omega)
      obtain ⟨E⟩ := wc_et_coh_iso_invariance e ℓ j
      haveI := hfinC j
      exact Finite.of_equiv _ (G.symm.trans E)
  have hcard : Nat.card (wcEtCoh Wo.toScheme ℓ (n - 2)) ≤ ℓ := by
    obtain ⟨G⟩ := wc_qmbt_d2c_germ_cone_coh_equiv hℓ hπ hx₀ hsh hps O rfl Oc rfl (n - 2)
      (by omega)
    obtain ⟨E⟩ := wc_et_coh_iso_invariance e ℓ (n - 2)
    exact ((Nat.card_congr E).symm.trans ((Nat.card_congr G).trans hcardC)).le

  obtain ⟨η, hηinj, hηlin⟩ := wc_hm_line_of_et_tors_qcsep Wo.toScheme ℓ (n - 2) hfin hcard
  have hlaminj : ∀ x x', η (Rf x) = η (Rf x') → x = x' :=
    fun x x' h => hRinj x x' (hηinj h)
  have hlam0 : η (Rf 0) = 0 := by rw [hR0, map_zero]
  have hlamlin : ∀ (t : ℚ_[ℓ]) x,
      η (Rf (x.comp (Abelian.Ext.mk₀ ((mt t).app (Limits.kernel (wcSuppUnitMap E₂))))
        (add_zero _))) = t * η (Rf x) := by
    intro t x
    rw [hRlin, hηlin]

  have hExtCyc : ∀ ev ew : Abelian.Ext (wcSuppObj E₂) (Limits.kernel (wcSuppUnitMap E₂)) (n - 1),
      ev ≠ 0 → ∃ c₀ : wcSuppObj E₂ ⟶ wcSuppObj E₂,
        ew = (Abelian.Ext.mk₀ c₀).comp ev (zero_add _) := by
    intro ev ew hev
    obtain ⟨xv, hxv⟩ := hδsurj ev
    obtain ⟨xw, hxw⟩ := hδsurj ew
    have hlv : η (Rf xv) ≠ 0 := by
      intro h0
      apply hev
      have hx0 : xv = 0 := hlaminj xv 0 (h0.trans hlam0.symm)
      rw [← hxv, hx0, Abelian.Ext.comp_zero]
    obtain ⟨t, ht⟩ : ∃ t : ℚ_[ℓ], t = η (Rf xw) / η (Rf xv) := ⟨_, rfl⟩
    refine ⟨(mt t).app (wcSuppObj E₂), ?_⟩
    have hx : xw = xv.comp (Abelian.Ext.mk₀ ((mt t).app
        (Limits.kernel (wcSuppUnitMap E₂)))) (add_zero _) := by
      apply hlaminj
      rw [hlamlin, ht, div_mul_cancel₀ _ hlv]
    rw [hcent (mt t) ev, ← hxw, ← hxv, hx]
    exact (Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ _).symm

  let σ := (DerivedCategory.singleFunctors (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))).shiftIso
    ((n - 1 : ℕ) : ℤ) 0 ((n - 1 : ℕ) : ℤ) (add_zero _)
  let sF := fun (f : (DerivedCategory.singleFunctor (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))
      ((n - 1 : ℕ) : ℤ)).obj (wcSuppObj E₂) ⟶
      (DerivedCategory.singleFunctor (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)) 0).obj
        (Limits.kernel (wcSuppUnitMap E₂))) =>
    (σ.inv.app (wcSuppObj E₂) ≫ (shiftFunctor (DerivedCategory
      (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))) ((n - 1 : ℕ) : ℤ)).map f :
      ShiftedHom ((DerivedCategory.singleFunctor (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)) 0).obj
        (wcSuppObj E₂))
        ((DerivedCategory.singleFunctor (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)) 0).obj
          (Limits.kernel (wcSuppUnitMap E₂))) ((n - 1 : ℕ) : ℤ))
  have hsinj : ∀ f f', sF f = sF f' → f = f' := by
    intro f f' h
    apply (shiftFunctor (DerivedCategory (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)))
      ((n - 1 : ℕ) : ℤ)).map_injective
    exact (cancel_epi (σ.inv.app (wcSuppObj E₂))).1 h
  have hs0 : sF 0 = 0 := by
    show σ.inv.app (wcSuppObj E₂) ≫ (shiftFunctor (DerivedCategory
      (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))) ((n - 1 : ℕ) : ℤ)).map 0 = 0
    rw [Functor.map_zero, Limits.comp_zero]
  have hsnat : ∀ (c₀ : wcSuppObj E₂ ⟶ wcSuppObj E₂) f,
      sF ((DerivedCategory.singleFunctor (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))
        ((n - 1 : ℕ) : ℤ)).map c₀ ≫ f) =
      (DerivedCategory.singleFunctor (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)) 0).map c₀ ≫
        sF f := by
    intro c₀ f
    show σ.inv.app (wcSuppObj E₂) ≫ (shiftFunctor (DerivedCategory
        (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))) ((n - 1 : ℕ) : ℤ)).map
        ((DerivedCategory.singleFunctor (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))
          ((n - 1 : ℕ) : ℤ)).map c₀ ≫ f) =
      (DerivedCategory.singleFunctor (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)) 0).map c₀ ≫
        σ.inv.app (wcSuppObj E₂) ≫ (shiftFunctor (DerivedCategory
          (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))) ((n - 1 : ℕ) : ℤ)).map f
    rw [Functor.map_comp, ← Category.assoc, ← Category.assoc]
    congr 1
    exact (σ.inv.naturality c₀).symm
  have hv' : Abelian.Ext.homAddEquiv.symm (sF v) ≠ 0 := by
    intro h
    apply hv
    apply hsinj
    rw [hs0]
    have := congrArg Abelian.Ext.homAddEquiv h
    rwa [AddEquiv.apply_symm_apply, map_zero] at this
  obtain ⟨c₀, hc₀⟩ := hExtCyc _ (Abelian.Ext.homAddEquiv.symm (sF w)) hv'
  refine ⟨(DerivedCategory.singleFunctor (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))
    ((n - 1 : ℕ) : ℤ)).map c₀, hsinj _ _ ?_⟩
  rw [hsnat]
  have := congrArg Abelian.Ext.homAddEquiv hc₀
  rw [AddEquiv.apply_symm_apply, Abelian.Ext.homAddEquiv_apply, Abelian.Ext.comp_hom,
    Abelian.Ext.mk₀_hom, ShiftedHom.mk₀_comp, ← Abelian.Ext.homAddEquiv_apply,
    AddEquiv.apply_symm_apply] at this
  exact this

theorem wc_ysi_derived_two_indep_of_ext {C : Type*} [Category C] [Abelian C]
    [HasDerivedCategory C] [HasExt C] (X Y : C) (k : ℕ) (p q : ℤ) (hpq : p = q + k)
    (a b : Abelian.Ext X Y k) (ha : a ≠ 0)
    (hab : ∀ e₀ : X ⟶ X, b ≠ (Abelian.Ext.mk₀ e₀).comp a (zero_add k)) :
    ∃ x y : (DerivedCategory.singleFunctor C p).obj X ⟶ (DerivedCategory.singleFunctor C q).obj Y,
      x ≠ 0 ∧ ∀ e : (DerivedCategory.singleFunctor C p).obj X ⟶
        (DerivedCategory.singleFunctor C p).obj X, y ≠ e ≫ x :=
by
  have h2 : p + (-(k:ℤ)) = q := by omega
  have h3 : (k:ℤ) + (-(k:ℤ)) = 0 := add_neg_cancel _
  let SF := DerivedCategory.singleFunctors C
  let iX : (shiftFunctor (DerivedCategory C) p).obj ((DerivedCategory.singleFunctor C p).obj X) ≅
      (DerivedCategory.singleFunctor C 0).obj X :=
    (SF.shiftIso p 0 p (add_zero p)).app X
  let iY : (shiftFunctor (DerivedCategory C) p).obj ((DerivedCategory.singleFunctor C q).obj Y) ≅
      (DerivedCategory.singleFunctor C (-(k:ℤ))).obj Y :=
    (SF.shiftIso p (-(k:ℤ)) q h2).app Y
  let jY : (shiftFunctor (DerivedCategory C) (k:ℤ)).obj
      ((DerivedCategory.singleFunctor C 0).obj Y) ≅
      (DerivedCategory.singleFunctor C (-(k:ℤ))).obj Y :=
    (SF.shiftIso (k:ℤ) (-(k:ℤ)) 0 h3).app Y
  let Ψ : ((DerivedCategory.singleFunctor C p).obj X ⟶ (DerivedCategory.singleFunctor C q).obj Y) →
      ((DerivedCategory.singleFunctor C 0).obj X ⟶
        (shiftFunctor (DerivedCategory C) (k:ℤ)).obj ((DerivedCategory.singleFunctor C 0).obj Y)) :=
    fun f => iX.inv ≫ (shiftFunctor (DerivedCategory C) p).map f ≫ iY.hom ≫ jY.inv
  have hsurj : ∀ g, ∃ f, Ψ f = g := by
    intro g
    refine ⟨(shiftFunctor (DerivedCategory C) p).preimage (iX.hom ≫ g ≫ jY.hom ≫ iY.inv), ?_⟩
    simp only [Ψ, Functor.map_preimage, Category.assoc, Iso.inv_hom_id_assoc,
      Iso.hom_inv_id, Category.comp_id]
  have h0 : Ψ 0 = 0 := by simp [Ψ]
  have hnat : ∀ e f, Ψ (e ≫ f) = (DerivedCategory.singleFunctor C 0).map
      ((DerivedCategory.singleFunctor C 0).preimage
        (iX.inv ≫ (shiftFunctor (DerivedCategory C) p).map e ≫ iX.hom)) ≫ Ψ f := by
    intro e f
    rw [Functor.map_preimage]
    simp only [Ψ, Functor.map_comp, Category.assoc, Iso.hom_inv_id_assoc]
  obtain ⟨x, hx⟩ := hsurj a.hom
  obtain ⟨y, hy⟩ := hsurj b.hom
  refine ⟨x, y, ?_, ?_⟩
  · rintro rfl
    apply ha
    apply Abelian.Ext.ext
    rw [← hx, h0, Abelian.Ext.zero_hom]
  · intro e he
    apply hab ((DerivedCategory.singleFunctor C 0).preimage
      (iX.inv ≫ (shiftFunctor (DerivedCategory C) p).map e ≫ iX.hom))
    apply Abelian.Ext.ext
    rw [Abelian.Ext.comp_hom, Abelian.Ext.mk₀_hom, ShiftedHom.mk₀_comp, ← hy, he, hnat, hx]

theorem wc_ysi_supp_unit_hom_scalar {S Z : Scheme.{u}} (i : Z ⟶ S) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (D : wcHMPullData i ℓ) (hD : wcHMPullCanonical D) [PreconnectedSpace Z] :
    ∀ g : SheafOfModules.unit (wcRingSheaf S ℓ) ⟶ wcSuppObj D,
      ∃ c : ℚ_[ℓ], g = wcHMConst S ℓ c ≫ wcSuppUnitMap D :=
by
  intro g
  classical

  have hend : ∀ e : SheafOfModules.unit (wcRingSheaf Z ℓ) ⟶ SheafOfModules.unit (wcRingSheaf Z ℓ),
      ∃ t : ℚ_[ℓ], e = wcHMConst Z ℓ t := by
    intro e
    let R := wcRingSheaf Z ℓ
    let s := (SheafOfModules.unit R).unitHomEquiv e
    let σ : ∀ X : (Z.ProEt)ᵒᵖ, R.obj.obj X := fun X => (s.1 X : R.obj.obj X)
    have hσ : ∀ {X Y : (Z.ProEt)ᵒᵖ} (f : X ⟶ Y), (R.obj.map f).hom (σ X) = σ Y :=
      fun f => PresheafOfModules.sections_property s f
    let T : Z.ProEt := MorphismProperty.Over.mk ⊤ (𝟙 Z) (inferInstance : WeaklyEtale (𝟙 Z))
    let fT : C(↥Z, ULift.{u+1} ℚ_[ℓ]) := σ (Opposite.op T)
    let g0 : ↥Z → ℚ_[ℓ] := fun x => (fT x).down
    have hg0 : Continuous g0 := continuous_uliftDown.comp fT.continuous
    have hsub : (Set.range g0).Subsingleton := (isPreconnected_range hg0).subsingleton
    let t : ℚ_[ℓ] := if h : Nonempty ↥Z then g0 (Classical.choice h) else 0
    have ht : ∀ y : ↥Z, g0 y = t := by
      intro y
      have hne : Nonempty ↥Z := ⟨y⟩
      simp only [t, dif_pos hne]
      exact hsub ⟨y, rfl⟩ ⟨_, rfl⟩
    have hV : ∀ V : Z.ProEt, (σ (Opposite.op V) : C(↥V.left, ULift.{u+1} ℚ_[ℓ])) =
        ContinuousMap.const _ (ULift.up t) := by
      intro V
      let φ : V ⟶ T := MorphismProperty.Over.homMk (B := T) V.hom (Category.comp_id _) trivial
      have h1 : (fT.comp V.hom.base.hom : C(↥V.left, ULift.{u+1} ℚ_[ℓ])) =
          (σ (Opposite.op V) : C(↥V.left, ULift.{u+1} ℚ_[ℓ])) := hσ φ.op
      rw [← h1]
      apply ContinuousMap.ext
      intro v
      apply ULift.ext
      exact ht _
    refine ⟨t, ?_⟩
    apply (SheafOfModules.unit R).unitHomEquiv.injective
    unfold wcHMConst
    rw [Equiv.apply_symm_apply]
    apply PresheafOfModules.sections_ext
    intro X
    exact hV X.unop

  have hpull : ∀ c : ℚ_[ℓ],
      D.μ.inv ≫ D.Φ.map (wcHMConst S ℓ c) ≫ D.μ.hom = wcHMConst Z ℓ c := by
    intro c
    have key : ∀ g : SheafOfModules.unit (wcRingSheaf S ℓ) ⟶
        (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC i) _ _ D.cont D.φ).obj
          (SheafOfModules.unit (wcRingSheaf Z ℓ)),
        wcHMConst S ℓ c ≫ g =
          g ≫ (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC i) _ _ D.cont D.φ).map
            (wcHMConst Z ℓ c) := by
      intro g
      apply (SheafOfModules.unitHomEquiv _).injective
      apply PresheafOfModules.sections_ext
      intro X
      cases X with
      | op V =>
      rw [SheafOfModules.unitHomEquiv_apply_coe, SheafOfModules.unitHomEquiv_apply_coe]
      obtain ⟨a, b, hab, ha1, ha2⟩ : ∃ (a : ↑((wcRingSheaf S ℓ).val.obj (Opposite.op V)))
          (b : ↑((wcRingSheaf Z ℓ).val.obj (Opposite.op ((wcProEtBC i).obj V)))),
          @Eq ↑((wcRingSheaf Z ℓ).val.obj (Opposite.op ((wcProEtBC i).obj V)))
            ((D.φ.hom.app (Opposite.op V)).hom a) b ∧
          (∀ r : ↑((wcRingSheaf S ℓ).val.obj (Opposite.op V)),
            @Eq ↑((wcRingSheaf S ℓ).val.obj (Opposite.op V))
              (((wcHMConst S ℓ c).val.app (Opposite.op V)).hom r) (r * a)) ∧
          (∀ r : ↑((wcRingSheaf Z ℓ).val.obj (Opposite.op ((wcProEtBC i).obj V))),
            @Eq ↑((wcRingSheaf Z ℓ).val.obj (Opposite.op ((wcProEtBC i).obj V)))
              (((wcHMConst Z ℓ c).val.app (Opposite.op ((wcProEtBC i).obj V))).hom r) (r * b)) :=
        ⟨(ContinuousMap.const _ (ULift.up c) : C(↥V.left, ULift.{u+1} ℚ_[ℓ])),
          (ContinuousMap.const _ (ULift.up c) : C(↥(Limits.pullback V.hom i), ULift.{u+1} ℚ_[ℓ])),
          (hD V (ContinuousMap.const _ (ULift.up c))).trans rfl, fun r => rfl, fun r => rfl⟩
      change (g.val.app (Opposite.op V)).hom (((wcHMConst S ℓ c).val.app (Opposite.op V)).hom
            (@id ↑((SheafOfModules.unit (wcRingSheaf S ℓ)).val.obj (Opposite.op V))
              (1 : ↑((wcRingSheaf S ℓ).val.obj (Opposite.op V))))) =
          ((wcHMConst Z ℓ c).val.app (Opposite.op ((wcProEtBC i).obj V))).hom
            ((g.val.app (Opposite.op V)).hom
              (@id ↑((SheafOfModules.unit (wcRingSheaf S ℓ)).val.obj (Opposite.op V))
                (1 : ↑((wcRingSheaf S ℓ).val.obj (Opposite.op V)))))
      have e1 : ((wcHMConst S ℓ c).val.app (Opposite.op V)).hom
            (@id ↑((SheafOfModules.unit (wcRingSheaf S ℓ)).val.obj (Opposite.op V))
              (1 : ↑((wcRingSheaf S ℓ).val.obj (Opposite.op V)))) =
          a • (@id ↑((SheafOfModules.unit (wcRingSheaf S ℓ)).val.obj (Opposite.op V))
              (1 : ↑((wcRingSheaf S ℓ).val.obj (Opposite.op V)))) := by
        have h := ha1 1
        change @Eq ↑((wcRingSheaf S ℓ).val.obj (Opposite.op V))
          (((wcHMConst S ℓ c).val.app (Opposite.op V)).hom (1 : ↑((wcRingSheaf S ℓ).val.obj (Opposite.op V))))
          (a * 1)
        rw [h, one_mul, mul_one]
      rw [e1, LinearMap.map_smul]
      generalize (g.val.app (Opposite.op V)).hom
        (@id ↑((SheafOfModules.unit (wcRingSheaf S ℓ)).val.obj (Opposite.op V))
          (1 : ↑((wcRingSheaf S ℓ).val.obj (Opposite.op V)))) = y
      have h2 := ha2 y
      refine Eq.trans ?_ h2.symm
      change @Eq ↑((wcRingSheaf Z ℓ).val.obj (Opposite.op ((wcProEtBC i).obj V)))
        (@HMul.hMul ↑((wcRingSheaf Z ℓ).val.obj (Opposite.op ((wcProEtBC i).obj V)))
          ↑((wcRingSheaf Z ℓ).val.obj (Opposite.op ((wcProEtBC i).obj V)))
          ↑((wcRingSheaf Z ℓ).val.obj (Opposite.op ((wcProEtBC i).obj V))) instHMul
          ((D.φ.hom.app (Opposite.op V)).hom a) y)
        (@HMul.hMul ↑((wcRingSheaf Z ℓ).val.obj (Opposite.op ((wcProEtBC i).obj V)))
          ↑((wcRingSheaf Z ℓ).val.obj (Opposite.op ((wcProEtBC i).obj V)))
          ↑((wcRingSheaf Z ℓ).val.obj (Opposite.op ((wcProEtBC i).obj V))) instHMul y b)
      rw [hab]
      exact @mul_comm C(↥(Limits.pullback V.hom i), ULift.{u+1} ℚ_[ℓ]) _ b y
    have hmate : D.Φ.map (wcHMConst S ℓ c) ≫ D.μ.hom = D.μ.hom ≫ wcHMConst Z ℓ c := by
      apply (D.adj.homEquiv _ _).injective
      rw [Adjunction.homEquiv_naturality_left, Adjunction.homEquiv_naturality_right]
      exact key _
    rw [hmate, Iso.inv_hom_id_assoc]
  haveI := D.cont
  have main : ∀ g' : SheafOfModules.unit (wcRingSheaf S ℓ) ⟶
      (SheafOfModules.pushforward D.φ).obj (SheafOfModules.unit (wcRingSheaf Z ℓ)),
      ∃ c : ℚ_[ℓ], g' = wcHMConst S ℓ c ≫
        (D.adj.unit.app (SheafOfModules.unit (wcRingSheaf S ℓ)) ≫
          (SheafOfModules.pushforward D.φ).map D.μ.hom) := by
    intro g'
    obtain ⟨t, ht⟩ := hend (D.μ.inv ≫ (D.adj.homEquiv _ _).symm g')
    refine ⟨t, ?_⟩
    have hpc := hpull t
    have hg : D.adj.unit.app _ ≫ (SheafOfModules.pushforward D.φ).map
        ((D.adj.homEquiv _ _).symm g') = g' := by
      first
        | exact (D.adj.homEquiv_unit (f := (D.adj.homEquiv _ _).symm g')).symm.trans
            (Equiv.apply_symm_apply _ _)
        | exact (D.adj.homEquiv_unit _ _ ((D.adj.homEquiv _ _).symm g')).symm.trans
            (Equiv.apply_symm_apply _ _)
        | (erw [← Adjunction.homEquiv_unit, Equiv.apply_symm_apply])
    have hĝ : (D.adj.homEquiv _ _).symm g' = D.Φ.map (wcHMConst S ℓ t) ≫ D.μ.hom := by
      rw [← cancel_epi D.μ.inv, ht, hpc]
    rw [← hg, hĝ, Functor.map_comp]
    first
      | exact D.adj.unit_naturality_assoc (wcHMConst S ℓ t) _
      | exact (Category.assoc _ _ _).symm.trans
          ((congrArg (· ≫ _) (D.adj.unit_naturality (wcHMConst S ℓ t))).trans
            (Category.assoc _ _ _))
      | (erw [Adjunction.unit_naturality_assoc])
  obtain ⟨c, hc⟩ := main g
  exact ⟨c, hc⟩

theorem wc_ysi_Z2_preconnected {A : Type u} [CommRing A] [IsDomain A]
    [IsDiscreteValuationRing A]
    [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
