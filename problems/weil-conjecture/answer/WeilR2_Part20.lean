    (Dβ : wcHMPullData βs ℓ) (hDβ : wcHMPullCanonical Dβ)
    [EnoughInjectives (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))]
    (Dp' : wcHMPullData p' ℓ) (hDp' : wcHMPullCanonical Dp')
    (Di' : wcHMPullData ι' ℓ) (hDi' : wcHMPullCanonical Di')
    (I' : InjectiveResolution (SheafOfModules.unit (wcRingSheaf XE' ℓ)))
    {Z₁ : Scheme.{u}} (i₁ : Z₁ ⟶ Xs') [IsClosedImmersion i₁]
    (h₁ : Set.range i₁ = closure ((fun z => (ι' ≫ bl ≫ Limits.pullback.fst
      (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))) z) ⁻¹'
        {IsLocalRing.closedPoint B₀})ᶜ)
    (hG1 : ∀ {X₁ : Scheme.{u}}
      (r₁ : X₁ ⟶ Spec (.of (wcQuadModelRing A' n (π' ^ 2) (c.map ιA))))
      (_ : wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range fun k =>
        (Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)))).inv.hom
          (wcQmbtGen A' n π' (c.map ιA) k)))) r₁)
      (ω : wcQuadModelRing A' n (π' ^ 2) (c.map ιA) →+* AlgebraicClosure (IsLocalRing.ResidueField B₀))
      (_ : ∀ p, ω (Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) (c.map ιA)) (MvPolynomial.X p)) = 0)
      (_ : ω (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)) π') = 0),
      ∃ W : X₁.Opens,
        (∀ w ∈ W, algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)) π' ∈ PrimeSpectrum.asIdeal (r₁ w) →
          ∀ k, wcQmbtGen A' n π' (c.map ιA) k ∈ PrimeSpectrum.asIdeal (r₁ w)) ∧
        (∀ w, w ∉ W → (∀ k, wcQmbtGen A' n π' (c.map ιA) k ∈ PrimeSpectrum.asIdeal (r₁ w)) →
          ∃ w', w' ⤳ w ∧
            algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)) π' ∈ PrimeSpectrum.asIdeal (r₁ w') ∧
            ∃ k, wcQmbtGen A' n π' (c.map ιA) k ∉ PrimeSpectrum.asIdeal (r₁ w')) ∧
        SmoothOfRelativeDimension (n - 1) (Limits.pullback.snd r₁ (Spec.map (CommRingCat.ofHom ω))) ∧
        ∃ (Y : Scheme.{u}) (i : Y ⟶ Limits.pullback r₁ (Spec.map (CommRingCat.ofHom ω))),
          IsClosedImmersion i ∧
          SmoothOfRelativeDimension (n - 2) (i ≫ Limits.pullback.snd r₁ (Spec.map (CommRingCat.ofHom ω))) ∧
          Set.range i = (Limits.pullback.fst r₁ (Spec.map (CommRingCat.ofHom ω))) ⁻¹' (W : Set X₁)ᶜ ∧
          IsAffineOpen ((Limits.pullback.fst r₁ (Spec.map (CommRingCat.ofHom ω))) ⁻¹ᵁ W)) :
    SmoothOfRelativeDimension (n - 1) (Limits.pullback.snd (Limits.pullback.snd
      (ι' ≫ bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA)))
      (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B₀))))
      (Spec.map (CommRingCat.ofHom (algebraMap (IsLocalRing.ResidueField B₀)
        (AlgebraicClosure (IsLocalRing.ResidueField B₀)))))) ∧
    ∃ (Z : Scheme.{u}) (ιZ : Z ⟶ Limits.pullback (Limits.pullback.snd
      (ι' ≫ bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA)))
      (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B₀))))
      (Spec.map (CommRingCat.ofHom (algebraMap (IsLocalRing.ResidueField B₀)
        (AlgebraicClosure (IsLocalRing.ResidueField B₀)))))),
      IsClosedImmersion ιZ ∧
      SmoothOfRelativeDimension (n - 2) (ιZ ≫ Limits.pullback.snd (Limits.pullback.snd
        (ι' ≫ bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA)))
        (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B₀))))
        (Spec.map (CommRingCat.ofHom (algebraMap (IsLocalRing.ResidueField B₀)
          (AlgebraicClosure (IsLocalRing.ResidueField B₀)))))) ∧
      ∃ U : (Limits.pullback (Limits.pullback.snd
        (ι' ≫ bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA)))
        (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B₀))))
        (Spec.map (CommRingCat.ofHom (algebraMap (IsLocalRing.ResidueField B₀)
          (AlgebraicClosure (IsLocalRing.ResidueField B₀)))))).Opens,
        (U : Set _) = (Set.range ιZ)ᶜ ∧
        (U : Set _) = (fun z => (Limits.pullback.fst (Limits.pullback.snd
            (ι' ≫ bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA)))
            (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B₀))))
            (Spec.map (CommRingCat.ofHom (algebraMap (IsLocalRing.ResidueField B₀)
              (AlgebraicClosure (IsLocalRing.ResidueField B₀))))) ≫
          Limits.pullback.fst
            (ι' ≫ bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA)))
            (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B₀)))) z) ⁻¹' (Set.range i₁)ᶜ ∧
