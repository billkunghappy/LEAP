        (ℓ ^ k) 0) = ℓ ^ k ∧
      Nat.card (wcZModProEtExt (Limits.pullback ((Limits.pullback V.hom i₁).fromSpecStalk z) O₁.ι)
        (ℓ ^ k) 1) = ℓ ^ k :=
by
  classical

  have L2 : ∀ {S R T : CommRingCat.{u}} (φ : S ⟶ R) (θ : S ⟶ T)
      (_ : Function.Surjective θ.hom) (s : (S : Type u)) (_ : θ.hom s = 0)
      (ψ : T ⟶ CommRingCat.of ((R : Type u) ⧸ Ideal.span {φ.hom s}))
      (_ : θ ≫ ψ = φ ≫ CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {φ.hom s})))
      (_ : WeaklyEtale (Spec.map φ)), WeaklyEtale (Spec.map ψ) := by
    intro S R T φ θ hθ s hs ψ hψ hφ
    have hdesc : ∀ c : Limits.PushoutCocone φ θ, ∀ x ∈ Ideal.span {φ.hom s},
        c.inl.hom x = 0 := by
      intro c x hx
      obtain ⟨y, rfl⟩ := Ideal.mem_span_singleton'.1 hx
      have h : (φ ≫ c.inl).hom s = (θ ≫ c.inr).hom s := by rw [c.condition]
      have h2 : c.inl.hom (φ.hom s) = 0 := by
        refine h.trans ?_
        show c.inr.hom (θ.hom s) = 0
        rw [hs, map_zero]
      rw [map_mul, h2, mul_zero]
    have hpo : IsPushout φ θ (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {φ.hom s}))) ψ := by
      refine IsPushout.of_isColimit (c := Limits.PushoutCocone.mk _ ψ hψ.symm) ?_
      refine Limits.PushoutCocone.IsColimit.mk hψ.symm
        (fun c => CommRingCat.ofHom
          (Ideal.Quotient.lift (Ideal.span {φ.hom s}) c.inl.hom (hdesc c))) ?_ ?_ ?_
      · intro c
        apply CommRingCat.hom_ext
        apply RingHom.ext
        intro x
        show Ideal.Quotient.lift (Ideal.span {φ.hom s}) c.inl.hom (hdesc c)
          (Ideal.Quotient.mk (Ideal.span {φ.hom s}) x) = c.inl.hom x
        exact Ideal.Quotient.lift_mk _ _ _
      · intro c
        apply CommRingCat.hom_ext
        apply RingHom.ext
        intro t
        obtain ⟨x, rfl⟩ := hθ t
        have e1 : ψ.hom (θ.hom x) = Ideal.Quotient.mk (Ideal.span {φ.hom s}) (φ.hom x) := by
          have := congrArg (fun f => f.hom x) hψ
          simpa using this
        have e2 : c.inl.hom (φ.hom x) = c.inr.hom (θ.hom x) := by
          have := congrArg (fun f => f.hom x) c.condition
          simpa using this
        show Ideal.Quotient.lift (Ideal.span {φ.hom s}) c.inl.hom (hdesc c) (ψ.hom (θ.hom x)) =
          c.inr.hom (θ.hom x)
        rw [e1, Ideal.Quotient.lift_mk, e2]
      · intro c m hm1 _
        apply CommRingCat.hom_ext
        apply Ideal.Quotient.ringHom_ext
        apply RingHom.ext
        intro x
        show m.hom (Ideal.Quotient.mk (Ideal.span {φ.hom s}) x) =
          Ideal.Quotient.lift (Ideal.span {φ.hom s}) c.inl.hom (hdesc c) (Ideal.Quotient.mk _ x)
        rw [Ideal.Quotient.lift_mk]
        exact congrArg (fun f => f.hom x) hm1
    have hpb := isPullback_SpecMap_of_isPushout _ _ _ _ hpo
    exact MorphismProperty.of_isPullback (P := @WeaklyEtale) hpb hφ

  have LK : ∀ (K : Type u) [CommRing K] (n : ℕ),
      Function.Surjective (MvPolynomial.aeval (R := K)
        (Fin.cons (0 : MvPolynomial (Fin n) K) MvPolynomial.X :
          Fin (n + 1) → MvPolynomial (Fin n) K)) := by
    intro K _ n
    set θ := (MvPolynomial.aeval (R := K)
        (Fin.cons (0 : MvPolynomial (Fin n) K) MvPolynomial.X :
          Fin (n + 1) → MvPolynomial (Fin n) K)) with hθ
    set σ : MvPolynomial (Fin n) K →ₐ[K] MvPolynomial (Fin (n + 1)) K :=
      MvPolynomial.rename Fin.succ
    have hθσ : ∀ g, θ (σ g) = g := by
      intro g
      rw [hθ, MvPolynomial.aeval_rename]
      have : ((Fin.cons (0 : MvPolynomial (Fin n) K) MvPolynomial.X :
          Fin (n + 1) → MvPolynomial (Fin n) K) ∘ Fin.succ) = MvPolynomial.X := by
        funext i; simp
      rw [this, MvPolynomial.aeval_X_left]; rfl
    exact fun g => ⟨σ g, hθσ g⟩

  have hhalf : ∀ {W Y : Scheme.{u}} (f : W ⟶ Y) [IsClosedImmersion f], Set.range f = Set.univ →
      ∀ m q, Nat.card (wcEtCoh W m q) = Nat.card (wcEtCoh Y m q) := by
    intro W Y f _ hf m q
    have h1 := wc_et_fibre_coh_reduced_invariance Y Y Y W (𝟙 Y) f hf (𝟙 Y) m q
    haveI : IsIso (Limits.pullback.fst (f ≫ 𝟙 Y) (𝟙 Y)) :=
      Limits.pullback_fst_iso_of_right_iso _ _
    haveI : IsIso (Limits.pullback.fst (𝟙 Y) (𝟙 Y)) := Limits.pullback_fst_iso_of_right_iso _ _
    obtain ⟨e1⟩ := wc_et_coh_iso_invariance (Limits.pullback.fst (f ≫ 𝟙 Y) (𝟙 Y)) m q
    obtain ⟨e2⟩ := wc_et_coh_iso_invariance (Limits.pullback.fst (𝟙 Y) (𝟙 Y)) m q
    rw [Nat.card_congr e1, h1, ← Nat.card_congr e2]
  have L1 : ∀ {X P₁ P₂ : Scheme.{u}} (j₁ : P₁ ⟶ X) (j₂ : P₂ ⟶ X) [IsImmersion j₁]
      [IsImmersion j₂], Set.range j₁ = Set.range j₂ →
      ∀ m q, Nat.card (wcEtCoh P₁ m q) = Nat.card (wcEtCoh P₂ m q) := by
    intro X P₁ P₂ j₁ j₂ _ _ h m q
    haveI : IsImmersion (Limits.pullback.fst j₁ j₂) := inferInstance
    haveI : IsImmersion (Limits.pullback.snd j₁ j₂) := inferInstance
    haveI : IsPreimmersion (Limits.pullback.fst j₁ j₂) := inferInstance
    haveI : IsPreimmersion (Limits.pullback.snd j₁ j₂) := inferInstance
    have hf : Set.range (Limits.pullback.fst j₁ j₂) = Set.univ := by
      rw [Scheme.Pullback.range_fst, ← h, Set.preimage_range]
    have hs : Set.range (Limits.pullback.snd j₁ j₂) = Set.univ := by
      rw [Scheme.Pullback.range_snd, h, Set.preimage_range]
    haveI : IsClosedImmersion (Limits.pullback.fst j₁ j₂) :=
      IsClosedImmersion.of_isPreimmersion _ (by rw [hf]; exact isClosed_univ)
    haveI : IsClosedImmersion (Limits.pullback.snd j₁ j₂) :=
      IsClosedImmersion.of_isPreimmersion _ (by rw [hs]; exact isClosed_univ)
    rw [← hhalf (Limits.pullback.fst j₁ j₂) hf m q, hhalf (Limits.pullback.snd j₁ j₂) hs m q]

  have C2 : ∀ {X Y : Scheme.{u}} (p : X ⟶ Y) [IsClosedImmersion p] (x : X) (O : X.Opens),
      IsImmersion (Limits.pullback.fst (X.fromSpecStalk x) O.ι ≫ Spec.map (p.stalkMap x)) ∧
      Set.range ⇑(Limits.pullback.fst (X.fromSpecStalk x) O.ι ≫ Spec.map (p.stalkMap x)) =
        {q | Y.fromSpecStalk (p x) q ∈ ⇑p '' (O : Set X)} := by
    intro X Y p _ x O
    haveI : IsClosedImmersion (Spec.map (p.stalkMap x)) :=
      IsClosedImmersion.spec_of_surjective _ (SurjectiveOnStalks.stalkMap_surjective p x)
    have hE : ∀ w, Y.fromSpecStalk (p x) (Spec.map (p.stalkMap x) w) =
        p (X.fromSpecStalk x w) := by
      intro w
      calc Y.fromSpecStalk (p x) (Spec.map (p.stalkMap x) w)
          = (Spec.map (p.stalkMap x) ≫ Y.fromSpecStalk (p x)) w := by
            rw [Scheme.Hom.comp_apply]
        _ = (X.fromSpecStalk x ≫ p) w := by rw [Scheme.SpecMap_stalkMap_fromSpecStalk]
        _ = p (X.fromSpecStalk x w) := by rw [Scheme.Hom.comp_apply]
    refine ⟨inferInstance, ?_⟩
    ext q
    show q ∈ Set.range _ ↔ Y.fromSpecStalk (p x) q ∈ ⇑p '' (O : Set X)
    constructor
    · rintro ⟨t, rfl⟩
      have hc : X.fromSpecStalk x (Limits.pullback.fst (X.fromSpecStalk x) O.ι t) =
          O.ι (Limits.pullback.snd (X.fromSpecStalk x) O.ι t) := by
        calc X.fromSpecStalk x (Limits.pullback.fst (X.fromSpecStalk x) O.ι t)
            = (Limits.pullback.fst (X.fromSpecStalk x) O.ι ≫ X.fromSpecStalk x) t := by
              rw [Scheme.Hom.comp_apply]
          _ = (Limits.pullback.snd (X.fromSpecStalk x) O.ι ≫ O.ι) t := by
              rw [Limits.pullback.condition]
          _ = O.ι (Limits.pullback.snd (X.fromSpecStalk x) O.ι t) := by
              rw [Scheme.Hom.comp_apply]
      rw [Scheme.Hom.comp_apply, hE, hc]
      refine ⟨O.ι (Limits.pullback.snd (X.fromSpecStalk x) O.ι t), ?_, rfl⟩
      rw [← Scheme.Opens.range_ι O]
      exact ⟨_, rfl⟩
    · rintro ⟨w, hwO, hq⟩
      have h1 : p w ⤳ p x := by
        have hr : p w ∈ Set.range (Y.fromSpecStalk (p x)) := ⟨q, hq.symm⟩
        rw [Scheme.range_fromSpecStalk] at hr
        exact hr
      have h2 : w ⤳ x := (p.isClosedEmbedding.isInducing.specializes_iff).1 h1
      have h3 : w ∈ Set.range (X.fromSpecStalk x) := by
        rw [Scheme.range_fromSpecStalk]; exact h2
      obtain ⟨y, hy⟩ := h3
      have h4 : y ∈ Set.range (Limits.pullback.fst (X.fromSpecStalk x) O.ι) := by
        rw [Scheme.Pullback.range_fst, Scheme.Opens.range_ι, Set.mem_preimage, hy]
        exact hwO
      obtain ⟨t, ht⟩ := h4
      refine ⟨t, ?_⟩
      apply (Y.fromSpecStalk (p x)).isEmbedding.injective
      rw [Scheme.Hom.comp_apply, hE, ht, hy, hq]

  have C4 : ∀ (L : Type u) [Field L] [IsSepClosed L] (_ : ((ℓ : ℕ) : L) ≠ 0) (T : Scheme.{u})
      [CompactSpace T] [QuasiSeparatedSpace T] [PreconnectedSpace T] (qT : T ⟶ Spec (.of L))
      (_ : ∃ a : (Γ(T, ⊤))ˣ, ¬ ∃ b : (Γ(T, ⊤))ˣ, b ^ ℓ = a)
      (_ : Finite (wcEtCoh T ℓ 1)) (_ : Nat.card (wcEtCoh T ℓ 1) ≤ ℓ)
      (_ : Subsingleton (wcEtCoh T ℓ 2)),
      ∀ k : ℕ, 1 ≤ k → Finite (wcZModProEtExt T (ℓ ^ k) 1) ∧
        Nat.card (wcZModProEtExt T (ℓ ^ k) 0) = ℓ ^ k ∧
        Nat.card (wcZModProEtExt T (ℓ ^ k) 1) = ℓ ^ k := by
    intro L _ _ hℓL T _ _ _ qT hnot' h1fin h1le h2
    have hp : ℓ.Prime := Fact.out
    obtain ⟨a, ha⟩ := hnot'
    have k1 : ∀ m j, Nonempty (wcEtCoh T m j ≃ wcZModProEtExt T m j) := by
      intro m j
      obtain ⟨Θ, hΘ, -⟩ := wc_zmod_et_proet_natural_comparison_all m j
      obtain ⟨e₂⟩ := wc_et_zmodext_coh_equiv T m j
      exact ⟨e₂.symm.trans (Equiv.ofBijective (Θ T) (hΘ T inferInstance inferInstance))⟩
    have hne : Nonempty T := by
      by_contra hT
      rw [not_nonempty_iff] at hT
      haveI := hT
      apply ha
      refine ⟨1, ?_⟩
      rw [one_pow]
      apply Units.ext
      exact Subsingleton.elim _ _
    haveI : ConnectedSpace T := ConnectedSpace.mk hne
    obtain ⟨κt, κΛ, hK⟩ := wc_yrc_ladic_kummer_package L ℓ hℓL
    have hγ0 : κt T qT 1 a ≠ 0 := by
      intro h
      apply ha
      obtain ⟨b, hb⟩ := (hK.2.2.1 T qT 1 a le_rfl).1 h
      exact ⟨b, by simpa [pow_one] using hb⟩
    have hpow : ∀ m : ℕ, κt T qT 1 (a ^ m) = m • κt T qT 1 a := by
      intro m
      induction m with
      | zero =>
        rw [pow_zero, zero_smul]
        have h := hK.1 T qT 1 1 1
        rw [mul_one] at h
        exact add_left_cancel (h.symm.trans (add_zero _).symm)
      | succ m ih => rw [pow_succ a m, hK.1 T qT 1 (a ^ m) a, ih, succ_nsmul]
