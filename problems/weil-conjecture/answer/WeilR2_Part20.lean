        @wc_open_slice_res_preserves_injective V ℓ _ Vo hVo hG I hI
      haveI : Injective (Dw.Φ.obj I) := Injective.of_iso (Φiso.app I).symm hRI
      exact Abelian.Ext.eq_zero_of_injective e
    haveI : EnoughInjectives (SheafOfModules.{u+1} (wcRingSheaf V ℓ)) :=
      sheafOfModules_enoughInjectives (Scheme.ProEt.topology V) (wcRingSheaf V ℓ)
    refine ⟨ε, hε, fun n => ?_⟩
    have hT := ext_transfer_of_corep Dw.Φ (Limits.kernel (wcSuppUnitMap Dj))
      (SheafOfModules.unit (wcRingSheaf Wo.toScheme ℓ)) ε hhom hvan
