    rw [heq]
    haveI := IsClosedImmersion.spec_of_surjective
      (CommRingCat.ofHom ((IsLocalRing.residue A').comp ιA)) hsurj
    infer_instance
  have hps'' : IsPullback ι' s' (bl ≫ Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
