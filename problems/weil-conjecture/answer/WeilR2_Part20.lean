    have htw2 := wc_supp_hom_twist_formula EY' hEY' (wcSuppUnitMap EY') ((wcProEtBC i₁).obj V)
      (((wcSuppUnitMap E₁).val.app (Opposite.op V)).hom
        (((Limits.kernel.ι (wcSuppUnitMap EY)).val.app (Opposite.op V)).hom p))
    refine htw2.trans (ContinuousMap.ext fun q => ?_)
    have hc1 : V.hom ((Limits.pullback.fst V.hom i₁).base
          ((Limits.pullback.fst ((wcProEtBC i₁).obj V).hom iY').base q)) =
        i₁ ((Limits.pullback.snd V.hom i₁).base
          ((Limits.pullback.fst ((wcProEtBC i₁).obj V).hom iY').base q)) :=
      congrArg (fun φ => φ.base ((Limits.pullback.fst ((wcProEtBC i₁).obj V).hom iY').base q))
        (Limits.pullback.condition (f := V.hom) (g := i₁))
    have hc2 : ((wcProEtBC i₁).obj V).hom
          ((Limits.pullback.fst ((wcProEtBC i₁).obj V).hom iY').base q) =
        iY' ((Limits.pullback.snd ((wcProEtBC i₁).obj V).hom iY').base q) :=
