    intro N' g x
    rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
      Abelian.Ext.comp_assoc_of_third_deg_zero, h2P]
  have hκA : (γA ≫ adjA.unit.app (EA.Φ.obj (wcSuppObj D))) ≫ EA.Φ.map
      (adjA.counit.app (wcSuppObj D)) = γA := by
    rw [Category.assoc, adjA.right_triangle_components, Category.comp_id]
  have hκB : (γB ≫ adjB.unit.app (EB.Φ.obj (wcSuppObj D))) ≫ EB.Φ.map
      (adjB.counit.app (wcSuppObj D)) = γB := by
    rw [Category.assoc, adjB.right_triangle_components, Category.comp_id]
  have hκPA : ((γP ≫ adjP.unit.app (EP.Φ.obj (wcSuppObj D))) ≫ EP.Φ.map u) ≫
      EP.Φ.map (adjA.counit.app (wcSuppObj D)) = γP := by
    rw [Category.assoc, ← EP.Φ.map_comp, hu, Category.assoc, adjP.right_triangle_components,
      Category.comp_id]
  have hκPB : ((γP ≫ adjP.unit.app (EP.Φ.obj (wcSuppObj D))) ≫ EP.Φ.map v) ≫
      EP.Φ.map (adjB.counit.app (wcSuppObj D)) = γP := by
    rw [Category.assoc, ← EP.Φ.map_comp, hv, Category.assoc, adjP.right_triangle_components,
