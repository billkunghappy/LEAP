    have hcover : ∀ q : wcProjK K (d + 1), ∃ k : Fin (d + 1 + 1), q ∈ wcSgD K (d + 1) k := by
      intro q
      by_contra hno
      push_neg at hno
      have hall : ∀ i : Fin (d + 1 + 1), MvPolynomial.X i ∈ q.asHomogeneousIdeal.toIdeal := by
        intro i
