        (Limits.pullback.condition (f := ((wcProEtBC i₁).obj V).hom) (g := iY'))
    have e1 : iY (gY ((Limits.pullback.snd ((wcProEtBC i₁).obj V).hom iY').base q)) =
        i₁ (iY' ((Limits.pullback.snd ((wcProEtBC i₁).obj V).hom iY').base q)) :=
      congrArg (fun φ => φ.base ((Limits.pullback.snd ((wcProEtBC i₁).obj V).hom iY').base q)) hw
    have hx : V.hom ((Limits.pullback.fst V.hom i₁).base
          ((Limits.pullback.fst ((wcProEtBC i₁).obj V).hom iY').base q)) ∈ Set.range iY :=
      ⟨gY ((Limits.pullback.snd ((wcProEtBC i₁).obj V).hom iY').base q),
        e1.trans ((congrArg i₁.base hc2).symm.trans hc1.symm)⟩
    have h0 := s1 V p _ hx
    have h1 := congrArg (fun φ : C(↥(Limits.pullback V.hom i₁), ULift.{u+1} ℚ_[ℓ]) =>
      φ ((Limits.pullback.fst ((wcProEtBC i₁).obj V).hom iY').base q)) htw1
    have hs : (@id C(↥(Limits.pullback V.hom i₁), ULift.{u+1} ℚ_[ℓ])
        (((wcSuppUnitMap E₁).val.app (Opposite.op V)).hom
          (((Limits.kernel.ι (wcSuppUnitMap EY)).val.app (Opposite.op V)).hom p)))
        ((Limits.pullback.fst ((wcProEtBC i₁).obj V).hom iY').base q) = 0 := by
      refine h1.trans ?_
      show (@id C(↥V.left, ULift.{u+1} ℚ_[ℓ])
          (((Limits.kernel.ι (wcSuppUnitMap EY)).val.app (Opposite.op V)).hom p))
          ((Limits.pullback.fst V.hom i₁).base.hom
            ((Limits.pullback.fst ((wcProEtBC i₁).obj V).hom iY').base q)) *
        (wcSuppTwist (wcSuppUnitMap E₁))
          ((Limits.pullback.snd V.hom i₁).base.hom
            ((Limits.pullback.fst ((wcProEtBC i₁).obj V).hom iY').base q)) = 0
      exact (congrArg (fun a : ULift.{u+1} ℚ_[ℓ] => a * (wcSuppTwist (wcSuppUnitMap E₁))
          ((Limits.pullback.snd V.hom i₁).base.hom
            ((Limits.pullback.fst ((wcProEtBC i₁).obj V).hom iY').base q))) h0).trans
