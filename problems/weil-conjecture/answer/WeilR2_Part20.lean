    (Dw0 : wcHMPullData (U0.toScheme.basicOpen s0).ι ℓ) (hDw0 : wcHMPullCanonical Dw0)
    (ER0 : wcIntRatData (U0.toScheme.basicOpen s0).toScheme ℓ)
    (hER0 : ER0.adj.homEquiv _ _ ER0.μ.hom =
