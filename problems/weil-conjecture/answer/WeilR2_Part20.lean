  let e : Wo.toScheme ⟶ O.toScheme := (Xs'.isoOfEq hWo).hom ≫ (βs ∣_ O)
  haveI he : IsIso e := inferInstanceAs (IsIso ((Xs'.isoOfEq hWo).hom ≫ (βs ∣_ O)))
  have hℓk : ((ℓ : ℕ) : IsLocalRing.ResidueField A) ≠ 0 := by
    rw [← map_natCast (IsLocalRing.residue A) ℓ]
    exact (hℓ.map (IsLocalRing.residue A)).ne_zero
  have hcbar : IsUnit ((c.map (IsLocalRing.residue A)) +
      (c.map (IsLocalRing.residue A)).transpose).det := by
    have e1 : (c.map (IsLocalRing.residue A)) + (c.map (IsLocalRing.residue A)).transpose =
        (IsLocalRing.residue A).mapMatrix (c + c.transpose) := by
      ext i j
