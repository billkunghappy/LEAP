  have hP2 : ∀ w : X₁, w ∈ Set.range (Limits.pullback.fst t (wcQmSp A')) ↔
      algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)) π' ∈ (r₁ w).asIdeal := by
    intro w
    have hrange : Set.range (wcQmSp A') = {IsLocalRing.closedPoint A'} := by
      haveI : Subsingleton ↥(Spec (CommRingCat.of (IsLocalRing.ResidueField A'))) :=
        (inferInstance : Subsingleton (PrimeSpectrum (IsLocalRing.ResidueField A')))
      ext z
      constructor
      · rintro ⟨y, rfl⟩
        rw [Subsingleton.elim y (IsLocalRing.closedPoint (IsLocalRing.ResidueField A'))]
        exact IsLocalRing.comap_closedPoint (IsLocalRing.residue A')
      · rintro rfl
