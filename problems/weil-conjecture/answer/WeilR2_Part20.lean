      Limits.biprod.desc ρ₁ (-ρ₂) = 0)
    (hS : (ShortComplex.mk _ _ hz).ShortExact) :
    letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))
    ∀ y : (DerivedCategory.singleFunctor (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))
        ((n : ℤ) - 1)).obj (wcSuppObj E₂) ⟶
        (DerivedCategory.singleFunctor (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)) 1).obj
          (wcSuppObj E₂),
      y ≫ (DerivedCategory.singleFunctor (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)) 1).map ρ₂ = 0 →
      y = 0 :=
by
  letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))

  have s1 : ∀ {S : ShortComplex (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))} (_ : S.ShortExact)
      (k : ℤ) {P : DerivedCategory (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))}
      (f : P ⟶ (DerivedCategory.singleFunctor (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)) k).obj
        S.X₂),
      f ≫ (DerivedCategory.singleFunctor (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)) k).map S.g = 0 →
      ∃ h : P ⟶ (DerivedCategory.singleFunctor (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)) k).obj
          S.X₁,
        f = h ≫ (DerivedCategory.singleFunctor (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)) k).map
          S.f := by
    intro S hS' k P f hf
    have hT' := Pretriangulated.Triangle.shift_distinguished _
      hS'.singleTriangle_distinguished (-k)
    rw [Pretriangulated.Triangle.shiftFunctor_eq, Pretriangulated.Triangle.shiftFunctor_obj] at hT'
    let σ := (DerivedCategory.singleFunctors
      (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))).shiftIso (-k) k 0 (by omega)
    have nat : ∀ {X Y : SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)} (a : X ⟶ Y),
        (shiftFunctor (DerivedCategory (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))) (-k)).map
          ((DerivedCategory.singleFunctor (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)) 0).map a) ≫
          σ.hom.app Y =
        σ.hom.app X ≫ (DerivedCategory.singleFunctor (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)) k).map a :=
      fun a => σ.hom.naturality a
    have nat' : ∀ {X Y : SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)} (a : X ⟶ Y),
        σ.inv.app X ≫
          (shiftFunctor (DerivedCategory (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))) (-k)).map
            ((DerivedCategory.singleFunctor (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)) 0).map a) =
          (DerivedCategory.singleFunctor (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)) k).map a ≫
            σ.inv.app Y :=
      fun a => (σ.inv.naturality a).symm
    let f' : P ⟶ (shiftFunctor (DerivedCategory (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))) (-k)).obj
        ((DerivedCategory.singleFunctor (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)) 0).obj S.X₂) :=
      f ≫ σ.inv.app S.X₂
    have key2 : f' ≫ ((-k).negOnePow •
        (shiftFunctor (DerivedCategory (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))) (-k)).map
          ((DerivedCategory.singleFunctor (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)) 0).map S.g)) =
        0 := by
      simp only [f']
      rw [Linear.comp_units_smul, Category.assoc, nat', ← Category.assoc, hf,
        Limits.zero_comp, smul_zero]
    obtain ⟨h', hh'⟩ := Pretriangulated.Triangle.coyoneda_exact₂ _ hT' f' key2
    let h'' : P ⟶ (shiftFunctor (DerivedCategory (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))) (-k)).obj
        ((DerivedCategory.singleFunctor (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)) 0).obj S.X₁) := h'
    have hh'' : f' = h'' ≫ ((-k).negOnePow •
        (shiftFunctor (DerivedCategory (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))) (-k)).map
          ((DerivedCategory.singleFunctor (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)) 0).map S.f)) :=
      hh'
    refine ⟨(-k).negOnePow • (h'' ≫ σ.hom.app S.X₁), ?_⟩
    have e1 : f = f' ≫ σ.hom.app S.X₂ := by
      simp only [f']
      rw [Category.assoc, Iso.inv_hom_id_app, Category.comp_id]
    rw [e1, hh'', Linear.comp_units_smul, Linear.units_smul_comp, Linear.units_smul_comp,
      Category.assoc, Category.assoc, nat]
  intro y hy

  have hf₀ : (y ≫ (DerivedCategory.singleFunctor (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)) 1).map
      Limits.biprod.inr) ≫
      (DerivedCategory.singleFunctor (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)) 1).map
        (ShortComplex.mk _ _ hz).g = 0 := by
    show (y ≫ (DerivedCategory.singleFunctor (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)) 1).map
      Limits.biprod.inr) ≫
      (DerivedCategory.singleFunctor (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)) 1).map
        (Limits.biprod.desc ρ₁ (-ρ₂)) = 0
    rw [Category.assoc, ← Functor.map_comp, Limits.biprod.inr_desc, Functor.map_neg,
      Preadditive.comp_neg, hy, neg_zero]

  obtain ⟨g, hg⟩ := s1 hS 1 _ hf₀
  have hg' : y ≫ (DerivedCategory.singleFunctor (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)) 1).map
      Limits.biprod.inr = g ≫
      (DerivedCategory.singleFunctor (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)) 1).map
        (Limits.biprod.lift (wcSuppUnitMap E₁) (wcSuppUnitMap E₂)) := hg

  have hg₁ : g ≫ (DerivedCategory.singleFunctor (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)) 1).map
      (wcSuppUnitMap E₁) = 0 := by
    have := congrArg (· ≫ (DerivedCategory.singleFunctor
      (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)) 1).map Limits.biprod.fst) hg'
    simp only [Category.assoc, ← Functor.map_comp, Limits.biprod.inr_fst,
      Limits.biprod.lift_fst, Functor.map_zero, Limits.comp_zero] at this
    exact this.symm

  have hy₂ : y = g ≫ (DerivedCategory.singleFunctor (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)) 1).map
      (wcSuppUnitMap E₂) := by
    have := congrArg (· ≫ (DerivedCategory.singleFunctor
      (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)) 1).map Limits.biprod.snd) hg'
    simp only [Category.assoc, ← Functor.map_comp, Limits.biprod.inr_snd,
      Limits.biprod.lift_snd, Functor.map_id, Category.comp_id] at this
    rw [CategoryTheory.Functor.map_id, Category.comp_id] at this
    exact this

  haveI hepi := wc_supp_unit_epi_of_closed i₁ ℓ E₁ hE₁
  have hS₁ : (ShortComplex.mk (Limits.kernel.ι (wcSuppUnitMap E₁)) (wcSuppUnitMap E₁)
      (Limits.kernel.condition _)).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_kernel _) inferInstance hepi

  obtain ⟨z, hzg⟩ := s1 hS₁ 1 g hg₁

  have hz0 := wc_qmbt_xsp_ess_exc_open_part_vanish hℓ hn hn4 hπ hc hx₀ hsh hps hℓ' hπ' hπ'2
    hgen hφ' halg' hbl hblf hpb' hps' hβ Dβ hDβ Dp' hDp' Di' hDi' I' i₁ i₂ h₁ h₂
    E₁ hE₁ E₂ hE₂ z
  have hg0 : g = 0 := by
    rw [hzg, hz0, Limits.zero_comp]
  rw [hy₂, hg0, Limits.zero_comp]

theorem wc_qmd2c_germ_cone_chart {A : Type u} [CommRing A] [IsDomain A]
    [IsDiscreteValuationRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    {n : ℕ} {π : A} {c : Matrix (Fin n) (Fin n) A}
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π})
    {x₀ : Spec (.of (wcQuadModelRing A n π c))}
    (hx₀ : ∀ p, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
      PrimeSpectrum.asIdeal x₀)
    {B₀ : Type u} [CommRing B₀] [HenselianLocalRing B₀] [IsSepClosed (IsLocalRing.ResidueField B₀)]
    {Λ₀ : Type u} [SmallCategory Λ₀] [IsCofiltered Λ₀]
    {W₀ : Λ₀ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (wcQuadModelRing A n π c))) x₀))
      (Scheme.Etale.forget (Spec (.of (wcQuadModelRing A n π c))))}
    {φ₀ : ∀ l, Spec (.of B₀) ⟶ (W₀.obj l).right.left}
    {a₀ : Spec (.of B₀) ⟶ Spec (.of (wcQuadModelRing A n π c))}
    (hsh : wcHalShData x₀ B₀ Λ₀ W₀ φ₀ a₀)
    {Xs : Scheme.{u}} {ι : Xs ⟶ Spec (.of B₀)} {s : Xs ⟶ Spec (.of (IsLocalRing.ResidueField A))}
    (hps : IsPullback ι s (a₀ ≫ wcQuadModelStr A n π c) (wcQmSp A)) :
    ∃ (κ : Xs ⟶ Spec (.of (wcQuadModelRing (IsLocalRing.ResidueField A) n 0
          (c.map (IsLocalRing.residue A)))))
      (v : Spec (.of (wcQuadModelRing (IsLocalRing.ResidueField A) n 0
          (c.map (IsLocalRing.residue A))))),
      WeaklyEtale κ ∧
      (∀ w : Xs, κ w ≠ v ↔ ι w ≠ IsLocalRing.closedPoint B₀) ∧
      (∀ y : Spec (.of (wcQuadModelRing (IsLocalRing.ResidueField A) n 0
          (c.map (IsLocalRing.residue A)))),
        (∃ p, Ideal.Quotient.mk (wcQuadModelIdeal (IsLocalRing.ResidueField A) n 0
          (c.map (IsLocalRing.residue A))) (MvPolynomial.X p) ∉ y.asIdeal) ↔ y ≠ v) ∧
      IsIso (Limits.pullback.snd κ ((Spec (.of (wcQuadModelRing (IsLocalRing.ResidueField A) n 0
          (c.map (IsLocalRing.residue A))))).fromSpecResidueField v)) :=
by
  classical

  have hrπ : IsLocalRing.residue A π = 0 := by
    rw [IsLocalRing.residue_eq_zero_iff, hπ]
    exact Ideal.mem_span_singleton_self π
  have hC : ∀ a : A, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.C a) =
      algebraMap A (wcQuadModelRing A n π c) a := by
    intro a
    show _ = algebraMap A (MvPolynomial (Fin n) A ⧸ wcQuadModelIdeal A n π c) a
    rw [← Ideal.Quotient.mk_algebraMap, MvPolynomial.algebraMap_eq]
  have hCk : ∀ b : IsLocalRing.ResidueField A,
      Ideal.Quotient.mk (wcQuadModelIdeal (IsLocalRing.ResidueField A) n 0
        (c.map (IsLocalRing.residue A))) (MvPolynomial.C b) =
      algebraMap (IsLocalRing.ResidueField A) (wcQuadModelRing (IsLocalRing.ResidueField A) n 0
        (c.map (IsLocalRing.residue A))) b := by
    intro b
    show _ = algebraMap (IsLocalRing.ResidueField A)
      (MvPolynomial (Fin n) (IsLocalRing.ResidueField A) ⧸
        wcQuadModelIdeal (IsLocalRing.ResidueField A) n 0 (c.map (IsLocalRing.residue A))) b
    rw [← Ideal.Quotient.mk_algebraMap, MvPolynomial.algebraMap_eq]
  have hF1 : MvPolynomial.map (IsLocalRing.residue A)
      (∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q - MvPolynomial.C π) =
      ∑ p, ∑ q, MvPolynomial.C ((c.map (IsLocalRing.residue A)) p q) * MvPolynomial.X p *
        MvPolynomial.X q - MvPolynomial.C 0 := by
    simp only [map_sub, map_sum, map_mul, MvPolynomial.map_C, MvPolynomial.map_X, hrπ,
      Matrix.map_apply]
  have hGk : Ideal.Quotient.mk (wcQuadModelIdeal (IsLocalRing.ResidueField A) n 0
      (c.map (IsLocalRing.residue A)))
      (∑ p, ∑ q, MvPolynomial.C ((c.map (IsLocalRing.residue A)) p q) * MvPolynomial.X p *
        MvPolynomial.X q - MvPolynomial.C 0) = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _)
  obtain ⟨ρ, hρdef⟩ : ∃ ρ : wcQuadModelRing A n π c →+* wcQuadModelRing (IsLocalRing.ResidueField A)
      n 0 (c.map (IsLocalRing.residue A)),
      ρ = Ideal.Quotient.lift (wcQuadModelIdeal A n π c)
        ((Ideal.Quotient.mk (wcQuadModelIdeal (IsLocalRing.ResidueField A) n 0
          (c.map (IsLocalRing.residue A)))).comp (MvPolynomial.map (IsLocalRing.residue A))) (by
          intro a ha
          obtain ⟨b, rfl⟩ := Ideal.mem_span_singleton'.mp ha
          rw [RingHom.comp_apply, map_mul, map_mul, hF1, hGk, mul_zero]) :=
    ⟨_, rfl⟩
  have hρX : ∀ p, ρ (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p)) =
      Ideal.Quotient.mk (wcQuadModelIdeal (IsLocalRing.ResidueField A) n 0
        (c.map (IsLocalRing.residue A))) (MvPolynomial.X p) := by
    intro p
    rw [hρdef, Ideal.Quotient.lift_mk, RingHom.comp_apply, MvPolynomial.map_X]
  have hρC : ∀ a, ρ (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.C a)) =
      Ideal.Quotient.mk (wcQuadModelIdeal (IsLocalRing.ResidueField A) n 0
        (c.map (IsLocalRing.residue A))) (MvPolynomial.C (IsLocalRing.residue A a)) := by
    intro a
    rw [hρdef, Ideal.Quotient.lift_mk, RingHom.comp_apply, MvPolynomial.map_C]
  have hρA : ρ.comp (algebraMap A (wcQuadModelRing A n π c)) =
      (algebraMap (IsLocalRing.ResidueField A) (wcQuadModelRing (IsLocalRing.ResidueField A) n 0
        (c.map (IsLocalRing.residue A)))).comp (IsLocalRing.residue A) := by
    refine RingHom.ext fun a => ?_
    rw [RingHom.comp_apply, RingHom.comp_apply, ← hC, hρC, hCk]
  have hdesc : ∀ {T : Type u} [CommRing T] (u : wcQuadModelRing A n π c →+* T)
      (w : IsLocalRing.ResidueField A →+* T),
      u.comp (algebraMap A (wcQuadModelRing A n π c)) = w.comp (IsLocalRing.residue A) →
      ∀ a ∈ wcQuadModelIdeal (IsLocalRing.ResidueField A) n 0 (c.map (IsLocalRing.residue A)),
        MvPolynomial.eval₂Hom w (fun p => u (Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
          (MvPolynomial.X p))) a = 0 := by
    intro T _ u w hs a ha
    have hs' : ∀ x, u (algebraMap A (wcQuadModelRing A n π c) x) = w (IsLocalRing.residue A x) :=
      fun x => RingHom.congr_fun hs x
    obtain ⟨b, rfl⟩ := Ideal.mem_span_singleton'.mp ha
    rw [map_mul]
    have e : Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
        (∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q) =
        algebraMap A (wcQuadModelRing A n π c) π := by
      rw [← hC, Ideal.Quotient.eq]
      exact Ideal.mem_span_singleton_self _
    have e2 : MvPolynomial.eval₂Hom w (fun p => u (Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
          (MvPolynomial.X p)))
        (∑ p, ∑ q, MvPolynomial.C ((c.map (IsLocalRing.residue A)) p q) * MvPolynomial.X p *
          MvPolynomial.X q - MvPolynomial.C 0) =
        u (Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
          (∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q)) := by
      simp only [map_sub, map_sum, map_mul, MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_X',
        map_zero, sub_zero, Matrix.map_apply, hC, hs']
    rw [e2, e, hs', hrπ, map_zero, mul_zero]
  have hpush : IsPushout (CommRingCat.ofHom (algebraMap A (wcQuadModelRing A n π c)))
      (CommRingCat.ofHom (IsLocalRing.residue A)) (CommRingCat.ofHom ρ)
      (CommRingCat.ofHom (algebraMap (IsLocalRing.ResidueField A)
        (wcQuadModelRing (IsLocalRing.ResidueField A) n 0 (c.map (IsLocalRing.residue A))))) := by
    have hcond : ∀ s : Limits.PushoutCocone
        (CommRingCat.ofHom (algebraMap A (wcQuadModelRing A n π c)))
        (CommRingCat.ofHom (IsLocalRing.residue A)),
        s.inl.hom.comp (algebraMap A (wcQuadModelRing A n π c)) =
          s.inr.hom.comp (IsLocalRing.residue A) := by
      intro s
      have h := congrArg CommRingCat.Hom.hom s.condition
      simpa only [CommRingCat.hom_comp, CommRingCat.hom_ofHom] using h
    refine IsPushout.of_isColimit (Limits.PushoutCocone.IsColimit.mk
      (inl := CommRingCat.ofHom ρ)
      (inr := CommRingCat.ofHom (algebraMap (IsLocalRing.ResidueField A)
        (wcQuadModelRing (IsLocalRing.ResidueField A) n 0 (c.map (IsLocalRing.residue A)))))
      ?_ (fun s => CommRingCat.ofHom (Ideal.Quotient.lift
        (wcQuadModelIdeal (IsLocalRing.ResidueField A) n 0 (c.map (IsLocalRing.residue A)))
        (MvPolynomial.eval₂Hom s.inr.hom
          (fun p => s.inl.hom (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p))))
        (hdesc s.inl.hom s.inr.hom (hcond s)))) ?_ ?_ ?_)
    · rw [← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp, hρA]
    · intro s
      dsimp only
      apply CommRingCat.hom_ext
      rw [CommRingCat.hom_comp, CommRingCat.hom_ofHom, CommRingCat.hom_ofHom]
      apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext
      · intro a
        simp only [RingHom.comp_apply, hρC, Ideal.Quotient.lift_mk, MvPolynomial.eval₂Hom_C]
        rw [hC]
        exact (RingHom.congr_fun (hcond s) a).symm
      · intro p
        simp only [RingHom.comp_apply, hρX, Ideal.Quotient.lift_mk, MvPolynomial.eval₂Hom_X']
    · intro s
      dsimp only
      apply CommRingCat.hom_ext
      rw [CommRingCat.hom_comp, CommRingCat.hom_ofHom, CommRingCat.hom_ofHom]
      refine RingHom.ext fun b => ?_
      rw [RingHom.comp_apply, ← hCk, Ideal.Quotient.lift_mk, MvPolynomial.eval₂Hom_C]
    · intro s m h1 h2
      dsimp only
      apply CommRingCat.hom_ext
      rw [CommRingCat.hom_ofHom]
      apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext
      · intro b
        have h2' := RingHom.congr_fun (congrArg CommRingCat.Hom.hom h2) b
        rw [CommRingCat.hom_comp, CommRingCat.hom_ofHom] at h2'
        simp only [RingHom.comp_apply, Ideal.Quotient.lift_mk, MvPolynomial.eval₂Hom_C]
        rw [hCk]
        exact h2'
      · intro p
        have h1' := RingHom.congr_fun (congrArg CommRingCat.Hom.hom h1)
          (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p))
        rw [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply, hρX] at h1'
        simp only [RingHom.comp_apply, Ideal.Quotient.lift_mk, MvPolynomial.eval₂Hom_X']
        exact h1'

  have sq₀ := isPullback_SpecMap_of_isPushout _ _ _ _ hpush
  have hw : (ι ≫ a₀) ≫ wcQuadModelStr A n π c = s ≫ wcQmSp A := by
    rw [Category.assoc]; exact hps.toCommSq.w
  obtain ⟨κ, hκ₁, hκ₂⟩ : ∃ κ : Xs ⟶ Spec (.of (wcQuadModelRing (IsLocalRing.ResidueField A) n 0
      (c.map (IsLocalRing.residue A)))),
      κ ≫ Spec.map (CommRingCat.ofHom ρ) = ι ≫ a₀ ∧
      κ ≫ wcQuadModelStr (IsLocalRing.ResidueField A) n 0 (c.map (IsLocalRing.residue A)) = s :=
    ⟨sq₀.lift _ _ hw, sq₀.lift_fst _ _ hw, sq₀.lift_snd _ _ hw⟩
  have big : IsPullback ι
      (κ ≫ wcQuadModelStr (IsLocalRing.ResidueField A) n 0 (c.map (IsLocalRing.residue A)))
      (a₀ ≫ wcQuadModelStr A n π c) (wcQmSp A) := by
    rw [hκ₂]; exact hps
  have top : IsPullback ι κ a₀ (Spec.map (CommRingCat.ofHom ρ)) :=
    IsPullback.of_bot big hκ₁.symm sq₀
  have hκet : WeaklyEtale κ :=
    MorphismProperty.of_isPullback (P := @WeaklyEtale) top
      (wc_shdata_weaklyEtale x₀ B₀ Λ₀ W₀ φ₀ a₀ hsh)

  obtain ⟨huniq, v₀, -, hv₀X⟩ := wc_lup_quad_cone_vertex (IsLocalRing.ResidueField A) n
    (c.map (IsLocalRing.residue A))
  have hvert : ∀ y : Spec (.of (wcQuadModelRing (IsLocalRing.ResidueField A) n 0
      (c.map (IsLocalRing.residue A)))),
      y = v₀ (IsLocalRing.closedPoint (IsLocalRing.ResidueField A)) ↔
        ∀ p, Ideal.Quotient.mk (wcQuadModelIdeal (IsLocalRing.ResidueField A) n 0
          (c.map (IsLocalRing.residue A))) (MvPolynomial.X p) ∈ y.asIdeal :=
    fun y => ⟨by rintro rfl; exact hv₀X, fun h => huniq y _ h hv₀X⟩

  have hmax := (wc_qmbt_ecc_shens_maximal hπ hx₀ hsh).2.1
  have ha₀ : Spec.map (CommRingCat.ofHom (Spec.preimage a₀).hom) = a₀ := by
    rw [CommRingCat.ofHom_hom, Spec.map_preimage]
  have hκpt : ∀ w, Spec.map (CommRingCat.ofHom ρ) (κ w) = a₀ (ι w) := by
    intro w
    rw [← Scheme.Hom.comp_apply, hκ₁, Scheme.Hom.comp_apply]
  have hmem : ∀ w p, Ideal.Quotient.mk (wcQuadModelIdeal (IsLocalRing.ResidueField A) n 0
      (c.map (IsLocalRing.residue A))) (MvPolynomial.X p) ∈ (κ w).asIdeal ↔
      (Spec.preimage a₀).hom (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p)) ∈
        (ι w).asIdeal := by
    intro w p
    rw [← hρX p]
    show Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
        (Spec.map (CommRingCat.ofHom ρ) (κ w)).asIdeal ↔
      Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
        (Spec.map (CommRingCat.ofHom (Spec.preimage a₀).hom) (ι w)).asIdeal
    rw [hκpt, ha₀]
  have hcp : ∀ P : Spec (.of B₀), (∀ p, (Spec.preimage a₀).hom
      (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p)) ∈ P.asIdeal) ↔
      P = IsLocalRing.closedPoint B₀ := by
    intro P
    constructor
    · intro h
      have hle : IsLocalRing.maximalIdeal B₀ ≤ P.asIdeal := by
        rw [hmax]
        exact Ideal.span_le.mpr (Set.range_subset_iff.mpr h)
      exact PrimeSpectrum.ext ((IsLocalRing.maximalIdeal.isMaximal B₀).eq_of_le
        P.isPrime.ne_top hle).symm
    · rintro rfl p
      show _ ∈ IsLocalRing.maximalIdeal B₀
      rw [hmax]
      exact Ideal.subset_span ⟨p, rfl⟩

  have hM := wc_qmbt_bm_origin_maximal hπ n c
  have hρv : Spec.map (CommRingCat.ofHom ρ) (v₀ (IsLocalRing.closedPoint
      (IsLocalRing.ResidueField A))) = x₀ := by
    have h1 : Ideal.span (Set.range fun p : Fin n =>
        Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p)) ≤
        (Spec.map (CommRingCat.ofHom ρ) (v₀ (IsLocalRing.closedPoint
          (IsLocalRing.ResidueField A)))).asIdeal := by
      rw [Ideal.span_le, Set.range_subset_iff]
      intro p
      show ρ (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p)) ∈
        (v₀ (IsLocalRing.closedPoint (IsLocalRing.ResidueField A))).asIdeal
      rw [hρX]
      exact hv₀X p
    have h2 : Ideal.span (Set.range fun p : Fin n =>
        Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p)) ≤ x₀.asIdeal := by
      rw [Ideal.span_le, Set.range_subset_iff]
      exact hx₀
    exact PrimeSpectrum.ext ((hM.eq_of_le (PrimeSpectrum.isPrime _).ne_top h1).symm.trans
      (hM.eq_of_le (PrimeSpectrum.isPrime _).ne_top h2))
  have hg : IsIso (Limits.pullback.snd a₀ ((Spec (.of (wcQuadModelRing A n π c))).fromSpecResidueField
      (Spec.map (CommRingCat.ofHom ρ) (v₀ (IsLocalRing.closedPoint
        (IsLocalRing.ResidueField A)))))) := by
    have key := (wc_qmbt_hlsc_x0_fibre hπ hx₀ hsh).2.2
    rw [← hρv] at key
    exact key
  have he := (Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField
    (Spec.map (CommRingCat.ofHom ρ)) (v₀ (IsLocalRing.closedPoint
      (IsLocalRing.ResidueField A)))).symm

  have L2 : ∀ {X B C S T T₀ : Scheme.{u}} {ι' : X ⟶ B} {κ' : X ⟶ C} {a : B ⟶ S} {ρ' : C ⟶ S}
      (_ : IsPullback ι' κ' a ρ') (t : T ⟶ C) (e : T ⟶ T₀) (g : T₀ ⟶ S),
      t ≫ ρ' = e ≫ g → IsIso (Limits.pullback.snd a g) →
        IsIso (Limits.pullback.snd κ' t) := by
    intro X B C S T T₀ ι' κ' a ρ' h t e g het hg'
    have H1 := IsPullback.paste_vert (IsPullback.of_hasPullback κ' t).flip h.flip
    rw [het] at H1
    have hw' : (Limits.pullback.fst κ' t ≫ ι') ≫ a = (Limits.pullback.snd κ' t ≫ e) ≫ g := by
      rw [Category.assoc, h.toCommSq.w, ← Category.assoc, Limits.pullback.condition,
        Category.assoc, het, Category.assoc]
    obtain ⟨m, hm1, hm2⟩ : ∃ m : Limits.pullback κ' t ⟶ Limits.pullback a g,
        m ≫ Limits.pullback.fst a g = Limits.pullback.fst κ' t ≫ ι' ∧
        m ≫ Limits.pullback.snd a g = Limits.pullback.snd κ' t ≫ e :=
      ⟨Limits.pullback.lift _ _ hw', Limits.pullback.lift_fst _ _ hw',
        Limits.pullback.lift_snd _ _ hw'⟩
    have H1' : IsPullback (Limits.pullback.snd κ' t) (m ≫ Limits.pullback.fst a g) (e ≫ g) a := by
      rw [hm1]; exact H1
    have H3 := IsPullback.of_bot H1' hm2.symm (IsPullback.of_hasPullback a g).flip
    haveI := hg'
    exact IsPullback.isIso_fst_of_isIso H3
  refine ⟨κ, v₀ (IsLocalRing.closedPoint (IsLocalRing.ResidueField A)), hκet, fun w => ?_,
    fun y => ?_, L2 top _ _ _ he hg⟩
  · apply not_congr
    rw [hvert, ← hcp]
    exact forall_congr' fun p => hmem w p
  · rw [ne_eq, hvert, not_forall]

theorem wc_weaklyEtale_point_excision_coker_ext {W C : Scheme.{u}} [IsLocallyNoetherian C]
    [CompactSpace W] (κ : W ⟶ C) [WeaklyEtale κ] (v : C)
    (hfib : IsIso (Limits.pullback.snd κ (C.fromSpecResidueField v)))
    (Oc : C.Opens) (hOc : (Oc : Set C) = {v}ᶜ)
    (O : W.Opens) (hO : (O : Set W) = κ ⁻¹' {v}ᶜ) (m i : ℕ) :
    Nonempty (Abelian.Ext (Limits.cokernel (wcFreeSheafMap W
        (MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial :
          Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 W)))) (wcZModSheaf W m) i ≃
      Abelian.Ext (Limits.cokernel (wcFreeSheafMap C
        (MorphismProperty.Over.homMk Oc.ι (Category.comp_id _) trivial :
          Scheme.ProEt.mk Oc.ι ⟶ Scheme.ProEt.mk (𝟙 C)))) (wcZModSheaf C m) i) :=
by
  classical
  have H' : Set.range (O.ι ≫ κ) ⊆ Set.range Oc.ι := by
    rintro y ⟨w', rfl⟩
    rw [Scheme.Opens.range_ι, hOc]
    have hw' : (O.ι w') ∈ (O : Set W) := by
      rw [← Scheme.Opens.range_ι]; exact ⟨w', rfl⟩
    rw [hO] at hw'
    simpa using hw'
  haveI hOci : IsOpenImmersion Oc.ι := inferInstance
  haveI hOi : IsOpenImmersion O.ι := inferInstance
  let lf : (O : Scheme) ⟶ (Oc : Scheme) := IsOpenImmersion.lift Oc.ι (O.ι ≫ κ) H'
  have hlf : lf ≫ Oc.ι = O.ι ≫ κ := IsOpenImmersion.lift_fac Oc.ι (O.ι ≫ κ) H'
  let U : C.ProEt := Scheme.ProEt.mk (𝟙 C)
  let V : C.ProEt := Scheme.ProEt.mk Oc.ι
  let T : C.ProEt := Scheme.ProEt.mk κ
  let VT : C.ProEt := Scheme.ProEt.mk (O.ι ≫ κ)
  let ι : V ⟶ U := MorphismProperty.Over.homMk Oc.ι (Category.comp_id _) trivial
  let g : T ⟶ U := MorphismProperty.Over.homMk κ (Category.comp_id _) trivial
  let j : VT ⟶ T := MorphismProperty.Over.homMk O.ι rfl trivial
  let gV : VT ⟶ V := MorphismProperty.Over.homMk lf hlf trivial
  have hι : IsOpenImmersion ι.left := hOci
  have hj : IsOpenImmersion j.left := hOi
  have hr : Set.range ι.left = {v}ᶜ := by
    show Set.range Oc.ι = ({v}ᶜ : Set C)
    rw [Scheme.Opens.range_ι]
    exact hOc
  have hrj : Set.range j.left = g.left ⁻¹' {v}ᶜ := by
    show Set.range O.ι = κ ⁻¹' ({v}ᶜ : Set C)
    rw [Scheme.Opens.range_ι]
    exact hO
  have hgV : gV ≫ ι = j ≫ g := by
    apply MorphismProperty.Over.Hom.ext
    exact hlf
  have hfib' : IsIso (Limits.pullback.snd g.left (U.left.fromSpecResidueField v)) := hfib
  have hT : CompactSpace T.left := (inferInstance : CompactSpace W)
  have hqs : QuasiSeparatedSpace U.left := (inferInstance : QuasiSeparatedSpace C)
  have hln : IsLocallyNoetherian U.left := (inferInstance : IsLocallyNoetherian C)
  obtain ⟨κ', hκ', -⟩ :=
    wc_lfi_point_excision C U V T VT ι hι v hr g j hj hrj gV hgV hfib' hT hqs hln
  haveI := hκ'
  have E₁ : Abelian.Ext (Limits.cokernel (wcFreeSheafMap C ι)) (wcZModSheaf C m) i ≃
      Abelian.Ext (Limits.cokernel (wcFreeSheafMap C j)) (wcZModSheaf C m) i :=
    { toFun := fun e => (Abelian.Ext.mk₀ κ').comp e (zero_add i)
      invFun := fun e => (Abelian.Ext.mk₀ (inv κ')).comp e (zero_add i)
      left_inv := fun e => by
        simp only
        rw [← Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add i) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, IsIso.inv_hom_id, Abelian.Ext.mk₀_id_comp]
      right_inv := fun e => by
        simp only
        rw [← Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add i) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, IsIso.hom_inv_id, Abelian.Ext.mk₀_id_comp] }
  haveI : IsOpenImmersion j.left := hj
  have E₂ := (wc_glc_coker_slice C T VT j m i).some
  exact ⟨(E₁.trans E₂).symm⟩

theorem wc_proet_strict_local_punct_coker_ext (X : Scheme.{u}) (R : Type u) [CommRing R]
    [HenselianLocalRing R] [IsSepClosed (IsLocalRing.ResidueField R)] [IsNoetherianRing R]
    (e : X ≅ Spec (.of R)) (O : X.Opens) (m j : ℕ) (hj : 1 ≤ j) :
    Nonempty (Abelian.Ext (Limits.cokernel (wcFreeSheafMap X
        (MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial :
          Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 X))))
        (wcZModSheaf X m) (j + 1) ≃ wcEtCoh (O : Scheme.{u}) m j) :=
by
  classical

  haveI : TopologicalSpace.NoetherianSpace X :=
    e.hom.isOpenEmbedding.isInducing.noetherianSpace
  haveI hcO : CompactSpace (Scheme.ProEt.mk O.ι).left :=
    isCompact_iff_compactSpace.mp (TopologicalSpace.NoetherianSpace.isCompact (O : Set X))
  have hsepO : IsSeparated (Limits.terminal.from (O : Scheme.{u})) := by
    have h : Limits.terminal.from (O : Scheme.{u}) =
        O.ι ≫ e.hom ≫ Limits.terminal.from (Spec (.of R)) :=
      Limits.terminal.hom_ext _ _
    rw [h]
    infer_instance
  haveI hsO : IsSeparated (Limits.terminal.from (Scheme.ProEt.mk O.ι).left) := hsepO

  have hmono : Mono (wcFreeSheafMap X
      (MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial :
        Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 X))) :=
    wc_free_sheaf_map_mono _ _ _ _ (IsOpenImmersion.mono O.ι)
  have hS : (ShortComplex.mk (wcFreeSheafMap X
      (MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial :
        Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 X)))
      (Limits.cokernel.π _) (Limits.cokernel.condition _)).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel _) hmono inferInstance

  haveI hP : Projective (wcFreeSheaf X (Scheme.ProEt.mk (𝟙 X))) :=
    wc_proet_free_projective_strict_local X (Scheme.ProEt.mk (𝟙 X)) R e

  have s4 : ∀ q : ℕ, 1 ≤ q → ∀ x : Abelian.Ext
      (wcFreeSheaf X (Scheme.ProEt.mk (𝟙 X))) (wcZModSheaf X m) q, x = 0 := by
    intro q hq x
    obtain ⟨q', rfl⟩ : ∃ q', q = q' + 1 := ⟨q - 1, by omega⟩
    exact Abelian.Ext.eq_zero_of_projective x

  have hjj : 1 + j = j + 1 := by omega
  let δ : Abelian.Ext (wcFreeSheaf X (Scheme.ProEt.mk O.ι)) (wcZModSheaf X m) j →
      Abelian.Ext (Limits.cokernel (wcFreeSheafMap X
        (MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial :
          Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 X))))
        (wcZModSheaf X m) (j + 1) :=
    fun x => hS.extClass.comp x hjj
  have hinj : Function.Injective δ := by
    intro a b hab
    have h0 : hS.extClass.comp (a - b) hjj = 0 := by
      rw [sub_eq_add_neg, Abelian.Ext.comp_add, Abelian.Ext.comp_neg]
      change δ a + -δ b = 0
      rw [hab, add_neg_cancel]
    obtain ⟨x₂, hx₂⟩ := Abelian.Ext.contravariant_sequence_exact₁ hS _ (a - b) hjj h0
    rw [s4 j hj x₂, Abelian.Ext.comp_zero] at hx₂
    exact sub_eq_zero.mp hx₂.symm
  have hsurj : Function.Surjective δ := by
    intro x₃
    obtain ⟨x₁, hx₁⟩ := Abelian.Ext.contravariant_sequence_exact₃ hS _ x₃
      (s4 (j + 1) (by omega) _) hjj
    exact ⟨x₁, hx₁⟩

  obtain ⟨E₁⟩ := wc_ext_free_slice_zmod X (Scheme.ProEt.mk O.ι) m j
  obtain ⟨-, hcont⟩ := wc_etToProEt_flat_cont (Scheme.ProEt.mk O.ι).left
  haveI := hcont
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology (Scheme.ProEt.mk O.ι).left)
    AddCommGrpCat.{u+1}) := HasExt.standard _
  obtain ⟨E₀⟩ := wc_proet_etale_comparison_epsInv_qcsep (Scheme.ProEt.mk O.ι).left
    ((constantSheaf (Scheme.smallEtaleTopology (Scheme.ProEt.mk O.ι).left) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) j
  let χ : (wcEpsInv (Scheme.ProEt.mk O.ι).left).obj ((constantSheaf (Scheme.smallEtaleTopology
        (Scheme.ProEt.mk O.ι).left) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) ≅
      wcZModSheaf (Scheme.ProEt.mk O.ι).left m :=
    (wc_epsInv_const (Scheme.ProEt.mk O.ι).left
      (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))).some ≪≫
      (wc_zmod_sheaf_const (Scheme.ProEt.mk O.ι).left m).some.symm
  have post : ∀ {A B B' : Sheaf (Scheme.ProEt.topology (Scheme.ProEt.mk O.ι).left)
      AddCommGrpCat.{u+1}} (e : B ≅ B'),
      Nonempty (Abelian.Ext A B j ≃ Abelian.Ext A B' j) := by
    intro A B B' e
    refine ⟨{ toFun := fun y => y.comp (Abelian.Ext.mk₀ e.hom) (add_zero j)
              invFun := fun y => y.comp (Abelian.Ext.mk₀ e.inv) (add_zero j)
              left_inv := fun y => ?_
              right_inv := fun y => ?_ }⟩
    · simp only
      rw [Abelian.Ext.comp_assoc _ _ _ (add_zero j) (add_zero 0) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
    · simp only
      rw [Abelian.Ext.comp_assoc _ _ _ (add_zero j) (add_zero 0) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.comp_mk₀_id]
  obtain ⟨E₂⟩ := post (A := wcFreeSheaf (Scheme.ProEt.mk O.ι).left
    (Scheme.ProEt.mk (𝟙 (Scheme.ProEt.mk O.ι).left))) χ.symm
  let Ec : Abelian.Ext (wcFreeSheaf X (Scheme.ProEt.mk O.ι)) (wcZModSheaf X m) j ≃
      wcEtCoh (O : Scheme.{u}) m j := E₁.trans (E₂.trans E₀)

  exact ⟨(Equiv.ofBijective δ ⟨hinj, hsurj⟩).symm.trans Ec⟩

theorem wc_qmbt_d2c_germ_cone_coh_equiv {A : Type u} [CommRing A] [IsDomain A]
    [IsDiscreteValuationRing A]
    [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (hℓ : IsUnit ((ℓ : ℕ) : A)) {n : ℕ} {π : A}
    {c : Matrix (Fin n) (Fin n) A}
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π})
    {x₀ : Spec (.of (wcQuadModelRing A n π c))}
    (hx₀ : ∀ p, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
      PrimeSpectrum.asIdeal x₀)
    {B₀ : Type u} [CommRing B₀] [HenselianLocalRing B₀] [IsSepClosed (IsLocalRing.ResidueField B₀)]
    {Λ₀ : Type u} [SmallCategory Λ₀] [IsCofiltered Λ₀]
    {W₀ : Λ₀ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (wcQuadModelRing A n π c))) x₀))
      (Scheme.Etale.forget (Spec (.of (wcQuadModelRing A n π c))))}
    {φ₀ : ∀ l, Spec (.of B₀) ⟶ (W₀.obj l).right.left}
    {a₀ : Spec (.of B₀) ⟶ Spec (.of (wcQuadModelRing A n π c))}
    (hsh : wcHalShData x₀ B₀ Λ₀ W₀ φ₀ a₀)
    {Xs : Scheme.{u}} {ι : Xs ⟶ Spec (.of B₀)} {s : Xs ⟶ Spec (.of (IsLocalRing.ResidueField A))}
    (hps : IsPullback ι s (a₀ ≫ wcQuadModelStr A n π c) (wcQmSp A))
    (O : Xs.Opens) (hO : (O : Set Xs) = (ι ⁻¹' {IsLocalRing.closedPoint B₀})ᶜ)
    (Oc : (Spec (.of (wcQuadModelRing (IsLocalRing.ResidueField A) n 0
      (c.map (IsLocalRing.residue A))))).Opens)
    (hOc : (Oc : Set (Spec (.of (wcQuadModelRing (IsLocalRing.ResidueField A) n 0
      (c.map (IsLocalRing.residue A)))))) =
      {y | ∃ p, Ideal.Quotient.mk (wcQuadModelIdeal (IsLocalRing.ResidueField A) n 0
        (c.map (IsLocalRing.residue A))) (MvPolynomial.X p) ∉ y.asIdeal})
    (q : ℕ) (hq : 1 ≤ q) :
    Nonempty (wcEtCoh (O : Scheme.{u}) ℓ q ≃ wcEtCoh (Oc : Scheme.{u}) ℓ q) :=
by
  classical

  have hℓk : ((ℓ : ℕ) : IsLocalRing.ResidueField A) ≠ 0 := by
    rw [← map_natCast (IsLocalRing.residue A) ℓ]
    exact (hℓ.map (IsLocalRing.residue A)).ne_zero

  obtain ⟨κ, v, hκ, hpre, hv, hfib⟩ := wc_qmd2c_germ_cone_chart hπ hx₀ hsh hps
  haveI := hκ

  obtain ⟨α, ha₀⟩ : ∃ α : wcQuadModelRing A n π c →+* B₀,
      Spec.map (CommRingCat.ofHom α) = a₀ :=
    ⟨(Spec.preimage a₀).hom, by rw [CommRingCat.ofHom_hom, Spec.map_preimage]⟩
  obtain ⟨φ, hφdef⟩ : ∃ φ : A →+* B₀, φ = α.comp (algebraMap A (wcQuadModelRing A n π c)) :=
    ⟨_, rfl⟩
  have hφ : Spec.map (CommRingCat.ofHom φ) = a₀ ≫ wcQuadModelStr A n π c := by
    rw [hφdef, CommRingCat.ofHom_comp, Spec.map_comp, ha₀]
  have hres : ∀ q : Spec (CommRingCat.of (IsLocalRing.ResidueField B₀)),
      Spec.map (CommRingCat.ofHom (IsLocalRing.residue B₀)) q = IsLocalRing.closedPoint B₀ :=
    fun q => IsLocalRing.PrimeSpectrum.comap_residue B₀ q
  have hpt : a₀ (IsLocalRing.closedPoint B₀) = x₀ := by
    obtain ⟨e, -, he⟩ := hsh.2.2.2.2.2
    let pt : ↥(Spec (CommRingCat.of (AlgebraicClosure
        ↑((Spec (CommRingCat.of (wcQuadModelRing A n π c))).residueField x₀)))) :=
      IsLocalRing.closedPoint _
    have h : (Spec.map (CommRingCat.ofHom e) ≫ Spec.map (CommRingCat.ofHom
        (IsLocalRing.residue B₀)) ≫ a₀) pt =
        wcEtGeomPt (Spec (CommRingCat.of (wcQuadModelRing A n π c))) x₀ pt := by
      rw [he]
    simp only [wcEtGeomPt, Scheme.Hom.comp_apply, Scheme.fromSpecResidueField_apply] at h
    rw [hres] at h
    exact h.trans (Scheme.fromSpecResidueField_apply x₀ _)
  have hx₀' : x₀ = Spec.map (CommRingCat.ofHom α) (IsLocalRing.closedPoint B₀) := by
    rw [ha₀, hpt]
  have hX : ∀ p, α (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p)) ∈
      IsLocalRing.maximalIdeal B₀ := by
    intro p
    have h := hx₀ p
    rw [hx₀'] at h
    exact h
  have hπm : φ π ∈ IsLocalRing.maximalIdeal B₀ := by
    have h1 : algebraMap A (wcQuadModelRing A n π c) π =
        Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
          (∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q) := by
      show algebraMap A (MvPolynomial (Fin n) A ⧸ wcQuadModelIdeal A n π c) π = _
      rw [← Ideal.Quotient.mk_algebraMap, MvPolynomial.algebraMap_eq, Ideal.Quotient.eq]
      have e1 : MvPolynomial.C π - ∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p *
            MvPolynomial.X q =
          -(∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q -
            MvPolynomial.C π) := by ring
      rw [e1]
      exact neg_mem (Ideal.mem_span_singleton_self _)
    rw [hφdef, RingHom.comp_apply, h1]
    simp only [map_sum, map_mul]
    exact Ideal.sum_mem _ fun p _ => Ideal.sum_mem _ fun q _ => Ideal.mul_mem_left _ _ (hX q)
  have hJ : Ideal.map φ (IsLocalRing.maximalIdeal A) ≠ ⊤ := by
    intro htop
    have hle : Ideal.map φ (IsLocalRing.maximalIdeal A) ≤ IsLocalRing.maximalIdeal B₀ := by
      rw [Ideal.map_le_iff_le_comap, hπ, Ideal.span_singleton_le_iff_mem]
      exact hπm
    rw [htop] at hle
    exact (IsLocalRing.maximalIdeal.isMaximal B₀).ne_top (top_le_iff.mp hle)
  have hps2 := hps
  rw [← hφ] at hps2
  have eX : Xs ≅ Spec (CommRingCat.of (B₀ ⧸ Ideal.map φ (IsLocalRing.maximalIdeal A))) := by
    letI : Algebra A B₀ := φ.toAlgebra
    have h2 := isPullback_SpecMap_of_isPushout _ _ _ _
      (CommRingCat.isPushout_tensorProduct A B₀ (IsLocalRing.ResidueField A))
    try rw [RingHom.algebraMap_toAlgebra] at h2
    try rw [IsLocalRing.ResidueField.algebraMap_eq] at h2
    exact hps2.isoIsPullback _ _ h2 ≪≫ Scheme.Spec.mapIso
      ((Algebra.TensorProduct.quotIdealMapEquivTensorQuot B₀
        (IsLocalRing.maximalIdeal A)).toRingEquiv.toCommRingCatIso.op)
  obtain ⟨hh, hsep⟩ := wc_quot_strictly_henselian_of_ne_top B₀ _ hJ
  haveI : IsNoetherianRing B₀ := (wc_qmbt_ecc_shens_maximal hπ hx₀ hsh).1
  have hnoeth : IsNoetherianRing (B₀ ⧸ Ideal.map φ (IsLocalRing.maximalIdeal A)) :=
    Ideal.Quotient.isNoetherianRing _

  haveI : CompactSpace Xs := QuasiCompact.compactSpace_of_compactSpace eX.hom
  haveI : IsNoetherianRing (wcQuadModelRing (IsLocalRing.ResidueField A) n 0
      (c.map (IsLocalRing.residue A))) := by
    unfold wcQuadModelRing; infer_instance

  have hO' : (O : Set Xs) = κ ⁻¹' {v}ᶜ := by
    rw [hO]
    ext w
    simp only [Set.mem_compl_iff, Set.mem_preimage, Set.mem_singleton_iff]
    exact (hpre w).symm
  have hOc' : (Oc : Set (Spec (.of (wcQuadModelRing (IsLocalRing.ResidueField A) n 0
      (c.map (IsLocalRing.residue A)))))) = {v}ᶜ := by
    rw [hOc]
    ext y
    simp only [Set.mem_setOf_eq, Set.mem_compl_iff, Set.mem_singleton_iff]
    exact hv y

  obtain ⟨E₃⟩ := wc_weaklyEtale_point_excision_coker_ext κ v hfib Oc hOc' O hO' ℓ (q + 1)
  obtain ⟨E₄⟩ := @wc_proet_strict_local_punct_coker_ext Xs
    (B₀ ⧸ Ideal.map φ (IsLocalRing.maximalIdeal A)) _ hh hsep hnoeth eX O ℓ q hq
  obtain ⟨E₅⟩ := wc_quad_cone_vertex_coker_ext (IsLocalRing.ResidueField A) ℓ hℓk n
    (c.map (IsLocalRing.residue A)) v Oc hOc' 1 q le_rfl hq
  rw [pow_one] at E₅
  exact ⟨E₄.symm.trans (E₃.trans E₅)⟩

theorem wc_quad_cone_sepclosed_punct_mid_vanish (k : Type u) [Field k] [IsSepClosed k] (ℓ : ℕ)
    [Fact (Nat.Prime ℓ)] (hℓ : ((ℓ : ℕ) : k) ≠ 0) (n : ℕ) (hn : Even n) (h4 : 4 ≤ n)
    (c : Matrix (Fin n) (Fin n) k) (hc : IsUnit (c + c.transpose).det)
    (Oc : (Spec (.of (wcQuadModelRing k n 0 c))).Opens)
    (hOc : (Oc : Set (Spec (.of (wcQuadModelRing k n 0 c)))) =
      {y | ∃ p, Ideal.Quotient.mk (wcQuadModelIdeal k n 0 c) (MvPolynomial.X p) ∉ y.asIdeal}) :
    Subsingleton (wcEtCoh (Oc : Scheme.{u}) ℓ (n - 3)) :=
by
  classical
  have hint : (algebraMap k (AlgebraicClosure k)).IsIntegral := by
    haveI := AlgebraicClosure.isAlgebraic k
    intro x
    exact Algebra.IsIntegral.isIntegral x
  have hℓK : ((ℓ : ℕ) : AlgebraicClosure k) ≠ 0 := by
    rw [← map_natCast (algebraMap k (AlgebraicClosure k))]
    exact (map_ne_zero _).mpr hℓ
  have hcK : IsUnit ((c.map (algebraMap k (AlgebraicClosure k))) +
      (c.map (algebraMap k (AlgebraicClosure k))).transpose).det := by
    have e1 : (c.map (algebraMap k (AlgebraicClosure k))) +
        (c.map (algebraMap k (AlgebraicClosure k))).transpose =
        (algebraMap k (AlgebraicClosure k)).mapMatrix (c + c.transpose) := by
      ext i j
      simp [Matrix.add_apply, Matrix.transpose_apply]
    rw [e1, ← RingHom.map_det]
    exact hc.map _
  have key := wc_qmbt_bm_quad_pullback (algebraMap k (AlgebraicClosure k)) n 0 c
    (0 : AlgebraicClosure k) (by rw [map_zero]; exact zero_pow two_ne_zero)
  have h0 : (0 : AlgebraicClosure k) ^ 2 = 0 := zero_pow two_ne_zero
  rw [h0] at key
  obtain ⟨θ, hθX, -, hpb⟩ := key
  have hP := IsPullback.paste_vert (isPullback_morphismRestrict (Spec.map (CommRingCat.ofHom θ)) Oc)
    hpb
  have hOcK : ((Spec.map (CommRingCat.ofHom θ) ⁻¹ᵁ Oc :
      (Spec (.of (wcQuadModelRing (AlgebraicClosure k) n 0
        (c.map (algebraMap k (AlgebraicClosure k)))))).Opens) :
      Set (Spec (.of (wcQuadModelRing (AlgebraicClosure k) n 0
        (c.map (algebraMap k (AlgebraicClosure k))))))) =
      {y | ∃ p, Ideal.Quotient.mk (wcQuadModelIdeal (AlgebraicClosure k) n 0
        (c.map (algebraMap k (AlgebraicClosure k)))) (MvPolynomial.X p) ∉ y.asIdeal} := by
    rw [Scheme.Hom.coe_preimage, hOc]
    ext y
    simp only [Set.mem_preimage, Set.mem_setOf_eq]
    refine exists_congr (fun p => ?_)
    rw [← hθX p]
    rfl
  let Oh : (Spec (.of (wcQuadModelRing (AlgebraicClosure k) n 0 (Matrix.of fun p q : Fin n =>
      if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : AlgebraicClosure k) else 0)))).Opens :=
    ⟨{y | ∃ p, Ideal.Quotient.mk (wcQuadModelIdeal (AlgebraicClosure k) n 0
        (Matrix.of fun p q : Fin n =>
          if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : AlgebraicClosure k) else 0))
        (MvPolynomial.X p) ∉ y.asIdeal}, by
      rw [Set.setOf_exists]
      exact isOpen_iUnion (fun p : Fin n => (PrimeSpectrum.basicOpen
        (Ideal.Quotient.mk (wcQuadModelIdeal (AlgebraicClosure k) n 0
          (Matrix.of fun p q : Fin n =>
            if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : AlgebraicClosure k) else 0))
          (MvPolynomial.X p))).isOpen)⟩
  obtain ⟨e1⟩ := wc_et_coh_purely_inseparable_invariance k (AlgebraicClosure k) hint
    (Oc : Scheme.{u}) (Oc.ι ≫ wcQuadModelStr k n 0 c) ℓ (n - 3)
  obtain ⟨e2⟩ := wc_et_coh_iso_invariance hP.isoPullback.hom ℓ (n - 3)
  obtain ⟨e3⟩ := wc_quad_cone_punct_coh_hyperbolic_transport (AlgebraicClosure k) n hn (by omega)
    (c.map (algebraMap k (AlgebraicClosure k))) hcK _ hOcK Oh rfl ℓ (n - 3)
  haveI := (wc_hyp_cone_punct_mid_coh_mod_ell (AlgebraicClosure k) ℓ hℓK n hn h4 Oh rfl).1
  haveI := e3.subsingleton
  haveI := e2.subsingleton
  exact e1.symm.subsingleton

theorem wc_qmbt_xsp_ess_D2_compl_ext_vanish {A : Type u} [CommRing A] [IsDomain A]
