    have nat2 : (shiftFunctor (DerivedCategory (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)))
          (-1 : ℤ)).map ((DerivedCategory.singleFunctor
            (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)) 0).map S.g) ≫ σ.hom.app S.X₃ =
        σ.hom.app S.X₂ ≫ (DerivedCategory.singleFunctor
          (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)) 1).map S.g :=
      σ.hom.naturality S.g
    have E : ∀ f₀ : P ⟶ (DerivedCategory.singleFunctor
          (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)) 1).obj S.X₃, f₀ ≫ δ = 0 →
        ∃ a : P ⟶ (DerivedCategory.singleFunctor
            (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)) 1).obj S.X₂,
          f₀ = a ≫ (DerivedCategory.singleFunctor
            (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)) 1).map S.g := by
      intro f₀ hf
      have h1 : (f₀ ≫ σ.inv.app S.X₃) ≫ T'.mor₃ = 0 := by
        have h0 : ((f₀ ≫ σ.inv.app S.X₃) ≫ T'.mor₃) ≫ θ.hom = 0 :=
          (Category.assoc _ _ _).trans ((Category.assoc _ _ _).trans hf)
        exact (cancel_mono θ.hom).1 (h0.trans Limits.zero_comp.symm)
      obtain ⟨g, hg⟩ := Pretriangulated.Triangle.coyoneda_exact₃ T' hT' _ h1
      let M : (shiftFunctor (DerivedCategory (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)))
