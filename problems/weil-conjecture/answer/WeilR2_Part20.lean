theorem wc_qmbt_dlyt_basicOpen_data {Y' Z : Scheme.{u}} (iY' : Y' ⟶ Z) (ℓ : ℕ)
    [Fact (Nat.Prime ℓ)] : wcQdBO iY' ℓ :=
by
  intro U0 x0 hzero0 T X g hle i hiC hi s hs
  haveI : IsClosedImmersion i := hiC
  have hpt : ∀ z : X, z ∈ X.basicOpen s ↔ z ∉ Set.range i := by
    intro z
    have hgz : g z ∈ U0 := by
      have : z ∈ g ⁻¹ᵁ U0 := hle (show z ∈ (⊤ : X.Opens) from trivial)
      exact (Scheme.Hom.mem_preimage g).mp this
    have h1 : z ∈ X.basicOpen s ↔ g z ∈ Z.basicOpen x0 := by
      rw [hs, Scheme.basicOpen_appLE]
      constructor
      · intro h
        exact (Scheme.Hom.mem_preimage g).mp h.2
      · intro h
        exact ⟨trivial, (Scheme.Hom.mem_preimage g).mpr h⟩
    have h2 : z ∈ Set.range i ↔ g z ∈ Set.range iY' := by
      rw [hi]; rfl
    have h3 := hzero0 (g z) hgz
    rw [h1, h2, h3]
    tauto
  refine ⟨?_, ?_, ?_⟩
  · ext z
    exact hpt z
  · have hU : IsUnit ((X.presheaf.map (homOfLE (X.basicOpen_le s)).op).hom s) :=
      (RingedSpace.isUnit_res_basicOpen X.toRingedSpace s :
        IsUnit ((X.presheaf.map (homOfLE (X.basicOpen_le s)).op).hom s))
    have key : ∀ (V : X.Opens) (hV : V = X.basicOpen s) (h : V ≤ ⊤),
        IsUnit ((X.presheaf.map (homOfLE h).op).hom s) := by
      rintro V rfl h
      exact hU
    rw [Scheme.Opens.ι_appTop]
    exact key _ (Scheme.Opens.ι_image_top _) _
  · intro Di hDi
    have hqc : ∀ (W : Scheme.{u}) [IsAffine W] (p : W ⟶ X), ∃ (n : ℕ) (f : Fin n → Γ(W, ⊤)),
        ∀ x : ↥W, (p x ∉ Set.range i ↔ ∃ k, x ∈ W.basicOpen (f k)) := by
      intro W _ p
      refine ⟨1, fun _ => (p.app ⊤).hom s, ?_⟩
      intro x
      have e : x ∈ W.basicOpen ((p.app ⊤).hom s) ↔ p x ∈ X.basicOpen s := by
        rw [← Scheme.preimage_basicOpen]
        exact Scheme.Hom.mem_preimage p
      constructor
      · intro h
        exact ⟨0, e.mpr ((hpt (p x)).mpr h)⟩
      · rintro ⟨_, h⟩
        exact (hpt (p x)).mp (e.mp h)
    intro U k W g' hW
    exact wc_supp_kernel_section_local_cover_qc i hqc Di hDi U k W g' hW

theorem wc_qmbt_dlyt_kummer_int_mul (L : Type u) [Field L] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (κt : ∀ (T : Scheme.{u}), (T ⟶ Spec (.of L)) → ∀ k : ℕ, (Γ(T, ⊤))ˣ → wcZModProEtExt T (ℓ ^ k) 1)
    (κΛ : ∀ (T : Scheme.{u}), (T ⟶ Spec (.of L)) → (Γ(T, ⊤))ˣ → wcIntExt T ℓ 1)
    (hK : wcYrcKummerPkg L ℓ κt κΛ) (T : Scheme.{u}) (qT : T ⟶ Spec (.of L))
    (a b : (Γ(T, ⊤))ˣ) : κΛ T qT (a * b) = κΛ T qT a + κΛ T qT b :=
by
  obtain ⟨hTr, ht⟩ := wc_int_red_transfer T ℓ
  have hM := (wc_int_red_milnor T ℓ hTr ht 1).2.2.1
  have hZ := hM (wc_zmod_deg0_lim1_zero T ℓ)
  have h0 := hZ (κΛ T qT (a * b) - κΛ T qT a - κΛ T qT b) (by
    intro k hk
    rw [map_sub, map_sub, hK.2.2.2 T qT k (a * b) hk, hK.2.2.2 T qT k a hk,
      hK.2.2.2 T qT k b hk, hK.1 T qT k a b]
    abel)
  rw [sub_sub, sub_eq_zero] at h0
  exact h0

theorem wc_qmbt_dlyt_kummer_rho_pull (L : Type u) [Field L] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (κt : ∀ (T : Scheme.{u}), (T ⟶ Spec (.of L)) → ∀ k : ℕ, (Γ(T, ⊤))ˣ → wcZModProEtExt T (ℓ ^ k) 1)
    (κΛ : ∀ (T : Scheme.{u}), (T ⟶ Spec (.of L)) → (Γ(T, ⊤))ˣ → wcIntExt T ℓ 1)
    (hK : wcYrcKummerPkg L ℓ κt κΛ) : wcQdKumP L ℓ κΛ :=
by
  intro T T' qT qT' f hf D hD E hE E' hE' a
  obtain ⟨DΛ, hDΛ⟩ := wc_int_pull_data_exists f ℓ
  choose Dk hDk using fun k : ℕ => wc_zmod_pull_data_exists f (ℓ ^ k)
  obtain ⟨hTr, ht⟩ := wc_int_red_transfer T ℓ
  obtain ⟨hTr', ht'⟩ := wc_int_red_transfer T' ℓ
  have hred := (wc_int_red_pull_compat ℓ f DΛ Dk hTr ht hTr' ht'
    (fun k => wc_int_zmod_pull_restrict_iso ℓ f k DΛ hDΛ (Dk k) (hDk k)) 1).1
  have hsep := (wc_int_red_milnor T' ℓ hTr' ht' 1).2.2.1 (wc_zmod_deg0_lim1_zero T' ℓ)
  have hkey : wcIntPull DΛ 1 (κΛ T qT a) =
      κΛ T' qT' (Units.map f.appTop.hom.toMonoidHom a) := by
    rw [← sub_eq_zero]
    apply hsep
    intro k hk
    rw [map_sub, hred k (κΛ T qT a), hK.2.2.2 T qT k a hk,
      hK.2.1 T T' qT qT' f hf k (Dk k) (hDk k) a,
      hK.2.2.2 T' qT' k (Units.map f.appTop.hom.toMonoidHom a) hk, sub_self]
  rw [← wc_int_rat_pull_compat ℓ f D hD DΛ hDΛ E hE E' hE' 1 (κΛ T qT a), hkey]

