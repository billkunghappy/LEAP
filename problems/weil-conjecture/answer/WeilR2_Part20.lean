        exact congrArg (zz l₀ ≫ ·) Limits.pullback.condition
      refine ⟨Limits.pullback.lift v w hwa, fun l => ?_, fun z₁ hz₁ => ?_⟩
      · apply Limits.pullback.hom_ext
        · rw [Category.assoc, ψ_fst, Limits.pullback.lift_fst]
          exact hfst l₀ l
        · rw [Category.assoc, ψ_snd, ← Category.assoc, Limits.pullback.lift_snd]
          exact hw1 l
      · apply Limits.pullback.hom_ext
        · rw [Limits.pullback.lift_fst, ← ψ_fst l₀, ← Category.assoc, hz₁ l₀]
        · rw [Limits.pullback.lift_snd]
          apply hw2
          intro l
          rw [Category.assoc, ← ψ_snd, ← Category.assoc, hz₁ l]
    have hrep := s1 G (Limits.pullback (Y.fromSpecResidueField z) a) ψ hGaff hψc hψlim
    have hint : ∀ g : Γ(Limits.pullback (Y.fromSpecResidueField z) a, ⊤),
        ((Scheme.ΓSpecIso (Y.residueField z)).inv ≫
          (Limits.pullback.fst (Y.fromSpecResidueField z) a).appTop).hom.IsIntegralElem g := by
      intro g
      obtain ⟨l, g₀, hg⟩ := hrep g
      haveI := hGaff l
      have hint0 := s3 (Y.residueField z) (G.obj l) (sG l) (hGet l) g₀
      have hmap := hint0.map ((ψ l).appTop.hom)
      have hmap' : (((Scheme.ΓSpecIso (Y.residueField z)).inv ≫
          (Limits.pullback.fst (Y.fromSpecResidueField z) (h l)).appTop) ≫
            (ψ l).appTop).hom.IsIntegralElem ((ψ l).appTop.hom g₀) := hmap
      rw [Category.assoc, ← Scheme.Hom.comp_appTop, ψ_fst l] at hmap'
      rw [← hg]
      exact hmap'
    exact L1b B a z hint p hpz
  have S4 : ∀ (S T : Type u) [CommRing S] [CommRing T] (θ : S →+* T) (Q : Spec (.of T)),
      ((Spec.map (CommRingCat.ofHom θ)).residueFieldMap Q).hom.IsIntegral →
      ∀ t : T ⧸ Q.asIdeal, ∃ q : Polynomial (S ⧸ Q.asIdeal.comap θ), q ≠ 0 ∧
        q.eval₂ (Ideal.quotientMap Q.asIdeal θ le_rfl) t = 0 := by
    intro S T _ _ θ Q hint t
    have hnat : ∀ s : S,
        ((Spec.map (CommRingCat.ofHom θ)).residueFieldMap Q).hom
          (((Scheme.ΓSpecIso (.of S)).inv ≫ (Spec (.of S)).Γevaluation
            ((Spec.map (CommRingCat.ofHom θ)) Q)).hom s) =
        ((Scheme.ΓSpecIso (.of T)).inv ≫ (Spec (.of T)).Γevaluation
            Q).hom (θ s) := by
      intro s
      have key : (Scheme.ΓSpecIso (.of S)).inv ≫ (Spec (.of S)).Γevaluation
            ((Spec.map (CommRingCat.ofHom θ)) Q) ≫
            (Spec.map (CommRingCat.ofHom θ)).residueFieldMap Q =
          CommRingCat.ofHom θ ≫ (Scheme.ΓSpecIso (.of T)).inv ≫
            (Spec (.of T)).Γevaluation Q := by
        rw [Scheme.Γevaluation_naturality, ← Category.assoc, ← Scheme.ΓSpecIso_inv_naturality,
          Category.assoc]
      have := congrArg (fun f => f.hom s) key
      simpa only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] using this
    let evS : S →+* (Spec (.of S)).residueField
        ((Spec.map (CommRingCat.ofHom θ)) Q) :=
      ((Scheme.ΓSpecIso (.of S)).inv ≫ (Spec (.of S)).Γevaluation
        ((Spec.map (CommRingCat.ofHom θ)) Q)).hom
    let evT : T →+* (Spec (.of T)).residueField Q :=
      ((Scheme.ΓSpecIso (.of T)).inv ≫ (Spec (.of T)).Γevaluation Q).hom
    let ρ := ((Spec.map (CommRingCat.ofHom θ)).residueFieldMap Q).hom
    have hkS : ∀ s : S, evS s = 0 ↔ s ∈ Q.asIdeal.comap θ := fun s =>
      hker S ((Spec.map (CommRingCat.ofHom θ)) Q) s
    have hkT : ∀ s : T, evT s = 0 ↔ s ∈ Q.asIdeal := fun s => hker T Q s
    let evSb : S ⧸ Q.asIdeal.comap θ →+* _ := Ideal.Quotient.lift (Q.asIdeal.comap θ) evS (fun s hs => (hkS s).mpr hs)
    let evTb : T ⧸ Q.asIdeal →+* _ := Ideal.Quotient.lift Q.asIdeal evT (fun s hs => (hkT s).mpr hs)
    have hTinj : Function.Injective evTb := by
      rw [injective_iff_map_eq_zero]
      intro w hw
      obtain ⟨s, rfl⟩ := Ideal.Quotient.mk_surjective w
      rw [Ideal.Quotient.eq_zero_iff_mem]
      exact (hkT s).mp hw
    have hcompat : evTb.comp (Ideal.quotientMap Q.asIdeal θ le_rfl) = ρ.comp evSb := by
      apply Ideal.Quotient.ringHom_ext
      ext s
      simp only [RingHom.comp_apply, Ideal.quotientMap_mk]
      exact (hnat s).symm
    letI : Algebra (S ⧸ Q.asIdeal.comap θ) ((Spec (.of S)).residueField
        ((Spec.map (CommRingCat.ofHom θ)) Q)) := evSb.toAlgebra
    letI : Algebra ((Spec (.of S)).residueField
        ((Spec.map (CommRingCat.ofHom θ)) Q))
        ((Spec (.of T)).residueField Q) := ρ.toAlgebra
    letI : Algebra (S ⧸ Q.asIdeal.comap θ) ((Spec (.of T)).residueField Q) :=
      (ρ.comp evSb).toAlgebra
    haveI : IsScalarTower (S ⧸ Q.asIdeal.comap θ) ((Spec (.of S)).residueField
        ((Spec.map (CommRingCat.ofHom θ)) Q))
        ((Spec (.of T)).residueField Q) :=
      IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    haveI : Algebra.IsAlgebraic (S ⧸ Q.asIdeal.comap θ) ((Spec (.of S)).residueField
        ((Spec.map (CommRingCat.ofHom θ)) Q)) := ⟨fun w => by
      obtain ⟨a', b', hb, hw⟩ := hfracG S ((Spec.map (CommRingCat.ofHom θ)) Q) w
      refine ⟨Polynomial.C (Ideal.Quotient.mk _ b') * Polynomial.X - Polynomial.C (Ideal.Quotient.mk _ a'),
        ?_, ?_⟩
      · intro h0
        have h1 := congrArg (fun q => Polynomial.coeff q 1) h0
        simp only [Polynomial.coeff_sub, Polynomial.coeff_C_mul_X, Polynomial.coeff_C,
          Polynomial.coeff_zero] at h1
        simp only [if_true, one_ne_zero, if_false, sub_zero] at h1
        apply hb
        have h2 : evSb (Ideal.Quotient.mk _ b') = 0 := by rw [h1, map_zero]
        exact h2
      · rw [Polynomial.aeval_def]
        simp only [Polynomial.eval₂_sub, Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_X]
        show evSb (Ideal.Quotient.mk _ b') * w - evSb (Ideal.Quotient.mk _ a') = 0
        show evS b' * w - evS a' = 0
        rw [mul_comm]
        exact sub_eq_zero.mpr hw⟩
    obtain ⟨τ, rfl⟩ := Ideal.Quotient.mk_surjective t
    have hτ : IsIntegral ((Spec (.of S)).residueField
        ((Spec.map (CommRingCat.ofHom θ)) Q)) (evT τ) := hint (evT τ)
    obtain ⟨q, hq0, hq⟩ := hτ.isAlgebraic.restrictScalars (S ⧸ Q.asIdeal.comap θ)
    refine ⟨q, hq0, ?_⟩
    apply hTinj
    rw [Polynomial.hom_eval₂, hcompat, map_zero]
    rw [Polynomial.aeval_def] at hq
    exact hq
  intro k _ n y A _ _ _ Λ _ _ W' φ a hsh c hc x B _ _ _ Λx _ _ Wx φx ax hshx β hβc P hP
  subst hβc
  have L1x := L1 x B Λx Wx φx _ hshx
  have L1y := L1 y A Λ W' φ a hsh

  haveI : P.IsPrime := hP
  haveI hp3 : (P.comap (algebraMap B (Localization.Away (β Polynomial.X)))).IsPrime :=
    Ideal.IsPrime.comap _
  haveI hp2 : ((P.comap (algebraMap B (Localization.Away (β Polynomial.X)))).comap β).IsPrime :=
    Ideal.IsPrime.comap _
  haveI hp1 : (((P.comap (algebraMap B (Localization.Away (β Polynomial.X)))).comap β).comap
      (Polynomial.C : A →+* Polynomial A)).IsPrime := Ideal.IsPrime.comap _
  haveI hp0 : ((((P.comap (algebraMap B (Localization.Away (β Polynomial.X)))).comap β).comap
      (Polynomial.C : A →+* Polynomial A)).comap (Spec.preimage a).hom).IsPrime :=
    Ideal.IsPrime.comap _
  set θR := algebraMap B (Localization.Away (β Polynomial.X)) with hθR
  set ψ := (Spec.preimage a).hom with hψ
  set alg := algebraMap k (MvPolynomial (Fin n) k) with halg
  set p3 := P.comap θR with hp3def
  set p2 := p3.comap β with hp2def
  set p1 := p2.comap (Polynomial.C : A →+* Polynomial A) with hp1def
  set p0 := p1.comap ψ with hp0def
  let Q1 : Spec (.of A) := show Spec (.of A) from ⟨p1, hp1⟩
  let Q3 : Spec (.of B) := show Spec (.of B) from ⟨p3, hp3⟩
  have ha : Spec.map (CommRingCat.ofHom ψ) = a := by
    rw [hψ, CommRingCat.ofHom_hom, Spec.map_preimage]

  have b0 := S7' k n p0 hp0

  have b1 := STEP0 k (MvPolynomial (Fin n) k ⧸ p0) (A ⧸ p1) ((Ideal.Quotient.mk p0).comp alg)
    ((Ideal.Quotient.mk p1).comp (ψ.comp alg)) (Ideal.quotientMap p1 ψ le_rfl)
    (RingHom.ext fun r => by simp only [RingHom.comp_apply, Ideal.quotientMap_mk])
    Ideal.quotientMap_injective
    (S4 (MvPolynomial (Fin n) k) A ψ Q1 (by rw [ha]; exact L1y Q1))

  have hj1 : (Ideal.quotientMap p2 (Polynomial.C : A →+* Polynomial A) le_rfl).comp
      (Ideal.Quotient.mk p1) = (Ideal.Quotient.mk p2).comp Polynomial.C :=
    RingHom.ext fun r => by rw [RingHom.comp_apply, RingHom.comp_apply, Ideal.quotientMap_mk]
  have b2 := STEP1 k (A ⧸ p1) (Polynomial A ⧸ p2) ((Ideal.Quotient.mk p1).comp (ψ.comp alg))
    ((Ideal.Quotient.mk p2).comp (Polynomial.C.comp (ψ.comp alg)))
    (Ideal.quotientMap p2 (Polynomial.C : A →+* Polynomial A) le_rfl)
    (Ideal.Quotient.mk p2 Polynomial.X)
    (RingHom.ext fun r => by simp only [RingHom.comp_apply, Ideal.quotientMap_mk])
    Ideal.quotientMap_injective
    (by
      intro e
      obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective e
      refine ⟨p.map (Ideal.Quotient.mk p1), ?_⟩
      rw [Polynomial.eval₂_map, hj1, ← Polynomial.hom_eval₂, Polynomial.eval₂_C_X])

  have hI3 := L1x Q3
  rw [Scheme.residueFieldMap_comp] at hI3
  have b3 := STEP0 k (Polynomial A ⧸ p2) (B ⧸ p3)
    ((Ideal.Quotient.mk p2).comp (Polynomial.C.comp (ψ.comp alg)))
    ((Ideal.Quotient.mk p3).comp (β.comp (Polynomial.C.comp (ψ.comp alg))))
    (Ideal.quotientMap p3 β le_rfl)
    (RingHom.ext fun r => by simp only [RingHom.comp_apply, Ideal.quotientMap_mk])
    Ideal.quotientMap_injective
    (S4 (Polynomial A) B β Q3 (RingHom.IsIntegral.tower_top (Scheme.Hom.residueFieldMap c ((Spec.map (CommRingCat.ofHom β)) Q3)).hom _ hI3))

  have b4 := STEP0 k (B ⧸ p3) (Localization.Away (β Polynomial.X) ⧸ P)
    ((Ideal.Quotient.mk p3).comp (β.comp (Polynomial.C.comp (ψ.comp alg))))
    ((Ideal.Quotient.mk P).comp (θR.comp (β.comp (Polynomial.C.comp (ψ.comp alg)))))
    (Ideal.quotientMap P θR le_rfl)
    (RingHom.ext fun r => by simp only [RingHom.comp_apply, Ideal.quotientMap_mk])
    Ideal.quotientMap_injective
    (S8 B (β Polynomial.X) P hP)
  show @Algebra.trdeg k (Localization.Away (β Polynomial.X) ⧸ P) _ _
    ((Ideal.Quotient.mk P).comp (θR.comp (β.comp (Polynomial.C.comp (ψ.comp alg))))).toAlgebra ≤
    ((n + 1 : ℕ) : Cardinal)
  refine le_trans b4 (le_trans b3 (le_trans b2 ?_))
  rw [Nat.cast_succ]
  exact add_le_add (le_trans b1 b0) le_rfl

theorem wc_shens_point_sepclosed_indep_subfield : ∀ (k : Type u) [Field k] (n : ℕ) (y : Spec (.of (MvPolynomial (Fin n) k))) (D : ℕ), (D : WithBot ℕ∞) ≤ topologicalKrullDim ↥(closure ({y} : Set (Spec (.of (MvPolynomial (Fin n) k))))) → ∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (MvPolynomial (Fin n) k))) y)) (Scheme.Etale.forget (Spec (.of (MvPolynomial (Fin n) k))))) (φ : ∀ l, Spec (.of A) ⟶ (W'.obj l).right.left) (a : Spec (.of A) ⟶ Spec (.of (MvPolynomial (Fin n) k))), wcHalShData y A Λ W' φ a → ∃ (F : Type u) (_ : Field F) (_ : IsSepClosed F) (ιF : F →+* A) (κ : k →+* F) (τ : Fin D → F), (letI : Algebra k F := κ.toAlgebra; AlgebraicIndependent k τ) ∧ ιF.comp κ = (Spec.preimage a).hom.comp (algebraMap k (MvPolynomial (Fin n) k)) :=
by
  intro k _ n y D hD A _ hHen hRes Λ _ _ W' φ a hsh
  classical

  have s3b : ∀ (F A : Type u) [Field F] [CommRing A] [HenselianLocalRing A]
      [IsSepClosed (IsLocalRing.ResidueField A)] (φ : F →+* A),
      (∀ x : A, (∃ L : Subring A, φ.range ≤ L ∧ x ∈ L ∧ ∀ z ∈ L, z ≠ 0 → ∃ w ∈ L, z * w = 1) →
        x ∈ φ.range) → IsSepClosed F := by
    intro F A _ _ _ _ φ hmax
    apply IsSepClosed.of_exists_root
    intro p hmon hirr hsep
    have hdeg : p.natDegree ≠ 0 := by
      intro h
      have hp1 : p = 1 := by
        have h0 := Polynomial.eq_C_of_natDegree_eq_zero h
        rw [h0, ← h, hmon.coeff_natDegree, map_one]
      exact hirr.not_isUnit (hp1 ▸ isUnit_one)
    set r := IsLocalRing.residue A with hr
    set pb := p.map (r.comp φ) with hpb
    have hpbm : pb.Monic := hmon.map _
    have hpbdeg : pb.degree ≠ 0 := by
      rw [Polynomial.degree_eq_natDegree hpbm.ne_zero, hmon.natDegree_map]
      exact_mod_cast hdeg
    have hpbsep : pb.Separable := hsep.map
    obtain ⟨ab, hab⟩ := IsSepClosed.exists_root pb hpbdeg hpbsep
    obtain ⟨a0, ha0⟩ := IsLocalRing.residue_surjective ab
    set f := p.map φ with hf
    have hfm : f.Monic := hmon.map _
    have hmapf : f.map r = pb := by rw [hf, Polynomial.map_map]
    have h1 : f.eval a0 ∈ IsLocalRing.maximalIdeal A := by
      rw [← IsLocalRing.residue_eq_zero_iff, ← hr, ← Polynomial.eval₂_hom, ← Polynomial.eval_map,
        hmapf, ha0]
      exact hab
    have h2 : IsUnit (f.derivative.eval a0) := by
      apply IsLocalRing.notMem_maximalIdeal.mp
      rw [← IsLocalRing.residue_eq_zero_iff, ← hr, ← Polynomial.eval₂_hom, ← Polynomial.eval_map,
        ← Polynomial.derivative_map, hmapf, ha0]
      exact Polynomial.Separable.eval₂_derivative_ne_zero (RingHom.id _) hpbsep hab
    obtain ⟨α, hα, -⟩ := HenselianLocalRing.is_henselian f hfm a0 h1 h2
    have hα' : Polynomial.eval₂ φ α p = 0 := by
      rw [← Polynomial.eval_map]; exact hα
    have hαmem : α ∈ φ.range := by
      apply hmax
      refine ⟨(Polynomial.eval₂RingHom φ α).range, ?_, ⟨Polynomial.X, by simp⟩, ?_⟩
      · rintro _ ⟨c, rfl⟩
        exact ⟨Polynomial.C c, by simp⟩
      · rintro _ ⟨q, rfl⟩ hz
        rcases Irreducible.isCoprime_or_dvd hirr q with hc | hd
        · obtain ⟨u', v', huv⟩ := hc
          refine ⟨Polynomial.eval₂RingHom φ α v', ⟨v', rfl⟩, ?_⟩
          have := congrArg (Polynomial.eval₂RingHom φ α) huv
          simp only [map_add, map_mul, map_one, Polynomial.coe_eval₂RingHom] at this
          rw [hα', mul_zero, zero_add] at this
          simp only [Polynomial.coe_eval₂RingHom]
          rw [mul_comm]; exact this
        · obtain ⟨r', rfl⟩ := hd
          exfalso; apply hz
          simp [Polynomial.eval₂_mul, hα']
    obtain ⟨c, hc⟩ := hαmem
    refine ⟨c, ?_⟩
    rw [← hc, Polynomial.eval₂_at_apply] at hα'
    exact φ.injective (by rw [hα', map_zero])

  have s3a : ∀ (E A : Type u) [Field E] [CommRing A] [IsLocalRing A] (ι : E →+* A),
      ∃ (F : Type u) (_ : Field F) (φ : F →+* A) (ε : E →+* F), φ.comp ε = ι ∧
        ∀ x : A, (∃ L : Subring A, φ.range ≤ L ∧ x ∈ L ∧ ∀ z ∈ L, z ≠ 0 → ∃ w ∈ L, z * w = 1) →
          x ∈ φ.range := by
    intro E A _ _ _ ι
    let S : Set (Subring A) := {L | ι.range ≤ L ∧ ∀ z ∈ L, z ≠ 0 → ∃ w ∈ L, z * w = 1}
    have hι : ι.range ∈ S := by
      refine ⟨le_rfl, ?_⟩
      rintro _ ⟨e, rfl⟩ hz
      have he : e ≠ 0 := fun h => hz (by rw [h, map_zero])
      exact ⟨ι e⁻¹, ⟨e⁻¹, rfl⟩, by rw [← map_mul, mul_inv_cancel₀ he, map_one]⟩
    obtain ⟨M, hleM, hM⟩ := zorn_le_nonempty₀ S (fun c hcS hc L hL => by
      have hdir : DirectedOn (· ≤ ·) c := hc.directedOn
      have hne : c.Nonempty := ⟨L, hL⟩
      refine ⟨sSup c, ⟨(hcS hL).1.trans (le_sSup hL), ?_⟩, fun z hz => le_sSup hz⟩
      intro z hz hz0
      obtain ⟨L', hL', hzL'⟩ := (Subring.mem_sSup_of_directedOn hne hdir).mp hz
      obtain ⟨w, hw, hzw⟩ := (hcS hL').2 z hzL' hz0
      exact ⟨w, le_sSup hL' hw, hzw⟩) ι.range hι
    have hF : IsField M :=
      { exists_pair_ne := ⟨0, 1, fun h => zero_ne_one (congrArg Subtype.val h)⟩
        mul_comm := mul_comm
        mul_inv_cancel := fun {a} ha => by
          obtain ⟨w, hw, hzw⟩ := hM.prop.2 a a.2 (fun h => ha (Subtype.ext h))
          exact ⟨⟨w, hw⟩, Subtype.ext hzw⟩ }
    let instM : Field M := hF.toField
    refine ⟨M, instM, M.subtype, ι.codRestrict M (fun e => hleM ⟨e, rfl⟩),
      RingHom.ext fun _ => rfl, ?_⟩
    rintro x ⟨L, hL, hxL, hLf⟩
    have hML : M ≤ L := fun m hm => hL ⟨⟨m, hm⟩, rfl⟩
    have hLS : L ∈ S := ⟨hleM.trans hML, hLf⟩
    have hxM : x ∈ M := hM.le_of_ge hLS hML hxL
    exact ⟨⟨x, hxM⟩, rfl⟩

  have hc : Ideal.comap (Spec.preimage a).hom (IsLocalRing.maximalIdeal A) =
      PrimeSpectrum.asIdeal (R := MvPolynomial (Fin n) k) y := by
    obtain ⟨-, -, -, -, -, e, -, he⟩ := hsh
    have hgeom : ∀ z, wcEtGeomPt (Spec (.of (MvPolynomial (Fin n) k))) y z = y := by
      intro z
      rw [wcEtGeomPt, Scheme.Hom.comp_apply]
      exact Scheme.fromSpecResidueField_apply y _
    have hres : ∀ z, (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A))) z =
        IsLocalRing.closedPoint A :=
      fun z => IsLocalRing.PrimeSpectrum.comap_residue A z
    have ha : a (IsLocalRing.closedPoint A) = y := by
      have h1 := congrArg (fun f => f (IsLocalRing.closedPoint
        (AlgebraicClosure ((Spec (.of (MvPolynomial (Fin n) k))).residueField y)))) he
      have h1' := (Scheme.Hom.comp_apply _ _ _).symm.trans
        ((Scheme.Hom.comp_apply _ _ _).symm.trans (h1.trans (hgeom _)))
      rw [hres] at h1'
      exact h1'
    have ha' : (Spec.map (Spec.preimage a)) (IsLocalRing.closedPoint A) = y := by
      rw [Spec.map_preimage]; exact ha
    rw [← ha']
    first
    | rfl
    | (simp only [Spec.map_base]; rfl)
    | (erw [Spec.map_base]; rfl)

  set p := PrimeSpectrum.asIdeal (R := MvPolynomial (Fin n) k) y with hp
  have hdimR : (D : WithBot ℕ∞) ≤ ringKrullDim (MvPolynomial (Fin n) k ⧸ p) := by
    rw [← PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim]
    have hemb := PrimeSpectrum.isEmbedding_comap_of_surjective _
      (Ideal.Quotient.mk p) Ideal.Quotient.mk_surjective
    have hrng : Set.range (PrimeSpectrum.comap (Ideal.Quotient.mk p)) =
        closure ({y} : Set (Spec (.of (MvPolynomial (Fin n) k)))) := by
      rw [range_comap_of_surjective _ _ Ideal.Quotient.mk_surjective, Ideal.mk_ker]
      exact (PrimeSpectrum.closure_singleton y).symm
    have hmem : ∀ x, PrimeSpectrum.comap (Ideal.Quotient.mk p) x ∈
        closure ({y} : Set (Spec (.of (MvPolynomial (Fin n) k)))) := by
      intro x
      rw [← hrng]
      exact Set.mem_range_self x
    have hsurj : Function.Surjective (Set.codRestrict _ _ hmem) := by
      rintro ⟨z, hz⟩
      rw [← hrng] at hz
      obtain ⟨x, rfl⟩ := hz
      exact ⟨x, rfl⟩
    rw [IsHomeomorph.topologicalKrullDim_eq _
      ((hemb.codRestrict _ hmem).toHomeomorphOfSurjective hsurj).isHomeomorph]
    exact hD
  haveI hpP : p.IsPrime := PrimeSpectrum.isPrime (R := MvPolynomial (Fin n) k) y
  haveI : Nontrivial (MvPolynomial (Fin n) k ⧸ p) :=
    Ideal.Quotient.nontrivial_iff.mpr hpP.ne_top
  haveI hftP : Algebra.FiniteType k (MvPolynomial (Fin n) k) := by
    first
    | exact ⟨⟨Finset.univ.image (MvPolynomial.X : Fin n → MvPolynomial (Fin n) k), by
        rw [Finset.coe_image, Finset.coe_univ, Set.image_univ, MvPolynomial.adjoin_range_X]⟩⟩
    | exact ⟨⟨Finset.univ.image (MvPolynomial.X : Fin n → MvPolynomial (Fin n) k), by
        simp [MvPolynomial.adjoin_range_X]⟩⟩
    | exact MvPolynomial.finiteType k (Fin n)
    | exact Algebra.FiniteType.mvPolynomial k (Fin n)
  haveI : Algebra.FiniteType k (MvPolynomial (Fin n) k ⧸ p) :=
    @Algebra.FiniteType.of_surjective k (MvPolynomial (Fin n) k) (MvPolynomial (Fin n) k ⧸ p)
      _ _ _ _ _ hftP (Ideal.Quotient.mkₐ k p) (Ideal.Quotient.mkₐ_surjective k p)
  obtain ⟨s, G, hGinj, hGfin⟩ := exists_finite_inj_algHom_of_fg k (MvPolynomial (Fin n) k ⧸ p)
  have hdle : ringKrullDim (MvPolynomial (Fin n) k ⧸ p) ≤
      ringKrullDim (MvPolynomial (Fin s) k) := by
    letI : Algebra (MvPolynomial (Fin s) k) (MvPolynomial (Fin n) k ⧸ p) := G.toRingHom.toAlgebra
    haveI : Algebra.IsIntegral (MvPolynomial (Fin s) k) (MvPolynomial (Fin n) k ⧸ p) :=
      ⟨RingHom.IsIntegral.of_finite hGfin⟩
    let c : PrimeSpectrum (MvPolynomial (Fin n) k ⧸ p) → PrimeSpectrum (MvPolynomial (Fin s) k) :=
      fun Q => ⟨Ideal.under _ Q.asIdeal, inferInstance⟩
    have hcm : StrictMono c := by
      intro Q₁ Q₂ h
      rw [← PrimeSpectrum.asIdeal_lt_asIdeal]
      exact Ideal.IsIntegral.under_lt_under ((PrimeSpectrum.asIdeal_lt_asIdeal _ _).mpr h)
    exact Order.krullDim_le_of_strictMono c hcm
  have hpoly : ringKrullDim (MvPolynomial (Fin s) k) = ((s : ℕ∞) : WithBot ℕ∞) := by
    rw [MvPolynomial.ringKrullDim_of_isNoetherianRing, ringKrullDim_eq_zero_of_field,
      ENat.card_eq_coe_fintype_card, Fintype.card_fin, zero_add]
  have hDs' := hdimR.trans (hdle.trans hpoly.le)
  have hDs : D ≤ s := by exact_mod_cast hDs'
  choose h hh using fun i : Fin D =>
    Ideal.Quotient.mk_surjective (I := p) (G (MvPolynomial.X (Fin.castLE hDs i)))
  have hkey : (Ideal.Quotient.mkₐ k p).comp (MvPolynomial.aeval h) =
      G.comp (MvPolynomial.rename (Fin.castLE hDs)) := by
    apply MvPolynomial.algHom_ext
    intro i
    simp only [AlgHom.comp_apply, MvPolynomial.aeval_X, MvPolynomial.rename_X,
      Ideal.Quotient.mkₐ_eq_mk]
    exact hh i
  have hindep : ∀ f : MvPolynomial (Fin D) k, f ≠ 0 → MvPolynomial.aeval h f ∉ p := by
    intro f hf hmemp
    have h1 : Ideal.Quotient.mkₐ k p (MvPolynomial.aeval h f) = 0 := by
      rw [Ideal.Quotient.mkₐ_eq_mk]; exact Ideal.Quotient.eq_zero_iff_mem.mpr hmemp
    have h2 : G (MvPolynomial.rename (Fin.castLE hDs) f) = 0 := by
      rw [← AlgHom.comp_apply, ← hkey, AlgHom.comp_apply]; exact h1
    have h3 : MvPolynomial.rename (Fin.castLE hDs) f = 0 := hGinj (h2.trans (map_zero G).symm)
    exact hf (MvPolynomial.rename_injective _ (Fin.castLE_injective hDs)
      (h3.trans (map_zero _).symm))

  obtain ⟨g, hg⟩ : ∃ g : MvPolynomial (Fin D) k →+* A,
      ∀ f, g f = (Spec.preimage a).hom (MvPolynomial.aeval h f) :=
    ⟨(Spec.preimage a).hom.comp (MvPolynomial.aeval h).toRingHom, fun _ => rfl⟩
  have hunit : ∀ f : nonZeroDivisors (MvPolynomial (Fin D) k), IsUnit (g f) := by
    rintro ⟨f, hf⟩
    have hf0 : f ≠ 0 := nonZeroDivisors.ne_zero hf
    have h1 := hindep f hf0
    rw [← hc, Ideal.mem_comap] at h1
    show IsUnit (g f)
    rw [hg]
    exact IsLocalRing.notMem_maximalIdeal.mp h1
  obtain ⟨ε, hε⟩ : ∃ ε : FractionRing (MvPolynomial (Fin D) k) →+* A,
      ∀ f, ε (algebraMap (MvPolynomial (Fin D) k) (FractionRing (MvPolynomial (Fin D) k)) f) =
        g f :=
    ⟨IsLocalization.lift (M := nonZeroDivisors (MvPolynomial (Fin D) k))
        (S := FractionRing (MvPolynomial (Fin D) k)) hunit,
      IsLocalization.lift_eq (M := nonZeroDivisors (MvPolynomial (Fin D) k))
        (S := FractionRing (MvPolynomial (Fin D) k)) hunit⟩
  obtain ⟨F, hFfield, φF, ε', hcomp, hmax⟩ := s3a (FractionRing (MvPolynomial (Fin D) k)) A ε
  have hsep : IsSepClosed F := @s3b F A hFfield _ hHen hRes φF hmax
  obtain ⟨θ, hθ⟩ : ∃ θ : MvPolynomial (Fin D) k →+* F,
      ∀ f, θ f = ε' (algebraMap (MvPolynomial (Fin D) k)
        (FractionRing (MvPolynomial (Fin D) k)) f) :=
    ⟨ε'.comp (algebraMap (MvPolynomial (Fin D) k) (FractionRing (MvPolynomial (Fin D) k))),
      fun _ => rfl⟩
  have hθinj : Function.Injective θ := by
    intro x y hxy
    rw [hθ, hθ] at hxy
    exact IsFractionRing.injective (MvPolynomial (Fin D) k)
      (FractionRing (MvPolynomial (Fin D) k)) (ε'.injective hxy)
  have hind : @AlgebraicIndependent (Fin D) k F (fun i => θ (MvPolynomial.X i)) _ _
      (θ.comp MvPolynomial.C).toAlgebra := by
    letI : Algebra k F := (θ.comp MvPolynomial.C).toAlgebra
    let j : MvPolynomial (Fin D) k →ₐ[k] F :=
      { toRingHom := θ
        commutes' := fun r => by
          first
          | (rw [MvPolynomial.algebraMap_eq, RingHom.algebraMap_toAlgebra]; rfl)
          | rfl
          | simp [RingHom.algebraMap_toAlgebra, MvPolynomial.algebraMap_eq] }
    have hj : Function.Injective j := fun x y hxy => hθinj hxy
    have e : (fun i => θ (MvPolynomial.X i)) = ⇑j ∘ MvPolynomial.X := by funext i; rfl
    rw [e]
    exact (MvPolynomial.algebraicIndependent_X (Fin D) k).map' hj
  refine ⟨F, hFfield, hsep, φF, θ.comp MvPolynomial.C, fun i => θ (MvPolynomial.X i), hind, ?_⟩
  · apply RingHom.ext
    intro r
    have h1 := RingHom.congr_fun hcomp
      (algebraMap (MvPolynomial (Fin D) k) (FractionRing (MvPolynomial (Fin D) k))
        (MvPolynomial.C r))
    rw [RingHom.comp_apply] at h1
    rw [RingHom.comp_apply, RingHom.comp_apply, hθ, h1, hε, hg, MvPolynomial.aeval_C,
      RingHom.comp_apply]

theorem wc_ratfunc_alg_indep_snoc : ∀ (k F : Type u) [Field k] [Field F] [Algebra k F] (D : ℕ) (τ : Fin D → F), AlgebraicIndependent k τ → letI : Algebra k (FractionRing (Polynomial F)) := ((algebraMap (Polynomial F) (FractionRing (Polynomial F))).comp (Polynomial.C.comp (algebraMap k F))).toAlgebra; AlgebraicIndependent k (Fin.snoc (α := fun _ => FractionRing (Polynomial F)) (fun i => algebraMap (Polynomial F) (FractionRing (Polynomial F)) (Polynomial.C (τ i))) (algebraMap (Polynomial F) (FractionRing (Polynomial F)) Polynomial.X)) :=
by
  intro k F _ _ _ D τ hτ
  letI inst : Algebra k (FractionRing (Polynomial F)) := ((algebraMap (Polynomial F) (FractionRing (Polynomial F))).comp (Polynomial.C.comp (algebraMap k F))).toAlgebra
  have hτ' : Function.Injective (MvPolynomial.aeval τ : MvPolynomial (Fin D) k →ₐ[k] F) :=
    algebraicIndependent_iff_injective_aeval.mp hτ
  let Ψ' : MvPolynomial (Option (Fin D)) k →+* Polynomial F :=
    (Polynomial.mapRingHom (MvPolynomial.aeval τ).toRingHom).comp
      (MvPolynomial.optionEquivLeft k (Fin D)).toRingEquiv.toRingHom
  have hΨ' : Function.Injective Ψ' :=
    (Polynomial.map_injective _ hτ').comp (MvPolynomial.optionEquivLeft k (Fin D)).injective
  have hren : Function.Injective (MvPolynomial.rename (R := k) (finSuccEquivLast (n := D))) :=
    MvPolynomial.rename_injective _ (Equiv.injective _)
  have hι : Function.Injective (algebraMap (Polynomial F) (FractionRing (Polynomial F))) :=
    IsFractionRing.injective _ _
  rw [algebraicIndependent_iff_injective_aeval]
  have key : (MvPolynomial.aeval (Fin.snoc (α := fun _ => FractionRing (Polynomial F))
      (fun i => algebraMap (Polynomial F) (FractionRing (Polynomial F)) (Polynomial.C (τ i)))
      (algebraMap (Polynomial F) (FractionRing (Polynomial F)) Polynomial.X)) :
        MvPolynomial (Fin (D + 1)) k →ₐ[k] FractionRing (Polynomial F)).toRingHom =
      ((algebraMap (Polynomial F) (FractionRing (Polynomial F))).comp Ψ').comp
        (MvPolynomial.rename (R := k) (finSuccEquivLast (n := D))).toRingHom := by
    apply MvPolynomial.ringHom_ext
    · intro r
      simp [Ψ', MvPolynomial.aeval_C, MvPolynomial.optionEquivLeft_C]
      rfl
    · intro i
      refine Fin.lastCases ?_ (fun j => ?_) i
      · simp [Ψ', MvPolynomial.optionEquivLeft_X_none]
      · simp [Ψ', MvPolynomial.optionEquivLeft_X_some]
  have hcoe := congrArg DFunLike.coe key
  have hinj := hι.comp (hΨ'.comp hren)
  intro p q hpq
  apply hinj
  have hp := congrFun hcoe p
  have hq := congrFun hcoe q
  simp only [AlgHom.toRingHom_eq_coe, RingHom.coe_coe, RingHom.coe_comp, Function.comp_apply] at hp hq
  simp only [Function.comp_apply, AlgHom.coe_toRingHom] at hp hq ⊢
  rw [← hp, ← hq]
  exact hpq

theorem wc_ft_subalg_noether_degree_le : ∀ (k K R : Type u) [Field k] [Field K] [CommRing R] [Algebra k K] [Algebra K R] [Algebra k R] [IsScalarTower k K R] (d M : ℕ) (τ : Fin d → K), AlgebraicIndependent k τ → (∀ P : Ideal R, P.IsPrime → letI : Algebra k (R ⧸ P) := ((Ideal.Quotient.mk P).comp (algebraMap k R)).toAlgebra; Algebra.trdeg k (R ⧸ P) ≤ (M : Cardinal)) → ∀ F : Finset R, Nontrivial ↥(Algebra.adjoin K (F : Set R)) → ∃ (e : ℕ) (g : MvPolynomial (Fin e) K →ₐ[K] ↥(Algebra.adjoin K (F : Set R))), d + e ≤ M ∧ Function.Injective g ∧ g.Finite :=
by
  intro k K R _ _ _ _ _ _ _ d M τ hτ htr F hS
  have : Algebra.FiniteType K ↥(Algebra.adjoin K (F : Set R)) :=
    Algebra.FiniteType.adjoin_of_finite F.finite_toSet
  obtain ⟨e, g, hginj, hgfin⟩ := exists_finite_inj_algHom_of_fg K ↥(Algebra.adjoin K (F : Set R))
  refine ⟨e, g, ?_, hginj, hgfin⟩
  let ψ : MvPolynomial (Fin e) K →+* R := ((Algebra.adjoin K (F : Set R)).val.comp g).toRingHom
  have hψ : Function.Injective ψ := Subtype.val_injective.comp hginj
  have hbot : (⊥ : Ideal (MvPolynomial (Fin e) K)) ∈ minimalPrimes (MvPolynomial (Fin e) K) := by
    rw [IsDomain.minimalPrimes_eq_singleton_bot]; rfl
  obtain ⟨P, hP, hcomap⟩ := Ideal.exists_comap_eq_of_mem_minimalPrimes_of_injective hψ ⊥ hbot
  have := hP
  have hM := htr P hP
  let ik : Algebra k (R ⧸ P) := ((Ideal.Quotient.mk P).comp (algebraMap k R)).toAlgebra
  have hT : @IsScalarTower k K (R ⧸ P) _ Algebra.toSMul ik.toSMul :=
    @IsScalarTower.of_algebraMap_eq k K (R ⧸ P) _ _ _ _ _ ik (fun x => by
      show Ideal.Quotient.mk P (algebraMap k R x) =
        Ideal.Quotient.mk P (algebraMap K R (algebraMap k K x))
      rw [IsScalarTower.algebraMap_apply k K R x])
  let f : MvPolynomial (Fin e) K →ₐ[K] R ⧸ P :=
    (Ideal.Quotient.mkₐ K P).comp ((Algebra.adjoin K (F : Set R)).val.comp g)
  have hf : Function.Injective f := by
    rw [injective_iff_map_eq_zero]
    intro a ha
    have h1 : ψ a ∈ P := by
      rw [← Ideal.Quotient.eq_zero_iff_mem]; exact ha
    have h2 : a ∈ Ideal.comap ψ P := h1
    rw [hcomap] at h2
    exact (Submodule.mem_bot _).mp h2
  have : FaithfulSMul k K :=
    (faithfulSMul_iff_algebraMap_injective k K).mpr (algebraMap k K).injective
  have : FaithfulSMul K (R ⧸ P) :=
    (faithfulSMul_iff_algebraMap_injective K (R ⧸ P)).mpr (algebraMap K (R ⧸ P)).injective
  have hb := @trdeg_add_le k K _ _ _ _ (R ⧸ P) _ ik _ _ _ hT
  have hc : ((d : ℕ) : Cardinal.{u}) ≤ Algebra.trdeg k K := by
    have := hτ.lift_cardinalMk_le_trdeg
    simpa using this
  have hd : ((e : ℕ) : Cardinal.{u}) ≤ Algebra.trdeg K (R ⧸ P) := by
    have := trdeg_le_of_injective f hf
    rw [MvPolynomial.trdeg_of_isDomain] at this
    simpa using this
  have : ((d + e : ℕ) : Cardinal.{u}) ≤ (M : Cardinal) := by
    rw [Nat.cast_add]
    exact (add_le_add hc hd).trans (hb.trans hM)
  exact_mod_cast this

theorem wc_subring_pushforward_system : ∀ (R : Type u) [CommRing R] (ℓ : ℕ)
    (G : Sheaf (Scheme.smallEtaleTopology (Spec (.of R))) AddCommGrpCat.{u+1}), ℓ • 𝟙 G = 0 →
    ∃ (A : ∀ F : Finset R, Sheaf (Scheme.smallEtaleTopology (wcSubX R F)) AddCommGrpCat.{u+1})
      (a : ∀ (F F' : Finset R) (h : F ⊆ F'), wcEtTransport (wcSubT R h) (A F) (A F'))
      (θ : ∀ F : Finset R, wcEtTransport (wcSubP R F) (A F) G),
      wcSubCoherent R A a ∧ wcSubCocone R A a G θ ∧
      (∀ (F : Finset R) (V : (wcSubX R F).Etale) (U : (Spec (.of R)).Etale) (k : U.left ⟶ V.left)
        (hk : k ≫ V.hom = U.hom ≫ wcSubP R F),
        IsPullback k U.hom V.hom (wcSubP R F) → Function.Bijective ((θ F).ρ V U k hk)) ∧
      ∀ F : Finset R, ℓ • 𝟙 (A F) = 0 :=
by
  intro R _ ℓ G hG
  classical
  have hcont : ∀ {X B : Scheme.{u}} (g : X ⟶ B), (wcEtBaseChange g).IsContinuous
      (Scheme.smallEtaleTopology B) (Scheme.smallEtaleTopology X) := by
    have hjs : ∀ (Y : Scheme.{u}) (V : Y.Etale) (S : Sieve V), (∀ v : V.left, ∃ (V₁ : Y.Etale)
        (c : V₁ ⟶ V), S.arrows c ∧ v ∈ Set.range c.left) → S ∈ Scheme.smallEtaleTopology Y V := by
      intro Y V S hS
      change S ∈ Scheme.smallGrothendieckTopology @Etale Y V
      rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
      apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
      intro x
      obtain ⟨V₁, c, hc, y, hy⟩ := hS x
      have hw : c.left ≫ V.hom = V₁.hom := MorphismProperty.Over.w c
      have hEt : Etale c.left := by
        have h1 : Etale V.hom := V.prop
        have h2 : Etale (c.left ≫ V.hom) := by rw [hw]; exact V₁.prop
        exact Etale.of_comp c.left V.hom
      exact ⟨V₁, c, y, hc, hEt, hy⟩
    have hcov : ∀ {X B : Scheme.{u}} (g : X ⟶ B), CoverPreserving (Scheme.smallEtaleTopology B)
        (Scheme.smallEtaleTopology X) (wcEtBaseChange g) := by
      intro X B g
      constructor
      intro V S hS
      change S ∈ Scheme.smallGrothendieckTopology @Etale B V at hS
      rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale B
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hS
      have hS' := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale B
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mp hS
      apply hjs
      intro v
      obtain ⟨W, a, w, ha, -, hw⟩ := hS' (Limits.pullback.fst V.hom g v)
      refine ⟨(wcEtBaseChange g).obj W, (wcEtBaseChange g).map a,
        Sieve.image_mem_functorPushforward (wcEtBaseChange g) S ha, ?_⟩
      have h0 : (Limits.pullback.fst W.hom g ≫ a.left) ≫ V.hom = Limits.pullback.snd W.hom g ≫ g := by
        rw [Category.assoc, MorphismProperty.Over.w a]
        exact Limits.pullback.condition
      let m : Limits.pullback W.hom g ⟶ Limits.pullback V.hom g :=
        Limits.pullback.lift (Limits.pullback.fst W.hom g ≫ a.left) (Limits.pullback.snd W.hom g) h0
      have hmap : ((wcEtBaseChange g).map a).left = m := rfl
      have h1 : Limits.pullback.fst a.left (Limits.pullback.fst V.hom g) ≫ W.hom =
          (Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) ≫ Limits.pullback.snd V.hom g) ≫ g := by
        rw [← MorphismProperty.Over.w a, ← Category.assoc, Limits.pullback.condition, Category.assoc,
          Limits.pullback.condition, Category.assoc]
      let ψ : Limits.pullback a.left (Limits.pullback.fst V.hom g) ⟶ Limits.pullback W.hom g :=
        Limits.pullback.lift (Limits.pullback.fst a.left (Limits.pullback.fst V.hom g))
          (Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) ≫ Limits.pullback.snd V.hom g) h1
      have hψ : ψ ≫ m = Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) := by
        apply Limits.pullback.hom_ext
        · rw [Category.assoc, Limits.pullback.lift_fst, ← Category.assoc, Limits.pullback.lift_fst,
            Limits.pullback.condition]
        · rw [Category.assoc, Limits.pullback.lift_snd, Limits.pullback.lift_snd]
      obtain ⟨z, hz⟩ : ∃ z, Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) z = v := by
        have hv : (v : ↥(Limits.pullback V.hom g)) ∈
            Set.range (Limits.pullback.snd a.left (Limits.pullback.fst V.hom g)) := by
          rw [Scheme.Pullback.range_snd]
          exact ⟨w, hw⟩
        exact hv
      rw [hmap]
      exact ⟨ψ z, (Scheme.Hom.comp_apply ψ m z).symm.trans (by rw [hψ]; exact hz)⟩
    intro X B g
    let Φ := wcEtBaseChange g
    haveI h1 : Limits.PreservesFiniteLimits Φ := ⟨fun J _ _ =>
      haveI : Limits.PreservesLimitsOfShape J (wcEtBaseChange g ⋙ Scheme.Etale.forget X) :=
        Limits.preservesLimitsOfShape_of_natIso
          (NatIso.ofComponents (fun _ => Iso.refl _) (fun _ => rfl) :
            Scheme.Etale.forget B ⋙ Over.pullback g ≅ wcEtBaseChange g ⋙ Scheme.Etale.forget X)
      Limits.preservesLimitsOfShape_of_reflects_of_preserves (wcEtBaseChange g) (Scheme.Etale.forget X)⟩
    haveI := flat_of_preservesFiniteLimits Φ
    exact Functor.isContinuous_of_coverPreserving (compatiblePreservingOfFlat _ _) (hcov g)
  have hPT : ∀ {F F' : Finset R} (h : F ⊆ F'), wcSubP R F' ≫ wcSubT R h = wcSubP R F := by
    intro F F' h
    show Spec.map _ ≫ Spec.map _ = Spec.map _
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
    have e1 : (Subring.closure (F' : Set R)).subtype.comp
        (Subring.inclusion (Subring.closure_mono (Finset.coe_subset.mpr h))) =
        (Subring.closure (F : Set R)).subtype := by
      apply RingHom.ext
      intro x
      simp
    rw [e1]
  have hev : ∀ {S : Scheme.{u}} (M : Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1})
      (O : S.Etale) (y : M.obj.obj (Opposite.op O)),
      ((ℓ • 𝟙 M).hom.app (Opposite.op O)).hom y = ℓ • y := by
    intro S M O y
    have e : (ℓ • 𝟙 M).hom = ℓ • 𝟙 M.obj := by
      have h1 : (sheafToPresheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}).map (ℓ • 𝟙 M) =
          ℓ • (sheafToPresheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}).map (𝟙 M) :=
        by rw [CategoryTheory.Functor.map_nsmul]
      rw [CategoryTheory.Functor.map_id] at h1
      exact h1
    rw [e]
    simp only [NatTrans.app_nsmul, NatTrans.id_app, AddCommGrpCat.hom_nsmul, AddCommGrpCat.hom_id,
      AddMonoidHom.nsmul_apply, AddMonoidHom.id_apply]

  have hext : ∀ {Z Y : Scheme.{u}} (g : Z ⟶ Y) (V : Y.Etale) (O : Z.Etale)
      (φ ψ : O ⟶ (wcEtBaseChange g).obj V),
      φ.left ≫ Limits.pullback.fst V.hom g = ψ.left ≫ Limits.pullback.fst V.hom g → φ = ψ := by
    intro Z Y g V O φ ψ h
    exact MorphismProperty.Over.Hom.ext (Limits.pullback.hom_ext (f := V.hom) (g := g) h
      ((MorphismProperty.Over.w φ).trans (MorphismProperty.Over.w ψ).symm))

  have hmap : ∀ {Z Y : Scheme.{u}} (g : Z ⟶ Y) {V V' : Y.Etale} (c : V' ⟶ V),
      ((wcEtBaseChange g).map c).left ≫ Limits.pullback.fst V.hom g =
        Limits.pullback.fst V'.hom g ≫ c.left := by
    intro Z Y g V V' c
    exact Limits.pullback.lift_fst _ _ _
  have hW6 : ∀ {Z Y : Scheme.{u}} (g : Z ⟶ Y) (V : Y.Etale) (O : Z.Etale) (k : O.left ⟶ V.left)
      (hk : k ≫ V.hom = O.hom ≫ g),
      (wcEtInvLift g V O k hk).left ≫ Limits.pullback.fst V.hom g = k := by
    intro Z Y g V O k hk
    exact Limits.pullback.lift_fst _ _ _

  have hmidA : ∀ {A B C D E S W : Scheme.{u}} (x : A ⟶ B) (p : B ⟶ C) (cc : C ⟶ W) (y : A ⟶ D)
      (q : D ⟶ E) (kk : E ⟶ W) (s : A ⟶ S) (k' : S ⟶ C) (d : S ⟶ E),
      x ≫ p = s ≫ k' → y ≫ q = s ≫ d → k' ≫ cc = d ≫ kk → x ≫ p ≫ cc = y ≫ q ≫ kk := by
    intro A B C D E S W x p cc y q kk s k' d h1 h2 h3
    rw [← Category.assoc, h1, Category.assoc, h3, ← Category.assoc, ← h2, Category.assoc]
  have hmidB : ∀ {A B C W : Scheme.{u}} (x : A ⟶ B) (p : B ⟶ C) (cc : C ⟶ W) (q : A ⟶ C)
      (r : A ⟶ W), x ≫ p = q → q ≫ cc = r → x ≫ p ≫ cc = r := by
    intro A B C W x p cc q r h1 h2
    rw [← Category.assoc, h1, h2]
  have hcomp_fst : ∀ {Z Y : Scheme.{u}} (g : Z ⟶ Y) (V : Y.Etale) {O O₁ : Z.Etale} (φ₁ : O ⟶ O₁)
      (φ₂ : O₁ ⟶ (wcEtBaseChange g).obj V) (m : O₁.left ⟶ V.left),
      φ₂.left ≫ Limits.pullback.fst V.hom g = m →
      (φ₁ ≫ φ₂).left ≫ Limits.pullback.fst V.hom g = φ₁.left ≫ m := by
    intro Z Y g V O O₁ φ₁ φ₂ m h
    exact (Category.assoc φ₁.left φ₂.left (Limits.pullback.fst V.hom g)).trans
      (congrArg (fun t => φ₁.left ≫ t) h)

  have hiso : ∀ {Z Y : Scheme.{u}} (g : Z ⟶ Y) (V : Y.Etale) (O : Z.Etale) (h : O.left ⟶ V.left)
      (hh : h ≫ V.hom = O.hom ≫ g), IsPullback h O.hom V.hom g →
      IsIso (wcEtInvLift g V O h hh) := by
    intro Z Y g V O h hh hpb
    have e1 : hpb.isoPullback.hom = (wcEtInvLift g V O h hh).left := by
      apply Limits.pullback.hom_ext
      · rw [IsPullback.isoPullback_hom_fst]
        exact (hW6 g V O h hh).symm
      · rw [IsPullback.isoPullback_hom_snd]
        exact (Limits.pullback.lift_snd _ _ _).symm
    let inv : (wcEtBaseChange g).obj V ⟶ O :=
      MorphismProperty.Over.homMk hpb.isoPullback.inv hpb.isoPullback_inv_snd trivial
    refine ⟨⟨inv, ?_, ?_⟩⟩
    · apply MorphismProperty.Over.Hom.ext
      exact (congrArg (fun m => m ≫ hpb.isoPullback.inv) e1).symm.trans hpb.isoPullback.hom_inv_id
    · apply MorphismProperty.Over.Hom.ext
      exact (congrArg (fun m => hpb.isoPullback.inv ≫ m) e1).symm.trans hpb.isoPullback.inv_hom_id

  have hw : ∀ {F F' : Finset R} (h : F ⊆ F') (V : (wcSubX R F).Etale) (O : (wcSubX R F').Etale)
      (k : O.left ⟶ V.left) (hk : k ≫ V.hom = O.hom ≫ wcSubT R h),
      (Limits.pullback.fst O.hom (wcSubP R F') ≫ k) ≫ V.hom =
        ((wcEtBaseChange (wcSubP R F')).obj O).hom ≫ wcSubP R F := by
    intro F F' h V O k hk
    show (Limits.pullback.fst O.hom (wcSubP R F') ≫ k) ≫ V.hom =
      Limits.pullback.snd O.hom (wcSubP R F') ≫ wcSubP R F
    rw [Category.assoc, hk, ← Category.assoc, Limits.pullback.condition, Category.assoc, hPT h]
  let Mf : ∀ (F F' : Finset R) (h : F ⊆ F') (V : (wcSubX R F).Etale) (O : (wcSubX R F').Etale)
      (k : O.left ⟶ V.left) (hk : k ≫ V.hom = O.hom ≫ wcSubT R h),
      (wcEtBaseChange (wcSubP R F')).obj O ⟶ (wcEtBaseChange (wcSubP R F)).obj V :=
    fun F F' h V O k hk => wcEtInvLift (wcSubP R F) V ((wcEtBaseChange (wcSubP R F')).obj O)
      (Limits.pullback.fst O.hom (wcSubP R F') ≫ k) (hw h V O k hk)
  have hMfst : ∀ (F F' : Finset R) (h : F ⊆ F') (V : (wcSubX R F).Etale) (O : (wcSubX R F').Etale)
      (k : O.left ⟶ V.left) (hk : k ≫ V.hom = O.hom ≫ wcSubT R h),
      (Mf F F' h V O k hk).left ≫ Limits.pullback.fst V.hom (wcSubP R F) =
        Limits.pullback.fst O.hom (wcSubP R F') ≫ k := by
    intro F F' h V O k hk
    exact Limits.pullback.lift_fst _ _ _

  have hGcomp : ∀ {P Q S : ((Spec (.of R)).Etale)ᵒᵖ} (f : P ⟶ Q) (g : Q ⟶ S) (x : G.obj.obj P),
      (G.obj.map g).hom ((G.obj.map f).hom x) = (G.obj.map (f ≫ g)).hom x := by
    intro P Q S f g x
    rw [Functor.map_comp, AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply]
  have hsq : ∀ {P Q Q' S : (Spec (.of R)).Etale} (f₁ : P ⟶ Q) (g₁ : Q ⟶ S) (f₂ : P ⟶ Q')
      (g₂ : Q' ⟶ S), f₁ ≫ g₁ = f₂ ≫ g₂ → ∀ x : G.obj.obj (Opposite.op S),
      (G.obj.map f₁.op).hom ((G.obj.map g₁.op).hom x) =
        (G.obj.map f₂.op).hom ((G.obj.map g₂.op).hom x) := by
    intro P Q Q' S f₁ g₁ f₂ g₂ e x
    rw [hGcomp, hGcomp, ← op_comp, ← op_comp, e]
  have hG2 : ∀ {P Q S : (Spec (.of R)).Etale} (f : P ⟶ S) (f₁ : P ⟶ Q) (g₁ : Q ⟶ S),
      f = f₁ ≫ g₁ → ∀ x : G.obj.obj (Opposite.op S),
      (G.obj.map f.op).hom x = (G.obj.map f₁.op).hom ((G.obj.map g₁.op).hom x) := by
    intro P Q S f f₁ g₁ e x
    rw [hGcomp, ← op_comp, e]

  let A : ∀ F : Finset R, Sheaf (Scheme.smallEtaleTopology (wcSubX R F)) AddCommGrpCat.{u+1} :=
    fun F =>
      haveI := hcont (wcSubP R F)
      ⟨(wcEtBaseChange (wcSubP R F)).op ⋙ G.obj,
        (wcEtBaseChange (wcSubP R F)).op_comp_isSheaf (Scheme.smallEtaleTopology (wcSubX R F))
          (Scheme.smallEtaleTopology (Spec (.of R))) G⟩
  let a : ∀ (F F' : Finset R) (h : F ⊆ F'), wcEtTransport (wcSubT R h) (A F) (A F') :=
    fun F F' h =>
      { ρ := fun V O k hk => (G.obj.map (Mf F F' h V O k hk).op).hom
        nat := by
          intro V V' c O O' d k hk k' hk' hc x
          refine hsq (Mf F F' h V' O' k' hk') ((wcEtBaseChange (wcSubP R F)).map c)
            ((wcEtBaseChange (wcSubP R F')).map d) (Mf F F' h V O k hk) ?_ x
          apply hext
          refine (hcomp_fst _ _ _ _ _ (hmap (wcSubP R F) c)).trans
            (Eq.trans ?_ (hcomp_fst _ _ _ _ _ (hMfst F F' h V O k hk)).symm)
          exact hmidA _ _ _ _ _ _ _ _ _ (hMfst F F' h V' O' k' hk') (hmap (wcSubP R F') d) hc }
  let θ : ∀ F : Finset R, wcEtTransport (wcSubP R F) (A F) G :=
    fun F =>
      { ρ := fun V U k hk => (G.obj.map (wcEtInvLift (wcSubP R F) V U k hk).op).hom
        nat := by
          intro V V' c O O' d k hk k' hk' hc x
          refine hsq (wcEtInvLift (wcSubP R F) V' O' k' hk') ((wcEtBaseChange (wcSubP R F)).map c)
            d (wcEtInvLift (wcSubP R F) V O k hk) ?_ x
          apply hext
          refine (hcomp_fst _ _ _ _ _ (hmap (wcSubP R F) c)).trans
            (Eq.trans ?_ (hcomp_fst _ _ _ _ _ (hW6 (wcSubP R F) V O k hk)).symm)
          exact hmidB _ _ _ _ _ (hW6 (wcSubP R F) V' O' k' hk') hc }
  have hcoh : wcSubCoherent R A a := by
    unfold wcSubCoherent
    refine ⟨?_, ?_⟩
    · intro F V O c hc x
      have e : Mf F F _ V O c.left hc = (wcEtBaseChange (wcSubP R F)).map c :=
        hext _ _ _ _ _ ((hMfst F F _ V O c.left hc).trans (hmap (wcSubP R F) c).symm)
      exact congrArg (fun φ => (G.obj.map (Quiver.Hom.op φ)).hom x) e
    · intro F F' F'' h₁ h₂ V O h hh O₂ k hk x
      have hT : wcSubT R h₂ ≫ wcSubT R h₁ = wcSubT R (Finset.Subset.trans h₁ h₂) := by
        show Spec.map _ ≫ Spec.map _ = Spec.map _
        rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
        have e2 : (Subring.inclusion (Subring.closure_mono (Finset.coe_subset.mpr h₂))).comp
            (Subring.inclusion (Subring.closure_mono (Finset.coe_subset.mpr h₁))) =
            Subring.inclusion (Subring.closure_mono
              (Finset.coe_subset.mpr (Finset.Subset.trans h₁ h₂))) := by
          apply RingHom.ext
          intro x
          apply Subtype.ext
          simp
        rw [e2]
      have hkh : (k ≫ h) ≫ V.hom = O₂.hom ≫ wcSubT R (Finset.Subset.trans h₁ h₂) :=
        (Category.assoc _ _ _).trans ((congrArg (fun t => k ≫ t) hh).trans
          ((Category.assoc _ _ _).symm.trans ((congrArg (fun t => t ≫ wcSubT R h₁) hk).trans
          ((Category.assoc _ _ _).trans (congrArg (fun t => O₂.hom ≫ t) hT)))))
      refine hG2 (Mf F F'' (Finset.Subset.trans h₁ h₂) V O₂ (k ≫ h) hkh) (Mf F' F'' h₂ O O₂ k hk)
        (Mf F F' h₁ V O h hh) ?_ x
      apply hext
      refine (hMfst F F'' (Finset.Subset.trans h₁ h₂) V O₂ (k ≫ h) hkh).trans
        (Eq.trans ?_ (hcomp_fst (wcSubP R F) V (Mf F' F'' h₂ O O₂ k hk) (Mf F F' h₁ V O h hh)
          _ (hMfst F F' h₁ V O h hh)).symm)
      exact (hmidB _ _ _ _ _ (hMfst F' F'' h₂ O O₂ k hk) (Category.assoc _ _ _)).symm
  have hcone : wcSubCocone R A a G θ := by
    intro F F' h V O h' hh O₂ k hk x
    refine hG2 (wcEtInvLift (wcSubP R F) V O₂ (k ≫ h') _) (wcEtInvLift (wcSubP R F') O O₂ k hk)
      (Mf F F' h V O h' hh) ?_ x
    apply hext
    refine (hW6 _ _ _ _ _).trans
      (Eq.trans ?_ (hcomp_fst _ _ _ _ _ (hMfst F F' h V O h' hh)).symm)
    exact (hmidB _ _ _ _ _ (hW6 (wcSubP R F') O O₂ k hk) rfl).symm
  refine ⟨A, a, θ, hcoh, hcone, ?_, ?_⟩
  · intro F V U k hk hpb
    haveI := hiso (wcSubP R F) V U k hk hpb
    exact ConcreteCategory.bijective_of_isIso (G.obj.map (wcEtInvLift (wcSubP R F) V U k hk).op)
  · intro F
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext V
    apply AddCommGrpCat.ext
    intro y
    have h1 : ((ℓ • 𝟙 (A F)).hom.app (Opposite.op V.unop)).hom y = ℓ • y := hev (A F) V.unop y
    have h2 : ((ℓ • 𝟙 G).hom.app
        (Opposite.op ((wcEtBaseChange (wcSubP R F)).obj V.unop))).hom y = ℓ • y :=
      hev G ((wcEtBaseChange (wcSubP R F)).obj V.unop) y
    rw [hG] at h2
    have h3 : ((0 : G ⟶ G).hom.app
        (Opposite.op ((wcEtBaseChange (wcSubP R F)).obj V.unop))).hom y = 0 := by simp
    have h4 : ((0 : A F ⟶ A F).hom.app V).hom y = 0 := by simp
    exact h1.trans (h2.symm.trans (h3.trans h4.symm))

theorem wc_subring_loc_of_pullback_bij : ∀ (R : Type u) [CommRing R]
    (A : ∀ F : Finset R, Sheaf (Scheme.smallEtaleTopology (wcSubX R F)) AddCommGrpCat.{u+1})
    (a : ∀ (F F' : Finset R) (h : F ⊆ F'), wcEtTransport (wcSubT R h) (A F) (A F'))
    (G : Sheaf (Scheme.smallEtaleTopology (Spec (.of R))) AddCommGrpCat.{u+1})
    (θ : ∀ F : Finset R, wcEtTransport (wcSubP R F) (A F) G),
    wcSubCocone R A a G θ →
    (∀ (F : Finset R) (V : (wcSubX R F).Etale) (U : (Spec (.of R)).Etale) (k : U.left ⟶ V.left)
      (hk : k ≫ V.hom = U.hom ≫ wcSubP R F),
      IsPullback k U.hom V.hom (wcSubP R F) → Function.Bijective ((θ F).ρ V U k hk)) →
    wcSubLocGen R A G θ ∧ wcSubLocKer R A a G θ :=
by
  intro R _ A a G θ hθc hbij
  refine ⟨?_, ?_⟩
  ·
    intro U s u
    obtain ⟨W, hW, huW, -⟩ := exists_isAffineOpen_mem_and_subset (x := u) (U := ⊤) trivial
    have hW' : IsAffine (wcEtOpen (Spec (.of R)) U W).left := hW
    obtain ⟨F, V, k, -, hpb⟩ := wc_subring_affine_etale_model R (wcEtOpen (Spec (.of R)) U W) hW'
    obtain ⟨t, ht⟩ := (hbij F V _ k hpb.toCommSq.w hpb).2
      ((G.obj.map (wcEtOpenι (Spec (.of R)) U W).op).hom s)
    refine ⟨wcEtOpen (Spec (.of R)) U W, wcEtOpenι (Spec (.of R)) U W, ⟨u, huW⟩, F, V, k,
      hpb.toCommSq.w, t, ?_, ht⟩
    show W.ι ⟨u, huW⟩ = u
    exact Scheme.Opens.ι_apply W ⟨u, huW⟩
  ·
    intro F V U k hk t ht u
    obtain ⟨V₀, hV₀, hkuV₀, -⟩ := exists_isAffineOpen_mem_and_subset (x := k u) (U := ⊤) trivial
    have hmem : u ∈ k ⁻¹ᵁ V₀ := (Scheme.Hom.mem_preimage k).mpr hkuV₀
    obtain ⟨W, hW, huW, hWsub⟩ := exists_isAffineOpen_mem_and_subset hmem
    have hYa : IsAffine (wcEtOpen (wcSubX R F) V V₀).left := hV₀
    have hU'a : IsAffine (wcEtOpen (Spec (.of R)) U W).left := hW
    have liftLem : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y) (V₁ : Y.Opens) (W₁ : X.Opens),
        W₁ ≤ f ⁻¹ᵁ V₁ → ∃ g : (W₁ : Scheme.{u}) ⟶ (V₁ : Scheme.{u}), g ≫ V₁.ι = W₁.ι ≫ f := by
      intro X Y f V₁ W₁ hle
      exact ⟨f.resLE V₁ W₁ hle, Scheme.Hom.resLE_comp_ι f hle⟩
    obtain ⟨g₀, hlf⟩ : ∃ g : (wcEtOpen (Spec (.of R)) U W).left ⟶
        (wcEtOpen (wcSubX R F) V V₀).left, g ≫ V₀.ι = W.ι ≫ k :=
      liftLem k V₀ W (fun x hx => hWsub hx)
    have hg₀' : g₀ ≫ (V₀.ι ≫ V.hom) = (W.ι ≫ U.hom) ≫ wcSubP R F :=
      (Category.assoc g₀ V₀.ι V.hom).symm.trans ((congrArg (fun x => x ≫ V.hom) hlf).trans
        ((Category.assoc W.ι k V.hom).trans ((congrArg (fun x => W.ι ≫ x) hk).trans
          (Category.assoc W.ι U.hom (wcSubP R F)).symm)))
    have hg₀ : g₀ ≫ (wcEtOpen (wcSubX R F) V V₀).hom =
        (wcEtOpen (Spec (.of R)) U W).hom ≫ wcSubP R F := hg₀'
    obtain ⟨F₁, W₁, k₁, hW₁, hpb₁⟩ :=
      wc_subring_affine_etale_model R (wcEtOpen (Spec (.of R)) U W) hU'a
    obtain ⟨F₃, -, h₂, W', -, k', g', -, -, hpb', -, hg', hk'g'⟩ :=
      wc_subring_hom_descend R (wcEtOpen (Spec (.of R)) U W) F₁ W₁ k₁ hW₁ hpb₁ F
        (wcEtOpen (wcSubX R F) V V₀) g₀ hYa hg₀
    have hk' : k' ≫ W'.hom = (wcEtOpen (Spec (.of R)) U W).hom ≫ wcSubP R F₃ :=
      hpb'.toCommSq.w
    have hk'' : (g' ≫ V₀.ι) ≫ V.hom = W'.hom ≫ wcSubT R h₂ :=
      (Category.assoc g' V₀.ι V.hom).trans hg'
    have hfac : k' ≫ (g' ≫ V₀.ι) = (wcEtOpenι (Spec (.of R)) U W).left ≫ k :=
      (Category.assoc k' g' V₀.ι).symm.trans ((congrArg (fun x => x ≫ V₀.ι) hk'g').trans hlf)
    have hcl : ((wcEtOpenι (Spec (.of R)) U W).left ≫ k) ≫ V.hom =
        (wcEtOpen (Spec (.of R)) U W).hom ≫ wcSubP R F :=
      (Category.assoc W.ι k V.hom).trans ((congrArg (fun x => W.ι ≫ x) hk).trans
        (Category.assoc W.ι U.hom (wcSubP R F)).symm)
    have TC : ∀ (j₁ j₂ : (wcEtOpen (Spec (.of R)) U W).left ⟶ V.left)
        (e₁ : j₁ ≫ V.hom = (wcEtOpen (Spec (.of R)) U W).hom ≫ wcSubP R F)
        (e₂ : j₂ ≫ V.hom = (wcEtOpen (Spec (.of R)) U W).hom ≫ wcSubP R F), j₁ = j₂ →
        (θ F).ρ V (wcEtOpen (Spec (.of R)) U W) j₁ e₁ t =
          (θ F).ρ V (wcEtOpen (Spec (.of R)) U W) j₂ e₂ t := by
      intro j₁ j₂ e₁ e₂ e
      subst e
      rfl
    have e1 := hθc F F₃ h₂ V W' (g' ≫ V₀.ι) hk'' (wcEtOpen (Spec (.of R)) U W) k' hk' t
    have e3 := (θ F).nat V V (𝟙 V) U (wcEtOpen (Spec (.of R)) U W) (wcEtOpenι (Spec (.of R)) U W)
      k hk ((wcEtOpenι (Spec (.of R)) U W).left ≫ k) hcl
      (by first | exact Category.comp_id _ | simp) t
    rw [op_id, CategoryTheory.Functor.map_id] at e3
    have e4 : (G.obj.map (wcEtOpenι (Spec (.of R)) U W).op).hom ((θ F).ρ V U k hk t) = 0 := by
      rw [ht]; exact map_zero _
    have hz : (θ F₃).ρ W' (wcEtOpen (Spec (.of R)) U W) k' hk'
        ((a F F₃ h₂).ρ V W' (g' ≫ V₀.ι) hk'' t) = 0 :=
      e1.symm.trans ((TC _ _ _ hcl hfac).trans (e3.trans e4))
    have hinj := (hbij F₃ W' (wcEtOpen (Spec (.of R)) U W) k' hk' hpb').1
    refine ⟨wcEtOpen (Spec (.of R)) U W, wcEtOpenι (Spec (.of R)) U W, ⟨u, huW⟩, F₃, h₂, W', k',
      hk', g' ≫ V₀.ι, hk'', ?_, hfac, hinj (hz.trans (map_zero _).symm)⟩
    show W.ι ⟨u, huW⟩ = u
    exact Scheme.Opens.ι_apply W ⟨u, huW⟩

theorem wc_subring_cocone_univ_of_loc : ∀ (R : Type u) [CommRing R]
    (A : ∀ F : Finset R, Sheaf (Scheme.smallEtaleTopology (wcSubX R F)) AddCommGrpCat.{u+1})
    (a : ∀ (F F' : Finset R) (h : F ⊆ F'), wcEtTransport (wcSubT R h) (A F) (A F'))
    (G : Sheaf (Scheme.smallEtaleTopology (Spec (.of R))) AddCommGrpCat.{u+1})
    (θ : ∀ F : Finset R, wcEtTransport (wcSubP R F) (A F) G),
    wcSubCoherent R A a → wcSubCocone R A a G θ → wcSubLocGen R A G θ → wcSubLocKer R A a G θ →
    ∀ (H' : Sheaf (Scheme.smallEtaleTopology (Spec (.of R))) AddCommGrpCat.{u+1})
      (σ' : ∀ F : Finset R, wcEtTransport (wcSubP R F) (A F) H'), wcSubCocone R A a H' σ' →
      ∃! φ : G ⟶ H', ∀ (F : Finset R) (V : (wcSubX R F).Etale) (U : (Spec (.of R)).Etale)
        (k : U.left ⟶ V.left) (hk : k ≫ V.hom = U.hom ≫ wcSubP R F)
        (x : (A F).obj.obj (Opposite.op V)),
        (φ.hom.app (Opposite.op U)).hom ((θ F).ρ V U k hk x) = (σ' F).ρ V U k hk x :=
by
  intro R _ A a G θ hcoh hθc hθg hθk H' σ' hσ'
  classical



  have hetale : ∀ {Y : Scheme.{u}} {V V₁ : Y.Etale} (c : V₁ ⟶ V), Etale c.left := by
    intro Y V V₁ c
    exact MorphismProperty.of_postcomp @Etale c.left V.hom V.prop
      (by rw [MorphismProperty.Over.w c]; exact V₁.prop)
  have hcov : ∀ {Y : Scheme.{u}} (V : Y.Etale) (S : Sieve V),
      (∀ v : V.left, ∃ (V₁ : Y.Etale) (c : V₁ ⟶ V) (v₁ : V₁.left), S.arrows c ∧ c.left v₁ = v) →
      S ∈ Scheme.smallEtaleTopology Y V := by
    intro Y V S hS
    have h := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ V S).mpr (fun v => by
        obtain ⟨V₁, c, v₁, hc, hv⟩ := hS v
        exact ⟨V₁, c, v₁, hc, hetale c, hv⟩)
    show S ∈ Scheme.smallGrothendieckTopology @Etale Y V
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
    exact h
  have hcl : ∀ {Y : Scheme.{u}} {A B C : Y.Etale} (f : A ⟶ B) (g : B ⟶ C),
      (f ≫ g).left = f.left ≫ g.left := fun _ _ => rfl
  have hcompPt : ∀ {Y : Scheme.{u}} {A B C : Y.Etale} (f : A ⟶ B) (g : B ⟶ C) (x : A.left),
      (f ≫ g).left x = g.left (f.left x) := by
    intro Y A B C f g x
    rw [hcl, Scheme.Hom.comp_apply]
  have e5 : ∀ {Y : Scheme.{u}} (G : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})
      {A B C : Y.Etale} (f : A ⟶ B) (g : B ⟶ C) (z : G.obj.obj (Opposite.op C)),
      (G.obj.map (f ≫ g).op).hom z = (G.obj.map f.op).hom ((G.obj.map g.op).hom z) := by
    intro Y G A B C f g z
    rw [op_comp, Functor.map_comp]
    rfl
  have hnat : ∀ {Y : Scheme.{u}} {A B : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}}
      (φ : A ⟶ B) {U U' : Y.Etale} (c : U' ⟶ U) (z : A.obj.obj (Opposite.op U)),
      (φ.hom.app (Opposite.op U')).hom ((A.obj.map c.op).hom z) =
        (B.obj.map c.op).hom ((φ.hom.app (Opposite.op U)).hom z) := by
    intro Y A B φ U U' c z
    exact congrArg (fun ψ => AddCommGrpCat.Hom.hom ψ z) (φ.hom.naturality c.op)
  have hρ : ∀ {A B : Scheme.{u}} {f : A ⟶ B}
      {F₁ : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}}
      {G₁ : Sheaf (Scheme.smallEtaleTopology A) AddCommGrpCat.{u+1}} (T : wcEtTransport f F₁ G₁)
      {V : B.Etale} {O : A.Etale} {h h' : O.left ⟶ V.left} (_ : h = h')
      (hh : h ≫ V.hom = O.hom ≫ f) (hh' : h' ≫ V.hom = O.hom ≫ f)
      (x : F₁.obj.obj (Opposite.op V)), T.ρ V O h hh x = T.ρ V O h' hh' x := by
    intro A B f F₁ G₁ T V O h h' hhh' hh hh' x
    subst hhh'
    rfl

  have hS1 : ∀ {Y : Scheme.{u}} {A B C : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}}
      (f : A ⟶ B) (g : B ⟶ C) (w : f ≫ g = 0),
      (∀ (U : Y.Etale) (b : B.obj.obj (Opposite.op U)), (g.hom.app (Opposite.op U)).hom b = 0 →
        ∀ u : U.left, ∃ (U' : Y.Etale) (c : U' ⟶ U) (u' : U'.left) (a : A.obj.obj (Opposite.op U')),
          c.left u' = u ∧ (f.hom.app (Opposite.op U')).hom a = (B.obj.map c.op).hom b) →
      (ShortComplex.mk f g w).Exact := by
    intro Y A B C f g w hloc
    rw [ShortComplex.exact_iff_epi_kernel_lift]
    have hιinj : ∀ U, Function.Injective ((Limits.kernel.ι g).hom.app (Opposite.op U)).hom := by
      intro U
      have h1 : Mono (Limits.kernel.ι g).hom :=
        (sheafToPresheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map_mono
          (Limits.kernel.ι g)
      have h2 : Mono ((Limits.kernel.ι g).hom.app (Opposite.op U)) :=
        (NatTrans.mono_iff_mono_app _).mp h1 _
      exact (AddCommGrpCat.mono_iff_injective _).mp h2
    have hls : Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology Y)
        (Limits.kernel.lift g f w).hom := by
      refine ⟨fun {U} s => ?_⟩
      have hb : (g.hom.app (Opposite.op U)).hom
          (((Limits.kernel.ι g).hom.app (Opposite.op U)).hom s) = 0 := by
        have := congrArg (fun φ => (φ.hom.app (Opposite.op U)).hom s) (Limits.kernel.condition g)
        exact this
      apply hcov
      intro u
      obtain ⟨U', c, u', a, hu', ha⟩ := hloc U _ hb u
      refine ⟨U', c, u', ⟨a, ?_⟩, hu'⟩
      apply hιinj U'
      have e1 := congrArg (fun φ => (φ.hom.app (Opposite.op U')).hom a) (Limits.kernel.lift_ι g f w)
      have e2 := congrArg (fun φ => AddCommGrpCat.Hom.hom φ s)
        ((Limits.kernel.ι g).hom.naturality c.op)
      exact e1.trans (ha.trans e2.symm)
    exact (Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u+1} _).mp hls

  have hS3 : ∀ {Y : Scheme.{u}} {A B : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}}
      (f : A ⟶ B),
      (∀ (U : Y.Etale) (a : A.obj.obj (Opposite.op U)), (f.hom.app (Opposite.op U)).hom a = 0 →
        ∀ u : U.left, ∃ (U' : Y.Etale) (c : U' ⟶ U) (u' : U'.left),
          c.left u' = u ∧ (A.obj.map c.op).hom a = 0) → Mono f := by
    intro Y A B f hloc
    have hex := hS1 (0 : A ⟶ A) f Limits.zero_comp (fun U a ha u => by
      obtain ⟨U', c, u', hu', hc⟩ := hloc U a ha u
      exact ⟨U', c, u', 0, hu', hc.symm⟩)
    exact (ShortComplex.exact_iff_mono _ rfl).mp hex



  obtain ⟨H, σ, hσc, hσg, _hσk, huniv⟩ := wc_subring_colim_sheaf_exists R A a hcoh
  obtain ⟨φ₀, hφ₀, -⟩ := huniv G θ hθc



  have hinj : ∀ (U : (Spec (.of R)).Etale) (y : H.obj.obj (Opposite.op U)),
      (φ₀.hom.app (Opposite.op U)).hom y = 0 → ∀ u : U.left,
      ∃ (U' : (Spec (.of R)).Etale) (c : U' ⟶ U) (u' : U'.left),
        c.left u' = u ∧ (H.obj.map c.op).hom y = 0 := by
    intro U y hy u
    obtain ⟨U₁, c₁, u₁, F, V, k, hk, t, hu₁, ht⟩ := hσg U y u
    have hθt : (θ F).ρ V U₁ k hk t = 0 := by
      rw [← hφ₀ F V U₁ k hk t, ht, hnat φ₀ c₁ y, hy, map_zero]
    obtain ⟨U₂, c₂, u₂, F', h, O, k', hk', k'', hk'', hu₂, hkk, hvan⟩ :=
      hθk F V U₁ k hk t hθt u₁
    have hk₂ : (c₂.left ≫ k) ≫ V.hom = U₂.hom ≫ wcSubP R F := by
      rw [Category.assoc, hk, ← Category.assoc, MorphismProperty.Over.w c₂]
    refine ⟨U₂, c₂ ≫ c₁, u₂, ?_, ?_⟩
    · rw [hcompPt, hu₂, hu₁]
    · have h1 := (σ F).nat V V (𝟙 V) U₁ U₂ c₂ k hk (c₂.left ≫ k) hk₂
        (Category.comp_id _) t
      rw [op_id, CategoryTheory.Functor.map_id] at h1
      have h2 := hσc F F' h V O k'' hk'' U₂ k' hk' t
      rw [hvan, map_zero] at h2
      rw [e5 H c₂ c₁ y, ← ht]
      exact h1.symm.trans ((hρ (σ F) hkk.symm hk₂ (by rw [hkk]; exact hk₂) t).trans h2)



  have hepi : Epi φ₀ := by
    have hls : Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology (Spec (.of R))) φ₀.hom := by
      refine ⟨fun {U} b => ?_⟩
      apply hcov
      intro u
      obtain ⟨U', c, u', F, V, k, hk, t, hu', ht⟩ := hθg U b u
      exact ⟨U', c, u', ⟨(σ F).ρ V U' k hk t, (hφ₀ F V U' k hk t).trans ht⟩, hu'⟩
    exact (Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u+1} φ₀).mp hls
  have hmono : Mono φ₀ := hS3 φ₀ hinj
  haveI : IsIso φ₀ := isIso_of_mono_of_epi φ₀



  obtain ⟨ψ, hψ, hψu⟩ := huniv H' σ' hσ'
  have hinv : ∀ (U : (Spec (.of R)).Etale) (z : H.obj.obj (Opposite.op U)),
      ((inv φ₀).hom.app (Opposite.op U)).hom ((φ₀.hom.app (Opposite.op U)).hom z) = z := by
    intro U z
    exact congrArg (fun f => (f.hom.app (Opposite.op U)).hom z) (IsIso.hom_inv_id φ₀)
  refine ⟨inv φ₀ ≫ ψ, ?_, ?_⟩
  · intro F V U k hk x
    show (ψ.hom.app (Opposite.op U)).hom
      (((inv φ₀).hom.app (Opposite.op U)).hom ((θ F).ρ V U k hk x)) = _
    rw [← hφ₀ F V U k hk x, hinv]
    exact hψ F V U k hk x
  · intro φ' hφ'
    have h1 : φ₀ ≫ φ' = ψ := hψu (φ₀ ≫ φ') (fun F V U k hk x => by
      show (φ'.hom.app (Opposite.op U)).hom
        ((φ₀.hom.app (Opposite.op U)).hom ((σ F).ρ V U k hk x)) = _
      rw [hφ₀]
      exact hφ' F V U k hk x)
    exact (IsIso.eq_inv_comp φ₀).mpr h1

theorem wc_subring_coherent_injres_gen : ∀ (R : Type u) [CommRing R]
    (A : ∀ F : Finset R, Sheaf (Scheme.smallEtaleTopology (wcSubX R F)) AddCommGrpCat.{u+1})
    (a : ∀ (F F' : Finset R) (h : F ⊆ F'), wcEtTransport (wcSubT R h) (A F) (A F')),
    wcSubCoherent R A a →
    ∃ (I : ∀ F : Finset R, InjectiveResolution (A F))
      (e : ∀ (n : ℕ) (F F' : Finset R) (h : F ⊆ F'),
        wcEtTransport (wcSubT R h) ((I F).cocomplex.X n) ((I F').cocomplex.X n)),
      (∀ n, wcSubCoherent R (fun F => (I F).cocomplex.X n) (e n)) ∧
      (∀ (n : ℕ) (F F' : Finset R) (h : F ⊆ F') (V : (wcSubX R F).Etale)
          (O : (wcSubX R F').Etale) (k : O.left ⟶ V.left) (hk : k ≫ V.hom = O.hom ≫ wcSubT R h)
          (x : ((I F).cocomplex.X n).obj.obj (Opposite.op V)),
        (e (n + 1) F F' h).ρ V O k hk ((((I F).cocomplex.d n (n + 1)).hom.app (Opposite.op V)).hom x) =
          (((I F').cocomplex.d n (n + 1)).hom.app (Opposite.op O)).hom ((e n F F' h).ρ V O k hk x)) ∧
      (∀ (F F' : Finset R) (h : F ⊆ F') (V : (wcSubX R F).Etale) (O : (wcSubX R F').Etale)
          (k : O.left ⟶ V.left) (hk : k ≫ V.hom = O.hom ≫ wcSubT R h)
          (x : (A F).obj.obj (Opposite.op V)),
        (e 0 F F' h).ρ V O k hk (((wcInjAug (I F)).hom.app (Opposite.op V)).hom x) =
          ((wcInjAug (I F')).hom.app (Opposite.op O)).hom ((a F F' h).ρ V O k hk x)) :=
by
  intro R _ A a hcoh
  classical
  let Pack := Σ' (A : ∀ F : Finset R, Sheaf (Scheme.smallEtaleTopology (wcSubX R F)) AddCommGrpCat.{u+1})
      (a : ∀ (F F' : Finset R) (h : F ⊆ F'), wcEtTransport (wcSubT R h) (A F) (A F')),
      wcSubCoherent R A a
  choose E ε μ hinj hmono hcohE hcompE using
    fun P : Pack => wc_subring_coh_injective_embed R P.1 P.2.1 P.2.2
  choose c hcohC hπ using
    fun P : Pack => wc_subring_coh_cokernel R P.1 (E P) P.2.1 (ε P) (μ P) (hcohE P) (hcompE P)
  let next : Pack → Pack := fun P => ⟨fun F => Limits.cokernel (μ P F), c P, hcohC P⟩
  let P₀ : Pack := ⟨A, a, hcoh⟩
  let pk : ℕ → Pack := fun n => Nat.rec (motive := fun _ => Pack) P₀ (fun _ P => next P) n
  let dd : ∀ (n : ℕ) (F : Finset R), E (pk n) F ⟶ E (pk (n + 1)) F := fun n F =>
    Limits.cokernel.π (μ (pk n) F) ≫ μ (pk (n + 1)) F
  have hdd : ∀ (F : Finset R) (n : ℕ), dd n F ≫ dd (n + 1) F = 0 := by
    intro F n
    show (Limits.cokernel.π (μ (pk n) F) ≫ μ (pk (n + 1)) F) ≫
      (Limits.cokernel.π (μ (pk (n + 1)) F) ≫ μ (pk (n + 1 + 1)) F) = 0
    rw [Category.assoc, ← Category.assoc (μ (pk (n + 1)) F), Limits.cokernel.condition,
      Limits.zero_comp, Limits.comp_zero]

  have hex : ∀ (F : Finset R) (n : ℕ), (ShortComplex.mk (dd n F) (dd (n + 1) F) (hdd F n)).Exact := by
    intro F n
    let S0 := ShortComplex.mk (μ (pk (n + 1)) F) (Limits.cokernel.π (μ (pk (n + 1)) F))
      (Limits.cokernel.condition _)
    have hS0 : S0.Exact := S0.exact_of_g_is_cokernel (Limits.cokernelIsCokernel _)
    have hz1 : dd n F ≫ Limits.cokernel.π (μ (pk (n + 1)) F) = 0 := by
      show (Limits.cokernel.π (μ (pk n) F) ≫ μ (pk (n + 1)) F) ≫
        Limits.cokernel.π (μ (pk (n + 1)) F) = 0
      rw [Category.assoc, Limits.cokernel.condition, Limits.comp_zero]
    let S1 := ShortComplex.mk (dd n F) (Limits.cokernel.π (μ (pk (n + 1)) F)) hz1
    let φ1 : S1 ⟶ S0 :=
      { τ₁ := Limits.cokernel.π (μ (pk n) F)
        τ₂ := 𝟙 _
        τ₃ := 𝟙 _
        comm₁₂ := (Category.comp_id _).symm
        comm₂₃ := by simp only [Category.id_comp, Category.comp_id]; rfl }
    have hS1 : S1.Exact :=
      (@ShortComplex.exact_iff_of_epi_of_isIso_of_mono _ _ _ S1 S0 φ1
        (show Epi (Limits.cokernel.π (μ (pk n) F)) from inferInstance)
        (show IsIso (𝟙 _) from inferInstance) (show Mono (𝟙 _) from inferInstance)).mpr hS0
    let φ2 : S1 ⟶ ShortComplex.mk (dd n F) (dd (n + 1) F) (hdd F n) :=
      { τ₁ := 𝟙 _
        τ₂ := 𝟙 _
        τ₃ := μ (pk (n + 1 + 1)) F
        comm₁₂ := by simp only [Category.id_comp, Category.comp_id]; try rfl
        comm₂₃ := by simp only [Category.id_comp]; rfl }
    exact (@ShortComplex.exact_iff_of_epi_of_isIso_of_mono _ _ _ _ _ φ2
      (show Epi (𝟙 _) from inferInstance) (show IsIso (𝟙 _) from inferInstance)
      (hmono (pk (n + 1 + 1)) F)).mp hS1
  have h0 : ∀ F : Finset R, μ (pk 0) F ≫ dd 0 F = 0 := by
    intro F
    show μ (pk 0) F ≫ (Limits.cokernel.π (μ (pk 0) F) ≫ μ (pk (0 + 1)) F) = 0
    rw [← Category.assoc, Limits.cokernel.condition, Limits.zero_comp]
  have hex0 : ∀ F : Finset R, (ShortComplex.mk (μ (pk 0) F) (dd 0 F) (h0 F)).Exact := by
    intro F
    let S0 := ShortComplex.mk (μ (pk 0) F) (Limits.cokernel.π (μ (pk 0) F))
      (Limits.cokernel.condition _)
    have hS0 : S0.Exact := S0.exact_of_g_is_cokernel (Limits.cokernelIsCokernel _)
    let φ : S0 ⟶ ShortComplex.mk (μ (pk 0) F) (dd 0 F) (h0 F) :=
      { τ₁ := 𝟙 _
        τ₂ := 𝟙 _
        τ₃ := μ (pk (0 + 1)) F
        comm₁₂ := by simp only [Category.id_comp, Category.comp_id]; try rfl
        comm₂₃ := by simp only [Category.id_comp]; rfl }
    exact (@ShortComplex.exact_iff_of_epi_of_isIso_of_mono _ _ _ _ _ φ
      (show Epi (𝟙 _) from inferInstance) (show IsIso (𝟙 _) from inferInstance)
      (hmono (pk (0 + 1)) F)).mp hS0

  let K : ∀ F : Finset R, CochainComplex (Sheaf (Scheme.smallEtaleTopology (wcSubX R F))
      AddCommGrpCat.{u+1}) ℕ := fun F =>
    CochainComplex.of (fun n => E (pk n) F) (fun n => dd n F) (hdd F)
  have hKd : ∀ (F : Finset R) (n : ℕ), (K F).d n (n + 1) = dd n F := fun F n =>
    CochainComplex.of_d (fun n => E (pk n) F) (fun n => dd n F) n
  have hKex : ∀ (F : Finset R) (n : ℕ), (K F).ExactAt (n + 1) := by
    intro F n
    rw [HomologicalComplex.exactAt_iff' (K F) n (n + 1) (n + 1 + 1) (CochainComplex.prev_nat_succ n)
      (CochainComplex.next ℕ (n + 1))]
    let eK : ShortComplex.mk (dd n F) (dd (n + 1) F) (hdd F n) ≅ (K F).sc' n (n + 1) (n + 1 + 1) :=
      ShortComplex.isoMk (Iso.refl _) (Iso.refl _) (Iso.refl _)
        (by
          simp only [Iso.refl_hom, Category.id_comp, Category.comp_id]
          try exact hKd F n)
        (by
          simp only [Iso.refl_hom, Category.id_comp, Category.comp_id]
          try exact hKd F (n + 1))
    exact (ShortComplex.exact_iff_of_iso eK).mp (hex F n)
  have hμ : ∀ F : Finset R, μ (pk 0) F ≫ (K F).d 0 1 = 0 := fun F => by
    rw [show (K F).d 0 1 = dd 0 F from hKd F 0]
    exact h0 F
  let ι : ∀ F : Finset R, (CochainComplex.single₀ _).obj (A F) ⟶ K F :=
    fun F => ((K F).fromSingle₀Equiv _).symm ⟨μ (pk 0) F, hμ F⟩
  have hιf : ∀ F : Finset R, (ι F).f 0 = μ (pk 0) F := fun F =>
    CochainComplex.fromSingle₀Equiv_symm_apply_f_zero _ _
  have hqis : ∀ F : Finset R, QuasiIso (ι F) := by
    intro F
    rw [quasiIso_iff]
    intro i
    cases i with
    | succ n =>
      exact (quasiIsoAt_iff_exactAt (ι F) (n + 1)
        (CochainComplex.exactAt_succ_single_obj _ n)).mpr (hKex F n)
    | zero =>
      refine (CochainComplex.quasiIsoAt₀_iff (ι F)).mpr
        ((ShortComplex.quasiIso_iff_of_zeros _ ?_ ?_ ?_).mpr ⟨?_, ?_⟩)
      · exact HomologicalComplex.single_obj_d (ComplexShape.up ℕ) 0 _ _ _
      · exact HomologicalComplex.single_obj_d (ComplexShape.up ℕ) 0 _ _ _
      · exact (K F).shape 0 0 (by simp)
      · refine (ShortComplex.exact_iff_of_iso (ShortComplex.isoMk
          (S₁ := ShortComplex.mk (μ (pk 0) F) (dd 0 F) (h0 F)) (Iso.refl _) (Iso.refl _)
          (Iso.refl _) ?_ ?_)).mp (hex0 F)
        · simp only [Iso.refl_hom, Category.id_comp, Category.comp_id]
          try exact hιf F
        · simp only [Iso.refl_hom, Category.id_comp, Category.comp_id]
          try exact hKd F 0
      · show Mono ((ι F).f 0)
        rw [hιf F]
        exact hmono (pk 0) F
  let I : ∀ F : Finset R, InjectiveResolution (A F) := fun F =>
    { cocomplex := K F
      injective := fun n => hinj (pk n) F
      ι := ι F
      quasiIso := hqis F }
  have haug : ∀ F : Finset R, wcInjAug (I F) = μ (pk 0) F := by
    intro F
    show (HomologicalComplex.singleObjXSelf (ComplexShape.up ℕ) 0 _).inv ≫ (ι F).f 0 = μ (pk 0) F
    rw [CochainComplex.single₀ObjXSelf, Iso.refl_inv]
    exact (Category.id_comp ((ι F).f 0)).trans (hιf F)
  refine ⟨I, fun n F F' h => ε (pk n) F F' h, fun n => hcohE (pk n), ?_, ?_⟩
  · intro n F F' h V O k hk x
    have e1 : (I F).cocomplex.d n (n + 1) = dd n F := hKd F n
    have e2 : (I F').cocomplex.d n (n + 1) = dd n F' := hKd F' n
    rw [e1, e2]
    exact (hcompE (pk (n + 1)) F F' h V O k hk _).trans
      (congrArg (fun z => ((μ (pk (n + 1)) F').hom.app (Opposite.op O)).hom z)
        (hπ (pk n) F F' h V O k hk x))
  · intro F F' h V O k hk x
    rw [haug F, haug F']
    exact hcompE (pk 0) F F' h V O k hk x

theorem wc_subring_colim_resolution_exact_gen : ∀ (R : Type u) [CommRing R]
    (A : ∀ F : Finset R, Sheaf (Scheme.smallEtaleTopology (wcSubX R F)) AddCommGrpCat.{u+1})
    (a : ∀ (F F' : Finset R) (h : F ⊆ F'), wcEtTransport (wcSubT R h) (A F) (A F'))
    (G : Sheaf (Scheme.smallEtaleTopology (Spec (.of R))) AddCommGrpCat.{u+1})
    (θ : ∀ F : Finset R, wcEtTransport (wcSubP R F) (A F) G)
    (I : ∀ F : Finset R, InjectiveResolution (A F))
    (e : ∀ (n : ℕ) (F F' : Finset R) (h : F ⊆ F'),
      wcEtTransport (wcSubT R h) ((I F).cocomplex.X n) ((I F').cocomplex.X n))
    (K : CochainComplex (Sheaf (Scheme.smallEtaleTopology (Spec (.of R))) AddCommGrpCat.{u+1}) ℕ)
    (σ : ∀ (n : ℕ) (F : Finset R), wcEtTransport (wcSubP R F) ((I F).cocomplex.X n) (K.X n))
    (εK : G ⟶ K.X 0) (hεK : εK ≫ K.d 0 1 = 0),
    wcSubCocone R A a G θ → wcSubLocGen R A G θ →
    (∀ (n : ℕ) (F F' : Finset R) (h : F ⊆ F') (V : (wcSubX R F).Etale)
        (O : (wcSubX R F').Etale) (k : O.left ⟶ V.left) (hk : k ≫ V.hom = O.hom ≫ wcSubT R h)
        (x : ((I F).cocomplex.X n).obj.obj (Opposite.op V)),
      (e (n + 1) F F' h).ρ V O k hk ((((I F).cocomplex.d n (n + 1)).hom.app (Opposite.op V)).hom x) =
        (((I F').cocomplex.d n (n + 1)).hom.app (Opposite.op O)).hom ((e n F F' h).ρ V O k hk x)) →
    (∀ (F F' : Finset R) (h : F ⊆ F') (V : (wcSubX R F).Etale) (O : (wcSubX R F').Etale)
        (k : O.left ⟶ V.left) (hk : k ≫ V.hom = O.hom ≫ wcSubT R h)
        (x : (A F).obj.obj (Opposite.op V)),
