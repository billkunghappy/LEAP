      (Abelian.Ext.mk₀ γPA).comp (wcSuppPullExt DA EPA q
        ((Abelian.Ext.mk₀ (γA ≫ adjA.unit.app (EA.Φ.obj (wcSuppObj D)))).comp
          ((Abelian.Ext.mapExactFunctor EA.Φ x).comp (Abelian.Ext.mk₀ EA.μ.hom) (add_zero q))
          (zero_add q))) (zero_add q) := by
    intro x
    rw [PsiWu]
    exact wc_qmbt_pmv_restr_comp_sub jA pA (pA ≫ jA) rfl D hD DA hDA DP hDP eDP EA hEA EPA hEPA
      EP hEP γA γPA γP hγA hγPA hγP _ (adjA.counit.app (wcSuppObj D)) (monoA _) _ _ hκA hκPA q x
  have NatB : ∀ x : Abelian.Ext (LB.obj (EB.Φ.obj (wcSuppObj D)))
      (SheafOfModules.unit (wcRingSheaf Y ℓ)) q,
      (Abelian.Ext.mk₀ (γP ≫ adjP.unit.app (EP.Φ.obj (wcSuppObj D)))).comp
        ((Abelian.Ext.mapExactFunctor EP.Φ ((Abelian.Ext.mk₀ v).comp x (zero_add q))).comp
          (Abelian.Ext.mk₀ EP.μ.hom) (add_zero q)) (zero_add q) =
      (Abelian.Ext.mk₀ γPB).comp (wcSuppPullExt DB EPB q
        ((Abelian.Ext.mk₀ (γB ≫ adjB.unit.app (EB.Φ.obj (wcSuppObj D)))).comp
          ((Abelian.Ext.mapExactFunctor EB.Φ x).comp (Abelian.Ext.mk₀ EB.μ.hom) (add_zero q))
          (zero_add q))) (zero_add q) := by
    intro x
    rw [PsiWu]
    exact wc_qmbt_pmv_restr_comp_sub jB pB (pA ≫ jA) hP.w.symm D hD DB hDB DP hDP eDP EB hEB
      EPB hEPB EP hEP γB γPB γP hγB hγPB hγP _ (adjB.counit.app (wcSuppObj D)) (monoB _) _ _ hκB
      hκPB q x
  refine ⟨?_, ?_⟩
  ·
    intro θA θB hag
    obtain ⟨xA, hxA⟩ := bijA.2 θA
    obtain ⟨yB, hyB⟩ := bijB.2 θB
    beta_reduce at hxA hyB
    have e1 := NatA xA
    have e2 := NatB yB
    rw [hxA] at e1
    rw [hyB] at e2
    have e : (Abelian.Ext.mk₀ u).comp xA (zero_add q) = (Abelian.Ext.mk₀ v).comp yB (zero_add q) :=
      (bijP q).1 (e1.trans (hag.trans e2.symm))
    obtain ⟨θ, h1, h2⟩ := Glue (SheafOfModules.unit (wcRingSheaf Y ℓ)) q xA yB e
    refine ⟨θ, ?_, ?_⟩
    · have fA := formA θ
      rw [h1, hxA] at fA
      exact fA.symm
    · have fB := formB θ
      rw [h2, hyB] at fB
      exact fB.symm
  ·
    intro q' hq' hvan θ hRA0 hRB0
    have hΨ0A : (Abelian.Ext.mk₀ (γA ≫ adjA.unit.app (EA.Φ.obj (wcSuppObj D)))).comp
        ((Abelian.Ext.mapExactFunctor EA.Φ (0 : Abelian.Ext (LA.obj (EA.Φ.obj (wcSuppObj D)))
          (SheafOfModules.unit (wcRingSheaf Y ℓ)) q)).comp (Abelian.Ext.mk₀ EA.μ.hom)
            (add_zero q)) (zero_add q) = 0 := by
      rw [Abelian.Ext.mapExactFunctor_zero, Abelian.Ext.zero_comp, Abelian.Ext.comp_zero]
    have hΨ0B : (Abelian.Ext.mk₀ (γB ≫ adjB.unit.app (EB.Φ.obj (wcSuppObj D)))).comp
        ((Abelian.Ext.mapExactFunctor EB.Φ (0 : Abelian.Ext (LB.obj (EB.Φ.obj (wcSuppObj D)))
          (SheafOfModules.unit (wcRingSheaf Y ℓ)) q)).comp (Abelian.Ext.mk₀ EB.μ.hom)
            (add_zero q)) (zero_add q) = 0 := by
      rw [Abelian.Ext.mapExactFunctor_zero, Abelian.Ext.zero_comp, Abelian.Ext.comp_zero]
    have h0A : (Abelian.Ext.mk₀ (adjA.counit.app (wcSuppObj D))).comp θ (zero_add q) = 0 :=
      bijA.1 ((formA θ).trans (hRA0.trans hΨ0A.symm))
    have h0B : (Abelian.Ext.mk₀ (adjB.counit.app (wcSuppObj D))).comp θ (zero_add q) = 0 :=
      bijB.1 ((formB θ).trans (hRB0.trans hΨ0B.symm))
    have hg : (Abelian.Ext.mk₀ (Limits.biprod.desc (adjA.counit.app (wcSuppObj D))
        (adjB.counit.app (wcSuppObj D)))).comp θ (zero_add q) = 0 := by
      apply Abelian.Ext.biprod_ext
      · rw [Abelian.Ext.comp_zero, ← Abelian.Ext.comp_assoc_of_second_deg_zero,
