  simp only [Units.val_pow_eq_pow_val, map_pow] at hpow
  rw [hΛa] at hpow
  exact wc_away_prime_not_pow _ _ hyp ℓ (Fact.out : Nat.Prime ℓ).two_le ⟨_, hpow⟩

theorem wc_qmbt_xsp_ess_D1l_Y_punct_stalk_counts {A : Type u} [CommRing A] [IsDomain A]
    [IsDiscreteValuationRing A]
    [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
