theorem wc_proet_open_closed_supp_free_ext_vanish_of_et {X Z : Scheme.{u}} (i : Z ⟶ X)
    [IsClosedImmersion i] [IsLocallyNoetherian X] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (Di : wcHMPullData i ℓ) (hDi : wcHMPullCanonical Di)
    (O : X.Opens) (Dj : wcHMPullData O.ι ℓ) (hDj : wcHMPullCanonical Dj)
    (W : X.ProEt) (hW : IsAffine W.left)
    (P : SheafOfModules.{u+1} (wcRingSheaf X ℓ))
    (ev : ∀ M : SheafOfModules.{u+1} (wcRingSheaf X ℓ), (P ⟶ M) ≃ M.val.obj (Opposite.op W))
    (hnat : ∀ (M N : SheafOfModules.{u+1} (wcRingSheaf X ℓ)) (ψ : M ⟶ N) (g : P ⟶ M),
