    (hhigh : ∀ k : ℕ, 2 ≤ k → Subsingleton (wcEtCoh Wo.toScheme ℓ k))
    (hfin1 : Finite (wcEtCoh Wo.toScheme ℓ 1))
    (hcard : Nat.card (wcEtCoh Wo.toScheme ℓ 1) ≤ ℓ) :
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf P ℓ)) := HasExt.standard _
