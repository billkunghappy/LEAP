    letI := (φ.appLE U W e).hom.toAlgebra
    haveI : Algebra.Etale _ _ := RingHom.Etale.toAlgebra h
    exact RingHom.quasiFinite_algebraMap.mpr inferInstance
  haveI hd : DiscreteTopology ↑(φ ⁻¹' {φ v}) := (φ.fiberHomeo (φ v)).discreteTopology
  have hv : φ v ∈ ({φ v} : Set B) := Set.mem_singleton _
  have hopen : IsOpen ({⟨v, hv⟩} : Set ↑(φ ⁻¹' {φ v})) := isOpen_discrete _
  obtain ⟨t, ht, hteq⟩ := isOpen_induced_iff.mp hopen
