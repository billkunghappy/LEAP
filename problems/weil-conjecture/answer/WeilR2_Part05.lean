    obtain ⟨z₀, hz₀, huniq⟩ := hl.existsUnique s
    exact ⟨z₀, fun j => hz₀ (Opposite.op j), fun w hw => huniq w (fun j => hw j.unop)⟩

  have sPkg : ∀ {B : Scheme.{u}} (U : B.Opens) (hU : IsAffineOpen U) (Ω : Type u) [Field Ω] (τ : Γ(B, U) →+* Ω) (p : Spec (.of Ω) ⟶ B), Spec.map (CommRingCat.ofHom τ) ≫ hU.fromSpec = p → ∀ (A : Type u) [CommRing A] [IsLocalRing A] (σ : Γ(B, U) →+* A) (ρ : A →+* Ω), IsLocalHom ρ → ρ.comp σ = τ → ∀ (J : Type u) [SmallCategory J] [IsFiltered J] (D : J ⥤ CommRingCat.{u}) (s : ∀ j, Γ(B, U) →+* D.obj j) (β : ∀ j, D.obj j ⟶ CommRingCat.of A), (∀ j, (s j).Etale) → (∀ {j j' : J} (t : j ⟶ j'), (D.map t).hom.comp (s j) = s j') → (∀ {j j' : J} (t : j ⟶ j'), D.map t ≫ β j' = β j) → (∀ j, (β j).hom.comp (s j) = σ) → (∀ (T : Scheme.{u}) (z : ∀ j, T ⟶ Spec (D.obj j)), (∀ {j j' : J} (t : j ⟶ j'), z j' ≫ Spec.map (D.map t) = z j) → ∃! z₀ : T ⟶ Spec (CommRingCat.of A), ∀ j, z₀ ≫ Spec.map (β j) = z j) → (∀ (C : Type u) [CommRing C] [Algebra Γ(B, U) C], Algebra.FinitePresentation Γ(B, U) C → ∀ γ : C →+* A, γ.comp (algebraMap Γ(B, U) C) = σ → ∃ (j : J) (α : C →+* D.obj j), α.comp (algebraMap Γ(B, U) C) = s j ∧ (β j).hom.comp α = γ) → (∀ (j j' : J) (f : D.obj j →+* D.obj j'), f.comp (s j) = s j' → (β j').hom.comp f = (β j).hom → ∃ t : j ⟶ j', (D.map t).hom = f) → (∀ (C : Type u) [CommRing C] [Algebra Γ(B, U) C], Algebra.Etale Γ(B, U) C → ∀ γ₀ : C →+* Ω, γ₀.comp (algebraMap Γ(B, U) C) = τ → ∃ γ : C →+* A, γ.comp (algebraMap Γ(B, U) C) = σ ∧ ρ.comp γ = γ₀) → (∀ (V : B.Etale) (t : Spec (.of Ω) ⟶ V.left), t ≫ V.hom = p → ∃ (C : Type u) (_ : CommRing C) (_ : Algebra Γ(B, U) C) (γ₀ : C →+* Ω) (w : Spec (.of C) ⟶ V.left), Algebra.Etale Γ(B, U) C ∧ γ₀.comp (algebraMap Γ(B, U) C) = τ ∧ Spec.map (CommRingCat.ofHom γ₀) ≫ w = t ∧ w ≫ V.hom = Spec.map (CommRingCat.ofHom (algebraMap Γ(B, U) C)) ≫ hU.fromSpec) → (∀ (j : J) (V : B.Etale) (f f' : Spec (D.obj j) ⟶ V.left), f ≫ V.hom = f' ≫ V.hom → Spec.map (CommRingCat.ofHom (ρ.comp (β j).hom)) ≫ f = Spec.map (CommRingCat.ofHom (ρ.comp (β j).hom)) ≫ f' → ∃ g : D.obj j, ρ ((β j).hom g) ≠ 0 ∧ Spec.map (CommRingCat.ofHom (algebraMap (D.obj j) (Localization.Aw