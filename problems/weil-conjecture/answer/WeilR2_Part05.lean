        have ht : d.hom.left ≫ d.right.hom = p := Over.w d.hom
        obtain ⟨C, _, _, γ₀, w, hC, hγ₀, hγw, hw⟩ := hCHART d.right d.hom.left ht
        obtain ⟨γ, hγσ, hργ⟩ := hHLIFT C hC γ₀ hγ₀
        obtain ⟨j, α, hα, hβα⟩ := hFPL C (by haveI := hC; infer_instance) γ hγσ
        let g : W.obj (Opposite.op j) ⟶ d.right :=
          MorphismProperty.Over.homMk (Spec.map (CommRingCat.ofHom α) ≫ w) (by
            show (Spec.map (CommRingCat.ofHom α) ≫ w) ≫ d.right.hom =
              Spec.map (S j) ≫ hU.fromSpec
            rw [Category.assoc, hw, ← Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp,
              hα]) trivial
        refine ⟨Opposite.op j, ⟨StructuredArrow.homMk g ?_⟩⟩
        apply Over.OverMorphism.ext
        show Spec.map (CommRingCat.ofHom (ρ.comp (β j).hom)) ≫ Spec.map (CommRingCat.ofHom α) ≫ w =
          d.hom.left
        have hc : (ρ.comp (β j).hom).comp α = γ₀ := by
          rw [RingHom.comp_assoc, hβα, hργ]
        rw [← Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp, hc, hγw]
      ·
        intro d c s₁ s₂
        have hff : s₁.right.left ≫ d.right.hom = s₂.right.left ≫ d.right.hom :=
          (MorphismProperty.Over.w s₁.right).trans (MorphismProperty.Over.w s₂.right).symm
        have e1 : Spec.map (CommRingCat.ofHom (ρ.comp (β c.unop).hom)) ≫ s₁.right.left =
            d.hom.left :=
          congrArg (fun k => k.left) (StructuredArrow.w s₁)
        have e2 : Spec.map (CommRingCat.ofHom (ρ.comp (β c.unop).hom)) ≫ s₂.right.left =
            d.hom.left :=
          congrArg (fun k => k.left) (StructuredArrow.w s₂)
        obtain ⟨g, hg0, hgeq⟩ :=
          hAGREE c.unop d.right s₁.right.left s₂.right.left hff (e1.trans e2.symm)
        have hu : IsUnit ((β c.unop).hom g) := isUnit_of_map_unit ρ _ (isUnit_iff_ne_zero.mpr hg0)
        letI : Algebra Γ(B, U) (D.obj c.unop) := (s c.unop).toAlgebra
        haveI : Algebra.Etale Γ(B, U) (D.obj c.unop) := RingHom.etale_algebraMap.mp (hs c.unop)
        haveI : Algebra.FinitePresentation Γ(B, U) (Localization.Away g) :=
          Algebra.FinitePresentation.trans Γ(B, U) (D.obj c.unop) (Localization.Away g)
        have hβ' : (IsLocalization.Away.lift g hu).comp
            (algebraMap Γ(B, U) (Localization.Away g)) = σ := by
          rw [IsScalarTower.algebraMap_eq Γ(B, U) (D.obj c.unop) (Localization.Away g),
            ← RingHom.comp_assoc, IsLocalization.Away.lift_comp]
          exact hβs c.unop
        obtain ⟨j'', α, hα1, hα2⟩ := hFPL (Localization.Away g) inferInstance _ hβ'
        have hf1 : (α.comp (algebraMap (D.obj c.unop) (Localization.Away g))).comp (s c.unop) =
            s j'' := by
          rw [RingHom.comp_assoc]
          rw [← hα1, IsScalarTower.algebraMap_eq Γ(B, U) (D.obj c.unop) (Localization.Away g)]
          rfl
        have hf2 : (β j'').hom.comp (α.comp (algebraMap (D.obj c.unop) (Localization.Away g))) =
            (β c.unop).hom := by
          rw [← RingHom.comp_assoc, hα2, IsLocalization.Away.lift_comp]
        obtain ⟨u, hu'⟩ := hFULL c.unop j'' _ hf1 hf2
        refine ⟨Opposite.op j'', (u.op : Opposite.op j'' ⟶ c), ?_⟩
        apply StructuredArrow.hom_ext
        apply MorphismProperty.Over.Hom.ext
        show Spec.map (D.map u) ≫ s₁.right.left = Spec.map (D.map u) ≫ s₂.right.left
        have hD : D.map u = CommRingCat.ofHom (algebraMap (D.obj c.unop) (Localization.Away g)) ≫
            CommRingCat.ofHom α := by
          rw [← CommRingCat.ofHom_comp, ← hu', CommRingCat.ofHom_hom]
        rw [hD, Spec.map_comp]
        exact (Category.assoc _ _ _).trans
          ((congrArg (fun k => Spec.map (CommRingCat.ofHom α) ≫ k) hgeq).trans
            (Category.assoc _ _ _).symm)
    · intro l
      show IsAffine (Spec (D.obj l.unop))
      infer_instance
    · intro l l' t
      show Spec.map (β l.unop) ≫ Spec.map (D.map t.unop) = Spec.map (β l'.unop)
      rw [← Spec.map_comp, hDβ]
    · intro l
      show Spec.map (β l.unop) ≫ Spec.map (S l.unop) ≫ hU.fromSpec =
        Spec.map (CommRingCat.ofHom σ) ≫ hU.fromSpec
      rw [← Category.assoc, ← Spec.map_comp, hSβ]
    · intro T z hz
      obtain ⟨z₀, hz₀, hu⟩ := hLIM T (fun j => z (Opposite.op j)) (fun {j j'} t => hz t.op)
      exact ⟨z₀, fun l => hz₀ l.unop, fun w hw => hu w (fun j => hw (Opposite.op j))⟩

  intro B b
  obtain ⟨U, hU, hb, -⟩ := exists_isAffineOpen_mem_and_subset (X := B) (x := b) (U := ⊤) trivial
  let τ : Γ(B, U) →+* AlgebraicClosure (B.residueField b) :=
    (algebraMap (B.residueField b) (AlgebraicClosure (B.residueField b))).comp
      (B.presheaf.germ U b hb ≫ B.residue b).hom

  have hp : Spec.map (CommRingCat.ofHom τ) ≫ hU.fromSpec = wcEtGeomPt B b := by
    have h1 : B.fromSpecResidueField b =
        Spec.map (B.residue b) ≫ Spec.map (B.presheaf.germ U b hb) ≫ hU.fromSpec := by
      rw [Scheme.fromSpecResidueField, ← hU.fromSpecStalk_eq_fromSpecStalk hb,
        IsAffineOpen.fromSpecStalk]
    show Spec.map (CommRingCat.ofHom ((algebraMap (B.residueField b)
        (AlgebraicClosure (B.residueField b))).comp (B.presheaf.germ U b hb ≫ B.residue b).hom)) ≫
        hU.fromSpec = Spec.map (CommRingCat.ofHom (algebraMap (B.residueField b)
          (AlgebraicClosure (B.residueField b)))) ≫ B.fromSpecResidueField b
    rw [h1, CommRingCat.ofHom_comp, Spec.map_comp, CommRingCat.ofHom_hom, Spec.map_comp]
    simp only [Category.assoc]
  have hsep : IsSepClosed (IsLocalRing.ResidueField (AlgebraicClosure (B.residueField b))) := by
    haveI := IsAlgClosed.of_ringEquiv (AlgebraicClosure (B.residueField b))
      (IsLocalRing.ResidueField (AlgebraicClosure (B.residueField b)))
      (RingEquiv.ofBijective (IsLocalRing.residue (AlgebraicClosure (B.residueField b)))
        ⟨RingHom.injective _, IsLocalRing.residue_surjective⟩)
    infer_instance
  obtain ⟨A, _, σ, ρ, hAloc, hρσ₀, hAh, hAsep, hρloc, hind⟩ :=
    @wc_strict_hull Γ(B, U) (AlgebraicClosure (B.residueField b)) _ _ τ.toAlgebra _ hsep
  have hρσ : ρ.comp σ = τ := hρσ₀
  obtain ⟨J, _, _, D, s, β, hs, hsD, hDβ, hβs, hsurj, hinj, hFPL, hFULL⟩ := sInd _ A σ hind
  have hLIM := sLim A J D β hDβ hsurj hinj
  have hHLIFT : ∀ (C : Type u) [CommRing C] [Algebra Γ(B, U) C], Algebra.Etale Γ(B, U) C →
      ∀ γ₀ : C →+* AlgebraicClosure (B.residueField b), γ₀.comp (algebraMap Γ(B, U) C) = τ →
      ∃ γ : C →+* A, γ.comp (algebraMap Γ(B, U) C) = σ ∧ ρ.comp γ = γ₀ := by
    intro C _ _ hC γ₀ h
    exact sLift _ A _ σ ρ (sRet A)
      (sRat (IsLocalRing.ResidueField A) _ (IsLocalRing.ResidueField.lift ρ)) C hC γ₀
      (h.trans hρσ.symm)
  have hCHART : ∀ (V : B.Etale) (t : Spec (.of (AlgebraicClosure (B.residueField b))) ⟶ V.left),
      t ≫ V.hom = wcEtGeomPt B b → ∃ (C : Type u) (_ : CommRing C) (_ : Algebra Γ(B, U) C)
      (γ₀ : C →+* AlgebraicClosure (B.residueField b)) (w : Spec (.of C) ⟶ V.left),
      Algebra.Etale Γ(B, U) C ∧ γ₀.comp (algebraMap Γ(B, U) C) = τ ∧
      Spec.map (CommRingCat.ofHom γ₀) ≫ w = t ∧
      w ≫ V.hom = Spec.map (CommRingCat.ofHom (algebraMap Γ(B, U) C)) ≫ hU.fromSpec :=
    fun V t ht => sChart U hU V _ t τ (ht.trans hp.symm)
  have hAGREE : ∀ (j : J) (V : B.Etale) (f f' : Spec (D.obj j) ⟶ V.left),
      f ≫ V.hom = f' ≫ V.hom →
      Spec.map (CommRingCat.ofHom (ρ.comp (β j).hom)) ≫ f =
        Spec.map (CommRingCat.ofHom (ρ.comp (β j).hom)) ≫ f' →
      ∃ g : D.obj j, ρ ((β j).hom g) ≠ 0 ∧
        Spec.map (CommRingCat.ofHom (algebraMap (D.obj j) (Localization.Away g))) ≫ f =
        Spec.map (CommRingCat.ofHom (algebraMap (D.obj j) (Localization.Away g))) ≫ f' := by
    intro j V f f' hff h
    haveI : Etale V.hom := V.prop
    obtain ⟨O, hO, hOf⟩ := wc_etale_maps_agree_near_geom_point V.hom f f' hff _
      (Spec.map (CommRingCat.ofHom (ρ.comp (β j).hom))) h
    exact sBasic (D.obj j) _ (ρ.comp (β j).hom) f f' O hO hOf
  obtain ⟨W', φ, hinit, haff, hφ, hφa, hlim⟩ :=
    sPkg U hU _ τ (wcEtGeomPt B b) hp A σ ρ hρloc hρσ J D s β hs hsD hDβ hβs hLIM hFPL hFULL
      hHLIFT hCHART hAGREE
  haveI : IsCofiltered Jᵒᵖ := isCofiltered_op_of_isFiltered J
  refine ⟨A, inferInstance, hAh, hAsep, Jᵒᵖ, inferInstance, inferInstance, W', φ,
    Spec.map (CommRingCat.ofHom σ) ≫ hU.fromSpec, IsLocalRing.ResidueField.lift ρ,
    hinit, haff, hφ, hφa, hlim, ?_, ?_⟩
  · exact sInt _ A (B.residueField b) _ σ ρ (B.presheaf.germ U b hb ≫ B.residue b).hom hρσ
      (sFrac U hU b hb)
  · have hc : (IsLocalRing.ResidueField.lift ρ).comp ((IsLocalRing.residue A).comp σ) = τ := by
      rw [← RingHom.comp_assoc, IsLocalRing.ResidueField.lift_comp_residue, hρσ]
    rw [← hp, ← hc, CommRingCat.ofHom_comp, CommRingCat.ofHom_comp, Spec.map_comp, Spec.map_comp]
    simp only [Category.assoc]

theorem wc_et_limit_sections_colim_iso : ∀ {S Z : Scheme.{u}} (p : Z ⟶ S) (L : Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1} ⥤ Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}), Nonempty (L ⊣ wcEtPush p) → ∀ (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (D : Λ ⥤ S.Etale) (π : ∀ l, Z ⟶ (D.obj l).left), (∀ l, π l ≫ (D.obj l).hom = p) → (∀ {l l' : Λ} (t : l ⟶ l'), π l ≫ (D.map t).left = π l') → (∀ (T : Scheme.{u}) (z : ∀ l, T ⟶ (D.obj l).left), (∀ {l l' : Λ} (t : l ⟶ l'), z l ≫ (D.map t).left = z l') → ∃! z₀ : T ⟶ Z, ∀ l, z₀ ≫ π l = z l) → (∀ l, CompactSpace (D.obj l).left) → (∀ l, QuasiSeparatedSpace (D.obj l).left) → (∀ {l l' : Λ} (t : l ⟶ l'), IsAffineHom (D.map t).left) → CompactSpace Z → QuasiSeparatedSpace Z → Nonempty ((sheafToPresheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1} ⋙ (Functor.whiskeringLeft Λᵒᵖ (S.Etale)ᵒᵖ AddCommGrpCat.{u+1}).obj D.op ⋙ Limits.colim) ≅ L ⋙ sheafToPresheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1} ⋙ (evaluation (Z.Etale)ᵒᵖ AddCommGrpCat.{u+1}).obj (Opposite.op (Scheme.Etale.mk (𝟙 Z)))) :=
by
  intro S Z p L hadj Λ _ _ D π hπ hπc hlim hcpt hqs haff hZc hZqs

  have crit : ∀ (F : Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1} ⥤ (Λᵒᵖ ⥤ AddCommGrpCat.{u+1}))
      (G : Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1} ⥤ AddCommGrpCat.{u+1})
      (ρ : ∀ (c : Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}) (l : Λ),
        (F.obj c).obj (Opposite.op l) →+ G.obj c),
      (∀ c {l l' : Λ} (t : l ⟶ l') (x : (F.obj c).obj (Opposite.op l')),
        ρ c l (((F.obj c).map t.op).hom x) = ρ c l' x) →
      (∀ {c c'} (f : c ⟶ c') (l : Λ) (x : (F.obj c).obj (Opposite.op l)),
        ρ c' l (((F.map f).app (Opposite.op l)).hom x) = (G.map f).hom (ρ c l x)) →
      (∀ c (s : G.obj c), ∃ (l : Λ) (x : (F.obj c).obj (Opposite.op l)), ρ c l x = s) →
      (∀ c (l : Λ) (x : (F.obj c).obj (Opposite.op l)), ρ c l x = 0 →
        ∃ (l' : Λ) (t : l' ⟶ l), ((F.obj c).map t.op).hom x = 0) →
      Nonempty (F ⋙ Limits.colim ≅ G) := by
    intro F G ρ h1 h2 h3 h4
    haveI : IsFiltered Λᵒᵖ := isFiltered_op_of_isCofiltered Λ
    haveI : Limits.PreservesFilteredColimitsOfSize.{u, u} (forget AddCommGrpCat.{u+1}) :=
      Limits.preservesFilteredColimitsOfSize_shrink.{u, u+1, u, u+1} _
    let κ : ∀ c, Limits.Cocone (F.obj c) := fun c =>
      { pt := G.obj c
        ι := { app := fun j => AddCommGrpCat.ofHom (ρ c j.unop)
               naturality := by
                 intro j j' f
                 ext x
                 have := h1 c f.unop x
                 simpa using this } }
    let δ : ∀ c, Limits.colimit (F.obj c) ⟶ G.obj c := fun c =>
      Limits.colimit.desc (F.obj c) (κ c)
    have hδ : ∀ c (l : Λ) (x : (F.obj c).obj (Opposite.op l)),
        (δ c).hom ((Limits.colimit.ι (F.obj c) (Opposite.op l)).hom x) = ρ c l x := by
      intro c l x
      have := Limits.colimit.ι_desc (κ c) (Opposite.op l)
      have h := congrArg (fun φ => φ.hom x) this
      exact h
    have hiso : ∀ c, IsIso (δ c) := by
      intro c
      rw [ConcreteCategory.isIso_iff_bijective]
      refine ⟨?_, ?_⟩
      · change Function.Injective (δ c).hom
        rw [injective_iff_map_eq_zero]
        intro y hy
        obtain ⟨j, x, rfl⟩ := Limits.Concrete.colimit_exists_rep (F.obj c) y
        induction j with
        | op l =>
          change (δ c).hom ((Limits.colimit.ι (F.obj c) (Opposite.op l)).hom x) = 0 at hy
          rw [hδ] at hy
          obtain ⟨l', t, ht⟩ := h4 c l x hy
          have hw := Limits.colimit.w (F.obj c) t.op
          have h := congrArg (fun φ => φ.hom x) hw
          simp only [AddCommGrpCat.hom_comp, AddMonoidHom.coe_comp, Function.comp_apply] at h
          change (Limits.colimit.ι (F.obj c) (Opposite.op l)).hom x = 0
          rw [← h, ht, map_zero]
      · intro s
        obtain ⟨l, x, rfl⟩ := h3 c s
        exact ⟨(Limits.colimit.ι (F.obj c) (Opposite.op l)).hom x, hδ c l x⟩
    refine ⟨NatIso.ofComponents (fun c => asIso (δ c)) ?_⟩
    intro c c' f
    simp only [asIso_hom]
    apply Limits.colimit.hom_ext
    intro j
    induction j with
    | op l =>
      apply AddCommGrpCat.hom_ext
      ext x
      change (δ c') ((Limits.colimit.ι (F.obj c) (Opposite.op l) ≫ Limits.colim.map (F.map f)).hom x) =
        (G.map f).hom ((δ c).hom ((Limits.colimit.ι (F.obj c) (Opposite.op l)).hom x))
      rw [Limits.colimit.ι_map, hδ]
      simp only [AddCommGrpCat.hom_comp, AddMonoidHom.coe_comp, Function.comp_apply]
      rw [hδ]
      exact h2 f l x

  obtain ⟨ρ, c1, c2, _c3, c4⟩ := wc_et_pullback_sections_colimit p L hadj
  have hπ' : ∀ l, π l ≫ (D.obj l).hom = (Scheme.Etale.mk (𝟙 Z)).hom ≫ p := by
    intro l
    rw [hπ l]
    exact (Category.id_comp p).symm
  obtain ⟨hsurj, hinj⟩ := c4 (Scheme.Etale.mk (𝟙 Z)) Λ D π hπ' hπc hlim hcpt hqs haff hZc hZqs
  have key : ∀ (G : Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}) (l' : Λ)
      (x : G.obj.obj (Opposite.op (D.obj l'))) (β : Z ⟶ (D.obj l').left) (hβ : β = π l')
      (h₁ : β ≫ (D.obj l').hom = (Scheme.Etale.mk (𝟙 Z)).hom ≫ p),
      ρ G (Scheme.Etale.mk (𝟙 Z)) (D.obj l') β h₁ x =
        ρ G (Scheme.Etale.mk (𝟙 Z)) (D.obj l') (π l') (hπ' l') x := by
    rintro G l' x β rfl h₁
    rfl
  exact crit (sheafToPresheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1} ⋙
      (Functor.whiskeringLeft Λᵒᵖ (S.Etale)ᵒᵖ AddCommGrpCat.{u+1}).obj D.op)
    (L ⋙ sheafToPresheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1} ⋙
      (evaluation (Z.Etale)ᵒᵖ AddCommGrpCat.{u+1}).obj (Opposite.op (Scheme.Etale.mk (𝟙 Z))))
    (fun G l => ρ G (Scheme.Etale.mk (𝟙 Z)) (D.obj l) (π l) (hπ' l))
    (fun G l l' t x => by
      have hα' : (π l ≫ (D.map t).left) ≫ (D.obj l').hom = (Scheme.Etale.mk (𝟙 Z)).hom ≫ p := by
        rw [hπc t]; exact hπ' l'
      have e := c2 G (Scheme.Etale.mk (𝟙 Z)) (D.obj l) (D.obj l') (D.map t) (π l) (hπ' l) hα' x
      exact e.symm.trans (key G l' x _ (hπc t) hα'))
    (fun {G G'} ψ l x => c1 G G' ψ (Scheme.Etale.mk (𝟙 Z)) (D.obj l) (π l) (hπ' l) x)
    (fun G s => hsurj G s)
    (fun G l x hx => hinj G l x hx)

theorem wc_et_sections_coyoneda_iso : ∀ (Y : Scheme.{u}) (T₀ : Y.Etale), Limits.IsTerminal T₀ → Nonempty ((sheafToPresheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1} ⋙ (evaluation (Y.Etale)ᵒᵖ AddCommGrpCat.{u+1}).obj (Opposite.op T₀)) ≅ preadditiveCoyoneda.obj (Opposite.op ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))))) :=
by
  intro Y T₀ hT
  let adj := constantSheafAdj (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1} hT
  let ev : ∀ X : AddCommGrpCat.{u+1}, (AddCommGrpCat.of (ULift.{u+1} ℤ) ⟶ X) ≃+ X := fun X =>
    { toFun := fun φ => φ.hom (ULift.up 1)
      invFun := fun x => AddCommGrpCat.ofHom
        ((zmultiplesHom X x).comp (AddEquiv.ulift : ULift.{u+1} ℤ ≃+ ℤ).toAddMonoidHom)
      left_inv := fun φ => by
        apply AddCommGrpCat.hom_ext
        apply AddMonoidHom.ext
        rintro ⟨n⟩
        have hn : (ULift.up n : ULift.{u+1} ℤ) = n • (ULift.up 1 : ULift.{u+1} ℤ) := by
          apply ULift.ext
          simp
        change (zmultiplesHom X (φ.hom (ULift.up 1))) n = φ.hom (ULift.up n)
        rw [zmultiplesHom_apply, hn, map_zsmul]
      right_inv := fun x => by
        change (zmultiplesHom X x) (1 : ℤ) = x
        rw [zmultiplesHom_apply, one_zsmul]
      map_add' := fun φ ψ => rfl }
  let E : ∀ M : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1},
      ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ)) ⟶ M) ≃+ M.obj.obj (Opposite.op T₀) := fun M =>
    (adj.homAddEquiv (AddCommGrpCat.of (ULift.{u+1} ℤ)) M).trans (ev (M.obj.obj (Opposite.op T₀)))
  have hnat : ∀ (M M' : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (ψ : M ⟶ M')
      (g : (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ)) ⟶ M),
      E M' (g ≫ ψ) = (ψ.hom.app (Opposite.op T₀)).hom (E M g) := by
    intro M M' ψ g
    simp only [E, AddEquiv.trans_apply, Adjunction.homAddEquiv_apply,
      Adjunction.homEquiv_naturality_right]
    rfl
  let P := (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
    (AddCommGrpCat.of (ULift.{u+1} ℤ))
  let Γ := sheafToPresheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1} ⋙
    (evaluation (Y.Etale)ᵒᵖ AddCommGrpCat.{u+1}).obj (Opposite.op T₀)
  let c : ∀ M, (preadditiveCoyoneda.obj (Opposite.op P)).obj M ≅ Γ.obj M := fun M =>
    @AddEquiv.toAddCommGrpIso ((preadditiveCoyoneda.obj (Opposite.op P)).obj M) (Γ.obj M) (E M)
  refine ⟨(NatIso.ofComponents c (fun {M M'} ψ => ?_)).symm⟩
  apply AddCommGrpCat.hom_ext
  apply AddMonoidHom.ext
  intro g
  exact hnat M M' ψ g

theorem wc_ext_acyclic_resolution_homology : ∀ {D : Type*} [Category D] [Abelian D] (P : D) (K : CochainComplex D ℕ), letI := HasExt.standard D; (∀ n : ℕ, K.ExactAt (n + 1)) → (∀ n k : ℕ, Subsingleton (Abelian.Ext P (K.X n) (k + 1))) → ∀ q : ℕ, Nonempty ((((preadditiveCoyoneda.obj (Opposite.op P)).mapHomologicalComplex (ComplexShape.up ℕ)).obj K).homology q ≃ Abelian.Ext P (K.homology 0) q) :=
by
  intro D _ _ P K
  letI := HasExt.standard D
  intro hex hacyc q

  have hG : ∀ (i j k : ℕ) (hi : (ComplexShape.up ℕ).prev j = i)
      (hk : (ComplexShape.up ℕ).next j = k) (Y : D) (r : ℕ)
      (δ : (P ⟶ K.cycles j) →+ Abelian.Ext P Y r), Function.Surjective δ →
      (∀ y, δ y = 0 ↔ ∃ x : P ⟶ K.X i, x ≫ K.d i j = y ≫ K.iCycles j) →
      Nonempty ((((preadditiveCoyoneda.obj (Opposite.op P)).mapHomologicalComplex
        (ComplexShape.up ℕ)).obj K).homology j ≃ Abelian.Ext P Y r) := by
    intro i j k hi hk Y r δ hδ hker
    let C := ((preadditiveCoyoneda.obj (Opposite.op P)).mapHomologicalComplex
      (ComplexShape.up ℕ)).obj K
    let T := C.sc' i j k
    let e1 : C.homology j ≃+ T.homology :=
      (C.homologyIsoSc' i j k hi hk).addCommGroupIsoToAddEquiv
    let e2 : T.homology ≃+ (T.g.hom.ker ⧸ T.abToCycles.range) :=
      T.abHomologyIso.addCommGroupIsoToAddEquiv
    have hmem : ∀ z : P ⟶ K.cycles j, (z ≫ K.iCycles j : T.X₂) ∈ T.g.hom.ker := by
      intro z
      change (z ≫ K.iCycles j) ≫ K.d j k = 0
      simp
    let Φ : (P ⟶ K.cycles j) →+ T.g.hom.ker :=
      AddMonoidHom.mk' (fun z => ⟨(z ≫ K.iCycles j : T.X₂), hmem z⟩) (by
        intro a b
        apply Subtype.ext
        change (a + b) ≫ K.iCycles j = a ≫ K.iCycles j + b ≫ K.iCycles j
        exact Preadditive.add_comp _ _ _ _ _ _)
    have hΦ : Function.Bijective Φ := by
      constructor
      · intro a b hab
        have h1 : a ≫ K.iCycles j = b ≫ K.iCycles j := congrArg Subtype.val hab
        exact (cancel_mono (K.iCycles j)).mp h1
      · intro v
        have hv : (show P ⟶ K.X j from v.1) ≫ K.d j k = 0 := v.2
        refine ⟨K.liftCycles (show P ⟶ K.X j from v.1) k hk hv, ?_⟩
        apply Subtype.ext
        exact K.liftCycles_i _ _ _ _
    let Φe := AddEquiv.ofBijective Φ hΦ
    let θ : T.g.hom.ker →+ Abelian.Ext P Y r := δ.comp Φe.symm.toAddMonoidHom
    have hθ : Function.Surjective θ := by
      intro m
      obtain ⟨y, rfl⟩ := hδ m
      refine ⟨Φe y, ?_⟩
      simp [θ]
    have hrange : T.abToCycles.range = θ.ker := by
      ext v
      rw [AddMonoidHom.mem_range, AddMonoidHom.mem_ker]
      have hv : Φ (Φe.symm v) = v := Φe.apply_symm_apply v
      have h2 : (Φe.symm v) ≫ K.iCycles j = (show P ⟶ K.X j from v.1) :=
        congrArg Subtype.val hv
      change _ ↔ δ (Φe.symm v) = 0
      rw [hker]
      constructor
      · rintro ⟨x, hx⟩
        refine ⟨x, ?_⟩
        have h1 : x ≫ K.d i j = (show P ⟶ K.X j from v.1) := congrArg Subtype.val hx
        rw [h1, h2]
      · rintro ⟨x, hx⟩
        refine ⟨x, ?_⟩
        apply Subtype.ext
        change x ≫ K.d i j = (show P ⟶ K.X j from v.1)
        rw [hx, h2]
    exact ⟨(e1.trans (e2.trans ((QuotientAddGroup.quotientAddEquivOfEq hrange).trans
      (QuotientAddGroup.quotientKerEquivOfSurjective θ hθ)))).toEquiv⟩

  have hw : ∀ n : ℕ, K.iCycles n ≫ K.toCycles n (n + 1) = 0 := by
    intro n
    rw [← cancel_mono (K.iCycles (n + 1)), Category.assoc, K.toCycles_i, K.iCycles_d,
      Limits.zero_comp]
  have hSE : ∀ n : ℕ, (ShortComplex.mk (K.iCycles n) (K.toCycles n (n + 1)) (hw n)).ShortExact := by
    intro n
    have hex' := (K.exactAt_iff' n (n + 1) (n + 1 + 1) (CochainComplex.prev_nat_succ n)
      (CochainComplex.next ℕ (n + 1))).mp (hex n)
    have hepi : Epi (K.toCycles n (n + 1)) := by
      have h1 : Epi (K.toCycles n (n + 1) ≫ (K.cyclesIsoSc' n (n + 1) (n + 1 + 1)
          (CochainComplex.prev_nat_succ n) (CochainComplex.next ℕ (n + 1))).hom) := by
        rw [K.toCycles_cyclesIsoSc'_hom]
        exact hex'.epi_toCycles
      exact (epi_comp_iff_of_isIso _ _).mp h1
    have hlim : Limits.IsLimit (Limits.KernelFork.ofι (K.iCycles n) (hw n)) :=
      Limits.KernelFork.IsLimit.ofι _ _
        (fun g' hg' => K.liftCycles g' (n + 1) (CochainComplex.next ℕ n) (by
          rw [← K.toCycles_i n (n + 1), ← Category.assoc, hg', Limits.zero_comp]))
        (fun g' hg' => K.liftCycles_i _ _ _ _)
        (fun g' hg' m hm => by
          rw [← cancel_mono (K.iCycles n), hm, K.liftCycles_i])
    exact ShortComplex.ShortExact.mk' (ShortComplex.exact_of_f_is_kernel _ hlim) inferInstance hepi

  let e := CochainComplex.isoHomologyπ₀ K
  have hE : ∀ r : ℕ, Nonempty (Abelian.Ext P (K.cycles 0) r ≃ Abelian.Ext P (K.homology 0) r) :=
    fun r =>
    ⟨{ toFun := fun x => x.comp (Abelian.Ext.mk₀ e.hom) (add_zero r)
       invFun := fun y => y.comp (Abelian.Ext.mk₀ e.inv) (add_zero r)
       left_inv := fun x => by
         simp only
         rw [Abelian.Ext.comp_assoc _ _ _ (add_zero r) (add_zero 0) (by omega),
           Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
       right_inv := fun y => by
         simp only
         rw [Abelian.Ext.comp_assoc _ _ _ (add_zero r) (add_zero 0) (by omega),
           Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.comp_mk₀_id] }⟩

  have hs2 : ∀ (S : ShortComplex D) (hS : S.ShortExact),
      (∀ k : ℕ, Subsingleton (Abelian.Ext P S.X₂ (k + 1))) → ∀ j : ℕ,
      Nonempty (Abelian.Ext P S.X₃ (j + 1) ≃ Abelian.Ext P S.X₁ (j + 1 + 1)) := by
    intro S hS hS2 j
    let δ : Abelian.Ext P S.X₃ (j + 1) →+ Abelian.Ext P S.X₁ (j + 1 + 1) :=
      hS.extClass.postcomp P rfl
    have hδ : Function.Bijective δ := by
      constructor
      · rw [injective_iff_map_eq_zero]
        intro x hx
        obtain ⟨x₂, hx₂⟩ := Abelian.Ext.covariant_sequence_exact₃ P hS x rfl hx
        have h0 : x₂ = 0 := @Subsingleton.elim _ (hS2 j) _ _
        rw [← hx₂, h0, Abelian.Ext.zero_comp]
      · intro y
        have h0 : y.comp (Abelian.Ext.mk₀ S.f) (add_zero _) = 0 :=
          @Subsingleton.elim _ (hS2 (j + 1)) _ _
        obtain ⟨x₃, hx₃⟩ := Abelian.Ext.covariant_sequence_exact₁ P hS y h0 (n₀ := j + 1) rfl
        exact ⟨x₃, hx₃⟩
    exact ⟨Equiv.ofBijective δ hδ⟩

  have hT : ∀ m j a : ℕ, a = j + 1 + m →
      Nonempty (Abelian.Ext P (K.cycles m) (j + 1) ≃ Abelian.Ext P (K.cycles 0) a) := by
    intro m
    induction m with
    | zero => intro j a ha; subst ha; exact ⟨Equiv.refl _⟩
    | succ m ih =>
      intro j a ha
      obtain ⟨e1⟩ := hs2 _ (hSE m) (hacyc m) j
      obtain ⟨e2⟩ := ih (j + 1) a (by omega)
      exact ⟨e1.trans e2⟩

  cases q with
  | zero =>
    let δ : (P ⟶ K.cycles 0) →+ Abelian.Ext P (K.homology 0) 0 :=
      AddMonoidHom.mk' (fun y => Abelian.Ext.mk₀ (y ≫ e.hom)) (by
        intro a b
        rw [Preadditive.add_comp, Abelian.Ext.mk₀_add])
    have hinj : ∀ y : P ⟶ K.cycles 0, δ y = 0 → y = 0 := by
      intro y hy
      have h1 : Abelian.Ext.mk₀ (y ≫ e.hom) = Abelian.Ext.mk₀ (0 : P ⟶ K.homology 0) := by
        rw [Abelian.Ext.mk₀_zero]; exact hy
      rw [← Abelian.Ext.homEquiv₀_symm_apply, ← Abelian.Ext.homEquiv₀_symm_apply] at h1
      have h2 : y ≫ e.hom = 0 := Abelian.Ext.homEquiv₀.symm.injective h1
      rw [← cancel_mono e.hom, h2, Limits.zero_comp]
    refine hG 0 0 1 CochainComplex.prev_nat_zero (CochainComplex.next ℕ 0) _ _ δ ?_ ?_
    · intro z
      refine ⟨Abelian.Ext.homEquiv₀ z ≫ e.inv, ?_⟩
      change Abelian.Ext.mk₀ ((Abelian.Ext.homEquiv₀ z ≫ e.inv) ≫ e.hom) = z
      rw [Category.assoc, Iso.inv_hom_id, Category.comp_id, Abelian.Ext.mk₀_homEquiv₀_apply]
    · intro y
      constructor
      · intro hy
        rw [hinj y hy]
        exact ⟨0, by simp⟩
      · rintro ⟨x, hx⟩
        have hd : K.d 0 0 = 0 := K.shape 0 0 (by simp)
        rw [hd, Limits.comp_zero] at hx
        have hy : y = 0 := by
          rw [← cancel_mono (K.iCycles 0), ← hx, Limits.zero_comp]
        rw [hy, map_zero]
  | succ q =>
    let S := ShortComplex.mk (K.iCycles q) (K.toCycles q (q + 1)) (hw q)
    have hS : S.ShortExact := hSE q
    let δ : (P ⟶ K.cycles (q + 1)) →+ Abelian.Ext P (K.cycles q) 1 :=
      AddMonoidHom.mk' (fun y => (Abelian.Ext.mk₀ y).comp hS.extClass (zero_add 1)) (by
        intro a b
        rw [Abelian.Ext.mk₀_add, Abelian.Ext.add_comp])
    have hδs : Function.Surjective δ := by
      intro y
      have h0 : y.comp (Abelian.Ext.mk₀ S.f) (add_zero 1) = 0 :=
        @Subsingleton.elim _ (hacyc q 0) _ _
      obtain ⟨x₃, hx₃⟩ := Abelian.Ext.covariant_sequence_exact₁ P hS y h0 (n₀ := 0) (zero_add 1)
      refine ⟨Abelian.Ext.homEquiv₀ x₃, ?_⟩
      change (Abelian.Ext.mk₀ (Abelian.Ext.homEquiv₀ x₃)).comp hS.extClass (zero_add 1) = y
      rw [Abelian.Ext.mk₀_homEquiv₀_apply]
      exact hx₃
    have hδk : ∀ y, δ y = 0 ↔ ∃ x : P ⟶ K.X q, x ≫ K.d q (q + 1) = y ≫ K.iCycles (q + 1) := by
      intro y
      constructor
      · intro hy
        obtain ⟨x₂, hx₂⟩ :=
          Abelian.Ext.covariant_sequence_exact₃ P hS (Abelian.Ext.mk₀ y) (zero_add 1) hy
        refine ⟨Abelian.Ext.homEquiv₀ x₂, ?_⟩
        rw [← Abelian.Ext.mk₀_homEquiv₀_apply x₂, Abelian.Ext.mk₀_comp_mk₀] at hx₂
        rw [← Abelian.Ext.homEquiv₀_symm_apply, ← Abelian.Ext.homEquiv₀_symm_apply] at hx₂
        have h2 := Abelian.Ext.homEquiv₀.symm.injective hx₂
        rw [← K.toCycles_i q (q + 1), ← Category.assoc]
        change (Abelian.Ext.homEquiv₀ x₂ ≫ S.g) ≫ _ = _
        rw [h2]
      · rintro ⟨x, hx⟩
        have h1 : x ≫ S.g = y := by
          rw [← cancel_mono (K.iCycles (q + 1)), ← hx]
          change (x ≫ K.toCycles q (q + 1)) ≫ _ = _
          rw [Category.assoc, K.toCycles_i]
        change (Abelian.Ext.mk₀ y).comp hS.extClass (zero_add 1) = 0
        rw [← h1, ← Abelian.Ext.mk₀_comp_mk₀,
          Abelian.Ext.comp_assoc _ _ _ (add_zero 0) (zero_add 1) (by omega), hS.comp_extClass,
          Abelian.Ext.comp_zero]
    obtain ⟨e1⟩ := hG q (q + 1) (q + 1 + 1) (CochainComplex.prev_nat_succ q)
      (CochainComplex.next ℕ (q + 1)) _ _ δ hδs hδk
    obtain ⟨e2⟩ := hT q 0 (q + 1) (by omega)
    obtain ⟨e3⟩ := hE (q + 1)
    exact ⟨e1.trans (e2.trans e3)⟩

theorem wc_et_left_adjoint_const_zmod : ∀ {Y Z : Scheme.{u}} (L : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1} ⥤ Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) [L.Additive] [Limits.PreservesFiniteColimits L], Nonempty (L.obj ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) ≅ (constantSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) → ∀ m : ℕ, Nonempty (L.obj ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) ≅ (constantSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) :=
by
  intro Y Z L _ _ ⟨e⟩ m
  let A := AddCommGrpCat.of (ULift.{u+1} ℤ)
  let Q := AddCommGrpCat.of (ULift.{u+1} (ZMod m))
  let f : A ⟶ A := ((m : ℤ)) • 𝟙 A
  let ψ : ULift.{u+1} ℤ →+ ULift.{u+1} (ZMod m) :=
    (AddEquiv.ulift.symm.toAddMonoidHom.comp (Int.castAddHom (ZMod m))).comp
      AddEquiv.ulift.toAddMonoidHom
  have hψ : ∀ x, ψ x = ULift.up ((x.down : ℤ) : ZMod m) := fun x => rfl
  let p : A ⟶ Q := AddCommGrpCat.ofHom ψ
  have hf : ∀ x, f.hom x = (m : ℤ) • x := fun x => rfl
  have w : f ≫ p = 0 := by
    apply AddCommGrpCat.ext
    intro x
    change ψ (f.hom x) = 0
    rw [hf, hψ]
    apply ULift.ext
    change (((((m : ℤ) • x).down : ℤ)) : ZMod m) = 0
    rw [ULift.smul_down]
    simp
  have hepi : Epi p := by
    rw [AddCommGrpCat.epi_iff_surjective]
    intro y
    obtain ⟨z, hz⟩ := ZMod.intCast_surjective y.down
    exact ⟨ULift.up z, by change ψ _ = _; rw [hψ]; exact ULift.ext _ _ hz⟩
  have hc : Limits.IsColimit (Limits.CokernelCofork.ofπ p w) := by
    refine Limits.CokernelCofork.IsColimit.ofπ' p w (fun {B} k hk => ?_)
    let κ : ℤ →+ B := k.hom.comp AddEquiv.ulift.symm.toAddMonoidHom
    have hκ : κ ((m : ℕ) : ℤ) = 0 := by
      have h1 : (f ≫ k).hom (ULift.up 1) = 0 := by rw [hk]; rfl
      change k.hom (ULift.up ((m : ℕ) : ℤ)) = 0
      rw [← h1]
      change _ = k.hom (f.hom (ULift.up 1))
      rw [hf]
      congr 1
      apply ULift.ext
      change ((m : ℕ) : ℤ) = ((m : ℤ) • ULift.up.{u+1} (1 : ℤ)).down
      rw [ULift.smul_down]
      simp
    refine ⟨AddCommGrpCat.ofHom ((ZMod.lift m ⟨κ, hκ⟩).comp AddEquiv.ulift.toAddMonoidHom), ?_⟩
    ext x
    change (ZMod.lift m ⟨κ, hκ⟩) ((x.down : ℤ) : ZMod m) = k.hom x
    rw [ZMod.lift_coe]
    rfl
  let φ : Limits.cokernel f ≅ Q :=
    Limits.IsColimit.coconePointUniqueUpToIso (Limits.cokernelIsCokernel f) hc
  have key : ∀ (G : AddCommGrpCat.{u+1} ⥤ Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1})
      [G.Additive] [Limits.PreservesFiniteColimits G],
      Nonempty (G.obj Q ≅ Limits.cokernel ((m : ℤ) • 𝟙 (G.obj A))) := by
    intro G _ _
    have h1 : G.map f = (m : ℤ) • 𝟙 (G.obj A) := by
      rw [CategoryTheory.Functor.map_zsmul, CategoryTheory.Functor.map_id]
    exact ⟨G.mapIso φ.symm ≪≫ Limits.PreservesCokernel.iso G f ≪≫
      Limits.cokernel.mapIso _ _ (Iso.refl _) (Iso.refl _) (by rw [h1]; simp)⟩
  obtain ⟨α⟩ := key (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1} ⋙ L)
  obtain ⟨β⟩ := key (constantSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1})
  have hδ : ((m : ℤ) • 𝟙 _) ≫ e.hom = e.hom ≫ ((m : ℤ) • 𝟙 _) := by
    rw [Preadditive.zsmul_comp, Preadditive.comp_zsmul, Category.id_comp, Category.comp_id]
  exact ⟨α ≪≫ Limits.cokernel.mapIso _ _ e e hδ ≪≫ β.symm⟩

theorem wc_et_limit_push_homology : ∀ {X B : Scheme.{u}} (g : X ⟶ B) [IsProper g] (A : Type u) [CommRing A] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W : Λ ⥤ B.Etale) (φ : ∀ l, Spec (.of A) ⟶ (W.obj l).left) (a : Spec (.of A) ⟶ B), (∀ l, IsAffine (W.obj l).left) → (∀ {l l' : Λ} (t : l ⟶ l'), φ l ≫ (W.map t).left = φ l') → (∀ l, φ l ≫ (W.obj l).hom = a) → (∀ (T : Scheme.{u}) (z : ∀ l, T ⟶ (W.obj l).left), (∀ {l l' : Λ} (t : l ⟶ l'), z l ≫ (W.map t).left = z l') → ∃! z₀ : T ⟶ Spec (.of A), ∀ l, z₀ ≫ φ l = z l) → ∀ (m : ℕ) (I : InjectiveResolution ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))) (q : ℕ), Nonempty ((((sheafToPresheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1} ⋙ (Functor.whiskeringLeft (B.Etale)ᵒᵖ (X.Etale)ᵒᵖ AddCommGrpCat.{u+1}).obj (@Functor.op B.Etale _ X.Etale _ (wcEtBaseChange g)) ⋙ (Functor.whiskeringLeft Λᵒᵖ (B.Etale)ᵒᵖ AddCommGrpCat.{u+1}).obj W.op ⋙ Limits.colim).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q ≃ wcEtCoh (Limits.pullback g a) m q) :=
by
  intro X B g _ A _ Λ _ _ W φ a haff hφ hφa hlim m I q

  obtain ⟨π, hπ, hπc, hπlim, hcpt, hqs, htaff, hZc, hZqs, hZsep⟩ :=
    wc_et_baseChange_limit_presentation g A Λ W φ a haff hφ hφa hlim (Limits.pullback g a)
      (Limits.pullback.fst g a) (Limits.pullback.snd g a) (IsPullback.of_hasPullback g a)

  obtain ⟨L, ⟨adj⟩, hPFL, ⟨eℤ⟩⟩ := wc_et_push_left_adjoint (Limits.pullback.fst g a)
  haveI := hPFL
  haveI : L.Additive := adj.left_adjoint_additive
  haveI : Limits.PreservesColimitsOfSize.{0, 0} L := adj.leftAdjoint_preservesColimits
  haveI : Limits.PreservesFiniteColimits L := inferInstance
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology (Limits.pullback g a)) AddCommGrpCat.{u+1}) :=
    HasExt.standard _

  obtain ⟨hH⟩ := wc_et_limit_sections_colim_iso (Limits.pullback.fst g a) L ⟨adj⟩ Λ
    (W ⋙ wcEtBaseChange g) π hπ hπc hπlim hcpt hqs htaff hZc hZqs

  have hT : Limits.IsTerminal (Scheme.Etale.mk (𝟙 (Limits.pullback g a))) :=
    Limits.IsTerminal.ofUniqueHom (fun V => MorphismProperty.Over.homMk V.hom)
      (fun V m => MorphismProperty.Over.Hom.ext
        ((Category.comp_id m.left).symm.trans (MorphismProperty.Over.w m)))
  obtain ⟨hS⟩ := wc_et_sections_coyoneda_iso (Limits.pullback g a) _ hT
  let P := (constantSheaf (Scheme.smallEtaleTopology (Limits.pullback g a))
    AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))
  let K := (L.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex

  have hex : ∀ n : ℕ, K.ExactAt (n + 1) := by
    intro n
    rw [HomologicalComplex.exactAt_iff' K n (n + 1) (n + 1 + 1) (CochainComplex.prev_nat_succ n)
      (CochainComplex.next ℕ (n + 1))]
    exact (I.exact_succ n).map L
  have hι0 : L.map (I.ι.f 0) ≫ L.map (I.cocomplex.d 0 1) = 0 := by
    rw [← L.map_comp, InjectiveResolution.ι_f_zero_comp_complex_d, L.map_zero]
  haveI : Mono (L.map (I.ι.f 0)) := L.map_mono _
  have h₀ : Limits.IsLimit (Limits.KernelFork.ofι (L.map (I.ι.f 0)) hι0) := by
    let S0 := ShortComplex.mk (I.ι.f 0) (I.cocomplex.d 0 1)
      (by rw [InjectiveResolution.ι_f_zero_comp_complex_d])
    have hE : (S0.map L).Exact := I.exact₀.map L
    haveI : Mono (S0.map L).f := (inferInstance : Mono (L.map (I.ι.f 0)))
    exact hE.fIsKernel
  let e₀ := (CochainComplex.isoHomologyπ₀ K).symm ≪≫
    Limits.IsLimit.conePointUniqueUpToIso (K.cyclesIsKernel 0 1 (CochainComplex.next ℕ 0)) h₀ ≪≫
    L.mapIso (HomologicalComplex.singleObjXSelf (ComplexShape.up ℕ) 0
      ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))))

  have hacyc : ∀ n k : ℕ, Subsingleton (Abelian.Ext P (K.X n) (k + 1)) := by
    intro n k
    haveI := I.injective n
    exact wc_et_pullback_injective_limit_acyclic (Limits.pullback.fst g a) L ⟨adj⟩ Λ
      (W ⋙ wcEtBaseChange g) π hπ hπc hπlim hcpt hqs htaff hZc hZqs hZsep (I.cocomplex.X n) k

  obtain ⟨E₂⟩ := wc_ext_acyclic_resolution_homology P K hex hacyc q

  obtain ⟨eΛ⟩ := wc_et_left_adjoint_const_zmod L ⟨eℤ⟩ m
  let e := e₀ ≪≫ eΛ
  let E₃ : Abelian.Ext P (K.homology 0) q ≃ Abelian.Ext P
      ((constantSheaf (Scheme.smallEtaleTopology (Limits.pullback g a)) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) q :=
    { toFun := fun x => x.comp (Abelian.Ext.mk₀ e.hom) (add_zero q)
      invFun := fun y => y.comp (Abelian.Ext.mk₀ e.inv) (add_zero q)
      left_inv := fun x => by
        simp only
        rw [Abelian.Ext.comp_assoc _ _ _ (add_zero q) (add_zero 0) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
      right_inv := fun y => by
        simp only
        rw [Abelian.Ext.comp_assoc _ _ _ (add_zero q) (add_zero 0) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.comp_mk₀_id] }

  let iso := (NatIso.mapHomologicalComplex (hH ≪≫ Functor.isoWhiskerLeft L hS)
      (ComplexShape.up ℕ)).app I.cocomplex ≪≫
    ((Functor.mapHomologicalComplexCompIso
      (Iso.refl (L ⋙ preadditiveCoyoneda.obj (Opposite.op P))) (ComplexShape.up ℕ)).app
        I.cocomplex).symm
  exact ⟨((HomologicalComplex.homologyMapIso iso q).addCommGroupIsoToAddEquiv.toEquiv).trans
    (E₂.trans E₃)⟩

theorem wc_et_henselian_closed_fibre_coh : ∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (Y₀ : Scheme.{u}) (f : Y₀ ⟶ Spec (.of A)) [IsProper f] (m : ℕ), m ≠ 0 → (∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (Y₀ : Scheme.{u}) (f : Y₀ ⟶ Spec (.of A)) [IsProper f] (m' : ℕ), m' ≠ 0 → ∀ S : Set (Spec (.of A)), IsOpen S → S ≠ Set.univ → ∀ q' : ℕ, Subsingleton (wcEtExt Y₀ (wcEtExtZero Y₀ (f ⁻¹' S) m') q')) → ∀ q : ℕ, Nonempty (wcEtCoh Y₀ m q ≃ wcEtCoh (Limits.pullback f (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)))) m q) :=
by
  intro A _ _ _ Y₀ f _ m hm hPBC q
  classical
  set r : Spec (.of (IsLocalRing.ResidueField A)) ⟶ Spec (.of A) :=
    Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)) with hr
  haveI hrci : IsClosedImmersion r :=
    IsClosedImmersion.spec_of_surjective _ IsLocalRing.residue_surjective
  have hrange : ∀ x : Spec (.of A), x ∈ Set.range r ↔ x = IsLocalRing.closedPoint A := by
    intro x
    have hpt : ∀ y : Spec (.of (IsLocalRing.ResidueField A)), r y = IsLocalRing.closedPoint A := by
      intro y
      rw [hr, Spec.map_base]
      exact IsLocalRing.PrimeSpectrum.comap_residue A y
    constructor
    · rintro ⟨y, rfl⟩
      exact hpt y
    · intro hx
      obtain ⟨y⟩ : Nonempty (PrimeSpectrum (IsLocalRing.ResidueField A)) := inferInstance
      exact ⟨y, (hpt y).trans hx.symm⟩
  have hset : (Set.range (Limits.pullback.fst f r))ᶜ =
      f ⁻¹' ({IsLocalRing.closedPoint A}ᶜ : Set (Spec (.of A))) := by
    ext x
    rw [Set.mem_compl_iff, Scheme.Pullback.range_fst, Set.mem_preimage, hrange]
    exact Iff.rfl
  have hSo : IsOpen ({IsLocalRing.closedPoint A}ᶜ : Set (Spec (.of A))) :=
    (IsLocalRing.isClosed_singleton_closedPoint A).isOpen_compl
  have hSne : ({IsLocalRing.closedPoint A}ᶜ : Set (Spec (.of A))) ≠ Set.univ := by
    intro h
    have hc : IsLocalRing.closedPoint A ∈ ({IsLocalRing.closedPoint A}ᶜ : Set (Spec (.of A))) := by
      rw [h]; trivial
    exact hc rfl
  have hvan := hPBC A Y₀ f m hm _ hSo hSne
  rw [← hset] at hvan
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y₀) AddCommGrpCat.{u+1}) := HasExt.standard _
  let j := wcEtExtZeroι Y₀ (Set.range (Limits.pullback.fst f r))ᶜ m
  have key : ∀ {P Q : (Scheme.Etale Y₀)ᵒᵖ ⥤ AddCommGrpCat.{u+1}} (α : P ⟶ Q),
      (∀ V, Function.Injective (ConcreteCategory.hom (α.app V))) →
      Mono ((presheafToSheaf (Scheme.smallEtaleTopology Y₀) AddCommGrpCat.{u+1}).map α) := by
    intro P Q α hα
    haveI : ∀ V, Mono (α.app V) := fun V => (AddCommGrpCat.mono_iff_injective _).2 (hα V)
    haveI : Mono α := NatTrans.mono_of_mono_app α
    infer_instance
  have hmono : Mono j := key _ (fun V => Subtype.val_injective)
  let P := (constantSheaf (Scheme.smallEtaleTopology Y₀) AddCommGrpCat.{u+1}).obj
    (AddCommGrpCat.of (ULift.{u+1} ℤ))
  let Sc : ShortComplex (Sheaf (Scheme.smallEtaleTopology Y₀) AddCommGrpCat.{u+1}) :=
    ShortComplex.mk j (Limits.cokernel.π j) (Limits.cokernel.condition j)
  have hS : Sc.ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel j) hmono inferInstance
  have hsub : ∀ n, Subsingleton (Abelian.Ext P Sc.X₁ n) := fun n => hvan n
  have hbij : Function.Bijective
      (fun x : Abelian.Ext P Sc.X₂ q => x.comp (Abelian.Ext.mk₀ Sc.g) (add_zero q)) := by
    constructor
    · intro x y hxy
      have h0 : (x - y).comp (Abelian.Ext.mk₀ Sc.g) (add_zero q) = 0 := by
        change ((Abelian.Ext.mk₀ Sc.g).postcomp P (add_zero q)) (x - y) = 0
        rw [map_sub]
        exact sub_eq_zero.mpr hxy
      obtain ⟨x₁, hx₁⟩ := Abelian.Ext.covariant_sequence_exact₂ P hS (x - y) h0
      have h1 : x₁ = 0 := Subsingleton.elim _ _
      rw [h1, Abelian.Ext.zero_comp] at hx₁
      exact sub_eq_zero.mp hx₁.symm
    · intro y
      have hz : y.comp hS.extClass (rfl : q + 1 = q + 1) = 0 := Subsingleton.elim _ _
      obtain ⟨x₂, hx₂⟩ := Abelian.Ext.covariant_sequence_exact₃ P hS y rfl hz
      exact ⟨x₂, hx₂⟩
  obtain ⟨E₂⟩ := wc_et_closed_complement_coh Y₀ (Limits.pullback f r) (Limits.pullback.fst f r) m q
  exact ⟨(Equiv.ofBijective _ hbij).trans E₂⟩

theorem wc_et_push_const_of_homeomorph : ∀ {Y Y' : Scheme.{u}} (π : Y' ⟶ Y), (∀ V : Y.Etale, IsHomeomorph (Limits.pullback.fst V.hom π)) → ∀ (m : ℕ), (∀ (V : Y'.Etale) (a : ULift.{u+1} (ZMod m)), ((toSheafify (Scheme.smallEtaleTopology Y') ((Functor.const (Y'.Etale)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))).app (Opposite.op V)).hom a = 0 → a = 0 ∨ IsEmpty V.left) → (∀ (U : Y'.Etale) (s : ((constantSheaf (Scheme.smallEtaleTopology Y') AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))).obj.obj (Opposite.op U)) (x : U.left), ∃ (O : Set U.left) (a : ULift.{u+1} (ZMod m)), IsOpen O ∧ x ∈ O ∧ ∀ (V : Y'.Etale) (e : V ⟶ U), Set.range e.left ⊆ O → (((constantSheaf (Scheme.smallEtaleTopology Y') AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))).obj.map e.op).hom s = ((toSheafify (Scheme.smallEtaleTopology Y') ((Functor.const (Y'.Etale)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))).app (Opposite.op V)).hom a) → Nonempty ((wcEtPush π).obj ((constantSheaf (Scheme.smallEtaleTopology Y') AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) ≅ (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) :=
by
  intro Y Y' π hπ m hF1 hF2

  have hcov : ∀ (V : Y.Etale) (S : Sieve V), (∀ v : V.left, ∃ (V₁ : Y.Etale) (c : V₁ ⟶ V),
      S.arrows c ∧ v ∈ Set.range c.left) → S ∈ Scheme.smallEtaleTopology Y V := by
    intro V S hS
    change S ∈ Scheme.smallGrothendieckTopology @Etale Y V
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
    apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
    intro x
    obtain ⟨V₁, c, hc, y, hy⟩ := hS x
    have hw : c.left ≫ V.hom = V₁.hom := MorphismProperty.Over.w c
    have hEt : Etale c.left := by
      have h1 : Etale V.hom := V.prop
      have h2 : Etale (c.left ≫ V.hom) := by rw [hw]; exact V₁.prop
      exact Etale.of_comp c.left V.hom
    exact ⟨V₁, c, y, hc, hEt, hy⟩
  let α := Functor.whiskerLeft (wcEtBaseChange π).op (toSheafify (Scheme.smallEtaleTopology Y')
    ((Functor.const (Y'.Etale)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))))

  haveI hinj : Presheaf.IsLocallyInjective (Scheme.smallEtaleTopology Y) α := by
    apply Presheaf.IsLocallyInjective.mk
    intro X x y hxy
    have hxy' : (α.app X).hom x = (α.app X).hom y := hxy
    have h0 : (α.app X).hom (x - y) = 0 := by
      rw [map_sub]; exact sub_eq_zero.mpr hxy'
    rcases hF1 ((wcEtBaseChange π).obj X.unop) (x - y) h0 with h | h
    · have hxy2 : x = y := sub_eq_zero.mp h
      subst hxy2
      rw [Presheaf.equalizerSieve_self_eq_top]
      exact (Scheme.smallEtaleTopology Y).top_mem _
    · apply hcov
      intro v
      obtain ⟨w, -⟩ := (hπ X.unop).surjective v
      exact (h.false w).elim

  haveI hsurj : Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology Y) α := by
    apply Presheaf.IsLocallySurjective.mk
    intro U t
    apply hcov
    intro v
    have hU := hπ U
    obtain ⟨x, hx⟩ := hU.surjective v
    obtain ⟨O, a, hO, hxO, hag⟩ := hF2 ((wcEtBaseChange π).obj U) t x
    let W₁ : U.left.Opens := ⟨(Limits.pullback.fst U.hom π) '' O, hU.isOpenMap O hO⟩
    have hW₁ : Set.range W₁.ι = (W₁ : Set U.left) := Scheme.Opens.range_ι W₁
    refine ⟨wcEtOpen Y U W₁, wcEtOpenι Y U W₁, ?_, ?_⟩
    · rw [Presheaf.imageSieve_apply]
      refine ⟨a, ?_⟩
      have hN : ((wcEtBaseChange π).map (wcEtOpenι Y U W₁)).left ≫ Limits.pullback.fst U.hom π =
          Limits.pullback.fst (wcEtOpen Y U W₁).hom π ≫ (wcEtOpenι Y U W₁).left :=
        Limits.pullback.lift_fst _ _ _
      have hrange : Set.range ((wcEtBaseChange π).map (wcEtOpenι Y U W₁)).left ⊆ O := by
        rintro _ ⟨z, rfl⟩
        have h1 : Limits.pullback.fst U.hom π
            (((wcEtBaseChange π).map (wcEtOpenι Y U W₁)).left z) =
            (wcEtOpenι Y U W₁).left (Limits.pullback.fst (wcEtOpen Y U W₁).hom π z) := by
          have hz := congrArg (fun φ : ((wcEtBaseChange π).obj (wcEtOpen Y U W₁)).left ⟶ U.left =>
            φ z) hN
          exact (Scheme.Hom.comp_apply _ _ z).symm.trans (hz.trans (Scheme.Hom.comp_apply _ _ z))
        have h2' : (wcEtOpenι Y U W₁).left (Limits.pullback.fst (wcEtOpen Y U W₁).hom π z) ∈
            Set.range W₁.ι := ⟨_, rfl⟩
        have h2 : (wcEtOpenι Y U W₁).left (Limits.pullback.fst (wcEtOpen Y U W₁).hom π z) ∈
            (Limits.pullback.fst U.hom π) '' O := by
          rw [hW₁] at h2'
          exact h2'
        obtain ⟨o, ho, heq⟩ := h2
        have hoeq : o = ((wcEtBaseChange π).map (wcEtOpenι Y U W₁)).left z :=
          hU.injective (heq.trans h1.symm)
        exact hoeq ▸ ho
      exact (hag _ _ hrange).symm
    · change v ∈ Set.range W₁.ι
      rw [hW₁]
      exact ⟨x, hxO, hx⟩
  haveI : IsIso ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map α) :=
    (GrothendieckTopology.W_iff (Scheme.smallEtaleTopology Y) α).mp
      (GrothendieckTopology.W_of_isLocallyBijective (Scheme.smallEtaleTopology Y) α)
  exact ⟨(asIso ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map α)).symm⟩

theorem wc_et_coh_purely_inseparable_invariance : ∀ (k K : Type u) [Field k] [Field K] [Algebra k K] [IsSepClosed k], (algebraMap k K).IsIntegral → ∀ (Y : Scheme.{u}) (f : Y ⟶ Spec (.of k)) (m q : ℕ), Nonempty (wcEtCoh (Limits.pullback f (Spec.map (CommRingCat.ofHom (algebraMap k K)))) m q ≃ wcEtCoh Y m q) :=
by
  intro k K _ _ _ _ hint Y f m q
  classical


  have key : ∀ {Y' : Scheme.{u}} (π : Y' ⟶ Y) [IsIntegralHom π],
      (∀ V : Y.Etale, IsHomeomorph (Limits.pullback.fst V.hom π)) →
      Nonempty (wcEtCoh Y' m q ≃ wcEtCoh Y m q) := by
    intro Y' π _ hV
    obtain ⟨L, ⟨adj⟩, hL, ⟨e⟩⟩ := wc_et_push_left_adjoint π
    haveI := hL
    haveI : Limits.PreservesFiniteColimits (wcEtPush π) := wc_et_integral_push_exact π
    haveI : Limits.PreservesFiniteLimits (wcEtPush π) := by
      have : Limits.PreservesLimitsOfSize.{0, 0} (wcEtPush π) := adj.rightAdjoint_preservesLimits
      infer_instance
    haveI := wc_et_enough_injectives Y'
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y') AddCommGrpCat.{u+1}) := HasExt.standard _
    obtain ⟨E⟩ := wc_et_push_const_of_homeomorph π hV m (wc_et_const_sheaf_local_form Y' m).1
      (wc_et_const_sheaf_local_form Y' m).2
    have B := wc_ext_adjoint_transfer L (wcEtPush π) adj
      ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ)))
      ((constantSheaf (Scheme.smallEtaleTopology Y') AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) q
    show Nonempty (Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y') AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ)))
        ((constantSheaf (Scheme.smallEtaleTopology Y') AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) q ≃
      Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ)))
        ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) q)
    refine ⟨Equiv.trans ?_ ((Equiv.ofBijective _ B).trans ?_)⟩
    · exact
        { toFun := fun y => (Abelian.Ext.mk₀ e.hom).comp y (zero_add q)
          invFun := fun y => (Abelian.Ext.mk₀ e.inv).comp y (zero_add q)
          left_inv := fun y => by
            simp only [Abelian.Ext.mk₀_comp_mk₀_assoc, Iso.inv_hom_id, Abelian.Ext.mk₀_id_comp]
          right_inv := fun y => by
            simp only [Abelian.Ext.mk₀_comp_mk₀_assoc, Iso.hom_inv_id, Abelian.Ext.mk₀_id_comp] }
    · exact
        { toFun := fun x => x.comp (Abelian.Ext.mk₀ E.hom) (add_zero q)
          invFun := fun x => x.comp (Abelian.Ext.mk₀ E.inv) (add_zero q)
          left_inv := fun x => by
            simp only
            rw [Abelian.Ext.comp_assoc _ _ _ (add_zero q) (add_zero 0) (by omega),
              Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
          right_inv := fun x => by
            simp only
            rw [Abelian.Ext.comp_assoc _ _ _ (add_zero q) (add_zero 0) (by omega),
              Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.comp_mk₀_id] }

  haveI : Algebra.IsIntegral k K := ⟨hint⟩
  haveI : Algebra.IsAlgebraic k K := Algebra.IsIntegral.isAlgebraic
  haveI : IsPurelyInseparable k K := Algebra.IsAlgebraic.isPurelyInseparable_of_isSepClosed
  haveI hsint : IsIntegralHom (Spec.map (CommRingCat.ofHom (algebraMap k K))) :=
    IsIntegralHom.SpecMap_iff.mpr hint

  have hsinj : UniversallyInjective (Spec.map (CommRingCat.ofHom (algebraMap k K))) := by
    rw [universallyInjective_eq_diagonal]
    change Surjective (Limits.pullback.diagonal (Spec.map (CommRingCat.ofHom (algebraMap k K))))
    have h1 : Subsingleton (PrimeSpectrum (TensorProduct k K K)) :=
      (PrimeSpectrum.isHomeomorph_comap_of_isPurelyInseparable k K K).injective.subsingleton
    haveI : Subsingleton ↥(Spec (CommRingCat.of (TensorProduct k K K))) := h1
    haveI : Subsingleton ↥(Limits.pullback (Spec.map (CommRingCat.ofHom (algebraMap k K)))
        (Spec.map (CommRingCat.ofHom (algebraMap k K)))) :=
      (Scheme.homeoOfIso (pullbackSpecIso k K K)).injective.subsingleton
    obtain ⟨x⟩ : Nonempty (PrimeSpectrum K) := inferInstance
    exact ⟨fun z => ⟨x, Subsingleton.elim _ _⟩⟩

  have hhomeo : ∀ (T : Scheme.{u}) (h : T ⟶ Spec (.of k)),
      IsHomeomorph (Limits.pullback.fst h (Spec.map (CommRingCat.ofHom (algebraMap k K)))) := by
    intro T h
    haveI : UniversallyInjective (Limits.pullback.fst h
        (Spec.map (CommRingCat.ofHom (algebraMap k K)))) :=
      MorphismProperty.of_isPullback (P := @UniversallyInjective)
        (IsPullback.of_hasPullback h _).flip hsinj
    rw [isHomeomorph_iff_continuous_isClosedMap_bijective]
    exact ⟨Scheme.Hom.continuous _, Scheme.Hom.isClosedMap _,
      Scheme.Hom.injective _, Scheme.Hom.surjective _⟩

  have hV : ∀ V : Y.Etale, IsHomeomorph (Limits.pullback.fst V.hom
      (Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap k K))))) := by
    intro V
    have e : ⇑(Limits.pullback.fst V.hom
        (Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap k K))))) =
        ⇑(Limits.pullback.fst (V.hom ≫ f) (Spec.map (CommRingCat.ofHom (algebraMap k K)))) ∘
          ⇑(Scheme.homeoOfIso (Limits.pullbackRightPullbackFstIso f
            (Spec.map (CommRingCat.ofHom (algebraMap k K))) V.hom)) := by
      funext z
      rw [Function.comp_apply]
      change _ = ((Limits.pullbackRightPullbackFstIso f
            (Spec.map (CommRingCat.ofHom (algebraMap k K))) V.hom).hom ≫
          Limits.pullback.fst (V.hom ≫ f) (Spec.map (CommRingCat.ofHom (algebraMap k K)))) z
      rw [Limits.pullbackRightPullbackFstIso_hom_fst]
    rw [e]
    exact (hhomeo V.left (V.hom ≫ f)).comp (Homeomorph.isHomeomorph _)
  exact key _ hV

theorem wc_et_coh_iso_invariance : ∀ {Y Z : Scheme.{u}} (i : Z ⟶ Y) [IsIso i] (m q : ℕ), Nonempty (wcEtCoh Y m q ≃ wcEtCoh Z m q) :=
by
  intro Y Z i _ m q

  have hS : ∀ y : Y, y ∉ (Set.range i)ᶜ := fun y hy => hy (i.surjective y)

  have hz : Limits.IsZero (wcEtExtZero Y (Set.range i)ᶜ m) := by
    have key : ∀ (G : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})
        (η₁ η₂ : wcEtExtZeroPre Y (Set.range i)ᶜ m ⟶
          (sheafToPresheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj G),
        η₁ = η₂ := by
      intro G η₁ η₂
      apply NatTrans.ext'
      funext V
      by_cases hV : Nonempty V.unop.left
      · obtain ⟨x₀⟩ := hV
        have hp : ¬ (∀ x, V.unop.hom x ∈ (Set.range i)ᶜ) := fun h => hS _ (h x₀)
        have hbot : wcSuppSub.{u} m (∀ x, V.unop.hom x ∈ (Set.range i)ᶜ) = ⊥ := by
          unfold wcSuppSub
          exact iSup_neg hp
        have hall : ∀ s : ULift.{u+1} (ZMod m),
            s ∈ wcSuppSub.{u} m (∀ x, V.unop.hom x ∈ (Set.range i)ᶜ) → s = 0 := by
          rw [hbot]
          intro s hs
          exact AddSubgroup.mem_bot.mp hs
        have hsub : Subsingleton (wcSuppSub.{u} m (∀ x, V.unop.hom x ∈ (Set.range i)ᶜ)) := by
          constructor
          intro a b
          apply Subtype.ext
          rw [hall _ a.2, hall _ b.2]
        exact (@AddCommGrpCat.isZero_of_subsingleton ((wcEtExtZeroPre Y (Set.range i)ᶜ m).obj V)
          hsub).eq_of_src _ _
      · have hbotc : (⊥ : Sieve V.unop) ∈ Scheme.smallEtaleTopology Y V.unop :=
          wc_etale_jointly_surjective_covers Y V.unop ⊥ (fun v => (hV ⟨v⟩).elim)
        exact (Sheaf.isTerminalOfBotCover G V.unop hbotc).hom_ext _ _
    rw [Limits.IsZero.iff_id_eq_zero]
    show 𝟙 ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
      (wcEtExtZeroPre Y (Set.range i)ᶜ m)) = 0
    apply ((sheafificationAdjunction (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).homEquiv
      _ _).injective
    exact key _ _ _

  have hι : wcEtExtZeroι Y (Set.range i)ᶜ m = 0 := hz.eq_of_src _ _
  let e := Limits.cokernelIsoOfEq hι ≪≫ Limits.cokernelZeroIsoTarget

  letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
  let P := (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
    (AddCommGrpCat.of (ULift.{u+1} ℤ))
  let E₁ : Abelian.Ext P (Limits.cokernel (wcEtExtZeroι Y (Set.range i)ᶜ m)) q ≃
      Abelian.Ext P ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) q :=
    { toFun := fun x => x.comp (Abelian.Ext.mk₀ e.hom) (add_zero q)
      invFun := fun y => y.comp (Abelian.Ext.mk₀ e.inv) (add_zero q)
      left_inv := fun x => by
        simp only
        rw [Abelian.Ext.comp_assoc _ _ _ (add_zero q) (add_zero 0) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
      right_inv := fun y => by
        simp only
        rw [Abelian.Ext.comp_assoc _ _ _ (add_zero q) (add_zero 0) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.comp_mk₀_id] }

  obtain ⟨E₂⟩ := wc_et_closed_complement_coh Y Z i m q
  exact ⟨E₁.symm.trans E₂⟩

theorem wc_et_proper_stalk_coh : ∀ {X B : Scheme.{u}} (g : X ⟶ B) [IsProper g] (m : ℕ), m ≠ 0 → (∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (Y₀ : Scheme.{u}) (f : Y₀ ⟶ Spec (.of A)) [IsProper f] (m' : ℕ), m' ≠ 0 → ∀ S : Set (Spec (.of A)), IsOpen S → S ≠ Set.univ → ∀ q' : ℕ, Subsingleton (wcEtExt Y₀ (wcEtExtZero Y₀ (f ⁻¹' S) m') q')) → ∀ (I : InjectiveResolution ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))) (b : B) (q : ℕ), Nonempty ((wcEtStalk B b).obj ((((wcEtPush g).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q) ≃ wcEtCoh (Limits.pullback g (wcEtGeomPt B b)) m q) :=
by
  intro X B g _ m hm hPBC I b q
  obtain ⟨A, _, _, _, Λ, _, _, W', φ, a, e, hinit, haff, hφ, hφa, hlim, he, hpt⟩ :=
    wc_et_geom_strict_henselization b
  obtain ⟨E₁⟩ := wc_et_stalk_push_homology g b Λ W' hinit I.cocomplex q
  obtain ⟨E₂⟩ := wc_et_limit_push_homology g A Λ
    (W' ⋙ StructuredArrow.proj (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B)) φ a
    haff hφ hφa hlim m I q
  obtain ⟨E₃⟩ := wc_et_henselian_closed_fibre_coh A (Limits.pullback g a)
    (Limits.pullback.snd g a) m hm hPBC q
  letI : Algebra (IsLocalRing.ResidueField A) (AlgebraicClosure (B.residueField b)) := e.toAlgebra
  obtain ⟨E₄⟩ := wc_et_coh_purely_inseparable_invariance (IsLocalRing.ResidueField A)
    (AlgebraicClosure (B.residueField b)) he
    (Limits.pullback (Limits.pullback.snd g a) (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A))))
    (Limits.pullback.snd (Limits.pullback.snd g a) (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A))))
    m q
  have h1 := IsPullback.of_hasPullback
    (Limits.pullback.snd (Limits.pullback.snd g a) (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A))))
    (Spec.map (CommRingCat.ofHom (algebraMap (IsLocalRing.ResidueField A)
      (AlgebraicClosure (B.residueField b)))))
  have h2 := IsPullback.of_hasPullback (Limits.pullback.snd g a)
    (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)))
  have h3 := IsPullback.of_hasPullback g a
  have h123 := (h1.paste_horiz h2).paste_horiz h3
  have hpt' : (Spec.map (CommRingCat.ofHom (algebraMap (IsLocalRing.ResidueField A)
      (AlgebraicClosure (B.residueField b)))) ≫
      Spec.map (CommRingCat.ofHom (IsLocalRing.residue A))) ≫ a = wcEtGeomPt B b := by
    rw [Category.assoc]
    exact hpt
  let ι := h123.isoPullback ≪≫ Limits.pullback.congrHom rfl hpt'
  obtain ⟨E₅⟩ := wc_et_coh_iso_invariance ι.hom m q
  exact ⟨E₁.trans (E₂.trans (E₃.trans (E₄.symm.trans E₅.symm)))⟩

theorem wc_et_geomstalk_cofiltered : ∀ (B : Scheme.{u}) (b : B), (∀ {P E S : Scheme.{u}} (e : E ⟶ S) [Etale e] (a₁ a₂ : P ⟶ E), a₁ ≫ e = a₂ ≫ e → ∀ (Ω : Type u) [Field Ω] (π : Spec (.of Ω) ⟶ P), π ≫ a₁ = π ≫ a₂ → ∃ U : P.Opens, π (IsLocalRing.closedPoint Ω) ∈ U ∧ U.ι ≫ a₁ = U.ι ≫ a₂) → IsCofiltered (StructuredArrow (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B)) :=
