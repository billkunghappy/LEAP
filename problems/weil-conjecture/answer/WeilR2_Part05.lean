      ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel u') inferInstance inferInstance

    have hz : ∀ x : Abelian.Ext P0 G' q, x = 0 := by
      intro x
      have hx : x.comp (Abelian.Ext.mk₀ u') (add_zero q) = 0 := Subsingleton.elim _ _
      cases q with
      | zero =>
        obtain ⟨φ, rfl⟩ : ∃ φ, Abelian.Ext.mk₀ φ = x := ⟨_, Abelian.Ext.mk₀_homEquiv₀_apply x⟩
        have hx' : Abelian.Ext.mk₀ (φ ≫ u') = Abelian.Ext.mk₀ (0 : P0 ⟶ K.homology 0) := by
          rw [← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_zero]
