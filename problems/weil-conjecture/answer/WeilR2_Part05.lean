  haveI : TopologicalSpace.NoetherianSpace
      (Limits.widePullback B (fun _ : Fin N => Z) (fun _ => p) : Scheme.{u}) :=
    IsNoetherian.noetherianSpace

  obtain ⟨e, he⟩ := wc_fnp_push_const_sections_lc B Z p ℓ

  have h5 := wc_fnp_subobject_sections B ((wcEtPush p).obj ((constantSheaf
    (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))))
  have tnat : ∀ {A A' : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}} (φ : A ⟶ A')
      {V W : B.Etale} (f : W ⟶ V) (x : A.obj.obj (Opposite.op V)),
      (A'.obj.map f.op).hom ((φ.hom.app (Opposite.op V)).hom x) =
        (φ.hom.app (Opposite.op W)).hom ((A.obj.map f.op).hom x) := by
    intro A A' φ V W f x
