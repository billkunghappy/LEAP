    rw [hmap]
    exact ⟨ψ z, (Scheme.Hom.comp_apply ψ m z).symm.trans (by rw [hψ]; exact hz)⟩
  haveI hcont : (wcEtBaseChange i).IsContinuous (Scheme.smallEtaleTopology X)
