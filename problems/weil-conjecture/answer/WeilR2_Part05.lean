                Limits.pullback.condition y) := (hβ T' y).symm
        _ = ((toSheafify (Scheme.smallEtaleTopology X) P).app (Opposite.op T')).hom
              ((P.map c.op).hom t) :=
            congrArg (fun w => ((toSheafify (Scheme.smallEtaleTopology X) P).app
              (Opposite.op T')).hom w) hy.symm
