    have hy2 := (wc_fnp_relation_locus_geom_point p ℓ N I c Ω (vb ≫ V.hom)
      (fun i => (z i).1) (fun i => (z i).2)).1 (hsep c hy) V vb rfl f hf
    exact hNK hy2

theorem wc_et_finite_push_const_noetherian : ∀ (K : Type u) [Field K] (B : Scheme.{u}) (fB : B ⟶ Spec (.of K)) [IsProper fB] (Z : Scheme.{u}) (p : Z ⟶ B) [IsFinite p] (ℓ : ℕ), ℓ.Prime → IsNoetherianObject ((wcEtPush p).obj ((constantSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))))) :=
