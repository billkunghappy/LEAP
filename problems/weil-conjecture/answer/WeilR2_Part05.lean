theorem wc_chart_closed_immersion_of_surj : ∀ (Y Y' V P : Scheme.{u}) (π : Y' ⟶ Y) (g : Y' ⟶ P) (δ : V ⟶ Y') (U : Y.Opens) (C : P.Opens) [IsSeparated g], DenseRange δ → (δ ≫ π) ⁻¹ᵁ U = ⊤ → IsAffineOpen C → IsAffineOpen (π ⁻¹ᵁ U ⊓ g ⁻¹ᵁ C) → (∀ t : Γ(Y', π ⁻¹ᵁ U ⊓ g ⁻¹ᵁ C), ∃ c : Γ(P, C), (Y'.presheaf.map (homOfLE (inf_le_right : π ⁻¹ᵁ U ⊓ g ⁻¹ᵁ C ≤ g ⁻¹ᵁ C)).op).hom (g.app C c) = t) → IsClosedImmersion (g ∣_ C) :=
by
  intro Y Y' V P π g δ U C _ hd hU hC hA hS
  set V₀ : Y'.Opens := π ⁻¹ᵁ U ⊓ g ⁻¹ᵁ C with hV₀def
  have hV : V₀ ≤ g ⁻¹ᵁ C := inf_le_right
  haveI : IsAffine (C : Scheme.{u}) := hC
  haveI : IsAffine (V₀ : Scheme.{u}) := hA

  have key : Function.Surjective (ConcreteCategory.hom (g.appLE C V₀ hV)) := by
    intro t
    obtain ⟨c, hc⟩ := hS t
    exact ⟨c, hc⟩
  have h1 : IsClosedImmersion (Y'.homOfLE hV ≫ g ∣_ C) := by
    apply IsClosedImmersion.of_surjective_of_isAffine
    show Function.Surjective (ConcreteCategory.hom ((g.resLE C V₀ hV).app ⊤))
    rw [Scheme.Hom.app_eq_appLE, Scheme.Hom.resLE_appLE]
    refine (Scheme.Hom.appLE_congr g _ (Scheme.Opens.ι_image_top C) ?_
      (fun f => Function.Surjective (ConcreteCategory.hom f))).mpr key
    rw [Scheme.Hom.preimage_top, Scheme.Opens.ι_image_top]

  haveI := h1
  haveI h0 : IsClosedImmersion (Y'.homOfLE hV) := IsClosedImmersion.of_comp _ (g ∣_ C)

  have hGV : g ⁻¹ᵁ C ≤ V₀ := by
    intro y hy
    by_contra hyV
    have hclosed : IsClosed (Set.range (Y'.homOfLE hV)) :=
      (Y'.homOfLE hV).isClosedEmbedding.isClosed_range
    have hrange : ∀ x : (g ⁻¹ᵁ C : Scheme.{u}),
        x ∈ Set.range (Y'.homOfLE hV) ↔ x.1 ∈ V₀ := by
      intro x
      constructor
      · rintro ⟨z, rfl⟩
        exact (congrArg (· ∈ V₀) (Scheme.homOfLE_apply hV z)).mpr z.2
      · intro hx
        exact ⟨⟨x.val, hx⟩, Subtype.ext (Scheme.homOfLE_apply hV _)⟩
    have hO : IsOpen (Subtype.val '' (Set.range (Y'.homOfLE hV))ᶜ : Set Y') :=
      (g ⁻¹ᵁ C).isOpen.isOpenMap_subtype_val _ hclosed.isOpen_compl
    have hyO : y ∈ (Subtype.val '' (Set.range (Y'.homOfLE hV))ᶜ : Set Y') :=
      ⟨⟨y, hy⟩, fun h => hyV ((hrange _).mp h), rfl⟩
    obtain ⟨z, hzO, v, rfl⟩ := Dense.inter_open_nonempty hd _ hO ⟨y, hyO⟩
    obtain ⟨w, hw, hwz⟩ := hzO
    apply hw
    refine (hrange w).mpr ?_
    have hv : v ∈ (δ ≫ π) ⁻¹ᵁ U := by rw [hU]; trivial
    rw [Scheme.Hom.mem_preimage, Scheme.Hom.comp_apply] at hv
    have hwG : w.1 ∈ g ⁻¹ᵁ C := w.2
    have hwz' : w.1 = δ v := hwz
    rw [hwz'] at hwG ⊢
    exact ⟨hv, hwG⟩

  haveI hiso : IsIso (Y'.homOfLE hGV) :=
    ⟨⟨Y'.homOfLE hV, by rw [Scheme.homOfLE_homOfLE, Scheme.homOfLE_rfl],
      by rw [Scheme.homOfLE_homOfLE, Scheme.homOfLE_rfl]⟩⟩
  have hfac : g ∣_ C = Y'.homOfLE hGV ≫ (Y'.homOfLE hV ≫ g ∣_ C) := by
    rw [← Category.assoc, Scheme.homOfLE_homOfLE, Scheme.homOfLE_rfl, Category.id_comp]
  rw [hfac]
  infer_instance

theorem wc_closed_in_product_chart_gen : ∀ (S X Y Y' : Scheme.{u}) [IsAffine S] (f : X ⟶ S) (g : Y ⟶ S) (ι : Y' ⟶ Limits.pullback f g) [IsClosedImmersion ι] (U : X.Opens) (C : Y.Opens), IsAffineOpen U → IsAffineOpen C → IsAffineOpen ((ι ≫ Limits.pullback.fst f g) ⁻¹ᵁ U ⊓ (ι ≫ Limits.pullback.snd f g) ⁻¹ᵁ C) ∧ ∀ t : Γ(Y', (ι ≫ Limits.pullback.fst f g) ⁻¹ᵁ U ⊓ (ι ≫ Limits.pullback.snd f g) ⁻¹ᵁ C), t ∈ Subring.closure (Set.range ((Y'.presheaf.map (homOfLE (inf_le_left : (ι ≫ Limits.pullback.fst f g) ⁻¹ᵁ U ⊓ (ι ≫ Limits.pullback.snd f g) ⁻¹ᵁ C ≤ (ι ≫ Limits.pullback.fst f g) ⁻¹ᵁ U)).op).hom.comp ((ι ≫ Limits.pullback.fst f g).app U).hom) ∪ Set.range ((Y'.presheaf.map (homOfLE (inf_le_right : (ι ≫ Limits.pullback.fst f g) ⁻¹ᵁ U ⊓ (ι ≫ Limits.pullback.snd f g) ⁻¹ᵁ C ≤ (ι ≫ Limits.pullback.snd f g) ⁻¹ᵁ C)).op).hom.comp ((ι ≫ Limits.pullback.snd f g).app C).hom)) :=
by
  intro S X Y Y' _ f g ι _ U C hU hC

  have s2 : ∀ (R A B P : CommRingCat.{u}) (f : R ⟶ A) (g : R ⟶ B) (inl : A ⟶ P) (inr : B ⟶ P),
      IsPushout f g inl inr → ∀ x : P, x ∈ Subring.closure (Set.range inl.hom ∪ Set.range inr.hom) := by
    intro R A B P f g inl inr hP x
    let S := Subring.closure (Set.range inl.hom ∪ Set.range inr.hom)
    let inl' : A ⟶ CommRingCat.of S := CommRingCat.ofHom (RingHom.codRestrict inl.hom S
      (fun a => Subring.subset_closure (Or.inl ⟨a, rfl⟩)))
    let inr' : B ⟶ CommRingCat.of S := CommRingCat.ofHom (RingHom.codRestrict inr.hom S
      (fun b => Subring.subset_closure (Or.inr ⟨b, rfl⟩)))
    have hw : f ≫ inl' = g ≫ inr' := by
      ext y
      exact ConcreteCategory.congr_hom hP.w y
    let d := hP.desc inl' inr' hw
    have hε : d ≫ CommRingCat.ofHom S.subtype = 𝟙 P := by
      apply hP.hom_ext
      · rw [Category.comp_id, ← Category.assoc, hP.inl_desc]
        ext a
        rfl
      · rw [Category.comp_id, ← Category.assoc, hP.inr_desc]
        ext a
        rfl
    have hx : (S.subtype (d x)) = x := by
      have := ConcreteCategory.congr_hom hε x
      exact this
    rw [← hx]
    exact (d x).property

  have s3 : ∀ (X Y : Scheme.{u}) (f : X ⟶ Y) (U : Y.Opens) (V : X.Opens) (e : V ≤ f ⁻¹ᵁ U),
      (f.resLE U V e).appTop ≫ V.topIso.hom = U.topIso.hom ≫ f.appLE U V e := by
    intro X Y f U V e
    rw [Scheme.Hom.appTop, Scheme.Hom.app_eq_appLE, Scheme.Hom.resLE_appLE,
      Scheme.Opens.topIso_hom, Scheme.Opens.topIso_hom]
    erw [Scheme.Hom.appLE_map, Scheme.Hom.map_appLE]

  have hP : IsPullback
      ((Limits.pullback.fst f g).resLE U ((Limits.pullback.fst f g) ⁻¹ᵁ U ⊓
        (Limits.pullback.snd f g) ⁻¹ᵁ C) inf_le_left)
      ((Limits.pullback.snd f g).resLE C ((Limits.pullback.fst f g) ⁻¹ᵁ U ⊓
        (Limits.pullback.snd f g) ⁻¹ᵁ C) inf_le_right)
      (U.ι ≫ f) (C.ι ≫ g) := by
    have comm : (Limits.pullback.fst f g).resLE U ((Limits.pullback.fst f g) ⁻¹ᵁ U ⊓
        (Limits.pullback.snd f g) ⁻¹ᵁ C) inf_le_left ≫ (U.ι ≫ f) =
        (Limits.pullback.snd f g).resLE C ((Limits.pullback.fst f g) ⁻¹ᵁ U ⊓
        (Limits.pullback.snd f g) ⁻¹ᵁ C) inf_le_right ≫ (C.ι ≫ g) := by
      rw [← Category.assoc, Scheme.Hom.resLE_comp_ι, ← Category.assoc, Scheme.Hom.resLE_comp_ι,
        Category.assoc, Category.assoc, Limits.pullback.condition]
    have hc : ∀ (s : Limits.PullbackCone (U.ι ≫ f) (C.ι ≫ g)),
        (s.fst ≫ U.ι) ≫ f = (s.snd ≫ C.ι) ≫ g := by
      intro s
      rw [Category.assoc, Category.assoc]
      exact s.condition
    have hrange : ∀ (s : Limits.PullbackCone (U.ι ≫ f) (C.ι ≫ g)),
        Set.range (Limits.pullback.lift (s.fst ≫ U.ι) (s.snd ≫ C.ι) (hc s)) ⊆
          Set.range ((Limits.pullback.fst f g) ⁻¹ᵁ U ⊓ (Limits.pullback.snd f g) ⁻¹ᵁ C).ι := by
      intro s
      rw [Scheme.Opens.range_ι]
      rintro _ ⟨x, rfl⟩
      refine ⟨?_, ?_⟩
      · show (Limits.pullback.fst f g) (Limits.pullback.lift (s.fst ≫ U.ι) (s.snd ≫ C.ι) (hc s) x) ∈ U
        rw [← Scheme.Hom.comp_apply, Limits.pullback.lift_fst, Scheme.Hom.comp_apply]
        have h : U.ι (s.fst x) ∈ Set.range U.ι := ⟨_, rfl⟩
        rwa [Scheme.Opens.range_ι] at h
      · show (Limits.pullback.snd f g) (Limits.pullback.lift (s.fst ≫ U.ι) (s.snd ≫ C.ι) (hc s) x) ∈ C
        rw [← Scheme.Hom.comp_apply, Limits.pullback.lift_snd, Scheme.Hom.comp_apply]
        have h : C.ι (s.snd x) ∈ Set.range C.ι := ⟨_, rfl⟩
        rwa [Scheme.Opens.range_ι] at h
    refine IsPullback.of_isLimit (c := Limits.PullbackCone.mk _ _ comm) ?_
    refine Limits.PullbackCone.IsLimit.mk comm
      (fun s => IsOpenImmersion.lift _ _ (hrange s)) ?_ ?_ ?_
    · intro s
      rw [← cancel_mono U.ι, Category.assoc, Scheme.Hom.resLE_comp_ι, ← Category.assoc,
        IsOpenImmersion.lift_fac, Limits.pullback.lift_fst]
    · intro s
      rw [← cancel_mono C.ι, Category.assoc, Scheme.Hom.resLE_comp_ι, ← Category.assoc,
        IsOpenImmersion.lift_fac, Limits.pullback.lift_snd]
    · intro s m h1 h2
      apply IsOpenImmersion.lift_uniq
      apply Limits.pullback.hom_ext
      · rw [Limits.pullback.lift_fst, ← h1, Category.assoc, Category.assoc, Scheme.Hom.resLE_comp_ι]
      · rw [Limits.pullback.lift_snd, ← h2, Category.assoc, Category.assoc, Scheme.Hom.resLE_comp_ι]
  haveI : IsAffine (U : Scheme.{u}) := hU
  haveI : IsAffine (C : Scheme.{u}) := hC
  have hOaff : IsAffineOpen ((Limits.pullback.fst f g) ⁻¹ᵁ U ⊓
      (Limits.pullback.snd f g) ⁻¹ᵁ C) := IsAffine.of_isIso hP.isoPullback.hom
  have hgen := s2 _ _ _ _ _ _ _ _ (isPushout_appTop_of_isPullback hP)

  have hOgen : ∀ t : Γ(Limits.pullback f g, (Limits.pullback.fst f g) ⁻¹ᵁ U ⊓
      (Limits.pullback.snd f g) ⁻¹ᵁ C), t ∈ Subring.closure
        (Set.range (((Limits.pullback f g).presheaf.map (homOfLE (inf_le_left :
          (Limits.pullback.fst f g) ⁻¹ᵁ U ⊓ (Limits.pullback.snd f g) ⁻¹ᵁ C ≤
            (Limits.pullback.fst f g) ⁻¹ᵁ U)).op).hom.comp ((Limits.pullback.fst f g).app U).hom) ∪
        Set.range (((Limits.pullback f g).presheaf.map (homOfLE (inf_le_right :
          (Limits.pullback.fst f g) ⁻¹ᵁ U ⊓ (Limits.pullback.snd f g) ⁻¹ᵁ C ≤
            (Limits.pullback.snd f g) ⁻¹ᵁ C)).op).hom.comp ((Limits.pullback.snd f g).app C).hom)) := by
    intro t
    have ht : ((Limits.pullback.fst f g) ⁻¹ᵁ U ⊓ (Limits.pullback.snd f g) ⁻¹ᵁ C).topIso.hom
        (((Limits.pullback.fst f g) ⁻¹ᵁ U ⊓ (Limits.pullback.snd f g) ⁻¹ᵁ C).topIso.inv t)
        = t := by
      exact ConcreteCategory.congr_hom
        ((Limits.pullback.fst f g) ⁻¹ᵁ U ⊓ (Limits.pullback.snd f g) ⁻¹ᵁ C).topIso.inv_hom_id t
    rw [← ht, ← Subring.mem_comap]
    refine (Subring.closure_le.mpr ?_) (hgen _)
    rintro _ (⟨y, rfl⟩ | ⟨z, rfl⟩)
    · rw [SetLike.mem_coe, Subring.mem_comap]
      apply Subring.subset_closure
      left
      refine ⟨U.topIso.hom y, ?_⟩
      have h := ConcreteCategory.congr_hom (s3 _ _ (Limits.pullback.fst f g) U
        ((Limits.pullback.fst f g) ⁻¹ᵁ U ⊓ (Limits.pullback.snd f g) ⁻¹ᵁ C) inf_le_left) y
      exact h.symm
    · rw [SetLike.mem_coe, Subring.mem_comap]
      apply Subring.subset_closure
      right
      refine ⟨C.topIso.hom z, ?_⟩
      have h := ConcreteCategory.congr_hom (s3 _ _ (Limits.pullback.snd f g) C
        ((Limits.pullback.fst f g) ⁻¹ᵁ U ⊓ (Limits.pullback.snd f g) ⁻¹ᵁ C) inf_le_right) z
      exact h.symm

  refine ⟨hOaff.preimage ι, fun t => ?_⟩
  let φ : Γ(Limits.pullback f g, (Limits.pullback.fst f g) ⁻¹ᵁ U ⊓
      (Limits.pullback.snd f g) ⁻¹ᵁ C) →+*
      Γ(Y', (ι ≫ Limits.pullback.fst f g) ⁻¹ᵁ U ⊓ (ι ≫ Limits.pullback.snd f g) ⁻¹ᵁ C) :=
    (ι.app ((Limits.pullback.fst f g) ⁻¹ᵁ U ⊓ (Limits.pullback.snd f g) ⁻¹ᵁ C)).hom
  obtain ⟨s, hs⟩ : ∃ s, φ s = t :=
    Scheme.Hom.app_surjective ι _ hOaff t
  rw [← hs, ← Subring.mem_comap]
  refine (Subring.closure_le.mpr ?_) (hOgen s)
  rintro _ (⟨a, rfl⟩ | ⟨b, rfl⟩)
  · rw [SetLike.mem_coe, Subring.mem_comap]
    apply Subring.subset_closure
    left
    refine ⟨a, ?_⟩
    have h := ConcreteCategory.congr_hom (ι.naturality (homOfLE (inf_le_left :
      (Limits.pullback.fst f g) ⁻¹ᵁ U ⊓ (Limits.pullback.snd f g) ⁻¹ᵁ C ≤
        (Limits.pullback.fst f g) ⁻¹ᵁ U)).op) ((Limits.pullback.fst f g).app U a)
    exact h.symm
  · rw [SetLike.mem_coe, Subring.mem_comap]
    apply Subring.subset_closure
    right
    refine ⟨b, ?_⟩
    have h := ConcreteCategory.congr_hom (ι.naturality (homOfLE (inf_le_right :
      (Limits.pullback.fst f g) ⁻¹ᵁ U ⊓ (Limits.pullback.snd f g) ⁻¹ᵁ C ≤
        (Limits.pullback.snd f g) ⁻¹ᵁ C)).op) ((Limits.pullback.snd f g).app C b)
    exact h.symm

theorem wc_chart_sections_from_target : ∀ (K : Type u) [Field K] (Y Y' P : Scheme.{u}) (f : Y ⟶ Spec (.of K)) (str : P ⟶ Spec (.of K)) (π : Y' ⟶ Y) (g : Y' ⟶ P) (U : Y.Opens) (C : P.Opens) (n : ℕ) (a : Fin (n + 1) → Γ(Y, U)) (b : Fin (n + 1) → Γ(P, C)), π ≫ f = g ≫ str → (∀ t : Γ(Y', π ⁻¹ᵁ U ⊓ g ⁻¹ᵁ C), t ∈ Subring.closure (Set.range ((Y'.presheaf.map (homOfLE (inf_le_left : π ⁻¹ᵁ U ⊓ g ⁻¹ᵁ C ≤ π ⁻¹ᵁ U)).op).hom.comp (π.app U).hom) ∪ Set.range ((Y'.presheaf.map (homOfLE (inf_le_right : π ⁻¹ᵁ U ⊓ g ⁻¹ᵁ C ≤ g ⁻¹ᵁ C)).op).hom.comp (g.app C).hom))) → (∀ t : Γ(Y, U), t ∈ Subring.closure (Set.range ((Y.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom.comp (f.appTop.hom.comp (Scheme.ΓSpecIso (.of K)).inv.hom)) ∪ Set.range a)) → (∀ k, (Y'.presheaf.map (homOfLE (inf_le_left : π ⁻¹ᵁ U ⊓ g ⁻¹ᵁ C ≤ π ⁻¹ᵁ U)).op).hom (π.app U (a k)) = (Y'.presheaf.map (homOfLE (inf_le_right : π ⁻¹ᵁ U ⊓ g ⁻¹ᵁ C ≤ g ⁻¹ᵁ C)).op).hom (g.app C (b k))) → ∀ t : Γ(Y', π ⁻¹ᵁ U ⊓ g ⁻¹ᵁ C), ∃ c : Γ(P, C), (Y'.presheaf.map (homOfLE (inf_le_right : π ⁻¹ᵁ U ⊓ g ⁻¹ᵁ C ≤ g ⁻¹ᵁ C)).op).hom (g.app C c) = t :=
by
  intro K _ Y Y' P f str π g U C n a b hgf hGen hA hkey

  have nat : ∀ (Z : Scheme.{u}) (q : Y' ⟶ Z) (s : Z ⟶ Spec (.of K)) (V : Z.Opens)
      (W' : Y'.Opens) (h : W' ≤ q ⁻¹ᵁ V) (x : Γ(Spec (.of K), ⊤)),
      (Y'.presheaf.map (homOfLE h).op).hom (q.app V
        ((Z.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op).hom (s.appTop.hom x))) =
      (Y'.presheaf.map (homOfLE (le_top : W' ≤ ⊤)).op).hom ((q ≫ s).appTop.hom x) := by
    intro Z q s V W' h x
    change (s.appTop ≫ Z.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op ≫ q.app V ≫
        Y'.presheaf.map (homOfLE h).op) x =
      ((q ≫ s).appTop ≫ Y'.presheaf.map (homOfLE (le_top : W' ≤ ⊤)).op) x
    congr 1
    rw [Scheme.Hom.naturality_assoc, ← Functor.map_comp, Scheme.Hom.comp_appTop,
      Category.assoc]
    rfl
  set rL : Γ(Y, U) →+* Γ(Y', π ⁻¹ᵁ U ⊓ g ⁻¹ᵁ C) :=
    (Y'.presheaf.map (homOfLE (inf_le_left : π ⁻¹ᵁ U ⊓ g ⁻¹ᵁ C ≤ π ⁻¹ᵁ U)).op).hom.comp
      (π.app U).hom with hrL
  set rR : Γ(P, C) →+* Γ(Y', π ⁻¹ᵁ U ⊓ g ⁻¹ᵁ C) :=
    (Y'.presheaf.map (homOfLE (inf_le_right : π ⁻¹ᵁ U ⊓ g ⁻¹ᵁ C ≤ g ⁻¹ᵁ C)).op).hom.comp
      (g.app C).hom with hrR
  let T : Subring Γ(Y, U) := Subring.comap rL rR.range
  have hGT : Set.range ((Y.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom.comp
      (f.appTop.hom.comp (Scheme.ΓSpecIso (.of K)).inv.hom)) ∪ Set.range a ⊆ (T : Set Γ(Y, U)) := by
    rintro s (⟨y, rfl⟩ | ⟨k, rfl⟩)
    · show rL _ ∈ rR.range
      refine ⟨(P.presheaf.map (homOfLE (le_top : C ≤ ⊤)).op).hom
        (str.appTop.hom ((Scheme.ΓSpecIso (.of K)).inv.hom y)), ?_⟩
      have e1 := nat P g str C (π ⁻¹ᵁ U ⊓ g ⁻¹ᵁ C) inf_le_right
        ((Scheme.ΓSpecIso (.of K)).inv.hom y)
      have e2 := nat Y π f U (π ⁻¹ᵁ U ⊓ g ⁻¹ᵁ C) inf_le_left
        ((Scheme.ΓSpecIso (.of K)).inv.hom y)
      rw [hgf] at e2
      simp only [hrL, hrR, RingHom.comp_apply]
      exact e1.trans e2.symm
    · show rL (a k) ∈ rR.range
      exact ⟨b k, (hkey k).symm⟩
  have hTall : ∀ s : Γ(Y, U), s ∈ T := fun s => (Subring.closure_le.mpr hGT) (hA s)
  have hRall : Set.range rL ∪ Set.range rR ⊆ (rR.range : Set _) := by
    rintro x (⟨s, rfl⟩ | ⟨c, rfl⟩)
    · exact hTall s
    · exact ⟨c, rfl⟩
  intro t
  obtain ⟨c, hc⟩ := (Subring.closure_le.mpr hRall) (hGen t)
  exact ⟨c, hc⟩

theorem wc_closed_immersion_of_chart_cover : ∀ (Y' P : Scheme.{u}) (g : Y' ⟶ P) (N : ℕ) (C : Fin (N + 1) → P.Opens) (S : Set (Fin (N + 1))), IsClosed (Set.range g) → (∀ y : Y', ∃ J ∈ S, g y ∈ C J) → (∀ J ∈ S, IsClosedImmersion (g ∣_ C J)) → IsClosedImmersion g :=
by
  intro Y' P g N C S hclosed hcov hchart
  refine IsZariskiLocalAtTarget.of_forall_exists_morphismRestrict (P := @IsClosedImmersion) ?_
  intro p
  by_cases hp : p ∈ Set.range g
  · obtain ⟨y, rfl⟩ := hp
    obtain ⟨J, hJ, hyJ⟩ := hcov y
    exact ⟨C J, hyJ, hchart J hJ⟩
  · let W₀ : P.Opens := ⟨(Set.range g)ᶜ, hclosed.isOpen_compl⟩
    refine ⟨W₀, hp, ?_⟩
    haveI hE : IsEmpty ((g ⁻¹ᵁ W₀ : Scheme.{u}) : Type u) := ⟨fun x => by
      have hx : (g ⁻¹ᵁ W₀).ι x ∈ Set.range (g ⁻¹ᵁ W₀).ι := ⟨x, rfl⟩
      rw [Scheme.Opens.range_ι] at hx
      have hx' : g ((g ⁻¹ᵁ W₀).ι x) ∈ W₀ := hx
      exact hx' ⟨_, rfl⟩⟩
    haveI : IsOpenImmersion (g ∣_ W₀) := isOpenImmersion_of_isEmpty _
    apply IsClosedImmersion.of_isPreimmersion
    rw [Set.range_eq_empty]
    exact isClosed_empty

theorem wc_chow_projective_cover : ∀ (K : Type u) [Field K] (Y : Scheme.{u}) (f : Y ⟶ Spec (.of K))
    [IsProper f], ∃ (N : ℕ) (Y' : Scheme.{u}) (π : Y' ⟶ Y) (j : Y' ⟶ wcProjK K N) (V : Y.Opens),
      IsProper π ∧ IsClosedImmersion j ∧ Dense (V : Set Y) ∧ Dense (π ⁻¹' (V : Set Y)) ∧
      IsIso (π ∣_ V) :=
by
  intro K _ Y f _

  haveI : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace f
  haveI : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian f
  haveI : IsNoetherian Y := ⟨⟩
  obtain ⟨r, U, hUaff, hUcov, hUdense⟩ := wc_chow_dense_affine_charts Y
  let W : Y.Opens := ⨅ i, U i
  have hWcoe : (W : Set Y) = ⋂ i, (U i : Set Y) := TopologicalSpace.Opens.coe_iInf U
  have hWdense : Dense (W : Set Y) := by rw [hWcoe]; exact hUdense
  have hWU : ∀ i, W ≤ U i := fun i => iInf_le U i
  have hgen := fun i => wc_chow_affine_generators K Y f (U i) (hUaff i)
  choose n a ha0 hagen using hgen
  have hcard : 0 < Fintype.card (∀ i, Fin (n i + 1)) := Fintype.card_pos
  let N : ℕ := Fintype.card (∀ i, Fin (n i + 1)) - 1
  let κ : Fin (N + 1) ≃ (∀ i, Fin (n i + 1)) :=
    (Fintype.equivFinOfCardEq (by omega : Fintype.card (∀ i, Fin (n i + 1)) = N + 1)).symm
  obtain ⟨C, e, hCcov, hCaff, hCbo, UP⟩ := wc_projK_coords K N

  have hψU : ∀ i, W.ι ⁻¹ᵁ U i = ⊤ := by
    intro i
    apply top_le_iff.mp
    intro x _
    show W.ι x ∈ (U i : Set Y)
    have hx : W.ι x ∈ Set.range W.ι := ⟨x, rfl⟩
    rw [Scheme.Opens.range_ι] at hx
    exact hWU i hx
  let s : Fin (N + 1) → Γ((W : Scheme.{u}), ⊤) :=
    fun L => ∏ i, W.ι.appLE (U i) ⊤ (hψU i).ge (a i (κ L i))
  have hs1 : s (κ.symm 0) = 1 := by
    simp only [s, Equiv.apply_symm_apply, Pi.zero_apply, ha0, map_one, Finset.prod_const_one]
  have hspan : Ideal.span (Set.range s) = ⊤ := by
    rw [Ideal.eq_top_iff_one]
    exact Ideal.subset_span ⟨κ.symm 0, hs1⟩
  obtain ⟨φ, hφstr, hφC, hrel⟩ := UP (W : Scheme.{u}) (W.ι ≫ f) s hspan
  haveI := wc_proj_space_isProper K N
  let γ : (W : Scheme.{u}) ⟶ Limits.pullback f (wcProjKStr K N) :=
    Limits.pullback.lift W.ι φ hφstr.symm
  haveI : CompactSpace (W : Scheme.{u}) :=
    isCompact_iff_compactSpace.mp (TopologicalSpace.NoetherianSpace.isCompact (W : Set Y))
  haveI : IsNoetherian (W : Scheme.{u}) := ⟨⟩
  haveI : QuasiCompact γ := inferInstance
  let ιQ := γ.imageι
  let δ := γ.toImage
  have hδι : δ ≫ ιQ = γ := Scheme.Hom.toImage_imageι γ
  let π : γ.image ⟶ Y := ιQ ≫ Limits.pullback.fst f (wcProjKStr K N)
  let g : γ.image ⟶ wcProjK K N := ιQ ≫ Limits.pullback.snd f (wcProjKStr K N)
  have hδπ : δ ≫ π = W.ι := by
    show δ ≫ ιQ ≫ Limits.pullback.fst f (wcProjKStr K N) = W.ι
    rw [← Category.assoc, hδι]
    exact Limits.pullback.lift_fst _ _ _
  have hδg : δ ≫ g = φ := by
    show δ ≫ ιQ ≫ Limits.pullback.snd f (wcProjKStr K N) = φ
    rw [← Category.assoc, hδι]
    exact Limits.pullback.lift_snd _ _ _
  obtain ⟨hinj, hdense⟩ := wc_toImage_injective_dense _ _ γ

  haveI hπprop : IsProper π := by
    show IsProper (ιQ ≫ Limits.pullback.fst f (wcProjKStr K N))
    infer_instance
  have hπWd : Dense (π ⁻¹' (W : Set Y)) := by
    refine Dense.mono ?_ hdense
    rintro _ ⟨x, rfl⟩
    show π (δ x) ∈ (W : Set Y)
    rw [← Scheme.Hom.comp_apply, hδπ]
    have hx : W.ι x ∈ Set.range W.ι := ⟨x, rfl⟩
    rwa [Scheme.Opens.range_ι] at hx
  have hiso : IsIso (π ∣_ W) := wc_isIso_restrict_of_section _ Y π W δ hinj hδπ

  have hgf : π ≫ f = g ≫ wcProjKStr K N := by
    show (ιQ ≫ Limits.pullback.fst f (wcProjKStr K N)) ≫ f =
      (ιQ ≫ Limits.pullback.snd f (wcProjKStr K N)) ≫ wcProjKStr K N
    rw [Category.assoc, Category.assoc, Limits.pullback.condition]
  haveI hgprop : IsProper g := by
    show IsProper (ιQ ≫ Limits.pullback.snd f (wcProjKStr K N))
    infer_instance
  have hrange : IsClosed (Set.range g) := g.isClosedMap.isClosed_range
  have hπcov : ∀ z : γ.image, ∃ i, π z ∈ U i := by
    intro z
    have hz : π z ∈ (⊤ : Y.Opens) := trivial
    rw [← hUcov] at hz
    exact TopologicalSpace.Opens.mem_iSup.mp hz
  have hcov := wc_chow_charts_cover_K Y γ.image (W : Scheme.{u}) (wcProjK K N) π g δ W.ι φ r U n a
    N κ C e s hψU hinj hδπ hδg ha0 (fun L => rfl) hφC hrel hCcov hCbo hπcov
  have hchart : ∀ J ∈ {J : Fin (N + 1) | ∃ i, κ J i = 0}, IsClosedImmersion (g ∣_ C J) := by
    rintro J ⟨i, hi⟩
    obtain ⟨hGaff, hGgen⟩ := wc_closed_in_product_chart_gen (Spec (.of K)) Y (wcProjK K N)
      γ.image f (wcProjKStr K N) ιQ (U i) (C J) (hUaff i) (hCaff J)
    have hkey := wc_chow_key_identity Y γ.image (W : Scheme.{u}) (wcProjK K N) π g δ W.ι φ r U n a
      N κ C e s hψU hinj hδπ hδg ha0 (fun L => rfl) hφC hrel i J hi
    have hsurj := wc_chart_sections_from_target K Y γ.image (wcProjK K N) f (wcProjKStr K N) π g
      (U i) (C J) (n i) (a i) (fun k => e J (κ.symm (Function.update (κ J) i k))) hgf hGgen
      (hagen i) hkey
    have hpre : (δ ≫ π) ⁻¹ᵁ U i = ⊤ := by rw [hδπ]; exact hψU i
    exact wc_chart_closed_immersion_of_surj Y γ.image (W : Scheme.{u}) (wcProjK K N) π g δ (U i)
      (C J) hdense hpre (hCaff J) hGaff hsurj

  exact ⟨N, γ.image, π, g, W, hπprop,
    wc_closed_immersion_of_chart_cover γ.image (wcProjK K N) g N C _ hrange hcov hchart,
    hWdense, hπWd, hiso⟩

theorem wc_closed_dense_compl_dim_drop : ∀ (X : Type u) [TopologicalSpace X]
    [TopologicalSpace.NoetherianSpace X] (C : Set X) (n : ℕ), IsClosed C → Dense Cᶜ →
    topologicalKrullDim X ≤ ((n + 1 : ℕ) : WithBot ℕ∞) → topologicalKrullDim ↥C ≤ (n : WithBot ℕ∞) :=
by
  intro X _ _ C n hC hD hX
  have hext : ∀ T : Set X, IsIrreducible T → T ⊆ C →
      ∃ W : Set X, IsClosed W ∧ IsIrreducible W ∧ T ⊂ W := by
    intro T hT hTC
    obtain ⟨W, hW, hTW⟩ := exists_mem_irreducibleComponents_subset_of_isIrreducible T hT
    obtain ⟨o, ho, hne, hoW⟩ :=
      TopologicalSpace.NoetherianSpace.exists_isOpen_nonempty_subset_irreducibleComponent W hW
    obtain ⟨x, hxo, hxC⟩ := hD.inter_open_nonempty o ho hne
    exact ⟨W, isClosed_of_mem_irreducibleComponents W hW, hW.1, hTW,
      fun hWT => hxC (hTC (hWT (hoW hxo)))⟩
  let φ : TopologicalSpace.IrreducibleCloseds C → TopologicalSpace.IrreducibleCloseds X :=
    fun T => ⟨Subtype.val '' (T : Set C),
      T.isIrreducible.image _ continuous_subtype_val.continuousOn,
      hC.isClosedMap_subtype_val _ T.isClosed⟩
  have hφ : StrictMono φ := by
    intro a b hab
    rw [← SetLike.coe_ssubset_coe] at hab ⊢
    exact Subtype.val_injective.image_strictMono hab
  have hφC : ∀ T, (φ T : Set X) ⊆ C := fun T => by
    rintro _ ⟨y, _, rfl⟩
    exact y.2
  unfold topologicalKrullDim at hX ⊢
  unfold Order.krullDim
  apply iSup_le
  intro p
  obtain ⟨W, hWc, hWi, hsub⟩ := hext _ (φ p.last).isIrreducible (hφC _)
  let b : TopologicalSpace.IrreducibleCloseds X := ⟨W, hWi, hWc⟩
  have hlt : φ p.last < b := by
    rw [← SetLike.coe_ssubset_coe]
    exact hsub
  let q := (p.map φ hφ).snoc b (by rw [LTSeries.last_map]; exact hlt)
  have h1 := Order.LTSeries.length_le_krullDim q
  have hq : q.length = p.length + 1 := by
    simp [q, RelSeries.snoc_length, LTSeries.map_length]
  rw [hq] at h1
  have h2 : ((p.length + 1 : ℕ) : WithBot ℕ∞) ≤ ((n + 1 : ℕ) : WithBot ℕ∞) := h1.trans hX
  have h3 : p.length + 1 ≤ n + 1 := by exact_mod_cast h2
  have h4 : p.length ≤ n := by omega
  exact_mod_cast h4

theorem wc_dim_le_dim_dense_open_part : ∀ (K : Type u) [Field K] (X : Scheme.{u})
    (f : X ⟶ Spec (.of K)) [IsProper f] (Z U : Set X), IsClosed Z → IsOpen U →
    Z ⊆ closure (Z ∩ U) → topologicalKrullDim ↥Z ≤ topologicalKrullDim ↥(Z ∩ U) :=
by
  intro K _ X f _ Z U hZ hU hd


  have L7 : ∀ (A C : Type u) [CommRing A] [CommRing C] (g : A →+* C), g.IsIntegral →
      Function.Injective g → ringKrullDim A = ringKrullDim C := by
    intro A C _ _ g hg hinj
    letI := g.toAlgebra
    haveI : Algebra.IsIntegral A C := ⟨hg⟩
    apply le_antisymm
    · have key : ∀ (n : ℕ) (p : LTSeries (PrimeSpectrum A)), p.length = n →
          ∃ q : LTSeries (PrimeSpectrum C), q.length = n ∧
            Ideal.under A q.last.asIdeal = p.last.asIdeal := by
        intro n
        induction n with
        | zero =>
          intro p _
          haveI := p.last.isPrime
          obtain ⟨Q, -, hQ, hQP⟩ := Ideal.exists_ideal_over_prime_of_isIntegral p.last.asIdeal
            (⊥ : Ideal C) (by
              intro a ha
              have : g a = 0 := ha
              rw [show a = 0 from hinj (by rw [this, map_zero])]
              exact Ideal.zero_mem _)
          exact ⟨RelSeries.singleton _ ⟨Q, hQ⟩, rfl, hQP⟩
        | succ n ih =>
          intro p hp
          have hpos : p.length ≠ 0 := by omega
          obtain ⟨q', hq'l, hq'⟩ := ih p.eraseLast (by simp [RelSeries.eraseLast_length, hp])
          have hlt : p.eraseLast.last < p.last := RelSeries.eraseLast_last_rel_last p hpos
          haveI := p.last.isPrime
          obtain ⟨Q, hQge, hQ, hQP⟩ := Ideal.exists_ideal_over_prime_of_isIntegral p.last.asIdeal
            q'.last.asIdeal (by rw [hq']; exact hlt.le)
          have hlt' : q'.last < ⟨Q, hQ⟩ := by
            refine lt_of_le_of_ne hQge ?_
            intro heq
            have : Ideal.under A q'.last.asIdeal = Ideal.under A Q := by rw [heq]
            rw [hq', hQP] at this
            exact hlt.ne (PrimeSpectrum.ext this)
          exact ⟨q'.snoc ⟨Q, hQ⟩ hlt', by simp [hq'l], by simp [hQP]⟩
      unfold ringKrullDim Order.krullDim
      refine iSup_le fun p => ?_
      obtain ⟨q, hql, -⟩ := key p.length p rfl
      rw [← hql]
      exact Order.LTSeries.length_le_krullDim q
    · apply Order.krullDim_le_of_strictMono
        (fun Q : PrimeSpectrum C => (⟨Ideal.under A Q.asIdeal, inferInstance⟩ : PrimeSpectrum A))
      intro Q Q' h
      have h' : Q.asIdeal < Q'.asIdeal := h
      obtain ⟨x, hx1, hx2⟩ := SetLike.exists_of_lt h'
      exact Ideal.under_lt_under_of_integral_mem_sdiff h'.le ⟨hx1, hx2⟩
        (Algebra.IsIntegral.isIntegral x)

  have L5 : ∀ (B : Type u) [CommRing B] [IsDomain B] [Algebra K B] [Algebra.FiniteType K B],
      ∃ (s : ℕ) (φ : MvPolynomial (Fin s) K →ₐ[K] B), Function.Injective φ ∧ φ.Finite ∧
        Algebra.trdeg K B = (s : Cardinal.{u}) := by
    intro B _ _ _ _
    obtain ⟨s, φ, hinj, hfin⟩ := exists_finite_inj_algHom_of_fg K B
    refine ⟨s, φ, hinj, hfin, ?_⟩
    set x : Fin s → B := fun i => φ (MvPolynomial.X i) with hx
    have haeval : MvPolynomial.aeval x = φ := (MvPolynomial.aeval_unique φ).symm
    have hind : AlgebraicIndependent K x := by
      rw [algebraicIndependent_iff_injective_aeval, haeval]; exact hinj
    have hbasis : IsTranscendenceBasis K x := by
      rw [hind.isTranscendenceBasis_iff_isAlgebraic]
      constructor
      intro b
      apply IsIntegral.isAlgebraic
      let S := Algebra.adjoin K (Set.range x)
      let ψa : MvPolynomial (Fin s) K →ₐ[K] S :=
        MvPolynomial.aeval (fun i => (⟨x i, Algebra.subset_adjoin ⟨i, rfl⟩⟩ : S))
      have hcompA : (S.val).comp ψa = φ := by
        apply MvPolynomial.algHom_ext
        intro i
        simp [ψa, x]
      have hcomp : (algebraMap S B).comp ψa.toRingHom = φ.toRingHom :=
        RingHom.ext fun p => DFunLike.congr_fun hcompA p
      obtain ⟨p, hpm, hp⟩ := (RingHom.Finite.to_isIntegral hfin) b
      refine ⟨p.map ψa.toRingHom, hpm.map _, ?_⟩
      rw [Polynomial.eval₂_map, hcomp]
      exact hp
    have := hbasis.lift_cardinalMk_eq_trdeg
    simpa using this.symm

  have L6 : ∀ (B : Type u) [CommRing B] [IsDomain B] [Algebra K B] (g : B), g ≠ 0 →
      Algebra.trdeg K (Localization.Away g) = Algebra.trdeg K B := by
    intro B _ _ _ g hg
    haveI : FaithfulSMul K B :=
      (faithfulSMul_iff_algebraMap_injective K B).mpr (algebraMap K B).injective
    obtain ⟨s, hx⟩ := exists_isTranscendenceBasis K B
    have hle := powers_le_nonZeroDivisors_of_noZeroDivisors hg
    haveI : IsDomain (Localization.Away g) := IsLocalization.isDomain_localization hle
    haveI : FaithfulSMul B (Localization.Away g) :=
      (faithfulSMul_iff_algebraMap_injective _ _).mpr (IsLocalization.injective _ hle)
    haveI : Algebra.IsAlgebraic B (Localization.Away g) :=
      IsLocalization.isAlgebraic _ (Submonoid.powers g)
    have hx' := hx.algebraMap_comp (A := Localization.Away g)
    have e1 := hx.lift_cardinalMk_eq_trdeg
    have e2 := hx'.lift_cardinalMk_eq_trdeg
    simp only [Cardinal.lift_id] at e1 e2
    rw [← e1, ← e2]

  have s3 : ∀ (B : Type u) [CommRing B] [IsDomain B] [Algebra K B] [Algebra.FiniteType K B]
      (h : B), h ≠ 0 → ringKrullDim B ≤ ringKrullDim (Localization.Away h) := by
    intro B _ _ _ _ h hh
    have hle := powers_le_nonZeroDivisors_of_noZeroDivisors hh
    haveI : IsDomain (Localization.Away h) := IsLocalization.isDomain_localization hle
    haveI : Algebra.FiniteType B (Localization.Away h) := Algebra.FiniteType.of_finitePresentation
    haveI : Algebra.FiniteType K (Localization.Away h) :=
      Algebra.FiniteType.trans (S := B) inferInstance inferInstance
    have hdim : ∀ (C : Type u) [CommRing C] [IsDomain C] [Algebra K C] [Algebra.FiniteType K C],
        ∃ s : ℕ, ringKrullDim C = (s : WithBot ℕ∞) ∧ Algebra.trdeg K C = (s : Cardinal.{u}) := by
      intro C _ _ _ _
      obtain ⟨s, φ, hinj, hfin, htr⟩ := L5 C
      refine ⟨s, ?_, htr⟩
      rw [← L7 _ _ φ.toRingHom (RingHom.Finite.to_isIntegral hfin) hinj,
        MvPolynomial.ringKrullDim_of_isNoetherianRing, ringKrullDim_eq_zero_of_field]
      simp
    obtain ⟨s, hs, hts⟩ := hdim B
    obtain ⟨s', hs', hts'⟩ := hdim (Localization.Away h)
    have : s' = s := by
      have := hts'.symm.trans ((L6 B h hh).trans hts)
      exact Nat.cast_injective this
    rw [hs, hs', this]


  have dmono : ∀ {Y : Type u} [TopologicalSpace Y] (A B : Set Y), A ⊆ B →
      topologicalKrullDim ↥A ≤ topologicalKrullDim ↥B := by
    intro Y _ A B hAB
    rw [IsHomeomorph.topologicalKrullDim_eq _
      (Topology.IsEmbedding.inclusion hAB).toHomeomorph.isHomeomorph]
    exact topologicalKrullDim_subspace_le _ _
  have duniv : ∀ (Y : Type u) [TopologicalSpace Y],
      topologicalKrullDim ↥(Set.univ : Set Y) = topologicalKrullDim Y := fun Y _ =>
    IsHomeomorph.topologicalKrullDim_eq _ (Homeomorph.Set.univ Y).isHomeomorph
  have EPle : ∀ {A B : Type u} [TopologicalSpace A] [TopologicalSpace B] (e : A → B),
      Topology.IsEmbedding e → ∀ S : Set B,
      topologicalKrullDim ↥(e ⁻¹' S) ≤ topologicalKrullDim ↥S := by
    intro A B _ _ e he S
    have hg := he.restrictPreimage S
    rw [IsHomeomorph.topologicalKrullDim_eq _ hg.toHomeomorph.isHomeomorph]
    exact topologicalKrullDim_subspace_le _ _
  have EP : ∀ {A B : Type u} [TopologicalSpace A] [TopologicalSpace B] (e : A → B),
      Topology.IsEmbedding e → ∀ S : Set B, S ⊆ Set.range e →
      topologicalKrullDim ↥(e ⁻¹' S) = topologicalKrullDim ↥S := by
    intro A B _ _ e he S hS
    apply IsHomeomorph.topologicalKrullDim_eq (S.restrictPreimage e)
    rw [isHomeomorph_iff_isEmbedding_surjective]
    refine ⟨he.restrictPreimage S, ?_⟩
    rintro ⟨s, hs⟩
    obtain ⟨a, rfl⟩ := hS hs
    exact ⟨⟨a, hs⟩, rfl⟩
  have IRR : ∀ {A B : Type u} [TopologicalSpace A] [TopologicalSpace B] (e : A → B),
      Topology.IsEmbedding e → ∀ T : Set B, T ⊆ Set.range e → IsIrreducible T →
      IsIrreducible (e ⁻¹' T) := by
    intro A B _ _ e he T hTr hT
    obtain ⟨t, ht⟩ := hT.nonempty
    obtain ⟨a, rfl⟩ := hTr ht
    refine ⟨⟨a, ht⟩, ?_⟩
    intro u v hu hv ⟨b, hb, hbu⟩ ⟨c, hc, hcv⟩
    obtain ⟨u', hu', rfl⟩ := he.isInducing.isOpen_iff.mp hu
    obtain ⟨v', hv', rfl⟩ := he.isInducing.isOpen_iff.mp hv
    obtain ⟨y, hyT, hyu, hyv⟩ := hT.2 u' v' hu' hv' ⟨e b, hb, hbu⟩ ⟨e c, hc, hcv⟩
    obtain ⟨d, rfl⟩ := hTr hyT
    exact ⟨d, hyT, hyu, hyv⟩
  have DIMLE : ∀ {Y : Type u} [TopologicalSpace Y] (c : WithBot ℕ∞),
      (∀ p : LTSeries (TopologicalSpace.IrreducibleCloseds Y), (p.length : WithBot ℕ∞) ≤ c) →
      topologicalKrullDim Y ≤ c := by
    intro Y _ c h
    unfold topologicalKrullDim Order.krullDim
    exact iSup_le h

  have CH : ∀ {Y : Type u} [TopologicalSpace Y] (S : Set Y)
      (p : LTSeries (TopologicalSpace.IrreducibleCloseds Y)),
      ((p 0 : Set Y) ∩ S).Nonempty → (∀ j, (p j : Set Y) ⊆ closure ((p j : Set Y) ∩ S)) →
      (p.length : WithBot ℕ∞) ≤ topologicalKrullDim ↥S := by
    intro Y _ S p hne hcl
    have hcleq : ∀ j, closure ((p j : Set Y) ∩ S) = (p j : Set Y) := fun j =>
      le_antisymm (closure_minimal Set.inter_subset_left (p j).isClosed) (hcl j)
    let T : Fin (p.length + 1) → TopologicalSpace.IrreducibleCloseds S := fun j =>
      { carrier := (Subtype.val : S → Y) ⁻¹' (p j : Set Y)
        isIrreducible' := by
          have h1 : IsIrreducible ((p j : Set Y) ∩ S) := by
            rw [← isIrreducible_iff_closure, hcleq j]; exact (p j).isIrreducible
          have h2 := IRR (Subtype.val : S → Y) Topology.IsEmbedding.subtypeVal _
            (by rw [Subtype.range_coe]; exact Set.inter_subset_right) h1
          have e : (Subtype.val : S → Y) ⁻¹' ((p j : Set Y) ∩ S) =
              (Subtype.val : S → Y) ⁻¹' (p j : Set Y) := by
            ext y; exact ⟨fun h => h.1, fun h => ⟨h, y.2⟩⟩
          rwa [e] at h2
        isClosed' := (p j).isClosed.preimage continuous_subtype_val }
    have hT : StrictMono T := by
      intro a b hab
      have hlt : p a < p b := p.strictMono hab
      refine lt_of_le_of_ne ?_ ?_
      · intro y hy
        exact (p.monotone hab.le) hy
      · intro heq
        apply hlt.ne
        have e1 : (p a : Set Y) ∩ S = (p b : Set Y) ∩ S := by
          ext y; constructor
          · rintro ⟨hy, hyS⟩
            have : (⟨y, hyS⟩ : S) ∈ (T a : Set S) := hy
            rw [heq] at this
            exact ⟨this, hyS⟩
          · rintro ⟨hy, hyS⟩
            have : (⟨y, hyS⟩ : S) ∈ (T b : Set S) := hy
            rw [← heq] at this
            exact ⟨this, hyS⟩
        apply le_antisymm hlt.le
        intro y hy
        have : y ∈ closure ((p b : Set Y) ∩ S) := hcl b hy
        rw [← e1, hcleq a] at this
        exact this
    let q : LTSeries (TopologicalSpace.IrreducibleCloseds S) :=
      ⟨p.length, T, fun j => hT Fin.castSucc_lt_succ⟩
    exact Order.LTSeries.length_le_krullDim q


  haveI : TopologicalSpace.NoetherianSpace X := by
    haveI := QuasiCompact.compactSpace_of_compactSpace f
    haveI := LocallyOfFiniteType.isLocallyNoetherian f
    haveI : IsNoetherian X := ⟨⟩
    infer_instance

  have LOC : ∀ (W : Set X) (c : WithBot ℕ∞),
      (∀ x ∈ W, ∃ V : Set X, IsOpen V ∧ x ∈ V ∧ topologicalKrullDim ↥(W ∩ V) ≤ c) →
      topologicalKrullDim ↥W ≤ c := by
    intro W c hloc
    apply DIMLE c
    intro p
    obtain ⟨x, hx⟩ := (p 0).isIrreducible.nonempty
    obtain ⟨V, hVo, hxV, hVc⟩ := hloc x.1 x.2
    have hSo : IsOpen ((Subtype.val : W → X) ⁻¹' (W ∩ V)) := by
      have : (Subtype.val : W → X) ⁻¹' (W ∩ V) = (Subtype.val : W → X) ⁻¹' V := by
        ext y; exact ⟨fun h => h.2, fun h => ⟨y.2, h⟩⟩
      rw [this]; exact hVo.preimage continuous_subtype_val
    have h1 := CH ((Subtype.val : W → X) ⁻¹' (W ∩ V)) p ⟨x, hx, x.2, hxV⟩
      (fun j => subset_closure_inter_of_isPreirreducible_of_isOpen
        (p j).isIrreducible.isPreirreducible hSo
        ⟨x, (p.monotone (Fin.zero_le j)) hx, x.2, hxV⟩)
    have h2 := EP (Subtype.val : W → X) Topology.IsEmbedding.subtypeVal (W ∩ V)
      (by rw [Subtype.range_coe]; exact Set.inter_subset_left)
    rw [h2] at h1
    exact h1.trans hVc


  have KEY : ∀ W : Set X, IsClosed W → IsIrreducible W → (W ∩ U).Nonempty →
      topologicalKrullDim ↥W ≤ topologicalKrullDim ↥(W ∩ U) := by
    intro W hWc hWi hWU
    apply LOC W
    intro x hxW
    obtain ⟨V, hV, hxV, -⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp
      (Scheme.isBasis_affineOpens X)) (show x ∈ (⊤ : X.Opens) from trivial)
    have hV' : IsAffineOpen V := hV
    refine ⟨(V : Set X), V.isOpen, hxV, ?_⟩

    have hψ := Scheme.Hom.finiteType_appLE f (isAffineOpen_top (Spec (.of K))) hV' (by simp)
    have hε : (Scheme.ΓSpecIso (CommRingCat.of K)).inv.hom.FiniteType :=
      RingHom.FiniteType.of_surjective _
        ((Scheme.ΓSpecIso (CommRingCat.of K)).commRingCatIsoToRingEquiv.symm.surjective)
    have hφ := hψ.comp hε
    letI := ((f.appLE ⊤ V (by simp)).hom.comp (Scheme.ΓSpecIso (CommRingCat.of K)).inv.hom).toAlgebra
    haveI hft : Algebra.FiniteType K Γ(X, V) := hφ

    obtain ⟨e0, he0, he0r⟩ : ∃ e0 : PrimeSpectrum Γ(X, V) → X,
        Topology.IsOpenEmbedding e0 ∧ Set.range e0 = (V : Set X) :=
      ⟨_, hV'.fromSpec.isOpenEmbedding, hV'.range_fromSpec⟩
    obtain ⟨T, hTdef⟩ : ∃ T : Set (PrimeSpectrum Γ(X, V)), T = e0 ⁻¹' W := ⟨_, rfl⟩
    have hTc : IsClosed T := by rw [hTdef]; exact hWc.preimage he0.continuous
    obtain ⟨qx, hqx⟩ : x ∈ Set.range e0 := by rw [he0r]; exact hxV
    have hTi : IsIrreducible T := by
      rw [hTdef]
      exact ⟨⟨qx, by rw [Set.mem_preimage, hqx]; exact hxW⟩,
        hWi.isPreirreducible.preimage he0⟩

    set P := PrimeSpectrum.vanishingIdeal T with hPdef
    haveI hP : P.IsPrime := PrimeSpectrum.isIrreducible_iff_vanishingIdeal_isPrime.mp hTi
    have hTz : PrimeSpectrum.zeroLocus (P : Set Γ(X, V)) = T := by
      rw [hPdef, PrimeSpectrum.zeroLocus_vanishingIdeal_eq_closure, hTc.closure_eq]
    have hψe := PrimeSpectrum.isClosedEmbedding_comap_of_surjective _
      (Ideal.Quotient.mk P) Ideal.Quotient.mk_surjective
    have hψr : Set.range (PrimeSpectrum.comap (Ideal.Quotient.mk P)) = T := by
      rw [← hTz]
      ext q
      rw [PrimeSpectrum.mem_zeroLocus]
      constructor
      · rintro ⟨Q, rfl⟩ a ha
        simp only [SetLike.mem_coe, PrimeSpectrum.comap_asIdeal, Ideal.mem_comap]
        rw [Ideal.Quotient.eq_zero_iff_mem.mpr ha]
        exact Q.asIdeal.zero_mem
      · intro hq
        haveI := q.isPrime
        have hker : RingHom.ker (Ideal.Quotient.mk P) ≤ q.asIdeal := by
          rw [Ideal.mk_ker]; exact hq
        refine ⟨⟨Ideal.map (Ideal.Quotient.mk P) q.asIdeal,
          Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective hker⟩, ?_⟩
        apply PrimeSpectrum.ext
        rw [PrimeSpectrum.comap_asIdeal,
          Ideal.comap_map_of_surjective' _ Ideal.Quotient.mk_surjective, sup_eq_left.mpr hker]

    obtain ⟨e, he, her⟩ : ∃ e : PrimeSpectrum (Γ(X, V) ⧸ P) → X,
        Topology.IsEmbedding e ∧ Set.range e = W ∩ (V : Set X) := by
      refine ⟨e0 ∘ PrimeSpectrum.comap (Ideal.Quotient.mk P),
        he0.isEmbedding.comp hψe.isEmbedding, ?_⟩
      rw [Set.range_comp, hψr, hTdef, Set.image_preimage_eq_inter_range, he0r]
    have hdimWV : topologicalKrullDim ↥(W ∩ (V : Set X)) = ringKrullDim (Γ(X, V) ⧸ P) := by
      rw [← EP e he _ her.ge, Set.preimage_eq_univ_iff.mpr her.le, duniv,
        PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim]

    obtain ⟨z, hzW, hzV, hzU⟩ := hWi.2 (V : Set X) U V.isOpen hU ⟨x, hxW, hxV⟩ hWU
    obtain ⟨qz, hqz⟩ : z ∈ Set.range e := her.ge ⟨hzW, hzV⟩
    obtain ⟨o, ⟨h, rfl⟩, hqo, hoU⟩ :=
      PrimeSpectrum.isTopologicalBasis_basic_opens.exists_subset_of_mem_open
        (show qz ∈ e ⁻¹' U by rw [Set.mem_preimage, hqz]; exact hzU) (hU.preimage he.continuous)
    have hh0 : h ≠ 0 := by
      intro h0
      have := (PrimeSpectrum.mem_basicOpen _ _).mp hqo
      rw [h0] at this
      exact this qz.asIdeal.zero_mem
    have hdimD : topologicalKrullDim ↥((PrimeSpectrum.basicOpen h :
        Set (PrimeSpectrum (Γ(X, V) ⧸ P)))) = ringKrullDim (Localization.Away h) := by
      rw [← EP _ (PrimeSpectrum.localization_away_isOpenEmbedding (Localization.Away h) h).isEmbedding
        _ (PrimeSpectrum.localization_away_comap_range (Localization.Away h) h).ge,
        Set.preimage_eq_univ_iff.mpr
          (PrimeSpectrum.localization_away_comap_range (Localization.Away h) h).le,
        duniv, PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim]
    have hDsub : ((PrimeSpectrum.basicOpen h : Set (PrimeSpectrum (Γ(X, V) ⧸ P)))) ⊆
        e ⁻¹' (W ∩ U) := fun q hq => ⟨(her.le ⟨q, rfl⟩).1, hoU hq⟩

    haveI : IsDomain (Γ(X, V) ⧸ P) := Ideal.Quotient.isDomain P
    haveI : Algebra.FiniteType K (Γ(X, V) ⧸ P) :=
      Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ K P) (Ideal.Quotient.mkₐ_surjective K P)
    calc topologicalKrullDim ↥(W ∩ (V : Set X)) = ringKrullDim (Γ(X, V) ⧸ P) := hdimWV
      _ ≤ ringKrullDim (Localization.Away h) := s3 _ h hh0
      _ = _ := hdimD.symm
      _ ≤ topologicalKrullDim ↥(e ⁻¹' (W ∩ U)) := dmono _ _ hDsub
      _ ≤ topologicalKrullDim ↥(W ∩ U) := EPle e he _


  apply DIMLE
  intro p
  obtain ⟨C, hC, hpC⟩ := exists_mem_irreducibleComponents_subset_of_isIrreducible
    (p.last : Set Z) (p.last).isIrreducible
  have hpj : ∀ j, (p j : Set Z) ⊆ C := fun j y hy => hpC ((p.monotone (Fin.le_last j)) hy)
  obtain ⟨y0, hy0⟩ := (p 0).isIrreducible.nonempty
  have h1 := CH C p ⟨y0, hy0, hpj 0 hy0⟩
    (fun j => by rw [Set.inter_eq_left.mpr (hpj j)]; exact subset_closure)
  have h2 : topologicalKrullDim ↥C = topologicalKrullDim ↥(Subtype.val '' C : Set X) := by
    rw [← EP (Subtype.val : Z → X) Topology.IsEmbedding.subtypeVal _ (Set.image_subset_range _ _),
      Set.preimage_image_eq C Subtype.val_injective]
  have hWc : IsClosed (Subtype.val '' C : Set X) :=
    hZ.isClosedEmbedding_subtypeVal.isClosedMap C (isClosed_of_mem_irreducibleComponents C hC)
  have hWi : IsIrreducible (Subtype.val '' C : Set X) :=
    hC.1.image _ continuous_subtype_val.continuousOn
  have hWU : ((Subtype.val '' C : Set X) ∩ U).Nonempty := by
    by_contra hne
    rw [Set.not_nonempty_iff_eq_empty] at hne
    have hfin : (irreducibleComponents Z \ {C}).Finite :=
      TopologicalSpace.NoetherianSpace.finite_irreducibleComponents.subset Set.diff_subset
    have hcl : ∀ t ∈ irreducibleComponents Z \ {C}, IsClosed t :=
      fun t ht => isClosed_of_mem_irreducibleComponents t ht.1
    have hRc : IsClosed (⋃₀ (irreducibleComponents Z \ {C})) := hfin.isClosed_sUnion hcl
    have hUR : ((Subtype.val : Z → X) ⁻¹' U) ⊆ ⋃₀ (irreducibleComponents Z \ {C}) := by
      intro z hz
      have hzc : z ∈ ⋃₀ irreducibleComponents Z := by rw [sUnion_irreducibleComponents]; trivial
      obtain ⟨C', hC', hzC'⟩ := Set.mem_sUnion.mp hzc
      by_cases hCC : C' = C
      · have : (z : X) ∈ (Subtype.val '' C : Set X) ∩ U := ⟨⟨z, hCC ▸ hzC', rfl⟩, hz⟩
        rw [hne] at this
        exact absurd this (Set.notMem_empty _)
      · exact Set.mem_sUnion.mpr ⟨C', ⟨hC', hCC⟩, hzC'⟩
    have hdense : ∀ z : Z, z ∈ closure ((Subtype.val : Z → X) ⁻¹' U) := by
      intro z
      rw [closure_subtype, Subtype.image_preimage_coe]
      exact hd z.2
    have hCR : C ⊆ ⋃₀ (irreducibleComponents Z \ {C}) :=
      fun z _ => closure_minimal hUR hRc (hdense z)
    obtain ⟨C', hC'mem, hCC'⟩ := isIrreducible_iff_sUnion_isClosed.mp hC.1 hfin.toFinset
      (fun t ht => hcl t (hfin.mem_toFinset.mp ht)) (by rw [Set.Finite.coe_toFinset]; exact hCR)
    have hC' := hfin.mem_toFinset.mp hC'mem
    exact hC'.2 (le_antisymm (hC.2 hC'.1.1 hCC') hCC')
  exact h1.trans (h2.le.trans ((KEY _ hWc hWi hWU).trans
    (dmono _ _ (Set.inter_subset_inter_left U (Subtype.coe_image_subset Z C)))))

theorem wc_proj_linear_projection_morphism : ∀ (K : Type u) [Field K] (M : ℕ) (ℓ : Fin (M + 1) → MvPolynomial (Fin (M + 1 + 1)) K), (∀ i, (ℓ i).IsHomogeneous 1) → ∃ π : ((⨆ i : Fin (M + 1), @Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (M + 1 + 1)) K) MvPolynomial.gradedAlgebra (ℓ i) : (wcProjK K (M + 1)).Opens) : Scheme.{u}) ⟶ wcProjK K M, π ≫ wcProjKStr K M = Scheme.Opens.ι _ ≫ wcProjKStr K (M + 1) ∧ ∀ i : Fin (M + 1), π ⁻¹ᵁ @Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) K) MvPolynomial.gradedAlgebra (MvPolynomial.X i) = (Scheme.Opens.ι _) ⁻¹ᵁ @Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (M + 1 + 1)) K) MvPolynomial.gradedAlgebra (ℓ i) :=
by
  intro K _ M ℓ hℓ
  classical
  letI : GradedRing (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) K) := MvPolynomial.gradedAlgebra
  letI : GradedRing (MvPolynomial.homogeneousSubmodule (Fin (M + 1 + 1)) K) :=
    MvPolynomial.gradedAlgebra
  let φ : MvPolynomial.homogeneousSubmodule (Fin (M + 1)) K →+*ᵍ
      MvPolynomial.homogeneousSubmodule (Fin (M + 1 + 1)) K :=
    GradedRingHom.mk (MvPolynomial.aeval ℓ).toRingHom (fun {i} {x} hx => by
      rw [MvPolynomial.mem_homogeneousSubmodule] at hx ⊢
      simpa using (hx.aeval ℓ hℓ))
  have hφ : ∀ a, φ a = MvPolynomial.aeval ℓ a := fun a => rfl
  have hy : ∀ i : Fin (M + 1), (MvPolynomial.X i : MvPolynomial (Fin (M + 1)) K) ∈
      MvPolynomial.homogeneousSubmodule (Fin (M + 1)) K 1 :=
    fun i => (MvPolynomial.mem_homogeneousSubmodule _ _).mpr (MvPolynomial.isHomogeneous_X K i)
  have hℓ' : ∀ i, ℓ i ∈ MvPolynomial.homogeneousSubmodule (Fin (M + 1 + 1)) K 1 :=
    fun i => (MvPolynomial.mem_homogeneousSubmodule _ _).mpr (hℓ i)
  have hφX : ∀ i, φ (MvPolynomial.X i) = ℓ i := fun i => MvPolynomial.aeval_X ℓ i
  have h : ∀ i, Submonoid.powers (MvPolynomial.X i : MvPolynomial (Fin (M + 1)) K) ≤
      Submonoid.comap φ (Submonoid.powers (ℓ i)) :=
    fun i => Submonoid.powers_le.mpr (Submonoid.mem_comap.mpr
      (by rw [hφX]; exact Submonoid.mem_powers _))
  have h₂ : ∀ i j, Submonoid.powers (MvPolynomial.X i * MvPolynomial.X j :
      MvPolynomial (Fin (M + 1)) K) ≤ Submonoid.comap φ (Submonoid.powers (ℓ i * ℓ j)) :=
    fun i j => Submonoid.powers_le.mpr (Submonoid.mem_comap.mpr (by
      rw [map_mul, hφX, hφX]; exact Submonoid.mem_powers _))

  have L1 : ∀ j (n : ℕ) (a : MvPolynomial (Fin (M + 1)) K)
      (ha : a ∈ MvPolynomial.homogeneousSubmodule (Fin (M + 1)) K (n • 1)),
      HomogeneousLocalization.map φ (h j) (HomogeneousLocalization.Away.mk _ (hy j) n a ha) =
      HomogeneousLocalization.Away.mk _ (hℓ' j) n (φ a) (φ.map_mem ha) := by
    intro j n a ha
    apply HomogeneousLocalization.val_injective
    rw [HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.Away.mk,
      HomogeneousLocalization.map_mk, HomogeneousLocalization.val_mk]
    congr 1
    apply Subtype.ext
    show φ (MvPolynomial.X j ^ n) = ℓ j ^ n
    rw [map_pow, hφX]
  have C4 : ∀ (a b : Fin (M + 1)) (x : MvPolynomial (Fin (M + 1)) K)
      (x' : MvPolynomial (Fin (M + 1 + 1)) K)
      (hx : x = MvPolynomial.X a * MvPolynomial.X b) (hx' : x' = ℓ a * ℓ b)
      (h₂ : Submonoid.powers x ≤ Submonoid.comap φ (Submonoid.powers x')),
      (HomogeneousLocalization.awayMap _ (hℓ' b) hx').comp (HomogeneousLocalization.map φ (h a)) =
        (HomogeneousLocalization.map φ h₂).comp (HomogeneousLocalization.awayMap _ (hy b) hx) := by
    intro a b x x' hx hx' h₂
    refine RingHom.ext fun z => ?_
    obtain ⟨n, z, hz, rfl⟩ := HomogeneousLocalization.Away.mk_surjective _ (hy a) z
    rw [RingHom.comp_apply, RingHom.comp_apply, L1, HomogeneousLocalization.awayMap_mk,
      HomogeneousLocalization.awayMap_mk]
    apply HomogeneousLocalization.val_injective
    rw [HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.Away.mk,
      HomogeneousLocalization.map_mk, HomogeneousLocalization.val_mk]
    subst hx hx'
    congr 1
    · show φ z * ℓ b ^ n = φ (z * MvPolynomial.X b ^ n)
      rw [map_mul, map_pow, hφX]
    · apply Subtype.ext
      show (ℓ a * ℓ b) ^ n = φ ((MvPolynomial.X a * MvPolynomial.X b) ^ n)
      rw [map_pow, map_mul, hφX, hφX]
  have C5 : ∀ i (r : K), HomogeneousLocalization.map φ (h i)
      (HomogeneousLocalization.fromZeroRingHom (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) K)
        (Submonoid.powers (MvPolynomial.X i)) (algebraMap K _ r)) =
      HomogeneousLocalization.fromZeroRingHom
        (MvPolynomial.homogeneousSubmodule (Fin (M + 1 + 1)) K)
        (Submonoid.powers (ℓ i)) (algebraMap K _ r) := by
    intro i r
    apply HomogeneousLocalization.val_injective
    change (HomogeneousLocalization.map φ (h i) (HomogeneousLocalization.mk
        ⟨0, algebraMap K _ r, 1, by rw [SetLike.GradeZero.coe_one]; exact Submonoid.one_mem _⟩)).val =
      (HomogeneousLocalization.mk
        ⟨0, algebraMap K _ r, 1, by rw [SetLike.GradeZero.coe_one]; exact Submonoid.one_mem _⟩ :
          HomogeneousLocalization (MvPolynomial.homogeneousSubmodule (Fin (M + 1 + 1)) K)
            (Submonoid.powers (ℓ i))).val
    rw [HomogeneousLocalization.map_mk, HomogeneousLocalization.val_mk,
      HomogeneousLocalization.val_mk]
    congr 1
    · show φ ((algebraMap K (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) K 0) r :
          MvPolynomial (Fin (M + 1)) K)) = _
      rw [SetLike.GradeZero.coe_algebraMap, SetLike.GradeZero.coe_algebraMap, hφ, AlgHom.commutes]
    · apply Subtype.ext
      show φ (((1 : MvPolynomial.homogeneousSubmodule (Fin (M + 1)) K 0)) :
        MvPolynomial (Fin (M + 1)) K) = ((1 : MvPolynomial.homogeneousSubmodule (Fin (M + 1 + 1)) K 0) :
          MvPolynomial (Fin (M + 1 + 1)) K)
      rw [SetLike.GradeZero.coe_one, SetLike.GradeZero.coe_one, map_one]
  have C6 : ∀ i j, HomogeneousLocalization.map φ (h j)
      (HomogeneousLocalization.Away.isLocalizationElem (hy j) (hy i)) =
      HomogeneousLocalization.Away.isLocalizationElem (hℓ' j) (hℓ' i) := by
    intro i j
    unfold HomogeneousLocalization.Away.isLocalizationElem
    rw [L1]
    apply HomogeneousLocalization.val_injective
    rw [HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.Away.val_mk, map_pow, hφX]

  let U : (wcProjK K (M + 1)).Opens :=
    ⨆ i, Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (M + 1 + 1)) K) (ℓ i)
  let c : ∀ i, Spec (CommRingCat.of (HomogeneousLocalization.Away
      (MvPolynomial.homogeneousSubmodule (Fin (M + 1 + 1)) K) (ℓ i))) ⟶ (U : Scheme) :=
    fun i => (Proj.basicOpenIsoSpec _ (ℓ i) (hℓ' i) one_pos).inv ≫
      (wcProjK K (M + 1)).homOfLE (le_iSup (fun i => Proj.basicOpen
        (MvPolynomial.homogeneousSubmodule (Fin (M + 1 + 1)) K) (ℓ i)) i)
  have K1 : ∀ i, c i ≫ U.ι = Proj.awayι _ (ℓ i) (hℓ' i) one_pos := by
    intro i
    simp only [c, Category.assoc, Scheme.homOfLE_ι, Proj.basicOpenIsoSpec_inv_ι]
  have hcov : ∀ z : (U : Scheme), ∃ i w, c i w = z := by
    intro z
    obtain ⟨i, hi⟩ := TopologicalSpace.Opens.mem_iSup.mp z.2
    refine ⟨i, (Proj.basicOpenIsoSpec _ (ℓ i) (hℓ' i) one_pos).hom ⟨z.1, hi⟩, ?_⟩
    apply Subtype.ext
    simp only [c, Scheme.Hom.comp_apply]
    have e := Scheme.hom_inv_apply (Proj.basicOpenIsoSpec _ (ℓ i) (hℓ' i) one_pos) ⟨z.1, hi⟩
    refine (Scheme.homOfLE_apply _ _).trans ?_
    rw [e]
  let 𝒰 : (U : Scheme).OpenCover :=
    Scheme.Cover.mkOfCovers (P := @IsOpenImmersion) (Fin (M + 1)) _ c hcov (fun i => inferInstance)

  let f : ∀ i, Spec (CommRingCat.of (HomogeneousLocalization.Away
      (MvPolynomial.homogeneousSubmodule (Fin (M + 1 + 1)) K) (ℓ i))) ⟶ wcProjK K M :=
    fun i => Spec.map (CommRingCat.ofHom (HomogeneousLocalization.map φ (h i))) ≫
      Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) K) (MvPolynomial.X i) (hy i)
        one_pos
  have cocycle : ∀ i j, Spec.map (CommRingCat.ofHom (HomogeneousLocalization.awayMap _ (hℓ' j)
      (rfl : ℓ i * ℓ j = ℓ i * ℓ j))) ≫ f i =
      Spec.map (CommRingCat.ofHom (HomogeneousLocalization.awayMap _ (hℓ' i)
        (mul_comm (ℓ i) (ℓ j)))) ≫ f j := by
    intro i j
    simp only [f]
    rw [← Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp,
      C4 i j _ _ rfl rfl (h₂ i j), CommRingCat.ofHom_comp, Spec.map_comp, Category.assoc,
      Proj.SpecMap_awayMap_awayι]
    rw [← Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp,
      C4 j i _ _ (mul_comm (MvPolynomial.X i) (MvPolynomial.X j)) (mul_comm (ℓ i) (ℓ j)) (h₂ i j),
      CommRingCat.ofHom_comp, Spec.map_comp, Category.assoc, Proj.SpecMap_awayMap_awayι]
  have hglue : ∀ i j, Limits.pullback.fst (𝒰.f i) (𝒰.f j) ≫ f i =
      Limits.pullback.snd (𝒰.f i) (𝒰.f j) ≫ f j := by
    intro i j
    change Limits.pullback.fst (c i) (c j) ≫ f i = Limits.pullback.snd (c i) (c j) ≫ f j
    have w : Limits.pullback.fst (c i) (c j) ≫ Proj.awayι _ (ℓ i) (hℓ' i) one_pos =
        Limits.pullback.snd (c i) (c j) ≫ Proj.awayι _ (ℓ j) (hℓ' j) one_pos := by
      rw [← K1 i, ← K1 j, ← Category.assoc, Limits.pullback.condition, Category.assoc]
    have e1 := Proj.pullbackAwayιIso_inv_fst
      (MvPolynomial.homogeneousSubmodule (Fin (M + 1 + 1)) K) (hℓ' i) one_pos (hℓ' j) one_pos
      (rfl : ℓ i * ℓ j = ℓ i * ℓ j)
    have e2 := Proj.pullbackAwayιIso_inv_snd
      (MvPolynomial.homogeneousSubmodule (Fin (M + 1 + 1)) K) (hℓ' i) one_pos (hℓ' j) one_pos
      (rfl : ℓ i * ℓ j = ℓ i * ℓ j)
    obtain ⟨t, ht1, ht2⟩ : ∃ t : Limits.pullback (c i) (c j) ⟶ Spec (CommRingCat.of
        (HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (M + 1 + 1)) K)
          (ℓ i * ℓ j))),
        Limits.pullback.fst (c i) (c j) = t ≫
          Spec.map (CommRingCat.ofHom (HomogeneousLocalization.awayMap _ (hℓ' j)
            (rfl : ℓ i * ℓ j = ℓ i * ℓ j))) ∧
        Limits.pullback.snd (c i) (c j) = t ≫
          Spec.map (CommRingCat.ofHom (HomogeneousLocalization.awayMap _ (hℓ' i)
            (mul_comm (ℓ i) (ℓ j)))) := by
      refine ⟨Limits.pullback.lift _ _ w ≫
        (Proj.pullbackAwayιIso (MvPolynomial.homogeneousSubmodule (Fin (M + 1 + 1)) K) (hℓ' i)
          one_pos (hℓ' j) one_pos (rfl : ℓ i * ℓ j = ℓ i * ℓ j)).hom, ?_, ?_⟩
      · rw [Category.assoc, ← e1, Iso.hom_inv_id_assoc, Limits.pullback.lift_fst]
      · rw [Category.assoc, ← e2, Iso.hom_inv_id_assoc, Limits.pullback.lift_snd]
    rw [ht1, ht2, Category.assoc, Category.assoc, cocycle i j]
  let π : (U : Scheme) ⟶ wcProjK K M := 𝒰.glueMorphisms f hglue
  have hπ : ∀ i, c i ≫ π = f i := fun i => 𝒰.ι_glueMorphisms f hglue i
  refine ⟨π, ?_, ?_⟩
  · apply 𝒰.hom_ext
    intro i
    change c i ≫ π ≫ _ = c i ≫ U.ι ≫ _
    rw [← Category.assoc, hπ i, ← Category.assoc (c i), K1 i]
    simp only [f, Category.assoc]
    rw [← Category.assoc (Proj.awayι _ _ _ _), Proj.awayι_toSpecZero,
      ← Category.assoc (Proj.awayι _ _ _ _), Proj.awayι_toSpecZero]
    simp only [← Spec.map_comp, ← CommRingCat.ofHom_comp]
    congr 2
    exact RingHom.ext fun r => C5 i r
  · intro i
    apply TopologicalSpace.Opens.ext
    refine Set.ext fun z => ?_
    obtain ⟨j, w, rfl⟩ := hcov z
    have key2 : (c j ≫ π) ⁻¹ᵁ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) K)
          (MvPolynomial.X i) =
        (c j ≫ U.ι) ⁻¹ᵁ
          Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (M + 1 + 1)) K) (ℓ i) := by
      rw [hπ j, K1 j]
      simp only [f]
      rw [Scheme.Hom.comp_preimage, Proj.awayι_preimage_basicOpen _ (hy j) one_pos (hy i) one_pos,
        Proj.awayι_preimage_basicOpen _ (hℓ' j) one_pos (hℓ' i) one_pos,
        SpecMap_preimage_basicOpen]
      congr 1
      exact C6 i j
    have hw := SetLike.ext_iff.mp key2 w
    simp only [Scheme.Hom.comp_preimage, Scheme.Hom.mem_preimage] at hw
    simp only [SetLike.mem_coe, Scheme.Hom.mem_preimage]
    exact hw

theorem wc_finite_projection_step : ∀ (K : Type u) [Field K] [IsAlgClosed K] (M : ℕ) (W : Scheme.{u})
    (h : W ⟶ wcProjK K (M + 1)), IsFinite h → Set.range h ≠ Set.univ →
    ∃ h' : W ⟶ wcProjK K M, IsFinite h' :=
by
  intro K _ _ M W h hh hne
  classical

  have c4 : ∀ (n : ℕ) (x : wcProjK K n), ∃ i : Fin (n + 1), x ∈ @Proj.basicOpen _ _ _ _ _
      (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) MvPolynomial.gradedAlgebra
      (MvPolynomial.X i) := by
    intro n x
    letI : GradedRing (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) :=
      MvPolynomial.gradedAlgebra
    by_contra hx
    push_neg at hx
    apply x.not_irrelevant_le
    intro a ha
    have hi : ∀ i, MvPolynomial.X i ∈ x.asHomogeneousIdeal.toIdeal := fun i => by
      have := hx i
      rw [Proj.mem_basicOpen, not_not] at this
      exact HomogeneousIdeal.mem_iff.mpr this
    rw [HomogeneousIdeal.mem_irrelevant_iff, GradedRing.proj_apply] at ha
    have ha' : MvPolynomial.homogeneousComponent 0 a = 0 :=
      (MvPolynomial.decomposition.decompose'_apply a 0).symm.trans ha
    rw [MvPolynomial.homogeneousComponent_zero, MvPolynomial.C_eq_zero] at ha'
    have hspan : a ∈ Ideal.span (MvPolynomial.X '' (Set.univ : Set (Fin (n + 1)))) := by
      rw [MvPolynomial.mem_ideal_span_X_image]
      intro m hm
      by_contra hc
      push_neg at hc
      have hm0 : m = 0 := Finsupp.ext fun i => hc i (Set.mem_univ i)
      rw [hm0] at hm
      exact (MvPolynomial.mem_support_iff.mp hm) ha'
    have hle : Ideal.span (MvPolynomial.X '' (Set.univ : Set (Fin (n + 1)))) ≤
        x.asHomogeneousIdeal.toIdeal := by
      rw [Ideal.span_le]
      rintro _ ⟨i, _, rfl⟩
      exact hi i
    exact HomogeneousIdeal.mem_iff.mp (hle hspan)

  have c1 : ∀ (n : ℕ) (F : Set (wcProjK K n)), IsClosed F → F ≠ Set.univ →
      ∃ (d : ℕ) (g : MvPolynomial (Fin (n + 1)) K), g.IsHomogeneous d ∧ 1 ≤ d ∧ g ≠ 0 ∧
        ∀ x ∈ F, x ∉ @Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)
          MvPolynomial.gradedAlgebra g := by
    intro n F hF hne
    letI : GradedRing (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) :=
      MvPolynomial.gradedAlgebra
    have hdec : ∀ (φ : MvPolynomial (Fin (n + 1)) K) (i : ℕ),
        ((DirectSum.decompose (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) φ) i :
          MvPolynomial (Fin (n + 1)) K) = MvPolynomial.homogeneousComponent i φ :=
      fun φ i => MvPolynomial.decomposition.decompose'_apply φ i
    have hcomp : ∀ (I : HomogeneousIdeal (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K))
        (f : MvPolynomial (Fin (n + 1)) K),
        f ∈ I ↔ ∀ e, MvPolynomial.homogeneousComponent e f ∈ I := by
      intro I f
      rw [← HomogeneousIdeal.mem_iff, I.isHomogeneous.mem_iff]
      simp only [hdec, HomogeneousIdeal.mem_iff]
    obtain ⟨s, hs⟩ := (ProjectiveSpectrum.isClosed_iff_zeroLocus _ F).mp hF
    obtain ⟨y, hy⟩ : ∃ y, y ∉ F := by
      by_contra h
      push_neg at h
      exact hne (Set.eq_univ_of_forall h)
    have hy' : ¬ (s ⊆ (y.asHomogeneousIdeal : Set (MvPolynomial (Fin (n + 1)) K))) := by
      intro h
      apply hy
      rw [hs]
      exact (ProjectiveSpectrum.mem_zeroLocus _ y s).mpr h
    rw [Set.not_subset] at hy'
    obtain ⟨f, hfs, hfy⟩ := hy'
    obtain ⟨e, he⟩ : ∃ e, MvPolynomial.homogeneousComponent e f ∉ y.asHomogeneousIdeal := by
      by_contra hc
      push_neg at hc
      exact hfy ((hcomp _ f).mpr hc)
    refine ⟨e + 1, MvPolynomial.X 0 * MvPolynomial.homogeneousComponent e f, ?_, by omega, ?_, ?_⟩
    · have := (MvPolynomial.isHomogeneous_X K (0 : Fin (n + 1))).mul
        (MvPolynomial.homogeneousComponent_isHomogeneous e f)
      rwa [show 1 + e = e + 1 from Nat.add_comm 1 e] at this
    · refine mul_ne_zero (MvPolynomial.X_ne_zero _) ?_
      intro h0
      rw [h0] at he
      exact he (zero_mem _)
    · intro x hx
      rw [hs] at hx
      have hx' := (ProjectiveSpectrum.mem_zeroLocus _ x s).mp hx
      rw [Proj.mem_basicOpen, not_not]
      have hfx : f ∈ x.asHomogeneousIdeal := hx' hfs
      have hfe := (hcomp _ f).mp hfx e
      exact HomogeneousIdeal.mem_iff.mp (Ideal.mul_mem_left _ _ (HomogeneousIdeal.mem_iff.mpr hfe))

  have c2 : ∀ (d : ℕ) (g : MvPolynomial (Fin (M + 1 + 1)) K), g.IsHomogeneous d → 1 ≤ d → g ≠ 0 →
      ∃ ℓ : Fin (M + 1) → MvPolynomial (Fin (M + 1 + 1)) K, (∀ i, (ℓ i).IsHomogeneous 1) ∧
        ∀ P : Ideal (MvPolynomial (Fin (M + 1 + 1)) K), P.IsPrime → g ∈ P → (∀ i, ℓ i ∈ P) →
          ∀ j, MvPolynomial.X j ∈ P := by
    intro d g hg hd hg0
    obtain ⟨a, ha⟩ : ∃ a : Fin (M + 1 + 1) → K, MvPolynomial.eval a g ≠ 0 := by
      by_contra hc
      push_neg at hc
      exact hg0 (MvPolynomial.funext fun x => by rw [hc x, map_zero])
    obtain ⟨k, hk⟩ : ∃ k, a k ≠ 0 := by
      by_contra hc
      push_neg at hc
      have h0 : a = 0 := funext hc
      apply ha
      rw [h0, MvPolynomial.eval_zero, MvPolynomial.constantCoeff_eq]
      exact hg.coeff_eq_zero (by rw [map_zero]; omega)
    have scale : ∀ {R : Type u} [CommRing R] [Algebra K R] (t : R) (w : Fin (M + 1 + 1) → R),
        MvPolynomial.aeval (fun j => t * w j) g = t ^ d * MvPolynomial.aeval w g := by
      intro R _ _ t w
      rw [MvPolynomial.aeval_def, MvPolynomial.aeval_def, MvPolynomial.eval₂_eq',
        MvPolynomial.eval₂_eq', Finset.mul_sum]
      refine Finset.sum_congr rfl fun m hm => ?_
      have hdeg : Finsupp.degree m = d := by
        by_contra hne
        exact (MvPolynomial.mem_support_iff.mp hm) (hg.coeff_eq_zero hne)
      rw [Finsupp.degree_eq_sum] at hdeg
      simp only [mul_pow, Finset.prod_mul_distrib, Finset.prod_pow_eq_pow_sum, hdeg]
      ring
    refine ⟨fun i => MvPolynomial.C (a k) * MvPolynomial.X (k.succAbove i) -
        MvPolynomial.C (a (k.succAbove i)) * MvPolynomial.X k, fun i =>
        ((MvPolynomial.isHomogeneous_X K _).C_mul _).sub
          ((MvPolynomial.isHomogeneous_X K _).C_mul _), ?_⟩
    intro P hP hgP hℓP
    haveI := hP
    let R := MvPolynomial (Fin (M + 1 + 1)) K ⧸ P
    let q : MvPolynomial (Fin (M + 1 + 1)) K →ₐ[K] R := Ideal.Quotient.mkₐ K P
    have hq0 : ∀ p, q p = 0 ↔ p ∈ P := fun p => by
      rw [Ideal.Quotient.mkₐ_eq_mk]
      exact Ideal.Quotient.eq_zero_iff_mem
    let v : Fin (M + 1 + 1) → R := fun j => q (MvPolynomial.X j)
    have claim : ∀ j, algebraMap K R (a k) * v j = v k * algebraMap K R (a j) := by
      intro j
      by_cases hj : j = k
      · subst hj; ring
      · obtain ⟨i, rfl⟩ := Fin.exists_succAbove_eq hj
        have h1 := (hq0 _).mpr (hℓP i)
        simp only [map_sub, map_mul, MvPolynomial.algHom_C] at h1
        rw [sub_eq_zero] at h1
        simp only [v]
        rw [h1, mul_comm]
    haveI : Nontrivial R := Ideal.Quotient.nontrivial_iff.mpr hP.ne_top
    have hv : MvPolynomial.aeval v g = 0 := by
      have : q = MvPolynomial.aeval (⇑q ∘ MvPolynomial.X) := MvPolynomial.aeval_unique q
      have h2 : q g = 0 := (hq0 g).mpr hgP
      rw [this] at h2
      exact h2
    have hev : MvPolynomial.aeval (fun j => algebraMap K R (a j)) g =
        algebraMap K R (MvPolynomial.eval a g) := by
      rw [MvPolynomial.aeval_def, MvPolynomial.eval, MvPolynomial.coe_eval₂Hom,
        MvPolynomial.eval₂_comp_left, RingHom.comp_id]
      rfl
    have key : v k ^ d * algebraMap K R (MvPolynomial.eval a g) = 0 := by
      rw [← hev, ← scale, ← funext claim, scale, hv, mul_zero]
    have hne' : algebraMap K R (MvPolynomial.eval a g) ≠ 0 :=
      (map_ne_zero (algebraMap K R)).mpr ha
    have hvk : v k = 0 := by
      have := (mul_eq_zero.mp key).resolve_right hne'
      exact (pow_eq_zero_iff (by omega)).mp this
    intro j
    rw [← hq0]
    have hj := claim j
    rw [hvk, zero_mul] at hj
    have hak : algebraMap K R (a k) ≠ 0 := (map_ne_zero (algebraMap K R)).mpr hk
    exact (mul_eq_zero.mp hj).resolve_left hak

  haveI := hh
  have hcl : IsClosed (Set.range h) := h.isClosedMap.isClosed_range
  obtain ⟨d, g, hg, hd, hg0, hgF⟩ := c1 (M + 1) _ hcl hne
  obtain ⟨ℓ, hℓ, hP⟩ := c2 d g hg hd hg0
  obtain ⟨π, hπstr, hπpre⟩ := wc_proj_linear_projection_morphism K M ℓ hℓ
  letI : GradedRing (MvPolynomial.homogeneousSubmodule (Fin (M + 1 + 1)) K) :=
    MvPolynomial.gradedAlgebra
  letI : GradedRing (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) K) :=
    MvPolynomial.gradedAlgebra
  have hrange : Set.range h ⊆ ((⨆ i : Fin (M + 1), Proj.basicOpen
      (MvPolynomial.homogeneousSubmodule (Fin (M + 1 + 1)) K) (ℓ i) :
        (wcProjK K (M + 1)).Opens) : Set _) := by
    rintro _ ⟨w, rfl⟩
    by_contra hx
    have hx' : ∀ i, ℓ i ∈ (h w).asHomogeneousIdeal.toIdeal := by
      intro i
      by_contra hi
      apply hx
      rw [SetLike.mem_coe, TopologicalSpace.Opens.mem_iSup]
      exact ⟨i, (Proj.mem_basicOpen _ _ _).mpr hi⟩
    have hgx : g ∈ (h w).asHomogeneousIdeal.toIdeal := by
      have := hgF (h w) ⟨w, rfl⟩
      rw [Proj.mem_basicOpen, not_not] at this
      exact this
    obtain ⟨j, hj⟩ := c4 (M + 1) (h w)
    rw [Proj.mem_basicOpen] at hj
    exact hj (hP _ (h w).isPrime hgx hx' j)
  set h₀ := IsOpenImmersion.lift (Scheme.Opens.ι _) h
    (by rw [Scheme.Opens.range_ι]; exact hrange) with hh₀
  have hfac : h₀ ≫ Scheme.Opens.ι _ = h := IsOpenImmersion.lift_fac _ _ _
  refine ⟨h₀ ≫ π, ?_⟩
  haveI := wc_proj_space_isProper K M
  haveI := wc_proj_space_isProper K (M + 1)
  have hcomp : (h₀ ≫ π) ≫ wcProjKStr K M = h ≫ wcProjKStr K (M + 1) := by
    rw [Category.assoc, hπstr, ← Category.assoc, hfac]
  haveI : IsProper ((h₀ ≫ π) ≫ wcProjKStr K M) := by rw [hcomp]; infer_instance
  haveI : IsProper (h₀ ≫ π) := IsProper.of_comp _ (wcProjKStr K M)
  haveI : IsAffineHom (h₀ ≫ π) := by
    apply isAffineHom_of_forall_exists_isAffineOpen
    intro y
    obtain ⟨i, hi⟩ := c4 M y
    refine ⟨_, hi, ?_, ?_⟩
    · exact Proj.isAffineOpen_basicOpen _ _
        ((MvPolynomial.mem_homogeneousSubmodule _ _).mpr (MvPolynomial.isHomogeneous_X K i)) one_pos
    · rw [Scheme.Hom.comp_preimage, hπpre i, ← Scheme.Hom.comp_preimage, hfac]
      exact IsAffineHom.isAffine_preimage _ (Proj.isAffineOpen_basicOpen _ _
        ((MvPolynomial.mem_homogeneousSubmodule _ _).mpr (hℓ i)) one_pos)
  exact IsFinite.iff_isProper_and_isAffineHom.mpr ⟨inferInstance, inferInstance⟩

theorem wc_proj_linear_closed_embedding : ∀ (K : Type u) [Field K] (N M : ℕ), N ≤ M →
    ∃ ι : wcProjK K N ⟶ wcProjK K M, IsClosedImmersion ι :=
by
  intro K _ N M hNM
  classical

  have s4 : ∀ {A B σ τ : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A] [CommRing B]
      [SetLike τ B] [AddSubgroupClass τ B] {𝒜 : ℕ → σ} {ℬ : ℕ → τ} [GradedRing 𝒜] [GradedRing ℬ]
      (f : 𝒜 →+*ᵍ ℬ)
      (hf : HomogeneousIdeal.irrelevant ℬ ≤ HomogeneousIdeal.map f (HomogeneousIdeal.irrelevant 𝒜))
      {ι : Type} (s : ι → A) (d : ι → ℕ), (∀ i, s i ∈ 𝒜 (d i)) → (∀ i, 0 < d i) →
      (HomogeneousIdeal.irrelevant 𝒜).toIdeal ≤ Ideal.span (Set.range s) →
      (∀ i, Function.Surjective (HomogeneousLocalization.Away.map f (s i))) →
      IsClosedImmersion (Proj.map f hf) := by
    intro A B σ τ _ _ _ _ _ _ 𝒜 ℬ _ _ f hf ι s d hs hd hcov hsurj
    refine IsZariskiLocalAtTarget.of_iSup_eq_top (P := @IsClosedImmersion)
      (fun i => Proj.basicOpen 𝒜 (s i)) (Proj.iSup_basicOpen_eq_top 𝒜 s hcov) ?_
    intro i
    have hs' : f (s i) ∈ ℬ (d i) := f.map_mem (hs i)
    let iV := Proj.awayι 𝒜 (s i) (hs i) (hd i)
    let iU := Proj.awayι ℬ (f (s i)) hs' (hd i)
    let g := Spec.map (CommRingCat.ofHom (HomogeneousLocalization.Away.map f (s i)))
    have hc : iU ≫ Proj.map f hf = g ≫ iV := Proj.awayι_comp_map f hf (hd i) (s i) (hs i)
    have hpre : Proj.map f hf ⁻¹ᵁ iV.opensRange = iU.opensRange := by
      simp only [iV, iU, Proj.opensRange_awayι]
      exact Proj.map_preimage_basicOpen f hf (s i)
    have hpb : IsPullback g iU iV (Proj.map f hf) := IsOpenImmersion.isPullback g iU iV _ hc hpre
    have hg : IsClosedImmersion g :=
      IsClosedImmersion.spec_of_surjective _ (by simpa using hsurj i)
    have h1 : IsClosedImmersion (Limits.pullback.snd (Proj.map f hf) iV) :=
      (MorphismProperty.arrow_mk_iso_iff @IsClosedImmersion
        (Arrow.isoMk hpb.flip.isoPullback (Iso.refl _)
          (by
            dsimp only [Arrow.mk_hom, Iso.refl_hom]
            rw [Category.comp_id]
            exact IsPullback.isoPullback_hom_snd _))).mp hg
    have h2 : IsClosedImmersion (Proj.map f hf ∣_ iV.opensRange) :=
      (MorphismProperty.arrow_mk_iso_iff @IsClosedImmersion
        (morphismRestrictOpensRange _ iV)).mpr h1
    exact (MorphismProperty.arrow_mk_iso_iff @IsClosedImmersion
      (morphismRestrictEq _ (Proj.opensRange_awayι 𝒜 (s i) (hs i) (hd i)))).mp h2

  have s3 : ∀ {A B σ τ : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A] [CommRing B]
      [SetLike τ B] [AddSubgroupClass τ B] {𝒜 : ℕ → σ} {ℬ : ℕ → τ} [GradedRing 𝒜] [GradedRing ℬ]
      (f : 𝒜 →+*ᵍ ℬ), (∀ (n : ℕ) (b : B), b ∈ ℬ n → ∃ a ∈ 𝒜 n, f a = b) →
      ∀ (s : A) (d : ℕ), s ∈ 𝒜 d → Function.Surjective (HomogeneousLocalization.Away.map f s) := by
    intro A B σ τ _ _ _ _ _ _ 𝒜 ℬ _ _ f hsurj s d hs y
    obtain ⟨n, b, hb, rfl⟩ := HomogeneousLocalization.Away.mk_surjective ℬ (f.map_mem hs) y
    obtain ⟨a, ha, rfl⟩ := hsurj _ b hb
    exact ⟨_, HomogeneousLocalization.Away.map_mk f s hs n a ha⟩

  have s1 : ∀ (n : ℕ) (p : MvPolynomial (Fin n) K),
      letI : GradedRing (MvPolynomial.homogeneousSubmodule (Fin n) K) := MvPolynomial.gradedAlgebra
      p ∈ HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin n) K) ↔
        p.coeff 0 = 0 := by
    intro n p
    letI : GradedRing (MvPolynomial.homogeneousSubmodule (Fin n) K) := MvPolynomial.gradedAlgebra
    rw [HomogeneousIdeal.mem_irrelevant_iff, GradedRing.proj_apply]
    erw [MvPolynomial.decomposition.decompose'_apply]
    rw [MvPolynomial.homogeneousComponent_zero, MvPolynomial.C_eq_zero]
  letI iA : GradedRing (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) K) :=
    MvPolynomial.gradedAlgebra
  letI iB : GradedRing (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) :=
    MvPolynomial.gradedAlgebra

  let g : Fin (M + 1) → MvPolynomial (Fin (N + 1)) K :=
    fun i => if h : (i : ℕ) < N + 1 then MvPolynomial.X ⟨i, h⟩ else 0
  have hg : ∀ i, (g i).IsHomogeneous 1 := by
    intro i
    simp only [g]
    split_ifs
    · exact MvPolynomial.isHomogeneous_X K _
    · exact MvPolynomial.isHomogeneous_zero _ _ 1
  let φ : GradedRingHom (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) K)
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) :=
    ⟨(MvPolynomial.aeval g).toRingHom, fun {n x} hx => by
      rw [MvPolynomial.mem_homogeneousSubmodule] at hx ⊢
      have := hx.aeval g hg
      rw [one_mul] at this
      exact this⟩
  let c : Fin (N + 1) → Fin (M + 1) := Fin.castLE (by omega)
  let ψ : GradedRingHom (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
      (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) K) :=
    ⟨(MvPolynomial.rename c).toRingHom, fun {n x} hx => by
      rw [MvPolynomial.mem_homogeneousSubmodule] at hx ⊢
      exact hx.rename_isHomogeneous⟩
  have hφψ : ∀ b, φ (ψ b) = b := by
    intro b
    show MvPolynomial.aeval g (MvPolynomial.rename c b) = b
    rw [MvPolynomial.aeval_rename]
    have hgc : g ∘ c = MvPolynomial.X := by
      funext j
      have hj : ((c j : Fin (M + 1)) : ℕ) < N + 1 := by simp [c, j.isLt]
      rw [Function.comp_apply]
      simp only [g]
      rw [dif_pos hj]
      congr 1
    rw [hgc, MvPolynomial.aeval_X_left_apply]
  have hf : HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) ≤
      HomogeneousIdeal.map φ
        (HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) K)) := by
    intro b hb
    have hb0 : b.coeff 0 = 0 := (s1 (N + 1) b).mp hb
    have hψ : ψ b ∈
        HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) K) := by
      apply (s1 (M + 1) (ψ b)).mpr
      rw [← MvPolynomial.constantCoeff_eq] at hb0 ⊢
      exact (MvPolynomial.constantCoeff_rename c b).trans hb0
    rw [← HomogeneousIdeal.mem_iff, HomogeneousIdeal.toIdeal_map, ← hφψ b]
    exact Ideal.mem_map_of_mem φ (HomogeneousIdeal.mem_iff.mpr hψ)
  have hdeg : ∀ (n : ℕ) (b : MvPolynomial (Fin (N + 1)) K),
      b ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K n →
      ∃ a ∈ MvPolynomial.homogeneousSubmodule (Fin (M + 1)) K n, φ a = b :=
    fun n b hb => ⟨ψ b, ψ.map_mem hb, hφψ b⟩
  have hcov : (HomogeneousIdeal.irrelevant
      (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) K)).toIdeal ≤
      Ideal.span (Set.range (MvPolynomial.X : Fin (M + 1) → MvPolynomial (Fin (M + 1)) K)) := by
    intro x hx
    have hx0 : x.coeff 0 = 0 := (s1 (M + 1) x).mp (HomogeneousIdeal.mem_iff.mp hx)
    rw [← Set.image_univ, MvPolynomial.mem_ideal_span_X_image]
    intro m hm
    have hm0 : m ≠ 0 := by
      rintro rfl
      exact (MvPolynomial.mem_support_iff.mp hm) hx0
    obtain ⟨i, hi⟩ := Finsupp.ne_iff.mp hm0
    exact ⟨i, Set.mem_univ _, by simpa using hi⟩
  have hX : ∀ i : Fin (M + 1),
      (MvPolynomial.X i : MvPolynomial (Fin (M + 1)) K) ∈
        MvPolynomial.homogeneousSubmodule (Fin (M + 1)) K 1 :=
    fun i => (MvPolynomial.mem_homogeneousSubmodule 1 _).2 (MvPolynomial.isHomogeneous_X K i)
  exact ⟨Proj.map φ hf, s4 φ hf (fun i : Fin (M + 1) => MvPolynomial.X i) (fun _ => 1) hX
    (fun _ => Nat.one_pos) hcov (fun i => s3 φ hdeg _ 1 (hX i))⟩

theorem wc_dim_range_closed_map_le : ∀ (X Y : Type u) [TopologicalSpace X] [TopologicalSpace Y]
    [QuasiSober Y] (f : X → Y), Continuous f → IsClosedMap f →
    topologicalKrullDim ↥(Set.range f) ≤ topologicalKrullDim X :=
by
  intro X Y _ _ _ f hf hfc
  classical

  have s1 : ∀ {α β : Type u} [Preorder α] [Preorder β] (φ : α → β), Function.Surjective φ →
      (∀ (a : α) (b : β), b < φ a → ∃ a' : α, a' < a ∧ φ a' = b) →
      Order.krullDim β ≤ Order.krullDim α := by
    intro α β _ _ φ hs hl
    have key : ∀ q : LTSeries β, ∃ p : LTSeries α, p.length = q.length ∧ φ p.head = q.head := by
      intro q
      induction q using RelSeries.inductionOn with
      | singleton x =>
        obtain ⟨a, ha⟩ := hs x
        exact ⟨RelSeries.singleton _ a, by simp, by simpa using ha⟩
      | cons q x hx ih =>
        obtain ⟨p, hpl, hph⟩ := ih
        have hx' : x < q.head := hx
        obtain ⟨a', ha'lt, ha'⟩ := hl p.head x (by rw [hph]; exact hx')
        refine ⟨p.cons a' ha'lt, ?_, ?_⟩
        · simp [hpl]
        · simpa using ha'
    unfold Order.krullDim
    apply iSup_le
    intro q
    obtain ⟨p, hpl, _⟩ := key q
    rw [← hpl]
    exact le_iSup (fun p : LTSeries α => (p.length : WithBot ℕ∞)) p

  let g : X → Set.range f := Set.rangeFactorization f
  have hg : Continuous g := hf.subtype_mk _
  have hgc : IsClosedMap g := hfc.codRestrict _
  have hgs : Function.Surjective g := Set.rangeFactorization_surjective
  haveI : QuasiSober (Set.range f) := hfc.isClosed_range.isClosedEmbedding_subtypeVal.quasiSober

  have s2 : ∀ (Z : Set X) (T : Set (Set.range f)), IsClosed Z → IsIrreducible T → IsClosed T →
      T ⊆ g '' Z → ∃ Z' : Set X, Z' ⊆ Z ∧ IsClosed Z' ∧ IsIrreducible Z' ∧ g '' Z' = T := by
    intro Z T hZ hT hTc hTZ
    obtain ⟨y, hy⟩ := QuasiSober.sober hT hTc
    obtain ⟨x, hxZ, rfl⟩ := hTZ hy.mem
    refine ⟨closure {x}, closure_minimal (Set.singleton_subset_iff.mpr hxZ) hZ, isClosed_closure,
      isIrreducible_singleton.closure, ?_⟩
    rw [← hgc.closure_image_eq_of_continuous hg, Set.image_singleton]
    exact hy.def

  let Φ : TopologicalSpace.IrreducibleCloseds X →
      TopologicalSpace.IrreducibleCloseds (Set.range f) :=
    fun Z => ⟨g '' Z, Z.isIrreducible.image g hg.continuousOn, hgc _ Z.isClosed⟩
  show Order.krullDim _ ≤ Order.krullDim _
  apply s1 Φ
  · intro T
    obtain ⟨Z', -, hZ'c, hZ'i, hZ'⟩ := s2 Set.univ T isClosed_univ T.isIrreducible T.isClosed
      (by rw [Set.image_univ_of_surjective hgs]; exact Set.subset_univ _)
    exact ⟨⟨Z', hZ'i, hZ'c⟩, TopologicalSpace.IrreducibleCloseds.ext hZ'⟩
  · intro Z T hT
    have hsub : (T : Set (Set.range f)) ⊆ g '' Z := hT.le
    obtain ⟨Z', hZ'Z, hZ'c, hZ'i, hZ'⟩ := s2 Z T Z.isClosed T.isIrreducible T.isClosed hsub
    have hΦ : Φ ⟨Z', hZ'i, hZ'c⟩ = T := TopologicalSpace.IrreducibleCloseds.ext hZ'
    refine ⟨⟨Z', hZ'i, hZ'c⟩, lt_of_le_of_ne hZ'Z ?_, hΦ⟩
    intro hW
    exact (ne_of_lt hT) (hΦ.symm.trans (congrArg Φ hW))

theorem wc_proj_space_dim : ∀ (K : Type u) [Field K] (n : ℕ),
    topologicalKrullDim ↥(wcProjK K n) = (n : WithBot ℕ∞) :=
by
  intro K _ n
  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) :=
    MvPolynomial.gradedAlgebra


  have hH : ∀ {S : Type u} [CommRing S] (g h : MvPolynomial (Fin (n + 1)) K →+* S) (s : S),
      (∀ r, g (MvPolynomial.C r) = h (MvPolynomial.C r)) →
      (∀ l, g (MvPolynomial.X l) = s * h (MvPolynomial.X l)) →
      ∀ (a : MvPolynomial (Fin (n + 1)) K) (k : ℕ), a.IsHomogeneous k → g a = s ^ k * h a := by
    intro S _ g h s hC hXs a k ha
    conv_lhs => rw [a.as_sum]
    conv_rhs => rw [a.as_sum]
    rw [map_sum, map_sum, Finset.mul_sum]
    refine Finset.sum_congr rfl fun d hd => ?_
    have hdeg := ha (MvPolynomial.mem_support_iff.mp hd)
    simp only [Finsupp.weight_apply, Finsupp.sum, smul_eq_mul, mul_one, Pi.one_apply] at hdeg
    rw [MvPolynomial.monomial_eq, map_mul, map_mul, hC, Finsupp.prod, map_prod, map_prod]
    simp only [map_pow, hXs, mul_pow]
    rw [Finset.prod_mul_distrib, Finset.prod_pow_eq_pow_sum, hdeg]
    ring
  have hX : ∀ l, (MvPolynomial.X l : MvPolynomial (Fin (n + 1)) K) ∈
      MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K 1 := fun l =>
    (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K l)

  have hchart : ∀ i : Fin (n + 1), Nonempty (HomogeneousLocalization.Away
      (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X i) ≃+*
        MvPolynomial (Fin n) K) := by
    intro i
    let ev : MvPolynomial (Fin (n + 1)) K →+* MvPolynomial (Fin n) K :=
      MvPolynomial.eval₂Hom MvPolynomial.C (Fin.insertNth i 1 MvPolynomial.X)
    have hev_i : ev (MvPolynomial.X i) = 1 := by simp [ev]
    have hev_s : ∀ j, ev (MvPolynomial.X (i.succAbove j)) = MvPolynomial.X j := by simp [ev]
    have hev_C : ∀ r, ev (MvPolynomial.C r) = MvPolynomial.C r := by simp [ev]
    have hunit : IsUnit (ev (MvPolynomial.X i)) := by rw [hev_i]; exact isUnit_one
    let lam : Localization.Away (MvPolynomial.X i : MvPolynomial (Fin (n + 1)) K) →+*
        MvPolynomial (Fin n) K := Localization.awayLift ev (MvPolynomial.X i) hunit
    let ψ : HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)
        (MvPolynomial.X i) →+* MvPolynomial (Fin n) K := lam.comp (algebraMap _ _)
    have hψ : ∀ k a (ha : a ∈ MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K (k • 1)),
        ψ (HomogeneousLocalization.Away.mk _ (hX i) k a ha) = ev a := by
      intro k a ha
      simp only [ψ, lam, RingHom.comp_apply, HomogeneousLocalization.algebraMap_apply,
        HomogeneousLocalization.Away.val_mk]
      rw [Localization.awayLift_mk ev _ a 1 (by rw [hev_i, one_mul]) k, one_pow, mul_one]
    let c : K →+* HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)
        (MvPolynomial.X i) :=
      (algebraMap (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K 0) _).comp
        (algebraMap K (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K 0))
    have hc : ∀ r, (c r).val = algebraMap (MvPolynomial (Fin (n + 1)) K) (Localization.Away
        (MvPolynomial.X i : MvPolynomial (Fin (n + 1)) K)) (MvPolynomial.C r) := by
      intro r
      simp only [c, RingHom.comp_apply, HomogeneousLocalization.algebraMap_eq]
      rw [← Localization.mk_one_eq_algebraMap]
      rfl
    let y : Fin n → HomogeneousLocalization.Away
        (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X i) := fun j =>
      HomogeneousLocalization.Away.mk _ (hX i) 1 (MvPolynomial.X (i.succAbove j))
        (by rw [one_smul]; exact hX _)
    let φ : MvPolynomial (Fin n) K →+* HomogeneousLocalization.Away
        (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X i) :=
      MvPolynomial.eval₂Hom c y
    have hlamA : ∀ a, lam (algebraMap (MvPolynomial (Fin (n + 1)) K) (Localization.Away
        (MvPolynomial.X i : MvPolynomial (Fin (n + 1)) K)) a) = ev a := by
      intro a
      simp only [lam]
      rw [← Localization.mk_one_eq_algebraMap]
      have := Localization.awayLift_mk ev (MvPolynomial.X i) a 1 (by rw [hev_i, one_mul]) 0
      simp only [pow_zero, mul_one] at this
      convert this
    have h1 : ψ.comp φ = RingHom.id _ := by
      apply MvPolynomial.ringHom_ext
      · intro r
        simp only [RingHom.comp_apply, RingHom.id_apply, φ, MvPolynomial.eval₂Hom_C, ψ]
        rw [HomogeneousLocalization.algebraMap_apply, hc, hlamA, hev_C]
      · intro j
        simp only [RingHom.comp_apply, RingHom.id_apply, φ, MvPolynomial.eval₂Hom_X']
        rw [hψ, hev_s]
    let θ := (algebraMap (HomogeneousLocalization.Away
        (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X i))
        (Localization.Away (MvPolynomial.X i : MvPolynomial (Fin (n + 1)) K))).comp (φ.comp ev)
    have hθ : ∀ (k : ℕ) (a : MvPolynomial (Fin (n + 1)) K), a.IsHomogeneous k →
        algebraMap (MvPolynomial (Fin (n + 1)) K)
          (Localization.Away (MvPolynomial.X i : MvPolynomial (Fin (n + 1)) K)) a =
        (algebraMap (MvPolynomial (Fin (n + 1)) K)
          (Localization.Away (MvPolynomial.X i : MvPolynomial (Fin (n + 1)) K))
          (MvPolynomial.X i)) ^ k * θ a := by
      intro k a ha
      apply hH _ θ _ _ _ a k ha
      · intro r
        simp only [θ, RingHom.comp_apply, hev_C, φ, MvPolynomial.eval₂Hom_C]
        rw [HomogeneousLocalization.algebraMap_apply, hc]
      · intro l
        rcases Fin.eq_self_or_eq_succAbove i l with rfl | ⟨j, rfl⟩
        · simp only [θ, RingHom.comp_apply, hev_i, map_one, mul_one]
        · simp only [θ, RingHom.comp_apply, hev_s, φ, MvPolynomial.eval₂Hom_X']
          rw [HomogeneousLocalization.algebraMap_apply, HomogeneousLocalization.Away.val_mk,
            ← Localization.mk_one_eq_algebraMap, ← Localization.mk_one_eq_algebraMap,
            Localization.mk_mul, Localization.mk_eq_mk_iff, Localization.r_iff_exists]
          refine ⟨1, ?_⟩
          simp only [OneMemClass.coe_one, one_mul, pow_one]
          try ring
    have h2 : φ.comp ψ = RingHom.id _ := by
      ext z
      obtain ⟨k, a, ha, rfl⟩ := HomogeneousLocalization.Away.mk_surjective _ (hX i) z
      rw [RingHom.comp_apply, hψ, RingHom.id_apply]
      rw [HomogeneousLocalization.Away.val_mk, Localization.mk_eq_mk',
        IsLocalization.eq_mk'_iff_mul_eq]
      have hh : a.IsHomogeneous k := by
        have := (MvPolynomial.mem_homogeneousSubmodule _ _).mp ha
        simpa using this
      rw [hθ k a hh, mul_comm]
      congr 1
      exact map_pow _ _ _
    exact ⟨RingEquiv.ofRingHom ψ φ h1 h2⟩

  have hdimU : ∀ i : Fin (n + 1), topologicalKrullDim ↥(Proj.basicOpen
      (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X i)) =
        (n : WithBot ℕ∞) := by
    intro i
    obtain ⟨e⟩ := hchart i
    have hR : topologicalKrullDim (Spec (CommRingCat.of (HomogeneousLocalization.Away
        (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X i)))) =
        ringKrullDim (HomogeneousLocalization.Away
          (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X i)) :=
      PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim _
    have hiso := IsHomeomorph.topologicalKrullDim_eq _ (Scheme.homeoOfIso (Proj.basicOpenIsoSpec
      (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X i) (hX i)
        one_pos)).isHomeomorph
    refine hiso.trans ?_
    rw [hR, ringKrullDim_eq_of_ringEquiv e, MvPolynomial.ringKrullDim_of_isNoetherianRing,
      ringKrullDim_eq_zero_of_field]
    simp

  have hcover : (⨆ i : Fin (n + 1), Proj.basicOpen
      (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X i)) = ⊤ := by
    apply Proj.iSup_basicOpen_eq_top _ (fun i => MvPolynomial.X i)
    intro a ha
    have ha' := (HomogeneousIdeal.mem_irrelevant_iff _ a).mp ha
    have h0 : MvPolynomial.homogeneousComponent 0 a = 0 := by
      rw [← MvPolynomial.decomposition.decompose'_apply]
      exact ha'
    rw [MvPolynomial.homogeneousComponent_zero, MvPolynomial.C_eq_zero] at h0
    rw [← Set.image_univ, MvPolynomial.mem_ideal_span_X_image]
    intro m hm
    have hm0 : m ≠ 0 := by
      rintro rfl
      exact (MvPolynomial.mem_support_iff.mp hm) h0
    obtain ⟨l, hl⟩ := Finsupp.ne_iff.mp hm0
    exact ⟨l, Set.mem_univ _, hl⟩

  have s2 : ∀ (ι : Type) (U : ι → (wcProjK K n).Opens), (∀ x : wcProjK K n, ∃ i, x ∈ U i) →
      ∀ N : ℕ, (∀ i, topologicalKrullDim (U i) ≤ (N : WithBot ℕ∞)) →
      topologicalKrullDim (wcProjK K n) ≤ (N : WithBot ℕ∞) := by
    intro ι U hcov N hN
    unfold topologicalKrullDim Order.krullDim
    refine iSup_le fun p => ?_
    obtain ⟨x, hx⟩ := (p 0).isIrreducible.nonempty
    obtain ⟨i, hi⟩ := hcov x
    have hmem : ∀ j, x ∈ (p j : Set (wcProjK K n)) := fun j => (p.monotone (Fin.zero_le j)) hx
    let T : Fin (p.length + 1) → TopologicalSpace.IrreducibleCloseds (U i) := fun j =>
      { carrier := (Subtype.val : U i → wcProjK K n) ⁻¹' (p j : Set (wcProjK K n))
        isIrreducible' := ⟨⟨⟨x, hi⟩, hmem j⟩, (p j).isIrreducible.isPreirreducible.preimage
          (U i).isOpen.isOpenEmbedding_subtypeVal⟩
        isClosed' := (p j).isClosed.preimage continuous_subtype_val }
    have hT : StrictMono T := by
      intro a b hab
      have hlt : p a < p b := p.strictMono hab
      refine lt_of_le_of_ne ?_ ?_
      · intro y hy
        exact (p.monotone hab.le) hy
      · intro heq
        apply hlt.ne
        apply le_antisymm hlt.le
        have h1 : (p b : Set (wcProjK K n)) ⊆
            closure ((p b : Set (wcProjK K n)) ∩ (U i : Set (wcProjK K n))) :=
          subset_closure_inter_of_isPreirreducible_of_isOpen
            (p b).isIrreducible.isPreirreducible (U i).isOpen ⟨x, hmem b, hi⟩
        have h2 : (p b : Set (wcProjK K n)) ∩ (U i : Set (wcProjK K n)) ⊆
            (p a : Set (wcProjK K n)) := by
          rintro y ⟨hyb, hyU⟩
          have hy : (⟨y, hyU⟩ : U i) ∈ (T b : Set (U i)) := hyb
          rw [← heq] at hy
          exact hy
        intro y hy
        have := closure_mono h2 (h1 hy)
        rwa [(p a).isClosed.closure_eq] at this
    let q : LTSeries (TopologicalSpace.IrreducibleCloseds (U i)) :=
      ⟨p.length, T, fun j => hT Fin.castSucc_lt_succ⟩
    have := Order.LTSeries.length_le_krullDim q
    exact this.trans (hN i)
  have hup : topologicalKrullDim (wcProjK K n) ≤ (n : WithBot ℕ∞) := by
    refine s2 (Fin (n + 1)) (fun i => Proj.basicOpen
      (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X i)) ?_ n
      (fun i => (hdimU i).le)
    intro x
    have hx : x ∈ (⊤ : (wcProjK K n).Opens) := trivial
    rw [← hcover] at hx
    exact TopologicalSpace.Opens.mem_iSup.mp hx
  have hlow : (n : WithBot ℕ∞) ≤ topologicalKrullDim (wcProjK K n) := by
    rw [← hdimU 0]
    exact topologicalKrullDim_subspace_le _ _
  exact le_antisymm hup hlow

theorem wc_blowup_center : ∀ (K : Type u) [Field K] (n : ℕ), ∃ p : ↥(wcProjK K (n + 1)),
    IsClosed ({p} : Set _) ∧ ∀ x : ↥(wcProjK K (n + 1)), x ≠ p ↔ ∃ j : Fin (n + 1),
      x ∈ @Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (n + 1 + 1)) K)
        MvPolynomial.gradedAlgebra (MvPolynomial.X (Fin.castSucc j)) :=
by
  intro K _ n
  classical
  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (n + 1 + 1)) K) :=
    MvPolynomial.gradedAlgebra

  have hd : ∀ d : Fin (n + 1 + 1) →₀ ℕ, (∀ j : Fin (n + 1), d (Fin.castSucc j) = 0) →
      d = Finsupp.single (Fin.last (n + 1)) (d (Fin.last (n + 1))) := by
    intro d hdj
    ext i
    rcases Fin.eq_castSucc_or_eq_last i with ⟨j, rfl⟩ | rfl
    · simp [Finsupp.single_apply, hdj j, (Fin.castSucc_ne_last j).symm]
    · simp
  have hsingle : ∀ (j : Fin (n + 1)) (k : ℕ),
      Finsupp.single (Fin.last (n + 1)) k (Fin.castSucc j) = 0 := by
    intro j k
    simp [Finsupp.single_apply, (Fin.castSucc_ne_last j).symm]
  obtain ⟨I, hIdef⟩ : ∃ I : Ideal (MvPolynomial (Fin (n + 1 + 1)) K), I = Ideal.span
      (Set.range fun j : Fin (n + 1) =>
        (MvPolynomial.X (Fin.castSucc j) : MvPolynomial (Fin (n + 1 + 1)) K)) := ⟨_, rfl⟩
  have hI_eq : I = Ideal.span (MvPolynomial.X '' Set.range
      (Fin.castSucc : Fin (n + 1) → Fin (n + 1 + 1))) := by
    rw [hIdef, ← Set.range_comp]
    rfl

  have s1 : ∀ f : MvPolynomial (Fin (n + 1 + 1)) K,
      f ∈ I ↔ ∀ k : ℕ, f.coeff (Finsupp.single (Fin.last (n + 1)) k) = 0 := by
    intro f
    rw [hI_eq, MvPolynomial.mem_ideal_span_X_image]
    constructor
    · intro h k
      by_contra hc
      obtain ⟨i, ⟨j, rfl⟩, hi⟩ := h _ (MvPolynomial.mem_support_iff.mpr hc)
      exact hi (hsingle j k)
    · intro h m hm
      by_contra hc
      push_neg at hc
      have hm' := hd m (fun j => hc _ ⟨j, rfl⟩)
      apply MvPolynomial.mem_support_iff.mp hm
      rw [hm']
      exact h _

  have s2 : ∀ (f : MvPolynomial (Fin (n + 1 + 1)) K) (k : ℕ),
      (MvPolynomial.aeval (fun i : Fin (n + 1 + 1) =>
        if i = Fin.last (n + 1) then (Polynomial.X : Polynomial K) else 0) f).coeff k =
      f.coeff (Finsupp.single (Fin.last (n + 1)) k) := by
    intro f k
    induction f using MvPolynomial.induction_on' with
    | monomial d c =>
      rw [MvPolynomial.aeval_monomial, MvPolynomial.coeff_monomial]
      by_cases hpure : ∀ j : Fin (n + 1), d (Fin.castSucc j) = 0
      · rw [hd d hpure, Finsupp.prod_single_index (h := fun i e =>
            (if i = Fin.last (n + 1) then (Polynomial.X : Polynomial K) else 0) ^ e) (pow_zero _),
          if_pos (rfl : Fin.last (n + 1) = Fin.last (n + 1)),
          ← Polynomial.C_eq_algebraMap, Polynomial.coeff_C_mul_X_pow]
        by_cases hk : k = d (Fin.last (n + 1))
        · rw [if_pos hk, if_pos (by rw [hk])]
        · rw [if_neg hk, if_neg]
          intro h
          exact hk (Finsupp.single_injective _ h).symm
      · push_neg at hpure
        obtain ⟨j, hj⟩ := hpure
        have hprod : (d.prod fun i e =>
            (if i = Fin.last (n + 1) then (Polynomial.X : Polynomial K) else 0) ^ e) = 0 := by
          rw [Finsupp.prod]
          exact Finset.prod_eq_zero (Finsupp.mem_support_iff.mpr hj)
            (by rw [if_neg (Fin.castSucc_ne_last j), zero_pow hj])
        rw [hprod, mul_zero, Polynomial.coeff_zero, if_neg]
        intro h
        apply hj
        rw [h]
        exact hsingle j k
    | add p q hp hq =>
      rw [map_add, Polynomial.coeff_add, MvPolynomial.coeff_add, hp, hq]

  have hIprime : I.IsPrime := by
    have hker : I = RingHom.ker (MvPolynomial.aeval (fun i : Fin (n + 1 + 1) =>
        if i = Fin.last (n + 1) then (Polynomial.X : Polynomial K) else 0)) := by
      ext f
      rw [s1, RingHom.mem_ker, Polynomial.ext_iff]
      simp only [s2, Polynomial.coeff_zero]
    rw [hker]
    exact RingHom.ker_isPrime _

  have hIhom : I.IsHomogeneous (MvPolynomial.homogeneousSubmodule (Fin (n + 1 + 1)) K) := by
    rw [hIdef]
    apply Ideal.homogeneous_span
    rintro _ ⟨j, rfl⟩
    exact ⟨1, (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K _)⟩

  have hirr : ∀ a : MvPolynomial (Fin (n + 1 + 1)) K,
      a ∈ HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (n + 1 + 1)) K) ↔
        a.coeff 0 = 0 := by
    intro a
    have e : GradedRing.proj (MvPolynomial.homogeneousSubmodule (Fin (n + 1 + 1)) K) 0 a =
        MvPolynomial.homogeneousComponent 0 a := by
      rw [← MvPolynomial.decomposition.decompose'_apply]
      rfl
    rw [HomogeneousIdeal.mem_irrelevant_iff, e, MvPolynomial.homogeneousComponent_zero,
      MvPolynomial.C_eq_zero]
  have hXL_irr : (MvPolynomial.X (Fin.last (n + 1)) : MvPolynomial (Fin (n + 1 + 1)) K) ∈
      HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (n + 1 + 1)) K) :=
    (hirr _).mpr (MvPolynomial.coeff_zero_X _)
  have hXL_notI : (MvPolynomial.X (Fin.last (n + 1)) : MvPolynomial (Fin (n + 1 + 1)) K) ∉ I := by
    rw [s1]
    intro h
    have h1 := h 1
    rw [MvPolynomial.coeff_X] at h1
    simp at h1

  obtain ⟨Ih, hIhdef⟩ : ∃ Ih : HomogeneousIdeal (MvPolynomial.homogeneousSubmodule (Fin (n + 1 + 1)) K),
      Ih = Ideal.homogeneousCore (MvPolynomial.homogeneousSubmodule (Fin (n + 1 + 1)) K) I :=
    ⟨_, rfl⟩
  have hIh : Ih.toIdeal = I := by
    rw [hIhdef]
    exact hIhom.toIdeal_homogeneousCore_eq_self
  have hprime : Ih.toIdeal.IsPrime := by rw [hIh]; exact hIprime
  have hrel : ¬ HomogeneousIdeal.irrelevant
      (MvPolynomial.homogeneousSubmodule (Fin (n + 1 + 1)) K) ≤ Ih := by
    intro hle
    apply hXL_notI
    have h1 : (MvPolynomial.X (Fin.last (n + 1)) : MvPolynomial (Fin (n + 1 + 1)) K) ∈
        Ih.toIdeal := hle hXL_irr
    rwa [hIh] at h1
  let p : ↥(wcProjK K (n + 1)) := ProjectiveSpectrum.mk Ih hprime hrel

  have s5 : ∀ x : ↥(wcProjK K (n + 1)),
      (∀ j : Fin (n + 1), (MvPolynomial.X (Fin.castSucc j) : MvPolynomial (Fin (n + 1 + 1)) K) ∈
        x.asHomogeneousIdeal.toIdeal) → x = p := by
    intro x hx
    have hIx : I ≤ x.asHomogeneousIdeal.toIdeal := by
      rw [hIdef, Ideal.span_le]
      rintro _ ⟨j, rfl⟩
      exact hx j
    have hXL : (MvPolynomial.X (Fin.last (n + 1)) : MvPolynomial (Fin (n + 1 + 1)) K) ∉
        x.asHomogeneousIdeal.toIdeal := by
      intro hL
      apply x.not_irrelevant_le
      intro a ha
      rw [hirr] at ha
      have hspan : a ∈ Ideal.span (MvPolynomial.X '' (Set.univ : Set (Fin (n + 1 + 1)))) := by
        rw [MvPolynomial.mem_ideal_span_X_image]
        intro m hm
        have hm0 : m ≠ 0 := by
          rintro rfl
          exact (MvPolynomial.mem_support_iff.mp hm) ha
        obtain ⟨l, hl⟩ := Finsupp.ne_iff.mp hm0
        exact ⟨l, Set.mem_univ _, hl⟩
      have hle : Ideal.span (MvPolynomial.X '' (Set.univ : Set (Fin (n + 1 + 1)))) ≤
          x.asHomogeneousIdeal.toIdeal := by
        rw [Ideal.span_le]
        rintro _ ⟨i, -, rfl⟩
        rcases Fin.eq_castSucc_or_eq_last i with ⟨j, rfl⟩ | rfl
        · exact hx j
        · exact hL
      exact hle hspan
    have hhom : ∀ f ∈ x.asHomogeneousIdeal.toIdeal, ∀ d : ℕ,
        MvPolynomial.homogeneousComponent d f ∈ x.asHomogeneousIdeal.toIdeal := by
      intro f hf d
      have h1 := (x.asHomogeneousIdeal.isHomogeneous.mem_iff).mp hf d
      rw [← MvPolynomial.decomposition.decompose'_apply]
      exact h1
    have hle : x.asHomogeneousIdeal.toIdeal ≤ I := by
      intro f hf
      rw [s1]
      intro k
      by_contra hc
      obtain ⟨c, hcdef⟩ : ∃ c : K, c = f.coeff (Finsupp.single (Fin.last (n + 1)) k) := ⟨_, rfl⟩
      rw [← hcdef] at hc
      have hh := hhom f hf k
      have hg : MvPolynomial.homogeneousComponent k f -
          MvPolynomial.C c * MvPolynomial.X (Fin.last (n + 1)) ^ k ∈ I := by
        rw [s1]
        intro k'
        rw [MvPolynomial.coeff_sub, MvPolynomial.coeff_C_mul, MvPolynomial.coeff_X_pow,
          MvPolynomial.coeff_homogeneousComponent, Finsupp.degree_single]
        by_cases hk : k' = k
        · rw [hk, if_pos rfl, if_pos rfl, hcdef, mul_one, sub_self]
        · rw [if_neg hk, if_neg (fun h' => hk (Finsupp.single_injective _ h').symm), mul_zero,
            sub_zero]
      have hc' : MvPolynomial.C c * MvPolynomial.X (Fin.last (n + 1)) ^ k ∈
          x.asHomogeneousIdeal.toIdeal := by
        have h2 := Ideal.sub_mem _ hh (hIx hg)
        rwa [sub_sub_cancel] at h2
      have hpow : (MvPolynomial.X (Fin.last (n + 1)) : MvPolynomial (Fin (n + 1 + 1)) K) ^ k ∈
          x.asHomogeneousIdeal.toIdeal := by
        have h2 := Ideal.mul_mem_left _ (MvPolynomial.C c⁻¹) hc'
        rwa [← mul_assoc, ← MvPolynomial.C_mul, inv_mul_cancel₀ hc, MvPolynomial.C_1,
          one_mul] at h2
      exact hXL (x.isPrime.mem_of_pow_mem k hpow)
    apply ProjectiveSpectrum.ext
    apply HomogeneousIdeal.toIdeal_injective
    change x.asHomogeneousIdeal.toIdeal = Ih.toIdeal
    rw [hIh]
    exact le_antisymm hle hIx

  have s6 : ∀ x : ↥(wcProjK K (n + 1)), x ≠ p ↔ ∃ j : Fin (n + 1),
      x ∈ @Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (n + 1 + 1)) K)
        MvPolynomial.gradedAlgebra (MvPolynomial.X (Fin.castSucc j)) := by
    intro x
    simp only [Proj.mem_basicOpen]
    constructor
    · intro hne
      by_contra hall
      push_neg at hall
      exact hne (s5 x hall)
    · rintro ⟨j, hj⟩ rfl
      apply hj
      change (MvPolynomial.X (Fin.castSucc j) : MvPolynomial (Fin (n + 1 + 1)) K) ∈ Ih.toIdeal
      rw [hIh, hIdef]
      exact Ideal.subset_span ⟨j, rfl⟩

  refine ⟨p, ?_, s6⟩
  have hcompl : ({p} : Set ↥(wcProjK K (n + 1)))ᶜ = ⋃ j : Fin (n + 1),
      ((@Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (n + 1 + 1)) K)
        MvPolynomial.gradedAlgebra (MvPolynomial.X (Fin.castSucc j)) :
          (wcProjK K (n + 1)).Opens) : Set ↥(wcProjK K (n + 1))) := by
    ext x
    rw [Set.mem_compl_singleton_iff, Set.mem_iUnion]
    exact s6 x
  rw [← isOpen_compl_iff, hcompl]
  exact isOpen_iUnion fun j => TopologicalSpace.Opens.isOpen _

theorem wc_bc_awayMap_calculus : (∀ {A σ : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A] (𝒜 : ℕ → σ) [GradedRing 𝒜] (f g h k x z : A) (e e' e'' : ℕ) (hg : g ∈ 𝒜 e) (hh : h ∈ 𝒜 e') (hk : k ∈ 𝒜 e'') (hx : x = f * g) (hz : z = x * h) (hz' : z = f * k), k = g * h → (HomogeneousLocalization.awayMap 𝒜 hh hz).comp (HomogeneousLocalization.awayMap 𝒜 hg hx) = HomogeneousLocalization.awayMap 𝒜 hk hz') ∧ (∀ {A σ : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A] (𝒜 : ℕ → σ) [GradedRing 𝒜] (f g : A) (e : ℕ) (hg : g ∈ 𝒜 e) (hx : f = f * g), g = 1 → HomogeneousLocalization.awayMap 𝒜 hg hx = RingHom.id _) ∧ (∀ {A σ : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A] (𝒜 : ℕ → σ) [GradedRing 𝒜] (f g x : A) (e : ℕ) (hg : g ∈ 𝒜 e) (hx : x = f * g) (a : ↥(𝒜 0)), HomogeneousLocalization.awayMap 𝒜 hg hx (algebraMap ↥(𝒜 0) (HomogeneousLocalization.Away 𝒜 f) a) = algebraMap ↥(𝒜 0) (HomogeneousLocalization.Away 𝒜 x) a) ∧ (∀ {A σ : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A] (𝒜 : ℕ → σ) [GradedRing 𝒜] (x : Submonoid A), HomogeneousLocalization.fromZeroRingHom 𝒜 x = algebraMap ↥(𝒜 0) (HomogeneousLocalization 𝒜 x)) :=
by
  have key : ∀ {A : Type u} [CommRing A] (y w : A)
      (hu : IsUnit (algebraMap A (Localization.Away w) y)),
      (Localization.awayLift (algebraMap A (Localization.Away w)) y hu).comp
        (algebraMap A (Localization.Away y)) = algebraMap A (Localization.Away w) := by
    intro A _ y w hu
    exact IsLocalization.Away.lift_comp y hu
  refine ⟨?_, ?_, ?_, ?_⟩
  · intro A σ _ _ _ 𝒜 _ f g h k x z e e' e'' hg hh hk hx hz hz' _
    have hc : ∀ (u₁ : IsUnit (algebraMap A (Localization.Away x) f))
        (u₂ : IsUnit (algebraMap A (Localization.Away z) x))
        (u₃ : IsUnit (algebraMap A (Localization.Away z) f)),
        (Localization.awayLift (algebraMap A (Localization.Away z)) x u₂).comp
          (Localization.awayLift (algebraMap A (Localization.Away x)) f u₁) =
          Localization.awayLift (algebraMap A (Localization.Away z)) f u₃ := by
      intro u₁ u₂ u₃
      apply IsLocalization.ringHom_ext (Submonoid.powers f)
      rw [RingHom.comp_assoc, key, key, key]
    refine RingHom.ext fun a => ?_
    apply HomogeneousLocalization.val_injective
    rw [RingHom.comp_apply, HomogeneousLocalization.val_awayMap,
      HomogeneousLocalization.val_awayMap, HomogeneousLocalization.val_awayMap]
    rw [← RingHom.comp_apply, hc]
  · intro A σ _ _ _ 𝒜 _ f g e hg hx _
    have hc : ∀ hu : IsUnit (algebraMap A (Localization.Away f) f),
        Localization.awayLift (algebraMap A (Localization.Away f)) f hu = RingHom.id _ := by
      intro hu
      apply IsLocalization.ringHom_ext (Submonoid.powers f)
      rw [key, RingHom.id_comp]
    refine RingHom.ext fun a => ?_
    apply HomogeneousLocalization.val_injective
    rw [HomogeneousLocalization.val_awayMap]
    exact RingHom.congr_fun (hc _) _
  · intro A σ _ _ _ 𝒜 _ f g x e hg hx a
    rw [HomogeneousLocalization.algebraMap_eq, HomogeneousLocalization.algebraMap_eq]
    exact HomogeneousLocalization.awayMap_fromZeroRingHom 𝒜 hg hx a
  · intro A σ _ _ _ 𝒜 _ x
    exact HomogeneousLocalization.algebraMap_eq.symm

theorem wc_bc_coord_identities : ∀ (K : Type u) [Field K] (n : ℕ),
  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) := MvPolynomial.gradedAlgebra
  ∀ (T T' : Finset (Fin (n + 1))) (j j' : Fin (n + 1))
    (hs : (∏ m ∈ T, MvPolynomial.X m : MvPolynomial (Fin (n + 1)) K) ∈ MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K T.card)
    (hs' : (∏ m ∈ T', MvPolynomial.X m : MvPolynomial (Fin (n + 1)) K) ∈ MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K T'.card)
    (hν : ∀ l, (MvPolynomial.X l * ∏ m ∈ T.erase j, MvPolynomial.X m : MvPolynomial (Fin (n + 1)) K) ∈
      MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K (1 • T.card))
    (hν' : ∀ l, (MvPolynomial.X l * ∏ m ∈ T'.erase j', MvPolynomial.X m : MvPolynomial (Fin (n + 1)) K) ∈
      MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K (1 • T'.card))
    (hν'' : ∀ l, (MvPolynomial.X l * ∏ m ∈ T.erase j', MvPolynomial.X m : MvPolynomial (Fin (n + 1)) K) ∈
      MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K (1 • T.card))
    (hg : (∏ m ∈ T \ T', MvPolynomial.X m : MvPolynomial (Fin (n + 1)) K) ∈ MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K (T \ T').card)
    (hx : (∏ m ∈ T, MvPolynomial.X m : MvPolynomial (Fin (n + 1)) K) = (∏ m ∈ T', MvPolynomial.X m) * ∏ m ∈ T \ T', MvPolynomial.X m),
    j ∈ T → j' ∈ T' → T' ⊆ T →
    HomogeneousLocalization.Away.mk _ hs 1 _ (hν j) = 1 ∧
    (∀ l, HomogeneousLocalization.awayMap _ hg hx (HomogeneousLocalization.Away.mk _ hs' 1 _ (hν' l)) *
        HomogeneousLocalization.Away.mk _ hs 1 _ (hν j') = HomogeneousLocalization.Away.mk _ hs 1 _ (hν l)) ∧
    HomogeneousLocalization.Away.mk _ hs 1 _ (hν j') * HomogeneousLocalization.Away.mk _ hs 1 _ (hν'' j) = 1 :=
by
  intro K _ n
  intro T T' j j' hs hs' hν hν' hν'' hg hx hj hj' hT
  have hE : (MvPolynomial.X j * ∏ m ∈ T.erase j, MvPolynomial.X m : MvPolynomial (Fin (n + 1)) K) =
      ∏ m ∈ T, MvPolynomial.X m := Finset.mul_prod_erase T (fun m => MvPolynomial.X m) hj
  have hE' : (MvPolynomial.X j' * ∏ m ∈ T'.erase j', MvPolynomial.X m : MvPolynomial (Fin (n + 1)) K) =
      ∏ m ∈ T', MvPolynomial.X m := Finset.mul_prod_erase T' (fun m => MvPolynomial.X m) hj'
  have hE'' : (MvPolynomial.X j' * ∏ m ∈ T.erase j', MvPolynomial.X m : MvPolynomial (Fin (n + 1)) K) =
      ∏ m ∈ T, MvPolynomial.X m := Finset.mul_prod_erase T (fun m => MvPolynomial.X m) (hT hj')
  refine ⟨?_, fun l => ?_, ?_⟩
  · apply HomogeneousLocalization.val_injective
    rw [HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.val_one, ← Localization.mk_one,
      Localization.mk_eq_mk_iff, Localization.r_iff_exists]
    refine ⟨1, ?_⟩
    simp only [OneMemClass.coe_one, Submonoid.coe_mul, one_mul, mul_one, pow_one]
    linear_combination hE
  · rw [HomogeneousLocalization.awayMap_mk]
    apply HomogeneousLocalization.val_injective
    rw [HomogeneousLocalization.val_mul, HomogeneousLocalization.Away.val_mk,
      HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.Away.val_mk, Localization.mk_mul,
      Localization.mk_eq_mk_iff, Localization.r_iff_exists]
    refine ⟨1, ?_⟩
    simp only [OneMemClass.coe_one, Submonoid.coe_mul, one_mul, mul_one, pow_one]
    linear_combination
      ((∏ m ∈ T, MvPolynomial.X m) * MvPolynomial.X l * (∏ m ∈ T.erase j, MvPolynomial.X m) *
        (∏ m ∈ T \ T', MvPolynomial.X m)) * hE' -
      ((∏ m ∈ T, MvPolynomial.X m) * MvPolynomial.X l * (∏ m ∈ T.erase j, MvPolynomial.X m)) * hx
  · apply HomogeneousLocalization.val_injective
    rw [HomogeneousLocalization.val_mul, HomogeneousLocalization.Away.val_mk,
      HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.val_one, Localization.mk_mul,
      ← Localization.mk_one, Localization.mk_eq_mk_iff, Localization.r_iff_exists]
    refine ⟨1, ?_⟩
    simp only [OneMemClass.coe_one, Submonoid.coe_mul, one_mul, mul_one, pow_one]
    linear_combination (MvPolynomial.X j' * ∏ m ∈ T.erase j', MvPolynomial.X m) * hE +
      (∏ m ∈ T, MvPolynomial.X m) * hE''

theorem wc_bc_basicOpen_coord : ∀ (K : Type u) [Field K] (n : ℕ),
  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) := MvPolynomial.gradedAlgebra
  ∀ (T : Finset (Fin (n + 1))) (j l : Fin (n + 1))
    (hs : (∏ m ∈ T, MvPolynomial.X m : MvPolynomial (Fin (n + 1)) K) ∈ MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K T.card)
    (hν : (MvPolynomial.X l * ∏ m ∈ T.erase j, MvPolynomial.X m : MvPolynomial (Fin (n + 1)) K) ∈
      MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K (1 • T.card))
    (hX : (MvPolynomial.X l : MvPolynomial (Fin (n + 1)) K) ∈ MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K 1),
    j ∈ T → PrimeSpectrum.basicOpen (HomogeneousLocalization.Away.mk _ hs 1 _ hν) =
      PrimeSpectrum.basicOpen (HomogeneousLocalization.Away.isLocalizationElem hs hX) :=
by
  intro K _ n
  intro T j l hs hν hX hj
  obtain ⟨k, hk⟩ : ∃ k, T.card = k + 1 :=
    ⟨T.card - 1, by have := Finset.card_pos.mpr ⟨j, hj⟩; omega⟩
  have KEY : (MvPolynomial.X j : MvPolynomial (Fin (n + 1)) K) *
      ∏ m ∈ T.erase j, MvPolynomial.X m = ∏ m ∈ T, MvPolynomial.X m :=
    Finset.mul_prod_erase T (fun m => MvPolynomial.X m) hj
  have hpcard : (T.erase j).card = k := by rw [Finset.card_erase_of_mem hj, hk]; rfl
  have hpH : (∏ m ∈ T.erase j, MvPolynomial.X m :
      MvPolynomial (Fin (n + 1)) K).IsHomogeneous k := by
    have := MvPolynomial.IsHomogeneous.prod (T.erase j)
      (fun m => (MvPolynomial.X m : MvPolynomial (Fin (n + 1)) K)) (fun _ => 1)
      (fun m _ => MvPolynomial.isHomogeneous_X K m)
    simpa [hpcard] using this
  have hw : (MvPolynomial.X l ^ k * MvPolynomial.X j : MvPolynomial (Fin (n + 1)) K) ∈
      MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K (1 • T.card) := by
    rw [MvPolynomial.mem_homogeneousSubmodule, smul_eq_mul, one_mul, hk]
    have h1 := ((MvPolynomial.isHomogeneous_X K l).pow k).mul (MvPolynomial.isHomogeneous_X K j)
    simpa using h1
  have hw' : ((∏ m ∈ T.erase j, MvPolynomial.X m) ^ (k + 1) :
      MvPolynomial (Fin (n + 1)) K) ∈
      MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K (k • T.card) := by
    rw [MvPolynomial.mem_homogeneousSubmodule, smul_eq_mul, hk]
    exact hpH.pow (k + 1)
  set ν := HomogeneousLocalization.Away.mk _ hs 1 _ hν with hν_def
  set e := HomogeneousLocalization.Away.isLocalizationElem hs hX with he_def
  set w := HomogeneousLocalization.Away.mk _ hs 1 _ hw with hw_def
  set w' := HomogeneousLocalization.Away.mk _ hs k _ hw' with hw'_def
  have hA : ν * w = e := by
    apply HomogeneousLocalization.val_injective
    rw [HomogeneousLocalization.val_mul]
    simp only [hν_def, hw_def, he_def, HomogeneousLocalization.Away.isLocalizationElem,
      HomogeneousLocalization.Away.val_mk, Localization.mk_mul]
    rw [Localization.mk_eq_mk_iff, Localization.r_iff_exists]
    refine ⟨1, ?_⟩
    simp only [Submonoid.coe_mul, OneMemClass.coe_one, one_mul, pow_one]
    rw [hk, ← KEY]
    ring
  have hB : ν ^ (k + 1) = e * w' := by
    apply HomogeneousLocalization.val_injective
    rw [HomogeneousLocalization.val_pow, HomogeneousLocalization.val_mul]
    simp only [hν_def, hw'_def, he_def, HomogeneousLocalization.Away.isLocalizationElem,
      HomogeneousLocalization.Away.val_mk, Localization.mk_mul, Localization.mk_pow]
    rw [Localization.mk_eq_mk_iff, Localization.r_iff_exists]
    refine ⟨1, ?_⟩
    simp only [Submonoid.coe_mul, SubmonoidClass.coe_pow, OneMemClass.coe_one, one_mul, pow_one]
    rw [hk]
    ring
  apply le_antisymm
  · calc PrimeSpectrum.basicOpen ν = PrimeSpectrum.basicOpen (ν ^ (k + 1)) :=
          (PrimeSpectrum.basicOpen_pow ν (k + 1) (Nat.succ_pos k)).symm
      _ = PrimeSpectrum.basicOpen (e * w') := by rw [hB]
      _ ≤ PrimeSpectrum.basicOpen e := PrimeSpectrum.basicOpen_mul_le_left e w'
  · calc PrimeSpectrum.basicOpen e = PrimeSpectrum.basicOpen (ν * w) := by rw [hA]
      _ ≤ PrimeSpectrum.basicOpen ν := PrimeSpectrum.basicOpen_mul_le_left ν w

theorem wc_bc_P1_preimage_basicOpen : ∀ (A : Type u) [CommRing A] (a : A), (wcP1 A ≫ Spec.map (CommRingCat.ofHom (algebraMap A ↥(MvPolynomial.homogeneousSubmodule (Fin 2) A 0)))) ⁻¹ᵁ PrimeSpectrum.basicOpen a = @Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) A) MvPolynomial.gradedAlgebra (MvPolynomial.C a) :=
by
  intro A _ a
  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin 2) A) := MvPolynomial.gradedAlgebra
  have hX : ∀ i : Fin 2, (MvPolynomial.X i : MvPolynomial (Fin 2) A) ∈
      MvPolynomial.homogeneousSubmodule (Fin 2) A 1 :=
    fun i => (MvPolynomial.mem_homogeneousSubmodule _ _).mpr (MvPolynomial.isHomogeneous_X A i)
  have hCX : ∀ i : Fin 2, (MvPolynomial.C a * MvPolynomial.X i : MvPolynomial (Fin 2) A) ∈
      MvPolynomial.homogeneousSubmodule (Fin 2) A 1 :=
    fun i => (MvPolynomial.mem_homogeneousSubmodule _ _).mpr (MvPolynomial.isHomogeneous_C_mul_X a i)
  have hY : (⨆ i : Fin 2, Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin 2) A)
      (MvPolynomial.X i)) = ⊤ := by
    apply Proj.iSup_basicOpen_eq_top _ (fun i => MvPolynomial.X i)
    intro p hp
    have ha' := (HomogeneousIdeal.mem_irrelevant_iff _ p).mp hp
    have h0 : MvPolynomial.homogeneousComponent 0 p = 0 := by
      rw [← MvPolynomial.decomposition.decompose'_apply]
      exact ha'
    rw [MvPolynomial.homogeneousComponent_zero, MvPolynomial.C_eq_zero] at h0
    rw [← Set.image_univ, MvPolynomial.mem_ideal_span_X_image]
    intro m hm
    have hm0 : m ≠ 0 := by
      rintro rfl
      exact (MvPolynomial.mem_support_iff.mp hm) h0
    obtain ⟨l, hl⟩ := Finsupp.ne_iff.mp hm0
    exact ⟨l, Set.mem_univ _, hl⟩
  have hkey : ∀ i : Fin 2, HomogeneousLocalization.fromZeroRingHom
      (MvPolynomial.homogeneousSubmodule (Fin 2) A) (Submonoid.powers (MvPolynomial.X i))
      (algebraMap A _ a) = HomogeneousLocalization.Away.isLocalizationElem (hX i) (hCX i) := by
    intro i
    apply HomogeneousLocalization.val_injective
    have hv : (HomogeneousLocalization.fromZeroRingHom
        (MvPolynomial.homogeneousSubmodule (Fin 2) A) (Submonoid.powers (MvPolynomial.X i))
        (algebraMap A _ a)).val = Localization.mk (MvPolynomial.C a) 1 := by
      first
      | rfl
      | (erw [HomogeneousLocalization.val_mk]; rfl)
    rw [hv]
    simp only [HomogeneousLocalization.Away.isLocalizationElem, HomogeneousLocalization.Away.val_mk]
    rw [Localization.mk_eq_mk_iff, Localization.r_iff_exists]
    refine ⟨1, ?_⟩
    dsimp only
    simp only [pow_one, OneMemClass.coe_one, Submonoid.coe_one, one_mul, mul_one]
    first
    | ring
    | simp [mul_comm]
  apply TopologicalSpace.Opens.ext
  ext x
  simp only [SetLike.mem_coe]
  have hx : x ∈ (⨆ i : Fin 2, Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin 2) A)
      (MvPolynomial.X i)) := by rw [hY]; trivial
  obtain ⟨i, hi⟩ := TopologicalSpace.Opens.mem_iSup.mp hx
  rw [← Proj.opensRange_awayι _ _ (hX i) one_pos] at hi
  obtain ⟨y, rfl⟩ := Scheme.Hom.mem_opensRange.mp hi
  have e : Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin 2) A) (MvPolynomial.X i) (hX i)
      one_pos ≫ wcP1 A = Spec.map (CommRingCat.ofHom (HomogeneousLocalization.fromZeroRingHom
        (MvPolynomial.homogeneousSubmodule (Fin 2) A) (Submonoid.powers (MvPolynomial.X i)))) := by
    unfold wcP1
    exact Proj.awayι_toSpecZero _ _ _ _
  have hy : (wcP1 A ≫ Spec.map (CommRingCat.ofHom (algebraMap A
      ↥(MvPolynomial.homogeneousSubmodule (Fin 2) A 0))))
      (Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin 2) A) (MvPolynomial.X i) (hX i) one_pos y) =
      (Spec.map (CommRingCat.ofHom (HomogeneousLocalization.fromZeroRingHom
        (MvPolynomial.homogeneousSubmodule (Fin 2) A) (Submonoid.powers (MvPolynomial.X i)))) ≫
        Spec.map (CommRingCat.ofHom (algebraMap A
          ↥(MvPolynomial.homogeneousSubmodule (Fin 2) A 0)))) y := by
    rw [← Scheme.Hom.comp_apply, ← Category.assoc, e]
  have h1 : Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin 2) A) (MvPolynomial.X i) (hX i)
      one_pos y ∈ (wcP1 A ≫ Spec.map (CommRingCat.ofHom (algebraMap A
        ↥(MvPolynomial.homogeneousSubmodule (Fin 2) A 0)))) ⁻¹ᵁ PrimeSpectrum.basicOpen a ↔
      y ∈ PrimeSpectrum.basicOpen (HomogeneousLocalization.Away.isLocalizationElem (hX i) (hCX i)) := by
    rw [← hkey i]
    change (wcP1 A ≫ Spec.map (CommRingCat.ofHom (algebraMap A
        ↥(MvPolynomial.homogeneousSubmodule (Fin 2) A 0))))
      (Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin 2) A) (MvPolynomial.X i) (hX i) one_pos y) ∈
        PrimeSpectrum.basicOpen a ↔ _
    rw [hy]
    first
    | exact Iff.rfl
    | (rw [Scheme.Hom.comp_apply, Spec.map_apply, Spec.map_apply]
       simp only [PrimeSpectrum.mem_basicOpen, PrimeSpectrum.comap_asIdeal, Ideal.mem_comap]
       rfl)
  have h2 : Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin 2) A) (MvPolynomial.X i) (hX i)
      one_pos y ∈ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin 2) A) (MvPolynomial.C a) ↔
      y ∈ PrimeSpectrum.basicOpen (HomogeneousLocalization.Away.isLocalizationElem (hX i) (hCX i)) := by
    have hpre := Proj.awayι_preimage_basicOpen (MvPolynomial.homogeneousSubmodule (Fin 2) A)
      (hX i) one_pos (hCX i) one_pos
    have hmem : Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin 2) A) (MvPolynomial.X i) (hX i)
        one_pos y ∈ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin 2) A) (MvPolynomial.X i) := by
      rw [← Proj.opensRange_awayι _ _ (hX i) one_pos]
      exact ⟨y, rfl⟩
    have hiff : y ∈ Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin 2) A) (MvPolynomial.X i)
        (hX i) one_pos ⁻¹ᵁ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin 2) A)
          (MvPolynomial.C a * MvPolynomial.X i) ↔
        Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin 2) A) (MvPolynomial.X i) (hX i)
          one_pos y ∈ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin 2) A)
            (MvPolynomial.C a * MvPolynomial.X i) := Iff.rfl
    rw [hpre] at hiff
    rw [Proj.basicOpen_mul] at hiff
    refine Iff.trans ?_ hiff.symm
    constructor
    · intro h
      exact ⟨h, hmem⟩
    · intro h
      exact h.1
  exact h1.trans h2.symm

theorem wc_bc_proj_map_toSpecZero : ∀ {A B σ τ : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A] [CommRing B] [SetLike τ B]
    [AddSubgroupClass τ B] {𝒜 : ℕ → σ} {ℬ : ℕ → τ} [GradedRing 𝒜] [GradedRing ℬ] (f : 𝒜 →+*ᵍ ℬ)
    (hf : HomogeneousIdeal.irrelevant ℬ ≤ HomogeneousIdeal.map f (HomogeneousIdeal.irrelevant 𝒜))
    (f₀ : ↥(𝒜 0) →+* ↥(ℬ 0)), (∀ a : ↥(𝒜 0), ((f₀ a : ↥(ℬ 0)) : B) = f (a : A)) →
    Proj.map f hf ≫ Proj.toSpecZero 𝒜 = Proj.toSpecZero ℬ ≫ Spec.map (CommRingCat.ofHom f₀) :=
by
  intro A B σ τ _ _ _ _ _ _ 𝒜 ℬ _ _ f hf f₀ hf₀
  have s1 : ∀ s : A, (HomogeneousLocalization.Away.map f s).comp
      (HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers s)) =
      (HomogeneousLocalization.fromZeroRingHom ℬ (Submonoid.powers (f s))).comp f₀ := by
    intro s
    refine RingHom.ext (fun a => ?_)
    apply HomogeneousLocalization.val_injective
    simp only [RingHom.comp_apply]
    show (HomogeneousLocalization.Away.map f s (HomogeneousLocalization.mk ⟨0, a, 1, _⟩)).val =
      (HomogeneousLocalization.mk ⟨0, f₀ a, 1, _⟩ : HomogeneousLocalization ℬ (Submonoid.powers (f s))).val
    rw [HomogeneousLocalization.Away.map, HomogeneousLocalization.map_mk,
      HomogeneousLocalization.val_mk, HomogeneousLocalization.val_mk]
    simp only [SetLike.GradeZero.coe_one, map_one, hf₀]
  have s2 : ∀ x : Proj ℬ, ∃ i, ∃ s ∈ 𝒜 i, 0 < i ∧ x ∈ Proj.basicOpen ℬ (f s) := by
    intro x
    by_contra hcon
    push_neg at hcon
    apply ProjectiveSpectrum.not_irrelevant_le (x : ProjectiveSpectrum ℬ)
    intro b hb
    have hb' := hf hb
    have hle : (HomogeneousIdeal.map f (HomogeneousIdeal.irrelevant 𝒜)).toIdeal ≤
        (x : ProjectiveSpectrum ℬ).asHomogeneousIdeal.toIdeal := by
      rw [HomogeneousIdeal.toIdeal_map, HomogeneousIdeal.irrelevant_eq_span, Ideal.map_span,
        Ideal.span_le]
      rintro _ ⟨y, hy, rfl⟩
      simp only [Set.mem_iUnion] at hy
      obtain ⟨i, hi, hyi⟩ := hy
      have h1 := hcon i y hyi hi
      rw [Proj.mem_basicOpen] at h1
      push_neg at h1
      exact h1
    exact hle hb'
  let 𝒰 : (Proj ℬ).OpenCover := Scheme.Cover.mkOfCovers (P := @IsOpenImmersion)
      {p : ℕ × A // p.2 ∈ 𝒜 p.1 ∧ 0 < p.1}
      (fun j => Spec (.of (HomogeneousLocalization.Away ℬ (f j.1.2))))
      (fun j => Proj.awayι ℬ (f j.1.2) (f.map_mem j.2.1) j.2.2) (fun x => by
        obtain ⟨i, s, hs, hi, hx⟩ := s2 x
        rw [← Proj.opensRange_awayι ℬ (f s) (f.map_mem hs) hi] at hx
        obtain ⟨y, hy⟩ := hx
        exact ⟨⟨(i, s), hs, hi⟩, y, hy⟩)
  refine Scheme.Cover.hom_ext 𝒰 _ _ (fun j => ?_)
  obtain ⟨⟨i, s⟩, hs, hi⟩ := j
  have hs' : s ∈ 𝒜 i := hs
  have hi' : 0 < i := hi
  show Proj.awayι ℬ (f s) (f.map_mem hs') hi' ≫ _ = Proj.awayι ℬ (f s) (f.map_mem hs') hi' ≫ _
  rw [Proj.awayι_comp_map_assoc f hf hi' s hs', Proj.awayι_toSpecZero, Proj.awayι_toSpecZero_assoc,
    ← Spec.map_comp, ← Spec.map_comp, ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp, s1]

theorem wc_bc_P1_localization_pullback : ∀ (B B' : Type u) [CommRing B] [CommRing B'] (φ : B →+* B') (b : B) (c : B'),
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin 2) B) := MvPolynomial.gradedAlgebra
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin 2) B') := MvPolynomial.gradedAlgebra
    letI : Algebra B B' := φ.toAlgebra
    IsLocalization.Away b B' →
    ∀ (g : MvPolynomial.homogeneousSubmodule (Fin 2) B →+*ᵍ MvPolynomial.homogeneousSubmodule (Fin 2) B')
    (hg : HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin 2) B') ≤
      HomogeneousIdeal.map g (HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin 2) B))),
    IsUnit c → (∀ b : B, g (MvPolynomial.C b) = MvPolynomial.C (φ b)) →
    g (MvPolynomial.X 0) = MvPolynomial.C c * MvPolynomial.X 0 → g (MvPolynomial.X 1) = MvPolynomial.X 1 →
    IsPullback (Proj.map g hg)
      (wcP1 B' ≫ Spec.map (CommRingCat.ofHom (algebraMap B' ↥(MvPolynomial.homogeneousSubmodule (Fin 2) B' 0))))
      (wcP1 B ≫ Spec.map (CommRingCat.ofHom (algebraMap B ↥(MvPolynomial.homogeneousSubmodule (Fin 2) B 0))))
      (Spec.map (CommRingCat.ofHom φ)) :=
by

  have hC1 : ∀ (B B' : Type u) [CommRing B] [CommRing B'] (φ : B →+* B') (c : B')
      (g : MvPolynomial (Fin 2) B →+* MvPolynomial (Fin 2) B'),
      (∀ r : B, g (MvPolynomial.C r) = MvPolynomial.C (φ r)) →
      g (MvPolynomial.X 0) = MvPolynomial.C c * MvPolynomial.X 0 → g (MvPolynomial.X 1) = MvPolynomial.X 1 →
      ∀ (p : MvPolynomial (Fin 2) B) (d : Fin 2 →₀ ℕ),
        (g p).coeff d = c ^ (d 0) * φ (p.coeff d) := by
    intro B B' _ _ φ c g hC h0 h1 p d
    have hmono : ∀ (u : Fin 2 →₀ ℕ) (a : B), g (MvPolynomial.monomial u a) =
        MvPolynomial.monomial u (c ^ (u 0) * φ a) := by
      intro u a
      rw [MvPolynomial.monomial_eq, MvPolynomial.monomial_eq,
        Finsupp.prod_fintype _ _ (fun _ => pow_zero _), Finsupp.prod_fintype _ _ (fun _ => pow_zero _),
        Fin.prod_univ_two, Fin.prod_univ_two]
      simp only [map_mul, map_pow, hC, h0, h1, mul_pow, MvPolynomial.C_mul, MvPolynomial.C_pow]
      ring
    induction p using MvPolynomial.induction_on' with
    | monomial u a =>
      rw [hmono, MvPolynomial.coeff_monomial, MvPolynomial.coeff_monomial]
      split_ifs with h
      · rw [h]
      · simp
    | add p q hp hq =>
      rw [map_add, MvPolynomial.coeff_add, MvPolynomial.coeff_add, hp, hq, map_add, mul_add]

  have hC2 : ∀ (B B' : Type u) [CommRing B] [CommRing B'] (φ : B →+* B') (b : B) (c : B'),
      letI : Algebra B B' := φ.toAlgebra
      IsLocalization.Away b B' → IsUnit c →
      ∀ (g : MvPolynomial (Fin 2) B → MvPolynomial (Fin 2) B'),
      (∀ (p : MvPolynomial (Fin 2) B) (d : Fin 2 →₀ ℕ), (g p).coeff d = c ^ (d 0) * φ (p.coeff d)) →
      (∀ a : MvPolynomial (Fin 2) B, g a = 0 → ∃ m : ℕ, MvPolynomial.C b ^ m * a = 0) ∧
      (∀ (k : ℕ) (a' : MvPolynomial (Fin 2) B'), a' ∈ MvPolynomial.homogeneousSubmodule (Fin 2) B' k →
        ∃ (m : ℕ) (a : MvPolynomial (Fin 2) B), a ∈ MvPolynomial.homogeneousSubmodule (Fin 2) B k ∧
          g a = MvPolynomial.C (φ b) ^ m * a') := by
    intro B B' _ _ φ b c
    letI : Algebra B B' := φ.toAlgebra
    intro hloc hc g hg
    classical
    have halg : ∀ r, algebraMap B B' r = φ r := fun r => rfl
    have hz0 : ∀ d : Fin 2 →₀ ℕ, (0 : MvPolynomial (Fin 2) B').coeff d = 0 := fun d => by simp
    have hz0' : ∀ d : Fin 2 →₀ ℕ, (0 : MvPolynomial (Fin 2) B).coeff d = 0 := fun d => by simp
    refine ⟨?_, ?_⟩
    · intro a ha
      have h1 : ∀ d, ∃ n : ℕ, b ^ n * a.coeff d = 0 := by
        intro d
        have hφ : φ (a.coeff d) = 0 := by
          have h2 := hg a d
          rw [ha, hz0] at h2
          exact ((hc.pow (d 0)).mul_right_eq_zero).mp h2.symm
        obtain ⟨n, hn⟩ := IsLocalization.Away.exists_of_eq (S := B') b (a := a.coeff d) (b := 0)
          (by rw [halg, halg, hφ, map_zero])
        exact ⟨n, by rw [hn, mul_zero]⟩
      choose n hn using h1
      refine ⟨∑ d ∈ a.support, n d, ?_⟩
      ext d
      rw [← MvPolynomial.C_pow, MvPolynomial.coeff_C_mul, hz0']
      by_cases hd : d ∈ a.support
      · have hle : n d ≤ ∑ d ∈ a.support, n d := Finset.single_le_sum (fun _ _ => Nat.zero_le _) hd
        rw [← Nat.sub_add_cancel hle, pow_add, mul_assoc, hn d, mul_zero]
      · rw [MvPolynomial.notMem_support_iff.mp hd, mul_zero]
    · intro k a' ha'
      have hhom := (MvPolynomial.mem_homogeneousSubmodule _ _).mp ha'
      obtain ⟨cinv, hcinv⟩ : ∃ ci : B', c * ci = 1 := by
        obtain ⟨u, rfl⟩ := hc
        exact ⟨↑u⁻¹, u.mul_inv⟩
      have h1 : ∀ d : Fin 2 →₀ ℕ, ∃ (n : ℕ) (α : B), cinv ^ (d 0) * a'.coeff d * φ b ^ n = φ α := by
        intro d
        obtain ⟨n, α, h⟩ := IsLocalization.Away.surj (S := B') b (cinv ^ (d 0) * a'.coeff d)
        exact ⟨n, α, h⟩
      choose n α hα using h1
      obtain ⟨N, hN⟩ : ∃ N, N = ∑ d ∈ a'.support, n d := ⟨_, rfl⟩
      refine ⟨N, ∑ d ∈ a'.support, MvPolynomial.monomial d (α d * b ^ (N - n d)), ?_, ?_⟩
      · rw [MvPolynomial.mem_homogeneousSubmodule]
        apply MvPolynomial.IsHomogeneous.sum
        intro d hd
        apply MvPolynomial.isHomogeneous_monomial
        have hw := hhom (MvPolynomial.mem_support_iff.mp hd)
        rw [Finsupp.degree_eq_weight_one (R := ℕ)]
        exact hw
      · ext d
        rw [hg, MvPolynomial.coeff_sum, ← MvPolynomial.C_pow, MvPolynomial.coeff_C_mul]
        simp only [MvPolynomial.coeff_monomial]
        rw [Finset.sum_ite_eq']
        split_ifs with hd
        · have hle : n d ≤ N := hN ▸ Finset.single_le_sum (fun _ _ => Nat.zero_le _) hd
          have hNp : φ b ^ N = φ b ^ (n d) * φ b ^ (N - n d) := by
            rw [← pow_add, Nat.add_sub_cancel' hle]
          have hce : c ^ (d 0) * cinv ^ (d 0) = 1 := by rw [← mul_pow, hcinv, one_pow]
          rw [map_mul, ← hα d, map_pow, hNp]
          linear_combination (a'.coeff d * φ b ^ n d * φ b ^ (N - n d)) * hce
        · rw [MvPolynomial.notMem_support_iff.mp hd]
          simp

  have hC3 : ∀ (B B' : Type u) [CommRing B] [CommRing B'] (φ : B →+* B') (b : B) (i : Fin 2),
      letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin 2) B) := MvPolynomial.gradedAlgebra
      letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin 2) B') := MvPolynomial.gradedAlgebra
      ∀ (g : MvPolynomial.homogeneousSubmodule (Fin 2) B →+*ᵍ MvPolynomial.homogeneousSubmodule (Fin 2) B')
      (hX : (MvPolynomial.X i : MvPolynomial (Fin 2) B) ∈ MvPolynomial.homogeneousSubmodule (Fin 2) B 1)
      (hbX : (MvPolynomial.C b * MvPolynomial.X i : MvPolynomial (Fin 2) B) ∈
        MvPolynomial.homogeneousSubmodule (Fin 2) B 1),
      IsUnit (φ b) → g (MvPolynomial.C b) = MvPolynomial.C (φ b) →
      (∀ a : MvPolynomial (Fin 2) B, g a = 0 → ∃ m : ℕ, MvPolynomial.C b ^ m * a = 0) →
      (∀ (k : ℕ) (a' : MvPolynomial (Fin 2) B'), a' ∈ MvPolynomial.homogeneousSubmodule (Fin 2) B' k →
        ∃ (m : ℕ) (a : MvPolynomial (Fin 2) B), a ∈ MvPolynomial.homogeneousSubmodule (Fin 2) B k ∧
          g a = MvPolynomial.C (φ b) ^ m * a') →
      letI : Algebra (HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin 2) B) (MvPolynomial.X i))
        (HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin 2) B') (g (MvPolynomial.X i))) :=
        (HomogeneousLocalization.Away.map g (MvPolynomial.X i)).toAlgebra
      IsLocalization.Away (HomogeneousLocalization.Away.isLocalizationElem hX hbX)
        (HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin 2) B') (g (MvPolynomial.X i))) := by
    intro B B' _ _ φ b i
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin 2) B) := MvPolynomial.gradedAlgebra
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin 2) B') := MvPolynomial.gradedAlgebra
    intro g hX hbX hbU hgC hker hsurj
    letI : Algebra (HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin 2) B) (MvPolynomial.X i))
        (HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin 2) B') (g (MvPolynomial.X i))) :=
        (HomogeneousLocalization.Away.map g (MvPolynomial.X i)).toAlgebra
    have hgX : g (MvPolynomial.X i) ∈ MvPolynomial.homogeneousSubmodule (Fin 2) B' 1 := g.map_mem hX
    have hbX1 : (MvPolynomial.C b * MvPolynomial.X i : MvPolynomial (Fin 2) B) ^ 1 ∈
        MvPolynomial.homogeneousSubmodule (Fin 2) B (1 • 1) := by simpa using hbX
    have hgbX : g ((MvPolynomial.C b * MvPolynomial.X i : MvPolynomial (Fin 2) B) ^ 1) ∈
        MvPolynomial.homogeneousSubmodule (Fin 2) B' (1 • 1) := g.map_mem hbX1
    have he : HomogeneousLocalization.Away.isLocalizationElem hX hbX =
        HomogeneousLocalization.Away.mk _ hX 1 _ hbX1 := rfl
    have hae : algebraMap _ _ (HomogeneousLocalization.Away.isLocalizationElem hX hbX) =
        HomogeneousLocalization.Away.mk _ hgX 1 _ hgbX := by
      rw [he, RingHom.algebraMap_toAlgebra]
      exact HomogeneousLocalization.Away.map_mk g _ hX 1 _ hbX1
    refine IsLocalization.Away.mk _ ?_ ?_ ?_
    ·
      obtain ⟨u, hu⟩ : ∃ u : B', φ b * u = 1 := by
        obtain ⟨v, hv⟩ := hbU
        exact ⟨↑v⁻¹, by rw [← hv]; exact v.mul_inv⟩
      have hmem : (MvPolynomial.C u * g (MvPolynomial.X i) : MvPolynomial (Fin 2) B') ∈
          MvPolynomial.homogeneousSubmodule (Fin 2) B' (1 • 1) := by
        have := SetLike.mul_mem_graded
          ((MvPolynomial.mem_homogeneousSubmodule 0 _).mpr (MvPolynomial.isHomogeneous_C (Fin 2) u)) hgX
        simpa using this
      rw [hae, isUnit_iff_exists_inv]
      refine ⟨HomogeneousLocalization.Away.mk _ hgX 1 _ hmem, ?_⟩
      apply HomogeneousLocalization.val_injective
      rw [HomogeneousLocalization.val_mul, HomogeneousLocalization.val_one,
        HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.Away.val_mk,
        Localization.mk_mul, ← Localization.mk_one,
        Localization.mk_eq_mk_iff, Localization.r_iff_exists]
      refine ⟨1, ?_⟩
      have hCu : MvPolynomial.C (φ b) * MvPolynomial.C u = (1 : MvPolynomial (Fin 2) B') := by
        rw [← map_mul, hu, map_one]
      simp only [OneMemClass.coe_one, one_mul, mul_one, pow_one, Submonoid.coe_mul, map_mul, hgC]
      linear_combination (g (MvPolynomial.X i) * g (MvPolynomial.X i)) * hCu
    ·
      intro s
      obtain ⟨n, a', ha', rfl⟩ := HomogeneousLocalization.Away.mk_surjective _ hgX s
      obtain ⟨m, a, ha, hga⟩ := hsurj (n • 1) a' ha'
      refine ⟨m, HomogeneousLocalization.Away.mk _ hX n a ha, ?_⟩
      rw [hae]
      apply HomogeneousLocalization.val_injective
      rw [HomogeneousLocalization.val_mul, HomogeneousLocalization.val_pow,
        HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.Away.val_mk,
        RingHom.algebraMap_toAlgebra,
        HomogeneousLocalization.Away.map_mk, HomogeneousLocalization.Away.val_mk,
        Localization.mk_pow, Localization.mk_mul, Localization.mk_eq_mk_iff, Localization.r_iff_exists]
      refine ⟨1, ?_⟩
      simp only [OneMemClass.coe_one, one_mul, Submonoid.coe_mul, SubmonoidClass.coe_pow, hga,
        map_mul, pow_one, hgC]
      ring
    ·
      intro y₁ y₂ hy
      obtain ⟨n, a, ha, hz⟩ := HomogeneousLocalization.Away.mk_surjective _ hX (y₁ - y₂)
      have h0 : HomogeneousLocalization.Away.map g (MvPolynomial.X i) (y₁ - y₂) = 0 := by
        rw [map_sub, sub_eq_zero]; exact hy
      rw [← hz, HomogeneousLocalization.Away.map_mk] at h0
      have h1 := congrArg HomogeneousLocalization.val h0
      rw [HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.val_zero,
        ← Localization.mk_zero 1, Localization.mk_eq_mk_iff, Localization.r_iff_exists] at h1
      obtain ⟨⟨_, j, rfl⟩, hj⟩ := h1
      have hj' : g (MvPolynomial.X i ^ j * a) = 0 := by
        simp only [OneMemClass.coe_one, one_mul, mul_zero] at hj
        rw [map_mul, map_pow]
        exact hj
      obtain ⟨m, hm⟩ := hker _ hj'
      refine ⟨m, ?_⟩
      rw [← sub_eq_zero, ← mul_sub, ← hz]
      apply HomogeneousLocalization.val_injective
      rw [HomogeneousLocalization.val_mul, HomogeneousLocalization.val_pow, HomogeneousLocalization.val_zero,
        he, HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.Away.val_mk,
        Localization.mk_pow, Localization.mk_mul, ← Localization.mk_zero 1, Localization.mk_eq_mk_iff,
        Localization.r_iff_exists]
      refine ⟨⟨MvPolynomial.X i ^ j, j, rfl⟩, ?_⟩
      simp only [OneMemClass.coe_one, one_mul, mul_zero, pow_one]
      linear_combination (MvPolynomial.X i ^ m) * hm

  have hC4 : ∀ {X Y : Scheme.{u}} (M : X ⟶ Y) {ι : Type} (U : ι → Y.Opens)
      (Z Z' : ι → Scheme.{u}) (W : ∀ i, Z i ⟶ X) (V : ∀ i, Z' i ⟶ Y) (h : ∀ i, Z i ⟶ Z' i)
      [∀ i, IsOpenImmersion (W i)] [∀ i, IsOpenImmersion (V i)], (∀ i, IsOpenImmersion (h i)) →
      (⨆ i, U i) = ⊤ → (∀ i, (W i).opensRange = M ⁻¹ᵁ U i) → (∀ i, (V i).opensRange = U i) →
      (∀ i, W i ≫ M = h i ≫ V i) →
      IsOpenImmersion M ∧ ∀ y : Y, y ∈ Set.range M ↔ ∃ i, y ∈ Set.range (h i ≫ V i) := by
    intro X Y M ι U Z Z' W V h _ _ hh hU hWr hVr hcomm
    refine ⟨?_, ?_⟩
    · apply IsZariskiLocalAtTarget.of_iSup_eq_top (P := @IsOpenImmersion) U hU
      intro i
      haveI := hh i
      let α := IsOpenImmersion.isoOfRangeEq (W i) (M ⁻¹ᵁ U i).ι
        (by rw [Scheme.Opens.range_ι, ← hWr i, Scheme.Hom.coe_opensRange])
      let β := IsOpenImmersion.isoOfRangeEq (V i) (U i).ι
        (by rw [Scheme.Opens.range_ι, ← hVr i, Scheme.Hom.coe_opensRange])
      have e : α.hom ≫ (M ∣_ U i) = h i ≫ β.hom := by
        rw [← cancel_mono (U i).ι, Category.assoc, morphismRestrict_ι, ← Category.assoc,
          IsOpenImmersion.isoOfRangeEq_hom_fac, Category.assoc, IsOpenImmersion.isoOfRangeEq_hom_fac,
          hcomm i]
      have e2 : (M ∣_ U i) = α.inv ≫ h i ≫ β.hom := by
        rw [← e, Iso.inv_hom_id_assoc]
      rw [e2]
      infer_instance
    · intro y
      constructor
      · rintro ⟨x, rfl⟩
        have hx : M x ∈ (⨆ i, U i) := by rw [hU]; trivial
        obtain ⟨i, hi⟩ := TopologicalSpace.Opens.mem_iSup.mp hx
        have hx' : x ∈ ((W i).opensRange : Set X) := by rw [hWr i]; exact hi
        rw [Scheme.Hom.coe_opensRange] at hx'
        obtain ⟨z, rfl⟩ := hx'
        refine ⟨i, z, ?_⟩
        rw [← hcomm i, Scheme.Hom.comp_apply]
      · rintro ⟨i, z, rfl⟩
        refine ⟨W i z, ?_⟩
        rw [← hcomm i, Scheme.Hom.comp_apply]

  have hC6 : ∀ {A σ : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
      {𝒜 : ℕ → σ} [GradedRing 𝒜]
      (s t : A) (m m' : ℕ) (hs : s ∈ 𝒜 m) (ht : t ∈ 𝒜 m') (hm : 0 < m), 0 < m' →
      ∀ (R : Type u) [CommRing R] [Algebra (HomogeneousLocalization.Away 𝒜 s) R],
      IsLocalization.Away (HomogeneousLocalization.Away.isLocalizationElem hs ht) R →
      ∀ y : Proj 𝒜, y ∈ Set.range (Spec.map (CommRingCat.ofHom
        (algebraMap (HomogeneousLocalization.Away 𝒜 s) R)) ≫ Proj.awayι 𝒜 s hs hm) ↔
        y ∈ Proj.basicOpen 𝒜 (s * t) := by
    intro A σ _ _ _ 𝒜 _ s t m m' hs ht hm hm' R _ _ hR y
    have h1 : Set.range (Spec.map (CommRingCat.ofHom
        (algebraMap (HomogeneousLocalization.Away 𝒜 s) R))) =
        ((Proj.awayι 𝒜 s hs hm ⁻¹ᵁ Proj.basicOpen 𝒜 t : (Spec (.of (HomogeneousLocalization.Away 𝒜 s))).Opens) :
          Set (Spec (.of (HomogeneousLocalization.Away 𝒜 s)))) := by
      rw [Proj.awayι_preimage_basicOpen 𝒜 hs hm ht hm']
      exact PrimeSpectrum.localization_away_comap_range R _
    rw [Proj.basicOpen_mul]
    constructor
    · rintro ⟨z, rfl⟩
      rw [Scheme.Hom.comp_apply]
      have hz : Spec.map (CommRingCat.ofHom (algebraMap (HomogeneousLocalization.Away 𝒜 s) R)) z ∈
          Set.range (Spec.map (CommRingCat.ofHom (algebraMap (HomogeneousLocalization.Away 𝒜 s) R))) :=
        ⟨z, rfl⟩
      rw [h1] at hz
      refine ⟨?_, hz⟩
      rw [← Proj.opensRange_awayι 𝒜 s hs hm]
      exact ⟨_, rfl⟩
    · rintro ⟨hy1, hy2⟩
      rw [← Proj.opensRange_awayι 𝒜 s hs hm] at hy1
      obtain ⟨x, rfl⟩ := hy1
      have hx : x ∈ ((Proj.awayι 𝒜 s hs hm ⁻¹ᵁ Proj.basicOpen 𝒜 t :
          (Spec (.of (HomogeneousLocalization.Away 𝒜 s))).Opens) :
          Set (Spec (.of (HomogeneousLocalization.Away 𝒜 s)))) := hy2
      rw [← h1] at hx
      obtain ⟨z, rfl⟩ := hx
      exact ⟨z, by rw [Scheme.Hom.comp_apply]⟩

  intro B B' _ _ φ b c
  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin 2) B) := MvPolynomial.gradedAlgebra
  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin 2) B') := MvPolynomial.gradedAlgebra
  letI : Algebra B B' := φ.toAlgebra
  intro hloc g hg hc hC hX0 hX1
  have hbU : IsUnit (φ b) := IsLocalization.Away.algebraMap_isUnit b
  haveI hSpecOI : IsOpenImmersion (Spec.map (CommRingCat.ofHom φ)) :=
    IsOpenImmersion.of_isLocalization (R := B) (S := B') b
  have hcoef := hC1 B B' φ c (g : MvPolynomial (Fin 2) B →+* MvPolynomial (Fin 2) B') hC hX0 hX1
  obtain ⟨hker, hsurj⟩ := hC2 B B' φ b c hloc hc (⇑g) hcoef
  have hX : ∀ i : Fin 2, (MvPolynomial.X i : MvPolynomial (Fin 2) B) ∈
      MvPolynomial.homogeneousSubmodule (Fin 2) B 1 := fun i =>
    (MvPolynomial.mem_homogeneousSubmodule _ _).mpr (MvPolynomial.isHomogeneous_X B i)
  have hbX : ∀ i : Fin 2, (MvPolynomial.C b * MvPolynomial.X i : MvPolynomial (Fin 2) B) ∈
      MvPolynomial.homogeneousSubmodule (Fin 2) B 1 := fun i =>
    (MvPolynomial.mem_homogeneousSubmodule _ _).mpr (MvPolynomial.isHomogeneous_C_mul_X b i)
  have hgX : ∀ i : Fin 2, g (MvPolynomial.X i) ∈ MvPolynomial.homogeneousSubmodule (Fin 2) B' 1 :=
    fun i => g.map_mem (hX i)

  have hY : (⨆ i : Fin 2, Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin 2) B)
      (MvPolynomial.X i)) = ⊤ := by
    apply Proj.iSup_basicOpen_eq_top _ (fun i => MvPolynomial.X i)
    intro a ha
    have ha' := (HomogeneousIdeal.mem_irrelevant_iff _ a).mp ha
    have h0 : MvPolynomial.homogeneousComponent 0 a = 0 := by
      rw [← MvPolynomial.decomposition.decompose'_apply]
      exact ha'
    rw [MvPolynomial.homogeneousComponent_zero, MvPolynomial.C_eq_zero] at h0
    rw [← Set.image_univ, MvPolynomial.mem_ideal_span_X_image]
    intro m hm
    have hm0 : m ≠ 0 := by
      rintro rfl
      exact (MvPolynomial.mem_support_iff.mp hm) h0
    obtain ⟨l, hl⟩ := Finsupp.ne_iff.mp hm0
    exact ⟨l, Set.mem_univ _, hl⟩

  have hloc' : ∀ i : Fin 2,
      letI := (HomogeneousLocalization.Away.map g (MvPolynomial.X i)).toAlgebra
      IsLocalization.Away (HomogeneousLocalization.Away.isLocalizationElem (hX i) (hbX i))
        (HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin 2) B')
          (g (MvPolynomial.X i))) := fun i =>
    hC3 B B' φ b i g (hX i) (hbX i) hbU (hC b) hker hsurj
  have hOI : ∀ i : Fin 2, IsOpenImmersion (Spec.map (CommRingCat.ofHom
      (HomogeneousLocalization.Away.map g (MvPolynomial.X i)))) := by
    intro i
    letI := (HomogeneousLocalization.Away.map g (MvPolynomial.X i)).toAlgebra
    haveI := hloc' i
    exact IsOpenImmersion.of_isLocalization
      (HomogeneousLocalization.Away.isLocalizationElem (hX i) (hbX i))
  obtain ⟨hMOI, hMrange⟩ := hC4 (Proj.map g hg)
    (fun i : Fin 2 => Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin 2) B) (MvPolynomial.X i))
    _ _ (fun i => Proj.awayι _ (g (MvPolynomial.X i)) (hgX i) one_pos)
    (fun i => Proj.awayι _ (MvPolynomial.X i) (hX i) one_pos)
    (fun i => Spec.map (CommRingCat.ofHom (HomogeneousLocalization.Away.map g (MvPolynomial.X i))))
    hOI hY
    (fun i => (Proj.opensRange_awayι _ _ _ _).trans (Proj.map_preimage_basicOpen g hg _).symm)
    (fun i => Proj.opensRange_awayι _ _ _ _)
    (fun i => Proj.awayι_comp_map _ _ _ _ _)
  haveI := hMOI
  have hchart : ∀ (i : Fin 2) (y : Proj (MvPolynomial.homogeneousSubmodule (Fin 2) B)),
      y ∈ Set.range (Spec.map (CommRingCat.ofHom (HomogeneousLocalization.Away.map g (MvPolynomial.X i))) ≫
        Proj.awayι _ (MvPolynomial.X i) (hX i) one_pos) ↔
      y ∈ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin 2) B)
        (MvPolynomial.X i * (MvPolynomial.C b * MvPolynomial.X i)) := by
    intro i y
    letI := (HomogeneousLocalization.Away.map g (MvPolynomial.X i)).toAlgebra
    exact hC6 (MvPolynomial.X i) (MvPolynomial.C b * MvPolynomial.X i) 1 1 (hX i) (hbX i) one_pos one_pos
      _ (hloc' i) y
  have hRange : (Proj.map g hg).opensRange =
      Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin 2) B) (MvPolynomial.C b) := by
    apply TopologicalSpace.Opens.ext
    ext y
    rw [Scheme.Hom.coe_opensRange, SetLike.mem_coe, hMrange y]
    constructor
    · rintro ⟨i, hi⟩
      have h2 := (hchart i y).mp hi
      rw [Proj.basicOpen_mul, Proj.basicOpen_mul] at h2
      exact h2.2.1
    · intro hy
      have hy' : y ∈ (⨆ i : Fin 2, Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin 2) B)
          (MvPolynomial.X i)) := by rw [hY]; trivial
      obtain ⟨i, hi⟩ := TopologicalSpace.Opens.mem_iSup.mp hy'
      refine ⟨i, (hchart i y).mpr ?_⟩
      rw [Proj.basicOpen_mul, Proj.basicOpen_mul]
      exact ⟨hi, hy, hi⟩

  have hcomm : Proj.map g hg ≫ (wcP1 B ≫ Spec.map (CommRingCat.ofHom
        (algebraMap B ↥(MvPolynomial.homogeneousSubmodule (Fin 2) B 0)))) =
      (wcP1 B' ≫ Spec.map (CommRingCat.ofHom
        (algebraMap B' ↥(MvPolynomial.homogeneousSubmodule (Fin 2) B' 0)))) ≫
        Spec.map (CommRingCat.ofHom φ) := by
    have h8 := wc_bc_proj_map_toSpecZero g hg (wcGradeZeroHom g) (fun a => rfl)
    have hring : (wcGradeZeroHom g).comp
          (algebraMap B ↥(MvPolynomial.homogeneousSubmodule (Fin 2) B 0)) =
        (algebraMap B' ↥(MvPolynomial.homogeneousSubmodule (Fin 2) B' 0)).comp φ := by
      apply RingHom.ext
      intro r
      apply Subtype.ext
      show g ((algebraMap B ↥(MvPolynomial.homogeneousSubmodule (Fin 2) B 0) r :
          MvPolynomial (Fin 2) B)) =
        ((algebraMap B' ↥(MvPolynomial.homogeneousSubmodule (Fin 2) B' 0) (φ r)) :
          MvPolynomial (Fin 2) B')
      rw [SetLike.GradeZero.coe_algebraMap, SetLike.GradeZero.coe_algebraMap,
        MvPolynomial.algebraMap_eq, MvPolynomial.algebraMap_eq, hC]
    unfold wcP1
    rw [← Category.assoc, h8, Category.assoc, Category.assoc, ← Spec.map_comp, ← Spec.map_comp,
      ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp, hring]

  have hpre : (wcP1 B ≫ Spec.map (CommRingCat.ofHom
        (algebraMap B ↥(MvPolynomial.homogeneousSubmodule (Fin 2) B 0)))) ⁻¹ᵁ
        (Spec.map (CommRingCat.ofHom φ)).opensRange = (Proj.map g hg).opensRange := by
    have hr : (Spec.map (CommRingCat.ofHom φ)).opensRange = PrimeSpectrum.basicOpen b := by
      apply TopologicalSpace.Opens.ext
      rw [Scheme.Hom.coe_opensRange]
      exact PrimeSpectrum.localization_away_comap_range B' b
    rw [hr, wc_bc_P1_preimage_basicOpen, hRange]
  exact (IsOpenImmersion.isPullback _ _ _ _ hcomm hpre).flip

theorem wc_bc_degree_zero_bijective : ∀ (A : Type u) [CommRing A] (m : ℕ), Function.Bijective (algebraMap A ↥(MvPolynomial.homogeneousSubmodule (Fin m) A 0)) :=
by
  intro A _ m
  have hC : ∀ a : A, ((algebraMap A ↥(MvPolynomial.homogeneousSubmodule (Fin m) A 0) a :
      ↥(MvPolynomial.homogeneousSubmodule (Fin m) A 0)) : MvPolynomial (Fin m) A) =
      MvPolynomial.C a := by
    intro a
    rw [SetLike.GradeZero.coe_algebraMap, MvPolynomial.algebraMap_eq]
  refine ⟨fun a b h => ?_, fun x => ⟨(x : MvPolynomial (Fin m) A).coeff 0, ?_⟩⟩
  · have h' := congrArg Subtype.val h
    have h'' : MvPolynomial.C a = (MvPolynomial.C b : MvPolynomial (Fin m) A) := by
      rw [← hC a, ← hC b]
      exact h'
    exact MvPolynomial.C_injective _ _ h''
  · have hp : (x : MvPolynomial (Fin m) A).IsHomogeneous 0 :=
      (MvPolynomial.mem_homogeneousSubmodule 0 _).mp x.2
    have h0 : (x : MvPolynomial (Fin m) A).totalDegree = 0 := Nat.le_zero.mp hp.totalDegree_le
    apply Subtype.ext
    rw [hC]
    exact (MvPolynomial.totalDegree_eq_zero_iff_eq_C.mp h0).symm

theorem wc_bc_P1_inj_off_U : ∀ (A : Type u) [CommRing A]
    (a b : @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) A) MvPolynomial.gradedAlgebra),
    a ∉ @Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) A) MvPolynomial.gradedAlgebra (MvPolynomial.X 0) →
    b ∉ @Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) A) MvPolynomial.gradedAlgebra (MvPolynomial.X 0) →
    wcP1 A a = wcP1 A b → a = b :=
by
  intro A _ a b ha hb hab
  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin 2) A) :=
    MvPolynomial.gradedAlgebra
  have hX : ∀ l, (MvPolynomial.X l : MvPolynomial (Fin 2) A) ∈
      MvPolynomial.homogeneousSubmodule (Fin 2) A 1 := fun l =>
    (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X A l)

  have s3 : ∀ {R S : Type u} [CommRing R] [CommRing S] (φ : R →+* S) (t : S),
      Function.Surjective (Polynomial.eval₂RingHom φ t) →
      ∀ (I J : Ideal S), t ∈ I → t ∈ J → I.comap φ = J.comap φ → I = J := by
    intro R S _ _ φ t hs I J hI hJ hIJ
    have key : ∀ (K : Ideal S), t ∈ K → ∀ (p : Polynomial R),
        (Polynomial.eval₂ φ t p ∈ K ↔ p.coeff 0 ∈ K.comap φ) := by
      intro K hK p
      have e : Polynomial.eval₂ φ t p =
          Polynomial.eval₂ φ t p.divX * t + φ (p.coeff 0) := by
        conv_lhs => rw [← Polynomial.divX_mul_X_add p]
        rw [Polynomial.eval₂_add, Polynomial.eval₂_mul, Polynomial.eval₂_X, Polynomial.eval₂_C]
      rw [e, Ideal.add_mem_iff_right _ (Ideal.mul_mem_left _ _ hK), Ideal.mem_comap]
    apply Ideal.ext
    intro s
    obtain ⟨p, rfl⟩ := hs s
    show Polynomial.eval₂ φ t p ∈ I ↔ Polynomial.eval₂ φ t p ∈ J
    rw [key I hI p, key J hJ p, hIJ]

  have hH : ∀ {S : Type u} [CommRing S] (g h : MvPolynomial (Fin 2) A →+* S) (s : S),
      (∀ r, g (MvPolynomial.C r) = h (MvPolynomial.C r)) →
      (∀ l, g (MvPolynomial.X l) = s * h (MvPolynomial.X l)) →
      ∀ (a : MvPolynomial (Fin 2) A) (k : ℕ), a.IsHomogeneous k → g a = s ^ k * h a := by
    intro S _ g h s hC hXs a k ha
    conv_lhs => rw [a.as_sum]
    conv_rhs => rw [a.as_sum]
    rw [map_sum, map_sum, Finset.mul_sum]
    refine Finset.sum_congr rfl fun d hd => ?_
    have hdeg := ha (MvPolynomial.mem_support_iff.mp hd)
    simp only [Finsupp.weight_apply, Finsupp.sum, smul_eq_mul, mul_one, Pi.one_apply] at hdeg
    rw [MvPolynomial.monomial_eq, map_mul, map_mul, hC, Finsupp.prod, map_prod, map_prod]
    simp only [map_pow, hXs, mul_pow]
    rw [Finset.prod_mul_distrib, Finset.prod_pow_eq_pow_sum, hdeg]
    ring

  have s2 : Function.Surjective (Polynomial.eval₂RingHom (HomogeneousLocalization.fromZeroRingHom
      (MvPolynomial.homogeneousSubmodule (Fin 2) A) (Submonoid.powers (MvPolynomial.X 1)))
      (HomogeneousLocalization.Away.isLocalizationElem (hX 1) (hX 0))) := by
    let y : HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin 2) A)
        (MvPolynomial.X 1) := HomogeneousLocalization.Away.isLocalizationElem (hX 1) (hX 0)
    let gv : Fin 2 → Polynomial (MvPolynomial.homogeneousSubmodule (Fin 2) A 0) :=
      ![Polynomial.X, 1]
    let cv : A →+* Polynomial (MvPolynomial.homogeneousSubmodule (Fin 2) A 0) :=
      Polynomial.C.comp (algebraMap A (MvPolynomial.homogeneousSubmodule (Fin 2) A 0))
    let ev : MvPolynomial (Fin 2) A →+* Polynomial (MvPolynomial.homogeneousSubmodule (Fin 2) A 0) :=
      MvPolynomial.eval₂Hom cv gv
    have hev0 : ev (MvPolynomial.X 0) = Polynomial.X := by simp [ev, gv]
    have hev1 : ev (MvPolynomial.X 1) = 1 := by simp [ev, gv]
    have hev_C : ∀ r, ev (MvPolynomial.C r) =
        Polynomial.C (algebraMap A (MvPolynomial.homogeneousSubmodule (Fin 2) A 0) r) := by
      simp [ev, cv]
    let φy := Polynomial.eval₂RingHom (HomogeneousLocalization.fromZeroRingHom
        (MvPolynomial.homogeneousSubmodule (Fin 2) A) (Submonoid.powers (MvPolynomial.X 1))) y
    have hc : ∀ r, (HomogeneousLocalization.fromZeroRingHom
        (MvPolynomial.homogeneousSubmodule (Fin 2) A) (Submonoid.powers (MvPolynomial.X 1))
        (algebraMap A (MvPolynomial.homogeneousSubmodule (Fin 2) A 0) r)).val =
        algebraMap (MvPolynomial (Fin 2) A) (Localization.Away
          (MvPolynomial.X 1 : MvPolynomial (Fin 2) A)) (MvPolynomial.C r) := by
      intro r
      rw [← Localization.mk_one_eq_algebraMap]
      rfl
    let θ := (algebraMap (HomogeneousLocalization.Away
        (MvPolynomial.homogeneousSubmodule (Fin 2) A) (MvPolynomial.X 1))
        (Localization.Away (MvPolynomial.X 1 : MvPolynomial (Fin 2) A))).comp (φy.comp ev)
    have hθ : ∀ (k : ℕ) (a : MvPolynomial (Fin 2) A), a.IsHomogeneous k →
        algebraMap (MvPolynomial (Fin 2) A)
          (Localization.Away (MvPolynomial.X 1 : MvPolynomial (Fin 2) A)) a =
        (algebraMap (MvPolynomial (Fin 2) A)
          (Localization.Away (MvPolynomial.X 1 : MvPolynomial (Fin 2) A))
          (MvPolynomial.X 1)) ^ k * θ a := by
      intro k a ha
      apply hH _ θ _ _ _ a k ha
      · intro r
        simp only [θ, RingHom.comp_apply, hev_C, φy, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
        rw [HomogeneousLocalization.algebraMap_apply, hc]
      · rw [Fin.forall_fin_two]
        refine ⟨?_, ?_⟩
        · simp only [θ, RingHom.comp_apply, hev0, φy, Polynomial.coe_eval₂RingHom,
            Polynomial.eval₂_X, y, HomogeneousLocalization.Away.isLocalizationElem]
          rw [HomogeneousLocalization.algebraMap_apply, HomogeneousLocalization.Away.val_mk,
            ← Localization.mk_one_eq_algebraMap, ← Localization.mk_one_eq_algebraMap,
            Localization.mk_mul, Localization.mk_eq_mk_iff, Localization.r_iff_exists]
          refine ⟨1, ?_⟩
          simp only [OneMemClass.coe_one, one_mul, pow_one]
          try ring
        · simp only [θ, RingHom.comp_apply, hev1, map_one, mul_one]
    intro z
    obtain ⟨k, a, ha, rfl⟩ := HomogeneousLocalization.Away.mk_surjective _ (hX 1) z
    refine ⟨ev a, ?_⟩
    apply HomogeneousLocalization.val_injective
    rw [HomogeneousLocalization.Away.val_mk, Localization.mk_eq_mk',
      IsLocalization.eq_mk'_iff_mul_eq]
    have hh : a.IsHomogeneous k := by
      have := (MvPolynomial.mem_homogeneousSubmodule _ _).mp ha
      simpa using this
    rw [hθ k a hh, mul_comm]
    congr 1
    exact map_pow _ _ _

  have hcover : (⨆ i : Fin 2, Proj.basicOpen
      (MvPolynomial.homogeneousSubmodule (Fin 2) A) (MvPolynomial.X i)) = ⊤ := by
    apply Proj.iSup_basicOpen_eq_top _ (fun i => MvPolynomial.X i)
    intro a ha
    have ha' := (HomogeneousIdeal.mem_irrelevant_iff _ a).mp ha
    have h0 : MvPolynomial.homogeneousComponent 0 a = 0 := by
      rw [← MvPolynomial.decomposition.decompose'_apply]
      exact ha'
    rw [MvPolynomial.homogeneousComponent_zero, MvPolynomial.C_eq_zero] at h0
    rw [← Set.image_univ, MvPolynomial.mem_ideal_span_X_image]
    intro m hm
    have hm0 : m ≠ 0 := by
      rintro rfl
      exact (MvPolynomial.mem_support_iff.mp hm) h0
    obtain ⟨l, hl⟩ := Finsupp.ne_iff.mp hm0
    exact ⟨l, Set.mem_univ _, hl⟩

  have s1 : ∀ c : Proj (MvPolynomial.homogeneousSubmodule (Fin 2) A),
      c ∉ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin 2) A) (MvPolynomial.X 0) →
      ∃ c' : PrimeSpectrum (HomogeneousLocalization.Away
          (MvPolynomial.homogeneousSubmodule (Fin 2) A) (MvPolynomial.X 1)),
        Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin 2) A) (MvPolynomial.X 1) (hX 1)
          one_pos c' = c ∧
        HomogeneousLocalization.Away.isLocalizationElem (hX 1) (hX 0) ∈ c'.asIdeal := by
    intro c hc
    have hc1 : c ∈ (⨆ i : Fin 2, Proj.basicOpen
        (MvPolynomial.homogeneousSubmodule (Fin 2) A) (MvPolynomial.X i)) := by
      rw [hcover]; trivial
    obtain ⟨i, hi⟩ := TopologicalSpace.Opens.mem_iSup.mp hc1
    have hc2 : c ∈ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin 2) A)
        (MvPolynomial.X 1) := by
      fin_cases i
      · exact (hc hi).elim
      · exact hi
    rw [← Proj.opensRange_awayι _ _ (hX 1) one_pos] at hc2
    obtain ⟨c', hc'⟩ := Scheme.Hom.mem_opensRange.mp hc2
    refine ⟨c', hc', ?_⟩
    by_contra hy
    apply hc
    rw [← hc', ← Scheme.Hom.mem_preimage,
      Proj.awayι_preimage_basicOpen _ (hX 1) one_pos (hX 0) one_pos]
    exact (PrimeSpectrum.mem_basicOpen _ _).mpr hy

  have s4 : ∀ c' : PrimeSpectrum (HomogeneousLocalization.Away
        (MvPolynomial.homogeneousSubmodule (Fin 2) A) (MvPolynomial.X 1)),
      wcP1 A (Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin 2) A) (MvPolynomial.X 1) (hX 1)
        one_pos c') =
      PrimeSpectrum.comap (HomogeneousLocalization.fromZeroRingHom
        (MvPolynomial.homogeneousSubmodule (Fin 2) A) (Submonoid.powers (MvPolynomial.X 1))) c' := by
    intro c'
    show Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin 2) A)
      (Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin 2) A) (MvPolynomial.X 1) (hX 1)
        one_pos c') = _
    exact (Scheme.Hom.comp_apply (Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin 2) A)
        (MvPolynomial.X 1) (hX 1) one_pos)
        (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin 2) A)) c').symm.trans
      ((congrArg (fun f : Spec (.of (HomogeneousLocalization.Away
          (MvPolynomial.homogeneousSubmodule (Fin 2) A) (MvPolynomial.X 1))) ⟶
          Spec (.of ↥(MvPolynomial.homogeneousSubmodule (Fin 2) A 0)) => f c') (Proj.awayι_toSpecZero
        (MvPolynomial.homogeneousSubmodule (Fin 2) A) (MvPolynomial.X 1) (hX 1) one_pos)).trans
        (Spec.map_apply _ _))

  obtain ⟨a', rfl, ha'⟩ := s1 a ha
  obtain ⟨b', rfl, hb'⟩ := s1 b hb
  rw [s4, s4] at hab
  have hI := congrArg PrimeSpectrum.asIdeal hab
  rw [PrimeSpectrum.comap_asIdeal, PrimeSpectrum.comap_asIdeal] at hI
  rw [PrimeSpectrum.ext (s3 _ _ s2 a'.asIdeal b'.asIdeal ha' hb' hI)]

theorem wc_bc_chart_iso : ∀ (K : Type u) [Field K] (n : ℕ) (j : Fin (n + 1)) (s : MvPolynomial (Fin (n + 1)) K),
  s = MvPolynomial.X j →
  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) := MvPolynomial.gradedAlgebra
  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (n + 1 + 1)) K) := MvPolynomial.gradedAlgebra
  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin 2)
      (HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) s)) := MvPolynomial.gradedAlgebra
  ∀ (ν : Fin (n + 1) → HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) s)
    (f : MvPolynomial.homogeneousSubmodule (Fin (n + 1 + 1)) K →+*ᵍ MvPolynomial.homogeneousSubmodule (Fin 2)
      (HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) s)),
    (∀ l, HomogeneousLocalization.val (ν l) = Localization.mk (MvPolynomial.X l) ⟨s, Submonoid.mem_powers s⟩) →
    (∀ k : K, f (MvPolynomial.C k) = MvPolynomial.C (algebraMap ↥(MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K 0)
      (HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) s)
      (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K 0) k))) →
    (∀ l : Fin (n + 1), f (MvPolynomial.X (Fin.castSucc l)) = MvPolynomial.C (ν l) * MvPolynomial.X 0) →
    f (MvPolynomial.X (Fin.last (n + 1))) = MvPolynomial.X 1 →
    Function.Bijective (HomogeneousLocalization.Away.map f (MvPolynomial.X (Fin.castSucc j))) :=
by


  have hvm : ∀ {A σ : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A] (𝒜 : ℕ → σ)
      [GradedRing 𝒜] (z : A) (d : ℕ) (hz : z ∈ 𝒜 d) (k : ℕ) (a : A) (ha : a ∈ 𝒜 (k • d)),
      HomogeneousLocalization.val (HomogeneousLocalization.Away.mk 𝒜 hz k a ha) *
        algebraMap A (Localization.Away z) z ^ k = algebraMap A (Localization.Away z) a := by
    intro A σ _ _ _ 𝒜 _ z d hz k a ha
    rw [HomogeneousLocalization.Away.val_mk, Localization.mk_eq_mk', ← map_pow]
    exact IsLocalization.mk'_spec _ _ _
  have hvm0 : ∀ {A σ : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A] (𝒜 : ℕ → σ)
      [GradedRing 𝒜] (z : A) (d : ℕ) (hz : z ∈ 𝒜 d) (a : A) (ha : a ∈ 𝒜 (0 • d)),
      HomogeneousLocalization.val (HomogeneousLocalization.Away.mk 𝒜 hz 0 a ha) =
        algebraMap A (Localization.Away z) a := by
    intro A σ _ _ _ 𝒜 _ z d hz a ha
    have h := hvm 𝒜 z d hz 0 a ha
    rwa [pow_zero, mul_one] at h

  have hval0 : ∀ {A σ : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A] (𝒜 : ℕ → σ)
      [GradedRing 𝒜] (z : A) (c : ↥(𝒜 0)),
      HomogeneousLocalization.val (algebraMap ↥(𝒜 0) (HomogeneousLocalization.Away 𝒜 z) c) =
        algebraMap A (Localization.Away z) (c : A) := by
    intro A σ _ _ _ 𝒜 _ z c
    rw [HomogeneousLocalization.algebraMap_eq, ← Localization.mk_one_eq_algebraMap]
    rfl

  have hlift : ∀ {A σ : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A] (𝒜 : ℕ → σ)
      [GradedRing 𝒜] (z : A) (d : ℕ) (hz : z ∈ 𝒜 d) (S : Type u) [CommRing S] (e : A →+* S),
      e z = 1 → ∃ ψ : HomogeneousLocalization.Away 𝒜 z →+* S, ∀ (k : ℕ) (a : A) (ha : a ∈ 𝒜 (k • d)),
        ψ (HomogeneousLocalization.Away.mk 𝒜 hz k a ha) = e a := by
    intro A σ _ _ _ 𝒜 _ z d hz S _ e he
    refine ⟨(Localization.awayLift e z (by rw [he]; exact isUnit_one)).comp (algebraMap _ _),
      fun k a ha => ?_⟩
    simp only [RingHom.comp_apply, HomogeneousLocalization.algebraMap_apply,
      HomogeneousLocalization.Away.val_mk]
    rw [Localization.awayLift_mk e z a 1 (by rw [he, one_mul]) k, one_pow, mul_one]

  have hH : ∀ {S : Type u} [CommRing S] (R : Type u) [CommRing R] (m : ℕ)
      (g h : MvPolynomial (Fin m) R →+* S) (s : S),
      (∀ r, g (MvPolynomial.C r) = h (MvPolynomial.C r)) →
      (∀ l, g (MvPolynomial.X l) = s * h (MvPolynomial.X l)) →
      ∀ (a : MvPolynomial (Fin m) R) (k : ℕ), a.IsHomogeneous k → g a = s ^ k * h a := by
    intro S _ R _ m g h s hC hXs a k ha
    conv_lhs => rw [a.as_sum]
    conv_rhs => rw [a.as_sum]
    rw [map_sum, map_sum, Finset.mul_sum]
    refine Finset.sum_congr rfl fun d hd => ?_
    have hdeg := ha (MvPolynomial.mem_support_iff.mp hd)
    simp only [Finsupp.weight_apply, Finsupp.sum, smul_eq_mul, mul_one, Pi.one_apply] at hdeg
    rw [MvPolynomial.monomial_eq, map_mul, map_mul, hC, Finsupp.prod, map_prod, map_prod]
    simp only [map_pow, hXs, mul_pow]
    rw [Finset.prod_mul_distrib, Finset.prod_pow_eq_pow_sum, hdeg]
    ring

  have hC3 : ∀ (R : Type u) [CommRing R] (m : ℕ)
      [GradedRing (MvPolynomial.homogeneousSubmodule (Fin m) R)]
      (z : MvPolynomial (Fin m) R) (hz : z ∈ MvPolynomial.homogeneousSubmodule (Fin m) R 1)
      (Θ : MvPolynomial (Fin m) R →+*
        HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin m) R) z),
      (∀ r : R, HomogeneousLocalization.val (Θ (MvPolynomial.C r)) =
        algebraMap (MvPolynomial (Fin m) R) (Localization.Away z) (MvPolynomial.C r)) →
      (∀ l : Fin m, HomogeneousLocalization.val (Θ (MvPolynomial.X l)) *
        algebraMap (MvPolynomial (Fin m) R) (Localization.Away z) z =
        algebraMap (MvPolynomial (Fin m) R) (Localization.Away z) (MvPolynomial.X l)) →
      ∀ (k : ℕ) (a : MvPolynomial (Fin m) R)
        (ha : a ∈ MvPolynomial.homogeneousSubmodule (Fin m) R (k • 1)),
        Θ a = HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin m) R) hz k a ha := by
    intro R _ m _ z hz Θ hC hX k a ha
    have hh : a.IsHomogeneous k := by
      have := (MvPolynomial.mem_homogeneousSubmodule _ _).mp ha
      simpa using this
    have hs := hH R m (algebraMap (MvPolynomial (Fin m) R) (Localization.Away z))
      ((algebraMap (HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin m) R) z)
        (Localization.Away z)).comp Θ)
      (algebraMap (MvPolynomial (Fin m) R) (Localization.Away z) z)
      (fun r => by
        simp only [RingHom.comp_apply, HomogeneousLocalization.algebraMap_apply]
        exact (hC r).symm)
      (fun l => by
        simp only [RingHom.comp_apply, HomogeneousLocalization.algebraMap_apply]
        rw [← hX l, mul_comm]) a k hh
    simp only [RingHom.comp_apply, HomogeneousLocalization.algebraMap_apply] at hs
    apply HomogeneousLocalization.val_injective
    have hv := hvm (MvPolynomial.homogeneousSubmodule (Fin m) R) z 1 hz k a ha
    have hu : IsUnit (algebraMap (MvPolynomial (Fin m) R) (Localization.Away z) z ^ k) :=
      (IsLocalization.Away.algebraMap_isUnit z).pow k
    refine hu.mul_left_inj.mp ?_
    rw [hv, hs, mul_comm]

  intro K _ n j s hs
  subst hs
  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) :=
    MvPolynomial.gradedAlgebra
  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (n + 1 + 1)) K) :=
    MvPolynomial.gradedAlgebra
  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin 2)
      (HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)
        (MvPolynomial.X j))) := MvPolynomial.gradedAlgebra
  intro ν f hν hFC hFX hFXl
  have hy : (MvPolynomial.X j : MvPolynomial (Fin (n + 1)) K) ∈
      MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K 1 :=
    (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K j)
  have hXl : ∀ l, (MvPolynomial.X l : MvPolynomial (Fin (n + 1)) K) ∈
      MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K (1 • 1) := fun l =>
    (MvPolynomial.mem_homogeneousSubmodule _ _).mpr (by
      rw [smul_eq_mul, mul_one]; exact MvPolynomial.isHomogeneous_X K l)
  have hX : ∀ i, (MvPolynomial.X i : MvPolynomial (Fin (n + 1 + 1)) K) ∈
      MvPolynomial.homogeneousSubmodule (Fin (n + 1 + 1)) K (1 • 1) := fun i =>
    (MvPolynomial.mem_homogeneousSubmodule _ _).mpr (by
      rw [smul_eq_mul, mul_one]; exact MvPolynomial.isHomogeneous_X K i)
  have hx : (MvPolynomial.X (Fin.castSucc j) : MvPolynomial (Fin (n + 1 + 1)) K) ∈
      MvPolynomial.homogeneousSubmodule (Fin (n + 1 + 1)) K 1 :=
    (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K _)
  have hC0 : ∀ c : K, (MvPolynomial.C c : MvPolynomial (Fin (n + 1)) K) ∈
      MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K (0 • 1) := fun c =>
    (MvPolynomial.mem_homogeneousSubmodule _ _).mpr (by
      rw [smul_eq_mul, zero_mul]; exact MvPolynomial.isHomogeneous_C _ c)
  have hC0' : ∀ c : K, (MvPolynomial.C c : MvPolynomial (Fin (n + 1 + 1)) K) ∈
      MvPolynomial.homogeneousSubmodule (Fin (n + 1 + 1)) K (0 • 1) := fun c =>
    (MvPolynomial.mem_homogeneousSubmodule _ _).mpr (by
      rw [smul_eq_mul, zero_mul]; exact MvPolynomial.isHomogeneous_C _ c)
  have hfx : f (MvPolynomial.X (Fin.castSucc j)) ∈ MvPolynomial.homogeneousSubmodule (Fin 2)
      (HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)
        (MvPolynomial.X j)) 1 := f.map_mem hx

  have hνj : ν j = 1 := by
    apply HomogeneousLocalization.val_injective
    rw [hν, HomogeneousLocalization.val_one]
    exact Localization.mk_self (⟨MvPolynomial.X j, Submonoid.mem_powers _⟩ :
      Submonoid.powers (MvPolynomial.X j : MvPolynomial (Fin (n + 1)) K))
  have hu : f (MvPolynomial.X (Fin.castSucc j)) = MvPolynomial.X 0 := by
    rw [hFX j, hνj, map_one, one_mul]
  have hιu : algebraMap (MvPolynomial (Fin 2)
      (HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)
        (MvPolynomial.X j))) (Localization.Away (f (MvPolynomial.X (Fin.castSucc j))))
        (f (MvPolynomial.X (Fin.castSucc j))) =
      algebraMap (MvPolynomial (Fin 2)
      (HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)
        (MvPolynomial.X j))) (Localization.Away (f (MvPolynomial.X (Fin.castSucc j))))
        (MvPolynomial.X 0) := congrArg _ hu
  have hunitA : IsUnit (algebraMap (MvPolynomial (Fin (n + 1)) K)
      (Localization.Away (MvPolynomial.X j : MvPolynomial (Fin (n + 1)) K)) (MvPolynomial.X j)) :=
    IsLocalization.Away.algebraMap_isUnit _
  have hunitA' : IsUnit (algebraMap (MvPolynomial (Fin (n + 1 + 1)) K)
      (Localization.Away (MvPolynomial.X (Fin.castSucc j) : MvPolynomial (Fin (n + 1 + 1)) K))
      (MvPolynomial.X (Fin.castSucc j))) :=
    IsLocalization.Away.algebraMap_isUnit _
  have hunitG : IsUnit (algebraMap (MvPolynomial (Fin 2)
      (HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)
        (MvPolynomial.X j))) (Localization.Away (f (MvPolynomial.X (Fin.castSucc j))))
        (f (MvPolynomial.X (Fin.castSucc j)))) :=
    IsLocalization.Away.algebraMap_isUnit _

  have hw1 : ∀ i, HomogeneousLocalization.val (HomogeneousLocalization.Away.mk
      (MvPolynomial.homogeneousSubmodule (Fin (n + 1 + 1)) K) hx 1 (MvPolynomial.X i) (hX i)) *
      algebraMap (MvPolynomial (Fin (n + 1 + 1)) K)
        (Localization.Away (MvPolynomial.X (Fin.castSucc j) : MvPolynomial (Fin (n + 1 + 1)) K))
        (MvPolynomial.X (Fin.castSucc j)) =
      algebraMap (MvPolynomial (Fin (n + 1 + 1)) K)
        (Localization.Away (MvPolynomial.X (Fin.castSucc j) : MvPolynomial (Fin (n + 1 + 1)) K))
        (MvPolynomial.X i) := by
    intro i
    have h := hvm _ _ 1 hx 1 (MvPolynomial.X i) (hX i)
    rwa [pow_one] at h
  have hy1 : ∀ l, HomogeneousLocalization.val (HomogeneousLocalization.Away.mk
      (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) hy 1 (MvPolynomial.X l) (hXl l)) *
      algebraMap (MvPolynomial (Fin (n + 1)) K)
        (Localization.Away (MvPolynomial.X j : MvPolynomial (Fin (n + 1)) K)) (MvPolynomial.X j) =
      algebraMap (MvPolynomial (Fin (n + 1)) K)
        (Localization.Away (MvPolynomial.X j : MvPolynomial (Fin (n + 1)) K)) (MvPolynomial.X l) := by
    intro l
    have h := hvm _ _ 1 hy 1 (MvPolynomial.X l) (hXl l)
    rwa [pow_one] at h

  have hF1 : ∀ l, ν l = HomogeneousLocalization.Away.mk
      (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) hy 1 (MvPolynomial.X l) (hXl l) := by
    intro l
    apply HomogeneousLocalization.val_injective
    refine hunitA.mul_left_inj.mp ?_
    rw [hy1 l, hν l, Localization.mk_eq_mk']
    exact IsLocalization.mk'_spec _ _ _

  have hκ : ∀ c : K, algebraMap ↥(MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K 0)
      (HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)
        (MvPolynomial.X j))
      (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K 0) c) =
      HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) hy 0
        (MvPolynomial.C c) (hC0 c) := by
    intro c
    apply HomogeneousLocalization.val_injective
    rw [hval0, hvm0, SetLike.GradeZero.coe_algebraMap, MvPolynomial.algebraMap_eq]
  have hκ' : ∀ c : K, algebraMap ↥(MvPolynomial.homogeneousSubmodule (Fin (n + 1 + 1)) K 0)
      (HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (n + 1 + 1)) K)
        (MvPolynomial.X (Fin.castSucc j)))
      (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (n + 1 + 1)) K 0) c) =
      HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (n + 1 + 1)) K) hx 0
        (MvPolynomial.C c) (hC0' c) := by
    intro c
    apply HomogeneousLocalization.val_injective
    rw [hval0, hvm0, SetLike.GradeZero.coe_algebraMap, MvPolynomial.algebraMap_eq]

  let e : MvPolynomial (Fin (n + 1)) K →+* HomogeneousLocalization.Away
      (MvPolynomial.homogeneousSubmodule (Fin (n + 1 + 1)) K) (MvPolynomial.X (Fin.castSucc j)) :=
    MvPolynomial.eval₂Hom
      ((algebraMap ↥(MvPolynomial.homogeneousSubmodule (Fin (n + 1 + 1)) K 0)
        (HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (n + 1 + 1)) K)
          (MvPolynomial.X (Fin.castSucc j)))).comp
        (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (n + 1 + 1)) K 0)))
      (fun l => HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (n + 1 + 1)) K)
        hx 1 (MvPolynomial.X (Fin.castSucc l)) (hX (Fin.castSucc l)))
  have heC : ∀ c : K, e (MvPolynomial.C c) =
      algebraMap ↥(MvPolynomial.homogeneousSubmodule (Fin (n + 1 + 1)) K 0)
        (HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (n + 1 + 1)) K)
          (MvPolynomial.X (Fin.castSucc j)))
        (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (n + 1 + 1)) K 0) c) :=
    fun c => MvPolynomial.eval₂Hom_C _ _ _
  have heX : ∀ l, e (MvPolynomial.X l) =
      HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (n + 1 + 1)) K)
        hx 1 (MvPolynomial.X (Fin.castSucc l)) (hX (Fin.castSucc l)) :=
    fun l => MvPolynomial.eval₂Hom_X' _ _ _
  clear_value e
  have he : e (MvPolynomial.X j) = 1 := by
    rw [heX]
    apply HomogeneousLocalization.val_injective
    refine hunitA'.mul_left_inj.mp ?_
    rw [hw1, HomogeneousLocalization.val_one, one_mul]
  obtain ⟨β, hβ⟩ := hlift (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X j) 1 hy
    _ e he
  have hβκ : ∀ c : K, β (algebraMap ↥(MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K 0)
      (HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)
        (MvPolynomial.X j))
      (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K 0) c)) =
      algebraMap ↥(MvPolynomial.homogeneousSubmodule (Fin (n + 1 + 1)) K 0)
        (HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (n + 1 + 1)) K)
          (MvPolynomial.X (Fin.castSucc j)))
        (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (n + 1 + 1)) K 0) c) := by
    intro c
    rw [hκ, hβ, heC]
  have hβν : ∀ l, β (ν l) =
      HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (n + 1 + 1)) K)
        hx 1 (MvPolynomial.X (Fin.castSucc l)) (hX (Fin.castSucc l)) := by
    intro l
    rw [hF1 l, hβ, heX]

  let e₂ : MvPolynomial (Fin 2) (HomogeneousLocalization.Away
      (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X j)) →+*
      HomogeneousLocalization.Away
        (MvPolynomial.homogeneousSubmodule (Fin (n + 1 + 1)) K) (MvPolynomial.X (Fin.castSucc j)) :=
    MvPolynomial.eval₂Hom β ![1, HomogeneousLocalization.Away.mk
      (MvPolynomial.homogeneousSubmodule (Fin (n + 1 + 1)) K) hx 1
      (MvPolynomial.X (Fin.last (n + 1))) (hX (Fin.last (n + 1)))]
  have he₂C : ∀ r, e₂ (MvPolynomial.C r) = β r := fun r => MvPolynomial.eval₂Hom_C _ _ _
  have he₂X0 : e₂ (MvPolynomial.X 0) = 1 := by
    rw [MvPolynomial.eval₂Hom_X']
    rfl
  have he₂X1 : e₂ (MvPolynomial.X 1) = HomogeneousLocalization.Away.mk
      (MvPolynomial.homogeneousSubmodule (Fin (n + 1 + 1)) K) hx 1
      (MvPolynomial.X (Fin.last (n + 1))) (hX (Fin.last (n + 1))) := by
    rw [MvPolynomial.eval₂Hom_X']
    rfl
  clear_value e₂
  have he₂ : e₂ (f (MvPolynomial.X (Fin.castSucc j))) = 1 := by
    rw [hFX j, map_mul, he₂C, he₂X0, hνj, map_one, one_mul]
  obtain ⟨ψ, hψ⟩ := hlift (MvPolynomial.homogeneousSubmodule (Fin 2)
      (HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)
        (MvPolynomial.X j))) (f (MvPolynomial.X (Fin.castSucc j))) 1 hfx _ e₂ he₂

  have hcompat : ∀ r : HomogeneousLocalization.Away
      (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X j),
      HomogeneousLocalization.val (HomogeneousLocalization.Away.map f
        (MvPolynomial.X (Fin.castSucc j)) (β r)) =
      algebraMap (MvPolynomial (Fin 2)
        (HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)
          (MvPolynomial.X j)))
        (Localization.Away (f (MvPolynomial.X (Fin.castSucc j)))) (MvPolynomial.C r) := by
    let Θ : MvPolynomial (Fin (n + 1)) K →+* HomogeneousLocalization.Away
        (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X j) :=
      MvPolynomial.eval₂Hom
        ((algebraMap ↥(MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K 0)
          (HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)
            (MvPolynomial.X j))).comp
          (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K 0))) ν
    have hΘC : ∀ c : K, Θ (MvPolynomial.C c) =
        algebraMap ↥(MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K 0)
          (HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)
            (MvPolynomial.X j))
          (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K 0) c) :=
      fun c => MvPolynomial.eval₂Hom_C _ _ _
    have hΘX : ∀ l, Θ (MvPolynomial.X l) = ν l := fun l => MvPolynomial.eval₂Hom_X' _ _ _
    clear_value Θ
    have hΘ := hC3 K (n + 1) (MvPolynomial.X j) hy Θ
      (fun c => by rw [hΘC, hval0, SetLike.GradeZero.coe_algebraMap, MvPolynomial.algebraMap_eq])
      (fun l => by rw [hΘX, hF1 l]; exact hy1 l)
    intro r
    obtain ⟨k, a, ha, rfl⟩ := HomogeneousLocalization.Away.mk_surjective _ hy r
    rw [← hΘ k a ha]
    have hL : (algebraMap (HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin 2)
        (HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)
          (MvPolynomial.X j))) (f (MvPolynomial.X (Fin.castSucc j))))
        (Localization.Away (f (MvPolynomial.X (Fin.castSucc j))))).comp
        ((HomogeneousLocalization.Away.map f (MvPolynomial.X (Fin.castSucc j))).comp (β.comp Θ)) =
        (algebraMap (MvPolynomial (Fin 2)
          (HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)
            (MvPolynomial.X j)))
          (Localization.Away (f (MvPolynomial.X (Fin.castSucc j))))).comp
          (MvPolynomial.C.comp Θ) := by
      apply MvPolynomial.ringHom_ext
      · intro c
        simp only [RingHom.comp_apply, HomogeneousLocalization.algebraMap_apply]
        rw [hΘC, hβκ, hκ', HomogeneousLocalization.Away.map_mk, hvm0, hFC]
      · intro l
        simp only [RingHom.comp_apply, HomogeneousLocalization.algebraMap_apply]
        rw [hΘX, hβν, HomogeneousLocalization.Away.map_mk]
        refine hunitG.mul_left_inj.mp ?_
        have h := hvm _ _ 1 hfx 1 (f (MvPolynomial.X (Fin.castSucc l))) (f.map_mem (hX _))
        rw [pow_one] at h
        rw [h, hFX l, map_mul, hιu]
    have := RingHom.congr_fun hL a
    simp only [RingHom.comp_apply, HomogeneousLocalization.algebraMap_apply] at this
    exact this

  have hl : ∀ z, ψ (HomogeneousLocalization.Away.map f (MvPolynomial.X (Fin.castSucc j)) z) = z := by
    intro z
    obtain ⟨k, a, ha, rfl⟩ := HomogeneousLocalization.Away.mk_surjective _ hx z
    rw [HomogeneousLocalization.Away.map_mk, hψ]
    have hΘ' : ∀ p, (e₂.comp f.toRingHom) p = e₂ (f p) := fun p => rfl
    have key := hC3 K (n + 1 + 1) (MvPolynomial.X (Fin.castSucc j)) hx (e₂.comp f.toRingHom)
      (fun c => by
        rw [hΘ', hFC, he₂C, hβκ, hval0, SetLike.GradeZero.coe_algebraMap,
          MvPolynomial.algebraMap_eq])
      (fun i => by
        rw [hΘ']
        induction i using Fin.lastCases with
        | last => rw [hFXl, he₂X1]; exact hw1 _
        | cast l => rw [hFX l, map_mul, he₂C, he₂X0, mul_one, hβν]; exact hw1 _)
      k a ha
    rw [← hΘ', key]

  have hr : ∀ w, HomogeneousLocalization.Away.map f (MvPolynomial.X (Fin.castSucc j)) (ψ w) = w := by
    intro w
    obtain ⟨k, b, hb, rfl⟩ := HomogeneousLocalization.Away.mk_surjective _ hfx w
    rw [hψ]
    have h0 : HomogeneousLocalization.val
        (((HomogeneousLocalization.Away.map f (MvPolynomial.X (Fin.castSucc j))).comp e₂)
          (MvPolynomial.X 0)) *
        algebraMap (MvPolynomial (Fin 2)
          (HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)
            (MvPolynomial.X j)))
          (Localization.Away (f (MvPolynomial.X (Fin.castSucc j))))
          (f (MvPolynomial.X (Fin.castSucc j))) =
        algebraMap (MvPolynomial (Fin 2)
          (HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)
            (MvPolynomial.X j)))
          (Localization.Away (f (MvPolynomial.X (Fin.castSucc j)))) (MvPolynomial.X 0) := by
      rw [RingHom.comp_apply, he₂X0, map_one, HomogeneousLocalization.val_one, one_mul]
      exact hιu
    have h1 : HomogeneousLocalization.val
        (((HomogeneousLocalization.Away.map f (MvPolynomial.X (Fin.castSucc j))).comp e₂)
          (MvPolynomial.X 1)) *
        algebraMap (MvPolynomial (Fin 2)
          (HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)
            (MvPolynomial.X j)))
          (Localization.Away (f (MvPolynomial.X (Fin.castSucc j))))
          (f (MvPolynomial.X (Fin.castSucc j))) =
        algebraMap (MvPolynomial (Fin 2)
          (HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)
            (MvPolynomial.X j)))
          (Localization.Away (f (MvPolynomial.X (Fin.castSucc j)))) (MvPolynomial.X 1) := by
      rw [RingHom.comp_apply, he₂X1, HomogeneousLocalization.Away.map_mk]
      have h := hvm _ _ 1 hfx 1 (f (MvPolynomial.X (Fin.last (n + 1)))) (f.map_mem (hX _))
      rw [pow_one] at h
      rw [h, hFXl]
    have key := hC3 _ 2 (f (MvPolynomial.X (Fin.castSucc j))) hfx
      ((HomogeneousLocalization.Away.map f (MvPolynomial.X (Fin.castSucc j))).comp e₂)
      (fun r => by rw [RingHom.comp_apply, he₂C]; exact hcompat r)
      (fun i => by fin_cases i; exacts [h0, h1])
      k b hb
    rw [← key]
    rfl
  exact Function.bijective_iff_has_inverse.mpr ⟨ψ, hl, hr⟩

theorem wc_bc_irrelevant_le : ∀ {R S : Type u} [CommRing R] [CommRing S] (m : ℕ),
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin m) R) := MvPolynomial.gradedAlgebra
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin 2) S) := MvPolynomial.gradedAlgebra
    ∀ (g : MvPolynomial.homogeneousSubmodule (Fin m) R →+*ᵍ MvPolynomial.homogeneousSubmodule (Fin 2) S)
      (i₀ i₁ : Fin m) (c : S), IsUnit c → g (MvPolynomial.X i₀) = MvPolynomial.C c * MvPolynomial.X 0 →
      g (MvPolynomial.X i₁) = MvPolynomial.X 1 →
      HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin 2) S) ≤
        HomogeneousIdeal.map g (HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin m) R)) :=
by
  intro R S _ _ m g i₀ i₁ c hc h0 h1
  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin m) R) := MvPolynomial.gradedAlgebra
  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin 2) S) := MvPolynomial.gradedAlgebra

  have hXirr : ∀ j : Fin m, (MvPolynomial.X j : MvPolynomial (Fin m) R) ∈
      (HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin m) R)).toIdeal := by
    intro j
    rw [HomogeneousIdeal.mem_iff, HomogeneousIdeal.mem_irrelevant_iff, GradedRing.proj_apply]
    have hX : (MvPolynomial.X j : MvPolynomial (Fin m) R) ∈
        MvPolynomial.homogeneousSubmodule (Fin m) R 1 := by
      rw [MvPolynomial.mem_homogeneousSubmodule]
      exact MvPolynomial.isHomogeneous_X R j
    rw [DirectSum.decompose_of_mem_ne _ hX one_ne_zero]
  intro x hx
  rw [← HomogeneousIdeal.mem_iff, HomogeneousIdeal.toIdeal_map]
  set J := Ideal.map g (HomogeneousIdeal.irrelevant
    (MvPolynomial.homogeneousSubmodule (Fin m) R)).toIdeal with hJ

  have hx0 : x.coeff 0 = 0 := by
    rw [HomogeneousIdeal.mem_irrelevant_iff, GradedRing.proj_apply] at hx
    have e : ((DirectSum.decompose (MvPolynomial.homogeneousSubmodule (Fin 2) S) x 0 :
        MvPolynomial (Fin 2) S)) = MvPolynomial.homogeneousComponent 0 x :=
      MvPolynomial.decomposition.decompose'_apply x 0
    rw [e, MvPolynomial.homogeneousComponent_zero, MvPolynomial.C_eq_zero] at hx
    exact hx

  have hspan : x ∈ Ideal.span (MvPolynomial.X '' (Set.univ : Set (Fin 2))) := by
    rw [MvPolynomial.mem_ideal_span_X_image]
    intro d hd
    have hd0 : d ≠ 0 := by
      rintro rfl
      exact (MvPolynomial.mem_support_iff.mp hd) hx0
    obtain ⟨i, hi⟩ := Finsupp.ne_iff.mp hd0
    exact ⟨i, Set.mem_univ _, by simpa using hi⟩
  have hX1 : (MvPolynomial.X 1 : MvPolynomial (Fin 2) S) ∈ J := by
    rw [← h1]
    exact Ideal.mem_map_of_mem g (hXirr i₁)
  have hX0 : (MvPolynomial.X 0 : MvPolynomial (Fin 2) S) ∈ J := by
    have e : (MvPolynomial.X 0 : MvPolynomial (Fin 2) S) =
        MvPolynomial.C (↑hc.unit⁻¹ : S) * g (MvPolynomial.X i₀) := by
      rw [h0, ← mul_assoc, ← MvPolynomial.C_mul, IsUnit.val_inv_mul, MvPolynomial.C_1, one_mul]
    rw [e]
    exact Ideal.mul_mem_left J _ (Ideal.mem_map_of_mem g (hXirr i₀))
  have hle : Ideal.span (MvPolynomial.X '' (Set.univ : Set (Fin 2))) ≤ J := by
    rw [Ideal.span_le]
    rintro y ⟨i, -, rfl⟩
    fin_cases i
    · exact hX0
    · exact hX1
  exact hle hspan

theorem wc_bc_open_pullback_lift_surj : ∀ {X Y Z W : Scheme.{u}} (f : X ⟶ Z) (g : Y ⟶ Z) (h : W ⟶ Z) [IsOpenImmersion f] [IsOpenImmersion g]
    [IsOpenImmersion h] (i₁ : W ⟶ X) (i₂ : W ⟶ Y) (h₁ : i₁ ≫ f = h) (h₂ : i₂ ≫ g = h),
    f.opensRange ⊓ g.opensRange ≤ h.opensRange →
    ∀ x : ↥(Limits.pullback f g), ∃ y : ↥W, (Limits.pullback.lift i₁ i₂ (h₁.trans h₂.symm)) y = x :=
by
  intro X Y Z W f g h _ _ _ i₁ i₂ h₁ h₂ hle x
  have hq : Function.Injective ⇑(Limits.pullback.fst f g ≫ f) :=
    (Limits.pullback.fst f g ≫ f).isOpenEmbedding.injective
  have hxf : (Limits.pullback.fst f g ≫ f) x ∈ f.opensRange :=
    Scheme.Hom.mem_opensRange.mpr ⟨Limits.pullback.fst f g x, (Scheme.Hom.comp_apply _ _ _).symm⟩
  have hxg : (Limits.pullback.fst f g ≫ f) x ∈ g.opensRange := by
    rw [Limits.pullback.condition]
    exact Scheme.Hom.mem_opensRange.mpr ⟨Limits.pullback.snd f g x, (Scheme.Hom.comp_apply _ _ _).symm⟩
  have hz : (Limits.pullback.fst f g ≫ f) x ∈ h.opensRange := hle ⟨hxf, hxg⟩
  obtain ⟨y, hy⟩ := Scheme.Hom.mem_opensRange.mp hz
  refine ⟨y, hq ?_⟩
  have e : Limits.pullback.lift i₁ i₂ (h₁.trans h₂.symm) ≫ (Limits.pullback.fst f g ≫ f) = h := by
    rw [← Category.assoc, Limits.pullback.lift_fst, h₁]
  rw [← Scheme.Hom.comp_apply, e, hy]

theorem wc_bc_isIso_restrict_of_open : ∀ {X Y Z Z' : Scheme.{u}} (f : X ⟶ Y) (U : Y.Opens) (W : Z ⟶ X) (V : Z' ⟶ Y) (h : Z ⟶ Z')
    [IsOpenImmersion W] [IsOpenImmersion V] [IsIso h],
    W.opensRange = f ⁻¹ᵁ U → V.opensRange = U → W ≫ f = h ≫ V → IsIso (f ∣_ U) :=
by
  intro X Y Z Z' f U W V h _ _ _ hW hV hc
  let e₁ : Z ≅ (f ⁻¹ᵁ U).toScheme := W.isoOpensRange ≪≫ X.isoOfEq hW
  let e₂ : Z' ≅ U.toScheme := V.isoOpensRange ≪≫ Y.isoOfEq hV
  have h1 : e₁.hom ≫ (f ⁻¹ᵁ U).ι = W := by
    simp only [e₁, Iso.trans_hom, Category.assoc, Scheme.isoOfEq_hom_ι,
      Scheme.Hom.isoOpensRange_hom_ι]
  have h2 : e₂.hom ≫ U.ι = V := by
    simp only [e₂, Iso.trans_hom, Category.assoc, Scheme.isoOfEq_hom_ι,
      Scheme.Hom.isoOpensRange_hom_ι]
  have sq : e₁.hom ≫ (f ∣_ U) = h ≫ e₂.hom := by
    rw [← cancel_mono U.ι, Category.assoc, Category.assoc, morphismRestrict_ι, h2,
      ← Category.assoc, h1, hc]
  have : IsIso (e₁.hom ≫ (f ∣_ U)) := by rw [sq]; infer_instance
  exact IsIso.of_isIso_comp_left e₁.hom (f ∣_ U)

theorem wc_bc_arrow_iso_of_pullback : ∀ {X S T Y P : Scheme.{u}} (h : X ⟶ S) (s : S ⟶ T) [IsIso s] (ι : X ⟶ P) (e : T ⟶ Y) [IsOpenImmersion e]
    (ρ : P ⟶ Y), IsPullback (h ≫ s) ι e ρ → Nonempty (Arrow.mk (ρ ∣_ e.opensRange) ≅ Arrow.mk h) :=
by
  intro X S T Y P h s _ ι e _ ρ hP
  have hP' : IsPullback ((h ≫ s) ≫ e.isoOpensRange.hom) ι e.opensRange.ι ρ :=
    IsPullback.of_iso hP (Iso.refl _) e.isoOpensRange (Iso.refl _) (Iso.refl _)
      (by simp) (by simp) (by simp [Scheme.Hom.isoOpensRange_hom_ι]) (by simp)
  have hR := isPullback_morphismRestrict ρ e.opensRange
  have hfst : (IsPullback.isoIsPullback _ _ hP' hR).hom ≫ ρ ∣_ e.opensRange =
      (h ≫ s) ≫ e.isoOpensRange.hom :=
    IsPullback.isoIsPullback_hom_fst _ _ hP' hR
  refine ⟨Arrow.isoMk' _ _ (IsPullback.isoIsPullback _ _ hP' hR).symm
    (asIso s ≪≫ e.isoOpensRange).symm ?_⟩
  rw [← cancel_epi (IsPullback.isoIsPullback _ _ hP' hR).hom]
  simp only [Iso.symm_hom, Iso.hom_inv_id_assoc, Iso.trans_inv, asIso_inv]
  rw [← Category.assoc, hfst]
  simp

theorem wc_blowup_charts : ∀ (K : Type u) [Field K] (n : ℕ), ∃ (P : Scheme.{u})
    (σ : P ⟶ wcProjK K (n + 1)) (ρ : P ⟶ wcProjK K n),
    σ ≫ wcProjKStr K (n + 1) = ρ ≫ wcProjKStr K n ∧
    (∀ j : Fin (n + 1), IsIso (σ ∣_ @Proj.basicOpen _ _ _ _ _
        (MvPolynomial.homogeneousSubmodule (Fin (n + 1 + 1)) K) MvPolynomial.gradedAlgebra
        (MvPolynomial.X (Fin.castSucc j)))) ∧
    (∀ a b : P,
      (∀ j : Fin (n + 1), σ a ∉ @Proj.basicOpen _ _ _ _ _
        (MvPolynomial.homogeneousSubmodule (Fin (n + 1 + 1)) K) MvPolynomial.gradedAlgebra
        (MvPolynomial.X (Fin.castSucc j))) →
      (∀ j : Fin (n + 1), σ b ∉ @Proj.basicOpen _ _ _ _ _
        (MvPolynomial.homogeneousSubmodule (Fin (n + 1 + 1)) K) MvPolynomial.gradedAlgebra
        (MvPolynomial.X (Fin.castSucc j))) →
      ρ a = ρ b → a = b) ∧
    ∀ j : Fin (n + 1), ∃ (A : Type u) (_ : CommRing A),
      Nonempty (Arrow.mk (ρ ∣_ @Proj.basicOpen _ _ _ _ _
          (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) MvPolynomial.gradedAlgebra
          (MvPolynomial.X j)) ≅
        Arrow.mk (@Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) A)
          MvPolynomial.gradedAlgebra)) :=
by
  intro K _ n
  have hprod : ∀ S : Finset (Fin (n + 1)),
      (∏ m ∈ S, MvPolynomial.X m : MvPolynomial (Fin (n + 1)) K) ∈
        MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K S.card := fun S =>
    (MvPolynomial.mem_homogeneousSubmodule _ _).mpr (by
      simpa using MvPolynomial.IsHomogeneous.prod S
        (fun m => (MvPolynomial.X m : MvPolynomial (Fin (n + 1)) K)) (fun _ => 1)
        (fun m _ => MvPolynomial.isHomogeneous_X K m))
  have hνmem : ∀ (S : Finset (Fin (n + 1))) (j l : Fin (n + 1)), j ∈ S →
      (MvPolynomial.X l * ∏ m ∈ S.erase j, MvPolynomial.X m : MvPolynomial (Fin (n + 1)) K) ∈
        MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K (1 • S.card) := by
    intro S j l hj
    rw [MvPolynomial.mem_homogeneousSubmodule]
    have h2 := Finset.card_erase_of_mem hj
    have h1 : 0 < S.card := Finset.card_pos.mpr ⟨j, hj⟩
    have h3 := (MvPolynomial.isHomogeneous_X K l).mul (MvPolynomial.IsHomogeneous.prod
      (S.erase j) (fun m => (MvPolynomial.X m : MvPolynomial (Fin (n + 1)) K))
      (fun _ => 1) (fun m _ => MvPolynomial.isHomogeneous_X K m))
    convert h3 using 1
    simp only [Finset.sum_const, smul_eq_mul, mul_one, h2]
    omega
  have hXn : ∀ i : Fin (n + 1), (MvPolynomial.X i : MvPolynomial (Fin (n + 1)) K) ∈
      MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K 1 := fun i =>
    (MvPolynomial.mem_homogeneousSubmodule _ _).mpr (MvPolynomial.isHomogeneous_X K i)
  have hX : ∀ i : Fin (n + 1 + 1), (MvPolynomial.X i : MvPolynomial (Fin (n + 1 + 1)) K) ∈
      MvPolynomial.homogeneousSubmodule (Fin (n + 1 + 1)) K 1 := fun i =>
    (MvPolynomial.mem_homogeneousSubmodule _ _).mpr (MvPolynomial.isHomogeneous_X K i)
  have hsd : ∀ (S S' : Finset (Fin (n + 1))), S' ⊆ S →
      (∏ m ∈ S, MvPolynomial.X m : MvPolynomial (Fin (n + 1)) K) =
        (∏ m ∈ S', MvPolynomial.X m) * ∏ m ∈ S \ S', MvPolynomial.X m :=
    fun S S' h => (Finset.prod_sdiff h).symm.trans (mul_comm _ _)
  have hjT : ∀ T : wcBlIdx n, T.1.min' T.2 ∈ T.1 := fun T => Finset.min'_mem _ _
  have hL2 : ∀ (T T' : wcBlIdx n) (h : T'.1 ⊆ T.1),
      wcBlNu K n T (T.1.min' T.2) = 1 ∧
      (∀ l, wcBlPhi K n T.1 T'.1 h (wcBlNu K n T' l) * wcBlNu K n T (T'.1.min' T'.2) =
        wcBlNu K n T l) ∧
      wcBlNu K n T (T'.1.min' T'.2) * HomogeneousLocalization.Away.mk _ (hprod T.1) 1 _
        (hνmem T.1 (T'.1.min' T'.2) (T.1.min' T.2) (h (hjT T'))) = 1 := fun T T' h =>
    wc_bc_coord_identities K n T.1 T'.1 (T.1.min' T.2) (T'.1.min' T'.2) (hprod _) (hprod _)
      (fun l => hνmem T.1 _ l (hjT T)) (fun l => hνmem T'.1 _ l (hjT T'))
      (fun l => hνmem T.1 _ l (h (hjT T'))) (hprod _) (hsd _ _ h) (hjT T) (hjT T') h
  have hunit : ∀ (T T' : wcBlIdx n) (h : T'.1 ⊆ T.1), IsUnit (wcBlNu K n T (T'.1.min' T'.2)) :=
    fun T T' h => isUnit_iff_exists_inv.mpr ⟨_, (hL2 T T' h).2.2⟩
  have hGC : ∀ (T T' : wcBlIdx n) (h : T'.1 ⊆ T.1) (r : wcBlB K n T'.1),
      wcBlG K n T T' h (MvPolynomial.C r) = MvPolynomial.C (wcBlPhi K n T.1 T'.1 h r) := by
    intro T T' h r
    show MvPolynomial.eval₂Hom _ _ (MvPolynomial.C r) = _
    simp
  have hGX0 : ∀ (T T' : wcBlIdx n) (h : T'.1 ⊆ T.1), wcBlG K n T T' h (MvPolynomial.X 0) =
      MvPolynomial.C (wcBlNu K n T (T'.1.min' T'.2)) * MvPolynomial.X 0 := by
    intro T T' h
    show MvPolynomial.eval₂Hom _ _ (MvPolynomial.X 0) = _
    simp
  have hGX1 : ∀ (T T' : wcBlIdx n) (h : T'.1 ⊆ T.1), wcBlG K n T T' h (MvPolynomial.X 1) =
      MvPolynomial.X 1 := by
    intro T T' h
    show MvPolynomial.eval₂Hom _ _ (MvPolynomial.X 1) = _
    simp
  have hFC : ∀ (T : wcBlIdx n) (k : K), wcBlF K n T (MvPolynomial.C k) =
      MvPolynomial.C (algebraMap ↥(MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K 0)
        (wcBlB K n T.1) (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K 0) k)) := by
    intro T k
    show MvPolynomial.eval₂Hom _ _ (MvPolynomial.C k) = _
    simp
  have hFX : ∀ (T : wcBlIdx n) (l : Fin (n + 1)), wcBlF K n T (MvPolynomial.X (Fin.castSucc l)) =
      MvPolynomial.C (wcBlNu K n T l) * MvPolynomial.X 0 := by
    intro T l
    show MvPolynomial.eval₂Hom _ _ (MvPolynomial.X (Fin.castSucc l)) = _
    simp
  have hFXl : ∀ (T : wcBlIdx n), wcBlF K n T (MvPolynomial.X (Fin.last (n + 1))) =
      MvPolynomial.X 1 := by
    intro T
    show MvPolynomial.eval₂Hom _ _ (MvPolynomial.X (Fin.last (n + 1))) = _
    simp
  have hirrG : ∀ (T T' : wcBlIdx n) (h : T'.1 ⊆ T.1),
      HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin 2) (wcBlB K n T.1)) ≤
        HomogeneousIdeal.map (wcBlG K n T T' h)
          (HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin 2) (wcBlB K n T'.1))) :=
    fun T T' h => wc_bc_irrelevant_le 2 (wcBlG K n T T' h) 0 1 _ (hunit T T' h) (hGX0 T T' h)
      (hGX1 T T' h)
  have hirrF : ∀ (T : wcBlIdx n),
      HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin 2) (wcBlB K n T.1)) ≤
        HomogeneousIdeal.map (wcBlF K n T)
          (HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (n + 1 + 1)) K)) :=
    fun T => wc_bc_irrelevant_le (n + 1 + 1) (wcBlF K n T) (Fin.castSucc (T.1.min' T.2))
      (Fin.last _) 1 isUnit_one (by rw [hFX, (hL2 T T subset_rfl).1]) (hFXl T)
  have hPhiId : ∀ (T : wcBlIdx n) (h : T.1 ⊆ T.1), wcBlPhi K n T.1 T.1 h = RingHom.id _ := by
    intro T h
