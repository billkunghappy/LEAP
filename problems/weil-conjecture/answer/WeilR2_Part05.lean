        rw [h1]
        exact h2
      · change O.ι ⟨x, hx⟩ = x
        exact Scheme.Opens.ι_apply O ⟨x, hx⟩
    · have hE := Presheaf.equalizerSieve_mem (Scheme.smallEtaleTopology X)
        (toSheafify (Scheme.smallEtaleTopology X) P) (X := Opposite.op T)
        (ρ.ρ T ((wcEtBaseChange i).obj T) (Limits.pullback.fst T.hom i)
          Limits.pullback.condition g) 0
        (by rw [map_zero]; exact (hβ T g).trans hg)
      change _ ∈ Scheme.smallGrothendieckTopology @Etale X T at hE
      rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale X
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hE
      obtain ⟨Y, c, y, hc, hy⟩ : ∃ (Y : X.Etale) (c : Y ⟶ T) (y : Y.left),
          (P.map c.op).hom (ρ.ρ T ((wcEtBaseChange i).obj T) (Limits.pullback.fst T.hom i)
            Limits.pullback.condition g) = (P.map c.op).hom 0 ∧ c.left y = x := by
        obtain ⟨Y, c, y, hc, -, hy⟩ := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale X
          MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mp hE x
        exact ⟨Y, c, y, hc, hy⟩
      have hc' : (H.obj.map ((wcEtBaseChange i).map c).op).hom
          (ρ.ρ T ((wcEtBaseChange i).obj T) (Limits.pullback.fst T.hom i)
            Limits.pullback.condition g) = 0 := by
        have h := hc
        rw [map_zero] at h
        exact h
      have hnat := ρ.nat T Y c ((wcEtBaseChange i).obj T) ((wcEtBaseChange i).obj Y)
        ((wcEtBaseChange i).map c) (Limits.pullback.fst T.hom i) Limits.pullback.condition
        (Limits.pullback.fst Y.hom i) Limits.pullback.condition
        (Limits.pullback.lift_fst _ _ _).symm g
      have hE' := hnat.trans hc'
      have hyx : Y.hom y = T.hom x := by
        have hw : c.left ≫ T.hom = Y.hom := MorphismProperty.Over.w c
        rw [← hy]
        exact (congrArg (fun k : Y.left ⟶ X => k y) hw).symm.trans
          (Scheme.Hom.comp_apply c.left T.hom y)
      have hyr : y ∈ Set.range (Limits.pullback.fst Y.hom i) := by
        rw [Scheme.Pullback.range_fst]
        show Y.hom y ∈ Set.range i
        rw [hyx, hW]
        exact hx
      obtain ⟨o, ho⟩ := hyr
      obtain ⟨V', c', v', hcv, hc'0⟩ := hinj Y ((wcEtBaseChange i).obj Y)
        (Limits.pullback.fst Y.hom i) Limits.pullback.condition ((G.obj.map c.op).hom g) o hE'
      refine ⟨V', c' ≫ c, (hRdef _).mpr (Or.inr ?_), ⟨v', ?_⟩⟩
      · rw [hcompG c' c g]
        exact hc'0
      · show (c'.left ≫ c.left) v' = x
        exact (Scheme.Hom.comp_apply c'.left c.left v').trans
          ((congrArg (fun z => c.left z) (hcv.trans ho)).trans hy)
  refine GrothendieckTopology.transitive _ hR _ ?_
  intro T' c hc
  rcases (hRdef c).mp hc with hc | hc
  · refine GrothendieckTopology.superset_covering _ ?_ (hcov T' hc ((G.obj.map c.op).hom g))
    intro T'' d hd
    obtain ⟨t, ht⟩ := hd
    exact ⟨t, ht.trans (hcompG d c g).symm⟩
  · refine GrothendieckTopology.superset_covering _ ?_ (GrothendieckTopology.top_mem _ T')
    intro T'' d _
    refine ⟨0, ?_⟩
    have e1 : (G.obj.map (d ≫ c).op).hom g = 0 := by rw [hcompG d c g, hc, map_zero]
    rw [map_zero]
    exact e1.symm

theorem wc_et_open_closed_unit_seq : ∀ (X Z : Scheme.{u}) (i : Z ⟶ X) [IsClosedImmersion i] (W : X.Opens), Set.range i = (W : Set X)ᶜ → ∀ (L : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1} ⥤ Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) (adj : L ⊣ wcEtPush i) (U : X.Etale) (G : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) (p : (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj (yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶ G), Epi p → ∃ S : ShortComplex (Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}), S.ShortExact ∧ Nonempty (S.X₁ ≅ Limits.image ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map (Functor.whiskerRight (yoneda.map (wcEtOpenι X U (U.hom ⁻¹ᵁ W))) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) ≫ p)) ∧ Nonempty (S.X₂ ≅ G) ∧ Nonempty (S.X₃ ≅ (wcEtPush i).obj (L.obj G)) :=
by
  intro X Z i _ W hW L adj U G p hp

  have hjs : ∀ (V : Z.Etale) (S : Sieve V), (∀ v : V.left, ∃ (V₁ : Z.Etale)
      (c : V₁ ⟶ V), S.arrows c ∧ v ∈ Set.range c.left) → S ∈ Scheme.smallEtaleTopology Z V := by
    intro V S hS
    change S ∈ Scheme.smallGrothendieckTopology @Etale Z V
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Z
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
    apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Z
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
    intro x
