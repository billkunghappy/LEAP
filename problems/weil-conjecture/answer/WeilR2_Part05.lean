    refine ⟨(wcEtBaseChange i).obj W₁, (wcEtBaseChange i).map a,
      Sieve.image_mem_functorPushforward (wcEtBaseChange i) S ha, ?_⟩
    have h0 : (Limits.pullback.fst W₁.hom i ≫ a.left) ≫ V.hom = Limits.pullback.snd W₁.hom i ≫ i := by
      rw [Category.assoc, MorphismProperty.Over.w a]
