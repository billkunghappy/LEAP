        refine ⟨A''.hom.left (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField b'))), ?_⟩
        have hca := Scheme.Hom.comp_apply A''.hom.left c.left
          (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField b')))
        rw [hW2] at hca
        exact hca.symm
      exact hsp.mem_open hopen hmem
    obtain ⟨x₂, hx₂⟩ := hp
    obtain ⟨t₂, ht₂c, -⟩ := hlift (AlgebraicClosure (B.residueField b)) c.left t x₂ hx₂
    have ht₂ : t₂ ≫ A''.right.hom = wcEtGeomPt B b := by
      rw [← hcw, ← Category.assoc, ht₂c, ht]
    refine ⟨t₂, ht₂, ?_⟩
    let ĉ : StructuredArrow.mk (Over.homMk t₂ ht₂ : Over.mk (wcEtGeomPt B b) ⟶
          (Scheme.Etale.forget B).obj A''.right) ⟶
        StructuredArrow.mk (Over.homMk t ht : Over.mk (wcEtGeomPt B b) ⟶
          (Scheme.Etale.forget B).obj V) :=
      StructuredArrow.homMk c (by ext; exact ht₂c)
    have hw := congrArg (fun φ => φ.hom s) (Limits.colimit.w ((StructuredArrow.proj
      (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B)).op ⋙ F.obj) ĉ.op)
    exact hw.symm
  refine ⟨fun h0 => ?_, fun G' ι' hR => ?_⟩
  · obtain ⟨A'', f, f', hff⟩ := (wc_et_stalk_germ_facts B b' (hcof b') F).2.1
      (StructuredArrow.mk (Over.homMk t' ht' : Over.mk (wcEtGeomPt B b') ⟶
        (Scheme.Etale.forget B).obj V))
      (StructuredArrow.mk (Over.homMk t' ht' : Over.mk (wcEtGeomPt B b') ⟶
        (Scheme.Etale.forget B).obj V)) s 0
      (h0.trans (map_zero _).symm)
    obtain ⟨t₂, ht₂, he⟩ := key A'' f
    rw [he, hff]
    simp only [map_zero]
  · obtain ⟨γ, hγ⟩ := hR
    obtain ⟨A₁, g₁, rfl⟩ := (wc_et_stalk_germ_facts B b' (hcof b') G').1 γ
    have hP3 := (wc_et_stalk_germ_facts B b' (hcof b') F).2.2 G' ι' A₁ g₁
    obtain ⟨A'', f, f', hff⟩ := (wc_et_stalk_germ_facts B b' (hcof b') F).2.1
      (StructuredArrow.mk (Over.homMk t' ht' : Over.mk (wcEtGeomPt B b') ⟶
        (Scheme.Etale.forget B).obj V)) A₁ s _ (hγ.symm.trans hP3)
    obtain ⟨t₂, ht₂, he⟩ := key A'' f
    have hnat := congrArg (fun φ => φ.hom g₁) (ι'.hom.naturality f'.right.op)
    have h3 := (wc_et_stalk_germ_facts B b (hcof b) F).2.2 G' ι'
      (StructuredArrow.mk (Over.homMk t₂ ht₂ : Over.mk (wcEtGeomPt B b) ⟶
