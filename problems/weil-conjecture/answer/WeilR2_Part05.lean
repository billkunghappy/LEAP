  classical

  have wc_et_stalk_germ_facts : ∀ (B : Scheme.{u}) (b : B), IsCofiltered (StructuredArrow (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B)) → ∀ (F : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}), (∀ x : (wcEtStalk B b).obj F, ∃ (A : StructuredArrow (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B)) (s : F.obj.obj (Opposite.op A.right)), (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B)).op ⋙ F.obj) (Opposite.op A)).hom s = x) ∧ (∀ (A A' : StructuredArrow (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B)) (s : F.obj.obj (Opposite.op A.right)) (s' : F.obj.obj (Opposite.op A'.right)), (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B)).op ⋙ F.obj) (Opposite.op A)).hom s = (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B)).op ⋙ F.obj) (Opposite.op A')).hom s' → ∃ (A'' : StructuredArrow (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B)) (f : A'' ⟶ A) (f' : A'' ⟶ A'), (F.obj.map f.right.op).hom s = (F.obj.map f'.right.op).hom s') ∧ (∀ (G : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}) (φ : G ⟶ F) (A : StructuredArrow (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B)) (g : G.obj.obj (Opposite.op A.right)), ((wcEtStalk B b).map φ).hom ((Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B)).op ⋙ G.obj) (Opposite.op A)).hom g) = (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B)).op ⋙ F.obj) (Opposite.op A)).hom ((φ.hom.app (Opposite.op A.right)).hom g)) := by
    intro B b hcof F
