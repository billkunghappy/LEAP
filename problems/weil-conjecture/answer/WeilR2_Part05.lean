theorem wc_etale_fibre_point_isolated : ∀ {V B : Scheme.{u}} (φ : V ⟶ B) [Etale φ] (v : V), ∃ U : V.Opens, v ∈ U ∧ ∀ w ∈ U, φ w = φ v → w = v :=
by
