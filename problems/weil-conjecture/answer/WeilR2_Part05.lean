  exact MorphismProperty.of_isPullback hpb hq

theorem wc_pd_tower_P : ∀ (P : ∀ {X Y : Scheme.{u}}, (X ⟶ Y) → Prop), (∀ {X Y : Scheme.{u}} (f : X ⟶ Y), IsFinite f → P f) → (∀ (R : Type u) [CommRing R], P (wcP1 R)) → (∀ {X Y Z : Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ Z), IsProper f → IsProper g → P f → P g → P (f ≫ g)) → (∀ {X Y : Scheme.{u}} (f : X ⟶ Y), (∀ y : Y, ∃ U : Y.Opens, y ∈ U ∧ P (f ∣_ U)) → P f) → (∀ (R : Type u) [CommRing R], ∃ (e₁ : @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) R) MvPolynomial.gradedAlgebra ≅ Spec (.of R) ⨯ wcPdP1Z.{u}) (e₂ : Spec (.of ((MvPolynomial.homogeneousSubmodule (Fin 2) R) 0)) ≅ Spec (.of R)), e₁.hom ≫ Limits.prod.fst = wcP1 R ≫ e₂.hom) → (∀ (S : Scheme.{u}), IsProper (Limits.prod.fst : S ⨯ wcPdP1Z.{u} ⟶ S)) → ∀ (N : ℕ) (S : Scheme.{u}), IsProper (Limits.prod.fst : S ⨯ wcPdT.{u} N ⟶ S) ∧ P (Limits.prod.fst : S ⨯ wcPdT.{u} N ⟶ S) :=
by
  intro P hfin hP1 hcomp hloc hiso hs2

  have hisoP : ∀ {X Y : Scheme.{u}} (e : X ⟶ Y), IsIso e → P e :=
    fun e _ => hfin e inferInstance

  have t1 : ∀ (R : Type u) [CommRing R],
      P (Limits.prod.fst : Spec (.of R) ⨯ wcPdP1Z.{u} ⟶ Spec (.of R)) := by
    intro R _
    obtain ⟨e₁, e₂, heq⟩ := hiso R
    haveI := hs2 (Spec (.of R))
    have ha : (Limits.prod.fst : Spec (.of R) ⨯ wcPdP1Z.{u} ⟶ Spec (.of R)) =
        e₁.inv ≫ (wcP1 R ≫ e₂.hom) := by
      rw [eq_comm, Iso.inv_comp_eq]; exact heq.symm
    have hb : wcP1 R = (e₁.hom ≫ Limits.prod.fst) ≫ e₂.inv := by
      rw [Iso.eq_comp_inv]; exact heq.symm
    haveI hwp : IsProper (wcP1 R) := by rw [hb]; infer_instance
    have hd : P (wcP1 R ≫ e₂.hom) :=
      hcomp _ _ hwp inferInstance (hP1 R) (hisoP _ inferInstance)
    rw [ha]
    exact hcomp _ _ inferInstance inferInstance (hisoP _ inferInstance) hd

  have t2 : ∀ (T : Scheme.{u}), (∀ (S : Scheme.{u}), IsProper (Limits.prod.fst : S ⨯ T ⟶ S)) →
      (∀ (R : Type u) [CommRing R], P (Limits.prod.fst : Spec (.of R) ⨯ T ⟶ Spec (.of R))) →
      ∀ (S : Scheme.{u}), P (Limits.prod.fst : S ⨯ T ⟶ S) := by
    intro T hprop haff S
    apply hloc
    intro y
    obtain ⟨U, hU, hyU, -⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp
      (Scheme.isBasis_affineOpens S)) (show y ∈ (⊤ : S.Opens) from trivial)
    refine ⟨U, hyU, ?_⟩
    have hU' : IsAffineOpen U := hU
    let ε := IsPullback.isoIsPullback (U : Scheme.{u}) (S ⨯ T)
      (isPullback_morphismRestrict (Limits.prod.fst : S ⨯ T ⟶ S) U)
      (IsPullback.of_prod_fst_with_id (Scheme.Opens.ι U) T)
    have hε : ε.hom ≫ (Limits.prod.fst : (U : Scheme.{u}) ⨯ T ⟶ U) =
        (Limits.prod.fst : S ⨯ T ⟶ S) ∣_ U :=
      IsPullback.isoIsPullback_hom_fst _ _ _ _
    let κ := hU'.isoSpec
    have hκ : (Limits.prod.fst : (U : Scheme.{u}) ⨯ T ⟶ U) =
        Limits.prod.map κ.hom (𝟙 T) ≫
          (Limits.prod.fst : Spec Γ(S, U) ⨯ T ⟶ Spec Γ(S, U)) ≫ κ.inv := by
      rw [← Category.assoc, Limits.prod.map_fst, Category.assoc, Iso.hom_inv_id,
        Category.comp_id]
    have hfP : P (Limits.prod.fst : Spec Γ(S, U) ⨯ T ⟶ Spec Γ(S, U)) :=
      haff (Γ(S, U) : Type u)
    haveI := hprop (Spec Γ(S, U))
    have h1 : P ((Limits.prod.fst : Spec Γ(S, U) ⨯ T ⟶ Spec Γ(S, U)) ≫ κ.inv) :=
      hcomp _ _ inferInstance inferInstance hfP (hisoP _ inferInstance)
    have h2 : P (Limits.prod.map κ.hom (𝟙 T) ≫
        (Limits.prod.fst : Spec Γ(S, U) ⨯ T ⟶ Spec Γ(S, U)) ≫ κ.inv) :=
      hcomp _ _ inferInstance inferInstance (hisoP _ inferInstance) h1
    rw [← hε, hκ]
    exact hcomp _ _ inferInstance inferInstance (hisoP _ inferInstance) h2

  have t3 : ∀ (T T' : Scheme.{u}),
      (∀ S : Scheme.{u}, IsProper (Limits.prod.fst : S ⨯ T ⟶ S) ∧
        P (Limits.prod.fst : S ⨯ T ⟶ S)) →
      (∀ S : Scheme.{u}, IsProper (Limits.prod.fst : S ⨯ T' ⟶ S) ∧
        P (Limits.prod.fst : S ⨯ T' ⟶ S)) →
      ∀ S : Scheme.{u}, IsProper (Limits.prod.fst : S ⨯ (T ⨯ T') ⟶ S) ∧
        P (Limits.prod.fst : S ⨯ (T ⨯ T') ⟶ S) := by
    intro T T' hT hT' S
    obtain ⟨hp1, hP1'⟩ := hT S
    obtain ⟨hp2, hP2'⟩ := hT' (S ⨯ T)
    have hid : (Limits.prod.associator S T T').inv ≫
        ((Limits.prod.fst : (S ⨯ T) ⨯ T' ⟶ S ⨯ T) ≫ (Limits.prod.fst : S ⨯ T ⟶ S)) =
        (Limits.prod.fst : S ⨯ (T ⨯ T') ⟶ S) := by
      rw [Limits.prod.associator_inv, Limits.prod.lift_fst_assoc, Limits.prod.lift_fst]
    haveI := hp1
    haveI := hp2
    have hc : P ((Limits.prod.fst : (S ⨯ T) ⨯ T' ⟶ S ⨯ T) ≫ (Limits.prod.fst : S ⨯ T ⟶ S)) :=
      hcomp _ _ hp2 hp1 hP2' hP1'
    rw [← hid]
    exact ⟨inferInstance, hcomp _ _ inferInstance inferInstance (hisoP _ inferInstance) hc⟩

  have hP1Z : ∀ S : Scheme.{u}, P (Limits.prod.fst : S ⨯ wcPdP1Z.{u} ⟶ S) :=
    t2 wcPdP1Z.{u} hs2 t1
  intro N
  induction N with
  | zero =>
    intro S
    have h : (Limits.prod.fst : S ⨯ wcPdT.{u} 0 ⟶ S) = (Limits.prod.rightUnitor S).hom :=
      (Limits.prod.rightUnitor_hom S).symm
    haveI hI : IsIso (Limits.prod.fst : S ⨯ wcPdT.{u} 0 ⟶ S) := by
      rw [h]; exact Iso.isIso_hom _
    exact ⟨inferInstance, hisoP _ hI⟩
  | succ N ih =>
    intro S
    exact t3 (wcPdT.{u} N) wcPdP1Z.{u} ih (fun S' => ⟨hs2 S', hP1Z S'⟩) S

theorem wc_pd_coprod_P : ∀ (P : ∀ {X Y : Scheme.{u}}, (X ⟶ Y) → Prop), (∀ {X Y : Scheme.{u}} (f : X ⟶ Y), IsFinite f → P f) → (∀ {X Y Z : Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ Z), IsProper f → IsProper g → P f → P g → P (f ≫ g)) → (∀ {X Y : Scheme.{u}} (f : X ⟶ Y), (∀ y : Y, ∃ U : Y.Opens, y ∈ U ∧ P (f ∣_ U)) → P f) → ∀ {A B Y : Scheme.{u}} (a : A ⟶ Y) (b : B ⟶ Y), IsProper a → IsProper b → P a → P b → IsProper (Limits.coprod.desc a b) ∧ P (Limits.coprod.desc a b) :=
by
  intro P hfin hcomp hloc A B Y a b ha hb hPa hPb

  have hiso : ∀ {S T : Scheme.{u}} (e : S ⟶ T), IsIso e → IsProper e ∧ P e := by
    intro S T e he
    exact ⟨inferInstance, hfin e inferInstance⟩

  have hres : ∀ {V U X' Y' : Scheme.{u}} (i : V ⟶ X') (g : V ⟶ U) (m : X' ⟶ Y') (j : U ⟶ Y')
      [IsOpenImmersion j], IsPullback i g m j → IsProper g → P g →
      IsProper (m ∣_ j.opensRange) ∧ P (m ∣_ j.opensRange) := by
    intro V U X' Y' i g m j _ h hg hPg
    let E := morphismRestrictOpensRange m j
    have hw : m ∣_ j.opensRange = E.symm.inv.left ≫ Limits.pullback.snd m j ≫ E.symm.hom.right :=
      Arrow.iso_w' E.symm
    have hsnd : Limits.pullback.snd m j = h.isoPullback.inv ≫ g := by
      have e := h.isoPullback_hom_snd
      calc Limits.pullback.snd m j
          = h.isoPullback.inv ≫ h.isoPullback.hom ≫ Limits.pullback.snd m j :=
            (Iso.inv_hom_id_assoc _ _).symm
        _ = h.isoPullback.inv ≫ g := by rw [e]
    have hw' : m ∣_ j.opensRange =
        E.symm.inv.left ≫ h.isoPullback.inv ≫ g ≫ E.symm.hom.right := by
      refine hw.trans ?_
      rw [← Category.assoc h.isoPullback.inv g E.symm.hom.right, ← hsnd]
    obtain ⟨p2, P2⟩ := hiso E.symm.hom.right inferInstance
    obtain ⟨p1, P1⟩ := hiso E.symm.inv.left inferInstance
    obtain ⟨p0, P0⟩ := hiso h.isoPullback.inv inferInstance
    have q1 : IsProper (g ≫ E.symm.hom.right) := by
      haveI := hg; haveI := p2; infer_instance
    have Q1 : P (g ≫ E.symm.hom.right) := hcomp _ _ hg p2 hPg P2
    have q2 : IsProper (h.isoPullback.inv ≫ g ≫ E.symm.hom.right) := by
      haveI := q1; haveI := p0; infer_instance
    have Q2 : P (h.isoPullback.inv ≫ g ≫ E.symm.hom.right) := hcomp _ _ p0 q1 P0 Q1
    have q3 : IsProper (E.symm.inv.left ≫ h.isoPullback.inv ≫ g ≫ E.symm.hom.right) := by
      haveI := q2; haveI := p1; infer_instance
    have Q3 : P (E.symm.inv.left ≫ h.isoPullback.inv ≫ g ≫ E.symm.hom.right) :=
      hcomp _ _ p1 q2 P1 Q2
    rw [hw']
    exact ⟨q3, Q3⟩

  have hfac : Limits.coprod.desc a b =
      Limits.coprod.map a b ≫ Limits.coprod.desc (𝟙 Y) (𝟙 Y) := by
    rw [Limits.coprod.map_desc, Category.comp_id, Category.comp_id]
  have hL := hres Limits.coprod.inl a (Limits.coprod.map a b) Limits.coprod.inl
    (isPullback_inl_inl_coprodMap a b).flip ha hPa
  have hR := hres Limits.coprod.inr b (Limits.coprod.map a b) Limits.coprod.inr
    (isPullback_inr_inr_coprodMap a b).flip hb hPb
  have hcov : ∀ y, y ∈ (Limits.coprod.inl : Y ⟶ Y ⨿ Y).opensRange ∨
      y ∈ (Limits.coprod.inr : Y ⟶ Y ⨿ Y).opensRange := by
    intro y
    have h := (isCompl_opensRange_inl_inr Y Y).sup_eq_top
    have hy : y ∈ ((Limits.coprod.inl : Y ⟶ Y ⨿ Y).opensRange ⊔
        (Limits.coprod.inr : Y ⟶ Y ⨿ Y).opensRange) := by
      rw [h]; trivial
    exact TopologicalSpace.Opens.mem_sup.mp hy
  have hmapP : IsProper (Limits.coprod.map a b) := by
    apply IsZariskiLocalAtTarget.of_forall_exists_morphismRestrict (P := @IsProper)
    intro y
    rcases hcov y with h | h
    · exact ⟨_, h, hL.1⟩
    · exact ⟨_, h, hR.1⟩
  have hmapQ : P (Limits.coprod.map a b) := by
    apply hloc
    intro y
    rcases hcov y with h | h
    · exact ⟨_, h, hL.2⟩
    · exact ⟨_, h, hR.2⟩
  have hfoldP : IsProper (Limits.coprod.desc (𝟙 Y) (𝟙 Y)) := inferInstance
  have hfoldQ : P (Limits.coprod.desc (𝟙 Y) (𝟙 Y)) :=
    hfin (Limits.coprod.desc (𝟙 Y) (𝟙 Y)) inferInstance
  rw [hfac]
  exact ⟨by haveI := hmapP; infer_instance, hcomp _ _ hmapP hfoldP hmapQ hfoldQ⟩

theorem wc_pd_affine_embed_tower : ∀ (Y : Scheme.{u}) [IsAffine Y] (U : Scheme.{u}) [IsAffine U] (g : U ⟶ Y) [LocallyOfFiniteType g], ∃ (N : ℕ) (e : U ⟶ Y ⨯ wcPdT.{u} N), IsImmersion e ∧ e ≫ Limits.prod.fst = g :=
by

  have capp : ∀ {A B C : Scheme.{u}} (f : A ⟶ B) (g : B ⟶ C) (x : Γ(C, ⊤)),
      (f ≫ g).appTop.hom x = f.appTop.hom (g.appTop.hom x) := by
    intro A B C f g x
    rw [Scheme.Hom.comp_appTop]
    rfl

  have hfg : ∀ (Y : Scheme.{u}) [IsAffine Y] (U : Scheme.{u}) [IsAffine U] (g : U ⟶ Y)
      [LocallyOfFiniteType g], ∃ (N : ℕ) (φ : MvPolynomial (Fin N) Γ(Y, ⊤) →+* Γ(U, ⊤)),
      Function.Surjective φ ∧ ∀ r, φ (MvPolynomial.C r) = g.appTop.hom r := by
    intro Y _ U _ g _
    have hft : RingHom.FiniteType g.appTop.hom :=
      (HasRingHomProperty.iff_of_isAffine (P := @LocallyOfFiniteType)).mp inferInstance
    letI := g.appTop.hom.toAlgebra
    have hft' : Algebra.FiniteType Γ(Y, ⊤) Γ(U, ⊤) := hft
    obtain ⟨n, f, hf⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp hft'
    refine ⟨n, f.toRingHom, hf, fun r => ?_⟩
    change f (MvPolynomial.C r) = _
    rw [← MvPolynomial.algebraMap_eq, AlgHom.commutes, RingHom.algebraMap_toAlgebra]

  have hchart : ∃ (D : Scheme.{u}) (ι : D ⟶ wcPdP1Z.{u}) (σ : Γ(D, ⊤)), IsAffine D ∧
      IsOpenImmersion ι ∧ ∀ (S : Scheme.{u}) (b : Γ(S, ⊤)), ∃ d : S ⟶ D, d.appTop.hom σ = b := by
    letI : GradedRing (MvPolynomial.homogeneousSubmodule (Fin 2) (ULift.{u} ℤ)) :=
      MvPolynomial.gradedAlgebra
    have hX0 : (MvPolynomial.X 0 : MvPolynomial (Fin 2) (ULift.{u} ℤ)) ∈
        MvPolynomial.homogeneousSubmodule (Fin 2) (ULift.{u} ℤ) 1 :=
      (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X _ 0)
    have hX1 : (MvPolynomial.X 1 : MvPolynomial (Fin 2) (ULift.{u} ℤ)) ∈
        MvPolynomial.homogeneousSubmodule (Fin 2) (ULift.{u} ℤ) (1 • 1) :=
      (MvPolynomial.mem_homogeneousSubmodule _ _).mpr
        (by simpa using MvPolynomial.isHomogeneous_X (ULift.{u} ℤ) (1 : Fin 2))
    let x₁ := HomogeneousLocalization.Away.mk
      (MvPolynomial.homogeneousSubmodule (Fin 2) (ULift.{u} ℤ)) hX0 1 (MvPolynomial.X 1) hX1
    refine ⟨Spec (CommRingCat.of (HomogeneousLocalization.Away
        (MvPolynomial.homogeneousSubmodule (Fin 2) (ULift.{u} ℤ)) (MvPolynomial.X 0))),
      Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin 2) (ULift.{u} ℤ)) (MvPolynomial.X 0) hX0
        one_pos,
      (Scheme.ΓSpecIso _).inv x₁, inferInstance,
      Proj.instIsOpenImmersionAwayι _ _ hX0 one_pos, ?_⟩
    intro S b
    let ev : MvPolynomial (Fin 2) (ULift.{u} ℤ) →+* Γ(S, ⊤) :=
      MvPolynomial.eval₂Hom ((Int.castRingHom Γ(S, ⊤)).comp ULift.ringEquiv.toRingHom) ![1, b]
    have hev0 : ev (MvPolynomial.X 0) = 1 := by
      rw [MvPolynomial.eval₂Hom_X']; rfl
    have hev1 : ev (MvPolynomial.X 1) = b := by
      rw [MvPolynomial.eval₂Hom_X']; rfl
    have hv : ev (MvPolynomial.X 0) * 1 = 1 := by rw [hev0, one_mul]
    have hu : IsUnit (ev (MvPolynomial.X 0)) := by rw [hev0]; exact isUnit_one
    let ψ : HomogeneousLocalization.Away
        (MvPolynomial.homogeneousSubmodule (Fin 2) (ULift.{u} ℤ)) (MvPolynomial.X 0) →+* Γ(S, ⊤) :=
      (Localization.awayLift ev (MvPolynomial.X 0) hu).comp
        (algebraMap _ (Localization.Away (MvPolynomial.X 0 : MvPolynomial (Fin 2) (ULift.{u} ℤ))))
    refine ⟨S.toSpecΓ ≫ Spec.map (CommRingCat.ofHom ψ), ?_⟩
    have key : (S.toSpecΓ ≫ Spec.map (CommRingCat.ofHom ψ)).appTop =
        (Scheme.ΓSpecIso _).hom ≫ CommRingCat.ofHom ψ := by
      rw [Scheme.Hom.comp_appTop, Scheme.toSpecΓ_appTop, Scheme.ΓSpecIso_naturality]
    have hψ : ψ x₁ = b := by
      change Localization.awayLift ev (MvPolynomial.X 0) hu
        (algebraMap _ (Localization.Away (MvPolynomial.X 0 : MvPolynomial (Fin 2) (ULift.{u} ℤ)))
          x₁) = b
      rw [HomogeneousLocalization.algebraMap_apply, HomogeneousLocalization.Away.val_mk]
      rw [Localization.awayLift_mk ev (MvPolynomial.X 0) (MvPolynomial.X 1) 1 hv 1, hev1, one_pow,
        mul_one]
    rw [key, CommRingCat.hom_comp, RingHom.comp_apply, Iso.inv_hom_id_apply]
    exact hψ

  have hpa : ∀ (X Z : Scheme.{u}), IsAffine X → IsAffine Z → IsAffine (X ⨯ Z) := by
    intro X Z hX hZ
    have h := IsPullback.of_is_product (Limits.prodIsProd X Z) Limits.terminalIsTerminal
    haveI : IsAffine ((Limits.pair X Z).obj ⟨Limits.WalkingPair.left⟩) := hX
    haveI : IsAffine ((Limits.pair X Z).obj ⟨Limits.WalkingPair.right⟩) := hZ
    exact IsAffine.of_isIso h.isoPullback.hom

  have hpm : ∀ {X X' Z Z' : Scheme.{u}} (f : X ⟶ X') (h : Z ⟶ Z'), IsOpenImmersion f →
      IsOpenImmersion h → IsOpenImmersion (Limits.prod.map f h) := by
    intro X X' Z Z' f h hf hh
    have base : ∀ {A A' : Scheme.{u}} (k : A ⟶ A') (B : Scheme.{u}), IsOpenImmersion k →
        IsOpenImmersion (Limits.prod.map k (𝟙 B)) := by
      intro A A' k B hk
      exact MorphismProperty.of_isPullback (P := @IsOpenImmersion)
        (IsPullback.of_prod_fst_with_id k B) hk
    have e1 : Limits.prod.map f h = Limits.prod.map f (𝟙 Z) ≫ Limits.prod.map (𝟙 X') h := by
      rw [Limits.prod.map_map, Category.comp_id, Category.id_comp]
    have e2 : Limits.prod.map (𝟙 X') h = (Limits.prod.braiding X' Z).hom ≫
        Limits.prod.map h (𝟙 X') ≫ (Limits.prod.braiding Z' X').hom := by
      apply Limits.prod.hom_ext
      · rw [Limits.prod.map_fst, Category.comp_id, Limits.prod.braiding_hom, Category.assoc,
          Category.assoc, Limits.prod.braiding_hom, Limits.prod.lift_fst, Limits.prod.map_snd,
          Category.comp_id, Limits.prod.lift_snd]
      · rw [Limits.prod.map_snd, Limits.prod.braiding_hom, Category.assoc,
          Category.assoc, Limits.prod.braiding_hom, Limits.prod.lift_snd, Limits.prod.map_fst,
          ← Category.assoc, Limits.prod.lift_fst]
    haveI := base f Z hf
    haveI := base h X' hh
    have h3 : IsOpenImmersion ((Limits.prod.braiding X' Z).hom ≫
        Limits.prod.map h (𝟙 X') ≫ (Limits.prod.braiding Z' X').hom) :=
      IsOpenImmersion.comp _ _
    rw [e1, e2]
    exact IsOpenImmersion.comp _ _

  have htower : ∀ (N : ℕ), ∃ (W : Scheme.{u}) (ι' : W ⟶ wcPdT.{u} N) (τ : Fin N → Γ(W, ⊤)),
      IsAffine W ∧ IsOpenImmersion ι' ∧ ∀ (S : Scheme.{u}) (b : Fin N → Γ(S, ⊤)), ∃ a : S ⟶ W,
        ∀ k, a.appTop.hom (τ k) = b k := by
    obtain ⟨D, ι, σ, hD, hι, hu⟩ := hchart
    intro N
    induction N with
    | zero =>
      have h0 : IsAffine (wcPdT.{u} 0) := by
        show IsAffine (⊤_ Scheme.{u})
        infer_instance
      refine ⟨wcPdT.{u} 0, 𝟙 _, fun k => k.elim0, h0, inferInstance, ?_⟩
      intro S b
      exact ⟨Limits.terminal.from S, fun k => k.elim0⟩
    | succ n ih =>
      obtain ⟨W, ι', τ, hW, hι', hU⟩ := ih
      refine ⟨W ⨯ D, Limits.prod.map ι' ι,
        Fin.lastCases ((Limits.prod.snd : W ⨯ D ⟶ D).appTop.hom σ)
          (fun j => (Limits.prod.fst : W ⨯ D ⟶ W).appTop.hom (τ j)),
        hpa W D hW hD, hpm ι' ι hι' hι, ?_⟩
      intro S b
      obtain ⟨a, ha⟩ := hU S (fun j => b j.castSucc)
      obtain ⟨d, hd⟩ := hu S (b (Fin.last n))
      refine ⟨Limits.prod.lift a d, fun k => ?_⟩
      induction k using Fin.lastCases with
      | last =>
        simp only [Fin.lastCases_last]
        rw [← capp, Limits.prod.lift_snd, hd]
      | cast j =>
        simp only [Fin.lastCases_castSucc]
        rw [← capp, Limits.prod.lift_fst, ha]

  have hlift : ∀ (Y U W : Scheme.{u}) [IsAffine Y] [IsAffine U] [IsAffine (Y ⨯ W)] (g : U ⟶ Y)
      (a : U ⟶ W) (N : ℕ) (τ : Fin N → Γ(W, ⊤)) (φ : MvPolynomial (Fin N) Γ(Y, ⊤) →+* Γ(U, ⊤)),
      Function.Surjective φ → (∀ r, φ (MvPolynomial.C r) = g.appTop.hom r) →
      (∀ k, φ (MvPolynomial.X k) = a.appTop.hom (τ k)) →
      IsClosedImmersion (Limits.prod.lift g a) := by
    intro Y U W _ _ _ g a N τ φ hs hC hX
    apply IsClosedImmersion.of_surjective_of_isAffine
    have hmem : ∀ p, φ p ∈ (Limits.prod.lift g a).appTop.hom.range := by
      intro p
      induction p using MvPolynomial.induction_on with
      | C r =>
        refine ⟨(Limits.prod.fst : Y ⨯ W ⟶ Y).appTop.hom r, ?_⟩
        rw [← capp, Limits.prod.lift_fst, hC]
      | add p q hp hq => rw [map_add]; exact add_mem hp hq
      | mul_X p n hp =>
        rw [map_mul]
        refine mul_mem hp ⟨(Limits.prod.snd : Y ⨯ W ⟶ W).appTop.hom (τ n), ?_⟩
        rw [← capp, Limits.prod.lift_snd, hX]
    intro y
    obtain ⟨p, rfl⟩ := hs y
    exact hmem p

  intro Y _ U _ g _
  obtain ⟨N, φ, hφs, hφC⟩ := hfg Y U g
  obtain ⟨W, ι', τ, hW, hι', hUW⟩ := htower N
  obtain ⟨a, ha⟩ := hUW U (fun k => φ (MvPolynomial.X k))
  haveI : IsAffine W := hW
  haveI : IsAffine (Y ⨯ W) := hpa Y W inferInstance hW
  haveI hc : IsClosedImmersion (Limits.prod.lift g a) :=
    hlift Y U W g a N τ φ hφs hφC (fun k => (ha k).symm)
  haveI ho : IsOpenImmersion (Limits.prod.map (𝟙 Y) ι') := hpm (𝟙 Y) ι' inferInstance hι'
  refine ⟨N, Limits.prod.lift g a ≫ Limits.prod.map (𝟙 Y) ι', inferInstance, ?_⟩
  rw [Category.assoc, Limits.prod.map_fst, Category.comp_id, Limits.prod.lift_fst]

theorem wc_pd_tower_prod : ∀ (m : ℕ) (n : Fin m → ℕ), ∃ (M : ℕ) (ρ : ∀ i, wcPdT.{u} M ⟶ wcPdT.{u} (n i)), ∀ (S : Scheme.{u}) (b : ∀ i, S ⟶ wcPdT.{u} (n i)), ∃ l : S ⟶ wcPdT.{u} M, ∀ i, l ≫ ρ i = b i :=
by
  have pair : ∀ (a b : ℕ), ∃ (C : ℕ) (p : wcPdT.{u} C ⟶ wcPdT.{u} a)
      (q : wcPdT.{u} C ⟶ wcPdT.{u} b), ∀ (S : Scheme.{u}) (x : S ⟶ wcPdT.{u} a)
      (y : S ⟶ wcPdT.{u} b), ∃ l : S ⟶ wcPdT.{u} C, l ≫ p = x ∧ l ≫ q = y := by
    intro a b
    induction b with
    | zero =>
      refine ⟨a, 𝟙 _, (Limits.terminal.from (wcPdT.{u} a) : wcPdT.{u} a ⟶ ⊤_ Scheme.{u}),
        fun S x y => ⟨x, Category.comp_id x, ?_⟩⟩
      exact Limits.terminal.hom_ext (C := Scheme.{u}) _ _
    | succ k ih =>
      obtain ⟨C, p, q, H⟩ := ih
      refine ⟨C + 1, (Limits.prod.fst : wcPdT.{u} C ⨯ wcPdP1Z.{u} ⟶ wcPdT.{u} C) ≫ p,
        (Limits.prod.map q (𝟙 wcPdP1Z.{u}) :
          wcPdT.{u} C ⨯ wcPdP1Z.{u} ⟶ wcPdT.{u} k ⨯ wcPdP1Z.{u}), ?_⟩
      intro S x y
      let y' : S ⟶ wcPdT.{u} k ⨯ wcPdP1Z.{u} := y
      obtain ⟨l₀, h1, h2⟩ := H S x (y' ≫ Limits.prod.fst)
      refine ⟨(Limits.prod.lift l₀ (y' ≫ Limits.prod.snd) :
        S ⟶ wcPdT.{u} C ⨯ wcPdP1Z.{u}), ?_, ?_⟩
      · have e : Limits.prod.lift l₀ (y' ≫ Limits.prod.snd) ≫
            (Limits.prod.fst : wcPdT.{u} C ⨯ wcPdP1Z.{u} ⟶ wcPdT.{u} C) = l₀ :=
          Limits.prod.lift_fst _ _
        change (Limits.prod.lift l₀ (y' ≫ Limits.prod.snd) : S ⟶ wcPdT.{u} C ⨯ wcPdP1Z.{u}) ≫
          ((Limits.prod.fst : wcPdT.{u} C ⨯ wcPdP1Z.{u} ⟶ wcPdT.{u} C) ≫ p) = x
        exact (Category.assoc _ _ _).symm.trans ((congrArg (· ≫ p) e).trans h1)
      · change Limits.prod.lift l₀ (y' ≫ Limits.prod.snd) ≫
          Limits.prod.map q (𝟙 wcPdP1Z.{u}) = y'
        rw [Limits.prod.lift_map, h2, Category.comp_id]
        apply Limits.prod.hom_ext
        · rw [Limits.prod.lift_fst]
        · rw [Limits.prod.lift_snd]
  intro m
  induction m with
  | zero =>
    intro n
    exact ⟨0, fun i => i.elim0, fun S b =>
      ⟨(Limits.terminal.from S : S ⟶ ⊤_ Scheme.{u}), fun i => i.elim0⟩⟩
  | succ m ih =>
    intro n
    obtain ⟨M₁, ρ₁, H₁⟩ := ih (fun j => n j.succ)
    obtain ⟨C, p, q, Hpq⟩ := pair (n 0) M₁
    refine ⟨C, Fin.cases (motive := fun i => wcPdT.{u} C ⟶ wcPdT.{u} (n i)) p
      (fun j => q ≫ ρ₁ j), ?_⟩
    intro S b
    obtain ⟨l₁, hl₁⟩ := H₁ S (fun j => b j.succ)
    obtain ⟨l, hp, hq⟩ := Hpq S (b 0) l₁
    refine ⟨l, fun i => ?_⟩
    cases i using Fin.cases with
    | zero =>
      rw [Fin.cases_zero]
      exact hp
    | succ j =>
      rw [Fin.cases_succ, ← Category.assoc, hq]
      exact hl₁ j

theorem wc_pd_chow_dense : ∀ (Y : Scheme.{u}) [IsAffine Y] (X : Scheme.{u}) [IsReduced X] (f : X ⟶ Y) [IsProper f] (m : ℕ) (U : Fin m → X.Opens), (∀ (N : ℕ) (S : Scheme.{u}), IsProper (Limits.prod.fst : S ⨯ wcPdT.{u} N ⟶ S)) → (∀ (Y₀ : Scheme.{u}) [IsAffine Y₀] (U₀ : Scheme.{u}) [IsAffine U₀] (g : U₀ ⟶ Y₀) [LocallyOfFiniteType g], ∃ (N : ℕ) (e : U₀ ⟶ Y₀ ⨯ wcPdT.{u} N), IsImmersion e ∧ e ≫ Limits.prod.fst = g) → (∀ (k : ℕ) (n : Fin k → ℕ), ∃ (M : ℕ) (ρ : ∀ i, wcPdT.{u} M ⟶ wcPdT.{u} (n i)), ∀ (S : Scheme.{u}) (b : ∀ i, S ⟶ wcPdT.{u} (n i)), ∃ l : S ⟶ wcPdT.{u} M, ∀ i, l ≫ ρ i = b i) → (∀ i, IsAffineOpen (U i)) → iSup U = ⊤ → Dense (⋂ i, (U i : Set X)) → ∃ (X' : Scheme.{u}) (π : X' ⟶ X) (N : ℕ) (ψ : X' ⟶ Y ⨯ wcPdT.{u} N), IsProper π ∧ Surjective π ∧ IsImmersion ψ ∧ ψ ≫ Limits.prod.fst = π ≫ f :=
by
  intro Y _ X _ f _ m U hT hE hP hU hsup hdense

  set W : X.Opens := ⨅ i, U i with hWdef
  have hWcoe : (W : Set X) = ⋂ i, (U i : Set X) := TopologicalSpace.Opens.coe_iInf U
  have hW : Dense (W : Set X) := by rw [hWcoe]; exact hdense
  have hWle : ∀ i, W ≤ U i := fun i => iInf_le U i
  have hchart : ∀ i, ∃ (N : ℕ) (e : (U i : Scheme.{u}) ⟶ Y ⨯ wcPdT.{u} N),
      IsImmersion e ∧ e ≫ Limits.prod.fst = (U i).ι ≫ f := by
    intro i
    haveI : IsAffine (U i : Scheme.{u}) := hU i
    exact hE Y (U i) ((U i).ι ≫ f)
  choose n e he heq using hchart

  obtain ⟨M, ρ, hlift⟩ := hP m n
  haveI hqQ : IsProper (Limits.prod.fst : Y ⨯ wcPdT.{u} M ⟶ Y) := hT M Y
  obtain ⟨pr, hprdef⟩ : ∃ pr : ∀ i, Y ⨯ wcPdT.{u} M ⟶ Y ⨯ wcPdT.{u} (n i),
      pr = fun i => Limits.prod.map (𝟙 Y) (ρ i) := ⟨_, rfl⟩
  have hpr : ∀ i, pr i ≫ Limits.prod.fst = (Limits.prod.fst : Y ⨯ wcPdT.{u} M ⟶ Y) := by
    intro i
    rw [hprdef, Limits.prod.map_fst, Category.comp_id]
  have hprsnd : ∀ i, pr i ≫ Limits.prod.snd = Limits.prod.snd ≫ ρ i := by
    intro i
    rw [hprdef, Limits.prod.map_snd]
  have hprP : ∀ i, IsProper (pr i) := by
    intro i
    haveI := hT (n i) Y
    haveI : IsProper (pr i ≫ Limits.prod.fst) := by rw [hpr i]; exact hqQ
    exact IsProper.of_comp (pr i) Limits.prod.fst
  obtain ⟨l, hl⟩ := hlift (W : Scheme.{u})
    (fun i => X.homOfLE (hWle i) ≫ e i ≫ Limits.prod.snd)
  have hl' : ∀ i, l ≫ ρ i = X.homOfLE (hWle i) ≫ e i ≫ Limits.prod.snd := hl
  obtain ⟨g, hgdef⟩ : ∃ g : (W : Scheme.{u}) ⟶ Y ⨯ wcPdT.{u} M,
      g = Limits.prod.lift (W.ι ≫ f) l := ⟨_, rfl⟩
  have hg : ∀ i, g ≫ pr i = X.homOfLE (hWle i) ≫ e i := by
    intro i
    apply Limits.prod.hom_ext
    · rw [Category.assoc, hpr i, hgdef, Limits.prod.lift_fst, Category.assoc, heq i,
        Scheme.homOfLE_ι_assoc]
    · rw [Category.assoc, hprsnd i, hgdef, Limits.prod.lift_snd_assoc, hl' i, Category.assoc]

  have hTc : IsClosed (closure (Set.range g)) := isClosed_closure
  let I := Scheme.IdealSheafData.vanishingIdeal
    (⟨closure (Set.range g), hTc⟩ : TopologicalSpace.Closeds (Y ⨯ wcPdT.{u} M : Scheme.{u}))
  obtain ⟨R, r, hr, hrsurj, hred⟩ := wc_reduced_subscheme_exists I.subscheme
  haveI := hr
  haveI := hred
  obtain ⟨zQ, hzQ, hzQr⟩ : ∃ zQ : R ⟶ Y ⨯ wcPdT.{u} M, zQ = r ≫ I.subschemeι ∧ True :=
    ⟨_, rfl, trivial⟩
  haveI : IsClosedImmersion zQ := by rw [hzQ]; infer_instance
  have hzQrange : Set.range zQ = closure (Set.range g) := by
    have h1 : Set.range I.subschemeι = closure (Set.range g) := by
      rw [Scheme.IdealSheafData.range_subschemeι, Scheme.IdealSheafData.coe_support_vanishingIdeal]
      rfl
    rw [← h1, hzQ]
    ext x
    constructor
    · rintro ⟨w, rfl⟩
      exact ⟨r w, by simp [Scheme.Hom.comp_apply]⟩
    · rintro ⟨v, rfl⟩
      have hv : v ∈ Set.range r := hrsurj ▸ Set.mem_univ v
      obtain ⟨w, rfl⟩ := hv
      exact ⟨w, by simp [Scheme.Hom.comp_apply]⟩
  obtain ⟨g', hg'⟩ := wc_ap_reduced_factor_closed_immersion (W : Scheme.{u}) R
    (Y ⨯ wcPdT.{u} M) g zQ (by rw [hzQrange]; exact subset_closure)
  have hg'dense : DenseRange g' := by
    apply dense_iff_closure_eq.mpr
    rw [zQ.isClosedEmbedding.isInducing.closure_eq_preimage_closure_image, ← Set.range_comp]
    have hc : ⇑zQ ∘ ⇑g' = ⇑g := by
      funext x
      rw [Function.comp_apply, ← Scheme.Hom.comp_apply, hg']
    rw [hc, ← hzQrange, Set.preimage_range]

  have hrestr : ∀ i, ∃ (V : R.Opens) (πV : (V : Scheme.{u}) ⟶ (U i : Scheme.{u})),
      Set.range g' ⊆ (V : Set R) ∧ IsProper πV ∧ πV ≫ e i = V.ι ≫ (zQ ≫ pr i) := by
    intro i
    haveI := he i
    haveI := hprP i
    refine wc_ap_proper_preimage_immersion_restrict (U i) (Y ⨯ wcPdT.{u} (n i)) R (e i)
      (zQ ≫ pr i) (Set.range g') hg'dense ?_
    rintro _ ⟨_, ⟨x, rfl⟩, rfl⟩
    refine ⟨X.homOfLE (hWle i) x, ?_⟩
    have hx : (g' ≫ zQ ≫ pr i) x = (X.homOfLE (hWle i) ≫ e i) x := by
      rw [← Category.assoc, hg', hg i]
    simpa only [Scheme.Hom.comp_apply] using hx.symm
  choose V πV hVg hπV hπVeq using hrestr

  have hf : ∀ i, (πV i ≫ (U i).ι) ≫ f = (V i).ι ≫ (zQ ≫ Limits.prod.fst) := by
    intro i
    calc (πV i ≫ (U i).ι) ≫ f = (πV i ≫ e i) ≫ Limits.prod.fst := by
          simp only [Category.assoc, heq i]
      _ = ((V i).ι ≫ (zQ ≫ pr i)) ≫ Limits.prod.fst := by rw [hπVeq i]
      _ = (V i).ι ≫ (zQ ≫ Limits.prod.fst) := by simp only [Category.assoc, hpr i]
  have hgiex : ∀ i, ∃ gi : (W : Scheme.{u}) ⟶ (V i : Scheme.{u}), gi ≫ (V i).ι = g' := by
    intro i
    exact ⟨IsOpenImmersion.lift (V i).ι g' (by rw [Scheme.Opens.range_ι]; exact hVg i),
      IsOpenImmersion.lift_fac _ _ _⟩
  choose gi hgi1 using hgiex
  have hgi2 : ∀ i, gi i ≫ πV i = X.homOfLE (hWle i) := by
    intro i
    haveI := he i
    rw [← cancel_mono (e i)]
    calc (gi i ≫ πV i) ≫ e i = gi i ≫ (V i).ι ≫ zQ ≫ pr i := by
          rw [Category.assoc, hπVeq i]
      _ = ((gi i ≫ (V i).ι) ≫ zQ) ≫ pr i := by simp only [Category.assoc]
      _ = X.homOfLE (hWle i) ≫ e i := by rw [hgi1 i, hg', hg i]
  have hgi : ∀ i, ∃ gi' : (W : Scheme.{u}) ⟶ (V i : Scheme.{u}),
      gi' ≫ (V i).ι = g' ∧ gi' ≫ (πV i ≫ (U i).ι) = W.ι := by
    intro i
    refine ⟨gi i, hgi1 i, ?_⟩
    rw [← Category.assoc, hgi2 i, Scheme.homOfLE_ι]
  obtain ⟨π, hπ1, hπ2⟩ := wc_ap_glue_dense_compatible Y X R (W : Scheme.{u}) f
    (zQ ≫ Limits.prod.fst) m V (fun i => πV i ≫ (U i).ι) g' W.ι hg'dense hf hgi

  haveI : IsSeparated (π ≫ f) := by rw [hπ2]; infer_instance
  haveI : IsSeparated π := IsSeparated.of_comp π f

  have hmemU : ∀ x : (W : Scheme.{u}), ∃ i, W.ι x ∈ U i := by
    intro x
    have hx : W.ι x ∈ iSup U := by rw [hsup]; trivial
    exact TopologicalSpace.Opens.mem_iSup.mp hx
  have hO : Set.range g' ⊆ Set.range (⨆ i, V i).ι := by
    rw [Scheme.Opens.range_ι]
    rintro _ ⟨x, rfl⟩
    obtain ⟨i, -⟩ := hmemU x
    exact TopologicalSpace.Opens.mem_iSup.mpr ⟨i, hVg i ⟨x, rfl⟩⟩
  obtain ⟨g'', hg''⟩ : ∃ g'' : (W : Scheme.{u}) ⟶ ((⨆ i, V i : R.Opens) : Scheme.{u}),
      g'' ≫ (⨆ i, V i).ι = g' :=
    ⟨IsOpenImmersion.lift (⨆ i, V i).ι g' hO, IsOpenImmersion.lift_fac _ _ _⟩
  have hg''i : ∀ i, g'' = gi i ≫ R.homOfLE (le_iSup V i) := by
    intro i
    rw [← cancel_mono (⨆ i, V i).ι, hg'', Category.assoc, Scheme.homOfLE_ι, hgi1 i]
  have hDdense : Dense (Set.range g'') := by
    apply dense_iff_closure_eq.mpr
    rw [(⨆ i, V i).ι.isOpenEmbedding.isInducing.closure_eq_preimage_closure_image,
      ← Set.range_comp]
    have hc : ⇑(⨆ i, V i).ι ∘ ⇑g'' = ⇑g' := by
      funext x
      rw [Function.comp_apply, ← Scheme.Hom.comp_apply, hg'']
    rw [hc, hg'dense.closure_range, Set.preimage_univ]
  have hDsub : ∀ i, Set.range g'' ⊆ Set.range (R.homOfLE (le_iSup V i)) := by
    intro i
    rintro _ ⟨x, rfl⟩
    refine ⟨gi i x, ?_⟩
    rw [hg''i i, Scheme.Hom.comp_apply]

  have hπproper : IsProper π :=
    wc_ap_proper_of_local_proper_dense ((⨆ i, V i : R.Opens) : Scheme.{u}) X π m U
      (fun i => (V i : Scheme.{u}))
      (fun i => R.homOfLE (le_iSup V i)) πV (Set.range g'') hsup hDdense
      (fun i => inferInstance) hDsub hπV (fun i => (hπ1 i).symm)

  have hπsurj : Surjective π := by
    refine ⟨fun y => ?_⟩
    have hcl : IsClosed (Set.range π) := π.isClosedMap.isClosed_range
    have hWsub : (W : Set X) ⊆ Set.range π := by
      intro y hy
      have hy' : y ∈ Set.range W.ι := by rw [Scheme.Opens.range_ι]; exact hy
      obtain ⟨x, rfl⟩ := hy'
      obtain ⟨i, -⟩ := hmemU x
      have e1 : g'' ≫ π = W.ι := by
        rw [hg''i i, Category.assoc, hπ1 i, ← Category.assoc, hgi2 i, Scheme.homOfLE_ι]
      exact ⟨g'' x, by rw [← Scheme.Hom.comp_apply, e1]⟩
    have hy : y ∈ closure (W : Set X) := by rw [hW.closure_eq]; trivial
    exact closure_minimal hWsub hcl hy
  exact ⟨_, π, M, (⨆ i, V i).ι ≫ zQ, hπproper, hπsurj, inferInstance,
    by rw [Category.assoc]; exact hπ2.symm⟩

theorem wc_pd_closed_cover_descent : ∀ (P : ∀ {X Y : Scheme.{u}}, (X ⟶ Y) → Prop), (∀ {X Y : Scheme.{u}} (f : X ⟶ Y), IsFinite f → P f) → (∀ {X Y Z : Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ Z), IsProper f → IsProper g → Surjective f → P f → P (f ≫ g) → P g) → (∀ {A B Y : Scheme.{u}} (a : A ⟶ Y) (b : B ⟶ Y), IsProper a → IsProper b → P a → P b → IsProper (Limits.coprod.desc a b) ∧ P (Limits.coprod.desc a b)) → ∀ {X Y : Scheme.{u}} (f : X ⟶ Y) (r : ℕ) (Z : Fin r → Scheme.{u}) (z : ∀ k, Z k ⟶ X), IsProper f → (∀ k, IsClosedImmersion (z k)) → (∀ x : X, ∃ k, x ∈ Set.range (z k)) → (∀ k, P (z k ≫ f)) → P f :=
by
  intro P hfin hcancel hcop X Y f r Z z hf hz hcov hP
  have aux : ∀ (n : ℕ) (W : Fin n → Scheme.{u}) (w : ∀ k, W k ⟶ X),
      (∀ k, IsClosedImmersion (w k)) → (∀ k, P (w k ≫ f)) →
      ∃ (C : Scheme.{u}) (c : C ⟶ X), IsProper c ∧ P c ∧ IsProper (c ≫ f) ∧ P (c ≫ f) ∧
        ∀ k, ∀ x : X, x ∈ Set.range (w k) → x ∈ Set.range c := by
    intro n
    induction n with
    | zero =>
      intro W w _ _
      exact ⟨⊥_ Scheme.{u}, Limits.initial.to X, inferInstance, hfin _ inferInstance,
        inferInstance, hfin _ inferInstance, fun k => k.elim0⟩
    | succ n ih =>
      intro W w hw hPw
      obtain ⟨C', c', h1, h2, h3, h4, h5⟩ := ih (fun j => W j.succ) (fun j => w j.succ)
        (fun j => hw j.succ) (fun j => hPw j.succ)
      haveI := hw 0
      haveI := hf
      obtain ⟨hA, hB⟩ := hcop (w 0) c' inferInstance h1 (hfin _ inferInstance) h2
      obtain ⟨hC, hD⟩ := hcop (w 0 ≫ f) (c' ≫ f) inferInstance h3 (hPw 0) h4
      rw [← Limits.coprod.desc_comp] at hC hD
      refine ⟨W 0 ⨿ C', Limits.coprod.desc (w 0) c', hA, hB, hC, hD, ?_⟩
      intro k x hx
      rcases Fin.eq_zero_or_eq_succ k with rfl | ⟨j, rfl⟩
      · obtain ⟨y, rfl⟩ := hx
        refine ⟨(Limits.coprod.inl : W 0 ⟶ W 0 ⨿ C') y, ?_⟩
        rw [← Scheme.Hom.comp_apply, Limits.coprod.inl_desc]
      · obtain ⟨y, hy⟩ := h5 j x hx
        refine ⟨(Limits.coprod.inr : C' ⟶ W 0 ⨿ C') y, ?_⟩
        rw [← Scheme.Hom.comp_apply, Limits.coprod.inr_desc]
        exact hy
  obtain ⟨C, c, h1, h2, _, h4, h5⟩ := aux r Z z hz hP
  have hs : Surjective c := (surjective_iff c).mpr (fun x => by
    obtain ⟨k, hk⟩ := hcov x
    exact h5 k x hk)
  exact hcancel c f h1 hf hs h2 h4

theorem wc_pd_cover_induction : ∀ (P : ∀ {X Y : Scheme.{u}}, (X ⟶ Y) → Prop), (∀ {X Y : Scheme.{u}} (f : X ⟶ Y) (r : ℕ) (Z : Fin r → Scheme.{u}) (z : ∀ k, Z k ⟶ X), IsProper f → (∀ k, IsClosedImmersion (z k)) → (∀ x : X, ∃ k, x ∈ Set.range (z k)) → (∀ k, P (z k ≫ f)) → P f) → (∀ (Y₀ : Scheme.{u}) [IsAffine Y₀] (X₀ : Scheme.{u}) [IsReduced X₀] (f₀ : X₀ ⟶ Y₀) [IsProper f₀] (k : ℕ) (V : Fin k → X₀.Opens), (∀ i, IsAffineOpen (V i)) → iSup V = ⊤ → Dense (⋂ i, (V i : Set X₀)) → P f₀) → ∀ (m : ℕ) (Y : Scheme.{u}) [IsAffine Y] (X : Scheme.{u}) (f : X ⟶ Y) [IsProper f] (U : Fin m → X.Opens), (∀ i, IsAffineOpen (U i)) → iSup U = ⊤ → P f :=
by
  have s0 : ∀ (C : Scheme.{u}), ∃ (R : Scheme.{u}) (r : R ⟶ C),
      IsClosedImmersion r ∧ Set.range r = Set.univ ∧ IsReduced R := by
    intro C
    let J : C.IdealSheafData := (⊥ : C.IdealSheafData).radical
    have h2 : Set.range J.subschemeι = Set.univ := by
      rw [Scheme.IdealSheafData.range_subschemeι, Scheme.IdealSheafData.support_radical,
        Scheme.IdealSheafData.support_bot, TopologicalSpace.Closeds.coe_top]
    have hring : ∀ U : C.affineOpens, _root_.IsReduced (Γ(C, U) ⧸ J.ideal U) := fun U =>
      (Ideal.isRadical_iff_quotient_reduced _).mp
        (by
          show ((⊥ : C.IdealSheafData).radical.ideal U).IsRadical
          rw [Scheme.IdealSheafData.radical_ideal]
          exact Ideal.radical_isRadical _)
    have hpieces : ∀ i, IsReduced (J.subschemeCover.openCover.X i) := fun (U : C.affineOpens) => by
      haveI := hring U
      exact (inferInstance : IsReduced (Spec (CommRingCat.of (Γ(C, (U : C.Opens)) ⧸ J.ideal U))))
    have h3 : IsReduced J.subscheme := IsReduced.of_openCover _ J.subschemeCover.openCover
    exact ⟨J.subscheme, J.subschemeι, inferInstance, h2, h3⟩
  have s1 : ∀ (Y : Scheme.{u}) (T : Set Y), IsClosed T → ∃ (Z : Scheme.{u}) (z : Z ⟶ Y),
      IsClosedImmersion z ∧ Set.range z = T ∧ IsReduced Z := by
    intro Y T hT
    let I := Scheme.IdealSheafData.vanishingIdeal (⟨T, hT⟩ : TopologicalSpace.Closeds Y)
    obtain ⟨R, r, hr, hrr, hred⟩ := s0 I.subscheme
    haveI := hr
    refine ⟨R, r ≫ I.subschemeι, inferInstance, ?_, hred⟩
    have hrange : Set.range I.subschemeι = T := by
      rw [Scheme.IdealSheafData.range_subschemeι, Scheme.IdealSheafData.coe_support_vanishingIdeal]
      rfl
    rw [← hrange]
    ext y
    constructor
    · rintro ⟨x, rfl⟩
      exact ⟨r x, (Scheme.Hom.comp_apply _ _ _).symm⟩
    · rintro ⟨w, rfl⟩
      have hw : w ∈ Set.range r := by rw [hrr]; trivial
      obtain ⟨x, rfl⟩ := hw
      exact ⟨x, Scheme.Hom.comp_apply _ _ _⟩
  have s2 : ∀ {X Y : Type u} [TopologicalSpace X] [TopologicalSpace Y] (f : X → Y),
      Topology.IsInducing f → ∀ (W : Set Y), Set.range f = closure W → Dense (f ⁻¹' W) := by
    intro X Y _ _ f hf W hW
    rw [hf.dense_iff]
    intro x
    rw [Set.image_preimage_eq_inter_range, hW, Set.inter_eq_left.mpr subset_closure, ← hW]
    exact ⟨x, rfl⟩
  intro P hdesc hdense m
  induction m with
  | zero =>
    intro Y _ X f _ U hU hsup
    refine hdesc f 0 (fun k => k.elim0) (fun k => k.elim0) inferInstance (fun k => k.elim0) ?_
      (fun k => k.elim0)
    intro x
    have hx : x ∈ iSup U := by rw [hsup]; trivial
    obtain ⟨i, _⟩ := TopologicalSpace.Opens.mem_iSup.mp hx
    exact i.elim0
  | succ n ih =>
    intro Y _ X f _ U hU hsup
    set W : Set X := ⋂ i, (U i : Set X) with hW
    let T : Fin (n + 2) → Set X := Fin.cases (closure W) (fun i => ((U i : Set X))ᶜ)
    have hT : ∀ k, IsClosed (T k) := by
      intro k
      refine Fin.cases ?_ (fun i => ?_) k
      · exact isClosed_closure
      · exact (U i).isOpen.isClosed_compl
    choose Z z hzi hzr hzred using fun k => s1 X (T k) (hT k)
    refine hdesc f (n + 2) Z z inferInstance hzi ?_ (fun k => ?_)
    · intro x
      by_cases hx : x ∈ W
      · exact ⟨0, by rw [hzr 0]; exact subset_closure hx⟩
      · have hex : ∃ i, x ∉ (U i : Set X) := by
          by_contra hc
          push_neg at hc
          exact hx (Set.mem_iInter.mpr hc)
        obtain ⟨i, hi⟩ := hex
        exact ⟨i.succ, by rw [hzr i.succ]; exact hi⟩
    · rcases Fin.eq_zero_or_eq_succ k with rfl | ⟨i, rfl⟩
      · haveI := hzi 0
        haveI := hzred 0
        have hU' : ∀ i, IsAffineOpen (z 0 ⁻¹ᵁ U i) := fun i => (hU i).preimage (z 0)
        have hsup' : iSup (fun i => z 0 ⁻¹ᵁ U i) = ⊤ := by
          rw [← Scheme.Hom.preimage_iSup, hsup, Scheme.Hom.preimage_top]
        have hd : Dense (⋂ i, ((z 0 ⁻¹ᵁ U i : (Z 0).Opens) : Set (Z 0))) := by
          have he : (⋂ i, ((z 0 ⁻¹ᵁ U i : (Z 0).Opens) : Set (Z 0))) = z 0 ⁻¹' W := by
            rw [hW, Set.preimage_iInter]
            rfl
          rw [he]
          exact s2 (z 0) (z 0).isClosedEmbedding.isInducing W (hzr 0)
        exact hdense Y (Z 0) (z 0 ≫ f) (n + 1) (fun i => z 0 ⁻¹ᵁ U i) hU' hsup' hd
      · haveI := hzi i.succ
        haveI := hzred i.succ
        have hU'' : ∀ l, IsAffineOpen (z i.succ ⁻¹ᵁ U (i.succAbove l)) :=
          fun l => (hU _).preimage _
        have hsup'' : iSup (fun l : Fin n => z i.succ ⁻¹ᵁ U (i.succAbove l)) = ⊤ := by
          rw [eq_top_iff]
          intro x _
          have hx : z i.succ x ∈ iSup U := by rw [hsup]; trivial
          obtain ⟨j, hj⟩ := TopologicalSpace.Opens.mem_iSup.mp hx
          have hxi : z i.succ x ∉ (U i : Set X) := by
            have hm : z i.succ x ∈ T i.succ := by rw [← hzr i.succ]; exact ⟨x, rfl⟩
            exact hm
          have hji : j ≠ i := by
            rintro rfl
            exact hxi hj
          obtain ⟨l, hl⟩ := Fin.exists_succAbove_eq hji
          rw [TopologicalSpace.Opens.mem_iSup]
          refine ⟨l, ?_⟩
          show z i.succ x ∈ U (i.succAbove l)
          rw [hl]
          exact hj
        exact ih Y (Z i.succ) (z i.succ ≫ f) (fun l => z i.succ ⁻¹ᵁ U (i.succAbove l)) hU'' hsup''

theorem wc_proper_devissage : ∀ (P : ∀ {X Y : Scheme.{u}}, (X ⟶ Y) → Prop),
    (∀ {X Y : Scheme.{u}} (f : X ⟶ Y), IsFinite f → P f) →
    (∀ (R : Type u) [CommRing R], P (wcP1 R)) →
    (∀ {X Y Z : Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ Z), IsProper f → IsProper g → P f → P g →
      P (f ≫ g)) →
    (∀ {X Y Z : Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ Z), IsProper f → IsProper g → Surjective f →
      P f → P (f ≫ g) → P g) →
    (∀ {X Y : Scheme.{u}} (f : X ⟶ Y), (∀ y : Y, ∃ U : Y.Opens, y ∈ U ∧ P (f ∣_ U)) → P f) →
    ∀ {X Y : Scheme.{u}} (f : X ⟶ Y), IsProper f → P f :=
by
  intro P hfin hP1 hcomp hcancel hloc
  have hT := wc_pd_tower_P P hfin hP1 hcomp hloc wc_pd_P1_base_iso wc_pd_P1Z_fst_proper
  have hcop : ∀ {A B Y : Scheme.{u}} (a : A ⟶ Y) (b : B ⟶ Y), IsProper a → IsProper b → P a →
      P b → IsProper (Limits.coprod.desc a b) ∧ P (Limits.coprod.desc a b) :=
    fun a b ha hb hPa hPb => wc_pd_coprod_P P hfin hcomp hloc a b ha hb hPa hPb
  have hdesc : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y) (r : ℕ) (Z : Fin r → Scheme.{u})
      (z : ∀ k, Z k ⟶ X), IsProper f → (∀ k, IsClosedImmersion (z k)) →
      (∀ x : X, ∃ k, x ∈ Set.range (z k)) → (∀ k, P (z k ≫ f)) → P f :=
    fun f r Z z hf hz hcov hP => wc_pd_closed_cover_descent P hfin hcancel hcop f r Z z hf hz hcov hP

  have hchow : ∀ {X Y X' : Scheme.{u}} (f : X ⟶ Y) (π : X' ⟶ X) (N : ℕ)
      (ψ : X' ⟶ Y ⨯ wcPdT.{u} N), IsProper f → IsProper π → Surjective π → IsImmersion ψ →
      ψ ≫ Limits.prod.fst = π ≫ f → P f := by
    intro X Y X' f π N ψ hf hπ hs hψ heq
    obtain ⟨hTY1, hTY2⟩ := hT N Y
    obtain ⟨hTX1, hTX2⟩ := hT N X
    haveI := hf
    haveI := hπ
    haveI := hψ
    haveI := hTY1
    haveI := hTX1
    have hψp : IsProper ψ := by
      haveI : IsProper (ψ ≫ Limits.prod.fst) := by rw [heq]; infer_instance
      exact IsProper.of_comp ψ Limits.prod.fst
    haveI := hψp
    haveI hψc : IsClosedImmersion ψ :=
      IsClosedImmersion.of_isPreimmersion ψ (ψ.isClosedMap.isClosed_range)
    have h1 : P (ψ ≫ Limits.prod.fst) :=
      hcomp ψ Limits.prod.fst hψp hTY1 (hfin ψ inferInstance) hTY2
    rw [heq] at h1
    let χ : X' ⟶ X ⨯ wcPdT.{u} N := Limits.prod.lift π (ψ ≫ Limits.prod.snd)
    have hχf : χ ≫ Limits.prod.fst = π := Limits.prod.lift_fst _ _
    have hχ : χ ≫ Limits.prod.map f (𝟙 _) = ψ := by
      apply Limits.prod.hom_ext
      · rw [Category.assoc, Limits.prod.map_fst, ← Category.assoc, hχf]
        exact heq.symm
      · rw [Category.assoc, Limits.prod.map_snd, Category.comp_id]
        exact Limits.prod.lift_snd _ _
    haveI : IsImmersion (χ ≫ Limits.prod.map f (𝟙 _)) := by rw [hχ]; exact hψ
    haveI : IsImmersion χ := IsImmersion.of_comp χ (Limits.prod.map f (𝟙 _))
    have hχp : IsProper χ := by
      haveI : IsProper (χ ≫ Limits.prod.fst) := by rw [hχf]; exact hπ
      exact IsProper.of_comp χ Limits.prod.fst
    haveI := hχp
    haveI hχc : IsClosedImmersion χ :=
      IsClosedImmersion.of_isPreimmersion χ (χ.isClosedMap.isClosed_range)
    have h2 : P (χ ≫ Limits.prod.fst) :=
      hcomp χ Limits.prod.fst hχp hTX1 (hfin χ inferInstance) hTX2
    rw [hχf] at h2
    exact hcancel π f hπ hf hs h2 h1

  have hdense : ∀ (Y₀ : Scheme.{u}) [IsAffine Y₀] (X₀ : Scheme.{u}) [IsReduced X₀] (f₀ : X₀ ⟶ Y₀)
      [IsProper f₀] (k : ℕ) (V : Fin k → X₀.Opens), (∀ i, IsAffineOpen (V i)) → iSup V = ⊤ →
      Dense (⋂ i, (V i : Set X₀)) → P f₀ := by
    intro Y₀ _ X₀ _ f₀ _ k V hV hsup hd
    obtain ⟨X', π, N, ψ, hπ, hs, hψ, heq⟩ := wc_pd_chow_dense Y₀ X₀ f₀ k V
      (fun N S => (hT N S).1) wc_pd_affine_embed_tower wc_pd_tower_prod hV hsup hd
    exact hchow f₀ π N ψ inferInstance hπ hs hψ heq

  intro X Y f hf
  haveI := hf
  apply hloc
  intro y
  obtain ⟨V, hV, hyV, -⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp
    (Scheme.isBasis_affineOpens Y)) (show y ∈ (⊤ : Y.Opens) from trivial)
  refine ⟨V, hyV, ?_⟩
  haveI : IsAffine (V : Scheme.{u}) := hV
  haveI : CompactSpace (f ⁻¹ᵁ V : Scheme.{u}) := QuasiCompact.compactSpace_of_compactSpace (f ∣_ V)
  let Uf : (f ⁻¹ᵁ V : Scheme.{u}).affineOpens → Set (f ⁻¹ᵁ V : Scheme.{u}) :=
    fun W => ((W.1 : (f ⁻¹ᵁ V : Scheme.{u}).Opens) : Set (f ⁻¹ᵁ V : Scheme.{u}))
  have hUf : ∀ W, IsOpen (Uf W) := fun W => W.1.isOpen
  have hcov : (Set.univ : Set (f ⁻¹ᵁ V : Scheme.{u})) ⊆ ⋃ W, Uf W := by
    intro z _
    obtain ⟨W, hW, hzW, -⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp
      (Scheme.isBasis_affineOpens (f ⁻¹ᵁ V : Scheme.{u})))
      (show z ∈ (⊤ : (f ⁻¹ᵁ V : Scheme.{u}).Opens) from trivial)
    exact Set.mem_iUnion.mpr ⟨⟨W, hW⟩, hzW⟩
  obtain ⟨t, ht⟩ := isCompact_univ.elim_finite_subcover Uf hUf hcov
  let U : Fin t.card → (f ⁻¹ᵁ V : Scheme.{u}).Opens := fun k => ((t.equivFin.symm k : t) :
    (f ⁻¹ᵁ V : Scheme.{u}).affineOpens).1
  have hU : ∀ k, IsAffineOpen (U k) := fun k => ((t.equivFin.symm k : t) :
    (f ⁻¹ᵁ V : Scheme.{u}).affineOpens).2
  have hsup : iSup U = ⊤ := by
    rw [eq_top_iff]
    intro z _
    rw [TopologicalSpace.Opens.mem_iSup]
    obtain ⟨W, hWt, hzW⟩ := Set.mem_iUnion₂.mp (ht (Set.mem_univ z))
    refine ⟨t.equivFin ⟨W, hWt⟩, ?_⟩
    simp only [U, Equiv.symm_apply_apply]
    exact hzW
  exact wc_pd_cover_induction P hdesc hdense t.card V (f ⁻¹ᵁ V) (f ∣_ V) U hU hsup

theorem wc_et_henselian_proper_vanishing : ∀ (A : Type u) [CommRing A] [HenselianLocalRing A]
    [IsSepClosed (IsLocalRing.ResidueField A)] (X : Scheme.{u}) (f : X ⟶ Spec (.of A))
    [IsProper f] (m : ℕ), m ≠ 0 → ∀ S : Set (Spec (.of A)), IsOpen S → S ≠ Set.univ →
    ∀ q : ℕ, Subsingleton (wcEtExt X (wcEtExtZero X (f ⁻¹' S) m) q) :=
by
  intro A _ _ _ X f _ m hm S hS hne q
  have hcp : IsLocalRing.closedPoint A ∉ S := by
    intro hc
    apply hne
    have h := (IsLocalRing.closedPoint_mem_iff (U := (⟨S, hS⟩ : TopologicalSpace.Opens _))).mp hc
    have h2 := congrArg (fun U : TopologicalSpace.Opens _ => (U : Set (Spec (.of A)))) h
    exact h2.trans rfl
  have hsub : f ⁻¹' S ⊆ {x | f x ≠ IsLocalRing.closedPoint A} := by
    intro x hx hfx
    exact hcp (hfx ▸ hx)
  obtain ⟨hsupp, htor⟩ : wcSuppIn X {x | f x ≠ IsLocalRing.closedPoint A}
      (wcEtExtZero X (f ⁻¹' S) m) ∧ m • 𝟙 (wcEtExtZero X (f ⁻¹' S) m) = 0 := by
    have hext : ∀ (Y : Scheme.{u}) (T T' : Set Y) (m : ℕ), T ⊆ T' →
        wcSuppIn Y T' (wcEtExtZero Y T m) ∧ m • 𝟙 (wcEtExtZero Y T m) = 0 := by
      intro Y T T' m hTT'
      constructor
      · intro V s
        let η := toSheafify (Scheme.smallEtaleTopology Y) (wcEtExtZeroPre Y T m)
        have : Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology Y) η :=
          Presheaf.isLocallySurjective_toSheafify' _ _
        have hI := Presheaf.imageSieve_mem (Scheme.smallEtaleTopology Y) η s
        refine GrothendieckTopology.superset_covering _ ?_ hI
        intro V' g hg
        obtain ⟨t, ht⟩ := hg
        apply Sieve.le_generate
        by_cases hp : ∀ x, V'.hom x ∈ T
        · exact Or.inr (fun x => hTT' (hp x))
        · left
          have key : ∀ (p : Prop), ¬p → ∀ y : ↥(wcSuppSub.{u} m p), y = 0 := by
            intro p hp y
            obtain ⟨y, hy⟩ := y
            have hy' : y ∈ (⊥ : AddSubgroup (ULift.{u+1} (ZMod m))) := by
              unfold wcSuppSub at hy
              rwa [iSup_neg hp] at hy
            exact Subtype.ext ((AddSubgroup.mem_bot).mp hy')
          have ht0 : t = 0 := key _ hp t
          have h2 : (sheafify (Scheme.smallEtaleTopology Y) (wcEtExtZeroPre Y T m)).map g.op s
              = 0 := by
            rw [← ht, ht0, map_zero]
          exact h2
      · have h0 : m • 𝟙 (wcEtExtZeroPre Y T m) = 0 := by
          ext V x
          have hx : ∀ y : ↥(wcSuppSub.{u} m (∀ x, V.unop.hom x ∈ T)), m • y = 0 := by
            rintro ⟨⟨z⟩, hz⟩
            apply Subtype.ext
            apply ULift.ext
            change m • z = (0 : ZMod m)
            rw [nsmul_eq_mul, ZMod.natCast_self, zero_mul]
          simp only [NatTrans.app_nsmul, NatTrans.id_app, AddCommGrpCat.hom_nsmul,
            AddCommGrpCat.hom_id, NatTrans.app_zero, AddCommGrpCat.hom_zero]
          exact hx x
        unfold wcEtExtZero
        rw [← CategoryTheory.Functor.map_id
            (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}),
          ← Functor.map_nsmul, h0, Functor.map_zero]
    exact hext X (f ⁻¹' S) _ m hsub
  have hloc : ∀ {X Y : Scheme.{u}} (g : X ⟶ Y),
      (∀ y : Y, ∃ U : Y.Opens, y ∈ U ∧ wcPBCV (g ∣_ U)) → wcPBCV g := by
    intro X Y g H A' _ _ _ a X' f' a' hsq m' hm' F hF htor' q'
    obtain ⟨U, hyU, hU⟩ := H (a (IsLocalRing.closedPoint A'))
    have htop : a ⁻¹ᵁ U = ⊤ := (IsLocalRing.closedPoint_mem_iff (U := a ⁻¹ᵁ U)).mp hyU
    have hrange : Set.range a ⊆ Set.range U.ι := by
      rw [Scheme.Opens.range_ι]
      rintro _ ⟨z, rfl⟩
      have hz : z ∈ a ⁻¹ᵁ U := by rw [htop]; trivial
      exact hz
    let b := IsOpenImmersion.lift U.ι a hrange
    have hb : b ≫ U.ι = a := IsOpenImmersion.lift_fac _ _ _
    have hsq2 : IsPullback (g ⁻¹ᵁ U).ι (g ∣_ U) g U.ι := (isPullback_morphismRestrict g U).flip
    let a'' : X' ⟶ (g ⁻¹ᵁ U : Scheme.{u}) :=
      hsq2.lift a' (f' ≫ b) (by rw [Category.assoc, hb, hsq.w])
    have h1 : a'' ≫ (g ⁻¹ᵁ U).ι = a' := hsq2.lift_fst _ _ _
    have h2 : a'' ≫ (g ∣_ U) = f' ≫ b := hsq2.lift_snd _ _ _
    have hbig : IsPullback (a'' ≫ (g ⁻¹ᵁ U).ι) f' g (b ≫ U.ι) := by rw [h1, hb]; exact hsq
    have hpb : IsPullback a'' f' (g ∣_ U) b := IsPullback.of_right hbig h2 hsq2
    exact hU A' b X' f' a'' hpb m' hm' F hF htor' q'
  have hall : ∀ {X Y : Scheme.{u}} (g : X ⟶ Y), IsProper g → wcPBCV g :=
    wc_proper_devissage (fun g => wcPBCV g) wc_pbc_finite wc_pbc_P1 wc_pbc_comp wc_pbc_cancel
      hloc
  exact hall f inferInstance A (𝟙 _) X f (𝟙 X) (IsPullback.id_horiz f) m hm _ hsupp htor q

theorem wc_et_push_extZero_iso : ∀ (Y X' : Scheme.{u}) (b : X' ⟶ Y) [IsProper b] (S : Set Y), IsOpen S → (∀ U : Y.Opens, (U : Set Y) = S → IsIso (b ∣_ U)) → ∀ m : ℕ, Nonempty ((wcEtPush b).obj (wcEtExtZero X' (b ⁻¹' S) m) ≅ wcEtExtZero Y S m) :=
by
  intro Y X' b _ S hS hiso m

  have hcov : ∀ (Z : Scheme.{u}) (V : Z.Etale) (R : Sieve V), (∀ v : V.left, ∃ (V₁ : Z.Etale)
      (c : V₁ ⟶ V), R.arrows c ∧ v ∈ Set.range c.left) → R ∈ Scheme.smallEtaleTopology Z V := by
    intro Z V R hR
    change R ∈ Scheme.smallGrothendieckTopology @Etale Z V
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Z
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
    apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Z
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
    intro x
    obtain ⟨V₁, c, hc, y, hy⟩ := hR x
    have hw : c.left ≫ V.hom = V₁.hom := MorphismProperty.Over.w c
    have hEt : Etale c.left := by
      have h1 : Etale V.hom := V.prop
      have h2 : Etale (c.left ≫ V.hom) := by rw [hw]; exact V₁.prop
      exact Etale.of_comp c.left V.hom
    exact ⟨V₁, c, y, hc, hEt, hy⟩
  have hcovR : ∀ (Z : Scheme.{u}) (V : Z.Etale) (R : Sieve V), R ∈ Scheme.smallEtaleTopology Z V →
      ∀ v : V.left, ∃ (V₁ : Z.Etale) (c : V₁ ⟶ V), R.arrows c ∧ v ∈ Set.range c.left := by
    intro Z V R hR v
    change R ∈ Scheme.smallGrothendieckTopology @Etale Z V at hR
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Z
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hR
    obtain ⟨V₁, c, y, hc, _, hy⟩ := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Z
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mp hR v
    exact ⟨V₁, c, hc, y, hy⟩
  have hEtArr : ∀ (Z : Scheme.{u}) (A B : Z.Etale) (c : A ⟶ B), Etale c.left := by
    intro Z A B c
    have hw : c.left ≫ B.hom = A.hom := MorphismProperty.Over.w c
    have h1 : Etale B.hom := B.prop
    have h2 : Etale (c.left ≫ B.hom) := by rw [hw]; exact A.prop
    exact Etale.of_comp c.left B.hom

  have s2 : ∀ (Z : Scheme.{u}) (G : Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1})
      (U : Z.Etale) (s : G.obj.obj (Opposite.op U)), (∀ p : U.left, ∃ (T : Z.Etale) (h : T ⟶ U)
        (t : T.left), h.left t = p ∧ (G.obj.map h.op).hom s = 0) → s = 0 := by
    intro Z G U s hloc
    have hsep := G.isSeparated
    rw [Presheaf.IsSeparated.eq_1] at hsep
    refine hsep U (Presheaf.equalizerSieve (F := G.obj) (X := Opposite.op U) s 0) ?_ s 0 ?_
    · apply hcov
      intro p
      obtain ⟨T, h, t, ht, hs⟩ := hloc p
      refine ⟨T, h, ?_, t, ht⟩
      rw [Presheaf.equalizerSieve_apply, map_zero]
      exact hs
    · intro T f hf
      rw [Presheaf.equalizerSieve_apply] at hf
      exact hf

  have s3 : ∀ (Z : Scheme.{u}) (G : Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1})
      {U U' : Z.Etale} (k : U' ⟶ U) (s : G.obj.obj (Opposite.op U)) (p' : U'.left),
      (∃ (T : Z.Etale) (h : T ⟶ U) (t : T.left), h.left t = k.left p' ∧
        (G.obj.map h.op).hom s = 0) →
      ∃ (T' : Z.Etale) (h' : T' ⟶ U') (t' : T'.left), h'.left t' = p' ∧
        (G.obj.map h'.op).hom ((G.obj.map k.op).hom s) = 0 := by
    intro Z G U U' k s p' hex
    obtain ⟨T, h, t, ht, hs⟩ := hex
    haveI := hEtArr Z T U h
    haveI : Etale U'.hom := U'.prop
    let T' : Z.Etale := MorphismProperty.Over.mk ⊤
      (Limits.pullback.snd h.left k.left ≫ U'.hom) inferInstance
    let h' : T' ⟶ U' := MorphismProperty.Over.homMk (Limits.pullback.snd h.left k.left) rfl trivial
    let f₁ : T' ⟶ T := MorphismProperty.Over.homMk (Limits.pullback.fst h.left k.left) (by
      change Limits.pullback.fst h.left k.left ≫ T.hom = Limits.pullback.snd h.left k.left ≫ U'.hom
      rw [← MorphismProperty.Over.w h, ← MorphismProperty.Over.w k, ← Category.assoc,
        Limits.pullback.condition, Category.assoc]) trivial
    obtain ⟨t', _, ht'⟩ :=
      Scheme.Pullback.exists_preimage_pullback (f := h.left) (g := k.left) t p' ht
    refine ⟨T', h', t', ht', ?_⟩
    have heq : h' ≫ k = f₁ ≫ h := by
      apply MorphismProperty.Over.Hom.ext
      exact (MorphismProperty.Comma.comp_left h' k).trans
        ((Limits.pullback.condition (f := h.left) (g := k.left)).symm.trans
          (MorphismProperty.Comma.comp_left f₁ h).symm)
    have h2 := congrArg (fun φ => (G.obj.map φ.op).hom s) heq
    simp only [op_comp, Functor.map_comp, AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply] at h2
    rw [h2, hs, map_zero]

  have s4 : ∀ (Z : Scheme.{u}) (P : (Z.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1}),
      (∀ (A B : Z.Etale) (f : A ⟶ B), Function.Injective (P.map f.op).hom) →
      ∀ (U : Z.Etale) (x : P.obj (Opposite.op U)),
      ((toSheafify (Scheme.smallEtaleTopology Z) P).app (Opposite.op U)).hom x = 0 →
      ∀ u : U.left, x = 0 := by
    intro Z P hinj U x hx u
    haveI := Presheaf.isLocallyInjective_toSheafify' (Scheme.smallEtaleTopology Z) P
    have hmem := Presheaf.equalizerSieve_mem (Scheme.smallEtaleTopology Z)
      (toSheafify (Scheme.smallEtaleTopology Z) P) x 0 (by rw [map_zero]; exact hx)
    obtain ⟨V₁, c, hc, _⟩ := hcovR Z U _ hmem u
    rw [Presheaf.equalizerSieve_apply, map_zero] at hc
    apply hinj V₁ U c
    rw [map_zero]
    exact hc

  have s5 : ∀ (Z : Scheme.{u}) (T : Set Z) (P : (Z.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1}),
      (∀ (V₁ : Z.Etale) (x₁ : V₁.left), V₁.hom x₁ ∉ T → ∀ a : P.obj (Opposite.op V₁), a = 0) →
      ∀ (U : Z.Etale) (s : ((presheafToSheaf (Scheme.smallEtaleTopology Z)
        AddCommGrpCat.{u+1}).obj P).obj.obj (Opposite.op U)) (p : U.left), U.hom p ∉ T →
      ∃ (U₁ : Z.Etale) (h : U₁ ⟶ U) (x₁ : U₁.left), h.left x₁ = p ∧
        (((presheafToSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).obj P).obj.map
          h.op).hom s = 0 := by
    intro Z T P hP U s p hp
    haveI := Presheaf.isLocallySurjective_toSheafify' (Scheme.smallEtaleTopology Z) P
    have hmem := Presheaf.imageSieve_mem (Scheme.smallEtaleTopology Z)
      (toSheafify (Scheme.smallEtaleTopology Z) P) (U := Opposite.op U) s
    obtain ⟨U₁, h, hh, x₁, hx₁⟩ := hcovR Z U _ hmem p
    rw [Presheaf.imageSieve_apply] at hh
    obtain ⟨a, ha⟩ := hh
    refine ⟨U₁, h, x₁, hx₁, ?_⟩
    have hx1T : U₁.hom x₁ ∉ T := by
      rw [← MorphismProperty.Over.w h, Scheme.Hom.comp_apply, hx₁]
      exact hp
    rw [hP U₁ x₁ hx1T a, map_zero] at ha
    exact ha.symm

  have s8 : ∀ (Z : Scheme.{u}) (G : Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1})
      (U : Z.Etale) (s : G.obj.obj (Opposite.op U)), IsOpen {p : U.left | ∃ (T : Z.Etale)
        (h : T ⟶ U) (t : T.left), h.left t = p ∧ (G.obj.map h.op).hom s = 0} := by
    intro Z G U s
    rw [isOpen_iff_forall_mem_open]
    rintro p ⟨T, h, t, ht, hs⟩
    haveI := hEtArr Z T U h
    refine ⟨Set.range h.left, ?_, (Scheme.Hom.isOpenMap h.left).isOpen_range, ⟨t, ht⟩⟩
    rintro _ ⟨t'', rfl⟩
    exact ⟨T, h, t'', rfl, hs⟩

  let U : Y.Opens := ⟨S, hS⟩
  haveI hU : IsIso (b ∣_ U) := hiso U rfl
  have hcancel : ∀ (Z : Scheme.{u}) (x₁ x₂ : Z ⟶ X'), (∀ z, b (x₁ z) ∈ S) →
      (∀ z, b (x₂ z) ∈ S) → x₁ ≫ b = x₂ ≫ b → x₁ = x₂ := by
    intro Z x₁ x₂ h₁ h₂ heq
    have r₁ : Set.range x₁ ⊆ Set.range (b ⁻¹ᵁ U).ι := by
      rw [Scheme.Opens.range_ι]
      rintro _ ⟨z, rfl⟩
      exact h₁ z
    have r₂ : Set.range x₂ ⊆ Set.range (b ⁻¹ᵁ U).ι := by
      rw [Scheme.Opens.range_ι]
      rintro _ ⟨z, rfl⟩
      exact h₂ z
    have e₁ := IsOpenImmersion.lift_fac (b ⁻¹ᵁ U).ι x₁ r₁
    have e₂ := IsOpenImmersion.lift_fac (b ⁻¹ᵁ U).ι x₂ r₂
    have key : IsOpenImmersion.lift (b ⁻¹ᵁ U).ι x₁ r₁ ≫ (b ∣_ U ≫ U.ι) =
        IsOpenImmersion.lift (b ⁻¹ᵁ U).ι x₂ r₂ ≫ (b ∣_ U ≫ U.ι) := by
      rw [morphismRestrict_ι, ← Category.assoc, ← Category.assoc, e₁, e₂, heq]
    have hl := (cancel_mono (b ∣_ U ≫ U.ι)).mp key
    exact e₁.symm.trans ((congrArg (· ≫ (b ⁻¹ᵁ U).ι) hl).trans e₂)
  have hsurj : ∀ y ∈ S, ∃ x : X', b x = y := by
    intro y hy
    obtain ⟨x'', hx''⟩ := (Scheme.Hom.homeomorph (b ∣_ U)).surjective (⟨y, hy⟩ : U)
    refine ⟨(b ⁻¹ᵁ U).ι x'', ?_⟩
    have h1 := congrArg (fun φ => φ x'') (morphismRestrict_ι b U)
    simp only [Scheme.Hom.comp_apply] at h1
    rw [← h1, ← Scheme.Hom.homeomorph_apply (b ∣_ U) x'', hx'']
    rfl

  have s6 : ∀ (V : Y.Etale) (Ω : Set ((wcEtBaseChange b).obj V).left), IsOpen Ω →
      (∀ p, p ∉ Ω → b (((wcEtBaseChange b).obj V).hom p) ∈ S) → ∀ v : V.left, V.hom v ∉ S →
      ∃ (W : Y.Etale) (g : W ⟶ V) (w : W.left), g.left w = v ∧
        ∀ p : ((wcEtBaseChange b).obj W).left, ((wcEtBaseChange b).map g).left p ∈ Ω := by
    intro V Ω hΩ hcompl v hv
    haveI : IsProper (Limits.pullback.fst V.hom b) := inferInstance
    let D : Set V.left := (Limits.pullback.fst V.hom b) '' Ωᶜ
    have hD : IsClosed D :=
      Scheme.Hom.isClosedMap (Limits.pullback.fst V.hom b) _ hΩ.isClosed_compl
    have hvD : v ∉ D := by
      rintro ⟨p, hp, hpv⟩
      apply hv
      have h1 := hcompl p hp
      have hc := congrArg (fun φ => φ p) (Limits.pullback.condition (f := V.hom) (g := b))
      simp only [Scheme.Hom.comp_apply] at hc
      rw [← hpv, hc]
      exact h1
    let O : V.left.Opens := ⟨Dᶜ, hD.isOpen_compl⟩
    haveI : Etale V.hom := V.prop
    let W : Y.Etale := MorphismProperty.Over.mk ⊤ (O.ι ≫ V.hom) inferInstance
    let g : W ⟶ V := MorphismProperty.Over.homMk O.ι rfl trivial
    refine ⟨W, g, (⟨v, hvD⟩ : (O : Scheme.{u})), Scheme.Opens.ι_apply O _, ?_⟩
    intro p
    by_contra hp
    have h2 : ((wcEtBaseChange b).map g).left ≫ Limits.pullback.fst V.hom b =
        Limits.pullback.fst W.hom b ≫ g.left := Limits.pullback.lift_fst _ _ _
    have h3 := congrArg (fun φ => φ p) h2
    have h3' : Limits.pullback.fst V.hom b (((wcEtBaseChange b).map g).left p) =
        g.left (Limits.pullback.fst W.hom b p) :=
      (Scheme.Hom.comp_apply _ _ _).symm.trans (h3.trans (Scheme.Hom.comp_apply _ _ _))
    have h4 : g.left (Limits.pullback.fst W.hom b p) ∈ O :=
      (congrArg (· ∈ O) (Scheme.Opens.ι_apply O (Limits.pullback.fst W.hom b p))).mpr
        (Limits.pullback.fst W.hom b p).2
    have h5 : Limits.pullback.fst V.hom b (((wcEtBaseChange b).map g).left p) ∈ O :=
      (congrArg (· ∈ O) h3').mpr h4
    exact (h5 : _ ∉ D) ⟨_, hp, rfl⟩

  have s7 : ∀ (P : (X'.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) (V : Y.Etale)
      (s : ((presheafToSheaf (Scheme.smallEtaleTopology X') AddCommGrpCat.{u+1}).obj P).obj.obj
        (Opposite.op ((wcEtBaseChange b).obj V))) (v : V.left), V.hom v ∈ S →
      ∃ (W : Y.Etale) (g : W ⟶ V) (w : W.left)
        (a : P.obj (Opposite.op ((wcEtBaseChange b).obj W))),
        g.left w = v ∧ (∀ x : W.left, W.hom x ∈ S) ∧
        ((toSheafify (Scheme.smallEtaleTopology X') P).app
          (Opposite.op ((wcEtBaseChange b).obj W))).hom a =
          (((presheafToSheaf (Scheme.smallEtaleTopology X') AddCommGrpCat.{u+1}).obj P).obj.map
            ((wcEtBaseChange b).map g).op).hom s := by
    intro P V s v hv
    let Gs := ((presheafToSheaf (Scheme.smallEtaleTopology X') AddCommGrpCat.{u+1}).obj P).obj
    let O : V.left.Opens := V.hom ⁻¹ᵁ U
    let W₀ : Y.Etale := MorphismProperty.Over.mk ⊤ (O.ι ≫ V.hom) (by
      haveI : Etale V.hom := V.prop
      infer_instance)
    let g₀ : W₀ ⟶ V := MorphismProperty.Over.homMk O.ι rfl trivial
    let w₀ : (O : Scheme.{u}) := ⟨v, hv⟩
    have hw₀ : g₀.left w₀ = v := Scheme.Opens.ι_apply O w₀
    have hW₀S' : ∀ w' : (O : Scheme.{u}), (O.ι ≫ V.hom) w' ∈ S := by
      intro w'
      rw [Scheme.Hom.comp_apply]
      exact (congrArg (fun p => V.hom p ∈ S) (Scheme.Opens.ι_apply O w')).mpr w'.2
    have hW₀S : ∀ w : W₀.left, W₀.hom w ∈ S := fun w => hW₀S' w
    let s₀ := (Gs.map ((wcEtBaseChange b).map g₀).op).hom s
    obtain ⟨x, hx⟩ := hsurj _ (hW₀S w₀)
    obtain ⟨t, ht1, ht2⟩ :=
      Scheme.Pullback.exists_preimage_pullback (f := W₀.hom) (g := b) w₀ x hx.symm
    haveI := Presheaf.isLocallySurjective_toSheafify' (Scheme.smallEtaleTopology X') P
    have hmem := Presheaf.imageSieve_mem (Scheme.smallEtaleTopology X')
      (toSheafify (Scheme.smallEtaleTopology X') P)
      (U := Opposite.op ((wcEtBaseChange b).obj W₀)) s₀
    obtain ⟨T', h, hh, t', ht'⟩ := hcovR X' _ _ hmem t
    rw [Presheaf.imageSieve_apply] at hh
    obtain ⟨a', ha'⟩ := hh
    have hw : h.left ≫ Limits.pullback.snd W₀.hom b = T'.hom := MorphismProperty.Over.w h
    have landS : ∀ {A P W' : Scheme.{u}} (k : A ⟶ P) (fst' : P ⟶ W') (snd' : P ⟶ X')
        (wh : W' ⟶ Y) (T : A ⟶ X'), k ≫ snd' = T → fst' ≫ wh = snd' ≫ b →
        (∀ w, wh w ∈ S) → ∀ z, b (T z) ∈ S := by
      intro A P W' k fst' snd' wh T hk hcond hwS z
      rw [← hk, Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply snd' b, ← hcond,
        Scheme.Hom.comp_apply]
      exact hwS _
    have compEq : ∀ {A P W' : Scheme.{u}} (k : A ⟶ P) (fst' : P ⟶ W') (snd' : P ⟶ X')
        (wh : W' ⟶ Y) (T : A ⟶ X'), k ≫ snd' = T → fst' ≫ wh = snd' ≫ b →
        (k ≫ fst') ≫ wh = T ≫ b := by
      intro A P W' k fst' snd' wh T hk hcond
      rw [Category.assoc, hcond, ← Category.assoc, hk]
    have hT'S : ∀ z : T'.left, b (T'.hom z) ∈ S :=
      landS h.left _ _ _ T'.hom hw Limits.pullback.condition hW₀S
    have hr : Set.range T'.hom ⊆ Set.range (b ⁻¹ᵁ U).ι := by
      rw [Scheme.Opens.range_ι]
      rintro _ ⟨z, rfl⟩
      exact hT'S z
    have hτ : IsOpenImmersion.lift (b ⁻¹ᵁ U).ι T'.hom hr ≫ (b ⁻¹ᵁ U).ι = T'.hom :=
      IsOpenImmersion.lift_fac _ _ hr
    haveI hτet : Etale (IsOpenImmersion.lift (b ⁻¹ᵁ U).ι T'.hom hr) :=
      MorphismProperty.of_postcomp @Etale (W' := @Etale) _ (b ⁻¹ᵁ U).ι inferInstance
        (by rw [hτ]; exact T'.prop)
    have hcomp : T'.hom ≫ b = IsOpenImmersion.lift (b ⁻¹ᵁ U).ι T'.hom hr ≫ (b ∣_ U ≫ U.ι) := by
      rw [morphismRestrict_ι, ← Category.assoc, hτ]
    have hét : Etale (T'.hom ≫ b) := by rw [hcomp]; infer_instance
    let W : Y.Etale := MorphismProperty.Over.mk ⊤ (T'.hom ≫ b) hét
    let g : W ⟶ W₀ := MorphismProperty.Over.homMk (h.left ≫ Limits.pullback.fst W₀.hom b)
      (compEq h.left _ _ _ T'.hom hw Limits.pullback.condition) trivial
    have hstar : Limits.pullback.fst (T'.hom ≫ b) b ≫ T'.hom =
        Limits.pullback.snd (T'.hom ≫ b) b := by
      apply hcancel
      · intro z
        rw [Scheme.Hom.comp_apply]
        exact hT'S _
      · intro z
        rw [← Scheme.Hom.comp_apply (Limits.pullback.snd (T'.hom ≫ b) b) b,
          ← Limits.pullback.condition, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply]
        exact hT'S _
      · rw [Category.assoc, Limits.pullback.condition]
    let e₀ : Limits.pullback (T'.hom ≫ b) b ≅ T'.left :=
      { hom := Limits.pullback.fst (T'.hom ≫ b) b
        inv := Limits.pullback.lift (𝟙 T'.left) T'.hom (by rw [Category.id_comp])
        hom_inv_id := by
          apply Limits.pullback.hom_ext
          · rw [Category.assoc, Limits.pullback.lift_fst, Category.comp_id, Category.id_comp]
          · rw [Category.assoc, Limits.pullback.lift_snd, Category.id_comp, hstar]
        inv_hom_id := Limits.pullback.lift_fst _ _ _ }
    let ε : (wcEtBaseChange b).obj W ≅ T' := MorphismProperty.Over.isoMk e₀ (by exact hstar)
    have h2f : ((wcEtBaseChange b).map g).left ≫ Limits.pullback.fst W₀.hom b =
        Limits.pullback.fst (T'.hom ≫ b) b ≫ g.left := Limits.pullback.lift_fst _ _ _
    have h2s : ((wcEtBaseChange b).map g).left ≫ Limits.pullback.snd W₀.hom b =
        Limits.pullback.snd (T'.hom ≫ b) b := Limits.pullback.lift_snd _ _ _
    have hε : ε.hom ≫ h = (wcEtBaseChange b).map g := by
      apply MorphismProperty.Over.Hom.ext
      change Limits.pullback.fst (T'.hom ≫ b) b ≫ h.left = ((wcEtBaseChange b).map g).left
      refine Limits.pullback.hom_ext (f := W₀.hom) (g := b) ?_ ?_
      · exact (Category.assoc _ _ _).trans h2f.symm
      · exact (Category.assoc _ _ _).trans
          ((congrArg (fun φ => Limits.pullback.fst (T'.hom ≫ b) b ≫ φ) hw).trans
            (hstar.trans h2s.symm))
    refine ⟨W, g ≫ g₀, t', (P.map ε.hom.op).hom a', ?_, ?_, ?_⟩
    · have e1 : (g ≫ g₀).left t' = g₀.left (g.left t') :=
        (congrArg (fun φ => φ t') (MorphismProperty.Comma.comp_left g g₀)).trans
          (Scheme.Hom.comp_apply _ _ _)
      have e2 : g.left t' = Limits.pullback.fst W₀.hom b (h.left t') :=
        Scheme.Hom.comp_apply h.left _ t'
      exact e1.trans ((congrArg g₀.left (e2.trans ((congrArg _ ht').trans ht1))).trans hw₀)
    · intro z
      show (T'.hom ≫ b) z ∈ S
      exact (congrArg (· ∈ S) (Scheme.Hom.comp_apply T'.hom b z)).mpr (hT'S z)
    · have n1 := NatTrans.naturality_apply (toSheafify (Scheme.smallEtaleTopology X') P)
        ε.hom.op a'
      have key : Gs.map ((wcEtBaseChange b).map (g ≫ g₀)).op =
          Gs.map ((wcEtBaseChange b).map g₀).op ≫ Gs.map h.op ≫ Gs.map ε.hom.op := by
        rw [Functor.map_comp, op_comp, ← hε, op_comp, Functor.map_comp, Functor.map_comp]
      change _ = (Gs.map ((wcEtBaseChange b).map (g ≫ g₀)).op).hom s
      rw [key]
      simp only [AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply]
      refine n1.trans ?_
      rw [ha']

  have supBot : ∀ (p : Prop), ¬ p → ∀ a : wcSuppSub.{u} m p, a = 0 := by
    intro p hp a
    apply Subtype.ext
    have h2 : wcSuppSub.{u} m p = ⊥ :=
      (iSup_neg hp : (⨆ _ : p, (⊤ : AddSubgroup (ULift.{u+1} (ZMod m)))) = ⊥)
    have h3 : (a : ULift.{u+1} (ZMod m)) ∈ (⊥ : AddSubgroup (ULift.{u+1} (ZMod m))) := h2 ▸ a.2
    exact AddSubgroup.mem_bot.mp h3
  have supTop : ∀ (p : Prop), p → ∀ y : ULift.{u+1} (ZMod m), y ∈ wcSuppSub.{u} m p := by
    intro p hp y
    exact AddSubgroup.mem_iSup_of_mem hp (AddSubgroup.mem_top y)
  have hinj : ∀ (A B : X'.Etale) (f : A ⟶ B),
      Function.Injective ((wcEtExtZeroPre X' (b ⁻¹' S) m).map f.op).hom := by
    intro A B f x y hxy
    have hv := congrArg Subtype.val hxy
    exact Subtype.ext hv
  have hle : ∀ V : Y.Etale, wcSuppSub.{u} m (∀ x, V.hom x ∈ S) ≤
      wcSuppSub.{u} m (∀ x, ((wcEtBaseChange b).obj V).hom x ∈ b ⁻¹' S) := by
    intro V
    refine iSup_le fun hp => le_iSup_of_le (fun x => ?_) le_rfl
    show b (Limits.pullback.snd V.hom b x) ∈ S
    have hc := congrArg (fun φ => φ x) (Limits.pullback.condition (f := V.hom) (g := b))
    have e : b (Limits.pullback.snd V.hom b x) = V.hom (Limits.pullback.fst V.hom b x) :=
      (Scheme.Hom.comp_apply _ _ x).symm.trans (hc.symm.trans (Scheme.Hom.comp_apply _ _ x))
    exact (congrArg (· ∈ S) e).mpr (hp _)
  let α : wcEtExtZeroPre Y S m ⟶ (wcEtBaseChange b).op ⋙ wcEtExtZeroPre X' (b ⁻¹' S) m :=
    { app := fun V => AddCommGrpCat.ofHom (AddSubgroup.inclusion (hle V.unop))
      naturality := fun _ _ _ => rfl }
  let φ : wcEtExtZeroPre Y S m ⟶ (wcEtBaseChange b).op ⋙ (wcEtExtZero X' (b ⁻¹' S) m).obj :=
    α ≫ Functor.whiskerLeft (wcEtBaseChange b).op
      (toSheafify (Scheme.smallEtaleTopology X') (wcEtExtZeroPre X' (b ⁻¹' S) m))

  have hφinj : Presheaf.IsLocallyInjective (Scheme.smallEtaleTopology Y) φ := by
    apply Presheaf.IsLocallyInjective.mk
    intro V x y hxy
    apply hcov
    intro v
    refine ⟨V.unop, 𝟙 _, ?_, v, rfl⟩
    rw [Presheaf.equalizerSieve_apply]
    suffices hxy' : x = y by rw [hxy']
    by_cases hp : ∀ z, V.unop.hom z ∈ S
    · obtain ⟨x', hx'⟩ := hsurj _ (hp v)
      obtain ⟨u, _, _⟩ :=
        Scheme.Pullback.exists_preimage_pullback (f := V.unop.hom) (g := b) v x' hx'.symm
      have h0 : ((toSheafify (Scheme.smallEtaleTopology X') (wcEtExtZeroPre X' (b ⁻¹' S) m)).app
          (Opposite.op ((wcEtBaseChange b).obj V.unop))).hom ((α.app V).hom (x - y)) = 0 := by
        have h00 : (φ.app V).hom (x - y) = 0 := by
          rw [map_sub, sub_eq_zero]
          exact hxy
        exact h00
      have h1 := s4 X' _ hinj _ _ h0 u
      rw [map_sub, sub_eq_zero] at h1
      have hv := congrArg Subtype.val h1
      exact Subtype.ext hv
    · rw [supBot _ hp x, supBot _ hp y]

  have hφsurj : Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology Y) φ := by
    apply Presheaf.IsLocallySurjective.mk
    intro V s
    apply hcov
    intro v
    by_cases hv : V.hom v ∈ S
    · obtain ⟨W, g, w, a, hw, hWS, heq⟩ := s7 (wcEtExtZeroPre X' (b ⁻¹' S) m) V s v hv
      refine ⟨W, g, ?_, w, hw⟩
      rw [Presheaf.imageSieve_apply]
      refine ⟨(⟨Subtype.val a, supTop _ hWS (Subtype.val a)⟩ :
        wcSuppSub.{u} m (∀ x, W.hom x ∈ S)), ?_⟩
      exact heq
    · let G := wcEtExtZero X' (b ⁻¹' S) m
      let Ω : Set ((wcEtBaseChange b).obj V).left := {p | ∃ (T : X'.Etale)
        (h : T ⟶ (wcEtBaseChange b).obj V) (t : T.left), h.left t = p ∧
          (G.obj.map h.op).hom s = 0}
      have hΩ : IsOpen Ω := s8 X' G _ s
      have hcompl : ∀ p, p ∉ Ω → b (((wcEtBaseChange b).obj V).hom p) ∈ S := by
        intro p hp
        by_contra hpS
        apply hp
        exact s5 X' (b ⁻¹' S) (wcEtExtZeroPre X' (b ⁻¹' S) m)
          (fun V₁ x₁ hx₁ a => supBot _ (fun hall => hx₁ (hall x₁)) a) _ s p hpS
      obtain ⟨W, g, w, hw, hWΩ⟩ := s6 V Ω hΩ hcompl v hv
      have hz : (G.obj.map ((wcEtBaseChange b).map g).op).hom s = 0 := by
        apply s2 X' G
        intro p
        exact s3 X' G ((wcEtBaseChange b).map g) s p (hWΩ p)
      refine ⟨W, g, ?_, w, hw⟩
      rw [Presheaf.imageSieve_apply]
      refine ⟨0, ?_⟩
      rw [map_zero]
      exact hz.symm
  have hW : (Scheme.smallEtaleTopology Y).W φ :=
    (GrothendieckTopology.W_iff_isLocallyBijective _ φ).2 ⟨hφinj, hφsurj⟩
  haveI := (GrothendieckTopology.W_iff _ φ).1 hW
  exact ⟨(asIso ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map φ)).symm⟩

theorem wc_et_locKill_iso_locus : ∀ (Y X' : Scheme.{u}) (b : X' ⟶ Y) (S : Set Y), IsOpen S → (∀ U : Y.Opens, (U : Set Y) = S → IsIso (b ∣_ U)) → ∀ (K : CochainComplex (Sheaf (Scheme.smallEtaleTopology X') AddCommGrpCat.{u+1}) ℕ) (q : ℕ), (∀ (T : X'.Etale) (c : (K.X (q + 1)).obj.obj (Opposite.op T)), ((K.d (q + 1) (q + 2)).hom.app (Opposite.op T)).hom c = 0 → ∀ t : T.left, ∃ (T' : X'.Etale) (h : T' ⟶ T) (t' : T'.left) (e : (K.X q).obj.obj (Opposite.op T')), h.left t' = t ∧ ((K.d q (q + 1)).hom.app (Opposite.op T')).hom e = ((K.X (q + 1)).obj.map h.op).hom c) → wcEtLocKill b K q (· ∈ S) :=
by
  intro Y X' b S hS hiso K q HLOC V c hc v hv
  let U : Y.Opens := ⟨S, hS⟩
  haveI hU : IsIso (b ∣_ U) := hiso U rfl

  have hcancel : ∀ (Z : Scheme.{u}) (x₁ x₂ : Z ⟶ X'), (∀ z, b (x₁ z) ∈ S) →
      (∀ z, b (x₂ z) ∈ S) → x₁ ≫ b = x₂ ≫ b → x₁ = x₂ := by
    intro Z x₁ x₂ h₁ h₂ heq
    have r₁ : Set.range x₁ ⊆ Set.range (b ⁻¹ᵁ U).ι := by
      rw [Scheme.Opens.range_ι]
      rintro _ ⟨z, rfl⟩
      exact h₁ z
    have r₂ : Set.range x₂ ⊆ Set.range (b ⁻¹ᵁ U).ι := by
      rw [Scheme.Opens.range_ι]
      rintro _ ⟨z, rfl⟩
      exact h₂ z
    have e₁ := IsOpenImmersion.lift_fac (b ⁻¹ᵁ U).ι x₁ r₁
    have e₂ := IsOpenImmersion.lift_fac (b ⁻¹ᵁ U).ι x₂ r₂
    have key : IsOpenImmersion.lift (b ⁻¹ᵁ U).ι x₁ r₁ ≫ (b ∣_ U ≫ U.ι) =
        IsOpenImmersion.lift (b ⁻¹ᵁ U).ι x₂ r₂ ≫ (b ∣_ U ≫ U.ι) := by
      rw [morphismRestrict_ι, ← Category.assoc, ← Category.assoc, e₁, e₂, heq]
    have hl := (cancel_mono (b ∣_ U ≫ U.ι)).mp key
    exact e₁.symm.trans ((congrArg (· ≫ (b ⁻¹ᵁ U).ι) hl).trans e₂)

  have hsurj : ∀ y ∈ S, ∃ x : X', b x = y := by
    intro y hy
    obtain ⟨x'', hx''⟩ := (Scheme.Hom.homeomorph (b ∣_ U)).surjective (⟨y, hy⟩ : U)
    refine ⟨(b ⁻¹ᵁ U).ι x'', ?_⟩
    have h1 := congrArg (fun φ => φ x'') (morphismRestrict_ι b U)
    simp only [Scheme.Hom.comp_apply] at h1
    rw [← h1, ← Scheme.Hom.homeomorph_apply (b ∣_ U) x'', hx'']
    rfl

  let O : V.left.Opens := V.hom ⁻¹ᵁ U
  let W₀ : Y.Etale := MorphismProperty.Over.mk ⊤ (O.ι ≫ V.hom) (by
    haveI : Etale V.hom := V.prop
    infer_instance)
  let g₀ : W₀ ⟶ V := MorphismProperty.Over.homMk O.ι rfl trivial
  let w₀ : (O : Scheme.{u}) := ⟨v, hv⟩
  have hw₀ : g₀.left w₀ = v := Scheme.Opens.ι_apply O w₀
  have hW₀S' : ∀ w' : (O : Scheme.{u}), (O.ι ≫ V.hom) w' ∈ S := by
    intro w'
    rw [Scheme.Hom.comp_apply]
    exact (congrArg (fun p => V.hom p ∈ S) (Scheme.Opens.ι_apply O w')).mpr w'.2
  have hW₀S : ∀ w : W₀.left, W₀.hom w ∈ S := fun w => hW₀S' w

  have hc₀ : ((K.d (q + 1) (q + 2)).hom.app (Opposite.op ((wcEtBaseChange b).obj W₀))).hom
      (((K.X (q + 1)).obj.map ((wcEtBaseChange b).map g₀).op).hom c) = 0 := by
    have h1 := congrArg (fun φ => (AddCommGrpCat.Hom.hom φ) c)
      ((K.d (q + 1) (q + 2)).hom.naturality ((wcEtBaseChange b).map g₀).op)
    simp only [AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply] at h1
    rw [h1, hc, map_zero]

  obtain ⟨x, hx⟩ := hsurj _ (hW₀S w₀)
  obtain ⟨t, ht1, ht2⟩ := Scheme.Pullback.exists_preimage_pullback (f := W₀.hom) (g := b) w₀ x hx.symm

  obtain ⟨T', h, t', e', ht', he'⟩ := HLOC ((wcEtBaseChange b).obj W₀)
    (((K.X (q + 1)).obj.map ((wcEtBaseChange b).map g₀).op).hom c) hc₀ t
  have hw : h.left ≫ Limits.pullback.snd W₀.hom b = T'.hom := MorphismProperty.Over.w h

  have landS : ∀ {A P W' : Scheme.{u}} (k : A ⟶ P) (fst' : P ⟶ W') (snd' : P ⟶ X') (wh : W' ⟶ Y)
      (T : A ⟶ X'), k ≫ snd' = T → fst' ≫ wh = snd' ≫ b → (∀ w, wh w ∈ S) → ∀ z, b (T z) ∈ S := by
    intro A P W' k fst' snd' wh T hk hcond hwS z
    rw [← hk, Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply snd' b, ← hcond, Scheme.Hom.comp_apply]
    exact hwS _
  have compEq : ∀ {A P W' : Scheme.{u}} (k : A ⟶ P) (fst' : P ⟶ W') (snd' : P ⟶ X') (wh : W' ⟶ Y)
      (T : A ⟶ X'), k ≫ snd' = T → fst' ≫ wh = snd' ≫ b → (k ≫ fst') ≫ wh = T ≫ b := by
    intro A P W' k fst' snd' wh T hk hcond
    rw [Category.assoc, hcond, ← Category.assoc, hk]
  have hT'S : ∀ z : T'.left, b (T'.hom z) ∈ S :=
    landS h.left _ _ _ T'.hom hw Limits.pullback.condition hW₀S

  have hr : Set.range T'.hom ⊆ Set.range (b ⁻¹ᵁ U).ι := by
    rw [Scheme.Opens.range_ι]
    rintro _ ⟨z, rfl⟩
    exact hT'S z
  have hτ : IsOpenImmersion.lift (b ⁻¹ᵁ U).ι T'.hom hr ≫ (b ⁻¹ᵁ U).ι = T'.hom :=
    IsOpenImmersion.lift_fac _ _ hr
  haveI hτet : Etale (IsOpenImmersion.lift (b ⁻¹ᵁ U).ι T'.hom hr) :=
    MorphismProperty.of_postcomp @Etale (W' := @Etale) _ (b ⁻¹ᵁ U).ι inferInstance
      (by rw [hτ]; exact T'.prop)
  have hcomp : T'.hom ≫ b = IsOpenImmersion.lift (b ⁻¹ᵁ U).ι T'.hom hr ≫ (b ∣_ U ≫ U.ι) := by
    rw [morphismRestrict_ι, ← Category.assoc, hτ]
  have hét : Etale (T'.hom ≫ b) := by rw [hcomp]; infer_instance
  let W : Y.Etale := MorphismProperty.Over.mk ⊤ (T'.hom ≫ b) hét
  let g : W ⟶ W₀ := MorphismProperty.Over.homMk (h.left ≫ Limits.pullback.fst W₀.hom b)
    (compEq h.left _ _ _ T'.hom hw Limits.pullback.condition) trivial
  have hstar : Limits.pullback.fst (T'.hom ≫ b) b ≫ T'.hom = Limits.pullback.snd (T'.hom ≫ b) b := by
    apply hcancel
    · intro z
      rw [Scheme.Hom.comp_apply]
      exact hT'S _
    · intro z
      rw [← Scheme.Hom.comp_apply (Limits.pullback.snd (T'.hom ≫ b) b) b,
        ← Limits.pullback.condition, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply]
      exact hT'S _
    · rw [Category.assoc, Limits.pullback.condition]
  let e₀ : Limits.pullback (T'.hom ≫ b) b ≅ T'.left :=
    { hom := Limits.pullback.fst (T'.hom ≫ b) b
      inv := Limits.pullback.lift (𝟙 T'.left) T'.hom (by rw [Category.id_comp])
      hom_inv_id := by
        apply Limits.pullback.hom_ext
        · rw [Category.assoc, Limits.pullback.lift_fst, Category.comp_id, Category.id_comp]
        · rw [Category.assoc, Limits.pullback.lift_snd, Category.id_comp, hstar]
      inv_hom_id := Limits.pullback.lift_fst _ _ _ }
  let ε : (wcEtBaseChange b).obj W ≅ T' := MorphismProperty.Over.isoMk e₀ (by exact hstar)
  have h2f : ((wcEtBaseChange b).map g).left ≫ Limits.pullback.fst W₀.hom b =
      Limits.pullback.fst (T'.hom ≫ b) b ≫ g.left := Limits.pullback.lift_fst _ _ _
  have h2s : ((wcEtBaseChange b).map g).left ≫ Limits.pullback.snd W₀.hom b =
      Limits.pullback.snd (T'.hom ≫ b) b := Limits.pullback.lift_snd _ _ _
  have hε : ε.hom ≫ h = (wcEtBaseChange b).map g := by
    apply MorphismProperty.Over.Hom.ext
    change Limits.pullback.fst (T'.hom ≫ b) b ≫ h.left = ((wcEtBaseChange b).map g).left
    refine Limits.pullback.hom_ext (f := W₀.hom) (g := b) ?_ ?_
    · exact (Category.assoc _ _ _).trans h2f.symm
    · exact (Category.assoc _ _ _).trans
        ((congrArg (fun φ => Limits.pullback.fst (T'.hom ≫ b) b ≫ φ) hw).trans (hstar.trans h2s.symm))

  refine ⟨W, g ≫ g₀, t', ((K.X q).obj.map ε.hom.op).hom e', ?_, ?_⟩
  · have e1 : (g ≫ g₀).left t' = g₀.left (g.left t') :=
      (congrArg (fun φ => φ t') (MorphismProperty.Comma.comp_left g g₀)).trans
        (Scheme.Hom.comp_apply _ _ _)
    have e2 : g.left t' = Limits.pullback.fst W₀.hom b (h.left t') :=
      Scheme.Hom.comp_apply h.left _ t'
    exact e1.trans ((congrArg g₀.left (e2.trans ((congrArg _ ht').trans ht1))).trans hw₀)
  · have n1 := congrArg (fun φ => (AddCommGrpCat.Hom.hom φ) e')
      ((K.d q (q + 1)).hom.naturality ε.hom.op)
    simp only [AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply] at n1
    have key : (K.X (q + 1)).obj.map ((wcEtBaseChange b).map (g ≫ g₀)).op =
        (K.X (q + 1)).obj.map ((wcEtBaseChange b).map g₀).op ≫ (K.X (q + 1)).obj.map h.op ≫
          (K.X (q + 1)).obj.map ε.hom.op := by
      rw [Functor.map_comp, op_comp, ← hε, op_comp, Functor.map_comp, Functor.map_comp]
    rw [key, n1, he']
    simp only [AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply]

theorem wc_et_pull_extZero_iso : ∀ {X Z : Scheme.{u}} (p : Z ⟶ X) (L : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1} ⥤ Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}), Nonempty (L ⊣ wcEtPush p) → ∀ (T : Set X), IsOpen T → ∀ m : ℕ, Nonempty (L.obj (wcEtExtZero X T m) ≅ wcEtExtZero Z (p ⁻¹' T) m) :=
by

  have hjs : ∀ (Y : Scheme.{u}) (V : Y.Etale) (S : Sieve V), (∀ v : V.left, ∃ (V₁ : Y.Etale)
      (c : V₁ ⟶ V), S.arrows c ∧ v ∈ Set.range c.left) → S ∈ Scheme.smallEtaleTopology Y V := by
    intro Y V S hS
    change S ∈ Scheme.smallGrothendieckTopology @Etale Y V
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
    apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
    intro x
    obtain ⟨V₁, c, hc, y, hy⟩ := hS x
    have hw : c.left ≫ V.hom = V₁.hom := MorphismProperty.Over.w c
    have hEt : Etale c.left := by
      have h1 : Etale V.hom := V.prop
      have h2 : Etale (c.left ≫ V.hom) := by rw [hw]; exact V₁.prop
      exact Etale.of_comp c.left V.hom
    exact ⟨V₁, c, y, hc, hEt, hy⟩

  have hcov : ∀ {X B : Scheme.{u}} (g : X ⟶ B), CoverPreserving (Scheme.smallEtaleTopology B)
      (Scheme.smallEtaleTopology X) (wcEtBaseChange g) := by
    intro X B g
    constructor
    intro V S hS
    change S ∈ Scheme.smallGrothendieckTopology @Etale B V at hS
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale B
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hS
    have hS' := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale B
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mp hS
    apply hjs
    intro v
    obtain ⟨W, a, w, ha, -, hw⟩ := hS' (Limits.pullback.fst V.hom g v)
    refine ⟨(wcEtBaseChange g).obj W, (wcEtBaseChange g).map a,
      Sieve.image_mem_functorPushforward (wcEtBaseChange g) S ha, ?_⟩
    have h0 : (Limits.pullback.fst W.hom g ≫ a.left) ≫ V.hom = Limits.pullback.snd W.hom g ≫ g := by
      rw [Category.assoc, MorphismProperty.Over.w a]
      exact Limits.pullback.condition
    let m : Limits.pullback W.hom g ⟶ Limits.pullback V.hom g :=
      Limits.pullback.lift (Limits.pullback.fst W.hom g ≫ a.left) (Limits.pullback.snd W.hom g) h0
    have hmap : ((wcEtBaseChange g).map a).left = m := rfl
    have h1 : Limits.pullback.fst a.left (Limits.pullback.fst V.hom g) ≫ W.hom =
        (Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) ≫ Limits.pullback.snd V.hom g) ≫ g := by
      rw [← MorphismProperty.Over.w a, ← Category.assoc, Limits.pullback.condition, Category.assoc,
        Limits.pullback.condition, Category.assoc]
    let ψ : Limits.pullback a.left (Limits.pullback.fst V.hom g) ⟶ Limits.pullback W.hom g :=
      Limits.pullback.lift (Limits.pullback.fst a.left (Limits.pullback.fst V.hom g))
        (Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) ≫ Limits.pullback.snd V.hom g) h1
    have hψ : ψ ≫ m = Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, Limits.pullback.lift_fst, ← Category.assoc, Limits.pullback.lift_fst,
          Limits.pullback.condition]
      · rw [Category.assoc, Limits.pullback.lift_snd, Limits.pullback.lift_snd]
    obtain ⟨z, hz⟩ : ∃ z, Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) z = v := by
      have hv : (v : ↥(Limits.pullback V.hom g)) ∈
          Set.range (Limits.pullback.snd a.left (Limits.pullback.fst V.hom g)) := by
        rw [Scheme.Pullback.range_snd]
        exact ⟨w, hw⟩
      exact hv
    rw [hmap]
    exact ⟨ψ z, (Scheme.Hom.comp_apply ψ m z).symm.trans (by rw [hψ]; exact hz)⟩

  have s3 : ∀ (Y : Scheme.{u}) (E : Y.Etale), IsOpenImmersion E.hom → ∀ V : Y.Etale,
      Subsingleton (V ⟶ E) ∧ (Nonempty (V ⟶ E) ↔ ∀ x, V.hom x ∈ Set.range E.hom) := by
    intro Y E hE V
    refine ⟨⟨fun a b => ?_⟩, ⟨fun ⟨a⟩ x => ?_, fun h => ?_⟩⟩
    · apply MorphismProperty.Over.Hom.ext
      rw [← cancel_mono E.hom, MorphismProperty.Over.w a, MorphismProperty.Over.w b]
    · rw [← MorphismProperty.Over.w a, Scheme.Hom.comp_apply]
      exact ⟨_, rfl⟩
    · have h' : Set.range V.hom ⊆ Set.range E.hom := by
        rintro _ ⟨x, rfl⟩
        exact h x
      exact ⟨MorphismProperty.Over.homMk (IsOpenImmersion.lift E.hom V.hom h')
        (IsOpenImmersion.lift_fac _ _ _) trivial⟩
  intro X Z p L hadj T hT m
  obtain ⟨adj⟩ := hadj

  have s2 : ∀ (Y : Scheme.{u}) (S : Set Y) (E : Y.Etale), (∀ V : Y.Etale, Subsingleton (V ⟶ E)) →
      (∀ V : Y.Etale, Nonempty (V ⟶ E) ↔ ∀ x, V.hom x ∈ S) →
      ∃ ε : ∀ Q : (Y.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1},
          (wcEtExtZeroPre Y S m ⟶ Q) ≃ {s : Q.obj (Opposite.op E) // m • s = 0},
        ∀ (Q Q' : (Y.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) (ψ : Q ⟶ Q') (f : wcEtExtZeroPre Y S m ⟶ Q),
          (ε Q' (f ≫ ψ)).1 = (ψ.app (Opposite.op E)).hom (ε Q f).1 := by
    classical
    intro Y S E hsub hiff
    let P := wcEtExtZeroPre Y S m
    have hES : ∀ x, E.hom x ∈ S := (hiff E).mp ⟨𝟙 E⟩
    have memP : ∀ (V : Y.Etale), (∀ x, V.hom x ∈ S) → ∀ (a : ULift.{u+1} (ZMod m)),
        a ∈ wcSuppSub.{u} m (∀ x, V.hom x ∈ S) :=
      fun V hV a => AddSubgroup.mem_iSup_of_mem hV (AddSubgroup.mem_top a)
    let one : P.obj (Opposite.op E) :=
      (⟨ULift.up 1, memP E hES _⟩ : wcSuppSub.{u} m (∀ x, E.hom x ∈ S))
    have hone : m • one = 0 := by
      apply Subtype.ext
      apply ULift.ext
      change (m • (1 : ZMod m)) = 0
      rw [nsmul_eq_mul, mul_one]
      exact ZMod.natCast_self m
    have zeroP : ∀ (V : Y.Etale), ¬ Nonempty (V ⟶ E) → ∀ x : P.obj (Opposite.op V), x = 0 := by
      intro V hV x
      have hn : ¬ ∀ y, V.hom y ∈ S := fun h => hV ((hiff V).mpr h)
      have hbot : wcSuppSub.{u} m (∀ y, V.hom y ∈ S) = ⊥ := iSup_neg hn
      exact Subtype.ext (AddSubgroup.mem_bot.mp (hbot.le x.2))
    have decomp : ∀ (V : Y.Etale) (ι : V ⟶ E) (x : P.obj (Opposite.op V)),
        x = ((x.1.down.cast : ℤ)) • (P.map ι.op).hom one := by
      intro V ι x
      apply Subtype.ext
      apply ULift.ext
      change x.1.down = ((x.1.down.cast : ℤ) • (1 : ZMod m))
      rw [zsmul_one, ZMod.intCast_zmod_cast]
    have uniq : ∀ (Q : (Y.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) (φ φ' : P ⟶ Q),
        (φ.app (Opposite.op E)).hom one = (φ'.app (Opposite.op E)).hom one → φ = φ' := by
      intro Q φ φ' h
      apply NatTrans.ext
      funext W
      obtain ⟨V⟩ := W
      apply AddCommGrpCat.hom_ext
      apply AddMonoidHom.ext
      intro x
      by_cases hW : Nonempty (V ⟶ E)
      · obtain ⟨ι⟩ := hW
        have e1 : (φ.app (Opposite.op V)).hom ((P.map ι.op).hom one) =
            (Q.map ι.op).hom ((φ.app (Opposite.op E)).hom one) :=
          congrArg (fun k : P.obj (Opposite.op E) ⟶ Q.obj (Opposite.op V) => k.hom one)
            (φ.naturality ι.op)
        have e2 : (φ'.app (Opposite.op V)).hom ((P.map ι.op).hom one) =
            (Q.map ι.op).hom ((φ'.app (Opposite.op E)).hom one) :=
          congrArg (fun k : P.obj (Opposite.op E) ⟶ Q.obj (Opposite.op V) => k.hom one)
            (φ'.naturality ι.op)
        rw [decomp V ι x, map_zsmul, map_zsmul, e1, e2, h]
      · rw [zeroP V hW x, map_zero, map_zero]
    have exist : ∀ (Q : (Y.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) (s : Q.obj (Opposite.op E)),
        m • s = 0 → ∃ β : P ⟶ Q, (β.app (Opposite.op E)).hom one = s := by
      intro Q s hs
      let t : ∀ V : Y.Etale, Q.obj (Opposite.op V) := fun V =>
        if h : Nonempty (V ⟶ E) then (Q.map h.some.op).hom s else 0
      have tpos : ∀ V (h : Nonempty (V ⟶ E)), t V = (Q.map h.some.op).hom s := fun V h => dif_pos h
      have tneg : ∀ V, ¬ Nonempty (V ⟶ E) → t V = 0 := fun V h => dif_neg h
      have ht : ∀ V, m • t V = 0 := by
        intro V
        by_cases h : Nonempty (V ⟶ E)
        · rw [tpos V h, ← map_nsmul, hs, map_zero]
        · rw [tneg V h, smul_zero]
      let F : ∀ V : Y.Etale, ZMod m →+ Q.obj (Opposite.op V) := fun V =>
        ZMod.lift m ⟨zmultiplesHom _ (t V), by rw [zmultiplesHom_apply, natCast_zsmul]; exact ht V⟩
      have Fval : ∀ (V : Y.Etale) (a : ZMod m), F V a = ((a.cast : ℤ)) • t V := by
        intro V a
        conv_lhs => rw [← ZMod.intCast_zmod_cast a]
        exact (ZMod.lift_coe m _ _).trans (zmultiplesHom_apply _ _ _)
      have F1 : ∀ V, F V 1 = t V := by
        intro V
        have h1 : (1 : ZMod m) = ((1 : ℤ) : ZMod m) := Int.cast_one.symm
        rw [h1]
        exact (ZMod.lift_coe m _ _).trans ((zmultiplesHom_apply _ _ _).trans (one_zsmul _))
      have htE : t E = s := by
        have hE1 : Nonempty (E ⟶ E) := ⟨𝟙 E⟩
        rw [tpos E hE1, @Subsingleton.elim _ (hsub E) hE1.some (𝟙 E), op_id, Q.map_id]
        rfl
      let β : P ⟶ Q :=
        { app := fun W => AddCommGrpCat.ofHom ((F W.unop).comp
            ((AddEquiv.ulift).toAddMonoidHom.comp (wcSuppSub.{u} m (∀ x, W.unop.hom x ∈ S)).subtype))
          naturality := by
            intro W W' f
            apply AddCommGrpCat.hom_ext
            apply AddMonoidHom.ext
            intro x
            show (F W'.unop) x.1.down = (Q.map f).hom ((F W.unop) x.1.down)
            by_cases h : Nonempty (W.unop ⟶ E)
            · have h' : Nonempty (W'.unop ⟶ E) := ⟨f.unop ≫ h.some⟩
              have htW' : t W'.unop = (Q.map f).hom (t W.unop) := by
                rw [tpos _ h', tpos _ h, @Subsingleton.elim _ (hsub _) h'.some (f.unop ≫ h.some),
                  op_comp, Functor.map_comp]
                rfl
              rw [Fval, Fval, htW', map_zsmul]
            · have hx0 : x.1.down = 0 :=
                congrArg (fun y : P.obj (Opposite.op W.unop) => y.1.down) (zeroP W.unop h x)
              rw [hx0]
              simp only [map_zero] }
      refine ⟨β, ?_⟩
      show F E (1 : ZMod m) = s
      rw [F1, htE]
    let fwd : ∀ Q : (Y.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1}, (P ⟶ Q) →
        {s : Q.obj (Opposite.op E) // m • s = 0} :=
      fun Q φ => ⟨(φ.app (Opposite.op E)).hom one, by rw [← map_nsmul, hone, map_zero]⟩
    refine ⟨fun Q => Equiv.ofBijective (fwd Q)
      ⟨fun φ φ' h => uniq Q φ φ' (congrArg Subtype.val h),
       fun ⟨s, hs⟩ => (exist Q s hs).elim fun β hβ => ⟨β, Subtype.ext hβ⟩⟩, ?_⟩
    intro Q Q' ψ f
    rfl

  haveI h1 : Limits.PreservesFiniteLimits (wcEtBaseChange p) := ⟨fun J _ _ =>
    haveI : Limits.PreservesLimitsOfShape J (wcEtBaseChange p ⋙ Scheme.Etale.forget Z) :=
      Limits.preservesLimitsOfShape_of_natIso
        (NatIso.ofComponents (fun _ => Iso.refl _) (fun _ => rfl) :
          Scheme.Etale.forget X ⋙ Over.pullback p ≅ wcEtBaseChange p ⋙ Scheme.Etale.forget Z)
    Limits.preservesLimitsOfShape_of_reflects_of_preserves (wcEtBaseChange p) (Scheme.Etale.forget Z)⟩
  haveI := flat_of_preservesFiniteLimits (wcEtBaseChange p)
  haveI hcont : (wcEtBaseChange p).IsContinuous (Scheme.smallEtaleTopology X)
      (Scheme.smallEtaleTopology Z) :=
    Functor.isContinuous_of_coverPreserving (compatiblePreservingOfFlat _ _) (hcov p)

  let e : wcEtPush p ≅ (wcEtBaseChange p).sheafPushforwardContinuous AddCommGrpCat.{u+1}
      (Scheme.smallEtaleTopology X) (Scheme.smallEtaleTopology Z) :=
    Functor.isoWhiskerRight ((wcEtBaseChange p).sheafPushforwardContinuousCompSheafToPresheafIso
      AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology X) (Scheme.smallEtaleTopology Z)).symm
      (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) ≪≫
    Functor.associator _ _ _ ≪≫
    Functor.isoWhiskerLeft _ (asIso (sheafificationAdjunction (Scheme.smallEtaleTopology X)
      AddCommGrpCat.{u+1}).counit) ≪≫
    Functor.rightUnitor _
  let sh := sheafificationAdjunction (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}
  let shZ := sheafificationAdjunction (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}
  let θ : ∀ K : Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1},
      (L.obj ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
        (wcEtExtZeroPre X T m)) ⟶ K) ≃ (wcEtExtZeroPre X T m ⟶ (wcEtBaseChange p).op ⋙ K.obj) :=
    fun K => ((adj.homEquiv _ K).trans ((Iso.refl _).homCongr (e.app K))).trans
      (sh.homEquiv (wcEtExtZeroPre X T m) _)
  have hθ : ∀ (K K' : Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) (ψ : K ⟶ K')
      (f : L.obj ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
        (wcEtExtZeroPre X T m)) ⟶ K),
      θ K' (f ≫ ψ) = θ K f ≫ Functor.whiskerLeft (wcEtBaseChange p).op ψ.hom := by
    intro K K' ψ f
    have a1 := adj.homEquiv_naturality_right f ψ
    have a2 := e.hom.naturality ψ
    have key : adj.homEquiv _ K' (f ≫ ψ) ≫ e.hom.app K' =
        (adj.homEquiv _ K f ≫ e.hom.app K) ≫
          ((wcEtBaseChange p).sheafPushforwardContinuous AddCommGrpCat.{u+1}
            (Scheme.smallEtaleTopology X) (Scheme.smallEtaleTopology Z)).map ψ := by
      rw [a1, Category.assoc, a2, Category.assoc]
    have a3 := sh.homEquiv_naturality_right (adj.homEquiv _ K f ≫ e.hom.app K)
      (((wcEtBaseChange p).sheafPushforwardContinuous AddCommGrpCat.{u+1}
            (Scheme.smallEtaleTopology X) (Scheme.smallEtaleTopology Z)).map ψ)
    exact (congrArg (sh.homEquiv (wcEtExtZeroPre X T m) _) key).trans a3

  let U : X.Opens := ⟨T, hT⟩
  let E : X.Etale := (wcZarToEt X).obj U
  let E' : Z.Etale := (wcEtBaseChange p).obj E
  haveI hE : IsOpenImmersion E.hom := show IsOpenImmersion U.ι from inferInstance
  haveI hE' : IsOpenImmersion E'.hom :=
    show IsOpenImmersion (Limits.pullback.snd U.ι p) from inferInstance
  have hR : Set.range E.hom = T := Scheme.Opens.range_ι U
  have hR' : Set.range E'.hom = p ⁻¹' T :=
    (Scheme.Pullback.range_snd U.ι p).trans (congrArg (fun S => p ⁻¹' S) (Scheme.Opens.range_ι U))
  have hsubX : ∀ V : X.Etale, Subsingleton (V ⟶ E) := fun V => (s3 X E hE V).1
  have hsubZ : ∀ V : Z.Etale, Subsingleton (V ⟶ E') := fun V => (s3 Z E' hE' V).1
  have hiffX : ∀ V : X.Etale, Nonempty (V ⟶ E) ↔ ∀ x, V.hom x ∈ T := fun V => by
    rw [← hR]; exact (s3 X E hE V).2
  have hiffZ : ∀ V : Z.Etale, Nonempty (V ⟶ E') ↔ ∀ x, V.hom x ∈ p ⁻¹' T := fun V => by
    rw [← hR']; exact (s3 Z E' hE' V).2
  obtain ⟨εX, hεX⟩ := s2 X T E hsubX hiffX
  obtain ⟨εZ, hεZ⟩ := s2 Z (p ⁻¹' T) E' hsubZ hiffZ

  let Θ : ∀ K : Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1},
      (L.obj (wcEtExtZero X T m) ⟶ K) ≃ (wcEtExtZero Z (p ⁻¹' T) m ⟶ K) :=
    fun K => (θ K).trans ((εX ((wcEtBaseChange p).op ⋙ K.obj)).trans ((εZ K.obj).symm.trans
      (shZ.homEquiv (wcEtExtZeroPre Z (p ⁻¹' T) m) K).symm))
  have hΘ : ∀ (K K' : Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1})
      (f : L.obj (wcEtExtZero X T m) ⟶ K) (ψ : K ⟶ K'), Θ K' (f ≫ ψ) = Θ K f ≫ ψ := by
    intro K K' f ψ
    have hval : (εX ((wcEtBaseChange p).op ⋙ K'.obj) (θ K' (f ≫ ψ))).1 =
        (ψ.hom.app (Opposite.op E')).hom (εX ((wcEtBaseChange p).op ⋙ K.obj) (θ K f)).1 :=
      (congrArg (fun g => (εX ((wcEtBaseChange p).op ⋙ K'.obj) g).1) (hθ K K' ψ f)).trans
        (hεX _ _ _ _)
    have hsym : (εZ K'.obj).symm (εX ((wcEtBaseChange p).op ⋙ K'.obj) (θ K' (f ≫ ψ))) =
        (εZ K.obj).symm (εX ((wcEtBaseChange p).op ⋙ K.obj) (θ K f)) ≫ ψ.hom := by
      apply (εZ K'.obj).injective
      refine (Equiv.apply_symm_apply _ _).trans ?_
      apply Subtype.ext
      refine hval.trans ?_
      refine Eq.trans ?_ (hεZ K.obj K'.obj ψ.hom _).symm
      exact congrArg (fun s => (ψ.hom.app (Opposite.op E')).hom s.1)
        (Equiv.apply_symm_apply (εZ K.obj) _).symm
    exact (congrArg (shZ.homEquiv (wcEtExtZeroPre Z (p ⁻¹' T) m) K').symm hsym).trans
      (shZ.homEquiv_naturality_right_symm _ ψ)

  refine ⟨{ hom := (Θ (wcEtExtZero Z (p ⁻¹' T) m)).symm (𝟙 _)
            inv := Θ (L.obj (wcEtExtZero X T m)) (𝟙 _)
            hom_inv_id := ?_
            inv_hom_id := ?_ }⟩
  · apply (Θ (L.obj (wcEtExtZero X T m))).injective
    rw [hΘ, Equiv.apply_symm_apply, Category.id_comp]
  · have := hΘ _ _ (𝟙 (L.obj (wcEtExtZero X T m))) ((Θ (wcEtExtZero Z (p ⁻¹' T) m)).symm (𝟙 _))
    rw [Category.id_comp, Equiv.apply_symm_apply] at this
    exact this.symm

theorem wc_et_locKill_proper_complement : ∀ (Y X' : Scheme.{u}) (b : X' ⟶ Y) [IsProper b] (S : Set Y), IsOpen S → ∀ m : ℕ, m ≠ 0 → (∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (X : Scheme.{u}) (f : X ⟶ Spec (.of A)) [IsProper f] (m' : ℕ), m' ≠ 0 → ∀ S : Set (Spec (.of A)), IsOpen S → S ≠ Set.univ → ∀ q : ℕ, Subsingleton (wcEtExt X (wcEtExtZero X (f ⁻¹' S) m') q)) → ∀ (I : InjectiveResolution (wcEtExtZero X' (b ⁻¹' S) m)) (q : ℕ), wcEtLocKill b I.cocomplex q (· ∉ S) :=
by
  intro Y X' b _ S hS m hm hPBC I q V c hc v hv

  obtain ⟨A, _, _, _, Λ, _, _, W, g, φ, ψ, hWaff, hg, hφ, hφψ, hψv, hlim⟩ :=
    wc_et_strict_henselization_prosystem V v

  let a : Spec (.of A) ⟶ Y := ψ ≫ V.hom
  have ha : ∀ l, φ l ≫ (W.obj l).hom = a := by
    intro l
    rw [← MorphismProperty.Over.w (g l), ← Category.assoc, hφψ l]

  have hpb : IsPullback (Limits.pullback.fst b a) (Limits.pullback.snd b a) b a :=
    IsPullback.of_hasPullback b a

  obtain ⟨L, ⟨adj⟩, -, -⟩ := wc_et_push_left_adjoint (Limits.pullback.fst b a)

  have hT : IsOpen (b ⁻¹' S) := hS.preimage b.continuous
  obtain ⟨e3⟩ := wc_et_pull_extZero_iso (Limits.pullback.fst b a) L ⟨adj⟩ (b ⁻¹' S) hT m

  have e2 : a (IsLocalRing.closedPoint A) = V.hom v :=
    (Scheme.Hom.comp_apply ψ V.hom (IsLocalRing.closedPoint A)).trans (congrArg V.hom hψv)
  have hSA : IsOpen (a ⁻¹' S) := hS.preimage a.continuous
  have hne : a ⁻¹' S ≠ Set.univ := by
    intro h
    have hmem : IsLocalRing.closedPoint A ∈ a ⁻¹' S := by rw [h]; trivial
    apply hv
    show V.hom v ∈ S
    rw [← e2]
    exact hmem
  have hset : Limits.pullback.snd b a ⁻¹' (a ⁻¹' S) =
      Limits.pullback.fst b a ⁻¹' (b ⁻¹' S) := by
    ext z
    have e1 : (Limits.pullback.fst b a ≫ b) z = (Limits.pullback.snd b a ≫ a) z := by
      rw [Limits.pullback.condition]
    rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at e1
    simp only [Set.mem_preimage]
    rw [e1]

  have hP : ∀ q', Subsingleton (wcEtExt (Limits.pullback b a)
      (wcEtExtZero (Limits.pullback b a) (Limits.pullback.fst b a ⁻¹' (b ⁻¹' S)) m) q') := by
    intro q'
    have h0 := hPBC A (Limits.pullback b a) (Limits.pullback.snd b a) m hm (a ⁻¹' S) hSA hne q'
    rw [hset] at h0
    exact h0

  have hvan : ∀ q', Subsingleton (wcEtExt (Limits.pullback b a)
      (L.obj (wcEtExtZero X' (b ⁻¹' S) m)) q') := by
    intro q'
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology (Limits.pullback b a)) AddCommGrpCat.{u+1}) :=
      HasExt.standard _
    let P := (constantSheaf (Scheme.smallEtaleTopology (Limits.pullback b a))
      AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))
    have h0 : Subsingleton (Abelian.Ext P (wcEtExtZero (Limits.pullback b a)
        (Limits.pullback.fst b a ⁻¹' (b ⁻¹' S)) m) q') := hP q'
    let E : Abelian.Ext P (L.obj (wcEtExtZero X' (b ⁻¹' S) m)) q' ≃
        Abelian.Ext P (wcEtExtZero (Limits.pullback b a)
          (Limits.pullback.fst b a ⁻¹' (b ⁻¹' S)) m) q' :=
      { toFun := fun x => x.comp (Abelian.Ext.mk₀ e3.hom) (add_zero q')
        invFun := fun y => y.comp (Abelian.Ext.mk₀ e3.inv) (add_zero q')
        left_inv := fun x => by
          simp only
          rw [Abelian.Ext.comp_assoc _ _ _ (add_zero q') (add_zero 0) (by omega),
            Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
        right_inv := fun y => by
          simp only
          rw [Abelian.Ext.comp_assoc _ _ _ (add_zero q') (add_zero 0) (by omega),
            Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.comp_mk₀_id] }
    change Subsingleton (Abelian.Ext P (L.obj (wcEtExtZero X' (b ⁻¹' S) m)) q')
    exact E.subsingleton

  obtain ⟨l₀⟩ := IsCofiltered.nonempty (C := Λ)
  have hnat := (I.cocomplex.d (q + 1) (q + 2)).hom.naturality ((wcEtBaseChange b).map (g l₀)).op
  have hnat' := congrArg (fun k => k.hom c) hnat
  simp only [AddCommGrpCat.hom_comp, AddMonoidHom.coe_comp, Function.comp_apply] at hnat'
  have hc₀ : ((I.cocomplex.d (q + 1) (q + 1 + 1)).hom.app
      (Opposite.op ((wcEtBaseChange b).obj (W.obj l₀)))).hom
      (((I.cocomplex.X (q + 1)).obj.map ((wcEtBaseChange b).map (g l₀)).op).hom c) = 0 := by
    change ((I.cocomplex.d (q + 1) (q + 2)).hom.app
      (Opposite.op ((wcEtBaseChange b).obj (W.obj l₀)))).hom
      (((I.cocomplex.X (q + 1)).obj.map ((wcEtBaseChange b).map (g l₀)).op).hom c) = 0
    rw [hnat', hc, map_zero]

  obtain ⟨l', t, e, he⟩ := wc_et_locKill_of_limit_vanishing b A Λ W φ a hWaff hφ ha hlim
    (Limits.pullback b a) (Limits.pullback.fst b a) (Limits.pullback.snd b a) hpb
    (wcEtExtZero X' (b ⁻¹' S) m) L ⟨adj⟩ hvan I (q + 1) l₀ _ hc₀

  refine ⟨W.obj l', g l', φ l' (IsLocalRing.closedPoint A), e, ?_, ?_⟩
  · exact (Scheme.Hom.comp_apply (φ l') (g l').left (IsLocalRing.closedPoint A)).symm.trans
      ((congrArg (fun k : Spec (.of A) ⟶ V.left => k (IsLocalRing.closedPoint A)) (hφψ l')).trans hψv)
  · change ((I.cocomplex.d (q + 1 - 1) (q + 1)).hom.app
      (Opposite.op ((wcEtBaseChange b).obj (W.obj l')))).hom e = _
    rw [he, ← hg t, CategoryTheory.Functor.map_comp, op_comp, CategoryTheory.Functor.map_comp]
    rfl

theorem wc_et_sheaf_exact_local : ∀ {X : Scheme.{u}} (K : CochainComplex (Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) ℕ) (q : ℕ), Limits.IsZero (K.homology (q + 1)) → ∀ (T : X.Etale) (c : (K.X (q + 1)).obj.obj (Opposite.op T)), ((K.d (q + 1) (q + 2)).hom.app (Opposite.op T)).hom c = 0 → ∀ t : T.left, ∃ (T' : X.Etale) (h : T' ⟶ T) (t' : T'.left) (e : (K.X q).obj.obj (Opposite.op T')), h.left t' = t ∧ ((K.d q (q + 1)).hom.app (Opposite.op T')).hom e = ((K.X (q + 1)).obj.map h.op).hom c :=
by
  intro X K q hK T c hc t
  have hSc : (K.sc' q (q + 1) (q + 2)).Exact :=
    (HomologicalComplex.exactAt_iff' K q (q + 1) (q + 2) (CochainComplex.prev_nat_succ q)
      (CochainComplex.next ℕ (q + 1))).mp
      ((HomologicalComplex.exactAt_iff_isZero_homology K (q + 1)).mpr hK)
  obtain ⟨κ, hκι, hκ⟩ : ∃ κ : K.X q ⟶ Limits.kernel (K.d (q + 1) (q + 2)),
      κ ≫ Limits.kernel.ι (K.d (q + 1) (q + 2)) = K.d q (q + 1) ∧ Epi κ :=
    ⟨_, Limits.kernel.lift_ι _ _ _, (K.sc' q (q + 1) (q + 2)).exact_iff_epi_kernel_lift.mp hSc⟩
  have hloc : Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology X) κ.hom :=
    (Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u+1} κ).mpr hκ
  let E := sheafToPresheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1} ⋙
    (evaluation _ _).obj (Opposite.op T)
  let y := (AddCommGrpCat.kernelIsoKer ((K.d (q + 1) (q + 2)).hom.app (Opposite.op T))).inv.hom
    ⟨c, hc⟩
  let s : (Limits.kernel (K.d (q + 1) (q + 2))).obj.obj (Opposite.op T) :=
    (Limits.PreservesKernel.iso E (K.d (q + 1) (q + 2))).inv.hom y
  have hs : ((Limits.kernel.ι (K.d (q + 1) (q + 2))).hom.app (Opposite.op T)).hom s = c := by
    have e1 := ConcreteCategory.congr_hom
      (Limits.PreservesKernel.iso_inv_ι E (K.d (q + 1) (q + 2))) y
    have e2 := ConcreteCategory.congr_hom
      (AddCommGrpCat.kernelIsoKer_inv_comp_ι ((K.d (q + 1) (q + 2)).hom.app (Opposite.op T)))
      (⟨c, hc⟩ : ((K.d (q + 1) (q + 2)).hom.app (Opposite.op T)).hom.ker)
    exact e1.trans e2
  have hR : Presheaf.imageSieve κ.hom s ∈ Scheme.smallGrothendieckTopology @Etale X T :=
    hloc.imageSieve_mem s
  have hpt := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale X
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ T _).mp
    ((@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale X
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl) ▸ hR)
  obtain ⟨T', h, t', hmem, -, ht'⟩ := hpt t
  obtain ⟨e, he⟩ := hmem
  refine ⟨T', h, t', e, ht', ?_⟩
  rw [← hκι, ObjectProperty.FullSubcategory.comp_hom, NatTrans.comp_app,
    ConcreteCategory.comp_apply, he, NatTrans.naturality_apply, hs]

theorem wc_et_proper_excision : ∀ (Y X' Z : Scheme.{u}) (b : X' ⟶ Y) [IsProper b] (iZ : Z ⟶ Y)
    [IsClosedImmersion iZ],
    (∀ U : Y.Opens, (U : Set Y) = (Set.range iZ)ᶜ → IsIso (b ∣_ U)) →
    ∀ m : ℕ, m ≠ 0 →
    (∀ (A : Type u) [CommRing A] [HenselianLocalRing A]
      [IsSepClosed (IsLocalRing.ResidueField A)] (X : Scheme.{u}) (f : X ⟶ Spec (.of A))
      [IsProper f] (m' : ℕ), m' ≠ 0 → ∀ S : Set (Spec (.of A)), IsOpen S → S ≠ Set.univ →
      ∀ q : ℕ, Subsingleton (wcEtExt X (wcEtExtZero X (f ⁻¹' S) m') q)) →
    ∀ q : ℕ, Nonempty (wcEtExt Y (wcEtExtZero Y (Set.range iZ)ᶜ m) q ≃
      wcEtExt X' (wcEtExtZero X' (Set.range (Limits.pullback.fst b iZ))ᶜ m) q) :=
by
  intro Y X' Z b _ iZ _ hiso m hm hPBC q
  have hS : IsOpen (Set.range iZ)ᶜ := iZ.isClosedEmbedding.isClosed_range.isOpen_compl
  have hS' : (Set.range (Limits.pullback.fst b iZ))ᶜ = b ⁻¹' (Set.range iZ)ᶜ := by
    rw [Scheme.Pullback.range_fst, Set.preimage_compl]
  rw [hS']
  generalize hSdef : (Set.range iZ)ᶜ = S at hS hiso ⊢
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology X') AddCommGrpCat.{u+1}) := HasExt.standard _
  haveI := wc_et_enough_injectives X'
  let G := wcEtExtZero X' (b ⁻¹' S) m
  let I : InjectiveResolution G := injectiveResolution G
  obtain ⟨L, ⟨adj⟩, hL, ⟨eL⟩⟩ := wc_et_push_left_adjoint b
  haveI := hL
  have hacyc : ∀ n : ℕ, 1 ≤ n → Limits.IsZero
      ((((wcEtPush b).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology n) := by
    intro n hn
    obtain ⟨n', rfl⟩ : ∃ n', n = n' + 1 := ⟨n - 1, by omega⟩
    apply wc_et_push_homology_zero_of_locKill b I.cocomplex n'
    intro V c hc v _
    by_cases hv : V.hom v ∈ S
    · exact wc_et_locKill_iso_locus Y X' b S hS hiso I.cocomplex n'
        (wc_et_sheaf_exact_local I.cocomplex n'
          ((HomologicalComplex.exactAt_iff_isZero_homology I.cocomplex (n' + 1)).mp
            (I.cocomplex_exactAt_succ n'))) V c hc v hv
    · exact wc_et_locKill_proper_complement Y X' b S hS m hm hPBC I n' V c hc v hv
  let PY := (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
    (AddCommGrpCat.of (ULift.{u+1} ℤ))
  let PX := (constantSheaf (Scheme.smallEtaleTopology X') AddCommGrpCat.{u+1}).obj
    (AddCommGrpCat.of (ULift.{u+1} ℤ))
  obtain ⟨E₂⟩ := wc_ext_degenerate_leray_equiv L (wcEtPush b) adj PY G I hacyc q
  obtain ⟨e4⟩ := wc_et_push_extZero_iso Y X' b S hS hiso m
  let E₁ : Abelian.Ext PY (wcEtExtZero Y S m) q ≃ Abelian.Ext PY ((wcEtPush b).obj G) q :=
    { toFun := fun x => x.comp (Abelian.Ext.mk₀ e4.inv) (add_zero q)
      invFun := fun y => y.comp (Abelian.Ext.mk₀ e4.hom) (add_zero q)
      left_inv := fun x => by
        simp only
        rw [Abelian.Ext.comp_assoc _ _ _ (add_zero q) (add_zero 0) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.comp_mk₀_id]
      right_inv := fun y => by
        simp only
        rw [Abelian.Ext.comp_assoc _ _ _ (add_zero q) (add_zero 0) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id] }
  let E₃ : Abelian.Ext (L.obj PY) G q ≃ Abelian.Ext PX G q :=
    { toFun := fun x => (Abelian.Ext.mk₀ eL.inv).comp x (zero_add q)
      invFun := fun y => (Abelian.Ext.mk₀ eL.hom).comp y (zero_add q)
      left_inv := fun x => by
        simp only
        rw [Abelian.Ext.mk₀_comp_mk₀_assoc, Iso.hom_inv_id, Abelian.Ext.mk₀_id_comp]
      right_inv := fun y => by
        simp only
        rw [Abelian.Ext.mk₀_comp_mk₀_assoc, Iso.inv_hom_id, Abelian.Ext.mk₀_id_comp] }
  change Nonempty (Abelian.Ext PY (wcEtExtZero Y S m) q ≃ Abelian.Ext PX G q)
  exact ⟨E₁.trans (E₂.trans E₃)⟩

theorem wc_et_abstract_blowup_finite : ∀ (Y X' Z : Scheme.{u}) (b : X' ⟶ Y) [IsProper b]
    (iZ : Z ⟶ Y) [IsClosedImmersion iZ],
    (∀ U : Y.Opens, (U : Set Y) = (Set.range iZ)ᶜ → IsIso (b ∣_ U)) →
    ∀ m : ℕ, m ≠ 0 →
    (∀ q : ℕ, Finite (wcEtCoh X' m q)) → (∀ q : ℕ, Finite (wcEtCoh Z m q)) →
    (∀ q : ℕ, Finite (wcEtCoh (Limits.pullback b iZ) m q)) →
    ∀ q : ℕ, Finite (wcEtCoh Y m q) :=
by
  intro Y X' Z b _ iZ _ hiso m hm hX hZ hE q
  classical

  have hmono : ∀ (W : Scheme.{u}) (S : Set W), Mono (wcEtExtZeroι W S m) := by
    intro W S
    let α : wcEtExtZeroPre W S m ⟶
        (Functor.const _).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))) :=
      { app := fun V => AddCommGrpCat.ofHom (wcSuppSub.{u} m (∀ x, V.unop.hom x ∈ S)).subtype
        naturality := fun _ _ _ => rfl }
    haveI : ∀ V, Mono (α.app V) := fun V =>
      (AddCommGrpCat.mono_iff_injective _).mpr (AddSubgroup.subtype_injective _)
    haveI : Mono α := NatTrans.mono_of_mono_app α
    exact Functor.map_mono (presheafToSheaf (Scheme.smallEtaleTopology W) AddCommGrpCat.{u+1}) α
  have hT : ∀ (W : Scheme.{u}) (S : Set W),
      (ShortComplex.mk (wcEtExtZeroι W S m) (Limits.cokernel.π _)
        (Limits.cokernel.condition _)).ShortExact := by
    intro W S
    haveI := hmono W S
    exact ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel _) inferInstance inferInstance
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology X') AddCommGrpCat.{u+1}) := HasExt.standard _

  have hQX' : ∀ n, Finite (wcEtExt X'
      (Limits.cokernel (wcEtExtZeroι X' (Set.range (Limits.pullback.fst b iZ))ᶜ m)) n) := by
    intro n
    obtain ⟨e⟩ := wc_et_closed_complement_coh X' (Limits.pullback b iZ)
      (Limits.pullback.fst b iZ) m n
    haveI := hE n
    exact Finite.of_equiv _ e.symm

  have hJ' : Finite (wcEtExt X'
      (wcEtExtZero X' (Set.range (Limits.pullback.fst b iZ))ᶜ m) q) := by
    let T := ShortComplex.mk (wcEtExtZeroι X' (Set.range (Limits.pullback.fst b iZ))ᶜ m)
      (Limits.cokernel.π _) (Limits.cokernel.condition _)
    have hTs : T.ShortExact := hT X' _
    let P := (constantSheaf (Scheme.smallEtaleTopology X') AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} ℤ))
    change Finite (Abelian.Ext P T.X₁ q)
    have h2 : Finite (Abelian.Ext P T.X₂ q) := hX q
    let φ : Abelian.Ext P T.X₁ q →+ Abelian.Ext P T.X₂ q :=
      (Abelian.Ext.mk₀ T.f).postcomp P (add_zero q)
    cases q with
    | zero =>
      refine Finite.of_injective φ ?_
      rw [injective_iff_map_eq_zero]
      intro x hx
      obtain ⟨g, rfl⟩ : ∃ g, Abelian.Ext.mk₀ g = x := ⟨_, Abelian.Ext.mk₀_homEquiv₀_apply x⟩
      have hx' : Abelian.Ext.mk₀ (g ≫ T.f) = Abelian.Ext.mk₀ 0 := by
        rw [← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_zero]
        exact hx
      rw [← Abelian.Ext.homEquiv₀_symm_apply, ← Abelian.Ext.homEquiv₀_symm_apply] at hx'
      have hg : g ≫ T.f = 0 := Abelian.Ext.homEquiv₀.symm.injective hx'
      haveI := hTs.mono_f
      rw [Limits.zero_of_comp_mono T.f hg, Abelian.Ext.mk₀_zero]
    | succ n₀ =>
      have h3 : Finite (Abelian.Ext P T.X₃ n₀) := hQX' n₀
      let δ : Abelian.Ext P T.X₃ n₀ →+ Abelian.Ext P T.X₁ (n₀ + 1) :=
        hTs.extClass.postcomp P rfl
      have hex : ∀ x, φ x = 0 → ∃ y, δ y = x := fun x hx =>
        Abelian.Ext.covariant_sequence_exact₁ P hTs x hx rfl
      haveI : Nonempty (Abelian.Ext P T.X₁ (n₀ + 1)) := ⟨0⟩
      let σ : Abelian.Ext P T.X₂ (n₀ + 1) → Abelian.Ext P T.X₁ (n₀ + 1) :=
        Function.invFun φ
      have hσ : ∀ x, φ (σ (φ x)) = φ x := fun x => Function.invFun_eq ⟨x, rfl⟩
      have hpre : ∀ x, ∃ y, δ y = x - σ (φ x) := fun x =>
        hex _ (by rw [map_sub, hσ, sub_self])
      choose τ hτ using hpre
      refine Finite.of_injective (fun x => (φ x, τ x)) ?_
      intro x x' hxx
      simp only [Prod.mk.injEq] at hxx
      obtain ⟨e1, e2⟩ := hxx
      have := hτ x
      rw [e2, hτ x', e1] at this
      exact (sub_left_inj.mp this).symm

  have hJ : Finite (wcEtExt Y (wcEtExtZero Y (Set.range iZ)ᶜ m) q) := by
    obtain ⟨e⟩ := wc_et_proper_excision Y X' Z b iZ hiso m hm
      wc_et_henselian_proper_vanishing q
    exact Finite.of_equiv _ e.symm

  have hQ : Finite (wcEtExt Y (Limits.cokernel (wcEtExtZeroι Y (Set.range iZ)ᶜ m)) q) := by
    obtain ⟨e⟩ := wc_et_closed_complement_coh Y Z iZ m q
    haveI := hZ q
    exact Finite.of_equiv _ e.symm

  let T := ShortComplex.mk (wcEtExtZeroι Y (Set.range iZ)ᶜ m)
    (Limits.cokernel.π _) (Limits.cokernel.condition _)
  have hTs : T.ShortExact := hT Y _
  let P := (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
    (AddCommGrpCat.of (ULift.{u+1} ℤ))
  change Finite (Abelian.Ext P T.X₂ q)
  have h1 : Finite (Abelian.Ext P T.X₁ q) := hJ
  have h3 : Finite (Abelian.Ext P T.X₃ q) := hQ
  let ψ : Abelian.Ext P T.X₂ q →+ Abelian.Ext P T.X₃ q :=
    (Abelian.Ext.mk₀ T.g).postcomp P (add_zero q)
  let φ : Abelian.Ext P T.X₁ q →+ Abelian.Ext P T.X₂ q :=
    (Abelian.Ext.mk₀ T.f).postcomp P (add_zero q)
  have hex : ∀ x, ψ x = 0 → ∃ a, φ a = x := fun x hx =>
    Abelian.Ext.covariant_sequence_exact₂ P hTs x hx
  haveI : Nonempty (Abelian.Ext P T.X₂ q) := ⟨0⟩
  let σ : Abelian.Ext P T.X₃ q → Abelian.Ext P T.X₂ q := Function.invFun ψ
  have hσ : ∀ x, ψ (σ (ψ x)) = ψ x := fun x => Function.invFun_eq ⟨x, rfl⟩
  have hpre : ∀ x, ∃ a, φ a = x - σ (ψ x) := fun x =>
    hex _ (by rw [map_sub, hσ, sub_self])
  choose τ hτ using hpre
  refine Finite.of_injective (fun x => (ψ x, τ x)) ?_
  intro x x' hxx
  simp only [Prod.mk.injEq] at hxx
  obtain ⟨e1, e2⟩ := hxx
  have := hτ x
  rw [e2, hτ x', e1] at this
  exact (sub_left_inj.mp this).symm

theorem wc_et_proper_curve_finite : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (C : Scheme.{u})
    (fC : C ⟶ Spec (.of Ω)) [IsProper fC] (ℓ : ℕ), ℓ.Prime → (ℓ : Ω) ≠ 0 →
    topologicalKrullDim C ≤ ((1 : ℕ) : WithBot ℕ∞) → ∀ q : ℕ, Finite (wcEtCoh C ℓ q) :=
by
  intro Ω _ _ C fC _ ℓ hℓ hℓΩ hC
  have hℓ0 : ℓ ≠ 0 := hℓ.ne_zero

  have s3 : ∀ x : WithBot ℕ∞, x ≤ ((1 : ℕ) : WithBot ℕ∞) → ¬ x ≤ ((0 : ℕ) : WithBot ℕ∞) →
      x = ((1 : ℕ) : WithBot ℕ∞) := by
    intro x h1 h0
    induction x using WithBot.recBotCoe with
    | bot => exact absurd bot_le h0
    | coe y =>
      induction y using ENat.recTopCoe with
      | top =>
        exfalso
        have : ((⊤ : ℕ∞) : WithBot ℕ∞) ≤ ((1 : ℕ∞) : WithBot ℕ∞) := by exact_mod_cast h1
        have h2 : (⊤ : ℕ∞) ≤ 1 := WithBot.coe_le_coe.mp this
        simp at h2
      | coe n =>
        have h1' : n ≤ 1 := by exact_mod_cast h1
        have h0' : ¬ n ≤ 0 := fun h => h0 (by exact_mod_cast h)
        have hn : n = 1 := by omega
        subst hn
        rfl

  have P0 : ∀ (n : ℕ) (W : Scheme.{u}) (fW : W ⟶ Spec (.of Ω)) [IsProper fW], Nat.card W = n →
      topologicalKrullDim W ≤ ((0 : ℕ) : WithBot ℕ∞) → ∀ q : ℕ, Finite (wcEtCoh W ℓ q) := by
    intro n
    induction n using Nat.strong_induction_on with
    | _ n IH =>
      intro W fW _ hn hW
      by_cases hE : IsEmpty W
      · exact wc_et_coh_empty_finite W hE ℓ
      · haveI : Nonempty W := not_isEmpty_iff.mp hE
        obtain ⟨k, _, iZ, X', b, hsep, hiZ, hb, hiso, hdisj, hdim, hcard⟩ :=
          wc_zero_dim_split_point Ω W fW hW inferInstance
        haveI := hsep
        haveI := hiZ
        haveI := hb
        refine wc_et_abstract_blowup_finite W X' (Spec (.of k)) b iZ hiso ℓ hℓ0 ?_ ?_ ?_
        · exact IH (Nat.card X') (by omega) X' (b ≫ fW) rfl hdim
        · exact wc_et_coh_sepClosed_point_finite k ℓ hℓ0
        · exact wc_et_coh_empty_finite _ (Scheme.isEmpty_pullback b iZ hdisj) ℓ

  have P1 : ∀ (n : ℕ) (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω)) [IsProper fX],
      (irreducibleComponents X).ncard = n →
      (∀ x : X, IsDomain (X.presheaf.stalk x) ∧ IsIntegrallyClosed (X.presheaf.stalk x)) →
      topologicalKrullDim X ≤ ((1 : ℕ) : WithBot ℕ∞) → ∀ q : ℕ, Finite (wcEtCoh X ℓ q) := by
    intro n
    induction n using Nat.strong_induction_on with
    | _ n IH =>
      intro X fX _ hn hnorm hX
      by_cases hE : IsEmpty X
      · exact wc_et_coh_empty_finite X hE ℓ
      · haveI : Nonempty X := not_isEmpty_iff.mp hE
        obtain ⟨Z, iZ, X', b, hiZ, hb, hiso, hdisj, hirr, hnZ, hnX', hdZ, hdX', hcard⟩ :=
          wc_normal_split_component Ω X fX hnorm inferInstance
        haveI := hiZ
        haveI := hb
        refine wc_et_abstract_blowup_finite X X' Z b iZ hiso ℓ hℓ0 ?_ ?_ ?_
        · exact IH _ (by omega) X' (b ≫ fX) rfl hnX' (hdX'.trans hX)
        · by_cases h0 : topologicalKrullDim Z ≤ ((0 : ℕ) : WithBot ℕ∞)
          · exact P0 _ Z (iZ ≫ fX) rfl h0
          · have h1 : topologicalKrullDim Z = ((1 : ℕ) : WithBot ℕ∞) := s3 _ (hdZ.trans hX) h0
            exact wc_et_normal_irreducible_curve_finite Ω Z (iZ ≫ fX) hirr hnZ h1 ℓ hℓ hℓΩ
        · exact wc_et_coh_empty_finite _ (Scheme.isEmpty_pullback b iZ hdisj) ℓ

  have G2 : ∀ (R : Scheme.{u}) (fR : R ⟶ Spec (.of Ω)) [IsProper fR] [IsReduced R],
      topologicalKrullDim R ≤ ((1 : ℕ) : WithBot ℕ∞) → ∀ q : ℕ, Finite (wcEtCoh R ℓ q) := by
    intro R fR _ _ hR
    obtain ⟨X', b, Z, iZ, hb, hiZ, hiso, hn, hdX', hdZ, hdE⟩ :=
      wc_reduced_curve_normalization Ω R fR hR
    haveI := hb
    haveI := hiZ
    refine wc_et_abstract_blowup_finite R X' Z b iZ hiso ℓ hℓ0 ?_ ?_ ?_
    · exact P1 _ X' (b ≫ fR) rfl hn hdX'
    · exact P0 _ Z (iZ ≫ fR) rfl hdZ
    · exact P0 _ (Limits.pullback b iZ) (Limits.pullback.snd b iZ ≫ iZ ≫ fR) rfl hdE

  obtain ⟨R, r, hr, hsurj, hred⟩ := wc_reduced_subscheme_exists C
  haveI := hr
  haveI := hred
  have hdimR : topologicalKrullDim R = topologicalKrullDim C :=
    IsHomeomorph.topologicalKrullDim_eq r (isHomeomorph_iff_isEmbedding_surjective.mpr
      ⟨r.isClosedEmbedding.isEmbedding, Set.range_eq_univ.mp hsurj⟩)
  have hFR := G2 R (r ≫ fC) (by rw [hdimR]; exact hC)
  refine wc_et_abstract_blowup_finite C _ R (Scheme.emptyTo C) r ?_ ℓ hℓ0 ?_ hFR ?_
  · intro U hU
    have hU' : (U : Set C) = ∅ := by rw [hU, hsurj, Set.compl_univ]
    haveI : IsEmpty ↥(U : Scheme.{u}) := ⟨fun x => by
      have hx : U.ι x ∈ Set.range U.ι := ⟨x, rfl⟩
      rw [Scheme.Opens.range_ι, hU'] at hx
      exact hx⟩
    exact isIso_of_isEmpty (Scheme.emptyTo C ∣_ U)
  · exact wc_et_coh_empty_finite _ inferInstance ℓ
  · exact wc_et_coh_empty_finite _ (Scheme.isEmpty_pullback _ r
      (by rw [Set.range_eq_empty]; exact Set.empty_disjoint _)) ℓ

theorem wc_proj_space_isProper : ∀ (K : Type u) [Field K] (n : ℕ), IsProper (wcProjKStr K n) :=
by
  intro K _ n
  letI := @MvPolynomial.gradedAlgebra (Fin (n+1)) K _
  letI : IsScalarTower K ((MvPolynomial.homogeneousSubmodule (Fin (n+1)) K) 0)
      (MvPolynomial (Fin (n+1)) K) :=
    IsScalarTower.of_algebraMap_eq (R := K)
      (S := (MvPolynomial.homogeneousSubmodule (Fin (n+1)) K) 0)
      (A := MvPolynomial (Fin (n+1)) K) (fun r => rfl)
  haveI : Algebra.FiniteType ((MvPolynomial.homogeneousSubmodule (Fin (n+1)) K) 0)
      (MvPolynomial (Fin (n+1)) K) :=
    Algebra.FiniteType.of_restrictScalars_finiteType K _ _
  haveI : IsProper (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (n+1)) K)) :=
    inferInstance
  have hbij : Function.Bijective
      (algebraMap K ((MvPolynomial.homogeneousSubmodule (Fin (n+1)) K) 0)) := by
    constructor
    · intro a b hab
      have h := congrArg (fun x : (MvPolynomial.homogeneousSubmodule (Fin (n+1)) K) 0 =>
        (x : MvPolynomial (Fin (n+1)) K)) hab
      simp only [SetLike.GradeZero.coe_algebraMap, MvPolynomial.algebraMap_eq] at h
      exact MvPolynomial.C_injective _ _ h
    · intro x
      have hx : (x : MvPolynomial (Fin (n+1)) K).IsHomogeneous 0 :=
        (MvPolynomial.mem_homogeneousSubmodule 0 _).mp x.2
      have ht : (x : MvPolynomial (Fin (n+1)) K).totalDegree = 0 :=
        Nat.le_zero.mp hx.totalDegree_le
      refine ⟨(x : MvPolynomial (Fin (n+1)) K).coeff 0, Subtype.ext ?_⟩
      simp only [SetLike.GradeZero.coe_algebraMap, MvPolynomial.algebraMap_eq]
      exact ((MvPolynomial.totalDegree_eq_zero_iff_eq_C).mp ht).symm
  haveI : IsIso (CommRingCat.ofHom
      (algebraMap K ((MvPolynomial.homogeneousSubmodule (Fin (n+1)) K) 0))) := by
    rw [ConcreteCategory.isIso_iff_bijective]
    exact hbij
  show IsProper (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (n+1)) K) ≫
    Spec.map (CommRingCat.ofHom
      (algebraMap K ((MvPolynomial.homogeneousSubmodule (Fin (n+1)) K) 0))))
  infer_instance

theorem wc_projK_coords : ∀ (K : Type u) [Field K] (N : ℕ), ∃ (C : Fin (N + 1) → (wcProjK K N).Opens) (e : ∀ J L : Fin (N + 1), Γ(wcProjK K N, C J)), (⨆ J, C J) = ⊤ ∧ (∀ J, IsAffineOpen (C J)) ∧ (∀ J L, (wcProjK K N).basicOpen (e J L) = C J ⊓ C L) ∧ ∀ (V : Scheme.{u}) (fV : V ⟶ Spec (.of K)) (s : Fin (N + 1) → Γ(V, ⊤)), Ideal.span (Set.range s) = ⊤ → ∃ φ : V ⟶ wcProjK K N, φ ≫ wcProjKStr K N = fV ∧ (∀ J, φ ⁻¹ᵁ C J = V.basicOpen (s J)) ∧ ∀ J L, φ.app (C J) (e J L) * V.presheaf.map (homOfLE (le_top : φ ⁻¹ᵁ C J ≤ ⊤)).op (s J) = V.presheaf.map (homOfLE (le_top : φ ⁻¹ᵁ C J ≤ ⊤)).op (s L) :=
by

  have s3a : ∀ (X : Scheme.{u}) (r a : Γ(X, ⊤)), ((X.isoOfEq (X.toSpecΓ_preimage_basicOpen r)).inv ≫ X.toSpecΓ ∣_ PrimeSpectrum.basicOpen r ≫ (basicOpenIsoSpecAway r).hom).appTop ((Scheme.ΓSpecIso (.of (Localization.Away r))).inv (algebraMap Γ(X, ⊤) (Localization.Away r) a)) = (X.basicOpen r).ι.appTop a := by
    intro X r a
    have h1 : ((X.isoOfEq (X.toSpecΓ_preimage_basicOpen r)).inv ≫ X.toSpecΓ ∣_ PrimeSpectrum.basicOpen r ≫ (basicOpenIsoSpecAway r).hom) ≫ Spec.map (CommRingCat.ofHom (algebraMap Γ(X, ⊤) (Localization.Away r))) = (X.basicOpen r).ι ≫ X.toSpecΓ := by
      have hm := morphismRestrict_ι X.toSpecΓ (PrimeSpectrum.basicOpen r)
      rw [Category.assoc, Category.assoc, basicOpenIsoSpecAway_hom_SpecMap, hm, ← Category.assoc,
        Scheme.isoOfEq_inv_ι]
    have h2 := congrArg Scheme.Hom.appTop h1
    rw [Scheme.Hom.comp_appTop _ (Spec.map _), Scheme.Hom.comp_appTop (X.basicOpen r).ι,
      Scheme.toSpecΓ_appTop] at h2
    have h3 := Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom (algebraMap Γ(X, ⊤) (Localization.Away r)))
    calc _ = (CommRingCat.ofHom (algebraMap Γ(X, ⊤) (Localization.Away r)) ≫ (Scheme.ΓSpecIso (.of (Localization.Away r))).inv ≫ ((X.isoOfEq (X.toSpecΓ_preimage_basicOpen r)).inv ≫ X.toSpecΓ ∣_ PrimeSpectrum.basicOpen r ≫ (basicOpenIsoSpecAway r).hom).appTop) a := rfl
      _ = ((Scheme.ΓSpecIso Γ(X, ⊤)).inv ≫ (Spec.map (CommRingCat.ofHom (algebraMap Γ(X, ⊤) (Localization.Away r)))).appTop ≫ ((X.isoOfEq (X.toSpecΓ_preimage_basicOpen r)).inv ≫ X.toSpecΓ ∣_ PrimeSpectrum.basicOpen r ≫ (basicOpenIsoSpecAway r).hom).appTop) a := by
        rw [← Category.assoc, h3, Category.assoc]; rfl
      _ = ((Scheme.ΓSpecIso Γ(X, ⊤)).inv ≫ (Scheme.ΓSpecIso Γ(X, ⊤)).hom ≫ (X.basicOpen r).ι.appTop) a := by
        rw [h2]
      _ = _ := by rw [Iso.inv_hom_id_assoc]

  have s2 : ∀ {σ A : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A] (𝒜 : ℕ → σ) [GradedRing 𝒜] {f g : A} {d e : ℕ} (hf : f ∈ 𝒜 d) (hg : g ∈ 𝒜 e), 0 < d → 0 < e → (Proj 𝒜).basicOpen ((Proj.awayToSection 𝒜 f).hom (HomogeneousLocalization.Away.isLocalizationElem hf hg)) = Proj.basicOpen 𝒜 f ⊓ Proj.basicOpen 𝒜 g := by
    intro σ A _ _ _ 𝒜 _ f g d e hf hg hd he
    have hβ : (Proj.basicOpenToSpec 𝒜 f).app ⊤ ((Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away 𝒜 f))).inv (HomogeneousLocalization.Away.isLocalizationElem hf hg)) = (Proj.basicOpen 𝒜 f).topIso.inv ((Proj.awayToSection 𝒜 f).hom (HomogeneousLocalization.Away.isLocalizationElem hf hg)) := by
      have hh := Proj.basicOpenToSpec_app_top 𝒜 f
      calc _ = ((Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away 𝒜 f))).hom ≫ Proj.awayToSection 𝒜 f ≫ (Proj.basicOpen 𝒜 f).topIso.inv) ((Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away 𝒜 f))).inv (HomogeneousLocalization.Away.isLocalizationElem hf hg)) := by rw [← hh]; rfl
        _ = (Proj.basicOpen 𝒜 f).topIso.inv (Proj.awayToSection 𝒜 f ((Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away 𝒜 f))).hom ((Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away 𝒜 f))).inv (HomogeneousLocalization.Away.isLocalizationElem hf hg)))) := rfl
        _ = _ := by rw [Iso.inv_hom_id_apply]
    have h3 : (Proj.basicOpen 𝒜 f : Scheme).basicOpen ((Proj.basicOpen 𝒜 f).topIso.inv ((Proj.awayToSection 𝒜 f).hom (HomogeneousLocalization.Away.isLocalizationElem hf hg))) = Proj.basicOpenToSpec 𝒜 f ⁻¹ᵁ PrimeSpectrum.basicOpen (HomogeneousLocalization.Away.isLocalizationElem hf hg) := by
      have hp := Scheme.preimage_basicOpen (Proj.basicOpenToSpec 𝒜 f) ((Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away 𝒜 f))).inv (HomogeneousLocalization.Away.isLocalizationElem hf hg))
      rw [basicOpen_eq_of_affine] at hp
      rw [hp, ← hβ]
      rfl
    have h4 : Proj.basicOpenToSpec 𝒜 f ⁻¹ᵁ PrimeSpectrum.basicOpen (HomogeneousLocalization.Away.isLocalizationElem hf hg) = (Proj.basicOpen 𝒜 f).ι ⁻¹ᵁ Proj.basicOpen 𝒜 g := by
      rw [← Proj.awayι_preimage_basicOpen 𝒜 hf hd hg he, ← Proj.basicOpenIsoSpec_inv_ι 𝒜 f hf hd,
        ← Scheme.Hom.comp_preimage, ← Proj.basicOpenIsoSpec_hom 𝒜 f hf hd, ← Category.assoc,
        Iso.hom_inv_id, Category.id_comp]
    rw [← Scheme.Opens.ι_image_basicOpen_topIso_inv, h3, h4, Scheme.Hom.image_preimage_eq_opensRange_inf,
      Scheme.Opens.opensRange_ι]

  have s3 : ∀ {σ A : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A] (𝒜 : ℕ → σ) [GradedRing 𝒜] (X : Scheme.{u}) (f : A →+* Γ(X, ⊤)) (hf : (HomogeneousIdeal.irrelevant 𝒜).toIdeal.map f = ⊤) {t : A} {d : ℕ} (hd : 0 < d) (ht : t ∈ 𝒜 d) (n : ℕ) (y : A) (hy : y ∈ 𝒜 (n • d)), (Proj.fromOfGlobalSections 𝒜 f hf).app (Proj.basicOpen 𝒜 t) ((Proj.awayToSection 𝒜 t).hom (HomogeneousLocalization.Away.mk 𝒜 ht n y hy)) * X.presheaf.map (homOfLE (le_top : Proj.fromOfGlobalSections 𝒜 f hf ⁻¹ᵁ Proj.basicOpen 𝒜 t ≤ ⊤)).op (f t) ^ n = X.presheaf.map (homOfLE (le_top : Proj.fromOfGlobalSections 𝒜 f hf ⁻¹ᵁ Proj.basicOpen 𝒜 t ≤ ⊤)).op (f y) := by
    intro σ A _ _ _ 𝒜 _ X f hf t d hd ht n y hy
    have key : ∀ {U V : Scheme.{u}} {R L : CommRingCat.{u}} (W : V ⟶ Spec L) (φ₀ : R ⟶ L) (i : U ≅ Spec R) (T : V ⟶ U), T = (W ≫ Spec.map φ₀) ≫ i.inv → ∀ x : R, T.appTop (i.hom.appTop ((Scheme.ΓSpecIso R).inv x)) = W.appTop ((Scheme.ΓSpecIso L).inv (φ₀ x)) := by
