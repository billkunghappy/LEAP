  let φ : StructuredArrow.mk (Over.homMk t ht : X₀ ⟶ (Scheme.Etale.forget B).obj V) ⟶ A₀ :=
    StructuredArrow.homMk e hw
  refine ⟨V, t, ht, fun x => (F.obj.map e.op).hom (σ₀ x), ?_, ?_, hfib⟩
  · intro x
