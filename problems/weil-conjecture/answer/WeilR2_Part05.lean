  let A : ℕ → (Fin N → ZMod ℓ) →
      Set (Limits.widePullback B (fun _ : Fin N => Z) (fun _ => p) : Scheme.{u}) := fun n c =>
    {y : (Limits.widePullback B (fun _ : Fin N => Z) (fun _ => p) : Scheme.{u}) | ∀ (V : B.Etale) (f : LocallyConstant ((wcEtBaseChange p).obj V).left (ZMod ℓ)), f ∈ I n V → ∀ y' : (Limits.pullback (C := Scheme.{u}) V.hom (Limits.WidePullback.base (fun _ : Fin N => p))), Limits.pullback.snd V.hom (Limits.WidePullback.base (fun _ : Fin N => p)) y' = y → ∑ i : Fin N, c i * f (Limits.pullback.map V.hom (Limits.WidePullback.base (fun _ : Fin N => p)) V.hom p (𝟙 _) (Limits.WidePullback.π (fun _ : Fin N => p) i) (𝟙 B) ((Category.comp_id _).trans (Category.id_comp _).symm) ((Category.comp_id _).trans (Limits.WidePullback.π_arrow (fun _ : Fin N => p) i).symm) y') = 0}
