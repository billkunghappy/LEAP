  have hmem : e V s ∈ I m V := (hI m V _).2 ⟨t, by rw [AddEquiv.symm_apply_apply]; exact ht⟩
  obtain ⟨t', ht'⟩ := (hI _ V _).1 (h7 V hmem)
  exact ⟨t', by rw [ht', AddEquiv.symm_apply_apply]⟩

theorem wc_et_noetherian_torsion_embedding : ∀ (K : Type u) [Field K] (B : Scheme.{u}) (fB : B ⟶ Spec (.of K)) [IsProper fB] (ℓ : ℕ), ℓ.Prime → ∀ (F : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}), IsNoetherianObject F → (ℓ : ℤ) • 𝟙 F = 0 → ∃ (G : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}) (ι : F ⟶ G) (r : ℕ) (B' : Fin r → Scheme.{u}) (π : ∀ i, B' i ⟶ B) (pr : ∀ i, G ⟶ (wcEtPush (π i)).obj ((constantSheaf (Scheme.smallEtaleTopology (B' i)) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))))) (ι' : ∀ i, (wcEtPush (π i)).obj ((constantSheaf (Scheme.smallEtaleTopology (B' i)) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))) ⟶ G), Mono ι ∧ (∀ i, IsFinite (π i)) ∧ ∑ i, pr i ≫ ι' i = 𝟙 G ∧ IsNoetherianObject (Limits.cokernel ι) ∧ (ℓ : ℤ) • 𝟙 (Limits.cokernel ι) = 0 :=
by
  intro K _ B fB _ ℓ hℓ F hFn hFt
  classical

  have tnat : ∀ {A A' : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}} (φ : A ⟶ A')
      {V W : B.Etale} (f : W ⟶ V) (x : A.obj.obj (Opposite.op V)),
      (A'.obj.map f.op).hom ((φ.hom.app (Opposite.op V)).hom x) =
        (φ.hom.app (Opposite.op W)).hom ((A.obj.map f.op).hom x) := by
    intro A A' φ V W f x
    rw [← AddCommGrpCat.comp_apply, ← φ.hom.naturality, AddCommGrpCat.comp_apply]
  have tcomp : ∀ {A A' A'' : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}} (φ : A ⟶ A')
      (χ : A' ⟶ A'') (V : B.Etale) (x : A.obj.obj (Opposite.op V)),
      ((φ ≫ χ).hom.app (Opposite.op V)).hom x =
        (χ.hom.app (Opposite.op V)).hom ((φ.hom.app (Opposite.op V)).hom x) :=
    fun _ _ _ _ => rfl
  have tzero : ∀ {A A' : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}} (V : B.Etale)
      (x : A.obj.obj (Opposite.op V)), (((0 : A ⟶ A')).hom.app (Opposite.op V)).hom x = 0 :=
    fun _ _ => rfl
  have text : ∀ {A A' : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}} (g : A ⟶ A'),
