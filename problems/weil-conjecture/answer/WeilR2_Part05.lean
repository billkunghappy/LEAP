    intro Y p _ t₀ ht₀
    have hv : p (t₀ (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField η)))) = η :=
      (Scheme.Hom.comp_apply t₀ p _).symm.trans
        ((congrArg (fun f : Spec (.of (AlgebraicClosure (B.residueField η))) ⟶ B =>
          f (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField η)))) ht₀).trans hgp)
    obtain ⟨U, hvU, hU⟩ := H3 p (t₀ (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField η))))
