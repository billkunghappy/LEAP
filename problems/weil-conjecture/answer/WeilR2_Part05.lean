    exact ⟨K, inferInstance, inferInstance, Spec.map χ ≫ X.fromSpecResidueField x, key _⟩
  obtain ⟨Ω, _, _, vb, hvb⟩ := hpt V.left v
  haveI := wc_finite_geom_fibre_finite p Ω (vb ≫ V.hom)
  obtain ⟨M, hM⟩ := wc_fnp_germ_subgroup p ℓ I' hstab Ω (vb ≫ V.hom)
  let w : {zb : Spec (.of Ω) ⟶ Z // zb ≫ p = vb ≫ V.hom} → ZMod ℓ := fun zb =>
