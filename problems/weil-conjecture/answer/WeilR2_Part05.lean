  exact ⟨ShortComplex.mk _ _ w, s5 ι p inferInstance hfg hsurj hex w, ⟨Iso.refl _⟩,
    ⟨Iso.refl _⟩, ⟨Iso.refl _⟩⟩

theorem wc_gal_desc_trivial_iso {X' E : Scheme.{u}} (Y' : X'.Opens) (ρ : E ⟶ (Y' : Scheme.{u}))
    (H : Type u) [Group H] (β : H →* Aut E) (hρ : wcGalCover ρ H β)
    (hβ : ∀ x, (β x).hom ≫ ρ ≫ Y'.ι = ρ ≫ Y'.ι) (ℓ : ℕ) :
    Nonempty (wcGalDesc (ρ ≫ Y'.ι) (Y' : Set X') H β hβ (ULift.{u+1} (ZMod ℓ)) 1 ⊤ ≅
      wcEtExtZero X' (Y' : Set X') ℓ) :=
by

  have hcov : ∀ (V : X'.Etale) (R : Sieve V), (∀ v : V.left, ∃ (V₁ : X'.Etale)
      (c : V₁ ⟶ V), R.arrows c ∧ v ∈ Set.range c.left) → R ∈ Scheme.smallEtaleTopology X' V := by
    intro V R hR
    change R ∈ Scheme.smallGrothendieckTopology @Etale X' V
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale X'
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
    apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale X'
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
    intro x
    obtain ⟨V₁, c, hc, y, hy⟩ := hR x
    have hw : c.left ≫ V.hom = V₁.hom := MorphismProperty.Over.w c
    have hEt : Etale c.left := by
      have h1 : Etale V.hom := V.prop
      have h2 : Etale (c.left ≫ V.hom) := by rw [hw]; exact V₁.prop
      exact Etale.of_comp c.left V.hom
    exact ⟨V₁, c, y, hc, hEt, hy⟩

  have supBot : ∀ (p : Prop), ¬ p → ∀ a : wcSuppSub.{u} ℓ p, a = 0 := by
    intro p hp a
    apply Subtype.ext
    have h2 : wcSuppSub.{u} ℓ p = ⊥ :=
      (iSup_neg hp : (⨆ _ : p, (⊤ : AddSubgroup (ULift.{u+1} (ZMod ℓ)))) = ⊥)
    have h3 : (a : ULift.{u+1} (ZMod ℓ)) ∈ (⊥ : AddSubgroup (ULift.{u+1} (ZMod ℓ))) := h2 ▸ a.2
    exact AddSubgroup.mem_bot.mp h3
  have supTop : ∀ (p : Prop), p → ∀ y : ULift.{u+1} (ZMod ℓ), y ∈ wcSuppSub.{u} ℓ p := by
    intro p hp y
    exact AddSubgroup.mem_iSup_of_mem hp (AddSubgroup.mem_top y)

  have hpto : ∀ (V : X'.Etale) (v : V.left), V.hom v ∈ (Y' : Set X') →
      ∃ z : ((wcEtBaseChange (ρ ≫ Y'.ι)).obj V).left,
        Limits.pullback.fst V.hom (ρ ≫ Y'.ι) z = v := by
    intro V v hv
    obtain ⟨e, he⟩ := hρ.2.2.2.1.surj (⟨V.hom v, hv⟩ : (Y' : Scheme.{u}))
    obtain ⟨z, hz1, _⟩ := Scheme.Pullback.exists_preimage_pullback (f := V.hom)
      (g := ρ ≫ Y'.ι) v e (by rw [Scheme.Hom.comp_apply, he, Scheme.Opens.ι_apply])
    exact ⟨z, hz1⟩

  have crux : ∀ {P B : Scheme.{u}} (a : P ⟶ B) (b : P ⟶ E) (t : B ⟶ X'), a ≫ t = b ≫ ρ ≫ Y'.ι →
      (∀ {T : Scheme.{u}} (g₁ g₂ : T ⟶ P), g₁ ≫ a = g₂ ≫ a → g₁ ≫ b = g₂ ≫ b → g₁ = g₂) →
      ∀ (τ : H → (P ⟶ P)), (∀ x, τ x ≫ a = a) → (∀ x, τ x ≫ b = b ≫ (β x).hom) →
      ∀ (φ : P → ULift.{u+1} (ZMod ℓ)), (∀ x y, φ (τ x y) = φ y) →
      ∀ z₁ z₂, a z₁ = a z₂ → φ z₁ = φ z₂ := by
    intro P B a b t hab hext τ hτa hτb φ hφ z₁ z₂ hz
    obtain ⟨_, _, _, _, hα, hiso⟩ := hρ
    obtain ⟨q, hq1, hq2⟩ := Scheme.Pullback.exists_preimage_pullback (f := a) (g := a) z₁ z₂ hz
    have hQ : Limits.pullback.fst a a ≫ a = Limits.pullback.snd a a ≫ a :=
      Limits.pullback.condition
    have w : (Limits.pullback.fst a a ≫ b) ≫ ρ = (Limits.pullback.snd a a ≫ b) ≫ ρ := by
      rw [← cancel_mono Y'.ι]
      simp only [Category.assoc]
      rw [← hab, reassoc_of% hQ]
    obtain ⟨m, hm1, hm2⟩ : ∃ m : Limits.pullback a a ⟶ Limits.pullback ρ ρ,
        m ≫ Limits.pullback.fst ρ ρ = Limits.pullback.fst a a ≫ b ∧
        m ≫ Limits.pullback.snd ρ ρ = Limits.pullback.snd a a ≫ b :=
      ⟨Limits.pullback.lift _ _ w, Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
    let Φ : ∐ (fun _ : H => E) ⟶ Limits.pullback ρ ρ := Limits.Sigma.desc (fun γ : H =>
      Limits.pullback.lift (β γ).hom (𝟙 E) ((hα γ).trans (Category.id_comp ρ).symm))
    haveI : IsIso Φ := hiso
    obtain ⟨pt, hpt⟩ : ∃ pt, Φ pt = m q := ⟨_, Scheme.inv_hom_apply (asIso Φ) (m q)⟩
    obtain ⟨h, e, hs⟩ : ∃ (h : H) (e : E), Limits.Sigma.ι (fun _ : H => E) h e = pt :=
      ⟨((sigmaMk (fun _ : H => E)).symm pt).1, ((sigmaMk (fun _ : H => E)).symm pt).2,
        (sigmaMk_mk (fun _ : H => E) _ _).symm.trans
          ((sigmaMk (fun _ : H => E)).apply_symm_apply pt)⟩
    have hmq : m q = Limits.pullback.lift (β h).hom (𝟙 E)
        ((hα h).trans (Category.id_comp ρ).symm) e := by
      calc m q = Φ (Limits.Sigma.ι (fun _ : H => E) h e) := by rw [hs, hpt]
        _ = (Limits.Sigma.ι (fun _ : H => E) h ≫ Φ) e := (Scheme.Hom.comp_apply _ _ e).symm
        _ = _ := congrArg (fun g : E ⟶ Limits.pullback ρ ρ => g e)
          (Limits.Sigma.ι_comp_desc (fun γ : H => Limits.pullback.lift (β γ).hom (𝟙 E)
            ((hα γ).trans (Category.id_comp ρ).symm)) h)
    obtain ⟨g, hg1, hg2, hmq'⟩ : ∃ g : E ⟶ Limits.pullback ρ ρ,
        g ≫ Limits.pullback.fst ρ ρ = (β h).hom ∧ g ≫ Limits.pullback.snd ρ ρ = 𝟙 E ∧
        m q = g e :=
      ⟨Limits.pullback.lift (β h).hom (𝟙 E) ((hα h).trans (Category.id_comp ρ).symm),
        Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _, hmq⟩
    obtain ⟨y, hy1, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := m) (g := g) q e hmq'
    have hjk : Limits.pullback.fst m g ≫ m = Limits.pullback.snd m g ≫ g :=
      Limits.pullback.condition
    have k1 : Limits.pullback.fst m g ≫ Limits.pullback.fst a a ≫ b =
        Limits.pullback.snd m g ≫ (β h).hom := by
      rw [← hm1, ← Category.assoc, hjk, Category.assoc, hg1]
    have k2 : Limits.pullback.fst m g ≫ Limits.pullback.snd a a ≫ b =
        Limits.pullback.snd m g := by
      rw [← hm2, ← Category.assoc, hjk, Category.assoc, hg2, Category.comp_id]
    have key : Limits.pullback.fst m g ≫ Limits.pullback.fst a a =
        Limits.pullback.fst m g ≫ Limits.pullback.snd a a ≫ τ h := by
      apply hext
      · simp only [Category.assoc]
        rw [hτa, hQ]
      · simp only [Category.assoc]
        rw [hτb, k1, reassoc_of% k2]
    have e1 : (Limits.pullback.fst m g ≫ Limits.pullback.fst a a) y = z₁ := by
      rw [Scheme.Hom.comp_apply, hy1, hq1]
    have e2 : (Limits.pullback.fst m g ≫ Limits.pullback.snd a a ≫ τ h) y = τ h z₂ := by
      rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply, hy1, hq2]
    rw [← e1, key, e2, hφ]

  have hθmem : ∀ (V : X'.Etale) (a : wcSuppSub.{u} ℓ (∀ x, V.hom x ∈ (Y' : Set X'))),
      LocallyConstant.const ((wcEtBaseChange (ρ ≫ Y'.ι)).obj V).left
          (a : ULift.{u+1} (ZMod ℓ)) ∈
        wcGalDescSub (ρ ≫ Y'.ι) (Y' : Set X') H β hβ (ULift.{u+1} (ZMod ℓ)) 1 ⊤ V := by
    intro V a T'' c
    have hres : wcGalRes (ρ ≫ Y'.ι) (ULift.{u+1} (ZMod ℓ)) c
        (LocallyConstant.const ((wcEtBaseChange (ρ ≫ Y'.ι)).obj V).left
          (a : ULift.{u+1} (ZMod ℓ))) =
        LocallyConstant.const _ (a : ULift.{u+1} (ZMod ℓ)) := by
      apply LocallyConstant.ext
      intro q
      rfl
    rw [hres]
    refine ⟨fun y => AddSubgroup.mem_top _, fun x y => rfl, ?_⟩
    by_cases ha : (a : ULift.{u+1} (ZMod ℓ)) = 0
    · left
      apply LocallyConstant.ext
      intro q
      exact ha
    · right
      have hp : ∀ x, V.hom x ∈ (Y' : Set X') := by
        by_contra hp
        exact ha (congrArg Subtype.val (supBot _ hp a))
      intro t
      rw [← MorphismProperty.Over.w c, Scheme.Hom.comp_apply]
      exact hp _
  let θ : wcEtExtZeroPre X' (Y' : Set X') ℓ ⟶
      wcGalDescPre (ρ ≫ Y'.ι) (Y' : Set X') H β hβ (ULift.{u+1} (ZMod ℓ)) 1 ⊤ :=
    { app := fun V => AddCommGrpCat.ofHom
        (AddMonoidHom.codRestrict
          ((LocallyConstant.constAddMonoidHom : ULift.{u+1} (ZMod ℓ) →+
            LocallyConstant ((wcEtBaseChange (ρ ≫ Y'.ι)).obj V.unop).left
              (ULift.{u+1} (ZMod ℓ))).comp
            (wcSuppSub.{u} ℓ (∀ x, V.unop.hom x ∈ (Y' : Set X'))).subtype)
          (wcGalDescSub (ρ ≫ Y'.ι) (Y' : Set X') H β hβ (ULift.{u+1} (ZMod ℓ)) 1 ⊤ V.unop)
          (fun a => hθmem V.unop a))
      naturality := fun V W g => by
        apply AddCommGrpCat.hom_ext
        apply AddMonoidHom.ext
        intro a
        apply Subtype.ext
        apply LocallyConstant.ext
        intro q
        rfl }

  have hinj : Presheaf.IsLocallyInjective (Scheme.smallEtaleTopology X') θ := by
    apply Presheaf.IsLocallyInjective.mk
    intro V x y hxy
    apply hcov
    intro v
    refine ⟨V.unop, 𝟙 _, ?_, v, rfl⟩
    rw [Presheaf.equalizerSieve_apply]
    suffices hxy' : x = y by rw [hxy']
    by_cases hp : ∀ z, V.unop.hom z ∈ (Y' : Set X')
    · obtain ⟨z, -⟩ := hpto V.unop v (hp v)
      have h1 := congrArg (fun s : wcGalDescSub (ρ ≫ Y'.ι) (Y' : Set X') H β hβ
        (ULift.{u+1} (ZMod ℓ)) 1 ⊤ V.unop => (s : LocallyConstant _ (ULift.{u+1} (ZMod ℓ))) z) hxy
      apply Subtype.ext
      exact h1
    · rw [supBot _ hp x, supBot _ hp y]

  have hsurj : Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology X') θ := by
    apply Presheaf.IsLocallySurjective.mk
    intro V s
    apply hcov
    intro v
    let f : LocallyConstant ((wcEtBaseChange (ρ ≫ Y'.ι)).obj V).left (ULift.{u+1} (ZMod ℓ)) :=
      (s : wcGalDescSub (ρ ≫ Y'.ι) (Y' : Set X') H β hβ (ULift.{u+1} (ZMod ℓ)) 1 ⊤ V).1
    have hf : f ∈ wcGalDescSub (ρ ≫ Y'.ι) (Y' : Set X') H β hβ (ULift.{u+1} (ZMod ℓ)) 1 ⊤ V :=
      (s : wcGalDescSub (ρ ≫ Y'.ι) (Y' : Set X') H β hβ (ULift.{u+1} (ZMod ℓ)) 1 ⊤ V).2
    have hid : wcGalRes (ρ ≫ Y'.ι) (ULift.{u+1} (ZMod ℓ)) (𝟙 V) f = f := by
      show ((wcLCPb (ρ ≫ Y'.ι) (ULift.{u+1} (ZMod ℓ))).map (𝟙 V).op).hom f = f
      rw [op_id, CategoryTheory.Functor.map_id]
      rfl
    have hinv : ∀ (x : H) (y : ((wcEtBaseChange (ρ ≫ Y'.ι)).obj V).left),
        f (wcPbρ (ρ ≫ Y'.ι) (ρ ≫ Y'.ι) (β x).hom (hβ x) V y) = f y := by
      intro x y
      have h : wcGalRes (ρ ≫ Y'.ι) (ULift.{u+1} (ZMod ℓ)) (𝟙 V) f
          (wcPbρ (ρ ≫ Y'.ι) (ρ ≫ Y'.ι) (β x).hom (hβ x) V y) =
          (1 : H →* AddMonoid.End (ULift.{u+1} (ZMod ℓ))) x
            (wcGalRes (ρ ≫ Y'.ι) (ULift.{u+1} (ZMod ℓ)) (𝟙 V) f y) :=
        (hf V (𝟙 V)).2.1 x y
      rw [hid] at h
      exact h
    have hcase : wcGalRes (ρ ≫ Y'.ι) (ULift.{u+1} (ZMod ℓ)) (𝟙 V) f = 0 ∨
        ∀ t, V.hom t ∈ (Y' : Set X') := (hf V (𝟙 V)).2.2
    rw [hid] at hcase
    rcases hcase with h0 | hland
    · refine ⟨V, 𝟙 V, ?_, v, rfl⟩
      rw [Presheaf.imageSieve_apply]
      refine ⟨0, ?_⟩
      rw [map_zero]
      apply Subtype.ext
      show (0 : LocallyConstant _ (ULift.{u+1} (ZMod ℓ))) =
        wcGalRes (ρ ≫ Y'.ι) (ULift.{u+1} (ZMod ℓ)) (𝟙 V) f
      rw [hid, h0]
    · obtain ⟨z₀, hz₀⟩ := hpto V v (hland v)
      have hfib : ∀ z₁ z₂ : ((wcEtBaseChange (ρ ≫ Y'.ι)).obj V).left,
          Limits.pullback.fst V.hom (ρ ≫ Y'.ι) z₁ = Limits.pullback.fst V.hom (ρ ≫ Y'.ι) z₂ →
          f z₁ = f z₂ :=
        crux (Limits.pullback.fst V.hom (ρ ≫ Y'.ι)) (Limits.pullback.snd V.hom (ρ ≫ Y'.ι)) V.hom
          Limits.pullback.condition (fun g₁ g₂ h1 h2 => Limits.pullback.hom_ext h1 h2)
          (fun x => wcPbρ (ρ ≫ Y'.ι) (ρ ≫ Y'.ι) (β x).hom (hβ x) V)
          (fun x => Limits.pullback.lift_fst _ _ _) (fun x => Limits.pullback.lift_snd _ _ _)
          f hinv
      let N : (Limits.pullback V.hom (ρ ≫ Y'.ι)).Opens :=
        ⟨{q | f q = f z₀}, f.isLocallyConstant.isOpen_fiber (f z₀)⟩
      haveI : Etale V.hom := V.prop
      haveI : Etale ρ := hρ.2.2.1
      haveI : Etale (ρ ≫ Y'.ι) := inferInstance
      haveI : Etale (Limits.pullback.fst V.hom (ρ ≫ Y'.ι)) := inferInstance
      haveI : Etale (N.ι ≫ Limits.pullback.fst V.hom (ρ ≫ Y'.ι)) := inferInstance
      haveI hEtV₁ : Etale ((N.ι ≫ Limits.pullback.fst V.hom (ρ ≫ Y'.ι)) ≫ V.hom) := inferInstance
      let V₁ : X'.Etale := MorphismProperty.Over.mk ⊤
        ((N.ι ≫ Limits.pullback.fst V.hom (ρ ≫ Y'.ι)) ≫ V.hom) hEtV₁
      let c : V₁ ⟶ V :=
        MorphismProperty.Over.homMk (N.ι ≫ Limits.pullback.fst V.hom (ρ ≫ Y'.ι)) rfl trivial
      have hV₁ : ∀ x : V₁.left, V₁.hom x ∈ (Y' : Set X') := by
        intro x
        exact (congrArg (· ∈ (Y' : Set X'))
          (Scheme.Hom.comp_apply (N.ι ≫ Limits.pullback.fst V.hom (ρ ≫ Y'.ι)) V.hom x)).mpr
          (hland _)
      refine ⟨V₁, c, ?_, ⟨z₀, rfl⟩, ?_⟩
      · rw [Presheaf.imageSieve_apply]
        refine ⟨⟨f z₀, supTop _ hV₁ (f z₀)⟩, ?_⟩
        apply Subtype.ext
        apply LocallyConstant.ext
        intro q
        show f z₀ = f (((wcEtBaseChange (ρ ≫ Y'.ι)).map c).left q)
        have hu : f (N.ι (Limits.pullback.fst V₁.hom (ρ ≫ Y'.ι) q)) = f z₀ :=
          (congrArg f (Scheme.Opens.ι_apply N (Limits.pullback.fst V₁.hom (ρ ≫ Y'.ι) q))).trans
            (Limits.pullback.fst V₁.hom (ρ ≫ Y'.ι) q).2
        refine (hu.symm.trans ?_)
        apply hfib
        have h2 : ((wcEtBaseChange (ρ ≫ Y'.ι)).map c).left ≫ Limits.pullback.fst V.hom (ρ ≫ Y'.ι) =
            Limits.pullback.fst V₁.hom (ρ ≫ Y'.ι) ≫ c.left := Limits.pullback.lift_fst _ _ _
        have h3 := congrArg (fun φ => φ q) h2
        have h3' : Limits.pullback.fst V.hom (ρ ≫ Y'.ι) (((wcEtBaseChange (ρ ≫ Y'.ι)).map c).left q) =
            c.left (Limits.pullback.fst V₁.hom (ρ ≫ Y'.ι) q) :=
          (Scheme.Hom.comp_apply _ _ _).symm.trans (h3.trans (Scheme.Hom.comp_apply _ _ _))
        refine Eq.trans ?_ h3'.symm
        exact (Scheme.Hom.comp_apply N.ι (Limits.pullback.fst V.hom (ρ ≫ Y'.ι))
          (Limits.pullback.fst V₁.hom (ρ ≫ Y'.ι) q)).symm
      · exact (Scheme.Hom.comp_apply N.ι (Limits.pullback.fst V.hom (ρ ≫ Y'.ι)) _).trans
          ((congrArg (Limits.pullback.fst V.hom (ρ ≫ Y'.ι)) (Scheme.Opens.ι_apply N _)).trans hz₀)
  have hW : (Scheme.smallEtaleTopology X').W θ :=
    (GrothendieckTopology.W_iff_isLocallyBijective _ θ).2 ⟨hinj, hsurj⟩
  haveI := (GrothendieckTopology.W_iff _ θ).1 hW
  exact ⟨(asIso ((presheafToSheaf (Scheme.smallEtaleTopology X') AddCommGrpCat.{u+1}).map θ)).symm⟩

theorem wc_et_left_adjoint_free_iso {X E : Scheme.{u}} (e : E ⟶ X)
    (Λ : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1} ⥤
      Sheaf (Scheme.smallEtaleTopology E) AddCommGrpCat.{u+1})
    (hΛ : Nonempty (Λ ⊣ wcEtPush e)) :
    ∃ θ : ∀ T : X.Etale, Λ.obj ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
          (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) ≅
        (presheafToSheaf (Scheme.smallEtaleTopology E) AddCommGrpCat.{u+1}).obj
          (yoneda.obj ((wcEtBaseChange e).obj T) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free),
      ∀ {T T' : X.Etale} (c : T ⟶ T'),
        Λ.map ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map
            (Functor.whiskerRight (yoneda.map c) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))) ≫
          (θ T').hom =
        (θ T).hom ≫ (presheafToSheaf (Scheme.smallEtaleTopology E) AddCommGrpCat.{u+1}).map
            (Functor.whiskerRight (yoneda.map ((wcEtBaseChange e).map c))
              (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) :=
by

  have hjs : ∀ (Y : Scheme.{u}) (V : Y.Etale) (S : Sieve V), (∀ v : V.left, ∃ (V₁ : Y.Etale)
      (c : V₁ ⟶ V), S.arrows c ∧ v ∈ Set.range c.left) → S ∈ Scheme.smallEtaleTopology Y V := by
    intro Y V S hS
    change S ∈ Scheme.smallGrothendieckTopology @Etale Y V
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
    apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
    intro x
    obtain ⟨V₁, c, hc, y, hy⟩ := hS x
    have hw : c.left ≫ V.hom = V₁.hom := MorphismProperty.Over.w c
    have hEt : Etale c.left := by
      have h1 : Etale V.hom := V.prop
      have h2 : Etale (c.left ≫ V.hom) := by rw [hw]; exact V₁.prop
      exact Etale.of_comp c.left V.hom
    exact ⟨V₁, c, y, hc, hEt, hy⟩

  have hcov : ∀ {X B : Scheme.{u}} (g : X ⟶ B), CoverPreserving (Scheme.smallEtaleTopology B)
      (Scheme.smallEtaleTopology X) (wcEtBaseChange g) := by
    intro X B g
    constructor
    intro V S hS
    change S ∈ Scheme.smallGrothendieckTopology @Etale B V at hS
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale B
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hS
    have hS' := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale B
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mp hS
    apply hjs
    intro v
    obtain ⟨W, a, w, ha, -, hw⟩ := hS' (Limits.pullback.fst V.hom g v)
    refine ⟨(wcEtBaseChange g).obj W, (wcEtBaseChange g).map a,
      Sieve.image_mem_functorPushforward (wcEtBaseChange g) S ha, ?_⟩
    have h0 : (Limits.pullback.fst W.hom g ≫ a.left) ≫ V.hom = Limits.pullback.snd W.hom g ≫ g := by
      rw [Category.assoc, MorphismProperty.Over.w a]
      exact Limits.pullback.condition
    let m : Limits.pullback W.hom g ⟶ Limits.pullback V.hom g :=
      Limits.pullback.lift (Limits.pullback.fst W.hom g ≫ a.left) (Limits.pullback.snd W.hom g) h0
    have hmap : ((wcEtBaseChange g).map a).left = m := rfl
    have h1 : Limits.pullback.fst a.left (Limits.pullback.fst V.hom g) ≫ W.hom =
        (Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) ≫ Limits.pullback.snd V.hom g) ≫ g := by
      rw [← MorphismProperty.Over.w a, ← Category.assoc, Limits.pullback.condition, Category.assoc,
        Limits.pullback.condition, Category.assoc]
    let ψ : Limits.pullback a.left (Limits.pullback.fst V.hom g) ⟶ Limits.pullback W.hom g :=
      Limits.pullback.lift (Limits.pullback.fst a.left (Limits.pullback.fst V.hom g))
        (Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) ≫ Limits.pullback.snd V.hom g) h1
    have hψ : ψ ≫ m = Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, Limits.pullback.lift_fst, ← Category.assoc, Limits.pullback.lift_fst,
          Limits.pullback.condition]
      · rw [Category.assoc, Limits.pullback.lift_snd, Limits.pullback.lift_snd]
    obtain ⟨z, hz⟩ : ∃ z, Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) z = v := by
      have hv : (v : ↥(Limits.pullback V.hom g)) ∈
          Set.range (Limits.pullback.snd a.left (Limits.pullback.fst V.hom g)) := by
        rw [Scheme.Pullback.range_snd]
        exact ⟨w, hw⟩
      exact hv
    rw [hmap]
    exact ⟨ψ z, (Scheme.Hom.comp_apply ψ m z).symm.trans (by rw [hψ]; exact hz)⟩

  obtain ⟨adj⟩ := hΛ
  let Φ := wcEtBaseChange e
  haveI h1 : Limits.PreservesFiniteLimits Φ := ⟨fun J _ _ =>
    haveI : Limits.PreservesLimitsOfShape J (wcEtBaseChange e ⋙ Scheme.Etale.forget E) :=
      Limits.preservesLimitsOfShape_of_natIso
        (NatIso.ofComponents (fun _ => Iso.refl _) (fun _ => rfl) :
          Scheme.Etale.forget X ⋙ Over.pullback e ≅ wcEtBaseChange e ⋙ Scheme.Etale.forget E)
    Limits.preservesLimitsOfShape_of_reflects_of_preserves (wcEtBaseChange e) (Scheme.Etale.forget E)⟩
  haveI := flat_of_preservesFiniteLimits Φ
  haveI : Φ.IsContinuous (Scheme.smallEtaleTopology X) (Scheme.smallEtaleTopology E) :=
    Functor.isContinuous_of_coverPreserving (compatiblePreservingOfFlat _ _) (hcov e)

  let ε : wcEtPush e ≅ Φ.sheafPushforwardContinuous AddCommGrpCat.{u+1}
      (Scheme.smallEtaleTopology X) (Scheme.smallEtaleTopology E) :=
    Functor.isoWhiskerRight (Φ.sheafPushforwardContinuousCompSheafToPresheafIso AddCommGrpCat.{u+1}
      (Scheme.smallEtaleTopology X) (Scheme.smallEtaleTopology E)).symm
      (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) ≪≫
    Functor.associator _ _ _ ≪≫
    Functor.isoWhiskerLeft _ (asIso (sheafificationAdjunction (Scheme.smallEtaleTopology X)
      AddCommGrpCat.{u+1}).counit) ≪≫
    Functor.rightUnitor _
  let adj' := adj.ofNatIsoRight ε

  have s1 : ∀ {C : Type (u+1)} [Category.{u} C] (J' : GrothendieckTopology C)
      [HasWeakSheafify J' AddCommGrpCat.{u+1}] {Y Y' : C} (g : Y ⟶ Y')
      (G : Sheaf J' AddCommGrpCat.{u+1})
      (φ : (presheafToSheaf J' AddCommGrpCat.{u+1}).obj
        (yoneda.obj Y' ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶ G),
      uliftYonedaEquiv ((Adjunction.whiskerRight Cᵒᵖ AddCommGrpCat.adj).homEquiv
          (yoneda.obj Y ⋙ uliftFunctor.{u+1, u}) ((sheafToPresheaf J' AddCommGrpCat.{u+1}).obj G)
          ((sheafificationAdjunction J' AddCommGrpCat.{u+1}).homEquiv _ G
            ((presheafToSheaf J' AddCommGrpCat.{u+1}).map
              (Functor.whiskerRight (yoneda.map g)
                (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) ≫ φ))) =
        ((sheafToPresheaf J' AddCommGrpCat.{u+1}).obj G ⋙ forget AddCommGrpCat.{u+1}).map g.op
          (uliftYonedaEquiv ((Adjunction.whiskerRight Cᵒᵖ AddCommGrpCat.adj).homEquiv
            (yoneda.obj Y' ⋙ uliftFunctor.{u+1, u}) ((sheafToPresheaf J' AddCommGrpCat.{u+1}).obj G)
            ((sheafificationAdjunction J' AddCommGrpCat.{u+1}).homEquiv _ G φ))) := by
    intro C _ J' _ Y Y' g G φ
    have e1 := (sheafificationAdjunction J' AddCommGrpCat.{u+1}).homEquiv_naturality_left
      (Functor.whiskerRight (yoneda.map g) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) φ
    have e2 := (Adjunction.whiskerRight Cᵒᵖ AddCommGrpCat.adj).homEquiv_naturality_left
      (uliftYoneda.{u+1}.map g) ((sheafificationAdjunction J' AddCommGrpCat.{u+1}).homEquiv _ G φ)
    have e3 := uliftYonedaEquiv_naturality
      (F := (sheafToPresheaf J' AddCommGrpCat.{u+1}).obj G ⋙ forget AddCommGrpCat.{u+1})
      ((Adjunction.whiskerRight Cᵒᵖ AddCommGrpCat.adj).homEquiv
        (yoneda.obj Y' ⋙ uliftFunctor.{u+1, u}) ((sheafToPresheaf J' AddCommGrpCat.{u+1}).obj G)
        ((sheafificationAdjunction J' AddCommGrpCat.{u+1}).homEquiv _ G φ)) g.op
    refine Eq.trans ?_ e3.symm
    refine Eq.trans ?_ (congrArg uliftYonedaEquiv e2)
    exact congrArg (fun t => uliftYonedaEquiv ((Adjunction.whiskerRight Cᵒᵖ AddCommGrpCat.adj).homEquiv
          (yoneda.obj Y ⋙ uliftFunctor.{u+1, u}) ((sheafToPresheaf J' AddCommGrpCat.{u+1}).obj G) t))
      e1
  have s2 : ∀ (F F' : Sheaf (Scheme.smallEtaleTopology E) AddCommGrpCat.{u+1} ⥤ Type (u+1))
      (τ : F' ⟶ F)
      {A A' B B' : Sheaf (Scheme.smallEtaleTopology E) AddCommGrpCat.{u+1}}
      (rA : F.CorepresentableBy A) (rA' : F'.CorepresentableBy A')
      (rB : F.CorepresentableBy B) (rB' : F'.CorepresentableBy B')
      (a : A ⟶ A') (b : B ⟶ B'),
      (∀ {G : Sheaf (Scheme.smallEtaleTopology E) AddCommGrpCat.{u+1}} (φ : A' ⟶ G),
        rA.homEquiv (a ≫ φ) = τ.app G (rA'.homEquiv φ)) →
      (∀ {G : Sheaf (Scheme.smallEtaleTopology E) AddCommGrpCat.{u+1}} (φ : B' ⟶ G),
        rB.homEquiv (b ≫ φ) = τ.app G (rB'.homEquiv φ)) →
      a ≫ (rA'.uniqueUpToIso rB').hom = (rA.uniqueUpToIso rB).hom ≫ b := by
    intro F F' τ A A' B B' rA rA' rB rB' a b ha hb
    show a ≫ rA'.homEquiv.symm (rB'.homEquiv (𝟙 _)) = rA.homEquiv.symm (rB.homEquiv (𝟙 _)) ≫ b
    apply rA.homEquiv.injective
    have hb1 := hb (𝟙 _)
    rw [Category.comp_id] at hb1
    rw [ha, Equiv.apply_symm_apply, rA.homEquiv_comp, Equiv.apply_symm_apply, ← rB.homEquiv_comp,
      Category.id_comp, hb1]
  let rep : ∀ {C : Type (u+1)} [Category.{u} C] (J' : GrothendieckTopology C)
      [HasWeakSheafify J' AddCommGrpCat.{u+1}] (Y : C),
      (sheafToPresheaf J' AddCommGrpCat.{u+1} ⋙ (evaluation Cᵒᵖ AddCommGrpCat.{u+1}).obj
        (Opposite.op Y) ⋙ forget AddCommGrpCat.{u+1}).CorepresentableBy
        ((presheafToSheaf J' AddCommGrpCat.{u+1}).obj
          (yoneda.obj Y ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) :=
    fun {C} _ J' _ Y =>
      { homEquiv := fun {G} =>
          ((sheafificationAdjunction J' AddCommGrpCat.{u+1}).homEquiv _ G).trans
            (((Adjunction.whiskerRight Cᵒᵖ AddCommGrpCat.adj).homEquiv
              (yoneda.obj Y ⋙ uliftFunctor.{u+1, u}) _).trans uliftYonedaEquiv)
        homEquiv_comp := fun {G G'} f g => by
          simp only [Equiv.trans_apply, Adjunction.homEquiv_naturality_right]
          rfl }
  let r3 : ∀ T : X.Etale, (sheafToPresheaf (Scheme.smallEtaleTopology E) AddCommGrpCat.{u+1} ⋙
        (evaluation (E.Etale)ᵒᵖ AddCommGrpCat.{u+1}).obj
        (Opposite.op (Φ.obj T)) ⋙ forget AddCommGrpCat.{u+1}).CorepresentableBy
        (Λ.obj ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
          (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))) := fun T =>
    { homEquiv := fun {G} => (adj'.homEquiv _ G).trans (rep (Scheme.smallEtaleTopology X) T).homEquiv
      homEquiv_comp := fun {G G'} f k => by
        show (rep (Scheme.smallEtaleTopology X) T).homEquiv (adj'.homEquiv _ G' (k ≫ f)) = _
        rw [Adjunction.homEquiv_naturality_right, (rep (Scheme.smallEtaleTopology X) T).homEquiv_comp]
        rfl }
  refine ⟨fun T => (r3 T).uniqueUpToIso (rep (Scheme.smallEtaleTopology E) (Φ.obj T)), ?_⟩
  intro T T' c
  refine s2 _ _ (Functor.whiskerLeft (sheafToPresheaf (Scheme.smallEtaleTopology E) AddCommGrpCat.{u+1})
      (Functor.whiskerRight ((evaluation (E.Etale)ᵒᵖ AddCommGrpCat.{u+1}).map (Φ.map c).op)
        (forget AddCommGrpCat.{u+1})))
    (r3 T) (r3 T') (rep (Scheme.smallEtaleTopology E) (Φ.obj T))
    (rep (Scheme.smallEtaleTopology E) (Φ.obj T')) _ _ ?_ ?_
  · intro G φ
    show (rep (Scheme.smallEtaleTopology X) T).homEquiv (adj'.homEquiv _ G (Λ.map _ ≫ φ)) = _
    rw [Adjunction.homEquiv_naturality_left]
    exact s1 (Scheme.smallEtaleTopology X) c
      ((Φ.sheafPushforwardContinuous AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology X)
        (Scheme.smallEtaleTopology E)).obj G) (adj'.homEquiv _ G φ)
  · intro G φ
    exact s1 (Scheme.smallEtaleTopology E) (Φ.map c) G φ

theorem wc_et_const_fullyFaithful_connected (E : Scheme.{u}) (hE : ConnectedSpace E) :
    Nonempty (constantSheaf (Scheme.smallEtaleTopology E) AddCommGrpCat.{u+1}).FullyFaithful :=
by
  classical
  let T₀ : E.Etale := Scheme.Etale.mk (𝟙 E)
  have hT : Limits.IsTerminal T₀ :=
    Limits.IsTerminal.ofUniqueHom (fun V => MorphismProperty.Over.homMk V.hom)
      (fun V m => MorphismProperty.Over.Hom.ext
        ((Category.comp_id m.left).symm.trans (MorphismProperty.Over.w m)))

  have hcov : ∀ (V : E.Etale) (S : Sieve V), (∀ v : V.left, ∃ (V₁ : E.Etale) (c : V₁ ⟶ V),
      S.arrows c ∧ v ∈ Set.range c.left) → S ∈ Scheme.smallEtaleTopology E V := by
    intro V S hS
    change S ∈ Scheme.smallGrothendieckTopology @Etale E V
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale E
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
    apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale E
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
    intro x
    obtain ⟨V₁, c, hc, y, hy⟩ := hS x
    have hw : c.left ≫ V.hom = V₁.hom := MorphismProperty.Over.w c
    have hEt : Etale c.left := by
      have h1 : Etale V.hom := V.prop
      have h2 : Etale (c.left ≫ V.hom) := by rw [hw]; exact V₁.prop
      exact Etale.of_comp c.left V.hom
    exact ⟨V₁, c, y, hc, hEt, hy⟩

  have hLsheaf : ∀ (A : Type (u+1)) [AddCommGroup A],
      Presheaf.IsSheaf (Scheme.smallEtaleTopology E) (wcEtLC E A) := by
    intro A _
    have s2 : ∀ {Z : Type u} [TopologicalSpace Z] {ι : Type (u+1)} {V : ι → Type u}
        [∀ i, TopologicalSpace (V i)] (f : ∀ i, V i → Z), (∀ i, IsOpenMap (f i)) →
        (∀ z : Z, ∃ (i : ι) (v : V i), f i v = z) → ∀ (g : ∀ i, LocallyConstant (V i) A),
        (∀ (i j : ι) (v : V i) (w : V j), f i v = f j w → g i v = g j w) →
        ∃ G : LocallyConstant Z A, ∀ (i : ι) (v : V i), G (f i v) = g i v := by
      intro Z _ ι V _ f hopen hsurj g hcompat
      choose iz vz hz using hsurj
      let G₀ : Z → A := fun z => g (iz z) (vz z)
      have hK : ∀ j w, G₀ (f j w) = g j w := fun j w => hcompat _ _ _ _ (hz _)
      have hlc : IsLocallyConstant G₀ := by
        rw [IsLocallyConstant.iff_isOpen_fiber]
        intro a
        rw [isOpen_iff_forall_mem_open]
        intro z hzA
        refine ⟨f (iz z) '' {v' | g (iz z) v' = g (iz z) (vz z)}, ?_,
          hopen _ _ (IsLocallyConstant.isOpen_fiber (g (iz z)).isLocallyConstant _),
          ⟨vz z, rfl, hz z⟩⟩
        rintro _ ⟨v', hv', rfl⟩
        change G₀ (f (iz z) v') = a
        rw [hK, hv']
        exact hzA
      exact ⟨⟨G₀, hlc⟩, hK⟩
    have s3 : ∀ (U : E.Etale) (S : Sieve U), S ∈ Scheme.smallEtaleTopology E U →
        ∀ z : U.left, ∃ (V : E.Etale) (f : V ⟶ U) (y : V.left), S.arrows f ∧ f.left y = z := by
      intro U S hS z
      change S ∈ Scheme.smallGrothendieckTopology @Etale E U at hS
      rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale E
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hS
      obtain ⟨V, f, y, hf, -, hy⟩ := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale E
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ U S).mp hS z
      exact ⟨V, f, y, hf, hy⟩
    have s4e : ∀ {V U : E.Etale} (c : V ⟶ U), Etale c.left := by
      intro V U c
      haveI : Etale U.hom := U.prop
      haveI : Etale (c.left ≫ U.hom) := by rw [MorphismProperty.Over.w c]; exact V.prop
      exact Etale.of_comp c.left U.hom
    have s4 : ∀ {V U : E.Etale} (c : V ⟶ U), IsOpenMap c.left := by
      intro V U c
      haveI := s4e c
      exact c.left.isOpenMap
    have s5 : ∀ {U V₁ V₂ : E.Etale} (f₁ : V₁ ⟶ U) (f₂ : V₂ ⟶ U) (y₁ : V₁.left) (y₂ : V₂.left),
        f₁.left y₁ = f₂.left y₂ → ∃ (D : E.Etale) (π₁ : D ⟶ V₁) (π₂ : D ⟶ V₂) (z : D.left),
          π₁ ≫ f₁ = π₂ ≫ f₂ ∧ π₁.left z = y₁ ∧ π₂.left z = y₂ := by
      intro U V₁ V₂ f₁ f₂ y₁ y₂ h
      haveI := s4e f₂
      haveI hEt : Etale (Limits.pullback.fst f₁.left f₂.left ≫ V₁.hom) := by
        haveI : Etale V₁.hom := V₁.prop
        infer_instance
      let D : E.Etale :=
        MorphismProperty.Over.mk ⊤ (Limits.pullback.fst f₁.left f₂.left ≫ V₁.hom) hEt
      have hw : Limits.pullback.snd f₁.left f₂.left ≫ V₂.hom =
          Limits.pullback.fst f₁.left f₂.left ≫ V₁.hom := by
        rw [← MorphismProperty.Over.w f₁, ← MorphismProperty.Over.w f₂, ← Category.assoc,
          ← Category.assoc, Limits.pullback.condition]
      let p₁ : D ⟶ V₁ :=
        MorphismProperty.Over.homMk (Limits.pullback.fst f₁.left f₂.left) rfl trivial
      let p₂ : D ⟶ V₂ :=
        MorphismProperty.Over.homMk (Limits.pullback.snd f₁.left f₂.left) hw trivial
      have hcomm : p₁ ≫ f₁ = p₂ ≫ f₂ := by
        apply MorphismProperty.Over.Hom.ext
        change Limits.pullback.fst f₁.left f₂.left ≫ f₁.left =
          Limits.pullback.snd f₁.left f₂.left ≫ f₂.left
        exact Limits.pullback.condition
      obtain ⟨z, hz1, hz2⟩ := Scheme.Pullback.exists_preimage_pullback y₁ y₂ h
      exact ⟨D, p₁, p₂, z, hcomm, hz1, hz2⟩
    rw [Presheaf.isSheaf_iff_isSheaf_forget (Scheme.smallEtaleTopology E) (wcEtLC E A)
      (forget AddCommGrpCat.{u+1}), isSheaf_iff_isSheaf_of_type]
    intro U S hS x hx
    let ι := Σ (V : E.Etale), {f : V ⟶ U // S.arrows f}
    obtain ⟨G, hG⟩ := s2 (Z := U.left) (ι := ι) (V := fun i => ↥(i.1.left))
      (fun i v => i.2.1.left v) (fun i => s4 i.2.1)
      (fun z => by
        obtain ⟨V, f, y, hf, hy⟩ := s3 U S hS z
        exact ⟨⟨V, f, hf⟩, y, hy⟩)
      (fun i => show LocallyConstant i.1.left A from x i.2.1 i.2.2)
      (by
        rintro ⟨V₁, f₁, h₁⟩ ⟨V₂, f₂, h₂⟩ v w hvw
        obtain ⟨D, π₁, π₂, z, hcomm, hz1, hz2⟩ := s5 f₁ f₂ v w hvw
        have hc := hx π₁ π₂ h₁ h₂ hcomm
        have h := congrArg (fun k => (show LocallyConstant D.left A from k) z) hc
        change (show LocallyConstant V₁.left A from x f₁ h₁) v =
          (show LocallyConstant V₂.left A from x f₂ h₂) w
        rw [← hz1, ← hz2]
        exact h)
    refine ⟨G, fun V f hf => ?_, fun t ht => ?_⟩
    · change @Eq (LocallyConstant V.left A) _ _
      exact LocallyConstant.ext (fun y => hG ⟨V, f, hf⟩ y)
    · change @Eq (LocallyConstant U.left A) _ _
      refine LocallyConstant.ext (fun z => ?_)
      obtain ⟨V, f, y, hf, rfl⟩ := s3 U S hS z
      have h1 := congrArg (fun k => (show LocallyConstant V.left A from k) y) (ht f hf)
      exact h1.trans (hG ⟨V, f, hf⟩ y).symm

  have hbij : ∀ Q : AddCommGrpCat.{u+1}, Function.Bijective
      ((toSheafify (Scheme.smallEtaleTopology E) ((Functor.const (E.Etale)ᵒᵖ).obj Q)).app
        (Opposite.op T₀)).hom := by
    intro Q
    let L := wcEtLC E Q
    have hL : Presheaf.IsSheaf (Scheme.smallEtaleTopology E) L := hLsheaf Q
    let P := (Functor.const (E.Etale)ᵒᵖ).obj Q
    let α : P ⟶ L :=
      { app := fun V => AddCommGrpCat.ofHom (LocallyConstant.constAddMonoidHom :
          Q →+ LocallyConstant V.unop.left Q)
        naturality := fun _ _ _ => rfl }
    have hinj : Presheaf.IsLocallyInjective (Scheme.smallEtaleTopology E) α := by
      constructor
      intro X a b hab
      apply hcov
      intro v
      have hab' : a = b :=
        congrArg (fun f : LocallyConstant X.unop.left Q => f v) hab
      refine ⟨X.unop, 𝟙 _, ?_, ⟨v, rfl⟩⟩
      rw [Presheaf.equalizerSieve_apply, hab']
    have hsurj : Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology E) α := by
      constructor
      intro V s
      apply hcov
      intro v
      let f : LocallyConstant V.left Q := s
      let O : V.left.Opens := ⟨{x | f x = f v}, f.isLocallyConstant.isOpen_fiber (f v)⟩
      let V₁ : E.Etale := MorphismProperty.Over.mk ⊤ (O.ι ≫ V.hom) (by infer_instance)
      let c : V₁ ⟶ V := MorphismProperty.Over.homMk O.ι rfl trivial
      have hv : v ∈ Set.range O.ι := by
        rw [Scheme.Opens.range_ι]
        exact (rfl : f v = f v)
      refine ⟨V₁, c, ?_, hv⟩
      rw [Presheaf.imageSieve_apply]
      refine ⟨f v, ?_⟩
      apply LocallyConstant.ext
      intro x
      have hx : O.ι x ∈ (O : Set V.left) := by
        rw [← Scheme.Opens.range_ι]
        exact ⟨x, rfl⟩
      exact (show f (O.ι x) = f v from hx).symm
    let φ := sheafifyLift (Scheme.smallEtaleTopology E) α hL
    have hfac : toSheafify (Scheme.smallEtaleTopology E) P ≫ φ = α :=
      toSheafify_sheafifyLift _ α hL
    have := hinj
    have := hsurj
    have : Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology E)
        (toSheafify (Scheme.smallEtaleTopology E) P) :=
      Presheaf.isLocallySurjective_toSheafify' _ P
    have h1 : Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology E) φ :=
      Presheaf.isLocallySurjective_of_isLocallySurjective_fac _ hfac
    have h2 : Presheaf.IsLocallyInjective (Scheme.smallEtaleTopology E) φ :=
      Presheaf.isLocallyInjective_of_isLocallyInjective_of_isLocallySurjective_fac _ α hfac
    let Φ : (constantSheaf (Scheme.smallEtaleTopology E) AddCommGrpCat.{u+1}).obj Q ⟶
        (⟨L, hL⟩ : Sheaf (Scheme.smallEtaleTopology E) AddCommGrpCat.{u+1}) :=
      ObjectProperty.homMk φ
    have hΦ : IsIso Φ := (Sheaf.isLocallyBijective_iff_isIso Φ).mp ⟨h2, h1⟩
    have hφ : IsIso φ := by
      have : IsIso ((sheafToPresheaf (Scheme.smallEtaleTopology E) AddCommGrpCat.{u+1}).map Φ) :=
        Functor.map_isIso _ Φ
      exact this
    have hV : IsIso (φ.app (Opposite.op T₀)) := NatIso.isIso_app_of_isIso φ _
    have hφbij : Function.Bijective (φ.app (Opposite.op T₀)).hom :=
      (ConcreteCategory.isIso_iff_bijective _).mp hV
    have hconst : Function.Bijective (fun q : Q => LocallyConstant.const E q) := by
      haveI : ConnectedSpace E := hE
      obtain ⟨x₀⟩ := (inferInstance : Nonempty E)
      refine ⟨fun a b hab => ?_, fun f => ?_⟩
      · exact congrArg (fun f : LocallyConstant E Q => f x₀) hab
      · exact ⟨f x₀, (LocallyConstant.eq_const f x₀).symm⟩
    have hαbij : Function.Bijective (α.app (Opposite.op T₀)).hom := hconst
    have hcomp : (α.app (Opposite.op T₀)).hom = (φ.app (Opposite.op T₀)).hom ∘
        ((toSheafify (Scheme.smallEtaleTopology E) P).app (Opposite.op T₀)).hom := by
      rw [← hfac]
      rfl
    rw [hcomp] at hαbij
    exact (Function.Bijective.of_comp_iff' hφbij _).mp hαbij

  let adj := constantSheafAdj (Scheme.smallEtaleTopology E) AddCommGrpCat.{u+1} hT
  have hunit : ∀ Q : AddCommGrpCat.{u+1}, IsIso (adj.unit.app Q) := by
    intro Q
    have e1 : adj.unit.app Q = (toSheafify (Scheme.smallEtaleTopology E)
        ((Functor.const (E.Etale)ᵒᵖ).obj Q)).app (Opposite.op T₀) := by
      simp only [adj, constantSheafAdj, Adjunction.comp_unit_app, constantPresheafAdj,
        Functor.constCompEvaluationObj_hom_app, evaluation_obj_map,
        sheafificationAdjunction_unit_app, Category.id_comp]
      rfl
    rw [e1]
    exact (ConcreteCategory.isIso_iff_bijective _).mpr (hbij Q)
  haveI : IsIso adj.unit := NatIso.isIso_of_isIso_app adj.unit
  exact ⟨adj.fullyFaithfulLOfIsIsoUnit⟩

theorem wc_et_split_sections_bijective {X E : Scheme.{u}} (e : E ⟶ X) (T : X.Etale) (A : Type u)
    (s : A → (E ⟶ T.left)) (hs : wcEtSplits e T A s) :
    ∃ σ : A → (Scheme.Etale.mk (𝟙 E) ⟶ (wcEtBaseChange e).obj T),
      ∀ G : Sheaf (Scheme.smallEtaleTopology E) AddCommGrpCat.{u+1},
        Function.Bijective (fun (x : G.obj.obj (Opposite.op ((wcEtBaseChange e).obj T))) (a : A) =>
          (G.obj.map (σ a).op).hom x) :=
by
  classical
  obtain ⟨hA, hs', hiso⟩ := hs
  let f : A → (E ⟶ Limits.pullback T.hom e) := fun a => Limits.pullback.lift (s a) (𝟙 E)
    ((hs' a).trans (Category.id_comp e).symm)
  haveI : IsIso (Limits.Sigma.desc f : ∐ (fun _ : A => E) ⟶ Limits.pullback T.hom e) := hiso
  have hfac : ∀ a, Limits.Sigma.ι (fun _ : A => E) a ≫ Limits.Sigma.desc f = f a :=
    fun a => Limits.Sigma.ι_comp_desc f a

  have hO : ∀ a, IsOpenImmersion (f a) := by
    intro a
    rw [← hfac a]
    infer_instance

  have hinj : Function.Injective (Limits.Sigma.desc f : ∐ (fun _ : A => E) ⟶ Limits.pullback T.hom e) := by
    intro x y hxy
    have h1 := Scheme.hom_inv_apply (asIso (Limits.Sigma.desc f : ∐ (fun _ : A => E) ⟶ Limits.pullback T.hom e)) x
    have h2 := Scheme.hom_inv_apply (asIso (Limits.Sigma.desc f : ∐ (fun _ : A => E) ⟶ Limits.pullback T.hom e)) y
    exact h1.symm.trans ((congrArg (asIso (Limits.Sigma.desc f : ∐ (fun _ : A => E) ⟶ Limits.pullback T.hom e)).inv hxy).trans h2)

  have hD : ∀ a b, a ≠ b → Disjoint (Set.range (f a)) (Set.range (f b)) := by
    intro a b hab
    rw [Set.disjoint_left]
    rintro z ⟨p, rfl⟩ ⟨q, hq⟩
    apply hab
    rw [← hfac a, ← hfac b, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at hq
    have h3 := hinj hq
    have h4 := (sigmaι_eq_iff (fun _ : A => E) b a q p).mp h3
    exact (congrArg Sigma.fst h4).symm

  have hC : ∀ x : (Limits.pullback T.hom e : Scheme.{u}), ∃ a, x ∈ Set.range (f a) := by
    intro x
    obtain ⟨⟨a, p⟩, hp⟩ := (sigmaMk (fun _ : A => E)).surjective
      ((asIso (Limits.Sigma.desc f : ∐ (fun _ : A => E) ⟶ Limits.pullback T.hom e)).inv x)
    refine ⟨a, p, ?_⟩
    rw [← hfac a, Scheme.Hom.comp_apply, ← sigmaMk_mk, hp]
    exact Scheme.inv_hom_apply (asIso (Limits.Sigma.desc f : ∐ (fun _ : A => E) ⟶ Limits.pullback T.hom e)) x

  let σ : A → (Scheme.Etale.mk (𝟙 E) ⟶ (wcEtBaseChange e).obj T) := fun a =>
    MorphismProperty.Over.homMk (f a) (Limits.pullback.lift_snd _ _ _) trivial
  refine ⟨σ, fun G => ?_⟩
  let eA := Finite.equivFin A
  have key := wc_et_disjoint_cover_bijective ((wcEtBaseChange e).obj T) (Nat.card A)
    (fun _ => Scheme.Etale.mk (𝟙 E)) (fun i => σ (eA.symm i))
    (fun i => hO (eA.symm i))
    (fun i j hij => hD _ _ (fun h => hij (eA.symm.injective h)))
    (fun x => by
      obtain ⟨a, ha⟩ := hC x
      refine ⟨eA a, ?_⟩
      have : eA.symm (eA a) = a := Equiv.symm_apply_apply eA a
      show x ∈ Set.range (f (eA.symm (eA a)))
      rw [this]
      exact ha) G
  have hR : Function.Bijective (fun (g : (i : Fin (Nat.card A)) →
      G.obj.obj (Opposite.op (Scheme.Etale.mk (𝟙 E)))) (a : A) => g (eA a)) := by
    constructor
    · intro g g' h
      funext i
      have h5 := congrFun h (eA.symm i)
      simp only [Equiv.apply_symm_apply] at h5
      exact h5
    · intro h
      refine ⟨fun i => h (eA.symm i), ?_⟩
      funext a
      simp only [Equiv.symm_apply_apply]
  have hcomp := hR.comp key
  convert hcomp using 1
  funext x a
  simp only [Function.comp_apply, Equiv.symm_apply_apply]

theorem wc_et_baseChange_openι_isIso {X E : Scheme.{u}} (e : E ⟶ X) (U : X.Etale) (W : X.Opens)
    (he : ∀ x : E, e x ∈ (W : Set X)) :
    IsIso ((wcEtBaseChange e).map (wcEtOpenι X U (U.hom ⁻¹ᵁ W))) :=
by
  set W' := U.hom ⁻¹ᵁ W with hW'
  have hrange : Set.range (Limits.pullback.fst U.hom e) ⊆ Set.range W'.ι := by
    rintro _ ⟨z, rfl⟩
    rw [Scheme.Opens.range_ι]
    have h1 : U.hom (Limits.pullback.fst U.hom e z) = e (Limits.pullback.snd U.hom e z) := by
      rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, Limits.pullback.condition]
    exact (Scheme.Hom.mem_preimage _).2 (h1 ▸ he _)
  let k := IsOpenImmersion.lift W'.ι (Limits.pullback.fst U.hom e) hrange
  have hk : k ≫ W'.ι = Limits.pullback.fst U.hom e := IsOpenImmersion.lift_fac _ _ _
  have hr : k ≫ (W'.ι ≫ U.hom) = Limits.pullback.snd U.hom e ≫ e := by
    rw [← Category.assoc, hk, Limits.pullback.condition]
  let r : Limits.pullback U.hom e ⟶ Limits.pullback (W'.ι ≫ U.hom) e :=
    Limits.pullback.lift k (Limits.pullback.snd U.hom e) hr
  let m : Limits.pullback (W'.ι ≫ U.hom) e ⟶ Limits.pullback U.hom e :=
    Limits.pullback.lift (Limits.pullback.fst (W'.ι ≫ U.hom) e ≫ W'.ι)
      (Limits.pullback.snd (W'.ι ≫ U.hom) e) (by rw [Category.assoc, Limits.pullback.condition])
  have hrm : r ≫ m = 𝟙 _ := by
    apply Limits.pullback.hom_ext
    · simp only [m, r, Category.assoc, Limits.pullback.lift_fst, Limits.pullback.lift_fst_assoc,
        Category.id_comp, hk]
    · simp only [m, r, Category.assoc, Limits.pullback.lift_snd, Category.id_comp]
  have hmr : m ≫ r = 𝟙 _ := by
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, Limits.pullback.lift_fst, Category.id_comp]
      rw [← cancel_mono W'.ι, Category.assoc, hk]
      simp only [m, Limits.pullback.lift_fst]
    · simp only [m, r, Category.assoc, Limits.pullback.lift_snd, Category.id_comp]
  have hc : ((wcEtBaseChange e).map (wcEtOpenι X U W')).left = m := rfl
  let cinv : (wcEtBaseChange e).obj U ⟶ (wcEtBaseChange e).obj (wcEtOpen X U W') :=
    MorphismProperty.Over.homMk r (by
      show r ≫ Limits.pullback.snd (W'.ι ≫ U.hom) e = Limits.pullback.snd U.hom e
      simp only [r, Limits.pullback.lift_snd]) trivial
  refine ⟨⟨cinv, ?_, ?_⟩⟩
  · apply MorphismProperty.Over.Hom.ext
    show m ≫ r = 𝟙 _
    exact hmr
  · apply MorphismProperty.Over.Hom.ext
    show r ≫ m = 𝟙 _
    exact hrm

theorem wc_et_free_const_of_sections (E : Scheme.{u}) (P : E.Etale) (A : Type u) [Finite A]
    (σ : A → (Scheme.Etale.mk (𝟙 E) ⟶ P))
    (hσ : ∀ G : Sheaf (Scheme.smallEtaleTopology E) AddCommGrpCat.{u+1},
      Function.Bijective (fun (x : G.obj.obj (Opposite.op P)) (a : A) => (G.obj.map (σ a).op).hom x)) :
    Nonempty ((presheafToSheaf (Scheme.smallEtaleTopology E) AddCommGrpCat.{u+1}).obj
        (yoneda.obj P ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ≅
      (constantSheaf (Scheme.smallEtaleTopology E) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (A → ULift.{u+1} ℤ))) :=
by
  classical
  haveI : Fintype A := Fintype.ofFinite A
  let J := Scheme.smallEtaleTopology E
  let T₀ : E.Etale := Scheme.Etale.mk (𝟙 E)
  have hT₀ : Limits.IsTerminal T₀ :=
    @MorphismProperty.Over.mkIdTerminal _ _ (@Etale) E
      MorphismProperty.IsMultiplicative.toContainsIdentities
  let adj := constantSheafAdj J AddCommGrpCat.{u+1} hT₀
  let Fp := yoneda.obj P ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free
  let F := (presheafToSheaf J AddCommGrpCat.{u+1}).obj Fp
  let K := (constantSheaf J AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (A → ULift.{u+1} ℤ))

  let η : F.obj.obj (Opposite.op P) :=
    ((toSheafify J Fp).app (Opposite.op P)).hom (FreeAbelianGroup.of (ULift.up (𝟙 P)))
  let e1 : ∀ G : Sheaf J AddCommGrpCat.{u+1}, (F ⟶ G) ≃ G.obj.obj (Opposite.op P) := fun G =>
    ((sheafificationAdjunction J AddCommGrpCat.{u+1}).homEquiv Fp G).trans
      (((Adjunction.whiskerRight (E.Etale)ᵒᵖ AddCommGrpCat.adj.{u+1}).homEquiv
          (yoneda.obj P ⋙ uliftFunctor.{u+1, u}) G.obj).trans
        (uliftYonedaEquiv.{u+1} (X := P) (F := G.obj ⋙ forget AddCommGrpCat.{u+1})))
  have he1 : ∀ (G : Sheaf J AddCommGrpCat.{u+1}) (g : F ⟶ G),
      e1 G g = (g.hom.app (Opposite.op P)).hom η := fun _ _ => rfl

  let e2 : ∀ G : Sheaf J AddCommGrpCat.{u+1},
      G.obj.obj (Opposite.op P) ≃ (A → G.obj.obj (Opposite.op T₀)) := fun G =>
    Equiv.ofBijective _ (hσ G)

  let fwd : ∀ M : AddCommGrpCat.{u+1}, (A → M) → (AddCommGrpCat.of (A → ULift.{u+1} ℤ) ⟶ M) :=
    fun M x => AddCommGrpCat.ofHom
      { toFun := fun n => ∑ a, (n a).down • x a
        map_zero' := by simp
        map_add' := fun n m => by simp [add_zsmul, Finset.sum_add_distrib] }
  have hfwd : ∀ (M : AddCommGrpCat.{u+1}) (x : A → M) (n : A → ULift.{u+1} ℤ),
      (fwd M x).hom n = ∑ a, (n a).down • x a := fun _ _ _ => rfl
  let e3 : ∀ M : AddCommGrpCat.{u+1}, (A → M) ≃ (AddCommGrpCat.of (A → ULift.{u+1} ℤ) ⟶ M) :=
    fun M =>
    { toFun := fwd M
      invFun := fun f a => f.hom (Pi.single a (ULift.up (1 : ℤ)))
      left_inv := fun x => by
        funext b
        show (fwd M x).hom (Pi.single b (ULift.up (1 : ℤ))) = x b
        rw [hfwd, Finset.sum_eq_single b]
        · simp
        · intro a _ hab
          simp [hab]
        · simp
      right_inv := fun f => by
        apply AddCommGrpCat.hom_ext
        apply AddMonoidHom.ext
        intro n
        have hn : n = ∑ a, (n a).down • (Pi.single a (ULift.up (1 : ℤ)) : A → ULift.{u+1} ℤ) := by
          funext b
          rw [Finset.sum_apply, Finset.sum_eq_single b]
          · apply ULift.ext
            simp
          · intro a _ hab
            simp [hab.symm]
          · simp
        show (fwd M _).hom n = f.hom n
        conv_rhs => rw [hn]
        rw [hfwd, map_sum]
        simp only [map_zsmul] }
  have N3 : ∀ (M M' : AddCommGrpCat.{u+1}) (f : M ⟶ M') (y : A → M),
      e3 M' (fun a => f.hom (y a)) = e3 M y ≫ f := by
    intro M M' f y
    apply AddCommGrpCat.hom_ext
    apply AddMonoidHom.ext
    intro n
    show (fwd M' _).hom n = f.hom ((fwd M y).hom n)
    rw [hfwd, hfwd, map_sum]
    simp only [map_zsmul]

  let Φ : ∀ G : Sheaf J AddCommGrpCat.{u+1}, (F ⟶ G) ≃ (K ⟶ G) := fun G =>
    (e1 G).trans ((e2 G).trans ((e3 (G.obj.obj (Opposite.op T₀))).trans
      (adj.homEquiv (AddCommGrpCat.of (A → ULift.{u+1} ℤ)) G).symm))
  have N : ∀ (G G' : Sheaf J AddCommGrpCat.{u+1}) (g : F ⟶ G) (ψ : G ⟶ G'),
      Φ G' (g ≫ ψ) = Φ G g ≫ ψ := by
    intro G G' g ψ
    have N1 : e1 G' (g ≫ ψ) = (ψ.hom.app (Opposite.op P)).hom (e1 G g) := by
      rw [he1, he1]
      rfl
    have h12 : e2 G' (e1 G' (g ≫ ψ)) =
        fun a => (ψ.hom.app (Opposite.op T₀)).hom (e2 G (e1 G g) a) := by
      rw [N1]
      funext a
      exact (NatTrans.naturality_apply ψ.hom (σ a).op (e1 G g)).symm
    have h3 : e3 _ (e2 G' (e1 G' (g ≫ ψ))) =
        e3 _ (e2 G (e1 G g)) ≫ ψ.hom.app (Opposite.op T₀) := by
      rw [h12]
      exact N3 _ _ _ _
    show (adj.homEquiv _ G').symm (e3 _ (e2 G' (e1 G' (g ≫ ψ)))) =
      (adj.homEquiv _ G).symm (e3 _ (e2 G (e1 G g))) ≫ ψ
    exact (congrArg (adj.homEquiv (AddCommGrpCat.of (A → ULift.{u+1} ℤ)) G').symm h3).trans
      (adj.homEquiv_naturality_right_symm _ ψ)
  exact ⟨(Coyoneda.ext K F (fun {Z} f => (Φ Z).symm f) (fun {Z} g => Φ Z g)
    (fun f => (Φ _).apply_symm_apply f) (fun g => (Φ _).symm_apply_apply g)
    (fun g ψ => N _ _ g ψ)).symm⟩

theorem wc_et_const_coker_finite_torsion (E : Scheme.{u})
    (hff : (constantSheaf (Scheme.smallEtaleTopology E) AddCommGrpCat.{u+1}).FullyFaithful)
    (A B : Type u) [Finite A] (ℓ : ℕ) (hℓ : 0 < ℓ)
    (k : (constantSheaf (Scheme.smallEtaleTopology E) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (B → ULift.{u+1} ℤ)) ⟶
      (constantSheaf (Scheme.smallEtaleTopology E) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (A → ULift.{u+1} ℤ)))
    (hk : ℓ • 𝟙 (Limits.cokernel k) = 0) :
    ∃ (M : Type (u+1)) (_ : AddCommGroup M), Finite M ∧ (∀ x : M, ℓ • x = 0) ∧
      Nonempty (Limits.cokernel k ≅
        (constantSheaf (Scheme.smallEtaleTopology E) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of M)) :=
by
  classical
  obtain ⟨N, rfl⟩ : ∃ N, (constantSheaf (Scheme.smallEtaleTopology E) AddCommGrpCat.{u+1}).map N = k :=
    ⟨hff.preimage k, hff.map_preimage k⟩
  let M : Type (u+1) := (A → ULift.{u+1} ℤ) ⧸ (AddCommGrpCat.Hom.hom N).range
  let I : Limits.cokernel ((constantSheaf (Scheme.smallEtaleTopology E) AddCommGrpCat.{u+1}).map N) ≅
      (constantSheaf (Scheme.smallEtaleTopology E) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of M) :=
    (Limits.PreservesCokernel.iso (constantSheaf (Scheme.smallEtaleTopology E) AddCommGrpCat.{u+1}) N).symm ≪≫
      (constantSheaf (Scheme.smallEtaleTopology E) AddCommGrpCat.{u+1}).mapIso
        (AddCommGrpCat.cokernelIsoQuotient N)
  have h4 : ℓ • 𝟙 ((constantSheaf (Scheme.smallEtaleTopology E) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of M)) = 0 := by
    calc ℓ • 𝟙 ((constantSheaf (Scheme.smallEtaleTopology E) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of M))
        = I.inv ≫ (ℓ • 𝟙 (Limits.cokernel
            ((constantSheaf (Scheme.smallEtaleTopology E) AddCommGrpCat.{u+1}).map N))) ≫ I.hom := by
          rw [Preadditive.nsmul_comp, Preadditive.comp_nsmul, Category.id_comp, Iso.inv_hom_id]
      _ = 0 := by rw [hk, Limits.zero_comp, Limits.comp_zero]
  have h5 : ℓ • 𝟙 (AddCommGrpCat.of M) = 0 := by
    apply hff.map_injective
    rw [Functor.map_nsmul, CategoryTheory.Functor.map_id, Functor.map_zero]
    exact h4
  have h6 : ∀ x : M, ℓ • x = 0 := by
    intro x
    have := congrArg (fun f => (AddCommGrpCat.Hom.hom f) x) h5
    simpa using this
  haveI : AddGroup.FG (A → ULift.{u+1} ℤ) := Module.Finite.iff_addGroup_fg.mp inferInstance
  haveI : AddGroup.FG M := AddGroup.fg_of_surjective (QuotientAddGroup.mk'_surjective _)
  have htors : IsAddTorsion M := fun x => isOfFinAddOrder_iff_nsmul_eq_zero.mpr ⟨ℓ, hℓ, h6 x⟩
  exact ⟨M, inferInstance, AddCommGroup.finite_of_fg_isAddTorsion M htors, h6, ⟨I⟩⟩

theorem wc_et_flag_const_on_cover {X X' E : Scheme.{u}} (ℓ : ℕ) (hℓ : ℓ.Prime) (U V : X.Etale)
    (g : (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
      (yoneda.obj V ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶
      (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
      (yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
    (htor : ℓ • 𝟙 (Limits.cokernel g) = 0) (W₁ : X.Opens) (h : X' ⟶ X) [IsFinite h]
    (e : E ⟶ X) (ρ : E ⟶ (h ⁻¹ᵁ W₁ : Scheme.{u})) (hρe : ρ ≫ (h ⁻¹ᵁ W₁).ι ≫ h = e)
    (hconn : ConnectedSpace E) (A B : Type u) (a : A → (E ⟶ U.left)) (b : B → (E ⟶ V.left))
    (ha : wcEtSplits e U A a) (hb : wcEtSplits e V B b)
    (L : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1} ⥤
      Sheaf (Scheme.smallEtaleTopology X') AddCommGrpCat.{u+1})
    (hL : Nonempty (L ⊣ wcEtPush h))
    (L' : Sheaf (Scheme.smallEtaleTopology X') AddCommGrpCat.{u+1} ⥤
      Sheaf (Scheme.smallEtaleTopology E) AddCommGrpCat.{u+1})
    (hL' : Nonempty (L' ⊣ wcEtPush (ρ ≫ (h ⁻¹ᵁ W₁).ι))) :
    ∃ (M : Type (u+1)) (_ : AddCommGroup M), Finite M ∧ (∀ x : M, ℓ • x = 0) ∧
      Nonempty (L'.obj (L.obj (Limits.image ((presheafToSheaf (Scheme.smallEtaleTopology X)
        AddCommGrpCat.{u+1}).map (Functor.whiskerRight
          (yoneda.map (wcEtOpenι X U (U.hom ⁻¹ᵁ W₁)))
          (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) ≫ Limits.cokernel.π g))) ≅
        (constantSheaf (Scheme.smallEtaleTopology E) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of M)) :=
by
  classical

  obtain ⟨adjL⟩ := hL
  obtain ⟨adjL'⟩ := hL'
  have heq : (ρ ≫ (h ⁻¹ᵁ W₁).ι) ≫ h = e := by rw [Category.assoc]; exact hρe
  obtain ⟨-, ⟨cmp⟩⟩ := wc_et_push_id_comp_iso (ρ ≫ (h ⁻¹ᵁ W₁).ι) h
  rw [heq] at cmp
  let adjΛ : L ⋙ L' ⊣ wcEtPush e := (adjL.comp adjL').ofNatIsoRight cmp
  obtain ⟨Le, ⟨adjE⟩, hLe, -⟩ := wc_et_push_left_adjoint e
  haveI := hLe
  haveI : Limits.PreservesFiniteLimits (L ⋙ L') :=
    Limits.preservesFiniteLimits_of_natIso (adjE.leftAdjointUniq adjΛ)
  haveI : (L ⋙ L').IsLeftAdjoint := adjΛ.isLeftAdjoint
  haveI : Limits.PreservesColimitsOfSize.{0, 0} (L ⋙ L') := adjΛ.leftAdjoint_preservesColimits
  haveI : (L ⋙ L').PreservesZeroMorphisms := Functor.preservesZeroMorphisms_of_isLeftAdjoint _
  haveI : Limits.PreservesBinaryBiproducts (L ⋙ L') :=
    Limits.preservesBinaryBiproducts_of_preservesBinaryCoproducts _
  haveI : (L ⋙ L').Additive := Functor.additive_of_preservesBinaryBiproducts _

  obtain ⟨θ, hθ⟩ := wc_et_left_adjoint_free_iso e (L ⋙ L') ⟨adjΛ⟩

  have he : ∀ x : E, e x ∈ (W₁ : Set X) := by
    intro x
    have hx0 : (h ⁻¹ᵁ W₁).ι (ρ x) ∈ Set.range (h ⁻¹ᵁ W₁).ι := ⟨ρ x, rfl⟩
    rw [Scheme.Opens.range_ι] at hx0
    rw [← hρe, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply]
    exact hx0

  haveI hbc := wc_et_baseChange_openι_isIso e U W₁ he
  haveI : IsIso (yoneda.map ((wcEtBaseChange e).map (wcEtOpenι X U (U.hom ⁻¹ᵁ W₁)))) :=
    Functor.map_isIso _ _
  haveI : IsIso (Functor.whiskerRight
      (yoneda.map ((wcEtBaseChange e).map (wcEtOpenι X U (U.hom ⁻¹ᵁ W₁))))
      (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) := inferInstance
  haveI hZbc : IsIso ((presheafToSheaf (Scheme.smallEtaleTopology E) AddCommGrpCat.{u+1}).map
      (Functor.whiskerRight
        (yoneda.map ((wcEtBaseChange e).map (wcEtOpenι X U (U.hom ⁻¹ᵁ W₁))))
        (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))) := Functor.map_isIso _ _
  haveI hιiso : IsIso ((L ⋙ L').map ((presheafToSheaf (Scheme.smallEtaleTopology X)
      AddCommGrpCat.{u+1}).map (Functor.whiskerRight
        (yoneda.map (wcEtOpenι X U (U.hom ⁻¹ᵁ W₁)))
        (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)))) := by
    have hn := hθ (wcEtOpenι X U (U.hom ⁻¹ᵁ W₁))
    have e1 : (L ⋙ L').map ((presheafToSheaf (Scheme.smallEtaleTopology X)
        AddCommGrpCat.{u+1}).map (Functor.whiskerRight
          (yoneda.map (wcEtOpenι X U (U.hom ⁻¹ᵁ W₁)))
          (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))) =
        (θ (wcEtOpen X U (U.hom ⁻¹ᵁ W₁))).hom ≫
          (presheafToSheaf (Scheme.smallEtaleTopology E) AddCommGrpCat.{u+1}).map
          (Functor.whiskerRight
            (yoneda.map ((wcEtBaseChange e).map (wcEtOpenι X U (U.hom ⁻¹ᵁ W₁))))
            (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) ≫ (θ U).inv := by
      rw [← Category.assoc, ← hn, Category.assoc, Iso.hom_inv_id, Category.comp_id]
    rw [e1]
    infer_instance

  have hepi : Epi ((L ⋙ L').map ((presheafToSheaf (Scheme.smallEtaleTopology X)
      AddCommGrpCat.{u+1}).map (Functor.whiskerRight
        (yoneda.map (wcEtOpenι X U (U.hom ⁻¹ᵁ W₁)))
        (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) ≫ Limits.cokernel.π g)) := by
    rw [Functor.map_comp]
    infer_instance
  rw [← Limits.image.fac ((presheafToSheaf (Scheme.smallEtaleTopology X)
      AddCommGrpCat.{u+1}).map (Functor.whiskerRight
        (yoneda.map (wcEtOpenι X U (U.hom ⁻¹ᵁ W₁)))
        (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) ≫ Limits.cokernel.π g),
    Functor.map_comp] at hepi
  haveI := hepi
  haveI : Epi ((L ⋙ L').map (Limits.image.ι ((presheafToSheaf (Scheme.smallEtaleTopology X)
      AddCommGrpCat.{u+1}).map (Functor.whiskerRight
        (yoneda.map (wcEtOpenι X U (U.hom ⁻¹ᵁ W₁)))
        (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) ≫ Limits.cokernel.π g))) :=
    epi_of_epi ((L ⋙ L').map (Limits.factorThruImage ((presheafToSheaf
      (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map (Functor.whiskerRight
        (yoneda.map (wcEtOpenι X U (U.hom ⁻¹ᵁ W₁)))
        (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) ≫ Limits.cokernel.π g))) _
  haveI : IsIso ((L ⋙ L').map (Limits.image.ι ((presheafToSheaf (Scheme.smallEtaleTopology X)
      AddCommGrpCat.{u+1}).map (Functor.whiskerRight
        (yoneda.map (wcEtOpenι X U (U.hom ⁻¹ᵁ W₁)))
        (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) ≫ Limits.cokernel.π g))) :=
    isIso_of_mono_of_epi _
  let e₁ := asIso ((L ⋙ L').map (Limits.image.ι ((presheafToSheaf (Scheme.smallEtaleTopology X)
      AddCommGrpCat.{u+1}).map (Functor.whiskerRight
        (yoneda.map (wcEtOpenι X U (U.hom ⁻¹ᵁ W₁)))
        (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) ≫ Limits.cokernel.π g)))

  haveI : Finite A := ha.1
  haveI : Finite B := hb.1
  obtain ⟨σA, hσA⟩ := wc_et_split_sections_bijective e U A a ha
  obtain ⟨σB, hσB⟩ := wc_et_split_sections_bijective e V B b hb
  obtain ⟨cA⟩ := wc_et_free_const_of_sections E ((wcEtBaseChange e).obj U) A σA hσA
  obtain ⟨cB⟩ := wc_et_free_const_of_sections E ((wcEtBaseChange e).obj V) B σB hσB
  let κU := θ U ≪≫ cA
  let κV := θ V ≪≫ cB

  let e₂ := Limits.PreservesCokernel.iso (L ⋙ L') g
  let k := κV.inv ≫ (L ⋙ L').map g ≫ κU.hom
  have hsq : (L ⋙ L').map g ≫ κU.hom = κV.hom ≫ k := by
    simp only [k, Iso.hom_inv_id_assoc]
  let e₃ := Limits.cokernel.mapIso ((L ⋙ L').map g) k κV κU hsq

  have hk : ℓ • 𝟙 (Limits.cokernel k) = 0 := by
    have h1 : (L ⋙ L').map (ℓ • 𝟙 (Limits.cokernel g)) = ℓ • 𝟙 _ := by
      rw [Functor.map_nsmul, CategoryTheory.Functor.map_id]
    rw [htor, Functor.map_zero] at h1
    calc ℓ • 𝟙 (Limits.cokernel k)
        = (e₂ ≪≫ e₃).inv ≫ (ℓ • 𝟙 ((L ⋙ L').obj (Limits.cokernel g))) ≫ (e₂ ≪≫ e₃).hom := by
          rw [Preadditive.nsmul_comp, Preadditive.comp_nsmul, Category.id_comp,
            Iso.inv_hom_id]
      _ = 0 := by rw [← h1, Limits.zero_comp, Limits.comp_zero]

  obtain ⟨hff⟩ := wc_et_const_fullyFaithful_connected E hconn
  obtain ⟨M, inst, hfin, htorM, ⟨e₄⟩⟩ :=
    wc_et_const_coker_finite_torsion E hff A B ℓ hℓ.pos k hk
  exact ⟨M, inst, hfin, htorM, ⟨e₁ ≪≫ e₂ ≪≫ e₃ ≪≫ e₄⟩⟩

theorem wc_gal_triv_sections {X' E : Scheme.{u}} (e' : E ⟶ X')
    [(wcEtBaseChange e').IsContinuous (Scheme.smallEtaleTopology X') (Scheme.smallEtaleTopology E)]
    (L' : Sheaf (Scheme.smallEtaleTopology X') AddCommGrpCat.{u+1} ⥤
      Sheaf (Scheme.smallEtaleTopology E) AddCommGrpCat.{u+1})
    (hL' : Nonempty (L' ⊣ wcEtPush e'))
    (Q : Sheaf (Scheme.smallEtaleTopology X') AddCommGrpCat.{u+1}) (M : Type (u+1))
    [AddCommGroup M]
    (eM : L'.obj Q ≅ (constantSheaf (Scheme.smallEtaleTopology E) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of M)) :
    ∃ Φ : ∀ (V : X'.Etale) (O : E.Etale) (k : O.left ⟶ V.left), k ≫ V.hom = O.hom ≫ e' →
        IsIso k → (Q.obj.obj (Opposite.op V) ≃+ LocallyConstant O.left M),
      ∀ (V V' : X'.Etale) (c : V' ⟶ V) (O O' : E.Etale) (d : O' ⟶ O)
        (k : O.left ⟶ V.left) (hk : k ≫ V.hom = O.hom ≫ e') (hki : IsIso k)
        (k' : O'.left ⟶ V'.left) (hk' : k' ≫ V'.hom = O'.hom ≫ e') (hki' : IsIso k'),
        k' ≫ c.left = d.left ≫ k → ∀ s : Q.obj.obj (Opposite.op V),
        Φ V' O' k' hk' hki' ((Q.obj.map c.op).hom s) =
          LocallyConstant.comap ⟨d.left, d.left.continuous⟩ (Φ V O k hk hki s) :=
by
  classical
  obtain ⟨ρ, huniv, -⟩ := wc_et_adjoint_univ_transport e' L' hL'
  obtain ⟨φ, hinj, hsurj⟩ := wc_et_const_to_lc_locBij E M
  let LC : Sheaf (Scheme.smallEtaleTopology E) AddCommGrpCat.{u+1} :=
    ⟨wcEtLC E M, wc_et_lc_isSheaf E M⟩
  have hW : (Scheme.smallEtaleTopology E).W φ :=
    (GrothendieckTopology.W_iff_isLocallyBijective (Scheme.smallEtaleTopology E) φ).mpr
      ⟨hinj, hsurj⟩
  have hI : IsIso ((presheafToSheaf (Scheme.smallEtaleTopology E) AddCommGrpCat.{u+1}).map φ) :=
    (GrothendieckTopology.W_iff (Scheme.smallEtaleTopology E) φ).mp hW
  let e1 := @asIso _ _ _ _ ((presheafToSheaf _ AddCommGrpCat.{u+1}).map φ) hI
  let ε : (constantSheaf (Scheme.smallEtaleTopology E) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of M) ≅ LC := e1 ≪≫ (sheafificationIso LC).symm
  let ι : L'.obj Q ≅ LC := eM ≪≫ ε
  let ψ : ∀ O : E.Etale, (L'.obj Q).obj.obj (Opposite.op O) ≃+ LocallyConstant O.left M :=
    fun O => (((sheafToPresheaf _ _).mapIso ι).app (Opposite.op O)).addCommGroupIsoToAddEquiv
  have hψ : ∀ (O : E.Etale) (y : (L'.obj Q).obj.obj (Opposite.op O)),
      ψ O y = (ι.hom.hom.app (Opposite.op O)).hom y := fun O y => rfl
  refine ⟨fun V O k hk hki => (AddEquiv.ofBijective ((ρ Q).ρ V O k hk)
      (wc_et_univ_transport_bijective_of_iso e' Q (L'.obj Q) (ρ Q) (huniv Q) V O k hk hki)).trans
      (ψ O), ?_⟩
  intro V V' c O O' d k hk hki k' hk' hki' hkk s
  have h1 := (ρ Q).nat V V' c O O' d k hk k' hk' hkk s
  change ψ O' ((ρ Q).ρ V' O' k' hk' ((Q.obj.map c.op).hom s)) =
    LocallyConstant.comap ⟨d.left, d.left.continuous⟩ (ψ O ((ρ Q).ρ V O k hk s))
  have h1' : (ρ Q).ρ V' O' k' hk' ((Q.obj.map c.op).hom s) =
      ((L'.obj Q).obj.map d.op).hom ((ρ Q).ρ V O k hk s) := h1
  rw [h1', hψ, hψ]
  have h2 := congrArg (fun f => f.hom ((ρ Q).ρ V O k hk s)) (ι.hom.hom.naturality d.op)
  simp only [AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply] at h2
  rw [h2]
  rfl

theorem wc_gal_twist_action {X' E : Scheme.{u}} (e' : E ⟶ X') [Etale e']
    (H : Type u) [Group H] (β : H →* Aut E) (hβ : ∀ x, (β x).hom ≫ e' = e')
    (hconn : ConnectedSpace E)
    (Q : Sheaf (Scheme.smallEtaleTopology X') AddCommGrpCat.{u+1}) (M : Type (u+1))
    [AddCommGroup M]
    (Φ : ∀ (V : X'.Etale) (O : E.Etale) (k : O.left ⟶ V.left), k ≫ V.hom = O.hom ≫ e' →
        IsIso k → (Q.obj.obj (Opposite.op V) ≃+ LocallyConstant O.left M))
    (hΦ : ∀ (V V' : X'.Etale) (c : V' ⟶ V) (O O' : E.Etale) (d : O' ⟶ O)
        (k : O.left ⟶ V.left) (hk : k ≫ V.hom = O.hom ≫ e') (hki : IsIso k)
        (k' : O'.left ⟶ V'.left) (hk' : k' ≫ V'.hom = O'.hom ≫ e') (hki' : IsIso k'),
        k' ≫ c.left = d.left ≫ k → ∀ s : Q.obj.obj (Opposite.op V),
        Φ V' O' k' hk' hki' ((Q.obj.map c.op).hom s) =
          LocallyConstant.comap ⟨d.left, d.left.continuous⟩ (Φ V O k hk hki s)) :
    ∃ act : H →* AddMonoid.End M, ∀ (x : H) (V : X'.Etale) (O O' : E.Etale)
      (k : O.left ⟶ V.left) (hk : k ≫ V.hom = O.hom ≫ e') (hki : IsIso k)
      (k' : O'.left ⟶ V.left) (hk' : k' ≫ V.hom = O'.hom ≫ e') (hki' : IsIso k')
      (w : O'.left ⟶ O.left), w ≫ k = k' → w ≫ O.hom ≫ (β x).hom = O'.hom →
      ∀ (s : Q.obj.obj (Opposite.op V)) (y : O'.left),
        Φ V O' k' hk' hki' s y = act x (Φ V O k hk hki s (w y)) :=
by
  classical

  have hZ : ∀ (V : X'.Etale) (O O' : E.Etale)
      (k : O.left ⟶ V.left) (hk : k ≫ V.hom = O.hom ≫ e') (hki : IsIso k)
      (k' : O'.left ⟶ V.left) (hk' : k' ≫ V.hom = O'.hom ≫ e') (hki' : IsIso k')
      (w : O'.left ⟶ O.left), w ≫ k = k' →
      ∀ (t : Q.obj.obj (Opposite.op V)) (y : O'.left),
        Φ V O k hk hki t (w y) = 0 → Φ V O' k' hk' hki' t y = 0 := by
    intro V O O' k hk hki k' hk' hki' w hw t y hy
    haveI := hki
    haveI := hki'
    haveI hwiso : IsIso w := by
      have e1 : w = k' ≫ inv k := by
        rw [← hw, Category.assoc, IsIso.hom_inv_id, Category.comp_id]
      rw [e1]; infer_instance
    haveI : Etale V.hom := V.prop
    haveI : Etale O.hom := O.prop
    haveI : Etale O'.hom := O'.prop
    let U' : O'.left.Opens := ⟨w ⁻¹' {x | Φ V O k hk hki t x = 0},
      ((Φ V O k hk hki t).isLocallyConstant.isOpen_fiber 0).preimage w.continuous⟩
    have hyU : y ∈ U' := hy
    let VU : X'.Etale := Scheme.Etale.mk (U'.ι ≫ k' ≫ V.hom)
    let OU : E.Etale := Scheme.Etale.mk (U'.ι ≫ O'.hom)
    let OU2 : E.Etale := Scheme.Etale.mk (U'.ι ≫ w ≫ O.hom)
    let c' : VU ⟶ V := MorphismProperty.Over.homMk (U'.ι ≫ k')
      (show (U'.ι ≫ k') ≫ V.hom = U'.ι ≫ k' ≫ V.hom from Category.assoc _ _ _) trivial
    let d' : OU ⟶ O' := MorphismProperty.Over.homMk U'.ι
      (show U'.ι ≫ O'.hom = U'.ι ≫ O'.hom from rfl) trivial
    let d'' : OU2 ⟶ O := MorphismProperty.Over.homMk (U'.ι ≫ w)
      (show (U'.ι ≫ w) ≫ O.hom = U'.ι ≫ w ≫ O.hom from Category.assoc _ _ _) trivial
    have hk2 : 𝟙 (U' : Scheme.{u}) ≫ VU.hom = OU2.hom ≫ e' := by
      show 𝟙 _ ≫ U'.ι ≫ k' ≫ V.hom = (U'.ι ≫ w ≫ O.hom) ≫ e'
      rw [Category.id_comp, Category.assoc, Category.assoc, ← hk, ← hw, Category.assoc]
    have hk3 : 𝟙 (U' : Scheme.{u}) ≫ VU.hom = OU.hom ≫ e' := by
      show 𝟙 _ ≫ U'.ι ≫ k' ≫ V.hom = (U'.ι ≫ O'.hom) ≫ e'
      rw [Category.id_comp, hk', Category.assoc]
    have h1 := hΦ V VU c' O OU2 d'' k hk hki (𝟙 _) hk2 (IsIso.id _)
      (show 𝟙 _ ≫ (U'.ι ≫ k') = (U'.ι ≫ w) ≫ k by
        rw [Category.id_comp, Category.assoc, hw]) t
    have e2 : Φ VU OU2 (𝟙 _) hk2 (IsIso.id _) ((Q.obj.map c'.op).hom t) = 0 := by
      rw [h1]
      ext p
      change Φ V O k hk hki t (w (U'.ι p)) = 0
      have hp : U'.ι p ∈ U' := (Scheme.Opens.range_ι U').subset ⟨p, rfl⟩
      exact hp
    have e3 : (Q.obj.map c'.op).hom t = 0 :=
      (Φ VU OU2 (𝟙 _) hk2 (IsIso.id _)).injective (by rw [e2, map_zero])
    have h2 := hΦ V VU c' O' OU d' k' hk' hki' (𝟙 _) hk3 (IsIso.id _)
      (show 𝟙 _ ≫ (U'.ι ≫ k') = U'.ι ≫ k' from Category.id_comp _) t
    rw [e3, map_zero] at h2
    have hyr : y ∈ Set.range U'.ι := by rw [Scheme.Opens.range_ι]; exact hyU
    obtain ⟨p, hp⟩ := hyr
    have h3 := DFunLike.congr_fun h2 p
    change (0 : M) = Φ V O' k' hk' hki' t (U'.ι p) at h3
    rw [hp] at h3
    exact h3.symm

  let e₀ : E := Classical.choice hconn.toNonempty
  let Eo : X'.Etale := Scheme.Etale.mk e'
  let E1 : E.Etale := Scheme.Etale.mk (𝟙 E)
  let Eσ : H → E.Etale := fun x => @Scheme.Etale.mk _ _ (β x).hom
    (by haveI : IsIso (β x).hom := Iso.isIso_hom (β x); infer_instance)
  have hσ : ∀ x : H, 𝟙 E ≫ Eo.hom = (Eσ x).hom ≫ e' := fun x =>
    (Category.id_comp e').trans (hβ x).symm
  have h1E : 𝟙 E ≫ Eo.hom = E1.hom ≫ e' := rfl
  let Φ₁ := Φ Eo E1 (𝟙 E) h1E (IsIso.id E)
  let s₀ : M →+ Q.obj.obj (Opposite.op Eo) :=
    Φ₁.symm.toAddMonoidHom.comp LocallyConstant.constAddMonoidHom
  have hs0 : ∀ m : M, Φ₁ (s₀ m) = LocallyConstant.const E m := fun m =>
    Φ₁.apply_symm_apply _
  let A : H → AddMonoid.End M := fun x => (LocallyConstant.evalAddMonoidHom e₀).comp
    ((Φ Eo (Eσ x) (𝟙 E) (hσ x) (IsIso.id E)).toAddMonoidHom.comp s₀)
  have hF : ∀ (x : H) (V : X'.Etale) (O O' : E.Etale)
      (k : O.left ⟶ V.left) (hk : k ≫ V.hom = O.hom ≫ e') (hki : IsIso k)
      (k' : O'.left ⟶ V.left) (hk' : k' ≫ V.hom = O'.hom ≫ e') (hki' : IsIso k')
      (w : O'.left ⟶ O.left), w ≫ k = k' → w ≫ O.hom ≫ (β x).hom = O'.hom →
      ∀ (s : Q.obj.obj (Opposite.op V)) (y : O'.left),
        Φ V O' k' hk' hki' s y = A x (Φ V O k hk hki s (w y)) := by
    intro x V O O' k hk hki k' hk' hki' w hw hw' s y
    haveI := hki
    obtain ⟨m, hm⟩ : ∃ m, Φ V O k hk hki s (w y) = m := ⟨_, rfl⟩
    let cO : V ⟶ Eo := MorphismProperty.Over.homMk (inv k ≫ O.hom)
      (show (inv k ≫ O.hom) ≫ e' = V.hom by
        rw [Category.assoc, ← hk, IsIso.inv_hom_id_assoc]) trivial
    let d₁ : O ⟶ E1 := MorphismProperty.Over.homMk O.hom
      (show O.hom ≫ 𝟙 E = O.hom from Category.comp_id _) trivial
    let dσ : O' ⟶ Eσ x := MorphismProperty.Over.homMk (w ≫ O.hom)
      (show (w ≫ O.hom) ≫ (β x).hom = O'.hom by rw [Category.assoc, hw']) trivial
    have i1 := hΦ Eo V cO E1 O d₁ (𝟙 E) h1E (IsIso.id E) k hk hki
      (show k ≫ (inv k ≫ O.hom) = O.hom ≫ 𝟙 E by
        rw [IsIso.hom_inv_id_assoc]; exact (Category.comp_id _).symm) (s₀ m)
    have i2 := hΦ Eo V cO (Eσ x) O' dσ (𝟙 E) (hσ x) (IsIso.id E) k' hk' hki'
      (show k' ≫ (inv k ≫ O.hom) = (w ≫ O.hom) ≫ 𝟙 E by
        rw [← hw, Category.assoc, IsIso.hom_inv_id_assoc]; exact (Category.comp_id _).symm) (s₀ m)
    have h0 : Φ V O k hk hki (s - (Q.obj.map cO.op).hom (s₀ m)) (w y) = 0 := by
      rw [map_sub, LocallyConstant.sub_apply, i1, hm]
      change m - Φ₁ (s₀ m) (O.hom (w y)) = 0
      rw [hs0]
      exact sub_self m
    have h4 := hZ V O O' k hk hki k' hk' hki' w hw _ y h0
    rw [map_sub, LocallyConstant.sub_apply, i2, sub_eq_zero] at h4
    rw [h4, hm]
    haveI : PreconnectedSpace (Eσ x).left := hconn.toPreconnectedSpace
    exact LocallyConstant.apply_eq_of_preconnectedSpace
      (Φ Eo (Eσ x) (𝟙 E) (hσ x) (IsIso.id E) (s₀ m)) (dσ.left y) e₀

  refine ⟨{ toFun := A, map_one' := ?_, map_mul' := ?_ }, ?_⟩
  · refine DFunLike.ext _ _ (fun m => ?_)
    have hw1 : 𝟙 E ≫ E1.hom ≫ (β 1).hom = E1.hom := by
      show 𝟙 E ≫ 𝟙 E ≫ (β 1).hom = 𝟙 E
      rw [map_one, Category.id_comp, Category.id_comp]
      rfl
    have h := hF 1 Eo E1 E1 (𝟙 E) h1E (IsIso.id E) (𝟙 E) h1E (IsIso.id E) (𝟙 E)
      (Category.id_comp _) hw1 (s₀ m) e₀
    change Φ₁ (s₀ m) e₀ = A 1 (Φ₁ (s₀ m) e₀) at h
    rw [hs0] at h
    exact h.symm
  · intro x y
    refine DFunLike.ext _ _ (fun m => ?_)
    have hw2 : 𝟙 E ≫ (Eσ y).hom ≫ (β x).hom = (Eσ (x * y)).hom := by
      show 𝟙 E ≫ (β y).hom ≫ (β x).hom = (β (x * y)).hom
      rw [Category.id_comp, map_mul, Aut.Aut_mul_def]
      rfl
    have h := hF x Eo (Eσ y) (Eσ (x * y)) (𝟙 E) (hσ y) (IsIso.id E) (𝟙 E) (hσ (x * y))
      (IsIso.id E) (𝟙 E) (Category.id_comp _) hw2 (s₀ m) e₀
    exact h
  · intro x V O O' k hk hki k' hk' hki' w hw hw' s y
    exact hF x V O O' k hk hki k' hk' hki' w hw hw' s y

theorem wc_gal_single_cover_descent {X' E : Scheme.{u}} (e' : E ⟶ X')
    (H : Type u) [Group H] (β : H →* Aut E) (hβ : ∀ x, (β x).hom ≫ e' = e')
    (hdeck : ∀ (Z : Scheme.{u}) (p₁ p₂ : Z ⟶ E), p₁ ≫ e' = p₂ ≫ e' →
      ∃ U : H → Z.Opens, (∀ z : Z, ∃ x, z ∈ U x) ∧
        ∀ x, (U x).ι ≫ p₁ = (U x).ι ≫ p₂ ≫ (β x).hom)
    (Q : Sheaf (Scheme.smallEtaleTopology X') AddCommGrpCat.{u+1})
    (T V₁ : X'.Etale) (π : V₁ ⟶ T) (a : V₁.left ⟶ E) (ha : a ≫ e' = V₁.hom)
    (hpb : IsPullback π.left a T.hom e') (hsurj : ∀ t : T.left, ∃ y : E, e' y = T.hom t) :
    (∀ s : Q.obj.obj (Opposite.op T), (Q.obj.map π.op).hom s = 0 → s = 0) ∧
    ∀ g : Q.obj.obj (Opposite.op V₁), (∀ (x : H) (d : V₁ ⟶ V₁), d ≫ π = π →
        d.left ≫ a = a ≫ (β x).hom → (Q.obj.map d.op).hom g = g) →
      ∃ s : Q.obj.obj (Opposite.op T), (Q.obj.map π.op).hom s = g :=
by
  classical

  have hjs : ∀ (V : X'.Etale) (S : Sieve V), (∀ v : V.left, ∃ (V₂ : X'.Etale)
      (c : V₂ ⟶ V), S.arrows c ∧ v ∈ Set.range c.left) →
      S ∈ Scheme.smallEtaleTopology X' V := by
    intro V S hS
    change S ∈ Scheme.smallGrothendieckTopology @Etale X' V
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale X'
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
    apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale X'
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
    intro x
    obtain ⟨V₂, c, hc, y, hy⟩ := hS x
    have hw : c.left ≫ V.hom = V₂.hom := MorphismProperty.Over.w c
    have hEt : Etale c.left := by
      have h1 : Etale V.hom := V.prop
      have h2 : Etale (c.left ≫ V.hom) := by rw [hw]; exact V₂.prop
      exact Etale.of_comp c.left V.hom
    exact ⟨V₂, c, y, hc, hEt, hy⟩
  have hF : Presieve.IsSheaf (Scheme.smallEtaleTopology X') (Q.obj ⋙ forget AddCommGrpCat) :=
    (isSheaf_iff_isSheaf_of_type _ _).1
      ((Presheaf.isSheaf_iff_isSheaf_forget (Scheme.smallEtaleTopology X') Q.obj
        (forget AddCommGrpCat.{u+1})).1 Q.property)
  have hmap : ∀ {A B C : X'.Etale} (f : A ⟶ B) (g : B ⟶ C) (s : Q.obj.obj (Opposite.op C)),
      (Q.obj.map (f ≫ g).op).hom s = (Q.obj.map f.op).hom ((Q.obj.map g.op).hom s) := by
    intro A B C f g s
    rw [op_comp, Functor.map_comp]
    rfl

  have hR : Sieve.generate (Presieve.singleton π) ∈ Scheme.smallEtaleTopology X' T := by
    apply hjs
    intro t
    obtain ⟨y, hy⟩ := hsurj t
    obtain ⟨z, hz1, -⟩ :=
      Scheme.Pullback.exists_preimage_pullback (f := T.hom) (g := e') t y hy.symm
    refine ⟨V₁, π, ⟨V₁, 𝟙 _, π, Presieve.singleton.mk, Category.id_comp π⟩,
      hpb.isoPullback.inv z, ?_⟩
    have h := Scheme.Hom.comp_apply hpb.isoPullback.inv π.left z
    rw [hpb.isoPullback_inv_fst, hz1] at h
    exact h.symm
  have h1 := (Presieve.isSheafFor_iff_generate (Presieve.singleton π)).2 (hF _ hR)
  have h2 := (Presieve.isSheafFor_singleton (P := Q.obj ⋙ forget AddCommGrpCat)).1 h1
  refine ⟨fun s hs => ?_, fun g hinv => ?_⟩
  · obtain ⟨t₀, _, ht₀⟩ := h2 ((Q.obj.map π.op).hom s) (fun {Z} p₁ p₂ hp => by
      change (Q.obj.map p₁.op).hom ((Q.obj.map π.op).hom s) =
        (Q.obj.map p₂.op).hom ((Q.obj.map π.op).hom s)
      rw [← hmap, ← hmap, hp])
    have e1 := ht₀ s rfl
    have e2 := ht₀ (0 : Q.obj.obj (Opposite.op T)) (by
      change (Q.obj.map π.op).hom 0 = (Q.obj.map π.op).hom s
      rw [hs, map_zero])
    exact e1.trans e2.symm
  ·
    have hw : π.left ≫ T.hom = a ≫ e' := hpb.w
    have hwx : ∀ x : H, π.left ≫ T.hom = (a ≫ (β x).hom) ≫ e' := fun x => by
      rw [Category.assoc, hβ x, hw]
    have hπw : π.left ≫ T.hom = V₁.hom := MorphismProperty.Over.w π
    let dl : H → (V₁.left ⟶ V₁.left) := fun x => hpb.lift π.left (a ≫ (β x).hom) (hwx x)
    have hdl1 : ∀ x, dl x ≫ π.left = π.left := fun x => hpb.lift_fst _ _ _
    have hdl2 : ∀ x, dl x ≫ a = a ≫ (β x).hom := fun x => hpb.lift_snd _ _ _
    let d : H → (V₁ ⟶ V₁) := fun x => MorphismProperty.Over.homMk (dl x)
      (by rw [← hπw, ← Category.assoc, hdl1])
    have hd1 : ∀ x, d x ≫ π = π := fun x => by
      apply MorphismProperty.Over.Hom.ext
      exact hdl1 x
    have hcompat : ∀ (Z : X'.Etale) (p₁ p₂ : Z ⟶ V₁), p₁ ≫ π = p₂ ≫ π →
        (Q.obj.map p₁.op).hom g = (Q.obj.map p₂.op).hom g := by
      intro Z p₁ p₂ hp
      have hpl : p₁.left ≫ π.left = p₂.left ≫ π.left :=
        congrArg (fun f : Z ⟶ T => f.left) hp
      have hz1 : (p₁.left ≫ a) ≫ e' = (p₂.left ≫ a) ≫ e' := by
        rw [Category.assoc, Category.assoc, ha, MorphismProperty.Over.w p₁,
          MorphismProperty.Over.w p₂]
      obtain ⟨U, hcov, hrel⟩ := hdeck Z.left (p₁.left ≫ a) (p₂.left ≫ a) hz1
      have : Etale Z.hom := Z.prop
      let Zx : H → X'.Etale := fun x =>
        MorphismProperty.Over.mk ⊤ ((U x).ι ≫ Z.hom) inferInstance
      let jx : ∀ x, Zx x ⟶ Z := fun x => MorphismProperty.Over.homMk (U x).ι rfl
      have hkey : ∀ x, jx x ≫ p₁ = jx x ≫ p₂ ≫ d x := by
        intro x
        apply MorphismProperty.Over.Hom.ext
        change (U x).ι ≫ p₁.left = (U x).ι ≫ p₂.left ≫ dl x
        apply hpb.hom_ext
        · simp only [Category.assoc]
          rw [hdl1, hpl]
        · simp only [Category.assoc]
          rw [hdl2]
          have := hrel x
          simpa only [Category.assoc] using this
      have hpieces : ∀ x, (Q.obj.map (jx x).op).hom ((Q.obj.map p₁.op).hom g) =
          (Q.obj.map (jx x).op).hom ((Q.obj.map p₂.op).hom g) := by
        intro x
        rw [← hmap (jx x) p₁ g, hkey x, hmap (jx x) (p₂ ≫ d x) g,
          hmap p₂ (d x) g, hinv x (d x) (hd1 x) (hdl2 x)]
      have hS : Sieve.generate (Presieve.ofArrows Zx jx) ∈ Scheme.smallEtaleTopology X' Z := by
        apply hjs
        intro z
        obtain ⟨x, hx⟩ := hcov z
        refine ⟨Zx x, jx x, ⟨Zx x, 𝟙 _, jx x, Presieve.ofArrows.mk x, Category.id_comp _⟩, ?_⟩
        change z ∈ Set.range (U x).ι
        rw [Scheme.Opens.range_ι]
        exact hx
      have hsep := (hF _ hS).isSeparatedFor
      have hsep' : Presieve.IsSeparatedFor (Q.obj ⋙ forget AddCommGrpCat)
          (Presieve.ofArrows Zx jx) :=
        Presieve.isSeparatedFor_iff_generate.2 hsep
      apply hsep'.ext
      rintro _ _ ⟨x⟩
      exact hpieces x
    obtain ⟨t₀, ht₀, _⟩ := h2 g (fun {Z} p₁ p₂ hp => hcompat Z p₁ p₂ hp)
    exact ⟨t₀, ht₀⟩

theorem wc_gal_restriction_from_triv {X' E : Scheme.{u}} (Y' : X'.Opens)
    (ρ : E ⟶ (Y' : Scheme.{u})) (H : Type u) [Group H] (β : H →* Aut E)
    (hβ : ∀ x, (β x).hom ≫ ρ ≫ Y'.ι = ρ ≫ Y'.ι) [Etale (ρ ≫ Y'.ι)]
    (Q : Sheaf (Scheme.smallEtaleTopology X') AddCommGrpCat.{u+1}) (M : Type (u+1))
    [AddCommGroup M] (act : H →* AddMonoid.End M)
    (Φ : ∀ (V : X'.Etale) (O : E.Etale) (k : O.left ⟶ V.left), k ≫ V.hom = O.hom ≫ (ρ ≫ Y'.ι) →
        IsIso k → (Q.obj.obj (Opposite.op V) ≃+ LocallyConstant O.left M))
    (hΦ : ∀ (V V' : X'.Etale) (c : V' ⟶ V) (O O' : E.Etale) (d : O' ⟶ O)
        (k : O.left ⟶ V.left) (hk : k ≫ V.hom = O.hom ≫ (ρ ≫ Y'.ι)) (hki : IsIso k)
        (k' : O'.left ⟶ V'.left) (hk' : k' ≫ V'.hom = O'.hom ≫ (ρ ≫ Y'.ι)) (hki' : IsIso k'),
        k' ≫ c.left = d.left ≫ k → ∀ s : Q.obj.obj (Opposite.op V),
        Φ V' O' k' hk' hki' ((Q.obj.map c.op).hom s) =
          LocallyConstant.comap ⟨d.left, d.left.continuous⟩ (Φ V O k hk hki s))
    (htw : ∀ (x : H) (V : X'.Etale) (O O' : E.Etale)
      (k : O.left ⟶ V.left) (hk : k ≫ V.hom = O.hom ≫ (ρ ≫ Y'.ι)) (hki : IsIso k)
      (k' : O'.left ⟶ V.left) (hk' : k' ≫ V.hom = O'.hom ≫ (ρ ≫ Y'.ι)) (hki' : IsIso k')
      (w : O'.left ⟶ O.left), w ≫ k = k' → w ≫ O.hom ≫ (β x).hom = O'.hom →
      ∀ (s : Q.obj.obj (Opposite.op V)) (y : O'.left),
        Φ V O' k' hk' hki' s y = act x (Φ V O k hk hki s (w y)))
    (hdesc : ∀ (T V₁ : X'.Etale) (π : V₁ ⟶ T) (a : V₁.left ⟶ E), a ≫ (ρ ≫ Y'.ι) = V₁.hom →
      IsPullback π.left a T.hom (ρ ≫ Y'.ι) → (∀ t, T.hom t ∈ (Y' : Set X')) →
      (∀ s : Q.obj.obj (Opposite.op T), (Q.obj.map π.op).hom s = 0 → s = 0) ∧
      ∀ g : Q.obj.obj (Opposite.op V₁), (∀ (x : H) (d : V₁ ⟶ V₁), d ≫ π = π →
          d.left ≫ a = a ≫ (β x).hom → (Q.obj.map d.op).hom g = g) →
        ∃ s : Q.obj.obj (Opposite.op T), (Q.obj.map π.op).hom s = g) :
    ∃ r : Q.obj ⟶ wcLCPb (ρ ≫ Y'.ι) M,
      (∀ T : X'.Etale, (∀ t, T.hom t ∈ (Y' : Set X')) →
        Function.Injective (r.app (Opposite.op T)).hom) ∧
      (∀ (T : X'.Etale) (s : Q.obj.obj (Opposite.op T)) (x : H)
          (y : ((wcEtBaseChange (ρ ≫ Y'.ι)).obj T).left),
        (show LocallyConstant ((wcEtBaseChange (ρ ≫ Y'.ι)).obj T).left M from
            (r.app (Opposite.op T)).hom s)
          (wcPbρ (ρ ≫ Y'.ι) (ρ ≫ Y'.ι) (β x).hom (hβ x) T y) =
        act x ((show LocallyConstant ((wcEtBaseChange (ρ ≫ Y'.ι)).obj T).left M from
            (r.app (Opposite.op T)).hom s) y)) ∧
      (∀ T : X'.Etale, (∀ t, T.hom t ∈ (Y' : Set X')) →
        ∀ f : LocallyConstant ((wcEtBaseChange (ρ ≫ Y'.ι)).obj T).left M,
        (∀ x y, f (wcPbρ (ρ ≫ Y'.ι) (ρ ≫ Y'.ι) (β x).hom (hβ x) T y) = act x (f y)) →
        ∃ s : Q.obj.obj (Opposite.op T), ((r.app (Opposite.op T)).hom s :
            LocallyConstant ((wcEtBaseChange (ρ ≫ Y'.ι)).obj T).left M) = f) :=
by

  have hEtV : ∀ T : X'.Etale,
      Etale (((wcEtBaseChange (ρ ≫ Y'.ι)).obj T).hom ≫ (ρ ≫ Y'.ι)) := by
    intro T
    have : Etale ((wcEtBaseChange (ρ ≫ Y'.ι)).obj T).hom :=
      ((wcEtBaseChange (ρ ≫ Y'.ι)).obj T).prop
    infer_instance
  have hEtO : ∀ (T : X'.Etale) (x : H),
      Etale (((wcEtBaseChange (ρ ≫ Y'.ι)).obj T).hom ≫ (β x).hom) := by
    intro T x
    have : Etale ((wcEtBaseChange (ρ ≫ Y'.ι)).obj T).hom :=
      ((wcEtBaseChange (ρ ≫ Y'.ι)).obj T).prop
    have : IsIso (β x).hom := Iso.isIso_hom _
    infer_instance
  let V : X'.Etale → X'.Etale := fun T =>
    MorphismProperty.Over.mk ⊤ (((wcEtBaseChange (ρ ≫ Y'.ι)).obj T).hom ≫ (ρ ≫ Y'.ι)) (hEtV T)
  let O' : X'.Etale → H → E.Etale := fun T x =>
    MorphismProperty.Over.mk ⊤ (((wcEtBaseChange (ρ ≫ Y'.ι)).obj T).hom ≫ (β x).hom) (hEtO T x)
  have hk : ∀ T : X'.Etale, 𝟙 ((wcEtBaseChange (ρ ≫ Y'.ι)).obj T).left ≫ (V T).hom =
      ((wcEtBaseChange (ρ ≫ Y'.ι)).obj T).hom ≫ (ρ ≫ Y'.ι) := fun T => Category.id_comp _
  have hk' : ∀ (T : X'.Etale) (x : H), 𝟙 ((wcEtBaseChange (ρ ≫ Y'.ι)).obj T).left ≫ (V T).hom =
      (O' T x).hom ≫ (ρ ≫ Y'.ι) := by
    intro T x
    show 𝟙 _ ≫ (((wcEtBaseChange (ρ ≫ Y'.ι)).obj T).hom ≫ (ρ ≫ Y'.ι)) =
      (((wcEtBaseChange (ρ ≫ Y'.ι)).obj T).hom ≫ (β x).hom) ≫ (ρ ≫ Y'.ι)
    rw [Category.id_comp, Category.assoc, hβ x]
  let ΦT : ∀ T : X'.Etale, Q.obj.obj (Opposite.op (V T)) ≃+
      LocallyConstant ((wcEtBaseChange (ρ ≫ Y'.ι)).obj T).left M := fun T =>
    Φ (V T) ((wcEtBaseChange (ρ ≫ Y'.ι)).obj T) (𝟙 _) (hk T) (IsIso.id _)
  let ΦT' : ∀ (T : X'.Etale) (x : H), Q.obj.obj (Opposite.op (V T)) ≃+
      LocallyConstant (O' T x).left M := fun T x =>
    Φ (V T) (O' T x) (𝟙 _) (hk' T x) (IsIso.id _)
  let π : ∀ T : X'.Etale, V T ⟶ T := fun T =>
    MorphismProperty.Over.homMk (Limits.pullback.fst T.hom (ρ ≫ Y'.ι))
      (by
        show Limits.pullback.fst T.hom (ρ ≫ Y'.ι) ≫ T.hom =
          Limits.pullback.snd T.hom (ρ ≫ Y'.ι) ≫ (ρ ≫ Y'.ι)
        exact Limits.pullback.condition) trivial

  have hQ : ∀ {A B C : X'.Etale} (f : B ⟶ A) (g : C ⟶ B) (t : Q.obj.obj (Opposite.op A)),
      (Q.obj.map g.op).hom ((Q.obj.map f.op).hom t) = (Q.obj.map (g ≫ f).op).hom t := by
    intro A B C f g t
    rw [op_comp, Functor.map_comp]
    try rfl

  have hτf : ∀ (T : X'.Etale) (x : H),
      wcPbρ (ρ ≫ Y'.ι) (ρ ≫ Y'.ι) (β x).hom (hβ x) T ≫ Limits.pullback.fst T.hom (ρ ≫ Y'.ι) =
        Limits.pullback.fst T.hom (ρ ≫ Y'.ι) := fun T x => Limits.pullback.lift_fst _ _ _
  have hτs : ∀ (T : X'.Etale) (x : H),
      wcPbρ (ρ ≫ Y'.ι) (ρ ≫ Y'.ι) (β x).hom (hβ x) T ≫ Limits.pullback.snd T.hom (ρ ≫ Y'.ι) =
        Limits.pullback.snd T.hom (ρ ≫ Y'.ι) ≫ (β x).hom := fun T x => Limits.pullback.lift_snd _ _ _

  have hnat : ∀ (T T'' : X'.Etale) (c : T'' ⟶ T) (s : Q.obj.obj (Opposite.op T)),
      ΦT T'' ((Q.obj.map (π T'').op).hom ((Q.obj.map c.op).hom s)) =
        LocallyConstant.comap ⟨((wcEtBaseChange (ρ ≫ Y'.ι)).map c).left,
          ((wcEtBaseChange (ρ ≫ Y'.ι)).map c).left.continuous⟩
          (ΦT T ((Q.obj.map (π T).op).hom s)) := by
    intro T T'' c s
    let b := (wcEtBaseChange (ρ ≫ Y'.ι)).map c
    have hb : b.left ≫ ((wcEtBaseChange (ρ ≫ Y'.ι)).obj T).hom =
        ((wcEtBaseChange (ρ ≫ Y'.ι)).obj T'').hom := MorphismProperty.Over.w b
    have hbl : @Eq (Limits.pullback T''.hom (ρ ≫ Y'.ι) ⟶ Limits.pullback T.hom (ρ ≫ Y'.ι)) b.left
        (Limits.pullback.lift (Limits.pullback.fst T''.hom (ρ ≫ Y'.ι) ≫ c.left)
          (Limits.pullback.snd T''.hom (ρ ≫ Y'.ι))
          (by rw [Category.assoc, MorphismProperty.Over.w c]; exact Limits.pullback.condition)) :=
      rfl
    let ct : V T'' ⟶ V T := MorphismProperty.Over.homMk b.left
      (by
        show b.left ≫ (((wcEtBaseChange (ρ ≫ Y'.ι)).obj T).hom ≫ (ρ ≫ Y'.ι)) =
          ((wcEtBaseChange (ρ ≫ Y'.ι)).obj T'').hom ≫ (ρ ≫ Y'.ι)
        rw [← Category.assoc, hb]) trivial
    have hsq : π T'' ≫ c = ct ≫ π T := by
      apply MorphismProperty.Over.Hom.ext
      show Limits.pullback.fst T''.hom (ρ ≫ Y'.ι) ≫ c.left =
        b.left ≫ Limits.pullback.fst T.hom (ρ ≫ Y'.ι)
      exact ((congrArg (fun k => k ≫ Limits.pullback.fst T.hom (ρ ≫ Y'.ι)) hbl).trans
        (Limits.pullback.lift_fst _ _ _)).symm
    have e1 : (Q.obj.map (π T'').op).hom ((Q.obj.map c.op).hom s) =
        (Q.obj.map ct.op).hom ((Q.obj.map (π T).op).hom s) := by
      rw [hQ, hQ, hsq]
    rw [e1]
    exact hΦ (V T) (V T'') ct _ _ b (𝟙 _) (hk T) (IsIso.id _) (𝟙 _) (hk T'') (IsIso.id _)
      ((Category.id_comp _).trans (Category.comp_id _).symm) _
  let r : Q.obj ⟶ wcLCPb (ρ ≫ Y'.ι) M :=
    { app := fun T => AddCommGrpCat.ofHom
        ((ΦT T.unop).toAddMonoidHom.comp (Q.obj.map (π T.unop).op).hom)
      naturality := by
        intro T₁ T₂ f
        apply AddCommGrpCat.ext
        intro s
        exact hnat T₁.unop T₂.unop f.unop s }
  refine ⟨r, ?_, ?_, ?_⟩
  ·
    intro T hT
    rw [injective_iff_map_eq_zero]
    intro s hs
    have h0 : ΦT T ((Q.obj.map (π T).op).hom s) = 0 := hs
    have h1 : (Q.obj.map (π T).op).hom s = 0 := (ΦT T).injective (h0.trans (map_zero _).symm)
    exact (hdesc T (V T) (π T) (Limits.pullback.snd T.hom (ρ ≫ Y'.ι)) rfl
      (IsPullback.of_hasPullback T.hom (ρ ≫ Y'.ι)) hT).1 s h1
  ·
    intro T s x y
    have hdxw : wcPbρ (ρ ≫ Y'.ι) (ρ ≫ Y'.ι) (β x).hom (hβ x) T ≫
        (Limits.pullback.snd T.hom (ρ ≫ Y'.ι) ≫ (ρ ≫ Y'.ι)) =
          Limits.pullback.snd T.hom (ρ ≫ Y'.ι) ≫ (ρ ≫ Y'.ι) :=
      (Category.assoc (wcPbρ (ρ ≫ Y'.ι) (ρ ≫ Y'.ι) (β x).hom (hβ x) T)
        (Limits.pullback.snd T.hom (ρ ≫ Y'.ι)) (ρ ≫ Y'.ι)).symm.trans
        ((congrArg (fun k => k ≫ (ρ ≫ Y'.ι)) (hτs T x)).trans
        ((Category.assoc (Limits.pullback.snd T.hom (ρ ≫ Y'.ι)) (β x).hom (ρ ≫ Y'.ι)).trans
          (congrArg (fun k => Limits.pullback.snd T.hom (ρ ≫ Y'.ι) ≫ k) (hβ x))))
    let dx : V T ⟶ V T := MorphismProperty.Over.homMk
      (wcPbρ (ρ ≫ Y'.ι) (ρ ≫ Y'.ι) (β x).hom (hβ x) T) hdxw trivial
    let dO : O' T x ⟶ (wcEtBaseChange (ρ ≫ Y'.ι)).obj T := MorphismProperty.Over.homMk
      (wcPbρ (ρ ≫ Y'.ι) (ρ ≫ Y'.ι) (β x).hom (hβ x) T)
      (by
        show wcPbρ (ρ ≫ Y'.ι) (ρ ≫ Y'.ι) (β x).hom (hβ x) T ≫
            Limits.pullback.snd T.hom (ρ ≫ Y'.ι) =
          Limits.pullback.snd T.hom (ρ ≫ Y'.ι) ≫ (β x).hom
        exact hτs T x) trivial
    have hdπ : dx ≫ π T = π T := by
      apply MorphismProperty.Over.Hom.ext
      show wcPbρ (ρ ≫ Y'.ι) (ρ ≫ Y'.ι) (β x).hom (hβ x) T ≫
          Limits.pullback.fst T.hom (ρ ≫ Y'.ι) = Limits.pullback.fst T.hom (ρ ≫ Y'.ι)
      exact hτf T x
    have hdu : (Q.obj.map dx.op).hom ((Q.obj.map (π T).op).hom s) =
        (Q.obj.map (π T).op).hom s := by
      rw [hQ, hdπ]
    have i1 := htw x (V T) ((wcEtBaseChange (ρ ≫ Y'.ι)).obj T) (O' T x) (𝟙 _) (hk T)
      (IsIso.id _) (𝟙 _) (hk' T x) (IsIso.id _) (𝟙 _) (Category.id_comp _) (Category.id_comp _)
      ((Q.obj.map (π T).op).hom s) y
    have i2 := hΦ (V T) (V T) dx ((wcEtBaseChange (ρ ≫ Y'.ι)).obj T) (O' T x) dO (𝟙 _) (hk T)
      (IsIso.id _) (𝟙 _) (hk' T x) (IsIso.id _)
      ((Category.id_comp _).trans (Category.comp_id _).symm) ((Q.obj.map (π T).op).hom s)
    rw [hdu] at i2
    have i3 := DFunLike.congr_fun i2 y
    exact i3.symm.trans i1
  ·
    intro T hT f hf
    obtain ⟨g, hg⟩ : ∃ g, ΦT T g = f := ⟨_, AddEquiv.apply_symm_apply _ _⟩
    have hinv : ∀ (x : H) (d : V T ⟶ V T), d ≫ π T = π T →
        d.left ≫ Limits.pullback.snd T.hom (ρ ≫ Y'.ι) =
          Limits.pullback.snd T.hom (ρ ≫ Y'.ι) ≫ (β x).hom →
        (Q.obj.map d.op).hom g = g := by
      intro x d hd1 hd2
      have hdl : @Eq (Limits.pullback T.hom (ρ ≫ Y'.ι) ⟶ Limits.pullback T.hom (ρ ≫ Y'.ι))
          d.left (wcPbρ (ρ ≫ Y'.ι) (ρ ≫ Y'.ι) (β x).hom (hβ x) T) := by
        apply Limits.pullback.hom_ext
        · exact (congrArg (fun k => k.left) hd1).trans (hτf T x).symm
        · exact hd2.trans (hτs T x).symm
      let dO : O' T x ⟶ (wcEtBaseChange (ρ ≫ Y'.ι)).obj T :=
        MorphismProperty.Over.homMk d.left hd2 trivial
      have j1 := hΦ (V T) (V T) d ((wcEtBaseChange (ρ ≫ Y'.ι)).obj T) (O' T x) dO (𝟙 _) (hk T)
        (IsIso.id _) (𝟙 _) (hk' T x) (IsIso.id _)
        ((Category.id_comp _).trans (Category.comp_id _).symm) g
      apply (ΦT' T x).injective
      refine j1.trans ?_
      apply LocallyConstant.ext
      intro y
      have j2 := htw x (V T) ((wcEtBaseChange (ρ ≫ Y'.ι)).obj T) (O' T x) (𝟙 _) (hk T)
        (IsIso.id _) (𝟙 _) (hk' T x) (IsIso.id _) (𝟙 _) (Category.id_comp _) (Category.id_comp _)
        g y
      refine Eq.trans ?_ j2.symm
      show ΦT T g (d.left y) = act x (ΦT T g y)
      rw [hdl, hg]
      exact hf x y
    obtain ⟨s, hs⟩ := (hdesc T (V T) (π T) (Limits.pullback.snd T.hom (ρ ≫ Y'.ι)) rfl
      (IsPullback.of_hasPullback T.hom (ρ ≫ Y'.ι)) hT).2 g hinv
    refine ⟨s, ?_⟩
    show ΦT T ((Q.obj.map (π T).op).hom s) = f
    rw [hs, hg]

theorem wc_gal_desc_of_restriction {X' E : Scheme.{u}} (Y' : X'.Opens)
    (ρ : E ⟶ (Y' : Scheme.{u})) (H : Type u) [Group H] (β : H →* Aut E)
    (hβ : ∀ x, (β x).hom ≫ ρ ≫ Y'.ι = ρ ≫ Y'.ι)
    (Q : Sheaf (Scheme.smallEtaleTopology X') AddCommGrpCat.{u+1})
    (hQ : wcSuppIn X' (Y' : Set X') Q) (M : Type (u+1)) [AddCommGroup M]
    (act : H →* AddMonoid.End M) (r : Q.obj ⟶ wcLCPb (ρ ≫ Y'.ι) M)
    (hinj : ∀ T : X'.Etale, (∀ t, T.hom t ∈ (Y' : Set X')) →
        Function.Injective (r.app (Opposite.op T)).hom)
    (hequiv : ∀ (T : X'.Etale) (s : Q.obj.obj (Opposite.op T)) (x : H)
          (y : ((wcEtBaseChange (ρ ≫ Y'.ι)).obj T).left),
        (show LocallyConstant ((wcEtBaseChange (ρ ≫ Y'.ι)).obj T).left M from
            (r.app (Opposite.op T)).hom s)
          (wcPbρ (ρ ≫ Y'.ι) (ρ ≫ Y'.ι) (β x).hom (hβ x) T y) =
        act x ((show LocallyConstant ((wcEtBaseChange (ρ ≫ Y'.ι)).obj T).left M from
            (r.app (Opposite.op T)).hom s) y))
    (hsurj : ∀ T : X'.Etale, (∀ t, T.hom t ∈ (Y' : Set X')) →
        ∀ f : LocallyConstant ((wcEtBaseChange (ρ ≫ Y'.ι)).obj T).left M,
        (∀ x y, f (wcPbρ (ρ ≫ Y'.ι) (ρ ≫ Y'.ι) (β x).hom (hβ x) T y) = act x (f y)) →
        ∃ s : Q.obj.obj (Opposite.op T), ((r.app (Opposite.op T)).hom s :
            LocallyConstant ((wcEtBaseChange (ρ ≫ Y'.ι)).obj T).left M) = f) :
    Nonempty (Q ≅ wcGalDesc (ρ ≫ Y'.ι) (Y' : Set X') H β hβ M act ⊤) :=
by
  classical

  have hPinh : ∀ {T T'' : X'.Etale} (c : T'' ⟶ T), (∀ t, T.hom t ∈ (Y' : Set X')) →
      ∀ t, T''.hom t ∈ (Y' : Set X') := by
    intro T T'' c hP t
    rw [← MorphismProperty.Over.w c, Scheme.Hom.comp_apply]
    exact hP _

  have hnat : ∀ {T T'' : X'.Etale} (c : T'' ⟶ T) (s : Q.obj.obj (Opposite.op T)),
      ((r.app (Opposite.op T'')).hom ((Q.obj.map c.op).hom s) :
        LocallyConstant ((wcEtBaseChange (ρ ≫ Y'.ι)).obj T'').left M) =
        wcGalRes (ρ ≫ Y'.ι) M c ((r.app (Opposite.op T)).hom s) :=
    fun {T T''} c s => congrArg
      (fun φ : Q.obj.obj (Opposite.op T) ⟶ (wcLCPb (ρ ≫ Y'.ι) M).obj (Opposite.op T'') => φ.hom s)
      (r.naturality c.op)

  have hid : ∀ (T : X'.Etale) (f : LocallyConstant ((wcEtBaseChange (ρ ≫ Y'.ι)).obj T).left M),
      wcGalRes (ρ ≫ Y'.ι) M (𝟙 T) f = f := by
    intro T f
    show ((wcLCPb (ρ ≫ Y'.ι) M).map (𝟙 T).op).hom f = f
    rw [op_id, CategoryTheory.Functor.map_id]
    rfl

  have hmem : ∀ T : X'.Etale, (∀ t, T.hom t ∈ (Y' : Set X')) → ∀ (s : Q.obj.obj (Opposite.op T))
      (f : LocallyConstant ((wcEtBaseChange (ρ ≫ Y'.ι)).obj T).left M),
      (r.app (Opposite.op T)).hom s = f →
      f ∈ wcGalDescSub (ρ ≫ Y'.ι) (Y' : Set X') H β hβ M act ⊤ T := by
    intro T hP s f hf
    subst hf
    intro T'' c
    rw [← hnat c s]
    exact ⟨fun y => AddSubgroup.mem_top _,
      fun x y => hequiv T'' ((Q.obj.map c.op).hom s) x y, Or.inr (hPinh c hP)⟩

  have hall : ∀ T : X'.Etale, (∀ t, T.hom t ∈ (Y' : Set X')) →
      ∀ f ∈ wcGalDescSub (ρ ≫ Y'.ι) (Y' : Set X') H β hβ M act ⊤ T,
      ∃ s : Q.obj.obj (Opposite.op T), ((r.app (Opposite.op T)).hom s :
        LocallyConstant ((wcEtBaseChange (ρ ≫ Y'.ι)).obj T).left M) = f := by
    intro T hP f hf
    have h2 := (hf T (𝟙 T)).2.1
    simp only [hid] at h2
    exact hsurj T hP f h2

  have hzero : ∀ T : X'.Etale, ¬ (∀ t, T.hom t ∈ (Y' : Set X')) →
      ∀ f ∈ wcGalDescSub (ρ ≫ Y'.ι) (Y' : Set X') H β hβ M act ⊤ T, f = 0 := by
    intro T hP f hf
    have h3 := (hf T (𝟙 T)).2.2
    rw [hid] at h3
    exact h3.resolve_right hP
  have hzero' : ∀ T : (X'.Etale)ᵒᵖ, ¬ (∀ t, T.unop.hom t ∈ (Y' : Set X')) →
      ∀ f : wcGalDescSub (ρ ≫ Y'.ι) (Y' : Set X') H β hβ M act ⊤ T.unop, f = 0 :=
    fun T hP f => Subtype.ext (hzero T.unop hP f.1 f.2)

  let ee : ∀ (T : X'.Etale), (∀ t, T.hom t ∈ (Y' : Set X')) →
      (Q.obj.obj (Opposite.op T) ≃+ wcGalDescSub (ρ ≫ Y'.ι) (Y' : Set X') H β hβ M act ⊤ T) :=
    fun T hP => AddEquiv.ofBijective
      (AddMonoidHom.codRestrict
        (show Q.obj.obj (Opposite.op T) →+ LocallyConstant ((wcEtBaseChange (ρ ≫ Y'.ι)).obj T).left M
          from (r.app (Opposite.op T)).hom)
        (wcGalDescSub (ρ ≫ Y'.ι) (Y' : Set X') H β hβ M act ⊤ T)
        (fun s => hmem T hP s _ rfl))
      ⟨fun s₁ s₂ h => hinj T hP (congrArg Subtype.val h),
       fun f => (hall T hP f.1 f.2).imp fun s hs => Subtype.ext hs⟩
  let a : ∀ T : (X'.Etale)ᵒᵖ, wcGalDescSub (ρ ≫ Y'.ι) (Y' : Set X') H β hβ M act ⊤ T.unop →+
      Q.obj.obj T :=
    fun T => if hP : (∀ t, T.unop.hom t ∈ (Y' : Set X')) then (ee T.unop hP).symm.toAddMonoidHom
      else 0
  have K1 : ∀ (T : (X'.Etale)ᵒᵖ) (hP : ∀ t, T.unop.hom t ∈ (Y' : Set X'))
      (f : wcGalDescSub (ρ ≫ Y'.ι) (Y' : Set X') H β hβ M act ⊤ T.unop),
      ((r.app T).hom (a T f) : LocallyConstant ((wcEtBaseChange (ρ ≫ Y'.ι)).obj T.unop).left M) =
        f.1 := by
    intro T hP f
    have h1 : a T f = (ee T.unop hP).symm f := by
      simp only [a, dif_pos hP] <;> rfl
    rw [h1]
    exact congrArg Subtype.val ((ee T.unop hP).apply_symm_apply f)
  let α : wcGalDescPre (ρ ≫ Y'.ι) (Y' : Set X') H β hβ M act ⊤ ⟶ Q.obj :=
    { app := fun T => AddCommGrpCat.ofHom (a T)
      naturality := by
        intro T T' c
        apply AddCommGrpCat.hom_ext
        apply AddMonoidHom.ext
        intro f
        by_cases hP : ∀ t, T.unop.hom t ∈ (Y' : Set X')
        · have hP' : ∀ t, T'.unop.hom t ∈ (Y' : Set X') := hPinh c.unop hP
          apply hinj T'.unop hP'
          refine (K1 T' hP'
            (((wcGalDescPre (ρ ≫ Y'.ι) (Y' : Set X') H β hβ M act ⊤).map c).hom f)).trans ?_
          exact (congrArg (wcGalRes (ρ ≫ Y'.ι) M c.unop) (K1 T hP f)).symm.trans
            (hnat c.unop (a T f)).symm
        · have e1 : ((wcGalDescPre (ρ ≫ Y'.ι) (Y' : Set X') H β hβ M act ⊤).map c).hom f = 0 := by
            apply Subtype.ext
            show wcGalRes (ρ ≫ Y'.ι) M c.unop f.1 = 0
            rw [hzero T.unop hP f.1 f.2, map_zero]
          have e2 : a T f = 0 := by
            rw [hzero' T hP f]
            exact map_zero _
          change a T' (((wcGalDescPre (ρ ≫ Y'.ι) (Y' : Set X') H β hβ M act ⊤).map c).hom f) =
            (Q.obj.map c).hom (a T f)
          rw [e1, e2]
          exact (map_zero (a T')).trans (map_zero (Q.obj.map c).hom).symm }
  have hαinj : ∀ T, Function.Injective (α.app T).hom := by
    intro T f g hfg
    by_cases hP : ∀ t, T.unop.hom t ∈ (Y' : Set X')
    · apply Subtype.ext
      exact (K1 T hP f).symm.trans ((congrArg (r.app T).hom hfg).trans (K1 T hP g))
    · exact (hzero' T hP f).trans (hzero' T hP g).symm
  have hαsurj : ∀ T : X'.Etale, (∀ t, T.hom t ∈ (Y' : Set X')) →
      Function.Surjective (α.app (Opposite.op T)).hom := by
    intro T hP s
    refine ⟨(⟨(r.app (Opposite.op T)).hom s, hmem T hP s _ rfl⟩ :
      wcGalDescSub (ρ ≫ Y'.ι) (Y' : Set X') H β hβ M act ⊤ T), ?_⟩
    apply hinj T hP
    exact K1 (Opposite.op T) hP _

  have hlinj : Presheaf.IsLocallyInjective (Scheme.smallEtaleTopology X') α := by
    apply Presheaf.isLocallyInjective_of_injective
    intro T
    exact hαinj T
  have hlsurj : Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology X') α := by
    apply Presheaf.IsLocallySurjective.mk
    intro U s
    apply (Scheme.smallEtaleTopology X').superset_covering _ (hQ U s)
    rw [Sieve.generate_le_iff]
    intro V g hg
    change (Presheaf.imageSieve α s).arrows g
    rw [Presheaf.imageSieve_apply]
    rcases hg with h0 | hP
    · refine ⟨0, ?_⟩
      rw [map_zero]
      exact h0.symm
    · exact hαsurj V hP _
  have hW : (Scheme.smallEtaleTopology X').W α :=
    (GrothendieckTopology.W_iff_isLocallyBijective _ α).2 ⟨hlinj, hlsurj⟩
  haveI := (GrothendieckTopology.W_iff _ α).1 hW
  exact ⟨sheafificationIso Q ≪≫
    (asIso ((presheafToSheaf (Scheme.smallEtaleTopology X') AddCommGrpCat.{u+1}).map α)).symm⟩

theorem wc_gal_desc_recognize {X' E : Scheme.{u}} (Y' : X'.Opens) (ρ : E ⟶ (Y' : Scheme.{u}))
    (H : Type u) [Group H] (β : H →* Aut E) (hρ : wcGalCover ρ H β)
    (hβ : ∀ x, (β x).hom ≫ ρ ≫ Y'.ι = ρ ≫ Y'.ι) (hconn : ConnectedSpace E)
    (L' : Sheaf (Scheme.smallEtaleTopology X') AddCommGrpCat.{u+1} ⥤
      Sheaf (Scheme.smallEtaleTopology E) AddCommGrpCat.{u+1})
    (hL' : Nonempty (L' ⊣ wcEtPush (ρ ≫ Y'.ι)))
    (Q : Sheaf (Scheme.smallEtaleTopology X') AddCommGrpCat.{u+1})
    (hQ : wcSuppIn X' (Y' : Set X') Q) (M : Type (u+1)) [AddCommGroup M]
    (eM : L'.obj Q ≅ (constantSheaf (Scheme.smallEtaleTopology E) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of M)) :
    ∃ act : H →* AddMonoid.End M,
      Nonempty (Q ≅ wcGalDesc (ρ ≫ Y'.ι) (Y' : Set X') H β hβ M act ⊤) :=
by
  classical
  obtain ⟨hHfin, hfin, het, hsurjρ, hα, hiso⟩ := id hρ
  haveI : Etale ρ := het
  haveI hEt' : Etale (ρ ≫ Y'.ι) := inferInstance

  have hjs : ∀ (Y : Scheme.{u}) (V : Y.Etale) (S : Sieve V), (∀ v : V.left, ∃ (V₁ : Y.Etale)
      (c : V₁ ⟶ V), S.arrows c ∧ v ∈ Set.range c.left) → S ∈ Scheme.smallEtaleTopology Y V := by
    intro Y V S hS
    change S ∈ Scheme.smallGrothendieckTopology @Etale Y V
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
    apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
    intro x
    obtain ⟨V₁, c, hc, y, hy⟩ := hS x
    have hw : c.left ≫ V.hom = V₁.hom := MorphismProperty.Over.w c
    have hEt : Etale c.left := by
      have h1 : Etale V.hom := V.prop
      have h2 : Etale (c.left ≫ V.hom) := by rw [hw]; exact V₁.prop
      exact Etale.of_comp c.left V.hom
    exact ⟨V₁, c, y, hc, hEt, hy⟩
  have hcov : ∀ {X B : Scheme.{u}} (g : X ⟶ B), CoverPreserving (Scheme.smallEtaleTopology B)
      (Scheme.smallEtaleTopology X) (wcEtBaseChange g) := by
    intro X B g
    constructor
    intro V S hS
    change S ∈ Scheme.smallGrothendieckTopology @Etale B V at hS
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale B
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hS
    have hS' := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale B
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mp hS
    apply hjs
    intro v
    obtain ⟨W, a, w, ha, -, hw⟩ := hS' (Limits.pullback.fst V.hom g v)
    refine ⟨(wcEtBaseChange g).obj W, (wcEtBaseChange g).map a,
      Sieve.image_mem_functorPushforward (wcEtBaseChange g) S ha, ?_⟩
    have h0 : (Limits.pullback.fst W.hom g ≫ a.left) ≫ V.hom = Limits.pullback.snd W.hom g ≫ g := by
      rw [Category.assoc, MorphismProperty.Over.w a]
      exact Limits.pullback.condition
    let m : Limits.pullback W.hom g ⟶ Limits.pullback V.hom g :=
      Limits.pullback.lift (Limits.pullback.fst W.hom g ≫ a.left) (Limits.pullback.snd W.hom g) h0
    have hmap : ((wcEtBaseChange g).map a).left = m := rfl
    have h1 : Limits.pullback.fst a.left (Limits.pullback.fst V.hom g) ≫ W.hom =
        (Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) ≫ Limits.pullback.snd V.hom g) ≫ g := by
      rw [← MorphismProperty.Over.w a, ← Category.assoc, Limits.pullback.condition, Category.assoc,
        Limits.pullback.condition, Category.assoc]
    let ψ : Limits.pullback a.left (Limits.pullback.fst V.hom g) ⟶ Limits.pullback W.hom g :=
      Limits.pullback.lift (Limits.pullback.fst a.left (Limits.pullback.fst V.hom g))
        (Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) ≫ Limits.pullback.snd V.hom g) h1
    have hψ : ψ ≫ m = Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, Limits.pullback.lift_fst, ← Category.assoc, Limits.pullback.lift_fst,
          Limits.pullback.condition]
      · rw [Category.assoc, Limits.pullback.lift_snd, Limits.pullback.lift_snd]
    obtain ⟨z, hz⟩ : ∃ z, Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) z = v := by
      have hv : (v : ↥(Limits.pullback V.hom g)) ∈
          Set.range (Limits.pullback.snd a.left (Limits.pullback.fst V.hom g)) := by
        rw [Scheme.Pullback.range_snd]
        exact ⟨w, hw⟩
      exact hv
    rw [hmap]
    exact ⟨ψ z, (Scheme.Hom.comp_apply ψ m z).symm.trans (by rw [hψ]; exact hz)⟩
  have hcont : ∀ {X B : Scheme.{u}} (g : X ⟶ B), (wcEtBaseChange g).IsContinuous
      (Scheme.smallEtaleTopology B) (Scheme.smallEtaleTopology X) := by
    intro X B g
    haveI h1 : Limits.PreservesFiniteLimits (wcEtBaseChange g) := ⟨fun J _ _ =>
      haveI : Limits.PreservesLimitsOfShape J (wcEtBaseChange g ⋙ Scheme.Etale.forget X) :=
        Limits.preservesLimitsOfShape_of_natIso
          (NatIso.ofComponents (fun _ => Iso.refl _) (fun _ => rfl) :
            Scheme.Etale.forget B ⋙ Over.pullback g ≅ wcEtBaseChange g ⋙ Scheme.Etale.forget X)
      Limits.preservesLimitsOfShape_of_reflects_of_preserves (wcEtBaseChange g)
        (Scheme.Etale.forget X)⟩
    haveI := flat_of_preservesFiniteLimits (wcEtBaseChange g)
    exact Functor.isContinuous_of_coverPreserving (compatiblePreservingOfFlat _ _) (hcov g)
  haveI := hcont (ρ ≫ Y'.ι)

  obtain ⟨Φ, hΦ⟩ := wc_gal_triv_sections (ρ ≫ Y'.ι) L' hL' Q M eM

  obtain ⟨act, htw⟩ := wc_gal_twist_action (ρ ≫ Y'.ι) H β hβ hconn Q M Φ hΦ

  have hdeck : ∀ (Z : Scheme.{u}) (p₁ p₂ : Z ⟶ E), p₁ ≫ (ρ ≫ Y'.ι) = p₂ ≫ (ρ ≫ Y'.ι) →
      ∃ U : H → Z.Opens, (∀ z : Z, ∃ x, z ∈ U x) ∧
        ∀ x, (U x).ι ≫ p₁ = (U x).ι ≫ p₂ ≫ (β x).hom := by
    intro Z p₁ p₂ hp
    have hp' : p₁ ≫ ρ = p₂ ≫ ρ := by
      rw [← cancel_mono Y'.ι, Category.assoc, Category.assoc]
      exact hp
    let Ψ : ∐ (fun _ : H => E) ⟶ Limits.pullback ρ ρ :=
      Limits.Sigma.desc (fun γ : H => Limits.pullback.lift (β γ).hom (𝟙 E)
        ((hα γ).trans (Category.id_comp ρ).symm))
    haveI : IsIso Ψ := hiso
    let μ : Z ⟶ ∐ (fun _ : H => E) := Limits.pullback.lift p₁ p₂ hp' ≫ inv Ψ
    have hμΨ : μ ≫ Ψ = Limits.pullback.lift p₁ p₂ hp' := by
      simp only [μ, Category.assoc, IsIso.inv_hom_id, Category.comp_id]
    refine ⟨fun x => μ ⁻¹ᵁ (Limits.Sigma.ι (fun _ : H => E) x).opensRange, ?_, ?_⟩
    · intro z
      obtain ⟨⟨i, y⟩, hy⟩ : ∃ q, (sigmaMk (fun _ : H => E)) q = μ z :=
        ⟨(sigmaMk (fun _ : H => E)).symm (μ z), Homeomorph.apply_symm_apply _ _⟩
      refine ⟨i, ?_⟩
      show μ z ∈ (Limits.Sigma.ι (fun _ : H => E) i).opensRange
      rw [Scheme.Hom.mem_opensRange]
      exact ⟨y, (sigmaMk_mk (fun _ : H => E) i y).symm.trans hy⟩
    · intro x
      have hsub : Set.range ((μ ⁻¹ᵁ (Limits.Sigma.ι (fun _ : H => E) x).opensRange).ι ≫ μ) ⊆
          Set.range (Limits.Sigma.ι (fun _ : H => E) x) := by
        rintro _ ⟨z, rfl⟩
        have hz : (μ ⁻¹ᵁ (Limits.Sigma.ι (fun _ : H => E) x).opensRange).ι z ∈
            μ ⁻¹ᵁ (Limits.Sigma.ι (fun _ : H => E) x).opensRange :=
          (Scheme.Opens.range_ι (μ ⁻¹ᵁ (Limits.Sigma.ι (fun _ : H => E) x).opensRange)).subset
            ⟨z, rfl⟩
        have hz' : μ ((μ ⁻¹ᵁ (Limits.Sigma.ι (fun _ : H => E) x).opensRange).ι z) ∈
            (Limits.Sigma.ι (fun _ : H => E) x).opensRange := hz
        obtain ⟨y, hy⟩ := Scheme.Hom.mem_opensRange.mp hz'
        rw [Scheme.Hom.comp_apply]
        exact ⟨y, hy⟩
      obtain ⟨κ, hκ⟩ : ∃ κ, κ ≫ Limits.Sigma.ι (fun _ : H => E) x =
          (μ ⁻¹ᵁ (Limits.Sigma.ι (fun _ : H => E) x).opensRange).ι ≫ μ :=
        ⟨_, IsOpenImmersion.lift_fac _ _ hsub⟩
      have h2 : (μ ⁻¹ᵁ (Limits.Sigma.ι (fun _ : H => E) x).opensRange).ι ≫
          Limits.pullback.lift p₁ p₂ hp' = κ ≫ Limits.pullback.lift (β x).hom (𝟙 E)
            ((hα x).trans (Category.id_comp ρ).symm) := by
        rw [← hμΨ, ← Category.assoc, ← hκ, Category.assoc]
        congr 1
        exact Limits.Sigma.ι_comp_desc _ x
      have e1 := congrArg (fun k => k ≫ Limits.pullback.fst ρ ρ) h2
      have e2 := congrArg (fun k => k ≫ Limits.pullback.snd ρ ρ) h2
      simp only [Category.assoc, Limits.pullback.lift_fst, Limits.pullback.lift_snd,
        Category.comp_id] at e1 e2
      rw [e1, ← Category.assoc, e2]

  have hdesc : ∀ (T V₁ : X'.Etale) (π : V₁ ⟶ T) (a : V₁.left ⟶ E), a ≫ (ρ ≫ Y'.ι) = V₁.hom →
      IsPullback π.left a T.hom (ρ ≫ Y'.ι) → (∀ t, T.hom t ∈ (Y' : Set X')) →
      (∀ s : Q.obj.obj (Opposite.op T), (Q.obj.map π.op).hom s = 0 → s = 0) ∧
      ∀ g : Q.obj.obj (Opposite.op V₁), (∀ (x : H) (d : V₁ ⟶ V₁), d ≫ π = π →
          d.left ≫ a = a ≫ (β x).hom → (Q.obj.map d.op).hom g = g) →
        ∃ s : Q.obj.obj (Opposite.op T), (Q.obj.map π.op).hom s = g := by
    intro T V₁ π a ha hpb hT
    refine wc_gal_single_cover_descent (ρ ≫ Y'.ι) H β hβ hdeck Q T V₁ π a ha hpb ?_
    intro t
    have h1 : T.hom t ∈ Set.range Y'.ι := by
      rw [Scheme.Opens.range_ι]
      exact hT t
    obtain ⟨y', hy'⟩ := h1
    obtain ⟨e₀, he₀⟩ := @AlgebraicGeometry.Surjective.surj _ _ ρ hsurjρ y'
    exact ⟨e₀, by rw [Scheme.Hom.comp_apply, he₀, hy']⟩

  obtain ⟨r, hinj, hequiv, hsurj⟩ :=
    wc_gal_restriction_from_triv Y' ρ H β hβ Q M act Φ hΦ htw hdesc

  exact ⟨act, wc_gal_desc_of_restriction Y' ρ H β hβ Q hQ M act r hinj hequiv hsurj⟩

theorem wc_et_galois_descended_flag {X X' E : Scheme.{u}} (ℓ : ℕ) (hℓ : ℓ.Prime) (U V : X.Etale)
    (g : (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
      (yoneda.obj V ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶
      (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
      (yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
    (htor : ℓ • 𝟙 (Limits.cokernel g) = 0) (W₁ : X.Opens) (h : X' ⟶ X) [IsFinite h]
    (e : E ⟶ X) (ρ : E ⟶ (h ⁻¹ᵁ W₁ : Scheme.{u})) (hρe : ρ ≫ (h ⁻¹ᵁ W₁).ι ≫ h = e)
    (H : Type u) [Group H] (hH : IsPGroup ℓ H) (β : H →* Aut E) (hρ : wcGalCover ρ H β)
    (hconn : ConnectedSpace E) (A B : Type u) (a : A → (E ⟶ U.left)) (b : B → (E ⟶ V.left))
    (ha : wcEtSplits e U A a) (hb : wcEtSplits e V B b)
    (L : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1} ⥤
      Sheaf (Scheme.smallEtaleTopology X') AddCommGrpCat.{u+1})
    (hL : Nonempty (L ⊣ wcEtPush h)) :
    ∃ (n : ℕ) (P : ℕ → Sheaf (Scheme.smallEtaleTopology X') AddCommGrpCat.{u+1}),
      Limits.IsZero (P 0) ∧
      Nonempty (P n ≅ L.obj (Limits.image ((presheafToSheaf (Scheme.smallEtaleTopology X)
        AddCommGrpCat.{u+1}).map (Functor.whiskerRight
          (yoneda.map (wcEtOpenι X U (U.hom ⁻¹ᵁ W₁)))
          (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) ≫ Limits.cokernel.π g))) ∧
      ∀ k < n, ∃ S : ShortComplex (Sheaf (Scheme.smallEtaleTopology X') AddCommGrpCat.{u+1}),
        S.ShortExact ∧ Nonempty (S.X₁ ≅ P k) ∧ Nonempty (S.X₂ ≅ P (k + 1)) ∧
        Nonempty (S.X₃ ≅ wcEtExtZero X' ((h ⁻¹ᵁ W₁ : X'.Opens) : Set X') ℓ) :=
by
  obtain ⟨_, _, _, _, hα, _⟩ := id hρ
  have hβ : ∀ x, (β x).hom ≫ ρ ≫ (h ⁻¹ᵁ W₁).ι = ρ ≫ (h ⁻¹ᵁ W₁).ι := fun x => by
    rw [← Category.assoc, hα x]
  obtain ⟨L', hL', -, -⟩ := wc_et_push_left_adjoint (ρ ≫ (h ⁻¹ᵁ W₁).ι)
  obtain ⟨M, _, hMfin, hMtor, ⟨eM⟩⟩ := wc_et_flag_const_on_cover ℓ hℓ U V g htor W₁ h e ρ hρe
    hconn A B a b ha hb L hL L' hL'
  have hsupp := wc_et_image_open_supp U W₁ (Limits.cokernel g) (Limits.cokernel.π g)
  have hsupp' := wc_et_supp_left_adjoint_pullback h L hL _ _ hsupp
  obtain ⟨act, ⟨eQ⟩⟩ := wc_gal_desc_recognize (h ⁻¹ᵁ W₁) ρ H β hρ hβ hconn L' hL' _ hsupp' M eM
  haveI : Finite M := hMfin
  haveI : Finite H := hρ.1
  obtain ⟨n, K, hK0, hKn, hKst, hstep⟩ := wc_pgroup_flag_functionals ℓ hℓ H hH M hMtor act
  refine ⟨n, fun k => wcGalDesc (ρ ≫ (h ⁻¹ᵁ W₁).ι) ((h ⁻¹ᵁ W₁ : X'.Opens) : Set X') H β hβ M act
    (K k), ?_, ?_, ?_⟩
  · show Limits.IsZero (wcGalDesc (ρ ≫ (h ⁻¹ᵁ W₁).ι) ((h ⁻¹ᵁ W₁ : X'.Opens) : Set X') H β hβ M act
      (K 0))
    rw [hK0]
    have hz : Limits.IsZero (wcGalDescPre (ρ ≫ (h ⁻¹ᵁ W₁).ι) ((h ⁻¹ᵁ W₁ : X'.Opens) : Set X')
        H β hβ M act ⊥) := by
      apply Functor.isZero
      intro T
      have h0 : ∀ f : wcGalDescSub (ρ ≫ (h ⁻¹ᵁ W₁).ι) ((h ⁻¹ᵁ W₁ : X'.Opens) : Set X') H β hβ M
          act ⊥ T.unop, f = 0 := by
        intro f
        apply Subtype.ext
        apply LocallyConstant.ext
        intro y
        have h1 := (f.2 T.unop (𝟙 _)).1 y
        rw [AddSubgroup.mem_bot] at h1
        have hid : wcGalRes (ρ ≫ (h ⁻¹ᵁ W₁).ι) M (𝟙 T.unop) f.1 = f.1 := by
          show ((wcLCPb (ρ ≫ (h ⁻¹ᵁ W₁).ι) M).map (𝟙 T.unop).op).hom f.1 = f.1
          rw [op_id, CategoryTheory.Functor.map_id]
          rfl
        rw [hid] at h1
        exact h1
      haveI : Subsingleton ((wcGalDescPre (ρ ≫ (h ⁻¹ᵁ W₁).ι) ((h ⁻¹ᵁ W₁ : X'.Opens) : Set X')
          H β hβ M act ⊥).obj T) := ⟨fun f g => (h0 f).trans (h0 g).symm⟩
      exact AddCommGrpCat.isZero_of_subsingleton _
    exact Functor.map_isZero (presheafToSheaf (Scheme.smallEtaleTopology X') AddCommGrpCat.{u+1}) hz
  · show Nonempty (wcGalDesc (ρ ≫ (h ⁻¹ᵁ W₁).ι) ((h ⁻¹ᵁ W₁ : X'.Opens) : Set X') H β hβ M act
      (K n) ≅ _)
    rw [hKn]
    exact ⟨eQ.symm⟩
  · intro k hk
    obtain ⟨hle, π, hπ0, hπ1, hπinv⟩ := hstep k hk
    obtain ⟨S, hS, e1, e2, ⟨e3⟩⟩ := wc_gal_desc_step (h ⁻¹ᵁ W₁) ρ H β hρ hβ ℓ M act (K k)
      (K (k + 1)) (hKst k) (hKst (k + 1)) hle π hπ0 hπ1 hπinv
    obtain ⟨e4⟩ := wc_gal_desc_trivial_iso (h ⁻¹ᵁ W₁) ρ H β hρ hβ ℓ
    exact ⟨S, hS, e1, e2, ⟨e3 ≪≫ e4⟩⟩

theorem wc_et_fp_generic_open_part : ∀ (K : Type u) [Field K] (X : Scheme.{u}) (f : X ⟶ Spec (.of K)) [IsProper f] (ℓ : ℕ), ℓ.Prime → (ℓ : K) ≠ 0 → ∀ (𝒟 : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1} → Prop), (∀ (A B : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}), Nonempty (A ≅ B) → 𝒟 A → 𝒟 B) → (∀ (S : ShortComplex (Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1})), S.ShortExact → 𝒟 S.X₁ → 𝒟 S.X₃ → 𝒟 S.X₂) → (∀ (A B : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) (s : A ⟶ B) (r : B ⟶ A), s ≫ r = 𝟙 A → 𝒟 B → 𝒟 A) → (∀ (W : Scheme.{u}) (π : W ⟶ X) [IsFinite π] (S : Set W), IsOpen S → Dense S → 𝒟 ((wcEtPush π).obj (wcEtExtZero W S ℓ))) → Nonempty X → ∀ (U V : X.Etale) (g : (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj (yoneda.obj V ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶ (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj (yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)), CompactSpace U.left → QuasiSeparatedSpace U.left → CompactSpace V.left → QuasiSeparatedSpace V.left → ℓ • 𝟙 (Limits.cokernel g) = 0 → ∃ W : X.Opens, (W : Set X).Nonempty ∧ 𝒟 (Limits.image ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map (Functor.whiskerRight (yoneda.map (wcEtOpenι X U (U.hom ⁻¹ᵁ W))) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) ≫ Limits.cokernel.π g)) :=
by
  intro K _ X f _ ℓ hℓ _ 𝒟 hI hE hR hG hX U V g hU hU' hV hV' htor
  classical
  haveI : Fact ℓ.Prime := ⟨hℓ⟩

  obtain ⟨W₁, E, q, Γ, _, α, A, B, a, b, hW₁ne, hW₁aff, hEaff, hEconn, hq, ha, hb⟩ :=
    wc_et_generic_galois_split K X f hX U V hU hU' hV hV'
  haveI : Finite Γ := hq.1
  haveI : Etale q := hq.2.2.1
  haveI : AlgebraicGeometry.Surjective q := hq.2.2.2.1

  obtain ⟨P⟩ : Nonempty (Sylow ℓ Γ) := inferInstance
  have hPp : IsPGroup ℓ (P : Subgroup Γ) := P.isPGroup'
  have hPidx : ¬ ℓ ∣ (P : Subgroup Γ).index := P.not_dvd_index

  obtain ⟨X', h, hfin, ρ, σ, hσ, hdense, hρe, hρ, hsplit⟩ :=
    wc_galois_sylow_quotient_extension K X f W₁ hW₁aff E hEaff q Γ α hq (P : Subgroup Γ)
  haveI := hfin

  obtain ⟨L, ⟨adj⟩, -, -⟩ := wc_et_push_left_adjoint h
  let φ := (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map
    (Functor.whiskerRight (yoneda.map (wcEtOpenι X U (U.hom ⁻¹ᵁ W₁)))
      (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) ≫ Limits.cokernel.π g

  have hsupp : wcSuppIn X (W₁ : Set X) (Limits.image φ) :=
    wc_et_image_open_supp U W₁ (Limits.cokernel g) (Limits.cokernel.π g)
  have htorF : ℓ • 𝟙 (Limits.image φ) = 0 := by
    have h0 : Limits.image.ι φ ≫ (ℓ • 𝟙 (Limits.cokernel g)) = 0 := by
      rw [htor, Limits.comp_zero]
    rw [Preadditive.comp_nsmul, Category.comp_id] at h0
    rw [← cancel_mono (Limits.image.ι φ), Preadditive.nsmul_comp, Category.id_comp, h0,
      Limits.zero_comp]

  obtain ⟨s, r, hsr⟩ := wc_et_finite_etale_trace_retract h W₁ q ℓ (P : Subgroup Γ).index hℓ hPidx
    σ hσ hsplit (Limits.image φ) hsupp htorF L ⟨adj⟩

  obtain ⟨n, Pk, hP0, ⟨eP⟩, hS⟩ := wc_et_galois_descended_flag ℓ hℓ U V g htor W₁ h
    (q ≫ W₁.ι) ρ hρe (↥(P : Subgroup Γ)) hPp (α.comp (P : Subgroup Γ).subtype) hρ hEconn
    A B a b ha hb L ⟨adj⟩

  haveI : Limits.PreservesFiniteLimits (wcEtPush h) := by
    have := adj.rightAdjoint_preservesLimits.{0, 0}
    infer_instance
  haveI : Limits.PreservesFiniteColimits (wcEtPush h) := wc_et_finite_push_exact h
  haveI : (wcEtPush h).PreservesZeroMorphisms := by
    have := adj.isRightAdjoint
    infer_instance

  have hbase : 𝒟 ((wcEtPush h).obj (Pk 0)) :=
    hR _ _ 0 0 ((Functor.map_isZero (wcEtPush h) hP0).eq_of_src _ _)
      (hG X (𝟙 X) Set.univ isOpen_univ dense_univ)
  have hind : ∀ k, k ≤ n → 𝒟 ((wcEtPush h).obj (Pk k)) := by
    intro k
    induction k with
    | zero => intro _; exact hbase
    | succ k ih =>
      intro hk
      obtain ⟨S, hSe, ⟨e1⟩, ⟨e2⟩, ⟨e3⟩⟩ := hS k (by omega)
      have h1 : 𝒟 ((wcEtPush h).obj S.X₁) :=
        hI _ _ ⟨(wcEtPush h).mapIso e1.symm⟩ (ih (by omega))
      have h3 : 𝒟 ((wcEtPush h).obj S.X₃) :=
        hI _ _ ⟨(wcEtPush h).mapIso e3.symm⟩ (hG X' h _ (h ⁻¹ᵁ W₁).isOpen hdense)
      have h2 : 𝒟 ((wcEtPush h).obj S.X₂) := hE (S.map (wcEtPush h)) (hSe.map_of_exact _) h1 h3
      exact hI _ _ ⟨(wcEtPush h).mapIso e2⟩ h2

  have hLF : 𝒟 ((wcEtPush h).obj (L.obj (Limits.image φ))) :=
    hI _ _ ⟨(wcEtPush h).mapIso eP⟩ (hind n le_rfl)
  exact ⟨W₁, hW₁ne, hR _ _ s r hsr hLF⟩

theorem wc_et_fp_torsion_devissage_class : ∀ (K : Type u) [Field K] (Y : Scheme.{u}) (f : Y ⟶ Spec (.of K)) [IsProper f] (ℓ : ℕ), ℓ.Prime → (ℓ : K) ≠ 0 → ∀ (𝒞 : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1} → Prop), (∀ (A B : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}), Nonempty (A ≅ B) → 𝒞 A → 𝒞 B) → (∀ (S : ShortComplex (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})), S.ShortExact → 𝒞 S.X₁ → 𝒞 S.X₃ → 𝒞 S.X₂) → (∀ (A B : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (s : A ⟶ B) (r : B ⟶ A), s ≫ r = 𝟙 A → 𝒞 B → 𝒞 A) → (∀ (W : Scheme.{u}) (π : W ⟶ Y) [IsFinite π] (S : Set W), IsOpen S → Dense S → 𝒞 ((wcEtPush π).obj (wcEtExtZero W S ℓ))) → ∀ (U V : Y.Etale) (g : (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (yoneda.obj V ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶ (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)), CompactSpace U.left → QuasiSeparatedSpace U.left → CompactSpace V.left → QuasiSeparatedSpace V.left → ℓ • 𝟙 (Limits.cokernel g) = 0 → 𝒞 (Limits.cokernel g) :=
by
  intro K _ Y f _ ℓ hℓ hℓK 𝒞 hI hE hR hG U V g hU hU' hV hV' htor

  have hzero : ∀ (X : Scheme.{u}) (𝒟 : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1} → Prop),
      (∀ (A B : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) (s : A ⟶ B) (r : B ⟶ A),
        s ≫ r = 𝟙 A → 𝒟 B → 𝒟 A) →
      (∀ (W : Scheme.{u}) (π : W ⟶ X) [IsFinite π] (S : Set W), IsOpen S → Dense S →
        𝒟 ((wcEtPush π).obj (wcEtExtZero W S ℓ))) →
      ∀ A : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}, Limits.IsZero A → 𝒟 A := by
    intro X 𝒟 hR' hG' A hA
    exact hR' A _ 0 0 (hA.eq_of_src _ _) (hG' X (𝟙 X) Set.univ isOpen_univ dense_univ)

  have htrans : ∀ (Z : Scheme.{u}) (i : Z ⟶ Y) [IsClosedImmersion i],
      (∀ (A B : Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}), Nonempty (A ≅ B) →
        𝒞 ((wcEtPush i).obj A) → 𝒞 ((wcEtPush i).obj B)) ∧
      (∀ (S : ShortComplex (Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1})), S.ShortExact →
        𝒞 ((wcEtPush i).obj S.X₁) → 𝒞 ((wcEtPush i).obj S.X₃) → 𝒞 ((wcEtPush i).obj S.X₂)) ∧
      (∀ (A B : Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) (s : A ⟶ B) (r : B ⟶ A),
        s ≫ r = 𝟙 A → 𝒞 ((wcEtPush i).obj B) → 𝒞 ((wcEtPush i).obj A)) ∧
      (∀ (W : Scheme.{u}) (π : W ⟶ Z) [IsFinite π] (S : Set W), IsOpen S → Dense S →
        𝒞 ((wcEtPush i).obj ((wcEtPush π).obj (wcEtExtZero W S ℓ)))) := by
    intro Z i _
    obtain ⟨L, ⟨adj⟩, -, -⟩ := wc_et_push_left_adjoint i
    haveI : Limits.PreservesFiniteLimits (wcEtPush i) := by
      have := adj.rightAdjoint_preservesLimits.{0, 0}
      infer_instance
    haveI : Limits.PreservesFiniteColimits (wcEtPush i) := wc_et_finite_push_exact i
    haveI : (wcEtPush i).PreservesZeroMorphisms := by
      have := adj.isRightAdjoint
      infer_instance
    refine ⟨?_, ?_, ?_, ?_⟩
    · rintro A B ⟨e⟩ h
      exact hI _ _ ⟨(wcEtPush i).mapIso e⟩ h
    · intro S hS h1 h3
      exact hE (S.map (wcEtPush i)) (hS.map_of_exact _) h1 h3
    · intro A B s r hsr h
      exact hR _ _ ((wcEtPush i).map s) ((wcEtPush i).map r)
        (by rw [← (wcEtPush i).map_comp, hsr]; exact (wcEtPush i).map_id A) h
    · intro W π _ S hS hD
      obtain ⟨e⟩ := (wc_et_push_id_comp_iso π i).2
      exact hI _ _ ⟨(e.app _).symm⟩ (hG W (π ≫ i) S hS hD)

  haveI : TopologicalSpace.NoetherianSpace Y := by
    have : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian f
    have : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace f
    have : IsNoetherian Y := {}
    infer_instance

  have key : ∀ O : Y.Opens, ∀ (Z : Scheme.{u}) (i : Z ⟶ Y) [IsClosedImmersion i],
      Set.range i ⊆ (O : Set Y)ᶜ →
      ∀ (U V : Z.Etale) (g : (presheafToSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).obj
          (yoneda.obj V ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶
        (presheafToSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).obj
          (yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)),
      CompactSpace U.left → QuasiSeparatedSpace U.left → CompactSpace V.left →
      QuasiSeparatedSpace V.left → ℓ • 𝟙 (Limits.cokernel g) = 0 →
      𝒞 ((wcEtPush i).obj (Limits.cokernel g)) := by
    intro O
    induction O using WellFoundedGT.induction with
    | _ O IH =>
    intro Z i _ hrange U V g hU hU' hV hV' htor
    obtain ⟨hIi, hEi, hRi, hGi⟩ := htrans Z i
    rcases isEmpty_or_nonempty Z with hZ | hZ
    ·
      have s1 : ∀ U : Z.Etale, IsEmpty U.left := fun U => ⟨fun x => hZ.false (U.hom.base x)⟩
      have s2 : ∀ U : Z.Etale, (⊥ : Sieve U) ∈ Scheme.smallEtaleTopology Z U := by
        intro U
        change (⊥ : Sieve U) ∈ Scheme.smallGrothendieckTopology @Etale Z U
        rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Z
          MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
        apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Z
          MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
        intro x
        exact ((s1 U).false x).elim
      have s4 : ∀ G₀ : Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}, Limits.IsZero G₀ := by
        intro G₀
        have h : Limits.IsZero G₀.obj :=
          Functor.isZero G₀.obj (fun X => (Sheaf.isTerminalOfBotCover G₀ X.unop (s2 X.unop)).isZero)
        exact Limits.IsZero.of_full_of_faithful_of_isZero
          (sheafToPresheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) G₀ h
      exact hzero Z (fun A => 𝒞 ((wcEtPush i).obj A)) hRi hGi _ (s4 _)
    ·
      haveI : IsProper (i ≫ f) := inferInstance
      obtain ⟨W, hWne, hDW⟩ := wc_et_fp_generic_open_part K Z (i ≫ f) ℓ hℓ hℓK
        (fun A => 𝒞 ((wcEtPush i).obj A)) hIi hEi hRi hGi hZ U V g hU hU' hV hV' htor
      obtain ⟨Z'', i'', hi'', hrange''⟩ : ∃ (Z'' : Scheme.{u}) (i'' : Z'' ⟶ Z),
          IsClosedImmersion i'' ∧ Set.range i'' = (W : Set Z)ᶜ :=
        ⟨_, (Scheme.IdealSheafData.vanishingIdeal ⟨(W : Set Z)ᶜ, W.isOpen.isClosed_compl⟩).subschemeι,
          inferInstance, (Scheme.IdealSheafData.range_subschemeι _).trans
            (Scheme.IdealSheafData.coe_support_vanishingIdeal _)⟩
      haveI := hi''
      obtain ⟨L'', ⟨adj''⟩, -, -⟩ := wc_et_push_left_adjoint i''
      obtain ⟨S, hS, ⟨e1⟩, ⟨e2⟩, ⟨e3⟩⟩ := wc_et_open_closed_unit_seq Z Z'' i'' W hrange'' L'' adj''
        U (Limits.cokernel g) (Limits.cokernel.π g) inferInstance
      obtain ⟨U'', V'', g'', hU1, hU2, hV1, hV2, htor'', ⟨e4⟩⟩ :=
        wc_et_closed_pull_fp i'' L'' ⟨adj''⟩ U V g hU hU' hV hV' ℓ htor

      have hcl : IsClosed (i '' (W : Set Z)ᶜ) :=
        i.isClosedEmbedding.isClosedMap _ W.isOpen.isClosed_compl
      let O' : Y.Opens := ⟨(i '' (W : Set Z)ᶜ)ᶜ, hcl.isOpen_compl⟩
      have hle : O ≤ O' := by
        intro y hy hy'
        obtain ⟨z, -, rfl⟩ := hy'
        exact hrange ⟨z, rfl⟩ hy
      have hlt : O < O' := by
        refine lt_of_le_of_ne hle (fun h => ?_)
        obtain ⟨w, hw⟩ := hWne
        have h2 : i w ∈ (O' : Set Y) := by
          rintro ⟨z, hz, hzw⟩
          exact hz ((i.isClosedEmbedding.injective hzw) ▸ hw)
        rw [← h] at h2
        exact hrange ⟨w, rfl⟩ h2
      have hrangeComp : Set.range (i'' ≫ i) ⊆ (O' : Set Y)ᶜ := by
        rintro _ ⟨z, rfl⟩ hy
        have hz : i'' z ∈ Set.range i'' := ⟨z, rfl⟩
        rw [hrange''] at hz
        exact hy ⟨i'' z, hz, (Scheme.Hom.comp_apply i'' i z).symm⟩
      have hIH := IH O' hlt Z'' (i'' ≫ i) hrangeComp U'' V'' g'' hU1 hU2 hV1 hV2 htor''
      obtain ⟨e5⟩ := (wc_et_push_id_comp_iso i'' i).2
      have hX3 : 𝒞 ((wcEtPush i).obj S.X₃) :=
        hI _ _ ⟨(e5.app _).symm ≪≫ (wcEtPush i).mapIso ((wcEtPush i'').mapIso e4.symm) ≪≫
          (wcEtPush i).mapIso e3.symm⟩ hIH
      have hX1 : 𝒞 ((wcEtPush i).obj S.X₁) := hIi _ _ ⟨e1.symm⟩ hDW
      exact hIi _ _ ⟨e2⟩ (hEi S hS hX1 hX3)

  have htop := key ⊥ Y (𝟙 Y) (by intro y _ hy; simpa using hy) U V g hU hU' hV hV' htor
  obtain ⟨e0⟩ := (wc_et_push_id_comp_iso (𝟙 Y) (𝟙 Y)).1
  exact hI _ _ ⟨e0.app _⟩ htop

theorem wc_dense_open_compl_subscheme : ∀ (K : Type u) [Field K] (W : Scheme.{u}) (fW : W ⟶ Spec (.of K)) [IsProper fW] (S : Set W), IsOpen S → Dense S → ∀ n : ℕ, topologicalKrullDim W ≤ (n : WithBot ℕ∞) → ∃ (Z : Scheme.{u}) (i : Z ⟶ W), IsClosedImmersion i ∧ Set.range i = Sᶜ ∧ (n = 0 → IsEmpty Z) ∧ ∀ d : ℕ, n = d + 1 → topologicalKrullDim Z ≤ (d : WithBot ℕ∞) :=
by
  intro K _ W fW _ S hSo hSd n hdim
  haveI hN : TopologicalSpace.NoetherianSpace W :=
    @AlgebraicGeometry.IsNoetherian.noetherianSpace W
      (@AlgebraicGeometry.IsNoetherian.mk W (LocallyOfFiniteType.isLocallyNoetherian fW)
        (QuasiCompact.compactSpace_of_compactSpace fW))
  have hC : IsClosed Sᶜ := hSo.isClosed_compl
  let I := Scheme.IdealSheafData.vanishingIdeal (⟨Sᶜ, hC⟩ : TopologicalSpace.Closeds W)
  have hrange : Set.range I.subschemeι = Sᶜ := by
    rw [Scheme.IdealSheafData.range_subschemeι, Scheme.IdealSheafData.coe_support_vanishingIdeal]
    rfl
  have hdimZ : topologicalKrullDim I.subscheme = topologicalKrullDim ↥(Sᶜ : Set W) := by
    rw [IsHomeomorph.topologicalKrullDim_eq _
      (I.subschemeι.isClosedEmbedding.isEmbedding.toHomeomorph).isHomeomorph]
    exact IsHomeomorph.topologicalKrullDim_eq _ (Homeomorph.setCongr hrange).isHomeomorph
  refine ⟨I.subscheme, I.subschemeι, inferInstance, hrange, ?_, ?_⟩
  · intro h0
    subst h0
    have hSu : S = Set.univ := by
      by_contra hne
      obtain ⟨x, hx⟩ : ∃ x, x ∉ S := by
        by_contra h
        push_neg at h
        exact hne (Set.eq_univ_of_forall h)
      have hT : IsIrreducible (closure ({x} : Set W)) := isIrreducible_singleton.closure
      obtain ⟨C, hCmem, hTC⟩ := exists_mem_irreducibleComponents_subset_of_isIrreducible _ hT
      have hCcl : IsClosed C := isClosed_of_mem_irreducibleComponents C hCmem
      obtain ⟨o, ho, hne', hoC⟩ :=
        TopologicalSpace.NoetherianSpace.exists_isOpen_nonempty_subset_irreducibleComponent C hCmem
      obtain ⟨y, hyo, hyS⟩ := hSd.inter_open_nonempty o ho hne'
      have hne2 : closure ({x} : Set W) ≠ C := by
        intro hEq
        have hy : y ∈ closure ({x} : Set W) := hEq ▸ hoC hyo
        obtain ⟨z, hzS, hz⟩ := mem_closure_iff.mp hy S hSo hyS
        rw [Set.mem_singleton_iff.mp hz] at hzS
        exact hx hzS
      have hlt : (⟨closure {x}, hT, isClosed_closure⟩ : TopologicalSpace.IrreducibleCloseds W) <
          ⟨C, hCmem.1, hCcl⟩ :=
        SetLike.coe_ssubset_coe.mp (HasSubset.Subset.ssubset_of_ne hTC hne2)
      have h1 : (1 : WithBot ℕ∞) ≤ topologicalKrullDim W :=
        Order.one_le_krullDim_iff.mpr ⟨_, _, hlt⟩
      have h2 : (1 : WithBot ℕ∞) ≤ 0 := h1.trans (hdim.trans (le_of_eq (by simp)))
      exact absurd h2 (by decide)
    refine ⟨fun z => ?_⟩
    have hz : I.subschemeι z ∈ Set.range I.subschemeι := ⟨z, rfl⟩
    rw [hrange, hSu, Set.compl_univ] at hz
    exact hz
  · intro d hd
    subst hd
    rw [hdimZ]
    have hD : Dense (Sᶜ : Set W)ᶜ := by rwa [compl_compl]
    have hext : ∀ T : Set W, IsIrreducible T → T ⊆ Sᶜ →
        ∃ V : Set W, IsClosed V ∧ IsIrreducible V ∧ T ⊂ V := by
      intro T hT hTC
      obtain ⟨V, hV, hTV⟩ := exists_mem_irreducibleComponents_subset_of_isIrreducible T hT
      obtain ⟨o, ho, hne, hoV⟩ :=
        TopologicalSpace.NoetherianSpace.exists_isOpen_nonempty_subset_irreducibleComponent V hV
      obtain ⟨x, hxo, hxC⟩ := hD.inter_open_nonempty o ho hne
      exact ⟨V, isClosed_of_mem_irreducibleComponents V hV, hV.1, hTV,
        fun hVT => hxC (hTC (hVT (hoV hxo)))⟩
    let φ : TopologicalSpace.IrreducibleCloseds ↥(Sᶜ : Set W) →
        TopologicalSpace.IrreducibleCloseds W :=
      fun T => ⟨Subtype.val '' (T : Set ↥(Sᶜ : Set W)),
        T.isIrreducible.image _ continuous_subtype_val.continuousOn,
        hC.isClosedMap_subtype_val _ T.isClosed⟩
    have hφ : StrictMono φ := by
      intro a b hab
      rw [← SetLike.coe_ssubset_coe] at hab ⊢
      exact Subtype.val_injective.image_strictMono hab
    have hφC : ∀ T, (φ T : Set W) ⊆ Sᶜ := fun T => by
      rintro _ ⟨y, _, rfl⟩
      exact y.2
    unfold topologicalKrullDim at hdim ⊢
    unfold Order.krullDim
    apply iSup_le
    intro p
    obtain ⟨V, hVc, hVi, hsub⟩ := hext _ (φ p.last).isIrreducible (hφC _)
    let b : TopologicalSpace.IrreducibleCloseds W := ⟨V, hVi, hVc⟩
    have hlt : φ p.last < b := by
      rw [← SetLike.coe_ssubset_coe]
      exact hsub
    let q := (p.map φ hφ).snoc b (by rw [LTSeries.last_map]; exact hlt)
    have h1 := Order.LTSeries.length_le_krullDim q
    have hq : q.length = p.length + 1 := by
      simp [q, RelSeries.snoc_length, LTSeries.map_length]
    rw [hq] at h1
    have h2 : ((p.length + 1 : ℕ) : WithBot ℕ∞) ≤ ((d + 1 : ℕ) : WithBot ℕ∞) := h1.trans hdim
    have h3 : p.length + 1 ≤ d + 1 := by exact_mod_cast h2
    have h4 : p.length ≤ d := by omega
    exact_mod_cast h4

theorem wc_et_cd_constant_to_torsion : ∀ (K : Type u) [Field K] [IsAlgClosed K] (Y : Scheme.{u}) (f : Y ⟶ Spec (.of K)) [IsProper f] (ℓ : ℕ), ℓ.Prime → (ℓ : K) ≠ 0 → (∀ (W : Scheme.{u}) (π : W ⟶ Y) [IsFinite π] (d : ℕ), topologicalKrullDim W ≤ (d : WithBot ℕ∞) → ∀ q : ℕ, 2 * d < q → Subsingleton (wcEtCoh W ℓ q)) → ∀ n : ℕ, topologicalKrullDim Y ≤ (n : WithBot ℕ∞) → ∀ (G : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}), ℓ • 𝟙 G = 0 → letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _; ∀ q : ℕ, 2 * n < q → ∀ x : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) G q, x = 0 :=
by
  intro K _ _ Y f _ ℓ hℓ hℓK H n hn G hG
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
  intro q hq x

  have hc : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace f
  have hqs : QuasiSeparatedSpace Y := quasiSeparatedSpace_of_quasiSeparated f

  have hempty : ∀ (Y₀ : Scheme.{u}), IsEmpty Y₀ → ∀ (q₀ : ℕ), Subsingleton (wcEtCoh Y₀ ℓ q₀) := by
    intro Y₀ hY q₀
    have s1 : ∀ U : Y₀.Etale, IsEmpty U.left := fun U => ⟨fun x => hY.false (U.hom.base x)⟩
    have s2 : ∀ U : Y₀.Etale, (⊥ : Sieve U) ∈ Scheme.smallEtaleTopology Y₀ U := by
      intro U
      change (⊥ : Sieve U) ∈ Scheme.smallGrothendieckTopology @Etale Y₀ U
      rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y₀
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
      apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y₀
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
      intro x
      exact ((s1 U).false x).elim
    have s4 : ∀ G₀ : Sheaf (Scheme.smallEtaleTopology Y₀) AddCommGrpCat.{u+1}, Limits.IsZero G₀ := by
      intro G₀
      have h : Limits.IsZero G₀.obj :=
        Functor.isZero G₀.obj (fun X => (Sheaf.isTerminalOfBotCover G₀ X.unop (s2 X.unop)).isZero)
      exact Limits.IsZero.of_full_of_faithful_of_isZero
        (sheafToPresheaf (Scheme.smallEtaleTopology Y₀) AddCommGrpCat.{u+1}) G₀ h
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y₀) AddCommGrpCat.{u+1}) := HasExt.standard _
    have hB := s4 ((constantSheaf (Scheme.smallEtaleTopology Y₀) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))))
    have hsub : ∀ {A B : Sheaf (Scheme.smallEtaleTopology Y₀) AddCommGrpCat.{u+1}},
        Limits.IsZero B → Subsingleton (Abelian.Ext A B q₀) := by
      intro A B hB
      have hx : ∀ x : Abelian.Ext A B q₀, x = 0 := by
        intro x
        rw [← Abelian.Ext.comp_mk₀_id x, hB.eq_of_src (𝟙 B) 0, Abelian.Ext.mk₀_zero,
          Abelian.Ext.comp_zero]
      exact ⟨fun x y => (hx x).trans (hx y).symm⟩
    unfold wcEtCoh
    exact hsub (A := (constantSheaf (Scheme.smallEtaleTopology Y₀) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} ℤ))) hB

  have hs3 : ∀ (W Z : Scheme.{u}) (i : Z ⟶ W) [IsClosedImmersion i] (N : ℕ),
      (∀ q₀ : ℕ, N < q₀ → Subsingleton (wcEtCoh W ℓ q₀)) →
      (∀ q' : ℕ, N < q' + 1 → Subsingleton (wcEtCoh Z ℓ q')) →
      ∀ q₀ : ℕ, N < q₀ → Subsingleton (wcEtExt W (wcEtExtZero W (Set.range i)ᶜ ℓ) q₀) := by
    intro W Z i _ N hW hZ q₀ hq₀
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology W) AddCommGrpCat.{u+1}) := HasExt.standard _
    have hmono : Mono (wcEtExtZeroι W (Set.range i)ᶜ ℓ) := by
      let α : wcEtExtZeroPre W (Set.range i)ᶜ ℓ ⟶
          (Functor.const _).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))) :=
        { app := fun V => AddCommGrpCat.ofHom
            (wcSuppSub.{u} ℓ (∀ x, V.unop.hom x ∈ (Set.range i)ᶜ)).subtype
          naturality := fun _ _ _ => rfl }
      haveI : ∀ V, Mono (α.app V) := fun V =>
        (AddCommGrpCat.mono_iff_injective _).mpr (AddSubgroup.subtype_injective _)
      haveI : Mono α := NatTrans.mono_of_mono_app α
      exact Functor.map_mono (presheafToSheaf (Scheme.smallEtaleTopology W) AddCommGrpCat.{u+1}) α
    let T := ShortComplex.mk (wcEtExtZeroι W (Set.range i)ᶜ ℓ) (Limits.cokernel.π _)
      (Limits.cokernel.condition _)
    have hTs : T.ShortExact :=
      ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel _) inferInstance inferInstance
    let P := (constantSheaf (Scheme.smallEtaleTopology W) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} ℤ))
    obtain ⟨q', rfl⟩ : ∃ q', q₀ = q' + 1 := ⟨q₀ - 1, by omega⟩
    have hx : ∀ x : Abelian.Ext P T.X₁ (q' + 1), x = 0 := by
      intro x
      have h2 : x.comp (Abelian.Ext.mk₀ T.f) (add_zero _) = 0 := by
        have hs := hW (q' + 1) hq₀
        exact @Subsingleton.elim _ hs _ _
      obtain ⟨y, hy⟩ := Abelian.Ext.covariant_sequence_exact₁ P hTs x h2 rfl
      obtain ⟨e⟩ := wc_et_closed_complement_coh W Z i ℓ q'
      haveI := hZ q' hq₀
      haveI hs : Subsingleton (Abelian.Ext P T.X₃ q') := e.subsingleton
      have hy0 : y = 0 := Subsingleton.elim _ _
      rw [← hy, hy0, Abelian.Ext.zero_comp]
    change Subsingleton (Abelian.Ext P T.X₁ (q' + 1))
    exact ⟨fun a b => (hx a).trans (hx b).symm⟩

  have hiso : ∀ (A B : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}), Nonempty (A ≅ B) →
      (∀ q₀ : ℕ, 2 * n < q₀ → ∀ x : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y)
        AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) A q₀, x = 0) →
      (∀ q₀ : ℕ, 2 * n < q₀ → ∀ x : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y)
        AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) B q₀, x = 0) := by
    rintro A B ⟨e⟩ hA q₀ hq₀ x
    have h1 : x.comp (Abelian.Ext.mk₀ e.inv) (add_zero q₀) = 0 := hA q₀ hq₀ _
    calc x = (x.comp (Abelian.Ext.mk₀ e.inv) (add_zero q₀)).comp (Abelian.Ext.mk₀ e.hom)
          (add_zero q₀) := by
          rw [Abelian.Ext.comp_assoc _ _ _ (add_zero q₀) (add_zero 0) (by omega),
            Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.comp_mk₀_id]
      _ = 0 := by rw [h1, Abelian.Ext.zero_comp]
  have hext : ∀ (S : ShortComplex (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})),
      S.ShortExact →
      (∀ q₀ : ℕ, 2 * n < q₀ → ∀ x : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y)
        AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) S.X₁ q₀, x = 0) →
      (∀ q₀ : ℕ, 2 * n < q₀ → ∀ x : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y)
        AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) S.X₃ q₀, x = 0) →
      (∀ q₀ : ℕ, 2 * n < q₀ → ∀ x : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y)
        AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) S.X₂ q₀, x = 0) := by
    intro S hS h1 h3 q₀ hq₀ x
    obtain ⟨a, ha⟩ := Abelian.Ext.covariant_sequence_exact₂ _ hS x (h3 q₀ hq₀ _)
    rw [← ha, h1 q₀ hq₀ a, Abelian.Ext.zero_comp]
  have hret : ∀ (A B : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (s : A ⟶ B)
      (r : B ⟶ A), s ≫ r = 𝟙 A →
      (∀ q₀ : ℕ, 2 * n < q₀ → ∀ x : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y)
        AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) B q₀, x = 0) →
      (∀ q₀ : ℕ, 2 * n < q₀ → ∀ x : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y)
        AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) A q₀, x = 0) := by
    intro A B s r hsr hB q₀ hq₀ x
    have h1 : x.comp (Abelian.Ext.mk₀ s) (add_zero q₀) = 0 := hB q₀ hq₀ _
    calc x = (x.comp (Abelian.Ext.mk₀ s) (add_zero q₀)).comp (Abelian.Ext.mk₀ r)
          (add_zero q₀) := by
          rw [Abelian.Ext.comp_assoc _ _ _ (add_zero q₀) (add_zero 0) (by omega),
            Abelian.Ext.mk₀_comp_mk₀, hsr, Abelian.Ext.comp_mk₀_id]
      _ = 0 := by rw [h1, Abelian.Ext.zero_comp]

  have hgen : ∀ (W : Scheme.{u}) (π : W ⟶ Y) [IsFinite π] (S : Set W), IsOpen S → Dense S →
      (∀ q₀ : ℕ, 2 * n < q₀ → ∀ x : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y)
        AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)))
        ((wcEtPush π).obj (wcEtExtZero W S ℓ)) q₀, x = 0) := by
    intro W π _ S hSo hSd q₀ hq₀ x
    have hdimW : topologicalKrullDim W ≤ (n : WithBot ℕ∞) :=
      (wc_finite_topologicalKrullDim_le π).trans hn
    haveI : IsProper (π ≫ f) := inferInstance
    obtain ⟨Z, i, hi, hrange, h0, hd⟩ :=
      wc_dense_open_compl_subscheme K W (π ≫ f) S hSo hSd n hdimW
    haveI := hi
    have hSeq : S = (Set.range i)ᶜ := by rw [hrange, compl_compl]
    have hZ : ∀ q' : ℕ, 2 * n < q' + 1 → Subsingleton (wcEtCoh Z ℓ q') := by
      intro q' hq'
      rcases Nat.eq_zero_or_eq_succ_pred n with h | h
      · exact hempty Z (h0 h) q'
      · haveI : IsFinite (i ≫ π) := inferInstance
        exact H Z (i ≫ π) (n - 1) (hd (n - 1) h) q' (by omega)
    have hs := hs3 W Z i (2 * n) (H W π n hdimW) hZ q₀ hq₀
    rw [← hSeq] at hs
    obtain ⟨e⟩ := wc_et_finite_push_ext_equiv π (wcEtExtZero W S ℓ) q₀
    haveI hs' : Subsingleton (Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y)
        AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)))
        ((wcEtPush π).obj (wcEtExtZero W S ℓ)) q₀) := e.subsingleton
    exact Subsingleton.elim _ _

  refine wc_et_torsion_ext_vanish_of_fp Y hc hqs ℓ (2 * n) ?_ G hG q hq x
  intro U V g hU hU' hV hV' htor
  exact wc_et_fp_torsion_devissage_class K Y f ℓ hℓ hℓK
    (fun F => ∀ q₀ : ℕ, 2 * n < q₀ → ∀ x : Abelian.Ext ((constantSheaf
      (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)))
      F q₀, x = 0)
    hiso hext hret hgen U V g hU hU' hV hV' htor

theorem wc_leray_ext_vanishing : ∀ {C : Type*} {D : Type*} [Category C] [Category D] [Abelian C] [Abelian D] [EnoughInjectives D] (L : D ⥤ C) (R : C ⥤ D) [R.Additive] (adj : L ⊣ R) [Limits.PreservesFiniteLimits L] (P : D) (A : C) (I : InjectiveResolution A) (N : ℕ), letI := HasExt.standard C; letI := HasExt.standard D; (∀ p q : ℕ, N < p + q → ∀ x : Abelian.Ext P (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q) p, x = 0) → ∀ k : ℕ, N < k → ∀ x : Abelian.Ext (L.obj P) A k, x = 0 :=
by
  intro C D _ _ _ _ _ L R _ adj _ P A I N hH k hk x
  letI : HasExt C := HasExt.standard C
  letI : HasExt D := HasExt.standard D
  classical

  have s1 : ∀ (K : CochainComplex D ℕ) (j : ℕ), ∃ (B : D) (u : K.X j ⟶ B)
      (v : B ⟶ K.cycles (j + 1)) (h1 : K.iCycles j ≫ u = 0) (h2 : v ≫ K.homologyπ (j + 1) = 0),
      (ShortComplex.mk _ _ h1).ShortExact ∧ (ShortComplex.mk _ _ h2).ShortExact ∧
        u ≫ v ≫ K.iCycles (j + 1) = K.d j (j + 1) := by
    intro K j
    have hv : Limits.image.ι (K.d j (j + 1)) ≫ K.d (j + 1) (j + 1 + 1) = 0 := by
      rw [← cancel_epi (Limits.factorThruImage (K.d j (j + 1))), Limits.image.fac_assoc,
        K.d_comp_d, Limits.comp_zero]
    let v := K.liftCycles (Limits.image.ι (K.d j (j + 1))) (j + 1 + 1)
      (CochainComplex.next ℕ (j + 1)) hv
    have hvi : v ≫ K.iCycles (j + 1) = Limits.image.ι (K.d j (j + 1)) :=
      K.liftCycles_i _ _ _ _
    have huv : Limits.factorThruImage (K.d j (j + 1)) ≫ v = K.toCycles j (j + 1) := by
      rw [← cancel_mono (K.iCycles (j + 1)), Category.assoc, hvi, Limits.image.fac,
        K.toCycles_i]
    have h1 : K.iCycles j ≫ Limits.factorThruImage (K.d j (j + 1)) = 0 := by
      rw [← cancel_mono (Limits.image.ι (K.d j (j + 1))), Category.assoc, Limits.image.fac,
        Limits.zero_comp]
      exact K.iCycles_d j (j + 1)
    have h2 : v ≫ K.homologyπ (j + 1) = 0 := by
      rw [← cancel_epi (Limits.factorThruImage (K.d j (j + 1))), ← Category.assoc, huv,
        Limits.comp_zero]
      exact K.toCycles_comp_homologyπ j (j + 1)
    haveI : Mono v := mono_of_mono_fac hvi
    refine ⟨Limits.image (K.d j (j + 1)), Limits.factorThruImage (K.d j (j + 1)), v, h1, h2,
      ?_, ?_, ?_⟩
    · refine ShortComplex.ShortExact.mk' (ShortComplex.exact_of_f_is_kernel _
        (Limits.KernelFork.IsLimit.ofι _ _
          (fun g' hg' => K.liftCycles g' (j + 1) (CochainComplex.next ℕ j) (by
            rw [← Limits.image.fac (K.d j (j + 1)), ← Category.assoc,
              show g' ≫ Limits.factorThruImage (K.d j (j + 1)) = 0 from hg', Limits.zero_comp]))
          (fun g' hg' => K.liftCycles_i _ _ _ _)
          (fun g' hg' m hm => by
            rw [← cancel_mono (K.iCycles j), K.liftCycles_i]
            exact hm))) inferInstance inferInstance
    · have hprev : (ComplexShape.up ℕ).prev (j + 1) = j := by simp
      refine ShortComplex.ShortExact.mk' (ShortComplex.exact_of_g_is_cokernel _
        (Limits.CokernelCofork.IsColimit.ofπ _ _
          (fun g' hg' => (Limits.CokernelCofork.IsColimit.desc'
            (K.homologyIsCokernel j (j + 1) hprev) g' (by
              rw [← huv, Category.assoc, show v ≫ g' = 0 from hg', Limits.comp_zero])).1)
          (fun g' hg' => (Limits.CokernelCofork.IsColimit.desc'
            (K.homologyIsCokernel j (j + 1) hprev) g' (by
              rw [← huv, Category.assoc, show v ≫ g' = 0 from hg', Limits.comp_zero])).2)
          (fun g' hg' m hm => by
            rw [← cancel_epi (K.homologyπ (j + 1))]
            exact hm.trans (Limits.CokernelCofork.IsColimit.desc'
              (K.homologyIsCokernel j (j + 1) hprev) g' (by
                rw [← huv, Category.assoc, show v ≫ g' = 0 from hg', Limits.comp_zero])).2.symm)))
        inferInstance inferInstance
    · rw [hvi, Limits.image.fac]

  have claim : ∀ (K : CochainComplex D ℕ), (∀ j, Injective (K.X j)) →
      (∀ p q : ℕ, N < p + q → ∀ x : Abelian.Ext P (K.homology q) p, x = 0) →
      ∀ p : ℕ, N < p + 1 → ∀ c : P ⟶ K.X (p + 1), c ≫ K.d (p + 1) (p + 1 + 1) = 0 →
        ∃ e : P ⟶ K.X p, e ≫ K.d p (p + 1) = c := by
    intro K hinjK hK
    choose Bo u v h1 h2 hS1 hS2 hfac using s1 K
    have hiso0 : IsIso (K.homologyπ 0) :=
      K.isIso_homologyπ 0 0 CochainComplex.prev_nat_zero (K.shape 0 0 (by simp))

    have hA : ∀ j i : ℕ, N < i + 1 + j → ∀ x : Abelian.Ext P (K.cycles j) (i + 1), x = 0 := by
      intro j
      induction j with
      | zero =>
        intro i hi x
        have h0 : x.comp (Abelian.Ext.mk₀ (K.homologyπ 0)) (add_zero _) = 0 :=
          hK (i + 1) 0 (by omega) _
        have hl : (x.comp (Abelian.Ext.mk₀ (K.homologyπ 0)) (add_zero _)).comp
            (Abelian.Ext.mk₀ (inv (K.homologyπ 0))) (add_zero _) = x := by
          rw [Abelian.Ext.comp_assoc _ _ _ (add_zero _) (add_zero 0) (by omega),
            Abelian.Ext.mk₀_comp_mk₀, IsIso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
        rw [← hl, h0, Abelian.Ext.zero_comp]
      | succ j ih =>
        intro i hi x
        have hS1j := hS1 j
        have hS2j := hS2 j
        haveI : Injective (ShortComplex.mk _ _ (h1 j)).X₂ := hinjK j
        have ha : ∀ y : Abelian.Ext P (Bo j) (i + 1), y = 0 := by
          intro y
          have hy : y.comp hS1j.extClass (rfl : (i + 1) + 1 = (i + 1) + 1) = 0 :=
            ih (i + 1) (by omega) _
          obtain ⟨x₂, hx₂⟩ := Abelian.Ext.covariant_sequence_exact₃ P hS1j y rfl hy
          rw [← hx₂, Abelian.Ext.eq_zero_of_injective x₂, Abelian.Ext.zero_comp]
        have hx : x.comp (Abelian.Ext.mk₀ (K.homologyπ (j + 1))) (add_zero _) = 0 :=
          hK (i + 1) (j + 1) (by omega) _
        obtain ⟨y, hy⟩ := Abelian.Ext.covariant_sequence_exact₂ P hS2j x hx
        rw [← hy, ha y, Abelian.Ext.zero_comp]

    intro p hp c hc
    have h0 : ∀ y : Abelian.Ext P (K.homology (p + 1)) 0, y = 0 :=
      fun y => hK 0 (p + 1) (by omega) y
    have hE1 : ∀ y : Abelian.Ext P (K.cycles p) 1, y = 0 := fun y => hA p 0 (by omega) y
    let ct := K.liftCycles c (p + 1 + 1) (CochainComplex.next ℕ (p + 1)) hc
    have hct : ct ≫ K.iCycles (p + 1) = c := K.liftCycles_i _ _ _ _
    have hπ : ct ≫ K.homologyπ (p + 1) = 0 := by
      have e : Abelian.Ext.mk₀ (ct ≫ K.homologyπ (p + 1)) = Abelian.Ext.mk₀ 0 := by
        rw [h0 (Abelian.Ext.mk₀ (ct ≫ K.homologyπ (p + 1))), Abelian.Ext.mk₀_zero]
      rw [← Abelian.Ext.homEquiv₀_symm_apply, ← Abelian.Ext.homEquiv₀_symm_apply] at e
      exact Abelian.Ext.homEquiv₀.symm.injective e
    have hS2p := hS2 p
    haveI := hS2p.mono_f
    let b : P ⟶ Bo p := hS2p.exact.lift ct hπ
    have hb : b ≫ v p = ct := hS2p.exact.lift_f _ _
    have hΞ : (Abelian.Ext.mk₀ b).comp (hS1 p).extClass (zero_add 1) = 0 := hE1 _
    obtain ⟨x₂, hx₂⟩ := Abelian.Ext.covariant_sequence_exact₃ P (hS1 p)
      (Abelian.Ext.mk₀ b) (zero_add 1) hΞ
    let e : P ⟶ K.X p := Abelian.Ext.homEquiv₀ x₂
    have he : e ≫ u p = b := by
      have h3 : Abelian.Ext.mk₀ (e ≫ u p) = Abelian.Ext.mk₀ b := by
        rw [← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_homEquiv₀_apply]
        exact hx₂
      rw [← Abelian.Ext.homEquiv₀_symm_apply, ← Abelian.Ext.homEquiv₀_symm_apply] at h3
      exact Abelian.Ext.homEquiv₀.symm.injective h3
    refine ⟨e, ?_⟩
    rw [← hfac p, ← Category.assoc, he, ← Category.assoc, hb, hct]

  have hinj : ∀ j, Injective (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj
      I.cocomplex).X j) := fun j => by
    haveI := I.injective j
    exact Injective.injective_of_adjoint adj (I.cocomplex.X j)

  have hφ0 : ∀ j, (adj.homEquiv P (I.cocomplex.X j)) 0 = 0 := fun j => by
    rw [Adjunction.homEquiv_unit, Functor.map_zero, Limits.comp_zero]
  obtain ⟨p, rfl⟩ : ∃ p, k = p + 1 := ⟨k - 1, by omega⟩
  obtain ⟨f, hf, rfl⟩ := I.extMk_surjective x (p + 1 + 1) rfl
  have hc : adj.homEquiv P _ f ≫ R.map (I.cocomplex.d (p + 1) (p + 1 + 1)) = 0 := by
    rw [← adj.homEquiv_naturality_right, hf, hφ0]
  obtain ⟨e, he⟩ := claim _ hinj hH p hk (adj.homEquiv P _ f) hc
  rw [I.extMk_eq_zero_iff _ _ _ _ p rfl]
  refine ⟨(adj.homEquiv P _).symm e, ?_⟩
  rw [← adj.homEquiv_naturality_right_symm, Equiv.symm_apply_eq]
  exact he

theorem wc_et_stalks_zero : ∀ {B : Scheme.{u}} (F : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}), (∀ b : B, Subsingleton ((wcEtStalk B b).obj F)) → Limits.IsZero F :=
by
  intro B F hF
  have key : ∀ (V : B.Etale) (s : F.obj.obj (Opposite.op V)), s = 0 := by
    intro V s
    have hloc : ∀ v : V.left, ∃ (V₁ : B.Etale) (c : V₁ ⟶ V),
        v ∈ Set.range c.left ∧ F.obj.map c.op s = 0 := by
      intro v
      haveI : Etale V.hom := V.prop
      have hb : V.hom v = (wcEtGeomPt B (V.hom v))
          (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField (V.hom v)))) := by
        have e1 := Scheme.Hom.comp_apply (Spec.map (CommRingCat.ofHom (algebraMap
          (B.residueField (V.hom v)) (AlgebraicClosure (B.residueField (V.hom v))))))
          (B.fromSpecResidueField (V.hom v))
          (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField (V.hom v))))
        refine (e1.trans ?_).symm
        first
          | exact Scheme.fromSpecResidueField_apply _ _ _
          | exact Scheme.fromSpecResidueField_apply _ _
          | simp only [Scheme.fromSpecResidueField_apply]
      obtain ⟨t, ht, htv⟩ := wc_etale_lift_alg_closed_point
        (AlgebraicClosure (B.residueField (V.hom v))) V.hom (wcEtGeomPt B (V.hom v)) v hb
      let X₀ : Over B := Over.mk (wcEtGeomPt B (V.hom v))
      let A : StructuredArrow X₀ (Scheme.Etale.forget B) :=
        StructuredArrow.mk (Y := V) (Over.homMk (U := X₀) (V := (Scheme.Etale.forget B).obj V) t ht)
      let G := (StructuredArrow.proj X₀ (Scheme.Etale.forget B)).op ⋙ F.obj
      haveI : IsCofiltered (StructuredArrow X₀ (Scheme.Etale.forget B)) :=
        IsCofiltered.of_hasFiniteLimits _
      haveI : Limits.PreservesFilteredColimitsOfSize.{u, u+1} (forget AddCommGrpCat.{u+1}) :=
        Limits.preservesFilteredColimitsOfSize_shrink.{u+1, u+1, u, u+1} (forget AddCommGrpCat.{u+1})
      obtain ⟨k, f, g, hfg⟩ := Limits.Concrete.colimit_exists_of_rep_eq G
        (i := Opposite.op A) (j := Opposite.op A) s 0 (@Subsingleton.elim _ (hF (V.hom v)) _ _)
      refine ⟨k.unop.right, f.unop.right, ?_, ?_⟩
      · have hw : k.unop.hom.left ≫ f.unop.right.left = t :=
          congrArg (fun φ => φ.left) (StructuredArrow.w f.unop)
        refine ⟨k.unop.hom.left (IsLocalRing.closedPoint _), ?_⟩
        have e2 := Scheme.Hom.comp_apply k.unop.hom.left f.unop.right.left
          (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField (V.hom v))))
        have e3 : (k.unop.hom.left ≫ f.unop.right.left)
            (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField (V.hom v)))) =
            t (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField (V.hom v)))) := by
          first
            | rw [hw]
            | simp only [hw]
            | exact congrArg (fun φ => φ (IsLocalRing.closedPoint _)) hw
        exact (e2.symm.trans e3).trans htv
      · exact hfg.trans (map_zero _)
    have h2 := (wc_etale_section_vanishing_open B F V s).2 V (𝟙 V) (fun v _ => hloc v)
    rw [op_id, F.obj.map_id] at h2
    exact h2
  have hP : Limits.IsZero F.obj := by
    apply Functor.isZero
    intro X
    haveI : Subsingleton (F.obj.obj X) :=
      ⟨fun a b => (key X.unop a).trans (key X.unop b).symm⟩
    exact AddCommGrpCat.isZero_of_subsingleton _
  exact Limits.IsZero.of_full_of_faithful_of_isZero (sheafToPresheaf _ _) F hP

theorem wc_et_fibration_vanishing : ∀ (K : Type u) [Field K] [IsAlgClosed K] (X B : Scheme.{u}) (fB : B ⟶ Spec (.of K)) [IsProper fB] (g : X ⟶ B) [IsProper g] (ℓ : ℕ), ℓ.Prime → (ℓ : K) ≠ 0 → ∀ n : ℕ, (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (t : Spec (.of Ω) ⟶ B), topologicalKrullDim ↥(Limits.pullback g t) ≤ ((1 : ℕ) : WithBot ℕ∞)) → (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (C : Scheme.{u}) (fC : C ⟶ Spec (.of Ω)) [IsProper fC], (ℓ : Ω) ≠ 0 → topologicalKrullDim C ≤ ((1 : ℕ) : WithBot ℕ∞) → ∀ q : ℕ, 2 < q → Subsingleton (wcEtCoh C ℓ q)) → (letI : HasExt (Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}) := HasExt.standard _; ∀ (F : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}), ℓ • 𝟙 F = 0 → ∀ q : ℕ, 2 * n < q → ∀ x : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) F q, x = 0) → ∀ q : ℕ, 2 * n + 2 < q → Subsingleton (wcEtCoh X ℓ q) :=
by
  intro K _ _ X B fB _ g _ ℓ hℓ hℓK n hfib hcurve hTor q hq
  classical
  haveI := wc_et_enough_injectives X
  haveI := wc_et_enough_injectives B
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) := HasExt.standard _
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}) := HasExt.standard _

  have hM : ∀ (Y : Scheme.{u}), (ℓ : ℤ) • 𝟙 ((constantSheaf (Scheme.smallEtaleTopology Y)
      AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))) = 0 := by
    intro Y
    have h0 : (ℓ : ℤ) • 𝟙 (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))) = 0 := by
      ext x
      simp
    rw [← CategoryTheory.Functor.map_id (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}),
      ← CategoryTheory.Functor.map_zsmul, h0, CategoryTheory.Functor.map_zero]

  have htors : ∀ (I : InjectiveResolution ((constantSheaf (Scheme.smallEtaleTopology X)
      AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))))) (q' : ℕ),
      (ℓ : ℤ) • 𝟙 ((((wcEtPush g).mapHomologicalComplex (ComplexShape.up ℕ)).obj
        I.cocomplex).homology q') = 0 := by
    intro I q'
    have h1 : I.ι ≫ ((ℓ : ℤ) • 𝟙 I.cocomplex) =
        (CochainComplex.single₀ _).map ((ℓ : ℤ) • 𝟙 _) ≫ I.ι := by
      rw [CategoryTheory.Functor.map_zsmul, CategoryTheory.Functor.map_id, Preadditive.zsmul_comp,
        Category.id_comp, Preadditive.comp_zsmul, Category.comp_id]
    have h2 : I.ι ≫ (0 : I.cocomplex ⟶ I.cocomplex) =
        (CochainComplex.single₀ _).map ((ℓ : ℤ) • 𝟙 _) ≫ I.ι := by
      rw [hM X, CategoryTheory.Functor.map_zero, Limits.comp_zero, Limits.zero_comp]
    have ho := (wcEtPush g).mapHomotopy (InjectiveResolution.descHomotopy _ _ _ h1 h2)
    have e1 := Homotopy.homologyMap_eq ho q'
    rw [CategoryTheory.Functor.map_zsmul, CategoryTheory.Functor.map_id,
      CategoryTheory.Functor.map_zero, HomologicalComplex.homologyMap_zero] at e1
    have e2 : HomologicalComplex.homologyMap ((ℓ : ℤ) • 𝟙 (((wcEtPush g).mapHomologicalComplex
        (ComplexShape.up ℕ)).obj I.cocomplex)) q' = (ℓ : ℤ) • 𝟙 _ := by
      rw [← HomologicalComplex.homologyFunctor_map, CategoryTheory.Functor.map_zsmul,
        CategoryTheory.Functor.map_id]
      rfl
    rw [← e2]
    exact e1

  let I : InjectiveResolution ((constantSheaf (Scheme.smallEtaleTopology X)
      AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))) := injectiveResolution _
  obtain ⟨L, ⟨adj⟩, hPFL, ⟨e⟩⟩ := wc_et_push_left_adjoint g
  haveI := hPFL
  have hstalk := wc_et_proper_stalk_coh g ℓ hℓ.ne_zero wc_et_henselian_proper_vanishing I

  have hzero : ∀ q' : ℕ, 2 < q' → Limits.IsZero
      ((((wcEtPush g).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q') := by
    intro q' hq'
    apply wc_et_stalks_zero
    intro b
    obtain ⟨eb⟩ := hstalk b q'
    have hΩ : ((ℓ : ℕ) : AlgebraicClosure (B.residueField b)) ≠ 0 := by
      intro h
      apply hℓK
      have hinj := (Spec.preimage (wcEtGeomPt B b ≫ fB)).hom.injective
      apply hinj
      rw [map_natCast, map_zero]
      exact h
    haveI := hcurve (AlgebraicClosure (B.residueField b)) (Limits.pullback g (wcEtGeomPt B b))
      (Limits.pullback.snd g (wcEtGeomPt B b)) hΩ (hfib _ (wcEtGeomPt B b)) q' hq'
    exact eb.subsingleton

  have hEB : ∀ p q' : ℕ, 2 * n + 2 < p + q' → ∀ x : Abelian.Ext
      ((constantSheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ)))
      ((((wcEtPush g).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q')
        p, x = 0 := by
    intro p q' hpq x
    by_cases h2 : 2 < q'
    · have hz := hzero q' h2
      calc x = x.comp (Abelian.Ext.mk₀ (𝟙 _)) (add_zero p) := (Abelian.Ext.comp_mk₀_id x).symm
        _ = x.comp (Abelian.Ext.mk₀ 0) (add_zero p) := by rw [hz.eq_of_src (𝟙 _) 0]
        _ = 0 := by rw [Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
    · have htN : ℓ • 𝟙 ((((wcEtPush g).mapHomologicalComplex (ComplexShape.up ℕ)).obj
          I.cocomplex).homology q') = 0 := by
        rw [← natCast_zsmul]
        exact htors I q'
      exact hTor _ htN p (by omega) x
  have hk := wc_leray_ext_vanishing L (wcEtPush g) adj
    ((constantSheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} ℤ))) _ I (2 * n + 2) hEB q hq

  show Subsingleton (Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology X)
      AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) ((constantSheaf
        (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))) q)
  have hall : ∀ z : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology X)
      AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) ((constantSheaf
        (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))) q, z = 0 := by
    intro z
    have h := hk ((Abelian.Ext.mk₀ e.hom).comp z (zero_add q))
    calc z = (Abelian.Ext.mk₀ e.inv).comp ((Abelian.Ext.mk₀ e.hom).comp z (zero_add q))
          (zero_add q) := by
          simp only [Abelian.Ext.mk₀_comp_mk₀_assoc, Iso.inv_hom_id, Abelian.Ext.mk₀_id_comp]
      _ = 0 := by rw [h, Abelian.Ext.comp_zero]
  exact ⟨fun a b => (hall a).trans (hall b).symm⟩

theorem wc_et_cd_proper_torsion : ∀ (K : Type u) [Field K] [IsAlgClosed K] (Y : Scheme.{u}) (f : Y ⟶ Spec (.of K)) [IsProper f] (n : ℕ), topologicalKrullDim Y ≤ (n : WithBot ℕ∞) → ∀ (m : ℕ), (m : K) ≠ 0 → ∀ (G : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}), m • 𝟙 G = 0 →
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
    ∀ q : ℕ, 2 * n < q → ∀ x : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) G q, x = 0 :=
by
  intro K _ _ Y f _ n hdim m hm G hG
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
  intro q hq x
  have hm0 : m ≠ 0 := by
    rintro rfl
    exact hm Nat.cast_zero
  refine wc_ext_torsion_prime_devissage _ (2 * n) m hm0 ?_ G hG q hq x
  intro p hp hpm F hF q' hq' x'
  obtain ⟨c, hc⟩ := hpm
  have hpK : (p : K) ≠ 0 := by
    intro h
    apply hm
    rw [hc, Nat.cast_mul, h, zero_mul]

  have main : ∀ d : ℕ,
      (∀ (W : Scheme.{u}) (w : W ⟶ Spec (.of K)) [IsProper w],
        topologicalKrullDim W ≤ (d : WithBot ℕ∞) → ∀ q : ℕ, 2 * d < q →
          Subsingleton (wcEtCoh W p q)) ∧
      (∀ (Y' : Scheme.{u}) (f' : Y' ⟶ Spec (.of K)) [IsProper f'],
        topologicalKrullDim Y' ≤ (d : WithBot ℕ∞) →
        ∀ F : Sheaf (Scheme.smallEtaleTopology Y') AddCommGrpCat.{u+1}, p • 𝟙 F = 0 →
        letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y') AddCommGrpCat.{u+1}) :=
          HasExt.standard _
        ∀ q : ℕ, 2 * d < q → ∀ x : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y')
          AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) F q, x = 0) := by
    intro d
    induction d using Nat.strong_induction_on with
    | _ d IH =>
    have hC : ∀ (W : Scheme.{u}) (w : W ⟶ Spec (.of K)) [IsProper w],
        topologicalKrullDim W ≤ (d : WithBot ℕ∞) → ∀ q : ℕ, 2 * d < q →
          Subsingleton (wcEtCoh W p q) := by
      intro W w _ hW q hq
      rcases d with _ | e
      · exact wc_et_zero_dim_vanishing K W w hW p hp.ne_zero q (by omega)
      · obtain ⟨X', b, Z, iZ, B, fB, g, hb, hiZ, hfB, hg, hiso, hB, hZ, hE, hfib⟩ :=
          wc_proper_curve_fibration_cover K W w e hW
        haveI := hb
        haveI := hiZ
        haveI := hfB
        haveI := hg
        have IHe := IH e (Nat.lt_succ_self e)
        refine wc_et_abstract_blowup_vanishing W X' Z b iZ hiso p hp.ne_zero q ?_ ?_ ?_
        · exact wc_et_fibration_vanishing K X' B fB g p hp hpK e hfib
            (fun Ω _ _ C fC _ hΩ hC => wc_et_proper_curve_vanishing Ω C fC p hp hΩ hC)
            (IHe.2 B fB hB) q (by omega)
        · exact IHe.1 Z (iZ ≫ w) hZ q (by omega)
        · intro q' hq'
          exact IHe.1 (Limits.pullback b iZ) (Limits.pullback.snd b iZ ≫ iZ ≫ w) hE q'
            (by omega)
    refine ⟨hC, ?_⟩
    intro Y' f' _ hY' F hF
    refine wc_et_cd_constant_to_torsion K Y' f' p hp hpK ?_ d hY' F hF
    intro W π _ d' hW q'' hq''
    by_cases hd : d' < d
    · exact (IH d' hd).1 W (π ≫ f') hW q'' hq''
    · have h1 := wc_finite_topologicalKrullDim_le π
      exact hC W (π ≫ f') (h1.trans hY') q'' (by omega)
  exact (main n).2 Y f hdim F hF q' hq' x'

theorem wc_coh_torsion_vanishing : ∀ (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F))) [GeometricallyIrreducible X.hom] [IsProper X.hom] (d : ℕ) [SmoothOfRelativeDimension d X.hom] (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F) (h : WeaklyEtale (Limits.pullback.fst X.hom (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))) (A : Type) [AddCommGroup A] [TopologicalSpace A] [DiscreteTopology A] [IsTopologicalAddGroup A] (hA : ∀ a : A, ∃ k : ℕ, ℓ ^ k • a = 0), ∀ i : ℕ, 2 * d < i → ∀ x : Abelian.Ext (wcFreeSheaf X.left (wcGeomPoint F X h)) (wcContSheaf X.left A) i, x = 0 :=
by
  intro F _ _ X _ _ d _ ℓ hfact hℓ h A _ _ _ _ hA i hi x

  have hm : ∀ k : ℕ, ((ℓ ^ k : ℕ) : AlgebraicClosure F) ≠ 0 := by
    intro k hk
    have hk' : ((ℓ ^ k : ℕ) : F) = 0 := by
      apply (algebraMap F (AlgebraicClosure F)).injective
      rw [map_natCast, map_zero]
      exact hk
    haveI : Fintype F := Fintype.ofFinite F
    have hprime : Nat.Prime (ringChar F) := CharP.char_is_prime F (ringChar F)
    have h1 : ringChar F ∣ ℓ ^ k := (CharP.cast_eq_zero_iff F (ringChar F) _).mp hk'
    have h2 : ringChar F ∣ ℓ := hprime.dvd_of_dvd_pow h1
    have h3 : ringChar F = ℓ := (Nat.prime_dvd_prime_iff_eq hprime hfact.out).mp h2
    have h4 : ringChar F ∣ Nat.card F := by
      rw [Nat.card_eq_fintype_card]
      exact (CharP.cast_eq_zero_iff F (ringChar F) _).mp (FiniteField.cast_card_eq_zero F)
    exact hℓ (h3 ▸ h4)

  have key : ∀ (Y : Scheme.{u}) (fY : Y ⟶ Spec (.of (AlgebraicClosure F))) [IsProper fY]
      [SmoothOfRelativeDimension d fY],
      ∀ z : Abelian.Ext (wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y))) (wcContSheaf Y A) i, z = 0 := by
    intro Y fY _ _ z
    have hdim := wc_smooth_alg_closed_dim_le (AlgebraicClosure F) Y fY d
    have hc : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace fY
    have hqs : QuasiSeparatedSpace Y := quasiSeparatedSpace_of_quasiSeparated fY
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _

    have het : ∀ ξ : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y)
          AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)))
          ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
            (AddCommGrpCat.of (ULift.{u+1} A))) i, ξ = 0 := by
      intro ξ
      obtain ⟨k, B, φ, y, htor, hy⟩ := wc_et_ext_torsion_colim_lift Y hc hqs ℓ A hA i ξ
      have hy0 : y = 0 :=
        wc_et_cd_proper_torsion (AlgebraicClosure F) Y fY d hdim (ℓ ^ k) (hm k) B htor i hi y
      rw [← hy, hy0, Abelian.Ext.zero_comp]

    obtain ⟨E3⟩ := wc_proet_etale_comparison_const (AlgebraicClosure F) Y fY
      (AddCommGrpCat.of (ULift.{u+1} A)) i
    have hpro : ∀ w : Abelian.Ext (wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y)))
        ((constantSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} A))) i, w = 0 := by
      intro w
      exact E3.injective ((het (E3 w)).trans (het (E3 0)).symm)

    obtain ⟨e⟩ := wc_contSheaf_discrete_const Y A
    have h1 : z.comp (Abelian.Ext.mk₀ e.hom) (add_zero i) = 0 := hpro _
    calc z = (z.comp (Abelian.Ext.mk₀ e.hom) (add_zero i)).comp (Abelian.Ext.mk₀ e.inv)
          (add_zero i) := by
          rw [Abelian.Ext.comp_assoc _ _ _ (add_zero i) (add_zero 0) (by omega),
            Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
      _ = 0 := by rw [h1, Abelian.Ext.zero_comp]

  have hP : IsProper (Limits.pullback.snd X.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))) := inferInstance
  have hS : SmoothOfRelativeDimension d (Limits.pullback.snd X.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))) :=
    MorphismProperty.IsStableUnderBaseChange.of_isPullback (P := @SmoothOfRelativeDimension d)
      (IsPullback.of_hasPullback X.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))) ‹_›
  have hY := @key (wcGeomPoint F X h).left (Limits.pullback.snd X.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))) hP hS

  obtain ⟨E1⟩ := wc_ext_free_slice_cont X.left (wcGeomPoint F X h) A i
  exact E1.injective ((hY (E1 x)).trans (hY (E1 0)).symm)

theorem wc_padicInt_open_facts : ∀ (ℓ : ℕ) [Fact (Nat.Prime ℓ)], IsOpen (wcPadicIntSub ℓ : Set ℚ_[ℓ]) ∧ Topology.IsEmbedding (PadicInt.Coe.ringHom (p := ℓ)).toAddMonoidHom ∧ Continuous (PadicInt.Coe.ringHom (p := ℓ)).toAddMonoidHom ∧ ∀ x : ℚ_[ℓ], ∃ k : ℕ, ℓ ^ k • x ∈ wcPadicIntSub ℓ :=
by
  intro ℓ _
  have hmem : ∀ x : ℚ_[ℓ], x ∈ wcPadicIntSub ℓ ↔ ‖x‖ ≤ 1 := by
    intro x
    unfold wcPadicIntSub
    rw [AddMonoidHom.mem_range]
    constructor
    · rintro ⟨z, rfl⟩
      exact z.2
    · intro h
      exact ⟨⟨x, h⟩, rfl⟩
  have hset : (wcPadicIntSub ℓ : Set ℚ_[ℓ]) = Metric.closedBall (0 : ℚ_[ℓ]) 1 := by
    ext x
    rw [SetLike.mem_coe, hmem, mem_closedBall_zero_iff]
  refine ⟨?_, ?_, ?_, ?_⟩
  · rw [hset]
    exact IsUltrametricDist.isOpen_closedBall (0 : ℚ_[ℓ]) one_ne_zero
  · exact Topology.IsEmbedding.subtypeVal
  · exact continuous_subtype_val
  · intro x
    have hℓ1 : (1 : ℝ) < (ℓ : ℝ) := by
      exact_mod_cast (Fact.out : Nat.Prime ℓ).one_lt
    obtain ⟨k, hk⟩ := pow_unbounded_of_one_lt ‖x‖ hℓ1
    refine ⟨k, (hmem _).2 ?_⟩
    have hpos : (0 : ℝ) < (ℓ : ℝ) ^ k := pow_pos (by linarith) k
    rw [nsmul_eq_mul, Nat.cast_pow, norm_mul, norm_pow, Padic.norm_p, inv_pow]
    rw [inv_mul_le_iff₀ hpos, mul_one]
    exact hk.le

theorem wc_ext_tower_vanishing : ∀ {C : Type*} [Category C] [Abelian C] [HasExt C] (P Z Y : C) (B : ℕ → C) (pr : ∀ n, Y ⟶ B n) (c : ∀ n, B (n + 1) ⟶ B n) (T : Y ⟶ Y) (hT : ∀ n, T ≫ pr n = pr n - pr (n + 1) ≫ c n) (f : Z ⟶ Y) (hzero : f ≫ T = 0) (hS : (ShortComplex.mk f T hzero).ShortExact) (M : ℕ) (hinj : ∀ (N : ℕ) (x : Abelian.Ext P Y N), (∀ n, x.comp (Abelian.Ext.mk₀ (pr n)) (add_zero N) = 0) → x = 0) (hsurj : ∀ (N : ℕ) (y : ∀ n, Abelian.Ext P (B n) N), ∃ x : Abelian.Ext P Y N, ∀ n, x.comp (Abelian.Ext.mk₀ (pr n)) (add_zero N) = y n) (hB : ∀ (n i : ℕ), M < i → ∀ x : Abelian.Ext P (B n) i, x = 0) (hc : ∀ (n : ℕ) (y : Abelian.Ext P (B n) M), ∃ z : Abelian.Ext P (B (n + 1)) M, z.comp (Abelian.Ext.mk₀ (c n)) (add_zero M) = y), ∀ i : ℕ, M < i → ∀ x : Abelian.Ext P Z i, x = 0 :=
by
  intro C _ _ _ P Z Y B pr c T hT f hzero hS M hinj hsurj hB hc
  have s1 : ∀ j, M < j → ∀ x : Abelian.Ext P Y j, x = 0 := fun j hj x =>
    hinj j x (fun n => hB n j hj _)
  have s4 : ∀ y : Abelian.Ext P Y M, ∃ w : Abelian.Ext P Y M,
      w.comp (Abelian.Ext.mk₀ T) (add_zero M) = y := by
    intro y
    choose g hg using hc
    let x : ∀ n, Abelian.Ext P (B n) M := fun n =>
      Nat.rec (motive := fun n => Abelian.Ext P (B n) M) 0
        (fun n xn => g n (xn - y.comp (Abelian.Ext.mk₀ (pr n)) (add_zero M))) n
    have hx : ∀ n, (x (n + 1)).comp (Abelian.Ext.mk₀ (c n)) (add_zero M) =
        x n - y.comp (Abelian.Ext.mk₀ (pr n)) (add_zero M) := fun n => hg n _
    obtain ⟨w, hw⟩ := hsurj M x
    refine ⟨w, ?_⟩
    rw [← sub_eq_zero]
    apply hinj M
    intro n
    have key : ∀ (a b : Abelian.Ext P Y M) (g : Y ⟶ B n),
        (a - b).comp (Abelian.Ext.mk₀ g) (add_zero M) =
          a.comp (Abelian.Ext.mk₀ g) (add_zero M) - b.comp (Abelian.Ext.mk₀ g) (add_zero M) := by
      intro a b g
      rw [sub_eq_add_neg, Abelian.Ext.add_comp, Abelian.Ext.neg_comp, ← sub_eq_add_neg]
    have h1 : (w.comp (Abelian.Ext.mk₀ T) (add_zero M)).comp (Abelian.Ext.mk₀ (pr n)) (add_zero M) =
        w.comp (Abelian.Ext.mk₀ (pr n)) (add_zero M) -
          (w.comp (Abelian.Ext.mk₀ (pr (n + 1))) (add_zero M)).comp (Abelian.Ext.mk₀ (c n))
            (add_zero M) := by
      rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, hT n,
        Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀,
        sub_eq_add_neg, Abelian.Ext.mk₀_add, Abelian.Ext.mk₀_neg, Abelian.Ext.comp_add,
        Abelian.Ext.comp_neg, ← sub_eq_add_neg]
    rw [key, h1, hw, hw, hx]
    abel
  intro i hi z
  obtain ⟨k, rfl⟩ : ∃ k, i = k + 1 := ⟨i - 1, by omega⟩
  have h0 : z.comp (Abelian.Ext.mk₀ f) (add_zero (k + 1)) = 0 := s1 _ hi _
  obtain ⟨x₃, hx₃⟩ := Abelian.Ext.covariant_sequence_exact₁ P hS z h0 (rfl : k + 1 = k + 1)
  rw [← hx₃]
  rcases Nat.lt_or_ge M k with hk | hk
  · rw [s1 k hk x₃, Abelian.Ext.zero_comp]
  · have hkM : k = M := by omega
    subst hkM
    obtain ⟨w, hw⟩ := s4 x₃
    rw [← hw, Abelian.Ext.comp_assoc_of_second_deg_zero]
    have h2 := hS.comp_extClass
    erw [h2, Abelian.Ext.comp_zero]

theorem wc_coh_vanishing (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    [GeometricallyIrreducible X.hom] [IsProper X.hom] (d : ℕ) [SmoothOfRelativeDimension d X.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F)
    (h : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))) :
    ∀ i : ℕ, 2 * d < i → ∀ x : wcCoh F X h ℓ i, x = 0 :=
by

  have hT0 : ∀ (A : Type) [AddCommGroup A] [TopologicalSpace A] [DiscreteTopology A]
      [IsTopologicalAddGroup A], (∀ a : A, ∃ k : ℕ, ℓ ^ k • a = 0) →
      ∀ i : ℕ, 2 * d < i → ∀ x : Abelian.Ext (wcFreeSheaf X.left (wcGeomPoint F X h))
        (wcContSheaf X.left A) i, x = 0 :=
    fun A _ _ _ _ hA => wc_coh_torsion_vanishing F X d ℓ hℓ h A hA

  have hzmod : ∀ (m : ℕ) (a : ZMod (ℓ ^ m)), ℓ ^ m • a = 0 := by
    intro m a
    rw [nsmul_eq_mul, ZMod.natCast_self, zero_mul]

  have hc : ∀ (n : ℕ) (y : Abelian.Ext (wcFreeSheaf X.left (wcGeomPoint F X h))
      (wcContSheaf X.left (ZMod (ℓ ^ n))) (2 * d)),
      ∃ z : Abelian.Ext (wcFreeSheaf X.left (wcGeomPoint F X h))
        (wcContSheaf X.left (ZMod (ℓ ^ (n + 1)))) (2 * d),
        z.comp (Abelian.Ext.mk₀ (wcContSheafMap X.left (wcTowerCast ℓ n)
          continuous_of_discreteTopology)) (add_zero _) = y := by
    intro n y
    have hsurj : Function.Surjective (wcTowerCast ℓ n) :=
      ZMod.castHom_surjective (pow_dvd_pow ℓ (Nat.le_succ n))
    obtain ⟨hz, hS⟩ := wc_contSheaf_shortExact X.left ((wcTowerCast ℓ n).ker.subtype)
      continuous_subtype_val (wcTowerCast ℓ n) continuous_of_discreteTopology
      Topology.IsEmbedding.subtypeVal
      (fun b => ⟨fun hb => ⟨⟨b, hb⟩, rfl⟩, by rintro ⟨a, rfl⟩; exact a.2⟩)
      ⟨Function.surjInv hsurj, continuous_of_discreteTopology, Function.surjInv_eq hsurj⟩
    have hy : y.comp hS.extClass (rfl : 2 * d + 1 = 2 * d + 1) = 0 :=
      hT0 _ (fun k => ⟨n + 1, Subtype.ext (by
        simp only [AddSubgroup.coe_nsmul, AddSubgroup.coe_zero]
        exact hzmod (n + 1) k.1)⟩) _ (by omega) _
    obtain ⟨z, hz⟩ := Abelian.Ext.covariant_sequence_exact₃ _ hS y rfl hy
    exact ⟨z, hz⟩

  haveI := wc_proet_products_exact X.left
  obtain ⟨hcont_incl, hemb, hcont_shift, hker, hsec⟩ := wc_padic_tower_facts ℓ
  obtain ⟨hz2, hS2⟩ := wc_contSheaf_shortExact X.left (wcTowerIncl ℓ) hcont_incl
    (wcTowerShift ℓ) hcont_shift hemb hker hsec
  have hY := (wc_contSheaf_pi_isLimit X.left (fun n => ZMod (ℓ ^ n))).some
  have hprod := fun N => wc_ext_prod_bijective (wcFreeSheaf X.left (wcGeomPoint F X h))
    (wcContSheaf X.left ((n : ℕ) → ZMod (ℓ ^ n))) (fun n => wcContSheaf X.left (ZMod (ℓ ^ n)))
    (fun n => wcContSheafMap X.left (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) n)
      (continuous_apply n)) hY N
  have hcongr : ∀ {A B : Type} [AddCommGroup A] [TopologicalSpace A] [IsTopologicalAddGroup A]
      [AddCommGroup B] [TopologicalSpace B] [IsTopologicalAddGroup B] (φ φ' : A →+ B)
      (e : φ = φ') (hφ : Continuous φ) (hφ' : Continuous φ'),
      wcContSheafMap X.left φ hφ = wcContSheafMap X.left φ' hφ' := by
    intro A B _ _ _ _ _ _ φ φ' e hφ hφ'
    subst e
    rfl
  have hTn : ∀ n, wcContSheafMap X.left (wcTowerShift ℓ) hcont_shift ≫
      wcContSheafMap X.left (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) n) (continuous_apply n) =
      wcContSheafMap X.left (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) n) (continuous_apply n) -
      wcContSheafMap X.left (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) (n + 1))
        (continuous_apply (n + 1)) ≫
      wcContSheafMap X.left (wcTowerCast ℓ n) continuous_of_discreteTopology := by
    intro n
    have e1 := (wc_contSheafMap_comp_sub X.left (wcTowerShift ℓ) (wcTowerShift ℓ) hcont_shift
      hcont_shift (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) n) (continuous_apply n)).1
    have e2 := (wc_contSheafMap_comp_sub X.left
      (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) (n + 1))
      (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) (n + 1)) (continuous_apply (n + 1))
      (continuous_apply (n + 1)) (wcTowerCast ℓ n) continuous_of_discreteTopology).1
    have e3 := (wc_contSheafMap_comp_sub X.left
      (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) n)
      ((wcTowerCast ℓ n).comp (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) (n + 1)))
      (continuous_apply n)
      ((continuous_of_discreteTopology (f := ⇑(wcTowerCast ℓ n))).comp (continuous_apply (n + 1)))
      (AddMonoidHom.id (ZMod (ℓ ^ n))) continuous_id).2
    rw [← e1, ← e2, ← e3]
    exact hcongr _ _ (AddMonoidHom.ext fun a => rfl) _ _
  have hInt : ∀ i : ℕ, 2 * d < i → ∀ x : Abelian.Ext (wcFreeSheaf X.left (wcGeomPoint F X h))
      (wcContSheaf X.left ℤ_[ℓ]) i, x = 0 :=
    wc_ext_tower_vanishing (wcFreeSheaf X.left (wcGeomPoint F X h)) _ _
      (fun n => wcContSheaf X.left (ZMod (ℓ ^ n)))
      (fun n => wcContSheafMap X.left (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) n)
        (continuous_apply n))
      (fun n => wcContSheafMap X.left (wcTowerCast ℓ n) continuous_of_discreteTopology)
      _ hTn _ hz2 hS2 (2 * d) (fun N => (hprod N).1) (fun N => (hprod N).2)
      (fun n i hi x => hT0 (ZMod (ℓ ^ n)) (fun a => ⟨n, hzmod n a⟩) i hi x) hc

  intro i hi x
  change Abelian.Ext (wcFreeSheaf X.left (wcGeomPoint F X h)) (wcContSheaf X.left ℚ_[ℓ]) i at x
  obtain ⟨hopen, hemb', hcont', htors⟩ := wc_padicInt_open_facts ℓ
  haveI : DiscreteTopology (ℚ_[ℓ] ⧸ wcPadicIntSub ℓ) := QuotientAddGroup.discreteTopology hopen
  have hmk_surj : Function.Surjective (QuotientAddGroup.mk' (wcPadicIntSub ℓ)) :=
    QuotientAddGroup.mk'_surjective _
  have hmk_cont : Continuous (QuotientAddGroup.mk' (wcPadicIntSub ℓ)) :=
    QuotientAddGroup.continuous_mk
  obtain ⟨hz1, hS1⟩ := wc_contSheaf_shortExact X.left (PadicInt.Coe.ringHom (p := ℓ)).toAddMonoidHom
    hcont' (QuotientAddGroup.mk' (wcPadicIntSub ℓ)) hmk_cont hemb'
    (fun b => by
      rw [QuotientAddGroup.mk'_apply, QuotientAddGroup.eq_zero_iff]
      exact AddMonoidHom.mem_range)
    ⟨Function.surjInv hmk_surj, continuous_of_discreteTopology, Function.surjInv_eq hmk_surj⟩
  have htorsQ : ∀ a : ℚ_[ℓ] ⧸ wcPadicIntSub ℓ, ∃ k : ℕ, ℓ ^ k • a = 0 := by
    intro a
    induction a using QuotientAddGroup.induction_on with
    | H z =>
      obtain ⟨k, hk⟩ := htors z
      exact ⟨k, by rw [← QuotientAddGroup.mk_nsmul, QuotientAddGroup.eq_zero_iff]; exact hk⟩
  have hx2 : x.comp (Abelian.Ext.mk₀ (wcContSheafMap X.left (QuotientAddGroup.mk' (wcPadicIntSub ℓ))
      hmk_cont)) (add_zero i) = 0 := hT0 _ htorsQ i hi _
  obtain ⟨x₁, hx₁⟩ := Abelian.Ext.covariant_sequence_exact₂ _ hS1 x hx2
  rw [← hx₁, hInt i hi x₁, Abelian.Ext.zero_comp]
  rfl

theorem wc_points_eq_frob_fixed (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    (E : Type u) [Field E] [Algebra F E] [FiniteDimensional F E] :
    Nat.card (Over.mk (Spec.map <| CommRingCat.ofHom <| algebraMap F E) ⟶ X) =
      Nat.card {x : Over.mk (Spec.map <| CommRingCat.ofHom <| algebraMap F (AlgebraicClosure F)) ⟶ X //
        Spec.map (CommRingCat.ofHom
          (((@FiniteField.frobeniusAlgEquivOfAlgebraic F _ (Fintype.ofFinite F)
              (AlgebraicClosure F) _ _ _) ^ Module.finrank F E :
              AlgebraicClosure F ≃ₐ[F] AlgebraicClosure F) : AlgebraicClosure F →+* AlgebraicClosure F))
          ≫ x.left = x.left} :=
by
  classical

  have s1 : ∀ (ι : E →ₐ[F] AlgebraicClosure F) (a : AlgebraicClosure F),
      ((@FiniteField.frobeniusAlgEquivOfAlgebraic F _ (Fintype.ofFinite F)
        (AlgebraicClosure F) _ _ _) ^ Module.finrank F E :
          AlgebraicClosure F ≃ₐ[F] AlgebraicClosure F) a = a ↔ a ∈ Set.range ι := by
    intro ι a
    letI : Fintype F := Fintype.ofFinite F
    haveI : Finite E := Module.finite_of_finite F
    letI : Fintype E := Fintype.ofFinite E
    have hiter : ∀ k : ℕ, ∀ b : AlgebraicClosure F,
        ((FiniteField.frobeniusAlgEquivOfAlgebraic F (AlgebraicClosure F)) ^ k) b
          = b ^ (Fintype.card F ^ k) := by
      intro k
      induction k with
      | zero => intro b; simp
      | succ k ih =>
        intro b
        rw [pow_succ', AlgEquiv.mul_apply, ih, FiniteField.frobeniusAlgEquivOfAlgebraic_apply,
          ← pow_mul, pow_succ]
    have hcardE : Fintype.card E = Fintype.card F ^ Module.finrank F E := by
      rw [Fintype.card_eq_nat_card, Fintype.card_eq_nat_card,
        Module.natCard_eq_pow_finrank (K := F) (V := E)]
    have hE : ∀ y : E, y ^ (Fintype.card F ^ Module.finrank F E) = y := by
      intro y; rw [← hcardE]; exact FiniteField.pow_card y
    have hinj : Function.Injective ι := (ι : E →+* AlgebraicClosure F).injective
    have hn0 : Module.finrank F E ≠ 0 := (Module.finrank_pos (R := F) (M := E)).ne'
    have hq1 : 1 < Fintype.card F := by
      rw [Fintype.card_eq_nat_card]; exact Finite.one_lt_card
    rw [hiter]
    constructor
    · intro ha
      set P : Polynomial (AlgebraicClosure F) :=
        Polynomial.X ^ (Fintype.card F ^ Module.finrank F E) - Polynomial.X with hP
      have hP0 : P ≠ 0 := FiniteField.X_pow_card_pow_sub_X_ne_zero (AlgebraicClosure F) hn0 hq1
      have hdeg : P.natDegree = Fintype.card F ^ Module.finrank F E :=
        FiniteField.X_pow_card_pow_sub_X_natDegree_eq (AlgebraicClosure F) hn0 hq1
      have hroot : ∀ b : AlgebraicClosure F,
          b ^ (Fintype.card F ^ Module.finrank F E) = b → b ∈ P.roots.toFinset := by
        intro b hb
        rw [Multiset.mem_toFinset, Polynomial.mem_roots hP0, Polynomial.IsRoot.def, hP,
          Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X, hb, sub_self]
      have hT : (Finset.univ.image ι).card = Fintype.card F ^ Module.finrank F E := by
        rw [Finset.card_image_of_injective _ hinj, Finset.card_univ, hcardE]
      have hTS : Finset.univ.image ι ⊆ P.roots.toFinset := by
        intro b hb
        obtain ⟨y, _, rfl⟩ := Finset.mem_image.mp hb
        apply hroot
        rw [← map_pow, hE]
      have hcard : P.roots.toFinset.card ≤ (Finset.univ.image ι).card :=
        (Multiset.toFinset_card_le _).trans ((Polynomial.card_roots' _).trans (hdeg.le.trans hT.ge))
      have hEq := Finset.eq_of_subset_of_card_le hTS hcard
      have hmem : a ∈ Finset.univ.image ι := by rw [hEq]; exact hroot a ha
      obtain ⟨y, _, hy⟩ := Finset.mem_image.mp hmem
      exact ⟨y, hy⟩
    · rintro ⟨y, rfl⟩
      rw [← map_pow, hE]

  have cancel : ∀ (K L : Type u) [Field K] [Field L] (ι : K →+* L) (Z : Scheme.{u})
      (g₁ g₂ : Spec (CommRingCat.of K) ⟶ Z),
      Spec.map (CommRingCat.ofHom ι) ≫ g₁ = Spec.map (CommRingCat.ofHom ι) ≫ g₂ → g₁ = g₂ := by
    intro K L _ _ ι Z g₁ g₂ h
    obtain ⟨⟨z₁, φ₁⟩, rfl⟩ := (Scheme.SpecToEquivOfField K Z).symm.surjective g₁
    obtain ⟨⟨z₂, φ₂⟩, rfl⟩ := (Scheme.SpecToEquivOfField K Z).symm.surjective g₂
    have key : ∀ (z : Z) (φ : Z.residueField z ⟶ CommRingCat.of K),
        Spec.map (CommRingCat.ofHom ι) ≫ (Scheme.SpecToEquivOfField K Z).symm ⟨z, φ⟩ =
          (Scheme.SpecToEquivOfField L Z).symm ⟨z, φ ≫ CommRingCat.ofHom ι⟩ := by
      intro z φ
      rw [Scheme.SpecToEquivOfField_symm_apply, Scheme.SpecToEquivOfField_symm_apply,
        Spec.map_comp, Category.assoc]
    rw [key, key] at h
    obtain ⟨e, he⟩ := Scheme.SpecToEquivOfField_eq_iff.mp
      ((Scheme.SpecToEquivOfField L Z).symm.injective h)
    dsimp only at e he
    subst e
    rw [Scheme.residueFieldCongr_refl, Iso.refl_hom, Category.id_comp] at he
    have hφ : φ₁ = φ₂ := by
      apply CommRingCat.hom_ext
      apply RingHom.ext
      intro a
      apply ι.injective
      have := congrArg (fun f => f.hom a) he
      simpa using this
    rw [hφ]

  have descend : ∀ (K L : Type u) [Field K] [Field L] (ι : K →+* L) (τ : L →+* L)
      (hτ : ∀ a : L, τ a = a → a ∈ Set.range ι) (Z : Scheme.{u})
      (g : Spec (CommRingCat.of L) ⟶ Z),
      Spec.map (CommRingCat.ofHom τ) ≫ g = g →
        ∃ g₀ : Spec (CommRingCat.of K) ⟶ Z, Spec.map (CommRingCat.ofHom ι) ≫ g₀ = g := by
    intro K L _ _ ι τ hτ Z g hg
    obtain ⟨⟨z, φ⟩, rfl⟩ := (Scheme.SpecToEquivOfField L Z).symm.surjective g
    have hg' : (Scheme.SpecToEquivOfField L Z).symm ⟨z, φ ≫ CommRingCat.ofHom τ⟩ =
        (Scheme.SpecToEquivOfField L Z).symm ⟨z, φ⟩ := by
      rw [← hg, Scheme.SpecToEquivOfField_symm_apply, Scheme.SpecToEquivOfField_symm_apply,
        Spec.map_comp, Category.assoc]
    obtain ⟨e, he⟩ := Scheme.SpecToEquivOfField_eq_iff.mp
      ((Scheme.SpecToEquivOfField L Z).symm.injective hg')
    dsimp only at e he
    rw [Scheme.residueFieldCongr_refl, Iso.refl_hom, Category.id_comp] at he
    have hfix : ∀ a, φ.hom a ∈ ι.range := by
      intro a
      have h1 := congrArg (fun f => f.hom a) he
      simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply] at h1
      obtain ⟨y, hy⟩ := hτ _ h1
      exact ⟨y, hy⟩
    let j : K ≃+* ι.range := RingEquiv.ofBijective ι.rangeRestrict
      ⟨fun x y hxy => ι.injective (congrArg Subtype.val hxy), ι.rangeRestrict_surjective⟩
    let ψ : Z.residueField z →+* K := j.symm.toRingHom.comp (φ.hom.codRestrict ι.range hfix)
    have hψ : ι.comp ψ = φ.hom := by
      ext a
      have h2 : ι.rangeRestrict (j.symm (φ.hom.codRestrict ι.range hfix a)) =
          φ.hom.codRestrict ι.range hfix a := j.apply_symm_apply _
      exact congrArg Subtype.val h2
    refine ⟨Spec.map (CommRingCat.ofHom ψ) ≫ Z.fromSpecResidueField z, ?_⟩
    rw [Scheme.SpecToEquivOfField_symm_apply, ← Category.assoc, ← Spec.map_comp,
      ← CommRingCat.ofHom_comp, hψ]
    rfl

  have assemble : ∀ (L : Type u) [Field L] [Algebra F L] (ι : E →ₐ[F] L) (τ : L →+* L),
      τ.comp (ι : E →+* L) = ι → (∀ a, τ a = a → a ∈ Set.range ι) →
      Nat.card (Over.mk (Spec.map <| CommRingCat.ofHom <| algebraMap F E) ⟶ X) =
      Nat.card {x : Over.mk (Spec.map <| CommRingCat.ofHom <| algebraMap F L) ⟶ X //
        Spec.map (CommRingCat.ofHom τ) ≫ x.left = x.left} := by
    intro L _ _ ι τ h1 h2
    have hB : Spec.map (CommRingCat.ofHom (ι : E →+* L)) ≫
        Spec.map (CommRingCat.ofHom (algebraMap F E)) =
          Spec.map (CommRingCat.ofHom (algebraMap F L)) := by
      rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, AlgHom.comp_algebraMap]
    let Ψ : (Over.mk (Spec.map <| CommRingCat.ofHom <| algebraMap F E) ⟶ X) →
        {x : Over.mk (Spec.map <| CommRingCat.ofHom <| algebraMap F L) ⟶ X //
          Spec.map (CommRingCat.ofHom τ) ≫ x.left = x.left} :=
      fun f => ⟨Over.homMk (Spec.map (CommRingCat.ofHom (ι : E →+* L)) ≫ f.left) (by
          rw [Category.assoc, Over.w f]; exact hB), by
        show Spec.map (CommRingCat.ofHom τ) ≫
            (Spec.map (CommRingCat.ofHom (ι : E →+* L)) ≫ f.left) =
          Spec.map (CommRingCat.ofHom (ι : E →+* L)) ≫ f.left
        rw [← Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp, h1]⟩
    have hinj : Function.Injective Ψ := by
      intro f₁ f₂ h
      have h' := congrArg (fun p => p.1.left) h
      simp only [Ψ, Over.homMk_left] at h'
      exact Over.OverMorphism.ext (cancel E L ι X.left _ _ h')
    have h2' : ∀ a, τ a = a → a ∈ Set.range (ι : E →+* L) := by
      intro a ha; rw [RingHom.coe_coe]; exact h2 a ha
    have hsurj : Function.Surjective Ψ := by
      rintro ⟨x, hx⟩
      obtain ⟨g₀, hg₀⟩ := descend E L ι τ h2' X.left x.left hx
      have w₀ : g₀ ≫ X.hom = Spec.map (CommRingCat.ofHom (algebraMap F E)) := by
        apply cancel E L ι (Spec (CommRingCat.of F))
        rw [← Category.assoc, hg₀, hB]
        exact Over.w x
      refine ⟨Over.homMk g₀ w₀, ?_⟩
      apply Subtype.ext
      apply Over.OverMorphism.ext
      simp only [Ψ, Over.homMk_left]
      exact hg₀
    exact Nat.card_congr (Equiv.ofBijective Ψ ⟨hinj, hsurj⟩)
  let ι : E →ₐ[F] AlgebraicClosure F := IsAlgClosed.lift
  refine assemble (AlgebraicClosure F) ι _ ?_ ?_
  · apply RingHom.ext
    intro y
    exact (s1 ι (ι y)).mpr ⟨y, rfl⟩
  · intro a ha
    exact (s1 ι a).mp ha

theorem wc_proet_pullback_continuous_flat {A B : Scheme.{u}} (f : A ⟶ B) :
    (wcProEtPullback f).IsContinuous (Scheme.ProEt.topology B) (Scheme.ProEt.topology A) ∧
      RepresentablyFlat (wcProEtPullback f) :=
by
  have crit : ∀ (S : Scheme.{u}) (X : S.ProEt) (R : Sieve X),
      R ∈ Scheme.ProEt.topology S X ↔
        Sieve.functorPushforward (Scheme.ProEt.forget S ⋙ Over.forget S) R ∈
          Scheme.proetaleTopology X.left := by
    intro S X R
    letI := MorphismProperty.IsMultiplicative.toIsStableUnderComposition (W := @WeaklyEtale)
    have h : Scheme.ProEt.topology S =
        (Scheme.ProEt.forget S).restrictedTopology (Scheme.proetaleTopology.over S) :=
      MorphismProperty.toGrothendieck_comap_forget_eq_restrictedTopology (S := S)
        (P := @WeaklyEtale) Scheme.proetalePrecoverage
        Scheme.proetalePrecoverage_le_precoverage_weaklyEtale
    rw [h, Functor.mem_restrictedTopology_iff, GrothendieckTopology.mem_over_iff,
      Sieve.overEquiv_apply, ← Sieve.functorPushforward_comp]
    rfl
  have hpres : Limits.PreservesFiniteLimits (wcProEtPullback f) := by
    let e : Scheme.ProEt.forget B ⋙ Over.pullback f ≅
        wcProEtPullback f ⋙ Scheme.ProEt.forget A :=
      NatIso.ofComponents (fun _ => Iso.refl _) (fun _ => rfl)
    haveI : Limits.PreservesFiniteLimits (wcProEtPullback f ⋙ Scheme.ProEt.forget A) :=
      Limits.preservesFiniteLimits_of_natIso e
    exact Limits.preservesFiniteLimits_of_reflects_of_preserves (wcProEtPullback f)
      (Scheme.ProEt.forget A)
  haveI := hpres
  haveI hflat : RepresentablyFlat (wcProEtPullback f) :=
    flat_of_preservesFiniteLimits (wcProEtPullback f)
  have hle : ∀ (U : B.ProEt) (R : Sieve U),
      Sieve.pullback (Limits.pullback.fst U.hom f)
        (Sieve.functorPushforward (Scheme.ProEt.forget B ⋙ Over.forget B) R) ≤
      Sieve.functorPushforward (Scheme.ProEt.forget A ⋙ Over.forget A)
        (Sieve.functorPushforward (wcProEtPullback f) R) := by
    intro U R Z h hh
    obtain ⟨V, g, k, hg, hk⟩ := hh
    change h ≫ Limits.pullback.fst U.hom f = k ≫ g.left at hk
    have hw : g.left ≫ U.hom = V.hom := MorphismProperty.Over.w g
    have w : k ≫ V.hom = (h ≫ Limits.pullback.snd U.hom f) ≫ f :=
      calc k ≫ V.hom = k ≫ (g.left ≫ U.hom) := congrArg (k ≫ ·) hw.symm
      _ = (k ≫ g.left) ≫ U.hom := (Category.assoc _ _ _).symm
      _ = (h ≫ Limits.pullback.fst U.hom f) ≫ U.hom := congrArg (· ≫ U.hom) hk.symm
      _ = h ≫ (Limits.pullback.fst U.hom f ≫ U.hom) := Category.assoc _ _ _
      _ = h ≫ (Limits.pullback.snd U.hom f ≫ f) := congrArg (h ≫ ·) Limits.pullback.condition
      _ = (h ≫ Limits.pullback.snd U.hom f) ≫ f := (Category.assoc _ _ _).symm
    refine ⟨(wcProEtPullback f).obj V, (wcProEtPullback f).map g,
      Limits.pullback.lift k (h ≫ Limits.pullback.snd U.hom f) w,
      Sieve.image_mem_functorPushforward (wcProEtPullback f) R hg, ?_⟩
    have hmap : ((wcProEtPullback f).map g).left =
        Limits.pullback.lift (Limits.pullback.fst V.hom f ≫ g.left) (Limits.pullback.snd V.hom f)
          (by rw [Category.assoc, MorphismProperty.Over.w g]; exact Limits.pullback.condition) :=
      rfl
    change h = Limits.pullback.lift k (h ≫ Limits.pullback.snd U.hom f) w ≫
      ((wcProEtPullback f).map g).left
    rw [hmap]
    apply Limits.pullback.hom_ext
    · refine hk.trans ?_
      refine Eq.symm ((Category.assoc _ _ _).trans ?_)
      refine (congrArg (fun x => Limits.pullback.lift k (h ≫ Limits.pullback.snd U.hom f) w ≫ x)
        (Limits.pullback.lift_fst _ _ _)).trans ?_
      refine (Category.assoc _ _ _).symm.trans ?_
      exact congrArg (fun x => x ≫ g.left) (Limits.pullback.lift_fst _ _ _)
    · refine Eq.symm ((Category.assoc _ _ _).trans ?_)
      refine (congrArg (fun x => Limits.pullback.lift k (h ≫ Limits.pullback.snd U.hom f) w ≫ x)
        (Limits.pullback.lift_snd _ _ _)).trans ?_
      exact Limits.pullback.lift_snd _ _ _
  have hcov : CoverPreserving (Scheme.ProEt.topology B) (Scheme.ProEt.topology A)
      (wcProEtPullback f) := by
    refine ⟨fun {U} {R} hR => ?_⟩
    have hS := (crit B U R).1 hR
    have hP := Scheme.proetaleTopology.pullback_stable (Limits.pullback.fst U.hom f) hS
    have hQ := Scheme.proetaleTopology.superset_covering (hle U R) hP
    exact (crit A ((wcProEtPullback f).obj U) (Sieve.functorPushforward (wcProEtPullback f) R)).2 hQ
  exact ⟨Functor.isContinuous_of_coverPreserving
    (compatiblePreservingOfFlat (Scheme.ProEt.topology A) (wcProEtPullback f)) hcov, hflat⟩

theorem wc_sheafPullback_preservesFiniteLimits_of_flat {C D : Type (u+1)} [Category.{u} C]
    [Category.{u} D] (J : GrothendieckTopology C) (K : GrothendieckTopology D) (G : C ⥤ D)
    [G.IsContinuous J K] [RepresentablyFlat G]
    [HasSheafify J AddCommGrpCat.{u+1}] [HasSheafify K AddCommGrpCat.{u+1}] :
    Limits.PreservesFiniteLimits (G.sheafPullback AddCommGrpCat.{u+1} J K) :=
by
  have wc_lan_eval_iso : ∀ {C D : Type (u+1)} [Category.{u} C] [Category.{u} D] (L : C ⥤ D)
      [∀ F : C ⥤ AddCommGrpCat.{u+1}, L.HasPointwiseLeftKanExtension F]
      [∀ F : C ⥤ AddCommGrpCat.{u+1}, L.HasLeftKanExtension F] (Y : D),
      Nonempty ((L.lan : (C ⥤ AddCommGrpCat.{u+1}) ⥤ (D ⥤ AddCommGrpCat.{u+1})) ⋙
          (evaluation D AddCommGrpCat.{u+1}).obj Y ≅
        (Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj (CostructuredArrow.proj L Y) ⋙
          Limits.colim) := by
    intro C D _ _ L _ _ Y
    refine ⟨NatIso.ofComponents (fun F => L.leftKanExtensionObjIsoColimit F Y) ?_⟩
    intro F₁ F₂ φ
    have hnat : ∀ j : CostructuredArrow L Y,
        (L.leftKanExtension F₁).map j.hom ≫ (L.lan.map φ).app Y =
        (L.lan.map φ).app (L.obj j.left) ≫ (L.leftKanExtension F₂).map j.hom :=
      fun j => (L.lan.map φ).naturality j.hom
    have hfac : ∀ j : CostructuredArrow L Y,
        (L.leftKanExtensionUnit F₁).app j.left ≫ (L.lan.map φ).app (L.obj j.left) =
        φ.app j.left ≫ (L.leftKanExtensionUnit F₂).app j.left := fun j =>
      Functor.descOfIsLeftKanExtension_fac_app (L.leftKanExtension F₁)
        (L.leftKanExtensionUnit F₁) (L.leftKanExtension F₂) (φ ≫ L.leftKanExtensionUnit F₂) j.left
    refine (Iso.inv_comp_eq _).1 ?_
    apply Limits.colimit.hom_ext
    intro j
    have key : (L.leftKanExtensionUnit F₁).app j.left ≫ (L.leftKanExtension F₁).map j.hom ≫
        (L.lan.map φ).app Y ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom =
        φ.app j.left ≫ Limits.colimit.ι (CostructuredArrow.proj L Y ⋙ F₂) j :=
      calc (L.leftKanExtensionUnit F₁).app j.left ≫ (L.leftKanExtension F₁).map j.hom ≫
            (L.lan.map φ).app Y ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom
          = (L.leftKanExtensionUnit F₁).app j.left ≫ ((L.leftKanExtension F₁).map j.hom ≫
            (L.lan.map φ).app Y) ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom :=
            congrArg ((L.leftKanExtensionUnit F₁).app j.left ≫ ·) (Category.assoc _ _ _).symm
        _ = (L.leftKanExtensionUnit F₁).app j.left ≫ ((L.lan.map φ).app (L.obj j.left) ≫
            (L.leftKanExtension F₂).map j.hom) ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom :=
            congrArg (fun k => (L.leftKanExtensionUnit F₁).app j.left ≫ k ≫
              (L.leftKanExtensionObjIsoColimit F₂ Y).hom) (hnat j)
        _ = ((L.leftKanExtensionUnit F₁).app j.left ≫ (L.lan.map φ).app (L.obj j.left)) ≫
            (L.leftKanExtension F₂).map j.hom ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom :=
            (congrArg ((L.leftKanExtensionUnit F₁).app j.left ≫ ·) (Category.assoc _ _ _)).trans
              (Category.assoc _ _ _).symm
        _ = (φ.app j.left ≫ (L.leftKanExtensionUnit F₂).app j.left) ≫
            (L.leftKanExtension F₂).map j.hom ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom :=
            congrArg (· ≫ (L.leftKanExtension F₂).map j.hom ≫
              (L.leftKanExtensionObjIsoColimit F₂ Y).hom) (hfac j)
        _ = φ.app j.left ≫ ((L.leftKanExtensionUnit F₂).app j.left ≫
            (L.leftKanExtension F₂).map j.hom ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom) :=
            Category.assoc _ _ _
        _ = φ.app j.left ≫ Limits.colimit.ι (CostructuredArrow.proj L Y ⋙ F₂) j :=
            congrArg (φ.app j.left ≫ ·) (Functor.ι_leftKanExtensionObjIsoColimit_hom L F₂ Y j)
    erw [Functor.ι_leftKanExtensionObjIsoColimit_inv_assoc, Limits.ι_colimMap]
    exact key
  have wc_lan_pfl_of_filtered : ∀ {C D : Type (u+1)} [Category.{u} C]
      [Category.{u} D] (L : C ⥤ D)
      [∀ F : C ⥤ AddCommGrpCat.{u+1}, L.HasPointwiseLeftKanExtension F]
      [∀ F : C ⥤ AddCommGrpCat.{u+1}, L.HasLeftKanExtension F],
      (∀ Y : D, IsFiltered (CostructuredArrow L Y)) →
      Limits.PreservesFiniteLimits
        (L.lan : (C ⥤ AddCommGrpCat.{u+1}) ⥤ (D ⥤ AddCommGrpCat.{u+1})) := by
    intro C D _ _ L _ _ hfilt
    constructor
    intro J _ _
    apply Limits.preservesLimitsOfShape_of_evaluation
    intro Y
    obtain ⟨θ⟩ := wc_lan_eval_iso L Y
    haveI := hfilt Y
    haveI : HasExactColimitsOfShape (CostructuredArrow L Y) AddCommGrpCat.{u+1} :=
      HasExactColimitsOfShape.of_domain_equivalence AddCommGrpCat.{u+1}
        (ULiftHom.equiv : CostructuredArrow L Y ≌ ULiftHom.{u+1} (CostructuredArrow L Y)).symm
    exact Limits.preservesLimitsOfShape_of_natIso θ.symm
  haveI : Limits.PreservesFiniteLimits
      (G.op.lan : (Cᵒᵖ ⥤ AddCommGrpCat.{u+1}) ⥤ (Dᵒᵖ ⥤ AddCommGrpCat.{u+1})) :=
    wc_lan_pfl_of_filtered G.op (fun Y => inferInstance)
  exact Functor.sheafPullbackConstruction.preservesFiniteLimits G AddCommGrpCat.{u+1} J K

theorem wc_presheafOfModules_pushforward_isRightAdjoint : ∀ {C D : Type (u+1)} [Category.{u} C]
    [Category.{u} D] (G : C ⥤ D) {R : Dᵒᵖ ⥤ RingCat.{u+1}} {S : Cᵒᵖ ⥤ RingCat.{u+1}}
    (ψ : S ⟶ G.op ⋙ R), (PresheafOfModules.pushforward.{u+1} ψ).IsRightAdjoint :=
by
  intro C D _ _ G R S ψ
  let A := PresheafOfModules.pushforward.{u+1} (F := (ULiftHom.down : ULiftHom.{u+1} D ⥤ D))
    (𝟙 ((ULiftHom.down : ULiftHom.{u+1} D ⥤ D).op ⋙ R))
  let P' := PresheafOfModules.pushforward.{u+1}
    (F := (ULiftHom.down ⋙ G ⋙ ULiftHom.up : ULiftHom.{u+1} C ⥤ ULiftHom.{u+1} D))
    (R := (ULiftHom.down : ULiftHom.{u+1} D ⥤ D).op ⋙ R)
    (S := (ULiftHom.down : ULiftHom.{u+1} C ⥤ C).op ⋙ S)
    (Functor.whiskerLeft (ULiftHom.down : ULiftHom.{u+1} C ⥤ C).op ψ)
  let BC := PresheafOfModules.pushforward.{u+1} (F := (ULiftHom.up : C ⥤ ULiftHom.{u+1} C))
    (R := (ULiftHom.down : ULiftHom.{u+1} C ⥤ C).op ⋙ S) (S := S) (𝟙 S)
  let AC := PresheafOfModules.pushforward.{u+1} (F := (ULiftHom.down : ULiftHom.{u+1} C ⥤ C))
    (𝟙 ((ULiftHom.down : ULiftHom.{u+1} C ⥤ C).op ⋙ S))
  let BD := PresheafOfModules.pushforward.{u+1} (F := (ULiftHom.up : D ⥤ ULiftHom.{u+1} D))
    (R := (ULiftHom.down : ULiftHom.{u+1} D ⥤ D).op ⋙ R) (S := R) (𝟙 R)
  have eA : A.IsEquivalence :=
    Functor.IsEquivalence.mk' BD (NatIso.ofComponents (fun M => Iso.refl _) (fun _ => rfl))
      (NatIso.ofComponents (fun M => Iso.refl _) (fun _ => rfl))
  have eB : BC.IsEquivalence :=
    Functor.IsEquivalence.mk' AC (NatIso.ofComponents (fun M => Iso.refl _) (fun _ => rfl))
      (NatIso.ofComponents (fun M => Iso.refl _) (fun _ => rfl))
  have hA : A.IsRightAdjoint := Functor.isRightAdjoint_of_isEquivalence
  have hB : BC.IsRightAdjoint := Functor.isRightAdjoint_of_isEquivalence
  have hP : P'.IsRightAdjoint := PresheafOfModules.instIsRightAdjointPushforward _
  have hPB : (P' ⋙ BC).IsRightAdjoint := Functor.isRightAdjoint_comp
  have hAPB : (A ⋙ P' ⋙ BC).IsRightAdjoint := Functor.isRightAdjoint_comp
  have e : A ⋙ P' ⋙ BC ≅ PresheafOfModules.pushforward.{u+1} ψ :=
    NatIso.ofComponents (fun M => Iso.refl _) (fun _ => rfl)
  exact Functor.isRightAdjoint_of_iso e

theorem wc_lan_ring_rep : ∀ {C D : Type (u+1)} [Category.{u} C] [Category.{u} D] (G : C ⥤ D) [RepresentablyFlat G]
    (S : Cᵒᵖ ⥤ RingCat.{u+1}) (R₀ : Dᵒᵖ ⥤ RingCat.{u+1}) (ψ : S ⟶ G.op ⋙ R₀),
    (Functor.LeftExtension.mk R₀ ψ).IsPointwiseLeftKanExtension →
    (∀ (Y : D) (x : R₀.obj (Opposite.op Y)), ∃ (V : C) (a : Y ⟶ G.obj V) (r : S.obj (Opposite.op V)),
        x = (R₀.map a.op).hom ((ψ.app (Opposite.op V)).hom r)) ∧
    (∀ (Y : D) (V₁ V₂ : C) (a₁ : Y ⟶ G.obj V₁) (a₂ : Y ⟶ G.obj V₂) (r₁ : S.obj (Opposite.op V₁))
        (r₂ : S.obj (Opposite.op V₂)),
        (R₀.map a₁.op).hom ((ψ.app (Opposite.op V₁)).hom r₁) =
          (R₀.map a₂.op).hom ((ψ.app (Opposite.op V₂)).hom r₂) →
        ∃ (W : C) (b : Y ⟶ G.obj W) (c₁ : W ⟶ V₁) (c₂ : W ⟶ V₂),
          b ≫ G.map c₁ = a₁ ∧ b ≫ G.map c₂ = a₂ ∧ (S.map c₁.op).hom r₁ = (S.map c₂.op).hom r₂) :=
by
  intro C D _ _ G _ S R₀ ψ hψ
  letI : Limits.PreservesFilteredColimitsOfSize.{u, u+1} (forget RingCat.{u+1}) :=
    Limits.preservesFilteredColimitsOfSize_shrink.{u+1, u+1, u, u+1} (forget RingCat.{u+1})
  refine ⟨fun Y x => ?_, fun Y V₁ V₂ a₁ a₂ r₁ r₂ h => ?_⟩
  · obtain ⟨j, y, hy⟩ := Limits.Concrete.isColimit_exists_rep _ (hψ (Opposite.op Y)) x
    obtain ⟨⟨V⟩, ⟨⟨⟩⟩, a'⟩ := j
    refine ⟨V, a'.unop, y, ?_⟩
    rw [← hy]
    rfl
  · let i₁ : CostructuredArrow G.op (Opposite.op Y) := CostructuredArrow.mk (Y := Opposite.op V₁)
      (a₁.op : G.op.obj (Opposite.op V₁) ⟶ Opposite.op Y)
    let i₂ : CostructuredArrow G.op (Opposite.op Y) := CostructuredArrow.mk (Y := Opposite.op V₂)
      (a₂.op : G.op.obj (Opposite.op V₂) ⟶ Opposite.op Y)
    have h0 : (((Functor.LeftExtension.mk R₀ ψ).coconeAt (Opposite.op Y)).ι.app i₁) r₁ =
        (((Functor.LeftExtension.mk R₀ ψ).coconeAt (Opposite.op Y)).ι.app i₂) r₂ := h
    have h' := (Limits.Concrete.isColimit_rep_eq_iff_exists _ (hψ (Opposite.op Y))
      (i := i₁) (j := i₂) r₁ r₂).mp h0
    obtain ⟨k, f, g, hfg⟩ := h'
    obtain ⟨⟨W⟩, ⟨⟨⟩⟩, b'⟩ := k
    refine ⟨W, b'.unop, f.left.unop, g.left.unop, ?_, ?_, ?_⟩
    · exact congrArg Quiver.Hom.unop (CostructuredArrow.w f)
    · exact congrArg Quiver.Hom.unop (CostructuredArrow.w g)
    · exact hfg

theorem wc_lan_ab_rep : ∀ {C D : Type (u+1)} [Category.{u} C] [Category.{u} D] (G : C ⥤ D) [RepresentablyFlat G]
    (F : Cᵒᵖ ⥤ AddCommGrpCat.{u+1}) (F' : Dᵒᵖ ⥤ AddCommGrpCat.{u+1}) (η : F ⟶ G.op ⋙ F'),
    (Functor.LeftExtension.mk F' η).IsPointwiseLeftKanExtension →
    (∀ (Y : D) (t : F'.obj (Opposite.op Y)), ∃ (V : C) (a : Y ⟶ G.obj V) (m : F.obj (Opposite.op V)),
        t = (F'.map a.op).hom ((η.app (Opposite.op V)).hom m)) ∧
    (∀ (Y : D) (V₁ V₂ : C) (a₁ : Y ⟶ G.obj V₁) (a₂ : Y ⟶ G.obj V₂) (m₁ : F.obj (Opposite.op V₁))
        (m₂ : F.obj (Opposite.op V₂)),
        (F'.map a₁.op).hom ((η.app (Opposite.op V₁)).hom m₁) =
          (F'.map a₂.op).hom ((η.app (Opposite.op V₂)).hom m₂) →
        ∃ (W : C) (b : Y ⟶ G.obj W) (c₁ : W ⟶ V₁) (c₂ : W ⟶ V₂),
          b ≫ G.map c₁ = a₁ ∧ b ≫ G.map c₂ = a₂ ∧ (F.map c₁.op).hom m₁ = (F.map c₂.op).hom m₂) :=
by
  intro C D _ _ G _ F F' η hη
  letI : Limits.PreservesFilteredColimitsOfSize.{u, u+1} (forget AddCommGrpCat.{u+1}) :=
    Limits.preservesFilteredColimitsOfSize_shrink.{u+1, u+1, u, u+1} (forget AddCommGrpCat.{u+1})
  refine ⟨fun Y t => ?_, fun Y V₁ V₂ a₁ a₂ m₁ m₂ h => ?_⟩
  · obtain ⟨j, y, hy⟩ := Limits.Concrete.isColimit_exists_rep _ (hη (Opposite.op Y)) t
    refine ⟨j.left.unop, j.hom.unop, y, ?_⟩
    rw [← hy]
    rfl
  · have h' : ConcreteCategory.hom
        (((Functor.LeftExtension.mk F' η).coconeAt (Opposite.op Y)).ι.app
          (CostructuredArrow.mk (Y := Opposite.op V₁)
            (a₁.op : G.op.obj (Opposite.op V₁) ⟶ Opposite.op Y))) m₁ =
      ConcreteCategory.hom
        (((Functor.LeftExtension.mk F' η).coconeAt (Opposite.op Y)).ι.app
          (CostructuredArrow.mk (Y := Opposite.op V₂)
            (a₂.op : G.op.obj (Opposite.op V₂) ⟶ Opposite.op Y))) m₂ := by
      first
        | exact h
        | (simp only [Functor.LeftExtension.coconeAt_ι_app, ConcreteCategory.comp_apply]
           exact h)
    obtain ⟨k, f, g, hfg⟩ :=
      (Limits.Concrete.isColimit_rep_eq_iff_exists _ (hη (Opposite.op Y)) _ _).mp h'
    have hf := CostructuredArrow.w f
    have hg := CostructuredArrow.w g
    refine ⟨k.left.unop, k.hom.unop, f.left.unop, g.left.unop, ?_, ?_, ?_⟩
    · exact congrArg Quiver.Hom.unop hf
    · exact congrArg Quiver.Hom.unop hg
    · exact hfg

theorem wc_lan_joint_rep : ∀ {C D : Type (u+1)} [Category.{u} C] [Category.{u} D] (G : C ⥤ D) [RepresentablyFlat G]
    (S : Cᵒᵖ ⥤ RingCat.{u+1}) (R₀ : Dᵒᵖ ⥤ RingCat.{u+1}) (ψ : S ⟶ G.op ⋙ R₀)
    (F : Cᵒᵖ ⥤ AddCommGrpCat.{u+1}) (F' : Dᵒᵖ ⥤ AddCommGrpCat.{u+1}) (η : F ⟶ G.op ⋙ F'),
    (∀ (Y : D) (x : R₀.obj (Opposite.op Y)), ∃ (V : C) (a : Y ⟶ G.obj V) (r : S.obj (Opposite.op V)),
        x = (R₀.map a.op).hom ((ψ.app (Opposite.op V)).hom r)) →
    (∀ (Y : D) (t : F'.obj (Opposite.op Y)), ∃ (V : C) (a : Y ⟶ G.obj V) (m : F.obj (Opposite.op V)),
        t = (F'.map a.op).hom ((η.app (Opposite.op V)).hom m)) →
    ∀ (Y : D) (x y : R₀.obj (Opposite.op Y)) (t t' : F'.obj (Opposite.op Y)),
      ∃ (W : C) (b : Y ⟶ G.obj W) (r s : S.obj (Opposite.op W)) (m n : F.obj (Opposite.op W)),
        x = (R₀.map b.op).hom ((ψ.app (Opposite.op W)).hom r) ∧
        y = (R₀.map b.op).hom ((ψ.app (Opposite.op W)).hom s) ∧
        t = (F'.map b.op).hom ((η.app (Opposite.op W)).hom m) ∧
        t' = (F'.map b.op).hom ((η.app (Opposite.op W)).hom n) :=
by
  intro C D _ _ G _ S R₀ ψ F F' η hRS hAS Y x y t t'
  have transR : ∀ {V W : C} (a : Y ⟶ G.obj V) (b : Y ⟶ G.obj W) (c : W ⟶ V),
      b ≫ G.map c = a → ∀ z : S.obj (Opposite.op V),
      (R₀.map a.op).hom ((ψ.app (Opposite.op V)).hom z) =
        (R₀.map b.op).hom ((ψ.app (Opposite.op W)).hom ((S.map c.op).hom z)) := by
    intro V W a b c h z
    subst h
    have hn := congrArg (fun f => f.hom z) (ψ.naturality c.op)
    simp only [RingCat.hom_comp, RingHom.comp_apply, Functor.comp_map, Functor.op_map,
      Quiver.Hom.unop_op] at hn
    rw [hn, op_comp, Functor.map_comp, RingCat.hom_comp, RingHom.comp_apply]
  have transF : ∀ {V W : C} (a : Y ⟶ G.obj V) (b : Y ⟶ G.obj W) (c : W ⟶ V),
      b ≫ G.map c = a → ∀ z : F.obj (Opposite.op V),
      (F'.map a.op).hom ((η.app (Opposite.op V)).hom z) =
        (F'.map b.op).hom ((η.app (Opposite.op W)).hom ((F.map c.op).hom z)) := by
    intro V W a b c h z
    subst h
    have hn := congrArg (fun f => f.hom z) (η.naturality c.op)
    simp only [AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply, Functor.comp_map,
      Functor.op_map, Quiver.Hom.unop_op] at hn
    rw [hn, op_comp, Functor.map_comp, AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply]
  obtain ⟨V₁, a₁, r₁, hx⟩ := hRS Y x
  obtain ⟨V₂, a₂, r₂, hy⟩ := hRS Y y
  obtain ⟨V₃, a₃, m₃, ht⟩ := hAS Y t
  obtain ⟨V₄, a₄, m₄, ht'⟩ := hAS Y t'
  haveI : IsCofiltered (StructuredArrow Y G) := RepresentablyFlat.cofiltered Y
  let A₁ : StructuredArrow Y G := StructuredArrow.mk a₁
  let A₂ : StructuredArrow Y G := StructuredArrow.mk a₂
  let A₃ : StructuredArrow Y G := StructuredArrow.mk a₃
  let A₄ : StructuredArrow Y G := StructuredArrow.mk a₄
  let B₁ := IsCofiltered.min A₁ A₂
  let B₂ := IsCofiltered.min A₃ A₄
  let M := IsCofiltered.min B₁ B₂
  let p₁ : M ⟶ A₁ := IsCofiltered.minToLeft B₁ B₂ ≫ IsCofiltered.minToLeft A₁ A₂
  let p₂ : M ⟶ A₂ := IsCofiltered.minToLeft B₁ B₂ ≫ IsCofiltered.minToRight A₁ A₂
  let p₃ : M ⟶ A₃ := IsCofiltered.minToRight B₁ B₂ ≫ IsCofiltered.minToLeft A₃ A₄
  let p₄ : M ⟶ A₄ := IsCofiltered.minToRight B₁ B₂ ≫ IsCofiltered.minToRight A₃ A₄
  have h₁ : M.hom ≫ G.map p₁.right = a₁ := StructuredArrow.w p₁
  have h₂ : M.hom ≫ G.map p₂.right = a₂ := StructuredArrow.w p₂
  have h₃ : M.hom ≫ G.map p₃.right = a₃ := StructuredArrow.w p₃
  have h₄ : M.hom ≫ G.map p₄.right = a₄ := StructuredArrow.w p₄
  refine ⟨M.right, M.hom, (S.map p₁.right.op).hom r₁, (S.map p₂.right.op).hom r₂,
    (F.map p₃.right.op).hom m₃, (F.map p₄.right.op).hom m₄, ?_, ?_, ?_, ?_⟩
  · rw [hx]; exact transR a₁ M.hom p₁.right h₁ r₁
  · rw [hy]; exact transR a₂ M.hom p₂.right h₂ r₂
  · rw [ht]; exact transF a₃ M.hom p₃.right h₃ m₃
  · rw [ht']; exact transF a₄ M.hom p₄.right h₄ m₄

theorem wc_lan_smul_well_defined : ∀ {C D : Type (u+1)} [Category.{u} C] [Category.{u} D] (G : C ⥤ D) [RepresentablyFlat G]
    (S : Cᵒᵖ ⥤ RingCat.{u+1}) (R₀ : Dᵒᵖ ⥤ RingCat.{u+1}) (ψ : S ⟶ G.op ⋙ R₀)
    (M : PresheafOfModules.{u+1} S) (F' : Dᵒᵖ ⥤ AddCommGrpCat.{u+1}) (η : M.presheaf ⟶ G.op ⋙ F'),
    (∀ (Y : D) (V₁ V₂ : C) (a₁ : Y ⟶ G.obj V₁) (a₂ : Y ⟶ G.obj V₂) (r₁ : S.obj (Opposite.op V₁))
        (r₂ : S.obj (Opposite.op V₂)),
        (R₀.map a₁.op).hom ((ψ.app (Opposite.op V₁)).hom r₁) =
          (R₀.map a₂.op).hom ((ψ.app (Opposite.op V₂)).hom r₂) →
        ∃ (W : C) (b : Y ⟶ G.obj W) (c₁ : W ⟶ V₁) (c₂ : W ⟶ V₂),
          b ≫ G.map c₁ = a₁ ∧ b ≫ G.map c₂ = a₂ ∧ (S.map c₁.op).hom r₁ = (S.map c₂.op).hom r₂) →
    (∀ (Y : D) (V₁ V₂ : C) (a₁ : Y ⟶ G.obj V₁) (a₂ : Y ⟶ G.obj V₂) (m₁ : M.presheaf.obj (Opposite.op V₁))
        (m₂ : M.presheaf.obj (Opposite.op V₂)),
        (F'.map a₁.op).hom ((η.app (Opposite.op V₁)).hom m₁) =
          (F'.map a₂.op).hom ((η.app (Opposite.op V₂)).hom m₂) →
        ∃ (W : C) (b : Y ⟶ G.obj W) (c₁ : W ⟶ V₁) (c₂ : W ⟶ V₂),
          b ≫ G.map c₁ = a₁ ∧ b ≫ G.map c₂ = a₂ ∧
            (M.presheaf.map c₁.op).hom m₁ = (M.presheaf.map c₂.op).hom m₂) →
    ∀ (Y : D) (W W' : C) (b : Y ⟶ G.obj W) (b' : Y ⟶ G.obj W') (r : S.obj (Opposite.op W))
      (r' : S.obj (Opposite.op W')) (m : M.obj (Opposite.op W)) (m' : M.obj (Opposite.op W')),
      (R₀.map b.op).hom ((ψ.app (Opposite.op W)).hom r) = (R₀.map b'.op).hom ((ψ.app (Opposite.op W')).hom r') →
      (F'.map b.op).hom ((η.app (Opposite.op W)).hom m) = (F'.map b'.op).hom ((η.app (Opposite.op W')).hom m') →
      (F'.map b.op).hom ((η.app (Opposite.op W)).hom (r • m)) =
        (F'.map b'.op).hom ((η.app (Opposite.op W')).hom (r' • m')) :=
by
  intro C D _ _ G _ S R₀ ψ M F' η HR HM Y W W' b b' r r' m m' hr hm
  obtain ⟨W₁, β₁, c₁, c₁', hc₁, hc₁', hrr⟩ := HR Y W W' b b' r r' hr
  obtain ⟨W₂, β₂, d, d', hd, hd', hmm⟩ := HM Y W W' b b' m m' hm

  have hrefine : ∃ (W₅ : C) (β₅ : Y ⟶ G.obj W₅) (k : W₅ ⟶ W₁) (l : W₅ ⟶ W₂),
      β₅ ≫ G.map k = β₁ ∧ k ≫ c₁ = l ≫ d ∧ k ≫ c₁' = l ≫ d' := by
    let P₁ : StructuredArrow Y G := StructuredArrow.mk β₁
    let P₂ : StructuredArrow Y G := StructuredArrow.mk β₂
    let A : StructuredArrow Y G := StructuredArrow.mk b
    let A' : StructuredArrow Y G := StructuredArrow.mk b'
    let f₁ : P₁ ⟶ A := StructuredArrow.homMk c₁ hc₁
    let f₁' : P₁ ⟶ A' := StructuredArrow.homMk c₁' hc₁'
    let g : P₂ ⟶ A := StructuredArrow.homMk d hd
    let g' : P₂ ⟶ A' := StructuredArrow.homMk d' hd'
    let u : IsCofiltered.min P₁ P₂ ⟶ P₁ := IsCofiltered.minToLeft P₁ P₂
    let v : IsCofiltered.min P₁ P₂ ⟶ P₂ := IsCofiltered.minToRight P₁ P₂
    let h : IsCofiltered.eq (u ≫ f₁) (v ≫ g) ⟶ IsCofiltered.min P₁ P₂ :=
      IsCofiltered.eqHom (u ≫ f₁) (v ≫ g)
    have e1 : h ≫ u ≫ f₁ = h ≫ v ≫ g := IsCofiltered.eq_condition _ _
    let h' : IsCofiltered.eq (h ≫ u ≫ f₁') (h ≫ v ≫ g') ⟶ IsCofiltered.eq (u ≫ f₁) (v ≫ g) :=
      IsCofiltered.eqHom (h ≫ u ≫ f₁') (h ≫ v ≫ g')
    have e2 : h' ≫ h ≫ u ≫ f₁' = h' ≫ h ≫ v ≫ g' := IsCofiltered.eq_condition _ _
    refine ⟨(IsCofiltered.eq (h ≫ u ≫ f₁') (h ≫ v ≫ g')).right,
      (IsCofiltered.eq (h ≫ u ≫ f₁') (h ≫ v ≫ g')).hom,
      (h' ≫ h ≫ u).right, (h' ≫ h ≫ v).right, StructuredArrow.w (h' ≫ h ≫ u), ?_, ?_⟩
    · show ((h' ≫ h ≫ u) ≫ f₁).right = ((h' ≫ h ≫ v) ≫ g).right
      simp only [Category.assoc]
      exact congrArg (fun φ => φ.right) (h' ≫= e1)
    · show ((h' ≫ h ≫ u) ≫ f₁').right = ((h' ≫ h ≫ v) ≫ g').right
      simp only [Category.assoc]
      exact congrArg (fun φ => φ.right) e2
  obtain ⟨W₅, β₅, k, l, hk, hkc, hkc'⟩ := hrefine

  have tr : ∀ (U V : C) (β : Y ⟶ G.obj U) (q : U ⟶ V) (x : M.obj (Opposite.op V)),
      (F'.map (β ≫ G.map q).op).hom ((η.app (Opposite.op V)).hom x) =
        (F'.map β.op).hom ((η.app (Opposite.op U)).hom ((M.presheaf.map q.op).hom x)) := by
    intro U V β q x
    have hn := congrArg (fun f => AddCommGrpCat.Hom.hom f x) (η.naturality q.op)
    change (F'.map ((G.map q).op ≫ β.op)).hom ((η.app (Opposite.op V)).hom x) = _
    rw [F'.map_comp, AddCommGrpCat.hom_comp, AddMonoidHom.coe_comp, Function.comp_apply]
    exact congrArg (F'.map β.op).hom hn.symm
  have hsm : ∀ (U V : C) (q : U ⟶ V) (s : S.obj (Opposite.op V)) (x : M.obj (Opposite.op V)),
      (M.presheaf.map q.op).hom (s • x) = (S.map q.op).hom s • (M.presheaf.map q.op).hom x := by
    intro U V q s x
    exact PresheafOfModules.map_smul M q.op s x
  have hb : b = β₅ ≫ G.map (k ≫ c₁) := by rw [G.map_comp, ← Category.assoc, hk, hc₁]
  have hb' : b' = β₅ ≫ G.map (k ≫ c₁') := by rw [G.map_comp, ← Category.assoc, hk, hc₁']
  have hS : (S.map (k ≫ c₁).op).hom r = (S.map (k ≫ c₁').op).hom r' := by
    simp only [op_comp, Functor.map_comp, RingCat.hom_comp, RingHom.coe_comp,
      Function.comp_apply, hrr]
  have hM : (M.presheaf.map (k ≫ c₁).op).hom m = (M.presheaf.map (k ≫ c₁').op).hom m' := by
    rw [hkc, hkc']
    simp only [op_comp, Functor.map_comp, AddCommGrpCat.hom_comp, AddMonoidHom.coe_comp]
    exact congrArg _ hmm
  rw [hb, hb', tr, tr, hsm, hsm, hS, hM]

theorem wc_lan_presheafOfModules_mk : ∀ {C D : Type (u+1)} [Category.{u} C] [Category.{u} D] (G : C ⥤ D)
    (S : Cᵒᵖ ⥤ RingCat.{u+1}) (R₀ : Dᵒᵖ ⥤ RingCat.{u+1}) (ψ : S ⟶ G.op ⋙ R₀)
    (M : PresheafOfModules.{u+1} S) (F' : Dᵒᵖ ⥤ AddCommGrpCat.{u+1}) (η : M.presheaf ⟶ G.op ⋙ F'),
    (∀ (Y : D) (W W' : C) (b : Y ⟶ G.obj W) (b' : Y ⟶ G.obj W') (r : S.obj (Opposite.op W))
      (r' : S.obj (Opposite.op W')) (m : M.obj (Opposite.op W)) (m' : M.obj (Opposite.op W')),
      (R₀.map b.op).hom ((ψ.app (Opposite.op W)).hom r) = (R₀.map b'.op).hom ((ψ.app (Opposite.op W')).hom r') →
      (F'.map b.op).hom ((η.app (Opposite.op W)).hom m) = (F'.map b'.op).hom ((η.app (Opposite.op W')).hom m') →
      (F'.map b.op).hom ((η.app (Opposite.op W)).hom (r • m)) =
        (F'.map b'.op).hom ((η.app (Opposite.op W')).hom (r' • m'))) →
    (∀ (Y : D) (x y : R₀.obj (Opposite.op Y)) (t t' : F'.obj (Opposite.op Y)),
      ∃ (W : C) (b : Y ⟶ G.obj W) (r s : S.obj (Opposite.op W)) (m n : M.obj (Opposite.op W)),
        x = (R₀.map b.op).hom ((ψ.app (Opposite.op W)).hom r) ∧
        y = (R₀.map b.op).hom ((ψ.app (Opposite.op W)).hom s) ∧
        t = (F'.map b.op).hom ((η.app (Opposite.op W)).hom m) ∧
        t' = (F'.map b.op).hom ((η.app (Opposite.op W)).hom n)) →
    ∃ (N : PresheafOfModules.{u+1} R₀) (e : N.presheaf ≅ F'),
      ∀ (Y : D) (W : C) (b : Y ⟶ G.obj W) (r : S.obj (Opposite.op W)) (m : M.obj (Opposite.op W)),
        ((R₀.map b.op).hom ((ψ.app (Opposite.op W)).hom r) •
          ((e.inv.app (Opposite.op Y)).hom ((F'.map b.op).hom ((η.app (Opposite.op W)).hom m))) :
            N.obj (Opposite.op Y)) =
        (e.inv.app (Opposite.op Y)).hom ((F'.map b.op).hom ((η.app (Opposite.op W)).hom (r • m))) :=
by
  intro C D _ _ G S R₀ ψ M F' η WD JR
  classical
  have JR1 : ∀ (Y : D) (x : R₀.obj (Opposite.op Y)) (t : F'.obj (Opposite.op Y)),
      ∃ (W : C) (b : Y ⟶ G.obj W) (r : S.obj (Opposite.op W)) (m : M.obj (Opposite.op W)),
        x = (R₀.map b.op).hom ((ψ.app (Opposite.op W)).hom r) ∧
        t = (F'.map b.op).hom ((η.app (Opposite.op W)).hom m) := by
    intro Y x t
    obtain ⟨W, b, r, _, m, _, hx, _, ht, _⟩ := JR Y x x t t
    exact ⟨W, b, r, m, hx, ht⟩
  choose Wc bc rc mc hx ht using JR1
  obtain ⟨smul, hF⟩ : ∃ smul : ∀ Y : D, R₀.obj (Opposite.op Y) → F'.obj (Opposite.op Y) →
      F'.obj (Opposite.op Y),
      ∀ (Y : D) (W : C) (b : Y ⟶ G.obj W) (r : S.obj (Opposite.op W)) (m : M.obj (Opposite.op W)),
        smul Y ((R₀.map b.op).hom ((ψ.app (Opposite.op W)).hom r))
          ((F'.map b.op).hom ((η.app (Opposite.op W)).hom m)) =
        (F'.map b.op).hom ((η.app (Opposite.op W)).hom (r • m)) :=
    ⟨fun Y x t => (F'.map (bc Y x t).op).hom
        ((η.app (Opposite.op (Wc Y x t))).hom (rc Y x t • mc Y x t)),
      fun Y W b r m => WD Y _ W _ b _ r _ m (hx Y _ _).symm (ht Y _ _).symm⟩
  have h1 : ∀ (Y : D) (t : F'.obj (Opposite.op Y)), smul Y 1 t = t := by
    intro Y t
    obtain ⟨W, b, r, s, m, n, -, -, rfl, -⟩ := JR Y 1 1 t t
    have e1 := hF Y W b 1 m
    simp only [map_one, one_smul] at e1
    exact e1
  have h2 : ∀ (Y : D) (x y : R₀.obj (Opposite.op Y)) (t : F'.obj (Opposite.op Y)),
      smul Y (x * y) t = smul Y x (smul Y y t) := by
    intro Y x y t
    obtain ⟨W, b, r, s, m, n, rfl, rfl, rfl, -⟩ := JR Y x y t t
    have e1 := hF Y W b (r * s) m
    simp only [map_mul, mul_smul] at e1
    rw [e1, hF Y W b s m, hF Y W b r (s • m)]
  have h3 : ∀ (Y : D) (x : R₀.obj (Opposite.op Y)), smul Y x 0 = 0 := by
    intro Y x
    obtain ⟨W, b, r, s, m, n, rfl, -, -, -⟩ := JR Y x x 0 0
    have e1 := hF Y W b r 0
    have z1 : (η.app (Opposite.op W)).hom (0 : M.obj (Opposite.op W)) = 0 :=
      (η.app (Opposite.op W)).hom.map_zero
    rw [smul_zero, z1, map_zero] at e1
    exact e1
  have h4 : ∀ (Y : D) (x : R₀.obj (Opposite.op Y)) (t t' : F'.obj (Opposite.op Y)),
      smul Y x (t + t') = smul Y x t + smul Y x t' := by
    intro Y x t t'
    obtain ⟨W, b, r, s, m, n, rfl, -, rfl, rfl⟩ := JR Y x x t t'
    have e1 := hF Y W b r (m + n)
    have a1 : ∀ p q : M.obj (Opposite.op W),
        (η.app (Opposite.op W)).hom (p + q) =
          (η.app (Opposite.op W)).hom p + (η.app (Opposite.op W)).hom q :=
      fun p q => (η.app (Opposite.op W)).hom.map_add p q
    rw [smul_add, a1, a1, map_add, map_add] at e1
    rw [e1, hF Y W b r m, hF Y W b r n]
  have h5 : ∀ (Y : D) (x y : R₀.obj (Opposite.op Y)) (t : F'.obj (Opposite.op Y)),
      smul Y (x + y) t = smul Y x t + smul Y y t := by
    intro Y x y t
    obtain ⟨W, b, r, s, m, n, rfl, rfl, rfl, -⟩ := JR Y x y t t
    have e1 := hF Y W b (r + s) m
    have a1 : ∀ p q : M.obj (Opposite.op W),
        (η.app (Opposite.op W)).hom (p + q) =
          (η.app (Opposite.op W)).hom p + (η.app (Opposite.op W)).hom q :=
      fun p q => (η.app (Opposite.op W)).hom.map_add p q
    rw [add_smul, a1, map_add, map_add, map_add] at e1
    rw [e1, hF Y W b r m, hF Y W b s m]
  have h6 : ∀ (Y : D) (t : F'.obj (Opposite.op Y)), smul Y 0 t = 0 := by
    intro Y t
    obtain ⟨W, b, r, s, m, n, -, -, rfl, -⟩ := JR Y 0 0 t t
    have e1 := hF Y W b 0 m
    have z1 : (η.app (Opposite.op W)).hom (0 : M.obj (Opposite.op W)) = 0 :=
      (η.app (Opposite.op W)).hom.map_zero
    rw [zero_smul, z1, map_zero, map_zero, map_zero] at e1
    exact e1
  have hres : ∀ (Y Y' : D) (g : Y' ⟶ Y) (x : R₀.obj (Opposite.op Y)) (t : F'.obj (Opposite.op Y)),
      (F'.map g.op).hom (smul Y x t) = smul Y' ((R₀.map g.op).hom x) ((F'.map g.op).hom t) := by
    intro Y Y' g x t
    obtain ⟨W, b, r, s, m, n, rfl, -, rfl, -⟩ := JR Y x x t t
    rw [hF Y W b r m]
    have e1 := hF Y' W (g ≫ b) r m
    simp only [op_comp, Functor.map_comp, ConcreteCategory.comp_apply] at e1
    exact e1.symm
  letI inst : ∀ X : Dᵒᵖ, Module (R₀.obj X) (F'.obj X) := fun X =>
    { smul := smul X.unop
      one_smul := h1 X.unop
      mul_smul := h2 X.unop
      smul_zero := h3 X.unop
      smul_add := h4 X.unop
      add_smul := h5 X.unop
      zero_smul := h6 X.unop }
  have hmap : ∀ ⦃X X' : Dᵒᵖ⦄ (f : X ⟶ X') (x : R₀.obj X) (t : F'.obj X),
      (F'.map f).hom (x • t) = (R₀.map f).hom x • (F'.map f).hom t :=
    fun X X' f x t => hres X.unop X'.unop f.unop x t
  refine ⟨PresheafOfModules.ofPresheaf F' hmap, Iso.refl _, ?_⟩
  intro Y W b r m
  exact hF Y W b r m

theorem wc_lan_presheafOfModules_adjunction : ∀ {C D : Type (u+1)} [Category.{u} C] [Category.{u} D] (G : C ⥤ D)
    (S : Cᵒᵖ ⥤ RingCat.{u+1}) (R₀ : Dᵒᵖ ⥤ RingCat.{u+1}) (ψ : S ⟶ G.op ⋙ R₀)
    (N : PresheafOfModules.{u+1} S → PresheafOfModules.{u+1} R₀)
    (e : ∀ M : PresheafOfModules.{u+1} S, (N M).presheaf ≅ G.op.lan.obj M.presheaf),
    (∀ (M : PresheafOfModules.{u+1} S) (Y : D) (W : C) (b : Y ⟶ G.obj W) (r : S.obj (Opposite.op W))
        (m : M.obj (Opposite.op W)),
       ((R₀.map b.op).hom ((ψ.app (Opposite.op W)).hom r) •
         (((e M).inv.app (Opposite.op Y)).hom (((G.op.lan.obj M.presheaf).map b.op).hom
           (((G.op.lanUnit.app M.presheaf).app (Opposite.op W)).hom m)) : (N M).obj (Opposite.op Y))) =
       ((e M).inv.app (Opposite.op Y)).hom (((G.op.lan.obj M.presheaf).map b.op).hom
           (((G.op.lanUnit.app M.presheaf).app (Opposite.op W)).hom (r • m)))) →
    (∀ (M : PresheafOfModules.{u+1} S) (Y : D) (x : R₀.obj (Opposite.op Y))
        (t : (G.op.lan.obj M.presheaf).obj (Opposite.op Y)),
      ∃ (W : C) (b : Y ⟶ G.obj W) (r : S.obj (Opposite.op W)) (m : M.obj (Opposite.op W)),
        x = (R₀.map b.op).hom ((ψ.app (Opposite.op W)).hom r) ∧
        t = ((G.op.lan.obj M.presheaf).map b.op).hom (((G.op.lanUnit.app M.presheaf).app (Opposite.op W)).hom m)) →
    ∃ Λ : PresheafOfModules.{u+1} S ⥤ PresheafOfModules.{u+1} R₀,
      Nonempty (Λ ⊣ PresheafOfModules.pushforward.{u+1} ψ) ∧
      Nonempty (Λ ⋙ PresheafOfModules.toPresheaf R₀ ≅ PresheafOfModules.toPresheaf S ⋙ G.op.lan) :=
by
  intro C D _ _ G S R₀ ψ N e hF hJR

  have hU : ∀ (M : PresheafOfModules.{u+1} S) (Q : Dᵒᵖ ⥤ AddCommGrpCat.{u+1})
      (φ : G.op.lan.obj M.presheaf ⟶ Q) (X : Cᵒᵖ) (m : M.obj X),
      ((((G.op.lanAdjunction AddCommGrpCat.{u+1}).homEquiv M.presheaf Q φ).app X).hom m) =
        (φ.app (Opposite.op (G.obj X.unop))).hom (((G.op.lanUnit.app M.presheaf).app X).hom m) := by
    intro M Q φ X m
    rw [Adjunction.homEquiv_unit, Functor.lanAdjunction_unit]
    rfl

  have hF1 : ∀ (M : PresheafOfModules.{u+1} S) (V : C) (r : S.obj (Opposite.op V))
      (m : M.obj (Opposite.op V)),
      ((R₀.map (𝟙 (Opposite.op (G.obj V)))).hom ((ψ.app (Opposite.op V)).hom r) •
         (((e M).inv.app (Opposite.op (G.obj V))).hom
           (((G.op.lanUnit.app M.presheaf).app (Opposite.op V)).hom m)) : (N M).obj (Opposite.op (G.obj V))) =
       ((e M).inv.app (Opposite.op (G.obj V))).hom
           (((G.op.lanUnit.app M.presheaf).app (Opposite.op V)).hom (r • m)) := by
    intro M V r m
    have h1 := hF M (G.obj V) V (𝟙 _) r m
    rw [show (𝟙 (G.obj V)).op = 𝟙 (Opposite.op (G.obj V)) from rfl,
      (G.op.lan.obj M.presheaf).map_id] at h1
    simpa using h1

  have fwd : ∀ (M : PresheafOfModules.{u+1} S) (P : PresheafOfModules.{u+1} R₀) (f : N M ⟶ P),
      ∃ g : M ⟶ (PresheafOfModules.pushforward.{u+1} ψ).obj P,
        (PresheafOfModules.toPresheaf S).map g =
          (G.op.lanAdjunction AddCommGrpCat.{u+1}).homEquiv M.presheaf P.presheaf
            ((e M).inv ≫ (PresheafOfModules.toPresheaf R₀).map f) := by
    intro M P f
    refine ⟨PresheafOfModules.homMk (M₁ := M) (M₂ := (PresheafOfModules.pushforward.{u+1} ψ).obj P)
      ((G.op.lanAdjunction AddCommGrpCat.{u+1}).homEquiv M.presheaf P.presheaf
            ((e M).inv ≫ (PresheafOfModules.toPresheaf R₀).map f)) ?_, rfl⟩
    intro X r m
    obtain ⟨V⟩ := X
    have h1 := hF1 M V r m
    rw [R₀.map_id] at h1
    erw [hU, hU]
    exact (congrArg (f.app (Opposite.op (G.obj V))).hom h1.symm).trans
      ((f.app (Opposite.op (G.obj V))).hom.map_smul _ _)

  have bwd : ∀ (M : PresheafOfModules.{u+1} S) (P : PresheafOfModules.{u+1} R₀)
      (g : M ⟶ (PresheafOfModules.pushforward.{u+1} ψ).obj P),
      ∃ f : N M ⟶ P, (PresheafOfModules.toPresheaf R₀).map f =
        (e M).hom ≫ ((G.op.lanAdjunction AddCommGrpCat.{u+1}).homEquiv M.presheaf P.presheaf).symm
          ((PresheafOfModules.toPresheaf S).map g) := by
    intro M P g
    have hK : ∀ (W : C) (m : M.obj (Opposite.op W)),
        ((((G.op.lanAdjunction AddCommGrpCat.{u+1}).homEquiv M.presheaf P.presheaf).symm
          ((PresheafOfModules.toPresheaf S).map g)).app (Opposite.op (G.obj W))).hom
            (((G.op.lanUnit.app M.presheaf).app (Opposite.op W)).hom m)
          = (g.app (Opposite.op W)).hom m := by
      intro W m
      have h2 := hU M P.presheaf (((G.op.lanAdjunction AddCommGrpCat.{u+1}).homEquiv M.presheaf P.presheaf).symm
          ((PresheafOfModules.toPresheaf S).map g)) (Opposite.op W) m
      refine h2.symm.trans ?_
      erw [Equiv.apply_symm_apply]
      rfl
    refine ⟨PresheafOfModules.homMk (M₁ := N M) (M₂ := P)
      ((e M).hom ≫ ((G.op.lanAdjunction AddCommGrpCat.{u+1}).homEquiv M.presheaf P.presheaf).symm
          ((PresheafOfModules.toPresheaf S).map g)) ?_, rfl⟩
    intro X x z
    obtain ⟨Y⟩ := X
    obtain ⟨W, b, r, m, hx, hz⟩ := hJR M Y x (((e M).hom.app (Opposite.op Y)).hom z)
    have hih : ∀ w : (N M).obj (Opposite.op Y),
        ((e M).inv.app (Opposite.op Y)).hom (((e M).hom.app (Opposite.op Y)).hom w) = w := by
      intro w
      exact congrArg (fun k : (N M).presheaf ⟶ (N M).presheaf => (k.app (Opposite.op Y)).hom w)
        (e M).hom_inv_id
    have hhi : ∀ w : (G.op.lan.obj M.presheaf).obj (Opposite.op Y),
        ((e M).hom.app (Opposite.op Y)).hom (((e M).inv.app (Opposite.op Y)).hom w) = w := by
      intro w
      exact congrArg (fun k : G.op.lan.obj M.presheaf ⟶ G.op.lan.obj M.presheaf =>
        (k.app (Opposite.op Y)).hom w) (e M).inv_hom_id
    have hz' : z = ((e M).inv.app (Opposite.op Y)).hom (((G.op.lan.obj M.presheaf).map b.op).hom
           (((G.op.lanUnit.app M.presheaf).app (Opposite.op W)).hom m)) := by
      rw [← hz, hih]
    have hxz : x • z = ((e M).inv.app (Opposite.op Y)).hom (((G.op.lan.obj M.presheaf).map b.op).hom
           (((G.op.lanUnit.app M.presheaf).app (Opposite.op W)).hom (r • m))) := by
      rw [hx, hz']
      exact hF M Y W b r m
    have hξ : ∀ w : (G.op.lan.obj M.presheaf).obj (Opposite.op Y),
        (((e M).hom ≫ ((G.op.lanAdjunction AddCommGrpCat.{u+1}).homEquiv M.presheaf P.presheaf).symm
          ((PresheafOfModules.toPresheaf S).map g)).app (Opposite.op Y)).hom
            (((e M).inv.app (Opposite.op Y)).hom w) =
        ((((G.op.lanAdjunction AddCommGrpCat.{u+1}).homEquiv M.presheaf P.presheaf).symm
          ((PresheafOfModules.toPresheaf S).map g)).app (Opposite.op Y)).hom w := by
      intro w
      change ((((G.op.lanAdjunction AddCommGrpCat.{u+1}).homEquiv M.presheaf P.presheaf).symm
          ((PresheafOfModules.toPresheaf S).map g)).app (Opposite.op Y)).hom
            (((e M).hom.app (Opposite.op Y)).hom (((e M).inv.app (Opposite.op Y)).hom w)) = _
      rw [hhi]
    have hP : ∀ m' : M.obj (Opposite.op W),
        ((((G.op.lanAdjunction AddCommGrpCat.{u+1}).homEquiv M.presheaf P.presheaf).symm
          ((PresheafOfModules.toPresheaf S).map g)).app (Opposite.op Y)).hom
            (((G.op.lan.obj M.presheaf).map b.op).hom
              (((G.op.lanUnit.app M.presheaf).app (Opposite.op W)).hom m')) =
        (P.map b.op).hom ((g.app (Opposite.op W)).hom m') := by
      intro m'
      erw [NatTrans.naturality_apply]
      erw [hK]
      rfl
    have step1 : (ConcreteCategory.hom
        (((e M).hom ≫ ((G.op.lanAdjunction AddCommGrpCat.{u+1}).homEquiv M.presheaf P.presheaf).symm
          ((PresheafOfModules.toPresheaf S).map g)).app (Opposite.op Y))) (x • z) =
        (P.map b.op).hom ((g.app (Opposite.op W)).hom (r • m)) := by
      rw [hxz]
      exact (hξ _).trans (hP _)
    have step2 : (ConcreteCategory.hom
        (((e M).hom ≫ ((G.op.lanAdjunction AddCommGrpCat.{u+1}).homEquiv M.presheaf P.presheaf).symm
          ((PresheafOfModules.toPresheaf S).map g)).app (Opposite.op Y))) z =
        (P.map b.op).hom ((g.app (Opposite.op W)).hom m) := by
      rw [hz']
      exact (hξ _).trans (hP _)
    rw [step1, step2, (g.app (Opposite.op W)).hom.map_smul, hx]
    exact PresheafOfModules.map_smul P b.op ((ψ.app (Opposite.op W)).hom r) _

  choose F hFw using fwd
  choose B hBw using bwd
  let E : ∀ (M : PresheafOfModules.{u+1} S) (P : PresheafOfModules.{u+1} R₀),
      (N M ⟶ P) ≃ (M ⟶ (PresheafOfModules.pushforward.{u+1} ψ).obj P) := fun M P =>
    { toFun := F M P
      invFun := B M P
      left_inv := fun f => (PresheafOfModules.toPresheaf R₀).map_injective <|
        (hBw M P (F M P f)).trans <|
        (congrArg (fun x => (e M).hom ≫
          ((G.op.lanAdjunction AddCommGrpCat.{u+1}).homEquiv M.presheaf P.presheaf).symm x)
          (hFw M P f)).trans <|
        (congrArg (fun y => (e M).hom ≫ y)
          (((G.op.lanAdjunction AddCommGrpCat.{u+1}).homEquiv M.presheaf P.presheaf).symm_apply_apply
            ((e M).inv ≫ (PresheafOfModules.toPresheaf R₀).map f))).trans
        ((e M).hom_inv_id_assoc _)
      right_inv := fun g => (PresheafOfModules.toPresheaf S).map_injective <|
        (hFw M P (B M P g)).trans <|
        (congrArg (fun x => (G.op.lanAdjunction AddCommGrpCat.{u+1}).homEquiv M.presheaf P.presheaf
          ((e M).inv ≫ x)) (hBw M P g)).trans <|
        (congrArg (fun y => (G.op.lanAdjunction AddCommGrpCat.{u+1}).homEquiv M.presheaf P.presheaf y)
          ((e M).inv_hom_id_assoc _)).trans
        (((G.op.lanAdjunction AddCommGrpCat.{u+1}).homEquiv M.presheaf P.presheaf).apply_symm_apply _) }
  have hE : ∀ (M : PresheafOfModules.{u+1} S) (P : PresheafOfModules.{u+1} R₀) (f : N M ⟶ P),
      (PresheafOfModules.toPresheaf S).map (E M P f) =
        (G.op.lanAdjunction AddCommGrpCat.{u+1}).homEquiv M.presheaf P.presheaf
          ((e M).inv ≫ (PresheafOfModules.toPresheaf R₀).map f) := fun M P f => hFw M P f

  have he : ∀ (M : PresheafOfModules.{u+1} S) (P P' : PresheafOfModules.{u+1} R₀) (k : P ⟶ P')
      (f : N M ⟶ P), E M P' (f ≫ k) = E M P f ≫ (PresheafOfModules.pushforward.{u+1} ψ).map k := by
    intro M P P' k f
    apply (PresheafOfModules.toPresheaf S).map_injective
    refine (hE M P' (f ≫ k)).trans ?_
    refine Eq.trans ?_ ((PresheafOfModules.toPresheaf S).map_comp _ _).symm
    refine Eq.trans ?_ (congrArg (fun x => x ≫ (PresheafOfModules.toPresheaf S).map
      ((PresheafOfModules.pushforward.{u+1} ψ).map k)) (hE M P f)).symm
    refine (congrArg (fun x => (G.op.lanAdjunction AddCommGrpCat.{u+1}).homEquiv M.presheaf P'.presheaf
      ((e M).inv ≫ x)) ((PresheafOfModules.toPresheaf R₀).map_comp f k)).trans ?_
    refine (congrArg (fun x => (G.op.lanAdjunction AddCommGrpCat.{u+1}).homEquiv M.presheaf P'.presheaf x)
      (Category.assoc _ _ _).symm).trans ?_
    exact Adjunction.homEquiv_naturality_right _ _ _
  let Λ : PresheafOfModules.{u+1} S ⥤ PresheafOfModules.{u+1} R₀ :=
    Adjunction.leftAdjointOfEquiv E he
  refine ⟨Λ, ⟨Adjunction.adjunctionOfEquivLeft E he⟩, ⟨NatIso.ofComponents (fun M => e M) ?_⟩⟩
  intro M M' k
  have i : E M (N M') (Λ.map k) = k ≫ E M' (N M') (𝟙 _) := by
    simp only [Λ]
    rw [Adjunction.leftAdjointOfEquiv_map, Equiv.apply_symm_apply]
  have i' : (G.op.lanAdjunction AddCommGrpCat.{u+1}).homEquiv M.presheaf (N M').presheaf
        ((e M).inv ≫ (PresheafOfModules.toPresheaf R₀).map (Λ.map k)) =
      (PresheafOfModules.toPresheaf S).map k ≫
        (G.op.lanAdjunction AddCommGrpCat.{u+1}).homEquiv M'.presheaf (N M').presheaf (e M').inv := by
    refine (hE M (N M') (Λ.map k)).symm.trans ?_
    refine (congrArg (PresheafOfModules.toPresheaf S).map i).trans ?_
    refine ((PresheafOfModules.toPresheaf S).map_comp _ _).trans ?_
    refine congrArg (fun x => (PresheafOfModules.toPresheaf S).map k ≫ x) ?_
    refine (hE M' (N M') (𝟙 _)).trans ?_
    refine congrArg (fun x => (G.op.lanAdjunction AddCommGrpCat.{u+1}).homEquiv M'.presheaf
      (N M').presheaf ((e M').inv ≫ x)) ((PresheafOfModules.toPresheaf R₀).map_id _) |>.trans ?_
    exact congrArg (fun x => (G.op.lanAdjunction AddCommGrpCat.{u+1}).homEquiv M'.presheaf
      (N M').presheaf x) (Category.comp_id _)
  have hnl := (G.op.lanAdjunction AddCommGrpCat.{u+1}).homEquiv_naturality_left
    ((PresheafOfModules.toPresheaf S).map k) (𝟙 (G.op.lan.obj M'.presheaf))
  have hnr := (G.op.lanAdjunction AddCommGrpCat.{u+1}).homEquiv_naturality_right
    ((e M).inv ≫ (PresheafOfModules.toPresheaf R₀).map (Λ.map k)) (e M').hom
  have hnr' := (G.op.lanAdjunction AddCommGrpCat.{u+1}).homEquiv_naturality_right
    (e M').inv (e M').hom
  have key : (e M).inv ≫ (PresheafOfModules.toPresheaf R₀).map (Λ.map k) ≫ (e M').hom =
      G.op.lan.map ((PresheafOfModules.toPresheaf S).map k) := by
    apply ((G.op.lanAdjunction AddCommGrpCat.{u+1}).homEquiv M.presheaf
      (G.op.lan.obj M'.presheaf)).injective
    refine (congrArg (fun x => (G.op.lanAdjunction AddCommGrpCat.{u+1}).homEquiv M.presheaf
      (G.op.lan.obj M'.presheaf) x) (Category.assoc _ _ _).symm).trans ?_
    refine hnr.trans ?_
    refine (congrArg (fun x => x ≫ ((Functor.whiskeringLeft Cᵒᵖ Dᵒᵖ AddCommGrpCat.{u+1}).obj G.op).map
      (e M').hom) i').trans ?_
    refine (Category.assoc _ _ _).trans ?_
    refine (congrArg (fun x => (PresheafOfModules.toPresheaf S).map k ≫ x) hnr'.symm).trans ?_
    refine (congrArg (fun x => (PresheafOfModules.toPresheaf S).map k ≫
      (G.op.lanAdjunction AddCommGrpCat.{u+1}).homEquiv M'.presheaf (G.op.lan.obj M'.presheaf) x)
      (e M').inv_hom_id).trans ?_
    refine hnl.symm.trans ?_
    exact congrArg (fun x => (G.op.lanAdjunction AddCommGrpCat.{u+1}).homEquiv M.presheaf
      (G.op.lan.obj M'.presheaf) x) (Category.comp_id _)
  exact ((e M).hom_inv_id_assoc _).symm.trans (congrArg (fun x => (e M).hom ≫ x) key)

theorem wc_lan_ring_comparison_locally_bijective : ∀ {C D : Type (u+1)} [Category.{u} C] [Category.{u} D] (J : GrothendieckTopology C)
    (K : GrothendieckTopology D) (G : C ⥤ D) [G.IsContinuous J K] [RepresentablyFlat G]
    (R : Sheaf J RingCat.{u+1}) (R' : Sheaf K RingCat.{u+1})
    (φ : R ⟶ (G.sheafPushforwardContinuous RingCat.{u+1} J K).obj R')
    (R₀ : Dᵒᵖ ⥤ RingCat.{u+1}) (ψ : R.obj ⟶ G.op ⋙ R₀) (α : R₀ ⟶ R'.obj),
    ψ ≫ Functor.whiskerLeft G.op α = φ.hom →
    (∀ (Y : D) (x : R₀.obj (Opposite.op Y)), ∃ (V : C) (a : Y ⟶ G.obj V) (r : R.obj.obj (Opposite.op V)),
      x = (R₀.map a.op).hom ((ψ.app (Opposite.op V)).hom r)) →
    (∀ (V' : D) (r' : R'.obj.obj (Opposite.op V')), ∃ T ∈ K V', ∀ ⦃W' : D⦄ (g : W' ⟶ V'),
      T.arrows g → ∃ (V : C) (a : W' ⟶ G.obj V) (r : R.obj.obj (Opposite.op V)),
        (R'.obj.map g.op).hom r' = (R'.obj.map a.op).hom ((φ.hom.app (Opposite.op V)).hom r)) →
    (∀ (V' : D) (V : C) (a : V' ⟶ G.obj V) (r : R.obj.obj (Opposite.op V)),
      (R'.obj.map a.op).hom ((φ.hom.app (Opposite.op V)).hom r) = 0 →
      ∃ T ∈ K V', ∀ ⦃W' : D⦄ (g : W' ⟶ V'), T.arrows g →
        ∃ (W : C) (b : W ⟶ V) (a' : W' ⟶ G.obj W),
          a' ≫ G.map b = g ≫ a ∧ (R.obj.map b.op).hom r = 0) →
    Presheaf.IsLocallySurjective K α ∧ Presheaf.IsLocallyInjective K α :=
by
  intro C D _ _ J K G _ _ R R' φ R₀ ψ α hfac hRep hH1 hH2
  have hstar : ∀ (W' : D) (V : C) (a : W' ⟶ G.obj V) (r : R.obj.obj (Opposite.op V)),
      (R'.obj.map a.op).hom ((φ.hom.app (Opposite.op V)).hom r) =
        (α.app (Opposite.op W')).hom ((R₀.map a.op).hom ((ψ.app (Opposite.op V)).hom r)) := by
    intro W' V a r
    have h1 : (φ.hom.app (Opposite.op V)).hom r =
        (α.app (Opposite.op (G.obj V))).hom ((ψ.app (Opposite.op V)).hom r) := by
      rw [← hfac]; rfl
    rw [h1]
    exact (NatTrans.naturality_apply α a.op _).symm
  refine ⟨Presheaf.IsLocallySurjective.mk (fun {U} s => ?_),
    Presheaf.IsLocallyInjective.mk (fun {X} x y hxy => ?_)⟩
  · obtain ⟨T, hT, hTp⟩ := hH1 U s
    refine K.superset_covering ?_ hT
    intro W' g hg
    rw [Presheaf.imageSieve_apply]
    obtain ⟨V, a, r, h⟩ := hTp g hg
    exact ⟨(R₀.map a.op).hom ((ψ.app (Opposite.op V)).hom r), (hstar W' V a r).symm.trans h.symm⟩
  · obtain ⟨Y⟩ := X
    have hz0 : (α.app (Opposite.op Y)).hom (x - y) = 0 := by
      rw [map_sub, sub_eq_zero]; exact hxy
    obtain ⟨V, a, r, hz⟩ := hRep Y (x - y)
    have hker : (R'.obj.map a.op).hom ((φ.hom.app (Opposite.op V)).hom r) = 0 := by
      rw [hstar, ← hz, hz0]
    obtain ⟨T, hT, hTp⟩ := hH2 Y V a r hker
    refine K.superset_covering ?_ hT
    intro W' g hg
    rw [Presheaf.equalizerSieve_apply]
    obtain ⟨W, b, a', hcomm, hb⟩ := hTp g hg
    have key : (R₀.map g.op).hom (x - y) = 0 := by
      rw [hz]
      have e1 : (R₀.map g.op).hom ((R₀.map a.op).hom ((ψ.app (Opposite.op V)).hom r)) =
          (R₀.map (g ≫ a).op).hom ((ψ.app (Opposite.op V)).hom r) := by
        rw [op_comp, Functor.map_comp]; rfl
      have e3 : (R₀.map (a' ≫ G.map b).op).hom ((ψ.app (Opposite.op V)).hom r) =
          (R₀.map a'.op).hom ((R₀.map (G.map b).op).hom ((ψ.app (Opposite.op V)).hom r)) := by
        rw [op_comp, Functor.map_comp]; rfl
      have e2 : (R₀.map (G.map b).op).hom ((ψ.app (Opposite.op V)).hom r) =
          (ψ.app (Opposite.op W)).hom ((R.obj.map b.op).hom r) :=
        (NatTrans.naturality_apply ψ b.op r).symm
      rw [e1, ← hcomm, e3, e2, hb, map_zero, map_zero]
    rw [← sub_eq_zero, ← map_sub]
    exact key

theorem wc_presheafOfModules_pushforward_restrictScalars_iso : ∀ {C D : Type (u+1)} [Category.{u} C] [Category.{u} D] (G : C ⥤ D)
    {S : Cᵒᵖ ⥤ RingCat.{u+1}} {R₀ R₁ : Dᵒᵖ ⥤ RingCat.{u+1}}
    (ψ : S ⟶ G.op ⋙ R₀) (α : R₀ ⟶ R₁) (φ₀ : S ⟶ G.op ⋙ R₁),
    ψ ≫ Functor.whiskerLeft G.op α = φ₀ →
    Nonempty (PresheafOfModules.pushforward.{u+1} φ₀ ≅
      PresheafOfModules.restrictScalars.{u+1} α ⋙ PresheafOfModules.pushforward.{u+1} ψ) :=
by
  intro C D _ _ G S R₀ R₁ ψ α φ₀ hfac
  subst hfac
  exact ⟨Iso.refl _⟩

theorem wc_sheafOfModules_pullback_toSheaf_iso : ∀ {C D : Type (u+1)} [Category.{u} C]
    [Category.{u} D] (J : GrothendieckTopology C) (K : GrothendieckTopology D) (G : C ⥤ D)
    [G.IsContinuous J K] [RepresentablyFlat G] [HasSheafify J AddCommGrpCat.{u+1}]
    [HasSheafify K AddCommGrpCat.{u+1}] [J.WEqualsLocallyBijective AddCommGrpCat.{u+1}]
    [K.WEqualsLocallyBijective AddCommGrpCat.{u+1}] (R : Sheaf J RingCat.{u+1})
    (R' : Sheaf K RingCat.{u+1}) (φ : R ⟶ (G.sheafPushforwardContinuous RingCat.{u+1} J K).obj R'),
    (∀ (V' : D) (r' : R'.obj.obj (Opposite.op V')), ∃ T ∈ K V', ∀ ⦃W' : D⦄ (g : W' ⟶ V'),
      T.arrows g → ∃ (V : C) (a : W' ⟶ G.obj V) (r : R.obj.obj (Opposite.op V)),
        (R'.obj.map g.op).hom r' = (R'.obj.map a.op).hom ((φ.hom.app (Opposite.op V)).hom r)) →
    (∀ (V' : D) (V : C) (a : V' ⟶ G.obj V) (r : R.obj.obj (Opposite.op V)),
      (R'.obj.map a.op).hom ((φ.hom.app (Opposite.op V)).hom r) = 0 →
      ∃ T ∈ K V', ∀ ⦃W' : D⦄ (g : W' ⟶ V'), T.arrows g →
        ∃ (W : C) (b : W ⟶ V) (a' : W' ⟶ G.obj W),
          a' ≫ G.map b = g ≫ a ∧ (R.obj.map b.op).hom r = 0) →
    ∀ (Φ : SheafOfModules.{u+1} R ⥤ SheafOfModules.{u+1} R')
      (_ : Φ ⊣ SheafOfModules.pushforward.{u+1} φ),
      Nonempty (Φ ⋙ SheafOfModules.toSheaf.{u+1} R' ≅
        SheafOfModules.toSheaf.{u+1} R ⋙ G.sheafPullback AddCommGrpCat.{u+1} J K) :=
by
  intro C D _ _ J K G _ _ _ _ _ _ R R' φ hsurj hinj Φ adj
  classical
  letI : Limits.HasColimitsOfSize.{u, u+1} RingCat.{u+1} :=
    Limits.hasColimitsOfSizeShrink.{u, u+1, u+1, u+1} RingCat.{u+1}

  let R₀ : Dᵒᵖ ⥤ RingCat.{u+1} := G.op.leftKanExtension R.obj
  let ψ : R.obj ⟶ G.op ⋙ R₀ := G.op.leftKanExtensionUnit R.obj
  let hψ : (Functor.LeftExtension.mk R₀ ψ).IsPointwiseLeftKanExtension :=
    G.op.isPointwiseLeftKanExtensionLeftKanExtensionUnit R.obj
  haveI : R₀.IsLeftKanExtension ψ := hψ.isLeftKanExtension
  let α : R₀ ⟶ R'.obj := R₀.descOfIsLeftKanExtension ψ R'.obj φ.hom
  have hfac : ψ ≫ Functor.whiskerLeft G.op α = φ.hom :=
    R₀.descOfIsLeftKanExtension_fac ψ R'.obj φ.hom

  obtain ⟨RS, RI⟩ := wc_lan_ring_rep G R.obj R₀ ψ hψ
  have hAB := fun M : PresheafOfModules.{u+1} R.obj =>
    wc_lan_ab_rep G M.presheaf (G.op.lan.obj M.presheaf) (G.op.lanUnit.app M.presheaf)
      (G.op.isPointwiseLeftKanExtensionLeftKanExtensionUnit M.presheaf)
  have JR := fun M : PresheafOfModules.{u+1} R.obj =>
    wc_lan_joint_rep G R.obj R₀ ψ M.presheaf (G.op.lan.obj M.presheaf)
      (G.op.lanUnit.app M.presheaf) RS (hAB M).1
  have WD := fun M : PresheafOfModules.{u+1} R.obj =>
    wc_lan_smul_well_defined G R.obj R₀ ψ M (G.op.lan.obj M.presheaf)
      (G.op.lanUnit.app M.presheaf) RI (hAB M).2
  choose N e hF using fun M : PresheafOfModules.{u+1} R.obj =>
    wc_lan_presheafOfModules_mk G R.obj R₀ ψ M (G.op.lan.obj M.presheaf)
      (G.op.lanUnit.app M.presheaf) (WD M) (JR M)

  obtain ⟨Λ, ⟨adjΛ⟩, ⟨ι₁⟩⟩ := wc_lan_presheafOfModules_adjunction G R.obj R₀ ψ N e hF
    (fun M Y x t => by
      obtain ⟨W, b, r, _, m, _, hx, _, ht, _⟩ := JR M Y x x t t
      exact ⟨W, b, r, m, hx, ht⟩)

  obtain ⟨hLS, hLI⟩ :=
    wc_lan_ring_comparison_locally_bijective J K G R R' φ R₀ ψ α hfac RS hsurj hinj
  haveI := hLS
  haveI := hLI

  obtain ⟨ι₂⟩ := wc_presheafOfModules_pushforward_restrictScalars_iso G ψ α φ.hom hfac
  let eD : SheafOfModules.pushforward.{u+1} φ ⋙ SheafOfModules.forget R ≅
      SheafOfModules.forget R' ⋙ PresheafOfModules.restrictScalars α ⋙
        PresheafOfModules.pushforward.{u+1} ψ :=
    (Iso.refl _ : SheafOfModules.pushforward.{u+1} φ ⋙ SheafOfModules.forget R ≅
      SheafOfModules.forget R' ⋙ PresheafOfModules.pushforward.{u+1} φ.hom) ≪≫
      Functor.isoWhiskerLeft (SheafOfModules.forget R') ι₂

  let adjS := (adjΛ.comp (PresheafOfModules.sheafificationAdjunction α)).restrictFullyFaithful
    (SheafOfModules.fullyFaithfulForget R) (Functor.FullyFaithful.id _)
    (L := SheafOfModules.forget R ⋙ Λ ⋙ PresheafOfModules.sheafification α)
    (R := SheafOfModules.pushforward.{u+1} φ) (Iso.refl _) eD.symm

  let i1 : Φ ≅ SheafOfModules.forget R ⋙ Λ ⋙ PresheafOfModules.sheafification α :=
    adj.leftAdjointUniq adjS
  let i2 := PresheafOfModules.sheafificationCompToSheaf α
  let i3 : Functor.sheafPullbackConstruction.sheafPullback G AddCommGrpCat.{u+1} J K ≅
      G.sheafPullback AddCommGrpCat.{u+1} J K :=
    (Functor.sheafPullbackConstruction.sheafAdjunctionContinuous G AddCommGrpCat.{u+1} J K).leftAdjointUniq
      (G.sheafAdjunctionContinuous AddCommGrpCat.{u+1} J K)
  refine ⟨Functor.isoWhiskerRight i1 (SheafOfModules.toSheaf.{u+1} R') ≪≫ ?_⟩
  refine (Iso.refl _ : (SheafOfModules.forget R ⋙ Λ ⋙ PresheafOfModules.sheafification α) ⋙
      SheafOfModules.toSheaf.{u+1} R' ≅ (SheafOfModules.forget R ⋙ Λ) ⋙
        (PresheafOfModules.sheafification α ⋙ SheafOfModules.toSheaf.{u+1} R')) ≪≫
    Functor.isoWhiskerLeft (SheafOfModules.forget R ⋙ Λ) i2 ≪≫ ?_
  refine (Iso.refl _ : (SheafOfModules.forget R ⋙ Λ) ⋙
      (PresheafOfModules.toPresheaf R₀ ⋙ presheafToSheaf K AddCommGrpCat.{u+1}) ≅
      (SheafOfModules.forget R ⋙ (Λ ⋙ PresheafOfModules.toPresheaf R₀)) ⋙
        presheafToSheaf K AddCommGrpCat.{u+1}) ≪≫
    Functor.isoWhiskerRight (Functor.isoWhiskerLeft (SheafOfModules.forget R) ι₁)
      (presheafToSheaf K AddCommGrpCat.{u+1}) ≪≫ ?_
  refine (Iso.refl _ : (SheafOfModules.forget R ⋙ (PresheafOfModules.toPresheaf R.obj ⋙
      (G.op.lan : (Cᵒᵖ ⥤ AddCommGrpCat.{u+1}) ⥤ (Dᵒᵖ ⥤ AddCommGrpCat.{u+1})))) ⋙
      presheafToSheaf K AddCommGrpCat.{u+1} ≅
      SheafOfModules.toSheaf.{u+1} R ⋙
        Functor.sheafPullbackConstruction.sheafPullback G AddCommGrpCat.{u+1} J K) ≪≫ ?_
  exact Functor.isoWhiskerLeft (SheafOfModules.toSheaf.{u+1} R) i3

theorem wc_lc_spec_weaklyEtale : ∀ (K : Type) [TopologicalSpace K] [CompactSpace K],
    WeaklyEtale (Spec.map (CommRingCat.ofHom
      (algebraMap (ULift.{u} ℤ) (LocallyConstant K (ULift.{u} ℤ))))) :=
by
  intro K _ _
  classical

  have hsep : ∀ φ : LocallyConstant K (ULift.{u} ℤ),
      ∃ c : TensorProduct (ULift.{u} ℤ) (LocallyConstant K (ULift.{u} ℤ))
        (LocallyConstant K (ULift.{u} ℤ)),
      Algebra.TensorProduct.lmul' (ULift.{u} ℤ) c = 1 ∧
        c * (TensorProduct.tmul (ULift.{u} ℤ) (1 : LocallyConstant K (ULift.{u} ℤ)) φ -
          TensorProduct.tmul (ULift.{u} ℤ) φ 1) = 0 := by
    intro φ
    let s : Finset (ULift.{u} ℤ) := (LocallyConstant.range_finite φ).toFinset
    let ε : ULift.{u} ℤ → LocallyConstant K (ULift.{u} ℤ) :=
      fun v => φ.map (fun w => if w = v then (1 : ULift.{u} ℤ) else 0)
    have hε : ∀ v y, ε v y = if φ y = v then 1 else 0 := fun v y => rfl
    have F1 : ∀ v, ε v * ε v = ε v := by
      intro v
      ext y
      rw [LocallyConstant.mul_apply, hε]
      split_ifs <;> simp
    have F2 : ∀ v, ε v * φ = v • ε v := by
      intro v
      ext y
      rw [LocallyConstant.mul_apply, LocallyConstant.smul_apply, hε]
      split_ifs with h
      · rw [h, one_mul, smul_eq_mul, mul_one]
      · rw [zero_mul, smul_eq_mul, mul_zero]
    have F3 : ∑ v ∈ s, ε v = 1 := by
      ext y
      have := map_sum (LocallyConstant.evalRingHom y :
        LocallyConstant K (ULift.{u} ℤ) →+* ULift.{u} ℤ) ε s
      simp only [LocallyConstant.evalRingHom_apply] at this
      rw [this]
      simp [hε, s, Finset.sum_ite_eq]
    refine ⟨∑ v ∈ s, TensorProduct.tmul (ULift.{u} ℤ) (ε v) (ε v), ?_, ?_⟩
    · rw [map_sum]
      simp only [Algebra.TensorProduct.lmul'_apply_tmul, F1]
      exact F3
    · rw [Finset.sum_mul]
      apply Finset.sum_eq_zero
      intro v _
      rw [mul_sub, Algebra.TensorProduct.tmul_mul_tmul, Algebra.TensorProduct.tmul_mul_tmul,
        mul_one, F2, TensorProduct.smul_tmul, sub_self]

  have heq : algebraMap (ULift.{u} ℤ) (LocallyConstant K (ULift.{u} ℤ)) =
      (algebraMap ℤ (LocallyConstant K (ULift.{u} ℤ))).comp
        (ULift.ringEquiv : ULift.{u} ℤ ≃+* ℤ).toRingHom := by
    refine RingHom.ext fun x => LocallyConstant.ext fun y => ?_
    apply ULift.ext
    have e1 : (algebraMap (ULift.{u} ℤ) (LocallyConstant K (ULift.{u} ℤ)) x) y = x := rfl
    have e2 : ((algebraMap ℤ (LocallyConstant K (ULift.{u} ℤ))).comp
        (ULift.ringEquiv : ULift.{u} ℤ ≃+* ℤ).toRingHom x) y = ((x.down : ℤ) : ULift.{u} ℤ) := by
      rw [RingHom.comp_apply, eq_intCast]
      exact map_intCast (LocallyConstant.evalRingHom y :
        LocallyConstant K (ULift.{u} ℤ) →+* ULift.{u} ℤ) _
    rw [e1, e2, ULift.down_intCast, Int.cast_id]
  have hfring : (algebraMap (ULift.{u} ℤ) (LocallyConstant K (ULift.{u} ℤ))).Flat := by
    rw [heq]
    refine RingHom.Flat.comp ?_ ?_
    · exact RingHom.Flat.of_bijective (ULift.ringEquiv : ULift.{u} ℤ ≃+* ℤ).bijective
    · refine RingHom.flat_algebraMap_iff.mpr ?_
      rw [IsDedekindDomain.flat_iff_torsion_eq_bot, Submodule.eq_bot_iff]
      intro x hx
      obtain ⟨a, ha⟩ := (Submodule.mem_torsion_iff x).mp hx
      have hn : (a : ℤ) ≠ 0 := nonZeroDivisors.coe_ne_zero a
      rw [Submonoid.smul_def, Algebra.smul_def] at ha
      ext y
      have h1 := congrArg (LocallyConstant.evalRingHom y :
        LocallyConstant K (ULift.{u} ℤ) →+* ULift.{u} ℤ) ha
      rw [map_mul, map_zero, eq_intCast, map_intCast, LocallyConstant.evalRingHom_apply] at h1
      have h2 := congrArg ULift.down h1
      rw [ULift.mul_down, ULift.down_intCast, ULift.zero_down, Int.cast_id] at h2
      show (x y).down = (0 : ULift.{u} ℤ).down
      rw [ULift.zero_down]
      exact (mul_eq_zero.mp h2).resolve_left hn

  have hflatμ : RingHom.Flat
      (Algebra.TensorProduct.lmul' (ULift.{u} ℤ) :
        TensorProduct (ULift.{u} ℤ) (LocallyConstant K (ULift.{u} ℤ))
          (LocallyConstant K (ULift.{u} ℤ)) →ₐ[ULift.{u} ℤ]
            LocallyConstant K (ULift.{u} ℤ)).toRingHom := by
    let μ := (Algebra.TensorProduct.lmul' (ULift.{u} ℤ) :
        TensorProduct (ULift.{u} ℤ) (LocallyConstant K (ULift.{u} ℤ))
          (LocallyConstant K (ULift.{u} ℤ)) →ₐ[ULift.{u} ℤ] LocallyConstant K (ULift.{u} ℤ))
    letI : Algebra (TensorProduct (ULift.{u} ℤ) (LocallyConstant K (ULift.{u} ℤ))
        (LocallyConstant K (ULift.{u} ℤ))) (LocallyConstant K (ULift.{u} ℤ)) :=
      μ.toRingHom.toAlgebra
    let M : Submonoid (TensorProduct (ULift.{u} ℤ) (LocallyConstant K (ULift.{u} ℤ))
        (LocallyConstant K (ULift.{u} ℤ))) :=
      Submonoid.comap μ.toRingHom (IsUnit.submonoid (LocallyConstant K (ULift.{u} ℤ)))
    have hM : ∀ y, y ∈ M ↔ IsUnit (μ y) := fun y => by
      rw [Submonoid.mem_comap, IsUnit.mem_submonoid_iff]; rfl
    haveI : IsLocalization M (LocallyConstant K (ULift.{u} ℤ)) := by
      refine ⟨?_, ?_, ?_⟩
      · intro y
        exact (hM y.1).mp y.2
      · intro z
        refine ⟨⟨TensorProduct.tmul (ULift.{u} ℤ) z 1, 1⟩, ?_⟩
        show z * μ 1 = μ (TensorProduct.tmul (ULift.{u} ℤ) z 1)
        rw [map_one, Algebra.TensorProduct.lmul'_apply_tmul, mul_one]
      · intro x y hxy
        change μ x = μ y at hxy
        have hker : x - y ∈ Ideal.span (Set.range fun s : LocallyConstant K (ULift.{u} ℤ) =>
            TensorProduct.tmul (ULift.{u} ℤ) (1 : LocallyConstant K (ULift.{u} ℤ)) s -
              TensorProduct.tmul (ULift.{u} ℤ) s 1) := by
          rw [KaehlerDifferential.span_range_eq_ideal, KaehlerDifferential.ideal, RingHom.mem_ker,
            map_sub]
          exact sub_eq_zero.mpr hxy
        have key : ∀ a ∈ Ideal.span (Set.range fun s : LocallyConstant K (ULift.{u} ℤ) =>
            TensorProduct.tmul (ULift.{u} ℤ) (1 : LocallyConstant K (ULift.{u} ℤ)) s -
              TensorProduct.tmul (ULift.{u} ℤ) s 1),
            ∃ c ∈ M, c * a = 0 := by
          intro a ha
          induction ha using Submodule.span_induction with
          | mem a ha =>
            obtain ⟨s, rfl⟩ := ha
            obtain ⟨c, hc1, hc2⟩ := hsep s
            refine ⟨c, (hM c).mpr ?_, hc2⟩
            show IsUnit (Algebra.TensorProduct.lmul' (ULift.{u} ℤ) c)
            rw [hc1]; exact isUnit_one
          | zero => exact ⟨1, M.one_mem, mul_zero 1⟩
          | add a b _ _ ha hb =>
            obtain ⟨c1, h1, e1⟩ := ha
            obtain ⟨c2, h2, e2⟩ := hb
            exact ⟨c1 * c2, M.mul_mem h1 h2, by linear_combination c2 * e1 + c1 * e2⟩
          | smul r a _ ha =>
            obtain ⟨c, h, e⟩ := ha
            exact ⟨c, h, by rw [smul_eq_mul, mul_left_comm, e, mul_zero]⟩
        obtain ⟨c, hc, e⟩ := key _ hker
        exact ⟨⟨c, hc⟩, by rw [mul_sub] at e; exact sub_eq_zero.mp e⟩
    exact IsLocalization.flat (LocallyConstant K (ULift.{u} ℤ)) M
  have hf : Flat (Spec.map (CommRingCat.ofHom
      (algebraMap (ULift.{u} ℤ) (LocallyConstant K (ULift.{u} ℤ))))) := by
    rw [HasRingHomProperty.Spec_iff (P := @Flat)]
    exact hfring
  have hd : Flat (Limits.pullback.diagonal (Spec.map (CommRingCat.ofHom
      (algebraMap (ULift.{u} ℤ) (LocallyConstant K (ULift.{u} ℤ)))))) := by
    rw [diagonal_SpecMap]
    haveI : Flat (Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.lmul' (ULift.{u} ℤ) :
        TensorProduct (ULift.{u} ℤ) (LocallyConstant K (ULift.{u} ℤ))
          (LocallyConstant K (ULift.{u} ℤ)) →ₐ[ULift.{u} ℤ]
            LocallyConstant K (ULift.{u} ℤ)).toRingHom)) :=
      HasRingHomProperty.Spec_iff.mpr hflatμ
    infer_instance
  exact ⟨hf, hd⟩

theorem wc_lc_spec_pi0 : ∀ (K : Type) [TopologicalSpace K] [CompactSpace K] [T2Space K]
    [TotallyDisconnectedSpace K],
    ∃ π0 : C(PrimeSpectrum (LocallyConstant K (ULift.{u} ℤ)), K),
      ∀ (U : Set K) (hU : IsClopen U) (q : PrimeSpectrum (LocallyConstant K (ULift.{u} ℤ))),
        π0 q ∈ U ↔ q ∈ PrimeSpectrum.basicOpen (LocallyConstant.charFn (ULift.{u} ℤ) hU) :=
by
  intro K _ _ _ _
  classical
  have I1 : LocallyConstant.charFn (ULift.{u} ℤ) (isClopen_univ (X := K)) = 1 := by
    ext y
    simp [LocallyConstant.coe_charFn]
  have I2 : LocallyConstant.charFn (ULift.{u} ℤ) (isClopen_empty (X := K)) = 0 := by
    ext y
    simp [LocallyConstant.coe_charFn]
  have I3 : ∀ (U V : Set K) (hU : IsClopen U) (hV : IsClopen V),
      LocallyConstant.charFn (ULift.{u} ℤ) (hU.inter hV) =
        LocallyConstant.charFn (ULift.{u} ℤ) hU * LocallyConstant.charFn (ULift.{u} ℤ) hV := by
    intro U V hU hV
    ext y
    simp only [LocallyConstant.coe_charFn, LocallyConstant.coe_mul, Pi.mul_apply,
      Set.indicator_apply, Pi.one_apply, Set.mem_inter_iff]
    split_ifs <;> simp_all
  have I5 : ∀ (U : Set K) (hU : IsClopen U),
      LocallyConstant.charFn (ULift.{u} ℤ) hU + LocallyConstant.charFn (ULift.{u} ℤ) hU.compl = 1 := by
    intro U hU
    ext y
    simp only [LocallyConstant.coe_charFn, LocallyConstant.coe_add, LocallyConstant.coe_one,
      Pi.add_apply, Pi.one_apply, Set.indicator_apply, Set.mem_compl_iff]
    split_ifs <;> simp_all
  have key : ∀ q : PrimeSpectrum (LocallyConstant K (ULift.{u} ℤ)), ∃ x : K,
      ∀ (U : Set K) (hU : IsClopen U),
        x ∈ U ↔ LocallyConstant.charFn (ULift.{u} ℤ) hU ∉ q.asIdeal := by
    intro q
    have hP := q.isPrime
    have h1 : (1 : LocallyConstant K (ULift.{u} ℤ)) ∉ q.asIdeal :=
      (Ideal.ne_top_iff_one _).mp hP.ne_top
    let 𝒰 : Set (Set K) :=
      {U | ∃ hU : IsClopen U, LocallyConstant.charFn (ULift.{u} ℤ) hU ∉ q.asIdeal}
    have hne : (⋂₀ 𝒰).Nonempty := by
      have : Nonempty 𝒰 := ⟨⟨Set.univ, isClopen_univ, by rw [I1]; exact h1⟩⟩
      apply IsCompact.nonempty_sInter_of_directed_nonempty_isCompact_isClosed
      · intro U hU V hV
        obtain ⟨hU', hu⟩ := hU
        obtain ⟨hV', hv⟩ := hV
        refine ⟨U ∩ V, ⟨hU'.inter hV', ?_⟩, Set.inter_subset_left, Set.inter_subset_right⟩
        rw [I3 U V hU' hV']
        intro hm
        rcases hP.mem_or_mem hm with h | h
        · exact hu h
        · exact hv h
      · rintro U ⟨hU', hu⟩
        rw [Set.nonempty_iff_ne_empty]
        rintro rfl
        apply hu
        have e : LocallyConstant.charFn (ULift.{u} ℤ) hU' = 0 := I2
        rw [e]
        exact Ideal.zero_mem _
      · rintro U ⟨hU', -⟩
        exact hU'.isClosed.isCompact
      · rintro U ⟨hU', -⟩
        exact hU'.isClosed
    obtain ⟨x, hx⟩ := hne
    rw [Set.mem_sInter] at hx
    refine ⟨x, fun U hU => ⟨fun hxU hm => ?_, fun hn => hx U ⟨hU, hn⟩⟩⟩
    have hc : LocallyConstant.charFn (ULift.{u} ℤ) hU.compl ∉ q.asIdeal := by
      intro hc
      apply h1
      rw [← I5 U hU]
      exact Ideal.add_mem _ hm hc
    exact hx Uᶜ ⟨hU.compl, hc⟩ hxU
  choose f hf using key
  have hcont : Continuous f := by
    rw [isTopologicalBasis_isClopen.continuous_iff]
    intro s hs
    have e : f ⁻¹' s =
        (PrimeSpectrum.basicOpen (LocallyConstant.charFn (ULift.{u} ℤ) hs) : Set _) := by
      ext q
      rw [Set.mem_preimage, hf q s hs, SetLike.mem_coe, PrimeSpectrum.mem_basicOpen]
    rw [e]
    exact PrimeSpectrum.isOpen_basicOpen
  refine ⟨⟨f, hcont⟩, fun U hU q => ?_⟩
  rw [PrimeSpectrum.mem_basicOpen]
  exact hf q U hU

theorem wc_scheme_lc_to_global : ∀ (T : Scheme.{u}),
    ∃ θ : LocallyConstant ↥T (ULift.{u} ℤ) →+* Γ(T, ⊤),
      (∀ (φ : LocallyConstant ↥T (ULift.{u} ℤ)) (x : ↥T),
        T.presheaf.germ ⊤ x trivial (θ φ) = (((φ x).down : ℤ) : T.presheaf.stalk x)) ∧
      ∀ (W : Set ↥T) (hW : IsClopen W) (x : ↥T),
        x ∈ T.basicOpen (θ (LocallyConstant.charFn (ULift.{u} ℤ) hW)) ↔ x ∈ W :=
by
  intro T
  have hext : ∀ s t : Γ(T, ⊤), (∀ x : ↥T,
      T.presheaf.germ ⊤ x trivial s = T.presheaf.germ ⊤ x trivial t) → s = t := by
    intro s t h
    exact TopCat.Presheaf.section_ext T.sheaf ⊤ s t (fun x _ => h x)
  have glue : ∀ φ : LocallyConstant ↥T (ULift.{u} ℤ), ∃ s : Γ(T, ⊤), ∀ x : ↥T,
      T.presheaf.germ ⊤ x trivial s = (((φ x).down : ℤ) : T.presheaf.stalk x) := by
    intro φ
    let U : ↥T → T.Opens := fun x =>
      ⟨{y | φ y = φ x}, (φ.isLocallyConstant.isClopen_fiber (φ x)).isOpen⟩
    have hmem : ∀ x : ↥T, x ∈ U x := fun x => show φ x = φ x from rfl
    let sf : ∀ x : ↥T, Γ(T, U x) := fun x => (((φ x).down : ℤ) : Γ(T, U x))
    have hcompat : TopCat.Presheaf.IsCompatible T.sheaf.obj U sf := by
      intro i j
      apply TopCat.Presheaf.section_ext T.sheaf (U i ⊓ U j)
      intro z hz
      have a := TopCat.Presheaf.germ_res_apply T.presheaf
        (TopologicalSpace.Opens.infLELeft (U i) (U j)) z hz (sf i)
      have b := TopCat.Presheaf.germ_res_apply T.presheaf
        (TopologicalSpace.Opens.infLERight (U i) (U j)) z hz (sf j)
      refine a.trans (Eq.trans ?_ b.symm)
      have h1 : φ z = φ i := hz.1
      have h2 : φ z = φ j := hz.2
      simp only [sf]
      rw [map_intCast, map_intCast, ← h1, ← h2]
    have hcover : (⊤ : T.Opens) ≤ iSup U := fun y _ =>
      TopologicalSpace.Opens.mem_iSup.mpr ⟨y, hmem y⟩
    obtain ⟨s, hs, -⟩ := TopCat.Sheaf.existsUnique_gluing' T.sheaf U ⊤
      (fun x => homOfLE le_top) hcover sf hcompat
    refine ⟨s, fun x => ?_⟩
    have e := TopCat.Presheaf.germ_res_apply T.presheaf (homOfLE le_top : U x ⟶ ⊤) x (hmem x) s
    rw [← e]
    have e2 : T.presheaf.map (homOfLE le_top : U x ⟶ ⊤).op s = sf x := hs x
    rw [e2]
    exact map_intCast _ _
  choose f hf using glue
  let θ : LocallyConstant ↥T (ULift.{u} ℤ) →+* Γ(T, ⊤) :=
    { toFun := f
      map_one' := hext _ _ fun x => by rw [hf, map_one]; simp
      map_mul' := fun a b => hext _ _ fun x => by rw [hf, map_mul, hf, hf]; simp
      map_zero' := hext _ _ fun x => by rw [hf, map_zero]; simp
      map_add' := fun a b => hext _ _ fun x => by rw [hf, map_add, hf, hf]; simp }
  refine ⟨θ, fun φ x => hf φ x, fun W hW x => ?_⟩
  rw [Scheme.mem_basicOpen_top]
  show IsUnit (T.presheaf.germ ⊤ x trivial (f _)) ↔ x ∈ W
  rw [hf]
  by_cases hx : x ∈ W
  · rw [(LocallyConstant.charFn_eq_one _ x hW).mpr hx]
    simp [hx]
  · rw [(LocallyConstant.charFn_eq_zero _ x hW).mpr hx]
    simp [hx]

theorem wc_lc_spec_hom_ext : ∀ (K : Type) [TopologicalSpace K] [CompactSpace K] (T : Scheme.{u})
    (g g' : T ⟶ Spec (CommRingCat.of (LocallyConstant K (ULift.{u} ℤ)))),
    (∀ (U : Set K) (hU : IsClopen U) (x : ↥T),
      g.base x ∈ PrimeSpectrum.basicOpen (LocallyConstant.charFn (ULift.{u} ℤ) hU) ↔
        g'.base x ∈ PrimeSpectrum.basicOpen (LocallyConstant.charFn (ULift.{u} ℤ) hU)) →
    g = g' :=
by
  intro K _ _ T g g' H
  classical

  have key : ∀ {R : Type u} [CommRing R] [IsLocalRing R] (b : R), IsIdempotentElem b →
      (IsUnit b → b = 1) ∧ (¬ IsUnit b → b = 0) := by
    intro R _ _ b hb
    refine ⟨fun hu => (IsIdempotentElem.iff_eq_one_of_isUnit hu).mp hb, fun hu => ?_⟩
    have h1 : IsUnit (1 - b) := (IsLocalRing.isUnit_or_isUnit_one_sub_self b).resolve_left hu
    exact (IsUnit.mul_left_eq_zero h1).mp hb.mul_one_sub_self
  have s1 : ∀ (ε ε' : Γ(T, ⊤)), IsIdempotentElem ε → IsIdempotentElem ε' →
      T.basicOpen ε = T.basicOpen ε' → ε = ε' := by
    intro ε ε' hε hε' hD
    apply TopCat.Presheaf.section_ext T.sheaf ⊤ ε ε'
    intro x hx
    have ha := key _ (hε.map (T.presheaf.germ ⊤ x hx).hom)
    have ha' := key _ (hε'.map (T.presheaf.germ ⊤ x hx).hom)
    have hiff : IsUnit ((T.presheaf.germ ⊤ x hx).hom ε) ↔
        IsUnit ((T.presheaf.germ ⊤ x hx).hom ε') := by
      rw [← Scheme.mem_basicOpen_top, ← Scheme.mem_basicOpen_top, hD]
    by_cases hu : IsUnit ((T.presheaf.germ ⊤ x hx).hom ε)
    · exact (ha.1 hu).trans (ha'.1 (hiff.mp hu)).symm
    · exact (ha.2 hu).trans (ha'.2 (mt hiff.mpr hu)).symm

  have s2 : ∀ (R : Type u) [CommRing R] (f f' : LocallyConstant K (ULift.{u} ℤ) →+* R),
      (∀ (U : Set K) (hU : IsClopen U), f (LocallyConstant.charFn (ULift.{u} ℤ) hU) =
        f' (LocallyConstant.charFn (ULift.{u} ℤ) hU)) → f = f' := by
    intro R _ f f' hff
    ext φ
    have hdec : φ = ∑ v ∈ (LocallyConstant.range_finite φ).toFinset,
        (v.down : ℤ) • LocallyConstant.charFn (ULift.{u} ℤ)
          (φ.isLocallyConstant.isClopen_fiber v) := by
      apply LocallyConstant.ext
      intro y
      show φ y = LocallyConstant.evalRingHom y (∑ v ∈ (LocallyConstant.range_finite φ).toFinset,
        (v.down : ℤ) • LocallyConstant.charFn (ULift.{u} ℤ)
          (φ.isLocallyConstant.isClopen_fiber v))
      rw [map_sum]
      simp only [LocallyConstant.evalRingHom_apply, LocallyConstant.smul_apply]
      rw [Finset.sum_eq_single (φ y)]
      · rw [(LocallyConstant.charFn_eq_one _ _ _).mpr (show y ∈ {x | φ x = φ y} from rfl)]
        apply ULift.ext
        rw [ULift.smul_down, ULift.one_down, smul_eq_mul, mul_one]
      · intro v _ hv
        have hyv : y ∉ {x | φ x = v} := fun h => hv h.symm
        rw [(LocallyConstant.charFn_eq_zero _ _ _).mpr hyv, smul_zero]
      · intro h
        exact absurd ((Set.Finite.mem_toFinset _).mpr (Set.mem_range_self y)) h
    rw [hdec, map_sum, map_sum]
    refine Finset.sum_congr rfl (fun v _ => ?_)
    rw [map_zsmul, map_zsmul, hff]

  have s3 : ∀ (h : T ⟶ Spec (CommRingCat.of (LocallyConstant K (ULift.{u} ℤ))))
      (a : LocallyConstant K (ULift.{u} ℤ)) (x : T),
      h.base x ∈ PrimeSpectrum.basicOpen a ↔
        x ∈ T.basicOpen (h.appTop ((Scheme.ΓSpecIso _).inv a)) := by
    intro h a x
    have e := Scheme.Hom.preimage_basicOpen h (U := ⊤) ((Scheme.ΓSpecIso _).inv a)
    rw [basicOpen_eq_of_affine] at e
    show _ ↔ x ∈ T.basicOpen (h.app ⊤ ((Scheme.ΓSpecIso _).inv a))
    rw [← e]
    exact Iff.rfl

  apply ext_of_isAffine
  rw [← cancel_epi (Scheme.ΓSpecIso (CommRingCat.of (LocallyConstant K (ULift.{u} ℤ)))).inv]
  apply CommRingCat.hom_ext
  apply s2
  intro U hU
  rw [CommRingCat.hom_comp, CommRingCat.hom_comp, RingHom.comp_apply, RingHom.comp_apply]
  have hidem : IsIdempotentElem (LocallyConstant.charFn (ULift.{u} ℤ) hU) := by
    show _ * _ = _
    apply LocallyConstant.ext
    intro y
    rw [LocallyConstant.mul_apply]
    by_cases hy : y ∈ U
    · rw [(LocallyConstant.charFn_eq_one _ _ _).mpr hy, mul_one]
    · rw [(LocallyConstant.charFn_eq_zero _ _ _).mpr hy, mul_zero]
  apply s1
  · exact (hidem.map _).map _
  · exact (hidem.map _).map _
  · ext x
    exact ((s3 g _ x).symm.trans (H U hU x)).trans (s3 g' _ x)

theorem wc_profinite_universal_weaklyEtale : ∀ (S : Scheme.{u}) (K : Type) [TopologicalSpace K]
    [CompactSpace K] [T2Space K] [TotallyDisconnectedSpace K],
    ∃ (P : Scheme.{u}) (p : P ⟶ S) (_ : WeaklyEtale p) (π : C(↥P, K)),
      (∀ (T : Scheme.{u}) (t : T ⟶ S) (c : C(↥T, K)),
        ∃ h : T ⟶ P, h ≫ p = t ∧ π.comp h.base.hom = c) ∧
      (∀ k : K, ∃ σ : S ⟶ P, WeaklyEtale σ ∧ σ ≫ p = 𝟙 S ∧ (∀ s : ↥S, π (σ.base s) = k) ∧
        ∀ (T : Scheme.{u}) (h : T ⟶ P), (∀ x : ↥T, π (h.base x) = k) → h = (h ≫ p) ≫ σ) :=
by
  intro S K _ _ _ _
  classical

  have sep : ∀ a b : K, (∀ U : Set K, IsClopen U → (a ∈ U ↔ b ∈ U)) → a = b := by
    intro a b h
    by_contra hab
    obtain ⟨U, hU, haU, hbU⟩ := exists_isClopen_of_totally_separated hab
    exact hbU ((h U hU).mp haU)

  have s5 : ∀ (T : Scheme.{u}) (R : CommRingCat.{u}) (ψ : R ⟶ Γ(T, ⊤)) (a : R) (x : ↥T),
      (T.toSpecΓ ≫ Spec.map ψ).base x ∈ PrimeSpectrum.basicOpen a ↔
        x ∈ T.basicOpen (ψ a) := by
    intro T R ψ a x
    rw [← Scheme.toSpecΓ_preimage_basicOpen]
    exact Iff.rfl

  have s6 : ∀ (k : K) (T : Scheme.{u}) (x : ↥T) (U : Set K) (hU : IsClopen U),
      (specULiftZIsTerminal.from T ≫ Spec.map (CommRingCat.ofHom
        (LocallyConstant.evalRingHom k : LocallyConstant K (ULift.{u} ℤ) →+* ULift.{u} ℤ))).base x ∈
          PrimeSpectrum.basicOpen (LocallyConstant.charFn (ULift.{u} ℤ) hU) ↔ k ∈ U := by
    intro k T x U hU
    have e : ((specULiftZIsTerminal.from T ≫ Spec.map (CommRingCat.ofHom
        (LocallyConstant.evalRingHom k : LocallyConstant K (ULift.{u} ℤ) →+* ULift.{u} ℤ))).base x ∈
          PrimeSpectrum.basicOpen (LocallyConstant.charFn (ULift.{u} ℤ) hU)) ↔
        (LocallyConstant.charFn (ULift.{u} ℤ) hU k ∉
          ((specULiftZIsTerminal.from T).base x : PrimeSpectrum (ULift.{u} ℤ)).asIdeal) := Iff.rfl
    rw [e]
    by_cases hk : k ∈ U
    · rw [(LocallyConstant.charFn_eq_one _ _ _).mpr hk]
      simp only [hk, iff_true]
      exact Ideal.IsPrime.one_notMem
        ((specULiftZIsTerminal.from T).base x : PrimeSpectrum (ULift.{u} ℤ)).isPrime
    · rw [(LocallyConstant.charFn_eq_zero _ _ _).mpr hk]
      simp only [hk, iff_false, not_not]
      exact Ideal.zero_mem _

  obtain ⟨ι, hιW⟩ : ∃ ι : Spec (CommRingCat.of (LocallyConstant K (ULift.{u} ℤ))) ⟶
      Spec (CommRingCat.of (ULift.{u} ℤ)), WeaklyEtale ι :=
    ⟨_, wc_lc_spec_weaklyEtale.{u} K⟩
  obtain ⟨π0, hπ0⟩ := wc_lc_spec_pi0.{u} K
  obtain ⟨P, p, q, hpb⟩ : ∃ (P : Scheme.{u}) (p : P ⟶ S)
      (q : P ⟶ Spec (CommRingCat.of (LocallyConstant K (ULift.{u} ℤ)))),
      IsPullback p q (specULiftZIsTerminal.from S) ι :=
    ⟨_, _, _, IsPullback.of_hasPullback _ _⟩
  have hp : WeaklyEtale p := MorphismProperty.of_isPullback (P := @WeaklyEtale) hpb.flip hιW
  refine ⟨P, p, hp, π0.comp q.base.hom, ?_, ?_⟩
  ·
    intro T t c
    obtain ⟨θ, -, hθ⟩ := wc_scheme_lc_to_global T
    let ψ : LocallyConstant K (ULift.{u} ℤ) →+* Γ(T, ⊤) :=
      θ.comp (LocallyConstant.comapRingHom c)
    obtain ⟨h0, hh0⟩ : ∃ h0 : T ⟶ Spec (CommRingCat.of (LocallyConstant K (ULift.{u} ℤ))),
        h0 = T.toSpecΓ ≫ Spec.map (CommRingCat.ofHom ψ) := ⟨_, rfl⟩
    have hclaim : ∀ x, π0 (h0.base x) = c x := by
      intro x
      apply sep
      intro U hU
      refine (hπ0 U hU (h0.base x)).trans ?_
      rw [hh0]
      refine (s5 T _ (CommRingCat.ofHom ψ) (LocallyConstant.charFn _ hU) x).trans ?_
      have he : LocallyConstant.comap c (LocallyConstant.charFn (ULift.{u} ℤ) hU) =
          LocallyConstant.charFn (ULift.{u} ℤ) (hU.preimage c.continuous) := by
        ext y
        simp [LocallyConstant.coe_charFn, Set.indicator_apply]
      have hψ : (CommRingCat.ofHom ψ) (LocallyConstant.charFn (ULift.{u} ℤ) hU) =
          θ (LocallyConstant.charFn (ULift.{u} ℤ) (hU.preimage c.continuous)) := by
        rw [← he]
        rfl
      rw [hψ, hθ]
      exact Iff.rfl
    obtain ⟨h, hhp, hhq⟩ : ∃ h : T ⟶ P, h ≫ p = t ∧ h ≫ q = h0 :=
      ⟨hpb.lift t h0 (specULiftZIsTerminal.hom_ext _ _), hpb.lift_fst _ _ _, hpb.lift_snd _ _ _⟩
    refine ⟨h, hhp, ?_⟩
    apply ContinuousMap.ext
    intro x
    have e1 : (h ≫ q).base x = h0.base x := by rw [hhq]
    rw [← hclaim x]
    exact congrArg π0 e1
  ·
    intro k
    obtain ⟨σ, hσp, hσq⟩ : ∃ σ : S ⟶ P, σ ≫ p = 𝟙 S ∧
        σ ≫ q = specULiftZIsTerminal.from S ≫ Spec.map (CommRingCat.ofHom
          (LocallyConstant.evalRingHom k : LocallyConstant K (ULift.{u} ℤ) →+* ULift.{u} ℤ)) :=
      ⟨hpb.lift (𝟙 S) _ (specULiftZIsTerminal.hom_ext _ _), hpb.lift_fst _ _ _,
        hpb.lift_snd _ _ _⟩
    have hσW : WeaklyEtale σ := by
      haveI : WeaklyEtale (σ ≫ p) := by rw [hσp]; infer_instance
      exact WeaklyEtale.of_comp σ p
    refine ⟨σ, hσW, hσp, ?_, ?_⟩
    · intro s
      apply sep
      intro U hU
      have e1 : (σ ≫ q).base s = (specULiftZIsTerminal.from S ≫ Spec.map (CommRingCat.ofHom
          (LocallyConstant.evalRingHom k : LocallyConstant K (ULift.{u} ℤ) →+* ULift.{u} ℤ))).base s :=
        by rw [hσq]
      refine (hπ0 U hU ((σ ≫ q).base s)).trans ?_
      rw [e1]
      exact s6 k S s U hU
    · intro T h hk
      apply hpb.hom_ext
      · rw [Category.assoc, hσp, Category.comp_id]
      · rw [Category.assoc, hσq, ← Category.assoc,
          specULiftZIsTerminal.hom_ext ((h ≫ p) ≫ specULiftZIsTerminal.from S)
            (specULiftZIsTerminal.from T)]
        apply wc_lc_spec_hom_ext K T
        intro U hU x
        have hkx : π0 ((h ≫ q).base x) = k := hk x
        refine (hπ0 U hU ((h ≫ q).base x)).symm.trans ?_
        rw [hkx]
        exact (s6 k T x U hU).symm

theorem wc_proet_contfun_pullback_locally_bijective : ∀ {S S' : Scheme.{u}} (f : S' ⟶ S) (ℓ : ℕ)
    [Fact (Nat.Prime ℓ)],
    (∀ (V' : S'.ProEt) (r' : C(↥V'.left, ULift.{u+1} ℚ_[ℓ])),
      ∃ T ∈ Scheme.ProEt.topology S' V', ∀ ⦃W' : S'.ProEt⦄ (g : W' ⟶ V'), T.arrows g →
        ∃ (V : S.ProEt) (a : W' ⟶ (wcProEtBC f).obj V) (r : C(↥V.left, ULift.{u+1} ℚ_[ℓ])),
          r'.comp g.left.base.hom =
            (r.comp (Limits.pullback.fst V.hom f).base.hom).comp a.left.base.hom) ∧
    (∀ (V' : S'.ProEt) (V : S.ProEt) (a : V' ⟶ (wcProEtBC f).obj V)
      (r : C(↥V.left, ULift.{u+1} ℚ_[ℓ])),
      (r.comp (Limits.pullback.fst V.hom f).base.hom).comp a.left.base.hom = 0 →
      ∃ T ∈ Scheme.ProEt.topology S' V', ∀ ⦃W' : S'.ProEt⦄ (g : W' ⟶ V'), T.arrows g →
        ∃ (W : S.ProEt) (b : W ⟶ V) (a' : W' ⟶ (wcProEtBC f).obj W),
          a' ≫ (wcProEtBC f).map b = g ≫ a ∧ r.comp b.left.base.hom = 0) :=
by
  intro S S' f ℓ _

  obtain ⟨P, p, hp, π, huniv, hσ⟩ := wc_profinite_universal_weaklyEtale S ℤ_[ℓ]
  have hℓ0 : (ℓ : ℚ_[ℓ]) ≠ 0 := by exact_mod_cast (Fact.out : Nat.Prime ℓ).ne_zero

  have H1 : ∀ (V : S'.ProEt) (R : Sieve V), (∀ x : ↥V.left, ∃ (W : S'.ProEt) (g : W ⟶ V),
      R.arrows g ∧ IsOpenImmersion g.left ∧ x ∈ Set.range g.left) →
      R ∈ Scheme.ProEt.topology S' V := by
    intro V R hR
    choose W g hgR hgo hgx using hR
    have hZ : Presieve.ofArrows (fun x => (W x).left) (fun x => (g x).left) ∈
        (Scheme.precoverage @IsOpenImmersion).coverings V.left :=
      (Scheme.ofArrows_mem_precoverage_iff _).mpr ⟨fun x => ⟨x, hgx x⟩, fun x => hgo x⟩
    have hP : Presieve.ofArrows W g ∈ (Scheme.ProEt.precoverage S').coverings V := by
      show _ ∈ (Precoverage.comap (Scheme.ProEt.forget S' ⋙ Over.forget S')
        Scheme.proetalePrecoverage).coverings V
      rw [Precoverage.mem_comap_iff, Presieve.map_ofArrows]
      change Presieve.ofArrows (fun x => (W x).left) (fun x => (g x).left) ∈
        Scheme.proetalePrecoverage.coverings V.left
      exact ⟨Scheme.zariskiPrecoverage_le_qcPrecoverage V.left hZ, hZ.1,
        MorphismProperty.ofArrows_mem_precoverage.mpr (fun x => inferInstance)⟩
    refine GrothendieckTopology.superset_covering _ ?_ (Precoverage.generate_mem_toGrothendieck hP)
    rw [Sieve.generate_le_iff]
    rintro _ _ ⟨x⟩
    exact hgR x

  have H2 : ∀ (X : Type u) [TopologicalSpace X] [CompactSpace X]
      (r : C(X, ULift.{u+1} ℚ_[ℓ])), ∃ (n : ℕ) (c : C(X, ℤ_[ℓ])),
        ∀ x : X, (ℓ : ℚ_[ℓ]) ^ n * (r x).down = (c x : ℚ_[ℓ]) := by
    intro X _ _ r
    have hF : Continuous (fun x => (r x).down) := continuous_uliftDown.comp r.continuous
    obtain ⟨C, hC⟩ := isCompact_univ.exists_bound_of_continuousOn hF.continuousOn
    have hℓ1 : (1 : ℝ) < ℓ := by exact_mod_cast (Fact.out : Nat.Prime ℓ).one_lt
    obtain ⟨n, hn⟩ := pow_unbounded_of_one_lt C hℓ1
    have hb : ∀ x, ‖(ℓ : ℚ_[ℓ]) ^ n * (r x).down‖ ≤ 1 := by
      intro x
      rw [norm_mul, Padic.norm_p_pow, zpow_neg, zpow_natCast]
      have hpos : (0 : ℝ) < (ℓ : ℝ) ^ n := by positivity
      rw [inv_mul_le_iff₀ hpos, mul_one]
      exact le_trans (hC x (Set.mem_univ x)) hn.le
    refine ⟨n, ⟨fun x => ⟨(ℓ : ℚ_[ℓ]) ^ n * (r x).down, hb x⟩, ?_⟩, fun x => rfl⟩
    exact (continuous_const.mul hF).subtype_mk _
  refine ⟨fun V' r' => ?_, fun V' V a r hr => ?_⟩
  ·
    let T : Sieve V' :=
      { arrows := fun W' g => ∃ (V : S.ProEt) (a : W' ⟶ (wcProEtBC f).obj V)
            (r : C(↥V.left, ULift.{u+1} ℚ_[ℓ])),
            r'.comp g.left.base.hom =
              (r.comp (Limits.pullback.fst V.hom f).base.hom).comp a.left.base.hom
        downward_closed := by
          rintro Y Z g ⟨V, a, r, h⟩ k
          exact ⟨V, k ≫ a, r,
            ContinuousMap.ext fun z => congrArg (fun ψ : C(_, _) => ψ (k.left.base z)) h⟩ }
    refine ⟨T, H1 V' T ?_, fun W' g hg => hg⟩
    intro x
    obtain ⟨U, hU, hxU, -⟩ :=
      exists_isAffineOpen_mem_and_subset (show x ∈ (⊤ : V'.left.Opens) from trivial)
    haveI : IsAffine U := hU
    haveI : WeaklyEtale V'.hom := V'.prop
    let W : S'.ProEt := Scheme.ProEt.mk (U.ι ≫ V'.hom)
    let g : W ⟶ V' := MorphismProperty.Over.homMk U.ι rfl trivial
    refine ⟨W, g, ?_, (inferInstance : IsOpenImmersion U.ι), ?_⟩
    swap
    · exact (Set.ext_iff.mp (Scheme.Opens.range_ι U) x).mpr hxU
    obtain ⟨n, c, hc⟩ := H2 U.toScheme (r'.comp U.ι.base.hom)
    obtain ⟨h, hhp, hhc⟩ := huniv U.toScheme (U.ι ≫ V'.hom ≫ f) c
    haveI := hp
    let V : S.ProEt := Scheme.ProEt.mk p
    let aL : U.toScheme ⟶ Limits.pullback p f :=
      Limits.pullback.lift h (U.ι ≫ V'.hom) (by rw [hhp, Category.assoc])
    let a : W ⟶ (wcProEtBC f).obj V :=
      MorphismProperty.Over.homMk aL (Limits.pullback.lift_snd _ _ _) trivial
    let rfun : C(↥P, ULift.{u+1} ℚ_[ℓ]) :=
      ⟨fun y => ULift.up (((ℓ : ℚ_[ℓ]) ^ n)⁻¹ * (π y : ℚ_[ℓ])),
        continuous_uliftUp.comp (continuous_const.mul (continuous_subtype_val.comp π.continuous))⟩
    refine ⟨V, a, rfun, ?_⟩
    apply ContinuousMap.ext
    intro z
    apply ULift.ext
    have h1 : (Limits.pullback.fst p f).base (aL.base z) = h.base z :=
      congrArg (fun k : U.toScheme ⟶ P => k.base z) (Limits.pullback.lift_fst h (U.ι ≫ V'.hom) _)
    have h2 : (π (h.base z) : ℚ_[ℓ]) = c z :=
      congrArg (fun φ : C(_, ℤ_[ℓ]) => (φ z : ℚ_[ℓ])) hhc
    change (r' (U.ι.base z)).down =
      ((ℓ : ℚ_[ℓ]) ^ n)⁻¹ * (π ((Limits.pullback.fst p f).base (aL.base z)) : ℚ_[ℓ])
    rw [h1, h2, ← hc z, ← mul_assoc, inv_mul_cancel₀ (pow_ne_zero n hℓ0), one_mul]
    try rfl
  ·
    obtain ⟨σ, hσW, hσp, hσπ, hσfac⟩ := hσ 0
    let T : Sieve V' :=
      { arrows := fun W' g => ∃ (W : S.ProEt) (b : W ⟶ V) (a' : W' ⟶ (wcProEtBC f).obj W),
            a' ≫ (wcProEtBC f).map b = g ≫ a ∧ r.comp b.left.base.hom = 0
        downward_closed := by
          rintro Y Z g ⟨W, b, a', h1, h2⟩ k
          exact ⟨W, b, k ≫ a', by rw [Category.assoc, h1, Category.assoc], h2⟩ }
    refine ⟨T, H1 V' T ?_, fun W' g hg => hg⟩
    intro x
    have ha : a.left ≫ Limits.pullback.snd V.hom f = V'.hom := Over.w a.toCommaMorphism
    have hGb1 : ∀ {W : S.ProEt} (b : W ⟶ V), ((wcProEtBC f).map b).left ≫
        Limits.pullback.fst V.hom f = Limits.pullback.fst W.hom f ≫ b.left := fun b =>
      Limits.pullback.lift_fst _ _ _
    have hGb2 : ∀ {W : S.ProEt} (b : W ⟶ V), ((wcProEtBC f).map b).left ≫
        Limits.pullback.snd V.hom f = Limits.pullback.snd W.hom f := fun b =>
      Limits.pullback.lift_snd _ _ _
    let φ : V'.left ⟶ V.left := a.left ≫ Limits.pullback.fst V.hom f
    obtain ⟨UV, hUV, hxUV, -⟩ :=
      exists_isAffineOpen_mem_and_subset (show φ.base x ∈ (⊤ : V.left.Opens) from trivial)
    haveI : IsAffine UV := hUV
    let O : V'.left.Opens := φ ⁻¹ᵁ UV
    haveI : WeaklyEtale V'.hom := V'.prop
    haveI : WeaklyEtale V.hom := V.prop
    let W' : S'.ProEt := Scheme.ProEt.mk (O.ι ≫ V'.hom)
    let g : W' ⟶ V' := MorphismProperty.Over.homMk O.ι rfl trivial
    refine ⟨W', g, ?_, (inferInstance : IsOpenImmersion O.ι), ?_⟩
    swap
    · exact (Set.ext_iff.mp (Scheme.Opens.range_ι O) x).mpr hxUV
    obtain ⟨n, c, hc⟩ := H2 UV.toScheme (r.comp UV.ι.base.hom)
    obtain ⟨h, hhp, hhc⟩ := huniv UV.toScheme (UV.ι ≫ V.hom) c
    haveI := hσW
    haveI := hp
    let W : S.ProEt := Scheme.ProEt.mk (Limits.pullback.fst h σ ≫ UV.ι ≫ V.hom)
    let b : W ⟶ V := MorphismProperty.Over.homMk (Limits.pullback.fst h σ ≫ UV.ι)
      (Category.assoc _ _ _) trivial
    have hb0 : r.comp b.left.base.hom = 0 := by
      apply ContinuousMap.ext
      intro w
      apply ULift.ext
      have e1 : h.base ((Limits.pullback.fst h σ).base w) =
          σ.base ((Limits.pullback.snd h σ).base w) :=
        congrArg (fun k : Limits.pullback h σ ⟶ P => k.base w) (Limits.pullback.condition (f := h) (g := σ))
      have e2 : (c ((Limits.pullback.fst h σ).base w) : ℚ_[ℓ]) = 0 := by
        have := congrArg (fun φ : C(_, ℤ_[ℓ]) => (φ ((Limits.pullback.fst h σ).base w) : ℚ_[ℓ])) hhc
        rw [← this]
        change ((π (h.base ((Limits.pullback.fst h σ).base w)) : ℚ_[ℓ])) = 0
        rw [e1, hσπ]
        rfl
      have e3 := hc ((Limits.pullback.fst h σ).base w)
      rw [e2] at e3
      have e4 := (mul_eq_zero.mp e3).resolve_left (pow_ne_zero n hℓ0)
      exact e4
    let m : O.toScheme ⟶ UV.toScheme := φ.resLE UV O le_rfl
    have hm : m ≫ UV.ι = O.ι ≫ a.left ≫ Limits.pullback.fst V.hom f :=
      Scheme.Hom.resLE_comp_ι _ _
    have hπm : ∀ o, π (h.base (m.base o)) = 0 := by
      intro o
      apply Subtype.ext
      have e1 := congrArg (fun φ : C(_, ℤ_[ℓ]) => (φ (m.base o) : ℚ_[ℓ])) hhc
      have e3 := hc (m.base o)
      have e5 : UV.ι.base (m.base o) =
          (Limits.pullback.fst V.hom f).base (a.left.base (O.ι.base o)) :=
        congrArg (fun k : O.toScheme ⟶ V.left => k.base o) hm
      have e6 : (r ((Limits.pullback.fst V.hom f).base (a.left.base (O.ι.base o)))).down = 0 :=
        congrArg (fun ψ : C(_, ULift.{u+1} ℚ_[ℓ]) => (ψ (O.ι.base o)).down) hr
      change ((π.comp h.base.hom) (m.base o) : ℚ_[ℓ]) = ((0 : ℤ_[ℓ]) : ℚ_[ℓ])
      rw [e1, ← e3]
      change (ℓ : ℚ_[ℓ]) ^ n * (r (UV.ι.base (m.base o))).down = 0
      rw [e5, e6, mul_zero]
      try rfl
    have hfac := hσfac O.toScheme (m ≫ h) (fun o => hπm o)
    let q : O.toScheme ⟶ Limits.pullback h σ := Limits.pullback.lift m ((m ≫ h) ≫ p) hfac
    have hq1 : q ≫ Limits.pullback.fst h σ = m := Limits.pullback.lift_fst _ _ _
    have hcond : Limits.pullback.fst V.hom f ≫ V.hom = Limits.pullback.snd V.hom f ≫ f :=
      Limits.pullback.condition
    have hw : q ≫ (Limits.pullback.fst h σ ≫ UV.ι ≫ V.hom) = (O.ι ≫ V'.hom) ≫ f :=
      calc q ≫ (Limits.pullback.fst h σ ≫ UV.ι ≫ V.hom)
          = (q ≫ Limits.pullback.fst h σ) ≫ UV.ι ≫ V.hom := (Category.assoc _ _ _).symm
        _ = m ≫ UV.ι ≫ V.hom := congrArg (fun k => k ≫ UV.ι ≫ V.hom) hq1
        _ = (m ≫ UV.ι) ≫ V.hom := (Category.assoc _ _ _).symm
        _ = (O.ι ≫ a.left ≫ Limits.pullback.fst V.hom f) ≫ V.hom :=
          congrArg (fun k => k ≫ V.hom) hm
        _ = O.ι ≫ a.left ≫ (Limits.pullback.fst V.hom f ≫ V.hom) :=
          (Category.assoc _ _ _).trans (congrArg (fun k => O.ι ≫ k) (Category.assoc _ _ _))
        _ = O.ι ≫ a.left ≫ (Limits.pullback.snd V.hom f ≫ f) :=
          congrArg (fun k => O.ι ≫ a.left ≫ k) hcond
        _ = O.ι ≫ (a.left ≫ Limits.pullback.snd V.hom f) ≫ f :=
          congrArg (fun k => O.ι ≫ k) (Category.assoc _ _ _).symm
        _ = O.ι ≫ V'.hom ≫ f := congrArg (fun k => O.ι ≫ k ≫ f) ha
        _ = (O.ι ≫ V'.hom) ≫ f := (Category.assoc _ _ _).symm
    let aL' : O.toScheme ⟶ Limits.pullback (Limits.pullback.fst h σ ≫ UV.ι ≫ V.hom) f :=
      Limits.pullback.lift q (O.ι ≫ V'.hom) hw
    let a' : W' ⟶ (wcProEtBC f).obj W :=
      MorphismProperty.Over.homMk aL' (Limits.pullback.lift_snd _ _ _) trivial
    refine ⟨W, b, a', ?_, hb0⟩
    apply MorphismProperty.Over.Hom.ext
    change aL' ≫ ((wcProEtBC f).map b).left = O.ι ≫ a.left
    have e1 : aL' ≫ Limits.pullback.fst W.hom f = q := Limits.pullback.lift_fst _ _ _
    have e2 : aL' ≫ Limits.pullback.snd W.hom f = O.ι ≫ V'.hom := Limits.pullback.lift_snd _ _ _
    have hbl : b.left = Limits.pullback.fst h σ ≫ UV.ι := rfl
    refine Limits.pullback.hom_ext ?_ ?_
    · exact calc (aL' ≫ ((wcProEtBC f).map b).left) ≫ Limits.pullback.fst V.hom f
          = aL' ≫ (((wcProEtBC f).map b).left ≫ Limits.pullback.fst V.hom f) :=
            Category.assoc _ _ _
        _ = aL' ≫ (Limits.pullback.fst W.hom f ≫ b.left) := congrArg (fun k => aL' ≫ k) (hGb1 b)
        _ = (aL' ≫ Limits.pullback.fst W.hom f) ≫ b.left := (Category.assoc _ _ _).symm
        _ = q ≫ b.left := congrArg (fun k => k ≫ b.left) e1
        _ = q ≫ (Limits.pullback.fst h σ ≫ UV.ι) := rfl
        _ = (q ≫ Limits.pullback.fst h σ) ≫ UV.ι := (Category.assoc _ _ _).symm
        _ = m ≫ UV.ι := congrArg (fun k => k ≫ UV.ι) hq1
        _ = O.ι ≫ a.left ≫ Limits.pullback.fst V.hom f := hm
        _ = (O.ι ≫ a.left) ≫ Limits.pullback.fst V.hom f := (Category.assoc _ _ _).symm
    · exact calc (aL' ≫ ((wcProEtBC f).map b).left) ≫ Limits.pullback.snd V.hom f
          = aL' ≫ (((wcProEtBC f).map b).left ≫ Limits.pullback.snd V.hom f) :=
            Category.assoc _ _ _
        _ = aL' ≫ Limits.pullback.snd W.hom f := congrArg (fun k => aL' ≫ k) (hGb2 b)
        _ = O.ι ≫ V'.hom := e2
        _ = O.ι ≫ (a.left ≫ Limits.pullback.snd V.hom f) := congrArg (fun k => O.ι ≫ k) ha.symm
        _ = (O.ι ≫ a.left) ≫ Limits.pullback.snd V.hom f := (Category.assoc _ _ _).symm

theorem wc_hm_pull_data_exists {S S' : Scheme.{u}} (f : S' ⟶ S) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] :
    ∃ D : wcHMPullData f ℓ, wcHMPullCanonical D :=
by
  classical

  obtain ⟨hcont, hflat⟩ := wc_proet_pullback_continuous_flat f
  have hcont' : (wcProEtBC f).IsContinuous (Scheme.ProEt.topology S)
      (Scheme.ProEt.topology S') := hcont
  have hflat' : RepresentablyFlat (wcProEtBC f) := hflat
  letI := hcont'
  haveI := hflat'

  have key : ∀ {V W : S.ProEt} (g : W ⟶ V),
      ((wcProEtBC f).map g).left ≫ Limits.pullback.fst V.hom f =
        Limits.pullback.fst W.hom f ≫ g.left := by
    intro V W g
    exact Limits.pullback.lift_fst _ _ _
  let φp : (wcRingSheaf S ℓ).obj ⟶ (wcProEtBC f).op ⋙ (wcRingSheaf S' ℓ).obj :=
    { app := fun V => RingCat.ofHom (ContinuousMap.compRightAlgHom ℤ (ULift.{u+1} ℚ_[ℓ])
          (Limits.pullback.fst V.unop.hom f).base.hom).toRingHom
      naturality := fun V W g => by
        ext s
        apply ContinuousMap.ext
        intro x
        have hx := congrArg (fun k => k.base x) (key g.unop)
        let s' : C(↥(Opposite.unop V).left, ULift.{u+1} ℚ_[ℓ]) := s
        first
          | exact congrArg s' hx.symm
          | exact congrArg s' hx
          | (simp only [Scheme.Hom.comp_base] at hx; exact congrArg s' hx.symm)
          | (simp only [Scheme.Hom.comp_base] at hx; exact congrArg s' hx) }
  let φ : wcRingSheaf S ℓ ⟶ ((wcProEtBC f).sheafPushforwardContinuous RingCat.{u+1}
      (Scheme.ProEt.topology S) (Scheme.ProEt.topology S')).obj (wcRingSheaf S' ℓ) :=
    ObjectProperty.homMk φp

  haveI : (PresheafOfModules.pushforward.{u+1} φ.hom).IsRightAdjoint :=
    wc_presheafOfModules_pushforward_isRightAdjoint _ φ.hom
  let Φ : SheafOfModules.{u+1} (wcRingSheaf S ℓ) ⥤ SheafOfModules.{u+1} (wcRingSheaf S' ℓ) :=
    SheafOfModules.pullback φ
  let adj : Φ ⊣ SheafOfModules.pushforward φ := SheafOfModules.pullbackPushforwardAdjunction φ

  haveI : Φ.IsLeftAdjoint := adj.isLeftAdjoint
  haveI : Φ.PreservesZeroMorphisms := Functor.preservesZeroMorphisms_of_isLeftAdjoint Φ
  haveI : Limits.PreservesColimitsOfSize.{0, 0} Φ := adj.leftAdjoint_preservesColimits
  haveI hcol : Limits.PreservesFiniteColimits Φ :=
    Limits.PreservesColimitsOfSize.preservesFiniteColimits Φ
  haveI : Limits.PreservesBinaryBiproducts Φ :=
    Limits.preservesBinaryBiproducts_of_preservesBinaryCoproducts Φ
  haveI hadd : Φ.Additive := Functor.additive_of_preservesBinaryBiproducts Φ

  obtain ⟨hsurj, hinj⟩ := wc_proet_contfun_pullback_locally_bijective f ℓ
  obtain ⟨ι⟩ := wc_sheafOfModules_pullback_toSheaf_iso (Scheme.ProEt.topology S)
    (Scheme.ProEt.topology S') (wcProEtBC f) (wcRingSheaf S ℓ) (wcRingSheaf S' ℓ) φ
    hsurj hinj Φ adj
  haveI := wc_sheafPullback_preservesFiniteLimits_of_flat (Scheme.ProEt.topology S)
    (Scheme.ProEt.topology S') (wcProEtBC f)
  haveI : Limits.PreservesFiniteLimits (SheafOfModules.toSheaf.{u+1} (wcRingSheaf S ℓ) ⋙
      (wcProEtBC f).sheafPullback AddCommGrpCat.{u+1} (Scheme.ProEt.topology S)
        (Scheme.ProEt.topology S')) :=
    Limits.comp_preservesFiniteLimits _ _
  haveI : Limits.PreservesFiniteLimits (Φ ⋙ SheafOfModules.toSheaf.{u+1} (wcRingSheaf S' ℓ)) :=
    Limits.preservesFiniteLimits_of_natIso ι.symm
  haveI hlim : Limits.PreservesFiniteLimits Φ :=
    Limits.preservesFiniteLimits_of_reflects_of_preserves Φ
      (SheafOfModules.toSheaf.{u+1} (wcRingSheaf S' ℓ))

  haveI : (wcProEtBC f).Final := final_of_representablyFlat _
  let μ : Φ.obj (SheafOfModules.unit (wcRingSheaf S ℓ)) ≅ SheafOfModules.unit (wcRingSheaf S' ℓ) :=
    Φ.mapIso (Limits.coproductUniqueIso
        (fun _ : PUnit.{u+2} => SheafOfModules.unit (wcRingSheaf S ℓ))).symm ≪≫
      SheafOfModules.pullbackObjFreeIso φ PUnit.{u+2} ≪≫
      Limits.coproductUniqueIso (fun _ : PUnit.{u+2} => SheafOfModules.unit (wcRingSheaf S' ℓ))

  exact ⟨⟨hcont', φ, Φ, adj, hadd, hlim, hcol, μ⟩, fun V s => rfl⟩

theorem sheafPushforward_additive_finiteColimits : ∀ {C D : Type (u+1)} [Category.{u} C] [Category.{u} D]
    (J : GrothendieckTopology C) (K : GrothendieckTopology D) (G : C ⥤ D)
    [G.IsContinuous J K] [G.IsCocontinuous J K],
    (G.sheafPushforwardContinuous AddCommGrpCat.{u+1} J K).Additive ∧
    Limits.PreservesFiniteColimits (G.sheafPushforwardContinuous AddCommGrpCat.{u+1} J K) :=
by
  intro C D _ _ J K G _ _
  have adj := G.sheafAdjunctionCocontinuous AddCommGrpCat.{u+1} J K
  have := adj.leftAdjoint_preservesColimits.{0, 0}
  have : (G.sheafPushforwardContinuous AddCommGrpCat.{u+1} J K).IsLeftAdjoint := adj.isLeftAdjoint
  have := Functor.preservesZeroMorphisms_of_isLeftAdjoint
    (G.sheafPushforwardContinuous AddCommGrpCat.{u+1} J K)
  have := Limits.preservesBinaryBiproducts_of_preservesBinaryCoproducts
    (G.sheafPushforwardContinuous AddCommGrpCat.{u+1} J K)
  exact ⟨Functor.additive_of_preservesBinaryBiproducts _,
    Limits.PreservesColimitsOfSize.preservesFiniteColimits _⟩

theorem sheafOfModules_toSheaf_preservesFiniteColimits : ∀ {C : Type (u+1)} [Category.{u} C]
    (J : GrothendieckTopology C)
    [HasSheafify J AddCommGrpCat.{u+1}] [J.WEqualsLocallyBijective AddCommGrpCat.{u+1}]
    (R : Sheaf J RingCat.{u+1}), Limits.PreservesFiniteColimits (SheafOfModules.toSheaf.{u+1} R) :=
by
  intro C _ J _ _ R
  constructor
  intro I _ _
  constructor
  intro K
  let adj := PresheafOfModules.sheafificationAdjunction (J := J) (𝟙 R.obj)
  haveI : IsIso adj.counit := inferInstance
  haveI hP : Limits.PreservesColimitsOfShape I
      (PresheafOfModules.sheafification (J := J) (𝟙 R.obj) ⋙ SheafOfModules.toSheaf.{u+1} R) :=
    Limits.preservesColimitsOfShape_of_natIso
      (PresheafOfModules.sheafificationCompToSheaf (J := J) (𝟙 R.obj)).symm
  let K₀ := K ⋙ (SheafOfModules.forget R ⋙ PresheafOfModules.restrictScalars (𝟙 R.obj))
  let c₀ := Limits.colimit.cocone K₀
  let h₀ : Limits.IsColimit c₀ := Limits.colimit.isColimit K₀
  have ht : Limits.IsColimit
      ((PresheafOfModules.sheafification (J := J) (𝟙 R.obj)).mapCocone c₀) :=
    Limits.isColimitOfPreserves _ h₀
  have ht' : Limits.IsColimit ((SheafOfModules.toSheaf.{u+1} R).mapCocone
      ((PresheafOfModules.sheafification (J := J) (𝟙 R.obj)).mapCocone c₀)) :=
    Limits.IsColimit.ofIsoColimit
      (Limits.isColimitOfPreserves
        (PresheafOfModules.sheafification (J := J) (𝟙 R.obj) ⋙ SheafOfModules.toSheaf.{u+1} R) h₀)
      (Functor.mapCoconeMapCocone c₀).symm
  haveI : Limits.PreservesColimit (K₀ ⋙ PresheafOfModules.sheafification (J := J) (𝟙 R.obj))
      (SheafOfModules.toSheaf.{u+1} R) :=
    Limits.preservesColimit_of_preserves_colimit_cocone ht ht'
  let e : K₀ ⋙ PresheafOfModules.sheafification (J := J) (𝟙 R.obj) ≅ K :=
    Functor.associator _ _ _ ≪≫ Functor.isoWhiskerLeft K (asIso adj.counit) ≪≫ Functor.rightUnitor K
  exact Limits.preservesColimit_of_iso_diagram _ e

theorem sheafOfModules_pushforward_exact : ∀ {C D : Type (u+1)} [Category.{u} C] [Category.{u} D]
    {J : GrothendieckTopology C} {K : GrothendieckTopology D} (G : C ⥤ D) [G.IsContinuous J K]
    [HasSheafify J AddCommGrpCat.{u+1}] [J.WEqualsLocallyBijective AddCommGrpCat.{u+1}]
    [HasSheafify K AddCommGrpCat.{u+1}] [K.WEqualsLocallyBijective AddCommGrpCat.{u+1}]
    (S : Sheaf J RingCat.{u+1}) (R : Sheaf K RingCat.{u+1})
    (φ : S ⟶ (G.sheafPushforwardContinuous RingCat.{u+1} J K).obj R)
    [Limits.PreservesFiniteColimits (SheafOfModules.toSheaf.{u+1} S)]
    [Limits.PreservesFiniteColimits (SheafOfModules.toSheaf.{u+1} R)]
    [Limits.PreservesFiniteLimits (G.sheafPushforwardContinuous AddCommGrpCat.{u+1} J K)]
    [Limits.PreservesFiniteColimits (G.sheafPushforwardContinuous AddCommGrpCat.{u+1} J K)],
    (SheafOfModules.pushforward.{u+1} φ).Additive ∧
      Limits.PreservesFiniteLimits (SheafOfModules.pushforward.{u+1} φ) ∧
      Limits.PreservesFiniteColimits (SheafOfModules.pushforward.{u+1} φ) :=
by
  intro C D _ _ J K G _ _ _ _ _ S R φ _ _ _ _
  haveI hΦA : (G.sheafPushforwardContinuous AddCommGrpCat.{u+1} J K).Additive :=
    Functor.additive_of_preserves_binary_products _
  haveI hcompA : (SheafOfModules.pushforward.{u+1} φ ⋙ SheafOfModules.toSheaf.{u+1} S).Additive :=
    Functor.additive_of_iso (F := SheafOfModules.toSheaf.{u+1} R ⋙
      G.sheafPushforwardContinuous AddCommGrpCat.{u+1} J K) (Iso.refl _)
  refine ⟨Functor.additive_of_comp_faithful (SheafOfModules.pushforward.{u+1} φ)
      (SheafOfModules.toSheaf.{u+1} S), ⟨fun I _ _ => ?_⟩, ⟨fun I _ _ => ?_⟩⟩
  · haveI : Limits.PreservesLimitsOfShape I
        (SheafOfModules.pushforward.{u+1} φ ⋙ SheafOfModules.toSheaf.{u+1} S) :=
      Limits.preservesLimitsOfShape_of_natIso (F := SheafOfModules.toSheaf.{u+1} R ⋙
        G.sheafPushforwardContinuous AddCommGrpCat.{u+1} J K) (Iso.refl _)
    haveI : Limits.ReflectsLimitsOfShape I (SheafOfModules.toSheaf.{u+1} S) :=
      Limits.reflectsLimitsOfShape_of_reflectsIsomorphisms
    exact Limits.preservesLimitsOfShape_of_reflects_of_preserves
      (SheafOfModules.pushforward.{u+1} φ) (SheafOfModules.toSheaf.{u+1} S)
  · haveI : Limits.PreservesColimitsOfShape I
        (SheafOfModules.pushforward.{u+1} φ ⋙ SheafOfModules.toSheaf.{u+1} S) :=
      Limits.preservesColimitsOfShape_of_natIso (F := SheafOfModules.toSheaf.{u+1} R ⋙
        G.sheafPushforwardContinuous AddCommGrpCat.{u+1} J K) (Iso.refl _)
    haveI : Limits.ReflectsColimitsOfShape I (SheafOfModules.toSheaf.{u+1} S) :=
      Limits.reflectsColimitsOfShape_of_reflectsIsomorphisms
    exact Limits.preservesColimitsOfShape_of_reflects_of_preserves
      (SheafOfModules.pushforward.{u+1} φ) (SheafOfModules.toSheaf.{u+1} S)

