    have h1 := hU _ hmem (hw.trans hv.symm)
    have h2 : U.ι (IsOpenImmersion.lift U.ι t₀ hsub
        (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField η)))) =
        t₀ (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField η))) :=
      (Scheme.Hom.comp_apply _ U.ι _).symm.trans
        (congrArg (fun f : Spec (.of (AlgebraicClosure (B.residueField η))) ⟶ Y =>
          f (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField η))))
          (IsOpenImmersion.lift_fac U.ι t₀ hsub))
    exact U.ι.isOpenEmbedding.isEmbedding.injective (h1.trans h2.symm)
  have s3 : ∃ (V : B.Etale) (t : Spec (.of (AlgebraicClosure (B.residueField η))) ⟶ V.left)
      (ht : t ≫ V.hom = wcEtGeomPt B η) (e : V ⟶ A₀.right), t ≫ e.left = A₀.hom.left ∧
      ∀ w : V.left, V.hom w = η → w = t (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField η))) := by
    haveI : Etale A₀.right.hom := A₀.right.prop
    obtain ⟨U, t, htU, hfib⟩ := shrink A₀.right.left A₀.right.hom A₀.hom.left (Over.w A₀.hom)
