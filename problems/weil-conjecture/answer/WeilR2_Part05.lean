  have key : ∀ (U'' : S.Etale) (c : U'' ⟶ U),
      (Θ.hom.hom.app (Opposite.op U'')).hom (((K.homology 1).obj.map (c ≫ d).op).hom s) =
      ((toSheafify (Scheme.smallEtaleTopology S) T.homology).app (Opposite.op U'')).hom
