    simp only [NatTrans.comp_app, AddCommGrpCat.hom_comp, AddMonoidHom.coe_comp,
      Function.comp_apply] at n2
    exact n2.symm.trans ((congrArg (fun w => (T.iCycles.app (Opposite.op U₃)).hom w) he).trans n1)

theorem wc_sheaf_restrict_resolution_exact : ∀ (X Y : Scheme.{u}) (m : ℕ) (I : InjectiveResolution ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))) (F : Y.Etale ⥤ X.Etale) [F.IsContinuous (Scheme.smallEtaleTopology Y) (Scheme.smallEtaleTopology X)] [F.IsCocontinuous (Scheme.smallEtaleTopology Y) (Scheme.smallEtaleTopology X)], ∃ (ι : (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))) ⟶ (F.sheafPushforwardContinuous AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology Y) (Scheme.smallEtaleTopology X)).obj (I.cocomplex.X 0)) (w₀ : ι ≫ (F.sheafPushforwardContinuous AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology Y) (Scheme.smallEtaleTopology X)).map (I.cocomplex.d 0 1) = 0) (w₁ : (F.sheafPushforwardContinuous AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology Y) (Scheme.smallEtaleTopology X)).map (I.cocomplex.d 0 1) ≫ (F.sheafPushforwardContinuous AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology Y) (Scheme.smallEtaleTopology X)).map (I.cocomplex.d 1 2) = 0), Mono ι ∧ (ShortComplex.mk ι _ w₀).Exact ∧ (ShortComplex.mk _ _ w₁).Exact :=
by
  intro X Y m I F _ _
  let R := F.sheafPushforwardContinuous AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology Y)
    (Scheme.smallEtaleTopology X)
  haveI : Limits.PreservesColimitsOfSize.{0, 0} R :=
    (F.sheafAdjunctionCocontinuous AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology Y)
      (Scheme.smallEtaleTopology X)).leftAdjoint_preservesColimits
  haveI : Limits.PreservesFiniteColimits R := Limits.PreservesColimitsOfSize.preservesFiniteColimits _
  let A := AddCommGrpCat.of (ULift.{u+1} (ZMod m))
  let η : (Functor.const (Y.Etale)ᵒᵖ).obj A ≅ F.op ⋙ (Functor.const (X.Etale)ᵒᵖ).obj A :=
    NatIso.ofComponents (fun _ => Iso.refl A) (by intros; simp)
  let c : (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
      (F.op ⋙ (Functor.const _).obj A) ≅
      R.obj ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj A) :=
    (F.pushforwardContinuousSheafificationCompatibility AddCommGrpCat.{u+1}
      (Scheme.smallEtaleTopology Y) (Scheme.smallEtaleTopology X)).app ((Functor.const _).obj A)
  let ε : (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj A ≅
      R.obj ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj A) :=
    (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).mapIso η ≪≫ c
  let σ := HomologicalComplex.singleObjXSelf (ComplexShape.up ℕ) 0
    ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj A)
  let κ := I.ι.f 0
  have hκd : κ ≫ I.cocomplex.d 0 1 = 0 := I.ι_f_zero_comp_complex_d
  let ι : (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj A ⟶
      R.obj (I.cocomplex.X 0) := ε.hom ≫ R.map (σ.inv ≫ κ)
  have w₀ : ι ≫ R.map (I.cocomplex.d 0 1) = 0 := by
    simp only [ι, Category.assoc, ← R.map_comp, hκd, Limits.comp_zero, R.map_zero]
  have w₁ : R.map (I.cocomplex.d 0 1) ≫ R.map (I.cocomplex.d 1 2) = 0 := by
    rw [← R.map_comp, HomologicalComplex.d_comp_d, R.map_zero]
  refine ⟨ι, w₀, w₁, ?_, ?_, ?_⟩
  · haveI : Mono κ := inferInstance
    haveI : Mono (R.map (σ.inv ≫ κ)) := inferInstance
    exact mono_comp _ _
  · have h0 := I.exact₀.map R
    refine ShortComplex.exact_of_iso ?_ h0
    refine ShortComplex.isoMk (R.mapIso σ ≪≫ ε.symm) (Iso.refl _) (Iso.refl _) ?_ ?_
    · simp only [ShortComplex.map_f, Iso.trans_hom, Functor.mapIso_hom, Iso.symm_hom,
        Iso.refl_hom, Category.comp_id, ι, Category.assoc, Iso.inv_hom_id_assoc]
      rw [← R.map_comp, Iso.hom_inv_id_assoc]
    · simp only [ShortComplex.map_g, Iso.refl_hom, Category.id_comp, Category.comp_id]
      rfl
  · exact (I.exact_succ 0).map R

theorem wc_et_cocycle_const_map : ∀ (Y : Scheme.{u}) (L₁ L₂ : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (δ₁ : L₁ ⟶ L₂) (z : L₁.obj.obj (Opposite.op (Scheme.Etale.mk (𝟙 Y)))), (δ₁.hom.app (Opposite.op (Scheme.Etale.mk (𝟙 Y)))).hom z = 0 → ∃ ζ : (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)) ⟶ L₁, ζ ≫ δ₁ = 0 ∧ ∀ (W : Y.Etale) (q : W ⟶ Scheme.Etale.mk (𝟙 Y)), (ζ.hom.app (Opposite.op W)).hom (wcConstSec Y (ULift.{u+1} ℤ) W (ULift.up 1)) = (L₁.obj.map q.op).hom z :=
by
  intro Y L₁ L₂ δ₁ z hz
  let bang : ∀ W : Y.Etale, W ⟶ Scheme.Etale.mk (𝟙 Y) := fun W =>
    MorphismProperty.Over.homMk W.hom (Category.comp_id _) trivial
  have huniq : ∀ (W : Y.Etale) (q : W ⟶ Scheme.Etale.mk (𝟙 Y)), q = bang W := by
    intro W q
    apply MorphismProperty.Over.Hom.ext
    have h := MorphismProperty.Over.w q
    exact (Category.comp_id _).symm.trans h
  let x : ∀ U : (Y.Etale)ᵒᵖ, L₁.obj.obj U := fun U => (L₁.obj.map (bang U.unop).op).hom z
  have hx : ∀ {U U' : (Y.Etale)ᵒᵖ} (f : U ⟶ U'), (L₁.obj.map f).hom (x U) = x U' := by
    intro U U' f
    have h1 := congrArg (fun φ => φ.hom z) (L₁.obj.map_comp (bang U.unop).op f)
    have h2 : (bang U.unop).op ≫ f = (bang U'.unop).op := by
      change (f.unop ≫ bang U.unop).op = (bang U'.unop).op
      rw [huniq _ (f.unop ≫ bang U.unop)]
    rw [h2] at h1
    exact h1.symm
  let η : (Functor.const (Y.Etale)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)) ⟶ L₁.obj :=
    { app := fun U => AddCommGrpCat.ofHom
        ((zmultiplesHom (L₁.obj.obj U) (x U)).comp AddEquiv.ulift.toAddMonoidHom)
      naturality := by
        intro U U' f
        apply AddCommGrpCat.ext
        intro n
        change (n.down) • x U' = (L₁.obj.map f).hom ((n.down) • x U)
        rw [map_zsmul, hx] }
  let ζ : (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} ℤ)) ⟶ L₁ :=
    ObjectProperty.homMk (sheafifyLift (Scheme.smallEtaleTopology Y) η L₁.property)
  have hK : toSheafify (Scheme.smallEtaleTopology Y)
      ((Functor.const (Y.Etale)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) ≫ ζ.hom = η :=
    toSheafify_sheafifyLift (Scheme.smallEtaleTopology Y) η L₁.property
  refine ⟨ζ, ?_, ?_⟩
  · apply Sheaf.hom_ext
    refine sheafify_hom_ext (Scheme.smallEtaleTopology Y)
      (P := (Functor.const (Y.Etale)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) _ _ L₂.property ?_
    have h0 : ((0 : (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ)) ⟶ L₂).hom) = 0 :=
      (sheafToPresheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map_zero _ _
    rw [h0]
    change toSheafify (Scheme.smallEtaleTopology Y)
      ((Functor.const (Y.Etale)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) ≫
        (sheafifyLift (Scheme.smallEtaleTopology Y) η L₁.property ≫ δ₁.hom) =
      toSheafify (Scheme.smallEtaleTopology Y)
      ((Functor.const (Y.Etale)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) ≫
        (0 : sheafify (Scheme.smallEtaleTopology Y)
          ((Functor.const (Y.Etale)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) ⟶ L₂.obj)
    rw [Limits.comp_zero, ← Category.assoc, toSheafify_sheafifyLift]
    apply NatTrans.ext
    funext U
    rw [NatTrans.app_zero]
    apply AddCommGrpCat.ext
    intro n
    have key : (δ₁.hom.app U).hom (x U) = 0 := by
      have h := congrArg (fun φ => φ.hom z) (δ₁.hom.naturality (bang U.unop).op)
      change (δ₁.hom.app U).hom (x U) = (L₂.obj.map (bang U.unop).op).hom
        ((δ₁.hom.app (Opposite.op (Scheme.Etale.mk (𝟙 Y)))).hom z) at h
      rw [h, hz, map_zero]
    change (δ₁.hom.app U).hom ((n.down) • x U) = 0
    rw [map_zsmul, key, zsmul_zero]
  · intro W q
    rw [huniq W q]
    have h := congrArg (fun φ => (φ.app (Opposite.op W)).hom (ULift.up (1 : ℤ))) hK
    change (ζ.hom.app (Opposite.op W)).hom (((toSheafify (Scheme.smallEtaleTopology Y)
      ((Functor.const (Y.Etale)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)))).app
        (Opposite.op W)).hom (ULift.up 1)) = (1 : ℤ) • x (Opposite.op W) at h
    exact h.trans (one_zsmul _)

theorem wc_sheaf_pullback_extension_sections : ∀ (Y : Scheme.{u}) (A Z L₀ L₁ L₂ : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (ι : A ⟶ L₀) (δ₀ : L₀ ⟶ L₁) (δ₁ : L₁ ⟶ L₂) (w₀ : ι ≫ δ₀ = 0) (w₁ : δ₀ ≫ δ₁ = 0), Mono ι → (ShortComplex.mk ι δ₀ w₀).Exact → (ShortComplex.mk δ₀ δ₁ w₁).Exact → ∀ (ζ : Z ⟶ L₁), ζ ≫ δ₁ = 0 → ∃ (E : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (f : A ⟶ E) (g : E ⟶ Z) (w : f ≫ g = 0), (ShortComplex.mk f g w).ShortExact ∧ ∀ (W : Y.Etale) (n : Z.obj.obj (Opposite.op W)), (∃ t : E.obj.obj (Opposite.op W), (g.hom.app (Opposite.op W)).hom t = n) ↔ (∃ e : L₀.obj.obj (Opposite.op W), (δ₀.hom.app (Opposite.op W)).hom e = (ζ.hom.app (Opposite.op W)).hom n) :=
by
  intro Y A Z L₀ L₁ L₂ ι δ₀ δ₁ w₀ w₁ hmono hex₀ hex₁ ζ hζ
  set δ₀' := Limits.kernel.lift δ₁ δ₀ w₁ with hδ₀'
  set ζ' := Limits.kernel.lift δ₁ ζ hζ with hζ'
  have ha : δ₀' ≫ Limits.kernel.ι δ₁ = δ₀ := Limits.kernel.lift_ι _ _ _
  have hb : ζ' ≫ Limits.kernel.ι δ₁ = ζ := Limits.kernel.lift_ι _ _ _
  have hι0 : ι ≫ δ₀' = 0 := by
    rw [← cancel_mono (Limits.kernel.ι δ₁), Category.assoc, ha, w₀, Limits.zero_comp]
  let f : A ⟶ Limits.pullback δ₀' ζ' :=
    Limits.pullback.lift ι 0 (by rw [hι0, Limits.zero_comp])
  have hf1 : f ≫ Limits.pullback.fst δ₀' ζ' = ι := Limits.pullback.lift_fst _ _ _
  have w : f ≫ Limits.pullback.snd δ₀' ζ' = 0 := Limits.pullback.lift_snd _ _ _
  have : Mono f := mono_of_mono_fac hf1
  have : Epi δ₀' := (ShortComplex.exact_iff_epi_kernel_lift _).mp hex₁
  have : Epi (Limits.pullback.snd δ₀' ζ') := Abelian.epi_pullback_of_epi_f δ₀' ζ'
  have hcond : Limits.pullback.fst δ₀' ζ' ≫ δ₀ = Limits.pullback.snd δ₀' ζ' ≫ ζ := by
    calc Limits.pullback.fst δ₀' ζ' ≫ δ₀
        = Limits.pullback.fst δ₀' ζ' ≫ δ₀' ≫ Limits.kernel.ι δ₁ := by rw [ha]
      _ = (Limits.pullback.fst δ₀' ζ' ≫ δ₀') ≫ Limits.kernel.ι δ₁ := (Category.assoc _ _ _).symm
      _ = (Limits.pullback.snd δ₀' ζ' ≫ ζ') ≫ Limits.kernel.ι δ₁ := by
          rw [Limits.pullback.condition]
      _ = Limits.pullback.snd δ₀' ζ' ≫ ζ := by rw [Category.assoc, hb]
  refine ⟨Limits.pullback δ₀' ζ', f, Limits.pullback.snd δ₀' ζ', w, ?_, ?_⟩
  · refine ShortComplex.ShortExact.mk' ?_ inferInstance inferInstance
    refine ShortComplex.exact_of_f_is_kernel _ (Limits.KernelFork.IsLimit.ofι' f w ?_)
    intro B k hk
    have hk0 : (k ≫ Limits.pullback.fst δ₀' ζ') ≫ δ₀ = 0 := by
      rw [Category.assoc, hcond, ← Category.assoc, hk, Limits.zero_comp]
    refine ⟨hex₀.lift (k ≫ Limits.pullback.fst δ₀' ζ') hk0, ?_⟩
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, hf1]
      exact hex₀.lift_f _ _
    · rw [Category.assoc, w, Limits.comp_zero, hk]
  · intro W n
    let ev := sheafToPresheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1} ⋙
      (evaluation (Y.Etale)ᵒᵖ AddCommGrpCat.{u+1}).obj (Opposite.op W) ⋙
        forget AddCommGrpCat.{u+1}
    constructor
    · rintro ⟨t, rfl⟩
      refine ⟨((Limits.pullback.fst δ₀' ζ').hom.app (Opposite.op W)).hom t, ?_⟩
      have h := congrArg (fun φ => (φ.hom.app (Opposite.op W)).hom t) hcond
      exact h
    · rintro ⟨e, he⟩
      have hinj : Function.Injective ((Limits.kernel.ι δ₁).hom.app (Opposite.op W)).hom := by
        have hm : Mono (ev.map (Limits.kernel.ι δ₁)) := inferInstance
        exact (mono_iff_injective _).mp hm
      have h1 : ((δ₀' ≫ Limits.kernel.ι δ₁).hom.app (Opposite.op W)).hom e =
          (δ₀.hom.app (Opposite.op W)).hom e := by rw [ha]
      have h2 : ((ζ' ≫ Limits.kernel.ι δ₁).hom.app (Opposite.op W)).hom n =
          (ζ.hom.app (Opposite.op W)).hom n := by rw [hb]
      have he' : (δ₀'.hom.app (Opposite.op W)).hom e = (ζ'.hom.app (Opposite.op W)).hom n :=
        hinj (h1.trans (he.trans h2.symm))
      have hc := Limits.isLimitPullbackConeMapOfIsLimit ev Limits.pullback.condition
        (Limits.pullbackIsPullback δ₀' ζ')
      refine ⟨(Limits.PullbackCone.IsLimit.equivPullbackObj hc).symm ⟨(e, n), he'⟩, ?_⟩
      exact Limits.PullbackCone.IsLimit.equivPullbackObj_symm_apply_snd hc _

theorem wc_et_ses_split_torsor_sections : ∀ (Y : Scheme.{u}) (m : ℕ), m ≠ 0 → ∀ (E : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (f : (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))) ⟶ E) (g : E ⟶ (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) (w : f ≫ g = 0), (ShortComplex.mk f g w).ShortExact → ∃ (P : Scheme.{u}) (p : P ⟶ Y) (a : ZMod m → (P ⟶ P)), wcFetTorsor p m a ∧ ∀ (W : Y.Etale), (∃ σ : W.left ⟶ P, σ ≫ p = W.hom) ↔ (∃ t : E.obj.obj (Opposite.op W), (g.hom.app (Opposite.op W)).hom t = wcConstSec Y (ULift.{u+1} ℤ) W (ULift.up 1)) :=
by
  intro Y m hm E f g w hSES

  have hconst : ∀ (A : Type (u+1)) [AddCommGroup A] (U W : Y.Etale) (h : W ⟶ U) (x : A),
      (((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of A)).obj.map h.op).hom (wcConstSec Y A U x) = wcConstSec Y A W x := by
    intro A _ U W h x
    unfold wcConstSec
    have := congrArg (fun φ => φ.hom x) ((toSheafify (Scheme.smallEtaleTopology Y)
      ((Functor.const (Y.Etale)ᵒᵖ).obj (AddCommGrpCat.of A))).naturality h.op)
    exact this.symm
  have gnat : ∀ {A B : Y.Etale} (k : A ⟶ B) (x : E.obj.obj (Opposite.op B)),
      (g.hom.app (Opposite.op A)).hom ((E.obj.map k.op).hom x) =
        (((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} ℤ))).obj.map k.op).hom
            ((g.hom.app (Opposite.op B)).hom x) :=
    fun k x => congrArg (fun φ => φ.hom x) (g.hom.naturality k.op)
  have fnat : ∀ {A B : Y.Etale} (k : A ⟶ B)
      (x : ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))).obj.obj (Opposite.op B)),
      (E.obj.map k.op).hom ((f.hom.app (Opposite.op B)).hom x) =
        (f.hom.app (Opposite.op A)).hom
          ((((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
            (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))).obj.map k.op).hom x) :=
    fun k x => (congrArg (fun φ => φ.hom x) (f.hom.naturality k.op)).symm
  have comp_apply : ∀ {A B C : Y.Etale} (k : A ⟶ B) (l : B ⟶ C) (x : E.obj.obj (Opposite.op C)),
      (E.obj.map k.op).hom ((E.obj.map l.op).hom x) = (E.obj.map (k ≫ l).op).hom x :=
    fun k l x => (congrArg (fun φ => φ.hom x) (E.obj.map_comp l.op k.op)).symm
  obtain ⟨P, p, a, ht, s₀, hs₀⟩ := wc_et_ses_torsor_representable Y m hm E f g w hSES
  obtain ⟨hs1, hs2⟩ := hs₀
  refine ⟨P, p, a, ht, fun W => ?_⟩
  constructor
  · rintro ⟨σ, hσ⟩
    let ψ : W ⟶ wcTorsorEt p ht.etale := MorphismProperty.Over.homMk σ hσ trivial
    refine ⟨(E.obj.map ψ.op).hom s₀, ?_⟩
    rw [gnat, hs1]
    exact hconst _ _ _ ψ _
  · rintro ⟨t, htW⟩
    have ht' : wcFetTorsor (p ≫ Y.topIso.inv) m a := by
      have := wc_tar_fet_transport p m a Y.topIso.symm ht
      rwa [Iso.symm_hom] at this
    have hp : (p ≫ Y.topIso.inv) ≫ (⊤ : Y.Opens).ι = p := by
      rw [← Scheme.topIso_hom, Category.assoc, Iso.inv_hom_id, Category.comp_id]
    have hE : Etale ((p ≫ Y.topIso.inv) ≫ (⊤ : Y.Opens).ι) := by
      rw [hp]; exact ht.etale
    let κ : wcTorsorEt ((p ≫ Y.topIso.inv) ≫ (⊤ : Y.Opens).ι) hE ⟶ wcTorsorEt p ht.etale :=
      MorphismProperty.Over.homMk (𝟙 P) ((Category.id_comp p).trans hp.symm) trivial
    have hrel : wcTorLocRel f g ⊤ ht' hE ((E.obj.map κ.op).hom s₀) := by
      refine ⟨?_, fun c => ?_⟩
      · rw [gnat, hs1]
        exact hconst _ _ _ κ _
      · have hcomm : wcTorsorAct _ hE (a c) (by rw [← Category.assoc, ht'.act_p c]) ≫ κ =
            κ ≫ wcTorsorAct p ht.etale (a c) (ht.act_p c) := by
          apply MorphismProperty.Over.Hom.ext
          change a c ≫ 𝟙 P = 𝟙 P ≫ a c
          rw [Category.comp_id, Category.id_comp]
        show (E.obj.map (wcTorsorAct _ hE (a c)
            (by rw [← Category.assoc, ht'.act_p c])).op).hom ((E.obj.map κ.op).hom s₀) =
          (E.obj.map κ.op).hom s₀ + _
        rw [comp_apply, hcomm, ← comp_apply, hs2 c, map_add, fnat]
        exact congrArg (fun y => (E.obj.map κ.op).hom s₀ +
          (f.hom.app (Opposite.op (wcTorsorEt ((p ≫ Y.topIso.inv) ≫ (⊤ : Y.Opens).ι) hE))).hom y)
          (hconst _ _ _ κ (ULift.up c))
    obtain ⟨k, ⟨φ, hφk, -⟩, -⟩ := wc_fet_split_universal Y m hm E f g w hSES ⊤ P
      (p ≫ Y.topIso.inv) a ht' hE ((E.obj.map κ.op).hom s₀) hrel W (by simp) t htW
    refine ⟨k, ?_⟩
    rw [← hφk]
    exact (congrArg (φ.left ≫ ·) hp.symm).trans (MorphismProperty.Over.w φ)

theorem wc_et_cocycle_primitive_torsor : ∀ (X : Scheme.{u}) (m : ℕ), m ≠ 0 → ∀ (I : InjectiveResolution ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))) (T : X.Etale) (z : (I.cocomplex.X 1).obj.obj (Opposite.op T)), ((I.cocomplex.d 1 2).hom.app (Opposite.op T)).hom z = 0 → ∃ (P : Scheme.{u}) (p : P ⟶ T.left) (a : ZMod m → (P ⟶ P)), wcFetTorsor p m a ∧ ∀ (T' : X.Etale) (h : T' ⟶ T), (∃ e : (I.cocomplex.X 0).obj.obj (Opposite.op T'), ((I.cocomplex.d 0 1).hom.app (Opposite.op T')).hom e = ((I.cocomplex.X 1).obj.map h.op).hom z) ↔ (∃ σ : T'.left ⟶ P, σ ≫ p = h.left) :=
by
  intro X m hm I T z hz
  obtain ⟨hcont, hcocont⟩ := wc_et_slice_continuous T
  haveI := hcont
  haveI := hcocont

  obtain ⟨ι, w₀, w₁, hmono, hex₀, hex₁⟩ :=
    wc_sheaf_restrict_resolution_exact X T.left m I (wcEtSlice T)

  let θ : (wcEtSlice T).obj (Scheme.Etale.mk (𝟙 T.left)) ⟶ T :=
    MorphismProperty.Over.homMk (𝟙 T.left) (Category.id_comp _) trivial
  let zbar : (((wcEtSlice T).sheafPushforwardContinuous AddCommGrpCat.{u+1}
      (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology X)).obj
        (I.cocomplex.X 1)).obj.obj (Opposite.op (Scheme.Etale.mk (𝟙 T.left))) :=
    ((I.cocomplex.X 1).obj.map θ.op).hom z
  have hzbar : ((((wcEtSlice T).sheafPushforwardContinuous AddCommGrpCat.{u+1}
      (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology X)).map
        (I.cocomplex.d 1 2)).hom.app (Opposite.op (Scheme.Etale.mk (𝟙 T.left)))).hom zbar = 0 := by
    have key : ((I.cocomplex.d 1 2).hom.app
        (Opposite.op ((wcEtSlice T).obj (Scheme.Etale.mk (𝟙 T.left))))).hom
          (((I.cocomplex.X 1).obj.map θ.op).hom z) =
        ((I.cocomplex.X 2).obj.map θ.op).hom (((I.cocomplex.d 1 2).hom.app (Opposite.op T)).hom z) :=
      congrArg (fun φ => φ.hom z) ((I.cocomplex.d 1 2).hom.naturality θ.op)
    rw [hz, map_zero] at key
    exact key

  obtain ⟨ζ, hζ0, hζv⟩ := wc_et_cocycle_const_map T.left _ _
    (((wcEtSlice T).sheafPushforwardContinuous AddCommGrpCat.{u+1}
      (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology X)).map (I.cocomplex.d 1 2))
    zbar hzbar

  obtain ⟨E, f, g, w, hSES, hsec⟩ := wc_sheaf_pullback_extension_sections T.left _ _ _ _ _
    ι _ _ w₀ w₁ hmono hex₀ hex₁ ζ hζ0

  obtain ⟨P, p, a, ht, htor⟩ := wc_et_ses_split_torsor_sections T.left m hm E f g w hSES
  refine ⟨P, p, a, ht, fun T' h => ?_⟩

  haveI hEt : Etale h.left := MorphismProperty.of_postcomp @Etale (W' := @Etale) h.left T.hom
    T.prop ((MorphismProperty.Over.w h).symm ▸ T'.prop)
  let W : T.left.Etale := Scheme.Etale.mk h.left
  let bang : W ⟶ Scheme.Etale.mk (𝟙 T.left) :=
    MorphismProperty.Over.homMk h.left (Category.comp_id _) trivial
  have h2 : (∃ σ : T'.left ⟶ P, σ ≫ p = h.left) ↔
      ∃ e : (((wcEtSlice T).sheafPushforwardContinuous AddCommGrpCat.{u+1}
        (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology X)).obj
          (I.cocomplex.X 0)).obj.obj (Opposite.op W),
        ((((wcEtSlice T).sheafPushforwardContinuous AddCommGrpCat.{u+1}
          (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology X)).map
            (I.cocomplex.d 0 1)).hom.app (Opposite.op W)).hom e =
        ((((wcEtSlice T).sheafPushforwardContinuous AddCommGrpCat.{u+1}
          (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology X)).obj
            (I.cocomplex.X 1)).obj.map bang.op).hom zbar := by
    rw [← hζv W bang]
    exact (htor W).trans (hsec W _)
  rw [h2]

  let lam : T' ⟶ (wcEtSlice T).obj W :=
    MorphismProperty.Over.homMk (𝟙 T'.left)
      ((Category.id_comp _).trans (MorphismProperty.Over.w h)) trivial
  let lam' : (wcEtSlice T).obj W ⟶ T' :=
    MorphismProperty.Over.homMk (𝟙 T'.left)
      ((Category.id_comp _).trans (MorphismProperty.Over.w h).symm) trivial
  have hlam' : lam' ≫ h = (wcEtSlice T).map bang ≫ θ := by
    apply MorphismProperty.Over.Hom.ext
    change 𝟙 T'.left ≫ h.left = h.left ≫ 𝟙 T.left
    rw [Category.id_comp, Category.comp_id]
  have hlam : lam ≫ (wcEtSlice T).map bang ≫ θ = h := by
    apply MorphismProperty.Over.Hom.ext
    change 𝟙 T'.left ≫ h.left ≫ 𝟙 T.left = h.left
    rw [Category.id_comp, Category.comp_id]
  have comp2 : ∀ {A B C : X.Etale} (k : A ⟶ B) (l : B ⟶ C)
      (x : (I.cocomplex.X 1).obj.obj (Opposite.op C)),
      ((I.cocomplex.X 1).obj.map k.op).hom (((I.cocomplex.X 1).obj.map l.op).hom x) =
        ((I.cocomplex.X 1).obj.map (k ≫ l).op).hom x := fun k l x =>
    (congrArg (fun φ => φ.hom x) ((I.cocomplex.X 1).obj.map_comp l.op k.op)).symm
  have hnat : ∀ {A B : X.Etale} (k : A ⟶ B) (x : (I.cocomplex.X 0).obj.obj (Opposite.op B)),
      ((I.cocomplex.d 0 1).hom.app (Opposite.op A)).hom (((I.cocomplex.X 0).obj.map k.op).hom x) =
        ((I.cocomplex.X 1).obj.map k.op).hom (((I.cocomplex.d 0 1).hom.app (Opposite.op B)).hom x) :=
    fun k x => congrArg (fun φ => φ.hom x) ((I.cocomplex.d 0 1).hom.naturality k.op)
  constructor
  · rintro ⟨e', he'⟩
    refine ⟨((I.cocomplex.X 0).obj.map lam'.op).hom e', ?_⟩
    change ((I.cocomplex.d 0 1).hom.app (Opposite.op ((wcEtSlice T).obj W))).hom
        (((I.cocomplex.X 0).obj.map lam'.op).hom e') =
      ((I.cocomplex.X 1).obj.map ((wcEtSlice T).map bang).op).hom
        (((I.cocomplex.X 1).obj.map θ.op).hom z)
    rw [hnat, he', comp2, comp2, hlam']
  · rintro ⟨e, he⟩
    change ((I.cocomplex.d 0 1).hom.app (Opposite.op ((wcEtSlice T).obj W))).hom e =
      ((I.cocomplex.X 1).obj.map ((wcEtSlice T).map bang).op).hom
        (((I.cocomplex.X 1).obj.map θ.op).hom z) at he
    refine ⟨((I.cocomplex.X 0).obj.map lam.op).hom e, ?_⟩
    refine (hnat lam e).trans ?_
    rw [he, comp2, comp2, Category.assoc, hlam]

theorem wc_et_R1_local_torsor_rep : ∀ (S X : Scheme.{u}) (g : X ⟶ S) (m : ℕ), m ≠ 0 → ∀ (I : InjectiveResolution ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))) (V : S.Etale) (s : ((((wcEtPush g).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology 1).obj.obj (Opposite.op V)) (v : V.left), ∃ (U : S.Etale) (d : U ⟶ V) (u : U.left) (P : Scheme.{u}) (p : P ⟶ Limits.pullback g U.hom) (a : ZMod m → (P ⟶ P)), d.left u = v ∧ wcFetTorsor p m a ∧ ∀ (U' : S.Etale) (c : U' ⟶ U) (u' : U'.left), (∃ (U'' : S.Etale) (c' : U'' ⟶ U') (u'' : U''.left), c'.left u'' = u' ∧ (((((wcEtPush g).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology 1).obj.map (c' ≫ c ≫ d).op).hom s = 0) ↔ (∃ (U'' : S.Etale) (c' : U'' ⟶ U') (u'' : U''.left) (σ : Limits.pullback g U''.hom ⟶ P), c'.left u'' = u' ∧ σ ≫ p ≫ Limits.pullback.fst g U.hom = Limits.pullback.fst g U''.hom ∧ σ ≫ p ≫ Limits.pullback.snd g U.hom = Limits.pullback.snd g U''.hom ≫ (c' ≫ c).left) :=
by
  intro S X g m hm I V s v

  have fwd : ∀ (A₁ A : Scheme.{u}) (h₁ : A₁ ⟶ S) (h : A ⟶ S) (k : A₁ ⟶ A)
      (P : Scheme.{u}) (q : P ⟶ Limits.pullback h g) (σ₀ : Limits.pullback h₁ g ⟶ P)
      (L : Limits.pullback h₁ g ⟶ Limits.pullback h g), σ₀ ≫ q = L →
      L ≫ Limits.pullback.snd h g = Limits.pullback.snd h₁ g →
      L ≫ Limits.pullback.fst h g = Limits.pullback.fst h₁ g ≫ k →
      ((Limits.pullbackSymmetry g h₁).hom ≫ σ₀) ≫ (q ≫ (Limits.pullbackSymmetry h g).hom) ≫
          Limits.pullback.fst g h = Limits.pullback.fst g h₁ ∧
      ((Limits.pullbackSymmetry g h₁).hom ≫ σ₀) ≫ (q ≫ (Limits.pullbackSymmetry h g).hom) ≫
          Limits.pullback.snd g h = Limits.pullback.snd g h₁ ≫ k := by
    intro A₁ A h₁ h k P q σ₀ L hL h1 h2
    have k1 : σ₀ ≫ q ≫ Limits.pullback.snd h g = Limits.pullback.snd h₁ g := by
      rw [← Category.assoc, hL, h1]
    have k2 : σ₀ ≫ q ≫ Limits.pullback.fst h g = Limits.pullback.fst h₁ g ≫ k := by
      rw [← Category.assoc, hL, h2]
    constructor
    · simp only [Category.assoc, Limits.pullbackSymmetry_hom_comp_fst]
      rw [k1, Limits.pullbackSymmetry_hom_comp_snd]
    · simp only [Category.assoc, Limits.pullbackSymmetry_hom_comp_snd]
      rw [k2, Limits.pullbackSymmetry_hom_comp_fst_assoc]
  have bwd : ∀ (A₁ A : Scheme.{u}) (h₁ : A₁ ⟶ S) (h : A ⟶ S) (k : A₁ ⟶ A)
      (P : Scheme.{u}) (q : P ⟶ Limits.pullback h g) (σ : Limits.pullback g h₁ ⟶ P)
      (L : Limits.pullback h₁ g ⟶ Limits.pullback h g),
      L ≫ Limits.pullback.snd h g = Limits.pullback.snd h₁ g →
      L ≫ Limits.pullback.fst h g = Limits.pullback.fst h₁ g ≫ k →
      σ ≫ (q ≫ (Limits.pullbackSymmetry h g).hom) ≫ Limits.pullback.fst g h =
        Limits.pullback.fst g h₁ →
      σ ≫ (q ≫ (Limits.pullbackSymmetry h g).hom) ≫ Limits.pullback.snd g h =
        Limits.pullback.snd g h₁ ≫ k →
      ((Limits.pullbackSymmetry g h₁).inv ≫ σ) ≫ q = L := by
    intro A₁ A h₁ h k P q σ L h1 h2 hσ1 hσ2
    simp only [Category.assoc, Limits.pullbackSymmetry_hom_comp_fst,
      Limits.pullbackSymmetry_hom_comp_snd] at hσ1 hσ2
    apply Limits.pullback.hom_ext
    · rw [h2, Category.assoc, Category.assoc, hσ2, Limits.pullbackSymmetry_inv_comp_snd_assoc]
    · rw [h1, Category.assoc, Category.assoc, hσ1, Limits.pullbackSymmetry_inv_comp_fst]

  have hsnd : ∀ {A B : S.Etale} (f : A ⟶ B),
      ((wcEtBaseChange g).map f).left ≫ Limits.pullback.snd B.hom g = Limits.pullback.snd A.hom g :=
    fun f => MorphismProperty.Over.w ((wcEtBaseChange g).map f)
  have hfst : ∀ {A B : S.Etale} (f : A ⟶ B),
      ((wcEtBaseChange g).map f).left ≫ Limits.pullback.fst B.hom g =
        Limits.pullback.fst A.hom g ≫ f.left :=
    fun f => Limits.pullback.lift_fst _ _ _

  obtain ⟨U, d, u, z, hdu, hz, hi, hii⟩ := wc_et_push_h1_local_cocycle g I.cocomplex V s v

  obtain ⟨P, p₀, a, ht₀, hB⟩ :=
    wc_et_cocycle_primitive_torsor X m hm I ((wcEtBaseChange g).obj U) z hz

  refine ⟨U, d, u, P, p₀ ≫ (Limits.pullbackSymmetry U.hom g).hom, a, hdu,
    wc_tar_fet_transport p₀ m a (Limits.pullbackSymmetry U.hom g) ht₀, ?_⟩
  intro U' c u'
  constructor
  · rintro ⟨U'', c', u'', hc', hs⟩
    have hs' : (((((wcEtPush g).mapHomologicalComplex (ComplexShape.up ℕ)).obj
        I.cocomplex).homology 1).obj.map ((c' ≫ c) ≫ d).op).hom s = 0 := by
      rw [Category.assoc]; exact hs
    obtain ⟨U₃, c₃, u₃, e, hc₃, he⟩ := hii U'' (c' ≫ c) hs' u''
    have he' : ((I.cocomplex.d 0 1).hom.app (Opposite.op ((wcEtBaseChange g).obj U₃))).hom e =
        ((I.cocomplex.X 1).obj.map ((wcEtBaseChange g).map ((c₃ ≫ c') ≫ c)).op).hom z := by
      rw [Category.assoc]; exact he
    obtain ⟨σ₀, hσ₀⟩ := (hB ((wcEtBaseChange g).obj U₃)
      ((wcEtBaseChange g).map ((c₃ ≫ c') ≫ c))).mp ⟨e, he'⟩
    obtain ⟨h1, h2⟩ := fwd _ _ U₃.hom U.hom ((c₃ ≫ c') ≫ c).left P p₀ σ₀ _ hσ₀
      (hsnd _) (hfst _)
    refine ⟨U₃, c₃ ≫ c', u₃, (Limits.pullbackSymmetry g U₃.hom).hom ≫ σ₀, ?_, h1, h2⟩
    show (c₃.left ≫ c'.left) u₃ = u'
    rw [Scheme.Hom.comp_apply, hc₃, hc']
  · rintro ⟨U'', c', u'', σ, hc', hσ1, hσ2⟩
    have hσ₀ := bwd _ _ U''.hom U.hom (c' ≫ c).left P p₀ σ _ (hsnd (c' ≫ c)) (hfst (c' ≫ c))
      hσ1 hσ2
    obtain ⟨e, he⟩ := (hB ((wcEtBaseChange g).obj U'')
      ((wcEtBaseChange g).map (c' ≫ c))).mpr ⟨_, hσ₀⟩
    have h0 := hi U'' (c' ≫ c) e he
    refine ⟨U'', c', u'', hc', ?_⟩
    rw [Category.assoc] at h0
    exact h0

theorem wc_shens_geom_point_over_generalization : ∀ {B : Scheme.{u}} (b b' : B), b' ⤳ b → ∀ (A : Type u) [CommRing A] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B)) (φ : ∀ l, Spec (.of A) ⟶ (W'.obj l).right.left) (a : Spec (.of A) ⟶ B), (∀ l, IsAffine (W'.obj l).right.left) → (∀ {l l' : Λ} (t : l ⟶ l'), φ l ≫ (W'.map t).right.left = φ l') → (∀ l, φ l ≫ (W'.obj l).right.hom = a) → (∀ (T : Scheme.{u}) (z : ∀ l, T ⟶ (W'.obj l).right.left), (∀ {l l' : Λ} (t : l ⟶ l'), z l ≫ (W'.map t).right.left = z l') → ∃! z₀ : T ⟶ Spec (.of A), ∀ l, z₀ ≫ φ l = z l) → ∃ ξ : Spec (.of (AlgebraicClosure (B.residueField b'))) ⟶ Spec (.of A), ξ ≫ a = wcEtGeomPt B b' :=
by
  intro B b b' hsp A _ Λ _ _ W' φ a hAff hφ ha hUniv
  classical

  have hcpt : ∀ (K : Type u) [Field K] {V X : Scheme.{u}} (g : V ⟶ X) [CompactSpace V]
      (s : Spec (.of K) ⟶ X), CompactSpace ↥(Limits.pullback g s) := by
    intro K _ V X g _ s
    exact QuasiCompact.compactSpace_of_compactSpace (Limits.pullback.fst g s)

  have s1 : ∀ (K : Type u) [Field K] {E : Scheme.{u}} (q : E ⟶ Spec (.of K)) [Etale q]
      [CompactSpace E], Finite E := by
    intro K _ E q _ _
    haveI : LocallyQuasiFinite q := by
      refine ⟨fun {U'} hU' {V'} hV' e => ?_⟩
      have h := q.etale_appLE hU' hV' e
      letI := (q.appLE U' V' e).hom.toAlgebra
      haveI : Algebra.Etale Γ(Spec (.of K), U') Γ(E, V') := h
      exact (inferInstance : Algebra.QuasiFinite Γ(Spec (.of K), U') Γ(E, V'))
    haveI : QuasiCompact q := quasiCompact_of_compactSpace q
    obtain ⟨p₀⟩ : Nonempty (Spec (.of K)) := inferInstance
    have h1 := q.finite_preimage_singleton p₀
    have h2 : q ⁻¹' {p₀} = Set.univ := by
      ext z
      simp only [Set.mem_preimage, Set.mem_singleton_iff, Set.mem_univ, iff_true]
      exact Subsingleton.elim _ _
    rw [h2] at h1
    exact Set.finite_univ_iff.mp h1

  have s2 : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y) [Etale f] (x : X),
      letI := (f.residueFieldMap x).hom.toAlgebra
      Module.Finite (Y.residueField (f x)) (X.residueField x) := by
    intro X Y f _ x
    try dsimp only
    letI := (f.residueFieldMap x).hom.toAlgebra
    letI : Algebra (Y.presheaf.stalk (f x)) (X.presheaf.stalk x) := (f.stalkMap x).hom.toAlgebra
    have : IsLocalHom (algebraMap (Y.presheaf.stalk (f x)) (X.presheaf.stalk x)) :=
      inferInstanceAs <| IsLocalHom (f.stalkMap x).hom
    have : Algebra.EssFiniteType (Y.presheaf.stalk (f x)) (X.presheaf.stalk x) := by
      rw [← RingHom.essFiniteType_algebraMap, RingHom.algebraMap_toAlgebra]
      exact LocallyOfFiniteType.stalkMap f x
    have : Algebra.FormallyUnramified (Y.presheaf.stalk (f x)) (X.presheaf.stalk x) := by
      rw [← RingHom.formallyUnramified_algebraMap, RingHom.algebraMap_toAlgebra]
      exact FormallyUnramified.stalkMap f x
    have hfin : Module.Finite (IsLocalRing.ResidueField (Y.presheaf.stalk (f x)))
        (IsLocalRing.ResidueField (X.presheaf.stalk x)) := inferInstance
    refine Module.Finite.of_equiv_equiv
      (RingEquiv.refl (IsLocalRing.ResidueField (Y.presheaf.stalk (f x))))
      (RingEquiv.refl (IsLocalRing.ResidueField (X.presheaf.stalk x))) ?_
    refine RingHom.ext fun a => ?_
    obtain ⟨a, rfl⟩ := IsLocalRing.residue_surjective a
    rfl

  have s3 : ∀ (K : Type u) [Field K] {E : Scheme.{u}} (q : E ⟶ Spec (.of K)), Finite E →
      (∀ e : E, letI := (q.residueFieldMap e).hom.toAlgebra
        Module.Finite ((Spec (.of K)).residueField (q e)) (E.residueField e)) →
      Finite {σ : Spec (.of K) ⟶ E // σ ≫ q = 𝟙 _} := by
    intro K _ E q hE hfin
    haveI := hE
    have key : ∀ σ : {σ : Spec (.of K) ⟶ E // σ ≫ q = 𝟙 _},
        (Scheme.SpecToEquivOfField K (Spec (.of K))).symm
          ⟨q (Scheme.SpecToEquivOfField K E σ.1).1,
            q.residueFieldMap (Scheme.SpecToEquivOfField K E σ.1).1 ≫
              (Scheme.SpecToEquivOfField K E σ.1).2⟩ = 𝟙 _ := by
      intro σ
      have hσ : Spec.map (Scheme.SpecToEquivOfField K E σ.1).2 ≫
          E.fromSpecResidueField (Scheme.SpecToEquivOfField K E σ.1).1 = σ.1 := by
        rw [← Scheme.SpecToEquivOfField_symm_apply, Equiv.symm_apply_apply]
      rw [Scheme.SpecToEquivOfField_symm_apply]
      dsimp only
      rw [Spec.map_comp, Category.assoc,
        Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField, ← Category.assoc, hσ, σ.2]
    let Fib : E → Type u := fun e => {χ : E.residueField e ⟶ CommRingCat.of K //
      (Scheme.SpecToEquivOfField K (Spec (.of K))).symm ⟨q e, q.residueFieldMap e ≫ χ⟩ = 𝟙 _}
    have hfib : ∀ e, Finite (Fib e) := by
      intro e
      by_cases hne : Nonempty (Fib e)
      · obtain ⟨χ₀, hχ₀⟩ := hne
        have hθ : ∀ χ : Fib e, q.residueFieldMap e ≫ χ.1 = q.residueFieldMap e ≫ χ₀ := by
          intro χ
          have hh := (Scheme.SpecToEquivOfField K (Spec (.of K))).symm.injective
            (Eq.trans χ.2 hχ₀.symm)
          exact eq_of_heq (Sigma.mk.inj hh).2
        letI := (q.residueFieldMap e).hom.toAlgebra
        haveI : Module.Finite ((Spec (.of K)).residueField (q e)) (E.residueField e) := hfin e
        letI : Algebra ((Spec (.of K)).residueField (q e)) K :=
          (q.residueFieldMap e ≫ χ₀).hom.toAlgebra
        let G : Fib e → (E.residueField e →ₐ[(Spec (.of K)).residueField (q e)] K) := fun χ =>
          { toRingHom := χ.1.hom
            commutes' := fun r => congrArg
              (fun f : (Spec (.of K)).residueField (q e) ⟶ CommRingCat.of K => f.hom r) (hθ χ) }
        refine Finite.of_injective G ?_
        intro χ χ' h
        apply Subtype.ext
        apply CommRingCat.hom_ext
        exact congrArg AlgHom.toRingHom h
      · haveI : IsEmpty (Fib e) := not_nonempty_iff.mp hne
        infer_instance
    haveI := hfib
    let F : {σ : Spec (.of K) ⟶ E // σ ≫ q = 𝟙 _} → Σ e, Fib e := fun σ =>
      ⟨(Scheme.SpecToEquivOfField K E σ.1).1, (Scheme.SpecToEquivOfField K E σ.1).2, key σ⟩
    refine Finite.of_injective F ?_
    intro σ τ h
    apply Subtype.ext
    apply (Scheme.SpecToEquivOfField K E).injective
    have h1 := congrArg (fun x : (Σ e, Fib e) =>
      (⟨x.1, x.2.1⟩ : Σ e : E, (E.residueField e ⟶ CommRingCat.of K))) h
    exact h1

  have hgp : ∀ y : B, (wcEtGeomPt B y)
      (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField y))) = y := fun y =>
    (Scheme.Hom.comp_apply _ (B.fromSpecResidueField y) _).trans
      (Scheme.fromSpecResidueField_apply y _)

  have hlift : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] {V U : Scheme.{u}} (g : V ⟶ U) [Etale g]
      (s : Spec (.of Ω) ⟶ U) (v : V), g v = s (IsLocalRing.closedPoint Ω) →
      ∃ t : Spec (.of Ω) ⟶ V, t ≫ g = s := by
    intro Ω _ _ V U g _ s v hv
    have hs : s = Spec.map (Scheme.SpecToEquivOfField Ω U s).2 ≫
        U.fromSpecResidueField (Scheme.SpecToEquivOfField Ω U s).1 := by
      rw [← Scheme.SpecToEquivOfField_symm_apply, Equiv.symm_apply_apply]
    have h1 : (Scheme.SpecToEquivOfField Ω U s).1 = s (IsLocalRing.closedPoint Ω) := rfl
    generalize Scheme.SpecToEquivOfField Ω U s = p at hs h1
    obtain ⟨u, φ⟩ := p
    simp only at hs h1
    rw [← h1] at hv
    subst hv
    letI : Algebra (U.residueField (g v)) (V.residueField v) := (g.residueFieldMap v).hom.toAlgebra
    haveI : Algebra.IsSeparable (U.residueField (g v)) (V.residueField v) := inferInstance
    haveI : Algebra.IsAlgebraic (U.residueField (g v)) (V.residueField v) :=
      Algebra.IsSeparable.isAlgebraic _ _
    letI : Algebra (U.residueField (g v)) Ω := φ.hom.toAlgebra
    let χ₀ : V.residueField v →ₐ[U.residueField (g v)] Ω :=
      IsAlgClosed.lift (R := U.residueField (g v)) (S := V.residueField v) (M := Ω)
    let χ : V.residueField v ⟶ CommRingCat.of Ω := CommRingCat.ofHom χ₀.toRingHom
    have hχ : g.residueFieldMap v ≫ χ = φ := by
      ext r
      exact χ₀.commutes r
    refine ⟨Spec.map χ ≫ V.fromSpecResidueField v, ?_⟩
    rw [Category.assoc, ← Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField,
      ← Category.assoc, ← Spec.map_comp, hχ, hs]

  have hneG : ∀ {V : Scheme.{u}} (g : V ⟶ B) [Etale g] (v : V), g v = b →
      Nonempty {t : Spec (.of (AlgebraicClosure (B.residueField b'))) ⟶ V //
        t ≫ g = wcEtGeomPt B b'} := by
    intro V g _ v hv
    have hsp' : b' ⤳ g v := by rw [hv]; exact hsp
    obtain ⟨x, -, hx⟩ := Flat.generalizingMap g hsp'
    obtain ⟨t, ht⟩ := hlift (AlgebraicClosure (B.residueField b')) g (wcEtGeomPt B b') x
      (by rw [hx, hgp])
    exact ⟨⟨t, ht⟩⟩

  have hfinG : ∀ (K : Type u) [Field K] {V : Scheme.{u}} (g : V ⟶ B) [Etale g] [CompactSpace V]
      (s : Spec (.of K) ⟶ B), Finite {t : Spec (.of K) ⟶ V // t ≫ g = s} := by
    intro K _ V g _ _ s
    haveI : CompactSpace ↥(Limits.pullback g s) := hcpt K g s
    have hE := s1 _ (Limits.pullback.snd g s)
    haveI hS := s3 _ (Limits.pullback.snd g s) hE
      (fun e => s2 (Limits.pullback.snd g s) e)
    let ι : {t : Spec (.of K) ⟶ V // t ≫ g = s} → {σ : Spec (.of K) ⟶
        Limits.pullback g s // σ ≫ Limits.pullback.snd g s = 𝟙 _} :=
      fun t => ⟨Limits.pullback.lift t.1 (𝟙 _) (by rw [t.2, Category.id_comp]),
        Limits.pullback.lift_snd _ _ _⟩
    refine Finite.of_injective ι ?_
    intro t t' h
    apply Subtype.ext
    have h1 := congrArg (fun σ : {σ : Spec (.of K) ⟶
        Limits.pullback g s // σ ≫ Limits.pullback.snd g s = 𝟙 _} =>
      σ.1 ≫ Limits.pullback.fst g s) h
    simp only [ι] at h1
    rwa [Limits.pullback.lift_fst, Limits.pullback.lift_fst] at h1

  let L : Λ ⥤ Type u :=
    { obj := fun l => {t : Spec (.of (AlgebraicClosure (B.residueField b'))) ⟶ (W'.obj l).right.left //
          t ≫ (W'.obj l).right.hom = wcEtGeomPt B b'}
      map := fun {l l'} f => TypeCat.ofHom (fun t => ⟨t.1 ≫ (W'.map f).right.left, by
          rw [Category.assoc, MorphismProperty.Over.w (W'.map f).right]; exact t.2⟩)
      map_id := fun l => by
        ext t
        show t.1 ≫ (W'.map (𝟙 l)).right.left = t.1
        rw [W'.map_id]
        exact Category.comp_id _
      map_comp := fun {l₁ l₂ l₃} f g => by
        ext t
        show t.1 ≫ (W'.map (f ≫ g)).right.left =
          (t.1 ≫ (W'.map f).right.left) ≫ (W'.map g).right.left
        rw [W'.map_comp, Category.assoc]
        rfl }
  haveI hne : ∀ l, Nonempty (L.obj l) := by
    intro l
    haveI : Etale (W'.obj l).right.hom := (W'.obj l).right.prop
    have hw : (W'.obj l).hom.left ≫ (W'.obj l).right.hom = wcEtGeomPt B b :=
      Over.w (W'.obj l).hom
    have e : (W'.obj l).right.hom ((W'.obj l).hom.left
        (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField b)))) = b := by
      have h0 := Scheme.Hom.comp_apply (W'.obj l).hom.left (W'.obj l).right.hom
        (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField b)))
      rw [hw, hgp] at h0
      exact h0.symm
    exact hneG (W'.obj l).right.hom _ e
  haveI hfinL : ∀ l, Finite (L.obj l) := by
    intro l
    haveI : Etale (W'.obj l).right.hom := (W'.obj l).right.prop
    haveI : IsAffine (W'.obj l).right.left := hAff l
    have hc : CompactSpace ↥(W'.obj l).right.left := inferInstance
    exact @hfinG (AlgebraicClosure (B.residueField b')) _ (W'.obj l).right.left
      (W'.obj l).right.hom _ hc (wcEtGeomPt B b')

  obtain ⟨σ, hσ⟩ := nonempty_sections_of_finite_cofiltered_system L
  have hσ' : ∀ {j j' : Λ} (f : j ⟶ j'), L.map f (σ j) = σ j' := hσ
  have hz : ∀ {l l' : Λ} (t : l ⟶ l'), (σ l).1 ≫ (W'.map t).right.left = (σ l').1 := by
    intro l l' t
    have := congrArg Subtype.val (hσ' t)
    exact this
  obtain ⟨z₀, hz₀, -⟩ := hUniv (Spec (.of (AlgebraicClosure (B.residueField b'))))
    (fun l => (σ l).1) hz
  obtain ⟨l₀⟩ := IsCofiltered.nonempty (C := Λ)
  refine ⟨z₀, ?_⟩
  rw [← ha l₀, ← Category.assoc, hz₀ l₀]
  exact (σ l₀).2

theorem wc_fet_torsor_base_change : ∀ {Y Y' P : Scheme.{u}} (p : P ⟶ Y) (h : Y' ⟶ Y) (m : ℕ) (a : ZMod m → (P ⟶ P)), wcFetTorsor p m a → ∃ a' : ZMod m → (Limits.pullback p h ⟶ Limits.pullback p h), wcFetTorsor (Limits.pullback.snd p h) m a' :=
by
  intro Y Y' P p h m a tor
  classical
  haveI := tor.finite
  haveI := tor.etale
  let f := Limits.pullback.fst p h
  let q := Limits.pullback.snd p h
  haveI hqe : Etale q := inferInstanceAs (Etale (Limits.pullback.snd p h))
  have hC : f ≫ p = q ≫ h := Limits.pullback.condition
  have hw : ∀ c, (f ≫ a c) ≫ p = q ≫ h := by
    intro c
    rw [Category.assoc, tor.act_p c, hC]

  let a' : ZMod m → (Limits.pullback p h ⟶ Limits.pullback p h) := fun c =>
    Limits.pullback.lift (f ≫ a c) q (hw c)
  have A1 : ∀ c, a' c ≫ f = f ≫ a c := fun c => Limits.pullback.lift_fst _ _ _
  have A2 : ∀ c, a' c ≫ q = q := fun c => Limits.pullback.lift_snd _ _ _

  have act_zero : a' 0 = 𝟙 _ := by
    apply Limits.pullback.hom_ext
    · rw [A1, tor.act_zero, Category.comp_id, Category.id_comp]
    · rw [A2, Category.id_comp]
  have act_add : ∀ c c', a' (c + c') = a' c' ≫ a' c := by
    intro c c'
    apply Limits.pullback.hom_ext
    · have A1' : ∀ (d : ZMod m) {Z : Scheme.{u}} (g : P ⟶ Z), a' d ≫ f ≫ g = f ≫ a d ≫ g := by
        intro d Z g
        rw [← Category.assoc, A1, Category.assoc]
      change a' (c + c') ≫ f = a' c' ≫ a' c ≫ f
      rw [A1, tor.act_add]
      simp only [Category.assoc, A1, A1']
    · change a' (c + c') ≫ q = a' c' ≫ a' c ≫ q
      rw [A2, A2, A2]

  have hsurj : Set.range (Limits.pullback.snd p h) = Set.univ := by
    rw [Scheme.Pullback.range_snd, tor.surj, Set.preimage_univ]

  let G' : ZMod m → (Limits.pullback p h ⟶ Limits.pullback q q) := fun c =>
    Limits.pullback.lift (a' c) (𝟙 _) ((A2 c).trans (Category.id_comp _).symm)
  have G'1 : ∀ c, G' c ≫ Limits.pullback.fst q q = a' c := fun c => Limits.pullback.lift_fst _ _ _
  have G'2 : ∀ c, G' c ≫ Limits.pullback.snd q q = 𝟙 _ := fun c => Limits.pullback.lift_snd _ _ _
  let G : ZMod m → (P ⟶ Limits.pullback p p) := fun c =>
    Limits.pullback.lift (a c) (𝟙 P) ((tor.act_p c).trans (Category.id_comp p).symm)
  have G1 : ∀ c, G c ≫ Limits.pullback.fst p p = a c := fun c => Limits.pullback.lift_fst _ _ _
  have G2 : ∀ c, G c ≫ Limits.pullback.snd p p = 𝟙 P := fun c => Limits.pullback.lift_snd _ _ _

  have hopen : ∀ c, IsOpenImmersion (G' c) := by
    intro c
    haveI : Mono (G' c) := mono_of_mono_fac (G'2 c)
    haveI : Etale (G' c) := by
      apply MorphismProperty.of_postcomp (W := @Etale) (W' := @Etale) _
        (Limits.pullback.snd q q) inferInstance
      rw [G'2 c]; infer_instance
    exact IsOpenImmersion.of_flat_of_mono _

  let κ := Limits.pullback.map q q p p f f h hC.symm hC.symm
  have κ1 : κ ≫ Limits.pullback.fst p p = Limits.pullback.fst q q ≫ f :=
    Limits.pullback.lift_fst _ _ _
  have κ2 : κ ≫ Limits.pullback.snd p p = Limits.pullback.snd q q ≫ f :=
    Limits.pullback.lift_snd _ _ _
  have K : ∀ c, G' c ≫ κ = f ≫ G c := by
    intro c
    apply Limits.pullback.hom_ext
    · simp only [Category.assoc]
      rw [κ1, ← Category.assoc, G'1, A1, G1]
    · simp only [Category.assoc]
      rw [κ2, ← Category.assoc, G'2, Category.id_comp, G2, Category.comp_id]

  have L : ∀ c {T : Scheme.{u}} (t₁ : T ⟶ P) (t₂ : T ⟶ Limits.pullback q q),
      t₁ ≫ G c = t₂ ≫ κ → (t₂ ≫ Limits.pullback.snd q q) ≫ G' c = t₂ := by
    intro c T t₁ t₂ ht
    have e1 : t₂ ≫ Limits.pullback.fst q q ≫ f = t₁ ≫ a c := by
      rw [← κ1, ← Category.assoc, ← ht, Category.assoc, G1]
    have e2 : t₂ ≫ Limits.pullback.snd q q ≫ f = t₁ := by
      rw [← κ2, ← Category.assoc, ← ht, Category.assoc, G2, Category.comp_id]
    apply Limits.pullback.hom_ext
    · simp only [Category.assoc, G'1]
      apply Limits.pullback.hom_ext
      · change t₂ ≫ Limits.pullback.snd q q ≫ a' c ≫ f = t₂ ≫ Limits.pullback.fst q q ≫ f
        rw [A1 c, reassoc_of% e2, e1]
      · change t₂ ≫ Limits.pullback.snd q q ≫ a' c ≫ q = t₂ ≫ Limits.pullback.fst q q ≫ q
        rw [A2, Limits.pullback.condition]
    · simp only [Category.assoc, G'2, Category.comp_id]

  have hR : ∀ c, Set.range (G' c) ⊆ κ ⁻¹' Set.range (G c) := by
    rintro c _ ⟨v, rfl⟩
    refine ⟨f v, ?_⟩
    have := Scheme.Hom.comp_apply (G' c) κ v
    rw [K c, Scheme.Hom.comp_apply] at this
    exact this
  have hdisj : Pairwise fun c c' => Disjoint (Set.range (G' c)) (Set.range (G' c')) := by
    intro c c' hcc'
    have hd : Disjoint (Set.range (G c)) (Set.range (G c')) := tor.graph_disj hcc'
    exact Disjoint.mono (hR c) (hR c') (hd.preimage (⇑κ))

  have hcov : ⋃ c, Set.range (G c) = Set.univ := tor.graph_cover
  have hcover : ⋃ c, Set.range (G' c) = Set.univ := by
    apply Set.eq_univ_of_forall
    intro z
    have hz : κ z ∈ ⋃ c, Set.range (G c) := by
      rw [hcov]; exact Set.mem_univ _
    obtain ⟨c, hc⟩ := Set.mem_iUnion.mp hz
    have hzT : z ∈ Set.range (Limits.pullback.snd (G c) κ) := by
      rw [Scheme.Pullback.range_snd]; exact hc
    obtain ⟨w, rfl⟩ := hzT
    have hL := L c (Limits.pullback.fst (G c) κ) (Limits.pullback.snd (G c) κ)
      Limits.pullback.condition
    refine Set.mem_iUnion.mpr ⟨c, (Limits.pullback.snd (G c) κ ≫ Limits.pullback.snd q q) w, ?_⟩
    have := Scheme.Hom.comp_apply (Limits.pullback.snd (G c) κ ≫ Limits.pullback.snd q q) (G' c) w
    rw [hL] at this
    exact this.symm

  exact ⟨a', ⟨inferInstance, inferInstance, hsurj, A2, act_zero, act_add, hopen, hdisj, hcover⟩⟩

theorem wc_smooth_restrict_base_change : ∀ (S X Y T : Scheme.{u}) (g : X ⟶ S) (W : S.Opens), Smooth (g ∣_ W) → ∀ (e : Y ⟶ S) (a : T ⟶ Y), Set.range (a ≫ e) ⊆ (W : Set S) → Smooth (Limits.pullback.snd (Limits.pullback.snd g e) a) :=
by
  intro S X Y T g W hsm e a hrange
  have hc : Set.range (a ≫ e) ⊆ Set.range W.ι := by
    rw [Scheme.Opens.range_ι]; exact hrange
  obtain ⟨c', hc'⟩ : ∃ c' : T ⟶ W, c' ≫ W.ι = a ≫ e :=
    ⟨_, IsOpenImmersion.lift_fac W.ι (a ≫ e) hc⟩
  have B2 : IsPullback
      (Limits.pullback.fst (Limits.pullback.snd g e) a ≫ Limits.pullback.fst g e)
      (Limits.pullback.snd (Limits.pullback.snd g e) a) g (a ≫ e) :=
    IsPullback.paste_horiz (IsPullback.of_hasPullback (Limits.pullback.snd g e) a)
      (IsPullback.of_hasPullback g e)
  have R := isPullback_morphismRestrict g W
  have w : (Limits.pullback.snd (Limits.pullback.snd g e) a ≫ c') ≫ W.ι =
      (Limits.pullback.fst (Limits.pullback.snd g e) a ≫ Limits.pullback.fst g e) ≫ g := by
    rw [Category.assoc, hc', B2.w]
  have hL1 := R.lift_fst _ _ w
  have hL2 := R.lift_snd _ _ w
  have outer : IsPullback (R.lift _ _ w ≫ (g ⁻¹ᵁ W).ι)
      (Limits.pullback.snd (Limits.pullback.snd g e) a) g (c' ≫ W.ι) := by
    rw [hL2, hc']; exact B2
  have Q := IsPullback.of_right outer hL1 R.flip
  exact MorphismProperty.of_isPullback (P := @Smooth) Q hsm

theorem wc_lim_section_descend : ∀ {Y : Scheme.{u}} (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (D : Λ ⥤ Y.Etale) (Zt : Scheme.{u}) (π : ∀ l, Zt ⟶ (D.obj l).left), (∀ {l l' : Λ} (t : l ⟶ l'), π l ≫ (D.map t).left = π l') → (∀ (T : Scheme.{u}) (z : ∀ l, T ⟶ (D.obj l).left), (∀ {l l' : Λ} (t : l ⟶ l'), z l ≫ (D.map t).left = z l') → ∃! z₀ : T ⟶ Zt, ∀ l, z₀ ≫ π l = z l) → (∀ l, CompactSpace (D.obj l).left) → (∀ l, QuasiSeparatedSpace (D.obj l).left) → (∀ {l l' : Λ} (t : l ⟶ l'), IsAffineHom (D.map t).left) → ∀ (P : Scheme.{u}) (p : P ⟶ Y), IsAffineHom p → LocallyOfFinitePresentation p → ∀ ψ : Zt ⟶ P, (∀ l, ψ ≫ p = π l ≫ (D.obj l).hom) → ∃ (l : Λ) (σ : (D.obj l).left ⟶ P), σ ≫ p = (D.obj l).hom :=
by
  intro Y Λ _ _ D Zt π hπ hlim hC hQS hAff P p _ hpLFP ψ hψ
  let D' : Λ ⥤ Scheme.{u} := D ⋙ Scheme.Etale.forget Y ⋙ Over.forget Y
  haveI : ∀ l, CompactSpace (D'.obj l) := hC
  haveI : ∀ l, QuasiSeparatedSpace (D'.obj l) := hQS
  haveI : ∀ {i j : Λ} (f : i ⟶ j), IsAffineHom (D'.map f) := fun f => hAff f
  let c : Limits.Cone D' :=
    { pt := Zt
      π :=
        { app := π
          naturality := fun l l' t => by
            show 𝟙 Zt ≫ π l' = π l ≫ (D.map t).left
            rw [Category.id_comp]
            exact (hπ t).symm } }
  have key : ∀ s : Limits.Cone D', ∃! z₀ : s.pt ⟶ Zt, ∀ l, z₀ ≫ π l = s.π.app l := by
    intro s
    refine hlim s.pt (fun l => s.π.app l) ?_
    intro l l' t
    have h := s.π.naturality t
    have h' : 𝟙 s.pt ≫ s.π.app l' = s.π.app l ≫ (D.map t).left := h
    rw [Category.id_comp] at h'
    exact h'.symm
  have hc : Limits.IsLimit c :=
    { lift := fun s => (key s).exists.choose
      fac := fun s l => (key s).exists.choose_spec l
      uniq := fun s m hm => (key s).unique hm (key s).exists.choose_spec }
  let tt : D' ⟶ (Functor.const Λ).obj Y :=
    { app := fun l => (D.obj l).hom
      naturality := fun l l' f =>
        (MorphismProperty.Over.w (D.map f)).trans (Category.comp_id _).symm }
  have hct : c.π ≫ tt = (Functor.const Λ).map (ψ ≫ p) := by
    ext l
    show π l ≫ (D.obj l).hom = ψ ≫ p
    exact (hψ l).symm
  obtain ⟨l, g, -, hg⟩ :=
    Scheme.exists_π_app_comp_eq_of_locallyOfFinitePresentation D' tt p c hc ψ hct
  exact ⟨l, g, hg⟩

theorem wc_torsor_section_of_fundamental_open : ∀ {Z P : Scheme.{u}} (p : P ⟶ Z) (m : ℕ) (a : ZMod m → (P ⟶ P)), wcFetTorsor p m a → ∀ (D : Set P), IsOpen D → (∀ c : ZMod m, c ≠ 0 → ∀ x ∈ D, (a c) x ∉ D) → (∀ x : P, ∃ c : ZMod m, (a c) x ∈ D) → ∃ σ : Z ⟶ P, σ ≫ p = 𝟙 Z :=
by
  intro Z P p m a ht D hD hdisj hcov
  haveI := ht.etale
  let U : P.Opens := ⟨D, hD⟩
  let Γ : ZMod m → (P ⟶ Limits.pullback p p) := fun c =>
    Limits.pullback.lift (a c) (𝟙 P) ((ht.act_p c).trans (Category.id_comp p).symm)
  have hΓ1 : ∀ c, Γ c ≫ Limits.pullback.fst p p = a c := fun c => Limits.pullback.lift_fst _ _ _
  have hΓ2 : ∀ c, Γ c ≫ Limits.pullback.snd p p = 𝟙 P := fun c => Limits.pullback.lift_snd _ _ _

  have hmono : Mono (U.ι ≫ p) := by
    constructor
    intro T g h hgh
    have w : (g ≫ U.ι) ≫ p = (h ≫ U.ι) ≫ p := by
      simp only [Category.assoc]; exact hgh
    let k : T ⟶ Limits.pullback p p := Limits.pullback.lift (g ≫ U.ι) (h ≫ U.ι) w
    have hk1 : k ≫ Limits.pullback.fst p p = g ≫ U.ι := Limits.pullback.lift_fst _ _ _
    have hk2 : k ≫ Limits.pullback.snd p p = h ≫ U.ι := Limits.pullback.lift_snd _ _ _
    have hrange : Set.range k ⊆ Set.range (Γ 0) := by
      rintro _ ⟨t, rfl⟩
      have hcov' := ht.graph_cover
      have hmem : k t ∈ ⋃ c, Set.range (Γ c) := by
        rw [hcov']; exact Set.mem_univ _
      obtain ⟨c, x, hx⟩ := Set.mem_iUnion.mp hmem
      have e1 : (a c) x = (g ≫ U.ι) t := by
        calc (a c) x = (Γ c ≫ Limits.pullback.fst p p) x := by rw [hΓ1]
          _ = Limits.pullback.fst p p (Γ c x) := Scheme.Hom.comp_apply _ _ _
          _ = Limits.pullback.fst p p (k t) := by rw [hx]
          _ = (k ≫ Limits.pullback.fst p p) t := (Scheme.Hom.comp_apply _ _ _).symm
          _ = (g ≫ U.ι) t := by rw [hk1]
      have e2 : x = (h ≫ U.ι) t := by
        calc x = (Γ c ≫ Limits.pullback.snd p p) x := by rw [hΓ2]; rfl
          _ = Limits.pullback.snd p p (Γ c x) := Scheme.Hom.comp_apply _ _ _
          _ = Limits.pullback.snd p p (k t) := by rw [hx]
          _ = (k ≫ Limits.pullback.snd p p) t := (Scheme.Hom.comp_apply _ _ _).symm
          _ = (h ≫ U.ι) t := by rw [hk2]
      have hgD : (g ≫ U.ι) t ∈ D := by
        have hr : (g ≫ U.ι) t ∈ Set.range U.ι := ⟨g t, (Scheme.Hom.comp_apply _ _ _).symm⟩
        rw [Scheme.Opens.range_ι] at hr
        exact hr
      have hhD : (h ≫ U.ι) t ∈ D := by
        have hr : (h ≫ U.ι) t ∈ Set.range U.ι := ⟨h t, (Scheme.Hom.comp_apply _ _ _).symm⟩
        rw [Scheme.Opens.range_ι] at hr
        exact hr
      have hc0 : c = 0 := by
        by_contra hc
        exact hdisj c hc x (e2 ▸ hhD) (e1 ▸ hgD)
      subst hc0
      exact ⟨x, hx⟩
    haveI : IsOpenImmersion (Γ 0) := ht.graph_open 0
    let j : T ⟶ P := IsOpenImmersion.lift (Γ 0) k hrange
    have hj : j ≫ Γ 0 = k := IsOpenImmersion.lift_fac _ _ _
    have hg : g ≫ U.ι = j := by
      rw [← hk1, ← hj, Category.assoc, hΓ1, ht.act_zero, Category.comp_id]
    have hh : h ≫ U.ι = j := by
      rw [← hk2, ← hj, Category.assoc, hΓ2, Category.comp_id]
    exact (cancel_mono U.ι).mp (hg.trans hh.symm)

  have hsurj : Surjective (U.ι ≫ p) := by
    constructor
    intro z
    have hz : z ∈ Set.range p := by rw [ht.surj]; exact Set.mem_univ _
    obtain ⟨x, rfl⟩ := hz
    obtain ⟨c, hc⟩ := hcov x
    have hr : (a c) x ∈ Set.range U.ι := by
      rw [Scheme.Opens.range_ι]; exact hc
    obtain ⟨y, hy⟩ := hr
    refine ⟨y, ?_⟩
    have e := Scheme.Hom.comp_apply (a c) p x
    rw [ht.act_p] at e
    rw [Scheme.Hom.comp_apply, hy]
    exact e.symm

  haveI := hmono
  haveI hoi : IsOpenImmersion (U.ι ≫ p) := IsOpenImmersion.of_flat_of_mono _
  haveI hiso : IsIso (U.ι ≫ p) := (isIso_iff_isOpenImmersion_and_surjective _).mpr ⟨hoi, hsurj⟩
  refine ⟨inv (U.ι ≫ p) ≫ U.ι, ?_⟩
  rw [Category.assoc, IsIso.inv_hom_id]

theorem wc_torsor_section_translates_partition : ∀ {Z Y P : Scheme.{u}} (p : P ⟶ Z) (m : ℕ) (a : ZMod m → (P ⟶ P)) (ht : wcFetTorsor p m a) (F : Y ⟶ Z) (τ : Y ⟶ P) (hτ : τ ≫ p = F), (∀ y : ↥(Limits.pullback p F), ∃ (c : ZMod m) (w : Y), (Limits.pullback.map p F p F (a c) (𝟙 Y) (𝟙 Z) ((Category.comp_id p).trans (ht.act_p c).symm) ((Category.comp_id F).trans (Category.id_comp F).symm)) y = (Limits.pullback.lift τ (𝟙 Y) (hτ.trans (Category.id_comp F).symm)) w) ∧ (∀ (c : ZMod m), c ≠ 0 → ∀ (w w' : Y), (Limits.pullback.map p F p F (a c) (𝟙 Y) (𝟙 Z) ((Category.comp_id p).trans (ht.act_p c).symm) ((Category.comp_id F).trans (Category.id_comp F).symm)) ((Limits.pullback.lift τ (𝟙 Y) (hτ.trans (Category.id_comp F).symm)) w) ≠ (Limits.pullback.lift τ (𝟙 Y) (hτ.trans (Category.id_comp F).symm)) w') :=
by
  intro Z Y P p m a ht F τ hτ
  obtain ⟨s', hs'⟩ : ∃ s' : Y ⟶ Limits.pullback p F,
      s' = Limits.pullback.lift τ (𝟙 Y) (hτ.trans (Category.id_comp F).symm) := ⟨_, rfl⟩
  obtain ⟨a', ha'⟩ : ∃ a' : ZMod m → (Limits.pullback p F ⟶ Limits.pullback p F), ∀ c,
      a' c = Limits.pullback.map p F p F (a c) (𝟙 Y) (𝟙 Z)
        ((Category.comp_id p).trans (ht.act_p c).symm)
        ((Category.comp_id F).trans (Category.id_comp F).symm) := ⟨_, fun _ => rfl⟩
  simp only [← hs', ← ha']
  have E1 : s' ≫ Limits.pullback.fst p F = τ := by rw [hs']; exact Limits.pullback.lift_fst _ _ _
  have E2 : s' ≫ Limits.pullback.snd p F = 𝟙 Y := by
    rw [hs']; exact Limits.pullback.lift_snd _ _ _
  have E3 : ∀ c, a' c ≫ Limits.pullback.fst p F = Limits.pullback.fst p F ≫ a c := fun c => by
    rw [ha']; exact Limits.pullback.lift_fst _ _ _
  have E4 : ∀ c, a' c ≫ Limits.pullback.snd p F = Limits.pullback.snd p F := fun c => by
    rw [ha']; exact (Limits.pullback.lift_snd _ _ _).trans (Category.comp_id _)
  have hΘ : Limits.pullback.fst p F ≫ p = (Limits.pullback.snd p F ≫ τ) ≫ p := by
    rw [Limits.pullback.condition, Category.assoc, hτ]
  obtain ⟨Θ, E7, E8⟩ : ∃ Θ : Limits.pullback p F ⟶ Limits.pullback p p,
      Θ ≫ Limits.pullback.fst p p = Limits.pullback.fst p F ∧
      Θ ≫ Limits.pullback.snd p p = Limits.pullback.snd p F ≫ τ :=
    ⟨Limits.pullback.lift _ _ hΘ, Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
  have E5 : ∀ c, Limits.pullback.lift (a c) (𝟙 P) ((ht.act_p c).trans (Category.id_comp p).symm)
      ≫ Limits.pullback.fst p p = a c := fun c => Limits.pullback.lift_fst _ _ _
  have E6 : ∀ c, Limits.pullback.lift (a c) (𝟙 P) ((ht.act_p c).trans (Category.id_comp p).symm)
      ≫ Limits.pullback.snd p p = 𝟙 P := fun c => Limits.pullback.lift_snd _ _ _
  have E9 : ∀ c, a c ≫ a (-c) = 𝟙 P := fun c => by
    rw [← ht.act_add, neg_add_cancel, ht.act_zero]
  refine ⟨fun y => ?_, fun c hc w w' h => ?_⟩
  · obtain ⟨c, hc⟩ := Set.mem_iUnion.mp (Set.eq_univ_iff_forall.mp ht.graph_cover (Θ y))
    have hc' : Θ y ∈ Set.range (Limits.pullback.lift (a c) (𝟙 P)
        ((ht.act_p c).trans (Category.id_comp p).symm)) := hc
    haveI : IsOpenImmersion (Limits.pullback.lift (a c) (𝟙 P)
        ((ht.act_p c).trans (Category.id_comp p).symm)) := ht.graph_open c
    have hopen : IsOpen (Set.range (Limits.pullback.lift (a c) (𝟙 P)
        ((ht.act_p c).trans (Category.id_comp p).symm))) :=
      (Limits.pullback.lift (a c) (𝟙 P)
        ((ht.act_p c).trans (Category.id_comp p).symm)).isOpenEmbedding.isOpen_range
    let V : (Limits.pullback p F).Opens := ⟨Θ ⁻¹' Set.range (Limits.pullback.lift (a c) (𝟙 P)
        ((ht.act_p c).trans (Category.id_comp p).symm)), hopen.preimage Θ.continuous⟩
    have hyV : y ∈ V := hc'
    have H' : Set.range (V.ι ≫ Θ) ⊆ Set.range (Limits.pullback.lift (a c) (𝟙 P)
        ((ht.act_p c).trans (Category.id_comp p).symm)) := by
      rintro _ ⟨v, rfl⟩
      rw [Scheme.Hom.comp_apply]
      exact v.2
    obtain ⟨hl, hfac⟩ : ∃ hl : V.toScheme ⟶ P, hl ≫ Limits.pullback.lift (a c) (𝟙 P)
        ((ht.act_p c).trans (Category.id_comp p).symm) = V.ι ≫ Θ :=
      ⟨_, IsOpenImmersion.lift_fac _ _ H'⟩
    have hh1 : hl = V.ι ≫ Limits.pullback.snd p F ≫ τ := by
      have := congrArg (· ≫ Limits.pullback.snd p p) hfac
      simp only [Category.assoc, E6, E8, Category.comp_id] at this
      exact this
    have hh2 : V.ι ≫ Limits.pullback.fst p F = V.ι ≫ Limits.pullback.snd p F ≫ τ ≫ a c := by
      have := congrArg (· ≫ Limits.pullback.fst p p) hfac
      simp only [Category.assoc, E5, E7] at this
      rw [← this, hh1]
      simp only [Category.assoc]
    have K : V.ι ≫ a' (-c) = V.ι ≫ Limits.pullback.snd p F ≫ s' := by
      apply Limits.pullback.hom_ext
      · simp only [Category.assoc, E3, E1, reassoc_of% hh2, E9, Category.comp_id]
      · simp only [Category.assoc, E4, E2, Category.comp_id]
    refine ⟨-c, Limits.pullback.snd p F y, ?_⟩
    have := congrArg (fun φ => φ ⟨y, hyV⟩) K
    simp only [Scheme.Hom.comp_apply, Scheme.Opens.ι_apply] at this
    exact this
  · have D1 : s' ≫ a' c ≫ Θ = τ ≫ Limits.pullback.lift (a c) (𝟙 P)
        ((ht.act_p c).trans (Category.id_comp p).symm) := by
      apply Limits.pullback.hom_ext
      · simp only [Category.assoc, E7, E5, E3, E1, reassoc_of% E1]
      · simp only [Category.assoc, E8, E6, E4, reassoc_of% E4, E2, reassoc_of% E2,
          Category.comp_id, Category.id_comp]
    have D2 : s' ≫ Θ = τ ≫ Limits.pullback.lift (a 0) (𝟙 P)
        ((ht.act_p 0).trans (Category.id_comp p).symm) := by
      apply Limits.pullback.hom_ext
      · simp only [Category.assoc, E7, E5, E1]
        rw [ht.act_zero, Category.comp_id]
      · simp only [Category.assoc, E8, E6, reassoc_of% E2, Category.comp_id, Category.id_comp]
    have e : Θ (a' c (s' w)) = Θ (s' w') := congrArg (fun x => Θ x) h
    have e1 : (s' ≫ a' c ≫ Θ) w = (s' ≫ Θ) w' := by
      simp only [Scheme.Hom.comp_apply]; exact e
    rw [D1, D2, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at e1
    exact Set.disjoint_left.mp (ht.graph_disj hc) ⟨τ w, rfl⟩ ⟨τ w', e1.symm⟩

theorem wc_clopen_empty_of_geom_fibre_empty : ∀ (A : Type u) [CommRing A] [IsLocalRing A] (X : Scheme.{u}) (g : X ⟶ Spec (.of A)) [UniversallyClosed g] [Flat g] (T W : Scheme.{u}) (ξ : T ⟶ Spec (.of A)) (q : W ⟶ X) (r : W ⟶ T), IsPullback q r g ξ → Nonempty T → ∀ E : Set X, IsOpen E → IsClosed E → q ⁻¹' E = ∅ → E = ∅ :=
by
  intro A _ _ X g _ _ T W ξ q r hpb hT E hEo hEc hq
  rw [Set.eq_empty_iff_forall_notMem]
  intro x₀ hx₀
  have hGc : IsClosed (g '' E) := g.isClosedMap E hEc
  have hm : (IsLocalRing.closedPoint A : Spec (.of A)) ∈ g '' E :=
    (IsLocalRing.specializes_closedPoint (g x₀)).mem_closed hGc (Set.mem_image_of_mem g hx₀)
  obtain ⟨x₁, hx₁, hgx₁⟩ := hm
  obtain ⟨t⟩ := hT
  have hy : ξ t ⤳ g x₁ := by
    rw [hgx₁]; exact IsLocalRing.specializes_closedPoint (ξ t)
  obtain ⟨x', hx'1, hx'2⟩ := Flat.generalizingMap g hy
  have hx'E : x' ∈ E := hx'1.mem_open hEo hx₁
  obtain ⟨z, hz1, -⟩ := Scheme.Pullback.exists_preimage_pullback x' t hx'2
  have e := Scheme.Hom.comp_apply hpb.isoPullback.inv q z
  rw [hpb.isoPullback_inv_fst, hz1] at e
  have hw : hpb.isoPullback.inv z ∈ q ⁻¹' E := by
    show q (hpb.isoPullback.inv z) ∈ E
    rw [← e]; exact hx'E
  rw [hq] at hw
  exact hw

theorem wc_proper_henselian_closed_fibre_clopen_extend : ∀ (A : Type u) [CommRing A] [HenselianLocalRing A] (X : Scheme.{u}) (g : X ⟶ Spec (.of A)) [IsProper g] (T₁ T₂ : Set X), IsClosed T₁ → IsClosed T₂ → Disjoint T₁ T₂ → T₁ ∪ T₂ = g ⁻¹' {IsLocalRing.closedPoint A} → ∃ C : Set X, IsClopen C ∧ ∀ x : X, g x = IsLocalRing.closedPoint A → (x ∈ C ↔ x ∈ T₁) :=
by
  intro A _ _ X g _ T₁ T₂ hT₁ hT₂ hdisj hunion
  classical
  have hHen : HenselianLocalRing A := inferInstance
  have hofId : ((Algebra.ofId A (IsLocalRing.ResidueField A) : A →ₐ[A] IsLocalRing.ResidueField A) :
      A →+* IsLocalRing.ResidueField A) = IsLocalRing.residue A := by
    ext x
    show Algebra.ofId A (IsLocalRing.ResidueField A) x = IsLocalRing.residue A x
    rw [Algebra.ofId_apply, IsLocalRing.ResidueField.algebraMap_eq]

  have s2 : ∀ (S : Type u) [CommRing S] [Algebra A S], Algebra.IsStandardEtale A S →
      ∀ φ : S →ₐ[A] IsLocalRing.ResidueField A,
        ∃ τ : S →ₐ[A] A, (Algebra.ofId A (IsLocalRing.ResidueField A)).comp τ = φ := by
    intro S _ _ hS φ
    obtain ⟨P⟩ := hS.nonempty_standardEtalePresentation
    have hm := P.hasMap
    have hf0 : Polynomial.aeval (φ P.x) P.f = 0 := by
      rw [Polynomial.aeval_algHom_apply, hm.1, map_zero]
    have hg0 : Polynomial.aeval (φ P.x) P.g ≠ 0 := by
      rw [Polynomial.aeval_algHom_apply]
      exact (hm.2.map φ).ne_zero
    have hd0 : Polynomial.aeval (φ P.x) (Polynomial.derivative P.f) ≠ 0 := by
      obtain ⟨p₁, p₂, N, hc⟩ := P.cond
      have h1 := congrArg (Polynomial.aeval (φ P.x)) hc
      rw [map_add, map_mul, map_mul, hf0, zero_mul, add_zero, map_pow] at h1
      intro h
      rw [h, zero_mul] at h1
      exact pow_ne_zero N hg0 h1.symm
    have key := (HenselianLocalRing.TFAE A).out 1 2
    obtain ⟨a, ha, hres⟩ := key.mp hHen P.f P.monic_f (φ P.x) hf0 hd0
    have hA : P.HasMap a := by
      refine ⟨?_, ?_⟩
      · rw [Polynomial.aeval_def, Algebra.algebraMap_self, Polynomial.eval₂_id]
        exact ha
      · have key2 : (Algebra.ofId A (IsLocalRing.ResidueField A)) (Polynomial.aeval a P.g) =
            Polynomial.aeval (φ P.x) P.g := by
          rw [← Polynomial.aeval_algHom_apply, Algebra.ofId_apply,
            IsLocalRing.ResidueField.algebraMap_eq, hres]
        rw [Algebra.ofId_apply, IsLocalRing.ResidueField.algebraMap_eq] at key2
        exact (IsLocalRing.residue_ne_zero_iff_isUnit _).mp (key2 ▸ hg0)
    refine ⟨(P.lift a hA).comp P.equivRing.toAlgHom, ?_⟩
    have h1 : (Algebra.ofId A (IsLocalRing.ResidueField A)).comp (P.lift a hA) =
        φ.comp P.equivRing.symm.toAlgHom := by
      apply StandardEtalePair.hom_ext
      rw [AlgHom.comp_apply, AlgHom.comp_apply, StandardEtalePair.lift_X, Algebra.ofId_apply,
        IsLocalRing.ResidueField.algebraMap_eq, hres]
      have hx : P.equivRing.symm P.X = P.x := (P.equivRing.symm_apply_eq).mpr P.equivRing_x.symm
      show φ P.x = φ (P.equivRing.symm P.X)
      rw [hx]
    ext s
    have h2 := congrArg (fun F => F (P.equivRing s)) h1
    simpa using h2

  have s3 : ∀ (E : Type u) [CommRing E] [Algebra A E], Algebra.Etale A E →
      ∀ φ : E →ₐ[A] IsLocalRing.ResidueField A,
        ∃ τ : E →ₐ[A] A, (Algebra.ofId A (IsLocalRing.ResidueField A)).comp τ = φ := by
    intro E _ _ hE φ
    have : (RingHom.ker (φ : E →+* IsLocalRing.ResidueField A)).IsPrime := RingHom.ker_isPrime _
    obtain ⟨s, hs, hst⟩ := Algebra.IsEtaleAt.exists_isStandardEtale (R := A)
      (RingHom.ker (φ : E →+* IsLocalRing.ResidueField A))
    have hs0 : φ s ≠ 0 := fun h => hs (RingHom.mem_ker.mpr h)
    have hu : ∀ y : Submonoid.powers s, IsUnit (φ y) := by
      rintro ⟨y, k, rfl⟩
      simpa [map_pow] using (isUnit_iff_ne_zero.mpr hs0).pow k
    let φ' : Localization.Away s →ₐ[A] IsLocalRing.ResidueField A :=
      IsLocalization.liftAlgHom (M := Submonoid.powers s) hu
    obtain ⟨τ', hτ'⟩ := s2 _ hst φ'
    refine ⟨τ'.comp (IsScalarTower.toAlgHom A E (Localization.Away s)), ?_⟩
    ext e
    have h1 := congrArg (fun F => F (algebraMap E (Localization.Away s) e)) hτ'
    simp only [AlgHom.comp_apply] at h1 ⊢
    rw [IsScalarTower.toAlgHom_apply, h1]
    simp [φ', IsLocalization.liftAlgHom_apply, IsLocalization.lift_eq]

  have s4 : ∀ (f : Polynomial A) (g₀ h₀ : Polynomial (IsLocalRing.ResidueField A)), f.Monic →
      g₀.Monic → h₀.Monic → IsCoprime g₀ h₀ → f.map (IsLocalRing.residue A) = g₀ * h₀ →
      ∃ g h : Polynomial A, g.Monic ∧ h.Monic ∧ f = g * h ∧
        g.map (IsLocalRing.residue A) = g₀ ∧ h.map (IsLocalRing.residue A) = h₀ := by
    intro f g₀ h₀ hf hg hh hc hfac
    have hn : f.natDegree = g₀.natDegree + h₀.natDegree := by
      rw [← hg.natDegree_mul hh, ← hfac, hf.natDegree_map]
    let p : Polynomial.MonicDegreeEq A f.natDegree := Polynomial.MonicDegreeEq.mk f hf rfl
    let G₀ : Polynomial.MonicDegreeEq (IsLocalRing.ResidueField A) g₀.natDegree :=
      Polynomial.MonicDegreeEq.mk g₀ hg rfl
    let H₀ : Polynomial.MonicDegreeEq (IsLocalRing.ResidueField A) h₀.natDegree :=
      Polynomial.MonicDegreeEq.mk h₀ hh rfl
    have hq : (G₀ : Polynomial (IsLocalRing.ResidueField A)) * (H₀ : Polynomial _) =
        Polynomial.map (algebraMap A (IsLocalRing.ResidueField A)) (p : Polynomial A) ∧
        IsCoprime (G₀ : Polynomial (IsLocalRing.ResidueField A)) (H₀ : Polynomial _) := by
      refine ⟨?_, hc⟩
      rw [IsLocalRing.ResidueField.algebraMap_eq]
      exact hfac.symm
    obtain ⟨τ, hτ⟩ := s3 _ inferInstance
      ((Polynomial.UniversalCoprimeFactorizationRing.homEquiv (IsLocalRing.ResidueField A)
        _ _ hn p).symm ⟨(G₀, H₀), hq⟩)
    have nat : ∀ (ψ : A →ₐ[A] IsLocalRing.ResidueField A),
        (((Polynomial.UniversalCoprimeFactorizationRing.homEquiv (IsLocalRing.ResidueField A)
          _ _ hn p (ψ.comp τ)).1.1 : Polynomial.MonicDegreeEq _ _) : Polynomial _) =
        (((Polynomial.UniversalCoprimeFactorizationRing.homEquiv A _ _ hn p τ).1.1 :
          Polynomial.MonicDegreeEq A _) : Polynomial A).map (ψ : A →+* IsLocalRing.ResidueField A) ∧
        (((Polynomial.UniversalCoprimeFactorizationRing.homEquiv (IsLocalRing.ResidueField A)
          _ _ hn p (ψ.comp τ)).1.2 : Polynomial.MonicDegreeEq _ _) : Polynomial _) =
        (((Polynomial.UniversalCoprimeFactorizationRing.homEquiv A _ _ hn p τ).1.2 :
          Polynomial.MonicDegreeEq A _) : Polynomial A).map (ψ : A →+* IsLocalRing.ResidueField A) := by
      intro ψ
      constructor
      · show (((Polynomial.UniversalFactorizationRing.factor₁ _ _ hn p).map
            (((ψ.comp τ).comp (IsScalarTower.toAlgHom A
              (Polynomial.UniversalFactorizationRing g₀.natDegree h₀.natDegree hn p)
              (Polynomial.UniversalCoprimeFactorizationRing g₀.natDegree h₀.natDegree hn p)) :
              Polynomial.UniversalFactorizationRing g₀.natDegree h₀.natDegree hn p →+*
                IsLocalRing.ResidueField A)) : Polynomial.MonicDegreeEq _ _) : Polynomial _) =
          (((Polynomial.UniversalFactorizationRing.factor₁ _ _ hn p).map
            ((τ.comp (IsScalarTower.toAlgHom A
              (Polynomial.UniversalFactorizationRing g₀.natDegree h₀.natDegree hn p)
              (Polynomial.UniversalCoprimeFactorizationRing g₀.natDegree h₀.natDegree hn p)) :
              Polynomial.UniversalFactorizationRing g₀.natDegree h₀.natDegree hn p →+* A)) :
              Polynomial.MonicDegreeEq A _) : Polynomial A).map
                (ψ : A →+* IsLocalRing.ResidueField A)
        rw [Polynomial.MonicDegreeEq.map_coe, Polynomial.MonicDegreeEq.map_coe, Polynomial.map_map]
        rfl
      · show (((Polynomial.UniversalFactorizationRing.factor₂ _ _ hn p).map
            (((ψ.comp τ).comp (IsScalarTower.toAlgHom A
              (Polynomial.UniversalFactorizationRing g₀.natDegree h₀.natDegree hn p)
              (Polynomial.UniversalCoprimeFactorizationRing g₀.natDegree h₀.natDegree hn p)) :
              Polynomial.UniversalFactorizationRing g₀.natDegree h₀.natDegree hn p →+*
                IsLocalRing.ResidueField A)) : Polynomial.MonicDegreeEq _ _) : Polynomial _) =
          (((Polynomial.UniversalFactorizationRing.factor₂ _ _ hn p).map
            ((τ.comp (IsScalarTower.toAlgHom A
              (Polynomial.UniversalFactorizationRing g₀.natDegree h₀.natDegree hn p)
              (Polynomial.UniversalCoprimeFactorizationRing g₀.natDegree h₀.natDegree hn p)) :
              Polynomial.UniversalFactorizationRing g₀.natDegree h₀.natDegree hn p →+* A)) :
              Polynomial.MonicDegreeEq A _) : Polynomial A).map
                (ψ : A →+* IsLocalRing.ResidueField A)
        rw [Polynomial.MonicDegreeEq.map_coe, Polynomial.MonicDegreeEq.map_coe, Polynomial.map_map]
        rfl
    obtain ⟨nat1, nat2⟩ := nat (Algebra.ofId A (IsLocalRing.ResidueField A))
    have hφ : Polynomial.UniversalCoprimeFactorizationRing.homEquiv (IsLocalRing.ResidueField A)
        _ _ hn p ((Algebra.ofId A (IsLocalRing.ResidueField A)).comp τ) = ⟨(G₀, H₀), hq⟩ := by
      rw [hτ]
      exact Equiv.apply_symm_apply _ _
    rw [hφ, hofId] at nat1 nat2
    refine ⟨_, _, (Polynomial.UniversalCoprimeFactorizationRing.homEquiv A _ _ hn p τ).1.1.monic,
      (Polynomial.UniversalCoprimeFactorizationRing.homEquiv A _ _ hn p τ).1.2.monic, ?_,
      nat1.symm, nat2.symm⟩
    rw [(Polynomial.UniversalCoprimeFactorizationRing.homEquiv A _ _ hn p τ).2.1,
      Algebra.algebraMap_self, Polynomial.map_id]
    rfl

  have s5 : ∀ (q : Polynomial (IsLocalRing.ResidueField A)), q.Monic →
      ∃ (a : ℕ) (r : Polynomial (IsLocalRing.ResidueField A)), r.Monic ∧
        q = Polynomial.X ^ a * r ∧ r.coeff 0 ≠ 0 ∧
        IsCoprime ((Polynomial.X : Polynomial (IsLocalRing.ResidueField A)) ^ a) r := by
    intro q hq
    obtain ⟨r, hr, hnd⟩ :=
      Polynomial.exists_eq_pow_rootMultiplicity_mul_and_not_dvd q hq.ne_zero 0
    rw [map_zero, sub_zero] at hr hnd
    refine ⟨_, r, ?_, hr, ?_, ?_⟩
    · exact (Polynomial.monic_X_pow _).of_mul_monic_left (hr ▸ hq)
    · intro h
      exact hnd (Polynomial.X_dvd_iff.mpr h)
    · exact IsCoprime.pow_left ((Irreducible.coprime_iff_not_dvd Polynomial.irreducible_X).mpr hnd)

  obtain ⟨b, hb1, hb2⟩ :=
    wc_proper_local_closed_fibre_clopen_lift A X g T₁ T₂ hT₁ hT₂ hdisj hunion
  let φ : A →+* Γ(X, ⊤) := g.appTop.hom.comp (Scheme.ΓSpecIso (.of A)).inv.hom
  have hφ : φ.IsIntegral := by
    have h1 : g.appTop.hom.IsIntegral := isIntegral_appTop_of_universallyClosed g
    have h2 : (Scheme.ΓSpecIso (.of A)).inv.hom.IsIntegral := by
      apply RingHom.isIntegral_of_surjective
      intro x
      exact ⟨(Scheme.ΓSpecIso (.of A)).hom.hom x, by simp⟩
    exact RingHom.IsIntegral.trans _ _ h2 h1
  obtain ⟨P, hPm, hPb⟩ := hφ b
  obtain ⟨a, r, hr, hsplit, hr0, hcop⟩ := s5 (P.map (IsLocalRing.residue A)) (hPm.map _)
  obtain ⟨G, H, -, -, hPGH, hGr, hHr⟩ :=
    s4 P (Polynomial.X ^ a) r hPm (Polynomial.monic_X_pow a) hr hcop hsplit
  have hβγ : G.eval₂ φ b * H.eval₂ φ b = 0 := by
    rw [← Polynomial.eval₂_mul, ← hPGH]
    exact hPb
  have hdisjD : ∀ x : X, x ∈ X.basicOpen (G.eval₂ φ b) → x ∈ X.basicOpen (H.eval₂ φ b) →
      False := by
    intro x h1 h2
    have h3 : x ∈ X.basicOpen (G.eval₂ φ b * H.eval₂ φ b) := by
      rw [Scheme.basicOpen_mul]
      exact ⟨h1, h2⟩
    rw [hβγ, Scheme.basicOpen_zero] at h3
    simp at h3
  have hevz : ∀ (x : X) (f : Γ(X, ⊤)),
      (X.evaluation ⊤ x trivial).hom f = 0 ↔ x ∉ X.basicOpen f := fun x f =>
    Scheme.evaluation_eq_zero_iff_notMem_basicOpen X (U := ⊤) x trivial f

  have hev : ∀ x : X, g x = IsLocalRing.closedPoint A →
      ∃ ι : IsLocalRing.ResidueField A →+* X.residueField x, ∀ Q : Polynomial A,
        (X.evaluation ⊤ x trivial).hom (Q.eval₂ φ b) =
          (Q.map (IsLocalRing.residue A)).eval₂ ι ((X.evaluation ⊤ x trivial).hom b) := by
    intro x hx
    let ψ : A →+* X.residueField x := (X.evaluation ⊤ x trivial).hom.comp φ
    have hker : ∀ c ∈ IsLocalRing.maximalIdeal A, ψ c = 0 := by
      intro c hc
      apply (hevz x (φ c)).mpr
      intro hmem
      have h1 : x ∈ g ⁻¹ᵁ (Spec (.of A)).basicOpen ((Scheme.ΓSpecIso (.of A)).inv.hom c) := by
        rw [Scheme.preimage_basicOpen_top]
        exact hmem
      have h2 : g x ∈ (Spec (.of A)).basicOpen ((Scheme.ΓSpecIso (.of A)).inv.hom c) := h1
      rw [basicOpen_eq_of_affine, hx] at h2
      exact (PrimeSpectrum.mem_basicOpen _ _).mp h2 hc
    haveI : IsLocalHom ψ := ⟨fun c hc => by
      by_contra hnc
      have h0 := hker c ((IsLocalRing.mem_maximalIdeal c).mpr hnc)
      rw [h0] at hc
      exact not_isUnit_zero hc⟩
    refine ⟨IsLocalRing.ResidueField.lift ψ, fun Q => ?_⟩
    rw [Polynomial.eval₂_map, IsLocalRing.ResidueField.lift_comp_residue, Polynomial.hom_eval₂]
  have hfib : ∀ x : X, x ∈ T₁ ∪ T₂ → g x = IsLocalRing.closedPoint A := by
    intro x hx
    rw [hunion] at hx
    exact hx

  have hT₁β : ∀ x ∈ T₁, x ∈ X.basicOpen (G.eval₂ φ b) := by
    intro x hx
    obtain ⟨ι, hι⟩ := hev x (hfib x (Or.inl hx))
    have h1 : (X.evaluation ⊤ x trivial).hom (1 - b) = 0 := (hevz x (1 - b)).mpr (hb1 x hx)
    rw [map_sub, map_one, sub_eq_zero] at h1
    by_contra hn
    have h2 := (hevz x _).mpr hn
    rw [hι G, hGr, Polynomial.eval₂_X_pow, ← h1, one_pow] at h2
    exact one_ne_zero h2

  have hT₂γ : ∀ x ∈ T₂, x ∈ X.basicOpen (H.eval₂ φ b) := by
    intro x hx
    obtain ⟨ι, hι⟩ := hev x (hfib x (Or.inr hx))
    have h1 : (X.evaluation ⊤ x trivial).hom b = 0 := (hevz x b).mpr (hb2 x hx)
    by_contra hn
    have h2 := (hevz x _).mpr hn
    rw [hι H, hHr, h1, Polynomial.eval₂_at_zero] at h2
    exact hr0 ((map_eq_zero ι).mp h2)

  have hcover : ∀ z : X, z ∈ X.basicOpen (G.eval₂ φ b) ∨ z ∈ X.basicOpen (H.eval₂ φ b) := by
    intro z
    by_contra hz
    push_neg at hz
    let Z : Set X := ((X.basicOpen (G.eval₂ φ b) : Set X) ∪ X.basicOpen (H.eval₂ φ b))ᶜ
    have hZc : IsClosed Z :=
      ((X.basicOpen (G.eval₂ φ b)).isOpen.union (X.basicOpen (H.eval₂ φ b)).isOpen).isClosed_compl
    have hzZ : z ∈ Z := fun h => h.elim hz.1 hz.2
    have hgZ : IsClosed (g '' Z) := Scheme.Hom.isClosedMap g _ hZc
    have hs : IsLocalRing.closedPoint A ∈ g '' Z :=
      (IsLocalRing.specializes_closedPoint (g z)).mem_closed hgZ ⟨z, hzZ, rfl⟩
    obtain ⟨z', hz'Z, hz'⟩ := hs
    have hz'F : z' ∈ T₁ ∪ T₂ := by
      rw [hunion]
      exact hz'
    rcases hz'F with h | h
    · exact hz'Z (Or.inl (hT₁β z' h))
    · exact hz'Z (Or.inr (hT₂γ z' h))
  have hEq : (X.basicOpen (G.eval₂ φ b) : Set X) = (X.basicOpen (H.eval₂ φ b) : Set X)ᶜ := by
    ext x
    constructor
    · intro h1 h2
      exact hdisjD x h1 h2
    · intro h2
      exact (hcover x).resolve_right h2
  refine ⟨X.basicOpen (G.eval₂ φ b), ⟨?_, (X.basicOpen (G.eval₂ φ b)).isOpen⟩, ?_⟩
  · rw [hEq]
    exact (X.basicOpen (H.eval₂ φ b)).isOpen.isClosed_compl
  · intro x hx
    constructor
    · intro hβ
      have hxF : x ∈ T₁ ∪ T₂ := by
        rw [hunion]
        exact hx
      rcases hxF with h | h
      · exact h
      · exact (hdisjD x hβ (hT₂γ x h)).elim
    · intro h
      exact hT₁β x h

theorem wc_sepclosed_integral_closed_fibre_unique_lift : ∀ (A B : Type u) [CommRing A] [IsLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] [CommRing B] [IsLocalRing B] (ι : A →+* B), IsLocalHom ι → ι.IsIntegral → ∀ (X : Scheme.{u}) (g : X ⟶ Spec (.of A)) (x : X), g x = IsLocalRing.closedPoint A → ∃! z : ↥(Limits.pullback g (Spec.map (CommRingCat.ofHom ι))), Limits.pullback.fst g (Spec.map (CommRingCat.ofHom ι)) z = x ∧ Limits.pullback.snd g (Spec.map (CommRingCat.ofHom ι)) z = IsLocalRing.closedPoint B :=
by
  intro A B _ _ hsep _ _ ι hloc hint X g x hx
  classical
  letI : Algebra A B := ι.toAlgebra
  have hBloc : IsLocalHom (algebraMap A B) := hloc
  have hBint : Algebra.IsIntegral A B := ⟨hint⟩

  have s1 : ∀ (K : Type u) [Field K] [Algebra A K], IsLocalHom (algebraMap A K) →
      Subsingleton (PrimeSpectrum (TensorProduct A K B)) := by
    intro K _ _ hK
    haveI h1 : IsLocalRing (TensorProduct A B K) :=
      wc_local_tensor_integral A K B hsep hK hBloc hBint
    haveI h2 : IsLocalRing (TensorProduct A K B) :=
      (Algebra.TensorProduct.comm A B K).toRingEquiv.isLocalRing
    haveI h3 : Algebra.IsIntegral K (TensorProduct A K B) := Algebra.IsIntegral.tensorProduct A K B
    have hmax : ∀ P : PrimeSpectrum (TensorProduct A K B),
        P.asIdeal = IsLocalRing.maximalIdeal (TensorProduct A K B) := by
      intro P
      have hc : (Ideal.comap (algebraMap K (TensorProduct A K B)) P.asIdeal).IsMaximal := by
        rw [Ideal.eq_bot_of_prime (Ideal.comap (algebraMap K (TensorProduct A K B)) P.asIdeal)]
        exact Ideal.bot_isMaximal
      have hP : P.asIdeal.IsMaximal := Ideal.isMaximal_of_isIntegral_of_isMaximal_comap _
        (fun t => Algebra.IsIntegral.isIntegral t) _ hc
      exact IsLocalRing.eq_maximalIdeal hP
    exact ⟨fun P Q => PrimeSpectrum.ext ((hmax P).trans (hmax Q).symm)⟩

  have hsm : Spec.map (CommRingCat.ofHom ι) (IsLocalRing.closedPoint B) =
      IsLocalRing.closedPoint A :=
    (Spec.map_apply _ _).trans (IsLocalRing.comap_closedPoint ι)
  obtain ⟨z₀, hz₀1, hz₀2⟩ := Scheme.Pullback.exists_preimage_pullback (f := g)
    (g := Spec.map (CommRingCat.ofHom ι)) x (IsLocalRing.closedPoint B)
    (hx.trans hsm.symm)

  let f' := X.fromSpecResidueField x
  let h : Spec (X.residueField x) ⟶ Spec (.of A) := f' ≫ g
  have hpt : ∀ p, h p = IsLocalRing.closedPoint A := by
    intro p
    show g (f' p) = _
    rw [Scheme.fromSpecResidueField_apply]
    exact hx
  let φ := Spec.preimage h
  letI : Algebra A (X.residueField x) := φ.hom.toAlgebra
  have hφ : Spec.map φ = h := Spec.map_preimage h
  have hKloc : IsLocalHom (algebraMap A (X.residueField x)) := by
    rw [IsLocalRing.isLocalHom_iff_comap_closedPoint]
    have := hpt (IsLocalRing.closedPoint (X.residueField x))
    rw [← hφ] at this
    exact (Spec.map_apply φ _).symm.trans this
  haveI hsub := s1 (X.residueField x) hKloc
  have e₁ : h = Spec.map (CommRingCat.ofHom (algebraMap A (X.residueField x))) := hφ.symm
  have e₂ : Spec.map (CommRingCat.ofHom ι) = Spec.map (CommRingCat.ofHom (algebraMap A B)) := rfl
  let E : Limits.pullback h (Spec.map (CommRingCat.ofHom ι)) ≅
      Spec (.of (TensorProduct A (X.residueField x) B)) :=
    Limits.pullback.congrHom e₁ e₂ ≪≫ pullbackSpecIso A (X.residueField x) B
  have hsub2 : ∀ a b : ↥(Limits.pullback h (Spec.map (CommRingCat.ofHom ι))), a = b := by
    intro a b
    have hab : E.hom a = E.hom b :=
      Subsingleton.elim (α := PrimeSpectrum (TensorProduct A (X.residueField x) B)) _ _
    rw [← Scheme.hom_inv_apply E a, ← Scheme.hom_inv_apply E b, hab]

  let I := Limits.pullbackRightPullbackFstIso g (Spec.map (CommRingCat.ofHom ι)) f'
  have hlift : ∀ z : ↥(Limits.pullback g (Spec.map (CommRingCat.ofHom ι))),
      Limits.pullback.fst g (Spec.map (CommRingCat.ofHom ι)) z = x →
      ∃ w : ↥(Limits.pullback f' (Limits.pullback.fst g (Spec.map (CommRingCat.ofHom ι)))),
        Limits.pullback.snd f' (Limits.pullback.fst g (Spec.map (CommRingCat.ofHom ι))) w = z := by
    intro z hz
    obtain ⟨w, -, hw⟩ := Scheme.Pullback.exists_preimage_pullback
      (f := f') (g := Limits.pullback.fst g (Spec.map (CommRingCat.ofHom ι)))
      (IsLocalRing.closedPoint (X.residueField x)) z
      ((Scheme.fromSpecResidueField_apply x _).trans hz.symm)
    exact ⟨w, hw⟩
  refine ⟨z₀, ⟨hz₀1, hz₀2⟩, ?_⟩
  rintro z ⟨hz1, -⟩
  obtain ⟨w, rfl⟩ := hlift z hz1
  obtain ⟨w₀, hw₀⟩ := hlift z₀ hz₀1
  have hww : w = w₀ := by
    rw [← Scheme.hom_inv_apply I w, ← Scheme.hom_inv_apply I w₀, hsub2 (I.hom w) (I.hom w₀)]
  rw [hww, hw₀]

theorem wc_integrally_closed_in_algclosed_field : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (R : Type u) [CommRing R] [IsDomain R] (ψ : R →+* Ω), Function.Injective ψ → (∀ x : Ω, (∃ p : Polynomial R, p.Monic ∧ p.eval₂ ψ x = 0) → x ∈ ψ.range) → IsIntegrallyClosed R ∧ IsAlgClosed (FractionRing R) :=
by
  intro Ω _ _ R _ _ ψ hψ H
  classical
  let L : FractionRing R →+* Ω := IsFractionRing.lift hψ
  have hLa : ∀ r : R, L (algebraMap R (FractionRing R) r) = ψ r :=
    fun r => IsFractionRing.lift_algebraMap hψ r
  have hLc : L.comp (algebraMap R (FractionRing R)) = ψ := RingHom.ext hLa
  have hLinj : Function.Injective L := L.injective
  have hψ0 : ∀ x : R, ψ x = 0 → x = 0 := fun x h => hψ (h.trans (map_zero ψ).symm)
  refine ⟨?_, ?_⟩
  · rw [isIntegrallyClosed_iff (FractionRing R)]
    rintro x ⟨p, hpm, hp⟩
    have hp' : p.eval₂ ψ (L x) = 0 := by
      rw [← hLc, ← Polynomial.hom_eval₂, hp, map_zero]
    obtain ⟨r, hr⟩ := RingHom.mem_range.mp (H (L x) ⟨p, hpm, hp'⟩)
    exact ⟨r, hLinj (by rw [hLa, hr])⟩
  · apply IsAlgClosed.of_exists_root
    intro p hpm hirr
    have hdeg : p.degree ≠ 0 := (Polynomial.degree_pos_of_irreducible hirr).ne'
    obtain ⟨y, hy⟩ := IsAlgClosed.exists_eval₂_eq_zero L p hdeg
    have hq : (IsLocalization.integerNormalization (nonZeroDivisors R) p).eval₂ ψ y = 0 := by
      have := IsLocalization.integerNormalization_eval₂_eq_zero (nonZeroDivisors R) L p hy
      rwa [hLc] at this
    have hq0 : IsLocalization.integerNormalization (nonZeroDivisors R) p ≠ 0 := by
      intro h
      exact hpm.ne_zero ((IsLocalization.integerNormalization_eq_zero_iff (le_refl _) p).mp h)
    have hmon := Polynomial.monic_integralNormalization hq0
    have hev := Polynomial.integralNormalization_eval₂_eq_zero ψ hq hψ0
    obtain ⟨r, hr⟩ := RingHom.mem_range.mp (H _ ⟨_, hmon, hev⟩)
    have hc : (IsLocalization.integerNormalization (nonZeroDivisors R) p).leadingCoeff ≠ 0 :=
      Polynomial.leadingCoeff_ne_zero.mpr hq0
    have hψc : ψ (IsLocalization.integerNormalization (nonZeroDivisors R) p).leadingCoeff ≠ 0 :=
      fun h => hc (hψ0 _ h)
    refine ⟨algebraMap R (FractionRing R) r /
      algebraMap R (FractionRing R) (IsLocalization.integerNormalization (nonZeroDivisors R) p).leadingCoeff, ?_⟩
    have hLx : L (algebraMap R (FractionRing R) r /
        algebraMap R (FractionRing R) (IsLocalization.integerNormalization (nonZeroDivisors R) p).leadingCoeff) = y := by
      rw [map_div₀, hLa, hLa, hr]
      field_simp
    apply hLinj
    rw [map_zero, Polynomial.eval, Polynomial.hom_eval₂, hLx]
    simpa using hy

theorem wc_smooth_proper_normal_algclosed_base_geom_clopen : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsIntegrallyClosed R] [IsAlgClosed (FractionRing R)] (Y : Scheme.{u}) (h : Y ⟶ Spec (.of R)) [IsProper h], Smooth h → ∀ (Ω : Type u) [Field Ω] (ψ : R →+* Ω), Function.Injective ψ → ∀ (W : Scheme.{u}) (q : W ⟶ Y) (r : W ⟶ Spec (.of Ω)), IsPullback q r h (Spec.map (CommRingCat.ofHom ψ)) → ∀ C' : Set W, IsClopen C' → ∃ C : Set Y, IsClopen C ∧ q ⁻¹' C = C' :=
by

  have s1 : ∀ (Y W : Type u) [TopologicalSpace Y] [TopologicalSpace W] (q : W → Y), Dense (Set.range q) → ∀ C' : Set W, (∀ y : Y, ∃ U D : Set Y, IsOpen U ∧ y ∈ U ∧ IsOpen D ∧ IsOpen (U \ D) ∧ D ⊆ U ∧ q ⁻¹' D = C' ∩ q ⁻¹' U) → ∃ C : Set Y, IsClopen C ∧ q ⁻¹' C = C' := by
    intro Y W _ _ q hd C' hloc
    let G : Set (Set Y × Set Y) := {p | IsOpen p.1 ∧ IsOpen p.2 ∧ IsOpen (p.1 \ p.2) ∧ p.2 ⊆ p.1 ∧
      q ⁻¹' p.2 = C' ∩ q ⁻¹' p.1}
    have hcons : ∀ p₁ ∈ G, ∀ p₂ ∈ G, p₁.2 ∩ p₂.1 ⊆ p₂.2 := by
      rintro p₁ ⟨-, hD₁, -, -, hq₁⟩ p₂ ⟨-, -, hUD₂, -, hq₂⟩ x ⟨hx1, hx2⟩
      by_contra hx3
      have hS : IsOpen (p₁.2 ∩ (p₂.1 \ p₂.2)) := hD₁.inter hUD₂
      obtain ⟨z, ⟨hz1, hz2, hz3⟩, ⟨w, rfl⟩⟩ :=
        hd.inter_open_nonempty _ hS ⟨x, hx1, hx2, hx3⟩
      have hw1 : w ∈ q ⁻¹' p₁.2 := hz1
      rw [hq₁] at hw1
      have hw2 : w ∈ C' ∩ q ⁻¹' p₂.1 := ⟨hw1.1, hz2⟩
      rw [← hq₂] at hw2
      exact hz3 hw2
    let C : Set Y := ⋃ p ∈ G, p.2
    have hres : ∀ p₀ ∈ G, ∀ y, y ∈ C → y ∈ p₀.1 → y ∈ p₀.2 := by
      intro p₀ hp₀ y hy hy0
      obtain ⟨p, hp, hyp⟩ := Set.mem_iUnion₂.mp hy
      exact hcons p hp p₀ hp₀ ⟨hyp, hy0⟩
    have hgood : ∀ y, ∃ p ∈ G, y ∈ p.1 := by
      intro y
      obtain ⟨U, D, hU, hy, hD, hUD, hDU, hq⟩ := hloc y
      exact ⟨(U, D), ⟨hU, hD, hUD, hDU, hq⟩, hy⟩
    refine ⟨C, ⟨?_, ?_⟩, ?_⟩
    · rw [← isOpen_compl_iff, isOpen_iff_forall_mem_open]
      intro y hy
      obtain ⟨p, hp, hyp⟩ := hgood y
      refine ⟨p.1 \ p.2, ?_, hp.2.2.1, ⟨hyp, fun h => hy (Set.mem_iUnion₂.mpr ⟨p, hp, h⟩)⟩⟩
      rintro z ⟨hz1, hz2⟩ hzC
      exact hz2 (hres p hp z hzC hz1)
    · exact isOpen_biUnion (fun p hp => hp.2.1)
    · ext w
      constructor
      · intro hw
        obtain ⟨p, hp, hwp⟩ := Set.mem_iUnion₂.mp hw
        have h1 : w ∈ q ⁻¹' p.2 := hwp
        rw [hp.2.2.2.2] at h1
        exact h1.1
      · intro hw
        obtain ⟨p, hp, hyp⟩ := hgood (q w)
        have h1 : w ∈ C' ∩ q ⁻¹' p.1 := ⟨hw, hyp⟩
        rw [← hp.2.2.2.2] at h1
        exact Set.mem_iUnion₂.mpr ⟨p, hp, h1⟩

  have s2 : ∀ (R : Type u) [CommRing R] [IsDomain R] (Y : Scheme.{u}) (h : Y ⟶ Spec (.of R)), Smooth h → ∀ (Ω : Type u) [Field Ω] (ψ : R →+* Ω), Function.Injective ψ → ∀ (W : Scheme.{u}) (q : W ⟶ Y) (r : W ⟶ Spec (.of Ω)), IsPullback q r h (Spec.map (CommRingCat.ofHom ψ)) → Dense (Set.range q) := by
    intro R _ _ Y h hsm Ω _ ψ hψ W q r hpb
    haveI : Flat h := by
      rw [HasRingHomProperty.iff_appLE (P := @Flat)]
      intro U V e
      exact RingHom.Smooth.flat (Smooth.smooth_appLE h U.2 V.2 e)
    rw [dense_iff_inter_open]
    rintro V hV ⟨y, hyV⟩
    let z : Spec (.of Ω) := IsLocalRing.closedPoint Ω
    have hη : Spec.map (CommRingCat.ofHom ψ) z ⤳ h y := by
      refine (PrimeSpectrum.le_iff_specializes (Spec.map (CommRingCat.ofHom ψ) z) (h y)).mp ?_
      intro x hx
      have hx' : ψ x ∈ z.asIdeal := hx
      rw [Ideal.eq_bot_of_prime z.asIdeal, Ideal.mem_bot] at hx'
      have : x = 0 := hψ (by rw [hx', map_zero])
      rw [this]
      exact Ideal.zero_mem _
    obtain ⟨y', hy', hhy'⟩ := Flat.generalizingMap h hη
    refine ⟨y', hy'.mem_open hV hyV, ?_⟩
    have hmem : y' ∈ Set.range (Limits.pullback.fst h (Spec.map (CommRingCat.ofHom ψ))) := by
      rw [Scheme.Pullback.range_fst]
      exact ⟨z, hhy'.symm⟩
    obtain ⟨p, hp⟩ := hmem
    refine ⟨hpb.isoPullback.inv p, ?_⟩
    rw [← Scheme.Hom.comp_apply, hpb.isoPullback_inv_fst, hp]

  have s3 : ∀ (R : Type u) [CommRing R] (Y : Scheme.{u}) (h : Y ⟶ Spec (.of R)), Smooth h → ∀ (Ω : Type u) [CommRing Ω] (ψ : R →+* Ω) (W : Scheme.{u}) (q : W ⟶ Y) (r : W ⟶ Spec (.of Ω)), IsPullback q r h (Spec.map (CommRingCat.ofHom ψ)) → ∀ y : Y, ∃ (A : Type u) (_ : CommRing A) (φ : R →+* A) (W' : Scheme.{u}) (q' : W' ⟶ Spec (.of A)) (r' : W' ⟶ Spec (.of Ω)) (j : Spec (.of A) ⟶ Y) (k : W' ⟶ W), φ.Smooth ∧ IsPullback q' r' (Spec.map (CommRingCat.ofHom φ)) (Spec.map (CommRingCat.ofHom ψ)) ∧ IsOpenImmersion j ∧ IsOpenImmersion k ∧ y ∈ Set.range j ∧ k ≫ q = q' ≫ j ∧ Set.range k = q ⁻¹' Set.range j := by
    intro R _ Y h hsm Ω _ ψ W q r hpb y
    haveI := hsm
    obtain ⟨U', hU', hyU', -⟩ :=
      (TopologicalSpace.Opens.isBasis_iff_nbhd.mp Y.isBasis_affineOpens) (show y ∈ (⊤ : Y.Opens) from trivial)
    have hU'a : IsAffineOpen U' := hU'
    let e : U' ≤ h ⁻¹ᵁ ⊤ := fun _ _ => trivial
    let φ : R →+* Γ(Y, U') := ((Scheme.ΓSpecIso (.of R)).inv ≫ h.appLE ⊤ U' e).hom
    have hφ : φ.Smooth := by
      refine RingHom.Smooth.comp ?_ (Smooth.smooth_appLE h (isAffineOpen_top _) hU'a e)
      exact RingHom.Smooth.of_bijective (ConcreteCategory.bijective_of_isIso (Scheme.ΓSpecIso (.of R)).inv)
    let j : Spec (.of Γ(Y, U')) ⟶ Y := hU'a.fromSpec
    have hjh : j ≫ h = Spec.map (CommRingCat.ofHom φ) := by
      have h1 := IsAffineOpen.SpecMap_appLE_fromSpec h (isAffineOpen_top _) hU'a e
      rw [IsAffineOpen.fromSpec_top] at h1
      have h2 : (Spec (.of R)).isoSpec.inv = Spec.map (Scheme.ΓSpecIso (.of R)).inv := by
        rw [← cancel_epi (Spec (.of R)).isoSpec.hom, Iso.hom_inv_id, Scheme.isoSpec_Spec_hom,
          ← Spec.map_comp, Iso.inv_hom_id, Spec.map_id]
      rw [h2] at h1
      change hU'a.fromSpec ≫ h = _
      rw [← h1, CommRingCat.ofHom_hom, Spec.map_comp]
    let W' := Limits.pullback (Spec.map (CommRingCat.ofHom φ)) (Spec.map (CommRingCat.ofHom ψ))
    let q' : W' ⟶ Spec (.of Γ(Y, U')) := Limits.pullback.fst _ _
    let r' : W' ⟶ Spec (.of Ω) := Limits.pullback.snd _ _
    have hpb' : IsPullback q' r' (Spec.map (CommRingCat.ofHom φ)) (Spec.map (CommRingCat.ofHom ψ)) :=
      IsPullback.of_hasPullback _ _
    let k : W' ⟶ W := hpb.lift (q' ≫ j) r' (by rw [Category.assoc, hjh]; exact hpb'.w)
    have hkq : k ≫ q = q' ≫ j := hpb.lift_fst _ _ _
    have hkr : k ≫ r = r' := hpb.lift_snd _ _ _
    have hleft : IsPullback q' k j q := by
      refine IsPullback.of_bot ?_ hkq.symm hpb
      rw [hkr, hjh]
      exact hpb'
    haveI hj : IsOpenImmersion j := hU'a.isOpenImmersion_fromSpec
    have hk : IsOpenImmersion k := MorphismProperty.of_isPullback (P := @IsOpenImmersion) hleft hj
    refine ⟨Γ(Y, U'), inferInstance, φ, W', q', r', j, k, hφ, hpb', hj, hk, ?_, hkq, ?_⟩
    · rw [hU'a.range_fromSpec]; exact hyU'
    · ext w
      constructor
      · rintro ⟨w', rfl⟩
        refine ⟨q' w', ?_⟩
        rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, hkq]
      · rintro ⟨a, ha⟩
        have hmem : w ∈ Set.range (Limits.pullback.fst q j) := by
          rw [Scheme.Pullback.range_fst]; exact ⟨a, ha⟩
        obtain ⟨p, hp⟩ := hmem
        refine ⟨hleft.flip.isoPullback.inv p, ?_⟩
        rw [← Scheme.Hom.comp_apply, hleft.flip.isoPullback_inv_fst, hp]

  have s4 : ∀ (R A : Type u) [CommRing R] [CommRing A] [Algebra R A] [Algebra.Smooth R A], ∃ T : Set A, Ideal.span T = ⊤ ∧ ∀ t ∈ T, ∃ (n : ℕ) (g : MvPolynomial (Fin n) R →+* Localization.Away t), g.comp MvPolynomial.C = algebraMap R (Localization.Away t) ∧ g.Etale := by
    intro R A _ _ _ _
    obtain ⟨T, hT, hloc⟩ := RingHom.Smooth.locally_isStandardSmooth ((RingHom.smooth_algebraMap).mpr ‹_›)
    refine ⟨T, hT, fun t ht => ?_⟩
    have h1 := hloc t ht
    rw [← IsScalarTower.algebraMap_eq] at h1
    rw [RingHom.isStandardSmooth_algebraMap] at h1
    obtain ⟨ι, σ, _, _, ⟨P⟩⟩ := h1.out
    have := P.isStandardSmoothOfRelativeDimension rfl
    obtain ⟨g, hg⟩ := Algebra.IsStandardSmoothOfRelativeDimension.exists_etale_mvPolynomial
      (R := R) (S := Localization.Away t) (n := P.dimension)
    refine ⟨P.dimension, g.toRingHom, ?_, hg⟩
    ext x
    simp

  have s6 : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsIntegrallyClosed R] (n : ℕ), IsIntegrallyClosed (MvPolynomial (Fin n) R) := by
    intro R _ _ _ n
    induction n with
    | zero => exact IsIntegrallyClosed.of_equiv (MvPolynomial.isEmptyAlgEquiv R (Fin 0)).symm.toRingEquiv
    | succ n ih =>
      have := ih
      exact IsIntegrallyClosed.of_equiv (MvPolynomial.finSuccEquiv R n).symm.toRingEquiv

  have s5 : ∀ (R A : Type u) [CommRing R] [IsDomain R] [IsIntegrallyClosed R] [CommRing A] [Algebra R A], (∀ n : ℕ, IsIntegrallyClosed (MvPolynomial (Fin n) R)) → ∀ T : Set A, Ideal.span T = ⊤ → (∀ t ∈ T, ∃ (n : ℕ) (g : MvPolynomial (Fin n) R →+* Localization.Away t), g.comp MvPolynomial.C = algebraMap R (Localization.Away t) ∧ g.Etale) → ∀ (a : A) (s : R), s ≠ 0 → a * a = s • a → ∃ a' : A, a = s • a' := by
    intro R A _ _ _ _ _ hMv T hT hch a s hs ha
    let I : Ideal A := Ideal.span {algebraMap R A s}
    suffices haI : a ∈ I by
      obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp haI
      exact ⟨c, by rw [Algebra.smul_def, ← hc, mul_comm]⟩
    refine Submodule.mem_of_span_eq_top_of_smul_pow_mem I T hT a (fun t => ?_)
    obtain ⟨n, g, hgC, hg⟩ := hch t.1 t.2
    have := hMv n
    letI : Algebra (MvPolynomial (Fin n) R) (Localization.Away t.1) := g.toAlgebra
    have : Algebra.Etale (MvPolynomial (Fin n) R) (Localization.Away t.1) := hg
    set c : Localization.Away t.1 := algebraMap A _ a with hc
    have hs' : (MvPolynomial.C s : MvPolynomial (Fin n) R) ≠ 0 := by
      rw [Ne, MvPolynomial.C_eq_zero]; exact hs
    have hcc : c * c = (MvPolynomial.C s : MvPolynomial (Fin n) R) • c := by
      rw [Algebra.smul_def, RingHom.algebraMap_toAlgebra]
      have e1 : g (MvPolynomial.C s) = algebraMap R (Localization.Away t.1) s := by
        rw [← hgC]; rfl
      rw [e1, IsScalarTower.algebraMap_apply R A (Localization.Away t.1), hc, ← map_mul, ← map_mul,
        ha, Algebra.smul_def]
    obtain ⟨c', hc'⟩ := wc_weaklyEtale_normal_idem (MvPolynomial (Fin n) R) (Localization.Away t.1)
      inferInstance c _ hs' hcc
    rw [Algebra.smul_def, RingHom.algebraMap_toAlgebra] at hc'
    have e1 : g (MvPolynomial.C s) = algebraMap A (Localization.Away t.1) (algebraMap R A s) := by
      rw [← IsScalarTower.algebraMap_apply, ← hgC]; rfl
    rw [e1] at hc'
    obtain ⟨⟨x, ⟨_, ⟨m, rfl⟩⟩⟩, hx⟩ := IsLocalization.surj (Submonoid.powers t.1) c'
    simp only at hx
    have key : algebraMap A (Localization.Away t.1) (a * t.1 ^ m) =
        algebraMap A (Localization.Away t.1) (algebraMap R A s * x) := by
      rw [map_mul, map_mul, ← hx, ← hc, hc']
      ring
    obtain ⟨⟨_, ⟨k, rfl⟩⟩, hk⟩ := IsLocalization.exists_of_eq (M := Submonoid.powers t.1) key
    simp only at hk
    refine ⟨k + m, ?_⟩
    have : t.1 ^ (k + m) • a = algebraMap R A s * (t.1 ^ k * x) := by
      rw [smul_eq_mul, pow_add]
      linear_combination hk
    rw [this]
    exact Ideal.mul_mem_right _ _ (Ideal.subset_span rfl)

  have s7 : ∀ (R A : Type u) [CommRing R] [IsDomain R] [CommRing A] [Algebra R A] [Module.Flat R A], (∀ (a : A) (s : R), s ≠ 0 → a * a = s • a → ∃ a' : A, a = s • a') → ∀ e : TensorProduct R (FractionRing R) A, IsIdempotentElem e → ∃ a : A, IsIdempotentElem a ∧ (1 : FractionRing R) ⊗ₜ[R] a = e := by
    intro R A _ _ _ _ _ hdiv e he
    classical
    let K := FractionRing R
    let ι : A →ₐ[R] TensorProduct R K A := Algebra.TensorProduct.includeRight
    have hι : ∀ a : A, ι a = (1 : K) ⊗ₜ[R] a := fun a => rfl
    have hinj : Function.Injective ι :=
      Algebra.TensorProduct.includeRight_injective (IsFractionRing.injective R K)
    have hclear : ∃ s : R, s ≠ 0 ∧ ∃ c : A, s • e = ι c := by
      obtain ⟨S, hS⟩ := TensorProduct.exists_finset e
      obtain ⟨⟨s, hsR⟩, hsint⟩ := IsLocalization.exist_integer_multiples_of_finset
        (nonZeroDivisors R) (S.image Prod.fst)
      have hint : ∀ i ∈ S, ∃ r : R, algebraMap R K r = s • i.1 := fun i hi =>
        hsint i.1 (Finset.mem_image_of_mem _ hi)
      choose r hr using hint
      refine ⟨s, nonZeroDivisors.ne_zero hsR, ∑ i ∈ S.attach, r i.1 i.2 • i.1.2, ?_⟩
      rw [hS, Finset.smul_sum, map_sum, ← Finset.sum_attach S]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [hι, TensorProduct.smul_tmul', ← hr i.1 i.2, TensorProduct.tmul_smul,
        Algebra.algebraMap_eq_smul_one, TensorProduct.smul_tmul']
    obtain ⟨s, hs, c, hsc⟩ := hclear
    have he' : e * e = e := he
    have hcc : c * c = s • c := by
      apply hinj
      rw [map_mul, map_smul, ← hsc, smul_mul_smul_comm, he', mul_smul]
    obtain ⟨a, rfl⟩ := hdiv c s hs hcc
    have hunit : IsUnit (algebraMap R (TensorProduct R K A) s) := by
      rw [IsScalarTower.algebraMap_apply R K (TensorProduct R K A)]
      refine IsUnit.map _ ?_
      exact IsUnit.mk0 _ ((map_ne_zero_iff _ (IsFractionRing.injective R K)).mpr hs)
    have hea : e = ι a := by
      rw [map_smul] at hsc
      have h2 : algebraMap R (TensorProduct R K A) s * e = algebraMap R (TensorProduct R K A) s * ι a := by
        rw [← Algebra.smul_def, ← Algebra.smul_def]; exact hsc
      exact hunit.mul_left_cancel h2
    refine ⟨a, ?_, hea.symm⟩
    apply hinj
    show ι (a * a) = ι a
    rw [map_mul, ← hea, he']

  have s8 : ∀ (B : Type u) [CommRing B] [IsNoetherianRing B], {b : B | IsIdempotentElem b}.Finite := by
    intro B _ _
    classical
    have hfin : (minimalPrimes B).Finite := minimalPrimes.finite_of_isNoetherianRing B
    have : Finite (minimalPrimes B) := hfin.to_subtype
    refine Set.Finite.of_finite_image (f := fun e => fun p : minimalPrimes B => decide (e ∈ (p : Ideal B)))
      (Set.toFinite _) ?_
    intro e he f hf heq
    have he' : e * e = e := he
    have hf' : f * f = f := hf
    have hmin : ∀ p ∈ minimalPrimes B, e - f ∈ p := by
      intro p hp
      have hpp : p.IsPrime := hp.1.1
      have h := congrFun heq ⟨p, hp⟩
      simp only [decide_eq_decide] at h
      by_cases hep : e ∈ p
      · exact p.sub_mem hep (h.mp hep)
      · have hfp : f ∉ p := fun hf => hep (h.mpr hf)
        have h1e : 1 - e ∈ p := by
          have : e * (1 - e) ∈ p := by
            rw [mul_sub, mul_one, he', sub_self]; exact p.zero_mem
          exact (hpp.mem_or_mem this).resolve_left hep
        have h1f : 1 - f ∈ p := by
          have : f * (1 - f) ∈ p := by
            rw [mul_sub, mul_one, hf', sub_self]; exact p.zero_mem
          exact (hpp.mem_or_mem this).resolve_left hfp
        have : e - f = (1 - f) - (1 - e) := by ring
        rw [this]
        exact p.sub_mem h1f h1e
    have hnil : IsNilpotent (e - f) := by
      rw [nilpotent_iff_mem_prime]
      intro J hJ
      obtain ⟨p, hp, hpJ⟩ := Ideal.exists_minimalPrimes_le (bot_le : (⊥ : Ideal B) ≤ J)
      exact hpJ (hmin p hp)
    set d := e - f with hd
    have hd3 : d * (d * d) = d := by
      rw [hd]; linear_combination (e + 1 - 3 * f) * he' + (3 * e - f - 1) * hf'
    have hidem : IsIdempotentElem (d * d) := by
      show d * d * (d * d) = d * d
      calc d * d * (d * d) = d * (d * (d * d)) := by ring
        _ = d * d := by rw [hd3]
    have hnil2 : IsNilpotent (d * d) := Commute.isNilpotent_mul_left (Commute.refl d) hnil
    have h0 : d * d = 0 := hidem.eq_zero_of_isNilpotent hnil2
    have : d = 0 := by rw [← hd3, h0, mul_zero]
    exact sub_eq_zero.mp this

  have s9 : ∀ (K Ω₀ : Type u) [Field K] [IsAlgClosed K] [CommRing Ω₀] [Algebra K Ω₀] [Algebra.FiniteType K Ω₀] (c : Ω₀), ¬ IsNilpotent c → ∃ χ : Ω₀ →ₐ[K] K, χ c ≠ 0 := by
    intro K Ω₀ _ _ _ _ _ c hc
    have : IsJacobsonRing Ω₀ := isJacobsonRing_of_finiteType (A := K)
    have hc' : c ∉ (⊥ : Ideal Ω₀).jacobson := by
      rw [← Ideal.radical_eq_jacobson]
      intro h
      exact hc (by simpa [Ideal.mem_radical_iff, IsNilpotent] using h)
    rw [Ideal.jacobson, Ideal.mem_sInf] at hc'
    push_neg at hc'
    obtain ⟨m, ⟨-, hm⟩, hcm⟩ := hc'
    have := hm
    letI : Field (Ω₀ ⧸ m) := Ideal.Quotient.field m
    have : Algebra.FiniteType K (Ω₀ ⧸ m) := inferInstance
    have : Module.Finite K (Ω₀ ⧸ m) := finite_of_finite_type_of_isJacobsonRing K (Ω₀ ⧸ m)
    have hbij : Function.Bijective (algebraMap K (Ω₀ ⧸ m)) :=
      IsAlgClosed.algebraMap_bijective_of_isIntegral
    let ε := AlgEquiv.ofBijective (Algebra.ofId K (Ω₀ ⧸ m)) hbij
    refine ⟨(ε.symm : (Ω₀ ⧸ m) →ₐ[K] K).comp (Ideal.Quotient.mkₐ K m), ?_⟩
    intro h0
    apply hcm
    have h1 : Ideal.Quotient.mkₐ K m c = 0 := by
      have := congrArg ε h0
      simpa using this
    exact Ideal.Quotient.eq_zero_iff_mem.mp h1

  have s10 : ∀ (K Ω₀ B : Type u) [Field K] [CommRing Ω₀] [IsDomain Ω₀] [Algebra K Ω₀] [CommRing B] [Algebra K B], (∀ c : Ω₀, c ≠ 0 → ∃ χ : Ω₀ →ₐ[K] K, χ c ≠ 0) → {b : B | IsIdempotentElem b}.Finite → ∀ e : TensorProduct K Ω₀ B, IsIdempotentElem e → ∃ b : B, IsIdempotentElem b ∧ (1 : Ω₀) ⊗ₜ[K] b = e := by
    intro K Ω₀ B _ _ _ _ _ _ hpts hfin e he
    classical
    have he' : e * e = e := he
    by_cases hA : ∃ b : B, IsIdempotentElem b ∧
        e + (1 : Ω₀) ⊗ₜ[K] b - 2 * (e * ((1 : Ω₀) ⊗ₜ[K] b)) = 0
    · obtain ⟨b, hb, hfb⟩ := hA
      refine ⟨b, hb, ?_⟩
      have hu : ((1 : Ω₀) ⊗ₜ[K] b) * ((1 : Ω₀) ⊗ₜ[K] b) = (1 : Ω₀) ⊗ₜ[K] b := by
        rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul, hb.eq]
      linear_combination ((1 : Ω₀) ⊗ₜ[K] b - e) * hfb + (1 - 2 * ((1 : Ω₀) ⊗ₜ[K] b)) * he'
        - (1 - 2 * e) * hu
    · exfalso
      push_neg at hA
      let β := Module.Basis.ofVectorSpace K B
      let Φ := TensorProduct.equivFinsuppOfBasisRight (M := Ω₀) β
      let ev : (Ω₀ →ₐ[K] K) → (TensorProduct K Ω₀ B →ₐ[K] B) := fun χ =>
        (Algebra.TensorProduct.lid K B).toAlgHom.comp (Algebra.TensorProduct.map χ (AlgHom.id K B))
      have hev1 : ∀ χ (b : B), ev χ ((1 : Ω₀) ⊗ₜ[K] b) = b := by
        intro χ b
        simp [ev]
      have hrep : ∀ χ (z : TensorProduct K Ω₀ B) k, β.repr (ev χ z) k = χ (Φ z k) := by
        intro χ z k
        induction z using TensorProduct.induction_on with
        | zero => simp
        | tmul ω b =>
          have e1 : ev χ (ω ⊗ₜ[K] b) = χ ω • b := by simp [ev]
          rw [e1, map_smul, Finsupp.smul_apply, smul_eq_mul,
            TensorProduct.equivFinsuppOfBasisRight_apply_tmul, Finsupp.mapRange_apply, map_smul,
            smul_eq_mul, mul_comm]
        | add x y hx hy =>
          rw [map_add, map_add, Finsupp.add_apply, hx, hy, map_add, Finsupp.add_apply, map_add]
      set E := hfin.toFinset with hE
      let f : B → TensorProduct K Ω₀ B := fun b => e + (1 : Ω₀) ⊗ₜ[K] b - 2 * (e * ((1 : Ω₀) ⊗ₜ[K] b))
      have hk : ∀ b ∈ E, ∃ k, Φ (f b) k ≠ 0 := by
        intro b hb
        have hb' : IsIdempotentElem b := hfin.mem_toFinset.mp hb
        have hne : Φ (f b) ≠ 0 := by
          intro h0
          exact hA b hb' (Φ.injective (h0.trans (map_zero Φ).symm))
        by_contra hcon
        push_neg at hcon
        exact hne (Finsupp.ext hcon)
      choose k hk using hk
      let c : Ω₀ := ∏ b ∈ E.attach, Φ (f b.1) (k b.1 b.2)
      have hc : c ≠ 0 := Finset.prod_ne_zero_iff.mpr (fun b _ => hk b.1 b.2)
      obtain ⟨χ, hχ⟩ := hpts c hc
      rw [map_prod] at hχ
      have hall := Finset.prod_ne_zero_iff.mp hχ
      set b0 := ev χ e with hb0
      have hb0i : IsIdempotentElem b0 := he.map (ev χ)
      have hb0E : b0 ∈ E := hfin.mem_toFinset.mpr hb0i
      have hzero : ev χ (f b0) = 0 := by
        simp only [f, map_sub, map_add, map_mul, map_ofNat, hev1, ← hb0]
        rw [hb0i.eq]
        ring
      have h1 := hall ⟨b0, hb0E⟩ (Finset.mem_attach _ _)
      rw [← hrep, hzero, map_zero, Finsupp.zero_apply] at h1
      exact h1 rfl

  have s11 : ∀ (K Ω B : Type u) [Field K] [CommRing Ω] [Algebra K Ω] [CommRing B] [Algebra K B], (∀ Ω₀ : Subalgebra K Ω, Ω₀.FG → ∀ e : TensorProduct K Ω₀ B, IsIdempotentElem e → ∃ b : B, IsIdempotentElem b ∧ (1 : Ω₀) ⊗ₜ[K] b = e) → ∀ e : TensorProduct K Ω B, IsIdempotentElem e → ∃ b : B, IsIdempotentElem b ∧ (1 : Ω) ⊗ₜ[K] b = e := by
    intro K Ω B _ _ _ _ _ hfg e he
    classical
    obtain ⟨S, hS⟩ := TensorProduct.exists_finset e
    let Ω₀ : Subalgebra K Ω := Algebra.adjoin K ((S.image Prod.fst : Finset Ω) : Set Ω)
    have hΩ₀ : Ω₀.FG := Subalgebra.fg_adjoin_finset _
    have hmem : ∀ i ∈ S, i.1 ∈ Ω₀ := fun i hi =>
      Algebra.subset_adjoin (Finset.mem_coe.mpr (Finset.mem_image_of_mem _ hi))
    let e₀ : TensorProduct K Ω₀ B :=
      ∑ i ∈ S.attach, (⟨i.1.1, hmem i.1 i.2⟩ : Ω₀) ⊗ₜ[K] i.1.2
    let m : TensorProduct K Ω₀ B →ₐ[K] TensorProduct K Ω B :=
      Algebra.TensorProduct.map Ω₀.val (AlgHom.id K B)
    have hme : m e₀ = e := by
      rw [hS, map_sum]
      rw [← Finset.sum_attach S]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      simp [m]
    have hinj : Function.Injective m := by
      have : (m : TensorProduct K Ω₀ B → TensorProduct K Ω B) =
          LinearMap.rTensor B (Ω₀.val.toLinearMap) := by
        ext x
        induction x using TensorProduct.induction_on with
        | zero => simp
        | tmul a b => simp [m]
        | add x y hx hy => simp only [map_add] at hx hy ⊢; rw [hx, hy]
      rw [this]
      exact Module.Flat.rTensor_preserves_injective_linearMap _ Subtype.val_injective
    have he₀ : IsIdempotentElem e₀ := by
      apply hinj
      show m (e₀ * e₀) = m e₀
      rw [map_mul, hme]; exact he
    obtain ⟨b, hb, hbe⟩ := hfg Ω₀ hΩ₀ e₀ he₀
    refine ⟨b, hb, ?_⟩
    rw [← hme, ← hbe]
    simp [m]

  have s12 : ∀ (R A Ω : Type u) [CommRing R] [IsDomain R] [CommRing A] [Field Ω] [Algebra R A] [Algebra R Ω] [Algebra (FractionRing R) Ω] [IsScalarTower R (FractionRing R) Ω], (∀ e : TensorProduct R (FractionRing R) A, IsIdempotentElem e → ∃ a : A, IsIdempotentElem a ∧ (1 : FractionRing R) ⊗ₜ[R] a = e) → (∀ e : TensorProduct (FractionRing R) Ω (TensorProduct R (FractionRing R) A), IsIdempotentElem e → ∃ b : TensorProduct R (FractionRing R) A, IsIdempotentElem b ∧ (1 : Ω) ⊗ₜ[FractionRing R] b = e) → ∀ e : TensorProduct R A Ω, IsIdempotentElem e → ∃ a : A, IsIdempotentElem a ∧ a ⊗ₜ[R] (1 : Ω) = e := by
    intro R A Ω _ _ _ _ _ _ _ _ hA hB e he
    let Ψ : TensorProduct (FractionRing R) Ω (TensorProduct R (FractionRing R) A) ≃ₐ[R] TensorProduct R A Ω :=
      ((Algebra.TensorProduct.cancelBaseChange R (FractionRing R) Ω Ω A).restrictScalars R).trans
        (Algebra.TensorProduct.comm R Ω A)
    have hΨ : ∀ a : A, Ψ ((1 : Ω) ⊗ₜ ((1 : FractionRing R) ⊗ₜ a)) = a ⊗ₜ (1 : Ω) := by
      intro a
      simp [Ψ, Algebra.TensorProduct.cancelBaseChange_tmul]
    have he' : IsIdempotentElem (Ψ.symm e) := he.map Ψ.symm
    obtain ⟨b, hb, hbe⟩ := hB _ he'
    obtain ⟨a, ha, hab⟩ := hA b hb
    refine ⟨a, ha, ?_⟩
    rw [← hΨ, hab, hbe, AlgEquiv.apply_symm_apply]

  have s13 : ∀ (R A Ω : Type u) [CommRing R] [CommRing A] [CommRing Ω] [Algebra R A] [Algebra R Ω], (∀ e : TensorProduct R A Ω, IsIdempotentElem e → ∃ a : A, IsIdempotentElem a ∧ a ⊗ₜ[R] (1 : Ω) = e) → ∀ (W' : Scheme.{u}) (q' : W' ⟶ Spec (.of A)) (r' : W' ⟶ Spec (.of Ω)), IsPullback q' r' (Spec.map (CommRingCat.ofHom (algebraMap R A))) (Spec.map (CommRingCat.ofHom (algebraMap R Ω))) → ∀ C' : Set W', IsClopen C' → ∃ D : Set (Spec (.of A)), IsClopen D ∧ q' ⁻¹' D = C' := by
    intro R A Ω _ _ _ _ _ hidem W' q' r' hpb C' hC'
    let Θ : W' ≅ Spec (.of (TensorProduct R A Ω)) := hpb.isoPullback ≪≫ pullbackSpecIso R A Ω
    have hΘ : Θ.hom ≫ Spec.map (CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom) = q' := by
      simp [Θ, pullbackSpecIso_hom_fst, IsPullback.isoPullback_hom_fst]
    let S : Set (PrimeSpectrum (TensorProduct R A Ω)) := Θ.inv ⁻¹' C'
    have hS : IsClopen S := hC'.preimage Θ.inv.continuous
    obtain ⟨e, he, hSe⟩ := PrimeSpectrum.isClopen_iff.mp hS
    obtain ⟨a, ha, hae⟩ := hidem e he
    refine ⟨(PrimeSpectrum.basicOpen a : Set (PrimeSpectrum A)), PrimeSpectrum.isClopen_iff.mpr ⟨a, ha, rfl⟩, ?_⟩
    have hC'S : C' = Θ.hom ⁻¹' S := by
      ext w
      show w ∈ C' ↔ Θ.inv (Θ.hom w) ∈ C'
      rw [← Scheme.Hom.comp_apply, Iso.hom_inv_id]
      rfl
    rw [hC'S, hSe, ← hΘ]
    ext w
    change (Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom :
        A →+* TensorProduct R A Ω))) (Θ.hom w) ∈ (PrimeSpectrum.basicOpen a : Set (PrimeSpectrum A)) ↔
      Θ.hom w ∈ (PrimeSpectrum.basicOpen e : Set (PrimeSpectrum (TensorProduct R A Ω)))
    rw [← hae]
    rfl

  intro R _ _ _ _ Y h _ hsm Ω _ ψ hψ W q r hpb C' hC'
  have hdense := s2 R Y h hsm Ω ψ hψ W q r hpb
  refine s1 Y W q hdense C' ?_
  intro y
  obtain ⟨A, _, φ, W', q', r', j, k, hφ, hpb', hj, hk, hy, hkq, hrange⟩ :=
    s3 R Y h hsm Ω ψ W q r hpb y
  letI : Algebra R A := φ.toAlgebra
  letI : Algebra R Ω := ψ.toAlgebra

  have hidem : ∀ e : TensorProduct R A Ω, IsIdempotentElem e →
      ∃ a : A, IsIdempotentElem a ∧ a ⊗ₜ[R] (1 : Ω) = e := by
    have : Algebra.Smooth R A := hφ
    letI : Algebra (FractionRing R) Ω := (IsFractionRing.lift (K := FractionRing R) hψ).toAlgebra
    have : IsScalarTower R (FractionRing R) Ω := IsScalarTower.of_algebraMap_eq
      (fun x => (IsFractionRing.lift_algebraMap (K := FractionRing R) hψ x).symm)
    obtain ⟨T, hT, hcharts⟩ := s4 R A
    have hdiv := s5 R A (s6 R) T hT hcharts
    have : Module.Flat R A := Algebra.Smooth.flat R A
    have hA := s7 R A hdiv
    have : IsNoetherianRing (TensorProduct R (FractionRing R) A) :=
      Algebra.FiniteType.isNoetherianRing (FractionRing R) _
    have hfin := s8 (TensorProduct R (FractionRing R) A)
    have hB := s11 (FractionRing R) Ω
      (TensorProduct R (FractionRing R) A) (fun Ω₀ hfg e he => by
        have : Algebra.FiniteType (FractionRing R) Ω₀ := (Subalgebra.fg_iff_finiteType Ω₀).mp hfg
        exact s10 (FractionRing R) Ω₀ _
          (fun c hc => s9 (FractionRing R) Ω₀ c (fun hn => hc hn.eq_zero)) hfin e he)
    exact s12 R A Ω hA hB
  obtain ⟨DA, hDA, hqDA⟩ := s13 R A Ω hidem W' q' r' hpb' (k ⁻¹' C') (hC'.preimage k.continuous)
  have := hj
  have := hk
  have hjemb := j.isOpenEmbedding
  have hjinj : Function.Injective j := hjemb.injective
  have hkey : ∀ w' : W', j (q' w') = q (k w') := by
    intro w'
    have e1 : (k ≫ q) w' = (q' ≫ j) w' := by rw [hkq]
    rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at e1
    exact e1.symm
  refine ⟨Set.range j, j '' DA, hjemb.isOpen_range, hy, hjemb.isOpenMap _ hDA.isOpen, ?_,
    Set.image_subset_range _ _, ?_⟩
  · have hdiff : Set.range j \ j '' DA = j '' DAᶜ := by
      ext x
      constructor
      · rintro ⟨⟨d, rfl⟩, hx⟩
        exact ⟨d, fun hd => hx ⟨d, hd, rfl⟩, rfl⟩
      · rintro ⟨d, hd, rfl⟩
        refine ⟨⟨d, rfl⟩, ?_⟩
        rintro ⟨d', hd', he⟩
        exact hd (hjinj he ▸ hd')
    rw [hdiff]
    exact hjemb.isOpenMap _ hDA.isClosed.isOpen_compl
  · ext w
    constructor
    · rintro ⟨d, hd, hdw⟩
      have hw : w ∈ Set.range k := by rw [hrange]; exact ⟨d, hdw⟩
      obtain ⟨w', rfl⟩ := hw
      have hqd : q' w' = d := hjinj ((hkey w').trans hdw.symm)
      have h1 : w' ∈ q' ⁻¹' DA := by
        show q' w' ∈ DA
        rw [hqd]; exact hd
      rw [hqDA] at h1
      exact ⟨h1, d, hdw⟩
    · rintro ⟨hwC, d, hdw⟩
      have hw : w ∈ Set.range k := by rw [hrange]; exact ⟨d, hdw⟩
      obtain ⟨w', rfl⟩ := hw
      have h1 : w' ∈ q' ⁻¹' DA := by rw [hqDA]; exact hwC
      exact ⟨q' w', h1, hkey w'⟩

theorem wc_proper_smooth_shens_geom_fibre_clopen_lift : ∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (X : Scheme.{u}) (g : X ⟶ Spec (.of A)) [IsProper g], Smooth g → ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (ξ : Spec (.of Ω) ⟶ Spec (.of A)) (W : Scheme.{u}) (q : W ⟶ X) (r : W ⟶ Spec (.of Ω)), IsPullback q r g ξ → ∀ C' : Set W, IsClopen C' → ∃ C : Set X, IsClopen C ∧ q ⁻¹' C = C' :=
by
  intro A _ _ _ X g _ hsm Ω _ _ ξ W q r hsq C' hC'
  classical
  haveI := hsm

  have key : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsLocalRing R] [IsIntegrallyClosed R]
      [IsAlgClosed (FractionRing R)] (ι : A →+* R) [IsLocalHom ι], ι.IsIntegral →
      ∀ ψ : R →+* Ω, Function.Injective ψ → ψ.comp ι = (Spec.preimage ξ).hom →
      ∃ C : Set X, IsClopen C ∧ q ⁻¹' C = C' := by
    intro R _ _ _ _ _ ι _ hιint ψ hψ hψι
    have hφfac : Spec.preimage ξ = CommRingCat.ofHom ι ≫ CommRingCat.ofHom ψ := by
      apply CommRingCat.hom_ext
      rw [CommRingCat.hom_comp, CommRingCat.hom_ofHom, CommRingCat.hom_ofHom, hψι]
    have hξfac : Spec.map (CommRingCat.ofHom ψ) ≫ Spec.map (CommRingCat.ofHom ι) = ξ := by
      rw [← Spec.map_comp, ← hφfac, Spec.map_preimage]
    haveI : IsIntegralHom (Spec.map (CommRingCat.ofHom ι)) :=
      IsIntegralHom.SpecMap_iff.mpr hιint
    have hsqR : IsPullback (Limits.pullback.fst g (Spec.map (CommRingCat.ofHom ι)))
        (Limits.pullback.snd g (Spec.map (CommRingCat.ofHom ι))) g
        (Spec.map (CommRingCat.ofHom ι)) := IsPullback.of_hasPullback _ _
    obtain ⟨qh, hqπ, hqr⟩ : ∃ qh : W ⟶ Limits.pullback g (Spec.map (CommRingCat.ofHom ι)),
        qh ≫ Limits.pullback.fst g (Spec.map (CommRingCat.ofHom ι)) = q ∧
        qh ≫ Limits.pullback.snd g (Spec.map (CommRingCat.ofHom ι)) =
          r ≫ Spec.map (CommRingCat.ofHom ψ) :=
      ⟨Limits.pullback.lift q (r ≫ Spec.map (CommRingCat.ofHom ψ))
        (by rw [hsq.w, ← hξfac, Category.assoc]),
        Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
    have hsq' : IsPullback qh r (Limits.pullback.snd g (Spec.map (CommRingCat.ofHom ι)))
        (Spec.map (CommRingCat.ofHom ψ)) := by
      refine IsPullback.of_right ?_ hqr hsqR
      rw [hqπ, hξfac]
      exact hsq

    obtain ⟨D, hD, hqD⟩ := wc_smooth_proper_normal_algclosed_base_geom_clopen R
      (Limits.pullback g (Spec.map (CommRingCat.ofHom ι)))
      (Limits.pullback.snd g (Spec.map (CommRingCat.ofHom ι))) inferInstance Ω ψ hψ W qh r
      hsq' C' hC'

    have hs5 : ∀ x : X, g x = IsLocalRing.closedPoint A →
        ∃! z : ↥(Limits.pullback g (Spec.map (CommRingCat.ofHom ι))),
          Limits.pullback.fst g (Spec.map (CommRingCat.ofHom ι)) z = x ∧
          Limits.pullback.snd g (Spec.map (CommRingCat.ofHom ι)) z = IsLocalRing.closedPoint R :=
      fun x hx => wc_sepclosed_integral_closed_fibre_unique_lift A R ι inferInstance hιint X g x hx
    have hcond : ∀ z, g (Limits.pullback.fst g (Spec.map (CommRingCat.ofHom ι)) z) =
        Spec.map (CommRingCat.ofHom ι) (Limits.pullback.snd g (Spec.map (CommRingCat.ofHom ι)) z) := by
      intro z
      rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, Limits.pullback.condition]
    have hπc : IsClosedMap (Limits.pullback.fst g (Spec.map (CommRingCat.ofHom ι))) :=
      Scheme.Hom.isClosedMap _
    have hghc : IsClosedMap (Limits.pullback.snd g (Spec.map (CommRingCat.ofHom ι))) :=
      Scheme.Hom.isClosedMap _
    have hπcont : Continuous (Limits.pullback.fst g (Spec.map (CommRingCat.ofHom ι))) :=
      (Limits.pullback.fst g (Spec.map (CommRingCat.ofHom ι))).continuous
    have hghcont : Continuous (Limits.pullback.snd g (Spec.map (CommRingCat.ofHom ι))) :=
      (Limits.pullback.snd g (Spec.map (CommRingCat.ofHom ι))).continuous
    have hsR : Spec.map (CommRingCat.ofHom ι) (IsLocalRing.closedPoint R) =
        IsLocalRing.closedPoint A := IsLocalRing.comap_closedPoint ι
    set π := Limits.pullback.fst g (Spec.map (CommRingCat.ofHom ι)) with hπdef
    set gh := Limits.pullback.snd g (Spec.map (CommRingCat.ofHom ι)) with hghdef
    have hπF : ∀ z, gh z = IsLocalRing.closedPoint R → g (π z) = IsLocalRing.closedPoint A := by
      intro z hz
      rw [hcond z, hz, hsR]
    have hFc : IsClosed (gh ⁻¹' {IsLocalRing.closedPoint R}) :=
      (IsLocalRing.isClosed_singleton_closedPoint R).preimage hghcont
    have huniq : ∀ z z', gh z = IsLocalRing.closedPoint R → gh z' = IsLocalRing.closedPoint R →
        π z = π z' → z = z' := by
      intro z z' hz hz' he
      obtain ⟨z0, -, hu⟩ := hs5 (π z) (hπF z hz)
      exact (hu z ⟨rfl, hz⟩).trans (hu z' ⟨he.symm, hz'⟩).symm
    have hT1 : IsClosed (π '' (D ∩ gh ⁻¹' {IsLocalRing.closedPoint R})) :=
      hπc _ (hD.isClosed.inter hFc)
    have hT2 : IsClosed (π '' (Dᶜ ∩ gh ⁻¹' {IsLocalRing.closedPoint R})) :=
      hπc _ (hD.isOpen.isClosed_compl.inter hFc)
    have hdisj : Disjoint (π '' (D ∩ gh ⁻¹' {IsLocalRing.closedPoint R}))
        (π '' (Dᶜ ∩ gh ⁻¹' {IsLocalRing.closedPoint R})) := by
      rw [Set.disjoint_left]
      rintro x ⟨z, ⟨hzD, hzF⟩, rfl⟩ ⟨z', ⟨hz'D, hz'F⟩, hz'⟩
      apply hz'D
      rw [huniq z' z hz'F hzF hz']
      exact hzD
    have hunion : π '' (D ∩ gh ⁻¹' {IsLocalRing.closedPoint R}) ∪
        π '' (Dᶜ ∩ gh ⁻¹' {IsLocalRing.closedPoint R}) = g ⁻¹' {IsLocalRing.closedPoint A} := by
      ext x
      constructor
      · rintro (⟨z, ⟨-, hzF⟩, rfl⟩ | ⟨z, ⟨-, hzF⟩, rfl⟩)
        · exact hπF z hzF
        · exact hπF z hzF
      · intro hx
        obtain ⟨z, ⟨hz1, hz2⟩, -⟩ := hs5 x hx
        by_cases hzD : z ∈ D
        · exact Or.inl ⟨z, ⟨hzD, hz2⟩, hz1⟩
        · exact Or.inr ⟨z, ⟨hzD, hz2⟩, hz1⟩

    obtain ⟨C, hC, hCT⟩ := wc_proper_henselian_closed_fibre_clopen_extend A X g _ _ hT1 hT2
      hdisj hunion
    have hkey : ∀ z, gh z = IsLocalRing.closedPoint R → (π z ∈ C ↔ z ∈ D) := by
      intro z hz
      rw [hCT (π z) (hπF z hz)]
      constructor
      · rintro ⟨z', ⟨hz'D, hz'F⟩, hz'⟩
        rw [← huniq z' z hz'F hz hz']
        exact hz'D
      · intro hzD
        exact ⟨z, ⟨hzD, hz⟩, rfl⟩

    have htr : ∀ E : Set ↥(Limits.pullback g (Spec.map (CommRingCat.ofHom ι))), IsClosed E →
        (∀ z ∈ E, gh z ≠ IsLocalRing.closedPoint R) → E = ∅ := by
      intro E hE hEF
      by_contra hne
      obtain ⟨e, he⟩ := Set.nonempty_iff_ne_empty.mpr hne
      have h3 : IsLocalRing.closedPoint R ∈ gh '' E :=
        (IsLocalRing.specializes_closedPoint (gh e)).mem_closed (hghc _ hE) ⟨e, he, rfl⟩
      obtain ⟨e', he', hge'⟩ := h3
      exact hEF e' he' hge'
    have hπD : π ⁻¹' C = D := by
      have e1 : π ⁻¹' C ∩ Dᶜ = ∅ :=
        htr _ ((hC.isClosed.preimage hπcont).inter hD.isOpen.isClosed_compl)
          (fun z hz hF => hz.2 ((hkey z hF).1 hz.1))
      have e2 : D ∩ (π ⁻¹' C)ᶜ = ∅ :=
        htr _ (hD.isClosed.inter (hC.isOpen.preimage hπcont).isClosed_compl)
          (fun z hz hF => hz.2 ((hkey z hF).2 hz.1))
      ext z
      constructor
      · intro hz
        by_contra hzD
        have hmem : z ∈ π ⁻¹' C ∩ Dᶜ := ⟨hz, hzD⟩
        rw [e1] at hmem
        exact hmem
      · intro hz
        by_contra hzC
        have hmem : z ∈ D ∩ (π ⁻¹' C)ᶜ := ⟨hz, hzC⟩
        rw [e2] at hmem
        exact hmem
    refine ⟨C, hC, ?_⟩
    have hw : ∀ w, q w = π (qh w) := by
      intro w
      rw [← hqπ, Scheme.Hom.comp_apply]
    ext w
    rw [← hqD, ← hπD]
    show q w ∈ C ↔ π (qh w) ∈ C
    rw [hw w]

  letI : Algebra A Ω := (Spec.preimage ξ).hom.toAlgebra
  obtain ⟨hRl, hιl⟩ := wc_henselian_integral_domain_local A (integralClosure A Ω)
    inferInstance inferInstance
  haveI := hRl
  haveI := hιl
  have hinj : Function.Injective (algebraMap (integralClosure A Ω) Ω) := fun a b h => Subtype.ext h
  obtain ⟨hic, hac⟩ := wc_integrally_closed_in_algclosed_field Ω (integralClosure A Ω)
    (algebraMap (integralClosure A Ω) Ω) hinj (by
      rintro x ⟨p, hpm, hp⟩
      have hxR : IsIntegral (integralClosure A Ω) x := ⟨p, hpm, hp⟩
      have hxA : IsIntegral A x := isIntegral_trans x hxR
      exact RingHom.mem_range.mpr ⟨⟨x, hxA⟩, rfl⟩)
  haveI := hic
  haveI := hac
  exact key (integralClosure A Ω) (algebraMap A _) (fun x => Algebra.IsIntegral.isIntegral x)
    (algebraMap _ Ω) hinj (by ext a; rfl)

theorem wc_etale_separated_section_range_clopen : ∀ {Y E : Scheme.{u}} (e : E ⟶ Y) [Etale e] [IsSeparated e] (s : Y ⟶ E), s ≫ e = 𝟙 Y → IsClopen (Set.range s) :=
by
  intro Y E e _ _ s hs
  haveI := FormallyUnramified.isOpenImmersion_diagonal e
  have hΔo : IsOpen (Set.range (Limits.pullback.diagonal e)) :=
    IsOpenImmersion.isOpen_range (Limits.pullback.diagonal e)
  have hΔc : IsClosed (Set.range (Limits.pullback.diagonal e)) :=
    (Limits.pullback.diagonal e).isClosedEmbedding.isClosed_range
  have w : 𝟙 E ≫ e = (e ≫ s) ≫ e := by
    rw [Category.assoc, hs, Category.comp_id, Category.id_comp]
  let g : E ⟶ Limits.pullback e e := Limits.pullback.lift (𝟙 E) (e ≫ s) w
  have hg1 : g ≫ Limits.pullback.fst e e = 𝟙 E := Limits.pullback.lift_fst _ _ _
  have hg2 : g ≫ Limits.pullback.snd e e = e ≫ s := Limits.pullback.lift_snd _ _ _
  have hsg : s ≫ g = s ≫ Limits.pullback.diagonal e := by
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, Category.assoc, hg1, Limits.pullback.diagonal_fst]
    · rw [Category.assoc, Category.assoc, hg2, Limits.pullback.diagonal_snd, ← Category.assoc,
        hs, Category.id_comp, Category.comp_id]
  have hset : Set.range s = g ⁻¹' Set.range (Limits.pullback.diagonal e) := by
    ext x
    constructor
    · rintro ⟨y, rfl⟩
      refine ⟨s y, ?_⟩
      show (Limits.pullback.diagonal e) (s y) = g (s y)
      rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, hsg]
    · rintro ⟨z, hz⟩
      have h1 : z = x := by
        have := congrArg (Limits.pullback.fst e e) hz
        rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, hg1,
          Limits.pullback.diagonal_fst] at this
        simpa using this
      have h2 : z = s (e x) := by
        have := congrArg (Limits.pullback.snd e e) hz
        rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, hg2,
          Limits.pullback.diagonal_snd, Scheme.Hom.comp_apply] at this
        simpa using this
      exact ⟨e x, h2.symm.trans h1⟩
  rw [hset]
  exact IsClopen.preimage ⟨hΔc, hΔo⟩ g.continuous

theorem wc_shens_torsor_section_of_geom_section : ∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (Z : Scheme.{u}) (f : Z ⟶ Spec (.of A)) [IsProper f], Smooth f → ∀ (m : ℕ), m ≠ 0 → ∀ (P : Scheme.{u}) (p : P ⟶ Z) (a : ZMod m → (P ⟶ P)), wcFetTorsor p m a → ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (ξ : Spec (.of Ω) ⟶ Spec (.of A)) (τ : Limits.pullback f ξ ⟶ P), τ ≫ p = Limits.pullback.fst f ξ → ∃ σ : Z ⟶ P, σ ≫ p = 𝟙 Z :=
by
  intro A _ _ _ Z f _ hsm m hm P p a ht Ω _ _ ξ τ hτ
  classical
  haveI := hsm
  haveI := ht.finite
  haveI := ht.etale
  haveI : NeZero m := ⟨hm⟩

  haveI : IsProper (p ≫ f) := inferInstance
  haveI : Smooth (p ≫ f) := inferInstance
  haveI : Etale (Limits.pullback.snd p (Limits.pullback.fst f ξ)) := inferInstance
  haveI : IsFinite (Limits.pullback.snd p (Limits.pullback.fst f ξ)) := inferInstance
  haveI : IsSeparated (Limits.pullback.snd p (Limits.pullback.fst f ξ)) := inferInstance

  let F := Limits.pullback.fst f ξ
  let N := Limits.pullback.snd f ξ
  let q' := Limits.pullback.fst p F
  let p' := Limits.pullback.snd p F
  let s' : Limits.pullback f ξ ⟶ Limits.pullback p F :=
    Limits.pullback.lift τ (𝟙 _) (hτ.trans (Category.id_comp F).symm)
  have hs'p : s' ≫ p' = 𝟙 _ := Limits.pullback.lift_snd _ _ _
  let a' : ZMod m → (Limits.pullback p F ⟶ Limits.pullback p F) := fun c =>
    Limits.pullback.map p F p F (a c) (𝟙 _) (𝟙 Z)
      ((Category.comp_id p).trans (ht.act_p c).symm)
      ((Category.comp_id F).trans (Category.id_comp F).symm)
  have ha'q : ∀ c, a' c ≫ q' = q' ≫ a c := fun c => Limits.pullback.lift_fst _ _ _
  have ha'pt : ∀ c y, q' (a' c y) = (a c) (q' y) := by
    intro c y
    have e := Scheme.Hom.comp_apply (a' c) q' y
    rw [ha'q c, Scheme.Hom.comp_apply] at e
    exact e.symm

  have hsq : IsPullback q' (p' ≫ N) (p ≫ f) ξ :=
    IsPullback.paste_vert (IsPullback.of_hasPullback p F) (IsPullback.of_hasPullback f ξ)
  have hne : Nonempty (Spec (.of Ω)) := ⟨IsLocalRing.closedPoint Ω⟩

  obtain ⟨hcov, hdisj⟩ := wc_torsor_section_translates_partition p m a ht F τ hτ

  have hclo : IsClopen (Set.range s') := wc_etale_separated_section_range_clopen p' s' hs'p

  obtain ⟨D, hDc, hD⟩ := wc_proper_smooth_shens_geom_fibre_clopen_lift A P (p ≫ f)
    inferInstance Ω ξ (Limits.pullback p F) q' (p' ≫ N) hsq (Set.range s') hclo
  have hstar : ∀ y, q' y ∈ D ↔ y ∈ Set.range s' := fun y => by
    rw [← hD]; exact Iff.rfl

  have hE : ∀ c : ZMod m, c ≠ 0 → ∀ x ∈ D, (a c) x ∉ D := by
    intro c hc
    have hEe : D ∩ (a c) ⁻¹' D = ∅ := by
      refine wc_clopen_empty_of_geom_fibre_empty A P (p ≫ f) (Spec (.of Ω))
        (Limits.pullback p F) ξ q' (p' ≫ N) hsq hne _
        (hDc.isOpen.inter (hDc.isOpen.preimage (a c).continuous))
        (hDc.isClosed.inter (hDc.isClosed.preimage (a c).continuous)) ?_
      refine Set.subset_empty_iff.mp ?_
      intro y hy
      obtain ⟨hy1, hy2⟩ := hy
      obtain ⟨w, rfl⟩ := (hstar y).1 hy1
      have h3 : q' (a' c (s' w)) ∈ D := by
        rw [ha'pt c (s' w)]; exact hy2
      obtain ⟨w', hw'⟩ := (hstar _).1 h3
      exact (hdisj c hc w w' hw'.symm).elim
    intro x hx hax
    have hmem : x ∈ D ∩ (a c) ⁻¹' D := ⟨hx, hax⟩
    rw [hEe] at hmem
    exact hmem

  have hC : ∀ x : P, ∃ c : ZMod m, (a c) x ∈ D := by
    have hUc : IsClopen (⋃ c : ZMod m, (a c) ⁻¹' D) :=
      isClopen_iUnion_of_finite (fun c => hDc.preimage (a c).continuous)
    have hKe : (⋃ c : ZMod m, (a c) ⁻¹' D)ᶜ = ∅ := by
      refine wc_clopen_empty_of_geom_fibre_empty A P (p ≫ f) (Spec (.of Ω))
        (Limits.pullback p F) ξ q' (p' ≫ N) hsq hne _ hUc.compl.isOpen hUc.compl.isClosed ?_
      refine Set.subset_empty_iff.mp ?_
      intro y hy
      obtain ⟨c, w, hcw⟩ := hcov y
      apply hy
      refine Set.mem_iUnion.2 ⟨c, ?_⟩
      have h1 : q' (a' c y) ∈ D := (hstar _).2 ⟨w, hcw.symm⟩
      rw [ha'pt c y] at h1
      exact h1
    intro x
    by_contra hx
    push_neg at hx
    have hmem : x ∈ (⋃ c : ZMod m, (a c) ⁻¹' D)ᶜ := by
      intro hU
      obtain ⟨c, hc⟩ := Set.mem_iUnion.1 hU
      exact hx c hc
    rw [hKe] at hmem
    exact hmem

  exact wc_torsor_section_of_fundamental_open p m a ht D hDc.isOpen hE hC

theorem wc_et_torsor_section_cospecialize : ∀ (S X : Scheme.{u}) (g : X ⟶ S) [IsProper g] (W : S.Opens), Smooth (g ∣_ W) → ∀ (U : S.Etale) (m : ℕ), m ≠ 0 → ∀ (P : Scheme.{u}) (p : P ⟶ Limits.pullback g U.hom) (a : ZMod m → (P ⟶ P)), wcFetTorsor p m a → ∀ (u u' : U.left), u' ⤳ u → U.hom u ∈ (W : Set S) → (∃ (U₁ : S.Etale) (c₁ : U₁ ⟶ U) (u₁ : U₁.left) (σ : Limits.pullback g U₁.hom ⟶ P), c₁.left u₁ = u' ∧ σ ≫ p ≫ Limits.pullback.fst g U.hom = Limits.pullback.fst g U₁.hom ∧ σ ≫ p ≫ Limits.pullback.snd g U.hom = Limits.pullback.snd g U₁.hom ≫ c₁.left) → ∃ (U₁ : S.Etale) (c₁ : U₁ ⟶ U) (u₁ : U₁.left) (σ : Limits.pullback g U₁.hom ⟶ P), c₁.left u₁ = u ∧ σ ≫ p ≫ Limits.pullback.fst g U.hom = Limits.pullback.fst g U₁.hom ∧ σ ≫ p ≫ Limits.pullback.snd g U.hom = Limits.pullback.snd g U₁.hom ≫ c₁.left :=
by
  intro S X g _ W hsm U m hm P p a htor u u' hspec hUu hyp
  classical

  obtain ⟨U₁, c₁, u₁, σ₀, hc₁, hσ1, hσ2⟩ := hyp
  have hEt : ∀ {U₁ U₂ : S.Etale} (c : U₁ ⟶ U₂), Etale c.left := fun {U₁ U₂} c =>
    MorphismProperty.of_postcomp @Etale (W' := @Etale) c.left U₂.hom U₂.prop
      ((MorphismProperty.Over.w c).symm ▸ U₁.prop)
  have hgeom_pt : ∀ x : U.left, (wcEtGeomPt U.left x)
      (IsLocalRing.closedPoint (AlgebraicClosure (U.left.residueField x))) = x := fun x =>
    (Scheme.Hom.comp_apply _ (U.left.fromSpecResidueField x) _).trans
      (Scheme.fromSpecResidueField_apply x _)
  obtain ⟨h, hh⟩ : ∃ h : Limits.pullback g U.hom ⟶ U.left, h = Limits.pullback.snd g U.hom :=
    ⟨_, rfl⟩
  haveI : IsProper h := by rw [hh]; infer_instance

  obtain ⟨A, _, _, _, Λ, _, _, W', φ, a₀, e, -, hAff, hφ, ha, hUniv, -, hgeom⟩ :=
    wc_et_geom_strict_henselization u

  have hca : a₀ (IsLocalRing.closedPoint A) = u := by
    have h2 : ∀ y : Spec (.of (IsLocalRing.ResidueField A)),
        (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A))) y = IsLocalRing.closedPoint A :=
      fun y => IsLocalRing.PrimeSpectrum.comap_residue A y
    have h1 := hgeom_pt u
    rw [← hgeom] at h1
    have e5 := (Scheme.Hom.comp_apply (Spec.map (CommRingCat.ofHom e))
      (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)) ≫ a₀)
      (IsLocalRing.closedPoint (AlgebraicClosure (U.left.residueField u)))).trans
      (Scheme.Hom.comp_apply (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A))) a₀
        ((Spec.map (CommRingCat.ofHom e))
          (IsLocalRing.closedPoint (AlgebraicClosure (U.left.residueField u)))))
    rw [h2] at e5
    exact e5.symm.trans h1

  have hrange : Set.range (a₀ ≫ U.hom) ⊆ (W : Set S) := by
    rintro _ ⟨x, rfl⟩
    have hx : x ⤳ IsLocalRing.closedPoint A := IsLocalRing.specializes_closedPoint x
    refine (hx.map (a₀ ≫ U.hom).continuous).mem_open W.isOpen ?_
    have e7 := Scheme.Hom.comp_apply a₀ U.hom (IsLocalRing.closedPoint A)
    rw [e7, hca]
    exact hUu

  have hsmZ : Smooth (Limits.pullback.snd h a₀) := by
    have := wc_smooth_restrict_base_change S X U.left (Spec (.of A)) g W hsm U.hom a₀ hrange
    rw [hh]; exact this

  obtain ⟨a', htor'⟩ := wc_fet_torsor_base_change p (Limits.pullback.fst h a₀) m a htor

  obtain ⟨ξ, hξ⟩ := wc_shens_geom_point_over_generalization u u' hspec A Λ W' φ a₀ hAff hφ ha hUniv
  haveI := hEt c₁
  obtain ⟨τ₁, hτ₁, -⟩ := wc_etale_lift_alg_closed_point (AlgebraicClosure (U.left.residueField u'))
    c₁.left (wcEtGeomPt U.left u') u₁ (by rw [hc₁, hgeom_pt])
  have e4 : τ₁ ≫ c₁.left = ξ ≫ a₀ := hτ₁.trans hξ.symm

  have e1 : Limits.pullback.fst g U.hom ≫ g = h ≫ U.hom := by
    rw [hh]; exact Limits.pullback.condition
  have e2 : Limits.pullback.fst h a₀ ≫ h = Limits.pullback.snd h a₀ ≫ a₀ :=
    Limits.pullback.condition
  have e3 : Limits.pullback.fst (Limits.pullback.snd h a₀) ξ ≫ Limits.pullback.snd h a₀ =
      Limits.pullback.snd (Limits.pullback.snd h a₀) ξ ≫ ξ := Limits.pullback.condition
  have hk : (Limits.pullback.fst (Limits.pullback.snd h a₀) ξ ≫ Limits.pullback.fst h a₀ ≫
      Limits.pullback.fst g U.hom) ≫ g =
      (Limits.pullback.snd (Limits.pullback.snd h a₀) ξ ≫ τ₁) ≫ U₁.hom := by
    rw [← MorphismProperty.Over.w c₁]
    simp only [Category.assoc]
    rw [e1, reassoc_of% e2, reassoc_of% e3, reassoc_of% e4]
  have hclaim : (Limits.pullback.lift _ _ hk ≫ σ₀) ≫ p =
      Limits.pullback.fst (Limits.pullback.snd h a₀) ξ ≫ Limits.pullback.fst h a₀ := by
    apply Limits.pullback.hom_ext
    · simp only [Category.assoc]
      rw [hσ1, Limits.pullback.lift_fst]
    · simp only [Category.assoc]
      rw [hσ2, Limits.pullback.lift_snd_assoc, Category.assoc, e4, ← hh, e2, reassoc_of% e3]

  obtain ⟨σA, hσA⟩ := wc_shens_torsor_section_of_geom_section A (Limits.pullback h a₀)
    (Limits.pullback.snd h a₀) hsmZ m hm (Limits.pullback p (Limits.pullback.fst h a₀))
    (Limits.pullback.snd p (Limits.pullback.fst h a₀)) a' htor'
    (AlgebraicClosure (U.left.residueField u')) ξ (Limits.pullback.lift _ _ hclaim)
    (Limits.pullback.lift_snd _ _ _)
  have hψ : (σA ≫ Limits.pullback.fst p (Limits.pullback.fst h a₀)) ≫ p =
      Limits.pullback.fst h a₀ := by
    rw [Category.assoc, Limits.pullback.condition, ← Category.assoc, hσA, Category.id_comp]

  obtain ⟨π, hπ1, hπ2, hπ3, hπ4, hπ5, hπ6, -, -, -⟩ := wc_et_baseChange_limit_presentation h A Λ
    (W' ⋙ StructuredArrow.proj _ _) φ a₀ hAff hφ ha hUniv (Limits.pullback h a₀)
    (Limits.pullback.fst h a₀) (Limits.pullback.snd h a₀) (IsPullback.of_hasPullback h a₀)

  haveI := htor.finite
  haveI := htor.etale
  obtain ⟨l, σl, hσl⟩ := wc_lim_section_descend Λ
    ((W' ⋙ StructuredArrow.proj _ _) ⋙ wcEtBaseChange h) (Limits.pullback h a₀) π hπ2 hπ3 hπ4
    hπ5 hπ6 P p inferInstance inferInstance
    (σA ≫ Limits.pullback.fst p (Limits.pullback.fst h a₀)) (fun l => hψ.trans (hπ1 l).symm)

  haveI : Etale (W'.obj l).right.hom := (W'.obj l).right.prop
  haveI : Etale U.hom := U.prop
  let U₁s : S.Etale := MorphismProperty.Over.mk ⊤ ((W'.obj l).right.hom ≫ U.hom) inferInstance
  have hU₁s : U₁s.hom = (W'.obj l).right.hom ≫ U.hom := rfl
  obtain ⟨k₀, hk₀1, hk₀2⟩ : ∃ k₀ : Limits.pullback g U₁s.hom ⟶ Limits.pullback g U.hom,
      k₀ ≫ Limits.pullback.fst g U.hom = Limits.pullback.fst g U₁s.hom ∧
      k₀ ≫ Limits.pullback.snd g U.hom = Limits.pullback.snd g U₁s.hom ≫ (W'.obj l).right.hom :=
    ⟨Limits.pullback.lift (Limits.pullback.fst g U₁s.hom)
      (Limits.pullback.snd g U₁s.hom ≫ (W'.obj l).right.hom)
      (by rw [Limits.pullback.condition]; exact (Category.assoc _ _ _).symm),
      Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
  obtain ⟨k', hk'⟩ : ∃ k' : Limits.pullback g U₁s.hom ⟶
      (((W' ⋙ StructuredArrow.proj _ _) ⋙ wcEtBaseChange h).obj l).left,
      k' ≫ (((W' ⋙ StructuredArrow.proj _ _) ⋙ wcEtBaseChange h).obj l).hom = k₀ :=
    ⟨(Limits.pullback.lift (f := (W'.obj l).right.hom) (g := h)
      (Limits.pullback.snd g U₁s.hom) k₀ (by rw [hh]; exact hk₀2.symm) :
        Limits.pullback g U₁s.hom ⟶ Limits.pullback (W'.obj l).right.hom h),
      Limits.pullback.lift_snd _ _ _⟩
  refine ⟨U₁s, MorphismProperty.Over.homMk (W'.obj l).right.hom hU₁s.symm trivial,
    φ l (IsLocalRing.closedPoint A), k' ≫ σl, ?_, ?_, ?_⟩
  · show (W'.obj l).right.hom (φ l (IsLocalRing.closedPoint A)) = u
    have h3 := Scheme.Hom.comp_apply (φ l) (W'.obj l).right.hom (IsLocalRing.closedPoint A)
    rw [ha l] at h3
    rw [← h3]
    exact hca
  · simp only [Category.assoc]
    rw [reassoc_of% hσl, reassoc_of% hk', hk₀1]
  · show (k' ≫ σl) ≫ p ≫ Limits.pullback.snd g U.hom =
      Limits.pullback.snd g U₁s.hom ≫ (W'.obj l).right.hom
    simp only [Category.assoc]
    rw [reassoc_of% hσl, reassoc_of% hk', hk₀2]

theorem wc_et_smooth_R1_cospecialization_injective : ∀ (K : Type u) [Field K] [IsAlgClosed K] (S X : Scheme.{u}) (fS : S ⟶ Spec (.of K)) [IsProper fS] [IsIntegral S] (g : X ⟶ S) [IsProper g] (ℓ : ℕ), ℓ.Prime → (ℓ : K) ≠ 0 → (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (t : Spec (.of Ω) ⟶ S), topologicalKrullDim ↥(Limits.pullback g t) ≤ ((1 : ℕ) : WithBot ℕ∞)) → (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (C : Scheme.{u}) (fC : C ⟶ Spec (.of Ω)) [IsProper fC], (ℓ : Ω) ≠ 0 → topologicalKrullDim C ≤ ((1 : ℕ) : WithBot ℕ∞) → ∀ q : ℕ, Finite (wcEtCoh C ℓ q)) → (∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (Y₀ : Scheme.{u}) (f : Y₀ ⟶ Spec (.of A)) [IsProper f] (m' : ℕ), m' ≠ 0 → ∀ S : Set (Spec (.of A)), IsOpen S → S ≠ Set.univ → ∀ q' : ℕ, Subsingleton (wcEtExt Y₀ (wcEtExtZero Y₀ (f ⁻¹' S) m') q')) → ∀ W : S.Opens, Smooth (g ∣_ W) → ∀ (I : InjectiveResolution ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))))) (y : S), y ∈ (W : Set S) → ∀ (V : S.Etale) (t : Spec (.of (AlgebraicClosure (S.residueField y))) ⟶ V.left) (ht : t ≫ V.hom = wcEtGeomPt S y) (t' : Spec (.of (AlgebraicClosure (S.residueField (genericPoint S)))) ⟶ V.left) (ht' : t' ≫ V.hom = wcEtGeomPt S (genericPoint S)), t' (IsLocalRing.closedPoint (AlgebraicClosure (S.residueField (genericPoint S)))) ⤳ t (IsLocalRing.closedPoint (AlgebraicClosure (S.residueField y))) → ∀ s : ((((wcEtPush g).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology 1).obj.obj (Opposite.op V), (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt S (genericPoint S))) (Scheme.Etale.forget S)).op ⋙ ((((wcEtPush g).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology 1).obj) (Opposite.op (StructuredArrow.mk (Over.homMk t' ht' : Over.mk (wcEtGeomPt S (genericPoint S)) ⟶ (Scheme.Etale.forget S).obj V)))).hom s = 0 → (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt S y)) (Scheme.Etale.forget S)).op ⋙ ((((wcEtPush g).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology 1).obj) (Opposite.op (StructuredArrow.mk (Over.homMk t ht : Over.mk (wcEtGeomPt S y) ⟶ (Scheme.Etale.forget S).obj V)))).hom s = 0 :=
by
  intro K _ _ S X fS _ _ g _ ℓ hℓ hℓK hdim hcurve hPBC W hsm I y hy V t ht t' ht' hsp s h0
  classical

  have hEt : ∀ {U₁ U₂ : S.Etale} (c : U₁ ⟶ U₂), Etale c.left := fun {U₁ U₂} c =>
    MorphismProperty.of_postcomp @Etale (W' := @Etale) c.left U₂.hom U₂.prop
      ((MorphismProperty.Over.w c).symm ▸ U₁.prop)

  have hmove : ∀ (b : S) (G : Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1})
      (U₀ U₁ : S.Etale) (c : U₁ ⟶ U₀)
      (τ : Spec (.of (AlgebraicClosure (S.residueField b))) ⟶ U₀.left)
      (hτ : τ ≫ U₀.hom = wcEtGeomPt S b)
      (τ₁ : Spec (.of (AlgebraicClosure (S.residueField b))) ⟶ U₁.left)
      (hτ₁ : τ₁ ≫ U₁.hom = wcEtGeomPt S b), τ₁ ≫ c.left = τ →
      ∀ x : G.obj.obj (Opposite.op U₀),
      (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt S b))
        (Scheme.Etale.forget S)).op ⋙ G.obj) (Opposite.op (StructuredArrow.mk
          (Over.homMk τ hτ : Over.mk (wcEtGeomPt S b) ⟶ (Scheme.Etale.forget S).obj U₀)))).hom x =
      (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt S b))
        (Scheme.Etale.forget S)).op ⋙ G.obj) (Opposite.op (StructuredArrow.mk
          (Over.homMk τ₁ hτ₁ : Over.mk (wcEtGeomPt S b) ⟶ (Scheme.Etale.forget S).obj U₁)))).hom
        ((G.obj.map c.op).hom x) := by
    intro b G U₀ U₁ c τ hτ τ₁ hτ₁ hc x
    let ĉ : StructuredArrow.mk (Over.homMk τ₁ hτ₁ : Over.mk (wcEtGeomPt S b) ⟶
          (Scheme.Etale.forget S).obj U₁) ⟶
        StructuredArrow.mk (Over.homMk τ hτ : Over.mk (wcEtGeomPt S b) ⟶
          (Scheme.Etale.forget S).obj U₀) :=
      StructuredArrow.homMk c (by ext; exact hc)
    have hw := congrArg (fun φ => φ.hom x) (Limits.colimit.w ((StructuredArrow.proj
      (Over.mk (wcEtGeomPt S b)) (Scheme.Etale.forget S)).op ⋙ G.obj) ĉ.op)
    exact hw.symm

  have hloc : ∀ (b : S) (G : Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1})
      (U₀ : S.Etale) (τ : Spec (.of (AlgebraicClosure (S.residueField b))) ⟶ U₀.left)
      (hτ : τ ≫ U₀.hom = wcEtGeomPt S b) (x : G.obj.obj (Opposite.op U₀)),
      (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt S b))
        (Scheme.Etale.forget S)).op ⋙ G.obj) (Opposite.op (StructuredArrow.mk
          (Over.homMk τ hτ : Over.mk (wcEtGeomPt S b) ⟶ (Scheme.Etale.forget S).obj U₀)))).hom x
        = 0 →
      ∃ (U₁ : S.Etale) (c : U₁ ⟶ U₀) (u₁ : U₁.left),
        c.left u₁ = τ (IsLocalRing.closedPoint (AlgebraicClosure (S.residueField b))) ∧
        (G.obj.map c.op).hom x = 0 := by
    intro b G U₀ τ hτ x hx
    haveI : IsCofiltered (StructuredArrow (Over.mk (wcEtGeomPt S b)) (Scheme.Etale.forget S)) :=
      wc_et_geomstalk_cofiltered S b wc_etale_maps_agree_near_geom_point
    haveI : IsFiltered (StructuredArrow (Over.mk (wcEtGeomPt S b)) (Scheme.Etale.forget S))ᵒᵖ :=
      isFiltered_op_of_isCofiltered _
    haveI := Limits.preservesFilteredColimitsOfSize_shrink.{u+1, u+1, u, u+1}
      (forget AddCommGrpCat.{u+1})
    obtain ⟨k, f, f', hk⟩ := (Limits.Concrete.colimit_rep_eq_iff_exists
      ((StructuredArrow.proj (Over.mk (wcEtGeomPt S b)) (Scheme.Etale.forget S)).op ⋙ G.obj)
      (i := Opposite.op (StructuredArrow.mk
        (Over.homMk τ hτ : Over.mk (wcEtGeomPt S b) ⟶ (Scheme.Etale.forget S).obj U₀)))
      (j := Opposite.op (StructuredArrow.mk
        (Over.homMk τ hτ : Over.mk (wcEtGeomPt S b) ⟶ (Scheme.Etale.forget S).obj U₀)))
      x 0).mp (hx.trans (map_zero _).symm)
    refine ⟨k.unop.right, f.unop.right,
      k.unop.hom.left (IsLocalRing.closedPoint (AlgebraicClosure (S.residueField b))), ?_, ?_⟩
    · have hw : k.unop.hom.left ≫ f.unop.right.left = τ :=
        congrArg (fun φ => φ.left) (StructuredArrow.w f.unop)
      have hca := Scheme.Hom.comp_apply k.unop.hom.left f.unop.right.left
        (IsLocalRing.closedPoint (AlgebraicClosure (S.residueField b)))
      rw [hw] at hca
      exact hca.symm
    · have hk' : (G.obj.map f.unop.right.op).hom x = (G.obj.map f'.unop.right.op).hom 0 := hk
      rw [hk', map_zero]

  have hglob : ∀ (b : S) (G : Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1})
      (U₀ : S.Etale) (τ : Spec (.of (AlgebraicClosure (S.residueField b))) ⟶ U₀.left)
      (hτ : τ ≫ U₀.hom = wcEtGeomPt S b) (x : G.obj.obj (Opposite.op U₀))
      (U₁ : S.Etale) (c : U₁ ⟶ U₀) (u₁ : U₁.left),
      c.left u₁ = τ (IsLocalRing.closedPoint (AlgebraicClosure (S.residueField b))) →
      (G.obj.map c.op).hom x = 0 →
      (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt S b))
        (Scheme.Etale.forget S)).op ⋙ G.obj) (Opposite.op (StructuredArrow.mk
          (Over.homMk τ hτ : Over.mk (wcEtGeomPt S b) ⟶ (Scheme.Etale.forget S).obj U₀)))).hom x
        = 0 := by
    intro b G U₀ τ hτ x U₁ c u₁ hcu hcx
    haveI := hEt c
    obtain ⟨τ₁, hτ₁c, -⟩ := wc_etale_lift_alg_closed_point
      (AlgebraicClosure (S.residueField b)) c.left τ u₁ hcu
    have hτ₁ : τ₁ ≫ U₁.hom = wcEtGeomPt S b := by
      rw [← MorphismProperty.Over.w c, ← Category.assoc, hτ₁c, hτ]
    rw [hmove b G U₀ U₁ c τ hτ τ₁ hτ₁ hτ₁c x, hcx, map_zero]

  obtain ⟨U, d, u, P, p, a, hdu, htor, hiff⟩ := wc_et_R1_local_torsor_rep S X g ℓ hℓ.ne_zero I V s
    (t (IsLocalRing.closedPoint (AlgebraicClosure (S.residueField y))))
  haveI := hEt d

  have hsp' : t' (IsLocalRing.closedPoint (AlgebraicClosure (S.residueField (genericPoint S)))) ⤳
      d.left u := by
    rw [hdu]; exact hsp
  obtain ⟨u', hu'u, hdu'⟩ := (Flat.generalizingMap d.left) hsp'
  obtain ⟨τ', hτ'd, hτ'pt⟩ := wc_etale_lift_alg_closed_point
    (AlgebraicClosure (S.residueField (genericPoint S))) d.left t' u' hdu'
  have hτ' : τ' ≫ U.hom = wcEtGeomPt S (genericPoint S) := by
    rw [← MorphismProperty.Over.w d, ← Category.assoc, hτ'd, ht']
  rw [hmove (genericPoint S) _ V U d t' ht' τ' hτ' hτ'd s] at h0
  obtain ⟨U₁, d₁, u₁, hd₁u₁, hd₁x⟩ := hloc (genericPoint S) _ U τ' hτ' _ h0

  obtain ⟨U₂, c₂, u₂, σ, hc₂, hσ1, hσ2⟩ := (hiff U (𝟙 U) u').mp ⟨U₁, d₁, u₁, hd₁u₁.trans hτ'pt, by
      rw [Category.id_comp, op_comp, Functor.map_comp]
      exact hd₁x⟩
  rw [Category.comp_id] at hσ2

  have hUu : U.hom u ∈ (W : Set S) := by
    have e1 := Scheme.Hom.comp_apply d.left V.hom u
    rw [MorphismProperty.Over.w d] at e1
    have e2 := Scheme.Hom.comp_apply t V.hom
      (IsLocalRing.closedPoint (AlgebraicClosure (S.residueField y)))
    rw [ht] at e2
    have e3 : (wcEtGeomPt S y) (IsLocalRing.closedPoint (AlgebraicClosure (S.residueField y))) = y :=
      (Scheme.Hom.comp_apply _ (S.fromSpecResidueField y) _).trans
        (Scheme.fromSpecResidueField_apply y _)
    rw [e1, hdu, ← e2, e3]
    exact hy

  obtain ⟨U₃, c₃, u₃, σ₃, hc₃, h31, h32⟩ := wc_et_torsor_section_cospecialize S X g W hsm U ℓ
    hℓ.ne_zero P p a htor u u' hu'u hUu ⟨U₂, c₂, u₂, σ, hc₂, hσ1, hσ2⟩

  obtain ⟨U₄, c₄, u₄, hc₄, hc₄x⟩ := (hiff U₃ c₃ u₃).mpr
    ⟨U₃, 𝟙 U₃, u₃, σ₃, by first | rfl | simp, h31, by rw [Category.id_comp]; exact h32⟩

  refine hglob y _ V t ht s U₄ (c₄ ≫ c₃ ≫ d) u₄ ?_ hc₄x
  show (c₄.left ≫ c₃.left ≫ d.left) u₄ = _
  rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply, hc₄, hc₃, hdu]

theorem wc_et_smooth_curve_family_h1_generic_const : ∀ (K : Type u) [Field K] [IsAlgClosed K] (S X : Scheme.{u}) (fS : S ⟶ Spec (.of K)) [IsProper fS] [IsIntegral S] (g : X ⟶ S) [IsProper g] (ℓ : ℕ), ℓ.Prime → (ℓ : K) ≠ 0 → (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (t : Spec (.of Ω) ⟶ S), topologicalKrullDim ↥(Limits.pullback g t) ≤ ((1 : ℕ) : WithBot ℕ∞)) → (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (C : Scheme.{u}) (fC : C ⟶ Spec (.of Ω)) [IsProper fC], (ℓ : Ω) ≠ 0 → topologicalKrullDim C ≤ ((1 : ℕ) : WithBot ℕ∞) → ∀ q : ℕ, Finite (wcEtCoh C ℓ q)) → (∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (Y₀ : Scheme.{u}) (f : Y₀ ⟶ Spec (.of A)) [IsProper f] (m' : ℕ), m' ≠ 0 → ∀ S : Set (Spec (.of A)), IsOpen S → S ≠ Set.univ → ∀ q' : ℕ, Subsingleton (wcEtExt Y₀ (wcEtExtZero Y₀ (f ⁻¹' S) m') q')) → ∀ W : S.Opens, (W : Set S).Nonempty → Smooth (g ∣_ W) → ∃ W' : Set S, IsOpen W' ∧ genericPoint S ∈ W' ∧ ∀ y ∈ W', Nat.card (wcEtCoh (Limits.pullback g (wcEtGeomPt S y)) ℓ 1) = Nat.card (wcEtCoh (Limits.pullback g (wcEtGeomPt S (genericPoint S))) ℓ 1) :=
by
  intro K _ _ S X fS _ _ g _ ℓ hℓ hℓK hdim hcurve hPBC W hWne hsm
  classical
  haveI := wc_et_enough_injectives X

  let I : InjectiveResolution ((constantSheaf (Scheme.smallEtaleTopology X)
      AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))) := injectiveResolution _

  have hcof : ∀ b : S, IsCofiltered
      (StructuredArrow (Over.mk (wcEtGeomPt S b)) (Scheme.Etale.forget S)) :=
    fun b => wc_et_geomstalk_cofiltered S b wc_etale_maps_agree_near_geom_point

  have hℓΩ : ∀ y : S, (ℓ : AlgebraicClosure (S.residueField y)) ≠ 0 := by
    intro y
    let ψ : K →+* AlgebraicClosure (S.residueField y) :=
      (algebraMap (S.residueField y) (AlgebraicClosure (S.residueField y))).comp
        ((S.evaluation ⊤ y trivial).hom.comp
          (fS.appTop.hom.comp (Scheme.ΓSpecIso (.of K)).inv.hom))
    rw [← map_natCast ψ ℓ]
    exact (map_ne_zero ψ).mpr hℓK

  have hstk : ∀ y : S, Nonempty ((wcEtStalk S y).obj
      ((((wcEtPush g).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology 1) ≃
      wcEtCoh (Limits.pullback g (wcEtGeomPt S y)) ℓ 1) :=
    fun y => wc_et_proper_stalk_coh g ℓ hℓ.ne_zero hPBC I y 1

  have hfin : ∀ y : S, Finite ((wcEtStalk S y).obj
      ((((wcEtPush g).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology 1)) := by
    intro y
    haveI : Finite (wcEtCoh (Limits.pullback g (wcEtGeomPt S y)) ℓ 1) :=
      hcurve _ (Limits.pullback g (wcEtGeomPt S y)) (Limits.pullback.snd g (wcEtGeomPt S y))
        (hℓΩ y) (hdim _ (wcEtGeomPt S y)) 1
    exact Finite.of_equiv _ (hstk y).some.symm

  have hηW : genericPoint S ∈ (W : Set S) :=
    ((genericPoint_spec S).mem_open_set_iff W.isOpen).mpr (by rw [Set.univ_inter]; exact hWne)

  obtain ⟨U, hUo, hηU, hU⟩ := wc_et_stalk_card_generic_le_nbhd S
    ((((wcEtPush g).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology 1)
    hcof (hfin (genericPoint S))
  refine ⟨U ∩ (W : Set S), hUo.inter W.isOpen, ⟨hηU, hηW⟩, fun y hy => ?_⟩
  have h1 := hU y hy.1 (hfin y)

  have h2 := wc_et_stalk_card_le_generic_of_cospec_inj S
    ((((wcEtPush g).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology 1) y
    hcof (hfin y) (hfin (genericPoint S))
    (fun V t ht t' ht' hsp s h0 => wc_et_smooth_R1_cospecialization_injective K S X fS g ℓ hℓ hℓK
      hdim hcurve hPBC W hsm I y hy.2 V t ht t' ht' hsp s h0)
  rw [← Nat.card_congr (hstk y).some, ← Nat.card_congr (hstk (genericPoint S)).some]
  exact le_antisymm h2 h1

theorem wc_finite_topologicalKrullDim_le : ∀ {Y Z : Scheme.{u}} (π : Y ⟶ Z) [IsFinite π], topologicalKrullDim Y ≤ topologicalKrullDim Z :=
by
  intro Y Z π _
  have hinc : ∀ x y : Y, y ⤳ x → π x = π y → x = y := by
    intro x y hxy he
    have hd : _root_.IsDiscrete (π ⁻¹' {π x}) := Scheme.Hom.isDiscrete_preimage_singleton π (π x)
    haveI : DiscreteTopology ↥(π ⁻¹' {π x}) := hd.to_subtype
    let x' : ↥(π ⁻¹' {π x}) := ⟨x, rfl⟩
    let y' : ↥(π ⁻¹' {π x}) := ⟨y, he.symm⟩
    have hs : y' ⤳ x' := (Topology.IsInducing.subtypeVal.specializes_iff (x := y') (y := x')).mp hxy
    exact (congrArg Subtype.val hs.eq).symm
  letI : PartialOrder Y := specializationOrder Y
  letI : PartialOrder Z := specializationOrder Z
  have hmono : StrictMono (fun y : Y => π y) := by
    intro a b hab
    rw [lt_iff_le_and_ne] at hab ⊢
    obtain ⟨hle, hne⟩ := hab
    have hle' : b ⤳ a := hle
    refine ⟨?_, fun h => hne (hinc a b hle' h)⟩
    exact hle'.map π.continuous
  rw [topologicalKrullDim.eq_def, topologicalKrullDim.eq_def,
    Order.krullDim_eq_of_orderIso (irreducibleSetEquivPoints (α := Y)),
    Order.krullDim_eq_of_orderIso (irreducibleSetEquivPoints (α := Z))]
  exact Order.krullDim_le_of_strictMono _ hmono

theorem wcfd_frobenius_endo : ∀ (K : Type u) [Field K] [IsAlgClosed K] (S : Scheme.{u}) (fS : S ⟶ Spec (.of K)) [LocallyOfFiniteType fS] (e : ℕ), ∃ Φ : S ⟶ S, IsFinite Φ ∧ (∀ x : S, Φ x = x) ∧ ∀ (U : S.Opens) (hU : U ≤ Φ ⁻¹ᵁ U) (s : Γ(S, U)), (Φ.appLE U U hU).hom s = s ^ (ringExpChar K ^ e) :=
by
  classical
  intro K _ _ S fS _ e
  have hp0 : ringExpChar K ≠ 0 := expChar_ne_zero K (ringExpChar K)
  have hq : 0 < ringExpChar K ^ e := Nat.pos_of_ne_zero (pow_ne_zero e hp0)

  let ι : ∀ U : S.Opens, K →+* Γ(S, U) := fun U =>
    (fS.appLE ⊤ U (fun _ _ => trivial)).hom.comp (Scheme.ΓSpecIso (.of K)).inv.hom

  have hadd : ∀ (U : S.Opens) (a b : Γ(S, U)),
      (a + b) ^ (ringExpChar K ^ e) = a ^ (ringExpChar K ^ e) + b ^ (ringExpChar K ^ e) := by
    intro U a b
    rcases subsingleton_or_nontrivial Γ(S, U) with h | h
    · exact Subsingleton.elim _ _
    · haveI : ExpChar Γ(S, U) (ringExpChar K) :=
        expChar_of_injective_ringHom (f := ι U) (ι U).injective (ringExpChar K)
      exact add_pow_expChar_pow a b (ringExpChar K) e

  let fr : ∀ U : S.Opens, Γ(S, U) →+* Γ(S, U) := fun U =>
    { toFun := fun s => s ^ (ringExpChar K ^ e)
      map_one' := one_pow _
      map_mul' := fun a b => mul_pow a b _
      map_zero' := zero_pow hq.ne'
      map_add' := hadd U }
  let c : S.presheaf ⟶
      (TopCat.Presheaf.pushforward CommRingCat (𝟙 S.toTopCat)).obj S.presheaf :=
    { app := fun U => CommRingCat.ofHom (fr U.unop)
      naturality := by
        intro U V i
        ext s
        exact (map_pow (S.presheaf.map i).hom s _).symm }
  let ψ : S.toPresheafedSpace ⟶ S.toPresheafedSpace := ⟨𝟙 _, c⟩
  have hloc : ∀ y, IsLocalHom (ψ.stalkMap y).hom := by
    intro y
    constructor
    intro a ha
    obtain ⟨U, hyU, s, rfl⟩ := S.presheaf.exists_germ_eq a
    rw [PresheafedSpace.stalkMap_germ_apply ψ U y hyU s] at ha
    change IsUnit ((S.presheaf.germ U y hyU).hom (s ^ (ringExpChar K ^ e))) at ha
    rwa [map_pow, isUnit_pow_iff hq.ne'] at ha
  let Φ : S ⟶ S := ⟨⟨ψ, hloc⟩⟩
  have hpow : ∀ (U : S.Opens) (hU : U ≤ Φ ⁻¹ᵁ U) (s : Γ(S, U)),
      (Φ.appLE U U hU).hom s = s ^ (ringExpChar K ^ e) := by
    intro U hU s
    change (S.presheaf.map (homOfLE hU).op).hom (s ^ (ringExpChar K ^ e)) = s ^ (ringExpChar K ^ e)
    erw [show (homOfLE hU).op = 𝟙 (Opposite.op U) from rfl, S.presheaf.map_id]
    rfl
  refine ⟨Φ, ?_, fun x => rfl, hpow⟩

  rw [isFinite_iff]
  refine ⟨(isAffineHom_iff Φ).mpr (fun U hU => hU), fun U hU => ?_⟩
  have hfin : (fr U).Finite := by
    apply RingHom.IsIntegral.to_finite
    · intro a
      refine ⟨Polynomial.X ^ (ringExpChar K ^ e) - Polynomial.C a,
        Polynomial.monic_X_pow_sub_C a hq.ne', ?_⟩
      rw [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C]
      exact sub_self _
    · haveI : PerfectRing K (ringExpChar K) := PerfectField.toPerfectRing (ringExpChar K)
      let φ : K →+* K := (iterateFrobeniusEquiv K (ringExpChar K) e : K →+* K)
      have hφv : ∀ x : K, φ x = x ^ (ringExpChar K ^ e) := fun x => by
        change iterateFrobeniusEquiv K (ringExpChar K) e x = _
        rw [iterateFrobeniusEquiv_apply, iterateFrobenius_def]
      have hφ : φ.FiniteType :=
        RingHom.FiniteType.of_surjective φ (iterateFrobeniusEquiv K (ringExpChar K) e).surjective
      have hι1 : (fS.appLE ⊤ U (fun _ _ => trivial)).hom.FiniteType :=
        HasRingHomProperty.appLE @LocallyOfFiniteType fS inferInstance
          ⟨⊤, isAffineOpen_top _⟩ ⟨U, hU⟩ (fun _ _ => trivial)
      have hι2 : (Scheme.ΓSpecIso (.of K)).inv.hom.FiniteType :=
        RingHom.FiniteType.of_surjective _ (fun x => ⟨_, Iso.hom_inv_id_apply _ x⟩)
      have hι : (ι U).FiniteType := hι1.comp hι2
      have hcomm : (fr U).comp (ι U) = (ι U).comp φ := by
        ext x
        change (ι U x) ^ (ringExpChar K ^ e) = ι U (φ x)
        rw [hφv, map_pow]
      have h2 : ((fr U).comp (ι U)).FiniteType := by
        rw [hcomm]; exact hι.comp hφ
      exact RingHom.FiniteType.of_comp_finiteType h2
  exact hfin

theorem wcfd_reduced_normalization : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (R : Scheme.{u}) (fR : R ⟶ Spec (.of Ω)) [IsProper fR] [IsReduced R], ∃ (Xt : Scheme.{u}) (b : Xt ⟶ R) (Z : Scheme.{u}) (iZ : Z ⟶ R), IsFinite b ∧ IsClosedImmersion iZ ∧ (∀ U : R.Opens, (U : Set R) = (Set.range iZ)ᶜ → IsIso (b ∣_ U)) ∧ (∀ x : Xt, IsDomain (Xt.presheaf.stalk x) ∧ IsIntegrallyClosed (Xt.presheaf.stalk x)) ∧ (∀ z : Z, ∃ y : R, y ⤳ iZ z ∧ y ≠ iZ z) ∧ (∀ x : Xt, ∃ x' : Xt, x' ⤳ x ∧ b x' ∉ Set.range iZ) :=
by

  have s0 : ∀ (Ω : Type u) [Field Ω] (R : Scheme.{u}) (fR : R ⟶ Spec (.of Ω)) [IsProper fR]
      (V : R.affineOpens), ∃ φ : Ω →+* Γ(R, V), φ.FiniteType := by
    intro Ω _ R fR _ V
    have h := HasRingHomProperty.appLE @LocallyOfFiniteType fR inferInstance
      ⟨⊤, isAffineOpen_top _⟩ V (by simp)
    refine ⟨(fR.appLE ⊤ V.1 (by simp)).hom.comp (Scheme.ΓSpecIso (.of Ω)).inv.hom, ?_⟩
    exact h.comp (RingHom.FiniteType.of_surjective _
      (Scheme.ΓSpecIso (.of Ω)).commRingCatIsoToRingEquiv.symm.surjective)

  have s4b : ∀ (B : Type u) [CommRing B] [IsDomain B] [IsIntegrallyClosed B] (L : Type u)
      [CommRing L] [Algebra B L], Nonempty (L ≃ₐ[B] ((P : {P : PrimeSpectrum B //
        P.asIdeal ∈ minimalPrimes B}) → Localization.AtPrime P.1.asIdeal)) →
      Function.Bijective (algebraMap B (integralClosure B L)) := by
    intro B _ _ _ L _ _ ⟨e⟩
    have hmin : (⊥ : Ideal B) ∈ minimalPrimes B := by
      refine ⟨⟨Ideal.isPrime_bot, bot_le⟩, fun q _ _ => bot_le⟩
    let P0 : {P : PrimeSpectrum B // P.asIdeal ∈ minimalPrimes B} :=
      ⟨⟨⊥, Ideal.isPrime_bot⟩, hmin⟩
    have huniq : ∀ P : {P : PrimeSpectrum B // P.asIdeal ∈ minimalPrimes B}, P = P0 := by
      intro P
      apply Subtype.ext
      apply PrimeSpectrum.ext
      exact le_antisymm (P.2.2 ⟨Ideal.isPrime_bot, bot_le⟩ bot_le) bot_le
    haveI : IsFractionRing B (Localization.AtPrime P0.1.asIdeal) := by
      have : P0.1.asIdeal.primeCompl = nonZeroDivisors B := by
        ext x; simp [Ideal.primeCompl, P0, mem_nonZeroDivisors_iff_ne_zero]
      show IsLocalization (nonZeroDivisors B) _
      rw [← this]; infer_instance
    let π : L →ₐ[B] Localization.AtPrime P0.1.asIdeal := (Pi.evalAlgHom B _ P0).comp e.toAlgHom
    have hπinj : Function.Injective π := by
      intro x y hxy
      apply e.injective
      funext P
      rw [huniq P]
      exact hxy
    constructor
    · intro a a' h
      have h2 : algebraMap B L a = algebraMap B L a' := congrArg Subtype.val h
      have h3 := congrArg π h2
      rw [π.commutes, π.commutes] at h3
      exact IsFractionRing.injective B _ h3
    · rintro ⟨x, hx⟩
      have hx' : IsIntegral B (π x) := hx.map π
      obtain ⟨a, ha⟩ := IsIntegrallyClosed.isIntegral_iff.mp hx'
      refine ⟨a, Subtype.ext (hπinj ?_)⟩
      show π (algebraMap B L a) = π x
      rw [π.commutes, ha]

  have s6a : ∀ (X R : Scheme.{u}) (g : X ⟶ R) [QuasiCompact g] [QuasiSeparated g],
      (∀ V : R.affineOpens, letI := (g.app V).hom.toAlgebra;
        Module.Finite Γ(R, V) (integralClosure Γ(R, V) Γ(X, g ⁻¹ᵁ V))) →
      IsFinite (Scheme.Hom.fromNormalization g) := by
    intro X R g _ _ h
    rw [isFinite_iff]
    refine ⟨inferInstance, fun U hU => ?_⟩
    rw [Scheme.Hom.fromNormalization_app g hU]
    letI := (g.app U).hom.toAlgebra
    have h1 := h ⟨U, hU⟩
    rw [CommRingCat.hom_comp]
    apply RingHom.Finite.comp
    · exact RingHom.Finite.of_surjective _
        (Scheme.Hom.normalizationObjIso g hU).commRingCatIsoToRingEquiv.symm.surjective
    · exact RingHom.finite_algebraMap.mpr h1

  have s6b : ∀ (X R : Scheme.{u}) (g : X ⟶ R) [QuasiCompact g] [QuasiSeparated g],
      (∀ V : R.affineOpens, letI := (g.app V).hom.toAlgebra;
        ∀ (Q : Ideal (integralClosure Γ(R, V) Γ(X, g ⁻¹ᵁ V))) [Q.IsPrime],
          IsDomain (Localization.AtPrime Q) ∧ IsIntegrallyClosed (Localization.AtPrime Q)) →
      ∀ x : Scheme.Hom.normalization g,
        IsDomain ((Scheme.Hom.normalization g).presheaf.stalk x) ∧
        IsIntegrallyClosed ((Scheme.Hom.normalization g).presheaf.stalk x) := by
    intro X R g _ _ h x
    set b := Scheme.Hom.fromNormalization g
    obtain ⟨V, hV, hbV, -⟩ := exists_isAffineOpen_mem_and_subset (x := b x) (U := ⊤) trivial
    have hW : IsAffineOpen (b ⁻¹ᵁ V) := hV.preimage b
    have hx : x ∈ b ⁻¹ᵁ V := hbV
    letI := (g.app V).hom.toAlgebra
    let e : Γ(Scheme.Hom.normalization g, b ⁻¹ᵁ V) ≃+* integralClosure Γ(R, V) Γ(X, g ⁻¹ᵁ V) :=
      (Scheme.Hom.normalizationObjIso g hV).commRingCatIsoToRingEquiv
    let p := (hW.primeIdealOf ⟨x, hx⟩).asIdeal
    let Q : Ideal (integralClosure Γ(R, V) Γ(X, g ⁻¹ᵁ V)) := p.comap e.symm.toRingHom
    haveI : Q.IsPrime := Ideal.comap_isPrime _ _
    obtain ⟨hd, hic⟩ := h ⟨V, hV⟩ Q
    set y : (b ⁻¹ᵁ V : Scheme) := ⟨x, hx⟩
    show IsDomain ((Scheme.Hom.normalization g).presheaf.stalk y.1) ∧
      IsIntegrallyClosed ((Scheme.Hom.normalization g).presheaf.stalk y.1)
    letI : Algebra Γ(Scheme.Hom.normalization g, b ⁻¹ᵁ V)
        ((Scheme.Hom.normalization g).presheaf.stalk y.1) :=
      TopCat.Presheaf.algebra_section_stalk (Scheme.Hom.normalization g).presheaf y
    haveI := hW.isLocalization_stalk y
    have hM : p.primeCompl.map e.toMonoidHom = Q.primeCompl := by
      ext z
      constructor
      · rintro ⟨w, hw, rfl⟩
        show e.symm (e w) ∉ p
        rw [e.symm_apply_apply]
        exact hw
      · intro hz
        exact ⟨e.symm z, hz, e.apply_symm_apply z⟩
    let f : (Scheme.Hom.normalization g).presheaf.stalk y.1 ≃+* Localization.AtPrime Q :=
      IsLocalization.ringEquivOfRingEquiv (M := p.primeCompl) (T := Q.primeCompl) _ _ e hM
    haveI : IsDomain ((Scheme.Hom.normalization g).presheaf.stalk y.1) :=
      MulEquiv.isDomain _ f.toMulEquiv
    exact ⟨inferInstance, IsIntegrallyClosed.of_equiv f.symm⟩

  have s6c : ∀ (X R : Scheme.{u}) (g : X ⟶ R) [QuasiCompact g] [QuasiSeparated g] (W : R.Opens),
      IsAffineOpen W → (letI := (g.app W).hom.toAlgebra;
        Function.Bijective (algebraMap Γ(R, W) (integralClosure Γ(R, W) Γ(X, g ⁻¹ᵁ W)))) →
      IsIso (Scheme.Hom.fromNormalization g ∣_ W) := by
    intro X R g _ _ W hW hbij
    set b := Scheme.Hom.fromNormalization g
    haveI : IsAffine W := hW
    haveI : IsAffine (b ⁻¹ᵁ W : Scheme) := hW.preimage b
    have hiso : IsIso (b.app W) := by
      rw [Scheme.Hom.fromNormalization_app g hW]
      letI := (g.app W).hom.toAlgebra
      haveI : IsIso (CommRingCat.ofHom (algebraMap Γ(R, W)
          (integralClosure Γ(R, W) Γ(X, g ⁻¹ᵁ W)))) :=
        (RingEquiv.ofBijective _ hbij).toCommRingCatIso.isIso_hom
      infer_instance
    have hiso' : ∀ U' : R.Opens, U' = W → IsIso (b.app U') := by
      rintro U' rfl; exact hiso
    have htop : IsIso (Scheme.Hom.appTop (b ∣_ W)) := by
      rw [morphismRestrict_appTop]
      have h3 := hiso' _ (Scheme.Opens.ι_image_top W)
      exact @IsIso.comp_isIso _ _ _ _ _ _ _ h3 (Functor.map_isIso _ _)
    have := Scheme.isoSpec_hom_naturality (b ∣_ W)
    have h2 : b ∣_ W = (b ⁻¹ᵁ W : Scheme).isoSpec.hom ≫ Spec.map (Scheme.Hom.appTop (b ∣_ W)) ≫
        (W : Scheme).isoSpec.inv := by
      rw [← Category.assoc, this]; simp
    rw [h2]
    infer_instance

  have s9 : ∀ (R : Scheme.{u}) (N : Set R), IsClosed N →
      ∃ (Z : Scheme.{u}) (iZ : Z ⟶ R), IsClosedImmersion iZ ∧ Set.range iZ = N := by
    intro R N hN
    refine ⟨(Scheme.IdealSheafData.vanishingIdeal ⟨N, hN⟩).subscheme,
      (Scheme.IdealSheafData.vanishingIdeal ⟨N, hN⟩).subschemeι, inferInstance, ?_⟩
    rw [Scheme.IdealSheafData.range_subschemeι, Scheme.IdealSheafData.coe_support_vanishingIdeal]
    rfl

  have s10 : ∀ (X R : Scheme.{u}) (b : X ⟶ R) (U : R.Opens),
      (∀ y ∈ U, ∃ V : R.Opens, y ∈ V ∧ IsIso (b ∣_ V)) → IsIso (b ∣_ U) := by
    intro X R b U h
    have hmono : ∀ (V W : R.Opens), W ≤ V → IsIso (b ∣_ V) → IsIso (b ∣_ W) := by
      intro V W hWV hV
      have h1 : IsIso ((b ∣_ V) ∣_ (V.ι ⁻¹ᵁ W)) :=
        IsZariskiLocalAtTarget.restrict (P := MorphismProperty.isomorphisms Scheme) hV _
      have e : V.ι ''ᵁ (V.ι ⁻¹ᵁ W) = W := by
        rw [Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι]
        exact inf_eq_right.mpr hWV
      have h2 := (MorphismProperty.isomorphisms Scheme).arrow_mk_iso_iff
        (morphismRestrictRestrict b V (V.ι ⁻¹ᵁ W)) |>.mp h1
      rw [e] at h2
      exact h2
    choose! V hyV hV using h
    have key : ∀ y : U, IsIso ((b ∣_ U) ∣_ (U.ι ⁻¹ᵁ V y.1)) := by
      intro y
      have h1 : IsIso (b ∣_ (U.ι ''ᵁ (U.ι ⁻¹ᵁ V y.1))) := by
        apply hmono (V y.1) _ _ (hV y.1 y.2)
        rw [Scheme.Hom.image_preimage_eq_opensRange_inf]
        exact inf_le_right
      exact (MorphismProperty.isomorphisms Scheme).arrow_mk_iso_iff
        (morphismRestrictRestrict b U (U.ι ⁻¹ᵁ V y.1)) |>.mpr h1
    have htop : ⨆ y : U, U.ι ⁻¹ᵁ V y.1 = ⊤ := by
      rw [eq_top_iff]
      intro z _
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨z, hyV z.1 z.2⟩
    exact (IsZariskiLocalAtTarget.iff_of_iSup_eq_top
      (P := MorphismProperty.isomorphisms Scheme) _ htop).mpr key

  have s12 : ∀ (R : Scheme.{u}) (V : R.Opens) (hV : IsAffineOpen V) (y : R) (hy : y ∈ V),
      ((∀ y' : R, y' ⤳ y → y' = y) →
        (hV.primeIdealOf ⟨y, hy⟩).asIdeal ∈ minimalPrimes Γ(R, V)) ∧
      ∀ f : Γ(R, V), f ∉ (hV.primeIdealOf ⟨y, hy⟩).asIdeal → y ∈ R.basicOpen f := by
    intro R V hV y hy
    have hfy : hV.fromSpec (hV.primeIdealOf ⟨y, hy⟩) = y := hV.fromSpec_primeIdealOf ⟨y, hy⟩
    refine ⟨fun hgen => ?_, fun f hf => ?_⟩
    · refine ⟨⟨(hV.primeIdealOf ⟨y, hy⟩).isPrime, bot_le⟩, fun q ⟨hq, _⟩ hle => ?_⟩
      let q' : PrimeSpectrum Γ(R, V) := ⟨q, hq⟩
      have hsp : q' ⤳ hV.primeIdealOf ⟨y, hy⟩ := (PrimeSpectrum.le_iff_specializes _ _).mp hle
      have h1 : hV.fromSpec q' ⤳ y := hfy ▸ hsp.map hV.fromSpec.continuous
      have h2 : hV.fromSpec q' = hV.fromSpec (hV.primeIdealOf ⟨y, hy⟩) :=
        (hgen _ h1).trans hfy.symm
      have h3 := hV.fromSpec.isOpenEmbedding.injective h2
      have : q' = hV.primeIdealOf ⟨y, hy⟩ := h3
      rw [← this]
    · have h1 : hV.primeIdealOf ⟨y, hy⟩ ∈ PrimeSpectrum.basicOpen f := hf
      rw [← hV.fromSpec_preimage_basicOpen] at h1
      have h2 : hV.fromSpec (hV.primeIdealOf ⟨y, hy⟩) ∈ R.basicOpen f := h1
      rwa [hfy] at h2

  have s6 : ∀ (A : Type u) [CommRing A] [IsNoetherianRing A] (L : Type u) [CommRing L] [Algebra A L], Nonempty (L ≃ₐ[A] ((P : {P : PrimeSpectrum A // P.asIdeal ∈ minimalPrimes A}) → Localization.AtPrime P.1.asIdeal)) → ∀ Q ∈ minimalPrimes (integralClosure A L), Q.comap (algebraMap A (integralClosure A L)) ∈ minimalPrimes A := by
    intro A _ _ L _ _ ⟨e⟩ Q hQ
    have : Q.IsPrime := hQ.1.1
    set q := Q.comap (algebraMap A (integralClosure A L)) with hq
    have hqp : q.IsPrime := Ideal.comap_isPrime _ _
    have hdis := Ideal.disjoint_nonZeroDivisors_of_mem_minimalPrimes hQ
    have hunit : ∀ a : A, (∀ P ∈ minimalPrimes A, a ∉ P) → IsUnit (algebraMap A L a) := by
      intro a ha
      have h1 : IsUnit (e (algebraMap A L a)) := by
        rw [e.commutes, Pi.isUnit_iff]
        intro P
        rw [Pi.algebraMap_apply]
        exact (IsLocalization.AtPrime.isUnit_to_map_iff _ P.1.asIdeal a).mpr (ha _ P.2)
      have h2 := h1.map e.symm
      simpa using h2
    have hsub : (q : Set A) ⊆ ⋃ P ∈ minimalPrimes A, ((id P : Ideal A) : Set A) := by
      intro a haq
      by_contra hcon
      simp only [Set.mem_iUnion, not_exists, id] at hcon
      have hu := hunit a (fun P hP h => hcon P hP h)
      have hnzd : algebraMap A (integralClosure A L) a ∈ nonZeroDivisors (integralClosure A L) := by
        rw [mem_nonZeroDivisors_iff_right]
        intro c hc
        apply Subtype.ext
        have hc' : (c : L) * algebraMap A L a = 0 := by
          have := congrArg (fun z : integralClosure A L => (z : L)) hc
          simpa using this
        simpa using (hu.mul_left_eq_zero).mp hc'
      exact Set.disjoint_left.mp hdis haq hnzd
    obtain ⟨P, hP, hle⟩ := (Ideal.subset_union_prime_finite (minimalPrimes.finite_of_isNoetherianRing A)
      (f := id) ⊥ ⊥ (fun P hP _ _ => hP.1.1)).mp hsub
    have heq : q = P := le_antisymm hle (hP.2 ⟨hqp, bot_le⟩ hle)
    rw [heq]
    exact hP

  have s7 : ∀ (X R : Scheme.{u}) (g : X ⟶ R) [QuasiCompact g] [QuasiSeparated g], (∀ V : R.affineOpens, letI := (g.app V).hom.toAlgebra; ∀ Q ∈ minimalPrimes (integralClosure Γ(R, V) Γ(X, g ⁻¹ᵁ V)), Q.comap (algebraMap Γ(R, V) (integralClosure Γ(R, V) Γ(X, g ⁻¹ᵁ V))) ∈ minimalPrimes Γ(R, V)) → ∀ x : Scheme.Hom.normalization g, ∃ x' : Scheme.Hom.normalization g, x' ⤳ x ∧ ∀ y : R, y ⤳ Scheme.Hom.fromNormalization g x' → y = Scheme.Hom.fromNormalization g x' := by
    intro X R g _ _ hD x
    set b := Scheme.Hom.fromNormalization g
    obtain ⟨V, hV, hbV, -⟩ := exists_isAffineOpen_mem_and_subset (x := b x) (U := ⊤) trivial
    have hW : IsAffineOpen (b ⁻¹ᵁ V) := hV.preimage b
    have hx : x ∈ b ⁻¹ᵁ V := hbV
    letI := (g.app V).hom.toAlgebra
    set p := hW.primeIdealOf ⟨x, hx⟩
    obtain ⟨q₀, hq₀, hle⟩ := Ideal.exists_minimalPrimes_le (J := p.asIdeal) (I := ⊥) bot_le
    let s : Spec Γ(Scheme.Hom.normalization g, b ⁻¹ᵁ V) := ⟨q₀, hq₀.1.1⟩
    refine ⟨hW.fromSpec s, ?_, ?_⟩
    · have hsp : s ⤳ p := (PrimeSpectrum.le_iff_specializes _ _).mp hle
      have := hsp.map hW.fromSpec.continuous
      rwa [hW.fromSpec_primeIdealOf] at this
    · have hcomp := IsAffineOpen.SpecMap_appLE_fromSpec b hV hW le_rfl
      have hbx : b (hW.fromSpec s) = hV.fromSpec ((Spec.map (b.appLE V (b ⁻¹ᵁ V) le_rfl)) s) := by
        rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, hcomp]
      let e : Γ(Scheme.Hom.normalization g, b ⁻¹ᵁ V) ≃+* integralClosure Γ(R, V) Γ(X, g ⁻¹ᵁ V) :=
        (Scheme.Hom.normalizationObjIso g hV).commRingCatIsoToRingEquiv
      let Q : Ideal (integralClosure Γ(R, V) Γ(X, g ⁻¹ᵁ V)) := q₀.comap e.symm.toRingHom
      have hQ : Q ∈ minimalPrimes (integralClosure Γ(R, V) Γ(X, g ⁻¹ᵁ V)) := by
        have := Ideal.minimalPrimes_comap_of_surjective (f := e.symm.toRingHom) e.symm.surjective hq₀
        rw [Ideal.comap_bot_of_injective e.symm.toRingHom e.symm.injective] at this
        exact this
      have hP := hD ⟨V, hV⟩ Q hQ
      set t := (Spec.map (b.appLE V (b ⁻¹ᵁ V) le_rfl)) s with ht
      have hideal : t.asIdeal =
          Q.comap (algebraMap Γ(R, V) (integralClosure Γ(R, V) Γ(X, g ⁻¹ᵁ V))) := by
        show q₀.comap (b.appLE V (b ⁻¹ᵁ V) le_rfl).hom = _
        rw [← Scheme.Hom.app_eq_appLE, Scheme.Hom.fromNormalization_app g hV, CommRingCat.hom_comp,
          ← Ideal.comap_comap]
        rfl
      rw [hbx]
      intro y hy
      have hmem : hV.fromSpec t ∈ (V : Set R) := hV.range_fromSpec ▸ ⟨t, rfl⟩
      have hyV : y ∈ (V : Set R) := hy.mem_open V.isOpen hmem
      rw [← hV.range_fromSpec] at hyV
      obtain ⟨t', rfl⟩ := hyV
      have hsp : t' ⤳ t := hV.fromSpec.isOpenEmbedding.isInducing.specializes_iff.mp hy
      have hle' : t'.asIdeal ≤ t.asIdeal := (PrimeSpectrum.le_iff_specializes _ _).mpr hsp
      rw [hideal] at hle'
      have hge := hP.2 ⟨t'.isPrime, bot_le⟩ hle'
      rw [← hideal] at hge
      have : t' = t := PrimeSpectrum.ext (le_antisymm (hideal ▸ hle') hge)
      rw [this]
  intro Ω _ _ R fR _ _
  obtain ⟨X, g, hqc, hqs, hL⟩ := generic_points_scheme Ω R fR
  haveI := hqc
  haveI := hqs
  have hnoeth : ∀ (V : R.Opens) (hV : IsAffineOpen V), IsNoetherianRing Γ(R, V) := by
    intro V hV
    obtain ⟨φ, hφ⟩ := s0 Ω R fR ⟨V, hV⟩
    letI := φ.toAlgebra
    haveI : Algebra.FiniteType Ω Γ(R, V) := hφ
    exact Algebra.FiniteType.isNoetherianRing Ω _
  have hfinP : ∀ (V : R.Opens) (hV : IsAffineOpen V), ∀ P ∈ minimalPrimes Γ(R, V),
      Module.Finite (Γ(R, V) ⧸ P)
        (integralClosure (Γ(R, V) ⧸ P) (FractionRing (Γ(R, V) ⧸ P))) := by
    intro V hV P hP
    obtain ⟨φ, hφ⟩ := s0 Ω R fR ⟨V, hV⟩
    letI := φ.toAlgebra
    haveI : Algebra.FiniteType Ω Γ(R, V) := hφ
    haveI : P.IsPrime := hP.1.1
    exact noether_integralClosure_finite Ω (Γ(R, V) ⧸ P)
  haveI hfin : IsFinite (Scheme.Hom.fromNormalization g) := by
    apply s6a X R g
    intro V
    letI := (g.app V).hom.toAlgebra
    haveI := hnoeth V.1 V.2
    exact integralClosure_prod_minimal_finite Γ(R, V) Γ(X, g ⁻¹ᵁ V) (hL V) (hfinP V.1 V.2)
  have hnorm := s6b X R g (fun V => by
    letI := (g.app V).hom.toAlgebra
    haveI := hnoeth V.1 V.2
    exact integralClosure_prod_minimal_stalks_normal Γ(R, V) Γ(X, g ⁻¹ᵁ V) (hL V))
  have hgen : ∀ y : R, (∀ y' : R, y' ⤳ y → y' = y) →
      ∃ W : R.Opens, y ∈ W ∧ IsIso (Scheme.Hom.fromNormalization g ∣_ W) := by
    intro y hy
    obtain ⟨V, hV, hyV, -⟩ := exists_isAffineOpen_mem_and_subset (x := y) (U := ⊤) trivial
    obtain ⟨hmin, hbasic⟩ := s12 R V hV y hyV
    haveI := hnoeth V hV
    obtain ⟨f, hf, hB⟩ := reduced_noetherian_generic_normal Γ(R, V) (hfinP V hV) _ (hmin hy)
    have hW : IsAffineOpen (R.basicOpen f) := hV.basicOpen f
    haveI := hV.isLocalization_basicOpen f
    obtain ⟨hdom, hic⟩ := hB Γ(R, R.basicOpen f)
    refine ⟨R.basicOpen f, hbasic f hf, ?_⟩
    apply s6c X R g _ hW
    letI := (g.app (R.basicOpen f)).hom.toAlgebra
    exact s4b Γ(R, R.basicOpen f) Γ(X, g ⁻¹ᵁ R.basicOpen f) (hL ⟨R.basicOpen f, hW⟩)
  let G : Set R := {y | ∃ W : R.Opens, y ∈ W ∧ IsIso (Scheme.Hom.fromNormalization g ∣_ W)}
  have hGopen : IsOpen G := by
    rw [isOpen_iff_forall_mem_open]
    rintro y ⟨W, hyW, hW⟩
    exact ⟨W, fun z hz => ⟨W, hz, hW⟩, W.isOpen, hyW⟩
  obtain ⟨Z, iZ, hiZ, hrange⟩ := s9 R Gᶜ hGopen.isClosed_compl
  haveI := hiZ
  have hnongen : ∀ z : Z, ∃ y' : R, y' ⤳ iZ z ∧ y' ≠ iZ z := by
    intro z
    have hz : iZ z ∈ Gᶜ := by rw [← hrange]; exact ⟨z, rfl⟩
    by_contra hcon
    push_neg at hcon
    obtain ⟨W, hyW, hW⟩ := hgen (iZ z) hcon
    exact hz ⟨W, hyW, hW⟩
  have hD1 : ∀ V : R.affineOpens, letI := (g.app V).hom.toAlgebra;
      ∀ Q ∈ minimalPrimes (integralClosure Γ(R, V) Γ(X, g ⁻¹ᵁ V)),
        Q.comap (algebraMap Γ(R, V) (integralClosure Γ(R, V) Γ(X, g ⁻¹ᵁ V))) ∈
          minimalPrimes Γ(R, V) := by
    intro V
    letI := (g.app V).hom.toAlgebra
    haveI := hnoeth V.1 V.2
    exact s6 Γ(R, V) Γ(X, g ⁻¹ᵁ V) (hL V)
  have hdense : ∀ x : Scheme.Hom.normalization g, ∃ x' : Scheme.Hom.normalization g,
      x' ⤳ x ∧ Scheme.Hom.fromNormalization g x' ∉ Set.range iZ := by
    intro x
    obtain ⟨x', hsp, hgx'⟩ := s7 X R g hD1 x
    refine ⟨x', hsp, fun hmem => ?_⟩
    rw [hrange] at hmem
    obtain ⟨W, hW, hiso⟩ := hgen _ hgx'
    exact hmem ⟨W, hW, hiso⟩
  refine ⟨Scheme.Hom.normalization g, Scheme.Hom.fromNormalization g, Z, iZ, hfin, hiZ,
    ?_, hnorm, hnongen, hdense⟩
  intro U hU
  apply s10 _ R _ U
  intro y hy
  have h : y ∈ (U : Set R) := hy
  rw [hU, hrange, compl_compl] at h
  exact h

theorem wcfd_gst_chart_geom_dim : ∀ (S X : Scheme.{u}) (g : X ⟶ S) (V : S.Opens) (hV : IsAffineOpen V) (U : X.Opens), IsAffineOpen U → ∀ (hUV : U ≤ g ⁻¹ᵁ V) (Ω : Type u) [Field Ω] [Algebra Γ(S, V) Ω], topologicalKrullDim ↥(Limits.pullback g (Spec.map (CommRingCat.ofHom (algebraMap Γ(S, V) Ω)) ≫ hV.fromSpec)) ≤ ((1 : ℕ) : WithBot ℕ∞) → letI := (g.appLE V U hUV).hom.toAlgebra; ringKrullDim (TensorProduct Γ(S, V) Γ(X, U) Ω) ≤ 1 :=
by
  intro S X g V hV U hU hUV Ω _ inst hdim
  have homeo : ∀ (ψ : Γ(S, V) →+* Ω) (t : Spec (.of Ω) ⟶ S),
      t = Spec.map (CommRingCat.ofHom ψ) ≫ hV.fromSpec →
      letI := (g.appLE V U hUV).hom.toAlgebra; letI := ψ.toAlgebra;
      Nonempty (↥((Limits.pullback.fst g t) ⁻¹' (U : Set X)) ≃ₜ
        PrimeSpectrum (TensorProduct Γ(S, V) Γ(X, U) Ω)) := by
    intro ψ t ht
    letI := (g.appLE V U hUV).hom.toAlgebra
    letI := ψ.toAlgebra
    have H1 : IsPullback (Limits.pullback.fst g t ∣_ U)
        ((Limits.pullback.fst g t ⁻¹ᵁ U).ι ≫ Limits.pullback.snd g t) (U.ι ≫ g) t :=
      (isPullback_morphismRestrict (Limits.pullback.fst g t) U).paste_vert
        (IsPullback.of_hasPullback g t)
    have H20 : IsPullback
        (Limits.pullback.fst (Spec.map (g.appLE V U hUV)) (Spec.map (CommRingCat.ofHom ψ)))
        (Limits.pullback.snd (Spec.map (g.appLE V U hUV)) (Spec.map (CommRingCat.ofHom ψ)))
        (Spec.map (g.appLE V U hUV) ≫ hV.fromSpec)
        (Spec.map (CommRingCat.ofHom ψ) ≫ hV.fromSpec) :=
      IsPullback.of_isLimit (Limits.pullbackIsPullbackOfCompMono _ _ hV.fromSpec)
    have H2 : IsPullback
        (Limits.pullback.fst (Spec.map (g.appLE V U hUV)) (Spec.map (CommRingCat.ofHom ψ)) ≫
          hU.isoSpec.inv)
        (Limits.pullback.snd (Spec.map (g.appLE V U hUV)) (Spec.map (CommRingCat.ofHom ψ)))
        (U.ι ≫ g) t :=
      IsPullback.of_iso H20 (Iso.refl _) hU.isoSpec.symm (Iso.refl _) (Iso.refl _)
        (by simp) (by simp)
        (by
          rw [Iso.refl_hom, Category.comp_id, Iso.symm_hom, ← Category.assoc,
            IsAffineOpen.isoSpec_inv_ι, IsAffineOpen.SpecMap_appLE_fromSpec g hV hU hUV])
        (by rw [Iso.refl_hom, Iso.refl_hom, Category.comp_id, Category.id_comp, ht])
    let e₁ := IsPullback.isoIsPullback _ _ H1 H2
    let e₂ : Limits.pullback (Spec.map (g.appLE V U hUV)) (Spec.map (CommRingCat.ofHom ψ)) ≅
        Spec (.of (TensorProduct Γ(S, V) Γ(X, U) Ω)) :=
      pullbackSpecIso Γ(S, V) Γ(X, U) Ω
    exact ⟨Scheme.homeoOfIso (e₁ ≪≫ e₂)⟩
  letI := (g.appLE V U hUV).hom.toAlgebra
  obtain ⟨e⟩ := homeo (algebraMap Γ(S, V) Ω) _ rfl
  have hinst : (algebraMap Γ(S, V) Ω).toAlgebra = inst :=
    Algebra.algebra_ext _ _ (fun _ => rfl)
  rw [hinst] at e
  have h1 := PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim (TensorProduct Γ(S, V) Γ(X, U) Ω)
  have h2 := IsHomeomorph.topologicalKrullDim_eq e e.isHomeomorph
  have h3 := topologicalKrullDim_subspace_le
    ↥(Limits.pullback g (Spec.map (CommRingCat.ofHom (algebraMap Γ(S, V) Ω)) ≫ hV.fromSpec))
    ((Limits.pullback.fst g (Spec.map (CommRingCat.ofHom (algebraMap Γ(S, V) Ω)) ≫ hV.fromSpec))
      ⁻¹' (U : Set X))
  rw [Nat.cast_one] at hdim
  exact (h1.symm.trans h2.symm).trans_le (h3.trans hdim)

theorem wcfd_gst_twist_chart_ring : ∀ (S X : Scheme.{u}) (g : X ⟶ S) (Φ : S ⟶ S) (V : S.Opens), IsAffineOpen V → ∀ (hVV : V ≤ Φ ⁻¹ᵁ V) (U : X.Opens), IsAffineOpen U → ∀ (hUV : U ≤ g ⁻¹ᵁ V), IsAffineOpen (Limits.pullback.fst g Φ ⁻¹ᵁ U ⊓ Limits.pullback.snd g Φ ⁻¹ᵁ V) ∧ IsPushout (g.appLE V U hUV) (Φ.appLE V V hVV) ((Limits.pullback.fst g Φ).appLE U (Limits.pullback.fst g Φ ⁻¹ᵁ U ⊓ Limits.pullback.snd g Φ ⁻¹ᵁ V) inf_le_left) ((Limits.pullback.snd g Φ).appLE V (Limits.pullback.fst g Φ ⁻¹ᵁ U ⊓ Limits.pullback.snd g Φ ⁻¹ᵁ V) inf_le_right) :=
by
  intro S X g Φ V hV hVV U hU hUV
  have s2 : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y) {U : Y.Opens} {V : X.Opens} (hU : IsAffineOpen U)
      (hV : IsAffineOpen V) (e : V ≤ f ⁻¹ᵁ U),
      f.resLE U V e ≫ hU.isoSpec.hom = hV.isoSpec.hom ≫ Spec.map (f.appLE U V e) := by
    intro X Y f U V hU hV e
    have h : hV.isoSpec.inv ≫ f.resLE U V e = Spec.map (f.appLE U V e) ≫ hU.isoSpec.inv := by
      rw [← cancel_mono U.ι]
      simp only [Category.assoc, Scheme.Hom.resLE_comp_ι, IsAffineOpen.isoSpec_inv_ι]
      rw [← Category.assoc, IsAffineOpen.isoSpec_inv_ι, IsAffineOpen.SpecMap_appLE_fromSpec]
    calc f.resLE U V e ≫ hU.isoSpec.hom
        = hV.isoSpec.hom ≫ (hV.isoSpec.inv ≫ f.resLE U V e) ≫ hU.isoSpec.hom := by simp
      _ = hV.isoSpec.hom ≫ Spec.map (f.appLE U V e) := by rw [h]; simp
  have s3 : ∀ {A B C D : CommRingCat.{u}} (f : A ⟶ B) (g : A ⟶ C) (inl : B ⟶ D) (inr : C ⟶ D),
      IsPullback (Spec.map inl) (Spec.map inr) (Spec.map f) (Spec.map g) →
      IsPushout f g inl inr := by
    intro A B C D f g inl inr h
    have h' : IsPullback (Scheme.Spec.map inl.op) (Scheme.Spec.map inr.op)
        (Scheme.Spec.map f.op) (Scheme.Spec.map g.op) := h
    exact (IsPullback.of_map_of_faithful Scheme.Spec h').unop.flip
  have H1 := Scheme.Hom.isPullback_resLE (IsPullback.of_hasPullback g Φ) hVV hUV
    (UY := Limits.pullback.fst g Φ ⁻¹ᵁ U ⊓ Limits.pullback.snd g Φ ⁻¹ᵁ V) rfl
  have : IsAffine U := hU
  have : IsAffine V := hV
  have hUP : IsAffineOpen (Limits.pullback.fst g Φ ⁻¹ᵁ U ⊓ Limits.pullback.snd g Φ ⁻¹ᵁ V) :=
    IsAffine.of_isIso H1.isoPullback.hom
  refine ⟨hUP, s3 _ _ _ _ ?_⟩
  exact IsPullback.of_iso H1 hUP.isoSpec hU.isoSpec hV.isoSpec hV.isoSpec
    (s2 _ _ _ _) (s2 _ _ _ _) (s2 _ _ _ _) (s2 _ _ _ _)

theorem wcfd_gst_reduced_chart_ring : ∀ (P R : Scheme.{u}) (r : R ⟶ P) [IsClosedImmersion r] [IsReduced R], Set.range r = Set.univ → ∀ (U : P.Opens), IsAffineOpen U → IsAffineOpen (r ⁻¹ᵁ U) ∧ Function.Surjective (r.appLE U (r ⁻¹ᵁ U) le_rfl).hom ∧ RingHom.ker (r.appLE U (r ⁻¹ᵁ U) le_rfl).hom = nilradical Γ(P, U) :=
by
  intro P R r _ _ hsurj U hU
  have hV : IsAffineOpen (r ⁻¹ᵁ U) := hU.preimage r
  have hs : Function.Surjective (r.appLE U (r ⁻¹ᵁ U) le_rfl).hom := by
    have h := (isClosedImmersion_iff_isAffineHom.mp ‹IsClosedImmersion r›).2 U hU
    rw [Scheme.Hom.app_eq_appLE] at h
    exact h
  refine ⟨hV, hs, le_antisymm ?_ ?_⟩
  · intro a ha
    rw [nilradical_eq_sInf, Ideal.mem_sInf]
    intro J hJ
    let p : Spec Γ(P, U) := (⟨J, hJ⟩ : PrimeSpectrum Γ(P, U))
    obtain ⟨y, hy⟩ : hU.fromSpec p ∈ Set.range r := by rw [hsurj]; trivial
    have hyV : y ∈ r ⁻¹ᵁ U := by
      rw [Scheme.Hom.mem_preimage, hy]
      have hm : hU.fromSpec p ∈ Set.range hU.fromSpec := ⟨p, rfl⟩
      rw [hU.range_fromSpec] at hm
      exact hm
    let q : Spec Γ(R, r ⁻¹ᵁ U) := hV.primeIdealOf ⟨y, hyV⟩
    have hq : hV.fromSpec q = y := hV.fromSpec_primeIdealOf ⟨y, hyV⟩
    have hsq := IsAffineOpen.SpecMap_appLE_fromSpec r hU hV le_rfl
    have h1 : (Spec.map (r.appLE U (r ⁻¹ᵁ U) le_rfl) ≫ hU.fromSpec) q = (hV.fromSpec ≫ r) q := by
      rw [hsq]
    rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply, hq, hy] at h1
    have h2 := hU.fromSpec.isOpenEmbedding.isEmbedding.injective h1
    have h3 : (r.appLE U (r ⁻¹ᵁ U) le_rfl).hom a ∈ PrimeSpectrum.asIdeal (R := Γ(R, r ⁻¹ᵁ U)) q := by
      rw [RingHom.mem_ker.mp ha]
      exact zero_mem _
    have h2' : PrimeSpectrum.asIdeal (R := Γ(P, U)) (Spec.map (r.appLE U (r ⁻¹ᵁ U) le_rfl) q) = J := by
      rw [h2]
    rw [← h2']
    exact h3
  · intro a ha
    rw [RingHom.mem_ker]
    exact (IsNilpotent.map (mem_nilradical.mp ha) (r.appLE U (r ⁻¹ᵁ U) le_rfl).hom).eq_zero

theorem wcfd_gst_normalization_chart : ∀ (R Xt Z : Scheme.{u}) [IsLocallyNoetherian R] [IsReduced R] (b : Xt ⟶ R) (iZ : Z ⟶ R) [IsFinite b] [IsClosedImmersion iZ], (∀ U : R.Opens, (U : Set R) = (Set.range iZ)ᶜ → IsIso (b ∣_ U)) → (∀ x : Xt, IsDomain (Xt.presheaf.stalk x) ∧ IsIntegrallyClosed (Xt.presheaf.stalk x)) → (∀ z : Z, ∃ y : R, y ⤳ iZ z ∧ y ≠ iZ z) → (∀ x : Xt, ∃ x' : Xt, x' ⤳ x ∧ b x' ∉ Set.range iZ) → ∀ (U : R.Opens), IsAffineOpen U → IsAffineOpen (b ⁻¹ᵁ U) ∧ Function.Injective (b.appLE U (b ⁻¹ᵁ U) le_rfl).hom ∧ (b.appLE U (b ⁻¹ᵁ U) le_rfl).hom.Finite ∧ (∀ (Q : Ideal Γ(Xt, b ⁻¹ᵁ U)) [Q.IsPrime], IsDomain (Localization.AtPrime Q) ∧ IsIntegrallyClosed (Localization.AtPrime Q)) ∧ ∃ f : Γ(R, U), f ∈ nonZeroDivisors Γ(R, U) ∧ (b.appLE U (b ⁻¹ᵁ U) le_rfl).hom f ∈ nonZeroDivisors Γ(Xt, b ⁻¹ᵁ U) ∧ Function.Bijective (Localization.awayMap (b.appLE U (b ⁻¹ᵁ U) le_rfl).hom f) :=
by
  classical

  have s1 : ∀ (X : Scheme.{u}) (U : X.Opens) (hU : IsAffineOpen U) (P : PrimeSpectrum Γ(X, U)),
      P.asIdeal ∈ minimalPrimes Γ(X, U) → ∀ y : X, y ⤳ hU.fromSpec P → y = hU.fromSpec P := by
    intro X U hU P hP y hy
    have hxU : hU.fromSpec P ∈ (U : Set X) := by rw [← hU.range_fromSpec]; exact ⟨P, rfl⟩
    have hyU : y ∈ (U : Set X) := hy.mem_open U.isOpen hxU
    rw [← hU.range_fromSpec] at hyU
    obtain ⟨p', rfl⟩ := hyU
    haveI := hU.isOpenImmersion_fromSpec
    have hind := (Scheme.Hom.isOpenEmbedding hU.fromSpec).isInducing
    have h1 : p' ⤳ P := hind.specializes_iff.mp hy
    have h2 : p'.asIdeal ≤ P.asIdeal := (PrimeSpectrum.le_iff_specializes p' P).mpr h1
    have h3 : p'.asIdeal = P.asIdeal := le_antisymm h2 (hP.2 ⟨p'.isPrime, bot_le⟩ h2)
    have : p' = P := PrimeSpectrum.ext h3
    rw [this]

  have aux : ∀ (C : Type u) [CommRing C] [_root_.IsReduced C] (r : C),
      (∀ P ∈ minimalPrimes C, r ∉ P) → r ∈ nonZeroDivisors C := by
    intro C _ _ r hr
    rw [mem_nonZeroDivisors_iff_right]
    intro x hx
    have hxr : x * r = 0 := hx
    have hmem : x ∈ (⊥ : Ideal C).radical := by
      rw [← Ideal.sInf_minimalPrimes, Ideal.mem_sInf]
      intro P hP
      have hPp : P.IsPrime := hP.1.1
      have : x * r ∈ P := by rw [hxr]; exact P.zero_mem
      exact (hPp.mem_or_mem this).resolve_right (hr P hP)
    rw [Ideal.radical_bot_of_isReduced] at hmem
    exact (Submodule.mem_bot C).mp hmem

  have s2 : ∀ (A B : Type u) [CommRing A] [CommRing B] [_root_.IsReduced A] [_root_.IsReduced B]
      [IsNoetherianRing A] [IsNoetherianRing B] (φ : A →+* B) (I : Ideal A),
      (∀ P ∈ minimalPrimes A, ¬ I ≤ P) → (∀ Q ∈ minimalPrimes B, ¬ I ≤ Q.comap φ) →
      ∃ f ∈ I, f ∈ nonZeroDivisors A ∧ φ f ∈ nonZeroDivisors B := by
    intro A B _ _ _ _ _ _ φ I hA hB
    have hfin : (minimalPrimes A ∪ Ideal.comap φ '' minimalPrimes B).Finite :=
      (minimalPrimes.finite_of_isNoetherianRing A).union
        ((minimalPrimes.finite_of_isNoetherianRing B).image _)
    have hnot : ¬ ((I : Set A) ⊆ ⋃ i ∈ (hfin.toFinset : Set (Ideal A)), ((id i : Ideal A) : Set A)) := by
      rw [Ideal.subset_union_prime (f := id) ⊥ ⊥ ?_]
      · rintro ⟨i, hi, hIi⟩
        rw [Set.Finite.mem_toFinset] at hi
        rcases hi with hi | ⟨Q, hQ, rfl⟩
        · exact hA i hi hIi
        · exact hB Q hQ hIi
      · intro i hi _ _
        rw [Set.Finite.mem_toFinset] at hi
        rcases hi with hi | ⟨Q, hQ, rfl⟩
        · exact hi.1.1
        · haveI : Q.IsPrime := hQ.1.1
          exact Ideal.IsPrime.comap φ
    rw [Set.not_subset] at hnot
    obtain ⟨f, hfI, hf⟩ := hnot
    simp only [Set.mem_iUnion, not_exists] at hf
    refine ⟨f, hfI, aux A f ?_, aux B (φ f) ?_⟩
    · intro P hP hfP
      exact hf P (by rw [Finset.mem_coe, Set.Finite.mem_toFinset]; exact Or.inl hP) hfP
    · intro Q hQ hfQ
      exact hf (Q.comap φ)
        (by rw [Finset.mem_coe, Set.Finite.mem_toFinset]; exact Or.inr ⟨Q, hQ, rfl⟩) hfQ

  have s3 : ∀ (X Y : Scheme.{u}) (b : X ⟶ Y) (V W : Y.Opens), IsIso (b ∣_ V) → W ≤ V →
      IsIso (b.app W) := by
    intro X Y b V W hiso hWV
    have hW : V.ι ''ᵁ (V.ι ⁻¹ᵁ W) = W := by
      rw [Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι]
      exact inf_eq_right.mpr hWV
    have h1 : IsIso ((b ∣_ V).app (V.ι ⁻¹ᵁ W)) := inferInstance
    rw [morphismRestrict_app] at h1
    have h2 : IsIso (b.app (V.ι ''ᵁ V.ι ⁻¹ᵁ W)) :=
      (isIso_comp_right_iff _ (X.presheaf.map (eqToHom _).op)).mp h1
    have gen : ∀ W' : Y.Opens, W' = W → IsIso (b.app W') → IsIso (b.app W) := by
      rintro W' rfl h
      exact h
    exact gen _ hW h2

  have key : ∀ (A B S Q : Type u) [CommRing A] [CommRing B] [CommRing S] [CommRing Q]
      [Algebra A S] [Algebra B Q] (φ : A →+* B) (f : A) [IsLocalization.Away f S]
      [IsLocalization.Away (φ f) Q], Function.Bijective (IsLocalization.Away.map S Q φ f) →
      Function.Bijective (Localization.awayMap φ f) := by
    intro A B S Q _ _ _ _ _ _ φ f _ _ h
    let e₁ := IsLocalization.algEquiv (Submonoid.powers f) (Localization.Away f) S
    let e₂ := IsLocalization.algEquiv (Submonoid.powers (φ f)) (Localization.Away (φ f)) Q
    have hcomm : ((e₂ : Localization.Away (φ f) ≃+* Q) : Localization.Away (φ f) →+* Q).comp
        (Localization.awayMap φ f) =
        (IsLocalization.Away.map S Q φ f).comp ((e₁ : Localization.Away f ≃+* S) :
          Localization.Away f →+* S) := by
      apply IsLocalization.ringHom_ext (Submonoid.powers f)
      ext a
      simp only [RingHom.comp_apply, RingEquiv.coe_toRingHom, AlgEquiv.coe_ringEquiv,
        Localization.awayMap, IsLocalization.Away.map, IsLocalization.map_eq, AlgEquiv.commutes]
    have h2 : Function.Bijective (e₂ ∘ Localization.awayMap φ f) := by
      have : (e₂ ∘ Localization.awayMap φ f) = (IsLocalization.Away.map S Q φ f) ∘ e₁ := by
        funext x
        exact RingHom.congr_fun hcomm x
      rw [this]
      exact h.comp e₁.bijective
    exact (EquivLike.comp_bijective _ e₂).mp h2

  have s4 : ∀ (X Y : Scheme.{u}) (b : X ⟶ Y) (U : Y.Opens) (hU : IsAffineOpen U)
      (hW : IsAffineOpen (b ⁻¹ᵁ U)) (f : Γ(Y, U)), IsIso (b.app (Y.basicOpen f)) →
      Function.Bijective (Localization.awayMap (b.app U).hom f) := by
    intro X Y b U hU hW f hiso
    haveI := hU.isLocalization_basicOpen f
    haveI := hW.isLocalization_basicOpen ((b.app U).hom f)
    have h1 := IsAffineOpen.app_basicOpen_eq_away_map b hU hW f
    rw [h1, eqToHom_op, eqToHom_map] at hiso
    have h2 := (isIso_comp_right_iff _ _).mp hiso
    have gen : ∀ {A B : CommRingCat.{u}} (g : A ⟶ B), IsIso g → Function.Bijective g.hom :=
      fun g _ => ConcreteCategory.bijective_of_isIso g
    have h3 := gen _ h2
    rw [CommRingCat.hom_ofHom] at h3
    exact key _ _ _ _ (b.app U).hom f h3

  have s5 : ∀ (Y : Scheme.{u}) (W : Y.Opens), IsAffineOpen W →
      (∀ y : Y, IsDomain (Y.presheaf.stalk y) ∧ IsIntegrallyClosed (Y.presheaf.stalk y)) →
      ∀ (Q : Ideal Γ(Y, W)) [Q.IsPrime], IsDomain (Localization.AtPrime Q) ∧
        IsIntegrallyClosed (Localization.AtPrime Q) := by
    intro Y W hW hst Q hQ
    have hy : hW.fromSpec ⟨Q, hQ⟩ ∈ W := by
      show hW.fromSpec ⟨Q, hQ⟩ ∈ (W : Set Y)
      rw [← hW.range_fromSpec]; exact ⟨⟨Q, hQ⟩, rfl⟩
    letI := Y.presheaf.algebra_section_stalk ⟨hW.fromSpec ⟨Q, hQ⟩, hy⟩
    haveI hL : IsLocalization Q.primeCompl (Y.presheaf.stalk (hW.fromSpec ⟨Q, hQ⟩)) :=
      hW.isLocalization_stalk' ⟨Q, hQ⟩ hy
    let e := IsLocalization.algEquiv Q.primeCompl (Localization.AtPrime Q)
      (Y.presheaf.stalk (hW.fromSpec ⟨Q, hQ⟩))
    obtain ⟨h1, h2⟩ := hst (hW.fromSpec ⟨Q, hQ⟩)
    exact ⟨MulEquiv.isDomain _ e.toMulEquiv, IsIntegrallyClosed.of_equiv e.toRingEquiv.symm⟩

  intro R Xt Z _ _ b iZ _ _ H1 H2 H3 H4 U hU
  rw [Scheme.Hom.appLE_eq_app]
  have hW : IsAffineOpen (b ⁻¹ᵁ U) := hU.preimage b
  have hfin : (b.app U).hom.Finite := IsFinite.finite_app b U hU
  haveI hAn : IsNoetherianRing Γ(R, U) := IsLocallyNoetherian.component_noetherian ⟨U, hU⟩
  haveI hAr : _root_.IsReduced Γ(R, U) := IsReduced.component_reduced U
  haveI : ∀ x : Xt, _root_.IsReduced (Xt.presheaf.stalk x) := fun x => by
    haveI := (H2 x).1
    infer_instance
  haveI : AlgebraicGeometry.IsReduced Xt := isReduced_of_isReduced_stalk Xt
  haveI hBr : _root_.IsReduced Γ(Xt, b ⁻¹ᵁ U) := IsReduced.component_reduced _
  haveI hBn : IsNoetherianRing Γ(Xt, b ⁻¹ᵁ U) := by
    letI := (b.app U).hom.toAlgebra
    haveI : Module.Finite Γ(R, U) Γ(Xt, b ⁻¹ᵁ U) := hfin
    exact IsNoetherianRing.of_finite Γ(R, U) _
  have hZc : IsClosed (Set.range iZ) := (Scheme.Hom.isClosedEmbedding iZ).isClosed_range
  have hTc : IsClosed (hU.fromSpec ⁻¹' Set.range iZ) := hZc.preimage hU.fromSpec.continuous
  have hIle : ∀ p : PrimeSpectrum Γ(R, U),
      PrimeSpectrum.vanishingIdeal (hU.fromSpec ⁻¹' Set.range iZ) ≤ p.asIdeal →
      hU.fromSpec p ∈ Set.range iZ := by
    intro p hp
    have hz : p ∈ PrimeSpectrum.zeroLocus
        (PrimeSpectrum.vanishingIdeal (hU.fromSpec ⁻¹' Set.range iZ) : Set Γ(R, U)) :=
      (PrimeSpectrum.mem_zeroLocus _ _).mpr hp
    rw [PrimeSpectrum.zeroLocus_vanishingIdeal_eq_closure] at hz
    exact hTc.closure_subset hz
  have hA : ∀ P ∈ minimalPrimes Γ(R, U),
      ¬ PrimeSpectrum.vanishingIdeal (hU.fromSpec ⁻¹' Set.range iZ) ≤ P := by
    intro P hP hIP
    haveI hPp : P.IsPrime := hP.1.1
    obtain ⟨z, hz⟩ := hIle ⟨P, hPp⟩ hIP
    obtain ⟨y, hy, hne⟩ := H3 z
    rw [hz] at hy hne
    exact hne (s1 R U hU ⟨P, hPp⟩ hP y hy)
  have hB : ∀ Q ∈ minimalPrimes Γ(Xt, b ⁻¹ᵁ U),
      ¬ PrimeSpectrum.vanishingIdeal (hU.fromSpec ⁻¹' Set.range iZ) ≤ Q.comap (b.app U).hom := by
    intro Q hQ hIQ
    haveI hQp : Q.IsPrime := hQ.1.1
    have hsq := hIle (PrimeSpectrum.comap (b.app U).hom ⟨Q, hQp⟩) hIQ
    have hcomm : b (hW.fromSpec ⟨Q, hQp⟩) =
        hU.fromSpec (PrimeSpectrum.comap (b.app U).hom ⟨Q, hQp⟩) := by
      have h := IsAffineOpen.SpecMap_appLE_fromSpec b hU hW le_rfl
      rw [Scheme.Hom.appLE_eq_app] at h
      have h' : ∀ x : Spec Γ(Xt, b ⁻¹ᵁ U),
          hU.fromSpec (Spec.map (b.app U) x) = b (hW.fromSpec x) := by
        intro x
        rw [← Scheme.Hom.comp_apply, h, Scheme.Hom.comp_apply]
      have h'' := h' ⟨Q, hQp⟩
      exact h''.symm.trans (congrArg hU.fromSpec (Spec.map_apply (b.app U) ⟨Q, hQp⟩))
    obtain ⟨x', hx', hbx'⟩ := H4 (hW.fromSpec ⟨Q, hQp⟩)
    have := s1 Xt (b ⁻¹ᵁ U) hW ⟨Q, hQp⟩ hQ x' hx'
    rw [this, hcomm] at hbx'
    exact hbx' hsq
  obtain ⟨f, hfI, hfA, hfB⟩ := s2 _ _ (b.app U).hom _ hA hB
  have hDf : R.basicOpen f ≤ (⟨(Set.range iZ)ᶜ, hZc.isOpen_compl⟩ : R.Opens) := by
    intro x hx
    have hxU : x ∈ U := R.basicOpen_le f hx
    have hxU' : x ∈ Set.range hU.fromSpec := by rw [hU.range_fromSpec]; exact hxU
    obtain ⟨p, rfl⟩ := hxU'
    have hp : p ∈ hU.fromSpec ⁻¹ᵁ R.basicOpen f := hx
    rw [hU.fromSpec_preimage_basicOpen] at hp
    have hp' : f ∉ p.asIdeal := (PrimeSpectrum.mem_basicOpen _ _).mp hp
    show hU.fromSpec p ∉ Set.range iZ
    intro hpZ
    exact hp' ((PrimeSpectrum.mem_vanishingIdeal _ f).mp hfI p hpZ)
  haveI hres := H1 ⟨(Set.range iZ)ᶜ, hZc.isOpen_compl⟩ rfl
  haveI happ := s3 Xt R b _ (R.basicOpen f) hres hDf
  have hbij := s4 Xt R b U hU hW f happ
  have hinj : Function.Injective (b.app U).hom := by
    intro a a' h
    have h1 : Localization.awayMap (b.app U).hom f (algebraMap _ (Localization.Away f) a) =
        Localization.awayMap (b.app U).hom f (algebraMap _ (Localization.Away f) a') := by
      simp only [Localization.awayMap, IsLocalization.Away.map, IsLocalization.map_eq, h]
    have h2 := hbij.1 h1
    exact IsLocalization.injective (Localization.Away f) (Submonoid.powers_le.mpr hfA) h2
  exact ⟨hW, hinj, hfin, s5 Xt _ hW H2, f, hfA, hfB, hbij⟩

theorem wcfd_gst_stalk_as_localization : ∀ (S Y : Scheme.{u}) [IsIntegral S] (p : Y ⟶ S) (V : S.Opens) [Nonempty V], IsAffineOpen V → ∀ (W : Y.Opens), IsAffineOpen W → ∀ (hWV : W ≤ p ⁻¹ᵁ V) (x : Y), x ∈ W → p x = genericPoint S → ∃ (Q : Ideal Γ(Y, W)) (_ : Q.IsPrime) (hQ : (⊥ : Ideal Γ(S, V)) = Q.comap (p.appLE V W hWV).hom), ((Scheme.Hom.stalkMap p x).hom.FormallySmooth ↔ (Localization.localRingHom ⊥ Q (p.appLE V W hWV).hom hQ).FormallySmooth) :=
by
  intro S Y _ p V _ hV W hW hWV x hxW hx
  classical
  have hpx : p x ∈ V := hWV hxW
  have hU : ∀ a : Γ(S, V), a ≠ 0 → IsUnit ((S.presheaf.germ V (p x) hpx).hom a) := by
    intro a ha
    have hne : S.basicOpen a ≠ ⊥ := fun h => ha ((AlgebraicGeometry.basicOpen_eq_bot_iff a).mp h)
    have hgen : genericPoint S ∈ ((S.basicOpen a : S.Opens) : Set S) :=
      ((genericPoint_spec S).mem_open_set_iff (S.basicOpen a).isOpen).mpr
        (by rw [Set.univ_inter]; exact (TopologicalSpace.Opens.ne_bot_iff_nonempty _).mp hne)
    have h1 : p x ∈ S.basicOpen a := by
      show p x ∈ ((S.basicOpen a : S.Opens) : Set S)
      rw [hx]; exact hgen
    exact (Scheme.mem_basicOpen S a (p x) hpx).mp h1
  have hN : ∀ a : Γ(S, V), (Scheme.Hom.stalkMap p x).hom ((S.presheaf.germ V (p x) hpx).hom a) =
      (Y.presheaf.germ W x hxW).hom ((p.appLE V W hWV).hom a) := by
    intro a
    rw [Scheme.Hom.germ_stalkMap_apply, Scheme.Hom.appLE, CommRingCat.comp_apply,
      TopCat.Presheaf.germ_res_apply]
  set Q : Ideal Γ(Y, W) := (hW.primeIdealOf ⟨x, hxW⟩).asIdeal with hQdef
  letI algR : Algebra Γ(Y, W) (Y.presheaf.stalk x) := (Y.presheaf.germ W x hxW).hom.toAlgebra
  haveI hLR : IsLocalization.AtPrime (Y.presheaf.stalk x) Q := hW.isLocalization_stalk ⟨x, hxW⟩
  have hQ : (⊥ : Ideal Γ(S, V)) = Q.comap (p.appLE V W hWV).hom := by
    ext a
    simp only [Ideal.mem_bot, Ideal.mem_comap]
    constructor
    · rintro rfl
      rw [map_zero]
      exact Q.zero_mem
    · intro h
      by_contra ha
      have h1 := (hU a ha).map (Scheme.Hom.stalkMap p x).hom
      rw [hN] at h1
      exact ((IsLocalization.AtPrime.isUnit_to_map_iff (Y.presheaf.stalk x) Q _).mp h1) h
  set P : Ideal Γ(S, V) := (hV.primeIdealOf ⟨p x, hpx⟩).asIdeal with hPdef
  letI algL : Algebra Γ(S, V) (S.presheaf.stalk (p x)) :=
    (S.presheaf.germ V (p x) hpx).hom.toAlgebra
  haveI hLP : IsLocalization.AtPrime (S.presheaf.stalk (p x)) P :=
    hV.isLocalization_stalk ⟨p x, hpx⟩
  have hP : ∀ a, a ∈ P ↔ a = 0 := by
    intro a
    constructor
    · intro h
      by_contra ha
      exact ((IsLocalization.AtPrime.isUnit_to_map_iff (S.presheaf.stalk (p x)) P a).mp
        (hU a ha)) h
    · rintro rfl
      exact P.zero_mem
  have hPc : P.primeCompl = (⊥ : Ideal Γ(S, V)).primeCompl := by
    ext a
    rw [Ideal.mem_primeCompl_iff, Ideal.mem_primeCompl_iff, hP, Ideal.mem_bot]
  haveI hL : IsLocalization (⊥ : Ideal Γ(S, V)).primeCompl (S.presheaf.stalk (p x)) := by
    rw [← hPc]
    exact hLP
  let eL := IsLocalization.algEquiv (⊥ : Ideal Γ(S, V)).primeCompl
    (Localization.AtPrime (⊥ : Ideal Γ(S, V))) (S.presheaf.stalk (p x))
  let eR := IsLocalization.algEquiv Q.primeCompl (Localization.AtPrime Q) (Y.presheaf.stalk x)
  set lrh := Localization.localRingHom ⊥ Q (p.appLE V W hWV).hom hQ with hlrh
  have hsq : (Scheme.Hom.stalkMap p x).hom.comp eL.toRingEquiv.toRingHom =
      eR.toRingEquiv.toRingHom.comp lrh := by
    apply IsLocalization.ringHom_ext (⊥ : Ideal Γ(S, V)).primeCompl
    ext a
    simp only [RingHom.comp_apply]
    have h1 : eL.toRingEquiv.toRingHom
        (algebraMap Γ(S, V) (Localization.AtPrime (⊥ : Ideal Γ(S, V))) a) =
        (S.presheaf.germ V (p x) hpx).hom a := eL.commutes a
    have h2 : eR.toRingEquiv.toRingHom
        (algebraMap Γ(Y, W) (Localization.AtPrime Q) ((p.appLE V W hWV).hom a)) =
        (Y.presheaf.germ W x hxW).hom ((p.appLE V W hWV).hom a) := eR.commutes _
    rw [h1, hN, hlrh, Localization.localRingHom_to_map, h2]
  have hRI := RingHom.FormallySmooth.respectsIso
  refine ⟨Q, inferInstance, hQ, ?_⟩
  constructor
  · intro h
    have h1 := hRI.2 _ eL.toRingEquiv h
    rw [hsq] at h1
    have h2 := hRI.1 _ eR.toRingEquiv.symm h1
    have e : eR.toRingEquiv.symm.toRingHom.comp (eR.toRingEquiv.toRingHom.comp lrh) = lrh := by
      ext y
      simp
    rwa [e] at h2
  · intro h
    have h1 := hRI.1 _ eR.toRingEquiv h
    rw [← hsq] at h1
    have h2 := hRI.2 _ eL.toRingEquiv.symm h1
    have e : ((Scheme.Hom.stalkMap p x).hom.comp eL.toRingEquiv.toRingHom).comp
        eL.toRingEquiv.symm.toRingHom = (Scheme.Hom.stalkMap p x).hom := by
      ext y
      simp
    rwa [e] at h2

theorem wcfd_tn_stalk_of_generic_smooth : ∀ (A B : Type u) [CommRing A] [IsDomain A] [CommRing B] [Algebra A B], (letI : Algebra (FractionRing A) (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors A))) := localizationAlgebra (nonZeroDivisors A) B; Algebra.FormallySmooth (FractionRing A) (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors A)))) → ∀ (Q : Ideal B) [Q.IsPrime] (hQ : (⊥ : Ideal A) = Q.comap (algebraMap A B)), (Localization.localRingHom ⊥ Q (algebraMap A B) hQ).FormallySmooth :=
by
  intro A B _ _ _ _ hk Q _ hQ
  letI : Algebra (FractionRing A) (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors A))) :=
    localizationAlgebra (nonZeroDivisors A) B

  have hle : Algebra.algebraMapSubmonoid B (nonZeroDivisors A) ≤ Q.primeCompl := by
    intro y hy
    obtain ⟨a, ha, rfl⟩ := Submonoid.mem_map.mp hy
    intro hya
    have h1 : a ∈ Q.comap (algebraMap A B) := hya
    rw [← hQ, Ideal.mem_bot] at h1
    exact nonZeroDivisors.ne_zero ha h1

  letI : Algebra (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors A)))
      (Localization.AtPrime Q) :=
    IsLocalization.localizationAlgebraOfSubmonoidLe _ _
      (Algebra.algebraMapSubmonoid B (nonZeroDivisors A)) Q.primeCompl hle
  haveI hst := IsLocalization.localization_isScalarTower_of_submonoid_le
    (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors A))) (Localization.AtPrime Q)
    (Algebra.algebraMapSubmonoid B (nonZeroDivisors A)) Q.primeCompl hle
  haveI hloc := IsLocalization.isLocalization_of_submonoid_le
    (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors A))) (Localization.AtPrime Q)
    (Algebra.algebraMapSubmonoid B (nonZeroDivisors A)) Q.primeCompl hle

  have h3 : (algebraMap (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors A)))
      (Localization.AtPrime Q)).FormallySmooth := by
    rw [RingHom.formallySmooth_algebraMap]
    exact Algebra.FormallySmooth.of_isLocalization
      (Submonoid.map (algebraMap B (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors A))))
        Q.primeCompl)

  have h4 : (algebraMap (FractionRing A)
      (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors A)))).FormallySmooth :=
    RingHom.formallySmooth_algebraMap.mpr hk

  haveI hbot : IsLocalization (⊥ : Ideal A).primeCompl (FractionRing A) := by
    refine IsLocalization.of_le (nonZeroDivisors A) _ ?_ ?_
    · intro a ha h
      exact nonZeroDivisors.ne_zero ha (Ideal.mem_bot.mp h)
    · intro r hr
      have hr0 : r ≠ 0 := fun h => hr (by rw [h]; exact Ideal.zero_mem _)
      exact IsLocalization.map_units (FractionRing A)
        (⟨r, mem_nonZeroDivisors_of_ne_zero hr0⟩ : nonZeroDivisors A)
  let ι := IsLocalization.algEquiv (⊥ : Ideal A).primeCompl (Localization.AtPrime (⊥ : Ideal A))
    (FractionRing A)
  have hι : (ι : Localization.AtPrime (⊥ : Ideal A) →+* FractionRing A).FormallySmooth :=
    RingHom.FormallySmooth.of_bijective ι.bijective

  have heq : Localization.localRingHom ⊥ Q (algebraMap A B) hQ =
      (algebraMap (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors A)))
        (Localization.AtPrime Q)).comp
        ((algebraMap (FractionRing A)
          (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors A)))).comp
          (ι : Localization.AtPrime (⊥ : Ideal A) →+* FractionRing A)) := by
    apply Localization.localRingHom_unique
    intro x
    simp only [RingHom.comp_apply, RingHom.coe_coe, AlgEquiv.commutes]
    rw [localizationAlgebraMap_def, IsLocalization.map_eq, ← IsScalarTower.algebraMap_apply]

  rw [heq]
  exact RingHom.FormallySmooth.comp (RingHom.FormallySmooth.comp hι h4) h3

theorem wcfd_tn_formallySmooth_descent_field : ∀ (k L R : Type u) [Field k] [Field L] [Algebra k L] [CommRing R] [Algebra k R] [Algebra.FiniteType k R], Algebra.FormallySmooth L (TensorProduct k L R) → Algebra.FormallySmooth k R :=
by
  intro k L R _ _ _ _ _ _ hfs
  haveI hfp : Algebra.FinitePresentation k R :=
    Algebra.FinitePresentation.of_finiteType.mp inferInstance
  haveI hfpL : Algebra.FinitePresentation L (TensorProduct k L R) :=
    Algebra.FinitePresentation.baseChange L
  haveI hsmL : Algebra.Smooth L (TensorProduct k L R) := ⟨hfs, hfpL⟩
  have hsmL' : (algebraMap L (TensorProduct k L R)).Smooth := RingHom.smooth_algebraMap.mpr hsmL
  have hff : (algebraMap k L).FaithfullyFlat := RingHom.faithfullyFlat_algebraMap_iff.mpr inferInstance
  letI : Algebra R (TensorProduct k L R) := Algebra.TensorProduct.rightAlgebra
  have hR : (algebraMap k R).Smooth :=
    RingHom.Smooth.codescendsAlong_faithfullyFlat (R := k) (S := R) (R' := L)
      (S' := TensorProduct k L R) hff hsmL'
  exact (RingHom.smooth_algebraMap.mp hR).formallySmooth

theorem wcpa_regular_quotient_conormal : ∀ (R : Type u) [CommRing R] [IsRegularLocalRing R], (∀ (T : Type u) [CommRing T], IsRegularLocalRing T → IsDomain T) → (∀ (T : Type u) [CommRing T] [IsRegularLocalRing T] (r : ℕ) (x : Fin r → IsLocalRing.maximalIdeal T), LinearIndependent (IsLocalRing.ResidueField T) (fun i => (IsLocalRing.maximalIdeal T).toCotangent (x i)) → IsRegularLocalRing (T ⧸ Ideal.span (Set.range (fun i => (x i : T)))) ∧ ringKrullDim (T ⧸ Ideal.span (Set.range (fun i => (x i : T)))) + r = ringKrullDim T) → ∀ (I : Ideal R), IsRegularLocalRing (R ⧸ I) → ∀ x ∈ I, x ∈ IsLocalRing.maximalIdeal R ^ 2 → x ∈ IsLocalRing.maximalIdeal R * I :=
by
  intro R _ _ HD H I hI x₀ hx₀I hx₀2
  classical
  haveI := hI

  have sD : ∀ (r : ℕ) (x : Fin r → IsLocalRing.maximalIdeal R),
      LinearIndependent (IsLocalRing.ResidueField R)
        (fun i => (IsLocalRing.maximalIdeal R).toCotangent (x i)) →
      ∀ z ∈ Ideal.span (Set.range (fun i => (x i : R))), z ∈ IsLocalRing.maximalIdeal R ^ 2 →
      z ∈ IsLocalRing.maximalIdeal R * Ideal.span (Set.range (fun i => (x i : R))) := by
    intro r x hlin z hz hz2
    obtain ⟨a, rfl⟩ := (Ideal.mem_span_range_iff_exists_fun).mp hz
    have h0 : (IsLocalRing.maximalIdeal R).toCotangent (∑ i, a i • x i) = 0 := by
      rw [Ideal.toCotangent_eq_zero]
      simpa [Submodule.coe_sum, smul_eq_mul] using hz2
    rw [map_sum] at h0
    have h1 : ∑ i, (IsLocalRing.residue R (a i)) •
        (IsLocalRing.maximalIdeal R).toCotangent (x i) = 0 := by
      rw [← h0]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [map_smul, ← IsLocalRing.ResidueField.algebraMap_eq, algebraMap_smul]
    have h2 := Fintype.linearIndependent_iff.mp hlin _ h1
    refine Ideal.sum_mem _ (fun i _ => Ideal.mul_mem_mul ?_ (Submodule.subset_span ⟨i, rfl⟩))
    exact (IsLocalRing.residue_eq_zero_iff _).mp (h2 i)

  have sC : ∀ (J : Ideal R), J ≤ I → IsDomain (R ⧸ J) → ∀ y ∈ I, y ∉ J →
      ringKrullDim (R ⧸ I) + 1 ≤ ringKrullDim (R ⧸ J) := by
    intro J hJI hd y hy hyJ
    set yb := Ideal.Quotient.mk J y with hyb
    have hne : yb ≠ 0 := by rwa [Ne, hyb, Ideal.Quotient.eq_zero_iff_mem]
    have hnz : yb ∈ nonZeroDivisors (R ⧸ J) := mem_nonZeroDivisors_of_ne_zero hne
    have h1 := ringKrullDim_quotient_succ_le_of_nonZeroDivisor hnz
    have hφ : ∀ a ∈ Ideal.span {yb}, Ideal.Quotient.factor hJI a = 0 := by
      intro a ha
      obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp ha
      rw [map_mul, hyb, Ideal.Quotient.factor_mk, Ideal.Quotient.eq_zero_iff_mem.mpr hy, mul_zero]
    have hψ : Function.Surjective
        (Ideal.Quotient.lift (Ideal.span {yb}) (Ideal.Quotient.factor hJI) hφ) :=
      Ideal.Quotient.lift_surjective_of_surjective _ _ (Ideal.Quotient.factor_surjective hJI)
    have h2 := ringKrullDim_le_of_surjective _ hψ
    calc ringKrullDim (R ⧸ I) + 1 ≤ ringKrullDim ((R ⧸ J) ⧸ Ideal.span {yb}) + 1 :=
          add_le_add h2 le_rfl
      _ ≤ _ := h1

  have sA : I ≤ IsLocalRing.maximalIdeal R →
      ∃ (r : ℕ) (x : Fin r → IsLocalRing.maximalIdeal R), (∀ i, (x i : R) ∈ I) ∧
        LinearIndependent (IsLocalRing.ResidueField R)
          (fun i => (IsLocalRing.maximalIdeal R).toCotangent (x i)) ∧
        I ≤ Ideal.span (Set.range (fun i => (x i : R))) ⊔ IsLocalRing.maximalIdeal R ^ 2 := by
    intro hIm
    let S : Set (IsLocalRing.maximalIdeal R) := {y | (y : R) ∈ I}
    let t : Set (IsLocalRing.maximalIdeal R).Cotangent :=
      (IsLocalRing.maximalIdeal R).toCotangent '' S
    obtain ⟨b, hbt, hspan, hli⟩ := exists_linearIndependent (IsLocalRing.ResidueField R) t
    have hfin : b.Finite := hli.setFinite
    haveI : Fintype b := hfin.fintype
    let e := Fintype.equivFin b
    have hpre : ∀ v : b, ∃ y : IsLocalRing.maximalIdeal R, (y : R) ∈ I ∧
        (IsLocalRing.maximalIdeal R).toCotangent y = v := fun v => by
      obtain ⟨y, hy, hyv⟩ := hbt v.2
      exact ⟨y, hy, hyv⟩
    choose pre hpreI hpreV using hpre
    refine ⟨Fintype.card b, fun i => pre (e.symm i), fun i => hpreI _, ?_, ?_⟩
    · have : (fun i => (IsLocalRing.maximalIdeal R).toCotangent (pre (e.symm i))) =
          Subtype.val ∘ e.symm := by
        funext i; simp [hpreV]
      rw [this]
      exact hli.comp _ e.symm.injective
    · intro z hz
      have hzm : z ∈ IsLocalRing.maximalIdeal R := hIm hz
      have hmem : (IsLocalRing.maximalIdeal R).toCotangent ⟨z, hzm⟩ ∈
          Submodule.span (IsLocalRing.ResidueField R)
            (Set.range (fun i => (IsLocalRing.maximalIdeal R).toCotangent (pre (e.symm i)))) := by
        have h1 : (IsLocalRing.maximalIdeal R).toCotangent ⟨z, hzm⟩ ∈
            Submodule.span (IsLocalRing.ResidueField R) t :=
          Submodule.subset_span ⟨⟨z, hzm⟩, hz, rfl⟩
        rw [← hspan] at h1
        refine Submodule.span_mono ?_ h1
        intro v hv
        exact ⟨e ⟨v, hv⟩, by simp [hpreV]⟩
      obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun _).mp hmem
      choose a ha using fun i => IsLocalRing.residue_surjective (c i)
      have h0 : (IsLocalRing.maximalIdeal R).toCotangent
          (⟨z, hzm⟩ - ∑ i, a i • pre (e.symm i)) = 0 := by
        rw [map_sub, map_sum, ← hc, sub_eq_zero]
        refine Finset.sum_congr rfl (fun i _ => ?_)
        rw [map_smul, ← ha i, ← IsLocalRing.ResidueField.algebraMap_eq, algebraMap_smul]
      rw [Ideal.toCotangent_eq_zero] at h0
      rw [Submodule.mem_sup]
      refine ⟨∑ i, a i * (pre (e.symm i) : R),
        Ideal.sum_mem _ (fun i _ => Ideal.mul_mem_left _ _ (Submodule.subset_span ⟨i, rfl⟩)),
        _, h0, ?_⟩
      simp [smul_eq_mul]

  have sB : ∀ (r : ℕ) (x : Fin r → R), (∀ i, x i ∈ IsLocalRing.maximalIdeal R) →
      I ≤ Ideal.span (Set.range x) ⊔ IsLocalRing.maximalIdeal R ^ 2 →
      Submodule.spanFinrank (IsLocalRing.maximalIdeal R) ≤
        Submodule.spanFinrank (IsLocalRing.maximalIdeal (R ⧸ I)) + r := by
    intro r x hx hcov
    have hfg : Submodule.FG (IsLocalRing.maximalIdeal (R ⧸ I)) := IsNoetherian.noetherian _
    obtain ⟨s, hs_card, hs_span⟩ := Submodule.FG.exists_span_set_encard_eq_spanFinrank hfg
    have hsfin : s.Finite := Set.finite_of_encard_eq_coe hs_card
    have hsn : s.ncard = Submodule.spanFinrank (IsLocalRing.maximalIdeal (R ⧸ I)) := by
      have := hsfin.cast_ncard_eq
      rw [hs_card] at this
      exact_mod_cast this
    have hsurj : Function.Surjective (Ideal.Quotient.mk I) := Ideal.Quotient.mk_surjective
    let σ := Function.surjInv hsurj
    have hσ : ∀ y, Ideal.Quotient.mk I (σ y) = y := Function.surjInv_eq hsurj
    let s' := σ '' s
    have hs'fin : s'.Finite := hsfin.image σ
    have hπs' : Ideal.Quotient.mk I '' s' = s := by
      rw [Set.image_image]; simp [hσ]
    have hs'm : s' ⊆ IsLocalRing.maximalIdeal R := by
      rintro _ ⟨y, hy, rfl⟩
      by_contra hn
      have hu : IsUnit (σ y) := IsLocalRing.notMem_maximalIdeal.mp hn
      have hu' : IsUnit (Ideal.Quotient.mk I (σ y)) := hu.map _
      rw [hσ] at hu'
      have hy' : y ∈ IsLocalRing.maximalIdeal (R ⧸ I) := by
        rw [← hs_span]; exact Submodule.subset_span hy
      exact (IsLocalRing.mem_maximalIdeal _).mp hy' hu'
    have hTfin : (s' ∪ Set.range x).Finite := hs'fin.union (Set.finite_range x)
    have hTm : Submodule.span R (s' ∪ Set.range x) ≤ IsLocalRing.maximalIdeal R := by
      rw [Submodule.span_le, Set.union_subset_iff]
      exact ⟨hs'm, by rintro _ ⟨i, rfl⟩; exact hx i⟩
    have hsup : IsLocalRing.maximalIdeal R ≤ Submodule.span R (s' ∪ Set.range x) ⊔
        IsLocalRing.maximalIdeal R • IsLocalRing.maximalIdeal R := by
      intro z hz
      have h1 : Ideal.Quotient.mk I z ∈ IsLocalRing.maximalIdeal (R ⧸ I) := by
        rw [← IsLocalRing.map_maximalIdeal_of_surjective (Ideal.Quotient.mk I) hsurj]
        exact Ideal.mem_map_of_mem _ hz
      have h1' : Ideal.Quotient.mk I z ∈ Ideal.map (Ideal.Quotient.mk I) (Ideal.span s') := by
        rw [Ideal.map_span, hπs']
        rw [← hs_span] at h1
        exact h1
      have h2 : z ∈ Ideal.comap (Ideal.Quotient.mk I)
          (Ideal.map (Ideal.Quotient.mk I) (Ideal.span s')) := h1'
      rw [Ideal.comap_map_of_surjective' _ hsurj, Ideal.mk_ker] at h2
      obtain ⟨u, hu, w, hw, rfl⟩ := Submodule.mem_sup.mp h2
      obtain ⟨w1, hw1, w2, hw2, rfl⟩ := Submodule.mem_sup.mp (hcov hw)
      rw [Submodule.mem_sup]
      refine ⟨u + w1, ?_, w2, ?_, by ring⟩
      · rw [Submodule.span_union]
        exact Submodule.add_mem_sup hu hw1
      · rw [Ideal.smul_eq_mul, ← pow_two]; exact hw2
    have hle : IsLocalRing.maximalIdeal R ≤ Submodule.span R (s' ∪ Set.range x) :=
      Submodule.le_of_le_smul_of_le_jacobson_bot (IsNoetherian.noetherian _)
        (IsLocalRing.maximalIdeal_le_jacobson _) hsup
    have heq : Submodule.span R (s' ∪ Set.range x) = IsLocalRing.maximalIdeal R :=
      le_antisymm hTm hle
    have hA : s'.ncard ≤ s.ncard := Set.ncard_image_le hsfin
    have hB : (Set.range x).ncard ≤ r := by
      rw [← Set.image_univ]
      refine (Set.ncard_image_le Set.finite_univ).trans ?_
      rw [Set.ncard_univ, Nat.card_fin]
    have hC := Submodule.spanFinrank_span_le_ncard_of_finite (R := R) hTfin
    have hD := Set.ncard_union_le s' (Set.range x)
    rw [heq] at hC
    omega

  have hR : ((Submodule.spanFinrank (IsLocalRing.maximalIdeal R) : ℕ) : WithBot ℕ∞) =
      ringKrullDim R := IsRegularLocalRing.spanFinrank_maximalIdeal
  have hIdim : ((Submodule.spanFinrank (IsLocalRing.maximalIdeal (R ⧸ I)) : ℕ) : WithBot ℕ∞) =
      ringKrullDim (R ⧸ I) := IsRegularLocalRing.spanFinrank_maximalIdeal
  have hIne : I ≠ ⊤ := Ideal.Quotient.nontrivial_iff.mp inferInstance
  have hIm : I ≤ IsLocalRing.maximalIdeal R := IsLocalRing.le_maximalIdeal hIne
  obtain ⟨r, x, hxI, hlin, hcov⟩ := sA hIm
  have hJI : Ideal.span (Set.range (fun i => (x i : R))) ≤ I := by
    rw [Ideal.span_le]; rintro _ ⟨i, rfl⟩; exact hxI i
  obtain ⟨hJreg, hJdim⟩ := H R r x hlin
  have hdom : IsDomain (R ⧸ Ideal.span (Set.range (fun i => (x i : R)))) := HD _ hJreg
  have hB := sB r (fun i => (x i : R)) (fun i => (x i).2) hcov
  have hIJ : I ≤ Ideal.span (Set.range (fun i => (x i : R))) := by
    intro y hy
    by_contra hyJ
    have h1 := sC _ hJI hdom y hy hyJ
    have h2 : ringKrullDim (R ⧸ I) + 1 + (r : WithBot ℕ∞) ≤ ringKrullDim R := by
      rw [← hJdim]; exact add_le_add h1 le_rfl
    rw [← hR, ← hIdim] at h2
    have h3 : ((Submodule.spanFinrank (IsLocalRing.maximalIdeal (R ⧸ I)) + 1 + r : ℕ) :
        WithBot ℕ∞) ≤ ((Submodule.spanFinrank (IsLocalRing.maximalIdeal R) : ℕ) : WithBot ℕ∞) := by
      push_cast; exact h2
    have h4 := (Nat.cast_le (α := WithBot ℕ∞)).mp h3
    omega
  exact Ideal.mul_mono_right hJI (sD r x hlin x₀ (hIJ hx₀I) hx₀2)

theorem wcpa_embdim_le_rank_omega : ∀ (k R : Type u) [Field k] [CommRing R] [IsLocalRing R] [IsNoetherianRing R] [Algebra k R], Algebra.FormallySmooth k R → Module.Free R Ω[R⁄k] → Module.Finite R Ω[R⁄k] → Algebra.FormallySmooth k (IsLocalRing.ResidueField R) → Submodule.spanFinrank (IsLocalRing.maximalIdeal R) ≤ Module.finrank R Ω[R⁄k] :=
by
  intro k R _ _ _ _ _ hR hfree hfin hκ
  haveI := hR
  haveI := hfree
  haveI := hfin
  have hsurj : Function.Surjective (algebraMap R (IsLocalRing.ResidueField R)) :=
    IsLocalRing.residue_surjective
  obtain ⟨l, hl⟩ := (Algebra.FormallySmooth.iff_split_injection hsurj).mp hκ
  have hc : Function.Injective
      (KaehlerDifferential.kerCotangentToTensor k R (IsLocalRing.ResidueField R)) := by
    intro a b h
    have ha := LinearMap.congr_fun hl a
    have hb := LinearMap.congr_fun hl b
    simp only [LinearMap.comp_apply, LinearMap.id_apply] at ha hb
    rw [← ha, ← hb, h]
  have hK : RingHom.ker (algebraMap R (IsLocalRing.ResidueField R)) =
      IsLocalRing.maximalIdeal R := IsLocalRing.ker_residue
  have hle : IsLocalRing.maximalIdeal R ≤ Ideal.comap (AlgHom.id R R)
      (RingHom.ker (algebraMap R (IsLocalRing.ResidueField R))) := by
    intro x hx
    rw [Ideal.mem_comap, AlgHom.id_apply, hK]
    exact hx
  let ι := Ideal.mapCotangent (IsLocalRing.maximalIdeal R)
    (RingHom.ker (algebraMap R (IsLocalRing.ResidueField R))) (AlgHom.id R R) hle
  have hι : Function.Injective ι := by
    rw [injective_iff_map_eq_zero]
    intro z hz
    obtain ⟨x, rfl⟩ := Ideal.toCotangent_surjective _ z
    rw [Ideal.mapCotangent_toCotangent, Ideal.toCotangent_eq_zero] at hz
    rw [Ideal.toCotangent_eq_zero]
    have hz' : (x : R) ∈ RingHom.ker (algebraMap R (IsLocalRing.ResidueField R)) ^ 2 := hz
    rw [hK] at hz'
    exact hz'
  let f : IsLocalRing.CotangentSpace R →ₗ[R]
      TensorProduct R (IsLocalRing.ResidueField R) Ω[R⁄k] :=
    (KaehlerDifferential.kerCotangentToTensor k R (IsLocalRing.ResidueField R)).comp ι
  have hf : Function.Injective f := hc.comp hι
  let fκ := LinearMap.extendScalarsOfSurjective hsurj f
  have hfκ : Function.Injective fκ := by
    intro a b h
    apply hf
    simpa [fκ, LinearMap.extendScalarsOfSurjective_apply] using h
  have h8 := LinearMap.finrank_le_finrank_of_injective hfκ
  have h9 : Module.finrank (IsLocalRing.ResidueField R)
      (TensorProduct R (IsLocalRing.ResidueField R) Ω[R⁄k]) = Module.finrank R Ω[R⁄k] :=
    Module.finrank_baseChange
  rw [IsLocalRing.spanFinrank_maximalIdeal_eq_finrank_cotangentSpace R, ← h9]
  exact h8

theorem wcpa_mvpoly_maximal_height : ∀ (k : Type u) [Field k] (N : ℕ) (n : Ideal (MvPolynomial (Fin N) k)), n.IsMaximal → (N : ℕ∞) ≤ n.height :=
by
  intro k _ N
  induction N with
  | zero => intro n _; simp
  | succ N ih =>
    intro n hn
    let e : MvPolynomial (Fin (N + 1)) k ≃+* Polynomial (MvPolynomial (Fin N) k) :=
      (MvPolynomial.finSuccEquiv k N).toRingEquiv
    let P : Ideal (Polynomial (MvPolynomial (Fin N) k)) := Ideal.map e n
    haveI hP : P.IsMaximal := Ideal.map_isMaximal_of_equiv e
    have hnP : n.height = P.height := by
      have h1 : Ideal.comap e P = n := Ideal.comap_map_of_bijective e e.bijective
      rw [← RingEquiv.height_comap e P, h1]
    let p : Ideal (MvPolynomial (Fin N) k) := Ideal.comap Polynomial.C P
    haveI hp : p.IsMaximal := Polynomial.isMaximal_comap_C_of_isJacobsonRing P
    haveI : P.LiesOver p := by
      constructor
      rw [Ideal.under_def, Polynomial.algebraMap_eq]
    have hPp : P.height = p.height + 1 := Polynomial.height_eq_height_add_one p P
    rw [hnP, hPp]
    have := ih p hp
    push_cast
    exact add_le_add this le_rfl

theorem wcpa_conormal_formallySmooth : ∀ (k R S : Type u) [Field k] [CommRing R] [CommRing S] [IsLocalRing R] [IsLocalRing S] [IsNoetherianRing R] [Algebra k R] [Algebra k S] (ψ : R →ₐ[k] S), Function.Surjective ψ → Algebra.FormallySmooth k R → Module.Free R Ω[R⁄k] → Module.Finite R Ω[R⁄k] → Algebra.FormallySmooth k (IsLocalRing.ResidueField R) → (∀ x ∈ RingHom.ker ψ, x ∈ IsLocalRing.maximalIdeal R ^ 2 → x ∈ IsLocalRing.maximalIdeal R * RingHom.ker ψ) → Algebra.FormallySmooth k S :=
by
  intro k R S _ _ _ _ _ _ _ _ ψ hψ hR hfree hfin hκR hcon
  haveI := hR
  haveI := hfree
  haveI := hfin

  haveI hloc : IsLocalHom ψ := by
    have h : IsLocalHom (ψ : R →+* S) := IsLocalHom.of_surjective _ hψ
    exact ⟨fun a ha => h.map_nonunit a ha⟩

  have hκS : Algebra.FormallySmooth k (IsLocalRing.ResidueField S) := by
    let φ : IsLocalRing.ResidueField R →ₐ[k] IsLocalRing.ResidueField S :=
      IsLocalRing.ResidueField.mapAlgHom ψ
    have hφ : ∀ r : R, φ (IsLocalRing.residue R r) = IsLocalRing.residue S (ψ r) := fun r => rfl
    have hinj : Function.Injective φ :=
      RingHom.injective (φ : IsLocalRing.ResidueField R →+* IsLocalRing.ResidueField S)
    have hsurj : Function.Surjective φ := by
      intro y
      obtain ⟨s, rfl⟩ := IsLocalRing.residue_surjective y
      obtain ⟨r, rfl⟩ := hψ s
      exact ⟨IsLocalRing.residue R r, hφ r⟩
    exact Algebra.FormallySmooth.of_equiv (AlgEquiv.ofBijective φ ⟨hinj, hsurj⟩)

  letI : Algebra R S := ψ.toRingHom.toAlgebra
  haveI : IsScalarTower k R S := IsScalarTower.of_algebraMap_eq (fun c => (ψ.commutes c).symm)
  have hsurj : Function.Surjective (algebraMap R S) := hψ
  rw [Algebra.FormallySmooth.iff_injective_cotangentComplexBaseChange_residueField R hsurj
    (IsNoetherian.noetherian _)]
  set κ := IsLocalRing.ResidueField S with hκdef
  have hamap : ∀ r : R, algebraMap R κ r = IsLocalRing.residue S (ψ r) := fun r => rfl
  have hκsurj : Function.Surjective (algebraMap R κ) := by
    intro y
    obtain ⟨s, rfl⟩ := IsLocalRing.residue_surjective y
    obtain ⟨r, rfl⟩ := hψ s
    exact ⟨r, hamap r⟩
  have hker𝔪 : ∀ x : R, algebraMap R κ x = 0 ↔ x ∈ IsLocalRing.maximalIdeal R := by
    intro x
    rw [hamap, IsLocalRing.residue_eq_zero_iff]
    constructor
    · intro h
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at h ⊢
      exact fun hu => h (hu.map ψ)
    · intro h
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at h ⊢
      exact fun hu => h (isUnit_of_map_unit ψ x hu)
  have hM : RingHom.ker (algebraMap R κ) = IsLocalRing.maximalIdeal R :=
    Ideal.ext (fun x => by rw [RingHom.mem_ker, hker𝔪])

  obtain ⟨l, hl⟩ := (Algebra.FormallySmooth.iff_split_injection (R := k) hκsurj).mp hκS
  have hinj : Function.Injective (KaehlerDifferential.kerCotangentToTensor k R κ) := by
    intro a b hab
    have ha := LinearMap.congr_fun hl a
    have hb := LinearMap.congr_fun hl b
    simp only [LinearMap.comp_apply, LinearMap.id_apply] at ha hb
    rw [← ha, ← hb, hab]

  have hall : ∀ z : TensorProduct R κ (RingHom.ker (algebraMap R S)),
      ∃ x : RingHom.ker (algebraMap R S), z = (1 : κ) ⊗ₜ[R] x := by
    intro z
    induction z using TensorProduct.induction_on with
    | zero => exact ⟨0, (TensorProduct.tmul_zero _ _).symm⟩
    | tmul a b =>
      obtain ⟨r, rfl⟩ := hκsurj a
      refine ⟨r • b, ?_⟩
      rw [Algebra.algebraMap_eq_smul_one, TensorProduct.smul_tmul]
    | add z₁ z₂ h₁ h₂ =>
      obtain ⟨x₁, rfl⟩ := h₁
      obtain ⟨x₂, rfl⟩ := h₂
      exact ⟨x₁ + x₂, (TensorProduct.tmul_add _ _ _).symm⟩

  have hle : IsLocalRing.maximalIdeal R * RingHom.ker (algebraMap R S) ≤
      RingHom.ker (algebraMap R S) :=
    Ideal.mul_le.mpr (fun a _ b hb => Ideal.mul_mem_left _ a hb)
  have key : ∀ (r : R) (hr : r ∈ IsLocalRing.maximalIdeal R * RingHom.ker (algebraMap R S)),
      (1 : κ) ⊗ₜ[R] (⟨r, hle hr⟩ : RingHom.ker (algebraMap R S)) = 0 := by
    intro r hr
    induction hr using Submodule.mul_induction_on' with
    | mem_mul_mem m hm n hn =>
      show (1 : κ) ⊗ₜ[R] (m • (⟨n, hn⟩ : RingHom.ker (algebraMap R S))) = 0
      rw [← TensorProduct.smul_tmul, Algebra.smul_def, mul_one, (hker𝔪 m).mpr hm,
        TensorProduct.zero_tmul]
    | add a ha b hb iha ihb =>
      show (1 : κ) ⊗ₜ[R] ((⟨a, hle ha⟩ : RingHom.ker (algebraMap R S)) + ⟨b, hle hb⟩) = 0
      rw [TensorProduct.tmul_add, iha, ihb, add_zero]

  rw [injective_iff_map_eq_zero]
  intro z hz
  obtain ⟨x, rfl⟩ := hall z
  rw [KaehlerDifferential.cotangentComplexBaseChange_tmul, one_smul,
    KaehlerDifferential.kerToTensor_apply] at hz
  have hxM : (x : R) ∈ RingHom.ker (algebraMap R κ) := by
    rw [RingHom.mem_ker, hamap]
    have : ψ (x : R) = 0 := RingHom.mem_ker.mp x.2
    rw [this, map_zero]
  have h2 := KaehlerDifferential.kerCotangentToTensor_toCotangent k R κ ⟨x, hxM⟩
  have h3 : (RingHom.ker (algebraMap R κ)).toCotangent ⟨x, hxM⟩ = 0 := by
    apply hinj
    rw [map_zero, h2]
    exact hz
  rw [Ideal.toCotangent_eq_zero] at h3
  have h4 : (x : R) ∈ IsLocalRing.maximalIdeal R ^ 2 := by
    rw [← hM]; exact h3
  have hxψ : (x : R) ∈ RingHom.ker ψ := RingHom.mem_ker.mpr (RingHom.mem_ker.mp x.2)
  have hmul := hcon x hxψ h4
  have hkerEq : RingHom.ker ψ = RingHom.ker (algebraMap R S) :=
    Ideal.ext (fun y => by rw [RingHom.mem_ker, RingHom.mem_ker]; rfl)
  rw [hkerEq] at hmul
  exact key (x : R) hmul

theorem wcpa_affine_local_smooth_data : ∀ (k : Type u) [Field k] [PerfectField k] (N : ℕ) (n : Ideal (MvPolynomial (Fin N) k)) [n.IsMaximal], Algebra.FormallySmooth k (Localization.AtPrime n) ∧ Module.Free (Localization.AtPrime n) Ω[Localization.AtPrime n⁄k] ∧ Module.Finite (Localization.AtPrime n) Ω[Localization.AtPrime n⁄k] ∧ Module.finrank (Localization.AtPrime n) Ω[Localization.AtPrime n⁄k] = N ∧ Algebra.FormallySmooth k (IsLocalRing.ResidueField (Localization.AtPrime n)) :=
by
  intro k _ _ N n _
  haveI hFS1 : Algebra.FormallySmooth (MvPolynomial (Fin N) k) (Localization.AtPrime n) :=
    Algebra.FormallySmooth.of_isLocalization n.primeCompl
  haveI hFS : Algebra.FormallySmooth k (Localization.AtPrime n) :=
    Algebra.FormallySmooth.comp k (MvPolynomial (Fin N) k) (Localization.AtPrime n)
  haveI := KaehlerDifferential.isLocalizedModule_map k (MvPolynomial (Fin N) k)
    (Localization.AtPrime n) n.primeCompl
  let b : Module.Basis (Fin N) (Localization.AtPrime n) Ω[Localization.AtPrime n⁄k] :=
    (KaehlerDifferential.mvPolynomialBasis k (Fin N)).ofIsLocalizedModule
      (Localization.AtPrime n) n.primeCompl
      (KaehlerDifferential.map k k (MvPolynomial (Fin N) k) (Localization.AtPrime n))
  refine ⟨hFS, Module.Free.of_basis b, Module.Finite.of_basis b, ?_, ?_⟩
  · rw [Module.finrank_eq_card_basis b, Fintype.card_fin]
  · haveI : IsScalarTower k (Localization.AtPrime n)
        (IsLocalRing.ResidueField (Localization.AtPrime n)) :=
      IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    haveI : Algebra.EssFiniteType (MvPolynomial (Fin N) k) (Localization.AtPrime n) :=
      Algebra.EssFiniteType.of_isLocalization (Localization.AtPrime n) n.primeCompl
    haveI : Algebra.EssFiniteType k (MvPolynomial (Fin N) k) :=
      Algebra.EssFiniteType.of_finiteType k (MvPolynomial (Fin N) k)
    haveI : Algebra.EssFiniteType k (Localization.AtPrime n) :=
      Algebra.EssFiniteType.comp k (MvPolynomial (Fin N) k) (Localization.AtPrime n)
    let f : Localization.AtPrime n →ₐ[k] IsLocalRing.ResidueField (Localization.AtPrime n) :=
      IsScalarTower.toAlgHom k (Localization.AtPrime n)
        (IsLocalRing.ResidueField (Localization.AtPrime n))
    have hf : Function.Surjective f := IsLocalRing.residue_surjective
    haveI : Algebra.EssFiniteType k (IsLocalRing.ResidueField (Localization.AtPrime n)) :=
      Algebra.EssFiniteType.of_surjective f hf
    exact Algebra.FormallySmooth.of_perfectField

theorem wcpa_scheme_local_standard_smooth : ∀ (F : Type u) [Field F] (Z : Scheme.{u}) (sZ : Z ⟶ Spec (.of F)) [LocallyOfFiniteType sZ], (∀ z : Z, IsRegularLocalRing (Z.presheaf.stalk z)) → (∀ (A : Type u) [CommRing A] [Algebra F A] [Algebra.FiniteType F A] (p : Ideal A) [p.IsPrime], (∀ (q : Ideal A) [q.IsPrime], IsRegularLocalRing (Localization.AtPrime q)) → ∃ f : A, f ∉ p ∧ ∃ n : ℕ, Algebra.IsStandardSmoothOfRelativeDimension n F (Localization.Away f)) → ∀ z : Z, ∃ (V : Z.Opens) (_ : IsAffineOpen V) (_ : z ∈ V) (e : V ≤ sZ ⁻¹ᵁ ⊤) (n : ℕ), RingHom.IsStandardSmoothOfRelativeDimension n (sZ.appLE ⊤ V e).hom :=
by
  intro F _ Z sZ _ hreg H15 z
  obtain ⟨W, hW, hz, -⟩ := exists_isAffineOpen_mem_and_subset (TopologicalSpace.Opens.mem_top z)
  have eW : W ≤ sZ ⁻¹ᵁ ⊤ := by rw [Scheme.Hom.preimage_top]; exact le_top
  let ι := Scheme.ΓSpecIso (CommRingCat.of F)
  have hιx : ∀ x, ι.inv.hom (ι.hom.hom x) = x := by
    intro x
    show (ι.hom ≫ ι.inv).hom x = x
    rw [Iso.hom_inv_id]; rfl
  let φ : F →+* Γ(Z, W) := (sZ.appLE ⊤ W eW).hom.comp ι.inv.hom
  have hft : RingHom.FiniteType φ := by
    have h1 : RingHom.FiniteType (sZ.appLE ⊤ W eW).hom :=
      HasRingHomProperty.appLE @LocallyOfFiniteType sZ inferInstance ⟨⊤, isAffineOpen_top _⟩ ⟨W, hW⟩ eW
    have h2 : RingHom.FiniteType ι.inv.hom := by
      apply RingHom.FiniteType.of_surjective
      intro y
      exact ⟨ι.hom.hom y, hιx y⟩
    exact h1.comp h2
  have hq : ∀ (q : Ideal Γ(Z, W)) [q.IsPrime], IsRegularLocalRing (Localization.AtPrime q) := by
    intro q hqp
    let y : PrimeSpectrum Γ(Z, W) := ⟨q, hqp⟩
    have hx : hW.fromSpec y ∈ W := by
      have h0 : hW.fromSpec y ∈ Set.range hW.fromSpec := ⟨y, rfl⟩
      rw [hW.range_fromSpec] at h0
      exact h0
    letI : Algebra Γ(Z, W) (Z.presheaf.stalk (hW.fromSpec y)) :=
      TopCat.Presheaf.algebra_section_stalk Z.presheaf ⟨hW.fromSpec y, hx⟩
    haveI : IsLocalization q.primeCompl (Z.presheaf.stalk (hW.fromSpec y)) :=
      hW.isLocalization_stalk' y hx
    haveI := hreg (hW.fromSpec y)
    exact IsRegularLocalRing.of_ringEquiv
      (IsLocalization.algEquiv q.primeCompl (Z.presheaf.stalk (hW.fromSpec y))
        (Localization.AtPrime q)).toRingEquiv
  letI : Algebra F Γ(Z, W) := φ.toAlgebra
  haveI : Algebra.FiniteType F Γ(Z, W) := hft
  obtain ⟨f, hf, n, hn⟩ := H15 Γ(Z, W) (hW.primeIdealOf ⟨z, hz⟩).asIdeal hq
  have hzf : z ∈ Z.basicOpen f := by
    have h1 : hW.primeIdealOf ⟨z, hz⟩ ∈ PrimeSpectrum.basicOpen f :=
      (PrimeSpectrum.mem_basicOpen _ _).mpr hf
    rw [← hW.fromSpec_preimage_basicOpen f] at h1
    have h2 : hW.fromSpec (hW.primeIdealOf ⟨z, hz⟩) ∈ Z.basicOpen f := h1
    rw [hW.fromSpec_primeIdealOf] at h2
    exact h2
  have e : Z.basicOpen f ≤ sZ ⁻¹ᵁ ⊤ := (Z.basicOpen_le f).trans eW
  refine ⟨Z.basicOpen f, hW.basicOpen f, hzf, e, n, ?_⟩
  have hP : RingHom.IsStandardSmoothOfRelativeDimension n
      ((algebraMap Γ(Z, W) (Localization.Away f)).comp φ) := by
    have := (RingHom.isStandardSmoothOfRelativeDimension_algebraMap n).mpr hn
    rwa [IsScalarTower.algebraMap_eq F Γ(Z, W) (Localization.Away f)] at this
  haveI := hW.isLocalization_basicOpen f
  let ε := IsLocalization.algEquiv (Submonoid.powers f) (Localization.Away f) Γ(Z, Z.basicOpen f)
  have hP2 := RingHom.isStandardSmoothOfRelativeDimension_respectsIso.1 _ ε.toRingEquiv hP
  have hP3 := RingHom.isStandardSmoothOfRelativeDimension_respectsIso.2 _
    ι.commRingCatIsoToRingEquiv hP2
  have key : sZ.appLE ⊤ (Z.basicOpen f) e =
      sZ.appLE ⊤ W eW ≫ Z.presheaf.map (homOfLE (Z.basicOpen_le f)).op := by
    rw [Scheme.Hom.appLE_map]
  convert hP3 using 1
  ext x
  rw [key]
  show Z.presheaf.map (homOfLE (Z.basicOpen_le f)).op (sZ.appLE ⊤ W eW x) =
    ε (algebraMap Γ(Z, W) (Localization.Away f) (φ (ι.hom.hom x)))
  rw [ε.commutes]
  show _ = Z.presheaf.map (homOfLE (Z.basicOpen_le f)).op ((sZ.appLE ⊤ W eW).hom (ι.inv.hom (ι.hom.hom x)))
  rw [hιx]

theorem wcpa_relative_dim_constant : ∀ (F : Type u) [Field F] (Z : Scheme.{u}) [AlgebraicGeometry.IsIntegral Z] (sZ : Z ⟶ Spec (.of F)), (∀ (R A K : Type u) [CommRing R] [CommRing A] [IsDomain A] [Field K] [Algebra R A] [Algebra A K] [Algebra R K] [IsScalarTower R A K] [IsFractionRing A K] (n : ℕ), Algebra.IsStandardSmoothOfRelativeDimension n R A → Module.finrank K Ω[K⁄R] = n) → ∀ (V₁ V₂ : Z.Opens), IsAffineOpen V₁ → IsAffineOpen V₂ → (V₁ : Set Z).Nonempty → (V₂ : Set Z).Nonempty → ∀ (e₁ : V₁ ≤ sZ ⁻¹ᵁ ⊤) (e₂ : V₂ ≤ sZ ⁻¹ᵁ ⊤) (n₁ n₂ : ℕ), RingHom.IsStandardSmoothOfRelativeDimension n₁ (sZ.appLE ⊤ V₁ e₁).hom → RingHom.IsStandardSmoothOfRelativeDimension n₂ (sZ.appLE ⊤ V₂ e₂).hom → n₁ = n₂ :=
by
  intro F _ Z _ sZ H V₁ V₂ hA₁ hA₂ hne₁ hne₂ e₁ e₂ n₁ n₂ h₁ h₂
  haveI : Nonempty V₁ := hne₁.to_subtype
  haveI : Nonempty V₂ := hne₂.to_subtype
  have hη : genericPoint Z ∈ sZ ⁻¹ᵁ ⊤ := by simp
  let G : Γ(Spec (.of F), ⊤) ⟶ Z.functionField :=
    sZ.app ⊤ ≫ Z.presheaf.germ (sZ ⁻¹ᵁ ⊤) (genericPoint Z) hη
  have key : ∀ (V : Z.Opens) [Nonempty V] (e : V ≤ sZ ⁻¹ᵁ ⊤),
      sZ.appLE ⊤ V e ≫ Z.germToFunctionField V = G := by
    intro V _ e
    simp only [G, Scheme.Hom.appLE, Scheme.germToFunctionField, Category.assoc,
      TopCat.Presheaf.germ_res]
  letI algRK : Algebra Γ(Spec (.of F), ⊤) Z.functionField := G.hom.toAlgebra
  have step : ∀ (V : Z.Opens) [Nonempty V], IsAffineOpen V → ∀ (e : V ≤ sZ ⁻¹ᵁ ⊤) (n : ℕ),
      RingHom.IsStandardSmoothOfRelativeDimension n (sZ.appLE ⊤ V e).hom →
      Module.finrank Z.functionField Ω[Z.functionField⁄Γ(Spec (.of F), ⊤)] = n := by
    intro V _ hV e n hn
    letI algRA : Algebra Γ(Spec (.of F), ⊤) Γ(Z, V) := (sZ.appLE ⊤ V e).hom.toAlgebra
    haveI : IsDomain Γ(Z, V) := IsIntegral.component_integral V
    haveI : IsFractionRing Γ(Z, V) Z.functionField :=
      functionField_isFractionRing_of_isAffineOpen Z V hV
    haveI : IsScalarTower Γ(Spec (.of F), ⊤) Γ(Z, V) Z.functionField := by
      apply IsScalarTower.of_algebraMap_eq'
      show G.hom = (Z.germToFunctionField V).hom.comp (sZ.appLE ⊤ V e).hom
      rw [← CommRingCat.hom_comp, key V e]
    exact H _ _ _ n hn
  exact (step V₁ hA₁ e₁ n₁ h₁).symm.trans (step V₂ hA₂ e₂ n₂ h₂)

theorem wcpa_regular_smooth : ∀ (F : Type u) [Field F] [PerfectField F] (Z : Scheme.{u})
    [AlgebraicGeometry.IsIntegral Z] (sZ : Z ⟶ Spec (.of F)) [LocallyOfFiniteType sZ],
    (∀ z : Z, IsRegularLocalRing (Z.presheaf.stalk z)) → ∃ e : ℕ, SmoothOfRelativeDimension e sZ :=
by
  intro F _ _ Z _ sZ _ hreg

  have s13 : ∀ (R A K : Type u) [CommRing R] [CommRing A] [IsDomain A] [Field K] [Algebra R A]
      [Algebra A K] [Algebra R K] [IsScalarTower R A K] [IsFractionRing A K] (n : ℕ),
      Algebra.IsStandardSmoothOfRelativeDimension n R A → Module.finrank K Ω[K⁄R] = n := by
    intro R A K _ _ _ _ _ _ _ _ _ n hn
    haveI := hn
    haveI := Algebra.IsStandardSmoothOfRelativeDimension.isStandardSmooth n (R := R) (S := A)
    have hr := Algebra.IsStandardSmoothOfRelativeDimension.rank_kaehlerDifferential
      (R := R) (S := A) n
    have hf : Module.finrank A Ω[A⁄R] = n := Module.finrank_eq_of_rank_eq hr
    let b := Module.finBasisOfFinrankEq A Ω[A⁄R] hf
    haveI : IsLocalizedModule (nonZeroDivisors A) (KaehlerDifferential.map R R A K) :=
      KaehlerDifferential.isLocalizedModule_map R A K (nonZeroDivisors A)
    let b' := b.ofIsLocalizedModule K (nonZeroDivisors A) (KaehlerDifferential.map R R A K)
    rw [Module.finrank_eq_card_basis b', Fintype.card_fin]

  have H9 : ∀ (A : Type u) [CommRing A] [Algebra F A] [Algebra.FiniteType F A] (m : Ideal A)
      [m.IsMaximal], ∃ (N : ℕ) (n : Ideal (MvPolynomial (Fin N) F)) (_ : n.IsMaximal)
      (ψ : Localization.AtPrime n →ₐ[F] Localization.AtPrime m), Function.Surjective ψ := by
    intro A _ _ hA m _
    obtain ⟨N, π, hπ⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp hA
    set πr : MvPolynomial (Fin N) F →+* A := π.toRingHom with hπr
    have hπr' : Function.Surjective πr := hπ
    haveI hn : (Ideal.comap πr m).IsMaximal := Ideal.comap_isMaximal_of_surjective πr hπr'
    have hto : ∀ x, Localization.localRingHom (Ideal.comap πr m) m πr rfl
        (algebraMap _ (Localization.AtPrime (Ideal.comap πr m)) x) =
        algebraMap A (Localization.AtPrime m) (πr x) :=
      fun x => Localization.localRingHom_to_map (Ideal.comap πr m) m πr rfl x
    have hmk : ∀ (x : MvPolynomial (Fin N) F) (y : (Ideal.comap πr m).primeCompl),
        Localization.localRingHom (Ideal.comap πr m) m πr rfl
          (IsLocalization.mk' (Localization.AtPrime (Ideal.comap πr m)) x y) =
        IsLocalization.mk' (Localization.AtPrime m) (πr x) ⟨πr y, y.2⟩ :=
      fun x y => Localization.localRingHom_mk' (Ideal.comap πr m) m πr rfl x y
    let ψ : Localization.AtPrime (Ideal.comap πr m) →ₐ[F] Localization.AtPrime m :=
      { Localization.localRingHom (Ideal.comap πr m) m πr rfl with
        commutes' := fun r => by
          show Localization.localRingHom (Ideal.comap πr m) m πr rfl (algebraMap F _ r) = _
          rw [IsScalarTower.algebraMap_apply F (MvPolynomial (Fin N) F)
              (Localization.AtPrime (Ideal.comap πr m)), hto]
          have : πr (algebraMap F _ r) = algebraMap F A r := π.commutes r
          rw [this]
          exact (IsScalarTower.algebraMap_apply F A _ r).symm }
    refine ⟨N, Ideal.comap πr m, hn, ψ, ?_⟩
    intro y
    obtain ⟨⟨a, s⟩, rfl⟩ := IsLocalization.mk'_surjective m.primeCompl y
    obtain ⟨a', ha'⟩ := hπr' a
    obtain ⟨s', hs'⟩ := hπr' (s : A)
    have hs'n : s' ∈ (Ideal.comap πr m).primeCompl := by
      show s' ∉ Ideal.comap πr m
      rw [Ideal.mem_comap, hs']
      exact s.2
    refine ⟨IsLocalization.mk' _ a' ⟨s', hs'n⟩, ?_⟩
    show Localization.localRingHom (Ideal.comap πr m) m πr rfl _ =
      IsLocalization.mk' (Localization.AtPrime m) a s
    rw [hmk, ha']
    congr 1
    ext
    exact hs'

  have hD : ∀ (T : Type u) [CommRing T], IsRegularLocalRing T → IsDomain T :=
    fun T _ hT => wcpa_regular_isDomain T wcpa_rs_quotient_regular hT
  have H10 : ∀ (A : Type u) [CommRing A] [Algebra F A] [Algebra.FiniteType F A] (m : Ideal A)
      [m.IsMaximal], IsRegularLocalRing (Localization.AtPrime m) →
      Algebra.FormallySmooth F (Localization.AtPrime m) := by
    intro A _ _ _ m _ hregm
    obtain ⟨N, n, hn, ψ, hψ⟩ := H9 A m
    haveI := hn
    obtain ⟨h1, h2, h3, h4, h5⟩ := wcpa_affine_local_smooth_data F N n
    have hRreg : IsRegularLocalRing (Localization.AtPrime n) := by
      have hdim : ringKrullDim (Localization.AtPrime n) = (n.height : WithBot ℕ∞) :=
        IsLocalization.AtPrime.ringKrullDim_eq_height n _
      have hN := wcpa_mvpoly_maximal_height F N n hn
      have he := wcpa_embdim_le_rank_omega F (Localization.AtPrime n) h1 h2 h3 h5
      rw [h4] at he
      have hle := ringKrullDim_le_spanFinrank_maximalIdeal (Localization.AtPrime n)
      refine IsRegularLocalRing.mk (le_antisymm ?_ hle)
      calc ((Submodule.spanFinrank (IsLocalRing.maximalIdeal (Localization.AtPrime n)) : ℕ)
            : WithBot ℕ∞) ≤ (((N : ℕ∞)) : WithBot ℕ∞) := by exact_mod_cast he
        _ ≤ (n.height : WithBot ℕ∞) := by exact_mod_cast hN
        _ = ringKrullDim (Localization.AtPrime n) := hdim.symm
    have hq : IsRegularLocalRing (Localization.AtPrime n ⧸ RingHom.ker ψ) :=
      IsRegularLocalRing.of_ringEquiv (Ideal.quotientKerAlgEquivOfSurjective hψ).toRingEquiv.symm
    have hcon := wcpa_regular_quotient_conormal (Localization.AtPrime n) hD
      wcpa_rs_quotient_regular (RingHom.ker ψ) hq
    exact wcpa_conormal_formallySmooth F (Localization.AtPrime n) (Localization.AtPrime m) ψ hψ
      h1 h2 h3 h5 hcon

  have H15 : ∀ (A : Type u) [CommRing A] [Algebra F A] [Algebra.FiniteType F A] (p : Ideal A)
      [p.IsPrime], (∀ (q : Ideal A) [q.IsPrime], IsRegularLocalRing (Localization.AtPrime q)) →
      ∃ f : A, f ∉ p ∧ ∃ n : ℕ,
        Algebra.IsStandardSmoothOfRelativeDimension n F (Localization.Away f) := by
    intro A _ _ hA p hp hq
    obtain ⟨m, hm, hpm⟩ := Ideal.exists_le_maximal p hp.ne_top
    haveI := hm
    haveI : Algebra.FinitePresentation F A := Algebra.FinitePresentation.of_finiteType.mp hA
    haveI : Algebra.IsSmoothAt F m := H10 A m (hq m)
    obtain ⟨g, hg, hsm⟩ := Algebra.IsSmoothAt.exists_notMem_isStandardSmooth F m
    obtain ⟨ι, σ, hσ, hι, ⟨P⟩⟩ := hsm.out
    exact ⟨g, fun h => hg (hpm h), P.dimension, ⟨ι, σ, hσ, hι, P, rfl⟩⟩

  have hloc := wcpa_scheme_local_standard_smooth F Z sZ hreg H15
  obtain ⟨z₀⟩ := (IsIntegral.nonempty : Nonempty Z)
  obtain ⟨V₀, hV₀, hz₀, e₀, n₀, h₀⟩ := hloc z₀
  refine ⟨n₀, ⟨fun x => ?_⟩⟩
  obtain ⟨V, hV, hx, ex, nx, hxs⟩ := hloc x
  have hn : nx = n₀ := wcpa_relative_dim_constant F Z sZ s13 V V₀ hV hV₀ ⟨x, hx⟩ ⟨z₀, hz₀⟩
    ex e₀ nx n₀ hxs h₀
  subst hn
  exact ⟨⊤, isAffineOpen_top _, V, hV, hx, ex, hxs⟩

theorem wcfd_tn_perfect_normal_dim_le_one_smooth : ∀ (L N : Type u) [Field L] [PerfectField L] [CommRing N] [Algebra L N] [Algebra.FiniteType L N], (∀ (P : Ideal N) [P.IsPrime], IsDomain (Localization.AtPrime P) ∧ IsIntegrallyClosed (Localization.AtPrime P)) → ringKrullDim N ≤ 1 → Algebra.FormallySmooth L N :=
by

  have s0 : ∀ (N : Type u) [CommRing N] (P : Ideal N), P ∈ minimalPrimes N → ∀ (Q : Ideal N) [Q.IsPrime],
      P ≤ Q → IsDomain (Localization.AtPrime Q) →
      P = RingHom.ker (algebraMap N (Localization.AtPrime Q)) := by
    intro N _ P hP Q _ hPQ hD
    haveI := hD
    have hK : (RingHom.ker (algebraMap N (Localization.AtPrime Q))).IsPrime := RingHom.ker_isPrime _
    have hPp : P.IsPrime := Ideal.minimalPrimes_isPrime hP
    have hKP : RingHom.ker (algebraMap N (Localization.AtPrime Q)) ≤ P := by
      intro x hx
      rw [RingHom.mem_ker, IsLocalization.map_eq_zero_iff Q.primeCompl] at hx
      obtain ⟨⟨s, hs⟩, hsx⟩ := hx
      have hmem : s * x ∈ P := by
        have : s * x = 0 := hsx
        rw [this]
        exact P.zero_mem
      rcases hPp.mem_or_mem hmem with h | h
      · exact absurd (hPQ h) hs
      · exact h
    have hmin : Minimal (fun q : Ideal N => q.IsPrime ∧ ⊥ ≤ q) P := hP
    exact (hmin.eq_of_le ⟨hK, bot_le⟩ hKP).symm

  have s2 : ∀ (N : Type u) [CommRing N] (P : Ideal N), P ∈ minimalPrimes N →
      ∀ (Q : Ideal (N ⧸ P)) [Q.IsPrime],
      IsDomain (Localization.AtPrime (Q.comap (Ideal.Quotient.mk P))) →
      Nonempty (Localization.AtPrime Q ≃+* Localization.AtPrime (Q.comap (Ideal.Quotient.mk P))) := by
    intro N _ P hP Q _ hD
    have hPQ : P ≤ Q.comap (Ideal.Quotient.mk P) := by
      intro p hp
      rw [Ideal.mem_comap, Ideal.Quotient.eq_zero_iff_mem.mpr hp]
      exact Q.zero_mem
    have hker := s0 N P hP (Q.comap (Ideal.Quotient.mk P)) hPQ hD
    obtain ⟨ψ₀, hψ₀⟩ : ∃ ψ₀ : N ⧸ P →+* Localization.AtPrime (Q.comap (Ideal.Quotient.mk P)),
        ∀ n, ψ₀ (Ideal.Quotient.mk P n) =
          algebraMap N (Localization.AtPrime (Q.comap (Ideal.Quotient.mk P))) n :=
      ⟨Ideal.Quotient.lift P (algebraMap N _) (fun a ha => by
          rw [hker] at ha
          exact (RingHom.mem_ker).mp ha),
        fun n => Ideal.Quotient.lift_mk _ _ _⟩
    have hunit : ∀ y : Q.primeCompl, IsUnit (ψ₀ y) := by
      rintro ⟨y, hy⟩
      obtain ⟨s, rfl⟩ := Ideal.Quotient.mk_surjective y
      show IsUnit (ψ₀ (Ideal.Quotient.mk P s))
      rw [hψ₀]
      exact IsLocalization.map_units (Localization.AtPrime (Q.comap (Ideal.Quotient.mk P)))
        (⟨s, hy⟩ : (Q.comap (Ideal.Quotient.mk P)).primeCompl)
    obtain ⟨ψ, hψ⟩ : ∃ ψ : Localization.AtPrime Q →+* Localization.AtPrime (Q.comap (Ideal.Quotient.mk P)),
        ∀ n, ψ (algebraMap (N ⧸ P) (Localization.AtPrime Q) n) = ψ₀ n :=
      ⟨IsLocalization.lift hunit, fun n => IsLocalization.lift_eq hunit n⟩
    obtain ⟨φ, hφ⟩ : ∃ φ : Localization.AtPrime (Q.comap (Ideal.Quotient.mk P)) →+* Localization.AtPrime Q,
        ∀ n, φ (algebraMap N _ n) = algebraMap (N ⧸ P) (Localization.AtPrime Q) (Ideal.Quotient.mk P n) :=
      ⟨Localization.localRingHom (Q.comap (Ideal.Quotient.mk P)) Q (Ideal.Quotient.mk P) rfl,
        fun n => Localization.localRingHom_to_map _ Q _ rfl n⟩
    refine ⟨RingEquiv.ofRingHom ψ φ ?_ ?_⟩
    · apply IsLocalization.ringHom_ext (Q.comap (Ideal.Quotient.mk P)).primeCompl
      ext n
      simp only [RingHom.comp_apply, RingHom.id_apply]
      rw [hφ, hψ, hψ₀]
    · apply IsLocalization.ringHom_ext Q.primeCompl
      apply Ideal.Quotient.ringHom_ext
      ext n
      simp only [RingHom.comp_apply, RingHom.id_apply]
      rw [hψ, hψ₀, hφ]

  have s3 : ∀ (R : Type u) [CommRing R] [IsLocalRing R] [IsNoetherianRing R] [IsDomain R]
      [IsIntegrallyClosed R], ringKrullDim R ≤ 1 → IsRegularLocalRing R := by
    intro R _ _ _ _ _ hR
    by_cases hF : IsField R
    · refine IsRegularLocalRing.mk ?_
      rw [IsLocalRing.isField_iff_maximalIdeal_eq.mp hF, Submodule.spanFinrank_bot,
        ringKrullDim_eq_zero_of_isField hF]
      rfl
    · have h46 := (IsDiscreteValuationRing.TFAE R hF).out 4 6
      have hm : IsLocalRing.maximalIdeal R ≠ ⊥ := fun h =>
        hF (IsLocalRing.isField_iff_maximalIdeal_eq.mpr h)
      haveI : Ring.KrullDimLE 1 R := Ring.krullDimLE_iff.mpr (by exact_mod_cast hR)
      have huniq : ∃! P : Ideal R, P ≠ ⊥ ∧ P.IsPrime := by
        refine ⟨IsLocalRing.maximalIdeal R, ⟨hm, inferInstance⟩, ?_⟩
        rintro P ⟨hP, hPp⟩
        haveI := hPp
        exact IsLocalRing.eq_maximalIdeal (Ideal.isMaximal_of_isPrime_of_ne_bot P hP)
      have hfr := h46.mp ⟨inferInstance, huniq⟩
      have key : ∀ (d : WithBot ℕ∞), d ≤ 1 → ¬ d ≤ 0 → d = 1 := by
        intro d h1 h0
        induction d using WithBot.recBotCoe with
        | bot => exact absurd bot_le h0
        | coe n =>
          induction n using ENat.recTopCoe with
          | top => exact absurd h1 (by decide)
          | coe k =>
            have h1' : k ≤ 1 := by exact_mod_cast h1
            have h0' : ¬ k ≤ 0 := fun h => h0 (by exact_mod_cast h)
            have : k = 1 := by omega
            subst this; rfl
      have hd1 : ringKrullDim R = 1 := by
        apply key _ hR
        intro h0
        haveI : Ring.KrullDimLE 0 R := Ring.krullDimLE_iff.mpr (by exact_mod_cast h0)
        exact hF Ring.KrullDimLE.isField_of_isDomain
      rw [IsRegularLocalRing.iff_finrank_cotangentSpace, hfr, hd1]
      rfl

  have s4 : ∀ (L D : Type u) [Field L] [PerfectField L] [CommRing D] [IsDomain D] [Algebra L D]
      [Algebra.FiniteType L D], (∀ (Q : Ideal D) [Q.IsPrime], IsRegularLocalRing (Localization.AtPrime Q)) →
      Algebra.FormallySmooth L D := by
    intro L D _ _ _ _ _ _ hreg
    haveI : LocallyOfFiniteType (Spec.map (CommRingCat.ofHom (algebraMap L D))) := by
      rw [HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType)]
      exact RingHom.finiteType_algebraMap.mpr inferInstance
    have hst : ∀ z : Spec (CommRingCat.of D),
        IsRegularLocalRing ((Spec (CommRingCat.of D)).presheaf.stalk z) := by
      intro z
      haveI : z.asIdeal.IsPrime := z.isPrime
      exact @IsRegularLocalRing.of_ringEquiv (Localization.AtPrime z.asIdeal) _ (hreg z.asIdeal) _ _
        (Spec.stalkIso (CommRingCat.of D) z).commRingCatIsoToRingEquiv.symm
    obtain ⟨e, he⟩ := wcpa_regular_smooth L (Spec (CommRingCat.of D))
      (Spec.map (CommRingCat.ofHom (algebraMap L D))) hst
    have hsm : Smooth (Spec.map (CommRingCat.ofHom (algebraMap L D))) :=
      @SmoothOfRelativeDimension.smooth e _ _ _ he
    rw [HasRingHomProperty.Spec_iff (P := @Smooth)] at hsm
    exact RingHom.formallySmooth_algebraMap.mp hsm.formallySmooth

  intro L N _ _ _ _ _ hLN hdim
  haveI : IsNoetherianRing N := Algebra.FiniteType.isNoetherianRing L N
  haveI hfinι : Finite {P : Ideal N // P ∈ minimalPrimes N} :=
    (minimalPrimes.finite_of_isNoetherianRing N).to_subtype
  have hdomQ : ∀ (Q : Ideal N) [Q.IsPrime], IsDomain (Localization.AtPrime Q) := fun Q _ => (hLN Q).1

  have hred : ∀ x : N, IsNilpotent x → x = 0 := by
    intro x hx
    apply eq_zero_of_localization
    intro J hJ
    haveI := hdomQ J
    exact (hx.map (algebraMap N (Localization.AtPrime J))).eq_zero
  have hinter : ∀ x : N, (∀ P : {P : Ideal N // P ∈ minimalPrimes N}, x ∈ P.1) → x = 0 := by
    intro x hx
    apply hred
    rw [← mem_nilradical, nilradical_eq_sInf, Ideal.mem_sInf]
    intro J hJ
    haveI : J.IsPrime := hJ
    obtain ⟨p, hp, hpJ⟩ := Ideal.exists_minimalPrimes_le (bot_le : (⊥ : Ideal N) ≤ J)
    exact hpJ (hx ⟨p, hp⟩)
  have hcop : Pairwise (Function.onFun IsCoprime
      (fun P : {P : Ideal N // P ∈ minimalPrimes N} => P.1)) := by
    intro P P' hne
    show IsCoprime P.1 P'.1
    rw [Ideal.isCoprime_iff_sup_eq]
    by_contra hsup
    obtain ⟨m, hm, hle⟩ := Ideal.exists_le_maximal _ hsup
    haveI := hm.isPrime
    have e1 := s0 N P.1 P.2 m (le_sup_left.trans hle) (hdomQ m)
    have e2 := s0 N P'.1 P'.2 m (le_sup_right.trans hle) (hdomQ m)
    exact hne (Subtype.ext (e1.trans e2.symm))
  let Φ : N →ₐ[L] ((P : {P : Ideal N // P ∈ minimalPrimes N}) → N ⧸ P.1) :=
    AlgHom.pi (fun P => Ideal.Quotient.mkₐ L P.1)
  have hΦ : ∀ x, Φ x = fun P : {P : Ideal N // P ∈ minimalPrimes N} => Ideal.Quotient.mk P.1 x :=
    fun x => rfl
  have hinj : Function.Injective Φ := by
    rw [injective_iff_map_eq_zero]
    intro x hx
    apply hinter
    intro P
    have h1 := congrFun hx P
    rw [hΦ] at h1
    exact Ideal.Quotient.eq_zero_iff_mem.mp h1
  have hsurj : Function.Surjective Φ := by
    intro y
    obtain ⟨z, hz⟩ := Ideal.quotientInfToPiQuotient_surj hcop y
    obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective z
    refine ⟨x, ?_⟩
    rw [← hz, Ideal.quotientInfToPiQuotient_mk, hΦ]
  have hfac : ∀ P : {P : Ideal N // P ∈ minimalPrimes N}, Algebra.FormallySmooth L (N ⧸ P.1) := by
    intro P
    haveI hPp : P.1.IsPrime := Ideal.minimalPrimes_isPrime P.2
    haveI : Algebra.FiniteType L (N ⧸ P.1) :=
      Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ L P.1) (Ideal.Quotient.mkₐ_surjective L P.1)
    have hreg : ∀ (Q : Ideal (N ⧸ P.1)) [Q.IsPrime], IsRegularLocalRing (Localization.AtPrime Q) := by
      intro Q _
      obtain ⟨hD, hIC⟩ := hLN (Q.comap (Ideal.Quotient.mk P.1))
      haveI := hD
      haveI := hIC
      have hdimA : ringKrullDim (Localization.AtPrime (Q.comap (Ideal.Quotient.mk P.1))) ≤ 1 := by
        rw [IsLocalization.AtPrime.ringKrullDim_eq_height (Q.comap (Ideal.Quotient.mk P.1))
          (Localization.AtPrime (Q.comap (Ideal.Quotient.mk P.1)))]
        exact (Ideal.height_le_ringKrullDim_of_ne_top (Ideal.IsPrime.ne_top inferInstance)).trans hdim
      have hA := s3 (Localization.AtPrime (Q.comap (Ideal.Quotient.mk P.1))) hdimA
      obtain ⟨ε⟩ := s2 N P.1 P.2 Q hD
      exact @IsRegularLocalRing.of_ringEquiv _ _ hA _ _ ε.symm
    exact s4 L (N ⧸ P.1) hreg
  haveI : Algebra.FormallySmooth L ((P : {P : Ideal N // P ∈ minimalPrimes N}) → N ⧸ P.1) :=
    (Algebra.FormallySmooth.pi_iff (fun P : {P : Ideal N // P ∈ minimalPrimes N} => N ⧸ P.1)).mpr hfac
  exact Algebra.FormallySmooth.of_equiv (AlgEquiv.ofBijective Φ ⟨hinj, hsurj⟩).symm

theorem wcfd_tn_twist_dim_le_one : ∀ (K : Type u) [Field K] [IsAlgClosed K] (A D : CommRingCat.{u}) [IsDomain A] (κ : CommRingCat.of K ⟶ A) (α : A ⟶ D), (letI := α.hom.toAlgebra; ringKrullDim (TensorProduct A D (AlgebraicClosure (FractionRing A))) ≤ 1) → ∀ (e : ℕ) (φ : A ⟶ A), (∀ a : A, φ.hom a = a ^ (ringExpChar K ^ e)) → ∀ (C : CommRingCat.{u}) (γ : D ⟶ C) (β : A ⟶ C), IsPushout α φ γ β → ∀ (C' : CommRingCat.{u}) (ρ : C ⟶ C'), Function.Surjective ρ.hom → ∀ (B : CommRingCat.{u}) (ι : C' ⟶ B), ι.hom.Finite → letI := (β ≫ ρ ≫ ι).hom.toAlgebra; letI : Algebra (FractionRing A) (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors A))) := localizationAlgebra (nonZeroDivisors A) B; ringKrullDim (TensorProduct (FractionRing A) (perfectClosure (FractionRing A) (AlgebraicClosure (FractionRing A))) (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors A)))) ≤ 1 :=
by

  have T1 : ∀ (R S : Type u) [CommRing R] [CommRing S] (f : R →+* S), f.IsIntegral →
      ringKrullDim S ≤ ringKrullDim R := by
    intro R S _ _ f hf
    letI := f.toAlgebra
    haveI : Algebra.IsIntegral R S := ⟨hf⟩
    refine Order.krullDim_le_of_strictMono (PrimeSpectrum.comap f) ?_
    intro P Q hPQ
    exact Ideal.IsIntegral.under_lt_under (R := R) (show P.asIdeal < Q.asIdeal from hPQ)

  have T2 : ∀ (R S : Type u) [CommRing R] [CommRing S] (f : R →+* S), Function.Injective f →
      f.IsIntegral → ringKrullDim R ≤ ringKrullDim S := by
    intro R S _ _ f hinj hf
    letI := f.toAlgebra
    haveI : Algebra.IsIntegral R S := ⟨hf⟩
    have key : ∀ (n : ℕ) (p : LTSeries (PrimeSpectrum R)), p.length = n →
        ∃ q : LTSeries (PrimeSpectrum S), q.length = n ∧
          q.last.asIdeal.comap f = p.last.asIdeal := by
      intro n
      induction n with
      | zero =>
        intro p _
        obtain ⟨Q, -, hQ, hQu⟩ := Ideal.exists_ideal_over_prime_of_isIntegral p.last.asIdeal
          (⊥ : Ideal S) (by
            intro x hx
            have hx' : f x = 0 := hx
            rw [show x = 0 from hinj (by rw [hx', map_zero])]
            exact zero_mem _)
        exact ⟨RelSeries.singleton _ ⟨Q, hQ⟩, rfl, hQu⟩
      | succ n ih =>
        intro p hp
        obtain ⟨q, hq, hql⟩ := ih p.eraseLast (by rw [RelSeries.eraseLast_length, hp]; rfl)
        have hlt : p.eraseLast.last < p.last := p.eraseLast_last_rel_last (by omega)
        obtain ⟨Q, hQge, hQ, hQu⟩ := Ideal.exists_ideal_over_prime_of_isIntegral p.last.asIdeal
          q.last.asIdeal (by
            show q.last.asIdeal.comap f ≤ _
            rw [hql]; exact hlt.le)
        have hlt2 : q.last < ⟨Q, hQ⟩ := by
          refine lt_of_le_of_ne hQge ?_
          intro heq
          have h3 : q.last.asIdeal.comap f = p.last.asIdeal := by rw [heq]; exact hQu
          rw [hql] at h3
          exact hlt.ne (PrimeSpectrum.ext h3)
        refine ⟨q.snoc ⟨Q, hQ⟩ hlt2, by simp [hq], ?_⟩
        rw [RelSeries.last_snoc]; exact hQu
    show (⨆ (p : LTSeries (PrimeSpectrum R)), (p.length : WithBot ℕ∞)) ≤
      Order.krullDim (PrimeSpectrum S)
    refine iSup_le fun p => ?_
    obtain ⟨q, hq, -⟩ := key p.length p rfl
    rw [← hq]; exact Order.LTSeries.length_le_krullDim q

  have T3 : ∀ (A D E C : CommRingCat.{u}) (α : A ⟶ D) (φ : A ⟶ E) (γ : D ⟶ C) (β : E ⟶ C),
      IsPushout α φ γ β → ∀ c : C, c ∈ Subring.closure (Set.range γ.hom ∪ Set.range β.hom) := by
    intro A D E C α φ γ β hpush
    let S := Subring.closure (Set.range γ.hom ∪ Set.range β.hom)
    let γ' : D ⟶ CommRingCat.of S := CommRingCat.ofHom
      (γ.hom.codRestrict S (fun d => Subring.subset_closure (Or.inl ⟨d, rfl⟩)))
    let β' : E ⟶ CommRingCat.of S := CommRingCat.ofHom
      (β.hom.codRestrict S (fun a => Subring.subset_closure (Or.inr ⟨a, rfl⟩)))
    have w : α ≫ γ' = φ ≫ β' := by
      ext a
      exact congrArg (fun g => g.hom a) hpush.toCommSq.w
    let incl : CommRingCat.of S ⟶ C := CommRingCat.ofHom S.subtype
    have hδ : hpush.desc γ' β' w ≫ incl = 𝟙 C := by
      apply hpush.hom_ext
      · rw [← Category.assoc, hpush.inl_desc]; ext d; rfl
      · rw [← Category.assoc, hpush.inr_desc]; ext a; rfl
    intro c
    have h1 : ((hpush.desc γ' β' w).hom c : C) = c := congrArg (fun g => g.hom c) hδ
    rw [← h1]
    exact ((hpush.desc γ' β' w).hom c).2

  have TInt : ∀ (k Ω Bm R' : Type u) [CommRing k] [CommRing Ω] [Algebra k Ω] [CommRing Bm]
      [Algebra k Bm] [CommRing R'] (Ψ : R' →+* TensorProduct k Ω Bm),
      (∀ y : Ω, Ψ.IsIntegralElem (TensorProduct.tmul k y (1 : Bm))) →
      (∀ m : Bm, Ψ.IsIntegralElem (TensorProduct.tmul k (1 : Ω) m)) → Ψ.IsIntegral := by
    intro k Ω Bm R' _ _ _ _ _ _ Ψ hl hr x
    induction x using TensorProduct.induction_on with
    | zero =>
      have h0 := Ψ.isIntegralElem_map (x := 0)
      rwa [map_zero] at h0
    | tmul y m =>
      have e : TensorProduct.tmul k y m =
          TensorProduct.tmul k y (1 : Bm) * TensorProduct.tmul k (1 : Ω) m := by
        rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
      rw [e]
      exact RingHom.IsIntegralElem.mul Ψ (hl y) (hr m)
    | add x y hx hy => exact RingHom.IsIntegralElem.add Ψ hx hy

  have Tmu : ∀ (k L Ω R : Type u) [Field k] [Field L] [Field Ω] [Algebra k L] [Algebra k Ω]
      [Algebra L Ω] [IsScalarTower k L Ω] [Algebra.IsAlgebraic L Ω] [CommRing R] [Algebra k R],
      Function.Injective
        (Algebra.TensorProduct.map (IsScalarTower.toAlgHom k L Ω) (AlgHom.id k R)) ∧
      (Algebra.TensorProduct.map (IsScalarTower.toAlgHom k L Ω)
        (AlgHom.id k R)).toRingHom.IsIntegral := by
    intro k L Ω R _ _ _ _ _ _ _ _ _ _
    constructor
    · have e : ⇑(Algebra.TensorProduct.map (IsScalarTower.toAlgHom k L Ω) (AlgHom.id k R)) =
          ⇑(TensorProduct.map (IsScalarTower.toAlgHom k L Ω).toLinearMap
            (AlgHom.id k R).toLinearMap) := rfl
      rw [e]
      exact TensorProduct.map_injective_of_flat_flat _ _
        (fun a b h => (algebraMap L Ω).injective h) (fun a b h => h)
    · refine TInt k Ω R (TensorProduct k L R) _ ?_ ?_
      · intro y
        have hy : _root_.IsIntegral L y := (Algebra.IsAlgebraic.isAlgebraic y).isIntegral
        obtain ⟨P, hPm, hP⟩ := hy
        refine ⟨P.map Algebra.TensorProduct.includeLeftRingHom, hPm.map _, ?_⟩
        rw [Polynomial.eval₂_map]
        have hc : (Algebra.TensorProduct.map (IsScalarTower.toAlgHom k L Ω)
            (AlgHom.id k R)).toRingHom.comp
            (Algebra.TensorProduct.includeLeftRingHom : L →+* TensorProduct k L R) =
            (Algebra.TensorProduct.includeLeftRingHom : Ω →+* TensorProduct k Ω R).comp
              (algebraMap L Ω) := by
          refine RingHom.ext fun x => ?_
          simp [Algebra.TensorProduct.includeLeftRingHom_apply]
        rw [hc]
        have e2 : TensorProduct.tmul k y (1 : R) =
            (Algebra.TensorProduct.includeLeftRingHom : Ω →+* TensorProduct k Ω R) y := rfl
        rw [e2, ← Polynomial.hom_eval₂, hP, map_zero]
      · intro r
        have h := (Algebra.TensorProduct.map (IsScalarTower.toAlgHom k L Ω)
          (AlgHom.id k R)).toRingHom.isIntegralElem_map (x := TensorProduct.tmul k (1 : L) r)
        simpa [Algebra.TensorProduct.map_tmul] using h

  intro K _ _ A D _ κ α hdim e φ hφ C γ β hpush C' ρ hρ B ι hfin
  letI : Algebra A D := α.hom.toAlgebra
  letI : Algebra A B := (β ≫ ρ ≫ ι).hom.toAlgebra
  letI : Algebra (FractionRing A) (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors A))) :=
    localizationAlgebra (nonZeroDivisors A) B
  show ringKrullDim (TensorProduct (FractionRing A)
    (perfectClosure (FractionRing A) (AlgebraicClosure (FractionRing A)))
    (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors A)))) ≤ 1
  have hdim' : ringKrullDim (TensorProduct A D (AlgebraicClosure (FractionRing A))) ≤ 1 := hdim

  have LA : ∀ a : A, algebraMap (FractionRing A)
      (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors A)))
      (algebraMap A (FractionRing A) a) =
      algebraMap B (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors A)))
      (algebraMap A B a) := fun a =>
    IsLocalization.map_eq (T := Algebra.algebraMapSubmonoid B (nonZeroDivisors A))
      (fun x hx => ⟨x, hx, rfl⟩) a
  have LB : ∀ a : A, TensorProduct.tmul (FractionRing A) (1 : AlgebraicClosure (FractionRing A))
      (algebraMap B (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors A)))
        (algebraMap A B a)) =
      TensorProduct.tmul (FractionRing A)
        (algebraMap A (AlgebraicClosure (FractionRing A)) a)
        (1 : Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors A))) := by
    intro a
    rw [← LA, IsScalarTower.algebraMap_apply A (FractionRing A) (AlgebraicClosure (FractionRing A)) a]
    exact (Algebra.TensorProduct.algebraMap_apply' _).symm.trans
      (Algebra.TensorProduct.algebraMap_apply _)

  haveI hK : ExpChar K (ringExpChar K) := ringExpChar.expChar K
  let κ' : K →+* A := κ.hom
  have hjinj : Function.Injective
      ((algebraMap A (AlgebraicClosure (FractionRing A))).comp κ') := RingHom.injective _
  haveI hΩ : ExpChar (AlgebraicClosure (FractionRing A)) (ringExpChar K) :=
    expChar_of_injective_ringHom hjinj (ringExpChar K)

  let f₁ : D →+* TensorProduct (FractionRing A) (AlgebraicClosure (FractionRing A))
      (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors A))) :=
    (Algebra.TensorProduct.includeRight).toRingHom.comp
      ((algebraMap B (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors A)))).comp
        (ι.hom.comp (ρ.hom.comp γ.hom)))
  let f₂ : AlgebraicClosure (FractionRing A) →+* TensorProduct (FractionRing A)
      (AlgebraicClosure (FractionRing A))
      (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors A))) :=
    Algebra.TensorProduct.includeLeftRingHom.comp
      (iterateFrobenius (AlgebraicClosure (FractionRing A)) (ringExpChar K) e)
  have hP := CommRingCat.isPushout_tensorProduct A D (AlgebraicClosure (FractionRing A))
  have w : CommRingCat.ofHom (algebraMap A D) ≫ CommRingCat.ofHom f₁ =
      CommRingCat.ofHom (algebraMap A (AlgebraicClosure (FractionRing A))) ≫
        CommRingCat.ofHom f₂ := by
    ext a
    show f₁ (α.hom a) = f₂ (algebraMap A (AlgebraicClosure (FractionRing A)) a)
    have h1 : γ.hom (α.hom a) = β.hom (a ^ (ringExpChar K ^ e)) := by
      rw [← hφ a]; exact congrArg (fun g => g.hom a) hpush.toCommSq.w
    show (Algebra.TensorProduct.includeRight :
        Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors A)) →ₐ[FractionRing A]
          TensorProduct (FractionRing A) (AlgebraicClosure (FractionRing A))
            (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors A))))
        (algebraMap B (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors A)))
          (ι.hom (ρ.hom (γ.hom (α.hom a))))) =
      Algebra.TensorProduct.includeLeftRingHom
        (iterateFrobenius (AlgebraicClosure (FractionRing A)) (ringExpChar K) e
          (algebraMap A (AlgebraicClosure (FractionRing A)) a))
    rw [h1, iterateFrobenius_def]
    simp only [map_pow]
    rw [Algebra.TensorProduct.includeRight_apply, Algebra.TensorProduct.includeLeftRingHom_apply]
    rw [show ι.hom (ρ.hom (β.hom a)) = algebraMap A B a from rfl, LB a]
  let Ψ : TensorProduct A D (AlgebraicClosure (FractionRing A)) →+*
      TensorProduct (FractionRing A) (AlgebraicClosure (FractionRing A))
        (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors A))) :=
    (hP.desc (CommRingCat.ofHom f₁) (CommRingCat.ofHom f₂) w).hom
  have hΨ1 : ∀ d : D, Ψ (TensorProduct.tmul A d (1 : AlgebraicClosure (FractionRing A))) = f₁ d :=
    fun d => congrArg (fun g => g.hom d) (hP.inl_desc _ _ w)
  have hΨ2 : ∀ x : AlgebraicClosure (FractionRing A), Ψ (TensorProduct.tmul A (1 : D) x) = f₂ x :=
    fun x => congrArg (fun g => g.hom x) (hP.inr_desc _ _ w)

  have hq : 0 < ringExpChar K ^ e := pow_pos (expChar_pos K (ringExpChar K)) e
  have hy : ∀ y : AlgebraicClosure (FractionRing A), ∃ t, Ψ t = TensorProduct.tmul (FractionRing A) y
      (1 : Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors A))) := by
    intro y
    obtain ⟨z, hz⟩ := IsAlgClosed.exists_pow_nat_eq y hq
    refine ⟨TensorProduct.tmul A (1 : D) z, ?_⟩
    rw [hΨ2]
    show TensorProduct.tmul (FractionRing A)
      (iterateFrobenius (AlgebraicClosure (FractionRing A)) (ringExpChar K) e z)
      (1 : Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors A))) = _
    rw [iterateFrobenius_def, hz]
  have hc : ∀ c : C, ∃ t, Ψ t = TensorProduct.tmul (FractionRing A)
      (1 : AlgebraicClosure (FractionRing A))
      (algebraMap B (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors A)))
        (ι.hom (ρ.hom c))) := by
    let θ : C →+* TensorProduct (FractionRing A) (AlgebraicClosure (FractionRing A))
        (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors A))) :=
      (Algebra.TensorProduct.includeRight).toRingHom.comp
        ((algebraMap B (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors A)))).comp
          (ι.hom.comp ρ.hom))
    have hle : Subring.closure (Set.range γ.hom ∪ Set.range β.hom) ≤ Ψ.range.comap θ := by
      rw [Subring.closure_le]
      rintro _ (⟨d, rfl⟩ | ⟨a, rfl⟩)
      · exact Subring.mem_comap.mpr (RingHom.mem_range.mpr ⟨_, hΨ1 d⟩)
      · obtain ⟨t, ht⟩ := hy (algebraMap A (AlgebraicClosure (FractionRing A)) a)
        exact Subring.mem_comap.mpr (RingHom.mem_range.mpr ⟨t, ht.trans (LB a).symm⟩)
    intro c
    obtain ⟨t, ht⟩ := RingHom.mem_range.mp (Subring.mem_comap.mp (hle (T3 _ _ _ _ α φ γ β hpush c)))
    exact ⟨t, ht⟩

  have hdec : ∀ m : Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors A)),
      ∃ c : FractionRing A, ∃ b : B, m = algebraMap (FractionRing A)
        (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors A))) c *
        algebraMap B (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors A))) b := by
    intro m
    obtain ⟨⟨b, s⟩, rfl⟩ := IsLocalization.mk'_surjective
      (Algebra.algebraMapSubmonoid B (nonZeroDivisors A)) m
    obtain ⟨a, ha, hs⟩ := s.2
    have hu : algebraMap A (FractionRing A) a ≠ 0 :=
      IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors ha
    refine ⟨(algebraMap A (FractionRing A) a)⁻¹, b, ?_⟩
    dsimp only
    rw [IsLocalization.mk'_eq_iff_eq_mul]
    have h2 : algebraMap B (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors A))) (s : B)
        = algebraMap (FractionRing A)
          (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors A)))
          (algebraMap A (FractionRing A) a) := by
      rw [LA, hs]
    rw [h2, mul_comm (algebraMap (FractionRing A) _ _) (algebraMap B _ b), mul_assoc, ← map_mul,
      inv_mul_cancel₀ hu, map_one, mul_one]

  have hl : ∀ y : AlgebraicClosure (FractionRing A), Ψ.IsIntegralElem
      (TensorProduct.tmul (FractionRing A) y
        (1 : Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors A)))) := by
    intro y
    obtain ⟨t, ht⟩ := hy y
    rw [← ht]; exact Ψ.isIntegralElem_map
  have hb : ∀ b : B, Ψ.IsIntegralElem (TensorProduct.tmul (FractionRing A)
      (1 : AlgebraicClosure (FractionRing A))
      (algebraMap B (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors A))) b)) := by
    intro b
    by_cases hT : Subsingleton (TensorProduct (FractionRing A) (AlgebraicClosure (FractionRing A))
        (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors A))))
    · exact ⟨Polynomial.X, Polynomial.monic_X, Subsingleton.elim _ _⟩
    · haveI : Nontrivial (TensorProduct (FractionRing A) (AlgebraicClosure (FractionRing A))
          (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors A)))) :=
        not_subsingleton_iff_nontrivial.mp hT
      obtain ⟨P, hPm, hP⟩ := (RingHom.Finite.to_isIntegral hfin) b
      let g : B →+* TensorProduct (FractionRing A) (AlgebraicClosure (FractionRing A))
          (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors A))) :=
        (Algebra.TensorProduct.includeRight).toRingHom.comp
          (algebraMap B (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors A))))
      have hlift : P.map (g.comp ι.hom) ∈ Polynomial.lifts Ψ := by
        rw [Polynomial.lifts_iff_coeff_lifts]
        intro n
        rw [Polynomial.coeff_map]
        obtain ⟨c, hc'⟩ := hρ (P.coeff n)
        obtain ⟨t, ht⟩ := hc c
        exact ⟨t, by rw [← hc']; exact ht⟩
      obtain ⟨Q, hQ, -, hQm⟩ := Polynomial.lifts_and_degree_eq_and_monic hlift (hPm.map _)
      refine ⟨Q, hQm, ?_⟩
      rw [← Polynomial.eval_map, hQ, Polynomial.eval_map]
      have h0 : g (Polynomial.eval₂ ι.hom b P) = 0 := by rw [hP, map_zero]
      rw [Polynomial.hom_eval₂] at h0
      exact h0
  have hr : ∀ m : Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors A)),
      Ψ.IsIntegralElem (TensorProduct.tmul (FractionRing A)
        (1 : AlgebraicClosure (FractionRing A)) m) := by
    intro m
    obtain ⟨c, b, rfl⟩ := hdec m
    have e1 : TensorProduct.tmul (FractionRing A) (1 : AlgebraicClosure (FractionRing A))
        (algebraMap (FractionRing A)
          (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors A))) c *
        algebraMap B (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors A))) b) =
        TensorProduct.tmul (FractionRing A) (1 : AlgebraicClosure (FractionRing A))
          (algebraMap (FractionRing A)
            (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors A))) c) *
        TensorProduct.tmul (FractionRing A) (1 : AlgebraicClosure (FractionRing A))
          (algebraMap B (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors A))) b) := by
      rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one]
    have e2 : TensorProduct.tmul (FractionRing A) (1 : AlgebraicClosure (FractionRing A))
        (algebraMap (FractionRing A)
          (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors A))) c) =
        TensorProduct.tmul (FractionRing A)
          (algebraMap (FractionRing A) (AlgebraicClosure (FractionRing A)) c)
          (1 : Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors A))) :=
      (Algebra.TensorProduct.algebraMap_apply' c).symm.trans
        (Algebra.TensorProduct.algebraMap_apply c)
    rw [e1, e2]
    exact RingHom.IsIntegralElem.mul Ψ (hl _) (hb b)
  have hΨint : Ψ.IsIntegral := TInt _ _ _ _ Ψ hl hr
  have dimT := T1 _ _ Ψ hΨint

  haveI : Algebra.IsAlgebraic (perfectClosure (FractionRing A) (AlgebraicClosure (FractionRing A)))
      (AlgebraicClosure (FractionRing A)) :=
    Algebra.IsAlgebraic.tower_top (K := FractionRing A) _
  obtain ⟨hμinj, hμint⟩ := Tmu (FractionRing A)
    (perfectClosure (FractionRing A) (AlgebraicClosure (FractionRing A)))
    (AlgebraicClosure (FractionRing A))
    (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors A)))
  have dimN := T2 _ _ _ hμinj hμint
  exact le_trans dimN (le_trans dimT hdim')

theorem wcfd_tn_perfect_normalization_package : ∀ (L R : Type u) [Field L] [PerfectField L] [CommRing R] [Algebra L R] [Algebra.FiniteType L R] [_root_.IsReduced R], ∃ (N : Type u) (_ : CommRing N) (j : R →+* N), Function.Injective j ∧ j.Finite ∧ (∀ (P : Ideal N) [P.IsPrime], IsDomain (Localization.AtPrime P) ∧ IsIntegrallyClosed (Localization.AtPrime P)) ∧ ∃ g : R, g ∈ nonZeroDivisors R ∧ j g ∈ nonZeroDivisors N ∧ Function.Bijective (Localization.awayMap j g) :=
by
  intro L R _ _ _ _ _ _
  classical
  haveI : IsNoetherianRing R := Algebra.FiniteType.isNoetherianRing L R

  have s1 : ∀ r : R, (∀ P ∈ minimalPrimes R, r ∈ P) → r = 0 := by
    intro r hr
    apply IsNilpotent.eq_zero
    rw [nilpotent_iff_mem_prime]
    intro J hJ
    haveI := hJ
    obtain ⟨p, hp, hpJ⟩ := Ideal.exists_minimalPrimes_le (I := (⊥ : Ideal R)) (J := J) bot_le
    exact hpJ (hr p hp)

  have hmin : ∀ Q : wcfdPnpIdx R,
      Minimal (fun q : Ideal R => q.IsPrime ∧ ⊥ ≤ q) Q.1.asIdeal := fun Q => Q.2

  have hvan : ∀ (Q : wcfdPnpIdx R) (z : R), z ∈ Q.1.asIdeal →
      algebraMap R (Localization.AtPrime Q.1.asIdeal) z = 0 := by
    intro Q z hz
    apply IsNilpotent.eq_zero
    rw [nilpotent_iff_mem_prime]
    intro J hJ
    have hJ' : (J.comap (algebraMap R (Localization.AtPrime Q.1.asIdeal))).IsPrime := hJ.comap _
    have hle : J.comap (algebraMap R (Localization.AtPrime Q.1.asIdeal)) ≤ Q.1.asIdeal := by
      intro w hw
      by_contra hwQ
      have hu : IsUnit (algebraMap R (Localization.AtPrime Q.1.asIdeal) w) :=
        IsLocalization.map_units (Localization.AtPrime Q.1.asIdeal)
          (⟨w, hwQ⟩ : Q.1.asIdeal.primeCompl)
      exact hJ.ne_top (Ideal.eq_top_of_isUnit_mem _ hw hu)
    have heq := (hmin Q).eq_of_le ⟨hJ', bot_le⟩ hle
    have hz' : z ∈ J.comap (algebraMap R (Localization.AtPrime Q.1.asIdeal)) := by
      rw [heq]; exact hz
    exact hz'

  haveI : Finite (wcfdPnpIdx R) := by
    have hfin := minimalPrimes.finite_of_isNoetherianRing R
    haveI := hfin.to_subtype
    refine Finite.of_injective
      (fun Q : wcfdPnpIdx R => (⟨Q.1.asIdeal, Q.2⟩ : minimalPrimes R)) ?_
    intro Q Q' h
    apply Subtype.ext
    apply PrimeSpectrum.ext
    exact congrArg Subtype.val h
  letI : Fintype (wcfdPnpIdx R) := Fintype.ofFinite _

  have hsep : ∀ Q : wcfdPnpIdx R, ∃ t : R, t ∉ Q.1.asIdeal ∧
      ∀ Q' : wcfdPnpIdx R, Q' ≠ Q → t ∈ Q'.1.asIdeal := by
    intro Q
    have hx : ∀ Q' : wcfdPnpIdx R, Q' ≠ Q → ∃ x : R, x ∈ Q'.1.asIdeal ∧ x ∉ Q.1.asIdeal := by
      intro Q' hne
      by_contra hcon
      push_neg at hcon
      have := (hmin Q).eq_of_le ⟨Q'.1.isPrime, bot_le⟩ hcon
      exact hne (Subtype.ext (PrimeSpectrum.ext this))
    choose x hxQ' hxQ using hx
    let x' : wcfdPnpIdx R → R := fun Q' => if h : Q' = Q then 1 else x Q' h
    refine ⟨∏ Q' ∈ Finset.univ.erase Q, x' Q', ?_, ?_⟩
    · intro hmem
      obtain ⟨Q', hQ', hm⟩ := (Ideal.IsPrime.prod_mem_iff).mp hmem
      have hne : Q' ≠ Q := Finset.ne_of_mem_erase hQ'
      have hx'e : x' Q' = x Q' hne := dif_neg hne
      rw [hx'e] at hm
      exact hxQ Q' hne hm
    · intro Q' hne
      have hd : x' Q' ∣ ∏ Q' ∈ Finset.univ.erase Q, x' Q' :=
        Finset.dvd_prod_of_mem _ (Finset.mem_erase.mpr ⟨hne, Finset.mem_univ _⟩)
      refine Ideal.mem_of_dvd _ hd ?_
      have hx'e : x' Q' = x Q' hne := dif_neg hne
      rw [hx'e]
      exact hxQ' Q' hne
  choose t ht using hsep

  have s3 : ∀ y : wcfdPnpTot R, ∃ c : R, (∀ P ∈ minimalPrimes R, c ∉ P) ∧
      ∃ r : R, algebraMap R (wcfdPnpTot R) r = algebraMap R (wcfdPnpTot R) c * y := by
    intro y
    have hsurj : ∀ Q : wcfdPnpIdx R, ∃ p : R × Q.1.asIdeal.primeCompl,
        y Q * algebraMap R (Localization.AtPrime Q.1.asIdeal) p.2 =
          algebraMap R (Localization.AtPrime Q.1.asIdeal) p.1 :=
      fun Q => IsLocalization.surj Q.1.asIdeal.primeCompl (y Q)
    choose p hp using hsurj
    refine ⟨∑ Q, (p Q).2.1 * t Q, ?_, ∑ Q, t Q * (p Q).1, ?_⟩
    · intro P hP hc
      haveI hPp : P.IsPrime := Ideal.minimalPrimes_isPrime hP
      let Q : wcfdPnpIdx R := ⟨⟨P, hPp⟩, hP⟩
      rw [← Finset.add_sum_erase _ _ (Finset.mem_univ Q)] at hc
      have hrest : ∑ Q' ∈ Finset.univ.erase Q, (p Q').2.1 * t Q' ∈ P := by
        apply Ideal.sum_mem
        intro Q' hQ'
        exact Ideal.mul_mem_left _ _ ((ht Q').2 Q (Finset.ne_of_mem_erase hQ').symm)
      have hQt : (p Q).2.1 * t Q ∈ P := by
        have h2 := Ideal.sub_mem _ hc hrest
        simpa using h2
      exact hPp.mul_notMem (p Q).2.2 (ht Q).1 hQt
    · funext Q
      simp only [map_sum, map_mul, Finset.sum_apply, Pi.algebraMap_apply, Pi.mul_apply]
      have h1 : ∑ Q', algebraMap R (Localization.AtPrime Q.1.asIdeal) (t Q') *
          algebraMap R (Localization.AtPrime Q.1.asIdeal) (p Q').1 =
          algebraMap R (Localization.AtPrime Q.1.asIdeal) (t Q) *
          algebraMap R (Localization.AtPrime Q.1.asIdeal) (p Q).1 :=
        Finset.sum_eq_single_of_mem Q (Finset.mem_univ _) (fun Q' _ hne => by
          rw [hvan Q (t Q') ((ht Q').2 Q (Ne.symm hne)), zero_mul])
      have h2 : ∑ Q', algebraMap R (Localization.AtPrime Q.1.asIdeal) (p Q').2.1 *
          algebraMap R (Localization.AtPrime Q.1.asIdeal) (t Q') =
          algebraMap R (Localization.AtPrime Q.1.asIdeal) (p Q).2.1 *
          algebraMap R (Localization.AtPrime Q.1.asIdeal) (t Q) :=
        Finset.sum_eq_single_of_mem Q (Finset.mem_univ _) (fun Q' _ hne => by
          rw [hvan Q (t Q') ((ht Q').2 Q (Ne.symm hne)), mul_zero])
      rw [h1, h2, ← hp Q]
      ring

  haveI hfinN : Module.Finite R (integralClosure R (wcfdPnpTot R)) :=
    integralClosure_prod_minimal_finite R (wcfdPnpTot R) ⟨AlgEquiv.refl⟩ (fun P hP => by
      haveI := Ideal.minimalPrimes_isPrime hP
      exact noether_integralClosure_finite L (R ⧸ P))

  have hinjT : ∀ r : R, algebraMap R (wcfdPnpTot R) r = 0 → r = 0 := by
    intro r hr
    apply s1
    intro P hP
    haveI hPp : P.IsPrime := Ideal.minimalPrimes_isPrime hP
    let Q : wcfdPnpIdx R := ⟨⟨P, hPp⟩, hP⟩
    have h0 : algebraMap R (Localization.AtPrime Q.1.asIdeal) r = 0 := by
      have h := congrFun hr Q
      simp only [Pi.algebraMap_apply, Pi.zero_apply] at h
      exact h
    obtain ⟨m, hm⟩ := (IsLocalization.map_eq_zero_iff Q.1.asIdeal.primeCompl _ r).mp h0
    have hmr : (m : R) * r ∈ P := by rw [hm]; exact P.zero_mem
    exact (hPp.mem_or_mem hmr).resolve_left m.2
  have hinj : Function.Injective (algebraMap R (integralClosure R (wcfdPnpTot R))) := by
    rw [injective_iff_map_eq_zero]
    intro r hr
    apply hinjT
    exact congrArg Subtype.val hr

  obtain ⟨S, hS⟩ := (Module.Finite.fg_top :
    (⊤ : Submodule R (integralClosure R (wcfdPnpTot R))).FG)
  choose c hc r hr using fun n : integralClosure R (wcfdPnpTot R) => s3 (n : wcfdPnpTot R)
  obtain ⟨g, hg⟩ : ∃ g : R, g = ∏ s ∈ S, c s := ⟨_, rfl⟩
  have hgP : ∀ P ∈ minimalPrimes R, g ∉ P := by
    intro P hP hmem
    haveI := Ideal.minimalPrimes_isPrime hP
    rw [hg] at hmem
    obtain ⟨s, _, hs⟩ := Ideal.IsPrime.prod_mem_iff.mp hmem
    exact hc s P hP hs
  have hgR : g ∈ nonZeroDivisors R := by
    rw [mem_nonZeroDivisors_iff_right]
    intro x hx
    apply s1
    intro P hP
    haveI hPp := Ideal.minimalPrimes_isPrime hP
    have hxg : x * g ∈ P := by rw [hx]; exact P.zero_mem
    exact (hPp.mem_or_mem hxg).resolve_right (hgP P hP)
  have hgN : algebraMap R (integralClosure R (wcfdPnpTot R)) g ∈
      nonZeroDivisors (integralClosure R (wcfdPnpTot R)) := by
    rw [mem_nonZeroDivisors_iff_right]
    intro n hn
    apply Subtype.ext
    have h1 : (n : wcfdPnpTot R) * algebraMap R (wcfdPnpTot R) g = 0 := congrArg Subtype.val hn
    funext Q
    have h2 : (n : wcfdPnpTot R) Q * algebraMap R (Localization.AtPrime Q.1.asIdeal) g = 0 := by
      have h := congrFun h1 Q
      simp only [Pi.mul_apply, Pi.algebraMap_apply, Pi.zero_apply] at h
      exact h
    have hu : IsUnit (algebraMap R (Localization.AtPrime Q.1.asIdeal) g) :=
      IsLocalization.map_units _ (⟨g, hgP _ Q.2⟩ : Q.1.asIdeal.primeCompl)
    show (n : wcfdPnpTot R) Q = 0
    exact (hu.mul_left_eq_zero).mp h2

  have hcond : ∀ n : integralClosure R (wcfdPnpTot R), ∃ a : R,
      algebraMap R (integralClosure R (wcfdPnpTot R)) g * n =
        algebraMap R (integralClosure R (wcfdPnpTot R)) a := by
    intro n
    have hn : n ∈ (⊤ : Submodule R (integralClosure R (wcfdPnpTot R))) := trivial
    rw [← hS] at hn
    induction hn using Submodule.span_induction with
    | mem x hx =>
      refine ⟨(∏ s ∈ S.erase x, c s) * r x, ?_⟩
      apply Subtype.ext
      have hgx : g = (∏ s ∈ S.erase x, c s) * c x :=
        hg.trans (Finset.prod_erase_mul _ _ (Finset.mem_coe.mp hx)).symm
      show algebraMap R (wcfdPnpTot R) g * (x : wcfdPnpTot R) =
        algebraMap R (wcfdPnpTot R) ((∏ s ∈ S.erase x, c s) * r x)
      rw [hgx, map_mul, map_mul, hr x, mul_assoc]
    | zero => exact ⟨0, by simp⟩
    | add x y _ _ hx hy =>
      obtain ⟨a, ha⟩ := hx
      obtain ⟨b, hb⟩ := hy
      exact ⟨a + b, by rw [mul_add, ha, hb, map_add]⟩
    | smul a x _ hx =>
      obtain ⟨b, hb⟩ := hx
      exact ⟨a * b, by rw [Algebra.smul_def, mul_left_comm, hb, map_mul]⟩

  have hbij : Function.Bijective
      (Localization.awayMap (algebraMap R (integralClosure R (wcfdPnpTot R))) g) := by
    constructor
    · rw [injective_iff_map_eq_zero]
      intro w hw
      obtain ⟨⟨a, s⟩, rfl⟩ := IsLocalization.mk'_surjective (Submonoid.powers g) w
      simp only at hw ⊢
      rw [Localization.awayMap, IsLocalization.Away.map, IsLocalization.map_mk',
        IsLocalization.mk'_eq_zero_iff] at hw
      obtain ⟨⟨_, k, rfl⟩, hm⟩ := hw
      have hm' : algebraMap R (integralClosure R (wcfdPnpTot R)) (g ^ k * a) = 0 := by
        rw [map_mul, map_pow]; exact hm
      rw [IsLocalization.mk'_eq_zero_iff]
      exact ⟨⟨g ^ k, k, rfl⟩, hinj (by rw [hm', map_zero])⟩
    · intro z
      obtain ⟨⟨b, m⟩, hz⟩ := IsLocalization.surj
        (Submonoid.powers (algebraMap R (integralClosure R (wcfdPnpTot R)) g)) z
      obtain ⟨k, hk⟩ := m.2
      obtain ⟨a, ha⟩ := hcond b
      refine ⟨IsLocalization.mk' (Localization.Away g) a
        (⟨g ^ (k + 1), k + 1, rfl⟩ : Submonoid.powers g), ?_⟩
      rw [Localization.awayMap, IsLocalization.Away.map, IsLocalization.map_mk',
        IsLocalization.mk'_eq_iff_eq_mul]
      have hgk : algebraMap R (integralClosure R (wcfdPnpTot R)) (g ^ (k + 1)) =
          (m : integralClosure R (wcfdPnpTot R)) *
            algebraMap R (integralClosure R (wcfdPnpTot R)) g := by
        rw [map_pow, pow_succ, ← hk]
      simp only at hz
      show algebraMap _ _ (algebraMap R (integralClosure R (wcfdPnpTot R)) a) =
        z * algebraMap _ _ (algebraMap R (integralClosure R (wcfdPnpTot R)) (g ^ (k + 1)))
      rw [hgk, map_mul, ← mul_assoc, hz, ← map_mul, ← ha, mul_comm]
  refine ⟨integralClosure R (wcfdPnpTot R), inferInstance,
    algebraMap R (integralClosure R (wcfdPnpTot R)), hinj,
    RingHom.finite_algebraMap.mpr hfinN, ?_, g, hgR, hgN, hbij⟩
  intro P _
  exact integralClosure_prod_minimal_stalks_normal R (wcfdPnpTot R) ⟨AlgEquiv.refl⟩ P

theorem wcfd_tn_locally_normal_away_closed : ∀ (N : Type u) [CommRing N], (∀ (P : Ideal N) [P.IsPrime], IsDomain (Localization.AtPrime P) ∧ IsIntegrallyClosed (Localization.AtPrime P)) → ∀ t : N, t ∈ nonZeroDivisors N → ∀ y : Localization.Away t, IsIntegral N y → ∃ b : N, algebraMap N (Localization.Away t) b = y :=
by
  intro N _ hloc t ht y hy
  classical
  have hwit : ∀ (P : Ideal N), P.IsMaximal → ∃ b a : N, b ∉ P ∧
      algebraMap N (Localization.Away t) a = algebraMap N (Localization.Away t) b * y := by
    intro P hPm
    have hP : P.IsPrime := hPm.isPrime
    obtain ⟨hdom, hic⟩ := hloc P
    have hj : Function.Injective (algebraMap (Localization.AtPrime P)
        (FractionRing (Localization.AtPrime P))) :=
      IsFractionRing.injective (Localization.AtPrime P) (FractionRing (Localization.AtPrime P))
    have ht0 : algebraMap N (Localization.AtPrime P) t ≠ 0 := by
      intro h0
      rw [IsLocalization.map_eq_zero_iff P.primeCompl (Localization.AtPrime P)] at h0
      obtain ⟨⟨m, hm⟩, hmt⟩ := h0
      have hm0 : m = 0 := (mul_right_mem_nonZeroDivisors_eq_zero_iff ht).mp hmt
      exact hm (hm0 ▸ P.zero_mem)
    let g : N →+* FractionRing (Localization.AtPrime P) :=
      (algebraMap (Localization.AtPrime P) (FractionRing (Localization.AtPrime P))).comp
        (algebraMap N (Localization.AtPrime P))
    have hgt : IsUnit (g t) := by
      apply Ne.isUnit
      intro h
      apply ht0
      apply hj
      rw [map_zero]
      exact h
    let ψ : Localization.Away t →+* FractionRing (Localization.AtPrime P) :=
      IsLocalization.Away.lift t hgt
    have hψ : ∀ n : N, ψ (algebraMap N (Localization.Away t) n) = g n :=
      fun n => IsLocalization.Away.lift_eq t hgt n
    have hψc : ψ.comp (algebraMap N (Localization.Away t)) = g := RingHom.ext hψ
    obtain ⟨p, hpm, hp⟩ := hy
    have hint : _root_.IsIntegral (Localization.AtPrime P) (ψ y) := by
      refine ⟨p.map (algebraMap N (Localization.AtPrime P)), hpm.map _, ?_⟩
      rw [Polynomial.eval₂_map]
      have := Polynomial.hom_eval₂ p (algebraMap N (Localization.Away t)) ψ y
      rw [hp, map_zero, hψc] at this
      exact this.symm
    obtain ⟨s, hs⟩ := (IsIntegrallyClosed.isIntegral_iff (R := Localization.AtPrime P)
      (K := FractionRing (Localization.AtPrime P))).mp hint
    obtain ⟨⟨c, ⟨u, hu⟩⟩, rfl⟩ := IsLocalization.mk'_surjective P.primeCompl s
    have hsu := IsLocalization.mk'_spec (Localization.AtPrime P) c ⟨u, hu⟩
    obtain ⟨⟨a₀, ⟨_, n, rfl⟩⟩, hy0⟩ := IsLocalization.surj (Submonoid.powers t) y
    simp only at hy0 hsu
    have h1 : ψ y * g (t ^ n) = g a₀ := by
      rw [← hψ, ← hψ, ← map_mul, hy0]
    have h2 : g c = ψ y * g u := by
      show (algebraMap (Localization.AtPrime P) (FractionRing (Localization.AtPrime P)))
        (algebraMap N (Localization.AtPrime P) c) = ψ y * g u
      rw [← hsu, map_mul, hs]
      rfl
    have e1 : g (c * t ^ n) = g (a₀ * u) := by
      rw [map_mul, map_mul, h2, ← h1]
      ring
    have e2 : algebraMap N (Localization.AtPrime P) (c * t ^ n) =
        algebraMap N (Localization.AtPrime P) (a₀ * u) := hj e1
    obtain ⟨⟨w, hw⟩, hwe⟩ := (IsLocalization.eq_iff_exists P.primeCompl
      (Localization.AtPrime P)).mp e2
    simp only at hwe
    refine ⟨w * u, w * c, ?_, ?_⟩
    · intro hwu
      rcases hP.mem_or_mem hwu with h | h
      · exact hw h
      · exact hu h
    · have hunit : IsUnit (algebraMap N (Localization.Away t) (t ^ n)) :=
        IsLocalization.map_units (Localization.Away t) (⟨t ^ n, n, rfl⟩ : Submonoid.powers t)
      apply (hunit.mul_left_inj).mp
      have hwe' := congrArg (algebraMap N (Localization.Away t)) hwe
      simp only [map_mul] at hwe' ⊢
      linear_combination hwe' - (algebraMap N (Localization.Away t) w *
        algebraMap N (Localization.Away t) u) * hy0
  let I : Ideal N :=
    { carrier := {b | ∃ a, algebraMap N (Localization.Away t) a =
        algebraMap N (Localization.Away t) b * y}
      add_mem' := by
        rintro b₁ b₂ ⟨a₁, h₁⟩ ⟨a₂, h₂⟩
        exact ⟨a₁ + a₂, by rw [map_add, map_add, h₁, h₂, add_mul]⟩
      zero_mem' := ⟨0, by simp⟩
      smul_mem' := by
        rintro r b ⟨a, h⟩
        exact ⟨r * a, by rw [smul_eq_mul, map_mul, map_mul, h, mul_assoc]⟩ }
  have hI : I = ⊤ := by
    by_contra hne
    obtain ⟨P, hPm, hle⟩ := Ideal.exists_le_maximal I hne
    obtain ⟨b, a, hb, hab⟩ := hwit P hPm
    exact hb (hle (show b ∈ I from ⟨a, hab⟩))
  have h1 : (1 : N) ∈ I := hI ▸ Submodule.mem_top
  obtain ⟨a, ha⟩ := h1
  exact ⟨a, by rw [ha, map_one, one_mul]⟩

theorem wcfd_tn_tg_comparison : ∀ (R1 T N : Type u) [CommRing R1] [CommRing T] [CommRing N], (∀ (N : Type u) [CommRing N], (∀ (P : Ideal N) [P.IsPrime], IsDomain (Localization.AtPrime P) ∧ IsIntegrallyClosed (Localization.AtPrime P)) → ∀ t : N, t ∈ nonZeroDivisors N → ∀ y : Localization.Away t, IsIntegral N y → ∃ b : N, algebraMap N (Localization.Away t) b = y) → (∀ (P : Ideal N) [P.IsPrime], IsDomain (Localization.AtPrime P) ∧ IsIntegrallyClosed (Localization.AtPrime P)) → ∀ (iT : R1 →+* T) (j : R1 →+* N), Function.Injective iT → iT.IsIntegral → Function.Injective j → ∀ (f g : R1), f ∈ nonZeroDivisors R1 → iT f ∈ nonZeroDivisors T → j g ∈ nonZeroDivisors N → (∀ t : T, ∃ (n : ℕ) (r : R1), iT f ^ n * t = iT r) → (∀ z : N, ∃ (n : ℕ) (r : R1), j g ^ n * z = j r) → ∀ (s : ℕ) (y : Fin s → N), (∀ z : N, ∃ c : Fin s → R1, z = ∑ l, j (c l) * y l) → (∀ l, ∃ (t : T) (n : ℕ) (r : R1), j g ^ n * y l = j r ∧ iT g ^ n * t = iT r) → wcfdTnLocNormal T :=
by
  intro R1 T N _ _ _ Hcl hLN iT j hiTinj hiTint hjinj f g hf hiTf hjg hbirT hbirN s y hgen hmatch
  classical

  have hjf : j f ∈ nonZeroDivisors N := by
    rw [mem_nonZeroDivisors_iff_right]
    intro z hz
    obtain ⟨n, r, hr⟩ := hbirN z
    have h1 : j (r * f) = 0 := by
      rw [map_mul, ← hr, mul_assoc, hz, mul_zero]
    have h2 : r * f = 0 := hjinj (by rw [h1, map_zero])
    have h3 : r = 0 := (mem_nonZeroDivisors_iff_right.mp hf) r h2
    rw [h3, map_zero] at hr
    exact (mul_left_mem_nonZeroDivisors_eq_zero_iff (pow_mem hjg n)).mp hr

  have hex : ∀ (t : T) (n : ℕ) (r : R1), iT f ^ n * t = iT r → ∃ b : N, j f ^ n * b = j r := by
    intro t n r htr
    obtain ⟨P, hPm, hP⟩ := hiTint t
    have hQr : (P.scaleRoots (f ^ n)).eval r = 0 := by
      apply hiTinj
      rw [map_zero, ← Polynomial.eval₂_at_apply, ← htr, ← map_pow iT f n,
        Polynomial.scaleRoots_eval₂_mul, hP, mul_zero]
    have hw : IsUnit (algebraMap N (Localization.Away (j f)) (j f ^ n)) := by
      rw [map_pow]; exact (IsLocalization.Away.algebraMap_isUnit (j f)).pow n
    obtain ⟨w, hwdef⟩ := hw
    set z : Localization.Away (j f) := ↑w⁻¹ * algebraMap N (Localization.Away (j f)) (j r) with hz
    have hwz : (w : Localization.Away (j f)) * z = algebraMap N (Localization.Away (j f)) (j r) := by
      rw [hz, Units.mul_inv_cancel_left]
    have hφw : ((algebraMap N (Localization.Away (j f))).comp j) (f ^ n) = w := by
      rw [hwdef]; simp only [RingHom.comp_apply, map_pow]
    have key := Polynomial.scaleRoots_eval₂_mul (p := P) ((algebraMap N (Localization.Away (j f))).comp j) z (f ^ n)
    have hφr : algebraMap N (Localization.Away (j f)) (j r) =
        ((algebraMap N (Localization.Away (j f))).comp j) r := rfl
    rw [hφw, hwz, hφr, Polynomial.eval₂_at_apply, hQr, map_zero] at key
    have hzP : Polynomial.eval₂ ((algebraMap N (Localization.Away (j f))).comp j) z P = 0 :=
      (IsUnit.pow P.natDegree w.isUnit).mul_right_eq_zero.mp key.symm
    have hint : IsIntegral N z := ⟨P.map j, hPm.map j, by rw [Polynomial.eval₂_map]; exact hzP⟩
    obtain ⟨b, hb⟩ := Hcl N hLN (j f) hjf z hint
    refine ⟨b, ?_⟩
    apply IsLocalization.injective (Localization.Away (j f)) (M := Submonoid.powers (j f))
      (Submonoid.powers_le.mpr hjf)
    rw [map_mul, hb, ← hwdef]
    exact hwz

  choose nn rr hrr using hbirT
  choose bb hbb using fun t => hex t (nn t) (rr t) (hrr t)
  have hjfp : ∀ k : ℕ, j f ^ k ∈ nonZeroDivisors N := fun k => pow_mem hjf k
  have spec : ∀ (t : T) (m : ℕ) (s0 : R1), iT f ^ m * t = iT s0 → j f ^ m * bb t = j s0 := by
    intro t m s0 hts
    have h1 : f ^ m * rr t = f ^ (nn t) * s0 := by
      apply hiTinj
      rw [map_mul, map_mul, map_pow, map_pow, ← hrr t, ← hts]; ring
    apply (mul_cancel_left_mem_nonZeroDivisors (hjfp (nn t))).mp
    calc j f ^ nn t * (j f ^ m * bb t) = j f ^ m * (j f ^ nn t * bb t) := by ring
      _ = j f ^ m * j (rr t) := by rw [hbb t]
      _ = j (f ^ m * rr t) := by rw [map_mul, map_pow]
      _ = j (f ^ nn t * s0) := by rw [h1]
      _ = j f ^ nn t * j s0 := by rw [map_mul, map_pow]
  have hmul : ∀ a b : T, bb (a * b) = bb a * bb b := by
    intro a b
    have h := spec (a * b) (nn a + nn b) (rr a * rr b)
      (by rw [pow_add, map_mul, ← hrr a, ← hrr b]; ring)
    apply (mul_cancel_left_mem_nonZeroDivisors (hjfp (nn a + nn b))).mp
    rw [h, map_mul, ← hbb a, ← hbb b]; ring
  have hadd : ∀ a b : T, bb (a + b) = bb a + bb b := by
    intro a b
    have h := spec (a + b) (nn a + nn b) (f ^ nn b * rr a + f ^ nn a * rr b)
      (by simp only [map_add, map_mul, map_pow]; rw [← hrr a, ← hrr b]; ring)
    apply (mul_cancel_left_mem_nonZeroDivisors (hjfp (nn a + nn b))).mp
    rw [h]
    simp only [map_add, map_mul, map_pow]
    rw [← hbb a, ← hbb b]; ring
  have hone : bb 1 = 1 := by
    have h := spec 1 0 1 (by rw [pow_zero, one_mul, map_one])
    rwa [pow_zero, one_mul, map_one] at h
  have hzero : bb 0 = 0 := by
    have h := spec 0 0 0 (by rw [pow_zero, one_mul, map_zero])
    rwa [pow_zero, one_mul, map_zero] at h
  let Φ : T →+* N :=
    { toFun := bb, map_one' := hone, map_mul' := hmul, map_zero' := hzero, map_add' := hadd }
  have hΦ : ∀ t, Φ t = bb t := fun t => rfl
  have hΦinj : Function.Injective Φ := by
    rw [injective_iff_map_eq_zero]
    intro t ht
    rw [hΦ] at ht
    have h1 : j (rr t) = 0 := by rw [← hbb t, ht, mul_zero]
    have h2 : rr t = 0 := hjinj (by rw [h1, map_zero])
    have h3 := hrr t
    rw [h2, map_zero] at h3
    exact (mul_left_mem_nonZeroDivisors_eq_zero_iff (pow_mem hiTf _)).mp h3

  have hΦiT : ∀ x : R1, Φ (iT x) = j x := by
    intro x
    have h := spec (iT x) 0 x (by rw [pow_zero, one_mul])
    rw [pow_zero, one_mul] at h
    rw [hΦ]; exact h
  have hgen' : ∀ l, ∃ t : T, Φ t = y l := by
    intro l
    obtain ⟨t, n, r, h1, h2⟩ := hmatch l
    refine ⟨t, ?_⟩
    have h3 := congrArg Φ h2
    rw [map_mul, map_pow, hΦiT, hΦiT, ← h1] at h3
    exact (mul_cancel_left_mem_nonZeroDivisors (pow_mem hjg n)).mp h3
  choose tt htt using hgen'
  have hΦsurj : Function.Surjective Φ := by
    intro z
    obtain ⟨c, hc⟩ := hgen z
    refine ⟨∑ l, iT (c l) * tt l, ?_⟩
    rw [map_sum, hc]
    refine Finset.sum_congr rfl (fun l _ => ?_)
    rw [map_mul, hΦiT, htt]
  let e : T ≃+* N := RingEquiv.ofBijective Φ ⟨hΦinj, hΦsurj⟩

  unfold wcfdTnLocNormal
  intro P hP
  let P' : Ideal N := P.comap e.symm
  have hP' : P'.IsPrime := Ideal.comap_isPrime _ _
  have hM : Submonoid.map e.toMonoidHom P.primeCompl = P'.primeCompl := by
    ext x
    simp only [Submonoid.mem_map, Ideal.mem_primeCompl_iff, P', Ideal.mem_comap]
    constructor
    · rintro ⟨a, ha, rfl⟩
      simpa using ha
    · intro hx
      exact ⟨e.symm x, hx, by simp⟩
  let ψ : Localization.AtPrime P ≃+* Localization.AtPrime P' :=
    IsLocalization.ringEquivOfRingEquiv (Localization.AtPrime P) (Localization.AtPrime P') e hM
  obtain ⟨hd, hic⟩ := hLN P'
  exact ⟨MulEquiv.isDomain (Localization.AtPrime P') ψ.toMulEquiv, IsIntegrallyClosed.of_equiv ψ.symm⟩

theorem wcfd_tn_tg_twist_iso : ∀ (A D C : CommRingCat.{u}) [IsDomain A] (α : A ⟶ D) (φ : A ⟶ A) (γ : D ⟶ C) (β : A ⟶ C), IsPushout α φ γ β → ∀ (L : Type u) [Field L] [Algebra (FractionRing A) L] [Algebra A L] [IsScalarTower A (FractionRing A) L] (p e : ℕ) [ExpChar L p] [PerfectRing L p], (∀ a : A, φ.hom a = a ^ (p ^ e)) → letI := α.hom.toAlgebra; letI := β.hom.toAlgebra; letI : Algebra (FractionRing A) (Localization (Algebra.algebraMapSubmonoid C (nonZeroDivisors A))) := localizationAlgebra (nonZeroDivisors A) C; ∃ Θ : TensorProduct (FractionRing A) L (Localization (Algebra.algebraMapSubmonoid C (nonZeroDivisors A))) ≃+* TensorProduct A L D, ∀ (y : L) (d : D), y ^ (p ^ e) ∈ (algebraMap (FractionRing A) L).range → ∃ c : Localization (Algebra.algebraMapSubmonoid C (nonZeroDivisors A)), Θ ((1 : L) ⊗ₜ c) = y ⊗ₜ d :=
by
  intro A D C _ α φ γ β hpush L _ _ _ _ p e _ _ hφ
  letI : Algebra A D := α.hom.toAlgebra
  letI : Algebra A C := β.hom.toAlgebra
  letI : Algebra (FractionRing A) (Localization (Algebra.algebraMapSubmonoid C (nonZeroDivisors A))) :=
    localizationAlgebra (nonZeroDivisors A) C

  have hF1 : ∀ y : L, (iterateFrobeniusEquiv L p e).symm (y ^ (p ^ e)) = y := by
    intro y
    rw [RingEquiv.symm_apply_eq, iterateFrobeniusEquiv_apply, iterateFrobenius_def]
  have hF2 : ∀ z : L, ((iterateFrobeniusEquiv L p e).symm z) ^ (p ^ e) = z := by
    intro z
    rw [← iterateFrobenius_def (R := L) p e, ← iterateFrobeniusEquiv_apply L p e]
    exact (iterateFrobeniusEquiv L p e).apply_symm_apply z

  have s0 : ∀ a : A, algebraMap (FractionRing A)
      (Localization (Algebra.algebraMapSubmonoid C (nonZeroDivisors A)))
      (algebraMap A (FractionRing A) a) =
      algebraMap C (Localization (Algebra.algebraMapSubmonoid C (nonZeroDivisors A))) (β.hom a) :=
    fun a => IsLocalization.map_eq _ a

  obtain ⟨θ, hθγ, hθk⟩ : ∃ θ : Localization (Algebra.algebraMapSubmonoid C (nonZeroDivisors A)) →+*
      TensorProduct A L D,
      (∀ d : D, θ (algebraMap C (Localization (Algebra.algebraMapSubmonoid C (nonZeroDivisors A)))
        (γ.hom d)) = (1 : L) ⊗ₜ[A] d) ∧
      ∀ x : FractionRing A, θ (algebraMap (FractionRing A)
        (Localization (Algebra.algebraMapSubmonoid C (nonZeroDivisors A))) x) =
        ((iterateFrobeniusEquiv L p e).symm (algebraMap (FractionRing A) L x)) ⊗ₜ[A] (1 : D) := by
    let u : L →+* TensorProduct A L D :=
      (Algebra.TensorProduct.includeLeftRingHom (R := A) (A := L) (B := D)).comp
        (iterateFrobeniusEquiv L p e).symm.toRingHom
    have hw : α ≫ (CommRingCat.ofHom (Algebra.TensorProduct.includeRight (R := A) (A := L)
        (B := D)).toRingHom : D ⟶ CommRingCat.of (TensorProduct A L D)) =
        φ ≫ (CommRingCat.ofHom (u.comp (algebraMap A L)) : A ⟶ CommRingCat.of (TensorProduct A L D)) := by
      ext a
      change (1 : L) ⊗ₜ[A] (α.hom a) =
        ((iterateFrobeniusEquiv L p e).symm (algebraMap A L (φ.hom a))) ⊗ₜ[A] (1 : D)
      rw [hφ, map_pow (algebraMap A L), hF1]
      exact (Algebra.TensorProduct.tmul_one_eq_one_tmul (R := A) (A := L) (B := D) a).symm
    let ct : C ⟶ CommRingCat.of (TensorProduct A L D) := hpush.desc _ _ hw
    have hct1 : ∀ d : D, ct.hom (γ.hom d) = (1 : L) ⊗ₜ[A] d := fun d =>
      congrArg (fun f => CommRingCat.Hom.hom f d) (hpush.inl_desc _ _ hw)
    have hct2 : ∀ a : A, ct.hom (β.hom a) = u (algebraMap A L a) := fun a =>
      congrArg (fun f => CommRingCat.Hom.hom f a) (hpush.inr_desc _ _ hw)
    have hunits : ∀ y : Algebra.algebraMapSubmonoid C (nonZeroDivisors A),
        IsUnit (ct.hom (y : C)) := by
      rintro ⟨y, hy⟩
      obtain ⟨s, hs, rfl⟩ := Submonoid.mem_map.mp hy
      change IsUnit (ct.hom (β.hom s))
      rw [hct2, IsScalarTower.algebraMap_apply A (FractionRing A) L s]
      exact ((IsLocalization.map_units (FractionRing A) (⟨s, hs⟩ : nonZeroDivisors A)).map
        (algebraMap (FractionRing A) L)).map u
    let θ : Localization (Algebra.algebraMapSubmonoid C (nonZeroDivisors A)) →+*
        TensorProduct A L D := IsLocalization.lift hunits
    have hθ1 : ∀ c : C, θ (algebraMap C
        (Localization (Algebra.algebraMapSubmonoid C (nonZeroDivisors A))) c) = ct.hom c :=
      fun c => IsLocalization.lift_eq hunits c
    refine ⟨θ, fun d => by rw [hθ1, hct1], fun x => ?_⟩
    have hθk' : θ.comp (algebraMap (FractionRing A)
        (Localization (Algebra.algebraMapSubmonoid C (nonZeroDivisors A)))) =
        u.comp (algebraMap (FractionRing A) L) := by
      apply IsLocalization.ringHom_ext (nonZeroDivisors A)
      apply RingHom.ext
      intro a
      simp only [RingHom.comp_apply]
      rw [s0, hθ1, hct2, IsScalarTower.algebraMap_apply A (FractionRing A) L a]
    exact RingHom.congr_fun hθk' x

  obtain ⟨ψ, hψ1, hψ2⟩ : ∃ ψ : TensorProduct A L D →+* TensorProduct (FractionRing A) L
      (Localization (Algebra.algebraMapSubmonoid C (nonZeroDivisors A))),
      (∀ y : L, ψ (y ⊗ₜ[A] (1 : D)) = (y ^ (p ^ e)) ⊗ₜ[FractionRing A]
        (1 : Localization (Algebra.algebraMapSubmonoid C (nonZeroDivisors A)))) ∧
      ∀ d : D, ψ ((1 : L) ⊗ₜ[A] d) = (1 : L) ⊗ₜ[FractionRing A]
        algebraMap C (Localization (Algebra.algebraMapSubmonoid C (nonZeroDivisors A))) (γ.hom d) := by
    have hw0 : ∀ a : A, γ.hom (α.hom a) = β.hom (φ.hom a) := fun a =>
      congrArg (fun f => CommRingCat.Hom.hom f a) hpush.toCommSq.w
    let v : L →+* TensorProduct (FractionRing A) L
        (Localization (Algebra.algebraMapSubmonoid C (nonZeroDivisors A))) :=
      Algebra.TensorProduct.includeLeftRingHom.comp (iterateFrobenius L p e)
    let w : D →+* TensorProduct (FractionRing A) L
        (Localization (Algebra.algebraMapSubmonoid C (nonZeroDivisors A))) :=
      (Algebra.TensorProduct.includeRight (R := FractionRing A) (A := L)
        (B := Localization (Algebra.algebraMapSubmonoid C (nonZeroDivisors A)))).toRingHom.comp
        ((algebraMap C (Localization (Algebra.algebraMapSubmonoid C (nonZeroDivisors A)))).comp γ.hom)
    have hw2 : CommRingCat.ofHom (algebraMap A L) ≫ CommRingCat.ofHom v =
        CommRingCat.ofHom (algebraMap A D) ≫ CommRingCat.ofHom w := by
      ext a
      change (iterateFrobenius L p e (algebraMap A L a)) ⊗ₜ[FractionRing A]
          (1 : Localization (Algebra.algebraMapSubmonoid C (nonZeroDivisors A))) =
        (1 : L) ⊗ₜ[FractionRing A]
          algebraMap C (Localization (Algebra.algebraMapSubmonoid C (nonZeroDivisors A)))
            (γ.hom (α.hom a))
      rw [hw0, ← s0, ← Algebra.TensorProduct.tmul_one_eq_one_tmul,
        ← IsScalarTower.algebraMap_apply A (FractionRing A) L, hφ, map_pow (algebraMap A L),
        iterateFrobenius_def]
    have P := CommRingCat.isPushout_tensorProduct A L D
    refine ⟨(P.desc _ _ hw2).hom, fun y => ?_, fun d => ?_⟩
    · have h := congrArg (fun f => CommRingCat.Hom.hom f y) (P.inl_desc _ _ hw2)
      rw [← iterateFrobenius_def (R := L) p e y]
      exact h
    · exact congrArg (fun f => CommRingCat.Hom.hom f d) (P.inr_desc _ _ hw2)

  obtain ⟨Θ₀, hΘ1, hΘ2⟩ : ∃ Θ₀ : TensorProduct (FractionRing A) L
      (Localization (Algebra.algebraMapSubmonoid C (nonZeroDivisors A))) →+* TensorProduct A L D,
      (∀ x : L, Θ₀ (x ⊗ₜ[FractionRing A]
        (1 : Localization (Algebra.algebraMapSubmonoid C (nonZeroDivisors A)))) =
        ((iterateFrobeniusEquiv L p e).symm x) ⊗ₜ[A] (1 : D)) ∧
      ∀ c : Localization (Algebra.algebraMapSubmonoid C (nonZeroDivisors A)),
        Θ₀ ((1 : L) ⊗ₜ[FractionRing A] c) = θ c := by
    let u : L →+* TensorProduct A L D :=
      (Algebra.TensorProduct.includeLeftRingHom (R := A) (A := L) (B := D)).comp
        (iterateFrobeniusEquiv L p e).symm.toRingHom
    have hw3 : CommRingCat.ofHom (algebraMap (FractionRing A) L) ≫ CommRingCat.ofHom u =
        CommRingCat.ofHom (algebraMap (FractionRing A)
          (Localization (Algebra.algebraMapSubmonoid C (nonZeroDivisors A)))) ≫
        CommRingCat.ofHom θ := by
      ext x
      exact (hθk x).symm
    have P := CommRingCat.isPushout_tensorProduct (FractionRing A) L
      (Localization (Algebra.algebraMapSubmonoid C (nonZeroDivisors A)))
    exact ⟨(P.desc _ _ hw3).hom,
      fun x => congrArg (fun f => CommRingCat.Hom.hom f x) (P.inl_desc _ _ hw3),
      fun c => congrArg (fun f => CommRingCat.Hom.hom f c) (P.inr_desc _ _ hw3)⟩

  have hψθa : ∀ d : D, ψ (θ (algebraMap C
      (Localization (Algebra.algebraMapSubmonoid C (nonZeroDivisors A))) (γ.hom d))) =
      (1 : L) ⊗ₜ[FractionRing A] algebraMap C
        (Localization (Algebra.algebraMapSubmonoid C (nonZeroDivisors A))) (γ.hom d) := by
    intro d
    rw [hθγ, hψ2]
  have hψθb : ∀ a : A, ψ (θ (algebraMap C
      (Localization (Algebra.algebraMapSubmonoid C (nonZeroDivisors A))) (β.hom a))) =
      (1 : L) ⊗ₜ[FractionRing A] algebraMap C
        (Localization (Algebra.algebraMapSubmonoid C (nonZeroDivisors A))) (β.hom a) := by
    intro a
    rw [← s0, hθk, hψ1, hF2, Algebra.TensorProduct.tmul_one_eq_one_tmul]
  have hψθ : ∀ c : Localization (Algebra.algebraMapSubmonoid C (nonZeroDivisors A)),
      ψ (θ c) = (1 : L) ⊗ₜ[FractionRing A] c := by
    have key : ψ.comp θ = (Algebra.TensorProduct.includeRight (R := FractionRing A) (A := L)
        (B := Localization (Algebra.algebraMapSubmonoid C (nonZeroDivisors A)))).toRingHom := by
      apply IsLocalization.ringHom_ext (Algebra.algebraMapSubmonoid C (nonZeroDivisors A))
      have h1 : γ ≫ (CommRingCat.ofHom ((ψ.comp θ).comp (algebraMap C
          (Localization (Algebra.algebraMapSubmonoid C (nonZeroDivisors A))))) :
            C ⟶ CommRingCat.of (TensorProduct (FractionRing A) L
              (Localization (Algebra.algebraMapSubmonoid C (nonZeroDivisors A))))) =
          γ ≫ (CommRingCat.ofHom ((Algebra.TensorProduct.includeRight (R := FractionRing A) (A := L)
            (B := Localization (Algebra.algebraMapSubmonoid C (nonZeroDivisors A)))).toRingHom.comp
              (algebraMap C (Localization (Algebra.algebraMapSubmonoid C (nonZeroDivisors A))))) :
            C ⟶ CommRingCat.of (TensorProduct (FractionRing A) L
              (Localization (Algebra.algebraMapSubmonoid C (nonZeroDivisors A))))) := by
        ext d
        exact hψθa d
      have h2 : β ≫ (CommRingCat.ofHom ((ψ.comp θ).comp (algebraMap C
          (Localization (Algebra.algebraMapSubmonoid C (nonZeroDivisors A))))) :
            C ⟶ CommRingCat.of (TensorProduct (FractionRing A) L
              (Localization (Algebra.algebraMapSubmonoid C (nonZeroDivisors A))))) =
          β ≫ (CommRingCat.ofHom ((Algebra.TensorProduct.includeRight (R := FractionRing A) (A := L)
            (B := Localization (Algebra.algebraMapSubmonoid C (nonZeroDivisors A)))).toRingHom.comp
              (algebraMap C (Localization (Algebra.algebraMapSubmonoid C (nonZeroDivisors A))))) :
            C ⟶ CommRingCat.of (TensorProduct (FractionRing A) L
              (Localization (Algebra.algebraMapSubmonoid C (nonZeroDivisors A))))) := by
        ext a
        exact hψθb a
      exact congrArg CommRingCat.Hom.hom (hpush.hom_ext h1 h2)
    intro c
    exact RingHom.congr_fun key c

  have hb : Θ₀.comp ψ = RingHom.id (TensorProduct A L D) := by
    apply RingHom.ext
    intro z
    induction z using TensorProduct.induction_on with
    | zero => simp only [map_zero]
    | tmul y d =>
      have hyd : y ⊗ₜ[A] d = (y ⊗ₜ[A] (1 : D)) * ((1 : L) ⊗ₜ[A] d) := by
        rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
      rw [RingHom.comp_apply, RingHom.id_apply, hyd, map_mul, map_mul, hψ1, hψ2, hΘ1, hΘ2, hθγ,
        hF1]
    | add z z' hz hz' => rw [map_add, map_add, hz, hz']
  have hc : ψ.comp Θ₀ = RingHom.id (TensorProduct (FractionRing A) L
      (Localization (Algebra.algebraMapSubmonoid C (nonZeroDivisors A)))) := by
    apply RingHom.ext
    intro z
    induction z using TensorProduct.induction_on with
    | zero => simp only [map_zero]
    | tmul x c =>
      have hxc : x ⊗ₜ[FractionRing A] c = (x ⊗ₜ[FractionRing A]
          (1 : Localization (Algebra.algebraMapSubmonoid C (nonZeroDivisors A)))) *
          ((1 : L) ⊗ₜ[FractionRing A] c) := by
        rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
      rw [RingHom.comp_apply, RingHom.id_apply, hxc, map_mul, map_mul, hΘ1, hΘ2, hψ1, hF2, hψθ]
    | add z z' hz hz' => rw [map_add, map_add, hz, hz']

  refine ⟨RingEquiv.ofRingHom Θ₀ ψ hb hc, ?_⟩
  intro y d hy
  obtain ⟨x, hx⟩ := RingHom.mem_range.mp hy
  refine ⟨algebraMap (FractionRing A)
    (Localization (Algebra.algebraMapSubmonoid C (nonZeroDivisors A))) x *
    algebraMap C (Localization (Algebra.algebraMapSubmonoid C (nonZeroDivisors A))) (γ.hom d), ?_⟩
  rw [RingEquiv.ofRingHom_apply, hΘ2, map_mul, hθk, hθγ, hx, hF1,
    Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]

theorem wcfd_tn_tg_localize_package : ∀ (A C C' B : CommRingCat.{u}) [IsDomain A] (β : A ⟶ C) (ρ : C ⟶ C') (ι : C' ⟶ B), Function.Surjective ρ.hom → RingHom.ker ρ.hom = nilradical C → Function.Injective ι.hom → ι.hom.Finite → (∀ (Q : Ideal B) [Q.IsPrime], IsDomain (Localization.AtPrime Q) ∧ IsIntegrallyClosed (Localization.AtPrime Q)) → ∀ f : C', f ∈ nonZeroDivisors C' → ι.hom f ∈ nonZeroDivisors B → Function.Bijective (Localization.awayMap ι.hom f) → letI := β.hom.toAlgebra; letI := (β ≫ ρ).hom.toAlgebra; letI := (β ≫ ρ ≫ ι).hom.toAlgebra; letI : Algebra (FractionRing A) (Localization (Algebra.algebraMapSubmonoid C (nonZeroDivisors A))) := localizationAlgebra (nonZeroDivisors A) C; letI : Algebra (FractionRing A) (Localization (Algebra.algebraMapSubmonoid C' (nonZeroDivisors A))) := localizationAlgebra (nonZeroDivisors A) C'; letI : Algebra (FractionRing A) (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors A))) := localizationAlgebra (nonZeroDivisors A) B; ∃ (ρM : Localization (Algebra.algebraMapSubmonoid C (nonZeroDivisors A)) →ₐ[FractionRing A] Localization (Algebra.algebraMapSubmonoid C' (nonZeroDivisors A))) (ιM : Localization (Algebra.algebraMapSubmonoid C' (nonZeroDivisors A)) →ₐ[FractionRing A] Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors A))) (f0 : Localization (Algebra.algebraMapSubmonoid C' (nonZeroDivisors A))), Function.Surjective ρM ∧ RingHom.ker ρM = nilradical (Localization (Algebra.algebraMapSubmonoid C (nonZeroDivisors A))) ∧ Function.Injective ιM ∧ ιM.toRingHom.Finite ∧ wcfdTnLocNormal (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors A))) ∧ f0 ∈ nonZeroDivisors (Localization (Algebra.algebraMapSubmonoid C' (nonZeroDivisors A))) ∧ ιM f0 ∈ nonZeroDivisors (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors A))) ∧ ∀ b : Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors A)), ∃ (n : ℕ) (r : Localization (Algebra.algebraMapSubmonoid C' (nonZeroDivisors A))), ιM f0 ^ n * b = ιM r :=
by

  have gen : ∀ (R X Y : Type u) [CommRing R] [CommRing X] [CommRing Y] [Algebra R X] [Algebra R Y]
      (M : Submonoid R) (g : X →+* Y), (∀ r : R, g (algebraMap R X r) = algebraMap R Y r) →
      ∃ gM : Localization (Algebra.algebraMapSubmonoid X M) →+*
          Localization (Algebra.algebraMapSubmonoid Y M),
        (∀ x : X, gM (algebraMap X _ x) = algebraMap Y _ (g x)) ∧
        (∀ z : Localization (Algebra.algebraMapSubmonoid Y M), ∃ (y : Y)
            (v : Localization (Algebra.algebraMapSubmonoid X M)), z = algebraMap Y _ y * gM v) ∧
        (∀ x : X, algebraMap Y (Localization (Algebra.algebraMapSubmonoid Y M)) (g x) = 0 →
            ∃ c ∈ Algebra.algebraMapSubmonoid X M, g (c * x) = 0) := by
    intro R X Y _ _ _ _ _ M g hg
    have hle : Algebra.algebraMapSubmonoid X M ≤ (Algebra.algebraMapSubmonoid Y M).comap g := by
      intro x hx
      obtain ⟨m, hm, rfl⟩ := Submonoid.mem_map.mp hx
      exact Submonoid.mem_comap.mpr (Submonoid.mem_map.mpr ⟨m, hm, (hg m).symm⟩)
    refine ⟨IsLocalization.map (Localization (Algebra.algebraMapSubmonoid Y M)) g hle,
      fun x => IsLocalization.map_eq hle x, ?_, ?_⟩
    · intro z
      obtain ⟨p, hp⟩ := IsLocalization.surj (Algebra.algebraMapSubmonoid Y M) z
      obtain ⟨m, hm, hcm⟩ := Submonoid.mem_map.mp p.2.2
      let t : Algebra.algebraMapSubmonoid X M := ⟨algebraMap R X m, Submonoid.mem_map.mpr ⟨m, hm, rfl⟩⟩
      refine ⟨p.1, IsLocalization.mk' (Localization (Algebra.algebraMapSubmonoid X M)) (1 : X) t, ?_⟩
      have hinv : IsLocalization.map (Localization (Algebra.algebraMapSubmonoid Y M)) g hle
          (IsLocalization.mk' (Localization (Algebra.algebraMapSubmonoid X M)) (1 : X) t) *
          algebraMap Y (Localization (Algebra.algebraMapSubmonoid Y M)) (p.2 : Y) = 1 := by
        have h1 : (p.2 : Y) = g (t : X) := by rw [← hcm]; exact (hg m).symm
        rw [h1, ← IsLocalization.map_eq (S := Localization (Algebra.algebraMapSubmonoid X M)) hle,
          ← map_mul, IsLocalization.mk'_spec, map_one, map_one]
      calc z = z * (algebraMap Y _ (p.2 : Y) * IsLocalization.map
              (Localization (Algebra.algebraMapSubmonoid Y M)) g hle
              (IsLocalization.mk' (Localization (Algebra.algebraMapSubmonoid X M)) (1 : X) t)) := by
            rw [mul_comm (algebraMap Y _ _), hinv, mul_one]
        _ = _ := by rw [← mul_assoc, hp]
    · intro x hx
      obtain ⟨c, hc⟩ := (IsLocalization.map_eq_zero_iff (Algebra.algebraMapSubmonoid Y M) _ (g x)).mp hx
      obtain ⟨m, hm, hcm⟩ := Submonoid.mem_map.mp c.2
      refine ⟨algebraMap R X m, Submonoid.mem_map.mpr ⟨m, hm, rfl⟩, ?_⟩
      rw [map_mul, hg, hcm, hc]
  intro A C C' B _ β ρ ι hρ hker hinj hfin hnorm f hf1 hf2 hf3
  letI iC : Algebra A C := β.hom.toAlgebra
  letI iC' : Algebra A C' := (β ≫ ρ).hom.toAlgebra
  letI iB : Algebra A B := (β ≫ ρ ≫ ι).hom.toAlgebra
  letI kC : Algebra (FractionRing A) (Localization (Algebra.algebraMapSubmonoid C (nonZeroDivisors A))) :=
    localizationAlgebra (nonZeroDivisors A) C
  letI kC' : Algebra (FractionRing A) (Localization (Algebra.algebraMapSubmonoid C' (nonZeroDivisors A))) :=
    localizationAlgebra (nonZeroDivisors A) C'
  letI kB : Algebra (FractionRing A) (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors A))) :=
    localizationAlgebra (nonZeroDivisors A) B
  have hρc : ∀ a : A, ρ.hom (algebraMap A C a) = algebraMap A C' a := fun a => rfl
  have hιc : ∀ a : A, ι.hom (algebraMap A C' a) = algebraMap A B a := fun a => rfl
  obtain ⟨ρ₀, haρ, hbρ, hcρ⟩ := gen A C C' (nonZeroDivisors A) ρ.hom hρc
  obtain ⟨ι₀, haι, hbι, hcι⟩ := gen A C' B (nonZeroDivisors A) ι.hom hιc
  have eC : ∀ a : A, algebraMap (FractionRing A) (Localization (Algebra.algebraMapSubmonoid C (nonZeroDivisors A)))
      (algebraMap A (FractionRing A) a) =
      algebraMap C (Localization (Algebra.algebraMapSubmonoid C (nonZeroDivisors A))) (algebraMap A C a) :=
    fun a => IsLocalization.map_eq _ a
  have eC' : ∀ a : A, algebraMap (FractionRing A) (Localization (Algebra.algebraMapSubmonoid C' (nonZeroDivisors A)))
      (algebraMap A (FractionRing A) a) =
      algebraMap C' (Localization (Algebra.algebraMapSubmonoid C' (nonZeroDivisors A))) (algebraMap A C' a) :=
    fun a => IsLocalization.map_eq _ a
  have eB : ∀ a : A, algebraMap (FractionRing A) (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors A)))
      (algebraMap A (FractionRing A) a) =
      algebraMap B (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors A))) (algebraMap A B a) :=
    fun a => IsLocalization.map_eq _ a
  have Hρ : ρ₀.comp (algebraMap (FractionRing A) (Localization (Algebra.algebraMapSubmonoid C (nonZeroDivisors A)))) =
      algebraMap (FractionRing A) (Localization (Algebra.algebraMapSubmonoid C' (nonZeroDivisors A))) := by
    apply IsLocalization.ringHom_ext (nonZeroDivisors A)
    refine RingHom.ext fun a => ?_
    rw [RingHom.comp_apply, RingHom.comp_apply, RingHom.comp_apply, eC a, haρ, eC' a, hρc]
  have Hι : ι₀.comp (algebraMap (FractionRing A) (Localization (Algebra.algebraMapSubmonoid C' (nonZeroDivisors A)))) =
      algebraMap (FractionRing A) (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors A))) := by
    apply IsLocalization.ringHom_ext (nonZeroDivisors A)
    refine RingHom.ext fun a => ?_
    rw [RingHom.comp_apply, RingHom.comp_apply, RingHom.comp_apply, eC' a, haι, eB a, hιc]
  let ρM : Localization (Algebra.algebraMapSubmonoid C (nonZeroDivisors A)) →ₐ[FractionRing A]
      Localization (Algebra.algebraMapSubmonoid C' (nonZeroDivisors A)) :=
    AlgHom.mk ρ₀ (fun q => RingHom.congr_fun Hρ q)
  let ιM : Localization (Algebra.algebraMapSubmonoid C' (nonZeroDivisors A)) →ₐ[FractionRing A]
      Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors A)) :=
    AlgHom.mk ι₀ (fun q => RingHom.congr_fun Hι q)

  have hρs : Function.Surjective ρ₀ := by
    intro z
    obtain ⟨y, v, rfl⟩ := hbρ z
    obtain ⟨x, rfl⟩ := hρ y
    exact ⟨algebraMap C _ x * v, by rw [map_mul, haρ]⟩

  haveI hred : _root_.IsReduced C' := ⟨fun y hy => by
    obtain ⟨n, hn⟩ := hy
    obtain ⟨x, rfl⟩ := hρ y
    have h1 : x ^ n ∈ RingHom.ker ρ.hom := by rw [RingHom.mem_ker, map_pow, hn]
    rw [hker, mem_nilradical] at h1
    obtain ⟨k, hk⟩ := h1
    have h2 : x ∈ nilradical C := mem_nilradical.mpr ⟨n * k, by rw [pow_mul, hk]⟩
    rw [← hker] at h2
    exact RingHom.mem_ker.mp h2⟩

  have hρk : RingHom.ker ρM = nilradical (Localization (Algebra.algebraMapSubmonoid C (nonZeroDivisors A))) := by
    ext z
    rw [RingHom.mem_ker, mem_nilradical]
    change ρ₀ z = 0 ↔ IsNilpotent z
    constructor
    · intro hz
      obtain ⟨p, hp⟩ := IsLocalization.surj (Algebra.algebraMapSubmonoid C (nonZeroDivisors A)) z
      have h1 : algebraMap C' (Localization (Algebra.algebraMapSubmonoid C' (nonZeroDivisors A))) (ρ.hom p.1) = 0 := by
        rw [← haρ, ← hp, map_mul, hz, zero_mul]
      obtain ⟨c, hc, hcx⟩ := hcρ p.1 h1
      have h2 : c * p.1 ∈ nilradical C := by rw [← hker]; exact hcx
      obtain ⟨k, hk⟩ := mem_nilradical.mp h2
      have h3 : (algebraMap C (Localization (Algebra.algebraMapSubmonoid C (nonZeroDivisors A))) (c * p.1)) ^ k = 0 := by
        rw [← map_pow, hk, map_zero]
      rw [map_mul, ← hp, mul_pow, mul_pow] at h3
      have hcu : IsUnit (algebraMap C (Localization (Algebra.algebraMapSubmonoid C (nonZeroDivisors A))) c) :=
        IsLocalization.map_units _ (⟨c, hc⟩ : Algebra.algebraMapSubmonoid C (nonZeroDivisors A))
      have htu : IsUnit (algebraMap C (Localization (Algebra.algebraMapSubmonoid C (nonZeroDivisors A))) (p.2 : C)) :=
        IsLocalization.map_units _ p.2
      have h4 := (hcu.pow k).mul_right_eq_zero.mp h3
      exact ⟨k, (htu.pow k).mul_left_eq_zero.mp h4⟩
    · intro hz
      exact IsReduced.eq_zero _ (hz.map ρ₀)

  have hιinj : Function.Injective ι₀ := by
    rw [injective_iff_map_eq_zero]
    intro z hz
    obtain ⟨p, hp⟩ := IsLocalization.surj (Algebra.algebraMapSubmonoid C' (nonZeroDivisors A)) z
    have h1 : algebraMap B (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors A))) (ι.hom p.1) = 0 := by
      rw [← haι, ← hp, map_mul, hz, zero_mul]
    obtain ⟨c, hc, hcx⟩ := hcι p.1 h1
    have h2 : c * p.1 = 0 := hinj (by rw [hcx, map_zero])
    have h3 : algebraMap C' (Localization (Algebra.algebraMapSubmonoid C' (nonZeroDivisors A))) p.1 = 0 :=
      (IsLocalization.map_eq_zero_iff (Algebra.algebraMapSubmonoid C' (nonZeroDivisors A)) _ p.1).mpr
        ⟨⟨c, hc⟩, h2⟩
    rw [← hp] at h3
    exact (IsLocalization.map_units _ p.2).mul_left_eq_zero.mp h3

  have hιfin : ι₀.Finite := by
    letI : Algebra C' B := ι.hom.toAlgebra
    haveI : Module.Finite C' B := hfin
    obtain ⟨n, s, hs⟩ := Module.Finite.exists_fin (R := C') (M := B)
    letI : Algebra (Localization (Algebra.algebraMapSubmonoid C' (nonZeroDivisors A)))
      (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors A))) := ι₀.toAlgebra
    have : Module.Finite (Localization (Algebra.algebraMapSubmonoid C' (nonZeroDivisors A)))
        (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors A))) := by
      classical
      refine Module.finite_def.mpr ⟨Finset.univ.image (fun i => algebraMap B
        (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors A))) (s i)), ?_⟩
      rw [eq_top_iff]
      intro w _
      obtain ⟨y, v, rfl⟩ := hbι w
      have hy : y ∈ Submodule.span C' (Set.range s) := by rw [hs]; trivial
      obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun C').mp hy
      rw [← hc, map_sum, Finset.sum_mul]
      refine Submodule.sum_mem _ (fun i _ => ?_)
      have e : algebraMap B (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors A))) (c i • s i) * ι₀ v =
          (algebraMap C' (Localization (Algebra.algebraMapSubmonoid C' (nonZeroDivisors A))) (c i) * v) •
            algebraMap B (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors A))) (s i) := by
        simp only [Algebra.smul_def, RingHom.algebraMap_toAlgebra, map_mul, haι]
        ring
      rw [e]
      exact Submodule.smul_mem _ _ (Submodule.subset_span
        (Finset.mem_coe.mpr (Finset.mem_image_of_mem _ (Finset.mem_univ i))))
    exact this

  have hloc : wcfdTnLocNormal (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors A))) := by
    unfold wcfdTnLocNormal
    intro Q _
    haveI : (Q.comap (algebraMap B (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors A))))).IsPrime :=
      Ideal.IsPrime.comap _
    haveI : IsLocalization.AtPrime (Localization.AtPrime Q)
        (Q.comap (algebraMap B (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors A))))) :=
      IsLocalization.isLocalization_isLocalization_atPrime_isLocalization
        (Algebra.algebraMapSubmonoid B (nonZeroDivisors A)) (Localization.AtPrime Q) Q
    obtain ⟨h1, h2⟩ := hnorm (Q.comap (algebraMap B (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors A)))))
    let e := IsLocalization.algEquiv
      (Q.comap (algebraMap B (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors A))))).primeCompl
      (Localization.AtPrime (Q.comap (algebraMap B (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors A))))))
      (Localization.AtPrime Q)
    exact ⟨MulEquiv.isDomain _ e.symm.toMulEquiv, IsIntegrallyClosed.of_equiv e.toRingEquiv⟩

  have hbirB : ∀ z : B, ∃ (n : ℕ) (r : C'), ι.hom f ^ n * z = ι.hom r := by
    intro z
    obtain ⟨x, hx⟩ := hf3.2 (algebraMap B (Localization.Away (ι.hom f)) z)
    obtain ⟨⟨r, ⟨_, n, rfl⟩⟩, hr⟩ := IsLocalization.surj (Submonoid.powers f) x
    have hmap : ∀ w : C', Localization.awayMap ι.hom f
        (algebraMap _ (Localization.Away f) w) = algebraMap B (Localization.Away (ι.hom f)) (ι.hom w) :=
      fun w => IsLocalization.map_eq _ _
    have h2 := congrArg (Localization.awayMap ι.hom f) hr
    simp only at h2
    rw [map_mul, hx, hmap, hmap, ← map_mul] at h2
    obtain ⟨⟨c, ⟨m, rfl⟩⟩, hc⟩ := (IsLocalization.eq_iff_exists (Submonoid.powers (ι.hom f)) _).mp h2
    have hcm : (ι.hom f) ^ m ∈ nonZeroDivisors B := pow_mem hf2 m
    simp only at hc
    rw [mul_cancel_left_mem_nonZeroDivisors hcm, map_pow] at hc
    exact ⟨n, r, by rw [mul_comm]; exact hc⟩
  refine ⟨ρM, ιM, algebraMap C' _ f, hρs, hρk, hιinj, hιfin, hloc, ?_, ?_, ?_⟩
  · exact IsLocalization.map_nonZeroDivisors_le (Algebra.algebraMapSubmonoid C' (nonZeroDivisors A)) _
      (Submonoid.mem_map_of_mem _ hf1)
  · change ι₀ (algebraMap C' _ f) ∈ _
    rw [haι]
    exact IsLocalization.map_nonZeroDivisors_le (Algebra.algebraMapSubmonoid B (nonZeroDivisors A)) _
      (Submonoid.mem_map_of_mem _ hf2)
  · intro b
    obtain ⟨y, v, rfl⟩ := hbι b
    obtain ⟨n, r, hr⟩ := hbirB y
    refine ⟨n, algebraMap C' _ r * v, ?_⟩
    change ι₀ (algebraMap C' _ f) ^ n * (algebraMap B _ y * ι₀ v) = ι₀ (algebraMap C' _ r * v)
    rw [map_mul, haι, haι, ← mul_assoc, ← map_pow, ← map_mul, hr]

theorem wcfd_tn_tg_nil_stable : ∀ (k L S S' W : Type u) [Field k] [Field L] [Algebra k L] [CommRing S] [Algebra k S] [CommRing S'] [Algebra k S'] [CommRing W] (ρS : S →ₐ[k] S'), Function.Surjective ρS → RingHom.ker ρS = nilradical S → ∀ (Θ : TensorProduct k L S ≃+* W) (r : ℕ) (ν : Fin r → W), Ideal.span (Set.range ν) = nilradical W → (∀ l, ∃ s : S, Θ ((1 : L) ⊗ₜ[k] s) = ν l) → ∃ Θ' : TensorProduct k L S' ≃+* (W ⧸ nilradical W), ∀ s : S, Θ' ((1 : L) ⊗ₜ[k] ρS s) = Ideal.Quotient.mk (nilradical W) (Θ ((1 : L) ⊗ₜ[k] s)) :=
by
  intro k L S S' W _ _ _ _ _ _ _ _ ρS hρs hρk Θ r ν hν hΘν
  classical
  choose s hs using hΘν
  let π : TensorProduct k L S →ₐ[k] TensorProduct k L S' :=
    Algebra.TensorProduct.map (AlgHom.id k L) ρS
  have hπs : Function.Surjective (π : TensorProduct k L S →+* TensorProduct k L S') :=
    Algebra.TensorProduct.map_surjective (AlgHom.id k L) ρS (fun x => ⟨x, rfl⟩) hρs
  let ψ : TensorProduct k L S →+* W ⧸ nilradical W :=
    (Ideal.Quotient.mk (nilradical W)).comp Θ.toRingHom
  have hψs : Function.Surjective ψ :=
    Ideal.Quotient.mk_surjective.comp Θ.surjective
  have hψker : ∀ x, x ∈ RingHom.ker ψ ↔ Θ x ∈ nilradical W := by
    intro x
    rw [RingHom.mem_ker]
    exact Ideal.Quotient.eq_zero_iff_mem
  have hinjR : Function.Injective
      (Algebra.TensorProduct.includeRight : S →ₐ[k] TensorProduct k L S) :=
    Algebra.TensorProduct.includeRight_injective (algebraMap k L).injective
  have hs0 : ∀ l, ρS (s l) = 0 := by
    intro l
    have h1 : ν l ∈ nilradical W := by
      rw [← hν]; exact Ideal.subset_span ⟨l, rfl⟩
    have h2 : IsNilpotent (Θ ((Algebra.TensorProduct.includeRight :
        S →ₐ[k] TensorProduct k L S) (s l))) := by
      rw [Algebra.TensorProduct.includeRight_apply, hs l]; exact mem_nilradical.mp h1
    have h3 : IsNilpotent ((Algebra.TensorProduct.includeRight :
        S →ₐ[k] TensorProduct k L S) (s l)) :=
      (IsNilpotent.map_iff Θ.injective).mp h2
    have h4 : IsNilpotent (s l) := (IsNilpotent.map_iff hinjR).mp h3
    have h5 : s l ∈ RingHom.ker ρS := by rw [hρk]; exact mem_nilradical.mpr h4
    exact h5
  have hle1 : RingHom.ker ψ ≤ RingHom.ker (π : TensorProduct k L S →+* TensorProduct k L S') := by
    intro x hx
    rw [hψker, ← hν] at hx
    obtain ⟨c, hc⟩ := (Ideal.mem_span_range_iff_exists_fun).mp hx
    have hx' : x = ∑ l, Θ.symm (c l) * ((1 : L) ⊗ₜ[k] s l) := by
      apply Θ.injective
      rw [map_sum, ← hc]
      refine Finset.sum_congr rfl (fun l _ => ?_)
      rw [map_mul, RingEquiv.apply_symm_apply, hs l]
    rw [RingHom.mem_ker, hx', map_sum]
    refine Finset.sum_eq_zero (fun l _ => ?_)
    rw [map_mul]
    change _ * π ((1 : L) ⊗ₜ[k] s l) = 0
    rw [Algebra.TensorProduct.map_tmul, hs0 l, TensorProduct.tmul_zero, mul_zero]
  have hle2 : RingHom.ker (π : TensorProduct k L S →+* TensorProduct k L S') ≤ RingHom.ker ψ := by
    have hk := Algebra.TensorProduct.lTensor_ker (A := L) ρS hρs
    change RingHom.ker π ≤ _
    rw [hk, hρk, Ideal.map_le_iff_le_comap]
    intro t ht
    rw [Ideal.mem_comap, hψker]
    exact mem_nilradical.mpr (((mem_nilradical.mp ht).map _).map Θ)
  have hK : RingHom.ker (π : TensorProduct k L S →+* TensorProduct k L S') = RingHom.ker ψ :=
    le_antisymm hle2 hle1
  refine ⟨(RingHom.quotientKerEquivOfSurjective hπs).symm.trans
    ((Ideal.quotEquivOfEq hK).trans (RingHom.quotientKerEquivOfSurjective hψs)), fun t => ?_⟩
  have e1 : (RingHom.quotientKerEquivOfSurjective hπs).symm ((1 : L) ⊗ₜ[k] ρS t) =
      Ideal.Quotient.mk _ ((1 : L) ⊗ₜ[k] t) := by
    rw [RingEquiv.symm_apply_eq, RingHom.quotientKerEquivOfSurjective_apply_mk]
    change _ = π ((1 : L) ⊗ₜ[k] t)
    rw [Algebra.TensorProduct.map_tmul]; rfl
  rw [RingEquiv.trans_apply, RingEquiv.trans_apply, e1, Ideal.quotEquivOfEq_mk,
    RingHom.quotientKerEquivOfSurjective_apply_mk]
  rfl

theorem wcfd_tn_tg_matching : ∀ (R0 R1 N B0 : Type u) [CommRing R0] [CommRing R1] [CommRing N] [CommRing B0] (i : R0 →+* R1) (j : R1 →+* N) (ι0 : R0 →+* B0), (∀ (N : Type u) [CommRing N], (∀ (P : Ideal N) [P.IsPrime], IsDomain (Localization.AtPrime P) ∧ IsIntegrallyClosed (Localization.AtPrime P)) → ∀ t : N, t ∈ nonZeroDivisors N → ∀ y : Localization.Away t, IsIntegral N y → ∃ b : N, algebraMap N (Localization.Away t) b = y) → (∀ (P : Ideal B0) [P.IsPrime], IsDomain (Localization.AtPrime P) ∧ IsIntegrallyClosed (Localization.AtPrime P)) → Function.Injective i → Function.Injective j → Function.Injective ι0 → ∀ f0 : R0, ι0 f0 ∈ nonZeroDivisors B0 → (∀ b : B0, ∃ (n : ℕ) (r : R0), ι0 f0 ^ n * b = ι0 r) → ∀ (g0 a0 : R0) (m : ℕ) (y : N) (P0 : Polynomial R0), P0.Monic → P0.eval₂ (j.comp i) y = 0 → j (i g0) ^ m * y = j (i a0) → i g0 ∈ nonZeroDivisors R1 → ∃ b : B0, ι0 g0 ^ m * b = ι0 a0 :=
by
  intro R0 R1 N B0 _ _ _ _ i j ι0 Hcl hBn hi hj hι f0 hf0 hbir g0 a0 m y P0 hP0 hev hy hig
  classical

  have hg0 : ∀ r : R0, g0 * r = 0 → r = 0 := by
    intro r hr
    apply hi
    rw [map_zero]
    have h1 : i g0 * i r = 0 := by rw [← map_mul, hr, map_zero]
    exact (mul_left_mem_nonZeroDivisors_eq_zero_iff hig).mp h1

  have hG : ι0 g0 ∈ nonZeroDivisors B0 := by
    have key : ∀ b : B0, ι0 g0 * b = 0 → b = 0 := by
      intro b hb
      obtain ⟨n, r, hr⟩ := hbir b
      have h1 : ι0 (g0 * r) = 0 := by
        rw [map_mul, ← hr]
        calc ι0 g0 * (ι0 f0 ^ n * b) = ι0 f0 ^ n * (ι0 g0 * b) := by ring
          _ = 0 := by rw [hb, mul_zero]
      have h2 : g0 * r = 0 := hι (by rw [h1, map_zero])
      have h3 : r = 0 := hg0 r h2
      rw [h3, map_zero] at hr
      exact (mul_left_mem_nonZeroDivisors_eq_zero_iff (pow_mem hf0 n)).mp hr
    exact mem_nonZeroDivisors_iff_left.mpr key

  have hhinj : Function.Injective (j.comp i) := hj.comp hi
  have hQ : Polynomial.eval a0 (P0.scaleRoots (g0 ^ m)) = 0 := by
    have e1 := Polynomial.scaleRoots_eval₂_eq_zero (j.comp i) (s := g0 ^ m) hev
    have e2 : (j.comp i) (g0 ^ m) * y = (j.comp i) a0 := by
      rw [RingHom.comp_apply, RingHom.comp_apply, map_pow, map_pow]; exact hy
    rw [e2, Polynomial.eval₂_at_apply] at e1
    exact hhinj (by rw [e1, map_zero])

  obtain ⟨w, huw⟩ : ∃ w : Localization.Away (ι0 g0),
      algebraMap B0 (Localization.Away (ι0 g0)) (ι0 g0) * w = 1 :=
    ⟨IsLocalization.Away.invSelf (ι0 g0), IsLocalization.Away.mul_invSelf (ι0 g0)⟩
  set u := algebraMap B0 (Localization.Away (ι0 g0)) with hu
  set z : Localization.Away (ι0 g0) := u (ι0 a0) * w ^ m with hzdef
  have hz : u (ι0 g0) ^ m * z = u (ι0 a0) := by
    calc u (ι0 g0) ^ m * z = u (ι0 a0) * (u (ι0 g0) * w) ^ m := by rw [hzdef]; ring
      _ = u (ι0 a0) := by rw [huw, one_pow, mul_one]
  have hzev : Polynomial.eval₂ (u.comp ι0) z P0 = 0 := by
    have e1 := Polynomial.scaleRoots_eval₂_mul (p := P0) (u.comp ι0) z (g0 ^ m)
    have e2 : (u.comp ι0) (g0 ^ m) * z = (u.comp ι0) a0 := by
      rw [RingHom.comp_apply, RingHom.comp_apply, map_pow, map_pow]; exact hz
    rw [e2, Polynomial.eval₂_at_apply, hQ, map_zero] at e1
    have hunit : IsUnit ((u.comp ι0) (g0 ^ m) ^ P0.natDegree) := by
      apply IsUnit.pow
      rw [RingHom.comp_apply, map_pow, map_pow]
      exact (show IsUnit (u (ι0 g0)) from
        ⟨⟨u (ι0 g0), w, huw, by rw [mul_comm]; exact huw⟩, rfl⟩).pow _
    exact hunit.mul_right_eq_zero.mp e1.symm
  have hzint : IsIntegral B0 z :=
    ⟨P0.map ι0, hP0.map ι0, by rw [Polynomial.eval₂_map]; exact hzev⟩

  obtain ⟨b, hb⟩ := Hcl B0 hBn (ι0 g0) hG z hzint
  refine ⟨b, ?_⟩
  have hinj : Function.Injective u :=
    IsLocalization.injective (Localization.Away (ι0 g0)) (M := Submonoid.powers (ι0 g0))
      (Submonoid.powers_le.mpr hG)
  apply hinj
  rw [map_mul, map_pow, hb]
  exact hz

theorem wcfd_tn_tg_basechange_birational : ∀ (k L R0 B0 : Type u) [Field k] [Field L] [Algebra k L] [CommRing R0] [CommRing B0] [Algebra k R0] [Algebra k B0] (ι0 : R0 →ₐ[k] B0), Function.Injective ι0 → ι0.toRingHom.Finite → ∀ f0 : R0, f0 ∈ nonZeroDivisors R0 → ι0 f0 ∈ nonZeroDivisors B0 → (∀ b : B0, ∃ (n : ℕ) (r : R0), ι0 f0 ^ n * b = ι0 r) → Function.Injective (Algebra.TensorProduct.map (AlgHom.id k L) ι0) ∧ (Algebra.TensorProduct.map (AlgHom.id k L) ι0).toRingHom.Finite ∧ ((1 : L) ⊗ₜ[k] f0) ∈ nonZeroDivisors (TensorProduct k L R0) ∧ ((1 : L) ⊗ₜ[k] ι0 f0) ∈ nonZeroDivisors (TensorProduct k L B0) ∧ ∀ t : TensorProduct k L B0, ∃ (n : ℕ) (w : TensorProduct k L R0), ((1 : L) ⊗ₜ[k] ι0 f0) ^ n * t = Algebra.TensorProduct.map (AlgHom.id k L) ι0 w :=
by
  classical
  intro k L R0 B0 _ _ _ _ _ _ _ ι0 H1 H2 f0 H3 H4 H5
  have hflatinj : ∀ (N P : Type u) [AddCommGroup N] [Module k N] [AddCommGroup P] [Module k P]
      (g : N →ₗ[k] P), Function.Injective g → Function.Injective (LinearMap.lTensor L g) :=
    fun N P _ _ _ _ g hg => Module.Flat.lTensor_preserves_injective_linearMap g hg
  have hμ : ∀ z : TensorProduct k L R0, Algebra.TensorProduct.map (AlgHom.id k L) ι0 z =
      LinearMap.lTensor L ι0.toLinearMap z := by
    intro z
    induction z using TensorProduct.induction_on with
    | zero => simp
    | tmul l r => simp [Algebra.TensorProduct.map_tmul, LinearMap.lTensor_tmul]
    | add x y hx hy => rw [map_add, map_add, hx, hy]
  have C1 : Function.Injective (Algebra.TensorProduct.map (AlgHom.id k L) ι0) := by
    have h := hflatinj R0 B0 ι0.toLinearMap H1
    intro x y hxy
    apply h
    rw [← hμ, ← hμ, hxy]
  have C2 : (Algebra.TensorProduct.map (AlgHom.id k L) ι0).toRingHom.Finite :=
    RingHom.Finite.tensorProductMap (AlgHom.Finite.id k L) H2
  have hnzd : ∀ (S : Type u) [CommRing S] [Algebra k S] (s : S), s ∈ nonZeroDivisors S →
      ((1 : L) ⊗ₜ[k] s) ∈ nonZeroDivisors (TensorProduct k L S) := by
    intro S _ _ s hs
    have hinj : Function.Injective (LinearMap.mulLeft k s) := by
      rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
      intro x hx
      rw [LinearMap.mulLeft_apply, mul_comm] at hx
      exact (mem_nonZeroDivisors_iff_right.mp hs) x hx
    have hid : ∀ z : TensorProduct k L S, ((1 : L) ⊗ₜ[k] s) * z =
        LinearMap.lTensor L (LinearMap.mulLeft k s) z := by
      intro z
      induction z using TensorProduct.induction_on with
      | zero => simp
      | tmul l x => simp [Algebra.TensorProduct.tmul_mul_tmul, LinearMap.lTensor_tmul]
      | add x y hx hy => rw [mul_add, map_add, hx, hy]
    rw [mem_nonZeroDivisors_iff_right]
    intro x hx
    apply hflatinj S S _ hinj
    rw [← hid, map_zero, mul_comm, hx]
  have C3 := hnzd R0 f0 H3
  have C4 := hnzd B0 (ι0 f0) H4
  have hμa : Algebra.TensorProduct.map (AlgHom.id k L) ι0 ((1 : L) ⊗ₜ[k] f0) =
      (1 : L) ⊗ₜ[k] ι0 f0 := by
    rw [Algebra.TensorProduct.map_tmul]; rfl
  have C5 : ∀ t : TensorProduct k L B0, ∃ (n : ℕ) (w : TensorProduct k L R0),
      ((1 : L) ⊗ₜ[k] ι0 f0) ^ n * t = Algebra.TensorProduct.map (AlgHom.id k L) ι0 w := by
    intro t
    induction t using TensorProduct.induction_on with
    | zero => exact ⟨0, 0, by simp⟩
    | tmul l b =>
      obtain ⟨n, r, hr⟩ := H5 b
      refine ⟨n, l ⊗ₜ[k] r, ?_⟩
      rw [Algebra.TensorProduct.tmul_pow, one_pow, Algebra.TensorProduct.tmul_mul_tmul, one_mul,
        hr, Algebra.TensorProduct.map_tmul]
      rfl
    | add x y hx hy =>
      obtain ⟨n1, w1, h1⟩ := hx
      obtain ⟨n2, w2, h2⟩ := hy
      refine ⟨n1 + n2, ((1 : L) ⊗ₜ[k] f0) ^ n2 * w1 + ((1 : L) ⊗ₜ[k] f0) ^ n1 * w2, ?_⟩
      rw [map_add, map_mul, map_mul, map_pow, map_pow, hμa, ← h1, ← h2]
      ring
  exact ⟨C1, C2, C3, C4, C5⟩

theorem wcfd_tn_twist_geom_normal : (∀ (L R : Type u) [Field L] [PerfectField L] [CommRing R] [Algebra L R] [Algebra.FiniteType L R] [_root_.IsReduced R], ∃ (N : Type u) (_ : CommRing N) (j : R →+* N), Function.Injective j ∧ j.Finite ∧ (∀ (P : Ideal N) [P.IsPrime], IsDomain (Localization.AtPrime P) ∧ IsIntegrallyClosed (Localization.AtPrime P)) ∧ ∃ g : R, g ∈ nonZeroDivisors R ∧ j g ∈ nonZeroDivisors N ∧ Function.Bijective (Localization.awayMap j g)) → (∀ (N : Type u) [CommRing N], (∀ (P : Ideal N) [P.IsPrime], IsDomain (Localization.AtPrime P) ∧ IsIntegrallyClosed (Localization.AtPrime P)) → ∀ t : N, t ∈ nonZeroDivisors N → ∀ y : Localization.Away t, IsIntegral N y → ∃ b : N, algebraMap N (Localization.Away t) b = y) → ∀ (K : Type u) [Field K] [IsAlgClosed K] (A D : CommRingCat.{u}) [IsDomain A] (κ : CommRingCat.of K ⟶ A) (α : A ⟶ D), κ.hom.FiniteType → α.hom.FiniteType → ∃ e₀ : ℕ, ∀ e : ℕ, e₀ ≤ e → ∀ (φ : A ⟶ A), (∀ a : A, φ.hom a = a ^ (ringExpChar K ^ e)) → ∀ (C : CommRingCat.{u}) (γ : D ⟶ C) (β : A ⟶ C), IsPushout α φ γ β → ∀ (C' : CommRingCat.{u}) (ρ : C ⟶ C'), Function.Surjective ρ.hom → RingHom.ker ρ.hom = nilradical C → ∀ (B : CommRingCat.{u}) (ι : C' ⟶ B), Function.Injective ι.hom → ι.hom.Finite → (∀ (Q : Ideal B) [Q.IsPrime], IsDomain (Localization.AtPrime Q) ∧ IsIntegrallyClosed (Localization.AtPrime Q)) → (∃ f : C', f ∈ nonZeroDivisors C' ∧ ι.hom f ∈ nonZeroDivisors B ∧ Function.Bijective (Localization.awayMap ι.hom f)) → letI := (β ≫ ρ ≫ ι).hom.toAlgebra; letI : Algebra (FractionRing A) (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors A))) := localizationAlgebra (nonZeroDivisors A) B; wcfdTnLocNormal (TensorProduct (FractionRing A) (perfectClosure (FractionRing A) (AlgebraicClosure (FractionRing A))) (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors A)))) :=
by
  intro Hpkg Hcl K _ _ A D _ κ α hκ hα
  have untw : ∀ (L W : Type u) [Field L] [PerfectField L] [CommRing W] [Algebra L W]
      [Algebra.FiniteType L W], ∃ Λ : Finset W, ∀ (k : Type u) [Field k] [Algebra k L]
      (S S' Bm : Type u) [CommRing S] [CommRing S'] [CommRing Bm] [Algebra k S] [Algebra k S']
      [Algebra k Bm] (ρS : S →ₐ[k] S') (ιM : S' →ₐ[k] Bm), Function.Surjective ρS →
      RingHom.ker ρS = nilradical S → Function.Injective ιM → ιM.toRingHom.Finite →
      wcfdTnLocNormal Bm → ∀ f0 : S', f0 ∈ nonZeroDivisors S' → ιM f0 ∈ nonZeroDivisors Bm →
      (∀ b : Bm, ∃ (n : ℕ) (r : S'), ιM f0 ^ n * b = ιM r) →
      ∀ Θ : TensorProduct k L S ≃+* W, (∀ z ∈ Λ, ∃ c : S, Θ ((1 : L) ⊗ₜ[k] c) = z) →
      wcfdTnLocNormal (TensorProduct k L Bm) := by
    intro L W _ _ _ _ _
    classical
    have nzd_equiv : ∀ {X Y : Type u} [CommRing X] [CommRing Y] (e : X ≃+* Y) (a : X),
        a ∈ nonZeroDivisors X → e a ∈ nonZeroDivisors Y := by
      intro X Y _ _ e a ha
      rw [mem_nonZeroDivisors_iff_right] at ha ⊢
      intro x hx
      have h1 : e.symm x * a = 0 := by
        apply e.injective
        rw [map_mul, RingEquiv.apply_symm_apply, map_zero, hx]
      rw [← e.apply_symm_apply x, ha _ h1, map_zero]
    haveI : IsNoetherianRing W := Algebra.FiniteType.isNoetherianRing L W
    obtain ⟨r, ν, hν⟩ : ∃ (r : ℕ) (ν : Fin r → W), Ideal.span (Set.range ν) = nilradical W := by
      obtain ⟨r, ν, h⟩ :=
        Submodule.fg_iff_exists_fin_generating_family.mp (IsNoetherian.noetherian (nilradical W))
      exact ⟨r, ν, h⟩
    haveI : _root_.IsReduced (W ⧸ nilradical W) :=
      (Ideal.isRadical_iff_quotient_reduced _).mp (Ideal.radical_isRadical _)
    obtain ⟨N, _, j, hjinj, hjfin, hLN, g, hgR, hgN, hbij⟩ := Hpkg L (W ⧸ nilradical W)

    obtain ⟨s, y, hgen⟩ : ∃ (s : ℕ) (y : Fin s → N),
        ∀ z : N, ∃ c : Fin s → W ⧸ nilradical W, z = ∑ l, j (c l) * y l := by
      letI := j.toAlgebra
      haveI : Module.Finite (W ⧸ nilradical W) N := hjfin
      obtain ⟨s, y, hy⟩ := Module.Finite.exists_fin (R := W ⧸ nilradical W) (M := N)
      refine ⟨s, y, fun z => ?_⟩
      have hz : z ∈ Submodule.span (W ⧸ nilradical W) (Set.range y) := by rw [hy]; trivial
      obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun (W ⧸ nilradical W)).mp hz
      exact ⟨c, by rw [← hc]; rfl⟩

    have hbirN : ∀ z : N, ∃ (n : ℕ) (r : W ⧸ nilradical W), j g ^ n * z = j r := by
      intro z
      obtain ⟨x, hx⟩ := hbij.2 (algebraMap N (Localization.Away (j g)) z)
      obtain ⟨⟨r, ⟨_, n, rfl⟩⟩, hr⟩ := IsLocalization.surj (Submonoid.powers g) x
      have hmap : ∀ w : W ⧸ nilradical W, Localization.awayMap j g
          (algebraMap _ (Localization.Away g) w) = algebraMap N (Localization.Away (j g)) (j w) :=
        fun w => IsLocalization.map_eq _ _
      have h2 := congrArg (Localization.awayMap j g) hr
      simp only at h2
      rw [map_mul, hx, hmap, hmap, ← map_mul] at h2
      obtain ⟨⟨c, ⟨m, rfl⟩⟩, hc⟩ := (IsLocalization.eq_iff_exists (Submonoid.powers (j g)) _).mp h2
      have hcm : (j g) ^ m ∈ nonZeroDivisors N := pow_mem hgN m
      simp only at hc
      rw [mul_cancel_left_mem_nonZeroDivisors hcm, map_pow] at hc
      exact ⟨n, r, by rw [mul_comm]; exact hc⟩
    choose m a ha using fun l => hbirN (y l)
    choose P hPm hP using fun l => hjfin.to_isIntegral (y l)
    choose lift hlift using fun u : W ⧸ nilradical W => Ideal.Quotient.mk_surjective u
    let Λ1 : Finset W := {lift g}
    let Λ2 : Finset W := Finset.univ.image (fun l => lift (a l))
    let Λ3 : Finset W := Finset.univ.biUnion
      (fun l => (Finset.range ((P l).natDegree + 1)).image (fun n => lift ((P l).coeff n)))
    let Λ4 : Finset W := Finset.univ.image ν
    have hΛg : lift g ∈ Λ1 ∪ Λ2 ∪ Λ3 ∪ Λ4 :=
      Finset.mem_union_left _ (Finset.mem_union_left _ (Finset.mem_union_left _
        (Finset.mem_singleton_self _)))
    have hΛa : ∀ l, lift (a l) ∈ Λ1 ∪ Λ2 ∪ Λ3 ∪ Λ4 := fun l =>
      Finset.mem_union_left _ (Finset.mem_union_left _ (Finset.mem_union_right _
        (Finset.mem_image_of_mem _ (Finset.mem_univ l))))
    have hΛc : ∀ l n, n ≤ (P l).natDegree → lift ((P l).coeff n) ∈ Λ1 ∪ Λ2 ∪ Λ3 ∪ Λ4 :=
      fun l n hn => Finset.mem_union_left _ (Finset.mem_union_right _ (Finset.mem_biUnion.mpr
        ⟨l, Finset.mem_univ _, Finset.mem_image_of_mem _ (Finset.mem_range.mpr (Nat.lt_succ_of_le hn))⟩))
    have hΛν : ∀ l, ν l ∈ Λ1 ∪ Λ2 ∪ Λ3 ∪ Λ4 := fun l =>
      Finset.mem_union_right _ (Finset.mem_image_of_mem _ (Finset.mem_univ l))
    refine ⟨Λ1 ∪ Λ2 ∪ Λ3 ∪ Λ4, ?_⟩
    intro k _ _ S S' Bm _ _ _ _ _ _ ρS ιM hρs hρk hιi hιf hBn f0 hf0 hιf0 hbir Θ hΘ

    obtain ⟨Θ', hΘ'⟩ := wcfd_tn_tg_nil_stable k L S S' W ρS hρs hρk Θ r ν hν
      (fun l => hΘ (ν l) (hΛν l))
    let i : S' →+* W ⧸ nilradical W :=
      Θ'.toRingHom.comp (Algebra.TensorProduct.includeRight : S' →ₐ[k] TensorProduct k L S').toRingHom
    have hi : ∀ c' : S', i c' = Θ' ((1 : L) ⊗ₜ[k] c') := fun c' => rfl
    have hiinj : Function.Injective i :=
      Θ'.injective.comp (Algebra.TensorProduct.includeRight_injective (algebraMap k L).injective)
    have hrange : ∀ z ∈ Λ1 ∪ Λ2 ∪ Λ3 ∪ Λ4, ∃ c' : S', i c' = Ideal.Quotient.mk (nilradical W) z := by
      intro z hz
      obtain ⟨c, hc⟩ := hΘ z hz
      exact ⟨ρS c, by rw [hi, hΘ', hc]⟩

    obtain ⟨hμi, hμf, hf0L, hιf0L, hbirL⟩ :=
      wcfd_tn_tg_basechange_birational k L S' Bm ιM hιi hιf f0 hf0 hιf0 hbir
    let iT : W ⧸ nilradical W →+* TensorProduct k L Bm :=
      (Algebra.TensorProduct.map (AlgHom.id k L) ιM).toRingHom.comp Θ'.symm.toRingHom
    have hiT : ∀ c' : S', iT (i c') = (1 : L) ⊗ₜ[k] ιM c' := by
      intro c'
      change Algebra.TensorProduct.map (AlgHom.id k L) ιM (Θ'.symm (Θ' ((1 : L) ⊗ₜ[k] c'))) = _
      rw [RingEquiv.symm_apply_apply, Algebra.TensorProduct.map_tmul]
      rfl
    have hiTinj : Function.Injective iT := hμi.comp Θ'.symm.injective
    have hiTint : iT.IsIntegral :=
      (RingHom.Finite.comp hμf (RingHom.Finite.of_surjective _ Θ'.symm.surjective)).to_isIntegral
    have hfR : i f0 ∈ nonZeroDivisors (W ⧸ nilradical W) := nzd_equiv Θ' _ hf0L
    have hiTfR : iT (i f0) ∈ nonZeroDivisors (TensorProduct k L Bm) := by
      rw [hiT]; exact hιf0L
    have hbirT : ∀ t : TensorProduct k L Bm, ∃ (n : ℕ) (r : W ⧸ nilradical W),
        iT (i f0) ^ n * t = iT r := by
      intro t
      obtain ⟨n, w, hw⟩ := hbirL t
      refine ⟨n, Θ' w, ?_⟩
      rw [hiT, hw]
      change _ = Algebra.TensorProduct.map (AlgHom.id k L) ιM (Θ'.symm (Θ' w))
      rw [RingEquiv.symm_apply_apply]

    have hPlift : ∀ l, ∃ P0 : Polynomial S', P0.Monic ∧ P0.map i = P l := by
      intro l
      have hl : P l ∈ Polynomial.lifts i := by
        rw [Polynomial.lifts_iff_coeff_lifts]
        intro n
        by_cases hn : n ≤ (P l).natDegree
        · obtain ⟨c', hc'⟩ := hrange _ (hΛc l n hn)
          exact ⟨c', by rw [hc', hlift]⟩
        · exact ⟨0, by rw [map_zero, Polynomial.coeff_eq_zero_of_natDegree_lt (not_le.mp hn)]⟩
      obtain ⟨P0, hmap, -, hmon⟩ := Polynomial.lifts_and_natDegree_eq_and_monic hl (hPm l)
      exact ⟨P0, hmon, hmap⟩

    have hmatch : ∀ l, ∃ (t : TensorProduct k L Bm) (n : ℕ) (r : W ⧸ nilradical W),
        j g ^ n * y l = j r ∧ iT g ^ n * t = iT r := by
      intro l
      obtain ⟨g'', hg''⟩ := hrange _ hΛg
      rw [hlift] at hg''
      obtain ⟨a'', ha''⟩ := hrange _ (hΛa l)
      rw [hlift] at ha''
      obtain ⟨P0, hP0m, hP0⟩ := hPlift l
      have hev : P0.eval₂ (j.comp i) (y l) = 0 := by
        rw [← Polynomial.eval₂_map, hP0]; exact hP l
      have hgi : i g'' ∈ nonZeroDivisors (W ⧸ nilradical W) := by rw [hg'']; exact hgR
      obtain ⟨b, hb⟩ := wcfd_tn_tg_matching S' (W ⧸ nilradical W) N Bm i j ιM.toRingHom Hcl hBn
        hiinj hjinj hιi f0 hιf0 hbir g'' a'' (m l) (y l) P0 hP0m hev
        (by rw [hg'', ha'']; exact ha l) hgi
      refine ⟨(1 : L) ⊗ₜ[k] b, m l, a l, ha l, ?_⟩
      rw [← hg'', ← ha'', hiT, hiT, Algebra.TensorProduct.tmul_pow, one_pow,
        Algebra.TensorProduct.tmul_mul_tmul, one_mul]
      congr 1

    exact wcfd_tn_tg_comparison (W ⧸ nilradical W) (TensorProduct k L Bm) N Hcl hLN iT j
      hiTinj hiTint hjinj (i f0) g hfR hiTfR hgN hbirT hbirN s y hgen hmatch
  have key : ∀ (L : Type u) [Field L] [PerfectField L] [Algebra (FractionRing A) L] [Algebra A L]
      [IsScalarTower A (FractionRing A) L] (q : ℕ) [ExpChar L q],
      (∀ y : L, ∃ n : ℕ, y ^ (q ^ n) ∈ (algebraMap (FractionRing A) L).range) →
      ∃ e₀ : ℕ, ∀ e : ℕ, e₀ ≤ e → ∀ (φ : A ⟶ A), (∀ a : A, φ.hom a = a ^ (q ^ e)) →
      ∀ (C : CommRingCat.{u}) (γ : D ⟶ C) (β : A ⟶ C), IsPushout α φ γ β →
      ∀ (C' : CommRingCat.{u}) (ρ : C ⟶ C'), Function.Surjective ρ.hom →
      RingHom.ker ρ.hom = nilradical C → ∀ (B : CommRingCat.{u}) (ι : C' ⟶ B),
      Function.Injective ι.hom → ι.hom.Finite →
      (∀ (Q : Ideal B) [Q.IsPrime], IsDomain (Localization.AtPrime Q) ∧
        IsIntegrallyClosed (Localization.AtPrime Q)) →
      (∃ f : C', f ∈ nonZeroDivisors C' ∧ ι.hom f ∈ nonZeroDivisors B ∧
        Function.Bijective (Localization.awayMap ι.hom f)) →
      letI := (β ≫ ρ ≫ ι).hom.toAlgebra
      letI : Algebra (FractionRing A) (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors A))) :=
        localizationAlgebra (nonZeroDivisors A) B
      wcfdTnLocNormal (TensorProduct (FractionRing A) L
        (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors A)))) := by
    intro L _ _ _ _ _ q _ hL
    haveI : PerfectRing L q := PerfectField.toPerfectRing q
    letI := α.hom.toAlgebra
    haveI : Algebra.FiniteType A D := hα
    haveI : Algebra.FiniteType L (TensorProduct A L D) := Algebra.FiniteType.baseChange L
    obtain ⟨Λ, hΛ⟩ := untw L (TensorProduct A L D)

    let G : ℕ → Set (TensorProduct A L D) := fun e =>
      {z | ∃ (y : L) (d : D), z = y ⊗ₜ[A] d ∧ y ^ (q ^ e) ∈ (algebraMap (FractionRing A) L).range}
    have mono : ∀ e e' : ℕ, e ≤ e' → AddSubmonoid.closure (G e) ≤ AddSubmonoid.closure (G e') := by
      intro e e' hee'
      apply AddSubmonoid.closure_mono
      rintro z ⟨y, d, rfl, hy⟩
      refine ⟨y, d, rfl, ?_⟩
      have h1 : y ^ (q ^ e') = (y ^ (q ^ e)) ^ (q ^ (e' - e)) := by
        rw [← pow_mul, ← pow_add, Nat.add_sub_cancel' hee']
      rw [h1]
      exact Subring.pow_mem _ hy _
    have each : ∀ z : TensorProduct A L D, ∃ n : ℕ, z ∈ AddSubmonoid.closure (G n) := by
      intro z
      induction z using TensorProduct.induction_on with
      | zero => exact ⟨0, AddSubmonoid.zero_mem _⟩
      | tmul y d =>
        obtain ⟨n, hn⟩ := hL y
        exact ⟨n, AddSubmonoid.subset_closure ⟨y, d, rfl, hn⟩⟩
      | add x x' hx hx' =>
        obtain ⟨n, hn⟩ := hx
        obtain ⟨n', hn'⟩ := hx'
        exact ⟨max n n', AddSubmonoid.add_mem _ (mono _ _ (le_max_left _ _) hn)
          (mono _ _ (le_max_right _ _) hn')⟩
    choose nz hnz using each
    refine ⟨Λ.sup nz, ?_⟩
    intro e he φ hφ C γ β hpush C' ρ hρ hker B ι hinj hfin hnorm hN3
    obtain ⟨f, hf1, hf2, hf3⟩ := hN3
    obtain ⟨ρM, ιM, f0, hρs, hρk, hιi, hιf, hBn, hf0, hιf0, hbir⟩ :=
      wcfd_tn_tg_localize_package A C C' B β ρ ι hρ hker hinj hfin hnorm f hf1 hf2 hf3
    obtain ⟨Θ, hΘ⟩ := wcfd_tn_tg_twist_iso A D C α φ γ β hpush L q e hφ
    have hrat : ∀ x ∈ AddSubmonoid.closure (G e), ∃ c, Θ ((1 : L) ⊗ₜ c) = x := by
      intro x hx
      induction hx using AddSubmonoid.closure_induction with
      | mem x hx =>
        obtain ⟨y, d, rfl, hy⟩ := hx
        exact hΘ y d hy
      | zero => exact ⟨0, by rw [TensorProduct.tmul_zero, map_zero]⟩
      | add x x' _ _ hx hx' =>
        obtain ⟨c, hc⟩ := hx
        obtain ⟨c', hc'⟩ := hx'
        exact ⟨c + c', by rw [TensorProduct.tmul_add, map_add, hc, hc']⟩
    refine hΛ (FractionRing A) _ _ _ ρM ιM hρs hρk hιi hιf hBn f0 hf0 hιf0 hbir Θ ?_
    intro z hz
    exact hrat z (mono _ _ (le_trans (Finset.le_sup hz) he) (hnz z))

  haveI : ExpChar K (ringExpChar K) := ringExpChar.expChar K
  have hκi : Function.Injective κ.hom := κ.hom.injective
  haveI : ExpChar A (ringExpChar K) := expChar_of_injective_ringHom hκi _
  haveI : ExpChar (FractionRing A) (ringExpChar K) :=
    expChar_of_injective_ringHom (IsFractionRing.injective A (FractionRing A)) _
  haveI : ExpChar (perfectClosure (FractionRing A) (AlgebraicClosure (FractionRing A))) (ringExpChar K) :=
    expChar_of_injective_ringHom
      (algebraMap (FractionRing A) (perfectClosure (FractionRing A) (AlgebraicClosure (FractionRing A)))).injective _
  haveI : PerfectField (AlgebraicClosure (FractionRing A)) := IsAlgClosed.perfectField _
  haveI : PerfectField (perfectClosure (FractionRing A) (AlgebraicClosure (FractionRing A))) :=
    perfectClosure.perfectField _ _
  have hk : ringExpChar (FractionRing A) = ringExpChar K := ringExpChar.eq _ _
  have hL : ∀ y : perfectClosure (FractionRing A) (AlgebraicClosure (FractionRing A)), ∃ n : ℕ,
      y ^ (ringExpChar K ^ n) ∈ (algebraMap (FractionRing A)
        (perfectClosure (FractionRing A) (AlgebraicClosure (FractionRing A)))).range := by
    intro y
    obtain ⟨n, x, hx⟩ := mem_perfectClosure_iff.mp y.2
    refine ⟨n, x, ?_⟩
    apply Subtype.ext
    rw [← hk]
    simpa using hx
  exact key _ (ringExpChar K) hL

theorem wcfd_tn_generic_finiteType : ∀ (A D : CommRingCat.{u}) [IsDomain A] (α : A ⟶ D), α.hom.FiniteType → ∀ (φ : A ⟶ A) (C : CommRingCat.{u}) (γ : D ⟶ C) (β : A ⟶ C), IsPushout α φ γ β → ∀ (C' : CommRingCat.{u}) (ρ : C ⟶ C'), Function.Surjective ρ.hom → ∀ (B : CommRingCat.{u}) (ι : C' ⟶ B), ι.hom.Finite → letI := (β ≫ ρ ≫ ι).hom.toAlgebra; letI : Algebra (FractionRing A) (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors A))) := localizationAlgebra (nonZeroDivisors A) B; Algebra.FiniteType (FractionRing A) (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors A))) :=
by
  intro A D _ α hα φ C γ β hpush C' ρ hρ B ι hι
  have h1 : (Limits.pushout.inl φ α).hom.FiniteType :=
    RingHom.IsStableUnderBaseChange.pushout_inl RingHom.finiteType_isStableUnderBaseChange
      RingHom.finiteType_respectsIso φ α hα
  have h2 : β.hom.FiniteType := by
    have e : Limits.pushout.inl φ α ≫ hpush.flip.isoPushout.inv = β :=
      hpush.flip.inl_isoPushout_inv
    rw [← e, CommRingCat.hom_comp]
    exact RingHom.FiniteType.comp
      (RingHom.FiniteType.of_surjective _ (ConcreteCategory.bijective_of_isIso _).2) h1
  have h3 : (β ≫ ρ ≫ ι).hom.FiniteType := by
    rw [CommRingCat.hom_comp, CommRingCat.hom_comp]
    exact RingHom.FiniteType.comp
      (RingHom.FiniteType.comp hι.finiteType (RingHom.FiniteType.of_surjective _ hρ)) h2
  letI : Algebra A B := (β ≫ ρ ≫ ι).hom.toAlgebra
  letI : Algebra (FractionRing A)
      (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors A))) :=
    localizationAlgebra (nonZeroDivisors A) B
  haveI hloc : IsLocalization (Submonoid.map (algebraMap A B) (nonZeroDivisors A))
      (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors A))) :=
    Localization.isLocalization
  have h4 := RingHom.finiteType_localizationPreserves (algebraMap A B) (nonZeroDivisors A)
    (FractionRing A) (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors A))) h3
  exact RingHom.finiteType_algebraMap.mp h4

theorem wcfd_gst_twist_normalization_smooth_alg : ∀ (K : Type u) [Field K] [IsAlgClosed K] (A D : CommRingCat.{u}) [IsDomain A] (κ : CommRingCat.of K ⟶ A) (α : A ⟶ D), κ.hom.FiniteType → α.hom.FiniteType → (letI := α.hom.toAlgebra; ringKrullDim (TensorProduct A D (AlgebraicClosure (FractionRing A))) ≤ 1) → ∃ e₀ : ℕ, ∀ e : ℕ, e₀ ≤ e → ∀ (φ : A ⟶ A), (∀ a : A, φ.hom a = a ^ (ringExpChar K ^ e)) → ∀ (C : CommRingCat.{u}) (γ : D ⟶ C) (β : A ⟶ C), IsPushout α φ γ β → ∀ (C' : CommRingCat.{u}) (ρ : C ⟶ C'), Function.Surjective ρ.hom → RingHom.ker ρ.hom = nilradical C → ∀ (B : CommRingCat.{u}) (ι : C' ⟶ B), Function.Injective ι.hom → ι.hom.Finite → (∀ (Q : Ideal B) [Q.IsPrime], IsDomain (Localization.AtPrime Q) ∧ IsIntegrallyClosed (Localization.AtPrime Q)) → (∃ f : C', f ∈ nonZeroDivisors C' ∧ ι.hom f ∈ nonZeroDivisors B ∧ Function.Bijective (Localization.awayMap ι.hom f)) → ∀ (τ : A ⟶ B), τ = β ≫ ρ ≫ ι → ∀ (Q : Ideal B) [Q.IsPrime] (hQ : (⊥ : Ideal A) = Q.comap τ.hom), (Localization.localRingHom ⊥ Q τ.hom hQ).FormallySmooth :=
by
  intro K _ _ A D _ κ α hκ hα hdim
  obtain ⟨e₀, he₀⟩ := wcfd_tn_twist_geom_normal wcfd_tn_perfect_normalization_package
    wcfd_tn_locally_normal_away_closed K A D κ α hκ hα
  refine ⟨e₀, ?_⟩
  intro e he φ hφ C γ β hpush C' ρ hρ hker B ι hinj hfin hnorm hN3 τ hτ Q _ hQ
  subst hτ
  letI : Algebra A B := (β ≫ ρ ≫ ι).hom.toAlgebra
  letI : Algebra (FractionRing A)
      (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors A))) :=
    localizationAlgebra (nonZeroDivisors A) B
  have hN := he₀ e he φ hφ C γ β hpush C' ρ hρ hker B ι hinj hfin hnorm hN3
  have hd := wcfd_tn_twist_dim_le_one K A D κ α hdim e φ hφ C γ β hpush C' ρ hρ B ι hfin
  haveI hft := wcfd_tn_generic_finiteType A D α hα φ C γ β hpush C' ρ hρ B ι hfin
  haveI : PerfectField (AlgebraicClosure (FractionRing A)) := IsAlgClosed.perfectField _
  haveI : PerfectField (perfectClosure (FractionRing A) (AlgebraicClosure (FractionRing A))) :=
    perfectClosure.perfectField _ _
  haveI : Algebra.FiniteType (perfectClosure (FractionRing A) (AlgebraicClosure (FractionRing A)))
      (TensorProduct (FractionRing A)
        (perfectClosure (FractionRing A) (AlgebraicClosure (FractionRing A)))
        (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors A)))) :=
    Algebra.FiniteType.baseChange _
  have hsm := wcfd_tn_perfect_normal_dim_le_one_smooth
    (perfectClosure (FractionRing A) (AlgebraicClosure (FractionRing A)))
    (TensorProduct (FractionRing A)
        (perfectClosure (FractionRing A) (AlgebraicClosure (FractionRing A)))
        (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors A)))) hN hd
  have hk := wcfd_tn_formallySmooth_descent_field (FractionRing A)
    (perfectClosure (FractionRing A) (AlgebraicClosure (FractionRing A)))
    (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors A))) hsm
  exact wcfd_tn_stalk_of_generic_smooth A B hk Q hQ

theorem wcfd_generic_fibre_smooth_twist : ∀ (K : Type u) [Field K] [IsAlgClosed K] (S X : Scheme.{u}) (fS : S ⟶ Spec (.of K)) [IsProper fS] [IsIntegral S] (g : X ⟶ S) [IsProper g], (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (t : Spec (.of Ω) ⟶ S), topologicalKrullDim ↥(Limits.pullback g t) ≤ ((1 : ℕ) : WithBot ℕ∞)) → ∃ e : ℕ, ∀ (Φ : S ⟶ S), IsFinite Φ → (∀ x : S, Φ x = x) → (∀ (U : S.Opens) (hU : U ≤ Φ ⁻¹ᵁ U) (s : Γ(S, U)), (Φ.appLE U U hU).hom s = s ^ (ringExpChar K ^ e)) → ∀ (R : Scheme.{u}) (r : R ⟶ Limits.pullback g Φ), IsClosedImmersion r → Set.range r = Set.univ → IsReduced R → ∀ (Xt : Scheme.{u}) (b : Xt ⟶ R) (Z : Scheme.{u}) (iZ : Z ⟶ R), IsFinite b → IsClosedImmersion iZ → (∀ U : R.Opens, (U : Set R) = (Set.range iZ)ᶜ → IsIso (b ∣_ U)) → (∀ x : Xt, IsDomain (Xt.presheaf.stalk x) ∧ IsIntegrallyClosed (Xt.presheaf.stalk x)) → (∀ z : Z, ∃ y : R, y ⤳ iZ z ∧ y ≠ iZ z) → (∀ x : Xt, ∃ x' : Xt, x' ⤳ x ∧ b x' ∉ Set.range iZ) → ∀ x : Xt, (b ≫ r ≫ Limits.pullback.snd g Φ) x = genericPoint S → (Scheme.Hom.stalkMap (b ≫ r ≫ Limits.pullback.snd g Φ) x).hom.FormallySmooth :=
by
  intro K _ _ S X fS _ _ g _ HDIM
  classical
  obtain ⟨V, hVaff, hηV, -⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp
    (Scheme.isBasis_affineOpens S)) (show genericPoint S ∈ (⊤ : S.Opens) from trivial)
  have hV : IsAffineOpen V := hVaff
  haveI : Nonempty V := ⟨⟨genericPoint S, hηV⟩⟩
  have hleK : V ≤ fS ⁻¹ᵁ ⊤ := by simp
  have hκft : ((Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫ fS.appLE ⊤ V hleK).hom.FiniteType := by
    rw [CommRingCat.hom_comp]
    refine RingHom.FiniteType.comp ?_ ?_
    · exact HasRingHomProperty.appLE @LocallyOfFiniteType fS inferInstance
        ⟨⊤, isAffineOpen_top _⟩ ⟨V, hV⟩ hleK
    · apply RingHom.FiniteType.of_surjective
      intro y
      exact ⟨(Scheme.ΓSpecIso (CommRingCat.of K)).hom y, by simp⟩

  have key : ∀ U : X.Opens, ∃ e₀ : ℕ, IsAffineOpen U → ∀ hUV : U ≤ g ⁻¹ᵁ V, ∀ e : ℕ, e₀ ≤ e →
      ∀ (φ : Γ(S, V) ⟶ Γ(S, V)), (∀ a : Γ(S, V), φ.hom a = a ^ (ringExpChar K ^ e)) →
      ∀ (C : CommRingCat.{u}) (γ : Γ(X, U) ⟶ C) (β : Γ(S, V) ⟶ C),
      IsPushout (g.appLE V U hUV) φ γ β →
      ∀ (C' : CommRingCat.{u}) (ρ : C ⟶ C'), Function.Surjective ρ.hom →
      RingHom.ker ρ.hom = nilradical C →
      ∀ (B : CommRingCat.{u}) (ι : C' ⟶ B), Function.Injective ι.hom → ι.hom.Finite →
      (∀ (Q : Ideal B) [Q.IsPrime], IsDomain (Localization.AtPrime Q) ∧
        IsIntegrallyClosed (Localization.AtPrime Q)) →
      (∃ f : C', f ∈ nonZeroDivisors C' ∧ ι.hom f ∈ nonZeroDivisors B ∧
        Function.Bijective (Localization.awayMap ι.hom f)) →
      ∀ (τ : Γ(S, V) ⟶ B), τ = β ≫ ρ ≫ ι → ∀ (Q : Ideal B) [Q.IsPrime]
      (hQ : (⊥ : Ideal Γ(S, V)) = Q.comap τ.hom),
      (Localization.localRingHom ⊥ Q τ.hom hQ).FormallySmooth := by
    intro U
    by_cases hU : IsAffineOpen U ∧ U ≤ g ⁻¹ᵁ V
    · obtain ⟨hUa, hUV⟩ := hU
      have hαft : (g.appLE V U hUV).hom.FiniteType :=
        HasRingHomProperty.appLE @LocallyOfFiniteType g inferInstance ⟨V, hV⟩ ⟨U, hUa⟩ hUV
      have hdim := wcfd_gst_chart_geom_dim S X g V hV U hUa hUV
        (AlgebraicClosure (FractionRing Γ(S, V))) (HDIM _ _)
      obtain ⟨e₀, he₀⟩ := wcfd_gst_twist_normalization_smooth_alg K Γ(S, V) Γ(X, U)
        ((Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫ fS.appLE ⊤ V hleK) (g.appLE V U hUV)
        hκft hαft hdim
      exact ⟨e₀, fun _ _ => he₀⟩
    · exact ⟨0, fun hUa hUV => absurd ⟨hUa, hUV⟩ hU⟩
  choose E hE using key

  have hcpt : IsCompact ((g ⁻¹ᵁ V : X.Opens) : Set X) :=
    QuasiCompact.isCompact_preimage (V : Set S) V.isOpen hV.isCompact
  obtain ⟨s, hs, hcov⟩ := isCompact_iff_finite_and_eq_biUnion_affineOpens.mp hcpt
  refine ⟨hs.toFinset.sup (fun i => E i.1), ?_⟩
  intro Φ hΦfin hΦid hΦpow R r hr hrsurj hRred Xt b Z iZ hbfin hiZ hiso hnorm hZgen hdense x hx
  haveI := hΦfin
  haveI := hr
  haveI := hRred
  haveI := hbfin
  haveI := hiZ
  have hVV : V ≤ Φ ⁻¹ᵁ V := by
    intro z hz
    exact (Scheme.Hom.mem_preimage Φ).mpr (by rw [hΦid z]; exact hz)
  have hsnd : Limits.pullback.snd g Φ (r (b x)) = genericPoint S := hx
  have hc : (Limits.pullback.fst g Φ ≫ g) (r (b x)) = (Limits.pullback.snd g Φ ≫ Φ) (r (b x)) := by
    rw [Limits.pullback.condition]
  rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply, hsnd, hΦid] at hc
  have hy : Limits.pullback.fst g Φ (r (b x)) ∈ g ⁻¹ᵁ V :=
    (Scheme.Hom.mem_preimage g).mpr (by rw [hc]; exact hηV)
  have hy' : Limits.pullback.fst g Φ (r (b x)) ∈ (⨆ i ∈ s, (i : X.Opens)) := by
    rw [← hcov]; exact hy
  simp only [TopologicalSpace.Opens.mem_iSup] at hy'
  obtain ⟨i, hi, hyi⟩ := hy'
  have hiV : (i : X.Opens) ≤ g ⁻¹ᵁ V := by
    rw [hcov]
    exact le_iSup₂ (f := fun (j : X.affineOpens) (_ : j ∈ s) => (j : X.Opens)) i hi
  have heE : E i.1 ≤ hs.toFinset.sup (fun i => E i.1) :=
    Finset.le_sup (f := fun i => E i.1) (hs.mem_toFinset.mpr hi)

  obtain ⟨hUPaff, hpush⟩ := wcfd_gst_twist_chart_ring S X g Φ V hV hVV i.1 i.2 hiV

  obtain ⟨hURaff, hρsurj, hρker⟩ := wcfd_gst_reduced_chart_ring _ R r hrsurj
    (Limits.pullback.fst g Φ ⁻¹ᵁ i.1 ⊓ Limits.pullback.snd g Φ ⁻¹ᵁ V) hUPaff

  haveI : IsLocallyNoetherian R :=
    LocallyOfFiniteType.isLocallyNoetherian (r ≫ Limits.pullback.snd g Φ ≫ fS)
  obtain ⟨hWaff, hιinj, hιfin, hBnorm, hN3⟩ := wcfd_gst_normalization_chart R Xt Z b iZ hiso
    hnorm hZgen hdense
    (r ⁻¹ᵁ (Limits.pullback.fst g Φ ⁻¹ᵁ i.1 ⊓ Limits.pullback.snd g Φ ⁻¹ᵁ V)) hURaff
  have hWV : b ⁻¹ᵁ (r ⁻¹ᵁ (Limits.pullback.fst g Φ ⁻¹ᵁ i.1 ⊓ Limits.pullback.snd g Φ ⁻¹ᵁ V)) ≤
      (b ≫ r ≫ Limits.pullback.snd g Φ) ⁻¹ᵁ V := fun z hz => hz.2
  have hxW : x ∈ b ⁻¹ᵁ (r ⁻¹ᵁ (Limits.pullback.fst g Φ ⁻¹ᵁ i.1 ⊓
      Limits.pullback.snd g Φ ⁻¹ᵁ V)) :=
    ⟨hyi, (Scheme.Hom.mem_preimage _).mpr (by rw [hsnd]; exact hηV)⟩

  obtain ⟨Q, hQp, hQ, hiff⟩ := wcfd_gst_stalk_as_localization S Xt
    (b ≫ r ≫ Limits.pullback.snd g Φ) V hV _ hWaff hWV x hxW hx
  haveI := hQp
  rw [hiff]
  have hτ : (b ≫ r ≫ Limits.pullback.snd g Φ).appLE V _ hWV =
      (Limits.pullback.snd g Φ).appLE V
        (Limits.pullback.fst g Φ ⁻¹ᵁ i.1 ⊓ Limits.pullback.snd g Φ ⁻¹ᵁ V) inf_le_right ≫
      r.appLE _ _ le_rfl ≫ b.appLE _ _ le_rfl := by
    rw [Scheme.Hom.appLE_comp_appLE, Scheme.Hom.appLE_comp_appLE]
    simp only [Category.assoc]

  exact hE i.1 i.2 hiV _ heE (Φ.appLE V V hVV) (fun a => hΦpow V hVV a) _ _ _ hpush _ _
    hρsurj hρker _ _ hιinj hιfin hBnorm hN3 _ hτ Q hQ

theorem wcfd_smooth_spread : ∀ (S Y : Scheme.{u}) [IsIntegral S] [IsLocallyNoetherian S] (p : Y ⟶ S) [IsProper p], (∀ y : Y, p y = genericPoint S → (Scheme.Hom.stalkMap p y).hom.FormallySmooth) → ∃ T : Set S, IsClosed T ∧ genericPoint S ∉ T ∧ ∀ W : S.Opens, (W : Set S) ⊆ Tᶜ → Smooth (p ∣_ W) :=
by
  intro S Y _ _ p _ hsm
  haveI : LocallyOfFinitePresentation p := inferInstance
  let L : Y.Opens := Scheme.Hom.smoothLocus p
  refine ⟨⇑p '' ((L : Set Y)ᶜ), ?_, ?_, ?_⟩
  · exact Scheme.Hom.isClosedMap p _ L.isOpen.isClosed_compl
  · rintro ⟨y, hy, hpy⟩
    exact hy (Scheme.Hom.mem_smoothLocus.mpr (hsm y hpy))
  · intro W hW
    rw [← Scheme.Hom.smoothLocus_eq_top_iff]
    rw [eq_top_iff]
    intro x _
    rw [Scheme.Hom.mem_smoothLocus]
    rw [(RingHom.FormallySmooth.respectsIso).arrow_mk_iso_iff (morphismRestrictStalkMap p W x)]
    have hxW : p x.1 ∈ (W : Set S) := (Scheme.Hom.mem_preimage p).mp x.2
    have hxL : x.1 ∈ L := by
      by_contra hn
      exact hW hxW ⟨x.1, hn, rfl⟩
    exact Scheme.Hom.mem_smoothLocus.mp hxL

theorem wcfd_zero_dim_fibre_spread : ∀ (K : Type u) [Field K] [IsAlgClosed K] (S Y : Scheme.{u}) (fS : S ⟶ Spec (.of K)) [IsProper fS] [IsIntegral S] (p : Y ⟶ S) [IsProper p], (∀ y y' : Y, p y = genericPoint S → p y' = genericPoint S → y' ⤳ y → y' = y) → ∃ T : Set S, IsClosed T ∧ genericPoint S ∉ T ∧ ∀ s : S, s ∉ T → topologicalKrullDim ↥(Limits.pullback p (Spec.map (CommRingCat.ofHom (algebraMap (S.residueField s) (AlgebraicClosure (S.residueField s)))) ≫ S.fromSpecResidueField s)) ≤ ((0 : ℕ) : WithBot ℕ∞) :=
by

  have t_s1 : ∀ (k R : Type u) [Field k] [CommRing R] [Algebra k R] [Algebra.FiniteType k R],
      (∀ J : Ideal R, J.IsPrime → J.IsMaximal) → Module.Finite k R := by
    intro k R _ _ _ _ hmax
    classical
    rcases subsingleton_or_nontrivial R with hR | hR
    · exact ⟨⟨∅, Subsingleton.elim _ _⟩⟩
    · obtain ⟨s, g, hinj, hfin⟩ := exists_finite_inj_algHom_of_fg k R
      rcases Nat.eq_zero_or_pos s with rfl | hs
      · have hsurj : Function.Surjective (algebraMap k (MvPolynomial (Fin 0) k)) := by
          rw [MvPolynomial.algebraMap_eq]
          exact MvPolynomial.C_surjective (Fin 0)
        have h1 : (algebraMap k (MvPolynomial (Fin 0) k)).Finite :=
          RingHom.Finite.of_surjective _ hsurj
        have h2 : ((g : MvPolynomial (Fin 0) k →+* R).comp (algebraMap k _)).Finite :=
          RingHom.Finite.comp hfin h1
        rw [AlgHom.comp_algebraMap] at h2
        exact RingHom.finite_algebraMap.mp h2
      · exfalso
        letI : Algebra (MvPolynomial (Fin s) k) R := (g : MvPolynomial (Fin s) k →+* R).toAlgebra
        haveI : Module.Finite (MvPolynomial (Fin s) k) R := hfin
        haveI : Algebra.IsIntegral (MvPolynomial (Fin s) k) R := Algebra.IsIntegral.of_finite _ _
        haveI : (⊥ : Ideal (MvPolynomial (Fin s) k)).IsPrime := Ideal.isPrime_bot
        obtain ⟨Q, -, hQ, hQunder⟩ := Ideal.exists_ideal_over_prime_of_isIntegral
          (⊥ : Ideal (MvPolynomial (Fin s) k)) (⊥ : Ideal R) (by
            intro x hx
            rw [Ideal.mem_bot]
            have hx' : g x = 0 := hx
            exact hinj (by rw [hx', map_zero]))
        haveI hQmax : Q.IsMaximal := hmax Q hQ
        have hcm : (Ideal.comap (g : MvPolynomial (Fin s) k →+* R) Q).IsMaximal :=
          Ideal.isMaximal_comap_of_isIntegral_of_isMaximal _ (RingHom.Finite.to_isIntegral hfin) Q
        have hcb : Ideal.comap (g : MvPolynomial (Fin s) k →+* R) Q = ⊥ := hQunder
        rw [hcb] at hcm
        have hne : RingHom.ker (MvPolynomial.eval (fun _ : Fin s => (0 : k))) ≠ ⊤ :=
          RingHom.ker_ne_top _
        have heq := hcm.eq_of_le hne bot_le
        have hX : (MvPolynomial.X (⟨0, hs⟩ : Fin s) : MvPolynomial (Fin s) k) ∈
            RingHom.ker (MvPolynomial.eval (fun _ : Fin s => (0 : k))) := by
          simp [RingHom.mem_ker]
        rw [← heq, Ideal.mem_bot] at hX
        exact MvPolynomial.X_ne_zero _ hX

  have t_s2 : ∀ (A C : Type u) [CommRing A] [IsDomain A] [CommRing C] [Algebra A C],
      (∀ P Q : Ideal C, P.IsPrime → Q.IsPrime → P.comap (algebraMap A C) = ⊥ →
        Q.comap (algebraMap A C) = ⊥ → P ≤ Q → P = Q) →
      ∀ J : Ideal (TensorProduct A (FractionRing A) C), J.IsPrime → J.IsMaximal := by
    intro A C _ _ _ _ hinc J hJ
    letI : Algebra C (TensorProduct A (FractionRing A) C) := Algebra.TensorProduct.rightAlgebra
    haveI : IsLocalization (Algebra.algebraMapSubmonoid C (nonZeroDivisors A))
        (TensorProduct A (FractionRing A) C) :=
      IsLocalization.tensorRight (FractionRing A) (nonZeroDivisors A)
    have key : ∀ J : Ideal (TensorProduct A (FractionRing A) C), J.IsPrime →
        (Ideal.under C J).IsPrime ∧ (Ideal.under C J).comap (algebraMap A C) = ⊥ := by
      intro J hJ
      have h := (IsLocalization.isPrime_iff_isPrime_disjoint
        (Algebra.algebraMapSubmonoid C (nonZeroDivisors A)) _ J).mp hJ
      refine ⟨h.1, ?_⟩
      rw [eq_bot_iff]
      intro a ha
      rw [Ideal.mem_bot]
      by_contra hne
      have hm : algebraMap A C a ∈ Algebra.algebraMapSubmonoid C (nonZeroDivisors A) :=
        Submonoid.mem_map_of_mem _ (mem_nonZeroDivisors_of_ne_zero hne)
      exact Set.disjoint_left.mp h.2 hm ha
    obtain ⟨J', hJ'max, hle⟩ := Ideal.exists_le_maximal J hJ.ne_top
    have k1 := key J hJ
    have k2 := key J' hJ'max.isPrime
    have hund : Ideal.under C J = Ideal.under C J' :=
      hinc _ _ k1.1 k2.1 k1.2 k2.2 (Ideal.comap_mono hle)
    have hJJ : J = J' := by
      calc J = Ideal.map (algebraMap C _) (Ideal.under C J) :=
            (IsLocalization.map_under (Algebra.algebraMapSubmonoid C (nonZeroDivisors A)) _ J).symm
        _ = Ideal.map (algebraMap C _) (Ideal.under C J') := by rw [hund]
        _ = J' := IsLocalization.map_under (Algebra.algebraMapSubmonoid C (nonZeroDivisors A)) _ J'
    rw [hJJ]
    exact hJ'max

  have t_s3 : ∀ (S Y : Scheme.{u}) [IsIntegral S] (p : Y ⟶ S) (V : S.Opens) (U : Y.Opens)
      (hV : IsAffineOpen V) (hU : IsAffineOpen U) (hUV : U ≤ p ⁻¹ᵁ V),
      genericPoint S ∈ (V : Set S) →
      (∀ y y' : Y, p y = genericPoint S → p y' = genericPoint S → y' ⤳ y → y' = y) →
      ∀ P Q : Ideal Γ(Y, U), P.IsPrime → Q.IsPrime → P.comap (p.appLE V U hUV).hom = ⊥ →
        Q.comap (p.appLE V U hUV).hom = ⊥ → P ≤ Q → P = Q := by
    intro S Y _ p V U hV hU hUV hη hgen P Q hP hQ hPb hQb hPQ
    haveI : Nonempty V := ⟨⟨_, hη⟩⟩
    have hbot : hV.fromSpec (⊥ : PrimeSpectrum Γ(S, V)) = genericPoint S := by
      have e1 := hV.fromSpec_primeIdealOf ⟨genericPoint S, hη⟩
      rw [hV.primeIdealOf_genericPoint, genericPoint_eq_bot_of_affine] at e1
      exact e1
    have hpt : ∀ x : ↥(Spec Γ(Y, U)), x.asIdeal.comap (p.appLE V U hUV).hom = ⊥ →
        p (hU.fromSpec x) = genericPoint S := by
      intro x hIb
      rw [← Scheme.Hom.comp_apply, ← IsAffineOpen.SpecMap_appLE_fromSpec p hV hU hUV,
        Scheme.Hom.comp_apply, ← hbot]
      congr 1
      apply PrimeSpectrum.ext
      exact hIb
    let xP : ↥(Spec Γ(Y, U)) := (⟨P, hP⟩ : PrimeSpectrum Γ(Y, U))
    let xQ : ↥(Spec Γ(Y, U)) := (⟨Q, hQ⟩ : PrimeSpectrum Γ(Y, U))
    have hsp : xP ⤳ xQ := (PrimeSpectrum.le_iff_specializes _ _).mp hPQ
    have hy := hgen (hU.fromSpec xQ) (hU.fromSpec xP) (hpt xQ hQb) (hpt xP hPb)
      (hsp.map hU.fromSpec.continuous)
    haveI := hU.isOpenImmersion_fromSpec
    have h2 : xP = xQ := hU.fromSpec.isOpenEmbedding.injective hy
    exact congrArg PrimeSpectrum.asIdeal h2

  have t_s4 : ∀ (S : Scheme.{u}) (V : S.Opens) (hV : IsAffineOpen V) (s : S) (hs : s ∈ V),
      Spec.map (CommRingCat.ofHom (algebraMap (S.residueField s)
        (AlgebraicClosure (S.residueField s)))) ≫ S.fromSpecResidueField s =
      Spec.map (CommRingCat.ofHom ((algebraMap (S.residueField s)
        (AlgebraicClosure (S.residueField s))).comp (S.evaluation V s hs).hom)) ≫
        hV.fromSpec := by
    intro S V hV s hs
    rw [Scheme.fromSpecResidueField, ← hV.fromSpecStalk_eq_fromSpecStalk hs,
      IsAffineOpen.fromSpecStalk]
    simp only [← Category.assoc, ← Spec.map_comp]
    congr 2

  have t_s5 : ∀ (S Y : Scheme.{u}) (p : Y ⟶ S) [QuasiCompact p] (V : S.Opens), IsAffineOpen V →
      ∃ (m : ℕ) (U : Fin m → Y.Opens), (∀ j, IsAffineOpen (U j)) ∧ (∀ j, U j ≤ p ⁻¹ᵁ V) ∧
        ((p ⁻¹ᵁ V : Y.Opens) : Set Y) ⊆ ⋃ j, (U j : Set Y) := by
    intro S Y p _ V hV
    classical
    have hc : IsCompact ((p ⁻¹ᵁ V : Y.Opens) : Set Y) := p.isCompact_preimage hV.isCompact
    have hW : ∀ y : (p ⁻¹ᵁ V : Y.Opens), ∃ W : Y.Opens, IsAffineOpen W ∧ (y : Y) ∈ W ∧
        W ≤ p ⁻¹ᵁ V := by
      intro y
      obtain ⟨W, hW, hyW, hWs⟩ := exists_isAffineOpen_mem_and_subset y.2
      exact ⟨W, hW, hyW, hWs⟩
    choose W hWa hyW hWle using hW
    obtain ⟨t, ht⟩ := hc.elim_finite_subcover (fun y => (W y : Set Y)) (fun y => (W y).isOpen)
      (fun y hy => Set.mem_iUnion.mpr ⟨⟨y, hy⟩, hyW _⟩)
    refine ⟨t.card, fun j => W (t.equivFin.symm j), fun j => hWa _, fun j => hWle _, ?_⟩
    intro y hy
    obtain ⟨i, hi, hyi⟩ := Set.mem_iUnion₂.mp (ht hy)
    exact Set.mem_iUnion.mpr ⟨t.equivFin ⟨i, hi⟩, by simpa using hyi⟩

  have t_s6 : ∀ (X : Type u) [TopologicalSpace X] [QuasiSober X],
      (∀ y : X, ∃ (G : Set X) (R : Type u) (_ : CommRing R), IsOpen G ∧ y ∈ G ∧
        (∀ q : PrimeSpectrum R, q.asIdeal.IsMaximal) ∧ Nonempty (G ≃ₜ PrimeSpectrum R)) →
      topologicalKrullDim X ≤ ((0 : ℕ) : WithBot ℕ∞) := by
    intro X _ _ h
    have hsp : ∀ x y : X, x ⤳ y → x = y := by
      intro x y hxy
      obtain ⟨G, R, _, hG, hyG, hmax, ⟨e⟩⟩ := h y
      have hxG : x ∈ G := hxy.mem_open hG hyG
      have h1 : (⟨x, hxG⟩ : G) ⤳ ⟨y, hyG⟩ :=
        Topology.IsEmbedding.subtypeVal.isInducing.specializes_iff.mp hxy
      have h2 : e ⟨x, hxG⟩ ⤳ e ⟨y, hyG⟩ := h1.map e.continuous
      rw [← PrimeSpectrum.le_iff_specializes] at h2
      have h3 : (e ⟨x, hxG⟩).asIdeal = (e ⟨y, hyG⟩).asIdeal :=
        (hmax _).eq_of_le (e ⟨y, hyG⟩).isPrime.ne_top h2
      have h4 := e.injective (PrimeSpectrum.ext h3)
      exact congrArg Subtype.val h4
    rw [topologicalKrullDim.eq_1, Nat.cast_zero, Order.krullDim_nonpos_iff_forall_isMax]
    intro Z Z' hZZ'
    obtain ⟨z, hz⟩ := Z.isIrreducible'.nonempty
    obtain ⟨ξ, hξ⟩ := QuasiSober.sober Z'.isIrreducible' Z'.isClosed'
    have hξ' : closure {ξ} = Z'.carrier := hξ
    have hzZ' : z ∈ Z'.carrier := hZZ' hz
    have hξz : ξ ⤳ z := by
      rw [specializes_iff_mem_closure, hξ']
      exact hzZ'
    have hξeq := hsp _ _ hξz
    subst hξeq
    show Z'.carrier ⊆ Z.carrier
    rw [← hξ']
    exact closure_minimal (Set.singleton_subset_iff.mpr hz) Z.isClosed'

  intro K _ _ S Y fS _ _ p _ hgen
  classical
  obtain ⟨V, hV, hηV, -⟩ :=
    exists_isAffineOpen_mem_and_subset (x := genericPoint S) (U := ⊤) trivial
  haveI : Nonempty V := ⟨⟨_, hηV⟩⟩
  obtain ⟨m, U, hU, hUV, hcov⟩ := t_s5 S Y p V hV
  have hchart : ∀ j : Fin m, ∃ a : Γ(S, V), a ≠ 0 ∧ ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
      (ψ : Γ(S, V) →+* Ω), ψ a ≠ 0 → letI := (p.appLE V (U j) (hUV j)).hom.toAlgebra;
      letI := ψ.toAlgebra; ∀ q : PrimeSpectrum (TensorProduct Γ(S, V) Γ(Y, U j) Ω),
        q.asIdeal.IsMaximal := by
    intro j
    letI : Algebra Γ(S, V) Γ(Y, U j) := (p.appLE V (U j) (hUV j)).hom.toAlgebra
    haveI : Algebra.FiniteType Γ(S, V) Γ(Y, U j) :=
      HasRingHomProperty.appLE @LocallyOfFiniteType p inferInstance ⟨V, hV⟩ ⟨U j, hU j⟩ (hUV j)
    have hinc := t_s3 S Y p V (U j) hV (hU j) (hUV j) hηV hgen
    have hmax := t_s2 Γ(S, V) Γ(Y, U j) hinc
    haveI := Algebra.FiniteType.baseChange (R := Γ(S, V)) (A := Γ(Y, U j)) (FractionRing Γ(S, V))
    have hfin := t_s1 (FractionRing Γ(S, V))
      (TensorProduct Γ(S, V) (FractionRing Γ(S, V)) Γ(Y, U j)) hmax
    exact wc_alg_fin_generic_fibre_no_nonmax Γ(S, V) Γ(Y, U j) hfin
  choose a ha0 ha using hchart
  obtain ⟨a0, ha0def⟩ : ∃ a0 : Γ(S, V), a0 = ∏ j, a j := ⟨_, rfl⟩
  have ha0ne : a0 ≠ 0 := by
    rw [ha0def]
    exact Finset.prod_ne_zero_iff.mpr (fun j _ => ha0 j)
  refine ⟨((S.basicOpen a0 : S.Opens) : Set S)ᶜ, (S.basicOpen a0).isOpen.isClosed_compl,
    fun h => h (wc_generic_point_mem_basicOpen S V a0 ha0ne), ?_⟩
  intro s hs
  have hs' : s ∈ ((S.basicOpen a0 : S.Opens) : Set S) := not_not.mp hs
  have hsV : s ∈ V := S.basicOpen_le a0 hs'
  have ht := t_s4 S V hV s hsV
  obtain ⟨ψ, hψ⟩ : ∃ ψ : Γ(S, V) →+* AlgebraicClosure (S.residueField s),
      ψ = (algebraMap (S.residueField s) (AlgebraicClosure (S.residueField s))).comp
        (S.evaluation V s hsV).hom := ⟨_, rfl⟩
  rw [← hψ] at ht
  have hψa : ∀ j, ψ (a j) ≠ 0 := by
    intro j
    have h1 : (S.evaluation V s hsV).hom a0 ≠ 0 :=
      (S.evaluation_ne_zero_iff_mem_basicOpen s hsV a0).mpr hs'
    rw [ha0def, map_prod] at h1
    have h2 := (Finset.prod_ne_zero_iff.mp h1) j (Finset.mem_univ j)
    rw [hψ, RingHom.comp_apply]
    exact (map_ne_zero _).mpr h2
  apply t_s6
  intro z
  have hz : p (Limits.pullback.fst p _ z) = s := by
    rw [← Scheme.Hom.comp_apply, Limits.pullback.condition, Scheme.Hom.comp_apply,
      Scheme.Hom.comp_apply, Scheme.fromSpecResidueField_apply]
  have hfz : Limits.pullback.fst p _ z ∈ ((p ⁻¹ᵁ V : Y.Opens) : Set Y) := by
    show p (Limits.pullback.fst p _ z) ∈ V
    rw [hz]
    exact hsV
  obtain ⟨j, hj⟩ := Set.mem_iUnion.mp (hcov hfz)
  obtain ⟨e⟩ := wc_affine_piece_geom_fibre_homeo S Y p V (U j) hV (hU j) (hUV j)
    (AlgebraicClosure (S.residueField s)) ψ _ ht
  letI : Algebra Γ(S, V) Γ(Y, U j) := (p.appLE V (U j) (hUV j)).hom.toAlgebra
  letI : Algebra Γ(S, V) (AlgebraicClosure (S.residueField s)) := ψ.toAlgebra
  exact ⟨(Limits.pullback.fst p _) ⁻¹' (U j : Set Y),
    TensorProduct Γ(S, V) Γ(Y, U j) (AlgebraicClosure (S.residueField s)), inferInstance,
    (U j).isOpen.preimage (Limits.pullback.fst p _).continuous, hj,
    ha j _ ψ (hψa j), ⟨e⟩⟩

theorem wcfd_fibre_chain_short : ∀ (S Y : Scheme.{u}) (p : Y ⟶ S) (s : S), topologicalKrullDim ↥(Limits.pullback p (Spec.map (CommRingCat.ofHom (algebraMap (S.residueField s) (AlgebraicClosure (S.residueField s)))) ≫ S.fromSpecResidueField s)) ≤ ((1 : ℕ) : WithBot ℕ∞) → ∀ y₀ y₁ y₂ : Y, p y₀ = s → p y₁ = s → p y₂ = s → y₀ ⤳ y₁ → y₁ ⤳ y₂ → y₀ = y₁ ∨ y₁ = y₂ :=
by
  intro S Y p s hdim y₀ y₁ y₂ hp₀ hp₁ hp₂ h01 h12

  have top : ∀ (X : Type u) [TopologicalSpace X] [T0Space X],
      topologicalKrullDim X ≤ ((1 : ℕ) : WithBot ℕ∞) →
      ∀ x₀ x₁ x₂ : X, x₀ ⤳ x₁ → x₁ ⤳ x₂ → x₀ = x₁ ∨ x₁ = x₂ := by
    intro X _ _ hX x₀ x₁ x₂ hx₁ hx₂
    by_contra hne
    rw [not_or] at hne
    obtain ⟨n1, n2⟩ := hne
    let A : X → TopologicalSpace.IrreducibleCloseds X := fun x =>
      ⟨closure {x}, isIrreducible_singleton.closure, isClosed_closure⟩
    have hle : ∀ x y : X, x ⤳ y → A y ≤ A x := fun x y h => by
      show closure {y} ⊆ closure {x}
      exact specializes_iff_closure_subset.mp h
    have hlt : ∀ x y : X, x ⤳ y → x ≠ y → A y < A x := by
      intro x y h hxy
      refine lt_of_le_of_ne (hle x y h) ?_
      intro heq
      apply hxy
      have h' : closure ({y} : Set X) = closure {x} :=
        congrArg (fun B : TopologicalSpace.IrreducibleCloseds X => (B : Set X)) heq
      exact (inseparable_iff_closure_eq.mpr h'.symm).eq
    have a1 := hlt x₁ x₂ hx₂ n2
    have a2 := hlt x₀ x₁ hx₁ n1
    let L : LTSeries (TopologicalSpace.IrreducibleCloseds X) :=
      LTSeries.mk 2 ![A x₂, A x₁, A x₀]
        (Fin.strictMono_iff_lt_succ.mpr (by intro i; fin_cases i <;> simpa))
    have hL : ((2 : ℕ) : WithBot ℕ∞) ≤ Order.krullDim (TopologicalSpace.IrreducibleCloseds X) :=
      Order.LTSeries.length_le_krullDim L
    have h2 : ((2 : ℕ) : WithBot ℕ∞) ≤ ((1 : ℕ) : WithBot ℕ∞) :=
      le_trans hL (show Order.krullDim (TopologicalSpace.IrreducibleCloseds X) ≤ _ from hX)
    exact absurd h2 (by decide)

  have hrange : Set.range (Limits.pullback.fst p (S.fromSpecResidueField s)) = p ⁻¹' {s} :=
    Scheme.Hom.range_fiberι p s
  have mem : ∀ y : Y, p y = s → ∃ f, Limits.pullback.fst p (S.fromSpecResidueField s) f = y := by
    intro y hy
    have hy' : y ∈ p ⁻¹' {s} := hy
    rw [← hrange] at hy'
    exact hy'
  obtain ⟨f₀, hf₀⟩ := mem y₀ hp₀
  obtain ⟨f₁, hf₁⟩ := mem y₁ hp₁
  obtain ⟨f₂, hf₂⟩ := mem y₂ hp₂
  have hind := (Limits.pullback.fst p (S.fromSpecResidueField s)).isEmbedding.isInducing
  have hf01 : f₀ ⤳ f₁ := by rw [← hind.specializes_iff, hf₀, hf₁]; exact h01
  have hf12 : f₁ ⤳ f₂ := by rw [← hind.specializes_iff, hf₁, hf₂]; exact h12
  haveI hint : IsIntegralHom (Spec.map (CommRingCat.ofHom
      (algebraMap (S.residueField s) (AlgebraicClosure (S.residueField s))))) :=
    IsIntegralHom.SpecMap_iff.mpr (fun x => Algebra.IsIntegral.isIntegral x)
  have hsurj := Scheme.Hom.surjective (Limits.pullback.fst
    (Limits.pullback.snd p (S.fromSpecResidueField s)) (Spec.map (CommRingCat.ofHom
      (algebraMap (S.residueField s) (AlgebraicClosure (S.residueField s))))))
  haveI hint2 : IsIntegralHom (Limits.pullback.fst
      (Limits.pullback.snd p (S.fromSpecResidueField s)) (Spec.map (CommRingCat.ofHom
        (algebraMap (S.residueField s) (AlgebraicClosure (S.residueField s)))))) :=
    MorphismProperty.of_isPullback (P := @IsIntegralHom) (IsPullback.of_hasPullback _ _).flip hint
  haveI huc : UniversallyClosed (Limits.pullback.fst
      (Limits.pullback.snd p (S.fromSpecResidueField s)) (Spec.map (CommRingCat.ofHom
        (algebraMap (S.residueField s) (AlgebraicClosure (S.residueField s)))))) := inferInstance
  have hspec : SpecializingMap (Limits.pullback.fst
      (Limits.pullback.snd p (S.fromSpecResidueField s)) (Spec.map (CommRingCat.ofHom
        (algebraMap (S.residueField s) (AlgebraicClosure (S.residueField s)))))) :=
    (Scheme.Hom.isClosedMap (Limits.pullback.fst
      (Limits.pullback.snd p (S.fromSpecResidueField s)) (Spec.map (CommRingCat.ofHom
        (algebraMap (S.residueField s) (AlgebraicClosure (S.residueField s))))))).specializingMap
  obtain ⟨k₀, hk₀⟩ := hsurj f₀
  obtain ⟨k₁, hk01, hk₁⟩ := hspec (show _ ⤳ f₁ by rw [hk₀]; exact hf01)
  obtain ⟨k₂, hk12, hk₂⟩ := hspec (show _ ⤳ f₂ by rw [hk₁]; exact hf12)
  have hk01' : k₀ ⤳ k₁ := hk01
  have hk12' : k₁ ⤳ k₂ := hk12
  have he : ∀ k, Limits.pullback.fst p (Spec.map (CommRingCat.ofHom (algebraMap (S.residueField s)
      (AlgebraicClosure (S.residueField s)))) ≫ S.fromSpecResidueField s)
      ((Limits.pullbackLeftPullbackSndIso p (S.fromSpecResidueField s) (Spec.map (CommRingCat.ofHom
        (algebraMap (S.residueField s) (AlgebraicClosure (S.residueField s)))))).hom k) =
      Limits.pullback.fst p (S.fromSpecResidueField s) (Limits.pullback.fst
        (Limits.pullback.snd p (S.fromSpecResidueField s)) (Spec.map (CommRingCat.ofHom
          (algebraMap (S.residueField s) (AlgebraicClosure (S.residueField s))))) k) := by
    intro k
    rw [← Scheme.Hom.comp_apply, ← Limits.pullbackLeftPullbackSndIso_hom_fst, Scheme.Hom.comp_apply]
    rfl

  have hcE := Scheme.Hom.continuous (Limits.pullbackLeftPullbackSndIso p (S.fromSpecResidueField s)
    (Spec.map (CommRingCat.ofHom
      (algebraMap (S.residueField s) (AlgebraicClosure (S.residueField s)))))).hom
  rcases top _ hdim _ _ _ (hk01'.map hcE) (hk12'.map hcE) with h | h
  · left
    have := congrArg (Limits.pullback.fst p (Spec.map (CommRingCat.ofHom (algebraMap
      (S.residueField s) (AlgebraicClosure (S.residueField s)))) ≫ S.fromSpecResidueField s)) h
    rw [he, he, hk₀, hk₁, hf₀, hf₁] at this
    exact this
  · right
    have := congrArg (Limits.pullback.fst p (Spec.map (CommRingCat.ofHom (algebraMap
      (S.residueField s) (AlgebraicClosure (S.residueField s)))) ≫ S.fromSpecResidueField s)) h
    rw [he, he, hk₁, hk₂, hf₁, hf₂] at this
    exact this

theorem wc_fibre_curve_generic_devissage : ∀ (K : Type u) [Field K] [IsAlgClosed K] (S X : Scheme.{u}) (fS : S ⟶ Spec (.of K)) [IsProper fS] [IsIntegral S] (g : X ⟶ S) [IsProper g], (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (t : Spec (.of Ω) ⟶ S), topologicalKrullDim ↥(Limits.pullback g t) ≤ ((1 : ℕ) : WithBot ℕ∞)) → ∃ (S' : Scheme.{u}) (h : S' ⟶ S) (R : Scheme.{u}) (r : R ⟶ Limits.pullback g h) (Xt : Scheme.{u}) (b : Xt ⟶ R) (Z : Scheme.{u}) (iZ : Z ⟶ R) (W : S'.Opens), IsIntegral S' ∧ IsProper (h ≫ fS) ∧ IsFinite h ∧ IsHomeomorph ⇑h ∧ IsClosedImmersion r ∧ Set.range r = Set.univ ∧ IsProper b ∧ IsClosedImmersion iZ ∧ (∀ U : R.Opens, (U : Set R) = (Set.range iZ)ᶜ → IsIso (b ∣_ U)) ∧ (W : Set S').Nonempty ∧ Smooth ((b ≫ r ≫ Limits.pullback.snd g h) ∣_ W) ∧ (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (t : Spec (.of Ω) ⟶ S'), topologicalKrullDim ↥(Limits.pullback (r ≫ Limits.pullback.snd g h) t) ≤ ((1 : ℕ) : WithBot ℕ∞) ∧ topologicalKrullDim ↥(Limits.pullback (b ≫ r ≫ Limits.pullback.snd g h) t) ≤ ((1 : ℕ) : WithBot ℕ∞) ∧ topologicalKrullDim ↥(Limits.pullback (iZ ≫ r ≫ Limits.pullback.snd g h) t) ≤ ((1 : ℕ) : WithBot ℕ∞) ∧ topologicalKrullDim ↥(Limits.pullback (Limits.pullback.snd b iZ ≫ iZ ≫ r ≫ Limits.pullback.snd g h) t) ≤ ((1 : ℕ) : WithBot ℕ∞)) ∧ ∀ y ∈ (W : Set S'), topologicalKrullDim ↥(Limits.pullback (iZ ≫ r ≫ Limits.pullback.snd g h) (wcEtGeomPt S' y)) ≤ ((0 : ℕ) : WithBot ℕ∞) ∧ topologicalKrullDim ↥(Limits.pullback (Limits.pullback.snd b iZ ≫ iZ ≫ r ≫ Limits.pullback.snd g h) (wcEtGeomPt S' y)) ≤ ((0 : ℕ) : WithBot ℕ∞) :=
by
  intro K _ _ S X fS _ _ g _ HDIM
  classical

  have s7 : ∀ (Y Y' T : Scheme.{u}) {B : Scheme.{u}} (f : Y' ⟶ Y) [IsFinite f] (q : Y ⟶ B)
      (t : T ⟶ B), topologicalKrullDim ↥(Limits.pullback (f ≫ q) t) ≤
        topologicalKrullDim ↥(Limits.pullback q t) := by
    intro Y Y' T B f _ q t
    have e := IsHomeomorph.topologicalKrullDim_eq _
      (Scheme.Hom.homeomorph (Limits.pullbackRightPullbackFstIso q t f).hom).isHomeomorph
    rw [← e]
    exact wc_finite_topologicalKrullDim_le (Limits.pullback.snd f (Limits.pullback.fst q t))

  obtain ⟨e, he⟩ := wcfd_generic_fibre_smooth_twist K S X fS g HDIM
  obtain ⟨Φ, hΦfin, hΦid, hΦpow⟩ := wcfd_frobenius_endo K S fS e
  haveI := hΦfin

  obtain ⟨R, r, hr, hrsurj, hRred⟩ := wc_reduced_subscheme_exists (Limits.pullback g Φ)
  haveI := hr
  haveI := hRred

  haveI : IsProper (r ≫ Limits.pullback.snd g Φ ≫ fS) := inferInstance
  obtain ⟨Xt, b, Z, iZ, hbfin, hiZ, hiso, hnorm, hZgen, hdense⟩ :=
    wcfd_reduced_normalization K R (r ≫ Limits.pullback.snd g Φ ≫ fS)
  haveI := hbfin
  haveI := hiZ

  haveI : IsLocallyNoetherian S := LocallyOfFiniteType.isLocallyNoetherian fS
  have hsm := he Φ hΦfin hΦid hΦpow R r hr hrsurj hRred Xt b Z iZ hbfin hiZ hiso hnorm hZgen
    hdense
  obtain ⟨T₁, hT₁c, hηT₁, hT₁⟩ :=
    wcfd_smooth_spread S Xt (b ≫ r ≫ Limits.pullback.snd g Φ) hsm

  have hα : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (t : Spec (.of Ω) ⟶ S),
      topologicalKrullDim ↥(Limits.pullback (Limits.pullback.snd g Φ) t) ≤
        ((1 : ℕ) : WithBot ℕ∞) := by
    intro Ω _ _ t
    have e1 := IsHomeomorph.topologicalKrullDim_eq _
      (Scheme.Hom.homeomorph (Limits.pullbackLeftPullbackSndIso g Φ t).hom).isHomeomorph
    rw [e1]
    exact HDIM Ω (t ≫ Φ)
  have hβ : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (t : Spec (.of Ω) ⟶ S),
      topologicalKrullDim ↥(Limits.pullback (r ≫ Limits.pullback.snd g Φ) t) ≤
        ((1 : ℕ) : WithBot ℕ∞) := fun Ω _ _ t =>
    (s7 _ _ _ r (Limits.pullback.snd g Φ) t).trans (hα Ω t)
  have hγ : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (t : Spec (.of Ω) ⟶ S),
      topologicalKrullDim ↥(Limits.pullback (b ≫ r ≫ Limits.pullback.snd g Φ) t) ≤
        ((1 : ℕ) : WithBot ℕ∞) := fun Ω _ _ t =>
    (s7 _ _ _ b (r ≫ Limits.pullback.snd g Φ) t).trans (hβ Ω t)
  have hδ : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (t : Spec (.of Ω) ⟶ S),
      topologicalKrullDim ↥(Limits.pullback (iZ ≫ r ≫ Limits.pullback.snd g Φ) t) ≤
        ((1 : ℕ) : WithBot ℕ∞) := fun Ω _ _ t =>
    (s7 _ _ _ iZ (r ≫ Limits.pullback.snd g Φ) t).trans (hβ Ω t)
  have hε : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (t : Spec (.of Ω) ⟶ S),
      topologicalKrullDim ↥(Limits.pullback
        (Limits.pullback.snd b iZ ≫ iZ ≫ r ≫ Limits.pullback.snd g Φ) t) ≤
        ((1 : ℕ) : WithBot ℕ∞) := fun Ω _ _ t =>
    (s7 _ _ _ (Limits.pullback.snd b iZ) (iZ ≫ r ≫ Limits.pullback.snd g Φ) t).trans (hδ Ω t)

  have hinc : ∀ z z' : Z, (iZ ≫ r ≫ Limits.pullback.snd g Φ) z = genericPoint S →
      (iZ ≫ r ≫ Limits.pullback.snd g Φ) z' = genericPoint S → z' ⤳ z → z' = z := by
    intro z z' hz hz' hsp
    by_contra hne
    have hinj : Function.Injective iZ := (Scheme.Hom.isEmbedding iZ).injective
    have h1 : iZ z' ≠ iZ z := fun h => hne (hinj h)
    have h2 : iZ z' ⤳ iZ z := hsp.map iZ.continuous
    obtain ⟨y, hy, hyne⟩ := hZgen z'
    have hz1 : (r ≫ Limits.pullback.snd g Φ) (iZ z) = genericPoint S := hz
    have hz1' : (r ≫ Limits.pullback.snd g Φ) (iZ z') = genericPoint S := hz'
    have h3 : (r ≫ Limits.pullback.snd g Φ) y = genericPoint S := by
      have a1 : (r ≫ Limits.pullback.snd g Φ) y ⤳ (r ≫ Limits.pullback.snd g Φ) (iZ z') :=
        hy.map (r ≫ Limits.pullback.snd g Φ).continuous
      rw [hz1'] at a1
      have a3 : genericPoint S ⤳ (r ≫ Limits.pullback.snd g Φ) y :=
        (genericPoint_spec S).specializes (Set.mem_univ _)
      exact (a1.antisymm a3).eq
    have hgeom := hβ (AlgebraicClosure (S.residueField (genericPoint S)))
      (wcEtGeomPt S (genericPoint S))
    rcases wcfd_fibre_chain_short S R (r ≫ Limits.pullback.snd g Φ) (genericPoint S) hgeom
      y (iZ z') (iZ z) h3 hz1' hz1 hy h2 with h | h
    · exact hyne h
    · exact h1 h

  obtain ⟨T₂, hT₂c, hηT₂, hT₂⟩ :=
    wcfd_zero_dim_fibre_spread K S Z fS (iZ ≫ r ≫ Limits.pullback.snd g Φ) hinc

  let W : S.Opens := ⟨(T₁ ∪ T₂)ᶜ, (hT₁c.union hT₂c).isOpen_compl⟩
  refine ⟨S, Φ, R, r, Xt, b, Z, iZ, W, inferInstance, inferInstance, hΦfin, ?_, hr, hrsurj,
    inferInstance, hiZ, hiso, ?_, ?_, ?_, ?_⟩
  · have hid : (⇑Φ : S → S) = id := funext hΦid
    rw [hid]
    exact IsHomeomorph.id
  · exact ⟨genericPoint S, show genericPoint S ∉ T₁ ∪ T₂ from fun h => h.elim hηT₁ hηT₂⟩
  · exact hT₁ W (fun x hx h1 => hx (Or.inl h1))
  · exact fun Ω _ _ t => ⟨hβ Ω t, hγ Ω t, hδ Ω t, hε Ω t⟩
  · intro y hy
    have hz := hT₂ y (fun h => hy (Or.inr h))
    exact ⟨hz, (s7 _ _ _ (Limits.pullback.snd b iZ) (iZ ≫ r ≫ Limits.pullback.snd g Φ)
      (wcEtGeomPt S y)).trans hz⟩

theorem wc_finite_fibre_coh_transfer : ∀ (S' S X : Scheme.{u}) (h : S' ⟶ S) [IsFinite h] (g : X ⟶ S) (y : S') (m q : ℕ), Nat.card (wcEtCoh (Limits.pullback (Limits.pullback.snd g h) (wcEtGeomPt S' y)) m q) = Nat.card (wcEtCoh (Limits.pullback g (wcEtGeomPt S (h y))) m q) :=
by
  intro S' S X h _ g y m q
  classical

  have hfield : ∀ (A B : Type u) [Field A] [Field B] (ρ : A →+* B)
      (φ : B →+* AlgebraicClosure A), φ.comp ρ = algebraMap A (AlgebraicClosure A) →
      ∃ Ψ : AlgebraicClosure B ≃+* AlgebraicClosure A,
        ∀ b : B, Ψ (algebraMap B (AlgebraicClosure B) b) = φ b := by
    intro A B _ _ ρ φ hφ
    letI : Algebra B (AlgebraicClosure A) := φ.toAlgebra
    haveI : Algebra.IsAlgebraic B (AlgebraicClosure A) := by
      constructor
      intro x
      have hx : IsIntegral A x :=
        isAlgebraic_iff_isIntegral.mp (Algebra.IsAlgebraic.isAlgebraic (R := A) x)
      obtain ⟨p, hpm, hp⟩ := hx
      refine IsIntegral.isAlgebraic ⟨p.map ρ, hpm.map ρ, ?_⟩
      rw [Polynomial.eval₂_map]
      show Polynomial.eval₂ (φ.comp ρ) x p = 0
      rw [hφ]
      exact hp
    haveI : IsAlgClosure B (AlgebraicClosure A) := IsAlgClosure.mk inferInstance inferInstance
    let Ψ₀ := IsAlgClosure.equiv B (AlgebraicClosure B) (AlgebraicClosure A)
    exact ⟨Ψ₀.toRingEquiv, fun b => Ψ₀.commutes b⟩

  have hfac : ∀ (K : Type u) [Field K] (Y : Scheme.{u}) (x : Y) (f : Spec (.of K) ⟶ Y),
      f (IsLocalRing.closedPoint K) = x →
      ∃ φ : Y.residueField x ⟶ CommRingCat.of K, Spec.map φ ≫ Y.fromSpecResidueField x = f := by
    intro K _ Y x f hx
    subst hx
    exact ⟨_, Scheme.descResidueField_stalkClosedPointTo_fromSpecResidueField K Y f⟩

  have ht0 : ∀ a : Spec (.of (AlgebraicClosure (S.residueField (h y)))),
      (wcEtGeomPt S (h y)) a = h y := by
    intro a
    show (Spec.map (CommRingCat.ofHom (algebraMap (S.residueField (h y))
      (AlgebraicClosure (S.residueField (h y))))) ≫ S.fromSpecResidueField (h y)) a = h y
    rw [Scheme.Hom.comp_apply, Scheme.fromSpecResidueField_apply]
  have ht : h y = (wcEtGeomPt S (h y))
      (IsLocalRing.closedPoint (AlgebraicClosure (S.residueField (h y)))) := (ht0 _).symm

  obtain ⟨zb, hzb1, hzb2⟩ : ∃ zb : Spec (.of (AlgebraicClosure (S.residueField (h y)))) ⟶ S',
      zb ≫ h = wcEtGeomPt S (h y) ∧
        zb (IsLocalRing.closedPoint (AlgebraicClosure (S.residueField (h y)))) = y := by
    obtain ⟨w, hw1, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := h)
      (g := wcEtGeomPt S (h y)) y
      (IsLocalRing.closedPoint (AlgebraicClosure (S.residueField (h y)))) ht
    haveI : IsLocallyArtinian (Limits.pullback h (wcEtGeomPt S (h y))) :=
      IsLocallyArtinian.of_locallyQuasiFinite (Limits.pullback.snd h (wcEtGeomPt S (h y)))
    have hwc : IsClosed ({w} : Set ↥(Limits.pullback h (wcEtGeomPt S (h y)))) :=
      isClosed_discrete _
    let σ : Spec (.of (AlgebraicClosure (S.residueField (h y)))) ⟶
        Limits.pullback h (wcEtGeomPt S (h y)) :=
      pointOfClosedPoint (K := AlgebraicClosure (S.residueField (h y)))
        (Limits.pullback.snd h (wcEtGeomPt S (h y))) w hwc
    have hσ1 : σ ≫ Limits.pullback.snd h (wcEtGeomPt S (h y)) = 𝟙 _ :=
      pointOfClosedPoint_comp _ _ _
    have hσ2 : ∀ a : Spec (.of (AlgebraicClosure (S.residueField (h y)))),
        (σ ≫ Limits.pullback.fst h (wcEtGeomPt S (h y))) a = y := by
      intro a
      rw [Scheme.Hom.comp_apply]
      rw [show σ a = w from pointOfClosedPoint_apply _ _ _ a, hw1]
    refine ⟨σ ≫ Limits.pullback.fst h (wcEtGeomPt S (h y)), ?_, hσ2 _⟩
    rw [Category.assoc, Limits.pullback.condition, ← Category.assoc, hσ1, Category.id_comp]

  obtain ⟨φ, hφ⟩ := hfac _ S' y zb hzb2

  have hcomp : h.residueFieldMap y ≫ φ = CommRingCat.ofHom
      (algebraMap (S.residueField (h y)) (AlgebraicClosure (S.residueField (h y)))) := by
    rw [← Spec.map_inj]
    apply (cancel_mono (S.fromSpecResidueField (h y))).mp
    rw [Spec.map_comp, Category.assoc, Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField,
      ← Category.assoc, hφ, hzb1]

  obtain ⟨Ψ, hΨ⟩ := hfield (S.residueField (h y)) (S'.residueField y)
    (h.residueFieldMap y).hom φ.hom (by rw [← CommRingCat.hom_comp, hcomp, CommRingCat.hom_ofHom])

  let e : Spec (.of (AlgebraicClosure (S.residueField (h y)))) ⟶
      Spec (.of (AlgebraicClosure (S'.residueField y))) :=
    Spec.map (CommRingCat.ofHom (Ψ : AlgebraicClosure (S'.residueField y) →+*
      AlgebraicClosure (S.residueField (h y))))
  haveI : IsIso e := by
    have hh : CommRingCat.ofHom (Ψ : AlgebraicClosure (S'.residueField y) →+*
        AlgebraicClosure (S.residueField (h y))) = Ψ.toCommRingCatIso.hom := rfl
    show IsIso (Spec.map (CommRingCat.ofHom (Ψ : AlgebraicClosure (S'.residueField y) →+*
      AlgebraicClosure (S.residueField (h y)))))
    rw [hh]
    infer_instance
  have hring : CommRingCat.ofHom (algebraMap (S'.residueField y)
      (AlgebraicClosure (S'.residueField y))) ≫ CommRingCat.ofHom (Ψ :
        AlgebraicClosure (S'.residueField y) →+* AlgebraicClosure (S.residueField (h y))) = φ := by
    ext b
    exact hΨ b
  have he : e ≫ (wcEtGeomPt S' y ≫ h) = wcEtGeomPt S (h y) := by
    rw [← hzb1, ← hφ, ← hring, Spec.map_comp]
    simp only [e, wcEtGeomPt, Category.assoc]

  let I₁ := Limits.pullbackLeftPullbackSndIso g h (wcEtGeomPt S' y)
  let I₂ : Limits.pullback g (wcEtGeomPt S (h y)) ≅ Limits.pullback g (wcEtGeomPt S' y ≫ h) :=
    Limits.pullback.congrHom rfl he.symm ≪≫
      (Limits.pullbackLeftPullbackSndIso g (wcEtGeomPt S' y ≫ h) e).symm ≪≫
      asIso (Limits.pullback.fst (Limits.pullback.snd g (wcEtGeomPt S' y ≫ h)) e)

  obtain ⟨E⟩ := wc_et_coh_iso_invariance (I₁ ≪≫ I₂.symm).hom m q
  exact (Nat.card_congr E).symm

theorem wc_abstract_blowup_base_change : ∀ (S T Y X' Z : Scheme.{u}) (pY : Y ⟶ S) (b : X' ⟶ Y) [IsProper b] (iZ : Z ⟶ Y) [IsClosedImmersion iZ] (t : T ⟶ S), (∀ U : Y.Opens, (U : Set Y) = (Set.range iZ)ᶜ → IsIso (b ∣_ U)) → ∃ (bt : Limits.pullback (b ≫ pY) t ⟶ Limits.pullback pY t) (it : Limits.pullback (iZ ≫ pY) t ⟶ Limits.pullback pY t), IsProper bt ∧ IsClosedImmersion it ∧ (∀ U : (Limits.pullback pY t).Opens, (U : Set ↥(Limits.pullback pY t)) = (Set.range it)ᶜ → IsIso (bt ∣_ U)) ∧ Nonempty (Limits.pullback bt it ≅ Limits.pullback (Limits.pullback.snd b iZ ≫ iZ ≫ pY) t) :=
by
  intro S T Y X' Z pY b _ iZ _ t hiso

  have s5 : ∀ {X'' W P' : Scheme.{u}} (b0 : X'' ⟶ Y) (g : P' ⟶ Y) (f' : W ⟶ X'') (b' : W ⟶ P'),
      IsPullback f' b' b0 g → ∀ V : Y.Opens, IsIso (b0 ∣_ V) → IsIso (b' ∣_ (g ⁻¹ᵁ V)) := by
    intro X'' W P' b0 g f' b' h V hV
    have R := (isPullback_morphismRestrict b' (g ⁻¹ᵁ V)).flip.paste_horiz h
    have Q := (isPullback_morphismRestrict b0 V).flip
    have w : ((b' ⁻¹ᵁ g ⁻¹ᵁ V).ι ≫ f') ≫ b0 = (b' ∣_ (g ⁻¹ᵁ V) ≫ g ∣_ V) ≫ V.ι := by
      simp only [Category.assoc, morphismRestrict_ι, morphismRestrict_ι_assoc, h.toCommSq.w]
    obtain ⟨k, hk1, hk2⟩ : ∃ k, k ≫ (b0 ⁻¹ᵁ V).ι = (b' ⁻¹ᵁ g ⁻¹ᵁ V).ι ≫ f' ∧
        k ≫ b0 ∣_ V = b' ∣_ (g ⁻¹ᵁ V) ≫ g ∣_ V :=
      ⟨Q.lift _ _ w, Q.lift_fst _ _ w, Q.lift_snd _ _ w⟩
    rw [← hk1, ← morphismRestrict_ι g V] at R
    have H := IsPullback.of_right R hk2 Q
    exact H.flip.isIso_fst_of_isIso

  have wb : (Limits.pullback.fst (b ≫ pY) t ≫ b) ≫ pY = Limits.pullback.snd (b ≫ pY) t ≫ t := by
    rw [Category.assoc]; exact Limits.pullback.condition
  have wi : (Limits.pullback.fst (iZ ≫ pY) t ≫ iZ) ≫ pY =
      Limits.pullback.snd (iZ ≫ pY) t ≫ t := by
    rw [Category.assoc]; exact Limits.pullback.condition
  obtain ⟨bt, hbt1, hbt2⟩ : ∃ bt : Limits.pullback (b ≫ pY) t ⟶ Limits.pullback pY t,
      bt ≫ Limits.pullback.fst pY t = Limits.pullback.fst (b ≫ pY) t ≫ b ∧
      bt ≫ Limits.pullback.snd pY t = Limits.pullback.snd (b ≫ pY) t :=
    ⟨_, Limits.pullback.lift_fst _ _ wb, Limits.pullback.lift_snd _ _ wb⟩
  obtain ⟨it, hit1, hit2⟩ : ∃ it : Limits.pullback (iZ ≫ pY) t ⟶ Limits.pullback pY t,
      it ≫ Limits.pullback.fst pY t = Limits.pullback.fst (iZ ≫ pY) t ≫ iZ ∧
      it ≫ Limits.pullback.snd pY t = Limits.pullback.snd (iZ ≫ pY) t :=
    ⟨_, Limits.pullback.lift_fst _ _ wi, Limits.pullback.lift_snd _ _ wi⟩

  have hb : IsPullback (Limits.pullback.fst (b ≫ pY) t) bt b (Limits.pullback.fst pY t) := by
    refine IsPullback.of_bot ?_ hbt1.symm (IsPullback.of_hasPullback pY t)
    rw [hbt2]
    exact IsPullback.of_hasPullback (b ≫ pY) t
  have hi : IsPullback (Limits.pullback.fst (iZ ≫ pY) t) it iZ (Limits.pullback.fst pY t) := by
    refine IsPullback.of_bot ?_ hit1.symm (IsPullback.of_hasPullback pY t)
    rw [hit2]
    exact IsPullback.of_hasPullback (iZ ≫ pY) t

  have hbtP : IsProper bt := MorphismProperty.of_isPullback (P := @IsProper) hb inferInstance
  have hitC : IsClosedImmersion it :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion) hi inferInstance

  have hrange : Set.range it = (Limits.pullback.fst pY t) ⁻¹' Set.range iZ := by
    rw [← Scheme.Pullback.range_snd iZ (Limits.pullback.fst pY t), ← hi.isoPullback_hom_snd]
    ext x
    constructor
    · rintro ⟨w, rfl⟩
      exact ⟨hi.isoPullback.hom w, (Scheme.Hom.comp_apply _ _ w).symm⟩
    · rintro ⟨y, rfl⟩
      refine ⟨hi.isoPullback.inv y, ?_⟩
      rw [← Scheme.Hom.comp_apply, Iso.inv_hom_id_assoc]
  refine ⟨bt, it, hbtP, hitC, ?_, ?_⟩
  ·
    have hVo : IsOpen (Set.range iZ)ᶜ := iZ.isClosedEmbedding.isClosed_range.isOpen_compl
    let V : Y.Opens := ⟨(Set.range iZ)ᶜ, hVo⟩
    have hbV : IsIso (b ∣_ V) := hiso V rfl
    intro U hU
    have hUeq : U = Limits.pullback.fst pY t ⁻¹ᵁ V := by
      apply TopologicalSpace.Opens.ext
      rw [hU, hrange]
      show _ = (Limits.pullback.fst pY t) ⁻¹' (Set.range iZ)ᶜ
      exact Set.preimage_compl.symm
    subst hUeq
    exact s5 b _ _ bt hb V hbV
  ·
    have wa : (Limits.pullback.fst (Limits.pullback.snd b iZ ≫ iZ ≫ pY) t ≫
        Limits.pullback.fst b iZ) ≫ b ≫ pY =
        Limits.pullback.snd (Limits.pullback.snd b iZ ≫ iZ ≫ pY) t ≫ t := by
      rw [Category.assoc, Limits.pullback.condition_assoc]
      exact Limits.pullback.condition
    have wc : (Limits.pullback.fst (Limits.pullback.snd b iZ ≫ iZ ≫ pY) t ≫
        Limits.pullback.snd b iZ) ≫ iZ ≫ pY =
        Limits.pullback.snd (Limits.pullback.snd b iZ ≫ iZ ≫ pY) t ≫ t := by
      rw [Category.assoc]
      exact Limits.pullback.condition
    obtain ⟨a, ha1, ha2⟩ : ∃ a : Limits.pullback (Limits.pullback.snd b iZ ≫ iZ ≫ pY) t ⟶
        Limits.pullback (b ≫ pY) t,
        a ≫ Limits.pullback.fst (b ≫ pY) t =
          Limits.pullback.fst (Limits.pullback.snd b iZ ≫ iZ ≫ pY) t ≫ Limits.pullback.fst b iZ ∧
        a ≫ Limits.pullback.snd (b ≫ pY) t =
          Limits.pullback.snd (Limits.pullback.snd b iZ ≫ iZ ≫ pY) t :=
      ⟨_, Limits.pullback.lift_fst _ _ wa, Limits.pullback.lift_snd _ _ wa⟩
    obtain ⟨c, hc1, hc2⟩ : ∃ c : Limits.pullback (Limits.pullback.snd b iZ ≫ iZ ≫ pY) t ⟶
        Limits.pullback (iZ ≫ pY) t,
        c ≫ Limits.pullback.fst (iZ ≫ pY) t =
          Limits.pullback.fst (Limits.pullback.snd b iZ ≫ iZ ≫ pY) t ≫ Limits.pullback.snd b iZ ∧
        c ≫ Limits.pullback.snd (iZ ≫ pY) t =
          Limits.pullback.snd (Limits.pullback.snd b iZ ≫ iZ ≫ pY) t :=
      ⟨_, Limits.pullback.lift_fst _ _ wc, Limits.pullback.lift_snd _ _ wc⟩
    have L : IsPullback (Limits.pullback.fst (Limits.pullback.snd b iZ ≫ iZ ≫ pY) t) c
        (Limits.pullback.snd b iZ) (Limits.pullback.fst (iZ ≫ pY) t) := by
      refine IsPullback.of_bot ?_ hc1.symm (IsPullback.of_hasPullback (iZ ≫ pY) t)
      rw [hc2]
      exact IsPullback.of_hasPullback (Limits.pullback.snd b iZ ≫ iZ ≫ pY) t
    have O := L.paste_horiz (IsPullback.of_hasPullback b iZ)
    rw [← ha1, ← hit1] at O
    have hcomm : a ≫ bt = c ≫ it := by
      apply Limits.pullback.hom_ext
      · simp only [Category.assoc, hbt1, hit1, reassoc_of% ha1, reassoc_of% hc1,
          Limits.pullback.condition (f := b) (g := iZ)]
      · simp only [Category.assoc, hbt2, hit2, ha2, hc2]
    have H := IsPullback.of_right O hcomm hb
    exact ⟨H.isoPullback.symm⟩

theorem wc_et_fibre_euler_char_generic_const : ∀ (K : Type u) [Field K] [IsAlgClosed K] (S X : Scheme.{u}) (fS : S ⟶ Spec (.of K)) [IsProper fS] [IsIntegral S] (g : X ⟶ S) [IsProper g] (ℓ : ℕ), ℓ.Prime → (ℓ : K) ≠ 0 → (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (t : Spec (.of Ω) ⟶ S), topologicalKrullDim ↥(Limits.pullback g t) ≤ ((1 : ℕ) : WithBot ℕ∞)) → (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (C : Scheme.{u}) (fC : C ⟶ Spec (.of Ω)) [IsProper fC], (ℓ : Ω) ≠ 0 → topologicalKrullDim C ≤ ((1 : ℕ) : WithBot ℕ∞) → ∀ q : ℕ, Finite (wcEtCoh C ℓ q)) → (∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (Y₀ : Scheme.{u}) (f : Y₀ ⟶ Spec (.of A)) [IsProper f] (m' : ℕ), m' ≠ 0 → ∀ S : Set (Spec (.of A)), IsOpen S → S ≠ Set.univ → ∀ q' : ℕ, Subsingleton (wcEtExt Y₀ (wcEtExtZero Y₀ (f ⁻¹' S) m') q')) → ∃ W : Set S, IsOpen W ∧ genericPoint S ∈ W ∧ ∀ y ∈ W, Nat.card (wcEtCoh (Limits.pullback g (wcEtGeomPt S y)) ℓ 0) * Nat.card (wcEtCoh (Limits.pullback g (wcEtGeomPt S y)) ℓ 2) * Nat.card (wcEtCoh (Limits.pullback g (wcEtGeomPt S (genericPoint S))) ℓ 1) = Nat.card (wcEtCoh (Limits.pullback g (wcEtGeomPt S (genericPoint S))) ℓ 0) * Nat.card (wcEtCoh (Limits.pullback g (wcEtGeomPt S (genericPoint S))) ℓ 2) * Nat.card (wcEtCoh (Limits.pullback g (wcEtGeomPt S y)) ℓ 1) :=
by
  intro K _ _ S X fS _ _ g _ ℓ hℓ hℓK hdim hcurve hPBC
  classical

  obtain ⟨S', h, R, r, Xt, b, Z, iZ, W, hS'int, hS'prop, hhfin, hhomeo, hr, hrsurj, hb, hiZ,
    hiso, hWne, hsmooth, hfibdim, hzero⟩ := wc_fibre_curve_generic_devissage K S X fS g hdim
  haveI := hS'int
  haveI := hS'prop
  haveI := hhfin
  haveI := hr
  haveI := hb
  haveI := hiZ
  set pR : R ⟶ S' := r ≫ Limits.pullback.snd g h with hpR
  haveI : IsProper pR := by rw [hpR]; infer_instance

  have hℓΩ' : ∀ y : S', (ℓ : AlgebraicClosure (S'.residueField y)) ≠ 0 := by
    intro y
    let ψ : K →+* AlgebraicClosure (S'.residueField y) :=
      (algebraMap (S'.residueField y) (AlgebraicClosure (S'.residueField y))).comp
        ((S'.evaluation ⊤ y trivial).hom.comp
          ((h ≫ fS).appTop.hom.comp (Scheme.ΓSpecIso (.of K)).inv.hom))
    rw [← map_natCast ψ ℓ]
    exact (map_ne_zero ψ).mpr hℓK
  have hfinGen : ∀ (T : Scheme.{u}) (p : T ⟶ S') [IsProper p] (y : S'),
      topologicalKrullDim ↥(Limits.pullback p (wcEtGeomPt S' y)) ≤ ((1 : ℕ) : WithBot ℕ∞) →
      ∀ q : ℕ, Finite (wcEtCoh (Limits.pullback p (wcEtGeomPt S' y)) ℓ q) := by
    intro T p _ y hd q
    exact hcurve _ (Limits.pullback p (wcEtGeomPt S' y)) (Limits.pullback.snd p (wcEtGeomPt S' y))
      (hℓΩ' y) hd q
  have hne : ∀ (Y : Scheme.{u}) (p : ℕ), Nonempty (wcEtCoh Y ℓ p) := by
    intro Y p
    unfold wcEtCoh
    exact ⟨0⟩
  have hposG : ∀ (T : Scheme.{u}) (p : T ⟶ S') [IsProper p] (y : S'),
      topologicalKrullDim ↥(Limits.pullback p (wcEtGeomPt S' y)) ≤ ((1 : ℕ) : WithBot ℕ∞) →
      ∀ q : ℕ, 0 < Nat.card (wcEtCoh (Limits.pullback p (wcEtGeomPt S' y)) ℓ q) := by
    intro T p _ y hd q
    haveI := hfinGen T p y hd q
    haveI := hne (Limits.pullback p (wcEtGeomPt S' y)) q
    exact Nat.card_pos

  have hkey : ∀ s : S',
      Nat.card (wcEtCoh (Limits.pullback pR (wcEtGeomPt S' s)) ℓ 0) *
      Nat.card (wcEtCoh (Limits.pullback pR (wcEtGeomPt S' s)) ℓ 2) *
      Nat.card (wcEtCoh (Limits.pullback (Limits.pullback.snd b iZ ≫ iZ ≫ pR) (wcEtGeomPt S' s)) ℓ 0) *
      Nat.card (wcEtCoh (Limits.pullback (Limits.pullback.snd b iZ ≫ iZ ≫ pR) (wcEtGeomPt S' s)) ℓ 2) *
      Nat.card (wcEtCoh (Limits.pullback (b ≫ pR) (wcEtGeomPt S' s)) ℓ 1) *
      Nat.card (wcEtCoh (Limits.pullback (iZ ≫ pR) (wcEtGeomPt S' s)) ℓ 1) =
      Nat.card (wcEtCoh (Limits.pullback (b ≫ pR) (wcEtGeomPt S' s)) ℓ 0) *
      Nat.card (wcEtCoh (Limits.pullback (b ≫ pR) (wcEtGeomPt S' s)) ℓ 2) *
      Nat.card (wcEtCoh (Limits.pullback (iZ ≫ pR) (wcEtGeomPt S' s)) ℓ 0) *
      Nat.card (wcEtCoh (Limits.pullback (iZ ≫ pR) (wcEtGeomPt S' s)) ℓ 2) *
      Nat.card (wcEtCoh (Limits.pullback pR (wcEtGeomPt S' s)) ℓ 1) *
      Nat.card (wcEtCoh (Limits.pullback (Limits.pullback.snd b iZ ≫ iZ ≫ pR) (wcEtGeomPt S' s)) ℓ 1) := by
    intro s
    obtain ⟨bt, it, hbt, hit, hisot, ⟨eE⟩⟩ :=
      wc_abstract_blowup_base_change S' _ R Xt Z pR b iZ (wcEtGeomPt S' s) hiso
    haveI := hbt
    haveI := hit
    have hd := hfibdim _ (wcEtGeomPt S' s)
    have hEq : ∀ q : ℕ, Nonempty (wcEtCoh (Limits.pullback (Limits.pullback.snd b iZ ≫ iZ ≫ pR)
        (wcEtGeomPt S' s)) ℓ q ≃ wcEtCoh (Limits.pullback bt it) ℓ q) :=
      fun q => wc_et_coh_iso_invariance eE.hom ℓ q
    have hfinE : ∀ q : ℕ, Finite (wcEtCoh (Limits.pullback bt it) ℓ q) := by
      intro q
      haveI := hfinGen _ (Limits.pullback.snd b iZ ≫ iZ ≫ pR) s hd.2.2.2 q
      exact Finite.of_equiv _ (hEq q).some
    have h3R := wc_et_proper_curve_vanishing _ _ (Limits.pullback.snd pR (wcEtGeomPt S' s)) ℓ hℓ
      (hℓΩ' s) hd.1 3 (by norm_num)
    have h3X := wc_et_proper_curve_vanishing _ _ (Limits.pullback.snd (b ≫ pR) (wcEtGeomPt S' s)) ℓ
      hℓ (hℓΩ' s) hd.2.1 3 (by norm_num)
    have hC1 := wc_et_euler_blowup_identity _ _ _ bt it hisot ℓ hℓ.ne_zero hPBC
      (hfinGen _ pR s hd.1) (hfinGen _ (b ≫ pR) s hd.2.1) (hfinGen _ (iZ ≫ pR) s hd.2.2.1)
      hfinE h3R h3X
    rw [Nat.card_congr (hEq 0).some, Nat.card_congr (hEq 2).some, Nat.card_congr (hEq 1).some]
    exact hC1

  have hη'W : genericPoint S' ∈ (W : Set S') :=
    ((genericPoint_spec S').mem_open_set_iff W.isOpen).mpr (by rw [Set.univ_inter]; exact hWne)

  have hgen : h (genericPoint S') = genericPoint S := by
    have h1 := (genericPoint_spec S').image (Scheme.Hom.continuous h)
    rw [Set.image_univ, hhomeo.surjective.range_eq, closure_univ] at h1
    exact h1.eq (genericPoint_spec S)

  have hdX : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (t : Spec (.of Ω) ⟶ S'),
      topologicalKrullDim ↥(Limits.pullback (b ≫ pR) t) ≤ ((1 : ℕ) : WithBot ℕ∞) :=
    fun Ω _ _ t => (hfibdim Ω t).2.1
  have hdZ : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (t : Spec (.of Ω) ⟶ S'),
      topologicalKrullDim ↥(Limits.pullback (iZ ≫ pR) t) ≤ ((1 : ℕ) : WithBot ℕ∞) :=
    fun Ω _ _ t => (hfibdim Ω t).2.2.1
  have hdE : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (t : Spec (.of Ω) ⟶ S'),
      topologicalKrullDim ↥(Limits.pullback (Limits.pullback.snd b iZ ≫ iZ ≫ pR) t) ≤
        ((1 : ℕ) : WithBot ℕ∞) :=
    fun Ω _ _ t => (hfibdim Ω t).2.2.2
  obtain ⟨WX0, hWX0o, hηX0, hX0⟩ :=
    wc_et_fibre_h0_card_generic_const K S' Xt (h ≫ fS) (b ≫ pR) ℓ hℓ hℓK hdX hcurve hPBC
  obtain ⟨WX2, hWX2o, hηX2, hX2⟩ :=
    wc_et_fibre_h2_card_generic_const K S' Xt (h ≫ fS) (b ≫ pR) ℓ hℓ hℓK hdX hcurve hPBC
  obtain ⟨WZ0, hWZ0o, hηZ0, hZ0⟩ :=
    wc_et_fibre_h0_card_generic_const K S' Z (h ≫ fS) (iZ ≫ pR) ℓ hℓ hℓK hdZ hcurve hPBC
  obtain ⟨WZ2, hWZ2o, hηZ2, hZ2⟩ :=
    wc_et_fibre_h2_card_generic_const K S' Z (h ≫ fS) (iZ ≫ pR) ℓ hℓ hℓK hdZ hcurve hPBC
  obtain ⟨WE0, hWE0o, hηE0, hE0⟩ :=
    wc_et_fibre_h0_card_generic_const K S' _ (h ≫ fS) (Limits.pullback.snd b iZ ≫ iZ ≫ pR) ℓ hℓ
      hℓK hdE hcurve hPBC
  obtain ⟨WE2, hWE2o, hηE2, hE2⟩ :=
    wc_et_fibre_h2_card_generic_const K S' _ (h ≫ fS) (Limits.pullback.snd b iZ ≫ iZ ≫ pR) ℓ hℓ
      hℓK hdE hcurve hPBC
  obtain ⟨WX1, hWX1o, hηX1, hX1⟩ :=
    wc_et_smooth_curve_family_h1_generic_const K S' Xt (h ≫ fS) (b ≫ pR) ℓ hℓ hℓK hdX hcurve hPBC
      W hWne hsmooth

  have hZ1 : ∀ y ∈ (W : Set S'),
      Nat.card (wcEtCoh (Limits.pullback (iZ ≫ pR) (wcEtGeomPt S' y)) ℓ 1) = 1 := by
    intro y hy
    haveI := wc_et_zero_dim_vanishing _ _ (Limits.pullback.snd (iZ ≫ pR) (wcEtGeomPt S' y))
      (hzero y hy).1 ℓ hℓ.ne_zero 1 one_pos
    exact Nat.card_of_subsingleton (hne _ 1).some
  have hE1 : ∀ y ∈ (W : Set S'),
      Nat.card (wcEtCoh (Limits.pullback (Limits.pullback.snd b iZ ≫ iZ ≫ pR) (wcEtGeomPt S' y)) ℓ 1)
        = 1 := by
    intro y hy
    haveI := wc_et_zero_dim_vanishing _ _
      (Limits.pullback.snd (Limits.pullback.snd b iZ ≫ iZ ≫ pR) (wcEtGeomPt S' y))
      (hzero y hy).2 ℓ hℓ.ne_zero 1 one_pos
    exact Nat.card_of_subsingleton (hne _ 1).some

  have htr : ∀ (s : S') (q : ℕ),
      Nat.card (wcEtCoh (Limits.pullback pR (wcEtGeomPt S' s)) ℓ q) =
        Nat.card (wcEtCoh (Limits.pullback g (wcEtGeomPt S (h s))) ℓ q) := by
    intro s q
    rw [hpR]
    exact (wc_et_fibre_coh_reduced_invariance S' _ (Limits.pullback g h) R
      (Limits.pullback.snd g h) r hrsurj (wcEtGeomPt S' s) ℓ q).trans
      (wc_finite_fibre_coh_transfer S' S X h g s ℓ q)

  have arith : ∀ (a0 a2 a1 b0 b2 b1 E0 E2 X1 X0 X2 Z0 Z2 : ℕ), 0 < E0 * E2 * X1 →
      a0 * a2 * E0 * E2 * X1 * 1 = X0 * X2 * Z0 * Z2 * a1 * 1 →
      b0 * b2 * E0 * E2 * X1 * 1 = X0 * X2 * Z0 * Z2 * b1 * 1 →
      a0 * a2 * b1 = b0 * b2 * a1 := by
    intro a0 a2 a1 b0 b2 b1 E0 E2 X1 X0 X2 Z0 Z2 hpos h1 h2
    apply Nat.eq_of_mul_eq_mul_right hpos
    calc a0 * a2 * b1 * (E0 * E2 * X1) = (a0 * a2 * E0 * E2 * X1 * 1) * b1 := by ring
      _ = (X0 * X2 * Z0 * Z2 * a1 * 1) * b1 := by rw [h1]
      _ = (X0 * X2 * Z0 * Z2 * b1 * 1) * a1 := by ring
      _ = (b0 * b2 * E0 * E2 * X1 * 1) * a1 := by rw [h2]
      _ = b0 * b2 * a1 * (E0 * E2 * X1) := by ring

  set V' : Set S' := (W : Set S') ∩ WX0 ∩ WX2 ∩ WZ0 ∩ WZ2 ∩ WE0 ∩ WE2 ∩ WX1 with hV'
  have hV'o : IsOpen V' :=
    (((((((W.isOpen.inter hWX0o).inter hWX2o).inter hWZ0o).inter hWZ2o).inter hWE0o).inter
      hWE2o).inter hWX1o)
  have hηV' : genericPoint S' ∈ V' :=
    ⟨⟨⟨⟨⟨⟨⟨hη'W, hηX0⟩, hηX2⟩, hηZ0⟩, hηZ2⟩, hηE0⟩, hηE2⟩, hηX1⟩
  have hposη : 0 <
      Nat.card (wcEtCoh (Limits.pullback (Limits.pullback.snd b iZ ≫ iZ ≫ pR)
        (wcEtGeomPt S' (genericPoint S'))) ℓ 0) *
      Nat.card (wcEtCoh (Limits.pullback (Limits.pullback.snd b iZ ≫ iZ ≫ pR)
        (wcEtGeomPt S' (genericPoint S'))) ℓ 2) *
      Nat.card (wcEtCoh (Limits.pullback (b ≫ pR) (wcEtGeomPt S' (genericPoint S'))) ℓ 1) :=
    Nat.mul_pos (Nat.mul_pos
      (hposG _ _ _ (hdE _ (wcEtGeomPt S' (genericPoint S'))) 0)
      (hposG _ _ _ (hdE _ (wcEtGeomPt S' (genericPoint S'))) 2))
      (hposG _ _ _ (hdX _ (wcEtGeomPt S' (genericPoint S'))) 1)
  refine ⟨h '' V', hhomeo.isOpenMap V' hV'o, ⟨genericPoint S', hηV', hgen⟩, ?_⟩
  rintro y ⟨y', hy', rfl⟩
  obtain ⟨⟨⟨⟨⟨⟨⟨hyW, hy0⟩, hy2⟩, hyz0⟩, hyz2⟩, hye0⟩, hye2⟩, hyx1⟩ := hy'
  have k1 := hkey y'
  have k2 := hkey (genericPoint S')
  rw [hX0 y' hy0, hX2 y' hy2, hZ0 y' hyz0, hZ2 y' hyz2, hE0 y' hye0, hE2 y' hye2, hX1 y' hyx1,
    hZ1 y' hyW, hE1 y' hyW] at k1
  rw [hZ1 _ hη'W, hE1 _ hη'W] at k2
  rw [← hgen, ← htr y' 0, ← htr y' 2, ← htr y' 1, ← htr (genericPoint S') 0,
    ← htr (genericPoint S') 2, ← htr (genericPoint S') 1]
  exact arith _ _ _ _ _ _ _ _ _ _ _ _ _ hposη k1 k2

theorem wc_et_fibre_coh_card_generic_const : ∀ (K : Type u) [Field K] [IsAlgClosed K] (S X : Scheme.{u}) (fS : S ⟶ Spec (.of K)) [IsProper fS] [IsIntegral S] (g : X ⟶ S) [IsProper g] (ℓ : ℕ), ℓ.Prime → (ℓ : K) ≠ 0 → (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (t : Spec (.of Ω) ⟶ S), topologicalKrullDim ↥(Limits.pullback g t) ≤ ((1 : ℕ) : WithBot ℕ∞)) → (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (C : Scheme.{u}) (fC : C ⟶ Spec (.of Ω)) [IsProper fC], (ℓ : Ω) ≠ 0 → topologicalKrullDim C ≤ ((1 : ℕ) : WithBot ℕ∞) → ∀ q : ℕ, Finite (wcEtCoh C ℓ q)) → (∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (Y₀ : Scheme.{u}) (f : Y₀ ⟶ Spec (.of A)) [IsProper f] (m' : ℕ), m' ≠ 0 → ∀ S : Set (Spec (.of A)), IsOpen S → S ≠ Set.univ → ∀ q' : ℕ, Subsingleton (wcEtExt Y₀ (wcEtExtZero Y₀ (f ⁻¹' S) m') q')) → ∀ q : ℕ, ∃ W : Set S, IsOpen W ∧ genericPoint S ∈ W ∧ ∀ y ∈ W, Nat.card (wcEtCoh (Limits.pullback g (wcEtGeomPt S y)) ℓ q) = Nat.card (wcEtCoh (Limits.pullback g (wcEtGeomPt S (genericPoint S))) ℓ q) :=
by
  intro K _ _ S X fS _ _ g _ ℓ hℓ hℓK hdim hcurve hPBC q
  classical

  have hℓΩ : ∀ y : S, (ℓ : AlgebraicClosure (S.residueField y)) ≠ 0 := by
    intro y
    let ψ : K →+* AlgebraicClosure (S.residueField y) :=
      (algebraMap (S.residueField y) (AlgebraicClosure (S.residueField y))).comp
        ((S.evaluation ⊤ y trivial).hom.comp
          (fS.appTop.hom.comp (Scheme.ΓSpecIso (.of K)).inv.hom))
    rw [← map_natCast ψ ℓ]
    exact (map_ne_zero ψ).mpr hℓK

  have hfin : ∀ (y : S) (p : ℕ),
      Finite (wcEtCoh (Limits.pullback g (wcEtGeomPt S y)) ℓ p) := fun y p =>
    hcurve _ (Limits.pullback g (wcEtGeomPt S y)) (Limits.pullback.snd g (wcEtGeomPt S y))
      (hℓΩ y) (hdim _ (wcEtGeomPt S y)) p

  have hne : ∀ (Y : Scheme.{u}) (p : ℕ), Nonempty (wcEtCoh Y ℓ p) := by
    intro Y p
    unfold wcEtCoh
    exact ⟨0⟩

  have hpos : ∀ (y : S) (p : ℕ),
      0 < Nat.card (wcEtCoh (Limits.pullback g (wcEtGeomPt S y)) ℓ p) := by
    intro y p
    haveI := hfin y p
    haveI := hne (Limits.pullback g (wcEtGeomPt S y)) p
    exact Nat.card_pos

  have hvan : ∀ (y : S) (p : ℕ), 2 < p →
      Nat.card (wcEtCoh (Limits.pullback g (wcEtGeomPt S y)) ℓ p) = 1 := by
    intro y p hp
    haveI := wc_et_proper_curve_vanishing _ (Limits.pullback g (wcEtGeomPt S y))
      (Limits.pullback.snd g (wcEtGeomPt S y)) ℓ hℓ (hℓΩ y) (hdim _ (wcEtGeomPt S y)) p hp
    obtain ⟨a⟩ := hne (Limits.pullback g (wcEtGeomPt S y)) p
    exact Nat.card_of_subsingleton a

  match q with
  | 0 => exact wc_et_fibre_h0_card_generic_const K S X fS g ℓ hℓ hℓK hdim hcurve hPBC
  | 2 => exact wc_et_fibre_h2_card_generic_const K S X fS g ℓ hℓ hℓK hdim hcurve hPBC
  | k + 3 =>
    exact ⟨Set.univ, isOpen_univ, Set.mem_univ _, fun y _ =>
      (hvan y (k + 3) (by omega)).trans (hvan _ (k + 3) (by omega)).symm⟩
  | 1 =>
    obtain ⟨W0, hW0o, hη0, hW0⟩ :=
      wc_et_fibre_h0_card_generic_const K S X fS g ℓ hℓ hℓK hdim hcurve hPBC
    obtain ⟨W2, hW2o, hη2, hW2⟩ :=
      wc_et_fibre_h2_card_generic_const K S X fS g ℓ hℓ hℓK hdim hcurve hPBC
    obtain ⟨Wc, hWco, hηc, hWc⟩ :=
      wc_et_fibre_euler_char_generic_const K S X fS g ℓ hℓ hℓK hdim hcurve hPBC
    refine ⟨W0 ∩ W2 ∩ Wc, (hW0o.inter hW2o).inter hWco, ⟨⟨hη0, hη2⟩, hηc⟩, fun y hy => ?_⟩
    have e := hWc y hy.2
    rw [hW0 y hy.1.1, hW2 y hy.1.2] at e
    have hA := Nat.mul_pos (hpos (genericPoint S) 0) (hpos (genericPoint S) 2)
    exact (Nat.eq_of_mul_eq_mul_left hA e).symm

theorem wc_et_proper_curve_fibration_constructible : ∀ (K : Type u) [Field K] [IsAlgClosed K] (X B : Scheme.{u}) (fB : B ⟶ Spec (.of K)) [IsProper fB] (g : X ⟶ B) [IsProper g] (ℓ : ℕ), ℓ.Prime → (ℓ : K) ≠ 0 → (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (t : Spec (.of Ω) ⟶ B), topologicalKrullDim ↥(Limits.pullback g t) ≤ ((1 : ℕ) : WithBot ℕ∞)) → (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (C : Scheme.{u}) (fC : C ⟶ Spec (.of Ω)) [IsProper fC], (ℓ : Ω) ≠ 0 → topologicalKrullDim C ≤ ((1 : ℕ) : WithBot ℕ∞) → ∀ q : ℕ, Finite (wcEtCoh C ℓ q)) → (∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (Y₀ : Scheme.{u}) (f : Y₀ ⟶ Spec (.of A)) [IsProper f] (m' : ℕ), m' ≠ 0 → ∀ S : Set (Spec (.of A)), IsOpen S → S ≠ Set.univ → ∀ q' : ℕ, Subsingleton (wcEtExt Y₀ (wcEtExtZero Y₀ (f ⁻¹' S) m') q')) → ∀ (I : InjectiveResolution ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))))), (∀ (b : B) (q : ℕ), Nonempty ((wcEtStalk B b).obj ((((wcEtPush g).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q) ≃ wcEtCoh (Limits.pullback g (wcEtGeomPt B b)) ℓ q)) → ∀ q : ℕ, IsNoetherianObject ((((wcEtPush g).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q) :=
by
  intro K _ _ X B fB _ g _ ℓ hℓ hℓK hfib hcurve hPBC I hstalk q
  classical

  haveI : IsLocallyNoetherian B := LocallyOfFiniteType.isLocallyNoetherian fB
  haveI : CompactSpace B := QuasiCompact.compactSpace_of_compactSpace fB
  haveI : IsNoetherian B := AlgebraicGeometry.IsNoetherian.mk

  have hfin : ∀ b : B, Finite ((wcEtStalk B b).obj
      ((((wcEtPush g).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q)) := by
    intro b
    have hℓΩ : (ℓ : AlgebraicClosure (B.residueField b)) ≠ 0 := by
      let ψ : K →+* AlgebraicClosure (B.residueField b) :=
        (algebraMap (B.residueField b) (AlgebraicClosure (B.residueField b))).comp
          ((B.evaluation ⊤ b trivial).hom.comp
            (fB.appTop.hom.comp (Scheme.ΓSpecIso (.of K)).inv.hom))
      rw [← map_natCast ψ ℓ]
      exact (map_ne_zero ψ).mpr hℓK
    haveI : Finite (wcEtCoh (Limits.pullback g (wcEtGeomPt B b)) ℓ q) :=
      hcurve _ (Limits.pullback g (wcEtGeomPt B b)) (Limits.pullback.snd g (wcEtGeomPt B b)) hℓΩ
        (hfib _ (wcEtGeomPt B b)) q
    exact Finite.of_equiv _ (hstalk b q).some.symm

  have hcof : ∀ b : B, IsCofiltered
      (StructuredArrow (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B)) :=
    fun b => wc_et_geomstalk_cofiltered B b wc_etale_maps_agree_near_geom_point

  refine wc_et_noetherianObject_of_stalk_criteria B _ hfin ?_ ?_
  · intro G G' ι ι' hm hr
    exact wc_et_mono_factor_of_stalk_range B hcof wc_etale_lift_alg_closed_point
      wc_etale_jointly_surjective_covers _ G G' ι ι' hm hr
  · intro η G ι
    have hgen : ∀ (S X' : Scheme.{u}) (fS : S ⟶ Spec (.of K)) [IsProper fS] [IsIntegral S]
        (g' : X' ⟶ S) [IsProper g'],
        (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (t : Spec (.of Ω) ⟶ S),
          topologicalKrullDim ↥(Limits.pullback g' t) ≤ ((1 : ℕ) : WithBot ℕ∞)) →
        ∃ W : Set S, IsOpen W ∧ genericPoint S ∈ W ∧ ∀ y ∈ W,
          Nat.card (wcEtCoh (Limits.pullback g' (wcEtGeomPt S y)) ℓ q) =
            Nat.card (wcEtCoh (Limits.pullback g' (wcEtGeomPt S (genericPoint S))) ℓ q) := by
      intro S X' fS _ _ g' _ hdim
      exact wc_et_fibre_coh_card_generic_const K S X' fS g' ℓ hℓ hℓK hdim hcurve hPBC q
    obtain ⟨W, hWo, hηW, hW⟩ := wc_et_fibre_card_reduce_to_integral K X B fB g ℓ q
      wc_et_coh_iso_invariance wc_closed_immersion_geomPt_compat wc_reduced_subscheme_exists
      hfib hgen η
    refine wc_et_stalk_range_local_uniform B _ hcof wc_etale_lift_alg_closed_point
      wc_etale_fibre_point_isolated wc_etale_section_vanishing_open hfin η
      ⟨W, hWo, hηW, fun y hy hsp => ?_⟩ G ι
    exact (Nat.card_congr (hstalk y q).some).trans
      ((hW y hy hsp).trans (Nat.card_congr (hstalk η q).some).symm)

theorem wc_fnp_fibre_card_bound : ∀ {X Y : Scheme.{u}} (p : Y ⟶ X) [IsFinite p], CompactSpace X → ∃ d : ℕ, ∀ (Ω : Type u) [Field Ω] (xb : Spec (.of Ω) ⟶ X), Nat.card {yb : Spec (.of Ω) ⟶ Y // yb ≫ p = xb} ≤ d :=
by

  have s1 : ∀ (A C Ω : Type u) [CommRing A] [CommRing C] [Field Ω] (φ : A →+* C) (χ : A →+* Ω)
      (n : ℕ) (c : Fin n → C), (∀ x : C, ∃ a : Fin n → A, x = ∑ i, φ (a i) * c i) →
      Finite {ψ : C →+* Ω // ψ.comp φ = χ} ∧ Nat.card {ψ : C →+* Ω // ψ.comp φ = χ} ≤ n := by
    intro A C Ω _ _ _ φ χ n c hgen
    classical
    let ι : {ψ : C →+* Ω // ψ.comp φ = χ} → (C →* Ω) := fun ψ => ψ.1.toMonoidHom
    have hι : Function.Injective ι := by
      intro ψ ψ' h
      apply Subtype.ext
      apply RingHom.ext
      intro x
      exact DFunLike.congr_fun h x
    have hD : LinearIndependent Ω (fun ψ : {ψ : C →+* Ω // ψ.comp φ = χ} => (⇑ψ.1 : C → Ω)) :=
      (linearIndependent_monoidHom C Ω).comp ι hι
    let w : {ψ : C →+* Ω // ψ.comp φ = χ} → (Fin n → Ω) := fun ψ i => ψ.1 (c i)
    have hval : ∀ (ψ : {ψ : C →+* Ω // ψ.comp φ = χ}) (a : A), ψ.1 (φ a) = χ a := fun ψ a => by
      rw [← RingHom.comp_apply, ψ.2]
    have hw : LinearIndependent Ω w := by
      rw [linearIndependent_iff'] at hD ⊢
      intro s g H
      apply hD s g
      funext x
      obtain ⟨a, rfl⟩ := hgen x
      have Hi : ∀ i, ∑ ψ ∈ s, g ψ * ψ.1 (c i) = 0 := by
        intro i
        have := congrFun H i
        simpa [Finset.sum_apply, w] using this
      simp only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul, Pi.zero_apply, map_sum, map_mul, hval]
      simp_rw [Finset.mul_sum]
      rw [Finset.sum_comm]
      refine Finset.sum_eq_zero (fun i _ => ?_)
      calc ∑ ψ ∈ s, g ψ * (χ (a i) * ψ.1 (c i)) = χ (a i) * ∑ ψ ∈ s, g ψ * ψ.1 (c i) := by
            rw [Finset.mul_sum]; exact Finset.sum_congr rfl (fun _ _ => by ring)
        _ = 0 := by rw [Hi i, mul_zero]
    have hfin : Finite {ψ : C →+* Ω // ψ.comp φ = χ} := hw.finite
    refine ⟨hfin, ?_⟩
    letI := Fintype.ofFinite {ψ : C →+* Ω // ψ.comp φ = χ}
    rw [Nat.card_eq_fintype_card]
    have := hw.fintype_card_le_finrank
    rwa [Module.finrank_fin_fun] at this

  have s2 : ∀ {X Y : Scheme.{u}} (p : Y ⟶ X) [IsFinite p] [IsAffine X], ∃ (n : ℕ) (c : Fin n → Γ(Y, ⊤)),
      (∀ x : Γ(Y, ⊤), ∃ a : Fin n → Γ(X, ⊤), x = ∑ i, p.appTop.hom (a i) * c i) ∧
      ∀ (Ω : Type u) [Field Ω] (xb : Spec (.of Ω) ⟶ X),
        ∃ f : {yb : Spec (.of Ω) ⟶ Y // yb ≫ p = xb} → {ψ : Γ(Y, ⊤) →+* Ω //
          ψ.comp p.appTop.hom = (xb.appTop ≫ (Scheme.ΓSpecIso (.of Ω)).hom).hom},
          Function.Injective f := by
    intro X Y p _ _
    haveI : IsAffine Y := isAffine_of_isAffineHom p
    have hfin : p.appTop.hom.Finite := Scheme.Hom.finite_app p ⊤ (isAffineOpen_top X)
    letI := p.appTop.hom.toAlgebra
    haveI hmod : Module.Finite Γ(X, ⊤) Γ(Y, ⊤) := hfin
    obtain ⟨n, c, hc⟩ := Module.Finite.exists_fin (R := Γ(X, ⊤)) (M := Γ(Y, ⊤))
    refine ⟨n, c, ?_, ?_⟩
    · intro x
      have hx : x ∈ Submodule.span Γ(X, ⊤) (Set.range c) := by rw [hc]; trivial
      obtain ⟨a, ha⟩ := (Submodule.mem_span_range_iff_exists_fun _).mp hx
      refine ⟨a, ?_⟩
      rw [← ha]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [Algebra.smul_def, RingHom.algebraMap_toAlgebra]
    · intro Ω _ xb
      refine ⟨fun yb => ⟨(yb.1.appTop ≫ (Scheme.ΓSpecIso (.of Ω)).hom).hom, ?_⟩, ?_⟩
      · rw [← CommRingCat.hom_comp, ← Category.assoc, ← Scheme.Hom.comp_appTop, yb.2]
      · intro y1 y2 h
        have h1 := congrArg Subtype.val h
        have h2 : y1.1.appTop ≫ (Scheme.ΓSpecIso (.of Ω)).hom =
            y2.1.appTop ≫ (Scheme.ΓSpecIso (.of Ω)).hom := CommRingCat.hom_ext h1
        have h3 := (cancel_mono _).mp h2
        exact Subtype.ext (ext_of_isAffine h3)

  have s3 : ∀ {X Y : Scheme.{u}} (p : Y ⟶ X) (W : X.Opens) (Ω : Type u) [Field Ω]
      (xb : Spec (.of Ω) ⟶ X), xb (IsLocalRing.closedPoint Ω) ∈ W →
      ∃ xb' : Spec (.of Ω) ⟶ W, xb' ≫ W.ι = xb ∧
        ∃ f : {yb : Spec (.of Ω) ⟶ Y // yb ≫ p = xb} → {yb' : Spec (.of Ω) ⟶ Limits.pullback p W.ι //
          yb' ≫ Limits.pullback.snd p W.ι = xb'}, Function.Injective f := by
    intro X Y p W Ω _ xb hx
    have hr : Set.range xb ⊆ Set.range W.ι := by
      rintro _ ⟨w, rfl⟩
      rw [Scheme.Opens.range_ι, Subsingleton.elim w (IsLocalRing.closedPoint Ω)]
      exact hx
    refine ⟨IsOpenImmersion.lift W.ι xb hr, IsOpenImmersion.lift_fac _ _ _, ?_⟩
    refine ⟨fun yb => ⟨Limits.pullback.lift yb.1 (IsOpenImmersion.lift W.ι xb hr)
      (by rw [yb.2, IsOpenImmersion.lift_fac]), Limits.pullback.lift_snd _ _ _⟩, ?_⟩
    intro y1 y2 h
    have := congrArg (fun z => z.1 ≫ Limits.pullback.fst p W.ι) h
    simp only [Limits.pullback.lift_fst] at this
    exact Subtype.ext this

  intro X Y p _ hX
  have haff : ∀ {X₀ Y₀ : Scheme.{u}} (p₀ : Y₀ ⟶ X₀) [IsFinite p₀] [IsAffine X₀], ∃ n : ℕ,
      ∀ (Ω : Type u) [Field Ω] (xb : Spec (.of Ω) ⟶ X₀),
        Finite {yb : Spec (.of Ω) ⟶ Y₀ // yb ≫ p₀ = xb} ∧
        Nat.card {yb : Spec (.of Ω) ⟶ Y₀ // yb ≫ p₀ = xb} ≤ n := by
    intro X₀ Y₀ p₀ _ _
    obtain ⟨n, c, hc, hinj⟩ := s2 p₀
    refine ⟨n, fun Ω _ xb => ?_⟩
    obtain ⟨f, hf⟩ := hinj Ω xb
    obtain ⟨hfin, hcard⟩ := s1 _ _ Ω p₀.appTop.hom
      (xb.appTop ≫ (Scheme.ΓSpecIso (.of Ω)).hom).hom n c hc
    exact ⟨Finite.of_injective f hf, (Nat.card_le_card_of_injective f hf).trans hcard⟩
  choose U hUa hxU _ using fun x : X => exists_isAffineOpen_mem_and_subset (U := ⊤) (x := x) trivial
  have hn : ∀ x : X, ∃ n : ℕ, ∀ (Ω : Type u) [Field Ω] (xb : Spec (.of Ω) ⟶ (U x : Scheme.{u})),
      Finite {yb : Spec (.of Ω) ⟶ Limits.pullback p (U x).ι //
        yb ≫ Limits.pullback.snd p (U x).ι = xb} ∧
      Nat.card {yb : Spec (.of Ω) ⟶ Limits.pullback p (U x).ι //
        yb ≫ Limits.pullback.snd p (U x).ι = xb} ≤ n := by
    intro x
    haveI : IsAffine (U x) := hUa x
    exact haff (Limits.pullback.snd p (U x).ι)
  choose n hn using hn
  obtain ⟨t, ht⟩ := isCompact_univ.elim_finite_subcover (fun x => (U x : Set X))
    (fun x => (U x).isOpen) (fun y _ => Set.mem_iUnion.2 ⟨y, hxU y⟩)
  refine ⟨t.sup n, fun Ω _ xb => ?_⟩
  obtain ⟨x, hxt, hx⟩ : ∃ x ∈ t, xb (IsLocalRing.closedPoint Ω) ∈ U x := by
    have := ht (Set.mem_univ (xb (IsLocalRing.closedPoint Ω)))
    simpa using this
  obtain ⟨xb', _, f, hf⟩ := s3 p (U x) Ω xb hx
  obtain ⟨hfin, hcard⟩ := hn x Ω xb'
  exact (Nat.card_le_card_of_injective f hf).trans (hcard.trans (Finset.le_sup hxt))

theorem wc_fnp_widePullback_finite : ∀ {B Z : Scheme.{u}} (p : Z ⟶ B) [IsFinite p] (N : ℕ), IsFinite (Limits.WidePullback.base (fun _ : Fin N => p)) :=
by
  intro B Z p _ N
  induction N with
  | zero =>
    have hiso : IsIso (Limits.WidePullback.base (fun _ : Fin 0 => p)) := by
      refine ⟨⟨Limits.WidePullback.lift (𝟙 B) (fun j => j.elim0) (fun j => j.elim0), ?_, ?_⟩⟩
      · apply Limits.WidePullback.hom_ext (fun _ : Fin 0 => p)
        · intro j
          exact j.elim0
        · rw [Category.assoc, Limits.WidePullback.lift_base, Category.comp_id, Category.id_comp]
      · exact Limits.WidePullback.lift_base _ _ _ _
    infer_instance
  | succ N ih =>
    obtain ⟨g, hgπ, hgb⟩ : ∃ g : Limits.widePullback B (fun _ : Fin (N + 1) => Z) (fun _ => p) ⟶
        Limits.widePullback B (fun _ : Fin N => Z) (fun _ => p),
        (∀ i : Fin N, g ≫ Limits.WidePullback.π (fun _ : Fin N => p) i =
          Limits.WidePullback.π (fun _ : Fin (N + 1) => p) i.castSucc) ∧
        g ≫ Limits.WidePullback.base (fun _ : Fin N => p) =
          Limits.WidePullback.base (fun _ : Fin (N + 1) => p) :=
      ⟨Limits.WidePullback.lift (Limits.WidePullback.base (fun _ : Fin (N + 1) => p))
        (fun i : Fin N => Limits.WidePullback.π (fun _ : Fin (N + 1) => p) i.castSucc)
        (fun i => Limits.WidePullback.π_arrow (fun _ : Fin (N + 1) => p) i.castSucc),
        fun i => Limits.WidePullback.lift_π _ _ _ _ _, Limits.WidePullback.lift_base _ _ _ _⟩
    have comm : g ≫ Limits.WidePullback.base (fun _ : Fin N => p) =
        Limits.WidePullback.π (fun _ : Fin (N + 1) => p) (Fin.last N) ≫ p := by
      rw [hgb, Limits.WidePullback.π_arrow]
    have hw : ∀ (s : Limits.PullbackCone (Limits.WidePullback.base (fun _ : Fin N => p)) p)
        (j : Fin (N + 1)),
        Fin.lastCases (motive := fun _ => s.pt ⟶ Z) s.snd
          (fun i => s.fst ≫ Limits.WidePullback.π (fun _ : Fin N => p) i) j ≫ p = s.snd ≫ p := by
      intro s j
      refine Fin.lastCases ?_ (fun i => ?_) j
      · rw [Fin.lastCases_last]
      · rw [Fin.lastCases_castSucc, Category.assoc, Limits.WidePullback.π_arrow, s.condition]
    have hpb : IsPullback g (Limits.WidePullback.π (fun _ : Fin (N + 1) => p) (Fin.last N))
        (Limits.WidePullback.base (fun _ : Fin N => p)) p := by
      refine IsPullback.of_isLimit' ⟨comm⟩ ?_
      refine Limits.PullbackCone.IsLimit.mk comm
        (fun s => Limits.WidePullback.lift (s.snd ≫ p)
          (Fin.lastCases (motive := fun _ => s.pt ⟶ Z) s.snd
            (fun i => s.fst ≫ Limits.WidePullback.π (fun _ : Fin N => p) i)) (hw s)) ?_ ?_ ?_
      · intro s
        apply Limits.WidePullback.hom_ext (fun _ : Fin N => p)
        · intro i
          rw [Category.assoc, hgπ, Limits.WidePullback.lift_π, Fin.lastCases_castSucc]
        · rw [Category.assoc, hgb, Limits.WidePullback.lift_base, s.condition]
      · intro s
        rw [Limits.WidePullback.lift_π, Fin.lastCases_last]
      · intro s m h1 h2
        apply Limits.WidePullback.hom_ext (fun _ : Fin (N + 1) => p)
        · intro j
          refine Fin.lastCases ?_ (fun i => ?_) j
          · rw [Limits.WidePullback.lift_π, Fin.lastCases_last, h2]
          · rw [Limits.WidePullback.lift_π, Fin.lastCases_castSucc, ← hgπ, ← Category.assoc, h1]
        · rw [Limits.WidePullback.lift_base,
            ← Limits.WidePullback.π_arrow (fun _ : Fin (N + 1) => p) (Fin.last N),
            ← Category.assoc, h2]
    have hgfin : IsFinite g := MorphismProperty.of_isPullback (P := @IsFinite) hpb.flip inferInstance
    rw [← hgb]
    infer_instance

theorem wc_fnp_push_const_sections_lc : ∀ (Y Z : Scheme.{u}) (p : Z ⟶ Y) (m : ℕ), ∃ e : ∀ V : Y.Etale, ((wcEtPush p).obj ((constantSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))).obj.obj (Opposite.op V) ≃+ LocallyConstant ((wcEtBaseChange p).obj V).left (ZMod m), ∀ (V V' : Y.Etale) (g : V' ⟶ V) (s : ((wcEtPush p).obj ((constantSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))).obj.obj (Opposite.op V)) (x : ((wcEtBaseChange p).obj V').left), e V' ((((wcEtPush p).obj ((constantSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))).obj.map g.op).hom s) x = e V s (((wcEtBaseChange p).map g).left x) :=
by
  intro Y Z p m

  have hjs : ∀ (T : Scheme.{u}) (V : T.Etale) (S : Sieve V), (∀ v : V.left, ∃ (V₁ : T.Etale)
      (c : V₁ ⟶ V), S.arrows c ∧ v ∈ Set.range c.left) → S ∈ Scheme.smallEtaleTopology T V := by
    intro T V S hS
    change S ∈ Scheme.smallGrothendieckTopology @Etale T V
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale T
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
    apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale T
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
    intro x
    obtain ⟨V₁, c, hc, y, hy⟩ := hS x
    have hw : c.left ≫ V.hom = V₁.hom := MorphismProperty.Over.w c
    have hEt : Etale c.left := by
      have h1 : Etale V.hom := V.prop
      have h2 : Etale (c.left ≫ V.hom) := by rw [hw]; exact V₁.prop
      exact Etale.of_comp c.left V.hom
    exact ⟨V₁, c, y, hc, hEt, hy⟩

  have hcov : ∀ {X B : Scheme.{u}} (g : X ⟶ B), CoverPreserving (Scheme.smallEtaleTopology B)
      (Scheme.smallEtaleTopology X) (wcEtBaseChange g) := by
    intro X B g
    constructor
    intro V S hS
    change S ∈ Scheme.smallGrothendieckTopology @Etale B V at hS
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale B
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hS
    have hS' := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale B
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mp hS
    apply hjs
    intro v
    obtain ⟨W, a, w, ha, -, hw⟩ := hS' (Limits.pullback.fst V.hom g v)
    refine ⟨(wcEtBaseChange g).obj W, (wcEtBaseChange g).map a,
      Sieve.image_mem_functorPushforward (wcEtBaseChange g) S ha, ?_⟩
    have h0 : (Limits.pullback.fst W.hom g ≫ a.left) ≫ V.hom = Limits.pullback.snd W.hom g ≫ g := by
      rw [Category.assoc, MorphismProperty.Over.w a]
      exact Limits.pullback.condition
    let m' : Limits.pullback W.hom g ⟶ Limits.pullback V.hom g :=
      Limits.pullback.lift (Limits.pullback.fst W.hom g ≫ a.left) (Limits.pullback.snd W.hom g) h0
    have hmap : ((wcEtBaseChange g).map a).left = m' := rfl
    have h1 : Limits.pullback.fst a.left (Limits.pullback.fst V.hom g) ≫ W.hom =
        (Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) ≫ Limits.pullback.snd V.hom g) ≫ g := by
      rw [← MorphismProperty.Over.w a, ← Category.assoc, Limits.pullback.condition, Category.assoc,
        Limits.pullback.condition, Category.assoc]
    let ψ : Limits.pullback a.left (Limits.pullback.fst V.hom g) ⟶ Limits.pullback W.hom g :=
      Limits.pullback.lift (Limits.pullback.fst a.left (Limits.pullback.fst V.hom g))
        (Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) ≫ Limits.pullback.snd V.hom g) h1
    have hψ : ψ ≫ m' = Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, Limits.pullback.lift_fst, ← Category.assoc, Limits.pullback.lift_fst,
          Limits.pullback.condition]
      · rw [Category.assoc, Limits.pullback.lift_snd, Limits.pullback.lift_snd]
    obtain ⟨z, hz⟩ : ∃ z, Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) z = v := by
      have hv : (v : ↥(Limits.pullback V.hom g)) ∈
          Set.range (Limits.pullback.snd a.left (Limits.pullback.fst V.hom g)) := by
        rw [Scheme.Pullback.range_snd]
        exact ⟨w, hw⟩
      exact hv
    rw [hmap]
    exact ⟨ψ z, (Scheme.Hom.comp_apply ψ m' z).symm.trans (by rw [hψ]; exact hz)⟩

  haveI hfl : Limits.PreservesFiniteLimits (wcEtBaseChange p) := ⟨fun J _ _ =>
    haveI : Limits.PreservesLimitsOfShape J (wcEtBaseChange p ⋙ Scheme.Etale.forget Z) :=
      Limits.preservesLimitsOfShape_of_natIso
        (NatIso.ofComponents (fun _ => Iso.refl _) (fun _ => rfl) :
          Scheme.Etale.forget Y ⋙ Over.pullback p ≅ wcEtBaseChange p ⋙ Scheme.Etale.forget Z)
    Limits.preservesLimitsOfShape_of_reflects_of_preserves (wcEtBaseChange p) (Scheme.Etale.forget Z)⟩
  haveI := flat_of_preservesFiniteLimits (wcEtBaseChange p)
  haveI : (wcEtBaseChange p).IsContinuous (Scheme.smallEtaleTopology Y)
      (Scheme.smallEtaleTopology Z) :=
    Functor.isContinuous_of_coverPreserving (compatiblePreservingOfFlat _ _) (hcov p)

  have hP : Presheaf.IsSheaf (Scheme.smallEtaleTopology Y) (wcLCPb p (ULift.{u+1} (ZMod m))) :=
    Functor.op_comp_isSheaf_of_isSheaf (wcEtBaseChange p) (Scheme.smallEtaleTopology Y)
      (Scheme.smallEtaleTopology Z) (wcEtLC Z (ULift.{u+1} (ZMod m)))
      (wc_et_lc_isSheaf Z (ULift.{u+1} (ZMod m)))

  obtain ⟨ι⟩ := wc_et_push_const_lc_iso p (ULift.{u+1} (ZMod m))
    (wc_et_lc_isSheaf Z (ULift.{u+1} (ZMod m))) (wc_et_const_to_lc_locBij Z (ULift.{u+1} (ZMod m)))
  let Psh : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1} :=
    ⟨wcLCPb p (ULift.{u+1} (ZMod m)), hP⟩
  let θ : Psh ≅ (wcEtPush p).obj ((constantSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) :=
    sheafificationIso Psh ≪≫ ι

  let φ : ∀ V : Y.Etale, ((wcEtPush p).obj ((constantSheaf (Scheme.smallEtaleTopology Z)
      AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))).obj.obj (Opposite.op V) ≃+
      LocallyConstant ((wcEtBaseChange p).obj V).left (ULift.{u+1} (ZMod m)) := fun V =>
    { toFun := fun s => (θ.inv.hom.app (Opposite.op V)).hom s
      invFun := fun t => (θ.hom.hom.app (Opposite.op V)).hom t
      left_inv := fun s => by
        have h := congrArg (fun f => (f.hom.app (Opposite.op V)).hom s) θ.inv_hom_id
        exact h
      right_inv := fun t => by
        have h := congrArg (fun f => (f.hom.app (Opposite.op V)).hom t) θ.hom_inv_id
        exact h
      map_add' := fun s s' => map_add (θ.inv.hom.app (Opposite.op V)).hom s s' }

  let uu : ∀ (T : Type u) [TopologicalSpace T],
      LocallyConstant T (ULift.{u+1} (ZMod m)) ≃+ LocallyConstant T (ZMod m) := fun T _ =>
    { toFun := fun f => f.map ULift.down
      invFun := fun h => h.map ULift.up
      left_inv := fun f => LocallyConstant.ext fun _ => rfl
      right_inv := fun h => LocallyConstant.ext fun _ => rfl
      map_add' := fun f f' => LocallyConstant.ext fun _ => rfl }
  refine ⟨fun V => (φ V).trans (uu _), ?_⟩

  intro V V' g s x
  have hn : φ V' ((((wcEtPush p).obj ((constantSheaf (Scheme.smallEtaleTopology Z)
      AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))).obj.map g.op).hom s) =
      LocallyConstant.comap ⟨((wcEtBaseChange p).map g).left,
        ((wcEtBaseChange p).map g).left.continuous⟩ (φ V s) := by
    change (θ.inv.hom.app (Opposite.op V')).hom ((((wcEtPush p).obj ((constantSheaf
      (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))).obj.map g.op).hom s) =
      (Psh.obj.map g.op).hom ((θ.inv.hom.app (Opposite.op V)).hom s)
    rw [← AddCommGrpCat.comp_apply, θ.inv.hom.naturality, AddCommGrpCat.comp_apply]
  change ((φ V' ((((wcEtPush p).obj ((constantSheaf (Scheme.smallEtaleTopology Z)
      AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))).obj.map g.op).hom s)) x).down =
    ((φ V s) (((wcEtBaseChange p).map g).left x)).down
  rw [hn]
  rfl

theorem wc_fnp_subobject_sections : ∀ (Y : Scheme.{u}) (G : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (S S' : Subobject G), (S ≤ S' ↔ ∀ (V : Y.Etale) (s : G.obj.obj (Opposite.op V)), s ∈ Set.range (S.arrow.hom.app (Opposite.op V)).hom → s ∈ Set.range (S'.arrow.hom.app (Opposite.op V)).hom) ∧ ∀ (V : Y.Etale) (s : G.obj.obj (Opposite.op V)), (∀ v : V.left, ∃ (V' : Y.Etale) (c : V' ⟶ V), v ∈ Set.range c.left ∧ (G.obj.map c.op).hom s ∈ Set.range (S.arrow.hom.app (Opposite.op V')).hom) → s ∈ Set.range (S.arrow.hom.app (Opposite.op V)).hom :=
by
  intro Y G S S'
  classical
  have tnat : ∀ {A A' : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}} (φ : A ⟶ A')
      {V W : Y.Etale} (f : W ⟶ V) (x : A.obj.obj (Opposite.op V)),
      (A'.obj.map f.op).hom ((φ.hom.app (Opposite.op V)).hom x) =
        (φ.hom.app (Opposite.op W)).hom ((A.obj.map f.op).hom x) := by
    intro A A' φ V W f x
    rw [← AddCommGrpCat.comp_apply, ← φ.hom.naturality, AddCommGrpCat.comp_apply]
  have hinj : ∀ (T : Subobject G) (V : Y.Etale),
      Function.Injective (T.arrow.hom.app (Opposite.op V)).hom := by
    intro T V
    have : Mono ((sheafToPresheaf _ _ ⋙ (evaluation _ _).obj (Opposite.op V)).map T.arrow) :=
      inferInstance
    exact (AddCommGrpCat.mono_iff_injective _).1 this
  refine ⟨⟨fun h V s hs => ?_, fun H => ?_⟩, fun V s hloc => ?_⟩
  ·
    obtain ⟨t, rfl⟩ := hs
    refine ⟨((S.ofLE S' h).hom.app (Opposite.op V)).hom t, ?_⟩
    show (((S.ofLE S' h) ≫ S'.arrow).hom.app (Opposite.op V)).hom t = _
    rw [Subobject.ofLE_arrow]
  ·
    have key : ∀ (V : Y.Etale) (t : (Subobject.underlying.obj S).obj.obj (Opposite.op V)),
        ((S.arrow ≫ Limits.cokernel.π S'.arrow).hom.app (Opposite.op V)).hom t = 0 := by
      intro V t
      obtain ⟨t', ht'⟩ := H V _ ⟨t, rfl⟩
      change ((Limits.cokernel.π S'.arrow).hom.app (Opposite.op V)).hom
        ((S.arrow.hom.app (Opposite.op V)).hom t) = 0
      rw [← ht']
      change ((S'.arrow ≫ Limits.cokernel.π S'.arrow).hom.app (Opposite.op V)).hom t' = 0
      rw [Limits.cokernel.condition]
      rfl
    have h0 : S.arrow ≫ Limits.cokernel.π S'.arrow = 0 := by
      ext V t
      simpa using key V.unop t
    exact Subobject.le_of_comm (Abelian.monoLift S'.arrow S.arrow h0) (Abelian.monoLift_comp _ _ _)
  ·
    let R : Presieve V := fun V' h =>
      (G.obj.map h.op).hom s ∈ Set.range (S.arrow.hom.app (Opposite.op V')).hom
    have hT : Sieve.generate R ∈ Scheme.smallEtaleTopology Y V := by
      change Sieve.generate R ∈ Scheme.smallGrothendieckTopology @Etale Y V
      rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
      apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
      intro x
      obtain ⟨V₁, c, ⟨y, hy⟩, hc⟩ := hloc x
      have hw : c.left ≫ V.hom = V₁.hom := MorphismProperty.Over.w c
      have hEt : Etale c.left := by
        have h1 : Etale V.hom := V.prop
        have h2 : Etale (c.left ≫ V.hom) := by rw [hw]; exact V₁.prop
        exact Etale.of_comp c.left V.hom
      exact ⟨V₁, c, y, ⟨V₁, 𝟙 _, c, hc, Category.id_comp _⟩, hEt, hy⟩
    let P := (Subobject.underlying.obj S).obj
    have hTR : ∀ {W : Y.Etale} (h : W ⟶ V), (Sieve.generate R).arrows h → R h := by
      intro W h hh
      obtain ⟨V₁, k, g, ⟨t₁, ht₁⟩, rfl⟩ := hh
      refine ⟨(P.map k.op).hom t₁, ?_⟩
      rw [← tnat S.arrow k t₁, ht₁, op_comp, Functor.map_comp, AddCommGrpCat.comp_apply]
    let x : Presieve.FamilyOfElements (P ⋙ forget AddCommGrpCat) (Sieve.generate R).arrows :=
      fun W h hh => (hTR h hh).choose
    have hx : ∀ {W : Y.Etale} (h : W ⟶ V) (hh : (Sieve.generate R).arrows h),
        (S.arrow.hom.app (Opposite.op W)).hom (x h hh) = (G.obj.map h.op).hom s :=
      fun h hh => (hTR h hh).choose_spec
    have e : ∀ {Z W' : Y.Etale} (a : Z ⟶ W') (b : W' ⟶ V),
        (G.obj.map a.op).hom ((G.obj.map b.op).hom s) = (G.obj.map (a ≫ b).op).hom s := by
      intro Z W' a b
      rw [op_comp, Functor.map_comp, AddCommGrpCat.comp_apply]
    have hcompat : x.Compatible := by
      intro W₁ W₂ Z g₁ g₂ f₁ f₂ h₁ h₂ heq
      apply hinj S Z
      change (S.arrow.hom.app (Opposite.op Z)).hom ((P.map g₁.op).hom (x f₁ h₁)) =
        (S.arrow.hom.app (Opposite.op Z)).hom ((P.map g₂.op).hom (x f₂ h₂))
      rw [← tnat S.arrow g₁, ← tnat S.arrow g₂, hx f₁ h₁, hx f₂ h₂, e, e, heq]
    have hsheaf : Presieve.IsSheaf (Scheme.smallEtaleTopology Y) (P ⋙ forget AddCommGrpCat) :=
      (isSheaf_iff_isSheaf_of_type _ _).1
        ((Presheaf.isSheaf_iff_isSheaf_forget _ P (forget AddCommGrpCat)).1
          (Subobject.underlying.obj S).cond)
    have hSF := hsheaf _ hT
    refine ⟨hSF.amalgamate x hcompat, ?_⟩
    apply G.isSeparated V _ hT
    intro W h hh
    show (G.obj.map h.op).hom ((S.arrow.hom.app (Opposite.op V)).hom (hSF.amalgamate x hcompat)) =
      (G.obj.map h.op).hom s
    rw [tnat]
    have hr : (P.map h.op).hom (hSF.amalgamate x hcompat) = x h hh := hSF.valid_glue hcompat h hh
    rw [hr, hx h hh]

theorem wc_fnp_relation_locus_closed : ∀ {B Z : Scheme.{u}} (p : Z ⟶ B) (N m : ℕ) (c : Fin N → ZMod m) (I : ∀ V : B.Etale, Set (LocallyConstant ((wcEtBaseChange p).obj V).left (ZMod m))), IsClosed {y : (Limits.widePullback B (fun _ : Fin N => Z) (fun _ => p) : Scheme.{u}) | ∀ (V : B.Etale) (f : LocallyConstant ((wcEtBaseChange p).obj V).left (ZMod m)), f ∈ I V → ∀ y' : (Limits.pullback (C := Scheme.{u}) V.hom (Limits.WidePullback.base (fun _ : Fin N => p))), Limits.pullback.snd V.hom (Limits.WidePullback.base (fun _ : Fin N => p)) y' = y → ∑ i : Fin N, c i * f (Limits.pullback.map V.hom (Limits.WidePullback.base (fun _ : Fin N => p)) V.hom p (𝟙 _) (Limits.WidePullback.π (fun _ : Fin N => p) i) (𝟙 B) ((Category.comp_id _).trans (Category.id_comp _).symm) ((Category.comp_id _).trans (Limits.WidePullback.π_arrow (fun _ : Fin N => p) i).symm) y') = 0} :=
by
  intro B Z p N m c I
  rw [← isOpen_compl_iff, isOpen_iff_forall_mem_open]
  intro y hy
  simp only [Set.mem_compl_iff, Set.mem_setOf_eq] at hy
  push_neg at hy
  obtain ⟨V, f, hf, y', hy', hne⟩ := hy
  let π := fun i : Fin N => Limits.pullback.map V.hom (Limits.WidePullback.base (fun _ : Fin N => p)) V.hom p (𝟙 _) (Limits.WidePullback.π (fun _ : Fin N => p) i) (𝟙 B) ((Category.comp_id _).trans (Category.id_comp _).symm) ((Category.comp_id _).trans (Limits.WidePullback.π_arrow (fun _ : Fin N => p) i).symm)
  let U : Set (Limits.pullback (C := Scheme.{u}) V.hom (Limits.WidePullback.base (fun _ : Fin N => p))) :=
    ⋂ i : Fin N, {x | f (π i x) = f (π i y')}
  have hU : IsOpen U := by
    refine isOpen_iInter_of_finite (fun i => ?_)
    exact (f.isLocallyConstant.comp_continuous (π i).continuous).isOpen_fiber (f (π i y'))
  have hopen := (Limits.pullback.snd V.hom (Limits.WidePullback.base (fun _ : Fin N => p))).isOpenMap
  refine ⟨Limits.pullback.snd V.hom (Limits.WidePullback.base (fun _ : Fin N => p)) '' U, ?_, hopen U hU, ?_⟩
  · rintro _ ⟨u, hu, rfl⟩ hS
    have h1 := hS V f hf u rfl
    have hu' := Set.mem_iInter.mp hu
    apply hne
    refine Eq.trans (Finset.sum_congr rfl (fun i _ => ?_)) h1
    exact congrArg (fun a => c i * a) (hu' i).symm
  · exact ⟨y', Set.mem_iInter.mpr (fun i => rfl), hy'⟩

theorem wc_fnp_germ_subgroup : ∀ {B Z : Scheme.{u}} (p : Z ⟶ B) (m : ℕ) (I' : ∀ V : B.Etale, AddSubgroup (LocallyConstant ((wcEtBaseChange p).obj V).left (ZMod m))), (∀ (V V' : B.Etale) (g : V' ⟶ V) (f : LocallyConstant ((wcEtBaseChange p).obj V).left (ZMod m)), f ∈ I' V → f.comap ⟨((wcEtBaseChange p).map g).left, ((wcEtBaseChange p).map g).left.continuous⟩ ∈ I' V') → ∀ (Ω : Type u) [Field Ω] (xb : Spec (.of Ω) ⟶ B), ∃ M : AddSubgroup ({zb : Spec (.of Ω) ⟶ Z // zb ≫ p = xb} → ZMod m), ∀ w, w ∈ M ↔ ∃ (V' : B.Etale) (vb' : Spec (.of Ω) ⟶ V'.left) (hv : vb' ≫ V'.hom = xb), ∃ h ∈ I' V', ∀ zb : {zb : Spec (.of Ω) ⟶ Z // zb ≫ p = xb}, w zb = h (Limits.pullback.lift vb' zb.1 (hv.trans zb.2.symm) (IsLocalRing.closedPoint Ω)) :=
by
  intro B Z p m I' hstab Ω _ xb
  have BC : ∀ {V V' : B.Etale} (g : V' ⟶ V) {T : Scheme.{u}} (a : T ⟶ V'.left)
      (a₀ : T ⟶ V.left) (zb : T ⟶ Z) (h : a ≫ V'.hom = zb ≫ p) (h₀ : a₀ ≫ V.hom = zb ≫ p),
      a ≫ g.left = a₀ →
      Limits.pullback.lift a zb h ≫ ((wcEtBaseChange p).map g).left =
        Limits.pullback.lift a₀ zb h₀ := by
    intro V V' g T a a₀ zb h h₀ hg
    have h0 : (Limits.pullback.fst V'.hom p ≫ g.left) ≫ V.hom =
        Limits.pullback.snd V'.hom p ≫ p := by
      rw [Category.assoc, MorphismProperty.Over.w g]
      exact Limits.pullback.condition
    have hmap : ((wcEtBaseChange p).map g).left =
        Limits.pullback.lift (Limits.pullback.fst V'.hom p ≫ g.left)
          (Limits.pullback.snd V'.hom p) h0 := rfl
    rw [hmap]
    refine Limits.pullback.hom_ext (f := V.hom) (g := p) ?_ ?_
    · exact (Category.assoc _ _ _).trans
        ((congrArg (fun k => Limits.pullback.lift a zb h ≫ k) (Limits.pullback.lift_fst _ _ _)).trans
          ((Limits.pullback.lift_fst_assoc _ _ _ _).trans
            (hg.trans (Limits.pullback.lift_fst _ _ _).symm)))
    · exact (Category.assoc _ _ _).trans
        ((congrArg (fun k => Limits.pullback.lift a zb h ≫ k) (Limits.pullback.lift_snd _ _ _)).trans
          ((Limits.pullback.lift_snd _ _ _).trans (Limits.pullback.lift_snd _ _ _).symm))
  have BCpt : ∀ {V V' : B.Etale} (g : V' ⟶ V) {T : Scheme.{u}} (a : T ⟶ V'.left)
      (a₀ : T ⟶ V.left) (zb : T ⟶ Z) (h : a ≫ V'.hom = zb ≫ p) (h₀ : a₀ ≫ V.hom = zb ≫ p),
      a ≫ g.left = a₀ → ∀ t : T,
      ((wcEtBaseChange p).map g).left (Limits.pullback.lift a zb h t) =
        Limits.pullback.lift a₀ zb h₀ t := by
    intro V V' g T a a₀ zb h h₀ hg t
    exact (Scheme.Hom.comp_apply (Limits.pullback.lift a zb h) ((wcEtBaseChange p).map g).left
      t).symm.trans (congrArg (fun f => f t) (BC g a a₀ zb h h₀ hg))
  refine ⟨{ carrier := {w | ∃ (V' : B.Etale) (vb' : Spec (.of Ω) ⟶ V'.left)
              (hv : vb' ≫ V'.hom = xb), ∃ h ∈ I' V',
              ∀ zb : {zb : Spec (.of Ω) ⟶ Z // zb ≫ p = xb},
                w zb = h (Limits.pullback.lift vb' zb.1 (hv.trans zb.2.symm)
                  (IsLocalRing.closedPoint Ω))}
            add_mem' := ?_
            zero_mem' := ?_
            neg_mem' := ?_ }, fun w => Iff.rfl⟩
  · intro w₁ w₂ hw₁ hw₂
    obtain ⟨V₁, vb₁, hv₁, h₁, hh₁, H₁⟩ := hw₁
    obtain ⟨V₂, vb₂, hv₂, h₂, hh₂, H₂⟩ := hw₂
    haveI : Etale V₁.hom := V₁.prop
    haveI : Etale V₂.hom := V₂.prop
    let V₃ : B.Etale := MorphismProperty.Over.mk ⊤
      (Limits.pullback.fst V₁.hom V₂.hom ≫ V₁.hom) (by infer_instance)
    let g₁ : V₃ ⟶ V₁ := MorphismProperty.Over.homMk (Limits.pullback.fst V₁.hom V₂.hom) rfl trivial
    let g₂ : V₃ ⟶ V₂ := MorphismProperty.Over.homMk (Limits.pullback.snd V₁.hom V₂.hom)
      Limits.pullback.condition.symm trivial
    let vb₃ : Spec (.of Ω) ⟶ V₃.left := Limits.pullback.lift vb₁ vb₂ (hv₁.trans hv₂.symm)
    have hv₃ : vb₃ ≫ V₃.hom = xb := by
      show Limits.pullback.lift vb₁ vb₂ (hv₁.trans hv₂.symm) ≫
        Limits.pullback.fst V₁.hom V₂.hom ≫ V₁.hom = xb
      rw [Limits.pullback.lift_fst_assoc, hv₁]
    have e₁ : vb₃ ≫ g₁.left = vb₁ := Limits.pullback.lift_fst _ _ _
    have e₂ : vb₃ ≫ g₂.left = vb₂ := Limits.pullback.lift_snd _ _ _
    refine ⟨V₃, vb₃, hv₃,
      h₁.comap ⟨((wcEtBaseChange p).map g₁).left, ((wcEtBaseChange p).map g₁).left.continuous⟩ +
      h₂.comap ⟨((wcEtBaseChange p).map g₂).left, ((wcEtBaseChange p).map g₂).left.continuous⟩,
      add_mem (hstab V₁ V₃ g₁ h₁ hh₁) (hstab V₂ V₃ g₂ h₂ hh₂), fun zb => ?_⟩
    have k₁ := BCpt g₁ vb₃ vb₁ zb.1 (hv₃.trans zb.2.symm) (hv₁.trans zb.2.symm) e₁
      (IsLocalRing.closedPoint Ω)
    have k₂ := BCpt g₂ vb₃ vb₂ zb.1 (hv₃.trans zb.2.symm) (hv₂.trans zb.2.symm) e₂
      (IsLocalRing.closedPoint Ω)
    rw [Pi.add_apply, H₁ zb, H₂ zb, ← k₁, ← k₂]
    rfl
  · exact ⟨wcEtTop B, xb, Category.comp_id xb, 0, zero_mem _, fun zb => rfl⟩
  · intro w hw
    obtain ⟨V', vb', hv, h, hh, H⟩ := hw
    exact ⟨V', vb', hv, -h, neg_mem hh, fun zb =>
      (congrArg Neg.neg (H zb)).trans (LocallyConstant.neg_apply h _).symm⟩

theorem wc_fnp_geom_germ_criterion : ∀ {B Z : Scheme.{u}} (p : Z ⟶ B) [IsFinite p] (m : ℕ) (I' : ∀ V : B.Etale, AddSubgroup (LocallyConstant ((wcEtBaseChange p).obj V).left (ZMod m))), (∀ (V V' : B.Etale) (g : V' ⟶ V) (f : LocallyConstant ((wcEtBaseChange p).obj V).left (ZMod m)), f ∈ I' V → f.comap ⟨((wcEtBaseChange p).map g).left, ((wcEtBaseChange p).map g).left.continuous⟩ ∈ I' V') → (∀ (V : B.Etale) (f : LocallyConstant ((wcEtBaseChange p).obj V).left (ZMod m)), (∀ v : V.left, ∃ (V' : B.Etale) (g : V' ⟶ V), v ∈ Set.range g.left ∧ f.comap ⟨((wcEtBaseChange p).map g).left, ((wcEtBaseChange p).map g).left.continuous⟩ ∈ I' V') → f ∈ I' V) → ∀ (V : B.Etale) (f : LocallyConstant ((wcEtBaseChange p).obj V).left (ZMod m)), (∀ v : V.left, ∃ (Ω : Type u) (_ : Field Ω) (_ : IsAlgClosed Ω) (vb : Spec (.of Ω) ⟶ V.left), vb (IsLocalRing.closedPoint Ω) = v ∧ ∃ (V' : B.Etale) (vb' : Spec (.of Ω) ⟶ V'.left) (hv : vb' ≫ V'.hom = vb ≫ V.hom), ∃ h ∈ I' V', ∀ (zb : Spec (.of Ω) ⟶ Z) (hz : zb ≫ p = vb ≫ V.hom), f (Limits.pullback.lift vb zb hz.symm (IsLocalRing.closedPoint Ω)) = h (Limits.pullback.lift vb' zb (hv.trans hz.symm) (IsLocalRing.closedPoint Ω))) → f ∈ I' V :=
by
  intro B Z p _ m I' hstab hloc V f hH

  have bc_fst : ∀ {V V' : B.Etale} (g : V' ⟶ V),
      ((wcEtBaseChange p).map g).left ≫ Limits.pullback.fst V.hom p =
        Limits.pullback.fst V'.hom p ≫ g.left := by
    intro V V' g
    have h0 : (Limits.pullback.fst V'.hom p ≫ g.left) ≫ V.hom =
        Limits.pullback.snd V'.hom p ≫ p := by
      rw [Category.assoc, MorphismProperty.Over.w g]
      exact Limits.pullback.condition
    have hmap : ((wcEtBaseChange p).map g).left =
        Limits.pullback.lift (Limits.pullback.fst V'.hom p ≫ g.left)
          (Limits.pullback.snd V'.hom p) h0 := rfl
    rw [hmap]
    exact Limits.pullback.lift_fst _ _ _
  have bc_snd : ∀ {V V' : B.Etale} (g : V' ⟶ V),
      ((wcEtBaseChange p).map g).left ≫ Limits.pullback.snd V.hom p =
        Limits.pullback.snd V'.hom p := by
    intro V V' g
    have h0 : (Limits.pullback.fst V'.hom p ≫ g.left) ≫ V.hom =
        Limits.pullback.snd V'.hom p ≫ p := by
      rw [Category.assoc, MorphismProperty.Over.w g]
      exact Limits.pullback.condition
    have hmap : ((wcEtBaseChange p).map g).left =
        Limits.pullback.lift (Limits.pullback.fst V'.hom p ≫ g.left)
          (Limits.pullback.snd V'.hom p) h0 := rfl
    rw [hmap]
    exact Limits.pullback.lift_snd _ _ _
  have bc_lift : ∀ {V V' : B.Etale} (g : V' ⟶ V) {T : Scheme.{u}} (a : T ⟶ V'.left)
      (a₀ : T ⟶ V.left) (zb : T ⟶ Z) (h : a ≫ V'.hom = zb ≫ p) (h₀ : a₀ ≫ V.hom = zb ≫ p),
      a ≫ g.left = a₀ →
      Limits.pullback.lift a zb h ≫ ((wcEtBaseChange p).map g).left =
        Limits.pullback.lift a₀ zb h₀ := by
    intro V V' g T a a₀ zb h h₀ ha
    apply Limits.pullback.hom_ext
    · exact (Category.assoc _ _ _).trans
        ((congrArg (Limits.pullback.lift a zb h ≫ ·) (bc_fst g)).trans
          ((Category.assoc _ _ _).symm.trans
            ((congrArg (· ≫ g.left) (Limits.pullback.lift_fst _ _ _)).trans
              (ha.trans (Limits.pullback.lift_fst _ _ _).symm))))
    · exact (Category.assoc _ _ _).trans
        ((congrArg (Limits.pullback.lift a zb h ≫ ·) (bc_snd g)).trans
          ((Limits.pullback.lift_snd _ _ _).trans (Limits.pullback.lift_snd _ _ _).symm))
  apply hloc V f
  intro v
  obtain ⟨Ω, _, _, vb, hvb, V', vb', hv, h, hh, hfib⟩ := hH v

  have geomLift : ∀ {Z' V'' : Scheme.{u}} (f' : Z' ⟶ V'') [IsFinite f']
      (vb'' : Spec (.of Ω) ⟶ V'') (z : Z'), f' z = vb'' (IsLocalRing.closedPoint Ω) →
      ∃ zb : Spec (.of Ω) ⟶ Z', zb ≫ f' = vb'' ∧ zb (IsLocalRing.closedPoint Ω) = z := by
    intro Z' V'' f' _ vb'' z hz
    obtain ⟨w, hw1, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := f') (g := vb'') z
      (IsLocalRing.closedPoint Ω) hz
    haveI : IsLocallyArtinian (Limits.pullback f' vb'') :=
      IsLocallyArtinian.of_locallyQuasiFinite (Limits.pullback.snd f' vb'')
    have hwc : IsClosed ({w} : Set ↥(Limits.pullback f' vb'')) := isClosed_discrete _
    let σ : Spec (.of Ω) ⟶ Limits.pullback f' vb'' :=
      pointOfClosedPoint (K := Ω) (Limits.pullback.snd f' vb'') w hwc
    have hσ1 : σ ≫ Limits.pullback.snd f' vb'' = 𝟙 _ := pointOfClosedPoint_comp _ _ _
    have hσ2 : ∀ a : Spec (.of Ω), (σ ≫ Limits.pullback.fst f' vb'') a = z := by
      intro a
      rw [Scheme.Hom.comp_apply]
      rw [show σ a = w from pointOfClosedPoint_apply _ _ _ a, hw1]
    refine ⟨σ ≫ Limits.pullback.fst f' vb'', ?_, hσ2 _⟩
    rw [Category.assoc, Limits.pullback.condition, ← Category.assoc, hσ1, Category.id_comp]

  obtain ⟨V₃, φ, ψ, vb₃, hφ, hψ⟩ : ∃ (V₃ : B.Etale) (φ : V₃ ⟶ V) (ψ : V₃ ⟶ V')
      (vb₃ : Spec (.of Ω) ⟶ V₃.left), vb₃ ≫ φ.left = vb ∧ vb₃ ≫ ψ.left = vb' := by
    haveI : Etale V.hom := V.prop
    haveI : Etale V'.hom := V'.prop
    exact ⟨MorphismProperty.Over.mk ⊤ (Limits.pullback.fst V.hom V'.hom ≫ V.hom) (by infer_instance),
      MorphismProperty.Over.homMk (Limits.pullback.fst V.hom V'.hom) rfl trivial,
      MorphismProperty.Over.homMk (Limits.pullback.snd V.hom V'.hom)
        Limits.pullback.condition.symm trivial,
      Limits.pullback.lift vb vb' hv.symm, Limits.pullback.lift_fst _ _ _,
      Limits.pullback.lift_snd _ _ _⟩
  have hV₃ : vb₃ ≫ V₃.hom = vb ≫ V.hom := by
    rw [← MorphismProperty.Over.w φ, ← Category.assoc, hφ]

  let d : LocallyConstant ((wcEtBaseChange p).obj V₃).left (ZMod m) :=
    f.comap ⟨((wcEtBaseChange p).map φ).left, ((wcEtBaseChange p).map φ).left.continuous⟩ -
      h.comap ⟨((wcEtBaseChange p).map ψ).left, ((wcEtBaseChange p).map ψ).left.continuous⟩
  have hdval : ∀ x, d x = f (((wcEtBaseChange p).map φ).left x) -
      h (((wcEtBaseChange p).map ψ).left x) := fun x => rfl
  have hh₃ : h.comap ⟨((wcEtBaseChange p).map ψ).left,
      ((wcEtBaseChange p).map ψ).left.continuous⟩ ∈ I' V₃ := hstab V' V₃ ψ h hh

  have hd_fib : ∀ (zb : Spec (.of Ω) ⟶ Z) (hz : zb ≫ p = vb₃ ≫ V₃.hom),
      d (Limits.pullback.lift vb₃ zb hz.symm (IsLocalRing.closedPoint Ω)) = 0 := by
    intro zb hz
    have hz' : zb ≫ p = vb ≫ V.hom := hz.trans hV₃
    have e1 : ((wcEtBaseChange p).map φ).left
        (Limits.pullback.lift vb₃ zb hz.symm (IsLocalRing.closedPoint Ω)) =
        Limits.pullback.lift vb zb hz'.symm (IsLocalRing.closedPoint Ω) :=
      (Scheme.Hom.comp_apply _ _ _).symm.trans
        (congrArg (fun k : Spec (.of Ω) ⟶ ((wcEtBaseChange p).obj V).left =>
          k (IsLocalRing.closedPoint Ω)) (bc_lift φ vb₃ vb zb hz.symm hz'.symm hφ))
    have e2 : ((wcEtBaseChange p).map ψ).left
        (Limits.pullback.lift vb₃ zb hz.symm (IsLocalRing.closedPoint Ω)) =
        Limits.pullback.lift vb' zb (hv.trans hz'.symm) (IsLocalRing.closedPoint Ω) :=
      (Scheme.Hom.comp_apply _ _ _).symm.trans
        (congrArg (fun k : Spec (.of Ω) ⟶ ((wcEtBaseChange p).obj V').left =>
          k (IsLocalRing.closedPoint Ω)) (bc_lift ψ vb₃ vb' zb hz.symm (hv.trans hz'.symm) hψ))
    exact (hdval _).trans ((congrArg₂ (fun a b : ZMod m => a - b) (congrArg f e1)
      (congrArg h e2)).trans (sub_eq_zero.mpr (hfib zb hz')))

  have hC : IsClosed ((⇑d ⁻¹' {0})ᶜ) :=
    (IsLocallyConstant.isClopen_fiber d.isLocallyConstant 0).compl.isClosed
  have hK : IsClosed ((Limits.pullback.fst V₃.hom p) '' ((⇑d ⁻¹' {0})ᶜ)) :=
    Scheme.Hom.isClosedMap (Limits.pullback.fst V₃.hom p) _ hC
  let W : V₃.left.Opens := ⟨((Limits.pullback.fst V₃.hom p) '' ((⇑d ⁻¹' {0})ᶜ))ᶜ, hK.isOpen_compl⟩
  have hvbW : vb₃ (IsLocalRing.closedPoint Ω) ∈ W := by
    rintro ⟨x, hxC, hxv⟩
    obtain ⟨xb, hxb, hxbpt⟩ := geomLift (Limits.pullback.fst V₃.hom p) vb₃ x hxv
    obtain ⟨zb, hzb⟩ : ∃ zb, zb = xb ≫ Limits.pullback.snd V₃.hom p := ⟨_, rfl⟩
    have hz : zb ≫ p = vb₃ ≫ V₃.hom := by
      rw [hzb, Category.assoc, ← Limits.pullback.condition, ← Category.assoc, hxb]
    have hxl : xb = Limits.pullback.lift vb₃ zb hz.symm :=
      Limits.pullback.hom_ext (by rw [Limits.pullback.lift_fst, hxb])
        (by rw [Limits.pullback.lift_snd, hzb])
    have e : d x = d (xb (IsLocalRing.closedPoint Ω)) := congrArg d hxbpt.symm
    exact hxC (show d x = 0 from e.trans
      ((congrArg (fun k : Spec (.of Ω) ⟶ Limits.pullback V₃.hom p =>
        d (k (IsLocalRing.closedPoint Ω))) hxl).trans (hd_fib zb hz)))
  have hdW : ∀ x, Limits.pullback.fst V₃.hom p x ∈ W → d x = 0 := by
    intro x hx
    by_contra hne
    exact hx ⟨x, hne, rfl⟩

  refine ⟨wcEtOpen B V₃ W, wcEtOpenι B V₃ W ≫ φ, ?_, ?_⟩
  · obtain ⟨t, ht⟩ : vb₃ (IsLocalRing.closedPoint Ω) ∈ Set.range W.ι := by
      rw [Scheme.Opens.range_ι]; exact hvbW
    refine ⟨t, ?_⟩
    have e : (wcEtOpenι B V₃ W ≫ φ).left = W.ι ≫ φ.left := rfl
    exact (congrArg (fun k : (wcEtOpen B V₃ W).left ⟶ V.left => k t) e).trans
      ((Scheme.Hom.comp_apply _ _ _).trans ((congrArg φ.left ht).trans
        ((Scheme.Hom.comp_apply _ _ _).symm.trans
          ((congrArg (fun k : Spec (.of Ω) ⟶ V.left => k (IsLocalRing.closedPoint Ω)) hφ).trans
            hvb))))
  · have hmem := hstab V₃ (wcEtOpen B V₃ W) (wcEtOpenι B V₃ W) _ hh₃
    convert hmem using 1
    ext x
    have hcomp : ((wcEtBaseChange p).map (wcEtOpenι B V₃ W ≫ φ)).left =
        ((wcEtBaseChange p).map (wcEtOpenι B V₃ W)).left ≫ ((wcEtBaseChange p).map φ).left := by
      rw [Functor.map_comp]; rfl
    have e1 : Limits.pullback.fst V₃.hom p (((wcEtBaseChange p).map (wcEtOpenι B V₃ W)).left x) =
        W.ι (Limits.pullback.fst (wcEtOpen B V₃ W).hom p x) :=
      (Scheme.Hom.comp_apply _ _ _).symm.trans
        ((congrArg (fun k : ((wcEtBaseChange p).obj (wcEtOpen B V₃ W)).left ⟶ V₃.left => k x)
          (bc_fst (wcEtOpenι B V₃ W))).trans (Scheme.Hom.comp_apply _ _ _))
    have h3 : W.ι (Limits.pullback.fst (wcEtOpen B V₃ W).hom p x) ∈ (W : Set V₃.left) :=
      (Scheme.Opens.range_ι W).subset ⟨_, rfl⟩
    have hxW : Limits.pullback.fst V₃.hom p (((wcEtBaseChange p).map (wcEtOpenι B V₃ W)).left x)
        ∈ (W : Set V₃.left) := Eq.mpr (congrArg (· ∈ (W : Set V₃.left)) e1) h3
    have hd0 := (hdval _).symm.trans (hdW _ hxW)
    show f (((wcEtBaseChange p).map (wcEtOpenι B V₃ W ≫ φ)).left x) =
      h (((wcEtBaseChange p).map ψ).left (((wcEtBaseChange p).map (wcEtOpenι B V₃ W)).left x))
    exact (congrArg f ((congrArg (fun k : ((wcEtBaseChange p).obj (wcEtOpen B V₃ W)).left ⟶
      ((wcEtBaseChange p).obj V).left => k x) hcomp).trans (Scheme.Hom.comp_apply _ _ _))).trans
      (sub_eq_zero.mp hd0)

theorem wc_fnp_relation_locus_geom_point : ∀ {B Z : Scheme.{u}} (p : Z ⟶ B) (m N : ℕ) (J : ∀ V : B.Etale, AddSubgroup (LocallyConstant ((wcEtBaseChange p).obj V).left (ZMod m))) (c : Fin N → ZMod m) (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (xb : Spec (.of Ω) ⟶ B) (zb : Fin N → (Spec (.of Ω) ⟶ Z)) (hz : ∀ i, zb i ≫ p = xb), (Limits.WidePullback.lift xb zb hz (IsLocalRing.closedPoint Ω) ∈ {y : (Limits.widePullback B (fun _ : Fin N => Z) (fun _ => p) : Scheme.{u}) | ∀ (V : B.Etale) (f : LocallyConstant ((wcEtBaseChange p).obj V).left (ZMod m)), f ∈ J V → ∀ y' : (Limits.pullback (C := Scheme.{u}) V.hom (Limits.WidePullback.base (fun _ : Fin N => p))), Limits.pullback.snd V.hom (Limits.WidePullback.base (fun _ : Fin N => p)) y' = y → ∑ i : Fin N, c i * f (Limits.pullback.map V.hom (Limits.WidePullback.base (fun _ : Fin N => p)) V.hom p (𝟙 _) (Limits.WidePullback.π (fun _ : Fin N => p) i) (𝟙 B) ((Category.comp_id _).trans (Category.id_comp _).symm) ((Category.comp_id _).trans (Limits.WidePullback.π_arrow (fun _ : Fin N => p) i).symm) y') = 0}) ↔ ∀ (V : B.Etale) (vb : Spec (.of Ω) ⟶ V.left) (hvb : vb ≫ V.hom = xb), ∀ f ∈ J V, ∑ i : Fin N, c i * f (Limits.pullback.lift vb (zb i) (hvb.trans (hz i).symm) (IsLocalRing.closedPoint Ω)) = 0 :=
by
  intro B Z p m N J c Ω _ _ xb zb hz
  have hlift : ∀ {V U : Scheme.{u}} (g : V ⟶ U) [Etale g]
      (s : Spec (.of Ω) ⟶ U) (v : V), g v = s (IsLocalRing.closedPoint Ω) →
      ∃ t : Spec (.of Ω) ⟶ V, t ≫ g = s ∧ t (IsLocalRing.closedPoint Ω) = v := by
    intro V U g _ s v hv
    have hs : s = Spec.map (Scheme.SpecToEquivOfField Ω U s).2 ≫
        U.fromSpecResidueField (Scheme.SpecToEquivOfField Ω U s).1 := by
      rw [← Scheme.SpecToEquivOfField_symm_apply, Equiv.symm_apply_apply]
    have h1 : (Scheme.SpecToEquivOfField Ω U s).1 = s (IsLocalRing.closedPoint Ω) := rfl
    generalize Scheme.SpecToEquivOfField Ω U s = q at hs h1
    obtain ⟨u, φ⟩ := q
    simp only at hs h1
    rw [← h1] at hv
    subst hv
    letI : Algebra (U.residueField (g v)) (V.residueField v) := (g.residueFieldMap v).hom.toAlgebra
    haveI : Algebra.IsSeparable (U.residueField (g v)) (V.residueField v) := inferInstance
    haveI : Algebra.IsAlgebraic (U.residueField (g v)) (V.residueField v) :=
      Algebra.IsSeparable.isAlgebraic _ _
    letI : Algebra (U.residueField (g v)) Ω := φ.hom.toAlgebra
    let χ₀ : V.residueField v →ₐ[U.residueField (g v)] Ω :=
      IsAlgClosed.lift (R := U.residueField (g v)) (S := V.residueField v) (M := Ω)
    let χ : V.residueField v ⟶ CommRingCat.of Ω := CommRingCat.ofHom χ₀.toRingHom
    have hχ : g.residueFieldMap v ≫ χ = φ := by
      ext r
      exact χ₀.commutes r
    have key : ∀ x : Spec (.of Ω), (Spec.map χ ≫ V.fromSpecResidueField v) x = v := by
      intro x
      rw [Scheme.Hom.comp_apply]
      exact Scheme.fromSpecResidueField_apply _ _
    refine ⟨Spec.map χ ≫ V.fromSpecResidueField v, ?_, key _⟩
    rw [Category.assoc, ← Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField,
      ← Category.assoc, ← Spec.map_comp, hχ, hs]
  have hF : ∀ (V : B.Etale) (i : Fin N)
      (t : Spec (.of Ω) ⟶ Limits.pullback V.hom (Limits.WidePullback.base (fun _ : Fin N => p)))
      (a : Spec (.of Ω) ⟶ V.left) (h : a ≫ V.hom = zb i ≫ p),
      t ≫ Limits.pullback.fst V.hom (Limits.WidePullback.base (fun _ : Fin N => p)) = a →
      t ≫ Limits.pullback.snd V.hom (Limits.WidePullback.base (fun _ : Fin N => p)) ≫
        Limits.WidePullback.π (fun _ : Fin N => p) i = zb i →
      ∀ x, Limits.pullback.map V.hom (Limits.WidePullback.base (fun _ : Fin N => p)) V.hom p (𝟙 _)
        (Limits.WidePullback.π (fun _ : Fin N => p) i) (𝟙 B)
        ((Category.comp_id _).trans (Category.id_comp _).symm)
        ((Category.comp_id _).trans (Limits.WidePullback.π_arrow (fun _ : Fin N => p) i).symm) (t x) =
        Limits.pullback.lift a (zb i) h x := by
    intro V i t a h h1 h2 x
    have e : t ≫ Limits.pullback.map V.hom (Limits.WidePullback.base (fun _ : Fin N => p)) V.hom p (𝟙 _)
        (Limits.WidePullback.π (fun _ : Fin N => p) i) (𝟙 B)
        ((Category.comp_id _).trans (Category.id_comp _).symm)
        ((Category.comp_id _).trans (Limits.WidePullback.π_arrow (fun _ : Fin N => p) i).symm) =
        Limits.pullback.lift a (zb i) h := by
      apply Limits.pullback.hom_ext
      · simp only [Category.assoc, Limits.pullback.lift_fst, Limits.pullback.map, Category.comp_id]
        exact h1
      · simp only [Category.assoc, Limits.pullback.lift_snd, Limits.pullback.map]
        exact h2
    rw [← e, Scheme.Hom.comp_apply]
  constructor
  · intro H V vb hvb f hf
    rw [Set.mem_setOf_eq] at H
    have w : vb ≫ V.hom = Limits.WidePullback.lift xb zb hz ≫
        Limits.WidePullback.base (fun _ : Fin N => p) := by
      rw [Limits.WidePullback.lift_base]; exact hvb
    obtain ⟨t, ht1, ht2⟩ : ∃ t : Spec (.of Ω) ⟶
        Limits.pullback V.hom (Limits.WidePullback.base (fun _ : Fin N => p)),
        t ≫ Limits.pullback.fst V.hom (Limits.WidePullback.base (fun _ : Fin N => p)) = vb ∧
        t ≫ Limits.pullback.snd V.hom (Limits.WidePullback.base (fun _ : Fin N => p)) =
          Limits.WidePullback.lift xb zb hz :=
      ⟨Limits.pullback.lift vb (Limits.WidePullback.lift xb zb hz) w,
        Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
    have hsnd : Limits.pullback.snd V.hom (Limits.WidePullback.base (fun _ : Fin N => p))
        (t (IsLocalRing.closedPoint Ω)) =
        Limits.WidePullback.lift xb zb hz (IsLocalRing.closedPoint Ω) := by
      rw [← ht2]
      first
        | exact (Scheme.Hom.comp_apply _ _ _).symm
        | rfl
    refine Eq.trans (Finset.sum_congr rfl fun i _ => ?_) (H V f hf _ hsnd)
    exact congrArg (fun y => c i * f y) (hF V i t vb (hvb.trans (hz i).symm) ht1
      (by rw [← Category.assoc, ht2, Limits.WidePullback.lift_π]) _).symm
  · intro H
    rw [Set.mem_setOf_eq]
    intro V f hf y' hy'
    obtain ⟨t, ht1, ht2⟩ := hlift
      (Limits.pullback.snd V.hom (Limits.WidePullback.base (fun _ : Fin N => p)))
      (Limits.WidePullback.lift xb zb hz) y' hy'
    subst ht2
    have hvb : (t ≫ Limits.pullback.fst V.hom (Limits.WidePullback.base (fun _ : Fin N => p))) ≫
        V.hom = xb := by
      rw [Category.assoc, Limits.pullback.condition, ← Category.assoc, ht1]
      first
        | exact Limits.WidePullback.lift_base _ _ _ _
        | exact Limits.WidePullback.lift_base _ _ _
        | exact Limits.WidePullback.lift_base _
        | simp
    refine Eq.trans (Finset.sum_congr rfl fun i _ => ?_) (H V _ hvb f hf)
    exact congrArg (fun y => c i * f y) (hF V i t _ (hvb.trans (hz i).symm) rfl
      (by rw [← Category.assoc, ht1, Limits.WidePullback.lift_π]) _)

theorem wc_fnp_relation_locus_separates : ∀ {B Z : Scheme.{u}} (p : Z ⟶ B) [IsFinite p] (ℓ N : ℕ), ℓ.Prime → (∀ (Ω : Type u) [Field Ω] (xb : Spec (.of Ω) ⟶ B), Nat.card {zb : Spec (.of Ω) ⟶ Z // zb ≫ p = xb} ≤ N) → ∀ (I I' : ∀ V : B.Etale, AddSubgroup (LocallyConstant ((wcEtBaseChange p).obj V).left (ZMod ℓ))), (∀ (V V' : B.Etale) (g : V' ⟶ V) (f : LocallyConstant ((wcEtBaseChange p).obj V).left (ZMod ℓ)), f ∈ I' V → f.comap ⟨((wcEtBaseChange p).map g).left, ((wcEtBaseChange p).map g).left.continuous⟩ ∈ I' V') → (∀ (V : B.Etale) (f : LocallyConstant ((wcEtBaseChange p).obj V).left (ZMod ℓ)), (∀ v : V.left, ∃ (V' : B.Etale) (g : V' ⟶ V), v ∈ Set.range g.left ∧ f.comap ⟨((wcEtBaseChange p).map g).left, ((wcEtBaseChange p).map g).left.continuous⟩ ∈ I' V') → f ∈ I' V) → (∀ c : Fin N → ZMod ℓ, {y : (Limits.widePullback B (fun _ : Fin N => Z) (fun _ => p) : Scheme.{u}) | ∀ (V : B.Etale) (f : LocallyConstant ((wcEtBaseChange p).obj V).left (ZMod ℓ)), f ∈ I' V → ∀ y' : (Limits.pullback (C := Scheme.{u}) V.hom (Limits.WidePullback.base (fun _ : Fin N => p))), Limits.pullback.snd V.hom (Limits.WidePullback.base (fun _ : Fin N => p)) y' = y → ∑ i : Fin N, c i * f (Limits.pullback.map V.hom (Limits.WidePullback.base (fun _ : Fin N => p)) V.hom p (𝟙 _) (Limits.WidePullback.π (fun _ : Fin N => p) i) (𝟙 B) ((Category.comp_id _).trans (Category.id_comp _).symm) ((Category.comp_id _).trans (Limits.WidePullback.π_arrow (fun _ : Fin N => p) i).symm) y') = 0} ⊆ {y : (Limits.widePullback B (fun _ : Fin N => Z) (fun _ => p) : Scheme.{u}) | ∀ (V : B.Etale) (f : LocallyConstant ((wcEtBaseChange p).obj V).left (ZMod ℓ)), f ∈ I V → ∀ y' : (Limits.pullback (C := Scheme.{u}) V.hom (Limits.WidePullback.base (fun _ : Fin N => p))), Limits.pullback.snd V.hom (Limits.WidePullback.base (fun _ : Fin N => p)) y' = y → ∑ i : Fin N, c i * f (Limits.pullback.map V.hom (Limits.WidePullback.base (fun _ : Fin N => p)) V.hom p (𝟙 _) (Limits.WidePullback.π (fun _ : Fin N => p) i) (𝟙 B) ((Category.comp_id _).trans (Category.id_comp _).symm) ((Category.comp_id _).trans (Limits.WidePullback.π_arrow (fun _ : Fin N => p) i).symm) y') = 0}) → ∀ V : B.Etale, I V ≤ I' V :=
by
  have wc_fnp_fibre_functional : ∀ (ℓ N : ℕ), ℓ.Prime → ∀ (P : Type u) [Finite P], Nat.card P ≤ N → ∀ (M : AddSubgroup (P → ZMod ℓ)) (w : P → ZMod ℓ), w ∉ M → ∃ (c : Fin N → ZMod ℓ) (z : Fin N → P), (∀ x ∈ M, ∑ i : Fin N, c i * x (z i) = 0) ∧ ∑ i : Fin N, c i * w (z i) ≠ 0 := by
    intro ℓ N hℓ P _ hcard M w hw
    classical
    haveI : Fact ℓ.Prime := ⟨hℓ⟩
    letI := Fintype.ofFinite P
    have hw' : w ∉ AddSubgroup.toZModSubmodule ℓ M := fun h =>
      hw ((AddSubgroup.mem_toZModSubmodule _).1 h)
    obtain ⟨φ, hφw, hle⟩ := Submodule.exists_le_ker_of_notMem hw'
    have hne : Nonempty P := by
      by_contra h
      rw [not_nonempty_iff] at h
      apply hw
      have : w = 0 := funext fun q => (IsEmpty.false q).elim
      rw [this]; exact M.zero_mem
    obtain ⟨z₀⟩ := hne
    have hn : Fintype.card P ≤ N := by rw [← Nat.card_eq_fintype_card]; exact hcard
    let e := Fintype.equivFin P
    let z : Fin N → P := fun i =>
      if h : i.val < Fintype.card P then e.symm ⟨i.val, h⟩ else z₀
    let c : Fin N → ZMod ℓ := fun i =>
      if h : i.val < Fintype.card P then φ (Pi.single (e.symm ⟨i.val, h⟩) 1) else 0
    have key : ∀ x : P → ZMod ℓ, ∑ i : Fin N, c i * x (z i) = φ x := by
      intro x
      have h1 : φ x = ∑ q : P, φ (Pi.single q 1) * x q := by
        conv_lhs => rw [← Finset.univ_sum_single x]
        rw [map_sum]
        refine Finset.sum_congr rfl fun q _ => ?_
        have hs : (Pi.single q (x q) : P → ZMod ℓ) = x q • Pi.single q 1 := by
          ext j
          by_cases h : j = q
          · subst h; simp
          · simp [h]
        rw [hs, map_smul, smul_eq_mul, mul_comm]
      rw [h1]
      symm
      refine Fintype.sum_of_injective (fun q => Fin.castLE hn (e q)) ?_ _ _ ?_ ?_
      · intro a b hab
