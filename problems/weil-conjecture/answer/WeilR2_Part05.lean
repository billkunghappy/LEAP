        obtain ⟨x₃, hx₃⟩ := Abelian.Ext.covariant_sequence_exact₁ P0 hS x hx rfl
        haveI := IH q₀ (Nat.lt_succ_self q₀) _ hQS hQT
        rw [← hx₃, Subsingleton.elim x₃ 0, Abelian.Ext.zero_comp]
