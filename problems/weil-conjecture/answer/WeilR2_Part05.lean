  intro B Z p _ ℓ N hℓ hN I I' hstab hloc hsep V f hf
  apply wc_fnp_geom_germ_criterion p ℓ I' hstab hloc V f
  intro v
  have hpt : ∀ (X : Scheme.{u}) (x : X), ∃ (Ω : Type u) (_ : Field Ω) (_ : IsAlgClosed Ω)
