  have s8 : ∀ {X Y : Scheme.{u}} (α : X ⟶ Y) (n : ℕ) (U V : Fin n → Scheme.{u}) (u : ∀ i, U i ⟶ X) (v : ∀ i, V i ⟶ Y) (k : ∀ i, U i ⟶ V i) (hu : ∀ i, IsOpenImmersion (u i)) (hv : ∀ i, IsOpenImmersion (v i)) (hk : ∀ i, IsIso (k i)) (hc : ∀ i, u i ≫ α = k i ≫ v i) (hcov : ∀ y : Y, ∃ i, y ∈ Set.range (v i)) (hpre : ∀ i (x : X), α x ∈ Set.range (v i) → x ∈ Set.range (u i)),
