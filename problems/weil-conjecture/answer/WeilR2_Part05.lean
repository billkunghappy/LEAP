      (key U'' c).symm.trans
        ((congrArg (fun w => (Θ.hom.hom.app (Opposite.op U'')).hom w) hs).trans (map_zero _))
    haveI := Presheaf.isLocallyInjective_toSheafify' (Scheme.smallEtaleTopology S) T.homology
    have hE := Presheaf.equalizerSieve_mem (Scheme.smallEtaleTopology S)
