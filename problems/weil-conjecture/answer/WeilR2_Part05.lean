theorem wc_pd_P1Z_fst_proper : ∀ (S : Scheme.{u}), IsProper (Limits.prod.fst : S ⨯ wcPdP1Z.{u} ⟶ S) :=
by
  intro S
  classical
  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin 2) (ULift.{u} ℤ)) :=
    MvPolynomial.gradedAlgebra
  let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin 2) (ULift.{u} ℤ)
  haveI hST : IsScalarTower (ULift.{u} ℤ) (𝒜 0) (MvPolynomial (Fin 2) (ULift.{u} ℤ)) :=
    IsScalarTower.of_algebraMap_eq (R := ULift.{u} ℤ) (S := 𝒜 0)
      (A := MvPolynomial (Fin 2) (ULift.{u} ℤ)) (fun x => by
        first
        | rfl
        | (rw [SetLike.GradeZero.algebraMap_apply, SetLike.GradeZero.coe_algebraMap]))
  haveI hFT : Algebra.FiniteType (𝒜 0) (MvPolynomial (Fin 2) (ULift.{u} ℤ)) :=
    Algebra.FiniteType.of_restrictScalars_finiteType (ULift.{u} ℤ) (𝒜 0) _
  have hsurj : Function.Surjective (algebraMap (ULift.{u} ℤ) (𝒜 0)) := by
    intro c
    obtain ⟨p, hp⟩ := c
    have hh : p.IsHomogeneous 0 := (MvPolynomial.mem_homogeneousSubmodule 0 p).mp hp
    refine ⟨p.coeff 0, Subtype.ext ?_⟩
    rw [SetLike.GradeZero.coe_algebraMap, MvPolynomial.algebraMap_eq]
    show MvPolynomial.C (p.coeff 0) = p
    refine MvPolynomial.ext _ _ (fun m => ?_)
    rw [MvPolynomial.coeff_C]
    split_ifs with h
    · subst h; rfl
    · symm
      apply hh.coeff_eq_zero
      intro hd
      exact h ((Finsupp.degree_eq_zero_iff m).mp hd).symm
  let j : Spec (.of (𝒜 0)) ⟶ Spec (.of (ULift.{u} ℤ)) :=
    Spec.map (CommRingCat.ofHom (algebraMap (ULift.{u} ℤ) (𝒜 0) : ULift.{u} ℤ →+* 𝒜 0))
  haveI hj : IsClosedImmersion j := IsClosedImmersion.spec_of_surjective _ hsurj
  have hjp : IsProper j := inferInstance
  have hpp : IsProper (Proj.toSpecZero 𝒜) := inferInstance
  let q : wcPdP1Z.{u} ⟶ Spec (.of (ULift.{u} ℤ)) := Proj.toSpecZero 𝒜 ≫ j
  have hq : IsProper q := MorphismProperty.comp_mem @IsProper _ _ hpp hjp
  let t := specULiftZIsTerminal.{u}
  have hpb : IsPullback (Limits.prod.snd : S ⨯ wcPdP1Z.{u} ⟶ _) Limits.prod.fst q (t.from S) := by
