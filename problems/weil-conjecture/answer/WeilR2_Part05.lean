  have s5 : ∀ (A S : Type u) [CommRing A] [CommRing S] (a : A →+* S) (s₀ : S) (ha : ∀ r : A, ∃ m : ℤ, a r = m) (hs : Function.Surjective (Polynomial.eval₂ a s₀)),
