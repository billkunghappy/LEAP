      have n3 := NatTrans.naturality_apply T.homologyπ c.op k
      have n4 := congrArg (fun φ => (φ.app (Opposite.op U'')).hom e) T.toCycles_comp_homologyπ
      simp only [NatTrans.comp_app, AddCommGrpCat.hom_comp, AddMonoidHom.coe_comp,
        Function.comp_apply, NatTrans.app_zero, AddCommGrpCat.hom_zero,
        AddMonoidHom.zero_apply] at n4
