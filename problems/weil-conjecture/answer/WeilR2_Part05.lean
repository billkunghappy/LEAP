  have hex : (ShortComplex.mk (Limits.image.ι f) β hz).Exact := by
    refine (ShortComplex.exact_iff_epi_kernel_lift _).mpr ?_
    change Epi (Limits.kernel.lift β (Limits.image.ι f) hz)
    have hinj : ∀ T : X.Etale,
        Function.Injective ((Limits.kernel.ι β).hom.app (Opposite.op T)).hom := by
      intro T
      haveI : Mono ((sheafToPresheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map
          (Limits.kernel.ι β)) := Functor.map_mono _ _
      have h1 := (NatTrans.mono_iff_mono_app _).mp this (Opposite.op T)
      exact (AddCommGrpCat.mono_iff_injective _).mp h1
    haveI : Sheaf.IsLocallySurjective (Limits.kernel.lift β (Limits.image.ι f) hz) := by
      refine Presheaf.IsLocallySurjective.mk (fun {T} k => ?_)
      have h2 : (Limits.kernel.ι β ≫ β).hom.app (Opposite.op T) = 0 := by
        rw [Limits.kernel.condition]; rfl
      have hg : (β.hom.app (Opposite.op T)).hom
          (((Limits.kernel.ι β).hom.app (Opposite.op T)).hom k) = 0 :=
        (ConcreteCategory.congr_hom h2 k).trans rfl
      refine GrothendieckTopology.superset_covering _ ?_ (hker T _ hg)
      intro T' c hc
      obtain ⟨a, ha⟩ := hc
      refine ⟨((Limits.factorThruImage f).hom.app (Opposite.op T')).hom a, ?_⟩
      apply hinj T'
      have e1 : Limits.kernel.lift β (Limits.image.ι f) hz ≫ Limits.kernel.ι β =
          Limits.image.ι f := Limits.kernel.lift_ι _ _ _
      have e2 : Limits.factorThruImage f ≫ Limits.image.ι f = f := Limits.image.fac f
      calc ((Limits.kernel.ι β).hom.app (Opposite.op T')).hom
            (((Limits.kernel.lift β (Limits.image.ι f) hz).hom.app (Opposite.op T')).hom
              (((Limits.factorThruImage f).hom.app (Opposite.op T')).hom a))
          = ((Limits.factorThruImage f ≫ Limits.kernel.lift β (Limits.image.ι f) hz ≫
              Limits.kernel.ι β).hom.app (Opposite.op T')).hom a := rfl
        _ = (f.hom.app (Opposite.op T')).hom a := by rw [e1, e2]
        _ = (G.obj.map c.op).hom (((Limits.kernel.ι β).hom.app (Opposite.op T)).hom k) := ha
        _ = ((Limits.kernel.ι β).hom.app (Opposite.op T')).hom
              (((Limits.kernel β).obj.map c.op).hom k) :=
            (NatTrans.naturality_apply (Limits.kernel.ι β).hom c.op k).symm
    exact Sheaf.epi_of_isLocallySurjective _
  exact ⟨ShortComplex.mk (Limits.image.ι f) β hz,
    ShortComplex.ShortExact.mk' hex (inferInstance : Mono (Limits.image.ι f)) hepi,
    ⟨Iso.refl _⟩, ⟨Iso.refl _⟩, ⟨Iso.refl _⟩⟩

theorem wc_et_image_open_supp {X : Scheme.{u}} (U : X.Etale) (W : X.Opens)
    (G : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1})
    (p : (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
      (yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶ G) :
    wcSuppIn X (W : Set X) (Limits.image ((presheafToSheaf (Scheme.smallEtaleTopology X)
      AddCommGrpCat.{u+1}).map (Functor.whiskerRight (yoneda.map (wcEtOpenι X U (U.hom ⁻¹ᵁ W)))
      (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) ≫ p)) :=
by
  classical
  have key : ∀ (T : X.Etale), (∀ (V' : X.Etale), (V' ⟶ T) → ∀ x, V'.hom x ∈ (W : Set X)) →
      ∀ (F : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1})
        (φ : (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
          (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶ F),
      wcSuppIn X (W : Set X) (Limits.image φ) := by
    intro T hT F φ V s
    have h1 : Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology X)
        (toSheafify (Scheme.smallEtaleTopology X)
          (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) :=
      Presheaf.isLocallySurjective_toSheafify' _ _
    have h2 : Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology X)
        (Limits.factorThruImage φ).hom :=
      (Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u+1} (Limits.factorThruImage φ)).2
        inferInstance
    have h3 : Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology X)
        (toSheafify (Scheme.smallEtaleTopology X)
          (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ≫
          (Limits.factorThruImage φ).hom) :=
      Presheaf.isLocallySurjective_comp _ _ _
    refine GrothendieckTopology.superset_covering _ ?_ (Presheaf.imageSieve_mem
      (Scheme.smallEtaleTopology X) (toSheafify (Scheme.smallEtaleTopology X)
          (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ≫
          (Limits.factorThruImage φ).hom) s)
    rintro V' g ⟨t, ht⟩
    apply Sieve.le_generate
    by_cases hk : Nonempty (V' ⟶ T)
    · exact Or.inr (hT V' hk.some)
    · left
      have : IsEmpty (ULift.{u+1} (V' ⟶ T)) := ⟨fun a => hk ⟨a.down⟩⟩
      have ht0 : t = 0 :=
        Subsingleton.elim (α := FreeAbelianGroup (ULift.{u+1} (V' ⟶ T))) t 0
      rw [← ht, ht0, map_zero]
  refine key _ ?_ G _
  intro V' k x
  have aux : ∀ (Y : Scheme.{u}) (f : Y ⟶ X) (Z : Scheme.{u}) (a : Z ⟶ (f ⁻¹ᵁ W : Scheme.{u}))
      (b : Z ⟶ X), a ≫ (f ⁻¹ᵁ W).ι ≫ f = b → ∀ z : Z, b z ∈ (W : Set X) := by
    intro Y f Z a b hab z
    subst hab
    rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply]
    have h : (f ⁻¹ᵁ W).ι (a z) ∈ ((f ⁻¹ᵁ W : Y.Opens) : Set Y) := by
      rw [← Scheme.Opens.range_ι]; exact ⟨_, rfl⟩
    exact (Scheme.Hom.mem_preimage f).1 h
  exact aux _ U.hom _ k.left V'.hom (MorphismProperty.Over.w k) x

theorem wc_et_univ_transport_bijective_of_iso : ∀ {X Y : Scheme.{u}} (p : Y ⟶ X) (J : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) (G : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (ρ : wcEtTransport p J G), wcEtTransportUniv ρ → ∀ (V : X.Etale) (O : Y.Etale) (k : O.left ⟶ V.left) (hk : k ≫ V.hom = O.hom ≫ p), IsIso k → Function.Bijective (ρ.ρ V O k hk) :=
by
  intro X Y p J G ρ hU V O k hk hiso

  have hjs : ∀ (Y : Scheme.{u}) (V : Y.Etale) (S : Sieve V), (∀ v : V.left, ∃ (V₁ : Y.Etale)
      (c : V₁ ⟶ V), S.arrows c ∧ v ∈ Set.range c.left) → S ∈ Scheme.smallEtaleTopology Y V := by
    intro Y V S hS
    change S ∈ Scheme.smallGrothendieckTopology @Etale Y V
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
    apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
    intro x
    obtain ⟨V₁, c, hc, y, hy⟩ := hS x
    have hw : c.left ≫ V.hom = V₁.hom := MorphismProperty.Over.w c
    have hEt : Etale c.left := by
      have h1 : Etale V.hom := V.prop
      have h2 : Etale (c.left ≫ V.hom) := by rw [hw]; exact V₁.prop
      exact Etale.of_comp c.left V.hom
    exact ⟨V₁, c, y, hc, hEt, hy⟩
  have hshJ := (isSheaf_iff_isSheaf_of_type _ _).mp
    ((sheafCompose (Scheme.smallEtaleTopology X) (forget AddCommGrpCat.{u+1})).obj J).2
  have hshG := (isSheaf_iff_isSheaf_of_type _ _).mp
    ((sheafCompose (Scheme.smallEtaleTopology Y) (forget AddCommGrpCat.{u+1})).obj G).2
  have hGcomp : ∀ {A B C : Y.Etale} (f : A ⟶ B) (f' : B ⟶ C) (y : G.obj.obj (Opposite.op C)),
      G.obj.map (f ≫ f').op y = G.obj.map f.op (G.obj.map f'.op y) := by
    intro A B C f f' y
    rw [op_comp, CategoryTheory.Functor.map_comp]
    rfl

  have hinj : ∀ (V₀ : X.Etale) (O₀ : Y.Etale) (k₀ : O₀.left ⟶ V₀.left)
      (hk₀ : k₀ ≫ V₀.hom = O₀.hom ≫ p), IsIso k₀ → Function.Injective (ρ.ρ V₀ O₀ k₀ hk₀) := by
    intro V₀ O₀ k₀ hk₀ hiso₀
    rw [injective_iff_map_eq_zero]
    intro x hx
    let R : Presieve V₀ := fun _ c => J.obj.map c.op x = 0
    have hS : Sieve.generate R ∈ Scheme.smallEtaleTopology X V₀ := by
      apply hjs
      intro v
      obtain ⟨o, rfl⟩ := k₀.surjective v
      obtain ⟨V', c, v', hc, h0⟩ :=
        wc_et_univ_transport_locally_injective p J G ρ hU V₀ O₀ k₀ hk₀ x o hx
      exact ⟨V', c, ⟨V', 𝟙 V', c, h0, Category.id_comp c⟩, v', hc⟩
    refine (hshJ _ hS).isSeparatedFor.ext (fun Z f hf => ?_)
    obtain ⟨Z₁, g, f₁, hf₁, rfl⟩ := hf
    change J.obj.map (g ≫ f₁).op x = J.obj.map (g ≫ f₁).op 0
    have hf₁' : J.obj.map f₁.op x = 0 := hf₁
    rw [op_comp, Functor.map_comp, ConcreteCategory.comp_apply, hf₁', map_zero, map_zero]

  have hsurj : Function.Surjective (ρ.ρ V O k hk) := by
    intro g
    have hP2 := fun o => wc_et_univ_transport_locally_surjective p J G ρ hU O g o
    choose Oo d o' Vo ko hko yo hdo hgo using hP2
    have hdet : ∀ o, Etale (d o).left := by
      intro o
      have h1 : Etale O.hom := O.prop
      have h2 : Etale ((d o).left ≫ O.hom) := by
        rw [MorphismProperty.Over.w (d o)]; exact (Oo o).prop
      exact Etale.of_comp (d o).left O.hom
    let Q : O.left → X.Etale := fun o => MorphismProperty.Over.mk ⊤ ((d o).left ≫ k ≫ V.hom)
      (by haveI : Etale V.hom := V.prop; haveI := hdet o; infer_instance)
    let c : ∀ o, Q o ⟶ V := fun o =>
      MorphismProperty.Over.homMk ((d o).left ≫ k) (Category.assoc _ _ _) trivial
    have hwe : ∀ o, ko o ≫ (Vo o).hom = (d o).left ≫ k ≫ V.hom := by
      intro o
      rw [hko o, hk, ← Category.assoc, MorphismProperty.Over.w (d o)]
    let e : ∀ o, Q o ⟶ Vo o := fun o => MorphismProperty.Over.homMk (ko o) (hwe o) trivial
    have h1 : ∀ o, 𝟙 (Oo o).left ≫ (Q o).hom = (Oo o).hom ≫ p := by
      intro o
      show 𝟙 _ ≫ (d o).left ≫ k ≫ V.hom = _
      rw [Category.id_comp, hk, ← Category.assoc, MorphismProperty.Over.w (d o)]

    have hA : ∀ o, ρ.ρ (Q o) (Oo o) (𝟙 (Oo o).left) (h1 o) (J.obj.map (e o).op (yo o)) =
        G.obj.map (d o).op g := by
      intro o
      rw [hgo o, ρ.nat (Vo o) (Q o) (e o) (Oo o) (Oo o) (𝟙 (Oo o)) (ko o) (hko o)
        (𝟙 (Oo o).left) (h1 o) (by show 𝟙 _ ≫ ko o = 𝟙 _ ≫ ko o; rfl) (yo o), op_id,
        CategoryTheory.Functor.map_id]
      rfl

    have hcovV : Sieve.generate (Presieve.ofArrows Q c) ∈ Scheme.smallEtaleTopology X V := by
      apply hjs
      intro v
      obtain ⟨o, rfl⟩ := k.surjective v
      refine ⟨Q o, c o, ⟨Q o, 𝟙 _, c o, Presieve.ofArrows.mk o, Category.id_comp _⟩, o' o, ?_⟩
      change ((d o).left ≫ k) (o' o) = k o
      rw [Scheme.Hom.comp_apply, hdo o]

    have hcompat : Presieve.Arrows.Compatible (J.obj ⋙ forget AddCommGrpCat.{u+1}) c
        (fun o => J.obj.map (e o).op (yo o)) := by
      intro i j Z a₁ a₂ hcomm
      have hl : a₁.left ≫ (d i).left ≫ k = a₂.left ≫ (d j).left ≫ k :=
        congrArg (fun φ => φ.left) hcomm
      have hm : a₁.left ≫ (d i).left = a₂.left ≫ (d j).left :=
        (cancel_mono k).mp ((Category.assoc _ _ _).trans (hl.trans (Category.assoc _ _ _).symm))
      have ha1 : Etale a₁.left := by
        have h1 : Etale (Q i).hom := (Q i).prop
        have h2 : Etale (a₁.left ≫ (Q i).hom) := by
          rw [MorphismProperty.Over.w a₁]; exact Z.prop
        exact Etale.of_comp a₁.left (Q i).hom
      have hmet : Etale (a₁.left ≫ (d i).left ≫ O.hom) := by
        have h3 : Etale ((d i).left ≫ O.hom) := by
          haveI : Etale O.hom := O.prop
          haveI := hdet i
          infer_instance
        let a : Z.left ⟶ (Oo i).left := a₁.left
        haveI : Etale a := ha1
        haveI := h3
        show Etale (a ≫ (d i).left ≫ O.hom)
        infer_instance
      let ZY : Y.Etale := MorphismProperty.Over.mk ⊤ (a₁.left ≫ (d i).left ≫ O.hom) hmet
      have hb1w : a₁.left ≫ (Oo i).hom = ZY.hom :=
        whisker_eq a₁.left (MorphismProperty.Over.w (d i)).symm
      have hb2w : a₂.left ≫ (Oo j).hom = ZY.hom := by
        calc a₂.left ≫ (Oo j).hom = a₂.left ≫ ((d j).left ≫ O.hom) :=
              whisker_eq a₂.left (MorphismProperty.Over.w (d j)).symm
          _ = (a₂.left ≫ (d j).left) ≫ O.hom := (Category.assoc _ _ _).symm
          _ = (a₁.left ≫ (d i).left) ≫ O.hom := eq_whisker hm.symm O.hom
          _ = a₁.left ≫ (d i).left ≫ O.hom := Category.assoc _ _ _
      let b₁ : ZY ⟶ Oo i := MorphismProperty.Over.homMk a₁.left hb1w trivial
      let b₂ : ZY ⟶ Oo j := MorphismProperty.Over.homMk a₂.left hb2w trivial
      have hZ : 𝟙 Z.left ≫ Z.hom = ZY.hom ≫ p := by
        have hc : 𝟙 Z.left ≫ Z.hom = (a₁.left ≫ ((d i).left ≫ O.hom)) ≫ p := by
          calc 𝟙 Z.left ≫ Z.hom = Z.hom := Category.id_comp _
            _ = a₁.left ≫ (Q i).hom := (MorphismProperty.Over.w a₁).symm
            _ = a₁.left ≫ ((d i).left ≫ (k ≫ V.hom)) := rfl
            _ = a₁.left ≫ ((d i).left ≫ (O.hom ≫ p)) :=
                whisker_eq a₁.left (whisker_eq (d i).left hk)
            _ = a₁.left ≫ (((d i).left ≫ O.hom) ≫ p) :=
                whisker_eq a₁.left (Category.assoc _ _ _).symm
            _ = (a₁.left ≫ ((d i).left ≫ O.hom)) ≫ p := (Category.assoc _ _ _).symm
        exact hc
      have hbd : b₁ ≫ d i = b₂ ≫ d j := by
        apply MorphismProperty.Over.Hom.ext
        exact hm
      have n1 := ρ.nat (Q i) Z a₁ (Oo i) ZY b₁ (𝟙 (Oo i).left) (h1 i) (𝟙 Z.left) hZ
        ((Category.id_comp _).trans (Category.comp_id _).symm) (J.obj.map (e i).op (yo i))
      have n2 := ρ.nat (Q j) Z a₂ (Oo j) ZY b₂ (𝟙 (Oo j).left) (h1 j) (𝟙 Z.left) hZ
        ((Category.id_comp _).trans (Category.comp_id _).symm) (J.obj.map (e j).op (yo j))
      change J.obj.map a₁.op (J.obj.map (e i).op (yo i)) =
        J.obj.map a₂.op (J.obj.map (e j).op (yo j))
      have hid : IsIso (𝟙 Z.left : ZY.left ⟶ Z.left) :=
        ⟨⟨𝟙 Z.left, Category.id_comp _, Category.id_comp _⟩⟩
      apply hinj Z ZY (𝟙 Z.left) hZ hid
      rw [n1, n2, hA i, hA j, ← hGcomp, ← hGcomp, hbd]

    have hsfV : Presieve.IsSheafFor (J.obj ⋙ forget AddCommGrpCat.{u+1}) (Presieve.ofArrows Q c) :=
      (Presieve.isSheafFor_iff_generate _).mpr (hshJ _ hcovV)
    obtain ⟨x, hx, -⟩ := (Presieve.isSheafFor_arrows_iff _ c).mp hsfV _ hcompat
    refine ⟨x, ?_⟩
    have hcovO : Sieve.generate (Presieve.ofArrows Oo d) ∈ Scheme.smallEtaleTopology Y O := by
      apply hjs
      intro o
      exact ⟨Oo o, d o, ⟨Oo o, 𝟙 _, d o, Presieve.ofArrows.mk o, Category.id_comp _⟩, o' o, hdo o⟩
    refine (hshG _ hcovO).isSeparatedFor.ext (fun Z f hf => ?_)
    obtain ⟨Z₁, g', f₁, hf₁, rfl⟩ := hf
    rcases hf₁ with ⟨o⟩
    have hkey : G.obj.map (d o).op (ρ.ρ V O k hk x) = G.obj.map (d o).op g := by
      rw [← ρ.nat V (Q o) (c o) O (Oo o) (d o) k hk (𝟙 (Oo o).left) (h1 o)
        (Category.id_comp _) x]
      have hxo : J.obj.map (c o).op x = J.obj.map (e o).op (yo o) := hx o
      rw [hxo, hA o]
    change G.obj.map (g' ≫ d o).op (ρ.ρ V O k hk x) = G.obj.map (g' ≫ d o).op g
    rw [hGcomp, hGcomp, hkey]
  exact ⟨hinj V O k hk hiso, hsurj⟩

theorem wc_split_local_perm : ∀ {X X' T Z : Scheme.{u}} (h : X' ⟶ X) (e : T ⟶ X) (d : ℕ) (σ : Fin d → (T ⟶ X')) (hσ : ∀ i, σ i ≫ h = e), IsIso (Limits.Sigma.desc (fun i => Limits.pullback.lift (σ i) (𝟙 T) ((hσ i).trans (Category.id_comp e).symm)) : ∐ (fun _ : Fin d => T) ⟶ Limits.pullback h e) → ∀ (l₁ l₂ : Z ⟶ T), l₁ ≫ e = l₂ ≫ e → ∃ U : Equiv.Perm (Fin d) → Z.Opens, (∀ z : Z, ∃ π, z ∈ U π) ∧ ∀ π j, (U π).ι ≫ l₂ ≫ σ j = (U π).ι ≫ l₁ ≫ σ (π j) :=
by
  intro X X' T Z h e d σ hσ hsplit l₁ l₂ hl
  classical
  have hιΦ : ∀ i, Limits.Sigma.ι (fun _ : Fin d => T) i ≫
      (Limits.Sigma.desc (fun i => Limits.pullback.lift (σ i) (𝟙 T)
        ((hσ i).trans (Category.id_comp e).symm)) : ∐ (fun _ : Fin d => T) ⟶ Limits.pullback h e) =
      Limits.pullback.lift (σ i) (𝟙 T) ((hσ i).trans (Category.id_comp e).symm) :=
    fun i => Limits.Sigma.ι_comp_desc _ i
  generalize (Limits.Sigma.desc (fun i => Limits.pullback.lift (σ i) (𝟙 T)
        ((hσ i).trans (Category.id_comp e).symm)) : ∐ (fun _ : Fin d => T) ⟶ Limits.pullback h e)
    = Φ at hsplit hιΦ
  haveI := hsplit

  have hdisj : ∀ (W : Scheme.{u}) (g : W ⟶ T) (j j' : Fin d), g ≫ σ j = g ≫ σ j' →
      Nonempty W → j = j' := by
    intro W g j j' hg ⟨w⟩
    by_contra hne
    have h1 : g ≫ Limits.Sigma.ι (fun _ : Fin d => T) j =
        g ≫ Limits.Sigma.ι (fun _ : Fin d => T) j' := by
      rw [← cancel_mono Φ, Category.assoc, Category.assoc, hιΦ, hιΦ]
      apply Limits.pullback.hom_ext
      · simp only [Category.assoc, Limits.pullback.lift_fst]; exact hg
      · simp only [Category.assoc, Limits.pullback.lift_snd]
    have h2 : (Limits.Sigma.ι (fun _ : Fin d => T) j) (g w) =
        (Limits.Sigma.ι (fun _ : Fin d => T) j') (g w) := by
      rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, h1]
    have hd := disjoint_opensRange_sigmaι (fun _ : Fin d => T) j j' hne
    have hm1 : (Limits.Sigma.ι (fun _ : Fin d => T) j) (g w) ∈
        (Limits.Sigma.ι (fun _ : Fin d => T) j).opensRange :=
      Scheme.Hom.mem_opensRange.2 ⟨g w, rfl⟩
    have hm2 : (Limits.Sigma.ι (fun _ : Fin d => T) j) (g w) ∈
        (Limits.Sigma.ι (fun _ : Fin d => T) j').opensRange :=
      Scheme.Hom.mem_opensRange.2 ⟨g w, h2.symm⟩
    have := hd.le_bot ⟨hm1, hm2⟩
    simpa using this

  have hcover : ∀ j : Fin d, ∃ V : Fin d → Z.Opens, (∀ z : Z, ∃ i, z ∈ V i) ∧
      ∀ i, (V i).ι ≫ l₂ ≫ σ j = (V i).ι ≫ l₁ ≫ σ i := by
    intro j
    have w : (l₂ ≫ σ j) ≫ h = l₁ ≫ e := by rw [Category.assoc, hσ j, hl]
    obtain ⟨n, hn⟩ : ∃ n : Z ⟶ ∐ (fun _ : Fin d => T),
        n = Limits.pullback.lift (l₂ ≫ σ j) l₁ w ≫ inv Φ := ⟨_, rfl⟩
    refine ⟨fun i => n ⁻¹ᵁ (Limits.Sigma.ι (fun _ : Fin d => T) i).opensRange, ?_, ?_⟩
    · intro z
      obtain ⟨i, y, hy⟩ : ∃ (i : Fin d) (y : T), Limits.Sigma.ι (fun _ : Fin d => T) i y = n z :=
        (sigmaOpenCover (fun _ : Fin d => T)).exists_eq (n z)
      refine ⟨i, ?_⟩
      show n z ∈ (Limits.Sigma.ι (fun _ : Fin d => T) i).opensRange
      rw [Scheme.Hom.mem_opensRange]
      exact ⟨y, hy⟩
    · intro i
      have hr : Set.range ((n ⁻¹ᵁ (Limits.Sigma.ι (fun _ : Fin d => T) i).opensRange).ι ≫ n) ⊆
          Set.range (Limits.Sigma.ι (fun _ : Fin d => T) i) := by
        rintro _ ⟨u, rfl⟩
        have hu : n u.1 ∈ (Limits.Sigma.ι (fun _ : Fin d => T) i).opensRange := u.2
        rw [Scheme.Hom.mem_opensRange] at hu
        rw [Scheme.Hom.comp_apply]
        exact hu
      obtain ⟨μ, hμ⟩ : ∃ μ, μ ≫ Limits.Sigma.ι (fun _ : Fin d => T) i =
          (n ⁻¹ᵁ (Limits.Sigma.ι (fun _ : Fin d => T) i).opensRange).ι ≫ n :=
        ⟨_, IsOpenImmersion.lift_fac _ _ hr⟩
      have key : (n ⁻¹ᵁ (Limits.Sigma.ι (fun _ : Fin d => T) i).opensRange).ι ≫
          Limits.pullback.lift (l₂ ≫ σ j) l₁ w =
          μ ≫ Limits.pullback.lift (σ i) (𝟙 T) ((hσ i).trans (Category.id_comp e).symm) := by
        rw [← hιΦ i, ← Category.assoc, hμ, hn]
        simp only [Category.assoc, IsIso.inv_hom_id, Category.comp_id]
      have k1 := congrArg (· ≫ Limits.pullback.snd h e) key
      have k2 := congrArg (· ≫ Limits.pullback.fst h e) key
      simp only [Category.assoc, Limits.pullback.lift_snd, Limits.pullback.lift_fst,
        Category.comp_id] at k1 k2
      rw [k2, ← k1, Category.assoc]

  choose V hVcov hVeq using hcover
  have huniq : ∀ (z : Z) (j j' i : Fin d), z ∈ V j i → z ∈ V j' i → j = j' := by
    intro z j j' i hz hz'
    have e1 : (V j i ⊓ V j' i).ι = Z.homOfLE inf_le_left ≫ (V j i).ι :=
      (Scheme.homOfLE_ι _ _).symm
    have e2 : (V j i ⊓ V j' i).ι = Z.homOfLE inf_le_right ≫ (V j' i).ι :=
      (Scheme.homOfLE_ι _ _).symm
    apply hdisj ((V j i ⊓ V j' i : Z.Opens) : Scheme.{u}) ((V j i ⊓ V j' i).ι ≫ l₂) j j'
    · have a1 : (V j i ⊓ V j' i).ι ≫ l₂ ≫ σ j = (V j i ⊓ V j' i).ι ≫ l₁ ≫ σ i := by
        rw [e1, Category.assoc, hVeq j i, Category.assoc]
      have a2 : (V j i ⊓ V j' i).ι ≫ l₂ ≫ σ j' = (V j i ⊓ V j' i).ι ≫ l₁ ≫ σ i := by
        rw [e2, Category.assoc, hVeq j' i, Category.assoc]
      rw [Category.assoc, Category.assoc, a1, a2]
    · exact ⟨⟨z, ⟨hz, hz'⟩⟩⟩
  have hperm : ∀ z : Z, ∃ π : Equiv.Perm (Fin d), ∀ j, z ∈ V j (π j) := by
    intro z
    choose f hf using fun j => hVcov j z
    have hinj : Function.Injective f := fun j j' hjj =>
      huniq z j j' (f j) (hf j) (by rw [hjj]; exact hf j')
    exact ⟨Equiv.ofBijective f (Finite.injective_iff_bijective.mp hinj), fun j => hf j⟩
  refine ⟨fun π => ⟨⋂ j, (V j (π j) : Set Z), isOpen_iInter_of_finite
    (fun j => (V j (π j)).isOpen)⟩, ?_, ?_⟩
  · intro z
    obtain ⟨π, hπ⟩ := hperm z
    exact ⟨π, Set.mem_iInter.mpr hπ⟩
  · intro π j
    have hle : (⟨⋂ j, (V j (π j) : Set Z), isOpen_iInter_of_finite
        (fun j => (V j (π j)).isOpen)⟩ : Z.Opens) ≤ V j (π j) :=
      Set.iInter_subset (fun j => (V j (π j) : Set Z)) j
    dsimp only
    rw [← Scheme.homOfLE_ι Z hle]
    simp only [Category.assoc]
    rw [hVeq j (π j)]

theorem wc_et_cover_lift_or_push_vanish : ∀ {X X' T : Scheme.{u}} (h : X' ⟶ X) [IsFinite h] (W : X.Opens) (q : T ⟶ (W : Scheme.{u})) [Etale q] [AlgebraicGeometry.Surjective q] (G : Sheaf (Scheme.smallEtaleTopology X') AddCommGrpCat.{u+1}), wcSuppIn X' (h ⁻¹' (W : Set X)) G → ∀ (V : X.Etale) (y : G.obj.obj (Opposite.op ((wcEtBaseChange h).obj V))), Sieve.generate (fun (Z : X.Etale) (f : Z ⟶ V) => (∃ lf : Z.left ⟶ T, lf ≫ q ≫ W.ι = Z.hom) ∨ G.obj.map ((wcEtBaseChange h).map f).op y = 0) ∈ Scheme.smallEtaleTopology X V :=
by
  intro X X' T h _ W q _ _ G hG V y

  have hjs : ∀ (Y : Scheme.{u}) (V : Y.Etale) (S : Sieve V), (∀ v : V.left, ∃ (V₁ : Y.Etale)
      (c : V₁ ⟶ V), S.arrows c ∧ v ∈ Set.range c.left) → S ∈ Scheme.smallEtaleTopology Y V := by
    intro Y V S hS
    change S ∈ Scheme.smallGrothendieckTopology @Etale Y V
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
    apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
    intro x
    obtain ⟨V₁, c, hc, y, hy⟩ := hS x
    have hw : c.left ≫ V.hom = V₁.hom := MorphismProperty.Over.w c
    have hEt : Etale c.left := by
      have h1 : Etale V.hom := V.prop
      have h2 : Etale (c.left ≫ V.hom) := by rw [hw]; exact V₁.prop
      exact Etale.of_comp c.left V.hom
    exact ⟨V₁, c, y, hc, hEt, hy⟩

  have hEtHom : ∀ {A B : X'.Etale} (c : A ⟶ B), Etale c.left := by
    intro A B c
    have hw : c.left ≫ B.hom = A.hom := MorphismProperty.Over.w c
    have h1 : Etale B.hom := B.prop
    have h2 : Etale (c.left ≫ B.hom) := by rw [hw]; exact A.prop
    exact Etale.of_comp c.left B.hom

  have s2 : ∀ (V : X'.Etale) (g : G.obj.obj (Opposite.op V)), IsOpen {v : V.left | ∃ (V₁ : X'.Etale)
      (c : V₁ ⟶ V), v ∈ Set.range c.left ∧ G.obj.map c.op g = 0} ∧ ∀ (V₁ : X'.Etale) (c : V₁ ⟶ V),
      Set.range c.left ⊆ {v : V.left | ∃ (V₂ : X'.Etale) (c₂ : V₂ ⟶ V), v ∈ Set.range c₂.left ∧
        G.obj.map c₂.op g = 0} → G.obj.map c.op g = 0 := by
    intro V g
    refine ⟨?_, ?_⟩
    · rw [isOpen_iff_forall_mem_open]
      rintro v ⟨V₁, c, hv, hc⟩
      haveI := hEtHom c
      exact ⟨Set.range c.left, fun w hw => ⟨V₁, c, hw, hc⟩, c.left.isOpenMap.isOpen_range, hv⟩
    · intro V₁ c hsub
      let S : Sieve V₁ :=
        { arrows := fun D d => G.obj.map d.op (G.obj.map c.op g) = 0
          downward_closed := by
            intro D D' d hd e
            change G.obj.map (e ≫ d).op (G.obj.map c.op g) = 0
            rw [op_comp, Functor.map_comp, ConcreteCategory.comp_apply]
            rw [hd, map_zero] }
      have hS : S ∈ Scheme.smallEtaleTopology X' V₁ := by
        change S ∈ Scheme.smallGrothendieckTopology @Etale X' V₁
        rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale X'
          MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
        apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale X'
          MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
        intro p
        obtain ⟨V₂, c₂, ⟨q₀, hq₀⟩, hc₂⟩ := hsub ⟨p, rfl⟩
        haveI : Etale c₂.left := hEtHom c₂
        haveI : Etale V₁.hom := V₁.prop
        let fst := Limits.pullback.fst c.left c₂.left
        let snd := Limits.pullback.snd c.left c₂.left
        haveI hfst : Etale fst := inferInstance
        let D : X'.Etale := Scheme.Etale.mk (fst ≫ V₁.hom)
        have hw2 : snd ≫ V₂.hom = fst ≫ V₁.hom := by
          rw [← MorphismProperty.Over.w c₂, ← MorphismProperty.Over.w c, ← Category.assoc,
            ← Category.assoc, Limits.pullback.condition]
        let π₁ : D ⟶ V₁ := MorphismProperty.Over.homMk fst rfl trivial
        let π₂ : D ⟶ V₂ := MorphismProperty.Over.homMk snd hw2 trivial
        have hcomm : π₁ ≫ c = π₂ ≫ c₂ := by
          apply MorphismProperty.Over.Hom.ext
          exact Limits.pullback.condition
        obtain ⟨z, hz1, -⟩ := Scheme.Pullback.exists_preimage_pullback p q₀ hq₀.symm
        have hπ₁ : S.arrows π₁ := by
          change G.obj.map π₁.op (G.obj.map c.op g) = 0
          rw [← ConcreteCategory.comp_apply, ← Functor.map_comp, ← op_comp, hcomm, op_comp,
            Functor.map_comp, ConcreteCategory.comp_apply, hc₂, map_zero]
        exact ⟨D, π₁, z, hπ₁, hfst, hz1⟩
      have hsh := (isSheaf_iff_isSheaf_of_type _ _).mp
        ((sheafCompose (Scheme.smallEtaleTopology X') (forget AddCommGrpCat.{u+1})).obj G).2
      exact (hsh S hS).isSeparatedFor.ext (fun D d hd => by
        change G.obj.map d.op (G.obj.map c.op g) = G.obj.map d.op 0
        rw [map_zero]
        exact hd)

  have s3 : ∀ (V : X.Etale) (g : G.obj.obj (Opposite.op ((wcEtBaseChange h).obj V))) (v : V.left),
      (∀ z : ((wcEtBaseChange h).obj V).left, Limits.pullback.fst V.hom h z = v →
        ∃ (V₁ : X'.Etale) (c : V₁ ⟶ (wcEtBaseChange h).obj V), z ∈ Set.range c.left ∧
          G.obj.map c.op g = 0) →
      ∃ W₀ : V.left.Opens, v ∈ W₀ ∧
        G.obj.map ((wcEtBaseChange h).map (wcEtOpenι X V W₀)).op g = 0 := by
    intro V g v hfib
    obtain ⟨hNopen, hkill⟩ := s2 ((wcEtBaseChange h).obj V) g
    set N : Set ((wcEtBaseChange h).obj V).left :=
      {o | ∃ (O₁ : X'.Etale) (c : O₁ ⟶ (wcEtBaseChange h).obj V), o ∈ Set.range c.left ∧
        G.obj.map c.op g = 0} with hN
    have hcl : IsClosedMap (Limits.pullback.fst V.hom h) :=
      Scheme.Hom.isClosedMap (Limits.pullback.fst V.hom h)
    have hC : IsClosed Nᶜ := hNopen.isClosed_compl
    have hK : IsClosed ((Limits.pullback.fst V.hom h) '' Nᶜ) := hcl _ hC
    let W₀ : V.left.Opens := ⟨((Limits.pullback.fst V.hom h) '' Nᶜ)ᶜ, hK.isOpen_compl⟩
    have hvW : v ∈ W₀ := by
      rintro ⟨z, hzC, hzv⟩
      exact hzC (hfib z hzv)
    refine ⟨W₀, hvW, hkill _ _ ?_⟩
    have h0 : (Limits.pullback.fst (wcEtOpen X V W₀).hom h ≫ (wcEtOpenι X V W₀).left) ≫ V.hom =
        Limits.pullback.snd (wcEtOpen X V W₀).hom h ≫ h := by
      rw [Category.assoc, MorphismProperty.Over.w (wcEtOpenι X V W₀)]
      exact Limits.pullback.condition
    have hmap : ((wcEtBaseChange h).map (wcEtOpenι X V W₀)).left =
        Limits.pullback.lift (Limits.pullback.fst (wcEtOpen X V W₀).hom h ≫ (wcEtOpenι X V W₀).left)
          (Limits.pullback.snd (wcEtOpen X V W₀).hom h) h0 := rfl
    have hside : ((wcEtBaseChange h).map (wcEtOpenι X V W₀)).left ≫ Limits.pullback.fst V.hom h =
        Limits.pullback.fst (wcEtOpen X V W₀).hom h ≫ W₀.ι := by
      rw [hmap]
      exact Limits.pullback.lift_fst _ _ _
    rintro _ ⟨t, rfl⟩
    by_contra hNt
    have e1 : (((wcEtBaseChange h).map (wcEtOpenι X V W₀)).left ≫ Limits.pullback.fst V.hom h) t =
        (Limits.pullback.fst (wcEtOpen X V W₀).hom h ≫ W₀.ι) t := by rw [hside]; rfl
    have e2 : Limits.pullback.fst V.hom h (((wcEtBaseChange h).map (wcEtOpenι X V W₀)).left t) =
        W₀.ι (Limits.pullback.fst (wcEtOpen X V W₀).hom h t) :=
      (Scheme.Hom.comp_apply _ _ _).symm.trans (e1.trans (Scheme.Hom.comp_apply _ _ _))
    have h3 : W₀.ι (Limits.pullback.fst (wcEtOpen X V W₀).hom h t) ∈ (W₀ : Set V.left) :=
      (Scheme.Opens.range_ι W₀).subset ⟨_, rfl⟩
    have hW : Limits.pullback.fst V.hom h (((wcEtBaseChange h).map (wcEtOpenι X V W₀)).left t)
        ∈ (W₀ : Set V.left) := Eq.mpr (congrArg (· ∈ (W₀ : Set V.left)) e2) h3
    exact hW ⟨_, hNt, rfl⟩

  apply hjs X V
  intro v
  by_cases hv : V.hom v ∈ (W : Set X)
  ·
    haveI : Etale V.hom := V.prop
    let Z : X.Etale := MorphismProperty.Over.mk ⊤
      (Limits.pullback.fst V.hom (q ≫ W.ι) ≫ V.hom) inferInstance
    let f : Z ⟶ V := MorphismProperty.Over.homMk (Limits.pullback.fst V.hom (q ≫ W.ι)) rfl trivial
    have hlf : Limits.pullback.snd V.hom (q ≫ W.ι) ≫ q ≫ W.ι = Z.hom :=
      Limits.pullback.condition.symm
    refine ⟨Z, f, ⟨Z, 𝟙 Z, f, Or.inl ⟨Limits.pullback.snd V.hom (q ≫ W.ι), hlf⟩,
      Category.id_comp f⟩, ?_⟩
    show v ∈ Set.range (Limits.pullback.fst V.hom (q ≫ W.ι))
    rw [Scheme.Pullback.range_fst]
    have h1 : V.hom v ∈ Set.range W.ι := by rw [Scheme.Opens.range_ι]; exact hv
    obtain ⟨a, ha⟩ := h1
    obtain ⟨t, ht⟩ := (AlgebraicGeometry.Surjective.surj (f := q)) a
    exact ⟨t, by rw [Scheme.Hom.comp_apply, ht, ha]⟩
  ·
    have s5 : ∀ z : ((wcEtBaseChange h).obj V).left, Limits.pullback.fst V.hom h z = v →
        ∃ (V₁ : X'.Etale) (c : V₁ ⟶ (wcEtBaseChange h).obj V), z ∈ Set.range c.left ∧
          G.obj.map c.op y = 0 := by
      intro z hz
      unfold wcSuppIn at hG
      have hS := hG ((wcEtBaseChange h).obj V) y
      change _ ∈ Scheme.smallGrothendieckTopology @Etale X' _ at hS
      rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale X'
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hS
      have hS' := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale X'
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mp hS
      obtain ⟨V₁, c, z₁, hc, -, hz₁⟩ := hS' z
      obtain ⟨Y₀, k, g₀, hD, hk⟩ := hc
      rcases hD with h0 | hsupp
      · refine ⟨V₁, c, ⟨z₁, hz₁⟩, ?_⟩
        subst hk
        have e : G.obj.map (k ≫ g₀).op = G.obj.map g₀.op ≫ G.obj.map k.op := by
          rw [← Functor.map_comp]; rfl
        rw [e, ConcreteCategory.comp_apply, h0, map_zero]
      · exfalso
        apply hv
        have h1 := hsupp (k.left z₁)
        have e1 : Y₀.hom (k.left z₁) = V₁.hom z₁ :=
          (Scheme.Hom.comp_apply k.left Y₀.hom z₁).symm.trans
            (congrArg (fun φ : V₁.left ⟶ X' => φ z₁) (MorphismProperty.Over.w k))
        have e2 : V₁.hom z₁ = ((wcEtBaseChange h).obj V).hom z := by
          rw [← hz₁]
          exact (congrArg (fun φ : V₁.left ⟶ X' => φ z₁) (MorphismProperty.Over.w c)).symm.trans
            (Scheme.Hom.comp_apply c.left _ z₁)
        have e4 : h (Limits.pullback.snd V.hom h z) = V.hom (Limits.pullback.fst V.hom h z) :=
          (Scheme.Hom.comp_apply _ _ z).symm.trans
            ((congrArg (fun φ => φ z) (Limits.pullback.condition (f := V.hom) (g := h))).symm.trans
              (Scheme.Hom.comp_apply _ _ z))
        rw [e1, e2] at h1
        change h (Limits.pullback.snd V.hom h z) ∈ (W : Set X) at h1
        rw [e4, hz] at h1
        exact h1
    obtain ⟨W₀, hvW₀, h0⟩ := s3 V y v s5
    refine ⟨wcEtOpen X V W₀, wcEtOpenι X V W₀,
      ⟨wcEtOpen X V W₀, 𝟙 _, wcEtOpenι X V W₀, Or.inr h0, Category.id_comp _⟩, ?_⟩
    show v ∈ Set.range W₀.ι
    rw [Scheme.Opens.range_ι]
    exact hvW₀

theorem wc_et_glue_presheaf_hom : ∀ {X : Scheme.{u}} (P : (X.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) (F : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) (A : X.Etale → Prop), (∀ (Z Z₁ : X.Etale) (k : Z ⟶ Z₁), A Z₁ → A Z) → ∀ (t : ∀ Z : X.Etale, A Z → (P.obj (Opposite.op Z) →+ F.obj.obj (Opposite.op Z))), (∀ (Z Z₁ : X.Etale) (k : Z ⟶ Z₁) (hZ : A Z) (hZ₁ : A Z₁) (y : P.obj (Opposite.op Z₁)), t Z hZ ((P.map k.op).hom y) = (F.obj.map k.op).hom (t Z₁ hZ₁ y)) → (∀ (V : X.Etale) (y : P.obj (Opposite.op V)), Sieve.generate (fun (Z : X.Etale) (f : Z ⟶ V) => A Z ∨ (P.map f.op).hom y = 0) ∈ Scheme.smallEtaleTopology X V) → ∃ β : P ⟶ F.obj, ∀ (Z : X.Etale) (hZ : A Z) (y : P.obj (Opposite.op Z)), (β.app (Opposite.op Z)).hom y = t Z hZ y :=
by
  intro X P F A hA t ht hcov
  classical
  have hsh : Presieve.IsSheaf (Scheme.smallEtaleTopology X) (F.obj ⋙ forget AddCommGrpCat.{u+1}) :=
    (isSheaf_iff_isSheaf_of_type _ _).mp
      ((sheafCompose (Scheme.smallEtaleTopology X) (forget AddCommGrpCat.{u+1})).obj F).2
  have hPc : ∀ {Z Y V : X.Etale} (g : Z ⟶ Y) (f : Y ⟶ V) (y : P.obj (Opposite.op V)),
      (P.map (g ≫ f).op).hom y = (P.map g.op).hom ((P.map f.op).hom y) := by
    intro Z Y V g f y
    rw [op_comp, Functor.map_comp]
    rfl
  have hFc : ∀ {Z Y V : X.Etale} (g : Z ⟶ Y) (f : Y ⟶ V) (x : F.obj.obj (Opposite.op V)),
      (F.obj.map (g ≫ f).op).hom x = (F.obj.map g.op).hom ((F.obj.map f.op).hom x) := by
    intro Z Y V g f x
    rw [op_comp, Functor.map_comp]
    rfl

  obtain ⟨w, hw⟩ : ∃ w : ∀ (Z V : X.Etale), (Z ⟶ V) → P.obj (Opposite.op V) →
      F.obj.obj (Opposite.op Z), ∀ Z V f y,
      w Z V f y = if h : A Z then t Z h ((P.map f.op).hom y) else 0 :=
    ⟨fun Z V f y => if h : A Z then t Z h ((P.map f.op).hom y) else 0, fun _ _ _ _ => rfl⟩
  have hw0 : ∀ (Z V : X.Etale) (f : Z ⟶ V) (y : P.obj (Opposite.op V)) (hZ : A Z),
      w Z V f y = t Z hZ ((P.map f.op).hom y) := by
    intro Z V f y hZ
    rw [hw, dif_pos hZ]
  have hw1 : ∀ (Z V : X.Etale) (f : Z ⟶ V) (y : P.obj (Opposite.op V)), ¬ A Z →
      w Z V f y = 0 := by
    intro Z V f y hZ
    rw [hw, dif_neg hZ]
  have hwadd : ∀ (Z V : X.Etale) (f : Z ⟶ V) (y y' : P.obj (Opposite.op V)),
      w Z V f (y + y') = w Z V f y + w Z V f y' := by
    intro Z V f y y'
    by_cases h : A Z
    · rw [hw0 _ _ _ _ h, hw0 _ _ _ _ h, hw0 _ _ _ _ h, map_add, map_add]
    · rw [hw1 _ _ _ _ h, hw1 _ _ _ _ h, hw1 _ _ _ _ h, add_zero]
  have hwc : ∀ (Z V₂ V : X.Etale) (f : Z ⟶ V₂) (c : V₂ ⟶ V) (y : P.obj (Opposite.op V)),
      w Z V (f ≫ c) y = w Z V₂ f ((P.map c.op).hom y) := by
    intro Z V₂ V f c y
    by_cases h : A Z
    · rw [hw0 _ _ _ _ h, hw0 _ _ _ _ h, hPc]
    · rw [hw1 _ _ _ _ h, hw1 _ _ _ _ h]
  have hwz : ∀ (Z V : X.Etale) (f : Z ⟶ V) (y : P.obj (Opposite.op V)),
      (P.map f.op).hom y = 0 → w Z V f y = 0 := by
    intro Z V f y hy
    by_cases h : A Z
    · rw [hw0 _ _ _ _ h, hy, map_zero]
    · exact hw1 _ _ _ _ h

  obtain ⟨S, hS⟩ : ∃ S : ∀ (V : X.Etale), P.obj (Opposite.op V) → Sieve V, ∀ V y,
      S V y = Sieve.generate (fun (Z : X.Etale) (f : Z ⟶ V) => A Z ∨ (P.map f.op).hom y = 0) :=
    ⟨fun V y => Sieve.generate (fun (Z : X.Etale) (f : Z ⟶ V) => A Z ∨ (P.map f.op).hom y = 0),
      fun _ _ => rfl⟩
  have hScov : ∀ V y, S V y ∈ Scheme.smallEtaleTopology X V := by
    intro V y
    rw [hS]
    exact hcov V y
  have hclos : ∀ (V : X.Etale) (y : P.obj (Opposite.op V)) (Z : X.Etale) (f : Z ⟶ V),
      (S V y).arrows f → A Z ∨ (P.map f.op).hom y = 0 := by
    intro V y Z f hf
    rw [hS, Sieve.generate_apply] at hf
    obtain ⟨Y, h, g, hg, rfl⟩ := hf
    rcases hg with hY | h0
    · exact Or.inl (hA _ _ h hY)
    · right
      rw [hPc, h0, map_zero]

  obtain ⟨fam, hfam⟩ : ∃ fam : ∀ (V : X.Etale) (y : P.obj (Opposite.op V)),
      Presieve.FamilyOfElements (F.obj ⋙ forget AddCommGrpCat.{u+1}) (S V y).arrows,
      ∀ V y (Z : X.Etale) (f : Z ⟶ V) (hf : (S V y).arrows f), fam V y f hf = w Z V f y :=
    ⟨fun V y Z f _ => w Z V f y, fun _ _ _ _ _ => rfl⟩
  have hxc : ∀ (V : X.Etale) (y : P.obj (Opposite.op V)), (fam V y).Compatible := by
    intro V y
    refine (Presieve.compatible_iff_sieveCompatible (fam V y)).mpr ?_
    intro Y Z f g hf
    rw [hfam, hfam]
    change w Z V (g ≫ f) y = (F.obj.map g.op).hom (w Y V f y)
    rcases hclos V y Y f hf with hY | h0
    · have hZ := hA Z Y g hY
      rw [hw0 _ _ _ _ hZ, hw0 _ _ _ _ hY, hPc, ht Z Y g hZ hY]
    · rw [hwc, h0, hwz Z Y g 0 (map_zero _), hwz Y V f y h0, map_zero]

  obtain ⟨β₀, hG⟩ : ∃ β₀ : ∀ (V : X.Etale), P.obj (Opposite.op V) → F.obj.obj (Opposite.op V),
      ∀ (V : X.Etale) (y : P.obj (Opposite.op V)) (Z : X.Etale) (f : Z ⟶ V),
        (S V y).arrows f → (F.obj.map f.op).hom (β₀ V y) = w Z V f y := by
    refine ⟨fun V y => (hsh _ (hScov V y)).amalgamate _ (hxc V y), fun V y Z f hf => ?_⟩
    rw [← hfam V y Z f hf]
    exact (hsh _ (hScov V y)).valid_glue (hxc V y) f hf

  have hU : ∀ (V : X.Etale) (y : P.obj (Opposite.op V)) (s : F.obj.obj (Opposite.op V))
      (R : Sieve V), R ∈ Scheme.smallEtaleTopology X V →
      (∀ (Z : X.Etale) (f : Z ⟶ V), R.arrows f → (S V y).arrows f) →
      (∀ (Z : X.Etale) (f : Z ⟶ V), R.arrows f → (F.obj.map f.op).hom s = w Z V f y) →
      s = β₀ V y := by
    intro V y s R hR hRS hs
    apply (hsh R hR).isSeparatedFor.ext
    intro Z f hf
    change (F.obj.map f.op).hom s = (F.obj.map f.op).hom (β₀ V y)
    rw [hs Z f hf, hG V y Z f (hRS Z f hf)]

  have hadd : ∀ (V : X.Etale) (y y' : P.obj (Opposite.op V)),
      β₀ V (y + y') = β₀ V y + β₀ V y' := by
    intro V y y'
    symm
    apply hU V (y + y') _ (S V (y + y') ⊓ (S V y ⊓ S V y'))
    · exact (Scheme.smallEtaleTopology X).intersection_covering (hScov _ _)
        ((Scheme.smallEtaleTopology X).intersection_covering (hScov _ _) (hScov _ _))
    · intro Z f hf
      simp only [Sieve.inter_apply] at hf
      exact hf.1
    · intro Z f hf
      simp only [Sieve.inter_apply] at hf
      rw [map_add, hG V y Z f hf.2.1, hG V y' Z f hf.2.2, hwadd]

  have hnat : ∀ (V V₂ : X.Etale) (c : V₂ ⟶ V) (y : P.obj (Opposite.op V)),
      (F.obj.map c.op).hom (β₀ V y) = β₀ V₂ ((P.map c.op).hom y) := by
    intro V V₂ c y
    apply hU V₂ _ _ (S V₂ ((P.map c.op).hom y) ⊓ Sieve.pullback c (S V y))
    · exact (Scheme.smallEtaleTopology X).intersection_covering (hScov _ _)
        ((Scheme.smallEtaleTopology X).pullback_stable c (hScov V y))
    · intro Z f hf
      simp only [Sieve.inter_apply] at hf
      exact hf.1
    · intro Z f hf
      simp only [Sieve.inter_apply, Sieve.pullback_apply] at hf
      rw [← hFc, hG V y Z (f ≫ c) hf.2, hwc]
  let β : P ⟶ F.obj :=
    { app := fun V => AddCommGrpCat.ofHom (AddMonoidHom.mk' (β₀ V.unop) (hadd V.unop))
      naturality := by
        intro V V' c
        ext y
        simp only [AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply, AddCommGrpCat.hom_ofHom,
          AddMonoidHom.mk'_apply]
        exact (hnat V.unop V'.unop c.unop y).symm }
  refine ⟨β, fun Z hZ y => ?_⟩
  change β₀ Z y = t Z hZ y
  have h1 : (S Z y).arrows (𝟙 Z) := by
    rw [hS, Sieve.generate_apply]
    exact ⟨Z, 𝟙 Z, 𝟙 Z, Or.inl hZ, Category.id_comp _⟩
  have h2 := hG Z y Z (𝟙 Z) h1
  rw [hw0 _ _ _ _ hZ] at h2
  simpa using h2

theorem wc_et_split_local_trace : ∀ {X X' T : Scheme.{u}} (h : X' ⟶ X) (e : T ⟶ X) [Etale e] (d : ℕ) (σ : Fin d → (T ⟶ X')) (hσ : ∀ i, σ i ≫ h = e) (hσe : ∀ i, Etale (σ i)), (∀ (Z : Scheme.{u}) (l₁ l₂ : Z ⟶ T), l₁ ≫ e = l₂ ≫ e → ∃ U : Equiv.Perm (Fin d) → Z.Opens, (∀ z : Z, ∃ π, z ∈ U π) ∧ ∀ π j, (U π).ι ≫ l₂ ≫ σ j = (U π).ι ≫ l₁ ≫ σ (π j)) → ∀ (F : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) (G : Sheaf (Scheme.smallEtaleTopology X') AddCommGrpCat.{u+1}) (ρ : wcEtTransport h F G), (∀ (V : X.Etale) (O : X'.Etale) (k : O.left ⟶ V.left) (hk : k ≫ V.hom = O.hom ≫ h), IsIso k → Function.Bijective (ρ.ρ V O k hk)) → ∃ t : ∀ Z : X.Etale, (∃ lf : Z.left ⟶ T, lf ≫ e = Z.hom) → (G.obj.obj (Opposite.op ((wcEtBaseChange h).obj Z)) →+ F.obj.obj (Opposite.op Z)), (∀ (Z Z₁ : X.Etale) (k : Z ⟶ Z₁) hZ hZ₁ (y : G.obj.obj (Opposite.op ((wcEtBaseChange h).obj Z₁))), t Z hZ ((G.obj.map ((wcEtBaseChange h).map k).op).hom y) = (F.obj.map k.op).hom (t Z₁ hZ₁ y)) ∧ (∀ (Z : X.Etale) hZ (x : F.obj.obj (Opposite.op Z)), t Z hZ (ρ.ρ Z ((wcEtBaseChange h).obj Z) (Limits.pullback.fst Z.hom h) Limits.pullback.condition x) = d • x) :=
by
  intro X X' T h e _ d σ hσ hσe hperm F G ρ hbij
  classical

  have hsE : ∀ (Z : X.Etale) (lf : Z.left ⟶ T), lf ≫ e = Z.hom → ∀ i, Etale (lf ≫ σ i) := by
    intro Z lf hlf i
    haveI : Etale (lf ≫ e) := by rw [hlf]; exact Z.prop
    haveI : Etale lf := Etale.of_comp lf e
    haveI := hσe i
    infer_instance
  have hw : ∀ (Z : X.Etale) (lf : Z.left ⟶ T), lf ≫ e = Z.hom → ∀ i,
      𝟙 Z.left ≫ Z.hom = (lf ≫ σ i) ≫ h := by
    intro Z lf hlf i
    rw [Category.id_comp, Category.assoc, hσ i, hlf]

  let Sh : ∀ (Z : X.Etale) (lf : Z.left ⟶ T), lf ≫ e = Z.hom → Fin d → X'.Etale :=
    fun Z lf hlf i => MorphismProperty.Over.mk ⊤ (lf ≫ σ i) (hsE Z lf hlf i)
  let mi : ∀ (Z : X.Etale) (lf : Z.left ⟶ T) (hlf : lf ≫ e = Z.hom) (i : Fin d),
      Sh Z lf hlf i ⟶ (wcEtBaseChange h).obj Z :=
    fun Z lf hlf i => MorphismProperty.Over.homMk
      (Limits.pullback.lift (f := Z.hom) (g := h) (𝟙 Z.left) (lf ≫ σ i) (hw Z lf hlf i))
      (Limits.pullback.lift_snd (f := Z.hom) (g := h) _ _ _) trivial
  let E : ∀ (Z : X.Etale) (lf : Z.left ⟶ T) (hlf : lf ≫ e = Z.hom) (i : Fin d),
      F.obj.obj (Opposite.op Z) →+ G.obj.obj (Opposite.op (Sh Z lf hlf i)) :=
    fun Z lf hlf i => ρ.ρ Z (Sh Z lf hlf i) (𝟙 Z.left) (hw Z lf hlf i)
  have hEb : ∀ Z lf hlf i, Function.Bijective (E Z lf hlf i) := fun Z lf hlf i =>
    hbij Z (Sh Z lf hlf i) (𝟙 Z.left) (hw Z lf hlf i) ⟨⟨𝟙 _, Category.id_comp _, Category.id_comp _⟩⟩
  let c : ∀ (Z : X.Etale) (lf : Z.left ⟶ T), lf ≫ e = Z.hom → Fin d →
      (G.obj.obj (Opposite.op ((wcEtBaseChange h).obj Z)) →+ F.obj.obj (Opposite.op Z)) :=
    fun Z lf hlf i => (AddEquiv.ofBijective (E Z lf hlf i) (hEb Z lf hlf i)).symm.toAddMonoidHom.comp
      (G.obj.map (mi Z lf hlf i).op).hom
  have hstar : ∀ Z lf hlf i a g, E Z lf hlf i a = (G.obj.map (mi Z lf hlf i).op).hom g →
      c Z lf hlf i g = a := by
    intro Z lf hlf i a g H
    show (AddEquiv.ofBijective (E Z lf hlf i) (hEb Z lf hlf i)).symm
      ((G.obj.map (mi Z lf hlf i).op).hom g) = a
    rw [AddEquiv.symm_apply_eq]
    exact H.symm
  have hcinv : ∀ Z lf hlf i g, E Z lf hlf i (c Z lf hlf i g) =
      (G.obj.map (mi Z lf hlf i).op).hom g := by
    intro Z lf hlf i g
    exact (AddEquiv.ofBijective (E Z lf hlf i) (hEb Z lf hlf i)).apply_symm_apply _
  have hGc : ∀ {O₁ O₂ O₃ : X'.Etale} (a : O₁ ⟶ O₂) (b : O₂ ⟶ O₃) (y : G.obj.obj (Opposite.op O₃)),
      (G.obj.map a.op).hom ((G.obj.map b.op).hom y) = (G.obj.map (a ≫ b).op).hom y := by
    intro O₁ O₂ O₃ a b y
    rw [op_comp, Functor.map_comp, AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply]
  have hFid : ∀ (Z : X.Etale) (x : F.obj.obj (Opposite.op Z)), (F.obj.map (𝟙 Z).op).hom x = x := by
    intro Z x
    exact (congrArg (fun f => (AddCommGrpCat.Hom.hom f) x) (F.obj.map_id (Opposite.op Z))).trans rfl

  have hR : ∀ (Z Z₁ : X.Etale) (k : Z ⟶ Z₁) (l₁ : Z₁.left ⟶ T) (hl₁ : l₁ ≫ e = Z₁.hom)
      (hl : (k.left ≫ l₁) ≫ e = Z.hom) (i : Fin d)
      (y : G.obj.obj (Opposite.op ((wcEtBaseChange h).obj Z₁))),
      c Z (k.left ≫ l₁) hl i ((G.obj.map ((wcEtBaseChange h).map k).op).hom y) =
        (F.obj.map k.op).hom (c Z₁ l₁ hl₁ i y) := by
    intro Z Z₁ k l₁ hl₁ hl i y
    refine hstar Z (k.left ≫ l₁) hl i _ _ ?_
    let n : Sh Z (k.left ≫ l₁) hl i ⟶ Sh Z₁ l₁ hl₁ i :=
      MorphismProperty.Over.homMk k.left
        (by show k.left ≫ l₁ ≫ σ i = (k.left ≫ l₁) ≫ σ i; rw [Category.assoc]) trivial
    have hnm : n ≫ mi Z₁ l₁ hl₁ i = mi Z (k.left ≫ l₁) hl i ≫ (wcEtBaseChange h).map k := by
      apply MorphismProperty.Over.Hom.ext
      show k.left ≫ Limits.pullback.lift (f := Z₁.hom) (g := h) (𝟙 Z₁.left) (l₁ ≫ σ i)
          (hw Z₁ l₁ hl₁ i) =
        Limits.pullback.lift (f := Z.hom) (g := h) (𝟙 Z.left) ((k.left ≫ l₁) ≫ σ i)
            (hw Z (k.left ≫ l₁) hl i) ≫
          Limits.pullback.lift (f := Z₁.hom) (g := h) (Limits.pullback.fst Z.hom h ≫ k.left)
            (Limits.pullback.snd Z.hom h)
            (by rw [Category.assoc, MorphismProperty.Over.w k]; exact Limits.pullback.condition)
      apply Limits.pullback.hom_ext
      · simp only [Category.assoc, Limits.pullback.lift_fst, Limits.pullback.lift_fst_assoc,
          Category.comp_id, Category.id_comp]
      · simp only [Category.assoc, Limits.pullback.lift_snd]
    have h1 := ρ.nat Z₁ Z k (Sh Z₁ l₁ hl₁ i) (Sh Z (k.left ≫ l₁) hl i) n (𝟙 Z₁.left)
      (hw Z₁ l₁ hl₁ i) (𝟙 Z.left) (hw Z (k.left ≫ l₁) hl i)
      ((Category.id_comp _).trans (Category.comp_id _).symm) (c Z₁ l₁ hl₁ i y)
    calc E Z (k.left ≫ l₁) hl i ((F.obj.map k.op).hom (c Z₁ l₁ hl₁ i y))
        = (G.obj.map n.op).hom (E Z₁ l₁ hl₁ i (c Z₁ l₁ hl₁ i y)) := h1
      _ = (G.obj.map n.op).hom ((G.obj.map (mi Z₁ l₁ hl₁ i).op).hom y) := by
          rw [hcinv Z₁ l₁ hl₁ i y]
      _ = (G.obj.map (n ≫ mi Z₁ l₁ hl₁ i).op).hom y := hGc _ _ _
      _ = (G.obj.map (mi Z (k.left ≫ l₁) hl i ≫ (wcEtBaseChange h).map k).op).hom y := by
          rw [hnm]
      _ = (G.obj.map (mi Z (k.left ≫ l₁) hl i).op).hom
          ((G.obj.map ((wcEtBaseChange h).map k).op).hom y) := (hGc _ _ _).symm

  have hS : ∀ (Z : X.Etale) (l l' : Z.left ⟶ T) (hl : l ≫ e = Z.hom) (hl' : l' ≫ e = Z.hom)
      (i j : Fin d), l ≫ σ j = l' ≫ σ i →
      ∀ y : G.obj.obj (Opposite.op ((wcEtBaseChange h).obj Z)), c Z l hl j y = c Z l' hl' i y := by
    intro Z l l' hl hl' i j hll y
    refine hstar Z l hl j _ _ ?_
    let δ : Sh Z l hl j ⟶ Sh Z l' hl' i :=
      MorphismProperty.Over.homMk (𝟙 Z.left)
        (by show 𝟙 Z.left ≫ l' ≫ σ i = l ≫ σ j; rw [Category.id_comp, hll]) trivial
    have hδm : δ ≫ mi Z l' hl' i = mi Z l hl j := by
      apply MorphismProperty.Over.Hom.ext
      show 𝟙 Z.left ≫ Limits.pullback.lift (f := Z.hom) (g := h) (𝟙 Z.left) (l' ≫ σ i)
          (hw Z l' hl' i) =
        Limits.pullback.lift (f := Z.hom) (g := h) (𝟙 Z.left) (l ≫ σ j) (hw Z l hl j)
      rw [Category.id_comp]
      apply Limits.pullback.hom_ext
      · rw [Limits.pullback.lift_fst, Limits.pullback.lift_fst]
      · rw [Limits.pullback.lift_snd, Limits.pullback.lift_snd, hll]
    have h1 := ρ.nat Z Z (𝟙 Z) (Sh Z l' hl' i) (Sh Z l hl j) δ (𝟙 Z.left)
      (hw Z l' hl' i) (𝟙 Z.left) (hw Z l hl j)
      ((Category.id_comp _).trans (Category.comp_id _).symm) (c Z l' hl' i y)
    calc E Z l hl j (c Z l' hl' i y)
        = E Z l hl j ((F.obj.map (𝟙 Z).op).hom (c Z l' hl' i y)) := by rw [hFid]
      _ = (G.obj.map δ.op).hom (E Z l' hl' i (c Z l' hl' i y)) := h1
      _ = (G.obj.map δ.op).hom ((G.obj.map (mi Z l' hl' i).op).hom y) := by
          rw [hcinv Z l' hl' i y]
      _ = (G.obj.map (δ ≫ mi Z l' hl' i).op).hom y := hGc _ _ _
      _ = (G.obj.map (mi Z l hl j).op).hom y := by rw [hδm]

  have hD : ∀ (Z : X.Etale) (lf : Z.left ⟶ T) (hlf : lf ≫ e = Z.hom) (i : Fin d)
      (x : F.obj.obj (Opposite.op Z)),
      c Z lf hlf i (ρ.ρ Z ((wcEtBaseChange h).obj Z) (Limits.pullback.fst Z.hom h)
        Limits.pullback.condition x) = x := by
    intro Z lf hlf i x
    refine hstar Z lf hlf i _ _ ?_
    have h1 := ρ.nat Z Z (𝟙 Z) ((wcEtBaseChange h).obj Z) (Sh Z lf hlf i) (mi Z lf hlf i)
      (Limits.pullback.fst Z.hom h) Limits.pullback.condition (𝟙 Z.left) (hw Z lf hlf i)
      (by
        show 𝟙 Z.left ≫ 𝟙 Z.left = Limits.pullback.lift (f := Z.hom) (g := h) (𝟙 Z.left)
          (lf ≫ σ i) (hw Z lf hlf i) ≫ Limits.pullback.fst Z.hom h
        rw [Limits.pullback.lift_fst, Category.id_comp]) x
    calc E Z lf hlf i x = E Z lf hlf i ((F.obj.map (𝟙 Z).op).hom x) := by rw [hFid]
      _ = _ := h1

  have hI : ∀ (Z : X.Etale) (l l' : Z.left ⟶ T) (hl : l ≫ e = Z.hom) (hl' : l' ≫ e = Z.hom)
      (y : G.obj.obj (Opposite.op ((wcEtBaseChange h).obj Z))),
      ∑ i, c Z l hl i y = ∑ i, c Z l' hl' i y := by
    intro Z l l' hl hl' y
    obtain ⟨U, hU, hUeq⟩ := hperm Z.left l l' (hl.trans hl'.symm)
    have hsh := (isSheaf_iff_isSheaf_of_type _ _).mp
      ((sheafCompose (Scheme.smallEtaleTopology X) (forget AddCommGrpCat.{u+1})).obj F).2
    let Sv : Sieve Z :=
      { arrows := fun Y f => (F.obj.map f.op).hom (∑ i, c Z l hl i y) =
          (F.obj.map f.op).hom (∑ i, c Z l' hl' i y)
        downward_closed := by
          intro Y Y' f hf g
          have hf' : (F.obj.map f.op).hom (∑ i, c Z l hl i y) =
              (F.obj.map f.op).hom (∑ i, c Z l' hl' i y) := hf
          show (F.obj.map (g ≫ f).op).hom (∑ i, c Z l hl i y) =
            (F.obj.map (g ≫ f).op).hom (∑ i, c Z l' hl' i y)
          rw [op_comp, Functor.map_comp, AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply,
            AddMonoidHom.comp_apply, hf'] }
    have hSv : Sv ∈ Scheme.smallEtaleTopology X Z := by
      change Sv ∈ Scheme.smallGrothendieckTopology @Etale X Z
      rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale X
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
      apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale X
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
      intro z
      obtain ⟨π, hz⟩ := hU z
      obtain ⟨w, hwz⟩ : z ∈ Set.range (U π).ι := by rw [Scheme.Opens.range_ι]; exact hz
      refine ⟨wcEtOpen X Z (U π), wcEtOpenι X Z (U π), w, ?_, ?_, hwz⟩
      · let P := wcEtOpen X Z (U π)
        let ι := wcEtOpenι X Z (U π)
        have hl1 : (ι.left ≫ l) ≫ e = P.hom := by
          rw [Category.assoc, hl]; exact MorphismProperty.Over.w ι
        have hl2 : (ι.left ≫ l') ≫ e = P.hom := by
          rw [Category.assoc, hl']; exact MorphismProperty.Over.w ι
        let yP := (G.obj.map ((wcEtBaseChange h).map ι).op).hom y
        show (F.obj.map ι.op).hom (∑ i, c Z l hl i y) = (F.obj.map ι.op).hom (∑ i, c Z l' hl' i y)
        rw [map_sum, map_sum]
        calc ∑ i, (F.obj.map ι.op).hom (c Z l hl i y)
            = ∑ i, c P (ι.left ≫ l) hl1 i yP :=
              Finset.sum_congr rfl (fun i _ => (hR P Z ι l hl hl1 i y).symm)
          _ = ∑ j, c P (ι.left ≫ l) hl1 (π j) yP := (Equiv.sum_comp π _).symm
          _ = ∑ j, c P (ι.left ≫ l') hl2 j yP :=
              Finset.sum_congr rfl (fun j _ => (hS P (ι.left ≫ l') (ι.left ≫ l) hl2 hl1 (π j) j
                (by rw [Category.assoc, Category.assoc]; exact hUeq π j) yP).symm)
          _ = ∑ j, (F.obj.map ι.op).hom (c Z l' hl' j y) :=
              Finset.sum_congr rfl (fun j _ => hR P Z ι l' hl' hl2 j y)
      · show Etale (U π).ι
        infer_instance
    exact (hsh Sv hSv).isSeparatedFor.ext (fun Y f hf => hf)

  refine ⟨fun Z hZ => ∑ i, c Z (Classical.choose hZ) (Classical.choose_spec hZ) i, ?_, ?_⟩
  · intro Z Z₁ k hZ hZ₁ y
    have hl : (k.left ≫ Classical.choose hZ₁) ≫ e = Z.hom := by
      rw [Category.assoc, Classical.choose_spec hZ₁, MorphismProperty.Over.w k]
    simp only [AddMonoidHom.finsetSum_apply]
    rw [hI Z (Classical.choose hZ) (k.left ≫ Classical.choose hZ₁) (Classical.choose_spec hZ) hl,
      map_sum]
    exact Finset.sum_congr rfl (fun i _ => hR Z Z₁ k _ (Classical.choose_spec hZ₁) hl i y)
  · intro Z hZ x
    simp only [AddMonoidHom.finsetSum_apply]
    rw [Finset.sum_congr rfl (fun i _ => hD Z (Classical.choose hZ) (Classical.choose_spec hZ) i x),
      Finset.sum_const, Finset.card_univ, Fintype.card_fin]

theorem wc_et_cover_lift_or_vanish : ∀ {X T : Scheme.{u}} (W : X.Opens) (q : T ⟶ (W : Scheme.{u})) [Etale q] [AlgebraicGeometry.Surjective q] (F : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}), wcSuppIn X (W : Set X) F → ∀ (V : X.Etale) (x : F.obj.obj (Opposite.op V)), Sieve.generate (fun (Z : X.Etale) (f : Z ⟶ V) => (∃ lf : Z.left ⟶ T, lf ≫ q ≫ W.ι = Z.hom) ∨ (F.obj.map f.op).hom x = 0) ∈ Scheme.smallEtaleTopology X V :=
by
  intro X T W q _ _ F hF V x
  have hjs : ∀ (Y : Scheme.{u}) (V : Y.Etale) (S : Sieve V), (∀ v : V.left, ∃ (V₁ : Y.Etale)
      (c : V₁ ⟶ V), S.arrows c ∧ v ∈ Set.range c.left) → S ∈ Scheme.smallEtaleTopology Y V := by
    intro Y V S hS
    change S ∈ Scheme.smallGrothendieckTopology @Etale Y V
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
    apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
    intro x
    obtain ⟨V₁, c, hc, y, hy⟩ := hS x
    have hw : c.left ≫ V.hom = V₁.hom := MorphismProperty.Over.w c
    have hEt : Etale c.left := by
      have h1 : Etale V.hom := V.prop
      have h2 : Etale (c.left ≫ V.hom) := by rw [hw]; exact V₁.prop
      exact Etale.of_comp c.left V.hom
    exact ⟨V₁, c, y, hc, hEt, hy⟩
  apply (Scheme.smallEtaleTopology X).transitive (hF V x)
  intro Z g hg
  obtain ⟨Z₀, k, g₀, hg₀, rfl⟩ := hg
  rcases hg₀ with h0 | hW₀
  · apply (Scheme.smallEtaleTopology X).covering_of_eq_top
    apply Sieve.pullback_eq_top_of_mem
    refine ⟨Z, 𝟙 Z, k ≫ g₀, Or.inr ?_, Category.id_comp _⟩
    rw [op_comp, Functor.map_comp, AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply]
    have h0' : (F.obj.map g₀.op).hom x = 0 := h0
    rw [h0', map_zero]
  · have hZW : ∀ z : Z.left, Z.hom z ∈ (W : Set X) := by
      intro z
      rw [← MorphismProperty.Over.w k, Scheme.Hom.comp_apply]
      exact hW₀ _
    haveI : Etale Z.hom := Z.prop
    let Z₁ : X.Etale := MorphismProperty.Over.mk ⊤
      (Limits.pullback.fst Z.hom (q ≫ W.ι) ≫ Z.hom) (by infer_instance)
    let c : Z₁ ⟶ Z := MorphismProperty.Over.homMk (Limits.pullback.fst Z.hom (q ≫ W.ι)) rfl trivial
    apply hjs
    intro z
    refine ⟨Z₁, c, ?_, ?_⟩
    · refine ⟨Z₁, 𝟙 Z₁, c ≫ k ≫ g₀,
        Or.inl ⟨Limits.pullback.snd Z.hom (q ≫ W.ι), ?_⟩, Category.id_comp _⟩
      exact Limits.pullback.condition.symm
    · change z ∈ Set.range (Limits.pullback.fst Z.hom (q ≫ W.ι))
      rw [Scheme.Pullback.range_fst]
      obtain ⟨w, hw⟩ : Z.hom z ∈ Set.range W.ι := by
        rw [Scheme.Opens.range_ι]; exact hZW z
      obtain ⟨t, ht⟩ := AlgebraicGeometry.Surjective.surj (f := q) w
      exact ⟨t, by rw [Scheme.Hom.comp_apply, ht, hw]⟩

theorem wc_et_finite_etale_trace_retract {X X' T : Scheme.{u}} (h : X' ⟶ X) [IsFinite h]
    (W : X.Opens) (q : T ⟶ (W : Scheme.{u})) [Etale q] [AlgebraicGeometry.Surjective q]
    (ℓ d : ℕ) (hℓ : ℓ.Prime) (hd : ¬ ℓ ∣ d) (σ : Fin d → (T ⟶ X')) (hσ : ∀ i, σ i ≫ h = q ≫ W.ι)
    (hsplit : IsIso (Limits.Sigma.desc (fun i => Limits.pullback.lift (σ i) (𝟙 T)
      ((hσ i).trans (Category.id_comp (q ≫ W.ι)).symm)) :
        ∐ (fun _ : Fin d => T) ⟶ Limits.pullback h (q ≫ W.ι)))
    (F : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) (hF : wcSuppIn X (W : Set X) F)
    (htor : ℓ • 𝟙 F = 0)
    (L : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1} ⥤
      Sheaf (Scheme.smallEtaleTopology X') AddCommGrpCat.{u+1})
    (hL : Nonempty (L ⊣ wcEtPush h)) :
    ∃ (s : F ⟶ (wcEtPush h).obj (L.obj F)) (r : (wcEtPush h).obj (L.obj F) ⟶ F), s ≫ r = 𝟙 F :=
by
  classical
  obtain ⟨adj⟩ := hL
  haveI := hsplit

  have hσe : ∀ i, Etale (σ i) := by
    intro i
    have hfac : σ i = Limits.Sigma.ι (fun _ : Fin d => T) i ≫
        Limits.Sigma.desc (fun i => Limits.pullback.lift (σ i) (𝟙 T)
          ((hσ i).trans (Category.id_comp (q ≫ W.ι)).symm)) ≫
        Limits.pullback.fst h (q ≫ W.ι) := by
      rw [Limits.Sigma.ι_comp_desc_assoc, Limits.pullback.lift_fst]
    rw [hfac]
    infer_instance

  have hjs : ∀ (Y : Scheme.{u}) (V : Y.Etale) (S : Sieve V), (∀ v : V.left, ∃ (V₁ : Y.Etale)
      (c : V₁ ⟶ V), S.arrows c ∧ v ∈ Set.range c.left) → S ∈ Scheme.smallEtaleTopology Y V := by
    intro Y V S hS
    change S ∈ Scheme.smallGrothendieckTopology @Etale Y V
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
    apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
    intro x
    obtain ⟨V₁, c, hc, y, hy⟩ := hS x
    have hw : c.left ≫ V.hom = V₁.hom := MorphismProperty.Over.w c
    have hEt : Etale c.left := by
      have h1 : Etale V.hom := V.prop
      have h2 : Etale (c.left ≫ V.hom) := by rw [hw]; exact V₁.prop
      exact Etale.of_comp c.left V.hom
    exact ⟨V₁, c, y, hc, hEt, hy⟩
  have hcov : ∀ {X B : Scheme.{u}} (g : X ⟶ B), CoverPreserving (Scheme.smallEtaleTopology B)
      (Scheme.smallEtaleTopology X) (wcEtBaseChange g) := by
    intro X B g
    constructor
    intro V S hS
    change S ∈ Scheme.smallGrothendieckTopology @Etale B V at hS
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale B
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hS
    have hS' := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale B
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mp hS
    apply hjs
    intro v
    obtain ⟨W, a, w, ha, -, hw⟩ := hS' (Limits.pullback.fst V.hom g v)
    refine ⟨(wcEtBaseChange g).obj W, (wcEtBaseChange g).map a,
      Sieve.image_mem_functorPushforward (wcEtBaseChange g) S ha, ?_⟩
    have h0 : (Limits.pullback.fst W.hom g ≫ a.left) ≫ V.hom = Limits.pullback.snd W.hom g ≫ g := by
      rw [Category.assoc, MorphismProperty.Over.w a]
      exact Limits.pullback.condition
    let m : Limits.pullback W.hom g ⟶ Limits.pullback V.hom g :=
      Limits.pullback.lift (Limits.pullback.fst W.hom g ≫ a.left) (Limits.pullback.snd W.hom g) h0
    have hmap : ((wcEtBaseChange g).map a).left = m := rfl
    have h1 : Limits.pullback.fst a.left (Limits.pullback.fst V.hom g) ≫ W.hom =
        (Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) ≫ Limits.pullback.snd V.hom g) ≫ g := by
      rw [← MorphismProperty.Over.w a, ← Category.assoc, Limits.pullback.condition, Category.assoc,
        Limits.pullback.condition, Category.assoc]
    let ψ : Limits.pullback a.left (Limits.pullback.fst V.hom g) ⟶ Limits.pullback W.hom g :=
      Limits.pullback.lift (Limits.pullback.fst a.left (Limits.pullback.fst V.hom g))
        (Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) ≫ Limits.pullback.snd V.hom g) h1
    have hψ : ψ ≫ m = Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, Limits.pullback.lift_fst, ← Category.assoc, Limits.pullback.lift_fst,
          Limits.pullback.condition]
      · rw [Category.assoc, Limits.pullback.lift_snd, Limits.pullback.lift_snd]
    obtain ⟨z, hz⟩ : ∃ z, Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) z = v := by
      have hv : (v : ↥(Limits.pullback V.hom g)) ∈
          Set.range (Limits.pullback.snd a.left (Limits.pullback.fst V.hom g)) := by
        rw [Scheme.Pullback.range_snd]
        exact ⟨w, hw⟩
      exact hv
    rw [hmap]
    exact ⟨ψ z, (Scheme.Hom.comp_apply ψ m z).symm.trans (by rw [hψ]; exact hz)⟩
  haveI h1 : Limits.PreservesFiniteLimits (wcEtBaseChange h) := ⟨fun J _ _ =>
    haveI : Limits.PreservesLimitsOfShape J (wcEtBaseChange h ⋙ Scheme.Etale.forget X') :=
      Limits.preservesLimitsOfShape_of_natIso
        (NatIso.ofComponents (fun _ => Iso.refl _) (fun _ => rfl) :
          Scheme.Etale.forget X ⋙ Over.pullback h ≅ wcEtBaseChange h ⋙ Scheme.Etale.forget X')
    Limits.preservesLimitsOfShape_of_reflects_of_preserves (wcEtBaseChange h) (Scheme.Etale.forget X')⟩
  haveI := flat_of_preservesFiniteLimits (wcEtBaseChange h)
  haveI hcont : (wcEtBaseChange h).IsContinuous (Scheme.smallEtaleTopology X)
      (Scheme.smallEtaleTopology X') :=
    Functor.isContinuous_of_coverPreserving (compatiblePreservingOfFlat _ _) (hcov h)

  obtain ⟨ρ, hρU, -⟩ := wc_et_adjoint_univ_transport h L ⟨adj⟩
  have hbij := wc_et_univ_transport_bijective_of_iso h F (L.obj F) (ρ F) (hρU F)
  have hperm : ∀ (Z : Scheme.{u}) (l₁ l₂ : Z ⟶ T), l₁ ≫ q ≫ W.ι = l₂ ≫ q ≫ W.ι →
      ∃ U : Equiv.Perm (Fin d) → Z.Opens, (∀ z : Z, ∃ π, z ∈ U π) ∧
        ∀ π j, (U π).ι ≫ l₂ ≫ σ j = (U π).ι ≫ l₁ ≫ σ (π j) :=
    fun Z l₁ l₂ hl => wc_split_local_perm h (q ≫ W.ι) d σ hσ hsplit l₁ l₂ hl
  obtain ⟨t, ht_nat, ht_deg⟩ :=
    wc_et_split_local_trace h (q ≫ W.ι) d σ hσ hσe hperm F (L.obj F) (ρ F) hbij
  have hG := wc_et_supp_left_adjoint_pullback h L ⟨adj⟩ (W : Set X) F hF

  let P : (X.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1} := (wcEtBaseChange h).op ⋙ (L.obj F).obj
  obtain ⟨β, hβ⟩ := wc_et_glue_presheaf_hom P F (fun Z => ∃ lf : Z.left ⟶ T, lf ≫ q ≫ W.ι = Z.hom)
    (fun Z Z₁ k hk => by
      obtain ⟨lf, hlf⟩ := hk
      exact ⟨k.left ≫ lf, by rw [Category.assoc, hlf, MorphismProperty.Over.w k]⟩)
    t (fun Z Z₁ k hZ hZ₁ y => ht_nat Z Z₁ k hZ hZ₁ y)
    (fun V y => wc_et_cover_lift_or_push_vanish h W q (L.obj F) hG V y)

  have hbcmap : ∀ {V V' : X.Etale} (c : V' ⟶ V),
      Limits.pullback.fst V'.hom h ≫ c.left =
        ((wcEtBaseChange h).map c).left ≫ Limits.pullback.fst V.hom h := by
    intro V V' c
    exact (Limits.pullback.lift_fst _ _ _).symm
  let α : F.obj ⟶ P :=
    { app := fun V => AddCommGrpCat.ofHom ((ρ F).ρ V.unop ((wcEtBaseChange h).obj V.unop)
          (Limits.pullback.fst V.unop.hom h) Limits.pullback.condition)
      naturality := by
        intro V V' c
        ext x
        exact (ρ F).nat V.unop V'.unop c.unop _ _ ((wcEtBaseChange h).map c.unop) _ _ _ _
          (hbcmap c.unop) x }

  have hnat : ∀ {V V' : X.Etale} (c : V' ⟶ V) (x : F.obj.obj (Opposite.op V)),
      (F.obj.map c.op).hom ((β.app (Opposite.op V)).hom ((α.app (Opposite.op V)).hom x)) =
        (β.app (Opposite.op V')).hom ((α.app (Opposite.op V')).hom ((F.obj.map c.op).hom x)) := by
    intro V V' c x
    have := congrArg (fun φ => φ.hom x) ((α ≫ β).naturality c.op)
    simp only [NatTrans.comp_app, AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply] at this
    exact this.symm
  have hkey : ∀ (V : X.Etale) (x : F.obj.obj (Opposite.op V)),
      (β.app (Opposite.op V)).hom ((α.app (Opposite.op V)).hom x) = d • x := by
    intro V x
    have hsh := (isSheaf_iff_isSheaf_of_type _ _).mp
      ((sheafCompose (Scheme.smallEtaleTopology X) (forget AddCommGrpCat.{u+1})).obj F).2
    have hcv := wc_et_cover_lift_or_vanish W q F hF V x
    refine (hsh _ hcv).isSeparatedFor.ext (fun Z f hf => ?_)
    obtain ⟨Z₁, g, f₁, hf₁, rfl⟩ := hf
    change (F.obj.map (g ≫ f₁).op).hom ((β.app (Opposite.op V)).hom ((α.app (Opposite.op V)).hom x)) =
      (F.obj.map (g ≫ f₁).op).hom (d • x)
    rw [hnat (g ≫ f₁) x, map_nsmul]
    rcases hf₁ with ⟨lf, hlf⟩ | h0
    · have hA : ∃ lf : Z.left ⟶ T, lf ≫ q ≫ W.ι = Z.hom :=
        ⟨g.left ≫ lf, by rw [Category.assoc, hlf, MorphismProperty.Over.w g]⟩
      rw [hβ Z hA]
      exact ht_deg Z hA _
    · have hy : (F.obj.map (g ≫ f₁).op).hom x = 0 := by
        rw [op_comp, Functor.map_comp, AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply, h0, map_zero]
      rw [hy, map_zero, map_zero, smul_zero]

  have hcop : Nat.Coprime d ℓ := ((Nat.Prime.coprime_iff_not_dvd hℓ).2 hd).symm
  obtain ⟨a, -, ha⟩ := Nat.exists_mul_mod_eq_one_of_coprime hcop hℓ.one_lt
  have hda : d * a = ℓ * (d * a / ℓ) + 1 := by
    have := Nat.div_add_mod (d * a) ℓ
    rw [ha] at this
    exact this.symm
  have hsr : (d * a) • 𝟙 F = 𝟙 F := by
    rw [hda, add_nsmul, mul_nsmul, htor, smul_zero, one_nsmul, zero_add]

  let s : F ⟶ (wcEtPush h).obj (L.obj F) :=
    ObjectProperty.homMk (α ≫ toSheafify (Scheme.smallEtaleTopology X) P)
  let r₀ : (wcEtPush h).obj (L.obj F) ⟶ F :=
    ObjectProperty.homMk (sheafifyLift (Scheme.smallEtaleTopology X) β F.property)
  have hsr₀ : s ≫ r₀ = d • 𝟙 F := by
    apply Sheaf.hom_ext
    change (α ≫ toSheafify (Scheme.smallEtaleTopology X) P) ≫
        sheafifyLift (Scheme.smallEtaleTopology X) β F.property =
      (sheafToPresheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map (d • 𝟙 F)
    rw [Functor.map_nsmul, CategoryTheory.Functor.map_id, Category.assoc, toSheafify_sheafifyLift]
    ext V x
    simp only [NatTrans.comp_app, NatTrans.app_nsmul, NatTrans.id_app, AddCommGrpCat.hom_comp,
      AddCommGrpCat.hom_nsmul, AddCommGrpCat.hom_id, AddMonoidHom.comp_apply,
      AddMonoidHom.nsmul_apply, AddMonoidHom.id_apply]
    exact hkey V.unop x
  refine ⟨s, a • r₀, ?_⟩
  rw [Preadditive.comp_nsmul, hsr₀, smul_smul, mul_comm a d, hsr]

theorem wc_etsplits_base_change : ∀ {X E E' : Scheme.{u}} (e : E ⟶ X) (T : X.Etale) (A : Type u) (s : A → (E ⟶ T.left)), wcEtSplits e T A s → ∀ (g : E' ⟶ E), wcEtSplits (g ≫ e) T A (fun a => g ≫ s a) :=
by
  intro X E E' e T A s hsplit g
  obtain ⟨hA, hs, hΦ⟩ := hsplit
  have hs' : ∀ a, (fun a => g ≫ s a) a ≫ T.hom = g ≫ e := fun a => by
    simp only [Category.assoc, hs a]
  refine ⟨hA, hs', ?_⟩
  let ι : A → (E ⟶ Limits.pullback T.hom e) := fun a =>
    Limits.pullback.lift (s a) (𝟙 E) ((hs a).trans (Category.id_comp e).symm)
  let c : Limits.Cofan (fun _ : A => E) := Limits.Cofan.mk (Limits.pullback T.hom e) ι
  have : IsIso (Limits.Sigma.desc c.inj) := hΦ
  have hc : Limits.IsColimit c := Limits.Cofan.isColimitOfIsIsoSigmaDesc c
  have hU : IsUniversalColimit c := FinitaryPreExtensive.isUniversal_finiteCoproducts hc
  let q₁ := Limits.pullback.fst T.hom (g ≫ e)
  let q₂ := Limits.pullback.snd T.hom (g ≫ e)
  let h : Limits.pullback T.hom (g ≫ e) ⟶ Limits.pullback T.hom e :=
    Limits.pullback.lift q₁ (q₂ ≫ g) (Limits.pullback.condition.trans (Category.assoc _ _ _).symm)
  have hQ : IsPullback q₂ h g (Limits.pullback.snd T.hom e) := by
    have h1 : IsPullback (h ≫ Limits.pullback.fst T.hom e) q₂ T.hom (g ≫ e) := by
      rw [Limits.pullback.lift_fst]
      exact IsPullback.of_hasPullback T.hom (g ≫ e)
    exact (IsPullback.of_right h1 (Limits.pullback.lift_snd _ _ _)
      (IsPullback.of_hasPullback T.hom e)).flip
  let κ : A → (E' ⟶ Limits.pullback T.hom (g ≫ e)) := fun a =>
    Limits.pullback.lift (g ≫ s a) (𝟙 E') ((hs' a).trans (Category.id_comp _).symm)
  let d : Limits.Cofan (fun _ : A => E') := Limits.Cofan.mk _ κ
  have hd : Nonempty (Limits.IsColimit d) :=
    hU.nonempty_isColimit_of_pullbackCone_left (fun _ => 𝟙 E) (Limits.pullback.snd T.hom e) g
      (fun _ => Limits.PullbackCone.mk (𝟙 E') g (by simp))
      (fun _ => (IsPullback.id_horiz g).isLimit)
      (Limits.PullbackCone.mk q₂ h hQ.w) hQ.isLimit d (Iso.refl _)
      (fun a => Limits.pullback.lift_snd _ _ _)
      (fun a => by
        change κ a ≫ 𝟙 _ ≫ q₂ = 𝟙 E'
        rw [Category.id_comp]
        exact Limits.pullback.lift_snd _ _ _)
      (fun a => by
        change κ a ≫ 𝟙 _ ≫ h = g ≫ ι a
        rw [Category.id_comp]
        apply Limits.pullback.hom_ext
        · simp only [κ, h, ι, q₁, Category.assoc, Limits.pullback.lift_fst]
        · simp only [κ, h, ι, q₂, Category.assoc, Limits.pullback.lift_snd,
            Limits.pullback.lift_snd_assoc, Category.id_comp, Category.comp_id])
  obtain ⟨hd⟩ := hd
  have key : Limits.Sigma.desc κ =
      ((Limits.colimit.isColimit (Discrete.functor fun _ : A => E')).coconePointUniqueUpToIso
        hd).hom := by
    apply Limits.Sigma.hom_ext
    intro a
    rw [Limits.Sigma.ι_comp_desc]
    exact ((Limits.colimit.isColimit _).comp_coconePointUniqueUpToIso_hom hd ⟨a⟩).symm
  show IsIso (Limits.Sigma.desc κ)
  rw [key]
  infer_instance

theorem wc_ggs_galois_field_split : ∀ (Y : Scheme.{u}) [CompactSpace Y] [QuasiSeparatedSpace Y] (y : Y) (U V : Y.Etale), CompactSpace U.left → QuasiSeparatedSpace U.left → CompactSpace V.left → QuasiSeparatedSpace V.left → ∃ (L : Type u) (_ : Field L) (_ : Algebra (Y.residueField y) L) (_ : FiniteDimensional (Y.residueField y) L) (_ : IsGalois (Y.residueField y) L) (A B : Type u) (a : A → (Spec (.of L) ⟶ U.left)) (b : B → (Spec (.of L) ⟶ V.left)), wcEtSplits (Spec.map (CommRingCat.ofHom (algebraMap (Y.residueField y) L)) ≫ Y.fromSpecResidueField y) U A a ∧ wcEtSplits (Spec.map (CommRingCat.ofHom (algebraMap (Y.residueField y) L)) ≫ Y.fromSpecResidueField y) V B b :=
by
  intro Y _ _ y U V hU hU' hV hV'
  classical

  have s2 : ∀ {P S : Scheme.{u}} (π : P ⟶ S) [Etale π] (σ : S ⟶ P), σ ≫ π = 𝟙 S →
      IsOpenImmersion σ := by
    intro P S π _ σ hσ
    have h1 : IsOpenImmersion (Limits.pullback.diagonal π) :=
      FormallyUnramified.isOpenImmersion_diagonal π
    have hpb := Limits.pullback_lift_diagonal_isPullback σ π
    have h2 := MorphismProperty.of_isPullback (P := @IsOpenImmersion) hpb h1
    haveI : IsIso (σ ≫ π) := by rw [hσ]; infer_instance
    haveI := h2
    have e : Limits.pullback.lift (𝟙 S) σ (by rw [Category.id_comp]) ≫
        Limits.pullback.snd (σ ≫ π) π = σ := Limits.pullback.lift_snd _ _ _
    rw [← e]
    infer_instance
  have hsurjSigma : ∀ {E P : Scheme.{u}} {A : Type u} (_hc : Limits.HasCoproduct (fun _ : A => E))
      (ℓ : A → (E ⟶ P)),
      (∀ z : P, ∃ (a : A) (x : E), ℓ a x = z) → Function.Surjective (Limits.Sigma.desc ℓ) := by
    intro E P A _ ℓ h z
    obtain ⟨a, x, hx⟩ := h z
    refine ⟨(Limits.Sigma.ι (fun _ : A => E) a) x, ?_⟩
    rw [← Scheme.Hom.comp_apply, Limits.Sigma.ι_desc]
    exact hx

  have s3 : ∀ {X E : Scheme.{u}} (e : E ⟶ X) (T : X.Etale) (k : ℕ) (s : Fin k → (E ⟶ T.left))
      (hs : ∀ a, s a ≫ T.hom = 𝟙 _ ≫ e),
      (∀ a, IsOpenImmersion (Limits.pullback.lift (s a) (𝟙 _) (hs a))) →
      (∀ (a a' : Fin k) (x x' : E), Limits.pullback.lift (s a) (𝟙 _) (hs a) x =
        Limits.pullback.lift (s a') (𝟙 _) (hs a') x' → a = a') →
      (∀ z : ↥(Limits.pullback T.hom e), ∃ (a : Fin k) (x : E),
        Limits.pullback.lift (s a) (𝟙 _) (hs a) x = z) →
      wcEtSplits e T (ULift.{u} (Fin k)) (fun a => s a.down) := by
    intro X E e T k s hs hopen hinj hsurj
    refine ⟨inferInstance, fun a => (hs a.down).trans (Category.id_comp e), ?_⟩
    haveI : ∀ a : ULift.{u} (Fin k),
        IsOpenImmersion (Limits.pullback.lift (s a.down) (𝟙 E) (hs a.down)) :=
      fun a => hopen a.down
    rw [isIso_iff_isOpenImmersion_and_surjective]
    constructor
    · apply isOpenImmersion_sigmaDesc
      intro a a' hne
      show Disjoint _ _
      refine Set.disjoint_left.mpr ?_
      rintro z ⟨x, rfl⟩ ⟨x', hx'⟩
      exact hne (ULift.ext _ _ (hinj _ _ _ _ hx'.symm))
    · rw [surjective_iff]
      refine hsurjSigma _ _ (fun z => ?_)
      obtain ⟨a, x, hx⟩ := hsurj z
      exact ⟨⟨a⟩, x, hx⟩

  have s4 : ∀ (k K : Type u) [Field k] [Field K] [Algebra k K] [FiniteDimensional k K]
      [Algebra.IsSeparable k K], ∃ (L : Type u) (_ : Field L) (_ : Algebra k L)
      (_ : FiniteDimensional k L) (_ : IsGalois k L), Nonempty (K →ₐ[k] L) := by
    intro k K _ _ _ _ _
    let pb := Field.powerBasisOfFiniteOfSeparable k K
    have hsep : (minpoly k pb.gen).Separable := Algebra.IsSeparable.isSeparable k pb.gen
    refine ⟨(minpoly k pb.gen).SplittingField, inferInstance, inferInstance, inferInstance,
      IsGalois.of_separable_splitting_field hsep, ?_⟩
    have hdeg : ((minpoly k pb.gen).map
        (algebraMap k (minpoly k pb.gen).SplittingField)).degree ≠ 0 := by
      rw [Polynomial.degree_map]
      exact (minpoly.degree_pos (IsIntegral.of_finite k pb.gen)).ne'
    obtain ⟨r, hr⟩ := (Polynomial.SplittingField.splits (minpoly k pb.gen)).exists_eval_eq_zero hdeg
    refine ⟨pb.lift r ?_⟩
    rw [Polynomial.aeval_def, ← Polynomial.eval_map]
    exact hr

  obtain ⟨K, _, _, _, _, k, uK, huK, hinjU, hsurjU, k', vK, hvK, hinjV, hsurjV⟩ :=
    wc_etale_fiber_split_field Y y U V hU hU' hV hV'
  haveI : Etale U.hom := U.prop
  haveI : Etale V.hom := V.prop
  have hUo : ∀ a, IsOpenImmersion (Limits.pullback.lift (uK a) (𝟙 _) (huK a)) := fun a =>
    s2 (Limits.pullback.snd U.hom _) _ (Limits.pullback.lift_snd _ _ _)
  have hVo : ∀ b, IsOpenImmersion (Limits.pullback.lift (vK b) (𝟙 _) (hvK b)) := fun b =>
    s2 (Limits.pullback.snd V.hom _) _ (Limits.pullback.lift_snd _ _ _)
  have hU1 := s3 _ U k uK huK hUo hinjU hsurjU
  have hV1 := s3 _ V k' vK hvK hVo hinjV hsurjV
  obtain ⟨L, _, _, _, _, ⟨ψ⟩⟩ := s4 (Y.residueField y) K
  obtain ⟨g, hg⟩ : ∃ g : Spec (.of L) ⟶ Spec (.of K),
      g ≫ Spec.map (CommRingCat.ofHom (algebraMap (Y.residueField y) K)) =
        Spec.map (CommRingCat.ofHom (algebraMap (Y.residueField y) L)) :=
    ⟨Spec.map (CommRingCat.ofHom (ψ : K →+* L)), by
      rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, AlgHom.comp_algebraMap]⟩
  have hU2 := wc_etsplits_base_change _ U _ _ hU1 g
  have hV2 := wc_etsplits_base_change _ V _ _ hV1 g
  rw [← Category.assoc, hg] at hU2 hV2
  exact ⟨L, inferInstance, inferInstance, inferInstance, inferInstance, _, _, _, _, hU2, hV2⟩

theorem wc_ggs_galois_spread : ∀ (X : Scheme.{u}) [IsLocallyNoetherian X] (W₀ : X.Opens), IsAffineOpen W₀ → ∀ (η : X), η ∈ W₀ → (∀ w ∈ W₀, η ⤳ w) → ∀ (L : Type u) [Field L] [Algebra (X.residueField η) L] [FiniteDimensional (X.residueField η) L] [IsGalois (X.residueField η) L], ∃ (W₁ : X.Opens) (E : Scheme.{u}) (q : E ⟶ (W₁ : Scheme.{u})) (Γ : Type u) (_ : Group Γ) (α : Γ →* Aut E) (ε : E) (g : Spec (E.residueField ε) ⟶ Spec (.of L)), W₁ ≤ W₀ ∧ η ∈ W₁ ∧ IsAffineOpen W₁ ∧ IsAffine E ∧ IsLocallyNoetherian E ∧ wcGalCover q Γ α ∧ (∀ x : E, ε ⤳ x) ∧ (q ≫ W₁.ι) ε = η ∧ (∀ x : E, (q ≫ W₁.ι) x = η → x = ε) ∧ g ≫ Spec.map (CommRingCat.ofHom (algebraMap (X.residueField η) L)) ≫ X.fromSpecResidueField η = E.fromSpecResidueField ε ≫ q ≫ W₁.ι :=
by

  have s1 : ∀ (X : Scheme.{u}) [IsLocallyNoetherian X] (W₀ : X.Opens), IsAffineOpen W₀ → ∀ (η : X) (hη : η ∈ W₀), (∀ w ∈ W₀, η ⤳ w) → IsNoetherianRing Γ(X, W₀) ∧ (∀ k : X.residueField η, ∃ a b : Γ(X, W₀), (X.evaluation W₀ η hη).hom b ≠ 0 ∧ k * (X.evaluation W₀ η hη).hom b = (X.evaluation W₀ η hη).hom a) ∧ (∀ a : Γ(X, W₀), (X.evaluation W₀ η hη).hom a = 0 → IsNilpotent a) := by
    intro X _ W₀ hW₀ η hη hgen
    refine ⟨IsLocallyNoetherian.component_noetherian ⟨W₀, hW₀⟩, ?_, ?_⟩
    · intro k
      obtain ⟨t, rfl⟩ := X.residue_surjective η k
      letI := TopCat.Presheaf.algebra_section_stalk X.presheaf (⟨η, hη⟩ : W₀)
      haveI := hW₀.isLocalization_stalk ⟨η, hη⟩
      obtain ⟨⟨a, b⟩, hab⟩ := IsLocalization.mk'_surjective (hW₀.primeIdealOf ⟨η, hη⟩).asIdeal.primeCompl t
      have hspec := IsLocalization.mk'_spec (X.presheaf.stalk η) a b
      simp only at hab
      rw [hab] at hspec
      have halg : ∀ z : Γ(X, W₀), algebraMap Γ(X, W₀) (X.presheaf.stalk η) z = (X.presheaf.germ W₀ η hη).hom z := fun z => rfl
      have hev : ∀ z : Γ(X, W₀), (X.evaluation W₀ η hη).hom z = (X.residue η).hom ((X.presheaf.germ W₀ η hη).hom z) := by
        intro z; rw [← Scheme.germ_residue]; rfl
      refine ⟨a, b, ?_, ?_⟩
      · rw [hev, ← halg]
        have hu : IsUnit (algebraMap Γ(X, W₀) (X.presheaf.stalk η) b) := IsLocalization.map_units _ b
        exact (hu.map (X.residue η).hom).ne_zero
      · rw [hev, hev, ← halg, ← halg, ← map_mul, hspec]
    · intro a ha
      have h1 : η ∉ X.basicOpen a := by
        rw [← X.evaluation_ne_zero_iff_mem_basicOpen η hη]; exact not_not.mpr ha
      have h2 : X.basicOpen a = ⊥ := by
        ext w
        simp only [TopologicalSpace.Opens.mem_bot, iff_false, SetLike.mem_coe]
        intro hw
        exact h1 ((hgen w (X.basicOpen_le a hw)).mem_open (X.basicOpen a).isOpen hw)
      have h3 := hW₀.fromSpec_preimage_basicOpen a
      rw [h2] at h3
      rw [← PrimeSpectrum.basicOpen_eq_bot_iff, ← h3]
      ext x
      exact ⟨fun h => (show False from h).elim, fun h => (show False from h).elim⟩

  have s2 : ∀ (A K L : Type u) [CommRing A] [Field K] [Field L] [Algebra K L] [FiniteDimensional K L] [IsGalois K L] (ρ : A →+* K), (∀ k : K, ∃ a b : A, ρ b ≠ 0 ∧ k * ρ b = ρ a) → (∀ a : A, ρ a = 0 → IsNilpotent a) → ∃ s : A, ρ s ≠ 0 ∧ ∀ (R : Type u) [CommRing R] [Algebra A R] [IsLocalization.Away s R] (ρR : R →+* K), ρR.comp (algebraMap A R) = ρ → ∃ (f U V : Polynomial R) (π : AdjoinRoot f →+* L), f.Monic ∧ f.natDegree = Nat.card (L ≃ₐ[K] L) ∧ f * U + Polynomial.derivative f * V = 1 ∧ π.comp (AdjoinRoot.of f) = (algebraMap K L).comp ρR ∧ (∀ b, π b = 0 → IsNilpotent b) ∧ (∀ l : L, ∃ b b' : AdjoinRoot f, π b' ≠ 0 ∧ l * π b' = π b) ∧ (∀ γ : L ≃ₐ[K] L, ∃ y : AdjoinRoot f, π y = γ (π (AdjoinRoot.root f))) ∧ (∀ γ δ : L ≃ₐ[K] L, γ (π (AdjoinRoot.root f)) = δ (π (AdjoinRoot.root f)) → γ = δ) := by
    intro A K L _ _ _ _ _ _ ρ hfrac hnil
    classical

    have cd : ∀ (S : Type u) [CommRing S] (σ : S →+* K), (∀ k : K, ∃ a b : S, σ b ≠ 0 ∧ k * σ b = σ a) →
        ∀ C : Finset K, ∃ s : S, σ s ≠ 0 ∧ ∀ c ∈ C, ∃ a : S, c * σ s = σ a := by
      intro S _ σ hσ C
      induction C using Finset.induction_on with
      | empty => exact ⟨1, by simp, fun c hc => absurd hc (Finset.notMem_empty c)⟩
      | insert c C hcC ih =>
        obtain ⟨s₀, hs₀, hC⟩ := ih
        obtain ⟨a, b, hb, hab⟩ := hσ c
        refine ⟨s₀ * b, by rw [map_mul]; exact mul_ne_zero hs₀ hb, ?_⟩
        intro c' hc'
        rcases Finset.mem_insert.mp hc' with h | h
        · subst h
          exact ⟨a * s₀, by rw [map_mul, map_mul, ← hab]; ring⟩
        · obtain ⟨a', ha'⟩ := hC c' h
          exact ⟨a' * b, by rw [map_mul, map_mul, ← ha']; ring⟩
    have hliftC : ∀ (S : Type u) [CommRing S] (σ : S →+* K) (P : Polynomial K),
        (∀ c ∈ P.coeffs, ∃ a : S, σ a = c) → P ∈ Polynomial.lifts σ := by
      intro S _ σ P hP
      rw [Polynomial.lifts_iff_coeff_lifts]
      intro n
      by_cases h : P.coeff n = 0
      · exact ⟨0, by rw [h, map_zero]⟩
      · exact hP _ (Polynomial.coeff_mem_coeffs h)

    haveI : Algebra.IsSeparable K L := IsGalois.to_isSeparable
    haveI : Fintype (L ≃ₐ[K] L) := Fintype.ofFinite _
    let pb := Field.powerBasisOfFiniteOfSeparable K L
    set θ := pb.gen with hθ
    set p := minpoly K θ with hp
    have hpmonic : p.Monic := minpoly.monic (IsIntegral.of_finite K θ)
    have hpdeg : p.natDegree = Nat.card (L ≃ₐ[K] L) := by
      rw [hp, hθ, pb.natDegree_minpoly, ← pb.finrank, IsGalois.card_aut_eq_finrank]
    have hsep : IsCoprime p (Polynomial.derivative p) := Algebra.IsSeparable.isSeparable K θ
    obtain ⟨u, v, huv⟩ := hsep
    have hh : ∀ γ : L ≃ₐ[K] L, ∃ h : Polynomial K, γ θ = Polynomial.aeval θ h :=
      fun γ => pb.exists_eq_aeval' (γ θ)
    choose h hh using hh
    set C : Finset K := p.coeffs ∪ u.coeffs ∪ v.coeffs ∪ Finset.univ.biUnion (fun γ => (h γ).coeffs) with hC
    obtain ⟨s, hs, hsC⟩ := cd A ρ hfrac C
    refine ⟨s, hs, ?_⟩
    intro R _ _ _ ρR hcomp
    have hjs : IsUnit (algebraMap A R s) := IsLocalization.Away.algebraMap_isUnit s
    have hρRj : ∀ a, ρR (algebraMap A R a) = ρ a := fun a => by rw [← RingHom.comp_apply, hcomp]
    set t : R := ↑(hjs.unit⁻¹) with ht
    have hts : ρR t * ρ s = 1 := by
      rw [← hρRj, ← map_mul, ht, IsUnit.val_inv_mul, map_one]
    have hCR : ∀ c ∈ C, ∃ a : R, ρR a = c := by
      intro c hc
      obtain ⟨a, ha⟩ := hsC c hc
      refine ⟨algebraMap A R a * t, ?_⟩
      rw [map_mul, hρRj, ← ha]
      calc c * ρ s * ρR t = c * (ρR t * ρ s) := by ring
        _ = c := by rw [hts, mul_one]
    haveI : Nontrivial R := ρR.domain_nontrivial

    have hnilR : ∀ r : R, ρR r = 0 → IsNilpotent r := by
      intro r hr
      obtain ⟨n, a, hna⟩ := IsLocalization.Away.surj s r
      have ha : ρ a = 0 := by rw [← hρRj, ← hna, map_mul, hr, zero_mul]
      have h1 : IsNilpotent (r * algebraMap A R s ^ n) := by rw [hna]; exact (hnil a ha).map _
      have h2 : r = (r * algebraMap A R s ^ n) * ↑((hjs.pow n).unit⁻¹) := by
        rw [mul_assoc, IsUnit.mul_val_inv, mul_one]
      rw [h2]
      exact (Commute.all _ _).isNilpotent_mul_right h1

    have hfracR : ∀ k : K, ∃ a b : R, ρR b ≠ 0 ∧ k * ρR b = ρR a := by
      intro k
      obtain ⟨a, b, hb, hab⟩ := hfrac k
      exact ⟨algebraMap A R a, algebraMap A R b, by rw [hρRj]; exact hb, by rw [hρRj, hρRj]; exact hab⟩

    have hpL : p ∈ Polynomial.lifts ρR := hliftC R ρR p (fun c hc => hCR c (by
      rw [hC]; exact Finset.mem_union_left _ (Finset.mem_union_left _ (Finset.mem_union_left _ hc))))
    have huL : u ∈ Polynomial.lifts ρR := hliftC R ρR u (fun c hc => hCR c (by
      rw [hC]; exact Finset.mem_union_left _ (Finset.mem_union_left _ (Finset.mem_union_right _ hc))))
    have hvL : v ∈ Polynomial.lifts ρR := hliftC R ρR v (fun c hc => hCR c (by
      rw [hC]; exact Finset.mem_union_left _ (Finset.mem_union_right _ hc)))
    have hhL : ∀ γ, h γ ∈ Polynomial.lifts ρR := fun γ => hliftC R ρR (h γ) (fun c hc => hCR c (by
      rw [hC]; exact Finset.mem_union_right _ (Finset.mem_biUnion.mpr ⟨γ, Finset.mem_univ _, hc⟩)))
    obtain ⟨f, hfmap, hfdeg, hfmonic⟩ := Polynomial.lifts_and_natDegree_eq_and_monic hpL hpmonic
    obtain ⟨U₀, hU₀⟩ := (Polynomial.mem_lifts u).mp huL
    obtain ⟨V₀, hV₀⟩ := (Polynomial.mem_lifts v).mp hvL
    have hH : ∀ γ, ∃ H : Polynomial R, Polynomial.map ρR H = h γ := fun γ => (Polynomial.mem_lifts _).mp (hhL γ)
    choose H hHmap using hH

    set M := f * U₀ + Polynomial.derivative f * V₀ with hM
    have hMmap : Polynomial.map ρR (M - 1) = 0 := by
      rw [Polynomial.map_sub, Polynomial.map_one, hM, Polynomial.map_add, Polynomial.map_mul,
        Polynomial.map_mul, ← Polynomial.derivative_map, hfmap, hU₀, hV₀, ← huv]
      ring
    have hMnil : IsNilpotent (M - 1) := by
      rw [Polynomial.isNilpotent_iff]
      intro i
      apply hnilR
      rw [← Polynomial.coeff_map, hMmap, Polynomial.coeff_zero]
    have hMunit : IsUnit M := by
      have := hMnil.isUnit_one_add
      rwa [add_sub_cancel] at this
    refine ⟨f, U₀ * ↑(hMunit.unit⁻¹), V₀ * ↑(hMunit.unit⁻¹), ?_⟩

    have hfθ : Polynomial.eval₂ ((algebraMap K L).comp ρR) θ f = 0 := by
      rw [← Polynomial.eval₂_map, hfmap, ← Polynomial.aeval_def, hp, minpoly.aeval]
    let π : AdjoinRoot f →+* L := AdjoinRoot.lift ((algebraMap K L).comp ρR) θ hfθ
    have hπmk : ∀ F : Polynomial R, π (AdjoinRoot.mk f F) = Polynomial.aeval θ (Polynomial.map ρR F) := by
      intro F
      rw [AdjoinRoot.lift_mk, Polynomial.aeval_def, Polynomial.eval₂_map]
    have hπroot : π (AdjoinRoot.root f) = θ := AdjoinRoot.lift_root hfθ
    refine ⟨π, hfmonic, by rw [hfdeg, hpdeg], ?_, ?_, ?_, ?_, ?_, ?_⟩
    · calc f * (U₀ * ↑(hMunit.unit⁻¹)) + Polynomial.derivative f * (V₀ * ↑(hMunit.unit⁻¹))
          = (f * U₀ + Polynomial.derivative f * V₀) * ↑(hMunit.unit⁻¹) := by ring
        _ = 1 := IsUnit.mul_val_inv hMunit
    · ext r
      exact AdjoinRoot.lift_of hfθ
    · intro b hb
      obtain ⟨F, rfl⟩ := AdjoinRoot.mk_surjective b
      have hF : AdjoinRoot.mk f F = AdjoinRoot.mk f (F %ₘ f) := by
        conv_lhs => rw [← Polynomial.modByMonic_add_div F f]
        rw [map_add, map_mul, AdjoinRoot.mk_self, zero_mul, add_zero]
      rw [hF] at hb ⊢
      rw [hπmk] at hb
      have hmap0 : Polynomial.map ρR (F %ₘ f) = 0 := by
        by_contra hne
        have h1 := minpoly.degree_le_of_ne_zero K θ hne hb
        have h2 : (Polynomial.map ρR (F %ₘ f)).degree < p.degree := by
          calc (Polynomial.map ρR (F %ₘ f)).degree ≤ (F %ₘ f).degree := Polynomial.degree_map_le
            _ < f.degree := Polynomial.degree_modByMonic_lt F hfmonic
            _ = p.degree := by rw [← hfmap, hfmonic.degree_map]
        exact absurd (lt_of_le_of_lt h1 h2) (lt_irrefl _)
      have hFnil : IsNilpotent (F %ₘ f) := by
        rw [Polynomial.isNilpotent_iff]
        intro i
        apply hnilR
        rw [← Polynomial.coeff_map, hmap0, Polynomial.coeff_zero]
      exact hFnil.map _
    · intro l
      obtain ⟨q, hq⟩ := pb.exists_eq_aeval' l
      obtain ⟨t', ht', htq⟩ := cd R ρR hfracR q.coeffs
      have hQL : Polynomial.C (ρR t') * q ∈ Polynomial.lifts ρR := by
        rw [Polynomial.lifts_iff_coeff_lifts]
        intro n
        rw [Polynomial.coeff_C_mul]
        by_cases hn : q.coeff n = 0
        · exact ⟨0, by rw [hn, mul_zero, map_zero]⟩
        · obtain ⟨a, ha⟩ := htq _ (Polynomial.coeff_mem_coeffs hn)
          exact ⟨a, by rw [← ha, mul_comm]⟩
      obtain ⟨Q, hQ⟩ := (Polynomial.mem_lifts _).mp hQL
      refine ⟨AdjoinRoot.mk f Q, AdjoinRoot.of f t', ?_, ?_⟩
      · rw [show π (AdjoinRoot.of f t') = algebraMap K L (ρR t') from AdjoinRoot.lift_of hfθ]
        exact (map_ne_zero _).mpr ht'
      · rw [show π (AdjoinRoot.of f t') = algebraMap K L (ρR t') from AdjoinRoot.lift_of hfθ, hπmk, hQ,
          map_mul, Polynomial.aeval_C, ← hq, mul_comm]
    · intro γ
      refine ⟨AdjoinRoot.mk f (H γ), ?_⟩
      rw [hπmk, hHmap, hπroot, hh]
    · intro γ δ hγδ
      rw [hπroot] at hγδ
      have : (γ : L →ₐ[K] L) = (δ : L →ₐ[K] L) := pb.algHom_ext hγδ
      exact AlgEquiv.ext fun x => congrArg (fun φ : L →ₐ[K] L => φ x) this

  have s3 : ∀ (R : Type u) [CommRing R] (f U V : Polynomial R), f.Monic → f * U + Polynomial.derivative f * V = 1 → Algebra.Etale R (AdjoinRoot f) := by
    intro R _ f U V hf hbez
    let P : StandardEtalePair R := ⟨f, hf, 1, ⟨V, U, 1, by rw [pow_one, ← hbez]; ring⟩⟩
    have e1 : P.Ring ≃ₐ[R] Localization.Away (AdjoinRoot.mk P.f P.g) := P.equivAwayAdjoinRoot
    have hu : IsUnit (AdjoinRoot.mk P.f P.g) := by
      show IsUnit (AdjoinRoot.mk f 1)
      rw [map_one]; exact isUnit_one
    let e2 : AdjoinRoot f ≃ₐ[R] Localization.Away (AdjoinRoot.mk P.f P.g) :=
      (IsLocalization.atUnit (AdjoinRoot f) (Localization.Away (AdjoinRoot.mk P.f P.g))
        (AdjoinRoot.mk P.f P.g) hu).restrictScalars R
    exact Algebra.Etale.of_equiv (e1.trans e2.symm)

  have s4 : ∀ (R K L : Type u) [CommRing R] [Field K] [Field L] [Algebra K L] (ρR : R →+* K) (f U V : Polynomial R) (π : AdjoinRoot f →+* L), f * U + Polynomial.derivative f * V = 1 → π.comp (AdjoinRoot.of f) = (algebraMap K L).comp ρR → (∀ b, π b = 0 → IsNilpotent b) → (∀ γ : L ≃ₐ[K] L, ∃ y : AdjoinRoot f, π y = γ (π (AdjoinRoot.root f))) → ∃ τ : (L ≃ₐ[K] L) → (AdjoinRoot f →ₐ[R] AdjoinRoot f), τ 1 = AlgHom.id R (AdjoinRoot f) ∧ (∀ γ δ, τ (γ * δ) = (τ δ).comp (τ γ)) ∧ (∀ γ, π (τ γ (AdjoinRoot.root f)) = γ⁻¹ (π (AdjoinRoot.root f))) := by
    intro R K L _ _ _ _ ρR f U V π hbez hπof hπnil hgal
    set ψ := (algebraMap K L).comp ρR with hψ
    set θ' := π (AdjoinRoot.root f) with hθ'
    have hnil0 : ∀ z, IsNilpotent z → π z = 0 := fun z hz => (hz.map π).eq_zero
    have key : ∀ z : AdjoinRoot f, π (Polynomial.aeval z f) = Polynomial.eval₂ ψ (π z) f := by
      intro z
      rw [Polynomial.aeval_def, Polynomial.hom_eval₂, AdjoinRoot.algebraMap_eq, hπof]
    have hgψ : ∀ (g : L ≃ₐ[K] L) (x : L), Polynomial.eval₂ ψ (g x) f = g (Polynomial.eval₂ ψ x f) := by
      intro g x
      have h := Polynomial.hom_eval₂ f ψ (g : L →+* L) x
      have hc : (g : L →+* L).comp ψ = ψ := by
        ext r; simp [hψ]
      rw [hc] at h
      exact h.symm
    have hr0 : Polynomial.aeval (AdjoinRoot.root f) f = 0 := by
      rw [AdjoinRoot.aeval_eq, AdjoinRoot.mk_self]
    have hθ0 : Polynomial.eval₂ ψ θ' f = 0 := by rw [hθ', ← key, hr0, map_zero]
    choose y hy using hgal
    have hfy : ∀ g, IsNilpotent (Polynomial.aeval (y g) f) := by
      intro g
      apply hπnil
      rw [key, hy, hgψ, hθ0, map_zero]
    have hdy : ∀ g, IsUnit (Polynomial.aeval (y g) (Polynomial.derivative f)) := by
      intro g
      have h := congrArg (Polynomial.aeval (y g)) hbez
      rw [map_add, map_mul, map_mul, map_one] at h
      have h2 : Polynomial.aeval (y g) (Polynomial.derivative f) * Polynomial.aeval (y g) V =
          1 - Polynomial.aeval (y g) f * Polynomial.aeval (y g) U := by rw [← h]; ring
      have hu : IsUnit (1 - Polynomial.aeval (y g) f * Polynomial.aeval (y g) U) :=
        ((Commute.all _ _).isNilpotent_mul_right (hfy g)).isUnit_one_sub
      rw [← h2] at hu
      exact isUnit_of_mul_isUnit_left hu
    have hH : ∀ g, ∃ r : AdjoinRoot f, (IsNilpotent (y g - r) ∧ Polynomial.aeval r f = 0) ∧
        ∀ r', IsNilpotent (y g - r') ∧ Polynomial.aeval r' f = 0 → r' = r := fun g =>
      Polynomial.existsUnique_nilpotent_sub_and_aeval_eq_zero (hfy g) (hdy g)
    choose r hr huniq using hH
    have hπr : ∀ g, π (r g) = g θ' := by
      intro g
      have h := hnil0 _ (hr g).1
      rw [map_sub, sub_eq_zero] at h
      rw [← h, hy]
    have hroot : ∀ g, Polynomial.eval₂ (↑(Algebra.ofId R (AdjoinRoot f))) (r g) f = 0 := by
      intro g
      exact (hr g).2
    let τ : (L ≃ₐ[K] L) → (AdjoinRoot f →ₐ[R] AdjoinRoot f) := fun γ =>
      AdjoinRoot.liftAlgHom f (Algebra.ofId R (AdjoinRoot f)) (r γ⁻¹) (hroot γ⁻¹)
    have hτroot : ∀ γ, τ γ (AdjoinRoot.root f) = r γ⁻¹ := fun γ => AdjoinRoot.liftAlgHom_root _ _ _ _
    have hπτ : ∀ γ z, π (τ γ z) = γ⁻¹ (π z) := by
      intro γ z
      have h : π.comp (τ γ : AdjoinRoot f →+* AdjoinRoot f) = (γ⁻¹ : L ≃ₐ[K] L).toRingHom.comp π := by
        apply AdjoinRoot.ringHom_ext
        · ext a
          simp only [RingHom.comp_apply, RingHom.coe_coe]
          have h1 : τ γ (AdjoinRoot.of f a) = AdjoinRoot.of f a := by
            rw [← AdjoinRoot.algebraMap_eq]; exact (τ γ).commutes a
          rw [h1]
          have h2 : π (AdjoinRoot.of f a) = ψ a := by rw [← RingHom.comp_apply, hπof]
          rw [h2]
          simp [hψ]
        · simp only [RingHom.comp_apply, RingHom.coe_coe]
          rw [hτroot, hπr]
          rfl
      exact congrArg (fun φ : AdjoinRoot f →+* L => φ z) h
    refine ⟨τ, ?_, ?_, ?_⟩
    · apply AdjoinRoot.algHom_ext
      rw [hτroot]
      symm
      apply huniq
      refine ⟨hπnil _ ?_, hr0⟩
      rw [map_sub, hy, inv_one, AlgEquiv.one_apply, AlgHom.id_apply, ← hθ', sub_self]
    · intro γ δ
      apply AdjoinRoot.algHom_ext
      rw [hτroot, AlgHom.comp_apply, hτroot]
      symm
      apply huniq
      refine ⟨hπnil _ ?_, ?_⟩
      · rw [map_sub, hy, hπτ, hπr, ← AlgEquiv.mul_apply, mul_inv_rev, sub_self]
      · rw [Polynomial.aeval_algHom_apply, (hr _).2, map_zero]
    · intro γ
      rw [hτroot, hπr]

  have s5 : ∀ (B L : Type u) [CommRing B] [Field L] (π : B →+* L) (P : Polynomial B) (a b : B), (∀ z, π z = 0 → IsNilpotent z) → P.eval a = 0 → P.eval b = 0 → IsUnit ((Polynomial.derivative P).eval b) → π a ≠ π b → IsUnit (a - b) := by
    intro B L _ _ π P a b hnil ha hb hd hne
    set Q := P /ₘ (Polynomial.X - Polynomial.C b) with hQ
    have hPQ : (Polynomial.X - Polynomial.C b) * Q = P := Polynomial.mul_divByMonic_eq_iff_isRoot.mpr hb
    have hw : (Polynomial.derivative P).eval b = Q.eval b := by
      rw [← hPQ, Polynomial.derivative_mul]; simp
    obtain ⟨c, hc⟩ := Polynomial.sub_dvd_eval_sub a b Q
    have h0 : (a - b) * Q.eval a = 0 := by
      have := congrArg (Polynomial.eval a) hPQ
      rw [Polynomial.eval_mul] at this
      simpa [ha] using this
    obtain ⟨w', hw'⟩ : ∃ w', Q.eval b * w' = 1 := by
      rw [← hw]; exact hd.exists_right_inv
    have h1 : Q.eval a = Q.eval b + (a - b) * c := by rw [← hc]; ring
    rw [h1] at h0
    have hed : a - b = (a - b) * (a - b) * (-(c * w')) := by
      linear_combination w' * h0 - (a - b) * hw'
    have hidem : IsIdempotentElem (1 - (a - b) * (-(c * w'))) := by
      have : IsIdempotentElem ((a - b) * (-(c * w'))) := by
        unfold IsIdempotentElem
        calc (a - b) * (-(c * w')) * ((a - b) * (-(c * w')))
            = ((a - b) * (a - b) * (-(c * w'))) * (-(c * w')) := by ring
          _ = (a - b) * (-(c * w')) := by rw [← hed]
      exact this.one_sub
    have hπe : π (a - b) ≠ 0 := by rw [map_sub]; exact sub_ne_zero.mpr hne
    have h2 : π (a - b) = π (a - b) * π (a - b) * π (-(c * w')) := by
      rw [← map_mul, ← map_mul, ← hed]
    have h3 : π (a - b) * π (-(c * w')) = 1 := by
      have h4 : π (a - b) * (π (a - b) * π (-(c * w')) - 1) = 0 := by linear_combination -h2
      rcases mul_eq_zero.mp h4 with h | h
      · exact absurd h hπe
      · linear_combination h
    have hπ1 : π (1 - (a - b) * (-(c * w'))) = 0 := by
      rw [map_sub, map_one, map_mul, h3, sub_self]
    have hz := hidem.eq_zero_of_isNilpotent (hnil _ hπ1)
    exact IsUnit.of_mul_eq_one (-(c * w')) (by linear_combination -hz)

  have s6 : ∀ (R B : Type u) [CommRing R] [CommRing B] [Algebra R B] (pb : PowerBasis R B) (Γ : Type u) [Fintype Γ] (τ : Γ → (B →ₐ[R] B)), Fintype.card Γ = pb.dim → (∀ γ δ, γ ≠ δ → IsUnit (τ γ pb.gen - τ δ pb.gen)) → Function.Bijective (Algebra.TensorProduct.productMap (AlgHom.pi τ) (AlgHom.pi fun _ : Γ => AlgHom.id R B)) := by
    intro R B _ _ _ pb Γ _ τ hcard hunit
    classical
    set Φ' := Algebra.TensorProduct.productMap (AlgHom.pi fun _ : Γ => AlgHom.id R B) (AlgHom.pi τ) with hΦ'
    have hΦ'tmul : ∀ c b : B, Φ' (c ⊗ₜ[R] b) = fun γ => c * τ γ b := by
      intro c b
      rw [hΦ', Algebra.TensorProduct.productMap_apply_tmul]
      rfl
    have hcomp : ⇑(Algebra.TensorProduct.productMap (AlgHom.pi τ) (AlgHom.pi fun _ : Γ => AlgHom.id R B)) =
        Φ' ∘ (Algebra.TensorProduct.comm R B B) := by
      funext x
      induction x using TensorProduct.induction_on with
      | zero => simp
      | tmul b c =>
        simp only [Function.comp_apply, Algebra.TensorProduct.comm_tmul, hΦ'tmul,
          Algebra.TensorProduct.productMap_apply_tmul]
        funext γ
        simp [mul_comm]
      | add x y hx hy => simp only [map_add, hx, hy, Function.comp_apply]
    let F : TensorProduct R B B →ₗ[B] (Γ → B) :=
      { toFun := Φ'
        map_add' := fun x y => map_add Φ' x y
        map_smul' := by
          intro c x
          rw [Algebra.smul_def, map_mul, Algebra.TensorProduct.algebraMap_apply, Algebra.algebraMap_self,
            RingHom.id_apply, hΦ'tmul]
          funext γ
          simp }
    have hF : ∀ x, F x = Φ' x := fun x => rfl
    let e : Fin pb.dim ≃ Γ := (Fintype.equivFinOfCardEq hcard).symm
    let v₁ := Algebra.TensorProduct.basis B pb.basis
    let v₂ := (Pi.basisFun B Γ).reindex e.symm
    have hmat : LinearMap.toMatrix v₁ v₂ F = Matrix.vandermonde (fun j => τ (e j) pb.gen) := by
      ext j i
      rw [LinearMap.toMatrix_apply, Matrix.vandermonde_apply]
      simp only [v₁, v₂, Algebra.TensorProduct.basis_apply, Module.Basis.repr_reindex_apply, Pi.basisFun_repr,
        PowerBasis.coe_basis, Equiv.symm_symm, hF, hΦ'tmul, one_mul, map_pow]
    have hdet : IsUnit (LinearMap.toMatrix v₁ v₂ F).det := by
      rw [hmat, Matrix.det_vandermonde]
      refine IsUnit.prod_iff.mpr (fun i _ => IsUnit.prod_iff.mpr (fun j hj => ?_))
      apply hunit
      intro h
      have := e.injective h
      simp only [Finset.mem_Ioi] at hj
      exact absurd this (ne_of_gt hj)
    have hFbij : Function.Bijective F := (LinearEquiv.ofIsUnitDet hdet).bijective
    rw [hcomp]
    exact hFbij.comp (Algebra.TensorProduct.comm R B B).bijective

  have hsig : ∀ (R S T : Type u) [CommRing R] [CommRing S]
      [CommRing T] [Algebra R S] [Algebra R T] (I : Type u) [Finite I] (μ : I → (S →ₐ[R] T))
      (P Q E : Scheme.{u}) (eP : P ≅ Spec (.of R)) (eQ : Q ≅ Spec (.of S)) (eE : E ≅ Spec (.of T))
      (f : Q ⟶ P) (e : E ⟶ P) (s : I → (E ⟶ Q)),
      f ≫ eP.hom = eQ.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap R S)) →
      e ≫ eP.hom = eE.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap R T)) →
      (∀ i, s i ≫ eQ.hom = eE.hom ≫ Spec.map (CommRingCat.ofHom (μ i : S →+* T))) →
      (IsPullback (Limits.Sigma.desc s) (Limits.Sigma.desc fun _ : I => 𝟙 E) f e ↔
        Function.Bijective (Algebra.TensorProduct.productMap (AlgHom.pi μ)
          (AlgHom.pi fun _ : I => AlgHom.id R T))) := by
    intro R S T _ _ _ _ _ I _ μ P Q E eP eQ eE f e s hf he hs
    classical
    obtain ⟨φ, hφ⟩ : ∃ φ : TensorProduct R S T →ₐ[R] (I → T), φ =
        Algebra.TensorProduct.productMap (AlgHom.pi μ) (AlgHom.pi fun _ : I => AlgHom.id R T) :=
      ⟨_, rfl⟩
    rw [← hφ]

    have hStd := isPullback_SpecMap_of_isPushout _ _ _ _ (CommRingCat.isPushout_tensorProduct R S T)
    have hP' : IsPullback
        (Spec.map (CommRingCat.ofHom
          (Algebra.TensorProduct.includeLeftRingHom : S →+* TensorProduct R S T)) ≫ eQ.inv)
        (Spec.map (CommRingCat.ofHom
          (Algebra.TensorProduct.includeRight : T →ₐ[R] TensorProduct R S T).toRingHom) ≫ eE.inv)
        f e := by
      refine IsPullback.of_iso hStd (Iso.refl _) eQ.symm eE.symm eP.symm ?_ ?_ ?_ ?_
      · rw [Iso.refl_hom, Category.id_comp, Iso.symm_hom]
      · rw [Iso.refl_hom, Category.id_comp, Iso.symm_hom]
      · rw [Iso.symm_hom, Iso.symm_hom, Iso.eq_inv_comp, ← Category.assoc, ← hf, Category.assoc,
          Iso.hom_inv_id, Category.comp_id]
      · rw [Iso.symm_hom, Iso.symm_hom, Iso.eq_inv_comp, ← Category.assoc, ← he, Category.assoc,
          Iso.hom_inv_id, Category.comp_id]

    obtain ⟨c, hc⟩ : ∃ c : (∐ fun _ : I => E) ⟶ Spec (CommRingCat.of (TensorProduct R S T)),
        c = Limits.Sigma.desc fun i => eE.hom ≫ Spec.map (CommRingCat.ofHom
          ((Pi.evalRingHom (fun _ : I => T) i).comp (φ : TensorProduct R S T →+* (I → T)))) :=
      ⟨_, rfl⟩
    have h1 : ∀ i, CommRingCat.ofHom
        (Algebra.TensorProduct.includeLeftRingHom : S →+* TensorProduct R S T) ≫
        CommRingCat.ofHom ((Pi.evalRingHom (fun _ : I => T) i).comp
          (φ : TensorProduct R S T →+* (I → T))) = CommRingCat.ofHom (μ i : S →+* T) := by
      intro i
      ext x
      simp [hφ, Algebra.TensorProduct.productMap_apply_tmul]
    have h2 : ∀ i, CommRingCat.ofHom
        (Algebra.TensorProduct.includeRight : T →ₐ[R] TensorProduct R S T).toRingHom ≫
        CommRingCat.ofHom ((Pi.evalRingHom (fun _ : I => T) i).comp
          (φ : TensorProduct R S T →+* (I → T))) = 𝟙 _ := by
      intro i
      ext x
      simp [hφ, Algebra.TensorProduct.productMap_apply_tmul]
    have hc1 : c ≫ (Spec.map (CommRingCat.ofHom
          (Algebra.TensorProduct.includeLeftRingHom : S →+* TensorProduct R S T)) ≫ eQ.inv) =
        Limits.Sigma.desc s := by
      refine Limits.Sigma.hom_ext _ _ (fun i => ?_)
      rw [hc, Limits.Sigma.ι_comp_desc_assoc, Limits.Sigma.ι_comp_desc, Category.assoc,
        ← Category.assoc (Spec.map _), ← Spec.map_comp, h1 i, ← Category.assoc, ← hs i,
        Category.assoc, Iso.hom_inv_id, Category.comp_id]
    have hc2 : c ≫ (Spec.map (CommRingCat.ofHom
          (Algebra.TensorProduct.includeRight : T →ₐ[R] TensorProduct R S T).toRingHom) ≫ eE.inv) =
        Limits.Sigma.desc fun _ : I => 𝟙 E := by
      refine Limits.Sigma.hom_ext _ _ (fun i => ?_)
      rw [hc, Limits.Sigma.ι_comp_desc_assoc, Limits.Sigma.ι_comp_desc, Category.assoc,
        ← Category.assoc (Spec.map _), ← Spec.map_comp, h2 i, Spec.map_id, Category.id_comp,
        Iso.hom_inv_id]

    have key : IsPullback (Limits.Sigma.desc s) (Limits.Sigma.desc fun _ : I => 𝟙 E) f e ↔
        IsIso c := by
      constructor
      · intro hP
        have hci : c = (IsPullback.isoIsPullback Q E hP hP').hom :=
          hP'.hom_ext (by rw [hc1, IsPullback.isoIsPullback_hom_fst])
            (by rw [hc2, IsPullback.isoIsPullback_hom_snd])
        rw [hci]
        infer_instance
      · intro hiso
        refine IsPullback.of_iso hP' (asIso c).symm (Iso.refl _) (Iso.refl _) (Iso.refl _)
          ?_ ?_ ?_ ?_
        · rw [Iso.refl_hom, Category.comp_id, Iso.symm_hom, asIso_inv, ← hc1,
            IsIso.inv_hom_id_assoc]
        · rw [Iso.refl_hom, Category.comp_id, Iso.symm_hom, asIso_inv, ← hc2,
            IsIso.inv_hom_id_assoc]
        · rw [Iso.refl_hom, Iso.refl_hom, Category.comp_id, Category.id_comp]
        · rw [Iso.refl_hom, Iso.refl_hom, Category.comp_id, Category.id_comp]

    have ε : ULift.{u} (Fin (Nat.card I)) ≃ I := Equiv.ulift.trans (Finite.equivFin I).symm
    obtain ⟨ψ', hψ'⟩ : ∃ ψ' : TensorProduct R S T →+* (ULift.{u} (Fin (Nat.card I)) → T),
        ψ' = RingHom.pi fun j => (Pi.evalRingHom (fun _ : I => T) (ε j)).comp
          (φ : TensorProduct R S T →+* (I → T)) := ⟨_, rfl⟩
    obtain ⟨M, hM⟩ : ∃ M : (∐ fun _ : I => E) ⟶
        ∐ fun _ : ULift.{u} (Fin (Nat.card I)) => Spec (CommRingCat.of T),
        M = Limits.Sigma.desc fun i => eE.hom ≫
          Limits.Sigma.ι (fun _ : ULift.{u} (Fin (Nat.card I)) => Spec (CommRingCat.of T))
            (ε.symm i) := ⟨_, rfl⟩
    obtain ⟨N, hN⟩ : ∃ N : (∐ fun _ : ULift.{u} (Fin (Nat.card I)) => Spec (CommRingCat.of T)) ⟶
        (∐ fun _ : I => E),
        N = Limits.Sigma.desc fun j => eE.inv ≫ Limits.Sigma.ι (fun _ : I => E) (ε j) :=
      ⟨_, rfl⟩
    have hMiso : IsIso M := by
      refine ⟨⟨N, ?_, ?_⟩⟩
      · refine Limits.Sigma.hom_ext _ _ (fun i => ?_)
        rw [hM, hN, Limits.Sigma.ι_comp_desc_assoc, Category.assoc, Limits.Sigma.ι_comp_desc,
          Iso.hom_inv_id_assoc, Equiv.apply_symm_apply, Category.comp_id]
      · refine Limits.Sigma.hom_ext _ _ (fun j => ?_)
        rw [hM, hN, Limits.Sigma.ι_comp_desc_assoc, Category.assoc, Limits.Sigma.ι_comp_desc,
          Iso.inv_hom_id_assoc, Equiv.symm_apply_apply, Category.comp_id]
    have hσ : IsIso (sigmaSpec (fun _ : ULift.{u} (Fin (Nat.card I)) => CommRingCat.of T)) :=
      inferInstance
    have hcf : c = M ≫ sigmaSpec (fun _ : ULift.{u} (Fin (Nat.card I)) => CommRingCat.of T) ≫
        Spec.map (CommRingCat.ofHom ψ') := by
      refine Limits.Sigma.hom_ext _ _ (fun i => ?_)
      rw [hc, hM, Limits.Sigma.ι_comp_desc, Limits.Sigma.ι_comp_desc_assoc, Category.assoc,
        ι_sigmaSpec_assoc, ← Spec.map_comp]
      congr 2
      refine CommRingCat.hom_ext (RingHom.ext fun x => ?_)
      simp [hψ']
    rw [key, hcf, isIso_comp_left_iff, isIso_comp_left_iff, isIso_SpecMap_iff,
      CommRingCat.hom_ofHom]
    have hfun : ⇑ψ' = (Equiv.arrowCongr ε.symm (Equiv.refl T)) ∘
        ⇑(φ : TensorProduct R S T →+* (I → T)) := by
      funext x j
      simp [hψ', Equiv.arrowCongr_apply]
    rw [hfun, Equiv.comp_bijective]
    rfl

  have s7 : ∀ (U : Scheme.{u}) (R B : Type u) [CommRing R] [CommRing B] [Algebra R B] (e : U ≅ Spec (.of R)) (Γ : Type u) [Group Γ] [Finite Γ] (τ : Γ → (B →ₐ[R] B)), Algebra.Etale R B → Module.Finite R B → Module.Free R B → Nontrivial B → τ 1 = AlgHom.id R B → (∀ γ δ, τ (γ * δ) = (τ δ).comp (τ γ)) → Function.Bijective (Algebra.TensorProduct.productMap (AlgHom.pi τ) (AlgHom.pi fun _ : Γ => AlgHom.id R B)) → ∃ α : Γ →* Aut (Spec (.of B)), wcGalCover (Spec.map (CommRingCat.ofHom (algebraMap R B)) ≫ e.inv) Γ α := by
    intro U R B _ _ _ e Γ _ _ τ hEt hfin hfree hnt hτ1 hτmul hbij
    set q := Spec.map (CommRingCat.ofHom (algebraMap R B)) ≫ e.inv with hq
    let T : Γ → (Spec (.of B) ⟶ Spec (.of B)) := fun γ => Spec.map (CommRingCat.ofHom (τ γ : B →+* B))
    have hS : ∀ f g : B →ₐ[R] B, Spec.map (CommRingCat.ofHom ((f.comp g : B →ₐ[R] B) : B →+* B)) =
        Spec.map (CommRingCat.ofHom (f : B →+* B)) ≫ Spec.map (CommRingCat.ofHom (g : B →+* B)) := by
      intro f g
      rw [← Spec.map_comp]
      rfl
    have hid : Spec.map (CommRingCat.ofHom ((AlgHom.id R B : B →ₐ[R] B) : B →+* B)) = 𝟙 _ := by
      rw [← Spec.map_id]
      rfl
    have hT1 : T 1 = 𝟙 _ := by simp only [T, hτ1]; exact hid
    have hTmul : ∀ γ δ, T (γ * δ) = T δ ≫ T γ := by
      intro γ δ
      simp only [T, hτmul]
      exact hS _ _
    let A : Γ → Aut (Spec (.of B)) := fun γ =>
      { hom := T γ
        inv := T γ⁻¹
        hom_inv_id := by rw [← hTmul, inv_mul_cancel, hT1]
        inv_hom_id := by rw [← hTmul, mul_inv_cancel, hT1] }
    let α : Γ →* Aut (Spec (.of B)) :=
      { toFun := A
        map_one' := by
          apply Iso.ext
          exact hT1
        map_mul' := by
          intro γ δ
          apply Iso.ext
          exact hTmul γ δ }
    have hαT : ∀ γ, (α γ).hom = T γ := fun γ => rfl
    refine ⟨α, inferInstance, ?_, ?_, ?_, ?_⟩
    · haveI : IsFinite (Spec.map (CommRingCat.ofHom (algebraMap R B))) := by
        rw [IsFinite.SpecMap_iff]
        exact RingHom.finite_algebraMap.mpr hfin
      infer_instance
    · haveI : Etale (Spec.map (CommRingCat.ofHom (algebraMap R B))) := by
        rw [HasRingHomProperty.Spec_iff (P := @Etale)]
        exact RingHom.etale_algebraMap.mpr hEt
      infer_instance
    · haveI : AlgebraicGeometry.Surjective (Spec.map (CommRingCat.ofHom (algebraMap R B))) := by
        haveI : Module.FaithfullyFlat R B := inferInstance
        constructor
        exact PrimeSpectrum.comap_surjective_of_faithfullyFlat
      infer_instance
    · have hα : ∀ γ, (α γ).hom ≫ q = q := by
        intro γ
        rw [hαT, hq, ← Category.assoc]
        congr 1
        simp only [T]
        rw [← Spec.map_comp]
        congr 1
        ext x
        exact (τ γ).commutes x
      refine ⟨hα, ?_⟩
      have hpb : IsPullback (Limits.Sigma.desc T) (Limits.Sigma.desc fun _ : Γ => 𝟙 (Spec (.of B))) q q := by
        refine (hsig R B B Γ τ U (Spec (.of B)) (Spec (.of B)) e
          (Iso.refl _) (Iso.refl _) q q T ?_ ?_ ?_).mpr hbij
        · simp [hq]
        · simp [hq]
        · intro γ; simp [T]
      have hD : Limits.Sigma.desc (fun γ : Γ => Limits.pullback.lift (α γ).hom (𝟙 (Spec (.of B)))
          ((hα γ).trans (Category.id_comp q).symm)) = hpb.isoPullback.hom := by
        apply Limits.pullback.hom_ext
        · rw [hpb.isoPullback_hom_fst]
          apply Limits.Sigma.hom_ext
          intro γ
          rw [Limits.Sigma.ι_desc_assoc, Limits.Sigma.ι_desc, Limits.pullback.lift_fst, hαT]
        · rw [hpb.isoPullback_hom_snd]
          apply Limits.Sigma.hom_ext
          intro γ
          rw [Limits.Sigma.ι_desc_assoc, Limits.Sigma.ι_desc, Limits.pullback.lift_snd]
      rw [hD]
      infer_instance

  have s8 : ∀ (X : Scheme.{u}) (W₁ : X.Opens) (hW₁ : IsAffineOpen W₁) (η : X) (hη : η ∈ W₁) (B : Type u) [CommRing B] [Algebra Γ(X, W₁) B] [Module.Finite Γ(X, W₁) B] (L : Type u) [Field L] [Algebra (X.residueField η) L] (π : B →+* L), π.comp (algebraMap Γ(X, W₁) B) = (algebraMap (X.residueField η) L).comp (X.evaluation W₁ η hη).hom → (∀ b, π b = 0 → IsNilpotent b) → (∀ l : L, ∃ b b' : B, π b' ≠ 0 ∧ l * π b' = π b) → ∃ (ε : Spec (.of B)) (g : Spec ((Spec (.of B)).residueField ε) ⟶ Spec (.of L)), (∀ x : Spec (.of B), ε ⤳ x) ∧ ((Spec.map (CommRingCat.ofHom (algebraMap Γ(X, W₁) B)) ≫ hW₁.isoSpec.inv) ≫ W₁.ι) ε = η ∧ (∀ x : Spec (.of B), ((Spec.map (CommRingCat.ofHom (algebraMap Γ(X, W₁) B)) ≫ hW₁.isoSpec.inv) ≫ W₁.ι) x = η → x = ε) ∧ g ≫ Spec.map (CommRingCat.ofHom (algebraMap (X.residueField η) L)) ≫ X.fromSpecResidueField η = (Spec (.of B)).fromSpecResidueField ε ≫ (Spec.map (CommRingCat.ofHom (algebraMap Γ(X, W₁) B)) ≫ hW₁.isoSpec.inv) ≫ W₁.ι := by
    intro X W₁ hW₁ η hη B _ _ _ L _ _ π hcomp hnil hfrac
    have hQ : (Spec.map (CommRingCat.ofHom (algebraMap Γ(X, W₁) B)) ≫ hW₁.isoSpec.inv) ≫ W₁.ι =
        Spec.map (CommRingCat.ofHom (algebraMap Γ(X, W₁) B)) ≫ hW₁.fromSpec := by
      rw [Category.assoc, hW₁.isoSpec_inv_ι]
    rw [hQ]
    set F : Spec (.of L) ⟶ Spec (.of B) := Spec.map (CommRingCat.ofHom π) with hF
    set ε : Spec (.of B) := F (IsLocalRing.closedPoint L) with hε
    have hεideal : ∀ b : B, b ∈ (ε : PrimeSpectrum B).asIdeal ↔ π b = 0 := by
      intro b
      show π b ∈ IsLocalRing.maximalIdeal L ↔ _
      rw [IsLocalRing.maximalIdeal_eq_bot, Ideal.mem_bot]

    have hsq : Spec.map (CommRingCat.ofHom (algebraMap (X.residueField η) L)) ≫ X.fromSpecResidueField η =
        F ≫ Spec.map (CommRingCat.ofHom (algebraMap Γ(X, W₁) B)) ≫ hW₁.fromSpec := by
      have e1 : X.fromSpecResidueField η = Spec.map (X.residue η) ≫ Spec.map (X.presheaf.germ W₁ η hη) ≫ hW₁.fromSpec := by
        show Spec.map (X.residue η) ≫ X.fromSpecStalk η = _
        rw [← hW₁.fromSpecStalk_eq_fromSpecStalk hη]
        rfl
      rw [e1, hF]
      simp only [← Category.assoc, ← Spec.map_comp]
      congr 2
      rw [Scheme.germ_residue]
      ext b
      exact (congrArg (fun φ : Γ(X, W₁) →+* L => φ b) hcomp).symm

    have hgen : ∀ x : Spec (.of B), ε ⤳ x := by
      intro x
      refine (PrimeSpectrum.le_iff_specializes (ε : PrimeSpectrum B) (x : PrimeSpectrum B)).mp ?_
      intro b hb
      obtain ⟨n, hn⟩ := hnil b ((hεideal b).mp hb)
      exact (x : PrimeSpectrum B).isPrime.mem_of_pow_mem n (by rw [hn]; exact zero_mem _)

    have hεη : (Spec.map (CommRingCat.ofHom (algebraMap Γ(X, W₁) B)) ≫ hW₁.fromSpec) ε = η := by
      have h2 : (Spec.map (CommRingCat.ofHom (algebraMap (X.residueField η) L)) ≫ X.fromSpecResidueField η)
          (IsLocalRing.closedPoint L) = η := by
        exact (Scheme.Hom.comp_apply _ _ _).trans (Scheme.fromSpecResidueField_apply η _)
      rw [hsq] at h2
      exact h2

    have hfib : ∀ x : Spec (.of B), (Spec.map (CommRingCat.ofHom (algebraMap Γ(X, W₁) B)) ≫ hW₁.fromSpec) x = η → x = ε := by
      intro x hx
      haveI := hW₁.isOpenImmersion_fromSpec
      haveI : Algebra.IsIntegral Γ(X, W₁) B := Algebra.IsIntegral.of_finite _ _
      rw [← hεη, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at hx
      have h1 := hW₁.fromSpec.isOpenEmbedding.injective hx
      rw [Spec.map_apply, Spec.map_apply] at h1
      have h2 : Ideal.under Γ(X, W₁) (x : PrimeSpectrum B).asIdeal = Ideal.under Γ(X, W₁) (ε : PrimeSpectrum B).asIdeal :=
        congrArg PrimeSpectrum.asIdeal h1
      have hle : (ε : PrimeSpectrum B).asIdeal ≤ (x : PrimeSpectrum B).asIdeal :=
        (PrimeSpectrum.le_iff_specializes (ε : PrimeSpectrum B) (x : PrimeSpectrum B)).mpr (hgen x)
      haveI : Ideal.IsPrime (PrimeSpectrum.asIdeal (ε : PrimeSpectrum B)) := PrimeSpectrum.isPrime _
      symm
      apply PrimeSpectrum.ext
      by_contra hne
      exact (Ideal.IsIntegral.under_lt_under (R := Γ(X, W₁)) (lt_of_le_of_ne hle hne)).ne h2.symm

    set φ := Scheme.descResidueField (Scheme.stalkClosedPointTo F) with hφ
    have hstar : Spec.map φ ≫ (Spec (.of B)).fromSpecResidueField ε = F :=
      Scheme.descResidueField_stalkClosedPointTo_fromSpecResidueField L (Spec (.of B)) F
    set r := Spec.preimage ((Spec (.of B)).fromSpecResidueField ε) with hr
    have hrmap : Spec.map r = (Spec (.of B)).fromSpecResidueField ε := Spec.map_preimage _
    have hrφ : r ≫ φ = CommRingCat.ofHom π := by
      apply Spec.map_injective
      rw [Spec.map_comp, hrmap, hstar]
    have hφr : ∀ b, φ.hom (r.hom b) = π b := by
      intro b
      have := congrArg (fun ψ : CommRingCat.of B ⟶ CommRingCat.of L => ψ.hom b) hrφ
      simpa using this
    have hφiso : IsIso φ := by
      rw [ConcreteCategory.isIso_iff_bijective]
      refine ⟨φ.hom.injective, ?_⟩
      intro l
      obtain ⟨b, b', hb', hl⟩ := hfrac l
      have hrb' : r.hom b' ≠ 0 := by
        intro h; apply hb'; rw [← hφr, h, map_zero]
      refine ⟨r.hom b * (r.hom b')⁻¹, ?_⟩
      show φ.hom (r.hom b * (r.hom b')⁻¹) = l
      rw [map_mul, map_inv₀, hφr, hφr, ← hl, mul_assoc, mul_inv_cancel₀ hb', mul_one]
    refine ⟨ε, Spec.map (inv φ), hgen, hεη, hfib, ?_⟩
    rw [hsq, ← hstar]
    simp only [Category.assoc]
    rw [← Category.assoc (Spec.map (inv φ)), ← Spec.map_comp, IsIso.hom_inv_id, Spec.map_id, Category.id_comp]
  intro X _ W₀ hW₀ η hη hgen L _ _ _ _
  obtain ⟨-, hfrac, hnil⟩ := s1 X W₀ hW₀ η hη hgen
  obtain ⟨s, hs, hmodel⟩ := s2 Γ(X, W₀) (X.residueField η) L
    (X.evaluation W₀ η hη).hom hfrac hnil
  have hηW₁ : η ∈ X.basicOpen s := (X.evaluation_ne_zero_iff_mem_basicOpen η hη s).mp hs
  have hW₁ : IsAffineOpen (X.basicOpen s) := hW₀.basicOpen s
  haveI : IsLocalization.Away s Γ(X, X.basicOpen s) := hW₀.isLocalization_basicOpen s
  have hcompat : (X.evaluation (X.basicOpen s) η hηW₁).hom.comp
      (algebraMap Γ(X, W₀) Γ(X, X.basicOpen s)) = (X.evaluation W₀ η hη).hom := by
    have e : (X.evaluation (X.basicOpen s) η hηW₁).hom.comp (algebraMap Γ(X, W₀) Γ(X, X.basicOpen s)) =
        (X.presheaf.map (homOfLE (X.basicOpen_le s)).op ≫ X.evaluation (X.basicOpen s) η hηW₁).hom := rfl
    rw [e, ← Scheme.germ_residue, ← Scheme.germ_residue, ← Category.assoc, TopCat.Presheaf.germ_res]
  obtain ⟨f, U, V, π, hf, hdeg, hbez, hπof, hπnil, hπfrac, hπgal, hπinj⟩ :=
    hmodel Γ(X, X.basicOpen s) (X.evaluation (X.basicOpen s) η hηW₁).hom hcompat
  haveI hBfin : Module.Finite Γ(X, X.basicOpen s) (AdjoinRoot f) := hf.finite_adjoinRoot
  haveI hBfree : Module.Free Γ(X, X.basicOpen s) (AdjoinRoot f) := hf.free_adjoinRoot
  haveI hBnt : Nontrivial (AdjoinRoot f) := π.domain_nontrivial
  have hEt : Algebra.Etale Γ(X, X.basicOpen s) (AdjoinRoot f) :=
    s3 _ f U V hf hbez
  obtain ⟨τ, hτ1, hτmul, hτroot⟩ := s4 Γ(X, X.basicOpen s)
    (X.residueField η) L (X.evaluation (X.basicOpen s) η hηW₁).hom f U V π hbez hπof hπnil hπgal
  haveI : Fintype (L ≃ₐ[X.residueField η] L) := Fintype.ofFinite _
  have hroot : ∀ c : AdjoinRoot f, Polynomial.aeval c f = 0 →
      ((f.map (algebraMap Γ(X, X.basicOpen s) (AdjoinRoot f))).eval c = 0 ∧
        IsUnit ((Polynomial.derivative (f.map (algebraMap Γ(X, X.basicOpen s) (AdjoinRoot f)))).eval c)) := by
    intro c hc
    refine ⟨by rw [Polynomial.eval_map_algebraMap]; exact hc, ?_⟩
    rw [Polynomial.derivative_map, Polynomial.eval_map_algebraMap]
    have h := congrArg (Polynomial.aeval c) hbez
    rw [map_add, map_mul, map_mul, hc, zero_mul, zero_add, map_one] at h
    exact IsUnit.of_mul_eq_one _ h
  have hr0 : Polynomial.aeval (AdjoinRoot.root f) f = 0 := by
    rw [AdjoinRoot.aeval_eq, AdjoinRoot.mk_self]
  have hτr : ∀ γ, Polynomial.aeval (τ γ (AdjoinRoot.root f)) f = 0 := by
    intro γ
    rw [Polynomial.aeval_algHom_apply, hr0, map_zero]
  have hunit : ∀ γ δ, γ ≠ δ → IsUnit (τ γ (AdjoinRoot.powerBasis' hf).gen -
      τ δ (AdjoinRoot.powerBasis' hf).gen) := by
    intro γ δ hγδ
    rw [AdjoinRoot.powerBasis'_gen]
    refine s5 (AdjoinRoot f) L π _ _ _ hπnil (hroot _ (hτr γ)).1
      (hroot _ (hτr δ)).1 (hroot _ (hτr δ)).2 ?_
    intro h
    rw [hτroot, hτroot] at h
    exact hγδ (inv_injective (hπinj _ _ h))
  have hcard : Fintype.card (L ≃ₐ[X.residueField η] L) = (AdjoinRoot.powerBasis' hf).dim := by
    rw [AdjoinRoot.powerBasis'_dim, hdeg, Nat.card_eq_fintype_card]
  have hbij := s6 Γ(X, X.basicOpen s) (AdjoinRoot f)
    (AdjoinRoot.powerBasis' hf) (L ≃ₐ[X.residueField η] L) τ hcard hunit
  obtain ⟨α, hα⟩ := s7 (X.basicOpen s : Scheme.{u}) Γ(X, X.basicOpen s)
    (AdjoinRoot f) hW₁.isoSpec (L ≃ₐ[X.residueField η] L) τ hEt hBfin hBfree hBnt hτ1 hτmul hbij
  obtain ⟨ε, g, hεgen, hεη, hfib, hg⟩ := s8 X (X.basicOpen s) hW₁ η hηW₁
    (AdjoinRoot f) L π (by rw [AdjoinRoot.algebraMap_eq]; exact hπof) hπnil hπfrac
  haveI : IsNoetherianRing Γ(X, X.basicOpen s) :=
    IsLocallyNoetherian.component_noetherian ⟨X.basicOpen s, hW₁⟩
  haveI : IsNoetherianRing (AdjoinRoot f) := IsNoetherianRing.of_finite Γ(X, X.basicOpen s) _
  refine ⟨X.basicOpen s, Spec (.of (AdjoinRoot f)),
    Spec.map (CommRingCat.ofHom (algebraMap Γ(X, X.basicOpen s) (AdjoinRoot f))) ≫ hW₁.isoSpec.inv,
    L ≃ₐ[X.residueField η] L, inferInstance, α, ε, g, X.basicOpen_le s, hηW₁, hW₁, inferInstance,
    ?_, hα, hεgen, hεη, hfib, hg⟩
  exact isLocallyNoetherian_Spec.mpr inferInstance

theorem wc_etsplits_generic_nil_lift : ∀ {E P : Scheme.{u}} [IsLocallyNoetherian E] (π : P ⟶ E) [Etale π] (ε : E), (∀ x : E, ε ⤳ x) → ∀ (σ₀ : Spec (E.residueField ε) ⟶ P), σ₀ ≫ π = E.fromSpecResidueField ε → ∃ φ : Spec (E.presheaf.stalk ε) ⟶ P, φ ≫ π = E.fromSpecStalk ε ∧ Spec.map (E.residue ε) ≫ φ = σ₀ :=
by
  intro E P _ π _ ε hgen σ₀ hσ₀
  classical

  have hnil : IsNilpotent (IsLocalRing.maximalIdeal (E.presheaf.stalk ε)) := by
    have hprime : ∀ q : PrimeSpectrum (E.presheaf.stalk ε),
        q = IsLocalRing.closedPoint (E.presheaf.stalk ε) := by
      intro q
      apply (Scheme.Hom.isEmbedding (E.fromSpecStalk ε)).injective
      rw [Scheme.fromSpecStalk_closedPoint]
      have h1 : E.fromSpecStalk ε q ∈ Set.range (E.fromSpecStalk ε) := ⟨q, rfl⟩
      rw [Scheme.range_fromSpecStalk] at h1
      exact (Specializes.antisymm h1 (hgen _)).eq
    have hle : IsLocalRing.maximalIdeal (E.presheaf.stalk ε) ≤ nilradical (E.presheaf.stalk ε) := by
      rw [nilradical_eq_sInf]
      refine le_sInf fun J hJ => ?_
      have h2 : J = IsLocalRing.maximalIdeal (E.presheaf.stalk ε) :=
        congrArg PrimeSpectrum.asIdeal (hprime ⟨J, hJ⟩)
      rw [h2]
    obtain ⟨n, hn⟩ := IsNoetherianRing.isNilpotent_nilradical (E.presheaf.stalk ε)
    refine ⟨n, ?_⟩
    have h3 := Ideal.pow_right_mono hle n
    rw [hn] at h3
    exact le_bot_iff.mp h3

  have hfac : ∀ {X : Scheme.{u}} {S : CommRingCat.{u}} [IsLocalRing S] (g : Spec S ⟶ X)
      (U : X.Opens) (hU : IsAffineOpen U), g (IsLocalRing.closedPoint S) ∈ U →
      ∃ c : Γ(X, U) ⟶ S, Spec.map c ≫ hU.fromSpec = g := by
    intro X S _ g U hU hg
    have hr : Set.range g ⊆ Set.range hU.fromSpec := by
      rw [hU.range_fromSpec]
      rintro _ ⟨q, rfl⟩
      have hs : q ⤳ IsLocalRing.closedPoint S :=
        (PrimeSpectrum.le_iff_specializes _ _).mp (IsLocalRing.le_maximalIdeal q.isPrime.ne_top)
      exact (hs.map g.continuous).mem_open U.isOpen hg
    haveI := hU.isOpenImmersion_fromSpec
    exact ⟨Spec.preimage (IsOpenImmersion.lift hU.fromSpec g hr),
      by rw [Spec.map_preimage, IsOpenImmersion.lift_fac]⟩

  obtain ⟨V, hV, hεV, -⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp
    (Scheme.isBasis_affineOpens E)) (show ε ∈ (⊤ : E.Opens) from trivial)
  have hV' : IsAffineOpen V := hV
  have hp0' : ∀ x : Spec (E.residueField ε), π (σ₀ x) = ε := by
    intro x
    rw [← Scheme.Hom.comp_apply, hσ₀, Scheme.fromSpecResidueField_apply]
  have hp0 : π (σ₀ (IsLocalRing.closedPoint (E.residueField ε))) = ε := hp0' _
  obtain ⟨W, hW, hpW, hWV⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp
    (Scheme.isBasis_affineOpens P))
    (show σ₀ (IsLocalRing.closedPoint (E.residueField ε)) ∈ π ⁻¹ᵁ V by
      rw [Scheme.Hom.mem_preimage, hp0]; exact hεV)
  have hW' : IsAffineOpen W := hW
  obtain ⟨ψ, hψ⟩ := hfac σ₀ W hW' hpW
  have hρ : RingHom.Etale (π.appLE V W hWV).hom :=
    HasRingHomProperty.appLE @Etale π ‹_› ⟨V, hV⟩ ⟨W, hW⟩ hWV
  have hdag := IsAffineOpen.SpecMap_appLE_fromSpec π hV' hW' hWV
  have hsec : Spec.map (E.presheaf.germ V ε hεV) ≫ hV'.fromSpec = E.fromSpecStalk ε := by
    rw [← hV'.fromSpecStalk_eq_fromSpecStalk hεV]
    rfl
  haveI := hV'.isOpenImmersion_fromSpec
  have hcomp : π.appLE V W hWV ≫ ψ = E.presheaf.germ V ε hεV ≫ E.residue ε := by
    apply Spec.map_injective
    rw [← cancel_mono hV'.fromSpec]
    rw [Spec.map_comp, Category.assoc, hdag, ← Category.assoc, hψ, hσ₀, Spec.map_comp,
      Category.assoc, hsec, Scheme.fromSpecResidueField.eq_1]

  letI : Algebra Γ(E, V) Γ(P, W) := (π.appLE V W hWV).hom.toAlgebra
  letI : Algebra Γ(E, V) (E.presheaf.stalk ε) := (E.presheaf.germ V ε hεV).hom.toAlgebra
  haveI : Algebra.Etale Γ(E, V) Γ(P, W) := RingHom.Etale.toAlgebra hρ
  let ψ' : Γ(P, W) →ₐ[Γ(E, V)]
      (E.presheaf.stalk ε) ⧸ IsLocalRing.maximalIdeal (E.presheaf.stalk ε) :=
    { toRingHom := ψ.hom
      commutes' := fun a => by
        have h := congrArg (fun f => CommRingCat.Hom.hom f a) hcomp
        exact h }
  obtain ⟨f, hf⟩ := Algebra.FormallySmooth.exists_lift _ hnil ψ'
  obtain ⟨F, hF⟩ : ∃ F : Γ(P, W) ⟶ E.presheaf.stalk ε, F.hom = f.toRingHom :=
    ⟨CommRingCat.ofHom f.toRingHom, rfl⟩
  have hF1 : π.appLE V W hWV ≫ F = E.presheaf.germ V ε hεV := by
    ext a
    show F.hom ((π.appLE V W hWV).hom a) = (E.presheaf.germ V ε hεV).hom a
    rw [hF]
    exact f.commutes a
  have hF2 : F ≫ E.residue ε = ψ := by
    ext b
    show (E.residue ε).hom (F.hom b) = ψ.hom b
    rw [hF]
    exact DFunLike.congr_fun hf b

  refine ⟨Spec.map F ≫ hW'.fromSpec, ?_, ?_⟩
  · rw [Category.assoc, ← hdag, ← Category.assoc, ← Spec.map_comp, hF1, hsec]
  · rw [← Category.assoc, ← Spec.map_comp, hF2, hψ]

theorem wc_etale_section_isOpenImmersion : ∀ {Y P E : Scheme.{u}} (π : P ⟶ E) [Etale π] (j : Y ⟶ E) [IsOpenImmersion j] (σ : Y ⟶ P), σ ≫ π = j → IsOpenImmersion σ :=
by
  intro Y P E π _ j _ σ h
  haveI : IsOpenImmersion (σ ≫ π) := by rw [h]; infer_instance
  haveI hL : IsOpenImmersion (Limits.pullback.lift (𝟙 Y) σ (by simp) :
      Y ⟶ Limits.pullback (σ ≫ π) π) :=
    MorphismProperty.of_isPullback (P := @IsOpenImmersion)
      (Limits.pullback_lift_diagonal_isPullback σ π)
      (FormallyUnramified.isOpenImmersion_diagonal π)
  have e : (Limits.pullback.lift (𝟙 Y) σ (by simp) : Y ⟶ Limits.pullback (σ ≫ π) π) ≫
      Limits.pullback.snd (σ ≫ π) π = σ := Limits.pullback.lift_snd _ _ _
  rw [← e]
  infer_instance

theorem wc_generic_point_avoid_closed_image : ∀ {P E : Scheme.{u}} (π : P ⟶ E) [QuasiCompact π] (ε : E), (∀ x : E, ε ⤳ x) → ∀ (Z : Set P), IsClosed Z → (∀ z ∈ Z, π z ≠ ε) → ∃ O : E.Opens, ε ∈ O ∧ ∀ z ∈ Z, π z ∉ O :=
by
  intro P E π _ ε hgen Z hZ hZε

  have s1 : ∀ {R S : Type u} [CommRing R] [CommRing S] (φ : R →+* S) (Z : Set (PrimeSpectrum S)),
      IsClosed Z → ∀ y ∈ closure (PrimeSpectrum.comap φ '' Z), ∃ z ∈ Z, PrimeSpectrum.comap φ z ⤳ y := by
    intro R S _ _ φ Z hZ y hy
    obtain ⟨I, rfl⟩ := (PrimeSpectrum.isClosed_iff_zeroLocus_ideal Z).mp hZ
    rw [PrimeSpectrum.closure_image_comap_zeroLocus, PrimeSpectrum.mem_zeroLocus] at hy
    obtain ⟨p, hp, hpy⟩ := Ideal.exists_minimalPrimes_le (J := y.asIdeal) (SetLike.coe_subset_coe.mp hy)
    obtain ⟨p', hp', hIp', hcomap⟩ := Ideal.exists_comap_eq_of_mem_minimalPrimes φ p hp
    refine ⟨⟨p', hp'⟩, ?_, ?_⟩
    · rw [PrimeSpectrum.mem_zeroLocus]
      exact SetLike.coe_subset_coe.mpr hIp'
    · rw [← PrimeSpectrum.le_iff_specializes]
      show (PrimeSpectrum.comap φ ⟨p', hp'⟩).asIdeal ≤ y.asIdeal
      rw [PrimeSpectrum.comap_asIdeal, hcomap]
      exact hpy
  let C := closure (⇑π '' Z)
  refine ⟨⟨Cᶜ, isClosed_closure.isOpen_compl⟩, ?_, ?_⟩
  swap
  · intro z hz hzO
    exact hzO (subset_closure (Set.mem_image_of_mem _ hz))
  show ε ∉ C
  intro hεC

  obtain ⟨V, hV', hεV, -⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp
    (Scheme.isBasis_affineOpens E)) (show ε ∈ (⊤ : E.Opens) from trivial)
  have hV : IsAffineOpen V := hV'
  have hcpt : IsCompact (π ⁻¹ᵁ V : P.Opens).carrier :=
    QuasiCompact.isCompact_preimage (V : Set E) V.isOpen hV.isCompact
  obtain ⟨Us, hUs, hUsfin, hUseq⟩ := (Scheme.isBasis_affineOpens P).exists_finite_of_isCompact hcpt
  have hsub : (V : Set E) ∩ ⇑π '' Z ⊆ ⋃ U ∈ Us, ⇑π '' (Z ∩ (U : Set P)) := by
    rintro x ⟨hxV, z, hz, rfl⟩
    have hz' : z ∈ π ⁻¹ᵁ V := hxV
    rw [hUseq, TopologicalSpace.Opens.mem_sSup] at hz'
    obtain ⟨U, hU, hzU⟩ := hz'
    exact Set.mem_biUnion hU ⟨z, ⟨hz, hzU⟩, rfl⟩
  have hεmem : ε ∈ ⋃ U ∈ Us, closure (⇑π '' (Z ∩ (U : Set P))) := by
    rw [← hUsfin.closure_biUnion]
    exact closure_mono hsub (V.isOpen.inter_closure ⟨hεV, hεC⟩)
  obtain ⟨U, hUUs, hεU⟩ := Set.mem_iUnion₂.mp hεmem
  have hU : IsAffineOpen U := hUs hUUs
  have hUV : U ≤ π ⁻¹ᵁ V := by rw [hUseq]; exact le_sSup hUUs

  set f : Spec Γ(P, U) ⟶ Spec Γ(E, V) := Spec.map (π.appLE V U hUV) with hfdef
  have hsq : ∀ s, hV.fromSpec (f s) = π (hU.fromSpec s) := by
    intro s
    rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, hfdef,
      IsAffineOpen.SpecMap_appLE_fromSpec π hV hU hUV]
  obtain ⟨y', hy'⟩ : ε ∈ Set.range hV.fromSpec := by rw [hV.range_fromSpec]; exact hεV
  have := hV.isOpenImmersion_fromSpec
  have hind : Topology.IsInducing hV.fromSpec := hV.fromSpec.isOpenEmbedding.isInducing
  have himg : hV.fromSpec '' (f '' (hU.fromSpec ⁻¹' Z)) = ⇑π '' (Z ∩ (U : Set P)) := by
    rw [Set.image_image, show (fun s => hV.fromSpec (f s)) = (fun s => π (hU.fromSpec s)) from
      funext hsq, ← Set.image_image (⇑π) (⇑hU.fromSpec),
      Set.image_preimage_eq_inter_range, hU.range_fromSpec]
  have hy'cl : y' ∈ closure (f '' (hU.fromSpec ⁻¹' Z)) := by
    rw [hind.closure_eq_preimage_closure_image, himg, Set.mem_preimage, hy']
    exact hεU
  have hfun : (⇑f : Spec Γ(P, U) → Spec Γ(E, V)) = PrimeSpectrum.comap (π.appLE V U hUV).hom :=
    funext fun x => Spec.map_apply _ x
  rw [hfun] at hy'cl
  obtain ⟨z', hz'Z, hspec⟩ := s1 (π.appLE V U hUV).hom _ (hZ.preimage hU.fromSpec.continuous) y' hy'cl
  rw [← hfun] at hspec
  have h1 : π (hU.fromSpec z') ⤳ ε := by
    have := hspec.map hV.fromSpec.continuous
    convert this using 1
    · exact (hsq z').symm
    · exact hy'.symm

  exact hZε _ hz'Z (h1.antisymm (hgen _)).eq

theorem wc_etsplits_residue_fibre : ∀ {X E : Scheme.{u}} (T : X.Etale) (e : E ⟶ X) (ε : E) (A : Type u) (s : A → (Spec (E.residueField ε) ⟶ T.left)) (h : ∀ a, s a ≫ T.hom = E.fromSpecResidueField ε ≫ e), wcEtSplits (E.fromSpecResidueField ε ≫ e) T A s → (∀ (a b : A) (p p' : Spec (E.residueField ε)), Limits.pullback.lift (s a) (E.fromSpecResidueField ε) (h a) p = Limits.pullback.lift (s b) (E.fromSpecResidueField ε) (h b) p' → a = b) ∧ (∀ z : ↥(Limits.pullback T.hom e), Limits.pullback.snd T.hom e z = ε → ∃ (a : A) (p : Spec (E.residueField ε)), Limits.pullback.lift (s a) (E.fromSpecResidueField ε) (h a) p = z) :=
by
  intro X E T e ε A s h hsplit
  classical
  obtain ⟨_, hs, hD⟩ := hsplit
  let ρ : Limits.pullback T.hom (E.fromSpecResidueField ε ≫ e) ⟶ Limits.pullback T.hom e :=
    Limits.pullback.lift (Limits.pullback.fst T.hom (E.fromSpecResidueField ε ≫ e))
      (Limits.pullback.snd T.hom (E.fromSpecResidueField ε ≫ e) ≫ E.fromSpecResidueField ε)
      (by rw [Category.assoc]; exact Limits.pullback.condition)
  have hρ1 : ρ ≫ Limits.pullback.fst T.hom e =
      Limits.pullback.fst T.hom (E.fromSpecResidueField ε ≫ e) := Limits.pullback.lift_fst _ _ _
  have hρ2 : ρ ≫ Limits.pullback.snd T.hom e =
      Limits.pullback.snd T.hom (E.fromSpecResidueField ε ≫ e) ≫ E.fromSpecResidueField ε :=
    Limits.pullback.lift_snd _ _ _
  let ι := Limits.pullbackLeftPullbackSndIso T.hom e (E.fromSpecResidueField ε)
  have hιρ : ι.hom ≫ ρ =
      Limits.pullback.fst (Limits.pullback.snd T.hom e) (E.fromSpecResidueField ε) := by
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, hρ1, Limits.pullbackLeftPullbackSndIso_hom_fst]
    · rw [Category.assoc, hρ2, ← Category.assoc, Limits.pullbackLeftPullbackSndIso_hom_snd]
      exact Limits.pullback.condition.symm
  have hρeq : ρ = ι.inv ≫
      Limits.pullback.fst (Limits.pullback.snd T.hom e) (E.fromSpecResidueField ε) := by
    rw [← hιρ, Iso.inv_hom_id_assoc]
  have hfstinj : Function.Injective
      (Limits.pullback.fst (Limits.pullback.snd T.hom e) (E.fromSpecResidueField ε)) :=
    (Limits.pullback.fst (Limits.pullback.snd T.hom e) (E.fromSpecResidueField ε)).isEmbedding.injective
  have hρinj : Function.Injective ρ := by
    intro x y hxy
    rw [hρeq, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at hxy
    have h1 := congrArg ι.hom (hfstinj hxy)
    rwa [Scheme.inv_hom_apply, Scheme.inv_hom_apply] at h1
  have hℓρ : ∀ a, Limits.pullback.lift (s a) (𝟙 _) ((hs a).trans (Category.id_comp _).symm) ≫ ρ =
      Limits.pullback.lift (s a) (E.fromSpecResidueField ε) (h a) := by
    intro a
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, hρ1, Limits.pullback.lift_fst, Limits.pullback.lift_fst]
    · rw [Category.assoc, hρ2, ← Category.assoc, Limits.pullback.lift_snd, Category.id_comp,
        Limits.pullback.lift_snd]
  let D := (Limits.Sigma.desc (fun a => Limits.pullback.lift (s a) (𝟙 _)
      ((hs a).trans (Category.id_comp (E.fromSpecResidueField ε ≫ e)).symm)) :
      ∐ (fun _ : A => Spec (E.residueField ε)) ⟶ Limits.pullback T.hom (E.fromSpecResidueField ε ≫ e))
  have : IsIso D := hD
  have hDinj : Function.Injective D := by
    intro x y hxy
    have h1 := Scheme.hom_inv_apply (asIso D) x
    have h2 := Scheme.hom_inv_apply (asIso D) y
    rw [asIso_hom] at h1 h2
    calc x = (asIso D).inv (D x) := h1.symm
      _ = (asIso D).inv (D y) := by rw [hxy]
      _ = y := h2
  have hDsurj : Function.Surjective D := by
    intro w
    refine ⟨(asIso D).inv w, ?_⟩
    have h1 := Scheme.inv_hom_apply (asIso D) w
    rwa [asIso_hom] at h1
  have hιD : ∀ a (p : Spec (E.residueField ε)),
      D (Limits.Sigma.ι (fun _ : A => Spec (E.residueField ε)) a p) =
      Limits.pullback.lift (s a) (𝟙 _) ((hs a).trans (Category.id_comp _).symm) p := by
    intro a p
    rw [← Scheme.Hom.comp_apply]
    exact congrArg (fun g : Spec (E.residueField ε) ⟶
      Limits.pullback T.hom (E.fromSpecResidueField ε ≫ e) => g p)
      (Limits.Sigma.ι_comp_desc (fun a => Limits.pullback.lift (s a) (𝟙 _)
        ((hs a).trans (Category.id_comp (E.fromSpecResidueField ε ≫ e)).symm)) a)
  refine ⟨fun a b p p' hpp' => ?_, fun z hz => ?_⟩
  · rw [← hℓρ a, ← hℓρ b, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at hpp'
    have h1 := hρinj hpp'
    rw [← hιD a p, ← hιD b p'] at h1
    have h3 := (sigmaι_eq_iff _ _ _ _ _).mp (hDinj h1)
    exact congrArg Sigma.fst h3
  · obtain ⟨pt⟩ : Nonempty (Spec (E.residueField ε)) := inferInstance
    have hpt : Limits.pullback.snd T.hom e z = E.fromSpecResidueField ε pt := by
      rw [hz, Scheme.fromSpecResidueField_apply]
    obtain ⟨w, hw1, -⟩ := Scheme.Pullback.exists_preimage_pullback z pt hpt
    obtain ⟨y, hy⟩ := hDsurj (ι.hom w)
    obtain ⟨⟨a, p⟩, rfl⟩ := (sigmaMk (fun _ : A => Spec (E.residueField ε))).surjective y
    refine ⟨a, p, ?_⟩
    rw [← hℓρ a, Scheme.Hom.comp_apply, ← hιD a p, ← sigmaMk_mk, hy, ← Scheme.Hom.comp_apply,
      hιρ, hw1]

theorem wc_etsplits_of_open_sections : ∀ {X E : Scheme.{u}} (T : X.Etale) (e : E ⟶ X) (O : E.Opens) (A : Type u) [Finite A] (σ : A → ((O : Scheme.{u}) ⟶ Limits.pullback T.hom e)), (∀ a, σ a ≫ Limits.pullback.snd T.hom e = O.ι) → (∀ (a b : A) (u v : (O : Scheme.{u})), σ a u = σ b v → a = b) → (∀ z : ↥(Limits.pullback T.hom e), Limits.pullback.snd T.hom e z ∈ O → ∃ (a : A) (u : (O : Scheme.{u})), σ a u = z) → wcEtSplits (O.ι ≫ e) T A (fun a => σ a ≫ Limits.pullback.fst T.hom e) :=
by
  intro X E T e O A _ σ hσπ hdisj hcov
  haveI hco : Limits.HasCoproduct (fun _ : A => (O : Scheme.{u})) := inferInstance
  haveI : Etale T.hom := T.prop
  have hs : ∀ a, (σ a ≫ Limits.pullback.fst T.hom e) ≫ T.hom = O.ι ≫ e := by
    intro a
    rw [Category.assoc, Limits.pullback.condition, ← Category.assoc, hσπ a]
  refine ⟨inferInstance, hs, ?_⟩
  obtain ⟨ℓ, hℓdef⟩ : ∃ ℓ : A → ((O : Scheme.{u}) ⟶ Limits.pullback T.hom (O.ι ≫ e)),
      ∀ a, ℓ a = Limits.pullback.lift (σ a ≫ Limits.pullback.fst T.hom e) (𝟙 _)
        ((hs a).trans (Category.id_comp (O.ι ≫ e)).symm) := ⟨_, fun a => rfl⟩
  have hgoal : (fun a => Limits.pullback.lift (σ a ≫ Limits.pullback.fst T.hom e)
      (𝟙 (O : Scheme.{u})) ((hs a).trans (Category.id_comp (O.ι ≫ e)).symm)) = ℓ :=
    funext fun a => (hℓdef a).symm
  rw [hgoal]
  have hℓfst : ∀ a, ℓ a ≫ Limits.pullback.fst T.hom (O.ι ≫ e) =
      σ a ≫ Limits.pullback.fst T.hom e := by
    intro a; rw [hℓdef a]; exact Limits.pullback.lift_fst _ _ _
  have hℓsnd : ∀ a, ℓ a ≫ Limits.pullback.snd T.hom (O.ι ≫ e) = 𝟙 _ := by
    intro a; rw [hℓdef a]; exact Limits.pullback.lift_snd _ _ _

  obtain ⟨ρ, hρdef⟩ : ∃ ρ : Limits.pullback T.hom (O.ι ≫ e) ⟶ Limits.pullback T.hom e,
      ρ = (Limits.pullbackLeftPullbackSndIso T.hom e O.ι).inv ≫
        Limits.pullback.fst (Limits.pullback.snd T.hom e) O.ι := ⟨_, rfl⟩
  have hρimm : IsOpenImmersion ρ := by rw [hρdef]; infer_instance
  have hρinj : Function.Injective ρ := ρ.isOpenEmbedding.injective
  have hρfst : ρ ≫ Limits.pullback.fst T.hom e = Limits.pullback.fst T.hom (O.ι ≫ e) := by
    rw [hρdef, Category.assoc, Limits.pullbackLeftPullbackSndIso_inv_fst]
  have hρsnd : ρ ≫ Limits.pullback.snd T.hom e =
      Limits.pullback.snd T.hom (O.ι ≫ e) ≫ O.ι := by
    rw [hρdef, Category.assoc, Limits.pullback.condition, ← Category.assoc,
      Limits.pullbackLeftPullbackSndIso_inv_snd_snd]
  have hℓρ : ∀ a, ℓ a ≫ ρ = σ a := by
    intro a
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, hρfst, hℓfst a]
    · rw [Category.assoc, hρsnd, ← Category.assoc, hℓsnd a, Category.id_comp, hσπ a]
  haveI : Etale (Limits.pullback.snd T.hom (O.ι ≫ e)) := inferInstance
  haveI hℓimm : ∀ a, IsOpenImmersion (ℓ a) := by
    intro a
    haveI : IsOpenImmersion (ℓ a ≫ Limits.pullback.snd T.hom (O.ι ≫ e)) := by
      rw [hℓsnd a]; infer_instance
    haveI hL : IsOpenImmersion (Limits.pullback.lift (𝟙 _) (ℓ a) (by simp) :
        (O : Scheme.{u}) ⟶ Limits.pullback (ℓ a ≫ Limits.pullback.snd T.hom (O.ι ≫ e))
          (Limits.pullback.snd T.hom (O.ι ≫ e))) :=
      MorphismProperty.of_isPullback (P := @IsOpenImmersion)
        (Limits.pullback_lift_diagonal_isPullback (ℓ a) (Limits.pullback.snd T.hom (O.ι ≫ e)))
        (FormallyUnramified.isOpenImmersion_diagonal (Limits.pullback.snd T.hom (O.ι ≫ e)))
    have he : (Limits.pullback.lift (𝟙 _) (ℓ a) (by simp) :
        (O : Scheme.{u}) ⟶ Limits.pullback (ℓ a ≫ Limits.pullback.snd T.hom (O.ι ≫ e))
          (Limits.pullback.snd T.hom (O.ι ≫ e))) ≫
        Limits.pullback.snd (ℓ a ≫ Limits.pullback.snd T.hom (O.ι ≫ e))
          (Limits.pullback.snd T.hom (O.ι ≫ e)) = ℓ a := Limits.pullback.lift_snd _ _ _
    rw [← he]
    infer_instance
  have hD : IsOpenImmersion (Limits.Sigma.desc ℓ) := by
    apply isOpenImmersion_sigmaDesc
    intro a b hab
    rw [Function.onFun, Set.disjoint_left]
    rintro x ⟨p, rfl⟩ ⟨q, hq⟩
    apply hab
    apply hdisj a b p q
    rw [← hℓρ a, ← hℓρ b, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply, hq]
  have hS : AlgebraicGeometry.Surjective (Limits.Sigma.desc ℓ) := by
    rw [surjective_iff]
    intro w
    obtain ⟨a, p, hp⟩ := hcov (ρ w) (by
      rw [← Scheme.Hom.comp_apply, hρsnd, Scheme.Hom.comp_apply]
      have hr : O.ι ((Limits.pullback.snd T.hom (O.ι ≫ e)) w) ∈ Set.range O.ι :=
        Set.mem_range_self _
      rw [Scheme.Opens.range_ι] at hr
      exact hr)
    refine ⟨Limits.Sigma.ι (fun _ : A => (O : Scheme.{u})) a p, ?_⟩
    rw [← Scheme.Hom.comp_apply, Limits.Sigma.ι_desc]
    apply hρinj
    rw [← Scheme.Hom.comp_apply, hℓρ a, hp]
  exact (isIso_iff_isOpenImmersion_and_surjective _).mpr ⟨hD, hS⟩

theorem wc_etsplits_spread_generic : ∀ {X E : Scheme.{u}} [QuasiSeparatedSpace X] [IsLocallyNoetherian E] (T : X.Etale), CompactSpace T.left → ∀ (e : E ⟶ X) (ε : E), (∀ x : E, ε ⤳ x) → ∀ (A : Type u) (s : A → (Spec (E.residueField ε) ⟶ T.left)), wcEtSplits (E.fromSpecResidueField ε ≫ e) T A s → ∃ (O : E.Opens) (s' : A → ((O : Scheme.{u}) ⟶ T.left)), ε ∈ O ∧ wcEtSplits (O.ι ≫ e) T A s' :=
by
  intro X E _ _ T hT e ε hgen A s hs
  classical
  obtain ⟨hA, h, hiso⟩ := hs
  haveI := hA
  haveI : CompactSpace ((𝟭 Scheme).obj T.left) := hT
  haveI : QuasiSeparatedSpace ((Functor.fromPUnit X).obj T.right) :=
    inferInstanceAs (QuasiSeparatedSpace X)
  haveI : QuasiCompact T.hom := quasiCompact_of_compactSpace T.hom
  haveI : Etale T.hom := T.prop
  haveI : Etale (Limits.pullback.snd T.hom e) := inferInstance
  haveI : QuasiCompact (Limits.pullback.snd T.hom e) := inferInstance

  obtain ⟨hI, hC⟩ := wc_etsplits_residue_fibre T e ε A s h ⟨hA, h, hiso⟩
  obtain ⟨σ0, hσ0def⟩ : ∃ σ0 : A → (Spec (E.residueField ε) ⟶ Limits.pullback T.hom e),
      ∀ a, σ0 a = Limits.pullback.lift (s a) (E.fromSpecResidueField ε) (h a) := ⟨_, fun a => rfl⟩
  have hσ0 : ∀ a, σ0 a ≫ Limits.pullback.snd T.hom e = E.fromSpecResidueField ε := by
    intro a
    rw [hσ0def]
    exact Limits.pullback.lift_snd _ _ _

  have hlift : ∀ a, ∃ φ : Spec (E.presheaf.stalk ε) ⟶ Limits.pullback T.hom e,
      φ ≫ Limits.pullback.snd T.hom e = E.fromSpecStalk ε ∧ Spec.map (E.residue ε) ≫ φ = σ0 a :=
    fun a => wc_etsplits_generic_nil_lift (Limits.pullback.snd T.hom e) ε hgen (σ0 a) (hσ0 a)
  choose φ hφπ hφres using hlift

  have hspread : ∀ a, ∃ (U : E.Opens) (hεU : ε ∈ U)
      (f : (U : Scheme.{u}) ⟶ Limits.pullback T.hom e),
      φ a = U.fromSpecStalkOfMem ε hεU ≫ f ∧ f ≫ Limits.pullback.snd T.hom e = U.ι ≫ 𝟙 E :=
    fun a => spread_out_of_isGermInjective' (𝟙 E) (Limits.pullback.snd T.hom e) (φ a)
      (by rw [hφπ a, Category.comp_id])
  choose U hεU f hφf hfπ using hspread

  have hpt : ∀ a (v : (U a : Scheme.{u})) (p : Spec (E.residueField ε)),
      (U a).ι v = ε → f a v = σ0 a p := by
    intro a v p hv
    have e1 : Spec.map (E.residue ε) ≫ (U a).fromSpecStalkOfMem ε (hεU a) ≫ (U a).ι =
        E.fromSpecResidueField ε := by
      rw [Scheme.Opens.fromSpecStalkOfMem_ι, Scheme.fromSpecResidueField.eq_1]
    have h1 : (U a).ι ((U a).fromSpecStalkOfMem ε (hεU a) (Spec.map (E.residue ε) p)) = ε := by
      have := congrArg (fun g : Spec (E.residueField ε) ⟶ E => g p) e1
      simpa only [Scheme.Hom.comp_apply, Scheme.fromSpecResidueField_apply] using this
    have hveq : v = (U a).fromSpecStalkOfMem ε (hεU a) (Spec.map (E.residue ε) p) :=
      (U a).ι.isOpenEmbedding.injective (hv.trans h1.symm)
    have e2 : Spec.map (E.residue ε) ≫ (U a).fromSpecStalkOfMem ε (hεU a) ≫ f a = σ0 a := by
      rw [← hφf a, hφres a]
    rw [hveq]
    have := congrArg (fun g : Spec (E.residueField ε) ⟶ Limits.pullback T.hom e => g p) e2
    simpa only [Scheme.Hom.comp_apply] using this

  obtain ⟨O₁, hO₁⟩ : ∃ O₁ : E.Opens, O₁ = ⨅ a, U a := ⟨_, rfl⟩
  have hle : ∀ a, O₁ ≤ U a := fun a => hO₁ ▸ iInf_le U a
  have hε₁ : ε ∈ O₁ := by
    rw [hO₁, ← SetLike.mem_coe, TopologicalSpace.Opens.coe_iInf, Set.mem_iInter]
    exact hεU
  obtain ⟨σ, hσdef⟩ : ∃ σ : A → ((O₁ : Scheme.{u}) ⟶ Limits.pullback T.hom e),
      ∀ a, σ a = E.homOfLE (hle a) ≫ f a := ⟨_, fun a => rfl⟩
  have hσπ : ∀ a, σ a ≫ Limits.pullback.snd T.hom e = O₁.ι := by
    intro a
    rw [hσdef, Category.assoc, hfπ a, Category.comp_id, Scheme.homOfLE_ι]
  have hstar : ∀ a (u : (O₁ : Scheme.{u})) (p : Spec (E.residueField ε)),
      O₁.ι u = ε → σ a u = σ0 a p := by
    intro a u p hu
    rw [hσdef, Scheme.Hom.comp_apply]
    apply hpt
    rw [← Scheme.Hom.comp_apply, Scheme.homOfLE_ι]
    exact hu

  have hσimm : ∀ a, IsOpenImmersion (σ a) := fun a =>
    wc_etale_section_isOpenImmersion (Limits.pullback.snd T.hom e) O₁.ι (σ a) (hσπ a)
  have hσopen : ∀ a, IsOpen (Set.range (σ a)) := fun a => by
    haveI := hσimm a
    exact (σ a).isOpenEmbedding.isOpen_range

  have hdisj : ∀ (a b : A) (u v : (O₁ : Scheme.{u})), σ a u = σ b v → a = b := by
    intro a b u v huv
    obtain ⟨p⟩ : Nonempty (Spec (E.residueField ε)) := inferInstance
    have hRo : IsOpen (Set.range (σ a) ∩ Set.range (σ b)) := (hσopen a).inter (hσopen b)
    have hRim : IsOpen ((Limits.pullback.snd T.hom e) '' (Set.range (σ a) ∩ Set.range (σ b))) :=
      (Limits.pullback.snd T.hom e).isOpenMap _ hRo
    have hmem : (Limits.pullback.snd T.hom e) (σ a u) ∈
        (Limits.pullback.snd T.hom e) '' (Set.range (σ a) ∩ Set.range (σ b)) :=
      ⟨σ a u, ⟨⟨u, rfl⟩, ⟨v, huv.symm⟩⟩, rfl⟩
    obtain ⟨z, ⟨⟨u', hu'⟩, ⟨v', hv'⟩⟩, hz⟩ := (hgen _).mem_open hRim hmem
    have hu'ε : O₁.ι u' = ε := by rw [← hσπ a, Scheme.Hom.comp_apply, hu', hz]
    have hv'ε : O₁.ι v' = ε := by rw [← hσπ b, Scheme.Hom.comp_apply, hv', hz]
    have key := (hstar a u' p hu'ε).symm.trans (hu'.trans (hv'.symm.trans (hstar b v' p hv'ε)))
    rw [hσ0def, hσ0def] at key
    exact hI a b p p key

  have hZc : IsClosed (⋃ a, Set.range (σ a))ᶜ := isClosed_compl_iff.mpr (isOpen_iUnion hσopen)
  have hZε : ∀ z ∈ (⋃ a, Set.range (σ a))ᶜ, Limits.pullback.snd T.hom e z ≠ ε := by
    intro z hz hzε
    obtain ⟨a, p, hap⟩ := hC z hzε
    apply hz
    refine Set.mem_iUnion.mpr ⟨a, ⟨⟨ε, hε₁⟩, ?_⟩⟩
    rw [hstar a ⟨ε, hε₁⟩ p (Scheme.Opens.ι_apply _ _), hσ0def]
    exact hap
  obtain ⟨O', hεO', hO'⟩ := wc_generic_point_avoid_closed_image (Limits.pullback.snd T.hom e) ε
    hgen _ hZc hZε

  have hεO : ε ∈ O₁ ⊓ O' := TopologicalSpace.Opens.mem_inf.mpr ⟨hε₁, hεO'⟩
  obtain ⟨τ, hτdef⟩ : ∃ τ : A → (((O₁ ⊓ O' : E.Opens) : Scheme.{u}) ⟶ Limits.pullback T.hom e),
      ∀ a, τ a = E.homOfLE (inf_le_left : O₁ ⊓ O' ≤ O₁) ≫ σ a := ⟨_, fun a => rfl⟩
  have hτπ : ∀ a, τ a ≫ Limits.pullback.snd T.hom e = (O₁ ⊓ O').ι := by
    intro a
    rw [hτdef, Category.assoc, hσπ a, Scheme.homOfLE_ι]
  have hτdisj : ∀ (a b : A) (u v : ((O₁ ⊓ O' : E.Opens) : Scheme.{u})), τ a u = τ b v → a = b := by
    intro a b u v huv
    rw [hτdef, hτdef, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at huv
    exact hdisj a b _ _ huv
  have hτcov : ∀ z : ↥(Limits.pullback T.hom e), Limits.pullback.snd T.hom e z ∈ O₁ ⊓ O' →
      ∃ (a : A) (u : ((O₁ ⊓ O' : E.Opens) : Scheme.{u})), τ a u = z := by
    intro z hz
    have hzO' : Limits.pullback.snd T.hom e z ∈ O' := (TopologicalSpace.Opens.mem_inf.mp hz).2
    have hzU : z ∈ ⋃ a, Set.range (σ a) := by
      by_contra hne
      exact hO' z hne hzO'
    obtain ⟨a, x, hx⟩ := Set.mem_iUnion.mp hzU
    have hx1 : O₁.ι x = Limits.pullback.snd T.hom e z := by
      rw [← hσπ a, Scheme.Hom.comp_apply, hx]
    refine ⟨a, ⟨Limits.pullback.snd T.hom e z, hz⟩, ?_⟩
    have hx2 : E.homOfLE (inf_le_left : O₁ ⊓ O' ≤ O₁) ⟨Limits.pullback.snd T.hom e z, hz⟩ = x :=
      Subtype.ext (by
        rw [Scheme.homOfLE_apply]
        exact hx1.symm.trans (Scheme.Opens.ι_apply O₁ x))
    rw [hτdef]
    exact (Scheme.Hom.comp_apply _ _ _).trans (by rw [hx2, hx])
  exact ⟨O₁ ⊓ O', _, hεO, wc_etsplits_of_open_sections T e (O₁ ⊓ O') A τ hτπ hτdisj hτcov⟩

theorem wc_galcover_shrink : ∀ {X E : Scheme.{u}} (W₁ : X.Opens) (q : E ⟶ (W₁ : Scheme.{u})) (Γ : Type u) [Group Γ] (α : Γ →* Aut E), wcGalCover q Γ α → ∀ (η : X), η ∈ W₁ → ∀ (O : E.Opens), (∀ e : E, (q ≫ W₁.ι) e = η → e ∈ O) → ∃ (W₂ : X.Opens) (E₂ : Scheme.{u}) (q₂ : E₂ ⟶ (W₂ : Scheme.{u})) (ι₂ : E₂ ⟶ (O : Scheme.{u})) (α₂ : Γ →* Aut E₂), W₂ ≤ W₁ ∧ η ∈ W₂ ∧ IsAffineOpen W₂ ∧ IsOpenImmersion ι₂ ∧ Set.range (ι₂ ≫ O.ι) = (q ≫ W₁.ι) ⁻¹' (W₂ : Set X) ∧ ι₂ ≫ O.ι ≫ q ≫ W₁.ι = q₂ ≫ W₂.ι ∧ wcGalCover q₂ Γ α₂ :=
by
  intro X E W₁ q Γ _ α hq η hη O hO
  obtain ⟨hΓ, hfin, het, hsurj, hα, hΦ⟩ := hq
  have : IsFinite q := hfin
  have : Etale q := het
  have : AlgebraicGeometry.Surjective q := hsurj

  have hKc : IsClosed (q '' (O : Set E)ᶜ) := q.isClosedMap _ O.isOpen.isClosed_compl
  have hηW' : η ∈ (⟨W₁.ι '' (q '' (O : Set E)ᶜ)ᶜ,
      W₁.ι.isOpenEmbedding.isOpenMap _ hKc.isOpen_compl⟩ : X.Opens) := by
    show η ∈ W₁.ι '' (q '' (O : Set E)ᶜ)ᶜ
    refine ⟨(⟨η, hη⟩ : ↥W₁), ?_, Scheme.Opens.ι_apply _ _⟩
    rintro ⟨z, hz, hzk⟩
    apply hz
    apply hO
    rw [Scheme.Hom.comp_apply, hzk, Scheme.Opens.ι_apply]
  obtain ⟨W₂, hW₂aff, hηW₂, hW₂W'⟩ : ∃ W₂ : X.Opens, W₂ ∈ X.affineOpens ∧ η ∈ W₂ ∧
      W₂ ≤ (⟨W₁.ι '' (q '' (O : Set E)ᶜ)ᶜ,
        W₁.ι.isOpenEmbedding.isOpenMap _ hKc.isOpen_compl⟩ : X.Opens) :=
    (TopologicalSpace.Opens.isBasis_iff_nbhd.mp (Scheme.isBasis_affineOpens X)) hηW'
  have hW : W₂ ≤ W₁ := by
    intro x hx
    have hx' : x ∈ W₁.ι '' (q '' (O : Set E)ᶜ)ᶜ := hW₂W' hx
    obtain ⟨k, -, rfl⟩ := hx'
    show W₁.ι k ∈ (W₁ : Set X)
    rw [← Scheme.Opens.range_ι W₁]
    exact ⟨k, rfl⟩
  have hVO : (q ≫ W₁.ι) ⁻¹ᵁ W₂ ≤ O := by
    intro z hz
    rw [Scheme.Hom.mem_preimage] at hz
    have hz' : (q ≫ W₁.ι) z ∈ W₁.ι '' (q '' (O : Set E)ᶜ)ᶜ := hW₂W' hz
    obtain ⟨k, hk, hke⟩ := hz'
    by_contra hzO
    apply hk
    refine ⟨z, hzO, ?_⟩
    apply W₁.ι.isOpenEmbedding.injective
    rw [hke, Scheme.Hom.comp_apply]

  have hinv : ∀ γ, (q ≫ W₁.ι) ⁻¹ᵁ W₂ ≤ (α γ).hom ⁻¹ᵁ ((q ≫ W₁.ι) ⁻¹ᵁ W₂) := by
    intro γ x hx
    rw [Scheme.Hom.mem_preimage, Scheme.Hom.mem_preimage, ← Scheme.Hom.comp_apply,
      ← Category.assoc, hα γ]
    rwa [Scheme.Hom.mem_preimage] at hx
  let r : Γ → ((((q ≫ W₁.ι) ⁻¹ᵁ W₂ : E.Opens) : Scheme.{u}) ⟶
      (((q ≫ W₁.ι) ⁻¹ᵁ W₂ : E.Opens) : Scheme.{u})) :=
    fun γ => (α γ).hom.resLE ((q ≫ W₁.ι) ⁻¹ᵁ W₂) ((q ≫ W₁.ι) ⁻¹ᵁ W₂) (hinv γ)
  have hr : ∀ γ, r γ ≫ ((q ≫ W₁.ι) ⁻¹ᵁ W₂).ι = ((q ≫ W₁.ι) ⁻¹ᵁ W₂).ι ≫ (α γ).hom :=
    fun γ => Scheme.Hom.resLE_comp_ι (α γ).hom (hinv γ)
  have hmulα : ∀ γ δ, (α δ).hom ≫ (α γ).hom = (α (γ * δ)).hom := by
    intro γ δ
    rw [map_mul, Aut.Aut_mul_def]
    rfl
  have hrmul : ∀ γ δ, r δ ≫ r γ = r (γ * δ) := by
    intro γ δ
    rw [← cancel_mono ((q ≫ W₁.ι) ⁻¹ᵁ W₂).ι, Category.assoc, hr γ, reassoc_of% (hr δ),
      hmulα, hr (γ * δ)]
  have hr1 : r 1 = 𝟙 _ := by
    rw [← cancel_mono ((q ≫ W₁.ι) ⁻¹ᵁ W₂).ι, hr, map_one, Category.id_comp]
    exact Category.comp_id _
  let α₂ : Γ →* Aut (((q ≫ W₁.ι) ⁻¹ᵁ W₂ : E.Opens) : Scheme.{u}) :=
    MonoidHom.mk' (fun γ => ⟨r γ, r γ⁻¹, by rw [hrmul, inv_mul_cancel, hr1],
      by rw [hrmul, mul_inv_cancel, hr1]⟩) (by
        intro γ δ
        apply Iso.ext
        show r (γ * δ) = r δ ≫ r γ
        exact (hrmul γ δ).symm)
  have hH : ∀ γ, (α₂ γ).hom ≫ ((q ≫ W₁.ι) ⁻¹ᵁ W₂).ι = ((q ≫ W₁.ι) ⁻¹ᵁ W₂).ι ≫ (α γ).hom :=
    fun γ => hr γ

  have hc : (q ≫ W₁.ι) ∣_ W₂ ≫ X.homOfLE hW = ((q ≫ W₁.ι) ⁻¹ᵁ W₂).ι ≫ q := by
    rw [← cancel_mono W₁.ι]
    simp only [Category.assoc, Scheme.homOfLE_ι, morphismRestrict_ι]
  have hPB : IsPullback ((q ≫ W₁.ι) ∣_ W₂) ((q ≫ W₁.ι) ⁻¹ᵁ W₂).ι (X.homOfLE hW) q := by
    refine IsPullback.of_bot (v₂₁ := 𝟙 E) (v₂₂ := W₁.ι) (h₃₁ := q ≫ W₁.ι) ?_ hc ?_
    · rw [Category.comp_id, Scheme.homOfLE_ι]
      exact isPullback_morphismRestrict _ _
    · exact IsPullback.of_vert_isIso_mono ⟨(Category.id_comp _).symm⟩
  have hfin₂ : IsFinite ((q ≫ W₁.ι) ∣_ W₂) :=
    MorphismProperty.of_isPullback (P := @IsFinite) hPB.flip hfin
  have het₂ : Etale ((q ≫ W₁.ι) ∣_ W₂) :=
    MorphismProperty.of_isPullback (P := @Etale) hPB.flip het
  have hsurj₂ : AlgebraicGeometry.Surjective ((q ≫ W₁.ι) ∣_ W₂) :=
    MorphismProperty.of_isPullback (P := @AlgebraicGeometry.Surjective) hPB.flip hsurj
  have hα₂ : ∀ γ, (α₂ γ).hom ≫ (q ≫ W₁.ι) ∣_ W₂ = (q ≫ W₁.ι) ∣_ W₂ := by
    intro γ
    rw [← cancel_mono W₂.ι]
    simp only [Category.assoc, morphismRestrict_ι]
    rw [reassoc_of% (hH γ), reassoc_of% (hα γ)]

  obtain ⟨Φ, hΦdef⟩ : ∃ Φ : ∐ (fun _ : Γ => E) ⟶ Limits.pullback q q,
      Φ = Limits.Sigma.desc (fun γ : Γ => Limits.pullback.lift (α γ).hom (𝟙 E)
        ((hα γ).trans (Category.id_comp q).symm)) := ⟨_, rfl⟩
  rw [← hΦdef] at hΦ
  have hιΦ : ∀ γ, Limits.Sigma.ι (fun _ : Γ => E) γ ≫ Φ = Limits.pullback.lift (α γ).hom (𝟙 E)
      ((hα γ).trans (Category.id_comp q).symm) := by
    intro γ
    rw [hΦdef, Limits.Sigma.ι_comp_desc]
  obtain ⟨m, hmdef⟩ : ∃ m : Limits.pullback ((q ≫ W₁.ι) ∣_ W₂) ((q ≫ W₁.ι) ∣_ W₂) ⟶
      Limits.pullback q q, m = Limits.pullback.map ((q ≫ W₁.ι) ∣_ W₂) ((q ≫ W₁.ι) ∣_ W₂) q q
        ((q ≫ W₁.ι) ⁻¹ᵁ W₂).ι ((q ≫ W₁.ι) ⁻¹ᵁ W₂).ι (X.homOfLE hW) hc hc := ⟨_, rfl⟩
  have hmopen : IsOpenImmersion m := by
    rw [hmdef, Limits.pullback_map_eq_pullbackFstFstIso_inv]
    infer_instance
  have hmfst : m ≫ Limits.pullback.fst q q =
      Limits.pullback.fst ((q ≫ W₁.ι) ∣_ W₂) ((q ≫ W₁.ι) ∣_ W₂) ≫ ((q ≫ W₁.ι) ⁻¹ᵁ W₂).ι := by
    rw [hmdef]
    exact Limits.pullback.lift_fst _ _ _
  have hmsnd : m ≫ Limits.pullback.snd q q =
      Limits.pullback.snd ((q ≫ W₁.ι) ∣_ W₂) ((q ≫ W₁.ι) ∣_ W₂) ≫ ((q ≫ W₁.ι) ⁻¹ᵁ W₂).ι := by
    rw [hmdef]
    exact Limits.pullback.lift_snd _ _ _
  obtain ⟨Φ₂, hΦ₂def⟩ : ∃ Φ₂ : ∐ (fun _ : Γ => (((q ≫ W₁.ι) ⁻¹ᵁ W₂ : E.Opens) : Scheme.{u})) ⟶
      Limits.pullback ((q ≫ W₁.ι) ∣_ W₂) ((q ≫ W₁.ι) ∣_ W₂),
      Φ₂ = Limits.Sigma.desc (fun γ : Γ => Limits.pullback.lift (α₂ γ).hom (𝟙 _)
        ((hα₂ γ).trans (Category.id_comp _).symm)) := ⟨_, rfl⟩
  have hD : Φ₂ ≫ m = Limits.Sigma.desc (fun γ : Γ =>
      ((q ≫ W₁.ι) ⁻¹ᵁ W₂).ι ≫ Limits.Sigma.ι (fun _ : Γ => E) γ ≫ Φ) := by
    apply Limits.Sigma.hom_ext
    intro γ
    rw [hΦ₂def]
    simp only [Limits.Sigma.ι_comp_desc_assoc, Limits.Sigma.ι_comp_desc]
    rw [hιΦ]
    apply Limits.pullback.hom_ext
    · simp only [Category.assoc, hmfst, Limits.pullback.lift_fst, Limits.pullback.lift_fst_assoc]
      exact hH γ
    · simp only [Category.assoc, hmsnd, Limits.pullback.lift_snd, Limits.pullback.lift_snd_assoc,
        Category.id_comp, Category.comp_id]
  have hΦinj : Function.Injective Φ := Φ.isOpenEmbedding.injective
  have hdisj : Pairwise (Function.onFun Disjoint fun γ : Γ =>
      Set.range ⇑(((q ≫ W₁.ι) ⁻¹ᵁ W₂).ι ≫ Limits.Sigma.ι (fun _ : Γ => E) γ ≫ Φ)) := by
    intro γ δ hγδ
    have h0 := disjoint_opensRange_sigmaι (fun _ : Γ => E) γ δ hγδ
    show Disjoint (Set.range _) (Set.range _)
    rw [Set.disjoint_left]
    rintro _ ⟨x, rfl⟩ ⟨y, hy⟩
    simp only [Scheme.Hom.comp_apply] at hy
    have hxy := hΦinj hy
    have hp1 : Limits.Sigma.ι (fun _ : Γ => E) γ (((q ≫ W₁.ι) ⁻¹ᵁ W₂).ι x) ∈
        (Limits.Sigma.ι (fun _ : Γ => E) γ).opensRange :=
      Scheme.Hom.mem_opensRange.mpr ⟨_, rfl⟩
    have hp2 : Limits.Sigma.ι (fun _ : Γ => E) γ (((q ≫ W₁.ι) ⁻¹ᵁ W₂).ι x) ∈
        (Limits.Sigma.ι (fun _ : Γ => E) δ).opensRange :=
      Scheme.Hom.mem_opensRange.mpr ⟨_, hxy⟩
    have h3 := h0.le_bot (TopologicalSpace.Opens.mem_inf.mpr ⟨hp1, hp2⟩)
    simp at h3
  have hΦ₂open : IsOpenImmersion Φ₂ := by
    have : IsOpenImmersion (Φ₂ ≫ m) := by
      rw [hD]
      exact isOpenImmersion_sigmaDesc _ _ hdisj
    exact IsOpenImmersion.of_comp Φ₂ m
  have hminj : Function.Injective m := m.isOpenEmbedding.injective
  have hsurjΦ₂ : Function.Surjective Φ₂ := by
    intro p
    obtain ⟨t, ht⟩ := (AlgebraicGeometry.Surjective.surj (f := Φ)) (m p)
    obtain ⟨⟨γ, x⟩, rfl⟩ := (sigmaMk (fun _ : Γ => E)).surjective t
    rw [sigmaMk_mk] at ht
    have ha : Limits.Sigma.ι (fun _ : Γ => E) γ ≫ Φ ≫ Limits.pullback.snd q q = 𝟙 E := by
      rw [reassoc_of% (hιΦ γ), Limits.pullback.lift_snd]
    obtain ⟨y, hy⟩ : ∃ y, y = (Limits.pullback.snd ((q ≫ W₁.ι) ∣_ W₂) ((q ≫ W₁.ι) ∣_ W₂)) p :=
      ⟨_, rfl⟩
    have hx : x = ((q ≫ W₁.ι) ⁻¹ᵁ W₂).ι y := by
      calc x = (Limits.Sigma.ι (fun _ : Γ => E) γ ≫ Φ ≫ Limits.pullback.snd q q) x := by
            rw [ha]; rfl
        _ = (m ≫ Limits.pullback.snd q q) p := by
            simp only [Scheme.Hom.comp_apply, ht]
        _ = ((q ≫ W₁.ι) ⁻¹ᵁ W₂).ι y := by
            rw [hmsnd, Scheme.Hom.comp_apply, hy]
    refine ⟨Limits.Sigma.ι (fun _ : Γ => (((q ≫ W₁.ι) ⁻¹ᵁ W₂ : E.Opens) : Scheme.{u})) γ y, ?_⟩
    apply hminj
    calc m (Φ₂ (Limits.Sigma.ι (fun _ : Γ => (((q ≫ W₁.ι) ⁻¹ᵁ W₂ : E.Opens) : Scheme.{u})) γ y))
        = (Limits.Sigma.ι (fun _ : Γ => (((q ≫ W₁.ι) ⁻¹ᵁ W₂ : E.Opens) : Scheme.{u})) γ ≫
            Φ₂ ≫ m) y := by
          simp only [Scheme.Hom.comp_apply]
      _ = (((q ≫ W₁.ι) ⁻¹ᵁ W₂).ι ≫ Limits.Sigma.ι (fun _ : Γ => E) γ ≫ Φ) y := by
          rw [hD, Limits.Sigma.ι_comp_desc]
      _ = Φ (Limits.Sigma.ι (fun _ : Γ => E) γ x) := by
          rw [hx]
          simp only [Scheme.Hom.comp_apply]
      _ = m p := ht
  have hisoΦ₂ : IsIso Φ₂ :=
    (isIso_iff_isOpenImmersion_and_surjective Φ₂).mpr ⟨hΦ₂open, ⟨hsurjΦ₂⟩⟩
  rw [hΦ₂def] at hisoΦ₂

  refine ⟨W₂, ((q ≫ W₁.ι) ⁻¹ᵁ W₂ : E.Opens), (q ≫ W₁.ι) ∣_ W₂, E.homOfLE hVO, α₂, hW, hηW₂,
    hW₂aff, inferInstance, ?_, ?_, ⟨hΓ, hfin₂, het₂, hsurj₂, hα₂, hisoΦ₂⟩⟩
  · rw [Scheme.homOfLE_ι, Scheme.Opens.range_ι, Scheme.Hom.coe_preimage]
  · rw [← Category.assoc, Scheme.homOfLE_ι, morphismRestrict_ι]

theorem wc_et_generic_galois_split (K : Type u) [Field K] (X : Scheme.{u}) (f : X ⟶ Spec (.of K))
    [IsProper f] (hX : Nonempty X) (U V : X.Etale) (hU : CompactSpace U.left)
    (hU' : QuasiSeparatedSpace U.left) (hV : CompactSpace V.left)
    (hV' : QuasiSeparatedSpace V.left) :
    ∃ (W₁ : X.Opens) (E : Scheme.{u}) (q : E ⟶ (W₁ : Scheme.{u})) (Γ : Type u) (_ : Group Γ)
      (α : Γ →* Aut E) (A B : Type u) (a : A → (E ⟶ U.left)) (b : B → (E ⟶ V.left)),
      (W₁ : Set X).Nonempty ∧ IsAffineOpen W₁ ∧ IsAffine E ∧ ConnectedSpace E ∧
      wcGalCover q Γ α ∧ wcEtSplits (q ≫ W₁.ι) U A a ∧ wcEtSplits (q ≫ W₁.ι) V B b :=
by
  classical
  haveI hcX : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace f
  haveI hqsX : QuasiSeparatedSpace X := quasiSeparatedSpace_of_quasiSeparated f
  haveI hlnX : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian f
  haveI : IsNoetherian X := {}
  haveI : TopologicalSpace.NoetherianSpace X := inferInstance

  obtain ⟨x⟩ := hX
  have hopen : ∃ o : Set X, IsOpen o ∧ o.Nonempty ∧ o ⊆ irreducibleComponent x := by
    have hS : (irreducibleComponents X \ {irreducibleComponent x}).Finite :=
      TopologicalSpace.NoetherianSpace.finite_irreducibleComponents.sdiff
    have hTc : IsClosed (⋃₀ (irreducibleComponents X \ {irreducibleComponent x})) := by
      rw [Set.sUnion_eq_biUnion]
      exact hS.isClosed_biUnion (fun Z' hZ' => isClosed_of_mem_irreducibleComponents Z' hZ'.1)
    refine ⟨(⋃₀ (irreducibleComponents X \ {irreducibleComponent x}))ᶜ, hTc.isOpen_compl, ?_, ?_⟩
    · by_contra hne
      rw [Set.not_nonempty_iff_eq_empty, Set.compl_empty_iff] at hne
      have hsub : irreducibleComponent x ⊆ ⋃₀ ↑hS.toFinset := by
        rw [hS.coe_toFinset, hne]; exact Set.subset_univ _
      obtain ⟨Z', hZ', hZZ'⟩ := (isIrreducible_iff_sUnion_isClosed.mp
        (isIrreducible_irreducibleComponent (x := x))) hS.toFinset
        (fun z hz => isClosed_of_mem_irreducibleComponents z ((hS.mem_toFinset).mp hz).1) hsub
      rw [hS.mem_toFinset] at hZ'
      have heq := (irreducibleComponent_mem_irreducibleComponents x).eq_of_le hZ'.1.prop hZZ'
      exact hZ'.2 (Set.mem_singleton_iff.mpr heq.symm)
    · intro w hw
      by_contra hwZ
      apply hw
      refine ⟨irreducibleComponent w, ⟨irreducibleComponent_mem_irreducibleComponents w, ?_⟩,
        mem_irreducibleComponent⟩
      intro h
      exact hwZ ((Set.mem_singleton_iff.mp h) ▸ mem_irreducibleComponent)
  obtain ⟨o, ho, ⟨y, hy⟩, hoZ⟩ := hopen
  obtain ⟨W₀, hW₀aff, hyW₀, hW₀o⟩ :=
    (TopologicalSpace.Opens.isBasis_iff_nbhd.mp (Scheme.isBasis_affineOpens X))
      (show y ∈ (⟨o, ho⟩ : X.Opens) from hy)
  obtain ⟨η, hη⟩ := QuasiSober.sober (isIrreducible_irreducibleComponent (x := x))
    isClosed_irreducibleComponent
  have hηW₀ : η ∈ W₀ := (hη.mem_open_set_iff W₀.isOpen).mpr ⟨y, hoZ hy, hyW₀⟩
  have hηgen : ∀ w ∈ W₀, η ⤳ w := fun w hw => hη.specializes (hoZ (hW₀o hw))

  obtain ⟨L, _, _, _, _, A, B, a, b, ha, hb⟩ := wc_ggs_galois_field_split X η U V hU hU' hV hV'

  obtain ⟨W₁, E, q, Γ, _, α, ε, g, -, hηW₁, -, -, hEln, hq, hεgen, hεη, hfib, hg⟩ :=
    wc_ggs_galois_spread X W₀ hW₀aff η hηW₀ hηgen L
  haveI := hEln

  have ha1 := wc_etsplits_base_change _ U A a ha g
  rw [hg] at ha1
  have hb1 := wc_etsplits_base_change _ V B b hb g
  rw [hg] at hb1

  obtain ⟨OU, aU, hεOU, haU⟩ := wc_etsplits_spread_generic U hU (q ≫ W₁.ι) ε hεgen A _ ha1
  obtain ⟨OV, bV, hεOV, hbV⟩ := wc_etsplits_spread_generic V hV (q ≫ W₁.ι) ε hεgen B _ hb1
  have haO := wc_etsplits_base_change _ U A aU haU (E.homOfLE (inf_le_left : OU ⊓ OV ≤ OU))
  rw [← Category.assoc, Scheme.homOfLE_ι] at haO
  have hbO := wc_etsplits_base_change _ V B bV hbV (E.homOfLE (inf_le_right : OU ⊓ OV ≤ OV))
  rw [← Category.assoc, Scheme.homOfLE_ι] at hbO

  obtain ⟨W₂, E₂, q₂, ι₂, α₂, -, hηW₂, hW₂aff, hι₂, hrange, hcomp, hq₂⟩ :=
    wc_galcover_shrink W₁ q Γ α hq η hηW₁ (OU ⊓ OV) (fun z hz => by
      rw [hfib z hz]; exact TopologicalSpace.Opens.mem_inf.mpr ⟨hεOU, hεOV⟩)
  have ha2 := wc_etsplits_base_change _ U A _ haO ι₂
  rw [hcomp] at ha2
  have hb2 := wc_etsplits_base_change _ V B _ hbO ι₂
  rw [hcomp] at hb2
  haveI : IsAffine (W₂ : Scheme.{u}) := hW₂aff
  haveI : IsFinite q₂ := hq₂.2.1
  haveI : IsAffine E₂ := isAffine_of_isAffineHom q₂
  haveI : IsOpenImmersion ι₂ := hι₂
  have hconn : ConnectedSpace E₂ := by
    have hmem : ε ∈ Set.range (ι₂ ≫ (OU ⊓ OV).ι) := by
      rw [hrange, Set.mem_preimage, hεη]
      exact hηW₂
    obtain ⟨ε₂, hε₂⟩ := hmem
    have hemb := (ι₂ ≫ (OU ⊓ OV).ι).isOpenEmbedding
    have hsp : ∀ z : E₂, ε₂ ⤳ z := fun z => by
      have h1 := hεgen ((ι₂ ≫ (OU ⊓ OV).ι) z)
      rw [← hε₂] at h1
      exact hemb.isInducing.specializes_iff.mp h1
    have huniv : closure ({ε₂} : Set E₂) = Set.univ := by
      ext z
      simp only [Set.mem_univ, iff_true]
      exact specializes_iff_mem_closure.mp (hsp z)
    have hirr : IsIrreducible (Set.univ : Set E₂) := huniv ▸ isIrreducible_singleton.closure
    exact connectedSpace_iff_univ.mpr hirr.isConnected
  exact ⟨W₂, E₂, q₂, Γ, inferInstance, α₂, A, B, _, _, ⟨η, hηW₂⟩, hW₂aff, inferInstance, hconn,
    hq₂, ha2, hb2⟩

theorem wc_affine_galois_ring_data : ∀ {W E : Scheme.{u}} [IsAffine W] [IsAffine E] (q : E ⟶ W)
    (G : Type u) [Group G] (α : G →* Aut E) [IsFinite q] [Etale q] [AlgebraicGeometry.Surjective q],
    (∀ γ, (α γ).hom ≫ q = q) → ∀ [Algebra Γ(W, ⊤) Γ(E, ⊤)], algebraMap Γ(W, ⊤) Γ(E, ⊤) = q.appTop.hom →
    ∃ τ : G → (Γ(E, ⊤) →ₐ[Γ(W, ⊤)] Γ(E, ⊤)), (∀ γ b, τ γ b = (α γ).hom.appTop.hom b) ∧
      (∀ γ δ, τ (γ * δ) = (τ δ).comp (τ γ)) ∧ Algebra.Etale Γ(W, ⊤) Γ(E, ⊤) ∧
      Module.Finite Γ(W, ⊤) Γ(E, ⊤) ∧ Module.FaithfullyFlat Γ(W, ⊤) Γ(E, ⊤) :=
by
  intro W E _ _ q G _ α _ _ _ hα _ hA
  have hc : ∀ γ r, (α γ).hom.appTop.hom (algebraMap Γ(W, ⊤) Γ(E, ⊤) r) =
      algebraMap Γ(W, ⊤) Γ(E, ⊤) r := by
    intro γ r
    rw [hA]
    have h1 := congrArg (fun φ : E ⟶ W => φ.appTop.hom r) (hα γ)
    simpa only [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply] using h1
  let τ : G → (Γ(E, ⊤) →ₐ[Γ(W, ⊤)] Γ(E, ⊤)) := fun γ =>
    { toRingHom := (α γ).hom.appTop.hom, commutes' := hc γ }
  have hEt : Algebra.Etale Γ(W, ⊤) Γ(E, ⊤) := by
    have h := HasRingHomProperty.appTop @Etale q ‹Etale q›
    rw [← hA] at h
    exact RingHom.etale_algebraMap.mp h
  have hFin : Module.Finite Γ(W, ⊤) Γ(E, ⊤) := by
    have h : (q.appTop.hom).Finite := IsFinite.finite_app q ⊤ (isAffineOpen_top W)
    rw [← hA] at h
    exact RingHom.finite_algebraMap.mp h
  have hsurj : Function.Surjective (PrimeSpectrum.comap (algebraMap Γ(W, ⊤) Γ(E, ⊤))) := by
    haveI : AlgebraicGeometry.Surjective (E.isoSpec.hom ≫ Spec.map q.appTop) := by
      rw [Scheme.isoSpec_hom_naturality]; infer_instance
    haveI := AlgebraicGeometry.Surjective.of_comp E.isoSpec.hom (Spec.map q.appTop)
    have h2 := (surjective_iff (Spec.map q.appTop)).mp inferInstance
    intro x
    obtain ⟨y, hy⟩ := h2 x
    refine ⟨y, ?_⟩
    rw [hA]
    rw [Spec.map_apply] at hy
    exact hy
  haveI := hEt
  have hFF : Module.FaithfullyFlat Γ(W, ⊤) Γ(E, ⊤) := by
    have hfl : (algebraMap Γ(W, ⊤) Γ(E, ⊤)).Flat := RingHom.flat_algebraMap_iff.mpr inferInstance
    exact RingHom.faithfullyFlat_algebraMap_iff.mp
      (RingHom.FaithfullyFlat.iff_flat_and_comap_surjective.mpr ⟨hfl, hsurj⟩)
  refine ⟨τ, fun _ _ => rfl, ?_, hEt, hFin, hFF⟩
  intro γ δ
  ext b
  show (α (γ * δ)).hom.appTop.hom b = (α δ).hom.appTop.hom ((α γ).hom.appTop.hom b)
  rw [map_mul]
  change (Scheme.Hom.appTop ((α δ).hom ≫ (α γ).hom)).hom b = _
  rw [Scheme.Hom.comp_appTop, CommRingCat.comp_apply]

theorem wc_sigma_lift_isIso_iff_isPullback : ∀ {P Q E : Scheme.{u}} (f : Q ⟶ P) (e : E ⟶ P)
    (I : Type v) [Finite I] (s : I → (E ⟶ Q)) (hs : ∀ i, s i ≫ f = 𝟙 E ≫ e),
    IsIso (Limits.Sigma.desc (fun i => Limits.pullback.lift (s i) (𝟙 E) (hs i)) :
      ∐ (fun _ : I => E) ⟶ Limits.pullback f e) ↔
    IsPullback (Limits.Sigma.desc s) (Limits.Sigma.desc fun _ : I => 𝟙 E) f e :=
by
  intro P Q E f e I _ s hs
  have ha : (Limits.Sigma.desc (fun i => Limits.pullback.lift (s i) (𝟙 E) (hs i)) :
      ∐ (fun _ : I => E) ⟶ Limits.pullback f e) ≫ Limits.pullback.fst f e =
      Limits.Sigma.desc s := by
    apply Limits.Sigma.hom_ext
    intro b
    rw [Limits.Sigma.ι_comp_desc_assoc, Limits.pullback.lift_fst, Limits.Sigma.ι_comp_desc]
  have hb : (Limits.Sigma.desc (fun i => Limits.pullback.lift (s i) (𝟙 E) (hs i)) :
      ∐ (fun _ : I => E) ⟶ Limits.pullback f e) ≫ Limits.pullback.snd f e =
      Limits.Sigma.desc (fun _ : I => 𝟙 E) := by
    apply Limits.Sigma.hom_ext
    intro b
    rw [Limits.Sigma.ι_comp_desc_assoc, Limits.pullback.lift_snd, Limits.Sigma.ι_comp_desc]
  have hc : CommSq (Limits.Sigma.desc s) (Limits.Sigma.desc fun _ : I => 𝟙 E) f e := by
    constructor
    rw [← ha, ← hb, Category.assoc, Category.assoc, Limits.pullback.condition]
  constructor
  · intro hiso
    exact IsPullback.of_iso_pullback hc (@asIso _ _ _ _ _ hiso) ha hb
  · intro h
    have hψ : h.isoPullback.hom =
        (Limits.Sigma.desc (fun i => Limits.pullback.lift (s i) (𝟙 E) (hs i)) :
          ∐ (fun _ : I => E) ⟶ Limits.pullback f e) := by
      apply Limits.pullback.hom_ext
      · rw [IsPullback.isoPullback_hom_fst, ha]
      · rw [IsPullback.isoPullback_hom_snd, hb]
    rw [← hψ]
    infer_instance

theorem wc_affine_sigma_isPullback_iff_bijective : ∀ (R S T : Type u) [CommRing R] [CommRing S]
    [CommRing T] [Algebra R S] [Algebra R T] (I : Type v) [Finite I] (μ : I → (S →ₐ[R] T))
    (P Q E : Scheme.{u}) (eP : P ≅ Spec (.of R)) (eQ : Q ≅ Spec (.of S)) (eE : E ≅ Spec (.of T))
    (f : Q ⟶ P) (e : E ⟶ P) (s : I → (E ⟶ Q)),
    f ≫ eP.hom = eQ.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap R S)) →
    e ≫ eP.hom = eE.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap R T)) →
    (∀ i, s i ≫ eQ.hom = eE.hom ≫ Spec.map (CommRingCat.ofHom (μ i : S →+* T))) →
    (IsPullback (Limits.Sigma.desc s) (Limits.Sigma.desc fun _ : I => 𝟙 E) f e ↔
      Function.Bijective (Algebra.TensorProduct.productMap (AlgHom.pi μ)
        (AlgHom.pi fun _ : I => AlgHom.id R T))) :=
by
  intro R S T _ _ _ _ _ I _ μ P Q E eP eQ eE f e s hf he hs
  classical
  obtain ⟨φ, hφ⟩ : ∃ φ : TensorProduct R S T →ₐ[R] (I → T), φ =
      Algebra.TensorProduct.productMap (AlgHom.pi μ) (AlgHom.pi fun _ : I => AlgHom.id R T) :=
    ⟨_, rfl⟩
  rw [← hφ]

  have hStd := isPullback_SpecMap_of_isPushout _ _ _ _ (CommRingCat.isPushout_tensorProduct R S T)
  have hP' : IsPullback
      (Spec.map (CommRingCat.ofHom
        (Algebra.TensorProduct.includeLeftRingHom : S →+* TensorProduct R S T)) ≫ eQ.inv)
      (Spec.map (CommRingCat.ofHom
        (Algebra.TensorProduct.includeRight : T →ₐ[R] TensorProduct R S T).toRingHom) ≫ eE.inv)
      f e := by
    refine IsPullback.of_iso hStd (Iso.refl _) eQ.symm eE.symm eP.symm ?_ ?_ ?_ ?_
    · rw [Iso.refl_hom, Category.id_comp, Iso.symm_hom]
    · rw [Iso.refl_hom, Category.id_comp, Iso.symm_hom]
    · rw [Iso.symm_hom, Iso.symm_hom, Iso.eq_inv_comp, ← Category.assoc, ← hf, Category.assoc,
        Iso.hom_inv_id, Category.comp_id]
    · rw [Iso.symm_hom, Iso.symm_hom, Iso.eq_inv_comp, ← Category.assoc, ← he, Category.assoc,
        Iso.hom_inv_id, Category.comp_id]

  obtain ⟨c, hc⟩ : ∃ c : (∐ fun _ : I => E) ⟶ Spec (CommRingCat.of (TensorProduct R S T)),
      c = Limits.Sigma.desc fun i => eE.hom ≫ Spec.map (CommRingCat.ofHom
        ((Pi.evalRingHom (fun _ : I => T) i).comp (φ : TensorProduct R S T →+* (I → T)))) :=
    ⟨_, rfl⟩
  have h1 : ∀ i, CommRingCat.ofHom
      (Algebra.TensorProduct.includeLeftRingHom : S →+* TensorProduct R S T) ≫
      CommRingCat.ofHom ((Pi.evalRingHom (fun _ : I => T) i).comp
        (φ : TensorProduct R S T →+* (I → T))) = CommRingCat.ofHom (μ i : S →+* T) := by
    intro i
    ext x
    simp [hφ, Algebra.TensorProduct.productMap_apply_tmul]
  have h2 : ∀ i, CommRingCat.ofHom
      (Algebra.TensorProduct.includeRight : T →ₐ[R] TensorProduct R S T).toRingHom ≫
      CommRingCat.ofHom ((Pi.evalRingHom (fun _ : I => T) i).comp
        (φ : TensorProduct R S T →+* (I → T))) = 𝟙 _ := by
    intro i
    ext x
    simp [hφ, Algebra.TensorProduct.productMap_apply_tmul]
  have hc1 : c ≫ (Spec.map (CommRingCat.ofHom
        (Algebra.TensorProduct.includeLeftRingHom : S →+* TensorProduct R S T)) ≫ eQ.inv) =
      Limits.Sigma.desc s := by
    refine Limits.Sigma.hom_ext _ _ (fun i => ?_)
    rw [hc, Limits.Sigma.ι_comp_desc_assoc, Limits.Sigma.ι_comp_desc, Category.assoc,
      ← Category.assoc (Spec.map _), ← Spec.map_comp, h1 i, ← Category.assoc, ← hs i,
      Category.assoc, Iso.hom_inv_id, Category.comp_id]
  have hc2 : c ≫ (Spec.map (CommRingCat.ofHom
        (Algebra.TensorProduct.includeRight : T →ₐ[R] TensorProduct R S T).toRingHom) ≫ eE.inv) =
      Limits.Sigma.desc fun _ : I => 𝟙 E := by
    refine Limits.Sigma.hom_ext _ _ (fun i => ?_)
    rw [hc, Limits.Sigma.ι_comp_desc_assoc, Limits.Sigma.ι_comp_desc, Category.assoc,
      ← Category.assoc (Spec.map _), ← Spec.map_comp, h2 i, Spec.map_id, Category.id_comp,
      Iso.hom_inv_id]

  have key : IsPullback (Limits.Sigma.desc s) (Limits.Sigma.desc fun _ : I => 𝟙 E) f e ↔
      IsIso c := by
    constructor
    · intro hP
      have hci : c = (IsPullback.isoIsPullback Q E hP hP').hom :=
        hP'.hom_ext (by rw [hc1, IsPullback.isoIsPullback_hom_fst])
          (by rw [hc2, IsPullback.isoIsPullback_hom_snd])
      rw [hci]
      infer_instance
    · intro hiso
      refine IsPullback.of_iso hP' (asIso c).symm (Iso.refl _) (Iso.refl _) (Iso.refl _)
        ?_ ?_ ?_ ?_
      · rw [Iso.refl_hom, Category.comp_id, Iso.symm_hom, asIso_inv, ← hc1,
          IsIso.inv_hom_id_assoc]
      · rw [Iso.refl_hom, Category.comp_id, Iso.symm_hom, asIso_inv, ← hc2,
          IsIso.inv_hom_id_assoc]
      · rw [Iso.refl_hom, Iso.refl_hom, Category.comp_id, Category.id_comp]
      · rw [Iso.refl_hom, Iso.refl_hom, Category.comp_id, Category.id_comp]

  have ε : ULift.{u} (Fin (Nat.card I)) ≃ I := Equiv.ulift.trans (Finite.equivFin I).symm
  obtain ⟨ψ', hψ'⟩ : ∃ ψ' : TensorProduct R S T →+* (ULift.{u} (Fin (Nat.card I)) → T),
      ψ' = RingHom.pi fun j => (Pi.evalRingHom (fun _ : I => T) (ε j)).comp
        (φ : TensorProduct R S T →+* (I → T)) := ⟨_, rfl⟩
  obtain ⟨M, hM⟩ : ∃ M : (∐ fun _ : I => E) ⟶
      ∐ fun _ : ULift.{u} (Fin (Nat.card I)) => Spec (CommRingCat.of T),
      M = Limits.Sigma.desc fun i => eE.hom ≫
        Limits.Sigma.ι (fun _ : ULift.{u} (Fin (Nat.card I)) => Spec (CommRingCat.of T))
          (ε.symm i) := ⟨_, rfl⟩
  obtain ⟨N, hN⟩ : ∃ N : (∐ fun _ : ULift.{u} (Fin (Nat.card I)) => Spec (CommRingCat.of T)) ⟶
      (∐ fun _ : I => E),
      N = Limits.Sigma.desc fun j => eE.inv ≫ Limits.Sigma.ι (fun _ : I => E) (ε j) :=
    ⟨_, rfl⟩
  have hMiso : IsIso M := by
    refine ⟨⟨N, ?_, ?_⟩⟩
    · refine Limits.Sigma.hom_ext _ _ (fun i => ?_)
      rw [hM, hN, Limits.Sigma.ι_comp_desc_assoc, Category.assoc, Limits.Sigma.ι_comp_desc,
        Iso.hom_inv_id_assoc, Equiv.apply_symm_apply, Category.comp_id]
    · refine Limits.Sigma.hom_ext _ _ (fun j => ?_)
      rw [hM, hN, Limits.Sigma.ι_comp_desc_assoc, Category.assoc, Limits.Sigma.ι_comp_desc,
        Iso.inv_hom_id_assoc, Equiv.symm_apply_apply, Category.comp_id]
  have hσ : IsIso (sigmaSpec (fun _ : ULift.{u} (Fin (Nat.card I)) => CommRingCat.of T)) :=
    inferInstance
  have hcf : c = M ≫ sigmaSpec (fun _ : ULift.{u} (Fin (Nat.card I)) => CommRingCat.of T) ≫
      Spec.map (CommRingCat.ofHom ψ') := by
    refine Limits.Sigma.hom_ext _ _ (fun i => ?_)
    rw [hc, hM, Limits.Sigma.ι_comp_desc, Limits.Sigma.ι_comp_desc_assoc, Category.assoc,
      ι_sigmaSpec_assoc, ← Spec.map_comp]
    congr 2
    refine CommRingCat.hom_ext (RingHom.ext fun x => ?_)
    simp [hψ']
  rw [key, hcf, isIso_comp_left_iff, isIso_comp_left_iff, isIso_SpecMap_iff,
    CommRingCat.hom_ofHom]
  have hfun : ⇑ψ' = (Equiv.arrowCongr ε.symm (Equiv.refl T)) ∘
      ⇑(φ : TensorProduct R S T →+* (I → T)) := by
    funext x j
    simp [hψ', Equiv.arrowCongr_apply]
  rw [hfun, Equiv.comp_bijective]
  rfl

theorem wc_galois_tensor_invariants_split : ∀ (A B : Type u) [CommRing A] [CommRing B] [Algebra A B]
    [Module.Flat A B] (G : Type u) [Group G] [Finite G] (τ : G → (B →ₐ[A] B)),
    (∀ γ δ, τ (γ * δ) = (τ δ).comp (τ γ)) →
    Function.Bijective (Algebra.TensorProduct.productMap (AlgHom.pi τ)
      (AlgHom.pi fun _ : G => AlgHom.id A B)) →
    ∀ (H : Subgroup G) (d : ℕ) (g : Fin d → G), (∀ γ : G, ∃! i : Fin d, γ * (g i)⁻¹ ∈ H) →
    ∀ (C : Subalgebra A B), (∀ b : B, b ∈ C ↔ ∀ h ∈ H, τ h b = b) →
    Function.Bijective (Algebra.TensorProduct.productMap
      (AlgHom.pi fun i : Fin d => (τ (g i)).comp C.val)
      (AlgHom.pi fun _ : Fin d => AlgHom.id A B)) :=
by
  intro A B _ _ _ _ G _ _ τ hτ hΦ H d g hg C hC
  classical
  haveI : Fintype H := Fintype.ofFinite H
  set Φ := Algebra.TensorProduct.productMap (AlgHom.pi τ)
      (AlgHom.pi fun _ : G => AlgHom.id A B) with hΦdef
  set χ := Algebra.TensorProduct.productMap
      (AlgHom.pi fun i : Fin d => (τ (g i)).comp C.val)
      (AlgHom.pi fun _ : Fin d => AlgHom.id A B) with hχdef
  set j := Algebra.TensorProduct.map C.val (AlgHom.id A B) with hjdef

  have s2 : ∀ (h γ : G) (x : TensorProduct A B B),
      Φ (Algebra.TensorProduct.map (τ h) (AlgHom.id A B) x) γ = Φ x (h * γ) := by
    intro h γ x
    induction x using TensorProduct.induction_on with
    | zero => simp
    | tmul b b' =>
      simp [hΦdef, Algebra.TensorProduct.productMap_apply_tmul, hτ]
    | add x y hx hy => simp only [map_add, Pi.add_apply, hx, hy]

  have s3 : ∀ (u : TensorProduct A C B) (i : Fin d), χ u i = Φ (j u) (g i) := by
    intro u i
    induction u using TensorProduct.induction_on with
    | zero => simp
    | tmul c b => simp [hχdef, hΦdef, hjdef, Algebra.TensorProduct.productMap_apply_tmul]
    | add x y hx hy => simp only [map_add, Pi.add_apply, hx, hy]

  let ι : C →ₗ[A] B := C.val.toLinearMap
  let δ : B →ₗ[A] (H → B) := LinearMap.pi (fun h : H => (τ h).toLinearMap - LinearMap.id)
  have hexact : Function.Exact ι δ := by
    intro y
    constructor
    · intro hy
      have hyC : y ∈ C := (hC y).2 (fun k hk => by
        have := congrFun hy ⟨k, hk⟩
        simpa [δ, sub_eq_zero] using this)
      exact ⟨⟨y, hyC⟩, rfl⟩
    · rintro ⟨c, rfl⟩
      funext k
      simp [δ, ι, (hC c).1 c.2 k k.2]
  have hj_eq : ∀ z, j z = LinearMap.rTensor B ι z := by
    intro z
    induction z using TensorProduct.induction_on with
    | zero => simp
    | tmul c b => simp [hjdef, ι]
    | add x y hx hy => simp only [map_add, hx, hy]
  have hT_eq : ∀ (h : G) x, Algebra.TensorProduct.map (τ h) (AlgHom.id A B) x =
      LinearMap.rTensor B (τ h).toLinearMap x := by
    intro h x
    induction x using TensorProduct.induction_on with
    | zero => simp
    | tmul c b => simp
    | add x y hx hy => simp only [map_add, hx, hy]
  have hinjR : Function.Injective (LinearMap.rTensor B ι) :=
    Module.Flat.rTensor_preserves_injective_linearMap ι Subtype.val_injective
  have hexR := Module.Flat.rTensor_exact B hexact
  have J1 : Function.Injective j := by
    intro a b hab
    apply hinjR
    rw [← hj_eq, ← hj_eq]
    exact hab
  have hproj : ∀ (h : H) x, LinearMap.rTensor B (LinearMap.proj h) (LinearMap.rTensor B δ x) =
      LinearMap.rTensor B (τ h).toLinearMap x - x := by
    intro h x
    rw [← LinearMap.rTensor_comp_apply]
    have hc : (LinearMap.proj h : (H → B) →ₗ[A] B) ∘ₗ δ = (τ h).toLinearMap - LinearMap.id := by
      ext b
      simp [δ]
    rw [hc, LinearMap.rTensor_sub, LinearMap.sub_apply, LinearMap.rTensor_id, LinearMap.id_apply]
  have hrecon : ∀ w : TensorProduct A (H → B) B, w = ∑ h : H,
      LinearMap.rTensor B (LinearMap.single A (fun _ : H => B) h)
        (LinearMap.rTensor B (LinearMap.proj h) w) := by
    intro w
    induction w using TensorProduct.induction_on with
    | zero => simp
    | tmul v b =>
      simp only [LinearMap.rTensor_tmul, LinearMap.proj_apply, LinearMap.coe_single]
      rw [← TensorProduct.sum_tmul, Finset.univ_sum_single]
    | add x y hx hy =>
      simp only [map_add, Finset.sum_add_distrib]
      rw [← hx, ← hy]
  have J2 : ∀ x, x ∈ Set.range j ↔
      ∀ h : H, Algebra.TensorProduct.map (τ h) (AlgHom.id A B) x = x := by
    intro x
    have e1 : x ∈ Set.range j ↔ x ∈ Set.range (LinearMap.rTensor B ι) := by
      constructor
      · rintro ⟨z, rfl⟩
        exact ⟨z, (hj_eq z).symm⟩
      · rintro ⟨z, rfl⟩
        exact ⟨z, hj_eq z⟩
    rw [e1, ← hexR x]
    constructor
    · intro h0 h
      have hh := hproj h x
      rw [h0, map_zero] at hh
      rw [hT_eq]
      exact sub_eq_zero.mp hh.symm
    · intro hfix
      rw [hrecon (LinearMap.rTensor B δ x)]
      apply Finset.sum_eq_zero
      intro h _
      rw [hproj h x, ← hT_eq, hfix h, sub_self, map_zero]

  let iF : G → Fin d := fun γ => (hg γ).exists.choose
  have P1 : ∀ γ, γ * (g (iF γ))⁻¹ ∈ H := fun γ => (hg γ).exists.choose_spec
  have P2 : ∀ k, iF (g k) = k := fun k =>
    (hg (g k)).unique (P1 (g k)) (by rw [mul_inv_cancel]; exact H.one_mem)
  have P3 : ∀ h ∈ H, ∀ γ, iF (h * γ) = iF γ := fun h hh γ =>
    (hg (h * γ)).unique (P1 (h * γ)) (by rw [mul_assoc]; exact H.mul_mem hh (P1 γ))
  have K : ∀ x, (∀ h : H, Algebra.TensorProduct.map (τ h) (AlgHom.id A B) x = x) →
      ∀ γ, Φ x γ = Φ x (g (iF γ)) := by
    intro x hx γ
    have e : γ = (γ * (g (iF γ))⁻¹) * g (iF γ) := by group
    calc Φ x γ = Φ x ((γ * (g (iF γ))⁻¹) * g (iF γ)) := congrArg (Φ x) e
      _ = Φ (Algebra.TensorProduct.map (τ (γ * (g (iF γ))⁻¹)) (AlgHom.id A B) x) (g (iF γ)) :=
          (s2 _ _ x).symm
      _ = Φ x (g (iF γ)) := congrArg (fun y => Φ y (g (iF γ))) (hx ⟨_, P1 γ⟩)
  refine ⟨?_, ?_⟩
  · intro u₁ u₂ h12
    have fix : ∀ u, ∀ h : H, Algebra.TensorProduct.map (τ h) (AlgHom.id A B) (j u) = j u :=
      fun u => (J2 (j u)).1 ⟨u, rfl⟩
    apply J1
    apply hΦ.1
    funext γ
    rw [K _ (fix u₁) γ, K _ (fix u₂) γ, ← s3, ← s3, h12]
  · intro y
    obtain ⟨x, hx⟩ := hΦ.2 (fun γ => y (iF γ))
    have hfix : ∀ h : H, Algebra.TensorProduct.map (τ h) (AlgHom.id A B) x = x := by
      intro h
      apply hΦ.1
      funext γ
      rw [s2, hx]
      exact congrArg y (P3 h h.2 γ)
    obtain ⟨u, rfl⟩ := (J2 x).2 hfix
    refine ⟨u, ?_⟩
    funext k
    rw [s3, hx]
    exact congrArg y (P2 k)

theorem wc_galois_tensor_subgroup_galois : ∀ (A B : Type u) [CommRing A] [CommRing B] [Algebra A B]
    (G : Type u) [Group G] (τ : G → (B →ₐ[A] B)), (∀ γ δ, τ (γ * δ) = (τ δ).comp (τ γ)) →
    Function.Bijective (Algebra.TensorProduct.productMap (AlgHom.pi τ)
      (AlgHom.pi fun _ : G => AlgHom.id A B)) →
    ∀ (H : Subgroup G) (d : ℕ) (g : Fin d → G), (∀ γ : G, ∃! i : Fin d, γ * (g i)⁻¹ ∈ H) →
    ∀ (C : Subalgebra A B), (∀ b : B, b ∈ C ↔ ∀ h ∈ H, τ h b = b) →
    Function.Surjective (Algebra.TensorProduct.productMap
      (AlgHom.pi fun i : Fin d => (τ (g i)).comp C.val)
      (AlgHom.pi fun _ : Fin d => AlgHom.id A B)) →
    ∀ (τ' : H → (B →ₐ[C] B)), (∀ (h : H) (b : B), τ' h b = τ h b) →
    Function.Bijective (Algebra.TensorProduct.productMap (AlgHom.pi τ')
      (AlgHom.pi fun _ : H => AlgHom.id C B)) :=
by
  intro A B _ _ _ G _ τ hτmul hΦ H d g hg C hC hχ τ' hτ'
  classical
  set Φ := Algebra.TensorProduct.productMap (AlgHom.pi τ)
    (AlgHom.pi fun _ : G => AlgHom.id A B) with hΦdef
  set Ψ := Algebra.TensorProduct.productMap (AlgHom.pi τ')
    (AlgHom.pi fun _ : H => AlgHom.id C B) with hΨdef
  set χ := Algebra.TensorProduct.productMap (AlgHom.pi fun i : Fin d => (τ (g i)).comp C.val)
    (AlgHom.pi fun _ : Fin d => AlgHom.id A B) with hχdef
  let π : TensorProduct A B B →ₐ[A] TensorProduct C B B := Algebra.TensorProduct.productMap
    (Algebra.TensorProduct.includeLeft : B →ₐ[A] TensorProduct C B B)
    ((Algebra.TensorProduct.includeRight : B →ₐ[C] TensorProduct C B B).restrictScalars A)
  let j : TensorProduct A C B →ₐ[A] TensorProduct A B B :=
    Algebra.TensorProduct.map C.val (AlgHom.id A B)
  have hΦt : ∀ (b b' : B) (γ : G), Φ (TensorProduct.tmul A b b') γ = τ γ b * b' := by
    intro b b' γ
    simp [Φ]
  have hΨt : ∀ (b b' : B) (h : H), Ψ (TensorProduct.tmul C b b') h = τ h b * b' := by
    intro b b' h
    simp [Ψ, hτ']
  have hχt : ∀ (c : C) (b : B) (i : Fin d),
      χ (TensorProduct.tmul A c b) i = τ (g i) c * b := by
    intro c b i
    simp [χ]
  have hπt : ∀ b b' : B, π (TensorProduct.tmul A b b') = TensorProduct.tmul C b b' := by
    intro b b'
    simp [π, Algebra.TensorProduct.tmul_mul_tmul]
  have hjt : ∀ (c : C) (b : B), j (TensorProduct.tmul A c b) = TensorProduct.tmul A (c : B) b := by
    intro c b
    simp [j]
  have hπsurj : Function.Surjective π := by
    intro y
    induction y using TensorProduct.induction_on with
    | zero => exact ⟨0, map_zero _⟩
    | tmul b b' => exact ⟨TensorProduct.tmul A b b', hπt b b'⟩
    | add y₁ y₂ h₁ h₂ =>
      obtain ⟨x₁, rfl⟩ := h₁
      obtain ⟨x₂, rfl⟩ := h₂
      exact ⟨x₁ + x₂, map_add _ _ _⟩
  have hcompat : ∀ (x : TensorProduct A B B) (h : H), Ψ (π x) h = Φ x h := by
    intro x h
    induction x using TensorProduct.induction_on with
    | zero => simp
    | tmul b b' => rw [hπt, hΨt, hΦt]
    | add x₁ x₂ h₁ h₂ => rw [map_add, map_add, Pi.add_apply, h₁, h₂, map_add, Pi.add_apply]

  obtain ⟨i₀, hi₀, -⟩ := hg 1
  have hgi₀ : g i₀ ∈ H := by
    rw [one_mul] at hi₀
    exact (Subgroup.inv_mem_iff H).mp hi₀
  obtain ⟨u, hu⟩ := hχ (Pi.single i₀ 1)
  have K1 : ∀ (w : TensorProduct A C B) (γ : G) (k : Fin d), γ * (g k)⁻¹ ∈ H →
      Φ (j w) γ = χ w k := by
    intro w γ k hk
    induction w using TensorProduct.induction_on with
    | zero => simp
    | tmul c b =>
      rw [hjt, hΦt, hχt]
      congr 1
      calc τ γ c = τ ((γ * (g k)⁻¹) * g k) c := by rw [inv_mul_cancel_right]
        _ = τ (g k) (τ (γ * (g k)⁻¹) c) := by rw [hτmul, AlgHom.comp_apply]
        _ = τ (g k) c := by rw [(hC c).1 c.2 _ hk]
    | add w₁ w₂ h₁ h₂ => rw [map_add, map_add, Pi.add_apply, h₁, h₂, map_add, Pi.add_apply]
  have K2 : ∀ w : TensorProduct A C B, π (j w) = TensorProduct.tmul C (1 : B) (χ w i₀) := by
    intro w
    induction w using TensorProduct.induction_on with
    | zero => simp
    | tmul c b =>
      rw [hjt, hπt, hχt, (hC c).1 c.2 _ hgi₀]
      have e1 : (c : B) = c • (1 : B) := ((Subalgebra.smul_def c (1 : B)).trans (mul_one _)).symm
      have e2 : (c : B) * b = c • b := (Subalgebra.smul_def c b).symm
      rw [e2]
      conv_lhs => rw [e1]
      rw [TensorProduct.smul_tmul]
    | add w₁ w₂ h₁ h₂ =>
      rw [map_add, map_add, h₁, h₂, map_add, Pi.add_apply, TensorProduct.tmul_add]
  have hπe : π (j u) = 1 := by
    rw [K2, hu, Pi.single_eq_same, Algebra.TensorProduct.one_def]
  have hΦe : ∀ γ : G, γ ∉ H → Φ (j u) γ = 0 := by
    intro γ hγ
    obtain ⟨k, hk, -⟩ := hg γ
    have hne : k ≠ i₀ := by
      rintro rfl
      exact hγ (by simpa using H.mul_mem hk hgi₀)
    rw [K1 u γ k hk, hu, Pi.single_eq_of_ne hne]
  refine ⟨?_, ?_⟩
  · rw [injective_iff_map_eq_zero]
    intro y hy
    obtain ⟨x, rfl⟩ := hπsurj y
    have hex : Φ (j u * x) = 0 := by
      funext γ
      rw [map_mul, Pi.mul_apply, Pi.zero_apply]
      by_cases hγ : γ ∈ H
      · have h1 := hcompat x ⟨γ, hγ⟩
        rw [hy] at h1
        have h2 : Φ x γ = 0 := h1.symm
        rw [h2, mul_zero]
      · rw [hΦe γ hγ, zero_mul]
    have hex0 : j u * x = 0 := hΦ.1 (by rw [hex, map_zero])
    calc π x = π (j u) * π x := by rw [hπe, one_mul]
      _ = π (j u * x) := (map_mul _ _ _).symm
      _ = 0 := by rw [hex0, map_zero]
  · intro y
    obtain ⟨x, hx⟩ := hΦ.2 (fun γ => if hγ : γ ∈ H then y ⟨γ, hγ⟩ else 0)
    refine ⟨π x, ?_⟩
    funext h
    rw [hcompat, hx]
    simp

theorem wc_finite_etale_descend_split : ∀ (A B : Type u) [CommRing A] [CommRing B] [Algebra A B]
    [Algebra.Etale A B] [Module.Finite A B] [Module.FaithfullyFlat A B] (C : Subalgebra A B)
    (d : ℕ) (μ : Fin d → (C →ₐ[A] B)),
    Function.Bijective (Algebra.TensorProduct.productMap (AlgHom.pi μ)
      (AlgHom.pi fun _ : Fin d => AlgHom.id A B)) →
    Algebra.Etale A C ∧ Module.Finite A C ∧ Algebra.Etale C B ∧ Module.Finite C B ∧
      Function.Surjective (PrimeSpectrum.comap (algebraMap C B)) :=
by
  intro A B _ _ _ _ _ _ C d μ hχ

  have key : ∀ (C' : Type u) [CommRing C'] [Algebra A C'] (μ' : Fin d → (C' →ₐ[A] B)),
      Function.Bijective (Algebra.TensorProduct.productMap (AlgHom.pi μ')
        (AlgHom.pi fun _ : Fin d => AlgHom.id A B)) →
      Algebra.Etale A C' ∧ Module.Finite A C' := by
    intro C' _ _ μ' hχ'
    letI : Algebra B (TensorProduct A C' B) := Algebra.TensorProduct.rightAlgebra
    let χ := Algebra.TensorProduct.productMap (AlgHom.pi μ')
        (AlgHom.pi fun _ : Fin d => AlgHom.id A B)
    let χB : TensorProduct A C' B →ₐ[B] (Fin d → B) :=
      { (χ : TensorProduct A C' B →+* (Fin d → B)) with
        commutes' := fun b => by
          funext i
          change χ (TensorProduct.tmul A (1 : C') b) i = b
          simp [χ, Algebra.TensorProduct.productMap_apply_tmul, AlgHom.pi_apply] }
    have hχB : Function.Bijective χB := hχ'
    let e : TensorProduct A C' B ≃ₐ[B] (Fin d → B) := AlgEquiv.ofBijective χB hχB
    haveI : Algebra.Etale B (TensorProduct A C' B) := Algebra.Etale.of_equiv e.symm
    haveI : Module.Finite B (TensorProduct A C' B) := Module.Finite.equiv e.symm.toLinearEquiv
    haveI : Algebra.IsPushout A C' B (TensorProduct A C' B) :=
      TensorProduct.isPushout (R := A) (S := C') (T := B)
    have hFF : (algebraMap A B).FaithfullyFlat :=
      RingHom.faithfullyFlat_algebraMap_iff.mpr inferInstance
    have h1 : (algebraMap A C').Etale :=
      RingHom.Etale.codescendsAlong_faithfullyFlat (R := A) (S := C') (R' := B)
        (S' := TensorProduct A C' B) hFF (RingHom.etale_algebraMap.mpr inferInstance)
    have h2 : (algebraMap A C').Finite :=
      RingHom.Finite.codescendsAlong_faithfullyFlat (R := A) (S := C') (R' := B)
        (S' := TensorProduct A C' B) hFF (RingHom.finite_algebraMap.mpr inferInstance)
    exact ⟨RingHom.etale_algebraMap.mp h1, RingHom.finite_algebraMap.mp h2⟩
  obtain ⟨hAC, hACf⟩ := key C μ hχ
  haveI := hAC
  haveI := hACf
  haveI hCBf : Module.Finite C B := Module.Finite.of_restrictScalars_finite A C B
  haveI := Algebra.IsIntegral.of_finite C B
  exact ⟨hAC, hACf, Algebra.Etale.of_restrictScalars A C B, hCBf,
    Algebra.IsIntegral.comap_surjective C B⟩

theorem wc_finite_extension_of_affine_finite : ∀ (X : Scheme.{u}) [CompactSpace X]
    [QuasiSeparatedSpace X] (W₁ : X.Opens), IsAffineOpen W₁ → ∀ (Y : Scheme.{u})
    (εO : Y ⟶ (W₁ : Scheme.{u})), IsFinite εO →
    ∃ (X' : Scheme.{u}) (h : X' ⟶ X) (_ : IsFinite h) (ψ : Y ⟶ X'),
      IsOpenImmersion ψ ∧ Set.range ψ = h ⁻¹' (W₁ : Set X) ∧ Dense (h ⁻¹' (W₁ : Set X)) ∧
      ψ ≫ h = εO ≫ W₁.ι :=
by
  intro X _ _ W₁ hW₁ Y εO hεO
  classical
  haveI := hεO
  haveI : IsAffine (W₁ : Scheme.{u}) := hW₁
  haveI : QuasiCompact W₁.ι := quasiCompact_of_compactSpace W₁.ι
  haveI hqc : QuasiCompact (εO ≫ W₁.ι) := inferInstance
  haveI hqs : QuasiSeparated (εO ≫ W₁.ι) := inferInstance
  obtain ⟨hjo, hjr, hjd, n, t, ht⟩ :=
    wc_normalization_iso_over_finite_locus Y X (εO ≫ W₁.ι) W₁ hW₁ εO hεO rfl
  obtain ⟨Z, p, r, hp, hr, hrs, hri, hrw⟩ := wc_integral_finite_stage X
    (εO ≫ W₁.ι).normalization (εO ≫ W₁.ι).fromNormalization (Fin n) (fun _ => W₁)
    (fun _ => hW₁) t
  haveI := hp
  obtain ⟨hOi, hOr⟩ := wc_finite_stage_open_immersion Y (εO ≫ W₁.ι).normalization X Z
    (εO ≫ W₁.ι).fromNormalization p r hr W₁ hW₁ (hri W₁ hW₁) n t hrw ht
    (εO ≫ W₁.ι).toNormalization hjo hjr
  refine ⟨Z, p, hp, (εO ≫ W₁.ι).toNormalization ≫ r, hOi, hOr, ?_, ?_⟩
  · rw [← hOr]
    have himg : Set.range ((εO ≫ W₁.ι).toNormalization ≫ r) =
        r '' Set.range (εO ≫ W₁.ι).toNormalization := by
      ext x
      constructor
      · rintro ⟨a, rfl⟩
        exact ⟨(εO ≫ W₁.ι).toNormalization a, ⟨a, rfl⟩, (Scheme.Hom.comp_apply _ r a).symm⟩
      · rintro ⟨b, ⟨a, rfl⟩, rfl⟩
        exact ⟨a, Scheme.Hom.comp_apply _ r a⟩
    rw [himg]
    exact DenseRange.dense_image (Function.Surjective.denseRange hrs) r.continuous hjd
  · rw [Category.assoc, hr, Scheme.Hom.toNormalization_fromNormalization]

theorem wc_galois_sylow_quotient_extension (K : Type u) [Field K] (X : Scheme.{u})
    (f : X ⟶ Spec (.of K)) [IsProper f] (W₁ : X.Opens) (hW₁ : IsAffineOpen W₁) (E : Scheme.{u})
    (hE : IsAffine E) (q : E ⟶ (W₁ : Scheme.{u})) (Γ : Type u) [Group Γ] (α : Γ →* Aut E)
    (hq : wcGalCover q Γ α) (H : Subgroup Γ) :
    ∃ (X' : Scheme.{u}) (h : X' ⟶ X) (_ : IsFinite h) (ρ : E ⟶ (h ⁻¹ᵁ W₁ : Scheme.{u}))
      (σ : Fin H.index → (E ⟶ X')) (hσ : ∀ i, σ i ≫ h = q ≫ W₁.ι),
      Dense ((h ⁻¹ᵁ W₁ : X'.Opens) : Set X') ∧
      ρ ≫ (h ⁻¹ᵁ W₁).ι ≫ h = q ≫ W₁.ι ∧
      wcGalCover ρ H (α.comp H.subtype) ∧
      IsIso (Limits.Sigma.desc (fun i => Limits.pullback.lift (σ i) (𝟙 E)
        ((hσ i).trans (Category.id_comp (q ≫ W₁.ι)).symm)) :
          ∐ (fun _ : Fin H.index => E) ⟶ Limits.pullback h (q ≫ W₁.ι)) :=
by
  classical
  obtain ⟨hfinΓ, hqfin, hqet, hqsurj, hα, hiso⟩ := hq
  haveI := hfinΓ
  haveI := hqfin
  haveI := hqet
  haveI := hqsurj
  haveI hWaff : IsAffine (W₁ : Scheme.{u}) := hW₁
  haveI := hE
  letI alg : Algebra Γ((W₁ : Scheme.{u}), ⊤) Γ(E, ⊤) := q.appTop.hom.toAlgebra

  obtain ⟨τ, hτ, hτmul, hEt, hFin, hFF⟩ := wc_affine_galois_ring_data q Γ α hα rfl
  haveI := hEt
  haveI := hFin
  haveI := hFF

  have hPB : IsPullback (Limits.Sigma.desc fun γ : Γ => (α γ).hom)
      (Limits.Sigma.desc fun _ : Γ => 𝟙 E) q q :=
    (wc_sigma_lift_isIso_iff_isPullback q q Γ (fun γ => (α γ).hom)
      (fun γ => (hα γ).trans (Category.id_comp q).symm)).1 hiso
  have hqSpec : q ≫ (W₁ : Scheme.{u}).isoSpec.hom = E.isoSpec.hom ≫
      Spec.map (CommRingCat.ofHom (algebraMap Γ((W₁ : Scheme.{u}), ⊤) Γ(E, ⊤))) :=
    (Scheme.isoSpec_hom_naturality q).symm
  have hτSpec : ∀ γ : Γ, CommRingCat.ofHom (τ γ : Γ(E, ⊤) →+* Γ(E, ⊤)) = (α γ).hom.appTop := by
    intro γ
    ext b
    exact hτ γ b
  have hαSpec : ∀ γ : Γ, (α γ).hom ≫ E.isoSpec.hom =
      E.isoSpec.hom ≫ Spec.map (CommRingCat.ofHom (τ γ : Γ(E, ⊤) →+* Γ(E, ⊤))) := by
    intro γ
    rw [hτSpec γ]
    exact (Scheme.isoSpec_hom_naturality _).symm
  have hΦ := (wc_affine_sigma_isPullback_iff_bijective Γ((W₁ : Scheme.{u}), ⊤) Γ(E, ⊤) Γ(E, ⊤) Γ τ
    (W₁ : Scheme.{u}) E E (W₁ : Scheme.{u}).isoSpec E.isoSpec E.isoSpec q q (fun γ => (α γ).hom)
    hqSpec hqSpec hαSpec).1 hPB

  haveI : Finite (Γ ⧸ H) :=
    Finite.of_surjective (QuotientGroup.mk : Γ → Γ ⧸ H) QuotientGroup.mk_surjective
  let e₀ : Γ ⧸ H ≃ Fin H.index :=
    (Finite.equivFin (Γ ⧸ H)).trans (finCongr (Subgroup.index_eq_card H).symm)
  let g : Fin H.index → Γ := fun i => (Quotient.out (e₀.symm i))⁻¹
  have hg : ∀ γ : Γ, ∃! i : Fin H.index, γ * (g i)⁻¹ ∈ H := by
    intro γ
    have key : ∀ i, γ * (g i)⁻¹ ∈ H ↔ e₀ ((γ⁻¹ : Γ) : Γ ⧸ H) = i := by
      intro i
      have e1 : γ * (g i)⁻¹ = (γ⁻¹)⁻¹ * Quotient.out (e₀.symm i) := by
        show γ * ((Quotient.out (e₀.symm i))⁻¹)⁻¹ = (γ⁻¹)⁻¹ * Quotient.out (e₀.symm i)
        rw [inv_inv, inv_inv]
      rw [e1, ← QuotientGroup.eq, QuotientGroup.out_eq']
      constructor
      · intro hh
        rw [hh, Equiv.apply_symm_apply]
      · intro hh
        subst hh
        exact (e₀.symm_apply_apply _).symm
    exact ⟨e₀ ((γ⁻¹ : Γ) : Γ ⧸ H), (key _).2 rfl, fun j hj => ((key j).1 hj).symm⟩

  obtain ⟨C, hC⟩ : ∃ C : Subalgebra Γ((W₁ : Scheme.{u}), ⊤) Γ(E, ⊤),
      ∀ b, b ∈ C ↔ ∀ k ∈ H, τ k b = b :=
    ⟨{ carrier := {b | ∀ k ∈ H, τ k b = b}
       mul_mem' := fun {a b} ha hb k hk => by rw [map_mul, ha k hk, hb k hk]
       add_mem' := fun {a b} ha hb k hk => by rw [map_add, ha k hk, hb k hk]
       algebraMap_mem' := fun r k _ => (τ k).commutes r }, fun b => Iff.rfl⟩

  have hχ := wc_galois_tensor_invariants_split _ _ Γ τ hτmul hΦ H H.index g hg C hC
  obtain ⟨hAC, hACf, hCB, hCBf, hsurjC⟩ :=
    wc_finite_etale_descend_split _ _ C H.index (fun i => (τ (g i)).comp C.val) hχ
  haveI := hAC
  haveI := hACf
  haveI := hCB
  haveI := hCBf
  let τ' : H → (Γ(E, ⊤) →ₐ[C] Γ(E, ⊤)) := fun k =>
    { (τ k : Γ(E, ⊤) →+* Γ(E, ⊤)) with commutes' := fun c => (hC c).1 c.2 k k.2 }
  have hΨ := wc_galois_tensor_subgroup_galois _ _ Γ τ hτmul hΦ H H.index g hg C hC hχ.2 τ'
    (fun k b => rfl)

  obtain ⟨εO, hεO⟩ : ∃ εO : Spec (.of C) ⟶ (W₁ : Scheme.{u}),
      εO = Spec.map (CommRingCat.ofHom (algebraMap Γ((W₁ : Scheme.{u}), ⊤) C)) ≫
        (W₁ : Scheme.{u}).isoSpec.inv := ⟨_, rfl⟩
  have hεOfin : IsFinite εO := by
    rw [hεO]
    haveI : IsFinite (Spec.map (CommRingCat.ofHom (algebraMap Γ((W₁ : Scheme.{u}), ⊤) C))) :=
      (IsFinite.SpecMap_iff _).2 (RingHom.finite_algebraMap.2 hACf)
    infer_instance
  have hfromE : ∀ φ : C →+* Γ(E, ⊤),
      (∀ a, φ (algebraMap Γ((W₁ : Scheme.{u}), ⊤) C a) =
        algebraMap Γ((W₁ : Scheme.{u}), ⊤) Γ(E, ⊤) a) →
      (E.isoSpec.hom ≫ Spec.map (CommRingCat.ofHom φ)) ≫ εO = q := by
    intro φ hφ
    have h1 : CommRingCat.ofHom (algebraMap Γ((W₁ : Scheme.{u}), ⊤) C) ≫ CommRingCat.ofHom φ =
        CommRingCat.ofHom (algebraMap Γ((W₁ : Scheme.{u}), ⊤) Γ(E, ⊤)) := by
      ext a
      exact hφ a
    rw [hεO, Category.assoc, ← Category.assoc (Spec.map _) (Spec.map _), ← Spec.map_comp, h1,
      ← Category.assoc, ← hqSpec, Category.assoc, Iso.hom_inv_id, Category.comp_id]
  obtain ⟨σ₀, hσ₀def⟩ : ∃ s : Fin H.index → (E ⟶ Spec (.of C)), ∀ i, s i = E.isoSpec.hom ≫
      Spec.map (CommRingCat.ofHom (((τ (g i)).comp C.val :
        C →ₐ[Γ((W₁ : Scheme.{u}), ⊤)] Γ(E, ⊤)) : C →+* Γ(E, ⊤))) := ⟨_, fun _ => rfl⟩
  have hσ₀ : ∀ i, σ₀ i ≫ εO = q := fun i => by
    rw [hσ₀def]
    exact hfromE _ (fun a => ((τ (g i)).comp C.val).commutes a)
  obtain ⟨ρ₀, hρ₀def⟩ : ∃ r : E ⟶ Spec (.of C), r = E.isoSpec.hom ≫
      Spec.map (CommRingCat.ofHom (algebraMap C Γ(E, ⊤))) := ⟨_, rfl⟩
  have hρ₀ : ρ₀ ≫ εO = q := by
    rw [hρ₀def]
    exact hfromE _ (fun a => (IsScalarTower.algebraMap_apply _ C _ a).symm)

  have hsq1 : IsPullback (Limits.Sigma.desc σ₀) (Limits.Sigma.desc fun _ : Fin H.index => 𝟙 E)
      εO q :=
    (wc_affine_sigma_isPullback_iff_bijective Γ((W₁ : Scheme.{u}), ⊤) C Γ(E, ⊤) (Fin H.index)
      (fun i => (τ (g i)).comp C.val) (W₁ : Scheme.{u}) (Spec (.of C)) E
      (W₁ : Scheme.{u}).isoSpec (Iso.refl _) E.isoSpec εO q σ₀
      (by rw [hεO, Category.assoc, Iso.inv_hom_id, Category.comp_id, Iso.refl_hom,
        Category.id_comp])
      hqSpec (fun i => by rw [Iso.refl_hom, Category.comp_id]; exact hσ₀def i)).2 hχ

  haveI : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace f
  haveI : QuasiSeparatedSpace X := quasiSeparatedSpace_of_quasiSeparated f
  obtain ⟨X', h, hhfin, ψ, hψopen, hψrange, hdense, hψh⟩ :=
    wc_finite_extension_of_affine_finite X W₁ hW₁ (Spec (.of C)) εO hεOfin
  haveI := hhfin
  haveI := hψopen
  have hrange : Set.range ψ = Set.range (h ⁻¹ᵁ W₁).ι := by
    rw [Scheme.Opens.range_ι, hψrange, Scheme.Hom.coe_preimage]
  obtain ⟨ψ', hψ'fac⟩ : ∃ ψ' : Spec (.of C) ≅ (h ⁻¹ᵁ W₁ : Scheme.{u}),
      ψ'.hom ≫ (h ⁻¹ᵁ W₁).ι = ψ :=
    ⟨IsOpenImmersion.isoOfRangeEq ψ (h ⁻¹ᵁ W₁).ι hrange,
      IsOpenImmersion.isoOfRangeEq_hom_fac _ _ _⟩
  have hres : ψ'.hom ≫ (h ∣_ W₁) = εO := by
    rw [← cancel_mono W₁.ι, Category.assoc, morphismRestrict_ι, ← Category.assoc, hψ'fac, hψh]
  have hsq2 : IsPullback ψ εO h W₁.ι :=
    IsPullback.of_iso (isPullback_morphismRestrict h W₁).flip ψ'.symm (Iso.refl _) (Iso.refl _)
      (Iso.refl _)
      (by rw [Iso.refl_hom, Category.comp_id, Iso.symm_hom, ← hψ'fac, Iso.inv_hom_id_assoc])
      (by rw [Iso.refl_hom, Category.comp_id, Iso.symm_hom, ← hres, Iso.inv_hom_id_assoc])
      (by simp) (by simp)

  have hσ : ∀ i, (σ₀ i ≫ ψ) ≫ h = q ≫ W₁.ι := fun i => by
    rw [Category.assoc, hψh, ← Category.assoc, hσ₀ i]
  have hinv : ∀ k : H, (α k).hom ≫ ρ₀ = ρ₀ := by
    intro k
    have e1 : CommRingCat.ofHom (algebraMap C Γ(E, ⊤)) ≫
        CommRingCat.ofHom (τ k : Γ(E, ⊤) →+* Γ(E, ⊤)) =
        CommRingCat.ofHom (algebraMap C Γ(E, ⊤)) := by
      ext c
      exact (hC _).1 c.2 k k.2
    rw [hρ₀def, ← Category.assoc, hαSpec, Category.assoc, ← Spec.map_comp, e1]
  have hα' : ∀ k : H, ((α.comp H.subtype) k).hom ≫ (ρ₀ ≫ ψ'.hom) = ρ₀ ≫ ψ'.hom := fun k => by
    rw [← Category.assoc]
    exact congrArg (· ≫ ψ'.hom) (hinv k)
  haveI : IsFinite ρ₀ := by
    rw [hρ₀def]
    haveI : IsFinite (Spec.map (CommRingCat.ofHom (algebraMap C Γ(E, ⊤)))) :=
      (IsFinite.SpecMap_iff _).2 (RingHom.finite_algebraMap.2 hCBf)
    infer_instance
  haveI : Etale ρ₀ := by
    rw [hρ₀def]
    haveI : Etale (Spec.map (CommRingCat.ofHom (algebraMap C Γ(E, ⊤)))) :=
      HasRingHomProperty.Spec_iff.mpr (RingHom.etale_algebraMap.mpr hCB)
    infer_instance
  haveI : AlgebraicGeometry.Surjective ρ₀ := by
    rw [hρ₀def]
    haveI : AlgebraicGeometry.Surjective (Spec.map (CommRingCat.ofHom (algebraMap C Γ(E, ⊤)))) := by
      rw [surjective_iff]
      exact hsurjC
    infer_instance
  have hpbH : IsPullback (Limits.Sigma.desc fun k : H => ((α.comp H.subtype) k).hom)
      (Limits.Sigma.desc fun _ : H => 𝟙 E) (ρ₀ ≫ ψ'.hom) (ρ₀ ≫ ψ'.hom) := by
    have c1 : (ρ₀ ≫ ψ'.hom) ≫ ψ'.symm.hom = E.isoSpec.hom ≫
        Spec.map (CommRingCat.ofHom (algebraMap C Γ(E, ⊤))) := by
      rw [Iso.symm_hom, Category.assoc, Iso.hom_inv_id, Category.comp_id, hρ₀def]
    exact (wc_affine_sigma_isPullback_iff_bijective C Γ(E, ⊤) Γ(E, ⊤) H τ'
      (h ⁻¹ᵁ W₁ : Scheme.{u}) E E ψ'.symm E.isoSpec E.isoSpec (ρ₀ ≫ ψ'.hom) (ρ₀ ≫ ψ'.hom)
      (fun k => ((α.comp H.subtype) k).hom) c1 c1 (fun k => hαSpec k)).2 hΨ
  have hsq := hsq1.paste_horiz hsq2
  have hdesc : Limits.Sigma.desc σ₀ ≫ ψ = Limits.Sigma.desc (fun i => σ₀ i ≫ ψ) := by
    ext i
    simp
  rw [hdesc] at hsq
  refine ⟨X', h, hhfin, ρ₀ ≫ ψ'.hom, fun i => σ₀ i ≫ ψ, hσ, hdense, ?_, ?_, ?_⟩
  · rw [Category.assoc, ← Category.assoc ψ'.hom, hψ'fac, hψh, ← Category.assoc, hρ₀]
  · unfold wcGalCover
    refine ⟨inferInstance, inferInstance, inferInstance, inferInstance, hα', ?_⟩
    exact (wc_sigma_lift_isIso_iff_isPullback (ρ₀ ≫ ψ'.hom) (ρ₀ ≫ ψ'.hom) H
      (fun k => ((α.comp H.subtype) k).hom)
      (fun k => (hα' k).trans (Category.id_comp _).symm)).2 hpbH
  · exact (wc_sigma_lift_isIso_iff_isPullback h (q ≫ W₁.ι) (Fin H.index) (fun i => σ₀ i ≫ ψ)
      (fun i => (hσ i).trans (Category.id_comp _).symm)).2 hsq

theorem wc_pgroup_flag_functionals (ℓ : ℕ) (hℓ : ℓ.Prime) (H : Type u) [Group H] [Finite H]
    (hH : IsPGroup ℓ H) (M : Type (u+1)) [AddCommGroup M] [Finite M] (hM : ∀ x : M, ℓ • x = 0)
    (act : H →* AddMonoid.End M) :
    ∃ (n : ℕ) (K : ℕ → AddSubgroup M), K 0 = ⊥ ∧ K n = ⊤ ∧
      (∀ k, ∀ x : H, ∀ y ∈ K k, act x y ∈ K k) ∧
      ∀ k < n, K k ≤ K (k + 1) ∧ ∃ π : M →+ ULift.{u+1} (ZMod ℓ),
        (∀ y ∈ K (k + 1), π y = 0 ↔ y ∈ K k) ∧ (∃ y ∈ K (k + 1), π y = ULift.up 1) ∧
        (∀ x : H, ∀ y ∈ K (k + 1), π (act x y) = π y) :=
by
  classical
  haveI : Fact ℓ.Prime := ⟨hℓ⟩
  haveI : NeZero ℓ := ⟨hℓ.ne_zero⟩

  have s1 : ∀ K : AddSubgroup M, (∀ x : H, ∀ y ∈ K, act x y ∈ K) → K ≠ ⊤ →
      ∃ v : M, v ∉ K ∧ ∀ x : H, act x v - v ∈ K := by
    intro K hK hKtop
    let ψ : H → (M ⧸ K) →+ (M ⧸ K) := fun x => QuotientAddGroup.map K K (act x) (hK x)
    have hψ : ∀ x (y : M), ψ x (y : M ⧸ K) = ((act x y : M) : M ⧸ K) := fun x y => rfl
    letI : MulAction H (M ⧸ K) :=
      { smul := fun x q => ψ x q
        one_smul := by
          intro q
          induction q using QuotientAddGroup.induction_on with
          | H y =>
            show ψ 1 (y : M ⧸ K) = y
            rw [hψ, map_one]
            rfl
        mul_smul := by
          intro x z q
          induction q using QuotientAddGroup.induction_on with
          | H y =>
            show ψ (x * z) (y : M ⧸ K) = ψ x (ψ z y)
            rw [hψ, hψ, hψ, map_mul]
            rfl }
    have hsmul : ∀ x (y : M), x • (y : M ⧸ K) = ((act x y : M) : M ⧸ K) := fun x y => rfl
    obtain ⟨-, y, -, hy⟩ := SetLike.lt_iff_le_and_exists.mp (Ne.lt_top hKtop)
    have hy0 : (y : M ⧸ K) ≠ 0 := by
      rw [Ne, QuotientAddGroup.eq_zero_iff]
      exact hy
    have hyl : ℓ • (y : M ⧸ K) = 0 := by
      rw [← QuotientAddGroup.mk_nsmul, hM y, QuotientAddGroup.mk_zero]
    have hord : addOrderOf (y : M ⧸ K) = ℓ := addOrderOf_eq_prime hyl hy0
    have hdvd : ℓ ∣ Nat.card (M ⧸ K) := by
      rw [← hord]
      exact addOrderOf_dvd_natCard _
    have h0 : (0 : M ⧸ K) ∈ MulAction.fixedPoints H (M ⧸ K) := by
      intro x
      show ψ x 0 = 0
      exact map_zero _
    obtain ⟨b, hb, hb0⟩ :=
      hH.exists_fixed_point_of_prime_dvd_card_of_fixed_point (M ⧸ K) hdvd h0
    obtain ⟨v, rfl⟩ := QuotientAddGroup.mk_surjective b
    refine ⟨v, ?_, ?_⟩
    · intro hv
      apply hb0
      exact ((QuotientAddGroup.eq_zero_iff v).mpr hv).symm
    · intro x
      have h1 : ((act x v : M) : M ⧸ K) = (v : M ⧸ K) := by
        rw [← hsmul]
        exact hb x
      have h2 := QuotientAddGroup.eq.mp h1
      have h3 := K.neg_mem h2
      convert h3 using 1
      abel

  have s2 : ∀ (K : AddSubgroup M) (v : M), v ∉ K →
      ∃ π : M →+ ULift.{u+1} (ZMod ℓ), (∀ y ∈ K, π y = 0) ∧ π v = ULift.up 1 := by
    intro K v hv
    have hQ : ∀ q : M ⧸ K, ℓ • q = 0 := by
      intro q
      induction q using QuotientAddGroup.induction_on with
      | H y => rw [← QuotientAddGroup.mk_nsmul, hM y, QuotientAddGroup.mk_zero]
    letI : Module (ZMod ℓ) (M ⧸ K) := AddCommGroup.zmodModule (n := ℓ) hQ
    have hv0 : (v : M ⧸ K) ≠ 0 := by
      rw [Ne, QuotientAddGroup.eq_zero_iff]
      exact hv
    have hex : ∃ f : Module.Dual (ZMod ℓ) (M ⧸ K), f (v : M ⧸ K) ≠ 0 := by
      by_contra hcon
      push_neg at hcon
      exact hv0 ((Module.forall_dual_apply_eq_zero_iff (ZMod ℓ) (v : M ⧸ K)).mp hcon)
    obtain ⟨f, hfv⟩ := hex
    refine ⟨AddMonoidHom.mk' (fun y => ULift.up ((f (v : M ⧸ K))⁻¹ * f (y : M ⧸ K))) ?_, ?_, ?_⟩
    · intro a b
      apply ULift.ext
      simp [QuotientAddGroup.mk_add, mul_add]
    · intro y hy
      apply ULift.ext
      have h0 : (y : M ⧸ K) = 0 := (QuotientAddGroup.eq_zero_iff y).mpr hy
      simp [h0]
    · apply ULift.ext
      simp [inv_mul_cancel₀ hfv]

  have s4 : ∀ K : AddSubgroup M, (∀ x : H, ∀ y ∈ K, act x y ∈ K) →
      ∃ (n : ℕ) (Kc : ℕ → AddSubgroup M), Kc 0 = K ∧ Kc n = ⊤ ∧
      (∀ k, ∀ x : H, ∀ y ∈ Kc k, act x y ∈ Kc k) ∧
      ∀ k < n, Kc k ≤ Kc (k + 1) ∧ ∃ π : M →+ ULift.{u+1} (ZMod ℓ),
        (∀ y ∈ Kc (k + 1), π y = 0 ↔ y ∈ Kc k) ∧ (∃ y ∈ Kc (k + 1), π y = ULift.up 1) ∧
        (∀ x : H, ∀ y ∈ Kc (k + 1), π (act x y) = π y) := by
    intro K
    induction K using WellFoundedGT.induction with
    | _ K IH =>
    intro hK
    by_cases htop : K = ⊤
    · refine ⟨0, fun _ => ⊤, htop.symm, rfl, ?_, ?_⟩
      · intro k x y _
        exact AddSubgroup.mem_top _
      · intro k hk
        omega
    · obtain ⟨v, hvK, hv⟩ := s1 K hK htop
      obtain ⟨π, hπK, hπv⟩ := s2 K v hvK
      have hmem : ∀ y, y ∈ K ⊔ AddSubgroup.zmultiples v ↔ ∃ a ∈ K, ∃ m : ℤ, a + m • v = y := by
        intro y
        rw [AddSubgroup.mem_sup]
        constructor
        · rintro ⟨a, ha, z, hz, rfl⟩
          obtain ⟨m, rfl⟩ := AddSubgroup.mem_zmultiples_iff.mp hz
          exact ⟨a, ha, m, rfl⟩
        · rintro ⟨a, ha, m, rfl⟩
          exact ⟨a, ha, m • v, AddSubgroup.mem_zmultiples_iff.mpr ⟨m, rfl⟩, rfl⟩
      have hπval : ∀ a ∈ K, ∀ m : ℤ, π (a + m • v) = ULift.up (m : ZMod ℓ) := by
        intro a ha m
        rw [map_add, map_zsmul, hπK a ha, hπv, zero_add]
        apply ULift.ext
        simp
      have hvK' : v ∈ K ⊔ AddSubgroup.zmultiples v :=
        AddSubgroup.mem_sup_right (AddSubgroup.mem_zmultiples v)
      have hlt : K < K ⊔ AddSubgroup.zmultiples v :=
        lt_of_le_of_ne le_sup_left (fun h => hvK (h ▸ hvK'))
      have hrw : ∀ x : H, ∀ a : M, ∀ m : ℤ,
          act x (a + m • v) = (act x a + m • (act x v - v)) + m • v := by
        intro x a m
        rw [map_add, map_zsmul, smul_sub]
        abel
      have hstK' : ∀ x : H, ∀ y ∈ K ⊔ AddSubgroup.zmultiples v,
          act x y ∈ K ⊔ AddSubgroup.zmultiples v := by
        intro x y hy
        obtain ⟨a, ha, m, rfl⟩ := (hmem y).mp hy
        exact (hmem _).mpr ⟨act x a + m • (act x v - v),
          K.add_mem (hK x a ha) (K.zsmul_mem (hv x) m), m, (hrw x a m).symm⟩
      have hker : ∀ y ∈ K ⊔ AddSubgroup.zmultiples v, π y = 0 ↔ y ∈ K := by
        intro y hy
        refine ⟨fun h => ?_, fun h => hπK y h⟩
        obtain ⟨a, ha, m, rfl⟩ := (hmem y).mp hy
        rw [hπval a ha m] at h
        have hm0 : ((m : ZMod ℓ)) = 0 := congrArg ULift.down h
        obtain ⟨c, hc⟩ := (ZMod.intCast_zmod_eq_zero_iff_dvd m ℓ).mp hm0
        have hmv : m • v = 0 := by
          rw [hc, mul_comm, ← smul_smul, natCast_zsmul, hM v, smul_zero]
        rw [hmv, add_zero]
        exact ha
      have hinv : ∀ x : H, ∀ y ∈ K ⊔ AddSubgroup.zmultiples v, π (act x y) = π y := by
        intro x y hy
        obtain ⟨a, ha, m, rfl⟩ := (hmem y).mp hy
        rw [hrw x a m, hπval _ (K.add_mem (hK x a ha) (K.zsmul_mem (hv x) m)) m,
          hπval a ha m]
      obtain ⟨n, Kc', h0, hn, hst, hstep⟩ := IH _ hlt hstK'
      refine ⟨n + 1, fun k => match k with | 0 => K | j + 1 => Kc' j, rfl, hn, ?_, ?_⟩
      · intro k
        cases k with
        | zero => exact hK
        | succ j => exact hst j
      · intro k hk
        cases k with
        | zero =>
          rw [← h0] at hker hinv hvK' hlt
          exact ⟨hlt.le, π, hker, ⟨v, hvK', hπv⟩, hinv⟩
        | succ j => exact hstep j (by omega)

  have hbot : ∀ x : H, ∀ y ∈ (⊥ : AddSubgroup M), act x y ∈ (⊥ : AddSubgroup M) := by
    intro x y hy
    rw [AddSubgroup.mem_bot] at hy ⊢
    rw [hy, map_zero]
  exact s4 ⊥ hbot

theorem wc_gal_desc_step {X' E : Scheme.{u}} (Y' : X'.Opens) (ρ : E ⟶ (Y' : Scheme.{u}))
    (H : Type u) [Group H] (β : H →* Aut E) (hρ : wcGalCover ρ H β)
    (hβ : ∀ x, (β x).hom ≫ ρ ≫ Y'.ι = ρ ≫ Y'.ι) (ℓ : ℕ) (M : Type (u+1)) [AddCommGroup M]
    (act : H →* AddMonoid.End M) (K K' : AddSubgroup M)
    (hK : ∀ x : H, ∀ y ∈ K, act x y ∈ K) (hK' : ∀ x : H, ∀ y ∈ K', act x y ∈ K')
    (hle : K ≤ K') (π : M →+ ULift.{u+1} (ZMod ℓ)) (hπ0 : ∀ y ∈ K', π y = 0 ↔ y ∈ K)
    (hπ1 : ∃ y ∈ K', π y = ULift.up 1) (hπinv : ∀ x : H, ∀ y ∈ K', π (act x y) = π y) :
    ∃ S : ShortComplex (Sheaf (Scheme.smallEtaleTopology X') AddCommGrpCat.{u+1}),
      S.ShortExact ∧
      Nonempty (S.X₁ ≅ wcGalDesc (ρ ≫ Y'.ι) (Y' : Set X') H β hβ M act K) ∧
      Nonempty (S.X₂ ≅ wcGalDesc (ρ ≫ Y'.ι) (Y' : Set X') H β hβ M act K') ∧
      Nonempty (S.X₃ ≅ wcGalDesc (ρ ≫ Y'.ι) (Y' : Set X') H β hβ (ULift.{u+1} (ZMod ℓ)) 1 ⊤) :=
by
  classical
  haveI : Etale ρ := hρ.2.2.1
  haveI : AlgebraicGeometry.Surjective ρ := hρ.2.2.2.1
  obtain ⟨y₀, hy₀K', hy₀π⟩ := hπ1

  have hid : ∀ (N : Type (u+1)) [AddCommGroup N] (T : X'.Etale)
      (f : LocallyConstant ((wcEtBaseChange (ρ ≫ Y'.ι)).obj T).left N),
      wcGalRes (ρ ≫ Y'.ι) N (𝟙 T) f = f := by
    intro N _ T f
    show ((wcLCPb (ρ ≫ Y'.ι) N).map (𝟙 T).op).hom f = f
    rw [op_id, CategoryTheory.Functor.map_id]
    rfl

  have hR : ∀ {T T'' : X'.Etale} (c : T'' ⟶ T) (x : H),
      wcPbρ (ρ ≫ Y'.ι) (ρ ≫ Y'.ι) (β x).hom (hβ x) T'' ≫
          ((wcEtBaseChange (ρ ≫ Y'.ι)).map c).left =
        ((wcEtBaseChange (ρ ≫ Y'.ι)).map c).left ≫
          wcPbρ (ρ ≫ Y'.ι) (ρ ≫ Y'.ι) (β x).hom (hβ x) T := by
    intro T T'' c x
    have hc : (Limits.pullback.fst T''.hom (ρ ≫ Y'.ι) ≫ c.left) ≫ T.hom =
        Limits.pullback.snd T''.hom (ρ ≫ Y'.ι) ≫ (ρ ≫ Y'.ι) := by
      rw [Category.assoc, MorphismProperty.Over.w c]; exact Limits.pullback.condition
    have hx : ∀ (T₀ : X'.Etale), Limits.pullback.fst T₀.hom (ρ ≫ Y'.ι) ≫ T₀.hom =
        (Limits.pullback.snd T₀.hom (ρ ≫ Y'.ι) ≫ (β x).hom) ≫ (ρ ≫ Y'.ι) := by
      intro T₀; rw [Category.assoc, hβ x]; exact Limits.pullback.condition
    show Limits.pullback.lift (Limits.pullback.fst T''.hom (ρ ≫ Y'.ι))
          (Limits.pullback.snd T''.hom (ρ ≫ Y'.ι) ≫ (β x).hom) (hx T'') ≫
        Limits.pullback.lift (Limits.pullback.fst T''.hom (ρ ≫ Y'.ι) ≫ c.left)
          (Limits.pullback.snd T''.hom (ρ ≫ Y'.ι)) hc =
      Limits.pullback.lift (Limits.pullback.fst T''.hom (ρ ≫ Y'.ι) ≫ c.left)
          (Limits.pullback.snd T''.hom (ρ ≫ Y'.ι)) hc ≫
        Limits.pullback.lift (Limits.pullback.fst T.hom (ρ ≫ Y'.ι))
          (Limits.pullback.snd T.hom (ρ ≫ Y'.ι) ≫ (β x).hom) (hx T)
    apply Limits.pullback.hom_ext
    · simp only [Category.assoc, Limits.pullback.lift_fst, Limits.pullback.lift_fst_assoc]
    · simp only [Category.assoc, Limits.pullback.lift_snd, Limits.pullback.lift_snd_assoc]

  have s1 : ∀ (N : AddSubgroup M) (T : X'.Etale)
      (f : LocallyConstant ((wcEtBaseChange (ρ ≫ Y'.ι)).obj T).left M),
      (∀ y, f y ∈ N) →
      (∀ (x : H) (y : ((wcEtBaseChange (ρ ≫ Y'.ι)).obj T).left),
        f (wcPbρ (ρ ≫ Y'.ι) (ρ ≫ Y'.ι) (β x).hom (hβ x) T y) = act x (f y)) →
      (∀ t, T.hom t ∈ (Y' : Set X')) →
      f ∈ wcGalDescSub (ρ ≫ Y'.ι) (Y' : Set X') H β hβ M act N T := by
    intro N T f h1 h2 h3 T'' c
    have hm : ∀ y, wcGalRes (ρ ≫ Y'.ι) M c f y = f (((wcEtBaseChange (ρ ≫ Y'.ι)).map c).left y) :=
      fun _ => rfl
    refine ⟨fun y => by rw [hm]; exact h1 _, fun x y => ?_, Or.inr fun t => ?_⟩
    · rw [hm, hm, ← Scheme.Hom.comp_apply, hR c x, Scheme.Hom.comp_apply, h2]
    · rw [← MorphismProperty.Over.w c, Scheme.Hom.comp_apply]
      exact h3 _

  have hmul : ∀ a b : H, (β (a * b)).hom = (β b).hom ≫ (β a).hom := by
    intro a b; rw [map_mul, Aut.Aut_mul_def]; rfl
  obtain ⟨hα, hiso⟩ := hρ.2.2.2.2
  obtain ⟨Φ, hΦiso, hΦ1, hΦ2⟩ : ∃ Φ : ∐ (fun _ : H => E) ⟶ Limits.pullback ρ ρ, IsIso Φ ∧
      (∀ h : H, Limits.Sigma.ι (fun _ : H => E) h ≫ Φ ≫ Limits.pullback.fst ρ ρ = (β h).hom) ∧
      (∀ h : H, Limits.Sigma.ι (fun _ : H => E) h ≫ Φ ≫ Limits.pullback.snd ρ ρ = 𝟙 E) :=
    ⟨_, hiso, fun h => by rw [Limits.Sigma.ι_comp_desc_assoc, Limits.pullback.lift_fst],
      fun h => by rw [Limits.Sigma.ι_comp_desc_assoc, Limits.pullback.lift_snd]⟩
  obtain ⟨Θ, hΘ1, hΘ2⟩ : ∃ Θ : H → (Limits.pullback ρ ρ ⟶ Limits.pullback ρ ρ),
      (∀ x, Θ x ≫ Limits.pullback.fst ρ ρ = Limits.pullback.fst ρ ρ) ∧
      (∀ x, Θ x ≫ Limits.pullback.snd ρ ρ = Limits.pullback.snd ρ ρ ≫ (β x).hom) :=
    ⟨fun x => Limits.pullback.lift (Limits.pullback.fst ρ ρ) (Limits.pullback.snd ρ ρ ≫ (β x).hom)
      (by rw [Category.assoc, hα x]; exact Limits.pullback.condition),
