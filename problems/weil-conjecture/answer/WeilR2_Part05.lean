      exact ⟨k.unop, f.unop, g.unop, hk⟩
    · intro G φ A g
      exact Limits.colimit.ι_map_apply
        (Functor.whiskerLeft (StructuredArrow.proj (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B)).op φ.hom)
        (Opposite.op A) g
  intro B F hcof hlift V b b' t ht t' ht' hsp s

  have key : ∀ (A'' : StructuredArrow (Over.mk (wcEtGeomPt B b')) (Scheme.Etale.forget B))
      (f : A'' ⟶ StructuredArrow.mk (Over.homMk t' ht' : Over.mk (wcEtGeomPt B b') ⟶
        (Scheme.Etale.forget B).obj V)),
      ∃ (t₂ : Spec (.of (AlgebraicClosure (B.residueField b))) ⟶ A''.right.left)
        (ht₂ : t₂ ≫ A''.right.hom = wcEtGeomPt B b),
