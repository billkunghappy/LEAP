    have hW2 : A''.hom.left ≫ c.left = t' := by
      have := congrArg (fun φ => φ.left) (StructuredArrow.w f)
      exact this
    have hp : t (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField b))) ∈
