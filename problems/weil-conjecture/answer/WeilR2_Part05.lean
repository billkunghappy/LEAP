theorem wc_alg_gi_plane_model_abs_irreducible : ∀ (A B : Type u) [CommRing A] [IsDomain A] [CommRing B] [Algebra A B] (y z : B) (P : Polynomial (Polynomial A)), P.Monic → IsDomain (TensorProduct A B (AlgebraicClosure (FractionRing A))) → Polynomial.eval₂ (Polynomial.aeval (R := FractionRing A) ((1 : FractionRing A) ⊗ₜ[A] y : TensorProduct A (FractionRing A) B)).toRingHom ((1 : FractionRing A) ⊗ₜ[A] z) (P.map (Polynomial.mapRingHom (algebraMap A (FractionRing A)))) = 0 → (∀ G : Polynomial (Polynomial (FractionRing A)), G.natDegree < P.natDegree → Polynomial.eval₂ (Polynomial.aeval (R := FractionRing A) ((1 : FractionRing A) ⊗ₜ[A] y : TensorProduct A (FractionRing A) B)).toRingHom ((1 : FractionRing A) ⊗ₜ[A] z) G = 0 → G = 0) → Irreducible (P.map (Polynomial.mapRingHom (algebraMap A (AlgebraicClosure (FractionRing A))))) :=
by
  intro A B _ _ _ _ y z P hPm hGI hrel hmin
  classical
  haveI : IsDomain (TensorProduct A B (AlgebraicClosure (FractionRing A))) := hGI
  obtain ⟨β, hβ⟩ : ∃ β : Polynomial (AlgebraicClosure (FractionRing A)) →+*
      TensorProduct A B (AlgebraicClosure (FractionRing A)),
      β = Polynomial.eval₂RingHom (Algebra.TensorProduct.includeRight :
        AlgebraicClosure (FractionRing A) →ₐ[A] TensorProduct A B (AlgebraicClosure (FractionRing A))).toRingHom
        (y ⊗ₜ[A] (1 : AlgebraicClosure (FractionRing A))) := ⟨_, rfl⟩
  obtain ⟨Θb, hΘb⟩ : ∃ Θb : Polynomial (Polynomial (AlgebraicClosure (FractionRing A))) →+*
      TensorProduct A B (AlgebraicClosure (FractionRing A)),
      Θb = Polynomial.eval₂RingHom β (z ⊗ₜ[A] (1 : AlgebraicClosure (FractionRing A))) := ⟨_, rfl⟩
  obtain ⟨ΘK, hΘK⟩ : ∃ ΘK : Polynomial (Polynomial (FractionRing A)) →+* TensorProduct A (FractionRing A) B,
      ΘK = Polynomial.eval₂RingHom (Polynomial.aeval (R := FractionRing A)
        ((1 : FractionRing A) ⊗ₜ[A] y : TensorProduct A (FractionRing A) B)).toRingHom
        ((1 : FractionRing A) ⊗ₜ[A] z) := ⟨_, rfl⟩
  have hΘKapp : ∀ G, ΘK G = Polynomial.eval₂ (Polynomial.aeval (R := FractionRing A)
      ((1 : FractionRing A) ⊗ₜ[A] y : TensorProduct A (FractionRing A) B)).toRingHom
      ((1 : FractionRing A) ⊗ₜ[A] z) G := by
    intro G; rw [hΘK]; rfl
  obtain ⟨Φ, hΦ⟩ : ∃ Φ : TensorProduct A (FractionRing A) B →+*
      TensorProduct A B (AlgebraicClosure (FractionRing A)),
      Φ = ((Algebra.TensorProduct.comm A (AlgebraicClosure (FractionRing A)) B).toAlgHom.comp
        (Algebra.TensorProduct.map (IsScalarTower.toAlgHom A (FractionRing A)
          (AlgebraicClosure (FractionRing A))) (AlgHom.id A B))).toRingHom := ⟨_, rfl⟩
  have hΦtmul : ∀ (k : FractionRing A) (b : B), Φ (k ⊗ₜ[A] b) =
      b ⊗ₜ[A] algebraMap (FractionRing A) (AlgebraicClosure (FractionRing A)) k := by
    intro k b; rw [hΦ]; simp

  have hinner : β.comp (Polynomial.mapRingHom (algebraMap (FractionRing A)
      (AlgebraicClosure (FractionRing A)))) = Φ.comp (Polynomial.aeval (R := FractionRing A)
        ((1 : FractionRing A) ⊗ₜ[A] y : TensorProduct A (FractionRing A) B)).toRingHom := by
    apply Polynomial.ringHom_ext
    · intro k
      simp [hβ, hΦtmul, Algebra.TensorProduct.algebraMap_apply]
    · simp [hβ, hΦtmul]
  have hs2 : Θb.comp (Polynomial.mapRingHom (Polynomial.mapRingHom (algebraMap (FractionRing A)
      (AlgebraicClosure (FractionRing A))))) = Φ.comp ΘK := by
    apply Polynomial.ringHom_ext
    · intro a
      have h := congrArg (fun f => f a) hinner
      simp only [RingHom.comp_apply] at h ⊢
      rw [Polynomial.coe_mapRingHom, Polynomial.map_C, hΘb, Polynomial.coe_eval₂RingHom,
        Polynomial.eval₂_C, hΘKapp, Polynomial.eval₂_C]
      exact h
    · simp only [RingHom.comp_apply]
      rw [Polynomial.coe_mapRingHom, Polynomial.map_X, hΘb, Polynomial.coe_eval₂RingHom,
        Polynomial.eval₂_X, hΘKapp, Polynomial.eval₂_X, hΦtmul, map_one]

  have hPKb : P.map (Polynomial.mapRingHom (algebraMap A (AlgebraicClosure (FractionRing A)))) =
      (P.map (Polynomial.mapRingHom (algebraMap A (FractionRing A)))).map
        (Polynomial.mapRingHom (algebraMap (FractionRing A) (AlgebraicClosure (FractionRing A)))) := by
    rw [Polynomial.map_map, Polynomial.mapRingHom_comp, ← IsScalarTower.algebraMap_eq]
  have hs5 : Θb (P.map (Polynomial.mapRingHom (algebraMap A (AlgebraicClosure (FractionRing A))))) = 0 := by
    rw [hPKb]
    have h := congrArg (fun f => f (P.map (Polynomial.mapRingHom (algebraMap A (FractionRing A))))) hs2
    simp only [RingHom.comp_apply, Polynomial.coe_mapRingHom] at h
    rw [h, hΘKapp, hrel, map_zero]

  have hmin' : ∀ R : Polynomial (Polynomial (AlgebraicClosure (FractionRing A))),
      R.natDegree < (P.map (Polynomial.mapRingHom
        (algebraMap A (AlgebraicClosure (FractionRing A))))).natDegree → Θb R = 0 → R = 0 := by
    intro R hR hΘR
    rw [hPm.natDegree_map] at hR
    have hall : ∀ (l : Module.Dual (FractionRing A) (AlgebraicClosure (FractionRing A))) (i j : ℕ),
        l ((R.coeff i).coeff j) = 0 := by
      intro l
      obtain ⟨g1, hg1⟩ : ∃ g1 : Polynomial (AlgebraicClosure (FractionRing A)) →
          Polynomial (FractionRing A), ∀ c j, (g1 c).coeff j = l (c.coeff j) :=
        ⟨fun c => ∑ j ∈ c.support, Polynomial.monomial j (l (c.coeff j)), fun c j => by
          rw [Polynomial.finsetSum_coeff]
          by_cases h : c.coeff j = 0
          · simp [Polynomial.coeff_monomial, h]
          · simp [Polynomial.coeff_monomial, h]⟩
      have hg10 : g1 0 = 0 := Polynomial.ext fun j => by
        rw [hg1, Polynomial.coeff_zero, map_zero, Polynomial.coeff_zero]
      obtain ⟨g2, hg2⟩ : ∃ g2 : Polynomial (Polynomial (AlgebraicClosure (FractionRing A))) →
          Polynomial (Polynomial (FractionRing A)), ∀ R i, (g2 R).coeff i = g1 (R.coeff i) :=
        ⟨fun R => ∑ i ∈ R.support, Polynomial.monomial i (g1 (R.coeff i)), fun R i => by
          rw [Polynomial.finsetSum_coeff]
          by_cases h : R.coeff i = 0
          · simp [Polynomial.coeff_monomial, h, hg10]
          · simp [Polynomial.coeff_monomial, h]⟩
      have hcoef : ∀ R i j, ((g2 R).coeff i).coeff j = l ((R.coeff i).coeff j) := by
        intro R i j; rw [hg2, hg1]
      have hg2add : ∀ p q, g2 (p + q) = g2 p + g2 q := by
        intro p q
        ext i j
        simp only [hcoef, Polynomial.coeff_add, map_add]
      have hg2mon : ∀ i j c, g2 (Polynomial.monomial i (Polynomial.monomial j c)) =
          Polynomial.monomial i (Polynomial.monomial j (l c)) := by
        intro i j c
        ext i' j'
        rw [hcoef]
        rcases eq_or_ne i i' with rfl | h1 <;> rcases eq_or_ne j j' with rfl | h2 <;>
          simp [Polynomial.coeff_monomial, *]
      obtain ⟨T, hTt⟩ : ∃ T : TensorProduct A B (AlgebraicClosure (FractionRing A)) →ₗ[A]
          TensorProduct A (FractionRing A) B, ∀ b c, T (b ⊗ₜ[A] c) = l c ⊗ₜ[A] b :=
        ⟨(LinearMap.rTensor B (l.restrictScalars A)) ∘ₗ
          (TensorProduct.comm A B (AlgebraicClosure (FractionRing A))).toLinearMap, fun b c => by
          simp⟩
      have hT : ∀ R, ΘK (g2 R) = T (Θb R) := by
        intro R
        induction R using Polynomial.induction_on' with
        | add p q hp hq => rw [hg2add, map_add, map_add, map_add, hp, hq]
        | monomial i a =>
          induction a using Polynomial.induction_on' with
          | add a1 a2 h1 h2 =>
            rw [map_add (Polynomial.monomial i) a1 a2, hg2add, map_add, map_add, h1, h2, map_add]
          | monomial j c =>
            rw [hg2mon]
            have e1 : Θb (Polynomial.monomial i (Polynomial.monomial j c)) =
                (y ^ j * z ^ i) ⊗ₜ[A] c := by
              rw [hΘb, hβ]
              simp [Algebra.TensorProduct.tmul_pow, Algebra.TensorProduct.tmul_mul_tmul]
            have e2 : ΘK (Polynomial.monomial i (Polynomial.monomial j (l c))) =
                l c ⊗ₜ[A] (y ^ j * z ^ i) := by
              rw [hΘKapp]
              simp [Algebra.TensorProduct.tmul_pow, Algebra.TensorProduct.tmul_mul_tmul,
                Algebra.TensorProduct.algebraMap_apply]
            rw [e1, e2, hTt]
      have hdeg : (g2 R).natDegree ≤ R.natDegree := by
        refine Polynomial.natDegree_le_iff_coeff_eq_zero.mpr fun N hN => ?_
        ext j
        rw [hcoef, Polynomial.coeff_eq_zero_of_natDegree_lt hN]
        simp
      have hz : g2 R = 0 := hmin (g2 R) (lt_of_le_of_lt hdeg hR)
        (by rw [← hΘKapp, hT, hΘR, map_zero])
      intro i j
      rw [← hcoef, hz]
      simp
    ext i j
    rw [Polynomial.coeff_zero, Polynomial.coeff_zero]
    exact (Module.forall_dual_apply_eq_zero_iff (FractionRing A) _).mp (fun l => hall l i j)

  have hirr : ∀ Q : Polynomial (Polynomial (AlgebraicClosure (FractionRing A))), Q.Monic →
      Θb Q = 0 → (∀ R, R.natDegree < Q.natDegree → Θb R = 0 → R = 0) → Irreducible Q := by
    intro Q hQ hQ0 hQmin
    have hQ1 : Q ≠ 1 := by
      rintro rfl
      rw [map_one] at hQ0
      exact one_ne_zero hQ0
    have hker : RingHom.ker Θb = Ideal.span {Q} := by
      ext G
      rw [RingHom.mem_ker, Ideal.mem_span_singleton]
      constructor
      · intro hG
        have h1 : G %ₘ Q + Q * (G /ₘ Q) = G := Polynomial.modByMonic_add_div G Q
        have h2 : Θb (G %ₘ Q) = 0 := by
          have := congrArg Θb h1
          rw [map_add, map_mul, hQ0, zero_mul, add_zero, hG] at this
          exact this
        have h3 := hQmin _ (Polynomial.natDegree_modByMonic_lt G hQ hQ1) h2
        exact (Polynomial.modByMonic_eq_zero_iff_dvd hQ).mp h3
      · rintro ⟨c, rfl⟩
        rw [map_mul, hQ0, zero_mul]
    have hprime : (Ideal.span {Q}).IsPrime := hker ▸ RingHom.ker_isPrime Θb
    exact ((Ideal.span_singleton_prime hQ.ne_zero).mp hprime).irreducible
  exact hirr _ (hPm.map _) hs5 hmin'

theorem wc_alg_gi_spread_injective : ∀ (A B : Type u) [CommRing A] [IsDomain A] [CommRing B] [Algebra A B] [Algebra.FiniteType A B] (y : B), IsDomain (TensorProduct A (FractionRing A) B) → Function.Injective (Polynomial.aeval (R := FractionRing A) ((1 : FractionRing A) ⊗ₜ[A] y : TensorProduct A (FractionRing A) B)) → (∀ x : TensorProduct A (FractionRing A) B, ∃ F : Polynomial (Polynomial (FractionRing A)), F.Monic ∧ Polynomial.eval₂ (Polynomial.aeval (R := FractionRing A) ((1 : FractionRing A) ⊗ₜ[A] y : TensorProduct A (FractionRing A) B)).toRingHom x F = 0) → ∃ a : A, a ≠ 0 ∧ ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (ψ : A →+* Ω), ψ a ≠ 0 → letI := ψ.toAlgebra; Function.Injective (Polynomial.eval₂RingHom (Algebra.TensorProduct.includeRight : Ω →ₐ[A] TensorProduct A B Ω).toRingHom (y ⊗ₜ[A] (1 : Ω))) :=
by

  have G1 : ∀ (B D S M : Type u) [CommRing B] [CommRing D] [CommRing S] [Field M]
      (κ : B →+* D) (ι : S →+* D) (χ : S →+* M) (u : S), Function.Injective ι →
      (∀ b : B, ∃ N : ℕ, ∃ t : S, ι t = ι u ^ N * κ b) → χ u ≠ 0 →
      ∃ β : B →+* M, ∀ (b : B) (n : ℕ) (t : S), ι t = ι u ^ n * κ b →
        β b * χ u ^ n = χ t := by
    intro B D S M _ _ _ _ κ ι χ u hι hpow hv
    choose N t ht using hpow
    have hkey : ∀ (b : B) (n : ℕ) (t' : S), ι t' = ι u ^ n * κ b →
        χ (t b) * (χ u ^ N b)⁻¹ * χ u ^ n = χ t' := by
      intro b n t' ht'
      have e : t b * u ^ n = t' * u ^ N b := hι (by
        rw [map_mul, map_mul, map_pow, map_pow, ht, ht']; ring)
      have e2 := congrArg χ e
      rw [map_mul, map_mul, map_pow, map_pow] at e2
      have hvN : χ u ^ N b ≠ 0 := pow_ne_zero _ hv
      calc χ (t b) * (χ u ^ N b)⁻¹ * χ u ^ n = (χ (t b) * χ u ^ n) * (χ u ^ N b)⁻¹ := by ring
        _ = χ t' * χ u ^ N b * (χ u ^ N b)⁻¹ := by rw [e2]
        _ = χ t' := by rw [mul_assoc, mul_inv_cancel₀ hvN, mul_one]
    obtain ⟨β₀, hβ₀⟩ : ∃ β₀ : B → M, ∀ (b : B) (n : ℕ) (t' : S), ι t' = ι u ^ n * κ b →
        β₀ b * χ u ^ n = χ t' := ⟨_, hkey⟩
    refine ⟨{ toFun := β₀
              map_one' := ?_
              map_mul' := ?_
              map_zero' := ?_
              map_add' := ?_ }, hβ₀⟩
    · have h := hβ₀ 1 0 1 (by rw [map_one, pow_zero, map_one, one_mul])
      rw [pow_zero, mul_one, map_one] at h
      exact h
    · intro b b'
      have h1 := hβ₀ (b * b') (N b + N b') (t b * t b') (by
        rw [map_mul, ht, ht, map_mul, pow_add]; ring)
      have h2 := hβ₀ b (N b) (t b) (ht b)
      have h3 := hβ₀ b' (N b') (t b') (ht b')
      apply mul_right_cancel₀ (pow_ne_zero (N b + N b') hv)
      change β₀ (b * b') * _ = β₀ b * β₀ b' * _
      rw [h1, map_mul, ← h2, ← h3, pow_add]
      ring
    · have h := hβ₀ 0 0 0 (by simp)
      rw [pow_zero, mul_one, map_zero] at h
      exact h
    · intro b b'
      have h1 := hβ₀ (b + b') (N b + N b') (u ^ N b' * t b + u ^ N b * t b') (by
        rw [map_add, map_mul, map_mul, map_pow, map_pow, ht, ht, map_add, pow_add]; ring)
      have h2 := hβ₀ b (N b) (t b) (ht b)
      have h3 := hβ₀ b' (N b') (t b') (ht b')
      apply mul_right_cancel₀ (pow_ne_zero (N b + N b') hv)
      change β₀ (b + b') * _ = (β₀ b + β₀ b') * _
      rw [h1, map_add, map_mul, map_mul, map_pow, map_pow, ← h2, ← h3, pow_add]
      ring

  have G2 : ∀ (A B Ω M : Type u) [CommRing A] [CommRing B] [Algebra A B] [Field Ω] [CommRing M]
      (ψ : A →+* Ω) (y : B) (j : Polynomial Ω →+* M) (β : B →+* M), Function.Injective j →
      (∀ r : A, β (algebraMap A B r) = j (Polynomial.C (ψ r))) → β y = j Polynomial.X →
      letI := ψ.toAlgebra; Function.Injective (Polynomial.eval₂RingHom
        (Algebra.TensorProduct.includeRight : Ω →ₐ[A] TensorProduct A B Ω).toRingHom
        (y ⊗ₜ[A] (1 : Ω))) := by
    intro A B Ω M _ _ _ _ _ ψ y j β hj hβA hβy
    letI := ψ.toAlgebra
    letI algAM : Algebra A M := (j.comp (Polynomial.C.comp ψ)).toAlgebra
    let fβ : B →ₐ[A] M := { β with commutes' := fun r => hβA r }
    let gΩ : Ω →ₐ[A] M := { j.comp Polynomial.C with commutes' := fun r => rfl }
    let Λ := Algebra.TensorProduct.productMap fβ gΩ
    have hΛ : Λ.toRingHom.comp (Polynomial.eval₂RingHom
        (Algebra.TensorProduct.includeRight : Ω →ₐ[A] TensorProduct A B Ω).toRingHom
        (y ⊗ₜ[A] (1 : Ω))) = j := by
      refine Polynomial.ringHom_ext (fun ω => ?_) ?_
      · rw [RingHom.comp_apply, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
        change Λ ((1 : B) ⊗ₜ[A] ω) = j (Polynomial.C ω)
        rw [Algebra.TensorProduct.productMap_apply_tmul, map_one, one_mul]
        rfl
      · rw [RingHom.comp_apply, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X]
        change Λ (y ⊗ₜ[A] (1 : Ω)) = j Polynomial.X
        rw [Algebra.TensorProduct.productMap_apply_tmul, map_one, mul_one]
        exact hβy
    intro p q hpq
    apply hj
    rw [← hΛ]
    exact congrArg Λ.toRingHom hpq

  have G3 : ∀ (P D : Type u) [CommRing P] [IsDomain P] [CommRing D] [IsDomain D] (φ : P →+* D),
      Function.Injective φ → ∃ c : P, c ≠ 0 ∧ ∀ (M : Type u) [Field M] [IsAlgClosed M]
        (χ : P →+* M), χ c ≠ 0 → ∃ (S : Type u) (_ : CommRing S) (ι : S →+* D) (χ' : S →+* M),
          Function.Injective ι ∧ (∀ p : P, ∃ s : S, ι s = φ p ∧ χ' s = χ p) ∧
          (∀ e : D, φ.IsIntegralElem e → ∃ s : S, ι s = e) := by
    intro P D _ _ _ _ φ hφ
    letI : Algebra P D := φ.toAlgebra
    let R₀ := integralClosure P D
    have hinj : Function.Injective (algebraMap P R₀) := fun p q h => hφ (congrArg Subtype.val h)
    have h1 : (1 : R₀) ≠ 0 := one_ne_zero
    obtain ⟨c, hc, hext⟩ := wc_alg_extend_hom_integral P R₀ hinj inferInstance 1 h1
    refine ⟨c, hc, fun M _ _ χ hχ => ?_⟩
    obtain ⟨χ', hχ', -⟩ := hext M χ hχ
    refine ⟨R₀, inferInstance, R₀.val.toRingHom, χ', Subtype.val_injective,
      fun p => ⟨algebraMap P R₀ p, rfl, by rw [← hχ']; rfl⟩, fun e he => ⟨⟨e, he⟩, rfl⟩⟩
  intro A B _ _ _ _ _ y hD hinj hint
  classical
  let K := FractionRing A
  let D := TensorProduct A K B
  let κ : B →ₐ[A] D := Algebra.TensorProduct.includeRight
  let f : Polynomial K →ₐ[K] D := Polynomial.aeval ((1 : K) ⊗ₜ[A] y : D)
  let φ₀ : Polynomial A →+* D := Polynomial.eval₂RingHom (algebraMap A D) (κ y)
  have hφC : ∀ r : A, φ₀ (Polynomial.C r) = algebraMap A D r := fun r => by
    simp [φ₀]
  have hφX : φ₀ Polynomial.X = κ y := by simp [φ₀]
  have hφ₀ : φ₀ = f.toRingHom.comp (Polynomial.mapRingHom (algebraMap A K)) := by
    refine Polynomial.ringHom_ext (fun r => ?_) ?_
    · rw [hφC]
      simp only [RingHom.coe_comp, Function.comp_apply, Polynomial.coe_mapRingHom,
        Polynomial.map_C, AlgHom.toRingHom_eq_coe, RingHom.coe_coe, f, Polynomial.aeval_C]
      exact IsScalarTower.algebraMap_apply A K D r
    · rw [hφX]
      simp [f]
      rfl
  have hφinj : Function.Injective φ₀ := by
    rw [hφ₀]
    exact hinj.comp (Polynomial.map_injective _ (IsFractionRing.injective A K))

  have hden : ∀ x : D, ∃ d : A, d ≠ 0 ∧ φ₀.IsIntegralElem (algebraMap A D d * x) := by
    intro x
    letI algAK : Algebra (Polynomial A) (Polynomial K) := Polynomial.algebra A K
    letI algAD : Algebra (Polynomial A) D := φ₀.toAlgebra
    letI algKD : Algebra (Polynomial K) D := f.toRingHom.toAlgebra
    haveI : IsScalarTower (Polynomial A) (Polynomial K) D :=
      IsScalarTower.of_algebraMap_eq (fun p => by
        change φ₀ p = f (Polynomial.map (algebraMap A K) p)
        rw [hφ₀]; rfl)
    obtain ⟨F, hFm, hF⟩ := hint x
    have hxK : IsIntegral (Polynomial K) x := ⟨F, hFm, hF⟩
    haveI : IsLocalization (Submonoid.map (Polynomial.C : A →+* Polynomial A)
        (nonZeroDivisors A)) (Polynomial K) :=
      Polynomial.isLocalization (nonZeroDivisors A) K
    obtain ⟨⟨m, hm⟩, hmx⟩ := IsIntegral.exists_multiple_integral_of_isLocalization
      (Submonoid.map (Polynomial.C : A →+* Polynomial A) (nonZeroDivisors A)) x hxK
    obtain ⟨d, hd, rfl⟩ := Submonoid.mem_map.mp hm
    refine ⟨d, nonZeroDivisors.ne_zero hd, ?_⟩
    have e : (⟨Polynomial.C d, hm⟩ : Submonoid.map (Polynomial.C : A →+* Polynomial A)
        (nonZeroDivisors A)) • x = algebraMap A D d * x := by
      rw [Submonoid.smul_def, Algebra.smul_def]
      change φ₀ (Polynomial.C d) * x = _
      rw [hφC]
    rw [← e]
    exact hmx
  have hconst : ∀ r : A, φ₀.IsIntegralElem (algebraMap A D r) := fun r => by
    rw [← hφC]
    exact φ₀.isIntegralElem_map

  obtain ⟨s, hs⟩ := Algebra.FiniteType.out (R := A) (A := B)
  choose d hd0 hdint using hden
  let u : A := ∏ b ∈ s, d (κ b)
  have hu0 : u ≠ 0 := Finset.prod_ne_zero_iff.mpr (fun b _ => hd0 _)
  have huint : ∀ b ∈ s, φ₀.IsIntegralElem (algebraMap A D u * κ b) := by
    intro b hb
    have e : algebraMap A D u * κ b =
        algebraMap A D (∏ b' ∈ s.erase b, d (κ b')) * (algebraMap A D (d (κ b)) * κ b) := by
      simp only [u]
      rw [← Finset.mul_prod_erase s (fun b' => d (κ b')) hb, map_mul]
      ring
    rw [e]
    exact RingHom.IsIntegralElem.mul φ₀ (hconst _) (hdint _)

  obtain ⟨c, hc0, hext⟩ := G3 (Polynomial A) D φ₀ hφinj
  refine ⟨u * c.leadingCoeff, mul_ne_zero hu0 (Polynomial.leadingCoeff_ne_zero.mpr hc0), ?_⟩
  intro Ω _ _ ψ hψ
  rw [map_mul] at hψ
  obtain ⟨hψu, hψc⟩ := mul_ne_zero_iff.mp hψ

  let F₀ := FractionRing (Polynomial Ω)
  let M := AlgebraicClosure F₀
  let j : Polynomial Ω →+* M := (algebraMap F₀ M).comp (algebraMap (Polynomial Ω) F₀)
  have hj : Function.Injective j :=
    (algebraMap F₀ M).injective.comp (IsFractionRing.injective (Polynomial Ω) F₀)
  let χ : Polynomial A →+* M := j.comp (Polynomial.mapRingHom ψ)
  have hχc : χ c ≠ 0 := by
    have hmap : c.map ψ ≠ 0 := by
      intro h
      have h2 := congrArg (fun p => Polynomial.coeff p c.natDegree) h
      simp only [Polynomial.coeff_map, Polynomial.coeff_zero] at h2
      exact hψc h2
    exact (map_ne_zero_iff j hj).mpr hmap
  obtain ⟨S, _, ι, χ', hι, hSφ, hSint⟩ := hext M χ hχc
  obtain ⟨uS, huS, hχu⟩ := hSφ (Polynomial.C u)
  rw [hφC] at huS

  have hpow : ∀ b : B, ∃ N : ℕ, ∃ t : S, ι t = ι uS ^ N * κ b := by
    intro b
    have hb : b ∈ Algebra.adjoin A (s : Set B) := by rw [hs]; trivial
    induction hb using Algebra.adjoin_induction with
    | mem x hx =>
      obtain ⟨t, ht⟩ := hSint _ (huint x hx)
      exact ⟨1, t, by rw [ht, pow_one, huS]⟩
    | algebraMap r =>
      obtain ⟨t, ht, -⟩ := hSφ (Polynomial.C r)
      refine ⟨0, t, ?_⟩
      rw [ht, pow_zero, one_mul, AlgHom.commutes]
      exact hφC r
    | add x x' _ _ hx hx' =>
      obtain ⟨N, t, ht⟩ := hx
      obtain ⟨N', t', ht'⟩ := hx'
      refine ⟨N + N', uS ^ N' * t + uS ^ N * t', ?_⟩
      rw [map_add, map_mul, map_mul, map_pow, map_pow, ht, ht', map_add, pow_add]
      ring
    | mul x x' _ _ hx hx' =>
      obtain ⟨N, t, ht⟩ := hx
      obtain ⟨N', t', ht'⟩ := hx'
      refine ⟨N + N', t * t', ?_⟩
      rw [map_mul, ht, ht', map_mul, pow_add]
      ring
  have hv : χ' uS ≠ 0 := by
    rw [hχu]
    simp only [χ, RingHom.coe_comp, Function.comp_apply, Polynomial.coe_mapRingHom,
      Polynomial.map_C]
    exact (map_ne_zero_iff j hj).mpr (Polynomial.C_ne_zero.mpr hψu)
  obtain ⟨β, hβ⟩ := G1 B D S M κ.toRingHom ι χ' uS hι hpow hv
  have hβA : ∀ r : A, β (algebraMap A B r) = j (Polynomial.C (ψ r)) := by
    intro r
    obtain ⟨t, ht, hχt⟩ := hSφ (Polynomial.C r)
    have := hβ (algebraMap A B r) 0 t (by
      rw [ht, pow_zero, one_mul, hφC]
      exact (κ.commutes r).symm)
    rw [pow_zero, mul_one, hχt] at this
    rw [this]
    simp [χ]
  have hβy : β y = j Polynomial.X := by
    obtain ⟨t, ht, hχt⟩ := hSφ Polynomial.X
    have := hβ y 0 t (by rw [ht, pow_zero, one_mul, hφX]; rfl)
    rw [pow_zero, mul_one, hχt] at this
    rw [this]
    simp [χ]
  exact G2 A B Ω M ψ y j β hj hβA hβy

theorem wc_alg_gi_spread_relations : ∀ (A B : Type u) [CommRing A] [IsDomain A] [CommRing B] [Algebra A B] [Algebra.FiniteType A B] (y z : B) (P : Polynomial (Polynomial A)) (q : ℕ), (q = 1 ∨ ∃ p k : ℕ, p.Prime ∧ CharP A p ∧ q = p ^ k) → (∀ x : TensorProduct A (FractionRing A) B, ∃ F : Polynomial (Polynomial (FractionRing A)), F.Monic ∧ Polynomial.eval₂ (Polynomial.aeval (R := FractionRing A) ((1 : FractionRing A) ⊗ₜ[A] y : TensorProduct A (FractionRing A) B)).toRingHom x F = 0) → Polynomial.eval₂ (Polynomial.aeval (R := FractionRing A) ((1 : FractionRing A) ⊗ₜ[A] y : TensorProduct A (FractionRing A) B)).toRingHom ((1 : FractionRing A) ⊗ₜ[A] z) (P.map (Polynomial.mapRingHom (algebraMap A (FractionRing A)))) = 0 → (∀ x : TensorProduct A (FractionRing A) B, ∃ (s : Polynomial (FractionRing A)) (h : Polynomial (Polynomial (FractionRing A))), s ≠ 0 ∧ Polynomial.aeval (R := FractionRing A) ((1 : FractionRing A) ⊗ₜ[A] y : TensorProduct A (FractionRing A) B) s * x ^ q = Polynomial.eval₂ (Polynomial.aeval (R := FractionRing A) ((1 : FractionRing A) ⊗ₜ[A] y : TensorProduct A (FractionRing A) B)).toRingHom ((1 : FractionRing A) ⊗ₜ[A] z) h) → ∃ a : A, a ≠ 0 ∧ ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (ψ : A →+* Ω), ψ a ≠ 0 → letI := ψ.toAlgebra; (Polynomial.eval₂RingHom (Algebra.TensorProduct.includeRight : Ω →ₐ[A] TensorProduct A B Ω).toRingHom (y ⊗ₜ[A] (1 : Ω))).IsIntegral ∧ Polynomial.eval₂ (Polynomial.eval₂RingHom (Algebra.TensorProduct.includeRight : Ω →ₐ[A] TensorProduct A B Ω).toRingHom (y ⊗ₜ[A] (1 : Ω))) (z ⊗ₜ[A] (1 : Ω)) (P.map (Polynomial.mapRingHom ψ)) = 0 ∧ ∀ x : TensorProduct A B Ω, ∃ (s : Polynomial Ω) (h : Polynomial (Polynomial Ω)), s ≠ 0 ∧ Polynomial.eval₂RingHom (Algebra.TensorProduct.includeRight : Ω →ₐ[A] TensorProduct A B Ω).toRingHom (y ⊗ₜ[A] (1 : Ω)) s * x ^ q = Polynomial.eval₂ (Polynomial.eval₂RingHom (Algebra.TensorProduct.includeRight : Ω →ₐ[A] TensorProduct A B Ω).toRingHom (y ⊗ₜ[A] (1 : Ω))) (z ⊗ₜ[A] (1 : Ω)) h :=
by
  intro A B _ _ _ _ _ y z P q hchar hint hrel hexp
  classical

  have H1 : ∀ b : B, ((1 : FractionRing A) ⊗ₜ[A] b : TensorProduct A (FractionRing A) B) = 0 →
      ∃ e : A, e ≠ 0 ∧ ∀ (Ω : Type u) [Field Ω] (ψ : A →+* Ω), ψ e ≠ 0 →
        letI := ψ.toAlgebra; (b ⊗ₜ[A] (1 : Ω) : TensorProduct A B Ω) = 0 := by
    intro b hb
    have hloc : IsLocalizedModule (nonZeroDivisors A)
        (TensorProduct.mk A (FractionRing A) B 1) :=
      (isLocalizedModule_iff_isBaseChange (nonZeroDivisors A) (FractionRing A) _).mpr
        (TensorProduct.isBaseChange A B (FractionRing A))
    obtain ⟨c, hc⟩ := IsLocalizedModule.exists_of_eq (S := nonZeroDivisors A)
      (f := TensorProduct.mk A (FractionRing A) B 1) (x₁ := b) (x₂ := 0)
      (by rw [map_zero]; exact hb)
    refine ⟨c, nonZeroDivisors.coe_ne_zero c, fun Ω _ ψ hψ => ?_⟩
    letI := ψ.toAlgebra
    have h1 : (c : A) • b = 0 := by
      rw [smul_zero] at hc; exact hc
    have h2 : (1 : Ω) = (c : A) • (ψ c)⁻¹ := by
      rw [Algebra.smul_def, RingHom.algebraMap_toAlgebra, mul_inv_cancel₀ hψ]
    rw [h2, ← TensorProduct.smul_tmul, h1, TensorProduct.zero_tmul]

  have H2 : ∀ {C' D E : Type u} [CommRing C'] [CommRing D] [CommRing E] [Algebra A C']
      (σ : A →+* E) (Φ : Polynomial E →+* D) (f : C' →+* D),
      (∀ a : A, f (algebraMap A C' a) = Φ (Polynomial.C (σ a))) → ∀ (y' w : C'),
      f y' = Φ Polynomial.X →
      (∀ s : Polynomial A, f (Polynomial.aeval y' s) = Φ (s.map σ)) ∧
      ∀ G : Polynomial (Polynomial A),
        f (Polynomial.eval₂ (Polynomial.aeval (R := A) y').toRingHom w G) =
        Polynomial.eval₂ Φ (f w) (G.map (Polynomial.mapRingHom σ)) := by
    intro C' D E _ _ _ _ σ Φ f hf y' w hy
    have key : f.comp (Polynomial.aeval (R := A) y').toRingHom =
        Φ.comp (Polynomial.mapRingHom σ) := by
      apply Polynomial.ringHom_ext
      · intro a; simp [hf]
      · simp [hy]
    refine ⟨fun s => RingHom.congr_fun key s, fun G => ?_⟩
    rw [Polynomial.hom_eval₂, Polynomial.eval₂_map, key]

  have H3 : ∀ F : Polynomial (Polynomial (FractionRing A)), ∃ (d : A) (G : Polynomial (Polynomial A)),
      d ≠ 0 ∧ G.map (Polynomial.mapRingHom (algebraMap A (FractionRing A))) =
        Polynomial.C (Polynomial.C (algebraMap A (FractionRing A) d)) * F := by
    intro F
    obtain ⟨b, hb⟩ := IsLocalization.exist_integer_multiples_of_finset (nonZeroDivisors A)
      (F.support.biUnion (fun i => (F.coeff i).support.image (fun j => (F.coeff i).coeff j)))
    have hlift : Polynomial.C (Polynomial.C (algebraMap A (FractionRing A) b)) * F ∈
        Polynomial.lifts (Polynomial.mapRingHom (algebraMap A (FractionRing A))) := by
      rw [Polynomial.lifts_iff_coeff_lifts]
      intro i
      rw [Polynomial.coeff_C_mul]
      have : Polynomial.C (algebraMap A (FractionRing A) b) * F.coeff i ∈
          Polynomial.lifts (algebraMap A (FractionRing A)) := by
        rw [Polynomial.lifts_iff_coeff_lifts]
        intro j
        rw [Polynomial.coeff_C_mul]
        by_cases hij : (F.coeff i).coeff j = 0
        · rw [hij, mul_zero]; exact ⟨0, map_zero _⟩
        · have hi : i ∈ F.support := by
            rw [Polynomial.mem_support_iff]; intro h; apply hij; rw [h, Polynomial.coeff_zero]
          obtain ⟨a, ha⟩ := hb ((F.coeff i).coeff j) (Finset.mem_biUnion.mpr
            ⟨i, hi, Finset.mem_image.mpr ⟨j, Polynomial.mem_support_iff.mpr hij, rfl⟩⟩)
          exact ⟨a, by rw [ha, Algebra.smul_def]⟩
      obtain ⟨g, hg⟩ := (Polynomial.mem_lifts _).mp this
      exact ⟨g, by rw [Polynomial.coe_mapRingHom]; exact hg⟩
    obtain ⟨G, hG⟩ := (Polynomial.mem_lifts _).mp hlift
    exact ⟨b, G, nonZeroDivisors.coe_ne_zero b, hG⟩

  have HK : ∀ w : B, (∀ s : Polynomial A,
      ((1 : FractionRing A) ⊗ₜ[A] Polynomial.aeval y s : TensorProduct A (FractionRing A) B) =
        Polynomial.aeval ((1 : FractionRing A) ⊗ₜ[A] y : TensorProduct A (FractionRing A) B)
          (s.map (algebraMap A (FractionRing A)))) ∧
      ∀ G : Polynomial (Polynomial A),
      ((1 : FractionRing A) ⊗ₜ[A] Polynomial.eval₂ (Polynomial.aeval (R := A) y).toRingHom w G :
          TensorProduct A (FractionRing A) B) =
        Polynomial.eval₂ (Polynomial.aeval (R := FractionRing A)
          ((1 : FractionRing A) ⊗ₜ[A] y : TensorProduct A (FractionRing A) B)).toRingHom
          ((1 : FractionRing A) ⊗ₜ[A] w)
          (G.map (Polynomial.mapRingHom (algebraMap A (FractionRing A)))) := by
    intro w
    refine H2 (algebraMap A (FractionRing A)) (Polynomial.aeval (R := FractionRing A)
      ((1 : FractionRing A) ⊗ₜ[A] y : TensorProduct A (FractionRing A) B)).toRingHom
      (Algebra.TensorProduct.includeRight : B →ₐ[A] TensorProduct A (FractionRing A) B).toRingHom
      (fun a => ?_) y w ?_
    · simp only [AlgHom.toRingHom_eq_coe, RingHom.coe_coe, AlgHom.commutes, Polynomial.aeval_C]
      exact IsScalarTower.algebraMap_apply A (FractionRing A) _ a
    · simp

  have HF : ∀ (Ω : Type u) [Field Ω] (ψ : A →+* Ω), letI := ψ.toAlgebra; ∀ w : B,
      (∀ s : Polynomial A, (Polynomial.aeval y s ⊗ₜ[A] (1 : Ω) : TensorProduct A B Ω) =
        Polynomial.eval₂RingHom (Algebra.TensorProduct.includeRight : Ω →ₐ[A] TensorProduct A B Ω).toRingHom
          (y ⊗ₜ[A] (1 : Ω)) (s.map ψ)) ∧
      ∀ G : Polynomial (Polynomial A),
        (Polynomial.eval₂ (Polynomial.aeval (R := A) y).toRingHom w G ⊗ₜ[A] (1 : Ω) :
          TensorProduct A B Ω) =
        Polynomial.eval₂ (Polynomial.eval₂RingHom
          (Algebra.TensorProduct.includeRight : Ω →ₐ[A] TensorProduct A B Ω).toRingHom
          (y ⊗ₜ[A] (1 : Ω))) (w ⊗ₜ[A] (1 : Ω)) (G.map (Polynomial.mapRingHom ψ)) := by
    intro Ω _ ψ
    letI := ψ.toAlgebra
    intro w
    refine H2 ψ (Polynomial.eval₂RingHom
      (Algebra.TensorProduct.includeRight : Ω →ₐ[A] TensorProduct A B Ω).toRingHom
      (y ⊗ₜ[A] (1 : Ω))) (Algebra.TensorProduct.includeLeftRingHom : B →+* TensorProduct A B Ω)
      (fun a => ?_) y w ?_
    · simp only [Algebra.TensorProduct.includeLeftRingHom_apply, Polynomial.coe_eval₂RingHom,
        Polynomial.eval₂_C, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
        Algebra.TensorProduct.includeRight_apply]
      rw [Algebra.algebraMap_eq_smul_one, TensorProduct.smul_tmul, Algebra.smul_def,
        RingHom.algebraMap_toAlgebra, mul_one]
    · simp
  have hK0 : ∀ a : A, a ≠ 0 → algebraMap A (FractionRing A) a ≠ 0 := fun a ha => by
    rw [Ne, ← map_zero (algebraMap A (FractionRing A))]
    exact (IsFractionRing.injective A _).ne ha

  have s3 : ∃ e : A, e ≠ 0 ∧ ∀ (Ω : Type u) [Field Ω] (ψ : A →+* Ω), ψ e ≠ 0 →
      letI := ψ.toAlgebra; Polynomial.eval₂ (Polynomial.eval₂RingHom
        (Algebra.TensorProduct.includeRight : Ω →ₐ[A] TensorProduct A B Ω).toRingHom
        (y ⊗ₜ[A] (1 : Ω))) (z ⊗ₜ[A] (1 : Ω)) (P.map (Polynomial.mapRingHom ψ)) = 0 := by
    obtain ⟨e, he, h⟩ := H1 _ (((HK z).2 P).trans hrel)
    refine ⟨e, he, fun Ω _ ψ hψ => ?_⟩
    letI := ψ.toAlgebra
    rw [← (HF Ω ψ z).2 P]
    exact h Ω ψ hψ

  have s1 : ∀ b : B, ∃ c : A, c ≠ 0 ∧ ∀ (Ω : Type u) [Field Ω] (ψ : A →+* Ω), ψ c ≠ 0 →
      letI := ψ.toAlgebra; (Polynomial.eval₂RingHom
        (Algebra.TensorProduct.includeRight : Ω →ₐ[A] TensorProduct A B Ω).toRingHom
        (y ⊗ₜ[A] (1 : Ω))).IsIntegralElem (b ⊗ₜ[A] (1 : Ω)) := by
    intro b
    obtain ⟨F, hFm, hF⟩ := hint ((1 : FractionRing A) ⊗ₜ[A] b)
    obtain ⟨d, G, hd, hG⟩ := H3 F
    have hinj : Function.Injective (Polynomial.map (algebraMap A (FractionRing A))) :=
      Polynomial.map_injective _ (IsFractionRing.injective A (FractionRing A))
    have hGc : ∀ i, (G.coeff i).map (algebraMap A (FractionRing A)) =
        Polynomial.C (algebraMap A (FractionRing A) d) * F.coeff i := by
      intro i
      have := congrArg (fun p => Polynomial.coeff p i) hG
      simp only [Polynomial.coeff_map, Polynomial.coeff_C_mul, Polynomial.coe_mapRingHom] at this
      exact this
    have hGn : G.coeff F.natDegree = Polynomial.C d := by
      apply hinj
      rw [hGc, hFm.coeff_natDegree, mul_one, Polynomial.map_C]
    have hGi : ∀ i, F.natDegree < i → G.coeff i = 0 := by
      intro i hi
      apply hinj
      rw [hGc, Polynomial.coeff_eq_zero_of_natDegree_lt hi, mul_zero, Polynomial.map_zero]
    have hβ : ((1 : FractionRing A) ⊗ₜ[A] Polynomial.eval₂ (Polynomial.aeval (R := A) y).toRingHom b G :
        TensorProduct A (FractionRing A) B) = 0 := by
      rw [(HK b).2 G, hG, Polynomial.eval₂_mul, Polynomial.eval₂_C, hF, mul_zero]
    obtain ⟨e, he, hβψ⟩ := H1 _ hβ
    refine ⟨d * e, mul_ne_zero hd he, fun Ω _ ψ hψ => ?_⟩
    letI := ψ.toAlgebra
    rw [map_mul] at hψ
    obtain ⟨hψd, hψe⟩ := mul_ne_zero_iff.mp hψ
    have h0 := hβψ Ω ψ hψe
    rw [(HF Ω ψ b).2 G] at h0
    refine ⟨Polynomial.C (Polynomial.C (ψ d)⁻¹) * G.map (Polynomial.mapRingHom ψ), ?_, ?_⟩
    · have hc : ∀ i, (Polynomial.C (Polynomial.C (ψ d)⁻¹) *
          G.map (Polynomial.mapRingHom ψ)).coeff i = Polynomial.C (ψ d)⁻¹ * (G.coeff i).map ψ := by
        intro i
        rw [Polynomial.coeff_C_mul, Polynomial.coeff_map, Polynomial.coe_mapRingHom]
      apply Polynomial.monic_of_natDegree_le_of_coeff_eq_one F.natDegree
      · rw [Polynomial.natDegree_le_iff_coeff_eq_zero]
        intro i hi
        rw [hc, hGi i hi, Polynomial.map_zero, mul_zero]
      · rw [hc, hGn, Polynomial.map_C, ← Polynomial.C_mul, inv_mul_cancel₀ hψd, Polynomial.C_1]
    · rw [Polynomial.eval₂_mul, h0, mul_zero]

  have s2 : ∀ b : B, ∃ c : A, c ≠ 0 ∧ ∀ (Ω : Type u) [Field Ω] (ψ : A →+* Ω), ψ c ≠ 0 →
      letI := ψ.toAlgebra; ∃ (s' : Polynomial Ω) (h' : Polynomial (Polynomial Ω)), s' ≠ 0 ∧
        Polynomial.eval₂RingHom (Algebra.TensorProduct.includeRight : Ω →ₐ[A] TensorProduct A B Ω).toRingHom
          (y ⊗ₜ[A] (1 : Ω)) s' * (b ⊗ₜ[A] (1 : Ω)) ^ q =
        Polynomial.eval₂ (Polynomial.eval₂RingHom
          (Algebra.TensorProduct.includeRight : Ω →ₐ[A] TensorProduct A B Ω).toRingHom
          (y ⊗ₜ[A] (1 : Ω))) (z ⊗ₜ[A] (1 : Ω)) h' := by
    intro b
    obtain ⟨s, h, hs0, hs⟩ := hexp ((1 : FractionRing A) ⊗ₜ[A] b)
    obtain ⟨d₁, G₁, hd₁, hG₁⟩ := H3 (Polynomial.C s)
    obtain ⟨d₂, η, hd₂, hη⟩ := H3 h
    have hσ : (G₁.coeff 0).map (algebraMap A (FractionRing A)) =
        Polynomial.C (algebraMap A (FractionRing A) d₁) * s := by
      have := congrArg (fun p => Polynomial.coeff p 0) hG₁
      simp only [Polynomial.coeff_map, Polynomial.coeff_C_mul, Polynomial.coe_mapRingHom,
        Polynomial.coeff_C_zero] at this
      exact this
    have hσ'K : (Polynomial.C d₂ * G₁.coeff 0).map (algebraMap A (FractionRing A)) =
        Polynomial.C (algebraMap A (FractionRing A) d₂) *
          (Polynomial.C (algebraMap A (FractionRing A) d₁) * s) := by
      rw [Polynomial.map_mul, Polynomial.map_C, hσ]
    have hη'K : (Polynomial.C (Polynomial.C d₁) * η).map
        (Polynomial.mapRingHom (algebraMap A (FractionRing A))) =
        Polynomial.C (Polynomial.C (algebraMap A (FractionRing A) d₁)) *
          (Polynomial.C (Polynomial.C (algebraMap A (FractionRing A) d₂)) * h) := by
      rw [Polynomial.map_mul, hη, Polynomial.map_C, Polynomial.coe_mapRingHom, Polynomial.map_C]
    have hσ'0 : Polynomial.C d₂ * G₁.coeff 0 ≠ 0 := by
      intro h0
      have h1 := hσ'K
      rw [h0, Polynomial.map_zero] at h1
      exact (mul_ne_zero (Polynomial.C_ne_zero.mpr (hK0 _ hd₂))
        (mul_ne_zero (Polynomial.C_ne_zero.mpr (hK0 _ hd₁)) hs0)) h1.symm
    have hβ : ((1 : FractionRing A) ⊗ₜ[A]
        (Polynomial.aeval y (Polynomial.C d₂ * G₁.coeff 0) * b ^ q -
          Polynomial.eval₂ (Polynomial.aeval (R := A) y).toRingHom z
            (Polynomial.C (Polynomial.C d₁) * η)) : TensorProduct A (FractionRing A) B) = 0 := by
      change (Algebra.TensorProduct.includeRight : B →ₐ[A] TensorProduct A (FractionRing A) B)
        (Polynomial.aeval y (Polynomial.C d₂ * G₁.coeff 0) * b ^ q -
          Polynomial.eval₂ (Polynomial.aeval (R := A) y).toRingHom z
            (Polynomial.C (Polynomial.C d₁) * η)) = 0
      rw [map_sub, map_mul, map_pow]
      simp only [Algebra.TensorProduct.includeRight_apply]
      rw [(HK b).1, (HK z).2, hσ'K, hη'K]
      simp only [map_mul, Polynomial.eval₂_mul, Polynomial.eval₂_C] at hs ⊢
      simp only [AlgHom.toRingHom_eq_coe, RingHom.coe_coe] at hs ⊢
      linear_combination (Polynomial.aeval ((1 : FractionRing A) ⊗ₜ[A] y : TensorProduct A (FractionRing A) B)
        (Polynomial.C (algebraMap A (FractionRing A) d₂)) *
        Polynomial.aeval ((1 : FractionRing A) ⊗ₜ[A] y : TensorProduct A (FractionRing A) B)
        (Polynomial.C (algebraMap A (FractionRing A) d₁))) * hs
    obtain ⟨e, he, hβψ⟩ := H1 _ hβ
    refine ⟨e * (Polynomial.C d₂ * G₁.coeff 0).leadingCoeff,
      mul_ne_zero he (Polynomial.leadingCoeff_ne_zero.mpr hσ'0), fun Ω _ ψ hψ => ?_⟩
    letI := ψ.toAlgebra
    rw [map_mul] at hψ
    obtain ⟨hψe, hψl⟩ := mul_ne_zero_iff.mp hψ
    have h0 := hβψ Ω ψ hψe
    change (Algebra.TensorProduct.includeLeftRingHom : B →+* TensorProduct A B Ω)
        (Polynomial.aeval y (Polynomial.C d₂ * G₁.coeff 0) * b ^ q -
          Polynomial.eval₂ (Polynomial.aeval (R := A) y).toRingHom z
            (Polynomial.C (Polynomial.C d₁) * η)) = 0 at h0
    rw [map_sub, map_mul, map_pow] at h0
    simp only [Algebra.TensorProduct.includeLeftRingHom_apply] at h0
    rw [(HF Ω ψ b).1, (HF Ω ψ z).2] at h0
    refine ⟨(Polynomial.C d₂ * G₁.coeff 0).map ψ,
      (Polynomial.C (Polynomial.C d₁) * η).map (Polynomial.mapRingHom ψ), ?_, sub_eq_zero.mp h0⟩
    intro h0'
    have h2 := congrArg (fun p => Polynomial.coeff p (Polynomial.C d₂ * G₁.coeff 0).natDegree) h0'
    simp only [Polynomial.coeff_map, Polynomial.coeff_zero] at h2
    exact hψl h2

  obtain ⟨t, ht⟩ := (Algebra.FiniteType.out : (⊤ : Subalgebra A B).FG)
  have gen : ∀ (Ω : Type u) [Field Ω] (ψ : A →+* Ω), letI := ψ.toAlgebra;
      ∀ T : Subring (TensorProduct A B Ω), (∀ ω : Ω, ((1 : B) ⊗ₜ[A] ω : TensorProduct A B Ω) ∈ T) →
      (∀ b ∈ t, (b ⊗ₜ[A] (1 : Ω) : TensorProduct A B Ω) ∈ T) → ∀ x, x ∈ T := by
    intro Ω _ ψ
    letI := ψ.toAlgebra
    intro T h1 ht'
    let S : Subalgebra A B :=
      { carrier := {b | (b ⊗ₜ[A] (1 : Ω) : TensorProduct A B Ω) ∈ T}
        mul_mem' := by
          intro a b ha hb
          simp only [Set.mem_setOf_eq] at ha hb ⊢
          have : (a * b) ⊗ₜ[A] (1 : Ω) = (a ⊗ₜ[A] (1 : Ω)) * (b ⊗ₜ[A] (1 : Ω)) := by
            rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one]
          rw [this]; exact T.mul_mem ha hb
        add_mem' := by
          intro a b ha hb
          simp only [Set.mem_setOf_eq] at ha hb ⊢
          rw [TensorProduct.add_tmul]; exact T.add_mem ha hb
        algebraMap_mem' := by
          intro a
          simp only [Set.mem_setOf_eq]
          rw [Algebra.algebraMap_eq_smul_one, TensorProduct.smul_tmul]
          exact h1 _ }
    have hS : ∀ b : B, b ∈ S := by
      intro b
      have hle : Algebra.adjoin A (t : Set B) ≤ S := Algebra.adjoin_le (fun b hb => ht' b hb)
      rw [ht] at hle
      exact hle Algebra.mem_top
    intro x
    induction x using TensorProduct.induction_on with
    | zero => exact T.zero_mem
    | tmul b ω =>
      have : b ⊗ₜ[A] ω = (b ⊗ₜ[A] (1 : Ω)) * ((1 : B) ⊗ₜ[A] ω) := by
        rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
      rw [this]; exact T.mul_mem (hS b) (h1 ω)
    | add x x' hx hx' => exact T.add_mem hx hx'
  choose c₁ hc₁ hc₁' using s1
  choose c₂ hc₂ hc₂' using s2
  obtain ⟨e₀, he₀, he₀'⟩ := s3
  have hq0 : q ≠ 0 := by
    rcases hchar with rfl | ⟨p, k, hp, _, rfl⟩
    · exact one_ne_zero
    · exact pow_ne_zero _ hp.ne_zero
  refine ⟨e₀ * ∏ b ∈ t, (c₁ b * c₂ b), mul_ne_zero he₀
    (Finset.prod_ne_zero_iff.mpr fun b _ => mul_ne_zero (hc₁ b) (hc₂ b)), fun Ω _ _ ψ hψ => ?_⟩
  rw [map_mul, map_prod] at hψ
  obtain ⟨hψ0, hψt⟩ := mul_ne_zero_iff.mp hψ
  have hψb : ∀ b ∈ t, ψ (c₁ b) ≠ 0 ∧ ψ (c₂ b) ≠ 0 := fun b hb => by
    have := Finset.prod_ne_zero_iff.mp hψt b hb
    rw [map_mul] at this
    exact mul_ne_zero_iff.mp this
  letI := ψ.toAlgebra
  have hφC : ∀ ω : Ω, Polynomial.eval₂RingHom
      (Algebra.TensorProduct.includeRight : Ω →ₐ[A] TensorProduct A B Ω).toRingHom
      (y ⊗ₜ[A] (1 : Ω)) (Polynomial.C ω) = (1 : B) ⊗ₜ[A] ω := by
    intro ω; simp
  refine ⟨?_, he₀' Ω ψ hψ0, ?_⟩
  · let φ := Polynomial.eval₂RingHom
      (Algebra.TensorProduct.includeRight : Ω →ₐ[A] TensorProduct A B Ω).toRingHom
      (y ⊗ₜ[A] (1 : Ω))
    let T₁ : Subring (TensorProduct A B Ω) :=
      { carrier := {x | φ.IsIntegralElem x}
        zero_mem' := by
          have := φ.isIntegralElem_map (x := 0)
          rw [map_zero] at this; exact this
        one_mem' := by
          have := φ.isIntegralElem_map (x := 1)
          rw [map_one] at this; exact this
        mul_mem' := fun hx hy => RingHom.IsIntegralElem.mul φ hx hy
        add_mem' := fun hx hy => RingHom.IsIntegralElem.add φ hx hy
        neg_mem' := fun hx => RingHom.IsIntegralElem.neg φ hx }
    have hT := gen Ω ψ T₁ (fun ω => by
        show φ.IsIntegralElem _
        rw [← hφC]; exact φ.isIntegralElem_map)
      (fun b hb => hc₁' b Ω ψ (hψb b hb).1)
    intro x
    exact hT x
  · have frob : ∀ x x' : TensorProduct A B Ω, (x + x') ^ q = x ^ q + x' ^ q := by
      intro x x'
      rcases hchar with rfl | ⟨p, k, hp, hpA, rfl⟩
      · simp
      · rcases subsingleton_or_nontrivial (TensorProduct A B Ω) with hR | hR
        · exact Subsingleton.elim _ _
        · haveI := Fact.mk hp
          haveI : CharP (TensorProduct A B Ω) p := by
            rw [CharP.charP_iff_prime_eq_zero hp,
              ← map_natCast (algebraMap A (TensorProduct A B Ω)), CharP.cast_eq_zero, map_zero]
          rw [add_pow_char_pow]
    let φ := Polynomial.eval₂RingHom
      (Algebra.TensorProduct.includeRight : Ω →ₐ[A] TensorProduct A B Ω).toRingHom
      (y ⊗ₜ[A] (1 : Ω))
    let T₂ : Subring (TensorProduct A B Ω) :=
      { carrier := {x | ∃ (s : Polynomial Ω) (h : Polynomial (Polynomial Ω)), s ≠ 0 ∧
          φ s * x ^ q = Polynomial.eval₂ φ (z ⊗ₜ[A] (1 : Ω)) h}
        zero_mem' := ⟨1, 0, one_ne_zero, by rw [zero_pow hq0, mul_zero, Polynomial.eval₂_zero]⟩
        one_mem' := ⟨1, 1, one_ne_zero, by rw [one_pow, mul_one, map_one, Polynomial.eval₂_one]⟩
        mul_mem' := by
          rintro x x' ⟨s, h, hs, hx⟩ ⟨s', h', hs', hx'⟩
          refine ⟨s * s', h * h', mul_ne_zero hs hs', ?_⟩
          rw [map_mul, mul_pow, Polynomial.eval₂_mul, ← hx, ← hx']; ring
        add_mem' := by
          rintro x x' ⟨s, h, hs, hx⟩ ⟨s', h', hs', hx'⟩
          refine ⟨s * s', Polynomial.C s' * h + Polynomial.C s * h', mul_ne_zero hs hs', ?_⟩
          rw [frob, Polynomial.eval₂_add, Polynomial.eval₂_mul, Polynomial.eval₂_mul,
            Polynomial.eval₂_C, Polynomial.eval₂_C, ← hx, ← hx', map_mul]; ring
        neg_mem' := by
          rintro x ⟨s, h, hs, hx⟩
          refine ⟨s, Polynomial.C (Polynomial.C (-1)) ^ q * h, hs, ?_⟩
          rw [Polynomial.eval₂_mul, Polynomial.eval₂_pow, Polynomial.eval₂_C, ← hx, neg_pow]
          simp only [Polynomial.C_neg, Polynomial.C_1, map_neg, map_one]
          ring }
    have hT := gen Ω ψ T₂ (fun ω => ⟨1, Polynomial.C (Polynomial.C (ω ^ q)), one_ne_zero, by
        rw [map_one, one_mul, Polynomial.eval₂_C, Polynomial.C_pow, map_pow, hφC]⟩)
      (fun b hb => hc₂' b Ω ψ (hψb b hb).2)
    intro x
    exact hT x

theorem wc_alg_gi_generic_abs_irreducible : ∀ (A : Type u) [CommRing A] [IsDomain A] (P : Polynomial (Polynomial A)), P.Monic → Irreducible (P.map (Polynomial.mapRingHom (algebraMap A (AlgebraicClosure (FractionRing A))))) → ∃ f : A, f ≠ 0 ∧ ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (ψ : A →+* Ω), ψ f ≠ 0 → Irreducible (P.map (Polynomial.mapRingHom ψ)) :=
by
  intro A _ _ P _ hirr
  classical
  have key : ∀ (S : Type u) [CommRing S] (g : A →+* S),
      Irreducible (P.map (Polynomial.mapRingHom g)) ↔
      Irreducible (MvPolynomial.map g (Polynomial.eval₂RingHom (Polynomial.eval₂RingHom
        (MvPolynomial.C : A →+* MvPolynomial (Fin 2) A) (MvPolynomial.X 1)) (MvPolynomial.X 0) P)) := by
    intro S _ g
    let Φ : Polynomial (Polynomial S) →+* MvPolynomial (Fin 2) S :=
      Polynomial.eval₂RingHom (Polynomial.eval₂RingHom
        (MvPolynomial.C : S →+* MvPolynomial (Fin 2) S) (MvPolynomial.X 1)) (MvPolynomial.X 0)
    let Ψ : MvPolynomial (Fin 2) S →+* Polynomial (Polynomial S) :=
      MvPolynomial.eval₂Hom (Polynomial.C.comp Polynomial.C)
        ![(Polynomial.X : Polynomial (Polynomial S)), Polynomial.C Polynomial.X]
    have h1 : Φ.comp Ψ = RingHom.id _ := by
      apply MvPolynomial.ringHom_ext
      · intro r
        simp [Φ, Ψ]
      · intro i
        fin_cases i <;> simp [Φ, Ψ]
    have h2 : Ψ.comp Φ = RingHom.id _ := by
      apply Polynomial.ringHom_ext'
      · apply Polynomial.ringHom_ext
        · intro r
          simp [Φ, Ψ]
        · simp [Φ, Ψ]
      · simp [Φ, Ψ]
    let e : Polynomial (Polynomial S) ≃+* MvPolynomial (Fin 2) S := RingEquiv.ofRingHom Φ Ψ h1 h2
    have hcomp : Φ.comp (Polynomial.mapRingHom (Polynomial.mapRingHom g)) =
        (MvPolynomial.map g).comp (Polynomial.eval₂RingHom (Polynomial.eval₂RingHom
          (MvPolynomial.C : A →+* MvPolynomial (Fin 2) A) (MvPolynomial.X 1)) (MvPolynomial.X 0)) := by
      apply Polynomial.ringHom_ext'
      · apply Polynomial.ringHom_ext
        · intro r
          simp [Φ]
        · simp [Φ]
      · simp [Φ]
    have hnat : e (P.map (Polynomial.mapRingHom g)) =
        MvPolynomial.map g (Polynomial.eval₂RingHom (Polynomial.eval₂RingHom
          (MvPolynomial.C : A →+* MvPolynomial (Fin 2) A) (MvPolynomial.X 1)) (MvPolynomial.X 0) P) :=
      RingHom.congr_fun hcomp P
    rw [← hnat]
    exact (MulEquiv.irreducible_iff e).symm
  obtain ⟨c, hc, hspread⟩ := wc_mvpoly_geom_irreducible_spread A 2 _ ((key _ _).mp hirr)
  exact ⟨c, hc, fun Ω _ _ ψ hψ => (key Ω ψ).mpr (hspread Ω ψ hψ)⟩

theorem wc_alg_gi_count_one : ∀ (Ω R : Type u) [Field Ω] [CommRing R] (φ : Polynomial Ω →+* R), Function.Injective φ → φ.IsIntegral → ∀ (P : Polynomial (Polynomial Ω)) (z : R), P.Monic → Irreducible P → Polynomial.eval₂ φ z P = 0 → ∀ q : ℕ, 0 < q → (∀ x : R, ∃ (s : Polynomial Ω) (h : Polynomial (Polynomial Ω)), s ≠ 0 ∧ φ s * x ^ q = Polynomial.eval₂ φ z h) → Set.Finite {Q : PrimeSpectrum R | ¬ Q.asIdeal.IsMaximal} ∧ Set.ncard {Q : PrimeSpectrum R | ¬ Q.asIdeal.IsMaximal} = 1 :=
by
  intro Ω R _ _ φ hinj hint P z hPm hPirr hPz q hq hexp
  classical

  have s1 : ∀ Q : Ideal R, Q.IsPrime → (¬ Q.IsMaximal ↔ Q.comap φ = ⊥) := by
    intro Q hQ
    constructor
    · intro hnm
      by_contra hne
      have hp : (Q.comap φ).IsPrime := Ideal.comap_isPrime φ Q
      have hm : (Q.comap φ).IsMaximal := hp.isMaximal hne
      exact hnm (Ideal.isMaximal_of_isIntegral_of_isMaximal_comap φ hint Q hm)
    · intro hbot hm
      have h1 := Ideal.isMaximal_comap_of_isIntegral_of_isMaximal φ hint Q
      rw [hbot] at h1
      exact Polynomial.not_isField Ω ((Ring.isField_iff_maximal_bot).mpr h1)

  have s2 : ∃ Q : Ideal R, Q.IsPrime ∧ Q.comap φ = ⊥ := by
    letI := φ.toAlgebra
    haveI : Algebra.IsIntegral (Polynomial Ω) R := ⟨hint⟩
    have hle : Ideal.under (Polynomial Ω) (⊥ : Ideal R) ≤ ⊥ :=
      (Ideal.comap_bot_of_injective φ hinj).le
    obtain ⟨Q, -, hQ, hQc⟩ := Ideal.exists_ideal_over_prime_of_isIntegral (⊥ : Ideal (Polynomial Ω)) (⊥ : Ideal R) hle
    exact ⟨Q, hQ, hQc⟩

  have s3 : ∀ G : Polynomial (Polynomial Ω), ¬ P ∣ G → ∃ (b : Polynomial Ω) (U V : Polynomial (Polynomial Ω)), b ≠ 0 ∧ U * P + V * G = Polynomial.C b := by
    intro G hG
    have hι : Function.Injective (algebraMap (Polynomial Ω) (FractionRing (Polynomial Ω))) :=
      IsFractionRing.injective _ _
    have hirrK : Irreducible (P.map (algebraMap (Polynomial Ω) (FractionRing (Polynomial Ω)))) :=
      (Polynomial.Monic.irreducible_iff_irreducible_map_fraction_map hPm).mp hPirr
    have hndvd : ¬ P.map (algebraMap (Polynomial Ω) (FractionRing (Polynomial Ω))) ∣
        G.map (algebraMap (Polynomial Ω) (FractionRing (Polynomial Ω))) := by
      intro hd
      apply hG
      rw [← Polynomial.modByMonic_eq_zero_iff_dvd hPm]
      apply Polynomial.map_injective _ hι
      rw [Polynomial.map_modByMonic _ hPm, Polynomial.map_zero]
      exact (Polynomial.modByMonic_eq_zero_iff_dvd (hPm.map _)).mpr hd
    have hcop := (Irreducible.coprime_iff_not_dvd hirrK).mpr hndvd
    obtain ⟨u, v, huv⟩ := hcop
    obtain ⟨b₁, hb₁, hU⟩ :=
      IsLocalization.integerNormalization_spec (nonZeroDivisors (Polynomial Ω)) u
    obtain ⟨b₂, hb₂, hV⟩ :=
      IsLocalization.integerNormalization_spec (nonZeroDivisors (Polynomial Ω)) v
    refine ⟨b₁ * b₂, Polynomial.C b₂ * IsLocalization.integerNormalization (nonZeroDivisors (Polynomial Ω)) u,
      Polynomial.C b₁ * IsLocalization.integerNormalization (nonZeroDivisors (Polynomial Ω)) v, ?_, ?_⟩
    · exact mul_ne_zero (nonZeroDivisors.ne_zero hb₁) (nonZeroDivisors.ne_zero hb₂)
    · apply Polynomial.map_injective _ hι
      simp only [Polynomial.map_add, Polynomial.map_mul, Polynomial.map_C, map_mul]
      rw [hU, hV]
      simp only [Algebra.smul_def, Polynomial.algebraMap_apply]
      linear_combination (Polynomial.C (algebraMap (Polynomial Ω) (FractionRing (Polynomial Ω)) b₁) *
        Polynomial.C (algebraMap (Polynomial Ω) (FractionRing (Polynomial Ω)) b₂)) * huv

  have s4 : ∀ Q : Ideal R, Q.IsPrime → Q.comap φ = ⊥ → ∀ G, Polynomial.eval₂ φ z G ∈ Q ↔ P ∣ G := by
    intro Q hQ hbot G
    constructor
    · intro hG
      by_contra hnd
      obtain ⟨b, U, V, hb, hUV⟩ := s3 G hnd
      have h1 : φ b ∈ Q := by
        have : Polynomial.eval₂ φ z (Polynomial.C b) = φ b := Polynomial.eval₂_C _ _
        rw [← this, ← hUV, Polynomial.eval₂_add, Polynomial.eval₂_mul, Polynomial.eval₂_mul, hPz,
          mul_zero, zero_add]
        exact Q.mul_mem_left _ hG
      have h2 : b ∈ Q.comap φ := h1
      rw [hbot] at h2
      exact hb (Ideal.mem_bot.mp h2)
    · rintro ⟨H, rfl⟩
      rw [Polynomial.eval₂_mul, hPz, zero_mul]
      exact Q.zero_mem

  have s5 : ∀ Q : Ideal R, Q.IsPrime → Q.comap φ = ⊥ → ∀ (x : R) (s : Polynomial Ω)
      (h : Polynomial (Polynomial Ω)), s ≠ 0 → φ s * x ^ q = Polynomial.eval₂ φ z h →
      (x ∈ Q ↔ P ∣ h) := by
    intro Q hQ hbot x s h hs hsh
    rw [← s4 Q hQ hbot h, ← hsh]
    constructor
    · intro hx
      exact Q.mul_mem_left _ (Q.pow_mem_of_mem hx q hq)
    · intro hx
      rcases hQ.mem_or_mem hx with h1 | h1
      · exfalso
        have h2 : s ∈ Q.comap φ := h1
        rw [hbot] at h2
        exact hs (Ideal.mem_bot.mp h2)
      · exact hQ.mem_of_pow_mem q h1

  obtain ⟨Q₀, hQ₀, hQ₀bot⟩ := s2
  have hset : {Q : PrimeSpectrum R | ¬ Q.asIdeal.IsMaximal} = {⟨Q₀, hQ₀⟩} := by
    ext Q
    simp only [Set.mem_setOf_eq, Set.mem_singleton_iff]
    constructor
    · intro hQ
      have hb := (s1 Q.asIdeal Q.isPrime).mp hQ
      apply PrimeSpectrum.ext
      apply Ideal.ext
      intro x
      obtain ⟨s, h, hs, hsh⟩ := hexp x
      rw [s5 Q.asIdeal Q.isPrime hb x s h hs hsh, s5 Q₀ hQ₀ hQ₀bot x s h hs hsh]
    · rintro rfl
      exact (s1 Q₀ hQ₀).mpr hQ₀bot
  rw [hset]
  exact ⟨Set.finite_singleton _, Set.ncard_singleton _⟩

theorem wc_alg_geom_integral_fibre_count : ∀ (A B : Type u) [CommRing A] [IsDomain A] [IsNoetherianRing A] [CommRing B] [Algebra A B] [Algebra.FiniteType A B], IsDomain (TensorProduct A B (AlgebraicClosure (FractionRing A))) → (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (ψ : A →+* Ω), letI := ψ.toAlgebra; ringKrullDim (TensorProduct A B Ω) ≤ 1) → ∃ (a : A) (n : ℕ), a ≠ 0 ∧ ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (ψ : A →+* Ω), ψ a ≠ 0 → letI := ψ.toAlgebra; Set.Finite {q : PrimeSpectrum (TensorProduct A B Ω) | ¬ q.asIdeal.IsMaximal} ∧ Set.ncard {q : PrimeSpectrum (TensorProduct A B Ω) | ¬ q.asIdeal.IsMaximal} = n :=
by
  intro A B _ _ _ _ _ _ hGI H
  classical
  by_cases hfin : Module.Finite (FractionRing A) (TensorProduct A (FractionRing A) B)
  ·
    obtain ⟨a, ha, hmax⟩ := wc_alg_fin_generic_fibre_no_nonmax A B hfin
    refine ⟨a, 0, ha, fun Ω _ _ ψ hψ => ?_⟩
    letI := ψ.toAlgebra
    have hempty : {q : PrimeSpectrum (TensorProduct A B Ω) | ¬ q.asIdeal.IsMaximal} = ∅ := by
      ext q
      simp only [Set.mem_setOf_eq, Set.mem_empty_iff_false, iff_false, not_not]
      exact hmax Ω ψ hψ q
    rw [hempty]
    exact ⟨Set.finite_empty, Set.ncard_empty _⟩
  ·

    have hD : IsDomain (TensorProduct A (FractionRing A) B) := by
      obtain ⟨r, hr⟩ := LinearMap.exists_leftInverse_of_injective
        (Algebra.linearMap (FractionRing A) (AlgebraicClosure (FractionRing A)))
        (LinearMap.ker_eq_bot.mpr
          (algebraMap (FractionRing A) (AlgebraicClosure (FractionRing A))).injective)
      let f : TensorProduct A (FractionRing A) B →ₐ[A]
          TensorProduct A (AlgebraicClosure (FractionRing A)) B :=
        Algebra.TensorProduct.map
          (IsScalarTower.toAlgHom A (FractionRing A) (AlgebraicClosure (FractionRing A)))
          (AlgHom.id A B)
      let g : TensorProduct A (AlgebraicClosure (FractionRing A)) B →ₗ[A]
          TensorProduct A (FractionRing A) B :=
        (r.restrictScalars A).rTensor B
      have hgf : ∀ x, g (f x) = x := by
        intro x
        induction x using TensorProduct.induction_on with
        | zero => simp
        | tmul k b =>
          have hk : r (algebraMap (FractionRing A) (AlgebraicClosure (FractionRing A)) k) = k :=
            LinearMap.congr_fun hr k
          simp [f, g, Algebra.TensorProduct.map_tmul, LinearMap.rTensor_tmul, hk]
        | add x y hx hy => rw [map_add, map_add, hx, hy]
      have hinj : Function.Injective f := Function.LeftInverse.injective hgf
      let φ : TensorProduct A (FractionRing A) B →+*
          TensorProduct A B (AlgebraicClosure (FractionRing A)) :=
        ((Algebra.TensorProduct.comm A (AlgebraicClosure (FractionRing A)) B).toAlgHom.comp
          f).toRingHom
      have hφ : Function.Injective φ :=
        (Algebra.TensorProduct.comm A (AlgebraicClosure (FractionRing A)) B).injective.comp hinj
      have : Nontrivial (TensorProduct A (FractionRing A) B) := φ.domain_nontrivial
      exact hφ.isDomain φ

    obtain ⟨y, hyinj, hyint⟩ := wc_alg_gi_noether_normalization A B hGI H hfin
    obtain ⟨z, P, q, hPm, hq, hchar, hrel, hmin, hexp⟩ :=
      wc_alg_gi_plane_model A B hD y hyinj hyint
    have hirr := wc_alg_gi_plane_model_abs_irreducible A B y z P hPm hGI hrel hmin
    obtain ⟨a5, ha5, h5⟩ := wc_alg_gi_spread_injective A B y hD hyinj hyint
    obtain ⟨a6, ha6, h6⟩ := wc_alg_gi_spread_relations A B y z P q hchar hyint hrel hexp
    obtain ⟨a7, ha7, h7⟩ := wc_alg_gi_generic_abs_irreducible A P hPm hirr

    refine ⟨a5 * a6 * a7, 1, mul_ne_zero (mul_ne_zero ha5 ha6) ha7, fun Ω _ _ ψ hψ => ?_⟩
    rw [map_mul, map_mul] at hψ
    obtain ⟨hψ56, hψ7⟩ := mul_ne_zero_iff.mp hψ
    obtain ⟨hψ5, hψ6⟩ := mul_ne_zero_iff.mp hψ56
    letI := ψ.toAlgebra
    obtain ⟨hint, hrelψ, hexpψ⟩ := h6 Ω ψ hψ6
    exact wc_alg_gi_count_one Ω (TensorProduct A B Ω) _ (h5 Ω ψ hψ5) hint
      (P.map (Polynomial.mapRingHom ψ)) (z ⊗ₜ[A] (1 : Ω)) (hPm.map _) (h7 Ω ψ hψ7) hrelψ q hq
      hexpψ

theorem wc_alg_fibre_nonclosed_generic_const : ∀ (A B : Type u) [CommRing A] [IsDomain A] [IsNoetherianRing A] [CommRing B] [Algebra A B] [Algebra.FiniteType A B], (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (ψ : A →+* Ω), letI := ψ.toAlgebra; ringKrullDim (TensorProduct A B Ω) ≤ 1) → ∃ (a : A) (n : ℕ), a ≠ 0 ∧ ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (ψ : A →+* Ω), ψ a ≠ 0 → letI := ψ.toAlgebra; Set.Finite {q : PrimeSpectrum (TensorProduct A B Ω) | ¬ IsClosed ({q} : Set (PrimeSpectrum (TensorProduct A B Ω)))} ∧ Set.ncard {q : PrimeSpectrum (TensorProduct A B Ω) | ¬ IsClosed ({q} : Set (PrimeSpectrum (TensorProduct A B Ω)))} = n :=
by
  intro A B _ _ _ _ _ _ H
  classical
  obtain ⟨A', _, _, _, hinj, hint, hft, a', m, Q, ha', hdom, ⟨N, hN⟩, hfin⟩ :=
    wc_alg_geom_components_split A B H
  haveI := hint
  haveI := hft
  haveI : IsNoetherianRing A' := Algebra.FiniteType.isNoetherianRing A A'

  have hiso : ∀ (Ω : Type u) [Field Ω] (ψ' : A' →+* Ω),
      letI := ψ'.toAlgebra
      letI : Algebra A Ω := (ψ'.comp (algebraMap A A')).toAlgebra
      Nonempty (TensorProduct A' (TensorProduct A A' B) Ω ≃+* TensorProduct A B Ω) := by
    intro Ω _ ψ'
    letI := ψ'.toAlgebra
    letI : Algebra A Ω := (ψ'.comp (algebraMap A A')).toAlgebra
    haveI : IsScalarTower A A' Ω := IsScalarTower.of_algebraMap_eq' rfl
    exact ⟨((Algebra.TensorProduct.comm A' (TensorProduct A A' B) Ω).toRingEquiv.trans
      (Algebra.TensorProduct.cancelBaseChange A A' A' Ω B).toRingEquiv).trans
      (Algebra.TensorProduct.comm A Ω B).toRingEquiv⟩

  have hdimB' : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (ψ' : A' →+* Ω),
      letI := ψ'.toAlgebra
      ringKrullDim (TensorProduct A' (TensorProduct A A' B) Ω) ≤ 1 := by
    intro Ω _ _ ψ'
    obtain ⟨e⟩ := hiso Ω ψ'
    exact (ringKrullDim_eq_of_ringEquiv e).le.trans (H Ω (ψ'.comp (algebraMap A A')))
  have hdimQ : ∀ j (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (ψ' : A' →+* Ω),
      letI := ψ'.toAlgebra
      ringKrullDim (TensorProduct A' (TensorProduct A A' B ⧸ Q j) Ω) ≤ 1 := by
    intro j Ω _ _ ψ'
    letI := ψ'.toAlgebra
    exact (ringKrullDim_le_of_surjective
      (Algebra.TensorProduct.map (Ideal.Quotient.mkₐ A' (Q j)) (AlgHom.id A' Ω)).toRingHom
      (Algebra.TensorProduct.map_surjective (Ideal.Quotient.mkₐ A' (Q j)) (AlgHom.id A' Ω)
        (Ideal.Quotient.mkₐ_surjective A' (Q j)) Function.surjective_id)).trans (hdimB' Ω ψ')

  have h5 := fun j => wc_alg_geom_integral_fibre_count A' (TensorProduct A A' B ⧸ Q j)
    (hdom j) (hdimQ j)
  choose aj nj haj hnj using h5

  have h1 : ∀ j k : Fin m, ∃ a : A', a ≠ 0 ∧ (j ≠ k → ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
      (ψ' : A' →+* Ω), ψ' a ≠ 0 → letI := ψ'.toAlgebra;
      ∀ q : PrimeSpectrum (TensorProduct A' (TensorProduct A A' B ⧸ (Q j ⊔ Q k)) Ω),
        q.asIdeal.IsMaximal) := by
    intro j k
    by_cases hjk : j = k
    · exact ⟨1, one_ne_zero, fun h => absurd hjk h⟩
    · obtain ⟨a, ha, h⟩ := wc_alg_fin_generic_fibre_no_nonmax A'
        (TensorProduct A A' B ⧸ (Q j ⊔ Q k)) (hfin j k hjk)
      exact ⟨a, ha, fun _ => h⟩
  choose ajk hajk hjkmax using h1

  have ha'' : a' * (∏ j, aj j) * (∏ j, ∏ k, ajk j k) ≠ 0 := by
    refine mul_ne_zero (mul_ne_zero ha' ?_) ?_
    · exact Finset.prod_ne_zero_iff.mpr (fun j _ => haj j)
    · exact Finset.prod_ne_zero_iff.mpr (fun j _ => Finset.prod_ne_zero_iff.mpr
        (fun k _ => hajk j k))
  obtain ⟨c, hc, hext⟩ := wc_alg_extend_hom_integral A A' hinj hint _ ha''
  refine ⟨c, ∑ j, nj j, hc, ?_⟩
  intro Ω _ _ ψ hψc
  obtain ⟨ψ', hψ', hψ'a⟩ := hext Ω ψ hψc
  subst hψ'
  rw [map_mul, map_mul] at hψ'a
  obtain ⟨hA, h3'⟩ := mul_ne_zero_iff.mp hψ'a
  obtain ⟨h1, h2'⟩ := mul_ne_zero_iff.mp hA
  rw [map_prod] at h2'
  rw [map_prod] at h3'
  have h2 : ∀ j, ψ' (aj j) ≠ 0 := fun j => Finset.prod_ne_zero_iff.mp h2' j (Finset.mem_univ j)
  have h3 : ∀ j k, ψ' (ajk j k) ≠ 0 := fun j k => by
    have := Finset.prod_ne_zero_iff.mp h3' j (Finset.mem_univ j)
    rw [map_prod] at this
    exact Finset.prod_ne_zero_iff.mp this k (Finset.mem_univ k)
  letI := ψ'.toAlgebra
  have hkerQ : ∀ I : Ideal (TensorProduct A A' B),
      RingHom.ker (Algebra.TensorProduct.map (Ideal.Quotient.mkₐ A' I) (AlgHom.id A' Ω)) =
        Ideal.map (Algebra.TensorProduct.includeLeft (R := A') (S := A')
          (A := TensorProduct A A' B) (B := Ω)) I := by
    intro I
    have hk : RingHom.ker (Ideal.Quotient.mkₐ A' I) = I := Ideal.Quotient.mkₐ_ker A' I
    have := Algebra.TensorProduct.rTensor_ker (R := A') (S := A') (C := Ω)
      (Ideal.Quotient.mkₐ A' I) (Ideal.Quotient.mkₐ_surjective A' I)
    rw [hk] at this
    exact this
  have hsurj : ∀ I : Ideal (TensorProduct A A' B), Function.Surjective
      (Algebra.TensorProduct.map (Ideal.Quotient.mkₐ A' I) (AlgHom.id A' Ω)) := fun I =>
    Algebra.TensorProduct.map_surjective (Ideal.Quotient.mkₐ A' I) (AlgHom.id A' Ω)
      (Ideal.Quotient.mkₐ_surjective A' I) Function.surjective_id

  have hcover : ∀ P : Ideal (TensorProduct A' (TensorProduct A A' B) Ω), P.IsPrime →
      ∃ j, RingHom.ker ((Algebra.TensorProduct.map (Ideal.Quotient.mkₐ A' (Q j))
        (AlgHom.id A' Ω)).toRingHom) ≤ P := by
    intro P hP
    by_contra hcon
    simp only [not_exists] at hcon
    have hx : ∀ j, ∃ x ∈ Q j, Algebra.TensorProduct.includeLeft (R := A') (S := A')
        (A := TensorProduct A A' B) (B := Ω) x ∉ P := by
      intro j
      have h := hcon j
      change ¬ RingHom.ker (Algebra.TensorProduct.map (Ideal.Quotient.mkₐ A' (Q j))
        (AlgHom.id A' Ω)) ≤ P at h
      rw [hkerQ, Ideal.map_le_iff_le_comap] at h
      obtain ⟨x, hxQ, hxP⟩ := SetLike.not_le_iff_exists.mp h
      exact ⟨x, hxQ, hxP⟩
    choose x hxQ hxP using hx
    have hy : (∏ j, x j) ^ N ∈ (∏ j, Q j) ^ N :=
      Ideal.pow_mem_pow (Ideal.prod_mem_prod (fun j _ => hxQ j)) N
    have hu : IsUnit (algebraMap A' (TensorProduct A' (TensorProduct A A' B) Ω) (a' ^ N)) := by
      rw [Algebra.TensorProduct.algebraMap_apply']
      have hΩ : IsUnit (algebraMap A' Ω (a' ^ N)) := by
        rw [isUnit_iff_ne_zero, map_pow]
        exact pow_ne_zero N h1
      exact hΩ.map (Algebra.TensorProduct.includeRight (R := A')
        (A := TensorProduct A A' B) (B := Ω))
    have h0 := congrArg (Algebra.TensorProduct.includeLeft (R := A') (S := A')
      (A := TensorProduct A A' B) (B := Ω)) (hN _ hy)
    rw [map_smul, map_zero, Algebra.smul_def, hu.mul_right_eq_zero] at h0
    have hmem : Algebra.TensorProduct.includeLeft (R := A') (S := A')
        (A := TensorProduct A A' B) (B := Ω) ((∏ j, x j) ^ N) ∈ P := by
      rw [h0]; exact P.zero_mem
    rw [map_pow, map_prod] at hmem
    obtain ⟨j, -, hj⟩ := (Ideal.IsPrime.prod_mem_iff (hp := hP)).mp (hP.mem_of_pow_mem N hmem)
    exact hxP j hj

  have hpair : ∀ j k, j ≠ k → ∀ P : Ideal (TensorProduct A' (TensorProduct A A' B) Ω),
      P.IsPrime →
      RingHom.ker ((Algebra.TensorProduct.map (Ideal.Quotient.mkₐ A' (Q j))
        (AlgHom.id A' Ω)).toRingHom) ≤ P →
      RingHom.ker ((Algebra.TensorProduct.map (Ideal.Quotient.mkₐ A' (Q k))
        (AlgHom.id A' Ω)).toRingHom) ≤ P → P.IsMaximal := by
    intro j k hjk P hP hj hk
    change RingHom.ker (Algebra.TensorProduct.map (Ideal.Quotient.mkₐ A' (Q j))
      (AlgHom.id A' Ω)) ≤ P at hj
    change RingHom.ker (Algebra.TensorProduct.map (Ideal.Quotient.mkₐ A' (Q k))
      (AlgHom.id A' Ω)) ≤ P at hk
    rw [hkerQ] at hj hk
    have hle : RingHom.ker (Algebra.TensorProduct.map (Ideal.Quotient.mkₐ A' (Q j ⊔ Q k))
        (AlgHom.id A' Ω)) ≤ P := by
      rw [hkerQ, Ideal.map_sup]
      exact sup_le hj hk
    haveI hPm : (Ideal.map (Algebra.TensorProduct.map (Ideal.Quotient.mkₐ A' (Q j ⊔ Q k))
        (AlgHom.id A' Ω)) P).IsPrime := Ideal.map_isPrime_of_surjective (hsurj _) hle
    haveI hmax : (Ideal.map (Algebra.TensorProduct.map (Ideal.Quotient.mkₐ A' (Q j ⊔ Q k))
        (AlgHom.id A' Ω)) P).IsMaximal :=
      hjkmax j k hjk Ω ψ' (h3 j k) ⟨_, hPm⟩
    have hcm := Ideal.comap_isMaximal_of_surjective
      (Algebra.TensorProduct.map (Ideal.Quotient.mkₐ A' (Q j ⊔ Q k)) (AlgHom.id A' Ω))
      (hsurj _) (K := Ideal.map (Algebra.TensorProduct.map (Ideal.Quotient.mkₐ A' (Q j ⊔ Q k))
        (AlgHom.id A' Ω)) P)
    rw [Ideal.comap_map_of_surjective' _ (hsurj _), sup_eq_left.mpr hle] at hcm
    exact hcm

  have hnj' : ∀ j, Set.Finite {q : PrimeSpectrum (TensorProduct A' (TensorProduct A A' B ⧸ Q j) Ω) |
      ¬ q.asIdeal.IsMaximal} ∧ Set.ncard {q : PrimeSpectrum
        (TensorProduct A' (TensorProduct A A' B ⧸ Q j) Ω) | ¬ q.asIdeal.IsMaximal} = nj j :=
    fun j => hnj j Ω ψ' (h2 j)
  have key := @wc_alg_nonmax_count_surj (TensorProduct A' (TensorProduct A A' B) Ω) _ m
    (fun j => TensorProduct A' (TensorProduct A A' B ⧸ Q j) Ω) (fun j => inferInstance)
    (fun j => (Algebra.TensorProduct.map (Ideal.Quotient.mkₐ A' (Q j))
      (AlgHom.id A' Ω)).toRingHom) (fun j => hsurj (Q j))
  have key2 := key hcover
  have key3 := key2 hpair nj
  obtain ⟨hF, hC⟩ := key3 hnj'

  obtain ⟨e⟩ := hiso Ω ψ'
  have hNC : ∀ {P Q' : Type u} [TopologicalSpace P] [TopologicalSpace Q'] (h : P ≃ₜ Q'),
      h '' {x : P | ¬ IsClosed ({x} : Set P)} = {y : Q' | ¬ IsClosed ({y} : Set Q')} := by
    intro P Q' _ _ h
    ext y
    simp only [Set.mem_image, Set.mem_setOf_eq]
    constructor
    · rintro ⟨x, hx, rfl⟩
      have h' := h.isClosed_image (s := ({x} : Set P))
      rw [Set.image_singleton] at h'
      rwa [h']
    · intro hy
      refine ⟨h.symm y, ?_, h.apply_symm_apply y⟩
      have h' := h.isClosed_image (s := ({h.symm y} : Set P))
      rw [Set.image_singleton, h.apply_symm_apply] at h'
      rwa [← h']
  have hset : {q : PrimeSpectrum (TensorProduct A' (TensorProduct A A' B) Ω) |
      ¬ IsClosed ({q} : Set (PrimeSpectrum (TensorProduct A' (TensorProduct A A' B) Ω)))} =
      {q | ¬ q.asIdeal.IsMaximal} := by
    ext q
    simp only [Set.mem_setOf_eq, PrimeSpectrum.isClosed_singleton_iff_isMaximal]
  have himg := hNC (PrimeSpectrum.homeomorphOfRingEquiv e)
  rw [hset] at himg
  rw [← himg]
  exact ⟨hF.image _, (Set.ncard_image_of_injective _
    (PrimeSpectrum.homeomorphOfRingEquiv e).injective).trans hC⟩

theorem wc_fibre_curve_components_generic_const : ∀ (K : Type u) [Field K] [IsAlgClosed K] (S X : Scheme.{u}) (fS : S ⟶ Spec (.of K)) [IsProper fS] [IsIntegral S] (g : X ⟶ S) [IsProper g], (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (t : Spec (.of Ω) ⟶ S), topologicalKrullDim ↥(Limits.pullback g t) ≤ ((1 : ℕ) : WithBot ℕ∞)) → ∃ W : Set S, IsOpen W ∧ genericPoint S ∈ W ∧ ∀ y ∈ W, Set.ncard {x : ↥(Limits.pullback g (wcEtGeomPt S y)) | ¬ IsClosed ({x} : Set ↥(Limits.pullback g (wcEtGeomPt S y)))} = Set.ncard {x : ↥(Limits.pullback g (wcEtGeomPt S (genericPoint S))) | ¬ IsClosed ({x} : Set ↥(Limits.pullback g (wcEtGeomPt S (genericPoint S))))} :=
by
  intro K _ _ S X fS _ _ g _ hdim

  haveI : IsLocallyNoetherian S := LocallyOfFiniteType.isLocallyNoetherian fS
  obtain ⟨V, hV, hηV, -⟩ := exists_isAffineOpen_mem_and_subset (x := genericPoint S) (U := ⊤) trivial
  haveI : Nonempty V := ⟨⟨genericPoint S, hηV⟩⟩
  haveI : IsDomain Γ(S, V) := IsIntegral.component_integral V
  haveI : IsNoetherianRing Γ(S, V) := IsLocallyNoetherian.component_noetherian ⟨V, hV⟩
  haveI : IsSeparated (Limits.terminal.from X) := by
    rw [show Limits.terminal.from X = g ≫ fS ≫ Limits.terminal.from _ from
      Limits.terminal.hom_ext _ _]
    infer_instance
  have hO : IsCompact ((g ⁻¹ᵁ V : X.Opens) : Set X) := g.isCompact_preimage hV.isCompact
  obtain ⟨m, U, UT, hUO, hUcov, hUT⟩ := wc_sep_affine_cover_inter X (g ⁻¹ᵁ V) hO
  have hUTle : ∀ T : Finset (Fin m), T.Nonempty → UT T ≤ g ⁻¹ᵁ V := by
    intro T hT
    obtain ⟨i, hi⟩ := hT
    have hsub : (UT T : Set X) ⊆ (U i : Set X) := by
      intro x hx
      have hx' : x ∈ ⋂ j ∈ T, (U j : Set X) := by rw [← (hUT T ⟨i, hi⟩).2]; exact hx
      exact Set.mem_iInter₂.mp hx' i hi
    exact le_trans (show UT T ≤ U i from hsub) (hUO i)

  have hNC : ∀ {P Q : Type u} [TopologicalSpace P] [TopologicalSpace Q] (e : P ≃ₜ Q),
      e '' {x : P | ¬ IsClosed ({x} : Set P)} = {y : Q | ¬ IsClosed ({y} : Set Q)} := by
    intro P Q _ _ e
    ext y
    simp only [Set.mem_image, Set.mem_setOf_eq]
    constructor
    · rintro ⟨x, hx, rfl⟩
      have h := e.isClosed_image (s := ({x} : Set P))
      rw [Set.image_singleton] at h
      rwa [h]
    · intro hy
      refine ⟨e.symm y, ?_, e.apply_symm_apply y⟩
      have h := e.isClosed_image (s := ({e.symm y} : Set P))
      rw [Set.image_singleton, e.apply_symm_apply] at h
      rwa [← h]

  have hkey : ∀ T : Finset (Fin m), ∃ (a : Γ(S, V)) (n : ℕ), a ≠ 0 ∧
      ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (t : Spec (.of Ω) ⟶ S),
        Set.range t ⊆ (V : Set S) → t (IsLocalRing.closedPoint Ω) ∈ (S.basicOpen a : Set S) →
        T.Nonempty →
        Set.Finite {x : ↥(⋂ i ∈ T, (Limits.pullback.fst g t) ⁻¹' (U i : Set X)) |
          ¬ IsClosed ({x} : Set ↥(⋂ i ∈ T, (Limits.pullback.fst g t) ⁻¹' (U i : Set X)))} ∧
        Set.ncard {x : ↥(⋂ i ∈ T, (Limits.pullback.fst g t) ⁻¹' (U i : Set X)) |
          ¬ IsClosed ({x} : Set ↥(⋂ i ∈ T, (Limits.pullback.fst g t) ⁻¹' (U i : Set X)))} = n := by
    intro T
    by_cases hT : T.Nonempty
    · have hle := hUTle T hT
      have haff := (hUT T hT).1
      letI : Algebra Γ(S, V) Γ(X, UT T) := (g.appLE V (UT T) hle).hom.toAlgebra
      haveI : Algebra.FiniteType Γ(S, V) Γ(X, UT T) :=
        HasRingHomProperty.appLE @LocallyOfFiniteType g inferInstance ⟨V, hV⟩ ⟨UT T, haff⟩ hle
      obtain ⟨a, n, ha, hs3⟩ := wc_alg_fibre_nonclosed_generic_const Γ(S, V) Γ(X, UT T) (by
        intro Ω _ _ ψ
        obtain ⟨e⟩ := wc_affine_piece_geom_fibre_homeo S X g V (UT T) hV haff hle Ω ψ
          (Spec.map (CommRingCat.ofHom ψ) ≫ hV.fromSpec) rfl
        have h1 := hdim Ω (Spec.map (CommRingCat.ofHom ψ) ≫ hV.fromSpec)
        rw [Nat.cast_one] at h1
        have h2 := topologicalKrullDim_subspace_le _
          ((Limits.pullback.fst g (Spec.map (CommRingCat.ofHom ψ) ≫ hV.fromSpec)) ⁻¹'
            (UT T : Set X))
        have h3 := IsHomeomorph.topologicalKrullDim_eq e e.isHomeomorph
        exact (PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim _).symm.le.trans
          (h3.symm.le.trans (h2.trans h1)))
      refine ⟨a, n, ha, fun Ω _ _ t hrange hmem _ => ?_⟩
      obtain ⟨ψ, rfl, hψ⟩ := wc_point_into_affine_factor S V hV Ω t hrange
      obtain ⟨e⟩ := wc_affine_piece_geom_fibre_homeo S X g V (UT T) hV haff hle Ω ψ _ rfl
      obtain ⟨hfin, hcard⟩ := hs3 Ω ψ ((hψ a).mpr hmem)
      have himg := hNC e
      have hset : (Limits.pullback.fst g (Spec.map (CommRingCat.ofHom ψ) ≫ hV.fromSpec)) ⁻¹'
          (UT T : Set X) = ⋂ i ∈ T,
          (Limits.pullback.fst g (Spec.map (CommRingCat.ofHom ψ) ≫ hV.fromSpec)) ⁻¹'
            (U i : Set X) := by
        rw [(hUT T hT).2, Set.preimage_iInter₂]
      rw [← hset]
      have hfin' : (e '' {x | ¬ IsClosed ({x} : Set _)}).Finite := by
        rw [himg]; exact hfin
      refine ⟨hfin'.of_finite_image e.injective.injOn, ?_⟩
      rw [← Set.ncard_image_of_injective _ e.injective, himg]
      exact hcard
    · exact ⟨1, 0, one_ne_zero, fun _ _ _ _ _ _ h => absurd h hT⟩
  choose a n ha hn using hkey

  have hcount : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (t : Spec (.of Ω) ⟶ S),
      (∀ p, t p ∈ (V : Set S)) →
      (∀ T, t (IsLocalRing.closedPoint Ω) ∈ (S.basicOpen (a T) : Set S)) →
      (Set.ncard {x : ↥(Limits.pullback g t) | ¬ IsClosed ({x} : Set ↥(Limits.pullback g t))} : ℤ) =
        ∑ T ∈ (Finset.univ : Finset (Finset (Fin m))).filter (fun T => T.Nonempty),
          (-1) ^ (T.card + 1) * (n T : ℤ) := by
    intro Ω _ _ t htV hta
    haveI : JacobsonSpace ↥(Limits.pullback g t) :=
      LocallyOfFiniteType.jacobsonSpace (Limits.pullback.snd g t)
    have hcov : (⋃ i, (Limits.pullback.fst g t) ⁻¹' (U i : Set X)) = Set.univ := by
      rw [← Set.preimage_iUnion, hUcov]
      apply Set.eq_univ_of_forall
      intro z
      have h := Scheme.Hom.comp_apply (Limits.pullback.fst g t) g z
      rw [Limits.pullback.condition, Scheme.Hom.comp_apply] at h
      show g (Limits.pullback.fst g t z) ∈ (V : Set S)
      rw [← h]
      exact htV _
    refine (wc_jacobson_nonclosed_incl_excl ↥(Limits.pullback g t) m
      (fun i => (Limits.pullback.fst g t) ⁻¹' (U i : Set X))
      (fun i => (Limits.pullback.fst g t).continuous.isOpen_preimage _ (U i).isOpen) hcov
      (fun T hT => (hn T Ω t (Set.range_subset_iff.mpr htV) (hta T) hT).1)).trans
      (Finset.sum_congr rfl (fun T hT => ?_))
    exact congrArg (fun k : ℕ => (-1 : ℤ) ^ (T.card + 1) * (k : ℤ))
      (hn T Ω t (Set.range_subset_iff.mpr htV) (hta T) (Finset.mem_filter.mp hT).2).2

  have hpt : ∀ (z : S) (p : ↥(Spec (.of (AlgebraicClosure (S.residueField z))))),
      (wcEtGeomPt S z) p = z := by
    intro z p
    show (Spec.map (CommRingCat.ofHom (algebraMap (S.residueField z)
      (AlgebraicClosure (S.residueField z)))) ≫ S.fromSpecResidueField z) p = z
    rw [Scheme.Hom.comp_apply]
    exact S.fromSpecResidueField_apply z _
  have hηa : ∀ T, genericPoint S ∈ (S.basicOpen (a T) : Set S) := fun T =>
    wc_generic_point_mem_basicOpen S V (a T) (ha T)

  refine ⟨(V : Set S) ∩ ⋂ T : Finset (Fin m), (S.basicOpen (a T) : Set S), ?_, ?_, ?_⟩
  · exact V.isOpen.inter (isOpen_iInter_of_finite (fun T => (S.basicOpen (a T)).isOpen))
  · exact ⟨hηV, Set.mem_iInter.mpr hηa⟩
  · intro y hy
    have hyV : y ∈ (V : Set S) := hy.1
    have hyT := Set.mem_iInter.mp hy.2
    have e1 := hcount (AlgebraicClosure (S.residueField y)) (wcEtGeomPt S y)
      (fun p => by rw [hpt]; exact hyV)
      (fun T => by convert hyT T using 1; exact hpt _ _)
    have e2 := hcount (AlgebraicClosure (S.residueField (genericPoint S)))
      (wcEtGeomPt S (genericPoint S))
      (fun p => by rw [hpt]; exact hηV)
      (fun T => by convert hηa T using 1; exact hpt _ _)
    exact_mod_cast e1.trans e2.symm

theorem wc_et_fibre_h2_card_generic_const : ∀ (K : Type u) [Field K] [IsAlgClosed K] (S X : Scheme.{u}) (fS : S ⟶ Spec (.of K)) [IsProper fS] [IsIntegral S] (g : X ⟶ S) [IsProper g] (ℓ : ℕ), ℓ.Prime → (ℓ : K) ≠ 0 → (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (t : Spec (.of Ω) ⟶ S), topologicalKrullDim ↥(Limits.pullback g t) ≤ ((1 : ℕ) : WithBot ℕ∞)) → (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (C : Scheme.{u}) (fC : C ⟶ Spec (.of Ω)) [IsProper fC], (ℓ : Ω) ≠ 0 → topologicalKrullDim C ≤ ((1 : ℕ) : WithBot ℕ∞) → ∀ q : ℕ, Finite (wcEtCoh C ℓ q)) → (∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (Y₀ : Scheme.{u}) (f : Y₀ ⟶ Spec (.of A)) [IsProper f] (m' : ℕ), m' ≠ 0 → ∀ S : Set (Spec (.of A)), IsOpen S → S ≠ Set.univ → ∀ q' : ℕ, Subsingleton (wcEtExt Y₀ (wcEtExtZero Y₀ (f ⁻¹' S) m') q')) → ∃ W : Set S, IsOpen W ∧ genericPoint S ∈ W ∧ ∀ y ∈ W, Nat.card (wcEtCoh (Limits.pullback g (wcEtGeomPt S y)) ℓ 2) = Nat.card (wcEtCoh (Limits.pullback g (wcEtGeomPt S (genericPoint S))) ℓ 2) :=
by
  intro K _ _ S X fS _ _ g _ ℓ hℓ hℓK hdim _hcurve hPBC
  classical
  have hℓΩ : ∀ y : S, (ℓ : AlgebraicClosure (S.residueField y)) ≠ 0 := by
    intro y
    let ψ : K →+* AlgebraicClosure (S.residueField y) :=
      (algebraMap (S.residueField y) (AlgebraicClosure (S.residueField y))).comp
        ((S.evaluation ⊤ y trivial).hom.comp
          (fS.appTop.hom.comp (Scheme.ΓSpecIso (.of K)).inv.hom))
    rw [← map_natCast ψ ℓ]
    exact (map_ne_zero ψ).mpr hℓK
  have key : ∀ y : S, Nat.card (wcEtCoh (Limits.pullback g (wcEtGeomPt S y)) ℓ 2) =
      ℓ ^ Set.ncard {x : ↥(Limits.pullback g (wcEtGeomPt S y)) |
        ¬ IsClosed ({x} : Set ↥(Limits.pullback g (wcEtGeomPt S y)))} := fun y =>
    wc_et_curve_h2_card_reduction (AlgebraicClosure (S.residueField y)) ℓ hℓ (hℓΩ y) hPBC
      (fun X' fX' _ hirr hn hd => wc_et_normal_curve_h2_card _ X' fX' hirr hn hd ℓ hℓ (hℓΩ y))
      (Limits.pullback g (wcEtGeomPt S y)) (Limits.pullback.snd g (wcEtGeomPt S y))
      (hdim _ (wcEtGeomPt S y))
  obtain ⟨W, hWo, hηW, hW⟩ := wc_fibre_curve_components_generic_const K S X fS g hdim
  refine ⟨W, hWo, hηW, fun y hy => ?_⟩
  rw [key y, key (genericPoint S), hW y hy]

theorem wc_et_euler_blowup_identity : ∀ (Y X' Z : Scheme.{u}) (b : X' ⟶ Y) [IsProper b] (iZ : Z ⟶ Y) [IsClosedImmersion iZ], (∀ U : Y.Opens, (U : Set Y) = (Set.range iZ)ᶜ → IsIso (b ∣_ U)) → ∀ m : ℕ, m ≠ 0 → (∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (Y₀ : Scheme.{u}) (f : Y₀ ⟶ Spec (.of A)) [IsProper f] (m' : ℕ), m' ≠ 0 → ∀ S : Set (Spec (.of A)), IsOpen S → S ≠ Set.univ → ∀ q' : ℕ, Subsingleton (wcEtExt Y₀ (wcEtExtZero Y₀ (f ⁻¹' S) m') q')) → (∀ q : ℕ, Finite (wcEtCoh Y m q)) → (∀ q : ℕ, Finite (wcEtCoh X' m q)) → (∀ q : ℕ, Finite (wcEtCoh Z m q)) → (∀ q : ℕ, Finite (wcEtCoh (Limits.pullback b iZ) m q)) → Subsingleton (wcEtCoh Y m 3) → Subsingleton (wcEtCoh X' m 3) → Nat.card (wcEtCoh Y m 0) * Nat.card (wcEtCoh Y m 2) * Nat.card (wcEtCoh (Limits.pullback b iZ) m 0) * Nat.card (wcEtCoh (Limits.pullback b iZ) m 2) * Nat.card (wcEtCoh X' m 1) * Nat.card (wcEtCoh Z m 1) = Nat.card (wcEtCoh X' m 0) * Nat.card (wcEtCoh X' m 2) * Nat.card (wcEtCoh Z m 0) * Nat.card (wcEtCoh Z m 2) * Nat.card (wcEtCoh Y m 1) * Nat.card (wcEtCoh (Limits.pullback b iZ) m 1) :=
by
  intro Y X' Z b _ iZ _ hiso m hm hPBC hY hX hZ hE h3Y h3X
  classical




  have s2g : ∀ {C : Type (u+2)} {_ : Category.{u+1} C} {_ : Abelian C} {_ : HasExt.{u+2} C} (P : C)
      (S : ShortComplex C), S.ShortExact → Subsingleton (Abelian.Ext P S.X₂ 3) →
      Nat.card (Abelian.Ext P S.X₂ 0) * Nat.card (Abelian.Ext P S.X₂ 2) *
        Nat.card (Abelian.Ext P S.X₁ 1) * Nat.card (Abelian.Ext P S.X₁ 3) *
        Nat.card (Abelian.Ext P S.X₃ 1) =
      Nat.card (Abelian.Ext P S.X₁ 0) * Nat.card (Abelian.Ext P S.X₁ 2) *
        Nat.card (Abelian.Ext P S.X₃ 0) * Nat.card (Abelian.Ext P S.X₃ 2) *
        Nat.card (Abelian.Ext P S.X₂ 1) := by
    intro C _ _ _ P S hS h3

    have rn : ∀ {F G : C} {a c : ℕ}
        (φ : Abelian.Ext P F a →+ Abelian.Ext P G c),
        Nat.card (Abelian.Ext P F a) = Nat.card φ.ker * Nat.card φ.range := by
      intro F G a c φ
      rw [AddSubgroup.card_eq_card_quotient_mul_card_addSubgroup φ.ker,
        Nat.card_congr (QuotientAddGroup.quotientKerEquivRange φ).toEquiv, mul_comm]
    let f : ∀ n : ℕ, Abelian.Ext P S.X₁ n →+ Abelian.Ext P S.X₂ n :=
      fun n => (Abelian.Ext.mk₀ S.f).postcomp P (add_zero n)
    let g : ∀ n : ℕ, Abelian.Ext P S.X₂ n →+ Abelian.Ext P S.X₃ n :=
      fun n => (Abelian.Ext.mk₀ S.g).postcomp P (add_zero n)
    let d : ∀ n : ℕ, Abelian.Ext P S.X₃ n →+ Abelian.Ext P S.X₁ (n + 1) :=
      fun n => hS.extClass.postcomp P rfl

    have K1 : (f 0).ker = ⊥ := by
      rw [eq_bot_iff]
      intro x hx
      rw [AddMonoidHom.mem_ker] at hx
      rw [AddSubgroup.mem_bot]
      obtain ⟨g', rfl⟩ : ∃ g', Abelian.Ext.mk₀ g' = x := ⟨_, Abelian.Ext.mk₀_homEquiv₀_apply x⟩
      have hx' : Abelian.Ext.mk₀ (g' ≫ S.f) = Abelian.Ext.mk₀ 0 := by
        rw [← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_zero]
        exact hx
      rw [← Abelian.Ext.homEquiv₀_symm_apply, ← Abelian.Ext.homEquiv₀_symm_apply] at hx'
      have hg : g' ≫ S.f = 0 := Abelian.Ext.homEquiv₀.symm.injective hx'
      haveI := hS.mono_f
      rw [Limits.zero_of_comp_mono S.f hg, Abelian.Ext.mk₀_zero]

    have K2 : ∀ n : ℕ, (g n).ker = (f n).range := by
      intro n
      ext x
      constructor
      · intro hx
        rw [AddMonoidHom.mem_ker] at hx
        obtain ⟨y, hy⟩ := Abelian.Ext.covariant_sequence_exact₂ P hS x hx
        exact ⟨y, hy⟩
      · rintro ⟨y, rfl⟩
        rw [AddMonoidHom.mem_ker]
        show ((y.comp (Abelian.Ext.mk₀ S.f) (add_zero n)).comp (Abelian.Ext.mk₀ S.g)
          (add_zero n)) = 0
        rw [Abelian.Ext.comp_assoc _ _ _ (add_zero n) (add_zero 0) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, S.zero, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]

    have K3 : ∀ n : ℕ, (d n).ker = (g n).range := by
      intro n
      ext x
      constructor
      · intro hx
        rw [AddMonoidHom.mem_ker] at hx
        obtain ⟨y, hy⟩ := Abelian.Ext.covariant_sequence_exact₃ P hS x rfl hx
        exact ⟨y, hy⟩
      · rintro ⟨y, rfl⟩
        rw [AddMonoidHom.mem_ker]
        show ((y.comp (Abelian.Ext.mk₀ S.g) (add_zero n)).comp hS.extClass rfl) = 0
        rw [Abelian.Ext.comp_assoc _ _ _ (add_zero n) (zero_add 1) (by omega),
          hS.comp_extClass, Abelian.Ext.comp_zero]

    have K4 : ∀ n : ℕ, (f (n + 1)).ker = (d n).range := by
      intro n
      ext x
      constructor
      · intro hx
        rw [AddMonoidHom.mem_ker] at hx
        obtain ⟨y, hy⟩ := Abelian.Ext.covariant_sequence_exact₁ P hS x hx rfl
        exact ⟨y, hy⟩
      · rintro ⟨y, rfl⟩
        rw [AddMonoidHom.mem_ker]
        show ((y.comp hS.extClass rfl).comp (Abelian.Ext.mk₀ S.f) (add_zero (n + 1))) = 0
        rw [Abelian.Ext.comp_assoc _ _ _ rfl (add_zero 1) (by omega),
          hS.extClass_comp, Abelian.Ext.comp_zero]

    have Surj : (d 2).range = ⊤ := by
      rw [eq_top_iff]
      intro x _
      have h0 : x.comp (Abelian.Ext.mk₀ S.f) (add_zero 3) = 0 := Subsingleton.elim _ _
      obtain ⟨y, hy⟩ := Abelian.Ext.covariant_sequence_exact₁ P hS x h0 (rfl : 2 + 1 = 3)
      exact ⟨y, hy⟩
    have K4a : (f 1).ker = (d 0).range := K4 0
    have K4b : (f 2).ker = (d 1).range := K4 1

    have cA0 : Nat.card (Abelian.Ext P S.X₁ 0) = Nat.card (f 0).range := by
      rw [rn (f 0), K1, AddSubgroup.card_bot, one_mul]
    have cB0 : Nat.card (Abelian.Ext P S.X₂ 0) = Nat.card (f 0).range * Nat.card (g 0).range := by
      rw [rn (g 0), K2 0]
    have cC0 : Nat.card (Abelian.Ext P S.X₃ 0) = Nat.card (g 0).range * Nat.card (d 0).range := by
      rw [rn (d 0), K3 0]
    have cA1 : Nat.card (Abelian.Ext P S.X₁ 1) = Nat.card (d 0).range * Nat.card (f 1).range := by
      rw [rn (f 1), K4a]
    have cB1 : Nat.card (Abelian.Ext P S.X₂ 1) = Nat.card (f 1).range * Nat.card (g 1).range := by
      rw [rn (g 1), K2 1]
    have cC1 : Nat.card (Abelian.Ext P S.X₃ 1) = Nat.card (g 1).range * Nat.card (d 1).range := by
      rw [rn (d 1), K3 1]
    have cA2 : Nat.card (Abelian.Ext P S.X₁ 2) = Nat.card (d 1).range * Nat.card (f 2).range := by
      rw [rn (f 2), K4b]
    have cB2 : Nat.card (Abelian.Ext P S.X₂ 2) = Nat.card (f 2).range * Nat.card (g 2).range := by
      rw [rn (g 2), K2 2]
    have cC2 : Nat.card (Abelian.Ext P S.X₃ 2) = Nat.card (g 2).range * Nat.card (d 2).range := by
      rw [rn (d 2), K3 2]
    have cA3 : Nat.card (Abelian.Ext P S.X₁ 3) = Nat.card (d 2).range := by
      rw [Surj]
      exact AddSubgroup.card_top.symm
    rw [cB0, cB2, cA1, cA3, cC1, cA0, cA2, cC0, cC2, cB1]
    ring

  have s3g : ∀ {C : Type (u+2)} {_ : Category.{u+1} C} {_ : Abelian C} {_ : HasExt.{u+2} C} (P : C)
      (S : ShortComplex C), S.ShortExact → (∀ n, Finite (Abelian.Ext P S.X₂ n)) →
      (∀ n, Finite (Abelian.Ext P S.X₃ n)) → ∀ n, Finite (Abelian.Ext P S.X₁ n) := by
    intro C _ _ _ P S hS hB hC q
    have h2 : Finite (Abelian.Ext P S.X₂ q) := hB q
    let φ : Abelian.Ext P S.X₁ q →+ Abelian.Ext P S.X₂ q :=
      (Abelian.Ext.mk₀ S.f).postcomp P (add_zero q)
    cases q with
    | zero =>
      refine Finite.of_injective φ ?_
      rw [injective_iff_map_eq_zero]
      intro x hx
      obtain ⟨g, rfl⟩ : ∃ g, Abelian.Ext.mk₀ g = x := ⟨_, Abelian.Ext.mk₀_homEquiv₀_apply x⟩
      have hx' : Abelian.Ext.mk₀ (g ≫ S.f) = Abelian.Ext.mk₀ 0 := by
        rw [← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_zero]
        exact hx
      rw [← Abelian.Ext.homEquiv₀_symm_apply, ← Abelian.Ext.homEquiv₀_symm_apply] at hx'
      have hg : g ≫ S.f = 0 := Abelian.Ext.homEquiv₀.symm.injective hx'
      haveI := hS.mono_f
      rw [Limits.zero_of_comp_mono S.f hg, Abelian.Ext.mk₀_zero]
    | succ n₀ =>
      have h3 : Finite (Abelian.Ext P S.X₃ n₀) := hC n₀
      let δ : Abelian.Ext P S.X₃ n₀ →+ Abelian.Ext P S.X₁ (n₀ + 1) :=
        hS.extClass.postcomp P rfl
      have hex : ∀ x, φ x = 0 → ∃ y, δ y = x := fun x hx =>
        Abelian.Ext.covariant_sequence_exact₁ P hS x hx rfl
      haveI : Nonempty (Abelian.Ext P S.X₁ (n₀ + 1)) := ⟨0⟩
      let σ : Abelian.Ext P S.X₂ (n₀ + 1) → Abelian.Ext P S.X₁ (n₀ + 1) :=
        Function.invFun φ
      have hσ : ∀ x, φ (σ (φ x)) = φ x := fun x => Function.invFun_eq ⟨x, rfl⟩
      have hpre : ∀ x, ∃ y, δ y = x - σ (φ x) := fun x =>
        hex _ (by rw [map_sub, hσ, sub_self])
      choose τ hτ using hpre
      refine Finite.of_injective (fun x => (φ x, τ x)) ?_
      intro x x' hxx
      simp only [Prod.mk.injEq] at hxx
      obtain ⟨e1, e2⟩ := hxx
      have := hτ x
      rw [e2, hτ x', e1] at this
      exact (sub_left_inj.mp this).symm


  have s2 : ∀ (W : Scheme.{u})
      (S : ShortComplex (Sheaf (Scheme.smallEtaleTopology W) AddCommGrpCat.{u+1})),
      S.ShortExact → Subsingleton (wcEtExt W S.X₂ 3) →
      Nat.card (wcEtExt W S.X₂ 0) * Nat.card (wcEtExt W S.X₂ 2) * Nat.card (wcEtExt W S.X₁ 1) *
        Nat.card (wcEtExt W S.X₁ 3) * Nat.card (wcEtExt W S.X₃ 1) =
      Nat.card (wcEtExt W S.X₁ 0) * Nat.card (wcEtExt W S.X₁ 2) * Nat.card (wcEtExt W S.X₃ 0) *
        Nat.card (wcEtExt W S.X₃ 2) * Nat.card (wcEtExt W S.X₂ 1) := by
    intro W S hS
    unfold wcEtExt Sheaf.H
    intro h3
    exact s2g _ S hS h3
  have s3 : ∀ (W : Scheme.{u})
      (S : ShortComplex (Sheaf (Scheme.smallEtaleTopology W) AddCommGrpCat.{u+1})),
      S.ShortExact → (∀ n, Finite (wcEtExt W S.X₂ n)) → (∀ n, Finite (wcEtExt W S.X₃ n)) →
      ∀ n, Finite (wcEtExt W S.X₁ n) := by
    intro W S hS
    unfold wcEtExt Sheaf.H
    intro hB hC
    exact s3g _ S hS hB hC

  have hmono : ∀ (W : Scheme.{u}) (S : Set W), Mono (wcEtExtZeroι W S m) := by
    intro W S
    let α : wcEtExtZeroPre W S m ⟶
        (Functor.const _).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))) :=
      { app := fun V => AddCommGrpCat.ofHom (wcSuppSub.{u} m (∀ x, V.unop.hom x ∈ S)).subtype
        naturality := fun _ _ _ => rfl }
    haveI : ∀ V, Mono (α.app V) := fun V =>
      (AddCommGrpCat.mono_iff_injective _).mpr (AddSubgroup.subtype_injective _)
    haveI : Mono α := NatTrans.mono_of_mono_app α
    exact Functor.map_mono (presheafToSheaf (Scheme.smallEtaleTopology W) AddCommGrpCat.{u+1}) α
  have hT : ∀ (W : Scheme.{u}) (S : Set W),
      (ShortComplex.mk (wcEtExtZeroι W S m) (Limits.cokernel.π _)
        (Limits.cokernel.condition _)).ShortExact := by
    intro W S
    haveI := hmono W S
    exact ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel _) inferInstance inferInstance
  let TY := ShortComplex.mk (wcEtExtZeroι Y (Set.range iZ)ᶜ m) (Limits.cokernel.π _)
    (Limits.cokernel.condition _)
  let TX := ShortComplex.mk (wcEtExtZeroι X' (Set.range (Limits.pullback.fst b iZ))ᶜ m)
    (Limits.cokernel.π _) (Limits.cokernel.condition _)
  have hTY : TY.ShortExact := hT Y _
  have hTX : TX.ShortExact := hT X' _

  have eQ : ∀ n, Nonempty (wcEtExt Y TY.X₃ n ≃ wcEtCoh Z m n) := fun n =>
    wc_et_closed_complement_coh Y Z iZ m n
  have eE : ∀ n, Nonempty (wcEtExt X' TX.X₃ n ≃ wcEtCoh (Limits.pullback b iZ) m n) := fun n =>
    wc_et_closed_complement_coh X' (Limits.pullback b iZ) (Limits.pullback.fst b iZ) m n
  have eJ : ∀ n, Nonempty (wcEtExt Y TY.X₁ n ≃ wcEtExt X' TX.X₁ n) := fun n =>
    wc_et_proper_excision Y X' Z b iZ hiso m hm hPBC n

  have hBX : ∀ n, Finite (wcEtExt X' TX.X₂ n) := fun n => hX n
  have hCX : ∀ n, Finite (wcEtExt X' TX.X₃ n) := fun n => by
    haveI := hE n
    exact Finite.of_equiv _ (eE n).some.symm
  have hAX : ∀ n, Finite (wcEtExt X' TX.X₁ n) := s3 X' TX hTX hBX hCX
  have hAY : ∀ n, Finite (wcEtExt Y TY.X₁ n) := fun n => by
    haveI := hAX n
    exact Finite.of_equiv _ (eJ n).some.symm
  have hneY : ∀ n, Nonempty (wcEtExt Y TY.X₁ n) := fun n => by
    unfold wcEtExt
    exact ⟨0⟩
  have hj : 0 < Nat.card (wcEtExt Y TY.X₁ 1) * Nat.card (wcEtExt Y TY.X₁ 3) := by
    haveI := hAY 1
    haveI := hAY 3
    haveI := hneY 1
    haveI := hneY 3
    exact Nat.mul_pos Nat.card_pos Nat.card_pos

  have hIY := s2 Y TY hTY h3Y
  have hIX := s2 X' TX hTX h3X
  have cZ : ∀ q, Nat.card (wcEtExt Y TY.X₃ q) = Nat.card (wcEtCoh Z m q) := fun q =>
    Nat.card_congr (eQ q).some
  have cE : ∀ q, Nat.card (wcEtExt X' TX.X₃ q) = Nat.card (wcEtCoh (Limits.pullback b iZ) m q) :=
    fun q => Nat.card_congr (eE q).some
  have cJ : ∀ q, Nat.card (wcEtExt X' TX.X₁ q) = Nat.card (wcEtExt Y TY.X₁ q) := fun q =>
    (Nat.card_congr (eJ q).some).symm
  rw [cZ 0, cZ 1, cZ 2] at hIY
  rw [cE 0, cE 1, cE 2, cJ 0, cJ 1, cJ 2, cJ 3] at hIX

  have arith : ∀ (Y0 Y2 Y1 X0 X2 X1 Z0 Z2 Z1 E0 E2 E1 j0 j1 j2 j3 : ℕ), 0 < j1 * j3 →
      Y0 * Y2 * j1 * j3 * Z1 = j0 * j2 * Z0 * Z2 * Y1 →
      X0 * X2 * j1 * j3 * E1 = j0 * j2 * E0 * E2 * X1 →
      Y0 * Y2 * E0 * E2 * X1 * Z1 = X0 * X2 * Z0 * Z2 * Y1 * E1 := by
    intro Y0 Y2 Y1 X0 X2 X1 Z0 Z2 Z1 E0 E2 E1 j0 j1 j2 j3 hpos h1 h2
    apply Nat.eq_of_mul_eq_mul_right hpos
    calc Y0 * Y2 * E0 * E2 * X1 * Z1 * (j1 * j3)
        = (Y0 * Y2 * j1 * j3 * Z1) * (E0 * E2 * X1) := by ring
      _ = (j0 * j2 * Z0 * Z2 * Y1) * (E0 * E2 * X1) := by rw [h1]
      _ = (Z0 * Z2 * Y1) * (j0 * j2 * E0 * E2 * X1) := by ring
      _ = (Z0 * Z2 * Y1) * (X0 * X2 * j1 * j3 * E1) := by rw [h2]
      _ = X0 * X2 * Z0 * Z2 * Y1 * E1 * (j1 * j3) := by ring
  exact arith _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ hj hIY hIX

theorem wc_et_stalk_card_generic_le_nbhd : ∀ (B : Scheme.{u}) [IsIntegral B] (F : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}), (∀ b : B, IsCofiltered (StructuredArrow (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B))) → Finite ((wcEtStalk B (genericPoint B)).obj F) → ∃ U : Set B, IsOpen U ∧ genericPoint B ∈ U ∧ ∀ y ∈ U, Finite ((wcEtStalk B y).obj F) → Nat.card ((wcEtStalk B (genericPoint B)).obj F) ≤ Nat.card ((wcEtStalk B y).obj F) :=
by
  intro B _ F hcof hfinη
  obtain ⟨V, t, ht, σ, hσ, -, hfib⟩ := wc_et_stalk_good_nbhd B F F (𝟙 F) (genericPoint B)
    (hcof (genericPoint B)) (fun φ _ v => wc_etale_fibre_point_isolated φ v) hfinη
  haveI : Etale V.hom := V.prop
  have hgp : ∀ b : B,
      (wcEtGeomPt B b) (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField b))) = b :=
    fun b => (Scheme.Hom.comp_apply _ _ _).trans (Scheme.fromSpecResidueField_apply _ _)
  have htη : V.hom (t (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField (genericPoint B)))))
      = genericPoint B :=
    (Scheme.Hom.comp_apply t V.hom _).symm.trans
      ((congrArg (fun f : Spec (.of (AlgebraicClosure (B.residueField (genericPoint B)))) ⟶ B =>
        f (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField (genericPoint B))))) ht).trans
        (hgp _))
  refine ⟨Set.range V.hom, V.hom.isOpenMap.isOpen_range, ⟨_, htη⟩, ?_⟩
  rintro y ⟨v, rfl⟩ hfiny
  have hηy : genericPoint B ⤳ V.hom v := (genericPoint_spec B).specializes (Set.mem_univ _)
  obtain ⟨w, hwv, hwη⟩ := Flat.generalizingMap V.hom hηy
  have hsp : t (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField (genericPoint B)))) ⤳ v := by
    rw [← hfib w hwη]; exact hwv
  obtain ⟨t', ht', ht'v⟩ := wc_etale_lift_alg_closed_point
    (AlgebraicClosure (B.residueField (V.hom v))) V.hom (wcEtGeomPt B (V.hom v)) v
    (hgp (V.hom v)).symm
  have hsp' : t (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField (genericPoint B)))) ⤳
      t' (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField (V.hom v)))) := by
    rw [ht'v]; exact hsp
  have htr := wc_et_germ_transfer_specialize B F hcof wc_etale_lift_alg_closed_point V
    (genericPoint B) (V.hom v) t ht t' ht' hsp'
  let φ : (wcEtStalk B (genericPoint B)).obj F → (wcEtStalk B (V.hom v)).obj F := fun x =>
    (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt B (V.hom v)))
      (Scheme.Etale.forget B)).op ⋙ F.obj) (Opposite.op (StructuredArrow.mk
        (Over.homMk t' ht' : Over.mk (wcEtGeomPt B (V.hom v)) ⟶
          (Scheme.Etale.forget B).obj V)))).hom (σ x)
  have hinj : Function.Injective φ := by
    intro x x' hxx
    have h0 := (htr (σ x - σ x')).1 (by rw [map_sub]; exact sub_eq_zero.mpr hxx)
    rw [map_sub, hσ x, hσ x'] at h0
    exact sub_eq_zero.mp h0
  haveI := hfiny
  exact Nat.card_le_card_of_injective φ hinj

theorem wc_et_stalk_card_le_generic_of_cospec_inj : ∀ (B : Scheme.{u}) [IsIntegral B] (F : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}) (y : B), (∀ b : B, IsCofiltered (StructuredArrow (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B))) → Finite ((wcEtStalk B y).obj F) → Finite ((wcEtStalk B (genericPoint B)).obj F) → (∀ (V : B.Etale) (t : Spec (.of (AlgebraicClosure (B.residueField y))) ⟶ V.left) (ht : t ≫ V.hom = wcEtGeomPt B y) (t' : Spec (.of (AlgebraicClosure (B.residueField (genericPoint B)))) ⟶ V.left) (ht' : t' ≫ V.hom = wcEtGeomPt B (genericPoint B)), t' (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField (genericPoint B)))) ⤳ t (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField y))) → ∀ s : F.obj.obj (Opposite.op V), (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt B (genericPoint B))) (Scheme.Etale.forget B)).op ⋙ F.obj) (Opposite.op (StructuredArrow.mk (Over.homMk t' ht' : Over.mk (wcEtGeomPt B (genericPoint B)) ⟶ (Scheme.Etale.forget B).obj V)))).hom s = 0 → (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt B y)) (Scheme.Etale.forget B)).op ⋙ F.obj) (Opposite.op (StructuredArrow.mk (Over.homMk t ht : Over.mk (wcEtGeomPt B y) ⟶ (Scheme.Etale.forget B).obj V)))).hom s = 0) → Nat.card ((wcEtStalk B y).obj F) ≤ Nat.card ((wcEtStalk B (genericPoint B)).obj F) :=
by
  intro B _ F y hcof hfiny hfinη hcosp
  obtain ⟨V, t, ht, σ, hσ, -, -⟩ := wc_et_stalk_good_nbhd B F F (𝟙 F) y
    (hcof y) (fun φ _ v => wc_etale_fibre_point_isolated φ v) hfiny
  haveI : Etale V.hom := V.prop
  have hgp : ∀ b : B,
      (wcEtGeomPt B b) (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField b))) = b :=
    fun b => (Scheme.Hom.comp_apply _ _ _).trans (Scheme.fromSpecResidueField_apply _ _)
  have hvy : V.hom (t (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField y)))) = y :=
    (Scheme.Hom.comp_apply t V.hom _).symm.trans
      ((congrArg (fun f : Spec (.of (AlgebraicClosure (B.residueField y))) ⟶ B =>
        f (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField y)))) ht).trans (hgp y))
  have hηy : genericPoint B ⤳
      V.hom (t (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField y)))) :=
    (genericPoint_spec B).specializes (Set.mem_univ _)
  obtain ⟨w, hwv, hwη⟩ := Flat.generalizingMap V.hom hηy
  obtain ⟨t', ht', ht'w⟩ := wc_etale_lift_alg_closed_point
    (AlgebraicClosure (B.residueField (genericPoint B))) V.hom (wcEtGeomPt B (genericPoint B)) w
    (hwη.trans (hgp (genericPoint B)).symm)
  have hsp : t' (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField (genericPoint B)))) ⤳
      t (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField y))) := by
    rw [ht'w]; exact hwv
  let φ : (wcEtStalk B y).obj F → (wcEtStalk B (genericPoint B)).obj F := fun x =>
    (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt B (genericPoint B)))
      (Scheme.Etale.forget B)).op ⋙ F.obj) (Opposite.op (StructuredArrow.mk
        (Over.homMk t' ht' : Over.mk (wcEtGeomPt B (genericPoint B)) ⟶
          (Scheme.Etale.forget B).obj V)))).hom (σ x)
  have hinj : Function.Injective φ := by
    intro x x' hxx
    have h0 := hcosp V t ht t' ht' hsp (σ x - σ x')
      (by rw [map_sub]; exact sub_eq_zero.mpr hxx)
    rw [map_sub, hσ x, hσ x'] at h0
    exact sub_eq_zero.mp h0
  haveI := hfinη
  exact Nat.card_le_card_of_injective φ hinj

theorem wc_et_push_h1_local_cocycle : ∀ {X S : Scheme.{u}} (g : X ⟶ S) (C : CochainComplex (Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) ℕ) (V : S.Etale) (s : ((((wcEtPush g).mapHomologicalComplex (ComplexShape.up ℕ)).obj C).homology 1).obj.obj (Opposite.op V)) (v : V.left), ∃ (U : S.Etale) (d : U ⟶ V) (u : U.left) (z : (C.X 1).obj.obj (Opposite.op ((wcEtBaseChange g).obj U))), d.left u = v ∧ ((C.d 1 2).hom.app (Opposite.op ((wcEtBaseChange g).obj U))).hom z = 0 ∧ (∀ (U'' : S.Etale) (c : U'' ⟶ U) (e : (C.X 0).obj.obj (Opposite.op ((wcEtBaseChange g).obj U''))), ((C.d 0 1).hom.app (Opposite.op ((wcEtBaseChange g).obj U''))).hom e = ((C.X 1).obj.map ((wcEtBaseChange g).map c).op).hom z → (((((wcEtPush g).mapHomologicalComplex (ComplexShape.up ℕ)).obj C).homology 1).obj.map (c ≫ d).op).hom s = 0) ∧ (∀ (U'' : S.Etale) (c : U'' ⟶ U), (((((wcEtPush g).mapHomologicalComplex (ComplexShape.up ℕ)).obj C).homology 1).obj.map (c ≫ d).op).hom s = 0 → ∀ u'' : U''.left, ∃ (U₃ : S.Etale) (c₃ : U₃ ⟶ U'') (u₃ : U₃.left) (e : (C.X 0).obj.obj (Opposite.op ((wcEtBaseChange g).obj U₃))), c₃.left u₃ = u'' ∧ ((C.d 0 1).hom.app (Opposite.op ((wcEtBaseChange g).obj U₃))).hom e = ((C.X 1).obj.map ((wcEtBaseChange g).map (c₃ ≫ c)).op).hom z) :=
by
  intro X S g C V s v
  classical

  have hpt : ∀ (W : S.Etale) (R : Sieve W), R ∈ Scheme.smallEtaleTopology S W →
      ∀ w : W.left, ∃ (W₁ : S.Etale) (f : W₁ ⟶ W) (w₁ : W₁.left), R.arrows f ∧ f.left w₁ = w := by
    intro W R hR w
    change R ∈ Scheme.smallGrothendieckTopology @Etale S W at hR
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale S
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hR
    obtain ⟨W₁, f, w₁, hf, _, hw⟩ := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale S
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mp hR w
    exact ⟨W₁, f, w₁, hf, hw⟩

  let Φ : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1} ⥤
      ((S.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) :=
    sheafToPresheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1} ⋙
      (Functor.whiskeringLeft (S.Etale)ᵒᵖ (X.Etale)ᵒᵖ AddCommGrpCat.{u+1}).obj
        (@Functor.op S.Etale _ X.Etale _ (wcEtBaseChange g))
  let T : ShortComplex ((S.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) :=
    ShortComplex.mk (Φ.map (C.d 0 1)) (Φ.map (C.d 1 2))
      (by rw [← Functor.map_comp, C.d_comp_d, Functor.map_zero])
  let K := ((wcEtPush g).mapHomologicalComplex (ComplexShape.up ℕ)).obj C
  obtain ⟨Θ⟩ : Nonempty (K.homology 1 ≅
      (presheafToSheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}).obj T.homology) :=
    ⟨(HomologicalComplex.homologyIsoSc' K 0 1 2 (CochainComplex.prev_nat_succ 0)
        (CochainComplex.next ℕ 1) :
      _ ≅ (T.map (presheafToSheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1})).homology) ≪≫
      T.mapHomologyIso (presheafToSheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1})⟩

  have hΘinj : ∀ (W : (S.Etale)ᵒᵖ) (x : (K.homology 1).obj.obj W),
