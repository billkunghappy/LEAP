import WeilR2_Part04
set_option maxHeartbeats 4000000

open CategoryTheory AlgebraicGeometry

theorem wc_et_locKill_of_limit_vanishing : ∀ {X' Y' : Scheme.{u}} (h : X' ⟶ Y') [IsProper h] (A : Type u) [CommRing A] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W : Λ ⥤ Y'.Etale) (φ : ∀ l, Spec (.of A) ⟶ (W.obj l).left) (a : Spec (.of A) ⟶ Y'), (∀ l, IsAffine (W.obj l).left) → (∀ {l l' : Λ} (t : l ⟶ l'), φ l ≫ (W.map t).left = φ l') → (∀ l, φ l ≫ (W.obj l).hom = a) → (∀ (T : Scheme.{u}) (z : ∀ l, T ⟶ (W.obj l).left), (∀ {l l' : Λ} (t : l ⟶ l'), z l ≫ (W.map t).left = z l') → ∃! z₀ : T ⟶ Spec (.of A), ∀ l, z₀ ≫ φ l = z l) → ∀ (XZ : Scheme.{u}) (p : XZ ⟶ X') (hZ : XZ ⟶ Spec (.of A)), IsPullback p hZ h a → ∀ (F : Sheaf (Scheme.smallEtaleTopology X') AddCommGrpCat.{u+1}) (L : Sheaf (Scheme.smallEtaleTopology X') AddCommGrpCat.{u+1} ⥤ Sheaf (Scheme.smallEtaleTopology XZ) AddCommGrpCat.{u+1}), Nonempty (L ⊣ wcEtPush p) → (∀ q : ℕ, Subsingleton (wcEtExt XZ (L.obj F) q)) → ∀ (I : InjectiveResolution F) (n : ℕ) (l : Λ) (c : (I.cocomplex.X n).obj.obj (Opposite.op ((wcEtBaseChange h).obj (W.obj l)))), ((I.cocomplex.d n (n + 1)).hom.app (Opposite.op ((wcEtBaseChange h).obj (W.obj l)))).hom c = 0 → ∃ (l' : Λ) (t : l' ⟶ l) (e : (I.cocomplex.X (n - 1)).obj.obj (Opposite.op ((wcEtBaseChange h).obj (W.obj l')))), ((I.cocomplex.d (n - 1) n).hom.app (Opposite.op ((wcEtBaseChange h).obj (W.obj l')))).hom e = ((I.cocomplex.X n).obj.map ((wcEtBaseChange h).map (W.map t)).op).hom c :=
by
  intro X' Y' h _ A _ Λ _ _ W φ a hW hφ hφa hlim XZ p hZ hpb F L hadj hvan I n l c hc
  obtain ⟨adj⟩ := hadj

  obtain ⟨π, hπ, hπc, hπlim, hcpt, hqs, haff, hZc, hZq, hZs⟩ :=
    wc_et_baseChange_limit_presentation h A Λ W φ a hW hφ hφa hlim XZ p hZ hpb

  obtain ⟨L₀, ⟨adj₀⟩, hL₀, -⟩ := wc_et_push_left_adjoint p
  haveI := hL₀
  haveI : Limits.PreservesFiniteLimits L :=
    Limits.preservesFiniteLimits_of_natIso (adj₀.leftAdjointUniq adj)
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology XZ) AddCommGrpCat.{u+1}) := HasExt.standard _

  have hA : ∀ q : ℕ, Subsingleton (Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology XZ)
      AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) (L.obj F) q) := fun q => hvan q
  have hK : ∀ j q : ℕ, Subsingleton (Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology XZ)
      AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)))
      (L.obj (I.cocomplex.X j)) (q + 1)) := fun j q =>
    wc_et_pullback_injective_limit_acyclic p L ⟨adj⟩ Λ (W ⋙ wcEtBaseChange h) π hπ hπc hπlim
      hcpt hqs haff hZc hZq hZs (I.cocomplex.X j) q

  obtain ⟨ρ, hnat, hV, -, hlimρ⟩ := wc_et_pullback_sections_colimit p L ⟨adj⟩
  have hπ' : ∀ l, π l ≫ ((W ⋙ wcEtBaseChange h).obj l).hom = (wcEtTop XZ).hom ≫ p :=
    fun l => (hπ l).trans (Category.id_comp p).symm
  obtain ⟨hsurj, hinj⟩ := hlimρ (wcEtTop XZ) Λ (W ⋙ wcEtBaseChange h) π hπ' hπc hπlim hcpt hqs
    haff hZc hZq
  have hρα : ∀ (G : Sheaf (Scheme.smallEtaleTopology X') AddCommGrpCat.{u+1}) (V : X'.Etale)
      (α β : (wcEtTop XZ).left ⟶ V.left) (hα : α ≫ V.hom = (wcEtTop XZ).hom ≫ p)
      (hβ : β ≫ V.hom = (wcEtTop XZ).hom ≫ p) (x : G.obj.obj (Opposite.op V)),
      α = β → ρ G (wcEtTop XZ) V α hα x = ρ G (wcEtTop XZ) V β hβ x := by
    intro G V α β hα hβ x e
    subst e
    rfl
  have htr : ∀ (G : Sheaf (Scheme.smallEtaleTopology X') AddCommGrpCat.{u+1}) {l₁ l₂ : Λ}
      (t : l₁ ⟶ l₂) (x : G.obj.obj (Opposite.op ((W ⋙ wcEtBaseChange h).obj l₂))),
      ρ G (wcEtTop XZ) ((W ⋙ wcEtBaseChange h).obj l₁) (π l₁) (hπ' l₁)
        ((G.obj.map ((W ⋙ wcEtBaseChange h).map t).op).hom x) =
      ρ G (wcEtTop XZ) ((W ⋙ wcEtBaseChange h).obj l₂) (π l₂) (hπ' l₂) x := by
    intro G l₁ l₂ t x
    rw [← hV G (wcEtTop XZ) _ _ ((W ⋙ wcEtBaseChange h).map t) (π l₁) (hπ' l₁)
      ((congrArg (fun k => k ≫ ((W ⋙ wcEtBaseChange h).obj l₂).hom) (hπc t)).trans (hπ' l₂)) x]
    exact hρα _ _ _ _ _ _ _ (hπc t)

  obtain ⟨ε, hεnat, hε0⟩ := wc_et_const_hom_sections_equiv XZ (wcEtTop XZ)
    (@MorphismProperty.Over.mkIdTerminal _ _ @Etale XZ
      MorphismProperty.IsMultiplicative.toContainsIdentities)

  have hc' : ((I.cocomplex.d n (n + 1)).hom.app
      (Opposite.op ((W ⋙ wcEtBaseChange h).obj l))).hom c = 0 := hc
  obtain ⟨γ, hεγ⟩ : ∃ γ, ε (L.obj (I.cocomplex.X n)) γ =
      ρ (I.cocomplex.X n) (wcEtTop XZ) ((W ⋙ wcEtBaseChange h).obj l) (π l) (hπ' l) c :=
    ⟨_, Equiv.apply_symm_apply _ _⟩
  have hγd : γ ≫ L.map (I.cocomplex.d n (n + 1)) = 0 := by
    apply (ε (L.obj (I.cocomplex.X (n + 1)))).injective
    rw [hεnat, hε0, hεγ]
    refine (hnat _ _ (I.cocomplex.d n (n + 1)) (wcEtTop XZ) _ (π l) (hπ' l) c).symm.trans ?_
    rw [hc', map_zero]

  obtain ⟨η, hη⟩ := wc_adj_resolution_cocycle_lift L (wcEtPush p) adj _ F I hA hK n γ hγd

  obtain ⟨l₁, e₀, he₀⟩ := hsurj (I.cocomplex.X (n - 1)) (ε _ η)
  obtain ⟨e₁, he₁⟩ : ∃ e₁, e₁ = ((I.cocomplex.X (n - 1)).obj.map
      ((W ⋙ wcEtBaseChange h).map (IsCofiltered.minToRight l l₁)).op).hom e₀ := ⟨_, rfl⟩
  obtain ⟨c₁, hc₁⟩ : ∃ c₁, c₁ = ((I.cocomplex.X n).obj.map
      ((W ⋙ wcEtBaseChange h).map (IsCofiltered.minToLeft l l₁)).op).hom c := ⟨_, rfl⟩
  have hE1 : ρ (I.cocomplex.X (n - 1)) (wcEtTop XZ)
      ((W ⋙ wcEtBaseChange h).obj (IsCofiltered.min l l₁)) (π (IsCofiltered.min l l₁))
      (hπ' (IsCofiltered.min l l₁)) e₁ = ε _ η := by
    rw [he₁]
    exact (htr _ (IsCofiltered.minToRight l l₁) e₀).trans he₀
  have h1 : ρ (I.cocomplex.X n) (wcEtTop XZ)
      ((W ⋙ wcEtBaseChange h).obj (IsCofiltered.min l l₁)) (π (IsCofiltered.min l l₁))
      (hπ' (IsCofiltered.min l l₁))
      (((I.cocomplex.d (n - 1) n).hom.app
        (Opposite.op ((W ⋙ wcEtBaseChange h).obj (IsCofiltered.min l l₁)))).hom e₁) =
      ε _ γ :=
    (hnat _ _ (I.cocomplex.d (n - 1) n) (wcEtTop XZ) _ (π (IsCofiltered.min l l₁))
      (hπ' (IsCofiltered.min l l₁)) e₁).trans
      ((congrArg (fun z => ((L.map (I.cocomplex.d (n - 1) n)).hom.app
          (Opposite.op (wcEtTop XZ))).hom z) hE1).trans
        ((hεnat _ _ (L.map (I.cocomplex.d (n - 1) n)) η).symm.trans (congrArg _ hη)))
  have h2 : ρ (I.cocomplex.X n) (wcEtTop XZ)
      ((W ⋙ wcEtBaseChange h).obj (IsCofiltered.min l l₁)) (π (IsCofiltered.min l l₁))
      (hπ' (IsCofiltered.min l l₁)) c₁ = ε _ γ := by
    rw [hc₁]
    exact (htr _ (IsCofiltered.minToLeft l l₁) c).trans hεγ.symm

  have hδ : ρ (I.cocomplex.X n) (wcEtTop XZ)
      ((W ⋙ wcEtBaseChange h).obj (IsCofiltered.min l l₁)) (π (IsCofiltered.min l l₁))
      (hπ' (IsCofiltered.min l l₁))
      (((I.cocomplex.d (n - 1) n).hom.app
        (Opposite.op ((W ⋙ wcEtBaseChange h).obj (IsCofiltered.min l l₁)))).hom e₁ - c₁) = 0 := by
    rw [map_sub, h1, h2, sub_self]
  obtain ⟨l', t', ht'⟩ := hinj (I.cocomplex.X n) (IsCofiltered.min l l₁) _ hδ
  rw [map_sub, sub_eq_zero] at ht'

  refine ⟨l', t' ≫ IsCofiltered.minToLeft l l₁,
    ((I.cocomplex.X (n - 1)).obj.map ((W ⋙ wcEtBaseChange h).map t').op).hom e₁, ?_⟩
  have hnatd := congrArg (fun k => k.hom e₁)
    ((I.cocomplex.d (n - 1) n).hom.naturality ((W ⋙ wcEtBaseChange h).map t').op)
  simp only [AddCommGrpCat.hom_comp, AddMonoidHom.coe_comp, Function.comp_apply] at hnatd
  have hcomp : ((I.cocomplex.X n).obj.map ((W ⋙ wcEtBaseChange h).map t').op).hom c₁ =
      ((I.cocomplex.X n).obj.map
        ((wcEtBaseChange h).map (W.map (t' ≫ IsCofiltered.minToLeft l l₁))).op).hom c := by
    rw [hc₁, CategoryTheory.Functor.map_comp, CategoryTheory.Functor.map_comp, op_comp,
      CategoryTheory.Functor.map_comp]
    rfl
  exact hnatd.trans (ht'.trans hcomp)

theorem wc_pbc_locKill : ∀ {X Y X' Y' : Scheme.{u}} (f : X ⟶ Y) (b : Y' ⟶ Y) (h : X' ⟶ Y') (a' : X' ⟶ X), IsPullback a' h f b → IsProper f → wcPBCV f → ∀ m : ℕ, m ≠ 0 → ∀ F : Sheaf (Scheme.smallEtaleTopology X') AddCommGrpCat.{u+1}, m • 𝟙 F = 0 → ∀ P : Y' → Prop, wcSuppIn X' {x | ¬ P (h x)} F → ∀ (I : InjectiveResolution F) (n : ℕ), wcEtLocKillN h I.cocomplex n P :=
by
  intro X Y X' Y' f b h a' hsq hfP hf m hm F htor P hF I n V c hc v hv

  obtain ⟨A, _, _, _, Λ, _, _, W, g, φ, ψ, hWaff, hg, hφ, hφψ, hψv, hlim⟩ :=
    wc_et_strict_henselization_prosystem V v

  let a : Spec (.of A) ⟶ Y' := ψ ≫ V.hom
  have ha : ∀ l, φ l ≫ (W.obj l).hom = a := by
    intro l
    rw [← MorphismProperty.Over.w (g l), ← Category.assoc, hφψ l]

  have hpb : IsPullback (Limits.pullback.fst h a) (Limits.pullback.snd h a) h a :=
    IsPullback.of_hasPullback h a
  have hbig : IsPullback (Limits.pullback.fst h a ≫ a') (Limits.pullback.snd h a) f (a ≫ b) :=
    hpb.paste_horiz hsq

  obtain ⟨L, ⟨adj⟩, -, -⟩ := wc_et_push_left_adjoint (Limits.pullback.fst h a)
  haveI : L.Additive := adj.left_adjoint_additive

  have htorA : m • 𝟙 (L.obj F) = 0 := by
    rw [← CategoryTheory.Functor.map_id, ← CategoryTheory.Functor.map_nsmul, htor,
      CategoryTheory.Functor.map_zero]

  have hs3 := wc_et_supp_left_adjoint_pullback (Limits.pullback.fst h a) L ⟨adj⟩
    {x | ¬ P (h x)} F hF
  have hsub : (Limits.pullback.fst h a) ⁻¹' {x | ¬ P (h x)} ⊆
      {z | Limits.pullback.snd h a z ≠ IsLocalRing.closedPoint A} := by
    intro z hz hcl
    apply hz
    have e1 : (Limits.pullback.fst h a ≫ h) z = (Limits.pullback.snd h a ≫ a) z := by
      rw [Limits.pullback.condition]
    rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at e1
    have e2 : a (IsLocalRing.closedPoint A) = V.hom v :=
      (Scheme.Hom.comp_apply ψ V.hom (IsLocalRing.closedPoint A)).trans (congrArg V.hom hψv)
    change P (h (Limits.pullback.fst h a z))
    rw [e1, hcl, e2]
    exact hv
  have hsupp : wcSuppIn (Limits.pullback h a)
      {z | Limits.pullback.snd h a z ≠ IsLocalRing.closedPoint A} (L.obj F) := by
    intro U s
    refine GrothendieckTopology.superset_covering _ ?_ (hs3 U s)
    apply Sieve.generate_mono
    intro U' k hk
    rcases hk with hk | hk
    · exact Or.inl hk
    · exact Or.inr (fun x => hsub (hk x))

  have hvan : ∀ q, Subsingleton (wcEtExt (Limits.pullback h a) (L.obj F) q) := fun q =>
    hf A (a ≫ b) (Limits.pullback h a) (Limits.pullback.snd h a)
      (Limits.pullback.fst h a ≫ a') hbig m hm (L.obj F) hsupp htorA q

  obtain ⟨l₀⟩ := IsCofiltered.nonempty (C := Λ)
  have hnat := (I.cocomplex.d n (n + 1)).hom.naturality ((wcEtBaseChange h).map (g l₀)).op
  have hnat' := congrArg (fun k => k.hom c) hnat
  simp only [AddCommGrpCat.hom_comp, AddMonoidHom.coe_comp, Function.comp_apply] at hnat'
  have hc₀ : ((I.cocomplex.d n (n + 1)).hom.app
      (Opposite.op ((wcEtBaseChange h).obj (W.obj l₀)))).hom
      (((I.cocomplex.X n).obj.map ((wcEtBaseChange h).map (g l₀)).op).hom c) = 0 := by
    rw [hnat', hc, map_zero]

  haveI : IsProper h := MorphismProperty.of_isPullback (P := @IsProper) hsq hfP
  obtain ⟨l', t, e, he⟩ := wc_et_locKill_of_limit_vanishing h A Λ W φ a hWaff hφ ha hlim
    (Limits.pullback h a) (Limits.pullback.fst h a) (Limits.pullback.snd h a) hpb F L ⟨adj⟩
    hvan I n l₀ _ hc₀

  refine ⟨W.obj l', g l', φ l' (IsLocalRing.closedPoint A), e, ?_, ?_⟩
  · exact (Scheme.Hom.comp_apply (φ l') (g l').left (IsLocalRing.closedPoint A)).symm.trans
      ((congrArg (fun k : Spec (.of A) ⟶ V.left => k (IsLocalRing.closedPoint A)) (hφψ l')).trans hψv)
  · rw [he, ← hg t, CategoryTheory.Functor.map_comp, op_comp, CategoryTheory.Functor.map_comp]
    rfl

theorem wc_pbc_comp : ∀ {X Y Z : Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ Z), IsProper f → IsProper g →
    wcPBCV f → wcPBCV g → wcPBCV (f ≫ g) :=
by
  intro X Y Z f g hfP hgP hf hg A _ _ _ a X' f'' a' hsq m hm F hF htor q

  have s5 : ∀ {C : Type _} {D : Type _} [Category C] [Category D] [Abelian C] [Abelian D]
      (R : C ⥤ D) [R.Additive] (A : C) (I : InjectiveResolution A) (m : ℕ), m • 𝟙 A = 0 →
      ∀ q : ℕ, m • 𝟙 (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q)
        = 0 := by
    intro C D _ _ _ _ R _ A I m hA q
    have hι : I.ι ≫ (m • 𝟙 I.cocomplex) = 0 := by
      rw [Preadditive.comp_nsmul, Category.comp_id, ← Category.id_comp I.ι,
        ← Preadditive.nsmul_comp]
      have h0 : m • 𝟙 ((CochainComplex.single₀ C).obj A) = 0 := by
        rw [← (CochainComplex.single₀ C).map_id, ← CategoryTheory.Functor.map_nsmul, hA,
          CategoryTheory.Functor.map_zero]
      rw [h0, Limits.zero_comp]
    let H := I.descHomotopyZero (m • 𝟙 I.cocomplex) hι
    let H' := R.mapHomotopy H
    have e1 := H'.homologyMap_eq q
    rw [CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id,
      CategoryTheory.Functor.map_zero, HomologicalComplex.homologyMap_zero] at e1
    have e2 : HomologicalComplex.homologyMap
        (m • 𝟙 ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex)) q =
        m • 𝟙 _ := by
      have : (HomologicalComplex.homologyFunctor D (ComplexShape.up ℕ) q).map
          (m • 𝟙 ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex)) =
          m • (HomologicalComplex.homologyFunctor D (ComplexShape.up ℕ) q).map
            (𝟙 ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex)) :=
        (HomologicalComplex.homologyFunctor D (ComplexShape.up ℕ) q).map_nsmul
      simp at this
      exact this
    rw [← e2, e1]

  have hY : IsPullback (Limits.pullback.fst g a) (Limits.pullback.snd g a) g a :=
    IsPullback.of_hasPullback g a

  let h : X' ⟶ Limits.pullback g a :=
    Limits.pullback.lift (a' ≫ f) f'' ((Category.assoc _ _ _).trans hsq.w)
  have h1 : h ≫ Limits.pullback.fst g a = a' ≫ f := Limits.pullback.lift_fst _ _ _
  have h2 : h ≫ Limits.pullback.snd g a = f'' := Limits.pullback.lift_snd _ _ _
  have hsq' : IsPullback a' (h ≫ Limits.pullback.snd g a) (f ≫ g) a := by rw [h2]; exact hsq
  have hX : IsPullback a' h f (Limits.pullback.fst g a) := IsPullback.of_bot hsq' h1.symm hY

  let P : ↥(Limits.pullback g a) → Prop :=
    fun y => Limits.pullback.snd g a y = IsLocalRing.closedPoint A
  have hPo : IsOpen {y | ¬ P y} :=
    (IsLocalRing.isClosed_singleton_closedPoint A).isOpen_compl.preimage
      (Limits.pullback.snd g a).continuous
  have hF' : wcSuppIn X' {x | ¬ P (h x)} F := by
    have hset : {x | ¬ P (h x)} = {x : X' | f'' x ≠ IsLocalRing.closedPoint A} := by
      ext x
      simp only [Set.mem_setOf_eq, P, ← h2, Scheme.Hom.comp_apply]
    rw [hset]
    exact hF

  letI : HasExt (Sheaf (Scheme.smallEtaleTopology X') AddCommGrpCat.{u+1}) := HasExt.standard _
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology (Limits.pullback g a)) AddCommGrpCat.{u+1}) :=
    HasExt.standard _
  haveI := wc_et_enough_injectives X'
  let I := injectiveResolution F
  obtain ⟨L, ⟨adj⟩, hL, ⟨eL⟩⟩ := wc_et_push_left_adjoint h
  haveI := hL

  have hKinj : ∀ j, Injective ((((wcEtPush h).mapHomologicalComplex (ComplexShape.up ℕ)).obj
      I.cocomplex).X j) := fun j => adj.map_injective _ (I.injective j)

  have hH : ∀ p n : ℕ, Subsingleton (Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology
      (Limits.pullback g a)) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)))
      ((((wcEtPush h).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology n) p) := by
    intro p n
    have hk := wc_pbc_locKill f (Limits.pullback.fst g a) h a' hX hfP hf m hm F htor P hF' I n
    have hs := wc_et_push_homology_supp_of_locKill h I.cocomplex n P hPo hk
    have ht := s5 (wcEtPush h) F I m htor n
    exact hg A a (Limits.pullback g a) (Limits.pullback.snd g a) (Limits.pullback.fst g a) hY m hm
      _ hs ht p

  have hcoc := wc_inj_complex_cocycle_exact ((constantSheaf (Scheme.smallEtaleTopology
      (Limits.pullback g a)) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)))
    (((wcEtPush h).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex) hKinj hH

  let P0 := (constantSheaf (Scheme.smallEtaleTopology (Limits.pullback g a)) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} ℤ))
  have hcoc' : ∀ (n : ℕ) (c : P0 ⟶ (wcEtPush h).obj (I.cocomplex.X n)),
      c ≫ (wcEtPush h).map (I.cocomplex.d n (n + 1)) = 0 →
      ∃ e : P0 ⟶ (wcEtPush h).obj (I.cocomplex.X (n - 1)),
        e ≫ (wcEtPush h).map (I.cocomplex.d (n - 1) n) = c := fun n c hc => hcoc n c hc
  haveI hsub : Subsingleton (Abelian.Ext (L.obj P0) F q) := by
    constructor
    intro x y
    suffices hz : ∀ z : Abelian.Ext (L.obj P0) F q, z = 0 by rw [hz x, hz y]
    intro z
    cases q with
    | zero =>
      let φ : L.obj P0 ⟶ F := Abelian.Ext.homEquiv₀ z
      have hz : z = Abelian.Ext.mk₀ φ := (Abelian.Ext.mk₀_homEquiv₀_apply z).symm
      let e0 := HomologicalComplex.singleObjXSelf (ComplexShape.up ℕ) 0 F
      let ι' : F ⟶ I.cocomplex.X 0 := e0.inv ≫ I.ι.f 0
      haveI : Mono ι' := mono_comp _ _
      have hι' : ι' ≫ I.cocomplex.d 0 1 = 0 := by
        simp only [ι', Category.assoc, InjectiveResolution.ι_f_zero_comp_complex_d,
          Limits.comp_zero]
      let c := adj.homEquiv _ _ (φ ≫ ι')
      have hc : c ≫ (wcEtPush h).map (I.cocomplex.d 0 (0 + 1)) = 0 := by
        rw [← adj.homEquiv_naturality_right, Category.assoc, hι', Limits.comp_zero,
          Adjunction.homEquiv_unit, CategoryTheory.Functor.map_zero, Limits.comp_zero]
      obtain ⟨e, he⟩ := hcoc' 0 c hc
      have hc0 : c = 0 := by
        rw [← he, I.cocomplex.shape (0 - 1) 0 (by simp), CategoryTheory.Functor.map_zero,
          Limits.comp_zero]
      have hφι : φ ≫ ι' = 0 := by
        have : φ ≫ ι' = (adj.homEquiv _ _).symm c := by
          simp only [c, Equiv.symm_apply_apply]
        rw [this, hc0, Adjunction.homEquiv_counit, CategoryTheory.Functor.map_zero,
          Limits.zero_comp]
      have hφ : φ = 0 := (cancel_mono ι').mp (hφι.trans (Limits.zero_comp).symm)
      rw [hz, hφ, Abelian.Ext.mk₀_zero]
    | succ p =>
      obtain ⟨f0, hf0, rfl⟩ := I.extMk_surjective z (p + 1 + 1) rfl
      have hc : adj.homEquiv _ _ f0 ≫ (wcEtPush h).map (I.cocomplex.d (p + 1) (p + 1 + 1)) = 0 := by
        rw [← adj.homEquiv_naturality_right, hf0, Adjunction.homEquiv_unit,
          CategoryTheory.Functor.map_zero, Limits.comp_zero]
      obtain ⟨e, he⟩ := hcoc' (p + 1) _ hc
      rw [I.extMk_eq_zero_iff f0 (p + 1 + 1) rfl hf0 p rfl]
      refine ⟨(adj.homEquiv _ _).symm e, ?_⟩
      apply (adj.homEquiv _ _).injective
      rw [adj.homEquiv_naturality_right, Equiv.apply_symm_apply]
      exact he

  show Subsingleton (Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology X')
    AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) F q)
  constructor
  intro x y
  have key : ∀ z : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology X')
      AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) F q,
      (Abelian.Ext.mk₀ eL.inv).comp ((Abelian.Ext.mk₀ eL.hom).comp z (zero_add _)) (zero_add _) = z := by
    intro z
    rw [Abelian.Ext.mk₀_comp_mk₀_assoc, Iso.inv_hom_id, Abelian.Ext.mk₀_id_comp]
  rw [← key x, ← key y, Subsingleton.elim ((Abelian.Ext.mk₀ eL.hom).comp x (zero_add _))
    ((Abelian.Ext.mk₀ eL.hom).comp y (zero_add _))]

theorem wc_inj_complex_ext_low : ∀ {C : Type*} [Category C] [Abelian C] (P : C) (K : CochainComplex C ℕ), (∀ j, Injective (K.X j)) → letI := HasExt.standard C; ∀ q : ℕ, (∀ p : ℕ, p < q → ∀ n : ℕ, Subsingleton (Abelian.Ext P (K.homology n) p)) → (∀ c : P ⟶ K.X q, c ≫ K.d q (q + 1) = 0 → ∃ e : P ⟶ K.X (q - 1), e ≫ K.d (q - 1) q = c) → Subsingleton (Abelian.Ext P (K.homology 0) q) :=
by
  intro C _ _ P K hinj
  letI := HasExt.standard C
  intro q hH hcoc

  have s3 : ∀ (S : ShortComplex C), S.ShortExact → Injective S.X₂ → ∀ k : ℕ,
      (∀ y : Abelian.Ext P S.X₃ k, ∃ y₀ : Abelian.Ext P S.X₂ k,
        y₀.comp (Abelian.Ext.mk₀ S.g) (add_zero k) = y) →
      Subsingleton (Abelian.Ext P S.X₁ (k + 1)) := by
    intro S hS hI k hlift
    have hz : ∀ x : Abelian.Ext P S.X₁ (k + 1), x = 0 := by
      intro x
      have h0 : x.comp (Abelian.Ext.mk₀ S.f) (add_zero (k + 1)) = 0 :=
        Abelian.Ext.eq_zero_of_injective _
      obtain ⟨x₃, hx₃⟩ := Abelian.Ext.covariant_sequence_exact₁ P hS x h0 rfl
      obtain ⟨y₀, hy₀⟩ := hlift x₃
      rw [← hx₃, ← hy₀, Abelian.Ext.comp_assoc _ _ _ (add_zero k) (zero_add 1) (by omega),
        hS.comp_extClass, Abelian.Ext.comp_zero]
    exact ⟨fun x y => by rw [hz x, hz y]⟩

  have s4 : ∀ (S : ShortComplex C), S.ShortExact → ∀ k : ℕ,
      Subsingleton (Abelian.Ext P S.X₃ k) → Subsingleton (Abelian.Ext P S.X₂ (k + 1)) →
      Subsingleton (Abelian.Ext P S.X₁ (k + 1)) := by
    intro S hS k h3 h2
    have hz : ∀ x : Abelian.Ext P S.X₁ (k + 1), x = 0 := by
      intro x
      obtain ⟨x₃, hx₃⟩ := Abelian.Ext.covariant_sequence_exact₁ P hS x (Subsingleton.elim _ _) rfl
      rw [← hx₃, Subsingleton.elim x₃ 0, Abelian.Ext.zero_comp]
    exact ⟨fun x y => by rw [hz x, hz y]⟩

  have s2 : ∀ j : ℕ, ∃ (κ : Limits.cokernel (K.iCycles j) ⟶ K.cycles (j + 1))
      (hκ : κ ≫ K.homologyπ (j + 1) = 0),
      Limits.cokernel.π (K.iCycles j) ≫ κ = K.toCycles j (j + 1) ∧
        (ShortComplex.mk κ (K.homologyπ (j + 1)) hκ).ShortExact := by
    intro j
    have w : K.iCycles j ≫ K.toCycles j (j + 1) = 0 := by
      rw [← cancel_mono (K.iCycles (j + 1)), Category.assoc, K.toCycles_i, K.iCycles_d,
        Limits.zero_comp]
    obtain ⟨κ, hπκ⟩ : ∃ κ : Limits.cokernel (K.iCycles j) ⟶ K.cycles (j + 1),
        Limits.cokernel.π (K.iCycles j) ≫ κ = K.toCycles j (j + 1) :=
      ⟨_, Limits.cokernel.π_desc _ _ w⟩
    have hκ : κ ≫ K.homologyπ (j + 1) = 0 := by
      rw [← cancel_epi (Limits.cokernel.π (K.iCycles j)), ← Category.assoc, hπκ,
        K.toCycles_comp_homologyπ, Limits.comp_zero]
    have hmono : Mono κ := by
      have hS' : (ShortComplex.mk (K.iCycles j) (K.d j (j + 1)) (K.iCycles_d j (j + 1))).Exact :=
        ShortComplex.exact_of_f_is_kernel _ (K.cyclesIsKernel j (j + 1) (CochainComplex.next ℕ j))
      have heq : Limits.cokernel.desc (K.iCycles j) (K.d j (j + 1)) (K.iCycles_d j (j + 1)) =
          κ ≫ K.iCycles (j + 1) := by
        rw [← cancel_epi (Limits.cokernel.π (K.iCycles j)), Limits.cokernel.π_desc,
          ← Category.assoc, hπκ, K.toCycles_i]
      haveI : Mono (κ ≫ K.iCycles (j + 1)) := by
        rw [← heq]
        exact hS'.mono_cokernelDesc
      exact mono_of_mono κ (K.iCycles (j + 1))
    refine ⟨κ, hκ, hπκ, ?_⟩
    have hS₁ : (ShortComplex.mk (K.toCycles j (j + 1)) (K.homologyπ (j + 1))
        (K.toCycles_comp_homologyπ j (j + 1))).Exact :=
      ShortComplex.exact_of_g_is_cokernel _
        (K.homologyIsCokernel j (j + 1) (CochainComplex.prev_nat_succ j))
    let φ : ShortComplex.mk (K.toCycles j (j + 1)) (K.homologyπ (j + 1))
        (K.toCycles_comp_homologyπ j (j + 1)) ⟶ ShortComplex.mk κ (K.homologyπ (j + 1)) hκ :=
      { τ₁ := Limits.cokernel.π (K.iCycles j)
        τ₂ := 𝟙 _
        τ₃ := 𝟙 _
        comm₁₂ := by
          show Limits.cokernel.π (K.iCycles j) ≫ κ = K.toCycles j (j + 1) ≫ 𝟙 _
          rw [hπκ, Category.comp_id]
        comm₂₃ := by
          show 𝟙 _ ≫ K.homologyπ (j + 1) = K.homologyπ (j + 1) ≫ 𝟙 _
          rw [Category.id_comp, Category.comp_id] }
    haveI : Epi φ.τ₁ := by
      show Epi (Limits.cokernel.π (K.iCycles j))
      infer_instance
    haveI : IsIso φ.τ₂ := by
      show IsIso (𝟙 _)
      infer_instance
    haveI : Mono φ.τ₃ := by
      show Mono (𝟙 _)
      infer_instance
    have hS₂ := (ShortComplex.exact_iff_of_epi_of_isIso_of_mono φ).mp hS₁
    exact ShortComplex.ShortExact.mk' hS₂ hmono inferInstance

  have s5 : ∀ (j : ℕ) (κ : Limits.cokernel (K.iCycles j) ⟶ K.cycles (j + 1)), Mono κ →
      Limits.cokernel.π (K.iCycles j) ≫ κ = K.toCycles j (j + 1) →
      (∀ c : P ⟶ K.X (j + 1), c ≫ K.d (j + 1) (j + 1 + 1) = 0 →
        ∃ e : P ⟶ K.X j, e ≫ K.d j (j + 1) = c) →
      ∀ g : P ⟶ Limits.cokernel (K.iCycles j),
        ∃ e : P ⟶ K.X j, e ≫ Limits.cokernel.π (K.iCycles j) = g := by
    intro j κ hκ hπκ hc g
    obtain ⟨e, he⟩ := hc (g ≫ κ ≫ K.iCycles (j + 1))
      (by rw [Category.assoc, Category.assoc, K.iCycles_d, Limits.comp_zero, Limits.comp_zero])
    refine ⟨e, ?_⟩
    rw [← cancel_mono (κ ≫ K.iCycles (j + 1)), Category.assoc, reassoc_of% hπκ, K.toCycles_i, he]

  suffices hZ : Subsingleton (Abelian.Ext P (K.cycles 0) q) by
    have hz : ∀ x : Abelian.Ext P (K.homology 0) q, x = 0 := by
      intro x
      have hx : x = (x.comp (Abelian.Ext.mk₀ (CochainComplex.isoHomologyπ₀ K).inv) (add_zero q)).comp
          (Abelian.Ext.mk₀ (CochainComplex.isoHomologyπ₀ K).hom) (add_zero q) := by
        rw [Abelian.Ext.comp_assoc _ _ _ (add_zero q) (add_zero 0) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.comp_mk₀_id]
      rw [hx, Subsingleton.elim (x.comp (Abelian.Ext.mk₀ (CochainComplex.isoHomologyπ₀ K).inv)
        (add_zero q)) 0, Abelian.Ext.zero_comp]
    exact ⟨fun x y => by rw [hz x, hz y]⟩
  cases q with
  | zero =>
    have hz : ∀ x : Abelian.Ext P (K.cycles 0) 0, x = 0 := by
      intro x
      obtain ⟨f, rfl⟩ : ∃ f, Abelian.Ext.mk₀ f = x := ⟨_, Abelian.Ext.mk₀_homEquiv₀_apply x⟩
      obtain ⟨e, he⟩ := hcoc (f ≫ K.iCycles 0)
        (by rw [Category.assoc, K.iCycles_d, Limits.comp_zero])
      have hd : K.d (0 - 1) 0 = 0 := K.shape _ _ (by simp)
      have hf : f ≫ K.iCycles 0 = 0 := by rw [← he, hd, Limits.comp_zero]
      have hf0 : f = 0 := by rw [← cancel_mono (K.iCycles 0), hf, Limits.zero_comp]
      rw [hf0, Abelian.Ext.mk₀_zero]
    exact ⟨fun x y => by rw [hz x, hz y]⟩
  | succ q₀ =>
    have hcoc' : ∀ c : P ⟶ K.X (q₀ + 1), c ≫ K.d (q₀ + 1) (q₀ + 1 + 1) = 0 →
        ∃ e : P ⟶ K.X q₀, e ≫ K.d q₀ (q₀ + 1) = c := hcoc
    have main : ∀ k j : ℕ, j + k = q₀ → Subsingleton (Abelian.Ext P (K.cycles j) (k + 1)) := by
      intro k
      induction k with
      | zero =>
        intro j hj
        have hj' : j = q₀ := by omega
        subst hj'
        obtain ⟨κ, hκ, hπκ, hB⟩ := s2 j
        refine s3 (ShortComplex.mk (K.iCycles j) (Limits.cokernel.π (K.iCycles j))
          (Limits.cokernel.condition _))
          (ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel _) inferInstance inferInstance)
          (hinj j) 0 ?_
        intro y
        obtain ⟨e, he⟩ := s5 j κ hB.mono_f hπκ hcoc' (Abelian.Ext.homEquiv₀ y)
        refine ⟨Abelian.Ext.mk₀ e, ?_⟩
        show (Abelian.Ext.mk₀ e).comp (Abelian.Ext.mk₀ (Limits.cokernel.π (K.iCycles j)))
          (add_zero 0) = y
        rw [Abelian.Ext.mk₀_comp_mk₀, he, Abelian.Ext.mk₀_homEquiv₀_apply]
      | succ k ih =>
        intro j hj
        obtain ⟨κ, hκ, hπκ, hB⟩ := s2 j
        have h1 : Subsingleton (Abelian.Ext P (K.cycles (j + 1)) (k + 1)) := ih (j + 1) (by omega)
        have h2 : Subsingleton (Abelian.Ext P (K.homology (j + 1)) k) := hH k (by omega) (j + 1)
        have h3 : Subsingleton (Abelian.Ext P (Limits.cokernel (K.iCycles j)) (k + 1)) :=
          s4 _ hB k h2 h1
        refine s3 (ShortComplex.mk (K.iCycles j) (Limits.cokernel.π (K.iCycles j))
          (Limits.cokernel.condition _))
          (ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel _) inferInstance inferInstance)
          (hinj j) (k + 1) ?_
        intro y
        refine ⟨0, ?_⟩
        rw [Abelian.Ext.zero_comp]
        exact @Subsingleton.elim _ h3 _ _
    exact main q₀ 0 (by omega)

theorem wc_et_push_unit_mono : ∀ {X B : Scheme.{u}} (h : X ⟶ B), Surjective h → ∀ (L : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1} ⥤ Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) (adj : L ⊣ wcEtPush h) (G : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}), Mono (adj.unit.app G) :=
by
  intro X B h hS L adj G

  have s1 : ∀ (F : (B.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) (U : X.Etale) (V₁ : B.Etale)
      (a : U ⟶ (wcEtBaseChange h).obj V₁) (t : F.obj (Opposite.op V₁)),
      ((wcEtBaseChange h).op.lan.obj F).map a.op
        (((wcEtBaseChange h).op.lanUnit.app F).app (Opposite.op V₁) t) = 0 →
      ∃ (V₂ : B.Etale) (c : V₂ ⟶ V₁) (a' : U ⟶ (wcEtBaseChange h).obj V₂),
        a' ≫ (wcEtBaseChange h).map c = a ∧ F.map c.op t = 0 := by
    intro F U V₁ a t ht
    haveI : Limits.PreservesFiniteLimits (wcEtBaseChange h) := ⟨fun J _ _ =>
      haveI : Limits.PreservesLimitsOfShape J (wcEtBaseChange h ⋙ Scheme.Etale.forget X) :=
        Limits.preservesLimitsOfShape_of_natIso
          (NatIso.ofComponents (fun _ => Iso.refl _) (fun _ => rfl) :
            Scheme.Etale.forget B ⋙ Over.pullback h ≅ wcEtBaseChange h ⋙ Scheme.Etale.forget X)
      Limits.preservesLimitsOfShape_of_reflects_of_preserves (wcEtBaseChange h)
        (Scheme.Etale.forget X)⟩
    haveI : RepresentablyFlat (wcEtBaseChange h) := flat_of_preservesFiniteLimits _
    haveI : IsCofiltered (StructuredArrow U (wcEtBaseChange h)) := RepresentablyFlat.cofiltered U
    haveI hI : IsFiltered (CostructuredArrow (wcEtBaseChange h).op (Opposite.op U)) :=
      IsFiltered.of_equivalence (structuredArrowOpEquivalence (wcEtBaseChange h) U)
    haveI : IsFiltered (ULiftHom.{u+1} (CostructuredArrow (wcEtBaseChange h).op (Opposite.op U))) :=
      IsFiltered.of_equivalence ULiftHom.equiv
    haveI := Limits.preservesColimitsOfShape_of_equiv
      (ULiftHom.equiv (C := CostructuredArrow (wcEtBaseChange h).op (Opposite.op U))).symm
      (forget AddCommGrpCat.{u+1})
    let E := Functor.LeftExtension.mk ((wcEtBaseChange h).op.leftKanExtension F)
      ((wcEtBaseChange h).op.leftKanExtensionUnit F)
    have hc : Limits.IsColimit (E.coconeAt (Opposite.op U)) :=
      (wcEtBaseChange h).op.isPointwiseLeftKanExtensionLeftKanExtensionUnit F (Opposite.op U)
    have hleg : (E.coconeAt (Opposite.op U)).ι.app (CostructuredArrow.mk (Y := Opposite.op V₁) a.op) t =
        ((wcEtBaseChange h).op.lan.obj F).map a.op
          (((wcEtBaseChange h).op.lanUnit.app F).app (Opposite.op V₁) t) := rfl
    let j : CostructuredArrow (wcEtBaseChange h).op (Opposite.op U) :=
      CostructuredArrow.mk (Y := Opposite.op V₁) a.op
    let t' : ToType ((CostructuredArrow.proj (wcEtBaseChange h).op (Opposite.op U) ⋙ F).obj j) := t
    have h0 : (E.coconeAt (Opposite.op U)).ι.app j t' = (E.coconeAt (Opposite.op U)).ι.app j 0 := by
      rw [map_zero]
      exact hleg.trans ht
    obtain ⟨k, f, g', hfg⟩ := Limits.Concrete.isColimit_exists_of_rep_eq _ hc t' 0 h0
    have hw : (wcEtBaseChange h).op.map f.left ≫ k.hom = a.op := CostructuredArrow.w f
    refine ⟨k.left.unop, f.left.unop, k.hom.unop, ?_, ?_⟩
    · apply Quiver.Hom.op_inj
      rw [op_comp]
      exact hw
    · have : F.map f.left t = 0 := by
        refine hfg.trans ?_
        exact map_zero _
      exact this

  have s2 : ∀ (V : B.Etale) (S : Sieve V),
      Sieve.functorPushforward (wcEtBaseChange h) S ∈
        Scheme.smallEtaleTopology X ((wcEtBaseChange h).obj V) →
      S ∈ Scheme.smallEtaleTopology B V := by
    intro V S hS'
    change _ ∈ Scheme.smallGrothendieckTopology @Etale X _ at hS'
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale X
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hS'
    have H := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale X
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mp hS'
    change S ∈ Scheme.smallGrothendieckTopology @Etale B V
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale B
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
    apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale B
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
    intro v
    obtain ⟨x, hx⟩ := hS.surj (V.hom v)
    obtain ⟨y, hy1, -⟩ := Scheme.Pullback.exists_preimage_pullback v x hx.symm
    obtain ⟨Y, f, y', hf, -, hfy⟩ := H y
    rw [Sieve.functorPushforward_apply] at hf
    obtain ⟨Z, g, k, hg, hfk⟩ := hf
    have hw : g.left ≫ V.hom = Z.hom := MorphismProperty.Over.w g
    have hEt : Etale g.left := by
      have h1 : Etale V.hom := V.prop
      have h2 : Etale (g.left ≫ V.hom) := by rw [hw]; exact Z.prop
      exact Etale.of_comp g.left V.hom
    refine ⟨Z, g, Limits.pullback.fst Z.hom h (k.left y'), hg, hEt, ?_⟩
    have h0 : (Limits.pullback.fst Z.hom h ≫ g.left) ≫ V.hom =
        Limits.pullback.snd Z.hom h ≫ h := by
      rw [Category.assoc, MorphismProperty.Over.w g]
      exact Limits.pullback.condition
    have hm : ((wcEtBaseChange h).map g).left =
        Limits.pullback.lift (Limits.pullback.fst Z.hom h ≫ g.left)
          (Limits.pullback.snd Z.hom h) h0 := rfl
    have hmap : ((wcEtBaseChange h).map g).left ≫ Limits.pullback.fst V.hom h =
        Limits.pullback.fst Z.hom h ≫ g.left := by
      rw [hm]
      exact Limits.pullback.lift_fst _ _ _
    have e1 : f.left = k.left ≫ ((wcEtBaseChange h).map g).left := by
      rw [hfk]
      rfl
    calc g.left (Limits.pullback.fst Z.hom h (k.left y'))
        = (Limits.pullback.fst Z.hom h ≫ g.left) (k.left y') :=
          (Scheme.Hom.comp_apply _ _ _).symm
      _ = (((wcEtBaseChange h).map g).left ≫ Limits.pullback.fst V.hom h) (k.left y') := by
          rw [hmap]; rfl
      _ = Limits.pullback.fst V.hom h (((wcEtBaseChange h).map g).left (k.left y')) :=
          Scheme.Hom.comp_apply _ _ _
      _ = Limits.pullback.fst V.hom h ((k.left ≫ ((wcEtBaseChange h).map g).left) y') := by
          rw [Scheme.Hom.comp_apply]
      _ = Limits.pullback.fst V.hom h (f.left y') := by rw [e1]
      _ = v := by rw [hfy, hy1]

  have s3 : ∀ (V : B.Etale) (g : G.obj.obj (Opposite.op V)),
      (toSheafify (Scheme.smallEtaleTopology B) ((wcEtBaseChange h).op ⋙
        ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
          ((wcEtBaseChange h).op.lan.obj G.obj)).obj)).app (Opposite.op V)
        ((toSheafify (Scheme.smallEtaleTopology X) ((wcEtBaseChange h).op.lan.obj G.obj)).app
          (Opposite.op ((wcEtBaseChange h).obj V))
          (((wcEtBaseChange h).op.lanUnit.app G.obj).app (Opposite.op V) g)) = 0 → g = 0 := by
    intro V g hyp
    haveI := Presheaf.isLocallyInjective_toSheafify' (Scheme.smallEtaleTopology B)
      ((wcEtBaseChange h).op ⋙ ((presheafToSheaf (Scheme.smallEtaleTopology X)
        AddCommGrpCat.{u+1}).obj ((wcEtBaseChange h).op.lan.obj G.obj)).obj)
    haveI := Presheaf.isLocallyInjective_toSheafify' (Scheme.smallEtaleTopology X)
      ((wcEtBaseChange h).op.lan.obj G.obj)
    have hS₁ := Presheaf.equalizerSieve_mem (Scheme.smallEtaleTopology B)
      (toSheafify (Scheme.smallEtaleTopology B) ((wcEtBaseChange h).op ⋙
        ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
          ((wcEtBaseChange h).op.lan.obj G.obj)).obj)) (X := Opposite.op V)
      ((toSheafify (Scheme.smallEtaleTopology X) ((wcEtBaseChange h).op.lan.obj G.obj)).app
          (Opposite.op ((wcEtBaseChange h).obj V))
          (((wcEtBaseChange h).op.lanUnit.app G.obj).app (Opposite.op V) g)) 0
      (hyp.trans (map_zero _).symm)
    have hT : Presheaf.equalizerSieve (F := G.obj) (X := Opposite.op V) g 0 ∈
        Scheme.smallEtaleTopology B V := by
      refine GrothendieckTopology.transitive _ hS₁ _ ?_
      intro W d hd
      rw [Presheaf.equalizerSieve_apply, map_zero] at hd
      apply s2
      have hW : (toSheafify (Scheme.smallEtaleTopology X) ((wcEtBaseChange h).op.lan.obj G.obj)).app
          (Opposite.op ((wcEtBaseChange h).obj W))
          (((wcEtBaseChange h).op.lanUnit.app G.obj).app (Opposite.op W) (G.obj.map d.op g)) = 0 := by
        refine Eq.trans ?_ hd
        have n1 : ((wcEtBaseChange h).op.lanUnit.app G.obj).app (Opposite.op W) (G.obj.map d.op g) =
            ((wcEtBaseChange h).op.lan.obj G.obj).map ((wcEtBaseChange h).op.map d.op)
              (((wcEtBaseChange h).op.lanUnit.app G.obj).app (Opposite.op V) g) :=
          NatTrans.naturality_apply ((wcEtBaseChange h).op.lanUnit.app G.obj) d.op g
        have n2 := NatTrans.naturality_apply
          (toSheafify (Scheme.smallEtaleTopology X) ((wcEtBaseChange h).op.lan.obj G.obj))
          ((wcEtBaseChange h).op.map d.op)
          (((wcEtBaseChange h).op.lanUnit.app G.obj).app (Opposite.op V) g)
        rw [n1]
        exact n2
      have hS₂ := Presheaf.equalizerSieve_mem (Scheme.smallEtaleTopology X)
        (toSheafify (Scheme.smallEtaleTopology X) ((wcEtBaseChange h).op.lan.obj G.obj))
        (X := Opposite.op ((wcEtBaseChange h).obj W))
        (((wcEtBaseChange h).op.lanUnit.app G.obj).app (Opposite.op W) (G.obj.map d.op g)) 0
        (hW.trans (map_zero _).symm)
      refine GrothendieckTopology.superset_covering _ ?_ hS₂
      intro U e he
      rw [Presheaf.equalizerSieve_apply, map_zero] at he
      obtain ⟨V₂, c, a', hca, hc0⟩ := s1 G.obj U W e (G.obj.map d.op g) he
      rw [Sieve.functorPushforward_apply]
      show ∃ (Z : B.Etale) (g₁ : Z ⟶ W) (k : U ⟶ (wcEtBaseChange h).obj Z),
        (Sieve.pullback d (Presheaf.equalizerSieve (F := G.obj) (X := Opposite.op V) g 0)).arrows g₁ ∧
          e = k ≫ (wcEtBaseChange h).map g₁
      refine ⟨V₂, c, a', ?_, hca.symm⟩
      show G.obj.map (c ≫ d).op g = G.obj.map (c ≫ d).op 0
      rw [map_zero, op_comp, Functor.map_comp, ConcreteCategory.comp_apply]
      exact hc0
    exact Sheaf.isSeparated G V _ hT g 0 (fun Y k hk => hk)

  let L₀G := (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
    ((wcEtBaseChange h).op.lan.obj G.obj)
  let ψ : G ⟶ (wcEtPush h).obj L₀G := ObjectProperty.homMk
    (((wcEtBaseChange h).op.lanUnit.app G.obj) ≫
      Functor.whiskerLeft (wcEtBaseChange h).op
        (toSheafify (Scheme.smallEtaleTopology X) ((wcEtBaseChange h).op.lan.obj G.obj)) ≫
      toSheafify (Scheme.smallEtaleTopology B) ((wcEtBaseChange h).op ⋙ L₀G.obj))
  haveI hψ : Mono ψ := by
    apply Preadditive.mono_of_cancel_zero
    intro P k hk
    apply Sheaf.hom_ext
    ext V x
    have h1 : (k ≫ ψ).hom.app V = (0 : P ⟶ (wcEtPush h).obj L₀G).hom.app V := by rw [hk]
    have h2 := ConcreteCategory.congr_hom h1 x
    exact (s3 V.unop (k.hom.app V x) h2).trans rfl
  have hfac : adj.unit.app G ≫ (wcEtPush h).map ((adj.homEquiv G L₀G).symm ψ) = ψ := by
    have e := adj.homEquiv_unit (f := (adj.homEquiv G L₀G).symm ψ)
    rw [Equiv.apply_symm_apply] at e
    exact e.symm
  haveI : Mono (adj.unit.app G ≫ (wcEtPush h).map ((adj.homEquiv G L₀G).symm ψ)) := by
    rw [hfac]; exact hψ
  exact mono_of_mono (adj.unit.app G) ((wcEtPush h).map ((adj.homEquiv G L₀G).symm ψ))

theorem wc_et_pull_suppIn : ∀ {X B : Scheme.{u}} (h : X ⟶ B) (L : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1} ⥤ Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}), (L ⊣ wcEtPush h) → ∀ (W : Set B) (G : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}), wcSuppIn B W G → wcSuppIn X (h ⁻¹' W) (L.obj G) :=
by

  have s1 : ∀ (Y : Scheme.{u}) (W : Set Y) (P : (Scheme.Etale Y)ᵒᵖ ⥤ AddCommGrpCat.{u+1}),
      (∀ (U : Y.Etale), (∀ x, U.hom x ∈ W) → ∀ p : P.obj (Opposite.op U), p = 0) →
      ∀ (U : Y.Etale), (∀ x, U.hom x ∈ W) →
      ∀ t : (sheafify (Scheme.smallEtaleTopology Y) P).obj (Opposite.op U), t = 0 := by
    intro Y W P hP U hU t
    haveI := Presheaf.isLocallySurjective_toSheafify' (Scheme.smallEtaleTopology Y) P
    have hI := Presheaf.imageSieve_mem (Scheme.smallEtaleTopology Y)
      (toSheafify (Scheme.smallEtaleTopology Y) P) t
    have hsep := Sheaf.isSeparated
      ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj P)
    refine hsep U _ hI t 0 ?_
    intro U' h hh
    obtain ⟨p, hp⟩ := hh
    have hU' : ∀ x, U'.hom x ∈ W := by
      intro x
      rw [← MorphismProperty.Over.w h, Scheme.Hom.comp_apply]
      exact hU _
    rw [hP U' hU' p, map_zero] at hp
    rw [map_zero]
    exact hp.symm

  have s2 : ∀ (Y : Scheme.{u}) (W : Set Y) (F H : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}),
      wcSuppIn Y W F →
      (∀ (U : Y.Etale), (∀ x, U.hom x ∈ W) → ∀ t : H.obj.obj (Opposite.op U), t = 0) →
      ∀ φ : F ⟶ H, φ = 0 := by
    intro Y W F H hF hH φ
    have key : ∀ (V : Y.Etale) (s : F.obj.obj (Opposite.op V)),
        φ.hom.app (Opposite.op V) s = 0 := by
      intro V s
      refine Sheaf.isSeparated H V _ (hF V s) _ 0 ?_
      intro V'' f hf
      obtain ⟨V', a, b, hb, rfl⟩ := hf
      have hnat : H.obj.map b.op (φ.hom.app (Opposite.op V) s) =
          φ.hom.app (Opposite.op V') (F.obj.map b.op s) :=
        (NatTrans.naturality_apply φ.hom b.op s).symm
      rw [map_zero, op_comp, Functor.map_comp, ConcreteCategory.comp_apply]
      rcases hb with h0 | hW
      · rw [hnat, h0, map_zero, map_zero]
      · rw [hH V' hW (H.obj.map b.op (φ.hom.app (Opposite.op V) s)), map_zero]
    apply Sheaf.hom_ext
    ext V s
    exact (key V.unop s).trans rfl

  have s3 : ∀ (Y : Scheme.{u}) (W : Set Y) (G : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}),
      (∀ (P : (Scheme.Etale Y)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) (π : G.obj ⟶ P),
        (∀ (U : Y.Etale), (∀ x, U.hom x ∈ W) → ∀ p : P.obj (Opposite.op U), p = 0) →
        π ≫ toSheafify (Scheme.smallEtaleTopology Y) P = 0) → wcSuppIn Y W G := by
    intro Y W G hG
    have hM : ∀ {U U' : Y.Etale} (h : U' ⟶ U), (∀ x, U.hom x ∈ W) → ∀ x, U'.hom x ∈ W := by
      intro U U' h hU x
      rw [← MorphismProperty.Over.w h, Scheme.Hom.comp_apply]
      exact hU _
    let K : ∀ U : Y.Etale, AddSubgroup (G.obj.obj (Opposite.op U)) :=
      fun U => ⨆ (_ : ∀ x, U.hom x ∈ W), ⊤
    have hK : ∀ (U : Y.Etale) (y : G.obj.obj (Opposite.op U)),
        y ∈ K U ↔ ((∀ x, U.hom x ∈ W) ∨ y = 0) := by
      intro U y
      by_cases hU : ∀ x, U.hom x ∈ W
      · simp only [K, iSup_pos hU]
        simp [hU]
      · simp only [K, iSup_neg hU]
        rw [AddSubgroup.mem_bot]
        exact ⟨Or.inr, fun h => h.resolve_left hU⟩
    have hle : ∀ {U U' : Y.Etale} (h : U' ⟶ U),
        K U ≤ (K U').comap (G.obj.map h.op).hom := by
      intro U U' h y hy
      rw [AddSubgroup.mem_comap, hK]
      rcases (hK U y).mp hy with hU | hy0
      · exact Or.inl (hM h hU)
      · right
        rw [hy0, map_zero]
    let Q : (Scheme.Etale Y)ᵒᵖ ⥤ AddCommGrpCat.{u+1} :=
      { obj := fun U => AddCommGrpCat.of (G.obj.obj U ⧸ K U.unop)
        map := fun {U U'} h => AddCommGrpCat.ofHom
          (QuotientAddGroup.map (K U.unop) (K U'.unop) (G.obj.map h).hom (hle h.unop))
        map_id := fun U => by
          apply AddCommGrpCat.hom_ext
          refine QuotientAddGroup.addMonoidHom_ext _ ?_
          ext y
          simp
        map_comp := fun f g => by
          apply AddCommGrpCat.hom_ext
          refine QuotientAddGroup.addMonoidHom_ext _ ?_
          ext y
          simp }
    let π : G.obj ⟶ Q :=
      { app := fun U => AddCommGrpCat.ofHom (QuotientAddGroup.mk' (K U.unop))
        naturality := fun U U' h => by
          apply AddCommGrpCat.hom_ext
          ext y
          rfl }
    have hQ : ∀ (U : Y.Etale), (∀ x, U.hom x ∈ W) → ∀ p : Q.obj (Opposite.op U), p = 0 := by
      intro U hU p
      obtain ⟨y, rfl⟩ : ∃ y : G.obj.obj (Opposite.op U),
          (QuotientAddGroup.mk y : G.obj.obj (Opposite.op U) ⧸ K U) = p :=
        QuotientAddGroup.mk_surjective p
      exact (QuotientAddGroup.eq_zero_iff y).mpr ((hK U y).mpr (Or.inl hU))
    intro V s
    have h0 := hG Q π hQ
    have h1 : (toSheafify (Scheme.smallEtaleTopology Y) Q).app (Opposite.op V)
        (QuotientAddGroup.mk s : G.obj.obj (Opposite.op V) ⧸ K V) =
        (toSheafify (Scheme.smallEtaleTopology Y) Q).app (Opposite.op V) 0 := by
      rw [map_zero]
      have h2 : (π ≫ toSheafify (Scheme.smallEtaleTopology Y) Q).app (Opposite.op V) = 0 := by
        rw [h0]; rfl
      exact (ConcreteCategory.congr_hom h2 s).trans rfl
    haveI := Presheaf.isLocallyInjective_toSheafify' (Scheme.smallEtaleTopology Y) Q
    have hE := Presheaf.equalizerSieve_mem (Scheme.smallEtaleTopology Y)
      (toSheafify (Scheme.smallEtaleTopology Y) Q) _ _ h1
    refine GrothendieckTopology.superset_covering _ ?_ hE
    intro V' f hf
    apply Sieve.le_generate
    rw [Presheaf.equalizerSieve_apply, map_zero] at hf
    have hf' : (QuotientAddGroup.mk (G.obj.map f.op s) :
        G.obj.obj (Opposite.op V') ⧸ K V') = 0 := hf
    rcases (hK V' _).mp ((QuotientAddGroup.eq_zero_iff _).mp hf') with hW | hz
    · exact Or.inr hW
    · exact Or.inl hz

  intro X B g L adj S F hF
  apply s3 X (g ⁻¹' S) (L.obj F)
  intro P π hP
  let H := (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj P
  let q : L.obj F ⟶ H := ObjectProperty.homMk (π ≫ toSheafify (Scheme.smallEtaleTopology X) P)
  have hH : ∀ (U : X.Etale), (∀ x, U.hom x ∈ g ⁻¹' S) → ∀ t : H.obj.obj (Opposite.op U), t = 0 :=
    fun U hU t => s1 X (g ⁻¹' S) P hP U hU t
  have hpush : ∀ (V : B.Etale), (∀ x, V.hom x ∈ S) →
      ∀ t : ((wcEtPush g).obj H).obj.obj (Opposite.op V), t = 0 := by
    intro V hV t
    refine s1 B S ((wcEtBaseChange g).op ⋙ H.obj) ?_ V hV t
    intro V' hV' p
    refine hH ((wcEtBaseChange g).obj V') ?_ p
    show ∀ z : ↥(Limits.pullback V'.hom g), g (Limits.pullback.snd V'.hom g z) ∈ S
    intro z
    have e1 : (Limits.pullback.fst V'.hom g ≫ V'.hom) z = (Limits.pullback.snd V'.hom g ≫ g) z := by
      rw [Limits.pullback.condition]
    rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at e1
    rw [← e1]
    exact hV' _
  have hq' : adj.homEquiv F H q = 0 := s2 B S F ((wcEtPush g).obj H) hF hpush _
  have hq : q = 0 := by
    apply (adj.homEquiv F H).injective
    rw [hq', Adjunction.homEquiv_unit, Functor.map_zero, Limits.comp_zero]
  show q.hom = 0
  rw [hq]
  rfl

theorem wc_pbc_cancel : ∀ {X Y Z : Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ Z), IsProper f → IsProper g →
    Surjective f → wcPBCV f → wcPBCV (f ≫ g) → wcPBCV g :=
by
  intro X Y Z f g hfP hgP hfS hf hfg A _ _ _ a Y' g' b hsq m hm

  have s5 : ∀ {C : Type _} {D : Type _} [Category C] [Category D] [Abelian C] [Abelian D]
      (R : C ⥤ D) [R.Additive] (A : C) (I : InjectiveResolution A) (m : ℕ), m • 𝟙 A = 0 →
      ∀ q : ℕ, m • 𝟙 (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q)
        = 0 := by
    intro C D _ _ _ _ R _ A I m hA q
    have hι : I.ι ≫ (m • 𝟙 I.cocomplex) = 0 := by
      rw [Preadditive.comp_nsmul, Category.comp_id, ← Category.id_comp I.ι,
        ← Preadditive.nsmul_comp]
      have h0 : m • 𝟙 ((CochainComplex.single₀ C).obj A) = 0 := by
        rw [← (CochainComplex.single₀ C).map_id, ← CategoryTheory.Functor.map_nsmul, hA,
          CategoryTheory.Functor.map_zero]
      rw [h0, Limits.zero_comp]
    let H := I.descHomotopyZero (m • 𝟙 I.cocomplex) hι
    let H' := R.mapHomotopy H
    have e1 := H'.homologyMap_eq q
    rw [CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id,
      CategoryTheory.Functor.map_zero, HomologicalComplex.homologyMap_zero] at e1
    have e2 : HomologicalComplex.homologyMap
        (m • 𝟙 ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex)) q =
        m • 𝟙 _ := by
      have : (HomologicalComplex.homologyFunctor D (ComplexShape.up ℕ) q).map
          (m • 𝟙 ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex)) =
          m • (HomologicalComplex.homologyFunctor D (ComplexShape.up ℕ) q).map
            (𝟙 ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex)) :=
        (HomologicalComplex.homologyFunctor D (ComplexShape.up ℕ) q).map_nsmul
      simp at this
      exact this
    rw [← e2, e1]

  obtain ⟨X', a', h, hX⟩ : ∃ (X' : Scheme.{u}) (a' : X' ⟶ X) (h : X' ⟶ Y'),
      IsPullback a' h f b := ⟨_, _, _, IsPullback.of_hasPullback f b⟩
  have hpaste : IsPullback a' (h ≫ g') (f ≫ g) a := IsPullback.paste_vert hX hsq
  have hhS : Surjective h := MorphismProperty.of_isPullback (P := @Surjective) hX hfS

  let P : ↥Y' → Prop := fun y => g' y = IsLocalRing.closedPoint A
  have hPo : IsOpen {y | ¬ P y} :=
    (IsLocalRing.isClosed_singleton_closedPoint A).isOpen_compl.preimage g'.continuous
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology X') AddCommGrpCat.{u+1}) := HasExt.standard _
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y') AddCommGrpCat.{u+1}) := HasExt.standard _
  haveI := wc_et_enough_injectives X'
  obtain ⟨L, ⟨adj⟩, hL, ⟨eL⟩⟩ := wc_et_push_left_adjoint h
  haveI := hL
  haveI : L.Additive := adj.left_adjoint_additive
  haveI : Limits.PreservesFiniteLimits (wcEtPush h) := by
    haveI : Limits.PreservesLimitsOfSize.{0, 0} (wcEtPush h) := adj.rightAdjoint_preservesLimits
    exact Limits.PreservesLimitsOfSize.preservesFiniteLimits _
  let P0 := (constantSheaf (Scheme.smallEtaleTopology Y') AddCommGrpCat.{u+1}).obj
    (AddCommGrpCat.of (ULift.{u+1} ℤ))

  have main : ∀ q : ℕ, ∀ G' : Sheaf (Scheme.smallEtaleTopology Y') AddCommGrpCat.{u+1},
      wcSuppIn Y' {y | ¬ P y} G' → m • 𝟙 G' = 0 → Subsingleton (Abelian.Ext P0 G' q) := by
    intro q
    induction q using Nat.strong_induction_on with
    | _ q IH =>
    intro G' hGs hGt

    let F := L.obj G'
    have hFt : m • 𝟙 F = 0 := by
      show m • 𝟙 (L.obj G') = 0
      rw [← CategoryTheory.Functor.map_id, ← CategoryTheory.Functor.map_nsmul, hGt,
        CategoryTheory.Functor.map_zero]
    have hFs : wcSuppIn X' (h ⁻¹' {y | ¬ P y}) F := wc_et_pull_suppIn h L adj _ G' hGs
    have hFs' : wcSuppIn X' {x | (h ≫ g') x ≠ IsLocalRing.closedPoint A} F := by
      have hset : {x | (h ≫ g') x ≠ IsLocalRing.closedPoint A} = h ⁻¹' {y | ¬ P y} := by
        ext x
        simp only [Set.mem_preimage, Set.mem_setOf_eq, P, Scheme.Hom.comp_apply]
      rw [hset]
      exact hFs

    have hE : ∀ n : ℕ, Subsingleton (Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology X')
        AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) F n) := fun n =>
      hfg A a X' (h ≫ g') a' hpaste m hm F hFs' hFt n
    have hE' : ∀ n : ℕ, Subsingleton (Abelian.Ext (L.obj P0) F n) := by
      intro n
      constructor
      intro x y
      have key : ∀ z : Abelian.Ext (L.obj P0) F n,
          (Abelian.Ext.mk₀ eL.hom).comp ((Abelian.Ext.mk₀ eL.inv).comp z (zero_add _))
            (zero_add _) = z := by
        intro z
        rw [Abelian.Ext.mk₀_comp_mk₀_assoc, Iso.hom_inv_id, Abelian.Ext.mk₀_id_comp]
      haveI := hE n
      rw [← key x, ← key y, Subsingleton.elim ((Abelian.Ext.mk₀ eL.inv).comp x (zero_add _))
        ((Abelian.Ext.mk₀ eL.inv).comp y (zero_add _))]

    let I := injectiveResolution F
    let K := ((wcEtPush h).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex
    have hKinj : ∀ j, Injective (K.X j) := fun j => adj.map_injective _ (I.injective j)

    have hcoc : ∀ (n : ℕ) (c : P0 ⟶ (wcEtPush h).obj (I.cocomplex.X n)),
        c ≫ (wcEtPush h).map (I.cocomplex.d n (n + 1)) = 0 →
        ∃ e : P0 ⟶ (wcEtPush h).obj (I.cocomplex.X (n - 1)),
          e ≫ (wcEtPush h).map (I.cocomplex.d (n - 1) n) = c := by
      intro n c hc
      have hcb : (adj.homEquiv _ _).symm c ≫ I.cocomplex.d n (n + 1) = 0 := by
        rw [← Adjunction.homEquiv_naturality_right_symm, hc, Adjunction.homEquiv_counit,
          CategoryTheory.Functor.map_zero, Limits.zero_comp]
      cases n with
      | zero =>
        obtain ⟨l, hl⟩ : ∃ l, l ≫ I.ι.f 0 = (adj.homEquiv _ _).symm c :=
          ⟨_, I.exact₀.lift_f _ hcb⟩
        have hφ : l ≫ (HomologicalComplex.singleObjXSelf (ComplexShape.up ℕ) 0 F).hom = 0 := by
          haveI := hE' 0
          have h1 : Abelian.Ext.mk₀
              (l ≫ (HomologicalComplex.singleObjXSelf (ComplexShape.up ℕ) 0 F).hom) =
              Abelian.Ext.mk₀ (0 : L.obj P0 ⟶ F) := Subsingleton.elim _ _
          rw [← Abelian.Ext.homEquiv₀_symm_apply, ← Abelian.Ext.homEquiv₀_symm_apply] at h1
          exact Abelian.Ext.homEquiv₀.symm.injective h1
        have hl0 : l = 0 := by
          rw [← cancel_mono (HomologicalComplex.singleObjXSelf (ComplexShape.up ℕ) 0 F).hom,
            Limits.zero_comp]
          exact hφ
        have hcs : (adj.homEquiv _ _).symm c = 0 := by
          rw [← hl, hl0, Limits.zero_comp]
        have hc0 : c = 0 := by
          have e1 : c = adj.homEquiv _ _ ((adj.homEquiv _ _).symm c) :=
            (Equiv.apply_symm_apply _ _).symm
          rw [e1, hcs, Adjunction.homEquiv_unit, CategoryTheory.Functor.map_zero,
            Limits.comp_zero]
        exact ⟨0, by rw [hc0, Limits.zero_comp]⟩
      | succ p =>
        have hx : I.extMk ((adj.homEquiv _ _).symm c) (p + 1 + 1) rfl hcb = 0 := by
          haveI := hE' (p + 1)
          exact Subsingleton.elim _ _
        obtain ⟨γ, hγ⟩ := (I.extMk_eq_zero_iff _ (p + 1 + 1) rfl hcb p rfl).mp hx
        refine ⟨adj.homEquiv _ _ γ, ?_⟩
        show adj.homEquiv _ _ γ ≫ (wcEtPush h).map (I.cocomplex.d p (p + 1)) = c
        rw [← Adjunction.homEquiv_naturality_right, hγ, Equiv.apply_symm_apply]

    have hsupp : ∀ n : ℕ, wcSuppIn Y' {y | ¬ P y} (K.homology n) := fun n =>
      wc_et_push_homology_supp_of_locKill h I.cocomplex n P hPo
        (wc_pbc_locKill f b h a' hX hfP hf m hm F hFt P hFs I n)
    have htors : ∀ n : ℕ, m • 𝟙 (K.homology n) = 0 := fun n => s5 (wcEtPush h) F I m hFt n
    have hH : ∀ p : ℕ, p < q → ∀ n : ℕ, Subsingleton (Abelian.Ext P0 (K.homology n) p) :=
      fun p hp n => IH p hp _ (hsupp n) (htors n)

    haveI h0 : Subsingleton (Abelian.Ext P0 (K.homology 0) q) :=
      wc_inj_complex_ext_low P0 K hKinj q hH (fun c hc => hcoc q c hc)

    let e0 : K.homology 0 ≅ (wcEtPush h).obj F :=
      (I.isoRightDerivedObj (wcEtPush h) 0).symm ≪≫ (wcEtPush h).rightDerivedZeroIsoSelf.app F

    haveI hu : Mono (adj.unit.app G') := wc_et_push_unit_mono h hhS L adj G'
    let u' : G' ⟶ K.homology 0 := adj.unit.app G' ≫ e0.inv
    haveI : Mono u' := mono_comp _ _
    obtain ⟨hQS, hQT⟩ := wc_supp_torsion_cokernel Y' {y | ¬ P y} m u' (hsupp 0) (htors 0)
    let S := ShortComplex.mk u' (Limits.cokernel.π u') (Limits.cokernel.condition u')
