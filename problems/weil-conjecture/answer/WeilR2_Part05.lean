    refine ⟨_, h3.trans ?_⟩
    rw [he, hff]
    exact congrArg _ hnat

theorem wc_et_stalk_range_local_uniform : ∀ (B : Scheme.{u}) [IsNoetherian B] (F : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}), (∀ b : B, IsCofiltered (StructuredArrow (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B))) → (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] {V U : Scheme.{u}} (g : V ⟶ U) [Etale g] (s : Spec (.of Ω) ⟶ U) (v : V), g v = s (IsLocalRing.closedPoint Ω) → ∃ t : Spec (.of Ω) ⟶ V, t ≫ g = s ∧ t (IsLocalRing.closedPoint Ω) = v) → (∀ {V B' : Scheme.{u}} (φ : V ⟶ B') [Etale φ] (v : V), ∃ U : V.Opens, v ∈ U ∧ ∀ w ∈ U, φ w = φ v → w = v) → (∀ (Y : Scheme.{u}) (G : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (V : Y.Etale) (g : G.obj.obj (Opposite.op V)), IsOpen {v : V.left | ∃ (V₁ : Y.Etale) (c : V₁ ⟶ V), v ∈ Set.range c.left ∧ G.obj.map c.op g = 0} ∧ ∀ (V₁ : Y.Etale) (c : V₁ ⟶ V), Set.range c.left ⊆ {v : V.left | ∃ (V₂ : Y.Etale) (c₂ : V₂ ⟶ V), v ∈ Set.range c₂.left ∧ G.obj.map c₂.op g = 0} → G.obj.map c.op g = 0) → (∀ b : B, Finite ((wcEtStalk B b).obj F)) → ∀ (η : B), (∃ W : Set B, IsOpen W ∧ η ∈ W ∧ ∀ y ∈ W, η ⤳ y → Nat.card ((wcEtStalk B y).obj F) = Nat.card ((wcEtStalk B η).obj F)) → ∀ (G : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}) (ι : G ⟶ F), ∃ U : Set B, IsOpen U ∧ η ∈ U ∧ ∀ y ∈ U, η ⤳ y → ∀ (G' : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}) (ι' : G' ⟶ F), Set.range ((wcEtStalk B η).map ι') ⊆ Set.range ((wcEtStalk B η).map ι) → Set.range ((wcEtStalk B y).map ι') ⊆ Set.range ((wcEtStalk B y).map ι) :=
by
  classical
  intro B _ F hcof hlift hiso hvan hfin η hW G ι
  obtain ⟨W, hWo, hηW, hWc⟩ := hW
  obtain ⟨V, t, ht, σ, hσ1, hσ2, hσ3⟩ :=
    wc_et_stalk_good_nbhd B F G ι η (hcof η) hiso (hfin η)
  haveI : Etale V.hom := V.prop
  have hgp : ∀ b : B, (wcEtGeomPt B b) (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField b))) = b :=
    fun b => (Scheme.Hom.comp_apply _ _ _).trans (Scheme.fromSpecResidueField_apply _ _)
  have hp : V.hom (t (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField η)))) = η := by
    have h1 : (t ≫ V.hom) (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField η))) =
        (wcEtGeomPt B η) (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField η))) := by
      rw [ht]
    exact (Scheme.Hom.comp_apply t V.hom _).symm.trans (h1.trans (hgp η))
  refine ⟨Set.range V.hom ∩ W, V.hom.isOpenMap.isOpen_range.inter hWo, ⟨⟨_, hp⟩, hηW⟩, ?_⟩
  rintro y ⟨⟨w₀, hw₀⟩, hyW⟩ hηy G' ι' hR

  have hηw₀ : η ⤳ V.hom w₀ := (congrArg (η ⤳ ·) hw₀).mpr hηy
  obtain ⟨w', hw'w₀, hw'η⟩ := Flat.generalizingMap V.hom hηw₀
  have hw'p := hσ3 w' hw'η
  rw [hw'p] at hw'w₀
  obtain ⟨ty, hty, htypt⟩ := hlift (AlgebraicClosure (B.residueField y)) V.hom (wcEtGeomPt B y) w₀
    (hw₀.trans (hgp y).symm)
  have hspec : t (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField η))) ⤳
      ty (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField y))) := by
    rw [htypt]; exact hw'w₀
  have hT := wc_et_germ_transfer_specialize B F hcof hlift V η y t ht ty hty hspec

  let Ay := StructuredArrow.mk (Over.homMk ty hty : Over.mk (wcEtGeomPt B y) ⟶ (Scheme.Etale.forget B).obj V)
  let gy := (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt B y)) (Scheme.Etale.forget B)).op ⋙ F.obj) (Opposite.op Ay)).hom
  let Φ : (wcEtStalk B η).obj F → (wcEtStalk B y).obj F := fun x => gy (σ x)
  have hinj : Function.Injective Φ := by
    intro x₁ x₂ h
    have h0 : gy (σ x₁ - σ x₂) = 0 := by
      rw [map_sub]; exact sub_eq_zero.mpr h
    have h1 := (hT (σ x₁ - σ x₂)).1 h0
    rw [map_sub, hσ1, hσ1] at h1
    exact sub_eq_zero.mp h1

  have hbij : Function.Bijective Φ := by
    haveI := hfin y
    exact hinj.bijective_of_nat_card_le (hWc y hyW hηy).le

  intro x hx
  obtain ⟨z, rfl⟩ := hbij.2 x
  have hzR : z ∈ Set.range ((wcEtStalk B η).map ι') := by
    have h2 := (hT (σ z)).2 G' ι' hx
    rwa [hσ1] at h2
  obtain ⟨g, hg⟩ := hσ2 z (hR hzR)
  have h3 := (wc_et_stalk_germ_facts B y (hcof y) F).2.2 G ι Ay g
  exact ⟨_, h3.trans (congrArg gy hg)⟩

theorem wc_et_noetherianObject_of_stalk_criteria : ∀ (B : Scheme.{u}) [IsNoetherian B] (F : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}), (∀ b : B, Finite ((wcEtStalk B b).obj F)) → (∀ (G G' : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}) (ι : G ⟶ F) (ι' : G' ⟶ F), Mono ι → (∀ b : B, Set.range ((wcEtStalk B b).map ι') ⊆ Set.range ((wcEtStalk B b).map ι)) → ∃ φ : G' ⟶ G, φ ≫ ι = ι') → (∀ (η : B) (G : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}) (ι : G ⟶ F), ∃ U : Set B, IsOpen U ∧ η ∈ U ∧ ∀ y ∈ U, η ⤳ y → ∀ (G' : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}) (ι' : G' ⟶ F), Set.range ((wcEtStalk B η).map ι') ⊆ Set.range ((wcEtStalk B η).map ι) → Set.range ((wcEtStalk B y).map ι') ⊆ Set.range ((wcEtStalk B y).map ι)) → IsNoetherianObject F :=
by
  intro B _ F hfin hfac hunif
  classical
  rw [isNoetherianObject_iff_monotone_chain_condition]
  intro f
  obtain ⟨R, hR⟩ : ∃ R : ℕ → ∀ b : B, Set ((wcEtStalk B b).obj F),
      ∀ n b, R n b = Set.range ((wcEtStalk B b).map (f n).arrow) := ⟨_, fun _ _ => rfl⟩
  have hmono : ∀ n m : ℕ, n ≤ m → ∀ b : B, R n b ⊆ R m b := by
    intro n m hnm b x hx
    rw [hR] at hx ⊢
    obtain ⟨z, rfl⟩ := hx
    refine ⟨(wcEtStalk B b).map (Subobject.ofLE _ _ (f.monotone hnm)) z, ?_⟩
    rw [← Subobject.ofLE_arrow (f.monotone hnm), Functor.map_comp]
    rfl
  have key : ∀ Z : TopologicalSpace.Closeds B, ∃ N : ℕ, ∀ n : ℕ, N ≤ n →
      ∀ b ∈ (Z : Set B), R n b ⊆ R N b := by
    intro Z
    refine WellFoundedLT.induction (motive := fun Z : TopologicalSpace.Closeds B =>
      ∃ N : ℕ, ∀ n : ℕ, N ≤ n → ∀ b ∈ (Z : Set B), R n b ⊆ R N b) Z ?_
    intro Z IH
    by_cases hne : (Z : Set B).Nonempty
    swap
    · exact ⟨0, fun n _ b hb => absurd ⟨b, hb⟩ hne⟩
    by_cases hirr : IsPreirreducible (Z : Set B)
    · obtain ⟨η, hη⟩ := QuasiSober.sober ⟨hne, hirr⟩ Z.isClosed
      have hηZ : η ∈ (Z : Set B) := hη.mem
      haveI := hfin η
      obtain ⟨N₀, hN₀⟩ := WellFoundedGT.monotone_chain_condition
        (⟨fun n => R n η, fun n m h => hmono n m h η⟩ : ℕ →o Set ((wcEtStalk B η).obj F))
      obtain ⟨U, hUo, hηU, hU⟩ := hunif η _ (f N₀).arrow
      let Y : TopologicalSpace.Closeds B :=
        ⟨(Z : Set B) ∩ Uᶜ, Z.isClosed.inter hUo.isClosed_compl⟩
      have hYlt : Y < Z := by
        refine lt_of_le_of_ne ?_ ?_
        · intro x hx
          exact hx.1
        · intro h
          have h' : (Y : Set B) = Z := congrArg (fun W : TopologicalSpace.Closeds B => (W : Set B)) h
          have hηY : η ∈ (Y : Set B) := h' ▸ hηZ
          exact hηY.2 hηU
      obtain ⟨N₁, hN₁⟩ := IH Y hYlt
      refine ⟨max N₀ N₁, fun n hn b hb => ?_⟩
      by_cases hbU : b ∈ U
      · have h1 : R n η ⊆ R N₀ η := by
          have this : R N₀ η = R n η := hN₀ n (le_trans (le_max_left _ _) hn)
          intro x hx
          rw [this]
          exact hx
        have h2 := hU b hbU (hη.specializes hb) _ (f n).arrow
          (by rw [← hR n η, ← hR N₀ η]; exact h1)
        rw [← hR n b, ← hR N₀ b] at h2
        exact h2.trans (hmono _ _ (le_max_left _ _) b)
      · exact (hN₁ n (le_trans (le_max_right _ _) hn) b ⟨hb, hbU⟩).trans
          (hmono _ _ (le_max_right _ _) b)
    · rw [IsPreirreducible] at hirr
      push_neg at hirr
      obtain ⟨u, v, hu, hv, hsu, hsv, hsuv⟩ := hirr
      have hdisj : ∀ x ∈ (Z : Set B), x ∈ u → x ∈ v → False := by
        intro x hx hxu hxv
        have : x ∈ (Z : Set B) ∩ (u ∩ v) := ⟨hx, hxu, hxv⟩
        rw [hsuv] at this
        exact this
      let Y₁ : TopologicalSpace.Closeds B :=
        ⟨(Z : Set B) ∩ uᶜ, Z.isClosed.inter hu.isClosed_compl⟩
      let Y₂ : TopologicalSpace.Closeds B :=
        ⟨(Z : Set B) ∩ vᶜ, Z.isClosed.inter hv.isClosed_compl⟩
      have hY₁ : Y₁ < Z := by
        obtain ⟨x, hxZ, hxu⟩ := hsu
        refine lt_of_le_of_ne ?_ ?_
        · intro y hy
          exact hy.1
        · intro h
          have h' : (Y₁ : Set B) = Z :=
            congrArg (fun W : TopologicalSpace.Closeds B => (W : Set B)) h
          have hxY : x ∈ (Y₁ : Set B) := h' ▸ hxZ
          exact hxY.2 hxu
      have hY₂ : Y₂ < Z := by
        obtain ⟨x, hxZ, hxv⟩ := hsv
        refine lt_of_le_of_ne ?_ ?_
        · intro y hy
          exact hy.1
        · intro h
          have h' : (Y₂ : Set B) = Z :=
            congrArg (fun W : TopologicalSpace.Closeds B => (W : Set B)) h
          have hxY : x ∈ (Y₂ : Set B) := h' ▸ hxZ
          exact hxY.2 hxv
      obtain ⟨N₁, hN₁⟩ := IH Y₁ hY₁
      obtain ⟨N₂, hN₂⟩ := IH Y₂ hY₂
      refine ⟨max N₁ N₂, fun n hn b hb => ?_⟩
      by_cases hbu : b ∈ u
      · have hbv : b ∉ v := fun hbv => hdisj b hb hbu hbv
        exact (hN₂ n (le_trans (le_max_right _ _) hn) b ⟨hb, hbv⟩).trans
          (hmono _ _ (le_max_right _ _) b)
      · exact (hN₁ n (le_trans (le_max_left _ _) hn) b ⟨hb, hbu⟩).trans
          (hmono _ _ (le_max_left _ _) b)
  obtain ⟨N, hN⟩ := key ⊤
  refine ⟨N, fun m hm => le_antisymm (f.monotone hm) ?_⟩
  obtain ⟨φ, hφ⟩ := hfac _ _ (f N).arrow (f m).arrow inferInstance (fun b => by
    rw [← hR m b, ← hR N b]
    exact hN m hm b (by rw [TopologicalSpace.Closeds.coe_top]; trivial))
  exact Subobject.le_of_comm φ hφ

theorem wc_closed_immersion_geomPt_compat : ∀ (R₀ B₀ : Scheme.{u}) (i : R₀ ⟶ B₀) [IsClosedImmersion i] (y : R₀), ∃ e : Spec (.of (AlgebraicClosure (B₀.residueField (i y)))) ⟶ Spec (.of (AlgebraicClosure (R₀.residueField y))), IsIso e ∧ e ≫ wcEtGeomPt R₀ y ≫ i = wcEtGeomPt B₀ (i y) :=
by
  intro R₀ B₀ i _ y
  have key : ∀ (K L : Type u) [Field K] [Field L] (ψ : K ≃+* L),
      ∃ Φ : AlgebraicClosure K ≃+* AlgebraicClosure L,
        ∀ s : K, Φ.symm (algebraMap L (AlgebraicClosure L) (ψ s)) =
          algebraMap K (AlgebraicClosure K) s := by
    intro K L _ _ ψ
    refine ⟨IsAlgClosure.equivOfEquiv (AlgebraicClosure K) (AlgebraicClosure L) ψ, fun s => ?_⟩
    rw [IsAlgClosure.equivOfEquiv_symm_algebraMap, RingEquiv.symm_apply_apply]
  have hinj : Function.Injective (i.residueFieldMap y).hom := RingHom.injective _
  have hsurj : Function.Surjective (i.residueFieldMap y).hom := by
    intro t
    obtain ⟨s, rfl⟩ := Scheme.residue_surjective R₀ y t
    obtain ⟨r, rfl⟩ := Scheme.Hom.stalkMap_surjective i y s
    refine ⟨(B₀.residue (i y)).hom r, ?_⟩
    have h := congrArg (fun g => g.hom r) (Scheme.residue_residueFieldMap i y)
    simpa using h
  obtain ⟨Φ, hΦ⟩ := key _ _ (RingEquiv.ofBijective (i.residueFieldMap y).hom ⟨hinj, hsurj⟩)
  refine ⟨Spec.map (CommRingCat.ofHom (Φ.symm : AlgebraicClosure (R₀.residueField y) →+*
    AlgebraicClosure (B₀.residueField (i y)))), ?_, ?_⟩
  · have hh : CommRingCat.ofHom (Φ.symm : AlgebraicClosure (R₀.residueField y) →+*
        AlgebraicClosure (B₀.residueField (i y))) = Φ.symm.toCommRingCatIso.hom := rfl
    rw [hh]
    infer_instance
  · have hring : i.residueFieldMap y ≫
        CommRingCat.ofHom (algebraMap (R₀.residueField y) (AlgebraicClosure (R₀.residueField y))) ≫
        CommRingCat.ofHom (Φ.symm : AlgebraicClosure (R₀.residueField y) →+*
          AlgebraicClosure (B₀.residueField (i y))) =
        CommRingCat.ofHom (algebraMap (B₀.residueField (i y))
          (AlgebraicClosure (B₀.residueField (i y)))) := by
      ext s
      exact hΦ s
    show Spec.map (CommRingCat.ofHom (Φ.symm : AlgebraicClosure (R₀.residueField y) →+*
        AlgebraicClosure (B₀.residueField (i y)))) ≫
        (Spec.map (CommRingCat.ofHom (algebraMap (R₀.residueField y)
          (AlgebraicClosure (R₀.residueField y)))) ≫ R₀.fromSpecResidueField y) ≫ i =
      Spec.map (CommRingCat.ofHom (algebraMap (B₀.residueField (i y))
          (AlgebraicClosure (B₀.residueField (i y))))) ≫ B₀.fromSpecResidueField (i y)
    rw [Category.assoc, ← Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField, ← hring]
    simp only [← Category.assoc, ← Spec.map_comp]
    try rfl

theorem wc_et_fibre_card_reduce_to_integral : ∀ (K : Type u) [Field K] [IsAlgClosed K] (X B : Scheme.{u}) (fB : B ⟶ Spec (.of K)) [IsProper fB] (g : X ⟶ B) [IsProper g] (ℓ q : ℕ), (∀ {Y Z : Scheme.{u}} (i : Z ⟶ Y) [IsIso i] (m q : ℕ), Nonempty (wcEtCoh Y m q ≃ wcEtCoh Z m q)) → (∀ (R₀ B₀ : Scheme.{u}) (i : R₀ ⟶ B₀) [IsClosedImmersion i] (y : R₀), ∃ e : Spec (.of (AlgebraicClosure (B₀.residueField (i y)))) ⟶ Spec (.of (AlgebraicClosure (R₀.residueField y))), IsIso e ∧ e ≫ wcEtGeomPt R₀ y ≫ i = wcEtGeomPt B₀ (i y)) → (∀ (C : Scheme.{u}), ∃ (R : Scheme.{u}) (r : R ⟶ C), IsClosedImmersion r ∧ Set.range r = Set.univ ∧ IsReduced R) → (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (t : Spec (.of Ω) ⟶ B), topologicalKrullDim ↥(Limits.pullback g t) ≤ ((1 : ℕ) : WithBot ℕ∞)) → (∀ (S X' : Scheme.{u}) (fS : S ⟶ Spec (.of K)) [IsProper fS] [IsIntegral S] (g' : X' ⟶ S) [IsProper g'], (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (t : Spec (.of Ω) ⟶ S), topologicalKrullDim ↥(Limits.pullback g' t) ≤ ((1 : ℕ) : WithBot ℕ∞)) → ∃ W : Set S, IsOpen W ∧ genericPoint S ∈ W ∧ ∀ y ∈ W, Nat.card (wcEtCoh (Limits.pullback g' (wcEtGeomPt S y)) ℓ q) = Nat.card (wcEtCoh (Limits.pullback g' (wcEtGeomPt S (genericPoint S))) ℓ q)) → ∀ η : B, ∃ W : Set B, IsOpen W ∧ η ∈ W ∧ ∀ y ∈ W, η ⤳ y → Nat.card (wcEtCoh (Limits.pullback g (wcEtGeomPt B y)) ℓ q) = Nat.card (wcEtCoh (Limits.pullback g (wcEtGeomPt B η)) ℓ q) :=
by
  intro K _ _ X B fB _ g _ ℓ q h1 h2 h3 h4 h5 η
  classical

  let Z : TopologicalSpace.Closeds B := ⟨closure {η}, isClosed_closure⟩
  let j := (Scheme.IdealSheafData.vanishingIdeal Z).subschemeι
  have hj : Set.range j = closure {η} := by
    rw [Scheme.IdealSheafData.range_subschemeι, Scheme.IdealSheafData.coe_support_vanishingIdeal]
    rfl
  obtain ⟨R, r, hr, hrs, hred⟩ := h3 (Scheme.IdealSheafData.vanishingIdeal Z).subscheme
  haveI := hr
  haveI := hred
  let i : R ⟶ B := r ≫ j
  haveI hi : IsClosedImmersion i := inferInstanceAs (IsClosedImmersion (r ≫ j))
  have hcomp : (⇑i : R → B) = ⇑j ∘ ⇑r := funext (fun x => Scheme.Hom.comp_apply r j x)
  have hrange : Set.range i = closure {η} := by
    rw [hcomp, Set.range_comp, hrs, Set.image_univ, hj]
  have hemb : Topology.IsEmbedding i := (Scheme.Hom.isClosedEmbedding i).isEmbedding
  haveI hR : IsIntegral R := by
    have hirr : IsIrreducible (Set.range i) := by
      rw [hrange]; exact isIrreducible_singleton.closure
    haveI : IrreducibleSpace (Set.range i) := Subtype.irreducibleSpace hirr
    haveI : IrreducibleSpace R := Function.Surjective.irreducibleSpace
      hemb.toHomeomorph.symm.continuous hemb.toHomeomorph.symm.surjective
    exact isIntegral_of_irreducibleSpace_of_isReduced R
  have hgen : i (genericPoint R) = η := by
    have hg' := (genericPoint_spec R).image (Scheme.Hom.continuous i)
    rw [Set.image_univ, hrange, closure_closure] at hg'
    exact hg'.eq isGenericPoint_closure

  have hdim : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (t : Spec (.of Ω) ⟶ R),
      topologicalKrullDim ↥(Limits.pullback (Limits.pullback.snd g i) t) ≤
        ((1 : ℕ) : WithBot ℕ∞) := by
    intro Ω _ _ t
    rw [IsHomeomorph.topologicalKrullDim_eq _
      (Scheme.Hom.homeomorph (Limits.pullbackLeftPullbackSndIso g i t).hom).isHomeomorph]
    exact h4 Ω (t ≫ i)

  have hcard : ∀ y : R,
      Nat.card (wcEtCoh (Limits.pullback (Limits.pullback.snd g i) (wcEtGeomPt R y)) ℓ q) =
        Nat.card (wcEtCoh (Limits.pullback g (wcEtGeomPt B (i y))) ℓ q) := by
    intro y
    obtain ⟨e, he, hee⟩ := h2 R B i y
    haveI := he
    let Φ : Limits.pullback g (wcEtGeomPt B (i y)) ≅
        Limits.pullback (Limits.pullback.snd g i) (wcEtGeomPt R y) :=
      (Limits.pullback.congrHom rfl hee.symm) ≪≫
        (Limits.pullbackLeftPullbackSndIso g (wcEtGeomPt R y ≫ i) e).symm ≪≫
        asIso (Limits.pullback.fst (Limits.pullback.snd g (wcEtGeomPt R y ≫ i)) e) ≪≫
        (Limits.pullbackLeftPullbackSndIso g i (wcEtGeomPt R y)).symm
    exact Nat.card_congr (h1 Φ.hom ℓ q).some

  haveI : IsProper (i ≫ fB) := inferInstance
  haveI : IsProper (Limits.pullback.snd g i) := inferInstance
  obtain ⟨WR, hWRo, hgenW, hWR⟩ :=
    h5 R (Limits.pullback g i) (i ≫ fB) (Limits.pullback.snd g i) hdim
  obtain ⟨W, hWo, hpre⟩ := hemb.isInducing.isOpen_iff.mp hWRo
  refine ⟨W, hWo, ?_, ?_⟩
  · rw [← hgen]
    have : genericPoint R ∈ i ⁻¹' W := by rw [hpre]; exact hgenW
    exact this
  · intro y hyW hsp
    have hy : y ∈ Set.range i := by
      rw [hrange]; exact specializes_iff_mem_closure.mp hsp
    obtain ⟨yR, rfl⟩ := hy
    have hyR : yR ∈ WR := by rw [← hpre]; exact hyW
    rw [← hcard yR, hWR yR hyR, hcard (genericPoint R), hgen]

theorem wc_et_abstract_blowup_vanishing : ∀ (Y X' Z : Scheme.{u}) (b : X' ⟶ Y) [IsProper b] (iZ : Z ⟶ Y) [IsClosedImmersion iZ], (∀ U : Y.Opens, (U : Set Y) = (Set.range iZ)ᶜ → IsIso (b ∣_ U)) → ∀ m : ℕ, m ≠ 0 → ∀ q : ℕ, Subsingleton (wcEtCoh X' m q) → Subsingleton (wcEtCoh Z m q) → (∀ q' : ℕ, q' + 1 = q → Subsingleton (wcEtCoh (Limits.pullback b iZ) m q')) → Subsingleton (wcEtCoh Y m q) :=
by
  intro Y X' Z b _ iZ _ hiso m hm q hX hZ hE
  classical

  have hmono : ∀ (W : Scheme.{u}) (S : Set W), Mono (wcEtExtZeroι W S m) := by
    intro W S
    let α : wcEtExtZeroPre W S m ⟶
        (Functor.const _).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))) :=
      { app := fun V => AddCommGrpCat.ofHom (wcSuppSub.{u} m (∀ x, V.unop.hom x ∈ S)).subtype
        naturality := fun _ _ _ => rfl }
    haveI : ∀ V, Mono (α.app V) := fun V =>
      (AddCommGrpCat.mono_iff_injective _).mpr (AddSubgroup.subtype_injective _)
    haveI : Mono α := NatTrans.mono_of_mono_app α
    exact Functor.map_mono (presheafToSheaf (Scheme.smallEtaleTopology W) AddCommGrpCat.{u+1}) α
  have hT : ∀ (W : Scheme.{u}) (S : Set W),
      (ShortComplex.mk (wcEtExtZeroι W S m) (Limits.cokernel.π _)
        (Limits.cokernel.condition _)).ShortExact := by
    intro W S
    haveI := hmono W S
    exact ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel _) inferInstance inferInstance
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology X') AddCommGrpCat.{u+1}) := HasExt.standard _

  have hQX' : ∀ n, n + 1 = q → Subsingleton (wcEtExt X'
      (Limits.cokernel (wcEtExtZeroι X' (Set.range (Limits.pullback.fst b iZ))ᶜ m)) n) := by
    intro n hn
    obtain ⟨e⟩ := wc_et_closed_complement_coh X' (Limits.pullback b iZ)
      (Limits.pullback.fst b iZ) m n
    haveI := hE n hn
    exact e.subsingleton

  have hJ' : Subsingleton (wcEtExt X'
      (wcEtExtZero X' (Set.range (Limits.pullback.fst b iZ))ᶜ m) q) := by
    let T := ShortComplex.mk (wcEtExtZeroι X' (Set.range (Limits.pullback.fst b iZ))ᶜ m)
      (Limits.cokernel.π _) (Limits.cokernel.condition _)
    have hTs : T.ShortExact := hT X' _
    let P := (constantSheaf (Scheme.smallEtaleTopology X') AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} ℤ))
    change Subsingleton (Abelian.Ext P T.X₁ q)
    have h2 : Subsingleton (Abelian.Ext P T.X₂ q) := hX
    have hall : ∀ x : Abelian.Ext P T.X₁ q, x = 0 := by
      intro x
      have hx : x.comp (Abelian.Ext.mk₀ T.f) (add_zero q) = 0 := Subsingleton.elim _ _
      cases q with
      | zero =>
        obtain ⟨g, rfl⟩ : ∃ g, Abelian.Ext.mk₀ g = x := ⟨_, Abelian.Ext.mk₀_homEquiv₀_apply x⟩
        have hx' : Abelian.Ext.mk₀ (g ≫ T.f) = Abelian.Ext.mk₀ 0 := by
          rw [← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_zero]
          exact hx
        rw [← Abelian.Ext.homEquiv₀_symm_apply, ← Abelian.Ext.homEquiv₀_symm_apply] at hx'
        have hg : g ≫ T.f = 0 := Abelian.Ext.homEquiv₀.symm.injective hx'
        haveI := hTs.mono_f
        rw [Limits.zero_of_comp_mono T.f hg, Abelian.Ext.mk₀_zero]
      | succ n₀ =>
        obtain ⟨y, hy⟩ := Abelian.Ext.covariant_sequence_exact₁ P hTs x hx rfl
        have h3 : Subsingleton (Abelian.Ext P T.X₃ n₀) := hQX' n₀ rfl
        rw [← hy, Subsingleton.elim y 0, Abelian.Ext.zero_comp]
    exact ⟨fun a c => (hall a).trans (hall c).symm⟩

  have hJ : Subsingleton (wcEtExt Y (wcEtExtZero Y (Set.range iZ)ᶜ m) q) := by
    obtain ⟨e⟩ := wc_et_proper_excision Y X' Z b iZ hiso m hm
      wc_et_henselian_proper_vanishing q
    exact e.subsingleton

  have hQ : Subsingleton (wcEtExt Y (Limits.cokernel (wcEtExtZeroι Y (Set.range iZ)ᶜ m)) q) := by
    obtain ⟨e⟩ := wc_et_closed_complement_coh Y Z iZ m q
    exact e.subsingleton

  let T := ShortComplex.mk (wcEtExtZeroι Y (Set.range iZ)ᶜ m)
    (Limits.cokernel.π _) (Limits.cokernel.condition _)
  have hTs : T.ShortExact := hT Y _
  let P := (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
    (AddCommGrpCat.of (ULift.{u+1} ℤ))
  change Subsingleton (Abelian.Ext P T.X₂ q)
  have h1 : Subsingleton (Abelian.Ext P T.X₁ q) := hJ
  have h3 : Subsingleton (Abelian.Ext P T.X₃ q) := hQ
  have hall : ∀ x : Abelian.Ext P T.X₂ q, x = 0 := by
    intro x
    have hx : x.comp (Abelian.Ext.mk₀ T.g) (add_zero q) = 0 := Subsingleton.elim _ _
    obtain ⟨a, ha⟩ := Abelian.Ext.covariant_sequence_exact₂ P hTs x hx
    rw [← ha, Subsingleton.elim a 0, Abelian.Ext.zero_comp]
  exact ⟨fun a c => (hall a).trans (hall c).symm⟩

theorem wc_et_zero_dim_vanishing : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : Scheme.{u}) (fW : W ⟶ Spec (.of Ω)) [IsProper fW], topologicalKrullDim W ≤ ((0 : ℕ) : WithBot ℕ∞) → ∀ m : ℕ, m ≠ 0 → ∀ q : ℕ, 0 < q → Subsingleton (wcEtCoh W m q) :=
by
  intro Ω _ _ W fW _ hW m hm q hq

  have hempty : ∀ (Y : Scheme.{u}), IsEmpty Y → ∀ (q : ℕ), Subsingleton (wcEtCoh Y m q) := by
    intro Y hY q
    have s1 : ∀ U : Y.Etale, IsEmpty U.left := fun U => ⟨fun x => hY.false (U.hom.base x)⟩
    have s2 : ∀ U : Y.Etale, (⊥ : Sieve U) ∈ Scheme.smallEtaleTopology Y U := by
      intro U
      change (⊥ : Sieve U) ∈ Scheme.smallGrothendieckTopology @Etale Y U
      rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
      apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
      intro x
      exact ((s1 U).false x).elim
    have s4 : ∀ G : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}, Limits.IsZero G := by
      intro G
      have h : Limits.IsZero G.obj :=
        Functor.isZero G.obj (fun X => (Sheaf.isTerminalOfBotCover G X.unop (s2 X.unop)).isZero)
      exact Limits.IsZero.of_full_of_faithful_of_isZero
        (sheafToPresheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) G h
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
    have hB := s4 ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))
    have hsub : ∀ {A B : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}},
        Limits.IsZero B → Subsingleton (Abelian.Ext A B q) := by
      intro A B hB
      have hx : ∀ x : Abelian.Ext A B q, x = 0 := by
        intro x
        rw [← Abelian.Ext.comp_mk₀_id x, hB.eq_of_src (𝟙 B) 0, Abelian.Ext.mk₀_zero,
          Abelian.Ext.comp_zero]
      exact ⟨fun x y => (hx x).trans (hx y).symm⟩
    unfold wcEtCoh
    exact hsub (A := (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} ℤ))) hB

  have hpoint : ∀ (k : Type u) [Field k] [IsSepClosed k] (q : ℕ), 0 < q →
      Subsingleton (wcEtCoh (Spec (.of k)) m q) := by
    intro k _ _ q hq
    have hsec : ∀ (X : Scheme.{u}) (f : X ⟶ Spec (.of k)), Etale f → Nonempty X →
        ∃ σ : Spec (.of k) ⟶ X, σ ≫ f = 𝟙 _ := by
      intro X f hf hX
      obtain ⟨x⟩ := hX
      obtain ⟨V, hV, hxV, -⟩ :=
        exists_isAffineOpen_mem_and_subset (X := X) (x := x) (U := ⊤) trivial
      haveI := hV.isOpenImmersion_fromSpec
      have hjx : x ∈ Set.range hV.fromSpec := by rw [hV.range_fromSpec]; exact hxV
      obtain ⟨y, -⟩ := hjx
      have hA : Nontrivial Γ(X, V) :=
        PrimeSpectrum.nonempty_iff_nontrivial.mp (⟨y⟩ : Nonempty (PrimeSpectrum Γ(X, V)))
      haveI : Etale (hV.fromSpec ≫ f) := inferInstance
      have hφ : Spec.map (Spec.preimage (hV.fromSpec ≫ f)) = hV.fromSpec ≫ f := Spec.map_preimage _
      have hφe : (Spec.preimage (hV.fromSpec ≫ f)).hom.Etale :=
        (HasRingHomProperty.Spec_iff (P := @Etale) (Q := @RingHom.Etale)).mp
          (by rw [hφ]; infer_instance)
      letI : Algebra k Γ(X, V) := (Spec.preimage (hV.fromSpec ≫ f)).hom.toAlgebra
      haveI : Algebra.Etale k Γ(X, V) := RingHom.Etale.toAlgebra hφe
      obtain ⟨I, _, Ai, _, _, e, hAi⟩ :=
        (Algebra.Etale.iff_exists_algEquiv_prod k Γ(X, V)).mp inferInstance
      have hI : Nonempty I := by
        by_contra hne
        rw [not_nonempty_iff] at hne
        haveI : Subsingleton (∀ i, Ai i) := ⟨fun a b => funext fun i => (hne.false i).elim⟩
        exact not_subsingleton Γ(X, V) e.toEquiv.subsingleton
      obtain ⟨i⟩ := hI
      haveI := (hAi i).2
      have hsurj := IsSepClosed.algebraMap_surjective k (Ai i)
      let ε : k ≃ₐ[k] Ai i := AlgEquiv.ofBijective (Algebra.ofId k (Ai i))
        ⟨(algebraMap k (Ai i)).injective, hsurj⟩
      let ρ₀ : Γ(X, V) →ₐ[k] k := ε.symm.toAlgHom.comp ((Pi.evalAlgHom k Ai i).comp e.toAlgHom)
      have hφρ : Spec.preimage (hV.fromSpec ≫ f) ≫ CommRingCat.ofHom ρ₀.toRingHom = 𝟙 _ := by
        ext c
        exact ρ₀.commutes c
      refine ⟨Spec.map (CommRingCat.ofHom ρ₀.toRingHom) ≫ hV.fromSpec, ?_⟩
      rw [Category.assoc, ← hφ, ← Spec.map_comp, hφρ, Spec.map_id]
    let T : (Spec (.of k)).Etale := Scheme.Etale.mk (𝟙 (Spec (.of k)))
    have hT : Limits.IsTerminal T :=
      Limits.IsTerminal.ofUniqueHom (fun V => MorphismProperty.Over.homMk V.hom)
        (fun V m => MorphismProperty.Over.Hom.ext
          ((Category.comp_id m.left).symm.trans (MorphismProperty.Over.w m)))
    have hcov : ∀ R ∈ (Scheme.smallEtaleTopology (Spec (.of k))) T, R.arrows (𝟙 T) := by
      intro R hR
      change R ∈ Scheme.smallGrothendieckTopology @Etale (Spec (.of k)) T at hR
      rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale _
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hR
      have hR' := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale _
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mp hR
      obtain ⟨x⟩ : Nonempty (Spec (.of k)) := inferInstance
      obtain ⟨Y, f, y, hf, -, -⟩ := hR' x
      obtain ⟨σ, hσ⟩ := hsec Y.left Y.hom Y.prop ⟨y⟩
      let σ' : T ⟶ Y := MorphismProperty.Over.homMk σ (by exact hσ)
      have h := R.downward_closed hf σ'
      rwa [hT.hom_ext (σ' ≫ f) (𝟙 T)] at h
    have hsurjT : ∀ {F G : (Spec (.of k)).Etaleᵒᵖ ⥤ AddCommGrpCat.{u+1}} (φ : F ⟶ G),
        Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology (Spec (.of k))) φ →
        Function.Surjective (φ.app (Opposite.op T)) := by
      intro F G φ hφ s
      have h1 := Presheaf.imageSieve_mem (Scheme.smallEtaleTopology (Spec (.of k))) φ s
      have h2 := hcov _ h1
      rw [Presheaf.imageSieve_apply] at h2
      obtain ⟨t, ht⟩ := h2
      exact ⟨t, by simpa using ht⟩
    haveI : ((sheafSections (Scheme.smallEtaleTopology (Spec (.of k))) AddCommGrpCat.{u+1}).obj
        (Opposite.op T)).PreservesEpimorphisms := by
      constructor
      intro F G φ hφ
      have h1 : Sheaf.IsLocallySurjective φ :=
        (Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u+1} φ).mpr hφ
      exact (AddCommGrpCat.epi_iff_surjective _).mpr (hsurjT φ.hom h1)
    have hP : Projective (AddCommGrpCat.of (ULift.{u+1} ℤ)) := by
      refine ⟨fun {E X} f e he => ?_⟩
      have hs := (AddCommGrpCat.epi_iff_surjective e).mp he
      obtain ⟨y, hy⟩ := hs (f ⟨1⟩)
      refine ⟨AddCommGrpCat.ofHom ((zmultiplesHom E y).comp AddEquiv.ulift.toAddMonoidHom), ?_⟩
      ext ⟨n⟩
      have h1 : (⟨n⟩ : ULift.{u+1} ℤ) = n • (⟨1⟩ : ULift.{u+1} ℤ) := by
        ext; simp
      change e (n • y) = f ⟨n⟩
      rw [h1, map_zsmul, map_zsmul, hy]
    have adj := constantSheafAdj (Scheme.smallEtaleTopology (Spec (.of k))) AddCommGrpCat.{u+1} hT
    haveI hproj := adj.map_projective _ hP
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology (Spec (.of k))) AddCommGrpCat.{u+1}) :=
      HasExt.standard _
    obtain ⟨n, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (show q ≠ 0 by omega)
    unfold wcEtCoh
    exact Abelian.Ext.subsingleton_of_projective _ _ n

  have P : ∀ (n : ℕ) (W : Scheme.{u}) (fW : W ⟶ Spec (.of Ω)) [IsProper fW], Nat.card W = n →
      topologicalKrullDim W ≤ ((0 : ℕ) : WithBot ℕ∞) → ∀ q : ℕ, 0 < q →
      Subsingleton (wcEtCoh W m q) := by
    intro n
    induction n using Nat.strong_induction_on with
    | _ n IH =>
      intro W fW _ hn hW q hq
      by_cases hE : IsEmpty W
      · exact hempty W hE q
      · haveI : Nonempty W := not_isEmpty_iff.mp hE
        obtain ⟨k, _, iZ, X', b, hsep, hiZ, hb, hiso, hdisj, hdim, hcard⟩ :=
          wc_zero_dim_split_point Ω W fW hW inferInstance
        haveI := hsep
        haveI := hiZ
        haveI := hb
        refine wc_et_abstract_blowup_vanishing W X' (Spec (.of k)) b iZ hiso m hm q ?_ ?_ ?_
        · exact IH (Nat.card X') (by omega) X' (b ≫ fW) rfl hdim q hq
        · exact hpoint k q hq
        · intro q' _
          exact hempty _ (Scheme.isEmpty_pullback b iZ hdisj) q'
  exact P _ W fW rfl hW q hq

theorem wc_et_proper_curve_vanishing : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (C : Scheme.{u}) (fC : C ⟶ Spec (.of Ω)) [IsProper fC] (ℓ : ℕ), ℓ.Prime → (ℓ : Ω) ≠ 0 → topologicalKrullDim C ≤ ((1 : ℕ) : WithBot ℕ∞) → ∀ q : ℕ, 2 < q → Subsingleton (wcEtCoh C ℓ q) :=
by
  intro Ω _ _ C fC _ ℓ hℓ hℓΩ hC q hq
  have hℓ0 : ℓ ≠ 0 := hℓ.ne_zero
  obtain ⟨k, rfl⟩ : ∃ k, q = k + 3 := ⟨q - 3, by omega⟩

  have hEmpty : ∀ (Y : Scheme.{u}), IsEmpty Y → ∀ (m q : ℕ), Subsingleton (wcEtCoh Y m q) := by
    intro Y hY m q
    have s1 : ∀ U : Y.Etale, IsEmpty U.left := fun U => ⟨fun x => hY.false (U.hom.base x)⟩
    have s2 : ∀ U : Y.Etale, (⊥ : Sieve U) ∈ Scheme.smallEtaleTopology Y U := by
      intro U
      change (⊥ : Sieve U) ∈ Scheme.smallGrothendieckTopology @Etale Y U
      rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
      apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
      intro x
      exact ((s1 U).false x).elim
    have s4 : ∀ G : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}, Limits.IsZero G := by
      intro G
      have h : Limits.IsZero G.obj :=
        Functor.isZero G.obj (fun X => (Sheaf.isTerminalOfBotCover G X.unop (s2 X.unop)).isZero)
      exact Limits.IsZero.of_full_of_faithful_of_isZero
        (sheafToPresheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) G h
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
    have hB := s4 ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))
    have hsub : ∀ {A B : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}},
        Limits.IsZero B → Subsingleton (Abelian.Ext A B q) := by
      intro A B hB
      have hx : ∀ x : Abelian.Ext A B q, x = 0 := by
        intro x
        rw [← Abelian.Ext.comp_mk₀_id x, hB.eq_of_src (𝟙 B) 0, Abelian.Ext.mk₀_zero,
          Abelian.Ext.comp_zero]
      exact ⟨fun x y => (hx x).trans (hx y).symm⟩
    haveI := hsub (A := (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} ℤ))) hB
    unfold wcEtCoh
    infer_instance

  have hCurve : ∀ (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω)) [IsProper fX], IrreducibleSpace X →
      (∀ x : X, IsDomain (X.presheaf.stalk x) ∧ IsIntegrallyClosed (X.presheaf.stalk x)) →
      topologicalKrullDim X = ((1 : ℕ) : WithBot ℕ∞) → Subsingleton (wcEtCoh X ℓ (k + 3)) := by
    intro X fX _ hirr hnorm hdim
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) := HasExt.standard _
    let P := (constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} ℤ))
    obtain ⟨ι, h, hS⟩ := wc_et_kummer_ses Ω X fX ℓ hℓ hℓΩ
    have hV := wc_et_gm_tsen_vanishing Ω X fX hirr hnorm hdim
    let S := ShortComplex.mk ι (ℓ • 𝟙 (wcEtGm X)) h
    change Subsingleton (Abelian.Ext P S.X₁ (k + 3))
    refine subsingleton_of_forall_eq 0 (fun x => ?_)
    have hy : x.comp (Abelian.Ext.mk₀ S.f) (add_zero _) = 0 :=
      @Subsingleton.elim _ (hV (k + 1)) _ _
    obtain ⟨x₃, hx₃⟩ := Abelian.Ext.covariant_sequence_exact₁ P hS x hy (n₀ := k + 2) rfl
    have hx₃0 : x₃ = 0 := @Subsingleton.elim _ (hV k) _ _
    rw [← hx₃, hx₃0, Abelian.Ext.zero_comp]

  have s3 : ∀ x : WithBot ℕ∞, x ≤ ((1 : ℕ) : WithBot ℕ∞) → ¬ x ≤ ((0 : ℕ) : WithBot ℕ∞) →
      x = ((1 : ℕ) : WithBot ℕ∞) := by
    intro x h1 h0
    induction x using WithBot.recBotCoe with
    | bot => exact absurd bot_le h0
    | coe y =>
      induction y using ENat.recTopCoe with
      | top =>
        exfalso
        have : ((⊤ : ℕ∞) : WithBot ℕ∞) ≤ ((1 : ℕ∞) : WithBot ℕ∞) := by exact_mod_cast h1
        have h2 : (⊤ : ℕ∞) ≤ 1 := WithBot.coe_le_coe.mp this
        simp at h2
      | coe n =>
        have h1' : n ≤ 1 := by exact_mod_cast h1
        have h0' : ¬ n ≤ 0 := fun h => h0 (by exact_mod_cast h)
        have hn : n = 1 := by omega
        subst hn
        rfl

  have P1 : ∀ (n : ℕ) (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω)) [IsProper fX],
      (irreducibleComponents X).ncard = n →
      (∀ x : X, IsDomain (X.presheaf.stalk x) ∧ IsIntegrallyClosed (X.presheaf.stalk x)) →
      topologicalKrullDim X ≤ ((1 : ℕ) : WithBot ℕ∞) → Subsingleton (wcEtCoh X ℓ (k + 3)) := by
    intro n
    induction n using Nat.strong_induction_on with
    | _ n IH =>
      intro X fX _ hn hnorm hX
      by_cases hE : IsEmpty X
      · exact hEmpty X hE ℓ (k + 3)
      · haveI : Nonempty X := not_isEmpty_iff.mp hE
        obtain ⟨Z, iZ, X', b, hiZ, hb, hiso, hdisj, hirr, hnZ, hnX', hdZ, hdX', hcard⟩ :=
          wc_normal_split_component Ω X fX hnorm inferInstance
        haveI := hiZ
        haveI := hb
        refine wc_et_abstract_blowup_vanishing X X' Z b iZ hiso ℓ hℓ0 (k + 3) ?_ ?_ ?_
        · exact IH _ (by omega) X' (b ≫ fX) rfl hnX' (hdX'.trans hX)
        · by_cases h0 : topologicalKrullDim Z ≤ ((0 : ℕ) : WithBot ℕ∞)
          · exact wc_et_zero_dim_vanishing Ω Z (iZ ≫ fX) h0 ℓ hℓ0 (k + 3) (by omega)
          · have h1 : topologicalKrullDim Z = ((1 : ℕ) : WithBot ℕ∞) := s3 _ (hdZ.trans hX) h0
            exact hCurve Z (iZ ≫ fX) hirr hnZ h1
        · intro q' _
          exact hEmpty _ (Scheme.isEmpty_pullback b iZ hdisj) ℓ q'

  have G2 : ∀ (R : Scheme.{u}) (fR : R ⟶ Spec (.of Ω)) [IsProper fR] [IsReduced R],
      topologicalKrullDim R ≤ ((1 : ℕ) : WithBot ℕ∞) → Subsingleton (wcEtCoh R ℓ (k + 3)) := by
    intro R fR _ _ hR
    obtain ⟨X', b, Z, iZ, hb, hiZ, hiso, hn, hdX', hdZ, hdE⟩ :=
      wc_reduced_curve_normalization Ω R fR hR
    haveI := hb
    haveI := hiZ
    refine wc_et_abstract_blowup_vanishing R X' Z b iZ hiso ℓ hℓ0 (k + 3) ?_ ?_ ?_
    · exact P1 _ X' (b ≫ fR) rfl hn hdX'
    · exact wc_et_zero_dim_vanishing Ω Z (iZ ≫ fR) hdZ ℓ hℓ0 (k + 3) (by omega)
    · intro q' hq'
      exact wc_et_zero_dim_vanishing Ω (Limits.pullback b iZ)
        (Limits.pullback.snd b iZ ≫ iZ ≫ fR) hdE ℓ hℓ0 q' (by omega)

  obtain ⟨R, r, hr, hsurj, hred⟩ := wc_reduced_subscheme_exists C
  haveI := hr
  haveI := hred
  have hdimR : topologicalKrullDim R = topologicalKrullDim C :=
    IsHomeomorph.topologicalKrullDim_eq r (isHomeomorph_iff_isEmbedding_surjective.mpr
      ⟨r.isClosedEmbedding.isEmbedding, Set.range_eq_univ.mp hsurj⟩)
  have hFR := G2 R (r ≫ fC) (by rw [hdimR]; exact hC)
  refine wc_et_abstract_blowup_vanishing C _ R (Scheme.emptyTo C) r ?_ ℓ hℓ0 (k + 3) ?_ hFR ?_
  · intro U hU
    have hU' : (U : Set C) = ∅ := by rw [hU, hsurj, Set.compl_univ]
    haveI : IsEmpty ↥(U : Scheme.{u}) := ⟨fun x => by
      have hx : U.ι x ∈ Set.range U.ι := ⟨x, rfl⟩
      rw [Scheme.Opens.range_ι, hU'] at hx
      exact hx⟩
    exact isIso_of_isEmpty (Scheme.emptyTo C ∣_ U)
  · exact hEmpty _ inferInstance ℓ (k + 3)
  · intro q' _
    exact hEmpty _ (Scheme.isEmpty_pullback _ r
      (by rw [Set.range_eq_empty]; exact Set.empty_disjoint _)) ℓ q'

theorem wc_fe_irreducible_closed_geom : ∀ (K : Type u) [Field K] [IsAlgClosed K] (Y : Scheme.{u}) (g : Y ⟶ Spec (.of K)) [LocallyOfFiniteType g] (C : Set ↥Y), IsClosed C → IsIrreducible C → ∀ (Ω : Type u) [Field Ω] (s : Spec (.of Ω) ⟶ Spec (.of K)), IsIrreducible ((Limits.pullback.fst g s) ⁻¹' C) :=
by
  intro K _ _ Y g _ C hC hCirr Ω _ s
  let I := Scheme.IdealSheafData.vanishingIdeal (⟨C, hC⟩ : TopologicalSpace.Closeds Y)
  have hι₀ : Set.range I.subschemeι = C := by
    rw [Scheme.IdealSheafData.range_subschemeι, Scheme.IdealSheafData.coe_support_vanishingIdeal]
    rfl
  obtain ⟨R, r, hr, hrr, hred⟩ := wc_reduced_subscheme_exists I.subscheme
  haveI := hr
  haveI := hred
  let j : R ⟶ Y := r ≫ I.subschemeι
  have hj : Set.range j = C := by
    rw [← hι₀]
    ext x
    constructor
    · rintro ⟨a, rfl⟩
      exact ⟨r a, (Scheme.Hom.comp_apply r I.subschemeι a).symm⟩
    · rintro ⟨b, rfl⟩
      obtain ⟨a, rfl⟩ : b ∈ Set.range r := by rw [hrr]; trivial
      exact ⟨a, Scheme.Hom.comp_apply r I.subschemeι a⟩
  haveI : IsClosedImmersion j := inferInstance
  have hemb : Topology.IsEmbedding j := j.isClosedEmbedding.isEmbedding
  let φ := hemb.toHomeomorph
  haveI : IrreducibleSpace ↑(Set.range j) :=
    isIrreducible_iff_irreducibleSpace.mp (hj ▸ hCirr)
  haveI : IrreducibleSpace R :=
    Function.Surjective.irreducibleSpace φ.symm.continuous φ.symm.surjective
  haveI : IsIntegral R := isIntegral_of_irreducibleSpace_of_isReduced R
  haveI : LocallyOfFiniteType (j ≫ g) := inferInstance
  have hGI := wc_geometricallyIrreducible_of_isAlgClosed K R (j ≫ g)
  haveI hirr : IrreducibleSpace ↥(Limits.pullback (j ≫ g) s) :=
    hGI.geometrically_irreducibleSpace s _ _ (IsPullback.of_hasPullback (j ≫ g) s)
  let m : Limits.pullback (j ≫ g) s ⟶ Limits.pullback g s :=
    Limits.pullback.map (j ≫ g) s g s j (𝟙 _) (𝟙 _) (Category.comp_id _) (by simp)
  have hm : Set.range m = (Limits.pullback.fst g s) ⁻¹' C := by
    have h1 : Set.range (𝟙 (Spec (.of Ω)) : Spec (.of Ω) ⟶ Spec (.of Ω)) = Set.univ :=
      Set.eq_univ_of_forall fun x => ⟨x, by simp⟩
    rw [Scheme.Pullback.range_map, hj, h1, Set.preimage_univ, Set.inter_univ]
  rw [← hm, ← Set.image_univ]
  exact (IrreducibleSpace.isIrreducible_univ _).image m m.continuous.continuousOn

theorem wc_fe_affine_closed_separation : ∀ (k K : Type u) [Field k] [Field K] [Algebra k K], (∀ (R : Type u) [CommRing R] [Algebra k R] (f : TensorProduct k R K), ∃ L₀ : IntermediateField k K, FiniteDimensional k L₀ ∧ ∀ L : IntermediateField k K, L₀ ≤ L → ∃ g : TensorProduct k R L, Algebra.TensorProduct.map (AlgHom.id k R) L.val g = f) → ∀ (R : CommRingCat.{u}) (a : Spec R ⟶ Spec (.of k)) (C : Set ↥(Limits.pullback a (Spec.map (CommRingCat.ofHom (algebraMap k K))))), IsClosed C → ∀ x ∉ C, ∃ L₀ : IntermediateField k K, FiniteDimensional k L₀ ∧ ∀ L : IntermediateField k K, L₀ ≤ L → ∀ (π : Limits.pullback a (Spec.map (CommRingCat.ofHom (algebraMap k K))) ⟶ Limits.pullback a (Spec.map (CommRingCat.ofHom (algebraMap k L)))), π ≫ Limits.pullback.fst a (Spec.map (CommRingCat.ofHom (algebraMap k L))) = Limits.pullback.fst a (Spec.map (CommRingCat.ofHom (algebraMap k K))) → π ≫ Limits.pullback.snd a (Spec.map (CommRingCat.ofHom (algebraMap k L))) = Limits.pullback.snd a (Spec.map (CommRingCat.ofHom (algebraMap k K))) ≫ Spec.map (CommRingCat.ofHom (algebraMap L K)) → ∀ y ∈ C, π y ≠ π x :=
by
  intro k K _ _ _ H
  have main : ∀ (A : Type u) [CommRing A] [Algebra k A]
      (C : Set ↥(Limits.pullback (Spec.map (CommRingCat.ofHom (algebraMap k A)))
        (Spec.map (CommRingCat.ofHom (algebraMap k K))))),
      IsClosed C → ∀ x ∉ C, ∃ L₀ : IntermediateField k K, FiniteDimensional k L₀ ∧
        ∀ L : IntermediateField k K, L₀ ≤ L →
        ∀ (π : Limits.pullback (Spec.map (CommRingCat.ofHom (algebraMap k A)))
            (Spec.map (CommRingCat.ofHom (algebraMap k K))) ⟶
          Limits.pullback (Spec.map (CommRingCat.ofHom (algebraMap k A)))
            (Spec.map (CommRingCat.ofHom (algebraMap k L)))),
        π ≫ Limits.pullback.fst (Spec.map (CommRingCat.ofHom (algebraMap k A)))
            (Spec.map (CommRingCat.ofHom (algebraMap k L))) =
          Limits.pullback.fst (Spec.map (CommRingCat.ofHom (algebraMap k A)))
            (Spec.map (CommRingCat.ofHom (algebraMap k K))) →
        π ≫ Limits.pullback.snd (Spec.map (CommRingCat.ofHom (algebraMap k A)))
            (Spec.map (CommRingCat.ofHom (algebraMap k L))) =
          Limits.pullback.snd (Spec.map (CommRingCat.ofHom (algebraMap k A)))
            (Spec.map (CommRingCat.ofHom (algebraMap k K))) ≫
            Spec.map (CommRingCat.ofHom (algebraMap L K)) →
        ∀ y ∈ C, π y ≠ π x := by
    intro A _ _ C hC x hx

    have hC' : IsClosed ((pullbackSpecIso k A K).inv ⁻¹' C) :=
      hC.preimage (pullbackSpecIso k A K).inv.continuous
    have hx' : (pullbackSpecIso k A K).hom x ∈ ((pullbackSpecIso k A K).inv ⁻¹' C)ᶜ := by
      simp only [Set.mem_compl_iff, Set.mem_preimage, Scheme.hom_inv_apply]
      exact hx
    obtain ⟨v, ⟨f, rfl⟩, hxv, hvsub⟩ :=
      (PrimeSpectrum.isTopologicalBasis_basic_opens (R := TensorProduct k A K)).exists_subset_of_mem_open
        hx' hC'.isOpen_compl
    have hfx : f ∉ PrimeSpectrum.asIdeal ((pullbackSpecIso k A K).hom x) :=
      (PrimeSpectrum.mem_basicOpen f _).mp hxv
    have hfC : ∀ z : PrimeSpectrum (TensorProduct k A K), (pullbackSpecIso k A K).inv z ∈ C →
        f ∈ z.asIdeal := by
      intro z hz
      by_contra hfz
      exact hvsub ((PrimeSpectrum.mem_basicOpen f z).mpr hfz) hz

    obtain ⟨L₀, hL₀, hdesc⟩ := H A f
    refine ⟨L₀, hL₀, ?_⟩
    intro L hL π h1 h2 y hy heq
    obtain ⟨g, hg⟩ := hdesc L hL
    let ψ : TensorProduct k A L →+* TensorProduct k A K :=
      (Algebra.TensorProduct.map (AlgHom.id k A) L.val).toRingHom

    have sq : (pullbackSpecIso k A K).inv ≫ π =
        Spec.map (CommRingCat.ofHom ψ) ≫ (pullbackSpecIso k A L).inv := by
      apply Limits.pullback.hom_ext
      · simp only [Category.assoc]
        rw [h1, pullbackSpecIso_inv_fst, pullbackSpecIso_inv_fst, ← Spec.map_comp,
          ← CommRingCat.ofHom_comp]
        congr 2
      · simp only [Category.assoc]
        rw [h2, ← Category.assoc, pullbackSpecIso_inv_snd, pullbackSpecIso_inv_snd,
          ← Spec.map_comp, ← Spec.map_comp, ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
        congr 2

    have hpt : ∀ z, π z = (pullbackSpecIso k A L).inv
        (Spec.map (CommRingCat.ofHom ψ) ((pullbackSpecIso k A K).hom z)) := by
      intro z
      conv_lhs => rw [← Scheme.hom_inv_apply (pullbackSpecIso k A K) z]
      rw [← Scheme.Hom.comp_apply, sq, Scheme.Hom.comp_apply]
    have e1 := congrArg (fun p => (pullbackSpecIso k A L).hom p)
      ((hpt y).symm.trans (heq.trans (hpt x)))
    simp only [Scheme.inv_hom_apply] at e1
    rw [Spec.map_apply, Spec.map_apply] at e1
    have e2 := congrArg (fun P => g ∈ PrimeSpectrum.asIdeal P) e1
    have hψg : ψ g = f := hg
    have e3 : ψ g ∈ PrimeSpectrum.asIdeal ((pullbackSpecIso k A K).hom y) ↔
        ψ g ∈ PrimeSpectrum.asIdeal ((pullbackSpecIso k A K).hom x) := Iff.of_eq e2
    rw [hψg] at e3
    have hyC : f ∈ PrimeSpectrum.asIdeal ((pullbackSpecIso k A K).hom y) :=
      hfC _ (by rw [Scheme.hom_inv_apply]; exact hy)
    exact hfx (e3.mp hyC)
  intro R a
  obtain ⟨φ, rfl⟩ := Spec.map_surjective a
  letI : Algebra k R := φ.hom.toAlgebra
  exact main R

theorem wc_fe_global_closed_separation : ∀ (k K : Type u) [Field k] [Field K] [Algebra k K] (T : Scheme.{u}) (h : T ⟶ Spec (.of k)), (∀ (R : CommRingCat.{u}) (a : Spec R ⟶ Spec (.of k)) (C : Set ↥(Limits.pullback a (Spec.map (CommRingCat.ofHom (algebraMap k K))))), IsClosed C → ∀ x ∉ C, ∃ L₀ : IntermediateField k K, FiniteDimensional k L₀ ∧ ∀ L : IntermediateField k K, L₀ ≤ L → ∀ (π : Limits.pullback a (Spec.map (CommRingCat.ofHom (algebraMap k K))) ⟶ Limits.pullback a (Spec.map (CommRingCat.ofHom (algebraMap k L)))), π ≫ Limits.pullback.fst a (Spec.map (CommRingCat.ofHom (algebraMap k L))) = Limits.pullback.fst a (Spec.map (CommRingCat.ofHom (algebraMap k K))) → π ≫ Limits.pullback.snd a (Spec.map (CommRingCat.ofHom (algebraMap k L))) = Limits.pullback.snd a (Spec.map (CommRingCat.ofHom (algebraMap k K))) ≫ Spec.map (CommRingCat.ofHom (algebraMap L K)) → ∀ y ∈ C, π y ≠ π x) → ∀ (C : Set ↥(Limits.pullback h (Spec.map (CommRingCat.ofHom (algebraMap k K))))), IsClosed C → ∀ x ∉ C, ∃ L₀ : IntermediateField k K, FiniteDimensional k L₀ ∧ ∀ L : IntermediateField k K, L₀ ≤ L → ∀ (π : Limits.pullback h (Spec.map (CommRingCat.ofHom (algebraMap k K))) ⟶ Limits.pullback h (Spec.map (CommRingCat.ofHom (algebraMap k L)))), π ≫ Limits.pullback.fst h (Spec.map (CommRingCat.ofHom (algebraMap k L))) = Limits.pullback.fst h (Spec.map (CommRingCat.ofHom (algebraMap k K))) → π ≫ Limits.pullback.snd h (Spec.map (CommRingCat.ofHom (algebraMap k L))) = Limits.pullback.snd h (Spec.map (CommRingCat.ofHom (algebraMap k K))) ≫ Spec.map (CommRingCat.ofHom (algebraMap L K)) → ∀ y ∈ C, π y ≠ π x :=
by
  intro k K _ _ _ T h H C hC x hx
  obtain ⟨U, hU, hpU, -⟩ := exists_isAffineOpen_mem_and_subset
    (x := Limits.pullback.fst h (Spec.map (CommRingCat.ofHom (algebraMap k K))) x)
    (U := ⊤) (by trivial)
  haveI := hU.isOpenImmersion_fromSpec
  have hrj : Set.range hU.fromSpec = (U : Set T) := hU.range_fromSpec
  have chart : ∀ (E : Type u) [Field E] [Algebra k E],
      ∃ J : Limits.pullback (hU.fromSpec ≫ h) (Spec.map (CommRingCat.ofHom (algebraMap k E))) ⟶
          Limits.pullback h (Spec.map (CommRingCat.ofHom (algebraMap k E))),
        IsOpenImmersion J ∧
        J ≫ Limits.pullback.fst h (Spec.map (CommRingCat.ofHom (algebraMap k E))) =
          Limits.pullback.fst (hU.fromSpec ≫ h) (Spec.map (CommRingCat.ofHom (algebraMap k E))) ≫
            hU.fromSpec ∧
        J ≫ Limits.pullback.snd h (Spec.map (CommRingCat.ofHom (algebraMap k E))) =
          Limits.pullback.snd (hU.fromSpec ≫ h) (Spec.map (CommRingCat.ofHom (algebraMap k E))) ∧
        ∀ z, Limits.pullback.fst h (Spec.map (CommRingCat.ofHom (algebraMap k E))) z ∈ U →
          ∃ z', J z' = z := by
    intro E _ _
    refine ⟨Limits.pullback.map (hU.fromSpec ≫ h) (Spec.map (CommRingCat.ofHom (algebraMap k E)))
      h (Spec.map (CommRingCat.ofHom (algebraMap k E))) hU.fromSpec (𝟙 _) (𝟙 _)
      (by simp) (by simp), inferInstance, Limits.pullback.lift_fst _ _ _,
      (Limits.pullback.lift_snd _ _ _).trans (Category.comp_id _), ?_⟩
    intro z hz
    have hmem : z ∈ Set.range (Limits.pullback.map (hU.fromSpec ≫ h)
        (Spec.map (CommRingCat.ofHom (algebraMap k E)))
        h (Spec.map (CommRingCat.ofHom (algebraMap k E))) hU.fromSpec (𝟙 _) (𝟙 _)
        (by simp) (by simp)) := by
      rw [Scheme.Pullback.range_map]
      refine ⟨?_, ?_⟩
      · show _ ∈ Set.range hU.fromSpec
        rw [hrj]
        exact hz
      · show _ ∈ Set.range (𝟙 _ : Spec (.of E) ⟶ Spec (.of E))
        exact ⟨_, rfl⟩
    exact hmem
  obtain ⟨JK, hJKo, hJK1, hJK2, hJKr⟩ := chart K
  obtain ⟨x', hx'⟩ := hJKr x hpU
  have hC' : IsClosed (JK ⁻¹' C) := hC.preimage JK.continuous
  have hx'C : x' ∉ JK ⁻¹' C := by
    intro hm
    apply hx
    rw [← hx']
    exact hm
  obtain ⟨L₀, hL₀, HA⟩ := H Γ(T, U) (hU.fromSpec ≫ h) (JK ⁻¹' C) hC' x' hx'C
  refine ⟨L₀, hL₀, ?_⟩
  intro L hL π hπ1 hπ2 y hy hxy
  obtain ⟨JL, hJLo, hJL1, hJL2, hJLr⟩ := chart L
  have hKL : Spec.map (CommRingCat.ofHom (algebraMap L K)) ≫
      Spec.map (CommRingCat.ofHom (algebraMap k L)) =
      Spec.map (CommRingCat.ofHom (algebraMap k K)) := by
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, ← IsScalarTower.algebraMap_eq]
  let πa := Limits.pullback.lift
    (Limits.pullback.fst (hU.fromSpec ≫ h) (Spec.map (CommRingCat.ofHom (algebraMap k K))))
    (Limits.pullback.snd (hU.fromSpec ≫ h) (Spec.map (CommRingCat.ofHom (algebraMap k K))) ≫
      Spec.map (CommRingCat.ofHom (algebraMap L K)))
    (by rw [Category.assoc, hKL, Limits.pullback.condition])
  have HA' := HA L hL πa (Limits.pullback.lift_fst _ _ _) (Limits.pullback.lift_snd _ _ _)
  have hsq : JK ≫ π = πa ≫ JL := by
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, hπ1, hJK1, Category.assoc, hJL1, ← Category.assoc,
        Limits.pullback.lift_fst]
    · rw [Category.assoc, hπ2, ← Category.assoc, hJK2, Category.assoc, hJL2,
        Limits.pullback.lift_snd]
  by_cases hyU : Limits.pullback.fst h (Spec.map (CommRingCat.ofHom (algebraMap k K))) y ∈ U
  · obtain ⟨y', rfl⟩ := hJKr y hyU
    have e1 : (JK ≫ π) y' = (πa ≫ JL) y' := by rw [hsq]
    have e2 : (JK ≫ π) x' = (πa ≫ JL) x' := by rw [hsq]
    rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at e1 e2
    have e : JL (πa y') = JL (πa x') := by
      rw [← e1, ← e2, hx']
      exact hxy
    exact HA' y' hy (JL.isOpenEmbedding.injective e)
  · apply hyU
    have e := congrArg (Limits.pullback.fst h (Spec.map (CommRingCat.ofHom (algebraMap k L)))) hxy
    have e1 : (π ≫ Limits.pullback.fst h (Spec.map (CommRingCat.ofHom (algebraMap k L)))) y =
        (π ≫ Limits.pullback.fst h (Spec.map (CommRingCat.ofHom (algebraMap k L)))) x := by
      rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply]
      exact e
    rw [hπ1] at e1
    rw [e1]
    exact hpU

theorem wc_finite_ext_geom_irred_cover : ∀ (k : Type u) [Field k] (T : Scheme.{u}) (h : T ⟶ Spec (.of k)) [LocallyOfFiniteType h] [QuasiCompact h], ∃ (L : Type u) (_ : Field L) (_ : Algebra k L), FiniteDimensional k L ∧ ∃ (n : ℕ) (Z : Fin n → Set ↥(Limits.pullback h (Spec.map (CommRingCat.ofHom (algebraMap k L))))), (∀ i, IsClosed (Z i)) ∧ (⋃ i, Z i) = Set.univ ∧ ∀ (i : Fin n) (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (t : Spec (.of Ω) ⟶ Spec (.of L)), IsIrreducible ((Limits.pullback.fst (Limits.pullback.snd h (Spec.map (CommRingCat.ofHom (algebraMap k L)))) t) ⁻¹' Z i) :=
by
  intro k _ T h _ _
  classical

  have s4 : ∀ (X : Type u) [TopologicalSpace X] [TopologicalSpace.NoetherianSpace X] (ι : Type u)
      [Preorder ι] (P : ι → Prop) (B : ι → Set X) (C : Set X), (∃ i, P i) →
      (∀ i j, P i → P j → ∃ l, P l ∧ i ≤ l ∧ j ≤ l) → (∀ i, P i → IsClosed (B i)) →
      (∀ i j, i ≤ j → B j ⊆ B i) → (∀ i, P i → C ⊆ B i) → (∀ x ∉ C, ∃ i, P i ∧ x ∉ B i) →
      ∃ i, P i ∧ B i = C := by
    intro X _ _ ι _ P B C hne hdir hcl hanti hsub hexc
    obtain ⟨i, hi⟩ := hne
    obtain ⟨O₀, ⟨i₀, hPi₀, hO₀⟩, hmin⟩ :=
      (wellFounded_gt (α := TopologicalSpace.Opens X)).has_min
        {O : TopologicalSpace.Opens X | ∃ i, P i ∧ (O : Set X) = (B i)ᶜ}
        ⟨⟨(B i)ᶜ, (hcl i hi).isOpen_compl⟩, i, hi, rfl⟩
    refine ⟨i₀, hPi₀, Set.Subset.antisymm ?_ (hsub i₀ hPi₀)⟩
    intro x hx
    by_contra hxC
    obtain ⟨j, hPj, hxj⟩ := hexc x hxC
    obtain ⟨l, hPl, hil, hjl⟩ := hdir i₀ j hPi₀ hPj
    apply hmin ⟨(B l)ᶜ, (hcl l hPl).isOpen_compl⟩ ⟨l, hPl, rfl⟩
    rw [SetLike.lt_iff_le_and_exists]
    refine ⟨fun y hy => ?_, x, fun hxl => hxj (hanti _ _ hjl hxl), fun hx0 => ?_⟩
    · have hy' : y ∈ (O₀ : Set X) := hy
      rw [hO₀] at hy'
      exact fun hyl => hy' (hanti _ _ hil hyl)
    · have hx' : x ∈ (O₀ : Set X) := hx0
      rw [hO₀] at hx'
      exact hx' hx

  have hSpec : ∀ {A B C : Type u} [CommRing A] [CommRing B] [CommRing C] (f : A →+* B)
      (g : B →+* C) (f' : A →+* C), g.comp f = f' →
      Spec.map (CommRingCat.ofHom g) ≫ Spec.map (CommRingCat.ofHom f) =
        Spec.map (CommRingCat.ofHom f') := by
    intro A B C _ _ _ f g f' hf
    subst hf
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]

  have s0 : ∀ (E F : Type u) [Field E] [Field F] [Algebra k E] [Algebra k F] [Algebra E F]
      [IsScalarTower k E F]
      (π : Limits.pullback h (Spec.map (CommRingCat.ofHom (algebraMap k F))) ⟶
        Limits.pullback h (Spec.map (CommRingCat.ofHom (algebraMap k E)))),
      π ≫ Limits.pullback.fst h (Spec.map (CommRingCat.ofHom (algebraMap k E))) =
        Limits.pullback.fst h (Spec.map (CommRingCat.ofHom (algebraMap k F))) →
      π ≫ Limits.pullback.snd h (Spec.map (CommRingCat.ofHom (algebraMap k E))) =
        Limits.pullback.snd h (Spec.map (CommRingCat.ofHom (algebraMap k F))) ≫
          Spec.map (CommRingCat.ofHom (algebraMap E F)) →
      IsPullback π (Limits.pullback.snd h (Spec.map (CommRingCat.ofHom (algebraMap k F))))
        (Limits.pullback.snd h (Spec.map (CommRingCat.ofHom (algebraMap k E))))
        (Spec.map (CommRingCat.ofHom (algebraMap E F))) := by
    intro E F _ _ _ _ _ _ π h1 h2
    have hcomp : Spec.map (CommRingCat.ofHom (algebraMap E F)) ≫
        Spec.map (CommRingCat.ofHom (algebraMap k E)) =
        Spec.map (CommRingCat.ofHom (algebraMap k F)) :=
      hSpec _ _ _ (IsScalarTower.algebraMap_eq k E F).symm
    refine IsPullback.of_right ?_ h2 (IsPullback.of_hasPullback h _)
    rw [h1, hcomp]
    exact IsPullback.of_hasPullback h _

  have s2 : ∀ (E F : Type u) [Field E] [Field F] [Algebra E F] [Algebra.IsAlgebraic E F]
      (P Y : Scheme.{u}) (π : P ⟶ Y) (f : P ⟶ Spec (.of F)) (g : Y ⟶ Spec (.of E)),
      IsPullback π f g (Spec.map (CommRingCat.ofHom (algebraMap E F))) →
      IsClosedMap π ∧ Function.Surjective π := by
    intro E F _ _ _ _ P Y π f g H
    have hI : IsIntegralHom (Spec.map (CommRingCat.ofHom (algebraMap E F))) := by
      rw [IsIntegralHom.SpecMap_iff]
      exact algebraMap_isIntegral_iff.mpr inferInstance
    have hS : Surjective (Spec.map (CommRingCat.ofHom (algebraMap E F))) :=
      ⟨fun _ => ⟨IsLocalRing.closedPoint F, Subsingleton.elim _ _⟩⟩
    haveI hI' : IsIntegralHom π := MorphismProperty.of_isPullback H.flip hI
    haveI hS' : Surjective π := MorphismProperty.of_isPullback H.flip hS
    exact ⟨π.isClosedMap, π.surjective⟩

  have s3 : ∀ (P Y A B : Scheme.{u}) (π : P ⟶ Y) (f : P ⟶ A) (g : Y ⟶ B) (e : A ⟶ B),
      IsPullback π f g e → ∀ (W : Scheme.{u}) (s : W ⟶ A) (t : W ⟶ B), s ≫ e = t →
      ∀ Z : Set ↥Y, IsIrreducible ((Limits.pullback.fst f s) ⁻¹' (π ⁻¹' Z)) →
      IsIrreducible ((Limits.pullback.fst g t) ⁻¹' Z) := by
    intro P Y A B π f g e H W s t hst Z hZ
    subst hst
    have H2 := IsPullback.paste_horiz (IsPullback.of_hasPullback f s) H
    have hc : ∀ x, Limits.pullback.fst g (s ≫ e) (H2.isoPullback.hom x) =
        π (Limits.pullback.fst f s x) := by
      intro x
      refine (Scheme.Hom.comp_apply H2.isoPullback.hom (Limits.pullback.fst g (s ≫ e)) x).symm.trans ?_
      rw [H2.isoPullback_hom_fst]
      exact Scheme.Hom.comp_apply _ _ x
    have key : (Limits.pullback.fst g (s ≫ e)) ⁻¹' Z =
        H2.isoPullback.hom '' ((Limits.pullback.fst f s) ⁻¹' (π ⁻¹' Z)) := by
      ext y
      constructor
      · intro hy
        refine ⟨H2.isoPullback.inv y, ?_, Scheme.inv_hom_apply _ y⟩
        show π (Limits.pullback.fst f s (H2.isoPullback.inv y)) ∈ Z
        rw [← hc, Scheme.inv_hom_apply]
        exact hy
      · rintro ⟨x, hx, rfl⟩
        show Limits.pullback.fst g (s ≫ e) (H2.isoPullback.hom x) ∈ Z
        rw [hc]
        exact hx
    rw [key]
    exact hZ.image _ (Scheme.Hom.continuous _).continuousOn

  have s3a : ∀ (E F Ω : Type u) [Field E] [Field F] [Field Ω] [IsAlgClosed Ω] [Algebra E F]
      [Algebra.IsAlgebraic E F] (t : Spec (.of Ω) ⟶ Spec (.of E)),
      ∃ s : Spec (.of Ω) ⟶ Spec (.of F), s ≫ Spec.map (CommRingCat.ofHom (algebraMap E F)) = t := by
    intro E F Ω _ _ _ _ _ _ t
    obtain ⟨φ, rfl⟩ := Spec.map_surjective t
    letI : Algebra E Ω := φ.hom.toAlgebra
    let ψ : F →ₐ[E] Ω := IsAlgClosed.lift
    refine ⟨Spec.map (CommRingCat.ofHom ψ.toRingHom), ?_⟩
    rw [hSpec (algebraMap E F) ψ.toRingHom φ.hom (RingHom.ext fun x => ψ.commutes x)]
    rfl

  obtain ⟨K, _, _, hKac, hKalg⟩ : ∃ (K : Type u) (_ : Field K) (_ : Algebra k K),
      IsAlgClosed K ∧ Algebra.IsAlgebraic k K :=
    ⟨AlgebraicClosure k, inferInstance, inferInstance, inferInstance, inferInstance⟩
  haveI := hKac
  haveI := hKalg

  have s5 : ∀ (E E' : IntermediateField k K), E ≤ E' →
      ∀ (π : Limits.pullback h (Spec.map (CommRingCat.ofHom (algebraMap k K))) ⟶
        Limits.pullback h (Spec.map (CommRingCat.ofHom (algebraMap k E))))
      (π' : Limits.pullback h (Spec.map (CommRingCat.ofHom (algebraMap k K))) ⟶
        Limits.pullback h (Spec.map (CommRingCat.ofHom (algebraMap k E')))),
      π ≫ Limits.pullback.fst h (Spec.map (CommRingCat.ofHom (algebraMap k E))) =
        Limits.pullback.fst h (Spec.map (CommRingCat.ofHom (algebraMap k K))) →
      π ≫ Limits.pullback.snd h (Spec.map (CommRingCat.ofHom (algebraMap k E))) =
        Limits.pullback.snd h (Spec.map (CommRingCat.ofHom (algebraMap k K))) ≫
          Spec.map (CommRingCat.ofHom (algebraMap E K)) →
      π' ≫ Limits.pullback.fst h (Spec.map (CommRingCat.ofHom (algebraMap k E'))) =
        Limits.pullback.fst h (Spec.map (CommRingCat.ofHom (algebraMap k K))) →
      π' ≫ Limits.pullback.snd h (Spec.map (CommRingCat.ofHom (algebraMap k E'))) =
        Limits.pullback.snd h (Spec.map (CommRingCat.ofHom (algebraMap k K))) ≫
          Spec.map (CommRingCat.ofHom (algebraMap E' K)) →
      ∀ x y, π' x = π' y → π x = π y := by
    intro E E' hle π π' h1 h2 h1' h2' x y hxy
    have hε : Spec.map (CommRingCat.ofHom (IntermediateField.inclusion hle).toRingHom) ≫
        Spec.map (CommRingCat.ofHom (algebraMap k E)) =
        Spec.map (CommRingCat.ofHom (algebraMap k E')) :=
      hSpec _ _ _ (RingHom.ext fun a => (IntermediateField.inclusion hle).commutes a)
    have hεK : Spec.map (CommRingCat.ofHom (algebraMap E' K)) ≫
        Spec.map (CommRingCat.ofHom (IntermediateField.inclusion hle).toRingHom) =
        Spec.map (CommRingCat.ofHom (algebraMap E K)) :=
      hSpec _ _ _ (RingHom.ext fun a => rfl)
    obtain ⟨ρ, hρ1, hρ2⟩ : ∃ ρ : Limits.pullback h (Spec.map (CommRingCat.ofHom (algebraMap k E'))) ⟶
        Limits.pullback h (Spec.map (CommRingCat.ofHom (algebraMap k E))),
        ρ ≫ Limits.pullback.fst h (Spec.map (CommRingCat.ofHom (algebraMap k E))) =
          Limits.pullback.fst h (Spec.map (CommRingCat.ofHom (algebraMap k E'))) ∧
        ρ ≫ Limits.pullback.snd h (Spec.map (CommRingCat.ofHom (algebraMap k E))) =
          Limits.pullback.snd h (Spec.map (CommRingCat.ofHom (algebraMap k E'))) ≫
            Spec.map (CommRingCat.ofHom (IntermediateField.inclusion hle).toRingHom) :=
      ⟨Limits.pullback.lift (Limits.pullback.fst _ _)
        (Limits.pullback.snd _ _ ≫ Spec.map (CommRingCat.ofHom (IntermediateField.inclusion hle).toRingHom))
        (by rw [Category.assoc, hε, Limits.pullback.condition]),
        Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
    have hfac : π = π' ≫ ρ := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, hρ1, h1, h1']
      · rw [Category.assoc, hρ2, ← Category.assoc, h2', Category.assoc, hεK, h2]
    rw [hfac, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply, hxy]

  have s6 : ∀ (R : Type u) [CommRing R] [Algebra k R] (f : TensorProduct k R K),
      ∃ L₀ : IntermediateField k K, FiniteDimensional k L₀ ∧ ∀ L : IntermediateField k K, L₀ ≤ L →
        ∃ g : TensorProduct k R L, Algebra.TensorProduct.map (AlgHom.id k R) L.val g = f := by
    intro R _ _ f
    induction f using TensorProduct.induction_on with
    | zero => exact ⟨⊥, inferInstance, fun L _ => ⟨0, map_zero _⟩⟩
    | tmul r a =>
      refine ⟨IntermediateField.adjoin k {a},
        IntermediateField.adjoin.finiteDimensional (Algebra.IsIntegral.isIntegral a), fun L hL => ?_⟩
      have ha : a ∈ L := hL (IntermediateField.subset_adjoin k {a} (Set.mem_singleton a))
      exact ⟨r ⊗ₜ ⟨a, ha⟩, by simp [Algebra.TensorProduct.map_tmul]⟩
    | add f₁ f₂ ih₁ ih₂ =>
      obtain ⟨L₁, hL₁, H₁⟩ := ih₁
      obtain ⟨L₂, hL₂, H₂⟩ := ih₂
      refine ⟨L₁ ⊔ L₂, by haveI := hL₁; haveI := hL₂; infer_instance, fun L hL => ?_⟩
      obtain ⟨g₁, hg₁⟩ := H₁ L (le_sup_left.trans hL)
      obtain ⟨g₂, hg₂⟩ := H₂ L (le_sup_right.trans hL)
      exact ⟨g₁ + g₂, by rw [map_add, hg₁, hg₂]⟩

  have hsep := wc_fe_global_closed_separation k K T h (wc_fe_affine_closed_separation k K s6)

  haveI : IsLocallyNoetherian (Limits.pullback h (Spec.map (CommRingCat.ofHom (algebraMap k K)))) :=
    LocallyOfFiniteType.isLocallyNoetherian
      (Limits.pullback.snd h (Spec.map (CommRingCat.ofHom (algebraMap k K))))
  haveI : CompactSpace ↥(Limits.pullback h (Spec.map (CommRingCat.ofHom (algebraMap k K)))) :=
    QuasiCompact.compactSpace_of_compactSpace
      (Limits.pullback.snd h (Spec.map (CommRingCat.ofHom (algebraMap k K))))
  haveI : AlgebraicGeometry.IsNoetherian
      (Limits.pullback h (Spec.map (CommRingCat.ofHom (algebraMap k K)))) :=
    AlgebraicGeometry.IsNoetherian.mk

  obtain ⟨n, C, hCcl, hCirr, hCcov⟩ : ∃ (n : ℕ)
      (C : Fin n → Set ↥(Limits.pullback h (Spec.map (CommRingCat.ofHom (algebraMap k K))))),
      (∀ i, IsClosed (C i)) ∧ (∀ i, IsIrreducible (C i)) ∧ ∀ x, ∃ i, x ∈ C i := by
    have hfin := TopologicalSpace.NoetherianSpace.finite_irreducibleComponents
      (α := ↥(Limits.pullback h (Spec.map (CommRingCat.ofHom (algebraMap k K)))))
    haveI := hfin.to_subtype
    obtain ⟨n, ⟨e⟩⟩ : ∃ n, Nonempty (irreducibleComponents
        ↥(Limits.pullback h (Spec.map (CommRingCat.ofHom (algebraMap k K)))) ≃ Fin n) :=
      ⟨_, ⟨Finite.equivFin _⟩⟩
    refine ⟨n, fun i => ((e.symm i : irreducibleComponents _) : Set _),
      fun i => isClosed_of_mem_irreducibleComponents _ (e.symm i).2,
      fun i => (e.symm i).2.1,
      fun x => ⟨e ⟨irreducibleComponent x, irreducibleComponent_mem_irreducibleComponents x⟩, ?_⟩⟩
    simp only [Equiv.symm_apply_apply]
    exact mem_irreducibleComponent

  have hKL : ∀ L : IntermediateField k K, Spec.map (CommRingCat.ofHom (algebraMap L K)) ≫
      Spec.map (CommRingCat.ofHom (algebraMap k L)) = Spec.map (CommRingCat.ofHom (algebraMap k K)) :=
    fun L => hSpec _ _ _ (IsScalarTower.algebraMap_eq k L K).symm
  obtain ⟨πc, hπ1, hπ2⟩ : ∃ πc : ∀ L : IntermediateField k K,
      Limits.pullback h (Spec.map (CommRingCat.ofHom (algebraMap k K))) ⟶
        Limits.pullback h (Spec.map (CommRingCat.ofHom (algebraMap k L))),
      (∀ L, πc L ≫ Limits.pullback.fst h (Spec.map (CommRingCat.ofHom (algebraMap k L))) =
        Limits.pullback.fst h (Spec.map (CommRingCat.ofHom (algebraMap k K)))) ∧
      (∀ L, πc L ≫ Limits.pullback.snd h (Spec.map (CommRingCat.ofHom (algebraMap k L))) =
        Limits.pullback.snd h (Spec.map (CommRingCat.ofHom (algebraMap k K))) ≫
          Spec.map (CommRingCat.ofHom (algebraMap L K))) :=
    ⟨fun L => Limits.pullback.lift (Limits.pullback.fst _ _)
        (Limits.pullback.snd _ _ ≫ Spec.map (CommRingCat.ofHom (algebraMap L K)))
        (by rw [Category.assoc, hKL L, Limits.pullback.condition]),
      fun L => Limits.pullback.lift_fst _ _ _, fun L => Limits.pullback.lift_snd _ _ _⟩
  have hPB : ∀ L : IntermediateField k K, IsPullback (πc L)
      (Limits.pullback.snd h (Spec.map (CommRingCat.ofHom (algebraMap k K))))
      (Limits.pullback.snd h (Spec.map (CommRingCat.ofHom (algebraMap k L))))
      (Spec.map (CommRingCat.ofHom (algebraMap L K))) :=
    fun L => s0 L K (πc L) (hπ1 L) (hπ2 L)
  have hcs : ∀ L : IntermediateField k K, IsClosedMap (πc L) ∧ Function.Surjective (πc L) :=
    fun L => s2 L K _ _ (πc L) _ _ (hPB L)
  have hanti : ∀ (D : Set ↥(Limits.pullback h (Spec.map (CommRingCat.ofHom (algebraMap k K)))))
      (L L' : IntermediateField k K), L ≤ L' →
      πc L' ⁻¹' (πc L' '' D) ⊆ πc L ⁻¹' (πc L '' D) := by
    rintro D L L' hle x ⟨y, hy, hxy⟩
    exact ⟨y, hy, s5 L L' hle (πc L) (πc L') (hπ1 L) (hπ2 L) (hπ1 L') (hπ2 L') y x hxy⟩

  have hdesc : ∀ i, ∃ L : IntermediateField k K, FiniteDimensional k L ∧
      πc L ⁻¹' (πc L '' C i) = C i := by
    intro i
    refine s4 _ (IntermediateField k K) (fun L => FiniteDimensional k L)
      (fun L => πc L ⁻¹' (πc L '' C i)) (C i) ⟨⊥, inferInstance⟩
      (fun L L' hL hL' => ⟨L ⊔ L', by haveI := hL; haveI := hL'; infer_instance,
        le_sup_left, le_sup_right⟩)
      (fun L _ => ((hcs L).1 _ (hCcl i)).preimage (Scheme.Hom.continuous _))
      (fun L L' hle => hanti (C i) L L' hle) (fun L _ => Set.subset_preimage_image _ _) ?_
    intro x hx
    obtain ⟨L₀, hL₀, H⟩ := hsep (C i) (hCcl i) x hx
    refine ⟨L₀, hL₀, ?_⟩
    rintro ⟨y, hy, hyx⟩
    exact H L₀ le_rfl (πc L₀) (hπ1 L₀) (hπ2 L₀) y hy hyx
  choose Lf hLf hLeq using hdesc
  haveI : ∀ i, FiniteDimensional k (Lf i) := hLf
  have hLfin : FiniteDimensional k ↥(⨆ i, Lf i) :=
    IntermediateField.finiteDimensional_iSup_of_finite
  have hB : ∀ i, πc (⨆ i, Lf i) ⁻¹' (πc (⨆ i, Lf i) '' C i) = C i := fun i =>
    Set.Subset.antisymm ((hanti _ _ _ (le_iSup Lf i)).trans (hLeq i).le)
      (Set.subset_preimage_image _ _)
  refine ⟨↥(⨆ i, Lf i), inferInstance, inferInstance, hLfin, n,
    fun i => πc (⨆ i, Lf i) '' C i, fun i => (hcs _).1 _ (hCcl i), ?_, ?_⟩
  · rw [← Set.image_iUnion, Set.iUnion_eq_univ_iff.mpr hCcov,
      Set.image_univ_of_surjective (hcs _).2]
  · intro i Ω _ _ t
    obtain ⟨s, hs⟩ := s3a ↥(⨆ i, Lf i) K Ω t
    have h1 := wc_fe_irreducible_closed_geom K
      (Limits.pullback h (Spec.map (CommRingCat.ofHom (algebraMap k K))))
      (Limits.pullback.snd h (Spec.map (CommRingCat.ofHom (algebraMap k K)))) (C i) (hCcl i)
      (hCirr i) Ω s
    rw [← hB i] at h1
    exact s3 _ _ _ _ (πc (⨆ i, Lf i)) _ _ _ (hPB _) _ s t hs _ h1

theorem wc_spread_finite_ext_generic : ∀ (S : Scheme.{u}) [IsIntegral S] [IsLocallyNoetherian S] (L : Type u) [Field L] [Algebra (S.residueField (genericPoint S)) L] [FiniteDimensional (S.residueField (genericPoint S)) L], ∃ (U Y' : Scheme.{u}) (ι : U ⟶ S) (q₀ : Y' ⟶ U), IsOpenImmersion ι ∧ genericPoint S ∈ Set.range ι ∧ IsFinite q₀ ∧ Surjective q₀ ∧ IsIntegral Y' ∧ AlgebraicGeometry.IsNoetherian Y' ∧ ∃ (_ : IsIntegral Y'), (∀ y' : Y', ι (q₀ y') = genericPoint S → y' = genericPoint Y') ∧ ∃ e : Y'.residueField (genericPoint Y') ⟶ CommRingCat.of L, IsIso e ∧ Spec.map e ≫ Y'.fromSpecResidueField (genericPoint Y') ≫ q₀ ≫ ι = Spec.map (CommRingCat.ofHom (algebraMap (S.residueField (genericPoint S)) L)) ≫ S.fromSpecResidueField (genericPoint S) :=
by

  have s5 : ∀ (X : Scheme.{u}) (U : X.Opens) (hU : IsAffineOpen U) (x : X) (hx : x ∈ U),
      Spec.map (X.evaluation U x hx) ≫ hU.fromSpec = X.fromSpecResidueField x := by
    intro X U hU x hx
    rw [Scheme.fromSpecResidueField, ← hU.fromSpecStalk_eq_fromSpecStalk hx,
      IsAffineOpen.fromSpecStalk, ← Category.assoc, ← Spec.map_comp, Scheme.germ_residue]

  have s6 : ∀ (X : Scheme.{u}) [IsIntegral X] (U : X.Opens), IsAffineOpen U →
      ∀ (h : genericPoint X ∈ U) [Algebra Γ(X, U) (X.residueField (genericPoint X))],
      algebraMap Γ(X, U) (X.residueField (genericPoint X)) = (X.evaluation U (genericPoint X) h).hom →
      IsFractionRing Γ(X, U) (X.residueField (genericPoint X)) := by
    intro X _ U hU h _ halg
    haveI : Nonempty U := ⟨⟨_, h⟩⟩
    haveI := functionField_isFractionRing_of_isAffineOpen X U hU
    let r := (X.residue (genericPoint X)).hom
    have hbij : Function.Bijective r := ⟨RingHom.injective r, Scheme.residue_surjective _ _⟩
    let E0 := RingEquiv.ofBijective r hbij
    have hcomm : ∀ a : Γ(X, U), E0 (algebraMap Γ(X, U) X.functionField a) =
        algebraMap Γ(X, U) (X.residueField (genericPoint X)) a := by
      intro a
      rw [halg, ← Scheme.germ_residue]
      rfl
    let E : X.functionField ≃ₐ[Γ(X, U)] X.residueField (genericPoint X) :=
      AlgEquiv.ofRingEquiv (f := E0) hcomm
    exact IsLocalization.isLocalization_of_algEquiv (nonZeroDivisors _) E

  have s3 : ∀ (A B : CommRingCat.{u}) [IsDomain A] [IsDomain B] (f : A ⟶ B), f.hom.Finite →
      Function.Injective f.hom → IsFinite (Spec.map f) ∧ Surjective (Spec.map f) ∧
      ∀ y : Spec B, Spec.map f y = genericPoint (Spec A) → y = genericPoint (Spec B) := by
    intro A B _ _ f hfin hinj
    refine ⟨(IsFinite.SpecMap_iff f).mpr hfin, ?_, ?_⟩
    · letI := f.hom.toAlgebra
      haveI : Module.Finite A B := hfin
      haveI : Algebra.IsIntegral A B := Algebra.IsIntegral.of_finite A B
      haveI : FaithfulSMul A B := (faithfulSMul_iff_algebraMap_injective A B).mpr hinj
      refine ⟨fun x => ?_⟩
      obtain ⟨y, hy⟩ := Algebra.IsIntegral.comap_surjective (R := A) (S := B) x
      exact ⟨y, hy⟩
    · intro y hy
      letI := f.hom.toAlgebra
      haveI : Module.Finite A B := hfin
      haveI : Algebra.IsIntegral A B := Algebra.IsIntegral.of_finite A B
      rw [genericPoint_eq_bot_of_affine] at hy ⊢
      have h1 : Ideal.comap f.hom y.asIdeal = ⊥ := by
        have := congrArg PrimeSpectrum.asIdeal hy
        exact this
      have h2 : Ideal.under A y.asIdeal = ⊥ := by
        rw [Ideal.under_def]; exact h1
      exact PrimeSpectrum.ext (Ideal.eq_bot_of_under_eq_bot h2)

  have s2 : ∀ (A K L : Type u) [CommRing A] [IsDomain A] [Field K] [Field L] [Algebra A K]
      [IsFractionRing A K] [Algebra K L] [FiniteDimensional K L] [Algebra A L] [IsScalarTower A K L],
      ∃ A' : Subalgebra A L, Module.Finite A A' ∧ ∀ z : L, ∃ a : A, a ≠ 0 ∧ algebraMap A L a * z ∈ A' := by
    intro A K L _ _ _ _ _ _ _ _ _ _
    classical
    let b := Module.finBasis K L
    obtain ⟨y, hy0, hyint⟩ := exists_integral_multiples A K (Finset.univ.image b)
    let A' := Algebra.adjoin A (Set.range (fun i => y • b i))
    refine ⟨A', ?_, ?_⟩
    · exact Algebra.finite_adjoin_of_finite_of_isIntegral (Set.finite_range _)
        (by rintro _ ⟨i, rfl⟩; exact hyint _ (Finset.mem_image_of_mem _ (Finset.mem_univ i)))
    · intro z
      obtain ⟨d, hd⟩ := IsLocalization.exist_integer_multiples (nonZeroDivisors A) Finset.univ
        (fun i => b.repr z i)
      choose a ha using fun i => hd i (Finset.mem_univ i)
      refine ⟨d * y, mul_ne_zero (nonZeroDivisors.ne_zero d.2) hy0, ?_⟩
      have hz : z = ∑ i, b.repr z i • b i := (b.sum_repr z).symm
      have key : algebraMap A L (d * y) * z = ∑ i, algebraMap A L (a i) * (y • b i) := by
        conv_lhs => rw [hz]
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl (fun i _ => ?_)
        have hai : algebraMap A K (a i) = (d : A) • b.repr z i := ha i
        have e1 : algebraMap A L (a i) = algebraMap K L (algebraMap A K (a i)) :=
          IsScalarTower.algebraMap_apply A K L (a i)
        have e2 : algebraMap A L (d : A) = algebraMap K L (algebraMap A K (d : A)) :=
          IsScalarTower.algebraMap_apply A K L _
        rw [e1, hai, Algebra.smul_def, Algebra.smul_def, Algebra.smul_def, map_mul, map_mul, e2]
        ring
      rw [key]
      exact Subalgebra.sum_mem _ (fun i _ => Subalgebra.mul_mem _ (Subalgebra.algebraMap_mem _ _)
        (Algebra.subset_adjoin ⟨i, rfl⟩))

  have s4 : ∀ (B L : Type u) [CommRing B] [IsDomain B] [Field L] (j : B →+* L),
      Function.Injective j → (∀ z : L, ∃ x y : B, y ≠ 0 ∧ j y * z = j x) →
      ∃ e : (Spec (.of B)).residueField (genericPoint (Spec (.of B))) ⟶ CommRingCat.of L,
        IsIso e ∧ Spec.map e ≫ (Spec (.of B)).fromSpecResidueField (genericPoint (Spec (.of B))) =
          Spec.map (CommRingCat.ofHom j) := by
    intro B L _ _ _ j hj hfr
    have h : genericPoint (Spec (.of B)) =
        (Spec.map (CommRingCat.ofHom j)) (IsLocalRing.closedPoint L) := by
      rw [genericPoint_eq_bot_of_affine]
      apply PrimeSpectrum.ext
      change (⊥ : Ideal B) = Ideal.comap j (IsLocalRing.maximalIdeal L)
      rw [IsLocalRing.maximalIdeal_eq_bot, Ideal.comap_bot_of_injective j hj]
    let d := Scheme.descResidueField (Scheme.stalkClosedPointTo (Spec.map (CommRingCat.ofHom j)))
    let e := (Scheme.residueFieldCongr h).hom ≫ d
    have heq : Spec.map e ≫ (Spec (.of B)).fromSpecResidueField (genericPoint (Spec (.of B))) =
        Spec.map (CommRingCat.ofHom j) := by
      simp only [e, Spec.map_comp, Category.assoc, Scheme.residueFieldCongr_fromSpecResidueField]
      exact Scheme.descResidueField_stalkClosedPointTo_fromSpecResidueField L _ _
    refine ⟨e, ?_, heq⟩
    have h5 := s5 (Spec (.of B)) ⊤ (isAffineOpen_top _) (genericPoint (Spec (.of B))) trivial
    rw [IsAffineOpen.fromSpec_top, Scheme.isoSpec_Spec_inv] at h5
    have hcomp : (Scheme.ΓSpecIso (.of B)).inv ≫
        (Spec (.of B)).evaluation ⊤ (genericPoint (Spec (.of B))) trivial ≫ e
        = CommRingCat.ofHom j := by
      apply Spec.map_injective
      rw [Spec.map_comp, Spec.map_comp, Category.assoc, h5, heq]
    let φ := ((Scheme.ΓSpecIso (.of B)).inv ≫
      (Spec (.of B)).evaluation ⊤ (genericPoint (Spec (.of B))) trivial).hom
    have hφ : ∀ b : B, e.hom (φ b) = j b := by
      intro b
      have := congrArg (fun g => g.hom b) hcomp
      simpa [φ] using this
    rw [ConcreteCategory.isIso_iff_bijective]
    refine ⟨RingHom.injective e.hom, fun z => ?_⟩
    obtain ⟨x, y, hy0, hxy⟩ := hfr z
    have hjy : j y ≠ 0 := (map_ne_zero_iff j hj).mpr hy0
    have hz : z = j x / j y := eq_div_of_mul_eq hjy (by rw [mul_comm]; exact hxy)
    refine ⟨φ x / φ y, ?_⟩
    change e.hom (φ x / φ y) = z
    rw [map_div₀, hφ, hφ, hz]

  intro S _ _ L _ _ _
  classical
  obtain ⟨x⟩ := (inferInstance : Nonempty S)
  obtain ⟨O, hO, hxO, -⟩ := exists_isAffineOpen_mem_and_subset (x := x) (U := ⊤) trivial
  haveI : Nonempty O := ⟨⟨x, hxO⟩⟩
  have hη : genericPoint S ∈ O :=
    (genericPoint_spec S).mem_open_set_iff O.isOpen |>.mpr ⟨x, trivial, hxO⟩
  haveI : IsNoetherianRing Γ(S, O) := IsLocallyNoetherian.component_noetherian ⟨O, hO⟩
  let ev := S.evaluation O (genericPoint S) hη
  letI : Algebra Γ(S, O) (S.residueField (genericPoint S)) := ev.hom.toAlgebra
  letI : Algebra Γ(S, O) L :=
    ((algebraMap (S.residueField (genericPoint S)) L).comp ev.hom).toAlgebra
  haveI : IsScalarTower Γ(S, O) (S.residueField (genericPoint S)) L :=
    IsScalarTower.of_algebraMap_eq' rfl
  haveI : IsFractionRing Γ(S, O) (S.residueField (genericPoint S)) := s6 S O hO hη rfl
  obtain ⟨A', hA'fin, hden⟩ := s2 Γ(S, O) (S.residueField (genericPoint S)) L
  haveI := hA'fin
  haveI : IsNoetherianRing A' := IsNoetherianRing.of_finite Γ(S, O) A'
  have hinjL : Function.Injective (algebraMap Γ(S, O) L) :=
    (RingHom.injective (algebraMap (S.residueField (genericPoint S)) L)).comp
      (IsFractionRing.injective Γ(S, O) (S.residueField (genericPoint S)))
  have hinj : Function.Injective (algebraMap Γ(S, O) A') := by
    intro a b hab
    apply hinjL
    have := congrArg Subtype.val hab
    simpa using this
  obtain ⟨hfin, hsurj, huniq₀⟩ := s3 Γ(S, O) (CommRingCat.of A')
    (CommRingCat.ofHom (algebraMap Γ(S, O) A')) ((RingHom.finite_algebraMap).mpr hA'fin) hinj
  have huniq : ∀ y' : Spec (CommRingCat.of A'),
      hO.fromSpec (Spec.map (CommRingCat.ofHom (algebraMap Γ(S, O) A')) y') = genericPoint S →
      y' = genericPoint (Spec (CommRingCat.of A')) := by
    intro y' hy'
    apply huniq₀
    apply hO.fromSpec.isOpenEmbedding.isEmbedding.injective
    rw [hy', genericPoint_eq_of_isOpenImmersion]
  let j : A' →+* L := A'.val.toRingHom
  have hj : Function.Injective j := Subtype.val_injective
  have hfr : ∀ z : L, ∃ x y : A', y ≠ 0 ∧ j y * z = j x := by
    intro z
    obtain ⟨a, ha0, haz⟩ := hden z
    refine ⟨⟨_, haz⟩, algebraMap Γ(S, O) A' a, ?_, rfl⟩
    intro h0
    exact ha0 (hinj (by rw [h0, map_zero]))
  obtain ⟨e, he, he4⟩ := s4 A' L j hj hfr
  have hjc : j.comp (algebraMap Γ(S, O) A') =
      (algebraMap (S.residueField (genericPoint S)) L).comp ev.hom := by
    ext a; rfl
  have hsq : Spec.map e ≫ (Spec (CommRingCat.of A')).fromSpecResidueField
      (genericPoint (Spec (CommRingCat.of A'))) ≫
      Spec.map (CommRingCat.ofHom (algebraMap Γ(S, O) A')) ≫ hO.fromSpec =
      Spec.map (CommRingCat.ofHom (algebraMap (S.residueField (genericPoint S)) L)) ≫
        S.fromSpecResidueField (genericPoint S) := by
    rw [← Category.assoc, he4, ← Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp, hjc,
      CommRingCat.ofHom_comp, CommRingCat.ofHom_hom, Spec.map_comp, Category.assoc,
      s5 S O hO (genericPoint S) hη]
  exact ⟨Spec Γ(S, O), Spec (CommRingCat.of A'), hO.fromSpec,
    Spec.map (CommRingCat.ofHom (algebraMap Γ(S, O) A')), inferInstance,
    by rw [hO.range_fromSpec]; exact hη, hfin, hsurj, inferInstance, inferInstance, inferInstance,
    huniq, e, he, hsq⟩

theorem wc_transport_generic_cover : ∀ (S X Y' : Scheme.{u}) (g : X ⟶ S) (b : Y' ⟶ S) (η : S) (η' : Y') (L : Type u) [Field L] [Algebra (S.residueField η) L] (e : Y'.residueField η' ⟶ CommRingCat.of L), IsIso e → Spec.map e ≫ Y'.fromSpecResidueField η' ≫ b = Spec.map (CommRingCat.ofHom (algebraMap (S.residueField η) L)) ≫ S.fromSpecResidueField η → ∀ (n : ℕ) (Z₀ : Fin n → Set ↥(Limits.pullback (Limits.pullback.snd g (S.fromSpecResidueField η)) (Spec.map (CommRingCat.ofHom (algebraMap (S.residueField η) L))))), (∀ i, IsClosed (Z₀ i)) → (⋃ i, Z₀ i) = Set.univ → (∀ (i : Fin n) (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (t : Spec (.of Ω) ⟶ Spec (.of L)), IsIrreducible ((Limits.pullback.fst (Limits.pullback.snd (Limits.pullback.snd g (S.fromSpecResidueField η)) (Spec.map (CommRingCat.ofHom (algebraMap (S.residueField η) L)))) t) ⁻¹' Z₀ i)) → ∃ Z : Fin n → Set ↥(Limits.pullback g b), (∀ i, IsClosed (Z i)) ∧ (∀ x : ↥(Limits.pullback g b), Limits.pullback.snd g b x = η' → ∃ i, x ∈ Z i) ∧ ∀ (i : Fin n) (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (t : Spec (.of Ω) ⟶ Y'), t (IsLocalRing.closedPoint Ω) = η' → IsIrreducible ((Limits.pullback.fst (Limits.pullback.snd g b) t) ⁻¹' Z i) :=
by

  have s1 : ∀ (Y : Scheme.{u}) (y : Y) (L : Type u) [Field L]
      (e : Y.residueField y ⟶ CommRingCat.of L), IsIso e → ∀ (Ω : Type u) [Field Ω]
      (t : Spec (.of Ω) ⟶ Y), t (IsLocalRing.closedPoint Ω) = y →
      ∃ t' : Spec (.of Ω) ⟶ Spec (.of L), t' ≫ Spec.map e ≫ Y.fromSpecResidueField y = t := by
    intro Y y L _ e he Ω _ t ht
    haveI := he
    obtain ⟨⟨x, φ⟩, hxφ⟩ : ∃ q, Scheme.SpecToEquivOfField Ω Y t = q := ⟨_, rfl⟩
    have htq : t = Spec.map φ ≫ Y.fromSpecResidueField x := by
      have := (Scheme.SpecToEquivOfField Ω Y).symm_apply_apply t
      rw [hxφ, Scheme.SpecToEquivOfField_symm_apply] at this
      exact this.symm
    have hxy : x = y := by
      rw [← ht, htq]
      exact (Scheme.fromSpecResidueField_apply x _).symm
    subst hxy htq
    refine ⟨Spec.map (inv e ≫ φ), ?_⟩
    rw [← Category.assoc, ← Spec.map_comp, IsIso.hom_inv_id_assoc]

  have s2 : ∀ {X S T T' Y' : Scheme.{u}} (g : X ⟶ S) (c : T ⟶ S) (a : T' ⟶ T) (b : Y' ⟶ S)
      (j : T' ⟶ Y'), j ≫ b = a ≫ c →
      ∃ ρ : Limits.pullback (Limits.pullback.snd g c) a ⟶ Limits.pullback g b,
        IsPullback ρ (Limits.pullback.snd (Limits.pullback.snd g c) a)
          (Limits.pullback.snd g b) j := by
    intro X S T T' Y' g c a b j hjb
    let i : Limits.pullback (Limits.pullback.snd g c) a ≅
        Limits.pullback (Limits.pullback.snd g b) j :=
      Limits.pullbackLeftPullbackSndIso g c a ≪≫ Limits.pullback.congrHom rfl hjb.symm ≪≫
        (Limits.pullbackLeftPullbackSndIso g b j).symm
    have hi : i.hom ≫ Limits.pullback.snd (Limits.pullback.snd g b) j =
        Limits.pullback.snd (Limits.pullback.snd g c) a := by
      simp only [i, Iso.trans_hom, Iso.symm_hom, Category.assoc,
        Limits.pullbackLeftPullbackSndIso_inv_snd_snd, Limits.pullback.congrHom_hom]
      rw [Limits.pullback.lift_snd, Category.comp_id,
        Limits.pullbackLeftPullbackSndIso_hom_snd]
    refine ⟨i.hom ≫ Limits.pullback.fst _ _, ?_⟩
    refine IsPullback.of_iso_pullback ⟨?_⟩ i rfl hi
    rw [Category.assoc, Limits.pullback.condition, ← Category.assoc, hi]

  have s3 : ∀ {P X' T Y' : Scheme.{u}} (ρ : P ⟶ X') (p : P ⟶ T) (f' : X' ⟶ Y') (j : T ⟶ Y'),
      IsPreimmersion j → IsPullback ρ p f' j →
      Topology.IsEmbedding ρ ∧ Set.range ρ = f' ⁻¹' Set.range j := by
    intro P X' T Y' ρ p f' j hj H
    haveI := hj
    have e1 : H.isoPullback.hom ≫ Limits.pullback.fst f' j = ρ := H.isoPullback_hom_fst
    haveI : IsPreimmersion (H.isoPullback.hom ≫ Limits.pullback.fst f' j) := inferInstance
    constructor
    · rw [← e1]; exact Scheme.Hom.isEmbedding _
    · rw [← e1, ← Scheme.Pullback.range_fst]
      ext x
      constructor
      · rintro ⟨w, rfl⟩
        exact ⟨H.isoPullback.hom w, (Scheme.Hom.comp_apply _ _ w).symm⟩
      · rintro ⟨w, rfl⟩
        refine ⟨H.isoPullback.inv w, ?_⟩
        rw [← Scheme.Hom.comp_apply, ← Category.assoc, Iso.inv_hom_id, Category.id_comp]

  have s4 : ∀ {P X' T Y' W : Scheme.{u}} (ρ : P ⟶ X') (p : P ⟶ T) (f' : X' ⟶ Y') (j : T ⟶ Y'),
      IsPullback ρ p f' j → ∀ (t' : W ⟶ T) (Z : Set ↥X'),
      IsIrreducible ((Limits.pullback.fst p t') ⁻¹' (ρ ⁻¹' Z)) →
      IsIrreducible ((Limits.pullback.fst f' (t' ≫ j)) ⁻¹' Z) := by
    intro P X' T Y' W ρ p f' j H t' Z hirr
    have H' := (IsPullback.of_hasPullback p t').paste_horiz H
    have e1 : H'.isoPullback.hom ≫ Limits.pullback.fst f' (t' ≫ j) =
        Limits.pullback.fst p t' ≫ ρ := H'.isoPullback_hom_fst
    let φ := Scheme.homeoOfIso H'.isoPullback
    have hφ : ∀ x, Limits.pullback.fst f' (t' ≫ j) (φ x) = ρ (Limits.pullback.fst p t' x) := by
      intro x
      show Limits.pullback.fst f' (t' ≫ j) (H'.isoPullback.hom x) = _
      rw [← Scheme.Hom.comp_apply, e1, Scheme.Hom.comp_apply]
    have hset : (Limits.pullback.fst f' (t' ≫ j)) ⁻¹' Z =
        φ '' ((Limits.pullback.fst p t') ⁻¹' (ρ ⁻¹' Z)) := by
      ext y
      constructor
      · intro hy
        refine ⟨φ.symm y, ?_, φ.apply_symm_apply y⟩
        show ρ (Limits.pullback.fst p t' (φ.symm y)) ∈ Z
        rw [← hφ, φ.apply_symm_apply]
        exact hy
      · rintro ⟨x, hx, rfl⟩
        show _ ∈ Z
        rw [hφ]
        exact hx
    rw [hset]
    exact hirr.image φ φ.continuous.continuousOn

  intro S X Y' g b η η' L _ _ e he hcompat n Z₀ hZ₀cl hZ₀cov hZ₀irr
  haveI : IsIso e := he
  have hjb : (Spec.map e ≫ Y'.fromSpecResidueField η') ≫ b =
      Spec.map (CommRingCat.ofHom (algebraMap (S.residueField η) L)) ≫
        S.fromSpecResidueField η := (Category.assoc _ _ _).trans hcompat
  obtain ⟨ρ, H⟩ := s2 g (S.fromSpecResidueField η)
    (Spec.map (CommRingCat.ofHom (algebraMap (S.residueField η) L))) b _ hjb
  obtain ⟨hemb, hrange⟩ := s3 ρ _ _ _ inferInstance H
  have hη'j : η' ∈ Set.range (Spec.map e ≫ Y'.fromSpecResidueField η') :=
    ⟨IsLocalRing.closedPoint L, Scheme.fromSpecResidueField_apply η' _⟩
  have hpre : ∀ i, ρ ⁻¹' closure (ρ '' Z₀ i) = Z₀ i := fun i => by
    rw [← hemb.closure_eq_preimage_closure_image, (hZ₀cl i).closure_eq]
  refine ⟨fun i => closure (ρ '' Z₀ i), fun i => isClosed_closure, ?_, ?_⟩
  · intro x hx
    have hxr : x ∈ Set.range ρ := by
      rw [hrange, Set.mem_preimage, hx]
      exact hη'j
    obtain ⟨w, rfl⟩ := hxr
    have hw : w ∈ ⋃ i, Z₀ i := by rw [hZ₀cov]; trivial
    obtain ⟨i, hi⟩ := Set.mem_iUnion.mp hw
    exact ⟨i, subset_closure (Set.mem_image_of_mem ρ hi)⟩
  · intro i Ω _ _ t ht
    obtain ⟨t', rfl⟩ := s1 Y' η' L e he Ω t ht
    apply s4 ρ _ _ _ H t'
    have := hZ₀irr i Ω t'
    rw [← hpre i] at this
    exact this

theorem wc_generic_constructible_dichotomy : ∀ (X' Y' : Scheme.{u}) (f : X' ⟶ Y') [LocallyOfFiniteType f] [QuasiCompact f] [IsIntegral Y'] [IsLocallyNoetherian Y'] (Z U : Set ↥X'), IsClosed Z → IsOpen U → ∃ V : Set ↥Y', IsOpen V ∧ genericPoint ↥Y' ∈ V ∧ (genericPoint ↥Y' ∈ f '' (Z ∩ U) → V ⊆ f '' (Z ∩ U)) ∧ (genericPoint ↥Y' ∉ f '' (Z ∩ U) → Disjoint V (f '' (Z ∩ U))) :=
by
  intro X' Y' f _ _ _ _ Z U hZ hU
  classical

  have s1 : ∀ (T : Type u) [TopologicalSpace T] (η : T),
      (∀ O : Set T, IsOpen O → O.Nonempty → η ∈ O) →
      ∀ (E : Set T), Topology.IsConstructible E →
        ∃ V : Set T, IsOpen V ∧ η ∈ V ∧ (V ⊆ E ∨ Disjoint V E) := by
    intro T _ η hη E hE
    refine BooleanSubalgebra.closure_bot_sup_induction
      (p := fun E _ => ∃ V : Set T, IsOpen V ∧ η ∈ V ∧ (V ⊆ E ∨ Disjoint V E)) ?_ ?_ ?_ ?_ hE
    · intro W hW
      by_cases hηW : η ∈ W
      · exact ⟨W, hW.1, hηW, Or.inl subset_rfl⟩
      · have hW0 : W = ∅ := by
          by_contra hne
          exact hηW (hη W hW.1 (Set.nonempty_iff_ne_empty.mpr hne))
        exact ⟨Set.univ, isOpen_univ, Set.mem_univ _,
          Or.inr (by rw [hW0]; exact Set.disjoint_empty _)⟩
    · exact ⟨Set.univ, isOpen_univ, Set.mem_univ _, Or.inr (Set.disjoint_empty _)⟩
    · rintro E₁ - E₂ - ⟨V₁, hV₁o, hηV₁, h₁⟩ ⟨V₂, hV₂o, hηV₂, h₂⟩
      refine ⟨V₁ ∩ V₂, hV₁o.inter hV₂o, ⟨hηV₁, hηV₂⟩, ?_⟩
      rcases h₁ with h₁ | h₁
      · exact Or.inl (fun x hx => Or.inl (h₁ hx.1))
      rcases h₂ with h₂ | h₂
      · exact Or.inl (fun x hx => Or.inr (h₂ hx.2))
      · refine Or.inr ?_
        rw [Set.disjoint_left]
        rintro x ⟨hx₁, hx₂⟩ (hxE | hxE)
        · exact Set.disjoint_left.mp h₁ hx₁ hxE
        · exact Set.disjoint_left.mp h₂ hx₂ hxE
    · rintro E - ⟨V, hVo, hηV, h⟩
      refine ⟨V, hVo, hηV, ?_⟩
      rcases h with h | h
      · exact Or.inr (Set.disjoint_compl_right_iff_subset.mpr h)
      · exact Or.inl (Set.subset_compl_iff_disjoint_right.mpr h)

  haveI : IsLocallyNoetherian X' := LocallyOfFiniteType.isLocallyNoetherian f
  have s2 : Topology.IsLocallyConstructible (Z ∩ U) := by
    intro x
    obtain ⟨O, hO, hxO, -⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp
      (Scheme.isBasis_affineOpens X')) (show x ∈ (⊤ : X'.Opens) from trivial)
    haveI := IsLocallyNoetherian.component_noetherian ⟨O, hO⟩
    haveI hNS : TopologicalSpace.NoetherianSpace ↥(O : Set X') :=
      noetherianSpace_of_isAffineOpen O hO
    have hc : ∀ s : Set ↥(O : Set X'), IsOpen s → Topology.IsConstructible s := fun s hs =>
      IsRetrocompact.isConstructible hs (fun K _ _ => TopologicalSpace.NoetherianSpace.isCompact _)
    refine ⟨O, O.isOpen.mem_nhds hxO, O.isOpen, ?_⟩
    change Topology.IsConstructible (Subtype.val ⁻¹' (Z ∩ U))
    rw [Set.preimage_inter]
    refine Topology.IsConstructible.inter ?_ (hc _ (hU.preimage continuous_subtype_val))
    have h := (hc _ (hZ.isOpen_compl.preimage continuous_subtype_val)).compl
    rwa [Set.preimage_compl, compl_compl] at h

  have hE := f.isLocallyConstructible_image s2

  obtain ⟨N, hNη, hN, hc⟩ := hE (genericPoint Y')
  have hηN : genericPoint Y' ∈ N := mem_of_mem_nhds hNη
  have hgen : ∀ O : Set Y', IsOpen O → O.Nonempty → genericPoint Y' ∈ O := by
    intro O hO hne
    exact ((genericPoint_spec Y').mem_open_set_iff hO).mpr (by simpa using hne)
  have hgen' : ∀ O : Set ↥N, IsOpen O → O.Nonempty → (⟨genericPoint Y', hηN⟩ : ↥N) ∈ O := by
    rintro O hO ⟨o, ho⟩
    obtain ⟨o', ho', he⟩ := hgen _ (hN.isOpenMap_subtype_val O hO) ⟨o.1, o, ho, rfl⟩
    have : o' = ⟨genericPoint Y', hηN⟩ := Subtype.ext he
    rw [← this]
    exact ho'
  obtain ⟨V', hV'o, hηV', hcase⟩ := s1 ↥N ⟨genericPoint Y', hηN⟩ hgen' _ hc
  refine ⟨Subtype.val '' V', hN.isOpenMap_subtype_val V' hV'o, ⟨_, hηV', rfl⟩, ?_⟩
  rcases hcase with hsub | hdis
  · have hVE : Subtype.val '' V' ⊆ f '' (Z ∩ U) := Set.image_subset_iff.mpr hsub
    exact ⟨fun _ => hVE, fun hη => absurd (hVE ⟨_, hηV', rfl⟩) hη⟩
  · have hVE : Disjoint (Subtype.val '' V') (f '' (Z ∩ U)) := by
      rw [Set.disjoint_left]
      rintro _ ⟨v, hv, rfl⟩ hvE
      exact Set.disjoint_left.mp hdis hv hvE
    exact ⟨fun hη => absurd hη (Set.disjoint_left.mp hVE ⟨_, hηV', rfl⟩), fun _ => hVE⟩

theorem wc_alg_extend_hom_integral : ∀ (A A' : Type u) [CommRing A] [IsDomain A] [CommRing A'] [IsDomain A'] [Algebra A A'], Function.Injective (algebraMap A A') → Algebra.IsIntegral A A' → ∀ a' : A', a' ≠ 0 → ∃ c : A, c ≠ 0 ∧ ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (ψ : A →+* Ω), ψ c ≠ 0 → ∃ ψ' : A' →+* Ω, ψ'.comp (algebraMap A A') = ψ ∧ ψ' a' ≠ 0 :=
by
  intro A A' _ _ _ _ _ hinj hint a' ha'
  have h1 : Ideal.under A (Ideal.span {a'}) ≠ ⊥ :=
    Ideal.under_ne_bot_of_integral_mem ha' (Ideal.mem_span_singleton_self a')
      (hint.isIntegral a')
  obtain ⟨c, hcmem, hc⟩ := (Submodule.ne_bot_iff _).mp h1
  rw [Ideal.under_def, Ideal.mem_comap] at hcmem
  obtain ⟨b, hb⟩ := Ideal.mem_span_singleton'.mp hcmem
  refine ⟨c, hc, ?_⟩
  intro Ω _ _ ψ hψc
  have hP : (RingHom.ker ψ).IsPrime := RingHom.ker_isPrime ψ
  have hker : RingHom.ker (algebraMap A A') ≤ RingHom.ker ψ := by
    rw [(RingHom.injective_iff_ker_eq_bot _).mp hinj]; exact bot_le
  obtain ⟨Q, hQ, hQP⟩ :=
    Ideal.exists_ideal_over_prime_of_isIntegral_of_isDomain (RingHom.ker ψ) hker
  have := hQ
  rw [Ideal.under_def] at hQP
  have : (Ideal.comap (algebraMap A A') Q).IsPrime := Ideal.IsPrime.comap _
  let ψb : A ⧸ Ideal.comap (algebraMap A A') Q →+* Ω :=
    Ideal.Quotient.lift _ ψ (fun a ha => by rw [hQP] at ha; exact ha)
  have hψb : Function.Injective ψb := by
    rw [injective_iff_map_eq_zero]
    intro x hx
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective x
    rw [Ideal.Quotient.eq_zero_iff_mem, hQP]
    exact hx
  letI : Algebra (A ⧸ Ideal.comap (algebraMap A A') Q) Ω := ψb.toAlgebra
  have : Module.IsTorsionFree (A ⧸ Ideal.comap (algebraMap A A') Q) Ω :=
    Module.isTorsionFree_iff_algebraMap_injective.mpr hψb
  have : Module.IsTorsionFree (A ⧸ Ideal.comap (algebraMap A A') Q) (A' ⧸ Q) :=
    Module.isTorsionFree_iff_algebraMap_injective.mpr Ideal.algebraMap_quotient_injective
  have : Algebra.IsIntegral (A ⧸ Ideal.comap (algebraMap A A') Q) (A' ⧸ Q) :=
    Algebra.IsIntegral.quotient
  have : Algebra.IsAlgebraic (A ⧸ Ideal.comap (algebraMap A A') Q) (A' ⧸ Q) :=
    Algebra.IsIntegral.isAlgebraic
  let φ := IsAlgClosed.lift (M := Ω) (R := A ⧸ Ideal.comap (algebraMap A A') Q) (S := A' ⧸ Q)
  let ψ' : A' →+* Ω := (φ : A' ⧸ Q →+* Ω).comp (Ideal.Quotient.mk Q)
  have hext : ψ'.comp (algebraMap A A') = ψ := by
    ext a
    show φ (Ideal.Quotient.mk Q (algebraMap A A' a)) = ψ a
    have : Ideal.Quotient.mk Q (algebraMap A A' a) =
        algebraMap (A ⧸ Ideal.comap (algebraMap A A') Q) (A' ⧸ Q)
          (Ideal.Quotient.mk _ a) := rfl
    rw [this, φ.commutes]
    rfl
  refine ⟨ψ', hext, fun h0 => hψc ?_⟩
  rw [← hext, RingHom.comp_apply, ← hb, map_mul, h0, mul_zero]

theorem wc_geom_preirr_empty_generic_fibre : ∀ (A R : Type u) [CommRing A] [IsDomain A] [CommRing R] [Algebra A R], Subsingleton (TensorProduct A (AlgebraicClosure (FractionRing A)) R) → ∃ a : A, a ≠ 0 ∧ ∀ (Ω : Type u) [Field Ω] [Algebra A Ω], algebraMap A Ω a ≠ 0 → Subsingleton (TensorProduct A Ω R) :=
by
  intro A R _ _ _ _ hsub
  classical
  have s1 : ∃ s : A, s ≠ 0 ∧ algebraMap A R s = 0 := by
    by_contra H
    push_neg at H
    let T : Submonoid R := Submonoid.map (algebraMap A R) (nonZeroDivisors A)
    have hdisj : Disjoint ((⊥ : Ideal R) : Set R) (T : Set R) := by
      rw [Set.disjoint_left]
      intro y hy hyT
      have hy0 : y = 0 := (Submodule.mem_bot R).mp hy
      obtain ⟨x, hx, hxy⟩ := Submonoid.mem_map.mp hyT
      exact H x (nonZeroDivisors.ne_zero hx) (hxy.trans hy0)
    obtain ⟨p, hp, -, hpT⟩ := Ideal.exists_le_prime_disjoint (⊥ : Ideal R) T hdisj
    haveI := hp
    have hinjp : Function.Injective (algebraMap A (R ⧸ p)) := by
      rw [injective_iff_map_eq_zero]
      intro x hx
      rw [IsScalarTower.algebraMap_apply A R (R ⧸ p), Ideal.Quotient.algebraMap_eq,
        Ideal.Quotient.eq_zero_iff_mem] at hx
      by_contra hx0
      have hxT : algebraMap A R x ∈ T := ⟨x, mem_nonZeroDivisors_of_ne_zero hx0, rfl⟩
      exact Set.disjoint_left.mp hpT hx hxT
    have hinjK : Function.Injective (algebraMap A (AlgebraicClosure (FractionRing A))) := by
      rw [IsScalarTower.algebraMap_eq A (FractionRing A) (AlgebraicClosure (FractionRing A))]
      exact (algebraMap (FractionRing A) (AlgebraicClosure (FractionRing A))).injective.comp
        (IsFractionRing.injective _ _)
    haveI : Nontrivial (TensorProduct A (AlgebraicClosure (FractionRing A)) (R ⧸ p)) :=
      Algebra.TensorProduct.nontrivial_of_algebraMap_injective_of_isDomain A _ _ hinjK hinjp
    let φ := (Algebra.TensorProduct.map (AlgHom.id A (AlgebraicClosure (FractionRing A)))
      (Ideal.Quotient.mkₐ A p)).toRingHom
    haveI := φ.domain_nontrivial
    exact false_of_nontrivial_of_subsingleton
      (TensorProduct A (AlgebraicClosure (FractionRing A)) R)
  obtain ⟨s, hs0, hs⟩ := s1
  refine ⟨s, hs0, fun Ω _ _ hΩ => ?_⟩
  have h1 : (TensorProduct.tmul A (algebraMap A Ω s) (1 : R) : TensorProduct A Ω R) = 0 := by
    rw [Algebra.TensorProduct.tmul_one_eq_one_tmul, hs, TensorProduct.tmul_zero]
  apply subsingleton_of_zero_eq_one
  calc (0 : TensorProduct A Ω R)
      = (TensorProduct.tmul A (algebraMap A Ω s)⁻¹ (1 : R)) *
          (TensorProduct.tmul A (algebraMap A Ω s) (1 : R)) := by rw [h1, mul_zero]
    _ = 1 := by
      rw [Algebra.TensorProduct.tmul_mul_tmul, inv_mul_cancel₀ hΩ, mul_one,
        Algebra.TensorProduct.one_def]

theorem wc_geom_preirr_transfer_integral : ∀ (A A' R : Type u) [CommRing A] [CommRing A'] [Algebra A A'] [CommRing R] [Algebra A R] (c : A) (c' : A'), (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (ψ : A →+* Ω), ψ c ≠ 0 → ∃ ψ' : A' →+* Ω, ψ'.comp (algebraMap A A') = ψ ∧ ψ' c' ≠ 0) → (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] [Algebra A' Ω], algebraMap A' Ω c' ≠ 0 → IsPreirreducible (Set.univ : Set (PrimeSpectrum (TensorProduct A' Ω (TensorProduct A A' R))))) → ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] [Algebra A Ω], algebraMap A Ω c ≠ 0 → IsPreirreducible (Set.univ : Set (PrimeSpectrum (TensorProduct A Ω R))) :=
by
  intro A A' R _ _ _ _ _ c c' H1 H2 Ω _ _ _ hc
  obtain ⟨ψ', hψ', hc'⟩ := H1 Ω (algebraMap A Ω) hc
  letI : Algebra A' Ω := ψ'.toAlgebra
  haveI : IsScalarTower A A' Ω := IsScalarTower.of_algebraMap_eq' hψ'.symm
  have hpre := H2 Ω hc'
  let e := Algebra.TensorProduct.cancelBaseChange A A' Ω Ω R
  let h := PrimeSpectrum.homeomorphOfRingEquiv e.toRingEquiv
  have h2 := hpre.image h h.continuous.continuousOn
  rwa [Set.image_univ, h.surjective.range_eq] at h2

theorem wc_birational_hypersurface_alg_closed : ∀ (k : Type u) [Field k] [IsAlgClosed k] (D : Type u) [CommRing D] [IsDomain D] [Algebra k D] [Algebra.FiniteType k D], ∃ (n : ℕ) (F g : MvPolynomial (Fin n) k) (t : D), Irreducible F ∧ t ≠ 0 ∧ Nonempty (Localization.Away t ≃ₐ[k] Localization.Away (Ideal.Quotient.mk (Ideal.span {F}) g)) :=
by
  intro k _ _ D _ _ _ _
  classical

  have T12 : ∃ (S : Finset (FractionRing D)) (r : ℕ) (x : Fin r → FractionRing D),
      IntermediateField.adjoin k (S : Set (FractionRing D)) = ⊤ ∧ IsTranscendenceBasis k x ∧
      Algebra.IsSeparable (IntermediateField.adjoin k (Set.range x)) (FractionRing D) := by
    haveI := IsAlgClosed.perfectField k
    haveI : Algebra.EssFiniteType D (FractionRing D) :=
      Algebra.EssFiniteType.of_isLocalization _ (nonZeroDivisors D)
    haveI : Algebra.EssFiniteType k (FractionRing D) := Algebra.EssFiniteType.comp k D (FractionRing D)
    obtain ⟨s₀, hs₀⟩ := (Algebra.FiniteType.out : (⊤ : Subalgebra k D).FG)
    let fD : D →ₐ[k] FractionRing D := IsScalarTower.toAlgHom k D (FractionRing D)
    let S : Finset (FractionRing D) := s₀.image fD
    have hmem : ∀ a : D, algebraMap D (FractionRing D) a ∈
        Algebra.adjoin k (S : Set (FractionRing D)) := by
      intro a
      rw [Finset.coe_image, Algebra.adjoin_image, hs₀]
      exact ⟨a, trivial, rfl⟩
    have hfrac : ∀ w : FractionRing D, ∃ a b : D, algebraMap D (FractionRing D) b ≠ 0 ∧
        w = algebraMap D (FractionRing D) a / algebraMap D (FractionRing D) b := by
      intro w
      obtain ⟨a, b, hb, rfl⟩ := IsFractionRing.div_surjective D w
      exact ⟨a, b, IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors hb, rfl⟩
    have hStop : IntermediateField.adjoin k (S : Set (FractionRing D)) = ⊤ := by
      rw [eq_top_iff]
      intro w _
      obtain ⟨a, b, _, rfl⟩ := hfrac w
      exact IntermediateField.div_mem _ (IntermediateField.algebra_adjoin_le_adjoin k _ (hmem a))
        (IntermediateField.algebra_adjoin_le_adjoin k _ (hmem b))
    haveI halg : Algebra.IsAlgebraic (Algebra.adjoin k (S : Set (FractionRing D)))
        (FractionRing D) := by
      constructor
      intro w
      obtain ⟨a, b, hb, rfl⟩ := hfrac w
      refine ⟨Polynomial.C ⟨_, hmem b⟩ * Polynomial.X - Polynomial.C ⟨_, hmem a⟩, ?_, ?_⟩
      · intro h0
        have h1 := congrArg (fun p => Polynomial.coeff p 1) h0
        simp only [Polynomial.coeff_sub, Polynomial.coeff_C_mul_X, Polynomial.coeff_C,
          Polynomial.coeff_zero] at h1
        simp at h1
        exact hb (congrArg Subtype.val h1)
      · rw [map_sub, map_mul, Polynomial.aeval_C, Polynomial.aeval_C, Polynomial.aeval_X]
        change algebraMap D _ b * (algebraMap D _ a / algebraMap D _ b) - algebraMap D _ a = 0
        rw [mul_comm, div_mul_cancel₀ _ hb, sub_self]
    obtain ⟨s, hs, hsep⟩ :=
      exists_isTranscendenceBasis_and_isSeparable_of_perfectField k (FractionRing D)
    obtain ⟨t, htS, ht⟩ := exists_isTranscendenceBasis_subset (R := k) (S : Set (FractionRing D))
    have hcard := Cardinal.lift_inj.mp (hs.lift_cardinalMk_eq ht)
    have htfin : Cardinal.mk t < Cardinal.aleph0 := ((S.finite_toSet).subset htS).lt_aleph0
    haveI : Finite s := Cardinal.mk_lt_aleph0_iff.mp (hcard ▸ htfin)
    let e := Finite.equivFin s
    refine ⟨S, Nat.card s, Subtype.val ∘ e.symm, hStop, hs.comp_equiv e.symm, ?_⟩
    have hr : Set.range (Subtype.val ∘ e.symm) = s := by
      rw [e.symm.surjective.range_comp, Subtype.range_coe]
    rw [hr]; exact hsep

  have T3 : ∀ (k L : Type u) [Field k] [Field L] [Algebra k L] (r : ℕ) (x : Fin r → L),
      IsTranscendenceBasis k x → Algebra.IsSeparable (IntermediateField.adjoin k (Set.range x)) L →
      ∀ S : Finset L, IntermediateField.adjoin k (S : Set L) = ⊤ → ∃ y : L,
        _root_.IsIntegral (Algebra.adjoin k (Set.range x)) y ∧
        IntermediateField.adjoin k (Set.range (Fin.cons y x : Fin (r + 1) → L)) = ⊤ := by
    intro k L _ _ _ r x hx hsep S hS
    have hK0S : IntermediateField.adjoin (IntermediateField.adjoin k (Set.range x)) (S : Set L)
        = ⊤ := by
      rw [eq_top_iff]
      intro w _
      have hw : w ∈ IntermediateField.adjoin k
          ((IntermediateField.adjoin k (Set.range x) : Set L) ∪ (S : Set L)) :=
        IntermediateField.adjoin.mono k _ _ Set.subset_union_right (by rw [hS]; trivial)
      rw [← IntermediateField.restrictScalars_adjoin] at hw
      exact hw
    haveI halgK0 : Algebra.IsAlgebraic (IntermediateField.adjoin k (Set.range x)) L :=
      hx.isAlgebraic_field
    have hfd : FiniteDimensional (IntermediateField.adjoin k (Set.range x))
        (IntermediateField.adjoin (IntermediateField.adjoin k (Set.range x)) (S : Set L)) :=
      IntermediateField.finiteDimensional_adjoin
        (fun s _ => (Algebra.IsAlgebraic.isAlgebraic s).isIntegral)
    have key : ∀ K : IntermediateField (IntermediateField.adjoin k (Set.range x)) L, K = ⊤ →
        FiniteDimensional (IntermediateField.adjoin k (Set.range x)) K →
        FiniteDimensional (IntermediateField.adjoin k (Set.range x)) L := by
      rintro K rfl h
      haveI := h
      exact IntermediateField.topEquiv.toLinearEquiv.finiteDimensional
    haveI : FiniteDimensional (IntermediateField.adjoin k (Set.range x)) L := key _ hK0S hfd
    obtain ⟨α, hα⟩ := Field.exists_primitive_element (IntermediateField.adjoin k (Set.range x)) L
    haveI hA := hx.isAlgebraic
    obtain ⟨c, hc0, hcint⟩ :=
      (Algebra.IsAlgebraic.isAlgebraic (R := Algebra.adjoin k (Set.range x)) α).exists_integral_multiple
    refine ⟨c • α, hcint, ?_⟩
    have hcL : (c : L) ≠ 0 := fun h => hc0 (Subtype.ext h)
    have hy : c • α = (c : L) * α := Algebra.smul_def c α
    rw [Fin.range_cons, eq_top_iff]
    have h1 : IntermediateField.adjoin k (Set.range x ∪ {α}) = ⊤ := by
      rw [← IntermediateField.adjoin_adjoin_left, hα, IntermediateField.restrictScalars_top]
    rw [← h1, IntermediateField.adjoin_le_iff]
    have hcmem : (c : L) ∈ IntermediateField.adjoin k (insert (c • α) (Set.range x)) :=
      IntermediateField.algebra_adjoin_le_adjoin k _
        (Algebra.adjoin_mono (Set.subset_insert _ _) c.2)
    have hymem : c • α ∈ IntermediateField.adjoin k (insert (c • α) (Set.range x)) :=
      IntermediateField.subset_adjoin k _ (Set.mem_insert _ _)
    rintro w (⟨j, rfl⟩ | hw)
    · exact IntermediateField.subset_adjoin k _ (Set.mem_insert_of_mem _ ⟨j, rfl⟩)
    · rw [Set.mem_singleton_iff] at hw
      rw [hw]
      have hαeq : c • α / (c : L) = α := by
        rw [hy, mul_comm, mul_div_assoc, div_self hcL, mul_one]
      have := IntermediateField.div_mem _ hymem hcmem
      rwa [hαeq] at this

  have T4 : ∀ (k L : Type u) [Field k] [Field L] [Algebra k L] (r : ℕ) (x : Fin r → L) (y : L),
      AlgebraicIndependent k x → _root_.IsIntegral (Algebra.adjoin k (Set.range x)) y →
      ∃ F : MvPolynomial (Fin (r + 1)) k, Irreducible F ∧
        RingHom.ker (MvPolynomial.aeval (Fin.cons y x : Fin (r + 1) → L)) = Ideal.span {F} := by
    intro k L _ _ _ r x y hx hy
    haveI : IsIntegrallyClosed (Algebra.adjoin k (Set.range x)) :=
      IsIntegrallyClosed.of_equiv hx.aevalEquiv.toRingEquiv
    have hp : Prime (minpoly (Algebra.adjoin k (Set.range x)) y) :=
      minpoly.prime_of_isIntegrallyClosed hy
    let Ψ : MvPolynomial (Fin (r + 1)) k ≃ₐ[k] Polynomial (Algebra.adjoin k (Set.range x)) :=
      (MvPolynomial.finSuccEquiv k r).trans (Polynomial.mapAlgEquiv hx.aevalEquiv)
    have hΨ : ∀ q, MvPolynomial.aeval (Fin.cons y x : Fin (r + 1) → L) q =
        Polynomial.aeval y (Ψ q) := by
      intro q
      have : MvPolynomial.aeval (Fin.cons y x : Fin (r + 1) → L) =
          ((Polynomial.aeval y).restrictScalars k).comp Ψ.toAlgHom := by
        apply MvPolynomial.algHom_ext
        intro i
        refine Fin.cases ?_ (fun j => ?_) i
        · simp [Ψ, MvPolynomial.finSuccEquiv_X_zero]
        · simp [Ψ, MvPolynomial.finSuccEquiv_X_succ]
      rw [this]; rfl
    refine ⟨Ψ.symm (minpoly (Algebra.adjoin k (Set.range x)) y), ?_, ?_⟩
    · exact (MulEquiv.irreducible_iff Ψ.symm.toMulEquiv).mpr hp.irreducible
    · ext q
      rw [RingHom.mem_ker, Ideal.mem_span_singleton, hΨ, minpoly.isIntegrallyClosed_dvd_iff hy]
      constructor
      · intro h
        have := map_dvd Ψ.symm h
        simpa using this
      · intro h
        have := map_dvd Ψ h
        simpa using this

  have T5 : ∀ (k L : Type u) [Field k] [Field L] [Algebra k L] (n : ℕ) (z : Fin n → L)
      (F : MvPolynomial (Fin n) k), RingHom.ker (MvPolynomial.aeval z) = Ideal.span {F} →
      IntermediateField.adjoin k (Set.range z) = ⊤ →
      ∃ fE : (MvPolynomial (Fin n) k ⧸ Ideal.span {F}) →ₐ[k] L, Function.Injective fE ∧
        ∀ w : L, ∃ e e' : MvPolynomial (Fin n) k ⧸ Ideal.span {F}, fE e' ≠ 0 ∧ w * fE e' = fE e := by
    intro k L _ _ _ n z F hker htop
    have hI : ∀ a ∈ Ideal.span {F}, MvPolynomial.aeval z a = 0 := by
      intro a ha; rw [← hker] at ha; exact ha
    let fE := Ideal.Quotient.liftₐ (Ideal.span {F}) (MvPolynomial.aeval z) hI
    have hfE : ∀ q, fE (Ideal.Quotient.mk _ q) = MvPolynomial.aeval z q := fun q => rfl
    refine ⟨fE, ?_, ?_⟩
    · rw [injective_iff_map_eq_zero]
      intro e he
      obtain ⟨q, rfl⟩ := Ideal.Quotient.mk_surjective e
      rw [hfE] at he
      rw [Ideal.Quotient.eq_zero_iff_mem, ← hker]
      exact he
    · intro w
      have hw : w ∈ IntermediateField.adjoin k (Set.range z) := by rw [htop]; trivial
      obtain ⟨a, ha, b, hb, rfl⟩ := IntermediateField.mem_adjoin_iff_div.mp hw
      rw [Algebra.adjoin_range_eq_range_aeval] at ha hb
      obtain ⟨p, rfl⟩ := ha
      obtain ⟨q, rfl⟩ := hb
      show ∃ e e' : MvPolynomial (Fin n) k ⧸ Ideal.span {F}, fE e' ≠ 0 ∧
        MvPolynomial.aeval z p / MvPolynomial.aeval z q * fE e' = fE e
      by_cases hq : MvPolynomial.aeval z q = 0
      · exact ⟨0, 1, by rw [map_one]; exact one_ne_zero,
          by rw [hq, div_zero, zero_mul, map_zero]⟩
      · refine ⟨Ideal.Quotient.mk _ p, Ideal.Quotient.mk _ q, by rw [hfE]; exact hq, ?_⟩
        rw [hfE, hfE, div_mul_cancel₀ _ hq]

  have Tclear : ∀ (k : Type u) [Field k] (L : Type u) [Field L] [Algebra k L] (R S : Type u)
      [CommRing R] [Algebra k R] [Algebra.FiniteType k R] [CommRing S] [Algebra k S]
      (fR : R →ₐ[k] L) (fS : S →ₐ[k] L), (∀ d : R, ∃ e e' : S, fS e' ≠ 0 ∧ fR d * fS e' = fS e) →
      ∃ B : S, fS B ≠ 0 ∧ ∀ d : R, ∃ (e : S) (m : ℕ), fR d * fS B ^ m = fS e := by
    intro k _ L _ _ R S _ _ _ _ _ fR fS h
    obtain ⟨s, hs⟩ := (Algebra.FiniteType.out : (⊤ : Subalgebra k R).FG)
    choose α β hβ hαβ using h
    refine ⟨∏ i ∈ s, β i, ?_, ?_⟩
    · rw [map_prod]; exact Finset.prod_ne_zero_iff.mpr (fun i _ => hβ i)
    · intro d
      have hd : d ∈ Algebra.adjoin k (s : Set R) := by rw [hs]; trivial
      induction hd using Algebra.adjoin_induction with
      | mem x hx =>
        refine ⟨α x * ∏ i ∈ s.erase x, β i, 1, ?_⟩
        rw [pow_one, ← Finset.mul_prod_erase s β (Finset.mem_coe.mp hx), map_mul, map_mul,
          ← mul_assoc, hαβ]
      | algebraMap r =>
        exact ⟨algebraMap k S r, 0, by rw [pow_zero, mul_one, AlgHom.commutes, AlgHom.commutes]⟩
      | add x y _ _ hx hy =>
        obtain ⟨e1, m1, h1⟩ := hx
        obtain ⟨e2, m2, h2⟩ := hy
        refine ⟨e1 * (∏ i ∈ s, β i) ^ m2 + e2 * (∏ i ∈ s, β i) ^ m1, m1 + m2, ?_⟩
        simp only [map_add, map_mul, map_pow]
        rw [← h1, ← h2]; ring
      | mul x y _ _ hx hy =>
        obtain ⟨e1, m1, h1⟩ := hx
        obtain ⟨e2, m2, h2⟩ := hy
        refine ⟨e1 * e2, m1 + m2, ?_⟩
        simp only [map_mul]
        rw [← h1, ← h2]; ring

  have T7 : ∀ (k : Type u) [Field k] (L : Type u) [Field L] [Algebra k L] (D E : Type u)
      [CommRing D] [Algebra k D] [CommRing E] [Algebra k E] (fD : D →ₐ[k] L) (fE : E →ₐ[k] L)
      (t : D) (g : E), Function.Injective fD → Function.Injective fE → fD t ≠ 0 → fE g ≠ 0 →
      (∀ d : D, ∃ (e : E) (m : ℕ), fD d * fE g ^ m = fE e) →
      (∃ (e : E) (m : ℕ), fD t * fE e = fE g ^ m) →
      (∀ e : E, ∃ (d : D) (m : ℕ), fE e * fD t ^ m = fD d) →
      (∃ (d : D) (m : ℕ), fE g * fD d = fD t ^ m) →
      Nonempty (Localization.Away t ≃ₐ[k] Localization.Away g) := by
    intro k _ L _ _ D E _ _ _ _ fD fE t g hD hE ht hg ha hb hc hd
    have side : ∀ (R : Type u) [CommRing R] [Algebra k R] (fR : R →ₐ[k] L) (s : R),
        Function.Injective fR → fR s ≠ 0 → ∃ ι : Localization.Away s →ₐ[k] L,
          Function.Injective ι ∧
          (∀ (r : R) (n : ℕ), ∃ z, ι z = fR r / fR s ^ n) ∧
          ∀ z, ∃ (r : R) (n : ℕ), ι z = fR r / fR s ^ n := by
      intro R _ _ fR s hR hs
      have hu : ∀ y : Submonoid.powers s, IsUnit (fR y) := by
        rintro ⟨_, n, rfl⟩
        exact IsUnit.mk0 _ (by rw [map_pow]; exact pow_ne_zero _ hs)
      let ι : Localization.Away s →ₐ[k] L :=
        IsLocalization.liftAlgHom (M := Submonoid.powers s) (S := Localization.Away s) hu
      have hval : ∀ (r : R) (n : ℕ), ι (IsLocalization.mk' (Localization.Away s) r
          (⟨s ^ n, n, rfl⟩ : Submonoid.powers s)) = fR r / fR s ^ n := by
        intro r n
        rw [IsLocalization.liftAlgHom_apply, IsLocalization.lift_mk'_spec]
        change fR r = fR (s ^ n) * (fR r / fR s ^ n)
        rw [map_pow, mul_div_assoc', mul_comm, mul_div_assoc, div_self (pow_ne_zero _ hs),
          mul_one]
      refine ⟨ι, ?_, fun r n => ⟨_, hval r n⟩, ?_⟩
      · intro z1 z2 h12
        have hinj : Function.Injective (IsLocalization.lift (M := Submonoid.powers s)
            (S := Localization.Away s) hu) := by
          rw [IsLocalization.lift_injective_iff]
          intro a b
          constructor
          · intro hab
            have := congrArg (IsLocalization.lift (M := Submonoid.powers s)
              (S := Localization.Away s) hu) hab
            rwa [IsLocalization.lift_eq, IsLocalization.lift_eq] at this
          · intro hab
            rw [hR hab]
        apply hinj
        have e1 := IsLocalization.liftAlgHom_apply (M := Submonoid.powers s)
          (S := Localization.Away s) hu z1
        have e2 := IsLocalization.liftAlgHom_apply (M := Submonoid.powers s)
          (S := Localization.Away s) hu z2
        rw [← e1, ← e2]
        exact h12
      · intro z
        obtain ⟨⟨r, ⟨_, n, rfl⟩⟩, rfl⟩ := IsLocalization.mk'_surjective (Submonoid.powers s) z
        exact ⟨r, n, hval r n⟩
    obtain ⟨ιD, hιD, memD, surjD⟩ := side D fD t hD ht
    obtain ⟨ιE, hιE, memE, surjE⟩ := side E fE g hE hg
    have hrange : ιD.range = ιE.range := by
      apply le_antisymm
      · rintro _ ⟨z, rfl⟩
        obtain ⟨d, n, hz⟩ := surjD z
        change ιD z ∈ ιE.range
        rw [hz]
        obtain ⟨e, m, he⟩ := ha d
        obtain ⟨e', m', he'⟩ := hb
        have h1 : fD d = fE e / fE g ^ m := by rw [eq_div_iff (pow_ne_zero _ hg), he]
        have h2 : (fD t)⁻¹ = fE e' / fE g ^ m' := by
          rw [eq_div_iff (pow_ne_zero _ hg), ← he', ← mul_assoc, inv_mul_cancel₀ ht, one_mul]
        have h3 : fD d / fD t ^ n = fD d * ((fD t)⁻¹) ^ n := by rw [div_eq_mul_inv, inv_pow]
        rw [h3, h1, h2]
        obtain ⟨z1, hz1⟩ := memE e m
        obtain ⟨z2, hz2⟩ := memE e' m'
        rw [← hz1, ← hz2]
        exact Subalgebra.mul_mem _ (AlgHom.mem_range_self _ _)
          (Subalgebra.pow_mem _ (AlgHom.mem_range_self _ _) n)
      · rintro _ ⟨z, rfl⟩
        obtain ⟨e, n, hz⟩ := surjE z
        change ιE z ∈ ιD.range
        rw [hz]
        obtain ⟨d, m, hd'⟩ := hc e
        obtain ⟨d', m', hd''⟩ := hd
        have h1 : fE e = fD d / fD t ^ m := by rw [eq_div_iff (pow_ne_zero _ ht), hd']
        have h2 : (fE g)⁻¹ = fD d' / fD t ^ m' := by
          rw [eq_div_iff (pow_ne_zero _ ht), ← hd'', ← mul_assoc, inv_mul_cancel₀ hg, one_mul]
        have h3 : fE e / fE g ^ n = fE e * ((fE g)⁻¹) ^ n := by rw [div_eq_mul_inv, inv_pow]
        rw [h3, h1, h2]
        obtain ⟨z1, hz1⟩ := memD d m
        obtain ⟨z2, hz2⟩ := memD d' m'
        rw [← hz1, ← hz2]
        exact Subalgebra.mul_mem _ (AlgHom.mem_range_self _ _)
          (Subalgebra.pow_mem _ (AlgHom.mem_range_self _ _) n)
    exact ⟨((AlgEquiv.ofInjective ιD hιD).trans (Subalgebra.equivOfEq _ _ hrange)).trans
      (AlgEquiv.ofInjective ιE hιE).symm⟩

  obtain ⟨S, r, x, hS, hx, hsep⟩ := T12
  obtain ⟨y, hy, htop⟩ := T3 k (FractionRing D) r x hx hsep S hS
  obtain ⟨F, hF, hker⟩ := T4 k (FractionRing D) r x y hx.1 hy
  obtain ⟨fE, hfEinj, hfrac⟩ := T5 k (FractionRing D) (r + 1) (Fin.cons y x) F hker htop
  let fD : D →ₐ[k] FractionRing D := IsScalarTower.toAlgHom k D (FractionRing D)
  have hfDinj : Function.Injective fD := IsFractionRing.injective D (FractionRing D)
  have h2 : ∀ e, ∃ d d' : D, fD d' ≠ 0 ∧ fE e * fD d' = fD d := by
    intro e
    obtain ⟨a, b, hb, hab⟩ := IsFractionRing.div_surjective D (fE e)
    have hb' : algebraMap D (FractionRing D) b ≠ 0 :=
      IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors hb
    refine ⟨a, b, hb', ?_⟩
    change fE e * algebraMap D _ b = algebraMap D _ a
    rw [← hab, div_mul_cancel₀ _ hb']
  obtain ⟨B, hB0, hB⟩ := Tclear k (FractionRing D) D (MvPolynomial (Fin (r + 1)) k ⧸ Ideal.span {F})
    fD fE (fun d => hfrac (fD d))
  obtain ⟨Δ, hΔ0, hΔ⟩ := Tclear k (FractionRing D) (MvPolynomial (Fin (r + 1)) k ⧸ Ideal.span {F})
    D fE fD h2
  obtain ⟨b', m1, hb'⟩ := hΔ B
  obtain ⟨t, ht⟩ : ∃ t : D, t = Δ * b' := ⟨_, rfl⟩
  have hft : fD t = fE B * fD Δ ^ (m1 + 1) := by
    rw [ht, map_mul, ← hb']; ring
  have ht0 : fD t ≠ 0 := by rw [hft]; exact mul_ne_zero hB0 (pow_ne_zero _ hΔ0)
  obtain ⟨τ, m2, hτ⟩ := hB t
  obtain ⟨g, hg⟩ : ∃ g : MvPolynomial (Fin (r + 1)) k ⧸ Ideal.span {F}, g = B * τ := ⟨_, rfl⟩
  have hfg : fE g = fD t * fE B ^ (m2 + 1) := by
    rw [hg, map_mul, ← hτ]; ring
  have hg0 : fE g ≠ 0 := by rw [hfg]; exact mul_ne_zero ht0 (pow_ne_zero _ hB0)
  have ha : ∀ d : D, ∃ (e : MvPolynomial (Fin (r + 1)) k ⧸ Ideal.span {F}) (m : ℕ),
      fD d * fE g ^ m = fE e := by
    intro d
    obtain ⟨e, m, he⟩ := hB d
    refine ⟨e * τ ^ m, m, ?_⟩
    rw [map_mul, map_pow, ← he, hg, map_mul]; ring
  have hb : ∃ (e : MvPolynomial (Fin (r + 1)) k ⧸ Ideal.span {F}) (m : ℕ),
      fD t * fE e = fE g ^ m :=
    ⟨B ^ (m2 + 1), 1, by rw [pow_one, hfg, map_pow]⟩
  have hc : ∀ e : MvPolynomial (Fin (r + 1)) k ⧸ Ideal.span {F}, ∃ (d : D) (m : ℕ),
      fE e * fD t ^ m = fD d := by
    intro e
    obtain ⟨d, m, hd⟩ := hΔ e
    refine ⟨d * b' ^ m, m, ?_⟩
    rw [map_mul, map_pow, ← hd, ht, map_mul]; ring
  have hd : ∃ (d : D) (m : ℕ), fE g * fD d = fD t ^ m := by
    refine ⟨Δ ^ ((m1 + 1) * (m2 + 1)), m2 + 2, ?_⟩
    rw [hfg, map_pow, hft, pow_mul]; ring
  obtain ⟨iso⟩ := T7 k (FractionRing D) D (MvPolynomial (Fin (r + 1)) k ⧸ Ideal.span {F}) fD fE
    t g hfDinj hfEinj ht0 hg0 ha hb hc hd
  obtain ⟨g₀, rfl⟩ := Ideal.Quotient.mk_surjective g
  exact ⟨r + 1, F, g₀, t, hF, fun h => ht0 (by rw [h, map_zero]), ⟨iso⟩⟩

theorem wc_descend_finite_data : ∀ (A R L : Type u) [CommRing A] [IsDomain A] [CommRing R] [Algebra A R] [Field L] [Algebra A L], Function.Injective (algebraMap A L) → Algebra.IsAlgebraic A L → ∀ (n : ℕ) (xs : Finset (TensorProduct A L R)) (Ps : Finset (MvPolynomial (Fin n) L)), ∃ (A' : Subalgebra A L) (d : A), d ≠ 0 ∧ Algebra.IsIntegral A A' ∧ A'.FG ∧ (∀ x ∈ xs, ∃ s : TensorProduct A A' R, Algebra.TensorProduct.map (Algebra.ofId A' L) (AlgHom.id A R) s = algebraMap L (TensorProduct A L R) (algebraMap A L d) * x) ∧ (∀ P ∈ Ps, ∃ P' : MvPolynomial (Fin n) A', MvPolynomial.map (algebraMap A' L) P' = MvPolynomial.C (algebraMap A L d) * P) :=
by
  intro A R L _ _ _ _ _ _ _ halg n xs Ps
  classical

  have s1 : ∀ x : TensorProduct A L R, ∃ T : Finset L, ∀ (B : Subalgebra A L) (e : L),
      (∀ t ∈ T, e * t ∈ B) → ∃ s : TensorProduct A B R,
        Algebra.TensorProduct.map (Algebra.ofId B L) (AlgHom.id A R) s =
          algebraMap L (TensorProduct A L R) e * x := by
    intro x
    induction x using TensorProduct.induction_on with
    | zero => exact ⟨∅, fun B e _ => ⟨0, by rw [map_zero, mul_zero]⟩⟩
    | tmul l r =>
      refine ⟨{l}, fun B e h =>
        ⟨TensorProduct.tmul A (⟨e * l, h l (Finset.mem_singleton_self l)⟩ : B) r, ?_⟩⟩
      rw [Algebra.TensorProduct.map_tmul, Algebra.TensorProduct.algebraMap_apply,
        Algebra.TensorProduct.tmul_mul_tmul, one_mul]
      rfl
    | add x₁ x₂ h₁ h₂ =>
      obtain ⟨T₁, hT₁⟩ := h₁
      obtain ⟨T₂, hT₂⟩ := h₂
      refine ⟨T₁ ∪ T₂, fun B e h => ?_⟩
      obtain ⟨s₁, hs₁⟩ := hT₁ B e (fun t ht => h t (Finset.mem_union_left _ ht))
      obtain ⟨s₂, hs₂⟩ := hT₂ B e (fun t ht => h t (Finset.mem_union_right _ ht))
      exact ⟨s₁ + s₂, by rw [map_add, hs₁, hs₂, mul_add]⟩

  have s3 : ∀ C : Finset L, ∃ d : A, d ≠ 0 ∧ ∀ c ∈ C, IsIntegral A (algebraMap A L d * c) := by
    intro C
    induction C using Finset.induction_on with
    | empty => exact ⟨1, one_ne_zero, fun c hc => absurd hc (Finset.notMem_empty c)⟩
    | insert a C₀ _ ih =>
      obtain ⟨d₀, hd₀, hC₀⟩ := ih
      obtain ⟨y, hy, hya⟩ := (Algebra.IsAlgebraic.isAlgebraic (R := A) a).exists_integral_multiple
      refine ⟨d₀ * y, mul_ne_zero hd₀ hy, fun c hc => ?_⟩
      rcases Finset.mem_insert.mp hc with rfl | hc
      · have e : algebraMap A L (d₀ * y) * c = d₀ • (y • c) := by
          rw [Algebra.smul_def, Algebra.smul_def, map_mul, mul_assoc]
        rw [e]
        exact hya.smul d₀
      · have e : algebraMap A L (d₀ * y) * c = y • (algebraMap A L d₀ * c) := by
          rw [Algebra.smul_def, map_mul]
          ring
        rw [e]
        exact (hC₀ c hc).smul y

  choose Tx hTx using s1
  obtain ⟨d, hd0, hdC⟩ := s3 (xs.biUnion Tx ∪ Ps.biUnion (fun P => P.coeffs))
  have hmem : ∀ c ∈ xs.biUnion Tx ∪ Ps.biUnion (fun P => P.coeffs),
      algebraMap A L d * c ∈ Algebra.adjoin A
        (↑((xs.biUnion Tx ∪ Ps.biUnion (fun P => P.coeffs)).image
          (fun c => algebraMap A L d * c)) : Set L) := fun c hc =>
    Algebra.subset_adjoin (Finset.mem_coe.mpr (Finset.mem_image_of_mem _ hc))
  refine ⟨Algebra.adjoin A (↑((xs.biUnion Tx ∪ Ps.biUnion (fun P => P.coeffs)).image
      (fun c => algebraMap A L d * c)) : Set L), d, hd0, ?_, Subalgebra.fg_adjoin_finset _, ?_, ?_⟩
  · apply Algebra.IsIntegral.adjoin
    intro z hz
    obtain ⟨c, hc, rfl⟩ := Finset.mem_image.mp (Finset.mem_coe.mp hz)
    exact hdC c hc
  · intro x hx
    exact hTx x _ (algebraMap A L d) (fun t ht =>
      hmem t (Finset.mem_union_left _ (Finset.mem_biUnion.mpr ⟨x, hx, ht⟩)))
  · intro P hP
    have hsub : (↑(MvPolynomial.C (algebraMap A L d) * P).coeffs : Set L) ⊆
        Set.range (algebraMap (Algebra.adjoin A (↑((xs.biUnion Tx ∪ Ps.biUnion
          (fun P => P.coeffs)).image (fun c => algebraMap A L d * c)) : Set L)) L) := by
      intro c hc
      obtain ⟨m, hm, rfl⟩ := MvPolynomial.mem_coeffs_iff.mp hc
      have hm' := MvPolynomial.mem_support_iff.mp hm
      rw [MvPolynomial.coeff_C_mul] at hm' ⊢
      have hPm : P.coeff m ≠ 0 := fun h0 => hm' (by rw [h0, mul_zero])
      have hc' : P.coeff m ∈ xs.biUnion Tx ∪ Ps.biUnion (fun P => P.coeffs) :=
        Finset.mem_union_right _ (Finset.mem_biUnion.mpr ⟨P, hP, MvPolynomial.coeff_mem_coeffs _ hPm⟩)
      exact ⟨⟨_, hmem _ hc'⟩, rfl⟩
    obtain ⟨P', hP'⟩ := MvPolynomial.mem_range_map_iff_coeffs_subset.mpr hsub
    exact ⟨P', hP'⟩

theorem wc_tensor_nil_kernel_pow_torsion : ∀ (A A' R L : Type u) [CommRing A] [CommRing A'] [IsDomain A'] [IsNoetherianRing A'] [Algebra A A'] [CommRing R] [Algebra A R] [Algebra.FiniteType A R] [Field L] [Algebra A L] [Algebra A' L] [IsScalarTower A A' L], Function.Injective (algebraMap A' L) → ∃ (N : ℕ) (b₁ : A'), b₁ ≠ 0 ∧ ∀ x ∈ (RingHom.ker ((Ideal.Quotient.mkₐ A' (nilradical (TensorProduct A L R))).comp (Algebra.TensorProduct.map (Algebra.ofId A' L) (AlgHom.id A R)))) ^ N, b₁ • x = 0 :=
by
  intro A A' R L _ _ _ _ _ _ _ _ _ _ _ _ hinj
  classical

  have s1 : ∀ (K : Type u) [Field K] [Algebra A K] (j : K →ₐ[A] L),
      Function.Injective (Algebra.TensorProduct.map j (AlgHom.id A R)) := by
    intro K _ _ j
    letI : Algebra K L := j.toRingHom.toAlgebra
    have hjK : Function.Injective (Algebra.linearMap K L) := j.toRingHom.injective
    obtain ⟨g, hg⟩ := LinearMap.exists_leftInverse_of_injective (Algebra.linearMap K L)
      (LinearMap.ker_eq_bot.mpr hjK)
    have hgj : ∀ k : K, g (j k) = k := fun k => LinearMap.congr_fun hg k
    let gA : L →ₗ[A] K :=
      { toFun := g
        map_add' := map_add g
        map_smul' := by
          intro a y
          have h1 : a • y = (algebraMap A K a) • y := by
            rw [Algebra.smul_def, Algebra.smul_def, RingHom.algebraMap_toAlgebra]
            congr 1
            exact (j.commutes a).symm
          rw [RingHom.id_apply, h1, map_smul g, smul_eq_mul, Algebra.smul_def] }
    have hleft : Function.LeftInverse (LinearMap.rTensor R gA)
        (Algebra.TensorProduct.map j (AlgHom.id A R)) := by
      intro z
      induction z using TensorProduct.induction_on with
      | zero => rw [map_zero, map_zero]
      | tmul k r =>
        rw [Algebra.TensorProduct.map_tmul, AlgHom.id_apply, LinearMap.rTensor_tmul]
        exact congrArg (fun t => t ⊗ₜ[A] r) (hgj k)
      | add x y hx hy => rw [map_add, map_add, hx, hy]
    exact hleft.injective

  have s2 : ∀ x : TensorProduct A A' R,
      Algebra.TensorProduct.map (IsScalarTower.toAlgHom A A' (FractionRing A')) (AlgHom.id A R) x = 0 →
      ∃ s : A', s ≠ 0 ∧ s • x = 0 := by
    intro x hx
    let e := TensorProduct.AlgebraTensorModule.cancelBaseChange A A' (FractionRing A')
      (FractionRing A') R
    have he : ∀ y : TensorProduct A A' R, e ((1 : FractionRing A') ⊗ₜ[A'] y) =
        Algebra.TensorProduct.map (IsScalarTower.toAlgHom A A' (FractionRing A')) (AlgHom.id A R) y := by
      intro y
      induction y using TensorProduct.induction_on with
      | zero => rw [TensorProduct.tmul_zero, map_zero, map_zero]
      | tmul a r =>
        rw [TensorProduct.AlgebraTensorModule.cancelBaseChange_tmul, Algebra.TensorProduct.map_tmul,
          AlgHom.id_apply, IsScalarTower.coe_toAlgHom', Algebra.algebraMap_eq_smul_one]
      | add y z hy hz => rw [TensorProduct.tmul_add, map_add, hy, hz, map_add]
    have h1 : (TensorProduct.mk A' (FractionRing A') (TensorProduct A A' R) 1) x = 0 := by
      rw [TensorProduct.mk_apply, ← e.map_eq_zero_iff, he, hx]
    have hloc : IsLocalizedModule (nonZeroDivisors A')
        (TensorProduct.mk A' (FractionRing A') (TensorProduct A A' R) 1) :=
      (isLocalizedModule_iff_isBaseChange (nonZeroDivisors A') (FractionRing A') _).mpr
        (TensorProduct.isBaseChange A' _ (FractionRing A'))
    obtain ⟨c, hc⟩ := (IsLocalizedModule.eq_zero_iff (nonZeroDivisors A')
      (TensorProduct.mk A' (FractionRing A') (TensorProduct A A' R) 1)).mp h1
    exact ⟨c, nonZeroDivisors.coe_ne_zero c, hc⟩

  have hinj' : Function.Injective (IsScalarTower.toAlgHom A A' L) := hinj
  obtain ⟨j, hj⟩ : ∃ j : FractionRing A' →ₐ[A] L,
      ∀ a : A', j (algebraMap A' (FractionRing A') a) = algebraMap A' L a :=
    ⟨IsFractionRing.liftAlgHom (K := FractionRing A') hinj', fun a => by
      rw [IsFractionRing.liftAlgHom_apply, IsFractionRing.lift_algebraMap]
      rfl⟩
  have hfac : ∀ y : TensorProduct A A' R,
      Algebra.TensorProduct.map (Algebra.ofId A' L) (AlgHom.id A R) y =
      Algebra.TensorProduct.map j (AlgHom.id A R)
        (Algebra.TensorProduct.map (IsScalarTower.toAlgHom A A' (FractionRing A')) (AlgHom.id A R) y) := by
    intro y
    induction y using TensorProduct.induction_on with
    | zero => simp only [map_zero]
    | tmul a r =>
      rw [Algebra.TensorProduct.map_tmul, Algebra.TensorProduct.map_tmul,
        Algebra.TensorProduct.map_tmul, AlgHom.id_apply, AlgHom.id_apply,
        IsScalarTower.coe_toAlgHom', hj, Algebra.ofId_apply]
    | add y z hy hz => rw [map_add, map_add, map_add, hy, hz]

  have htors : ∀ x ∈ RingHom.ker ((Ideal.Quotient.mkₐ A' (nilradical (TensorProduct A L R))).comp
      (Algebra.TensorProduct.map (Algebra.ofId A' L) (AlgHom.id A R))),
      ∃ (n : ℕ) (s : A'), s ≠ 0 ∧ s • x ^ n = 0 := by
    intro x hx
    rw [RingHom.mem_ker, AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk,
      Ideal.Quotient.eq_zero_iff_mem, mem_nilradical] at hx
    obtain ⟨n, hn⟩ := hx
    refine ⟨n, s2 (x ^ n) ?_⟩
    apply s1 (FractionRing A') j
    rw [map_zero, ← hfac, map_pow, hn]

  haveI : IsNoetherianRing (TensorProduct A A' R) := Algebra.FiniteType.isNoetherianRing A' _
  set I := RingHom.ker ((Ideal.Quotient.mkₐ A' (nilradical (TensorProduct A L R))).comp
      (Algebra.TensorProduct.map (Algebra.ofId A' L) (AlgHom.id A R))) with hI
  obtain ⟨G, hG⟩ : I.FG := IsNoetherian.noetherian I
  have hGI : ∀ g ∈ G, g ∈ I := fun g hg => hG ▸ Ideal.subset_span hg
  choose! n s hs using htors
  have hb0 : (∏ g ∈ G, s g) ≠ 0 := Finset.prod_ne_zero_iff.mpr (fun g hg => (hs g (hGI g hg)).1)
  let J : Ideal (TensorProduct A A' R) :=
    { carrier := {y | (∏ g ∈ G, s g) • y = 0}
      add_mem' := fun {y z} hy hz => by
        simp only [Set.mem_setOf_eq] at hy hz ⊢
        rw [smul_add, hy, hz, add_zero]
      zero_mem' := by
        simp only [Set.mem_setOf_eq]
        exact smul_zero _
      smul_mem' := fun c y hy => by
        simp only [Set.mem_setOf_eq, smul_eq_mul] at hy ⊢
        rw [← mul_smul_comm, hy, mul_zero] }
  have hIJ : I ≤ J.radical := by
    rw [← hG, Ideal.span_le]
    intro g hg
    refine ⟨n g, ?_⟩
    show (∏ g ∈ G, s g) • g ^ n g = 0
    rw [← Finset.mul_prod_erase G s hg, mul_comm, mul_smul, (hs g (hGI g hg)).2, smul_zero]
  obtain ⟨N, hN⟩ := Ideal.exists_pow_le_of_le_radical_of_fg hIJ ⟨G, hG⟩
  exact ⟨N, ∏ g ∈ G, s g, hb0, fun x hx => hN hx⟩

theorem wc_mvpoly_quotient_descent_kernel_torsion : ∀ (B L : Type u) [CommRing B] [IsDomain B] [IsNoetherianRing B] [Field L] [Algebra B L], Function.Injective (algebraMap B L) → ∀ (n : ℕ) (F : MvPolynomial (Fin n) L) (F' : MvPolynomial (Fin n) B) (δ : L), δ ≠ 0 → MvPolynomial.map (algebraMap B L) F' = MvPolynomial.C δ * F → ∃ (κ : (MvPolynomial (Fin n) B ⧸ Ideal.span {F'}) →ₐ[B] (MvPolynomial (Fin n) L ⧸ Ideal.span {F})) (c : B), c ≠ 0 ∧ (∀ P : MvPolynomial (Fin n) B, κ (Ideal.Quotient.mk (Ideal.span {F'}) P) = Ideal.Quotient.mk (Ideal.span {F}) (MvPolynomial.map (algebraMap B L) P)) ∧ ∀ q, κ q = 0 → c • q = 0 :=
by
  intro B L _ _ _ _ _ hinj n F F' δ hδ hF
  classical

  have descent : ∀ (K : Type u) [Field K] (ι : K →+* L) (A Q : MvPolynomial (Fin n) K)
      (H : MvPolynomial (Fin n) L), MvPolynomial.map ι A = H * MvPolynomial.map ι Q →
      ∃ G : MvPolynomial (Fin n) K, A = G * Q := by
    intro K _ ι A Q H hAQ
    letI : Algebra K L := ι.toAlgebra
    have hker : LinearMap.ker (Algebra.linearMap K L) = ⊥ := by
      rw [LinearMap.ker_eq_bot]; exact ι.injective
    obtain ⟨g, hg⟩ := LinearMap.exists_leftInverse_of_injective (Algebra.linearMap K L) hker
    have hgι : ∀ k : K, g (ι k) = k := fun k => by
      have h := LinearMap.congr_fun hg k
      simp only [LinearMap.coe_comp, Function.comp_apply, Algebra.linearMap_apply,
        LinearMap.id_coe, id_eq] at h
      exact h
    have hgmul : ∀ (x : L) (q : K), g (x * ι q) = q * g x := by
      intro x q
      have : x * ι q = q • x := by rw [Algebra.smul_def, mul_comm]; rfl
      rw [this, LinearMap.map_smul, smul_eq_mul]
    let G : MvPolynomial (Fin n) K :=
      ∑ m ∈ H.support, MvPolynomial.monomial m (g (H.coeff m))
    have hGc : ∀ p, G.coeff p = g (H.coeff p) := by
      intro p
      simp only [G, MvPolynomial.coeff_sum, MvPolynomial.coeff_monomial, Finset.sum_ite_eq']
      split_ifs with h
      · rfl
      · rw [MvPolynomial.notMem_support_iff.mp h, map_zero]
    refine ⟨G, ?_⟩
    ext m
    have h1 : g ((MvPolynomial.map ι A).coeff m) =
        g ((H * MvPolynomial.map ι Q).coeff m) := by rw [hAQ]
    simp only [MvPolynomial.coeff_map, hgι, MvPolynomial.coeff_mul, map_sum, hgmul] at h1
    rw [h1, MvPolynomial.coeff_mul]
    refine Finset.sum_congr rfl (fun p _ => ?_)
    rw [hGc]
    ring

  have clear : ∀ (P Q : MvPolynomial (Fin n) B) (G : MvPolynomial (Fin n) (FractionRing B)),
      MvPolynomial.map (algebraMap B (FractionRing B)) P =
        G * MvPolynomial.map (algebraMap B (FractionRing B)) Q →
      ∃ s : B, s ≠ 0 ∧ ∃ G' : MvPolynomial (Fin n) B, MvPolynomial.C s * P = G' * Q := by
    intro P Q G hPQ
    obtain ⟨b, hb⟩ := IsLocalization.exist_integer_multiples_of_finset (nonZeroDivisors B)
      (G.support.image G.coeff)
    have hcoef : ∀ m, ∃ r : B, algebraMap B (FractionRing B) r = (b : B) • G.coeff m := by
      intro m
      by_cases hm : m ∈ G.support
      · exact hb _ (Finset.mem_image_of_mem _ hm)
      · rw [MvPolynomial.notMem_support_iff.mp hm, smul_zero]; exact ⟨0, map_zero _⟩
    choose r hr using hcoef
    let G' : MvPolynomial (Fin n) B := ∑ m ∈ G.support, MvPolynomial.monomial m (r m)
    have hG'coef : ∀ p, algebraMap B (FractionRing B) (G'.coeff p) = (b : B) • G.coeff p := by
      intro p
      simp only [G', MvPolynomial.coeff_sum, MvPolynomial.coeff_monomial, Finset.sum_ite_eq']
      split_ifs with h
      · exact hr p
      · rw [map_zero, MvPolynomial.notMem_support_iff.mp h, smul_zero]
    have hmapG' : MvPolynomial.map (algebraMap B (FractionRing B)) G' =
        MvPolynomial.C (algebraMap B (FractionRing B) (b : B)) * G := by
      ext m
      rw [MvPolynomial.coeff_map, hG'coef, MvPolynomial.coeff_C_mul, Algebra.smul_def]
    refine ⟨b, nonZeroDivisors.coe_ne_zero b, G', ?_⟩
    apply MvPolynomial.map_injective (algebraMap B (FractionRing B))
      (IsFractionRing.injective B (FractionRing B))
    rw [map_mul, map_mul, MvPolynomial.map_C, hPQ, hmapG']
    ring

  have hvan : ∀ a ∈ Ideal.span {F'}, ((Ideal.Quotient.mkₐ B (Ideal.span {F})).comp
      (MvPolynomial.mapAlgHom (Algebra.ofId B L))) a = 0 := by
    intro a ha
    obtain ⟨r, rfl⟩ := Ideal.mem_span_singleton'.mp ha
    change Ideal.Quotient.mk (Ideal.span {F}) (MvPolynomial.map (algebraMap B L) (r * F')) = 0
    rw [map_mul, hF, Ideal.Quotient.eq_zero_iff_mem]
    exact Ideal.mem_span_singleton'.mpr ⟨MvPolynomial.map (algebraMap B L) r * MvPolynomial.C δ,
      by ring⟩
  let κ := Ideal.Quotient.liftₐ (Ideal.span {F'}) ((Ideal.Quotient.mkₐ B (Ideal.span {F})).comp
      (MvPolynomial.mapAlgHom (Algebra.ofId B L))) hvan
  have hform : ∀ P : MvPolynomial (Fin n) B, κ (Ideal.Quotient.mk (Ideal.span {F'}) P) =
      Ideal.Quotient.mk (Ideal.span {F}) (MvPolynomial.map (algebraMap B L) P) := fun P => rfl

  have perelt : ∀ x ∈ Ideal.comap (MvPolynomial.map (algebraMap B L)) (Ideal.span {F}),
      ∃ c : B, c ≠ 0 ∧ MvPolynomial.C c * x ∈ Ideal.span {F'} := by
    intro x hx
    rw [Ideal.mem_comap] at hx
    obtain ⟨H, hH⟩ := Ideal.mem_span_singleton'.mp hx
    let ι : FractionRing B →+* L := IsFractionRing.lift (K := FractionRing B) hinj
    have hcomp : ι.comp (algebraMap B (FractionRing B)) = algebraMap B L :=
      RingHom.ext (fun b => IsFractionRing.lift_algebraMap hinj b)
    have h1 : (MvPolynomial.C δ⁻¹ * MvPolynomial.C δ : MvPolynomial (Fin n) L) = 1 := by
      rw [← MvPolynomial.C_mul, inv_mul_cancel₀ hδ, MvPolynomial.C_1]
    have key : MvPolynomial.map ι (MvPolynomial.map (algebraMap B (FractionRing B)) x) =
        (MvPolynomial.C δ⁻¹ * H) *
          MvPolynomial.map ι (MvPolynomial.map (algebraMap B (FractionRing B)) F') := by
      rw [MvPolynomial.map_map, MvPolynomial.map_map, hcomp, hF, ← hH]
      calc H * F = (MvPolynomial.C δ⁻¹ * MvPolynomial.C δ) * (H * F) := by rw [h1, one_mul]
        _ = _ := by ring
    obtain ⟨G, hG⟩ := descent (FractionRing B) ι _ _ _ key
    obtain ⟨s, hs0, G', hG'⟩ := clear x F' G hG
    refine ⟨s, hs0, ?_⟩
    rw [hG']
    exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _)

  have uniform : ∃ c : B, c ≠ 0 ∧
      ∀ x ∈ Ideal.comap (MvPolynomial.map (algebraMap B L)) (Ideal.span {F}),
        MvPolynomial.C c * x ∈ Ideal.span {F'} := by
    obtain ⟨S, hS⟩ := (IsNoetherian.noetherian
      (Ideal.comap (MvPolynomial.map (algebraMap B L)) (Ideal.span {F})) :
        (Ideal.comap (MvPolynomial.map (algebraMap B L)) (Ideal.span {F})).FG)
    have hSI : ∀ s ∈ S, s ∈ Ideal.comap (MvPolynomial.map (algebraMap B L)) (Ideal.span {F}) :=
      fun s hs => hS ▸ Submodule.subset_span hs
    choose! cf hcf0 hcf using fun s (hs : s ∈ S) => perelt s (hSI s hs)
    refine ⟨∏ s ∈ S, cf s, Finset.prod_ne_zero_iff.mpr hcf0, ?_⟩
    intro x hx
    rw [← hS] at hx
    induction hx using Submodule.span_induction with
    | mem s hs =>
      rw [← Finset.prod_erase_mul S cf hs, map_mul, mul_assoc]
      exact Ideal.mul_mem_left _ _ (hcf s hs)
    | zero => rw [mul_zero]; exact Ideal.zero_mem _
    | add x y _ _ hx hy => rw [mul_add]; exact Ideal.add_mem _ hx hy
    | smul a x _ hx => rw [smul_eq_mul, mul_left_comm]; exact Ideal.mul_mem_left _ a hx

  obtain ⟨c, hc0, hc⟩ := uniform
  refine ⟨κ, c, hc0, hform, ?_⟩
  intro q hq
  obtain ⟨P, rfl⟩ := Ideal.Quotient.mk_surjective q
  rw [hform, Ideal.Quotient.eq_zero_iff_mem] at hq
  have hP := hc P (Ideal.mem_comap.mpr hq)
  have h2 : c • Ideal.Quotient.mk (Ideal.span {F'}) P =
      Ideal.Quotient.mk (Ideal.span {F'}) (MvPolynomial.C c * P) := by
    rw [← MvPolynomial.smul_eq_C_mul]
    exact (map_smul (Ideal.Quotient.mkₐ B (Ideal.span {F'})) c P).symm
  rw [h2, Ideal.Quotient.eq_zero_iff_mem]
  exact hP

theorem wc_mvpoly_irreducible_algClosure_transfer : ∀ (B L : Type u) [CommRing B] [IsDomain B] [Field L] [IsAlgClosed L] [Algebra B L], Function.Injective (algebraMap B L) → Algebra.IsAlgebraic B L → ∀ (n : ℕ) (F : MvPolynomial (Fin n) B), Irreducible (MvPolynomial.map (algebraMap B L) F) → Irreducible (MvPolynomial.map (algebraMap B (AlgebraicClosure (FractionRing B))) F) :=
by
  intro B L _ _ _ _ _ hinj halg n F hF
  haveI : Module.IsTorsionFree B L := Module.isTorsionFree_iff_algebraMap_injective.mpr hinj
  haveI : IsAlgClosure B L := IsAlgClosure.mk ‹IsAlgClosed L› halg
  have hinj' : Function.Injective (algebraMap B (AlgebraicClosure (FractionRing B))) := by
    rw [IsScalarTower.algebraMap_eq B (FractionRing B) (AlgebraicClosure (FractionRing B)),
      RingHom.coe_comp]
    exact (algebraMap (FractionRing B) (AlgebraicClosure (FractionRing B))).injective.comp
      (IsFractionRing.injective B (FractionRing B))
  haveI : Module.IsTorsionFree B (AlgebraicClosure (FractionRing B)) :=
    Module.isTorsionFree_iff_algebraMap_injective.mpr hinj'
  have halg' : Algebra.IsAlgebraic B (AlgebraicClosure (FractionRing B)) :=
    @Algebra.IsAlgebraic.trans B (FractionRing B) (AlgebraicClosure (FractionRing B))
      _ _ _ _ _ _ _ _ (IsLocalization.isAlgebraic (FractionRing B) (nonZeroDivisors B))
      (AlgebraicClosure.isAlgebraic (FractionRing B))
  haveI : IsAlgClosure B (AlgebraicClosure (FractionRing B)) := IsAlgClosure.mk inferInstance halg'
  let e : L ≃ₐ[B] AlgebraicClosure (FractionRing B) := IsAlgClosure.equiv B L _
  have hcomp : (e.toRingEquiv : L →+* AlgebraicClosure (FractionRing B)).comp (algebraMap B L) =
      algebraMap B (AlgebraicClosure (FractionRing B)) := by
    apply RingHom.ext
    intro b
    exact e.commutes b
  have h1 := (MulEquiv.irreducible_iff (MvPolynomial.mapEquiv (Fin n) e.toRingEquiv)).mpr hF
  rwa [MvPolynomial.mapEquiv_apply, MvPolynomial.map_map, hcomp] at h1

theorem wc_descend_away_iso : ∀ (B D E P₁ P₂ : Type u) [CommRing B] [CommRing D] [IsDomain D] [Algebra B D] [CommRing E] [IsDomain E] [Algebra B E] [CommRing P₁] [Algebra B P₁] [CommRing P₂] [Algebra B P₂] (κ₁ : P₁ →ₐ[B] D) (κ₂ : P₂ →ₐ[B] E) (τ : D) (γ : E) (Φ : Localization.Away τ ≃ₐ[B] Localization.Away γ) (u₁ : P₁) (u₂ : P₂) (δ c : B) (G₁ : Set P₁) (G₂ : Set P₂), τ ≠ 0 → γ ≠ 0 → IsUnit (algebraMap B D (δ * c)) → IsUnit (algebraMap B E (δ * c)) → κ₁ u₁ = algebraMap B D δ * τ → κ₂ u₂ = algebraMap B E δ * γ → (∀ p : P₁, κ₁ p = 0 → (δ * c) • p = 0) → (∀ q : P₂, κ₂ q = 0 → (δ * c) • q = 0) → Algebra.adjoin B G₁ = ⊤ → Algebra.adjoin B G₂ = ⊤ → (∀ p ∈ G₁, ∃ (k : ℕ) (e : E) (q : P₂), Φ (algebraMap D (Localization.Away τ) (κ₁ p)) * algebraMap E (Localization.Away γ) γ ^ k = algebraMap E (Localization.Away γ) e ∧ κ₂ q = algebraMap B E δ * e) → (∃ (k : ℕ) (e : E) (q : P₂), Φ (IsLocalization.Away.invSelf τ) * algebraMap E (Localization.Away γ) γ ^ k = algebraMap E (Localization.Away γ) e ∧ κ₂ q = algebraMap B E δ * e) → (∀ q ∈ G₂, ∃ (k : ℕ) (e : D) (p : P₁), Φ.symm (algebraMap E (Localization.Away γ) (κ₂ q)) * algebraMap D (Localization.Away τ) τ ^ k = algebraMap D (Localization.Away τ) e ∧ κ₁ p = algebraMap B D δ * e) → (∃ (k : ℕ) (e : D) (p : P₁), Φ.symm (IsLocalization.Away.invSelf γ) * algebraMap D (Localization.Away τ) τ ^ k = algebraMap D (Localization.Away τ) e ∧ κ₁ p = algebraMap B D δ * e) → Nonempty (Localization.Away (u₁ * algebraMap B P₁ (δ * c)) ≃ₐ[B] Localization.Away (u₂ * algebraMap B P₂ (δ * c))) :=
by
  intro B D E P₁ P₂ _ _ _ _ _ _ _ _ _ _ _ κ₁ κ₂ τ γ Φ u₁ u₂ δ c G₁ G₂ hτ hγ hUD hUE hu₁ hu₂
    hT₁ hT₂ hG₁ hG₂ hgen₁ hinv₁ hgen₂ hinv₂

  have s1 : ∀ (P T : Type u) [CommRing P] [Algebra B P] [CommRing T] [Algebra B T]
      (f : P →ₐ[B] T) (w : P), IsUnit (f w) → (∀ p : P, f p = 0 → w * p = 0) →
      ∃ j : Localization.Away w →ₐ[B] T, Function.Injective j ∧
        ∀ p : P, j (algebraMap P (Localization.Away w) p) = f p := by
    intro P T _ _ _ _ f w hw hk
    have hu : ∀ y : Submonoid.powers w, IsUnit (f y) := by
      rintro ⟨y, n, rfl⟩
      rw [map_pow]
      exact hw.pow n
    refine ⟨IsLocalization.liftAlgHom (M := Submonoid.powers w) (S := Localization.Away w) hu,
      ?_, ?_⟩
    · rw [injective_iff_map_eq_zero]
      intro z hz
      obtain ⟨⟨p, y⟩, rfl⟩ := IsLocalization.mk'_surjective (Submonoid.powers w) z
      have h1 := IsLocalization.mk'_spec (Localization.Away w) p y
      have h2 := congrArg
        (IsLocalization.liftAlgHom (M := Submonoid.powers w) (S := Localization.Away w) hu) h1
      rw [map_mul, hz, zero_mul, IsLocalization.liftAlgHom_apply, IsLocalization.lift_eq] at h2
      rw [IsLocalization.mk'_eq_zero_iff]
      exact ⟨⟨w, Submonoid.mem_powers w⟩, hk p h2.symm⟩
    · intro p
      rw [IsLocalization.liftAlgHom_apply, IsLocalization.lift_eq]
      rfl

  have s2 : ∀ (P T : Type u) [CommRing P] [Algebra B P] [CommRing T] [Algebra B T]
      (w : P) (j : Localization.Away w →ₐ[B] T) (S : Subalgebra B T) (G : Set P),
      Algebra.adjoin B G = ⊤ → (∀ p ∈ G, j (algebraMap P (Localization.Away w) p) ∈ S) →
      j (IsLocalization.Away.invSelf w) ∈ S → j.range ≤ S := by
    intro P T _ _ _ _ w j S G hG hgen hinv
    have hP : ∀ p : P, j (algebraMap P (Localization.Away w) p) ∈ S := by
      let g : P →ₐ[B] T := j.comp (IsScalarTower.toAlgHom B P (Localization.Away w))
      have hle : Algebra.adjoin B G ≤ S.comap g :=
        Algebra.adjoin_le (fun p hp => (Subalgebra.mem_comap S g p).mpr (hgen p hp))
      intro p
      have hp : p ∈ Algebra.adjoin B G := by rw [hG]; exact Algebra.mem_top
      exact (Subalgebra.mem_comap S g p).mp (hle hp)
    intro y hy
    obtain ⟨z, rfl⟩ := j.mem_range.mp hy
    obtain ⟨n, a, ha⟩ := IsLocalization.Away.surj w z
    have hz : z = algebraMap P (Localization.Away w) a * IsLocalization.Away.invSelf w ^ n := by
      rw [← ha, mul_assoc, ← mul_pow, IsLocalization.Away.mul_invSelf, one_pow, mul_one]
    rw [hz, map_mul, map_pow]
    exact S.mul_mem (hP a) (S.pow_mem hinv n)

  have s3 : ∀ (E' P : Type u) [CommRing E'] [Algebra B E'] [CommRing P] [Algebra B P]
      (κ : P →ₐ[B] E') (γ' : E') (u : P)
      (j : Localization.Away (u * algebraMap B P (δ * c)) →ₐ[B] Localization.Away γ'),
      (∀ q : P, j (algebraMap P (Localization.Away (u * algebraMap B P (δ * c))) q) =
        algebraMap E' (Localization.Away γ') (κ q)) → κ u = algebraMap B E' δ * γ' →
      (∀ (z : Localization.Away γ') (k : ℕ) (e : E') (q : P),
        z * algebraMap E' (Localization.Away γ') γ' ^ k = algebraMap E' (Localization.Away γ') e →
        κ q = algebraMap B E' δ * e → z ∈ j.range) ∧
      (∀ r : Localization.Away γ',
        r * algebraMap B (Localization.Away γ') (δ * (δ * c)) = 1 → r ∈ j.range) := by
    intro E' P _ _ _ _ κ γ' u j hj hu
    have hιa : ∀ b : B, algebraMap E' (Localization.Away γ') (algebraMap B E' b) =
        algebraMap B (Localization.Away γ') b := fun b =>
      (IsScalarTower.algebraMap_apply B E' (Localization.Away γ') b).symm
    have hjw : j (algebraMap P _ (u * algebraMap B P (δ * c))) =
        algebraMap B (Localization.Away γ') δ * algebraMap E' (Localization.Away γ') γ' *
          (algebraMap B (Localization.Away γ') δ * algebraMap B (Localization.Away γ') c) := by
      rw [hj, map_mul, AlgHom.commutes, hu, map_mul, map_mul, hιa, hιa, map_mul]
    have hK : j (IsLocalization.Away.invSelf (u * algebraMap B P (δ * c))) *
        (algebraMap B (Localization.Away γ') δ * algebraMap E' (Localization.Away γ') γ' *
          (algebraMap B (Localization.Away γ') δ * algebraMap B (Localization.Away γ') c)) = 1 := by
      have h := congrArg j (IsLocalization.Away.mul_invSelf
        (S := Localization.Away (u * algebraMap B P (δ * c))) (u * algebraMap B P (δ * c)))
      rw [map_mul, map_one, hjw] at h
      rw [mul_comm]; exact h
    have hyR : j (IsLocalization.Away.invSelf (u * algebraMap B P (δ * c))) ∈ j.range :=
      AlgHom.mem_range_self _ _
    have hJR : algebraMap B (Localization.Away γ') δ * algebraMap E' (Localization.Away γ') γ' ∈
        j.range := j.mem_range.mpr ⟨algebraMap P _ u, by rw [hj, hu, map_mul, hιa]⟩
    have haR : ∀ b : B, algebraMap B (Localization.Away γ') b ∈ j.range := fun b =>
      j.range.algebraMap_mem b
    have hqR : ∀ q : P, algebraMap E' (Localization.Away γ') (κ q) ∈ j.range := fun q =>
      j.mem_range.mpr ⟨_, hj q⟩
    set y := j (IsLocalization.Away.invSelf (u * algebraMap B P (δ * c))) with hy
    set aδ := algebraMap B (Localization.Away γ') δ with haδ
    set ac := algebraMap B (Localization.Away γ') c with hac
    set g := algebraMap E' (Localization.Away γ') γ' with hg
    have e1 : (aδ * (aδ * ac) * y) * g = 1 := by linear_combination hK
    have e2 : (ac * (aδ * g) * y) * aδ = 1 := by linear_combination hK
    have e3 : ((aδ * g) * y) * (aδ * ac) = 1 := by linear_combination hK
    have hiδR : ac * (aδ * g) * y ∈ j.range := j.range.mul_mem (j.range.mul_mem (haR c) hJR) hyR
    have hiγR : aδ * (aδ * ac) * y ∈ j.range :=
      j.range.mul_mem (j.range.mul_mem (haR δ) (j.range.mul_mem (haR δ) (haR c))) hyR
    have himR : (aδ * g) * y ∈ j.range := j.range.mul_mem hJR hyR
    refine ⟨fun z k e q hz hq => ?_, fun r hr => ?_⟩
    · have hικ : algebraMap E' (Localization.Away γ') (κ q) =
          aδ * algebraMap E' (Localization.Away γ') e := by
        rw [hq, map_mul, hιa]
      have hzeq : z = algebraMap E' (Localization.Away γ') (κ q) * (ac * (aδ * g) * y) *
          (aδ * (aδ * ac) * y) ^ k := by
        calc z = z * ((aδ * (aδ * ac) * y) * g) ^ k * ((ac * (aδ * g) * y) * aδ) := by
              rw [e1, e2, one_pow, mul_one, mul_one]
          _ = (z * g ^ k) * aδ * (ac * (aδ * g) * y) * (aδ * (aδ * ac) * y) ^ k := by ring
          _ = _ := by rw [hz, hικ]; ring
      rw [hzeq]
      exact j.range.mul_mem (j.range.mul_mem (hqR q) hiδR) (j.range.pow_mem hiγR k)
    · rw [map_mul, map_mul] at hr
      have hreq : r = (ac * (aδ * g) * y) * ((aδ * g) * y) := by
        linear_combination (-r) * e2 - r * (ac * (aδ * g) * y) * aδ * e3 +
          (ac * (aδ * g) * y) * ((aδ * g) * y) * hr
      rw [hreq]
      exact j.range.mul_mem hiδR himR

  have hι₁inj : Function.Injective (algebraMap D (Localization.Away τ)) :=
    IsLocalization.injective (M := Submonoid.powers τ) _
      (powers_le_nonZeroDivisors_of_noZeroDivisors hτ)
  have hι₂inj : Function.Injective (algebraMap E (Localization.Away γ)) :=
    IsLocalization.injective (M := Submonoid.powers γ) _
      (powers_le_nonZeroDivisors_of_noZeroDivisors hγ)
  have hδD : IsUnit (algebraMap B D δ) := by
    rw [map_mul] at hUD; exact isUnit_of_mul_isUnit_left hUD
  have hδE : IsUnit (algebraMap B E δ) := by
    rw [map_mul] at hUE; exact isUnit_of_mul_isUnit_left hUE
  obtain ⟨j₁, hj₁inj, hj₁⟩ := s1 P₁ (Localization.Away τ)
    ((IsScalarTower.toAlgHom B D (Localization.Away τ)).comp κ₁) (u₁ * algebraMap B P₁ (δ * c))
    (by
      rw [AlgHom.comp_apply, IsScalarTower.toAlgHom_apply, map_mul, AlgHom.commutes, hu₁,
        map_mul, map_mul]
      exact ((hδD.map _).mul (IsLocalization.Away.algebraMap_isUnit τ)).mul (hUD.map _))
    (by
      intro p hp
      rw [AlgHom.comp_apply, IsScalarTower.toAlgHom_apply] at hp
      have h1 : κ₁ p = 0 := (map_eq_zero_iff _ hι₁inj).mp hp
      have h2 := hT₁ p h1
      rw [Algebra.smul_def] at h2
      rw [mul_assoc, h2, mul_zero])
  obtain ⟨j₂, hj₂inj, hj₂⟩ := s1 P₂ (Localization.Away γ)
    ((IsScalarTower.toAlgHom B E (Localization.Away γ)).comp κ₂) (u₂ * algebraMap B P₂ (δ * c))
    (by
      rw [AlgHom.comp_apply, IsScalarTower.toAlgHom_apply, map_mul, AlgHom.commutes, hu₂,
        map_mul, map_mul]
      exact ((hδE.map _).mul (IsLocalization.Away.algebraMap_isUnit γ)).mul (hUE.map _))
    (by
      intro q hq
      rw [AlgHom.comp_apply, IsScalarTower.toAlgHom_apply] at hq
      have h1 : κ₂ q = 0 := (map_eq_zero_iff _ hι₂inj).mp hq
      have h2 := hT₂ q h1
      rw [Algebra.smul_def] at h2
      rw [mul_assoc, h2, mul_zero])
  have hj₁' : ∀ p : P₁, j₁ (algebraMap P₁ (Localization.Away (u₁ * algebraMap B P₁ (δ * c))) p) =
      algebraMap D (Localization.Away τ) (κ₁ p) := hj₁
  have hj₂' : ∀ q : P₂, j₂ (algebraMap P₂ (Localization.Away (u₂ * algebraMap B P₂ (δ * c))) q) =
      algebraMap E (Localization.Away γ) (κ₂ q) := hj₂
  obtain ⟨h3i₁, h3ii₁⟩ := s3 D P₁ κ₁ τ u₁ j₁ hj₁' hu₁
  obtain ⟨h3i₂, h3ii₂⟩ := s3 E P₂ κ₂ γ u₂ j₂ hj₂' hu₂

  have hw₁ : j₁ (algebraMap P₁ _ (u₁ * algebraMap B P₁ (δ * c))) =
      algebraMap D (Localization.Away τ) τ * algebraMap B (Localization.Away τ) (δ * (δ * c)) := by
    rw [hj₁', map_mul, AlgHom.commutes, hu₁,
      IsScalarTower.algebraMap_apply B D (Localization.Away τ) (δ * (δ * c))]
    simp only [map_mul]
    ring
  have hw₂ : j₂ (algebraMap P₂ _ (u₂ * algebraMap B P₂ (δ * c))) =
      algebraMap E (Localization.Away γ) γ * algebraMap B (Localization.Away γ) (δ * (δ * c)) := by
    rw [hj₂', map_mul, AlgHom.commutes, hu₂,
      IsScalarTower.algebraMap_apply B E (Localization.Away γ) (δ * (δ * c))]
    simp only [map_mul]
    ring

  have hle₁ : ((Φ : Localization.Away τ →ₐ[B] Localization.Away γ).comp j₁).range ≤ j₂.range := by
    refine s2 P₁ (Localization.Away γ) _ _ j₂.range G₁ hG₁ ?_ ?_
    · intro p hp
      obtain ⟨k, e, q, h1, h2⟩ := hgen₁ p hp
      have : (Φ : Localization.Away τ →ₐ[B] Localization.Away γ).comp j₁
          (algebraMap P₁ _ p) = Φ (algebraMap D (Localization.Away τ) (κ₁ p)) := by
        rw [AlgHom.comp_apply, hj₁']; rfl
      rw [this]
      exact h3i₂ _ k e q h1 h2
    · set x₁ := j₁ (IsLocalization.Away.invSelf (u₁ * algebraMap B P₁ (δ * c))) with hx₁
      have hx₁w : x₁ * (algebraMap D (Localization.Away τ) τ *
          algebraMap B (Localization.Away τ) (δ * (δ * c))) = 1 := by
        have h := congrArg j₁ (IsLocalization.Away.mul_invSelf
          (S := Localization.Away (u₁ * algebraMap B P₁ (δ * c))) (u₁ * algebraMap B P₁ (δ * c)))
        rw [map_mul, map_one, hw₁] at h
        rw [hx₁, mul_comm]; exact h
      have hx₁eq : x₁ = (x₁ * algebraMap D (Localization.Away τ) τ) *
          IsLocalization.Away.invSelf τ := by
        rw [mul_assoc, IsLocalization.Away.mul_invSelf, mul_one]
      have : (Φ : Localization.Away τ →ₐ[B] Localization.Away γ).comp j₁
          (IsLocalization.Away.invSelf (u₁ * algebraMap B P₁ (δ * c))) =
          Φ (x₁ * algebraMap D (Localization.Away τ) τ) * Φ (IsLocalization.Away.invSelf τ) := by
        simp only [AlgHom.comp_apply]
        change Φ x₁ = _
        conv_lhs => rw [hx₁eq]
        exact map_mul Φ _ _
      rw [this]
      refine j₂.range.mul_mem (h3ii₂ _ ?_) ?_
      · rw [← AlgEquiv.commutes Φ, ← map_mul, mul_assoc, hx₁w, map_one]
      · obtain ⟨k, e, q, h1, h2⟩ := hinv₁
        exact h3i₂ _ k e q h1 h2

  have hle₂ : ((Φ.symm : Localization.Away γ →ₐ[B] Localization.Away τ).comp j₂).range ≤
      j₁.range := by
    refine s2 P₂ (Localization.Away τ) _ _ j₁.range G₂ hG₂ ?_ ?_
    · intro q hq
      obtain ⟨k, e, p, h1, h2⟩ := hgen₂ q hq
      have : (Φ.symm : Localization.Away γ →ₐ[B] Localization.Away τ).comp j₂
          (algebraMap P₂ _ q) = Φ.symm (algebraMap E (Localization.Away γ) (κ₂ q)) := by
        rw [AlgHom.comp_apply, hj₂']; rfl
      rw [this]
      exact h3i₁ _ k e p h1 h2
    · set x₂ := j₂ (IsLocalization.Away.invSelf (u₂ * algebraMap B P₂ (δ * c))) with hx₂
      have hx₂w : x₂ * (algebraMap E (Localization.Away γ) γ *
          algebraMap B (Localization.Away γ) (δ * (δ * c))) = 1 := by
        have h := congrArg j₂ (IsLocalization.Away.mul_invSelf
          (S := Localization.Away (u₂ * algebraMap B P₂ (δ * c))) (u₂ * algebraMap B P₂ (δ * c)))
        rw [map_mul, map_one, hw₂] at h
        rw [hx₂, mul_comm]; exact h
      have hx₂eq : x₂ = (x₂ * algebraMap E (Localization.Away γ) γ) *
          IsLocalization.Away.invSelf γ := by
        rw [mul_assoc, IsLocalization.Away.mul_invSelf, mul_one]
      have : (Φ.symm : Localization.Away γ →ₐ[B] Localization.Away τ).comp j₂
          (IsLocalization.Away.invSelf (u₂ * algebraMap B P₂ (δ * c))) =
          Φ.symm (x₂ * algebraMap E (Localization.Away γ) γ) *
            Φ.symm (IsLocalization.Away.invSelf γ) := by
        simp only [AlgHom.comp_apply]
        change Φ.symm x₂ = _
        conv_lhs => rw [hx₂eq]
        exact map_mul Φ.symm _ _
      rw [this]
      refine j₁.range.mul_mem (h3ii₁ _ ?_) ?_
      · rw [← AlgEquiv.commutes Φ.symm, ← map_mul, mul_assoc, hx₂w, map_one]
      · obtain ⟨k, e, p, h1, h2⟩ := hinv₂
        exact h3i₁ _ k e p h1 h2

  set ψ := (Φ : Localization.Away τ →ₐ[B] Localization.Away γ).comp j₁ with hψdef
  have hψ : Function.Injective ψ := fun x y h => hj₁inj (Φ.injective h)
  have hS : ψ.range = j₂.range := by
    refine le_antisymm hle₁ ?_
    rintro y ⟨v, rfl⟩
    obtain ⟨v', hv'⟩ := hle₂ ⟨v, rfl⟩
    have hv'' : j₁ v' = Φ.symm (j₂ v) := hv'
    refine ⟨v', ?_⟩
    change Φ (j₁ v') = j₂ v
    rw [hv'', AlgEquiv.apply_symm_apply]
  exact ⟨(AlgEquiv.ofInjective ψ hψ).trans
    ((Subalgebra.equivOfEq _ _ hS).trans (AlgEquiv.ofInjective j₂ hj₂inj).symm)⟩

theorem wc_geom_preirr_descend_model : ∀ (A R : Type u) [CommRing A] [IsDomain A] [IsNoetherianRing A] [CommRing R] [Algebra A R] [Algebra.FiniteType A R] (n : ℕ) (F g : MvPolynomial (Fin n) (AlgebraicClosure (FractionRing A))) (t : TensorProduct A (AlgebraicClosure (FractionRing A)) R ⧸ nilradical (TensorProduct A (AlgebraicClosure (FractionRing A)) R)), (nilradical (TensorProduct A (AlgebraicClosure (FractionRing A)) R)).IsPrime → Irreducible F → t ≠ 0 → Nonempty (Localization.Away t ≃ₐ[AlgebraicClosure (FractionRing A)] Localization.Away (Ideal.Quotient.mk (Ideal.span {F}) g)) → ∃ (A' : Type u) (_ : CommRing A') (_ : IsDomain A') (_ : Algebra A A'), Function.Injective (algebraMap A A') ∧ Algebra.IsIntegral A A' ∧ Algebra.FiniteType A A' ∧ ∃ (b : A') (Q : Ideal (TensorProduct A A' R)) (N : ℕ) (h : TensorProduct A A' R) (m : ℕ) (F' g' : MvPolynomial (Fin m) A'), b ≠ 0 ∧ (∀ x ∈ Q ^ N, b • x = 0) ∧ (∀ s : TensorProduct A A' R ⧸ Q, Ideal.Quotient.mk Q h * s = 0 → ∃ c : A', c ≠ 0 ∧ c • s = 0) ∧ Irreducible (MvPolynomial.map (algebraMap A' (AlgebraicClosure (FractionRing A'))) F') ∧ Nonempty (Localization.Away (Ideal.Quotient.mk Q (h * algebraMap A' (TensorProduct A A' R) b)) ≃ₐ[A'] Localization.Away (Ideal.Quotient.mk (Ideal.span {F'}) (g' * MvPolynomial.C b))) :=
by
  intro A R _ _ _ _ _ _
  classical
  suffices key : ∀ (L : Type u) [Field L] [IsAlgClosed L] [Algebra A L],
      Function.Injective (algebraMap A L) → Algebra.IsAlgebraic A L →
      ∀ (n : ℕ) (F g : MvPolynomial (Fin n) L)
        (t : TensorProduct A L R ⧸ nilradical (TensorProduct A L R)),
      (nilradical (TensorProduct A L R)).IsPrime → Irreducible F → t ≠ 0 →
      Nonempty (Localization.Away t ≃ₐ[L] Localization.Away (Ideal.Quotient.mk (Ideal.span {F}) g)) →
      ∃ (A' : Type u) (_ : CommRing A') (_ : IsDomain A') (_ : Algebra A A'),
        Function.Injective (algebraMap A A') ∧ Algebra.IsIntegral A A' ∧ Algebra.FiniteType A A' ∧
        ∃ (b : A') (Q : Ideal (TensorProduct A A' R)) (N : ℕ) (h : TensorProduct A A' R) (m : ℕ)
          (F' g' : MvPolynomial (Fin m) A'), b ≠ 0 ∧ (∀ x ∈ Q ^ N, b • x = 0) ∧
          (∀ s : TensorProduct A A' R ⧸ Q, Ideal.Quotient.mk Q h * s = 0 →
            ∃ c : A', c ≠ 0 ∧ c • s = 0) ∧
          Irreducible (MvPolynomial.map (algebraMap A' (AlgebraicClosure (FractionRing A'))) F') ∧
          Nonempty (Localization.Away (Ideal.Quotient.mk Q (h * algebraMap A' (TensorProduct A A' R) b))
            ≃ₐ[A'] Localization.Away (Ideal.Quotient.mk (Ideal.span {F'}) (g' * MvPolynomial.C b))) by
    have hinjL : Function.Injective (algebraMap A (AlgebraicClosure (FractionRing A))) := by
      rw [IsScalarTower.algebraMap_eq A (FractionRing A) (AlgebraicClosure (FractionRing A))]
      exact (algebraMap (FractionRing A) (AlgebraicClosure (FractionRing A))).injective.comp
        (IsFractionRing.injective _ _)
    have halgL : Algebra.IsAlgebraic A (AlgebraicClosure (FractionRing A)) :=
      ⟨fun x => (IsFractionRing.isAlgebraic_iff A (FractionRing A)
        (AlgebraicClosure (FractionRing A))).mpr (Algebra.IsAlgebraic.isAlgebraic x)⟩
    exact key _ hinjL halgL
  intro L _ _ _ hinj halg n F g t hnil hF ht ⟨Φ⟩
  haveI := halg
  haveI : (nilradical (TensorProduct A L R)).IsPrime := hnil
  haveI hFprime : (Ideal.span {F}).IsPrime :=
    (Ideal.span_singleton_prime hF.ne_zero).mpr
      (UniqueFactorizationMonoid.irreducible_iff_prime.mp hF)

  have hDinj : Function.Injective (algebraMap (TensorProduct A L R ⧸ nilradical (TensorProduct A L R))
      (Localization.Away t)) :=
    IsLocalization.injective (M := Submonoid.powers t) _
      (powers_le_nonZeroDivisors_of_noZeroDivisors ht)

  have hγ : Ideal.Quotient.mk (Ideal.span {F}) g ≠ 0 := by
    intro h0
    haveI : Subsingleton (Localization.Away (Ideal.Quotient.mk (Ideal.span {F}) g)) :=
      IsLocalization.subsingleton (M := Submonoid.powers (Ideal.Quotient.mk (Ideal.span {F}) g))
        (by rw [h0]; exact Submonoid.mem_powers 0)
    have h1 : (1 : Localization.Away t) = 0 := Φ.injective (Subsingleton.elim _ _)
    apply one_ne_zero (α := TensorProduct A L R ⧸ nilradical (TensorProduct A L R))
    apply hDinj
    rw [map_one, map_zero]
    exact h1
  obtain ⟨τ₀, rfl⟩ := Ideal.Quotient.mk_surjective t

  obtain ⟨T, hT⟩ := (Algebra.FiniteType.out : (⊤ : Subalgebra A R).FG)
  have c1 : ∀ r : R, ∃ (k : ℕ) (P : MvPolynomial (Fin n) L),
      Φ (algebraMap (TensorProduct A L R ⧸ nilradical (TensorProduct A L R))
          (Localization.Away (Ideal.Quotient.mk (nilradical (TensorProduct A L R)) τ₀))
          (Ideal.Quotient.mk (nilradical (TensorProduct A L R)) (TensorProduct.tmul A (1 : L) r))) *
        algebraMap (MvPolynomial (Fin n) L ⧸ Ideal.span {F})
          (Localization.Away (Ideal.Quotient.mk (Ideal.span {F}) g))
          (Ideal.Quotient.mk (Ideal.span {F}) g) ^ k =
        algebraMap (MvPolynomial (Fin n) L ⧸ Ideal.span {F})
          (Localization.Away (Ideal.Quotient.mk (Ideal.span {F}) g))
          (Ideal.Quotient.mk (Ideal.span {F}) P) := by
    intro r
    obtain ⟨k, e, he⟩ := IsLocalization.Away.surj (Ideal.Quotient.mk (Ideal.span {F}) g)
      (Φ (algebraMap (TensorProduct A L R ⧸ nilradical (TensorProduct A L R))
          (Localization.Away (Ideal.Quotient.mk (nilradical (TensorProduct A L R)) τ₀))
          (Ideal.Quotient.mk (nilradical (TensorProduct A L R)) (TensorProduct.tmul A (1 : L) r))))
    obtain ⟨P, rfl⟩ := Ideal.Quotient.mk_surjective e
    exact ⟨k, P, he⟩
  choose kr Pr hPr using c1
  obtain ⟨k₀, P₀, hP₀⟩ : ∃ (k : ℕ) (P : MvPolynomial (Fin n) L),
      Φ (IsLocalization.Away.invSelf (Ideal.Quotient.mk (nilradical (TensorProduct A L R)) τ₀)) *
        algebraMap (MvPolynomial (Fin n) L ⧸ Ideal.span {F})
          (Localization.Away (Ideal.Quotient.mk (Ideal.span {F}) g))
          (Ideal.Quotient.mk (Ideal.span {F}) g) ^ k =
        algebraMap (MvPolynomial (Fin n) L ⧸ Ideal.span {F})
          (Localization.Away (Ideal.Quotient.mk (Ideal.span {F}) g))
          (Ideal.Quotient.mk (Ideal.span {F}) P) := by
    obtain ⟨k, e, he⟩ := IsLocalization.Away.surj (Ideal.Quotient.mk (Ideal.span {F}) g)
      (Φ (IsLocalization.Away.invSelf (Ideal.Quotient.mk (nilradical (TensorProduct A L R)) τ₀)))
    obtain ⟨P, rfl⟩ := Ideal.Quotient.mk_surjective e
    exact ⟨k, P, he⟩
  have c3 : ∀ i : Fin n, ∃ (k : ℕ) (f : TensorProduct A L R),
      Φ.symm (algebraMap (MvPolynomial (Fin n) L ⧸ Ideal.span {F})
          (Localization.Away (Ideal.Quotient.mk (Ideal.span {F}) g))
          (Ideal.Quotient.mk (Ideal.span {F}) (MvPolynomial.X i))) *
        algebraMap (TensorProduct A L R ⧸ nilradical (TensorProduct A L R))
          (Localization.Away (Ideal.Quotient.mk (nilradical (TensorProduct A L R)) τ₀))
          (Ideal.Quotient.mk (nilradical (TensorProduct A L R)) τ₀) ^ k =
        algebraMap (TensorProduct A L R ⧸ nilradical (TensorProduct A L R))
          (Localization.Away (Ideal.Quotient.mk (nilradical (TensorProduct A L R)) τ₀))
          (Ideal.Quotient.mk (nilradical (TensorProduct A L R)) f) := by
    intro i
    obtain ⟨k, e, he⟩ := IsLocalization.Away.surj
      (Ideal.Quotient.mk (nilradical (TensorProduct A L R)) τ₀)
      (Φ.symm (algebraMap (MvPolynomial (Fin n) L ⧸ Ideal.span {F})
          (Localization.Away (Ideal.Quotient.mk (Ideal.span {F}) g))
          (Ideal.Quotient.mk (Ideal.span {F}) (MvPolynomial.X i))))
    obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective e
    exact ⟨k, f, he⟩
  choose li fi hfi using c3
  obtain ⟨l₀, f₀, hf₀⟩ : ∃ (k : ℕ) (f : TensorProduct A L R),
      Φ.symm (IsLocalization.Away.invSelf (Ideal.Quotient.mk (Ideal.span {F}) g)) *
        algebraMap (TensorProduct A L R ⧸ nilradical (TensorProduct A L R))
          (Localization.Away (Ideal.Quotient.mk (nilradical (TensorProduct A L R)) τ₀))
          (Ideal.Quotient.mk (nilradical (TensorProduct A L R)) τ₀) ^ k =
        algebraMap (TensorProduct A L R ⧸ nilradical (TensorProduct A L R))
          (Localization.Away (Ideal.Quotient.mk (nilradical (TensorProduct A L R)) τ₀))
          (Ideal.Quotient.mk (nilradical (TensorProduct A L R)) f) := by
    obtain ⟨k, e, he⟩ := IsLocalization.Away.surj
      (Ideal.Quotient.mk (nilradical (TensorProduct A L R)) τ₀)
      (Φ.symm (IsLocalization.Away.invSelf (Ideal.Quotient.mk (Ideal.span {F}) g)))
    obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective e
    exact ⟨k, f, he⟩

  obtain ⟨A', d, hd0, hint, hfg, hlX, hlP⟩ := wc_descend_finite_data A R L hinj halg n
    (insert τ₀ (insert f₀ (Finset.univ.image fi)))
    (insert F (insert g (insert P₀ (T.image Pr))))
  choose! liftX hliftX using hlX
  choose! liftP hliftP using hlP
  have hmemτ : τ₀ ∈ insert τ₀ (insert f₀ (Finset.univ.image fi)) := Finset.mem_insert_self _ _
  have hmemf₀ : f₀ ∈ insert τ₀ (insert f₀ (Finset.univ.image fi)) :=
    Finset.mem_insert_of_mem (Finset.mem_insert_self _ _)
  have hmemfi : ∀ i, fi i ∈ insert τ₀ (insert f₀ (Finset.univ.image fi)) := fun i =>
    Finset.mem_insert_of_mem (Finset.mem_insert_of_mem
      (Finset.mem_image_of_mem fi (Finset.mem_univ i)))
  have hmemF : F ∈ insert F (insert g (insert P₀ (T.image Pr))) := Finset.mem_insert_self _ _
  have hmemg : g ∈ insert F (insert g (insert P₀ (T.image Pr))) :=
    Finset.mem_insert_of_mem (Finset.mem_insert_self _ _)
  have hmemP₀ : P₀ ∈ insert F (insert g (insert P₀ (T.image Pr))) :=
    Finset.mem_insert_of_mem (Finset.mem_insert_of_mem (Finset.mem_insert_self _ _))
  have hmemPr : ∀ r ∈ T, Pr r ∈ insert F (insert g (insert P₀ (T.image Pr))) := fun r hr =>
    Finset.mem_insert_of_mem (Finset.mem_insert_of_mem (Finset.mem_insert_of_mem
      (Finset.mem_image_of_mem Pr hr)))
  haveI : Algebra.FiniteType A A' := (Subalgebra.fg_iff_finiteType _).mp hfg
  haveI : IsNoetherianRing A' := Algebra.FiniteType.isNoetherianRing A A'
  have hinjA' : Function.Injective (algebraMap A A') := by
    intro x y hxy
    apply hinj
    have := congrArg (algebraMap A' L) hxy
    exact this
  have hδ0 : algebraMap A A' d ≠ 0 := fun h0 => hd0 (hinjA' (h0.trans (map_zero _).symm))
  have hdL : algebraMap A L d ≠ 0 := (map_ne_zero_iff _ hinj).mpr hd0

  obtain ⟨N, b₁, hb₁0, hb₁⟩ := wc_tensor_nil_kernel_pow_torsion A A' R L Subtype.val_injective
  obtain ⟨κ₁, hκ₁def⟩ : ∃ κ : TensorProduct A A' R →ₐ[A']
      (TensorProduct A L R ⧸ nilradical (TensorProduct A L R)),
      κ = (Ideal.Quotient.mkₐ A' (nilradical (TensorProduct A L R))).comp
        (Algebra.TensorProduct.map (Algebra.ofId A' L) (AlgHom.id A R)) := ⟨_, rfl⟩
  replace hb₁ : ∀ x ∈ (RingHom.ker κ₁) ^ N, b₁ • x = 0 := by
    subst hκ₁def; exact hb₁
  letI iQ : CommRing (TensorProduct A A' R ⧸ RingHom.ker κ₁) := Ideal.Quotient.commRing _
  letI iQa : Algebra A' (TensorProduct A A' R ⧸ RingHom.ker κ₁) := Ideal.Quotient.algebra A'

  obtain ⟨κ₂, c₂, hc₂0, hκ₂, hc₂⟩ := wc_mvpoly_quotient_descent_kernel_torsion A' L
    Subtype.val_injective n F (liftP F) (algebraMap A L d) hdL (hliftP F hmemF)

  have hκ₁lift : ∀ x ∈ insert τ₀ (insert f₀ (Finset.univ.image fi)),
      κ₁ (liftX x) = algebraMap A' (TensorProduct A L R ⧸ nilradical (TensorProduct A L R))
        (algebraMap A A' d) * Ideal.Quotient.mk (nilradical (TensorProduct A L R)) x := by
    intro x hx
    rw [hκ₁def]
    change Ideal.Quotient.mk (nilradical (TensorProduct A L R))
      (Algebra.TensorProduct.map (Algebra.ofId A' L) (AlgHom.id A R) (liftX x)) = _
    rw [hliftX x hx, map_mul]
    rfl
  have hκ₁one : ∀ r : R, κ₁ (TensorProduct.tmul A (1 : A') r) =
      Ideal.Quotient.mk (nilradical (TensorProduct A L R)) (TensorProduct.tmul A (1 : L) r) := by
    intro r
    rw [hκ₁def]
    change Ideal.Quotient.mk (nilradical (TensorProduct A L R))
      (Algebra.TensorProduct.map (Algebra.ofId A' L) (AlgHom.id A R) (TensorProduct.tmul A (1 : A') r)) = _
    rw [Algebra.TensorProduct.map_tmul, map_one, AlgHom.id_apply]
  have hκ₂lift : ∀ P ∈ insert F (insert g (insert P₀ (T.image Pr))),
      κ₂ (Ideal.Quotient.mk (Ideal.span {liftP F}) (liftP P)) =
        algebraMap A' (MvPolynomial (Fin n) L ⧸ Ideal.span {F}) (algebraMap A A' d) *
          Ideal.Quotient.mk (Ideal.span {F}) P := by
    intro P hP
    rw [hκ₂, hliftP P hP, map_mul, ← MvPolynomial.algebraMap_eq, Ideal.Quotient.mk_algebraMap,
      IsScalarTower.algebraMap_apply A' L (MvPolynomial (Fin n) L ⧸ Ideal.span {F})]
    rfl
  have hunitD : ∀ x : A', x ≠ 0 →
      IsUnit (algebraMap A' (TensorProduct A L R ⧸ nilradical (TensorProduct A L R)) x) := by
    intro x hx
    rw [IsScalarTower.algebraMap_apply A' L (TensorProduct A L R ⧸ nilradical (TensorProduct A L R))]
    exact (isUnit_iff_ne_zero.mpr ((map_ne_zero_iff _ Subtype.val_injective).mpr hx)).map _
  have hunitE : ∀ x : A', x ≠ 0 →
      IsUnit (algebraMap A' (MvPolynomial (Fin n) L ⧸ Ideal.span {F}) x) := by
    intro x hx
    rw [IsScalarTower.algebraMap_apply A' L (MvPolynomial (Fin n) L ⧸ Ideal.span {F})]
    exact (isUnit_iff_ne_zero.mpr ((map_ne_zero_iff _ Subtype.val_injective).mpr hx)).map _
  have hgen1 : Algebra.adjoin A' ((Ideal.Quotient.mkₐ A' (RingHom.ker κ₁)) ''
      ((fun x => TensorProduct.tmul A (1 : A') x) '' (T : Set R))) = ⊤ := by
    rw [Algebra.adjoin_image, Algebra.TensorProduct.adjoin_one_tmul_image_eq_top _ hT,
      Algebra.map_top, AlgHom.range_eq_top]
    exact Ideal.Quotient.mkₐ_surjective _ _
  have hgen2 : Algebra.adjoin A' ((Ideal.Quotient.mkₐ A' (Ideal.span {liftP F})) ''
      Set.range MvPolynomial.X) = ⊤ := by
    rw [Algebra.adjoin_image, MvPolynomial.adjoin_range_X, Algebra.map_top, AlgHom.range_eq_top]
    exact Ideal.Quotient.mkₐ_surjective _ _
  have hm0 : algebraMap A A' d * (b₁ * c₂) ≠ 0 := mul_ne_zero hδ0 (mul_ne_zero hb₁0 hc₂0)
  refine ⟨A', inferInstance, inferInstance, inferInstance, hinjA', hint, inferInstance,
    algebraMap A A' d * (b₁ * c₂), RingHom.ker κ₁, N, liftX τ₀, n, liftP F, liftP g,
    hm0, ?_, ?_, ?_, ?_⟩
  ·
    intro x hx
    rw [mul_comm b₁ c₂, ← mul_assoc, mul_smul, hb₁ x hx, smul_zero]
  ·
    intro s hs
    have h1 := congrArg (Ideal.kerLiftAlg κ₁) hs
    rw [map_mul, map_zero, Ideal.kerLiftAlg_mk, hκ₁lift τ₀ hmemτ] at h1
    have hne : algebraMap A' (TensorProduct A L R ⧸ nilradical (TensorProduct A L R))
        (algebraMap A A' d) * Ideal.Quotient.mk (nilradical (TensorProduct A L R)) τ₀ ≠ 0 :=
      mul_ne_zero (hunitD _ hδ0).ne_zero ht
    have h2 : Ideal.kerLiftAlg κ₁ s = 0 := (mul_eq_zero.mp h1).resolve_left hne
    have h3 : s = 0 := Ideal.kerLiftAlg_injective κ₁ (h2.trans (map_zero _).symm)
    exact ⟨1, one_ne_zero, by rw [h3, smul_zero]⟩
  ·
    have hirr : Irreducible (MvPolynomial.map (algebraMap A' L) (liftP F)) := by
      rw [hliftP F hmemF]
      exact (irreducible_isUnit_mul ((isUnit_iff_ne_zero.mpr hdL).map MvPolynomial.C)).mpr hF
    have halg' : Algebra.IsAlgebraic A' L := Algebra.IsAlgebraic.extendScalars hinjA'
    exact wc_mvpoly_irreducible_algClosure_transfer A' L Subtype.val_injective halg' n (liftP F) hirr
  ·
    letI iP : CommRing (MvPolynomial (Fin n) A' ⧸ Ideal.span {liftP F}) := Ideal.Quotient.commRing _
    letI iPa : Algebra A' (MvPolynomial (Fin n) A' ⧸ Ideal.span {liftP F}) := Ideal.Quotient.algebra A'
    rw [RingHom.map_mul (Ideal.Quotient.mk (RingHom.ker κ₁)),
      RingHom.map_mul (Ideal.Quotient.mk (Ideal.span {liftP F})),
      Ideal.Quotient.mk_algebraMap, ← MvPolynomial.algebraMap_eq, Ideal.Quotient.mk_algebraMap]
    refine wc_descend_away_iso A' _ _ _ _ (Ideal.kerLiftAlg κ₁) κ₂ _ _ ?iso
      (Ideal.Quotient.mk (RingHom.ker κ₁) (liftX τ₀))
      (Ideal.Quotient.mk (Ideal.span {liftP F}) (liftP g))
      (algebraMap A A' d) (b₁ * c₂) _ _ ht hγ (hunitD _ hm0) (hunitE _ hm0) ?_ ?_ ?_ ?_
      hgen1 hgen2 ?_ ?_ ?_ ?_
    case iso =>
      refine @AlgEquiv.mk A' _ _ _ _ _ ?i1 ?i2 Φ.toEquiv Φ.map_mul' Φ.map_add' ?commz
      case commz =>
      intro x
      change Φ (algebraMap (TensorProduct A L R ⧸ nilradical (TensorProduct A L R))
          (Localization.Away (Ideal.Quotient.mk (nilradical (TensorProduct A L R)) τ₀))
          (algebraMap A' (TensorProduct A L R ⧸ nilradical (TensorProduct A L R)) x)) =
        algebraMap (MvPolynomial (Fin n) L ⧸ Ideal.span {F})
          (Localization.Away (Ideal.Quotient.mk (Ideal.span {F}) g))
          (algebraMap A' (MvPolynomial (Fin n) L ⧸ Ideal.span {F}) x)
      have h1 : algebraMap (TensorProduct A L R ⧸ nilradical (TensorProduct A L R))
          (Localization.Away (Ideal.Quotient.mk (nilradical (TensorProduct A L R)) τ₀))
          (algebraMap A' (TensorProduct A L R ⧸ nilradical (TensorProduct A L R)) x) =
          algebraMap L
          (Localization.Away (Ideal.Quotient.mk (nilradical (TensorProduct A L R)) τ₀))
          (x : L) := by
        rw [IsScalarTower.algebraMap_apply L (TensorProduct A L R ⧸ nilradical (TensorProduct A L R))
          (Localization.Away (Ideal.Quotient.mk (nilradical (TensorProduct A L R)) τ₀))]
        rfl
      have h2 : algebraMap (MvPolynomial (Fin n) L ⧸ Ideal.span {F})
          (Localization.Away (Ideal.Quotient.mk (Ideal.span {F}) g))
          (algebraMap A' (MvPolynomial (Fin n) L ⧸ Ideal.span {F}) x) =
          algebraMap L (Localization.Away (Ideal.Quotient.mk (Ideal.span {F}) g)) (x : L) := by
        rw [IsScalarTower.algebraMap_apply L (MvPolynomial (Fin n) L ⧸ Ideal.span {F})
          (Localization.Away (Ideal.Quotient.mk (Ideal.span {F}) g))]
        rfl
      rw [h1, h2]
      exact Φ.commutes _
    · rw [Ideal.kerLiftAlg_mk, hκ₁lift τ₀ hmemτ]
    · exact hκ₂lift g hmemg
    · intro p hp
      rw [Ideal.kerLiftAlg_injective κ₁ (hp.trans (map_zero _).symm), smul_zero]
    · intro q hq
      rw [← mul_assoc, mul_smul, hc₂ q hq, smul_zero]
    · rintro _ ⟨_, ⟨r, hr, rfl⟩, rfl⟩
      refine ⟨kr r, Ideal.Quotient.mk (Ideal.span {F}) (Pr r),
        Ideal.Quotient.mk (Ideal.span {liftP F}) (liftP (Pr r)), ?_, hκ₂lift _ (hmemPr r hr)⟩
      rw [Ideal.Quotient.mkₐ_eq_mk, Ideal.kerLiftAlg_mk, hκ₁one]
      exact hPr r
    · exact ⟨k₀, Ideal.Quotient.mk (Ideal.span {F}) P₀,
        Ideal.Quotient.mk (Ideal.span {liftP F}) (liftP P₀), hP₀, hκ₂lift P₀ hmemP₀⟩
    · rintro _ ⟨_, ⟨i, rfl⟩, rfl⟩
      refine ⟨li i, Ideal.Quotient.mk (nilradical (TensorProduct A L R)) (fi i),
        Ideal.Quotient.mk (RingHom.ker κ₁) (liftX (fi i)), ?_, ?_⟩
      · rw [Ideal.Quotient.mkₐ_eq_mk, hκ₂, MvPolynomial.map_X]
        exact hfi i
      · rw [Ideal.kerLiftAlg_mk]
        exact hκ₁lift _ (hmemfi i)
    · refine ⟨l₀, Ideal.Quotient.mk (nilradical (TensorProduct A L R)) f₀,
        Ideal.Quotient.mk (RingHom.ker κ₁) (liftX f₀), hf₀, ?_⟩
      rw [Ideal.kerLiftAlg_mk]
      exact hκ₁lift _ hmemf₀

theorem wc_mvpoly_geom_irreducible_spread : ∀ (B : Type u) [CommRing B] [IsDomain B] (n : ℕ) (F : MvPolynomial (Fin n) B), Irreducible (MvPolynomial.map (algebraMap B (AlgebraicClosure (FractionRing B))) F) → ∃ c : B, c ≠ 0 ∧ ∀ (Ω : Type u) [Field Ω] (ψ : B →+* Ω), ψ c ≠ 0 → Irreducible (MvPolynomial.map ψ F) :=
by
  intro B _ _ n F hirr
  classical


  have descent : ∀ (σ : Type) [Fintype σ] (S : Finset (MvPolynomial σ B)),
      (∀ z : σ → AlgebraicClosure (FractionRing B), ∃ s ∈ S,
        MvPolynomial.eval₂ (algebraMap B (AlgebraicClosure (FractionRing B))) z s ≠ 0) →
      ∃ r : B, r ≠ 0 ∧ ∀ (M : Type u) [Field M] (ψ : B →+* M), ψ r ≠ 0 →
        ∀ z : σ → M, ∃ s ∈ S, MvPolynomial.eval₂ ψ z s ≠ 0 := by
    intro σ _ S hS
    have h1 : Ideal.span ((MvPolynomial.map (algebraMap B (FractionRing B))) ''
        (S : Set (MvPolynomial σ B))) = ⊤ := by
      have hz : MvPolynomial.zeroLocus (AlgebraicClosure (FractionRing B))
          (Ideal.span ((MvPolynomial.map (algebraMap B (FractionRing B))) ''
            (S : Set (MvPolynomial σ B)))) = ∅ := by
        apply Set.eq_empty_of_forall_notMem
        intro z hz
        rw [MvPolynomial.mem_zeroLocus_iff] at hz
        obtain ⟨s, hs, hne⟩ := hS z
        apply hne
        have h := hz (MvPolynomial.map (algebraMap B (FractionRing B)) s)
          (Ideal.subset_span ⟨s, hs, rfl⟩)
        rw [MvPolynomial.aeval_def, MvPolynomial.eval₂_map,
          ← IsScalarTower.algebraMap_eq] at h
        exact h
      have h := MvPolynomial.vanishingIdeal_zeroLocus_eq_radical
        (K := AlgebraicClosure (FractionRing B))
        (Ideal.span ((MvPolynomial.map (algebraMap B (FractionRing B))) ''
            (S : Set (MvPolynomial σ B))))
      rw [hz, MvPolynomial.vanishingIdeal_empty] at h
      exact Ideal.radical_eq_top.mp h.symm
    have h2 : ∃ r : B, r ≠ 0 ∧ MvPolynomial.C r ∈ Ideal.span (S : Set (MvPolynomial σ B)) := by
      letI : Algebra (MvPolynomial σ B) (MvPolynomial σ (FractionRing B)) :=
        MvPolynomial.algebraMvPolynomial
      haveI := MvPolynomial.isLocalization (σ := σ) (nonZeroDivisors B) (FractionRing B)
      have hmem : (1 : MvPolynomial σ (FractionRing B)) ∈
          Ideal.map (algebraMap (MvPolynomial σ B) (MvPolynomial σ (FractionRing B)))
            (Ideal.span (S : Set (MvPolynomial σ B))) := by
        rw [Ideal.map_span]
        show (1 : MvPolynomial σ (FractionRing B)) ∈
          Ideal.span ((MvPolynomial.map (algebraMap B (FractionRing B))) ''
            (S : Set (MvPolynomial σ B)))
        rw [h1]
        exact Submodule.mem_top
      obtain ⟨⟨⟨q, hq⟩, ⟨c', hc'⟩⟩, hx⟩ :=
        (IsLocalization.mem_map_algebraMap_iff
          (Submonoid.map (MvPolynomial.C : B →+* MvPolynomial σ B) (nonZeroDivisors B))
          (MvPolynomial σ (FractionRing B))).mp hmem
      obtain ⟨c, hc, rfl⟩ := Submonoid.mem_map.mp hc'
      refine ⟨c, nonZeroDivisors.ne_zero hc, ?_⟩
      rw [one_mul] at hx
      have hinj : Function.Injective
          (MvPolynomial.map (σ := σ) (algebraMap B (FractionRing B))) :=
        MvPolynomial.map_injective _ (IsFractionRing.injective B (FractionRing B))
      have : (MvPolynomial.C c : MvPolynomial σ B) = q := hinj hx
      rw [this]
      exact hq
    obtain ⟨r, hr0, hr⟩ := h2
    refine ⟨r, hr0, ?_⟩
    intro M _ ψ hψ z
    by_contra hcon
    push_neg at hcon
    apply hψ
    have hle : Ideal.span (S : Set (MvPolynomial σ B)) ≤
        RingHom.ker (MvPolynomial.eval₂Hom ψ z) := by
      rw [Ideal.span_le]
      intro s hs
      rw [SetLike.mem_coe, RingHom.mem_ker, MvPolynomial.coe_eval₂Hom]
      exact hcon s hs
    have h := hle hr
    rw [RingHom.mem_ker, MvPolynomial.eval₂Hom_C] at h
    exact h

  have encode : ∀ a e : ℕ, ∃ (σ : Type) (_ : Fintype σ) (S : Finset (MvPolynomial σ B)),
      ∀ (K : Type u) [Field K] (ψ : B →+* K),
        (∀ z : σ → K, (∀ s ∈ S, MvPolynomial.eval₂ ψ z s = 0) →
          ∃ G H : MvPolynomial (Fin n) K, G.totalDegree ≤ a ∧ H.totalDegree ≤ e ∧
            G * H = MvPolynomial.map ψ F) ∧
        (∀ G H : MvPolynomial (Fin n) K, G.totalDegree ≤ a → H.totalDegree ≤ e →
          G * H = MvPolynomial.map ψ F → ∃ z : σ → K, ∀ s ∈ S, MvPolynomial.eval₂ ψ z s = 0) := by
    intro a e
    let M : ℕ → Finset (Fin n →₀ ℕ) := fun b =>
      (Finset.range (b + 1)).biUnion (fun d => (Finset.univ : Finset (Fin n)).finsuppAntidiag d)
    have hM : ∀ (b : ℕ) (μ : Fin n →₀ ℕ), μ ∈ M b ↔ (μ.sum fun _ e => e) ≤ b := by
      intro b μ
      simp only [M, Finset.mem_biUnion, Finset.mem_range, Finset.mem_finsuppAntidiag,
        Finset.subset_univ, and_true]
      rw [Finsupp.sum_fintype _ _ (fun _ => rfl)]
      constructor
      · rintro ⟨d, hd, h⟩
        have h' : ∑ i, μ i = d := h
        omega
      · intro h
        exact ⟨∑ i, μ i, by omega, rfl⟩
    let P : MvPolynomial (Fin n) (MvPolynomial ({μ // μ ∈ M a} ⊕ {ν // ν ∈ M e}) B) :=
      (∑ μ : {μ // μ ∈ M a}, MvPolynomial.monomial μ.1 (MvPolynomial.X (Sum.inl μ))) *
      (∑ ν : {ν // ν ∈ M e}, MvPolynomial.monomial ν.1 (MvPolynomial.X (Sum.inr ν))) -
      MvPolynomial.map MvPolynomial.C F
    refine ⟨{μ // μ ∈ M a} ⊕ {ν // ν ∈ M e}, inferInstance,
      P.support.image (fun ρ => P.coeff ρ), ?_⟩
    intro K _ ψ
    have hmapP : ∀ z : {μ // μ ∈ M a} ⊕ {ν // ν ∈ M e} → K,
        MvPolynomial.map (MvPolynomial.eval₂Hom ψ z) P =
        (∑ μ : {μ // μ ∈ M a}, MvPolynomial.monomial μ.1 (z (Sum.inl μ))) *
        (∑ ν : {ν // ν ∈ M e}, MvPolynomial.monomial ν.1 (z (Sum.inr ν))) -
        MvPolynomial.map ψ F := by
      intro z
      simp only [P, map_sub, map_mul, map_sum, MvPolynomial.map_monomial,
        MvPolynomial.eval₂Hom_X', MvPolynomial.map_map, MvPolynomial.eval₂Hom_comp_C]
    have hzero : ∀ z : {μ // μ ∈ M a} ⊕ {ν // ν ∈ M e} → K,
        (∀ s ∈ P.support.image (fun ρ => P.coeff ρ), MvPolynomial.eval₂ ψ z s = 0) ↔
        MvPolynomial.map (MvPolynomial.eval₂Hom ψ z) P = 0 := by
      intro z
      constructor
      · intro h
        apply MvPolynomial.ext
        intro ρ
        rw [MvPolynomial.coeff_map]
        by_cases hρ : ρ ∈ P.support
        · rw [MvPolynomial.coe_eval₂Hom, h _ (Finset.mem_image_of_mem _ hρ)]
          simp
        · rw [MvPolynomial.notMem_support_iff.mp hρ, map_zero]
          simp
      · intro h s hs
        obtain ⟨ρ, -, rfl⟩ := Finset.mem_image.mp hs
        have := (MvPolynomial.ext_iff.mp h) ρ
        rw [MvPolynomial.coeff_map, MvPolynomial.coe_eval₂Hom] at this
        simpa using this
    have hdeg : ∀ (b : ℕ) (g : {μ // μ ∈ M b} → K),
        (∑ μ : {μ // μ ∈ M b}, MvPolynomial.monomial μ.1 (g μ)).totalDegree ≤ b := by
      intro b g
      refine (MvPolynomial.totalDegree_finsetSum _ _).trans (Finset.sup_le fun μ _ => ?_)
      exact (MvPolynomial.totalDegree_monomial_le _ _).trans ((hM b μ.1).mp μ.2)
    have hrecon : ∀ (b : ℕ) (G : MvPolynomial (Fin n) K), G.totalDegree ≤ b →
        (∑ μ : {μ // μ ∈ M b}, MvPolynomial.monomial μ.1 (G.coeff μ.1)) = G := by
      intro b G hG
      rw [Finset.sum_coe_sort (M b) (fun μ => MvPolynomial.monomial μ (G.coeff μ))]
      conv_rhs => rw [G.as_sum]
      symm
      apply Finset.sum_subset
      · intro μ hμ
        exact (hM b μ).mpr ((MvPolynomial.le_totalDegree hμ).trans hG)
      · intro μ _ hμ
        rw [MvPolynomial.notMem_support_iff.mp hμ, map_zero]
    constructor
    · intro z hz
      refine ⟨_, _, hdeg a (fun μ => z (Sum.inl μ)), hdeg e (fun ν => z (Sum.inr ν)), ?_⟩
      have := (hzero z).mp hz
      rw [hmapP z, sub_eq_zero] at this
      exact this
    · intro G H hG hH hGH
      refine ⟨Sum.elim (fun μ => G.coeff μ.1) (fun ν => H.coeff ν.1), ?_⟩
      rw [hzero, hmapP]
      simp only [Sum.elim_inl, Sum.elim_inr]
      rw [hrecon a G hG, hrecon e H hH, hGH, sub_self]

  have hinj : Function.Injective (algebraMap B (AlgebraicClosure (FractionRing B))) := by
    rw [IsScalarTower.algebraMap_eq B (FractionRing B) (AlgebraicClosure (FractionRing B))]
    exact (algebraMap (FractionRing B) (AlgebraicClosure (FractionRing B))).injective.comp
      (IsFractionRing.injective _ _)
  have hF0 : F ≠ 0 := by
    rintro rfl
    rw [map_zero] at hirr
    exact not_irreducible_zero hirr
  obtain ⟨μ0, hμ0, hμ0D⟩ := Finset.exists_mem_eq_sup F.support
    (MvPolynomial.support_nonempty.mpr hF0) (fun s : Fin n →₀ ℕ => s.sum fun _ e => e)
  have hD : F.totalDegree = μ0.sum fun _ e => e := hμ0D
  have hlam : F.coeff μ0 ≠ 0 := MvPolynomial.mem_support_iff.mp hμ0
  have hdegmap : ∀ (K : Type u) [CommRing K] (ψ : B →+* K), ψ (F.coeff μ0) ≠ 0 →
      (MvPolynomial.map ψ F).totalDegree = F.totalDegree := by
    intro K _ ψ hψ
    apply le_antisymm
    · unfold MvPolynomial.totalDegree
      exact Finset.sup_mono (MvPolynomial.support_map_subset ψ F)
    · have hmem : μ0 ∈ (MvPolynomial.map ψ F).support := by
        rw [MvPolynomial.mem_support_iff, MvPolynomial.coeff_map]
        exact hψ
      rw [hD]
      exact MvPolynomial.le_totalDegree hmem
  have hunit_deg : ∀ (K : Type u) [Field K] (Q : MvPolynomial (Fin n) K), IsUnit Q →
      Q.totalDegree = 0 := by
    intro K _ Q hQ
    obtain ⟨r, -, rfl⟩ := MvPolynomial.isUnit_iff_eq_C_of_isReduced.mp hQ
    exact MvPolynomial.totalDegree_C r
  have hdeg0_unit : ∀ (K : Type u) [Field K] (Q : MvPolynomial (Fin n) K), Q ≠ 0 →
      Q.totalDegree = 0 → IsUnit Q := by
    intro K _ Q hQ h0
    rw [MvPolynomial.totalDegree_eq_zero_iff_eq_C] at h0
    have hc : Q.coeff 0 ≠ 0 := by
      intro h
      apply hQ
      rw [h0, h, map_zero]
    rw [h0]
    exact (isUnit_iff_ne_zero.mpr hc).map MvPolynomial.C
  have hilam : algebraMap B (AlgebraicClosure (FractionRing B)) (F.coeff μ0) ≠ 0 :=
    fun h => hlam (hinj (h.trans (map_zero _).symm))
  have hdegι := hdegmap _ _ hilam
  have hD1 : 1 ≤ F.totalDegree := by
    by_contra h
    push_neg at h
    have h0 : (MvPolynomial.map (algebraMap B (AlgebraicClosure (FractionRing B))) F).totalDegree
        = 0 := by
      rw [hdegι]
      omega
    exact hirr.not_isUnit (hdeg0_unit _ _ hirr.ne_zero h0)

  have hr : ∀ a : ℕ, ∃ r : B, r ≠ 0 ∧ (1 ≤ a → a < F.totalDegree →
      ∀ (Ω : Type u) [Field Ω] (ψ : B →+* Ω), ψ r ≠ 0 → ∀ G H : MvPolynomial (Fin n) Ω,
        G.totalDegree ≤ a → H.totalDegree ≤ F.totalDegree - a → G * H ≠ MvPolynomial.map ψ F) := by
    intro a
    by_cases ha : 1 ≤ a ∧ a < F.totalDegree
    · obtain ⟨σ, hσ, S, hS⟩ := encode a (F.totalDegree - a)
      haveI := hσ
      have hgen : ∀ z : σ → AlgebraicClosure (FractionRing B), ∃ s ∈ S,
          MvPolynomial.eval₂ (algebraMap B (AlgebraicClosure (FractionRing B))) z s ≠ 0 := by
        intro z
        by_contra hz
        push_neg at hz
        obtain ⟨G, H, hG, hH, hGH⟩ := (hS _ _).1 z hz
        have h2 := MvPolynomial.totalDegree_mul G H
        rw [hGH, hdegι] at h2
        rcases hirr.isUnit_or_isUnit hGH.symm with hu | hu
        · have h1 := hunit_deg _ G hu
          omega
        · have h1 := hunit_deg _ H hu
          omega
      obtain ⟨r, hr0, hr⟩ := descent σ S hgen
      refine ⟨r, hr0, fun _ _ Ω _ ψ hψ G H hG hH hGH => ?_⟩
      obtain ⟨z, hz⟩ := (hS Ω ψ).2 G H hG hH hGH
      obtain ⟨s, hs, hne⟩ := hr Ω ψ hψ z
      exact hne (hz s hs)
    · exact ⟨1, one_ne_zero, fun h1 h2 => absurd ⟨h1, h2⟩ ha⟩
  choose r hr0 hr using hr
  refine ⟨F.coeff μ0 * ∏ a ∈ Finset.range F.totalDegree, r a,
    mul_ne_zero hlam (Finset.prod_ne_zero_iff.mpr fun a _ => hr0 a), ?_⟩
  intro Ω _ ψ hψ
  rw [map_mul, map_prod] at hψ
  have hψlam : ψ (F.coeff μ0) ≠ 0 := left_ne_zero_of_mul hψ
  have hψr : ∀ a ∈ Finset.range F.totalDegree, ψ (r a) ≠ 0 :=
    Finset.prod_ne_zero_iff.mp (right_ne_zero_of_mul hψ)
  have hdψ := hdegmap Ω ψ hψlam
  have hne : MvPolynomial.map ψ F ≠ 0 := by
    intro h
    rw [h, MvPolynomial.totalDegree_zero] at hdψ
    omega
  rw [irreducible_iff]
  refine ⟨fun hu => by have := hunit_deg Ω _ hu; omega, ?_⟩
  intro G H hGH
  have hG0 : G ≠ 0 := by
    rintro rfl
    rw [zero_mul] at hGH
    exact hne hGH
  have hH0 : H ≠ 0 := by
    rintro rfl
    rw [mul_zero] at hGH
    exact hne hGH
  have hsum := MvPolynomial.totalDegree_mul_of_isDomain hG0 hH0
  rw [← hGH, hdψ] at hsum
  by_cases hG : G.totalDegree = 0
  · exact Or.inl (hdeg0_unit Ω G hG0 hG)
  by_cases hH : H.totalDegree = 0
  · exact Or.inr (hdeg0_unit Ω H hH0 hH)
  exfalso
  exact hr G.totalDegree (by omega) (by omega) Ω ψ (hψr _ (Finset.mem_range.mpr (by omega)))
    G H le_rfl (by omega) hGH.symm

theorem wc_generic_freeness_finite_module : ∀ (A S M : Type u) [CommRing A] [IsDomain A] [IsNoetherianRing A] [CommRing S] [Algebra A S] [Algebra.FiniteType A S] [AddCommGroup M] [Module A M] [Module S M] [IsScalarTower A S M] [Module.Finite S M], ∃ a : A, a ≠ 0 ∧ Module.Free (Localization.Away a) (LocalizedModule (Submonoid.powers a) M) :=
by
  intro A S₁ M₁ _ _ _ _ _ _ _ _ _ _ _
  classical

  have s1 : ∀ (M : Type u) [AddCommGroup M] [Module A M] [Module.Finite A M], ∃ a : A, a ≠ 0 ∧
      Module.Free (Localization.Away a) (LocalizedModule (Submonoid.powers a) M) := by
    intro M _ _ _
    have : Module.FinitePresentation A M := Module.finitePresentation_of_finite A M
    obtain ⟨r, hr, hfree, -⟩ := Module.FinitePresentation.exists_free_localizedModule_powers
      (nonZeroDivisors A) (LocalizedModule.mkLinearMap (nonZeroDivisors A) M) (FractionRing A)
    exact ⟨r, nonZeroDivisors.ne_zero hr, hfree⟩

  have s6 : ∀ (N N' W : Type u) [AddCommGroup N] [Module A N] [AddCommGroup N'] [Module A N']
      [AddCommGroup W] [Module A W] (b a : A) [Module (Localization.Away a) W]
      [IsScalarTower A (Localization.Away a) W], b ∣ a → (N ≃ₗ[A] N') →
      Module.Free (Localization.Away b) (LocalizedModule (Submonoid.powers b) N) →
      ∀ (f : N' →ₗ[A] W) [IsLocalizedModule (Submonoid.powers a) f],
      Module.Free (Localization.Away a) W := by
    intro N N' W _ _ _ _ _ _ b a _ _ hba e hfree f _
    obtain ⟨c, rfl⟩ := hba
    have hu : IsUnit (algebraMap A (Localization.Away (b * c)) b) := by
      have := IsLocalization.Away.algebraMap_isUnit (S := Localization.Away (b * c)) (b * c)
      rw [map_mul] at this
      exact isUnit_of_mul_isUnit_left this
    letI : Algebra (Localization.Away b) (Localization.Away (b * c)) :=
      (IsLocalization.Away.lift b hu).toAlgebra
    have : IsScalarTower A (Localization.Away b) (Localization.Away (b * c)) :=
      IsScalarTower.of_algebraMap_eq (fun x => by
        rw [RingHom.algebraMap_toAlgebra]
        exact (IsLocalization.lift_eq _ x).symm)
    have hb : IsBaseChange (Localization.Away b)
        (LocalizedModule.mkLinearMap (Submonoid.powers b) N) :=
      IsLocalizedModule.isBaseChange (Submonoid.powers b) (Localization.Away b) _
    have ha : IsBaseChange (Localization.Away (b * c)) f :=
      IsLocalizedModule.isBaseChange (Submonoid.powers (b * c)) (Localization.Away (b * c)) f
    have : Module.Free (Localization.Away b) (TensorProduct A (Localization.Away b) N) :=
      Module.Free.of_equiv' hfree hb.equiv.symm
    have : Module.Free (Localization.Away (b * c)) (TensorProduct (Localization.Away b)
        (Localization.Away (b * c)) (TensorProduct A (Localization.Away b) N)) :=
      Module.Free.of_basis (Algebra.TensorProduct.basis (Localization.Away (b * c))
        (Module.Free.chooseBasis (Localization.Away b) (TensorProduct A (Localization.Away b) N)))
    let e1 := TensorProduct.AlgebraTensorModule.cancelBaseChange A (Localization.Away b)
      (Localization.Away (b * c)) (Localization.Away (b * c)) N
    let e2 := LinearEquiv.baseChange A (Localization.Away (b * c)) N N' e
    exact Module.Free.of_equiv' inferInstance (e1.trans (e2.trans ha.equiv))

  have s5 : ∀ (B M : Type u) [CommRing B] [AddCommGroup M] [Module B M] (Q : ℕ → Submodule B M),
      Monotone Q → Q 0 = ⊥ → (∀ m : M, ∃ j, m ∈ Q j) →
      (∀ j, Module.Free B ↥(Submodule.map (Q j).mkQ (Q (j+1)))) → Module.Free B M := by
    intro B M _ _ _ Q hmono h0 hex hfree
    let bs := fun j => Module.Free.chooseBasis B ↥(Submodule.map (Q j).mkQ (Q (j+1)))
    have hlift : ∀ j (i : Module.Free.ChooseBasisIndex B ↥(Submodule.map (Q j).mkQ (Q (j+1)))),
        ∃ w : M, w ∈ Q (j+1) ∧
          (Q j).mkQ w = ((bs j i : ↥(Submodule.map (Q j).mkQ (Q (j+1)))) : M ⧸ Q j) :=
      fun j i => Submodule.mem_map.mp (bs j i).2
    choose w hwQ hwb using hlift
    let W : (Σ j, Module.Free.ChooseBasisIndex B ↥(Submodule.map (Q j).mkQ (Q (j+1)))) → M :=
      fun x => w x.1 x.2
    have hspan : ∀ j, Q j ≤ Submodule.span B (Set.range W) := by
      intro j
      induction j with
      | zero => rw [h0]; exact bot_le
      | succ j ih =>
        intro x hx
        have h1 : (⟨(Q j).mkQ x, Submodule.mem_map_of_mem hx⟩ :
            ↥(Submodule.map (Q j).mkQ (Q (j+1)))) ∈ Submodule.span B (Set.range (bs j)) := by
          rw [(bs j).span_eq]; trivial
        have h2 := Submodule.mem_map_of_mem (f := (Submodule.map (Q j).mkQ (Q (j+1))).subtype) h1
        rw [Submodule.map_span, ← Set.range_comp] at h2
        have h3 : ⇑(Submodule.map (Q j).mkQ (Q (j+1))).subtype ∘ ⇑(bs j) = ⇑(Q j).mkQ ∘ w j :=
          funext fun i => (hwb j i).symm
        rw [h3, Set.range_comp, ← Submodule.map_span] at h2
        have h4 : x ∈ Submodule.comap (Q j).mkQ
            (Submodule.map (Q j).mkQ (Submodule.span B (Set.range (w j)))) := h2
        rw [Submodule.comap_map_mkQ] at h4
        refine (sup_le ih (Submodule.span_mono ?_)) h4
        rintro _ ⟨i, rfl⟩
        exact ⟨⟨j, i⟩, rfl⟩
    let s : ℕ → Set (Σ j, Module.Free.ChooseBasisIndex B ↥(Submodule.map (Q j).mkQ (Q (j+1)))) :=
      fun n => {x | x.1 < n}
    have hli : ∀ n, LinearIndepOn B W (s n) := by
      intro n
      induction n with
      | zero =>
        have : s 0 = ∅ := by ext x; simp [s]
        rw [this]; exact linearIndepOn_empty B W
      | succ n ih =>
        have hs : s (n+1) = s n ∪ Set.range (Sigma.mk n) := by
          ext ⟨j, i⟩
          simp only [s, Set.mem_setOf_eq, Set.mem_union, Set.mem_range]
          constructor
          · intro h
            rcases Nat.lt_succ_iff_lt_or_eq.mp h with h | h
            · exact Or.inl h
            · subst h; exact Or.inr ⟨i, rfl⟩
          · rintro (h | ⟨i', hi'⟩)
            · omega
            · have := congrArg Sigma.fst hi'
              simp only at this
              omega
        rw [hs]
        apply ih.union_of_quotient
        have hle : Submodule.span B (W '' s n) ≤ Q n := by
          rw [Submodule.span_le]
          rintro _ ⟨x, hx, rfl⟩
          exact hmono (Nat.succ_le_of_lt hx) (hwQ x.1 x.2)
        rw [linearIndepOn_range_iff sigma_mk_injective]
        apply LinearIndependent.of_comp (Submodule.factor hle)
        have h5 : ⇑(Submodule.factor hle) ∘ (⇑(Submodule.span B (W '' s n)).mkQ ∘ W) ∘ Sigma.mk n =
            ⇑(Submodule.map (Q n).mkQ (Q (n+1))).subtype ∘ ⇑(bs n) := by
          funext i
          simp only [Function.comp_apply, Submodule.mkQ_apply, Submodule.subtype_apply]
          exact hwb n i
        rw [h5]
        exact (bs n).linearIndependent.map' _ (Submodule.ker_subtype _)
    have hU : (⋃ n, s n) = Set.univ := by
      ext x
      simp only [Set.mem_iUnion, Set.mem_univ, iff_true]
      exact ⟨x.1 + 1, Nat.lt_succ_self _⟩
    have hdir : Directed (· ⊆ ·) s := fun m n =>
      ⟨max m n, fun x (hx : x.1 < m) => (lt_of_lt_of_le hx (le_max_left m n) : x.1 < max m n),
        fun x (hx : x.1 < n) => (lt_of_lt_of_le hx (le_max_right m n) : x.1 < max m n)⟩
    have hli' := linearIndepOn_iUnion_of_directed hdir hli
    rw [hU] at hli'
    have hW : LinearIndependent B W := linearIndepOn_univ_iff.mp hli'
    exact Module.Free.of_basis (Module.Basis.mk hW (fun x _ => by
      obtain ⟨j, hj⟩ := hex x
      exact hspan j hj))


  have s4 : ∀ (R M : Type u) [CommRing R] [Algebra A R] [AddCommGroup M] [Module A M]
      [Module R M] [IsScalarTower A R M] (a : A) (P : ℕ → Submodule R M),
      Monotone P → P 0 = ⊥ → (∀ m : M, ∃ j, m ∈ P j) →
      (∀ j, ∃ k : ℕ, ∃ b : A, b ∣ a ∧ Nonempty (↥(Submodule.map (P k).mkQ (P (k+1))) ≃ₗ[A]
        ↥(Submodule.map (P j).mkQ (P (j+1)))) ∧ Module.Free (Localization.Away b)
        (LocalizedModule (Submonoid.powers b) ↥(Submodule.map (P k).mkQ (P (k+1))))) →
      Module.Free (Localization.Away a) (LocalizedModule (Submonoid.powers a) M) := by
    intro R M _ _ _ _ _ _ a P hmono h0 hex hN
    let μ := LocalizedModule.mkLinearMap (Submonoid.powers a) M
    let PA : ℕ → Submodule A M := fun j => (P j).restrictScalars A
    let Q : ℕ → Submodule (Localization.Away a) (LocalizedModule (Submonoid.powers a) M) :=
      fun j => Submodule.localized' (Localization.Away a) (Submonoid.powers a) μ (PA j)
    have hQ : ∀ j x, x ∈ Q j ↔ ∃ m ∈ P j, ∃ s, IsLocalizedModule.mk' μ m s = x := fun j x =>
      Submodule.mem_localized' _ _ _ _ _
    have hQmono : Monotone Q := by
      intro i j hij x hx
      obtain ⟨m, hm, s, rfl⟩ := (hQ i x).mp hx
      exact (hQ j _).mpr ⟨m, hmono hij hm, s, rfl⟩
    have hQ0 : Q 0 = ⊥ := by
      rw [eq_bot_iff]
      intro x hx
      obtain ⟨m, hm, s, rfl⟩ := (hQ 0 x).mp hx
      rw [h0] at hm
      rw [(Submodule.mem_bot R).mp hm, IsLocalizedModule.mk'_zero]
      exact Submodule.zero_mem _
    have hQex : ∀ x, ∃ j, x ∈ Q j := by
      intro x
      obtain ⟨⟨m, s⟩, rfl⟩ := IsLocalizedModule.mk'_surjective (Submonoid.powers a) μ x
      obtain ⟨j, hj⟩ := hex m
      exact ⟨j, (hQ j _).mpr ⟨m, hj, s, rfl⟩⟩
    refine s5 _ _ Q hQmono hQ0 hQex (fun j => ?_)
    obtain ⟨k, b, hba, ⟨ek⟩, hfree⟩ := hN j
    let g := Submodule.toLocalizedQuotient' (Localization.Away a) (Submonoid.powers a) μ (PA j)
    let NA := Submodule.map (PA j).mkQ (PA (j+1))
    have hkey : ∀ (m : M) (s : Submonoid.powers a),
        IsLocalizedModule.mk' g ((PA j).mkQ m) s = (Q j).mkQ (IsLocalizedModule.mk' μ m s) := by
      intro m s
      rw [IsLocalizedModule.mk'_eq_iff, Submodule.mkQ_apply, Submodule.mkQ_apply,
        Submodule.toLocalizedQuotient'_mk, Submonoid.smul_def, ← Submodule.Quotient.mk_smul,
        ← Submonoid.smul_def, IsLocalizedModule.mk'_cancel']
    have hW : Submodule.localized' (Localization.Away a) (Submonoid.powers a) g NA =
        Submodule.map (Q j).mkQ (Q (j+1)) := by
      ext x
      rw [Submodule.mem_localized', Submodule.mem_map]
      constructor
      · rintro ⟨n, hn, s, rfl⟩
        obtain ⟨m, hm, rfl⟩ := Submodule.mem_map.mp hn
        exact ⟨IsLocalizedModule.mk' μ m s, (hQ (j+1) _).mpr ⟨m, hm, s, rfl⟩, (hkey m s).symm⟩
      · rintro ⟨y, hy, rfl⟩
        obtain ⟨m, hm, s, rfl⟩ := (hQ (j+1) y).mp hy
        exact ⟨(PA j).mkQ m, Submodule.mem_map_of_mem hm, s, hkey m s⟩
    let F := Submodule.toLocalized' (Localization.Away a) (Submonoid.powers a) g NA
    let E := (LinearEquiv.ofEq _ _ hW).restrictScalars A
    have : IsLocalizedModule (Submonoid.powers a) (E.toLinearMap ∘ₗ F) :=
      IsLocalizedModule.of_linearEquiv _ F E
    let RE := Submodule.Quotient.restrictScalarsEquiv A (P j)
    have hmem1 : ∀ x : M ⧸ P j, x ∈ Submodule.map (P j).mkQ (P (j+1)) → RE.symm x ∈ NA := by
      rintro _ ⟨m, hm, rfl⟩
      exact ⟨m, hm, by rw [Submodule.mkQ_apply, Submodule.mkQ_apply,
        Submodule.Quotient.restrictScalarsEquiv_symm_mk]⟩
    have hmem2 : ∀ y : M ⧸ PA j, y ∈ NA → RE y ∈ Submodule.map (P j).mkQ (P (j+1)) := by
      rintro _ ⟨m, hm, rfl⟩
      exact ⟨m, hm, by rw [Submodule.mkQ_apply, Submodule.mkQ_apply,
        Submodule.Quotient.restrictScalarsEquiv_mk]⟩
    let e : ↥(Submodule.map (P j).mkQ (P (j+1))) ≃ₗ[A] ↥NA :=
      { toFun := fun x => ⟨RE.symm x.1, hmem1 x.1 x.2⟩
        invFun := fun y => ⟨RE y.1, hmem2 y.1 y.2⟩
        map_add' := fun x y => Subtype.ext (map_add RE.symm x.1 y.1)
        map_smul' := fun c x => Subtype.ext (map_smul RE.symm c x.1)
        left_inv := fun x => Subtype.ext (RE.apply_symm_apply x.1)
        right_inv := fun y => Subtype.ext (RE.symm_apply_apply y.1) }
    exact s6 _ _ _ b a hba (ek.trans e) hfree (E.toLinearMap ∘ₗ F)

  have s3 : ∀ (R S M : Type u) [CommRing R] [IsNoetherianRing R] [CommRing S] [Algebra R S]
      [AddCommGroup M] [Module R M] [Module S M] [IsScalarTower R S M] [Module.Finite S M]
      (θ : S), (∀ s : S, s ∈ Algebra.adjoin R {θ}) →
      ∃ P : ℕ → Submodule R M, Monotone P ∧ P 0 = ⊥ ∧ (∀ m : M, ∃ j, m ∈ P j) ∧
        (∀ j, Module.Finite R ↥(Submodule.map (P j).mkQ (P (j+1)))) ∧
        ∃ j₀ : ℕ, ∀ j, j₀ ≤ j → Nonempty (↥(Submodule.map (P j).mkQ (P (j+1))) ≃ₗ[R]
          ↥(Submodule.map (P j₀).mkQ (P (j₀+1)))) := by
    intro R S M _ _ _ _ _ _ _ _ _ θ hθ
    obtain ⟨G, hG⟩ := (Module.Finite.fg_top : (⊤ : Submodule S M).FG)
    obtain ⟨σ, hσ⟩ : ∃ σ : ℕ → M →ₗ[R] M, ∀ j m, σ j m = θ ^ j • m :=
      ⟨fun j => { toFun := fun m => θ ^ j • m
                  map_add' := fun x y => smul_add _ x y
                  map_smul' := fun r m => smul_comm _ r m }, fun _ _ => rfl⟩
    obtain ⟨M₀, hM₀⟩ : ∃ M₀ : Submodule R M, M₀ = Submodule.span R (G : Set M) := ⟨_, rfl⟩
    obtain ⟨P, hP0, hPs⟩ : ∃ P : ℕ → Submodule R M, P 0 = ⊥ ∧
        ∀ j, P (j+1) = P j ⊔ M₀.map (σ j) :=
      ⟨fun j => Nat.rec ⊥ (fun i Pi => Pi ⊔ M₀.map (σ i)) j, rfl, fun _ => rfl⟩
    have hmono : Monotone P := monotone_nat_of_le_succ (fun j => by rw [hPs j]; exact le_sup_left)
    have hθP : ∀ j, ∀ x ∈ P j, θ • x ∈ P (j+1) := by
      intro j
      induction j with
      | zero => intro x hx; rw [hP0] at hx; rw [(Submodule.mem_bot R).mp hx, smul_zero]; exact
          Submodule.zero_mem _
      | succ j ih =>
        intro x hx
        rw [hPs j] at hx
        obtain ⟨p, hp, z, hz, rfl⟩ := Submodule.mem_sup.mp hx
        obtain ⟨m, hm, rfl⟩ := Submodule.mem_map.mp hz
        rw [smul_add, hPs (j+1)]
        refine Submodule.add_mem _ (Submodule.mem_sup_left (ih p hp)) (Submodule.mem_sup_right ?_)
        refine ⟨m, hm, ?_⟩
        rw [hσ, hσ, pow_succ', mul_smul]
    have hdir : Directed (· ≤ ·) P := hmono.directed_le
    have hall : ∀ s : S, ∀ x ∈ ⨆ j, P j, s • x ∈ ⨆ j, P j := by
      intro s
      induction (hθ s) using Algebra.adjoin_induction with
      | mem y hy =>
        rw [Set.mem_singleton_iff] at hy
        subst hy
        intro x hx
        obtain ⟨j, hj⟩ := (Submodule.mem_iSup_of_directed P hdir).mp hx
        exact (Submodule.mem_iSup_of_directed P hdir).mpr ⟨j+1, hθP j x hj⟩
      | algebraMap r =>
        intro x hx
        rw [algebraMap_smul]
        exact Submodule.smul_mem _ r hx
      | add y z _ _ hy hz =>
        intro x hx
        rw [add_smul]; exact Submodule.add_mem _ (hy x hx) (hz x hx)
      | mul y z _ _ hy hz =>
        intro x hx
        rw [mul_smul]; exact hy _ (hz x hx)
    let U : Submodule S M :=
      { carrier := ((⨆ j, P j : Submodule R M) : Set M)
        add_mem' := fun hx hy => Submodule.add_mem _ hx hy
        zero_mem' := Submodule.zero_mem (⨆ j, P j)
        smul_mem' := fun s x hx => hall s x hx }
    have hGU : (G : Set M) ⊆ U := by
      intro x hx
      show x ∈ ⨆ j, P j
      apply Submodule.mem_iSup_of_mem 1
      rw [hPs 0, hP0, bot_sup_eq]
      refine ⟨x, ?_, ?_⟩
      · rw [hM₀]; exact Submodule.subset_span hx
      · rw [hσ, pow_zero, one_smul]
    have hex : ∀ m : M, ∃ j, m ∈ P j := by
      intro m
      have hm : m ∈ U := by
        have := Submodule.span_le.mpr hGU
        rw [hG] at this
        exact this trivial
      exact (Submodule.mem_iSup_of_directed P hdir).mp hm
    obtain ⟨τ, hτ⟩ : ∃ τ : ∀ j, M₀ →ₗ[R] ↥(Submodule.map (P j).mkQ (P (j+1))),
        ∀ j (m : M₀), ((τ j m : ↥(Submodule.map (P j).mkQ (P (j+1)))) : M ⧸ P j) =
          Submodule.Quotient.mk (θ ^ j • (m : M)) := by
      refine ⟨fun j => LinearMap.codRestrict _ ((P j).mkQ ∘ₗ σ j ∘ₗ M₀.subtype) (fun m => ?_),
        fun j m => ?_⟩
      · show (P j).mkQ (σ j m) ∈ _
        refine Submodule.mem_map_of_mem ?_
        rw [hPs j]
        exact Submodule.mem_sup_right (Submodule.mem_map_of_mem m.2)
      · show (P j).mkQ (σ j m) = _
        rw [hσ]; rfl
    have hτsurj : ∀ j, Function.Surjective (τ j) := by
      intro j y
      obtain ⟨x, hx, hxy⟩ := Submodule.mem_map.mp y.2
      rw [hPs j] at hx
      obtain ⟨p, hp, z, hz, rfl⟩ := Submodule.mem_sup.mp hx
      obtain ⟨m, hm, rfl⟩ := Submodule.mem_map.mp hz
      refine ⟨⟨m, hm⟩, Subtype.ext ?_⟩
      rw [hτ, ← hxy, Submodule.mkQ_apply, Submodule.Quotient.eq, hσ]
      have : θ ^ j • m - (p + θ ^ j • m) = -p := by abel
      rw [this]; exact Submodule.neg_mem _ hp
    have hker : ∀ j (m : M₀), m ∈ LinearMap.ker (τ j) ↔ θ ^ j • (m : M) ∈ P j := by
      intro j m
      rw [LinearMap.mem_ker]
      constructor
      · intro h
        have h' := congrArg Subtype.val h
        rw [hτ] at h'
        exact (Submodule.Quotient.mk_eq_zero (P j)).mp h'
      · intro h
        apply Subtype.ext
        rw [hτ]
        exact (Submodule.Quotient.mk_eq_zero (P j)).mpr h
    have hkmono : Monotone (fun j => LinearMap.ker (τ j)) := by
      refine monotone_nat_of_le_succ (fun j m hm => ?_)
      have hm' := (hker j m).mp hm
      refine (hker (j+1) m).mpr ?_
      rw [pow_succ', mul_smul]
      exact hθP j _ hm'
    have hM₀fin : Module.Finite R M₀ := by
      subst hM₀; exact Module.Finite.span_of_finite R G.finite_toSet
    have hnoeth : IsNoetherian R M₀ := isNoetherian_of_isNoetherianRing_of_finite R M₀
    obtain ⟨j₀, hj₀⟩ := (monotone_stabilizes_iff_noetherian.mpr hnoeth)
      ⟨fun j => LinearMap.ker (τ j), hkmono⟩
    refine ⟨P, hmono, hP0, hex, fun j => Module.Finite.of_surjective (τ j) (hτsurj j), j₀,
      fun j hj => ⟨?_⟩⟩
    have hk : LinearMap.ker (τ j) = LinearMap.ker (τ j₀) := (hj₀ j hj).symm
    exact ((LinearMap.quotKerEquivOfSurjective (τ j) (hτsurj j)).symm.trans
      (Submodule.quotEquivOfEq _ _ hk)).trans
      (LinearMap.quotKerEquivOfSurjective (τ j₀) (hτsurj j₀))

  have GF : ∀ n : ℕ, ∀ (S : Type u) [CommRing S] [Algebra A S] (f : Fin n → S),
      Algebra.adjoin A (Set.range f) = ⊤ → ∀ (M : Type u) [AddCommGroup M] [Module A M]
      [Module S M] [IsScalarTower A S M] [Module.Finite S M], ∃ a : A, a ≠ 0 ∧
      Module.Free (Localization.Away a) (LocalizedModule (Submonoid.powers a) M) := by
    intro n
    induction n with
    | zero =>
      intro S _ _ f hf M _ _ _ _ _
      have hbot : ∀ s : S, s ∈ Set.range (algebraMap A S) := by
        intro s
        have hs : s ∈ Algebra.adjoin A (Set.range f) := by rw [hf]; trivial
        rw [Set.range_eq_empty, Algebra.adjoin_empty] at hs
        exact Algebra.mem_bot.mp hs
      have : Module.Finite A S := by
        refine ⟨⟨{1}, ?_⟩⟩
        rw [eq_top_iff]
        intro s _
        obtain ⟨r, rfl⟩ := hbot s
        rw [Algebra.algebraMap_eq_smul_one]
        exact Submodule.smul_mem _ r (Submodule.subset_span (by simp))
      have : Module.Finite A M := Module.Finite.trans S M
      exact s1 M
    | succ n ih =>
      intro S _ _ f hf M _ _ _ _ _
      let S' := Algebra.adjoin A (Set.range (f ∘ Fin.castSucc))
      have hS'fin : Algebra.FiniteType A S' :=
        Algebra.FiniteType.adjoin_of_finite (Set.finite_range _)
      have : IsNoetherianRing S' := Algebra.FiniteType.isNoetherianRing A S'
      let g : Fin n → S' := fun i => ⟨f i.castSucc, Algebra.subset_adjoin ⟨i, rfl⟩⟩
      have hg : Algebra.adjoin A (Set.range g) = ⊤ := by
        have : Set.range g = Subtype.val ⁻¹' (Set.range (f ∘ Fin.castSucc)) := by
          ext y
          constructor
          · rintro ⟨i, rfl⟩; exact ⟨i, rfl⟩
          · rintro ⟨i, hi⟩; exact ⟨i, Subtype.ext hi⟩
        rw [this]; exact Algebra.adjoin_adjoin_coe_preimage
      have hθ : ∀ s : S, s ∈ Algebra.adjoin S' {f (Fin.last n)} := by
        intro s
        have h1 : Set.range (f ∘ Fin.castSucc) ∪ {f (Fin.last n)} = Set.range f := by
          ext x
          constructor
          · rintro (⟨i, rfl⟩ | h)
            · exact ⟨_, rfl⟩
            · rw [Set.mem_singleton_iff] at h; exact ⟨_, h.symm⟩
          · rintro ⟨i, rfl⟩
            induction i using Fin.lastCases with
            | last => exact Or.inr rfl
            | cast i => exact Or.inl ⟨i, rfl⟩
        have h2 := Algebra.adjoin_union_eq_adjoin_adjoin A (Set.range (f ∘ Fin.castSucc))
          {f (Fin.last n)}
        rw [h1, hf] at h2
        have hs : s ∈ (⊤ : Subalgebra A S) := trivial
        rw [h2] at hs
        exact hs
      obtain ⟨P, hPmono, hP0, hPex, hPfin, j₀, hj₀⟩ := s3 S' S M (f (Fin.last n)) hθ
      have hb : ∀ j, ∃ b : A, b ≠ 0 ∧ Module.Free (Localization.Away b)
          (LocalizedModule (Submonoid.powers b) ↥(Submodule.map (P j).mkQ (P (j+1)))) := by
        intro j
        have := hPfin j
        exact ih S' g hg _
      choose b hb0 hbfree using hb
      refine ⟨∏ j ∈ Finset.range (j₀+1), b j,
        Finset.prod_ne_zero_iff.mpr (fun j _ => hb0 j), ?_⟩
      refine s4 S' M _ P hPmono hP0 hPex (fun j => ?_)
      by_cases hj : j ≤ j₀
      · exact ⟨j, b j, Finset.dvd_prod_of_mem _ (Finset.mem_range.mpr (by omega)),
          ⟨LinearEquiv.refl _ _⟩, hbfree j⟩
      · obtain ⟨e⟩ := hj₀ j (by omega)
        exact ⟨j₀, b j₀, Finset.dvd_prod_of_mem _ (Finset.mem_range.mpr (by omega)),
          ⟨(e.restrictScalars A).symm⟩, hbfree j₀⟩

  obtain ⟨t, ht⟩ := (Algebra.FiniteType.out : (⊤ : Subalgebra A S₁).FG)
  refine GF t.card S₁ (fun i => (t.equivFin.symm i : S₁)) ?_ M₁
  have : Set.range (fun i => (t.equivFin.symm i : S₁)) = (t : Set S₁) := by
    ext x
    constructor
    · rintro ⟨i, rfl⟩; exact (t.equivFin.symm i).2
    · intro hx; exact ⟨t.equivFin ⟨x, hx⟩, by simp⟩
  rw [this]; exact ht

theorem wc_generic_nzd_spread_of_free : ∀ (A S : Type u) [CommRing A] [IsDomain A] [IsNoetherianRing A] [CommRing S] [Algebra A S] [Algebra.FiniteType A S] (h : S), (∀ s : S, h * s = 0 → ∃ c : A, c ≠ 0 ∧ c • s = 0) → (∃ a₂ : A, a₂ ≠ 0 ∧ Module.Free (Localization.Away a₂) (LocalizedModule (Submonoid.powers a₂) (S ⧸ Ideal.span {h}))) → ∃ a : A, a ≠ 0 ∧ ∀ (Ω : Type u) [Field Ω] [Algebra A Ω], algebraMap A Ω a ≠ 0 → (Algebra.TensorProduct.includeRight h : TensorProduct A Ω S) ∈ nonZeroDivisors (TensorProduct A Ω S) :=
by
  intro A S _ _ _ _ _ _ h hann ⟨a₂, ha₂0, hfree⟩
  classical

  obtain ⟨c, hc0, hc⟩ : ∃ c : A, c ≠ 0 ∧ ∀ s : S, h * s = 0 → c • s = 0 := by
    have : IsNoetherianRing S := Algebra.FiniteType.isNoetherianRing A S
    let I : Ideal S := LinearMap.ker (LinearMap.mulLeft S h)
    have hI : ∀ x, x ∈ I ↔ h * x = 0 := fun x => by
      simp [I, LinearMap.mem_ker, LinearMap.mulLeft_apply]
    obtain ⟨G, hG⟩ := (IsNoetherian.noetherian I : I.FG)
    let cg : S → A := fun g => if hg : h * g = 0 then (hann g hg).choose else 1
    have hcg0 : ∀ g, cg g ≠ 0 := by
      intro g
      simp only [cg]
      split_ifs with hg
      · exact (hann g hg).choose_spec.1
      · exact one_ne_zero
    have hcgk : ∀ g ∈ G, cg g • g = 0 := by
      intro g hg
      have hgI : g ∈ I := by rw [← hG]; exact Submodule.subset_span hg
      have hg' : h * g = 0 := (hI g).mp hgI
      simp only [cg, dif_pos hg']
      exact (hann g hg').choose_spec.2
    refine ⟨∏ g ∈ G, cg g, Finset.prod_ne_zero_iff.mpr (fun g _ => hcg0 g), ?_⟩
    have hspan : ∀ x ∈ Submodule.span S (G : Set S), (∏ g ∈ G, cg g) • x = 0 := by
      intro x hx
      induction hx using Submodule.span_induction with
      | mem x hx =>
        rw [← Finset.prod_erase_mul G cg hx, mul_smul, hcgk x hx, smul_zero]
      | zero => exact smul_zero _
      | add x y _ _ hx hy => rw [smul_add, hx, hy, add_zero]
      | smul r x _ hx => rw [smul_eq_mul, ← mul_smul_comm, hx, mul_zero]
    intro s hs
    exact hspan s (by rw [hG]; exact (hI s).mpr hs)

  have hs2 : ∀ y : LocalizedModule (Submonoid.powers a₂) S,
      LocalizedModule.map (Submonoid.powers a₂) (LinearMap.mulLeft A h) y = 0 → c • y = 0 := by
    intro y
    induction y using LocalizedModule.induction_on with
    | h s u =>
      intro hy
      rw [LocalizedModule.map_mk, LinearMap.mulLeft_apply,
        ← LocalizedModule.zero_mk (1 : Submonoid.powers a₂), LocalizedModule.mk_eq] at hy
      obtain ⟨v, hv⟩ := hy
      simp only [one_smul, smul_zero] at hv
      have h1 : h * ((v : A) • s) = 0 := by rw [mul_smul_comm]; exact hv
      have h2 := hc _ h1
      rw [LocalizedModule.smul'_mk, ← LocalizedModule.zero_mk (1 : Submonoid.powers a₂),
        LocalizedModule.mk_eq]
      refine ⟨v, ?_⟩
      simp only [one_smul, smul_zero]
      show (v : A) • c • s = 0
      rw [smul_comm]
      exact h2

  obtain ⟨ρ, hρh, hcov⟩ : ∃ ρ : S →ₗ[A] LocalizedModule (Submonoid.powers a₂) S,
      (∀ s : S, ρ (h * s) = LocalizedModule.mk (h * s) 1) ∧
      ∀ s : S, ∃ y : LocalizedModule (Submonoid.powers a₂) S,
        LocalizedModule.map (Submonoid.powers a₂) (LinearMap.mulLeft A h) y = ρ s := by
    let π : S →ₗ[A] S ⧸ Ideal.span {h} := (Ideal.Quotient.mkₐ A (Ideal.span {h})).toLinearMap
    have hπ : Function.Surjective π := Ideal.Quotient.mkₐ_surjective A _
    have hπh : ∀ s, π (h * s) = 0 := fun s => by
      show Ideal.Quotient.mkₐ A (Ideal.span {h}) (h * s) = 0
      rw [Ideal.Quotient.mkₐ_eq_mk, Ideal.Quotient.eq_zero_iff_mem]
      exact Ideal.mul_mem_right s _ (Ideal.mem_span_singleton_self h)
    let F := LocalizedModule.map (Submonoid.powers a₂) π
    have hF : Function.Surjective F := LocalizedModule.map_surjective _ π hπ
    have hFmk : ∀ (t : S) (u : Submonoid.powers a₂),
        F (LocalizedModule.mk t u) = LocalizedModule.mk (π t) u := fun t u => by
      simp only [F, LocalizedModule.map_mk]
    have : Module.Projective (Localization.Away a₂)
        (LocalizedModule (Submonoid.powers a₂) (S ⧸ Ideal.span {h})) := Module.Projective.of_free
    obtain ⟨σ, hσ⟩ := Module.projective_lifting_property F LinearMap.id hF
    have hFσ : ∀ x, F (σ x) = x := fun x => LinearMap.congr_fun hσ x
    let mk1 := LocalizedModule.mkLinearMap (Submonoid.powers a₂) S
    let ρ : S →ₗ[A] LocalizedModule (Submonoid.powers a₂) S :=
      mk1 - (σ.restrictScalars A) ∘ₗ (F.restrictScalars A) ∘ₗ mk1
    have hρ : ∀ s, ρ s = LocalizedModule.mk s 1 - σ (F (LocalizedModule.mk s 1)) := fun s => rfl
    have hex : ∀ z, F z = 0 → ∃ y,
        LocalizedModule.map (Submonoid.powers a₂) (LinearMap.mulLeft A h) y = z := by
      intro z
      induction z using LocalizedModule.induction_on with
      | h t u =>
        intro hz
        rw [hFmk, ← LocalizedModule.zero_mk (1 : Submonoid.powers a₂), LocalizedModule.mk_eq] at hz
        obtain ⟨v, hv⟩ := hz
        simp only [one_smul, smul_zero] at hv
        have hv' : π ((v : A) • t) = 0 := by rw [map_smul]; exact hv
        have hmem : (v : A) • t ∈ Ideal.span {h} := by
          rw [← Ideal.Quotient.eq_zero_iff_mem, ← Ideal.Quotient.mkₐ_eq_mk A]; exact hv'
        obtain ⟨w, hw⟩ := Ideal.mem_span_singleton'.mp hmem
        refine ⟨LocalizedModule.mk w (v * u), ?_⟩
        rw [LocalizedModule.map_mk, LinearMap.mulLeft_apply, LocalizedModule.mk_eq]
        refine ⟨1, ?_⟩
        simp only [one_smul]
        rw [mul_comm h w, hw]
        show (u : A) • (v : A) • t = ((v : A) * (u : A)) • t
        rw [mul_comm, mul_smul]
    refine ⟨ρ, fun s => ?_, fun s => ?_⟩
    · rw [hρ, hFmk, hπh, LocalizedModule.zero_mk, map_zero, sub_zero]
    · exact hex (ρ s) (by rw [hρ, map_sub, hFσ, sub_self])

  let H := (LocalizedModule.map (Submonoid.powers a₂) (LinearMap.mulLeft A h)).restrictScalars A
  obtain ⟨τ, hτ⟩ : ∃ τ : S →ₗ[A] LocalizedModule (Submonoid.powers a₂) S,
      ∀ (n : S) (y : LocalizedModule (Submonoid.powers a₂) S), H y = ρ n → τ n = c • y := by
    have hK : LinearMap.ker H ≤ LinearMap.ker
        (c • LinearMap.id : LocalizedModule (Submonoid.powers a₂) S →ₗ[A] _) := by
      intro y hy
      rw [LinearMap.mem_ker] at hy ⊢
      simpa using hs2 y hy
    let q := (LinearMap.ker H).liftQ (c • LinearMap.id) hK
    let e := H.quotKerEquivRange
    let r : S →ₗ[A] LinearMap.range H := LinearMap.codRestrict (LinearMap.range H) ρ
      (fun n => by obtain ⟨y, hy⟩ := hcov n; exact LinearMap.mem_range.mpr ⟨y, hy⟩)
    refine ⟨q ∘ₗ e.symm.toLinearMap ∘ₗ r, ?_⟩
    intro n y hy
    have hr : r n = ⟨H y, LinearMap.mem_range_self H y⟩ := Subtype.ext (by simp [r, hy])
    simp only [LinearMap.comp_apply, LinearEquiv.coe_coe, hr, e]
    rw [LinearMap.quotKerEquivRange_symm_apply_image]
    simp [q]
  have hτh : ∀ s : S, τ (h * s) = c • LocalizedModule.mk s 1 := by
    intro s
    apply hτ
    show LocalizedModule.map (Submonoid.powers a₂) (LinearMap.mulLeft A h)
      (LocalizedModule.mk s 1) = ρ (h * s)
    rw [LocalizedModule.map_mk, LinearMap.mulLeft_apply, hρh]

  refine ⟨c * a₂, mul_ne_zero hc0 ha₂0, fun Ω _ _ hΩ => ?_⟩
  rw [map_mul] at hΩ
  have hcΩ : algebraMap A Ω c ≠ 0 := left_ne_zero_of_mul hΩ
  have hb : algebraMap A Ω a₂ ≠ 0 := right_ne_zero_of_mul hΩ
  let g : S →ₗ[A] TensorProduct A Ω S := TensorProduct.mk A Ω S 1
  have hunit : ∀ x : Submonoid.powers a₂,
      IsUnit (algebraMap A (Module.End A (TensorProduct A Ω S)) x) := by
    rintro ⟨x, hx⟩
    obtain ⟨k, rfl⟩ := (Submonoid.mem_powers_iff _ _).mp hx
    show IsUnit (algebraMap A (Module.End A (TensorProduct A Ω S)) (a₂ ^ k))
    rw [Module.End.isUnit_iff]
    have hk : algebraMap A Ω (a₂ ^ k) ≠ 0 := by rw [map_pow]; exact pow_ne_zero _ hb
    have hact : ∀ z : TensorProduct A Ω S,
        (algebraMap A (Module.End A (TensorProduct A Ω S)) (a₂ ^ k)) z
          = algebraMap A Ω (a₂ ^ k) • z := by
      intro z
      rw [Module.algebraMap_end_apply, algebraMap_smul]
    constructor
    · intro z1 z2 hz
      rw [hact, hact] at hz
      exact smul_right_injective _ hk hz
    · intro z
      refine ⟨(algebraMap A Ω (a₂ ^ k))⁻¹ • z, ?_⟩
      rw [hact, smul_inv_smul₀ hk]
  let lam := LocalizedModule.lift (Submonoid.powers a₂) g hunit
  have hlam : ∀ s : S, lam (LocalizedModule.mk s 1) = (1 : Ω) ⊗ₜ[A] s := by
    intro s
    have := LinearMap.congr_fun (LocalizedModule.lift_comp (Submonoid.powers a₂) g hunit) s
    rw [LinearMap.comp_apply, LocalizedModule.mkLinearMap_apply] at this
    exact this
  let Θ := LinearMap.liftBaseChange Ω (lam ∘ₗ τ)
  have key : ∀ z : TensorProduct A Ω S,
      Θ ((Algebra.TensorProduct.includeRight h : TensorProduct A Ω S) * z)
        = algebraMap A Ω c • z := by
    intro z
    induction z using TensorProduct.induction_on with
    | zero => rw [mul_zero, map_zero, smul_zero]
    | tmul ω s =>
      rw [Algebra.TensorProduct.includeRight_apply, Algebra.TensorProduct.tmul_mul_tmul, one_mul,
        LinearMap.liftBaseChange_tmul, LinearMap.comp_apply, hτh, map_smul, hlam]
      simp only [TensorProduct.smul_tmul']
      congr 1
      simp only [Algebra.smul_def, Algebra.algebraMap_self, RingHom.id_apply, mul_one]
      ring
    | add x y hx hy => rw [mul_add, map_add, hx, hy, smul_add]
  have hzero : ∀ z : TensorProduct A Ω S,
      (Algebra.TensorProduct.includeRight h : TensorProduct A Ω S) * z = 0 → z = 0 := by
    intro z hz
    have h1 := key z
    rw [hz, map_zero] at h1
    exact (smul_eq_zero.mp h1.symm).resolve_left hcΩ
  rw [mem_nonZeroDivisors_iff]
  refine ⟨fun z hz => hzero z hz, fun z hz => hzero z ?_⟩
  rw [mul_comm]; exact hz

theorem wc_geom_preirr_fibre_of_model : ∀ (B S Ω : Type u) [CommRing B] [CommRing S] [Algebra B S] [Field Ω] [Algebra B Ω] (b : B) (Q : Ideal S) (N : ℕ) (h : S) (n : ℕ) (F g : MvPolynomial (Fin n) B), algebraMap B Ω b ≠ 0 → (∀ x ∈ Q ^ N, b • x = 0) → (Algebra.TensorProduct.includeRight (Ideal.Quotient.mk Q h) : TensorProduct B Ω (S ⧸ Q)) ∈ nonZeroDivisors (TensorProduct B Ω (S ⧸ Q)) → Irreducible (MvPolynomial.map (algebraMap B Ω) F) → Nonempty (Localization.Away (Ideal.Quotient.mk Q (h * algebraMap B S b)) ≃ₐ[B] Localization.Away (Ideal.Quotient.mk (Ideal.span {F}) (g * MvPolynomial.C b))) → IsPreirreducible (Set.univ : Set (PrimeSpectrum (TensorProduct B Ω S))) :=
by
  intro B S Ω _ _ _ _ _ b Q N h n F g hb hQ hh hF hΦ
  obtain ⟨Φ⟩ := hΦ

  have htr : ∀ (R R' : Type u) [CommRing R] [CommRing R'], (R ≃+* R') →
      IsPreirreducible (Set.univ : Set (PrimeSpectrum R')) →
      IsPreirreducible (Set.univ : Set (PrimeSpectrum R)) := by
    intro R R' _ _ e hR'
    have := hR'.image (PrimeSpectrum.homeomorphOfRingEquiv e.symm)
      (PrimeSpectrum.homeomorphOfRingEquiv e.symm).continuous.continuousOn
    rwa [Set.image_univ_of_surjective (PrimeSpectrum.homeomorphOfRingEquiv e.symm).surjective]
      at this

  have s5 : ∀ (D : Type u) [CommRing D] [IsDomain D] (t : D),
      IsPreirreducible (Set.univ : Set (PrimeSpectrum (Localization.Away t))) := by
    intro D _ _ t
    by_cases ht : t = 0
    · subst ht
      have h01 : (0 : Localization.Away (0 : D)) = 1 := by
        have := IsLocalization.Away.algebraMap_isUnit (S := Localization.Away (0 : D)) (0 : D)
        rw [map_zero] at this
        exact isUnit_zero_iff.mp this
      have hempty : (Set.univ : Set (PrimeSpectrum (Localization.Away (0 : D)))) = ∅ := by
        ext p
        simp only [Set.mem_univ, Set.mem_empty_iff_false, iff_false, not_true_eq_false]
        apply p.isPrime.ne_top
        rw [Ideal.eq_top_iff_one, ← h01]
        exact Ideal.zero_mem _
      rw [hempty]
      exact isPreirreducible_empty
    · haveI : IsDomain (Localization.Away t) :=
        IsLocalization.isDomain_localization (powers_le_nonZeroDivisors_of_noZeroDivisors ht)
      exact (IrreducibleSpace.isIrreducible_univ _).isPreirreducible

  have s4 : ∀ (T : Type u) [CommRing T] (f : T), f ∈ nonZeroDivisors T →
      IsPreirreducible (Set.univ : Set (PrimeSpectrum (Localization.Away f))) →
      IsPreirreducible (Set.univ : Set (PrimeSpectrum T)) := by
    intro T _ f hf hpre
    have hinj : Function.Injective (algebraMap T (Localization.Away f)) :=
      IsLocalization.injective (M := Submonoid.powers f) _ (Submonoid.powers_le.mpr hf)
    have hker : RingHom.ker (algebraMap T (Localization.Away f)) = ⊥ :=
      (RingHom.injective_iff_ker_eq_bot _).mp hinj
    have h1 := PrimeSpectrum.closure_range_comap (algebraMap T (Localization.Away f))
    rw [hker, PrimeSpectrum.zeroLocus_bot] at h1
    rw [← h1, ← Set.image_univ]
    exact (hpre.image _ (PrimeSpectrum.continuous_comap _).continuousOn).closure

  have s3 : IsPreirreducible (Set.univ : Set (PrimeSpectrum (TensorProduct B Ω (S ⧸ Q)))) →
      IsPreirreducible (Set.univ : Set (PrimeSpectrum (TensorProduct B Ω S))) := by
    intro hT
    let φ : TensorProduct B Ω S →ₐ[B] TensorProduct B Ω (S ⧸ Q) :=
      Algebra.TensorProduct.map (AlgHom.id B Ω) (Ideal.Quotient.mkₐ B Q)
    let π : TensorProduct B Ω S →+* TensorProduct B Ω (S ⧸ Q) := φ.toRingHom
    have hπs : Function.Surjective π :=
      Algebra.TensorProduct.map_surjective (AlgHom.id B Ω) (Ideal.Quotient.mkₐ B Q)
        (fun x => ⟨x, rfl⟩) (Ideal.Quotient.mkₐ_surjective B Q)
    have hker : RingHom.ker φ = Ideal.map Algebra.TensorProduct.includeRight Q := by
      rw [Algebra.TensorProduct.lTensor_ker _ (Ideal.Quotient.mkₐ_surjective B Q)]
      congr 1
      ext x
      rw [RingHom.mem_ker, Ideal.Quotient.mkₐ_eq_mk, Ideal.Quotient.eq_zero_iff_mem]
    have hnil : ∀ y ∈ Q ^ N, (Algebra.TensorProduct.includeRight y : TensorProduct B Ω S) = 0 := by
      intro y hy
      have hu : IsUnit (algebraMap B (TensorProduct B Ω S) b) := by
        rw [IsScalarTower.algebraMap_apply B Ω (TensorProduct B Ω S)]
        exact (isUnit_iff_ne_zero.mpr hb).map _
      have h0 : algebraMap B (TensorProduct B Ω S) b *
          Algebra.TensorProduct.includeRight y = 0 := by
        rw [← Algebra.smul_def, ← map_smul, hQ y hy, map_zero]
      exact hu.mul_right_eq_zero.mp h0
    have hle : ∀ 𝔓 : Ideal (TensorProduct B Ω S), 𝔓.IsPrime → RingHom.ker π ≤ 𝔓 := by
      intro 𝔓 h𝔓
      show RingHom.ker φ ≤ 𝔓
      rw [hker, Ideal.map_le_iff_le_comap]
      intro x hx
      rw [Ideal.mem_comap]
      apply h𝔓.mem_of_pow_mem N
      rw [← map_pow, hnil _ (Ideal.pow_mem_pow hx N)]
      exact 𝔓.zero_mem
    have hsurj : ∀ 𝔓 : PrimeSpectrum (TensorProduct B Ω S),
        ∃ 𝔔 : PrimeSpectrum (TensorProduct B Ω (S ⧸ Q)), PrimeSpectrum.comap π 𝔔 = 𝔓 := by
      intro 𝔓
      haveI := 𝔓.isPrime
      have hk := hle 𝔓.asIdeal 𝔓.isPrime
      haveI hP' : (Ideal.map π 𝔓.asIdeal).IsPrime := Ideal.map_isPrime_of_surjective hπs hk
      refine ⟨⟨_, hP'⟩, ?_⟩
      ext1
      rw [PrimeSpectrum.comap_asIdeal]
      change Ideal.comap π (Ideal.map π 𝔓.asIdeal) = 𝔓.asIdeal
      rw [Ideal.comap_map_of_surjective _ hπs, ← RingHom.ker_eq_comap_bot, sup_eq_left.mpr hk]
    have hU : (Set.univ : Set (PrimeSpectrum (TensorProduct B Ω S))) =
        PrimeSpectrum.comap π '' Set.univ := by
      ext 𝔓
      simp only [Set.mem_univ, Set.image_univ, Set.mem_range, true_iff]
      exact hsurj 𝔓
    rw [hU]
    exact hT.image _ (PrimeSpectrum.continuous_comap π).continuousOn

  have s1 : ∀ (R : Type u) [CommRing R] [Algebra B R] (r : R),
      Nonempty (Localization.Away (Algebra.TensorProduct.includeRight r : TensorProduct B Ω R) ≃+*
        TensorProduct B Ω (Localization.Away r)) := by
    intro R _ _ r
    let c := (Algebra.TensorProduct.comm B Ω R).toRingEquiv
    have hc : Submonoid.map c.toMonoidHom
        (Submonoid.powers (Algebra.TensorProduct.includeRight r : TensorProduct B Ω R)) =
        Submonoid.powers (algebraMap R (TensorProduct B R Ω) r) := by
      rw [Submonoid.map_powers]
      congr 1
    let ea : Localization.Away (Algebra.TensorProduct.includeRight r : TensorProduct B Ω R) ≃+*
        Localization.Away (algebraMap R (TensorProduct B R Ω) r) :=
      IsLocalization.ringEquivOfRingEquiv (Localization.Away _) (Localization.Away _) c hc
    haveI : IsLocalization.Away (algebraMap R (TensorProduct B R Ω) r)
        (TensorProduct R (TensorProduct B R Ω) (Localization.Away r)) :=
      IsLocalization.Away.tensor (S := TensorProduct B R Ω) r (Localization.Away r)
    let eb := (IsLocalization.algEquiv (Submonoid.powers (algebraMap R (TensorProduct B R Ω) r))
      (Localization.Away (algebraMap R (TensorProduct B R Ω) r))
      (TensorProduct R (TensorProduct B R Ω) (Localization.Away r))).toRingEquiv
    let ec1 := (Algebra.TensorProduct.comm R (TensorProduct B R Ω)
      (Localization.Away r)).toRingEquiv
    let ec2 := (Algebra.TensorProduct.cancelBaseChange B R R (Localization.Away r) Ω).toRingEquiv
    let ed := (Algebra.TensorProduct.comm B (Localization.Away r) Ω).toRingEquiv
    exact ⟨ea.trans (eb.trans (ec1.trans (ec2.trans ed)))⟩

  have s2 : IsDomain (TensorProduct B Ω (MvPolynomial (Fin n) B ⧸ Ideal.span {F})) := by
    let e1 := Algebra.TensorProduct.tensorQuotientEquiv (R := B) Ω (MvPolynomial (Fin n) B) Ω
      (Ideal.span {F})
    let E := MvPolynomial.algebraTensorAlgEquiv (σ := Fin n) B Ω
    have hmap : Ideal.span {MvPolynomial.map (algebraMap B Ω) F} =
        Ideal.map (E : TensorProduct B Ω (MvPolynomial (Fin n) B) →+* MvPolynomial (Fin n) Ω)
          (Ideal.map (Algebra.TensorProduct.includeRight :
            MvPolynomial (Fin n) B →ₐ[B] TensorProduct B Ω (MvPolynomial (Fin n) B))
            (Ideal.span {F})) := by
      simp [E, Ideal.map_span, Algebra.TensorProduct.includeRight_apply,
        MvPolynomial.algebraTensorAlgEquiv_tmul]
    let e2 := Ideal.quotientEquivAlg _ _ E hmap
    have hprime : (Ideal.span {MvPolynomial.map (algebraMap B Ω) F}).IsPrime :=
      (Ideal.span_singleton_prime hF.ne_zero).mpr
        (UniqueFactorizationMonoid.irreducible_iff_prime.mp hF)
    haveI := hprime
    exact MulEquiv.isDomain _ (e1.trans e2).toMulEquiv

  have hf : (Algebra.TensorProduct.includeRight (Ideal.Quotient.mk Q (h * algebraMap B S b)) :
      TensorProduct B Ω (S ⧸ Q)) ∈ nonZeroDivisors (TensorProduct B Ω (S ⧸ Q)) := by
    rw [map_mul, map_mul, Ideal.Quotient.mk_algebraMap, AlgHom.commutes]
    refine mul_mem_nonZeroDivisors.mpr ⟨hh, ?_⟩
    apply IsUnit.mem_nonZeroDivisors
    rw [IsScalarTower.algebraMap_apply B Ω (TensorProduct B Ω (S ⧸ Q))]
    exact (isUnit_iff_ne_zero.mpr hb).map _
  obtain ⟨e1⟩ := s1 (S ⧸ Q) (Ideal.Quotient.mk Q (h * algebraMap B S b))
  obtain ⟨e3⟩ := s1 (MvPolynomial (Fin n) B ⧸ Ideal.span {F})
    (Ideal.Quotient.mk (Ideal.span {F}) (g * MvPolynomial.C b))
  let e2 := (Algebra.TensorProduct.congr (AlgEquiv.refl : Ω ≃ₐ[B] Ω) Φ).toRingEquiv
  haveI := s2
  have h5 := s5 _ (Algebra.TensorProduct.includeRight
    (Ideal.Quotient.mk (Ideal.span {F}) (g * MvPolynomial.C b)) :
      TensorProduct B Ω (MvPolynomial (Fin n) B ⧸ Ideal.span {F}))
  have hloc := htr _ _ (e1.trans (e2.trans e3.symm)) h5
  exact s3 (s4 _ _ hf hloc)

theorem wc_affine_geom_preirreducible_spread : ∀ (A R : Type u) [CommRing A] [IsDomain A] [IsNoetherianRing A] [CommRing R] [Algebra A R] [Algebra.FiniteType A R], (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] [Algebra A Ω], Function.Injective (algebraMap A Ω) → IsPreirreducible (Set.univ : Set (PrimeSpectrum (TensorProduct A Ω R)))) → ∃ a : A, a ≠ 0 ∧ ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] [Algebra A Ω], algebraMap A Ω a ≠ 0 → IsPreirreducible (Set.univ : Set (PrimeSpectrum (TensorProduct A Ω R))) :=
by
  intro A R _ _ _ _ _ _ hH
  classical
  by_cases hsub : Subsingleton (TensorProduct A (AlgebraicClosure (FractionRing A)) R)
  ·
    obtain ⟨a, ha0, ha⟩ := wc_geom_preirr_empty_generic_fibre A R hsub
    refine ⟨a, ha0, fun Ω _ _ _ hΩ => ?_⟩
    have hs := ha Ω hΩ
    have hempty : (Set.univ : Set (PrimeSpectrum (TensorProduct A Ω R))) = ∅ := by
      ext p
      simp only [Set.mem_univ, Set.mem_empty_iff_false, iff_false, not_true_eq_false]
      apply p.isPrime.ne_top
      rw [Ideal.eq_top_iff_one, hs.elim (1 : TensorProduct A Ω R) 0]
      exact Ideal.zero_mem _
    rw [hempty]
    exact isPreirreducible_empty
  ·
    rw [not_subsingleton_iff_nontrivial] at hsub
    have hinj : Function.Injective
        (algebraMap A (AlgebraicClosure (FractionRing A))) := by
      rw [IsScalarTower.algebraMap_eq A (FractionRing A) (AlgebraicClosure (FractionRing A))]
      exact (algebraMap (FractionRing A) (AlgebraicClosure (FractionRing A))).injective.comp
        (IsFractionRing.injective _ _)
    have hpre := hH (AlgebraicClosure (FractionRing A)) hinj
    have hirr : IsIrreducible (PrimeSpectrum.zeroLocus
        ((⊥ : Ideal (TensorProduct A (AlgebraicClosure (FractionRing A)) R)) :
          Set (TensorProduct A (AlgebraicClosure (FractionRing A)) R))) := by
      rw [Submodule.bot_coe, PrimeSpectrum.zeroLocus_singleton_zero]
      exact ⟨Set.univ_nonempty, hpre⟩
    rw [PrimeSpectrum.isIrreducible_zeroLocus_iff] at hirr
    have hnil : (nilradical (TensorProduct A (AlgebraicClosure (FractionRing A)) R)).IsPrime :=
      hirr

    haveI := hnil
    haveI : Algebra.FiniteType (AlgebraicClosure (FractionRing A))
        (TensorProduct A (AlgebraicClosure (FractionRing A)) R) :=
      Algebra.FiniteType.baseChange _
    haveI : Algebra.FiniteType (AlgebraicClosure (FractionRing A))
        (TensorProduct A (AlgebraicClosure (FractionRing A)) R ⧸
          nilradical (TensorProduct A (AlgebraicClosure (FractionRing A)) R)) :=
      Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ _ _) (Ideal.Quotient.mkₐ_surjective _ _)
    obtain ⟨n, F, g, t, hF, ht, hiso⟩ :=
      wc_birational_hypersurface_alg_closed (AlgebraicClosure (FractionRing A))
        (TensorProduct A (AlgebraicClosure (FractionRing A)) R ⧸
          nilradical (TensorProduct A (AlgebraicClosure (FractionRing A)) R))

    obtain ⟨A', _, _, _, hinjA', hintA', hftA', b, Q, N, h, m, F', g', hb0, hQ, hh, hF',
        hiso'⟩ := wc_geom_preirr_descend_model A R n F g t hnil hF ht hiso
    haveI := hftA'
    haveI : IsNoetherianRing A' := Algebra.FiniteType.isNoetherianRing A A'
    haveI : Algebra.FiniteType A' (TensorProduct A A' R) := Algebra.FiniteType.baseChange _
    haveI : Algebra.FiniteType A' (TensorProduct A A' R ⧸ Q) :=
      Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ _ _) (Ideal.Quotient.mkₐ_surjective _ _)

    obtain ⟨a₂, ha₂0, ha₂⟩ := wc_generic_freeness_finite_module A' (TensorProduct A A' R ⧸ Q)
      ((TensorProduct A A' R ⧸ Q) ⧸ Ideal.span {Ideal.Quotient.mk Q h})

    obtain ⟨a₆, ha₆0, ha₆⟩ := wc_generic_nzd_spread_of_free A' (TensorProduct A A' R ⧸ Q)
      (Ideal.Quotient.mk Q h) hh ⟨a₂, ha₂0, ha₂⟩

    obtain ⟨c₇, hc₇0, hc₇⟩ := wc_mvpoly_geom_irreducible_spread A' m F' hF'

    have hc'0 : b * a₆ * c₇ ≠ 0 := mul_ne_zero (mul_ne_zero hb0 ha₆0) hc₇0

    obtain ⟨c, hc0, hc⟩ := wc_alg_extend_hom_integral A A' hinjA' hintA' (b * a₆ * c₇) hc'0

    refine ⟨c, hc0, wc_geom_preirr_transfer_integral A A' R c (b * a₆ * c₇) hc ?_⟩
    intro Ω _ _ _ hΩ
    rw [map_mul, map_mul] at hΩ
    have hbΩ : algebraMap A' Ω b ≠ 0 := left_ne_zero_of_mul (left_ne_zero_of_mul hΩ)
    have ha₆Ω : algebraMap A' Ω a₆ ≠ 0 := right_ne_zero_of_mul (left_ne_zero_of_mul hΩ)
    have hc₇Ω : algebraMap A' Ω c₇ ≠ 0 := right_ne_zero_of_mul hΩ
    exact wc_geom_preirr_fibre_of_model A' (TensorProduct A A' R) Ω b Q N h m F' g' hbΩ hQ
      (ha₆ Ω ha₆Ω) (hc₇ Ω (algebraMap A' Ω) hc₇Ω) hiso'

theorem wc_affine_open_geom_points : ∀ (Y' : Scheme.{u}) [IsIntegral Y'] (W : Y'.Opens) (hW : IsAffineOpen W), (∀ (Ω : Type u) [Field Ω] (t : Spec (.of Ω) ⟶ Y'), t (IsLocalRing.closedPoint Ω) ∈ W → ∃ (_ : Algebra Γ(Y', W) Ω), t = Spec.map (CommRingCat.ofHom (algebraMap Γ(Y', W) Ω)) ≫ hW.fromSpec) ∧ ∀ (Ω : Type u) [Field Ω] [Algebra Γ(Y', W) Ω], (∀ a : Γ(Y', W), (Spec.map (CommRingCat.ofHom (algebraMap Γ(Y', W) Ω)) ≫ hW.fromSpec) (IsLocalRing.closedPoint Ω) ∈ Y'.basicOpen a ↔ algebraMap Γ(Y', W) Ω a ≠ 0) ∧ (genericPoint ↥Y' ∈ W → ((Spec.map (CommRingCat.ofHom (algebraMap Γ(Y', W) Ω)) ≫ hW.fromSpec) (IsLocalRing.closedPoint Ω) = genericPoint ↥Y' ↔ Function.Injective (algebraMap Γ(Y', W) Ω))) :=
by
  intro Y' _ W hW
  have hideal : ∀ (Ω : Type u) [Field Ω] [Algebra Γ(Y', W) Ω],
      PrimeSpectrum.asIdeal (Spec.map (CommRingCat.ofHom (algebraMap Γ(Y', W) Ω))
        (IsLocalRing.closedPoint Ω)) = RingHom.ker (algebraMap Γ(Y', W) Ω) := by
    intro Ω _ _
    show Ideal.comap (algebraMap Γ(Y', W) Ω) (IsLocalRing.maximalIdeal Ω) = _
    rw [IsLocalRing.maximalIdeal_eq_bot, RingHom.ker_eq_comap_bot]
  refine ⟨?_, ?_⟩
  · intro Ω _ t ht
    have hrange : Set.range t ⊆ Set.range hW.fromSpec := by
      rw [hW.range_fromSpec]
      rintro _ ⟨x, rfl⟩
      rwa [Subsingleton.elim x (IsLocalRing.closedPoint Ω)]
    refine ⟨(Spec.preimage (IsOpenImmersion.lift hW.fromSpec t hrange)).hom.toAlgebra, ?_⟩
    rw [RingHom.algebraMap_toAlgebra, CommRingCat.ofHom_hom, Spec.map_preimage,
      IsOpenImmersion.lift_fac]
  · intro Ω _ _
    have hcomp : (Spec.map (CommRingCat.ofHom (algebraMap Γ(Y', W) Ω)) ≫ hW.fromSpec)
        (IsLocalRing.closedPoint Ω) = hW.fromSpec (Spec.map (CommRingCat.ofHom
          (algebraMap Γ(Y', W) Ω)) (IsLocalRing.closedPoint Ω)) :=
      Scheme.Hom.comp_apply _ _ _
    have hk : ∀ a : Γ(Y', W), a ∈ PrimeSpectrum.asIdeal (Spec.map (CommRingCat.ofHom
        (algebraMap Γ(Y', W) Ω)) (IsLocalRing.closedPoint Ω)) ↔ algebraMap Γ(Y', W) Ω a = 0 := by
      intro a
      rw [hideal, RingHom.mem_ker]
    refine ⟨fun a => ?_, fun hη => ?_⟩
    · rw [hcomp, ← Scheme.Hom.mem_preimage, hW.fromSpec_preimage_basicOpen]
      exact (PrimeSpectrum.mem_basicOpen a _).trans (not_congr (hk a))
    · haveI : Nonempty W := ⟨⟨_, hη⟩⟩
      haveI : IsDomain Γ(Y', W) := IsIntegral.component_integral W
      have hgen : hW.fromSpec (genericPoint (Spec Γ(Y', W))) = genericPoint Y' :=
        genericPoint_eq_of_isOpenImmersion _
      have hbot : PrimeSpectrum.asIdeal (genericPoint (Spec Γ(Y', W))) = ⊥ := by
        rw [genericPoint_eq_bot_of_affine]
        rfl
      have hk2 : PrimeSpectrum.asIdeal (Spec.map (CommRingCat.ofHom
          (algebraMap Γ(Y', W) Ω)) (IsLocalRing.closedPoint Ω)) =
          PrimeSpectrum.asIdeal (genericPoint (Spec Γ(Y', W))) ↔
          Function.Injective (algebraMap Γ(Y', W) Ω) := by
        rw [hideal, hbot, RingHom.injective_iff_ker_eq_bot]
      rw [hcomp, ← hgen, hW.fromSpec.isOpenEmbedding.isEmbedding.injective.eq_iff]
      exact PrimeSpectrum.ext_iff.trans hk2

theorem wc_affine_chart_fibre_homeo : ∀ (X' Y' : Scheme.{u}) (f : X' ⟶ Y') [LocallyOfFiniteType f] (W : Y'.Opens) (hW : IsAffineOpen W) (U : X'.Opens), IsAffineOpen U → U ≤ f ⁻¹ᵁ W → ∀ (Z : Set ↥X'), IsClosed Z → ∃ (R : Type u) (_ : CommRing R) (_ : Algebra Γ(Y', W) R), Algebra.FiniteType Γ(Y', W) R ∧ ∀ (Ω : Type u) [Field Ω] [Algebra Γ(Y', W) Ω], Nonempty (↥((Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap Γ(Y', W) Ω)) ≫ hW.fromSpec)) ⁻¹' (Z ∩ (U : Set ↥X'))) ≃ₜ PrimeSpectrum (TensorProduct Γ(Y', W) Ω R)) :=
by
  intro X' Y' f _ W hW U hU h Z hZ

  have s3 : ∀ (A B C : Type u) [CommRing A] [CommRing B] [CommRing C] [Algebra A B] [Algebra A C]
      (I : Ideal B), Nonempty (↥{x : PrimeSpectrum (TensorProduct A B C) | I ≤ Ideal.comap
        (Algebra.TensorProduct.includeLeftRingHom : B →+* TensorProduct A B C) x.asIdeal} ≃ₜ
        PrimeSpectrum (TensorProduct A C (B ⧸ I))) := by
    intro A B C _ _ _ _ _ I
    let φ := Algebra.TensorProduct.map (Ideal.Quotient.mkₐ A I) (AlgHom.id A C)
    have hsurj : Function.Surjective φ.toRingHom :=
      Algebra.TensorProduct.map_surjective (Ideal.Quotient.mkₐ A I) (AlgHom.id A C)
        (Ideal.Quotient.mkₐ_surjective A I) (fun x => ⟨x, rfl⟩)
    have hker : RingHom.ker φ.toRingHom =
        Ideal.map (Algebra.TensorProduct.includeLeftRingHom : B →+* TensorProduct A B C) I := by
      have := Algebra.TensorProduct.rTensor_ker (R := A) (S := A) (C := C)
        (Ideal.Quotient.mkₐ A I) (Ideal.Quotient.mkₐ_surjective A I)
      have hk : RingHom.ker (Ideal.Quotient.mkₐ A I) = I := by
        ext b
        simp [RingHom.mem_ker, Ideal.Quotient.eq_zero_iff_mem]
      rw [hk] at this
      exact this
    have hemb := PrimeSpectrum.isClosedEmbedding_comap_of_surjective _ φ.toRingHom hsurj
    have hrange : Set.range (PrimeSpectrum.comap φ.toRingHom) =
        {x : PrimeSpectrum (TensorProduct A B C) | I ≤ Ideal.comap
          (Algebra.TensorProduct.includeLeftRingHom : B →+* TensorProduct A B C) x.asIdeal} := by
      ext x
      simp only [Set.mem_range, Set.mem_setOf_eq]
      rw [← Ideal.map_le_iff_le_comap, ← hker]
      constructor
      · rintro ⟨y, rfl⟩
        rw [PrimeSpectrum.comap_asIdeal, RingHom.ker_eq_comap_bot]
        exact Ideal.comap_mono bot_le
      · intro hx
        refine ⟨⟨Ideal.map φ.toRingHom x.asIdeal, Ideal.map_isPrime_of_surjective hsurj hx⟩, ?_⟩
        ext1
        rw [PrimeSpectrum.comap_asIdeal]
        change Ideal.comap φ.toRingHom (Ideal.map φ.toRingHom x.asIdeal) = x.asIdeal
        rw [Ideal.comap_map_of_surjective' _ hsurj, sup_eq_left.mpr hx]
    exact ⟨((hemb.isEmbedding.toHomeomorph.trans (Homeomorph.setCongr hrange)).symm).trans
      (PrimeSpectrum.homeomorphOfRingEquiv (Algebra.TensorProduct.comm A (B ⧸ I) C).toRingEquiv)⟩

  letI : Algebra Γ(Y', W) Γ(X', U) := (f.appLE W U h).hom.toAlgebra
  have hα : algebraMap Γ(Y', W) Γ(X', U) = (f.appLE W U h).hom := RingHom.algebraMap_toAlgebra _
  have hBft : Algebra.FiniteType Γ(Y', W) Γ(X', U) :=
    HasRingHomProperty.appLE @LocallyOfFiniteType f inferInstance ⟨W, hW⟩ ⟨U, hU⟩ h
  let I : Ideal Γ(X', U) := PrimeSpectrum.vanishingIdeal (hU.fromSpec ⁻¹' Z)
  have hZ' : IsClosed (hU.fromSpec ⁻¹' Z) := hZ.preimage hU.fromSpec.continuous
  have hzl : PrimeSpectrum.zeroLocus (I : Set Γ(X', U)) = hU.fromSpec ⁻¹' Z :=
    (PrimeSpectrum.zeroLocus_vanishingIdeal_eq_closure _).trans hZ'.closure_eq
  refine ⟨Γ(X', U) ⧸ I, inferInstance, inferInstance,
    Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ _ I) (Ideal.Quotient.mkₐ_surjective _ I), ?_⟩
  intro Ω _ _

  have s2 : ∃ Θ : Spec (.of (TensorProduct Γ(Y', W) Γ(X', U) Ω)) ⟶
      Limits.pullback f (Spec.map (CommRingCat.ofHom (algebraMap Γ(Y', W) Ω)) ≫ hW.fromSpec),
      IsOpenImmersion Θ ∧ Set.range Θ = (Limits.pullback.fst f (Spec.map (CommRingCat.ofHom
        (algebraMap Γ(Y', W) Ω)) ≫ hW.fromSpec)) ⁻¹' (U : Set X') ∧
      Θ ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap Γ(Y', W) Ω)) ≫
        hW.fromSpec) = Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom :
          Γ(X', U) →+* TensorProduct Γ(Y', W) Γ(X', U) Ω)) ≫ hU.fromSpec := by
    set gB : Spec (.of Γ(X', U)) ⟶ Spec (.of Γ(Y', W)) :=
      Spec.map (CommRingCat.ofHom (algebraMap Γ(Y', W) Γ(X', U))) with hgB
    set gΩ : Spec (.of Ω) ⟶ Spec (.of Γ(Y', W)) :=
      Spec.map (CommRingCat.ofHom (algebraMap Γ(Y', W) Ω)) with hgΩ
    have hc : hU.fromSpec ≫ f = gB ≫ hW.fromSpec := by
      rw [← IsAffineOpen.SpecMap_appLE_fromSpec f hW hU h, hgB, hα, CommRingCat.ofHom_hom]
    have hP := IsPullback.of_isLimit (Limits.pullbackIsPullbackOfCompMono gB gΩ hW.fromSpec)
    let e₃ : Limits.pullback gB gΩ ≅ Limits.pullback (gB ≫ hW.fromSpec) (gΩ ≫ hW.fromSpec) :=
      hP.isoPullback
    have h3 : e₃.hom ≫ Limits.pullback.fst (gB ≫ hW.fromSpec) (gΩ ≫ hW.fromSpec) =
        Limits.pullback.fst gB gΩ :=
      hP.isoPullback_hom_fst
    let e₂ : Limits.pullback (hU.fromSpec ≫ f) (gΩ ≫ hW.fromSpec) ≅
        Limits.pullback (gB ≫ hW.fromSpec) (gΩ ≫ hW.fromSpec) :=
      Limits.pullback.congrHom hc rfl
    have h2 : e₂.inv ≫ Limits.pullback.fst (hU.fromSpec ≫ f) (gΩ ≫ hW.fromSpec) =
        Limits.pullback.fst (gB ≫ hW.fromSpec) (gΩ ≫ hW.fromSpec) := by
      simp only [e₂, Limits.pullback.congrHom_inv, Limits.pullback.lift_fst, Category.comp_id]
    let e₁ := Limits.pullbackRightPullbackFstIso f (gΩ ≫ hW.fromSpec) hU.fromSpec
    have h1 : e₁.inv ≫ Limits.pullback.fst hU.fromSpec (Limits.pullback.fst f (gΩ ≫ hW.fromSpec)) =
        Limits.pullback.fst (hU.fromSpec ≫ f) (gΩ ≫ hW.fromSpec) :=
      Limits.pullbackRightPullbackFstIso_inv_fst _ _ _
    let e₄ := pullbackSpecIso Γ(Y', W) Γ(X', U) Ω
    have h4 : e₄.inv ≫ Limits.pullback.fst gB gΩ = Spec.map (CommRingCat.ofHom
        (Algebra.TensorProduct.includeLeftRingHom : Γ(X', U) →+* TensorProduct Γ(Y', W) Γ(X', U) Ω)) :=
      pullbackSpecIso_inv_fst _ _ _
    let E : Spec (.of (TensorProduct Γ(Y', W) Γ(X', U) Ω)) ≅
        Limits.pullback hU.fromSpec (Limits.pullback.fst f (gΩ ≫ hW.fromSpec)) :=
      e₄.symm ≪≫ e₃ ≪≫ e₂.symm ≪≫ e₁.symm
    have hE : E.hom ≫ Limits.pullback.fst hU.fromSpec (Limits.pullback.fst f (gΩ ≫ hW.fromSpec)) =
        Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom :
          Γ(X', U) →+* TensorProduct Γ(Y', W) Γ(X', U) Ω)) := by
      change e₄.inv ≫ e₃.hom ≫ e₂.inv ≫ e₁.inv ≫
        Limits.pullback.fst hU.fromSpec (Limits.pullback.fst f (gΩ ≫ hW.fromSpec)) = _
      rw [h1, h2, h3, h4]
    have hrange : Set.range (Limits.pullback.snd hU.fromSpec
        (Limits.pullback.fst f (gΩ ≫ hW.fromSpec))) =
        (Limits.pullback.fst f (gΩ ≫ hW.fromSpec)) ⁻¹' (U : Set X') :=
      (Scheme.Pullback.range_snd _ _).trans (by rw [hU.range_fromSpec])
    refine ⟨E.hom ≫ Limits.pullback.snd _ _, inferInstance, ?_, ?_⟩
    · rw [← hrange]
      ext y
      constructor
      · rintro ⟨x, rfl⟩
        exact ⟨E.hom x, (Scheme.Hom.comp_apply _ _ _).symm⟩
      · rintro ⟨q, rfl⟩
        refine ⟨E.inv q, ?_⟩
        rw [Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply E.inv E.hom, Iso.inv_hom_id]
        rfl
    · rw [Category.assoc, ← Limits.pullback.condition, ← Category.assoc, hE]

  obtain ⟨Θ, hΘo, hΘr, hΘe⟩ := s2
  let T : Set (PrimeSpectrum (TensorProduct Γ(Y', W) Γ(X', U) Ω)) :=
    {x | I ≤ Ideal.comap (Algebra.TensorProduct.includeLeftRingHom :
      Γ(X', U) →+* TensorProduct Γ(Y', W) Γ(X', U) Ω) x.asIdeal}
  have hpt : ∀ x, (Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap Γ(Y', W) Ω)) ≫
      hW.fromSpec)) (Θ x) = hU.fromSpec (PrimeSpectrum.comap
        (Algebra.TensorProduct.includeLeftRingHom :
          Γ(X', U) →+* TensorProduct Γ(Y', W) Γ(X', U) Ω) x) := by
    intro x
    rw [← Scheme.Hom.comp_apply, hΘe, Scheme.Hom.comp_apply]
    rfl
  have hpre : Θ ⁻¹' ((Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap Γ(Y', W) Ω)) ≫
      hW.fromSpec)) ⁻¹' (Z ∩ (U : Set ↥X'))) = T := by
    ext x
    simp only [Set.mem_preimage, Set.mem_inter_iff, hpt]
    constructor
    · rintro ⟨hz, -⟩
      have h1 : PrimeSpectrum.comap (Algebra.TensorProduct.includeLeftRingHom :
          Γ(X', U) →+* TensorProduct Γ(Y', W) Γ(X', U) Ω) x ∈
          PrimeSpectrum.zeroLocus (I : Set Γ(X', U)) := by
        rw [hzl]; exact hz
      exact h1
    · intro hx
      refine ⟨?_, ?_⟩
      · have h1 : PrimeSpectrum.comap (Algebra.TensorProduct.includeLeftRingHom :
            Γ(X', U) →+* TensorProduct Γ(Y', W) Γ(X', U) Ω) x ∈
            PrimeSpectrum.zeroLocus (I : Set Γ(X', U)) := hx
        rw [hzl] at h1
        exact h1
      · rw [← hU.range_fromSpec]
        exact ⟨_, rfl⟩
  have himg : (Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap Γ(Y', W) Ω)) ≫
      hW.fromSpec)) ⁻¹' (Z ∩ (U : Set ↥X')) = Θ '' T := by
    rw [← hpre, Set.image_preimage_eq_of_subset]
    rw [hΘr]
    exact Set.preimage_mono Set.inter_subset_right
  obtain ⟨k₃⟩ := s3 Γ(Y', W) Γ(X', U) Ω I
  exact ⟨(Homeomorph.setCongr himg).trans
    ((Θ.isOpenEmbedding.isEmbedding.homeomorphImage T).symm.trans k₃)⟩

theorem wc_spread_geom_irreducible_closed : ∀ (X' Y' : Scheme.{u}) (f : X' ⟶ Y') [IsProper f] [IsIntegral Y'] [IsLocallyNoetherian Y'] (Z : Set ↥X'), IsClosed Z → (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (t : Spec (.of Ω) ⟶ Y'), t (IsLocalRing.closedPoint Ω) = genericPoint Y' → IsIrreducible ((Limits.pullback.fst f t) ⁻¹' Z)) → ∃ V : Set ↥Y', IsOpen V ∧ genericPoint Y' ∈ V ∧ ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (t : Spec (.of Ω) ⟶ Y'), t (IsLocalRing.closedPoint Ω) ∈ V → IsIrreducible ((Limits.pullback.fst f t) ⁻¹' Z) :=
by
  intro X' Y' f _ _ _ Z hZ hgen
  classical

  have s1 : ∀ (T : Type u) [TopologicalSpace T] (ι : Type u) (S : Set T) (O : ι → Set T),
      (∀ k, IsOpen (O k)) → S ⊆ ⋃ k, O k → S.Nonempty →
      (∀ k, (S ∩ O k).Nonempty → IsPreirreducible (S ∩ O k)) →
      (∀ k l, (S ∩ O k).Nonempty → (S ∩ O l).Nonempty → (S ∩ O k ∩ O l).Nonempty) →
      IsIrreducible S := by
    intro T _ ι S O hO hcov hne hirr hmeet
    refine ⟨hne, ?_⟩
    intro u v hu hv ⟨x, hxS, hxu⟩ ⟨y, hyS, hyv⟩
    obtain ⟨k, hk⟩ := Set.mem_iUnion.mp (hcov hxS)
    obtain ⟨l, hl⟩ := Set.mem_iUnion.mp (hcov hyS)
    have hk' : (S ∩ O k).Nonempty := ⟨x, hxS, hk⟩
    have hl' : (S ∩ O l).Nonempty := ⟨y, hyS, hl⟩
    obtain ⟨z, ⟨hzS, hzk⟩, hzl⟩ := hmeet k l hk' hl'
    obtain ⟨p, ⟨hpS, hpk⟩, hpu, hpl⟩ := hirr k hk' u (O l) hu (hO l)
      ⟨x, ⟨hxS, hk⟩, hxu⟩ ⟨z, ⟨hzS, hzk⟩, hzl⟩
    obtain ⟨q, ⟨hqS, hql⟩, hqu, hqv⟩ := hirr l hl' u v hu hv
      ⟨p, ⟨hpS, hpl⟩, hpu⟩ ⟨y, ⟨hyS, hl⟩, hyv⟩
    exact ⟨q, hqS, hqu, hqv⟩

  have hPO : ∀ {T : Type u} [TopologicalSpace T] (S O : Set T), IsPreirreducible S → IsOpen O →
      IsPreirreducible (S ∩ O) := by
    intro T _ S O hS hO u v hu hv ⟨x, ⟨hxS, hxO⟩, hxu⟩ ⟨y, ⟨hyS, hyO⟩, hyv⟩
    obtain ⟨z, hzS, ⟨hzu, hzO⟩, hzv, -⟩ := hS (u ∩ O) (v ∩ O) (hu.inter hO) (hv.inter hO)
      ⟨x, hxS, hxu, hxO⟩ ⟨y, hyS, hyv, hyO⟩
    exact ⟨z, ⟨hzS, hzO⟩, hzu, hzv⟩

  have hover : ∀ (Ω : Type u) [Field Ω] (t : Spec (.of Ω) ⟶ Y') (w : ↥(Limits.pullback f t)),
      f (Limits.pullback.fst f t w) = t (IsLocalRing.closedPoint Ω) := by
    intro Ω _ t w
    rw [← Scheme.Hom.comp_apply, Limits.pullback.condition, Scheme.Hom.comp_apply]
    congr 1
    exact Subsingleton.elim _ _
  have hF : ∀ (Ω : Type u) [Field Ω] (t : Spec (.of Ω) ⟶ Y') (T : Set X'),
      ((Limits.pullback.fst f t) ⁻¹' T).Nonempty ↔ t (IsLocalRing.closedPoint Ω) ∈ f '' T := by
    intro Ω _ t T
    constructor
    · rintro ⟨w, hw⟩
      exact ⟨_, hw, hover Ω t w⟩
    · rintro ⟨x, hx, hxt⟩
      obtain ⟨w, hw, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := f) (g := t) x
        (IsLocalRing.closedPoint Ω) hxt
      exact ⟨w, by rw [Set.mem_preimage, hw]; exact hx⟩

  obtain ⟨W, hWaff, hηW, -⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp
    (Scheme.isBasis_affineOpens Y')) (show genericPoint Y' ∈ (⊤ : Y'.Opens) from trivial)
  have hW : IsAffineOpen W := hWaff
  haveI : Nonempty W := ⟨⟨_, hηW⟩⟩
  haveI hAdom : IsDomain Γ(Y', W) := IsIntegral.component_integral W
  haveI hAnoeth : IsNoetherianRing Γ(Y', W) := IsLocallyNoetherian.component_noetherian ⟨W, hW⟩

  have hcomp : IsCompact ((f ⁻¹ᵁ W : X'.Opens) : Set X') :=
    QuasiCompact.isCompact_preimage (f := f) _ W.isOpen hW.isCompact
  obtain ⟨s, hsfin, hseq⟩ := isCompact_iff_finite_and_eq_biUnion_affineOpens.mp hcomp
  haveI : Finite s := hsfin.to_subtype
  have hUle : ∀ k : s, k.1.1 ≤ f ⁻¹ᵁ W := by
    intro k
    rw [hseq]
    exact le_iSup₂_of_le k.1 k.2 le_rfl
  have hcov : ∀ x : X', f x ∈ W → ∃ k : s, x ∈ (k.1.1 : Set X') := by
    intro x hx
    have hx' : x ∈ f ⁻¹ᵁ W := hx
    rw [hseq] at hx'
    simp only [TopologicalSpace.Opens.mem_iSup] at hx'
    obtain ⟨i, hi, hxi⟩ := hx'
    exact ⟨⟨i, hi⟩, hxi⟩

  have hchart := fun k : s => wc_affine_chart_fibre_homeo X' Y' f W hW k.1.1 k.1.2 (hUle k) Z hZ
  choose R hRring hRalg hRft hR using hchart
  letI : ∀ k, CommRing (R k) := hRring
  letI : ∀ k, Algebra Γ(Y', W) (R k) := hRalg
  haveI : ∀ k, Algebra.FiniteType Γ(Y', W) (R k) := hRft

  obtain ⟨s4i, s4ii⟩ := wc_affine_open_geom_points Y' W hW

  have hinj₀ : Function.Injective
      (algebraMap Γ(Y', W) (AlgebraicClosure (FractionRing Γ(Y', W)))) := by
    rw [IsScalarTower.algebraMap_eq Γ(Y', W) (FractionRing Γ(Y', W))
      (AlgebraicClosure (FractionRing Γ(Y', W)))]
    exact (algebraMap (FractionRing Γ(Y', W))
      (AlgebraicClosure (FractionRing Γ(Y', W)))).injective.comp (IsFractionRing.injective _ _)
  obtain ⟨t₀, ht₀def⟩ : ∃ t : Spec (.of (AlgebraicClosure (FractionRing Γ(Y', W)))) ⟶ Y',
      t = Spec.map (CommRingCat.ofHom (algebraMap Γ(Y', W)
        (AlgebraicClosure (FractionRing Γ(Y', W))))) ≫ hW.fromSpec := ⟨_, rfl⟩
  have ht₀ : t₀ (IsLocalRing.closedPoint _) = genericPoint Y' := by
    rw [ht₀def]
    exact ((s4ii _).2 hηW).mpr hinj₀
  have hS₀ := hgen _ t₀ ht₀

  have hspread : ∀ k : s, ∃ a : Γ(Y', W), a ≠ 0 ∧ ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
      [Algebra Γ(Y', W) Ω], algebraMap Γ(Y', W) Ω a ≠ 0 →
      IsPreirreducible (Set.univ : Set (PrimeSpectrum (TensorProduct Γ(Y', W) Ω (R k)))) := by
    intro k
    apply wc_affine_geom_preirreducible_spread
    intro Ω _ _ _ hinj
    have ht : (Spec.map (CommRingCat.ofHom (algebraMap Γ(Y', W) Ω)) ≫ hW.fromSpec)
        (IsLocalRing.closedPoint Ω) = genericPoint Y' := ((s4ii Ω).2 hηW).mpr hinj
    have hirr := hgen Ω _ ht
    have hpre : IsPreirreducible ((Limits.pullback.fst f (Spec.map (CommRingCat.ofHom
        (algebraMap Γ(Y', W) Ω)) ≫ hW.fromSpec)) ⁻¹' (Z ∩ (k.1.1 : Set X'))) := by
      rw [Set.preimage_inter]
      exact hPO _ _ hirr.isPreirreducible ((k.1.1).isOpen.preimage (Scheme.Hom.continuous _))
    obtain ⟨e⟩ := hR k Ω
    have h1 := @PreirreducibleSpace.isPreirreducible_univ _ _ (Subtype.preirreducibleSpace hpre)
    have h2 := h1.image e e.continuous.continuousOn
    rwa [Set.image_univ, e.surjective.range_eq] at h2
  choose a ha0 ha using hspread

  have hV1 := fun k : s => wc_generic_constructible_dichotomy X' Y' f Z (k.1.1 : Set X') hZ
    k.1.1.isOpen
  choose V1 hV1o hV1η hV1in hV1out using hV1
  have hV2 := fun k l : s => wc_generic_constructible_dichotomy X' Y' f Z
    ((k.1.1 : Set X') ∩ (l.1.1 : Set X')) hZ (k.1.1.isOpen.inter l.1.1.isOpen)
  choose V2 hV2o hV2η hV2in hV2out using hV2

  have hηD : ∀ k, genericPoint Y' ∈ Y'.basicOpen (a k) := by
    intro k
    rw [← ht₀, ht₀def]
    exact ((s4ii _).1 (a k)).mpr (fun h => ha0 k (hinj₀ (h.trans (map_zero _).symm)))
  refine ⟨(W : Set Y') ∩ (⋂ k, (Y'.basicOpen (a k) : Set Y')) ∩ (⋂ k, V1 k) ∩
      (⋂ k, ⋂ l, V2 k l), ?_, ?_, ?_⟩
  · exact ((W.isOpen.inter (isOpen_iInter_of_finite fun k => (Y'.basicOpen (a k)).isOpen)).inter
      (isOpen_iInter_of_finite hV1o)).inter
      (isOpen_iInter_of_finite fun k => isOpen_iInter_of_finite (hV2o k))
  · exact ⟨⟨⟨hηW, Set.mem_iInter.mpr hηD⟩, Set.mem_iInter.mpr hV1η⟩,
      Set.mem_iInter.mpr fun k => Set.mem_iInter.mpr (hV2η k)⟩

  obtain ⟨w₀, hw₀⟩ := hS₀.nonempty
  have hfw₀ : f (Limits.pullback.fst f t₀ w₀) = genericPoint Y' := (hover _ t₀ w₀).trans ht₀
  obtain ⟨k₀, hk₀⟩ := hcov _ (by rw [hfw₀]; exact hηW)
  have hk₀E : genericPoint Y' ∈ f '' (Z ∩ (k₀.1.1 : Set X')) := ⟨_, ⟨hw₀, hk₀⟩, hfw₀⟩
  have h2 : ∀ k l : s, genericPoint Y' ∈ f '' (Z ∩ (k.1.1 : Set X')) →
      genericPoint Y' ∈ f '' (Z ∩ (l.1.1 : Set X')) →
      genericPoint Y' ∈ f '' (Z ∩ ((k.1.1 : Set X') ∩ (l.1.1 : Set X'))) := by
    intro k l hk hl
    rw [← ht₀] at hk hl ⊢
    obtain ⟨x, hxZ, hxk⟩ := (hF _ t₀ _).mpr hk
    obtain ⟨y, hyZ, hyl⟩ := (hF _ t₀ _).mpr hl
    obtain ⟨z, hzZ, hzk, hzl⟩ := hS₀.isPreirreducible _ _
      ((k.1.1).isOpen.preimage (Scheme.Hom.continuous _))
      ((l.1.1).isOpen.preimage (Scheme.Hom.continuous _)) ⟨x, hxZ, hxk⟩ ⟨y, hyZ, hyl⟩
    exact (hF _ t₀ _).mp ⟨z, hzZ, hzk, hzl⟩

  intro Ω _ _ t ht
  have htW : t (IsLocalRing.closedPoint Ω) ∈ W := ht.1.1.1
  have htD : ∀ k, t (IsLocalRing.closedPoint Ω) ∈ Y'.basicOpen (a k) :=
    fun k => Set.mem_iInter.mp ht.1.1.2 k
  have htV1 : ∀ k, t (IsLocalRing.closedPoint Ω) ∈ V1 k := fun k => Set.mem_iInter.mp ht.1.2 k
  have htV2 : ∀ k l, t (IsLocalRing.closedPoint Ω) ∈ V2 k l :=
    fun k l => Set.mem_iInter.mp (Set.mem_iInter.mp ht.2 k) l
  have hEk : ∀ k : s, t (IsLocalRing.closedPoint Ω) ∈ f '' (Z ∩ (k.1.1 : Set X')) →
      genericPoint Y' ∈ f '' (Z ∩ (k.1.1 : Set X')) := by
    intro k hk
    by_contra hη
    exact Set.disjoint_left.mp (hV1out k hη) (htV1 k) hk
  obtain ⟨alg, rfl⟩ := s4i Ω t htW
  refine s1 _ s _ (fun k => (Limits.pullback.fst f _) ⁻¹' (k.1.1 : Set X'))
    (fun k => (k.1.1).isOpen.preimage (Scheme.Hom.continuous _)) ?_ ?_ ?_ ?_
  · intro w _
    obtain ⟨k, hk⟩ := hcov _ (by rw [hover Ω _ w]; exact htW)
    exact Set.mem_iUnion.mpr ⟨k, hk⟩
  · obtain ⟨w, hwZ, -⟩ := (hF Ω _ _).mpr (hV1in k₀ hk₀E (htV1 k₀))
    exact ⟨w, hwZ⟩
  · intro k _
    beta_reduce
    rw [← Set.preimage_inter]
    obtain ⟨e⟩ := hR k Ω
    have h1 := (ha k Ω (((s4ii Ω).1 (a k)).mp (htD k))).image e.symm e.symm.continuous.continuousOn
    rw [Set.image_univ, e.symm.surjective.range_eq] at h1
    have h3 := h1.image Subtype.val continuous_subtype_val.continuousOn
    rwa [Subtype.coe_image_univ] at h3
  · intro k l hk hl
    beta_reduce at hk hl ⊢
    rw [← Set.preimage_inter] at hk hl
    have hk' := hEk k ((hF Ω _ _).mp hk)
    have hl' := hEk l ((hF Ω _ _).mp hl)
    obtain ⟨w, hwZ, hwk, hwl⟩ := (hF Ω _ _).mpr (hV2in k l (h2 k l hk' hl') (htV2 k l))
    exact ⟨w, ⟨hwZ, hwk⟩, hwl⟩

theorem wc_fibre_closed_cover_pattern_generic : ∀ (K : Type u) [Field K] [IsAlgClosed K] (S X : Scheme.{u}) (fS : S ⟶ Spec (.of K)) [IsProper fS] [IsIntegral S] (g : X ⟶ S) [IsProper g], ∃ W : Set S, IsOpen W ∧ genericPoint S ∈ W ∧ ∃ (n : ℕ) (P : Fin n → Fin n → Prop), ∀ y ∈ W, ∃ C : Fin n → Set ↥(Limits.pullback g (wcEtGeomPt S y)), (∀ i, IsClosed (C i)) ∧ (∀ i, IsIrreducible (C i)) ∧ (⋃ i, C i) = Set.univ ∧ ∀ i j, ((C i ∩ C j).Nonempty ↔ P i j) :=
by
  intro K _ _ S X fS _ _ g _
  classical

  have s1 : ∀ (A B : Type u) [TopologicalSpace A] [TopologicalSpace B]
      [TopologicalSpace.NoetherianSpace A] [QuasiSober A] [T0Space B] (f : A → B), Continuous f →
      ∀ (η : B), closure ({η} : Set B) = Set.univ → ∀ (C Z : Set A), IsClosed C → IsClosed Z →
      (∀ x ∈ C, f x = η → x ∈ Z) → ∃ V : Set B, IsOpen V ∧ η ∈ V ∧ ∀ x ∈ C, f x ∈ V → x ∈ Z := by
    intro A B _ _ _ _ _ f hf η hη C Z hC hZ hCZ
    refine ⟨(closure (f '' (C ∩ Zᶜ)))ᶜ, isClosed_closure.isOpen_compl, ?_, ?_⟩
    · intro hηmem
      obtain ⟨Sf, hSirr, hSeq⟩ := TopologicalSpace.NoetherianSpace.exists_finset_irreducible
        (⟨closure (C ∩ Zᶜ), isClosed_closure⟩ : TopologicalSpace.Closeds A)
      have hsub : f '' (C ∩ Zᶜ) ⊆
          ⋃ k : Sf, f '' (((k : TopologicalSpace.Closeds A) : Set A) ∩ (C ∩ Zᶜ)) := by
        rintro _ ⟨x, hx, rfl⟩
        have hx' : x ∈ ((Sf.sup id : TopologicalSpace.Closeds A) : Set A) := by
          rw [← hSeq]; exact subset_closure hx
        rw [TopologicalSpace.Closeds.coe_finset_sup, Finset.sup_eq_iSup] at hx'
        simp only [Set.iSup_eq_iUnion, Set.mem_iUnion, Function.comp_apply, id] at hx'
        obtain ⟨k, hkS, hxk⟩ := hx'
        exact Set.mem_iUnion.mpr ⟨⟨k, hkS⟩, x, ⟨hxk, hx⟩, rfl⟩
      have hηm : η ∈ ⋃ k : Sf,
          closure (f '' (((k : TopologicalSpace.Closeds A) : Set A) ∩ (C ∩ Zᶜ))) := by
        rw [← closure_iUnion_of_finite]
        exact closure_mono hsub hηmem
      obtain ⟨k, hk⟩ := Set.mem_iUnion.mp hηm
      have hne : (((k : TopologicalSpace.Closeds A) : Set A) ∩ (C ∩ Zᶜ)).Nonempty := by
        by_contra h
        rw [Set.not_nonempty_iff_eq_empty] at h
        rw [h, Set.image_empty, closure_empty] at hk
        exact hk
      have hirr : IsIrreducible ((k : TopologicalSpace.Closeds A) : Set A) := hSirr k
      have hgen := hirr.isGenericPoint_genericPoint_closure
      rw [(k : TopologicalSpace.Closeds A).isClosed.closure_eq] at hgen
      have h1 : f '' (((k : TopologicalSpace.Closeds A) : Set A) ∩ (C ∩ Zᶜ)) ⊆
          closure {f hirr.genericPoint} := by
        rintro _ ⟨x, hx, rfl⟩
        exact specializes_iff_mem_closure.mp ((hgen.specializes hx.1).map hf)
      have h2 : f hirr.genericPoint ⤳ η :=
        specializes_iff_mem_closure.mpr (closure_minimal h1 isClosed_closure hk)
      have h3 : η ⤳ f hirr.genericPoint :=
        specializes_iff_mem_closure.mpr (by rw [hη]; trivial)
      have hfeq : f hirr.genericPoint = η := (h2.antisymm h3).eq
      have hξk : hirr.genericPoint ∈ ((k : TopologicalSpace.Closeds A) : Set A) := hgen.mem
      have hξC : hirr.genericPoint ∈ C := by
        have hle : (k : TopologicalSpace.Closeds A) ≤ Sf.sup id := Finset.le_sup (f := id) k.2
        rw [← hSeq] at hle
        exact (closure_minimal Set.inter_subset_left hC) (SetLike.coe_subset_coe.mpr hle hξk)
      have hξZ : hirr.genericPoint ∉ Z :=
        (hgen.mem_open_set_iff hZ.isOpen_compl).mpr (hne.mono (fun x hx => ⟨hx.1, hx.2.2⟩))
      exact hξZ (hCZ _ hξC hfeq)
    · intro x hxC hxV
      by_contra hxZ
      exact hxV (subset_closure ⟨x, ⟨hxC, hxZ⟩, rfl⟩)

  haveI : IsLocallyNoetherian S := LocallyOfFiniteType.isLocallyNoetherian fS

  obtain ⟨L, _, _, hLfin, n, Z₀, hZ₀cl, hZ₀cov, hZ₀irr⟩ :=
    wc_finite_ext_geom_irred_cover (S.residueField (genericPoint S))
      (Limits.pullback g (S.fromSpecResidueField (genericPoint S)))
      (Limits.pullback.snd g (S.fromSpecResidueField (genericPoint S)))

  obtain ⟨U, Y', ι, q₀, hι, hηι, hq₀f, hq₀s, hY'i, hY'n, _, huniq, e, he, hcompat⟩ :=
    wc_spread_finite_ext_generic S L
  haveI := hι
  haveI := hq₀f
  haveI := hq₀s
  haveI := hY'n

  obtain ⟨Z, hZcl, hZcov, hZirr⟩ := wc_transport_generic_cover S X Y' g (q₀ ≫ ι)
    (genericPoint S) (genericPoint Y') L e he hcompat n Z₀ hZ₀cl hZ₀cov hZ₀irr

  haveI : IsLocallyNoetherian (Limits.pullback g (q₀ ≫ ι)) :=
    LocallyOfFiniteType.isLocallyNoetherian (Limits.pullback.snd g (q₀ ≫ ι))
  haveI : CompactSpace ↥(Limits.pullback g (q₀ ≫ ι)) :=
    QuasiCompact.compactSpace_of_compactSpace (Limits.pullback.snd g (q₀ ≫ ι))
  haveI : AlgebraicGeometry.IsNoetherian (Limits.pullback g (q₀ ≫ ι)) :=
    AlgebraicGeometry.IsNoetherian.mk
  have hη'gen : closure ({genericPoint Y'} : Set Y') = Set.univ :=
    isGenericPoint_def.mp (genericPoint_spec Y')

  have hV : ∀ i, ∃ V : Set Y', IsOpen V ∧ genericPoint Y' ∈ V ∧
      ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (t : Spec (.of Ω) ⟶ Y'),
        t (IsLocalRing.closedPoint Ω) ∈ V →
        IsIrreducible ((Limits.pullback.fst (Limits.pullback.snd g (q₀ ≫ ι)) t) ⁻¹' Z i) :=
    fun i => wc_spread_geom_irreducible_closed _ Y' (Limits.pullback.snd g (q₀ ≫ ι)) (Z i)
      (hZcl i) (fun Ω _ _ t ht => hZirr i Ω t ht)
  choose Vi hVio hVimem hVi using hV

  obtain ⟨Vc, hVco, hVcmem, hVc⟩ := s1 _ _ (⇑(Limits.pullback.snd g (q₀ ≫ ι)))
    (Limits.pullback.snd g (q₀ ≫ ι)).continuous (genericPoint Y') hη'gen Set.univ (⋃ i, Z i)
    isClosed_univ (isClosed_iUnion_of_finite hZcl)
    (fun x _ hx => Set.mem_iUnion.mpr (hZcov x hx))

  obtain ⟨P, hPdef⟩ : ∃ P : Fin n → Fin n → Prop, ∀ i j, P i j ↔
      ∃ x ∈ Z i ∩ Z j, Limits.pullback.snd g (q₀ ≫ ι) x = genericPoint Y' :=
    ⟨_, fun _ _ => Iff.rfl⟩
  have hVij : ∀ i j, ∃ V : Set Y', IsOpen V ∧ genericPoint Y' ∈ V ∧
      (¬ P i j → ∀ x ∈ Z i ∩ Z j, Limits.pullback.snd g (q₀ ≫ ι) x ∈ V → False) := by
    intro i j
    by_cases hP : P i j
    · exact ⟨Set.univ, isOpen_univ, Set.mem_univ _, fun h => absurd hP h⟩
    · obtain ⟨V, hVo, hVm, hV⟩ := s1 _ _ (⇑(Limits.pullback.snd g (q₀ ≫ ι)))
        (Limits.pullback.snd g (q₀ ≫ ι)).continuous (genericPoint Y') hη'gen (Z i ∩ Z j) ∅
        ((hZcl i).inter (hZcl j)) isClosed_empty
        (fun x hx hfx => absurd ((hPdef i j).mpr ⟨x, hx, hfx⟩) hP)
      exact ⟨V, hVo, hVm, fun _ x hx hxV => hV x hx hxV⟩
  choose Vij hVijo hVijm hVij using hVij

  set V : Set Y' := Vc ∩ (⋂ i, Vi i) ∩ (⋂ i, ⋂ j, Vij i j) with hVdef
  have hVo : IsOpen V := (hVco.inter (isOpen_iInter_of_finite hVio)).inter
    (isOpen_iInter_of_finite fun i => isOpen_iInter_of_finite (hVijo i))
  have hVm : genericPoint Y' ∈ V := ⟨⟨hVcmem, Set.mem_iInter.mpr hVimem⟩,
    Set.mem_iInter.mpr fun i => Set.mem_iInter.mpr (hVijm i)⟩

  have hBcl : IsClosed (q₀ '' Vᶜ) := q₀.isClosedMap _ hVo.isClosed_compl
  refine ⟨ι '' (q₀ '' Vᶜ)ᶜ, ι.isOpenEmbedding.isOpenMap _ hBcl.isOpen_compl, ?_, n, P, ?_⟩
  · obtain ⟨u₀, hu₀⟩ := hηι
    refine ⟨u₀, ?_, hu₀⟩
    rintro ⟨y', hy'V, rfl⟩
    apply hy'V
    rw [huniq y' hu₀]
    exact hVm
  rintro _ ⟨u, huB, rfl⟩
  have hrange : Set.range (wcEtGeomPt S (ι u)) ⊆ Set.range ι := by
    rintro _ ⟨s, rfl⟩
    exact ⟨u, by rw [wcEtGeomPt, Scheme.Hom.comp_apply, Scheme.fromSpecResidueField_apply]⟩
  have hfac : IsOpenImmersion.lift ι (wcEtGeomPt S (ι u)) hrange ≫ ι = wcEtGeomPt S (ι u) :=
    IsOpenImmersion.lift_fac _ _ _
  set pt : ↥(Spec (.of (AlgebraicClosure (S.residueField (ι u))))) :=
    IsLocalRing.closedPoint (AlgebraicClosure (S.residueField (ι u))) with hpt
  have hyUpt : IsOpenImmersion.lift ι (wcEtGeomPt S (ι u)) hrange pt = u := by
    apply ι.isOpenEmbedding.isEmbedding.injective
    have e1 := Scheme.Hom.comp_apply (IsOpenImmersion.lift ι (wcEtGeomPt S (ι u)) hrange) ι pt
    rw [hfac] at e1
    rw [← e1, wcEtGeomPt, Scheme.Hom.comp_apply, Scheme.fromSpecResidueField_apply]
  obtain ⟨z, hz⟩ := q₀.surjective u
  have hzV : z ∈ V := by
    by_contra hzV
    exact huB ⟨z, hzV, hz⟩
  obtain ⟨zb, hzb, hzbpt⟩ := wc_finite_geom_point_lift _ q₀
    (IsOpenImmersion.lift ι (wcEtGeomPt S (ι u)) hrange) z (by rw [hz]; exact hyUpt.symm)
  have hzbg : zb ≫ q₀ ≫ ι = wcEtGeomPt S (ι u) := by
    rw [← Category.assoc, hzb, hfac]
  have hpV : zb pt ∈ V := by
    rw [hpt, hzbpt]; exact hzV
  have hpVc : zb pt ∈ Vc := hpV.1.1
  have hpVi : ∀ i, zb pt ∈ Vi i := fun i => Set.mem_iInter.mp hpV.1.2 i
  have hpVij : ∀ i j, zb pt ∈ Vij i j := fun i j =>
    Set.mem_iInter.mp (Set.mem_iInter.mp hpV.2 i) j

  let h := Scheme.homeoOfIso (Limits.pullbackLeftPullbackSndIso g (q₀ ≫ ι) zb ≪≫
    Limits.pullback.congrHom rfl hzbg)
  have hover : ∀ w : ↥(Limits.pullback (Limits.pullback.snd g (q₀ ≫ ι)) zb),
      Limits.pullback.snd g (q₀ ≫ ι) (Limits.pullback.fst (Limits.pullback.snd g (q₀ ≫ ι)) zb w)
        = zb pt := by
    intro w
    rw [← Scheme.Hom.comp_apply, Limits.pullback.condition, Scheme.Hom.comp_apply]
    congr 1
    exact Subsingleton.elim _ _
  refine ⟨fun i => h '' ((Limits.pullback.fst (Limits.pullback.snd g (q₀ ≫ ι)) zb) ⁻¹' Z i),
    fun i => h.isClosedMap _ ((hZcl i).preimage (Scheme.Hom.continuous _)),
    fun i => (hVi i _ zb (hpVi i)).image h h.continuous.continuousOn, ?_, ?_⟩
  · apply Set.eq_univ_of_forall
    intro v
    obtain ⟨i, hi⟩ := Set.mem_iUnion.mp
      (hVc (Limits.pullback.fst (Limits.pullback.snd g (q₀ ≫ ι)) zb (h.symm v)) (Set.mem_univ _)
        (by rw [hover]; exact hpVc))
    exact Set.mem_iUnion.mpr ⟨i, h.symm v, hi, h.apply_symm_apply v⟩
  · intro i j
    rw [← Set.image_inter h.injective, Set.image_nonempty]
    constructor
    · rintro ⟨w, hwi, hwj⟩
      by_contra hP
      exact hVij i j hP _ ⟨hwi, hwj⟩ (by rw [hover]; exact hpVij i j)
    · intro hP
      obtain ⟨x₀, hx₀, hx₀η⟩ := (hPdef i j).mp hP
      have hcl : IsClosed (Limits.pullback.snd g (q₀ ≫ ι) '' (Z i ∩ Z j)) :=
        (Limits.pullback.snd g (q₀ ≫ ι)).isClosedMap _ ((hZcl i).inter (hZcl j))
      have hall : closure ({genericPoint Y'} : Set Y') ⊆
          Limits.pullback.snd g (q₀ ≫ ι) '' (Z i ∩ Z j) :=
        closure_minimal (Set.singleton_subset_iff.mpr ⟨x₀, hx₀, hx₀η⟩) hcl
      rw [hη'gen] at hall
      obtain ⟨x, hx, hxp⟩ := hall (Set.mem_univ (zb pt))
      obtain ⟨w, hw, -⟩ := Scheme.Pullback.exists_preimage_pullback
        (f := Limits.pullback.snd g (q₀ ≫ ι)) (g := zb) x pt hxp
      exact ⟨w, by rw [Set.mem_preimage, hw]; exact hx.1, by rw [Set.mem_preimage, hw]; exact hx.2⟩

theorem wc_et_fibre_h0_card_generic_const : ∀ (K : Type u) [Field K] [IsAlgClosed K] (S X : Scheme.{u}) (fS : S ⟶ Spec (.of K)) [IsProper fS] [IsIntegral S] (g : X ⟶ S) [IsProper g] (ℓ : ℕ), ℓ.Prime → (ℓ : K) ≠ 0 → (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (t : Spec (.of Ω) ⟶ S), topologicalKrullDim ↥(Limits.pullback g t) ≤ ((1 : ℕ) : WithBot ℕ∞)) → (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (C : Scheme.{u}) (fC : C ⟶ Spec (.of Ω)) [IsProper fC], (ℓ : Ω) ≠ 0 → topologicalKrullDim C ≤ ((1 : ℕ) : WithBot ℕ∞) → ∀ q : ℕ, Finite (wcEtCoh C ℓ q)) → (∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (Y₀ : Scheme.{u}) (f : Y₀ ⟶ Spec (.of A)) [IsProper f] (m' : ℕ), m' ≠ 0 → ∀ S : Set (Spec (.of A)), IsOpen S → S ≠ Set.univ → ∀ q' : ℕ, Subsingleton (wcEtExt Y₀ (wcEtExtZero Y₀ (f ⁻¹' S) m') q')) → ∃ W : Set S, IsOpen W ∧ genericPoint S ∈ W ∧ ∀ y ∈ W, Nat.card (wcEtCoh (Limits.pullback g (wcEtGeomPt S y)) ℓ 0) = Nat.card (wcEtCoh (Limits.pullback g (wcEtGeomPt S (genericPoint S))) ℓ 0) :=
by
  intro K _ _ S X fS _ _ g _ ℓ hℓ hℓK hdim hcurve hPBC
  classical

  have hA : ∀ (Y : Scheme.{u}), Nonempty (wcEtCoh Y ℓ 0 ≃ LocallyConstant Y (ZMod ℓ)) := by
    intro Y
    let T₀ : Y.Etale := Scheme.Etale.mk (𝟙 Y)
    have hT : Limits.IsTerminal T₀ :=
      Limits.IsTerminal.ofUniqueHom (fun V => MorphismProperty.Over.homMk V.hom)
        (fun V m => MorphismProperty.Over.Hom.ext
          ((Category.comp_id m.left).symm.trans (MorphismProperty.Over.w m)))
    obtain ⟨ε, -, -⟩ := wc_et_const_hom_sections_equiv Y T₀ hT
    obtain ⟨e, -⟩ := wc_et_const_zmod_sections_locallyConstant Y ℓ
      (fun V S hS x hx => wc_et_locallyConstant_glue Y V S hS ℓ x hx)
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
    let E₁ : wcEtCoh Y ℓ 0 ≃ ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ)) ⟶
        (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))) :=
      (Abelian.Ext.addEquiv₀).toEquiv
    exact ⟨E₁.trans ((ε _).trans (e T₀).toEquiv)⟩

  have hB : ∀ (T : Type u) [TopologicalSpace T] (n : ℕ) (P : Fin n → Fin n → Prop)
      (C : Fin n → Set T), (∀ i, IsClosed (C i)) → (∀ i, _root_.IsPreconnected (C i)) →
      (∀ i, (C i).Nonempty) → (⋃ i, C i) = Set.univ → (∀ i j, ((C i ∩ C j).Nonempty ↔ P i j)) →
      Nonempty (LocallyConstant T (ZMod ℓ) ≃ (Quot P → ZMod ℓ)) := by
    intro T _ n P C hcl hpc hne hcov hpat
    choose pt hpt using hne
    have hcov' : ∀ x : T, ∃ i, x ∈ C i := by
      intro x
      have hx : x ∈ (⋃ i, C i) := by rw [hcov]; exact Set.mem_univ x
      exact Set.mem_iUnion.mp hx
    choose idx hidx using hcov'
    have hK : ∀ (f : LocallyConstant T (ZMod ℓ)) (i : Fin n) (x z : T), x ∈ C i → z ∈ C i →
        f x = f z := fun f i x z hx hz =>
      LocallyConstant.apply_eq_of_isPreconnected f (hpc i) hx hz
    have hind : ∀ (x : T) (i : Fin n), x ∈ C i → Quot.mk P (idx x) = Quot.mk P i := by
      intro x i hx
      exact Quot.sound ((hpat (idx x) i).mp ⟨x, hidx x, hx⟩)
    let Φ : LocallyConstant T (ZMod ℓ) → (Quot P → ZMod ℓ) := fun f =>
      Quot.lift (fun i => f (pt i)) (fun i j hij => by
        obtain ⟨x, hxi, hxj⟩ := (hpat i j).mpr hij
        exact (hK f i (pt i) x (hpt i) hxi).trans (hK f j x (pt j) hxj (hpt j)))
    have hΨlc : ∀ φ : Quot P → ZMod ℓ, IsLocallyConstant (fun x : T => φ (Quot.mk P (idx x))) := by
      intro φ
      rw [IsLocallyConstant.iff_isOpen_fiber]
      intro v
      have hfib : (fun x : T => φ (Quot.mk P (idx x))) ⁻¹' {v} =
          (⋃ i ∈ {i : Fin n | φ (Quot.mk P i) ≠ v}, C i)ᶜ := by
        ext x
        simp only [Set.mem_preimage, Set.mem_singleton_iff, Set.mem_compl_iff, Set.mem_iUnion,
          Set.mem_setOf_eq, not_exists, not_and]
        constructor
        · intro hx i hi hxi
          apply hi
          rw [← hind x i hxi]
          exact hx
        · intro h
          by_contra hne'
          exact h (idx x) hne' (hidx x)
      rw [hfib, isOpen_compl_iff]
      exact Set.Finite.isClosed_biUnion (Set.toFinite _) (fun i _ => hcl i)
    let Ψ : (Quot P → ZMod ℓ) → LocallyConstant T (ZMod ℓ) := fun φ =>
      ⟨fun x => φ (Quot.mk P (idx x)), hΨlc φ⟩
    refine ⟨⟨Φ, Ψ, ?_, ?_⟩⟩
    · intro f
      apply LocallyConstant.ext
      intro x
      exact hK f (idx x) (pt (idx x)) x (hpt (idx x)) (hidx x)
    · intro φ
      funext q
      induction q using Quot.ind with
      | mk i =>
        change φ (Quot.mk P (idx (pt i))) = φ (Quot.mk P i)
        rw [hind (pt i) i (hpt i)]

  obtain ⟨W, hWo, hηW, n, P, hP⟩ := wc_fibre_closed_cover_pattern_generic K S X fS g
  have key : ∀ y ∈ W, Nat.card (wcEtCoh (Limits.pullback g (wcEtGeomPt S y)) ℓ 0) =
      Nat.card (Quot P → ZMod ℓ) := by
    intro y hy
    obtain ⟨C, hcl, hirr, hcov, hpat⟩ := hP y hy
    obtain ⟨e₁⟩ := hA (Limits.pullback g (wcEtGeomPt S y))
    obtain ⟨e₂⟩ := hB _ n P C hcl (fun i => (hirr i).isPreirreducible.isPreconnected)
      (fun i => (hirr i).nonempty) hcov hpat
    exact Nat.card_congr (e₁.trans e₂)
  refine ⟨W, hWo, hηW, fun y hy => ?_⟩
  rw [key y hy, key (genericPoint S) hηW]

theorem wc_curve_ord_units_full : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω)) [IsProper fX] [IrreducibleSpace X],
    (∀ x : X, IsDomain (X.presheaf.stalk x) ∧ IsIntegrallyClosed (X.presheaf.stalk x)) →
    topologicalKrullDim X = ((1 : ℕ) : WithBot ℕ∞) →
    ∀ (U : X.Opens) [IsDedekindDomain Γ(X, U)] (hU : IsAffineOpen U), ((U : Set X)ᶜ).Finite →
    ∃ (ord : X → Additive (FractionRing Γ(X, U))ˣ →+ ℤ)
      (ι : ∀ V : X.Opens, Additive (Γ(X, V))ˣ →+ Additive (FractionRing Γ(X, U))ˣ),
      wcCurveOrdData Ω X fX U hU ord ∧
      (∀ (V W : X.Opens) (hWV : W ≤ V), (W : Set X).Nonempty → ∀ g : (Γ(X, V))ˣ,
        ι W (Additive.ofMul (Units.map (X.presheaf.map (homOfLE hWV).op).hom.toMonoidHom g)) =
          ι V (Additive.ofMul g)) ∧
      (∀ V : X.Opens, (V : Set X).Nonempty → Function.Injective (ι V)) ∧
      (∀ V : X.Opens, (V : Set X).Nonempty →
        ∀ m, (∃ g, ι V g = m) ↔ ∀ x ∈ V, ord x m = 0) :=
by
  intro Ω _ _ X fX _ _ hnorm hdim U _ hU hfin
  classical

  haveI : ∀ x : X, _root_.IsReduced (X.presheaf.stalk x) := fun x => by
    haveI := (hnorm x).1
    infer_instance
  haveI : AlgebraicGeometry.IsReduced X := isReduced_of_isReduced_stalk X
  haveI : AlgebraicGeometry.IsIntegral X := isIntegral_of_irreducibleSpace_of_isReduced X
  have hclosed : ∀ y : X, y ≠ genericPoint X → IsClosed ({y} : Set X) := fun y hy =>
    (wc_curve_points_closed_opens_compact Ω X fX hdim).1 {y} (Set.finite_singleton y)
      (fun h => hy (Set.mem_singleton_iff.mp h).symm)
  have hDVR : ∀ x : X, x ≠ genericPoint X → IsDiscreteValuationRing (X.presheaf.stalk x) :=
    wc_curve_stalk_dvr Ω X fX (fun x => (hnorm x).2) hclosed
  have hP5 := wc_dedekind_affine_points X U hU
  haveI : Nonempty U := ⟨⟨genericPoint X, hP5.1⟩⟩
  obtain ⟨x₀⟩ : Nonempty X := IrreducibleSpace.toNonempty
  haveI : Nonempty (⊤ : X.Opens) := ⟨⟨x₀, trivial⟩⟩
  letI : IsFractionRing Γ(X, U) X.functionField :=
    functionField_isFractionRing_of_isAffineOpen X U hU
  let α := FractionRing.algEquiv Γ(X, U) X.functionField
  let E : Additive (FractionRing Γ(X, U))ˣ ≃+ Additive (X.functionField)ˣ :=
    MulEquiv.toAdditive (Units.mapEquiv α.toMulEquiv)

  have pkg : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
      (K : Type u) [Field K] [Algebra R K] [IsFractionRing R K]
      (w : IsDedekindDomain.HeightOneSpectrum R), ∃ o : Additive Kˣ →+ ℤ,
      (∀ f : Kˣ, o (Additive.ofMul f) =
        FractionalIdeal.count K w (FractionalIdeal.spanSingleton (nonZeroDivisors R) (f : K))) ∧
      (∃ f : Kˣ, o (Additive.ofMul f) = 1) ∧
      (∀ f : Kˣ, 0 ≤ o (Additive.ofMul f) ↔ ∃ r : R, algebraMap R K r = (f : K)) ∧
      (∀ f : Kˣ, o (Additive.ofMul f) = 0 ↔
        (∃ r : R, algebraMap R K r = (f : K)) ∧ ∃ r : R, algebraMap R K r = ((f⁻¹ : Kˣ) : K)) ∧
      (∀ f g h : Kˣ, (h : K) = (f : K) + (g : K) →
        min (o (Additive.ofMul f)) (o (Additive.ofMul g)) ≤ o (Additive.ofMul h)) := by
    intro R _ _ _ K _ _ _ w
    have hc_mul : ∀ f g : Kˣ,
        FractionalIdeal.count K w (FractionalIdeal.spanSingleton (nonZeroDivisors R)
          ((Additive.toMul (Additive.ofMul f + Additive.ofMul g) : Kˣ) : K)) =
        FractionalIdeal.count K w (FractionalIdeal.spanSingleton (nonZeroDivisors R) (f : K)) +
        FractionalIdeal.count K w (FractionalIdeal.spanSingleton (nonZeroDivisors R) (g : K)) := by
      intro f g
      rw [toMul_add, toMul_ofMul, toMul_ofMul, Units.val_mul,
        ← FractionalIdeal.spanSingleton_mul_spanSingleton]
      exact FractionalIdeal.count_mul K w
        (FractionalIdeal.spanSingleton_ne_zero_iff.mpr f.ne_zero)
        (FractionalIdeal.spanSingleton_ne_zero_iff.mpr g.ne_zero)
    let o : Additive Kˣ →+ ℤ := AddMonoidHom.mk' (fun m => FractionalIdeal.count K w
      (FractionalIdeal.spanSingleton (nonZeroDivisors R) ((Additive.toMul m : Kˣ) : K)))
      (fun a b => hc_mul (Additive.toMul a) (Additive.toMul b))
    have ho : ∀ f : Kˣ, o (Additive.ofMul f) =
        FractionalIdeal.count K w (FractionalIdeal.spanSingleton (nonZeroDivisors R) (f : K)) :=
      fun f => rfl
    have hint : ∀ f : Kˣ, 0 ≤ o (Additive.ofMul f) ↔ ∃ r : R, algebraMap R K r = (f : K) := by
      intro f
      rw [ho]
      exact (dvr_count_spanSingleton R K w (f : K) f.ne_zero).1.symm
    have hmul : ∀ f g : Kˣ,
        o (Additive.ofMul (f * g)) = o (Additive.ofMul f) + o (Additive.ofMul g) := by
      intro f g
      rw [ofMul_mul, map_add]
    have hinv : ∀ f : Kˣ, o (Additive.ofMul f⁻¹) = - o (Additive.ofMul f) := by
      intro f
      rw [ofMul_inv, map_neg]
    have key : ∀ f g h : Kˣ, (h : K) = (f : K) + (g : K) →
        o (Additive.ofMul f) ≤ o (Additive.ofMul g) →
        o (Additive.ofMul f) ≤ o (Additive.ofMul h) := by
      intro f g h hh hle
      have h1 : 0 ≤ o (Additive.ofMul (g * f⁻¹)) := by
        rw [hmul, hinv]; omega
      obtain ⟨r, hr⟩ := (hint _).mp h1
      have h2 : ∃ r : R, algebraMap R K r = ((h * f⁻¹ : Kˣ) : K) := by
        refine ⟨1 + r, ?_⟩
        rw [map_add, map_one, hr]
        simp only [Units.val_mul, hh, add_mul, Units.mul_inv]
      have h3 := (hint _).mpr h2
      rw [hmul, hinv] at h3
      omega
    refine ⟨o, ho, ?_, hint, ?_, ?_⟩
    · obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible R
      have h0 : algebraMap R K ϖ ≠ 0 := by
        intro h
        apply hϖ.ne_zero
        apply IsFractionRing.injective R K
        rw [h, map_zero]
      exact ⟨Units.mk0 _ h0, (dvr_count_spanSingleton R K w _ h0).2 ϖ hϖ⟩
    · intro f
      have h1 := hint f
      have h2 := hint f⁻¹
      have h3 := hinv f
      rw [← h1, ← h2, h3]
      constructor
      · intro h
        exact ⟨by omega, by omega⟩
      · rintro ⟨ha, hb⟩
        omega
    · intro f g h hh
      rcases le_total (o (Additive.ofMul f)) (o (Additive.ofMul g)) with hle | hle
      · exact (min_le_left _ _).trans (key f g h hh hle)
      · exact (min_le_right _ _).trans (key g f h (by rw [hh, add_comm]) hle)

  haveI hdom : IsDomain Γ(X, ⊤) :=
    @IsIntegral.component_integral X _ ⊤ ⟨⟨x₀, trivial⟩⟩
  let φ : Ω →+* Γ(X, ⊤) := fX.appTop.hom.comp (Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom
  have hφint : φ.IsIntegral := by
    refine RingHom.IsIntegral.trans _ _ (RingHom.isIntegral_of_surjective _ ?_)
      (isIntegral_appTop_of_universallyClosed fX)
    intro y
    refine ⟨(Scheme.ΓSpecIso (CommRingCat.of Ω)).hom.hom y, ?_⟩
    change ((Scheme.ΓSpecIso (CommRingCat.of Ω)).hom ≫
      (Scheme.ΓSpecIso (CommRingCat.of Ω)).inv).hom y = y
    rw [Iso.hom_inv_id]
    rfl
  have hsurj : Function.Surjective φ := by
    letI : Algebra Ω Γ(X, ⊤) := φ.toAlgebra
    intro s
    have hs : _root_.IsIntegral Ω s := hφint s
    have hdeg := IsAlgClosed.degree_eq_one_of_irreducible Ω (minpoly.irreducible hs)
    obtain ⟨c, hc⟩ := minpoly.mem_range_of_degree_eq_one Ω s hdeg
    exact ⟨c, hc⟩

  have s3 : ∀ (v : IsDedekindDomain.HeightOneSpectrum Γ(X, U))
      [IsDedekindDomain (X.presheaf.stalk (hU.fromSpec ⟨v.asIdeal, v.isPrime⟩))]
      (w : IsDedekindDomain.HeightOneSpectrum
        (X.presheaf.stalk (hU.fromSpec ⟨v.asIdeal, v.isPrime⟩)))
      (f : FractionRing Γ(X, U)), f ≠ 0 →
      FractionalIdeal.count X.functionField w
          (FractionalIdeal.spanSingleton
            (nonZeroDivisors (X.presheaf.stalk (hU.fromSpec ⟨v.asIdeal, v.isPrime⟩)))
            (FractionRing.algEquiv Γ(X, U) X.functionField f)) =
        FractionalIdeal.count (FractionRing Γ(X, U)) v
          (FractionalIdeal.spanSingleton (nonZeroDivisors Γ(X, U)) f) := by
    intro v _ w f hf
    have hxU : (hU.fromSpec ⟨v.asIdeal, v.isPrime⟩ : X) ∈ U := (hP5.2.2.1 v).1
    let xU : U := ⟨_, hxU⟩
    have hp : hU.primeIdealOf xU = ⟨v.asIdeal, v.isPrime⟩ := by
      apply hU.fromSpec.injective
      rw [hU.fromSpec_primeIdealOf xU]
    letI : Algebra Γ(X, U) (X.presheaf.stalk (xU : X)) :=
      TopCat.Presheaf.algebra_section_stalk X.presheaf xU
    haveI : IsLocalization.AtPrime (X.presheaf.stalk (xU : X)) v.asIdeal := by
      have := hU.isLocalization_stalk xU
      rw [hp] at this
      exact this
    haveI : IsScalarTower Γ(X, U) (X.presheaf.stalk (xU : X)) X.functionField :=
      functionField_isScalarTower X U xU
    exact dedekind_count_localization Γ(X, U) v (X.presheaf.stalk (xU : X)) X.functionField w f hf

  have K0 : ∀ (V : X.Opens) [Nonempty V] (x : X) (hx : x ∈ V) (s : Γ(X, V)),
      algebraMap (X.presheaf.stalk x) X.functionField ((X.presheaf.germ V x hx).hom s) =
        (X.germToFunctionField V).hom s := by
    intro V _ x hx s
    exact TopCat.Presheaf.germ_stalkSpecializes_apply X.presheaf hx _ s
  have s2 : ∀ (V : X.Opens) [Nonempty V] (f : (X.functionField)ˣ),
      (∃ g : (Γ(X, V))ˣ, (X.germToFunctionField V).hom (g : Γ(X, V)) = (f : X.functionField)) ↔
      ∀ x : V, (x : X) ≠ genericPoint X →
        (∃ t : X.presheaf.stalk (x : X),
          algebraMap (X.presheaf.stalk (x : X)) X.functionField t = (f : X.functionField)) ∧
        ∃ t : X.presheaf.stalk (x : X),
          algebraMap (X.presheaf.stalk (x : X)) X.functionField t =
            ((f⁻¹ : (X.functionField)ˣ) : X.functionField) := by
    intro V _ f
    constructor
    · rintro ⟨g, hg⟩ x _
      refine ⟨⟨(X.presheaf.germ V x x.2).hom (g : Γ(X, V)), ?_⟩,
        ⟨(X.presheaf.germ V x x.2).hom ((g⁻¹ : (Γ(X, V))ˣ) : Γ(X, V)), ?_⟩⟩
      · rw [K0, hg]
      · rw [K0, map_units_inv, hg, Units.val_inv_eq_inv_val]
    · intro H
      have hall : ∀ ℓ : X.functionField, (∀ x : V, (x : X) ≠ genericPoint X →
          ∃ t : X.presheaf.stalk (x : X),
            algebraMap (X.presheaf.stalk (x : X)) X.functionField t = ℓ) →
          ∃ s : Γ(X, V), (X.germToFunctionField V).hom s = ℓ := by
        intro ℓ hℓ
        apply wc_integral_hartogs_sections X V ℓ
        intro x
        by_cases hx : (x : X) = genericPoint X
        · obtain ⟨x, hxV⟩ := x
          simp only at hx
          subst hx
          refine ⟨ℓ, ?_⟩
          show (X.presheaf.stalkSpecializes _).hom ℓ = ℓ
          rw [TopCat.Presheaf.stalkSpecializes_refl]
          rfl
        · exact hℓ x hx
      obtain ⟨s, hs⟩ := hall f (fun x hx => (H x hx).1)
      obtain ⟨s', hs'⟩ := hall ((f⁻¹ : (X.functionField)ˣ) : X.functionField)
        (fun x hx => (H x hx).2)
      have h1 : s * s' = 1 := by
        apply Scheme.germToFunctionField_injective X V
        rw [map_mul, map_one, hs, hs', Units.mul_inv]
      exact ⟨⟨s, s', h1, by rw [mul_comm]; exact h1⟩, hs⟩

  have hloc : ∀ x : X, (hx : x ≠ genericPoint X) → ∃ o : Additive (X.functionField)ˣ →+ ℤ,
      (∃ f : (X.functionField)ˣ, o (Additive.ofMul f) = 1) ∧
      (∀ f : (X.functionField)ˣ, 0 ≤ o (Additive.ofMul f) ↔
        ∃ r : X.presheaf.stalk x, algebraMap _ X.functionField r = (f : X.functionField)) ∧
      (∀ f : (X.functionField)ˣ, o (Additive.ofMul f) = 0 ↔
        (∃ r : X.presheaf.stalk x, algebraMap _ X.functionField r = (f : X.functionField)) ∧
        ∃ r : X.presheaf.stalk x,
          algebraMap _ X.functionField r = ((f⁻¹ : (X.functionField)ˣ) : X.functionField)) ∧
      (∀ f g h : (X.functionField)ˣ,
        (h : X.functionField) = (f : X.functionField) + (g : X.functionField) →
        min (o (Additive.ofMul f)) (o (Additive.ofMul g)) ≤ o (Additive.ofMul h)) ∧
      (haveI := hDVR x hx
       ∃ w : IsDedekindDomain.HeightOneSpectrum (X.presheaf.stalk x),
        ∀ f : (X.functionField)ˣ, o (Additive.ofMul f) =
          FractionalIdeal.count X.functionField w
            (FractionalIdeal.spanSingleton (nonZeroDivisors (X.presheaf.stalk x))
              (f : X.functionField))) := by
    intro x hx
    haveI := hDVR x hx
    let w : IsDedekindDomain.HeightOneSpectrum (X.presheaf.stalk x) :=
      ⟨IsLocalRing.maximalIdeal _, (IsLocalRing.maximalIdeal.isMaximal _).isPrime,
        IsDiscreteValuationRing.not_a_field _⟩
    obtain ⟨o, h1, h2, h3, h4, h5⟩ := pkg (X.presheaf.stalk x) X.functionField w
    exact ⟨o, h2, h3, h4, h5, w, h1⟩
  choose o ho using hloc
  let ord : X → Additive (FractionRing Γ(X, U))ˣ →+ ℤ := fun x =>
    if hx : x = genericPoint X then 0 else (o x hx).comp E.toAddMonoidHom
  let ι : ∀ V : X.Opens, Additive (Γ(X, V))ˣ →+ Additive (FractionRing Γ(X, U))ˣ := fun V =>
    if hV : (V : Set X).Nonempty then
      haveI : Nonempty V := ⟨⟨hV.some, hV.some_mem⟩⟩
      E.symm.toAddMonoidHom.comp
        (MonoidHom.toAdditive (Units.map (X.germToFunctionField V).hom.toMonoidHom))
    else 0
  have hord : ∀ x (hx : x ≠ genericPoint X) m, ord x m = o x hx (E m) := by
    intro x hx m
    show (if h : x = genericPoint X then 0 else (o x h).comp E.toAddMonoidHom) m = _
    rw [dif_neg hx]
    rfl
  have hι : ∀ (V : X.Opens) [Nonempty V] (g : (Γ(X, V))ˣ), ι V (Additive.ofMul g) =
      E.symm (Additive.ofMul (Units.map (X.germToFunctionField V).hom.toMonoidHom g)) := by
    intro V hne g
    obtain ⟨y⟩ := hne
    have hV : (V : Set X).Nonempty := ⟨y.1, y.2⟩
    show (if hV : (V : Set X).Nonempty then
      haveI : Nonempty V := ⟨⟨hV.some, hV.some_mem⟩⟩
      E.symm.toAddMonoidHom.comp
        (MonoidHom.toAdditive (Units.map (X.germToFunctionField V).hom.toMonoidHom))
      else 0) (Additive.ofMul g) = _
    rw [dif_pos hV]
    rfl
  have P1 : ∀ m, ord (genericPoint X) m = 0 := by
    intro m
    show (if h : genericPoint X = genericPoint X then 0
      else (o (genericPoint X) h).comp E.toAddMonoidHom) m = 0
    rw [dif_pos rfl]
    rfl
  have P7 : ∀ (v : IsDedekindDomain.HeightOneSpectrum Γ(X, U)) (f : (FractionRing Γ(X, U))ˣ),
      ord (hU.fromSpec ⟨v.asIdeal, v.isPrime⟩) (Additive.ofMul f) =
        FractionalIdeal.count (FractionRing Γ(X, U)) v
          (FractionalIdeal.spanSingleton (nonZeroDivisors Γ(X, U)) (f : FractionRing Γ(X, U))) := by
    intro v f
    have hx := (hP5.2.2.1 v).2
    rw [hord _ hx]
    haveI := hDVR _ hx
    obtain ⟨w, hw⟩ := (ho _ hx).2.2.2.2
    rw [show E (Additive.ofMul f) = Additive.ofMul (Additive.toMul (E (Additive.ofMul f))) from rfl,
      hw]
    exact s3 v w (f : FractionRing Γ(X, U)) f.ne_zero
  have P2 : ∀ m, {x | ord x m ≠ 0}.Finite := by
    intro m
    have hfin2 : {v : IsDedekindDomain.HeightOneSpectrum Γ(X, U) |
        ¬ FractionalIdeal.count (FractionRing Γ(X, U)) v
          (FractionalIdeal.spanSingleton (nonZeroDivisors Γ(X, U))
            ((Additive.toMul m : (FractionRing Γ(X, U))ˣ) : FractionRing Γ(X, U))) = 0}.Finite :=
      Filter.eventually_cofinite.mp (FractionalIdeal.finite_factors _)
    refine (hfin.union (hfin2.image (fun v => (hU.fromSpec ⟨v.asIdeal, v.isPrime⟩ : X)))).subset ?_
    intro x hx
    simp only [Set.mem_setOf_eq] at hx
    by_cases hxU : x ∈ U
    · right
      have hxη : x ≠ genericPoint X := by
        rintro rfl
        exact hx (P1 m)
      obtain ⟨v, rfl⟩ := hP5.2.2.2 x hxU hxη
      refine ⟨v, ?_, rfl⟩
      simp only [Set.mem_setOf_eq]
      rw [← P7 v (Additive.toMul m)]
      exact hx
    · left
      exact hxU
  have P3 : ∀ x, x ≠ genericPoint X → ∃ m, ord x m = 1 := by
    intro x hx
    obtain ⟨f, hf⟩ := (ho x hx).1
    refine ⟨E.symm (Additive.ofMul f), ?_⟩
    rw [hord x hx, AddEquiv.apply_symm_apply]
    exact hf
  have P5 : ∀ (x : X) (f g h : (FractionRing Γ(X, U))ˣ),
      (h : FractionRing Γ(X, U)) = (f : FractionRing Γ(X, U)) + (g : FractionRing Γ(X, U)) →
      min (ord x (Additive.ofMul f)) (ord x (Additive.ofMul g)) ≤ ord x (Additive.ofMul h) := by
    intro x f g h hh
    by_cases hx : x = genericPoint X
    · subst hx
      rw [P1, P1, P1]
      exact min_le_left 0 0
    · rw [hord x hx, hord x hx, hord x hx]
      have := (ho x hx).2.2.2.1 (Additive.toMul (E (Additive.ofMul f)))
        (Additive.toMul (E (Additive.ofMul g))) (Additive.toMul (E (Additive.ofMul h))) (by
          show α (h : FractionRing Γ(X, U)) = α (f : FractionRing Γ(X, U)) + α (g : FractionRing Γ(X, U))
          rw [hh, map_add])
      simpa only [ofMul_toMul] using this
  have T1 : ∀ s : Γ(X, ⊤), α (algebraMap Γ(X, U) (FractionRing Γ(X, U))
      ((X.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom s)) = (X.germToFunctionField ⊤).hom s := by
    intro s
    rw [AlgEquiv.commutes]
    exact TopCat.Presheaf.germ_res_apply X.presheaf (homOfLE le_top) (genericPoint X) _ s
  have T2 : ∀ (x : X) (s : Γ(X, ⊤)), algebraMap (X.presheaf.stalk x) X.functionField
      ((X.presheaf.germ ⊤ x trivial).hom s) = (X.germToFunctionField ⊤).hom s :=
    fun x s => TopCat.Presheaf.germ_stalkSpecializes_apply X.presheaf
      (show x ∈ (⊤ : X.Opens) from trivial) _ s
  have P6 : ∀ f : (FractionRing Γ(X, U))ˣ, (∀ x, 0 ≤ ord x (Additive.ofMul f)) ↔
      ∃ c : Ω, algebraMap Γ(X, U) (FractionRing Γ(X, U))
        ((X.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom (φ c)) =
        (f : FractionRing Γ(X, U)) := by
    intro f
    have hloc6 : ∀ x (hx : x ≠ genericPoint X), 0 ≤ ord x (Additive.ofMul f) ↔
        ∃ t : X.presheaf.stalk x, algebraMap _ X.functionField t = α (f : FractionRing Γ(X, U)) := by
      intro x hx
      rw [hord x hx]
      exact (ho x hx).2.1 (Additive.toMul (E (Additive.ofMul f)))
    constructor
    · intro H
      obtain ⟨s, hs⟩ := wc_integral_hartogs_sections X ⊤ (α (f : FractionRing Γ(X, U))) (by
        intro x
        by_cases hx : (x : X) = genericPoint X
        · obtain ⟨x, hxV⟩ := x
          simp only at hx
          subst hx
          refine ⟨α (f : FractionRing Γ(X, U)), ?_⟩
          show (X.presheaf.stalkSpecializes _).hom _ = _
          rw [TopCat.Presheaf.stalkSpecializes_refl]
          rfl
        · exact (hloc6 (x : X) hx).mp (H x))
      obtain ⟨c, rfl⟩ := hsurj s
      refine ⟨c, α.injective ?_⟩
      rw [T1]
      exact hs
    · rintro ⟨c, hc⟩ x
      by_cases hx : x = genericPoint X
      · subst hx
        exact (P1 _).ge
      · rw [hloc6 x hx]
        refine ⟨(X.presheaf.germ ⊤ x trivial).hom (φ c), ?_⟩
        rw [T2, ← hc, T1]
  have Q4 : ∀ (V W : X.Opens) (hWV : W ≤ V), (W : Set X).Nonempty → ∀ g : (Γ(X, V))ˣ,
      ι W (Additive.ofMul (Units.map (X.presheaf.map (homOfLE hWV).op).hom.toMonoidHom g)) =
        ι V (Additive.ofMul g) := by
    intro V W hWV hW g
    obtain ⟨y, hy⟩ := hW
    haveI : Nonempty W := ⟨⟨y, hy⟩⟩
    haveI : Nonempty V := ⟨⟨y, hWV hy⟩⟩
    rw [hι W, hι V]
    congr 2
    apply Units.ext
    show (X.germToFunctionField W).hom ((X.presheaf.map (homOfLE hWV).op).hom (g : Γ(X, V))) =
      (X.germToFunctionField V).hom (g : Γ(X, V))
    exact TopCat.Presheaf.germ_res_apply X.presheaf (homOfLE hWV) (genericPoint X) _
      (g : Γ(X, V))
  have Q5 : ∀ V : X.Opens, (V : Set X).Nonempty → Function.Injective (ι V) := by
    intro V hV a b hab
    obtain ⟨y, hy⟩ := hV
    haveI : Nonempty V := ⟨⟨y, hy⟩⟩
    have ha := hι V (Additive.toMul a)
    have hb := hι V (Additive.toMul b)
    rw [ofMul_toMul] at ha hb
    rw [ha, hb] at hab
    have h2 := E.symm.injective hab
    have h3 := Additive.ofMul.injective h2
    exact Additive.toMul.injective
      (Units.map_injective (Scheme.germToFunctionField_injective X V) h3)
  have Q6 : ∀ V : X.Opens, (V : Set X).Nonempty →
      ∀ m, (∃ g, ι V g = m) ↔ ∀ x ∈ V, ord x m = 0 := by
    intro V hV m
    obtain ⟨y, hy⟩ := hV
    haveI : Nonempty V := ⟨⟨y, hy⟩⟩
    have step1 : (∃ g, ι V g = m) ↔ ∃ g : (Γ(X, V))ˣ,
        Units.map (X.germToFunctionField V).hom.toMonoidHom g = Additive.toMul (E m) := by
      constructor
      · rintro ⟨g, hg⟩
        refine ⟨Additive.toMul g, ?_⟩
        have h1 := hι V (Additive.toMul g)
        rw [ofMul_toMul, hg] at h1
        rw [h1, AddEquiv.apply_symm_apply, toMul_ofMul]
      · rintro ⟨g, hg⟩
        refine ⟨Additive.ofMul g, ?_⟩
        rw [hι, hg, ofMul_toMul, AddEquiv.symm_apply_apply]
    have step2 : (∃ g : (Γ(X, V))ˣ,
        Units.map (X.germToFunctionField V).hom.toMonoidHom g = Additive.toMul (E m)) ↔
        ∃ g : (Γ(X, V))ˣ, (X.germToFunctionField V).hom (g : Γ(X, V)) =
          ((Additive.toMul (E m) : (X.functionField)ˣ) : X.functionField) :=
      exists_congr (fun g => Units.ext_iff)
    rw [step1, step2, s2 V]
    constructor
    · intro H x hxV
      by_cases hx : x = genericPoint X
      · subst hx
        exact P1 m
      · rw [hord x hx, show E m = Additive.ofMul (Additive.toMul (E m)) from rfl,
          (ho x hx).2.2.1]
        exact H ⟨x, hxV⟩ hx
    · intro H x hx
      rw [← (ho x hx).2.2.1, ← show E m = Additive.ofMul (Additive.toMul (E m)) from rfl,
        ← hord x hx]
      exact H x x.2
  exact ⟨ord, ι, ⟨P1, P7, P2, P3, P5, P6⟩, Q4, Q5, Q6⟩

theorem wc_zar_pic_divisor_presentation : ∀ (Ω : Type u) [Field Ω] (X : Scheme.{u})
    (fX : X ⟶ Spec (.of Ω)) [IsProper fX]
    [IrreducibleSpace X], topologicalKrullDim X = ((1 : ℕ) : WithBot ℕ∞) →
    ∀ (M : Type u) [AddCommGroup M] (ord : X → M →+ ℤ)
      (ι : ∀ V : X.Opens, Additive (Γ(X, V))ˣ →+ M),
    (∀ m, ord (genericPoint X) m = 0) →
    (∀ m, {x | ord x m ≠ 0}.Finite) →
    (∀ x, x ≠ genericPoint X → ∃ m, ord x m = 1) →
    (∀ (V W : X.Opens) (hWV : W ≤ V), (W : Set X).Nonempty → ∀ g : (Γ(X, V))ˣ,
      ι W (Additive.ofMul (Units.map (X.presheaf.map (homOfLE hWV).op).hom.toMonoidHom g)) =
        ι V (Additive.ofMul g)) →
    (∀ V : X.Opens, (V : Set X).Nonempty → Function.Injective (ι V)) →
    (∀ V : X.Opens, (V : Set X).Nonempty →
      ∀ m, (∃ g, ι V g = m) ↔ ∀ x ∈ V, ord x m = 0) →
    letI : HasExt (Sheaf (Opens.grothendieckTopology X) AddCommGrpCat.{u}) := HasExt.standard _
    ∃ ρ : (X →₀ ℤ) →+ Abelian.Ext ((constantSheaf (Opens.grothendieckTopology X)
        AddCommGrpCat.{u}).obj (AddCommGrpCat.of (ULift.{u} ℤ))) (wcZarGm X) 1,
      (∀ y, ∃ n : X →₀ ℤ, n (genericPoint X) = 0 ∧ ρ n = y) ∧
      (∀ n : X →₀ ℤ, n (genericPoint X) = 0 → (ρ n = 0 ↔ ∃ m, ∀ x, n x = ord x m)) :=
by
  intro Ω _ X fX _ _ hdim M _ ord ι h0 hfin hone hres hinj himg
  classical
  letI : HasExt (Sheaf (Opens.grothendieckTopology X) AddCommGrpCat.{u}) := HasExt.standard _

  obtain ⟨hcl, hcpt⟩ := wc_curve_points_closed_opens_compact Ω X fX hdim
  have H1 : ∀ V : X.Opens, (V : Set X).Nonempty → genericPoint X ∈ V := fun V hV =>
    ((genericPoint_spec X).mem_open_set_iff V.isOpen).mpr (by rwa [Set.univ_inter])
  obtain ⟨φ, hφ⟩ := wc_zarGm_sections_units X
  let ι' : ∀ V : X.Opens, (wcZarGm X).obj.obj (Opposite.op V) →+ M :=
    fun V => (ι V).comp (φ V).toAddMonoidHom
  have H7 : ∀ (V W : X.Opens) (hWV : W ≤ V), (W : Set X).Nonempty →
      ∀ g, ι' W ((wcZarGm X).obj.map (homOfLE hWV).op g) = ι' V g := by
    intro V W hWV hW g
    show ι W (φ W ((wcZarGm X).obj.map (homOfLE hWV).op g)) = ι V (φ V g)
    rw [hφ V W hWV g, hres V W hWV hW]
    rfl
  have H8 : ∀ V : X.Opens, (V : Set X).Nonempty → Function.Injective (ι' V) :=
    fun V hV => (hinj V hV).comp (φ V).injective
  have H9 : ∀ V : X.Opens, (V : Set X).Nonempty →
      ∀ m, (∃ g, ι' V g = m) ↔ ∀ x ∈ V, ord x m = 0 := by
    intro V hV m
    rw [← himg V hV m]
    constructor
    · rintro ⟨g, hg⟩
      exact ⟨φ V g, hg⟩
    · rintro ⟨g', hg'⟩
      refine ⟨(φ V).symm g', ?_⟩
      show ι V (φ V ((φ V).symm g')) = m
      rw [AddEquiv.apply_symm_apply]
      exact hg'
  obtain ⟨K, D, i, d, h, hSES, hflas, eK, eD, heDinj, heDsurj, heDη, hdiv⟩ :=
    wc_abstract_divisor_ses X (genericPoint X) M ord (wcZarGm X) ι' H1 hcpt hcl h0 hfin hone
      H7 H8 H9

  let P := (constantSheaf (Opens.grothendieckTopology X) AddCommGrpCat.{u}).obj
    (AddCommGrpCat.of (ULift.{u} ℤ))
  have hsub : Subsingleton (Abelian.Ext P K 1) := wc_zar_flasque_ext_one_vanish X K hflas
  let δ : Abelian.Ext P D 0 →+ Abelian.Ext P (wcZarGm X) 1 :=
    hSES.extClass.postcomp P (zero_add 1)
  have hδs : Function.Surjective δ := by
    intro x
    have hx0 : x.comp (Abelian.Ext.mk₀ (ShortComplex.mk i d h).f) (add_zero 1) = 0 :=
      @Subsingleton.elim _ hsub _ _
    obtain ⟨y, hy⟩ := Abelian.Ext.covariant_sequence_exact₁ P hSES x hx0 (zero_add 1)
    exact ⟨y, hy⟩
  have hδk : ∀ w, δ w = 0 ↔
      ∃ z : Abelian.Ext P K 0, z.comp (Abelian.Ext.mk₀ d) (add_zero 0) = w := by
    intro w
    constructor
    · intro hw
      obtain ⟨z, hz⟩ := Abelian.Ext.covariant_sequence_exact₃ P hSES w (zero_add 1) hw
      exact ⟨z, hz⟩
    · rintro ⟨z, rfl⟩
      change (z.comp (Abelian.Ext.mk₀ (ShortComplex.mk i d h).g) (add_zero 0)).comp
        hSES.extClass (zero_add 1) = 0
      rw [Abelian.Ext.comp_assoc _ _ _ (add_zero 0) (zero_add 1) (by omega),
        hSES.comp_extClass, Abelian.Ext.comp_zero]

  let hT : Limits.IsTerminal (⊤ : X.Opens) := Limits.IsTerminal.ofUnique _
  let eD' : Abelian.Ext P D 0 →+ (X →₀ ℤ) := eD.comp (Sheaf.H.equiv₀ D hT).toAddMonoidHom
  have heD'inj : Function.Injective eD' := heDinj.comp (Sheaf.H.equiv₀ D hT).injective
  have heD'surj : ∀ n : X →₀ ℤ, n (genericPoint X) = 0 → ∃ w, eD' w = n := by
    intro n hn
    obtain ⟨w0, hw0⟩ := heDsurj n hn
    refine ⟨(Sheaf.H.equiv₀ D hT).symm w0, ?_⟩
    show eD (Sheaf.H.equiv₀ D hT ((Sheaf.H.equiv₀ D hT).symm w0)) = n
    rw [AddEquiv.apply_symm_apply]
    exact hw0
  have heD'η : ∀ w, eD' w (genericPoint X) = 0 := fun w => heDη _
  have hchain : ∀ (z : Abelian.Ext P K 0) (x : X),
      eD' (z.comp (Abelian.Ext.mk₀ d) (add_zero 0)) x = ord x (eK (Sheaf.H.equiv₀ K hT z)) := by
    intro z x
    show eD (Sheaf.H.equiv₀ D hT (Sheaf.H.map d 0 z)) x = _
    rw [← Sheaf.H.equiv₀_naturality hT d z, hdiv]

  let D₀ : AddSubgroup (X →₀ ℤ) := (Finsupp.applyAddHom (genericPoint X)).ker
  have hD₀ : ∀ n : X →₀ ℤ, n ∈ D₀ ↔ n (genericPoint X) = 0 := fun n => by
    simp [D₀, AddMonoidHom.mem_ker]
  let eD₀ : Abelian.Ext P D 0 →+ D₀ := eD'.codRestrict D₀ (fun w => (hD₀ _).mpr (heD'η w))
  have hb : Function.Bijective eD₀ := by
    constructor
    · intro a b hab
      exact heD'inj (congrArg Subtype.val hab)
    · rintro ⟨n, hn⟩
      obtain ⟨w, hw⟩ := heD'surj n ((hD₀ n).mp hn)
      exact ⟨w, Subtype.ext hw⟩
  let σ : D₀ ≃+ Abelian.Ext P D 0 := (AddEquiv.ofBijective eD₀ hb).symm
  have hσ : ∀ y : D₀, eD' (σ y) = (y : X →₀ ℤ) := fun y =>
    congrArg Subtype.val ((AddEquiv.ofBijective eD₀ hb).apply_symm_apply y)
  let e0 : (X →₀ ℤ) →+ D₀ := (Finsupp.eraseAddHom (genericPoint X)).codRestrict D₀
    (fun n => (hD₀ _).mpr (by simp [Finsupp.eraseAddHom_apply, Finsupp.erase_same]))
  have he0 : ∀ n : X →₀ ℤ, n (genericPoint X) = 0 → ((e0 n : D₀) : X →₀ ℤ) = n := by
    intro n hn
    show Finsupp.erase (genericPoint X) n = n
    ext y
    by_cases hy : y = genericPoint X
    · rw [hy, Finsupp.erase_same, hn]
    · rw [Finsupp.erase_ne hy]
  have hF2 : ∀ n : X →₀ ℤ, n (genericPoint X) = 0 → eD' (σ (e0 n)) = n := fun n hn =>
    (hσ _).trans (he0 n hn)
  refine ⟨δ.comp (σ.toAddMonoidHom.comp e0), ?_, ?_⟩
  · intro y
    obtain ⟨w, rfl⟩ := hδs y
    refine ⟨eD' w, heD'η w, ?_⟩
    have hw : σ (e0 (eD' w)) = w := heD'inj (hF2 _ (heD'η w))
    show δ (σ (e0 (eD' w))) = δ w
    rw [hw]
  · intro n hn
    show δ (σ (e0 n)) = 0 ↔ _
    rw [hδk]
    constructor
    · rintro ⟨z, hz⟩
      refine ⟨eK (Sheaf.H.equiv₀ K hT z), fun x => ?_⟩
      rw [← hchain z x, hz, hF2 n hn]
    · rintro ⟨m, hm⟩
      refine ⟨(Sheaf.H.equiv₀ K hT).symm (eK.symm m), heD'inj (Finsupp.ext fun x => ?_)⟩
      rw [hchain, AddEquiv.apply_symm_apply, AddEquiv.apply_symm_apply, hF2 n hn, hm]

theorem wc_curve_divisor_degree_point_congr : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω)) [IsProper fX] [IrreducibleSpace X],
    (∀ x : X, IsDomain (X.presheaf.stalk x) ∧ IsIntegrallyClosed (X.presheaf.stalk x)) →
    topologicalKrullDim X = ((1 : ℕ) : WithBot ℕ∞) →
    ∀ (U : X.Opens) [IsDedekindDomain Γ(X, U)] (hU : IsAffineOpen U), ((U : Set X)ᶜ).Finite →
    ∀ ℓ : ℕ, ℓ.Prime → (ℓ : Ω) ≠ 0 →
    ∀ ord : X → Additive (FractionRing Γ(X, U))ˣ →+ ℤ, wcCurveOrdData Ω X fX U hU ord →
    (∀ (m : Additive (FractionRing Γ(X, U))ˣ) (E : X →₀ ℤ), (∀ x, E x = ord x m) →
      E.sum (fun _ k => k) = 0) ∧
    ∃ Q : X, Q ≠ genericPoint X ∧ ∀ x : X, x ≠ genericPoint X →
      ∃ (E : X →₀ ℤ) (m : Additive (FractionRing Γ(X, U))ˣ), E (genericPoint X) = 0 ∧
        ∀ y, Finsupp.single x 1 y - Finsupp.single Q 1 y = (ℓ : ℤ) * E y + ord y m :=
by
  intro Ω _ _ X fX _ _ hnorm hdim U _ hU hfin ℓ hℓ hℓΩ ord hord
  classical
  obtain ⟨g, c0, hRR⟩ :=
    wc_curve_riemann_roch_large_degree Ω X fX hnorm hdim U hU hfin ord hord
  refine ⟨fun m E hE => wc_curve_principal_degree_zero Ω X fX hnorm hdim U hU hfin ord hord
    g c0 hRR (Additive.toMul m) E (fun x => by rw [ofMul_toMul]; exact hE x), ?_⟩
  obtain ⟨hηU, hinj, hvU, hcover⟩ := wc_dedekind_affine_points X U hU

  have hB : ((U : Set X)ᶜ).Nonempty := by
    by_contra hB
    have hx1 : ∃ x₁ : X, x₁ ≠ genericPoint X := by
      by_contra hall
      push_neg at hall
      haveI : Subsingleton (TopologicalSpace.IrreducibleCloseds X) := by
        constructor
        intro s t
        apply TopologicalSpace.IrreducibleCloseds.ext
        ext x
        obtain ⟨a, ha⟩ := s.isIrreducible.nonempty
        obtain ⟨b, hb⟩ := t.isIrreducible.nonempty
        rw [hall x]
        constructor
        · intro _
          rw [← hall b]
          exact hb
        · intro _
          rw [← hall a]
          exact ha
      have h0 : topologicalKrullDim X ≤ 0 := Order.krullDim_nonpos_of_subsingleton
      rw [hdim] at h0
      norm_num at h0
    obtain ⟨x₁, hx₁⟩ := hx1
    have hUuniv : (U : Set X) = Set.univ :=
      Set.compl_empty_iff.mp (Set.not_nonempty_iff_eq_empty.mp hB)
    have hx₁U : x₁ ∈ U := by
      have hx : x₁ ∈ (U : Set X) := by rw [hUuniv]; trivial
      exact hx
    obtain ⟨v, -⟩ := hcover x₁ hx₁U hx₁
    have hUtop : U = ⊤ := by
      apply le_antisymm le_top
      intro x _
      have hx : x ∈ (U : Set X) := by rw [hUuniv]; trivial
      exact hx
    subst hUtop
    let φ : Ω →+* Γ(X, ⊤) := fX.appTop.hom.comp (Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom
    have hφint : φ.IsIntegral := by
      refine RingHom.IsIntegral.trans _ _ (RingHom.isIntegral_of_surjective _ ?_)
        (isIntegral_appTop_of_universallyClosed fX)
      intro y
      refine ⟨(Scheme.ΓSpecIso (CommRingCat.of Ω)).hom.hom y, ?_⟩
      change ((Scheme.ΓSpecIso (CommRingCat.of Ω)).hom ≫
        (Scheme.ΓSpecIso (CommRingCat.of Ω)).inv).hom y = y
      rw [Iso.hom_inv_id]
      rfl
    have hsurj : Function.Surjective φ := by
      letI : Algebra Ω Γ(X, ⊤) := φ.toAlgebra
      intro s
      have hs : _root_.IsIntegral Ω s := hφint s
      have hdeg := IsAlgClosed.degree_eq_one_of_irreducible Ω (minpoly.irreducible hs)
      obtain ⟨c, hc⟩ := minpoly.mem_range_of_degree_eq_one Ω s hdeg
      exact ⟨c, hc⟩
    obtain ⟨a, ha, ha0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot v.ne_bot
    obtain ⟨c, rfl⟩ := hsurj a
    have hc0 : c ≠ 0 := by
      rintro rfl
      exact ha0 (map_zero φ)
    have hunit : IsUnit (φ c) := (IsUnit.mk0 c hc0).map φ
    exact v.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem _ ha hunit)

  obtain ⟨Q, hQ⟩ := hB
  have hQη : Q ≠ genericPoint X := fun h => hQ (h ▸ hηU)

  have htor := wc_curve_classGroup_ell_torsion_finite Ω X fX inferInstance hnorm hdim U hU hfin
    ℓ hℓ hℓΩ
  obtain ⟨T, hT⟩ :=
    wc_curve_proper_ell_torsion_reps Ω X fX hnorm hdim U hU hfin ℓ hℓ ord hord htor
  obtain ⟨d, e, Y, Z, fY, fZ, p, hd1, hYirr, hYft, hYqc, hYsep, hZprop, hpcomm, hYdim, hZdim,
    hfib, hlink⟩ :=
    wc_curve_incidence_variety Ω X fX hnorm hdim U hU hfin ℓ hℓ ord hord Q hQ g c0 hRR T hT
  haveI := hYirr
  haveI := hYft
  haveI := hYqc
  haveI := hYsep
  haveI := hZprop
  have hpsurj : Function.Surjective p :=
    closed_points_surjective_of_fibre_dim Ω Y Z fY fZ p hpcomm d e hYdim hZdim hfib

  refine ⟨Q, hQη, fun x hx => ?_⟩
  let F : X →₀ ℤ := Finsupp.single x 1 + Finsupp.single Q ((d : ℤ) - 1)
  have hFη : F (genericPoint X) = 0 := by
    simp only [F, Finsupp.add_apply, Finsupp.single_apply]
    rw [if_neg hx, if_neg hQη]
    simp
  have hFnn : ∀ w, 0 ≤ F w := by
    intro w
    simp only [F, Finsupp.add_apply, Finsupp.single_apply]
    have hd : (0 : ℤ) ≤ (d : ℤ) - 1 := by omega
    split_ifs <;> omega
  have hFdeg : F.sum (fun _ k => k) = d := by
    simp only [F]
    rw [Finsupp.sum_add_index' (fun _ => rfl) (fun _ _ _ => rfl),
      Finsupp.sum_single_index rfl, Finsupp.sum_single_index rfl]
    ring
  obtain ⟨yY, hy⟩ := hlink F hFη hFnn hFdeg
  obtain ⟨z, hz⟩ := hpsurj yY
  obtain ⟨E, h, hE⟩ := hy z hz

  have hℓ0 : (ℓ : ℤ) ≠ 0 := Nat.cast_ne_zero.mpr hℓ.ne_zero
  have hEη : E (genericPoint X) = 0 := by
    have h1 := hE (genericPoint X)
    have h0 : ord (genericPoint X) (Additive.ofMul h) = 0 := hord.1 _
    rw [hFη, Finsupp.single_apply, if_neg hQη, h0] at h1
    have h2 : (ℓ : ℤ) * E (genericPoint X) = 0 := by rw [h1]; ring
    exact (mul_eq_zero.mp h2).resolve_left hℓ0
  refine ⟨E - Finsupp.single Q (d : ℤ), Additive.ofMul h⁻¹, ?_, fun y => ?_⟩
  · rw [Finsupp.sub_apply, hEη, Finsupp.single_apply, if_neg hQη, sub_zero]
  · have hyy := hE y
    simp only [F, Finsupp.add_apply, Finsupp.sub_apply, Finsupp.single_apply] at hyy ⊢
    rw [ofMul_inv, map_neg]
    split_ifs at hyy ⊢ <;> linear_combination -hyy

theorem wc_et_normal_curve_h2_card : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω)) [IsProper fX], IrreducibleSpace X → (∀ x : X, IsDomain (X.presheaf.stalk x) ∧ IsIntegrallyClosed (X.presheaf.stalk x)) → topologicalKrullDim X = ((1 : ℕ) : WithBot ℕ∞) → ∀ ℓ : ℕ, ℓ.Prime → (ℓ : Ω) ≠ 0 → Nat.card (wcEtCoh X ℓ 2) = ℓ :=
by
  intro Ω _ _ X fX _ hirr hnorm hdim ℓ hℓ hℓΩ
  classical
  haveI := hirr
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) := HasExt.standard _
  letI : HasExt (Sheaf (Opens.grothendieckTopology X) AddCommGrpCat.{u}) := HasExt.standard _
  haveI : Fact ℓ.Prime := ⟨hℓ⟩
  haveI hNPic : (nsmulAddMonoidHom ℓ : Abelian.Ext ((constantSheaf (Opens.grothendieckTopology X)
      AddCommGrpCat.{u}).obj (AddCommGrpCat.of (ULift.{u} ℤ))) (wcZarGm X) 1 →+
      Abelian.Ext ((constantSheaf (Opens.grothendieckTopology X) AddCommGrpCat.{u}).obj
        (AddCommGrpCat.of (ULift.{u} ℤ))) (wcZarGm X) 1).range.Normal :=
    ⟨fun n hn g => by rwa [add_comm g n, add_neg_cancel_right]⟩

  have hPic : Nat.card (Abelian.Ext ((constantSheaf (Opens.grothendieckTopology X)
      AddCommGrpCat.{u}).obj (AddCommGrpCat.of (ULift.{u} ℤ))) (wcZarGm X) 1 ⧸
      (nsmulAddMonoidHom ℓ : Abelian.Ext ((constantSheaf (Opens.grothendieckTopology X)
        AddCommGrpCat.{u}).obj (AddCommGrpCat.of (ULift.{u} ℤ))) (wcZarGm X) 1 →+
        Abelian.Ext ((constantSheaf (Opens.grothendieckTopology X) AddCommGrpCat.{u}).obj
          (AddCommGrpCat.of (ULift.{u} ℤ))) (wcZarGm X) 1).range) = ℓ := by
    obtain ⟨U, hU, hfin, hDed⟩ := wc_curve_dedekind_affine_open Ω X fX hirr hnorm hdim
    haveI := hDed
    obtain ⟨ord, ι₀, hord, hι1, hι2, hι3⟩ := wc_curve_ord_units_full Ω X fX hnorm hdim U hU hfin
    obtain ⟨ρ, hρs, hρk⟩ := wc_zar_pic_divisor_presentation Ω X fX hdim
      (Additive (FractionRing Γ(X, U))ˣ) ord ι₀ hord.1 hord.2.2.1 hord.2.2.2.1 hι1 hι2 hι3
    obtain ⟨hdeg, Q, hQ, hcong⟩ :=
      wc_curve_divisor_degree_point_congr Ω X fX hnorm hdim U hU hfin ℓ hℓ hℓΩ ord hord

    set η := genericPoint X with hη
    set N := (nsmulAddMonoidHom ℓ : Abelian.Ext ((constantSheaf (Opens.grothendieckTopology X)
        AddCommGrpCat.{u}).obj (AddCommGrpCat.of (ULift.{u} ℤ))) (wcZarGm X) 1 →+
        Abelian.Ext ((constantSheaf (Opens.grothendieckTopology X) AddCommGrpCat.{u}).obj
          (AddCommGrpCat.of (ULift.{u} ℤ))) (wcZarGm X) 1).range with hN
    letI instQ : AddCommGroup (_ ⧸ N) := QuotientAddGroup.Quotient.addCommGroup N
    let deg : (X →₀ ℤ) →+ ℤ := Finsupp.liftAddHom (fun _ : X => AddMonoidHom.id ℤ)
    have hdeg' : ∀ (m : Additive (FractionRing Γ(X, U))ˣ) (E : X →₀ ℤ),
        (∀ x, E x = ord x m) → deg E = 0 := by
      intro m E h
      have e : deg E = E.sum (fun _ k => k) := by simp [deg, Finsupp.liftAddHom_apply]; rfl
      rw [e]
      exact hdeg m E h
    have hdegs : ∀ (a : X) (b : ℤ), deg (Finsupp.single a b) = b := by
      intro a b
      simp [deg]
    have hR : ∀ n : X →₀ ℤ, ∃ (E : X →₀ ℤ) (m : Additive (FractionRing Γ(X, U))ˣ), E η = 0 ∧
        ∀ y, (n.erase η) y - deg (n.erase η) * Finsupp.single Q 1 y = (ℓ : ℤ) * E y + ord y m := by
      intro n
      induction n using Finsupp.induction_linear with
      | zero => exact ⟨0, 0, rfl, fun y => by simp⟩
      | add f g hf hg =>
        obtain ⟨E1, m1, h1η, h1⟩ := hf
        obtain ⟨E2, m2, h2η, h2⟩ := hg
        refine ⟨E1 + E2, m1 + m2, by simp [h1η, h2η], fun y => ?_⟩
        simp only [Finsupp.erase_add, Finsupp.add_apply, map_add, add_mul]
        linarith [h1 y, h2 y]
      | single a b =>
        by_cases ha : a = η
        · refine ⟨0, 0, rfl, fun y => ?_⟩
          rw [ha, Finsupp.erase_single]
          simp
        · obtain ⟨E, m, hEη, hE⟩ := hcong a ha
          refine ⟨b • E, b • m, by simp [hEη], fun y => ?_⟩
          rw [Finsupp.erase_single_ne (Ne.symm ha), hdegs, Finsupp.smul_apply, map_zsmul,
            smul_eq_mul, smul_eq_mul]
          have hs : Finsupp.single a b y = b * Finsupp.single a 1 y := by
            simp only [Finsupp.single_apply]
            split_ifs <;> simp
          rw [hs]
          linear_combination b * hE y
    have herase : ∀ n : X →₀ ℤ, n η = 0 → n.erase η = n := by
      intro n hn
      ext y
      by_cases hy : y = η
      · rw [hy, Finsupp.erase_same, hn]
      · rw [Finsupp.erase_ne hy]
    set q : _ ⧸ N := QuotientAddGroup.mk (ρ (Finsupp.single Q 1)) with hq
    have hqℓ : ((ℓ : ℤ) • q) = 0 := by
      rw [hq, ← QuotientAddGroup.mk_zsmul, QuotientAddGroup.eq_zero_iff, natCast_zsmul]
      exact AddMonoidHom.mem_range.mpr ⟨_, nsmulAddMonoidHom_apply _ _⟩
    let f : ZMod ℓ →+ _ ⧸ N := ZMod.lift ℓ ⟨zmultiplesHom (_ ⧸ N) q, by
      rw [zmultiplesHom_apply]; exact hqℓ⟩
    have hf : ∀ t : ℤ, f (t : ZMod ℓ) = t • q := by
      intro t
      simp only [f, ZMod.lift_coe, zmultiplesHom_apply]
    have hsurj : Function.Surjective f := by
      intro z
      obtain ⟨y, rfl⟩ := QuotientAddGroup.mk_surjective z
      obtain ⟨n, hn, rfl⟩ := hρs y
      obtain ⟨E, m, hEη, hE⟩ := hR n
      rw [herase n hn] at hE
      refine ⟨((deg n : ℤ) : ZMod ℓ), ?_⟩
      rw [hf]
      have h0 : ρ (n - ℓ • E - deg n • Finsupp.single Q 1) = 0 := by
        refine (hρk _ ?_).mpr ⟨m, fun x => ?_⟩
        · simp [hn, hEη, Finsupp.single_apply, hQ]
        · have := hE x
          simp only [Finsupp.sub_apply, Finsupp.smul_apply, nsmul_eq_mul, smul_eq_mul]
          linarith
      rw [map_sub, map_sub, map_nsmul, map_zsmul, sub_sub, sub_eq_zero] at h0
      rw [h0, QuotientAddGroup.mk_add, hq, ← QuotientAddGroup.mk_zsmul]
      have : (QuotientAddGroup.mk (ℓ • ρ E) : _ ⧸ N) = 0 := by
        rw [QuotientAddGroup.eq_zero_iff]
        exact AddMonoidHom.mem_range.mpr ⟨_, nsmulAddMonoidHom_apply _ _⟩
      rw [this, zero_add]
    have hinj : Function.Injective f := by
      rw [injective_iff_map_eq_zero]
      intro k hk
      obtain ⟨t, rfl⟩ := ZMod.intCast_surjective k
      rw [hf, hq, ← QuotientAddGroup.mk_zsmul, QuotientAddGroup.eq_zero_iff] at hk
      obtain ⟨z, hz⟩ := AddMonoidHom.mem_range.mp hk
      rw [nsmulAddMonoidHom_apply] at hz
      obtain ⟨nz, hnz, rfl⟩ := hρs z
      have h0 : ρ (t • Finsupp.single Q 1 - ℓ • nz) = 0 := by
        rw [map_sub, map_zsmul, map_nsmul, hz, sub_self]
      obtain ⟨m, hm⟩ := (hρk _ (by simp [hnz, Finsupp.single_apply, hQ])).mp h0
      have hd := hdeg' m _ hm
      rw [map_sub, map_zsmul, map_nsmul, hdegs, smul_eq_mul, mul_one, nsmul_eq_mul,
        sub_eq_zero] at hd
      exact (ZMod.intCast_zmod_eq_zero_iff_dvd t ℓ).mpr ⟨deg nz, hd⟩
    rw [← Nat.card_zmod ℓ]
    exact (Nat.card_congr (AddEquiv.ofBijective f ⟨hinj, hsurj⟩).toEquiv).symm

  let P := (constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
    (AddCommGrpCat.of (ULift.{u+1} ℤ))
  let G := wcEtGm X
  have hA : ∀ (n k : ℕ) (x : Abelian.Ext P G n),
      x.comp (Abelian.Ext.mk₀ (k • 𝟙 G)) (add_zero n) = k • x := by
    intro n k x
    induction k with
    | zero => rw [zero_nsmul, zero_nsmul, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
    | succ k ih =>
      rw [succ_nsmul, succ_nsmul, Abelian.Ext.mk₀_add, Abelian.Ext.comp_add, ih,
        Abelian.Ext.comp_mk₀_id]
  obtain ⟨ι, h, hS⟩ := wc_et_kummer_ses Ω X fX ℓ hℓ hℓΩ
  obtain ⟨e1⟩ := wc_et_gm_h1_zariski X
  have hV := wc_et_gm_tsen_vanishing Ω X fX hirr hnorm hdim
  let S := ShortComplex.mk ι (ℓ • 𝟙 (wcEtGm X)) h
  change Nat.card (Abelian.Ext P S.X₁ 2) = ℓ
  let δ : Abelian.Ext P G 1 →+ Abelian.Ext P S.X₁ 2 := hS.extClass.postcomp P rfl
  have hδs : Function.Surjective δ := by
    intro x
    have h0 : x.comp (Abelian.Ext.mk₀ S.f) (add_zero 2) = 0 := @Subsingleton.elim _ (hV 0) _ _
    obtain ⟨y, hy⟩ := Abelian.Ext.covariant_sequence_exact₁ P hS x h0 rfl
    exact ⟨y, hy⟩
  have hker : δ.ker = (nsmulAddMonoidHom ℓ : Abelian.Ext P G 1 →+ Abelian.Ext P G 1).range := by
    ext y
    rw [AddMonoidHom.mem_ker, AddMonoidHom.mem_range]
    constructor
    · intro hy
      obtain ⟨z, hz⟩ := Abelian.Ext.covariant_sequence_exact₃ P hS y rfl hy
      refine ⟨z, ?_⟩
      rw [nsmulAddMonoidHom_apply, ← hA 1 ℓ z]
      exact hz
    · rintro ⟨z, rfl⟩
      rw [nsmulAddMonoidHom_apply, ← hA 1 ℓ z]
      change (z.comp (Abelian.Ext.mk₀ S.g) (add_zero 1)).comp hS.extClass rfl = 0
      rw [Abelian.Ext.comp_assoc _ _ _ (add_zero 1) (zero_add 1) (by omega),
        hS.comp_extClass, Abelian.Ext.comp_zero]
  have hδ's : Function.Surjective (δ.comp e1.symm.toAddMonoidHom) := by
    intro x
    obtain ⟨y, hy⟩ := hδs x
    refine ⟨e1 y, ?_⟩
    show δ (e1.symm (e1 y)) = x
    rw [AddEquiv.symm_apply_apply]
    exact hy
  have hker' : (δ.comp e1.symm.toAddMonoidHom).ker =
      (nsmulAddMonoidHom ℓ : Abelian.Ext ((constantSheaf (Opens.grothendieckTopology X)
        AddCommGrpCat.{u}).obj (AddCommGrpCat.of (ULift.{u} ℤ))) (wcZarGm X) 1 →+
        Abelian.Ext ((constantSheaf (Opens.grothendieckTopology X) AddCommGrpCat.{u}).obj
          (AddCommGrpCat.of (ULift.{u} ℤ))) (wcZarGm X) 1).range := by
    ext w
    have hw : w ∈ (δ.comp e1.symm.toAddMonoidHom).ker ↔ e1.symm w ∈ δ.ker := by
      rw [AddMonoidHom.mem_ker, AddMonoidHom.mem_ker]
      rfl
    rw [hw, hker, AddMonoidHom.mem_range, AddMonoidHom.mem_range]
    constructor
    · rintro ⟨z, hz⟩
      refine ⟨e1 z, ?_⟩
      rw [nsmulAddMonoidHom_apply] at hz ⊢
      rw [← map_nsmul e1, hz, AddEquiv.apply_symm_apply]
    · rintro ⟨z, hz⟩
      refine ⟨e1.symm z, ?_⟩
      rw [nsmulAddMonoidHom_apply] at hz ⊢
      rw [← map_nsmul e1.symm, hz]
  let eK := QuotientAddGroup.quotientKerEquivOfSurjective _ hδ's
  let eQ := QuotientAddGroup.quotientAddEquivOfEq hker'
  exact (Nat.card_congr (eK.symm.trans eQ).toEquiv).trans hPic

theorem wc_et_fibre_coh_reduced_invariance : ∀ (S T Y R : Scheme.{u}) (pY : Y ⟶ S) (r : R ⟶ Y) [IsClosedImmersion r], Set.range r = Set.univ → ∀ (t : T ⟶ S) (m q : ℕ), Nat.card (wcEtCoh (Limits.pullback (r ≫ pY) t) m q) = Nat.card (wcEtCoh (Limits.pullback pY t) m q) :=
by
  intro S T Y R pY r _ hr t m q
  classical
  let f := Limits.pullback.fst pY t
  let r' : Limits.pullback r f ⟶ Limits.pullback pY t := Limits.pullback.snd r f
  haveI : IsClosedImmersion r' := inferInstance
  have hrange : ∀ y : (Limits.pullback pY t : Scheme.{u}), y ∉ (Set.range r')ᶜ := by
    intro y hy
    apply hy
    have h1 : Set.range r' = f ⁻¹' Set.range r := Scheme.Pullback.range_snd r f
    rw [h1, hr, Set.preimage_univ]
    trivial
  let J := Scheme.smallEtaleTopology (Limits.pullback pY t)
  have key : ∀ {P Q : (Scheme.Etale (Limits.pullback pY t))ᵒᵖ ⥤ AddCommGrpCat.{u+1}} (α : P ⟶ Q),
      α ≫ toSheafify J Q = 0 → (presheafToSheaf J AddCommGrpCat.{u+1}).map α = 0 := by
    intro P Q α hα
    apply ((sheafificationAdjunction J AddCommGrpCat.{u+1}).homEquiv _ _).injective
    rw [Adjunction.homEquiv_unit, Adjunction.homEquiv_unit, Functor.map_zero, Limits.comp_zero]
    have hn := (sheafificationAdjunction J AddCommGrpCat.{u+1}).unit.naturality α
    simp only [Functor.id_map, Functor.comp_map] at hn
    rw [← hn, sheafificationAdjunction_unit_app]
    exact hα
  have hι : wcEtExtZeroι (Limits.pullback pY t) (Set.range r')ᶜ m = 0 := by
    unfold wcEtExtZeroι
    apply key
    refine NatTrans.ext (funext fun V => ?_)
    rw [NatTrans.comp_app, NatTrans.app_zero]
    by_cases hV : Nonempty V.unop.left
    · obtain ⟨x⟩ := hV
      have hp : ¬ (∀ x, V.unop.hom x ∈ (Set.range r')ᶜ) := fun h => hrange _ (h x)
      ext z
      have hz0 : z = 0 := by
        obtain ⟨zv, hzv⟩ := z
        have hzv' : zv ∈ (⊥ : AddSubgroup (ULift.{u+1} (ZMod m))) := by
          have e : wcSuppSub.{u} m (∀ x, V.unop.hom x ∈ (Set.range r')ᶜ) = ⊥ := by
            unfold wcSuppSub
            exact iSup_neg hp
          rw [← e]
          exact hzv
        rw [AddSubgroup.mem_bot] at hzv'
        subst hzv'
        rfl
      rw [hz0]
      simp
    · have hE : IsEmpty V.unop.left := not_nonempty_iff.mp hV
      have hbot : (⊥ : Sieve V.unop) ∈ J V.unop :=
        wc_etale_jointly_surjective_covers (Limits.pullback pY t) V.unop ⊥
          (fun v => isEmptyElim v)
      exact (Sheaf.isTerminalOfBotCover ((presheafToSheaf J AddCommGrpCat.{u+1}).obj _) V.unop
        hbot).hom_ext _ _
  obtain ⟨E₁⟩ := wc_et_closed_complement_coh (Limits.pullback pY t) (Limits.pullback r f) r' m q
  obtain ⟨E₀⟩ := wc_et_coh_iso_invariance (Limits.pullbackRightPullbackFstIso pY t r).hom m q
  haveI : IsIso (Limits.cokernel.π (wcEtExtZeroι (Limits.pullback pY t) (Set.range r')ᶜ m)) :=
    by rw [hι]; infer_instance
  let c := asIso (Limits.cokernel.π (wcEtExtZeroι (Limits.pullback pY t) (Set.range r')ᶜ m))
  letI : HasExt (Sheaf J AddCommGrpCat.{u+1}) := HasExt.standard _
  let Z := (constantSheaf J AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))
  let E₂ : Abelian.Ext Z (Limits.cokernel (wcEtExtZeroι (Limits.pullback pY t) (Set.range r')ᶜ m)) q
      ≃ Abelian.Ext Z ((constantSheaf J AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) q :=
    { toFun := fun y => y.comp (Abelian.Ext.mk₀ c.inv) (add_zero q)
      invFun := fun y => y.comp (Abelian.Ext.mk₀ c.hom) (add_zero q)
      left_inv := fun x => by
        simp only
        rw [Abelian.Ext.comp_assoc _ _ _ (add_zero q) (add_zero 0) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.comp_mk₀_id]
      right_inv := fun y => by
        simp only
        rw [Abelian.Ext.comp_assoc _ _ _ (add_zero q) (add_zero 0) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id] }
  exact Nat.card_congr (E₀.trans (E₁.symm.trans E₂))

theorem wc_et_abstract_blowup_coh_equiv : ∀ (Y X' Z : Scheme.{u}) (b : X' ⟶ Y) [IsProper b] (iZ : Z ⟶ Y) [IsClosedImmersion iZ], (∀ U : Y.Opens, (U : Set Y) = (Set.range iZ)ᶜ → IsIso (b ∣_ U)) → ∀ m : ℕ, m ≠ 0 → (∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (Y₀ : Scheme.{u}) (f : Y₀ ⟶ Spec (.of A)) [IsProper f] (m' : ℕ), m' ≠ 0 → ∀ S : Set (Spec (.of A)), IsOpen S → S ≠ Set.univ → ∀ q' : ℕ, Subsingleton (wcEtExt Y₀ (wcEtExtZero Y₀ (f ⁻¹' S) m') q')) → ∀ q : ℕ, (∀ q' : ℕ, q' + 1 = q → Subsingleton (wcEtCoh Z m q')) → Subsingleton (wcEtCoh Z m q) → (∀ q' : ℕ, q' + 1 = q → Subsingleton (wcEtCoh (Limits.pullback b iZ) m q')) → Subsingleton (wcEtCoh (Limits.pullback b iZ) m q) → Nonempty (wcEtCoh Y m q ≃ wcEtCoh X' m q) :=
by
  intro Y X' Z b _ iZ _ hiso m hm hPBC q hZq' hZq hEq' hEq
  classical

  have hmono : ∀ (W : Scheme.{u}) (S : Set W), Mono (wcEtExtZeroι W S m) := by
    intro W S
    let α : wcEtExtZeroPre W S m ⟶
        (Functor.const _).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))) :=
      { app := fun V => AddCommGrpCat.ofHom (wcSuppSub.{u} m (∀ x, V.unop.hom x ∈ S)).subtype
        naturality := fun _ _ _ => rfl }
    haveI : ∀ V, Mono (α.app V) := fun V =>
      (AddCommGrpCat.mono_iff_injective _).mpr (AddSubgroup.subtype_injective _)
    haveI : Mono α := NatTrans.mono_of_mono_app α
    exact Functor.map_mono (presheafToSheaf (Scheme.smallEtaleTopology W) AddCommGrpCat.{u+1}) α

  have side : ∀ (W T : Scheme.{u}) (i : T ⟶ W) [IsClosedImmersion i],
      (∀ q' : ℕ, q' + 1 = q → Subsingleton (wcEtCoh T m q')) → Subsingleton (wcEtCoh T m q) →
      Nonempty (wcEtExt W (wcEtExtZero W (Set.range i)ᶜ m) q ≃ wcEtCoh W m q) := by
    intro W T i _ hT' hT
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology W) AddCommGrpCat.{u+1}) := HasExt.standard _
    let S := ShortComplex.mk (wcEtExtZeroι W (Set.range i)ᶜ m) (Limits.cokernel.π _)
      (Limits.cokernel.condition _)
    haveI := hmono W (Set.range i)ᶜ
    have hS : S.ShortExact :=
      ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel _) inferInstance inferInstance
    let P := (constantSheaf (Scheme.smallEtaleTopology W) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} ℤ))
    have hQ : ∀ n : ℕ, Subsingleton (wcEtCoh T m n) → Subsingleton (Abelian.Ext P S.X₃ n) := by
      intro n hn
      haveI := hn
      obtain ⟨e⟩ := wc_et_closed_complement_coh W T i m n
      exact e.subsingleton
    have hker : ∀ (n : ℕ) (x : Abelian.Ext P S.X₁ n),
        (∀ n' : ℕ, n' + 1 = n → Subsingleton (Abelian.Ext P S.X₃ n')) →
        x.comp (Abelian.Ext.mk₀ S.f) (add_zero n) = 0 → x = 0 := by
      intro n
      cases n with
      | zero =>
        intro x _ hx
        obtain ⟨g, rfl⟩ : ∃ g, Abelian.Ext.mk₀ g = x := ⟨_, Abelian.Ext.mk₀_homEquiv₀_apply x⟩
        have hx' : Abelian.Ext.mk₀ (g ≫ S.f) = Abelian.Ext.mk₀ 0 := by
          rw [← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_zero]
          exact hx
        rw [← Abelian.Ext.homEquiv₀_symm_apply, ← Abelian.Ext.homEquiv₀_symm_apply] at hx'
        have hg : g ≫ S.f = 0 := Abelian.Ext.homEquiv₀.symm.injective hx'
        haveI := hS.mono_f
        rw [Limits.zero_of_comp_mono S.f hg, Abelian.Ext.mk₀_zero]
      | succ n₀ =>
        intro x h3 hx
        obtain ⟨y, hy⟩ := Abelian.Ext.covariant_sequence_exact₁ P hS x hx rfl
        haveI : Subsingleton (Abelian.Ext P S.X₃ n₀) := h3 n₀ rfl
        rw [← hy, Subsingleton.elim y 0, Abelian.Ext.zero_comp]
    let φ : Abelian.Ext P S.X₁ q →+ Abelian.Ext P S.X₂ q :=
      (Abelian.Ext.mk₀ S.f).postcomp P (add_zero q)
    have hinj : Function.Injective φ := by
      rw [injective_iff_map_eq_zero]
      intro x hx
      exact hker q x (fun n' hn' => hQ n' (hT' n' hn')) hx
    have hsurj : Function.Surjective φ := by
      intro z
      haveI := hQ q hT
      have hz : z.comp (Abelian.Ext.mk₀ S.g) (add_zero q) = 0 := Subsingleton.elim _ _
      obtain ⟨a, ha⟩ := Abelian.Ext.covariant_sequence_exact₂ P hS z hz
      exact ⟨a, ha⟩
    exact ⟨Equiv.ofBijective φ ⟨hinj, hsurj⟩⟩
  obtain ⟨eY⟩ := side Y Z iZ hZq' hZq
  obtain ⟨eX⟩ := side X' (Limits.pullback b iZ) (Limits.pullback.fst b iZ) hEq' hEq
  obtain ⟨eJ⟩ := wc_et_proper_excision Y X' Z b iZ hiso m hm hPBC q
  exact ⟨eY.symm.trans (eJ.trans eX)⟩

theorem wc_et_extZero_clopen_biprod_iso : ∀ (X : Scheme.{u}) (U U' : Set X), IsOpen U → IsOpen U' → Disjoint U U' → U ∪ U' = Set.univ → ∀ m : ℕ, IsIso (Limits.biprod.desc (wcEtExtZeroι X U m) (wcEtExtZeroι X U' m)) :=
by
  intro X U U' hU hU' hdisj hcov m

  let F := presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}
  let P := wcEtExtZeroPre X U m
  let Q := wcEtExtZeroPre X U' m
  let K := (Functor.const (Scheme.Etale X)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))
  let α : P ⟶ K :=
    { app := fun V => AddCommGrpCat.ofHom (wcSuppSub.{u} m (∀ x, V.unop.hom x ∈ U)).subtype
      naturality := fun _ _ _ => rfl }
  let α' : Q ⟶ K :=
    { app := fun V => AddCommGrpCat.ofHom (wcSuppSub.{u} m (∀ x, V.unop.hom x ∈ U')).subtype
      naturality := fun _ _ _ => rfl }
  let σ : P ⊞ Q ⟶ K := Limits.biprod.desc α α'

  have hbot0 : ∀ (p : Prop), ¬ p → ∀ y : ULift.{u+1} (ZMod m), y ∈ wcSuppSub.{u} m p → y = 0 := by
    intro p hp y hy
    unfold wcSuppSub at hy
    rw [iSup_neg hp] at hy
    exact (AddSubgroup.mem_bot).mp hy
  have hbot : ∀ (p : Prop), ¬ p → ∀ a : wcSuppSub.{u} m p, a = 0 := by
    intro p hp a
    apply Subtype.ext
    exact hbot0 p hp a.1 a.2
  have htop : ∀ (p : Prop), p → ∀ s : ULift.{u+1} (ZMod m), s ∈ wcSuppSub.{u} m p := by
    intro p hp s
    unfold wcSuppSub
    rw [iSup_pos hp]
    exact AddSubgroup.mem_top s

  have etot : ∀ (V : (Scheme.Etale X)ᵒᵖ) (z : ↑((P ⊞ Q).obj V)),
      z = ConcreteCategory.hom ((Limits.biprod.inl : P ⟶ P ⊞ Q).app V)
            (ConcreteCategory.hom ((Limits.biprod.fst : P ⊞ Q ⟶ P).app V) z) +
          ConcreteCategory.hom ((Limits.biprod.inr : Q ⟶ P ⊞ Q).app V)
            (ConcreteCategory.hom ((Limits.biprod.snd : P ⊞ Q ⟶ Q).app V) z) := by
    intro V z
    have h := ConcreteCategory.congr_hom
      (NatTrans.congr_app (Limits.biprod.total (X := P) (Y := Q)) V) z
    exact h.symm
  have edesc : ∀ (V : (Scheme.Etale X)ᵒᵖ) (z : ↑((P ⊞ Q).obj V)),
      ConcreteCategory.hom (σ.app V) z =
        ConcreteCategory.hom (α.app V)
            (ConcreteCategory.hom ((Limits.biprod.fst : P ⊞ Q ⟶ P).app V) z) +
          ConcreteCategory.hom (α'.app V)
            (ConcreteCategory.hom ((Limits.biprod.snd : P ⊞ Q ⟶ Q).app V) z) := by
    intro V z
    exact ConcreteCategory.congr_hom (NatTrans.congr_app
      (Limits.biprod.desc_eq : Limits.biprod.desc α α' = _) V) z
  have einl : ∀ (V : (Scheme.Etale X)ᵒᵖ) (a : ↑(P.obj V)),
      ConcreteCategory.hom (σ.app V)
        (ConcreteCategory.hom ((Limits.biprod.inl : P ⟶ P ⊞ Q).app V) a) =
        ConcreteCategory.hom (α.app V) a := by
    intro V a
    exact ConcreteCategory.congr_hom (NatTrans.congr_app (Limits.biprod.inl_desc α α') V) a
  have einr : ∀ (V : (Scheme.Etale X)ᵒᵖ) (b : ↑(Q.obj V)),
      ConcreteCategory.hom (σ.app V)
        (ConcreteCategory.hom ((Limits.biprod.inr : Q ⟶ P ⊞ Q).app V) b) =
        ConcreteCategory.hom (α'.app V) b := by
    intro V b
    exact ConcreteCategory.congr_hom (NatTrans.congr_app (Limits.biprod.inr_desc α α') V) b

  haveI hinj : Presheaf.IsLocallyInjective (Scheme.smallEtaleTopology X) σ := by
    refine ⟨fun {V} x y hxy => ?_⟩
    by_cases hne : Nonempty V.unop.left
    · obtain ⟨x₀⟩ := hne
      have hxy' : x = y := by
        rw [← sub_eq_zero]
        set z := x - y with hzdef
        have hσz : ConcreteCategory.hom (σ.app V) z = 0 := by
          rw [hzdef, map_sub, hxy, sub_self]
        rw [edesc V z] at hσz
        set a : wcSuppSub.{u} m (∀ x, V.unop.hom x ∈ U) :=
          ConcreteCategory.hom ((Limits.biprod.fst : P ⊞ Q ⟶ P).app V) z with ha
        set b : wcSuppSub.{u} m (∀ x, V.unop.hom x ∈ U') :=
          ConcreteCategory.hom ((Limits.biprod.snd : P ⊞ Q ⟶ Q).app V) z with hb
        have hab : (a : ULift.{u+1} (ZMod m)) + (b : ULift.{u+1} (ZMod m)) = 0 := hσz
        have hab0 : a = 0 ∧ b = 0 := by
          by_cases hpU : ∀ x, V.unop.hom x ∈ U
          · have hpU' : ¬ ∀ x, V.unop.hom x ∈ U' := fun h =>
              Set.disjoint_left.mp hdisj (hpU x₀) (h x₀)
            have hb0 := hbot _ hpU' b
            refine ⟨?_, hb0⟩
            apply Subtype.ext
            rw [hb0] at hab
            simpa using hab
          · have ha0 := hbot _ hpU a
            refine ⟨ha0, ?_⟩
            apply Subtype.ext
            rw [ha0] at hab
            simpa using hab
        rw [etot V z]
        change ConcreteCategory.hom ((Limits.biprod.inl : P ⟶ P ⊞ Q).app V) a +
          ConcreteCategory.hom ((Limits.biprod.inr : Q ⟶ P ⊞ Q).app V) b = 0
        have h1 : ConcreteCategory.hom ((Limits.biprod.inl : P ⟶ P ⊞ Q).app V) a = 0 := by
          rw [hab0.1]; exact map_zero _
        have h2 : ConcreteCategory.hom ((Limits.biprod.inr : Q ⟶ P ⊞ Q).app V) b = 0 := by
          rw [hab0.2]; exact map_zero _
        rw [h1, h2, add_zero]
      rw [hxy', Presheaf.equalizerSieve_self_eq_top]
      exact GrothendieckTopology.top_mem _ _
    · haveI : IsEmpty V.unop.left := not_nonempty_iff.mp hne
      have hmem : Sieve.ofArrows (X := V.unop) (fun _ : PEmpty.{1} => V.unop)
          (fun j => PEmpty.elim j) ∈ Scheme.smallEtaleTopology X V.unop := by
        rw [Scheme.ofArrows_mem_smallEtaleTopology_iff, Set.iUnion_of_empty]
        exact (Set.univ_eq_empty_iff.mpr inferInstance).symm
      have hle : Sieve.ofArrows (X := V.unop) (fun _ : PEmpty.{1} => V.unop)
          (fun j => PEmpty.elim j) ≤ Presheaf.equalizerSieve x y := by
        rw [Sieve.ofArrows, Sieve.generate_le_iff]
        rintro _ _ ⟨j⟩
        exact j.elim
      exact GrothendieckTopology.superset_covering _ hle hmem

  haveI hsurj : Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology X) σ := by
    refine ⟨fun {V} s => ?_⟩
    let O : V.left.Opens := V.hom ⁻¹ᵁ ⟨U, hU⟩
    let O' : V.left.Opens := V.hom ⁻¹ᵁ ⟨U', hU'⟩
    have hcovT : Sieve.ofArrows (X := V) (fun b : Bool => wcEtOpen X V (cond b O O'))
        (fun b => wcEtOpenι X V (cond b O O')) ∈ Scheme.smallEtaleTopology X V := by
      rw [Scheme.ofArrows_mem_smallEtaleTopology_iff]
      apply Set.eq_univ_of_forall
      intro v
      have hv : V.hom v ∈ U ∪ U' := by rw [hcov]; trivial
      rw [Set.mem_iUnion]
      rcases hv with h | h
      · refine ⟨true, ?_⟩
        change v ∈ Set.range O.ι
        rw [Scheme.Opens.range_ι]
        exact h
      · refine ⟨false, ?_⟩
        change v ∈ Set.range O'.ι
        rw [Scheme.Opens.range_ι]
        exact h
    refine GrothendieckTopology.superset_covering _ ?_ hcovT
    rw [Sieve.ofArrows, Sieve.generate_le_iff]
    rintro _ _ ⟨b⟩
    cases b
    · have hp : ∀ x, (wcEtOpen X V O').hom x ∈ U' := by
        intro x
        exact x.2
      refine Eq.mpr (Presheaf.imageSieve_apply _ _ _ _) ⟨ConcreteCategory.hom
        ((Limits.biprod.inr : Q ⟶ P ⊞ Q).app _)
        (⟨s, htop _ hp s⟩ : wcSuppSub.{u} m (∀ x, (wcEtOpen X V O').hom x ∈ U')), ?_⟩
      exact (einr _ _).trans rfl
    · have hp : ∀ x, (wcEtOpen X V O).hom x ∈ U := by
        intro x
        exact x.2
      refine Eq.mpr (Presheaf.imageSieve_apply _ _ _ _) ⟨ConcreteCategory.hom
        ((Limits.biprod.inl : P ⟶ P ⊞ Q).app _)
        (⟨s, htop _ hp s⟩ : wcSuppSub.{u} m (∀ x, (wcEtOpen X V O).hom x ∈ U)), ?_⟩
      exact (einl _ _).trans rfl

  have hW : (Scheme.smallEtaleTopology X).W σ :=
    GrothendieckTopology.W_of_isLocallyBijective _ σ
  haveI hσiso : IsIso (F.map σ) := (GrothendieckTopology.W_iff _ σ).1 hW
  clear hinj hsurj

  let θ : F.obj P ⊞ F.obj Q ⟶ F.obj (P ⊞ Q) :=
    Limits.biprod.desc (F.map (Limits.biprod.inl : P ⟶ P ⊞ Q))
      (F.map (Limits.biprod.inr : Q ⟶ P ⊞ Q))
  let ψ : F.obj (P ⊞ Q) ⟶ F.obj P ⊞ F.obj Q :=
    Limits.biprod.lift (F.map (Limits.biprod.fst : P ⊞ Q ⟶ P))
      (F.map (Limits.biprod.snd : P ⊞ Q ⟶ Q))
  haveI hθiso : IsIso θ := by
    refine ⟨⟨ψ, ?_, ?_⟩⟩
    · apply Limits.biprod.hom_ext' <;> apply Limits.biprod.hom_ext
      · simp only [θ, ψ, Limits.biprod.inl_desc_assoc, Category.assoc, Limits.biprod.lift_fst,
          Category.id_comp, Limits.biprod.inl_fst, ← F.map_comp, F.map_id]
      · simp only [θ, ψ, Limits.biprod.inl_desc_assoc, Category.assoc, Limits.biprod.lift_snd,
          Category.id_comp, Limits.biprod.inl_snd, ← F.map_comp, F.map_zero]
      · simp only [θ, ψ, Limits.biprod.inr_desc_assoc, Category.assoc, Limits.biprod.lift_fst,
          Category.id_comp, Limits.biprod.inr_fst, ← F.map_comp, F.map_zero]
      · simp only [θ, ψ, Limits.biprod.inr_desc_assoc, Category.assoc, Limits.biprod.lift_snd,
          Category.id_comp, Limits.biprod.inr_snd, ← F.map_comp, F.map_id]
    · simp only [θ, ψ]
      rw [Limits.biprod.lift_desc, ← F.map_comp, ← F.map_comp, ← F.map_add,
        Limits.biprod.total, F.map_id]
  have hfac : Limits.biprod.desc (wcEtExtZeroι X U m) (wcEtExtZeroι X U' m) = θ ≫ F.map σ := by
    apply Limits.biprod.hom_ext'
    · rw [Limits.biprod.inl_desc]
      change F.map α = Limits.biprod.inl ≫ Limits.biprod.desc (F.map (Limits.biprod.inl : P ⟶ P ⊞ Q))
        (F.map (Limits.biprod.inr : Q ⟶ P ⊞ Q)) ≫ F.map σ
      rw [Limits.biprod.inl_desc_assoc, ← F.map_comp, Limits.biprod.inl_desc]
    · rw [Limits.biprod.inr_desc]
      change F.map α' = Limits.biprod.inr ≫ Limits.biprod.desc (F.map (Limits.biprod.inl : P ⟶ P ⊞ Q))
        (F.map (Limits.biprod.inr : Q ⟶ P ⊞ Q)) ≫ F.map σ
      rw [Limits.biprod.inr_desc_assoc, ← F.map_comp, Limits.biprod.inr_desc]
  rw [hfac]
  exact @IsIso.comp_isIso _ _ _ _ _ θ (F.map σ) hθiso hσiso

theorem wc_ext_biprod_desc_iso_prod : ∀ {C : Type*} [Category C] [Abelian C] [HasExt C] (P A B L : C) (f : A ⟶ L) (g : B ⟶ L), IsIso (Limits.biprod.desc f g) → ∀ n : ℕ, Nonempty (Abelian.Ext P L n ≃ Abelian.Ext P (Limits.cokernel g) n × Abelian.Ext P (Limits.cokernel f) n) :=
by
  intro C _ _ _ P A B L f g hφ n
  have h1 : f ≫ inv (Limits.biprod.desc f g) = Limits.biprod.inl := by
    rw [← cancel_mono (Limits.biprod.desc f g)]
    simp
  have h2 : g ≫ inv (Limits.biprod.desc f g) = Limits.biprod.inr := by
    rw [← cancel_mono (Limits.biprod.desc f g)]
    simp
  have hgz : g ≫ (inv (Limits.biprod.desc f g) ≫ Limits.biprod.fst ≫ f) = 0 := by
    rw [← Category.assoc, h2]
    simp
  have hfz : f ≫ (inv (Limits.biprod.desc f g) ≫ Limits.biprod.snd ≫ g) = 0 := by
    rw [← Category.assoc, h1]
    simp
  obtain ⟨sg, Dg⟩ : ∃ s : Limits.cokernel g ⟶ L,
      Limits.cokernel.π g ≫ s = inv (Limits.biprod.desc f g) ≫ Limits.biprod.fst ≫ f :=
    ⟨_, Limits.cokernel.π_desc _ _ hgz⟩
  obtain ⟨sf, Df⟩ : ∃ s : Limits.cokernel f ⟶ L,
      Limits.cokernel.π f ≫ s = inv (Limits.biprod.desc f g) ≫ Limits.biprod.snd ≫ g :=
    ⟨_, Limits.cokernel.π_desc _ _ hfz⟩
  have star : Limits.cokernel.π g ≫ sg + Limits.cokernel.π f ≫ sf = 𝟙 L := by
    rw [Dg, Df, ← Preadditive.comp_add, ← Limits.biprod.desc_eq, IsIso.inv_hom_id]
  have c1 : sf ≫ Limits.cokernel.π g = 0 := by
    rw [← cancel_epi (Limits.cokernel.π f), ← Category.assoc, Df, Limits.comp_zero]
    simp
  have c2 : sg ≫ Limits.cokernel.π f = 0 := by
    rw [← cancel_epi (Limits.cokernel.π g), ← Category.assoc, Dg, Limits.comp_zero]
    simp
  have r1 : sg ≫ Limits.cokernel.π g = 𝟙 _ := by
    rw [← cancel_epi (Limits.cokernel.π g), Category.comp_id]
    have h := congrArg (· ≫ Limits.cokernel.π g) star
    simp only [Preadditive.add_comp, Category.assoc, c1, Limits.comp_zero, add_zero,
      Category.id_comp] at h
    exact h
  have r2 : sf ≫ Limits.cokernel.π f = 𝟙 _ := by
    rw [← cancel_epi (Limits.cokernel.π f), Category.comp_id]
    have h := congrArg (· ≫ Limits.cokernel.π f) star
    simp only [Preadditive.add_comp, Category.assoc, c2, Limits.comp_zero, zero_add,
      Category.id_comp] at h
    exact h
  have hC : ∀ {X Y Y' Y'' : C} (x : Abelian.Ext X Y n) (u : Y ⟶ Y') (v : Y' ⟶ Y''),
      (x.comp (Abelian.Ext.mk₀ u) (add_zero n)).comp (Abelian.Ext.mk₀ v) (add_zero n) =
        x.comp (Abelian.Ext.mk₀ (u ≫ v)) (add_zero n) := by
    intro X Y Y' Y'' x u v
    rw [Abelian.Ext.comp_assoc _ _ _ (add_zero n) (add_zero 0) (by omega),
      Abelian.Ext.mk₀_comp_mk₀]
  refine ⟨{ toFun := fun x => (x.comp (Abelian.Ext.mk₀ (Limits.cokernel.π g)) (add_zero n),
              x.comp (Abelian.Ext.mk₀ (Limits.cokernel.π f)) (add_zero n))
            invFun := fun p => p.1.comp (Abelian.Ext.mk₀ sg) (add_zero n) +
              p.2.comp (Abelian.Ext.mk₀ sf) (add_zero n)
            left_inv := ?_
            right_inv := ?_ }⟩
  · intro x
    simp only
    rw [hC, hC, ← Abelian.Ext.comp_add, ← Abelian.Ext.mk₀_add, star, Abelian.Ext.comp_mk₀_id]
  · rintro ⟨y, z⟩
    simp only
    rw [Abelian.Ext.add_comp, Abelian.Ext.add_comp, hC, hC, hC, hC, r1, c1, c2, r2,
      Abelian.Ext.mk₀_zero, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero, Abelian.Ext.comp_zero,
      Abelian.Ext.comp_mk₀_id, Abelian.Ext.comp_mk₀_id, add_zero, zero_add]

theorem wc_top_dim_nonpos_isClosed_singleton : ∀ (X : Type u) [TopologicalSpace X] [T0Space X], topologicalKrullDim X ≤ ((0 : ℕ) : WithBot ℕ∞) → ∀ x : X, IsClosed ({x} : Set X) :=
by
  intro X _ _ h x
  have h0 : Order.krullDim (TopologicalSpace.IrreducibleCloseds X) ≤ 0 := by
    have h' : topologicalKrullDim X ≤ 0 := by simpa using h
    exact h'
  have hmin := Order.krullDim_nonpos_iff_forall_isMin.mp h0
  apply closure_subset_iff_isClosed.mp
  intro y hy
  have hxy : x ⤳ y := specializes_iff_mem_closure.mpr hy
  let c : TopologicalSpace.IrreducibleCloseds X :=
    ⟨closure {x}, isIrreducible_singleton.closure, isClosed_closure⟩
  let d : TopologicalSpace.IrreducibleCloseds X :=
    ⟨closure {y}, isIrreducible_singleton.closure, isClosed_closure⟩
  have hdc : d ≤ c := by
    show (closure {y} : Set X) ⊆ closure {x}
    exact hxy.closure_subset
  have hcd : c ≤ d := hmin c hdc
  have hcd' : (closure {x} : Set X) ⊆ closure {y} := hcd
  have heq : closure ({x} : Set X) = closure {y} := Set.Subset.antisymm hcd' hxy.closure_subset
  have hins : Inseparable x y := inseparable_iff_closure_eq.mpr heq
  exact Set.mem_singleton_iff.mpr hins.eq.symm

theorem wc_top_irreducible_dim_one_ncard : ∀ (X : Type u) [TopologicalSpace X] [T0Space X] [QuasiSober X] [IrreducibleSpace X], topologicalKrullDim X = ((1 : ℕ) : WithBot ℕ∞) → Set.ncard {x : X | ¬ IsClosed ({x} : Set X)} = 1 :=
by
  intro X _ _ _ _ hdim
  have hdim' : Order.krullDim (TopologicalSpace.IrreducibleCloseds X) = ((1 : ℕ) : WithBot ℕ∞) :=
    hdim
  have nochain : ∀ A B C : TopologicalSpace.IrreducibleCloseds X, A < B → B < C → False := by
    intro A B C h1 h2
    let p : LTSeries (TopologicalSpace.IrreducibleCloseds X) :=
      ⟨2, ![A, B, C], fun i => by fin_cases i <;> simpa⟩
    have hp : ((2 : ℕ) : WithBot ℕ∞) ≤ Order.krullDim (TopologicalSpace.IrreducibleCloseds X) :=
      Order.le_krullDim_iff.mpr ⟨p, rfl⟩
    rw [hdim'] at hp
    norm_cast at hp
  obtain ⟨η, hηcl⟩ : ∃ η : X, closure ({η} : Set X) = Set.univ := by
    refine ⟨genericPoint X, ?_⟩
    have h := genericPoint_spec X
    rw [isGenericPoint_def] at h
    simpa using h
  have s3 : ∀ x : X, ¬ IsClosed ({x} : Set X) → x = η := by
    intro x hx
    have hnsub : ¬ closure ({x} : Set X) ⊆ {x} := fun h => hx (closure_subset_iff_isClosed.mp h)
    obtain ⟨y, hy, hyx⟩ := Set.not_subset.mp hnsub
    have hxy : x ⤳ y := specializes_iff_mem_closure.mpr hy
    have hsub : closure ({y} : Set X) ⊆ closure {x} := hxy.closure_subset
    have hne : closure ({y} : Set X) ≠ closure {x} := by
      intro h
      exact hyx (Set.mem_singleton_iff.mpr (inseparable_iff_closure_eq.mpr h).eq)
    by_cases hu : closure ({x} : Set X) = Set.univ
    · exact (inseparable_iff_closure_eq.mpr (hu.trans hηcl.symm)).eq
    · let A : TopologicalSpace.IrreducibleCloseds X :=
        ⟨closure {y}, isIrreducible_singleton.closure, isClosed_closure⟩
      let B : TopologicalSpace.IrreducibleCloseds X :=
        ⟨closure {x}, isIrreducible_singleton.closure, isClosed_closure⟩
      let C : TopologicalSpace.IrreducibleCloseds X :=
        ⟨Set.univ, IrreducibleSpace.isIrreducible_univ X, isClosed_univ⟩
      have h1 : A < B := SetLike.coe_ssubset_coe.mp (hsub.ssubset_of_ne hne)
      have h2 : B < C :=
        SetLike.coe_ssubset_coe.mp ((Set.subset_univ (closure ({x} : Set X))).ssubset_of_ne hu)
      exact (nochain A B C h1 h2).elim
  have s4 : ¬ IsClosed ({η} : Set X) := by
    intro hc
    have huniv : ({η} : Set X) = Set.univ := hc.closure_eq.symm.trans hηcl
    have hall : ∀ z : X, z = η := fun z => by
      have : z ∈ ({η} : Set X) := huniv ▸ Set.mem_univ z
      exact this
    have h0 : Order.krullDim (TopologicalSpace.IrreducibleCloseds X) ≤ 0 := by
      apply Order.krullDim_nonpos_iff_forall_isMin.mpr
      intro a b _
      obtain ⟨w, hw⟩ := b.isIrreducible.nonempty
      apply SetLike.coe_subset_coe.mp
      intro z _
      have hzw : z = w := (hall z).trans (hall w).symm
      rw [hzw]
      exact hw
    rw [hdim'] at h0
    norm_cast at h0
  have hset : {x : X | ¬ IsClosed ({x} : Set X)} = {η} := by
    ext x
    simp only [Set.mem_setOf_eq, Set.mem_singleton_iff]
    constructor
    · exact s3 x
    · intro h
      rw [h]
      exact s4
  rw [hset, Set.ncard_singleton]

theorem wc_proper_curve_nonclosed_finite : ∀ (Ω : Type u) [Field Ω] (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω)) [IsProper fX], topologicalKrullDim X ≤ ((1 : ℕ) : WithBot ℕ∞) → Set.Finite {x : X | ¬ IsClosed ({x} : Set X)} :=
by
  intro Ω _ X fX _ hdim
  haveI : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian fX
  haveI : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace fX
  haveI : AlgebraicGeometry.IsNoetherian X := AlgebraicGeometry.IsNoetherian.mk
  haveI : TopologicalSpace.NoetherianSpace X := inferInstance
  have hfin : (irreducibleComponents X).Finite :=
    TopologicalSpace.NoetherianSpace.finite_irreducibleComponents
  have hmm : ∀ T : TopologicalSpace.IrreducibleCloseds X, IsMin T ∨ IsMax T :=
    (Order.krullDim_le_one_iff (α := TopologicalSpace.IrreducibleCloseds X)).mp
      (by simpa [topologicalKrullDim] using hdim)
  have hinj : Function.Injective (fun x : X => closure ({x} : Set X)) := by
    intro a b h
    exact (inseparable_iff_closure_eq.mpr h).eq
  have hcomp : ∀ x : X, ¬ IsClosed ({x} : Set X) →
      closure ({x} : Set X) ∈ irreducibleComponents X := by
    intro x hx
    have hns : ¬ closure ({x} : Set X) ⊆ {x} := fun h => hx (closure_subset_iff_isClosed.mp h)
    obtain ⟨y, hy, hyx⟩ := Set.not_subset.mp hns
    have hyx' : y ≠ x := hyx
    have hsub : closure ({y} : Set X) ⊆ closure ({x} : Set X) :=
      closure_minimal (Set.singleton_subset_iff.mpr hy) isClosed_closure
    have hne : closure ({y} : Set X) ≠ closure ({x} : Set X) := fun h => hyx' (hinj h)
    let Tx : TopologicalSpace.IrreducibleCloseds X :=
      ⟨closure {x}, isIrreducible_singleton.closure, isClosed_closure⟩
    let Ty : TopologicalSpace.IrreducibleCloseds X :=
      ⟨closure {y}, isIrreducible_singleton.closure, isClosed_closure⟩
    have hlt : Ty < Tx := by
      refine lt_of_le_of_ne (show Ty ≤ Tx from hsub) ?_
      intro h
      exact hne (congrArg TopologicalSpace.IrreducibleCloseds.carrier h)
    have hmax : IsMax Tx := (hmm Tx).resolve_left (fun h => h.not_lt hlt)
    obtain ⟨W, hW, hxW⟩ := exists_mem_irreducibleComponents_subset_of_isIrreducible _
      (isIrreducible_singleton (x := x)).closure
    let TW : TopologicalSpace.IrreducibleCloseds X :=
      ⟨W, hW.prop, isClosed_of_mem_irreducibleComponents W hW⟩
    have hle : TW ≤ Tx := hmax (show Tx ≤ TW from hxW)
    have heq : closure ({x} : Set X) = W := Set.Subset.antisymm hxW hle
    rw [heq]
    exact hW
  have himg : (fun x : X => closure ({x} : Set X)) '' {x : X | ¬ IsClosed ({x} : Set X)} ⊆
      irreducibleComponents X := by
    rintro _ ⟨x, hx, rfl⟩
    exact hcomp x hx
  exact Set.Finite.of_finite_image (hfin.subset himg) hinj.injOn

theorem wc_clopen_split_ncard_add : ∀ (X X' Z : Scheme.{u}) (b : X' ⟶ X) (iZ : Z ⟶ X) [IsClosedImmersion b] [IsClosedImmersion iZ], (∀ x : X, x ∈ Set.range b ∨ x ∈ Set.range iZ) → Disjoint (Set.range b) (Set.range iZ) → Set.Finite {x : X' | ¬ IsClosed ({x} : Set X')} → Set.Finite {x : Z | ¬ IsClosed ({x} : Set Z)} → Set.ncard {x : X | ¬ IsClosed ({x} : Set X)} = Set.ncard {x : X' | ¬ IsClosed ({x} : Set X')} + Set.ncard {x : Z | ¬ IsClosed ({x} : Set Z)} :=
by
  intro X X' Z b iZ _ _ hcov hdisj hfX' hfZ
  have hb := b.isClosedEmbedding
  have hi := iZ.isClosedEmbedding
  have kb : ∀ y : X', IsClosed ({y} : Set X') ↔ IsClosed ({b y} : Set X) := by
    intro y
    rw [hb.isClosed_iff_image_isClosed, Set.image_singleton]
  have ki : ∀ y : Z, IsClosed ({y} : Set Z) ↔ IsClosed ({iZ y} : Set X) := by
    intro y
    rw [hi.isClosed_iff_image_isClosed, Set.image_singleton]
  have hset : {x : X | ¬ IsClosed ({x} : Set X)} =
      b '' {x : X' | ¬ IsClosed ({x} : Set X')} ∪ iZ '' {x : Z | ¬ IsClosed ({x} : Set Z)} := by
    ext x
    simp only [Set.mem_setOf_eq, Set.mem_union, Set.mem_image]
    constructor
    · intro hx
      rcases hcov x with ⟨y, rfl⟩ | ⟨y, rfl⟩
      · exact Or.inl ⟨y, by rwa [kb], rfl⟩
      · exact Or.inr ⟨y, by rwa [ki], rfl⟩
    · rintro (⟨y, hy, rfl⟩ | ⟨y, hy, rfl⟩)
      · rwa [← kb]
      · rwa [← ki]
  have hd : Disjoint (b '' {x : X' | ¬ IsClosed ({x} : Set X')})
      (iZ '' {x : Z | ¬ IsClosed ({x} : Set Z)}) :=
    hdisj.mono (Set.image_subset_range _ _) (Set.image_subset_range _ _)
  rw [hset, Set.ncard_union_eq hd (hfX'.image _) (hfZ.image _),
    Set.ncard_image_of_injective _ hb.isEmbedding.injective,
    Set.ncard_image_of_injective _ hi.isEmbedding.injective]

theorem wc_blowup_ncard_nonclosed_eq : ∀ (Y X' Z : Scheme.{u}) (b : X' ⟶ Y) [IsProper b] (iZ : Z ⟶ Y) [IsClosedImmersion iZ], (∀ U : Y.Opens, (U : Set Y) = (Set.range iZ)ᶜ → IsIso (b ∣_ U)) → (∀ y : Y, y ∈ Set.range b ∨ y ∈ Set.range iZ) → (∀ z : Z, IsClosed ({z} : Set Z)) → (∀ e : ↥(Limits.pullback b iZ), IsClosed ({e} : Set ↥(Limits.pullback b iZ))) → Set.ncard {x : Y | ¬ IsClosed ({x} : Set Y)} = Set.ncard {x : X' | ¬ IsClosed ({x} : Set X')} :=
by
  intro Y X' Z b _ iZ _ hiso hcov hZ hE
  let U : Y.Opens := ⟨(Set.range iZ)ᶜ, iZ.isClosedEmbedding.isClosed_range.isOpen_compl⟩
  have hinj : ∀ x₁ x₂ : X', b x₁ ∉ Set.range iZ → b x₁ = b x₂ → x₁ = x₂ :=
    (wc_iso_over_open_inj_dim b U (hiso U rfl)).1
  have s2 : ∀ z : Z, IsClosed ({iZ z} : Set Y) := by
    intro z
    rw [← Set.image_singleton]
    exact iZ.isClosedEmbedding.isClosedMap {z} (hZ z)
  have s3 : ∀ x' : X', b x' ∈ Set.range iZ → IsClosed ({x'} : Set X') := by
    rintro x' ⟨z, hz⟩
    obtain ⟨e, he, -⟩ := Scheme.Pullback.exists_preimage_pullback x' z hz.symm
    rw [← he, ← Set.image_singleton]
    exact (Limits.pullback.fst b iZ).isClosedEmbedding.isClosedMap {e} (hE e)
  have s4 : ∀ x' : X', b x' ∉ Set.range iZ →
      (IsClosed ({x'} : Set X') ↔ IsClosed ({b x'} : Set Y)) := by
    intro x' hx'
    constructor
    · intro h
      rw [← Set.image_singleton]
      exact b.isClosedMap {x'} h
    · intro h
      have hpre : b ⁻¹' {b x'} = {x'} := by
        ext w
        simp only [Set.mem_preimage, Set.mem_singleton_iff]
        constructor
        · intro hw
          exact (hinj x' w hx' hw.symm).symm
        · rintro rfl
          rfl
      rw [← hpre]
      exact h.preimage b.continuous
  symm
  refine Set.ncard_congr (fun x _ => b x) ?_ ?_ ?_
  · intro x hx
    simp only [Set.mem_setOf_eq] at hx ⊢
    have hU : b x ∉ Set.range iZ := fun h => hx (s3 x h)
    rwa [← s4 x hU]
  · intro x₁ x₂ hx₁ _ h
    simp only [Set.mem_setOf_eq] at hx₁
    exact hinj x₁ x₂ (fun h' => hx₁ (s3 x₁ h')) h
  · intro y hy
    simp only [Set.mem_setOf_eq] at hy
    have hyZ : y ∉ Set.range iZ := by
      rintro ⟨z, rfl⟩
      exact hy (s2 z)
    rcases hcov y with ⟨x, rfl⟩ | h
    · refine ⟨x, ?_, rfl⟩
      simp only [Set.mem_setOf_eq]
      rwa [s4 x hyZ]
    · exact absurd h hyZ

theorem wc_iso_over_compl_range_cover : ∀ (Y X' Z : Scheme.{u}) (b : X' ⟶ Y) (iZ : Z ⟶ Y) [IsClosedImmersion iZ], (∀ U : Y.Opens, (U : Set Y) = (Set.range iZ)ᶜ → IsIso (b ∣_ U)) → ∀ y : Y, y ∈ Set.range b ∨ y ∈ Set.range iZ :=
by
  intro Y X' Z b iZ _ h y
  by_cases hy : y ∈ Set.range iZ
  · exact Or.inr hy
  · left
    let U : Y.Opens := ⟨(Set.range iZ)ᶜ, iZ.isClosedEmbedding.isClosed_range.isOpen_compl⟩
    haveI : IsIso (b ∣_ U) := h U rfl
    obtain ⟨z, hz⟩ := (b ∣_ U).surjective ⟨y, hy⟩
    refine ⟨z.1, ?_⟩
    rw [← morphismRestrict_base_coe, hz]

theorem wc_et_curve_h2_card_reduction : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (ℓ : ℕ), ℓ.Prime → (ℓ : Ω) ≠ 0 → (∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (Y₀ : Scheme.{u}) (f : Y₀ ⟶ Spec (.of A)) [IsProper f] (m' : ℕ), m' ≠ 0 → ∀ S : Set (Spec (.of A)), IsOpen S → S ≠ Set.univ → ∀ q' : ℕ, Subsingleton (wcEtExt Y₀ (wcEtExtZero Y₀ (f ⁻¹' S) m') q')) → (∀ (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω)) [IsProper fX], IrreducibleSpace X → (∀ x : X, IsDomain (X.presheaf.stalk x) ∧ IsIntegrallyClosed (X.presheaf.stalk x)) → topologicalKrullDim X = ((1 : ℕ) : WithBot ℕ∞) → Nat.card (wcEtCoh X ℓ 2) = ℓ) → ∀ (C : Scheme.{u}) (fC : C ⟶ Spec (.of Ω)) [IsProper fC], topologicalKrullDim C ≤ ((1 : ℕ) : WithBot ℕ∞) → Nat.card (wcEtCoh C ℓ 2) = ℓ ^ Set.ncard {x : C | ¬ IsClosed ({x} : Set C)} :=
by
  intro Ω _ _ ℓ hℓ hℓΩ hPBC hnorm C fC _ hC
  classical
  have hℓ0 : ℓ ≠ 0 := hℓ.ne_zero

  have hne : ∀ (Y : Scheme.{u}) (q : ℕ), Nonempty (wcEtCoh Y ℓ q) := by
    intro Y q
    unfold wcEtCoh
    exact ⟨0⟩
  have hcard1 : ∀ (Y : Scheme.{u}) (q : ℕ), Subsingleton (wcEtCoh Y ℓ q) →
      Nat.card (wcEtCoh Y ℓ q) = 1 := by
    intro Y q hs
    haveI := hs
    obtain ⟨a⟩ := hne Y q
    exact Nat.card_of_subsingleton a

  have s3 : ∀ x : WithBot ℕ∞, x ≤ ((1 : ℕ) : WithBot ℕ∞) → ¬ x ≤ ((0 : ℕ) : WithBot ℕ∞) →
      x = ((1 : ℕ) : WithBot ℕ∞) := by
    intro x h1 h0
    induction x using WithBot.recBotCoe with
    | bot => exact absurd bot_le h0
    | coe y =>
      induction y using ENat.recTopCoe with
      | top =>
        exfalso
        have : ((⊤ : ℕ∞) : WithBot ℕ∞) ≤ ((1 : ℕ∞) : WithBot ℕ∞) := by exact_mod_cast h1
        have h2 : (⊤ : ℕ∞) ≤ 1 := WithBot.coe_le_coe.mp this
        simp at h2
      | coe n =>
        have h1' : n ≤ 1 := by exact_mod_cast h1
        have h0' : ¬ n ≤ 0 := fun h => h0 (by exact_mod_cast h)
        have hn : n = 1 := by omega
        subst hn
        rfl

  have hc0 : ∀ (Y : Scheme.{u}), topologicalKrullDim Y ≤ ((0 : ℕ) : WithBot ℕ∞) →
      Set.ncard {x : Y | ¬ IsClosed ({x} : Set Y)} = 0 := by
    intro Y hY
    have h : {x : Y | ¬ IsClosed ({x} : Set Y)} = ∅ := by
      ext x
      simp only [Set.mem_setOf_eq, Set.mem_empty_iff_false, iff_false, not_not]
      exact wc_top_dim_nonpos_isClosed_singleton _ hY x
    rw [h, Set.ncard_empty]

  have hdimEmpty : ∀ (Y : Scheme.{u}), IsEmpty Y →
      topologicalKrullDim Y ≤ ((0 : ℕ) : WithBot ℕ∞) := by
    intro Y hY
    have h : topologicalKrullDim Y = ⊥ := by
      unfold topologicalKrullDim
      rw [Order.krullDim_eq_bot_iff]
      exact ⟨fun s => by
        obtain ⟨x, _⟩ := s.2.nonempty
        exact hY.false x⟩
    rw [h]
    exact bot_le

  have G1 : ∀ (n : ℕ) (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω)) [IsProper fX],
      (irreducibleComponents X).ncard = n →
      (∀ x : X, IsDomain (X.presheaf.stalk x) ∧ IsIntegrallyClosed (X.presheaf.stalk x)) →
      topologicalKrullDim X ≤ ((1 : ℕ) : WithBot ℕ∞) →
      Nat.card (wcEtCoh X ℓ 2) = ℓ ^ Set.ncard {x : X | ¬ IsClosed ({x} : Set X)} := by
    intro n
    induction n using Nat.strong_induction_on with
    | _ n IH =>
      intro X fX _ hn hnormX hX
      by_cases hE : IsEmpty X
      · have h0 := hdimEmpty X hE
        rw [hcard1 X 2 (wc_et_zero_dim_vanishing Ω X fX h0 ℓ hℓ0 2 (by norm_num)), hc0 X h0,
          pow_zero]
      · haveI : Nonempty X := not_isEmpty_iff.mp hE
        obtain ⟨Z, iZ, X', b, hiZ, hb, hiso, hdisj, hirr, hnZ, hnX', hdZ, hdX', hcard⟩ :=
          wc_normal_split_component Ω X fX hnormX inferInstance
        haveI := hiZ
        haveI := hb
        have hcov := wc_iso_over_compl_range_cover X X' Z b iZ hiso

        have hoU : IsOpen (Set.range iZ)ᶜ := iZ.isClosedEmbedding.isClosed_range.isOpen_compl
        have hoU' : IsOpen (Set.range b)ᶜ := b.isClosedEmbedding.isClosed_range.isOpen_compl
        have hdUU : Disjoint (Set.range iZ)ᶜ (Set.range b)ᶜ := by
          rw [Set.disjoint_left]
          intro x h1 h2
          rcases hcov x with h | h
          · exact h2 h
          · exact h1 h
        have hunion : (Set.range iZ)ᶜ ∪ (Set.range b)ᶜ = Set.univ := by
          apply Set.eq_univ_of_forall
          intro x
          by_cases h : x ∈ Set.range iZ
          · right
            intro hb'
            exact Set.disjoint_left.mp hdisj hb' h
          · left
            exact h

        have hiso2 := wc_et_extZero_clopen_biprod_iso X _ _ hoU hoU' hdUU hunion ℓ
        have hsplit : Nat.card (wcEtCoh X ℓ 2) =
            Nat.card (wcEtCoh X' ℓ 2) * Nat.card (wcEtCoh Z ℓ 2) := by
          have e1 : Nonempty (wcEtCoh X ℓ 2 ≃
              wcEtExt X (Limits.cokernel (wcEtExtZeroι X (Set.range b)ᶜ ℓ)) 2 ×
                wcEtExt X (Limits.cokernel (wcEtExtZeroι X (Set.range iZ)ᶜ ℓ)) 2) := by
            unfold wcEtCoh wcEtExt Sheaf.H
            letI : HasExt (Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) :=
              HasExt.standard _
            exact wc_ext_biprod_desc_iso_prod _ _ _ _ _ _ hiso2 2
          obtain ⟨e1⟩ := e1
          obtain ⟨eb⟩ := wc_et_closed_complement_coh X X' b ℓ 2
          obtain ⟨ez⟩ := wc_et_closed_complement_coh X Z iZ ℓ 2
          rw [Nat.card_congr (e1.trans (eb.prodCongr ez)), Nat.card_prod]

        have hX' := IH _ (by omega) X' (b ≫ fX) rfl hnX' (hdX'.trans hX)

        have hZ : Nat.card (wcEtCoh Z ℓ 2) = ℓ ^ Set.ncard {x : Z | ¬ IsClosed ({x} : Set Z)} := by
          by_cases h0 : topologicalKrullDim Z ≤ ((0 : ℕ) : WithBot ℕ∞)
          · rw [hcard1 Z 2 (wc_et_zero_dim_vanishing Ω Z (iZ ≫ fX) h0 ℓ hℓ0 2 (by norm_num)),
              hc0 Z h0, pow_zero]
          · have h1 : topologicalKrullDim Z = ((1 : ℕ) : WithBot ℕ∞) := s3 _ (hdZ.trans hX) h0
            haveI := hirr
            rw [hnorm Z (iZ ≫ fX) hirr hnZ h1, wc_top_irreducible_dim_one_ncard _ h1, pow_one]

        have hcount := wc_clopen_split_ncard_add X X' Z b iZ hcov hdisj
          (wc_proper_curve_nonclosed_finite Ω X' (b ≫ fX) (hdX'.trans hX))
          (wc_proper_curve_nonclosed_finite Ω Z (iZ ≫ fX) (hdZ.trans hX))
        rw [hsplit, hX', hZ, hcount, pow_add]

  have G2 : ∀ (R : Scheme.{u}) (fR : R ⟶ Spec (.of Ω)) [IsProper fR] [IsReduced R],
      topologicalKrullDim R ≤ ((1 : ℕ) : WithBot ℕ∞) →
      Nat.card (wcEtCoh R ℓ 2) = ℓ ^ Set.ncard {x : R | ¬ IsClosed ({x} : Set R)} := by
    intro R fR _ _ hR
    obtain ⟨X', b, Z, iZ, hb, hiZ, hiso, hn, hdX', hdZ, hdE⟩ :=
      wc_reduced_curve_normalization Ω R fR hR
    haveI := hb
    haveI := hiZ
    have hZv : ∀ q, 0 < q → Subsingleton (wcEtCoh Z ℓ q) := fun q hq =>
      wc_et_zero_dim_vanishing Ω Z (iZ ≫ fR) hdZ ℓ hℓ0 q hq
    have hEv : ∀ q, 0 < q → Subsingleton (wcEtCoh (Limits.pullback b iZ) ℓ q) := fun q hq =>
      wc_et_zero_dim_vanishing Ω (Limits.pullback b iZ) (Limits.pullback.snd b iZ ≫ iZ ≫ fR)
        hdE ℓ hℓ0 q hq
    obtain ⟨e⟩ := wc_et_abstract_blowup_coh_equiv R X' Z b iZ hiso ℓ hℓ0 hPBC 2
      (fun q' hq' => hZv q' (by omega)) (hZv 2 (by norm_num))
      (fun q' hq' => hEv q' (by omega)) (hEv 2 (by norm_num))
    rw [Nat.card_congr e, G1 _ X' (b ≫ fR) rfl hn hdX',
      wc_blowup_ncard_nonclosed_eq R X' Z b iZ hiso (wc_iso_over_compl_range_cover R X' Z b iZ hiso)
        (wc_top_dim_nonpos_isClosed_singleton _ hdZ) (wc_top_dim_nonpos_isClosed_singleton _ hdE)]

  obtain ⟨R, r, hr, hsurj, hred⟩ := wc_reduced_subscheme_exists C
  haveI := hr
  haveI := hred
  have hdimR : topologicalKrullDim R = topologicalKrullDim C :=
    IsHomeomorph.topologicalKrullDim_eq r (isHomeomorph_iff_isEmbedding_surjective.mpr
      ⟨r.isClosedEmbedding.isEmbedding, Set.range_eq_univ.mp hsurj⟩)
  have hFR := G2 R (r ≫ fC) (by rw [hdimR]; exact hC)

  have hcoh : Nat.card (wcEtCoh C ℓ 2) = Nat.card (wcEtCoh R ℓ 2) := by
    obtain ⟨e1⟩ := wc_et_coh_iso_invariance (Limits.pullback.fst (𝟙 C) (𝟙 C)) ℓ 2
    obtain ⟨e2⟩ := wc_et_coh_iso_invariance (Limits.pullback.fst (r ≫ 𝟙 C) (𝟙 C)) ℓ 2
    rw [Nat.card_congr e1, Nat.card_congr e2]
    exact (wc_et_fibre_coh_reduced_invariance C C C R (𝟙 C) r hsurj (𝟙 C) ℓ 2).symm

  have hcnt : Set.ncard {x : C | ¬ IsClosed ({x} : Set C)} =
      Set.ncard {x : R | ¬ IsClosed ({x} : Set R)} := by
    have hce := r.isClosedEmbedding
    have key : ∀ x : R, IsClosed ({x} : Set R) ↔ IsClosed ({r x} : Set C) := by
      intro x
      rw [hce.isClosed_iff_image_isClosed, Set.image_singleton]
    symm
    refine Set.ncard_congr (fun x _ => r x) ?_ ?_ ?_
    · intro x hx
      simp only [Set.mem_setOf_eq] at hx ⊢
      rwa [← key]
    · intro a a' _ _ haa
      exact hce.isEmbedding.injective haa
    · intro y hy
      obtain ⟨x, rfl⟩ : y ∈ Set.range r := by rw [hsurj]; trivial
      refine ⟨x, ?_, rfl⟩
      simp only [Set.mem_setOf_eq] at hy ⊢
      rwa [key]
  rw [hcoh, hFR, hcnt]

theorem wc_sep_affine_cover_inter : ∀ (X : Scheme.{u}) [IsSeparated (Limits.terminal.from X)] (O : X.Opens), IsCompact (O : Set X) → ∃ (m : ℕ) (U : Fin m → X.Opens) (UT : Finset (Fin m) → X.Opens), (∀ i, U i ≤ O) ∧ (⋃ i, (U i : Set X)) = (O : Set X) ∧ ∀ T : Finset (Fin m), T.Nonempty → IsAffineOpen (UT T) ∧ (UT T : Set X) = ⋂ i ∈ T, (U i : Set X) :=
by
  intro X _ O hO
  classical
  obtain ⟨s, hs, hOeq⟩ := (isCompact_iff_finite_and_eq_biUnion_affineOpens).mp hO
  let t := hs.toFinset
  let e : ↥t ≃ Fin t.card := t.equivFin
  let V : Fin t.card → X.affineOpens := fun k => ((e.symm k : ↥t) : X.affineOpens)
  have hVs : ∀ k, V k ∈ s := fun k => hs.mem_toFinset.mp (e.symm k).2
  have hVaff : ∀ k, IsAffineOpen (V k : X.Opens) := fun k => (V k).2
  have hVle : ∀ k, (V k : X.Opens) ≤ O := by
    intro k
    rw [hOeq]
    exact le_iSup₂ (f := fun (i : X.affineOpens) (_ : i ∈ s) => (i : X.Opens)) (V k) (hVs k)
  refine ⟨t.card, fun k => (V k : X.Opens), fun T => T.inf (fun k => (V k : X.Opens)),
    hVle, ?_, ?_⟩
  · apply Set.eq_of_subset_of_subset
    · intro x hx
      obtain ⟨k, hk⟩ := Set.mem_iUnion.mp hx
      exact (SetLike.le_def.mp (hVle k)) hk
    · intro x hx
      have hx' : x ∈ (⨆ i ∈ s, (i : X.Opens)) := by rw [← hOeq]; exact hx
      rw [TopologicalSpace.Opens.mem_iSup] at hx'
      obtain ⟨a, ha⟩ := hx'
      rw [TopologicalSpace.Opens.mem_iSup] at ha
      obtain ⟨has, hxa⟩ := ha
      refine Set.mem_iUnion.mpr ⟨e ⟨a, hs.mem_toFinset.mpr has⟩, ?_⟩
      show x ∈ ((V (e ⟨a, hs.mem_toFinset.mpr has⟩)) : X.Opens)
      simp only [V, Equiv.symm_apply_apply]
      exact hxa
  · intro T hT
    constructor
    · show IsAffineOpen (T.inf fun k => (V k : X.Opens))
      induction hT using Finset.Nonempty.cons_induction with
      | singleton a => rw [Finset.inf_singleton]; exact hVaff a
      | cons a T h hT ih => rw [Finset.inf_cons]; exact (hVaff a).inf ih
    · rw [TopologicalSpace.Opens.coe_finset_inf, Finset.inf_set_eq_iInter]
      rfl

theorem wc_jacobson_nonclosed_incl_excl : ∀ (Y : Type u) [TopologicalSpace Y] [JacobsonSpace Y] (m : ℕ) (U : Fin m → Set Y), (∀ i, IsOpen (U i)) → (⋃ i, U i) = Set.univ → (∀ T : Finset (Fin m), T.Nonempty → Set.Finite {x : ↥(⋂ i ∈ T, U i) | ¬ IsClosed ({x} : Set ↥(⋂ i ∈ T, U i))}) → (Set.ncard {x : Y | ¬ IsClosed ({x} : Set Y)} : ℤ) = ∑ T ∈ (Finset.univ : Finset (Finset (Fin m))).filter (fun T => T.Nonempty), (-1) ^ (T.card + 1) * (Set.ncard {x : ↥(⋂ i ∈ T, U i) | ¬ IsClosed ({x} : Set ↥(⋂ i ∈ T, U i))} : ℤ) :=
by
  classical
  intro Y _ _ m U hU hcov hfin

  have s1 : ∀ W : Set Y, IsOpen W → Subtype.val '' {x : ↥W | ¬ IsClosed ({x} : Set ↥W)} =
      {y : Y | ¬ IsClosed ({y} : Set Y)} ∩ W := by
    intro W hW
    have e := (hW.isOpenEmbedding_subtypeVal).preimage_closedPoints
    have key : ∀ x : W, IsClosed ({x} : Set W) ↔ IsClosed ({(x : Y)} : Set Y) := by
      intro x
      have h1 : x ∈ Subtype.val ⁻¹' closedPoints Y ↔ x ∈ closedPoints W := by rw [e]
      rw [Set.mem_preimage, mem_closedPoints_iff, mem_closedPoints_iff] at h1
      exact h1.symm
    ext y
    simp only [Set.mem_image, Set.mem_setOf_eq, Set.mem_inter_iff]
    constructor
    · rintro ⟨x, hx, rfl⟩
      exact ⟨fun h => hx ((key x).mpr h), x.2⟩
    · rintro ⟨hy, hyW⟩
      exact ⟨⟨y, hyW⟩, fun h => hy ((key ⟨y, hyW⟩).mp h), rfl⟩
  have hWopen : ∀ T : Finset (Fin m), IsOpen (⋂ i ∈ T, U i) :=
    fun T => isOpen_biInter_finset (fun i _ => hU i)
  have hmemU : ∀ y : Y, ∃ i, y ∈ U i := by
    intro y
    have : y ∈ ⋃ i, U i := by rw [hcov]; trivial
    exact Set.mem_iUnion.mp this

  have hAfin : Set.Finite {y : Y | ¬ IsClosed ({y} : Set Y)} := by
    have hsub : {y : Y | ¬ IsClosed ({y} : Set Y)} ⊆ ⋃ i : Fin m, Subtype.val ''
        {x : ↥(⋂ j ∈ ({i} : Finset (Fin m)), U j) |
          ¬ IsClosed ({x} : Set ↥(⋂ j ∈ ({i} : Finset (Fin m)), U j))} := by
      intro y hy
      obtain ⟨i, hi⟩ := hmemU y
      refine Set.mem_iUnion.mpr ⟨i, ?_⟩
      rw [s1 _ (hWopen _)]
      exact ⟨hy, by simpa using hi⟩
    exact (Set.finite_iUnion (fun i =>
      (hfin {i} (Finset.singleton_nonempty i)).image _)).subset hsub

  have s2 : ∀ A : Set Y, A.Finite → (A.ncard : ℤ) =
      ∑ T ∈ (Finset.univ : Finset (Finset (Fin m))).filter (fun T => T.Nonempty),
        (-1) ^ (T.card + 1) * ((A ∩ ⋂ i ∈ T, U i).ncard : ℤ) := by
    intro A hA
    let S : Fin m → Finset Y := fun i => hA.toFinset.filter (· ∈ U i)
    have ha : Finset.univ.biUnion S = hA.toFinset := by
      ext x
      simp only [Finset.mem_biUnion, Finset.mem_univ, true_and, S, Finset.mem_filter]
      constructor
      · rintro ⟨i, h, _⟩; exact h
      · intro h
        obtain ⟨i, hi⟩ := hmemU x
        exact ⟨i, h, hi⟩
    have hb : (A.ncard : ℤ) = (hA.toFinset.card : ℤ) := by
      rw [Set.ncard_eq_toFinset_card A hA]
    have hd : ∀ (t : Finset (Fin m)) (h : t.Nonempty),
        (t.inf' h S).card = (A ∩ ⋂ i ∈ t, U i).ncard := by
      intro t h
      rw [← Set.ncard_coe_finset]
      congr 1
      ext x
      simp only [Finset.mem_coe, Finset.mem_inf', S, Finset.mem_filter, Set.Finite.mem_toFinset,
        Set.mem_inter_iff, Set.mem_iInter₂]
      obtain ⟨i₀, hi₀⟩ := h
      constructor
      · intro hx
        exact ⟨(hx i₀ hi₀).1, fun i hi => (hx i hi).2⟩
      · rintro ⟨hxA, hx⟩ i hi
        exact ⟨hxA, hx i hi⟩
    have hc := Finset.inclusion_exclusion_card_biUnion (s := Finset.univ) S
    rw [hb, ← ha, hc]
    trans ∑ t : ↥((Finset.univ : Finset (Fin m)).powerset.filter (·.Nonempty)),
        (-1 : ℤ) ^ (t.1.card + 1) * ((A ∩ ⋂ i ∈ t.1, U i).ncard : ℤ)
    · refine Finset.sum_congr rfl (fun t _ => ?_)
      rw [hd]
    · rw [Finset.sum_coe_sort ((Finset.univ : Finset (Fin m)).powerset.filter (·.Nonempty))
        (fun T => (-1 : ℤ) ^ (T.card + 1) * ((A ∩ ⋂ i ∈ T, U i).ncard : ℤ)),
        Finset.powerset_univ]

  rw [s2 _ hAfin]
  refine Finset.sum_congr rfl (fun T _ => ?_)
  rw [← s1 _ (hWopen T), Set.ncard_image_of_injective _ Subtype.val_injective]

theorem wc_point_into_affine_factor : ∀ (S : Scheme.{u}) (V : S.Opens) (hV : IsAffineOpen V) (Ω : Type u) [Field Ω] (t : Spec (.of Ω) ⟶ S), Set.range t ⊆ (V : Set S) → ∃ ψ : Γ(S, V) →+* Ω, t = Spec.map (CommRingCat.ofHom ψ) ≫ hV.fromSpec ∧ ∀ a : Γ(S, V), ψ a ≠ 0 ↔ t (IsLocalRing.closedPoint Ω) ∈ (S.basicOpen a : Set S) :=
by
  intro S V hV Ω _ t h
  haveI : IsOpenImmersion hV.fromSpec := hV.isOpenImmersion_fromSpec
  have H' : Set.range t ⊆ Set.range hV.fromSpec := by
    rw [hV.range_fromSpec]; exact h
  set l := IsOpenImmersion.lift hV.fromSpec t H' with hl_def
  have hl : l ≫ hV.fromSpec = t := IsOpenImmersion.lift_fac _ _ _
  refine ⟨(Spec.preimage l).hom, ?_, fun a => ?_⟩
  · rw [CommRingCat.ofHom_hom, Spec.map_preimage, hl]
  · have ht : t = Spec.map (CommRingCat.ofHom (Spec.preimage l).hom) ≫ hV.fromSpec := by
      rw [CommRingCat.ofHom_hom, Spec.map_preimage, hl]
    have key : ∀ x : ↥(Spec (.of Ω)), x.asIdeal = IsLocalRing.maximalIdeal Ω →
        ((Spec.preimage l).hom a ≠ 0 ↔ t x ∈ (S.basicOpen a : Set S)) := by
      intro x hx
      rw [ht, Scheme.Hom.comp_apply, SetLike.mem_coe, ← Scheme.Hom.mem_preimage,
        hV.fromSpec_preimage_basicOpen]
      change _ ↔ a ∉ Ideal.comap (Spec.preimage l).hom x.asIdeal
      rw [Ideal.mem_comap, hx, IsLocalRing.maximalIdeal_eq_bot, Ideal.mem_bot]
    exact key (IsLocalRing.closedPoint Ω) rfl

theorem wc_affine_piece_geom_fibre_homeo : ∀ (S X : Scheme.{u}) (g : X ⟶ S) (V : S.Opens) (U : X.Opens) (hV : IsAffineOpen V) (hU : IsAffineOpen U) (hUV : U ≤ g ⁻¹ᵁ V) (Ω : Type u) [Field Ω] (ψ : Γ(S, V) →+* Ω) (t : Spec (.of Ω) ⟶ S), t = Spec.map (CommRingCat.ofHom ψ) ≫ hV.fromSpec → letI := (g.appLE V U hUV).hom.toAlgebra; letI := ψ.toAlgebra; Nonempty (↥((Limits.pullback.fst g t) ⁻¹' (U : Set X)) ≃ₜ PrimeSpectrum (TensorProduct Γ(S, V) Γ(X, U) Ω)) :=
by
  intro S X g V U hV hU hUV Ω _ ψ t ht
  letI := (g.appLE V U hUV).hom.toAlgebra
  letI := ψ.toAlgebra
  have H1 : IsPullback (Limits.pullback.fst g t ∣_ U)
      ((Limits.pullback.fst g t ⁻¹ᵁ U).ι ≫ Limits.pullback.snd g t) (U.ι ≫ g) t :=
    (isPullback_morphismRestrict (Limits.pullback.fst g t) U).paste_vert
      (IsPullback.of_hasPullback g t)
  have H20 : IsPullback
      (Limits.pullback.fst (Spec.map (g.appLE V U hUV)) (Spec.map (CommRingCat.ofHom ψ)))
      (Limits.pullback.snd (Spec.map (g.appLE V U hUV)) (Spec.map (CommRingCat.ofHom ψ)))
      (Spec.map (g.appLE V U hUV) ≫ hV.fromSpec)
      (Spec.map (CommRingCat.ofHom ψ) ≫ hV.fromSpec) :=
    IsPullback.of_isLimit (Limits.pullbackIsPullbackOfCompMono _ _ hV.fromSpec)
  have H2 : IsPullback
      (Limits.pullback.fst (Spec.map (g.appLE V U hUV)) (Spec.map (CommRingCat.ofHom ψ)) ≫
        hU.isoSpec.inv)
      (Limits.pullback.snd (Spec.map (g.appLE V U hUV)) (Spec.map (CommRingCat.ofHom ψ)))
      (U.ι ≫ g) t :=
    IsPullback.of_iso H20 (Iso.refl _) hU.isoSpec.symm (Iso.refl _) (Iso.refl _)
      (by simp) (by simp)
      (by
        rw [Iso.refl_hom, Category.comp_id, Iso.symm_hom, ← Category.assoc,
          IsAffineOpen.isoSpec_inv_ι, IsAffineOpen.SpecMap_appLE_fromSpec g hV hU hUV])
      (by rw [Iso.refl_hom, Iso.refl_hom, Category.comp_id, Category.id_comp, ht])
  let e₁ := IsPullback.isoIsPullback _ _ H1 H2
  let e₂ : Limits.pullback (Spec.map (g.appLE V U hUV)) (Spec.map (CommRingCat.ofHom ψ)) ≅
      Spec (.of (TensorProduct Γ(S, V) Γ(X, U) Ω)) :=
    pullbackSpecIso Γ(S, V) Γ(X, U) Ω
  exact ⟨Scheme.homeoOfIso (e₁ ≪≫ e₂)⟩

theorem wc_generic_point_mem_basicOpen : ∀ (S : Scheme.{u}) [IsIntegral S] (V : S.Opens) (a : Γ(S, V)), a ≠ 0 → genericPoint S ∈ (S.basicOpen a : Set S) :=
by
  intro S _ V a ha
  have hne : S.basicOpen a ≠ ⊥ := fun h => ha ((AlgebraicGeometry.basicOpen_eq_bot_iff a).mp h)
  have hnon := (TopologicalSpace.Opens.ne_bot_iff_nonempty _).mp hne
  exact ((genericPoint_spec S).mem_open_set_iff (S.basicOpen a).isOpen).mpr (by simpa using hnon)

theorem wc_alg_fin_generic_fibre_no_nonmax : ∀ (A C : Type u) [CommRing A] [IsDomain A] [CommRing C] [Algebra A C] [Algebra.FiniteType A C], Module.Finite (FractionRing A) (TensorProduct A (FractionRing A) C) → ∃ a : A, a ≠ 0 ∧ ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (ψ : A →+* Ω), ψ a ≠ 0 → letI := ψ.toAlgebra; ∀ q : PrimeSpectrum (TensorProduct A C Ω), q.asIdeal.IsMaximal :=
by
  intro A C _ _ _ _ _ hfin
  classical

  have hrel : ∀ c : C, ∃ r : Polynomial A, r ≠ 0 ∧ Polynomial.aeval c r = 0 := by
    intro c
    haveI := Algebra.IsIntegral.of_finite (FractionRing A) (TensorProduct A (FractionRing A) C)
    obtain ⟨p, hpm, hp⟩ := Algebra.IsIntegral.isIntegral (R := FractionRing A)
      ((1 : FractionRing A) ⊗ₜ[A] c)
    have hp' : Polynomial.aeval ((1 : FractionRing A) ⊗ₜ[A] c) p = 0 := by
      rw [Polynomial.aeval_def]; exact hp
    have hq := IsLocalization.integerNormalization_aeval_eq_zero (nonZeroDivisors A) p hp'
    set q := IsLocalization.integerNormalization (nonZeroDivisors A) p with hqdef
    have hq0 : q ≠ 0 := by
      rw [hqdef, Ne, IsLocalization.integerNormalization_eq_zero_iff (le_refl _)]
      exact hpm.ne_zero
    haveI hloc : IsLocalizedModule (nonZeroDivisors A)
        (TensorProduct.mk A (FractionRing A) C 1) :=
      (isLocalizedModule_iff_isBaseChange (nonZeroDivisors A) (FractionRing A)
        (TensorProduct.mk A (FractionRing A) C 1)).mpr
        (TensorProduct.isBaseChange A C (FractionRing A))
    have h0 : (TensorProduct.mk A (FractionRing A) C 1) (Polynomial.aeval c q) = 0 := by
      rw [TensorProduct.mk_apply,
        ← Algebra.TensorProduct.includeRight_apply (R := A) (A := FractionRing A),
        ← Polynomial.aeval_algHom_apply, Algebra.TensorProduct.includeRight_apply]
      exact hq
    obtain ⟨s, hs⟩ := (IsLocalizedModule.eq_zero_iff (nonZeroDivisors A) _).mp h0
    refine ⟨Polynomial.C (s : A) * q, ?_, ?_⟩
    · exact mul_ne_zero (Polynomial.C_ne_zero.mpr (nonZeroDivisors.ne_zero s.2)) hq0
    · rw [map_mul, Polynomial.aeval_C, ← Algebra.smul_def]
      exact hs

  obtain ⟨S, hS⟩ := (Algebra.FiniteType.out : (⊤ : Subalgebra A C).FG)
  choose r hr0 hr using hrel
  refine ⟨∏ c ∈ S, (r c).leadingCoeff, ?_, ?_⟩
  · exact Finset.prod_ne_zero_iff.mpr (fun c _ => Polynomial.leadingCoeff_ne_zero.mpr (hr0 c))
  intro Ω _ _ ψ hψ
  letI := ψ.toAlgebra
  have hℓ : ∀ c ∈ S, ψ (r c).leadingCoeff ≠ 0 := by
    rw [map_prod] at hψ
    exact Finset.prod_ne_zero_iff.mp hψ

  set f : Ω →+* TensorProduct A C Ω :=
    (Algebra.TensorProduct.includeRight : Ω →ₐ[A] TensorProduct A C Ω).toRingHom with hf
  have hfψ : f.comp ψ = algebraMap A (TensorProduct A C Ω) :=
    AlgHom.comp_algebraMap (Algebra.TensorProduct.includeRight : Ω →ₐ[A] TensorProduct A C Ω)
  have hfω : ∀ ω : Ω, f ω = (1 : C) ⊗ₜ[A] ω := fun ω => rfl
  have hgen : ∀ c ∈ S, f.IsIntegralElem (c ⊗ₜ[A] (1 : Ω)) := by
    intro c hc
    have hlc : (Polynomial.map ψ (r c)).leadingCoeff = ψ (r c).leadingCoeff :=
      Polynomial.leadingCoeff_map_of_leadingCoeff_ne_zero ψ (hℓ c hc)
    have hne : Polynomial.map ψ (r c) ≠ 0 := by
      rw [← Polynomial.leadingCoeff_ne_zero, hlc]; exact hℓ c hc
    refine ⟨Polynomial.map ψ (r c) * Polynomial.C (ψ (r c).leadingCoeff)⁻¹, ?_, ?_⟩
    · rw [← hlc]; exact Polynomial.monic_mul_leadingCoeff_inv hne
    · rw [Polynomial.eval₂_mul_C' _ _ (Commute.all _ _), Polynomial.eval₂_map, hfψ]
      have h1 : Polynomial.eval₂ (algebraMap A (TensorProduct A C Ω)) (c ⊗ₜ[A] (1 : Ω)) (r c)
          = 0 := by
        rw [← Polynomial.aeval_def, ← Algebra.TensorProduct.includeLeft_apply (S := A),
          Polynomial.aeval_algHom_apply, hr c, map_zero]
      rw [h1, zero_mul]
  have hC : ∀ x : C, f.IsIntegralElem (x ⊗ₜ[A] (1 : Ω)) := by
    intro x
    have hx : x ∈ Algebra.adjoin A (S : Set C) := by rw [hS]; exact Algebra.mem_top
    induction hx using Algebra.adjoin_induction with
    | mem x hx => exact hgen x hx
    | algebraMap a =>
      have h2 : (algebraMap A C a) ⊗ₜ[A] (1 : Ω) = f (ψ a) := by
        rw [← RingHom.comp_apply, hfψ, Algebra.TensorProduct.algebraMap_apply]
      rw [h2]; exact f.isIntegralElem_map
    | add x y _ _ hx hy =>
      rw [TensorProduct.add_tmul]; exact RingHom.IsIntegralElem.add f hx hy
    | mul x y _ _ hx hy =>
      have h3 : (x * y) ⊗ₜ[A] (1 : Ω) = (x ⊗ₜ[A] (1 : Ω)) * (y ⊗ₜ[A] (1 : Ω)) := by
        rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one]
      rw [h3]; exact RingHom.IsIntegralElem.mul f hx hy
  have hint : f.IsIntegral := by
    intro z
    induction z using TensorProduct.induction_on with
    | zero => exact f.isIntegralElem_zero
    | tmul x ω =>
      have h4 : x ⊗ₜ[A] ω = (x ⊗ₜ[A] (1 : Ω)) * f ω := by
        rw [hfω, Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
      rw [h4]; exact RingHom.IsIntegralElem.mul f (hC x) f.isIntegralElem_map
    | add x y hx hy => exact RingHom.IsIntegralElem.add f hx hy

  intro q
  have hbot : (Ideal.comap f q.asIdeal).IsMaximal := by
    rw [Ideal.eq_bot_of_prime (Ideal.comap f q.asIdeal)]
    exact Ideal.bot_isMaximal
  exact Ideal.isMaximal_of_isIntegral_of_isMaximal_comap f hint q.asIdeal hbot

theorem wc_alg_nonmax_count_surj : ∀ (R : Type u) [CommRing R] (m : ℕ) (S : Fin m → Type u) [∀ j, CommRing (S j)] (f : ∀ j, R →+* S j), (∀ j, Function.Surjective (f j)) → (∀ P : Ideal R, P.IsPrime → ∃ j, RingHom.ker (f j) ≤ P) → (∀ j k, j ≠ k → ∀ P : Ideal R, P.IsPrime → RingHom.ker (f j) ≤ P → RingHom.ker (f k) ≤ P → P.IsMaximal) → ∀ n : Fin m → ℕ, (∀ j, Set.Finite {q : PrimeSpectrum (S j) | ¬ q.asIdeal.IsMaximal} ∧ Set.ncard {q : PrimeSpectrum (S j) | ¬ q.asIdeal.IsMaximal} = n j) → Set.Finite {q : PrimeSpectrum R | ¬ q.asIdeal.IsMaximal} ∧ Set.ncard {q : PrimeSpectrum R | ¬ q.asIdeal.IsMaximal} = ∑ j, n j :=
by
  classical
  intro R _ m S _ f hsurj hcover hpair n hn
  have hinj : ∀ j, Function.Injective (PrimeSpectrum.comap (f j)) := fun j =>
    PrimeSpectrum.comap_injective_of_surjective (f j) (hsurj j)
  have hmax : ∀ j (q : PrimeSpectrum (S j)),
      (Ideal.comap (f j) q.asIdeal).IsMaximal ↔ q.asIdeal.IsMaximal := by
    intro j q
    constructor
    · intro hM
      have h1 := Ideal.map_eq_top_or_isMaximal_of_surjective (f j) (hsurj j) hM
      rw [Ideal.map_comap_of_surjective (f j) (hsurj j)] at h1
      exact h1.resolve_left q.isPrime.ne_top
    · intro hq
      haveI := hq
      exact Ideal.comap_isMaximal_of_surjective (f j) (hsurj j)
  have hker : ∀ j (q : PrimeSpectrum (S j)),
      RingHom.ker (f j) ≤ Ideal.comap (f j) q.asIdeal := by
    intro j q x hx
    rw [Ideal.mem_comap, RingHom.mem_ker.mp hx]
    exact q.asIdeal.zero_mem
  have himg : ∀ j (P : PrimeSpectrum R), RingHom.ker (f j) ≤ P.asIdeal →
      ∃ q : PrimeSpectrum (S j), Ideal.comap (f j) q.asIdeal = P.asIdeal := by
    intro j P hP
    haveI hPr : (Ideal.map (f j) P.asIdeal).IsPrime := Ideal.map_isPrime_of_surjective (hsurj j) hP
    refine ⟨⟨Ideal.map (f j) P.asIdeal, hPr⟩, ?_⟩
    show Ideal.comap (f j) (Ideal.map (f j) P.asIdeal) = P.asIdeal
    rw [Ideal.comap_map_of_surjective' (f j) (hsurj j), sup_eq_left.mpr hP]
  obtain ⟨N, hN⟩ : ∃ N : Fin m → Set (PrimeSpectrum R), ∀ j, N j =
      (PrimeSpectrum.comap (f j)) '' {q : PrimeSpectrum (S j) | ¬ q.asIdeal.IsMaximal} :=
    ⟨_, fun j => rfl⟩
  have hNmem : ∀ j P, P ∈ N j ↔ ∃ q : PrimeSpectrum (S j), ¬ q.asIdeal.IsMaximal ∧
      Ideal.comap (f j) q.asIdeal = P.asIdeal := by
    intro j P
    rw [hN j, Set.mem_image]
    constructor
    · rintro ⟨q, hq, rfl⟩
      exact ⟨q, hq, rfl⟩
    · rintro ⟨q, hq, hqP⟩
      exact ⟨q, hq, PrimeSpectrum.ext hqP⟩
  have hU : {q : PrimeSpectrum R | ¬ q.asIdeal.IsMaximal} =
      ⋃ j ∈ (Set.univ : Set (Fin m)), N j := by
    ext P
    simp only [Set.mem_setOf_eq, Set.biUnion_univ, Set.mem_iUnion]
    constructor
    · intro hP
      obtain ⟨j, hj⟩ := hcover P.asIdeal P.isPrime
      obtain ⟨q, hq⟩ := himg j P hj
      refine ⟨j, (hNmem j P).mpr ⟨q, ?_, hq⟩⟩
      intro hqm
      apply hP
      rw [← hq]
      exact (hmax j q).mpr hqm
    · rintro ⟨j, hj⟩ hP
      obtain ⟨q, hq, hqP⟩ := (hNmem j P).mp hj
      apply hq
      apply (hmax j q).mp
      rw [hqP]
      exact hP
  have hdisj : (Set.univ : Set (Fin m)).PairwiseDisjoint N := by
    intro j _ k _ hjk
    rw [Function.onFun, Set.disjoint_left]
    intro P hPj hPk
    obtain ⟨q, hq, hqP⟩ := (hNmem j P).mp hPj
    obtain ⟨q', _, hq'P⟩ := (hNmem k P).mp hPk
    have h1 := hker j q
    have h2 := hker k q'
    rw [hqP] at h1
    rw [hq'P] at h2
    apply hq
    apply (hmax j q).mp
    rw [hqP]
    exact hpair j k hjk P.asIdeal P.isPrime h1 h2
  have hfin : ∀ j ∈ (Set.univ : Set (Fin m)), (N j).Finite := fun j _ => by
    rw [hN j]
    exact (hn j).1.image _
  have hcard : ∀ j, (N j).ncard = n j := fun j => by
    rw [hN j, Set.ncard_image_of_injective _ (hinj j)]
    exact (hn j).2
  rw [hU]
  refine ⟨Set.Finite.biUnion Set.finite_univ hfin, ?_⟩
  rw [Set.Finite.ncard_biUnion Set.finite_univ hfin hdisj, finsum_mem_univ,
    finsum_eq_sum_of_fintype]
  exact Finset.sum_congr rfl (fun j _ => hcard j)

theorem wc_alg_geom_components_split : ∀ (A B : Type u) [CommRing A] [IsDomain A] [IsNoetherianRing A] [CommRing B] [Algebra A B] [Algebra.FiniteType A B], (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (ψ : A →+* Ω), letI := ψ.toAlgebra; ringKrullDim (TensorProduct A B Ω) ≤ 1) → ∃ (A' : Type u) (_ : CommRing A') (_ : IsDomain A') (_ : Algebra A A'), Function.Injective (algebraMap A A') ∧ Algebra.IsIntegral A A' ∧ Algebra.FiniteType A A' ∧ ∃ (a' : A') (m : ℕ) (Q : Fin m → Ideal (TensorProduct A A' B)), a' ≠ 0 ∧ (∀ j, IsDomain (TensorProduct A' (TensorProduct A A' B ⧸ Q j) (AlgebraicClosure (FractionRing A')))) ∧ (∃ N : ℕ, ∀ x ∈ (∏ j, Q j) ^ N, a' ^ N • x = 0) ∧ (∀ j k, j ≠ k → Module.Finite (FractionRing A') (TensorProduct A' (FractionRing A') (TensorProduct A A' B ⧸ (Q j ⊔ Q k)))) :=
by

  have wc_alg_base_change_kernel_torsion : ∀ (A A' B L : Type u) [CommRing A] [CommRing A'] [IsDomain A'] [CommRing B] [Field L] [Algebra A A'] [Algebra A B] [Algebra A L] [Algebra A' L] [IsScalarTower A A' L], Function.Injective (algebraMap A' L) → ∀ x : TensorProduct A A' B, Algebra.TensorProduct.map (IsScalarTower.toAlgHom A A' L) (AlgHom.id A B) x = 0 → ∃ s : A', s ≠ 0 ∧ s • x = 0 := by
    intro A A' B L _ _ _ _ _ _ _ _ _ _ hinj x hx
    classical
    let e := Algebra.TensorProduct.cancelBaseChange A A' L L B
    have hcomp : ∀ y, e (TensorProduct.tmul A' (1 : L) y) =
        Algebra.TensorProduct.map (IsScalarTower.toAlgHom A A' L) (AlgHom.id A B) y := by
      intro y
      induction y using TensorProduct.induction_on with
      | zero => simp only [map_zero, TensorProduct.tmul_zero]
      | tmul a b =>
        rw [Algebra.TensorProduct.cancelBaseChange_tmul, Algebra.TensorProduct.map_tmul]
        simp [Algebra.algebraMap_eq_smul_one]
      | add x y hx hy => simp only [TensorProduct.tmul_add, map_add, hx, hy]
    have h1 : TensorProduct.tmul A' (1 : L) x = 0 := by
      apply e.injective
      rw [hcomp, hx, map_zero]
    haveI : FaithfulSMul A' L := (faithfulSMul_iff_algebraMap_injective A' L).mpr hinj
    letI : Algebra (FractionRing A') L := FractionRing.liftAlgebra A' L
    haveI : IsScalarTower A' (FractionRing A') L := FractionRing.isScalarTower_liftAlgebra A' L
    let f := TensorProduct.AlgebraTensorModule.cancelBaseChange A' (FractionRing A') L L
      (TensorProduct A A' B)
    have h3 : TensorProduct.tmul (FractionRing A') (1 : L)
        (TensorProduct.tmul A' (1 : FractionRing A') x) = 0 := by
      apply f.injective
      rw [TensorProduct.AlgebraTensorModule.cancelBaseChange_tmul, one_smul, h1, map_zero]
    haveI hfree : Module.Free (FractionRing A')
        (TensorProduct A' (FractionRing A') (TensorProduct A A' B)) :=
      Module.Free.of_divisionRing _ _
    haveI hflat : Module.Flat (FractionRing A')
        (TensorProduct A' (FractionRing A') (TensorProduct A A' B)) := Module.Flat.of_free
    have hinjr : Function.Injective (LinearMap.rTensor
        (TensorProduct A' (FractionRing A') (TensorProduct A A' B))
        (Algebra.linearMap (FractionRing A') L)) :=
      Module.Flat.rTensor_preserves_injective_linearMap _ (algebraMap (FractionRing A') L).injective
    have h4 : TensorProduct.tmul (FractionRing A') (1 : FractionRing A')
        (TensorProduct.tmul A' (1 : FractionRing A') x) = 0 := by
      apply hinjr
      rw [LinearMap.rTensor_tmul, map_zero, Algebra.linearMap_apply, map_one]
      exact h3
    have h5 : TensorProduct.tmul A' (1 : FractionRing A') x = 0 := by
      have := congrArg (TensorProduct.lid (FractionRing A')
        (TensorProduct A' (FractionRing A') (TensorProduct A A' B))) h4
      rwa [TensorProduct.lid_tmul, one_smul, map_zero] at this
    haveI : IsLocalizedModule (nonZeroDivisors A')
        (TensorProduct.mk A' (FractionRing A') (TensorProduct A A' B) 1) :=
      (isLocalizedModule_iff_isBaseChange (nonZeroDivisors A') (FractionRing A') _).mpr
        (TensorProduct.isBaseChange A' (TensorProduct A A' B) (FractionRing A'))
    obtain ⟨s, hs⟩ := (IsLocalizedModule.eq_zero_iff (nonZeroDivisors A')
      (TensorProduct.mk A' (FractionRing A') (TensorProduct A A' B) 1)).mp h5
    rw [Submonoid.smul_def] at hs
    exact ⟨s, nonZeroDivisors.ne_zero s.2, hs⟩

  have wc_alg_descend_elements_integral : ∀ (A B : Type u) [CommRing A] [IsDomain A] [CommRing B] [Algebra A B] (s : Finset (TensorProduct A (AlgebraicClosure (FractionRing A)) B)), ∃ A' : Subalgebra A (AlgebraicClosure (FractionRing A)), A'.FG ∧ Algebra.IsIntegral A A' ∧ ∃ c : A, c ≠ 0 ∧ ∀ x ∈ s, ∃ y : TensorProduct A A' B, Algebra.TensorProduct.map (IsScalarTower.toAlgHom A A' (AlgebraicClosure (FractionRing A))) (AlgHom.id A B) y = c • x := by
    intro A B _ _ _ _ s
    classical
    haveI halg : Algebra.IsAlgebraic A (AlgebraicClosure (FractionRing A)) := by
      haveI : Algebra.IsAlgebraic A (FractionRing A) :=
        IsLocalization.isAlgebraic (FractionRing A) (nonZeroDivisors A)
      exact Algebra.IsAlgebraic.trans A (FractionRing A) (AlgebraicClosure (FractionRing A))
    have hrep : ∀ x : TensorProduct A (AlgebraicClosure (FractionRing A)) B,
        ∃ S : Finset (AlgebraicClosure (FractionRing A) × B),
          x = ∑ i ∈ S, TensorProduct.tmul A i.1 i.2 :=
      fun x => TensorProduct.exists_finset x
    choose S hS using hrep
    let T := s.biUnion (fun x => (S x).image Prod.fst)
    obtain ⟨c, hc, hcint⟩ := Algebra.IsAlgebraic.exists_integral_multiples (R := A) T
    let A' := Algebra.adjoin A
      (↑(T.image (fun z => c • z)) : Set (AlgebraicClosure (FractionRing A)))
    refine ⟨A', Subalgebra.fg_adjoin_finset _, ?_, c, hc, ?_⟩
    · apply Algebra.IsIntegral.adjoin
      intro z hz
      simp only [Finset.coe_image, Set.mem_image, Finset.mem_coe] at hz
      obtain ⟨w, hw, rfl⟩ := hz
      exact hcint w hw
    · intro x hx
      have hmem : ∀ i ∈ S x, c • i.1 ∈ A' := fun i hi => Algebra.subset_adjoin (by
        simp only [Finset.coe_image, Set.mem_image, Finset.mem_coe]
        exact ⟨i.1, Finset.mem_biUnion.mpr ⟨x, hx, Finset.mem_image_of_mem _ hi⟩, rfl⟩)
      refine ⟨∑ i ∈ (S x).attach, TensorProduct.tmul A (⟨c • i.1.1, hmem i.1 i.2⟩ : A') i.1.2, ?_⟩
      rw [map_sum]
      conv_rhs => rw [hS x, Finset.smul_sum, ← Finset.sum_attach]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [Algebra.TensorProduct.map_tmul, TensorProduct.smul_tmul']
      rfl

  have wc_alg_two_minimal_primes_sup_finite : ∀ (k R : Type u) [Field k] [CommRing R] [Algebra k R] [Algebra.FiniteType k R], ringKrullDim R ≤ 1 → ∀ P₁ P₂ : Ideal R, P₁ ∈ minimalPrimes R → P₂ ∈ minimalPrimes R → P₁ ≠ P₂ → Module.Finite k (R ⧸ (P₁ ⊔ P₂)) := by
    intro k R _ _ _ _ hdim P₁ P₂ h1 h2 hne
    have hmax : ∀ P : Ideal R, P.IsPrime → P₁ ⊔ P₂ ≤ P → P.IsMaximal := by
      intro P hP hle
      have hd : Order.krullDim (PrimeSpectrum R) ≤ 1 := hdim
      rcases Order.krullDim_le_one_iff.mp hd ⟨P, hP⟩ with hmin | hmx
      · exfalso
        have hPmin : P ∈ minimalPrimes R := (PrimeSpectrum.isMin_iff).mp hmin
        have e1 : P = P₁ :=
          le_antisymm (hPmin.2 h1.1 (le_sup_left.trans hle)) (le_sup_left.trans hle)
        have e2 : P = P₂ :=
          le_antisymm (hPmin.2 h2.1 (le_sup_right.trans hle)) (le_sup_right.trans hle)
        exact hne (e1.symm.trans e2)
      · exact (PrimeSpectrum.isMax_iff).mp hmx
    haveI : Ring.KrullDimLE 0 (R ⧸ (P₁ ⊔ P₂)) := by
      apply Ring.KrullDimLE.mk₀
      intro p hp
      have hc : (Ideal.comap (Ideal.Quotient.mk (P₁ ⊔ P₂)) p).IsMaximal := by
        apply hmax _ (Ideal.comap_isPrime _ p)
        intro x hx
        show Ideal.Quotient.mk (P₁ ⊔ P₂) x ∈ p
        rw [Ideal.Quotient.eq_zero_iff_mem.mpr hx]
        exact p.zero_mem
      have hmc := Ideal.map_comap_of_surjective (Ideal.Quotient.mk (P₁ ⊔ P₂))
        Ideal.Quotient.mk_surjective p
      rcases Ideal.map_eq_top_or_isMaximal_of_surjective (Ideal.Quotient.mk (P₁ ⊔ P₂))
        Ideal.Quotient.mk_surjective hc with h | h
      · exact absurd (hmc ▸ h) hp.ne_top
      · rwa [hmc] at h
    haveI : Algebra.FiniteType k (R ⧸ (P₁ ⊔ P₂)) :=
      Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ k (P₁ ⊔ P₂))
        (Ideal.Quotient.mkₐ_surjective k _)
    haveI : IsNoetherianRing (R ⧸ (P₁ ⊔ P₂)) := Algebra.FiniteType.isNoetherianRing k _
    haveI : IsArtinianRing (R ⧸ (P₁ ⊔ P₂)) :=
      isArtinianRing_iff_isNoetherianRing_krullDimLE_zero.mpr ⟨inferInstance, inferInstance⟩
    exact Module.finite_of_isArtinianRing k _

  have wc_alg_finite_descent_fraction_ring : ∀ (A' M L : Type u) [CommRing A'] [IsDomain A'] [AddCommGroup M] [Module A' M] [Field L] [Algebra A' L], Function.Injective (algebraMap A' L) → Module.Finite L (TensorProduct A' L M) → Module.Finite (FractionRing A') (TensorProduct A' (FractionRing A') M) := by
    intro A' M L _ _ _ _ _ _ hinj hfin
    haveI : FaithfulSMul A' L := (faithfulSMul_iff_algebraMap_injective A' L).mpr hinj
    letI : Algebra (FractionRing A') L := FractionRing.liftAlgebra A' L
    haveI : IsScalarTower A' (FractionRing A') L := FractionRing.isScalarTower_liftAlgebra A' L
    let V := TensorProduct A' (FractionRing A') M
    haveI : Module.Finite L (TensorProduct (FractionRing A') L V) :=
      Module.Finite.equiv
        (TensorProduct.AlgebraTensorModule.cancelBaseChange A' (FractionRing A') L L M).symm
    let b := Module.Basis.ofVectorSpace (FractionRing A') V
    haveI : Finite (Module.Basis.ofVectorSpaceIndex (FractionRing A') V) :=
      Module.Finite.finite_basis (Algebra.TensorProduct.basis L b)
    exact Module.Finite.of_basis b

  have wc_alg_base_change_quot_iso : ∀ (A A' B L : Type u) [CommRing A] [CommRing A'] [CommRing B] [CommRing L] [Algebra A A'] [Algebra A B] [Algebra A L] [Algebra A' L] [IsScalarTower A A' L] (I : Ideal (TensorProduct A A' B)), Nonempty (TensorProduct A' L (TensorProduct A A' B ⧸ I) ≃ₐ[L] (TensorProduct A L B ⧸ Ideal.map (Algebra.TensorProduct.map (IsScalarTower.toAlgHom A A' L) (AlgHom.id A B)) I)) := by
    intro A A' B L _ _ _ _ _ _ _ _ _ I
    classical
    let e := Algebra.TensorProduct.cancelBaseChange A A' L L B
    let φ := Algebra.TensorProduct.map (IsScalarTower.toAlgHom A A' L) (AlgHom.id A B)
    let π := Algebra.TensorProduct.map (AlgHom.id L L) (Ideal.Quotient.mkₐ A' I)
    let π' := Algebra.TensorProduct.map (AlgHom.id A' L) (Ideal.Quotient.mkₐ A' I)
    have hfun : ∀ x, π x = π' x := by
      intro x
      induction x using TensorProduct.induction_on with
      | zero => simp only [map_zero]
      | tmul a b => rfl
      | add x y hx hy => rw [map_add, map_add, hx, hy]
    have hsurj : Function.Surjective π := by
      intro z
      obtain ⟨x, hx⟩ := Algebra.TensorProduct.map_surjective (AlgHom.id A' L)
        (Ideal.Quotient.mkₐ A' I) Function.surjective_id (Ideal.Quotient.mkₐ_surjective A' I) z
      exact ⟨x, (hfun x).trans hx⟩
    have hker : RingHom.ker π = Ideal.map (Algebra.TensorProduct.includeRight (R := A') (A := L)
        (B := TensorProduct A A' B)) I := by
      have h1 := Algebra.TensorProduct.lTensor_ker (R := A') (A := L) (Ideal.Quotient.mkₐ A' I)
        (Ideal.Quotient.mkₐ_surjective A' I)
      have hk : RingHom.ker (Ideal.Quotient.mkₐ A' I) = I := Ideal.Quotient.mkₐ_ker A' I
      rw [hk] at h1
      rw [← h1]
      ext x
      rw [RingHom.mem_ker, RingHom.mem_ker, hfun x]
    have hcomp : ∀ y, e (Algebra.TensorProduct.includeRight (R := A') (A := L) y) = φ y := by
      intro y
      induction y using TensorProduct.induction_on with
      | zero => simp only [map_zero]
      | tmul a b =>
        rw [Algebra.TensorProduct.includeRight_apply, Algebra.TensorProduct.cancelBaseChange_tmul,
          Algebra.TensorProduct.map_tmul]
        simp [Algebra.algebraMap_eq_smul_one]
      | add x y hx hy => simp only [map_add, hx, hy]
    have hmapeq : Ideal.map (e : TensorProduct A' L (TensorProduct A A' B) →+* TensorProduct A L B)
        (RingHom.ker π) = Ideal.map φ I := by
      rw [hker]
      have h0 : Ideal.map (Algebra.TensorProduct.includeRight (R := A') (A := L)
          (B := TensorProduct A A' B)) I = Ideal.map ((Algebra.TensorProduct.includeRight (R := A')
          (A := L) (B := TensorProduct A A' B)) : TensorProduct A A' B →+* _) I := rfl
      rw [h0, Ideal.map_map]
      have h2 : (e : TensorProduct A' L (TensorProduct A A' B) →+* TensorProduct A L B).comp
          ((Algebra.TensorProduct.includeRight (R := A') (A := L) (B := TensorProduct A A' B)) :
            TensorProduct A A' B →+* _) = (φ : TensorProduct A A' B →+* TensorProduct A L B) :=
        RingHom.ext hcomp
      rw [h2]
      rfl
    let iso1 := Ideal.quotientKerAlgEquivOfSurjective hsurj
    let iso2 := Ideal.quotientEquivAlg (R₁ := L) (RingHom.ker π) (Ideal.map φ I) e hmapeq.symm
    exact ⟨iso1.symm.trans iso2⟩

  have wc_alg_tensor_algClosure_domain_transfer : ∀ (A' C L : Type u) [CommRing A'] [IsDomain A'] [CommRing C] [Algebra A' C] [Field L] [IsAlgClosed L] [Algebra A' L], Function.Injective (algebraMap A' L) → Algebra.IsAlgebraic A' L → IsDomain (TensorProduct A' L C) → IsDomain (TensorProduct A' C (AlgebraicClosure (FractionRing A'))) := by
    intro A' C L _ _ _ _ _ _ _ hinj halg hdom
    have hinjB : Function.Injective (algebraMap A' (AlgebraicClosure (FractionRing A'))) := by
      rw [IsScalarTower.algebraMap_eq A' (FractionRing A') (AlgebraicClosure (FractionRing A'))]
      exact (algebraMap (FractionRing A') (AlgebraicClosure (FractionRing A'))).injective.comp
        (IsFractionRing.injective A' (FractionRing A'))
    haveI : Module.IsTorsionFree A' L := Module.isTorsionFree_iff_faithfulSMul.mpr
      ((faithfulSMul_iff_algebraMap_injective A' L).mpr hinj)
    haveI : Module.IsTorsionFree A' (AlgebraicClosure (FractionRing A')) :=
      Module.isTorsionFree_iff_faithfulSMul.mpr
        ((faithfulSMul_iff_algebraMap_injective A' _).mpr hinjB)
    haveI : Algebra.IsAlgebraic A' (FractionRing A') :=
      IsLocalization.isAlgebraic (FractionRing A') (nonZeroDivisors A')
    haveI : Algebra.IsAlgebraic A' (AlgebraicClosure (FractionRing A')) :=
      Algebra.IsAlgebraic.trans A' (FractionRing A') (AlgebraicClosure (FractionRing A'))
    haveI : IsAlgClosure A' L := ⟨inferInstance, halg⟩
    haveI : IsAlgClosure A' (AlgebraicClosure (FractionRing A')) := ⟨inferInstance, inferInstance⟩
    let σ := IsAlgClosure.equiv A' L (AlgebraicClosure (FractionRing A'))
    let e : TensorProduct A' C (AlgebraicClosure (FractionRing A')) ≃ₐ[A'] TensorProduct A' L C :=
      (Algebra.TensorProduct.comm A' C _).trans (Algebra.TensorProduct.congr σ.symm AlgEquiv.refl)
    exact MulEquiv.isDomain _ e.toRingEquiv.toMulEquiv

  intro A B _ _ _ _ _ _ H
  classical

  have hinjK : Function.Injective (algebraMap A (AlgebraicClosure (FractionRing A))) := by
    rw [IsScalarTower.algebraMap_eq A (FractionRing A) (AlgebraicClosure (FractionRing A))]
    exact (algebraMap (FractionRing A) (AlgebraicClosure (FractionRing A))).injective.comp
      (IsFractionRing.injective A (FractionRing A))

  have halg : Algebra.IsAlgebraic A (AlgebraicClosure (FractionRing A)) := by
    haveI : Algebra.IsAlgebraic A (FractionRing A) :=
      IsLocalization.isAlgebraic (FractionRing A) (nonZeroDivisors A)
    exact Algebra.IsAlgebraic.trans A (FractionRing A) (AlgebraicClosure (FractionRing A))

  haveI hRft : Algebra.FiniteType (AlgebraicClosure (FractionRing A))
      (TensorProduct A (AlgebraicClosure (FractionRing A)) B) := inferInstance
  haveI hRnoeth : IsNoetherianRing (TensorProduct A (AlgebraicClosure (FractionRing A)) B) :=
    Algebra.FiniteType.isNoetherianRing (AlgebraicClosure (FractionRing A)) _

  have hdim : ringKrullDim (TensorProduct A (AlgebraicClosure (FractionRing A)) B) ≤ 1 := by
    have h := H (AlgebraicClosure (FractionRing A)) (algebraMap A (AlgebraicClosure (FractionRing A)))
    have heq : (algebraMap A (AlgebraicClosure (FractionRing A))).toAlgebra =
        (inferInstance : Algebra A (AlgebraicClosure (FractionRing A))) :=
      Algebra.algebra_ext _ _ (fun _ => rfl)
    have h' : ringKrullDim (TensorProduct A B (AlgebraicClosure (FractionRing A))) ≤ 1 := by
      first
        | exact heq ▸ h
        | (rw [heq] at h; exact h)
    exact (ringKrullDim_eq_of_ringEquiv
      (Algebra.TensorProduct.comm A B (AlgebraicClosure (FractionRing A))).toRingEquiv).symm.le.trans h'

  have hfin := minimalPrimes.finite_of_isNoetherianRing
    (TensorProduct A (AlgebraicClosure (FractionRing A)) B)
  set Fs := hfin.toFinset with hFs
  set m := Fs.card with hm
  let eF := Fs.equivFin
  let P : Fin m → Ideal (TensorProduct A (AlgebraicClosure (FractionRing A)) B) :=
    fun j => (eF.symm j).1
  have hPmin : ∀ j, P j ∈ minimalPrimes (TensorProduct A (AlgebraicClosure (FractionRing A)) B) :=
    fun j => hfin.mem_toFinset.mp (eF.symm j).2
  have hPinj : Function.Injective P := fun j k h => eF.symm.injective (Subtype.ext h)
  have hPall : ∀ p ∈ minimalPrimes (TensorProduct A (AlgebraicClosure (FractionRing A)) B),
      ∃ j, P j = p := by
    intro p hp
    refine ⟨eF ⟨p, hfin.mem_toFinset.mpr hp⟩, ?_⟩
    simp only [P, Equiv.symm_apply_apply]

  have hgen : ∀ j, ∃ G : Finset (TensorProduct A (AlgebraicClosure (FractionRing A)) B),
      Ideal.span (G : Set _) = P j := fun j => Ideal.fg_of_isNoetherianRing (P j)
  choose G hG using hgen
  let s := Finset.univ.biUnion G

  obtain ⟨A'₀, hfg, hint, c, hc, hdesc⟩ := wc_alg_descend_elements_integral A B s
  have hinjA' : Function.Injective (algebraMap A A'₀) := by
    intro x y h
    apply hinjK
    have := congrArg Subtype.val h
    exact this
  have hinjval : Function.Injective (algebraMap A'₀ (AlgebraicClosure (FractionRing A))) :=
    Subtype.val_injective
  haveI : Algebra.IsIntegral A A'₀ := hint
  haveI hA'ft : Algebra.FiniteType A A'₀ := (Subalgebra.fg_iff_finiteType A'₀).mp hfg
  haveI : IsNoetherianRing A'₀ := Algebra.FiniteType.isNoetherianRing A A'₀
  haveI : IsNoetherianRing (TensorProduct A A'₀ B) := Algebra.FiniteType.isNoetherianRing A'₀ _
  let φ := Algebra.TensorProduct.map (IsScalarTower.toAlgHom A A'₀ (AlgebraicClosure (FractionRing A)))
    (AlgHom.id A B)
  let Q : Fin m → Ideal (TensorProduct A A'₀ B) := fun j => Ideal.comap φ (P j)
  have hcK : algebraMap A (AlgebraicClosure (FractionRing A)) c ≠ 0 := fun h =>
    hc (hinjK (h.trans (map_zero _).symm))
  have hu : IsUnit (algebraMap A (TensorProduct A (AlgebraicClosure (FractionRing A)) B) c) := by
    rw [Algebra.TensorProduct.algebraMap_apply]
    exact (isUnit_iff_ne_zero.mpr hcK).map
      (Algebra.TensorProduct.includeLeftRingHom (R := A) (A := AlgebraicClosure (FractionRing A))
        (B := B))
  have hmap : ∀ j, Ideal.map φ (Q j) = P j := by
    intro j
    apply le_antisymm Ideal.map_comap_le
    have hsp : Ideal.span (G j : Set _) ≤ Ideal.map φ (Q j) := by
      rw [Ideal.span_le]
      intro g hg
      have hgs : g ∈ s := Finset.mem_biUnion.mpr ⟨j, Finset.mem_univ _, hg⟩
      obtain ⟨y, hy⟩ := hdesc g hgs
      have hgP : g ∈ P j := by rw [← hG j]; exact Ideal.subset_span hg
      have hyQ : y ∈ Q j := by
        show φ y ∈ P j
        rw [hy, Algebra.smul_def]
        exact Ideal.mul_mem_left _ _ hgP
      have h1 : algebraMap A _ c * g ∈ Ideal.map φ (Q j) := by
        rw [← Algebra.smul_def, ← hy]
        exact Ideal.mem_map_of_mem φ hyQ
      have h2 := Ideal.mul_mem_left _ (↑hu.unit⁻¹) h1
      rwa [← mul_assoc, IsUnit.val_inv_mul, one_mul] at h2
    calc P j = Ideal.span (G j : Set _) := (hG j).symm
      _ ≤ _ := hsp

  have hprodle : (∏ j, P j) ≤
      sInf (minimalPrimes (TensorProduct A (AlgebraicClosure (FractionRing A)) B)) := by
    apply le_sInf
    intro p hp
    obtain ⟨j, rfl⟩ := hPall p hp
    exact Ideal.prod_le_inf.trans (Finset.inf_le (Finset.mem_univ j))
  have hrad : sInf (minimalPrimes (TensorProduct A (AlgebraicClosure (FractionRing A)) B)) =
      (⊥ : Ideal (TensorProduct A (AlgebraicClosure (FractionRing A)) B)).radical :=
    Ideal.sInf_minimalPrimes
  obtain ⟨N₀, hN₀⟩ := Ideal.exists_pow_le_of_le_radical_of_fg (hprodle.trans_eq hrad)
    (Ideal.fg_of_isNoetherianRing _)
  have hmapprod : Ideal.map φ (∏ j, Q j) = ∏ j, P j := by
    rw [show Ideal.map φ (∏ j, Q j) = Ideal.mapHom φ (∏ j, Q j) from rfl, map_prod]
    exact Finset.prod_congr rfl (fun j _ => hmap j)
  have hJzero : ∀ x ∈ (∏ j, Q j) ^ N₀, φ x = 0 := by
    intro x hx
    have h1 := Ideal.mem_map_of_mem φ hx
    rw [Ideal.map_pow, hmapprod] at h1
    exact (Ideal.mem_bot).mp (hN₀ h1)
  obtain ⟨H0, hH0⟩ := Ideal.fg_of_isNoetherianRing ((∏ j, Q j) ^ N₀)
  have htors : ∀ h ∈ H0, ∃ t : A'₀, t ≠ 0 ∧ t • h = 0 := fun h hh =>
    wc_alg_base_change_kernel_torsion A A'₀ B (AlgebraicClosure (FractionRing A)) hinjval h
      (hJzero h (hH0 ▸ Ideal.subset_span hh))
  choose! t ht0 htk using htors
  have ha' : (∏ h ∈ H0, t h) ≠ 0 := Finset.prod_ne_zero_iff.mpr (fun h hh => ht0 h hh)
  have hkillgen : ∀ h ∈ H0, (∏ h ∈ H0, t h) • h = 0 := by
    intro h hh
    rw [← Finset.prod_erase_mul H0 t hh, mul_smul, htk h hh, smul_zero]
  have hkill : ∀ x ∈ (∏ j, Q j) ^ N₀, (∏ h ∈ H0, t h) • x = 0 := by
    intro x hx
    rw [← hH0] at hx
    induction hx using Submodule.span_induction with
    | mem x hx => exact hkillgen x hx
    | zero => exact smul_zero _
    | add x y _ _ hx hy => rw [smul_add, hx, hy, add_zero]
    | smul r x _ hx => rw [smul_eq_mul, ← mul_smul_comm, hx, mul_zero]
  have halg' : Algebra.IsAlgebraic A'₀ (AlgebraicClosure (FractionRing A)) :=
    Algebra.IsAlgebraic.extendScalars hinjA'
  refine ⟨A'₀, inferInstance, inferInstance, inferInstance, hinjA', hint, hA'ft,
    ∏ h ∈ H0, t h, m, Q, ha', ?_, ⟨N₀ + 1, ?_⟩, ?_⟩
  ·
    intro j
    obtain ⟨e⟩ := wc_alg_base_change_quot_iso A A'₀ B (AlgebraicClosure (FractionRing A)) (Q j)
    haveI : (P j).IsPrime := (hPmin j).1.1
    have e' := e.trans (Ideal.quotientEquivAlgOfEq (AlgebraicClosure (FractionRing A)) (hmap j))
    refine wc_alg_tensor_algClosure_domain_transfer A'₀ _
      (AlgebraicClosure (FractionRing A)) hinjval halg' ?_
    exact MulEquiv.isDomain _ e'.toRingEquiv.toMulEquiv
  ·
    intro x hx
    have hx' : x ∈ (∏ j, Q j) ^ N₀ := Ideal.pow_le_pow_right (Nat.le_succ N₀) hx
    rw [pow_succ, mul_smul, hkill x hx', smul_zero]
  ·
    intro j k hjk
    have hPne : P j ≠ P k := fun h => hjk (hPinj h)
    haveI hfinR := wc_alg_two_minimal_primes_sup_finite (AlgebraicClosure (FractionRing A))
      (TensorProduct A (AlgebraicClosure (FractionRing A)) B) hdim (P j) (P k) (hPmin j) (hPmin k) hPne
    obtain ⟨e⟩ := wc_alg_base_change_quot_iso A A'₀ B (AlgebraicClosure (FractionRing A))
      (Q j ⊔ Q k)
    have hms : Ideal.map φ (Q j ⊔ Q k) = P j ⊔ P k := by rw [Ideal.map_sup, hmap j, hmap k]
    have e' := e.trans (Ideal.quotientEquivAlgOfEq (AlgebraicClosure (FractionRing A)) hms)
    refine wc_alg_finite_descent_fraction_ring A'₀ _
      (AlgebraicClosure (FractionRing A)) hinjval ?_
    exact Module.Finite.equiv e'.symm.toLinearEquiv

theorem wc_alg_gi_noether_normalization : ∀ (A B : Type u) [CommRing A] [IsDomain A] [IsNoetherianRing A] [CommRing B] [Algebra A B] [Algebra.FiniteType A B], IsDomain (TensorProduct A B (AlgebraicClosure (FractionRing A))) → (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (ψ : A →+* Ω), letI := ψ.toAlgebra; ringKrullDim (TensorProduct A B Ω) ≤ 1) → ¬ Module.Finite (FractionRing A) (TensorProduct A (FractionRing A) B) → ∃ y : B, Function.Injective (Polynomial.aeval (R := FractionRing A) ((1 : FractionRing A) ⊗ₜ[A] y : TensorProduct A (FractionRing A) B)) ∧ ∀ x : TensorProduct A (FractionRing A) B, ∃ F : Polynomial (Polynomial (FractionRing A)), F.Monic ∧ Polynomial.eval₂ (Polynomial.aeval (R := FractionRing A) ((1 : FractionRing A) ⊗ₜ[A] y : TensorProduct A (FractionRing A) B)).toRingHom x F = 0 :=
by
  intro A B _ _ _ _ _ _ _hGI H hNF
  classical

  have dimMono : ∀ (R S : Type u) [CommRing R] [CommRing S] (f : R →+* S),
      Function.Injective f → f.IsIntegral → ringKrullDim R ≤ ringKrullDim S := by
    intro R S _ _ f hf hi
    letI := f.toAlgebra
    haveI : Algebra.IsIntegral R S := ⟨hi⟩
    have key : ∀ p : LTSeries (PrimeSpectrum R), ∃ q : LTSeries (PrimeSpectrum S),
        q.length = p.length ∧ Ideal.comap f q.last.asIdeal = p.last.asIdeal := by
      intro p
      induction p using RelSeries.inductionOn' with
      | singleton x =>
        obtain ⟨Q, -, hQ, hQu⟩ := Ideal.exists_ideal_over_prime_of_isIntegral (S := S)
          x.asIdeal ⊥ (by
            rw [Ideal.under_def]
            show Ideal.comap f ⊥ ≤ _
            rw [Ideal.comap_bot_of_injective f hf]
            exact bot_le)
        exact ⟨RelSeries.singleton _ ⟨Q, hQ⟩, rfl, hQu⟩
      | snoc p x hx ih =>
        obtain ⟨q, hql, hqu⟩ := ih
        have hlt : p.last < x := hx
        obtain ⟨Q, hQge, hQ, hQu⟩ := Ideal.exists_ideal_over_prime_of_isIntegral_of_isPrime
          (S := S) x.asIdeal q.last.asIdeal (by
            rw [Ideal.under_def]
            show Ideal.comap f _ ≤ _
            rw [hqu]
            exact hlt.le)
        have hlt' : q.last < (⟨Q, hQ⟩ : PrimeSpectrum S) := by
          refine lt_of_le_of_ne hQge ?_
          intro heq
          apply hlt.ne
          ext1
          rw [← hqu, heq]
          exact hQu
        refine ⟨q.snoc ⟨Q, hQ⟩ hlt', ?_, ?_⟩
        · rw [RelSeries.snoc_length, RelSeries.snoc_length, hql]
        · rw [RelSeries.last_snoc, RelSeries.last_snoc]
          exact hQu
    show Order.krullDim _ ≤ Order.krullDim _
    refine iSup_le fun p => ?_
    obtain ⟨q, hql, -⟩ := key p
    rw [← hql]
    exact Order.LTSeries.length_le_krullDim q

  have hcomp : ∀ (Ω : Type u) [Field Ω] (ι : FractionRing A →+* Ω),
      (∀ w : Ω, ι.IsIntegralElem w) →
      letI := (ι.comp (algebraMap A (FractionRing A))).toAlgebra
      ∃ f : TensorProduct A (FractionRing A) B →+* TensorProduct A B Ω,
        Function.Injective f ∧ f.IsIntegral := by
    intro Ω _ ι hι
    letI : Algebra (FractionRing A) Ω := ι.toAlgebra
    letI : Algebra A Ω := (ι.comp (algebraMap A (FractionRing A))).toAlgebra
    haveI : IsScalarTower A (FractionRing A) Ω := IsScalarTower.of_algebraMap_eq' rfl
    haveI : Algebra.IsIntegral (FractionRing A) Ω := ⟨hι⟩
    obtain ⟨r, hr⟩ := LinearMap.exists_leftInverse_of_injective
      (Algebra.linearMap (FractionRing A) Ω)
      (LinearMap.ker_eq_bot.mpr (algebraMap (FractionRing A) Ω).injective)
    let m : TensorProduct A (FractionRing A) B →ₐ[A] TensorProduct A Ω B :=
      Algebra.TensorProduct.map (IsScalarTower.toAlgHom A (FractionRing A) Ω) (AlgHom.id A B)
    let g : TensorProduct A Ω B →ₗ[A] TensorProduct A (FractionRing A) B :=
      (r.restrictScalars A).rTensor B
    have hgm : ∀ x, g (m x) = x := by
      intro x
      induction x using TensorProduct.induction_on with
      | zero => simp
      | tmul k b =>
        have hk : r (algebraMap (FractionRing A) Ω k) = k := LinearMap.congr_fun hr k
        simp [m, g, Algebra.TensorProduct.map_tmul, LinearMap.rTensor_tmul, hk]
      | add x y hx hy => rw [map_add, map_add, hx, hy]
    let f : TensorProduct A (FractionRing A) B →+* TensorProduct A B Ω :=
      ((Algebra.TensorProduct.comm A Ω B).toAlgHom.comp m).toRingHom
    have hf : ∀ (k : FractionRing A) (b : B), f (k ⊗ₜ[A] b) = b ⊗ₜ[A] algebraMap (FractionRing A) Ω k := by
      intro k b
      simp [f, m]
    refine ⟨f, (Algebra.TensorProduct.comm A Ω B).injective.comp
      (Function.LeftInverse.injective hgm), ?_⟩
    intro z
    induction z using TensorProduct.induction_on with
    | zero =>
      have := f.isIntegralElem_map (x := 0)
      rwa [map_zero] at this
    | tmul b ω =>
      have e : b ⊗ₜ[A] ω = (b ⊗ₜ[A] (1 : Ω)) * ((1 : B) ⊗ₜ[A] ω) := by
        rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
      rw [e]
      refine RingHom.IsIntegralElem.mul f ?_ ?_
      · have h1 : f ((1 : FractionRing A) ⊗ₜ[A] b) = b ⊗ₜ[A] (1 : Ω) := by
          rw [hf, map_one]
        rw [← h1]
        exact f.isIntegralElem_map
      · obtain ⟨p, hpm, hp⟩ := Algebra.IsIntegral.isIntegral (R := FractionRing A) ω
        refine ⟨p.map (algebraMap (FractionRing A) (TensorProduct A (FractionRing A) B)),
          hpm.map _, ?_⟩
        rw [Polynomial.eval₂_map]
        have hc : f.comp (algebraMap (FractionRing A) (TensorProduct A (FractionRing A) B)) =
            (Algebra.TensorProduct.includeRight : Ω →ₐ[A] TensorProduct A B Ω).toRingHom.comp
              (algebraMap (FractionRing A) Ω) := by
          ext c
          simp only [RingHom.comp_apply, Algebra.TensorProduct.algebraMap_apply,
            Algebra.algebraMap_self, RingHom.id_apply, hf, AlgHom.toRingHom_eq_coe,
            RingHom.coe_coe, Algebra.TensorProduct.includeRight_apply]
        rw [hc]
        have h2 := Polynomial.hom_eval₂ p (algebraMap (FractionRing A) Ω)
          (Algebra.TensorProduct.includeRight : Ω →ₐ[A] TensorProduct A B Ω).toRingHom ω
        rw [hp, map_zero] at h2
        exact h2.symm
    | add x y hx hy => exact RingHom.IsIntegralElem.add f hx hy

  have hclear : ∀ x : TensorProduct A (FractionRing A) B, ∃ (a : A) (b : B), a ≠ 0 ∧
      a • x = (1 : FractionRing A) ⊗ₜ[A] b := by
    intro x
    induction x using TensorProduct.induction_on with
    | zero => exact ⟨1, 0, one_ne_zero, by rw [smul_zero, TensorProduct.tmul_zero]⟩
    | tmul k b₀ =>
      obtain ⟨⟨n, d⟩, rfl⟩ := IsLocalization.mk'_surjective (nonZeroDivisors A) k
      refine ⟨d, n • b₀, nonZeroDivisors.ne_zero d.2, ?_⟩
      simp only
      rw [TensorProduct.smul_tmul', Algebra.smul_def, mul_comm, IsLocalization.mk'_spec,
        Algebra.algebraMap_eq_smul_one, TensorProduct.smul_tmul]
    | add x y hx hy =>
      obtain ⟨a₁, b₁, h1, e1⟩ := hx
      obtain ⟨a₂, b₂, h2, e2⟩ := hy
      refine ⟨a₁ * a₂, a₂ • b₁ + a₁ • b₂, mul_ne_zero h1 h2, ?_⟩
      have ex : (a₁ * a₂) • x = a₂ • ((1 : FractionRing A) ⊗ₜ[A] b₁) := by
        rw [mul_comm, mul_smul, e1]
      have ey : (a₁ * a₂) • y = a₁ • ((1 : FractionRing A) ⊗ₜ[A] b₂) := by
        rw [mul_smul, e2]
      rw [smul_add, ex, ey, ← TensorProduct.tmul_smul, ← TensorProduct.tmul_smul,
        TensorProduct.tmul_add]

  haveI : Algebra.FiniteType (FractionRing A) (TensorProduct A (FractionRing A) B) :=
    Algebra.FiniteType.baseChange (FractionRing A)
  haveI : Nontrivial (TensorProduct A (FractionRing A) B) := by
    by_contra hnt
    haveI := not_nontrivial_iff_subsingleton.mp hnt
    haveI : Finite (TensorProduct A (FractionRing A) B) := Finite.of_subsingleton
    exact hNF (Module.Finite.of_finite)
  obtain ⟨s, g, hginj, hgfin⟩ :=
    exists_finite_inj_algHom_of_fg (FractionRing A) (TensorProduct A (FractionRing A) B)
  have hs0 : s ≠ 0 := by
    rintro rfl
    apply hNF
    have hC : (algebraMap (FractionRing A) (MvPolynomial (Fin 0) (FractionRing A))).Finite :=
      RingHom.Finite.of_surjective _ (MvPolynomial.C_surjective (Fin 0))
    have := RingHom.Finite.comp hgfin hC
    rw [← RingHom.finite_algebraMap]
    convert this using 1
    exact g.comp_algebraMap.symm
  have hs1 : s ≤ 1 := by
    letI : Algebra A (AlgebraicClosure (FractionRing A)) :=
      ((algebraMap (FractionRing A) (AlgebraicClosure (FractionRing A))).comp
        (algebraMap A (FractionRing A))).toAlgebra
    obtain ⟨f, hfi, hfint⟩ := hcomp (AlgebraicClosure (FractionRing A))
      (algebraMap (FractionRing A) (AlgebraicClosure (FractionRing A)))
      (fun w => Algebra.IsIntegral.isIntegral (R := FractionRing A) w)
    have h1 := H (AlgebraicClosure (FractionRing A))
      ((algebraMap (FractionRing A) (AlgebraicClosure (FractionRing A))).comp
        (algebraMap A (FractionRing A)))
    have h2 := dimMono _ _ (f.comp g.toRingHom) (hfi.comp hginj)
      (RingHom.IsIntegral.trans g.toRingHom f (RingHom.IsIntegral.of_finite hgfin) hfint)
    have h3 := h2.trans h1
    rw [MvPolynomial.ringKrullDim_of_isNoetherianRing, ringKrullDim_eq_zero_of_field,
      ENat.card_eq_coe_natCard, Nat.card_fin, zero_add] at h3
    exact_mod_cast h3
  have hs : s = 1 := by omega
  subst hs

  obtain ⟨a, b, ha, hab⟩ := hclear (g (MvPolynomial.X 0))
  set c : FractionRing A := algebraMap A (FractionRing A) a with hc_def
  have hc : c ≠ 0 := by
    intro h0
    apply ha
    apply IsFractionRing.injective A (FractionRing A)
    rw [map_zero]
    exact h0
  set v : TensorProduct A (FractionRing A) B := (1 : FractionRing A) ⊗ₜ[A] b with hv_def
  have hvw : v = c • g (MvPolynomial.X 0) := by
    rw [← hab, hc_def, algebraMap_smul]
  let τ : Polynomial (FractionRing A) →ₐ[FractionRing A] MvPolynomial (Fin 1) (FractionRing A) :=
    Polynomial.aeval (MvPolynomial.C c * MvPolynomial.X 0)
  let τ' : MvPolynomial (Fin 1) (FractionRing A) →ₐ[FractionRing A] Polynomial (FractionRing A) :=
    MvPolynomial.aeval (fun _ => Polynomial.C c⁻¹ * Polynomial.X)
  have hτ'τ : τ'.comp τ = AlgHom.id _ _ := by
    apply Polynomial.algHom_ext
    simp only [τ, τ', AlgHom.comp_apply, Polynomial.aeval_X, map_mul, MvPolynomial.aeval_X,
      MvPolynomial.aeval_C, AlgHom.id_apply]
    rw [Polynomial.algebraMap_eq, ← mul_assoc, ← Polynomial.C_mul, mul_inv_cancel₀ hc,
      Polynomial.C_1, one_mul]
  have hττ' : τ.comp τ' = AlgHom.id _ _ := by
    apply MvPolynomial.algHom_ext
    intro i
    simp only [τ, τ', AlgHom.comp_apply, MvPolynomial.aeval_X, map_mul, Polynomial.aeval_X,
      Polynomial.aeval_C, AlgHom.id_apply]
    rw [MvPolynomial.algebraMap_eq, ← mul_assoc, ← MvPolynomial.C_mul, inv_mul_cancel₀ hc,
      MvPolynomial.C_1, one_mul, Subsingleton.elim i 0]
  have hav : Polynomial.aeval (R := FractionRing A) v = g.comp τ := by
    apply Polynomial.algHom_ext
    simp only [τ, Polynomial.aeval_X, AlgHom.comp_apply, map_mul, MvPolynomial.algHom_C, hvw]
    exact Algebra.smul_def c (g (MvPolynomial.X 0))
  refine ⟨b, ?_, ?_⟩
  · change Function.Injective (Polynomial.aeval (R := FractionRing A) v)
    rw [hav]
    refine hginj.comp ?_
    intro p q hpq
    have h1 := AlgHom.congr_fun hτ'τ p
    have h2 := AlgHom.congr_fun hτ'τ q
    simp only [AlgHom.comp_apply, AlgHom.id_apply] at h1 h2
    exact (h1.symm.trans (congrArg τ' hpq)).trans h2
  · intro x
    change ∃ F : Polynomial (Polynomial (FractionRing A)), F.Monic ∧
      Polynomial.eval₂ (Polynomial.aeval (R := FractionRing A) v).toRingHom x F = 0
    obtain ⟨G, hGm, hG⟩ := RingHom.IsIntegral.of_finite hgfin x
    refine ⟨G.map τ'.toRingHom, hGm.map _, ?_⟩
    rw [Polynomial.eval₂_map]
    have heq : (Polynomial.aeval (R := FractionRing A) v).toRingHom.comp τ'.toRingHom =
        g.toRingHom := by
      refine RingHom.ext fun p => ?_
      have := AlgHom.congr_fun hττ' p
      simp only [AlgHom.comp_apply, AlgHom.id_apply] at this
      change (Polynomial.aeval (R := FractionRing A) v) (τ' p) = g p
      rw [hav, AlgHom.comp_apply, this]
    rw [heq]
    exact hG

theorem wc_alg_gi_plane_model : ∀ (A B : Type u) [CommRing A] [IsDomain A] [CommRing B] [Algebra A B] [Algebra.FiniteType A B], IsDomain (TensorProduct A (FractionRing A) B) → ∀ y : B, Function.Injective (Polynomial.aeval (R := FractionRing A) ((1 : FractionRing A) ⊗ₜ[A] y : TensorProduct A (FractionRing A) B)) → (∀ x : TensorProduct A (FractionRing A) B, ∃ F : Polynomial (Polynomial (FractionRing A)), F.Monic ∧ Polynomial.eval₂ (Polynomial.aeval (R := FractionRing A) ((1 : FractionRing A) ⊗ₜ[A] y : TensorProduct A (FractionRing A) B)).toRingHom x F = 0) → ∃ (z : B) (P : Polynomial (Polynomial A)) (q : ℕ), P.Monic ∧ 0 < q ∧ (q = 1 ∨ ∃ p k : ℕ, p.Prime ∧ CharP A p ∧ q = p ^ k) ∧ Polynomial.eval₂ (Polynomial.aeval (R := FractionRing A) ((1 : FractionRing A) ⊗ₜ[A] y : TensorProduct A (FractionRing A) B)).toRingHom ((1 : FractionRing A) ⊗ₜ[A] z) (P.map (Polynomial.mapRingHom (algebraMap A (FractionRing A)))) = 0 ∧ (∀ G : Polynomial (Polynomial (FractionRing A)), G.natDegree < P.natDegree → Polynomial.eval₂ (Polynomial.aeval (R := FractionRing A) ((1 : FractionRing A) ⊗ₜ[A] y : TensorProduct A (FractionRing A) B)).toRingHom ((1 : FractionRing A) ⊗ₜ[A] z) G = 0 → G = 0) ∧ ∀ x : TensorProduct A (FractionRing A) B, ∃ (s : Polynomial (FractionRing A)) (h : Polynomial (Polynomial (FractionRing A))), s ≠ 0 ∧ Polynomial.aeval (R := FractionRing A) ((1 : FractionRing A) ⊗ₜ[A] y : TensorProduct A (FractionRing A) B) s * x ^ q = Polynomial.eval₂ (Polynomial.aeval (R := FractionRing A) ((1 : FractionRing A) ⊗ₜ[A] y : TensorProduct A (FractionRing A) B)).toRingHom ((1 : FractionRing A) ⊗ₜ[A] z) h :=
by

  have pm_s1 : ∀ (E F : Type u) [Field E] [Field F] [Algebra E F] [FiniteDimensional E F],
      ∃ (z : F) (q : ℕ), 0 < q ∧ (q = 1 ∨ ∃ p k : ℕ, p.Prime ∧ CharP E p ∧ q = p ^ k) ∧
        ∀ x : F, x ^ q ∈ Algebra.adjoin E {z} := by
    intro E F _ _ _ _
    haveI : Algebra.IsAlgebraic E F := Algebra.IsAlgebraic.of_finite E F
    haveI : FiniteDimensional E (separableClosure E F) :=
      IntermediateField.finiteDimensional_left (separableClosure E F)
    haveI : Algebra.IsSeparable E (separableClosure E F) := separableClosure.isSeparable E F
    obtain ⟨α, hα⟩ := Field.exists_primitive_element E (separableClosure E F)
    haveI : IsPurelyInseparable (separableClosure E F) F :=
      separableClosure.isPurelyInseparable E F
    haveI : FiniteDimensional (separableClosure E F) F :=
      IntermediateField.finiteDimensional_right (separableClosure E F)
    haveI : IsPurelyInseparable.HasExponent (separableClosure E F) F :=
      IsPurelyInseparable.hasExponent_of_finiteDimensional
    obtain ⟨e, he⟩ :=
      (IsPurelyInseparable.hasExponent_iff (separableClosure E F) F).mp inferInstance
    have key : ∀ r : ℕ, ExpChar (separableClosure E F) r →
        r = 1 ∨ (r.Prime ∧ CharP (separableClosure E F) r) := by
      intro r hr
      cases hr with
      | zero => left; rfl
      | prime hp => right; exact ⟨hp, inferInstance⟩
    refine ⟨(α : F), ringExpChar (separableClosure E F) ^ e, ?_, ?_, ?_⟩
    · rcases key _ (ringExpChar.expChar _) with h | ⟨h, _⟩
      · rw [h]; simp
      · exact pow_pos h.pos e
    · rcases key _ (ringExpChar.expChar _) with h | ⟨h, hc⟩
      · left; rw [h]; simp
      · right
        refine ⟨ringExpChar (separableClosure E F), e, h, ?_, rfl⟩
        exact (RingHom.charP_iff (algebraMap E (separableClosure E F))
          (algebraMap E (separableClosure E F)).injective _).mpr hc
    · intro x
      obtain ⟨β, hβ⟩ := he x
      have h1 : β ∈ IntermediateField.adjoin E {α} := by
        rw [hα]; exact IntermediateField.mem_top
      have h2 : β ∈ Algebra.adjoin E {α} := by
        rw [← IntermediateField.adjoin_simple_toSubalgebra_of_isAlgebraic
          (Algebra.IsAlgebraic.isAlgebraic α)]
        exact h1
      rw [Algebra.adjoin_singleton_eq_range_aeval] at h2
      obtain ⟨p, hp⟩ := h2
      rw [← hβ, Algebra.adjoin_singleton_eq_range_aeval]
      refine ⟨p, ?_⟩
      rw [← hp]
      exact Polynomial.aeval_algHom_apply (separableClosure E F).val α p

  have pm_s6 : ∀ (A B : Type u) [CommRing A] [IsDomain A] [CommRing B] [Algebra A B]
      (x : TensorProduct A (FractionRing A) B), ∃ (μ : A) (b : B), μ ≠ 0 ∧
        algebraMap A (FractionRing A) μ • x = (1 : FractionRing A) ⊗ₜ[A] b := by
    intro A B _ _ _ _ x
    have hs : ∀ (μ : A) (b : B),
        algebraMap A (FractionRing A) μ • ((1 : FractionRing A) ⊗ₜ[A] b)
          = (1 : FractionRing A) ⊗ₜ[A] (μ • b) := by
      intro μ b
      rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one, Algebra.algebraMap_eq_smul_one,
        TensorProduct.smul_tmul]
    induction x using TensorProduct.induction_on with
    | zero => exact ⟨1, 0, one_ne_zero, by simp⟩
    | tmul k b₀ =>
      obtain ⟨a, μ, hμ, rfl⟩ := IsFractionRing.div_surjective A k
      have hμ0 : μ ≠ 0 := nonZeroDivisors.ne_zero hμ
      have hκ : algebraMap A (FractionRing A) μ ≠ 0 :=
        (map_ne_zero_iff _ (IsFractionRing.injective A (FractionRing A))).mpr hμ0
      refine ⟨μ, a • b₀, hμ0, ?_⟩
      rw [TensorProduct.smul_tmul', smul_eq_mul, mul_div_cancel₀ _ hκ,
        Algebra.algebraMap_eq_smul_one, TensorProduct.smul_tmul]
    | add x₁ x₂ h₁ h₂ =>
      obtain ⟨μ₁, b₁, hμ₁, e₁⟩ := h₁
      obtain ⟨μ₂, b₂, hμ₂, e₂⟩ := h₂
      refine ⟨μ₁ * μ₂, μ₂ • b₁ + μ₁ • b₂, mul_ne_zero hμ₁ hμ₂, ?_⟩
      rw [map_mul, smul_add, mul_smul, mul_smul, e₂, smul_comm, e₁, hs, hs,
        TensorProduct.tmul_add]

  have pm_s2 : ∀ (K D E F : Type u) [Field K] [CommRing D] [IsDomain D] [Algebra K D] [Field E]
      [Algebra (Polynomial K) E] [IsFractionRing (Polynomial K) E] [Field F] [Algebra D F]
      [IsFractionRing D F] [Algebra E F] (w : D),
      (∀ c : Polynomial K, algebraMap E F (algebraMap (Polynomial K) E c) =
        algebraMap D F (Polynomial.aeval (R := K) w c)) →
      (∀ x : D, ∃ G : Polynomial (Polynomial K), G.Monic ∧
        Polynomial.eval₂ (Polynomial.aeval (R := K) w).toRingHom x G = 0) →
      ∀ f : F, ∃ (c : Polynomial K) (d : D), c ≠ 0 ∧
        algebraMap E F (algebraMap (Polynomial K) E c) * f = algebraMap D F d := by
    intro K D E F _ _ _ _ _ _ _ _ _ _ _ w hC hI f
    obtain ⟨n, m, hm, rfl⟩ := IsFractionRing.div_surjective D f
    have hm0 : m ≠ 0 := nonZeroDivisors.ne_zero hm
    letI : Algebra (Polynomial K) D := (Polynomial.aeval (R := K) w).toRingHom.toAlgebra
    have hint : IsIntegral (Polynomial K) m := by
      obtain ⟨G, hG, hG0⟩ := hI m
      exact ⟨G, hG, hG0⟩
    have h := Ideal.under_ne_bot_of_integral_mem (R := Polynomial K) (I := Ideal.span {m}) hm0
      (Ideal.subset_span rfl) hint
    obtain ⟨c, hc, hc0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot h
    have hc' : Polynomial.aeval (R := K) w c ∈ Ideal.span {m} := Ideal.mem_comap.mp hc
    obtain ⟨d', hd'⟩ := Ideal.mem_span_singleton'.mp hc'
    refine ⟨c, d' * n, hc0, ?_⟩
    have hmF : algebraMap D F m ≠ 0 :=
      (map_ne_zero_iff _ (IsFractionRing.injective D F)).mpr hm0
    rw [hC, ← hd', map_mul, map_mul]
    field_simp

  have pm_s3 : ∀ (K D E F : Type u) [Field K] [CommRing D] [IsDomain D] [Algebra K D]
      [Algebra.FiniteType K D] [Field E]
      [Algebra (Polynomial K) E] [IsFractionRing (Polynomial K) E] [Field F] [Algebra D F]
      [IsFractionRing D F] [Algebra E F] (w : D),
      (∀ c : Polynomial K, algebraMap E F (algebraMap (Polynomial K) E c) =
        algebraMap D F (Polynomial.aeval (R := K) w c)) →
      (∀ x : D, ∃ G : Polynomial (Polynomial K), G.Monic ∧
        Polynomial.eval₂ (Polynomial.aeval (R := K) w).toRingHom x G = 0) →
      (∀ f : F, ∃ (c : Polynomial K) (d : D), c ≠ 0 ∧
        algebraMap E F (algebraMap (Polynomial K) E c) * f = algebraMap D F d) →
      FiniteDimensional E F := by
    intro K D E F _ _ _ _ _ _ _ _ _ _ _ _ w hC hI hD
    classical
    letI : Algebra (Polynomial K) D := (Polynomial.aeval (R := K) w).toRingHom.toAlgebra
    haveI : IsScalarTower K (Polynomial K) D :=
      IsScalarTower.of_algebraMap_eq (fun k => ((Polynomial.aeval (R := K) w).commutes k).symm)
    haveI : Algebra.FiniteType (Polynomial K) D :=
      Algebra.FiniteType.of_restrictScalars_finiteType K (Polynomial K) D
    haveI : Algebra.IsIntegral (Polynomial K) D := ⟨fun x => by
      obtain ⟨G, hG, hG0⟩ := hI x
      exact ⟨G, hG, hG0⟩⟩
    haveI : Module.Finite (Polynomial K) D := Algebra.IsIntegral.finite
    obtain ⟨S, hS⟩ := (Module.Finite.fg_top : (⊤ : Submodule (Polynomial K) D).FG)
    refine Module.Finite.of_fg_top ⟨S.image (algebraMap D F), ?_⟩
    have key : ∀ d ∈ Submodule.span (Polynomial K) (S : Set D),
        algebraMap D F d ∈ Submodule.span E ((S.image (algebraMap D F) : Finset F) : Set F) := by
      intro d hd
      induction hd using Submodule.span_induction with
      | mem x hx =>
        exact Submodule.subset_span (Finset.mem_coe.mpr (Finset.mem_image_of_mem _ hx))
      | zero => rw [map_zero]; exact Submodule.zero_mem _
      | add x z _ _ hx hz => rw [map_add]; exact Submodule.add_mem _ hx hz
      | smul a x _ hx =>
        have : algebraMap D F (a • x) = algebraMap (Polynomial K) E a • algebraMap D F x := by
          rw [Algebra.smul_def, Algebra.smul_def, map_mul, hC]
          rfl
        rw [this]
        exact Submodule.smul_mem _ _ hx
    rw [eq_top_iff]
    intro f _
    obtain ⟨c, d, hc, hcd⟩ := hD f
    have hγ : algebraMap E F (algebraMap (Polynomial K) E c) ≠ 0 := by
      intro h
      apply hc
      exact (map_eq_zero_iff _ (IsFractionRing.injective _ E)).mp
        ((map_eq_zero_iff _ (algebraMap E F).injective).mp h)
    have hf : f = (algebraMap (Polynomial K) E c)⁻¹ • algebraMap D F d := by
      rw [Algebra.smul_def, map_inv₀, ← hcd, ← mul_assoc, inv_mul_cancel₀ hγ, one_mul]
    rw [hf]
    exact Submodule.smul_mem _ _ (key d (hS ▸ Submodule.mem_top))

  have pm_s4 : ∀ (K D E F : Type u) [Field K] [CommRing D] [IsDomain D] [Algebra K D] [Field E]
      [Algebra (Polynomial K) E] [IsFractionRing (Polynomial K) E] [Field F] [Algebra D F]
      [IsFractionRing D F] [Algebra E F] (w : D),
      (∀ c : Polynomial K, algebraMap E F (algebraMap (Polynomial K) E c) =
        algebraMap D F (Polynomial.aeval (R := K) w c)) →
      (∀ x : D, ∃ G : Polynomial (Polynomial K), G.Monic ∧
        Polynomial.eval₂ (Polynomial.aeval (R := K) w).toRingHom x G = 0) →
      (∀ f : F, ∃ (c : Polynomial K) (d : D), c ≠ 0 ∧
        algebraMap E F (algebraMap (Polynomial K) E c) * f = algebraMap D F d) →
      ∀ (z₀ : F) (q : ℕ), (∀ x : F, x ^ q ∈ Algebra.adjoin E {z₀}) →
      ∃ (z : D) (P : Polynomial (Polynomial K)), P.Monic ∧
        Polynomial.eval₂ (Polynomial.aeval (R := K) w).toRingHom z P = 0 ∧
        (∀ G : Polynomial (Polynomial K), G.natDegree < P.natDegree →
          Polynomial.eval₂ (Polynomial.aeval (R := K) w).toRingHom z G = 0 → G = 0) ∧
        ∀ x : D, ∃ (s : Polynomial K) (h : Polynomial (Polynomial K)), s ≠ 0 ∧
          Polynomial.aeval (R := K) w s * x ^ q =
            Polynomial.eval₂ (Polynomial.aeval (R := K) w).toRingHom z h := by
    intro K D E F _ _ _ _ _ _ _ _ _ _ _ w hC hI hD z₀ q hq
    have hι : Function.Injective (algebraMap D F) := IsFractionRing.injective D F
    have hε : Function.Injective (algebraMap (Polynomial K) E) := IsFractionRing.injective _ E
    letI : Algebra (Polynomial K) F :=
      ((algebraMap E F).comp (algebraMap (Polynomial K) E)).toAlgebra
    haveI : IsScalarTower (Polynomial K) E F := IsScalarTower.of_algebraMap_eq' rfl
    have hstar : algebraMap (Polynomial K) F =
        (algebraMap D F).comp (Polynomial.aeval (R := K) w).toRingHom := by
      apply RingHom.ext
      intro c
      exact hC c
    have hev : ∀ (G : Polynomial (Polynomial K)) (d : D),
        algebraMap D F (Polynomial.eval₂ (Polynomial.aeval (R := K) w).toRingHom d G) =
          Polynomial.aeval (algebraMap D F d) G := by
      intro G d
      rw [Polynomial.hom_eval₂, Polynomial.aeval_def, hstar]
    obtain ⟨c, d, hc, hcd⟩ := hD z₀
    have hγ : algebraMap E F (algebraMap (Polynomial K) E c) ≠ 0 := by
      intro h
      apply hc
      exact (map_eq_zero_iff _ hε).mp ((map_eq_zero_iff _ (algebraMap E F).injective).mp h)
    have hadj : Algebra.adjoin E {z₀} ≤ Algebra.adjoin E {algebraMap D F d} := by
      apply Algebra.adjoin_le
      rw [Set.singleton_subset_iff]
      have : z₀ = (algebraMap (Polynomial K) E c)⁻¹ • algebraMap D F d := by
        rw [Algebra.smul_def, map_inv₀, ← hcd, ← mul_assoc, inv_mul_cancel₀ hγ, one_mul]
      rw [this]
      exact Subalgebra.smul_mem _ (Algebra.self_mem_adjoin_singleton E (algebraMap D F d)) _
    have hintd : IsIntegral (Polynomial K) (algebraMap D F d) := by
      obtain ⟨G, hG, hG0⟩ := hI d
      refine ⟨G, hG, ?_⟩
      rw [← Polynomial.aeval_def, ← hev, hG0, map_zero]
    have hmin := minpoly.isIntegrallyClosed_eq_field_fractions' E hintd
    refine ⟨d, minpoly (Polynomial K) (algebraMap D F d), minpoly.monic hintd, ?_, ?_, ?_⟩
    · apply hι
      rw [hev, map_zero]
      exact minpoly.aeval _ _
    · intro G hdeg hG0
      by_contra hG
      have h1 : Polynomial.aeval (algebraMap D F d)
          (G.map (algebraMap (Polynomial K) E)) = 0 := by
        rw [Polynomial.aeval_map_algebraMap, ← hev, hG0, map_zero]
      have h2 := minpoly.degree_le_of_ne_zero E (algebraMap D F d)
        ((Polynomial.map_ne_zero_iff hε).mpr hG) h1
      rw [hmin, Polynomial.degree_map_eq_of_injective hε,
        Polynomial.degree_map_eq_of_injective hε] at h2
      have h3 := Polynomial.natDegree_le_natDegree h2
      omega
    · intro x
      have hx := hq (algebraMap D F x)
      have hx' := hadj hx
      rw [Algebra.adjoin_singleton_eq_range_aeval] at hx'
      obtain ⟨r, hr⟩ := hx'
      obtain ⟨b, hb, hbr⟩ := IsLocalization.integerNormalization_spec
        (nonZeroDivisors (Polynomial K)) r
      refine ⟨b, IsLocalization.integerNormalization (nonZeroDivisors (Polynomial K)) r,
        nonZeroDivisors.ne_zero hb, ?_⟩
      apply hι
      rw [hev, ← Polynomial.aeval_map_algebraMap E (algebraMap D F d)
        (IsLocalization.integerNormalization (nonZeroDivisors (Polynomial K)) r), hbr,
        ← IsScalarTower.algebraMap_smul E b r, map_smul]
