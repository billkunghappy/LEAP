  have s4 : ∀ (R : Type u) [CommRing R] (i j : Fin 2) (hij : i ≠ j) (f g : MvPolynomial (Fin 2) R) (hf : f ∈ MvPolynomial.homogeneousSubmodule (Fin 2) R 1) (hg : g ∈ MvPolynomial.homogeneousSubmodule (Fin 2) R 1) (hfX : f = MvPolynomial.X i) (hgX : g = MvPolynomial.X j),
