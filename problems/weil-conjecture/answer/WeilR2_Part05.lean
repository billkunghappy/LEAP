  obtain ⟨U, d, u, hd, hdu⟩ := hpt V _ hR v
  obtain ⟨η, hη⟩ := hd
  have hπ : Function.Surjective (ConcreteCategory.hom (T.homologyπ.app (Opposite.op U))) :=
    (AddCommGrpCat.epi_iff_surjective _).1 ((NatTrans.epi_iff_epi_app _).1 inferInstance _)
