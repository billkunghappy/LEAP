      (∀ x : TensorProduct A (FractionRing A) B, ∃ (s : Polynomial (FractionRing A)) (h : Polynomial (Polynomial (FractionRing A))), s ≠ 0 ∧ Polynomial.aeval (R := FractionRing A) ((1 : FractionRing A) ⊗ₜ[A] y : TensorProduct A (FractionRing A) B) s * x ^ q = Polynomial.eval₂ (Polynomial.aeval (R := FractionRing A) ((1 : FractionRing A) ⊗ₜ[A] y : TensorProduct A (FractionRing A) B)).toRingHom z' h) →
