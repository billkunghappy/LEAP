      intro n
      rw [Polynomial.coeff_scaleRoots]
      rcases lt_trichotomy n N with hn | hn | hn
      · obtain ⟨k, hk⟩ : ∃ k, N - n = k + 1 := ⟨N - n - 1, by omega⟩
