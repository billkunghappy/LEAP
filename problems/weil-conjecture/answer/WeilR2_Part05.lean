    exact ⟨Ω, inferInstance, inferInstance, vb, hvb, V', vb', hv, h, hh,
      fun zb hz => heq ⟨zb, hz⟩⟩
  · exfalso
    obtain ⟨c, z, hK, hNK⟩ := wc_fnp_fibre_functional ℓ N hℓ _ (hN Ω (vb ≫ V.hom)) M w hw
    have hy := (wc_fnp_relation_locus_geom_point p ℓ N I' c Ω (vb ≫ V.hom)
      (fun i => (z i).1) (fun i => (z i).2)).2 (by
