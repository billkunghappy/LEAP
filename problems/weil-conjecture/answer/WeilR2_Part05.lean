  choose nc hnc using hstab
  refine ⟨Finset.univ.sup nc, fun m hm => ?_⟩
  refine le_antisymm (S.monotone hm) ?_

  have h7 := wc_fnp_relation_locus_separates p ℓ N hℓ hN (I m) (I (Finset.univ.sup nc))
    (hstabI _) (hlocI _) (fun c => by
