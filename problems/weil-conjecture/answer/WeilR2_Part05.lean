  have hgp : (wcEtGeomPt B η) (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField η))) = η :=
    (Scheme.Hom.comp_apply _ _ _).trans (Scheme.fromSpecResidueField_apply _ _)
