    obtain ⟨c, hc, hmax⟩ := WellFounded.has_min (wellFounded_gt (α := Subobject X)) S hne
    refine ⟨c, hc, fun a ha => ?_⟩
    obtain ⟨d, hd, had, hcd⟩ := hdir a ha c hc
    have hdc : d = c := by
      by_contra hne'
      exact hmax d hd (lt_of_le_of_ne hcd (Ne.symm hne'))
    exact hdc ▸ had

  have hFt' : ℓ • 𝟙 F = 0 := by rw [← natCast_zsmul]; exact hFt
  obtain ⟨Λ, _, _, D, ψ, hC, hLS, hLI, hFP⟩ := wc_et_torsion_fp_filtered_system B ℓ F hFt'
  haveI : Nonempty Λ := IsFiltered.nonempty

  have hE : ∀ i : Λ, ∃ (Z : Scheme.{u}) (p : Z ⟶ B) (_ : IsFinite p)
      (e : D.obj i ⟶ (wcEtPush p).obj ((constantSheaf (Scheme.smallEtaleTopology Z)
        AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))))), Mono e := by
    intro i
    obtain ⟨U, V, g, h1, h2, h3, h4, h5, ⟨iso⟩⟩ := hFP i
    obtain ⟨Z, p, hp, e, he⟩ :=
      wc_et_fp_torsion_embed_finite_push K B fB ℓ hℓ.ne_zero U V g h1 h2 h3 h4 h5
    haveI := he
    exact ⟨Z, p, hp, iso.hom ≫ e, inferInstance⟩

  obtain ⟨i₀, hi₀⟩ : ∃ i₀ : Λ, ∀ j, Limits.imageSubobject (ψ j) ≤ Limits.imageSubobject (ψ i₀) := by
    obtain ⟨c, ⟨i₀, rfl⟩, hc⟩ := dirMax F hFn (Set.range fun j => Limits.imageSubobject (ψ j))
      (Set.range_nonempty _) (by
        rintro _ ⟨j, rfl⟩ _ ⟨j', rfl⟩
        refine ⟨_, ⟨IsFiltered.max j j', rfl⟩, ?_, ?_⟩
        · exact Limits.imageSubobject_le _
            (D.map (IsFiltered.leftToMax j j') ≫ Limits.factorThruImageSubobject (ψ _))
            (by rw [Category.assoc, Limits.imageSubobject_arrow_comp, hC])
        · exact Limits.imageSubobject_le _
            (D.map (IsFiltered.rightToMax j j') ≫ Limits.factorThruImageSubobject (ψ _))
            (by rw [Category.assoc, Limits.imageSubobject_arrow_comp, hC]))
    exact ⟨i₀, fun j => hc _ ⟨j, rfl⟩⟩

  haveI hepi : Epi (ψ i₀) := by
    apply Preadditive.epi_of_cancel_zero
    intro R g hg
    have hA : (Limits.imageSubobject (ψ i₀)).arrow ≫ g = 0 := by
      rw [← cancel_epi (Limits.factorThruImageSubobject (ψ i₀)), Limits.comp_zero, ← Category.assoc,
        Limits.imageSubobject_arrow_comp, hg]
    have hj : ∀ j, ψ j ≫ g = 0 := by
      intro j
      rw [← Limits.imageSubobject_arrow_comp (ψ j), ← Subobject.ofLE_arrow (hi₀ j), Category.assoc,
        Category.assoc, hA, Limits.comp_zero, Limits.comp_zero]
    apply text
    intro V s
    apply R.isSeparated V _ (hLS V s)
    intro W f hf
    obtain ⟨W', h, g', ⟨i, t, ht⟩, rfl⟩ := hf
    show (R.obj.map (h ≫ g').op).hom ((g.hom.app (Opposite.op V)).hom s) =
      (R.obj.map (h ≫ g').op).hom 0
    rw [map_zero, tnat, op_comp, Functor.map_comp, AddCommGrpCat.comp_apply, ← ht, tnat, ← tcomp,
      hj i, tzero]

  have hD : IsNoetherianObject (D.obj i₀) := by
    obtain ⟨Z, p, hp, e, he⟩ := hE i₀
    haveI := hp
    haveI := he
    haveI := wc_et_finite_push_const_noetherian K B fB Z p ℓ hℓ
    exact isNoetherianObject_of_mono e

  have hkle : ∀ {j j' : Λ} (f : i₀ ⟶ j) (g : j ⟶ j'),
      Limits.kernelSubobject (D.map f) ≤ Limits.kernelSubobject (D.map (f ≫ g)) := by
    intro j j' f g
    refine Subobject.le_of_comm
      (Limits.factorThruKernelSubobject _ (Limits.kernelSubobject (D.map f)).arrow ?_)
      (Limits.factorThruKernelSubobject_comp_arrow _ _ _)
    rw [D.map_comp, ← Category.assoc, Limits.kernelSubobject_arrow_comp, Limits.zero_comp]
  obtain ⟨j₀, f₀, hf₀⟩ : ∃ (j₀ : Λ) (f₀ : i₀ ⟶ j₀), ∀ (j : Λ) (f : i₀ ⟶ j),
      Limits.kernelSubobject (D.map f) ≤ Limits.kernelSubobject (D.map f₀) := by
    obtain ⟨c, ⟨⟨j₀, f₀⟩, rfl⟩, hc⟩ := dirMax (D.obj i₀) hD
      (Set.range fun x : (Σ j : Λ, (i₀ ⟶ j)) => Limits.kernelSubobject (D.map x.2))
      ⟨_, ⟨⟨i₀, 𝟙 i₀⟩, rfl⟩⟩ (by
        rintro _ ⟨⟨j, f⟩, rfl⟩ _ ⟨⟨j', f'⟩, rfl⟩
        let a := IsFiltered.leftToMax j j'
        let b := IsFiltered.rightToMax j j'
        let h := IsFiltered.coeqHom (f ≫ a) (f' ≫ b)
        have heq : f' ≫ b ≫ h = f ≫ a ≫ h := by
          simpa only [Category.assoc] using (IsFiltered.coeq_condition (f ≫ a) (f' ≫ b)).symm
        refine ⟨_, ⟨⟨_, f ≫ a ≫ h⟩, rfl⟩, hkle f (a ≫ h), ?_⟩
        have := hkle f' (b ≫ h)
        rwa [heq] at this)
    exact ⟨j₀, f₀, fun j f => hc _ ⟨⟨j, f⟩, rfl⟩⟩

  have hk : Limits.kernel.ι (ψ i₀) ≫ D.map f₀ = 0 := by
    have hfac : ∀ (j : Λ) (f : i₀ ⟶ j) (W : B.Etale) (x : (D.obj i₀).obj.obj (Opposite.op W)),
        ((D.map f).hom.app (Opposite.op W)).hom x = 0 →
          ((D.map f₀).hom.app (Opposite.op W)).hom x = 0 := by
      intro j f W x hx
      have hke : Limits.kernel.ι (Limits.factorThruImage (D.map f)) ≫ D.map f₀ = 0 := by
        have h1 : (Limits.kernelSubobject (D.map f)).Factors
            (Limits.kernel.ι (Limits.factorThruImage (D.map f))) :=
          Limits.kernelSubobject_factors _ _ (by
            have e : Limits.kernel.ι (Limits.factorThruImage (D.map f)) ≫ D.map f =
                (Limits.kernel.ι (Limits.factorThruImage (D.map f)) ≫
                  Limits.factorThruImage (D.map f)) ≫ Limits.image.ι (D.map f) := by
              rw [Category.assoc, Limits.image.fac]
            rw [e, Limits.kernel.condition, Limits.zero_comp])
        exact (Limits.kernelSubobject_factors_iff _ _).1 (Subobject.factors_of_le _ (hf₀ j f) h1)
      have hu := Abelian.comp_epiDesc (Limits.factorThruImage (D.map f)) (D.map f₀) hke
      have hm : Function.Injective ((Limits.image.ι (D.map f)).hom.app (Opposite.op W)).hom := by
        have : Mono ((sheafToPresheaf _ _ ⋙ (evaluation _ _).obj (Opposite.op W)).map
            (Limits.image.ι (D.map f))) := inferInstance
        exact (AddCommGrpCat.mono_iff_injective _).1 this
      have hex : ((Limits.factorThruImage (D.map f)).hom.app (Opposite.op W)).hom x = 0 := by
        apply hm
        rw [map_zero, ← tcomp, Limits.image.fac]
        exact hx
      rw [← hu, tcomp, hex, map_zero]
    apply text
    intro V n
    rw [tcomp]
    have hψt : ((ψ i₀).hom.app (Opposite.op V)).hom
        (((Limits.kernel.ι (ψ i₀)).hom.app (Opposite.op V)).hom n) = 0 := by
      rw [← tcomp, Limits.kernel.condition, tzero]
    apply (D.obj j₀).isSeparated V _ (hLI i₀ V _ hψt)
    intro W f hf
    obtain ⟨W', h, g', ⟨j, f, hjf⟩, rfl⟩ := hf
    show ((D.obj j₀).obj.map (h ≫ g').op).hom _ = ((D.obj j₀).obj.map (h ≫ g').op).hom 0
    rw [map_zero, tnat, op_comp, Functor.map_comp, AddCommGrpCat.comp_apply, ← tnat,
      hfac j f W' _ hjf, map_zero]

  let ι₀ : F ⟶ D.obj j₀ := Abelian.epiDesc (ψ i₀) (D.map f₀) hk
  have hι₀ : ψ i₀ ≫ ι₀ = D.map f₀ := Abelian.comp_epiDesc (ψ i₀) (D.map f₀) hk
  have hsec : ι₀ ≫ ψ j₀ = 𝟙 F := by
    rw [← cancel_epi (ψ i₀), ← Category.assoc, hι₀, hC, Category.comp_id]
  haveI hι₀m : Mono ι₀ := mono_of_mono_fac hsec

  obtain ⟨Z, p, hp, e, he⟩ := hE j₀
  haveI := hp
  haveI := he
  haveI hGn := wc_et_finite_push_const_noetherian K B fB Z p ℓ hℓ
  have hM : (ℓ : ℤ) • 𝟙 ((constantSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))) = 0 := by
    have h0 : (ℓ : ℤ) • 𝟙 (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))) = 0 := by
      ext x
      simp
    rw [← CategoryTheory.Functor.map_id (constantSheaf (Scheme.smallEtaleTopology Z)
        AddCommGrpCat.{u+1}), ← CategoryTheory.Functor.map_zsmul, h0,
      CategoryTheory.Functor.map_zero]
  have hG : (ℓ : ℤ) • 𝟙 ((wcEtPush p).obj ((constantSheaf (Scheme.smallEtaleTopology Z)
      AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))))) = 0 := by
    rw [← CategoryTheory.Functor.map_id (wcEtPush p), ← CategoryTheory.Functor.map_zsmul, hM,
      CategoryTheory.Functor.map_zero]
  refine ⟨(wcEtPush p).obj ((constantSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))), ι₀ ≫ e, 1, fun _ => Z, fun _ => p,
    fun _ => 𝟙 _, fun _ => 𝟙 _, inferInstance, fun _ => hp, ?_, ?_, ?_⟩
  · rw [Fin.sum_univ_one, Category.id_comp]
  · exact quotNoeth (Limits.cokernel.π (ι₀ ≫ e)) hGn
  · rw [← cancel_epi (Limits.cokernel.π (ι₀ ≫ e)), Preadditive.comp_zsmul, Category.comp_id,
      Limits.comp_zero]
    rw [show (ℓ : ℤ) • Limits.cokernel.π (ι₀ ≫ e) =
        ((ℓ : ℤ) • 𝟙 _) ≫ Limits.cokernel.π (ι₀ ≫ e) by
      rw [Preadditive.zsmul_comp, Category.id_comp], hG, Limits.zero_comp]

theorem wc_et_fibration_finite : ∀ (K : Type u) [Field K] [IsAlgClosed K] (X B : Scheme.{u})
    (fB : B ⟶ Spec (.of K)) [IsProper fB] (g : X ⟶ B) [IsProper g] (ℓ : ℕ), ℓ.Prime →
    (ℓ : K) ≠ 0 → ∀ n : ℕ, topologicalKrullDim B ≤ (n : WithBot ℕ∞) →
    (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (t : Spec (.of Ω) ⟶ B),
      topologicalKrullDim ↥(Limits.pullback g t) ≤ ((1 : ℕ) : WithBot ℕ∞)) →
    (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (C : Scheme.{u}) (fC : C ⟶ Spec (.of Ω))
      [IsProper fC], (ℓ : Ω) ≠ 0 → topologicalKrullDim C ≤ ((1 : ℕ) : WithBot ℕ∞) →
      ∀ q : ℕ, Finite (wcEtCoh C ℓ q)) →
    (∀ (W : Scheme.{u}) (w : W ⟶ Spec (.of K)) [IsProper w],
      topologicalKrullDim W ≤ (n : WithBot ℕ∞) → ∀ q : ℕ, Finite (wcEtCoh W ℓ q)) →
    ∀ q : ℕ, Finite (wcEtCoh X ℓ q) :=
by
  intro K _ _ X B fB _ g _ ℓ hℓ hℓK n hB hfib hcurve hIH q
  classical
  haveI := wc_et_enough_injectives X
  haveI := wc_et_enough_injectives B
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) := HasExt.standard _
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}) := HasExt.standard _

  have hM : ∀ (Y : Scheme.{u}), (ℓ : ℤ) • 𝟙 ((constantSheaf (Scheme.smallEtaleTopology Y)
      AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))) = 0 := by
    intro Y
    have h0 : (ℓ : ℤ) • 𝟙 (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))) = 0 := by
      ext x
      simp
    rw [← CategoryTheory.Functor.map_id (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}),
      ← CategoryTheory.Functor.map_zsmul, h0, CategoryTheory.Functor.map_zero]

  have htors : ∀ (I : InjectiveResolution ((constantSheaf (Scheme.smallEtaleTopology X)
      AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))))) (q' : ℕ),
      (ℓ : ℤ) • 𝟙 ((((wcEtPush g).mapHomologicalComplex (ComplexShape.up ℕ)).obj
        I.cocomplex).homology q') = 0 := by
    intro I q'
    have h1 : I.ι ≫ ((ℓ : ℤ) • 𝟙 I.cocomplex) =
        (CochainComplex.single₀ _).map ((ℓ : ℤ) • 𝟙 _) ≫ I.ι := by
      rw [CategoryTheory.Functor.map_zsmul, CategoryTheory.Functor.map_id, Preadditive.zsmul_comp,
        Category.id_comp, Preadditive.comp_zsmul, Category.comp_id]
    have h2 : I.ι ≫ (0 : I.cocomplex ⟶ I.cocomplex) =
        (CochainComplex.single₀ _).map ((ℓ : ℤ) • 𝟙 _) ≫ I.ι := by
      rw [hM X, CategoryTheory.Functor.map_zero, Limits.comp_zero, Limits.zero_comp]
    have ho := (wcEtPush g).mapHomotopy (InjectiveResolution.descHomotopy _ _ _ h1 h2)
    have e1 := Homotopy.homologyMap_eq ho q'
    rw [CategoryTheory.Functor.map_zsmul, CategoryTheory.Functor.map_id,
      CategoryTheory.Functor.map_zero, HomologicalComplex.homologyMap_zero] at e1
    have e2 : HomologicalComplex.homologyMap ((ℓ : ℤ) • 𝟙 (((wcEtPush g).mapHomologicalComplex
        (ComplexShape.up ℕ)).obj I.cocomplex)) q' = (ℓ : ℤ) • 𝟙 _ := by
      rw [← HomologicalComplex.homologyFunctor_map, CategoryTheory.Functor.map_zsmul,
        CategoryTheory.Functor.map_id]
      rfl
    rw [← e2]
    exact e1

  have hretract : ∀ (G : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}) (r : ℕ)
      (H : Fin r → Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1})
      (pr : ∀ i, G ⟶ H i) (ι' : ∀ i, H i ⟶ G), ∑ i, pr i ≫ ι' i = 𝟙 G → ∀ p : ℕ,
      (∀ i, Finite (Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology B)
        AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) (H i) p)) →
      Finite (Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology B)
        AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) G p) := by
    intro G r H pr ι' hsum p hH
    haveI := hH
    have key : ∀ z : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology B)
        AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) G p,
        z = ∑ i, (z.comp (Abelian.Ext.mk₀ (pr i)) (add_zero p)).comp
          (Abelian.Ext.mk₀ (ι' i)) (add_zero p) := by
      intro z
      calc z = z.comp (Abelian.Ext.mk₀ (𝟙 G)) (add_zero p) := (Abelian.Ext.comp_mk₀_id z).symm
        _ = z.comp (Abelian.Ext.mk₀ (∑ i, pr i ≫ ι' i)) (add_zero p) := by rw [hsum]
        _ = ∑ i, z.comp (Abelian.Ext.mk₀ (pr i ≫ ι' i)) (add_zero p) := by
            rw [Abelian.Ext.mk₀_sum, Abelian.Ext.comp_sum]
        _ = _ := by
            refine Finset.sum_congr rfl (fun i _ => ?_)
            rw [Abelian.Ext.comp_assoc _ _ _ (add_zero p) (add_zero 0) (by omega),
              Abelian.Ext.mk₀_comp_mk₀]
    refine Finite.of_injective
      (fun z => fun i => z.comp (Abelian.Ext.mk₀ (pr i)) (add_zero p)) ?_
    intro x y hxy
    rw [key x, key y]
    exact Finset.sum_congr rfl (fun i _ =>
      congrArg (fun w => w.comp (Abelian.Ext.mk₀ (ι' i)) (add_zero p)) (congrFun hxy i))

  have hcores : ∀ (N : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1} → Prop),
      (∀ F, N F → ∃ (G : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}) (ι : F ⟶ G),
        Mono ι ∧ N (Limits.cokernel ι) ∧ ∀ p : ℕ, Finite (Abelian.Ext ((constantSheaf
          (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}).obj
            (AddCommGrpCat.of (ULift.{u+1} ℤ))) G p)) →
      ∀ (p : ℕ) (F : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}), N F →
        Finite (Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology B)
          AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) F p) := by
    intro N hN p
    induction p with
    | zero =>
      intro F hF
      obtain ⟨G, ι, hmono, _, hG⟩ := hN F hF
      haveI := hmono
      haveI := hG 0
      let φ := (Abelian.Ext.mk₀ ι).postcomp ((constantSheaf (Scheme.smallEtaleTopology B)
          AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) (add_zero 0)
      refine Finite.of_injective φ ?_
      rw [injective_iff_map_eq_zero]
      intro x hx
      obtain ⟨f, rfl⟩ : ∃ f, Abelian.Ext.mk₀ f = x := ⟨_, Abelian.Ext.mk₀_homEquiv₀_apply x⟩
      have hx' : Abelian.Ext.mk₀ (f ≫ ι) = Abelian.Ext.mk₀ 0 := by
        rw [← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_zero]
        exact hx
      rw [← Abelian.Ext.homEquiv₀_symm_apply, ← Abelian.Ext.homEquiv₀_symm_apply] at hx'
      have hf : f ≫ ι = 0 := Abelian.Ext.homEquiv₀.symm.injective hx'
      rw [Limits.zero_of_comp_mono ι hf, Abelian.Ext.mk₀_zero]
    | succ p ih =>
      intro F hF
      obtain ⟨G, ι, hmono, hNc, hG⟩ := hN F hF
      let P := (constantSheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ))
      let T := ShortComplex.mk ι (Limits.cokernel.π ι) (Limits.cokernel.condition ι)
      have hTs : T.ShortExact :=
        ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel ι) hmono inferInstance
      change Finite (Abelian.Ext P T.X₁ (p + 1))
      haveI h2 : Finite (Abelian.Ext P T.X₂ (p + 1)) := hG (p + 1)
      haveI h3 : Finite (Abelian.Ext P T.X₃ p) := ih _ hNc
      let φ : Abelian.Ext P T.X₁ (p + 1) →+ Abelian.Ext P T.X₂ (p + 1) :=
        (Abelian.Ext.mk₀ T.f).postcomp P (add_zero (p + 1))
      let δ : Abelian.Ext P T.X₃ p →+ Abelian.Ext P T.X₁ (p + 1) :=
        hTs.extClass.postcomp P rfl
      have hex : ∀ x, φ x = 0 → ∃ y, δ y = x := fun x hx =>
        Abelian.Ext.covariant_sequence_exact₁ P hTs x hx rfl
      haveI : Nonempty (Abelian.Ext P T.X₁ (p + 1)) := ⟨0⟩
      let σ : Abelian.Ext P T.X₂ (p + 1) → Abelian.Ext P T.X₁ (p + 1) := Function.invFun φ
      have hσ : ∀ x, φ (σ (φ x)) = φ x := fun x => Function.invFun_eq ⟨x, rfl⟩
      have hpre : ∀ x, ∃ y, δ y = x - σ (φ x) := fun x =>
        hex _ (by rw [map_sub, hσ, sub_self])
      choose τ hτ using hpre
      refine Finite.of_injective (fun x => (φ x, τ x)) ?_
      intro x x' hxx
      simp only [Prod.mk.injEq] at hxx
      obtain ⟨e1, e2⟩ := hxx
      have := hτ x
      rw [e2, hτ x', e1] at this
      exact (sub_left_inj.mp this).symm

  have hpush : ∀ (B' : Scheme.{u}) (π : B' ⟶ B) [IsFinite π] (p : ℕ),
      Finite (Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ))) ((wcEtPush π).obj ((constantSheaf
          (Scheme.smallEtaleTopology B') AddCommGrpCat.{u+1}).obj
            (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))))) p) := by
    intro B' π _ p
    haveI := wc_et_enough_injectives B'
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology B') AddCommGrpCat.{u+1}) := HasExt.standard _
    obtain ⟨Lπ, ⟨adj⟩, hPFL, ⟨e⟩⟩ := wc_et_push_left_adjoint π
    haveI := hPFL
    haveI : Limits.PreservesFiniteColimits (wcEtPush π) := wc_et_finite_push_exact π
    haveI : Limits.PreservesFiniteLimits (wcEtPush π) := by
      have : Limits.PreservesLimitsOfSize.{0, 0} (wcEtPush π) :=
        adj.rightAdjoint_preservesLimits
      infer_instance
    have hdim : topologicalKrullDim B' ≤ (n : WithBot ℕ∞) :=
      (wc_finite_topologicalKrullDim_le π).trans hB
    have hfin0 : Finite (Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology B')
        AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) ((constantSheaf
          (Scheme.smallEtaleTopology B') AddCommGrpCat.{u+1}).obj
            (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))) p) :=
      hIH B' (π ≫ fB) hdim p
    have hfin1 : Finite (Abelian.Ext (Lπ.obj ((constantSheaf (Scheme.smallEtaleTopology B)
        AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)))) ((constantSheaf
          (Scheme.smallEtaleTopology B') AddCommGrpCat.{u+1}).obj
            (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))) p) := by
      refine Finite.of_injective
        (fun y => (Abelian.Ext.mk₀ e.inv).comp y (zero_add p)) ?_
      intro y y' hyy
      have h := congrArg (fun z => (Abelian.Ext.mk₀ e.hom).comp z (zero_add p)) hyy
      simp only [Abelian.Ext.mk₀_comp_mk₀_assoc, Iso.hom_inv_id, Abelian.Ext.mk₀_id_comp] at h
      exact h
    exact Finite.of_surjective _ (wc_ext_adjoint_transfer Lπ (wcEtPush π) adj
      ((constantSheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ))) _ p).2

  let I : InjectiveResolution ((constantSheaf (Scheme.smallEtaleTopology X)
      AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))) := injectiveResolution _
  obtain ⟨L, ⟨adj⟩, hPFL, ⟨e⟩⟩ := wc_et_push_left_adjoint g
  haveI := hPFL
  have hstalk := wc_et_proper_stalk_coh g ℓ hℓ.ne_zero wc_et_henselian_proper_vanishing I
  have hnoeth := wc_et_proper_curve_fibration_constructible K X B fB g ℓ hℓ hℓK hfib hcurve
    wc_et_henselian_proper_vanishing I hstalk
  have hEB : ∀ p q' : ℕ, Finite (Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology B)
      AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)))
      ((((wcEtPush g).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q')
        p) := by
    intro p q'
    refine hcores (fun F => IsNoetherianObject F ∧ (ℓ : ℤ) • 𝟙 F = 0) ?_ p _
      ⟨hnoeth q', htors I q'⟩
    rintro F ⟨hFn, hFt⟩
    obtain ⟨G, ι, r, B', π, pr, ι', hmono, hfin, hsum, hcn, hct⟩ :=
      wc_et_noetherian_torsion_embedding K B fB ℓ hℓ F hFn hFt
    refine ⟨G, ι, hmono, ⟨hcn, hct⟩, fun p' => ?_⟩
    exact hretract G r _ pr ι' hsum p' (fun i => by
      haveI := hfin i
      exact hpush (B' i) (π i) p')
  have hk := wc_leray_ext_finite L (wcEtPush g) adj
    ((constantSheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} ℤ))) _ I hEB q

  show Finite (Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology X)
      AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) ((constantSheaf
        (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))) q)
  haveI := hk
  refine Finite.of_injective (fun y => (Abelian.Ext.mk₀ e.hom).comp y (zero_add q)) ?_
  intro y y' hyy
  have h := congrArg (fun z => (Abelian.Ext.mk₀ e.inv).comp z (zero_add q)) hyy
  simp only [Abelian.Ext.mk₀_comp_mk₀_assoc, Iso.inv_hom_id, Abelian.Ext.mk₀_id_comp] at h
  exact h

theorem wc_etale_proper_finite : ∀ (K : Type u) [Field K] [IsAlgClosed K] (Y : Scheme.{u})
    (f : Y ⟶ Spec (.of K)) [IsProper f] (m : ℕ), (m : K) ≠ 0 →
    ∀ i : ℕ, Finite (wcEtCoh Y m i) :=
by
  intro K _ _ Y f _ m hm i

  have hm0 : m ≠ 0 := by
    rintro rfl
    exact hm Nat.cast_zero

  have hP : ∀ (ℓ : ℕ), ℓ.Prime → ∀ n : ℕ, ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
      (W : Scheme.{u}) (w : W ⟶ Spec (.of Ω)) [IsProper w], (ℓ : Ω) ≠ 0 →
      topologicalKrullDim W ≤ (n : WithBot ℕ∞) → ∀ q : ℕ, Finite (wcEtCoh W ℓ q) := by
    intro ℓ hℓ n
    induction n with
    | zero =>
      intro Ω _ _ W w _ hℓΩ hW
      exact wc_et_proper_curve_finite Ω W w ℓ hℓ hℓΩ
        (hW.trans (Nat.mono_cast (Nat.zero_le 1)))
    | succ n IH =>
      intro Ω _ _ W w _ hℓΩ hW
      obtain ⟨X', b, Z, iZ, B, fB, g, hb, hiZ, hfB, hg, hiso, hB, hZ, hE, hfib⟩ :=
        wc_proper_curve_fibration_cover Ω W w n hW
      haveI := hb
      haveI := hiZ
      haveI := hfB
      haveI := hg
      refine wc_et_abstract_blowup_finite W X' Z b iZ hiso ℓ hℓ.ne_zero ?_ ?_ ?_
      · exact wc_et_fibration_finite Ω X' B fB g ℓ hℓ hℓΩ n hB hfib
          (fun Ω' _ _ C fC _ hΩ' hC => wc_et_proper_curve_finite Ω' C fC ℓ hℓ hΩ' hC)
          (fun V v _ hV => IH Ω V v hℓΩ hV)
      · exact IH Ω Z (iZ ≫ w) hℓΩ hZ
      · exact IH Ω (Limits.pullback b iZ) (Limits.pullback.snd b iZ ≫ iZ ≫ w) hℓΩ hE

  obtain ⟨n₀, hn₀⟩ := wc_proper_finite_dim K Y f

  refine wc_et_coh_coeff_devissage Y m hm0 ?_ i
  intro p hp hpm
  obtain ⟨k, rfl⟩ := hpm
  have hpK : (p : K) ≠ 0 := by
    intro h
    apply hm
    rw [Nat.cast_mul, h, zero_mul]
  exact hP p hp n₀ K Y f hpK hn₀

theorem wc_coh_mod_ell_finite (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    [GeometricallyIrreducible X.hom] [IsProper X.hom] (d : ℕ) [SmoothOfRelativeDimension d X.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F)
    (h : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))) :
    ∀ i : ℕ, Finite (Abelian.Ext (wcFreeSheaf X.left (wcGeomPoint F X h))
      (Limits.cokernel (wcIntScalar X.left ℓ (ℓ : ℤ_[ℓ]))) i) :=
by
  intro i

  obtain ⟨e⟩ := wc_int_coker_zmod X.left ℓ 1 (ℓ : ℤ_[ℓ]) (pow_one _).symm
  let E₁ : Abelian.Ext (wcFreeSheaf X.left (wcGeomPoint F X h))
      (Limits.cokernel (wcIntScalar X.left ℓ (ℓ : ℤ_[ℓ]))) i ≃
      Abelian.Ext (wcFreeSheaf X.left (wcGeomPoint F X h)) (wcZModSheaf X.left (ℓ ^ 1)) i :=
    { toFun := fun x => x.comp (Abelian.Ext.mk₀ e.hom) (add_zero i)
      invFun := fun y => y.comp (Abelian.Ext.mk₀ e.inv) (add_zero i)
      left_inv := fun x => by
        simp only
        rw [Abelian.Ext.comp_assoc _ _ _ (add_zero i) (add_zero 0) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
      right_inv := fun y => by
        simp only
        rw [Abelian.Ext.comp_assoc _ _ _ (add_zero i) (add_zero 0) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.comp_mk₀_id] }

  obtain ⟨E₂⟩ := wc_ext_free_slice_zmod X.left (wcGeomPoint F X h) (ℓ ^ 1) i

  let fY : (wcGeomPoint F X h).left ⟶ Spec (.of (AlgebraicClosure F)) :=
    Limits.pullback.snd X.hom (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))
  haveI hprop : IsProper fY :=
    (show IsProper (Limits.pullback.snd X.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) :
        (wcGeomPoint F X h).left ⟶ Spec (.of (AlgebraicClosure F))) from inferInstance)
  obtain ⟨E₃⟩ := wc_proet_etale_comparison_zmod (AlgebraicClosure F) (wcGeomPoint F X h).left
    fY (ℓ ^ 1) i

  have hne : (((ℓ ^ 1 : ℕ)) : AlgebraicClosure F) ≠ 0 := by
    intro h0
    rw [pow_one] at h0
    have hp : ringChar F ∣ ℓ := (CharP.cast_eq_zero_iff (AlgebraicClosure F) (ringChar F) ℓ).mp h0
    have hpp : Nat.Prime (ringChar F) := CharP.char_is_prime F (ringChar F)
    have hpl : ringChar F = ℓ := (Nat.prime_dvd_prime_iff_eq hpp (Fact.out)).mp hp
    letI := Fintype.ofFinite F
    have hc : ((Nat.card F : ℕ) : F) = 0 := by
      rw [Nat.card_eq_fintype_card]; exact FiniteField.cast_card_eq_zero F
    have hdvd : ringChar F ∣ Nat.card F := (ringChar.spec F _).mp hc
    exact hℓ (hpl ▸ hdvd)
  haveI hfin := wc_etale_proper_finite (AlgebraicClosure F) (wcGeomPoint F X h).left
    fY (ℓ ^ 1) hne i

  haveI h3 := Finite.of_equiv _ E₃.symm
  haveI h2 := Finite.of_equiv _ E₂.symm
  exact Finite.of_equiv _ E₁.symm

theorem wc_contSheaf_shortExact : ∀ (S : Scheme.{u}) {A B C : Type} [AddCommGroup A] [TopologicalSpace A] [IsTopologicalAddGroup A] [AddCommGroup B] [TopologicalSpace B] [IsTopologicalAddGroup B] [AddCommGroup C] [TopologicalSpace C] [IsTopologicalAddGroup C] (φ : A →+ B) (hφ : Continuous φ) (ψ : B →+ C) (hψ : Continuous ψ), Topology.IsEmbedding φ → (∀ b : B, ψ b = 0 ↔ ∃ a : A, φ a = b) → (∃ σ : C → B, Continuous σ ∧ ∀ c, ψ (σ c) = c) → ∃ hzero : wcContSheafMap S φ hφ ≫ wcContSheafMap S ψ hψ = 0, (ShortComplex.mk (wcContSheafMap S φ hφ) (wcContSheafMap S ψ hψ) hzero).ShortExact :=
by
  intro S A B C _ _ _ _ _ _ _ _ _ φ hφ ψ hψ hemb hker hsec
  obtain ⟨σ, hσc, hσ⟩ := hsec

  have crit : ∀ {F G H : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} (f : F ⟶ G)
      (g : G ⟶ H),
      (∀ U (x : F.obj.obj U), g.hom.app U (f.hom.app U x) = 0) →
      (∀ U, Function.Injective (f.hom.app U)) →
      (∀ U, Function.Surjective (g.hom.app U)) →
      (∀ U (x : G.obj.obj U), g.hom.app U x = 0 → ∃ y, f.hom.app U y = x) →
      ∃ hzero : f ≫ g = 0, (ShortComplex.mk f g hzero).ShortExact := by
    intro F G H f g h1 h0 h2 h3
    have hzero : ∀ {X Y : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} (U : S.ProEtᵒᵖ)
        (y : X.obj.obj U), (0 : X ⟶ Y).hom.app U y = 0 := by
      intro X Y U y
      rfl
    have hcomp : ∀ {X Y Z : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} (p : X ⟶ Y)
        (q : Y ⟶ Z) (U : S.ProEtᵒᵖ) (y : X.obj.obj U),
        (p ≫ q).hom.app U y = q.hom.app U (p.hom.app U y) := by
      intro X Y Z p q U y
      rfl
    have w : f ≫ g = 0 := by
      apply Sheaf.hom_ext
      ext U x
      rw [hcomp, hzero, h1]
    haveI : Epi g := by
      haveI : ∀ U, Epi (g.hom.app U) := fun U => (AddCommGrpCat.epi_iff_surjective _).mpr (h2 U)
      haveI : Epi g.hom := NatTrans.epi_of_epi_app _
      exact Sheaf.Hom.epi_of_presheaf_epi _ _ _
    haveI : Mono f := by
      haveI : ∀ U, Mono (f.hom.app U) := fun U => (AddCommGrpCat.mono_iff_injective _).mpr (h0 U)
      haveI : Mono f.hom := NatTrans.mono_of_mono_app _
      exact Sheaf.Hom.mono_of_presheaf_mono _ _ _
    have fac : ∀ {A : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} (k : G ⟶ A),
        f ≫ k = 0 → {l : H ⟶ A // g ≫ l = k} := by
      intro A k hk
      have hk' : ∀ U (y : F.obj.obj U), k.hom.app U (f.hom.app U y) = 0 := by
        intro U y
        have := congrArg (fun φ => φ.hom.app U y) hk
        simp only at this
        rw [hcomp, hzero] at this
        exact this
      have hd : ∀ U (x x' : G.obj.obj U), g.hom.app U x = g.hom.app U x' →
          k.hom.app U x = k.hom.app U x' := by
        intro U x x' hxx
        obtain ⟨y, hy⟩ := h3 U (x - x') (by rw [map_sub, hxx, sub_self])
        have := hk' U y
        rw [hy, map_sub, sub_eq_zero] at this
        exact this
      let σ : ∀ U, H.obj.obj U → G.obj.obj U := fun U => Function.surjInv (h2 U)
      have hσ : ∀ U φ, g.hom.app U (σ U φ) = φ := fun U φ => Function.surjInv_eq (h2 U) φ
      let lU : ∀ U, H.obj.obj U ⟶ A.obj.obj U := fun U => AddCommGrpCat.ofHom
        (AddMonoidHom.mk' (fun φ => k.hom.app U (σ U φ)) (by
          intro φ ψ
          rw [← map_add]
          apply hd
          rw [map_add, hσ, hσ, hσ]))
      have hlU : ∀ U φ, lU U φ = k.hom.app U (σ U φ) := fun U φ => rfl
      let l : H ⟶ A := ObjectProperty.homMk
        { app := lU
          naturality := by
            intro U V r
            ext φ
            rw [CategoryTheory.comp_apply, CategoryTheory.comp_apply, hlU, hlU,
              ← NatTrans.naturality_apply]
            apply hd
            rw [hσ, NatTrans.naturality_apply, hσ] }
      refine ⟨l, ?_⟩
      apply Sheaf.hom_ext
      ext U x
      rw [hcomp]
      change lU U (g.hom.app U x) = k.hom.app U x
      rw [hlU]
      apply hd
      rw [hσ]
    refine ⟨w, ShortComplex.ShortExact.mk' ?_ inferInstance inferInstance⟩
    exact ShortComplex.exact_of_g_is_cokernel _ (Limits.CokernelCofork.IsColimit.ofπ' g w fac)

  refine crit (wcContSheafMap S φ hφ) (wcContSheafMap S ψ hψ) ?_ ?_ ?_ ?_
  · intro U x
    let x0 : C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop U)), A) := x.down
    apply ULift.ext
    apply ContinuousMap.ext
    intro t
    change ψ (φ (x0 t)) = 0
    exact (hker _).mpr ⟨_, rfl⟩
  · intro U x x' hxx
    let x0 : C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop U)), A) := x.down
    let x1 : C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop U)), A) := x'.down
    apply ULift.ext
    apply ContinuousMap.ext
    intro t
    have h := congrArg (fun z => (ULift.down z :
      C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop U)), B)) t) hxx
    have h' : φ (x0 t) = φ (x1 t) := h
    exact hemb.injective h'
  · intro U z
    let z0 : C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop U)), C) := z.down
    refine ⟨ULift.up (⟨fun t => σ (z0 t), hσc.comp z0.continuous⟩ :
      C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop U)), B)), ?_⟩
    apply ULift.ext
    apply ContinuousMap.ext
    intro t
    change ψ (σ (z0 t)) = z0 t
    exact hσ _
  · intro U x hx
    let y0 : C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop U)), B) := x.down
    have hx' : ∀ t, ψ (y0 t) = 0 := by
      intro t
      have := congrArg (fun z => (ULift.down z :
        C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop U)), C)) t) hx
      exact this
    choose k hk using fun t => (hker (y0 t)).mp (hx' t)
    have hkc : Continuous k := by
      rw [hemb.continuous_iff]
      have e : (⇑φ ∘ k) = ⇑y0 := funext hk
      rw [e]
      exact y0.continuous
    refine ⟨ULift.up (⟨k, hkc⟩ :
      C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop U)), A)), ?_⟩
    apply ULift.ext
    apply ContinuousMap.ext
    intro t
    change φ (k t) = y0 t
    exact hk t

theorem wc_contSheafMap_comp_sub : ∀ (S : Scheme.{u}) {A B C : Type} [AddCommGroup A] [TopologicalSpace A] [IsTopologicalAddGroup A] [AddCommGroup B] [TopologicalSpace B] [IsTopologicalAddGroup B] [AddCommGroup C] [TopologicalSpace C] [IsTopologicalAddGroup C] (φ φ' : A →+ B) (hφ : Continuous φ) (hφ' : Continuous φ') (ψ : B →+ C) (hψ : Continuous ψ), wcContSheafMap S (ψ.comp φ) (hψ.comp hφ) = wcContSheafMap S φ hφ ≫ wcContSheafMap S ψ hψ ∧ wcContSheafMap S (φ - φ') (hφ.sub hφ') = wcContSheafMap S φ hφ - wcContSheafMap S φ' hφ' :=
by
  intro S A B C _ _ _ _ _ _ _ _ _ φ φ' hφ hφ' ψ hψ
  have key : ∀ {A B : Type} [AddCommGroup A] [TopologicalSpace A] [IsTopologicalAddGroup A]
      [AddCommGroup B] [TopologicalSpace B] [IsTopologicalAddGroup B]
      (φ : A →+ B) (hφ : Continuous φ) (U : (S.ProEt)ᵒᵖ)
      (x : ((wcContSheaf S A).obj.obj U : Type (u+1))),
      (wcContSheafMap S φ hφ).hom.app U x =
        (ULift.up (AddMonoidHom.compLeftContinuous
          (↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop U))) φ hφ
          (ULift.down x : C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop U)), A))) : _) := by
    intro A B _ _ _ _ _ _ φ hφ U x
    rfl
  refine ⟨?_, ?_⟩
  · apply Sheaf.hom_ext
    apply NatTrans.ext
    funext U
    apply AddCommGrpCat.ext
    intro x
    rw [ObjectProperty.FullSubcategory.comp_hom, NatTrans.comp_app, CategoryTheory.comp_apply,
      key, key, key]
    rfl
  · apply eq_sub_of_add_eq
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext U
    apply AddCommGrpCat.ext
    intro x
    rw [Sheaf.Hom.add_app, AddCommGrpCat.hom_add_apply, key, key]
    apply ULift.ext
    apply ContinuousMap.ext
    intro a
    exact sub_add_cancel _ _

theorem wc_contSheaf_pi_isLimit : ∀ (S : Scheme.{u}) (A : ℕ → Type) [∀ n, AddCommGroup (A n)] [∀ n, TopologicalSpace (A n)] [∀ n, IsTopologicalAddGroup (A n)], Nonempty (Limits.IsLimit (Limits.Fan.mk (wcContSheaf S ((n : ℕ) → A n)) (fun n => wcContSheafMap S (Pi.evalAddMonoidHom A n) (continuous_apply n)))) :=
by
  intro S A _ _ _
  let T : (S.ProEt)ᵒᵖ → Type u := fun U =>
    ↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop U))
  let L : ∀ (s : Limits.Fan (fun n => wcContSheaf S (A n))) (U : (S.ProEt)ᵒᵖ),
      (s.pt.obj.obj U : Type (u+1)) →+ ((wcContSheaf S ((n : ℕ) → A n)).obj.obj U : Type (u+1)) :=
    fun s U =>
      { toFun := fun x => (ULift.up (ContinuousMap.pi (fun n =>
            (ULift.down ((s.proj n).hom.app U x) : C(T U, A n)))) : ULift.{u+1} C(T U, (n : ℕ) → A n))
        map_zero' := by
          apply ULift.ext
          apply ContinuousMap.ext
          intro p
          funext n
          change (ULift.down ((s.proj n).hom.app U 0) : C(T U, A n)) p = (0 : A n)
          rw [map_zero]
          rfl
        map_add' := fun x y => by
          apply ULift.ext
          apply ContinuousMap.ext
          intro p
          funext n
          change (ULift.down ((s.proj n).hom.app U (x + y)) : C(T U, A n)) p =
            (ULift.down ((s.proj n).hom.app U x) : C(T U, A n)) p +
              (ULift.down ((s.proj n).hom.app U y) : C(T U, A n)) p
          rw [map_add]
          rfl }
  let lift : ∀ s : Limits.Fan (fun n => wcContSheaf S (A n)),
      s.pt ⟶ wcContSheaf S ((n : ℕ) → A n) := fun s =>
    ObjectProperty.homMk
      { app := fun U => AddCommGrpCat.ofHom (L s U)
        naturality := fun U V f => by
          apply AddCommGrpCat.ext
          intro x
          change L s V (s.pt.obj.map f x) = (wcContSheaf S ((n : ℕ) → A n)).obj.map f (L s U x)
          apply ULift.ext
          apply ContinuousMap.ext
          intro p
          funext n
          have h := NatTrans.naturality_apply (s.proj n).hom f x
          exact congrArg (fun y : ((wcContSheaf S (A n)).obj.obj V : Type (u+1)) =>
            (ULift.down y : C(T V, A n)) p) h }
  refine ⟨Limits.Fan.IsLimit.mk _ lift ?_ ?_⟩
  · intro s n
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext U
    apply AddCommGrpCat.ext
    intro x
    rfl
  · intro s m hm
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext U
    apply AddCommGrpCat.ext
    intro x
    apply ULift.ext
    apply ContinuousMap.ext
    intro p
    funext n
    have h := congrArg (fun k : s.pt ⟶ wcContSheaf S (A n) =>
      (ULift.down (k.hom.app U x) : C(T U, A n)) p) (hm n)
    exact h

theorem wc_proet_epi_affine_lift : ∀ (S : Scheme.{u}) {G H : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} (α : G ⟶ H), Epi α → ∀ (U : S.ProEt), IsAffine U.left → ∀ (y : H.obj.obj (Opposite.op U)), ∃ (V : S.ProEt) (g : V ⟶ U) (x : G.obj.obj (Opposite.op V)), IsAffine V.left ∧ Surjective g.left ∧ α.hom.app (Opposite.op V) x = H.obj.map g.op y :=
by
  intro S G H α hα U hU y

  haveI : Presheaf.IsLocallySurjective (Scheme.ProEt.topology S) α.hom :=
    (Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u+1} α).mpr hα
  have hR := Presheaf.imageSieve_mem (Scheme.ProEt.topology S) α.hom (U := Opposite.op U) y

  have s1 : ∀ (R : Sieve U), R ∈ Scheme.ProEt.topology S U →
      ∃ (n : ℕ) (W : Fin n → S.ProEt) (h : ∀ i, W i ⟶ U), (∀ i, R (h i)) ∧
        (∀ i, IsAffine (W i).left) ∧ ∀ x : U.left, ∃ i, x ∈ Set.range (h i).left := by
    intro R hR
    have h1 := (CoverPreserving.of_isContinuous (Scheme.ProEt.forget S) (Scheme.ProEt.topology S)
      (Scheme.proetaleTopology.over S)).cover_preserve hR
    rw [GrothendieckTopology.mem_over_iff] at h1
    obtain ⟨R', hR', hle⟩ := Precoverage.mem_toGrothendieck_iff_of_isStableUnderComposition.mp h1
    obtain ⟨𝒰, hqc, rfl⟩ :=
      (Scheme.mem_propQCPrecoverage_iff_exists_quasiCompactCover (P := @WeaklyEtale)).mp hR'
    haveI := hqc
    haveI : IsAffine ((Scheme.ProEt.forget S).obj U).left := hU
    obtain ⟨n, a, V, hV, hcov⟩ := QuasiCompactCover.exists_isAffineOpen_of_isCompact
      𝒰.toPreZeroHypercover (U := ⊤) (by rw [TopologicalSpace.Opens.coe_top]; exact isCompact_univ)
    have hwe : ∀ i, WeaklyEtale ((V i).ι ≫ 𝒰.f (a i) ≫ U.hom) := by
      intro i
      have h1 : WeaklyEtale (𝒰.f (a i)) := 𝒰.map_prop (a i)
      have h2 : WeaklyEtale U.hom := U.prop
      have h0 : WeaklyEtale (V i).ι := inferInstance
      have comp : ∀ {X Y Z : Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ Z), WeaklyEtale f → WeaklyEtale g →
          WeaklyEtale (f ≫ g) := by
        intro X Y Z f g _ _; infer_instance
      exact comp _ _ h0 (comp _ _ h1 h2)
    let W : Fin n → S.ProEt := fun i => MorphismProperty.Over.mk ⊤ ((V i).ι ≫ 𝒰.f (a i) ≫ U.hom) (hwe i)
    let h : ∀ i, W i ⟶ U := fun i =>
      MorphismProperty.Over.homMk ((V i).ι ≫ 𝒰.f (a i)) (Category.assoc _ _ _) trivial
    refine ⟨n, W, h, ?_, ?_, ?_⟩
    · intro i
      have hmem : (Sieve.overEquiv _ (Sieve.functorPushforward (Scheme.ProEt.forget S) R)).arrows
          (𝒰.f (a i)) := by
        apply hle
        exact Presieve.ofArrows.mk (a i)
      rw [Sieve.overEquiv_iff] at hmem
      obtain ⟨Z, φ, ψ, hφ, heq⟩ := hmem
      have hl : 𝒰.f (a i) = ψ.left ≫ φ.left := congrArg (fun m => m.left) heq
      have hw : ψ.left ≫ Z.hom = 𝒰.f (a i) ≫ U.hom := Over.w ψ
      let k : W i ⟶ Z := MorphismProperty.Over.homMk ((V i).ι ≫ ψ.left)
        (by exact (Category.assoc _ _ _).trans (congrArg ((V i).ι ≫ ·) hw)) trivial
      have hk : k ≫ φ = h i := by
        apply MorphismProperty.Over.Hom.ext
        show ((V i).ι ≫ ψ.left) ≫ φ.left = (V i).ι ≫ 𝒰.f (a i)
        exact (Category.assoc _ _ _).trans (congrArg ((V i).ι ≫ ·) hl.symm)
      rw [← hk]
      exact R.downward_closed hφ k
    · intro i
      exact (hV i)
    · intro x
      have hx : (show ((Scheme.ProEt.forget S).obj U).left from x) ∈
          ⋃ i, (𝒰.f (a i)) '' ((V i : (𝒰.X (a i)).Opens) : Set (𝒰.X (a i))) := by
        rw [hcov]; trivial
      obtain ⟨i, hi⟩ := Set.mem_iUnion.mp hx
      obtain ⟨z, hz, hzx⟩ := hi
      obtain ⟨w, rfl⟩ : z ∈ Set.range (V i).ι := by rw [Scheme.Opens.range_ι]; exact hz
      refine ⟨i, w, ?_⟩
      show ((V i).ι ≫ 𝒰.f (a i)) w = x
      rw [Scheme.Hom.comp_apply]
      exact hzx
  obtain ⟨n, W, h, hRh, hWaff, hsurj⟩ := s1 _ hR
  have hRh' : ∀ i, ∃ t, α.hom.app (Opposite.op (W i)) t = H.obj.map (h i).op y := fun i => hRh i
  choose xs hxs using hRh'

  haveI hdesc : WeaklyEtale (Limits.Sigma.desc fun i => (W i).hom) :=
    IsZariskiLocalAtSource.sigmaDesc (fun i => (W i).prop)
  let V : S.ProEt := MorphismProperty.Over.mk ⊤ (Limits.Sigma.desc fun i => (W i).hom) hdesc
  let ι : ∀ i, W i ⟶ V := fun i =>
    MorphismProperty.Over.homMk (Limits.Sigma.ι (fun i => (W i).left) i)
      (Limits.Sigma.ι_comp_desc _ _) trivial
  let g : V ⟶ U := MorphismProperty.Over.homMk (Limits.Sigma.desc fun i => (h i).left)
    (by
      apply Limits.Sigma.hom_ext
      intro i
      show Limits.Sigma.ι _ i ≫ Limits.Sigma.desc (fun i => (h i).left) ≫ U.hom =
        Limits.Sigma.ι _ i ≫ Limits.Sigma.desc fun i => (W i).hom
      rw [Limits.Sigma.ι_comp_desc_assoc, Limits.Sigma.ι_comp_desc]
      exact MorphismProperty.Over.w (h i)) trivial
  have hg : ∀ i, ι i ≫ g = h i := by
    intro i
    apply MorphismProperty.Over.Hom.ext
    show Limits.Sigma.ι _ i ≫ Limits.Sigma.desc (fun i => (h i).left) = (h i).left
    rw [Limits.Sigma.ι_comp_desc]

  have hcovP : Presieve.ofArrows W ι ∈ (Scheme.ProEt.precoverage S).coverings V := by
    rw [Scheme.ProEt.precoverage, Precoverage.mem_comap_iff, Presieve.map_ofArrows]
    exact (⟨Scheme.zariskiPrecoverage_le_qcPrecoverage _ (sigmaOpenCover fun i => (W i).left).mem₀,
      (sigmaOpenCover fun i => (W i).left).mem₀.1,
      MorphismProperty.ofArrows_mem_precoverage.mpr (fun i => inferInstance)⟩ :
      (sigmaOpenCover fun i => (W i).left).presieve₀ ∈
        Scheme.proetalePrecoverage.coverings (∐ fun i => (W i).left))
  have hgen : Sieve.generate (Presieve.ofArrows W ι) ∈ Scheme.ProEt.topology S V :=
    Precoverage.generate_mem_toGrothendieck hcovP
  have key : ∀ F : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1},
      Function.Bijective (fun (x : F.obj.obj (Opposite.op V)) (i : Fin n) => F.obj.map (ι i).op x) := by
    intro F
    have hF : Presieve.IsSheaf (Scheme.ProEt.topology S) (F.obj ⋙ forget AddCommGrpCat.{u+1}) :=
      (isSheaf_iff_isSheaf_of_type _ _).mp ((Presheaf.isSheaf_iff_isSheaf_forget
        (Scheme.ProEt.topology S) F.obj (forget AddCommGrpCat.{u+1})).mp F.property)
    have hsf := (Presieve.isSheafFor_arrows_iff _ ι).mp (hF.isSheafFor _ hgen)
    have hcomp : ∀ x : ∀ i, (F.obj ⋙ forget AddCommGrpCat.{u+1}).obj (Opposite.op (W i)),
        Presieve.Arrows.Compatible (F.obj ⋙ forget AddCommGrpCat.{u+1}) ι x := by
      intro x i j Z gi gj hij
      by_cases hij' : i = j
      · subst hij'
        have : gi = gj := by
          apply MorphismProperty.Over.Hom.ext
          exact (cancel_mono (Limits.Sigma.ι (fun i => (W i).left) i)).mp
            (congrArg (fun m => m.left) hij)
        rw [this]
      · haveI : IsEmpty Z.left :=
          isEmpty_of_commSq_sigmaι_of_ne ⟨congrArg (fun m => m.left) hij⟩ hij'
        have hbot : Presieve.IsSheafFor (F.obj ⋙ forget AddCommGrpCat.{u+1}) (⊥ : Presieve Z) :=
          hF.isSheafFor ⊥ (by rw [Sieve.generate_bot]; exact Scheme.ProEt.bot_mem_topology Z)
        exact hbot.isSeparatedFor (fun _ _ h => h.elim) _ _ (fun _ _ h => h.elim)
          (fun _ _ h => h.elim)
    constructor
    · intro t₁ t₂ ht
      obtain ⟨t, _, huniq⟩ := hsf (fun i => F.obj.map (ι i).op t₁) (hcomp _)
      have e1 := huniq t₁ (fun i => rfl)
      have e2 := huniq t₂ (fun i => (congrFun ht i).symm)
      rw [e1, e2]
    · intro x
      obtain ⟨t, ht, _⟩ := hsf x (hcomp x)
      exact ⟨t, funext ht⟩

  obtain ⟨x, hx⟩ := (key G).2 xs
  haveI : ∀ i, IsAffine (W i).left := hWaff
  refine ⟨V, g, x, ?_, ⟨fun u => ?_⟩, ?_⟩
  · show IsAffine (∐ fun i => (W i).left)
    infer_instance
  · obtain ⟨i, w, hw⟩ := hsurj u
    refine ⟨Limits.Sigma.ι (fun i => (W i).left) i w, ?_⟩
    have e : (h i).left = Limits.Sigma.ι (fun i => (W i).left) i ≫ g.left := by
      rw [← hg i]; rfl
    rw [← hw, e]; rfl
  · apply (key H).1
    funext i
    show H.obj.map (ι i).op (α.hom.app (Opposite.op V) x) = H.obj.map (ι i).op (H.obj.map g.op y)
    rw [← NatTrans.naturality_apply α.hom (ι i).op x]
    have hxi : G.obj.map (ι i).op x = xs i := congrFun hx i
    rw [hxi, hxs i, ← ConcreteCategory.comp_apply, ← Functor.map_comp, ← op_comp, hg i]

theorem wc_proet_affine_tower_limit : ∀ (S : Scheme.{u}) (U : ℕ → S.ProEt) (p : ∀ n, U (n + 1) ⟶ U n), (∀ n, IsAffine (U n).left) → (∀ n, Surjective (p n).left) → ∃ (W : S.ProEt) (q : ∀ n, W ⟶ U n), IsAffine W.left ∧ (∀ n, q (n + 1) ≫ p n = q n) ∧ Surjective (q 0).left :=
by
  intro S U p hU hp
  classical

  have s0 : ∀ (G : ℕ → Type u) [∀ k, CommRing (G k)] (φ : ∀ k, G k →+* G (k + 1)),
      ∃ (T : Type u) (_ : CommRing T) (ι : ∀ k, G k →+* T) (Φ : ∀ k, G 0 →+* G k),
        Φ 0 = RingHom.id (G 0) ∧ (∀ k, Φ (k + 1) = (φ k).comp (Φ k)) ∧
        (∀ k, (ι (k + 1)).comp (φ k) = ι k) ∧
        (∀ (n : ℕ) (t : Fin n → T), ∃ (k : ℕ) (x : Fin n → G k), ∀ i, ι k (x i) = t i) ∧
        (∀ (k n : ℕ) (x : Fin n → G k), (∀ i, ι k (x i) = 0) → ∃ (j : ℕ) (θ : G k →+* G j),
          (ι j).comp θ = ι k ∧ θ.comp (Φ k) = Φ j ∧ ∀ i, θ (x i) = 0) := by
    intro G _ φ
    obtain ⟨F, hself, hsucc⟩ : ∃ F : ∀ i j, i ≤ j → (G i →+* G j),
        (∀ i (h : i ≤ i), F i i h = RingHom.id (G i)) ∧
        (∀ i j (h : i ≤ j) (h' : i ≤ j + 1), F i (j + 1) h' = (φ j).comp (F i j h)) :=
      ⟨fun i j h => Nat.leRecOn (C := fun k => G i →+* G k) h (fun {k} g => (φ k).comp g)
          (RingHom.id (G i)),
        fun i h => Nat.leRecOn_self _, fun i j h h' => Nat.leRecOn_succ h _⟩
    have hcomp : ∀ i j k (hij : i ≤ j) (hjk : j ≤ k) (hik : i ≤ k),
        (F j k hjk).comp (F i j hij) = F i k hik := by
      intro i j k hij hjk
      induction k, hjk using Nat.le_induction with
      | base => intro hik; rw [hself, RingHom.id_comp]
      | succ k hjk ih =>
        intro hik
        rw [hsucc j k hjk, hsucc i k (hij.trans hjk), RingHom.comp_assoc, ih]
    have : DirectedSystem G (fun i j h => F i j h) :=
      { map_self := fun i x => RingHom.congr_fun (hself i _) x
        map_map := fun k j i hij hjk x => RingHom.congr_fun (hcomp i j k hij hjk _) x }
    have OF : ∀ i j (h : i ≤ j), (Ring.DirectLimit.of G (fun i j h => F i j h) j).comp (F i j h) =
        Ring.DirectLimit.of G (fun i j h => F i j h) i :=
      fun i j h => RingHom.ext fun x => Ring.DirectLimit.of_f (G := G) (f := fun i j h => F i j h) h x
    have hstep : ∀ k, F k (k + 1) (Nat.le_succ k) = φ k := by
      intro k
      rw [hsucc k k le_rfl, hself, RingHom.comp_id]
    refine ⟨Ring.DirectLimit G (fun i j h => F i j h), inferInstance,
      fun k => Ring.DirectLimit.of G (fun i j h => F i j h) k, fun k => F 0 k (Nat.zero_le k),
      hself 0 _, fun k => hsucc 0 k _ _, ?_, ?_, ?_⟩
    · intro k
      rw [← hstep k]
      exact OF k (k + 1) _
    · intro n t
      choose kk y hy using fun i =>
        Ring.DirectLimit.exists_of (G := G) (f := fun i j h => F i j h) (t i)
      obtain ⟨M, hM⟩ := Finite.exists_le kk
      refine ⟨M, fun i => F (kk i) M (hM i) (y i), fun i => ?_⟩
      rw [← hy i]
      exact Ring.DirectLimit.of_f (G := G) (f := fun i j h => F i j h) (hM i) (y i)
    · intro k n x hx
      have hx' : ∀ i, Ring.DirectLimit.of G (fun i j h => F i j h) k (x i) = 0 := hx
      choose jj hkj hz using fun i => Ring.DirectLimit.of.zero_exact (f' := F) (hx' i)
      obtain ⟨M, hM⟩ := Finite.exists_le jj
      refine ⟨max k M, F k (max k M) (le_max_left _ _), OF _ _ _,
        hcomp 0 k _ _ _ _, fun i => ?_⟩
      rw [← hcomp k (jj i) (max k M) (hkj i) ((hM i).trans (le_max_right _ _)),
        RingHom.comp_apply, hz i, map_zero]

  have s1 : ∀ (R S' : Type u) [CommRing R] [CommRing S'] (φ : R →+* S'),
      WeaklyEtale (Spec.map (CommRingCat.ofHom φ)) ↔ @Algebra.WeaklyEtale R S' _ _ φ.toAlgebra := by
    intro R S' _ _ φ
    letI := φ.toAlgebra
    have e : Spec.map (CommRingCat.ofHom φ) = Spec.map (CommRingCat.ofHom (algebraMap R S')) := rfl
    rw [e]
    have hF : Flat (Spec.map (CommRingCat.ofHom (algebraMap R S'))) ↔ Module.Flat R S' := by
      rw [HasRingHomProperty.Spec_iff (P := @Flat), CommRingCat.hom_ofHom]
      exact RingHom.flat_algebraMap_iff
    have hD : Flat (Limits.pullback.diagonal (Spec.map (CommRingCat.ofHom (algebraMap R S')))) ↔
        (Algebra.TensorProduct.lmul' R : TensorProduct R S' S' →ₐ[R] S').Flat := by
      rw [diagonal_SpecMap]
      constructor
      · intro h
        have h2 : Flat (Spec.map (CommRingCat.ofHom
            (Algebra.TensorProduct.lmul' R : TensorProduct R S' S' →ₐ[R] S').toRingHom)) := by
          have e2 : Spec.map (CommRingCat.ofHom
              (Algebra.TensorProduct.lmul' R : TensorProduct R S' S' →ₐ[R] S').toRingHom) =
              (Spec.map (CommRingCat.ofHom
                (Algebra.TensorProduct.lmul' R : TensorProduct R S' S' →ₐ[R] S').toRingHom) ≫
                (pullbackSpecIso R S' S').inv) ≫ (pullbackSpecIso R S' S').hom := by
            rw [Category.assoc, Iso.inv_hom_id, Category.comp_id]
          rw [e2]
          infer_instance
        exact HasRingHomProperty.Spec_iff.mp h2
      · intro h
        haveI : Flat (Spec.map (CommRingCat.ofHom
            (Algebra.TensorProduct.lmul' R : TensorProduct R S' S' →ₐ[R] S').toRingHom)) :=
          HasRingHomProperty.Spec_iff.mpr h
        infer_instance
    constructor
    · intro h
      exact Algebra.WeaklyEtale.mk (hF.mp h.flat) (hD.mp h.flat_diagonal)
    · intro h
      haveI := hF.mpr h.flat
      haveI := hD.mpr h.flat_lmul'
      exact WeaklyEtale.mk

  have s2 : ∀ (A B C : Type u) [CommRing A] [CommRing B] [CommRing C] (f : A →+* B) (g : B →+* C),
      @Algebra.WeaklyEtale A B _ _ f.toAlgebra → @Algebra.WeaklyEtale B C _ _ g.toAlgebra →
      @Algebra.WeaklyEtale A C _ _ (g.comp f).toAlgebra := by
    intro A B C _ _ _ f g hf hg
    letI := f.toAlgebra
    letI := g.toAlgebra
    letI : Algebra A C := (g.comp f).toAlgebra
    haveI : IsScalarTower A B C := IsScalarTower.of_algebraMap_eq' rfl
    exact Algebra.WeaklyEtale.trans A B C

  have s3 : ∀ (G : ℕ → Type u) [∀ k, CommRing (G k)] (T : Type u) [CommRing T]
      (ι : ∀ k, G k →+* T) (Φ : ∀ k, G 0 →+* G k), (∀ k, (ι k).comp (Φ k) = ι 0) →
      (∀ k, (Φ k).Flat) →
      (∀ (n : ℕ) (t : Fin n → T), ∃ (k : ℕ) (x : Fin n → G k), ∀ i, ι k (x i) = t i) →
      (∀ (k n : ℕ) (x : Fin n → G k), (∀ i, ι k (x i) = 0) → ∃ (j : ℕ) (θ : G k →+* G j),
        (ι j).comp θ = ι k ∧ θ.comp (Φ k) = Φ j ∧ ∀ i, θ (x i) = 0) → (ι 0).Flat := by
    intro G _ T _ ι Φ hιΦ hfl hlift hkill
    have hιΦ' : ∀ k y, ι k (Φ k y) = ι 0 y := fun k y => RingHom.congr_fun (hιΦ k) y
    letI : Algebra (G 0) T := (ι 0).toAlgebra
    show Module.Flat (G 0) T
    apply Module.Flat.of_forall_isTrivialRelation
    intro l f x hx
    have hx' : ∑ i, ι 0 (f i) * x i = 0 := hx
    obtain ⟨k, x', hx'k⟩ := hlift l x
    obtain ⟨j, θ, hθι, hθΦ, hθ0⟩ := hkill k 1 ![∑ i, Φ k (f i) * x' i] (by
      intro i
      obtain rfl : i = 0 := Subsingleton.elim _ _
      simp only [Matrix.cons_val_zero, map_sum, map_mul, hιΦ', hx'k]
      exact hx')
    have hθι' : ∀ y, ι j (θ y) = ι k y := fun y => RingHom.congr_fun hθι y
    have hθΦ' : ∀ y, θ (Φ k y) = Φ j y := fun y => RingHom.congr_fun hθΦ y
    have h0 := hθ0 0
    simp only [Matrix.cons_val_zero, map_sum, map_mul, hθΦ'] at h0
    letI : Algebra (G 0) (G j) := (Φ j).toAlgebra
    haveI : Module.Flat (G 0) (G j) := hfl j
    have h1 : ∑ i, f i • θ (x' i) = 0 := h0
    obtain ⟨k', a, y, hy, ha⟩ := Module.Flat.isTrivialRelation_of_sum_smul_eq_zero
      (R := G 0) (M := G j) (f := f) (x := fun i => θ (x' i)) h1
    refine ⟨k', a, fun j' => ι j (y j'), fun i => ?_, ha⟩
    rw [← hx'k i, ← hθι' (x' i), show θ (x' i) = _ from hy i, map_sum]
    refine Finset.sum_congr rfl fun j' _ => ?_
    show ι j (Φ j (a i j') * y j') = ι 0 (a i j') * ι j (y j')
    rw [map_mul, hιΦ']

  have s4 : ∀ (G : ℕ → Type u) [∀ k, CommRing (G k)] (T : Type u) [CommRing T]
      (ι : ∀ k, G k →+* T) (Φ : ∀ k, G 0 →+* G k), (∀ k, (ι k).comp (Φ k) = ι 0) →
      (∀ k, @Algebra.WeaklyEtale (G 0) (G k) _ _ (Φ k).toAlgebra) → (ι 0).Flat →
      (∀ (n : ℕ) (t : Fin n → T), ∃ (k : ℕ) (x : Fin n → G k), ∀ i, ι k (x i) = t i) →
      (∀ (k n : ℕ) (x : Fin n → G k), (∀ i, ι k (x i) = 0) → ∃ (j : ℕ) (θ : G k →+* G j),
        (ι j).comp θ = ι k ∧ θ.comp (Φ k) = Φ j ∧ ∀ i, θ (x i) = 0) →
      @Algebra.WeaklyEtale (G 0) T _ _ (ι 0).toAlgebra := by
    intro G _ T _ ι Φ hιΦ hwe hflat hlift hkill
    have hιΦ' : ∀ k y, ι k (Φ k y) = ι 0 y := fun k y => RingHom.congr_fun (hιΦ k) y
    letI : Algebra (G 0) T := (ι 0).toAlgebra
    have hrep : ∀ w : TensorProduct (G 0) T T, ∃ (m : ℕ) (a b : Fin m → T),
        w = ∑ t, a t ⊗ₜ[G 0] b t := by
      intro w
      induction w using TensorProduct.induction_on with
      | zero => exact ⟨0, Fin.elim0, Fin.elim0, by simp⟩
      | tmul x y => exact ⟨1, fun _ => x, fun _ => y, by simp⟩
      | add w₁ w₂ h₁ h₂ =>
        obtain ⟨m₁, a₁, b₁, e₁⟩ := h₁
        obtain ⟨m₂, a₂, b₂, e₂⟩ := h₂
        refine ⟨m₁ + m₂, Fin.append a₁ a₂, Fin.append b₁ b₂, ?_⟩
        rw [Fin.sum_univ_add, e₁, e₂]
        simp [Fin.append_left, Fin.append_right]
    have hdiag : (Algebra.TensorProduct.lmul' (G 0) : TensorProduct (G 0) T T →ₐ[G 0] T).Flat := by
      letI : Algebra (TensorProduct (G 0) T T) T :=
        (Algebra.TensorProduct.lmul' (G 0) : TensorProduct (G 0) T T →ₐ[G 0] T).toRingHom.toAlgebra
      show Module.Flat (TensorProduct (G 0) T T) T
      apply Module.Flat.of_forall_isTrivialRelation
      intro l f x hx
      have hx' : ∑ i, Algebra.TensorProduct.lmul' (G 0) (f i) * x i = 0 := by
        rw [← hx]
        rfl
      choose m a b hab using fun i => hrep (f i)
      let pt : Fin l ⊕ ((Σ i, Fin (m i)) ⊕ (Σ i, Fin (m i))) → T :=
        Sum.elim x (Sum.elim (fun p => a p.1 p.2) (fun p => b p.1 p.2))
      let eI := Fintype.equivFin (Fin l ⊕ ((Σ i, Fin (m i)) ⊕ (Σ i, Fin (m i))))
      obtain ⟨k, y, hy⟩ := hlift _ (fun s => pt (eI.symm s))
      let pt' : Fin l ⊕ ((Σ i, Fin (m i)) ⊕ (Σ i, Fin (m i))) → G k := fun s => y (eI s)
      have hpt' : ∀ s, ι k (pt' s) = pt s := by
        intro s
        show ι k (y (eI s)) = pt s
        rw [hy, Equiv.symm_apply_apply]
      have hr : ι k (∑ i, (∑ t : Fin (m i), pt' (Sum.inr (Sum.inl ⟨i, t⟩)) *
          pt' (Sum.inr (Sum.inr ⟨i, t⟩))) * pt' (Sum.inl i)) = 0 := by
        rw [← hx']
        simp only [map_sum, map_mul, hpt']
        refine Finset.sum_congr rfl (fun i _ => ?_)
        rw [hab i, map_sum]
        simp [pt, Algebra.TensorProduct.lmul'_apply_tmul]
      obtain ⟨j, θ, hθι, hθΦ, hθ0⟩ := hkill k 1 ![∑ i, (∑ t : Fin (m i),
          pt' (Sum.inr (Sum.inl ⟨i, t⟩)) * pt' (Sum.inr (Sum.inr ⟨i, t⟩))) * pt' (Sum.inl i)] (by
        intro i
        obtain rfl : i = 0 := Subsingleton.elim _ _
        simp only [Matrix.cons_val_zero]
        exact hr)
      have hθι' : ∀ y, ι j (θ y) = ι k y := fun y => RingHom.congr_fun hθι y
      letI : Algebra (G 0) (G j) := (Φ j).toAlgebra
      haveI hWE : Algebra.WeaklyEtale (G 0) (G j) := hwe j
      let q : Fin l ⊕ ((Σ i, Fin (m i)) ⊕ (Σ i, Fin (m i))) → G j := fun s => θ (pt' s)
      let w₀ : Fin l → TensorProduct (G 0) (G j) (G j) := fun i =>
        ∑ t : Fin (m i), q (Sum.inr (Sum.inl ⟨i, t⟩)) ⊗ₜ[G 0] q (Sum.inr (Sum.inr ⟨i, t⟩))
      let x₀ : Fin l → G j := fun i => q (Sum.inl i)
      letI : Algebra (TensorProduct (G 0) (G j) (G j)) (G j) :=
        (Algebra.TensorProduct.lmul' (G 0) :
          TensorProduct (G 0) (G j) (G j) →ₐ[G 0] G j).toRingHom.toAlgebra
      haveI hE₀flat : Module.Flat (TensorProduct (G 0) (G j) (G j)) (G j) := hWE.flat_lmul'
      have h0 : ∑ i, w₀ i • x₀ i = 0 := by
        have h1 := hθ0 0
        simp only [Matrix.cons_val_zero, map_sum, map_mul] at h1
        rw [← h1]
        refine Finset.sum_congr rfl (fun i _ => ?_)
        show Algebra.TensorProduct.lmul' (G 0) (w₀ i) * x₀ i = _
        simp [w₀, x₀, q, map_sum, Algebra.TensorProduct.lmul'_apply_tmul]
      obtain ⟨k', A, z, hA, hA'⟩ := Module.Flat.isTrivialRelation_of_sum_smul_eq_zero
        (R := TensorProduct (G 0) (G j) (G j)) (M := G j) (f := w₀) (x := x₀) h0
      let β : G j →ₐ[G 0] T := AlgHom.mk (ι j) (fun r => hιΦ' j r)
      have hβq : ∀ s, β (q s) = pt s := fun s => (hθι' (pt' s)).trans (hpt' s)
      have hK : ∀ u : TensorProduct (G 0) (G j) (G j),
          Algebra.TensorProduct.lmul' (G 0) (Algebra.TensorProduct.map β β u) =
            β (Algebra.TensorProduct.lmul' (G 0) u) := by
        intro u
        induction u using TensorProduct.induction_on with
        | zero => simp
        | tmul p q => simp [Algebra.TensorProduct.lmul'_apply_tmul]
        | add p q hp hq => simp only [map_add, hp, hq]
      have hw : ∀ i, Algebra.TensorProduct.map β β (w₀ i) = f i := by
        intro i
        rw [hab i]
        simp only [w₀, map_sum, Algebra.TensorProduct.map_tmul, hβq, pt, Sum.elim_inl,
          Sum.elim_inr]
      refine ⟨k', fun i j' => Algebra.TensorProduct.map β β (A i j'), fun j' => β (z j'),
        fun i => ?_, fun j' => ?_⟩
      · have := congrArg β (hA i)
        rw [show β (x₀ i) = x i from hβq (Sum.inl i)] at this
        rw [this, map_sum]
        refine Finset.sum_congr rfl (fun j' _ => ?_)
        show β (Algebra.TensorProduct.lmul' (G 0) (A i j') * z j') =
          Algebra.TensorProduct.lmul' (G 0) (Algebra.TensorProduct.map β β (A i j')) * β (z j')
        rw [map_mul, hK]
      · have := congrArg (Algebra.TensorProduct.map β β) (hA' j')
        rw [map_sum, map_zero] at this
        rw [← this]
        refine Finset.sum_congr rfl (fun i _ => ?_)
        rw [map_mul, hw]
    exact Algebra.WeaklyEtale.mk hflat hdiag

  have s5 : ∀ (G : ℕ → Type u) [∀ k, CommRing (G k)] (T : Type u) [CommRing T]
      (ι : ∀ k, G k →+* T) (Φ : ∀ k, G 0 →+* G k), (∀ k, (ι k).comp (Φ k) = ι 0) →
      (∀ k, Function.Surjective (PrimeSpectrum.comap (Φ k))) →
      (∀ (n : ℕ) (t : Fin n → T), ∃ (k : ℕ) (x : Fin n → G k), ∀ i, ι k (x i) = t i) →
      (∀ (k n : ℕ) (x : Fin n → G k), (∀ i, ι k (x i) = 0) → ∃ (j : ℕ) (θ : G k →+* G j),
        (ι j).comp θ = ι k ∧ θ.comp (Φ k) = Φ j ∧ ∀ i, θ (x i) = 0) →
      Function.Surjective (PrimeSpectrum.comap (ι 0)) := by
    intro G _ T _ ι Φ hιΦ hsurj hlift hkill P
    have hιΦ' : ∀ k y, ι k (Φ k y) = ι 0 y := fun k y => RingHom.congr_fun (hιΦ k) y
    have hP : P ∈ Set.range (PrimeSpectrum.comap (ι 0)) := by
      rw [PrimeSpectrum.mem_range_comap_iff]
      refine le_antisymm ?_ Ideal.le_comap_map
      intro a ha
      rw [Ideal.mem_comap] at ha
      have ha' : ι 0 a ∈ Submodule.span T (⇑(ι 0) '' (P.asIdeal : Set (G 0))) := ha
      rw [Submodule.mem_span_set'] at ha'
      obtain ⟨n, c, g, hg⟩ := ha'
      choose pp hpp hppg using fun s => (g s).2
      obtain ⟨k, c', hc'⟩ := hlift n c
      obtain ⟨j, θ, hθι, hθΦ, hθ0⟩ := hkill k 1 ![Φ k a - ∑ s, c' s * Φ k (pp s)] (by
        intro i
        obtain rfl : i = 0 := Subsingleton.elim _ _
        simp only [Matrix.cons_val_zero, map_sub, map_sum, map_mul, hιΦ', hc', hppg]
        rw [← hg]
        simp [smul_eq_mul])
      have hθΦ' : ∀ y, θ (Φ k y) = Φ j y := fun y => RingHom.congr_fun hθΦ y
      have h0 := hθ0 0
      simp only [Matrix.cons_val_zero, map_sub, map_sum, map_mul, hθΦ'] at h0
      obtain ⟨Q, hQ⟩ := hsurj j P
      have hQ' : Ideal.comap (Φ j) Q.asIdeal = P.asIdeal := by
        rw [← PrimeSpectrum.comap_asIdeal, hQ]
      rw [← hQ', Ideal.mem_comap, sub_eq_zero.mp h0]
      refine Ideal.sum_mem _ (fun s _ => Ideal.mul_mem_left _ _ ?_)
      rw [← Ideal.mem_comap, hQ']
      exact hpp s
    exact hP

  have s6 : ∀ (V V' : S.ProEt) (g : V' ⟶ V), IsAffine V.left → IsAffine V'.left →
      Surjective g.left →
      WeaklyEtale (Spec.map g.left.appTop) ∧ Surjective (Spec.map g.left.appTop) := by
    intro V V' g hV hV' hg
    haveI : WeaklyEtale V.hom := V.prop
    haveI : WeaklyEtale (g.left ≫ V.hom) := by
      rw [MorphismProperty.Over.w g]
      exact V'.prop
    haveI : WeaklyEtale g.left := WeaklyEtale.of_comp g.left V.hom
    have e : Spec.map g.left.appTop = V'.left.isoSpec.inv ≫ g.left ≫ V.left.isoSpec.hom := by
      rw [← Scheme.isoSpec_hom_naturality, Iso.inv_hom_id_assoc]
    rw [e]
    exact ⟨inferInstance, inferInstance⟩

  obtain ⟨T, _, ι, Φ, hΦ0, hΦs, hιφ, hlift, hkill⟩ :=
    s0 (fun k => Γ((U k).left, ⊤)) (fun k => ((p k).left.appTop).hom)
  have hιΦ : ∀ k, (ι k).comp (Φ k) = ι 0 := by
    intro k
    induction k with
    | zero => rw [hΦ0, RingHom.comp_id]
    | succ k ih => rw [hΦs k, ← RingHom.comp_assoc, hιφ k, ih]
  have h6 := fun k => s6 (U k) (U (k + 1)) (p k) (hU k) (hU (k + 1)) (hp k)
  have hWφ : ∀ k, @Algebra.WeaklyEtale _ _ _ _ ((p k).left.appTop).hom.toAlgebra := fun k =>
    (s1 _ _ ((p k).left.appTop).hom).mp (by rw [CommRingCat.ofHom_hom]; exact (h6 k).1)
  have hSφ : ∀ k, Function.Surjective (PrimeSpectrum.comap ((p k).left.appTop).hom) := by
    intro k
    have h := (h6 k).2
    rw [surjective_iff, Spec.map_base] at h
    exact h
  have hWΦ : ∀ k, @Algebra.WeaklyEtale _ _ _ _ (Φ k).toAlgebra := by
    intro k
    induction k with
    | zero => rw [hΦ0]; infer_instance
    | succ k ih => rw [hΦs k]; exact s2 _ _ _ (Φ k) ((p k).left.appTop).hom ih (hWφ k)
  have hSΦ : ∀ k, Function.Surjective (PrimeSpectrum.comap (Φ k)) := by
    intro k
    induction k with
    | zero => rw [hΦ0, PrimeSpectrum.comap_id]; exact Function.surjective_id
    | succ k ih => rw [hΦs k, PrimeSpectrum.comap_comp]; exact ih.comp (hSφ k)
  have hflat : (ι 0).Flat := s3 _ T ι Φ hιΦ (fun k => (hWΦ k).flat) hlift hkill
  have hWE := s4 _ T ι Φ hιΦ hWΦ hflat hlift hkill
  have hW0 : WeaklyEtale (Spec.map (CommRingCat.ofHom (ι 0))) := (s1 _ _ (ι 0)).mpr hWE
  have hS0 : Surjective (Spec.map (CommRingCat.ofHom (ι 0))) := by
    rw [surjective_iff, Spec.map_base]
    exact s5 _ T ι Φ hιΦ hSΦ hlift hkill

  have hring : ∀ n, (p n).left.appTop ≫ CommRingCat.ofHom (ι (n + 1)) =
      CommRingCat.ofHom (ι n) := by
    intro n
    apply CommRingCat.hom_ext
    rw [CommRingCat.hom_comp, CommRingCat.hom_ofHom, CommRingCat.hom_ofHom]
    exact hιφ n
  have hcompat : ∀ n, (Spec.map (CommRingCat.ofHom (ι (n + 1))) ≫ (U (n + 1)).left.isoSpec.inv) ≫
      (p n).left = Spec.map (CommRingCat.ofHom (ι n)) ≫ (U n).left.isoSpec.inv := by
    intro n
    rw [Category.assoc, ← Scheme.isoSpec_inv_naturality, ← Category.assoc, ← Spec.map_comp,
      hring n]
  have hover : ∀ n, (Spec.map (CommRingCat.ofHom (ι n)) ≫ (U n).left.isoSpec.inv) ≫ (U n).hom =
      Spec.map (CommRingCat.ofHom (ι 0)) ≫ (U 0).left.isoSpec.inv ≫ (U 0).hom := by
    intro n
    induction n with
    | zero => rw [Category.assoc]
    | succ n ih => rw [← MorphismProperty.Over.w (p n), ← Category.assoc, hcompat n, ih]
  have hWhom : WeaklyEtale (Spec.map (CommRingCat.ofHom (ι 0)) ≫ (U 0).left.isoSpec.inv ≫
      (U 0).hom) := by
    haveI : WeaklyEtale (U 0).hom := (U 0).prop
    infer_instance
  let W : S.ProEt := MorphismProperty.Over.mk ⊤
    (Spec.map (CommRingCat.ofHom (ι 0)) ≫ (U 0).left.isoSpec.inv ≫ (U 0).hom) hWhom
  refine ⟨W, fun n => MorphismProperty.Over.homMk
    (Spec.map (CommRingCat.ofHom (ι n)) ≫ (U n).left.isoSpec.inv) (hover n) trivial, ?_, ?_, ?_⟩
  · change IsAffine (Spec (CommRingCat.of T))
    infer_instance
  · intro n
    apply MorphismProperty.Over.Hom.ext
    exact hcompat n
  · change Surjective (Spec.map (CommRingCat.ofHom (ι 0)) ≫ (U 0).left.isoSpec.inv)
    infer_instance

theorem wc_proet_epi_of_affine_lift : ∀ (S : Scheme.{u}) {G H : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} (α : G ⟶ H), (∀ (U : S.ProEt), IsAffine U.left → ∀ (y : H.obj.obj (Opposite.op U)), ∃ (V : S.ProEt) (g : V ⟶ U) (x : G.obj.obj (Opposite.op V)), IsAffine V.left ∧ Surjective g.left ∧ α.hom.app (Opposite.op V) x = H.obj.map g.op y) → Epi α :=
by
  intro S G H α hyp

  have surj_covers : ∀ {V U : S.ProEt} (g : V ⟶ U), IsAffine V.left → IsAffine U.left →
      Surjective g.left → Sieve.generate (Presieve.singleton g) ∈ Scheme.ProEt.topology S U := by
    intro V U g hV hU hg
    haveI : WeaklyEtale U.hom := U.prop
    haveI : WeaklyEtale (g.left ≫ U.hom) := by rw [Over.w g.toCommaMorphism]; exact V.prop
    haveI hW : WeaklyEtale g.left := WeaklyEtale.of_comp g.left U.hom
    have h1 : Presieve.singleton g.left ∈ (Scheme.propQCPrecoverage @WeaklyEtale).coverings U.left :=
      Scheme.Hom.singleton_mem_propQCPrecoverage (P := @WeaklyEtale) (f := g.left) hW
    have hP : Presieve.singleton g ∈ (Scheme.ProEt.precoverage S).coverings U := by
      show _ ∈ (Precoverage.comap (Scheme.ProEt.forget S ⋙ Over.forget S)
        Scheme.proetalePrecoverage).coverings U
      rw [Precoverage.mem_comap_iff, Presieve.map_singleton]
      exact h1
    exact Precoverage.generate_mem_toGrothendieck hP

  have affine_local : ∀ (U : S.ProEt) (R : Sieve U),
      (∀ (V : S.ProEt) (f : V ⟶ U), IsAffine V.left → R.pullback f ∈ Scheme.ProEt.topology S V) →
      R ∈ Scheme.ProEt.topology S U := by
    intro U R hR
    have hU : WeaklyEtale U.hom := U.prop
    let W : U.left.affineCover.I₀ → S.ProEt := fun i =>
      MorphismProperty.Over.mk ⊤ (U.left.affineCover.f i ≫ U.hom) inferInstance
    let e : ∀ i, W i ⟶ U := fun i => MorphismProperty.Over.homMk (U.left.affineCover.f i) rfl trivial
    have hP : Presieve.ofArrows W e ∈ (Scheme.ProEt.precoverage S).coverings U := by
      show _ ∈ (Precoverage.comap (Scheme.ProEt.forget S ⋙ Over.forget S)
        Scheme.proetalePrecoverage).coverings U
      rw [Precoverage.mem_comap_iff, Presieve.map_ofArrows]
      change U.left.affineCover.presieve₀ ∈ Scheme.proetalePrecoverage.coverings U.left
      exact ⟨Scheme.zariskiPrecoverage_le_qcPrecoverage U.left U.left.affineCover.mem₀,
        U.left.affineCover.mem₀.1,
        MorphismProperty.ofArrows_mem_precoverage.mpr (fun i => inferInstance)⟩
    refine GrothendieckTopology.transitive _ (Precoverage.generate_mem_toGrothendieck hP) R ?_
    intro Y f hf
    obtain ⟨Y', h, g', hg', rfl⟩ := hf
    rcases hg' with ⟨i⟩
    rw [Sieve.pullback_comp]
    exact GrothendieckTopology.pullback_stable _ h
      (hR (W i) (e i) (show IsAffine (U.left.affineCover.X i) by infer_instance))

  refine (Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u+1} α).mp ⟨fun {U} y => ?_⟩
  apply affine_local U
  intro V f hV
  obtain ⟨V', g, x, hV', hg, hx⟩ := hyp V hV (H.obj.map f.op y)
  refine GrothendieckTopology.superset_covering _ ?_ (surj_covers g hV' hV hg)
  rw [Sieve.generate_le_iff]
  rintro _ _ ⟨⟩
  show ∃ t, α.hom.app (Opposite.op V') t = H.obj.map (g ≫ f).op y
  refine ⟨x, ?_⟩
  rw [hx, op_comp, Functor.map_comp, ConcreteCategory.comp_apply]

theorem wc_proet_products_exact : ∀ (S : Scheme.{u}), HasExactLimitsOfShape (Discrete ℕ) (Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) :=
by
  intro S

  have s1 : ∀ {C : Type (u+2)} [Category.{u+1} C] [Abelian C] [Limits.HasCountableProducts C],
      (∀ (F : ℕᵒᵖ ⥤ C) (c : Limits.Cone F), Limits.IsLimit c →
        (∀ n : ℕ, Epi (F.map (homOfLE (Nat.le_succ n)).op)) → Epi (c.π.app (Opposite.op 0))) →
      HasExactLimitsOfShape (Discrete ℕ) C := by
    intro C _ _ _ H
    letI := Abelian.hasFiniteBiproducts (C := C)
    have hPi : ∀ {M N : ℕ → C} (f : ∀ n, M n ⟶ N n), (∀ n, Epi (f n)) →
        Epi (Limits.Pi.map f) := by
      intro M N f hf
      have h0 := H _ _ (Limits.SequentialProduct.isLimit f)
        (fun n ↦ by
          rw [Functor.ofOpSequence_map_homOfLE_succ]
          exact Limits.SequentialProduct.functorMap_epi f n)
      simp only [Limits.SequentialProduct.cone_π_app, not_lt_zero, ↓reduceDIte] at h0
      rw [← Limits.Pi.map_comp_map] at h0
      obtain ⟨e, he1, he2⟩ : ∃ e, Epi (Limits.Pi.map f ≫ e) ∧ IsIso e :=
        ⟨_, h0, Limits.Pi.map_isIso _⟩
      exact (epi_comp_iff_of_isIso _ e).mp he1
    have : (Limits.lim : (Discrete ℕ ⥤ C) ⥤ C).PreservesEpimorphisms := by
      constructor
      intro X Y φ _
      have hφ : ∀ n, Epi (φ.app ⟨n⟩) := fun n => (NatTrans.epi_iff_epi_app φ).mp inferInstance ⟨n⟩
      have e : Limits.lim.map φ = (Limits.Pi.isoLimit X).inv ≫
          Limits.Pi.map (fun n => φ.app ⟨n⟩) ≫ (Limits.Pi.isoLimit Y).hom := by
        apply Limits.limit.hom_ext
        rintro ⟨n⟩
        simp
      rw [e]
      have := hPi _ hφ
      infer_instance
    exact hasExactLimitsOfShape_of_preservesEpi C (Discrete ℕ)
  apply s1
  intro F c hc hF
  apply wc_proet_epi_of_affine_lift S
  intro V hV y

  have hyp := fun n => wc_proet_epi_affine_lift S (F.map (homOfLE (Nat.le_succ n)).op) (hF n)
  choose V' g x hV' hg hx using hyp
  let seq : ∀ n : ℕ, Σ' (U : S.ProEt) (_ : IsAffine U.left), ((F.obj (Opposite.op n)).obj.obj (Opposite.op U)) :=
    fun n => Nat.rec (motive := fun n => Σ' (U : S.ProEt) (_ : IsAffine U.left), ((F.obj (Opposite.op n)).obj.obj (Opposite.op U)))
      ⟨V, hV, y⟩ (fun n s => ⟨V' n s.1 s.2.1 s.2.2, hV' n _ _ _, x n _ _ _⟩) n
  let U : ℕ → S.ProEt := fun n => (seq n).1
  let p : ∀ n, U (n + 1) ⟶ U n := fun n => g n (seq n).1 (seq n).2.1 (seq n).2.2
  let xs : ∀ n, (F.obj (Opposite.op n)).obj.obj (Opposite.op (U n)) := fun n => (seq n).2.2
  have hU : ∀ n, IsAffine (U n).left := fun n => (seq n).2.1
  have hp : ∀ n, Surjective (p n).left := fun n => hg n _ _ _
  have hxs : ∀ n, (F.map (homOfLE (Nat.le_succ n)).op).hom.app (Opposite.op (U (n + 1))) (xs (n + 1)) =
      (F.obj (Opposite.op n)).obj.map (p n).op (xs n) := fun n => hx n _ _ _

  obtain ⟨W, q, hW, hq, hq0⟩ := wc_proet_affine_tower_limit S U p hU hp
  let w : ∀ n, (F.obj (Opposite.op n)).obj.obj (Opposite.op W) :=
    fun n => (F.obj (Opposite.op n)).obj.map (q n).op (xs n)
  have hw : ∀ n, (F.map (homOfLE (Nat.le_succ n)).op).hom.app (Opposite.op W) (w (n + 1)) = w n := by
    intro n
    show (F.map (homOfLE (Nat.le_succ n)).op).hom.app (Opposite.op W)
      ((F.obj (Opposite.op (n + 1))).obj.map (q (n + 1)).op (xs (n + 1))) = _
    rw [NatTrans.naturality_apply (F.map (homOfLE (Nat.le_succ n)).op).hom (q (n + 1)).op (xs (n + 1)),
      hxs n, ← ConcreteCategory.comp_apply, ← Functor.map_comp, ← op_comp, hq n]

  let G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1} ⥤ Type (u+1) :=
    sheafToPresheaf _ _ ⋙ (evaluation _ _).obj (Opposite.op W) ⋙ forget AddCommGrpCat.{u+1}
  have hcG : Limits.IsLimit (G.mapCone c) := Limits.isLimitOfPreserves G hc
  have key : ∀ k n, (F ⋙ G).map (homOfLE (Nat.le_add_right n k)).op (w (n + k)) = w n := by
    intro k
    induction k with
    | zero =>
      intro n
      have e : (homOfLE (Nat.le_add_right n 0)).op = 𝟙 (Opposite.op (n + 0)) :=
        Quiver.Hom.unop_inj (Subsingleton.elim _ _)
      rw [e, FunctorToTypes.map_id_apply]
      rfl
    | succ k ih =>
      intro n
      have e : (homOfLE (Nat.le_add_right n (k + 1))).op =
          (homOfLE (Nat.le_succ (n + k))).op ≫ (homOfLE (Nat.le_add_right n k)).op :=
        Quiver.Hom.unop_inj (Subsingleton.elim _ _)
      rw [e, FunctorToTypes.map_comp_apply]
      have h1 : (F ⋙ G).map (homOfLE (Nat.le_succ (n + k))).op (w (n + (k + 1))) = w (n + k) :=
        hw (n + k)
      rw [h1, ih]
  let sec : (F ⋙ G).sections := ⟨fun j => w j.unop, by
    intro j j' f
    cases j with | op m =>
    cases j' with | op n =>
    obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le (leOfHom f.unop)
    have e : f = (homOfLE (Nat.le_add_right n k)).op := Quiver.Hom.unop_inj (Subsingleton.elim _ _)
    subst e
    exact key k n⟩
  let z : c.pt.obj.obj (Opposite.op W) := (Limits.Types.isLimitEquivSections hcG).symm sec
  have hz : ∀ n, (c.π.app (Opposite.op n)).hom.app (Opposite.op W) z = w n := fun n =>
    Limits.Types.isLimitEquivSections_symm_apply hcG sec (Opposite.op n)
  refine ⟨W, q 0, z, hW, hq0, ?_⟩
  rw [hz 0]
  rfl

theorem wc_ext_prod_bijective : ∀ {C : Type*} [Category C] [Abelian C] [HasExt C] [EnoughInjectives C] [Limits.HasLimitsOfShape (Discrete ℕ) C] [HasExactLimitsOfShape (Discrete ℕ) C] (P Y : C) (B : ℕ → C) (pr : ∀ n, Y ⟶ B n) (hY : Limits.IsLimit (Limits.Fan.mk Y pr)) (N : ℕ), (∀ x : Abelian.Ext P Y N, (∀ n, x.comp (Abelian.Ext.mk₀ (pr n)) (add_zero N) = 0) → x = 0) ∧ (∀ y : ∀ n, Abelian.Ext P (B n) N, ∃ x : Abelian.Ext P Y N, ∀ n, x.comp (Abelian.Ext.mk₀ (pr n)) (add_zero N) = y n) :=
by
  intro C _ _ _ _ _ _ P Y B pr hY N
  have hc : ∀ {X₁ X₂ X₃ : C} {n : ℕ} (x : Abelian.Ext P X₁ n) (f : X₁ ⟶ X₂) (g : X₂ ⟶ X₃),
      (x.comp (Abelian.Ext.mk₀ f) (add_zero n)).comp (Abelian.Ext.mk₀ g) (add_zero n) =
        x.comp (Abelian.Ext.mk₀ (f ≫ g)) (add_zero n) := by
    intro X₁ X₂ X₃ n x f g
    rw [Abelian.Ext.comp_assoc _ _ _ (add_zero _) (add_zero 0) (by omega),
      Abelian.Ext.mk₀_comp_mk₀]
  have key : ∀ (M : ℕ) (G : Discrete ℕ ⥤ C),
      (∀ x : Abelian.Ext P (Limits.limit G) M,
        (∀ j, x.comp (Abelian.Ext.mk₀ (Limits.limit.π G j)) (add_zero M) = 0) → x = 0) ∧
      (∀ y : ∀ j, Abelian.Ext P (G.obj j) M, ∃ x : Abelian.Ext P (Limits.limit G) M,
        ∀ j, x.comp (Abelian.Ext.mk₀ (Limits.limit.π G j)) (add_zero M) = y j) := by
    intro M
    induction M with
    | zero =>
      intro G
      constructor
      · intro x hx
        rw [← Abelian.Ext.mk₀_homEquiv₀_apply x]
        have h0 : Abelian.Ext.homEquiv₀ x = 0 := by
          apply Limits.limit.hom_ext
          intro j
          apply (Abelian.Ext.mk₀_bijective _ _).1
          rw [← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_homEquiv₀_apply, Limits.zero_comp,
            Abelian.Ext.mk₀_zero]
          exact hx j
        rw [h0, Abelian.Ext.mk₀_zero]
      · intro y
        refine ⟨Abelian.Ext.mk₀ (Limits.limit.lift G
          (Limits.Cone.mk P (Discrete.natTrans fun j => Abelian.Ext.homEquiv₀ (y j)))),
          fun j => ?_⟩
        rw [Abelian.Ext.mk₀_comp_mk₀, Limits.limit.lift_π]
        exact Abelian.Ext.mk₀_homEquiv₀_apply (y j)
    | succ M ih =>
      intro G
      let I : Discrete ℕ ⥤ C := Discrete.functor (fun n => Injective.under (G.obj ⟨n⟩))
      let α : G ⟶ I := Discrete.natTrans (fun j => Injective.ι (G.obj j))
      haveI : ∀ j, Mono (α.app j) := fun j => (inferInstance : Mono (Injective.ι (G.obj j)))
      haveI : Mono α := NatTrans.mono_of_mono_app α
      let S : ShortComplex (Discrete ℕ ⥤ C) :=
        ShortComplex.mk α (Limits.cokernel.π α) (Limits.cokernel.condition α)
      have hS : S.ShortExact :=
        ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel α) inferInstance inferInstance
      have hT : (S.map Limits.lim).ShortExact := hS.map_of_exact Limits.lim
      have hSj : ∀ j, (S.map ((evaluation (Discrete ℕ) C).obj j)).ShortExact :=
        fun j => hS.map_of_exact _
      haveI hIinj : Injective ((S.map Limits.lim).X₂) :=
        (inferInstance : Injective (Limits.limit
          (Discrete.functor (fun n => Injective.under (G.obj ⟨n⟩)))))
      haveI hIj : ∀ j, Injective ((S.map ((evaluation (Discrete ℕ) C).obj j)).X₂) :=
        fun j => (inferInstance : Injective (Injective.under (G.obj ⟨j.as⟩)))
      let Q := Limits.cokernel α
      let φ : ∀ j, S.map Limits.lim ⟶ S.map ((evaluation (Discrete ℕ) C).obj j) := fun j =>
        ShortComplex.homMk (Limits.limit.π G j) (Limits.limit.π I j) (Limits.limit.π Q j)
          (Limits.limMap_π α j).symm (Limits.limMap_π (Limits.cokernel.π α) j).symm
      have hnat : ∀ j, hT.extClass.comp (Abelian.Ext.mk₀ (Limits.limit.π G j)) (add_zero 1) =
          (Abelian.Ext.mk₀ (Limits.limit.π Q j)).comp (hSj j).extClass (zero_add 1) :=
        fun j => hT.extClass_naturality (hSj j) (φ j)
      constructor
      · intro x hx
        have h0 : x.comp (Abelian.Ext.mk₀ (S.map Limits.lim).f) (add_zero _) = 0 :=
          Abelian.Ext.eq_zero_of_injective _
        obtain ⟨x₃, hx₃⟩ := Abelian.Ext.covariant_sequence_exact₁ P hT x h0 (n₀ := M) rfl
        have hq : ∀ j, (x₃.comp (Abelian.Ext.mk₀ (Limits.limit.π Q j)) (add_zero M)).comp
            (hSj j).extClass rfl = 0 := by
          intro j
          rw [Abelian.Ext.comp_assoc _ _ _ (add_zero M) (zero_add 1) (by omega), ← hnat j,
            ← Abelian.Ext.comp_assoc _ _ _ rfl (add_zero 1) (by omega), hx₃]
          exact hx j
        choose k hk using fun j => Abelian.Ext.covariant_sequence_exact₃ P (hSj j)
          (x₃.comp (Abelian.Ext.mk₀ (Limits.limit.π Q j)) (add_zero M)) rfl (hq j)
        obtain ⟨k', hk'⟩ := (ih I).2 k
        have hz : x₃ = k'.comp (Abelian.Ext.mk₀ (S.map Limits.lim).g) (add_zero M) := by
          rw [← sub_eq_zero]
          apply (ih Q).1
          intro j
          have hgj : (S.map Limits.lim).g ≫ Limits.limit.π Q j =
              Limits.limit.π I j ≫ (S.map ((evaluation (Discrete ℕ) C).obj j)).g :=
            Limits.limMap_π _ j
          rw [sub_eq_add_neg, Abelian.Ext.add_comp, Abelian.Ext.neg_comp, hc, hgj, ← hc,
            hk', hk j, add_neg_cancel]
        rw [← hx₃, hz, Abelian.Ext.comp_assoc _ _ _ (add_zero M) (zero_add 1) (by omega),
          hT.comp_extClass, Abelian.Ext.comp_zero]
      · intro y
        choose q hq using fun j => Abelian.Ext.covariant_sequence_exact₁ P (hSj j) (y j)
          (Abelian.Ext.eq_zero_of_injective _) (n₀ := M) rfl
        obtain ⟨q', hq'⟩ := (ih Q).2 q
        refine ⟨q'.comp hT.extClass rfl, fun j => ?_⟩
        rw [Abelian.Ext.comp_assoc _ _ _ rfl (add_zero 1) (by omega), hnat j,
          ← Abelian.Ext.comp_assoc _ _ _ (add_zero M) (zero_add 1) (by omega), hq' j, hq j]
  let e := hY.conePointUniqueUpToIso (Limits.limit.isLimit (Discrete.functor B))
  have he1 : ∀ n, e.hom ≫ Limits.limit.π (Discrete.functor B) ⟨n⟩ = pr n :=
    fun n => hY.conePointUniqueUpToIso_hom_comp _ ⟨n⟩
  have he2 : ∀ n, e.inv ≫ pr n = Limits.limit.π (Discrete.functor B) ⟨n⟩ :=
    fun n => hY.conePointUniqueUpToIso_inv_comp _ ⟨n⟩
  obtain ⟨k1, k2⟩ := key N (Discrete.functor B)
  constructor
  · intro x hx
    have h1 : x.comp (Abelian.Ext.mk₀ e.hom) (add_zero N) = 0 := by
      apply k1
      rintro ⟨n⟩
      rw [hc, he1 n]
      exact hx n
    calc x = x.comp (Abelian.Ext.mk₀ (e.hom ≫ e.inv)) (add_zero N) := by
          rw [Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
      _ = 0 := by rw [← hc, h1, Abelian.Ext.zero_comp]
  · intro y
    obtain ⟨x', hx'⟩ := k2 (fun j => y j.as)
    refine ⟨x'.comp (Abelian.Ext.mk₀ e.inv) (add_zero N), fun n => ?_⟩
    rw [hc, he2 n]
    exact hx' ⟨n⟩

theorem wc_padic_tower_facts : ∀ (ℓ : ℕ) [Fact (Nat.Prime ℓ)], Continuous (wcTowerIncl ℓ) ∧ Topology.IsEmbedding (wcTowerIncl ℓ) ∧ Continuous (wcTowerShift ℓ) ∧ (∀ b, wcTowerShift ℓ b = 0 ↔ ∃ a, wcTowerIncl ℓ a = b) ∧ ∃ σ : ((n : ℕ) → ZMod (ℓ ^ n)) → ((n : ℕ) → ZMod (ℓ ^ n)), Continuous σ ∧ ∀ c, wcTowerShift ℓ (σ c) = c :=
by
  intro ℓ _

  have hT : ∀ n : ℕ, Continuous (PadicInt.toZModPow (p := ℓ) n) := by
    intro n
    have hzero : ∀ᶠ x in nhds (0 : ℤ_[ℓ]), PadicInt.toZModPow (p := ℓ) n x = 0 := by
      have hpos : (0 : ℝ) < (ℓ : ℝ) ^ (-(n : ℤ)) := by
        apply zpow_pos
        exact_mod_cast (Fact.out : Nat.Prime ℓ).pos
      filter_upwards [Metric.closedBall_mem_nhds (0 : ℤ_[ℓ]) hpos] with x hx
      rw [Metric.mem_closedBall, dist_zero_right] at hx
      have h1 := (PadicInt.norm_le_pow_iff_mem_span_pow x n).mp hx
      rw [← PadicInt.ker_toZModPow] at h1
      exact (RingHom.mem_ker).mp h1
    apply continuous_of_continuousAt_zero (PadicInt.toZModPow (p := ℓ) n)
    rw [ContinuousAt, map_zero, nhds_discrete (ZMod (ℓ ^ n)), Filter.tendsto_pure]
    exact hzero

  have hincl : Continuous (wcTowerIncl ℓ) := continuous_pi fun n => hT n

  have hinj : Function.Injective (wcTowerIncl ℓ) := by
    intro x y hxy
    apply PadicInt.ext_of_toZModPow.mp
    intro n
    exact congrFun hxy n
  have hemb : Topology.IsEmbedding (wcTowerIncl ℓ) := (hincl.isClosedEmbedding hinj).isEmbedding

  have hshift : Continuous (wcTowerShift ℓ) := by
    apply continuous_pi
    intro n
    exact (continuous_apply n).sub
      ((continuous_of_discreteTopology (f := ⇑(wcTowerCast ℓ n))).comp (continuous_apply (n + 1)))

  have hker : ∀ b, wcTowerShift ℓ b = 0 ↔ ∃ a, wcTowerIncl ℓ a = b := by
    intro b
    constructor
    · intro hb
      have hC : ∀ N, b N = ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ N)) (ZMod (ℓ ^ N))
          (b (N + 1)) := by
        intro N
        have h := congrFun hb N
        exact sub_eq_zero.mp h
      have hA : ∀ n N (h : n ≤ N), ZMod.castHom (pow_dvd_pow ℓ h) (ZMod (ℓ ^ n)) (b N) = b n := by
        intro n N h
        induction N, h using Nat.le_induction with
        | base => rw [ZMod.castHom_apply, ZMod.cast_id]
        | succ N hnN ih =>
          rw [← ih, hC N]
          exact (RingHom.congr_fun (ZMod.castHom_comp (pow_dvd_pow ℓ hnN)
            (pow_dvd_pow ℓ (Nat.le_succ N))) (b (N + 1))).symm
      have hB : ∀ n N, n ≤ N → PadicInt.toZModPow n (((b N).val : ℕ) : ℤ_[ℓ]) = b n := by
        intro n N h
        rw [map_natCast, ← hA n N h, ZMod.castHom_apply, ZMod.cast_eq_val]
      have hclosed : IsClosed (Set.range (wcTowerIncl ℓ)) := (isCompact_range hincl).isClosed
      have hlim : Filter.Tendsto (fun N => wcTowerIncl ℓ (((b N).val : ℕ) : ℤ_[ℓ])) Filter.atTop
          (nhds b) := by
        rw [tendsto_pi_nhds]
        intro n
        rw [nhds_discrete (ZMod (ℓ ^ n)), Filter.tendsto_pure, Filter.eventually_atTop]
        exact ⟨n, fun N hN => hB n N hN⟩
      exact hclosed.mem_of_tendsto hlim (Filter.Eventually.of_forall fun N => ⟨_, rfl⟩)
    · rintro ⟨a, rfl⟩
      funext n
      show PadicInt.toZModPow n a - ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ n)) (ZMod (ℓ ^ n))
        (PadicInt.toZModPow (n + 1) a) = 0
      rw [ZMod.castHom_apply, PadicInt.cast_toZModPow n (n + 1) (Nat.le_succ n) a, sub_self]
  refine ⟨hincl, hemb, hshift, hker, ?_⟩

  refine ⟨fun c n => -∑ k ∈ Finset.range n, (((c k).val : ℕ) : ZMod (ℓ ^ n)), ?_, ?_⟩
  · apply continuous_pi
    intro n
    exact (continuous_finset_sum _ fun k _ =>
      (continuous_of_discreteTopology
        (f := fun y : ZMod (ℓ ^ k) => ((y.val : ℕ) : ZMod (ℓ ^ n)))).comp
        (continuous_apply k)).neg
  · intro c
    funext n
    show (-∑ k ∈ Finset.range n, (((c k).val : ℕ) : ZMod (ℓ ^ n))) -
      ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ n)) (ZMod (ℓ ^ n))
        (-∑ k ∈ Finset.range (n + 1), (((c k).val : ℕ) : ZMod (ℓ ^ (n + 1)))) = c n
    rw [map_neg, map_sum, Finset.sum_range_succ]
    simp only [map_natCast]
    rw [ZMod.natCast_zmod_val]
    ring

theorem wc_int_coh_separated (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    [GeometricallyIrreducible X.hom] [IsProper X.hom] (d : ℕ) [SmoothOfRelativeDimension d X.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F)
    (h : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))) :
    ∀ (i : ℕ) (x : Abelian.Ext (wcFreeSheaf X.left (wcGeomPoint F X h)) (wcIntSheaf X.left ℓ) i),
      (∀ n : ℕ, x.comp (Abelian.Ext.mk₀ (Limits.cokernel.π (wcIntScalar X.left ℓ ((ℓ : ℤ_[ℓ]) ^ n))))
        (add_zero i) = 0) → x = 0 :=
by
  classical
  have hℓ0 : ℓ ≠ 0 := (Fact.out : Nat.Prime ℓ).ne_zero
  have hℓpos : (0 : ℝ) < (ℓ : ℝ) := by exact_mod_cast (Fact.out : Nat.Prime ℓ).pos
  have hcongr : ∀ {A B : Type} [AddCommGroup A] [TopologicalSpace A] [IsTopologicalAddGroup A]
      [AddCommGroup B] [TopologicalSpace B] [IsTopologicalAddGroup B] (φ φ' : A →+ B)
      (e : φ = φ') (hφ : Continuous φ) (hφ' : Continuous φ'),
      wcContSheafMap X.left φ hφ = wcContSheafMap X.left φ' hφ' := by
    intro A B _ _ _ _ _ _ φ φ' e hφ hφ'
    subst e
    rfl



  have mid : ∀ {S : ShortComplex (Sheaf (Scheme.ProEt.topology X.left) AddCommGrpCat.{u+1})},
      S.ShortExact → ∀ k : ℕ,
      Finite (Abelian.Ext (wcFreeSheaf X.left (wcGeomPoint F X h)) S.X₁ k) →
      Finite (Abelian.Ext (wcFreeSheaf X.left (wcGeomPoint F X h)) S.X₃ k) →
      Finite (Abelian.Ext (wcFreeSheaf X.left (wcGeomPoint F X h)) S.X₂ k) := by
    intro S hS k h1 h3
    haveI := h1
    haveI := h3
    let g' := (Abelian.Ext.mk₀ S.g).postcomp (wcFreeSheaf X.left (wcGeomPoint F X h)) (add_zero k)
    let f' := (Abelian.Ext.mk₀ S.f).postcomp (wcFreeSheaf X.left (wcGeomPoint F X h)) (add_zero k)
    let pre : Abelian.Ext (wcFreeSheaf X.left (wcGeomPoint F X h)) S.X₃ k →
        Abelian.Ext (wcFreeSheaf X.left (wcGeomPoint F X h)) S.X₂ k :=
      fun z => if hz : ∃ y, g' y = z then hz.choose else 0
    have hpre : ∀ y, g' (pre (g' y)) = g' y := by
      intro y
      have hz : ∃ y', g' y' = g' y := ⟨y, rfl⟩
      simp only [pre, dif_pos hz]
      exact hz.choose_spec
    have hmem : ∀ y, y - pre (g' y) ∈ Set.range f' := by
      intro y
      have h0 : (y - pre (g' y)).comp (Abelian.Ext.mk₀ S.g) (add_zero k) = 0 := by
        change g' (y - pre (g' y)) = 0
        rw [map_sub, hpre, sub_self]
      obtain ⟨a, ha⟩ := Abelian.Ext.covariant_sequence_exact₂ _ hS _ h0
      exact ⟨a, ha⟩
    haveI : Finite (Set.range f') := (Set.finite_range f').to_subtype
    refine Finite.of_injective (fun y => (g' y, (⟨y - pre (g' y), hmem y⟩ : Set.range f'))) ?_
    intro y y' hyy
    simp only [Prod.mk.injEq, Subtype.mk.injEq] at hyy
    obtain ⟨e1, e2⟩ := hyy
    rw [e1] at e2
    exact sub_left_injective e2



  have hfin1 : ∀ k : ℕ, Finite (Abelian.Ext (wcFreeSheaf X.left (wcGeomPoint F X h))
      (wcContSheaf X.left (ZMod (ℓ ^ 1))) k) := by
    intro k
    haveI := wc_coh_mod_ell_finite F X d ℓ hℓ h k
    obtain ⟨e0⟩ := wc_int_coker_zmod X.left ℓ 1 (ℓ : ℤ_[ℓ]) (pow_one _).symm
    let e : Limits.cokernel (wcIntScalar X.left ℓ (ℓ : ℤ_[ℓ])) ≅
        wcContSheaf X.left (ZMod (ℓ ^ 1)) := e0
    refine Finite.of_surjective (fun y : Abelian.Ext (wcFreeSheaf X.left (wcGeomPoint F X h))
      (Limits.cokernel (wcIntScalar X.left ℓ (ℓ : ℤ_[ℓ]))) k =>
        y.comp (Abelian.Ext.mk₀ e.hom) (add_zero k)) ?_
    intro y
    refine ⟨y.comp (Abelian.Ext.mk₀ e.inv) (add_zero k), ?_⟩
    simp only
    rw [Abelian.Ext.comp_assoc _ _ _ (add_zero k) (add_zero 0) (by omega),
      Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.comp_mk₀_id]



  have hfin : ∀ n k : ℕ, Finite (Abelian.Ext (wcFreeSheaf X.left (wcGeomPoint F X h))
      (wcContSheaf X.left (ZMod (ℓ ^ n))) k) := by
    intro n
    induction n with
    | zero =>
      intro k
      haveI : Subsingleton (ZMod (ℓ ^ 0)) := ZMod.subsingleton_iff.mpr (pow_zero ℓ)
      have h0 : 𝟙 (wcContSheaf X.left (ZMod (ℓ ^ 0))) = 0 := by
        apply Sheaf.hom_ext
        apply NatTrans.ext
        funext U
        apply AddCommGrpCat.ext
        intro y
        apply ULift.ext
        apply ContinuousMap.ext
        intro t
        exact Subsingleton.elim _ _
      have hall : ∀ y : Abelian.Ext (wcFreeSheaf X.left (wcGeomPoint F X h))
          (wcContSheaf X.left (ZMod (ℓ ^ 0))) k, y = 0 := by
        intro y
        rw [← Abelian.Ext.comp_mk₀_id y, h0, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
      haveI : Subsingleton (Abelian.Ext (wcFreeSheaf X.left (wcGeomPoint F X h))
          (wcContSheaf X.left (ZMod (ℓ ^ 0))) k) := ⟨fun a b => by rw [hall a, hall b]⟩
      exact Finite.of_subsingleton
    | succ n ih =>
      intro k
      haveI : NeZero (ℓ ^ 1) := ⟨pow_ne_zero _ hℓ0⟩
      obtain ⟨φ, hφ⟩ : ∃ φ : ZMod (ℓ ^ 1) →+ ZMod (ℓ ^ (n + 1)), ∀ j : ℤ,
          φ (j : ZMod (ℓ ^ 1)) = (j : ZMod (ℓ ^ (n + 1))) * ((ℓ ^ n : ℕ) : ZMod (ℓ ^ (n + 1))) :=
        ⟨ZMod.lift (ℓ ^ 1) ⟨zmultiplesHom (ZMod (ℓ ^ (n + 1))) ((ℓ ^ n : ℕ) : ZMod (ℓ ^ (n + 1))),
          by
            rw [zmultiplesHom_apply, natCast_zsmul, nsmul_eq_mul, ← Nat.cast_mul]
            exact (ZMod.natCast_eq_zero_iff _ _).mpr ⟨1, by ring⟩⟩,
          fun j => by
            rw [ZMod.lift_coe]
            change zmultiplesHom (ZMod (ℓ ^ (n + 1))) ((ℓ ^ n : ℕ) : ZMod (ℓ ^ (n + 1))) j = _
            rw [zmultiplesHom_apply, zsmul_eq_mul]⟩
      have hφinj : Function.Injective φ := by
        intro a b hab
        obtain ⟨ka, rfl⟩ := ZMod.intCast_surjective a
        obtain ⟨kb, rfl⟩ := ZMod.intCast_surjective b
        rw [hφ, hφ] at hab
        have h1 : ((ka * ((ℓ ^ n : ℕ) : ℤ) : ℤ) : ZMod (ℓ ^ (n + 1))) =
            ((kb * ((ℓ ^ n : ℕ) : ℤ) : ℤ) : ZMod (ℓ ^ (n + 1))) := by
          push_cast at hab ⊢
          exact hab
        rw [ZMod.intCast_eq_intCast_iff_dvd_sub] at h1
        rw [ZMod.intCast_eq_intCast_iff_dvd_sub]
        have hl : ((ℓ ^ n : ℕ) : ℤ) ≠ 0 := Nat.cast_ne_zero.mpr (pow_ne_zero _ hℓ0)
        have e1 : kb * ((ℓ ^ n : ℕ) : ℤ) - ka * ((ℓ ^ n : ℕ) : ℤ) =
            ((ℓ ^ n : ℕ) : ℤ) * (kb - ka) := by ring
        have e2 : ((ℓ ^ (n + 1) : ℕ) : ℤ) = ((ℓ ^ n : ℕ) : ℤ) * ((ℓ ^ 1 : ℕ) : ℤ) := by
          push_cast; ring
        rw [e1, e2] at h1
        exact Int.dvd_of_mul_dvd_mul_left hl h1
      have hemb : Topology.IsEmbedding φ :=
        ((continuous_of_discreteTopology (f := ⇑φ)).isClosedEmbedding hφinj).isEmbedding
      have hψ : ∀ j : ℤ, wcTowerCast ℓ n (j : ZMod (ℓ ^ (n + 1))) = (j : ZMod (ℓ ^ n)) := by
        intro j
        change (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ n)) (ZMod (ℓ ^ n)))
          (j : ZMod (ℓ ^ (n + 1))) = _
        exact map_intCast _ j
      have hexact : ∀ b, wcTowerCast ℓ n b = 0 ↔ ∃ a, φ a = b := by
        intro b
        obtain ⟨kb, rfl⟩ := ZMod.intCast_surjective b
        rw [hψ, ZMod.intCast_zmod_eq_zero_iff_dvd]
        constructor
        · rintro ⟨j, hj⟩
          refine ⟨(j : ZMod (ℓ ^ 1)), ?_⟩
          rw [hφ, hj]
          push_cast
          ring
        · rintro ⟨a, ha⟩
          obtain ⟨j, rfl⟩ := ZMod.intCast_surjective a
          rw [hφ] at ha
          have h1 : ((j * ((ℓ ^ n : ℕ) : ℤ) : ℤ) : ZMod (ℓ ^ (n + 1))) = (kb : ZMod (ℓ ^ (n + 1))) := by
            push_cast at ha ⊢
            exact ha
          rw [ZMod.intCast_eq_intCast_iff_dvd_sub] at h1
          have h2 : ((ℓ ^ n : ℕ) : ℤ) ∣ kb - j * ((ℓ ^ n : ℕ) : ℤ) :=
            (Int.natCast_dvd_natCast.mpr (pow_dvd_pow ℓ (Nat.le_succ n))).trans h1
          have h3 : ((ℓ ^ n : ℕ) : ℤ) ∣ j * ((ℓ ^ n : ℕ) : ℤ) := Dvd.intro_left _ rfl
          have h4 := dvd_add h2 h3
          rwa [sub_add_cancel] at h4
      have hsurj : Function.Surjective (wcTowerCast ℓ n) :=
        ZMod.castHom_surjective (pow_dvd_pow ℓ (Nat.le_succ n))
      obtain ⟨hz, hS⟩ := wc_contSheaf_shortExact X.left φ continuous_of_discreteTopology
        (wcTowerCast ℓ n) continuous_of_discreteTopology hemb hexact
        ⟨Function.surjInv hsurj, continuous_of_discreteTopology, Function.surjInv_eq hsurj⟩
      exact mid hS k (hfin1 k) (ih k)



  have hlim1 : ∀ (k : ℕ) (w : ∀ n, Abelian.Ext (wcFreeSheaf X.left (wcGeomPoint F X h))
      (wcContSheaf X.left (ZMod (ℓ ^ n))) k),
      ∃ v : ∀ n, Abelian.Ext (wcFreeSheaf X.left (wcGeomPoint F X h))
        (wcContSheaf X.left (ZMod (ℓ ^ n))) k,
      ∀ n, w n = v n - (v (n + 1)).comp (Abelian.Ext.mk₀
        (wcContSheafMap X.left (wcTowerCast ℓ n) continuous_of_discreteTopology)) (add_zero k) := by
    intro k w
    let E : ℕ → Type (u+1) := fun n => Abelian.Ext (wcFreeSheaf X.left (wcGeomPoint F X h))
        (wcContSheaf X.left (ZMod (ℓ ^ n))) k
    obtain ⟨s, hs⟩ := @nonempty_sections_of_finite_inverse_system ℕ _ _
      (Functor.ofOpSequence (X := E)
        (fun n => TypeCat.ofHom (fun a => w n + a.comp (Abelian.Ext.mk₀
          (wcContSheafMap X.left (wcTowerCast ℓ n) continuous_of_discreteTopology)) (add_zero k))))
      (fun j => hfin j.unop k) (fun j => ⟨(0 : E j.unop)⟩)
    refine ⟨fun n => (s (Opposite.op n) : E n), fun n => ?_⟩
    have h1 := hs (homOfLE (Nat.le_succ n)).op
    rw [Functor.ofOpSequence_map_homOfLE_succ] at h1
    exact eq_sub_of_add_eq h1



  obtain ⟨hcont_incl, hemb_incl, hcont_shift, hker, hsec⟩ := wc_padic_tower_facts ℓ
  obtain ⟨hz2, hS2⟩ := wc_contSheaf_shortExact X.left (wcTowerIncl ℓ) hcont_incl
    (wcTowerShift ℓ) hcont_shift hemb_incl hker hsec
  haveI := wc_proet_products_exact X.left
  have hY := (wc_contSheaf_pi_isLimit X.left (fun n => ZMod (ℓ ^ n))).some
  have hprod := fun N => wc_ext_prod_bijective (wcFreeSheaf X.left (wcGeomPoint F X h))
    (wcContSheaf X.left ((n : ℕ) → ZMod (ℓ ^ n))) (fun n => wcContSheaf X.left (ZMod (ℓ ^ n)))
    (fun n => wcContSheafMap X.left (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) n)
      (continuous_apply n)) hY N
  have hTn : ∀ n, wcContSheafMap X.left (wcTowerShift ℓ) hcont_shift ≫
      wcContSheafMap X.left (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) n) (continuous_apply n) =
      wcContSheafMap X.left (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) n) (continuous_apply n) -
      wcContSheafMap X.left (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) (n + 1))
        (continuous_apply (n + 1)) ≫
      wcContSheafMap X.left (wcTowerCast ℓ n) continuous_of_discreteTopology := by
    intro n
    have e1 := (wc_contSheafMap_comp_sub X.left (wcTowerShift ℓ) (wcTowerShift ℓ) hcont_shift
      hcont_shift (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) n) (continuous_apply n)).1
    have e2 := (wc_contSheafMap_comp_sub X.left
      (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) (n + 1))
      (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) (n + 1)) (continuous_apply (n + 1))
      (continuous_apply (n + 1)) (wcTowerCast ℓ n) continuous_of_discreteTopology).1
    have e3 := (wc_contSheafMap_comp_sub X.left
      (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) n)
      ((wcTowerCast ℓ n).comp (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) (n + 1)))
      (continuous_apply n)
      ((continuous_of_discreteTopology (f := ⇑(wcTowerCast ℓ n))).comp (continuous_apply (n + 1)))
      (AddMonoidHom.id (ZMod (ℓ ^ n))) continuous_id).2
    rw [← e1, ← e2, ← e3]
    exact hcongr _ _ (AddMonoidHom.ext fun a => rfl) _ _



  intro i x hx
  have hE : wcIntSheaf X.left ℓ = wcContSheaf X.left ℤ_[ℓ] := rfl
  let x' : Abelian.Ext (wcFreeSheaf X.left (wcGeomPoint F X h)) (wcContSheaf X.left ℤ_[ℓ]) i :=
    x.comp (Abelian.Ext.mk₀ (eqToHom hE)) (add_zero i)
  have hred : ∀ n, x'.comp (Abelian.Ext.mk₀ (wcContSheafMap X.left (wcTowerIncl ℓ) hcont_incl ≫
      wcContSheafMap X.left (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) n) (continuous_apply n)))
      (add_zero i) = 0 := by
    intro n
    have hρc : Continuous (PadicInt.toZModPow (p := ℓ) n) := by
      rw [continuous_discrete_rng]
      intro b
      rw [Metric.isOpen_iff]
      intro y hy
      refine ⟨(ℓ : ℝ) ^ (-(n : ℤ)), zpow_pos hℓpos _, ?_⟩
      intro z hz
      rw [Metric.mem_ball, dist_eq_norm] at hz
      have h1 : z - y ∈ Ideal.span {(ℓ : ℤ_[ℓ]) ^ n} :=
        (PadicInt.norm_le_pow_iff_mem_span_pow _ _).mp hz.le
      rw [← PadicInt.ker_toZModPow, RingHom.mem_ker, map_sub, sub_eq_zero] at h1
      simp only [Set.mem_preimage, Set.mem_singleton_iff] at hy ⊢
      rw [h1, hy]
    let red := wcContSheafMap X.left (PadicInt.toZModPow (p := ℓ) n).toAddMonoidHom hρc
    have e1 : wcContSheafMap X.left (wcTowerIncl ℓ) hcont_incl ≫
        wcContSheafMap X.left (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) n) (continuous_apply n) =
        red := by
      rw [← (wc_contSheafMap_comp_sub X.left (wcTowerIncl ℓ) (wcTowerIncl ℓ) hcont_incl hcont_incl
        (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) n) (continuous_apply n)).1]
      exact hcongr _ _ (AddMonoidHom.ext fun a => rfl) _ _
    let red' := eqToHom hE ≫ red
    have hw : wcIntScalar X.left ℓ ((ℓ : ℤ_[ℓ]) ^ n) ≫ red' = 0 := by
      apply Sheaf.hom_ext
      apply NatTrans.ext
      funext U
      apply AddCommGrpCat.ext
      intro y
      apply ULift.ext
      apply ContinuousMap.ext
      intro t
      change PadicInt.toZModPow n ((ℓ : ℤ_[ℓ]) ^ n * (ULift.down y :
        C(↥((Scheme.ProEt.forget X.left ⋙ Over.forget X.left).obj (Opposite.unop U)), ℤ_[ℓ])) t) = 0
      rw [map_mul, map_pow, map_natCast, ← Nat.cast_pow, ZMod.natCast_self, zero_mul]
    have key : eqToHom hE ≫ (wcContSheafMap X.left (wcTowerIncl ℓ) hcont_incl ≫
        wcContSheafMap X.left (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) n) (continuous_apply n)) =
        Limits.cokernel.π (wcIntScalar X.left ℓ ((ℓ : ℤ_[ℓ]) ^ n)) ≫
          Limits.cokernel.desc _ red' hw := by
      rw [Limits.cokernel.π_desc, e1]
    change (x.comp (Abelian.Ext.mk₀ (eqToHom hE)) (add_zero i)).comp
      (Abelian.Ext.mk₀ (wcContSheafMap X.left (wcTowerIncl ℓ) hcont_incl ≫
        wcContSheafMap X.left (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) n) (continuous_apply n)))
      (add_zero i) = 0
    rw [Abelian.Ext.comp_assoc _ _ _ (add_zero i) (add_zero 0) (by omega),
      Abelian.Ext.mk₀_comp_mk₀, key, ← Abelian.Ext.mk₀_comp_mk₀,
      ← Abelian.Ext.comp_assoc _ _ _ (add_zero i) (add_zero 0) (by omega), hx n,
      Abelian.Ext.zero_comp]
  have hxf : x'.comp (Abelian.Ext.mk₀ (wcContSheafMap X.left (wcTowerIncl ℓ) hcont_incl))
      (add_zero i) = 0 := by
    apply (hprod i).1
    intro n
    rw [Abelian.Ext.comp_assoc _ _ _ (add_zero i) (add_zero 0) (by omega),
      Abelian.Ext.mk₀_comp_mk₀]
    exact hred n

  have hback : x = x'.comp (Abelian.Ext.mk₀ (eqToHom hE.symm)) (add_zero i) := by
    change x = (x.comp (Abelian.Ext.mk₀ (eqToHom hE)) (add_zero i)).comp
      (Abelian.Ext.mk₀ (eqToHom hE.symm)) (add_zero i)
    rw [Abelian.Ext.comp_assoc _ _ _ (add_zero i) (add_zero 0) (by omega),
      Abelian.Ext.mk₀_comp_mk₀, eqToHom_trans, eqToHom_refl, Abelian.Ext.comp_mk₀_id]
  suffices hx0 : x' = 0 by
    rw [hback, hx0, Abelian.Ext.zero_comp]



  have hsubmk : ∀ {A B : Sheaf (Scheme.ProEt.topology X.left) AddCommGrpCat.{u+1}} (a b : A ⟶ B),
      Abelian.Ext.mk₀ (a - b) = Abelian.Ext.mk₀ a - Abelian.Ext.mk₀ b := by
    intro A B a b
    rw [sub_eq_add_neg, Abelian.Ext.mk₀_add, Abelian.Ext.mk₀_neg, ← sub_eq_add_neg]
  have hcompsub : ∀ {A B C : Sheaf (Scheme.ProEt.topology X.left) AddCommGrpCat.{u+1}} {p : ℕ}
      (α : Abelian.Ext A B p) (β₁ β₂ : Abelian.Ext B C 0),
      α.comp (β₁ - β₂) (add_zero p) = α.comp β₁ (add_zero p) - α.comp β₂ (add_zero p) := by
    intro A B C p α β₁ β₂
    rw [sub_eq_add_neg, Abelian.Ext.comp_add, Abelian.Ext.comp_neg, ← sub_eq_add_neg]
  clear_value x'
  clear hback hred hx
  cases i with
  | zero =>
    haveI : Mono (wcContSheafMap X.left (wcTowerIncl ℓ) hcont_incl) := hS2.mono_f
    apply Abelian.Ext.postcomp_mk₀_injective_of_mono (wcFreeSheaf X.left (wcGeomPoint F X h))
      (wcContSheafMap X.left (wcTowerIncl ℓ) hcont_incl)
    rw [map_zero]
    exact hxf
  | succ k =>
    obtain ⟨z, hz⟩ := Abelian.Ext.covariant_sequence_exact₁ _ hS2 x' hxf (n₀ := k) rfl
    obtain ⟨v, hv⟩ := hlim1 k (fun n => z.comp (Abelian.Ext.mk₀
      (wcContSheafMap X.left (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) n) (continuous_apply n)))
      (add_zero k))
    have hv' : ∀ n, z.comp (Abelian.Ext.mk₀
        (wcContSheafMap X.left (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) n) (continuous_apply n)))
        (add_zero k) = v n - (v (n + 1)).comp (Abelian.Ext.mk₀
          (wcContSheafMap X.left (wcTowerCast ℓ n) continuous_of_discreteTopology)) (add_zero k) := hv
    obtain ⟨W, hW⟩ := (hprod k).2 v
    have hWg : W.comp (Abelian.Ext.mk₀ (wcContSheafMap X.left (wcTowerShift ℓ) hcont_shift))
        (add_zero k) = z := by
      rw [← sub_eq_zero]
      apply (hprod k).1
      intro n
      have hpost : ∀ (a b : Abelian.Ext (wcFreeSheaf X.left (wcGeomPoint F X h))
          (wcContSheaf X.left ((n : ℕ) → ZMod (ℓ ^ n))) k),
          (a - b).comp (Abelian.Ext.mk₀ (wcContSheafMap X.left
            (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) n) (continuous_apply n))) (add_zero k) =
          a.comp (Abelian.Ext.mk₀ (wcContSheafMap X.left
            (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) n) (continuous_apply n))) (add_zero k) -
          b.comp (Abelian.Ext.mk₀ (wcContSheafMap X.left
            (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) n) (continuous_apply n))) (add_zero k) := by
        intro a b
        rw [sub_eq_add_neg, Abelian.Ext.add_comp, Abelian.Ext.neg_comp, ← sub_eq_add_neg]
      rw [hpost, Abelian.Ext.comp_assoc _ _ _ (add_zero k) (add_zero 0) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, hTn n, hsubmk, hcompsub, ← Abelian.Ext.mk₀_comp_mk₀,
        ← Abelian.Ext.comp_assoc _ _ _ (add_zero k) (add_zero 0) (by omega), hW, hW, hv' n,
        sub_self]
    have hce : (Abelian.Ext.mk₀ (wcContSheafMap X.left (wcTowerShift ℓ) hcont_shift)).comp
        hS2.extClass (zero_add 1) = 0 := hS2.comp_extClass
    rw [← hz, ← hWg, Abelian.Ext.comp_assoc _ _ _ (add_zero k) (zero_add 1) (by omega), hce,
      Abelian.Ext.comp_zero]

theorem wc_ladic_tower_colimit : ∀ (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)],
    ∃ (κ : Functor.ofSequence (X := fun _ : ℕ => wcIntSheaf S ℓ)
        (fun _ => wcIntScalar S ℓ (ℓ : ℤ_[ℓ])) ⟶ (Functor.const ℕ).obj (wcLadicSheaf S ℓ)),
      Nonempty (Limits.IsColimit (Limits.Cocone.mk _ κ)) ∧
      ∀ n : ℕ, κ.app n = wcIntToLadic S ℓ ≫ wcLadicScalar S ℓ (((ℓ : ℚ_[ℓ]) ^ n)⁻¹) :=
by
  intro S ℓ _
  classical
  haveI hex : HasExactColimitsOfShape ℕ (Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) :=
    @Sheaf.hasExactColimitsOfShape _ AddCommGrpCat.{u+1} ℕ _ _ _ (Scheme.ProEt.topology S) _ _ _
      (@HasExactColimitsOfShape.of_domain_equivalence AddCommGrpCat.{u+1} _ _ _ _ _
        (ULiftHomULiftCategory.equiv.{u+1, u+1} ℕ).symm _ (AB5OfSize.ofShape _))
  have hℓ0 : (ℓ : ℚ_[ℓ]) ≠ 0 := Nat.cast_ne_zero.mpr (Fact.out : Nat.Prime ℓ).ne_zero
  have keyQ : ∀ (c : ℚ_[ℓ]) (U : (S.ProEt)ᵒᵖ) (x : ((wcLadicSheaf S ℓ).obj.obj U : Type (u+1))),
      (wcLadicScalar S ℓ c).hom.app U x =
        (ULift.up (c • (ULift.down x : C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj
          (Opposite.unop U)), ℚ_[ℓ]))) : _) := by
    intro c U x
    rfl
  have keyZ : ∀ (c : ℤ_[ℓ]) (U : (S.ProEt)ᵒᵖ) (x : ((wcIntSheaf S ℓ).obj.obj U : Type (u+1))),
      (wcIntScalar S ℓ c).hom.app U x =
        (ULift.up (c • (ULift.down x : C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj
          (Opposite.unop U)), ℤ_[ℓ]))) : _) := by
    intro c U x
    rfl
  have keyT : ∀ (U : (S.ProEt)ᵒᵖ) (x : ((wcIntSheaf S ℓ).obj.obj U : Type (u+1)))
      (p : ↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop U))),
      (ULift.down ((wcIntToLadic S ℓ).hom.app U x) :
          C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop U)), ℚ_[ℓ])) p =
        (((ULift.down x : C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop U)),
          ℤ_[ℓ])) p : ℤ_[ℓ]) : ℚ_[ℓ]) := by
    intro U x p
    rfl
  have hq1 : wcLadicScalar S ℓ 1 = 𝟙 _ := by
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext U
    apply AddCommGrpCat.ext
    intro x
    rw [keyQ]
    apply ULift.ext
    exact one_smul _ _
  have hqmul : ∀ a b : ℚ_[ℓ],
      wcLadicScalar S ℓ (a * b) = wcLadicScalar S ℓ b ≫ wcLadicScalar S ℓ a := by
    intro a b
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext U
    apply AddCommGrpCat.ext
    intro x
    rw [ObjectProperty.FullSubcategory.comp_hom, NatTrans.comp_app, CategoryTheory.comp_apply,
      keyQ, keyQ, keyQ]
    apply ULift.ext
    exact mul_smul _ _ _
  have hscomm : ∀ a : ℤ_[ℓ], wcIntScalar S ℓ a ≫ wcIntToLadic S ℓ =
      wcIntToLadic S ℓ ≫ wcLadicScalar S ℓ (a : ℚ_[ℓ]) := by
    intro a
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext U
    apply AddCommGrpCat.ext
    intro x
    rw [ObjectProperty.FullSubcategory.comp_hom, ObjectProperty.FullSubcategory.comp_hom,
      NatTrans.comp_app, NatTrans.comp_app, CategoryTheory.comp_apply, CategoryTheory.comp_apply,
      keyQ]
    apply ULift.ext
    apply ContinuousMap.ext
    intro p
    rw [keyT, ContinuousMap.smul_apply, keyT, keyZ]
    exact PadicInt.coe_mul _ _

  have crit : ∀ (T : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
      (G : ℕ ⥤ Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
      (κ : G ⟶ (Functor.const ℕ).obj T), (∀ n, Mono (κ.app n)) →
      Epi (Limits.colimit.desc G (Limits.Cocone.mk T κ)) →
      Nonempty (Limits.IsColimit (Limits.Cocone.mk T κ)) := by
    intro T G κ hmono hepi
    haveI : Mono κ := NatTrans.mono_of_mono_app κ
    haveI : Mono (Limits.colimMap κ) := Functor.map_mono Limits.colim κ
    let e : Limits.colimit ((Functor.const ℕ).obj T) ≅ T :=
      (Limits.colimit.isColimit ((Functor.const ℕ).obj T)).coconePointUniqueUpToIso
        (Limits.isColimitConstCocone ℕ T)
    have he : ∀ n, Limits.colimit.ι ((Functor.const ℕ).obj T) n ≫ e.hom = 𝟙 T := fun n =>
      (Limits.colimit.isColimit ((Functor.const ℕ).obj T)).comp_coconePointUniqueUpToIso_hom
        (Limits.isColimitConstCocone ℕ T) n
    have hD : Limits.colimit.desc G (Limits.Cocone.mk T κ) = Limits.colimMap κ ≫ e.hom := by
      apply Limits.colimit.hom_ext
      intro n
      rw [Limits.colimit.ι_desc, Limits.ι_colimMap_assoc, he]
      exact (Category.comp_id (κ.app n)).symm
    haveI : Mono (Limits.colimMap κ ≫ e.hom) := mono_comp _ _
    haveI : Mono (Limits.colimit.desc G (Limits.Cocone.mk T κ)) := by
      rw [hD]; infer_instance
    haveI : IsIso (Limits.colimit.desc G (Limits.Cocone.mk T κ)) := isIso_of_mono_of_epi _
    haveI : IsIso ((Limits.colimit.isColimit G).desc (Limits.Cocone.mk T κ)) := by
      rw [Limits.colimit.isColimit_desc]; infer_instance
    exact ⟨Limits.IsColimit.ofPointIso (Limits.colimit.isColimit G)⟩

  have hιmono : Mono (wcIntToLadic S ℓ) := by
    haveI : ∀ U, Mono ((wcIntToLadic S ℓ).hom.app U) := fun U =>
      (AddCommGrpCat.mono_iff_injective _).mpr (by
        intro x x' hxx
        let x0 : C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop U)), ℤ_[ℓ]) :=
          x.down
        let x1 : C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop U)), ℤ_[ℓ]) :=
          x'.down
        apply ULift.ext
        apply ContinuousMap.ext
        intro t
        have h := congrArg (fun z => (ULift.down z :
          C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop U)), ℚ_[ℓ])) t) hxx
        have h' : ((x0 t : ℤ_[ℓ]) : ℚ_[ℓ]) = ((x1 t : ℤ_[ℓ]) : ℚ_[ℓ]) := h
        exact PadicInt.ext h')
    haveI : Mono (wcIntToLadic S ℓ).hom := NatTrans.mono_of_mono_app _
    exact Sheaf.Hom.mono_of_presheaf_mono _ _ _

  have hσiso : ∀ c : ℚ_[ℓ], c ≠ 0 → IsIso (wcLadicScalar S ℓ c) := by
    intro c hc
    refine ⟨⟨wcLadicScalar S ℓ c⁻¹, ?_, ?_⟩⟩
    · rw [← hqmul, inv_mul_cancel₀ hc, hq1]
    · rw [← hqmul, mul_inv_cancel₀ hc, hq1]

  have affine_sieve : ∀ (V : S.ProEt) (R : Sieve V),
      (∀ (W : S.ProEt) (f : W ⟶ V), IsAffine W.left → R.arrows f) →
      R ∈ Scheme.ProEt.topology S V := by
    intro V R hR
    have hV : WeaklyEtale V.hom := V.prop
    let W : V.left.affineCover.I₀ → S.ProEt := fun i =>
      MorphismProperty.Over.mk ⊤ (V.left.affineCover.f i ≫ V.hom) inferInstance
    let g : ∀ i, W i ⟶ V := fun i => MorphismProperty.Over.homMk (V.left.affineCover.f i) rfl trivial
    have hP : Presieve.ofArrows W g ∈ (Scheme.ProEt.precoverage S).coverings V := by
      show _ ∈ (Precoverage.comap (Scheme.ProEt.forget S ⋙ Over.forget S)
        Scheme.proetalePrecoverage).coverings V
      rw [Precoverage.mem_comap_iff, Presieve.map_ofArrows]
      change V.left.affineCover.presieve₀ ∈ Scheme.proetalePrecoverage.coverings V.left
      exact ⟨Scheme.zariskiPrecoverage_le_qcPrecoverage V.left V.left.affineCover.mem₀,
        V.left.affineCover.mem₀.1,
        MorphismProperty.ofArrows_mem_precoverage.mpr (fun i => inferInstance)⟩
    refine GrothendieckTopology.superset_covering _ ?_
      (Precoverage.generate_mem_toGrothendieck hP)
    rw [Sieve.generate_le_iff]
    rintro _ _ ⟨i⟩
    exact hR (W i) (g i) (show IsAffine (V.left.affineCover.X i) by infer_instance)

  obtain ⟨κ, hκapp⟩ : ∃ κ : Functor.ofSequence (X := fun _ : ℕ => wcIntSheaf S ℓ)
      (fun _ => wcIntScalar S ℓ (ℓ : ℤ_[ℓ])) ⟶ (Functor.const ℕ).obj (wcLadicSheaf S ℓ),
      ∀ n : ℕ, κ.app n = wcIntToLadic S ℓ ≫ wcLadicScalar S ℓ (((ℓ : ℚ_[ℓ]) ^ n)⁻¹) := by
    refine ⟨NatTrans.ofSequence
      (fun n => wcIntToLadic S ℓ ≫ wcLadicScalar S ℓ (((ℓ : ℚ_[ℓ]) ^ n)⁻¹)) (fun n => ?_),
      fun n => NatTrans.ofSequence_app _ _ n⟩
    have e : ((ℓ : ℚ_[ℓ]) ^ (n + 1))⁻¹ * (ℓ : ℚ_[ℓ]) = ((ℓ : ℚ_[ℓ]) ^ n)⁻¹ := by
      rw [pow_succ, mul_inv, mul_assoc, inv_mul_cancel₀ hℓ0, mul_one]
    have key : wcIntScalar S ℓ (ℓ : ℤ_[ℓ]) ≫ wcIntToLadic S ℓ ≫
        wcLadicScalar S ℓ (((ℓ : ℚ_[ℓ]) ^ (n + 1))⁻¹) =
        wcIntToLadic S ℓ ≫ wcLadicScalar S ℓ (((ℓ : ℚ_[ℓ]) ^ n)⁻¹) := by
      rw [← Category.assoc, hscomm, PadicInt.coe_natCast, Category.assoc, ← hqmul, e]
    rw [Functor.ofSequence_map_homOfLE_succ, Functor.const_obj_map]
    exact key.trans (Category.comp_id _).symm
  refine ⟨κ, ?_, hκapp⟩

  have hepi : Epi (Limits.colimit.desc (Functor.ofSequence (X := fun _ : ℕ => wcIntSheaf S ℓ)
      (fun _ => wcIntScalar S ℓ (ℓ : ℤ_[ℓ]))) (Limits.Cocone.mk _ κ)) := by
    have hls : Presheaf.IsLocallySurjective (Scheme.ProEt.topology S)
        (Limits.colimit.desc (Functor.ofSequence (X := fun _ : ℕ => wcIntSheaf S ℓ)
          (fun _ => wcIntScalar S ℓ (ℓ : ℤ_[ℓ]))) (Limits.Cocone.mk _ κ)).hom := by
      refine ⟨fun {V} s => ?_⟩
      apply affine_sieve V
      intro W f hW
      haveI : CompactSpace ↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj W) :=
        (inferInstance : CompactSpace W.left)
      let g : C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj W), ℚ_[ℓ]) :=
        ((wcLadicSheaf S ℓ).obj.map f.op s).down
      obtain ⟨C, hC⟩ := isCompact_univ.exists_bound_of_continuousOn g.continuous.continuousOn
      have hℓ1 : (1 : ℝ) < (ℓ : ℝ) := Nat.one_lt_cast.mpr (Fact.out : Nat.Prime ℓ).one_lt
      obtain ⟨n, hn⟩ := pow_unbounded_of_one_lt C hℓ1
      have hpos : (0 : ℝ) < (ℓ : ℝ) ^ n := pow_pos (by linarith) n
      have hbd : ∀ x, ‖(ℓ : ℚ_[ℓ]) ^ n * g x‖ ≤ 1 := by
        intro x
        have h1 := hC x (Set.mem_univ x)
        rw [norm_mul, Padic.norm_p_pow, zpow_neg, zpow_natCast, inv_mul_le_iff₀ hpos, mul_one]
        linarith
      let f0 : C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj W), ℤ_[ℓ]) :=
        ⟨fun x => ⟨(ℓ : ℚ_[ℓ]) ^ n * g x, hbd x⟩, (continuous_const.mul g.continuous).subtype_mk _⟩
      let t0 : (wcIntSheaf S ℓ).obj.obj (Opposite.op W) := ULift.up f0
      refine ⟨(Limits.colimit.ι (Functor.ofSequence (X := fun _ : ℕ => wcIntSheaf S ℓ)
        (fun _ => wcIntScalar S ℓ (ℓ : ℤ_[ℓ]))) n).hom.app (Opposite.op W) t0, ?_⟩
      change (Limits.colimit.ι (Functor.ofSequence (X := fun _ : ℕ => wcIntSheaf S ℓ)
        (fun _ => wcIntScalar S ℓ (ℓ : ℤ_[ℓ]))) n ≫ Limits.colimit.desc
          (Functor.ofSequence (X := fun _ : ℕ => wcIntSheaf S ℓ)
          (fun _ => wcIntScalar S ℓ (ℓ : ℤ_[ℓ]))) (Limits.Cocone.mk _ κ)).hom.app
          (Opposite.op W) t0 = _
      rw [Limits.colimit.ι_desc]
      change (κ.app n).hom.app (Opposite.op W) t0 = _
      rw [hκapp n]
      apply ULift.ext
      apply ContinuousMap.ext
      intro x
      change ((ℓ : ℚ_[ℓ]) ^ n)⁻¹ • ((ℓ : ℚ_[ℓ]) ^ n * g x) = g x
      rw [smul_eq_mul, inv_mul_cancel_left₀ (pow_ne_zero n hℓ0)]
    exact (Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u+1} _).mp hls

  refine crit _ _ κ (fun n => ?_) hepi
  have hm : Mono (wcIntToLadic S ℓ ≫ wcLadicScalar S ℓ (((ℓ : ℚ_[ℓ]) ^ n)⁻¹)) := by
    haveI := hιmono
    haveI := hσiso _ (inv_ne_zero (pow_ne_zero n hℓ0))
    exact mono_comp _ _
  rw [hκapp n]
  exact hm

theorem ext_seq_colimit_lift_of_acyclic : ∀ {C : Type*} [Category C] [Abelian C] [HasExt.{w} C]
    [Limits.HasColimitsOfShape ℕ C] [HasExactColimitsOfShape ℕ C] (P : C),
    (∀ (G : ℕ ⥤ C) (c : Limits.Cocone G), Limits.IsColimit c →
      ∀ g : P ⟶ c.pt, ∃ (n : ℕ) (g' : P ⟶ G.obj n), g = g' ≫ c.ι.app n) →
    (∀ G : ℕ ⥤ C, ∃ (I : ℕ ⥤ C) (α : G ⟶ I), Mono α ∧ ∀ (c : Limits.Cocone I),
      Limits.IsColimit c → ∀ (k : ℕ) (x : Abelian.Ext.{w} P c.pt (k + 1)), x = 0) →
    ∀ (j : ℕ) (G : ℕ ⥤ C) (c : Limits.Cocone G), Limits.IsColimit c →
      ∀ x : Abelian.Ext.{w} P c.pt j, ∃ (n : ℕ) (y : Abelian.Ext.{w} P (G.obj n) j),
        x = y.comp (Abelian.Ext.mk₀ (c.ι.app n)) (add_zero j) :=
by
  intro C _ _ _ _ _ P H0 H1 j
  induction j with
  | zero =>
    intro G c hc x
    obtain ⟨n, g', hg⟩ := H0 G c hc (Abelian.Ext.homEquiv₀ x)
    refine ⟨n, Abelian.Ext.mk₀ g', ?_⟩
    rw [Abelian.Ext.mk₀_comp_mk₀, ← hg, Abelian.Ext.mk₀_homEquiv₀_apply]
  | succ j ih =>
    intro G c hc x
    obtain ⟨I, α, hα, hI⟩ := H1 G
    let S : ShortComplex (ℕ ⥤ C) :=
      ShortComplex.mk α (Limits.cokernel.π α) (Limits.cokernel.condition α)
    have hS : S.ShortExact :=
      ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel α) hα inferInstance
    have hSc : (S.map Limits.colim).ShortExact := hS.map_of_exact Limits.colim
    let e := hc.coconePointUniqueUpToIso (Limits.colimit.isColimit G)
    let x' : Abelian.Ext.{w} P (Limits.colimit G) (j + 1) :=
      x.comp (Abelian.Ext.mk₀ e.hom) (add_zero _)
    have h0 : x'.comp (Abelian.Ext.mk₀ (S.map Limits.colim).f) (add_zero _) = 0 :=
      hI (Limits.colimit.cocone I) (Limits.colimit.isColimit I) j _
    obtain ⟨z, hz⟩ := Abelian.Ext.covariant_sequence_exact₁ P hSc x' h0 (n₀ := j) rfl
    obtain ⟨n, w, hw⟩ := ih (Limits.cokernel α) (Limits.colimit.cocone _)
      (Limits.colimit.isColimit _) z
    have hSn : (S.map ((evaluation ℕ C).obj n)).ShortExact := hS.map_of_exact _
    let φ : S.map ((evaluation ℕ C).obj n) ⟶ S.map Limits.colim :=
      ShortComplex.homMk (Limits.colimit.ι G n) (Limits.colimit.ι I n)
        (Limits.colimit.ι (Limits.cokernel α) n)
        (Limits.colimit.ι_map α n) (Limits.colimit.ι_map _ n)
    have hnat : hSn.extClass.comp (Abelian.Ext.mk₀ (Limits.colimit.ι G n)) (add_zero 1) =
        (Abelian.Ext.mk₀ (Limits.colimit.ι (Limits.cokernel α) n)).comp hSc.extClass
          (zero_add 1) := hSn.extClass_naturality hSc φ
    let y : Abelian.Ext.{w} P (G.obj n) (j + 1) := w.comp hSn.extClass rfl
    have key : y.comp (Abelian.Ext.mk₀ (Limits.colimit.ι G n)) (add_zero _) = x' := by
      change (w.comp hSn.extClass rfl).comp _ _ = _
      have hw' : z = w.comp (Abelian.Ext.mk₀ (Limits.colimit.ι (Limits.cokernel α) n))
          (add_zero j) := hw
      rw [Abelian.Ext.comp_assoc _ _ _ rfl (add_zero 1) (by omega), hnat,
        ← Abelian.Ext.comp_assoc _ _ _ (add_zero j) (zero_add 1) (by omega), ← hw', hz]
    refine ⟨n, y, ?_⟩
    have hι : Limits.colimit.ι G n ≫ e.inv = c.ι.app n :=
      Limits.IsColimit.comp_coconePointUniqueUpToIso_inv hc (Limits.colimit.isColimit G) n
    calc x = x.comp (Abelian.Ext.mk₀ (e.hom ≫ e.inv)) (add_zero _) := by
          rw [Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
      _ = x'.comp (Abelian.Ext.mk₀ e.inv) (add_zero _) := by
          rw [← Abelian.Ext.mk₀_comp_mk₀,
            ← Abelian.Ext.comp_assoc _ _ _ (add_zero _) (add_zero 0) (by omega)]
      _ = y.comp (Abelian.Ext.mk₀ (c.ι.app n)) (add_zero _) := by
          rw [← key, Abelian.Ext.comp_assoc _ _ _ (add_zero _) (add_zero 0) (by omega),
            Abelian.Ext.mk₀_comp_mk₀, hι]

theorem injective_tower_of_tower : ∀ {C : Type*} [Category C] [Abelian C] [EnoughInjectives C]
    (G : ℕ ⥤ C), ∃ (I : ℕ ⥤ C) (α : G ⟶ I), Mono α ∧ ∀ n, Injective (I.obj n) :=
by
  intro C _ _ _ G
  let t : (n : ℕ) → Injective.under (G.obj n) ⟶ Injective.under (G.obj (n + 1)) := fun n =>
    Injective.factorThru (G.map (homOfLE (Nat.le_succ n)) ≫ Injective.ι (G.obj (n + 1)))
      (Injective.ι (G.obj n))
  let I : ℕ ⥤ C := Functor.ofSequence t
  have hnat : ∀ n : ℕ, G.map (homOfLE (Nat.le_succ n)) ≫ Injective.ι (G.obj (n + 1)) =
      Injective.ι (G.obj n) ≫ I.map (homOfLE (Nat.le_succ n)) := by
    intro n
    rw [Functor.ofSequence_map_homOfLE_succ]
    exact (Injective.comp_factorThru _ _).symm
  let α : G ⟶ I := NatTrans.ofSequence (F := G) (G := I)
    (fun n => Injective.ι (G.obj n)) hnat
  refine ⟨I, α, ?_, fun n => Injective.injective_under (G.obj n)⟩
  haveI : ∀ n, Mono (α.app n) := by
    intro n
    exact (Injective.ι_mono (G.obj n) : Mono (Injective.ι (G.obj n)))
  exact NatTrans.mono_of_mono_app α

theorem sheaf_seq_colimit_section_locally_lifts : ∀ {C : Type (u+1)} [Category.{u} C]
    (J : GrothendieckTopology C)
    (G : ℕ ⥤ Sheaf J AddCommGrpCat.{u+1}) (c : Limits.Cocone G), Limits.IsColimit c →
    ∀ (K : C) (s : c.pt.obj.obj (Opposite.op K)), ∃ R ∈ J K, ∀ (Y : C) (f : Y ⟶ K), R.arrows f →
      ∃ (n : ℕ) (t : (G.obj n).obj.obj (Opposite.op Y)),
        (c.ι.app n).hom.app (Opposite.op Y) t = c.pt.obj.map f.op s :=
by
  intro C _ J G c hc K s
  let P := G ⋙ sheafToPresheaf J AddCommGrpCat.{u+1}
  let E := Limits.colimit.cocone P
  let hE := Sheaf.isColimitSheafifyCocone E (Limits.colimit.isColimit P)
  let φ := hE.coconePointUniqueUpToIso hc
  let ψ : sheafify J E.pt ⟶ c.pt.obj := φ.hom.hom
  have hA : ∀ n, E.ι.app n ≫ toSheafify J E.pt ≫ ψ = (c.ι.app n).hom := by
    intro n
    have h1 := congrArg (fun g => g.hom) (hE.comp_coconePointUniqueUpToIso_hom hc n)
    simp only [ObjectProperty.FullSubcategory.comp_hom, Sheaf.sheafifyCocone_ι_app_val] at h1
    rw [← h1]
    exact (Category.assoc _ _ _).symm
  let s' : (sheafify J E.pt).obj (Opposite.op K) := φ.inv.hom.app (Opposite.op K) s
  have hC : ψ.app (Opposite.op K) s' = s :=
    Iso.inv_hom_id_apply (((sheafToPresheaf J AddCommGrpCat.{u+1}).mapIso φ).app (Opposite.op K)) s
  refine ⟨Presheaf.imageSieve (toSheafify J E.pt) s', Presheaf.imageSieve_mem J _ s', ?_⟩
  intro Y f hf
  obtain ⟨e₀, he₀⟩ := hf
  haveI : Limits.PreservesFilteredColimitsOfSize.{0, 0} (forget AddCommGrpCat.{u+1}) :=
    Limits.preservesFilteredColimitsOfSize_shrink (forget AddCommGrpCat.{u+1})
  obtain ⟨n, t, ht⟩ := Limits.Concrete.isColimit_exists_rep
    (P ⋙ (evaluation Cᵒᵖ AddCommGrpCat.{u+1}).obj (Opposite.op Y))
    (Limits.isColimitOfPreserves ((evaluation Cᵒᵖ AddCommGrpCat.{u+1}).obj (Opposite.op Y))
      (Limits.colimit.isColimit P)) e₀
  refine ⟨n, t, ?_⟩
  have hAY : ψ.app (Opposite.op Y) ((toSheafify J E.pt).app (Opposite.op Y)
      ((E.ι.app n).app (Opposite.op Y) t)) = (c.ι.app n).hom.app (Opposite.op Y) t := by
    rw [← hA n]
    rfl
  rw [← hAY]
  rw [show (E.ι.app n).app (Opposite.op Y) t = e₀ from ht]
  rw [he₀]
  rw [← hC]
  exact NatTrans.naturality_apply ψ f.op s'

theorem sheaf_seq_colimit_section_locally_dies : ∀ {C : Type (u+1)} [Category.{u} C]
    (J : GrothendieckTopology C)
    (G : ℕ ⥤ Sheaf J AddCommGrpCat.{u+1}) (c : Limits.Cocone G), Limits.IsColimit c →
    ∀ (K : C) (n : ℕ) (t : (G.obj n).obj.obj (Opposite.op K)),
      (c.ι.app n).hom.app (Opposite.op K) t = 0 →
      ∃ R ∈ J K, ∀ (Y : C) (f : Y ⟶ K), R.arrows f →
        ∃ (m : ℕ) (hnm : n ≤ m),
          (G.map (homOfLE hnm)).hom.app (Opposite.op Y) ((G.obj n).obj.map f.op t) = 0 :=
by
  intro C _ J G c hc K n t ht
  let P := G ⋙ sheafToPresheaf J AddCommGrpCat.{u+1}
  let E := Limits.colimit.cocone P
  let hE := Sheaf.isColimitSheafifyCocone E (Limits.colimit.isColimit P)
  let φ := hE.coconePointUniqueUpToIso hc
  let ψ : sheafify J E.pt ⟶ c.pt.obj := φ.hom.hom
  have hA : ∀ n, E.ι.app n ≫ toSheafify J E.pt ≫ ψ = (c.ι.app n).hom := by
    intro n
    have h1 := congrArg (fun g => g.hom) (hE.comp_coconePointUniqueUpToIso_hom hc n)
    simp only [ObjectProperty.FullSubcategory.comp_hom, Sheaf.sheafifyCocone_ι_app_val] at h1
    rw [← h1]
    exact (Category.assoc _ _ _).symm
  have hinj : ∀ x : (sheafify J E.pt).obj (Opposite.op K),
      ψ.app (Opposite.op K) x = 0 → x = 0 := by
    intro x hx
    have h := Iso.hom_inv_id_apply
      (((sheafToPresheaf J AddCommGrpCat.{u+1}).mapIso φ).app (Opposite.op K)) x
    rw [← h]
    change φ.inv.hom.app (Opposite.op K) (ψ.app (Opposite.op K) x) = 0
    rw [hx, map_zero]
  let e : E.pt.obj (Opposite.op K) := (E.ι.app n).app (Opposite.op K) t
  have he : (toSheafify J E.pt).app (Opposite.op K) e =
      (toSheafify J E.pt).app (Opposite.op K) 0 := by
    rw [map_zero]
    apply hinj
    have hAK : ψ.app (Opposite.op K) ((toSheafify J E.pt).app (Opposite.op K) e) =
        (c.ι.app n).hom.app (Opposite.op K) t := by
      rw [← hA n]
      rfl
    rw [hAK, ht]
  haveI hLI : Presheaf.IsLocallyInjective J (toSheafify J E.pt) :=
    Presheaf.isLocallyInjective_toSheafify' J E.pt
  refine ⟨Presheaf.equalizerSieve e 0,
    Presheaf.IsLocallyInjective.equalizerSieve_mem (J := J) (φ := toSheafify J E.pt) e 0 he, ?_⟩
  intro Y f hf
  have hf' : E.pt.map f.op e = E.pt.map f.op 0 := hf
  rw [map_zero] at hf'
  have hY : (E.ι.app n).app (Opposite.op Y) ((G.obj n).obj.map f.op t) = 0 := by
    rw [← hf']
    exact NatTrans.naturality_apply (E.ι.app n) f.op t
  haveI : Limits.PreservesFilteredColimitsOfSize.{0, 0} (forget AddCommGrpCat.{u+1}) :=
    Limits.preservesFilteredColimitsOfSize_shrink (forget AddCommGrpCat.{u+1})
  obtain ⟨k, a, b, hab⟩ := Limits.Concrete.isColimit_exists_of_rep_eq
    (P ⋙ (evaluation Cᵒᵖ AddCommGrpCat.{u+1}).obj (Opposite.op Y))
    (Limits.isColimitOfPreserves ((evaluation Cᵒᵖ AddCommGrpCat.{u+1}).obj (Opposite.op Y))
      (Limits.colimit.isColimit P)) ((G.obj n).obj.map f.op t) 0 (by
        change (E.ι.app n).app (Opposite.op Y) ((G.obj n).obj.map f.op t) =
          (E.ι.app n).app (Opposite.op Y) 0
        rw [hY, map_zero])
  refine ⟨k, leOfHom a, ?_⟩
  have hab' : (G.map a).hom.app (Opposite.op Y) ((G.obj n).obj.map f.op t) =
      (G.map b).hom.app (Opposite.op Y) 0 := hab
  rw [map_zero] at hab'
  exact hab'

theorem sheaf_seq_kill_of_finite_refinement : ∀ {C : Type (u+1)} [Category.{u} C]
    (J : GrothendieckTopology C)
    (G : ℕ ⥤ Sheaf J AddCommGrpCat.{u+1}) (K : C),
    (∀ R ∈ J K, ∃ (k : ℕ) (V : Fin k → C) (f : ∀ j, V j ⟶ K), (∀ j, R.arrows (f j)) ∧
      Sieve.generate (Presieve.ofArrows V f) ∈ J K) →
    ∀ (n : ℕ) (t : (G.obj n).obj.obj (Opposite.op K)) (R : Sieve K), R ∈ J K →
    (∀ (Y : C) (f : Y ⟶ K), R.arrows f → ∃ (m : ℕ) (hnm : n ≤ m),
        (G.map (homOfLE hnm)).hom.app (Opposite.op Y) ((G.obj n).obj.map f.op t) = 0) →
    ∃ (m : ℕ) (hnm : n ≤ m), (G.map (homOfLE hnm)).hom.app (Opposite.op K) t = 0 :=
by
  intro C _ J G K hfin n t R hR hloc
  obtain ⟨k, V, f, hf, hS⟩ := hfin R hR
  choose m hnm hm using fun j => hloc (V j) (f j) (hf j)
  have hjM : ∀ j, m j ≤ n + ∑ i, m i := fun j => by
    have := Finset.single_le_sum (f := m) (fun i _ => Nat.zero_le _) (Finset.mem_univ j)
    omega
  have hnM : n ≤ n + ∑ i, m i := Nat.le_add_right _ _
  refine ⟨n + ∑ i, m i, hnM, ?_⟩
  have key : ∀ j, (G.obj (n + ∑ i, m i)).obj.map (f j).op
      ((G.map (homOfLE hnM)).hom.app (Opposite.op K) t) = 0 := by
    intro j
    have h1 : (G.obj (n + ∑ i, m i)).obj.map (f j).op
        ((G.map (homOfLE hnM)).hom.app (Opposite.op K) t) =
        (G.map (homOfLE hnM)).hom.app (Opposite.op (V j)) ((G.obj n).obj.map (f j).op t) :=
      (NatTrans.naturality_apply (G.map (homOfLE hnM)).hom (f j).op t).symm
    have h2 : G.map (homOfLE hnM) = G.map (homOfLE (hnm j)) ≫ G.map (homOfLE (hjM j)) := by
      rw [← G.map_comp]; rfl
    have h3 : (G.map (homOfLE hnM)).hom.app (Opposite.op (V j)) ((G.obj n).obj.map (f j).op t) =
        (G.map (homOfLE (hjM j))).hom.app (Opposite.op (V j))
          ((G.map (homOfLE (hnm j))).hom.app (Opposite.op (V j))
            ((G.obj n).obj.map (f j).op t)) := by
      rw [h2]; rfl
    rw [h1, h3, hm j, map_zero]
  apply Sheaf.isSeparated (G.obj (n + ∑ i, m i)) K _ hS
  intro Y g hg
  obtain ⟨Y', h, g', hg', rfl⟩ := hg
  rcases hg' with ⟨j⟩
  rw [map_zero, op_comp, Functor.map_comp, ConcreteCategory.comp_apply, key j, map_zero]

theorem sheaf_seq_glue_finite_cover : ∀ {C : Type (u+1)} [Category.{u} C] [Limits.HasPullbacks C]
    (J : GrothendieckTopology C)
    (G : ℕ ⥤ Sheaf J AddCommGrpCat.{u+1}) (c : Limits.Cocone G) (K : C)
    (k : ℕ) (V : Fin k → C) (f : ∀ j, V j ⟶ K), Sieve.generate (Presieve.ofArrows V f) ∈ J K →
    (∀ (i j : Fin k) (n : ℕ) (t : (G.obj n).obj.obj (Opposite.op (Limits.pullback (f i) (f j)))),
      (c.ι.app n).hom.app (Opposite.op (Limits.pullback (f i) (f j))) t = 0 →
      ∃ (m : ℕ) (hnm : n ≤ m),
        (G.map (homOfLE hnm)).hom.app (Opposite.op (Limits.pullback (f i) (f j))) t = 0) →
    ∀ s : c.pt.obj.obj (Opposite.op K),
    (∀ j, ∃ (n : ℕ) (t : (G.obj n).obj.obj (Opposite.op (V j))),
      (c.ι.app n).hom.app (Opposite.op (V j)) t = c.pt.obj.map (f j).op s) →
    ∃ (n : ℕ) (t : (G.obj n).obj.obj (Opposite.op K)),
      (c.ι.app n).hom.app (Opposite.op K) t = s :=
by
  intro C _ _ J G c K k V f hcov hover s hlift

  have nat : ∀ (m : ℕ) {X Y : C} (g : X ⟶ Y) (y : (G.obj m).obj.obj (Opposite.op Y)),
      (c.ι.app m).hom.app (Opposite.op X) ((G.obj m).obj.map g.op y) =
        c.pt.obj.map g.op ((c.ι.app m).hom.app (Opposite.op Y) y) :=
    fun m X Y g y => NatTrans.naturality_apply (c.ι.app m).hom g.op y
  have mapc : ∀ {X Y Z : C} (g : X ⟶ Y) (h : Y ⟶ Z) (z : c.pt.obj.obj (Opposite.op Z)),
      c.pt.obj.map (g ≫ h).op z = c.pt.obj.map g.op (c.pt.obj.map h.op z) := by
    intro X Y Z g h z
    rw [op_comp, Functor.map_comp, ConcreteCategory.comp_apply]

  choose n t ht using hlift
  have hjN : ∀ j, n j ≤ ∑ i, n i := fun j =>
    Finset.single_le_sum (f := n) (fun i _ => Nat.zero_le _) (Finset.mem_univ j)
  set N := ∑ i, n i with hN
  let t' : ∀ j, (G.obj N).obj.obj (Opposite.op (V j)) := fun j =>
    (G.map (homOfLE (hjN j))).hom.app (Opposite.op (V j)) (t j)
  have ht' : ∀ j, (c.ι.app N).hom.app (Opposite.op (V j)) (t' j) = c.pt.obj.map (f j).op s := by
    intro j
    rw [← ht j]
    exact congrArg (fun φ => φ.hom.app (Opposite.op (V j)) (t j)) (c.w (homOfLE (hjN j)))

  let x : ∀ a : Fin k × Fin k,
      (G.obj N).obj.obj (Opposite.op (Limits.pullback (f a.1) (f a.2))) := fun a =>
    (G.obj N).obj.map (Limits.pullback.fst (f a.1) (f a.2)).op (t' a.1) -
      (G.obj N).obj.map (Limits.pullback.snd (f a.1) (f a.2)).op (t' a.2)
  have hx : ∀ a, (c.ι.app N).hom.app _ (x a) = 0 := by
    intro a
    show (c.ι.app N).hom.app _
      ((G.obj N).obj.map (Limits.pullback.fst (f a.1) (f a.2)).op (t' a.1) -
        (G.obj N).obj.map (Limits.pullback.snd (f a.1) (f a.2)).op (t' a.2)) = 0
    rw [map_sub, nat, nat, ht', ht', ← mapc, ← mapc, Limits.pullback.condition, sub_self]
  choose m hNm hm using fun a : Fin k × Fin k => hover a.1 a.2 N (x a) (hx a)

  have hmN' : ∀ a, m a ≤ N + ∑ b, m b := fun a => by
    have := Finset.single_le_sum (f := m) (fun b _ => Nat.zero_le _) (Finset.mem_univ a)
    omega
  have hNN' : N ≤ N + ∑ b, m b := Nat.le_add_right _ _
  set N' := N + ∑ b, m b with hN'
  have hkill : ∀ a, (G.map (homOfLE hNN')).hom.app _ (x a) = 0 := by
    intro a
    have h2 : G.map (homOfLE hNN') = G.map (homOfLE (hNm a)) ≫ G.map (homOfLE (hmN' a)) := by
      rw [← G.map_comp]; rfl
    have h3 : (G.map (homOfLE hNN')).hom.app _ (x a) =
        (G.map (homOfLE (hmN' a))).hom.app _ ((G.map (homOfLE (hNm a))).hom.app _ (x a)) := by
      rw [h2]; rfl
    rw [h3, hm a, map_zero]

  let y : ∀ j, (G.obj N').obj.obj (Opposite.op (V j)) := fun j =>
    (G.map (homOfLE hNN')).hom.app (Opposite.op (V j)) (t' j)
  have natT : ∀ {X Y : C} (g : X ⟶ Y) (z : (G.obj N).obj.obj (Opposite.op Y)),
      (G.obj N').obj.map g.op ((G.map (homOfLE hNN')).hom.app (Opposite.op Y) z) =
        (G.map (homOfLE hNN')).hom.app (Opposite.op X) ((G.obj N).obj.map g.op z) :=
    fun g z => (NatTrans.naturality_apply (G.map (homOfLE hNN')).hom g.op z).symm
  have compat : ∀ i j, (G.obj N').obj.map (Limits.pullback.fst (f i) (f j)).op (y i) =
      (G.obj N').obj.map (Limits.pullback.snd (f i) (f j)).op (y j) := by
    intro i j
    rw [← sub_eq_zero]
    show (G.obj N').obj.map (Limits.pullback.fst (f i) (f j)).op
        ((G.map (homOfLE hNN')).hom.app _ (t' i)) -
      (G.obj N').obj.map (Limits.pullback.snd (f i) (f j)).op
        ((G.map (homOfLE hNN')).hom.app _ (t' j)) = 0
    rw [natT, natT, ← map_sub]
    exact hkill (i, j)

  have hsh : Presieve.IsSheaf J ((G.obj N').obj ⋙ forget AddCommGrpCat.{u+1}) :=
    (isSheaf_iff_isSheaf_of_type J _).mp
      ((sheafCompose J (forget AddCommGrpCat.{u+1})).obj (G.obj N')).property
  have hsf := hsh.isSheafFor _ hcov
  obtain ⟨tg, htg, -⟩ := (Presieve.isSheafFor_arrows_iff_pullbacks _ f).mp hsf y compat
  have htg' : ∀ j, (G.obj N').obj.map (f j).op tg = y j := htg

  refine ⟨N', tg, ?_⟩
  apply Sheaf.isSeparated c.pt K _ hcov
  intro Y g hg
  obtain ⟨Y', h, g', hg', rfl⟩ := hg
  rcases hg' with ⟨j⟩
  rw [mapc, mapc]
  congr 1
  rw [← nat, htg' j, ← ht' j]
  exact congrArg (fun φ => φ.hom.app (Opposite.op (V j)) (t' j)) (c.w (homOfLE hNN'))

theorem proet_pullback_qcqs : ∀ (S : Scheme.{u}) {U V W : S.ProEt} (f : V ⟶ U) (g : W ⟶ U)
    [QuasiSeparatedSpace U.left] [CompactSpace V.left] [QuasiSeparatedSpace V.left]
    [CompactSpace W.left] [QuasiSeparatedSpace W.left],
    CompactSpace (Limits.pullback f g).left ∧ QuasiSeparatedSpace (Limits.pullback f g).left :=
by
  intro S U V W f g _ _ _ _ _
  have sq : IsPullback (Limits.pullback.fst f g).left (Limits.pullback.snd f g).left
      f.left g.left :=
    (Scheme.ProEt.forget S ⋙ Over.forget S).map_isPullback (IsPullback.of_hasPullback f g)
  haveI hqc : QuasiCompact (Limits.pullback.snd f g).left :=
    MorphismProperty.of_isPullback (P := @QuasiCompact) sq (quasiCompact_of_compactSpace f.left)
  haveI hqs : QuasiSeparated (Limits.pullback.snd f g).left :=
    MorphismProperty.of_isPullback (P := @QuasiSeparated) sq
      (QuasiSeparated.of_quasiSeparatedSpace f.left)
  exact ⟨QuasiCompact.compactSpace_of_compactSpace (Limits.pullback.snd f g).left,
    quasiSeparatedSpace_of_quasiSeparated (Limits.pullback.snd f g).left⟩

theorem proet_free_hom_seq_colimit : ∀ (S : Scheme.{u}) (U : S.ProEt) [CompactSpace U.left]
    [QuasiSeparatedSpace U.left] (G : ℕ ⥤ Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
    (c : Limits.Cocone G), Limits.IsColimit c →
    (∀ g : wcFreeSheaf S U ⟶ c.pt, ∃ (n : ℕ) (g' : wcFreeSheaf S U ⟶ G.obj n),
      g = g' ≫ c.ι.app n) ∧
    (∀ (n : ℕ) (g' : wcFreeSheaf S U ⟶ G.obj n), g' ≫ c.ι.app n = 0 →
      ∃ (m : ℕ) (hnm : n ≤ m), g' ≫ G.map (homOfLE hnm) = 0) :=
by
  intro S U _ _ G c hc
  obtain ⟨e, he_nat, he_zero⟩ := proet_free_sheaf_hom_equiv S U
  have kill : ∀ (K : S.ProEt) [CompactSpace K.left] [QuasiSeparatedSpace K.left] (n : ℕ)
      (t : (G.obj n).obj.obj (Opposite.op K)), (c.ι.app n).hom.app (Opposite.op K) t = 0 →
      ∃ (m : ℕ) (hnm : n ≤ m), (G.map (homOfLE hnm)).hom.app (Opposite.op K) t = 0 := by
    intro K _ _ n t ht
    obtain ⟨R, hR, hloc⟩ := sheaf_seq_colimit_section_locally_dies _ G c hc K n t ht
    refine sheaf_seq_kill_of_finite_refinement _ G K ?_ n t R hR hloc
    intro R' hR'
    obtain ⟨k, V, f, hf, -, hcov⟩ := proet_qcqs_finite_affine_refinement S K R' hR'
    exact ⟨k, V, f, hf, hcov⟩
  constructor
  · intro g
    obtain ⟨R, hR, hlift⟩ := sheaf_seq_colimit_section_locally_lifts _ G c hc U (e c.pt g)
    obtain ⟨k, V, f, hf, haff, hcov⟩ := proet_qcqs_finite_affine_refinement S U R hR
    have hover : ∀ (i j : Fin k) (n : ℕ)
        (t : (G.obj n).obj.obj (Opposite.op (Limits.pullback (f i) (f j)))),
        (c.ι.app n).hom.app (Opposite.op (Limits.pullback (f i) (f j))) t = 0 →
        ∃ (m : ℕ) (hnm : n ≤ m),
          (G.map (homOfLE hnm)).hom.app (Opposite.op (Limits.pullback (f i) (f j))) t = 0 := by
      intro i j n t ht
      haveI := haff i
      haveI := haff j
      haveI : QuasiSeparatedSpace (V i).left := quasiSeparatedSpace_of_isAffine _
      haveI : QuasiSeparatedSpace (V j).left := quasiSeparatedSpace_of_isAffine _
      obtain ⟨h1, h2⟩ := proet_pullback_qcqs S (f i) (f j)
      haveI := h1
      haveI := h2
      exact kill _ n t ht
    obtain ⟨n, t, ht⟩ := sheaf_seq_glue_finite_cover _ G c U k V f hcov hover (e c.pt g)
      (fun j => hlift _ (f j) (hf j))
    refine ⟨n, (e (G.obj n)).symm t, ?_⟩
    apply (e c.pt).injective
    rw [he_nat, Equiv.apply_symm_apply, ht]
  · intro n g' hg'
    have ht : (c.ι.app n).hom.app (Opposite.op U) (e (G.obj n) g') = 0 := by
      rw [← he_nat, hg', he_zero]
    obtain ⟨m, hnm, hm⟩ := kill U n _ ht
    refine ⟨m, hnm, (e (G.obj m)).injective ?_⟩
    rw [he_nat, hm, he_zero]

theorem proet_ext_colimit_injectives_vanish : ∀ (S : Scheme.{u}) (U : S.ProEt) [CompactSpace U.left]
    [QuasiSeparatedSpace U.left] (I : ℕ ⥤ Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}),
    (∀ n, Injective (I.obj n)) → ∀ (c : Limits.Cocone I), Limits.IsColimit c →
    ∀ (k : ℕ) (x : Abelian.Ext (wcFreeSheaf S U) c.pt (k + 1)), x = 0 :=
by
  intro S U _ _ I hI c hc k x

  have sq : ∀ (K : S.ProEt) (n : ℕ) (Xs : Fin (n + 1) → S.ProEt) (g : ∀ i, Xs i ⟶ K),
      IsPullback (Limits.WidePullback.lift (Limits.WidePullback.base g)
        (fun i : Fin n => Limits.WidePullback.π g i.castSucc)
        (fun i => Limits.WidePullback.π_arrow g i.castSucc) :
          Limits.widePullback K Xs g ⟶ Limits.widePullback K (fun i : Fin n => Xs i.castSucc)
            (fun i => g i.castSucc))
        (Limits.WidePullback.π g (Fin.last n))
        (Limits.WidePullback.base (fun i : Fin n => g i.castSucc)) (g (Fin.last n)) := by
    intro K n Xs g
    have w : (Limits.WidePullback.lift (Limits.WidePullback.base g)
        (fun i : Fin n => Limits.WidePullback.π g i.castSucc)
        (fun i => Limits.WidePullback.π_arrow g i.castSucc) :
          Limits.widePullback K Xs g ⟶ Limits.widePullback K (fun i : Fin n => Xs i.castSucc)
            (fun i => g i.castSucc)) ≫
        Limits.WidePullback.base (fun i : Fin n => g i.castSucc) =
        Limits.WidePullback.π g (Fin.last n) ≫ g (Fin.last n) := by
      rw [Limits.WidePullback.lift_base, Limits.WidePullback.π_arrow]
    refine IsPullback.of_isLimit (c := Limits.PullbackCone.mk _ _ w) ?_
    refine Limits.PullbackCone.IsLimit.mk w
      (fun s => Limits.WidePullback.lift (s.fst ≫ Limits.WidePullback.base _)
        (Fin.lastCases (motive := fun j => s.pt ⟶ Xs j) s.snd
          (fun i => s.fst ≫ Limits.WidePullback.π (fun i : Fin n => g i.castSucc) i))
        (fun j => by
          induction j using Fin.lastCases with
          | last => rw [Fin.lastCases_last]; exact s.condition.symm
          | cast i =>
            rw [Fin.lastCases_castSucc, Category.assoc, Limits.WidePullback.π_arrow]))
      (fun s => ?_) (fun s => ?_) (fun s m h1 h2 => ?_)
    · apply Limits.WidePullback.hom_ext
      · intro j
        rw [Category.assoc, Limits.WidePullback.lift_π, Limits.WidePullback.lift_π,
          Fin.lastCases_castSucc]
      · rw [Category.assoc, Limits.WidePullback.lift_base, Limits.WidePullback.lift_base]
    · rw [Limits.WidePullback.lift_π, Fin.lastCases_last]
    · apply Limits.WidePullback.hom_ext
      · intro j
        induction j using Fin.lastCases with
        | last => rw [Limits.WidePullback.lift_π, Fin.lastCases_last]; exact h2
        | cast i =>
          rw [Limits.WidePullback.lift_π, Fin.lastCases_castSucc, ← h1, Category.assoc,
            Limits.WidePullback.lift_π]
      · rw [Limits.WidePullback.lift_base, ← h1, Category.assoc, Limits.WidePullback.lift_base]

  have main : ∀ (K : S.ProEt) (k' : ℕ) (V : Fin k' → S.ProEt) (f : ∀ i, V i ⟶ K),
      QuasiSeparatedSpace K.left → (∀ i, IsAffine (V i).left) →
      ∀ (n : ℕ) (τ : Fin n → Fin k'),
      QuasiCompact (Limits.WidePullback.base (fun l => f (τ l))).left ∧
      QuasiSeparated (Limits.WidePullback.base (fun l => f (τ l))).left := by
    intro K k' V f hKqs hVaff n
    haveI := hKqs
    have leg : ∀ i, QuasiCompact (f i).left ∧ QuasiSeparated (f i).left := by
      intro i
      haveI := hVaff i
      exact ⟨inferInstance, inferInstance⟩
    induction n with
    | zero =>
      intro τ
      let e0 : Limits.widePullback K (fun l => V (τ l)) (fun l => f (τ l)) ≅ K :=
        { hom := Limits.WidePullback.base _
          inv := Limits.WidePullback.lift (𝟙 K) (fun i => Fin.elim0 i) (fun i => Fin.elim0 i)
          hom_inv_id := by
            apply Limits.WidePullback.hom_ext
            · intro j; exact Fin.elim0 j
            · rw [Category.assoc, Limits.WidePullback.lift_base, Category.comp_id,
                Category.id_comp]
          inv_hom_id := Limits.WidePullback.lift_base _ _ _ _ }
      let E := (Scheme.ProEt.forget S ⋙ Over.forget S).mapIso e0
      haveI hE : IsIso E.hom := Iso.isIso_hom E
      have hEq : E.hom = (Limits.WidePullback.base (fun l => f (τ l))).left := rfl
      haveI : IsIso (Limits.WidePullback.base (fun l => f (τ l))).left := hEq ▸ hE
      exact ⟨inferInstance, inferInstance⟩
    | succ n ih =>
      intro τ
      obtain ⟨hqc, hqs⟩ := ih (fun i => τ i.castSucc)
      have hsq := (sq K n (fun l => V (τ l)) (fun l => f (τ l))).map
        (Scheme.ProEt.forget S ⋙ Over.forget S)
      obtain ⟨lqc, lqs⟩ := leg (τ (Fin.last n))
      have rqc := MorphismProperty.of_isPullback (P := @QuasiCompact) hsq.flip lqc
      have rqs := MorphismProperty.of_isPullback (P := @QuasiSeparated) hsq.flip lqs
      have hfac : (Limits.WidePullback.base (fun l => f (τ l))).left =
          (Limits.WidePullback.lift (Limits.WidePullback.base (fun l => f (τ l)))
            (fun i : Fin n => Limits.WidePullback.π (fun l => f (τ l)) i.castSucc)
            (fun i => Limits.WidePullback.π_arrow (fun l => f (τ l)) i.castSucc)).left ≫
          (Limits.WidePullback.base (fun i : Fin n => f (τ i.castSucc))).left := by
        change (Scheme.ProEt.forget S ⋙ Over.forget S).map
            (Limits.WidePullback.base (fun l => f (τ l))) =
          (Scheme.ProEt.forget S ⋙ Over.forget S).map
            (Limits.WidePullback.lift (Limits.WidePullback.base (fun l => f (τ l)))
              (fun i : Fin n => Limits.WidePullback.π (fun l => f (τ l)) i.castSucc)
              (fun i => Limits.WidePullback.π_arrow (fun l => f (τ l)) i.castSucc)) ≫
          (Scheme.ProEt.forget S ⋙ Over.forget S).map
            (Limits.WidePullback.base (fun i : Fin n => f (τ i.castSucc)))
        rw [← Functor.map_comp, Limits.WidePullback.lift_base]
      haveI : QuasiCompact (Limits.WidePullback.lift (Limits.WidePullback.base (fun l => f (τ l)))
            (fun i : Fin n => Limits.WidePullback.π (fun l => f (τ l)) i.castSucc)
            (fun i => Limits.WidePullback.π_arrow (fun l => f (τ l)) i.castSucc)).left := rqc
      haveI : QuasiSeparated (Limits.WidePullback.lift (Limits.WidePullback.base (fun l => f (τ l)))
            (fun i : Fin n => Limits.WidePullback.π (fun l => f (τ l)) i.castSucc)
            (fun i => Limits.WidePullback.π_arrow (fun l => f (τ l)) i.castSucc)).left := rqs
      haveI := hqc
      haveI := hqs
      rw [hfac]
      exact ⟨inferInstance, inferInstance⟩

  have wpgood : ∀ (K : S.ProEt) (k' : ℕ) (V : Fin k' → S.ProEt) (f : ∀ i, V i ⟶ K),
      CompactSpace K.left → QuasiSeparatedSpace K.left → (∀ i, IsAffine (V i).left) →
      ∀ (p : ℕ) (σ : Fin (p + 1) → Fin k'),
        CompactSpace (Limits.widePullback K (fun l => V (σ l)) (fun l => f (σ l))).left ∧
        QuasiSeparatedSpace (Limits.widePullback K (fun l => V (σ l)) (fun l => f (σ l))).left := by
    intro K k' V f hKc hKqs hVaff p σ
    haveI := hKc
    haveI := hKqs
    obtain ⟨hqc, hqs⟩ := main K k' V f hKqs hVaff (p + 1) σ
    exact ⟨QuasiCompact.compactSpace_of_compactSpace
        (Limits.WidePullback.base (fun l => f (σ l))).left,
      quasiSeparatedSpace_of_quasiSeparated (Limits.WidePullback.base (fun l => f (σ l))).left⟩

  have pbgood : ∀ (K A B : S.ProEt) (a : A ⟶ K) (b : B ⟶ K),
      QuasiSeparatedSpace K.left → IsAffine A.left → IsAffine B.left →
      CompactSpace (Limits.pullback a b).left ∧ QuasiSeparatedSpace (Limits.pullback a b).left := by
    intro K A B a b hK hA hB
    haveI := hK
    haveI := hA
    haveI := hB
    have hsq := (IsPullback.of_hasPullback a b).map (Scheme.ProEt.forget S ⋙ Over.forget S)
    have hbqc : QuasiCompact b.left := inferInstance
    have hbqs : QuasiSeparated b.left := inferInstance
    have rqc := MorphismProperty.of_isPullback (P := @QuasiCompact) hsq.flip hbqc
    have rqs := MorphismProperty.of_isPullback (P := @QuasiSeparated) hsq.flip hbqs
    haveI : QuasiCompact (Limits.pullback.fst a b).left := rqc
    haveI : QuasiSeparated (Limits.pullback.fst a b).left := rqs
    exact ⟨QuasiCompact.compactSpace_of_compactSpace (Limits.pullback.fst a b).left,
      quasiSeparatedSpace_of_quasiSeparated (Limits.pullback.fst a b).left⟩

  have injK : ∀ (K : S.ProEt), CompactSpace K.left → QuasiSeparatedSpace K.left →
      ∀ (n : ℕ) (t : (I.obj n).obj.obj (Opposite.op K)),
        (c.ι.app n).hom.app (Opposite.op K) t = 0 →
        ∃ (m : ℕ) (hnm : n ≤ m), (I.map (homOfLE hnm)).hom.app (Opposite.op K) t = 0 := by
    intro K hK1 hK2 n t ht
    haveI := hK1
    haveI := hK2
    obtain ⟨R, hR, hRk⟩ :=
      sheaf_seq_colimit_section_locally_dies (Scheme.ProEt.topology S) I c hc K n t ht
    exact sheaf_seq_kill_of_finite_refinement (Scheme.ProEt.topology S) I K (fun R' hR' => by
        obtain ⟨k', V, f, h1, -, h3⟩ := proet_qcqs_finite_affine_refinement S K R' hR'
        exact ⟨k', V, f, h1, h3⟩) n t R hR hRk

  have surjK : ∀ (K : S.ProEt), CompactSpace K.left → QuasiSeparatedSpace K.left →
      ∀ s : c.pt.obj.obj (Opposite.op K), ∃ (n : ℕ) (t : (I.obj n).obj.obj (Opposite.op K)),
        (c.ι.app n).hom.app (Opposite.op K) t = s := by
    intro K hK1 hK2 s
    haveI := hK1
    haveI := hK2
    obtain ⟨R, hR, hl⟩ :=
      sheaf_seq_colimit_section_locally_lifts (Scheme.ProEt.topology S) I c hc K s
    obtain ⟨k', V, f, hRf, hVa, hcov⟩ := proet_qcqs_finite_affine_refinement S K R hR
    refine sheaf_seq_glue_finite_cover (Scheme.ProEt.topology S) I c K k' V f hcov ?_ s
      (fun j => hl (V j) (f j) (hRf j))
    intro i j n t ht
    obtain ⟨h1, h2⟩ := pbgood K (V i) (V j) (f i) (f j) hK2 (hVa i) (hVa j)
    exact injK _ h1 h2 n t ht

  have hW : ∀ {i j : ℕ} (g : i ⟶ j) (Z : S.ProEt) (x : (I.obj i).obj.obj (Opposite.op Z)),
      ((c.ι.app j).hom.app (Opposite.op Z)).hom (((I.map g).hom.app (Opposite.op Z)).hom x) =
        ((c.ι.app i).hom.app (Opposite.op Z)).hom x := by
    intro i j g Z x
    exact congrArg (fun m => (m.hom.app (Opposite.op Z)).hom x) (c.w g)
  have hcomp : ∀ {i j l : ℕ} (g : i ⟶ j) (g' : j ⟶ l) (Z : S.ProEt)
      (x : (I.obj i).obj.obj (Opposite.op Z)),
      ((I.map (g ≫ g')).hom.app (Opposite.op Z)).hom x =
        ((I.map g').hom.app (Opposite.op Z)).hom (((I.map g).hom.app (Opposite.op Z)).hom x) := by
    intro i j l g g' Z x
    exact congrArg (fun m => (m.hom.app (Opposite.op Z)).hom x) (I.map_comp g g')

  have s1 : ∀ (R : Type) [Finite R] (Z : R → S.ProEt),
      (∀ (r : R) (s : c.pt.obj.obj (Opposite.op (Z r))), ∃ (i : ℕ)
        (t : (I.obj i).obj.obj (Opposite.op (Z r))),
        ((c.ι.app i).hom.app (Opposite.op (Z r))).hom t = s) →
      ∀ (s : ∀ r, c.pt.obj.obj (Opposite.op (Z r))), ∃ (i : ℕ)
        (t : ∀ r, (I.obj i).obj.obj (Opposite.op (Z r))),
        ∀ r, ((c.ι.app i).hom.app (Opposite.op (Z r))).hom (t r) = s r := by
    intro R _ Z h s
    choose i₀ t₀ ht₀ using fun r => h r (s r)
    haveI := Fintype.ofFinite R
    classical
    obtain ⟨N, hN⟩ := IsFiltered.sup_objs_exists (Finset.univ.image i₀)
    have g : ∀ r, i₀ r ⟶ N := fun r => (hN (Finset.mem_image_of_mem i₀ (Finset.mem_univ r))).some
    exact ⟨N, fun r => ((I.map (g r)).hom.app _).hom (t₀ r), fun r =>
      (hW (g r) (Z r) (t₀ r)).trans (ht₀ r)⟩

  have s2 : ∀ (R : Type) [Finite R] (Z : R → S.ProEt),
      (∀ (r : R) (i : ℕ) (t : (I.obj i).obj.obj (Opposite.op (Z r))),
        ((c.ι.app i).hom.app (Opposite.op (Z r))).hom t = 0 →
        ∃ (j : ℕ) (f : i ⟶ j), ((I.map f).hom.app (Opposite.op (Z r))).hom t = 0) →
      ∀ (i : ℕ) (x : ∀ r, (I.obj i).obj.obj (Opposite.op (Z r))),
        (∀ r, ((c.ι.app i).hom.app (Opposite.op (Z r))).hom (x r) = 0) →
        ∃ (j : ℕ) (φ : i ⟶ j), ∀ r, ((I.map φ).hom.app (Opposite.op (Z r))).hom (x r) = 0 := by
    intro R _ Z h
    haveI := Fintype.ofFinite R
    classical
    have key : ∀ T : Finset R, ∀ (i : ℕ) (x : ∀ r, (I.obj i).obj.obj (Opposite.op (Z r))),
        (∀ r, ((c.ι.app i).hom.app (Opposite.op (Z r))).hom (x r) = 0) →
        ∃ (j : ℕ) (φ : i ⟶ j), ∀ r ∈ T, ((I.map φ).hom.app (Opposite.op (Z r))).hom (x r) = 0 := by
      intro T
      induction T using Finset.induction_on with
      | empty =>
        intro i x _
        exact ⟨i, 𝟙 i, fun r hr => by simp at hr⟩
      | insert a T' haT ih =>
        intro i x hx
        obtain ⟨j₁, f₁, hf₁⟩ := h a i (x a) (hx a)
        obtain ⟨j, φ', hφ'⟩ := ih j₁ (fun r => ((I.map f₁).hom.app _).hom (x r))
          (fun r => (hW f₁ (Z r) (x r)).trans (hx r))
        refine ⟨j, f₁ ≫ φ', fun r hr => ?_⟩
        rw [hcomp]
        rcases Finset.mem_insert.mp hr with hra | hr'
        · subst hra
          rw [hf₁, map_zero]
        · exact hφ' r hr'
    intro i x hx
    obtain ⟨j, φ, hφ⟩ := key Finset.univ i x hx
    exact ⟨j, φ, fun r => hφ r (Finset.mem_univ r)⟩

  have hcech : ∀ (K : S.ProEt) (k' : ℕ) (V : Fin k' → S.ProEt) (f : ∀ i, V i ⟶ K),
      CompactSpace K.left → QuasiSeparatedSpace K.left → (∀ i, IsAffine (V i).left) →
      wcCechAcyclic c.pt.obj V f := by
    intro K k' V f hU1 hU2 hV p cc hcc

    obtain ⟨i, t, ht⟩ := s1 (Fin (p + 2) → Fin k')
      (fun τ => Limits.widePullback K (fun l => V (τ l)) (fun l => f (τ l)))
      (fun τ s => surjK _ (wpgood K k' V f hU1 hU2 hV (p + 1) τ).1
        (wpgood K k' V f hU1 hU2 hV (p + 1) τ).2 s) cc

    have hx0 : ∀ ρ : Fin (p + 3) → Fin k',
        ((c.ι.app i).hom.app
          (Opposite.op (Limits.widePullback K (fun l => V (ρ l)) (fun l => f (ρ l))))).hom
          (∑ j : Fin (p + 3), ((-1 : ℤ) ^ (j : ℕ)) •
            (I.obj i).obj.map (wcCechFace V f ρ j).op (t (fun l => ρ (j.succAbove l)))) = 0 := by
      intro ρ
      refine Eq.trans ?_ (hcc ρ)
      rw [map_sum]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [map_zsmul]
      congr 1
      rw [← ht (fun l => ρ (j.succAbove l))]
      exact NatTrans.naturality_apply (c.ι.app i).hom (wcCechFace V f ρ j).op _

    obtain ⟨j, φ, hφ⟩ := s2 (Fin (p + 3) → Fin k')
      (fun ρ => Limits.widePullback K (fun l => V (ρ l)) (fun l => f (ρ l)))
      (fun ρ i t ht => by
        obtain ⟨m, hnm, hm⟩ := injK _ (wpgood K k' V f hU1 hU2 hV (p + 2) ρ).1
          (wpgood K k' V f hU1 hU2 hV (p + 2) ρ).2 i t ht
        exact ⟨m, homOfLE hnm, hm⟩)
      i (fun ρ => ∑ j : Fin (p + 3), ((-1 : ℤ) ^ (j : ℕ)) •
            (I.obj i).obj.map (wcCechFace V f ρ j).op (t (fun l => ρ (j.succAbove l)))) hx0

    haveI := hI j
    obtain ⟨b', hb'⟩ :=
      (wc_injective_cech_acyclic (Scheme.ProEt.topology S) (I.obj j) V f).2 p
      (fun τ => ((I.map φ).hom.app _).hom (t τ)) (by
        intro ρ
        have hφρ := hφ ρ
        beta_reduce at hφρ ⊢
        refine Eq.trans ?_ hφρ
        rw [map_sum]
        refine Finset.sum_congr rfl (fun l _ => ?_)
        rw [map_zsmul]
        congr 1
        exact (NatTrans.naturality_apply (I.map φ).hom (wcCechFace V f ρ l).op _).symm)

    refine ⟨fun σ => ((c.ι.app j).hom.app _).hom (b' σ), fun τ => ?_⟩
    have e1 := hb' τ
    beta_reduce at e1 ⊢
    refine Eq.trans ?_ ((congrArg (fun z => ((c.ι.app j).hom.app
      (Opposite.op (Limits.widePullback K (fun l => V (τ l)) (fun l => f (τ l))))).hom z) e1).trans
      ((hW φ _ (t τ)).trans (ht τ)))
    beta_reduce
    rw [map_sum]
    refine Finset.sum_congr rfl (fun l _ => ?_)
    rw [map_zsmul]
    congr 1
    exact (NatTrans.naturality_apply (c.ι.app j).hom (wcCechFace V f τ l).op _).symm

  exact wc_cech_criterion_ext_vanishing S
    (fun K => CompactSpace K.left ∧ QuasiSeparatedSpace K.left)
    (fun K k' V f => (CompactSpace K.left ∧ QuasiSeparatedSpace K.left) ∧
      (∀ i, IsAffine (V i).left) ∧
      Sieve.generate (Presieve.ofArrows V f) ∈ Scheme.ProEt.topology S K)
    (fun _ _ _ _ hcv => hcv.2.2)
    (fun K k' V f hcv p σ => wpgood K k' V f hcv.1.1 hcv.1.2 hcv.2.1 p σ)
    (fun K hK R hR => by
      haveI := hK.1
      haveI := hK.2
      obtain ⟨k', V, f, hRf, hVa, hcov⟩ := proet_qcqs_finite_affine_refinement S K R hR
      exact ⟨k', V, f, ⟨hK, hVa, hcov⟩, hRf⟩)
    (fun I' _ K k' V f _ => (wc_injective_cech_acyclic (Scheme.ProEt.topology S) I' V f).2)
    c.pt (fun K k' V f hcv => hcech K k' V f hcv.1.1 hcv.1.2 hcv.2.1)
    U ⟨inferInstance, inferInstance⟩ k x

theorem wc_ladic_coh_bounded_denominators (F : Type u) [Finite F] [Field F]
    (X : Over (Spec (.of F)))
    [GeometricallyIrreducible X.hom] [IsProper X.hom] (d : ℕ) [SmoothOfRelativeDimension d X.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F)
    (h : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))) :
    ∀ (i : ℕ) (x : wcCoh F X h ℓ i), ∃ (n : ℕ)
      (y : Abelian.Ext (wcFreeSheaf X.left (wcGeomPoint F X h)) (wcIntSheaf X.left ℓ) i),
      wcCohScalar F X h ℓ i ((ℓ : ℚ_[ℓ]) ^ n) x =
        y.comp (Abelian.Ext.mk₀ (wcIntToLadic X.left ℓ)) (add_zero i) :=
by
  intro i x
  classical

  haveI hex : HasExactColimitsOfShape ℕ
      (Sheaf (Scheme.ProEt.topology X.left) AddCommGrpCat.{u+1}) :=
    @Sheaf.hasExactColimitsOfShape _ AddCommGrpCat.{u+1} ℕ _ _ _ (Scheme.ProEt.topology X.left) _ _ _
      (@HasExactColimitsOfShape.of_domain_equivalence AddCommGrpCat.{u+1} _ _ _ _ _
        (ULiftHomULiftCategory.equiv.{u+1, u+1} ℕ).symm _ (AB5OfSize.ofShape _))

  haveI : IsProper (Limits.pullback.snd X.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))) := inferInstance
  have hqc : QuasiCompact (Limits.pullback.snd X.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))) := inferInstance
  have hqs : QuasiSeparated (Limits.pullback.snd X.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))) := inferInstance
  haveI : CompactSpace (wcGeomPoint F X h).left := by
    exact @QuasiCompact.compactSpace_of_compactSpace _ _ (Limits.pullback.snd X.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))) hqc _
  haveI : QuasiSeparatedSpace (wcGeomPoint F X h).left := by
    exact @quasiSeparatedSpace_of_quasiSeparated _ _ (Limits.pullback.snd X.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))) _ hqs

  obtain ⟨κ, ⟨hκ⟩, hκapp⟩ := wc_ladic_tower_colimit X.left ℓ

  have H0 : ∀ (G : ℕ ⥤ Sheaf (Scheme.ProEt.topology X.left) AddCommGrpCat.{u+1})
      (c : Limits.Cocone G), Limits.IsColimit c →
      ∀ g : wcFreeSheaf X.left (wcGeomPoint F X h) ⟶ c.pt, ∃ (n : ℕ)
        (g' : wcFreeSheaf X.left (wcGeomPoint F X h) ⟶ G.obj n), g = g' ≫ c.ι.app n :=
    fun G c hc => (proet_free_hom_seq_colimit X.left (wcGeomPoint F X h) G c hc).1
  have H1 : ∀ G : ℕ ⥤ Sheaf (Scheme.ProEt.topology X.left) AddCommGrpCat.{u+1},
      ∃ (I : ℕ ⥤ Sheaf (Scheme.ProEt.topology X.left) AddCommGrpCat.{u+1}) (α : G ⟶ I),
        Mono α ∧ ∀ (c : Limits.Cocone I), Limits.IsColimit c → ∀ (k : ℕ)
          (x : Abelian.Ext (wcFreeSheaf X.left (wcGeomPoint F X h)) c.pt (k + 1)), x = 0 := by
    intro G
    obtain ⟨I, α, hα, hI⟩ := injective_tower_of_tower G
    exact ⟨I, α, hα, fun c hc k x =>
      proet_ext_colimit_injectives_vanish X.left (wcGeomPoint F X h) I hI c hc k x⟩

  obtain ⟨n, y, hy⟩ := ext_seq_colimit_lift_of_acyclic
    (wcFreeSheaf X.left (wcGeomPoint F X h)) H0 H1 i _ (Limits.Cocone.mk _ κ) hκ x
  refine ⟨n, y, ?_⟩
  have hl : (ℓ : ℚ_[ℓ]) ^ n ≠ 0 :=
    pow_ne_zero _ (Nat.cast_ne_zero.mpr (Fact.out : Nat.Prime ℓ).ne_zero)
  let y' : Abelian.Ext (wcFreeSheaf X.left (wcGeomPoint F X h)) (wcIntSheaf X.left ℓ) i := y
  have hy' : x = y'.comp (Abelian.Ext.mk₀ (wcIntToLadic X.left ℓ ≫
      wcLadicScalar X.left ℓ (((ℓ : ℚ_[ℓ]) ^ n)⁻¹))) (add_zero i) := by
    rw [hy]
    exact congrArg (fun f => y.comp (Abelian.Ext.mk₀ f) (add_zero i)) (hκapp n)
  change x.comp (Abelian.Ext.mk₀ (wcLadicScalar X.left ℓ ((ℓ : ℚ_[ℓ]) ^ n))) (add_zero i) =
    y'.comp (Abelian.Ext.mk₀ (wcIntToLadic X.left ℓ)) (add_zero i)
  have hσ1 : wcLadicScalar X.left ℓ 1 = 𝟙 _ := (wc_ladic_scalar_ring X.left ℓ).1
  have hσmul : wcLadicScalar X.left ℓ (((ℓ : ℚ_[ℓ]) ^ n) * ((ℓ : ℚ_[ℓ]) ^ n)⁻¹) =
      wcLadicScalar X.left ℓ (((ℓ : ℚ_[ℓ]) ^ n)⁻¹) ≫ wcLadicScalar X.left ℓ ((ℓ : ℚ_[ℓ]) ^ n) :=
    (wc_ladic_scalar_ring X.left ℓ).2.1 _ _
  rw [hy', Abelian.Ext.comp_assoc _ _ _ (add_zero i) (add_zero 0) (by omega),
    Abelian.Ext.mk₀_comp_mk₀, Category.assoc, ← hσmul, mul_inv_cancel₀ hl, hσ1, Category.comp_id]

theorem padic_fg_of_mod_ell_reps : ∀ (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (M : Type*) [AddCommGroup M]
    [Module ℤ_[ℓ] M],
    (∃ T : Finset M, ∀ m : M, ∃ t ∈ T, ∃ m' : M, m = t + (ℓ : ℤ_[ℓ]) • m') →
    (∀ w : ℕ → M, (∀ n, w n = (ℓ : ℤ_[ℓ]) • w (n + 1)) → w 0 = 0) →
    Module.Finite ℤ_[ℓ] M :=
by
  classical
  intro ℓ _ M _ _ hT hD
  obtain ⟨T, hT⟩ := hT

  have hℓ1 : (1 : ℝ) < (ℓ : ℝ) := by exact_mod_cast (Fact.out : Nat.Prime ℓ).one_lt
  have hsum : ∀ c : ℕ → ℤ_[ℓ], Summable (fun j => (ℓ : ℤ_[ℓ]) ^ j * c j) := by
    intro c
    refine Summable.of_norm_bounded (g := fun j : ℕ => ((ℓ : ℝ)⁻¹) ^ j)
      (summable_geometric_of_lt_one (by positivity) (inv_lt_one_of_one_lt₀ hℓ1)) ?_
    intro j
    calc ‖(ℓ : ℤ_[ℓ]) ^ j * c j‖ ≤ ‖(ℓ : ℤ_[ℓ]) ^ j‖ * ‖c j‖ := norm_mul_le _ _
      _ ≤ ‖(ℓ : ℤ_[ℓ]) ^ j‖ * 1 :=
          mul_le_mul_of_nonneg_left (PadicInt.norm_le_one _) (norm_nonneg _)
      _ = ((ℓ : ℝ)⁻¹) ^ j := by rw [mul_one, norm_pow, PadicInt.norm_p]
  obtain ⟨A, hA⟩ : ∃ A : (ℕ → ℤ_[ℓ]) → ℤ_[ℓ], ∀ c : ℕ → ℤ_[ℓ],
      A c = c 0 + (ℓ : ℤ_[ℓ]) * A (fun j => c (j + 1)) := by
    refine ⟨fun c => ∑' j, (ℓ : ℤ_[ℓ]) ^ j * c j, fun c => ?_⟩
    show ∑' j, (ℓ : ℤ_[ℓ]) ^ j * c j = c 0 + (ℓ : ℤ_[ℓ]) * ∑' j, (ℓ : ℤ_[ℓ]) ^ j * c (j + 1)
    rw [(hsum c).tsum_eq_zero_add, pow_zero, one_mul,
      ← (hsum (fun j => c (j + 1))).tsum_mul_left]
    congr 1
    apply tsum_congr
    intro j
    ring

  choose dig hdigT nxt hnxt using hT
  rw [Module.finite_def]
  refine ⟨T, ?_⟩
  rw [eq_top_iff]
  intro m _
  obtain ⟨μ, hμ0, hμ⟩ : ∃ μ : ℕ → M, μ 0 = m ∧ ∀ n, μ (n + 1) = nxt (μ n) :=
    ⟨fun n => nxt^[n] m, rfl, fun n => Function.iterate_succ_apply' nxt n m⟩
  obtain ⟨κ, hκ⟩ : ∃ κ : ℕ → M → ℤ_[ℓ], ∀ n s,
      κ n s = (if dig (μ n) = s then (1 : ℤ_[ℓ]) else 0) + (ℓ : ℤ_[ℓ]) * κ (n + 1) s := by
    refine ⟨fun n s => A (fun j => if dig (μ (n + j)) = s then (1 : ℤ_[ℓ]) else 0),
      fun n s => ?_⟩
    have h1 := hA (fun j => if dig (μ (n + j)) = s then (1 : ℤ_[ℓ]) else 0)
    have e : (fun j => if dig (μ (n + (j + 1))) = s then (1 : ℤ_[ℓ]) else 0) =
        (fun j => if dig (μ (n + 1 + j)) = s then (1 : ℤ_[ℓ]) else 0) := by
      funext j
      rw [show n + (j + 1) = n + 1 + j by omega]
    beta_reduce at h1
    rw [add_zero, e] at h1
    exact h1
  have hsplit : ∀ n, ∑ s ∈ T, κ n s • s =
      dig (μ n) + (ℓ : ℤ_[ℓ]) • ∑ s ∈ T, κ (n + 1) s • s := by
    intro n
    have h3 : ∑ s ∈ T, (if dig (μ n) = s then (1 : ℤ_[ℓ]) else 0) • s = dig (μ n) := by
      simp only [ite_smul, one_smul, zero_smul]
      rw [Finset.sum_ite_eq, if_pos (hdigT (μ n))]
    rw [Finset.sum_congr rfl (fun s _ => by rw [hκ n s]), Finset.smul_sum]
    simp only [add_smul, mul_smul, Finset.sum_add_distrib, h3]
  have hw : ∀ n, μ n - ∑ s ∈ T, κ n s • s =
      (ℓ : ℤ_[ℓ]) • (μ (n + 1) - ∑ s ∈ T, κ (n + 1) s • s) := by
    intro n
    have h2 : μ n = dig (μ n) + (ℓ : ℤ_[ℓ]) • μ (n + 1) := by rw [hμ n]; exact hnxt (μ n)
    rw [hsplit n, smul_sub]
    generalize dig (μ n) = d at h2 ⊢
    rw [h2]
    abel
  have h0 : μ 0 - ∑ s ∈ T, κ 0 s • s = 0 := hD (fun n => μ n - ∑ s ∈ T, κ n s • s) hw
  rw [hμ0, sub_eq_zero] at h0
  rw [h0]
  exact Submodule.sum_smul_mem _ _ (fun s hs => Submodule.subset_span hs)

theorem wc_coh_finite (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    [GeometricallyIrreducible X.hom] [IsProper X.hom] (d : ℕ) [SmoothOfRelativeDimension d X.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F)
    (h : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))) :
    ∀ i : ℕ, ∃ (r : ℕ) (e : wcCoh F X h ℓ i ≃+ (Fin r → ℚ_[ℓ])),
      ∀ (c : ℚ_[ℓ]) (x : wcCoh F X h ℓ i), e (wcCohScalar F X h ℓ i c x) = c • e x :=
by
  classical
  intro i

  have s4 : ∀ (R : Type) [Ring R] (G : Sheaf (Scheme.ProEt.topology X.left) AddCommGrpCat.{u+1})
      (s : R → (G ⟶ G)), s 1 = 𝟙 G → (∀ a b, s (a * b) = s b ≫ s a) →
      (∀ a b, s (a + b) = s a + s b) →
      (∀ x : Abelian.Ext (wcFreeSheaf X.left (wcGeomPoint F X h)) G i,
          x.comp (Abelian.Ext.mk₀ (s 1)) (add_zero i) = x) ∧
      (∀ a b (x : Abelian.Ext (wcFreeSheaf X.left (wcGeomPoint F X h)) G i),
          x.comp (Abelian.Ext.mk₀ (s (a * b))) (add_zero i) =
          (x.comp (Abelian.Ext.mk₀ (s b)) (add_zero i)).comp (Abelian.Ext.mk₀ (s a)) (add_zero i)) ∧
      (∀ a b (x : Abelian.Ext (wcFreeSheaf X.left (wcGeomPoint F X h)) G i),
          x.comp (Abelian.Ext.mk₀ (s (a + b))) (add_zero i) =
          x.comp (Abelian.Ext.mk₀ (s a)) (add_zero i) + x.comp (Abelian.Ext.mk₀ (s b)) (add_zero i)) := by
    intro R _ G s h1 hmul hadd
    refine ⟨fun x => ?_, fun a b x => ?_, fun a b x => ?_⟩
    · rw [h1, Abelian.Ext.comp_mk₀_id]
    · rw [hmul, ← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.comp_assoc _ _ _ (add_zero i) (add_zero 0)
        (by omega)]
    · rw [hadd, Abelian.Ext.mk₀_add, Abelian.Ext.comp_add]
  obtain ⟨hs1, hsmul, hsadd, hscomm⟩ := wc_int_scalar_ring X.left ℓ
  obtain ⟨hq1, hqmul, hqadd⟩ := wc_ladic_scalar_ring X.left ℓ

  let M := Abelian.Ext (wcFreeSheaf X.left (wcGeomPoint F X h)) (wcIntSheaf X.left ℓ) i
  letI smulM : SMul ℤ_[ℓ] M :=
    ⟨fun a m => m.comp (Abelian.Ext.mk₀ (wcIntScalar X.left ℓ a)) (add_zero i)⟩
  obtain ⟨A1, Amul, Aadd⟩ := s4 ℤ_[ℓ] (wcIntSheaf X.left ℓ) (wcIntScalar X.left ℓ) hs1 hsmul hsadd
  letI modM : Module ℤ_[ℓ] M := Module.ofMinimalAxioms
    (fun a x y => Abelian.Ext.add_comp x y _ _)
    (fun a b x => Aadd a b x)
    (fun a b x => Amul a b x)
    (fun x => A1 x)

  let V := wcCoh F X h ℓ i
  letI smulV : SMul ℚ_[ℓ] V := ⟨fun c x => wcCohScalar F X h ℓ i c x⟩
  obtain ⟨B1, Bmul, Badd⟩ := s4 ℚ_[ℓ] (wcLadicSheaf X.left ℓ) (wcLadicScalar X.left ℓ) hq1 hqmul hqadd
  letI modV : Module ℚ_[ℓ] V := Module.ofMinimalAxioms
    (fun a x y => map_add (wcCohScalar F X h ℓ i a) x y)
    (fun a b x => Badd a b x)
    (fun a b x => Bmul a b x)
    (fun x => B1 x)

  haveI hmono : Mono (wcIntScalar X.left ℓ (ℓ : ℤ_[ℓ])) := wc_int_scalar_ell_mono X.left ℓ
  haveI hfin := wc_coh_mod_ell_finite F X d ℓ hℓ h i
  have hT : ∃ T : Finset M, ∀ m : M, ∃ t ∈ T, ∃ m' : M, m = t + (ℓ : ℤ_[ℓ]) • m' := by
    let f := wcIntScalar X.left ℓ (ℓ : ℤ_[ℓ])
    let S : ShortComplex (Sheaf (Scheme.ProEt.topology X.left) AddCommGrpCat.{u+1}) :=
      ShortComplex.mk f (Limits.cokernel.π f) (Limits.cokernel.condition f)
    have hS : S.ShortExact :=
      ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel f) hmono inferInstance
    let β : M → Abelian.Ext (wcFreeSheaf X.left (wcGeomPoint F X h)) (Limits.cokernel f) i :=
      fun m => m.comp (Abelian.Ext.mk₀ (Limits.cokernel.π f)) (add_zero i)
    have hfr : (Set.range β).Finite := Set.toFinite _
    let pre : Abelian.Ext (wcFreeSheaf X.left (wcGeomPoint F X h)) (Limits.cokernel f) i → M :=
      fun y => if hy : ∃ m, β m = y then hy.choose else 0
    refine ⟨hfr.toFinset.image pre, fun m => ?_⟩
    refine ⟨pre (β m), Finset.mem_image_of_mem _ (hfr.mem_toFinset.mpr ⟨m, rfl⟩), ?_⟩
    have hpre : β (pre (β m)) = β m := by
      have hy : ∃ m', β m' = β m := ⟨m, rfl⟩
      simp only [pre, dif_pos hy]
      exact hy.choose_spec
    have hsub := map_sub ((Abelian.Ext.mk₀ (Limits.cokernel.π f)).postcomp
      (wcFreeSheaf X.left (wcGeomPoint F X h)) (add_zero i)) m (pre (β m))
    have h0 : (m - pre (β m)).comp (Abelian.Ext.mk₀ S.g) (add_zero i) = 0 := by
      change ((Abelian.Ext.mk₀ (Limits.cokernel.π f)).postcomp
        (wcFreeSheaf X.left (wcGeomPoint F X h)) (add_zero i)) (m - pre (β m)) = 0
      rw [hsub]
      exact sub_eq_zero.mpr hpre.symm
    obtain ⟨m', hm'⟩ := Abelian.Ext.covariant_sequence_exact₂ _ hS (m - pre (β m)) h0
    refine ⟨m', ?_⟩
    change m = pre (β m) + m'.comp (Abelian.Ext.mk₀ S.f) (add_zero i)
    rw [hm']
    abel

  have hD : ∀ w : ℕ → M, (∀ n, w n = (ℓ : ℤ_[ℓ]) • w (n + 1)) → w 0 = 0 := by
    intro w hw
    have hpow : ∀ n : ℕ, w 0 = ((ℓ : ℤ_[ℓ]) ^ n) • w n := by
      intro n
      induction n with
      | zero => rw [pow_zero, one_smul]
      | succ n ih => rw [ih, hw n, ← mul_smul, ← pow_succ]
    apply wc_int_coh_separated F X d ℓ hℓ h i (w 0)
    intro n
    rw [hpow n]
    change ((w n).comp (Abelian.Ext.mk₀ (wcIntScalar X.left ℓ ((ℓ : ℤ_[ℓ]) ^ n))) (add_zero i)).comp
      (Abelian.Ext.mk₀ (Limits.cokernel.π (wcIntScalar X.left ℓ ((ℓ : ℤ_[ℓ]) ^ n)))) (add_zero i) = 0
    rw [Abelian.Ext.comp_assoc _ _ _ (add_zero i) (add_zero 0) (by omega),
      Abelian.Ext.mk₀_comp_mk₀, Limits.cokernel.condition, Abelian.Ext.mk₀_zero,
      Abelian.Ext.comp_zero]

  haveI hMfin : Module.Finite ℤ_[ℓ] M := padic_fg_of_mod_ell_reps ℓ M hT hD

  let φ : M →+ V := (Abelian.Ext.mk₀ (wcIntToLadic X.left ℓ)).postcomp
    (wcFreeSheaf X.left (wcGeomPoint F X h)) (add_zero i)
  have hφ : ∀ (a : ℤ_[ℓ]) (m : M), φ (a • m) = (a : ℚ_[ℓ]) • φ m := by
    intro a m
    change ((m.comp (Abelian.Ext.mk₀ (wcIntScalar X.left ℓ a)) (add_zero i)).comp
        (Abelian.Ext.mk₀ (wcIntToLadic X.left ℓ)) (add_zero i)) =
      (m.comp (Abelian.Ext.mk₀ (wcIntToLadic X.left ℓ)) (add_zero i)).comp
        (Abelian.Ext.mk₀ (wcLadicScalar X.left ℓ (a : ℚ_[ℓ]))) (add_zero i)
    rw [Abelian.Ext.comp_assoc _ _ _ (add_zero i) (add_zero 0) (by omega),
      Abelian.Ext.comp_assoc _ _ _ (add_zero i) (add_zero 0) (by omega),
      Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_comp_mk₀, hscomm]
  have hV : Module.Finite ℚ_[ℓ] V := by
    obtain ⟨G, hG⟩ := Module.finite_def.mp hMfin
    refine Module.finite_def.mpr ⟨G.image φ, ?_⟩
    rw [eq_top_iff]
    intro v _
    obtain ⟨n, y, hy⟩ := wc_ladic_coh_bounded_denominators F X d ℓ hℓ h i v
    have hy' : (ℓ : ℚ_[ℓ]) ^ n • v = φ y := hy
    have hspan : ∀ z : M, φ z ∈ Submodule.span ℚ_[ℓ] (↑(G.image φ) : Set V) := by
      intro z
      have hzG : z ∈ Submodule.span ℤ_[ℓ] (↑G : Set M) := by rw [hG]; trivial
      induction hzG using Submodule.span_induction with
      | mem x hx => exact Submodule.subset_span (Finset.mem_coe.mpr (Finset.mem_image_of_mem φ hx))
      | zero => rw [map_zero]; exact Submodule.zero_mem _
      | add x z _ _ hx hz => rw [map_add]; exact Submodule.add_mem _ hx hz
      | smul a x _ hx => rw [hφ]; exact Submodule.smul_mem _ _ hx
    have hmem : φ y ∈ Submodule.span ℚ_[ℓ] (↑(G.image φ) : Set V) := hspan y
    have hl : (ℓ : ℚ_[ℓ]) ^ n ≠ 0 :=
      pow_ne_zero _ (Nat.cast_ne_zero.mpr (Fact.out : Nat.Prime ℓ).ne_zero)
    rw [← inv_smul_smul₀ hl v, hy']
    exact Submodule.smul_mem _ _ hmem

  haveI := hV
  refine ⟨Module.finrank ℚ_[ℓ] V, (Module.finBasis ℚ_[ℓ] V).equivFun.toAddEquiv, fun c x => ?_⟩
  exact (Module.finBasis ℚ_[ℓ] V).equivFun.map_smul c x

theorem wc_ext_free_slice_cont : ∀ (S : Scheme.{u}) (U : S.ProEt) (A : Type) [AddCommGroup A] [TopologicalSpace A] [IsTopologicalAddGroup A] (i : ℕ), Nonempty (Abelian.Ext (wcFreeSheaf S U) (wcContSheaf S A) i ≃ Abelian.Ext (wcFreeSheaf U.left (Scheme.ProEt.mk (𝟙 U.left))) (wcContSheaf U.left A) i) :=
by

  have wc_proet_mem_topology_iff : ∀ (S : Scheme.{u}) (X : S.ProEt) (R : Sieve X),
      R ∈ Scheme.ProEt.topology S X ↔
        Sieve.functorPushforward (Scheme.ProEt.forget S ⋙ Over.forget S) R ∈
          Scheme.proetaleTopology X.left := by
    intro S X R
    letI := MorphismProperty.IsMultiplicative.toIsStableUnderComposition (W := @WeaklyEtale)
    have h : Scheme.ProEt.topology S =
        (Scheme.ProEt.forget S).restrictedTopology (Scheme.proetaleTopology.over S) :=
      MorphismProperty.toGrothendieck_comap_forget_eq_restrictedTopology (S := S)
        (P := @WeaklyEtale) Scheme.proetalePrecoverage
        Scheme.proetalePrecoverage_le_precoverage_weaklyEtale
    rw [h, Functor.mem_restrictedTopology_iff, GrothendieckTopology.mem_over_iff,
      Sieve.overEquiv_apply, ← Sieve.functorPushforward_comp]
    rfl

  have wc_slice_pushforward_functorPullback : ∀ (S : Scheme.{u}) (U : S.ProEt)
      (V : U.left.ProEt) (T : Sieve ((wcSliceFunctor S U).obj V)),
      Sieve.functorPushforward (Scheme.ProEt.forget U.left ⋙ Over.forget U.left)
          (Sieve.functorPullback (wcSliceFunctor S U) T) =
        Sieve.functorPushforward (Scheme.ProEt.forget S ⋙ Over.forget S) T := by
    intro S U V T
    ext Z g
    constructor
    · rintro ⟨W, t', h, ht', rfl⟩
      exact ⟨(wcSliceFunctor S U).obj W, (wcSliceFunctor S U).map t', h, ht', rfl⟩
    · rintro ⟨W', t, h, ht, rfl⟩
      have hw : (t.left ≫ V.hom) ≫ U.hom = W'.hom :=
        (Category.assoc _ _ _).trans (MorphismProperty.Over.w t)
      haveI : WeaklyEtale ((t.left ≫ V.hom) ≫ U.hom) := hw ▸ W'.prop
      haveI : WeaklyEtale (t.left ≫ V.hom) := WeaklyEtale.of_comp _ U.hom
      let W'' : U.left.ProEt := Scheme.ProEt.mk (t.left ≫ V.hom)
      let t'' : W'' ⟶ V := MorphismProperty.Over.homMk t.left rfl trivial
      let e : (wcSliceFunctor S U).obj W'' ⟶ W' :=
        MorphismProperty.Over.homMk (𝟙 _) ((Category.id_comp _).trans hw.symm) trivial
      have he : (wcSliceFunctor S U).map t'' = e ≫ t := by
        apply MorphismProperty.Over.Hom.ext
        exact (Category.id_comp _).symm
      refine ⟨W'', t'', h, ?_, rfl⟩
      show T.arrows ((wcSliceFunctor S U).map t'')
      rw [he]
      exact T.downward_closed ht e

  have wc_slice_compatiblePreserving : ∀ (S : Scheme.{u}) (U : S.ProEt),
      CompatiblePreserving.{u+1} (Scheme.ProEt.topology S) (wcSliceFunctor S U) := by
    intro S U
    apply CompatiblePreserving.mk
    intro ℱ Z T x hx Y₁ Y₂ X f₁ f₂ g₁ g₂ hg₁ hg₂ hfg
    have hw : (f₁.left ≫ Y₁.hom) ≫ U.hom = X.hom :=
      (Category.assoc _ _ _).trans (MorphismProperty.Over.w f₁)
    haveI : WeaklyEtale ((f₁.left ≫ Y₁.hom) ≫ U.hom) := hw ▸ X.prop
    haveI : WeaklyEtale (f₁.left ≫ Y₁.hom) := WeaklyEtale.of_comp _ U.hom
    let X' : U.left.ProEt := Scheme.ProEt.mk (f₁.left ≫ Y₁.hom)
    have hleft : f₁.left ≫ g₁.left = f₂.left ≫ g₂.left :=
      congrArg (fun k => k.left) hfg
    have h2 : f₂.left ≫ Y₂.hom = f₁.left ≫ Y₁.hom := by
      have e1 : Y₁.hom = g₁.left ≫ Z.hom := (MorphismProperty.Over.w g₁).symm
      have e2 : Y₂.hom = g₂.left ≫ Z.hom := (MorphismProperty.Over.w g₂).symm
      calc f₂.left ≫ Y₂.hom = (f₂.left ≫ g₂.left) ≫ Z.hom :=
            (congrArg (f₂.left ≫ ·) e2).trans (Category.assoc _ _ _).symm
        _ = (f₁.left ≫ g₁.left) ≫ Z.hom := congrArg (· ≫ Z.hom) hleft.symm
        _ = f₁.left ≫ Y₁.hom :=
            (Category.assoc _ _ _).trans (congrArg (f₁.left ≫ ·) e1.symm)
    let f₁' : X' ⟶ Y₁ := MorphismProperty.Over.homMk f₁.left rfl trivial
    let f₂' : X' ⟶ Y₂ := MorphismProperty.Over.homMk f₂.left h2 trivial
    let e : X ⟶ (wcSliceFunctor S U).obj X' :=
      MorphismProperty.Over.homMk (𝟙 _) ((Category.id_comp _).trans hw) trivial
    have hf₁ : f₁ = e ≫ (wcSliceFunctor S U).map f₁' := by
      apply MorphismProperty.Over.Hom.ext
      exact (Category.id_comp _).symm
    have hf₂ : f₂ = e ≫ (wcSliceFunctor S U).map f₂' := by
      apply MorphismProperty.Over.Hom.ext
      exact (Category.id_comp _).symm
    have hsq : f₁' ≫ g₁ = f₂' ≫ g₂ := by
      apply MorphismProperty.Over.Hom.ext
      exact hleft
    have hc := hx f₁' f₂' hg₁ hg₂ hsq
    rw [hf₁, hf₂]
    simp only [Functor.map_comp, op_comp]
    rw [ConcreteCategory.comp_apply, ConcreteCategory.comp_apply]
    exact congrArg _ hc

  have wc_slice_costructuredArrow_final : ∀ (S : Scheme.{u}) (U W : S.ProEt),
      ∃ (I : Type u)
        (D : Discrete I ⥤ CostructuredArrow (wcSliceFunctor S U).op (Opposite.op W)),
        D.Final := by
    intro S U W
    have hWf : ∀ f : W ⟶ U, WeaklyEtale f.left := fun f => by
      have h : f.left ≫ U.hom = W.hom := MorphismProperty.Over.w f
      haveI : WeaklyEtale (f.left ≫ U.hom) := h ▸ W.prop
      exact WeaklyEtale.of_comp f.left U.hom
    let Wf : (W ⟶ U) → U.left.ProEt := fun f => @Scheme.ProEt.mk _ _ f.left (hWf f)
    obtain ⟨ε, hε⟩ : ∃ ε : ∀ f : W ⟶ U, W ⟶ (wcSliceFunctor S U).obj (Wf f),
        ∀ f, (ε f).left = 𝟙 W.left := ⟨fun f =>
      MorphismProperty.Over.homMk (𝟙 _)
        ((Category.id_comp _).trans (MorphismProperty.Over.w f)) trivial, fun f => rfl⟩
    have hWfhom : ∀ f : W ⟶ U, (Wf f).hom = f.left := fun f => rfl
    obtain ⟨D, hD⟩ : ∃ D : Discrete (W ⟶ U) ⥤
        CostructuredArrow (wcSliceFunctor S U).op (Opposite.op W),
        ∀ f, D.obj ⟨f⟩ = CostructuredArrow.mk (Y := Opposite.op (Wf f)) (ε f).op :=
      ⟨Discrete.functor (fun f => CostructuredArrow.mk (Y := Opposite.op (Wf f)) (ε f).op),
        fun f => rfl⟩
    have key : ∀ (c : CostructuredArrow (wcSliceFunctor S U).op (Opposite.op W)) (f : W ⟶ U)
        (k : c.left ⟶ Opposite.op (Wf f))
        (hk : (wcSliceFunctor S U).op.map k ≫ (ε f).op = c.hom),
        (Quiver.Hom.unop k).left = (Quiver.Hom.unop c.hom).left ∧
          f.left = (Quiver.Hom.unop c.hom).left ≫ c.left.unop.hom := by
      intro c f k hk
      have h0 : ε f ≫ (wcSliceFunctor S U).map k.unop = c.hom.unop :=
        congrArg Quiver.Hom.unop hk
      have h1 : (ε f).left ≫ (Quiver.Hom.unop k).left = (Quiver.Hom.unop c.hom).left :=
        congrArg (fun k : W ⟶ (wcSliceFunctor S U).obj c.left.unop => k.left) h0
      have h1' : (Quiver.Hom.unop k).left = (Quiver.Hom.unop c.hom).left :=
        (Category.id_comp _).symm.trans
          ((congrArg (· ≫ (Quiver.Hom.unop k).left) (hε f)).symm.trans h1)
      refine ⟨h1', ?_⟩
      have hw : (Quiver.Hom.unop k).left ≫ c.left.unop.hom = (Wf f).hom :=
        MorphismProperty.Over.w (k.unop : Wf f ⟶ c.left.unop)
      exact (hWfhom f).symm.trans (hw.symm.trans (congrArg (· ≫ c.left.unop.hom) h1'))
    refine ⟨W ⟶ U, D, Functor.Final.mk (fun c => ?_)⟩
    have hext : ∀ (f : W ⟶ U) (h h' : c ⟶ D.obj ⟨f⟩), h = h' := by
      intro f h h'
      refine (cancel_mono (eqToHom (hD f))).1 ?_
      apply CostructuredArrow.hom_ext
      apply Quiver.Hom.unop_inj
      apply MorphismProperty.Over.Hom.ext
      exact (key c f (h ≫ eqToHom (hD f)).left (CostructuredArrow.w _)).1.trans
        (key c f (h' ≫ eqToHom (hD f)).left (CostructuredArrow.w _)).1.symm
    have ha : (Quiver.Hom.unop c.hom).left ≫ c.left.unop.hom ≫ U.hom = W.hom :=
      MorphismProperty.Over.w (Quiver.Hom.unop c.hom : W ⟶ (wcSliceFunctor S U).obj c.left.unop)
    obtain ⟨fc, hfc⟩ : ∃ fc : W ⟶ U,
        fc.left = (Quiver.Hom.unop c.hom).left ≫ c.left.unop.hom :=
      ⟨MorphismProperty.Over.homMk ((Quiver.Hom.unop c.hom).left ≫ c.left.unop.hom)
        ((Category.assoc _ _ _).trans ha) trivial, rfl⟩
    have hκ : (Quiver.Hom.unop c.hom).left ≫ c.left.unop.hom = (Wf fc).hom :=
      hfc.symm.trans (hWfhom fc).symm
    obtain ⟨κc, hκc⟩ : ∃ κc : Wf fc ⟶ c.left.unop,
        κc.left = (Quiver.Hom.unop c.hom).left :=
      ⟨MorphismProperty.Over.homMk (Quiver.Hom.unop c.hom).left hκ trivial, rfl⟩
    have hw : (wcSliceFunctor S U).op.map κc.op ≫ (ε fc).op = c.hom := by
      apply Quiver.Hom.unop_inj
      apply MorphismProperty.Over.Hom.ext
      exact ((congrArg (· ≫ κc.left) (hε fc)).trans (Category.id_comp _)).trans hκc
    let φc : c ⟶ D.obj ⟨fc⟩ :=
      CostructuredArrow.homMk (f := c)
        (f' := CostructuredArrow.mk (Y := Opposite.op (Wf fc)) (ε fc).op)
        κc.op hw ≫ eqToHom (hD fc).symm
    have hto : ∀ s : StructuredArrow c D, s.right.as = fc := by
      intro s
      apply MorphismProperty.Over.Hom.ext
      exact (key c s.right.as (s.hom ≫ eqToHom (hD s.right.as)).left
        (CostructuredArrow.w _)).2.trans hfc.symm
    let tc : StructuredArrow c D := StructuredArrow.mk (Y := ⟨fc⟩) φc
    exact isConnected_of_isTerminal _ (Limits.IsTerminal.ofUniqueHom (X := tc)
      (fun s => StructuredArrow.homMk (Discrete.eqToHom (hto s)) (hext _ _ _))
      (fun s m => StructuredArrow.ext _ _ (Subsingleton.elim _ _)))

  have wc_lan_eval_iso : ∀ {C D : Type (u+1)} [Category.{u} C] [Category.{u} D] (L : C ⥤ D)
      [∀ F : C ⥤ AddCommGrpCat.{u+1}, L.HasPointwiseLeftKanExtension F]
      [∀ F : C ⥤ AddCommGrpCat.{u+1}, L.HasLeftKanExtension F] (Y : D),
      Nonempty ((L.lan : (C ⥤ AddCommGrpCat.{u+1}) ⥤ (D ⥤ AddCommGrpCat.{u+1})) ⋙
          (evaluation D AddCommGrpCat.{u+1}).obj Y ≅
        (Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj (CostructuredArrow.proj L Y) ⋙
          Limits.colim) := by
    intro C D _ _ L _ _ Y
    refine ⟨NatIso.ofComponents (fun F => L.leftKanExtensionObjIsoColimit F Y) ?_⟩
    intro F₁ F₂ φ
    have hnat : ∀ j : CostructuredArrow L Y,
        (L.leftKanExtension F₁).map j.hom ≫ (L.lan.map φ).app Y =
        (L.lan.map φ).app (L.obj j.left) ≫ (L.leftKanExtension F₂).map j.hom :=
      fun j => (L.lan.map φ).naturality j.hom
    have hfac : ∀ j : CostructuredArrow L Y,
        (L.leftKanExtensionUnit F₁).app j.left ≫ (L.lan.map φ).app (L.obj j.left) =
        φ.app j.left ≫ (L.leftKanExtensionUnit F₂).app j.left := fun j =>
      Functor.descOfIsLeftKanExtension_fac_app (L.leftKanExtension F₁)
        (L.leftKanExtensionUnit F₁) (L.leftKanExtension F₂) (φ ≫ L.leftKanExtensionUnit F₂) j.left
    refine (Iso.inv_comp_eq _).1 ?_
    apply Limits.colimit.hom_ext
    intro j
    have key : (L.leftKanExtensionUnit F₁).app j.left ≫ (L.leftKanExtension F₁).map j.hom ≫
        (L.lan.map φ).app Y ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom =
        φ.app j.left ≫ Limits.colimit.ι (CostructuredArrow.proj L Y ⋙ F₂) j :=
      calc (L.leftKanExtensionUnit F₁).app j.left ≫ (L.leftKanExtension F₁).map j.hom ≫
            (L.lan.map φ).app Y ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom
          = (L.leftKanExtensionUnit F₁).app j.left ≫ ((L.leftKanExtension F₁).map j.hom ≫
            (L.lan.map φ).app Y) ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom :=
            congrArg ((L.leftKanExtensionUnit F₁).app j.left ≫ ·) (Category.assoc _ _ _).symm
        _ = (L.leftKanExtensionUnit F₁).app j.left ≫ ((L.lan.map φ).app (L.obj j.left) ≫
            (L.leftKanExtension F₂).map j.hom) ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom :=
            congrArg (fun k => (L.leftKanExtensionUnit F₁).app j.left ≫ k ≫
              (L.leftKanExtensionObjIsoColimit F₂ Y).hom) (hnat j)
        _ = ((L.leftKanExtensionUnit F₁).app j.left ≫ (L.lan.map φ).app (L.obj j.left)) ≫
            (L.leftKanExtension F₂).map j.hom ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom :=
            (congrArg ((L.leftKanExtensionUnit F₁).app j.left ≫ ·) (Category.assoc _ _ _)).trans
              (Category.assoc _ _ _).symm
        _ = (φ.app j.left ≫ (L.leftKanExtensionUnit F₂).app j.left) ≫
            (L.leftKanExtension F₂).map j.hom ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom :=
            congrArg (· ≫ (L.leftKanExtension F₂).map j.hom ≫
              (L.leftKanExtensionObjIsoColimit F₂ Y).hom) (hfac j)
        _ = φ.app j.left ≫ ((L.leftKanExtensionUnit F₂).app j.left ≫
            (L.leftKanExtension F₂).map j.hom ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom) :=
            Category.assoc _ _ _
        _ = φ.app j.left ≫ Limits.colimit.ι (CostructuredArrow.proj L Y ⋙ F₂) j :=
            congrArg (φ.app j.left ≫ ·) (Functor.ι_leftKanExtensionObjIsoColimit_hom L F₂ Y j)
    erw [Functor.ι_leftKanExtensionObjIsoColimit_inv_assoc, Limits.ι_colimMap]
    exact key

  have wc_lan_preservesFiniteLimits_of_discrete_final : ∀ {C D : Type (u+1)} [Category.{u} C]
      [Category.{u} D] (L : C ⥤ D)
      [∀ F : C ⥤ AddCommGrpCat.{u+1}, L.HasPointwiseLeftKanExtension F]
      [∀ F : C ⥤ AddCommGrpCat.{u+1}, L.HasLeftKanExtension F],
      (∀ Y : D, Nonempty ((L.lan : (C ⥤ AddCommGrpCat.{u+1}) ⥤ (D ⥤ AddCommGrpCat.{u+1})) ⋙
          (evaluation D AddCommGrpCat.{u+1}).obj Y ≅
        (Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj (CostructuredArrow.proj L Y) ⋙
          Limits.colim)) →
      (∀ Y : D, ∃ (I : Type u) (G : Discrete I ⥤ CostructuredArrow L Y), G.Final) →
      Limits.PreservesFiniteLimits
        (L.lan : (C ⥤ AddCommGrpCat.{u+1}) ⥤ (D ⥤ AddCommGrpCat.{u+1})) := by
    intro C D _ _ L _ _ hiso hfin
    constructor
    intro J _ _
    apply Limits.preservesLimitsOfShape_of_evaluation
    intro Y
    obtain ⟨θ⟩ := hiso Y
    obtain ⟨I, G, hG⟩ := hfin Y
    haveI : HasExactColimitsOfShape (Discrete I) AddCommGrpCat.{u+1} :=
      HasExactColimitsOfShape.of_domain_equivalence AddCommGrpCat.{u+1}
        (Discrete.equivalence (Equiv.ulift : ULift.{u+1} I ≃ I))
    let e2 : (Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj (CostructuredArrow.proj L Y) ⋙
        ((Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj G ⋙ Limits.colim) ≅
        (Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj (CostructuredArrow.proj L Y) ⋙
          Limits.colim :=
      Functor.isoWhiskerLeft _ (Functor.Final.colimIso G)
    exact Limits.preservesLimitsOfShape_of_natIso (e2 ≪≫ θ.symm)

  have wc_leftAdjoint_freeYoneda_iso : ∀ {C D : Type (u+1)} [Category.{u} C] [Category.{u} D]
      (J : GrothendieckTopology C) (K : GrothendieckTopology D)
      [HasWeakSheafify J AddCommGrpCat.{u+1}] [HasWeakSheafify K AddCommGrpCat.{u+1}]
      (Φ : C ⥤ D) [Φ.IsContinuous J K]
      (L : Sheaf J AddCommGrpCat.{u+1} ⥤ Sheaf K AddCommGrpCat.{u+1})
      (adj : L ⊣ Φ.sheafPushforwardContinuous AddCommGrpCat.{u+1} J K) (X : C),
      Nonempty (L.obj ((presheafToSheaf J AddCommGrpCat.{u+1}).obj
          (yoneda.obj X ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) ≅
        (presheafToSheaf K AddCommGrpCat.{u+1}).obj
          (yoneda.obj (Φ.obj X) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) := by
    intro C D _ _ J K _ _ Φ _ L adj X
    have rep : ∀ {E : Type (u+1)} [Category.{u} E] (J' : GrothendieckTopology E)
        [HasWeakSheafify J' AddCommGrpCat.{u+1}] (Y : E),
        (sheafToPresheaf J' AddCommGrpCat.{u+1} ⋙ (evaluation Eᵒᵖ AddCommGrpCat.{u+1}).obj
          (Opposite.op Y) ⋙ forget AddCommGrpCat.{u+1}).CorepresentableBy
          ((presheafToSheaf J' AddCommGrpCat.{u+1}).obj
            (yoneda.obj Y ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) := by
      intro E _ J' _ Y
      exact
        { homEquiv := fun {G} =>
            ((sheafificationAdjunction J' AddCommGrpCat.{u+1}).homEquiv _ G).trans
              (((Adjunction.whiskerRight Eᵒᵖ AddCommGrpCat.adj).homEquiv
                (yoneda.obj Y ⋙ uliftFunctor.{u+1, u}) _).trans uliftYonedaEquiv)
          homEquiv_comp := fun {G G'} f g => by
            simp only [Equiv.trans_apply, Adjunction.homEquiv_naturality_right]
            rfl }
    have r1 := rep J X
    have r2 := rep K (Φ.obj X)
    let r3 : (sheafToPresheaf K AddCommGrpCat.{u+1} ⋙ (evaluation Dᵒᵖ AddCommGrpCat.{u+1}).obj
          (Opposite.op (Φ.obj X)) ⋙ forget AddCommGrpCat.{u+1}).CorepresentableBy
          (L.obj ((presheafToSheaf J AddCommGrpCat.{u+1}).obj
            (yoneda.obj X ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))) :=
      { homEquiv := fun {G} => (adj.homEquiv _ G).trans r1.homEquiv
        homEquiv_comp := fun {G G'} f g => by
          show r1.homEquiv (adj.homEquiv _ G' (g ≫ f)) = _
          rw [Adjunction.homEquiv_naturality_right, r1.homEquiv_comp]
          rfl }
    exact ⟨r3.uniqueUpToIso r2⟩

  have wc_slice_ext_adjunction : ∀ (S : Scheme.{u}) (U : S.ProEt)
      [(wcSliceFunctor S U).IsContinuous (Scheme.ProEt.topology U.left) (Scheme.ProEt.topology S)]
      [(wcSliceFunctor S U).IsCocontinuous (Scheme.ProEt.topology U.left)
        (Scheme.ProEt.topology S)]
      [Limits.PreservesFiniteLimits ((wcSliceFunctor S U).op.lan :
        ((U.left.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) ⥤ ((S.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1}))]
      (X : Sheaf (Scheme.ProEt.topology U.left) AddCommGrpCat.{u+1})
      (Y : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (i : ℕ),
      Nonempty (Abelian.Ext (((wcSliceFunctor S U).sheafPullback AddCommGrpCat.{u+1}
          (Scheme.ProEt.topology U.left) (Scheme.ProEt.topology S)).obj X) Y i ≃
        Abelian.Ext X (((wcSliceFunctor S U).sheafPushforwardContinuous AddCommGrpCat.{u+1}
          (Scheme.ProEt.topology U.left) (Scheme.ProEt.topology S)).obj Y) i) := by
    intro S U _ _ _ X Y i
    let G := (wcSliceFunctor S U).sheafPushforwardContinuous AddCommGrpCat.{u+1}
          (Scheme.ProEt.topology U.left) (Scheme.ProEt.topology S)
    let F := (wcSliceFunctor S U).sheafPullback AddCommGrpCat.{u+1}
          (Scheme.ProEt.topology U.left) (Scheme.ProEt.topology S)
    let adj : F ⊣ G := (wcSliceFunctor S U).sheafAdjunctionContinuous AddCommGrpCat.{u+1}
          (Scheme.ProEt.topology U.left) (Scheme.ProEt.topology S)
    let adj2 := (wcSliceFunctor S U).sheafAdjunctionCocontinuous AddCommGrpCat.{u+1}
          (Scheme.ProEt.topology U.left) (Scheme.ProEt.topology S)
    haveI : Limits.PreservesColimitsOfSize.{0, 0} F := adj.leftAdjoint_preservesColimits
    haveI : Limits.PreservesFiniteColimits F :=
      Limits.PreservesColimitsOfSize.preservesFiniteColimits F
    haveI : Limits.PreservesColimitsOfSize.{0, 0} G := adj2.leftAdjoint_preservesColimits
    haveI : Limits.PreservesFiniteColimits G :=
      Limits.PreservesColimitsOfSize.preservesFiniteColimits G
    haveI : G.PreservesZeroMorphisms := Functor.preservesZeroMorphisms_of_isRightAdjoint G
    haveI : G.Additive := Functor.additive_of_preserves_binary_products G
    haveI : F.Additive := adj.left_adjoint_additive
    exact ⟨(adj.extEquiv (X := X) (Y := Y) (n := i)).toEquiv⟩
  intro S U A _ _ _ i

  have hcov : CoverPreserving (Scheme.ProEt.topology U.left) (Scheme.ProEt.topology S)
      (wcSliceFunctor S U) :=
    CoverPreserving.mk (fun {V} {R} hR =>
      (wc_proet_mem_topology_iff S ((wcSliceFunctor S U).obj V)
        (Sieve.functorPushforward (wcSliceFunctor S U) R)).2
        ((Sieve.functorPushforward_comp (wcSliceFunctor S U)
          (Scheme.ProEt.forget S ⋙ Over.forget S) R) ▸ (wc_proet_mem_topology_iff U.left V R).1 hR))
  haveI hcont : (wcSliceFunctor S U).IsContinuous (Scheme.ProEt.topology U.left)
      (Scheme.ProEt.topology S) :=
    Functor.isContinuous_of_coverPreserving (wc_slice_compatiblePreserving S U) hcov
  haveI hcocont : (wcSliceFunctor S U).IsCocontinuous (Scheme.ProEt.topology U.left)
      (Scheme.ProEt.topology S) :=
    Functor.IsCocontinuous.mk (fun {V} {T} hT => by
      have h1 := (wc_proet_mem_topology_iff S ((wcSliceFunctor S U).obj V) T).1 hT
      rw [← wc_slice_pushforward_functorPullback S U V T] at h1
      exact (wc_proet_mem_topology_iff U.left V _).2 h1)

  haveI hlan : Limits.PreservesFiniteLimits ((wcSliceFunctor S U).op.lan :
      ((U.left.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) ⥤ ((S.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1})) :=
    wc_lan_preservesFiniteLimits_of_discrete_final (wcSliceFunctor S U).op
      (fun Y => wc_lan_eval_iso (wcSliceFunctor S U).op Y)
      (fun Y => wc_slice_costructuredArrow_final S U Y.unop)

  obtain ⟨E₁⟩ := wc_slice_ext_adjunction S U (wcFreeSheaf U.left (Scheme.ProEt.mk (𝟙 U.left)))
    (wcContSheaf S A) i
  obtain ⟨e⟩ := wc_leftAdjoint_freeYoneda_iso (Scheme.ProEt.topology U.left)
    (Scheme.ProEt.topology S) (wcSliceFunctor S U)
    ((wcSliceFunctor S U).sheafPullback AddCommGrpCat.{u+1} (Scheme.ProEt.topology U.left)
      (Scheme.ProEt.topology S))
    ((wcSliceFunctor S U).sheafAdjunctionContinuous AddCommGrpCat.{u+1}
      (Scheme.ProEt.topology U.left) (Scheme.ProEt.topology S))
    (Scheme.ProEt.mk (𝟙 U.left))
  let e' : ((wcSliceFunctor S U).sheafPullback AddCommGrpCat.{u+1} (Scheme.ProEt.topology U.left)
      (Scheme.ProEt.topology S)).obj (wcFreeSheaf U.left (Scheme.ProEt.mk (𝟙 U.left))) ≅
      wcFreeSheaf S U := e
  let E₀ : Abelian.Ext (wcFreeSheaf S U) (wcContSheaf S A) i ≃
      Abelian.Ext (((wcSliceFunctor S U).sheafPullback AddCommGrpCat.{u+1}
        (Scheme.ProEt.topology U.left) (Scheme.ProEt.topology S)).obj
          (wcFreeSheaf U.left (Scheme.ProEt.mk (𝟙 U.left)))) (wcContSheaf S A) i :=
    { toFun := fun x => (Abelian.Ext.mk₀ e'.hom).comp x (zero_add i)
      invFun := fun y => (Abelian.Ext.mk₀ e'.inv).comp y (zero_add i)
      left_inv := fun x => by
        simp only
        rw [← Abelian.Ext.comp_assoc _ _ _ (add_zero 0) (zero_add i) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.mk₀_id_comp]
      right_inv := fun y => by
        simp only
        rw [← Abelian.Ext.comp_assoc _ _ _ (add_zero 0) (zero_add i) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.mk₀_id_comp] }
  exact ⟨E₀.trans E₁⟩

theorem wc_contSheaf_discrete_const : ∀ (Y : Scheme.{u}) (A : Type) [AddCommGroup A] [TopologicalSpace A] [DiscreteTopology A] [IsTopologicalAddGroup A], Nonempty (wcContSheaf Y A ≅ (constantSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} A))) :=
by
  intro Y A _ _ _ _

  let c : (Functor.const Y.ProEtᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} A)) ⟶
      (wcContSheaf Y A).obj :=
    { app := fun U => AddCommGrpCat.ofHom (AddMonoidHom.mk'
          (fun a : ULift.{u+1} A =>
            (ULift.up (ContinuousMap.const _ a.down) :
              ULift.{u+1} C(↥((Scheme.ProEt.forget Y ⋙ Over.forget Y).obj (Opposite.unop U)),
                A)))
          (fun a b => rfl))
      naturality := fun U V f => by
        apply AddCommGrpCat.hom_ext
        apply AddMonoidHom.ext
        intro a
        apply ULift.ext
        apply ContinuousMap.ext
        intro t
        rfl }

  have hinj : Presheaf.IsLocallyInjective (Scheme.ProEt.topology Y) c := by
    refine ⟨fun {X} x y hxy => ?_⟩
    rcases isEmpty_or_nonempty (X.unop.left) with hE | ⟨⟨p⟩⟩
    · exact (Scheme.ProEt.topology Y).superset_covering bot_le
        (Scheme.ProEt.bot_mem_topology X.unop)
    · change (ULift.up (ContinuousMap.const _ x.down) : ULift.{u+1} C(↥X.unop.left, A)) =
          ULift.up (ContinuousMap.const _ y.down) at hxy
      have h1 := congrArg (fun z : ULift.{u+1} C(↥X.unop.left, A) => z.down p) hxy
      have hxy' : x = y := by
        apply ULift.ext
        exact h1
      subst hxy'
      refine (Scheme.ProEt.topology Y).superset_covering ?_ ((Scheme.ProEt.topology Y).top_mem _)
      intro V f _
      rw [Presheaf.equalizerSieve_apply]

  have hsurj : Presheaf.IsLocallySurjective (Scheme.ProEt.topology Y) c := by
    refine ⟨fun {U} s => ?_⟩
    let s' : C(↥U.left, A) := ULift.down s
    let O : A → U.left.Opens := fun a =>
      ⟨s' ⁻¹' {a}, s'.continuous.isOpen_preimage _ (isOpen_discrete _)⟩
    haveI := U.prop
    let W : ULift.{u+1} A → Y.ProEt := fun i => Scheme.ProEt.mk ((O i.down).ι ≫ U.hom)
    let f : ∀ i, W i ⟶ U := fun i => MorphismProperty.Over.homMk (O i.down).ι rfl trivial
    have hcov : ∀ x : ↥U.left, ∃ (i : ULift.{u+1} A) (y : ↥(O i.down).toScheme),
        (O i.down).ι y = x := fun x =>
      ⟨ULift.up (s' x), ⟨x, rfl⟩, Scheme.Opens.ι_apply _ _⟩
    let 𝒰 : Scheme.Cover (Scheme.precoverage @WeaklyEtale) U.left :=
      Scheme.Cover.mkOfCovers (P := @WeaklyEtale) (ULift.{u+1} A)
        (fun i => (O i.down).toScheme) (fun i => (O i.down).ι) hcov (fun i => inferInstance)
    have hqc : QuasiCompactCover 𝒰.toPreZeroHypercover :=
      @QuasiCompactCover.of_isOpenMap _ _ 𝒰 Scheme.instJointlySurjectivePrecoverage
        (fun i => (Scheme.Hom.isOpenEmbedding (O i.down).ι).isOpenMap)
    have hR : Presieve.ofArrows (fun i : ULift.{u+1} A => (O i.down).toScheme)
        (fun i => (O i.down).ι) ∈ Scheme.proetalePrecoverage.coverings U.left :=
      Scheme.mem_propQCPrecoverage_iff_exists_quasiCompactCover.mpr ⟨𝒰, hqc, rfl⟩
    have e := Presieve.map_ofArrows (F := Scheme.ProEt.forget Y ⋙ Over.forget Y) (Y := W) f
    have hR' : Presieve.ofArrows W f ∈ (Scheme.ProEt.precoverage Y).coverings U :=
      Precoverage.mem_comap_iff.mpr (e ▸ hR)
    have hRJ : Sieve.generate (Presieve.ofArrows W f) ∈ (Scheme.ProEt.topology Y) U :=
      Precoverage.generate_mem_toGrothendieck hR'
    refine (Scheme.ProEt.topology Y).superset_covering ?_ hRJ
    rintro V g ⟨W', h, f', hf', rfl⟩
    rcases hf' with ⟨i⟩
    rw [Presheaf.imageSieve_apply]
    refine ⟨ULift.up i.down, ?_⟩
    apply ULift.ext
    apply ContinuousMap.ext
    intro v
    let y : ↥(O i.down) := (h.left : V.left ⟶ (O i.down).toScheme) v
    change i.down = s' ((O i.down).ι y)
    have h2 := Scheme.Opens.ι_apply (O i.down) y
    have hm : s' y.1 = i.down := y.2
    rw [h2]
    exact hm.symm

  haveI := hinj
  haveI := hsurj
  haveI : IsIso ((presheafToSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).map c) :=
    (GrothendieckTopology.W_iff (Scheme.ProEt.topology Y) c).mp
      (GrothendieckTopology.W_of_isLocallyBijective (Scheme.ProEt.topology Y) c)
  exact ⟨((asIso ((presheafToSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).map c)) ≪≫
    (sheafificationIso (wcContSheaf Y A)).symm).symm⟩

theorem wc_proet_etale_comparison_const : ∀ (K : Type u) [Field K] (Y : Scheme.{u}) (f : Y ⟶ Spec (.of K)) [IsProper f] (B : AddCommGrpCat.{u+1}) (i : ℕ),
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
    Nonempty (Abelian.Ext (wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y))) ((constantSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).obj B) i ≃ Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj B) i) :=
by
  intro K _ Y f _ B i

  haveI : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace f
  haveI : IsSeparated (Limits.terminal.from Y) := by
    have e : Limits.terminal.from Y = f ≫ Limits.terminal.from (Spec (.of K)) :=
      Limits.terminal.hom_ext _ _
    rw [e]; infer_instance

  obtain ⟨hlim, hcont⟩ := wc_etToProEt_flat_cont Y
  haveI := hlim
  haveI := hcont
  haveI hlan := wc_lan_preservesFiniteLimits (wcEtToProEt Y)
  let adj := Functor.sheafPullbackConstruction.sheafAdjunctionContinuous (wcEtToProEt Y)
    AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology Y) (Scheme.ProEt.topology Y)
  haveI hpl : Limits.PreservesFiniteLimits (wcEpsInv Y) := by
    haveI := Functor.sheafPullbackConstruction.preservesFiniteLimits (wcEtToProEt Y)
      AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology Y) (Scheme.ProEt.topology Y)
    exact Limits.preservesFiniteLimits_of_natIso
      (Adjunction.leftAdjointUniq (Functor.sheafAdjunctionContinuous (wcEtToProEt Y)
        AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology Y) (Scheme.ProEt.topology Y)) adj)
  haveI hladj : (wcEpsInv Y).IsLeftAdjoint := adj.isLeftAdjoint
  haveI hpc : Limits.PreservesFiniteColimits (wcEpsInv Y) := by
    haveI := adj.leftAdjoint_preservesColimits.{0, 0}
    exact Limits.PreservesColimitsOfSize.preservesFiniteColimits.{0, 0} _
  haveI : (wcEpsInv Y).PreservesZeroMorphisms :=
    Functor.preservesZeroMorphisms_of_isLeftAdjoint _
  haveI hadd : (wcEpsInv Y).Additive := Functor.additive_of_preserves_binary_products _

  letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
  haveI : EssentiallySmall.{u+1} Y.Etale := inferInstance
  haveI : IsGrothendieckAbelian.{u+1} (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) :=
    Sheaf.isGrothendieckAbelian_of_essentiallySmall _ _
  haveI : EnoughInjectives (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) :=
    IsGrothendieckAbelian.enoughInjectives

  have hunit := fun G => wc_epsInv_unit_iso Y G
  haveI : ∀ G, IsIso (adj.unit.app G) := hunit
  haveI : IsIso adj.unit := NatIso.isIso_of_isIso_app _
  let Zet := (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
    (AddCommGrpCat.of (ULift.{u+1} ℤ))
  let Bet := (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj B
  have ha : ∀ G : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1},
      Function.Bijective (fun g : Zet ⟶ G => (wcEpsInv Y).map g) :=
    fun G => (adj.fullyFaithfulLOfIsIsoUnit).map_bijective Zet G

  let ψ : (wcEpsInv Y).obj Zet ≅ wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y)) :=
    (wc_epsInv_const Y (AddCommGrpCat.of (ULift.{u+1} ℤ))).some ≪≫
      (wc_free_terminal_const Y).some.symm
  let χ : (wcEpsInv Y).obj Bet ≅ (constantSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).obj B :=
    (wc_epsInv_const Y B).some
  have hb : ∀ (I : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) [Injective I] (n : ℕ)
      (e : Abelian.Ext ((wcEpsInv Y).obj Zet) ((wcEpsInv Y).obj I) (n + 1)), e = 0 := by
    intro I _ n e
    have h0 : (Abelian.Ext.mk₀ ψ.inv).comp e (zero_add (n + 1)) = 0 :=
      wc_proet_globalize_vanishing Y hunit (wc_epsInv_affine_vanishing Y) I n _
    calc e = (Abelian.Ext.mk₀ (𝟙 _)).comp e (zero_add (n + 1)) := (Abelian.Ext.mk₀_id_comp e).symm
      _ = ((Abelian.Ext.mk₀ ψ.hom).comp (Abelian.Ext.mk₀ ψ.inv) (add_zero 0)).comp e
            (zero_add (n + 1)) := by rw [Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id]
      _ = (Abelian.Ext.mk₀ ψ.hom).comp ((Abelian.Ext.mk₀ ψ.inv).comp e (zero_add (n + 1)))
            (zero_add (n + 1)) :=
          Abelian.Ext.comp_assoc _ _ _ (add_zero 0) (zero_add (n + 1)) (by omega)
      _ = 0 := by rw [h0, Abelian.Ext.comp_zero]

  have hΦ := wc_ext_transfer_exact (wcEpsInv Y) Zet ha hb Bet i
  let Φ := Equiv.ofBijective _ hΦ

  have pre : ∀ {A A' B : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}} (e : A ≅ A'),
      Nonempty (Abelian.Ext A B i ≃ Abelian.Ext A' B i) := by
    intro A A' B e
    refine ⟨{ toFun := fun y => (Abelian.Ext.mk₀ e.inv).comp y (zero_add i)
              invFun := fun y => (Abelian.Ext.mk₀ e.hom).comp y (zero_add i)
              left_inv := fun y => ?_
              right_inv := fun y => ?_ }⟩
    · simp only
      rw [← Abelian.Ext.comp_assoc _ _ _ (add_zero 0) (zero_add i) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.mk₀_id_comp]
    · simp only
      rw [← Abelian.Ext.comp_assoc _ _ _ (add_zero 0) (zero_add i) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.mk₀_id_comp]
  have post : ∀ {A B B' : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}} (e : B ≅ B'),
      Nonempty (Abelian.Ext A B i ≃ Abelian.Ext A B' i) := by
    intro A B B' e
    refine ⟨{ toFun := fun y => y.comp (Abelian.Ext.mk₀ e.hom) (add_zero i)
              invFun := fun y => y.comp (Abelian.Ext.mk₀ e.inv) (add_zero i)
              left_inv := fun y => ?_
              right_inv := fun y => ?_ }⟩
    · simp only
      rw [Abelian.Ext.comp_assoc _ _ _ (add_zero i) (add_zero 0) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
    · simp only
      rw [Abelian.Ext.comp_assoc _ _ _ (add_zero i) (add_zero 0) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.comp_mk₀_id]
  obtain ⟨E1⟩ := pre (B := (constantSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).obj B) ψ.symm
  obtain ⟨E2⟩ := post (A := (wcEpsInv Y).obj Zet) χ.symm
  exact ⟨E1.trans (E2.trans Φ.symm)⟩

theorem wc_et_ext_torsion_colim_lift : ∀ (Y : Scheme.{u}), CompactSpace Y → QuasiSeparatedSpace Y → ∀ (ℓ : ℕ) (A : Type) [AddCommGroup A], (∀ a : A, ∃ k : ℕ, ℓ ^ k • a = 0) →
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
    ∀ (n : ℕ) (ξ : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} A))) n), ∃ (k : ℕ) (B : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (φ : B ⟶ (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} A))) (y : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) B n), (ℓ ^ k) • 𝟙 B = 0 ∧ y.comp (Abelian.Ext.mk₀ φ) (add_zero n) = ξ :=
by
  intro Y hYc hYqs ℓ A _ hA
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
  intro n ξ

  have s1 : ∃ (D : ULift.{u+1} ℕ ⥤ AddCommGrpCat.{u+1}),
      Nonempty (Limits.colimit D ≅ AddCommGrpCat.of (ULift.{u+1} A)) ∧
      ∀ j : ULift.{u+1} ℕ, ∃ k : ℕ, (ℓ ^ k) • 𝟙 (D.obj j) = 0 := by
    let Ak : ℕ → AddSubgroup A := fun k => (nsmulAddMonoidHom (ℓ ^ k) : A →+ A).ker
    have hmemAk : ∀ k (a : A), a ∈ Ak k ↔ ℓ ^ k • a = 0 := fun k a => by
      simp [Ak, AddMonoidHom.mem_ker]
    have hmono : ∀ {k k' : ℕ}, k ≤ k' → Ak k ≤ Ak k' := by
      intro k k' h a ha
      rw [hmemAk] at ha ⊢
      rw [← Nat.pow_sub_mul_pow ℓ h, mul_nsmul', ha, smul_zero]
    let D : ULift.{u+1} ℕ ⥤ AddCommGrpCat.{u+1} :=
      { obj := fun j => AddCommGrpCat.of (ULift.{u+1} (Ak j.down))
        map := fun {j j'} f => AddCommGrpCat.ofHom
          (AddEquiv.ulift.symm.toAddMonoidHom.comp
            ((AddSubgroup.inclusion (hmono (ULift.down_le.mpr (leOfHom f)))).comp
              AddEquiv.ulift.toAddMonoidHom))
        map_id := fun j => by ext x; rfl
        map_comp := fun f g => by ext x; rfl }
    let t : Limits.Cocone D :=
      { pt := AddCommGrpCat.of (ULift.{u+1} A)
        ι := { app := fun j => AddCommGrpCat.ofHom
                 (AddEquiv.ulift.symm.toAddMonoidHom.comp
                   ((Ak j.down).subtype.comp AddEquiv.ulift.toAddMonoidHom))
               naturality := fun j j' f => by ext x; rfl } }
    have : Limits.ReflectsColimitsOfShape (ULift.{u+1} ℕ) (forget AddCommGrpCat.{u+1}) :=
      Limits.reflectsColimitsOfShape_of_reflectsIsomorphisms
    have ht : Limits.IsColimit t := by
      apply Limits.isColimitOfReflects (forget AddCommGrpCat.{u+1})
      apply Limits.Types.FilteredColimit.isColimitOf
      · intro x
        obtain ⟨k, hk⟩ := hA x.down
        exact ⟨⟨k⟩, (ULift.up ⟨x.down, (hmemAk k _).2 hk⟩ : ULift.{u+1} (Ak k)), rfl⟩
      · intro i j xi xj h
        rcases xi with ⟨⟨a, ha⟩⟩
        rcases xj with ⟨⟨b, hb⟩⟩
        have hab : a = b := congrArg ULift.down h
        subst hab
        exact ⟨i ⊔ j, homOfLE le_sup_left, homOfLE le_sup_right, rfl⟩
    refine ⟨D, ⟨(Limits.colimit.isColimit D).coconePointUniqueUpToIso ht⟩, fun j => ⟨j.down, ?_⟩⟩
    ext x
    rcases x with ⟨⟨a, ha⟩⟩
    simp only [AddCommGrpCat.hom_nsmul, AddMonoidHom.nsmul_apply, AddCommGrpCat.hom_zero,
      AddMonoidHom.zero_apply, AddCommGrpCat.hom_id, AddMonoidHom.id_apply]
    exact (hmemAk _ _).1 ha

  have hT : Limits.IsTerminal (Scheme.Etale.mk (𝟙 Y)) :=
    Limits.IsTerminal.ofUniqueHom (fun V => MorphismProperty.Over.homMk V.hom)
      (fun V m => MorphismProperty.Over.Hom.ext
        ((Category.comp_id m.left).symm.trans (MorphismProperty.Over.w m)))
  have hTc : CompactSpace (Scheme.Etale.mk (𝟙 Y)).left := hYc
  have hTqs : QuasiSeparatedSpace (Scheme.Etale.mk (𝟙 Y)).left := hYqs
  have H0 : ∀ (G : ULift.{u+1} ℕ ⥤ Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})
      (x : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ))) (Limits.colimit G) 0),
      ∃ (i : ULift.{u+1} ℕ) (y : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y)
        AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) (G.obj i) 0),
        y.comp (Abelian.Ext.mk₀ (Limits.colimit.ι G i)) (add_zero 0) = x := by
    intro G x
    obtain ⟨hA', hB'⟩ := wc_et_sheaf_colimit_cocone_local Y (ULift.{u+1} ℕ) G
    obtain ⟨hsurj, -⟩ := wc_et_qcqs_sections_local_cocone Y (ULift.{u+1} ℕ) G (Limits.colimit G)
      (Limits.colimit.ι G) (fun i j f => Limits.colimit.w G f) hA' hB' (Scheme.Etale.mk (𝟙 Y))
      hTc hTqs
    obtain ⟨i, t, ht⟩ := hsurj ((Sheaf.H.equiv₀ (Limits.colimit G) hT) x)
    refine ⟨i, (Sheaf.H.equiv₀ (G.obj i) hT).symm t,
      (Sheaf.H.equiv₀ (Limits.colimit G) hT).injective ?_⟩
    have h := Sheaf.H.equiv₀_naturality hT (Limits.colimit.ι G i)
      ((Sheaf.H.equiv₀ (G.obj i) hT).symm t)
    rw [AddEquiv.apply_symm_apply, Sheaf.H.map_apply] at h
    rw [← h, ht]
  have Hemb : ∀ G : ULift.{u+1} ℕ ⥤ Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1},
      ∃ (I : ULift.{u+1} ℕ ⥤ Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (α : G ⟶ I),
        Mono α ∧
        ∀ (q : ℕ) (e : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y)
          AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) (Limits.colimit I) (q + 1)),
          e = 0 := by
    intro G
    obtain ⟨I, α, hα, hinj⟩ := wc_et_functorial_injective_embedding Y (ULift.{u+1} ℕ) G
    obtain ⟨hA', hB'⟩ := wc_et_sheaf_colimit_cocone_local Y (ULift.{u+1} ℕ) I
    exact ⟨I, α, hα, wc_et_qcqs_colim_injective_acyclic Y hYc hYqs (ULift.{u+1} ℕ) I hinj
      (fun U hU1 hU2 => wc_et_qcqs_sections_local_cocone Y (ULift.{u+1} ℕ) I (Limits.colimit I)
        (Limits.colimit.ι I) (fun i j f => Limits.colimit.w I f) hA' hB' U hU1 hU2)⟩

  obtain ⟨D, ⟨e⟩, htor⟩ := s1
  let c := constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}
  let Ψ : Limits.colimit (D ⋙ c) ≅ c.obj (AddCommGrpCat.of (ULift.{u+1} A)) :=
    (preservesColimitIso c D).symm ≪≫ c.mapIso e
  obtain ⟨i, y, hy⟩ := wc_ext_filtered_colim_lift
    ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} ℤ))) (ULift.{u+1} ℕ) H0 Hemb (D ⋙ c) n
    (ξ.comp (Abelian.Ext.mk₀ Ψ.inv) (add_zero n))
  obtain ⟨k, hk⟩ := htor i
  refine ⟨k, (D ⋙ c).obj i, Limits.colimit.ι (D ⋙ c) i ≫ Ψ.hom, y, ?_, ?_⟩
  · change (ℓ ^ k) • 𝟙 (c.obj (D.obj i)) = 0
    rw [← c.map_id, ← Functor.map_nsmul, hk, Functor.map_zero]
  · have h1 : (y.comp (Abelian.Ext.mk₀ (Limits.colimit.ι (D ⋙ c) i)) (add_zero n)).comp
        (Abelian.Ext.mk₀ Ψ.hom) (add_zero n) = ξ := by
      rw [hy, Abelian.Ext.comp_assoc _ _ _ (add_zero n) (add_zero 0) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.comp_mk₀_id]
    rw [Abelian.Ext.comp_assoc _ _ _ (add_zero n) (add_zero 0) (by omega),
      Abelian.Ext.mk₀_comp_mk₀] at h1
    exact h1

theorem wc_smooth_alg_closed_dim_le : ∀ (K : Type u) [Field K] [IsAlgClosed K] (Y : Scheme.{u}) (f : Y ⟶ Spec (.of K)) (d : ℕ) [SmoothOfRelativeDimension d f], topologicalKrullDim Y ≤ (d : WithBot ℕ∞) :=
by
  intro K _ _ Y f d _
  classical

  have s1 : ∀ (X : Type u) [TopologicalSpace X] (n : ℕ), (∀ x : X, ∃ (T : Type u)
      (_ : TopologicalSpace T) (g : T → X), Topology.IsOpenEmbedding g ∧ x ∈ Set.range g ∧
      topologicalKrullDim T ≤ (n : WithBot ℕ∞)) → topologicalKrullDim X ≤ (n : WithBot ℕ∞) := by
    intro X _ n H
    unfold topologicalKrullDim Order.krullDim
    apply iSup_le
    intro p
    obtain ⟨x, hx0⟩ := (p 0).isIrreducible.nonempty
    have hxi : ∀ i, x ∈ (p i : Set X) := fun i => (p.strictMono.monotone (Fin.zero_le i)) hx0
    obtain ⟨T, _, g, hg, ⟨t0, ht0⟩, hT⟩ := H x
    have hirr : ∀ i, IsIrreducible (g ⁻¹' (p i : Set X)) := fun i =>
      (p i).isIrreducible.preimage hg ⟨x, hxi i, t0, ht0⟩
    let W : Fin (p.length + 1) → TopologicalSpace.IrreducibleCloseds T := fun i =>
      ⟨g ⁻¹' (p i : Set X), hirr i, (p i).isClosed.preimage hg.continuous⟩
    have hstep : ∀ i : Fin p.length, W (Fin.castSucc i) < W (Fin.succ i) := by
      intro i
      have hlt : p (Fin.castSucc i) < p (Fin.succ i) := p.step i
      rw [lt_iff_le_not_ge] at hlt ⊢
      obtain ⟨hle, hnle⟩ := hlt
      refine ⟨fun t ht => hle ht, fun hge => hnle ?_⟩
      have hsub : (p (Fin.succ i) : Set X) ∩ Set.range g ⊆ (p (Fin.castSucc i) : Set X) := by
        rintro _ ⟨hz1, t, rfl⟩
        exact hge hz1
      have hcl := subset_closure_inter_of_isPreirreducible_of_isOpen
        (p (Fin.succ i)).isIrreducible.isPreirreducible hg.isOpen_range ⟨x, hxi _, t0, ht0⟩
      intro z hz
      exact closure_minimal hsub (p (Fin.castSucc i)).isClosed (hcl hz)
    let q : LTSeries (TopologicalSpace.IrreducibleCloseds T) := ⟨p.length, W, hstep⟩
    exact le_trans (Order.LTSeries.length_le_krullDim q) hT

  have s4 : ∀ (R : Type u) [CommRing R] [Algebra K R] [Algebra.FiniteType K R] (m : Ideal R)
      [m.IsMaximal] (r : R), ∃ k : K, r - algebraMap K R k ∈ m := by
    intro R _ _ _ m _ r
    letI : Field (R ⧸ m) := Ideal.Quotient.field m
    haveI : Algebra.FiniteType K (R ⧸ m) := Algebra.FiniteType.of_surjective
      (Ideal.Quotient.mkₐ K m) (Ideal.Quotient.mkₐ_surjective K m)
    haveI : Module.Finite K (R ⧸ m) := finite_of_finite_type_of_isJacobsonRing K (R ⧸ m)
    haveI : Algebra.IsIntegral K (R ⧸ m) := Algebra.IsIntegral.of_finite K (R ⧸ m)
    obtain ⟨k, hk⟩ := (IsAlgClosed.algebraMap_bijective_of_isIntegral (k := K) (K := R ⧸ m)).2
      (Ideal.Quotient.mk m r)
    refine ⟨k, ?_⟩
    rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, Ideal.Quotient.mk_algebraMap, hk, sub_self]

  have s2 : ∀ (R : Type u) [CommRing R] [IsNoetherianRing R] (m : Ideal R) [m.IsMaximal] (n : ℕ)
      (x : Fin n → R), (∀ i, x i ∈ m) → m ≤ Ideal.span (Set.range x) ⊔ m ^ 2 →
      m.height ≤ (n : ℕ∞) := by
    intro R _ _ m hm n x hx hspan
    set I := Ideal.span (Set.range x) with hI
    have hIm : I ≤ m := Ideal.span_le.mpr (by rintro _ ⟨i, rfl⟩; exact hx i)
    let N : Submodule R (R ⧸ I) := Submodule.map (Submodule.mkQ I) m
    have hN : N ≤ m • N := by
      rintro _ ⟨y, hy, rfl⟩
      obtain ⟨a, ha, b, hb, rfl⟩ := Submodule.mem_sup.mp (hspan hy)
      have hb' : b ∈ m • m := by rw [Ideal.smul_eq_mul, ← sq]; exact hb
      have ha0 : Submodule.mkQ I a = 0 := (Submodule.Quotient.mk_eq_zero I).mpr ha
      rw [map_add, ha0, zero_add, ← Submodule.map_smul'']
      exact Submodule.mem_map_of_mem hb'
    have hNfg : N.FG := (IsNoetherian.noetherian m).map (Submodule.mkQ I)
    obtain ⟨r, hr1, hr⟩ :=
      Submodule.exists_sub_one_mem_and_smul_eq_zero_of_fg_of_le_smul m N hNfg hN
    have hrm : r ∉ m := by
      intro h
      apply hm.ne_top
      rw [Ideal.eq_top_iff_one]
      have := m.sub_mem h hr1
      simpa using this
    have hry : ∀ y ∈ m, r * y ∈ I := by
      intro y hy
      have h1 := hr (Submodule.mkQ I y) (Submodule.mem_map_of_mem hy)
      rw [← LinearMap.map_smul, smul_eq_mul] at h1
      exact (Submodule.Quotient.mk_eq_zero I).mp h1
    have hmin : m ∈ I.minimalPrimes := by
      refine ⟨⟨hm.isPrime, hIm⟩, ?_⟩
      intro q hq hqm y hy
      rcases hq.1.mem_or_mem (hq.2 (hry y hy)) with h | h
      · exact absurd (hqm h) hrm
      · exact h
    have hk := Ideal.height_le_spanRank_toENat_of_mem_minimalPrimes I m hmin
    refine hk.trans ?_
    have hc : Submodule.spanRank I ≤ (n : Cardinal) := by
      refine (Submodule.spanRank_span_le_card _).trans ?_
      calc Cardinal.mk (Set.range x) = Cardinal.lift.{0} (Cardinal.mk (Set.range x)) :=
            (Cardinal.lift_uzero _).symm
        _ ≤ Cardinal.lift.{u} (Cardinal.mk (Fin n)) := Cardinal.mk_range_le_lift
        _ = n := by simp
    have hfin : (n : Cardinal) ≤ Cardinal.aleph0 := (Cardinal.natCast_lt_aleph0).le
    rw [← Cardinal.toENat_nat]
    exact (Cardinal.toENat_le_iff_of_le_aleph0 (hc.trans hfin)).mpr hc

  have s3 : ∀ (R : Type u) [CommRing R] [Algebra K R]
      [Algebra.IsStandardSmoothOfRelativeDimension d K R] (m : Ideal R) [m.IsMaximal],
      (∀ r : R, ∃ k : K, r - algebraMap K R k ∈ m) →
      ∃ x : Fin d → R, (∀ i, x i ∈ m) ∧ m ≤ Ideal.span (Set.range x) ⊔ m ^ 2 := by
    intro R _ _ _ m hm hres
    choose c hc using hres
    have huniq : ∀ (r : R) (k : K), r - algebraMap K R k ∈ m → c r = k := by
      intro r k hk
      by_contra hne
      have h1 : algebraMap K R (k - c r) ∈ m := by
        have := m.sub_mem (hc r) hk
        rw [map_sub]; convert this using 1; ring
      have hu : IsUnit (algebraMap K R (k - c r)) :=
        (isUnit_iff_ne_zero.mpr (sub_ne_zero.mpr (Ne.symm hne))).map _
      exact hm.ne_top (Ideal.eq_top_of_isUnit_mem _ h1 hu)
    have hadd : ∀ r s, c (r + s) = c r + c s := fun r s => huniq _ _ (by
      have := m.add_mem (hc r) (hc s); rw [map_add]; convert this using 1; ring)
    have hsmul : ∀ (k : K) (r : R), c (k • r) = k * c r := fun k r => huniq _ _ (by
      have := m.mul_mem_left (algebraMap K R k) (hc r)
      rw [map_mul, Algebra.smul_def]; convert this using 1; ring)
    have hmul : ∀ r s, c (r * s) = c r * c s := fun r s => huniq _ _ (by
      have := m.add_mem (m.mul_mem_left r (hc s)) (m.mul_mem_left (algebraMap K R (c s)) (hc r))
      rw [map_mul]; convert this using 1; ring)
    have hzero : ∀ y ∈ m, c y = 0 := fun y hy => huniq _ _ (by rw [map_zero, sub_zero]; exact hy)
    let D0 : R → m.Cotangent := fun r => m.toCotangent ⟨r - algebraMap K R (c r), hc r⟩
    let L0 : R →ₗ[K] m.Cotangent :=
      { toFun := D0
        map_add' := fun r s => by
          simp only [D0]
          rw [← map_add]
          congr 1
          apply Subtype.ext
          simp only [Submodule.coe_add, hadd, map_add]
          ring
        map_smul' := fun k r => by
          simp only [D0, RingHom.id_apply]
          rw [← algebraMap_smul R k (m.toCotangent _), ← m.toCotangent.map_smul]
          congr 1
          apply Subtype.ext
          show k • r - algebraMap K R (c (k • r)) = algebraMap K R k * (r - algebraMap K R (c r))
          rw [hsmul, Algebra.smul_def, map_mul]
          ring }
    have hleib : ∀ r s, L0 (r * s) = r • L0 s + s • L0 r := by
      intro r s
      show D0 (r * s) = r • D0 s + s • D0 r
      simp only [D0]
      rw [← map_smul, ← map_smul, ← map_add, Ideal.toCotangent_eq, sq]
      have h := Ideal.mul_mem_mul (hc r) (hc s)
      convert (m * m).neg_mem h using 1
      simp only [Submodule.coe_add, Submodule.coe_smul, smul_eq_mul, hmul, map_mul]
      ring
    let D : Derivation K R m.Cotangent := Derivation.mk' L0 hleib
    have hLD : ∀ r, D.liftKaehlerDifferential (KaehlerDifferential.D K R r) = D0 r := by
      intro r
      rw [Derivation.liftKaehlerDifferential_comp_D]
      rfl
    haveI : Nontrivial R := ⟨⟨0, 1, fun h => hm.ne_top (by
      rw [Ideal.eq_top_iff_one, ← h]; exact m.zero_mem)⟩⟩
    haveI := Algebra.IsStandardSmoothOfRelativeDimension.isStandardSmooth d (R := K) (S := R)
    have hrank := Algebra.IsStandardSmoothOfRelativeDimension.rank_kaehlerDifferential
      (R := K) (S := R) d
    haveI : Module.Finite R Ω[R⁄K] := Module.finite_of_rank_eq_nat hrank
    let b := Module.finBasisOfFinrankEq R Ω[R⁄K] (Module.finrank_eq_of_rank_eq hrank)
    choose xs hxs using fun i => Ideal.toCotangent_surjective m (D.liftKaehlerDifferential (b i))
    refine ⟨fun i => (xs i : R), fun i => (xs i).2, ?_⟩
    intro y hy
    have key : m.toCotangent ⟨y, hy⟩ =
        m.toCotangent (∑ i, b.repr (KaehlerDifferential.D K R y) i • xs i) := by
      have e1 : m.toCotangent ⟨y, hy⟩ = D0 y := by
        simp only [D0]
        congr 1
        apply Subtype.ext
        simp [hzero y hy]
      rw [e1, ← hLD]
      conv_lhs => rw [← b.sum_repr (KaehlerDifferential.D K R y)]
      simp only [map_sum, map_smul, hxs]
    rw [Ideal.toCotangent_eq] at key
    rw [Submodule.mem_sup]
    refine ⟨((∑ i, b.repr (KaehlerDifferential.D K R y) i • xs i : m) : R), ?_, _, key, ?_⟩
    · rw [Submodule.coe_sum]
      exact Ideal.sum_mem _ (fun i _ => by
        rw [Submodule.coe_smul, smul_eq_mul]
        exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨i, rfl⟩))
    · simp

  have s5 : ∀ (R : Type u) [CommRing R] (φ : K →+* R),
      RingHom.IsStandardSmoothOfRelativeDimension d φ → ringKrullDim R ≤ d := by
    intro R _ φ hφ
    letI := φ.toAlgebra
    haveI : Algebra.IsStandardSmoothOfRelativeDimension d K R := hφ
    haveI := Algebra.IsStandardSmoothOfRelativeDimension.isStandardSmooth d (R := K) (S := R)
    haveI : Algebra.FiniteType K R := inferInstance
    haveI : IsNoetherianRing R := Algebra.FiniteType.isNoetherianRing K R
    rw [ringKrullDim_le_iff_height_le]
    intro p hp
    obtain ⟨m, hm, hpm⟩ := Ideal.exists_le_maximal p hp.ne_top
    haveI := hm
    obtain ⟨x, hx, hspan⟩ := s3 R m (s4 R m)
    have h := s2 R m d x hx hspan
    have h2 := (Ideal.height_mono hpm).trans h
    exact_mod_cast h2

  refine s1 Y d (fun y => ?_)
  obtain ⟨U, hU, V, hV, hyV, e, hstd⟩ := (smoothOfRelativeDimension_iff d f).mp ‹_› y
  have hfy : f y ∈ U := (Scheme.Hom.mem_preimage f).mp (e hyV)
  have hUtop : U = ⊤ := by
    apply TopologicalSpace.Opens.ext
    rw [TopologicalSpace.Opens.coe_top]
    exact Set.eq_univ_of_forall (fun z => by rw [Subsingleton.elim z (f y)]; exact hfy)
  subst hUtop
  refine ⟨Spec Γ(Y, V), inferInstance, ⇑hV.fromSpec, hV.fromSpec.isOpenEmbedding, ?_, ?_⟩
  · rw [hV.range_fromSpec]; exact hyV
  · exact (PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim Γ(Y, V)).le.trans
      (s5 _ _ (hstd.comp (RingHom.IsStandardSmoothOfRelativeDimension.equiv
        (Scheme.ΓSpecIso (CommRingCat.of K)).symm.commRingCatIsoToRingEquiv)))

theorem wc_ext_torsion_prime_devissage : ∀ {C : Type*} [Category C] [Abelian C] [HasExt C] (P : C) (N m : ℕ), m ≠ 0 → (∀ p : ℕ, p.Prime → p ∣ m → ∀ F : C, p • 𝟙 F = 0 → ∀ q : ℕ, N < q → ∀ x : Abelian.Ext P F q, x = 0) → ∀ G : C, m • 𝟙 G = 0 → ∀ q : ℕ, N < q → ∀ x : Abelian.Ext P G q, x = 0 :=
by
  intro C _ _ _ P N m hm H
  have key : ∀ k : ℕ, k ∣ m → ∀ G : C, k • 𝟙 G = 0 → ∀ q : ℕ, N < q →
      ∀ x : Abelian.Ext P G q, x = 0 := by
    intro k
    induction k using Nat.strong_induction_on with
    | _ k IH =>
    intro hk G hG q hq x
    rcases Nat.lt_or_ge k 2 with hk2 | hk2
    · interval_cases k
      · exact absurd (Nat.eq_zero_of_zero_dvd hk) hm
      · rw [one_nsmul] at hG
        calc x = x.comp (Abelian.Ext.mk₀ (𝟙 G)) (add_zero q) := (Abelian.Ext.comp_mk₀_id x).symm
          _ = 0 := by rw [hG, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
    · obtain ⟨p, hpdef⟩ : ∃ p, p = Nat.minFac k := ⟨_, rfl⟩
      have hp : p.Prime := hpdef ▸ Nat.minFac_prime (by omega)
      have hpk : p ∣ k := hpdef ▸ Nat.minFac_dvd k
      obtain ⟨k', hk'⟩ := hpk
      have hp2 := hp.two_le
      have hk'pos : 0 < k' := by
        rcases Nat.eq_zero_or_pos k' with h | h
        · subst h; simp at hk'; omega
        · exact h
      have hk'lt : k' < k := by
        rw [hk']; nlinarith
      have hpm : p ∣ m := dvd_trans ⟨k', hk'⟩ hk
      have hk'm : k' ∣ m := dvd_trans ⟨p, by rw [hk', mul_comm]⟩ hk
      have hG' : (p * k') • 𝟙 G = 0 := by rw [← hk']; exact hG
      have hK : p • 𝟙 (Limits.kernel (p • 𝟙 G)) = 0 := by
        rw [← cancel_mono (Limits.kernel.ι (p • 𝟙 G)), Limits.zero_comp, Preadditive.nsmul_comp,
          Category.id_comp]
        have := Limits.kernel.condition (p • 𝟙 G)
        rw [Preadditive.comp_nsmul, Category.comp_id] at this
        exact this
      have hQ : k' • 𝟙 (Limits.cokernel (Limits.kernel.ι (p • 𝟙 G))) = 0 := by
        have hfac : Limits.cokernel.π (Limits.kernel.ι (p • 𝟙 G)) ≫
            Abelian.factorThruCoimage (p • 𝟙 G) = p • 𝟙 G := Abelian.coimage.fac (p • 𝟙 G)
        have h1 : k' • Limits.cokernel.π (Limits.kernel.ι (p • 𝟙 G)) = 0 := by
          rw [← cancel_mono (Abelian.factorThruCoimage (p • 𝟙 G)), Limits.zero_comp,
            Preadditive.nsmul_comp, hfac, smul_smul, mul_comm]
          exact hG'
        rw [← cancel_epi (Limits.cokernel.π (Limits.kernel.ι (p • 𝟙 G))), Limits.comp_zero,
          Preadditive.comp_nsmul, Category.comp_id]
        exact h1
      let S := ShortComplex.mk (Limits.kernel.ι (p • 𝟙 G))
        (Limits.cokernel.π (Limits.kernel.ι (p • 𝟙 G))) (Limits.cokernel.condition _)
      have hS : S.ShortExact := ShortComplex.ShortExact.mk'
        (S.exact_of_g_is_cokernel (Limits.cokernelIsCokernel _)) inferInstance inferInstance
      have hx2 : x.comp (Abelian.Ext.mk₀ S.g) (add_zero q) = 0 := IH k' hk'lt hk'm _ hQ q hq _
      obtain ⟨x₁, hx₁⟩ := Abelian.Ext.covariant_sequence_exact₂ P hS x hx2
      rw [← hx₁, H p hp hpm _ hK q hq x₁, Abelian.Ext.zero_comp]
  intro G hG q hq x
  exact key m dvd_rfl G hG q hq x

theorem wc_et_torsion_ext_vanish_of_fp : ∀ (Y : Scheme.{u}), CompactSpace Y → QuasiSeparatedSpace Y → ∀ (m N : ℕ), (∀ (U V : Y.Etale) (g : (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (yoneda.obj V ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶ (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)), CompactSpace U.left → QuasiSeparatedSpace U.left → CompactSpace V.left → QuasiSeparatedSpace V.left → m • 𝟙 (Limits.cokernel g) = 0 → letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _; ∀ q : ℕ, N < q → ∀ x : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) (Limits.cokernel g) q, x = 0) → ∀ (G : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}), m • 𝟙 G = 0 → letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _; ∀ q : ℕ, N < q → ∀ x : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) G q, x = 0 :=
by
  intro Y hYc hYqs m N Hfp G hG
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
  intro q hq x

  obtain ⟨Λ, instC, instF, F, ψ, hcompat, hLCa, hLCb, hstage⟩ :=
    wc_et_torsion_fp_filtered_system Y m G hG
  letI := instC
  haveI := instF

  obtain ⟨hA, -⟩ := wc_et_sheaf_colimit_cocone_local Y Λ F
  obtain ⟨e, -⟩ := wc_et_local_cocone_colimit_iso Y Λ F G ψ hcompat hLCa hLCb hA

  have hT : Limits.IsTerminal (Scheme.Etale.mk (𝟙 Y)) :=
    Limits.IsTerminal.ofUniqueHom (fun V => MorphismProperty.Over.homMk V.hom)
      (fun V m => MorphismProperty.Over.Hom.ext
        ((Category.comp_id m.left).symm.trans (MorphismProperty.Over.w m)))
  have hTc : CompactSpace (Scheme.Etale.mk (𝟙 Y)).left := hYc
  have hTqs : QuasiSeparatedSpace (Scheme.Etale.mk (𝟙 Y)).left := hYqs
  have H0 : ∀ (G' : Λ ⥤ Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})
      (x₀ : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ))) (Limits.colimit G') 0),
      ∃ (i : Λ) (y : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y)
        AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) (G'.obj i) 0),
        y.comp (Abelian.Ext.mk₀ (Limits.colimit.ι G' i)) (add_zero 0) = x₀ := by
    intro G' x₀
    obtain ⟨hA', hB'⟩ := wc_et_sheaf_colimit_cocone_local Y Λ G'
    obtain ⟨hsurj, -⟩ := wc_et_qcqs_sections_local_cocone Y Λ G' (Limits.colimit G')
      (Limits.colimit.ι G') (fun i j f => Limits.colimit.w G' f) hA' hB' (Scheme.Etale.mk (𝟙 Y))
      hTc hTqs
    obtain ⟨i, t, ht⟩ := hsurj ((Sheaf.H.equiv₀ (Limits.colimit G') hT) x₀)
    refine ⟨i, (Sheaf.H.equiv₀ (G'.obj i) hT).symm t,
      (Sheaf.H.equiv₀ (Limits.colimit G') hT).injective ?_⟩
    have h := Sheaf.H.equiv₀_naturality hT (Limits.colimit.ι G' i)
      ((Sheaf.H.equiv₀ (G'.obj i) hT).symm t)
    rw [AddEquiv.apply_symm_apply, Sheaf.H.map_apply] at h
    rw [← h, ht]
  have Hemb : ∀ G' : Λ ⥤ Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1},
      ∃ (I : Λ ⥤ Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (α : G' ⟶ I),
        Mono α ∧
        ∀ (q : ℕ) (e : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y)
          AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) (Limits.colimit I) (q + 1)),
          e = 0 := by
    intro G'
    obtain ⟨I, α, hα, hinj⟩ := wc_et_functorial_injective_embedding Y Λ G'
    obtain ⟨hA', hB'⟩ := wc_et_sheaf_colimit_cocone_local Y Λ I
    exact ⟨I, α, hα, wc_et_qcqs_colim_injective_acyclic Y hYc hYqs Λ I hinj
      (fun U hU1 hU2 => wc_et_qcqs_sections_local_cocone Y Λ I (Limits.colimit I)
        (Limits.colimit.ι I) (fun i j f => Limits.colimit.w I f) hA' hB' U hU1 hU2)⟩

  obtain ⟨i, y, hy⟩ := wc_ext_filtered_colim_lift
    ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} ℤ))) Λ H0 Hemb F q
    (x.comp (Abelian.Ext.mk₀ e.inv) (add_zero q))

  obtain ⟨U, V, g, hU, hU', hV, hV', htor, ⟨φ⟩⟩ := hstage i
  have hy' : y.comp (Abelian.Ext.mk₀ φ.hom) (add_zero q) = 0 :=
    Hfp U V g hU hU' hV hV' htor q hq _
  have hy0 : y = 0 := by
    have h1 : y = (y.comp (Abelian.Ext.mk₀ φ.hom) (add_zero q)).comp (Abelian.Ext.mk₀ φ.inv)
        (add_zero q) := by
      rw [Abelian.Ext.comp_assoc _ _ _ (add_zero q) (add_zero 0) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
    rw [h1, hy', Abelian.Ext.zero_comp]

  calc x = (x.comp (Abelian.Ext.mk₀ e.inv) (add_zero q)).comp (Abelian.Ext.mk₀ e.hom)
        (add_zero q) := by
        rw [Abelian.Ext.comp_assoc _ _ _ (add_zero q) (add_zero 0) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.comp_mk₀_id]
    _ = 0 := by rw [← hy, hy0, Abelian.Ext.zero_comp, Abelian.Ext.zero_comp]

theorem wc_et_finite_push_ext_equiv : ∀ {W Y : Scheme.{u}} (π : W ⟶ Y) [IsFinite π] (F : Sheaf (Scheme.smallEtaleTopology W) AddCommGrpCat.{u+1}) (q : ℕ), Nonempty (wcEtExt Y ((wcEtPush π).obj F) q ≃ wcEtExt W F q) :=
by
  intro W Y π _ F q
  obtain ⟨L, ⟨adj⟩, hPFL, ⟨e⟩⟩ := wc_et_push_left_adjoint π
  haveI := hPFL
  haveI hFc : Limits.PreservesFiniteColimits (wcEtPush π) := wc_et_finite_push_exact π
  haveI hFl : Limits.PreservesFiniteLimits (wcEtPush π) := by
    haveI := adj.rightAdjoint_preservesLimits.{0, 0}
    exact Limits.PreservesLimitsOfSize.preservesFiniteLimits.{0, 0} (wcEtPush π)
  haveI : (wcEtPush π).IsRightAdjoint := adj.isRightAdjoint
  haveI : (wcEtPush π).PreservesZeroMorphisms :=
    Functor.preservesZeroMorphisms_of_isRightAdjoint (wcEtPush π)
  haveI : (wcEtPush π).Additive := Functor.additive_of_preserves_binary_products (wcEtPush π)
  haveI : L.PreservesMonomorphisms := preservesMonomorphisms_of_preservesLimitsOfShape L
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology W) AddCommGrpCat.{u+1}) := HasExt.standard _
  haveI : EssentiallySmall.{u+1} W.Etale := inferInstance
  haveI : IsGrothendieckAbelian.{u+1} (Sheaf (Scheme.smallEtaleTopology W) AddCommGrpCat.{u+1}) :=
    Sheaf.isGrothendieckAbelian_of_essentiallySmall _ _
  haveI : EnoughInjectives (Sheaf (Scheme.smallEtaleTopology W) AddCommGrpCat.{u+1}) :=
    IsGrothendieckAbelian.enoughInjectives
  let ZY := (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
    (AddCommGrpCat.of (ULift.{u+1} ℤ))
  let ZW := (constantSheaf (Scheme.smallEtaleTopology W) AddCommGrpCat.{u+1}).obj
    (AddCommGrpCat.of (ULift.{u+1} ℤ))
  let Θ := Equiv.ofBijective _ (wc_ext_adjoint_transfer L (wcEtPush π) adj ZY F q)
  let E2 : Abelian.Ext (L.obj ZY) F q ≃ Abelian.Ext ZW F q :=
    { toFun := fun y => (Abelian.Ext.mk₀ e.inv).comp y (zero_add q)
      invFun := fun y => (Abelian.Ext.mk₀ e.hom).comp y (zero_add q)
      left_inv := fun y => by
        simp only
        rw [← Abelian.Ext.comp_assoc _ _ _ (add_zero 0) (zero_add q) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.mk₀_id_comp]
      right_inv := fun y => by
        simp only
        rw [← Abelian.Ext.comp_assoc _ _ _ (add_zero 0) (zero_add q) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.mk₀_id_comp] }
  change Nonempty (Abelian.Ext ZY ((wcEtPush π).obj F) q ≃ Abelian.Ext ZW F q)
  exact ⟨Θ.symm.trans E2⟩

theorem wc_et_push_id_comp_iso : ∀ {X Y Z : Scheme.{u}} (a : X ⟶ Y) (b : Y ⟶ Z), Nonempty (wcEtPush (𝟙 X) ≅ 𝟭 (Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1})) ∧ Nonempty (wcEtPush a ⋙ wcEtPush b ≅ wcEtPush (a ≫ b)) :=
by

  have hjs : ∀ (Y : Scheme.{u}) (V : Y.Etale) (S : Sieve V), (∀ v : V.left, ∃ (V₁ : Y.Etale)
      (c : V₁ ⟶ V), S.arrows c ∧ v ∈ Set.range c.left) → S ∈ Scheme.smallEtaleTopology Y V := by
    intro Y V S hS
    change S ∈ Scheme.smallGrothendieckTopology @Etale Y V
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
    apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
    intro x
    obtain ⟨V₁, c, hc, y, hy⟩ := hS x
    have hw : c.left ≫ V.hom = V₁.hom := MorphismProperty.Over.w c
    have hEt : Etale c.left := by
      have h1 : Etale V.hom := V.prop
      have h2 : Etale (c.left ≫ V.hom) := by rw [hw]; exact V₁.prop
      exact Etale.of_comp c.left V.hom
    exact ⟨V₁, c, y, hc, hEt, hy⟩

  have hcov : ∀ {X B : Scheme.{u}} (g : X ⟶ B), CoverPreserving (Scheme.smallEtaleTopology B)
      (Scheme.smallEtaleTopology X) (wcEtBaseChange g) := by
    intro X B g
    constructor
    intro V S hS
    change S ∈ Scheme.smallGrothendieckTopology @Etale B V at hS
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale B
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hS
    have hS' := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale B
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mp hS
    apply hjs
    intro v
    obtain ⟨W, a, w, ha, -, hw⟩ := hS' (Limits.pullback.fst V.hom g v)
    refine ⟨(wcEtBaseChange g).obj W, (wcEtBaseChange g).map a,
      Sieve.image_mem_functorPushforward (wcEtBaseChange g) S ha, ?_⟩
    have h0 : (Limits.pullback.fst W.hom g ≫ a.left) ≫ V.hom = Limits.pullback.snd W.hom g ≫ g := by
      rw [Category.assoc, MorphismProperty.Over.w a]
      exact Limits.pullback.condition
    let m : Limits.pullback W.hom g ⟶ Limits.pullback V.hom g :=
      Limits.pullback.lift (Limits.pullback.fst W.hom g ≫ a.left) (Limits.pullback.snd W.hom g) h0
    have hmap : ((wcEtBaseChange g).map a).left = m := rfl
    have h1 : Limits.pullback.fst a.left (Limits.pullback.fst V.hom g) ≫ W.hom =
        (Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) ≫ Limits.pullback.snd V.hom g) ≫ g := by
      rw [← MorphismProperty.Over.w a, ← Category.assoc, Limits.pullback.condition, Category.assoc,
        Limits.pullback.condition, Category.assoc]
    let ψ : Limits.pullback a.left (Limits.pullback.fst V.hom g) ⟶ Limits.pullback W.hom g :=
      Limits.pullback.lift (Limits.pullback.fst a.left (Limits.pullback.fst V.hom g))
        (Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) ≫ Limits.pullback.snd V.hom g) h1
    have hψ : ψ ≫ m = Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, Limits.pullback.lift_fst, ← Category.assoc, Limits.pullback.lift_fst,
          Limits.pullback.condition]
      · rw [Category.assoc, Limits.pullback.lift_snd, Limits.pullback.lift_snd]
    obtain ⟨z, hz⟩ : ∃ z, Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) z = v := by
      have hv : (v : ↥(Limits.pullback V.hom g)) ∈
          Set.range (Limits.pullback.snd a.left (Limits.pullback.fst V.hom g)) := by
        rw [Scheme.Pullback.range_snd]
        exact ⟨w, hw⟩
      exact hv
    rw [hmap]
    exact ⟨ψ z, (Scheme.Hom.comp_apply ψ m z).symm.trans (by rw [hψ]; exact hz)⟩

  have hcont : ∀ {X B : Scheme.{u}} (g : X ⟶ B), (wcEtBaseChange g).IsContinuous
      (Scheme.smallEtaleTopology B) (Scheme.smallEtaleTopology X) := by
    intro X B g
    haveI h1 : Limits.PreservesFiniteLimits (wcEtBaseChange g) := ⟨fun J _ _ =>
      haveI : Limits.PreservesLimitsOfShape J (wcEtBaseChange g ⋙ Scheme.Etale.forget X) :=
        Limits.preservesLimitsOfShape_of_natIso
          (NatIso.ofComponents (fun _ => Iso.refl _) (fun _ => rfl) :
            Scheme.Etale.forget B ⋙ Over.pullback g ≅ wcEtBaseChange g ⋙ Scheme.Etale.forget X)
      Limits.preservesLimitsOfShape_of_reflects_of_preserves (wcEtBaseChange g)
        (Scheme.Etale.forget X)⟩
    haveI := flat_of_preservesFiniteLimits (wcEtBaseChange g)
    exact Functor.isContinuous_of_coverPreserving (compatiblePreservingOfFlat _ _) (hcov g)

  have he : ∀ {X B : Scheme.{u}} (g : X ⟶ B) [(wcEtBaseChange g).IsContinuous
      (Scheme.smallEtaleTopology B) (Scheme.smallEtaleTopology X)],
      Nonempty (wcEtPush g ≅ (wcEtBaseChange g).sheafPushforwardContinuous AddCommGrpCat.{u+1}
        (Scheme.smallEtaleTopology B) (Scheme.smallEtaleTopology X)) := by
    intro X B g _
    exact ⟨Functor.isoWhiskerRight ((wcEtBaseChange g).sheafPushforwardContinuousCompSheafToPresheafIso
        AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology B) (Scheme.smallEtaleTopology X)).symm
        (presheafToSheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}) ≪≫
      Functor.associator _ _ _ ≪≫
      Functor.isoWhiskerLeft _ (asIso (sheafificationAdjunction (Scheme.smallEtaleTopology B)
        AddCommGrpCat.{u+1}).counit) ≪≫
      Functor.rightUnitor _⟩

  have hι : ∀ (X : Scheme.{u}), Nonempty (wcEtBaseChange (𝟙 X) ≅ 𝟭 X.Etale) := by
    intro X
    let hiso : ∀ V : X.Etale, Limits.pullback V.hom (𝟙 X) ≅ V.left := fun V =>
      { hom := Limits.pullback.fst V.hom (𝟙 X)
        inv := Limits.pullback.lift (𝟙 V.left) V.hom
          ((Category.id_comp V.hom).trans (Category.comp_id V.hom).symm)
        hom_inv_id := by
          apply Limits.pullback.hom_ext
          · rw [Category.assoc, Limits.pullback.lift_fst, Category.comp_id, Category.id_comp]
          · rw [Category.assoc, Limits.pullback.lift_snd, Category.id_comp,
              Limits.pullback.condition, Category.comp_id]
        inv_hom_id := Limits.pullback.lift_fst _ _ _ }
    refine ⟨NatIso.ofComponents (fun V => MorphismProperty.Over.isoMk (hiso V) ?_) ?_⟩
    · change Limits.pullback.fst V.hom (𝟙 X) ≫ V.hom = Limits.pullback.snd V.hom (𝟙 X)
      rw [Limits.pullback.condition, Category.comp_id]
    · intro V W f
      apply MorphismProperty.Over.Hom.ext
      change Limits.pullback.lift (Limits.pullback.fst V.hom (𝟙 X) ≫ f.left)
        (Limits.pullback.snd V.hom (𝟙 X)) _ ≫ Limits.pullback.fst W.hom (𝟙 X) =
        Limits.pullback.fst V.hom (𝟙 X) ≫ f.left
      exact Limits.pullback.lift_fst _ _ _

  have hκ : ∀ {X Y Z : Scheme.{u}} (a : X ⟶ Y) (b : Y ⟶ Z),
      Nonempty (wcEtBaseChange (a ≫ b) ≅ wcEtBaseChange b ⋙ wcEtBaseChange a) := by
    intro X Y Z a b
    letI : ∀ {A B : Scheme.{u}} (f : A ⟶ B),
        MorphismProperty.HasPullbacksAlong (@Etale : MorphismProperty Scheme.{u}) f :=
      fun _ => ⟨fun _ _ => inferInstance⟩
    letI : ∀ {A B : Scheme.{u}} (f : A ⟶ B),
        MorphismProperty.IsStableUnderBaseChangeAlong (@Etale : MorphismProperty Scheme.{u}) f :=
      fun f => (fun (P : MorphismProperty Scheme.{u}) [P.IsStableUnderBaseChange] =>
        (inferInstance : P.IsStableUnderBaseChangeAlong f)) (@Etale : MorphismProperty Scheme.{u})
    exact ⟨MorphismProperty.Over.pullbackComp (P := (@Etale : MorphismProperty Scheme.{u}))
      (Q := ⊤) a b⟩

  intro X Y Z a b
  haveI := hcont (𝟙 X)
  haveI := hcont a
  haveI := hcont b
  haveI := hcont (a ≫ b)
  obtain ⟨e1⟩ := he (𝟙 X)
  obtain ⟨ι⟩ := hι X
  obtain ⟨ea⟩ := he a
  obtain ⟨eb⟩ := he b
  obtain ⟨eab⟩ := he (a ≫ b)
  obtain ⟨κ⟩ := hκ a b
  haveI : (wcEtBaseChange b ⋙ wcEtBaseChange a).IsContinuous (Scheme.smallEtaleTopology Z)
      (Scheme.smallEtaleTopology X) :=
    Functor.isContinuous_comp (wcEtBaseChange b) (wcEtBaseChange a) (Scheme.smallEtaleTopology Z)
      (Scheme.smallEtaleTopology Y) (Scheme.smallEtaleTopology X)
  refine ⟨⟨e1 ≪≫ Functor.sheafPushforwardContinuousIso ι AddCommGrpCat.{u+1} _ _ ≪≫
    Functor.sheafPushforwardContinuousId AddCommGrpCat.{u+1} _⟩, ⟨?_⟩⟩
  exact Functor.isoWhiskerRight ea (wcEtPush b) ≪≫ Functor.isoWhiskerLeft _ eb ≪≫
    Functor.sheafPushforwardContinuousComp (wcEtBaseChange b) (wcEtBaseChange a)
      AddCommGrpCat.{u+1} _ _ _ ≪≫
    Functor.sheafPushforwardContinuousIso κ.symm AddCommGrpCat.{u+1} _ _ ≪≫ eab.symm

theorem wc_et_closed_pull_fp : ∀ {X Z : Scheme.{u}} (i : Z ⟶ X) [IsClosedImmersion i] (L : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1} ⥤ Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}), Nonempty (L ⊣ wcEtPush i) → ∀ (U V : X.Etale) (g : (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj (yoneda.obj V ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶ (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj (yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)), CompactSpace U.left → QuasiSeparatedSpace U.left → CompactSpace V.left → QuasiSeparatedSpace V.left → ∀ ℓ : ℕ, ℓ • 𝟙 (Limits.cokernel g) = 0 → ∃ (U'' V'' : Z.Etale) (g'' : (presheafToSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).obj (yoneda.obj V'' ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶ (presheafToSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).obj (yoneda.obj U'' ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)), CompactSpace U''.left ∧ QuasiSeparatedSpace U''.left ∧ CompactSpace V''.left ∧ QuasiSeparatedSpace V''.left ∧ ℓ • 𝟙 (Limits.cokernel g'') = 0 ∧ Nonempty (L.obj (Limits.cokernel g) ≅ Limits.cokernel g'') :=
by

  have hjs : ∀ (Y : Scheme.{u}) (V : Y.Etale) (S : Sieve V), (∀ v : V.left, ∃ (V₁ : Y.Etale)
      (c : V₁ ⟶ V), S.arrows c ∧ v ∈ Set.range c.left) → S ∈ Scheme.smallEtaleTopology Y V := by
    intro Y V S hS
    change S ∈ Scheme.smallGrothendieckTopology @Etale Y V
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
    apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
    intro x
    obtain ⟨V₁, c, hc, y, hy⟩ := hS x
    have hw : c.left ≫ V.hom = V₁.hom := MorphismProperty.Over.w c
    have hEt : Etale c.left := by
      have h1 : Etale V.hom := V.prop
      have h2 : Etale (c.left ≫ V.hom) := by rw [hw]; exact V₁.prop
      exact Etale.of_comp c.left V.hom
    exact ⟨V₁, c, y, hc, hEt, hy⟩

  have hcov : ∀ {X B : Scheme.{u}} (g : X ⟶ B), CoverPreserving (Scheme.smallEtaleTopology B)
      (Scheme.smallEtaleTopology X) (wcEtBaseChange g) := by
    intro X B g
    constructor
    intro V S hS
    change S ∈ Scheme.smallGrothendieckTopology @Etale B V at hS
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale B
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hS
    have hS' := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale B
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mp hS
    apply hjs
    intro v
    obtain ⟨W, a, w, ha, -, hw⟩ := hS' (Limits.pullback.fst V.hom g v)
    refine ⟨(wcEtBaseChange g).obj W, (wcEtBaseChange g).map a,
      Sieve.image_mem_functorPushforward (wcEtBaseChange g) S ha, ?_⟩
    have h0 : (Limits.pullback.fst W.hom g ≫ a.left) ≫ V.hom = Limits.pullback.snd W.hom g ≫ g := by
      rw [Category.assoc, MorphismProperty.Over.w a]
      exact Limits.pullback.condition
    let m : Limits.pullback W.hom g ⟶ Limits.pullback V.hom g :=
      Limits.pullback.lift (Limits.pullback.fst W.hom g ≫ a.left) (Limits.pullback.snd W.hom g) h0
    have hmap : ((wcEtBaseChange g).map a).left = m := rfl
    have h1 : Limits.pullback.fst a.left (Limits.pullback.fst V.hom g) ≫ W.hom =
        (Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) ≫ Limits.pullback.snd V.hom g) ≫ g := by
      rw [← MorphismProperty.Over.w a, ← Category.assoc, Limits.pullback.condition, Category.assoc,
        Limits.pullback.condition, Category.assoc]
    let ψ : Limits.pullback a.left (Limits.pullback.fst V.hom g) ⟶ Limits.pullback W.hom g :=
      Limits.pullback.lift (Limits.pullback.fst a.left (Limits.pullback.fst V.hom g))
        (Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) ≫ Limits.pullback.snd V.hom g) h1
    have hψ : ψ ≫ m = Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, Limits.pullback.lift_fst, ← Category.assoc, Limits.pullback.lift_fst,
          Limits.pullback.condition]
      · rw [Category.assoc, Limits.pullback.lift_snd, Limits.pullback.lift_snd]
    obtain ⟨z, hz⟩ : ∃ z, Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) z = v := by
      have hv : (v : ↥(Limits.pullback V.hom g)) ∈
          Set.range (Limits.pullback.snd a.left (Limits.pullback.fst V.hom g)) := by
        rw [Scheme.Pullback.range_snd]
        exact ⟨w, hw⟩
      exact hv
    rw [hmap]
    exact ⟨ψ z, (Scheme.Hom.comp_apply ψ m z).symm.trans (by rw [hψ]; exact hz)⟩

  let rep : ∀ {E : Type (u+1)} [Category.{u} E] (J' : GrothendieckTopology E)
      [HasWeakSheafify J' AddCommGrpCat.{u+1}] (Y : E),
      (sheafToPresheaf J' AddCommGrpCat.{u+1} ⋙ (evaluation Eᵒᵖ AddCommGrpCat.{u+1}).obj
        (Opposite.op Y) ⋙ forget AddCommGrpCat.{u+1}).CorepresentableBy
        ((presheafToSheaf J' AddCommGrpCat.{u+1}).obj
          (yoneda.obj Y ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) :=
    fun {E} _ J' _ Y =>
      { homEquiv := fun {G} =>
          ((sheafificationAdjunction J' AddCommGrpCat.{u+1}).homEquiv _ G).trans
            (((Adjunction.whiskerRight Eᵒᵖ AddCommGrpCat.adj).homEquiv
              (yoneda.obj Y ⋙ uliftFunctor.{u+1, u}) _).trans uliftYonedaEquiv)
        homEquiv_comp := fun {G G'} f g => by
          simp only [Equiv.trans_apply, Adjunction.homEquiv_naturality_right]
          rfl }
  intro X Z i _ L hadj U V g hU hU' hV hV' ℓ htor
  obtain ⟨adj⟩ := hadj
  let Φ := wcEtBaseChange i
  haveI h1 : Limits.PreservesFiniteLimits Φ := ⟨fun J _ _ =>
    haveI : Limits.PreservesLimitsOfShape J (wcEtBaseChange i ⋙ Scheme.Etale.forget Z) :=
      Limits.preservesLimitsOfShape_of_natIso
        (NatIso.ofComponents (fun _ => Iso.refl _) (fun _ => rfl) :
          Scheme.Etale.forget X ⋙ Over.pullback i ≅ wcEtBaseChange i ⋙ Scheme.Etale.forget Z)
    Limits.preservesLimitsOfShape_of_reflects_of_preserves (wcEtBaseChange i) (Scheme.Etale.forget Z)⟩
  haveI := flat_of_preservesFiniteLimits Φ
  haveI : Φ.IsContinuous (Scheme.smallEtaleTopology X) (Scheme.smallEtaleTopology Z) :=
    Functor.isContinuous_of_coverPreserving (compatiblePreservingOfFlat _ _) (hcov i)
  let e : wcEtPush i ≅ Φ.sheafPushforwardContinuous AddCommGrpCat.{u+1}
      (Scheme.smallEtaleTopology X) (Scheme.smallEtaleTopology Z) :=
    Functor.isoWhiskerRight (Φ.sheafPushforwardContinuousCompSheafToPresheafIso AddCommGrpCat.{u+1}
      (Scheme.smallEtaleTopology X) (Scheme.smallEtaleTopology Z)).symm
      (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) ≪≫
    Functor.associator _ _ _ ≪≫
    Functor.isoWhiskerLeft _ (asIso (sheafificationAdjunction (Scheme.smallEtaleTopology X)
      AddCommGrpCat.{u+1}).counit) ≪≫
    Functor.rightUnitor _
  let adj' := adj.ofNatIsoRight e
  let r3 : ∀ T : X.Etale, (sheafToPresheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1} ⋙
        (evaluation (Z.Etale)ᵒᵖ AddCommGrpCat.{u+1}).obj
        (Opposite.op (Φ.obj T)) ⋙ forget AddCommGrpCat.{u+1}).CorepresentableBy
        (L.obj ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
          (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))) := fun T =>
    { homEquiv := fun {G} => (adj'.homEquiv _ G).trans (rep (Scheme.smallEtaleTopology X) T).homEquiv
      homEquiv_comp := fun {G G'} f k => by
        show (rep (Scheme.smallEtaleTopology X) T).homEquiv (adj'.homEquiv _ G' (k ≫ f)) = _
        rw [Adjunction.homEquiv_naturality_right, (rep (Scheme.smallEtaleTopology X) T).homEquiv_comp]
        rfl }
  let θ : ∀ T : X.Etale, L.obj ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
        (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) ≅
      (presheafToSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).obj
        (yoneda.obj (Φ.obj T) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) :=
    fun T => (r3 T).uniqueUpToIso (rep (Scheme.smallEtaleTopology Z) (Φ.obj T))

  haveI := adj.isLeftAdjoint
  haveI : L.PreservesZeroMorphisms := Functor.preservesZeroMorphisms_of_isLeftAdjoint L
  haveI : Limits.PreservesColimitsOfSize.{0, 0} L := adj.leftAdjoint_preservesColimits
  haveI := Limits.preservesBinaryBiproducts_of_preservesBinaryCoproducts L
  haveI : L.Additive := Functor.additive_of_preservesBinaryBiproducts L

  let g'' := (θ V).inv ≫ L.map g ≫ (θ U).hom
  have hsq : L.map g ≫ (θ U).hom = (θ V).hom ≫ g'' := (Iso.hom_inv_id_assoc _ _).symm
  let E := Limits.PreservesCokernel.iso L g ≪≫
    Limits.cokernel.mapIso (L.map g) g'' (θ V) (θ U) hsq
  have htor'' : ℓ • 𝟙 (Limits.cokernel g'') = 0 := by
    calc ℓ • 𝟙 (Limits.cokernel g'') = E.inv ≫ L.map (ℓ • 𝟙 (Limits.cokernel g)) ≫ E.hom := by
          rw [Functor.map_nsmul, L.map_id, Preadditive.nsmul_comp, Category.id_comp,
            Preadditive.comp_nsmul, E.inv_hom_id]
      _ = 0 := by rw [htor, L.map_zero, Limits.zero_comp, Limits.comp_zero]
  have hq : ∀ T : X.Etale, CompactSpace T.left → QuasiSeparatedSpace T.left →
      CompactSpace (Φ.obj T).left ∧ QuasiSeparatedSpace (Φ.obj T).left := by
    intro T hc hqs
    change CompactSpace ↥(Limits.pullback T.hom i : Scheme.{u}) ∧
      QuasiSeparatedSpace ↥(Limits.pullback T.hom i : Scheme.{u})
    haveI : CompactSpace ↥((𝟭 Scheme.{u}).obj T.left) := hc
    haveI : QuasiSeparatedSpace ↥((𝟭 Scheme.{u}).obj T.left) := hqs
    exact ⟨QuasiCompact.compactSpace_of_compactSpace (Limits.pullback.fst T.hom i),
      quasiSeparatedSpace_of_quasiSeparated (Limits.pullback.fst T.hom i)⟩
  exact ⟨Φ.obj U, Φ.obj V, g'', (hq U hU hU').1, (hq U hU hU').2, (hq V hV hV').1,
    (hq V hV hV').2, htor'', ⟨E⟩⟩

theorem wc_et_closed_section_extend : ∀ {X Z : Scheme.{u}} (i : Z ⟶ X) [IsClosedImmersion i], (∀ {P E S : Scheme.{u}} (e : E ⟶ S) [Etale e] (a b : P ⟶ E), a ≫ e = b ≫ e → ∀ (Ω : Type u) [Field Ω] (π : Spec (.of Ω) ⟶ P), π ≫ a = π ≫ b → ∃ U : P.Opens, π (IsLocalRing.closedPoint Ω) ∈ U ∧ U.ι ≫ a = U.ι ≫ b) → ∀ (T V : X.Etale) (h : ((wcEtBaseChange i).obj T).left ⟶ V.left), h ≫ V.hom = ((wcEtBaseChange i).obj T).hom ≫ i → ∀ z : ((wcEtBaseChange i).obj T).left, ∃ (T' : X.Etale) (c : T' ⟶ T) (k : T'.left ⟶ V.left) (t' : T'.left), k ≫ V.hom = T'.hom ∧ c.left t' = Limits.pullback.fst T.hom i z ∧ ((wcEtBaseChange i).map c).left ≫ h = Limits.pullback.fst T'.hom i ≫ k :=
by
  intro X Z i _ hAG T V h hh z

  have ev : ∀ {A B : Scheme.{u}} {f g : A ⟶ B}, f = g → ∀ x, f x = g x := by
    rintro A B f g rfl x
    rfl

  have hBCfst : ∀ {A B : X.Etale} (c : A ⟶ B), ((wcEtBaseChange i).map c).left ≫
      Limits.pullback.fst B.hom i = Limits.pullback.fst A.hom i ≫ c.left := by
    intro A B c
    exact Limits.pullback.lift_fst _ _ _
  have hBCsnd : ∀ {A B : X.Etale} (c : A ⟶ B), ((wcEtBaseChange i).map c).left ≫
      Limits.pullback.snd B.hom i = Limits.pullback.snd A.hom i := by
    intro A B c
    exact Limits.pullback.lift_snd _ _ _

  obtain ⟨T₀, c₀, k₀, σ, hk₀, hσ1, hσ2⟩ : ∃ (T₀ : X.Etale) (c₀ : T₀ ⟶ T) (k₀ : T₀.left ⟶ V.left)
      (σ : ((wcEtBaseChange i).obj T).left ⟶ T₀.left), k₀ ≫ V.hom = T₀.hom ∧
      σ ≫ c₀.left = Limits.pullback.fst T.hom i ∧ σ ≫ k₀ = h := by
    have : Etale T.hom := T.prop
    have : Etale V.hom := V.prop
    refine ⟨MorphismProperty.Over.mk ⊤ (Limits.pullback.fst T.hom V.hom ≫ T.hom) inferInstance,
      MorphismProperty.Over.homMk (Limits.pullback.fst T.hom V.hom) rfl trivial,
      Limits.pullback.snd T.hom V.hom,
      Limits.pullback.lift (Limits.pullback.fst T.hom i) h (Limits.pullback.condition.trans hh.symm),
      Limits.pullback.condition.symm, Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩

  have w₂ : σ ≫ T₀.hom = Limits.pullback.snd T.hom i ≫ i := by
    rw [← hk₀, ← Category.assoc, hσ2]
    exact hh
  obtain ⟨σ', hσ'1, hσ'2⟩ : ∃ σ' : ((wcEtBaseChange i).obj T).left ⟶
      ((wcEtBaseChange i).obj T₀).left, σ' ≫ Limits.pullback.fst T₀.hom i = σ ∧
      σ' ≫ Limits.pullback.snd T₀.hom i = Limits.pullback.snd T.hom i :=
    ⟨Limits.pullback.lift σ (Limits.pullback.snd T.hom i) w₂, Limits.pullback.lift_fst _ _ _,
      Limits.pullback.lift_snd _ _ _⟩
  have hσ₁ : σ' ≫ ((wcEtBaseChange i).map c₀).left = 𝟙 _ := by
    refine Limits.pullback.hom_ext (f := T.hom) (g := i) ?_ ?_
    · have e : σ' ≫ (((wcEtBaseChange i).map c₀).left ≫ Limits.pullback.fst T.hom i) =
          Limits.pullback.fst T.hom i :=
        (congrArg (σ' ≫ ·) (hBCfst c₀)).trans ((Category.assoc _ _ _).symm.trans
          ((congrArg (· ≫ c₀.left) hσ'1).trans hσ1))
      exact (Category.assoc _ _ _).trans (e.trans (Category.id_comp _).symm)
    · have e : σ' ≫ (((wcEtBaseChange i).map c₀).left ≫ Limits.pullback.snd T.hom i) =
          Limits.pullback.snd T.hom i :=
        (congrArg (σ' ≫ ·) (hBCsnd c₀)).trans hσ'2
      exact (Category.assoc _ _ _).trans (e.trans (Category.id_comp _).symm)

  have hab : (((wcEtBaseChange i).map c₀).left ≫ h) ≫ V.hom =
      (Limits.pullback.fst T₀.hom i ≫ k₀) ≫ V.hom := by
    have e1 : (((wcEtBaseChange i).map c₀).left ≫ h) ≫ V.hom =
        (((wcEtBaseChange i).map c₀).left ≫ Limits.pullback.snd T.hom i) ≫ i :=
      (Category.assoc _ _ _).trans ((congrArg (((wcEtBaseChange i).map c₀).left ≫ ·) hh).trans
        (Category.assoc _ _ _).symm)
    have e2 : (Limits.pullback.fst T₀.hom i ≫ k₀) ≫ V.hom =
        Limits.pullback.fst T₀.hom i ≫ T₀.hom :=
      (Category.assoc _ _ _).trans (congrArg (Limits.pullback.fst T₀.hom i ≫ ·) hk₀)
    exact e1.trans ((congrArg (· ≫ i) (hBCsnd c₀)).trans (Limits.pullback.condition.symm.trans e2.symm))
  have hσab : σ' ≫ (((wcEtBaseChange i).map c₀).left ≫ h) =
      σ' ≫ (Limits.pullback.fst T₀.hom i ≫ k₀) := by
    have e1 : σ' ≫ (((wcEtBaseChange i).map c₀).left ≫ h) = h :=
      (Category.assoc _ _ _).symm.trans ((congrArg (· ≫ h) hσ₁).trans (Category.id_comp _))
    have e2 : σ' ≫ (Limits.pullback.fst T₀.hom i ≫ k₀) = h :=
      (Category.assoc _ _ _).symm.trans ((congrArg (· ≫ k₀) hσ'1).trans hσ2)
    exact e1.trans e2.symm

  have : Etale V.hom := V.prop
  obtain ⟨U₀, hU₀mem, hU₀⟩ := hAG V.hom _ _ hab (((wcEtBaseChange i).obj T).left.residueField z)
    (((wcEtBaseChange i).obj T).left.fromSpecResidueField z ≫ σ')
    ((Category.assoc _ _ _).trans ((congrArg (_ ≫ ·) hσab).trans (Category.assoc _ _ _).symm))
  have epz : (((wcEtBaseChange i).obj T).left.fromSpecResidueField z ≫ σ')
      (IsLocalRing.closedPoint (((wcEtBaseChange i).obj T).left.residueField z)) = σ' z :=
    (Scheme.Hom.comp_apply _ _ _).trans (congrArg σ' (Scheme.fromSpecResidueField_apply z _))
  have hz : σ' z ∈ U₀ := epz ▸ hU₀mem

  have hind : Topology.IsInducing (Limits.pullback.fst T₀.hom i) :=
    (Limits.pullback.fst T₀.hom i).isClosedEmbedding.isInducing
  obtain ⟨t, ht, hpre⟩ := hind.isOpen_iff.mp U₀.isOpen
  let O : T₀.left.Opens := ⟨t, ht⟩
  have hzt : Limits.pullback.fst T₀.hom i (σ' z) ∈ t := by
    have : σ' z ∈ (Limits.pullback.fst T₀.hom i) ⁻¹' t := by rw [hpre]; exact hz
    exact this

  have hrange : Set.range ((wcEtBaseChange i).map (wcEtOpenι X T₀ O)).left ⊆ Set.range U₀.ι := by
    rintro _ ⟨y, rfl⟩
    rw [Scheme.Opens.range_ι, ← hpre]
    have e : Limits.pullback.fst T₀.hom i (((wcEtBaseChange i).map (wcEtOpenι X T₀ O)).left y) =
        O.ι (Limits.pullback.fst (wcEtOpen X T₀ O).hom i y) :=
      (Scheme.Hom.comp_apply _ _ _).symm.trans ((ev (hBCfst (wcEtOpenι X T₀ O)) y).trans
        (Scheme.Hom.comp_apply _ _ _))
    have hmem : O.ι (Limits.pullback.fst (wcEtOpen X T₀ O).hom i y) ∈ (O : Set T₀.left) := by
      rw [← Scheme.Opens.range_ι]
      exact ⟨_, rfl⟩
    show Limits.pullback.fst T₀.hom i (((wcEtBaseChange i).map (wcEtOpenι X T₀ O)).left y) ∈ t
    exact e ▸ hmem
  have hag : ((wcEtBaseChange i).map (wcEtOpenι X T₀ O)).left ≫
      (((wcEtBaseChange i).map c₀).left ≫ h) =
      ((wcEtBaseChange i).map (wcEtOpenι X T₀ O)).left ≫
      (Limits.pullback.fst T₀.hom i ≫ k₀) :=
    (congrArg (· ≫ _) (IsOpenImmersion.lift_fac U₀.ι _ hrange)).symm.trans
      ((Category.assoc _ _ _).trans ((congrArg (_ ≫ ·) hU₀).trans
        ((Category.assoc _ _ _).symm.trans
          (congrArg (· ≫ _) (IsOpenImmersion.lift_fac U₀.ι _ hrange)))))

  refine ⟨wcEtOpen X T₀ O, wcEtOpenι X T₀ O ≫ c₀, O.ι ≫ k₀, (⟨_, hzt⟩ : O), ?_, ?_, ?_⟩
  · exact (Category.assoc _ _ _).trans (congrArg (O.ι ≫ ·) hk₀)
  · have e3 : c₀.left (Limits.pullback.fst T₀.hom i (σ' z)) = Limits.pullback.fst T.hom i z :=
      (Scheme.Hom.comp_apply _ _ _).symm.trans ((ev (hBCfst c₀) (σ' z)).symm.trans
        ((Scheme.Hom.comp_apply _ _ _).trans (congrArg (Limits.pullback.fst T.hom i)
          ((Scheme.Hom.comp_apply _ _ _).symm.trans ((ev hσ₁ z).trans rfl)))))
    have e4 : (wcEtOpenι X T₀ O ≫ c₀).left (⟨_, hzt⟩ : O) =
        c₀.left (Limits.pullback.fst T₀.hom i (σ' z)) :=
      (Scheme.Hom.comp_apply _ _ _).trans (congrArg c₀.left (Scheme.Opens.ι_apply O _))
    exact e4.trans e3
  · have e2 : ((wcEtBaseChange i).map (wcEtOpenι X T₀ O ≫ c₀)).left =
        ((wcEtBaseChange i).map (wcEtOpenι X T₀ O)).left ≫ ((wcEtBaseChange i).map c₀).left := by
      rw [Functor.map_comp]
      rfl
    have e5 : ((wcEtBaseChange i).map (wcEtOpenι X T₀ O)).left ≫
        (Limits.pullback.fst T₀.hom i ≫ k₀) =
        Limits.pullback.fst (wcEtOpen X T₀ O).hom i ≫ (O.ι ≫ k₀) :=
      (Category.assoc _ _ _).symm.trans ((congrArg (· ≫ k₀) (hBCfst (wcEtOpenι X T₀ O))).trans
        (Category.assoc _ _ _))
    exact ((congrArg (· ≫ h) e2).trans (Category.assoc _ _ _)).trans (hag.trans e5)

theorem wc_et_closed_transport_lift : ∀ {X Z : Scheme.{u}} (i : Z ⟶ X) [IsClosedImmersion i] (G : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) (H : Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) (ρ : wcEtTransport i G H), (∀ (O : Z.Etale) (g : H.obj.obj (Opposite.op O)) (o : O.left), ∃ (O' : Z.Etale) (d : O' ⟶ O) (o' : O'.left) (V : X.Etale) (h : O'.left ⟶ V.left) (hh : h ≫ V.hom = O'.hom ≫ i) (y : G.obj.obj (Opposite.op V)), d.left o' = o ∧ H.obj.map d.op g = ρ.ρ V O' h hh y) → (∀ {T V : Scheme.{u}} (j : T ⟶ V) [IsClosedImmersion j] {W : Scheme.{u}} (w : W ⟶ T) [Etale w] (x : W), ∃ (V' : Scheme.{u}) (e : V' ⟶ V) (_ : Etale e) (h : Limits.pullback e j ⟶ W) (x' : ↥(Limits.pullback e j)), h ≫ w = Limits.pullback.snd e j ∧ h x' = x) → (∀ (T V : X.Etale) (h : ((wcEtBaseChange i).obj T).left ⟶ V.left), h ≫ V.hom = ((wcEtBaseChange i).obj T).hom ≫ i → ∀ z : ((wcEtBaseChange i).obj T).left, ∃ (T' : X.Etale) (c : T' ⟶ T) (k : T'.left ⟶ V.left) (t' : T'.left), k ≫ V.hom = T'.hom ∧ c.left t' = Limits.pullback.fst T.hom i z ∧ ((wcEtBaseChange i).map c).left ≫ h = Limits.pullback.fst T'.hom i ≫ k) → ∀ (T : X.Etale) (t : H.obj.obj (Opposite.op ((wcEtBaseChange i).obj T))) (z : ((wcEtBaseChange i).obj T).left), ∃ (T' : X.Etale) (c : T' ⟶ T) (x' : T'.left) (y : G.obj.obj (Opposite.op T')), c.left x' = Limits.pullback.fst T.hom i z ∧ H.obj.map ((wcEtBaseChange i).map c).op t = ρ.ρ T' ((wcEtBaseChange i).obj T') (Limits.pullback.fst T'.hom i) Limits.pullback.condition y :=
by
  intro X Z i _ G H ρ hA hB hC T t z

  obtain ⟨O', d, o', V, h, hh, y, hd, hy⟩ := hA ((wcEtBaseChange i).obj T) t z

  have hdw : d.left ≫ ((wcEtBaseChange i).obj T).hom = O'.hom := MorphismProperty.Over.w d
  have hEtd : Etale d.left := by
    have : Etale ((wcEtBaseChange i).obj T).hom := ((wcEtBaseChange i).obj T).prop
    have : Etale (d.left ≫ ((wcEtBaseChange i).obj T).hom) := by rw [hdw]; exact O'.prop
    exact Etale.of_comp d.left ((wcEtBaseChange i).obj T).hom
  obtain ⟨V₁, e, he, h₁, x₁, h1a, h1b⟩ :=
    @hB _ _ (Limits.pullback.fst T.hom i) inferInstance O'.left d.left hEtd o'
  clear hEtd
  have h1a' : h₁ ≫ d.left = Limits.pullback.snd e (Limits.pullback.fst T.hom i) := h1a
  clear h1a

  have hT₁ : Etale (e ≫ T.hom) := by
    have : Etale T.hom := T.prop
    infer_instance
  clear he
  let T₁ : X.Etale := MorphismProperty.Over.mk ⊤ (e ≫ T.hom) hT₁
  let c₁ : T₁ ⟶ T := MorphismProperty.Over.homMk e rfl trivial
  obtain ⟨ψ, hψ⟩ : ∃ ψ : ((wcEtBaseChange i).obj T₁).left ⟶ O'.left,
      ψ = (Limits.pullbackRightPullbackFstIso T.hom i e).inv ≫ h₁ := ⟨_, rfl⟩
  have key3a : (Limits.pullbackRightPullbackFstIso T.hom i e).inv ≫
      Limits.pullback.snd e (Limits.pullback.fst T.hom i) =
      Limits.pullback.lift (Limits.pullback.fst (e ≫ T.hom) i ≫ e)
        (Limits.pullback.snd (e ≫ T.hom) i)
        (by rw [Category.assoc]; exact Limits.pullback.condition) := by
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, Limits.pullback.lift_fst]
      exact Limits.pullbackRightPullbackFstIso_inv_snd_fst T.hom i e
    · rw [Category.assoc, Limits.pullback.lift_snd]
      exact Limits.pullbackRightPullbackFstIso_inv_snd_snd T.hom i e
  have h3a : ψ ≫ d.left = Limits.pullback.lift (Limits.pullback.fst (e ≫ T.hom) i ≫ e)
        (Limits.pullback.snd (e ≫ T.hom) i)
        (by rw [Category.assoc]; exact Limits.pullback.condition) := by
    subst hψ
    exact (Category.assoc _ _ _).trans
      ((congrArg (fun m => (Limits.pullbackRightPullbackFstIso T.hom i e).inv ≫ m) h1a').trans key3a)
  have h3b : ψ ≫ O'.hom = Limits.pullback.snd (e ≫ T.hom) i := by
    rw [← hdw, ← Category.assoc, h3a]
    exact Limits.pullback.lift_snd _ _ _
  let d₁ : (wcEtBaseChange i).obj T₁ ⟶ O' :=
    MorphismProperty.Over.homMk (A := (wcEtBaseChange i).obj T₁) (B := O') ψ h3b trivial
  have h3c : d₁ ≫ d = (wcEtBaseChange i).map c₁ := by
    apply MorphismProperty.Over.Hom.ext
    exact h3a
  have hh₁ : (ψ ≫ h) ≫ V.hom = ((wcEtBaseChange i).obj T₁).hom ≫ i := by
    rw [Category.assoc, hh, ← Category.assoc, h3b]
    rfl
  have hid : ∀ x : G.obj.obj (Opposite.op V), G.obj.map (𝟙 V).op x = x := by
    intro x
    simp

  have nat1 := ρ.nat V V (𝟙 V) O' ((wcEtBaseChange i).obj T₁) d₁ h hh (ψ ≫ h) hh₁
    (Category.comp_id _) y
  rw [hid] at nat1
  have star : H.obj.map ((wcEtBaseChange i).map c₁).op t =
      ρ.ρ V ((wcEtBaseChange i).obj T₁) (ψ ≫ h) hh₁ y := by
    rw [← h3c, op_comp, Functor.map_comp_apply, hy]
    exact nat1.symm

  obtain ⟨T₂, c₂, k, t₂, hk, hc₂, hkc⟩ :=
    hC T₁ V (ψ ≫ h) hh₁ ((Limits.pullbackRightPullbackFstIso T.hom i e).hom x₁)
  have hc₂' : c₂.left t₂ = Limits.pullback.fst (e ≫ T.hom) i
      ((Limits.pullbackRightPullbackFstIso T.hom i e).hom x₁) := hc₂
  clear hc₂

  let κ : T₂ ⟶ V := MorphismProperty.Over.homMk k hk trivial
  have hh₂ : (Limits.pullback.fst T₂.hom i ≫ k) ≫ V.hom =
      ((wcEtBaseChange i).obj T₂).hom ≫ i := by
    rw [Category.assoc, hk]
    exact Limits.pullback.condition
  have nat2 := ρ.nat V V (𝟙 V) ((wcEtBaseChange i).obj T₁) ((wcEtBaseChange i).obj T₂)
    ((wcEtBaseChange i).map c₂) (ψ ≫ h) hh₁ (Limits.pullback.fst T₂.hom i ≫ k) hh₂
    ((Category.comp_id _).trans hkc.symm) y
  rw [hid] at nat2
  have nat3 := ρ.nat V T₂ κ ((wcEtBaseChange i).obj T₂) ((wcEtBaseChange i).obj T₂)
    (𝟙 _) (Limits.pullback.fst T₂.hom i ≫ k) hh₂ (Limits.pullback.fst T₂.hom i)
    Limits.pullback.condition (Category.id_comp _).symm y
  have hidH : ∀ x : H.obj.obj (Opposite.op ((wcEtBaseChange i).obj T₂)),
      H.obj.map (𝟙 ((wcEtBaseChange i).obj T₂)).op x = x := by
    intro x
    simp
  rw [hidH] at nat3

  have r1 : (c₂ ≫ c₁).left t₂ = e (c₂.left t₂) := Scheme.Hom.comp_apply c₂.left e t₂
  have r2 : Limits.pullback.fst (e ≫ T.hom) i
      ((Limits.pullbackRightPullbackFstIso T.hom i e).hom x₁) =
      Limits.pullback.fst e (Limits.pullback.fst T.hom i) x₁ := by
    rw [← Scheme.Hom.comp_apply, Limits.pullbackRightPullbackFstIso_hom_fst]
  have r3 : e (Limits.pullback.fst e (Limits.pullback.fst T.hom i) x₁) =
      Limits.pullback.fst T.hom i (Limits.pullback.snd e (Limits.pullback.fst T.hom i) x₁) := by
    rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, Limits.pullback.condition]
  have r4 : Limits.pullback.snd e (Limits.pullback.fst T.hom i) x₁ = d.left o' := by
    have e1 := congrArg (fun m => m x₁) h1a'
    simp only [Scheme.Hom.comp_apply, h1b] at e1
    exact e1.symm
  have hpt : (c₂ ≫ c₁).left t₂ = Limits.pullback.fst T.hom i z := by
    rw [r1, hc₂', r2, r3, r4, hd]

  refine ⟨T₂, c₂ ≫ c₁, t₂, G.obj.map κ.op y, hpt, ?_⟩
  rw [(wcEtBaseChange i).map_comp c₂ c₁, op_comp, Functor.map_comp_apply, star]
  exact nat2.symm.trans nat3.symm

theorem wc_et_open_image_sieve_covering : ∀ (X : Scheme.{u}) (W : X.Opens) (U : X.Etale) (G : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) (p : (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj (yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶ G), Epi p → ∀ (T : X.Etale), (∀ x, T.hom x ∈ (W : Set X)) → ∀ s : G.obj.obj (Opposite.op T), Presheaf.imageSieve ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map (Functor.whiskerRight (yoneda.map (wcEtOpenι X U (U.hom ⁻¹ᵁ W))) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) ≫ p).hom s ∈ Scheme.smallEtaleTopology X T :=
by
  intro X W U G p hp T hT s

  have key : ∀ (P Q : (X.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) (κ : P ⟶ Q)
      (p : (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj Q ⟶ G), Epi p →
      (∀ (T' : X.Etale) (_ : T' ⟶ T), Function.Surjective (κ.app (Opposite.op T')).hom) →
      Presheaf.imageSieve ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map κ ≫ p).hom s
        ∈ Scheme.smallEtaleTopology X T := by
    intro P Q κ p hp hκ
    haveI : Sheaf.IsLocallySurjective p :=
      (Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u+1} p).mpr hp
    have hR₁ : Presheaf.imageSieve p.hom s ∈ Scheme.smallEtaleTopology X T :=
      Presheaf.imageSieve_mem (Scheme.smallEtaleTopology X) p.hom s
    refine GrothendieckTopology.transitive _ hR₁ _ ?_
    intro T₁ c₁ hc₁
    obtain ⟨a, ha⟩ := hc₁
    have hR₂ : Presheaf.imageSieve (toSheafify (Scheme.smallEtaleTopology X) Q) a ∈
        Scheme.smallEtaleTopology X T₁ :=
      Presheaf.imageSieve_mem (Scheme.smallEtaleTopology X) (toSheafify (Scheme.smallEtaleTopology X) Q) a
    refine GrothendieckTopology.superset_covering _ ?_ hR₂
    intro T₂ c₂ hc₂
    obtain ⟨b, hb⟩ := hc₂
    obtain ⟨b', hb'⟩ := hκ T₂ (c₂ ≫ c₁) b
    have hnat : ((toSheafify (Scheme.smallEtaleTopology X) Q).app (Opposite.op T₂)).hom
          ((κ.app (Opposite.op T₂)).hom b') =
        ((sheafifyMap (Scheme.smallEtaleTopology X) κ).app (Opposite.op T₂)).hom
          (((toSheafify (Scheme.smallEtaleTopology X) P).app (Opposite.op T₂)).hom b') :=
      congrArg (fun φ => (φ.app (Opposite.op T₂)).hom b')
        (toSheafify_naturality (Scheme.smallEtaleTopology X) κ)
    refine ⟨((toSheafify (Scheme.smallEtaleTopology X) P).app (Opposite.op T₂)).hom b', ?_⟩
    calc (((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map κ ≫ p).hom.app
            (Opposite.op T₂)).hom
            (((toSheafify (Scheme.smallEtaleTopology X) P).app (Opposite.op T₂)).hom b')
        = (p.hom.app (Opposite.op T₂)).hom
            (((sheafifyMap (Scheme.smallEtaleTopology X) κ).app (Opposite.op T₂)).hom
              (((toSheafify (Scheme.smallEtaleTopology X) P).app (Opposite.op T₂)).hom b')) := rfl
      _ = (p.hom.app (Opposite.op T₂)).hom
            (((toSheafify (Scheme.smallEtaleTopology X) Q).app (Opposite.op T₂)).hom
              ((κ.app (Opposite.op T₂)).hom b')) := by rw [hnat]
      _ = (p.hom.app (Opposite.op T₂)).hom
            (((toSheafify (Scheme.smallEtaleTopology X) Q).app (Opposite.op T₂)).hom b) := by
          rw [hb']
      _ = (p.hom.app (Opposite.op T₂)).hom
            (((sheafify (Scheme.smallEtaleTopology X) Q).map c₂.op).hom a) := congrArg _ hb
      _ = (G.obj.map c₂.op).hom ((p.hom.app (Opposite.op T₁)).hom a) :=
          NatTrans.naturality_apply p.hom c₂.op a
      _ = (G.obj.map c₂.op).hom ((G.obj.map c₁.op).hom s) := congrArg _ ha
      _ = (G.obj.map (c₂ ≫ c₁).op).hom s := by
          rw [op_comp, Functor.map_comp]; rfl

  have hsurj : ∀ T' : X.Etale, (∀ x, T'.hom x ∈ (W : Set X)) →
      Function.Surjective ((Functor.whiskerRight (yoneda.map (wcEtOpenι X U (U.hom ⁻¹ᵁ W)))
        (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app (Opposite.op T')).hom := by
    intro T' hT'
    have hlift : ∀ e : T' ⟶ U, ∃ l : T' ⟶ wcEtOpen X U (U.hom ⁻¹ᵁ W),
        l ≫ wcEtOpenι X U (U.hom ⁻¹ᵁ W) = e := by
      intro e
      have hw : e.left ≫ U.hom = T'.hom := MorphismProperty.Over.w e
      have H : Set.range e.left ⊆ Set.range (U.hom ⁻¹ᵁ W).ι := by
        rintro _ ⟨x, rfl⟩
        rw [Scheme.Opens.range_ι]
        apply (Scheme.Hom.mem_preimage U.hom (U := W) (x := e.left x)).mpr
        have h1 : U.hom (e.left x) = T'.hom x := by rw [← Scheme.Hom.comp_apply, hw]
        rw [h1]
        exact hT' x
      obtain ⟨l, hfac⟩ : ∃ l : T'.left ⟶ (U.hom ⁻¹ᵁ W).toScheme, l ≫ (U.hom ⁻¹ᵁ W).ι = e.left :=
        ⟨_, IsOpenImmersion.lift_fac _ _ H⟩
      refine ⟨MorphismProperty.Over.homMk l ?_ trivial, ?_⟩
      · change l ≫ (U.hom ⁻¹ᵁ W).ι ≫ U.hom = T'.hom
        rw [← Category.assoc, hfac, hw]
      · apply MorphismProperty.Over.Hom.ext
        exact hfac
    intro b
    refine FreeAbelianGroup.induction_on b ?_ ?_ ?_ ?_
    · exact ⟨0, map_zero _⟩
    · intro e
      obtain ⟨l, hl⟩ := hlift e.down
      refine ⟨FreeAbelianGroup.of ⟨l⟩, ?_⟩
      change FreeAbelianGroup.map (fun x : ULift.{u+1} (T' ⟶ wcEtOpen X U (U.hom ⁻¹ᵁ W)) =>
        (ULift.up (x.down ≫ wcEtOpenι X U (U.hom ⁻¹ᵁ W)) : ULift.{u+1} (T' ⟶ U)))
        (FreeAbelianGroup.of ⟨l⟩) = _
      rw [FreeAbelianGroup.map_of_apply, hl]
      rfl
    · rintro e ⟨y, hy⟩
      exact ⟨-y, by rw [map_neg, hy]; rfl⟩
    · rintro x y ⟨x', hx⟩ ⟨y', hy⟩
      exact ⟨x' + y', by rw [map_add, hx, hy]; rfl⟩

  refine key _ _ _ p hp (fun T' c => hsurj T' (fun x => ?_))
  have hw : c.left ≫ T.hom = T'.hom := MorphismProperty.Over.w c
  rw [← hw, Scheme.Hom.comp_apply]
  exact hT _

theorem wc_et_transport_push_epi : ∀ (X Z : Scheme.{u}) (i : Z ⟶ X) (W : X.Opens), Set.range i = (W : Set X)ᶜ → ∀ (G : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) (H : Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) (β : G ⟶ (wcEtPush i).obj H) (ρ : wcEtTransport i G H), (∀ (V : X.Etale) (x : G.obj.obj (Opposite.op V)), ((toSheafify (Scheme.smallEtaleTopology X) ((wcEtBaseChange i).op ⋙ H.obj)).app (Opposite.op V)).hom (ρ.ρ V ((wcEtBaseChange i).obj V) (Limits.pullback.fst V.hom i) Limits.pullback.condition x) = (β.hom.app (Opposite.op V)).hom x) → (∀ V : X.Etale, (∀ x, V.hom x ∈ (W : Set X)) → Subsingleton (((wcEtPush i).obj H).obj.obj (Opposite.op V))) → (∀ (T : X.Etale) (t : H.obj.obj (Opposite.op ((wcEtBaseChange i).obj T))) (z : ((wcEtBaseChange i).obj T).left), ∃ (T' : X.Etale) (c : T' ⟶ T) (x' : T'.left) (y : G.obj.obj (Opposite.op T')), c.left x' = Limits.pullback.fst T.hom i z ∧ H.obj.map ((wcEtBaseChange i).map c).op t = ρ.ρ T' ((wcEtBaseChange i).obj T') (Limits.pullback.fst T'.hom i) Limits.pullback.condition y) → Epi β :=
by
  intro X Z i W hW G H β ρ hβ hvan hlift
  have hjs : ∀ (V : X.Etale) (S : Sieve V), (∀ v : V.left, ∃ (V₁ : X.Etale)
      (c : V₁ ⟶ V), S.arrows c ∧ v ∈ Set.range c.left) → S ∈ Scheme.smallEtaleTopology X V := by
    intro V S hS
    change S ∈ Scheme.smallGrothendieckTopology @Etale X V
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale X
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
    apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale X
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
    intro x
    obtain ⟨V₁, c, hc, y, hy⟩ := hS x
    have hw : c.left ≫ V.hom = V₁.hom := MorphismProperty.Over.w c
    have hEt : Etale c.left := by
      have h1 : Etale V.hom := V.prop
      have h2 : Etale (c.left ≫ V.hom) := by rw [hw]; exact V₁.prop
      exact Etale.of_comp c.left V.hom
    exact ⟨V₁, c, y, hc, hEt, hy⟩
  let P : (X.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1} := (wcEtBaseChange i).op ⋙ H.obj
  haveI hτ := Presheaf.isLocallySurjective_toSheafify' (Scheme.smallEtaleTopology X) P
  haveI : Sheaf.IsLocallySurjective β := by
    refine Presheaf.IsLocallySurjective.mk (fun {T} s => ?_)
    have hR1 : Presheaf.imageSieve (toSheafify (Scheme.smallEtaleTopology X) P) (U := T) s ∈
        Scheme.smallEtaleTopology X T :=
      Presheaf.imageSieve_mem (Scheme.smallEtaleTopology X) (toSheafify (Scheme.smallEtaleTopology X) P)
        (U := Opposite.op T) s
    refine GrothendieckTopology.transitive _ hR1 _ ?_
    intro T₁ c₁ hc₁
    obtain ⟨t, ht⟩ := hc₁
    apply hjs
    intro x
    by_cases hx : T₁.hom x ∈ (W : Set X)
    · let O : T₁.left.Opens := T₁.hom ⁻¹ᵁ W
      refine ⟨wcEtOpen X T₁ O, wcEtOpenι X T₁ O, ?_, ?_⟩
      · have hY : ∀ y, (wcEtOpen X T₁ O).hom y ∈ (W : Set X) := by
          intro y
          have h1 : (wcEtOpen X T₁ O).hom y = T₁.hom (O.ι y) :=
            Scheme.Hom.comp_apply O.ι T₁.hom y
          have h2 : O.ι y ∈ (O : Set T₁.left) := by
            rw [← Scheme.Opens.range_ι]
            exact ⟨_, rfl⟩
          rw [h1]
          exact h2
        refine ⟨0, ?_⟩
        exact @Subsingleton.elim _ (hvan _ hY) _ _
      · refine ⟨⟨x, hx⟩, ?_⟩
        change O.ι ⟨x, hx⟩ = x
        exact Scheme.Opens.ι_apply O ⟨x, hx⟩
    · have hxr : T₁.hom x ∈ Set.range i := by rw [hW]; exact hx
      have hxr' : x ∈ Set.range (Limits.pullback.fst T₁.hom i) := by
        rw [Scheme.Pullback.range_fst]; exact hxr
      obtain ⟨z, hz⟩ := hxr'
      obtain ⟨T', c, x', y, hcx, hy⟩ := hlift T₁ t z
