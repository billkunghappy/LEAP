  rw [isNoetherianObject_iff_monotone_chain_condition]
  intro S

  let I : ℕ → ∀ V : B.Etale, AddSubgroup (LocallyConstant ((wcEtBaseChange p).obj V).left (ZMod ℓ)) :=
    fun n V => (((S n).arrow.hom.app (Opposite.op V)).hom.range).comap (e V).symm.toAddMonoidHom
  have hI : ∀ n V f, f ∈ I n V ↔ ∃ t, ((S n).arrow.hom.app (Opposite.op V)).hom t = (e V).symm f :=
    fun _ _ _ => Iff.rfl
