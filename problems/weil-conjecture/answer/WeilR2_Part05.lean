  have sLim : ∀ (A : Type u) [CommRing A] (J : Type u) [SmallCategory J] [IsFiltered J] (D : J ⥤ CommRingCat.{u}) (β : ∀ j, D.obj j ⟶ CommRingCat.of A), (∀ {j j' : J} (t : j ⟶ j'), D.map t ≫ β j' = β j) → (∀ a : A, ∃ (j : J) (x : D.obj j), (β j).hom x = a) → (∀ (j j' : J) (x : D.obj j) (y : D.obj j'), (β j).hom x = (β j').hom y → ∃ (k : J) (t : j ⟶ k) (t' : j' ⟶ k), (D.map t).hom x = (D.map t').hom y) → ∀ (T : Scheme.{u}) (z : ∀ j, T ⟶ Spec (D.obj j)), (∀ {j j' : J} (t : j ⟶ j'), z j' ≫ Spec.map (D.map t) = z j) → ∃! z₀ : T ⟶ Spec (CommRingCat.of A), ∀ j, z₀ ≫ Spec.map (β j) = z j := by
