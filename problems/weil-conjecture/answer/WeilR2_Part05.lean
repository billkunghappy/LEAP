          ← wc_bc_basicOpen_coord K n (S : wcBlIdx n).1 _ j (hprod _) (hνmem _ _ j (hjT S))
            (hXn j) (hjT S)]
        exact hq1
      have hq3 : wcBlι K n (S : wcBlIdx n).1 (S : wcBlIdx n).2 (wcBlNt K n (S : wcBlIdx n).1 q) ∈
          (wcBlι K n (T : wcBlIdx n).1 (T : wcBlIdx n).2).opensRange := by
        rw [hrange T]
        show _ ∈ Proj.basicOpen _ (∏ m ∈ {j}, MvPolynomial.X m)
        rw [Finset.prod_singleton]
        exact hq2
      obtain ⟨y, hy⟩ := hq3
      obtain ⟨q', hq'⟩ := hs1 (d.isPullback_natTrans_ι_toBase T) _ y (hy.trans (hρq S q).symm)
      rw [← hq']
      have hz' : Limits.colimit.desc d.functor c (Limits.colimit.ι d.functor T q') ∈
          Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1 + 1)) K)
            (MvPolynomial.X (Fin.castSucc j)) := by
        rw [hq']
        exact hz0
      rw [hσq] at hz'
      have hz'' : q' ∈ (Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin 2) (wcBlB K n T.1))
          (wcBlF K n T (MvPolynomial.X (Fin.castSucc j))) ((wcBlF K n T).map_mem (hX _))
          one_pos).opensRange := by
        rw [Proj.opensRange_awayι, ← Proj.map_preimage_basicOpen (wcBlF K n T) (hirrF T)]
        exact hz'
      obtain ⟨w, hw⟩ := hz''
      refine ⟨w, ?_⟩
      show (Proj.awayι _ _ _ _ ≫ Limits.colimit.ι d.functor T) w = _
      rw [Scheme.Hom.comp_apply, hw]
  ·
    intro a b ha hb hab
    obtain ⟨S, q, rfl⟩ := hsurj a
    have hoff : ∀ q₀ : d.functor.obj S,
        (Limits.colimit.desc d.functor c (Limits.colimit.ι d.functor S q₀) ∉
          Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1 + 1)) K)
            (MvPolynomial.X (Fin.castSucc ((S : wcBlIdx n).1.min' (S : wcBlIdx n).2)))) →
        q₀ ∉ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin 2) (wcBlB K n (S : wcBlIdx n).1))
          (MvPolynomial.X 0) := by
      intro q₀ h₀
      have e := hpre S ((S : wcBlIdx n).1.min' (S : wcBlIdx n).2) q₀
      rw [(hL2 S S subset_rfl).1, map_one, one_mul] at e
      rw [hσq] at h₀
      exact fun h => h₀ (e.mpr h)
    have hq := hoff q (ha _)
    have hb' : wcBlι K n (S : wcBlIdx n).1 (S : wcBlIdx n).2 (wcBlNt K n (S : wcBlIdx n).1 q) =
        d.toBase b := (hρq S q).symm.trans hab
    obtain ⟨q'', rfl⟩ := hs1 (d.isPullback_natTrans_ι_toBase S) b _ hb'
    have hq'' := hoff q'' (hb _)
    rw [hρq, hρq] at hab
    have h1 := (wcBlι K n (S : wcBlIdx n).1 (S : wcBlIdx n).2).isOpenEmbedding.injective hab
    haveI := hdeg0 S
    have h2 : wcP1 _ q = wcP1 _ q'' :=
      (Spec.map (CommRingCat.ofHom (algebraMap (wcBlB K n (S : wcBlIdx n).1)
        ↥(MvPolynomial.homogeneousSubmodule (Fin 2) (wcBlB K n (S : wcBlIdx n).1) 0)))).isOpenEmbedding.injective
        h1
    rw [wc_bc_P1_inj_off_U _ q q'' hq hq'' h2]
  · intro j
    let T : (wcBlCover K n).I₀ := (⟨{j}, Finset.singleton_nonempty j⟩ : wcBlIdx n)
    haveI : IsIso (CommRingCat.ofHom (algebraMap (wcBlB K n T.1)
        ↥(MvPolynomial.homogeneousSubmodule (Fin 2) (wcBlB K n T.1) 0))) :=
      (ConcreteCategory.isIso_iff_bijective _).mpr (wc_bc_degree_zero_bijective _ 2)
    obtain ⟨φ⟩ := wc_bc_arrow_iso_of_pullback (wcP1 (wcBlB K n T.1)) (Spec.map (CommRingCat.ofHom
      (algebraMap (wcBlB K n T.1) ↥(MvPolynomial.homogeneousSubmodule (Fin 2) (wcBlB K n T.1) 0))))
      (Limits.colimit.ι d.functor T) (wcBlι K n T.1 T.2) d.toBase
      (d.isPullback_natTrans_ι_toBase T)
    have e : (wcBlι K n T.1 T.2).opensRange =
        Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X j) := by
      rw [hrange T]
      show Proj.basicOpen _ (∏ m ∈ {j}, MvPolynomial.X m) = _
      rw [Finset.prod_singleton]
    rw [e] at φ
    exact ⟨wcBlB K n T.1, inferInstance, ⟨φ⟩⟩

theorem wc_P1_fibre_dim : ∀ (A : Type u) [CommRing A] (Ω : Type u) [Field Ω]
    (t : Spec (.of Ω) ⟶ Spec (.of ↥(MvPolynomial.homogeneousSubmodule (Fin 2) A 0))),
    topologicalKrullDim ↥(Limits.pullback (@Proj.toSpecZero _ _ _ _ _
      (MvPolynomial.homogeneousSubmodule (Fin 2) A) MvPolynomial.gradedAlgebra) t) ≤
      ((1 : ℕ) : WithBot ℕ∞) :=
by
  intro A _ Ω _ t
  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin 2) A) :=
    MvPolynomial.gradedAlgebra

  have s1 : ∀ (X : Type u) [TopologicalSpace X] (ι : Type) (U : ι → Set X), (∀ i, IsOpen (U i)) →
      (∀ x : X, ∃ i, x ∈ U i) → ∀ N : ℕ, (∀ i, topologicalKrullDim ↥(U i) ≤ (N : WithBot ℕ∞)) →
      topologicalKrullDim X ≤ (N : WithBot ℕ∞) := by
    intro X _ ι U hU hcov N hN
    unfold topologicalKrullDim Order.krullDim
    refine iSup_le fun p => ?_
    obtain ⟨x, hx⟩ := (p 0).isIrreducible.nonempty
    obtain ⟨i, hi⟩ := hcov x
    have hmem : ∀ j, x ∈ (p j : Set X) := fun j => (p.monotone (Fin.zero_le j)) hx
    let T : Fin (p.length + 1) → TopologicalSpace.IrreducibleCloseds ↥(U i) := fun j =>
      { carrier := (Subtype.val : ↥(U i) → X) ⁻¹' (p j : Set X)
        isIrreducible' := ⟨⟨⟨x, hi⟩, hmem j⟩, (p j).isIrreducible.isPreirreducible.preimage
          (hU i).isOpenEmbedding_subtypeVal⟩
        isClosed' := (p j).isClosed.preimage continuous_subtype_val }
    have hT : StrictMono T := by
      intro a b hab
      have hlt : p a < p b := p.strictMono hab
      refine lt_of_le_of_ne ?_ ?_
      · intro y hy
        exact (p.monotone hab.le) hy
      · intro heq
        apply hlt.ne
        apply le_antisymm hlt.le
        have h1 : (p b : Set X) ⊆ closure ((p b : Set X) ∩ U i) :=
          subset_closure_inter_of_isPreirreducible_of_isOpen
            (p b).isIrreducible.isPreirreducible (hU i) ⟨x, hmem b, hi⟩
        have h2 : (p b : Set X) ∩ U i ⊆ (p a : Set X) := by
          rintro y ⟨hyb, hyU⟩
          have hy : (⟨y, hyU⟩ : ↥(U i)) ∈ (T b : Set ↥(U i)) := hyb
          rw [← heq] at hy
          exact hy
        intro y hy
        have := closure_mono h2 (h1 hy)
        rwa [(p a).isClosed.closure_eq] at this
    let q : LTSeries (TopologicalSpace.IrreducibleCloseds ↥(U i)) :=
      ⟨p.length, T, fun j => hT Fin.castSucc_lt_succ⟩
    have := Order.LTSeries.length_le_krullDim q
    exact this.trans (hN i)

  have s3 : ∀ (R B : Type u) [CommRing R] [CommRing B] (φ : R →+* B) (y : B),
      Function.Surjective (Polynomial.eval₂RingHom φ y) →
      ∀ (f : Spec (.of B) ⟶ Spec (.of R)), f = Spec.map (CommRingCat.ofHom φ) →
      ∀ (g : Spec (.of Ω) ⟶ Spec (.of R)),
        topologicalKrullDim ↥(Limits.pullback f g) ≤ ((1 : ℕ) : WithBot ℕ∞) := by
    intro R B _ _ φ y hsurj f hf g
    subst hf
    obtain ⟨ψ₀, rfl⟩ : ∃ ψ₀, Spec.map ψ₀ = g := ⟨Spec.preimage g, Spec.map_preimage g⟩
    letI : Algebra R B := φ.toAlgebra
    letI : Algebra R Ω := ψ₀.hom.toAlgebra
    have e : topologicalKrullDim ↥(Limits.pullback (Spec.map (CommRingCat.ofHom φ)) (Spec.map ψ₀)) =
        topologicalKrullDim ↥(Spec (.of (TensorProduct R B Ω))) :=
      IsHomeomorph.topologicalKrullDim_eq _ (Scheme.homeoOfIso (pullbackSpecIso R B Ω)).isHomeomorph
    rw [e]
    show topologicalKrullDim (PrimeSpectrum (TensorProduct R B Ω)) ≤ _
    rw [PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim]
    let Φ : Polynomial Ω →+* TensorProduct R B Ω :=
      Polynomial.eval₂RingHom (Algebra.TensorProduct.includeRight : Ω →ₐ[R] TensorProduct R B Ω).toRingHom
        (Algebra.TensorProduct.includeLeftRingHom y)
    have hcomp : (Algebra.TensorProduct.includeRight : Ω →ₐ[R] TensorProduct R B Ω).toRingHom.comp
        ψ₀.hom = (Algebra.TensorProduct.includeLeftRingHom : B →+* TensorProduct R B Ω).comp φ := by
      ext r
      exact (Algebra.TensorProduct.tmul_one_eq_one_tmul (R := R) (A := B) (B := Ω) r).symm
    have hΦ : Function.Surjective Φ := by
      intro w
      have hw : w ∈ Φ.range := by
        induction w using TensorProduct.induction_on with
        | zero => exact Subring.zero_mem _
        | tmul b ω =>
          obtain ⟨p, rfl⟩ := hsurj b
          have h1 : (Polynomial.eval₂RingHom φ y p) ⊗ₜ[R] ω =
              ((Polynomial.eval₂RingHom φ y p) ⊗ₜ[R] (1 : Ω)) * ((1 : B) ⊗ₜ[R] ω) := by
            rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
          rw [h1]
          refine Subring.mul_mem _ ?_ ?_
          · refine ⟨p.map ψ₀.hom, ?_⟩
            show Polynomial.eval₂ _ _ (p.map ψ₀.hom) = _
            rw [Polynomial.eval₂_map, hcomp, ← Polynomial.hom_eval₂]
            rfl
          · refine ⟨Polynomial.C ω, ?_⟩
            show Polynomial.eval₂ _ _ (Polynomial.C ω) = _
            rw [Polynomial.eval₂_C]
            rfl
        | add a b ha hb => exact Subring.add_mem _ ha hb
      exact hw
    calc ringKrullDim (TensorProduct R B Ω) ≤ ringKrullDim (Polynomial Ω) :=
          ringKrullDim_le_of_surjective Φ hΦ
      _ = ((1 : ℕ) : WithBot ℕ∞) := by
          rw [Polynomial.ringKrullDim_of_isNoetherianRing, ringKrullDim_eq_zero_of_field]
          rfl

  have hH : ∀ {S : Type u} [CommRing S] (g h : MvPolynomial (Fin 2) A →+* S) (s : S),
      (∀ r, g (MvPolynomial.C r) = h (MvPolynomial.C r)) →
      (∀ l, g (MvPolynomial.X l) = s * h (MvPolynomial.X l)) →
      ∀ (a : MvPolynomial (Fin 2) A) (k : ℕ), a.IsHomogeneous k → g a = s ^ k * h a := by
    intro S _ g h s hC hXs a k ha
    conv_lhs => rw [a.as_sum]
    conv_rhs => rw [a.as_sum]
    rw [map_sum, map_sum, Finset.mul_sum]
    refine Finset.sum_congr rfl fun d hd => ?_
    have hdeg := ha (MvPolynomial.mem_support_iff.mp hd)
    simp only [Finsupp.weight_apply, Finsupp.sum, smul_eq_mul, mul_one, Pi.one_apply] at hdeg
    rw [MvPolynomial.monomial_eq, map_mul, map_mul, hC, Finsupp.prod, map_prod, map_prod]
    simp only [map_pow, hXs, mul_pow]
    rw [Finset.prod_mul_distrib, Finset.prod_pow_eq_pow_sum, hdeg]
    ring
  have hX : ∀ l, (MvPolynomial.X l : MvPolynomial (Fin 2) A) ∈
      MvPolynomial.homogeneousSubmodule (Fin 2) A 1 := fun l =>
    (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X A l)

  have s2 : ∀ i : Fin 2, ∃ y : HomogeneousLocalization.Away
      (MvPolynomial.homogeneousSubmodule (Fin 2) A) (MvPolynomial.X i),
      Function.Surjective (Polynomial.eval₂RingHom (HomogeneousLocalization.fromZeroRingHom
        (MvPolynomial.homogeneousSubmodule (Fin 2) A) (Submonoid.powers (MvPolynomial.X i))) y) := by
    intro i
    let y : HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin 2) A)
        (MvPolynomial.X i) :=
      HomogeneousLocalization.Away.mk _ (hX i) 1 (MvPolynomial.X (i.succAbove 0))
        (by rw [one_smul]; exact hX _)
    refine ⟨y, ?_⟩
    let gv : Fin 2 → Polynomial (MvPolynomial.homogeneousSubmodule (Fin 2) A 0) :=
      Fin.insertNth (α := fun _ => Polynomial (MvPolynomial.homogeneousSubmodule (Fin 2) A 0)) i 1
        (fun _ => Polynomial.X)
    let cv : A →+* Polynomial (MvPolynomial.homogeneousSubmodule (Fin 2) A 0) :=
      Polynomial.C.comp (algebraMap A (MvPolynomial.homogeneousSubmodule (Fin 2) A 0))
    let ev : MvPolynomial (Fin 2) A →+* Polynomial (MvPolynomial.homogeneousSubmodule (Fin 2) A 0) :=
      MvPolynomial.eval₂Hom cv gv
    have hev_i : ev (MvPolynomial.X i) = 1 := by simp [ev, gv]
    have hev_s : ∀ j, ev (MvPolynomial.X (i.succAbove j)) = Polynomial.X := by simp [ev, gv]
    have hev_C : ∀ r, ev (MvPolynomial.C r) =
        Polynomial.C (algebraMap A (MvPolynomial.homogeneousSubmodule (Fin 2) A 0) r) := by
      simp [ev, cv]
    let φy := Polynomial.eval₂RingHom (HomogeneousLocalization.fromZeroRingHom
        (MvPolynomial.homogeneousSubmodule (Fin 2) A) (Submonoid.powers (MvPolynomial.X i))) y
    have hc : ∀ r, (HomogeneousLocalization.fromZeroRingHom
        (MvPolynomial.homogeneousSubmodule (Fin 2) A) (Submonoid.powers (MvPolynomial.X i))
        (algebraMap A (MvPolynomial.homogeneousSubmodule (Fin 2) A 0) r)).val =
        algebraMap (MvPolynomial (Fin 2) A) (Localization.Away
          (MvPolynomial.X i : MvPolynomial (Fin 2) A)) (MvPolynomial.C r) := by
      intro r
      rw [← Localization.mk_one_eq_algebraMap]
      rfl
    let θ := (algebraMap (HomogeneousLocalization.Away
        (MvPolynomial.homogeneousSubmodule (Fin 2) A) (MvPolynomial.X i))
        (Localization.Away (MvPolynomial.X i : MvPolynomial (Fin 2) A))).comp (φy.comp ev)
    have hθ : ∀ (k : ℕ) (a : MvPolynomial (Fin 2) A), a.IsHomogeneous k →
        algebraMap (MvPolynomial (Fin 2) A)
          (Localization.Away (MvPolynomial.X i : MvPolynomial (Fin 2) A)) a =
        (algebraMap (MvPolynomial (Fin 2) A)
          (Localization.Away (MvPolynomial.X i : MvPolynomial (Fin 2) A))
          (MvPolynomial.X i)) ^ k * θ a := by
      intro k a ha
      apply hH _ θ _ _ _ a k ha
      · intro r
        simp only [θ, RingHom.comp_apply, hev_C, φy, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
        rw [HomogeneousLocalization.algebraMap_apply, hc]
      · intro l
        rcases Fin.eq_self_or_eq_succAbove i l with rfl | ⟨j, rfl⟩
        · simp only [θ, RingHom.comp_apply, hev_i, map_one, mul_one]
        · have hj : j = 0 := Subsingleton.elim _ _
          subst hj
          simp only [θ, RingHom.comp_apply, hev_s, φy, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X]
          rw [HomogeneousLocalization.algebraMap_apply, HomogeneousLocalization.Away.val_mk,
            ← Localization.mk_one_eq_algebraMap, ← Localization.mk_one_eq_algebraMap,
            Localization.mk_mul, Localization.mk_eq_mk_iff, Localization.r_iff_exists]
          refine ⟨1, ?_⟩
          simp only [OneMemClass.coe_one, one_mul, pow_one]
          try ring
    intro z
    obtain ⟨k, a, ha, rfl⟩ := HomogeneousLocalization.Away.mk_surjective _ (hX i) z
    refine ⟨ev a, ?_⟩
    apply HomogeneousLocalization.val_injective
    rw [HomogeneousLocalization.Away.val_mk, Localization.mk_eq_mk',
      IsLocalization.eq_mk'_iff_mul_eq]
    have hh : a.IsHomogeneous k := by
      have := (MvPolynomial.mem_homogeneousSubmodule _ _).mp ha
      simpa using this
    rw [hθ k a hh, mul_comm]
    congr 1
    exact map_pow _ _ _

  have hcover : (⨆ i : Fin 2, Proj.basicOpen
      (MvPolynomial.homogeneousSubmodule (Fin 2) A) (MvPolynomial.X i)) = ⊤ := by
    apply Proj.iSup_basicOpen_eq_top _ (fun i => MvPolynomial.X i)
    intro a ha
    have ha' := (HomogeneousIdeal.mem_irrelevant_iff _ a).mp ha
    have h0 : MvPolynomial.homogeneousComponent 0 a = 0 := by
      rw [← MvPolynomial.decomposition.decompose'_apply]
      exact ha'
    rw [MvPolynomial.homogeneousComponent_zero, MvPolynomial.C_eq_zero] at h0
    rw [← Set.image_univ, MvPolynomial.mem_ideal_span_X_image]
    intro m hm
    have hm0 : m ≠ 0 := by
      rintro rfl
      exact (MvPolynomial.mem_support_iff.mp hm) h0
    obtain ⟨l, hl⟩ := Finsupp.ne_iff.mp hm0
    exact ⟨l, Set.mem_univ _, hl⟩

  refine s1 _ (Fin 2) (fun i => Set.range (Limits.pullback.snd
      (Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin 2) A) (MvPolynomial.X i) (hX i) one_pos)
      (Limits.pullback.fst (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin 2) A)) t)))
    (fun i => IsOpenImmersion.isOpen_range _) ?_ 1 ?_
  · intro x
    have hx : (Limits.pullback.fst (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin 2) A)) t) x ∈
        (⊤ : (Proj (MvPolynomial.homogeneousSubmodule (Fin 2) A)).Opens) := trivial
    rw [← hcover] at hx
    obtain ⟨i, hi⟩ := TopologicalSpace.Opens.mem_iSup.mp hx
    refine ⟨i, ?_⟩
    rw [Scheme.Pullback.range_snd, Set.mem_preimage, ← Scheme.Hom.coe_opensRange, Proj.opensRange_awayι]
    exact hi
  · intro i
    have e1 := IsHomeomorph.topologicalKrullDim_eq _
      (Scheme.Hom.isOpenEmbedding (Limits.pullback.snd
        (Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin 2) A) (MvPolynomial.X i) (hX i) one_pos)
        (Limits.pullback.fst (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin 2) A)) t))
        ).isEmbedding.toHomeomorph.isHomeomorph
    rw [← e1]
    have e2 := IsHomeomorph.topologicalKrullDim_eq _ (Scheme.homeoOfIso
      (Limits.pullbackRightPullbackFstIso (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin 2) A)) t
        (Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin 2) A) (MvPolynomial.X i) (hX i) one_pos))).isHomeomorph
    rw [e2]
    obtain ⟨y, hy⟩ := s2 i
    exact s3 _ _ _ y hy _ (Proj.awayι_toSpecZero _ _ (hX i) one_pos) t

theorem wc_proj_blowup_point : ∀ (K : Type u) [Field K] (n : ℕ),
    ∃ (p : ↥(wcProjK K (n + 1))) (P : Scheme.{u}) (σ : P ⟶ wcProjK K (n + 1)) (ρ : P ⟶ wcProjK K n),
      IsClosed ({p} : Set _) ∧ IsProper σ ∧ IsProper ρ ∧
      (∀ O : (wcProjK K (n + 1)).Opens, (O : Set _) = {p}ᶜ → IsIso (σ ∣_ O)) ∧
      topologicalKrullDim ↥(σ ⁻¹' {p}) ≤ (n : WithBot ℕ∞) ∧
      ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (t : Spec (.of Ω) ⟶ wcProjK K n),
        topologicalKrullDim ↥(Limits.pullback ρ t) ≤ ((1 : ℕ) : WithBot ℕ∞) :=
by
  intro K _ n
  obtain ⟨p, hpc, hp⟩ := wc_blowup_center K n
  obtain ⟨P, σ, ρ, hcomm, hiso, hinj, hloc⟩ := wc_blowup_charts K n

  have c5 : ∀ (X Y : Type u) [TopologicalSpace X] [TopologicalSpace Y] (f : X → Y) (S : Set X),
      Continuous f → IsClosedMap f → IsClosed S → Set.InjOn f S →
      topologicalKrullDim ↥S ≤ topologicalKrullDim Y := by
    intro X Y _ _ f S hf hfc hS hfi
    have hg : Topology.IsClosedEmbedding (fun x : S => f x.1) :=
      Topology.IsClosedEmbedding.of_continuous_injective_isClosedMap
        (hf.comp continuous_subtype_val)
        (fun a b hab => Subtype.ext (hfi a.2 b.2 hab))
        (hfc.comp hS.isClosedEmbedding_subtypeVal.isClosedMap)
    rw [IsHomeomorph.topologicalKrullDim_eq _ hg.isEmbedding.toHomeomorph.isHomeomorph]
    exact topologicalKrullDim_subspace_le _ _

  have c6 : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y) (O : Y.Opens) (ι : Type) (U : ι → Y.Opens),
      (⨆ i, U i) = O → (∀ i, IsIso (f ∣_ U i)) → IsIso (f ∣_ O) := by
    intro X Y f O ι U hU hf
    have hle : ∀ i, U i ≤ O := fun i => hU ▸ le_iSup U i
    have htop : (⨆ i, O.ι ⁻¹ᵁ U i) = ⊤ := by
      rw [eq_top_iff]
      intro x _
      have hx : O.ι x ∈ (O : Set Y) := by
        rw [← Scheme.Opens.range_ι]
        exact ⟨x, rfl⟩
      have hx' : O.ι x ∈ ((⨆ i, U i : Y.Opens) : Set Y) := by rw [hU]; exact hx
      obtain ⟨i, hi⟩ := TopologicalSpace.Opens.mem_iSup.mp hx'
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨i, hi⟩
    have key : MorphismProperty.isomorphisms Scheme (f ∣_ O) := by
      rw [IsZariskiLocalAtTarget.iff_of_iSup_eq_top
        (P := MorphismProperty.isomorphisms Scheme) _ htop]
      intro i
      rw [MorphismProperty.arrow_mk_iso_iff (MorphismProperty.isomorphisms Scheme)
        (morphismRestrictRestrict f O (O.ι ⁻¹ᵁ U i))]
      have he : O.ι ''ᵁ (O.ι ⁻¹ᵁ U i) = U i := by
        rw [Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι]
        exact inf_eq_right.mpr (hle i)
      rw [MorphismProperty.arrow_mk_iso_iff (MorphismProperty.isomorphisms Scheme)
        (morphismRestrictEq f he)]
      exact hf i
    exact key

  have c4 : ∀ (ι : Type) (U : ι → (wcProjK K n).Opens), (⨆ i, U i) = ⊤ →
      (∀ i, ∃ (A : Type u) (_ : CommRing A), Nonempty (Arrow.mk (ρ ∣_ U i) ≅
        Arrow.mk (@Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) A)
          MvPolynomial.gradedAlgebra))) →
      ∀ (Ω : Type u) [Field Ω] (t : Spec (.of Ω) ⟶ wcProjK K n),
        topologicalKrullDim ↥(Limits.pullback ρ t) ≤ ((1 : ℕ) : WithBot ℕ∞) := by
    intro ι U hU hl Ω _ t
    obtain ⟨x0⟩ : Nonempty (Spec (.of Ω)) := by
      change Nonempty (PrimeSpectrum Ω); infer_instance
    haveI hsub : Subsingleton (Spec (.of Ω)) := by
      change Subsingleton (PrimeSpectrum Ω); infer_instance
    have hx : t x0 ∈ (⨆ i, U i) := by rw [hU]; trivial
    obtain ⟨i, hi⟩ := TopologicalSpace.Opens.mem_iSup.mp hx
    have hrange : Set.range t ⊆ Set.range (U i).ι := by
      rw [Scheme.Opens.range_ι]
      rintro _ ⟨y, rfl⟩
      rw [Subsingleton.elim y x0]
      exact hi
    obtain ⟨t', ht'⟩ : ∃ t' : Spec (.of Ω) ⟶ (U i : Scheme.{u}), t' ≫ (U i).ι = t :=
      ⟨_, IsOpenImmersion.lift_fac _ _ hrange⟩
    subst ht'
    obtain ⟨A, _, ⟨e⟩⟩ := hl i
    have c1' : Limits.pullback.snd ρ (U i).ι ≫ 𝟙 _ =
        (pullbackRestrictIsoRestrict ρ (U i)).hom ≫ ρ ∣_ U i := by
      rw [Category.comp_id, pullbackRestrictIsoRestrict_hom_morphismRestrict]
    let m1 := Limits.pullback.map (Limits.pullback.snd ρ (U i).ι) t' (ρ ∣_ U i) t'
      (pullbackRestrictIsoRestrict ρ (U i)).hom (𝟙 _) (𝟙 _) c1' (by simp)
    haveI : IsIso m1 := Limits.pullback.map_isIso _ _ _ _ _ _ _ _ _
    haveI : IsIso e.hom.left := Arrow.isIso_left e.hom
    haveI : IsIso e.hom.right := Arrow.isIso_right e.hom
    have c2' : (ρ ∣_ U i) ≫ e.hom.right = e.hom.left ≫
        @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) A)
          MvPolynomial.gradedAlgebra := (Arrow.w e.hom).symm
    let m2 := Limits.pullback.map (ρ ∣_ U i) t'
      (@Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) A)
        MvPolynomial.gradedAlgebra) (t' ≫ e.hom.right) e.hom.left (𝟙 _) e.hom.right c2'
      (by simp)
    haveI : IsIso m2 := Limits.pullback.map_isIso _ _ _ _ _ _ _ _ _
    let I := (Limits.pullbackLeftPullbackSndIso ρ (U i).ι t').symm ≪≫ asIso m1 ≪≫ asIso m2
    rw [IsHomeomorph.topologicalKrullDim_eq _ (Scheme.homeoOfIso I).isHomeomorph]
    exact wc_P1_fibre_dim A Ω (t' ≫ e.hom.right)

  have hY : (⨆ j : Fin (n + 1), @Proj.basicOpen _ _ _ _ _
      (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) MvPolynomial.gradedAlgebra
      (MvPolynomial.X j)) = ⊤ := by
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) :=
      MvPolynomial.gradedAlgebra
    apply Proj.iSup_basicOpen_eq_top _ (fun i => MvPolynomial.X i)
    intro a ha
    have ha' := (HomogeneousIdeal.mem_irrelevant_iff _ a).mp ha
    have h0 : MvPolynomial.homogeneousComponent 0 a = 0 := by
      rw [← MvPolynomial.decomposition.decompose'_apply]
      exact ha'
    rw [MvPolynomial.homogeneousComponent_zero, MvPolynomial.C_eq_zero] at h0
    rw [← Set.image_univ, MvPolynomial.mem_ideal_span_X_image]
    intro m hm
    have hm0 : m ≠ 0 := by
      rintro rfl
      exact (MvPolynomial.mem_support_iff.mp hm) h0
    obtain ⟨l, hl⟩ := Finsupp.ne_iff.mp hm0
    exact ⟨l, Set.mem_univ _, hl⟩

  haveI hρ : IsProper ρ := by
    apply IsZariskiLocalAtTarget.of_iSup_eq_top (P := @IsProper) _ hY
    intro j
    obtain ⟨A, _, ⟨e⟩⟩ := hloc j
    letI := @MvPolynomial.gradedAlgebra (Fin 2) A _
    letI : IsScalarTower A ((MvPolynomial.homogeneousSubmodule (Fin 2) A) 0)
        (MvPolynomial (Fin 2) A) :=
      IsScalarTower.of_algebraMap_eq (R := A)
        (S := (MvPolynomial.homogeneousSubmodule (Fin 2) A) 0)
        (A := MvPolynomial (Fin 2) A) (fun r => rfl)
    haveI : Algebra.FiniteType ((MvPolynomial.homogeneousSubmodule (Fin 2) A) 0)
        (MvPolynomial (Fin 2) A) :=
      Algebra.FiniteType.of_restrictScalars_finiteType A _ _
    haveI h0 : IsProper (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin 2) A)) :=
      inferInstance
    exact (MorphismProperty.arrow_mk_iso_iff (@IsProper) e).mpr h0

  haveI := wc_proj_space_isProper K n
  haveI := wc_proj_space_isProper K (n + 1)
  haveI : IsProper (σ ≫ wcProjKStr K (n + 1)) := by rw [hcomm]; infer_instance
  haveI hσ : IsProper σ := IsProper.of_comp σ (wcProjKStr K (n + 1))

  have hO : ∀ O : (wcProjK K (n + 1)).Opens, (O : Set _) = {p}ᶜ → IsIso (σ ∣_ O) := by
    intro O hO
    refine c6 σ O (Fin (n + 1)) (fun j => @Proj.basicOpen _ _ _ _ _
      (MvPolynomial.homogeneousSubmodule (Fin (n + 1 + 1)) K) MvPolynomial.gradedAlgebra
      (MvPolynomial.X (Fin.castSucc j))) ?_ hiso
    apply TopologicalSpace.Opens.ext
    rw [hO, TopologicalSpace.Opens.coe_iSup]
    exact Set.ext fun x => Set.mem_iUnion.trans (hp x).symm

  have hE : topologicalKrullDim ↥(σ ⁻¹' {p}) ≤ (n : WithBot ℕ∞) := by
    rw [← wc_proj_space_dim K n]
    refine c5 P (wcProjK K n) ρ (σ ⁻¹' {p}) ρ.continuous ρ.isClosedMap
      (hpc.preimage σ.continuous) ?_
    intro a ha b hb hab
    have hna : ∀ j : Fin (n + 1), σ a ∉ @Proj.basicOpen _ _ _ _ _
        (MvPolynomial.homogeneousSubmodule (Fin (n + 1 + 1)) K) MvPolynomial.gradedAlgebra
        (MvPolynomial.X (Fin.castSucc j)) := fun j hj => ((hp (σ a)).mpr ⟨j, hj⟩) ha
    have hnb : ∀ j : Fin (n + 1), σ b ∉ @Proj.basicOpen _ _ _ _ _
        (MvPolynomial.homogeneousSubmodule (Fin (n + 1 + 1)) K) MvPolynomial.gradedAlgebra
        (MvPolynomial.X (Fin.castSucc j)) := fun j hj => ((hp (σ b)).mpr ⟨j, hj⟩) hb
    exact hinj a b hna hnb hab
  exact ⟨p, P, σ, ρ, hpc, hσ, hρ, hO, hE, fun Ω _ _ t =>
    c4 (Fin (n + 1)) (fun j => @Proj.basicOpen _ _ _ _ _
      (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) MvPolynomial.gradedAlgebra
      (MvPolynomial.X j)) hY hloc Ω t⟩

theorem wc_integral_preimage_dim_le : ∀ (X Y : Scheme.{u}) (f : X ⟶ Y) [IsIntegralHom f] (S : Set Y),
    IsClosed S → topologicalKrullDim ↥(f ⁻¹' S) ≤ topologicalKrullDim ↥S :=
by
  intro X Y f _ S hS

  have incomp : ∀ x x' : X, x ⤳ x' → f x = f x' → x = x' := by
    intro x x' hxx' hfx
    obtain ⟨V, hV, hyV, -⟩ := exists_isAffineOpen_mem_and_subset (X := Y) (x := f x') (U := ⊤) trivial
    have hU : IsAffineOpen (f ⁻¹ᵁ V) := hV.preimage f
    have hx'U : x' ∈ f ⁻¹ᵁ V := hyV
    have hxU : x ∈ f ⁻¹ᵁ V := hxx'.mem_open (f ⁻¹ᵁ V).isOpen hx'U
    have hcomm := IsAffineOpen.SpecMap_appLE_fromSpec f hV hU le_rfl
    have hpt : ∀ p, f (hU.fromSpec p) = hV.fromSpec (Spec.map (f.appLE V (f ⁻¹ᵁ V) le_rfl) p) := by
      intro p
      have := congrArg (fun g => g p) hcomm
      simp only [Scheme.Hom.comp_apply] at this
      exact this.symm
    obtain ⟨p, hp⟩ : x ∈ Set.range hU.fromSpec := by rw [hU.range_fromSpec]; exact hxU
    obtain ⟨p', hp'⟩ : x' ∈ Set.range hU.fromSpec := by rw [hU.range_fromSpec]; exact hx'U
    have hpp' : p ⤳ p' := by
      rw [← hU.fromSpec.isOpenEmbedding.isInducing.specializes_iff, hp, hp']; exact hxx'
    have hle : p.asIdeal ≤ p'.asIdeal := (PrimeSpectrum.le_iff_specializes p p').mpr hpp'
    have heq : Spec.map (f.appLE V (f ⁻¹ᵁ V) le_rfl) p =
        Spec.map (f.appLE V (f ⁻¹ᵁ V) le_rfl) p' := by
      apply hV.fromSpec.isOpenEmbedding.injective
      rw [← hpt, ← hpt, hp, hp', hfx]
    rw [Spec.map_apply, Spec.map_apply] at heq
    have heqI : Ideal.comap (f.appLE V (f ⁻¹ᵁ V) le_rfl).hom p.asIdeal =
        Ideal.comap (f.appLE V (f ⁻¹ᵁ V) le_rfl).hom p'.asIdeal :=
      congrArg PrimeSpectrum.asIdeal heq
    have hint : (f.appLE V (f ⁻¹ᵁ V) le_rfl).hom.IsIntegral := by
      rw [Scheme.Hom.appLE_eq_app]
      exact IsIntegralHom.isIntegral_app f V hV
    suffices hpe : p = p' by rw [← hp, ← hp', hpe]
    by_contra hne
    have hlt : p.asIdeal < p'.asIdeal := lt_of_le_of_ne hle (fun h => hne (PrimeSpectrum.ext h))
    letI := (f.appLE V (f ⁻¹ᵁ V) le_rfl).hom.toAlgebra
    haveI : Algebra.IsIntegral Γ(Y, V) Γ(X, f ⁻¹ᵁ V) := ⟨hint⟩
    haveI := p.isPrime
    have := Ideal.IsIntegral.under_lt_under (R := Γ(Y, V)) hlt
    rw [Ideal.under_def, Ideal.under_def] at this
    exact this.ne heqI

  have s3 : ∀ (A B : Type u) [TopologicalSpace A] [TopologicalSpace B] [QuasiSober A] (g : A → B),
      Continuous g → IsClosedMap g → (∀ a a' : A, a ⤳ a' → g a = g a' → a = a') →
      topologicalKrullDim A ≤ topologicalKrullDim B := by
    intro A B _ _ _ g hg hcl hinc
    let Φ : TopologicalSpace.IrreducibleCloseds A → TopologicalSpace.IrreducibleCloseds B :=
      fun Z => ⟨g '' Z, Z.isIrreducible.image g hg.continuousOn, hcl _ Z.isClosed⟩
    have hΦ : StrictMono Φ := by
      intro Z Z' hZZ'
      have hsub : (Z : Set A) ⊆ Z' := hZZ'.le
      refine lt_of_le_of_ne (show (Φ Z : Set B) ⊆ Φ Z' from Set.image_mono hsub) ?_
      intro hEq
      have hEq' : g '' (Z : Set A) = g '' (Z' : Set A) :=
        congrArg (fun W : TopologicalSpace.IrreducibleCloseds B => (W : Set B)) hEq
      obtain ⟨η, hη⟩ := QuasiSober.sober Z'.isIrreducible Z'.isClosed
      have hηmem : η ∈ (Z' : Set A) := hη.mem
      obtain ⟨z, hz, hgz⟩ : g η ∈ g '' (Z : Set A) := by rw [hEq']; exact ⟨η, hηmem, rfl⟩
      have hspec : η ⤳ z := hη.specializes (hsub hz)
      have hηz : η = z := hinc η z hspec hgz.symm
      have hZ'Z : (Z' : Set A) ⊆ Z := by
        calc (Z' : Set A) = closure {η} := hη.def.symm
          _ ⊆ Z := closure_minimal (Set.singleton_subset_iff.mpr (hηz ▸ hz)) Z.isClosed
      exact hZZ'.not_ge hZ'Z
    exact Order.krullDim_le_of_strictMono Φ hΦ

  have hAc : IsClosed (f ⁻¹' S) := hS.preimage f.continuous
  haveI : QuasiSober ↥(f ⁻¹' S) := hAc.isClosedEmbedding_subtypeVal.quasiSober
  refine s3 _ _ (S.restrictPreimage f) (f.continuous.restrictPreimage (s := S))
    (f.isClosedMap.restrictPreimage S) ?_
  intro a a' haa' hga
  apply Subtype.ext
  apply incomp _ _ (Topology.IsInducing.subtypeVal.specializes_iff.mpr haa')
  have := congrArg Subtype.val hga
  simpa [Set.restrictPreimage_coe] using this

theorem wc_iso_over_open_inj_dim : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y) (V : Y.Opens), IsIso (f ∣_ V) →
    (∀ x₁ x₂ : X, f x₁ ∈ (V : Set Y) → f x₁ = f x₂ → x₁ = x₂) ∧
    ∀ A : Set Y, A ⊆ (V : Set Y) → topologicalKrullDim ↥(f ⁻¹' A) = topologicalKrullDim ↥A :=
by
  intro X Y f V hiso
  have := hiso
  obtain ⟨H, hHdef⟩ : ∃ H : ↥(f ⁻¹ᵁ V).toScheme ≃ₜ ↥V.toScheme, H = (f ∣_ V).homeomorph :=
    ⟨_, rfl⟩
  have hH : ∀ p, V.ι (H p) = f ((f ⁻¹ᵁ V).ι p) := by
    intro p
    rw [hHdef]
    simp only [Scheme.Hom.homeomorph_apply]
    exact morphismRestrict_base_coe f V p
  have hVinj : Function.Injective V.ι := V.ι.isOpenEmbedding.injective
  refine ⟨?_, ?_⟩
  · intro x₁ x₂ h₁ h₂
    have h₁' : x₁ ∈ f ⁻¹ᵁ V := (Scheme.Hom.mem_preimage f).mpr h₁
    have h₂' : x₂ ∈ f ⁻¹ᵁ V := (Scheme.Hom.mem_preimage f).mpr (h₂ ▸ h₁)
    let p₁ : ↥(f ⁻¹ᵁ V).toScheme := ⟨x₁, h₁'⟩
    let p₂ : ↥(f ⁻¹ᵁ V).toScheme := ⟨x₂, h₂'⟩
    have hp₁ : (f ⁻¹ᵁ V).ι p₁ = x₁ := rfl
    have hp₂ : (f ⁻¹ᵁ V).ι p₂ = x₂ := rfl
    have e : H p₁ = H p₂ := by
      apply hVinj
      rw [hH, hH, hp₁, hp₂]
      exact h₂
    rw [← hp₁, ← hp₂, H.injective e]
  · intro A hA
    let ψ : ↥(f ⁻¹' A) → ↥(f ⁻¹ᵁ V).toScheme :=
      fun x => ⟨x.1, (Scheme.Hom.mem_preimage f).mpr (hA x.2)⟩
    have hιψ : ((f ⁻¹ᵁ V).ι : ↥(f ⁻¹ᵁ V).toScheme → X) ∘ ψ = Subtype.val :=
      funext fun x => rfl
    have hψc : Continuous ψ := by
      rw [(f ⁻¹ᵁ V).ι.isOpenEmbedding.isInducing.continuous_iff, hιψ]
      exact continuous_subtype_val
    have hψe : Topology.IsEmbedding ψ :=
      Topology.IsEmbedding.of_comp hψc (f ⁻¹ᵁ V).ι.continuous
        (by rw [hιψ]; exact Topology.IsEmbedding.subtypeVal)
    let e : ↥(f ⁻¹' A) → Y := fun x => f x.1
    have heq : e = (V.ι : ↥V.toScheme → Y) ∘ H ∘ ψ := by
      funext x
      show f x.1 = V.ι (H (ψ x))
      rw [hH]
      rfl
    have he : Topology.IsEmbedding e := by
      rw [heq]
      exact V.ι.isOpenEmbedding.isEmbedding.comp (H.isEmbedding.comp hψe)
    have hrange : Set.range e = A := by
      ext a
      constructor
      · rintro ⟨x, rfl⟩
        exact x.2
      · intro ha
        obtain ⟨p, hp⟩ := H.surjective ⟨a, hA ha⟩
        have hfa : f ((f ⁻¹ᵁ V).ι p) = a := by
          rw [← hH, hp]
          rfl
        refine ⟨⟨(f ⁻¹ᵁ V).ι p, ?_⟩, hfa⟩
        show f _ ∈ A
        rw [hfa]
        exact ha
    rw [IsHomeomorph.topologicalKrullDim_eq _ he.toHomeomorph.isHomeomorph]
    exact IsHomeomorph.topologicalKrullDim_eq _ (Homeomorph.setCongr hrange).isHomeomorph

theorem wc_isIso_restrict_mono : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y) (U V : Y.Opens), IsIso (f ∣_ U) →
    V ≤ U → IsIso (f ∣_ V) :=
by
  intro X Y f U V hU hVU
  have h3 : U.ι ''ᵁ (U.ι ⁻¹ᵁ V) = V := by
    rw [Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι,
      inf_eq_right.mpr hVU]
  have s1 : IsIso ((f ∣_ U) ∣_ (U.ι ⁻¹ᵁ V)) := inferInstance
  let e := morphismRestrictRestrict f U (U.ι ⁻¹ᵁ V) ≪≫ morphismRestrictEq f h3
  exact (MorphismProperty.isomorphisms.iff _).mp
    (((MorphismProperty.isomorphisms Scheme).arrow_mk_iso_iff e).mp
      ((MorphismProperty.isomorphisms.iff _).mpr s1))

theorem wc_isIso_restrict_pullback_fst : ∀ {X Y S : Scheme.{u}} (h : X ⟶ S) (σ : Y ⟶ S) (O : S.Opens),
    IsIso (σ ∣_ O) → IsIso ((Limits.pullback.fst h σ) ∣_ (h ⁻¹ᵁ O)) :=
by
  intro X Y S h σ O hσ
  have sq : IsPullback (Limits.pullback.fst h σ) (Limits.pullback.snd h σ) h σ :=
    IsPullback.of_hasPullback h σ
  have hpre : Limits.pullback.fst h σ ⁻¹ᵁ (h ⁻¹ᵁ O) =
      Limits.pullback.snd h σ ⁻¹ᵁ (σ ⁻¹ᵁ O) := by
    rw [← Scheme.Hom.comp_preimage, ← Scheme.Hom.comp_preimage, Limits.pullback.condition]
  have hUY : Limits.pullback.fst h σ ⁻¹ᵁ (h ⁻¹ᵁ O) =
      Limits.pullback.fst h σ ⁻¹ᵁ (h ⁻¹ᵁ O) ⊓ Limits.pullback.snd h σ ⁻¹ᵁ (σ ⁻¹ᵁ O) := by
    rw [← hpre, inf_idem]
  have sq' := Scheme.Hom.isPullback_resLE sq (US := O) (UT := σ ⁻¹ᵁ O) (UX := h ⁻¹ᵁ O)
    le_rfl le_rfl hUY
  simp only [Scheme.Hom.resLE_eq_morphismRestrict] at sq'
  exact sq'.isIso_fst_of_isIso

theorem wc_dim_union_closed_le : ∀ (X : Type u) [TopologicalSpace X] (A B : Set X) (n : ℕ),
    IsClosed A → IsClosed B → topologicalKrullDim ↥A ≤ (n : WithBot ℕ∞) →
    topologicalKrullDim ↥B ≤ (n : WithBot ℕ∞) → topologicalKrullDim ↥(A ∪ B) ≤ (n : WithBot ℕ∞) :=
by
  intro X _ A B n hAc hBc hA hB
  have key : ∀ (S T : Set X) (h : S ⊆ T) (Z : TopologicalSpace.IrreducibleCloseds ↥T),
      (∀ z ∈ (Z : Set ↥T), (z : X) ∈ S) →
      Order.krullDim ↑(Set.Iic Z) ≤ topologicalKrullDim ↥S := by
    intro S T h Z hZ
    have hlift : ∀ P : Set ↥T, (∀ p ∈ P, (p : X) ∈ S) →
        Set.inclusion h '' (Set.inclusion h ⁻¹' P) = P := by
      intro P hP
      apply Set.image_preimage_eq_of_subset
      intro p hp
      exact ⟨⟨p.1, hP p hp⟩, rfl⟩
    have hirr : ∀ W : Set ↥T, IsIrreducible W → (∀ w ∈ W, (w : X) ∈ S) →
        IsIrreducible (Set.inclusion h ⁻¹' W) := by
      intro W hW hWS
      refine ⟨?_, ?_⟩
      · obtain ⟨w, hw⟩ := hW.nonempty
        exact ⟨⟨w.1, hWS w hw⟩, hw⟩
      · rw [isPreirreducible_iff_isClosed_union_isClosed]
        intro z₁ z₂ hz₁ hz₂ hsub
        have hind := (Topology.IsEmbedding.inclusion h).isInducing
        obtain ⟨c₁, hc₁, rfl⟩ := hind.isClosed_iff.mp hz₁
        obtain ⟨c₂, hc₂, rfl⟩ := hind.isClosed_iff.mp hz₂
        have hW' : W ⊆ c₁ ∪ c₂ := by
          intro w hw
          have hmem : (⟨w.1, hWS w hw⟩ : ↥S) ∈ Set.inclusion h ⁻¹' W := hw
          exact hsub hmem
        rcases (isPreirreducible_iff_isClosed_union_isClosed.mp hW.isPreirreducible)
            c₁ c₂ hc₁ hc₂ hW' with h1 | h1
        · left; exact Set.preimage_mono h1
        · right; exact Set.preimage_mono h1
    have hsubZ : ∀ W : ↑(Set.Iic Z), (W.1 : Set ↥T) ⊆ (Z : Set ↥T) := fun W =>
      SetLike.coe_subset_coe.mpr W.2
    let Φ : ↑(Set.Iic Z) → TopologicalSpace.IrreducibleCloseds ↥S := fun W =>
      ⟨Set.inclusion h ⁻¹' (W.1 : Set ↥T),
        hirr _ W.1.isIrreducible (fun w hw => hZ w (hsubZ W hw)),
        W.1.isClosed.preimage (continuous_inclusion h)⟩
    have hmono : Monotone Φ := by
      intro W W' hle
      have hle' : (W.1 : Set ↥T) ⊆ (W'.1 : Set ↥T) := SetLike.coe_subset_coe.mpr hle
      exact SetLike.coe_subset_coe.mp (Set.preimage_mono hle' : Set.inclusion h ⁻¹' (W.1 : Set ↥T) ⊆
        Set.inclusion h ⁻¹' (W'.1 : Set ↥T))
    have hinj : Function.Injective Φ := by
      intro W W' hWW
      have e1 : Set.inclusion h ⁻¹' (W.1 : Set ↥T) = Set.inclusion h ⁻¹' (W'.1 : Set ↥T) :=
        congrArg (fun V : TopologicalSpace.IrreducibleCloseds ↥S => (V : Set ↥S)) hWW
      have e2 : (W.1 : Set ↥T) = (W'.1 : Set ↥T) := by
        calc (W.1 : Set ↥T) = Set.inclusion h '' (Set.inclusion h ⁻¹' (W.1 : Set ↥T)) :=
              (hlift _ (fun w hw => hZ w (hsubZ W hw))).symm
          _ = Set.inclusion h '' (Set.inclusion h ⁻¹' (W'.1 : Set ↥T)) := by rw [e1]
          _ = (W'.1 : Set ↥T) := hlift _ (fun w hw => hZ w (hsubZ W' hw))
      exact Subtype.ext (TopologicalSpace.IrreducibleCloseds.ext e2)
    exact Order.krullDim_le_of_strictMono Φ (hmono.strictMono_of_injective hinj)
  have hU : topologicalKrullDim ↥(A ∪ B) =
      Order.krullDim (TopologicalSpace.IrreducibleCloseds ↥(A ∪ B)) := rfl
  rw [hU, Order.krullDim_eq_iSup_height]
  refine iSup_le (fun Z => ?_)
  rw [Order.height_eq_krullDim_Iic]
  have himg : IsIrreducible (Subtype.val '' (Z : Set ↥(A ∪ B))) :=
    Z.isIrreducible.image _ continuous_subtype_val.continuousOn
  have hcov : Subtype.val '' (Z : Set ↥(A ∪ B)) ⊆ A ∪ B := by
    rintro _ ⟨z, _, rfl⟩
    exact z.2
  rcases (isPreirreducible_iff_isClosed_union_isClosed.mp himg.isPreirreducible)
      A B hAc hBc hcov with hZA | hZB
  · exact (key A (A ∪ B) Set.subset_union_left Z
      (fun z hz => hZA (Set.mem_image_of_mem _ hz))).trans hA
  · exact (key B (A ∪ B) Set.subset_union_right Z
      (fun z hz => hZB (Set.mem_image_of_mem _ hz))).trans hB

theorem wc_proper_curve_fibration_cover : ∀ (K : Type u) [Field K] [IsAlgClosed K] (Y : Scheme.{u})
    (f : Y ⟶ Spec (.of K)) [IsProper f] (n : ℕ),
    topologicalKrullDim Y ≤ ((n + 1 : ℕ) : WithBot ℕ∞) →
    ∃ (X' : Scheme.{u}) (b : X' ⟶ Y) (Z : Scheme.{u}) (iZ : Z ⟶ Y) (B : Scheme.{u})
      (fB : B ⟶ Spec (.of K)) (g : X' ⟶ B),
      IsProper b ∧ IsClosedImmersion iZ ∧ IsProper fB ∧ IsProper g ∧
      (∀ U : Y.Opens, (U : Set Y) = (Set.range iZ)ᶜ → IsIso (b ∣_ U)) ∧
      topologicalKrullDim B ≤ (n : WithBot ℕ∞) ∧
      topologicalKrullDim Z ≤ (n : WithBot ℕ∞) ∧
      topologicalKrullDim ↥(Limits.pullback b iZ) ≤ (n : WithBot ℕ∞) ∧
      ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (t : Spec (.of Ω) ⟶ B),
        topologicalKrullDim ↥(Limits.pullback g t) ≤ ((1 : ℕ) : WithBot ℕ∞) :=
by
  intro K _ _ Y f _ n hY

  have dmono : ∀ {X : Type u} [TopologicalSpace X] (A B : Set X), A ⊆ B →
      topologicalKrullDim ↥A ≤ topologicalKrullDim ↥B := by
    intro X _ A B hAB
    rw [IsHomeomorph.topologicalKrullDim_eq _
      (Topology.IsEmbedding.inclusion hAB).toHomeomorph.isHomeomorph]
    exact topologicalKrullDim_subspace_le _ _
  have dsub : ∀ {X : Type u} [TopologicalSpace X] (A : Set X), A.Subsingleton →
      topologicalKrullDim ↥A ≤ 0 := by
    intro X _ A hA
    haveI : Subsingleton ↥A := hA.coe_sort
    haveI : Subsingleton (TopologicalSpace.IrreducibleCloseds ↥A) := ⟨fun s t => by
      ext x
      obtain ⟨y, hy⟩ := s.isIrreducible.nonempty
      obtain ⟨z, hz⟩ := t.isIrreducible.nonempty
      constructor
      · intro _
        rw [Subsingleton.elim x z]
        exact hz
      · intro _
        rw [Subsingleton.elim x y]
        exact hy⟩
    exact Order.krullDim_nonpos_of_subsingleton
  have duniv : ∀ (X : Type u) [TopologicalSpace X],
      topologicalKrullDim ↥(Set.univ : Set X) = topologicalKrullDim X := fun X _ =>
    IsHomeomorph.topologicalKrullDim_eq _ (Homeomorph.Set.univ X).isHomeomorph
  have demb : ∀ {A B : Type u} [TopologicalSpace A] [TopologicalSpace B] {e : A → B},
      Topology.IsEmbedding e → topologicalKrullDim A = topologicalKrullDim ↥(Set.range e) :=
    fun he => IsHomeomorph.topologicalKrullDim_eq _ he.toHomeomorph.isHomeomorph
  have noeth : ∀ (X : Scheme.{u}) (q : X ⟶ Spec (.of K)) [IsProper q],
      TopologicalSpace.NoetherianSpace X := by
    intro X q _
    haveI := QuasiCompact.compactSpace_of_compactSpace q
    haveI := LocallyOfFiniteType.isLocallyNoetherian q
    haveI : IsNoetherian X := ⟨⟩
    infer_instance
  haveI := noeth Y f

  obtain ⟨N, Y', π, j, V, hπ, hj, hVd, hπVd, hπV⟩ := wc_chow_projective_cover K Y f
  haveI := hπ
  haveI := hj
  haveI := noeth Y' (π ≫ f)
  have hY'dim : topologicalKrullDim Y' ≤ ((n + 1 : ℕ) : WithBot ℕ∞) := by
    have h1 := wc_dim_le_dim_dense_open_part K Y' (π ≫ f) Set.univ (π ⁻¹' (V : Set Y))
      isClosed_univ (V.isOpen.preimage π.continuous)
      (by simp only [Set.univ_inter, hπVd.closure_eq, Set.subset_univ])
    rw [Set.univ_inter] at h1
    have h2 := (wc_iso_over_open_inj_dim π V hπV).2 (V : Set Y) subset_rfl
    calc topologicalKrullDim Y' = topologicalKrullDim ↥(Set.univ : Set Y') := (duniv _).symm
      _ ≤ topologicalKrullDim ↥(π ⁻¹' (V : Set Y)) := h1
      _ = topologicalKrullDim ↥(V : Set Y) := h2
      _ ≤ topologicalKrullDim ↥(Set.univ : Set Y) := dmono _ _ (Set.subset_univ _)
      _ = topologicalKrullDim Y := duniv _
      _ ≤ _ := hY

  have hfin : ∃ h : Y' ⟶ wcProjK K (n + 1), IsFinite h := by
    rcases le_total N (n + 1) with hN | hN
    · obtain ⟨ι, hι⟩ := wc_proj_linear_closed_embedding K N (n + 1) hN
      haveI := hι
      exact ⟨j ≫ ι, inferInstance⟩
    · obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le hN
      have claim : ∀ m : ℕ, ∀ h₀ : Y' ⟶ wcProjK K (n + 1 + m), IsFinite h₀ →
          ∃ h : Y' ⟶ wcProjK K (n + 1), IsFinite h := by
        intro m
        induction m with
        | zero => intro h₀ hh₀; exact ⟨h₀, hh₀⟩
        | succ m ih =>
          intro h₀ hh₀
          haveI := hh₀
          have hne : Set.range h₀ ≠ Set.univ := by
            intro hr
            have h1 := wc_dim_range_closed_map_le _ _ (⇑h₀) h₀.continuous h₀.isClosedMap
            rw [hr, duniv, wc_proj_space_dim] at h1
            have h2 := h1.trans hY'dim
            have h3 : n + 1 + (m + 1) ≤ n + 1 := by exact_mod_cast h2
            omega
          obtain ⟨h₁, hh₁⟩ := wc_finite_projection_step K (n + 1 + m) Y' h₀ hh₀ hne
          exact ih h₁ hh₁
      exact claim k j inferInstance
  obtain ⟨h, hh⟩ := hfin
  haveI := hh

  obtain ⟨p, P, σ, ρ, hp, hσ, hρ, hσiso, hσp, hfib⟩ := wc_proj_blowup_point K n
  haveI := hσ
  haveI := hρ
  haveI := wc_proj_space_isProper K n
  obtain ⟨O, hO⟩ : ∃ O : (wcProjK K (n + 1)).Opens, (O : Set _) = {p}ᶜ :=
    ⟨⟨{p}ᶜ, hp.isOpen_compl⟩, rfl⟩

  have hHc : IsClosed (h ⁻¹' {p}) := hp.preimage h.continuous
  have hQc : IsClosed (π '' (h ⁻¹' {p})) := π.isClosedMap _ hHc
  have hT : IsClosed ((V : Set Y)ᶜ ∪ π '' (h ⁻¹' {p})) := V.isOpen.isClosed_compl.union hQc
  obtain ⟨Z, iZ, hiZ, hrange⟩ : ∃ (Z : Scheme.{u}) (iZ : Z ⟶ Y), IsClosedImmersion iZ ∧
      Set.range iZ = ((V : Set Y)ᶜ ∪ π '' (h ⁻¹' {p})) :=
    ⟨_, (Scheme.IdealSheafData.vanishingIdeal ⟨_, hT⟩).subschemeι, inferInstance,
      (Scheme.IdealSheafData.range_subschemeι _).trans
        (Scheme.IdealSheafData.coe_support_vanishingIdeal _)⟩
  haveI := hiZ
  have hZdim : topologicalKrullDim Z ≤ (n : WithBot ℕ∞) := by
    rw [demb iZ.isClosedEmbedding.isEmbedding, hrange]
    apply wc_dim_union_closed_le _ _ _ n V.isOpen.isClosed_compl hQc
    · exact wc_closed_dense_compl_dim_drop Y (V : Set Y)ᶜ n V.isOpen.isClosed_compl
        (by rw [compl_compl]; exact hVd) hY
    · calc topologicalKrullDim ↥(π '' (h ⁻¹' {p}))
          = topologicalKrullDim ↥(Set.range (fun x : ↥(h ⁻¹' {p}) => π x.1)) := by
            rw [Set.image_eq_range]
        _ ≤ topologicalKrullDim ↥(h ⁻¹' {p}) :=
            wc_dim_range_closed_map_le _ _ _ (π.continuous.comp continuous_subtype_val)
              (π.isClosedMap.comp hHc.isClosedEmbedding_subtypeVal.isClosedMap)
        _ ≤ topologicalKrullDim ↥({p} : Set ↥(wcProjK K (n + 1))) :=
            wc_integral_preimage_dim_le _ _ h _ hp
        _ ≤ 0 := dsub _ Set.subsingleton_singleton
        _ ≤ (n : WithBot ℕ∞) := by exact_mod_cast Nat.zero_le n

  have hiso : ∀ U : Y.Opens, (U : Set Y) = (Set.range iZ)ᶜ →
      IsIso ((Limits.pullback.fst h σ ≫ π) ∣_ U) := by
    intro U hU
    rw [hrange] at hU
    have hUV : U ≤ V := by
      intro y hy
      have hy' : y ∈ (U : Set Y) := hy
      rw [hU] at hy'
      by_contra hyV
      exact hy' (Or.inl hyV)
    have hUO : π ⁻¹ᵁ U ≤ h ⁻¹ᵁ O := by
      intro y hy
      have hy' : π y ∈ (U : Set Y) := hy
      rw [hU] at hy'
      show h y ∈ (O : Set _)
      rw [hO, Set.mem_compl_iff, Set.mem_singleton_iff]
      intro hyp
      exact hy' (Or.inr ⟨y, hyp, rfl⟩)
    rw [morphismRestrict_comp]
    have i1 := wc_isIso_restrict_mono π V U hπV hUV
    have i2 := wc_isIso_restrict_mono (Limits.pullback.fst h σ) (h ⁻¹ᵁ O) (π ⁻¹ᵁ U)
      (wc_isIso_restrict_pullback_fst h σ O (hσiso O hO)) hUO
    exact IsIso.comp_isIso' i2 i1

  have hE : topologicalKrullDim ↥(Limits.pullback (Limits.pullback.fst h σ ≫ π) iZ) ≤
      (n : WithBot ℕ∞) := by
    rw [demb (Limits.pullback.fst (Limits.pullback.fst h σ ≫ π) iZ).isClosedEmbedding.isEmbedding,
      Scheme.Pullback.range_fst, hrange]
    have hDc : IsClosed (π ⁻¹' (V : Set Y))ᶜ := (V.isOpen.preimage π.continuous).isClosed_compl
    have hA_c : IsClosed (Limits.pullback.fst h σ ⁻¹' (π ⁻¹' (V : Set Y))ᶜ) :=
      hDc.preimage (Limits.pullback.fst h σ).continuous
    have hG_c : IsClosed (Limits.pullback.fst h σ ⁻¹' (h ⁻¹' {p})) :=
      hHc.preimage (Limits.pullback.fst h σ).continuous

    have hsub : (Limits.pullback.fst h σ ≫ π) ⁻¹' ((V : Set Y)ᶜ ∪ π '' (h ⁻¹' {p})) ⊆
        Limits.pullback.fst h σ ⁻¹' (π ⁻¹' (V : Set Y))ᶜ ∪
          Limits.pullback.fst h σ ⁻¹' (h ⁻¹' {p}) := by
      intro x hx
      rw [Set.mem_preimage, Scheme.Hom.comp_apply] at hx
      by_cases hV : π (Limits.pullback.fst h σ x) ∈ (V : Set Y)
      · right
        rcases hx with hx | hx
        · exact absurd hV hx
        · obtain ⟨z, hz, hzx⟩ := hx
          have hxz := (wc_iso_over_open_inj_dim π V hπV).1 (Limits.pullback.fst h σ x) z hV hzx.symm
          show h (Limits.pullback.fst h σ x) ∈ ({p} : Set _)
          rw [hxz]
          exact hz
      · left
        exact hV

    have hc : ∀ x, h (Limits.pullback.fst h σ x) = σ (Limits.pullback.snd h σ x) := fun x => by
      have := congrArg (fun φ : Limits.pullback h σ ⟶ wcProjK K (n + 1) => φ x)
        (Limits.pullback.condition (f := h) (g := σ))
      simpa only [Scheme.Hom.comp_apply] using this
    have hGeq : Limits.pullback.fst h σ ⁻¹' (h ⁻¹' {p}) =
        Limits.pullback.snd h σ ⁻¹' (σ ⁻¹' {p}) := by
      ext x
      exact iff_of_eq (congrArg (· ∈ ({p} : Set _)) (hc x))
    have hGdim : topologicalKrullDim ↥(Limits.pullback.fst h σ ⁻¹' (h ⁻¹' {p})) ≤
        (n : WithBot ℕ∞) := by
      rw [hGeq]
      exact (wc_integral_preimage_dim_le _ _ (Limits.pullback.snd h σ) _
        (hp.preimage σ.continuous)).trans hσp

    have hDdim : topologicalKrullDim ↥(π ⁻¹' (V : Set Y))ᶜ ≤ (n : WithBot ℕ∞) :=
      wc_closed_dense_compl_dim_drop Y' _ n hDc (by rw [compl_compl]; exact hπVd) hY'dim

    have hA₁sub : closure (Limits.pullback.fst h σ ⁻¹' (π ⁻¹' (V : Set Y))ᶜ ∩
        (Limits.pullback.fst h σ ⁻¹' (h ⁻¹' {p}))ᶜ) ⊆
        Limits.pullback.fst h σ ⁻¹' (π ⁻¹' (V : Set Y))ᶜ :=
      closure_minimal Set.inter_subset_left hA_c
    have hAcov : Limits.pullback.fst h σ ⁻¹' (π ⁻¹' (V : Set Y))ᶜ ⊆
        closure (Limits.pullback.fst h σ ⁻¹' (π ⁻¹' (V : Set Y))ᶜ ∩
          (Limits.pullback.fst h σ ⁻¹' (h ⁻¹' {p}))ᶜ) ∪
        Limits.pullback.fst h σ ⁻¹' (h ⁻¹' {p}) := by
      intro a ha
      by_cases hg : a ∈ Limits.pullback.fst h σ ⁻¹' (h ⁻¹' {p})
      · exact Or.inr hg
      · exact Or.inl (subset_closure ⟨ha, hg⟩)
    have hsubO : (π ⁻¹' (V : Set Y))ᶜ ∩ (h ⁻¹' {p})ᶜ ⊆ ((h ⁻¹ᵁ O : Y'.Opens) : Set Y') := by
      intro y hy
      show h y ∈ (O : Set _)
      rw [hO]
      exact hy.2
    have hA₁dim : topologicalKrullDim ↥(closure (Limits.pullback.fst h σ ⁻¹' (π ⁻¹' (V : Set Y))ᶜ ∩
        (Limits.pullback.fst h σ ⁻¹' (h ⁻¹' {p}))ᶜ)) ≤ (n : WithBot ℕ∞) := by
      have h1 := wc_dim_le_dim_dense_open_part K (Limits.pullback h σ)
        ((Limits.pullback.fst h σ ≫ π) ≫ f)
        (closure (Limits.pullback.fst h σ ⁻¹' (π ⁻¹' (V : Set Y))ᶜ ∩
          (Limits.pullback.fst h σ ⁻¹' (h ⁻¹' {p}))ᶜ))
        (Limits.pullback.fst h σ ⁻¹' (h ⁻¹' {p}))ᶜ isClosed_closure hG_c.isOpen_compl
        (closure_mono (fun x hx => ⟨subset_closure hx, hx.2⟩))
      have h2 : topologicalKrullDim ↥(closure (Limits.pullback.fst h σ ⁻¹' (π ⁻¹' (V : Set Y))ᶜ ∩
          (Limits.pullback.fst h σ ⁻¹' (h ⁻¹' {p}))ᶜ) ∩
          (Limits.pullback.fst h σ ⁻¹' (h ⁻¹' {p}))ᶜ) ≤
          topologicalKrullDim ↥(Limits.pullback.fst h σ ⁻¹'
            ((π ⁻¹' (V : Set Y))ᶜ ∩ (h ⁻¹' {p})ᶜ)) :=
        dmono _ _ (fun x hx => ⟨hA₁sub hx.1, hx.2⟩)
      have h3 := (wc_iso_over_open_inj_dim (Limits.pullback.fst h σ) (h ⁻¹ᵁ O)
        (wc_isIso_restrict_pullback_fst h σ O (hσiso O hO))).2 _ hsubO
      have h4 := dmono _ _ (Set.inter_subset_left (s := (π ⁻¹' (V : Set Y))ᶜ)
        (t := (h ⁻¹' {p})ᶜ))
      exact h1.trans (h2.trans (h3.le.trans (h4.trans hDdim)))
    have hAdim : topologicalKrullDim ↥(Limits.pullback.fst h σ ⁻¹' (π ⁻¹' (V : Set Y))ᶜ) ≤
        (n : WithBot ℕ∞) :=
      (dmono _ _ hAcov).trans
        (wc_dim_union_closed_le _ _ _ n isClosed_closure hG_c hA₁dim hGdim)

    exact (dmono _ _ hsub).trans (wc_dim_union_closed_le _ _ _ n hA_c hG_c hAdim hGdim)

  refine ⟨Limits.pullback h σ, Limits.pullback.fst h σ ≫ π, Z, iZ, wcProjK K n, wcProjKStr K n,
    Limits.pullback.snd h σ ≫ ρ, inferInstance, hiZ, wc_proj_space_isProper K n, inferInstance,
    hiso, (wc_proj_space_dim K n).le, hZdim, hE, ?_⟩
  intro Ω _ _ t
  have e := IsHomeomorph.topologicalKrullDim_eq _
    (Scheme.homeoOfIso (Limits.pullbackRightPullbackFstIso ρ t (Limits.pullback.snd h σ))).isHomeomorph
  rw [← e]
  calc topologicalKrullDim ↥(Limits.pullback (Limits.pullback.snd h σ) (Limits.pullback.fst ρ t))
      = topologicalKrullDim ↥(Set.univ : Set ↥(Limits.pullback (Limits.pullback.snd h σ)
          (Limits.pullback.fst ρ t))) := (duniv _).symm
    _ = topologicalKrullDim ↥((Limits.pullback.snd (Limits.pullback.snd h σ)
          (Limits.pullback.fst ρ t)) ⁻¹' Set.univ) := rfl
    _ ≤ topologicalKrullDim ↥(Set.univ : Set ↥(Limits.pullback ρ t)) :=
        wc_integral_preimage_dim_le _ _
          (Limits.pullback.snd (Limits.pullback.snd h σ) (Limits.pullback.fst ρ t)) Set.univ
          isClosed_univ
    _ = topologicalKrullDim ↥(Limits.pullback ρ t) := duniv _
    _ ≤ _ := hfib Ω t

theorem wc_leray_ext_finite : ∀ {C : Type*} {D : Type*} [Category C] [Category D] [Abelian C] [Abelian D] [EnoughInjectives D] (L : D ⥤ C) (R : C ⥤ D) [R.Additive] (adj : L ⊣ R) [Limits.PreservesFiniteLimits L] (P : D) (A : C) (I : InjectiveResolution A), letI := HasExt.standard C; letI := HasExt.standard D; (∀ p q : ℕ, Finite (Abelian.Ext P (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q) p)) → ∀ k : ℕ, Finite (Abelian.Ext (L.obj P) A k) :=
by
  intro C D _ _ _ _ _ L R _ adj _ P A I hfin k
  letI : HasExt C := HasExt.standard C
  letI : HasExt D := HasExt.standard D
  classical

  have s1 : ∀ (K : CochainComplex D ℕ) (j : ℕ), ∃ (B : D) (u : K.X j ⟶ B)
      (v : B ⟶ K.cycles (j + 1)) (h1 : K.iCycles j ≫ u = 0) (h2 : v ≫ K.homologyπ (j + 1) = 0),
      (ShortComplex.mk _ _ h1).ShortExact ∧ (ShortComplex.mk _ _ h2).ShortExact ∧
        u ≫ v ≫ K.iCycles (j + 1) = K.d j (j + 1) := by
    intro K j
    have hv : Limits.image.ι (K.d j (j + 1)) ≫ K.d (j + 1) (j + 1 + 1) = 0 := by
      rw [← cancel_epi (Limits.factorThruImage (K.d j (j + 1))), Limits.image.fac_assoc,
        K.d_comp_d, Limits.comp_zero]
    let v := K.liftCycles (Limits.image.ι (K.d j (j + 1))) (j + 1 + 1)
      (CochainComplex.next ℕ (j + 1)) hv
    have hvi : v ≫ K.iCycles (j + 1) = Limits.image.ι (K.d j (j + 1)) :=
      K.liftCycles_i _ _ _ _
    have huv : Limits.factorThruImage (K.d j (j + 1)) ≫ v = K.toCycles j (j + 1) := by
      rw [← cancel_mono (K.iCycles (j + 1)), Category.assoc, hvi, Limits.image.fac,
        K.toCycles_i]
    have h1 : K.iCycles j ≫ Limits.factorThruImage (K.d j (j + 1)) = 0 := by
      rw [← cancel_mono (Limits.image.ι (K.d j (j + 1))), Category.assoc, Limits.image.fac,
        Limits.zero_comp]
      exact K.iCycles_d j (j + 1)
    have h2 : v ≫ K.homologyπ (j + 1) = 0 := by
      rw [← cancel_epi (Limits.factorThruImage (K.d j (j + 1))), ← Category.assoc, huv,
        Limits.comp_zero]
      exact K.toCycles_comp_homologyπ j (j + 1)
    haveI : Mono v := mono_of_mono_fac hvi
    refine ⟨Limits.image (K.d j (j + 1)), Limits.factorThruImage (K.d j (j + 1)), v, h1, h2,
      ?_, ?_, ?_⟩
    · refine ShortComplex.ShortExact.mk' (ShortComplex.exact_of_f_is_kernel _
        (Limits.KernelFork.IsLimit.ofι _ _
          (fun g' hg' => K.liftCycles g' (j + 1) (CochainComplex.next ℕ j) (by
            rw [← Limits.image.fac (K.d j (j + 1)), ← Category.assoc,
              show g' ≫ Limits.factorThruImage (K.d j (j + 1)) = 0 from hg', Limits.zero_comp]))
          (fun g' hg' => K.liftCycles_i _ _ _ _)
          (fun g' hg' m hm => by
            rw [← cancel_mono (K.iCycles j), K.liftCycles_i]
            exact hm))) inferInstance inferInstance
    · have hprev : (ComplexShape.up ℕ).prev (j + 1) = j := by simp
      refine ShortComplex.ShortExact.mk' (ShortComplex.exact_of_g_is_cokernel _
        (Limits.CokernelCofork.IsColimit.ofπ _ _
          (fun g' hg' => (Limits.CokernelCofork.IsColimit.desc'
            (K.homologyIsCokernel j (j + 1) hprev) g' (by
              rw [← huv, Category.assoc, show v ≫ g' = 0 from hg', Limits.comp_zero])).1)
          (fun g' hg' => (Limits.CokernelCofork.IsColimit.desc'
            (K.homologyIsCokernel j (j + 1) hprev) g' (by
              rw [← huv, Category.assoc, show v ≫ g' = 0 from hg', Limits.comp_zero])).2)
          (fun g' hg' m hm => by
            rw [← cancel_epi (K.homologyπ (j + 1))]
            exact hm.trans (Limits.CokernelCofork.IsColimit.desc'
              (K.homologyIsCokernel j (j + 1) hprev) g' (by
                rw [← huv, Category.assoc, show v ≫ g' = 0 from hg', Limits.comp_zero])).2.symm)))
        inferInstance inferInstance
    · rw [hvi, Limits.image.fac]

  have claimB : ∀ (K : CochainComplex D ℕ), (∀ j, Injective (K.X j)) →
      (∀ p q : ℕ, Finite (Abelian.Ext P (K.homology q) p)) →
      ∀ k : ℕ, ∃ S : Set (P ⟶ K.X k), S.Finite ∧ ∀ c : P ⟶ K.X k, c ≫ K.d k (k + 1) = 0 →
        ∃ c' ∈ S, c' ≫ K.d k (k + 1) = 0 ∧ (k = 0 → c = c') ∧
          ∀ p : ℕ, p + 1 = k → ∃ e : P ⟶ K.X p, e ≫ K.d p k = c - c' := by
    intro K hinj hfin
    choose Bo u v h1 h2 hS1 hS2 hfac using s1 K
    have hiso0 : IsIso (K.homologyπ 0) :=
      K.isIso_homologyπ 0 0 CochainComplex.prev_nat_zero (K.shape 0 0 (by simp))

    have hA : ∀ j i : ℕ, Finite (Abelian.Ext P (K.cycles j) (i + 1)) := by
      intro j
      induction j with
      | zero =>
        intro i
        haveI := hfin (i + 1) 0
        have hl : ∀ z : Abelian.Ext P (K.cycles 0) (i + 1),
            (z.comp (Abelian.Ext.mk₀ (K.homologyπ 0)) (add_zero _)).comp
              (Abelian.Ext.mk₀ (inv (K.homologyπ 0))) (add_zero _) = z := by
          intro z
          rw [Abelian.Ext.comp_assoc _ _ _ (add_zero _) (add_zero 0) (by omega),
            Abelian.Ext.mk₀_comp_mk₀, IsIso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
        refine Finite.of_injective
          (fun z => z.comp (Abelian.Ext.mk₀ (K.homologyπ 0)) (add_zero _)) ?_
        intro x y hxy
        rw [← hl x, ← hl y]
        exact congrArg (fun w => w.comp (Abelian.Ext.mk₀ (inv (K.homologyπ 0))) (add_zero _)) hxy
      | succ j ih =>
        intro i
        have hS1j := hS1 j
        have hS2j := hS2 j
        haveI : Injective (ShortComplex.mk _ _ (h1 j)).X₂ := hinj j
        have ha : Finite (Abelian.Ext P (Bo j) (i + 1)) := by
          haveI := ih (i + 1)
          let δ := hS1j.extClass.postcomp P (rfl : (i + 1) + 1 = (i + 1) + 1)
          refine Finite.of_injective δ ?_
          rw [injective_iff_map_eq_zero]
          intro x hx
          obtain ⟨x₂, hx₂⟩ := Abelian.Ext.covariant_sequence_exact₃ P hS1j x rfl hx
          rw [← hx₂, Abelian.Ext.eq_zero_of_injective x₂, Abelian.Ext.zero_comp]
        haveI := ha
        haveI : Finite (Abelian.Ext P (K.homology (j + 1)) (i + 1)) := hfin (i + 1) (j + 1)
        let φ : Abelian.Ext P (K.cycles (j + 1)) (i + 1) →+
            Abelian.Ext P (K.homology (j + 1)) (i + 1) :=
          (Abelian.Ext.mk₀ (K.homologyπ (j + 1))).postcomp P (add_zero (i + 1))
        have hex : ∀ x, φ x = 0 → ∃ y : Abelian.Ext P (Bo j) (i + 1),
            y.comp (Abelian.Ext.mk₀ (v j)) (add_zero _) = x := fun x hx =>
          Abelian.Ext.covariant_sequence_exact₂ P hS2j x hx
        haveI : Nonempty (Abelian.Ext P (K.cycles (j + 1)) (i + 1)) := ⟨0⟩
        let σ := Function.invFun φ
        have hσ : ∀ x, φ (σ (φ x)) = φ x := fun x => Function.invFun_eq ⟨x, rfl⟩
        have hpre : ∀ x, ∃ y : Abelian.Ext P (Bo j) (i + 1),
            y.comp (Abelian.Ext.mk₀ (v j)) (add_zero _) = x - σ (φ x) := fun x =>
          hex _ (by rw [map_sub, hσ, sub_self])
        choose τ hτ using hpre
        refine Finite.of_injective (fun x => (φ x, τ x)) ?_
        intro x x' hxx
        simp only [Prod.mk.injEq] at hxx
        obtain ⟨e1, e2⟩ := hxx
        have := hτ x
        rw [e2, hτ x', e1] at this
        exact (sub_left_inj.mp this).symm

    intro k
    cases k with
    | zero =>
      refine ⟨{c | c ≫ K.d 0 (0 + 1) = 0}, ?_,
        fun c hc => ⟨c, hc, hc, fun _ => rfl, fun p hp => absurd hp (by omega)⟩⟩
      haveI := hfin 0 0
      rw [← Set.finite_coe_iff]
      refine Finite.of_injective (fun c : ({c | c ≫ K.d 0 (0 + 1) = 0} : Set (P ⟶ K.X 0)) =>
        Abelian.Ext.mk₀ (K.liftCycles c.1 (0 + 1) (CochainComplex.next ℕ 0) c.2 ≫
          K.homologyπ 0)) ?_
      intro c₁ c₂ h
      simp only at h
      rw [← Abelian.Ext.homEquiv₀_symm_apply, ← Abelian.Ext.homEquiv₀_symm_apply] at h
      have h' := Abelian.Ext.homEquiv₀.symm.injective h
      rw [cancel_mono] at h'
      have h'' := congrArg (· ≫ K.iCycles 0) h'
      simp only [HomologicalComplex.liftCycles_i] at h''
      exact Subtype.ext h''
    | succ p =>
      haveI := hfin 0 (p + 1)
      haveI : Finite (Abelian.Ext P (K.cycles p) 1) := hA p 0
      let Z := {c : P ⟶ K.X (p + 1) // c ≫ K.d (p + 1) (p + 1 + 1) = 0}
      let Θ : Z → Abelian.Ext P (K.homology (p + 1)) 0 := fun c =>
        Abelian.Ext.mk₀ (K.liftCycles c.1 (p + 1 + 1) (CochainComplex.next ℕ (p + 1)) c.2 ≫
          K.homologyπ (p + 1))
      haveI : Nonempty Z := ⟨⟨0, Limits.zero_comp⟩⟩
      let ρ := Function.invFun Θ
      have hρ : ∀ z, Θ (ρ (Θ z)) = Θ z := fun z => Function.invFun_eq ⟨z, rfl⟩
      let Ξ : (P ⟶ Bo p) → Abelian.Ext P (K.cycles p) 1 := fun b =>
        (Abelian.Ext.mk₀ b).comp (hS1 p).extClass (zero_add 1)
      haveI : Nonempty (P ⟶ Bo p) := ⟨0⟩
      let σ := Function.invFun Ξ
      have hσ : ∀ b, Ξ (σ (Ξ b)) = Ξ b := fun b => Function.invFun_eq ⟨b, rfl⟩
      let F : Abelian.Ext P (K.homology (p + 1)) 0 × Abelian.Ext P (K.cycles p) 1 →
          (P ⟶ K.X (p + 1)) := fun hε =>
        (ρ hε.1).1 + σ hε.2 ≫ v p ≫ K.iCycles (p + 1)
      refine ⟨Set.range F, Set.finite_range F, ?_⟩
      intro c hc
      let z : Z := ⟨c, hc⟩
      let w := ρ (Θ z)
      have hwd : w.1 ≫ K.d (p + 1) (p + 1 + 1) = 0 := w.2
      have hmd : (c - w.1) ≫ K.d (p + 1) (p + 1 + 1) = 0 := by
        rw [Preadditive.sub_comp, hc, hwd, sub_zero]
      have hlift : K.liftCycles (c - w.1) (p + 1 + 1) (CochainComplex.next ℕ (p + 1)) hmd =
          K.liftCycles c (p + 1 + 1) (CochainComplex.next ℕ (p + 1)) hc -
            K.liftCycles w.1 (p + 1 + 1) (CochainComplex.next ℕ (p + 1)) hwd := by
        rw [← cancel_mono (K.iCycles (p + 1)), Preadditive.sub_comp, K.liftCycles_i,
          K.liftCycles_i, K.liftCycles_i]
      have hΘ : K.liftCycles (c - w.1) (p + 1 + 1) (CochainComplex.next ℕ (p + 1)) hmd ≫
          K.homologyπ (p + 1) = 0 := by
        have e : Abelian.Ext.mk₀ (K.liftCycles w.1 (p + 1 + 1) (CochainComplex.next ℕ (p + 1))
              hwd ≫ K.homologyπ (p + 1)) =
            Abelian.Ext.mk₀ (K.liftCycles c (p + 1 + 1) (CochainComplex.next ℕ (p + 1)) hc ≫
              K.homologyπ (p + 1)) := hρ z
        rw [← Abelian.Ext.homEquiv₀_symm_apply, ← Abelian.Ext.homEquiv₀_symm_apply] at e
        have e' := Abelian.Ext.homEquiv₀.symm.injective e
        rw [hlift, Preadditive.sub_comp]
        exact sub_eq_zero.mpr e'.symm
      have hS2p := hS2 p
      haveI := hS2p.mono_f
      let b : P ⟶ Bo p := hS2p.exact.lift
        (K.liftCycles (c - w.1) (p + 1 + 1) (CochainComplex.next ℕ (p + 1)) hmd) hΘ
      have hb : b ≫ v p =
          K.liftCycles (c - w.1) (p + 1 + 1) (CochainComplex.next ℕ (p + 1)) hmd :=
        hS2p.exact.lift_f _ _
      have hbm : b ≫ v p ≫ K.iCycles (p + 1) = c - w.1 := by
        rw [← Category.assoc, hb, K.liftCycles_i]
      let b₀ := σ (Ξ b)
      have hΞ : (Abelian.Ext.mk₀ (b - b₀)).comp (hS1 p).extClass (zero_add 1) = 0 := by
        have e : (Abelian.Ext.mk₀ b₀).comp (hS1 p).extClass (zero_add 1) =
            (Abelian.Ext.mk₀ b).comp (hS1 p).extClass (zero_add 1) := hσ b
        have hsub : Abelian.Ext.mk₀ (b - b₀) = Abelian.Ext.mk₀ b - Abelian.Ext.mk₀ b₀ := by
          rw [eq_sub_iff_add_eq, ← Abelian.Ext.mk₀_add, sub_add_cancel]
        change ((hS1 p).extClass.postcomp P (zero_add 1)) (Abelian.Ext.mk₀ (b - b₀)) = 0
        rw [hsub, map_sub]
        exact sub_eq_zero.mpr e.symm
      obtain ⟨x₂, hx₂⟩ := Abelian.Ext.covariant_sequence_exact₃ P (hS1 p)
        (Abelian.Ext.mk₀ (b - b₀)) (zero_add 1) hΞ
      let e : P ⟶ K.X p := Abelian.Ext.homEquiv₀ x₂
      have he : e ≫ u p = b - b₀ := by
        have h3 : Abelian.Ext.mk₀ (e ≫ u p) = Abelian.Ext.mk₀ (b - b₀) := by
          rw [← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_homEquiv₀_apply]
          exact hx₂
        rw [← Abelian.Ext.homEquiv₀_symm_apply, ← Abelian.Ext.homEquiv₀_symm_apply] at h3
        exact Abelian.Ext.homEquiv₀.symm.injective h3
      refine ⟨F (Θ z, Ξ b), ⟨_, rfl⟩, ?_, fun h => absurd h (by omega), ?_⟩
      · show (w.1 + b₀ ≫ v p ≫ K.iCycles (p + 1)) ≫ K.d (p + 1) (p + 1 + 1) = 0
        rw [Preadditive.add_comp, hwd, Category.assoc, Category.assoc, K.iCycles_d,
          Limits.comp_zero, Limits.comp_zero, add_zero]
      · intro p' hp'
        have hpp : p' = p := by omega
        subst hpp
        refine ⟨e, ?_⟩
        rw [← hfac p', ← Category.assoc, he, Preadditive.sub_comp, hbm]
        show c - w.1 - b₀ ≫ v p' ≫ K.iCycles (p' + 1) = c - (w.1 + b₀ ≫ v p' ≫ K.iCycles (p' + 1))
        abel

  have hinj : ∀ j, Injective (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj
      I.cocomplex).X j) := fun j => by
    haveI := I.injective j
    exact Injective.injective_of_adjoint adj (I.cocomplex.X j)
  obtain ⟨S, hS, hrep⟩ := claimB _ hinj hfin k

  have hφ0 : ∀ j, (adj.homEquiv P (I.cocomplex.X j)) 0 = 0 := fun j => by
    rw [Adjunction.homEquiv_unit, Functor.map_zero, Limits.comp_zero]
  have hφs0 : ∀ j, (adj.homEquiv P (I.cocomplex.X j)).symm 0 = 0 := fun j => by
    rw [Equiv.symm_apply_eq, hφ0]
  have hφsub : ∀ j (f g : L.obj P ⟶ I.cocomplex.X j),
      adj.homEquiv P _ (f - g) = adj.homEquiv P _ f - adj.homEquiv P _ g := fun j f g => by
    simp only [Adjunction.homEquiv_unit, Functor.map_sub, Preadditive.comp_sub]
  let T : Set (P ⟶ R.obj (I.cocomplex.X k)) :=
    {c' | c' ∈ S ∧ c' ≫ R.map (I.cocomplex.d k (k + 1)) = 0}
  have hT : T.Finite := hS.subset (fun x hx => hx.1)
  haveI := hT.to_subtype
  have hextc : ∀ (f g : L.obj P ⟶ I.cocomplex.X k) (hf : f ≫ I.cocomplex.d k (k + 1) = 0)
      (hg : g ≫ I.cocomplex.d k (k + 1) = 0), f = g →
      I.extMk f (k + 1) rfl hf = I.extMk g (k + 1) rfl hg := by
    rintro f g hf hg rfl
    rfl
  refine Finite.of_surjective (fun c' : T => I.extMk ((adj.homEquiv P _).symm c'.1) (k + 1) rfl
    (by rw [← adj.homEquiv_naturality_right_symm, c'.2.2, hφs0])) ?_
  intro α
  obtain ⟨f, hf, rfl⟩ := I.extMk_surjective α (k + 1) rfl
  have hc : adj.homEquiv P _ f ≫ R.map (I.cocomplex.d k (k + 1)) = 0 := by
    rw [← adj.homEquiv_naturality_right, hf, hφ0]
  obtain ⟨c', hc'S, hc'd, hk0, hkp⟩ := hrep (adj.homEquiv P _ f) hc
  refine ⟨⟨c', hc'S, hc'd⟩, ?_⟩
  cases k with
  | zero =>
    apply hextc
    exact (Equiv.symm_apply_eq _).mpr (hk0 rfl).symm
  | succ p =>
    obtain ⟨e, he⟩ := hkp p rfl
    refine (sub_eq_zero.mp ?_).symm
    rw [I.sub_extMk, I.extMk_eq_zero_iff _ _ _ _ p rfl]
    refine ⟨(adj.homEquiv P _).symm e, ?_⟩
    rw [← adj.homEquiv_naturality_right_symm, Equiv.symm_apply_eq, hφsub, Equiv.apply_symm_apply]
    exact he

theorem wc_et_stalk_push_homology : ∀ {X B : Scheme.{u}} (g : X ⟶ B) (b : B) (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B)), W'.Initial → ∀ (K : CochainComplex (Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) ℕ) (q : ℕ), Nonempty ((wcEtStalk B b).obj ((((wcEtPush g).mapHomologicalComplex (ComplexShape.up ℕ)).obj K).homology q) ≃ (((sheafToPresheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1} ⋙ (Functor.whiskeringLeft (B.Etale)ᵒᵖ (X.Etale)ᵒᵖ AddCommGrpCat.{u+1}).obj (@Functor.op B.Etale _ X.Etale _ (wcEtBaseChange g)) ⋙ (Functor.whiskeringLeft Λᵒᵖ (B.Etale)ᵒᵖ AddCommGrpCat.{u+1}).obj (W' ⋙ StructuredArrow.proj (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B)).op ⋙ Limits.colim).mapHomologicalComplex (ComplexShape.up ℕ)).obj K).homology q) :=
by
  intro X B g b Λ _ _ W' hinit K q
  haveI := hinit

  have hliftgen : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] {V U : Scheme.{u}} (e : V ⟶ U)
      [Etale e] (s : Spec (.of Ω) ⟶ U) (v : V), e v = s (IsLocalRing.closedPoint Ω) →
      ∃ t : Spec (.of Ω) ⟶ V, t ≫ e = s := by
    intro Ω _ _ V U e _ s v hv
    have hs : s = Spec.map (Scheme.SpecToEquivOfField Ω U s).2 ≫
        U.fromSpecResidueField (Scheme.SpecToEquivOfField Ω U s).1 := by
      rw [← Scheme.SpecToEquivOfField_symm_apply, Equiv.symm_apply_apply]
    have h1 : (Scheme.SpecToEquivOfField Ω U s).1 = s (IsLocalRing.closedPoint Ω) := rfl
    generalize Scheme.SpecToEquivOfField Ω U s = p at hs h1
    obtain ⟨w, φ⟩ := p
    simp only at hs h1
    rw [← h1] at hv
    subst hv
    letI : Algebra (U.residueField (e v)) (V.residueField v) := (e.residueFieldMap v).hom.toAlgebra
    haveI : Algebra.IsSeparable (U.residueField (e v)) (V.residueField v) := inferInstance
    haveI : Algebra.IsAlgebraic (U.residueField (e v)) (V.residueField v) :=
      Algebra.IsSeparable.isAlgebraic _ _
    letI : Algebra (U.residueField (e v)) Ω := φ.hom.toAlgebra
    let χ₀ : V.residueField v →ₐ[U.residueField (e v)] Ω :=
      IsAlgClosed.lift (R := U.residueField (e v)) (S := V.residueField v) (M := Ω)
    let χ : V.residueField v ⟶ CommRingCat.of Ω := CommRingCat.ofHom χ₀.toRingHom
    have hχ : e.residueFieldMap v ≫ χ = φ := by
      ext r
      exact χ₀.commutes r
    refine ⟨Spec.map χ ≫ V.fromSpecResidueField v, ?_⟩
    rw [Category.assoc, ← Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField,
      ← Category.assoc, ← Spec.map_comp, hχ, hs]

  let X₀ : Over B := Over.mk (wcEtGeomPt B b)
  let F : B.Etale ⥤ Type (u+1) :=
    Scheme.Etale.forget B ⋙ coyoneda.obj (Opposite.op X₀) ⋙ uliftFunctor.{u+1}
  let G : StructuredArrow X₀ (Scheme.Etale.forget B) ⥤ F.Elements :=
    { obj := fun A => Functor.elementsMk F A.right (ULift.up A.hom)
      map := fun {A A'} φ => Functor.Elements.homMk φ.right
        (congrArg ULift.up (StructuredArrow.w φ))
      map_id := by intros; rfl
      map_comp := by intros; rfl }
  haveI : G.Faithful := ⟨fun {A A'} φ ψ h => StructuredArrow.hom_ext φ ψ (by
    have h' := congrArg Functor.Elements.Hom.hom h
    exact h')⟩
  haveI : G.Full := ⟨fun {A A'} f =>
    ⟨StructuredArrow.homMk f.hom (congrArg ULift.down f.map_val), rfl⟩⟩
  haveI : G.EssSurj := ⟨fun Y => ⟨StructuredArrow.mk (Y := Y.obj) Y.val.down, ⟨Iso.refl _⟩⟩⟩
  haveI : G.IsEquivalence := { }
  haveI : IsCofiltered (StructuredArrow X₀ (Scheme.Etale.forget B)) :=
    IsCofiltered.of_hasFiniteLimits _
  haveI : IsCofiltered F.Elements := IsCofiltered.of_equivalence G.asEquivalence
  haveI : InitiallySmall.{u+1} F.Elements := initiallySmall_of_essentiallySmall.{u+1} F.Elements

  have hjs : ∀ {V : B.Etale} (R : Sieve V), R ∈ Scheme.smallEtaleTopology B V →
      ∀ x : F.obj V, ∃ (Y : B.Etale) (f : Y ⟶ V) (_ : R.arrows f) (y : F.obj Y), F.map f y = x := by
    intro V R hR x
    have e := @Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology (@Etale) (@Etale)
        B MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl
    have hR' := (@Scheme.mem_toGrothendieck_smallPretopology (@Etale) (@Etale) B
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ V R).mp
        (by rw [← e]; exact hR)
    obtain ⟨Y, f, y, hRf, hEt, hy⟩ :=
      hR' (x.down.left (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField b))))
    haveI : Etale f.left := hEt
    obtain ⟨t', ht'⟩ := hliftgen (AlgebraicClosure (B.residueField b)) f.left x.down.left y hy
    have hw : t' ≫ Y.hom = wcEtGeomPt B b := by
      rw [← MorphismProperty.Over.w f, ← Category.assoc, ht']
      exact Over.w x.down
    refine ⟨Y, f, hRf, ULift.up (Over.homMk (U := X₀) (V := (Scheme.Etale.forget B).obj Y) t' hw), ?_⟩
    apply ULift.ext
    apply Over.OverMorphism.ext
    exact ht'
  let Φ : (Scheme.smallEtaleTopology B).Point.{u+1} :=
    { fiber := F
      jointly_surjective := hjs }

  haveI : G.op.Final := inferInstance
  let α : (Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj
      (StructuredArrow.proj (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B)).op ⋙ Limits.colim ≅
      Φ.presheafFiber (A := AddCommGrpCat.{u+1}) :=
    Functor.isoWhiskerRight (Functor.whiskeringLeftObjCompIso (E := AddCommGrpCat.{u+1}) G.op
        (Functor.Elements.π F).op) Limits.colim ≪≫
      Functor.associator _ _ _ ≪≫
      Functor.isoWhiskerLeft _ (Functor.Final.colimIso G.op (E := AddCommGrpCat.{u+1}))

  let αΛ : ((Functor.whiskeringLeft Λᵒᵖ (B.Etale)ᵒᵖ AddCommGrpCat.{u+1}).obj
      (W' ⋙ StructuredArrow.proj (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B)).op ⋙
        Limits.colim) ≅
      ((Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj
        (StructuredArrow.proj (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B)).op ⋙
          Limits.colim) :=
    Functor.isoWhiskerRight (Functor.whiskeringLeftObjCompIso (C := Λᵒᵖ) (E := AddCommGrpCat.{u+1})
        W'.op (StructuredArrow.proj (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B)).op)
        Limits.colim ≪≫
      Functor.associator _ _ _ ≪≫
      Functor.isoWhiskerLeft _ (haveI := Functor.final_op_of_initial W';
        Functor.Final.colimIso W'.op (E := AddCommGrpCat.{u+1}))

  let P := sheafToPresheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1} ⋙
    (Functor.whiskeringLeft (B.Etale)ᵒᵖ (X.Etale)ᵒᵖ AddCommGrpCat.{u+1}).obj
      (@Functor.op B.Etale _ X.Etale _ (wcEtBaseChange g))
  let SΛ := (Functor.whiskeringLeft Λᵒᵖ (B.Etale)ᵒᵖ AddCommGrpCat.{u+1}).obj
      (W' ⋙ StructuredArrow.proj (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B)).op ⋙
        Limits.colim
  let Fs := Φ.sheafFiber (A := AddCommGrpCat.{u+1})
  let L := ((wcEtPush g).mapHomologicalComplex (ComplexShape.up ℕ)).obj K
  let ι₁ : ((Fs.mapHomologicalComplex (ComplexShape.up ℕ)).obj L).homology q ≅
      Fs.obj (L.homology q) := ShortComplex.mapHomologyIso (L.sc q) Fs
  let ι₂ := (Functor.mapHomologicalComplexCompIso (Iso.refl (wcEtPush g ⋙ Fs))
    (ComplexShape.up ℕ)).app K
  let β : wcEtPush g ⋙ Fs ≅ P ⋙ SΛ :=
    Functor.associator P (presheafToSheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}) Fs ≪≫
      Functor.isoWhiskerLeft P (Φ.presheafToSheafCompSheafFiberIso AddCommGrpCat.{u+1}) ≪≫
      Functor.isoWhiskerLeft P (α.symm ≪≫ αΛ.symm)
  let ι₃ := (NatIso.mapHomologicalComplex β (ComplexShape.up ℕ)).app K
  let ι₄ := HomologicalComplex.homologyMapIso (ι₂ ≪≫ ι₃) q
  exact ⟨((α.app ((sheafToPresheaf _ _).obj (L.homology q))) ≪≫
    (Φ.sheafToPresheafCompPresheafFiberIso (A := AddCommGrpCat.{u+1})).app _ ≪≫
    ι₁.symm ≪≫ ι₄).addCommGroupIsoToAddEquiv.toEquiv⟩

theorem wc_et_geom_strict_henselization : ∀ {B : Scheme.{u}} (b : B), ∃ (A : Type u) (_ : CommRing A) (_ : HenselianLocalRing A) (_ : IsSepClosed (IsLocalRing.ResidueField A)) (Λ : Type u) (_ : SmallCategory Λ) (_ : IsCofiltered Λ) (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B)) (φ : ∀ l, Spec (.of A) ⟶ (W'.obj l).right.left) (a : Spec (.of A) ⟶ B) (e : IsLocalRing.ResidueField A →+* AlgebraicClosure (B.residueField b)), W'.Initial ∧ (∀ l, IsAffine (W'.obj l).right.left) ∧ (∀ {l l' : Λ} (t : l ⟶ l'), φ l ≫ (W'.map t).right.left = φ l') ∧ (∀ l, φ l ≫ (W'.obj l).right.hom = a) ∧ (∀ (T : Scheme.{u}) (z : ∀ l, T ⟶ (W'.obj l).right.left), (∀ {l l' : Λ} (t : l ⟶ l'), z l ≫ (W'.map t).right.left = z l') → ∃! z₀ : T ⟶ Spec (.of A), ∀ l, z₀ ≫ φ l = z l) ∧ e.IsIntegral ∧ Spec.map (CommRingCat.ofHom e) ≫ Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)) ≫ a = wcEtGeomPt B b :=
by
  classical

  have sFrac : ∀ {B : Scheme.{u}} (U : B.Opens) (hU : IsAffineOpen U) (b : B) (hb : b ∈ U) (x : B.residueField b), ∃ r s : Γ(B, U), (B.presheaf.germ U b hb ≫ B.residue b).hom s ≠ 0 ∧ x * (B.presheaf.germ U b hb ≫ B.residue b).hom s = (B.presheaf.germ U b hb ≫ B.residue b).hom r := by
    intro B U hU b hb x
    letI := TopCat.Presheaf.algebra_section_stalk B.presheaf (⟨b, hb⟩ : U)
    haveI := hU.isLocalization_stalk ⟨b, hb⟩
    obtain ⟨y, hy⟩ : ∃ y : B.presheaf.stalk b, IsLocalRing.residue _ y = x :=
      IsLocalRing.residue_surjective x
    obtain ⟨⟨r, s⟩, hrs⟩ :=
      IsLocalization.mk'_surjective (hU.primeIdealOf ⟨b, hb⟩).asIdeal.primeCompl y
    change IsLocalization.mk' (B.presheaf.stalk b) r s = y at hrs
    subst hy
    refine ⟨r, s, ?_, ?_⟩
    · show IsLocalRing.residue (B.presheaf.stalk b)
        (algebraMap Γ(B, U) (B.presheaf.stalk b) (s : Γ(B, U))) ≠ 0
      exact (IsLocalRing.residue_ne_zero_iff_isUnit _).mpr
        (IsLocalization.map_units (B.presheaf.stalk b) s)
    · show IsLocalRing.residue (B.presheaf.stalk b) y *
          IsLocalRing.residue (B.presheaf.stalk b)
            (algebraMap Γ(B, U) (B.presheaf.stalk b) (s : Γ(B, U))) =
        IsLocalRing.residue (B.presheaf.stalk b) (algebraMap Γ(B, U) (B.presheaf.stalk b) r)
      rw [← map_mul, ← hrs, IsLocalization.mk'_spec]

  have sInt : ∀ (R A k Ω : Type u) [CommRing R] [CommRing A] [IsLocalRing A] [Field k] [Field Ω] [Algebra k Ω] [Algebra.IsAlgebraic k Ω] (σ : R →+* A) (ρ : A →+* Ω) [IsLocalHom ρ] (ev : R →+* k), ρ.comp σ = (algebraMap k Ω).comp ev → (∀ x : k, ∃ r s : R, ev s ≠ 0 ∧ x * ev s = ev r) → (IsLocalRing.ResidueField.lift ρ).IsIntegral := by
    intro R A k Ω _ _ _ _ _ _ _ σ ρ _ ev hρσ hfrac
    have he : ∀ a, IsLocalRing.ResidueField.lift ρ (IsLocalRing.residue A a) = ρ a :=
      fun a => IsLocalRing.ResidueField.lift_residue_apply ρ a
    have hρσ' : ∀ r, ρ (σ r) = algebraMap k Ω (ev r) := fun r => RingHom.congr_fun hρσ r
    have himg : ∀ x : k, algebraMap k Ω x ∈ Set.range (IsLocalRing.ResidueField.lift ρ) := by
      intro x
      obtain ⟨r, s, hs, hx⟩ := hfrac x
      refine ⟨IsLocalRing.residue A (σ r) * (IsLocalRing.residue A (σ s))⁻¹, ?_⟩
      have hs' : algebraMap k Ω (ev s) ≠ 0 := (map_ne_zero _).mpr hs
      rw [map_mul, map_inv₀, he, he, hρσ', hρσ', ← hx, map_mul, mul_assoc, mul_inv_cancel₀ hs',
        mul_one]
    intro y
    obtain ⟨P, hPm, hPy⟩ := (Algebra.IsAlgebraic.isAlgebraic (R := k) y).isIntegral
    have hlift : P.map (algebraMap k Ω) ∈ Polynomial.lifts (IsLocalRing.ResidueField.lift ρ) := by
      rw [Polynomial.lifts_iff_coeff_lifts]
      intro n
      rw [Polynomial.coeff_map]
      exact himg _
    obtain ⟨Q, hQ, -, hQm⟩ := Polynomial.lifts_and_degree_eq_and_monic hlift (hPm.map _)
    refine ⟨Q, hQm, ?_⟩
    rw [Polynomial.eval₂_eq_eval_map, hQ, ← Polynomial.eval₂_eq_eval_map]
    exact hPy

  have sBasic : ∀ (D : Type u) [CommRing D] (Ω : Type u) [Field Ω] (π : D →+* Ω) {E : Scheme.{u}} (f f' : Spec (.of D) ⟶ E) (O : (Spec (.of D)).Opens), Spec.map (CommRingCat.ofHom π) (IsLocalRing.closedPoint Ω) ∈ O → O.ι ≫ f = O.ι ≫ f' → ∃ g : D, π g ≠ 0 ∧ Spec.map (CommRingCat.ofHom (algebraMap D (Localization.Away g))) ≫ f = Spec.map (CommRingCat.ofHom (algebraMap D (Localization.Away g))) ≫ f' := by
    intro D _ Ω _ π E f f' O hx hO
    have hx' : PrimeSpectrum.comap π (IsLocalRing.closedPoint Ω) ∈
        (@id (Set (PrimeSpectrum D)) O.1) := hx
    have hOo : IsOpen (@id (Set (PrimeSpectrum D)) O.1) := O.isOpen
    obtain ⟨_, ⟨g, rfl⟩, hxg, hgO⟩ :=
      PrimeSpectrum.isTopologicalBasis_basic_opens.exists_subset_of_mem_open hx' hOo
    refine ⟨g, ?_, ?_⟩
    · intro h0
      have hxg' := (PrimeSpectrum.mem_basicOpen g _).mp hxg
      apply hxg'
      rw [PrimeSpectrum.comap_asIdeal, Ideal.mem_comap, h0]
      exact Ideal.zero_mem _
    · have hrange : Set.range (Spec.map (CommRingCat.ofHom (algebraMap D (Localization.Away g)))) ⊆
          Set.range O.ι := by
        rw [Scheme.Opens.range_ι]
        have h1 : Set.range (PrimeSpectrum.comap (algebraMap D (Localization.Away g))) ⊆
            @id (Set (PrimeSpectrum D)) O.1 := by
          rw [PrimeSpectrum.localization_away_comap_range (Localization.Away g) g]
          exact hgO
        exact h1
      rw [← IsOpenImmersion.lift_fac O.ι _ hrange, Category.assoc, Category.assoc, hO]

  have sRat : ∀ (k Ω : Type u) [Field k] [IsSepClosed k] [Field Ω] (ι : k →+* Ω) (E : Type u) [CommRing E] [Algebra k E], Algebra.Etale k E → ∀ ψ : E →+* Ω, ψ.comp (algebraMap k E) = ι → ∃ φ : E →ₐ[k] k, ι.comp (φ : E →+* k) = ψ := by
    intro k Ω _ _ _ ι E _ _ hE ψ hψ
    haveI : Module.Finite k E := Algebra.FormallyUnramified.finite_of_free k E
    haveI : IsArtinianRing E := IsArtinianRing.of_finite k E
    haveI hP : (RingHom.ker ψ).IsPrime := RingHom.ker_isPrime ψ
    haveI : (RingHom.ker ψ).IsMaximal := IsArtinianRing.isMaximal_of_isPrime _
    letI : Field (E ⧸ RingHom.ker ψ) := Ideal.Quotient.field _
    haveI : Algebra.FormallyUnramified k (E ⧸ RingHom.ker ψ) :=
      Algebra.FormallyUnramified.of_surjective (Ideal.Quotient.mkₐ k (RingHom.ker ψ))
        Ideal.Quotient.mk_surjective
    haveI : Algebra.FiniteType k (E ⧸ RingHom.ker ψ) :=
      Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ k (RingHom.ker ψ))
        Ideal.Quotient.mk_surjective
    haveI : Algebra.IsSeparable k (E ⧸ RingHom.ker ψ) :=
      Algebra.FormallyUnramified.isSeparable k _
    have hsurj := IsSepClosed.algebraMap_surjective k (E ⧸ RingHom.ker ψ)
    let eL : k ≃ₐ[k] (E ⧸ RingHom.ker ψ) := AlgEquiv.ofBijective (Algebra.ofId k _)
      ⟨(algebraMap k (E ⧸ RingHom.ker ψ)).injective, hsurj⟩
    let ψbar : E ⧸ RingHom.ker ψ →+* Ω :=
      Ideal.Quotient.lift _ ψ (fun a ha => RingHom.mem_ker.mp ha)
    have h1 : ∀ c : k, ψbar (algebraMap k (E ⧸ RingHom.ker ψ) c) = ι c := by
      intro c
      show ψbar (Ideal.Quotient.mk _ (algebraMap k E c)) = ι c
      rw [Ideal.Quotient.lift_mk]
      exact RingHom.congr_fun hψ c
    have h2 : ∀ x : E, algebraMap k (E ⧸ RingHom.ker ψ) (eL.symm (Ideal.Quotient.mk _ x)) =
        Ideal.Quotient.mk _ x := by
      intro x
      exact eL.apply_symm_apply (Ideal.Quotient.mk _ x)
    refine ⟨eL.symm.toAlgHom.comp (Ideal.Quotient.mkₐ k (RingHom.ker ψ)), ?_⟩
    ext x
    show ι (eL.symm (Ideal.Quotient.mk _ x)) = ψ x
    rw [← h1, h2]
    exact Ideal.Quotient.lift_mk _ _ _

  have sChart : ∀ {B : Scheme.{u}} (U : B.Opens) (hU : IsAffineOpen U) (V : B.Etale) (Ω : Type u) [Field Ω] (t : Spec (.of Ω) ⟶ V.left) (τ : Γ(B, U) →+* Ω), t ≫ V.hom = Spec.map (CommRingCat.ofHom τ) ≫ hU.fromSpec → ∃ (C : Type u) (_ : CommRing C) (_ : Algebra Γ(B, U) C) (γ₀ : C →+* Ω) (w : Spec (.of C) ⟶ V.left), Algebra.Etale Γ(B, U) C ∧ γ₀.comp (algebraMap Γ(B, U) C) = τ ∧ Spec.map (CommRingCat.ofHom γ₀) ≫ w = t ∧ w ≫ V.hom = Spec.map (CommRingCat.ofHom (algebraMap Γ(B, U) C)) ≫ hU.fromSpec := by
    intro B U hU V Ω _ t τ ht
    have hv : t (IsLocalRing.closedPoint Ω) ∈ V.hom ⁻¹ᵁ U := by
      have e : V.hom (t (IsLocalRing.closedPoint Ω)) =
          hU.fromSpec (Spec.map (CommRingCat.ofHom τ) (IsLocalRing.closedPoint Ω)) :=
        (Scheme.Hom.comp_apply t V.hom _).symm.trans
          ((congrArg (fun k => k (IsLocalRing.closedPoint Ω)) ht).trans
            (Scheme.Hom.comp_apply _ _ _))
      have h := Set.mem_range_self (f := hU.fromSpec)
        (Spec.map (CommRingCat.ofHom τ) (IsLocalRing.closedPoint Ω))
      rw [hU.range_fromSpec] at h
      show V.hom (t (IsLocalRing.closedPoint Ω)) ∈ U
      exact (congrArg (fun y => y ∈ U) e).mpr h
    obtain ⟨V₀, hV₀, hvV₀, hle⟩ := exists_isAffineOpen_mem_and_subset hv
    have hle' : V₀ ≤ V.hom ⁻¹ᵁ U := hle
    let θ : Γ(B, U) ⟶ Γ(V.left, V₀) := V.hom.appLE U V₀ hle'
    letI : Algebra Γ(B, U) Γ(V.left, V₀) := θ.hom.toAlgebra
    have hθ : θ.hom.Etale :=
      HasRingHomProperty.appLE (P := @Etale) V.hom V.prop ⟨U, hU⟩ ⟨V₀, hV₀⟩ hle'
    haveI := hV₀.isOpenImmersion_fromSpec
    haveI := hU.isOpenImmersion_fromSpec
    have hrange : Set.range t ⊆ Set.range hV₀.fromSpec := by
      rw [hV₀.range_fromSpec]
      rintro _ ⟨z, rfl⟩
      obtain rfl : z = IsLocalRing.closedPoint Ω := Subsingleton.elim _ _
      exact hvV₀
    let t' := IsOpenImmersion.lift hV₀.fromSpec t hrange
    let γ₀ : Γ(V.left, V₀) →+* Ω := (Spec.preimage t').hom
    have hγ₀ : Spec.map (CommRingCat.ofHom γ₀) = t' := by
      rw [CommRingCat.ofHom_hom]; exact Spec.map_preimage t'
    have hSq : Spec.map θ ≫ hU.fromSpec = hV₀.fromSpec ≫ V.hom :=
      IsAffineOpen.SpecMap_appLE_fromSpec V.hom hU hV₀ hle'
    refine ⟨Γ(V.left, V₀), inferInstance, inferInstance, γ₀, hV₀.fromSpec,
      RingHom.etale_algebraMap.mp hθ, ?_, ?_, ?_⟩
    · have h1 : Spec.map (CommRingCat.ofHom (γ₀.comp (algebraMap Γ(B, U) Γ(V.left, V₀)))) ≫
          hU.fromSpec = Spec.map (CommRingCat.ofHom τ) ≫ hU.fromSpec := by
        rw [CommRingCat.ofHom_comp, Spec.map_comp, Category.assoc, hγ₀]
        change t' ≫ Spec.map θ ≫ hU.fromSpec = _
        rw [hSq, ← Category.assoc, IsOpenImmersion.lift_fac, ht]
      have h2 := (cancel_mono hU.fromSpec).mp h1
      have h3 := congrArg CommRingCat.Hom.hom (Spec.map_injective h2)
      simpa only [CommRingCat.hom_ofHom] using h3
    · rw [hγ₀, IsOpenImmersion.lift_fac]
    · exact hSq.symm

  have sRet : ∀ (A : Type u) [CommRing A] [HenselianLocalRing A] (E : Type u) [CommRing E] [Algebra A E], Algebra.Etale A E → ∀ φ : E →ₐ[A] IsLocalRing.ResidueField A, ∃ τ : E →ₐ[A] A, (Algebra.ofId A (IsLocalRing.ResidueField A)).comp τ = φ := by
    intro A0 _ hHen
    have sstd : ∀ (S : Type u) [CommRing S] [Algebra A0 S], Algebra.IsStandardEtale A0 S →
        ∀ φ : S →ₐ[A0] IsLocalRing.ResidueField A0,
          ∃ τ : S →ₐ[A0] A0, (Algebra.ofId A0 (IsLocalRing.ResidueField A0)).comp τ = φ := by
      intro S _ _ hS φ
      obtain ⟨P⟩ := hS.nonempty_standardEtalePresentation
      have hm := P.hasMap
      have hf0 : Polynomial.aeval (φ P.x) P.f = 0 := by
        rw [Polynomial.aeval_algHom_apply, hm.1, map_zero]
      have hg0 : Polynomial.aeval (φ P.x) P.g ≠ 0 := by
        rw [Polynomial.aeval_algHom_apply]
        exact (hm.2.map φ).ne_zero
      have hd0 : Polynomial.aeval (φ P.x) (Polynomial.derivative P.f) ≠ 0 := by
        obtain ⟨p₁, p₂, N, hc⟩ := P.cond
        have h1 := congrArg (Polynomial.aeval (φ P.x)) hc
        rw [map_add, map_mul, map_mul, hf0, zero_mul, add_zero, map_pow] at h1
        intro h
        rw [h, zero_mul] at h1
        exact pow_ne_zero N hg0 h1.symm
      have key := (HenselianLocalRing.TFAE A0).out 1 2
      obtain ⟨a, ha, hres⟩ := key.mp hHen P.f P.monic_f (φ P.x) hf0 hd0
      have hA : P.HasMap a := by
        refine ⟨?_, ?_⟩
        · rw [Polynomial.aeval_def, Algebra.algebraMap_self, Polynomial.eval₂_id]
          exact ha
        · have key2 : (Algebra.ofId A0 (IsLocalRing.ResidueField A0)) (Polynomial.aeval a P.g) =
              Polynomial.aeval (φ P.x) P.g := by
            rw [← Polynomial.aeval_algHom_apply, Algebra.ofId_apply,
              IsLocalRing.ResidueField.algebraMap_eq, hres]
          rw [Algebra.ofId_apply, IsLocalRing.ResidueField.algebraMap_eq] at key2
          exact (IsLocalRing.residue_ne_zero_iff_isUnit _).mp (key2 ▸ hg0)
      refine ⟨(P.lift a hA).comp P.equivRing.toAlgHom, ?_⟩
      have h1 : (Algebra.ofId A0 (IsLocalRing.ResidueField A0)).comp (P.lift a hA) =
          φ.comp P.equivRing.symm.toAlgHom := by
        apply StandardEtalePair.hom_ext
        rw [AlgHom.comp_apply, AlgHom.comp_apply, StandardEtalePair.lift_X, Algebra.ofId_apply,
          IsLocalRing.ResidueField.algebraMap_eq, hres]
        have hx : P.equivRing.symm P.X = P.x :=
          (P.equivRing.symm_apply_eq).mpr P.equivRing_x.symm
        show φ P.x = φ (P.equivRing.symm P.X)
        rw [hx]
      ext s
      have h2 := congrArg (fun F => F (P.equivRing s)) h1
      simpa using h2
    intro E _ _ hE φ
    have : (RingHom.ker (φ : E →+* IsLocalRing.ResidueField A0)).IsPrime := RingHom.ker_isPrime _
    obtain ⟨s, hs, hst⟩ := Algebra.IsEtaleAt.exists_isStandardEtale (R := A0)
      (RingHom.ker (φ : E →+* IsLocalRing.ResidueField A0))
    have hs0 : φ s ≠ 0 := fun h => hs (RingHom.mem_ker.mpr h)
    have hu : ∀ y : Submonoid.powers s, IsUnit (φ y) := by
      rintro ⟨y, k, rfl⟩
      simpa [map_pow] using (isUnit_iff_ne_zero.mpr hs0).pow k
    let φ' : Localization.Away s →ₐ[A0] IsLocalRing.ResidueField A0 :=
      IsLocalization.liftAlgHom (M := Submonoid.powers s) hu
    obtain ⟨τ', hτ'⟩ := sstd _ hst φ'
    refine ⟨τ'.comp (IsScalarTower.toAlgHom A0 E (Localization.Away s)), ?_⟩
    ext e
    have h1 := congrArg (fun F => F (algebraMap E (Localization.Away s) e)) hτ'
    simp only [AlgHom.comp_apply] at h1 ⊢
    rw [IsScalarTower.toAlgHom_apply, h1]
    simp [φ', IsLocalization.liftAlgHom_apply, IsLocalization.lift_eq]

  have sLift : ∀ (R A Ω : Type u) [CommRing R] [CommRing A] [IsLocalRing A] [Field Ω] (σ : R →+* A) (ρ : A →+* Ω) [IsLocalHom ρ], (∀ (E : Type u) [CommRing E] [Algebra A E], Algebra.Etale A E → ∀ φ : E →ₐ[A] IsLocalRing.ResidueField A, ∃ τ : E →ₐ[A] A, (Algebra.ofId A (IsLocalRing.ResidueField A)).comp τ = φ) → (∀ (E : Type u) [CommRing E] [Algebra (IsLocalRing.ResidueField A) E], Algebra.Etale (IsLocalRing.ResidueField A) E → ∀ ψ : E →+* Ω, ψ.comp (algebraMap (IsLocalRing.ResidueField A) E) = IsLocalRing.ResidueField.lift ρ → ∃ φ : E →ₐ[IsLocalRing.ResidueField A] IsLocalRing.ResidueField A, (IsLocalRing.ResidueField.lift ρ).comp (φ : E →+* IsLocalRing.ResidueField A) = ψ) → ∀ (C : Type u) [CommRing C] [Algebra R C], Algebra.Etale R C → ∀ γ₀ : C →+* Ω, γ₀.comp (algebraMap R C) = ρ.comp σ → ∃ γ : C →+* A, γ.comp (algebraMap R C) = σ ∧ ρ.comp γ = γ₀ := by
    intro R A Ω _ _ _ _ σ ρ _ hRET hRAT C _ _ hC γ₀ hγ₀
    letI : Algebra R A := σ.toAlgebra
    letI : Algebra R Ω := (ρ.comp σ).toAlgebra
    letI : Algebra A Ω := ρ.toAlgebra
    haveI : IsScalarTower R A Ω := IsScalarTower.of_algebraMap_eq (fun r => rfl)
    let γ₀ₐ : C →ₐ[R] Ω := { γ₀ with commutes' := fun r => RingHom.congr_fun hγ₀ r }
    haveI hEet : Algebra.Etale A (TensorProduct R A C) := Algebra.Etale.baseChange R C A
    let ψ : TensorProduct R A C →ₐ[A] Ω :=
      Algebra.TensorProduct.lift (Algebra.ofId A Ω) γ₀ₐ (fun _ _ => Commute.all _ _)
    letI : Algebra (IsLocalRing.ResidueField A) Ω := (IsLocalRing.ResidueField.lift ρ).toAlgebra
    haveI : IsScalarTower A (IsLocalRing.ResidueField A) Ω := IsScalarTower.of_algebraMap_eq
      (fun a => (IsLocalRing.ResidueField.lift_residue_apply ρ a).symm)
    let ψk : TensorProduct A (IsLocalRing.ResidueField A) (TensorProduct R A C) →ₐ[IsLocalRing.ResidueField A] Ω :=
      Algebra.TensorProduct.lift (Algebra.ofId (IsLocalRing.ResidueField A) Ω) ψ
        (fun _ _ => Commute.all _ _)
    obtain ⟨φk, hφk⟩ := hRAT (TensorProduct A (IsLocalRing.ResidueField A) (TensorProduct R A C))
      (Algebra.Etale.baseChange A (TensorProduct R A C) (IsLocalRing.ResidueField A))
      (ψk : _ →+* Ω) ψk.comp_algebraMap
    let φ : TensorProduct R A C →ₐ[A] IsLocalRing.ResidueField A :=
      (φk.restrictScalars A).comp Algebra.TensorProduct.includeRight
    obtain ⟨τ', hτ'⟩ := hRET (TensorProduct R A C) hEet φ
    have key : ∀ z : TensorProduct R A C, ρ (τ' z) = ψ z := by
      intro z
      have e1 : ρ (τ' z) = IsLocalRing.ResidueField.lift ρ (φ z) := by
        rw [← hτ']
        exact (IsLocalRing.ResidueField.lift_residue_apply ρ (τ' z)).symm
      rw [e1]
      have e2 : IsLocalRing.ResidueField.lift ρ (φk (Algebra.TensorProduct.includeRight z)) =
          ψk (Algebra.TensorProduct.includeRight z) := RingHom.congr_fun hφk _
      change IsLocalRing.ResidueField.lift ρ (φk (Algebra.TensorProduct.includeRight z)) = ψ z
      rw [e2]
      change ψk (1 ⊗ₜ z) = ψ z
      rw [Algebra.TensorProduct.lift_tmul, map_one, one_mul]
    refine ⟨τ'.toRingHom.comp
      (Algebra.TensorProduct.includeRight : C →ₐ[R] TensorProduct R A C).toRingHom, ?_, ?_⟩
    · ext r
      simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, AlgHom.coe_toRingHom]
      rw [AlgHom.commutes, IsScalarTower.algebraMap_apply R A (TensorProduct R A C),
        AlgHom.commutes]
      rfl
    · ext c
      simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, AlgHom.coe_toRingHom]
      rw [key]
      change ψ (1 ⊗ₜ c) = γ₀ c
      rw [Algebra.TensorProduct.lift_tmul, map_one, one_mul]
