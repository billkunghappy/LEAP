    intro U'' c
    calc (Θ.hom.hom.app (Opposite.op U'')).hom (((K.homology 1).obj.map (c ≫ d).op).hom s)
        = ((sheafify (Scheme.smallEtaleTopology S) T.homology).map (c ≫ d).op).hom s' :=
          NatTrans.naturality_apply Θ.hom.hom (c ≫ d).op s
      _ = ((sheafify (Scheme.smallEtaleTopology S) T.homology).map c.op).hom
            (((sheafify (Scheme.smallEtaleTopology S) T.homology).map d.op).hom s') :=
