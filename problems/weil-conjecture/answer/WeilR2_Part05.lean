      simp only [Set.mem_preimage, Set.mem_singleton_iff]; exact hw
    have : (⟨w, hw'⟩ : ↑(φ ⁻¹' {φ v})) ∈ Subtype.val ⁻¹' t := hwU
    rw [hteq, Set.mem_singleton_iff] at this
    exact congrArg Subtype.val this

theorem wc_et_mono_factor_of_stalk_range : ∀ (B : Scheme.{u}), (∀ b : B, IsCofiltered (StructuredArrow (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B))) → (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] {V U : Scheme.{u}} (g : V ⟶ U) [Etale g] (s : Spec (.of Ω) ⟶ U) (v : V), g v = s (IsLocalRing.closedPoint Ω) → ∃ t : Spec (.of Ω) ⟶ V, t ≫ g = s ∧ t (IsLocalRing.closedPoint Ω) = v) → (∀ (Y : Scheme.{u}) (V : Y.Etale) (S : Sieve V), (∀ v : V.left, ∃ (V₁ : Y.Etale) (c : V₁ ⟶ V), S.arrows c ∧ v ∈ Set.range c.left) → S ∈ Scheme.smallEtaleTopology Y V) → ∀ (F G G' : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}) (ι : G ⟶ F) (ι' : G' ⟶ F), Mono ι → (∀ b : B, Set.range ((wcEtStalk B b).map ι') ⊆ Set.range ((wcEtStalk B b).map ι)) → ∃ φ : G' ⟶ G, φ ≫ ι = ι' :=
by
  intro B H1 H2 H3 F G G' ι ι' hmono hrange
  haveI := hmono

  have hinj : ∀ V : B.Etale, Function.Injective (ι.hom.app (Opposite.op V)).hom := fun V =>
    (AddCommGrpCat.mono_iff_injective (ι.hom.app (Opposite.op V))).mp
      (Functor.map_mono (sheafToPresheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1} ⋙
        (evaluation _ AddCommGrpCat.{u+1}).obj (Opposite.op V)) ι)

  have natι : ∀ {X Y : (B.Etale)ᵒᵖ} (d : X ⟶ Y) (y : G.obj.obj X),
      (ι.hom.app Y).hom ((G.obj.map d).hom y) = (F.obj.map d).hom ((ι.hom.app X).hom y) :=
    fun d y => NatTrans.naturality_apply ι.hom d y
  have natι' : ∀ {X Y : (B.Etale)ᵒᵖ} (d : X ⟶ Y) (y : G'.obj.obj X),
      (ι'.hom.app Y).hom ((G'.obj.map d).hom y) = (F.obj.map d).hom ((ι'.hom.app X).hom y) :=
    fun d y => NatTrans.naturality_apply ι'.hom d y
  have compF : ∀ {W₁ W₂ W₃ : B.Etale} (d : W₃ ⟶ W₂) (c : W₂ ⟶ W₁) (y : F.obj.obj (Opposite.op W₁)),
      (F.obj.map d.op).hom ((F.obj.map c.op).hom y) = (F.obj.map (d ≫ c).op).hom y := by
    intro W₁ W₂ W₃ d c y
    rw [op_comp, Functor.map_comp]
    rfl

  have hloc : ∀ (V : B.Etale) (g' : G'.obj.obj (Opposite.op V)) (v : V.left),
      ∃ (V₁ : B.Etale) (c : V₁ ⟶ V), v ∈ Set.range c.left ∧
        ∃ h : G.obj.obj (Opposite.op V₁), (ι.hom.app (Opposite.op V₁)).hom h =
          (F.obj.map c.op).hom ((ι'.hom.app (Opposite.op V)).hom g') := by
    intro V g' v
    haveI : Etale V.hom := V.prop
    have hb : V.hom v = (wcEtGeomPt B (V.hom v))
        (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField (V.hom v)))) := by
      have e1 := Scheme.Hom.comp_apply (Spec.map (CommRingCat.ofHom (algebraMap
        (B.residueField (V.hom v)) (AlgebraicClosure (B.residueField (V.hom v))))))
        (B.fromSpecResidueField (V.hom v))
        (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField (V.hom v))))
      refine (e1.trans ?_).symm
      exact Scheme.fromSpecResidueField_apply _ _
    obtain ⟨t, ht, htv⟩ := H2 (AlgebraicClosure (B.residueField (V.hom v))) V.hom
      (wcEtGeomPt B (V.hom v)) v hb
    let X₀ : Over B := Over.mk (wcEtGeomPt B (V.hom v))
    let A : StructuredArrow X₀ (Scheme.Etale.forget B) :=
      StructuredArrow.mk (Y := V) (Over.homMk (U := X₀) (V := (Scheme.Etale.forget B).obj V) t ht)
    haveI : IsCofiltered (StructuredArrow X₀ (Scheme.Etale.forget B)) := H1 (V.hom v)
    haveI : Limits.PreservesFilteredColimitsOfSize.{u, u+1} (forget AddCommGrpCat.{u+1}) :=
      Limits.preservesFilteredColimitsOfSize_shrink.{u+1, u+1, u, u+1} (forget AddCommGrpCat.{u+1})
    obtain ⟨γ, hγ⟩ := hrange (V.hom v)
      ⟨Limits.colimit.ι ((StructuredArrow.proj X₀ (Scheme.Etale.forget B)).op ⋙ G'.obj)
        (Opposite.op A) g', rfl⟩
    obtain ⟨j₁, h₁, hh₁⟩ := Limits.Concrete.colimit_exists_rep
      ((StructuredArrow.proj X₀ (Scheme.Etale.forget B)).op ⋙ G.obj) γ
    have l1 := Limits.colimit.ι_map_apply
      (Functor.whiskerLeft (StructuredArrow.proj X₀ (Scheme.Etale.forget B)).op ι.hom) j₁ h₁
    have l2 := Limits.colimit.ι_map_apply
      (Functor.whiskerLeft (StructuredArrow.proj X₀ (Scheme.Etale.forget B)).op ι'.hom)
      (Opposite.op A) g'
    have e1 : (Limits.colimit.ι ((StructuredArrow.proj X₀ (Scheme.Etale.forget B)).op ⋙ F.obj) j₁)
          ((ι.hom.app (Opposite.op j₁.unop.right)) h₁) =
        (Limits.colimit.ι ((StructuredArrow.proj X₀ (Scheme.Etale.forget B)).op ⋙ F.obj)
          (Opposite.op A)) ((ι'.hom.app (Opposite.op V)) g') := by
      refine l1.symm.trans ?_
      refine Eq.trans ?_ (hγ.trans l2)
      rw [hh₁]
      rfl
    obtain ⟨k, f₁, f₀, hk⟩ := Limits.Concrete.colimit_exists_of_rep_eq
      ((StructuredArrow.proj X₀ (Scheme.Etale.forget B)).op ⋙ F.obj) _ _ e1
    refine ⟨k.unop.right, f₀.unop.right, ?_, (G.obj.map f₁.unop.right.op).hom h₁, ?_⟩
    · have hw : k.unop.hom.left ≫ f₀.unop.right.left = t :=
        congrArg (fun φ => φ.left) (StructuredArrow.w f₀.unop)
      refine ⟨k.unop.hom.left (IsLocalRing.closedPoint _), ?_⟩
      have e2 := Scheme.Hom.comp_apply k.unop.hom.left f₀.unop.right.left
        (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField (V.hom v))))
      have e3 : (k.unop.hom.left ≫ f₀.unop.right.left)
          (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField (V.hom v)))) =
          t (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField (V.hom v)))) := by
        rw [hw]
      exact (e2.symm.trans e3).trans htv
    · exact (natι f₁.unop.right.op h₁).trans hk

  have hG := (isSheaf_iff_isSheaf_of_type (Scheme.smallEtaleTopology B)
    (G.obj ⋙ forget AddCommGrpCat.{u+1})).mp ((Presheaf.isSheaf_iff_isSheaf_forget
      (Scheme.smallEtaleTopology B) G.obj (forget AddCommGrpCat.{u+1})).mp G.property)
  have hF := (isSheaf_iff_isSheaf_of_type (Scheme.smallEtaleTopology B)
    (F.obj ⋙ forget AddCommGrpCat.{u+1})).mp ((Presheaf.isSheaf_iff_isSheaf_forget
      (Scheme.smallEtaleTopology B) F.obj (forget AddCommGrpCat.{u+1})).mp F.property)
  have hglue : ∀ (V : B.Etale) (f : F.obj.obj (Opposite.op V)),
      (∀ v : V.left, ∃ (V₁ : B.Etale) (c : V₁ ⟶ V), v ∈ Set.range c.left ∧
        ∃ h : G.obj.obj (Opposite.op V₁), (ι.hom.app (Opposite.op V₁)).hom h =
          (F.obj.map c.op).hom f) →
      ∃ h : G.obj.obj (Opposite.op V), (ι.hom.app (Opposite.op V)).hom h = f := by
    intro V f hpt
    let S : Sieve V :=
      { arrows := fun V₁ c => ∃ h : G.obj.obj (Opposite.op V₁),
          (ι.hom.app (Opposite.op V₁)).hom h = (F.obj.map c.op).hom f
        downward_closed := by
          rintro V₁ V₂ c ⟨h, hh⟩ d
          refine ⟨(G.obj.map d.op).hom h, ?_⟩
          rw [natι, hh, compF] }
    have hS : S ∈ Scheme.smallEtaleTopology B V := H3 B V S (fun v => by
      obtain ⟨V₁, c, hv, h, hh⟩ := hpt v
      exact ⟨V₁, c, ⟨h, hh⟩, hv⟩)
    let x : Presieve.FamilyOfElements (G.obj ⋙ forget AddCommGrpCat.{u+1}) S.arrows :=
      fun _ _ hc => hc.choose
    have hxs : ∀ {V₁ : B.Etale} (c : V₁ ⟶ V) (hc : S.arrows c),
        (ι.hom.app (Opposite.op V₁)).hom (x c hc) = (F.obj.map c.op).hom f :=
      fun _ hc => hc.choose_spec
    have hcompat : x.Compatible := by
      intro Y₁ Y₂ Z g₁ g₂ f₁ f₂ h₁ h₂ hcomm
      apply hinj Z
      change (ι.hom.app (Opposite.op Z)).hom ((G.obj.map g₁.op).hom (x f₁ h₁)) =
        (ι.hom.app (Opposite.op Z)).hom ((G.obj.map g₂.op).hom (x f₂ h₂))
      rw [natι, natι, hxs, hxs, compF, compF, hcomm]
    obtain ⟨a, ha⟩ : ∃ a : G.obj.obj (Opposite.op V), ∀ (Y : B.Etale) (c : Y ⟶ V)
        (hc : S.arrows c), (G.obj.map c.op).hom a = x c hc :=
      ⟨(hG S hS).amalgamate x hcompat, fun Y c hc => (hG S hS).valid_glue hcompat c hc⟩
    refine ⟨a, (hF S hS).isSeparatedFor.ext ?_⟩
    intro Y c hc
    change (F.obj.map c.op).hom ((ι.hom.app (Opposite.op V)).hom a) = (F.obj.map c.op).hom f
    rw [← natι, ha Y c hc, hxs]

  have hlift : ∀ (V : B.Etale) (g' : G'.obj.obj (Opposite.op V)),
      ∃ h : G.obj.obj (Opposite.op V),
        (ι.hom.app (Opposite.op V)).hom h = (ι'.hom.app (Opposite.op V)).hom g' :=
    fun V g' => hglue V _ (fun v => hloc V g' v)
  choose φ₀ hφ₀ using hlift
  have hφ₀' : ∀ (X : (B.Etale)ᵒᵖ) (g' : G'.obj.obj X),
      (ι.hom.app X).hom (φ₀ X.unop g') = (ι'.hom.app X).hom g' := fun X g' => hφ₀ X.unop g'
  have hadd : ∀ (V : B.Etale) (a b : G'.obj.obj (Opposite.op V)),
      φ₀ V (a + b) = φ₀ V a + φ₀ V b := by
    intro V a b
    apply hinj V
    rw [map_add, hφ₀, hφ₀, hφ₀, map_add]
  let α : G'.obj ⟶ G.obj :=
    { app := fun X => AddCommGrpCat.ofHom (AddMonoidHom.mk' (φ₀ X.unop) (hadd X.unop))
      naturality := by
        intro X Y d
        ext y
        apply hinj Y.unop
        change (ι.hom.app Y).hom (φ₀ Y.unop ((G'.obj.map d).hom y)) =
          (ι.hom.app Y).hom ((G.obj.map d).hom (φ₀ X.unop y))
        rw [hφ₀', natι, hφ₀', natι'] }
  refine ⟨ObjectProperty.homMk α, ?_⟩
  apply Sheaf.hom_ext
  ext X y
  exact hφ₀' X y

theorem wc_et_stalk_germ_facts : ∀ (B : Scheme.{u}) (b : B), IsCofiltered (StructuredArrow (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B)) → ∀ (F : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}), (∀ x : (wcEtStalk B b).obj F, ∃ (A : StructuredArrow (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B)) (s : F.obj.obj (Opposite.op A.right)), (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B)).op ⋙ F.obj) (Opposite.op A)).hom s = x) ∧ (∀ (A A' : StructuredArrow (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B)) (s : F.obj.obj (Opposite.op A.right)) (s' : F.obj.obj (Opposite.op A'.right)), (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B)).op ⋙ F.obj) (Opposite.op A)).hom s = (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B)).op ⋙ F.obj) (Opposite.op A')).hom s' → ∃ (A'' : StructuredArrow (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B)) (f : A'' ⟶ A) (f' : A'' ⟶ A'), (F.obj.map f.right.op).hom s = (F.obj.map f'.right.op).hom s') ∧ (∀ (G : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}) (φ : G ⟶ F) (A : StructuredArrow (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B)) (g : G.obj.obj (Opposite.op A.right)), ((wcEtStalk B b).map φ).hom ((Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B)).op ⋙ G.obj) (Opposite.op A)).hom g) = (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B)).op ⋙ F.obj) (Opposite.op A)).hom ((φ.hom.app (Opposite.op A.right)).hom g)) :=
by
  intro B b hcof F
  classical
  haveI := hcof
  haveI : IsFiltered (StructuredArrow (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B))ᵒᵖ :=
    isFiltered_op_of_isCofiltered _
  haveI := Limits.preservesFilteredColimitsOfSize_shrink.{u+1, u+1, u, u+1} (forget AddCommGrpCat.{u+1})
  refine ⟨?_, ?_, ?_⟩
  · intro x
    obtain ⟨j, y, hy⟩ := Limits.Concrete.colimit_exists_rep
      ((StructuredArrow.proj (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B)).op ⋙ F.obj) x
    exact ⟨j.unop, y, hy⟩
  · intro A A' s s' h
    obtain ⟨k, f, g, hk⟩ := (Limits.Concrete.colimit_rep_eq_iff_exists
      ((StructuredArrow.proj (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B)).op ⋙ F.obj)
      (i := Opposite.op A) (j := Opposite.op A') s s').mp h
    exact ⟨k.unop, f.unop, g.unop, hk⟩
  · intro G φ A g
    exact Limits.colimit.ι_map_apply
      (Functor.whiskerLeft (StructuredArrow.proj (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B)).op φ.hom)
