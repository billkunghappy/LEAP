    have := hsm.wellFoundedGT
    exact (isNoetherianObject_iff_monotone_chain_condition Y).2
      (wellFoundedGT_iff_monotone_chain_condition.1 this)

  have dirMax : ∀ (X : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}),
      IsNoetherianObject X → ∀ (S : Set (Subobject X)), S.Nonempty →
      (∀ a ∈ S, ∀ b ∈ S, ∃ c ∈ S, a ≤ c ∧ b ≤ c) → ∃ c ∈ S, ∀ a ∈ S, a ≤ c := by
    intro X hX S hne hdir
    have hwf : WellFoundedGT (Subobject X) := wellFoundedGT_iff_monotone_chain_condition.2
