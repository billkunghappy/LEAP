  exact main q G hG htor

theorem wc_pd_P1_base_iso : ∀ (R : Type u) [CommRing R], ∃ (e₁ : @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) R) MvPolynomial.gradedAlgebra ≅ Spec (.of R) ⨯ wcPdP1Z.{u}) (e₂ : Spec (.of ((MvPolynomial.homogeneousSubmodule (Fin 2) R) 0)) ≅ Spec (.of R)), e₁.hom ≫ Limits.prod.fst = wcP1 R ≫ e₂.hom :=
