theorem wc_et_stalk_good_nbhd : ∀ (B : Scheme.{u}) (F G : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}) (ι : G ⟶ F) (η : B), IsCofiltered (StructuredArrow (Over.mk (wcEtGeomPt B η)) (Scheme.Etale.forget B)) → (∀ {V B' : Scheme.{u}} (φ : V ⟶ B') [Etale φ] (v : V), ∃ U : V.Opens, v ∈ U ∧ ∀ w ∈ U, φ w = φ v → w = v) → Finite ((wcEtStalk B η).obj F) → ∃ (V : B.Etale) (t : Spec (.of (AlgebraicClosure (B.residueField η))) ⟶ V.left) (ht : t ≫ V.hom = wcEtGeomPt B η) (σ : (wcEtStalk B η).obj F → F.obj.obj (Opposite.op V)), (∀ x, (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt B η)) (Scheme.Etale.forget B)).op ⋙ F.obj) (Opposite.op (StructuredArrow.mk (Over.homMk t ht : Over.mk (wcEtGeomPt B η) ⟶ (Scheme.Etale.forget B).obj V)))).hom (σ x) = x) ∧ (∀ x ∈ Set.range ((wcEtStalk B η).map ι), ∃ g : G.obj.obj (Opposite.op V), (ι.hom.app (Opposite.op V)).hom g = σ x) ∧ ∀ w : V.left, V.hom w = η → w = t (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField η))) :=
by
  classical
  intro B F G ι η H1 H3 H5
  let X₀ : Over B := Over.mk (wcEtGeomPt B η)
  haveI : IsCofiltered (StructuredArrow X₀ (Scheme.Etale.forget B)) := H1
  haveI : IsFiltered (StructuredArrow X₀ (Scheme.Etale.forget B))ᵒᵖ :=
    isFiltered_op_of_isCofiltered _
  haveI : Limits.PreservesFilteredColimitsOfSize.{u, u+1} (forget AddCommGrpCat.{u+1}) :=
    Limits.preservesFilteredColimitsOfSize_shrink.{u+1, u+1, u, u+1} (forget AddCommGrpCat.{u+1})
  have natι : ∀ {X Y : (B.Etale)ᵒᵖ} (d : X ⟶ Y) (y : G.obj.obj X),
      (ι.hom.app Y).hom ((G.obj.map d).hom y) = (F.obj.map d).hom ((ι.hom.app X).hom y) :=
    fun d y => NatTrans.naturality_apply ι.hom d y

  have ha : ∀ x : (wcEtStalk B η).obj F, ∃ (j : (StructuredArrow X₀ (Scheme.Etale.forget B))ᵒᵖ)
      (s : F.obj.obj (Opposite.op j.unop.right)),
      (Limits.colimit.ι ((StructuredArrow.proj X₀ (Scheme.Etale.forget B)).op ⋙ F.obj) j).hom s = x ∧
      (x ∈ Set.range ((wcEtStalk B η).map ι) → ∃ g : G.obj.obj (Opposite.op j.unop.right),
        (ι.hom.app (Opposite.op j.unop.right)).hom g = s) := by
    intro x
    obtain ⟨j₁, s₁, hs₁⟩ := Limits.Concrete.colimit_exists_rep
      ((StructuredArrow.proj X₀ (Scheme.Etale.forget B)).op ⋙ F.obj) x
    by_cases hx : x ∈ Set.range ((wcEtStalk B η).map ι)
    · obtain ⟨γ, hγ⟩ := hx
      obtain ⟨k, g₁, hg₁⟩ := Limits.Concrete.colimit_exists_rep
        ((StructuredArrow.proj X₀ (Scheme.Etale.forget B)).op ⋙ G.obj) γ
      have l1 := Limits.colimit.ι_map_apply
        (Functor.whiskerLeft (StructuredArrow.proj X₀ (Scheme.Etale.forget B)).op ι.hom) k g₁
      have e1 : (Limits.colimit.ι ((StructuredArrow.proj X₀ (Scheme.Etale.forget B)).op ⋙ F.obj) j₁) s₁ =
          (Limits.colimit.ι ((StructuredArrow.proj X₀ (Scheme.Etale.forget B)).op ⋙ F.obj) k)
            ((ι.hom.app (Opposite.op k.unop.right)) g₁) := by
