theorem wc_et_closed_kernel_covers : ∀ (X Z : Scheme.{u}) (i : Z ⟶ X) (W : X.Opens), Set.range i = (W : Set X)ᶜ → ∀ (A G : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) (f : A ⟶ G) (H : Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) (β : G ⟶ (wcEtPush i).obj H) (ρ : wcEtTransport i G H), (∀ (V : X.Etale) (x : G.obj.obj (Opposite.op V)), ((toSheafify (Scheme.smallEtaleTopology X) ((wcEtBaseChange i).op ⋙ H.obj)).app (Opposite.op V)).hom (ρ.ρ V ((wcEtBaseChange i).obj V) (Limits.pullback.fst V.hom i) Limits.pullback.condition x) = (β.hom.app (Opposite.op V)).hom x) → (∀ (V : X.Etale) (O : Z.Etale) (h : O.left ⟶ V.left) (hh : h ≫ V.hom = O.hom ≫ i) (x : G.obj.obj (Opposite.op V)) (o : O.left), ρ.ρ V O h hh x = 0 → ∃ (V' : X.Etale) (c : V' ⟶ V) (v' : V'.left), c.left v' = h o ∧ G.obj.map c.op x = 0) → (∀ (T : X.Etale), (∀ x, T.hom x ∈ (W : Set X)) → ∀ s : G.obj.obj (Opposite.op T), Presheaf.imageSieve f.hom s ∈ Scheme.smallEtaleTopology X T) → ∀ (T : X.Etale) (g : G.obj.obj (Opposite.op T)), (β.hom.app (Opposite.op T)).hom g = 0 → Presheaf.imageSieve f.hom g ∈ Scheme.smallEtaleTopology X T :=
by
  intro X Z i W hW A G f H β ρ hβ hinj hcov T g hg
  have hjs : ∀ (V : X.Etale) (S : Sieve V), (∀ v : V.left, ∃ (V₁ : X.Etale)
      (c : V₁ ⟶ V), S.arrows c ∧ v ∈ Set.range c.left) → S ∈ Scheme.smallEtaleTopology X V := by
    intro V S hS
    change S ∈ Scheme.smallGrothendieckTopology @Etale X V
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale X
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
    apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale X
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
    intro x
    obtain ⟨V₁, c, hc, y, hy⟩ := hS x
    have hw : c.left ≫ V.hom = V₁.hom := MorphismProperty.Over.w c
    have hEt : Etale c.left := by
      have h1 : Etale V.hom := V.prop
      have h2 : Etale (c.left ≫ V.hom) := by rw [hw]; exact V₁.prop
      exact Etale.of_comp c.left V.hom
    exact ⟨V₁, c, y, hc, hEt, hy⟩
  have hcompG : ∀ {T₁ T₂ : X.Etale} (d : T₂ ⟶ T₁) (c : T₁ ⟶ T) (s : G.obj.obj (Opposite.op T)),
      (G.obj.map (d ≫ c).op).hom s = (G.obj.map d.op).hom ((G.obj.map c.op).hom s) :=
    fun d c s => ConcreteCategory.congr_hom (G.obj.map_comp c.op d.op) s
  obtain ⟨R, hRdef⟩ : ∃ R : Sieve T, ∀ {T' : X.Etale} (c : T' ⟶ T),
      R.arrows c ↔ ((∀ x, T'.hom x ∈ (W : Set X)) ∨ (G.obj.map c.op).hom g = 0) :=
    ⟨{ arrows := fun T' c => (∀ x, T'.hom x ∈ (W : Set X)) ∨ (G.obj.map c.op).hom g = 0
       downward_closed := by
         intro T' T'' c hc e
         rcases hc with hc | hc
         · left
           intro y
           have hw : e.left ≫ T'.hom = T''.hom := MorphismProperty.Over.w e
           have h1 : T''.hom y = T'.hom (e.left y) :=
             (congrArg (fun k : T''.left ⟶ X => k y) hw).symm.trans
               (Scheme.Hom.comp_apply e.left T'.hom y)
           rw [h1]
           exact hc _
         · right
           rw [hcompG e c g, hc, map_zero] }, fun _ => Iff.rfl⟩
  let P : (X.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1} := (wcEtBaseChange i).op ⋙ H.obj
  haveI hτ := Presheaf.isLocallyInjective_toSheafify' (Scheme.smallEtaleTopology X) P
  have hR : R ∈ Scheme.smallEtaleTopology X T := by
    apply hjs
    intro x
    by_cases hx : T.hom x ∈ (W : Set X)
    · let O : T.left.Opens := T.hom ⁻¹ᵁ W
      refine ⟨wcEtOpen X T O, wcEtOpenι X T O, (hRdef _).mpr (Or.inl ?_), ⟨⟨x, hx⟩, ?_⟩⟩
      · intro y
        have h1 : (wcEtOpen X T O).hom y = T.hom (O.ι y) :=
          Scheme.Hom.comp_apply O.ι T.hom y
        have h2 : O.ι y ∈ (O : Set T.left) := by
