        (Limits.pullback.snd a.left (Limits.pullback.fst V.hom i) ≫ Limits.pullback.snd V.hom i) ≫ i := by
      rw [← MorphismProperty.Over.w a, ← Category.assoc, Limits.pullback.condition, Category.assoc,
        Limits.pullback.condition, Category.assoc]
    let ψ : Limits.pullback a.left (Limits.pullback.fst V.hom i) ⟶ Limits.pullback W₁.hom i :=
      Limits.pullback.lift (Limits.pullback.fst a.left (Limits.pullback.fst V.hom i))
        (Limits.pullback.snd a.left (Limits.pullback.fst V.hom i) ≫ Limits.pullback.snd V.hom i) h1
