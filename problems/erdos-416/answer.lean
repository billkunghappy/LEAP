      have := mul_lt_mul_of_pos_left h7 (by positivity : (0 : ℝ) < 4 * c)
      rw [← mul_assoc, mul_one_div_cancel (by positivity), one_mul] at this
      linarith
    set g := Y / (L * T ^ 2) with hg
    have hg0 : 0 < g := by positivity
    have hsq : c * Y * T ≤ (g / 2) ^ 2 := by
