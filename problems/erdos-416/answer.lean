theorem powerRawPairs_collisions_bound (hPNT : Tendsto (fun x : ℝ => (Nat.primeCounting ⌊x⌋₊ : ℝ) / (x / Real.log x)) atTop (𝓝 1))
    (hMERT : ∃ C : ℝ, ∀ x : ℝ, 2 ≤ x →
      |(∑ p ∈ (Finset.Iic ⌊x⌋₊).filter Nat.Prime, (1 : ℝ) / p) - Real.log (Real.log x)| ≤ C)
    (hEULER : Asymptotics.IsEquivalent atTop
      (fun x : ℝ => ∏ p ∈ (Finset.Iic ⌊x⌋₊).filter Nat.Prime, (1 - (1 : ℝ) / p))
      (fun x => Real.exp (-Real.eulerMascheroniConstant) / Real.log x))
    (R : ℕ) (P A : ℝ) (hA : 0 < A) :
    ∀ᶠ Y : ℝ in atTop, ∀ (L : ℕ) (S : CoreRecords.CoreSelection Y L R P),
      (L : ℝ) ≤ A * Real.log (logLog Y) →
        ((collisionPoints (CoreRecords.powerRawPairs S) corePairValue).card : ℝ) ≤
          4 * R * (Y / (Real.log Y * (logLog Y) ^ 2)) :=
by
  obtain ⟨D, hD, hsize⟩ := inverse_totient_size_bound hPNT hMERT hEULER
  have hLL : Tendsto logLog atTop atTop :=
    Real.tendsto_log_atTop.comp Real.tendsto_log_atTop
  have hS : Tendsto (fun Y => normalityScale (logLog Y)) atTop atTop := by
    unfold normalityScale
    exact Real.tendsto_exp_atTop.comp (Real.tendsto_exp_atTop.comp
      (((tendsto_pow_atTop (by norm_num : (10 : ℕ) ≠ 0)).comp Real.tendsto_log_atTop).comp hLL))
  
  have hnormal : ∀ q : ℕ, q.Prime → ∀ᶠ S : ℝ in atTop, SNormal S q := by
    intro q hq
    have h2 : Tendsto (fun S : ℝ => 2 * Real.log (Real.log S)) atTop atTop :=
      (Real.tendsto_log_atTop.comp Real.tendsto_log_atTop).const_mul_atTop (by norm_num)
    filter_upwards [eventually_ge_atTop (q : ℝ),
      h2.eventually_ge_atTop (ArithmeticFunction.cardFactors (q - 1) : ℝ)] with S hSq hSlog
    refine ⟨hq, ?_, ?_⟩
    · have hle : omegaInterval (q - 1) 1 S ≤ ArithmeticFunction.cardFactors (q - 1) := by
        unfold omegaInterval
        rw [ArithmeticFunction.cardFactors_apply]
        exact List.countP_le_length
      calc (omegaInterval (q - 1) 1 S : ℝ)
          ≤ (ArithmeticFunction.cardFactors (q - 1) : ℝ) := by exact_mod_cast hle
        _ ≤ _ := hSlog
    · intro u v hu huv hv
      exfalso
      have hq1 : 1 ≤ q := hq.one_lt.le
      have hlt : ((q - 1 : ℕ) : ℝ) < q := by
        rw [Nat.cast_sub hq1]; simp
      linarith
  have hrn : ∀ r : ℕ, ∀ᶠ Y : ℝ in atTop,
      ∀ q ∈ r.primeFactors, SNormal (normalityScale (logLog Y)) q := by
    intro r
    refine (Filter.eventually_all_finset _).mpr ?_
    intro q hq
    exact hS.eventually (hnormal q (Nat.prime_of_mem_primeFactors hq))
  
  have hfixed : ∀ᶠ Y : ℝ in atTop, ∀ r ∈ Finset.Icc 1 R, ∀ (L : ℕ) (G : Finset ℕ)
      (p : ℕ → Fin (L + 1) → ℕ),
      (L : ℝ) ≤ A * Real.log (logLog Y) →
      (∀ n ∈ G, Rigidity.Tuple Y P (6 / 5) (4 / 5) r n (p n)) →
      (∀ n ∈ G, ∀ m ∈ G,
        (∏ idx : Fin L, (p n idx.succ - 1)) = (∏ idx : Fin L, (p m idx.succ - 1)) →
          ∀ idx : Fin L, p n idx.succ = p m idx.succ) →
      (∀ n ∈ G, ∃ N : ℕ, 0 < N ∧ N.totient = r.totient * n.totient ∧
        largestPrimeFactor N ≠ p n 0) →
      (G.card : ℝ) ≤ 4 * (Y / (Real.log Y * (logLog Y) ^ 2)) := by
    refine (Filter.eventually_all_finset _).mpr ?_
    intro r hr
    have hr0 : 0 < r := (Finset.mem_Icc.mp hr).1
    filter_upwards [hsize, hrn r, hS.eventually_ge_atTop (largestPrimeFactor r.totient : ℝ),
      retained_pairs_count hPNT hMERT hEULER hA.le P (6 / 5) (4 / 5) (by norm_num) (by norm_num)
        r.totient (Nat.totient_pos.mpr hr0),
      squarefree_nonnormal_count hPNT hMERT hEULER hA hD, large_prime_square_count hD,
      nonnormal_totients_count hPNT hMERT hEULER, eventually_ge_atTop (0 : ℝ)]
      with Y hsz hrnY hdS hret h0 h1 h2 hY0
    intro L G p hL hG hlow hwit
    have hmain := rigidity_count_le_exceptions (c := D)
      (B := Y / (Real.log Y * (logLog Y) ^ 2)) hr0 hY0 hsz hrnY
      (fun G' hG' => hret L G' hL hdS hG') G p hL hG hlow hwit
    linarith
  filter_upwards [hfixed, rawPair_power_top_eventually R A, eventually_ge_atTop (0 : ℝ)]
    with Y hfix htopQ hY0
  intro L S hL
  have htop : ∀ bp ∈ CoreRecords.powerRawPairs S, ∀ hb : bp.1 ∈ S.cores,
      Y ^ (9 / 10 : ℝ) < (bp.2 : ℝ) ∧
        (S.record ⟨bp.1, hb⟩).lower ⟨0, (S.record ⟨bp.1, hb⟩).length_pos⟩ < bp.2 := by
    intro bp hbp hb
    have hbp' := hbp
    simp only [CoreRecords.powerRawPairs, corePairs, Finset.mem_filter] at hbp'
    obtain ⟨_, hp, hlo, _⟩ := hbp'
    have hce := S.core_eq ⟨bp.1, hb⟩
    have hval : corePairValue ((S.record ⟨bp.1, hb⟩).numericalCore, bp.2) =
        corePairValue bp := by
      rw [hce]
    exact htopQ L P (S.record ⟨bp.1, hb⟩) hL bp.2 hp (by rw [hval]; exact hlo)
  have hsum := powerRawPairs_collisions_le_tail_sum S
    (4 * (Y / (Real.log Y * (logLog Y) ^ 2))) hY0 htop
    (fun r hr G p => hfix r hr L G p hL)
  calc ((collisionPoints (CoreRecords.powerRawPairs S) corePairValue).card : ℝ)
      ≤ (R : ℝ) * (4 * (Y / (Real.log Y * (logLog Y) ^ 2))) := hsum
    _ = 4 * R * (Y / (Real.log Y * (logLog Y) ^ 2)) := by ring

theorem fordRho_spec : 0 < FordAnalysis.rho ∧ FordAnalysis.rho < 3 / 4 ∧ FordAnalysis.F FordAnalysis.rho = 1 :=
by
  
  have hb : ∀ n : ℕ, 0 ≤ FordAnalysis.coeff n ∧ FordAnalysis.coeff n ≤ (n : ℝ) ∧
      Real.log (n : ℝ) ≤ FordAnalysis.coeff n := by
    intro n
    rcases Nat.eq_zero_or_pos n with rfl | hn
    · simp [FordAnalysis.coeff]
    · have hne : n ≠ 0 := by omega
      simp only [FordAnalysis.coeff, if_neg hne, fordWeight]
      have hx1 : (1 : ℝ) ≤ (n : ℝ) := by exact_mod_cast hn
      have hx0 : 0 < (n : ℝ) := by linarith
      have hx10 : 0 < (n : ℝ) + 1 := by linarith
      have hlogx : 0 ≤ Real.log (n : ℝ) := Real.log_nonneg hx1
      have hA : Real.log (n : ℝ) - Real.log ((n : ℝ) + 1) ≤ (n : ℝ) / ((n : ℝ) + 1) - 1 := by
        rw [← Real.log_div hx0.ne' hx10.ne']
        exact Real.log_le_sub_one_of_pos (by positivity)
      have hA' : (Real.log (n : ℝ) - Real.log ((n : ℝ) + 1)) * ((n : ℝ) + 1) ≤ -1 := by
        have h := mul_le_mul_of_nonneg_right hA hx10.le
        have he : ((n : ℝ) / ((n : ℝ) + 1) - 1) * ((n : ℝ) + 1) = -1 := by
          field_simp
          ring
        linarith
      have hB : Real.log ((n : ℝ) + 1) - Real.log (n : ℝ) ≤ ((n : ℝ) + 1) / (n : ℝ) - 1 := by
        rw [← Real.log_div hx10.ne' hx0.ne']
        exact Real.log_le_sub_one_of_pos (by positivity)
      have hB' : (Real.log ((n : ℝ) + 1) - Real.log (n : ℝ)) * (n : ℝ) ≤ 1 := by
        have h := mul_le_mul_of_nonneg_right hB hx0.le
        have he : (((n : ℝ) + 1) / (n : ℝ) - 1) * (n : ℝ) = 1 := by
          field_simp
          ring
        linarith
      have hC : Real.log ((n : ℝ) + 1) ≤ (n : ℝ) := by
        have := Real.log_le_sub_one_of_pos hx10
        linarith
      refine ⟨?_, ?_, ?_⟩
      · nlinarith
      · nlinarith
      · nlinarith
  
  have hsum : Summable (fun n : ℕ => (n : ℝ) * (3 / 4 : ℝ) ^ n) := by
    have h := summable_pow_mul_geometric_of_norm_lt_one 1 (r := (3 / 4 : ℝ))
      (by rw [Real.norm_eq_abs, abs_of_pos (by norm_num)]; norm_num)
    simpa using h
  
  have hcont : ContinuousOn FordAnalysis.F (Set.Icc 0 (3 / 4)) := by
    unfold FordAnalysis.F
    refine continuousOn_tsum (fun n => (continuous_const.mul (continuous_pow n)).continuousOn)
      hsum ?_
    intro n z hz
    rw [norm_mul, norm_pow, Real.norm_eq_abs, Real.norm_eq_abs, abs_of_nonneg (hb n).1,
      abs_of_nonneg hz.1]
    exact mul_le_mul (hb n).2.1 (pow_le_pow_left₀ hz.1 hz.2 n) (pow_nonneg hz.1 n)
      (Nat.cast_nonneg n)
  
  have hgt : 1 < FordAnalysis.F (3 / 4) := by
    have hg0 : ∀ n : ℕ, 0 ≤ FordAnalysis.coeff n * (3 / 4 : ℝ) ^ n :=
      fun n => mul_nonneg (hb n).1 (by positivity)
    have hgs : Summable (fun n : ℕ => FordAnalysis.coeff n * (3 / 4 : ℝ) ^ n) :=
      Summable.of_nonneg_of_le hg0
        (fun n => mul_le_mul_of_nonneg_right (hb n).2.1 (by positivity)) hsum
    have hle := hgs.sum_le_tsum ({2, 3, 4} : Finset ℕ) (fun i _ => hg0 i)
    have hs3 : ∑ i ∈ ({2, 3, 4} : Finset ℕ), FordAnalysis.coeff i * (3 / 4 : ℝ) ^ i =
        FordAnalysis.coeff 2 * (9 / 16) + FordAnalysis.coeff 3 * (27 / 64) +
          FordAnalysis.coeff 4 * (81 / 256) := by
      rw [Finset.sum_insert (by norm_num), Finset.sum_insert (by norm_num),
        Finset.sum_singleton]
      ring
    have h2 := (hb 2).2.2
    have h3 := (hb 3).2.2
    have h4 := (hb 4).2.2
    push_cast at h2 h3 h4
    have hl3 : Real.log 2 ≤ Real.log 3 := Real.log_le_log (by norm_num) (by norm_num)
    have hl4 : Real.log 4 = 2 * Real.log 2 := by
      rw [show (4 : ℝ) = 2 ^ 2 by norm_num, Real.log_pow]
      norm_num
    have hl2 := Real.log_two_gt_d9
    have hF : FordAnalysis.F (3 / 4) = ∑' n : ℕ, FordAnalysis.coeff n * (3 / 4 : ℝ) ^ n := rfl
    rw [hF]
    linarith
  
  have hF0 : FordAnalysis.F 0 = 0 := by
    unfold FordAnalysis.F
    have hfun : (fun n : ℕ => FordAnalysis.coeff n * (0 : ℝ) ^ n) = fun _ => 0 := by
      funext n
      cases n with
      | zero => simp [FordAnalysis.coeff]
      | succ k => simp
    rw [hfun, tsum_zero]
  
  have hivt := intermediate_value_Ioo (by norm_num : (0 : ℝ) ≤ 3 / 4) hcont
  obtain ⟨r, hr, hFr⟩ := hivt ⟨by rw [hF0]; norm_num, hgt⟩
  exact Classical.epsilon_spec (p := fun r : ℝ => 0 < r ∧ r < 3 / 4 ∧ FordAnalysis.F r = 1)
    ⟨r, hr.1, hr.2, hFr⟩

theorem prime_reciprocal_log_error : ∃ B K : ℝ, 0 < K ∧ ∀ x : ℝ, 2 ≤ x →
      |(∑ p ∈ (Finset.Iic ⌊x⌋₊).filter Nat.Prime, (1 : ℝ) / p) - Real.log (Real.log x) - B| ≤
        K / Real.log x :=
by
  obtain ⟨C, K₁, hrate⟩ :=
    vonMangoldt_div_log_sum_rate (Real.log 4 + 4) vonMangoldt_div_sum_sub_log_abs_le
  
  set W : ℕ → ℝ := fun n =>
    if n.Prime then (0 : ℝ) else ArithmeticFunction.vonMangoldt n / (n : ℝ) with hWdef
  have hW : ∀ n : ℕ, 0 ≤ W n ∧ (W n = 0 ∨ ∃ m k : ℕ, 2 ≤ m ∧ 2 ≤ k ∧ n = m ^ k ∧
      W n = Real.log m / (m : ℝ) ^ k) := by
    intro n
    by_cases hp : n.Prime
    · have h0 : W n = 0 := by simp only [hWdef, if_pos hp]
      exact ⟨h0.ge, Or.inl h0⟩
    · by_cases hpp : IsPrimePow n
      · obtain ⟨p, k, hpk, hk, rfl⟩ := (isPrimePow_nat_iff _).mp hpp
        have hk2 : 2 ≤ k := by
          rcases Nat.lt_or_ge k 2 with h | h
          · exfalso
            have hk1 : k = 1 := by omega
            subst hk1
            exact hp (by simpa using hpk)
          · exact h
        have hp1 : (1 : ℝ) < p := by exact_mod_cast hpk.one_lt
        have hlogp : 0 < Real.log p := Real.log_pos hp1
        have hval : W (p ^ k) = Real.log p / (p : ℝ) ^ k := by
          simp only [hWdef, if_neg hp, ArithmeticFunction.vonMangoldt_apply_pow (by omega : k ≠ 0),
            ArithmeticFunction.vonMangoldt_apply_prime hpk, Nat.cast_pow]
        refine ⟨by rw [hval]; positivity, Or.inr ⟨p, k, hpk.two_le, hk2, rfl, hval⟩⟩
      · have h0 : W n = 0 := by
          simp only [hWdef, if_neg hp, ArithmeticFunction.vonMangoldt_eq_zero_iff.mpr hpp]
          simp
        exact ⟨h0.ge, Or.inl h0⟩
  
  have hQ : ∀ N : ℕ, ∑ n ∈ Finset.range (N + 1), W n ≤ 2 := by
    intro N
    have hnonneg : ∀ n m k : ℕ, 0 ≤ (if n = m ^ k then Real.log m / (m : ℝ) ^ k else 0) := by
      intro n m k
      split_ifs
      · exact div_nonneg (Real.log_natCast_nonneg m) (by positivity)
      · exact le_rfl
    have hG : ∀ n ∈ Finset.range (N + 1), W n ≤ ∑ m ∈ Finset.Icc 2 N, ∑ k ∈ Finset.Icc 2 N,
        (if n = m ^ k then Real.log m / (m : ℝ) ^ k else 0) := by
      intro n hn
      have hnN : n ≤ N := Nat.lt_succ_iff.mp (Finset.mem_range.mp hn)
      rcases (hW n).2 with h0 | ⟨m, k, hm, hk, rfl, hle⟩
      · rw [h0]
        exact Finset.sum_nonneg fun m _ => Finset.sum_nonneg fun k _ => hnonneg _ m k
      · have hmN : m ∈ Finset.Icc 2 N := by
          refine Finset.mem_Icc.mpr ⟨hm, le_trans ?_ hnN⟩
          exact Nat.le_self_pow (by omega) m
        have hkN : k ∈ Finset.Icc 2 N := by
          refine Finset.mem_Icc.mpr ⟨hk, le_trans ?_ hnN⟩
          calc k ≤ 2 ^ k := (Nat.lt_two_pow_self).le
            _ ≤ m ^ k := Nat.pow_le_pow_left hm k
        calc W (m ^ k) = Real.log m / (m : ℝ) ^ k := hle
          _ = (if m ^ k = m ^ k then Real.log m / (m : ℝ) ^ k else 0) := by rw [if_pos rfl]
          _ ≤ ∑ k' ∈ Finset.Icc 2 N, (if m ^ k = m ^ k' then Real.log m / (m : ℝ) ^ k' else 0) :=
              Finset.single_le_sum
                (f := fun k' => if m ^ k = m ^ k' then Real.log m / (m : ℝ) ^ k' else 0)
                (fun k' _ => hnonneg _ m k') hkN
          _ ≤ ∑ m' ∈ Finset.Icc 2 N, ∑ k' ∈ Finset.Icc 2 N,
                (if m ^ k = m' ^ k' then Real.log m' / (m' : ℝ) ^ k' else 0) :=
              Finset.single_le_sum
                (f := fun m' => ∑ k' ∈ Finset.Icc 2 N,
                  (if m ^ k = m' ^ k' then Real.log m' / (m' : ℝ) ^ k' else 0))
                (fun m' _ => Finset.sum_nonneg fun k' _ => hnonneg _ m' k') hmN
    have hswap : ∑ n ∈ Finset.range (N + 1), ∑ m ∈ Finset.Icc 2 N, ∑ k ∈ Finset.Icc 2 N,
        (if n = m ^ k then Real.log m / (m : ℝ) ^ k else 0)
        ≤ ∑ m ∈ Finset.Icc 2 N, ∑ k ∈ Finset.Icc 2 N, Real.log m * ((m : ℝ)⁻¹) ^ k := by
      rw [Finset.sum_comm]
      apply Finset.sum_le_sum
      intro m _
      rw [Finset.sum_comm]
      apply Finset.sum_le_sum
      intro k _
      rw [Finset.sum_ite_eq']
      have he : Real.log m * ((m : ℝ)⁻¹) ^ k = Real.log m / (m : ℝ) ^ k := by
        rw [inv_pow]; ring
      rw [he]
      split_ifs
      · exact le_rfl
      · exact div_nonneg (Real.log_natCast_nonneg m) (by positivity)
    have hgeom : ∀ m ∈ Finset.Icc 2 N, ∑ k ∈ Finset.Icc 2 N, Real.log m * ((m : ℝ)⁻¹) ^ k ≤
        Real.log m / ((m : ℝ) * ((m : ℝ) - 1)) := by
      intro m hm
