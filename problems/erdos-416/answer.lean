      _ ≤ Real.exp (-(2*s)) := Real.exp_le_exp.mpr (by linarith)
  have P14 : Real.log x ^ (-37 / 36 : ℝ) ≤ 1 / (Real.log x * T ^ 2) := by
    rw [hLx, Real.rpow_def_of_pos (Real.exp_pos T), Real.log_exp]
    have e : 1 / (Real.exp T * T^2) = Real.exp (-(T + 2*s)) := by
      rw [hT2e, Real.exp_neg, ← Real.exp_add, one_div]
    rw [e]
    exact Real.exp_le_exp.mpr (by linarith)
  refine ⟨hx16, by linarith, P3, P4, P5, P6, P7, P8, P9, P10, P11, P12, ?_, P14, P15⟩
  rw [hs]; exact P13

theorem badFacet_uniform_density_of_envelope (hPNT : Tendsto (fun x : ℝ => (Nat.primeCounting ⌊x⌋₊ : ℝ) / (x / Real.log x)) atTop (𝓝 1))
    (hMERT : ∃ C : ℝ, ∀ x : ℝ, 2 ≤ x →
      |(∑ p ∈ (Finset.Iic ⌊x⌋₊).filter Nat.Prime, (1 : ℝ) / p) - Real.log (Real.log x)| ≤ C)
    (hEULER : Asymptotics.IsEquivalent atTop
      (fun x : ℝ => ∏ p ∈ (Finset.Iic ⌊x⌋₊).filter Nat.Prime, (1 - (1 : ℝ) / p))
      (fun x => Real.exp (-Real.eulerMascheroniConstant) / Real.log x))
    (hENV : ∃ B : ℝ, 0 < B ∧ ∀ᶠ x : ℝ in atTop, ∀ u : ℝ, 2 ≤ u → u ≤ x →
      ((totientsUpTo u).card : ℝ) ≤ Real.exp (B * Real.log (logLog x) ^ 2) * u / Real.log u) :
    ∃ C H : ℝ, 0 < C ∧ 0 ≤ H ∧ ∀ (k : ℕ) (x : ℝ),
      Real.exp (Real.exp (Real.exp ((k : ℝ) / 15 + H))) ≤ x →
      ((FordBadFacet.badFacetValues x k (FordRestricted.suffixMargin k)).card : ℝ) ≤
        C * (x / (Real.log x * logLog x ^ 2)) :=
by
  obtain ⟨B, hBpos, hEv⟩ := hENV
  obtain ⟨X₁, hX₁⟩ := Filter.eventually_atTop.mp hEv
  
  have hLSev : ∀ᶠ Y : ℝ in atTop,
      ((largeSquareTotients Y).card : ℝ) ≤ Y / (Real.log Y * (logLog Y) ^ 2) := by
    obtain ⟨D, hDpos, hsize⟩ := inverse_totient_size_bound hPNT hMERT hEULER
    have hsq := large_prime_square_count hDpos
    filter_upwards [hsize, hsq, eventually_ge_atTop (0 : ℝ)] with Y hY hsqY hY0
    refine le_trans ?_ hsqY
    have hsub : largeSquareTotients Y ⊆
        ((Finset.Icc 1 ⌊D * Y * logLog Y⌋₊).filter (fun n => ∃ q : ℕ, q.Prime ∧
          Real.log Y ^ 4 < (q : ℝ) ∧ (q ^ 2 ∣ n ∨ q ^ 2 ∣ n.totient))).image Nat.totient := by
      intro m hm
      unfold largeSquareTotients at hm
      rw [Finset.mem_filter] at hm
      obtain ⟨hmT, n, hn, hnm, hq⟩ := hm
      unfold totientsUpTo at hmT
      rw [Finset.mem_filter, Finset.mem_Icc] at hmT
      have hmY : (m : ℝ) ≤ Y := (Nat.le_floor_iff hY0).mp hmT.1.2
      have hnle : (n : ℝ) ≤ D * Y * logLog Y := hY n hn (by rw [hnm]; exact hmY)
      rw [Finset.mem_image]
      refine ⟨n, ?_, hnm⟩
      rw [Finset.mem_filter, Finset.mem_Icc]
      exact ⟨⟨hn, Nat.le_floor hnle⟩, hq⟩
    have hc := (Finset.card_le_card hsub).trans Finset.card_image_le
    exact_mod_cast hc
  obtain ⟨X₂, hX₂⟩ := Filter.eventually_atTop.mp hLSev
  obtain ⟨C₀, hC₀, hdens⟩ := nonnormal_prime_density_estimate hPNT hMERT hEULER
  obtain ⟨K₁, hK₁, hfin⟩ := nonnormal_totients_finite_bound
  obtain ⟨K₂, hK₂, hom⟩ := facet_omega_totients_rankin hMERT
  obtain ⟨C₃, B₀, hC₃, hB₀, hret⟩ := retained_facet_cover_count_of_family
    (interval_family_count hPNT hMERT hEULER) normal_preimage_interval_lower
  obtain ⟨H₀, hH₀, hpar⟩ := facet_suffix_parameter_calculus B B₀ hBpos.le hB₀
  refine ⟨K₁ * C₀ + 1 + K₂ + C₃, max H₀ (max X₁ X₂), by positivity,
    le_max_of_le_left hH₀, ?_⟩
  intro k x hx
  have hk0 : (0 : ℝ) ≤ (k : ℝ) / 15 := by positivity
  have hHx : max H₀ (max X₁ X₂) ≤ x := by
    have e1 := Real.add_one_le_exp ((k : ℝ) / 15 + max H₀ (max X₁ X₂))
    have e2 := Real.add_one_le_exp (Real.exp ((k : ℝ) / 15 + max H₀ (max X₁ X₂)))
    have e3 := Real.add_one_le_exp (Real.exp (Real.exp ((k : ℝ) / 15 + max H₀ (max X₁ X₂))))
    linarith
  have hxX₁ : X₁ ≤ x := le_trans (le_trans (le_max_left _ _) (le_max_right _ _)) hHx
  have hxX₂ : X₂ ≤ x := le_trans (le_trans (le_max_right _ _) (le_max_right _ _)) hHx
  have hx0 : Real.exp (Real.exp (Real.exp ((k : ℝ) / 15 + H₀))) ≤ x :=
    le_trans (Real.exp_le_exp.mpr (Real.exp_le_exp.mpr (Real.exp_le_exp.mpr
      (by linarith [le_max_left H₀ (max X₁ X₂)])))) hx
  obtain ⟨R, hR⟩ : ∃ R : ℝ, R = (FordRestricted.suffixMargin k / 2 /
      (32 * (((k + 1 : ℕ) : ℝ) ^ 2 * (1 + Real.log ((k + 1 : ℕ) : ℝ))))) ^ 2 * logLog x :=
    ⟨_, rfl⟩
  obtain ⟨S, hS⟩ : ∃ S : ℝ, S = Real.exp (Real.exp R) := ⟨_, rfl⟩
  obtain ⟨F, hF⟩ : ∃ F : ℝ, F = x ^ (1 / (20 * logLog x)) := ⟨_, rfl⟩
  obtain ⟨h, hh⟩ : ∃ h : ℝ, h = FordRestricted.suffixMargin k / (10 * ((k + 1 : ℕ) : ℝ) ^ 2) :=
    ⟨_, rfl⟩
  obtain ⟨P1, P2, P3, P4, P5, P6, P7, P8, P9, P10, P11, P12, P13, P14, P15⟩ :=
    hpar k x ((k + 1 : ℕ) : ℝ) (FordRestricted.suffixMargin k) (logLog x) R S F h hx0
      rfl rfl rfl hR hS hF hh
  have hω : 0 < FordRestricted.suffixMargin k := by
    unfold FordRestricted.suffixMargin; positivity
  have hS0 : 0 < S := by rw [hS]; exact Real.exp_pos _
  have hhpos : 0 < h := by rw [hh]; positivity
  have hx1 : 1 < x := by linarith
  have hlogx : 0 < Real.log x := Real.log_pos hx1
  have hT0 : 0 < logLog x := by linarith
  have hxe : Real.exp 1 ≤ x := by have := Real.exp_one_lt_d9; linarith
  
  have hsub : FordBadFacet.badFacetValues x k (FordRestricted.suffixMargin k) ⊆
      ((totientsUpTo x).filter (fun m => ∃ n : ℕ, 0 < n ∧ n.totient = m ∧
          ∃ q : ℕ, q.Prime ∧ q ∣ n ∧ ¬ SNormal S q)) ∪
        largeSquareTotients x ∪
        ((totientsUpTo x).filter (fun m => 5 * logLog x < (ArithmeticFunction.cardFactors m : ℝ))) ∪
        ((totientsUpTo x).filter (fun m => (∀ n : ℕ, 0 < n → n.totient = m → ∀ p : ℕ, p.Prime →
            p ∣ n → SNormal S p) ∧ NoLargePrimeSquare m S ∧
          (ArithmeticFunction.cardFactors m : ℝ) ≤ 5 * logLog x ∧ ∃ N : ℕ, 0 < N ∧
            N.totient = m ∧ NoLargePrimeSquare N (S / 2) ∧ 1 + FordRestricted.suffixMargin k ≤
              ∑ idx : Fin k, fordWeight (idx.val + 1) *
                FordBadFacet.ordinaryPrimeCoordinate (logLog x) N (idx.val + 1))) := by
    intro m hm
    obtain ⟨hmT, N, hN, hNm, hfacet⟩ := Finset.mem_filter.mp hm
    by_cases hNN : m ∈ (totientsUpTo x).filter (fun m => ∃ n : ℕ, 0 < n ∧ n.totient = m ∧
        ∃ q : ℕ, q.Prime ∧ q ∣ n ∧ ¬ SNormal S q)
    · exact Finset.mem_union_left _ (Finset.mem_union_left _ (Finset.mem_union_left _ hNN))
    by_cases hLS : m ∈ largeSquareTotients x
    · exact Finset.mem_union_left _ (Finset.mem_union_left _ (Finset.mem_union_right _ hLS))
    by_cases hOM : m ∈ (totientsUpTo x).filter
        (fun m => 5 * logLog x < (ArithmeticFunction.cardFactors m : ℝ))
    · exact Finset.mem_union_left _ (Finset.mem_union_right _ hOM)
    apply Finset.mem_union_right
    refine Finset.mem_filter.mpr ⟨hmT, ?_, ?_, ?_, N, hN, hNm, ?_, hfacet⟩
    · intro n hn hnm p hp hpn
      by_contra hns
      exact hNN (Finset.mem_filter.mpr ⟨hmT, n, hn, hnm, p, hp, hpn, hns⟩)
    · intro q hq hqS hdvd
      apply hLS
      unfold largeSquareTotients
      refine Finset.mem_filter.mpr ⟨hmT, N, hN, hNm, q, hq, by linarith, Or.inr ?_⟩
      rw [hNm]; exact hdvd
    · exact not_lt.mp (fun hlt => hOM (Finset.mem_filter.mpr ⟨hmT, hlt⟩))
    · intro q hq hqS hdvd
      apply hLS
      unfold largeSquareTotients
      exact Finset.mem_filter.mpr ⟨hmT, N, hN, hNm, q, hq, by linarith, Or.inl hdvd⟩
  have hcardU : ∀ (A₁ A₂ A₃ A₄ : Finset ℕ), ((A₁ ∪ A₂ ∪ A₃ ∪ A₄).card : ℝ) ≤
      (A₁.card : ℝ) + A₂.card + A₃.card + A₄.card := by
    intro A₁ A₂ A₃ A₄
    have h1 := Finset.card_union_le A₁ A₂
    have h2 := Finset.card_union_le (A₁ ∪ A₂) A₃
    have h3 := Finset.card_union_le (A₁ ∪ A₂ ∪ A₃) A₄
    exact_mod_cast (by omega : (A₁ ∪ A₂ ∪ A₃ ∪ A₄).card ≤ A₁.card + A₂.card + A₃.card + A₄.card)
  have hb4 := ((Nat.cast_le (α := ℝ)).mpr (Finset.card_le_card hsub)).trans (hcardU _ _ _ _)
  
  have hA1 : 1 ≤ Real.exp (B * Real.log (logLog x) ^ 2) := Real.one_le_exp (by positivity)
  have hNNb := hfin S x (Real.exp (B * Real.log (logLog x) ^ 2)) C₀ P3.le P1 hA1 hC₀.le
    (hX₁ x hxX₁) (fun z hz3 _ => hdens S z P3.le hz3)
  have P8' : Real.log (Real.log S) = R := P8
  have hLLx : Real.log (Real.log x) = logLog x := rfl
  have hq1 : K₁ * C₀ * Real.exp (B * Real.log (logLog x) ^ 2) * x / Real.log x *
      (1 + Real.log (Real.log x)) ^ 6 * Real.exp (-Real.log (Real.log S) / 6) ≤
      K₁ * C₀ * (x / (Real.log x * logLog x ^ 2)) := by
    rw [P8', hLLx]
    have hxl : 0 ≤ K₁ * C₀ * (x / Real.log x) := by
      have : 0 ≤ x / Real.log x := div_nonneg (by linarith) hlogx.le
      positivity
    calc K₁ * C₀ * Real.exp (B * Real.log (logLog x) ^ 2) * x / Real.log x *
          (1 + logLog x) ^ 6 * Real.exp (-R / 6)
        = K₁ * C₀ * (x / Real.log x) * (Real.exp (B * Real.log (logLog x) ^ 2) *
            (1 + logLog x) ^ 6 * Real.exp (-R / 6)) := by ring
      _ ≤ K₁ * C₀ * (x / Real.log x) * (1 / logLog x ^ 2) :=
          mul_le_mul_of_nonneg_left P13 hxl
      _ = K₁ * C₀ * (x / (Real.log x * logLog x ^ 2)) := by ring
  have hNNQ := hNNb.trans hq1
  
  have hLSb := hX₂ x hxX₂
  
  have hOMQ : (((totientsUpTo x).filter
      (fun m => 5 * logLog x < (ArithmeticFunction.cardFactors m : ℝ))).card : ℝ) ≤
      K₂ * (x / (Real.log x * logLog x ^ 2)) := by
    refine (hom x hxe).trans ?_
    calc K₂ * x * Real.log x ^ (-37 / 36 : ℝ) ≤ K₂ * x * (1 / (Real.log x * logLog x ^ 2)) :=
          mul_le_mul_of_nonneg_left P14 (by positivity)
      _ = K₂ * (x / (Real.log x * logLog x ^ 2)) := by ring
  
  have hRETb := hret x k h S F (FordRestricted.suffixMargin k) (FordRestricted.suffixMargin k / 2)
    (by linarith) P2 hhpos hω (by positivity) P3 P4 P5 P6 hF.le P7 P9 P10
  have hexpT : Real.exp (-logLog x) = 1 / Real.log x := by
    rw [Real.exp_neg]; unfold logLog; rw [Real.exp_log hlogx, one_div]
  have e1 : (((k + 1) * (⌊2 / h⌋₊ + 1) ^ k : ℕ) : ℝ) *
      Real.exp (-(1 + FordRestricted.suffixMargin k / 2 / 2) * logLog x) ≤
      1 / Real.log x * (1 / logLog x ^ 2) := by
    calc (((k + 1) * (⌊2 / h⌋₊ + 1) ^ k : ℕ) : ℝ) *
          Real.exp (-(1 + FordRestricted.suffixMargin k / 2 / 2) * logLog x)
        ≤ Real.exp (FordRestricted.suffixMargin k * logLog x / 8) *
          Real.exp (-(1 + FordRestricted.suffixMargin k / 2 / 2) * logLog x) :=
          mul_le_mul_of_nonneg_right P11 (Real.exp_pos _).le
      _ = Real.exp (-logLog x) * Real.exp (-(FordRestricted.suffixMargin k * logLog x / 8)) := by
          rw [← Real.exp_add, ← Real.exp_add]; congr 1; ring
      _ ≤ 1 / Real.log x * (1 / logLog x ^ 2) := by
          rw [hexpT]; exact mul_le_mul_of_nonneg_left P12 (by positivity)
  have hRETQ := hRETb.trans (show C₃ * x * (((k + 1) * (⌊2 / h⌋₊ + 1) ^ k : ℕ) : ℝ) *
      Real.exp (-(1 + FordRestricted.suffixMargin k / 2 / 2) * logLog x) ≤
      C₃ * (x / (Real.log x * logLog x ^ 2)) by
    calc C₃ * x * (((k + 1) * (⌊2 / h⌋₊ + 1) ^ k : ℕ) : ℝ) *
          Real.exp (-(1 + FordRestricted.suffixMargin k / 2 / 2) * logLog x)
        = C₃ * x * ((((k + 1) * (⌊2 / h⌋₊ + 1) ^ k : ℕ) : ℝ) *
          Real.exp (-(1 + FordRestricted.suffixMargin k / 2 / 2) * logLog x)) := by ring
      _ ≤ C₃ * x * (1 / Real.log x * (1 / logLog x ^ 2)) :=
          mul_le_mul_of_nonneg_left e1 (by positivity)
      _ = C₃ * (x / (Real.log x * logLog x ^ 2)) := by ring)
  
  refine hb4.trans ((add_le_add (add_le_add (add_le_add hNNQ hLSb) hOMQ) hRETQ).trans
    (le_of_eq (by ring)))

theorem firstFailedExceptionalValues_negligible_in_V (hPNT : Tendsto (fun x : ℝ => (Nat.primeCounting ⌊x⌋₊ : ℝ) / (x / Real.log x)) atTop (𝓝 1))
    (hMERT : ∃ C : ℝ, ∀ x : ℝ, 2 ≤ x →
      |(∑ p ∈ (Finset.Iic ⌊x⌋₊).filter Nat.Prime, (1 : ℝ) / p) - Real.log (Real.log x)| ≤ C)
    (hEULER : Asymptotics.IsEquivalent atTop
      (fun x : ℝ => ∏ p ∈ (Finset.Iic ⌊x⌋₊).filter Nat.Prime, (1 - (1 : ℝ) / p))
      (fun x => Real.exp (-Real.eulerMascheroniConstant) / Real.log x))
    (hRHO : 0 < FordAnalysis.rho ∧ FordAnalysis.rho < 3 / 4 ∧ FordAnalysis.F FordAnalysis.rho = 1) :
    (fun x : ℝ => ((FordBadFacet.firstFailedExceptionalValues x
      (FordScale.optimalDimension (logLog x))).card : ℝ)) =o[atTop] V :=
by
  have hLL : Tendsto logLog atTop atTop :=
    Real.tendsto_log_atTop.comp Real.tendsto_log_atTop
  have hVlow := (V_lower_bound_and_power_cutoff hPNT).1
  
  have hD : ∀ (f : ℝ → ℝ) (C : ℝ), 0 ≤ C → (∀ x, 0 ≤ f x) →
      (∀ᶠ x : ℝ in atTop, f x ≤ C * (x / (Real.log x * logLog x ^ 2))) → f =o[atTop] V := by
    intro f C hC hf0 hf
    rw [Asymptotics.isLittleO_iff]
    intro c hc
    filter_upwards [hf, hVlow, hLL.eventually_ge_atTop (max 1 (2 * C / c)),
      eventually_gt_atTop (1 : ℝ)] with x hfx hV hT hx
    have hT1 : 1 ≤ logLog x := le_trans (le_max_left _ _) hT
    have hTC : 2 * C / c ≤ logLog x := le_trans (le_max_right _ _) hT
    have hlog : 0 < Real.log x := Real.log_pos hx
    have hTs : 0 < logLog x ^ 2 := by positivity
    have hx0 : 0 < x := by linarith
    have hV' : x / Real.log x ≤ 2 * V x := by
      rw [div_le_iff₀ hlog]
      have hv := (div_le_iff₀ (by positivity : 0 < 2 * Real.log x)).mp hV
      nlinarith
    have hVn : 0 ≤ V x := by positivity
    have hcoeff : C / logLog x ^ 2 ≤ c / 2 := by
      rw [div_le_iff₀ hTs]
      have he := (div_le_iff₀ hc).mp hTC
      have hsq : logLog x ≤ logLog x ^ 2 := by nlinarith
      have := mul_le_mul_of_nonneg_right hsq hc.le
      nlinarith
    rw [Real.norm_eq_abs, Real.norm_eq_abs, abs_of_nonneg (hf0 x), abs_of_nonneg hVn]
    calc
      f x ≤ C * (x / (Real.log x * logLog x ^ 2)) := hfx
      _ = (C / logLog x ^ 2) * (x / Real.log x) := by
        field_simp
      _ ≤ (c / 2) * (2 * V x) :=
        mul_le_mul hcoeff hV' (div_nonneg hx0.le hlog.le) (by positivity)
      _ = c * V x := by ring
  
  have hs2 : (fun x : ℝ => ((totientsUpTo (Real.sqrt x)).card : ℝ)) =o[atTop] V := by
    have hlogo : Real.log =o[atTop] (fun x : ℝ => x ^ (1 / 2 : ℝ)) :=
      isLittleO_log_rpow_atTop (by norm_num)
    rw [Asymptotics.isLittleO_iff]
    intro c hc
    filter_upwards [hlogo.bound (by positivity : (0 : ℝ) < c / 2), hVlow,
      eventually_gt_atTop (1 : ℝ)] with x hlx hV hx
    have hx0 : 0 < x := by linarith
    have hlog : 0 < Real.log x := Real.log_pos hx
    have hsq0 : 0 ≤ Real.sqrt x := Real.sqrt_nonneg x
    have hrp : x ^ (1 / 2 : ℝ) = Real.sqrt x := (Real.sqrt_eq_rpow x).symm
    rw [Real.norm_eq_abs, Real.norm_eq_abs, abs_of_pos hlog, hrp, abs_of_nonneg hsq0] at hlx
    have hcard : ((totientsUpTo (Real.sqrt x)).card : ℝ) ≤ Real.sqrt x := by
      have h1 : (totientsUpTo (Real.sqrt x)).card ≤ ⌊Real.sqrt x⌋₊ := by
        have := Finset.card_filter_le (Finset.Icc 1 ⌊Real.sqrt x⌋₊)
          (fun n => ∃ m : ℕ, m.totient = n)
        rw [Nat.card_Icc] at this
        unfold totientsUpTo
        omega
      have h2 : ((totientsUpTo (Real.sqrt x)).card : ℝ) ≤ (⌊Real.sqrt x⌋₊ : ℝ) := by
        exact_mod_cast h1
      exact h2.trans (Nat.floor_le hsq0)
    have hVn : 0 ≤ V x := by positivity
    rw [Real.norm_eq_abs, Real.norm_eq_abs, abs_of_nonneg (Nat.cast_nonneg _), abs_of_nonneg hVn]
    have hss : Real.sqrt x * Real.sqrt x = x := Real.mul_self_sqrt hx0.le
    have hkey : Real.sqrt x * (2 * Real.log x) ≤ c * x := by
      have := mul_le_mul_of_nonneg_left hlx hsq0
      nlinarith
    have hmid : Real.sqrt x ≤ c * (x / (2 * Real.log x)) := by
      rw [mul_div_assoc', le_div_iff₀ (by positivity)]
      exact hkey
    calc ((totientsUpTo (Real.sqrt x)).card : ℝ) ≤ Real.sqrt x := hcard
      _ ≤ c * (x / (2 * Real.log x)) := hmid
      _ ≤ c * V x := mul_le_mul_of_nonneg_left hV hc.le
  
  have hs3 := fiveLogOmegaTotients_negligible_in_V hPNT hMERT
  
  have hs4 : (fun x : ℝ => ((largeSquareTotients x).card : ℝ)) =o[atTop] V := by
    obtain ⟨D, hDpos, hsize⟩ := inverse_totient_size_bound hPNT hMERT hEULER
    have hsq := large_prime_square_count hDpos
    refine hD _ 1 zero_le_one (fun _ => Nat.cast_nonneg _) ?_
    filter_upwards [hsize, hsq, eventually_ge_atTop (0 : ℝ)] with Y hY hsqY hY0
    rw [one_mul]
    refine le_trans ?_ hsqY
    have hsub : largeSquareTotients Y ⊆
        ((Finset.Icc 1 ⌊D * Y * logLog Y⌋₊).filter (fun n => ∃ q : ℕ, q.Prime ∧
          Real.log Y ^ 4 < (q : ℝ) ∧ (q ^ 2 ∣ n ∨ q ^ 2 ∣ n.totient))).image Nat.totient := by
      intro m hm
      unfold largeSquareTotients at hm
      rw [Finset.mem_filter] at hm
      obtain ⟨hmT, n, hn, hnm, hq⟩ := hm
      unfold totientsUpTo at hmT
      rw [Finset.mem_filter, Finset.mem_Icc] at hmT
      have hmY : (m : ℝ) ≤ Y := (Nat.le_floor_iff hY0).mp hmT.1.2
      have hnle : (n : ℝ) ≤ D * Y * logLog Y := hY n hn (by rw [hnm]; exact hmY)
      rw [Finset.mem_image]
      refine ⟨n, ?_, hnm⟩
      rw [Finset.mem_filter, Finset.mem_Icc]
      exact ⟨⟨hn, Nat.le_floor hnle⟩, hq⟩
    have hc := (Finset.card_le_card hsub).trans Finset.card_image_le
    exact_mod_cast hc
  
  obtain ⟨C, H, hC, hH, hdens⟩ :=
    badFacet_uniform_density_of_envelope hPNT hMERT hEULER
      (totient_envelope_growth hPNT hMERT hEULER)
  
  have hmarg : FordRestricted.suffixMargin 2 ≤ 1 / 1000 := by
    unfold FordRestricted.suffixMargin
    have : Real.exp (-((2 : ℕ) : ℝ) / 40) ≤ 1 := Real.exp_le_one_iff.mpr (by norm_num)
    have hpos : 0 < Real.exp (-((2 : ℕ) : ℝ) / 40) := Real.exp_pos _
    nlinarith
  have hs7a : (fun x : ℝ => ((FordBadFacet.badFacetValues x 2 (1 / 1000)).card : ℝ)) =o[atTop] V := by
    refine hD _ C hC.le (fun _ => Nat.cast_nonneg _) ?_
    filter_upwards [eventually_ge_atTop
      (Real.exp (Real.exp (Real.exp (((2 : ℕ) : ℝ) / 15 + H))))] with x hx
    have hsub : FordBadFacet.badFacetValues x 2 (1 / 1000) ⊆
        FordBadFacet.badFacetValues x 2 (FordRestricted.suffixMargin 2) := by
      intro m hm
      unfold FordBadFacet.badFacetValues at hm ⊢
      rw [Finset.mem_filter] at hm ⊢
      obtain ⟨hmT, N, hN, hNm, hsum⟩ := hm
      exact ⟨hmT, N, hN, hNm, le_trans (by linarith) hsum⟩
    have h1 := hdens 2 x hx
    have h2 : ((FordBadFacet.badFacetValues x 2 (1 / 1000)).card : ℝ) ≤
        ((FordBadFacet.badFacetValues x 2 (FordRestricted.suffixMargin 2)).card : ℝ) := by
      exact_mod_cast Finset.card_le_card hsub
    exact h2.trans h1
  
  have hdim : ∀ t : ℝ, Real.exp 1 ≤ t →
      (FordScale.optimalDimension t : ℝ) ≤ 4 * Real.log t := by
    intro t ht
    have hρ0 := hRHO.1
    have hρ1 := hRHO.2.1
    have hlog34 : Real.log (3 / 4) < -1 / 4 := by
      rw [Real.log_lt_iff_lt_exp (by norm_num)]
      have := Real.add_one_lt_exp (x := (-1 / 4 : ℝ)) (by norm_num)
      linarith
    have hlρ : Real.log FordAnalysis.rho < Real.log (3 / 4) := Real.log_lt_log hρ0 hρ1
    have habs : |Real.log FordAnalysis.rho| = -Real.log FordAnalysis.rho :=
      abs_of_neg (by linarith)
    have hapos : 0 < 2 * |Real.log FordAnalysis.rho| := by rw [habs]; linarith
    have hCdef : FordAnalysis.C = (2 * |Real.log FordAnalysis.rho|)⁻¹ := rfl
    have hCpos : 0 < FordAnalysis.C := by rw [hCdef]; exact inv_pos.mpr hapos
    have hCmul : FordAnalysis.C * (2 * |Real.log FordAnalysis.rho|) = 1 := by
      rw [hCdef]; exact inv_mul_cancel₀ hapos.ne'
    have hClt : FordAnalysis.C < 2 := by
      rw [habs] at hCmul
      nlinarith
    have hlogt : 1 ≤ Real.log t := by
      have := Real.log_le_log (Real.exp_pos 1) ht
      rwa [Real.log_exp] at this
    have hloglogt : 0 ≤ Real.log (Real.log t) := Real.log_nonneg hlogt
    have hbound : 2 * FordAnalysis.C * (Real.log t - Real.log (Real.log t)) ≤
        4 * Real.log t := by
      nlinarith
    unfold FordScale.optimalDimension
    by_cases hu : 0 ≤ 2 * FordAnalysis.C * (Real.log t - Real.log (Real.log t))
    · exact (Nat.floor_le hu).trans hbound
    · rw [Nat.floor_of_nonpos (le_of_not_ge hu)]
      simp only [Nat.cast_zero]
      linarith
  have hs7b : (fun x : ℝ => ((FordBadFacet.badFacetValues x
      (FordScale.optimalDimension (logLog x))
      (FordRestricted.suffixMargin (FordScale.optimalDimension (logLog x)))).card : ℝ)) =o[atTop] V := by
    refine hD _ C hC.le (fun _ => Nat.cast_nonneg _) ?_
    filter_upwards [hLL.eventually_ge_atTop (Real.exp 1),
      (Real.tendsto_log_atTop.comp hLL).eventually_ge_atTop (15 * H / 11),
      eventually_gt_atTop (1 : ℝ)] with x hTe hlT hx
    rw [Function.comp_apply] at hlT
    apply hdens
    have hx0 : 0 < x := by linarith
    have hlog : 0 < Real.log x := Real.log_pos hx
    have hT0 : 0 < logLog x := lt_of_lt_of_le (Real.exp_pos 1) hTe
    have hA := hdim (logLog x) hTe
    have h1 : ((FordScale.optimalDimension (logLog x) : ℕ) : ℝ) / 15 + H ≤
        Real.log (logLog x) := by linarith
    have h2 : Real.exp (((FordScale.optimalDimension (logLog x) : ℕ) : ℝ) / 15 + H) ≤
        logLog x := by
      calc _ ≤ Real.exp (Real.log (logLog x)) := Real.exp_le_exp.mpr h1
        _ = logLog x := Real.exp_log hT0
    have h3 : Real.exp (Real.exp (((FordScale.optimalDimension (logLog x) : ℕ) : ℝ) / 15 + H)) ≤
        Real.log x := by
      calc _ ≤ Real.exp (logLog x) := Real.exp_le_exp.mpr h2
        _ = Real.log x := by unfold logLog; exact Real.exp_log hlog
    calc _ ≤ Real.exp (Real.log x) := Real.exp_le_exp.mpr h3
      _ = x := Real.exp_log hx0
  
  have hsum := (((hs2.add hs7a).add hs3).add hs4).add hs7b
  refine Asymptotics.IsBigO.trans_isLittleO ?_ hsum
  apply Asymptotics.isBigO_of_le
  intro x
  have hcu : ∀ (A B C D E : Finset ℕ), ((A ∪ B ∪ C ∪ D ∪ E).card : ℝ) ≤
      (A.card : ℝ) + B.card + C.card + D.card + E.card := by
    intro A B C D E
    have h1 := Finset.card_union_le A B
    have h2 := Finset.card_union_le (A ∪ B) C
    have h3 := Finset.card_union_le (A ∪ B ∪ C) D
    have h4 := Finset.card_union_le (A ∪ B ∪ C ∪ D) E
    exact_mod_cast (by omega : (A ∪ B ∪ C ∪ D ∪ E).card ≤
      A.card + B.card + C.card + D.card + E.card)
  have hle := hcu (totientsUpTo (Real.sqrt x)) (FordBadFacet.badFacetValues x 2 (1 / 1000))
    (fiveLogOmegaTotients x) (largeSquareTotients x)
    (FordBadFacet.badFacetValues x (FordScale.optimalDimension (logLog x))
      (FordRestricted.suffixMargin (FordScale.optimalDimension (logLog x))))
  rw [Real.norm_eq_abs, Real.norm_eq_abs, abs_of_nonneg (Nat.cast_nonneg _),
    abs_of_nonneg (by positivity)]
  unfold FordBadFacet.firstFailedExceptionalValues
  exact hle

theorem polytopeFailure_subset_firstFailed_rows {x : ℝ} {A L : ℕ}
    (hx : Real.exp 1 ≤ x) (hT : 0 < logLog x) (hL : 2 ≤ L) (hLA : L ≤ A) :
    FordBadFacet.polytopeFailureValues x L (FordGeometry.expandedParameter A) ⊆
      FordBadFacet.firstFailedExceptionalValues x A ∪
        (Finset.Ico 1 (L - 1)).biUnion (FordBadFacet.retainedFirstFailedValues x A L) :=
by
  classical
  
  have hw : ∀ n : ℕ, 1 ≤ n → 0 ≤ fordWeight n := by
    intro n hn
    have ha : (1 : ℝ) ≤ n := by exact_mod_cast hn
    have ha0 : (0 : ℝ) < n := by linarith
    have hdiv : 0 < ((n : ℝ) + 1) / n := by positivity
    have h1 := Real.one_sub_inv_le_log_of_pos hdiv
    rw [Real.log_div (by linarith) (by linarith), inv_div] at h1
    have hlogn : 0 ≤ Real.log n := Real.log_nonneg ha
    have hmul := mul_le_mul_of_nonneg_left h1 (by linarith : (0 : ℝ) ≤ (n : ℝ) + 1)
    have hid : ((n : ℝ) + 1) * (1 - (n : ℝ) / ((n : ℝ) + 1)) = 1 := by
      field_simp
      ring
    rw [hid] at hmul
    have hfw : fordWeight n = ((n : ℝ) + 1) * (Real.log ((n : ℝ) + 1) - Real.log n) +
        Real.log n - 1 := by
      unfold fordWeight
      ring
    rw [hfw]
    linarith
  
  have hplm : ∀ a b : ℝ, 1 ≤ a → a ≤ b →
      FordBadFacet.positiveLogLog a ≤ FordBadFacet.positiveLogLog b := by
    intro a b ha hab
    unfold FordBadFacet.positiveLogLog logLog
    rcases eq_or_lt_of_le ha with h | h
    · rw [← h]
      simp only [Real.log_one, Real.log_zero, max_self]
      exact le_max_left _ _
    · apply max_le_max_left
      have hla : 0 < Real.log a := Real.log_pos h
      exact Real.log_le_log hla (Real.log_le_log (by linarith) hab)
  
  have hone : ∀ N idx : ℕ, 1 ≤ FordBadFacet.ordinaryPrimeAt N idx := by
    intro N idx
    show 1 ≤ (N.primeFactorsList.reverse).getD idx 1
    by_cases hi : idx < (N.primeFactorsList.reverse).length
    · rw [List.getD_eq_getElem _ 1 hi]
      have hm : (N.primeFactorsList.reverse)[idx] ∈ N.primeFactorsList :=
        List.mem_reverse.mp (List.getElem_mem hi)
      exact (Nat.prime_of_mem_primeFactorsList hm).one_le
    · rw [List.getD_eq_default _ _ (by omega)]
  have hantiP : ∀ N : ℕ, Antitone (FordBadFacet.ordinaryPrimeAt N) := by
    intro N i j hij
    have hs : (N.primeFactorsList.reverse).SortedGE := (Nat.primeFactorsList_sorted N).reverse
    by_cases hj : j < (N.primeFactorsList.reverse).length
    · have hi : i < (N.primeFactorsList.reverse).length := lt_of_le_of_lt hij hj
      show (N.primeFactorsList.reverse).getD j 1 ≤ (N.primeFactorsList.reverse).getD i 1
      rw [List.getD_eq_getElem _ 1 hi, List.getD_eq_getElem _ 1 hj]
      exact hs.antitone_get hij
    · have h1 : FordBadFacet.ordinaryPrimeAt N j = 1 := by
        show (N.primeFactorsList.reverse).getD j 1 = 1
        exact List.getD_eq_default _ _ (by omega)
      rw [h1]
      exact hone N i
  
  have hsec : ∀ N : ℕ, 0 < N → FordBadFacet.ordinaryPrimeAt N 1 ≤ N.totient := by
    intro N hN
    have hprod0 : (N.primeFactorsList.reverse).prod = N := by
      rw [List.prod_reverse, Nat.prod_primeFactorsList hN.ne']
    have hmem : ∀ p ∈ N.primeFactorsList.reverse, p.Prime := fun p hp =>
      Nat.prime_of_mem_primeFactorsList (List.mem_reverse.mp hp)
    have hant : (N.primeFactorsList.reverse).getD 1 1 ≤ (N.primeFactorsList.reverse).getD 0 1 :=
      hantiP N (show 0 ≤ 1 by omega)
    have htot : 1 ≤ N.totient := Nat.totient_pos.mpr hN
    show (N.primeFactorsList.reverse).getD 1 1 ≤ N.totient
    generalize N.primeFactorsList.reverse = l at hprod0 hmem hant ⊢
    rcases l with _ | ⟨p, _ | ⟨q, r⟩⟩
    · simpa using htot
    · simpa using htot
    · simp only [List.getD_cons_succ, List.getD_cons_zero] at hant ⊢
      have hp : p.Prime := hmem p (by simp)
      have hq : q.Prime := hmem q (by simp)
      have hd : p * q ∣ N := ⟨r.prod, by rw [← hprod0]; simp [List.prod_cons, mul_assoc]⟩
      have ht := Nat.le_of_dvd (Nat.totient_pos.mpr hN) (Nat.totient_dvd_of_dvd hd)
      have hpq : q ≤ (p * q).totient := by
        by_cases he : p = q
        · subst he
          rw [Nat.totient_mul_of_prime_of_dvd hp dvd_rfl, Nat.totient_prime hp]
          have h := hp.two_le
          exact Nat.le_mul_of_pos_right p (by omega)
        · have hqp' : q ≤ p - 1 := by omega
          have hq1 : 1 ≤ q - 1 := by have := hq.two_le; omega
          have hs := Nat.totient_super_multiplicative p q
          rw [Nat.totient_prime hp, Nat.totient_prime hq] at hs
          exact hqp'.trans ((Nat.le_mul_of_pos_right (p - 1) (by omega)).trans hs)
      exact hpq.trans ht
  
  have hsplit : ∀ (a n : ℕ) (g : ℕ → ℝ), (∀ k < a, g k = 0) →
      ∑ k ∈ Finset.range (a + n), g k = ∑ i ∈ Finset.range n, g (a + i) := by
    intro a n g hg
    rw [Finset.sum_range_add, Finset.sum_eq_zero (fun k hk => hg k (Finset.mem_range.mp hk)),
      zero_add]
  have hmem_of_rows : ∀ (ξ q : ℕ → ℝ), (∀ i, 0 ≤ q i) → (∀ i, 1 ≤ i → q i ≤ 1) → Antitone q →
      (∀ i, 1 ≤ ξ i) → (∀ j, j + 1 < L → FordBadFacet.RowHolds L ξ q j) →
      (fun idx : Fin L => q (idx.val + 1)) ∈ FordGeometry.polytope L ξ := by
    intro ξ q hq0 hq1 hqa hξ hrows
    refine ⟨fun idx => hq0 _, fun idx => hq1 _ (by omega), ?_, ?_, ?_⟩
    · intro i j hij
      exact hqa (Nat.add_le_add_right (Fin.le_def.mp hij) 1)
    · have h0 := hrows 0 (by omega)
      simp only [FordBadFacet.RowHolds, if_pos rfl, FordBadFacet.shiftedFacet, Nat.zero_add] at h0
      show ∑ i : Fin L, fordWeight (i.val + 1) * q (i.val + 1) ≤ ξ 0
      exact h0
    · intro idx hi
      show ∑ k : Fin L, FordGeometry.tailWeight idx k * q (k.val + 1) ≤ ξ (idx.val + 1) * q (idx.val + 1)
      by_cases hrow : idx.val + 2 < L
      · have hh := hrows (idx.val + 1) hrow
        simp only [FordBadFacet.RowHolds, if_neg (Nat.succ_ne_zero _)] at hh
        have hstar : ∑ k : Fin L, FordGeometry.tailWeight idx k * q (k.val + 1) =
            FordBadFacet.shiftedFacet q (idx.val + 1) (L - (idx.val + 1)) := by
          have e1 : ∑ k : Fin L, FordGeometry.tailWeight idx k * q (k.val + 1) =
              ∑ k : Fin L, (fun k : ℕ => if idx.val < k then fordWeight (k - idx.val) * q (k + 1)
                else 0) k.val := by
            apply Finset.sum_congr rfl
            intro k _
            unfold FordGeometry.tailWeight
            by_cases hk : idx.val < k.val
            · simp [hk, hrow]
            · simp [hk]
          rw [e1, Fin.sum_univ_eq_sum_range (fun k : ℕ => if idx.val < k then
            fordWeight (k - idx.val) * q (k + 1) else 0) L]
          have e2 := hsplit (idx.val + 1) (L - (idx.val + 1)) (fun k : ℕ => if idx.val < k then
            fordWeight (k - idx.val) * q (k + 1) else 0) (by
              intro k hk
              simp only
              rw [if_neg (by omega)])
          rw [Nat.add_sub_cancel' (by omega)] at e2
          rw [e2]
          unfold FordBadFacet.shiftedFacet
          rw [Fin.sum_univ_eq_sum_range (fun i : ℕ => fordWeight (i + 1) * q (idx.val + 1 + i + 1))
            (L - (idx.val + 1))]
          apply Finset.sum_congr rfl
          intro i _
          simp only
          rw [if_pos (by omega)]
          congr 2
          omega
        rw [hstar]
        exact hh
      · have hiL : idx.val + 2 = L := by omega
        have hlast : ∑ k : Fin L, FordGeometry.tailWeight idx k * q (k.val + 1) =
            q (idx.val + 2) := by
          rw [Finset.sum_eq_single (⟨idx.val + 1, by omega⟩ : Fin L)]
          · simp [FordGeometry.tailWeight, show ¬ idx.val + 2 < L by omega]
          · intro k _ hkj
            have hne : k.val ≠ idx.val + 1 := fun h => hkj (Fin.ext h)
            have hk := k.isLt
            have hki : ¬ idx.val < k.val := by omega
            simp [FordGeometry.tailWeight, hki]
          · simp
        rw [hlast]
        exact (hqa (show idx.val + 1 ≤ idx.val + 2 by omega)).trans
          (le_mul_of_one_le_left (hq0 _) (hξ _))
  
  have hx0 : (0 : ℝ) ≤ x := (Real.exp_pos 1).le.trans hx
  intro m hm
  obtain ⟨hmV, N, hN, hNm, hnot⟩ := Finset.mem_filter.mp hm
  have hmV' := hmV
  unfold totientsUpTo at hmV'
  obtain ⟨hmIcc, hmtot⟩ := Finset.mem_filter.mp hmV'
  obtain ⟨hm1, hmx⟩ := Finset.mem_Icc.mp hmIcc
  have hphi : (N.totient : ℝ) ≤ x := by
    rw [hNm]
    exact (Nat.le_floor_iff hx0).mp hmx
  simp only [FordBadFacet.firstFailedExceptionalValues, Finset.mem_union]
  by_cases hsmall : (m : ℝ) ≤ Real.sqrt x
  · refine Or.inl (Or.inl (Or.inl (Or.inl (Or.inl ?_))))
    unfold totientsUpTo
    exact Finset.mem_filter.mpr ⟨Finset.mem_Icc.mpr ⟨hm1, Nat.le_floor hsmall⟩, hmtot⟩
  by_cases hbad : m ∈ FordBadFacet.badFacetValues x 2 (1 / 1000)
  · exact Or.inl (Or.inl (Or.inl (Or.inl (Or.inr hbad))))
  by_cases hΩ : m ∈ fiveLogOmegaTotients x
  · exact Or.inl (Or.inl (Or.inl (Or.inr hΩ)))
  by_cases hSq : m ∈ largeSquareTotients x
  · exact Or.inl (Or.inl (Or.inr hSq))
  
  set q : ℕ → ℝ := FordBadFacet.ordinaryPrimeCoordinate (logLog x) N with hqdef
  have hqi : ∀ i, q i = FordBadFacet.positiveLogLog (FordBadFacet.ordinaryPrimeAt N i : ℝ) /
      logLog x := fun i => rfl
  have hq0 : ∀ i, 0 ≤ q i := by
    intro i
    rw [hqi]
    exact div_nonneg (le_max_left _ _) hT.le
  have hqa : Antitone q := by
    intro i j hij
    rw [hqi, hqi]
    apply div_le_div_of_nonneg_right _ hT.le
    exact hplm _ _ (by exact_mod_cast hone N j) (by exact_mod_cast hantiP N hij)
  have hq1 : ∀ i, 1 ≤ i → q i ≤ 1 := by
    intro i hi
    rw [hqi]
    have hp : (FordBadFacet.ordinaryPrimeAt N i : ℝ) ≤ x :=
      (Nat.cast_le.mpr ((hantiP N hi).trans (hsec N hN))).trans hphi
    have hlog := hplm _ _ (by exact_mod_cast hone N i) hp
    have hxx : FordBadFacet.positiveLogLog x = logLog x := max_eq_right hT.le
    rw [hxx] at hlog
    exact (div_le_one hT).mpr hlog
  have hξ : ∀ j, 1 ≤ FordGeometry.expandedParameter A j := by
    intro j
    unfold FordGeometry.expandedParameter
    have := Real.exp_pos (-(((A : ℝ) - j) / 40))
    linarith
  
  have hex : ∃ j, j + 1 < L ∧ ¬ FordBadFacet.RowHolds L (FordGeometry.expandedParameter A) q j := by
    by_contra hcon
    push_neg at hcon
    exact hnot (hmem_of_rows _ q hq0 hq1 hqa hξ hcon)
  have hspec := Nat.find_spec hex
  have hfirst : FordBadFacet.FirstFailedRow L (FordGeometry.expandedParameter A) q (Nat.find hex) := by
    refine ⟨hspec.1, hspec.2, ?_⟩
    intro idx hidx
    by_contra hi
    exact Nat.find_min hex hidx ⟨by omega, hi⟩
  by_cases hj0 : Nat.find hex = 0
  · 
    refine Or.inl (Or.inr ?_)
    have hfail : FordGeometry.expandedParameter A 0 <
        ∑ i : Fin L, fordWeight (i.val + 1) * q (i.val + 1) := by
      have h := hspec.2
      rw [hj0] at h
      unfold FordBadFacet.RowHolds at h
      rw [if_pos rfl] at h
      unfold FordBadFacet.shiftedFacet at h
      simp only [Nat.zero_add] at h
      exact lt_of_not_ge h
    have hmargin : FordGeometry.expandedParameter A 0 = 1 + FordRestricted.suffixMargin A := by
      unfold FordGeometry.expandedParameter FordRestricted.suffixMargin
      rw [show (-(((A : ℝ) - ((0 : ℕ) : ℝ)) / 40)) = -(A : ℝ) / 40 by push_cast; ring]
    have eL : ∑ i : Fin L, fordWeight (i.val + 1) * q (i.val + 1) =
        ∑ i ∈ Finset.range L, fordWeight (i + 1) * q (i + 1) :=
      Fin.sum_univ_eq_sum_range (fun i => fordWeight (i + 1) * q (i + 1)) L
    have eA : ∑ i : Fin A, fordWeight (i.val + 1) * q (i.val + 1) =
        ∑ i ∈ Finset.range A, fordWeight (i + 1) * q (i + 1) :=
      Fin.sum_univ_eq_sum_range (fun i => fordWeight (i + 1) * q (i + 1)) A
    have hmono : ∑ i ∈ Finset.range L, fordWeight (i + 1) * q (i + 1) ≤
        ∑ i ∈ Finset.range A, fordWeight (i + 1) * q (i + 1) :=
      Finset.sum_le_sum_of_subset_of_nonneg (Finset.range_mono hLA)
        (fun i _ _ => mul_nonneg (hw (i + 1) (by omega)) (hq0 _))
    have hsum : 1 + FordRestricted.suffixMargin A ≤
        ∑ i : Fin A, fordWeight (i.val + 1) * q (i.val + 1) := by
      rw [eA, ← hmargin]
      rw [eL] at hfail
      exact (hfail.trans_le hmono).le
    exact Finset.mem_filter.mpr ⟨hmV, N, hN, hNm, hsum⟩
  · 
    right
    refine Finset.mem_biUnion.mpr ⟨Nat.find hex, Finset.mem_Ico.mpr ⟨by omega, by omega⟩, ?_⟩
    exact Finset.mem_filter.mpr ⟨Finset.mem_filter.mpr ⟨hmV, N, hN, hNm, hfirst⟩,
      (lt_of_not_ge hsmall).le, hbad, hΩ, hSq⟩

theorem retained_top_prime_log_lower : ∀ᶠ x : ℝ in atTop, ∀ N : ℕ, 0 < N → N.totient ∈ totientsUpTo x →
      Real.sqrt x ≤ (N.totient : ℝ) →
      N.totient ∉ FordBadFacet.badFacetValues x 2 (1 / 1000) →
      N.totient ∉ fiveLogOmegaTotients x → N.totient ∉ largeSquareTotients x →
      (FordBadFacet.ordinaryPrimeAt N 0).Prime ∧
        Real.log x / 6 ≤ Real.log (FordBadFacet.ordinaryPrimeAt N 0) :=
by
  
  have s1 : ∀ N : ℕ,
      ArithmeticFunction.cardFactors N ≤ ArithmeticFunction.cardFactors N.totient + 1 := by
    have key : ∀ n : ℕ, ArithmeticFunction.cardFactors n ≤
        ArithmeticFunction.cardFactors n.totient + (if 2 ∣ n then 1 else 0) := by
      intro n
      induction n using Nat.recOnPosPrimePosCoprime with
      | prime_pow p k hp hk =>
        rw [ArithmeticFunction.cardFactors_apply_prime_pow hp, Nat.totient_prime_pow hp hk]
        have hp2 := hp.two_le
        rw [ArithmeticFunction.cardFactors_mul (pow_ne_zero _ (by omega)) (by omega),
          ArithmeticFunction.cardFactors_apply_prime_pow hp]
        by_cases h2 : p = 2
        · subst h2
          have : 2 ∣ 2 ^ k := dvd_pow_self 2 (by omega)
          rw [if_pos this]
          omega
        · have hne : ArithmeticFunction.cardFactors (p - 1) ≠ 0 := by
            intro h0
            rcases (ArithmeticFunction.cardFactors_eq_zero_iff_eq_zero_or_one).mp h0 with h | h <;>
              omega
          split_ifs <;> omega
      | zero => simp
      | one => simp
      | coprime a b ha hb hab iha ihb =>
        rw [ArithmeticFunction.cardFactors_mul (by omega) (by omega), Nat.totient_mul hab,
