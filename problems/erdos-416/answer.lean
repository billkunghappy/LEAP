    exact ⟨h2.two_le, (Nat.le_floor_iff hz0.le).mp h1⟩
  have hQd : ∀ x : ℝ, 2 ≤ x → x ≤ z →
      ((Q.filter (fun q : ℕ => (q : ℝ) ≤ x)).card : ℝ) ≤ D * x / Real.log x := by
    intro x hx2 hxz
    have hx0 : 0 < x := by linarith
    have hlogx : 0 < Real.log x := Real.log_pos (by linarith)
    have hsub : Q.filter (fun q : ℕ => (q : ℝ) ≤ x) ⊆
        (Finset.Iic ⌊x⌋₊).filter (fun p => p.Prime ∧ ¬ SNormal S p) := by
      intro q hq
      rw [Finset.mem_filter] at hq
      obtain ⟨hqQ, hqx⟩ := hq
      obtain ⟨_, h2, h3⟩ := (hQmem q).mp hqQ
      rw [Finset.mem_filter, Finset.mem_Iic]
      exact ⟨Nat.le_floor hqx, h2, h3⟩
