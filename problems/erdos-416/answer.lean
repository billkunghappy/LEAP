        (Nat.cast_le.mpr (Finset.card_le_card (Finset.filter_subset _ _))).trans
          (hdens _ hut)
      have hlogt : Real.log (u * 2 ^ (n + 1)) = Real.log u + ((n : ℝ) + 1) * Real.log 2 := by
        rw [Real.log_mul hu0.ne' (pow_ne_zero _ two_ne_zero), Real.log_pow]; push_cast; ring
      have hY0 : Real.exp 1 ≤ Real.log u + ((n : ℝ) + 1) * Real.log 2 := by
        have : 0 ≤ ((n : ℝ) + 1) * Real.log 2 := by positivity
        linarith
      have hYpos : 0 < Real.log u + ((n : ℝ) + 1) * Real.log 2 := by linarith
      have hlogY : 0 < Real.log (Real.log u + ((n : ℝ) + 1) * Real.log 2) :=
        Real.log_pos (by linarith)
