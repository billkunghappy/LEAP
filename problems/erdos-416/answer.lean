        rw [nsmul_eq_mul] at this
        exact this
      have hBcard : ((((F.filter (fun m : ℕ => (m : ℝ) ≤ u * 2 ^ (n + 1))).filter
          (fun m : ℕ => ¬ (m : ℝ) ≤ u * 2 ^ n)).card : ℕ) : ℝ) ≤
