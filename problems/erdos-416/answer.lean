  have ford_F_deriv_moment : ∀ ρ : ℝ, 0 < ρ → ρ < 1 → (∀ n : ℕ, 0 ≤ FordAnalysis.coeff n ∧ FordAnalysis.coeff n ≤ (n : ℝ)) → ρ * deriv FordAnalysis.F ρ = ∑' n : ℕ, (n : ℝ) * FordAnalysis.coeff n * ρ ^ n := by
