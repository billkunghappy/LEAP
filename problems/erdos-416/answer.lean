      X / (2 * Real.log y) ≤
        (((Finset.Iic ⌊X⌋₊).filter (fun p : ℕ => p.Prime ∧ c * X + 1 < (p : ℝ))).card : ℝ) := by
    intro y c X hy hx0 hc0 hc1 hgap hX1 hX2
    have hy0 : 0 < y := by linarith
    have he0 : 0 < y ^ (1 / 40 : ℝ) := Real.rpow_pos_of_pos hy0 _
    have hW1 : 1 < y ^ (1 / 2 : ℝ) := Real.one_lt_rpow hy (by norm_num)
    have hlogy : 0 < Real.log y := Real.log_pos hy
    have hX0 : 0 < X := by
      by_contra h
      push_neg at h
      nlinarith
    have hWcX : y ^ (1 / 2 : ℝ) ≤ c * X := by
      have h1 : y ^ (1 / 2 : ℝ) * y ^ (1 / 40 : ℝ) ≤ (c * X) * y ^ (1 / 40 : ℝ) := by
