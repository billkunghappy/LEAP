  have hmain := key r 13 h13 Q (by
    intro q hq
    obtain ⟨h1, h2⟩ := hQ q hq
    refine ⟨h1, fun i => ⟨h2 i, ?_⟩⟩
    have h3 := h2 i
    simp only [hT, Finset.mem_insert, Finset.mem_singleton] at h3
