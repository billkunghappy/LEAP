      · apply Finset.mem_union_right
        apply Finset.mem_biUnion.mpr
        refine ⟨p, Finset.mem_filter.mpr ⟨hprimeN p hp, hpq⟩, ?_⟩
        apply Finset.mem_biUnion.mpr
        refine ⟨r, Finset.mem_filter.mpr ⟨hprimeN r hr, hrq⟩, Finset.mem_filter.mpr ⟨hnN, ?_⟩⟩
