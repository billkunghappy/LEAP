  have hsplit : (2 * B + 9) / Real.log N = B / Real.log N + B / Real.log N + 8 / Real.log N + 1 / Real.log N := by ring
  have hfin : (2 * B + 9) / Real.log N ≤ (4 * B + 18) / Real.log x := by
    rw [div_le_div_iff₀ hp hlogx]
    nlinarith [mul_le_mul_of_nonneg_left hlx (by linarith : (0:ℝ) ≤ 2 * B + 9)]
  rw [hsplit] at hfin
  have a1 := abs_le.mp hLN
  have a2 := abs_le.mp hRp
  have a3 := abs_le.mp hll
  exact abs_le.mpr ⟨by linarith, by linarith⟩

theorem log_riemannZeta_eq_tsum_vonMangoldt : ∀ s : ℝ, 1 < s → Real.log (riemannZeta (s : ℂ)).re = ∑' n : ℕ, ArithmeticFunction.vonMangoldt n / ((n : ℝ) ^ s * Real.log n) :=
by
  intro s hs
  set f : ℕ → ℝ := fun n => ArithmeticFunction.vonMangoldt n / ((n : ℝ) ^ s * Real.log n) with hf
  
  have hsum : Summable f := by
    refine Summable.of_nonneg_of_le (fun n => ?_) (fun n => ?_)
      (Real.summable_one_div_nat_rpow.mpr hs)
    · exact div_nonneg ArithmeticFunction.vonMangoldt_nonneg
        (mul_nonneg (Real.rpow_nonneg (Nat.cast_nonneg n) s) (Real.log_natCast_nonneg n))
    · show ArithmeticFunction.vonMangoldt n / ((n : ℝ) ^ s * Real.log n) ≤ 1 / (n : ℝ) ^ s
      have hD : 0 ≤ (n : ℝ) ^ s * Real.log n :=
        mul_nonneg (Real.rpow_nonneg (Nat.cast_nonneg n) s) (Real.log_natCast_nonneg n)
      calc ArithmeticFunction.vonMangoldt n / ((n : ℝ) ^ s * Real.log n)
          ≤ Real.log n / ((n : ℝ) ^ s * Real.log n) :=
            div_le_div_of_nonneg_right ArithmeticFunction.vonMangoldt_le_log hD
        _ ≤ 1 / (n : ℝ) ^ s := by
          rcases eq_or_ne (Real.log n) 0 with h | h
          · rw [h, zero_div]
            exact div_nonneg zero_le_one (Real.rpow_nonneg (Nat.cast_nonneg n) s)
          · rw [mul_comm, ← div_div, div_self h]
  
  have hterm : ∀ (p k : ℕ), p.Prime →
      f (p ^ (k + 1)) = ((p : ℝ) ^ (-s)) ^ (k + 1) / ((k : ℝ) + 1) := by
    intro p k hp
    show ArithmeticFunction.vonMangoldt (p ^ (k + 1)) /
      ((((p ^ (k + 1) : ℕ) : ℝ)) ^ s * Real.log (((p ^ (k + 1) : ℕ) : ℝ))) = _
    rw [ArithmeticFunction.vonMangoldt_apply_pow (Nat.succ_ne_zero k),
      ArithmeticFunction.vonMangoldt_apply_prime hp]
    have hP : (0 : ℝ) < p := by exact_mod_cast hp.pos
    have hlog : 0 < Real.log p := Real.log_pos (by exact_mod_cast hp.one_lt)
    have e1 : ((p : ℝ) ^ (k + 1)) ^ s = (p : ℝ) ^ (s * ((k : ℝ) + 1)) := by
      rw [← Real.rpow_natCast, ← Real.rpow_mul hP.le]
      push_cast
      ring_nf
    have e2 : ((p : ℝ) ^ (-s)) ^ (k + 1) = ((p : ℝ) ^ (s * ((k : ℝ) + 1)))⁻¹ := by
      rw [← Real.rpow_natCast, ← Real.rpow_mul hP.le, ← Real.rpow_neg hP.le]
      push_cast
      ring_nf
    have hpos : 0 < (p : ℝ) ^ (s * ((k : ℝ) + 1)) := Real.rpow_pos_of_pos hP _
    push_cast
    rw [e1, e2, Real.log_pow]
    push_cast
    field_simp
  
  have hzeta : riemannZeta (s : ℂ) =
      ((Real.exp (∑' p : Nat.Primes, -Real.log (1 - ((p : ℕ) : ℝ) ^ (-s))) : ℝ) : ℂ) := by
    rw [← riemannZeta_eulerProduct_exp_log (by simpa using hs)]
    rw [Complex.ofReal_exp, Complex.ofReal_tsum]
    congr 1
    apply tsum_congr
    intro p
    have hp1 : (1 : ℝ) ≤ ((p : ℕ) : ℝ) := by exact_mod_cast p.2.one_lt.le
    have hx : ((p : ℕ) : ℝ) ^ (-s) ≤ 1 :=
      Real.rpow_le_one_of_one_le_of_nonpos hp1 (by linarith)
    have hc : ((p : ℕ) : ℂ) ^ (-(s : ℂ)) = ((((p : ℕ) : ℝ) ^ (-s) : ℝ) : ℂ) := by
      rw [Complex.ofReal_cpow (Nat.cast_nonneg _)]
      push_cast
      rfl
    rw [hc, Complex.ofReal_neg, ← Complex.ofReal_one, ← Complex.ofReal_sub,
      Complex.ofReal_log (by linarith)]
  
  have hinj : Function.Injective (fun q : Nat.Primes × ℕ => (q.1 : ℕ) ^ (q.2 + 1)) := by
    rintro ⟨p, i⟩ ⟨q, j⟩ h
    obtain ⟨h1, h2⟩ := Nat.Prime.pow_inj p.2 q.2 h
    simp only [Prod.mk.injEq]
    exact ⟨Subtype.ext h1, h2⟩
  have hsupp : ∀ n ∉ Set.range (fun q : Nat.Primes × ℕ => (q.1 : ℕ) ^ (q.2 + 1)), f n = 0 := by
    intro n hn
    by_contra hne
    have hΛ : ArithmeticFunction.vonMangoldt n ≠ 0 := by
      intro h
      apply hne
      show ArithmeticFunction.vonMangoldt n / ((n : ℝ) ^ s * Real.log n) = 0
      rw [h, zero_div]
    rw [Ne, ArithmeticFunction.vonMangoldt_eq_zero_iff, not_not] at hΛ
    obtain ⟨p, k, hp, hk, rfl⟩ := (isPrimePow_nat_iff _).mp hΛ
    apply hn
    refine ⟨(⟨p, hp⟩, k - 1), ?_⟩
    show p ^ (k - 1 + 1) = p ^ k
    rw [Nat.sub_add_cancel hk]
  have hcomp := (hinj.hasSum_iff hsupp).mpr hsum.hasSum
  have hfib : ∀ p : Nat.Primes,
      HasSum (fun k => (f ∘ fun q : Nat.Primes × ℕ => (q.1 : ℕ) ^ (q.2 + 1)) (p, k))
        (-Real.log (1 - ((p : ℕ) : ℝ) ^ (-s))) := by
    intro p
    have hP : (1 : ℝ) < ((p : ℕ) : ℝ) := by exact_mod_cast p.2.one_lt
    have hpos : 0 < ((p : ℕ) : ℝ) ^ (-s) := Real.rpow_pos_of_pos (by linarith) _
    have hlt : ((p : ℕ) : ℝ) ^ (-s) < 1 := Real.rpow_lt_one_of_one_lt_of_neg hP (by linarith)
    have h := Real.hasSum_pow_div_log_of_abs_lt_one
      (show |((p : ℕ) : ℝ) ^ (-s)| < 1 by rw [abs_of_pos hpos]; exact hlt)
    convert h using 1
    funext k
    exact hterm p k p.2
  have hT := hcomp.prod_fiberwise hfib
  rw [hzeta, Complex.ofReal_re, Real.log_exp, hT.tsum_eq]

theorem integral_log_log_mul_rpow_neg : ∀ s : ℝ, 1 < s → (s - 1) * ∫ x in Set.Ioi (1:ℝ), Real.log (Real.log x) * x ^ (-s) = -Real.log (s - 1) - Real.eulerMascheroniConstant :=
by
  have s1 : ∫ t in Set.Ioi (0:ℝ), Real.log t * Real.exp (-t) = -Real.eulerMascheroniConstant := by
    have hD := Complex.hasDerivAt_GammaIntegral (s := 1) (by norm_num)
    have hev : Complex.Gamma =ᶠ[𝓝 (1:ℂ)] Complex.GammaIntegral := by
      have hU : {z : ℂ | 0 < z.re} ∈ 𝓝 (1:ℂ) :=
        (isOpen_lt continuous_const Complex.continuous_re).mem_nhds (by simp)
      filter_upwards [hU] with z hz
      exact Complex.Gamma_eq_integral hz
    have h2 := hD.congr_of_eventuallyEq hev
    have h3 := h2.unique Complex.hasDerivAt_Gamma_one
    have h4 : (∫ t in Set.Ioi (0:ℝ), (t:ℂ) ^ ((1:ℂ) - 1) * ((Real.log t : ℂ) * (Real.exp (-t) : ℂ)))
        = ((∫ t in Set.Ioi (0:ℝ), Real.log t * Real.exp (-t) : ℝ) : ℂ) := by
      rw [← integral_complex_ofReal]
      congr 1
      funext t
      simp
    rw [h4] at h3
    exact_mod_cast h3
  have s2 : ∀ s : ℝ, ∫ x in Set.Ioi (1:ℝ), Real.log (Real.log x) * x ^ (-s)
      = ∫ u in Set.Ioi (0:ℝ), Real.log u * Real.exp (-((s - 1) * u)) := by
    intro s
    have himg : Real.exp '' Set.Ioi 0 = Set.Ioi 1 := by
      ext y
      constructor
      · rintro ⟨u, hu, rfl⟩
        exact Real.one_lt_exp_iff.mpr hu
      · intro hy
        have hy' : (1:ℝ) < y := hy
        exact ⟨Real.log y, Real.log_pos hy', Real.exp_log (by linarith)⟩
    rw [← himg, MeasureTheory.integral_image_eq_integral_abs_deriv_smul measurableSet_Ioi
      (fun u _ => (Real.hasDerivAt_exp u).hasDerivWithinAt) Real.exp_injective.injOn]
    congr 1
    funext u
    rw [abs_of_pos (Real.exp_pos u), smul_eq_mul, Real.log_exp,
      Real.rpow_def_of_pos (Real.exp_pos u), Real.log_exp]
    calc Real.exp u * (Real.log u * Real.exp (u * -s))
        = Real.log u * (Real.exp u * Real.exp (u * -s)) := by ring
      _ = Real.log u * Real.exp (-((s - 1) * u)) := by
        rw [← Real.exp_add]
        congr 2
        ring
  have s3 : ∀ a : ℝ, 0 < a → IntegrableOn (fun t : ℝ => Real.log t * Real.exp (-t)) (Set.Ioi 0) →
      ∫ u in Set.Ioi (0:ℝ), Real.log u * Real.exp (-(a * u))
        = a⁻¹ * ((∫ t in Set.Ioi (0:ℝ), Real.log t * Real.exp (-t)) - Real.log a) := by
    intro a ha hint
    have h1 := MeasureTheory.integral_comp_mul_left_Ioi
      (fun v => Real.log (v / a) * Real.exp (-v)) 0 ha
    have h2 : ∀ x : ℝ, Real.log (a * x / a) * Real.exp (-(a * x))
        = Real.log x * Real.exp (-(a * x)) := by
      intro x
      rw [mul_div_cancel_left₀ x ha.ne']
    simp only [mul_zero, h2] at h1
    rw [h1, smul_eq_mul]
    congr 1
    rw [MeasureTheory.setIntegral_congr_fun measurableSet_Ioi
      (g := fun v => Real.log v * Real.exp (-v) - Real.log a * Real.exp (-v))]
    · rw [MeasureTheory.integral_sub hint ((integrableOn_exp_neg_Ioi 0).const_mul _),
        MeasureTheory.integral_const_mul, integral_exp_neg_Ioi_zero, mul_one]
    · intro v hv
      have hv' : (0:ℝ) < v := hv
      simp only
      rw [Real.log_div hv'.ne' ha.ne']
      ring
  intro s hs
  have ha : 0 < s - 1 := sub_pos.mpr hs
  have hint : IntegrableOn (fun t : ℝ => Real.log t * Real.exp (-t)) (Set.Ioi 0) := by
    apply MeasureTheory.Integrable.of_integral_ne_zero
    rw [s1]
    intro h
    linarith [Real.one_half_lt_eulerMascheroniConstant]
  rw [s2 s, s3 (s - 1) ha hint, s1]
  field_simp
  ring

theorem tsum_vonMangoldt_div_log_eq_integral : ∀ s : ℝ, 1 < s → ∑' n : ℕ, ArithmeticFunction.vonMangoldt n / ((n : ℝ) ^ s * Real.log n) = (s - 1) * ∫ x in Set.Ioi (1:ℝ), (∑ d ∈ Finset.Ioc 0 ⌊x⌋₊, ArithmeticFunction.vonMangoldt d / ((d : ℝ) * Real.log d)) * x ^ (-s) :=
by
  intro s hs
  have hs2 : s - 1 ≠ 0 := by linarith
  have hΛ01 : ∀ n : ℕ, n ≤ 1 → ArithmeticFunction.vonMangoldt n = 0 := by
    intro n hn
    interval_cases n
    · simp
    · simp
  have ha_nonneg : ∀ n : ℕ, 0 ≤ ArithmeticFunction.vonMangoldt n / ((n : ℝ) * Real.log n) :=
    fun n => div_nonneg ArithmeticFunction.vonMangoldt_nonneg
      (mul_nonneg (Nat.cast_nonneg n) (Real.log_natCast_nonneg n))
  
  have hsum : Summable (fun n : ℕ => ArithmeticFunction.vonMangoldt n / ((n : ℝ) ^ s * Real.log n)) := by
    refine Summable.of_nonneg_of_le (fun n => ?_) (fun n => ?_) (Real.summable_nat_rpow_inv.mpr hs)
    · exact div_nonneg ArithmeticFunction.vonMangoldt_nonneg
        (mul_nonneg (Real.rpow_nonneg (Nat.cast_nonneg n) s) (Real.log_natCast_nonneg n))
    · rcases Nat.lt_or_ge n 2 with hn | hn
      · rw [hΛ01 n (by omega), zero_div]
        exact inv_nonneg.mpr (Real.rpow_nonneg (Nat.cast_nonneg n) s)
      · have hn1 : (1:ℝ) < n := by exact_mod_cast hn
        have hL : 0 < Real.log n := Real.log_pos hn1
        have hP : 0 < (n:ℝ) ^ s := Real.rpow_pos_of_pos (by linarith) s
        calc ArithmeticFunction.vonMangoldt n / ((n : ℝ) ^ s * Real.log n)
            ≤ Real.log n / ((n:ℝ) ^ s * Real.log n) :=
              div_le_div_of_nonneg_right ArithmeticFunction.vonMangoldt_le_log (by positivity)
          _ = ((n:ℝ) ^ s)⁻¹ := by field_simp
  
  have hF_nonneg : ∀ n : ℕ, ∀ x ∈ Set.Ioi (1:ℝ),
      0 ≤ ArithmeticFunction.vonMangoldt n / ((n : ℝ) * Real.log n) *
        Set.indicator (Set.Ici (n : ℝ)) (fun y : ℝ => y ^ (-s)) x := by
    intro n x hx
    have hx1 : (1:ℝ) < x := Set.mem_Ioi.mp hx
    refine mul_nonneg (ha_nonneg n) ?_
    simp only [Set.indicator_apply]
    split_ifs
    · exact Real.rpow_nonneg (by linarith) _
    · exact le_rfl
  have hF_int : ∀ n : ℕ, Integrable (fun x : ℝ => ArithmeticFunction.vonMangoldt n / ((n : ℝ) * Real.log n) *
        Set.indicator (Set.Ici (n : ℝ)) (fun y : ℝ => y ^ (-s)) x) (volume.restrict (Set.Ioi (1:ℝ))) := by
    intro n
    have h1 : IntegrableOn (fun y : ℝ => y ^ (-s)) (Set.Ioi (1:ℝ)) :=
      integrableOn_Ioi_rpow_of_lt (by linarith) one_pos
    exact Integrable.const_mul (h1.indicator measurableSet_Ici) _
  have hF_val : ∀ n : ℕ, ∫ x in Set.Ioi (1:ℝ), ArithmeticFunction.vonMangoldt n / ((n : ℝ) * Real.log n) *
        Set.indicator (Set.Ici (n : ℝ)) (fun y : ℝ => y ^ (-s)) x =
      ArithmeticFunction.vonMangoldt n / ((n : ℝ) ^ s * Real.log n) / (s - 1) := by
    intro n
    rcases Nat.lt_or_ge n 2 with hn | hn
    · have h0 := hΛ01 n (by omega)
      simp [h0]
    · have hN : (1:ℝ) < n := by exact_mod_cast hn
      have hN0 : (0:ℝ) < n := by linarith
      rw [integral_const_mul, setIntegral_indicator measurableSet_Ici,
        Set.inter_eq_right.mpr (Set.Ici_subset_Ioi.mpr hN), integral_Ici_eq_integral_Ioi,
        integral_Ioi_rpow_of_lt (by linarith) hN0]
      have hL : 0 < Real.log n := Real.log_pos hN
      have hP : 0 < (n:ℝ) ^ s := Real.rpow_pos_of_pos hN0 s
      have hpow : (n:ℝ) ^ (-s + 1) = (n:ℝ) / (n:ℝ) ^ s := by
        rw [show -s + 1 = 1 - s by ring, Real.rpow_sub hN0, Real.rpow_one]
      rw [hpow]
      have hs1' : -s + 1 ≠ 0 := by linarith
      field_simp
      ring
  
  have hpt : ∀ x : ℝ, 0 ≤ x →
      (∑ d ∈ Finset.Ioc 0 ⌊x⌋₊, ArithmeticFunction.vonMangoldt d / ((d : ℝ) * Real.log d)) * x ^ (-s) =
        ∑' n : ℕ, ArithmeticFunction.vonMangoldt n / ((n : ℝ) * Real.log n) *
          Set.indicator (Set.Ici (n : ℝ)) (fun y : ℝ => y ^ (-s)) x := by
    intro x hx
    have hvan : ∀ n ∉ Finset.Ioc 0 ⌊x⌋₊, ArithmeticFunction.vonMangoldt n / ((n : ℝ) * Real.log n) *
          Set.indicator (Set.Ici (n : ℝ)) (fun y : ℝ => y ^ (-s)) x = 0 := by
      intro n hn
      rw [Finset.mem_Ioc, not_and_or] at hn
      rcases hn with hn | hn
      · rw [hΛ01 n (by omega), zero_div, zero_mul]
      · have hlt : x < n := (Nat.floor_lt hx).mp (by omega)
        have hnm : x ∉ Set.Ici (n : ℝ) := by
          rw [Set.mem_Ici, not_le]
          exact hlt
        rw [Set.indicator_of_notMem hnm, mul_zero]
    rw [tsum_eq_sum hvan, Finset.sum_mul]
    refine Finset.sum_congr rfl (fun n hn => ?_)
    have hn' := (Finset.mem_Ioc.mp hn).2
    have hnx : (n:ℝ) ≤ x := le_trans (by exact_mod_cast hn') (Nat.floor_le hx)
    rw [Set.indicator_of_mem (Set.mem_Ici.mpr hnx)]
  
  have hint_eq : ∫ x in Set.Ioi (1:ℝ),
      (∑ d ∈ Finset.Ioc 0 ⌊x⌋₊, ArithmeticFunction.vonMangoldt d / ((d : ℝ) * Real.log d)) * x ^ (-s) =
      ∫ x in Set.Ioi (1:ℝ), ∑' n : ℕ, ArithmeticFunction.vonMangoldt n / ((n : ℝ) * Real.log n) *
          Set.indicator (Set.Ici (n : ℝ)) (fun y : ℝ => y ^ (-s)) x :=
    setIntegral_congr_fun measurableSet_Ioi
      (fun x hx => hpt x (by linarith [Set.mem_Ioi.mp hx]))
  have hnorm : (fun n : ℕ => ∫ x in Set.Ioi (1:ℝ), ‖ArithmeticFunction.vonMangoldt n / ((n : ℝ) * Real.log n) *
          Set.indicator (Set.Ici (n : ℝ)) (fun y : ℝ => y ^ (-s)) x‖) =
      fun n : ℕ => ArithmeticFunction.vonMangoldt n / ((n : ℝ) ^ s * Real.log n) / (s - 1) := by
    funext n
    rw [← hF_val n]
    exact setIntegral_congr_fun measurableSet_Ioi
      (fun x hx => Real.norm_of_nonneg (hF_nonneg n x hx))
  have hswap := integral_tsum_of_summable_integral_norm hF_int
    (by rw [hnorm]; exact hsum.div_const _)
  rw [hint_eq, ← hswap]
  simp_rw [hF_val]
  rw [tsum_div_const]
  field_simp

theorem vonMangoldt_log_sum_const_eq_eulerMascheroni : ∀ C K : ℝ, (∀ s : ℝ, 1 < s → Real.log (riemannZeta (s : ℂ)).re = (s - 1) * ∫ x in Set.Ioi (1:ℝ), (∑ d ∈ Finset.Ioc 0 ⌊x⌋₊, ArithmeticFunction.vonMangoldt d / ((d : ℝ) * Real.log d)) * x ^ (-s)) → (∀ s : ℝ, 1 < s → (s - 1) * ∫ x in Set.Ioi (1:ℝ), Real.log (Real.log x) * x ^ (-s) = -Real.log (s - 1) - Real.eulerMascheroniConstant) → (∀ x : ℝ, 2 ≤ x → |(∑ d ∈ Finset.Ioc 0 ⌊x⌋₊, ArithmeticFunction.vonMangoldt d / ((d : ℝ) * Real.log d)) - Real.log (Real.log x) - C| ≤ K / Real.log x) → C = Real.eulerMascheroniConstant :=
by
  
  have s1 : Tendsto (fun s : ℝ => Real.log (riemannZeta (s : ℂ)).re + Real.log (s - 1))
      (𝓝[>] 1) (𝓝 0) := by
    have h1 : Tendsto (fun s : ℝ => (s : ℂ)) (𝓝[>] 1) (𝓝[≠] (1:ℂ)) := by
      apply tendsto_nhdsWithin_of_tendsto_nhds_of_eventually_within
      · have := (Complex.continuous_ofReal.tendsto (1:ℝ))
        rw [Complex.ofReal_one] at this
        exact this.mono_left nhdsWithin_le_nhds
      · filter_upwards [self_mem_nhdsWithin] with s hs
        simp only [Set.mem_compl_iff, Set.mem_singleton_iff]
        exact_mod_cast (ne_of_gt hs)
    have h2 := riemannZeta_residue_one.comp h1
    have h3' : Tendsto (fun s : ℝ => (s - 1) * (riemannZeta (s:ℂ)).re) (𝓝[>] 1) (𝓝 1) := by
      have := (Complex.continuous_re.tendsto _).comp h2
      rw [Complex.one_re] at this
      refine this.congr fun s => ?_
      simp [Function.comp]
    have h4 := ((Real.continuousAt_log one_ne_zero).tendsto).comp h3'
    rw [Real.log_one] at h4
    refine h4.congr' ?_
    filter_upwards [h3'.eventually (lt_mem_nhds zero_lt_one), self_mem_nhdsWithin] with s hP hs
    have hs1 : 0 < s - 1 := sub_pos.mpr hs
    have hz : 0 < (riemannZeta (s:ℂ)).re := by
      by_contra h
      push_neg at h
      nlinarith
    simp only [Function.comp]
    rw [Real.log_mul hs1.ne' hz.ne', add_comm]
  
  have s2 : ∀ (R : ℝ → ℝ) (s₀ : ℝ), 1 < s₀ →
      IntegrableOn (fun x => R x * x ^ (-s₀)) (Set.Ioi 1) → Tendsto R atTop (𝓝 0) →
      Tendsto (fun s : ℝ => (s - 1) * ∫ x in Set.Ioi (1:ℝ), R x * x ^ (-s)) (𝓝[>] 1) (𝓝 0) := by
    intro R s₀ hs₀ hint hR
    rw [Metric.tendsto_nhdsWithin_nhds]
    intro ε hε
    obtain ⟨X₀, hX₀⟩ := (Metric.tendsto_atTop.mp hR) (ε/2) (by linarith)
    obtain ⟨X, hXdef⟩ : ∃ X : ℝ, X = max X₀ 1 := ⟨_, rfl⟩
    have hX1 : 1 ≤ X := hXdef ▸ le_max_right _ _
    have hXX₀ : X₀ ≤ X := hXdef ▸ le_max_left _ _
    obtain ⟨M, hM⟩ : ∃ M : ℝ, M = ∫ x in Set.Ioi (1:ℝ), |R x * x ^ (-s₀)| := ⟨_, rfl⟩
    have hM0 : 0 ≤ M := hM ▸ setIntegral_nonneg measurableSet_Ioi (fun x _ => abs_nonneg _)
    obtain ⟨A, hA⟩ : ∃ A : ℝ, A = X ^ (s₀ - 1) * M := ⟨_, rfl⟩
    have hA0 : 0 ≤ A := hA ▸ mul_nonneg (Real.rpow_nonneg (by linarith) _) hM0
    refine ⟨ε / (2 * (A + 1)), by positivity, ?_⟩
    intro s hs hdist
    have hs1 : 1 < s := hs
    have hs1' : 0 < s - 1 := sub_pos.mpr hs1
    rw [Real.dist_eq] at hdist
    have hsd : s - 1 < ε / (2 * (A + 1)) := by rw [abs_lt] at hdist; linarith
    rw [Real.dist_eq, sub_zero]
    have hIs : IntegrableOn (fun x : ℝ => x ^ (-s)) (Set.Ioi 1) :=
      integrableOn_Ioi_rpow_of_lt (by linarith) one_pos
    have hval : ∫ x in Set.Ioi (1:ℝ), x ^ (-s) = 1 / (s - 1) := by
      rw [integral_Ioi_rpow_of_lt (by linarith) one_pos, Real.one_rpow]
      have : -s + 1 ≠ 0 := by linarith
      field_simp
      ring
    have hg : IntegrableOn (fun x : ℝ => X ^ (s₀ - 1) * |R x * x ^ (-s₀)| + (ε/2) * x ^ (-s))
        (Set.Ioi 1) := (hint.abs.const_mul _).add (hIs.const_mul _)
    have hbound : ∀ x ∈ Set.Ioi (1:ℝ), ‖R x * x ^ (-s)‖ ≤
        X ^ (s₀ - 1) * |R x * x ^ (-s₀)| + (ε/2) * x ^ (-s) := by
      intro x hx
      have hx1 : 1 < x := hx
      have hx0 : 0 < x := by linarith
      have hxs : 0 < x ^ (-s) := Real.rpow_pos_of_pos hx0 _
      have hxs0 : 0 < x ^ (-s₀) := Real.rpow_pos_of_pos hx0 _
      rw [Real.norm_eq_abs, abs_mul, abs_of_pos hxs]
      have hg1 : 0 ≤ X ^ (s₀ - 1) * |R x * x ^ (-s₀)| :=
        mul_nonneg (Real.rpow_nonneg (by linarith) _) (abs_nonneg _)
      have hg2 : 0 ≤ (ε/2) * x ^ (-s) := by positivity
      by_cases hxX : x ≤ X
      · have e1 : x ^ (-s) = x ^ (s₀ - s) * x ^ (-s₀) := by
          rw [← Real.rpow_add hx0]; congr 1; ring
        have e2 : x ^ (s₀ - s) ≤ x ^ (s₀ - 1) :=
          Real.rpow_le_rpow_of_exponent_le hx1.le (by linarith)
        have e3 : x ^ (s₀ - 1) ≤ X ^ (s₀ - 1) := Real.rpow_le_rpow hx0.le hxX (by linarith)
        have key : |R x| * x ^ (-s) ≤ X ^ (s₀ - 1) * |R x * x ^ (-s₀)| := by
          rw [abs_mul, abs_of_pos hxs0, e1]
          have h23 := mul_le_mul_of_nonneg_right (e2.trans e3) hxs0.le
          calc |R x| * (x ^ (s₀ - s) * x ^ (-s₀))
              ≤ |R x| * (X ^ (s₀ - 1) * x ^ (-s₀)) :=
                mul_le_mul_of_nonneg_left h23 (abs_nonneg _)
            _ = X ^ (s₀ - 1) * (|R x| * x ^ (-s₀)) := by ring
        linarith
      · push_neg at hxX
        have hxX0 : X₀ ≤ x := hXX₀.trans hxX.le
        have hRx := hX₀ x hxX0
        rw [Real.dist_eq, sub_zero] at hRx
        have : |R x| * x ^ (-s) ≤ (ε/2) * x ^ (-s) := mul_le_mul_of_nonneg_right hRx.le hxs.le
        linarith
    have hnorm := norm_integral_le_of_norm_le hg
      (ae_restrict_of_forall_mem measurableSet_Ioi hbound)
    have hgint : ∫ x in Set.Ioi (1:ℝ), (X ^ (s₀ - 1) * |R x * x ^ (-s₀)| + (ε/2) * x ^ (-s)) =
        A + (ε/2) * (1/(s-1)) := by
      rw [integral_add (hint.abs.const_mul _) (hIs.const_mul _), integral_const_mul,
        integral_const_mul, hval, hA, hM]
    rw [hgint, Real.norm_eq_abs] at hnorm
    rw [abs_mul, abs_of_pos hs1']
    have hsd' : (s - 1) * (2 * (A + 1)) < ε := (lt_div_iff₀ (by positivity)).mp hsd
    calc (s-1) * |∫ x in Set.Ioi (1:ℝ), R x * x ^ (-s)|
        ≤ (s-1) * (A + (ε/2) * (1/(s-1))) := mul_le_mul_of_nonneg_left hnorm hs1'.le
      _ = (s-1) * A + ε/2 := by field_simp
      _ < ε := by nlinarith
  
  intro C K H1 H2 H3
  have key : ∀ (S : ℝ → ℝ),
      (∀ s : ℝ, 1 < s → Real.log (riemannZeta (s : ℂ)).re =
        (s - 1) * ∫ x in Set.Ioi (1:ℝ), S x * x ^ (-s)) →
      (∀ x : ℝ, 2 ≤ x → |S x - Real.log (Real.log x) - C| ≤ K / Real.log x) →
      C = Real.eulerMascheroniConstant := by
    intro S H1 H3
    have hL : Tendsto (fun s : ℝ => -Real.log (s - 1)) (𝓝[>] 1) atTop := by
      have h0 : Tendsto (fun s : ℝ => s - 1) (𝓝[>] 1) (𝓝[>] 0) := by
        apply tendsto_nhdsWithin_of_tendsto_nhds_of_eventually_within
        · have : Tendsto (fun s : ℝ => s - 1) (𝓝 1) (𝓝 (1 - 1)) := tendsto_id.sub_const 1
          rw [sub_self] at this
          exact this.mono_left nhdsWithin_le_nhds
        · filter_upwards [self_mem_nhdsWithin] with s hs
          exact sub_pos.mpr (Set.mem_Ioi.mp hs)
      exact tendsto_neg_atBot_atTop.comp (Real.tendsto_log_nhdsGT_zero.comp h0)
    have hF : Tendsto (fun s : ℝ => Real.log (riemannZeta (s : ℂ)).re) (𝓝[>] 1) atTop := by
      have := s1.add_atTop hL
      refine this.congr fun s => ?_
      ring
    have hE : ∀ᶠ s : ℝ in 𝓝[>] (1:ℝ), 1 < s ∧ 0 < Real.log (riemannZeta (s : ℂ)).re ∧
        Real.eulerMascheroniConstant < -Real.log (s - 1) := by
      filter_upwards [self_mem_nhdsWithin, hF.eventually_gt_atTop 0,
        hL.eventually_gt_atTop Real.eulerMascheroniConstant] with s h1 h2 h3
      exact ⟨h1, h2, h3⟩
    have hint : ∀ s : ℝ, (1 < s ∧ 0 < Real.log (riemannZeta (s : ℂ)).re ∧
        Real.eulerMascheroniConstant < -Real.log (s - 1)) →
        IntegrableOn (fun x => S x * x ^ (-s)) (Set.Ioi 1) ∧
        IntegrableOn (fun x => Real.log (Real.log x) * x ^ (-s)) (Set.Ioi 1) := by
      rintro s ⟨h1, h2, h3⟩
      constructor
      · by_contra h
        have := H1 s h1
        rw [integral_undef h, mul_zero] at this
        linarith
      · by_contra h
        have := H2 s h1
        rw [integral_undef h, mul_zero] at this
        linarith
    obtain ⟨R, hR⟩ : ∃ R : ℝ → ℝ, R = fun x => S x - Real.log (Real.log x) - C := ⟨_, rfl⟩
    have hid : ∀ s : ℝ, (1 < s ∧ 0 < Real.log (riemannZeta (s : ℂ)).re ∧
        Real.eulerMascheroniConstant < -Real.log (s - 1)) →
        (s - 1) * ∫ x in Set.Ioi (1:ℝ), R x * x ^ (-s) =
          (Real.log (riemannZeta (s : ℂ)).re + Real.log (s - 1)) +
            (Real.eulerMascheroniConstant - C) := by
      intro s hs
      obtain ⟨hf, hg⟩ := hint s hs
      have h1 := hs.1
      have hc : IntegrableOn (fun x : ℝ => C * x ^ (-s)) (Set.Ioi 1) :=
        (integrableOn_Ioi_rpow_of_lt (by linarith) one_pos).const_mul C
      have hval : ∫ x in Set.Ioi (1:ℝ), x ^ (-s) = 1 / (s - 1) := by
        rw [integral_Ioi_rpow_of_lt (by linarith) one_pos, Real.one_rpow]
        have : -s + 1 ≠ 0 := by linarith
        have : s - 1 ≠ 0 := by linarith
        field_simp
        ring
      have hfg : IntegrableOn (fun x => S x * x ^ (-s) - Real.log (Real.log x) * x ^ (-s))
          (Set.Ioi 1) := hf.sub hg
      have e2 : ∫ x in Set.Ioi (1:ℝ), (S x * x ^ (-s) - Real.log (Real.log x) * x ^ (-s)) =
          (∫ x in Set.Ioi (1:ℝ), S x * x ^ (-s)) -
            ∫ x in Set.Ioi (1:ℝ), Real.log (Real.log x) * x ^ (-s) := integral_sub hf hg
      have e1 : ∫ x in Set.Ioi (1:ℝ),
          ((S x * x ^ (-s) - Real.log (Real.log x) * x ^ (-s)) - C * x ^ (-s)) =
          (∫ x in Set.Ioi (1:ℝ), (S x * x ^ (-s) - Real.log (Real.log x) * x ^ (-s))) -
            ∫ x in Set.Ioi (1:ℝ), C * x ^ (-s) := integral_sub hfg hc
      have e : ∫ x in Set.Ioi (1:ℝ), R x * x ^ (-s) =
          (∫ x in Set.Ioi (1:ℝ), S x * x ^ (-s)) -
            (∫ x in Set.Ioi (1:ℝ), Real.log (Real.log x) * x ^ (-s)) -
              ∫ x in Set.Ioi (1:ℝ), C * x ^ (-s) := by
        rw [← e2, ← e1]
        congr 1
        ext x
        rw [hR]
        ring
      have hs1' : s - 1 ≠ 0 := by linarith
      rw [e, integral_const_mul, hval, mul_sub, mul_sub, ← H1 s h1, H2 s h1]
      field_simp
      ring
    obtain ⟨s₀, hs₀⟩ := hE.exists
    obtain ⟨hf0, hg0⟩ := hint s₀ hs₀
    have hR0 : IntegrableOn (fun x => R x * x ^ (-s₀)) (Set.Ioi 1) := by
      have hc : IntegrableOn (fun x : ℝ => C * x ^ (-s₀)) (Set.Ioi 1) :=
        (integrableOn_Ioi_rpow_of_lt (by linarith [hs₀.1]) one_pos).const_mul C
      have h3 : IntegrableOn (fun x : ℝ => (S x * x ^ (-s₀) -
          Real.log (Real.log x) * x ^ (-s₀)) - C * x ^ (-s₀)) (Set.Ioi 1) :=
        (hf0.sub hg0).sub hc
      refine IntegrableOn.congr_fun h3 (fun x _ => ?_) measurableSet_Ioi
      simp only [hR]
      ring
    have hRt : Tendsto R atTop (𝓝 0) := by
      have hK : Tendsto (fun x : ℝ => K / Real.log x) atTop (𝓝 0) :=
        tendsto_const_nhds.div_atTop Real.tendsto_log_atTop
      apply squeeze_zero_norm' _ hK
      filter_upwards [eventually_ge_atTop (2:ℝ)] with x hx
      rw [Real.norm_eq_abs, hR]
      exact H3 x hx
    have hG := s2 R s₀ hs₀.1 hR0 hRt
    have hG' : Tendsto (fun s : ℝ => (Real.log (riemannZeta (s : ℂ)).re + Real.log (s - 1)) +
        (Real.eulerMascheroniConstant - C)) (𝓝[>] 1) (𝓝 0) := by
      refine hG.congr' ?_
      filter_upwards [hE] with s hs
      exact hid s hs
    have hG'' := s1.add_const (Real.eulerMascheroniConstant - C)
    have := tendsto_nhds_unique hG'' hG'
    linarith
  exact key _ H1 H3

theorem prime_euler_product_asymptotic : Asymptotics.IsEquivalent atTop
      (fun x : ℝ => ∏ p ∈ (Finset.Iic ⌊x⌋₊).filter Nat.Prime, (1 - (1 : ℝ) / p))
      (fun x => Real.exp (-Real.eulerMascheroniConstant) / Real.log x) :=
by
  
  have vonMangoldt_div_log_sum_eq_prime_sum : ∀ N : ℕ, ∑ n ∈ Finset.Ioc 0 N, ArithmeticFunction.vonMangoldt n / ((n : ℝ) * Real.log n) = ∑ p ∈ (Finset.Iic N).filter Nat.Prime, ∑ i ∈ Finset.range (Nat.log p N), (1 / (p : ℝ)) ^ (i + 1) / ((i : ℝ) + 1) := by
    intro N
    rw [Finset.sum_sigma']
    symm
    apply Finset.sum_bij_ne_zero (fun a _ _ => a.1 ^ (a.2 + 1))
    · rintro ⟨p, i⟩ ha _
      simp only [Finset.mem_sigma, Finset.mem_filter, Finset.mem_Iic, Finset.mem_range] at ha
      obtain ⟨⟨hpN, hp⟩, hi⟩ := ha
      simp only [Finset.mem_Ioc]
      refine ⟨pow_pos hp.pos _, ?_⟩
      have hN : N ≠ 0 := by have := hp.two_le; omega
      calc p ^ (i+1) ≤ p ^ Nat.log p N := Nat.pow_le_pow_right hp.pos hi
        _ ≤ N := Nat.pow_log_le_self p hN
    · rintro ⟨p, i⟩ ha _ ⟨q, j⟩ hb _ h
      simp only [Finset.mem_sigma, Finset.mem_filter, Finset.mem_Iic, Finset.mem_range] at ha hb
      obtain ⟨hpq, hij⟩ := Nat.Prime.pow_inj ha.1.2 hb.1.2 h
      subst hpq
      subst hij
      rfl
    · intro n hn hne
      have hΛ : ArithmeticFunction.vonMangoldt n ≠ 0 := by
        intro h
        apply hne
        rw [h, zero_div]
      rw [Ne, ArithmeticFunction.vonMangoldt_eq_zero_iff, not_not] at hΛ
      obtain ⟨p, k, hp, hk, rfl⟩ := (isPrimePow_nat_iff _).mp hΛ
      simp only [Finset.mem_Ioc] at hn
      have hpk : p ≤ p ^ k := Nat.le_self_pow hk.ne' p
      have hkl : k ≤ Nat.log p N := Nat.le_log_of_pow_le hp.one_lt hn.2
      refine ⟨⟨p, k - 1⟩, ?_, ?_, ?_⟩
      · simp only [Finset.mem_sigma, Finset.mem_filter, Finset.mem_Iic, Finset.mem_range]
        exact ⟨⟨hpk.trans hn.2, hp⟩, by omega⟩
      · have hp0 : (0:ℝ) < p := by exact_mod_cast hp.pos
        positivity
      · show p ^ (k - 1 + 1) = p ^ k
        rw [Nat.sub_add_cancel hk]
    · rintro ⟨p, i⟩ ha _
      simp only [Finset.mem_sigma, Finset.mem_filter, Finset.mem_Iic, Finset.mem_range] at ha
      have hp := ha.1.2
      show (1 / (p : ℝ)) ^ (i + 1) / ((i : ℝ) + 1) =
        ArithmeticFunction.vonMangoldt (p ^ (i + 1)) /
          (((p ^ (i + 1) : ℕ) : ℝ) * Real.log ((p ^ (i + 1) : ℕ) : ℝ))
      rw [ArithmeticFunction.vonMangoldt_apply_pow (by omega),
        ArithmeticFunction.vonMangoldt_apply_prime hp]
      have hp1 : (1:ℝ) < p := by exact_mod_cast hp.one_lt
      have hlog : 0 < Real.log p := Real.log_pos hp1
      push_cast
      rw [Real.log_pow]
      push_cast
      field_simp
      rw [← mul_pow, one_div_mul_cancel (Nat.cast_ne_zero.mpr hp.ne_zero), one_pow]
  
  have prime_log_series_remainder_bound : ∀ N : ℕ, 1 ≤ N → |∑ p ∈ (Finset.Iic N).filter Nat.Prime, ((∑ i ∈ Finset.range (Nat.log p N), (1 / (p : ℝ)) ^ (i + 1) / ((i : ℝ) + 1)) + Real.log (1 - 1 / (p : ℝ)))| ≤ 8 / Real.sqrt N := by
    intro N hN
    have key : ∀ p ∈ (Finset.Iic N).filter Nat.Prime,
        |(∑ i ∈ Finset.range (Nat.log p N), (1 / (p : ℝ)) ^ (i + 1) / ((i : ℝ) + 1)) +
            Real.log (1 - 1 / (p : ℝ))| ≤ 2 / ((N:ℝ) + 1) ∧
        |(∑ i ∈ Finset.range (Nat.log p N), (1 / (p : ℝ)) ^ (i + 1) / ((i : ℝ) + 1)) +
            Real.log (1 - 1 / (p : ℝ))| ≤ 2 / ((p:ℝ) ^ 2) := by
      intro p hp
      simp only [Finset.mem_filter, Finset.mem_Iic] at hp
      obtain ⟨hpN, hpr⟩ := hp
      have hp2 : (2:ℝ) ≤ p := by exact_mod_cast hpr.two_le
      have hp0 : (0:ℝ) < p := by linarith
      have hpos : (0:ℝ) < 1 / p := by positivity
      have hx : |(1:ℝ) / p| < 1 := by
        rw [abs_of_pos hpos, div_lt_one hp0]
        linarith
      have h1 := Real.abs_log_sub_add_sum_range_le hx (Nat.log p N)
      rw [abs_of_pos hpos] at h1
      have hq1 : (N:ℝ) + 1 ≤ (p:ℝ) ^ (Nat.log p N + 1) := by
        have := Nat.lt_pow_succ_log_self hpr.one_lt N
        have h' : N + 1 ≤ p ^ (Nat.log p N + 1) := this
        exact_mod_cast h'
      have hK : 1 ≤ Nat.log p N := Nat.le_log_of_pow_le hpr.one_lt (by simpa using hpN)
      have hq2 : (p:ℝ) ^ 2 ≤ (p:ℝ) ^ (Nat.log p N + 1) :=
        pow_le_pow_right₀ (by linarith) (by omega)
      have h12 : (1:ℝ) / 2 ≤ 1 - 1 / p := by
        have : (1:ℝ) / p ≤ 1 / 2 := one_div_le_one_div_of_le (by norm_num) hp2
        linarith
      have hb : (1 / (p:ℝ)) ^ (Nat.log p N + 1) / (1 - 1 / p) ≤
          2 / (p:ℝ) ^ (Nat.log p N + 1) := by
        calc (1 / (p:ℝ)) ^ (Nat.log p N + 1) / (1 - 1 / p)
            ≤ (1 / (p:ℝ)) ^ (Nat.log p N + 1) / (1 / 2) :=
              div_le_div_of_nonneg_left (by positivity) (by norm_num) h12
          _ = 2 / (p:ℝ) ^ (Nat.log p N + 1) := by rw [one_div_pow]; field_simp
      have hA := h1.trans hb
      constructor
      · exact hA.trans (div_le_div_of_nonneg_left (by norm_num) (by positivity) hq1)
      · exact hA.trans (div_le_div_of_nonneg_left (by norm_num) (by positivity) hq2)
    set F := (Finset.Iic N).filter Nat.Prime with hF
    set M := Nat.sqrt N with hM
    have hM1 : 1 ≤ M := Nat.le_sqrt.mpr (by simpa using hN)
    set a : ℕ → ℝ := fun p => (∑ i ∈ Finset.range (Nat.log p N),
      (1 / (p : ℝ)) ^ (i + 1) / ((i : ℝ) + 1)) + Real.log (1 - 1 / (p : ℝ)) with ha
    have hsum1 : ∑ p ∈ F.filter (fun p => p ≤ M), (2 / ((N:ℝ) + 1)) ≤
        M * (2 / ((N:ℝ) + 1)) := by
      rw [Finset.sum_const, nsmul_eq_mul]
      gcongr
      have hsub : F.filter (fun p => p ≤ M) ⊆ Finset.Icc 1 M := by
        intro p hp
        simp only [hF, Finset.mem_filter, Finset.mem_Iic, Finset.mem_Icc] at hp ⊢
        exact ⟨hp.1.2.one_lt.le, hp.2⟩
      have := Finset.card_le_card hsub
      rw [Nat.card_Icc] at this
      exact_mod_cast (by omega : (F.filter (fun p => p ≤ M)).card ≤ M)
    have hsum2 : ∑ p ∈ F.filter (fun p => ¬ p ≤ M), (2 / ((p:ℝ) ^ 2)) ≤
        2 * (2 / ((M:ℝ) + 1)) := by
      have hsub : F.filter (fun p => ¬ p ≤ M) ⊆ Finset.Ioo M (N + 1) := by
        intro p hp
        simp only [hF, Finset.mem_filter, Finset.mem_Iic, Finset.mem_Ioo] at hp ⊢
        omega
      calc ∑ p ∈ F.filter (fun p => ¬ p ≤ M), (2 / ((p:ℝ) ^ 2))
          = 2 * ∑ p ∈ F.filter (fun p => ¬ p ≤ M), (((p:ℝ) ^ 2))⁻¹ := by
            rw [Finset.mul_sum]
            exact Finset.sum_congr rfl (fun p _ => by rw [div_eq_mul_inv])
        _ ≤ 2 * ∑ i ∈ Finset.Ioo M (N + 1), (((i:ℝ) ^ 2))⁻¹ := by
            gcongr
        _ ≤ 2 * (2 / ((M:ℝ) + 1)) := by
            gcongr
            exact sum_Ioo_inv_sq_le M (N + 1)
    have hr : 0 < Real.sqrt N := Real.sqrt_pos.mpr (by exact_mod_cast hN)
    have hMr : (M:ℝ) ≤ Real.sqrt N := Real.nat_sqrt_le_real_sqrt
    have hrM : Real.sqrt N < M + 1 := Real.real_sqrt_lt_nat_sqrt_succ
    have hN' : (N:ℝ) = (Real.sqrt N) ^ 2 := (Real.sq_sqrt (by positivity)).symm
    have hfin : (M:ℝ) * (2 / ((N:ℝ) + 1)) + 2 * (2 / ((M:ℝ) + 1)) ≤ 8 / Real.sqrt N := by
      have e1 : (M:ℝ) * (2 / ((N:ℝ) + 1)) ≤ 2 / Real.sqrt N := by
        rw [show (M:ℝ) * (2 / ((N:ℝ) + 1)) = 2 * M / ((N:ℝ) + 1) by ring,
          div_le_div_iff₀ (by positivity) hr]
        have := mul_le_mul_of_nonneg_right hMr hr.le
        nlinarith
      have e2 : 2 * (2 / ((M:ℝ) + 1)) ≤ 4 / Real.sqrt N := by
        rw [show 2 * (2 / ((M:ℝ) + 1)) = 4 / ((M:ℝ) + 1) by ring]
        exact div_le_div_of_nonneg_left (by norm_num) hr hrM.le
      have e3 : 2 / Real.sqrt N + 4 / Real.sqrt N ≤ 8 / Real.sqrt N := by
        rw [← add_div]
        exact div_le_div_of_nonneg_right (by norm_num) hr.le
      linarith
    calc |∑ p ∈ F, a p| ≤ ∑ p ∈ F, |a p| := Finset.abs_sum_le_sum_abs _ _
      _ = ∑ p ∈ F.filter (fun p => p ≤ M), |a p| +
            ∑ p ∈ F.filter (fun p => ¬ p ≤ M), |a p| :=
          (Finset.sum_filter_add_sum_filter_not _ _ _).symm
      _ ≤ ∑ p ∈ F.filter (fun p => p ≤ M), (2 / ((N:ℝ) + 1)) +
            ∑ p ∈ F.filter (fun p => ¬ p ≤ M), (2 / ((p:ℝ) ^ 2)) :=
          add_le_add (Finset.sum_le_sum fun p hp => (key p (Finset.mem_filter.mp hp).1).1)
            (Finset.sum_le_sum fun p hp => (key p (Finset.mem_filter.mp hp).1).2)
      _ ≤ (M:ℝ) * (2 / ((N:ℝ) + 1)) + 2 * (2 / ((M:ℝ) + 1)) := add_le_add hsum1 hsum2
      _ ≤ 8 / Real.sqrt N := hfin
  
  obtain ⟨C, K, hCK⟩ :=
    vonMangoldt_div_log_sum_rate (Real.log 4 + 4) vonMangoldt_div_sum_sub_log_abs_le
  
  have hC : C = Real.eulerMascheroniConstant :=
    vonMangoldt_log_sum_const_eq_eulerMascheroni C K
      (fun s hs => by
        rw [log_riemannZeta_eq_tsum_vonMangoldt s hs, tsum_vonMangoldt_div_log_eq_integral s hs])
      integral_log_log_mul_rpow_neg hCK
  subst hC
  
  have hlogK : Tendsto (fun x : ℝ => K / Real.log x) atTop (𝓝 0) :=
    tendsto_const_nhds.div_atTop Real.tendsto_log_atTop
  have T1 : Tendsto (fun x : ℝ =>
      (∑ d ∈ Finset.Ioc 0 ⌊x⌋₊, ArithmeticFunction.vonMangoldt d / ((d : ℝ) * Real.log d))
        - Real.log (Real.log x) - Real.eulerMascheroniConstant) atTop (𝓝 0) := by
    apply squeeze_zero_norm' _ hlogK
    filter_upwards [eventually_ge_atTop (2:ℝ)] with x hx
    rw [Real.norm_eq_abs]
    exact hCK x hx
  
  have hsq : Tendsto (fun x : ℝ => 8 / Real.sqrt (⌊x⌋₊ : ℝ)) atTop (𝓝 0) := by
    apply tendsto_const_nhds.div_atTop
    exact Real.tendsto_sqrt_atTop.comp (tendsto_natCast_atTop_atTop.comp tendsto_nat_floor_atTop)
  have T2 : Tendsto (fun x : ℝ =>
      (∑ p ∈ (Finset.Iic ⌊x⌋₊).filter Nat.Prime, Real.log (1 - 1 / (p : ℝ)))
        + ∑ d ∈ Finset.Ioc 0 ⌊x⌋₊, ArithmeticFunction.vonMangoldt d / ((d : ℝ) * Real.log d))
      atTop (𝓝 0) := by
    apply squeeze_zero_norm' _ hsq
    filter_upwards [eventually_ge_atTop (1:ℝ)] with x hx
    have hN : 1 ≤ ⌊x⌋₊ := Nat.le_floor (by exact_mod_cast hx)
    rw [Real.norm_eq_abs, vonMangoldt_div_log_sum_eq_prime_sum, ← Finset.sum_add_distrib]
    have hb := prime_log_series_remainder_bound ⌊x⌋₊ hN
    have he : ∑ p ∈ (Finset.Iic ⌊x⌋₊).filter Nat.Prime,
        (Real.log (1 - 1 / (p : ℝ)) + ∑ i ∈ Finset.range (Nat.log p ⌊x⌋₊),
          (1 / (p : ℝ)) ^ (i + 1) / ((i : ℝ) + 1)) =
        ∑ p ∈ (Finset.Iic ⌊x⌋₊).filter Nat.Prime,
        ((∑ i ∈ Finset.range (Nat.log p ⌊x⌋₊), (1 / (p : ℝ)) ^ (i + 1) / ((i : ℝ) + 1))
          + Real.log (1 - 1 / (p : ℝ))) :=
      Finset.sum_congr rfl (fun p _ => add_comm _ _)
    rw [he]
    exact hb
  
  have T3 : Tendsto (fun x : ℝ =>
      (∑ p ∈ (Finset.Iic ⌊x⌋₊).filter Nat.Prime, Real.log (1 - 1 / (p : ℝ)))
        + Real.log (Real.log x) + Real.eulerMascheroniConstant) atTop (𝓝 0) := by
    have h := T2.sub T1
    rw [sub_zero] at h
    refine h.congr (fun x => ?_)
    ring
  
  have T4 := T3.rexp
  rw [Real.exp_zero] at T4
  have hz : ∀ᶠ x : ℝ in atTop, Real.exp (-Real.eulerMascheroniConstant) / Real.log x ≠ 0 := by
    filter_upwards [eventually_gt_atTop (1:ℝ)] with x hx
    exact (div_pos (Real.exp_pos _) (Real.log_pos hx)).ne'
  
  rw [Asymptotics.isEquivalent_iff_tendsto_one hz]
  refine T4.congr' ?_
  filter_upwards [eventually_gt_atTop (1:ℝ)] with x hx
  have hlog : 0 < Real.log x := Real.log_pos hx
  have hP : ∏ p ∈ (Finset.Iic ⌊x⌋₊).filter Nat.Prime, (1 - (1 : ℝ) / p) =
      Real.exp (∑ p ∈ (Finset.Iic ⌊x⌋₊).filter Nat.Prime, Real.log (1 - 1 / (p : ℝ))) := by
    rw [Real.exp_sum]
    refine Finset.prod_congr rfl (fun p hp => ?_)
    have hp2 : (2:ℝ) ≤ p := by exact_mod_cast (Finset.mem_filter.mp hp).2.two_le
    have h12 : (1:ℝ) / p ≤ 1 / 2 := one_div_le_one_div_of_le (by norm_num) hp2
    rw [Real.exp_log (by linarith)]
  simp only [Pi.div_apply]
  rw [hP, Real.exp_add, Real.exp_add, Real.exp_log hlog, Real.exp_neg]
  field_simp

theorem doubling_of_raw_counting_contracts (hcontracts : ∀ ε : ℝ, 0 < ε → ε < 1 / 2 →
      ∃ (Q : ℝ → Finset (ℕ × ℕ)) (f : ℝ → ℕ × ℕ → ℕ) (r : ℝ → ℝ),
        (∀ᶠ y : ℝ in atTop, (∀ a ∈ Q y, f y a ∈ totientsUpTo y) ∧
          V y - (((Q y).image (f y)).card : ℝ) ≤ ε * V y + r y) ∧
        r =o[atTop] V ∧
        (fun y => ((collisionPoints (Q y) (f y)).card : ℝ)) =o[atTop] V ∧
        (fun y => ((Q y).card : ℝ) -
            2 * (((Q y).filter (fun a => f y a ∈ totientsUpTo (y / 2))).card : ℝ)) =o[atTop]
          (fun y => ((Q y).card : ℝ))) :
    Tendsto (fun x => V (2 * x) / V x) atTop (𝓝 2) :=
by
  classical
  
  have s1 : ∀ (Q G : Finset (ℕ × ℕ)) (f : ℕ × ℕ → ℕ), G ⊆ Q →
      G.card ≤ (G.image f).card + (collisionPoints Q f).card := by
    intro Q G f hGQ
    have hinj : Set.InjOn f ↑(G \ collisionPoints Q f) := by
      intro a ha b hb hab
      by_contra hne
      have ha' := Finset.mem_sdiff.mp (Finset.mem_coe.mp ha)
      have hb' := Finset.mem_sdiff.mp (Finset.mem_coe.mp hb)
      apply ha'.2
      have hmemK : a ∈ Q.filter (fun a => ∃ b ∈ Q, b ≠ a ∧ f b = f a) :=
        Finset.mem_filter.mpr ⟨hGQ ha'.1, b, hGQ hb'.1, fun h => hne h.symm, hab.symm⟩
      unfold collisionPoints
      convert hmemK
    have h1 := Finset.card_image_of_injOn hinj
    have h2 : ((G \ collisionPoints Q f).image f).card ≤ (G.image f).card :=
      Finset.card_le_card (Finset.image_subset_image Finset.sdiff_subset)
    have h3 := Finset.card_le_card_sdiff_add_card (s := G) (t := collisionPoints Q f)
    omega
  have hVeq : ∀ y, V y = ((totientsUpTo y).card : ℝ) := by
    intro y
    rfl
  have hsub : ∀ y : ℝ, 0 ≤ y → totientsUpTo (y / 2) ⊆ totientsUpTo y := by
    intro y hy n hn
    simp only [totientsUpTo, Finset.mem_filter, Finset.mem_Icc] at hn ⊢
    exact ⟨⟨hn.1.1, hn.1.2.trans (Nat.floor_mono (by linarith))⟩, hn.2⟩
  
  have s2 : ∀ (y : ℝ), 0 ≤ y → ∀ (Q : Finset (ℕ × ℕ)) (f : ℕ × ℕ → ℕ),
      (∀ a ∈ Q, f a ∈ totientsUpTo y) →
      (Q.image f).card ≤ (totientsUpTo y).card ∧
      ((Q.filter (fun a => f a ∈ totientsUpTo (y / 2))).image f).card ≤
        (totientsUpTo (y / 2)).card ∧
      (totientsUpTo (y / 2)).card + (Q.image f).card ≤
        ((Q.filter (fun a => f a ∈ totientsUpTo (y / 2))).image f).card +
          (totientsUpTo y).card := by
    intro y hy Q f hmap
    have hI : Q.image f ⊆ totientsUpTo y := Finset.image_subset_iff.mpr hmap
    have hI₀ : (Q.filter (fun a => f a ∈ totientsUpTo (y / 2))).image f ⊆
        totientsUpTo (y / 2) := by
      intro n hn
      obtain ⟨a, ha, rfl⟩ := Finset.mem_image.mp hn
      exact (Finset.mem_filter.mp ha).2
    have hT := hsub y hy
    have hmiss : totientsUpTo (y / 2) \
        (Q.filter (fun a => f a ∈ totientsUpTo (y / 2))).image f ⊆
        totientsUpTo y \ Q.image f := by
      intro n hn
      obtain ⟨hn0, hn1⟩ := Finset.mem_sdiff.mp hn
      refine Finset.mem_sdiff.mpr ⟨hT hn0, ?_⟩
      intro hnI
      obtain ⟨a, ha, rfl⟩ := Finset.mem_image.mp hnI
      exact hn1 (Finset.mem_image.mpr ⟨a, Finset.mem_filter.mpr ⟨ha, hn0⟩, rfl⟩)
    have hc := Finset.card_le_card hmiss
    rw [Finset.card_sdiff_of_subset hI₀, Finset.card_sdiff_of_subset hI] at hc
    have := Finset.card_le_card hI₀
    have := Finset.card_le_card hI
    refine ⟨by omega, by omega, by omega⟩
  
  have s3 : ∀ (W v N H I C r ε δ : ℝ), 0 ≤ W → 0 ≤ ε → 0 ≤ δ → δ ≤ 1 → I ≤ W →
      W - I ≤ ε * W + r → |r| ≤ δ * W → 0 ≤ C → C ≤ δ * W → I ≤ N → N ≤ I + C →
      |N - 2 * H| ≤ δ * N → H - C ≤ v → v ≤ H + W - I → |v - W / 2| ≤ (ε + 3 * δ) * W := by
    intro W v N H I C r ε δ hW hε hδ hδ1 hIW hmiss hr hC0 hC hIN hNI hB hlo hhi
    obtain ⟨hr1, hr2⟩ := abs_le.mp hr
    obtain ⟨hB1, hB2⟩ := abs_le.mp hB
    have hNW : N ≤ W + δ * W := by linarith
    have hδN : δ * N ≤ δ * (W + δ * W) := mul_le_mul_of_nonneg_left hNW hδ
    have hδW : 0 ≤ δ * W := mul_nonneg hδ hW
    have hεW : 0 ≤ ε * W := mul_nonneg hε hW
    have hδδ : δ * (δ * W) ≤ 1 * (δ * W) := mul_le_mul_of_nonneg_right hδ1 hδW
    rw [abs_le]
    constructor
    · nlinarith
    · nlinarith
  
  have s4 : ∀ (W v : ℝ → ℝ), (∀ᶠ y in atTop, 1 ≤ W y) →
      (∀ η : ℝ, 0 < η → ∀ᶠ y in atTop, |v y - W y / 2| ≤ η * W y) →
      Tendsto (fun y => W y / v y) atTop (𝓝 2) := by
    intro W v hW hA
    have h1 : Tendsto (fun y => v y / W y) atTop (𝓝 (1 / 2)) := by
      rw [Metric.tendsto_nhds]
      intro e he
      filter_upwards [hW, hA (e / 2) (by positivity)] with y hWy hy
      have hWp : 0 < W y := by linarith
      rw [Real.dist_eq]
      have hid : v y / W y - 1 / 2 = (v y - W y / 2) / W y := by
        field_simp
      rw [hid, abs_div, abs_of_pos hWp, div_lt_iff₀ hWp]
      nlinarith
    have h2 := h1.inv₀ (by norm_num : (1 / 2 : ℝ) ≠ 0)
    have h3 : (fun y => (v y / W y)⁻¹) = fun y => W y / v y := by
      funext y
      rw [inv_div]
    rw [h3] at h2
    norm_num at h2
    exact h2
  
  have s5 : ∀ y : ℝ, 1 ≤ y → 1 ≤ V y := by
    intro y hy
    rw [hVeq]
    have hmem : 1 ∈ totientsUpTo y := by
      simp only [totientsUpTo, Finset.mem_filter, Finset.mem_Icc]
      exact ⟨⟨le_refl 1, Nat.le_floor (by exact_mod_cast hy)⟩, ⟨1, Nat.totient_one⟩⟩
    have := Finset.card_pos.mpr ⟨1, hmem⟩
    exact_mod_cast this
  
  have hmain : ∀ η : ℝ, 0 < η → ∀ᶠ y in atTop, |V (y / 2) - V y / 2| ≤ η * V y := by
    intro η hη
    have hε0 : 0 < min (η / 2) (1 / 4) := lt_min (by linarith) (by norm_num)
    have hε12 : min (η / 2) (1 / 4) < 1 / 2 := lt_of_le_of_lt (min_le_right _ _) (by norm_num)
    have hδ0 : 0 < min (η / 6) 1 := lt_min (by linarith) (by norm_num)
    have hδ1 : min (η / 6) 1 ≤ 1 := min_le_right _ _
    have hsum : min (η / 2) (1 / 4) + 3 * min (η / 6) 1 ≤ η := by
      have := min_le_left (η / 2) (1 / 4)
      have := min_le_left (η / 6) 1
      linarith
    obtain ⟨Q, f, r, hev, hr, hC, himb⟩ := hcontracts _ hε0 hε12
    filter_upwards [hev, hr.bound hδ0, hC.bound hδ0, himb.bound hδ0,
      eventually_ge_atTop (1 : ℝ)] with y hy hry hCy hBy hy1
    obtain ⟨hmap, hmiss⟩ := hy
    have hy0 : (0 : ℝ) ≤ y := by linarith
    obtain ⟨hs2a, hs2c, hs2b⟩ := s2 y hy0 (Q y) (f y) hmap
    have hs1a := s1 (Q y) (Q y) (f y) (subset_refl _)
    have hs1b := s1 (Q y) ((Q y).filter (fun a => f y a ∈ totientsUpTo (y / 2))) (f y)
      (Finset.filter_subset _ _)
    have hIN := Finset.card_image_le (s := Q y) (f := f y)
    have hI0H := Finset.card_image_le
      (s := (Q y).filter (fun a => f y a ∈ totientsUpTo (y / 2))) (f := f y)
    rw [hVeq y] at hmiss hry hCy
    simp only [Real.norm_eq_abs, Nat.abs_cast] at hry hCy hBy
    rw [hVeq y, hVeq (y / 2)]
    have e1 : ((Q y).card : ℝ) ≤ (((Q y).image (f y)).card : ℝ) +
        ((collisionPoints (Q y) (f y)).card : ℝ) := by exact_mod_cast hs1a
    have e2 : (((Q y).filter (fun a => f y a ∈ totientsUpTo (y / 2))).card : ℝ) ≤
        ((((Q y).filter (fun a => f y a ∈ totientsUpTo (y / 2))).image (f y)).card : ℝ) +
        ((collisionPoints (Q y) (f y)).card : ℝ) := by exact_mod_cast hs1b
    have e3 : (((Q y).image (f y)).card : ℝ) ≤ ((Q y).card : ℝ) := by exact_mod_cast hIN
    have e4 : ((((Q y).filter (fun a => f y a ∈ totientsUpTo (y / 2))).image (f y)).card : ℝ) ≤
        (((Q y).filter (fun a => f y a ∈ totientsUpTo (y / 2))).card : ℝ) := by
      exact_mod_cast hI0H
    have e5 : (((Q y).image (f y)).card : ℝ) ≤ ((totientsUpTo y).card : ℝ) := by
      exact_mod_cast hs2a
    have e6 : ((totientsUpTo (y / 2)).card : ℝ) + (((Q y).image (f y)).card : ℝ) ≤
        ((((Q y).filter (fun a => f y a ∈ totientsUpTo (y / 2))).image (f y)).card : ℝ) +
          ((totientsUpTo y).card : ℝ) := by exact_mod_cast hs2b
    have e7 : ((((Q y).filter (fun a => f y a ∈ totientsUpTo (y / 2))).image (f y)).card : ℝ) ≤
        ((totientsUpTo (y / 2)).card : ℝ) := by exact_mod_cast hs2c
    have key := s3 ((totientsUpTo y).card : ℝ) ((totientsUpTo (y / 2)).card : ℝ)
      ((Q y).card : ℝ) (((Q y).filter (fun a => f y a ∈ totientsUpTo (y / 2))).card : ℝ)
      (((Q y).image (f y)).card : ℝ) ((collisionPoints (Q y) (f y)).card : ℝ) (r y)
      (min (η / 2) (1 / 4)) (min (η / 6) 1) (Nat.cast_nonneg _) hε0.le hδ0.le hδ1 e5 hmiss hry
      (Nat.cast_nonneg _) hCy e3 e1 hBy (by linarith) (by linarith)
    exact key.trans (mul_le_mul_of_nonneg_right hsum (Nat.cast_nonneg _))
  
  have hW : ∀ᶠ y in atTop, 1 ≤ V y := (eventually_ge_atTop 1).mono fun y hy => s5 y hy
  have hlim := s4 V (fun y => V (y / 2)) hW hmain
  have htwo : Tendsto (fun x : ℝ => 2 * x) atTop atTop :=
    tendsto_id.const_mul_atTop (by norm_num)
  refine (hlim.comp htwo).congr (fun x => ?_)
  simp only [Function.comp]
  rw [show 2 * x / 2 = x by ring]

theorem V_lower_bound_and_power_cutoff (hPNT : Tendsto (fun x : ℝ => (Nat.primeCounting ⌊x⌋₊ : ℝ) / (x / Real.log x)) atTop (𝓝 1)) :
    (∀ᶠ x : ℝ in atTop, x / (2 * Real.log x) ≤ V x) ∧
      (fun x : ℝ => V (x ^ (99 / 100 : ℝ))) =o[atTop] V :=
by
  
  have s1 : ∀ x : ℝ, ((Nat.primeCounting ⌊x⌋₊ : ℕ) : ℝ) ≤ V x := by
    intro x
    unfold V
    rw [Nat.cast_le, Nat.primeCounting, ← Nat.primesBelow_card_eq_primeCounting']
    apply Finset.card_le_card_of_injOn (fun p => p - 1)
    · intro p hp
      have hp' := hp
      simp only [Finset.mem_coe, Nat.mem_primesBelow] at hp'
      obtain ⟨hlt, hpr⟩ := hp'
      have h2 := hpr.two_le
      simp only [Finset.mem_coe, Finset.mem_filter, Finset.mem_Icc]
      exact ⟨⟨by omega, by omega⟩, p, Nat.totient_prime hpr⟩
    · intro p hp q hq hpq
      simp only [Finset.mem_coe, Nat.mem_primesBelow] at hp hq
      have := hp.2.two_le
      have := hq.2.two_le
      simp only at hpq
      omega
  
  have s2 : ∀ y : ℝ, 0 ≤ y → V y ≤ y := by
    intro y hy
    have h1 : V y ≤ ((Finset.Icc 1 ⌊y⌋₊).card : ℝ) := by
      unfold V
      exact_mod_cast Finset.card_filter_le _ _
    have h2 : ((Finset.Icc 1 ⌊y⌋₊).card : ℝ) = (⌊y⌋₊ : ℝ) := by simp
    have h3 : ((⌊y⌋₊ : ℕ) : ℝ) ≤ y := Nat.floor_le hy
    linarith
  
  have s3 : ∀ c : ℝ, 0 < c → ∀ᶠ x : ℝ in atTop,
      x ^ (99 / 100 : ℝ) ≤ c * (x / (2 * Real.log x)) := by
    intro c hc
    have hlo := (isLittleO_log_rpow_atTop (r := (1 / 100 : ℝ)) (by norm_num)).bound
      (by positivity : (0 : ℝ) < c / 2)
    filter_upwards [hlo, eventually_gt_atTop (1 : ℝ)] with x hx hx1
    have hx0 : 0 < x := by linarith
    have hlog : 0 < Real.log x := Real.log_pos hx1
    have hr1 : 0 < x ^ (1 / 100 : ℝ) := Real.rpow_pos_of_pos hx0 _
    have hr99 : 0 < x ^ (99 / 100 : ℝ) := Real.rpow_pos_of_pos hx0 _
    rw [Real.norm_eq_abs, Real.norm_eq_abs, abs_of_pos hlog, abs_of_pos hr1] at hx
    have hid : x ^ (99 / 100 : ℝ) * x ^ (1 / 100 : ℝ) = x := by
      rw [← Real.rpow_add hx0]
      norm_num
    have key : x ^ (99 / 100 : ℝ) * Real.log x ≤ (c / 2) * x := by
      calc x ^ (99 / 100 : ℝ) * Real.log x
            ≤ x ^ (99 / 100 : ℝ) * ((c / 2) * x ^ (1 / 100 : ℝ)) :=
            mul_le_mul_of_nonneg_left hx hr99.le
        _ = (c / 2) * (x ^ (99 / 100 : ℝ) * x ^ (1 / 100 : ℝ)) := by ring
        _ = (c / 2) * x := by rw [hid]
    have heq : c * (x / (2 * Real.log x)) = (c / 2) * x / Real.log x := by ring
    rw [heq, le_div_iff₀ hlog]
    exact key
  
  have hA : ∀ᶠ x : ℝ in atTop, x / (2 * Real.log x) ≤ V x := by
    filter_upwards [hPNT.eventually_const_le (by norm_num : (1 / 2 : ℝ) < 1),
      eventually_gt_atTop (1 : ℝ)] with x hx hx1
    have hx0 : 0 < x := by linarith
    have hlog : 0 < Real.log x := Real.log_pos hx1
    have hpos : 0 < x / Real.log x := div_pos hx0 hlog
    rw [le_div_iff₀ hpos] at hx
    have := s1 x
    have heq : x / (2 * Real.log x) = 1 / 2 * (x / Real.log x) := by ring
    linarith
  
  refine ⟨hA, ?_⟩
  rw [Asymptotics.isLittleO_iff]
  intro c hc
  filter_upwards [hA, s3 c hc, eventually_gt_atTop (1 : ℝ)] with x ha hs hx1
  have hx0 : 0 < x := by linarith
  have hr : 0 ≤ x ^ (99 / 100 : ℝ) := Real.rpow_nonneg hx0.le _
  have hV1 : 0 ≤ V (x ^ (99 / 100 : ℝ)) := Nat.cast_nonneg _
  have hV2 : 0 ≤ V x := Nat.cast_nonneg _
  rw [Real.norm_eq_abs, Real.norm_eq_abs, abs_of_nonneg hV1, abs_of_nonneg hV2]
  calc V (x ^ (99 / 100 : ℝ)) ≤ x ^ (99 / 100 : ℝ) := s2 _ hr
    _ ≤ c * (x / (2 * Real.log x)) := hs
    _ ≤ c * V x := mul_le_mul_of_nonneg_left ha hc.le

theorem record_cores_and_actual_values (R : ℕ) (A : ℝ) :
    ∀ᶠ Y : ℝ in atTop, ∀ (L : ℕ) (P : ℝ) (S : CoreRecords.CoreSelection Y L R P),
      (L : ℝ) ≤ A * Real.log (logLog Y) →
        (∀ b ∈ S.cores, 0 < b ∧
          Real.log b ≤ Real.log R + A * Real.log (logLog Y) * (Real.log Y) ^ (4 / 5 : ℝ)) ∧
        (∀ bp ∈ CoreRecords.powerRawPairs S, corePairValue bp ∈ totientsUpTo Y) :=
by
  classical
  
  have s1 : ∀ {Y P : ℝ} {L : ℕ} (Q : CoreRecords.LowerCoreRecord Y L R P),
      0 < Q.numericalCore ∧ Real.log (Q.numericalCore : ℝ) ≤
        Real.log (R : ℝ) + (L : ℝ) * (Real.log Y) ^ (4 / 5 : ℝ) := by
    intro Y P L Q
    have htpos : 0 < Q.tail.totient := Nat.totient_pos.mpr Q.tail_pos
    have hfac : ∀ idx, 0 < Q.lower idx - 1 := fun idx => by
      have := (Q.prime idx).two_le
      omega
    have hprodpos : 0 < ∏ idx, (Q.lower idx - 1) := Finset.prod_pos fun idx _ => hfac idx
    refine ⟨Nat.mul_pos htpos hprodpos, ?_⟩
    unfold CoreRecords.LowerCoreRecord.numericalCore
    have hne1 : ((Q.tail.totient : ℕ) : ℝ) ≠ 0 := by exact_mod_cast htpos.ne'
    have hne2 : (∏ idx, ((Q.lower idx - 1 : ℕ) : ℝ)) ≠ 0 :=
      (Finset.prod_pos fun i _ => (by exact_mod_cast hfac i : (0:ℝ) < ((Q.lower i - 1 : ℕ) : ℝ))).ne'
    rw [Nat.cast_mul, Nat.cast_prod, Real.log_mul hne1 hne2,
      Real.log_prod (fun i _ => (by exact_mod_cast (hfac i).ne' : ((Q.lower i - 1 : ℕ) : ℝ) ≠ 0))]
    have h1 : Real.log (Q.tail.totient : ℝ) ≤ Real.log R := by
      apply Real.log_le_log (by exact_mod_cast htpos)
      exact_mod_cast (Nat.totient_le _).trans Q.tail_le
    have h2 : ∀ idx ∈ (Finset.univ : Finset (Fin L)),
        Real.log ((Q.lower idx - 1 : ℕ) : ℝ) ≤ (Real.log Y) ^ (4 / 5 : ℝ) := by
      intro idx _
      have hle : ((Q.lower idx - 1 : ℕ) : ℝ) ≤ Real.exp ((Real.log Y) ^ (4 / 5 : ℝ)) := by
        have hu := Q.upper idx
        unfold CollisionBox.cutoff at hu
        exact le_trans (by exact_mod_cast Nat.sub_le _ _) hu
      calc Real.log ((Q.lower idx - 1 : ℕ) : ℝ)
          ≤ Real.log (Real.exp ((Real.log Y) ^ (4 / 5 : ℝ))) :=
            Real.log_le_log (by exact_mod_cast hfac idx) hle
        _ = _ := Real.log_exp _
