        ((∏ p ∈ (Finset.Iic ⌊S⌋₊).filter Nat.Prime, p).totient : ℝ) ≤ C * Real.log S := by
    set E : ℝ → ℝ := fun x => ∏ p ∈ (Finset.Iic ⌊x⌋₊).filter Nat.Prime, (1 - (1 : ℝ) / p) with hEdef
    have hEpos : ∀ x : ℝ, 0 < E x := by
      intro x
      apply Finset.prod_pos
      intro p hp
      have hp2 : (2 : ℝ) ≤ p := by exact_mod_cast (Finset.mem_filter.mp hp).2.two_le
