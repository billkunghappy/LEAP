    _ ≤ x * (Ka * Real.log x ^ (3 / 2 : ℝ) / (3 / 2 : ℝ) ^ (2 * Real.log (Real.log S))) :=
        mul_le_mul_of_nonneg_left hs hx0.le
    _ = Ka * x * (Real.log x ^ (3 / 2 : ℝ) / (3 / 2 : ℝ) ^ (2 * Real.log (Real.log S))) := by
        ring
    _ ≤ Ka * x * (1 / Real.log x * Real.exp (-Real.log (Real.log S) / 6)) :=
        mul_le_mul_of_nonneg_left hdecay (by positivity)
    _ = Ka * x / Real.log x * Real.exp (-Real.log (Real.log S) / 6) * 1 := by ring
    _ ≤ Ka * x / Real.log x * Real.exp (-Real.log (Real.log S) / 6) *
          (1 + Real.log (Real.log x)) ^ 5 :=
        mul_le_mul_of_nonneg_left hpow hE
    _ = _ := by ring

theorem nonnormal_prime_density_estimate (hPNT : Tendsto (fun x : ℝ => (Nat.primeCounting ⌊x⌋₊ : ℝ) / (x / Real.log x)) atTop (𝓝 1))
    (hMERT : ∃ C : ℝ, ∀ x : ℝ, 2 ≤ x →
      |(∑ p ∈ (Finset.Iic ⌊x⌋₊).filter Nat.Prime, (1 : ℝ) / p) - Real.log (Real.log x)| ≤ C)
    (hEULER : Asymptotics.IsEquivalent atTop
      (fun x : ℝ => ∏ p ∈ (Finset.Iic ⌊x⌋₊).filter Nat.Prime, (1 - (1 : ℝ) / p))
      (fun x => Real.exp (-Real.eulerMascheroniConstant) / Real.log x)) :
    ∃ C : ℝ, 0 < C ∧ ∀ S x : ℝ, Real.exp 1 ≤ S → 3 ≤ x →
      (((Finset.Iic ⌊x⌋₊).filter (fun p => p.Prime ∧ ¬ SNormal S p)).card : ℝ) ≤
        C * x / Real.log x * (1 + Real.log (Real.log x)) ^ 5 *
          Real.exp (-Real.log (Real.log S) / 6) :=
by
  
  have hcount : ∀ n : ℕ, ((Finset.Iic n).filter Nat.Prime).card = Nat.primeCounting n := by
    intro n
    rw [Nat.primeCounting, Nat.primeCounting', Nat.count_eq_card_filter_range]
    congr 1
    ext p
    simp [Nat.lt_succ_iff]
  obtain ⟨C₁, hC₁, hcheb⟩ : ∃ C : ℝ, 0 < C ∧ ∀ x : ℝ, 2 ≤ x →
      (((Finset.Iic ⌊x⌋₊).filter Nat.Prime).card : ℝ) ≤ C * x / Real.log x := by
    have hev : ∀ᶠ x : ℝ in atTop, (Nat.primeCounting ⌊x⌋₊ : ℝ) / (x / Real.log x) < 2 :=
      hPNT.eventually (gt_mem_nhds (by norm_num))
    obtain ⟨X₀, hX₀⟩ := Filter.eventually_atTop.mp (hev.and (eventually_ge_atTop (2 : ℝ)))
    have hM0 : (0 : ℝ) ≤ (Nat.primeCounting ⌊X₀⌋₊ : ℝ) := Nat.cast_nonneg _
    refine ⟨max 2 (Nat.primeCounting ⌊X₀⌋₊ : ℝ) + 1, by
      have := le_max_left (2 : ℝ) (Nat.primeCounting ⌊X₀⌋₊ : ℝ); linarith, ?_⟩
    intro x hx
    rw [hcount]
    have hlog : 0 < Real.log x := Real.log_pos (by linarith)
    have hxl : 0 < x / Real.log x := div_pos (by linarith) hlog
    have hmul : (max 2 (Nat.primeCounting ⌊X₀⌋₊ : ℝ) + 1) * x / Real.log x =
        (max 2 (Nat.primeCounting ⌊X₀⌋₊ : ℝ) + 1) * (x / Real.log x) := by ring
    rw [hmul]
    have hm2 := le_max_left (2 : ℝ) (Nat.primeCounting ⌊X₀⌋₊ : ℝ)
    have hmM := le_max_right (2 : ℝ) (Nat.primeCounting ⌊X₀⌋₊ : ℝ)
    rcases le_total X₀ x with h | h
    · obtain ⟨h1, _⟩ := hX₀ x h
      rw [div_lt_iff₀ hxl] at h1
      nlinarith
    · have hmono : (Nat.primeCounting ⌊x⌋₊ : ℝ) ≤ (Nat.primeCounting ⌊X₀⌋₊ : ℝ) := by
        exact_mod_cast Nat.monotone_primeCounting (Nat.floor_mono h)
      have h1 : 1 ≤ x / Real.log x := by
        rw [le_div_iff₀ hlog, one_mul]
        linarith [Real.log_le_sub_one_of_pos (by linarith : 0 < x)]
      nlinarith
  
  obtain ⟨C₀, hC₀, hsieve⟩ := shifted_prime_pair_sieve_bound
  obtain ⟨Ka, hKa, htail⟩ := cardFactors_totient_tail hMERT weighted_totient_euler_bound
  obtain ⟨Cd, hCd, hdev⟩ := omegaInterval_totient_deviation hMERT weighted_totient_euler_bound
  obtain ⟨Cs, hCs, hsp⟩ := smallPrimeOmega_totient_tail hMERT weighted_totient_euler_bound
  have hred := shifted_prime_cofactor_reduction hC₀ hsieve
  obtain ⟨C₂, hC₂, hmid⟩ := middle_regime_assembly (Cr := 900 * C₀) (by positivity) hKa hCd hCs
    hred htail hdev hsp normality_grid_rounding
  obtain ⟨C₃, hC₃, hlarge⟩ := large_regime_assembly hKa htail
  have hexp0 : 0 < Real.exp (100 / 6) := Real.exp_pos _
  refine ⟨C₁ * Real.exp (100 / 6) + C₂ + C₃, by positivity, ?_⟩
  intro S x hS hx
  have hx0 : 0 < x := by linarith
  have hlogx : 1 < Real.log x := by
    rw [Real.lt_log_iff_exp_lt hx0]
    linarith [Real.exp_one_lt_d9]
  have ht : 0 < Real.log (Real.log x) := Real.log_pos hlogx
  obtain ⟨E, hE⟩ : ∃ E : ℝ, E = x / Real.log x * (1 + Real.log (Real.log x)) ^ 5 *
      Real.exp (-Real.log (Real.log S) / 6) := ⟨_, rfl⟩
  have hE0 : 0 ≤ E := by
    rw [hE]
    have : 0 < x / Real.log x := div_pos hx0 (by linarith)
    positivity
  have hrw : ∀ c : ℝ, c * x / Real.log x * (1 + Real.log (Real.log x)) ^ 5 *
      Real.exp (-Real.log (Real.log S) / 6) = c * E := by
    intro c; rw [hE]; ring
  rw [hrw]
  have hCE : ∀ c : ℝ, c ≤ C₁ * Real.exp (100 / 6) + C₂ + C₃ →
      c * E ≤ (C₁ * Real.exp (100 / 6) + C₂ + C₃) * E :=
    fun c hc => mul_le_mul_of_nonneg_right hc hE0
  have hC1e : 0 < C₁ * Real.exp (100 / 6) := mul_pos hC₁ hexp0
  rcases le_or_gt (Real.log (Real.log S)) 100 with hL | hL
  · 
    have hsub : (Finset.Iic ⌊x⌋₊).filter (fun p => p.Prime ∧ ¬ SNormal S p) ⊆
        (Finset.Iic ⌊x⌋₊).filter Nat.Prime := by
      intro p hp
      rw [Finset.mem_filter] at hp ⊢
      exact ⟨hp.1, hp.2.1⟩
    have hN : (((Finset.Iic ⌊x⌋₊).filter (fun p => p.Prime ∧ ¬ SNormal S p)).card : ℝ) ≤
        C₁ * x / Real.log x :=
      le_trans (by exact_mod_cast Finset.card_le_card hsub) (hcheb x (by linarith))
    have hxl : 0 < x / Real.log x := div_pos hx0 (by linarith)
    have hpow : 1 ≤ (1 + Real.log (Real.log x)) ^ 5 := one_le_pow₀ (by linarith)
    have hexp : 1 ≤ Real.exp (100 / 6) * Real.exp (-Real.log (Real.log S) / 6) := by
      rw [← Real.exp_add]
      exact Real.one_le_exp (by linarith)
    have hkey : x / Real.log x ≤ Real.exp (100 / 6) * E := by
      rw [hE]
      have h2 : 1 ≤ (1 + Real.log (Real.log x)) ^ 5 *
          (Real.exp (100 / 6) * Real.exp (-Real.log (Real.log S) / 6)) := by nlinarith
      calc x / Real.log x = x / Real.log x * 1 := by ring
        _ ≤ x / Real.log x * ((1 + Real.log (Real.log x)) ^ 5 *
            (Real.exp (100 / 6) * Real.exp (-Real.log (Real.log S) / 6))) :=
          mul_le_mul_of_nonneg_left h2 hxl.le
        _ = _ := by ring
    have h3 : C₁ * x / Real.log x ≤ C₁ * Real.exp (100 / 6) * E := by
      rw [mul_div_assoc, mul_assoc]
      exact mul_le_mul_of_nonneg_left hkey hC₁.le
    exact le_trans hN (le_trans h3 (hCE _ (by linarith)))
  · rcases le_or_gt (Real.log (Real.log S)) (6 * Real.log (Real.log x)) with hLT | hLT
    · 
      have h := hmid S x hS hx hL.le hLT
      rw [hrw] at h
      exact le_trans h (hCE _ (by linarith))
    · 
      have h := hlarge S x hS hx hLT.le
      rw [hrw] at h
      exact le_trans h (hCE _ (by linarith))

theorem squarefree_exceptional_count_bound {C₀ : ℝ} (hC₀ : 0 < C₀)
    (hcheb : ∀ x : ℝ, 2 ≤ x → (Nat.primeCounting ⌊x⌋₊ : ℝ) ≤ C₀ * x / Real.log x)
    (F Q : Finset ℕ) (z D : ℝ) (k : ℕ) (hz : 4 ≤ z) (hD : 0 ≤ D) (hk : 0 < k)
    (hQ : ∀ q ∈ Q, q.Prime)
    (hF : ∀ n ∈ F, Squarefree n ∧ (n : ℝ) ≤ z ∧ ArithmeticFunction.cardFactors n ≤ k ∧ ∃ q ∈ Q, q ∣ n)
    (hdensity : ∀ x : ℝ, 2 ≤ x → x ≤ z →
      ((Q.filter (fun q : ℕ => (q : ℝ) ≤ x)).card : ℝ) ≤ D * x / Real.log x) :
    (F.card : ℝ) ≤ Real.sqrt z + (2 * k * z / Real.log z) *
      (Real.exp 1 * (1 + ∑ p ∈ (Finset.Iic ⌊z⌋₊).filter Nat.Prime, (1 : ℝ) / ((p : ℝ) - 1)) ^ k) *
      (D + C₀ * ∑ q ∈ Q, (1 : ℝ) / q) :=
by
  classical
  have hzpos : 0 < z := by linarith
  have hlog : 0 < Real.log z := Real.log_pos (by linarith)
  have hkR : (0 : ℝ) < k := by exact_mod_cast hk
  
  have hlpf_ge : ∀ {n p : ℕ}, 0 < n → p.Prime → p ∣ n → p ≤ largestPrimeFactor n :=
    fun {n p} hn hp hpn =>
      (Finset.le_sup (f := id) (hp.mem_primeFactors hpn (Nat.ne_of_gt hn))).trans
        (le_max_right _ _)
  have hlpf_pow : ∀ {n : ℕ}, n ≠ 0 →
      n ≤ largestPrimeFactor n ^ ArithmeticFunction.cardFactors n := by
    intro n hn
    have h := List.prod_le_pow_card n.primeFactorsList (largestPrimeFactor n)
      (fun p hp => by
        obtain ⟨hprime, hdvd, hn'⟩ := Nat.mem_primeFactorsList'.mp hp
        exact hlpf_ge (Nat.pos_of_ne_zero hn') hprime hdvd)
    simpa only [Nat.prod_primeFactorsList hn, ArithmeticFunction.cardFactors_apply] using h
  have hlpf_one_lt : ∀ {n : ℕ}, 1 < n → 1 < largestPrimeFactor n := by
    intro n hn
    have hbound := hlpf_pow (by omega : n ≠ 0)
    have hbase : 1 ≤ largestPrimeFactor n := le_max_left _ _
    by_contra h
    have heq : largestPrimeFactor n = 1 := by omega
    simp only [heq, one_pow] at hbound
    omega
  have hlpf_mem : ∀ {n : ℕ}, 1 < largestPrimeFactor n →
      largestPrimeFactor n ∈ n.primeFactors := by
    intro n h
    have hs : n.primeFactors.Nonempty := by
      apply Finset.nonempty_iff_ne_empty.mpr
      intro hs
      simp [largestPrimeFactor, hs] at h
    obtain ⟨p, hp, hsup⟩ := Finset.exists_mem_eq_sup n.primeFactors hs id
    have hprime := Nat.prime_of_mem_primeFactors hp
    simpa only [largestPrimeFactor, hsup, id_eq, max_eq_right hprime.one_le] using hp
  have hlpf_dvd : ∀ n : ℕ, largestPrimeFactor n ∣ n := by
    intro n
    by_cases h : largestPrimeFactor n = 1
    · rw [h]; exact one_dvd n
    · have hlarge : 1 < largestPrimeFactor n := by
        have : 1 ≤ largestPrimeFactor n := le_max_left _ _
        omega
      exact Nat.dvd_of_mem_primeFactors (hlpf_mem hlarge)
  have hlog_lpf : ∀ {n : ℕ}, 0 < n →
      Real.log n ≤ ArithmeticFunction.cardFactors n * Real.log (largestPrimeFactor n) := by
    intro n hn
    have hbound : (n : ℝ) ≤ (largestPrimeFactor n : ℝ) ^ ArithmeticFunction.cardFactors n := by
      exact_mod_cast hlpf_pow hn.ne'
    have hlg := Real.log_le_log (by exact_mod_cast hn) hbound
    simpa only [Real.log_pow] using hlg
  
  have hs5 : ∀ {n : ℕ}, Real.sqrt z < (n : ℝ) → ArithmeticFunction.cardFactors n ≤ k →
      0 < n ∧ (largestPrimeFactor n).Prime ∧
        Real.log z / (2 * (k : ℝ)) ≤ Real.log (largestPrimeFactor n) := by
    intro n hn hΩ
    have hsqrt2 : (2 : ℝ) ≤ Real.sqrt z := Real.le_sqrt_of_sq_le (by norm_num; exact hz)
    have hn1 : 1 < n := by exact_mod_cast (show (1 : ℝ) < n by linarith)
    have hnpos : 0 < n := by omega
    have hp := Nat.prime_of_mem_primeFactors (hlpf_mem (hlpf_one_lt hn1))
    refine ⟨hnpos, hp, ?_⟩
    have hln : Real.log z / 2 ≤ Real.log n := by
      have h := Real.log_le_log (Real.sqrt_pos.mpr hzpos) hn.le
      simpa only [Real.log_sqrt hzpos.le] using h
    have hnlog := hlog_lpf hnpos
    have hpLog : 0 ≤ Real.log (largestPrimeFactor n) :=
      Real.log_nonneg (by exact_mod_cast hp.one_le)
    have hklog := mul_le_mul_of_nonneg_right (show (ArithmeticFunction.cardFactors n : ℝ) ≤ k
      by exact_mod_cast hΩ) hpLog
    apply (div_le_iff₀ (by positivity : (0 : ℝ) < 2 * (k : ℝ))).mpr
    nlinarith
  
  have htot_prod : ∀ s : Finset ℕ, (∀ p ∈ s, p.Prime) →
      (∏ p ∈ s, p).totient = ∏ p ∈ s, (p - 1) := by
    intro s
    induction s using Finset.induction with
    | empty => simp
    | @insert p s hps ih =>
      intro hs
      have hp : p.Prime := hs p (Finset.mem_insert_self _ _)
      have hs' : ∀ q ∈ s, q.Prime := fun q hq => hs q (Finset.mem_insert_of_mem hq)
      have hcop : p.Coprime (∏ q ∈ s, q) := by
        apply Nat.coprime_prod_right_iff.mpr
        intro q hq
        rw [hp.coprime_iff_not_dvd]
        intro hdvd
        have heq : p = q := (Nat.prime_dvd_prime_iff_eq hp (hs' q hq)).mp hdvd
        exact hps (heq.symm ▸ hq)
      rw [Finset.prod_insert hps, Nat.totient_mul hcop, Nat.totient_prime hp,
        ih hs', Finset.prod_insert hps]
  have htrunc : ∀ (P : Finset ℕ) (w : ℕ → ℝ), (∀ i ∈ P, 0 ≤ w i) →
      (∑ s ∈ P.powerset.filter (fun s => s.card ≤ k), ∏ i ∈ s, w i) ≤
        Real.exp 1 * (1 + ∑ i ∈ P, w i) ^ k := by
    intro P w hw
    set a : ℝ := 1 + ∑ i ∈ P, w i with ha_def
    have ha : 1 ≤ a := by rw [ha_def]; linarith [Finset.sum_nonneg hw]
    have ha0 : 0 < a := by linarith
    have hscaled : ∀ s ∈ P.powerset.filter (fun s => s.card ≤ k),
        (∏ i ∈ s, w i) ≤ a ^ k * ∏ i ∈ s, (w i / a) := by
      intro s hs
      obtain ⟨hsP, hsk⟩ := Finset.mem_filter.mp hs
      have hsub := Finset.mem_powerset.mp hsP
      have hnonneg : 0 ≤ ∏ i ∈ s, (w i / a) :=
        Finset.prod_nonneg fun i hi => div_nonneg (hw i (hsub hi)) ha0.le
      calc
        (∏ i ∈ s, w i) = a ^ s.card * ∏ i ∈ s, (w i / a) := by
          rw [Finset.prod_div_distrib, Finset.prod_const]
          field_simp [ne_of_gt ha0]
        _ ≤ a ^ k * ∏ i ∈ s, (w i / a) :=
          mul_le_mul_of_nonneg_right (pow_le_pow_right₀ ha hsk) hnonneg
    have hall : (∑ s ∈ P.powerset.filter (fun s => s.card ≤ k), ∏ i ∈ s, (w i / a)) ≤
        ∑ s ∈ P.powerset, ∏ i ∈ s, (w i / a) := by
      apply Finset.sum_le_sum_of_subset_of_nonneg (Finset.filter_subset _ _)
      intro s hs _
      exact Finset.prod_nonneg fun i hi =>
        div_nonneg (hw i ((Finset.mem_powerset.mp hs) hi)) ha0.le
    have hprod : (∏ i ∈ P, (1 + w i / a)) ≤ Real.exp 1 := by
      calc
        (∏ i ∈ P, (1 + w i / a)) ≤ ∏ i ∈ P, Real.exp (w i / a) := by
          apply Finset.prod_le_prod
          · intro i hi
            have := div_nonneg (hw i hi) ha0.le
            linarith
          · intro i hi
            simpa only [add_comm] using Real.add_one_le_exp (w i / a)
        _ = Real.exp (∑ i ∈ P, w i / a) := (Real.exp_sum _ _).symm
        _ ≤ Real.exp 1 := by
          apply Real.exp_le_exp.mpr
          rw [← Finset.sum_div, div_le_one ha0, ha_def]
          linarith
    calc
      _ ≤ ∑ s ∈ P.powerset.filter (fun s => s.card ≤ k), a ^ k * ∏ i ∈ s, (w i / a) :=
        Finset.sum_le_sum hscaled
      _ = a ^ k * ∑ s ∈ P.powerset.filter (fun s => s.card ≤ k), ∏ i ∈ s, (w i / a) :=
        (Finset.mul_sum _ _ _).symm
      _ ≤ a ^ k * ∑ s ∈ P.powerset, ∏ i ∈ s, (w i / a) :=
        mul_le_mul_of_nonneg_left hall (pow_nonneg ha0.le _)
      _ = a ^ k * ∏ i ∈ P, (1 + w i / a) := by rw [Finset.prod_one_add]
      _ ≤ a ^ k * Real.exp 1 := mul_le_mul_of_nonneg_left hprod (pow_nonneg ha0.le _)
      _ = _ := by ring
  have hs1 : ∀ (M P : Finset ℕ), (∀ p ∈ P, p.Prime) →
      (∀ n ∈ M, Squarefree n ∧ n.primeFactors ⊆ P ∧ n.primeFactors.card ≤ k) →
      (∑ n ∈ M, (1 : ℝ) / n) ≤
        Real.exp 1 * (1 + ∑ p ∈ P, (1 : ℝ) / ((p : ℝ) - 1)) ^ k := by
    intro M P hP hM
    have hw : ∀ p ∈ P, 0 ≤ (1 : ℝ) / ((p : ℝ) - 1) := by
      intro p hp
      have hp1 : (1 : ℝ) < p := by exact_mod_cast (hP p hp).one_lt
      exact div_nonneg zero_le_one (by linarith)
    have hinv : ∀ n ∈ M, (1 : ℝ) / n ≤ ∏ p ∈ n.primeFactors, (1 : ℝ) / ((p : ℝ) - 1) := by
      intro n hn
      have hsq := (hM n hn).1
      have hnpos : 0 < n := Nat.pos_of_ne_zero hsq.ne_zero
      have ht := htot_prod n.primeFactors (fun p hp => Nat.prime_of_mem_primeFactors hp)
      rw [Nat.prod_primeFactors_of_squarefree hsq] at ht
      have h1 : (1 : ℝ) / n ≤ 1 / (n.totient : ℝ) :=
        one_div_le_one_div_of_le (by exact_mod_cast Nat.totient_pos.mpr hnpos)
          (by exact_mod_cast Nat.totient_le n)
      have h2 : (1 : ℝ) / (n.totient : ℝ) = ∏ p ∈ n.primeFactors, (1 : ℝ) / ((p : ℝ) - 1) := by
        rw [ht, Nat.cast_prod, one_div, ← Finset.prod_inv_distrib]
        apply Finset.prod_congr rfl
        intro p hp
        rw [Nat.cast_sub (Nat.prime_of_mem_primeFactors hp).one_le, Nat.cast_one, one_div]
      linarith
    have hinj : Set.InjOn Nat.primeFactors (M : Set ℕ) := by
      intro n hn m hm hnm
      calc
        n = ∏ p ∈ n.primeFactors, p := (Nat.prod_primeFactors_of_squarefree (hM n hn).1).symm
        _ = ∏ p ∈ m.primeFactors, p := congrArg (fun s : Finset ℕ => ∏ p ∈ s, p) hnm
        _ = m := Nat.prod_primeFactors_of_squarefree (hM m hm).1
    have hsub : M.image Nat.primeFactors ⊆ P.powerset.filter (fun s => s.card ≤ k) := by
      intro s hs
      obtain ⟨n, hn, rfl⟩ := Finset.mem_image.mp hs
      exact Finset.mem_filter.mpr ⟨Finset.mem_powerset.mpr (hM n hn).2.1, (hM n hn).2.2⟩
    calc
      (∑ n ∈ M, (1 : ℝ) / n) ≤ ∑ n ∈ M, ∏ p ∈ n.primeFactors, (1 : ℝ) / ((p : ℝ) - 1) :=
        Finset.sum_le_sum hinv
      _ = ∑ s ∈ M.image Nat.primeFactors, ∏ p ∈ s, (1 : ℝ) / ((p : ℝ) - 1) :=
        (Finset.sum_image (f := fun s : Finset ℕ => ∏ p ∈ s, (1 : ℝ) / ((p : ℝ) - 1)) hinj).symm
      _ ≤ ∑ s ∈ P.powerset.filter (fun s => s.card ≤ k),
            ∏ p ∈ s, (1 : ℝ) / ((p : ℝ) - 1) := by
        apply Finset.sum_le_sum_of_subset_of_nonneg hsub
        intro s hs _
        have hsP := Finset.mem_powerset.mp (Finset.mem_filter.mp hs).1
        exact Finset.prod_nonneg fun p hp => hw p (hsP hp)
      _ ≤ _ := htrunc P (fun p : ℕ => (1 : ℝ) / ((p : ℝ) - 1)) hw
  
  have hs2 : ∀ (M P : Finset ℕ), (∀ p ∈ P, p.Prime) →
      (∀ n ∈ M, Squarefree n ∧ n.primeFactors ⊆ P ∧ n.primeFactors.card ≤ k) →
      (∀ n ∈ M, ∃ q ∈ Q, q ∣ n) →
      (∑ n ∈ M, (1 : ℝ) / n) ≤ (∑ q ∈ Q, (1 : ℝ) / q) *
        (Real.exp 1 * (1 + ∑ p ∈ P, (1 : ℝ) / ((p : ℝ) - 1)) ^ k) := by
    intro M P hP hM hbad
    have hB : ∀ q : ℕ, ∀ b ∈ (M.filter (fun n => q ∣ n)).image (fun n => n / q),
        Squarefree b ∧ b.primeFactors ⊆ P ∧ b.primeFactors.card ≤ k := by
      intro q b hb
      obtain ⟨n, hn, rfl⟩ := Finset.mem_image.mp hb
      obtain ⟨hnM, hqn⟩ := Finset.mem_filter.mp hn
      obtain ⟨hnSF, hnP, hnk⟩ := hM n hnM
      have hd : n / q ∣ n := Nat.div_dvd_of_dvd hqn
      have hsub := Nat.primeFactors_mono hd hnSF.ne_zero
      exact ⟨hnSF.squarefree_of_dvd hd, hsub.trans hnP, (Finset.card_le_card hsub).trans hnk⟩
    have hsubsum : ∀ q : ℕ,
        (∑ n ∈ M.filter (fun n => q ∣ n), (1 : ℝ) / n) =
          ((1 : ℝ) / q) * ∑ b ∈ (M.filter (fun n => q ∣ n)).image (fun n => n / q),
            (1 : ℝ) / b := by
      intro q
      have hinj : Set.InjOn (fun n : ℕ => n / q) ((M.filter (fun n => q ∣ n)) : Set ℕ) := by
        intro n hn m hm hnm
        change n / q = m / q at hnm
        have hnprod := Nat.div_mul_cancel (Finset.mem_filter.mp hn).2
        have hmprod := Nat.div_mul_cancel (Finset.mem_filter.mp hm).2
        rw [hnm, hmprod] at hnprod
        exact hnprod.symm
      rw [Finset.sum_image hinj, Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro n hn
      have hnprod : ((n / q : ℕ) : ℝ) * q = n := by
        exact_mod_cast Nat.div_mul_cancel (Finset.mem_filter.mp hn).2
      calc
        _ = 1 / (((n / q : ℕ) : ℝ) * q) := by rw [hnprod]
        _ = _ := by ring
    have hcover : (∑ n ∈ M, (1 : ℝ) / n) ≤
        ∑ q ∈ Q, ∑ n ∈ M.filter (fun n => q ∣ n), (1 : ℝ) / n := by
      simp only [Finset.sum_filter]
      rw [Finset.sum_comm]
      apply Finset.sum_le_sum
      intro n hn
      obtain ⟨q, hq, hqn⟩ := hbad n hn
      have h := Finset.single_le_sum (s := Q)
        (f := fun q : ℕ => if q ∣ n then (1 : ℝ) / n else 0)
        (fun r hr => by dsimp only; split_ifs <;> positivity) hq
      simpa only [if_pos hqn] using h
    calc
      _ ≤ _ := hcover
      _ = ∑ q ∈ Q, ((1 : ℝ) / q) *
            ∑ b ∈ (M.filter (fun n => q ∣ n)).image (fun n => n / q), (1 : ℝ) / b :=
        Finset.sum_congr rfl (fun q _ => hsubsum q)
      _ ≤ ∑ q ∈ Q, ((1 : ℝ) / q) *
          (Real.exp 1 * (1 + ∑ p ∈ P, (1 : ℝ) / ((p : ℝ) - 1)) ^ k) := by
        apply Finset.sum_le_sum
        intro q hq
        exact mul_le_mul_of_nonneg_left (hs1 _ P hP (hB q)) (by positivity)
      _ = _ := (Finset.sum_mul _ _ _).symm
  
  have hs3 : ∀ (F' P : Finset ℕ) (p : ℕ → ℕ) (E a : ℝ), 0 ≤ E → 0 < a →
      (∀ n ∈ F', 0 < n ∧ (n : ℝ) ≤ z ∧ (p n).Prime ∧ p n ∣ n ∧
        a ≤ Real.log (p n) ∧ p n ∈ P) →
      (∀ x : ℝ, 2 ≤ x → x ≤ z →
        ((P.filter (fun q : ℕ => (q : ℝ) ≤ x)).card : ℝ) ≤ E * x / Real.log x) →
      (F'.card : ℝ) ≤ E * z / a * ∑ b ∈ F'.image (fun n => n / p n), (1 : ℝ) / b := by
    intro F' P p E a hE ha hF' hdens
    have hbpos : ∀ n ∈ F', 0 < n / p n := by
      intro n hn
      obtain ⟨hnpos, _, hp, hd, _⟩ := hF' n hn
      exact Nat.div_pos (Nat.le_of_dvd hnpos hd) hp.pos
    have hple : ∀ n ∈ F', (p n : ℝ) ≤ z / (n / p n : ℕ) := by
      intro n hn
      have hbR : (0 : ℝ) < (n / p n : ℕ) := by exact_mod_cast hbpos n hn
      apply (le_div_iff₀ hbR).mpr
      have hmul : (p n : ℝ) * (n / p n : ℕ) = n := by
        exact_mod_cast Nat.mul_div_cancel' (hF' n hn).2.2.2.1
      exact hmul.trans_le (hF' n hn).2.1
    have hB : ∀ b ∈ F'.image (fun n => n / p n),
        0 < b ∧ 2 ≤ z / b ∧ z / b ≤ z ∧ a ≤ Real.log (z / b) := by
      intro b hb
      obtain ⟨n, hn, rfl⟩ := Finset.mem_image.mp hb
      obtain ⟨hnpos, hnz, hp, hd, hlg, _⟩ := hF' n hn
      refine ⟨hbpos n hn, (by exact_mod_cast hp.two_le : (2 : ℝ) ≤ p n).trans (hple n hn), ?_, ?_⟩
      · exact div_le_self hzpos.le (by exact_mod_cast hbpos n hn)
      · exact hlg.trans (Real.log_le_log (by exact_mod_cast hp.pos) (hple n hn))
    have hcard : F'.card ≤ ((F'.image (fun n => n / p n)).sigma
        fun b => P.filter (fun q : ℕ => (q : ℝ) ≤ z / b)).card := by
      apply Finset.card_le_card_of_injOn (fun n => (⟨n / p n, p n⟩ : Σ _ : ℕ, ℕ))
      · intro n hn
        exact Finset.mem_sigma.mpr ⟨Finset.mem_image.mpr ⟨n, hn, rfl⟩,
          Finset.mem_filter.mpr ⟨(hF' n hn).2.2.2.2.2, hple n hn⟩⟩
      · intro n hn m hm heq
        have hb : n / p n = m / p m := congrArg Sigma.fst heq
        have hp : p n = p m := congrArg (fun x : Σ _ : ℕ, ℕ => x.2) heq
        calc
          n = (n / p n) * p n := (Nat.div_mul_cancel (hF' n hn).2.2.2.1).symm
          _ = (m / p m) * p m := by rw [hb, hp]
          _ = m := Nat.div_mul_cancel (hF' m hm).2.2.2.1
    have hsum : (F'.card : ℝ) ≤ ∑ b ∈ F'.image (fun n => n / p n),
        ((P.filter (fun q : ℕ => (q : ℝ) ≤ z / b)).card : ℝ) := by
      have hR : (F'.card : ℝ) ≤ (((F'.image (fun n => n / p n)).sigma
          fun b => P.filter (fun q : ℕ => (q : ℝ) ≤ z / b)).card : ℝ) := by
        exact_mod_cast hcard
      simpa only [Finset.card_sigma, Nat.cast_sum] using hR
    calc
      _ ≤ _ := hsum
      _ ≤ ∑ b ∈ F'.image (fun n => n / p n), (E * z / a) * ((1 : ℝ) / b) := by
        apply Finset.sum_le_sum
        intro b hb
        obtain ⟨hbpos, hx2, hxz, halog⟩ := hB b hb
        have hbR : (0 : ℝ) < b := by exact_mod_cast hbpos
        calc
          _ ≤ E * (z / b) / Real.log (z / b) := hdens _ hx2 hxz
          _ ≤ E * (z / b) / a := div_le_div_of_nonneg_left (by positivity) ha halog
          _ = _ := by ring
      _ = _ := (Finset.mul_sum _ _ _).symm
  
  have hs4 : ∀ x : ℝ, (((Finset.Iic ⌊z⌋₊).filter Nat.Prime).filter
      (fun q : ℕ => (q : ℝ) ≤ x)).card ≤ Nat.primeCounting ⌊x⌋₊ := by
    intro x
    have hsub : ((Finset.Iic ⌊z⌋₊).filter Nat.Prime).filter (fun q : ℕ => (q : ℝ) ≤ x) ⊆
        Nat.primesBelow (⌊x⌋₊ + 1) := by
      intro q hq
      simp only [Finset.mem_filter] at hq
      rw [Nat.mem_primesBelow]
      exact ⟨Nat.lt_succ_of_le (Nat.le_floor hq.2), hq.1.2⟩
    calc _ ≤ (Nat.primesBelow (⌊x⌋₊ + 1)).card := Finset.card_le_card hsub
      _ = Nat.primeCounting ⌊x⌋₊ := by rw [Nat.primesBelow_card_eq_primeCounting']; rfl
  
  have hPz : ∀ p ∈ (Finset.Iic ⌊z⌋₊).filter Nat.Prime, p.Prime :=
    fun p hp => (Finset.mem_filter.mp hp).2
  set G := F.filter (fun n : ℕ => Real.sqrt z < n) with hG_def
  set E := F.filter (fun n : ℕ => ¬ Real.sqrt z < n) with hE_def
  set A := G.filter (fun n => largestPrimeFactor n ∈ Q) with hA_def
  set B := G.filter (fun n => ¬ largestPrimeFactor n ∈ Q) with hB_def
  set W := Real.exp 1 * (1 + ∑ p ∈ (Finset.Iic ⌊z⌋₊).filter Nat.Prime,
    (1 : ℝ) / ((p : ℝ) - 1)) ^ k with hW_def
  set a := Real.log z / (2 * (k : ℝ)) with ha_def
  have ha : 0 < a := by rw [ha_def]; positivity
  have hG : ∀ n ∈ G, 0 < n ∧ (n : ℝ) ≤ z ∧ (largestPrimeFactor n).Prime ∧
      largestPrimeFactor n ∣ n ∧ a ≤ Real.log (largestPrimeFactor n) := by
    intro n hn
    obtain ⟨hnF, hnlarge⟩ := Finset.mem_filter.mp hn
    have hnData := hF n hnF
    obtain ⟨hnpos, hp, hplog⟩ := hs5 hnlarge hnData.2.2.1
    exact ⟨hnpos, hnData.2.1, hp, hlpf_dvd n, hplog⟩
  have hdata : ∀ J : Finset ℕ, J ⊆ G → ∀ b ∈ J.image (fun n => n / largestPrimeFactor n),
      Squarefree b ∧ b.primeFactors ⊆ (Finset.Iic ⌊z⌋₊).filter Nat.Prime ∧
        b.primeFactors.card ≤ k := by
    intro J hJ b hb
    obtain ⟨n, hn, rfl⟩ := Finset.mem_image.mp hb
    have hnF := (Finset.mem_filter.mp (hJ hn)).1
    obtain ⟨hnSF, hnz, hnk, _⟩ := hF n hnF
    have hd : n / largestPrimeFactor n ∣ n := Nat.div_dvd_of_dvd (hlpf_dvd n)
    have hsub := Nat.primeFactors_mono hd hnSF.ne_zero
    refine ⟨hnSF.squarefree_of_dvd hd, ?_, ?_⟩
    · intro q hq
      have hqn : q ≤ n := (Nat.le_of_mem_primeFactors hq).trans (Nat.div_le_self _ _)
      have hqnR : (q : ℝ) ≤ n := by exact_mod_cast hqn
      exact Finset.mem_filter.mpr ⟨Finset.mem_Iic.mpr (Nat.le_floor (hqnR.trans hnz)),
        Nat.prime_of_mem_primeFactors hq⟩
    · have hcf : n.primeFactors.card ≤ ArithmeticFunction.cardFactors n := by
        change n.primeFactorsList.toFinset.card ≤ n.primeFactorsList.length
        exact List.toFinset_card_le (l := n.primeFactorsList)
      exact (Finset.card_le_card hsub).trans (hcf.trans hnk)
  have hA : (A.card : ℝ) ≤ (D * z / a) * W := by
    have hc := hs3 A Q largestPrimeFactor D a hD ha
      (fun n hn => by
        have hg := hG n (Finset.mem_filter.mp hn).1
        exact ⟨hg.1, hg.2.1, hg.2.2.1, hg.2.2.2.1, hg.2.2.2.2, (Finset.mem_filter.mp hn).2⟩)
      hdensity
    exact hc.trans (mul_le_mul_of_nonneg_left
      (hs1 _ _ hPz (hdata A (Finset.filter_subset _ _))) (by positivity))
  have hBbad : ∀ b ∈ B.image (fun n => n / largestPrimeFactor n), ∃ q ∈ Q, q ∣ b := by
    intro b hb
    obtain ⟨n, hn, rfl⟩ := Finset.mem_image.mp hb
    obtain ⟨hnG, hnQ⟩ := Finset.mem_filter.mp hn
    have hnF := (Finset.mem_filter.mp hnG).1
    obtain ⟨q, hq, hqn⟩ := (hF n hnF).2.2.2
    refine ⟨q, hq, ?_⟩
    have hnprod := Nat.mul_div_cancel' (hlpf_dvd n)
    have hdiv : q ∣ largestPrimeFactor n * (n / largestPrimeFactor n) := by
      rw [hnprod]
      exact hqn
    rcases (hQ q hq).dvd_mul.mp hdiv with hqp | hqb
    · have heq := (Nat.prime_dvd_prime_iff_eq (hQ q hq) (hG n hnG).2.2.1).mp hqp
      exact (hnQ (heq ▸ hq)).elim
    · exact hqb
  have hB : (B.card : ℝ) ≤ (C₀ * z / a) * ((∑ q ∈ Q, (1 : ℝ) / q) * W) := by
    have hdensPz : ∀ x : ℝ, 2 ≤ x → x ≤ z →
        ((((Finset.Iic ⌊z⌋₊).filter Nat.Prime).filter (fun q : ℕ => (q : ℝ) ≤ x)).card : ℝ) ≤
          C₀ * x / Real.log x := by
      intro x hx2 _
      have h4 : ((((Finset.Iic ⌊z⌋₊).filter Nat.Prime).filter
          (fun q : ℕ => (q : ℝ) ≤ x)).card : ℝ) ≤ (Nat.primeCounting ⌊x⌋₊ : ℝ) := by
        exact_mod_cast hs4 x
      exact h4.trans (hcheb x hx2)
    have hc := hs3 B ((Finset.Iic ⌊z⌋₊).filter Nat.Prime) largestPrimeFactor C₀ a hC₀.le ha
      (fun n hn => by
        have hg := hG n (Finset.mem_filter.mp hn).1
        have hle : largestPrimeFactor n ≤ ⌊z⌋₊ := by
          have h1 : largestPrimeFactor n ≤ n := Nat.le_of_dvd hg.1 hg.2.2.2.1
          exact h1.trans (Nat.le_floor hg.2.1)
        exact ⟨hg.1, hg.2.1, hg.2.2.1, hg.2.2.2.1, hg.2.2.2.2,
          Finset.mem_filter.mpr ⟨Finset.mem_Iic.mpr hle, hg.2.2.1⟩⟩)
      hdensPz
    exact hc.trans (mul_le_mul_of_nonneg_left
      (hs2 _ _ hPz (hdata B (Finset.filter_subset _ _)) hBbad) (by positivity))
  have hE : (E.card : ℝ) ≤ Real.sqrt z := by
    have hsub : E ⊆ Finset.Icc 1 ⌊Real.sqrt z⌋₊ := by
      intro n hn
      obtain ⟨hnF, hnsmall⟩ := Finset.mem_filter.mp hn
      exact Finset.mem_Icc.mpr ⟨Nat.one_le_iff_ne_zero.mpr (hF n hnF).1.ne_zero,
        Nat.le_floor (le_of_not_gt hnsmall)⟩
    calc
      _ ≤ ((Finset.Icc 1 ⌊Real.sqrt z⌋₊).card : ℝ) := by exact_mod_cast Finset.card_le_card hsub
      _ = (⌊Real.sqrt z⌋₊ : ℝ) := by simp
      _ ≤ _ := Nat.floor_le (Real.sqrt_nonneg _)
  have hcardG : (A.card : ℝ) + B.card = G.card := by
    exact_mod_cast Finset.card_filter_add_card_filter_not (s := G)
      (fun n => largestPrimeFactor n ∈ Q)
  have hcardF : (G.card : ℝ) + E.card = F.card := by
    exact_mod_cast Finset.card_filter_add_card_filter_not (s := F)
      (fun n : ℕ => Real.sqrt z < n)
  have htotal : (F.card : ℝ) ≤ Real.sqrt z +
      (D * z / a) * W + (C₀ * z / a) * ((∑ q ∈ Q, (1 : ℝ) / q) * W) := by linarith
  apply htotal.trans_eq
  rw [ha_def]
  field_simp
  ring

theorem reciprocal_sum_of_density : ∃ K : ℝ, 0 < K ∧ ∀ (Q : Finset ℕ) (z D : ℝ), Real.exp 1 ≤ z → 0 ≤ D →
      (∀ q ∈ Q, 2 ≤ q ∧ (q : ℝ) ≤ z) →
      (∀ x : ℝ, 2 ≤ x → x ≤ z → ((Q.filter (fun q : ℕ => (q : ℝ) ≤ x)).card : ℝ) ≤ D * x / Real.log x) →
      (∑ q ∈ Q, (1 : ℝ) / q) ≤ K * D * (1 + Real.log (Real.log z)) :=
by
  refine ⟨8, by norm_num, ?_⟩
  intro Q z D hz hD hQ hdens
  have he2 : (2 : ℝ) ≤ Real.exp 1 := by linarith [Real.add_one_le_exp (1 : ℝ)]
  have hz2 : (2 : ℝ) ≤ z := le_trans he2 hz
  have hz0 : (0 : ℝ) ≤ z := by linarith
  have hlog2 : 0 < Real.log 2 := Real.log_pos (by norm_num)
  have hlog2' : 1 / 2 < Real.log 2 := by have := Real.log_two_gt_d9; linarith
  have hlog2'' : Real.log 2 < 1 := by have := Real.log_two_lt_d9; linarith
  have hlz : 1 ≤ Real.log z := by
    have := Real.log_le_log (Real.exp_pos 1) hz
    rwa [Real.log_exp] at this
  have hllz : 0 ≤ Real.log (Real.log z) := Real.log_nonneg hlz
  
  have hblock : ∀ k : ℕ, 1 ≤ k →
      (∑ q ∈ Q.filter (fun q : ℕ => Nat.log 2 q = k), (1 : ℝ) / q) ≤ 2 * D / (k * Real.log 2) := by
    intro k hk
    have hk' : (1 : ℝ) ≤ k := by exact_mod_cast hk
    have hkl : 0 < (k : ℝ) * Real.log 2 := mul_pos (by linarith) hlog2
    have hkne : (k : ℝ) ≠ 0 := by linarith
    have hl2ne : Real.log 2 ≠ 0 := hlog2.ne'
    have hmemB : ∀ q ∈ Q.filter (fun q : ℕ => Nat.log 2 q = k),
        q ∈ Q ∧ (2 : ℝ) ^ k ≤ q ∧ (q : ℝ) < 2 ^ (k + 1) := by
      intro q hq
      rw [Finset.mem_filter] at hq
      obtain ⟨hqQ, hqk⟩ := hq
      have hq2 := (hQ q hqQ).1
      have hq0 : q ≠ 0 := by omega
      have h1 : 2 ^ k ≤ q := by rw [← hqk]; exact Nat.pow_log_le_self 2 hq0
      have h2 : q < 2 ^ (k + 1) := by rw [← hqk]; exact Nat.lt_pow_succ_log_self (by norm_num) q
      refine ⟨hqQ, by exact_mod_cast h1, by exact_mod_cast h2⟩
    rcases (Q.filter (fun q : ℕ => Nat.log 2 q = k)).eq_empty_or_nonempty with hBe | ⟨q0, hq0⟩
    · rw [hBe, Finset.sum_empty]; exact div_nonneg (by linarith) hkl.le
    obtain ⟨hq0Q, hq0k, _⟩ := hmemB q0 hq0
    have h2kz : (2 : ℝ) ^ k ≤ z := le_trans hq0k (hQ q0 hq0Q).2
    have hpk : (0 : ℝ) < 2 ^ k := by positivity
    have h2k1 : (2 : ℝ) ^ (k + 1) = 2 * 2 ^ k := by ring
    have h2k2 : (2 : ℝ) ≤ 2 ^ k := by
      calc (2 : ℝ) = 2 ^ 1 := by norm_num
        _ ≤ 2 ^ k := pow_le_pow_right₀ (by norm_num) hk
    have hx2 : 2 ≤ min ((2 : ℝ) ^ (k + 1)) z := le_min (by linarith) hz2
    have hxz : min ((2 : ℝ) ^ (k + 1)) z ≤ z := min_le_right _ _
    have hxu : min ((2 : ℝ) ^ (k + 1)) z ≤ 2 ^ (k + 1) := min_le_left _ _
    have hxl : (2 : ℝ) ^ k ≤ min ((2 : ℝ) ^ (k + 1)) z := le_min (by linarith) h2kz
    have hsub : Q.filter (fun q : ℕ => Nat.log 2 q = k) ⊆
        Q.filter (fun q : ℕ => (q : ℝ) ≤ min ((2 : ℝ) ^ (k + 1)) z) := by
      intro q hq
      obtain ⟨hqQ, _, hqu⟩ := hmemB q hq
      rw [Finset.mem_filter]
      exact ⟨hqQ, le_min hqu.le (hQ q hqQ).2⟩
    have hcard : ((Q.filter (fun q : ℕ => Nat.log 2 q = k)).card : ℝ) ≤
        D * min ((2 : ℝ) ^ (k + 1)) z / Real.log (min ((2 : ℝ) ^ (k + 1)) z) := by
      have := Finset.card_le_card hsub
      calc ((Q.filter (fun q : ℕ => Nat.log 2 q = k)).card : ℝ)
          ≤ ((Q.filter (fun q : ℕ => (q : ℝ) ≤ min ((2 : ℝ) ^ (k + 1)) z)).card : ℝ) := by
            exact_mod_cast this
        _ ≤ _ := hdens _ hx2 hxz
    have hlogx : (k : ℝ) * Real.log 2 ≤ Real.log (min ((2 : ℝ) ^ (k + 1)) z) := by
      have := Real.log_le_log hpk hxl
      rwa [Real.log_pow] at this
    have hcard2 : ((Q.filter (fun q : ℕ => Nat.log 2 q = k)).card : ℝ) ≤
        D * 2 ^ (k + 1) / (k * Real.log 2) := by
      calc ((Q.filter (fun q : ℕ => Nat.log 2 q = k)).card : ℝ)
          ≤ D * min ((2 : ℝ) ^ (k + 1)) z / Real.log (min ((2 : ℝ) ^ (k + 1)) z) := hcard
        _ ≤ D * 2 ^ (k + 1) / (k * Real.log 2) :=
          div_le_div₀ (mul_nonneg hD (by positivity)) (mul_le_mul_of_nonneg_left hxu hD) hkl hlogx
    have hterm : ∀ q ∈ Q.filter (fun q : ℕ => Nat.log 2 q = k), (1 : ℝ) / q ≤ 1 / 2 ^ k := by
      intro q hq
      exact one_div_le_one_div_of_le hpk (hmemB q hq).2.1
    calc (∑ q ∈ Q.filter (fun q : ℕ => Nat.log 2 q = k), (1 : ℝ) / q)
        ≤ ∑ q ∈ Q.filter (fun q : ℕ => Nat.log 2 q = k), (1 : ℝ) / 2 ^ k :=
          Finset.sum_le_sum hterm
      _ = ((Q.filter (fun q : ℕ => Nat.log 2 q = k)).card : ℝ) * (1 / 2 ^ k) := by
          rw [Finset.sum_const, nsmul_eq_mul]
      _ ≤ (D * 2 ^ (k + 1) / (k * Real.log 2)) * (1 / 2 ^ k) :=
          mul_le_mul_of_nonneg_right hcard2 (by positivity)
      _ = 2 * D / (k * Real.log 2) := by
          rw [h2k1]; field_simp
  
  have hfl2 : 2 ≤ ⌊z⌋₊ := Nat.le_floor (by exact_mod_cast hz2)
  have hM1 : 1 ≤ Nat.log 2 ⌊z⌋₊ := Nat.log_pos (by norm_num) hfl2
  have hharm : (∑ k ∈ Finset.Icc 1 (Nat.log 2 ⌊z⌋₊), (1 : ℝ) / k) ≤
      2 * (1 + Real.log (Real.log z)) := by
    have hH : (∑ k ∈ Finset.Icc 1 (Nat.log 2 ⌊z⌋₊), (1 : ℝ) / k) =
        (harmonic (Nat.log 2 ⌊z⌋₊) : ℝ) := by
      rw [harmonic_eq_sum_Icc]; push_cast; simp [one_div]
    rw [hH]
    have h1 := harmonic_le_one_add_log (Nat.log 2 ⌊z⌋₊)
    have hMpos : (0 : ℝ) < (Nat.log 2 ⌊z⌋₊ : ℕ) := by exact_mod_cast hM1
    have h2M : (2 : ℝ) ^ (Nat.log 2 ⌊z⌋₊) ≤ z := by
      have : 2 ^ (Nat.log 2 ⌊z⌋₊) ≤ ⌊z⌋₊ := Nat.pow_log_le_self 2 (by omega)
      calc (2 : ℝ) ^ (Nat.log 2 ⌊z⌋₊) = ((2 ^ (Nat.log 2 ⌊z⌋₊) : ℕ) : ℝ) := by push_cast; ring
        _ ≤ (⌊z⌋₊ : ℝ) := by exact_mod_cast this
        _ ≤ z := Nat.floor_le hz0
    have hMlog : ((Nat.log 2 ⌊z⌋₊ : ℕ) : ℝ) * Real.log 2 ≤ Real.log z := by
      have := Real.log_le_log (by positivity) h2M
      rwa [Real.log_pow] at this
    have hM2 : ((Nat.log 2 ⌊z⌋₊ : ℕ) : ℝ) ≤ 2 * Real.log z := by nlinarith
    have hlogM : Real.log ((Nat.log 2 ⌊z⌋₊ : ℕ) : ℝ) ≤ Real.log 2 + Real.log (Real.log z) := by
      rw [← Real.log_mul (by norm_num) (by linarith)]
      exact Real.log_le_log hMpos hM2
    linarith
  
  have hmaps : ∀ q ∈ Q, Nat.log 2 q ∈ Finset.Icc 1 (Nat.log 2 ⌊z⌋₊) := by
    intro q hq
    obtain ⟨hq2, hqz⟩ := hQ q hq
    rw [Finset.mem_Icc]
    exact ⟨Nat.log_pos (by norm_num) hq2, Nat.log_mono_right (Nat.le_floor hqz)⟩
  rw [← Finset.sum_fiberwise_of_maps_to hmaps]
  calc (∑ k ∈ Finset.Icc 1 (Nat.log 2 ⌊z⌋₊), ∑ q ∈ Q with Nat.log 2 q = k, (1 : ℝ) / q)
      ≤ ∑ k ∈ Finset.Icc 1 (Nat.log 2 ⌊z⌋₊), 2 * D / (k * Real.log 2) := by
        apply Finset.sum_le_sum
        intro k hk
        exact hblock k (Finset.mem_Icc.mp hk).1
    _ = (2 * D / Real.log 2) * ∑ k ∈ Finset.Icc 1 (Nat.log 2 ⌊z⌋₊), (1 : ℝ) / k := by
        rw [Finset.mul_sum]
        apply Finset.sum_congr rfl
        intro k hk
        have hk1 := (Finset.mem_Icc.mp hk).1
        have : (k : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr (by omega)
        have : Real.log 2 ≠ 0 := hlog2.ne'
        field_simp
    _ ≤ (2 * D / Real.log 2) * (2 * (1 + Real.log (Real.log z))) :=
        mul_le_mul_of_nonneg_left hharm (div_nonneg (by linarith) hlog2.le)
    _ ≤ 8 * D * (1 + Real.log (Real.log z)) := by
        have hinv : 1 / Real.log 2 ≤ 2 := by
          rw [div_le_iff₀ hlog2]; linarith
        have hX : 0 ≤ D * (1 + Real.log (Real.log z)) := mul_nonneg hD (by linarith)
        calc (2 * D / Real.log 2) * (2 * (1 + Real.log (Real.log z)))
            = 4 * (1 / Real.log 2) * (D * (1 + Real.log (Real.log z))) := by ring
          _ ≤ 4 * 2 * (D * (1 + Real.log (Real.log z))) := by
              apply mul_le_mul_of_nonneg_right _ hX; linarith
          _ = 8 * D * (1 + Real.log (Real.log z)) := by ring

theorem squarefree_nonnormal_count (hPNT : Tendsto (fun x : ℝ => (Nat.primeCounting ⌊x⌋₊ : ℝ) / (x / Real.log x)) atTop (𝓝 1))
    (hMERT : ∃ C : ℝ, ∀ x : ℝ, 2 ≤ x →
      |(∑ p ∈ (Finset.Iic ⌊x⌋₊).filter Nat.Prime, (1 : ℝ) / p) - Real.log (Real.log x)| ≤ C)
    (hEULER : Asymptotics.IsEquivalent atTop
      (fun x : ℝ => ∏ p ∈ (Finset.Iic ⌊x⌋₊).filter Nat.Prime, (1 - (1 : ℝ) / p))
      (fun x => Real.exp (-Real.eulerMascheroniConstant) / Real.log x))
    {A c : ℝ} (hA : 0 < A) (hc : 0 < c) :
    ∀ᶠ Y : ℝ in atTop, (((Finset.Icc 1 ⌊c * Y * logLog Y⌋₊).filter (fun n => Squarefree n ∧
      ArithmeticFunction.cardFactors n ≤ ⌊A * Real.log (logLog Y)⌋₊ + 1 ∧
      ∃ q : ℕ, q.Prime ∧ q ∣ n ∧ ¬ SNormal (normalityScale (logLog Y)) q)).card : ℝ) ≤
        Y / (Real.log Y * (logLog Y) ^ 2) :=
by
  have he2 : (2 : ℝ) ≤ Real.exp 1 := by linarith [Real.add_one_le_exp (1 : ℝ)]
  
  have hcheb_ex : ∃ C : ℝ, 0 < C ∧ ∀ x : ℝ, 2 ≤ x →
      (Nat.primeCounting ⌊x⌋₊ : ℝ) ≤ C * x / Real.log x := by
    have hev : ∀ᶠ x : ℝ in atTop, (Nat.primeCounting ⌊x⌋₊ : ℝ) / (x / Real.log x) < 2 :=
      hPNT.eventually (gt_mem_nhds (by norm_num))
    obtain ⟨X₀, hX₀⟩ := (hev.and (eventually_ge_atTop (2 : ℝ))).exists_forall_of_atTop
    obtain ⟨M, hM⟩ : ∃ M : ℝ, M = (Nat.primeCounting ⌊X₀⌋₊ : ℝ) := ⟨_, rfl⟩
    have hmax2 : (2 : ℝ) ≤ max 2 M := le_max_left _ _
    refine ⟨max 2 M + 1, by linarith, ?_⟩
    intro x hx
    have hlogx : 0 < Real.log x := Real.log_pos (by linarith)
    have hxl : 0 < x / Real.log x := div_pos (by linarith) hlogx
    rw [mul_div_assoc]
    rcases le_total X₀ x with h | h
    · obtain ⟨h1, _⟩ := hX₀ x h
      rw [div_lt_iff₀ hxl] at h1
      nlinarith [mul_le_mul_of_nonneg_right hmax2 hxl.le]
    · have hmono : Nat.primeCounting ⌊x⌋₊ ≤ Nat.primeCounting ⌊X₀⌋₊ :=
        Nat.monotone_primeCounting (Nat.floor_le_floor h)
      have hge1 : 1 ≤ x / Real.log x := by
        rw [le_div_iff₀ hlogx]
        linarith [Real.log_le_sub_one_of_pos (by linarith : (0 : ℝ) < x)]
      have hpiM : (Nat.primeCounting ⌊x⌋₊ : ℝ) ≤ M := by rw [hM]; exact_mod_cast hmono
      have hMm : M ≤ max 2 M := le_max_right _ _
      nlinarith [mul_le_mul_of_nonneg_left hge1 (by linarith : (0 : ℝ) ≤ max 2 M + 1)]
  obtain ⟨Cd, hCd, hdens⟩ := nonnormal_prime_density_estimate hPNT hMERT hEULER
  obtain ⟨C₀, hC₀, hcheb⟩ := hcheb_ex
  obtain ⟨K₁, hK₁, hrecip⟩ := reciprocal_sum_of_density
  have hLL : Tendsto logLog atTop atTop :=
    Real.tendsto_log_atTop.comp Real.tendsto_log_atTop
  
  have hpar_ev : ∀ᶠ Y : ℝ in atTop, 1 ≤ Real.log (logLog Y) ∧ 1 ≤ c * logLog Y ∧
      0 < Real.log Y ∧ 4 ≤ c * Y * logLog Y ∧ Real.exp (Real.exp 1) ≤ c * Y * logLog Y ∧
      Y ≤ c * Y * logLog Y ∧ Real.log (Real.log (c * Y * logLog Y)) ≤ 2 * logLog Y := by
    filter_upwards [hLL.eventually_ge_atTop (Real.exp 1), hLL.eventually_ge_atTop (1 / c),
      eventually_ge_atTop (max 4 (Real.exp (Real.exp 1))),
      Real.tendsto_log_atTop.eventually_ge_atTop (2 + |Real.log c|)] with Y hTe hTc hY hlY
    have hY4 : 4 ≤ Y := le_trans (le_max_left _ _) hY
    have hYee : Real.exp (Real.exp 1) ≤ Y := le_trans (le_max_right _ _) hY
    have hY0 : 0 < Y := by linarith
    have hT0 : 0 < logLog Y := by linarith
    have hlogY : 0 < Real.log Y := by linarith [abs_nonneg (Real.log c)]
    have hu1 : 1 ≤ Real.log (logLog Y) := by
      have := Real.log_le_log (Real.exp_pos 1) hTe
      rwa [Real.log_exp] at this
    have hcT : 1 ≤ c * logLog Y := by
      have := mul_le_mul_of_nonneg_left hTc hc.le
      rwa [mul_one_div_cancel hc.ne'] at this
    have hYz : Y ≤ c * Y * logLog Y := by
      have := mul_le_mul_of_nonneg_left hcT hY0.le
      nlinarith
    refine ⟨hu1, hcT, hlogY, by linarith, by linarith, hYz, ?_⟩
    have hlogz : Real.log (c * Y * logLog Y) =
        Real.log c + Real.log Y + Real.log (logLog Y) := by
      rw [Real.log_mul (by positivity) hT0.ne', Real.log_mul hc.ne' hY0.ne']
    have h1 : Real.log (logLog Y) ≤ logLog Y := Real.log_le_self hT0.le
    have h2 : logLog Y ≤ Real.log Y := by unfold logLog; exact Real.log_le_self hlogY.le
    have hlz_le : Real.log (c * Y * logLog Y) ≤ Real.log Y ^ 2 := by
      rw [hlogz]
      nlinarith [le_abs_self (Real.log c), abs_nonneg (Real.log c),
        mul_le_mul_of_nonneg_left hlY hlogY.le,
        mul_le_mul_of_nonneg_left (by linarith : (1 : ℝ) ≤ Real.log Y) (abs_nonneg (Real.log c))]
    have hlz_pos : 0 < Real.log (c * Y * logLog Y) := Real.log_pos (by linarith)
    calc Real.log (Real.log (c * Y * logLog Y)) ≤ Real.log (Real.log Y ^ 2) :=
          Real.log_le_log hlz_pos hlz_le
      _ = 2 * logLog Y := by rw [Real.log_pow]; unfold logLog; push_cast; ring
  obtain ⟨K, hKdef⟩ : ∃ K : ℝ, K = 2 * (A + 1) * c * (1 + C₀ * K₁) * Cd * 3 ^ 6 := ⟨_, rfl⟩
  have hK : 0 ≤ K := by rw [hKdef]; positivity
  
  obtain ⟨B, hB⟩ := id hMERT
  have hW_ev : ∀ᶠ T : ℝ in atTop, ∀ x : ℝ, Real.exp (Real.exp 1) ≤ x →
      Real.log (Real.log x) ≤ 2 * T → ∀ k : ℕ, (k : ℝ) ≤ (A + 1) * Real.log T →
      Real.exp 1 * (1 + ∑ p ∈ (Finset.Iic ⌊x⌋₊).filter Nat.Prime, (1 : ℝ) / ((p : ℝ) - 1)) ^ k ≤
        Real.exp ((2 * (A + 1) + 1) * (Real.log T) ^ 2) := by
    filter_upwards [eventually_ge_atTop (Real.exp 1),
      eventually_ge_atTop (1 + 4 * (1 + |B|))] with T hTe hTB
    intro x hx hxT k hk
    have hT1 : 1 ≤ T := by linarith
    have hT0 : 0 < T := by linarith
    have hlT : 1 ≤ Real.log T := by
      have := Real.log_le_log (Real.exp_pos 1) hTe
      rwa [Real.log_exp] at this
    have hee : Real.exp 1 ≤ Real.exp (Real.exp 1) := Real.exp_le_exp.mpr (by linarith)
    have hx2 : 2 ≤ x := by linarith
    have hlx : Real.exp 1 ≤ Real.log x := by
      have := Real.log_le_log (Real.exp_pos _) hx
      rwa [Real.log_exp] at this
    have hllx : 1 ≤ Real.log (Real.log x) := by
      have := Real.log_le_log (Real.exp_pos 1) hlx
      rwa [Real.log_exp] at this
    have hsum : ∑ p ∈ (Finset.Iic ⌊x⌋₊).filter Nat.Prime, (1 : ℝ) / ((p : ℝ) - 1) ≤
        2 * ∑ p ∈ (Finset.Iic ⌊x⌋₊).filter Nat.Prime, (1 : ℝ) / p := by
      rw [Finset.mul_sum]
      apply Finset.sum_le_sum
      intro p hp
      rw [Finset.mem_filter] at hp
      have h2 : (2 : ℝ) ≤ p := by exact_mod_cast hp.2.two_le
      have : (1 : ℝ) / (p - 1) ≤ 2 / p := by
        rw [div_le_div_iff₀ (by linarith) (by linarith)]
        linarith
      have h3 : 2 * (1 / (p : ℝ)) = 2 / p := by ring
      linarith
    have hsum0 : 0 ≤ ∑ p ∈ (Finset.Iic ⌊x⌋₊).filter Nat.Prime, (1 : ℝ) / ((p : ℝ) - 1) := by
      apply Finset.sum_nonneg
      intro p hp
      rw [Finset.mem_filter] at hp
      have : (2 : ℝ) ≤ p := by exact_mod_cast hp.2.two_le
      apply div_nonneg zero_le_one
      linarith
    have hBx := (abs_le.mp (hB x hx2)).2
    have hBB : B ≤ |B| := le_abs_self B
    have hsig : 1 + ∑ p ∈ (Finset.Iic ⌊x⌋₊).filter Nat.Prime, (1 : ℝ) / ((p : ℝ) - 1) ≤ T ^ 2 := by
      have hB0 : 0 ≤ |B| := abs_nonneg B
      nlinarith [mul_le_mul_of_nonneg_left hllx hB0, mul_le_mul_of_nonneg_left hTB hT0.le]
    have hpow : (1 + ∑ p ∈ (Finset.Iic ⌊x⌋₊).filter Nat.Prime, (1 : ℝ) / ((p : ℝ) - 1)) ^ k ≤
        (T ^ 2) ^ k := pow_le_pow_left₀ (by linarith) hsig k
    have hTk : (T ^ 2) ^ k = Real.exp (((2 * k : ℕ) : ℝ) * Real.log T) := by
      rw [Real.exp_nat_mul, Real.exp_log hT0, ← pow_mul]
    calc Real.exp 1 * (1 + ∑ p ∈ (Finset.Iic ⌊x⌋₊).filter Nat.Prime, (1 : ℝ) / ((p : ℝ) - 1)) ^ k
        ≤ Real.exp 1 * (T ^ 2) ^ k := mul_le_mul_of_nonneg_left hpow (Real.exp_pos 1).le
      _ = Real.exp (1 + ((2 * k : ℕ) : ℝ) * Real.log T) := by rw [hTk, ← Real.exp_add]
      _ ≤ Real.exp ((2 * (A + 1) + 1) * (Real.log T) ^ 2) := by
          apply Real.exp_le_exp.mpr
          push_cast
          nlinarith [mul_le_mul_of_nonneg_right hk (by linarith : (0 : ℝ) ≤ 2 * Real.log T)]
  
  have hfin_ev : ∀ᶠ Y : ℝ in atTop, Real.sqrt (c * Y * logLog Y) +
      K * Y / Real.log Y * logLog Y ^ 8 *
        Real.exp ((2 * A + 3) * Real.log (logLog Y) ^ 2 - Real.log (logLog Y) ^ 10 / 6) ≤
      Y / (Real.log Y * (logLog Y) ^ 2) := by
    have hlog7 : Tendsto (fun x : ℝ => Real.log x ^ 7 / (1 * x + 0)) atTop (𝓝 0) :=
      Real.tendsto_pow_log_div_mul_add_atTop 1 0 7 one_ne_zero
    obtain ⟨M, hM⟩ : ∃ M : ℝ, M = 10 + |2 * A + 3| := ⟨_, rfl⟩
    obtain ⟨Lam, hLam⟩ : ∃ Lam : ℝ, Lam = Real.log (2 * K + 1) := ⟨_, rfl⟩
    have hLam0 : 0 ≤ Lam := by rw [hLam]; exact Real.log_nonneg (by linarith)
    have hlogLL : Tendsto (fun Y => Real.log (logLog Y)) atTop atTop :=
      Real.tendsto_log_atTop.comp hLL
    filter_upwards [hLL.eventually_ge_atTop (Real.exp 1),
      hlogLL.eventually_ge_atTop (6 * (M + Lam) + 1),
      hlog7.eventually (gt_mem_nhds (by positivity : (0 : ℝ) < 1 / (4 * c))),
      eventually_gt_atTop (1 : ℝ)] with Y hTe hub h7 hY1
    set T := logLog Y with hT
    set u := Real.log T with hu
    set L := Real.log Y with hL
    have hY0 : 0 < Y := by linarith
    have hL0 : 0 < L := Real.log_pos hY1
    have hT0 : 0 < T := by linarith [Real.add_one_le_exp (1 : ℝ)]
    have hTL : T ≤ L := by
