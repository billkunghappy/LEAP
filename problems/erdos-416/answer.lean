    obtain ⟨Z₀, hZ₀⟩ := eventually_atTop.mp (s2 (ε/8) (by positivity))
    obtain ⟨η, hη0, hη1, hηε⟩ : ∃ η : ℝ, 0 < η ∧ η ≤ 1/4 ∧ η ≤ ε/20 :=
      ⟨min (1/4) (ε/20), lt_min (by norm_num) (by positivity), min_le_left _ _, min_le_right _ _⟩
    have hsucc : ∀ n : ℕ, (Nat.primeCounting n : ℝ) ≤ Nat.primeCounting (n+1) ∧
        (Nat.primeCounting (n+1) : ℝ) ≤ Nat.primeCounting n + 1 := by
      intro n
      have h : Nat.primeCounting (n+1) =
          Nat.primeCounting n + if Nat.Prime (n+1) then 1 else 0 := by
        simp only [Nat.primeCounting, Nat.primeCounting']
        rw [Nat.count_succ]
      rw [h]
      split_ifs <;> push_cast <;> constructor <;> linarith
    have hfl : ∀ x : ℝ, 0 ≤ x → ⌊1 + x⌋₊ = ⌊x⌋₊ + 1 := by
      intro x hx; rw [add_comm]; exact Nat.floor_add_one hx
    have hle : ∀ m : ℕ, (Nat.primeCounting m : ℝ) ≤ m + 1 := by
      intro m
      have : Nat.primeCounting m ≤ m + 1 := by
        simp only [Nat.primeCounting, Nat.primeCounting']
        exact Nat.count_le _
      exact_mod_cast this
    refine ⟨max Z₀ 2, η, hη0, ?_⟩
    intro z w hz hw hwz
    have hz2 : 2 ≤ z := le_trans (le_max_right _ _) hz
    have hzZ : Z₀ ≤ z := le_trans (le_max_left _ _) hz
    obtain ⟨hdiff, hlow⟩ := hZ₀ z hzZ
    have hℓ : 0 < Real.log z := Real.log_pos (by linarith)
    have hz0 : 0 < z := by linarith
    have hwL : w + 2 ≤ η * (z / Real.log z) := by
      rw [mul_div_assoc', le_div_iff₀ hℓ]; exact hwz
    have h2L : z / (2 * Real.log z) = (z / Real.log z) / 2 := by ring
    rw [h2L] at hlow
    set L := z / Real.log z with hLdef
    have hL0 : 0 < L := div_pos hz0 hℓ
    rw [hfl z hz0.le, hfl (z/2) (by positivity)]
    obtain ⟨hP1, hP2⟩ := hsucc ⌊z⌋₊
    obtain ⟨hQ1, hQ2⟩ := hsucc ⌊z/2⌋₊
    have hW0 : (0:ℝ) ≤ Nat.primeCounting ⌊1 + w⌋₊ := Nat.cast_nonneg _
    have hW1 : (Nat.primeCounting ⌊1 + w⌋₊ : ℝ) ≤ w + 2 := by
      have h1 := hle ⌊1 + w⌋₊
      have h2 : (⌊1 + w⌋₊ : ℝ) ≤ 1 + w := Nat.floor_le (by linarith)
      linarith
    rw [abs_le] at hdiff
    obtain ⟨hd1, hd2⟩ := hdiff
    have hηL : η * L ≤ ε / 20 * L := mul_le_mul_of_nonneg_right hηε hL0.le
    have hT : L / 4 ≤ (Nat.primeCounting (⌊z⌋₊ + 1) : ℝ) - Nat.primeCounting ⌊1 + w⌋₊ := by
      have : η * L ≤ 1/4 * L := mul_le_mul_of_nonneg_right hη1 hL0.le
      linarith
    have hεT := mul_le_mul_of_nonneg_left hT hε.le
    rw [abs_le]
    constructor <;> linarith
  
  have s4 : ∀ᶠ y : ℝ in atTop,
      Real.log R + A * Real.log (logLog y) * (Real.log y) ^ (4 / 5 : ℝ) ≤
        (1 / 100) * Real.log y := by
    have hu : ∀ᶠ u : ℝ in atTop,
        Real.log R + A * Real.log (Real.log u) * u ^ (4 / 5 : ℝ) ≤ (1 / 100) * u := by
      have hlo := (isLittleO_log_rpow_atTop (by norm_num : (0:ℝ) < 1/10)).bound
        (by norm_num : (0:ℝ) < 1)
      filter_upwards [hlo, Real.tendsto_log_atTop.eventually_ge_atTop 1,
        eventually_ge_atTop (1:ℝ),
        (tendsto_rpow_atTop (by norm_num : (0:ℝ) < 1/10)).eventually_ge_atTop
          (100 * (|A| + |Real.log R|))] with u hlo hlu hu1 hbig
      have hu0 : 0 < u := by linarith
      have hr1 : 0 ≤ u ^ (1/10 : ℝ) := Real.rpow_nonneg hu0.le _
      have hr9 : 1 ≤ u ^ (9/10 : ℝ) := Real.one_le_rpow hu1 (by norm_num)
      have hr45 : 0 ≤ u ^ (4/5 : ℝ) := Real.rpow_nonneg hu0.le _
      rw [Real.norm_eq_abs, Real.norm_eq_abs, abs_of_nonneg (Real.log_nonneg hu1),
        abs_of_nonneg hr1, one_mul] at hlo
      have hg0 : 0 ≤ Real.log (Real.log u) := Real.log_nonneg hlu
      have hg1 : Real.log (Real.log u) ≤ u ^ (1/10 : ℝ) :=
        (Real.log_le_self (by linarith)).trans hlo
      have hmul : u ^ (1/10 : ℝ) * u ^ (4/5 : ℝ) = u ^ (9/10 : ℝ) := by
        rw [← Real.rpow_add hu0]; norm_num
      have hmul2 : u ^ (9/10 : ℝ) * u ^ (1/10 : ℝ) = u := by
        rw [← Real.rpow_add hu0]; norm_num
      have hA : A * Real.log (Real.log u) * u ^ (4 / 5 : ℝ) ≤ |A| * u ^ (9/10 : ℝ) := by
        calc A * Real.log (Real.log u) * u ^ (4 / 5 : ℝ)
            ≤ |A| * Real.log (Real.log u) * u ^ (4 / 5 : ℝ) := by
              apply mul_le_mul_of_nonneg_right _ hr45
              exact mul_le_mul_of_nonneg_right (le_abs_self A) hg0
          _ ≤ |A| * u ^ (1/10 : ℝ) * u ^ (4 / 5 : ℝ) := by
              apply mul_le_mul_of_nonneg_right _ hr45
              exact mul_le_mul_of_nonneg_left hg1 (abs_nonneg A)
          _ = |A| * u ^ (9/10 : ℝ) := by rw [mul_assoc, hmul]
      have hR : Real.log R ≤ |Real.log R| * u ^ (9/10 : ℝ) := by
        have := mul_le_mul_of_nonneg_left hr9 (abs_nonneg (Real.log R))
        linarith [le_abs_self (Real.log R)]
      have hKb : (|A| + |Real.log R|) * u ^ (9/10 : ℝ) ≤ (1/100) * u := by
        have := mul_le_mul_of_nonneg_left hbig (by positivity : (0:ℝ) ≤ u ^ (9/10 : ℝ))
        rw [hmul2] at this
        linarith
      nlinarith
    filter_upwards [Real.tendsto_log_atTop.eventually hu] with y hy
    unfold logLog
    exact hy
  
  have s5 : ∀ η : ℝ, 0 < η → ∀ᶠ y : ℝ in atTop, 2 * y ^ (99 / 100 : ℝ) ≤ y ∧
      (y ^ (99 / 100 : ℝ) + 2 * y ^ (1 / 100 : ℝ)) * Real.log y ≤ η * y := by
    intro η hη
    have hlo := (isLittleO_log_rpow_atTop (by norm_num : (0:ℝ) < 1/100)).bound
      (by positivity : (0:ℝ) < η/3)
    filter_upwards [hlo, eventually_ge_atTop (1:ℝ),
      (tendsto_rpow_atTop (by norm_num : (0:ℝ) < 1/100)).eventually_ge_atTop 2]
      with y hlo hy1 hbig
    have hy0 : 0 < y := by linarith
    have ha : 0 ≤ y ^ (1/100 : ℝ) := Real.rpow_nonneg hy0.le _
    have hb : 0 ≤ y ^ (99/100 : ℝ) := Real.rpow_nonneg hy0.le _
    have hlog0 : 0 ≤ Real.log y := Real.log_nonneg hy1
    rw [Real.norm_eq_abs, Real.norm_eq_abs, abs_of_nonneg hlog0, abs_of_nonneg ha] at hlo
    have hmul : y ^ (99/100 : ℝ) * y ^ (1/100 : ℝ) = y := by
      rw [← Real.rpow_add hy0]; norm_num
    have hab : y ^ (1/100 : ℝ) ≤ y ^ (99/100 : ℝ) :=
      Real.rpow_le_rpow_of_exponent_le hy1 (by norm_num)
    constructor
    · have := mul_le_mul_of_nonneg_left hbig hb
      linarith
    · calc (y ^ (99 / 100 : ℝ) + 2 * y ^ (1 / 100 : ℝ)) * Real.log y
          ≤ (3 * y ^ (99 / 100 : ℝ)) * Real.log y := by
            apply mul_le_mul_of_nonneg_right _ hlog0; linarith
        _ ≤ (3 * y ^ (99 / 100 : ℝ)) * (η / 3 * y ^ (1/100 : ℝ)) := by
            apply mul_le_mul_of_nonneg_left hlo; linarith
        _ = η * (y ^ (99/100 : ℝ) * y ^ (1/100 : ℝ)) := by ring
        _ = η * y := by rw [hmul]
  
  rw [Asymptotics.isLittleO_iff]
  intro c hc
  obtain ⟨Z, η, hη, hU⟩ := s3 c hc
  filter_upwards [hC, s4, s5 η hη,
    (tendsto_rpow_atTop (by norm_num : (0:ℝ) < 99/100)).eventually_ge_atTop Z,
    eventually_ge_atTop (1:ℝ)] with y hCy hs4 hs5 hyZ hy1
  obtain ⟨h2lo, hscale⟩ := hs5
  have hy0 : 0 < y := by linarith
  have hlo0 : 0 ≤ y ^ (99/100 : ℝ) := Real.rpow_nonneg hy0.le _
  have hlo1 : 1 ≤ y ^ (99/100 : ℝ) := Real.one_le_rpow hy1 (by norm_num)
  have hloy2 : y ^ (99/100 : ℝ) ≤ y / 2 := by linarith
  have hloy : y ^ (99/100 : ℝ) ≤ y := by linarith
  have hmul : y ^ (99/100 : ℝ) * y ^ (1/100 : ℝ) = y := by
    rw [← Real.rpow_add hy0]; norm_num
  have hCpos : ∀ b ∈ C y, 0 < b := fun b hb => (hCy b hb).1
  rw [Real.norm_eq_abs, Real.norm_eq_abs,
    abs_of_nonneg (Nat.cast_nonneg (α := ℝ) (corePairs (C y) (y ^ (99 / 100 : ℝ)) y).card),
    s1 (C y) _ y hCpos hlo0 hloy, s1 (C y) _ (y/2) hCpos hlo0 hloy2]
  simp only [Finset.mul_sum, ← Finset.sum_sub_distrib]
  refine (Finset.abs_sum_le_sum_abs _ _).trans (Finset.sum_le_sum fun b hb => ?_)
  obtain ⟨hbpos, hlogb⟩ := hCy b hb
  have hbR : (0:ℝ) < b := by exact_mod_cast hbpos
  have hb1 : (1:ℝ) ≤ b := by exact_mod_cast hbpos
  have hbs : (b:ℝ) ≤ y ^ (1/100 : ℝ) := by
    rw [Real.rpow_def_of_pos hy0]
    calc (b:ℝ) = Real.exp (Real.log b) := (Real.exp_log hbR).symm
      _ ≤ Real.exp (Real.log y * (1/100)) := Real.exp_le_exp.mpr (by linarith)
  have hz0 : 0 < y / b := div_pos hy0 hbR
  have hzy : y / b ≤ y := div_le_self hy0.le hb1
  have hz1 : y ^ (99/100 : ℝ) ≤ y / b := by
    rw [le_div_iff₀ hbR]
    calc y ^ (99/100 : ℝ) * b ≤ y ^ (99/100 : ℝ) * y ^ (1/100 : ℝ) :=
          mul_le_mul_of_nonneg_left hbs hlo0
      _ = y := hmul
  have hzZ : Z ≤ y / b := hyZ.trans hz1
  have hlz0 : 0 ≤ Real.log (y / b) := Real.log_nonneg (hlo1.trans hz1)
  have hlzy : Real.log (y / b) ≤ Real.log y := Real.log_le_log hz0 hzy
  have hw0 : 0 ≤ y ^ (99/100 : ℝ) / b := div_nonneg hlo0 hbR.le
  have hkey : (y ^ (99/100 : ℝ) / b + 2) * Real.log (y / b) ≤ η * (y / b) := by
    have h1 : (y ^ (99/100 : ℝ) + 2 * b) * Real.log (y / b) ≤ η * y := by
      calc (y ^ (99/100 : ℝ) + 2 * b) * Real.log (y / b)
          ≤ (y ^ (99/100 : ℝ) + 2 * y ^ (1/100 : ℝ)) * Real.log y := by
            apply mul_le_mul (by linarith) hlzy hlz0 (by positivity)
        _ ≤ η * y := hscale
    rw [div_add' _ _ _ hbR.ne', div_mul_eq_mul_div, ← mul_div_assoc]
    exact (div_le_div_iff_of_pos_right hbR).mpr h1
  have hyb : y / 2 / (b:ℝ) = y / b / 2 := by ring
  rw [hyb]
  exact hU (y / b) (y ^ (99/100 : ℝ) / b) hzZ hw0 hkey

theorem rawPair_power_top_eventually (R : ℕ) (A : ℝ) : ∀ᶠ Y : ℝ in atTop, ∀ (L : ℕ) (P : ℝ) (Q : CoreRecords.LowerCoreRecord Y L R P), (L : ℝ) ≤ A * Real.log (logLog Y) → ∀ p : ℕ, p.Prime → Y ^ (99 / 100 : ℝ) < (corePairValue (Q.numericalCore, p) : ℝ) → Y ^ (9 / 10 : ℝ) < (p : ℝ) ∧ Q.lower ⟨0, Q.length_pos⟩ < p :=
by
  obtain ⟨c', hc'def⟩ : ∃ c' : ℝ, c' = 1 / (100 * (|A| + 1)) := ⟨_, rfl⟩
  have hc' : 0 < c' := by rw [hc'def]; positivity
  have hE3 : ∀ᶠ Y : ℝ in atTop,
      ‖Real.log (Real.log Y)‖ ≤ c' * ‖(Real.log Y) ^ (1 / 5 : ℝ)‖ :=
    Real.tendsto_log_atTop.eventually
      ((isLittleO_log_rpow_atTop (r := 1 / 5) (by norm_num)).bound hc')
  have hLL : Tendsto logLog atTop atTop :=
    Real.tendsto_log_atTop.comp Real.tendsto_log_atTop
  filter_upwards [eventually_gt_atTop (1 : ℝ),
    Real.tendsto_log_atTop.eventually_ge_atTop (32 : ℝ), hLL.eventually_ge_atTop 1, hE3,
    Real.tendsto_log_atTop.eventually_ge_atTop (100 * Real.log R)]
    with Y hY1 ht32 hu1 hE3Y hE4
  intro L P Q hL p _hp hval
  have hY : 0 < Y := by linarith
  have ht0 : 0 < Real.log Y := by linarith
  
  have h15 : (2 : ℝ) ≤ (Real.log Y) ^ (1 / 5 : ℝ) := by
    have h32 : (32 : ℝ) ^ (1 / 5 : ℝ) = 2 := by
      rw [show (32 : ℝ) = 2 ^ (5 : ℕ) by norm_num, ← Real.rpow_natCast,
        ← Real.rpow_mul (by norm_num)]
      norm_num
    calc (2 : ℝ) = 32 ^ (1 / 5 : ℝ) := h32.symm
      _ ≤ (Real.log Y) ^ (1 / 5 : ℝ) := Real.rpow_le_rpow (by norm_num) ht32 (by norm_num)
  have hsplit : Real.log Y = (Real.log Y) ^ (1 / 5 : ℝ) * (Real.log Y) ^ (4 / 5 : ℝ) := by
    rw [← Real.rpow_add ht0]; norm_num
  have h45nn : 0 ≤ (Real.log Y) ^ (4 / 5 : ℝ) := Real.rpow_nonneg ht0.le _
  have h15nn : 0 ≤ (Real.log Y) ^ (1 / 5 : ℝ) := Real.rpow_nonneg ht0.le _
  have hi : (Real.log Y) ^ (4 / 5 : ℝ) ≤ Real.log Y / 2 := by
    have := mul_le_mul_of_nonneg_right h15 h45nn
    linarith
  have hcut_eq : CollisionBox.cutoff Y (4 / 5) = Real.exp ((Real.log Y) ^ (4 / 5 : ℝ)) := rfl
  have hcut : CollisionBox.cutoff Y (4 / 5) < Y ^ (9 / 10 : ℝ) := by
    rw [hcut_eq, Real.rpow_def_of_pos hY]
    exact Real.exp_lt_exp.mpr (by linarith)
  
  have hlogu : 0 ≤ Real.log (logLog Y) := Real.log_nonneg hu1
  have hlogu_le : Real.log (logLog Y) ≤ logLog Y := by
    have := Real.log_le_sub_one_of_pos (by linarith : 0 < logLog Y)
    linarith
  have huE : logLog Y ≤ c' * (Real.log Y) ^ (1 / 5 : ℝ) := by
    have h1 : logLog Y ≤ ‖Real.log (Real.log Y)‖ := by
      rw [Real.norm_eq_abs]; exact le_abs_self _
    have h2 : ‖(Real.log Y) ^ (1 / 5 : ℝ)‖ = (Real.log Y) ^ (1 / 5 : ℝ) := by
      rw [Real.norm_eq_abs, abs_of_nonneg h15nn]
    rw [h2] at hE3Y
    exact h1.trans hE3Y
  have hAc : |A| * c' ≤ 1 / 100 := by
    rw [hc'def, mul_one_div, div_le_div_iff₀ (by positivity) (by norm_num)]
    linarith [abs_nonneg A]
  have hLt : (L : ℝ) ≤ (1 / 100) * (Real.log Y) ^ (1 / 5 : ℝ) := by
    calc (L : ℝ) ≤ A * Real.log (logLog Y) := hL
      _ ≤ |A| * Real.log (logLog Y) := mul_le_mul_of_nonneg_right (le_abs_self A) hlogu
      _ ≤ |A| * logLog Y := mul_le_mul_of_nonneg_left hlogu_le (abs_nonneg A)
      _ ≤ |A| * (c' * (Real.log Y) ^ (1 / 5 : ℝ)) :=
          mul_le_mul_of_nonneg_left huE (abs_nonneg A)
      _ = (|A| * c') * (Real.log Y) ^ (1 / 5 : ℝ) := by ring
      _ ≤ (1 / 100) * (Real.log Y) ^ (1 / 5 : ℝ) := mul_le_mul_of_nonneg_right hAc h15nn
  have hii : (L : ℝ) * (Real.log Y) ^ (4 / 5 : ℝ) ≤ Real.log Y / 100 := by
    have := mul_le_mul_of_nonneg_right hLt h45nn
    linarith
  
  have hbound : (R : ℝ) * CollisionBox.cutoff Y (4 / 5) ^ L ≤ Y ^ (9 / 100 : ℝ) := by
    rcases Nat.eq_zero_or_pos R with hR | hR
    · rw [hR, Nat.cast_zero, zero_mul]; exact Real.rpow_nonneg hY.le _
    · have hRpos : (0 : ℝ) < R := by exact_mod_cast hR
      rw [hcut_eq, ← Real.exp_nat_mul, Real.rpow_def_of_pos hY, ← Real.exp_log hRpos,
        ← Real.exp_add]
      apply Real.exp_le_exp.mpr
      linarith
  
  have hb1 : (Q.numericalCore : ℝ) ≤ (R : ℝ) * CollisionBox.cutoff Y (4 / 5) ^ L := by
    unfold CoreRecords.LowerCoreRecord.numericalCore
    rw [Nat.cast_mul, Nat.cast_prod]
    apply mul_le_mul
    · exact_mod_cast (Nat.totient_le _).trans Q.tail_le
    · calc (∏ idx, ((Q.lower idx - 1 : ℕ) : ℝ))
          ≤ ∏ _idx : Fin L, CollisionBox.cutoff Y (4 / 5) := by
            apply Finset.prod_le_prod
            · intro i _; exact Nat.cast_nonneg _
            · intro i _; exact (Nat.cast_le.mpr (Nat.sub_le _ 1)).trans (Q.upper i)
        _ = CollisionBox.cutoff Y (4 / 5) ^ L := by simp
    · exact Finset.prod_nonneg (fun i _ => Nat.cast_nonneg _)
    · exact Nat.cast_nonneg _
  have hcore : (Q.numericalCore : ℝ) ≤ Y ^ (9 / 100 : ℝ) := hb1.trans hbound
  have hp : Y ^ (9 / 10 : ℝ) < (p : ℝ) := by
    by_contra hcon
    push_neg at hcon
    have hv : (corePairValue (Q.numericalCore, p) : ℝ) =
        ((p - 1 : ℕ) : ℝ) * (Q.numericalCore : ℝ) := by
      simp only [corePairValue, Nat.cast_mul]
    have h1 : ((p - 1 : ℕ) : ℝ) ≤ p := Nat.cast_le.mpr (Nat.sub_le p 1)
    have h2 : ((p - 1 : ℕ) : ℝ) * (Q.numericalCore : ℝ) ≤ Y ^ (9 / 10 : ℝ) * Y ^ (9 / 100 : ℝ) :=
      mul_le_mul (h1.trans hcon) hcore (Nat.cast_nonneg _) (Real.rpow_nonneg hY.le _)
    have h3 : Y ^ (9 / 10 : ℝ) * Y ^ (9 / 100 : ℝ) = Y ^ (99 / 100 : ℝ) := by
      rw [← Real.rpow_add hY]; norm_num
    linarith
  refine ⟨hp, ?_⟩
  have hlt : (Q.lower ⟨0, Q.length_pos⟩ : ℝ) < p := (Q.upper _).trans_lt (hcut.trans hp)
  exact_mod_cast hlt

theorem inverse_totient_size_bound (hPNT : Tendsto (fun x : ℝ => (Nat.primeCounting ⌊x⌋₊ : ℝ) / (x / Real.log x)) atTop (𝓝 1))
    (hMERT : ∃ C : ℝ, ∀ x : ℝ, 2 ≤ x →
      |(∑ p ∈ (Finset.Iic ⌊x⌋₊).filter Nat.Prime, (1 : ℝ) / p) - Real.log (Real.log x)| ≤ C)
    (hEULER : Asymptotics.IsEquivalent atTop
      (fun x : ℝ => ∏ p ∈ (Finset.Iic ⌊x⌋₊).filter Nat.Prime, (1 - (1 : ℝ) / p))
      (fun x => Real.exp (-Real.eulerMascheroniConstant) / Real.log x)) :
    ∃ D : ℝ, 0 < D ∧ ∀ᶠ Y : ℝ in atTop, ∀ n : ℕ, 0 < n → (n.totient : ℝ) ≤ Y → (n : ℝ) ≤ D * Y * logLog Y :=
by
  classical
  
  have hfpos : ∀ p : ℕ, p.Prime → 0 < (p : ℝ) / ((p : ℝ) - 1) := by
    intro p hp
    have hp1 : (1 : ℝ) < p := by exact_mod_cast hp.one_lt
    exact div_pos (by linarith) (by linarith)
  have hfone : ∀ p : ℕ, p.Prime → 1 ≤ (p : ℝ) / ((p : ℝ) - 1) := by
    intro p hp
    have hp1 : (1 : ℝ) < p := by exact_mod_cast hp.one_lt
    rw [le_div_iff₀ (show (0 : ℝ) < p - 1 by linarith)]
    linarith
  have hfinv : ∀ p : ℕ, p.Prime → (p : ℝ) / ((p : ℝ) - 1) = (1 - (1 : ℝ) / p)⁻¹ := by
    intro p hp
    have hp1 : (1 : ℝ) < p := by exact_mod_cast hp.one_lt
    have hp0 : (p : ℝ) ≠ 0 := by linarith
    rw [one_sub_div hp0, inv_div]
  have hfexp : ∀ p : ℕ, p.Prime → (p : ℝ) / ((p : ℝ) - 1) ≤ Real.exp (2 / (p : ℝ)) := by
    intro p hp
    have hp2 : (2 : ℝ) ≤ p := by exact_mod_cast hp.two_le
    have hfrac : (1 : ℝ) / ((p : ℝ) - 1) ≤ 2 / p := by
      apply (div_le_div_iff₀ (by linarith) (by linarith : (0 : ℝ) < p)).mpr
      linarith
    have heq : (p : ℝ) / ((p : ℝ) - 1) = 1 + (1 : ℝ) / ((p : ℝ) - 1) := by
      field_simp [show (p : ℝ) - 1 ≠ 0 by linarith]
      ring
    rw [heq]
    have := Real.add_one_le_exp (2 / (p : ℝ))
    linarith
  
  have hratio_eq : ∀ n : ℕ, 0 < n →
      (n : ℝ) / n.totient = ∏ p ∈ n.primeFactors, (p : ℝ) / ((p : ℝ) - 1) := by
    intro n hn
    have hφ : (n.totient : ℝ) ≠ 0 := by exact_mod_cast (Nat.totient_pos.mpr hn).ne'
    have hprod : (∏ p ∈ n.primeFactors, ((p : ℝ) - 1)) ≠ 0 := by
      apply Finset.prod_ne_zero_iff.mpr
      intro p hp
      have hp1 : (1 : ℝ) < p := by exact_mod_cast (Nat.prime_of_mem_primeFactors hp).one_lt
      linarith
    have h := congrArg (fun a : ℕ => (a : ℝ)) (Nat.totient_mul_prod_primeFactors n)
    simp only [Nat.cast_mul, Nat.cast_prod] at h
    have hpred : (∏ p ∈ n.primeFactors, ((p - 1 : ℕ) : ℝ)) =
        ∏ p ∈ n.primeFactors, ((p : ℝ) - 1) := by
      apply Finset.prod_congr rfl
      intro p hp
      rw [Nat.cast_sub (Nat.prime_of_mem_primeFactors hp).one_le, Nat.cast_one]
    rw [hpred] at h
    rw [Finset.prod_div_distrib]
    exact (div_eq_div_iff hφ hprod).mpr (h.symm.trans (mul_comm _ _))
  
  have hcardlog : ∀ n : ℕ, 0 < n → (n.primeFactors.card : ℝ) * Real.log 2 ≤ Real.log n := by
    intro n hn
    have hpow : 2 ^ n.primeFactors.card ≤ n := by
      calc
        _ = ∏ _ ∈ n.primeFactors, 2 := (Finset.prod_const 2).symm
        _ ≤ ∏ p ∈ n.primeFactors, p :=
          Finset.prod_le_prod' fun p hp => (Nat.prime_of_mem_primeFactors hp).two_le
        _ ≤ n := Nat.le_of_dvd hn (Nat.prod_primeFactors_dvd n)
    have hR : (2 : ℝ) ^ n.primeFactors.card ≤ n := by exact_mod_cast hpow
    simpa only [Real.log_pow] using Real.log_le_log (by positivity) hR
  have hlarge : ∀ n : ℕ, 1 < n →
      (∏ p ∈ n.primeFactors.filter (fun p : ℕ => ¬ (p : ℝ) ≤ Real.log n),
        (p : ℝ) / ((p : ℝ) - 1)) ≤ Real.exp (2 / Real.log 2) := by
    intro n hn
    have hn1 : (1 : ℝ) < n := by exact_mod_cast hn
    have hlog : 0 < Real.log n := Real.log_pos hn1
    have hlog2 : 0 < Real.log 2 := Real.log_pos (by norm_num)
    set s := n.primeFactors.filter fun p : ℕ => ¬ (p : ℝ) ≤ Real.log n with hs_def
    have hcard : (s.card : ℝ) ≤ n.primeFactors.card := by
      exact_mod_cast (Finset.card_le_card (Finset.filter_subset _ _) : s.card ≤ n.primeFactors.card)
    have hcl := hcardlog n (by omega)
    calc
      _ ≤ ∏ _ ∈ s, Real.exp (2 / Real.log n) := by
        apply Finset.prod_le_prod
        · intro p hp
          exact (hfpos p (Nat.prime_of_mem_primeFactors (Finset.mem_filter.mp hp).1)).le
        · intro p hp
          obtain ⟨hpn, hp⟩ := Finset.mem_filter.mp hp
          apply (hfexp p (Nat.prime_of_mem_primeFactors hpn)).trans
          apply Real.exp_le_exp.mpr
          exact div_le_div_of_nonneg_left (by norm_num) hlog (le_of_not_ge hp)
      _ = Real.exp ((s.card : ℝ) * (2 / Real.log n)) := by
        rw [← Real.exp_sum]
        simp
      _ ≤ Real.exp (2 / Real.log 2) := by
        apply Real.exp_le_exp.mpr
        have hcardbound : (s.card : ℝ) * Real.log 2 ≤ Real.log n :=
          (mul_le_mul_of_nonneg_right hcard hlog2.le).trans hcl
        rw [le_div_iff₀ hlog2]
        rw [mul_div_assoc', div_mul_eq_mul_div, div_le_iff₀ hlog]
        nlinarith
  
  obtain ⟨C0, hC0, hEb⟩ : ∃ C : ℝ, 0 < C ∧ ∀ᶠ x : ℝ in atTop,
      (∏ p ∈ (Finset.Iic ⌊x⌋₊).filter Nat.Prime, (p : ℝ) / ((p : ℝ) - 1)) ≤ C * Real.log x := by
    obtain ⟨B, hB, hbound⟩ := hEULER.inv.isBigO.exists_pos
    refine ⟨B / Real.exp (-Real.eulerMascheroniConstant), by positivity, ?_⟩
    filter_upwards [hbound.bound, eventually_gt_atTop (1 : ℝ)] with x h hx
    have heq : (∏ p ∈ (Finset.Iic ⌊x⌋₊).filter Nat.Prime, (p : ℝ) / ((p : ℝ) - 1)) =
        (∏ p ∈ (Finset.Iic ⌊x⌋₊).filter Nat.Prime, (1 - (1 : ℝ) / p))⁻¹ := by
      rw [← Finset.prod_inv_distrib]
      exact Finset.prod_congr rfl fun p hp => hfinv p (Finset.mem_filter.mp hp).2
    have hprod : 0 < ∏ p ∈ (Finset.Iic ⌊x⌋₊).filter Nat.Prime, (p : ℝ) / ((p : ℝ) - 1) :=
      Finset.prod_pos fun p hp => hfpos p (Finset.mem_filter.mp hp).2
    change ‖(∏ p ∈ (Finset.Iic ⌊x⌋₊).filter Nat.Prime, (1 - (1 : ℝ) / p))⁻¹‖ ≤
      B * ‖(Real.exp (-Real.eulerMascheroniConstant) / Real.log x)⁻¹‖ at h
    rw [← heq, Real.norm_eq_abs, abs_of_pos hprod, inv_div,
      Real.norm_eq_abs, abs_of_pos (div_pos (Real.log_pos hx) (Real.exp_pos _))] at h
    convert h using 1
    ring
  
  have hsmall : ∀ n : ℕ,
      (∏ p ∈ n.primeFactors.filter (fun p : ℕ => (p : ℝ) ≤ Real.log n),
        (p : ℝ) / ((p : ℝ) - 1)) ≤
      ∏ p ∈ (Finset.Iic ⌊Real.log n⌋₊).filter Nat.Prime, (p : ℝ) / ((p : ℝ) - 1) := by
    intro n
    have hsub : n.primeFactors.filter (fun p : ℕ => (p : ℝ) ≤ Real.log n) ⊆
        (Finset.Iic ⌊Real.log n⌋₊).filter Nat.Prime := by
      intro p hp
      obtain ⟨hpn, hpl⟩ := Finset.mem_filter.mp hp
      exact Finset.mem_filter.mpr
        ⟨Finset.mem_Iic.mpr (Nat.le_floor hpl), Nat.prime_of_mem_primeFactors hpn⟩
    rw [← Finset.prod_sdiff hsub]
    have h1 : (1 : ℝ) ≤ ∏ p ∈ ((Finset.Iic ⌊Real.log n⌋₊).filter Nat.Prime) \
        n.primeFactors.filter (fun p : ℕ => (p : ℝ) ≤ Real.log n), (p : ℝ) / ((p : ℝ) - 1) := by
      calc (1 : ℝ) = ∏ _ ∈ ((Finset.Iic ⌊Real.log n⌋₊).filter Nat.Prime) \
            n.primeFactors.filter (fun p : ℕ => (p : ℝ) ≤ Real.log n), (1 : ℝ) := by simp
        _ ≤ _ := Finset.prod_le_prod (fun _ _ => zero_le_one)
            (fun p hp => hfone p (Finset.mem_filter.mp (Finset.mem_sdiff.mp hp).1).2)
    have h2 : 0 ≤ ∏ p ∈ n.primeFactors.filter (fun p : ℕ => (p : ℝ) ≤ Real.log n),
        (p : ℝ) / ((p : ℝ) - 1) :=
      Finset.prod_nonneg fun p hp =>
        (hfpos p (Nat.prime_of_mem_primeFactors (Finset.mem_filter.mp hp).1)).le
    exact le_mul_of_one_le_left h2 h1
  
  have hsqrtb : ∀ C : ℝ, 0 ≤ C → ∀ᶠ x : ℝ in atTop,
      C * Real.log (Real.log x) ≤ Real.sqrt x := by
    intro C hC
    have h := isLittleO_log_rpow_atTop (show (0 : ℝ) < 1 / 2 by norm_num)
    filter_upwards [h.bound (show (0 : ℝ) < 1 / (C + 1) by positivity),
      eventually_gt_atTop (1 : ℝ)] with x hx hx1
    have hl : 0 < Real.log x := Real.log_pos hx1
    rw [Real.norm_eq_abs, Real.norm_eq_abs, abs_of_pos hl,
      abs_of_nonneg (Real.rpow_nonneg (by linarith) _), ← Real.sqrt_eq_rpow] at hx
    have h2 : Real.log x * (C + 1) ≤ Real.sqrt x := by
      rw [div_mul_eq_mul_div, one_mul, le_div_iff₀ (by positivity)] at hx
      exact hx
    have h3 : Real.log (Real.log x) ≤ Real.log x := Real.log_le_self hl.le
    have h4 := mul_le_mul_of_nonneg_left h3 hC
    nlinarith
  
  obtain ⟨C, hC, hratio⟩ : ∃ C : ℝ, 0 < C ∧
      ∀ᶠ n : ℕ in atTop, (n : ℝ) / n.totient ≤ C * Real.log (Real.log n) := by
    refine ⟨C0 * Real.exp (2 / Real.log 2), by positivity, ?_⟩
    filter_upwards [(Real.tendsto_log_atTop.comp tendsto_natCast_atTop_atTop).eventually hEb,
      eventually_gt_atTop (1 : ℕ)] with n hsm hn
    rw [hratio_eq n (by omega)]
    rw [← Finset.prod_filter_mul_prod_filter_not n.primeFactors
      (fun p : ℕ => (p : ℝ) ≤ Real.log n)]
    have hs := (hsmall n).trans hsm
    have hl := hlarge n hn
    calc
      _ ≤ (C0 * Real.log (Real.log n)) * Real.exp (2 / Real.log 2) := by
        exact mul_le_mul hs hl (Finset.prod_nonneg fun p hp =>
          (hfpos p (Nat.prime_of_mem_primeFactors (Finset.mem_filter.mp hp).1)).le)
          ((Finset.prod_pos fun p hp =>
            hfpos p (Nat.prime_of_mem_primeFactors (Finset.mem_filter.mp hp).1)).le.trans hs)
      _ = _ := by ring
  
  have hsqrt := tendsto_natCast_atTop_atTop.eventually (hsqrtb C hC.le)
  obtain ⟨N, hN⟩ := eventually_atTop.mp ((hratio.and hsqrt).and (eventually_gt_atTop (1 : ℕ)))
  refine ⟨max (2 * C) 1, by positivity, ?_⟩
  have hD1 : (1 : ℝ) ≤ max (2 * C) 1 := le_max_right _ _
  have hDC : 2 * C ≤ max (2 * C) 1 := le_max_left _ _
  filter_upwards [eventually_ge_atTop (N : ℝ), eventually_gt_atTop (1 : ℝ),
    (Real.tendsto_log_atTop.comp Real.tendsto_log_atTop).eventually_ge_atTop 1]
    with y hNy hy hLLy
  dsimp only [Function.comp_apply] at hLLy
  intro n hn hφy
  unfold logLog
  set D := max (2 * C) 1 with hD_def
  have hy0 : 0 < y := by linarith
  by_cases hnN : n < N
  · have hny : (n : ℝ) ≤ y := (by exact_mod_cast hnN.le : (n : ℝ) ≤ N).trans hNy
    apply hny.trans
    nlinarith [mul_le_mul_of_nonneg_right hD1 hy0.le,
      mul_le_mul_of_nonneg_left hLLy (show 0 ≤ D * y by positivity)]
  · obtain ⟨⟨hr, hs⟩, hn1⟩ := hN n (by omega)
    have hnR : (0 : ℝ) < n := by exact_mod_cast hn
    have hφR : (0 : ℝ) < n.totient := by exact_mod_cast Nat.totient_pos.mpr hn
    have hnr : (n : ℝ) ≤ C * Real.log (Real.log n) * n.totient := (div_le_iff₀ hφR).mp hr
    have hnroot : (n : ℝ) ≤ Real.sqrt n * y :=
      hnr.trans (mul_le_mul hs hφy hφR.le (Real.sqrt_nonneg _))
    have hsroot : Real.sqrt n ≤ y := by
      have hspos : 0 < Real.sqrt n := Real.sqrt_pos.mpr hnR
      have hsq := Real.sq_sqrt hnR.le
      nlinarith
    have hnysq : (n : ℝ) ≤ y ^ 2 := by
      have hsq := Real.sq_sqrt hnR.le
      nlinarith [mul_self_le_mul_self (Real.sqrt_nonneg n) hsroot]
    have hn1R : (1 : ℝ) < n := by exact_mod_cast hn1
    have hlogn : Real.log n ≤ 2 * Real.log y := by
      have := Real.log_le_log hnR hnysq
      rw [Real.log_pow] at this
      push_cast at this
      linarith
    have hLLn : Real.log (Real.log n) ≤ Real.log 2 + Real.log (Real.log y) := by
      rw [← Real.log_mul (by norm_num) (ne_of_gt (Real.log_pos hy))]
      exact Real.log_le_log (Real.log_pos hn1R) hlogn
    have hlog2 : Real.log 2 ≤ 1 := by
      have := Real.log_le_sub_one_of_pos (by norm_num : (0 : ℝ) < 2)
      linarith
    have hLL : Real.log (Real.log n) ≤ 2 * Real.log (Real.log y) := by linarith
    have hCd : C * Real.log (Real.log n) ≤ D * Real.log (Real.log y) := by
      have h₁ := mul_le_mul_of_nonneg_left hLL hC.le
      have h₂ := mul_le_mul_of_nonneg_right hDC (show 0 ≤ Real.log (Real.log y) by linarith)
      nlinarith
    calc
      (n : ℝ) ≤ C * Real.log (Real.log n) * n.totient := hnr
      _ ≤ (D * Real.log (Real.log y)) * y :=
        mul_le_mul hCd hφy hφR.le (by positivity)
      _ = _ := by ring

theorem weighted_totient_euler_bound : ∀ (w : ℕ → ℝ), (∀ p : ℕ, p.Prime → 0 ≤ w p ∧ w p ≤ 7 / 4) →
    ∀ (x : ℝ) (F : Finset ℕ), (∀ n ∈ F, 0 < n ∧ ∀ p ∈ n.primeFactors, (p : ℝ) ≤ x) →
    (∑ n ∈ F, (n.primeFactorsList.map w).prod / (n.totient : ℝ)) ≤
      Real.exp ((∑ p ∈ (Finset.Iic ⌊x⌋₊).filter Nat.Prime, w p / p) + 36) :=
by
  
  have s1 : ∀ (p : ℕ), p.Prime → ∀ (w : ℝ), 0 ≤ w → w ≤ 7 / 4 → ∀ e : ℕ,
      (∑ i ∈ Finset.range (e + 1), w ^ i / ((p ^ i).totient : ℝ)) ≤
        1 + w * (p : ℝ) / (((p : ℝ) - 1) * ((p : ℝ) - w)) := by
    intro p hp w hw0 hw1 e
    have hq : (2:ℝ) ≤ p := by exact_mod_cast hp.two_le
    have hq1 : (0:ℝ) < (p:ℝ) - 1 := by linarith
    have hqw : (0:ℝ) < (p:ℝ) - w := by linarith
    have hq0 : (0:ℝ) < p := by linarith
    set r := w / (p:ℝ) with hr
    have hr0 : 0 ≤ r := div_nonneg hw0 hq0.le
    have hr1 : r < 1 := by rw [hr, div_lt_one hq0]; linarith
    have hterm : ∀ i : ℕ, w ^ (i+1) / ((p ^ (i+1)).totient : ℝ) = (w / ((p:ℝ) - 1)) * r ^ i := by
      intro i
      rw [Nat.totient_prime_pow_succ hp, Nat.cast_mul, Nat.cast_pow, Nat.cast_sub hp.one_le,
        Nat.cast_one, hr, div_pow]
      field_simp
      ring
    rw [Finset.sum_range_succ']
    simp only [hterm, pow_zero, Nat.totient_one, Nat.cast_one, div_one]
    rw [← Finset.mul_sum]
    have hkey : (∑ i ∈ Finset.range e, r ^ i) * (1 - r) ≤ 1 := by
      rw [geom_sum_mul_neg]
      linarith [pow_nonneg hr0 e]
    have hpw : (p:ℝ) - w = (1 - r) * p := by rw [hr]; field_simp
    have hgeom : ∑ i ∈ Finset.range e, r ^ i ≤ (p:ℝ) / ((p:ℝ) - w) := by
      rw [le_div_iff₀ hqw, hpw]
      nlinarith
    have hc : 0 ≤ w / ((p:ℝ) - 1) := div_nonneg hw0 hq1.le
    calc w / ((p:ℝ) - 1) * ∑ i ∈ Finset.range e, r ^ i + 1
        ≤ w / ((p:ℝ) - 1) * ((p:ℝ) / ((p:ℝ) - w)) + 1 := by gcongr
      _ = 1 + w * (p : ℝ) / (((p : ℝ) - 1) * ((p : ℝ) - w)) := by
        field_simp
        ring
  
  have s2 : ∀ (p w : ℝ), 2 ≤ p → 0 ≤ w → w ≤ 7 / 4 →
      w * p / ((p - 1) * (p - w)) ≤ w / p + 28 / (p * (p - 1)) := by
    intro p w hp hw0 hw1
    have h1 : 0 < p - 1 := by linarith
    have h2 : 0 < p - w := by linarith
    have h0 : 0 < p := by linarith
    have hid : w / p + 28 / (p * (p - 1)) - w * p / ((p - 1) * (p - w)) =
        (28 * (p - w) - w * (p * w + p - w)) / (p * (p - 1) * (p - w)) := by
      field_simp
      ring
    have hnum : 0 ≤ 28 * (p - w) - w * (p * w + p - w) := by
      have ha : 0 ≤ (p - 2) * (28 - w ^ 2 - w) := by
        apply mul_nonneg (by linarith); nlinarith
      nlinarith
    have : 0 ≤ (28 * (p - w) - w * (p * w + p - w)) / (p * (p - 1) * (p - w)) := by
      apply div_nonneg hnum; positivity
    linarith
  
  have s3 : ∀ (P : Finset ℕ), (∀ p ∈ P, 2 ≤ p) →
      (∑ p ∈ P, (1 : ℝ) / ((p : ℝ) * ((p : ℝ) - 1))) ≤ 1 := by
    intro P hP
    have tele : ∀ M : ℕ, ∑ n ∈ Finset.Icc 2 (M+1), (1:ℝ) / ((n:ℝ) * ((n:ℝ) - 1)) =
        1 - 1 / ((M:ℝ)+1) := by
      intro M
      induction M with
      | zero => simp
      | succ k ih =>
        rw [Finset.sum_Icc_succ_top (by omega : 2 ≤ k + 1 + 1), ih]
        push_cast
        have e1 : ((k:ℝ) + 1 + 1) - 1 = (k:ℝ) + 1 := by ring
        rw [e1]
        field_simp
        ring
    set M := P.sup id
    have hsub : P ⊆ Finset.Icc 2 (M+1) := by
      intro p hp
      rw [Finset.mem_Icc]
      refine ⟨hP p hp, ?_⟩
      have := Finset.le_sup (f := id) hp
      simp only [id] at this
      omega
    calc _ ≤ ∑ n ∈ Finset.Icc 2 (M+1), (1:ℝ) / ((n:ℝ) * ((n:ℝ) - 1)) := by
          apply Finset.sum_le_sum_of_subset_of_nonneg hsub
          intro n hn _
          rw [Finset.mem_Icc] at hn
          have : (2:ℝ) ≤ n := by exact_mod_cast hn.1
          apply div_nonneg zero_le_one
          nlinarith
      _ = 1 - 1/((M:ℝ)+1) := tele M
      _ ≤ 1 := by
          have : 0 ≤ 1/((M:ℝ)+1) := by positivity
          linarith
  
  have s4 : ∀ (w : ℕ → ℝ), (∀ p : ℕ, p.Prime → 0 ≤ w p) → ∀ (P F : Finset ℕ) (B : ℕ → ℝ),
      (∀ p ∈ P, p.Prime) → (∀ n ∈ F, 0 < n ∧ n.primeFactors ⊆ P) →
      (∀ p ∈ P, ∀ e : ℕ, (∑ i ∈ Finset.range (e + 1), (w p) ^ i / ((p ^ i).totient : ℝ)) ≤ B p) →
      (∑ n ∈ F, (n.primeFactorsList.map w).prod / (n.totient : ℝ)) ≤ ∏ p ∈ P, B p := by
    intro w hw P F B hP hF hB
    let f : ArithmeticFunction ℝ :=
      ⟨fun n => (n.primeFactorsList.map w).prod / (n.totient : ℝ), by simp⟩
    have hfapp : ∀ n, f n = (n.primeFactorsList.map w).prod / (n.totient : ℝ) := fun n => rfl
    have hfnn : ∀ n, 0 ≤ f n := by
      intro n
      rw [hfapp]
      apply div_nonneg _ (Nat.cast_nonneg _)
      apply List.prod_nonneg
      intro a ha
      rw [List.mem_map] at ha
      obtain ⟨q, hq, rfl⟩ := ha
      exact hw q (Nat.prime_of_mem_primeFactorsList hq)
    have hfmul : f.IsMultiplicative := by
      rw [ArithmeticFunction.IsMultiplicative.iff_ne_zero]
      refine ⟨by simp [hfapp], ?_⟩
      intro m n hm hn hmn
      rw [hfapp, hfapp, hfapp, ((Nat.perm_primeFactorsList_mul hm hn).map w).prod_eq,
        List.map_append, List.prod_append, Nat.totient_mul hmn, Nat.cast_mul, div_mul_div_comm]
    have hfpow : ∀ p, p.Prime → ∀ i : ℕ, f (p ^ i) = (w p) ^ i / ((p ^ i).totient : ℝ) := by
      intro p hp i
      rw [hfapp, hp.primeFactorsList_pow, List.map_replicate, List.prod_replicate]
    set K := F.sup id
    set N := (∏ p ∈ P, p) ^ (K + 1) with hNdef
    have hN0 : N ≠ 0 := by
      apply pow_ne_zero
      rw [Finset.prod_ne_zero_iff]
      intro p hp
      exact (hP p hp).ne_zero
    have hNpf : N.primeFactors = P := by
      rw [hNdef, Nat.primeFactors_pow _ (by omega), Nat.primeFactors_prod hP]
    have hFsub : F ⊆ N.divisors := by
      intro n hn
      obtain ⟨hn0, hnP⟩ := hF n hn
      rw [Nat.mem_divisors]
      refine ⟨?_, hN0⟩
      have hnK : n ≤ K := by
        have := Finset.le_sup (f := id) hn
        simpa using this
      have h1 : n ∣ ∏ q ∈ n.primeFactors, q ^ (K + 1) := by
        conv_lhs => rw [← Nat.factorization_prod_pow_eq_self hn0.ne']
        rw [Finsupp.prod, Nat.support_factorization]
        apply Finset.prod_dvd_prod_of_dvd
        intro q _
        apply pow_dvd_pow
        have := Nat.factorization_lt q hn0.ne'
        omega
      rw [Finset.prod_pow] at h1
      exact h1.trans (pow_dvd_pow_of_dvd (Finset.prod_dvd_prod_of_subset _ _ _ hnP) _)
    have hzmul : (f * (ArithmeticFunction.zeta : ArithmeticFunction ℝ)).IsMultiplicative :=
      hfmul.mul ArithmeticFunction.isMultiplicative_zeta.natCast
    calc (∑ n ∈ F, (n.primeFactorsList.map w).prod / (n.totient : ℝ))
        = ∑ n ∈ F, f n := rfl
      _ ≤ ∑ n ∈ N.divisors, f n :=
          Finset.sum_le_sum_of_subset_of_nonneg hFsub (fun n _ _ => hfnn n)
      _ = (f * (ArithmeticFunction.zeta : ArithmeticFunction ℝ)) N :=
          ArithmeticFunction.coe_mul_zeta_apply.symm
      _ = ∏ p ∈ P, (f * (ArithmeticFunction.zeta : ArithmeticFunction ℝ))
            (p ^ (N.factorization p)) := by
          rw [hzmul.multiplicative_factorization _ hN0, Finsupp.prod, Nat.support_factorization,
            hNpf]
      _ ≤ ∏ p ∈ P, B p := by
          apply Finset.prod_le_prod
          · intro p _
            rw [ArithmeticFunction.coe_mul_zeta_apply]
            exact Finset.sum_nonneg (fun n _ => hfnn n)
          · intro p hp
            rw [ArithmeticFunction.coe_mul_zeta_apply, Nat.sum_divisors_prime_pow (hP p hp)]
            simp only [hfpow p (hP p hp)]
            exact hB p hp _
  
  intro w hw x F hF
  set P := (Finset.Iic ⌊x⌋₊).filter Nat.Prime with hPdef
  have hPp : ∀ p ∈ P, p.Prime := fun p hp => (Finset.mem_filter.mp hp).2
  have hFP : ∀ n ∈ F, 0 < n ∧ n.primeFactors ⊆ P := by
    intro n hn
    refine ⟨(hF n hn).1, ?_⟩
    intro q hq
    rw [hPdef, Finset.mem_filter, Finset.mem_Iic]
    exact ⟨Nat.le_floor ((hF n hn).2 q hq), Nat.prime_of_mem_primeFactors hq⟩
  let B : ℕ → ℝ := fun p => Real.exp (w p / p + 28 / ((p:ℝ) * ((p:ℝ) - 1)))
  have hB : ∀ p ∈ P, ∀ e : ℕ,
      (∑ i ∈ Finset.range (e + 1), (w p) ^ i / ((p ^ i).totient : ℝ)) ≤ B p := by
    intro p hp e
    have hpp := hPp p hp
    have h2 : (2:ℝ) ≤ p := by exact_mod_cast hpp.two_le
    calc _ ≤ 1 + w p * (p : ℝ) / (((p : ℝ) - 1) * ((p : ℝ) - w p)) :=
          s1 p hpp (w p) (hw p hpp).1 (hw p hpp).2 e
      _ ≤ Real.exp (w p * (p : ℝ) / (((p : ℝ) - 1) * ((p : ℝ) - w p))) := by
          linarith [Real.add_one_le_exp (w p * (p : ℝ) / (((p : ℝ) - 1) * ((p : ℝ) - w p)))]
      _ ≤ B p := Real.exp_le_exp.mpr (s2 p (w p) h2 (hw p hpp).1 (hw p hpp).2)
  have hmain := s4 w (fun p hp => (hw p hp).1) P F B hPp hFP hB
  have hprod : ∏ p ∈ P, B p =
      Real.exp (∑ p ∈ P, (w p / p + 28 / ((p:ℝ) * ((p:ℝ) - 1)))) := (Real.exp_sum _ _).symm
  have hsum : ∑ p ∈ P, (w p / p + 28 / ((p:ℝ) * ((p:ℝ) - 1))) ≤ (∑ p ∈ P, w p / p) + 36 := by
    rw [Finset.sum_add_distrib]
    have h3 := s3 P (fun p hp => (hPp p hp).two_le)
    have h28 : ∑ p ∈ P, 28 / ((p:ℝ) * ((p:ℝ) - 1)) =
        28 * ∑ p ∈ P, (1:ℝ) / ((p:ℝ) * ((p:ℝ) - 1)) := by
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl (fun p _ => ?_)
      ring
    linarith
  calc _ ≤ ∏ p ∈ P, B p := hmain
    _ = _ := hprod
    _ ≤ _ := Real.exp_le_exp.mpr hsum

theorem lambdaSq_upperMoebius_bound : ∀ (s : BoundingSieve) (w : ℕ → ℝ), w 1 = 1 →
    BoundingSieve.siftedSum (s := s) ≤
      s.totalMass * BoundingSieve.mainSum (s := s) (fun n => ∑ d1 ∈ n.divisors, ∑ d2 ∈ n.divisors,
          if n = Nat.lcm d1 d2 then w d1 * w d2 else 0) +
        BoundingSieve.errSum (s := s) (fun n => ∑ d1 ∈ n.divisors, ∑ d2 ∈ n.divisors,
          if n = Nat.lcm d1 d2 then w d1 * w d2 else 0) :=
by
  intro s w hw
  apply BoundingSieve.siftedSum_le_mainSum_errSum_of_upperMoebius
  intro n
  have hsq : (∑ d ∈ n.divisors, ∑ d1 ∈ d.divisors, ∑ d2 ∈ d.divisors,
      if d = Nat.lcm d1 d2 then w d1 * w d2 else 0) = (∑ d ∈ n.divisors, w d) ^ 2 := by
    have h2 : ∀ d ∈ n.divisors, (∑ d1 ∈ d.divisors, ∑ d2 ∈ d.divisors,
        if d = Nat.lcm d1 d2 then w d1 * w d2 else 0) =
        ∑ d1 ∈ n.divisors, ∑ d2 ∈ n.divisors, if d = Nat.lcm d1 d2 then w d1 * w d2 else 0 := by
      intro d hd
      have hdn : d ∣ n := Nat.dvd_of_mem_divisors hd
      have hn : n ≠ 0 := (Nat.mem_divisors.mp hd).2
      have hd0 : d ≠ 0 := Nat.ne_of_gt (Nat.pos_of_mem_divisors hd)
      have hsub : d.divisors ⊆ n.divisors := Nat.divisors_subset_of_dvd hn hdn
      calc (∑ d1 ∈ d.divisors, ∑ d2 ∈ d.divisors,
            if d = Nat.lcm d1 d2 then w d1 * w d2 else 0)
          = ∑ d1 ∈ n.divisors, ∑ d2 ∈ d.divisors,
              (if d = Nat.lcm d1 d2 then w d1 * w d2 else 0) := by
            apply Finset.sum_subset hsub
            intro d1 _ hd1
            apply Finset.sum_eq_zero
            intro d2 _
            rw [if_neg]
            intro h
            apply hd1
            rw [Nat.mem_divisors]
            refine ⟨?_, hd0⟩
            rw [h]
            exact Nat.dvd_lcm_left _ _
        _ = _ := by
            apply Finset.sum_congr rfl
            intro d1 _
            apply Finset.sum_subset hsub
            intro d2 _ hd2
            rw [if_neg]
            intro h
            apply hd2
            rw [Nat.mem_divisors]
            refine ⟨?_, hd0⟩
            rw [h]
            exact Nat.dvd_lcm_right _ _
    rw [Finset.sum_congr rfl h2, Finset.sum_comm, sq, Finset.sum_mul_sum]
    apply Finset.sum_congr rfl
    intro d1 hd1
    rw [Finset.sum_comm]
    apply Finset.sum_congr rfl
    intro d2 hd2
    rw [Finset.sum_ite_eq', if_pos]
    exact Nat.mem_divisors.mpr ⟨Nat.lcm_dvd (Nat.dvd_of_mem_divisors hd1)
      (Nat.dvd_of_mem_divisors hd2), (Nat.mem_divisors.mp hd1).2⟩
  refine le_trans ?_ (le_of_eq hsq.symm)
  split_ifs with h
  · subst h
    simp [hw]
  · exact sq_nonneg _

theorem lambdaSq_errSum_le : ∀ (s : SelbergSieve) (w : ℕ → ℝ), (∀ d, |w d| ≤ 1) →
    (∀ d : ℕ, ¬ (d : ℝ) ^ 2 ≤ s.level → w d = 0) →
    BoundingSieve.errSum (s := s.toBoundingSieve) (fun n => ∑ d1 ∈ n.divisors, ∑ d2 ∈ n.divisors,
        if n = Nat.lcm d1 d2 then w d1 * w d2 else 0) ≤
      ∑ d ∈ s.prodPrimes.divisors,
        if (d : ℝ) ≤ s.level then
          (3 : ℝ) ^ ArithmeticFunction.cardDistinctFactors d *
            |BoundingSieve.rem (s := s.toBoundingSieve) d|
        else 0 :=
by
  intro s w habs hsupp
  unfold BoundingSieve.errSum
  apply Finset.sum_le_sum
  intro d hd
  have hsq : Squarefree d := BoundingSieve.squarefree_of_mem_divisors_prodPrimes hd
  dsimp only
  split_ifs with hdy
  · apply mul_le_mul_of_nonneg_right _ (abs_nonneg _)
    calc |∑ d1 ∈ d.divisors, ∑ d2 ∈ d.divisors, if d = Nat.lcm d1 d2 then w d1 * w d2 else 0|
        ≤ ∑ d1 ∈ d.divisors,
            |∑ d2 ∈ d.divisors, if d = Nat.lcm d1 d2 then w d1 * w d2 else 0| :=
          Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ d1 ∈ d.divisors, ∑ d2 ∈ d.divisors,
            (if d = Nat.lcm d1 d2 then (1 : ℝ) else 0) := by
          apply Finset.sum_le_sum
          intro d1 _
          refine (Finset.abs_sum_le_sum_abs _ _).trans ?_
          apply Finset.sum_le_sum
          intro d2 _
          split_ifs
          · rw [abs_mul]
            exact mul_le_one₀ (habs d1) (abs_nonneg _) (habs d2)
          · simp
      _ = (((d.divisors ×ˢ d.divisors).filter (fun p => p.1.lcm p.2 = d)).card : ℝ) := by
          rw [← Finset.sum_product' (f := fun d1 d2 => if d = Nat.lcm d1 d2 then (1 : ℝ) else 0),
            Finset.sum_boole]
          congr 2
          ext p
          simp [eq_comm]
      _ = _ := by
          rw [Nat.card_pair_lcm_eq hsq]
          push_cast
          ring
  · have h0 : (∑ d1 ∈ d.divisors, ∑ d2 ∈ d.divisors,
        if d = Nat.lcm d1 d2 then w d1 * w d2 else 0) = 0 := by
      apply Finset.sum_eq_zero
      intro d1 _
      apply Finset.sum_eq_zero
      intro d2 _
      split_ifs with h
      · have hle : d ≤ d1 * d2 := by
          rw [h]
          exact Nat.div_le_self _ _
        rcases le_total d1 d2 with h12 | h12
        · have hd2 : d ≤ d2 ^ 2 := by nlinarith
          have hw : w d2 = 0 := by
            apply hsupp d2
            intro hy
            apply hdy
            have : (d : ℝ) ≤ (d2 : ℝ) ^ 2 := by exact_mod_cast hd2
            linarith
          rw [hw, mul_zero]
        · have hd1 : d ≤ d1 ^ 2 := by nlinarith
          have hw : w d1 = 0 := by
            apply hsupp d1
            intro hy
            apply hdy
            have : (d : ℝ) ≤ (d1 : ℝ) ^ 2 := by exact_mod_cast hd1
            linarith
          rw [hw, zero_mul]
      · rfl
    rw [h0]
    simp

theorem nu_inv_eq_sum_inv_selbergTerms : ∀ (s : BoundingSieve) (e : ℕ), e ∣ s.prodPrimes →
    (s.nu e)⁻¹ = ∑ l ∈ s.prodPrimes.divisors,
      if l ∣ e then 1 / (s.nu l * ∏ p ∈ l.primeFactors, 1 / (1 - s.nu p)) else 0 :=
by
  intro s e he
  have hP : s.prodPrimes ≠ 0 := s.prodPrimes_ne_zero
  have hsqf : ∀ n, n ∣ s.prodPrimes → Squarefree n :=
    fun n hn => BoundingSieve.squarefree_of_dvd_prodPrimes hn
  have F3 : ∀ n : ℕ, Squarefree n → s.nu n = ∏ p ∈ n.primeFactors, s.nu p := by
    intro n hn
    have h := ArithmeticFunction.IsMultiplicative.map_prod_of_subset_primeFactors
      s.nu_mult n n.primeFactors subset_rfl
    rwa [Nat.prod_primeFactors_of_squarefree hn] at h
  have he0 : e ≠ 0 := ne_zero_of_dvd_ne_zero hP he
  obtain ⟨g, hg⟩ : ∃ g : ℕ → ℝ, ∀ p, g p = (1 - s.nu p) / s.nu p := ⟨_, fun _ => rfl⟩
  have hrestrict : (∑ l ∈ s.prodPrimes.divisors,
      if l ∣ e then 1 / (s.nu l * ∏ p ∈ l.primeFactors, 1 / (1 - s.nu p)) else 0)
      = ∑ l ∈ e.divisors, 1 / (s.nu l * ∏ p ∈ l.primeFactors, 1 / (1 - s.nu p)) := by
    rw [← Finset.sum_filter]
    apply Finset.sum_congr _ (fun _ _ => rfl)
    ext l
    simp only [Finset.mem_filter, Nat.mem_divisors]
    constructor
    · rintro ⟨⟨_, _⟩, hle⟩
      exact ⟨hle, he0⟩
    · rintro ⟨hle, _⟩
      exact ⟨⟨dvd_trans hle he, hP⟩, hle⟩
  have hterm : ∀ l ∈ e.divisors, 1 / (s.nu l * ∏ p ∈ l.primeFactors, 1 / (1 - s.nu p)) =
      ∏ p ∈ l.primeFactors, g p := by
    intro l hl
    have hlP : l ∣ s.prodPrimes := dvd_trans (Nat.dvd_of_mem_divisors hl) he
    rw [F3 l (hsqf l hlP), ← Finset.prod_mul_distrib, one_div, ← Finset.prod_inv_distrib]
    refine Finset.prod_congr rfl (fun p _ => ?_)
    rw [hg, one_div, mul_inv, inv_inv, div_eq_mul_inv, mul_comm]
  have h3 : ∑ l ∈ e.divisors, ∏ p ∈ l.primeFactors, g p = ∏ p ∈ e.primeFactors, (1 + g p) := by
    have hK := ArithmeticFunction.IsMultiplicative.prodPrimeFactors g
    have h := hK.prodPrimeFactors_one_add_of_squarefree (hsqf e he)
    calc ∑ l ∈ e.divisors, ∏ p ∈ l.primeFactors, g p
        = ∑ l ∈ e.divisors, ArithmeticFunction.prodPrimeFactors g l := by
          refine Finset.sum_congr rfl (fun l hl => ?_)
          rw [ArithmeticFunction.prodPrimeFactors_apply (Nat.pos_of_mem_divisors hl).ne']
      _ = ∏ p ∈ e.primeFactors, (1 + ArithmeticFunction.prodPrimeFactors g p) := h.symm
      _ = ∏ p ∈ e.primeFactors, (1 + g p) := by
          refine Finset.prod_congr rfl (fun p hp => ?_)
          have hpp := Nat.prime_of_mem_primeFactors hp
          rw [ArithmeticFunction.prodPrimeFactors_apply hpp.ne_zero, hpp.primeFactors,
            Finset.prod_singleton]
  rw [hrestrict, Finset.sum_congr rfl hterm, h3, F3 e (hsqf e he), ← Finset.prod_inv_distrib]
  refine Finset.prod_congr rfl (fun p hp => ?_)
  have hpP : p ∣ s.prodPrimes := dvd_trans (Nat.dvd_of_mem_primeFactors hp) he
  have hne : s.nu p ≠ 0 := BoundingSieve.nu_ne_zero hpP
  rw [hg, one_add_div hne, inv_eq_one_div]
  congr 1
  ring

theorem lambdaSq_mainSum_eq_diag : ∀ (s : BoundingSieve) (w F : ℕ → ℝ),
    (∀ e, e ∣ s.prodPrimes → (s.nu e)⁻¹ = ∑ l ∈ s.prodPrimes.divisors, if l ∣ e then F l else 0) →
    BoundingSieve.mainSum (s := s) (fun n => ∑ d1 ∈ n.divisors, ∑ d2 ∈ n.divisors,
        if n = Nat.lcm d1 d2 then w d1 * w d2 else 0) =
      ∑ l ∈ s.prodPrimes.divisors,
        F l * (∑ d ∈ s.prodPrimes.divisors, if l ∣ d then s.nu d * w d else 0) ^ 2 :=
by
  intro s w F hH
  have hP : s.prodPrimes ≠ 0 := BoundingSieve.prodPrimes_ne_zero
  
  have hQ : BoundingSieve.mainSum (s := s) (fun n => ∑ d1 ∈ n.divisors, ∑ d2 ∈ n.divisors,
        if n = Nat.lcm d1 d2 then w d1 * w d2 else 0) =
      ∑ d1 ∈ s.prodPrimes.divisors, ∑ d2 ∈ s.prodPrimes.divisors,
        s.nu d1 * w d1 * s.nu d2 * w d2 * (s.nu (d1.gcd d2))⁻¹ := by
    dsimp only [BoundingSieve.mainSum]
    trans (∑ d ∈ s.prodPrimes.divisors, ∑ d1 ∈ d.divisors, ∑ d2 ∈ d.divisors,
            if d = d1.lcm d2 then w d1 * w d2 * s.nu d else 0)
    · rw [Finset.sum_congr rfl]; intro d _
      rw [Finset.sum_mul, Finset.sum_congr rfl]; intro d1 _
      rw [Finset.sum_mul, Finset.sum_congr rfl]; intro d2 _
      rw [ite_zero_mul]
    trans (∑ d ∈ s.prodPrimes.divisors, ∑ d1 ∈ s.prodPrimes.divisors,
            ∑ d2 ∈ s.prodPrimes.divisors,
            if d = d1.lcm d2 then w d1 * w d2 * s.nu d else 0)
    · apply Finset.sum_congr rfl; intro d hd
      have hd' : d ∣ s.prodPrimes := Nat.dvd_of_mem_divisors hd
      rw [← Nat.divisors_filter_dvd_of_dvd hP hd', Finset.sum_filter]
      apply Finset.sum_congr rfl; intro d1 _
      rw [Finset.sum_filter]
      split_ifs with h1
      · apply Finset.sum_congr rfl; intro d2 _
        split_ifs with h2 h3 h3
        · rfl
        · rfl
        · exact absurd (h3 ▸ Nat.dvd_lcm_right d1 d2) h2
        · rfl
      · symm
        apply Finset.sum_eq_zero; intro d2 _
        rw [if_neg]
        rintro rfl
        exact h1 (Nat.dvd_lcm_left d1 d2)
    rw [Finset.sum_comm, Finset.sum_congr rfl]; intro d1 hd1
    rw [Finset.sum_comm, Finset.sum_congr rfl]; intro d2 hd2
    have h : d1.lcm d2 ∣ s.prodPrimes :=
      Nat.lcm_dvd_iff.mpr ⟨Nat.dvd_of_mem_divisors hd1, Nat.dvd_of_mem_divisors hd2⟩
    rw [Finset.sum_ite_eq_of_mem' (s.prodPrimes.divisors) (d1.lcm d2) _
      (Nat.mem_divisors.mpr ⟨h, hP⟩)]
    rw [s.nu_mult.map_lcm]
    · ring
    exact BoundingSieve.nu_ne_zero
      (dvd_trans (Nat.gcd_dvd_left d1 d2) (Nat.dvd_of_mem_divisors hd1))
  rw [hQ]
  trans (∑ d1 ∈ s.prodPrimes.divisors, ∑ d2 ∈ s.prodPrimes.divisors,
      (∑ l ∈ s.prodPrimes.divisors,
        if l ∣ d1.gcd d2 then F l * (s.nu d1 * w d1) * (s.nu d2 * w d2) else 0))
  · apply Finset.sum_congr rfl; intro d1 hd1; apply Finset.sum_congr rfl; intro d2 _
    have hgcd : d1.gcd d2 ∣ s.prodPrimes :=
      dvd_trans (Nat.gcd_dvd_left d1 d2) (Nat.dvd_of_mem_divisors hd1)
    rw [hH _ hgcd, Finset.mul_sum]
    apply Finset.sum_congr rfl; intro l _
    rw [mul_ite_zero]; apply if_congr Iff.rfl _ rfl
    ring
  trans (∑ l ∈ s.prodPrimes.divisors, ∑ d1 ∈ s.prodPrimes.divisors,
      ∑ d2 ∈ s.prodPrimes.divisors,
        if l ∣ Nat.gcd d1 d2 then F l * (s.nu d1 * w d1) * (s.nu d2 * w d2) else 0)
  · symm; rw [Finset.sum_comm, Finset.sum_congr rfl]; intro d1 _
    rw [Finset.sum_comm]
  apply Finset.sum_congr rfl; intro l _
  rw [sq, Finset.sum_mul, Finset.mul_sum, Finset.sum_congr rfl]; intro d1 _
  rw [Finset.mul_sum, Finset.mul_sum, Finset.sum_congr rfl]; intro d2 _
  rw [ite_zero_mul_ite_zero, mul_ite_zero]
  apply if_congr (Nat.dvd_gcd_iff) _ rfl
  ring

theorem selbergWeights_diagonalisation : ∀ (s : SelbergSieve) (h : ℕ → ℝ) (G : ℝ) (w : ℕ → ℝ),
    (∀ l, h l = s.nu l * ∏ p ∈ l.primeFactors, 1 / (1 - s.nu p)) →
    G = ∑ l ∈ s.prodPrimes.divisors, (if (l : ℝ) ^ 2 ≤ s.level then h l else 0) →
    (∀ d, w d = if d ∣ s.prodPrimes then
        (s.nu d)⁻¹ * h d * (ArithmeticFunction.moebius d : ℝ) * G⁻¹ *
          ∑ m ∈ s.prodPrimes.divisors,
            (if ((d * m : ℕ) : ℝ) ^ 2 ≤ s.level ∧ m.Coprime d then h m else 0)
      else 0) →
    ∀ l ∈ s.prodPrimes.divisors,
      (∑ d ∈ s.prodPrimes.divisors, if l ∣ d then s.nu d * w d else 0) =
        if (l : ℝ) ^ 2 ≤ s.level then h l * (ArithmeticFunction.moebius l : ℝ) * G⁻¹ else 0 :=
by
  intro s h G w hh hG hw l hl
  have hP : Squarefree s.prodPrimes := s.prodPrimes_squarefree
  have hP0 : s.prodPrimes ≠ 0 := hP.ne_zero
  
  have L1 : ∀ a b : ℕ, a.Coprime b → h (a * b) = h a * h b := by
    intro a b hab
    rw [hh, hh, hh, s.nu_mult.map_mul_of_coprime hab, Nat.Coprime.primeFactors_mul hab,
      Finset.prod_union hab.disjoint_primeFactors]
    ring
  
  have L3 : ∀ d : ℕ, d ∣ s.prodPrimes → ∀ g : ℕ → ℝ,
      (∑ m ∈ s.prodPrimes.divisors, if m.Coprime d then g (d * m) else 0) =
        ∑ k ∈ s.prodPrimes.divisors, if d ∣ k then g k else 0 := by
    intro d hd g
    have hd0 : 0 < d := Nat.pos_of_ne_zero (fun h0 => hP0 (by rw [h0] at hd; exact zero_dvd_iff.mp hd))
    rw [← Finset.sum_filter, ← Finset.sum_filter]
    apply Finset.sum_nbij' (fun m => d * m) (fun k => k / d)
    · intro m hm
      simp only [Finset.mem_coe, Finset.mem_filter, Nat.mem_divisors] at hm ⊢
      exact ⟨⟨Nat.Coprime.mul_dvd_of_dvd_of_dvd hm.2.symm hd hm.1.1, hP0⟩, dvd_mul_right d m⟩
    · intro k hk
      simp only [Finset.mem_coe, Finset.mem_filter, Nat.mem_divisors] at hk ⊢
      refine ⟨⟨(Nat.div_dvd_of_dvd hk.2).trans hk.1.1, hP0⟩, ?_⟩
      have hsq : Squarefree (d * (k / d)) := by
        rw [Nat.mul_div_cancel' hk.2]
        exact hP.squarefree_of_dvd hk.1.1
      exact (Nat.coprime_of_squarefree_mul hsq).symm
    · intro m _
      exact Nat.mul_div_cancel_left m hd0
    · intro k hk
      simp only [Finset.mem_coe, Finset.mem_filter, Nat.mem_divisors] at hk
      exact Nat.mul_div_cancel' hk.2
    · intro m _
      rfl
  
  have L2 : ∀ k, k ∣ s.prodPrimes →
      (∑ d ∈ s.prodPrimes.divisors,
          if l ∣ d ∧ d ∣ k then (ArithmeticFunction.moebius d : ℝ) else 0) =
        if l = k then (ArithmeticFunction.moebius l : ℝ) else 0 := by
    intro k hk
    have hk0 : k ≠ 0 := ne_zero_of_dvd_ne_zero hP0 hk
    by_cases hlk : l ∣ k
    · obtain ⟨t, rfl⟩ := hlk
      have hl0 : l ≠ 0 := left_ne_zero_of_mul hk0
      have ht0 : t ≠ 0 := right_ne_zero_of_mul hk0
      have hlpos : 0 < l := Nat.pos_of_ne_zero hl0
      have hsq : Squarefree (l * t) := hP.squarefree_of_dvd hk
      have hcop : l.Coprime t := Nat.coprime_of_squarefree_mul hsq
      rw [← Finset.sum_filter]
      have e1 : (∑ d ∈ s.prodPrimes.divisors.filter (fun d => l ∣ d ∧ d ∣ l * t),
          (ArithmeticFunction.moebius d : ℝ)) =
          ∑ e ∈ t.divisors, (ArithmeticFunction.moebius (l * e) : ℝ) := by
        apply Finset.sum_nbij' (fun d => d / l) (fun e => l * e)
        · intro d hd
          simp only [Finset.mem_coe, Finset.mem_filter, Nat.mem_divisors] at hd ⊢
          obtain ⟨_, ⟨c, rfl⟩, hdk⟩ := hd
          refine ⟨?_, ht0⟩
          rw [Nat.mul_div_cancel_left c hlpos]
          exact Nat.dvd_of_mul_dvd_mul_left hlpos hdk
        · intro e he
          simp only [Finset.mem_coe, Finset.mem_filter, Nat.mem_divisors] at he ⊢
          exact ⟨⟨(Nat.mul_dvd_mul_left l he.1).trans hk, hP0⟩, dvd_mul_right l e,
            Nat.mul_dvd_mul_left l he.1⟩
        · intro d hd
          simp only [Finset.mem_coe, Finset.mem_filter, Nat.mem_divisors] at hd
          exact Nat.mul_div_cancel' hd.2.1
        · intro e _
          exact Nat.mul_div_cancel_left e hlpos
        · intro d hd
          simp only [Finset.mem_coe, Finset.mem_filter, Nat.mem_divisors] at hd
          rw [Nat.mul_div_cancel' hd.2.1]
      rw [e1]
      have e2 : ∀ e ∈ t.divisors, (ArithmeticFunction.moebius (l * e) : ℝ) =
          (ArithmeticFunction.moebius l : ℝ) * (ArithmeticFunction.moebius e : ℝ) := by
        intro e he
        have hle : l.Coprime e := Nat.Coprime.coprime_dvd_right (Nat.dvd_of_mem_divisors he) hcop
        rw [ArithmeticFunction.isMultiplicative_moebius.map_mul_of_coprime hle]
        push_cast
        ring
      rw [Finset.sum_congr rfl e2, ← Finset.mul_sum]
      have e3 : (∑ e ∈ t.divisors, (ArithmeticFunction.moebius e : ℝ)) =
          if t = 1 then 1 else 0 := by
        have h1 := ArithmeticFunction.coe_mul_zeta_apply (f := ArithmeticFunction.moebius) (x := t)
        rw [ArithmeticFunction.moebius_mul_coe_zeta, ArithmeticFunction.one_apply] at h1
        have h2 : (∑ e ∈ t.divisors, (ArithmeticFunction.moebius e : ℝ)) =
            ((∑ e ∈ t.divisors, ArithmeticFunction.moebius e : ℤ) : ℝ) := by
          push_cast
          rfl
        rw [h2, ← h1]
        split_ifs <;> simp
      rw [e3]
      by_cases ht : t = 1
      · subst ht
        simp
      · have hne : l ≠ l * t := by
          intro heq
          apply ht
          exact Nat.eq_of_mul_eq_mul_left hlpos (heq.symm.trans (mul_one l).symm)
        rw [if_neg ht, if_neg hne, mul_zero]
    · have hne : l ≠ k := by
        rintro rfl
        exact hlk dvd_rfl
      rw [if_neg hne]
      apply Finset.sum_eq_zero
      intro d _
      exact if_neg (fun hd => hlk (hd.1.trans hd.2))
  
  obtain ⟨g, hg⟩ : ∃ g : ℕ → ℝ, ∀ k, g k = if (k : ℝ) ^ 2 ≤ s.level then h k else 0 :=
    ⟨_, fun _ => rfl⟩
  
  have s4 : ∀ d ∈ s.prodPrimes.divisors, s.nu d * w d =
      G⁻¹ * (ArithmeticFunction.moebius d : ℝ) *
        ∑ k ∈ s.prodPrimes.divisors, (if d ∣ k then g k else 0) := by
    intro d hd
    have hdP : d ∣ s.prodPrimes := Nat.dvd_of_mem_divisors hd
    have hν : s.nu d ≠ 0 := BoundingSieve.nu_ne_zero hdP
    have hS : h d * (∑ m ∈ s.prodPrimes.divisors,
        (if ((d * m : ℕ) : ℝ) ^ 2 ≤ s.level ∧ m.Coprime d then h m else 0)) =
        ∑ m ∈ s.prodPrimes.divisors, if m.Coprime d then g (d * m) else 0 := by
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro m _
      by_cases hC : m.Coprime d
      · by_cases hA : ((d * m : ℕ) : ℝ) ^ 2 ≤ s.level
        · rw [if_pos ⟨hA, hC⟩, if_pos hC, hg, if_pos hA, L1 d m hC.symm]
        · rw [if_neg (fun hc => hA hc.1), if_pos hC, hg, if_neg hA, mul_zero]
      · rw [if_neg (fun hc => hC hc.2), if_neg hC, mul_zero]
    rw [hw d, if_pos hdP, ← L3 d hdP g, ← hS]
    simp only [mul_assoc]
    rw [mul_inv_cancel_left₀ hν]
    ring
  calc (∑ d ∈ s.prodPrimes.divisors, if l ∣ d then s.nu d * w d else 0)
      = ∑ d ∈ s.prodPrimes.divisors, ∑ k ∈ s.prodPrimes.divisors,
          (if l ∣ d ∧ d ∣ k then G⁻¹ * g k * (ArithmeticFunction.moebius d : ℝ) else 0) := by
        apply Finset.sum_congr rfl
        intro d hd
        by_cases hld : l ∣ d
        · rw [if_pos hld, s4 d hd, Finset.mul_sum]
          apply Finset.sum_congr rfl
          intro k _
          by_cases hdk : d ∣ k
          · rw [if_pos hdk, if_pos ⟨hld, hdk⟩]
            ring
          · rw [if_neg hdk, if_neg (fun hc => hdk hc.2)]
            ring
        · rw [if_neg hld]
          symm
          apply Finset.sum_eq_zero
          intro k _
          exact if_neg (fun hc => hld hc.1)
    _ = ∑ k ∈ s.prodPrimes.divisors, ∑ d ∈ s.prodPrimes.divisors,
          (if l ∣ d ∧ d ∣ k then G⁻¹ * g k * (ArithmeticFunction.moebius d : ℝ) else 0) :=
        Finset.sum_comm
    _ = ∑ k ∈ s.prodPrimes.divisors, G⁻¹ * g k *
          (∑ d ∈ s.prodPrimes.divisors,
            if l ∣ d ∧ d ∣ k then (ArithmeticFunction.moebius d : ℝ) else 0) := by
        apply Finset.sum_congr rfl
        intro k _
        rw [Finset.mul_sum]
        apply Finset.sum_congr rfl
        intro d _
        split_ifs <;> ring
    _ = ∑ k ∈ s.prodPrimes.divisors,
          (if l = k then G⁻¹ * g k * (ArithmeticFunction.moebius l : ℝ) else 0) := by
        apply Finset.sum_congr rfl
        intro k hk
        rw [L2 k (Nat.dvd_of_mem_divisors hk)]
        split_ifs <;> ring
    _ = G⁻¹ * g l * (ArithmeticFunction.moebius l : ℝ) := by
        rw [Finset.sum_ite_eq, if_pos hl]
    _ = _ := by
        rw [hg l]
        split_ifs <;> ring

theorem selbergWeights_abs_le_one : ∀ (s : SelbergSieve) (h : ℕ → ℝ) (G : ℝ) (w : ℕ → ℝ),
    (∀ l, h l = s.nu l * ∏ p ∈ l.primeFactors, 1 / (1 - s.nu p)) →
    G = ∑ l ∈ s.prodPrimes.divisors, (if (l : ℝ) ^ 2 ≤ s.level then h l else 0) →
    (∀ d, w d = if d ∣ s.prodPrimes then
        (s.nu d)⁻¹ * h d * (ArithmeticFunction.moebius d : ℝ) * G⁻¹ *
          ∑ m ∈ s.prodPrimes.divisors,
            (if ((d * m : ℕ) : ℝ) ^ 2 ≤ s.level ∧ m.Coprime d then h m else 0)
      else 0) →
    ∀ d, |w d| ≤ 1 :=
by
  intro s h G w hh hG hw d
  have hP : s.prodPrimes ≠ 0 := BoundingSieve.prodPrimes_ne_zero
  by_cases hd : d ∣ s.prodPrimes
  swap
  · rw [hw d, if_neg hd, abs_zero]; exact zero_le_one
  
  have hpos : ∀ l, l ∣ s.prodPrimes → 0 < h l := by
    intro l hl
    rw [hh l]
    apply mul_pos (BoundingSieve.nu_pos_of_dvd_prodPrimes hl)
    apply Finset.prod_pos
    intro p hp
    have hpp := Nat.prime_of_mem_primeFactors hp
    have hpP : p ∣ s.prodPrimes := (Nat.dvd_of_mem_primeFactors hp).trans hl
    have := s.nu_lt_one_of_prime p hpp hpP
    rw [one_div_pos]; linarith
  have h1 : h 1 = 1 := by
    rw [hh 1, s.nu_mult.map_one]; simp
  
  have hmul : ∀ a b : ℕ, a.Coprime b → h (a * b) = h a * h b := by
    intro a b hab
    rw [hh (a * b), hh a, hh b, s.nu_mult.map_mul_of_coprime hab, Nat.Coprime.primeFactors_mul hab,
      Finset.prod_union (Nat.Coprime.disjoint_primeFactors hab)]
    ring
  
  have hsum : ∑ e ∈ d.divisors, h e = (s.nu d)⁻¹ * h d := by
    have hsqf : Squarefree d := BoundingSieve.squarefree_of_dvd_prodPrimes hd
    set H : ArithmeticFunction ℝ :=
      s.nu.pmul (ArithmeticFunction.prodPrimeFactors fun p => 1 / (1 - s.nu p)) with hHdef
    have hHm : H.IsMultiplicative :=
      ArithmeticFunction.IsMultiplicative.pmul s.nu_mult
        (ArithmeticFunction.IsMultiplicative.prodPrimeFactors _)
    have hHh : ∀ l, H l = h l := by
      intro l
      rcases Nat.eq_zero_or_pos l with hl | hl
      · subst hl
        rw [hh 0, ArithmeticFunction.map_zero, ArithmeticFunction.map_zero, zero_mul]
      · rw [hh l, hHdef, ArithmeticFunction.pmul_apply,
          ArithmeticFunction.prodPrimeFactors_apply hl.ne']
    have hHsum := hHm.prodPrimeFactors_one_add_of_squarefree hsqf
    have hLHS : ∑ e ∈ d.divisors, h e = ∏ p ∈ d.primeFactors, (1 / (1 - s.nu p)) := by
      rw [← Finset.sum_congr rfl (fun e _ => hHh e), ← hHsum]
      apply Finset.prod_congr rfl
      intro p hp
      have hpp := Nat.prime_of_mem_primeFactors hp
      have hpP : p ∣ s.prodPrimes := (Nat.dvd_of_mem_primeFactors hp).trans hd
      have hlt := s.nu_lt_one_of_prime p hpp hpP
      have hne : (1 - s.nu p) ≠ 0 := by linarith
      rw [hHh p, hh p, hpp.primeFactors, Finset.prod_singleton]
      field_simp
      ring
    rw [hLHS, hh d, inv_mul_cancel_left₀ (BoundingSieve.nu_pos_of_dvd_prodPrimes hd).ne']
  
  have hd0 : d ≠ 0 := fun h0 => hP (by rw [h0] at hd; exact zero_dvd_iff.mp hd)
  set S := ∑ m ∈ s.prodPrimes.divisors,
      (if ((d * m : ℕ) : ℝ) ^ 2 ≤ s.level ∧ m.Coprime d then h m else 0) with hSdef
  have hS0 : 0 ≤ S := by
    apply Finset.sum_nonneg
    intro m hm
    split_ifs
    · exact (hpos m (Nat.dvd_of_mem_divisors hm)).le
    · exact le_refl _
  
  have hineq : (∑ e ∈ d.divisors, h e) * S ≤ G := by
    set E := d.divisors with hE
    set M := s.prodPrimes.divisors.filter
      (fun m => ((d * m : ℕ) : ℝ) ^ 2 ≤ s.level ∧ m.Coprime d) with hM
    set T := s.prodPrimes.divisors.filter (fun l : ℕ => (l : ℝ) ^ 2 ≤ s.level) with hT
    have hS' : S = ∑ m ∈ M, h m := by rw [hSdef, hM, Finset.sum_filter]
    have hG' : G = ∑ l ∈ T, h l := by rw [hG, hT, Finset.sum_filter]
    rw [hS', hG', Finset.sum_mul_sum, ← Finset.sum_product']
    have hmerge : ∀ x ∈ E ×ˢ M, h x.1 * h x.2 = h (x.1 * x.2) := by
      intro x hx
      rw [Finset.mem_product] at hx
      have he : x.1 ∣ d := Nat.dvd_of_mem_divisors hx.1
      have hm := (Finset.mem_filter.mp hx.2).2.2
      exact (hmul x.1 x.2 (Nat.Coprime.coprime_dvd_left he hm.symm)).symm
    rw [Finset.sum_congr rfl hmerge]
    have hinj : Set.InjOn (fun x : ℕ × ℕ => x.1 * x.2) (E ×ˢ M : Finset (ℕ × ℕ)) := by
      have key : ∀ x ∈ E ×ˢ M, Nat.gcd d (x.1 * x.2) = x.1 := by
        intro x hx
        rw [Finset.mem_product] at hx
        have he : x.1 ∣ d := Nat.dvd_of_mem_divisors hx.1
        have hm := (Finset.mem_filter.mp hx.2).2.2
        rw [Nat.Coprime.gcd_mul d (Nat.Coprime.coprime_dvd_left he hm.symm), Nat.gcd_eq_right he,
          Nat.Coprime.gcd_eq_one hm.symm, mul_one]
      intro x hx y hy hxy
      have hx' : x ∈ E ×ˢ M := hx
      have hy' : y ∈ E ×ˢ M := hy
      simp only at hxy
      have h1eq : x.1 = y.1 := by rw [← key x hx', ← key y hy', hxy]
      have hxpos : 0 < x.1 := Nat.pos_of_mem_divisors (Finset.mem_product.mp hx').1
      have h2eq : x.2 = y.2 := by
        rw [h1eq] at hxy
        exact Nat.eq_of_mul_eq_mul_left (h1eq ▸ hxpos) hxy
      exact Prod.ext h1eq h2eq
    rw [← Finset.sum_image (f := h) hinj]
    apply Finset.sum_le_sum_of_subset_of_nonneg
    · intro l hl
      rw [Finset.mem_image] at hl
      obtain ⟨x, hx, rfl⟩ := hl
      rw [Finset.mem_product] at hx
      have he : x.1 ∣ d := Nat.dvd_of_mem_divisors hx.1
      have hmD := (Finset.mem_filter.mp hx.2).1
      have hm := (Finset.mem_filter.mp hx.2).2
      have hmP : x.2 ∣ s.prodPrimes := Nat.dvd_of_mem_divisors hmD
      rw [hT, Finset.mem_filter, Nat.mem_divisors]
      refine ⟨⟨Nat.Coprime.mul_dvd_of_dvd_of_dvd
        (Nat.Coprime.coprime_dvd_left he hm.2.symm) (he.trans hd) hmP, hP⟩, ?_⟩
      have hle : x.1 * x.2 ≤ d * x.2 := Nat.mul_le_mul_right _ (Nat.le_of_dvd (Nat.pos_of_ne_zero hd0) he)
      have hle' : ((x.1 * x.2 : ℕ) : ℝ) ≤ ((d * x.2 : ℕ) : ℝ) := by exact_mod_cast hle
      calc ((x.1 * x.2 : ℕ) : ℝ) ^ 2 ≤ ((d * x.2 : ℕ) : ℝ) ^ 2 :=
            pow_le_pow_left₀ (Nat.cast_nonneg _) hle' 2
        _ ≤ s.level := hm.1
    · intro l hl _
      exact (hpos l (Nat.dvd_of_mem_divisors (Finset.mem_filter.mp hl).1)).le
  
  have hG1 : 1 ≤ G := by
    rw [hG]
    have h1mem : 1 ∈ s.prodPrimes.divisors := Nat.one_mem_divisors.mpr hP
    have hterm : (if ((1 : ℕ) : ℝ) ^ 2 ≤ s.level then h 1 else 0) = 1 := by
      rw [if_pos (by rw [Nat.cast_one, one_pow]; exact s.one_le_level), h1]
    rw [← hterm]
    apply Finset.single_le_sum (f := fun l : ℕ => if (l : ℝ) ^ 2 ≤ s.level then h l else 0) _ h1mem
    intro l hl
    dsimp only
    split_ifs
    · exact (hpos l (Nat.dvd_of_mem_divisors hl)).le
    · exact le_refl _
  have hGpos : 0 < G := by linarith
  have hmu : |((ArithmeticFunction.moebius d : ℤ) : ℝ)| = 1 := by
    rw [← Int.cast_abs, ArithmeticFunction.abs_moebius_eq_one_of_squarefree
      (BoundingSieve.squarefree_of_dvd_prodPrimes hd), Int.cast_one]
  have hnu : 0 < (s.nu d)⁻¹ := inv_pos.mpr (BoundingSieve.nu_pos_of_dvd_prodPrimes hd)
  rw [hw d, if_pos hd, ← hSdef, abs_mul, abs_mul, abs_mul, abs_mul, hmu, abs_of_pos hnu,
    abs_of_pos (hpos d hd), abs_of_pos (inv_pos.mpr hGpos), abs_of_nonneg hS0]
  rw [hsum] at hineq
  have : (s.nu d)⁻¹ * h d * 1 * G⁻¹ * S = ((s.nu d)⁻¹ * h d * S) / G := by ring
  rw [this, div_le_one hGpos]
  exact hineq

theorem selbergWeights_basic : ∀ (s : SelbergSieve) (h : ℕ → ℝ) (G : ℝ) (w : ℕ → ℝ),
    (∀ l, h l = s.nu l * ∏ p ∈ l.primeFactors, 1 / (1 - s.nu p)) →
    G = ∑ l ∈ s.prodPrimes.divisors, (if (l : ℝ) ^ 2 ≤ s.level then h l else 0) →
    (∀ d, w d = if d ∣ s.prodPrimes then
        (s.nu d)⁻¹ * h d * (ArithmeticFunction.moebius d : ℝ) * G⁻¹ *
          ∑ m ∈ s.prodPrimes.divisors,
            (if ((d * m : ℕ) : ℝ) ^ 2 ≤ s.level ∧ m.Coprime d then h m else 0)
      else 0) →
    (∀ l, l ∣ s.prodPrimes → 0 < h l) ∧ 0 < G ∧ w 1 = 1 ∧
      (∀ d : ℕ, ¬ (d : ℝ) ^ 2 ≤ s.level → w d = 0) :=
by
  intro s h G w hh hG hw
  have hP0 : s.prodPrimes ≠ 0 := BoundingSieve.prodPrimes_ne_zero (s := s.toBoundingSieve)
  have hnu1 : s.nu 1 = 1 := s.toBoundingSieve.nu_mult.map_one
  have hpos : ∀ l, l ∣ s.prodPrimes → 0 < h l := by
    intro l hl
    rw [hh l]
    apply mul_pos (BoundingSieve.nu_pos_of_dvd_prodPrimes hl)
    apply Finset.prod_pos
    intro p hp
    have hpp : p.Prime := Nat.prime_of_mem_primeFactors hp
    have hpP : p ∣ s.prodPrimes := dvd_trans (Nat.dvd_of_mem_primeFactors hp) hl
    have hlt : s.nu p < 1 := s.toBoundingSieve.nu_lt_one_of_prime p hpp hpP
    apply one_div_pos.mpr
    linarith
  have h1 : h 1 = 1 := by
    rw [hh 1, hnu1, Nat.primeFactors_one, Finset.prod_empty, mul_one]
  have hGge : 1 ≤ G := by
    rw [hG]
    have hmem : 1 ∈ s.prodPrimes.divisors := Nat.one_mem_divisors.mpr hP0
    have hnn : ∀ l ∈ s.prodPrimes.divisors,
        0 ≤ (if (l : ℝ) ^ 2 ≤ s.level then h l else 0) := by
      intro l hl
      have := hpos l (Nat.mem_divisors.mp hl).1
      split_ifs
      · exact this.le
      · exact le_refl 0
    have hle := Finset.single_le_sum hnn hmem
    have hval : (if ((1 : ℕ) : ℝ) ^ 2 ≤ s.level then h 1 else 0) = 1 := by
      have hy : ((1 : ℕ) : ℝ) ^ 2 ≤ s.level := by
        simp only [Nat.cast_one, one_pow]
        exact s.one_le_level
      rw [if_pos hy, h1]
    rw [hval] at hle
    exact hle
  have hGpos : 0 < G := lt_of_lt_of_le one_pos hGge
  refine ⟨hpos, hGpos, ?_, ?_⟩
  · rw [hw 1, if_pos (one_dvd _), hnu1, h1, ArithmeticFunction.moebius_apply_one]
    have hsum : (∑ m ∈ s.prodPrimes.divisors,
        (if ((1 * m : ℕ) : ℝ) ^ 2 ≤ s.level ∧ m.Coprime 1 then h m else 0)) = G := by
      rw [hG]
      apply Finset.sum_congr rfl
      intro m _
      simp [Nat.one_mul, Nat.coprime_one_right_eq_true]
    rw [hsum]
    simp only [inv_one, one_mul, Int.cast_one]
    exact inv_mul_cancel₀ hGpos.ne'
  · intro d hd
    rw [hw d]
    split_ifs with hdP
    · have hz : (∑ m ∈ s.prodPrimes.divisors,
          (if ((d * m : ℕ) : ℝ) ^ 2 ≤ s.level ∧ m.Coprime d then h m else 0)) = 0 := by
        apply Finset.sum_eq_zero
        intro m hm
        apply if_neg
        rintro ⟨hyp, _⟩
        have hmpos : 0 < m := Nat.pos_of_mem_divisors hm
        have hdm : d ≤ d * m := Nat.le_mul_of_pos_right d hmpos
        have hdm2 : d ^ 2 ≤ (d * m) ^ 2 := Nat.pow_le_pow_left hdm 2
        have hR : (d : ℝ) ^ 2 ≤ ((d * m : ℕ) : ℝ) ^ 2 := by exact_mod_cast hdm2
        exact hd (le_trans hR hyp)
      rw [hz, mul_zero]
    · rfl

theorem selberg_sieve_simple_bound : ∀ s : SelbergSieve,
    BoundingSieve.siftedSum (s := s.toBoundingSieve) ≤
      s.totalMass / (∑ l ∈ s.prodPrimes.divisors,
          if (l : ℝ) ^ 2 ≤ s.level then s.nu l * ∏ p ∈ l.primeFactors, 1 / (1 - s.nu p) else 0) +
        ∑ d ∈ s.prodPrimes.divisors,
          if (d : ℝ) ≤ s.level then
            (3 : ℝ) ^ ArithmeticFunction.cardDistinctFactors d *
              |BoundingSieve.rem (s := s.toBoundingSieve) d|
          else 0 :=
by
  intro s
  obtain ⟨h, hh⟩ : ∃ h : ℕ → ℝ, ∀ l, h l = s.nu l * ∏ p ∈ l.primeFactors, 1 / (1 - s.nu p) :=
    ⟨_, fun _ => rfl⟩
  obtain ⟨G, hG⟩ : ∃ G : ℝ,
      G = ∑ l ∈ s.prodPrimes.divisors, (if (l : ℝ) ^ 2 ≤ s.level then h l else 0) :=
    ⟨_, rfl⟩
  obtain ⟨w, hw⟩ : ∃ w : ℕ → ℝ, ∀ d, w d = if d ∣ s.prodPrimes then
        (s.nu d)⁻¹ * h d * (ArithmeticFunction.moebius d : ℝ) * G⁻¹ *
          ∑ m ∈ s.prodPrimes.divisors,
            (if ((d * m : ℕ) : ℝ) ^ 2 ≤ s.level ∧ m.Coprime d then h m else 0)
      else 0 := ⟨_, fun _ => rfl⟩
  obtain ⟨hpos, hGpos, hw1, hsupp⟩ := selbergWeights_basic s h G w hh hG hw
  have hdiag := selbergWeights_diagonalisation s h G w hh hG hw
  have habs := selbergWeights_abs_le_one s h G w hh hG hw
  have H1 := lambdaSq_upperMoebius_bound s.toBoundingSieve w hw1
  have H2 := lambdaSq_errSum_le s w habs hsupp
  have H4 := lambdaSq_mainSum_eq_diag s.toBoundingSieve w (fun l => 1 / h l)
    (fun e he => by
      rw [nu_inv_eq_sum_inv_selbergTerms s.toBoundingSieve e he]
      simp only [hh])
  have hden : (∑ l ∈ s.prodPrimes.divisors,
      if (l : ℝ) ^ 2 ≤ s.level then s.nu l * ∏ p ∈ l.primeFactors, 1 / (1 - s.nu p) else 0) = G := by
    rw [hG]
    simp only [hh]
  have hGne : G ≠ 0 := hGpos.ne'
  have hterm : ∀ l ∈ s.prodPrimes.divisors,
      1 / h l * (∑ d ∈ s.prodPrimes.divisors, if l ∣ d then s.nu d * w d else 0) ^ 2 =
        (if (l : ℝ) ^ 2 ≤ s.level then h l else 0) * (G⁻¹ * G⁻¹) := by
    intro l hl
    rw [hdiag l hl]
    have hl' : l ∣ s.prodPrimes := Nat.dvd_of_mem_divisors hl
    have hsq : ((ArithmeticFunction.moebius l : ℤ) : ℝ) ^ 2 = 1 := by
      have := ArithmeticFunction.moebius_sq_eq_one_of_squarefree
        (BoundingSieve.squarefree_of_dvd_prodPrimes hl')
      exact_mod_cast this
    have hne : h l ≠ 0 := (hpos l hl').ne'
    split_ifs
    · calc 1 / h l * (h l * (ArithmeticFunction.moebius l : ℝ) * G⁻¹) ^ 2
          = (1 / h l * h l) * h l * ((ArithmeticFunction.moebius l : ℤ) : ℝ) ^ 2 * (G⁻¹ * G⁻¹) := by
            ring
        _ = h l * (G⁻¹ * G⁻¹) := by rw [one_div_mul_cancel hne, hsq]; ring
    · simp
  have Hmain : BoundingSieve.mainSum (s := s.toBoundingSieve)
      (fun n => ∑ d1 ∈ n.divisors, ∑ d2 ∈ n.divisors,
        if n = Nat.lcm d1 d2 then w d1 * w d2 else 0) = G⁻¹ := by
    rw [H4, Finset.sum_congr rfl hterm, ← Finset.sum_mul, ← hG]
    field_simp
  rw [hden]
  calc BoundingSieve.siftedSum (s := s.toBoundingSieve)
      ≤ s.totalMass * BoundingSieve.mainSum (s := s.toBoundingSieve)
          (fun n => ∑ d1 ∈ n.divisors, ∑ d2 ∈ n.divisors,
            if n = Nat.lcm d1 d2 then w d1 * w d2 else 0) +
        BoundingSieve.errSum (s := s.toBoundingSieve)
          (fun n => ∑ d1 ∈ n.divisors, ∑ d2 ∈ n.divisors,
            if n = Nat.lcm d1 d2 then w d1 * w d2 else 0) := H1
    _ ≤ _ := by
      rw [Hmain, ← div_eq_mul_inv]
      linarith [H2]

theorem selberg_sum_ge_multiplicative_sum : ∀ (g : ℕ → ℝ) (P : ℕ) (y : ℝ), 1 ≤ y → Squarefree P →
    (∀ p : ℕ, p.Prime → (p : ℝ) ≤ y → p ∣ P) →
    (∀ p : ℕ, p.Prime → 0 ≤ g p ∧ g p < 1) →
    (∑ m ∈ Finset.Icc 1 ⌊Real.sqrt y⌋₊, ∏ p ∈ m.primeFactors, g p ^ m.factorization p) ≤
      ∑ l ∈ P.divisors, if (l : ℝ) ^ 2 ≤ y then ∏ p ∈ l.primeFactors, g p / (1 - g p) else 0 :=
by
  intro g P y hy hsq hP hg
  have hP0 : P ≠ 0 := hsq.ne_zero
  have hy0 : (0 : ℝ) ≤ y := by linarith
  
  have s1 : ∀ m ∈ Finset.Icc 1 ⌊Real.sqrt y⌋₊, (∏ p ∈ m.primeFactors, p) ∈
      P.divisors.filter (fun l : ℕ => (l : ℝ) ^ 2 ≤ y) := by
    intro m hm
    rw [Finset.mem_Icc] at hm
    have hmsq : (m : ℝ) ≤ Real.sqrt y := by
      have h1 := Nat.floor_le (Real.sqrt_nonneg y)
      have h2 : (m : ℝ) ≤ (⌊Real.sqrt y⌋₊ : ℝ) := by exact_mod_cast hm.2
      linarith
    have hsqy : Real.sqrt y ≤ y := Real.sqrt_le_iff.mpr ⟨hy0, by nlinarith⟩
    have hrm : (∏ p ∈ m.primeFactors, p) ∣ m := Nat.prod_primeFactors_dvd m
    have hrle : (∏ p ∈ m.primeFactors, p) ≤ m := Nat.le_of_dvd (by omega) hrm
    have hrP : (∏ p ∈ m.primeFactors, p) ∣ P := by
      apply Finset.prod_primes_dvd
      · intro p hp
        exact (Nat.prime_of_mem_primeFactors hp).prime
      · intro p hp
        apply hP p (Nat.prime_of_mem_primeFactors hp)
        have h3 : p ≤ m := Nat.le_of_mem_primeFactors hp
        have h4 : (p : ℝ) ≤ m := by exact_mod_cast h3
        linarith
    rw [Finset.mem_filter, Nat.mem_divisors]
    refine ⟨⟨hrP, hP0⟩, ?_⟩
    have h1 : ((∏ p ∈ m.primeFactors, p : ℕ) : ℝ) ≤ Real.sqrt y := by
      have h5 : ((∏ p ∈ m.primeFactors, p : ℕ) : ℝ) ≤ m := by exact_mod_cast hrle
      linarith
    have h0 : (0 : ℝ) ≤ ((∏ p ∈ m.primeFactors, p : ℕ) : ℝ) := Nat.cast_nonneg _
    calc ((∏ p ∈ m.primeFactors, p : ℕ) : ℝ) ^ 2 ≤ (Real.sqrt y) ^ 2 := pow_le_pow_left₀ h0 h1 2
      _ = y := Real.sq_sqrt hy0
  
  have s2 : ∀ s : Finset ℕ, (∀ p ∈ s, p.Prime) →
      (∑ m ∈ (Finset.Icc 1 ⌊Real.sqrt y⌋₊).filter (fun m => m.primeFactors = s),
        ∏ p ∈ m.primeFactors, g p ^ m.factorization p) ≤
        ∏ p ∈ s, ∑ e ∈ Finset.Icc 1 ⌊Real.sqrt y⌋₊, g p ^ e := by
    intro s hs
    let vec : ℕ → (s → ℕ) := fun m i => m.factorization i
    let H : (s → ℕ) → ℝ := fun f => ∏ i : s, g i ^ f i
    have hA : ∏ p ∈ s, ∑ e ∈ Finset.Icc 1 ⌊Real.sqrt y⌋₊, g p ^ e =
        ∑ f ∈ Fintype.piFinset (fun _ : s => Finset.Icc 1 ⌊Real.sqrt y⌋₊), H f := by
      rw [← Finset.prod_coe_sort s, Finset.prod_univ_sum]
    have hB : (∑ m ∈ (Finset.Icc 1 ⌊Real.sqrt y⌋₊).filter (fun m => m.primeFactors = s),
        ∏ p ∈ m.primeFactors, g p ^ m.factorization p) =
        ∑ m ∈ (Finset.Icc 1 ⌊Real.sqrt y⌋₊).filter (fun m => m.primeFactors = s), H (vec m) := by
      apply Finset.sum_congr rfl
      intro m hm
      have hms : m.primeFactors = s := (Finset.mem_filter.mp hm).2
      rw [hms]
      exact (Finset.prod_coe_sort s (fun p => g p ^ m.factorization p)).symm
    have hinj : Set.InjOn vec
        ((Finset.Icc 1 ⌊Real.sqrt y⌋₊).filter (fun m => m.primeFactors = s) : Set ℕ) := by
      intro m hm m' hm' h
      have hm1 := Finset.mem_filter.mp (Finset.mem_coe.mp hm)
      have hm1' := Finset.mem_filter.mp (Finset.mem_coe.mp hm')
      have h0 : m ≠ 0 := by have := (Finset.mem_Icc.mp hm1.1).1; omega
      have h0' : m' ≠ 0 := by have := (Finset.mem_Icc.mp hm1'.1).1; omega
      apply Nat.eq_of_factorization_eq h0 h0'
      intro p
      by_cases hp : p ∈ s
      · exact congrFun h ⟨p, hp⟩
      · have a : p ∉ m.primeFactors := by rw [hm1.2]; exact hp
        have b : p ∉ m'.primeFactors := by rw [hm1'.2]; exact hp
        rw [← Nat.support_factorization] at a b
        rw [Finsupp.notMem_support_iff.mp a, Finsupp.notMem_support_iff.mp b]
    have hsub : ((Finset.Icc 1 ⌊Real.sqrt y⌋₊).filter (fun m => m.primeFactors = s)).image vec ⊆
        Fintype.piFinset (fun _ : s => Finset.Icc 1 ⌊Real.sqrt y⌋₊) := by
      intro f hf
      obtain ⟨m, hm, rfl⟩ := Finset.mem_image.mp hf
      have hm1 := Finset.mem_filter.mp hm
      have hmI := Finset.mem_Icc.mp hm1.1
      have h0 : m ≠ 0 := by omega
      rw [Fintype.mem_piFinset]
      intro i
      have hi : (i : ℕ) ∈ m.primeFactors := by rw [hm1.2]; exact i.2
      have hip := Nat.mem_primeFactors.mp hi
      rw [Finset.mem_Icc]
      constructor
      · exact hip.1.factorization_pos_of_dvd h0 hip.2.1
      · have := Nat.factorization_lt (i : ℕ) h0
        show m.factorization i ≤ ⌊Real.sqrt y⌋₊
        omega
    have hHnn : ∀ f, 0 ≤ H f := fun f =>
      Finset.prod_nonneg (fun i _ => pow_nonneg (hg i (hs i i.2)).1 _)
    rw [hB, ← Finset.sum_image hinj, hA]
    exact Finset.sum_le_sum_of_subset_of_nonneg hsub (fun f _ _ => hHnn f)
  
  have s3 : ∀ s : Finset ℕ, (∀ p ∈ s, p.Prime) →
      ∏ p ∈ s, ∑ e ∈ Finset.Icc 1 ⌊Real.sqrt y⌋₊, g p ^ e ≤ ∏ p ∈ s, g p / (1 - g p) := by
    intro s hs
    apply Finset.prod_le_prod
    · intro p hp
      exact Finset.sum_nonneg (fun e _ => pow_nonneg (hg p (hs p hp)).1 e)
    · intro p hp
      have h := geom_sum_Ico_le_of_lt_one (m := 1) (n := ⌊Real.sqrt y⌋₊ + 1)
        (hg p (hs p hp)).1 (hg p (hs p hp)).2
      rw [Finset.Ico_add_one_right_eq_Icc, pow_one] at h
      exact h
  
  rw [← Finset.sum_filter]
  rw [← Finset.sum_fiberwise_of_maps_to s1]
  apply Finset.sum_le_sum
  intro l _
  have hsub : (Finset.Icc 1 ⌊Real.sqrt y⌋₊).filter (fun m => (∏ p ∈ m.primeFactors, p) = l) ⊆
      (Finset.Icc 1 ⌊Real.sqrt y⌋₊).filter (fun m => m.primeFactors = l.primeFactors) := by
    intro m hm
    rw [Finset.mem_filter] at hm ⊢
    refine ⟨hm.1, ?_⟩
    rw [← hm.2, Nat.primeFactors_prod (fun p hp => Nat.prime_of_mem_primeFactors hp)]
  have hGnn : ∀ m : ℕ, 0 ≤ ∏ p ∈ m.primeFactors, g p ^ m.factorization p := fun m =>
    Finset.prod_nonneg (fun p hp => pow_nonneg (hg p (Nat.prime_of_mem_primeFactors hp)).1 _)
  calc _ ≤ _ := Finset.sum_le_sum_of_subset_of_nonneg hsub (fun m _ _ => hGnn m)
    _ ≤ _ := s2 l.primeFactors (fun p hp => Nat.prime_of_mem_primeFactors hp)
    _ ≤ _ := s3 l.primeFactors (fun p hp => Nat.prime_of_mem_primeFactors hp)

theorem coprime_harmonic_lower_bound : ∀ (b M : ℕ), 0 < b →
    (b.totient : ℝ) / b * (∑ k ∈ Finset.Icc 1 M, (k : ℝ)⁻¹) ≤
      ∑ k ∈ (Finset.Icc 1 M).filter (fun k => k.Coprime b), (k : ℝ)⁻¹ :=
by
  intro b M hb
  
  have hstep : ∀ (s : Finset ℕ) (p : ℕ), 0 < p →
      ∑ k ∈ ((Finset.Icc 1 M).filter (fun k => ∀ q ∈ s, ¬ q ∣ k)).filter (fun k => p ∣ k),
          (k : ℝ)⁻¹ ≤
        (p : ℝ)⁻¹ * ∑ k ∈ (Finset.Icc 1 M).filter (fun k => ∀ q ∈ s, ¬ q ∣ k), (k : ℝ)⁻¹ := by
    intro s p hp
    set A := (Finset.Icc 1 M).filter (fun k => ∀ q ∈ s, ¬ q ∣ k) with hA
    set B := A.filter (fun k => p ∣ k) with hB
    have hBdvd : ∀ k ∈ B, p ∣ k := fun k hk => (Finset.mem_filter.mp hk).2
    have hmaps : ∀ k ∈ B, k / p ∈ A := by
      intro k hk
      have h4 := hBdvd k hk
      have hkA : k ∈ A := (Finset.mem_filter.mp hk).1
      rw [hA, Finset.mem_filter, Finset.mem_Icc] at hkA
      obtain ⟨⟨h1, h2⟩, h3⟩ := hkA
      rw [hA, Finset.mem_filter, Finset.mem_Icc]
      refine ⟨⟨Nat.div_pos (Nat.le_of_dvd (by omega) h4) hp, (Nat.div_le_self k p).trans h2⟩, ?_⟩
      intro q hq hqd
      have := Dvd.dvd.mul_left hqd p
      rw [Nat.mul_div_cancel' h4] at this
      exact h3 q hq this
    have hinj : Set.InjOn (fun k => k / p) (B : Set ℕ) := by
      intro k hk k' hk' h
      have h' : k / p = k' / p := h
      have h4 := hBdvd k hk
      have h4' := hBdvd k' hk'
      calc k = p * (k / p) := (Nat.mul_div_cancel' h4).symm
        _ = p * (k' / p) := by rw [h']
        _ = k' := Nat.mul_div_cancel' h4'
    have hterm : ∀ k ∈ B, (k : ℝ)⁻¹ = (p : ℝ)⁻¹ * ((k / p : ℕ) : ℝ)⁻¹ := by
      intro k hk
      have h4 := hBdvd k hk
      have hc : (k : ℝ) = (p : ℝ) * ((k / p : ℕ) : ℝ) := by
        exact_mod_cast (Nat.mul_div_cancel' h4).symm
      rw [hc, mul_inv]
    calc ∑ k ∈ B, (k : ℝ)⁻¹ = ∑ k ∈ B, (p : ℝ)⁻¹ * ((k / p : ℕ) : ℝ)⁻¹ :=
          Finset.sum_congr rfl hterm
      _ = (p : ℝ)⁻¹ * ∑ k ∈ B, ((k / p : ℕ) : ℝ)⁻¹ := by rw [Finset.mul_sum]
      _ = (p : ℝ)⁻¹ * ∑ m ∈ B.image (fun k => k / p), (m : ℝ)⁻¹ := by
          rw [Finset.sum_image hinj]
      _ ≤ (p : ℝ)⁻¹ * ∑ m ∈ A, (m : ℝ)⁻¹ := by
          apply mul_le_mul_of_nonneg_left _ (by positivity)
          apply Finset.sum_le_sum_of_subset_of_nonneg
          · intro m hm
            rw [Finset.mem_image] at hm
            obtain ⟨k, hk, rfl⟩ := hm
            exact hmaps k hk
          · intro m _ _
            positivity
  
  have hind : ∀ (s : Finset ℕ), (∀ p ∈ s, p.Prime) →
      (∏ p ∈ s, (1 - (p : ℝ)⁻¹)) * (∑ k ∈ Finset.Icc 1 M, (k : ℝ)⁻¹) ≤
        ∑ k ∈ (Finset.Icc 1 M).filter (fun k => ∀ q ∈ s, ¬ q ∣ k), (k : ℝ)⁻¹ := by
    intro s
    induction s using Finset.induction_on with
    | empty =>
      intro _
      simp
    | insert a s ha ih =>
      intro hs
      have hap : a.Prime := hs a (Finset.mem_insert_self a s)
      have hs' : ∀ p ∈ s, p.Prime := fun p hp => hs p (Finset.mem_insert_of_mem hp)
      have ih' := ih hs'
      have hone := hstep s a hap.pos
      set A := (Finset.Icc 1 M).filter (fun k => ∀ q ∈ s, ¬ q ∣ k) with hA
      have hset : (Finset.Icc 1 M).filter (fun k => ∀ q ∈ insert a s, ¬ q ∣ k) =
          A.filter (fun k => ¬ a ∣ k) := by
        ext k
        simp only [hA, Finset.mem_filter, Finset.forall_mem_insert]
        tauto
      rw [hset, Finset.prod_insert ha]
      have hsplit := Finset.sum_filter_add_sum_filter_not A (fun k => a ∣ k) (fun k => (k : ℝ)⁻¹)
      have ha1 : (a : ℝ)⁻¹ ≤ 1 := inv_le_one_of_one_le₀ (by exact_mod_cast hap.one_lt.le)
      have hnn : 0 ≤ 1 - (a : ℝ)⁻¹ := by linarith
      have hmul := mul_le_mul_of_nonneg_left ih' hnn
      rw [mul_assoc]
      nlinarith
  
  have hcop : (Finset.Icc 1 M).filter (fun k => k.Coprime b) =
      (Finset.Icc 1 M).filter (fun k => ∀ q ∈ b.primeFactors, ¬ q ∣ k) := by
    apply Finset.filter_congr
    intro k _
    constructor
    · intro h q hq hqk
      have hqb : q ∣ b := Nat.dvd_of_mem_primeFactors hq
      have h1 : q = 1 := Nat.eq_one_of_dvd_coprimes h hqk hqb
      exact (Nat.prime_of_mem_primeFactors hq).one_lt.ne' h1
    · intro h
      apply Nat.coprime_of_dvd
      intro r hr hrk hrb
      exact h r (Nat.mem_primeFactors.mpr ⟨hr, hrb, hb.ne'⟩) hrk
  
  have htot : (b.totient : ℝ) / b = ∏ p ∈ b.primeFactors, (1 - (p : ℝ)⁻¹) := by
    have h := Nat.totient_eq_mul_prod_factors b
    have h2 : (b.totient : ℝ) = (b : ℝ) * ∏ p ∈ b.primeFactors, (1 - (p : ℝ)⁻¹) := by
      have := congrArg (fun x : ℚ => (x : ℝ)) h
      push_cast at this
      exact this
    have hb0 : (b : ℝ) ≠ 0 := by positivity
    rw [h2, mul_div_cancel_left₀ _ hb0]
  rw [hcop, htot]
  exact hind _ (fun p hp => Nat.prime_of_mem_primeFactors hp)

theorem twoForm_density_sum_lower_bound : ∀ (b M : ℕ), 0 < b →
    (b.totient : ℝ) / b * (∑ k ∈ Finset.Icc 1 M, (k : ℝ)⁻¹) ≤
      ∑ k ∈ (Finset.Icc 1 M).filter (fun k => k.Coprime b), (k : ℝ)⁻¹ →
    (b.totient : ℝ) / b * (∑ k ∈ Finset.Icc 1 M, (k : ℝ)⁻¹) ^ 2 ≤
      ∑ m ∈ Finset.Icc 1 (M ^ 2),
        ∏ p ∈ m.primeFactors, ((if p ∣ b then 1 else 2 : ℝ) / p) ^ m.factorization p :=
by
  intro b M hb hcop
  
  have s1 : ∀ m : ℕ, 0 < m →
      ((m.divisors.filter (fun d => d.Coprime b)).card : ℝ) ≤
        ∏ p ∈ m.primeFactors, (if p ∣ b then 1 else 2 : ℝ) ^ m.factorization p := by
    intro m hm
    have hm0 : m ≠ 0 := hm.ne'
    let t : ℕ → Finset ℕ := fun p =>
      if p ∣ b then ({0} : Finset ℕ) else Finset.range (m.factorization p + 1)
    have hcard : (m.divisors.filter (fun d => d.Coprime b)).card ≤
        (m.primeFactors.pi t).card := by
      apply Finset.card_le_card_of_injOn
        (fun d => fun p (_ : p ∈ m.primeFactors) => d.factorization p)
      · intro d hd
        obtain ⟨hdm, hcopd⟩ := Finset.mem_filter.mp (Finset.mem_coe.mp hd)
        have hdvd := Nat.dvd_of_mem_divisors hdm
        have hd0 : d ≠ 0 := ne_zero_of_dvd_ne_zero hm0 hdvd
        rw [Finset.mem_coe, Finset.mem_pi]
        intro p hp
        have hpp := Nat.prime_of_mem_primeFactors hp
        simp only [t]
        split_ifs with hpb
        · rw [Finset.mem_singleton]
          apply Nat.factorization_eq_zero_of_not_dvd
          intro hpd
          exact hpp.not_dvd_one (hcopd ▸ Nat.dvd_gcd hpd hpb)
        · rw [Finset.mem_range]
          have := (Nat.factorization_le_iff_dvd hd0 hm0).mpr hdvd p
          omega
      · intro d hd d' hd' heq
        have hd1 := Finset.mem_filter.mp (Finset.mem_coe.mp hd)
        have hd1' := Finset.mem_filter.mp (Finset.mem_coe.mp hd')
        have hdvd := Nat.dvd_of_mem_divisors hd1.1
        have hdvd' := Nat.dvd_of_mem_divisors hd1'.1
        have hd0 : d ≠ 0 := ne_zero_of_dvd_ne_zero hm0 hdvd
        have hd0' : d' ≠ 0 := ne_zero_of_dvd_ne_zero hm0 hdvd'
        apply Nat.eq_of_factorization_eq hd0 hd0'
        intro p
        by_cases hp : p ∈ m.primeFactors
        · exact congrFun (congrFun heq p) hp
        · have hmp : m.factorization p = 0 := by
            rwa [← Nat.support_factorization, Finsupp.mem_support_iff, not_not] at hp
          have h1 := (Nat.factorization_le_iff_dvd hd0 hm0).mpr hdvd p
          have h2 := (Nat.factorization_le_iff_dvd hd0' hm0).mpr hdvd' p
          omega
    rw [Finset.card_pi] at hcard
    calc ((m.divisors.filter (fun d => d.Coprime b)).card : ℝ)
        ≤ ((∏ p ∈ m.primeFactors, (t p).card : ℕ) : ℝ) := by exact_mod_cast hcard
      _ = ∏ p ∈ m.primeFactors, ((t p).card : ℝ) := by push_cast; rfl
      _ ≤ ∏ p ∈ m.primeFactors, (if p ∣ b then 1 else 2 : ℝ) ^ m.factorization p := by
        apply Finset.prod_le_prod
        · intro p _
          positivity
        · intro p _
          simp only [t]
          split_ifs with hpb
          · simp
          · rw [Finset.card_range]
            have h := Nat.succ_le_of_lt (Nat.lt_two_pow_self (n := m.factorization p))
            exact_mod_cast h
  
  have s2 : ∀ m : ℕ, 0 < m →
      ∏ p ∈ m.primeFactors, ((if p ∣ b then 1 else 2 : ℝ) / p) ^ m.factorization p =
        (∏ p ∈ m.primeFactors, (if p ∣ b then 1 else 2 : ℝ) ^ m.factorization p) / m := by
    intro m hm
    have hden : (∏ p ∈ m.primeFactors, (p : ℝ) ^ m.factorization p) = m := by
      have h := Nat.factorization_prod_pow_eq_self hm.ne'
      rw [Finsupp.prod, Nat.support_factorization] at h
      exact_mod_cast h
    simp_rw [div_pow]
    rw [Finset.prod_div_distrib, hden]
  
  let F := Finset.Icc 1 M
  let B := F.filter (fun n => n.Coprime b)
  let P := F ×ˢ B
  let Q : Finset (Σ _ : ℕ, ℕ) :=
    (Finset.Icc 1 (M ^ 2)).sigma (fun n => n.divisors.filter (fun d => d.Coprime b))
  let f : ℕ × ℕ → (Σ _ : ℕ, ℕ) := fun v => ⟨v.1 * v.2, v.2⟩
  have hP (v : ℕ × ℕ) (hv : v ∈ P) :
      0 < v.1 ∧ v.1 ≤ M ∧ 0 < v.2 ∧ v.2 ≤ M ∧ v.2.Coprime b := by
    obtain ⟨hv1, hvB⟩ := Finset.mem_product.mp hv
    obtain ⟨hv2, hc⟩ := Finset.mem_filter.mp hvB
    exact ⟨(Finset.mem_Icc.mp hv1).1, (Finset.mem_Icc.mp hv1).2,
      (Finset.mem_Icc.mp hv2).1, (Finset.mem_Icc.mp hv2).2, hc⟩
  have hsub : P.image f ⊆ Q := by
    intro v hv
    obtain ⟨w, hw, rfl⟩ := Finset.mem_image.mp hv
    obtain ⟨hw1, hwN1, hw2, hwN2, hc⟩ := hP w hw
    apply Finset.mem_sigma.mpr
    refine ⟨Finset.mem_Icc.mpr ⟨Nat.mul_pos hw1 hw2, ?_⟩,
      Finset.mem_filter.mpr ⟨Nat.mem_divisors.mpr ⟨dvd_mul_left _ _, (Nat.mul_pos hw1 hw2).ne'⟩,
        hc⟩⟩
    simpa only [pow_two] using Nat.mul_le_mul hwN1 hwN2
  have hinj : Set.InjOn f (P : Set (ℕ × ℕ)) := by
    intro v hv w hw heq
    have hprod : v.1 * v.2 = w.1 * w.2 := congrArg Sigma.fst heq
    have hsecond : v.2 = w.2 := congrArg (fun x : Σ _ : ℕ, ℕ => x.2) heq
    have hfirst : v.1 = w.1 := by
      rw [hsecond] at hprod
      exact Nat.eq_of_mul_eq_mul_right (hP w hw).2.2.1 hprod
    exact Prod.ext hfirst hsecond
  have hmass : (∑ n ∈ F, (n : ℝ)⁻¹) * (∑ n ∈ B, (n : ℝ)⁻¹) ≤
      ∑ m ∈ Finset.Icc 1 (M ^ 2),
        ∏ p ∈ m.primeFactors, ((if p ∣ b then 1 else 2 : ℝ) / p) ^ m.factorization p := by
    calc
      _ = ∑ v ∈ P, ((v.1 * v.2 : ℕ) : ℝ)⁻¹ := by
        rw [Finset.sum_mul_sum]
        symm
        calc
          _ = ∑ n ∈ F, ∑ m ∈ B, ((n * m : ℕ) : ℝ)⁻¹ :=
            Finset.sum_product F B (fun v : ℕ × ℕ => ((v.1 * v.2 : ℕ) : ℝ)⁻¹)
          _ = _ := by simp only [Nat.cast_mul, mul_inv_rev, mul_comm]
      _ = ∑ v ∈ P.image f, (v.1 : ℝ)⁻¹ :=
        (Finset.sum_image (f := fun v : Σ _ : ℕ, ℕ => (v.1 : ℝ)⁻¹) hinj).symm
      _ ≤ ∑ v ∈ Q, (v.1 : ℝ)⁻¹ := by
        apply Finset.sum_le_sum_of_subset_of_nonneg hsub
        intro v _ _
        positivity
      _ = ∑ n ∈ Finset.Icc 1 (M ^ 2),
          ((n.divisors.filter (fun d => d.Coprime b)).card : ℝ) / n := by
        calc
          _ = ∑ n ∈ Finset.Icc 1 (M ^ 2), ∑ d ∈ n.divisors.filter (fun d => d.Coprime b),
              (n : ℝ)⁻¹ := Finset.sum_sigma _ _ (fun v : Σ _ : ℕ, ℕ => (v.1 : ℝ)⁻¹)
          _ = _ := by simp only [Finset.sum_const, nsmul_eq_mul, div_eq_mul_inv]
      _ ≤ _ := by
        apply Finset.sum_le_sum
        intro n hn
        have hn0 : 0 < n := (Finset.mem_Icc.mp hn).1
        rw [s2 n hn0]
        exact div_le_div_of_nonneg_right (s1 n hn0) (Nat.cast_nonneg n)
  have hHN : 0 ≤ ∑ n ∈ F, (n : ℝ)⁻¹ := Finset.sum_nonneg fun _ _ => by positivity
  have hcop' := mul_le_mul_of_nonneg_left hcop hHN
  have hstart : (b.totient : ℝ) / b * (∑ n ∈ F, (n : ℝ)⁻¹) ^ 2 ≤
      (∑ n ∈ F, (n : ℝ)⁻¹) * (∑ n ∈ B, (n : ℝ)⁻¹) := by
    calc
      _ = (∑ n ∈ F, (n : ℝ)⁻¹) * ((b.totient : ℝ) / b * (∑ n ∈ F, (n : ℝ)⁻¹)) := by ring
      _ ≤ _ := hcop'
  exact hstart.trans hmass

theorem sum_pow_omega_divisors_le : ∀ (P k : ℕ) (x : ℝ), 1 ≤ x → Squarefree P →
    (∑ d ∈ P.divisors, if (d : ℝ) ≤ x then (k : ℝ) ^ ArithmeticFunction.cardDistinctFactors d else 0) ≤
      x * (1 + Real.log x) ^ k :=
by
  intro P k x hx hP
  have hx_pos : 0 < x := by linarith
  
  have hH : (∑ d ∈ P.divisors, if (d : ℝ) ≤ x then (d : ℝ)⁻¹ else 0) ≤ 1 + Real.log x := by
    rw [← Finset.sum_filter]
    have hn1 : 1 ≤ ⌊x⌋₊ := (Nat.one_le_floor_iff _).mpr hx
    calc (∑ d ∈ P.divisors.filter (fun d : ℕ => (d : ℝ) ≤ x), (d : ℝ)⁻¹)
        ≤ ∑ d ∈ Finset.Icc 1 ⌊x⌋₊, (d : ℝ)⁻¹ := by
          apply Finset.sum_le_sum_of_subset_of_nonneg
          · intro d hd
            rw [Finset.mem_filter] at hd
            rw [Finset.mem_Icc]
            exact ⟨Nat.pos_of_mem_divisors hd.1, (Nat.le_floor_iff hx_pos.le).mpr hd.2⟩
          · intro i _ _; positivity
      _ = ((harmonic ⌊x⌋₊ : ℚ) : ℝ) := by
          rw [harmonic_eq_sum_Icc]; push_cast; rfl
      _ ≤ 1 + Real.log (⌊x⌋₊ : ℝ) := harmonic_le_one_add_log _
      _ ≤ 1 + Real.log x := by
          linarith [Real.log_le_log (Nat.cast_pos.mpr hn1) (Nat.floor_le hx_pos.le)]
  have hH0 : 0 ≤ (∑ d ∈ P.divisors, if (d : ℝ) ≤ x then (d : ℝ)⁻¹ else 0) := by
    apply Finset.sum_nonneg
    intro d _
    split_ifs
    · positivity
    · exact le_refl 0
  
  have hT : (∑ d ∈ P.divisors, if (d : ℝ) ≤ x then
      (k : ℝ) ^ ArithmeticFunction.cardDistinctFactors d / (d : ℝ) else 0) ≤
      (∑ d ∈ P.divisors, if (d : ℝ) ≤ x then (d : ℝ)⁻¹ else 0) ^ k := by
    calc
      _ = ∑ d ∈ P.divisors,
            ∑ a ∈ Fintype.piFinset fun _i : Fin k => P.divisors,
              if ∏ idx, a idx = d ∧ d ∣ P then if (d : ℝ) ≤ x then (d : ℝ)⁻¹ else 0 else 0 := ?_
      _ = ∑ a ∈ Fintype.piFinset fun _i : Fin k => P.divisors,
            if ∏ idx, a idx ∣ P then
              if ((∏ idx, a idx : ℕ) : ℝ) ≤ x then ∏ idx, (a idx : ℝ)⁻¹ else 0 else 0 := ?_
      _ ≤ ∑ a ∈ Fintype.piFinset fun _i : Fin k => P.divisors,
            if ((∏ idx, a idx : ℕ) : ℝ) ≤ x then ∏ idx, (a idx : ℝ)⁻¹ else 0 := ?_
      _ ≤ ∑ a ∈ Fintype.piFinset fun _i : Fin k => P.divisors,
            ∏ idx, if ((a idx : ℕ) : ℝ) ≤ x then (a idx : ℝ)⁻¹ else 0 := ?_
      _ = ∏ _i : Fin k, ∑ d ∈ P.divisors, if (d : ℝ) ≤ x then (d : ℝ)⁻¹ else 0 := by
          rw [Finset.prod_univ_sum]
      _ = (∑ d ∈ P.divisors, if (d : ℝ) ≤ x then (d : ℝ)⁻¹ else 0) ^ k := by
          rw [Finset.prod_const, Finset.card_fin]
    · apply Finset.sum_congr rfl; intro d hd
      rw [Nat.mem_divisors] at hd
      simp_rw [ite_and]
      rw [← Finset.sum_filter, Finset.sum_const,
        ← Nat.finMulAntidiag_eq_piFinset_divisors_filter hd.1 hd.2,
        Nat.card_finMulAntidiag_of_squarefree (hP.squarefree_of_dvd hd.1), if_pos hd.1]
      simp only [div_eq_mul_inv, nsmul_eq_mul, Nat.cast_pow, mul_ite, mul_zero]
    · rw [Finset.sum_comm]; apply Finset.sum_congr rfl; intro a _
      rw [Finset.sum_eq_single (∏ idx, a idx)]
      · apply if_ctx_congr _ _ (fun _ => rfl)
        · rw [Iff.comm, iff_and_self]; exact fun _ => rfl
        · intro; rw [Nat.cast_prod, ← Finset.prod_inv_distrib]
      · exact fun d _ hd_ne ↦ if_neg fun h => hd_ne.symm h.1
      · exact fun h ↦ if_neg fun h' => h (Nat.mem_divisors.mpr ⟨h'.2, hP.ne_zero⟩)
    · apply Finset.sum_le_sum; intro a _
      by_cases h : (∏ idx, a idx ∣ P)
      · rw [if_pos h]
      rw [if_neg h]
      split_ifs with h'
      · apply Finset.prod_nonneg; intro idx _; positivity
      · exact le_refl 0
    · apply Finset.sum_le_sum; intro a ha
      split_ifs with h
      · apply le_of_eq
        apply Finset.prod_congr rfl
        intro idx hi
        rw [if_pos]
        apply le_trans _ h
        norm_cast
        rw [← Finset.prod_erase_mul (a := idx) (h := hi)]
        apply Nat.le_mul_of_pos_left
        rw [Fintype.mem_piFinset] at ha
        apply Finset.prod_pos; intro j _; exact Nat.pos_of_mem_divisors (ha j)
      · apply Finset.prod_nonneg; intro j _
        split_ifs
        · positivity
        · exact le_refl 0
  
  calc (∑ d ∈ P.divisors, if (d : ℝ) ≤ x then (k : ℝ) ^ ArithmeticFunction.cardDistinctFactors d else 0)
      ≤ ∑ d ∈ P.divisors, x * (if (d : ℝ) ≤ x then
          (k : ℝ) ^ ArithmeticFunction.cardDistinctFactors d / (d : ℝ) else 0) := by
        apply Finset.sum_le_sum
        intro d hd
        have hd0 : (0 : ℝ) < d := Nat.cast_pos.mpr (Nat.pos_of_mem_divisors hd)
        split_ifs with h
        · have hk0 : (0 : ℝ) ≤ (k : ℝ) ^ ArithmeticFunction.cardDistinctFactors d := by positivity
          rw [mul_div_assoc']
          rw [le_div_iff₀ hd0]
          rw [mul_comm]
          exact mul_le_mul_of_nonneg_right h hk0
        · simp
    _ = x * ∑ d ∈ P.divisors, (if (d : ℝ) ≤ x then
          (k : ℝ) ^ ArithmeticFunction.cardDistinctFactors d / (d : ℝ) else 0) := by
        rw [Finset.mul_sum]
    _ ≤ x * (∑ d ∈ P.divisors, if (d : ℝ) ≤ x then (d : ℝ)⁻¹ else 0) ^ k :=
        mul_le_mul_of_nonneg_left hT hx_pos.le
    _ ≤ x * (1 + Real.log x) ^ k :=
        mul_le_mul_of_nonneg_left (pow_le_pow_left₀ hH0 hH k) hx_pos.le

theorem twoForm_count_error : ∀ (b N d : ℕ), Squarefree d →
    |(((Finset.range N).filter (fun n => d ∣ n * (b * n + 1))).card : ℝ) -
        (∏ p ∈ d.primeFactors, (if p ∣ b then 1 else 2 : ℝ) / p) * N| ≤
      (2 : ℝ) ^ ArithmeticFunction.cardDistinctFactors d :=
by
  intro b N d hd
  have hd0 : 0 < d := Nat.pos_of_ne_zero hd.ne_zero
  
  have hdiv : ∀ (k x : ℕ), k ∣ x * (b * x + 1) ↔
      (x : ZMod k) * ((b : ZMod k) * (x : ZMod k) + 1) = 0 := by
    intro k x
    rw [← ZMod.natCast_eq_zero_iff]
    simp only [Nat.cast_mul, Nat.cast_add, Nat.cast_one]
  
  have hzmod : ∀ (k : ℕ) [NeZero k],
      ((Finset.range k).filter (fun x => k ∣ x * (b * x + 1))).card =
        ((Finset.univ : Finset (ZMod k)).filter
          (fun t => t * ((b : ZMod k) * t + 1) = 0)).card := by
    intro k _
    have heq : ((Finset.univ : Finset (ZMod k)).filter
        (fun t => t * ((b : ZMod k) * t + 1) = 0)).image ZMod.val =
        (Finset.range k).filter (fun x => k ∣ x * (b * x + 1)) := by
      ext n
      constructor
      · intro hn
        obtain ⟨t, ht, rfl⟩ := Finset.mem_image.mp hn
        apply Finset.mem_filter.mpr
        refine ⟨Finset.mem_range.mpr (ZMod.val_lt t), ?_⟩
        apply (hdiv k t.val).mpr
        simpa only [ZMod.natCast_zmod_val] using (Finset.mem_filter.mp ht).2
      · intro hn
        obtain ⟨hnlt, hn⟩ := Finset.mem_filter.mp hn
        refine Finset.mem_image.mpr ⟨(n : ZMod k), ?_, ?_⟩
        · exact Finset.mem_filter.mpr ⟨Finset.mem_univ _, (hdiv k n).mp hn⟩
        · exact ZMod.val_natCast_of_lt (Finset.mem_range.mp hnlt)
    rw [← heq, Finset.card_image_of_injective _ (ZMod.val_injective k)]
  
  have hprime : ∀ p : ℕ, p.Prime →
      ((Finset.range p).filter (fun x => p ∣ x * (b * x + 1))).card =
        if p ∣ b then 1 else 2 := by
    intro p hp
    haveI : Fact p.Prime := ⟨hp⟩
    rw [hzmod p]
    by_cases hpb : p ∣ b
    · have hb : (b : ZMod p) = 0 := (ZMod.natCast_eq_zero_iff b p).mpr hpb
      have hset : (Finset.univ : Finset (ZMod p)).filter
          (fun t => t * ((b : ZMod p) * t + 1) = 0) = {0} := by
        ext t
        simp [hb]
      rw [hset, Finset.card_singleton, if_pos hpb]
    · have hb : (b : ZMod p) ≠ 0 := fun h => hpb ((ZMod.natCast_eq_zero_iff b p).mp h)
      have hset : (Finset.univ : Finset (ZMod p)).filter
          (fun t => t * ((b : ZMod p) * t + 1) = 0) = {0, -(b : ZMod p)⁻¹} := by
        ext t
        simp only [Finset.mem_filter, Finset.mem_univ, true_and, Finset.mem_insert,
          Finset.mem_singleton, mul_eq_zero]
        apply or_congr_right
        constructor
        · intro h
          apply mul_left_cancel₀ hb
          calc (b : ZMod p) * t = -1 := eq_neg_of_add_eq_zero_left h
            _ = (b : ZMod p) * -(b : ZMod p)⁻¹ := by simp [hb]
        · rintro rfl
          simp [hb]
      have hneq : (0 : ZMod p) ≠ -(b : ZMod p)⁻¹ :=
        fun h => inv_ne_zero hb (neg_eq_zero.mp h.symm)
      rw [hset, Finset.card_pair hneq, if_neg hpb]
  
  have hcardk : ∀ (k : ℕ) [NeZero k],
      Nat.card {t : ZMod k // t * ((b : ZMod k) * t + 1) = 0} =
        ((Finset.range k).filter (fun x => k ∣ x * (b * x + 1))).card := by
    intro k _
    rw [Nat.card_eq_fintype_card, Fintype.card_subtype, hzmod]
  have hmul : ∀ m n : ℕ, 0 < m → 0 < n → m.Coprime n →
      ((Finset.range (m * n)).filter (fun x => m * n ∣ x * (b * x + 1))).card =
        ((Finset.range m).filter (fun x => m ∣ x * (b * x + 1))).card *
          ((Finset.range n).filter (fun x => n ∣ x * (b * x + 1))).card := by
    intro m n hm hn hcop
    haveI : NeZero m := ⟨hm.ne'⟩
    haveI : NeZero n := ⟨hn.ne'⟩
    haveI : NeZero (m * n) := ⟨(Nat.mul_pos hm hn).ne'⟩
    let e := ZMod.chineseRemainder hcop
    have hmap : ∀ t : ZMod (m * n), t * ((b : ZMod (m * n)) * t + 1) = 0 ↔
        (e t).1 * ((b : ZMod m) * (e t).1 + 1) = 0 ∧
        (e t).2 * ((b : ZMod n) * (e t).2 + 1) = 0 := by
      intro t
      constructor
      · intro ht
        have h := congrArg e ht
        simp only [map_mul, map_add, map_natCast, map_one, map_zero] at h
        exact ⟨congrArg (fun x : ZMod m × ZMod n => x.1) h,
          congrArg (fun x : ZMod m × ZMod n => x.2) h⟩
      · rintro ⟨h1, h2⟩
        apply e.injective
        simp only [map_mul, map_add, map_natCast, map_one, map_zero]
        exact Prod.ext h1 h2
    let E : {t : ZMod (m * n) // t * ((b : ZMod (m * n)) * t + 1) = 0} ≃
        {t : ZMod m // t * ((b : ZMod m) * t + 1) = 0} ×
        {t : ZMod n // t * ((b : ZMod n) * t + 1) = 0} :=
      (e.toEquiv.subtypeEquiv hmap).trans
        (Equiv.subtypeProdEquivProd (p := fun t : ZMod m => t * ((b : ZMod m) * t + 1) = 0)
          (q := fun t : ZMod n => t * ((b : ZMod n) * t + 1) = 0))
    rw [← hcardk (m * n), ← hcardk m, ← hcardk n, ← Nat.card_prod]
    exact Nat.card_congr E
  
  let ρ : ArithmeticFunction ℕ :=
    ⟨fun k => ((Finset.range k).filter (fun x => k ∣ x * (b * x + 1))).card, by simp⟩
  have hρ : ∀ k, ρ k = ((Finset.range k).filter (fun x => k ∣ x * (b * x + 1))).card :=
    fun k => rfl
  have hρmult : ρ.IsMultiplicative := by
    refine ⟨?_, ?_⟩
    · rw [hρ]
      simp
    · intro m n hcop
      rw [hρ, hρ, hρ]
      rcases Nat.eq_zero_or_pos m with rfl | hm
      · simp
      rcases Nat.eq_zero_or_pos n with rfl | hn
      · simp
      exact hmul m n hm hn hcop
  have hρd : ((Finset.range d).filter (fun x => d ∣ x * (b * x + 1))).card =
      ∏ p ∈ d.primeFactors, (if p ∣ b then 1 else 2 : ℕ) := by
    rw [← hρ d, ← hρmult.prod_primeFactors hd]
    exact Finset.prod_congr rfl (fun p hp => hprime p (Nat.prime_of_mem_primeFactors hp))
  have hdc : (d : ℝ) = ∏ p ∈ d.primeFactors, (p : ℝ) := by
    rw [← Nat.cast_prod, Nat.prod_primeFactors_of_squarefree hd]
  have hcoef : (((Finset.range d).filter (fun x => d ∣ x * (b * x + 1))).card : ℝ) / d =
      ∏ p ∈ d.primeFactors, (if p ∣ b then 1 else 2 : ℝ) / p := by
    rw [Finset.prod_div_distrib, hρd, hdc]
    push_cast
    rfl
  have hle : (((Finset.range d).filter (fun x => d ∣ x * (b * x + 1))).card : ℝ) ≤
      (2 : ℝ) ^ ArithmeticFunction.cardDistinctFactors d := by
    have h1 : ((Finset.range d).filter (fun x => d ∣ x * (b * x + 1))).card ≤
        2 ^ ArithmeticFunction.cardDistinctFactors d := by
      rw [hρd]
      have hcard : d.primeFactors.card = ArithmeticFunction.cardDistinctFactors d := by
        rw [ArithmeticFunction.cardDistinctFactors_apply, ← Nat.toFinset_factors,
          List.card_toFinset]
      rw [← hcard]
      apply Finset.prod_le_pow_card
      intro p _
      split_ifs <;> omega
    exact_mod_cast h1
  
  have hcount_err : ∀ (P : ℕ → Prop) [DecidablePred P], Function.Periodic P d → ∀ M : ℕ,
      |(Nat.count P M : ℝ) - (Nat.count P d : ℝ) / d * M| ≤ Nat.count P d := by
    intro P _ hP M
    have hmulc : ∀ k : ℕ, Nat.count P (k * d) = k * Nat.count P d := by
      intro k
      induction k with
      | zero => simp
      | succ k ih =>
        have hshift : (fun n => P (n + k * d)) = P := funext (hP.nat_mul k)
        simp only [Nat.succ_mul, Nat.add_comm (k * d) d, Nat.count_add', hshift, ih]
        omega
    have hdm : Nat.count P M = (M / d) * Nat.count P d + Nat.count P (M % d) := by
      have hshift : (fun n => P (n + (M / d) * d)) = P := funext (hP.nat_mul (M / d))
      calc
        _ = Nat.count P (M % d + (M / d) * d) := by rw [Nat.mod_add_div']
        _ = _ := by simp only [Nat.count_add', hshift, hmulc]; omega
    have hdR : (0 : ℝ) < d := by exact_mod_cast hd0
    have hrem : (M % d : ℕ) ≤ d := (Nat.mod_lt M hd0).le
    have hremR : ((M % d : ℕ) : ℝ) ≤ d := by exact_mod_cast hrem
    have hcount : (Nat.count P (M % d) : ℝ) ≤ Nat.count P d := by
      exact_mod_cast Nat.count_monotone P hrem
    have hterm : 0 ≤ (Nat.count P d : ℝ) / d * (M % d : ℕ) := by positivity
    have htermle : (Nat.count P d : ℝ) / d * (M % d : ℕ) ≤ Nat.count P d := by
      calc
        _ ≤ (Nat.count P d : ℝ) / d * d :=
          mul_le_mul_of_nonneg_left hremR (by positivity)
        _ = _ := div_mul_cancel₀ _ hdR.ne'
    have hN : (M : ℝ) = (M / d : ℕ) * (d : ℝ) + (M % d : ℕ) := by
      exact_mod_cast (by simpa only [Nat.mul_comm] using (Nat.div_add_mod M d).symm)
    have hdec : (Nat.count P M : ℝ) =
        (M / d : ℕ) * (Nat.count P d : ℝ) + (Nat.count P (M % d) : ℝ) := by
      exact_mod_cast hdm
    have heq : (Nat.count P M : ℝ) - (Nat.count P d : ℝ) / d * M =
        (Nat.count P (M % d) : ℝ) - (Nat.count P d : ℝ) / d * (M % d : ℕ) := by
      rw [hdec, hN]
      field_simp
      ring
    rw [heq, abs_le]
    constructor <;> linarith [Nat.cast_nonneg (Nat.count P (M % d)) (α := ℝ)]
  have hper : Function.Periodic (fun n => d ∣ n * (b * n + 1)) d := by
    intro n
    apply propext
    show d ∣ (n + d) * (b * (n + d) + 1) ↔ d ∣ n * (b * n + 1)
    have h : (n + d) * (b * (n + d) + 1) = d * (2 * b * n + b * d + 1) + n * (b * n + 1) := by
      ring
    rw [h]
    exact Nat.dvd_add_right (dvd_mul_right d _)
  have herr := hcount_err (fun n => d ∣ n * (b * n + 1)) hper N
  simp only [Nat.count_eq_card_filter_range] at herr
  rw [hcoef] at herr
  exact herr.trans hle

theorem twoForm_sifted_count_of_ingredients : (∀ s : SelbergSieve,
      BoundingSieve.siftedSum (s := s.toBoundingSieve) ≤
        s.totalMass / (∑ l ∈ s.prodPrimes.divisors,
            if (l : ℝ) ^ 2 ≤ s.level then s.nu l * ∏ p ∈ l.primeFactors, 1 / (1 - s.nu p) else 0) +
          ∑ d ∈ s.prodPrimes.divisors,
            if (d : ℝ) ≤ s.level then
              (3 : ℝ) ^ ArithmeticFunction.cardDistinctFactors d *
                |BoundingSieve.rem (s := s.toBoundingSieve) d|
            else 0) →
    (∀ (g : ℕ → ℝ) (P : ℕ) (y : ℝ), 1 ≤ y → Squarefree P →
      (∀ p : ℕ, p.Prime → (p : ℝ) ≤ y → p ∣ P) →
      (∀ p : ℕ, p.Prime → 0 ≤ g p ∧ g p < 1) →
      (∑ m ∈ Finset.Icc 1 ⌊Real.sqrt y⌋₊, ∏ p ∈ m.primeFactors, g p ^ m.factorization p) ≤
        ∑ l ∈ P.divisors, if (l : ℝ) ^ 2 ≤ y then ∏ p ∈ l.primeFactors, g p / (1 - g p) else 0) →
    (∀ (b M : ℕ), 0 < b →
      (b.totient : ℝ) / b * (∑ k ∈ Finset.Icc 1 M, (k : ℝ)⁻¹) ≤
        ∑ k ∈ (Finset.Icc 1 M).filter (fun k => k.Coprime b), (k : ℝ)⁻¹) →
    (∀ (b M : ℕ), 0 < b →
      (b.totient : ℝ) / b * (∑ k ∈ Finset.Icc 1 M, (k : ℝ)⁻¹) ≤
        ∑ k ∈ (Finset.Icc 1 M).filter (fun k => k.Coprime b), (k : ℝ)⁻¹ →
      (b.totient : ℝ) / b * (∑ k ∈ Finset.Icc 1 M, (k : ℝ)⁻¹) ^ 2 ≤
