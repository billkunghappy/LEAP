      have hlogu : Real.log u ≤ u / 2 := by
        have := Real.log_le_log hupos hexp
        rwa [Real.log_exp] at this
      nlinarith
    have hf : Tendsto (fun t : ℝ => 2 * FordAnalysis.C * (Real.log t - Real.log (Real.log t)))
        atTop atTop := Filter.tendsto_atTop_mono' atTop hle hlin
    have hN : Tendsto (fun t : ℝ => FordScale.optimalDimension t) atTop atTop :=
      tendsto_nat_floor_atTop.comp hf
    exact (tendsto_sub_atTop_nat M).comp hN
  refine ⟨2 * (3 + Real.exp 80) * 22, by positivity, ?_⟩
  obtain ⟨L₀, hL₀⟩ := Filter.eventually_atTop.mp
    (modelVolume_eventually_le_T hPNT hMERT hEULER hRHO)
  have hREN := ford_renewal_scaled_bounds hRHO
  refine Filter.Eventually.of_forall (fun M => ?_)
  filter_upwards [(hdimT M).eventually_ge_atTop L₀, eventually_ge_atTop (Real.exp 1)] with t hLt ht
  have he1 : (1 : ℝ) ≤ Real.exp 1 := by
    have := Real.add_one_le_exp (1 : ℝ); linarith
  have ht1 : (1 : ℝ) ≤ t := he1.trans ht
  have htpos : (0 : ℝ) < t := by linarith
  have hτ : (0 : ℝ) ≤ 1 / t := by positivity
  have hτ1 : 1 / t ≤ (1 : ℝ) := by
