            exact_mod_cast (Finset.mem_filter.mp (Finset.mem_sdiff.mp hp).1).2.two_le
          have : (1 : ℝ) / p ≤ 1 / 2 := by
            rw [div_le_div_iff₀ (by linarith) (by norm_num)]; linarith
          linarith
