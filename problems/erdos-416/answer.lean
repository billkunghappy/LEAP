      apply max_le
      · have hM1 : 1 ≤ max 1 c * (t₀ * (10 / 9 : ℝ) ^ (n + 1)) ^ 2 := by nlinarith
        have hGC : C₀ ≤ C₀ * (max 1 c * t₀ ^ 2) ^ n * (10 / 9 : ℝ) ^ (n * (n + 1)) := by
          have h1 : C₀ ≤ C₀ * (max 1 c * t₀ ^ 2) ^ n := le_mul_of_one_le_right (by linarith) hDn
          have h2 : C₀ * (max 1 c * t₀ ^ 2) ^ n ≤
              C₀ * (max 1 c * t₀ ^ 2) ^ n * (10 / 9 : ℝ) ^ (n * (n + 1)) :=
            le_mul_of_one_le_right (by linarith) hqn
          linarith
        have hMG := le_mul_of_one_le_left (show (0 : ℝ) ≤
          C₀ * (max 1 c * t₀ ^ 2) ^ n * (10 / 9 : ℝ) ^ (n * (n + 1)) by linarith) hM1
        linarith
      · apply mul_le_mul_of_nonneg_right _ (by linarith)
        exact mul_le_mul_of_nonneg_right (le_max_right _ _) (by positivity)
  
  have s5 : ∀ (C₀ D : ℝ), 1 ≤ C₀ → 1 ≤ D →
      ∃ B : ℝ, 0 < B ∧ ∀ ℓ : ℝ, Real.exp 1 ≤ ℓ → ∃ n : ℕ, ℓ ≤ (10 / 9 : ℝ) ^ n ∧
        C₀ * D ^ n * (10 / 9 : ℝ) ^ (n * (n + 1)) ≤ Real.exp (B * Real.log ℓ ^ 2) := by
    intro C₀ D hC₀ hD
    have hr0 : 1 / 10 ≤ Real.log (10 / 9 : ℝ) := by
      have := Real.one_sub_inv_le_log_of_pos (show (0 : ℝ) < 10 / 9 by norm_num)
