      exact hnE₁ (Finset.mem_filter.mpr ⟨hnF1, q, hq, hH, Or.inl hdiv⟩)
    · intro q hq hH hdiv
      exact hnE₁ (Finset.mem_filter.mpr ⟨hnF1, q, hq, hH, Or.inr hdiv⟩)
  
  have hcover : F ⊆ ((E₀ ∪ E₁) ∪ E₂) ∪ G := by
    intro n hn
    by_cases h₀ : n ∈ E₀
    · exact Finset.mem_union_left _ (Finset.mem_union_left _ (Finset.mem_union_left _ h₀))
    by_cases h₁ : n ∈ E₁
    · exact Finset.mem_union_left _ (Finset.mem_union_left _ (Finset.mem_union_right _ h₁))
    by_cases h₂ : n ∈ E₂
    · exact Finset.mem_union_left _ (Finset.mem_union_right _ h₂)
    exact Finset.mem_union_right _ (Finset.mem_sdiff.mpr ⟨Finset.mem_sdiff.mpr ⟨hn, h₀⟩,
      fun h => (Finset.mem_union.mp h).elim h₁ h₂⟩)
  have hcard : F.card ≤ E₀.card + E₁.card + E₂.card + G.card := by
    calc
      F.card ≤ (((E₀ ∪ E₁) ∪ E₂) ∪ G).card := Finset.card_le_card hcover
      _ ≤ ((E₀ ∪ E₁) ∪ E₂).card + G.card := Finset.card_union_le _ _
      _ ≤ (E₀ ∪ E₁).card + E₂.card + G.card := by gcongr; exact Finset.card_union_le _ _
      _ ≤ E₀.card + E₁.card + E₂.card + G.card := by gcongr; exact Finset.card_union_le _ _
  have hcardR : (F.card : ℝ) ≤ E₀.card + E₁.card + E₂.card + G.card := by exact_mod_cast hcard
  exact hcardR.trans (add_le_add (add_le_add (add_le_add hzero hone) htwo) hG)

theorem powerRawPairs_collisions_le_tail_sum {Y P : ℝ} {L R : ℕ}
    (S : CoreRecords.CoreSelection Y L R P) (B : ℝ) (hY : 0 ≤ Y)
    (htop : ∀ bp ∈ CoreRecords.powerRawPairs S, ∀ hb : bp.1 ∈ S.cores,
      Y ^ (9 / 10 : ℝ) < (bp.2 : ℝ) ∧
        (S.record ⟨bp.1, hb⟩).lower ⟨0, (S.record ⟨bp.1, hb⟩).length_pos⟩ < bp.2)
    (hcount : ∀ r ∈ Finset.Icc 1 R, ∀ (G : Finset ℕ) (p : ℕ → Fin (L + 1) → ℕ),
      (∀ n ∈ G, Rigidity.Tuple Y P (6 / 5) (4 / 5) r n (p n)) →
      (∀ n ∈ G, ∀ m ∈ G,
        (∏ idx : Fin L, (p n idx.succ - 1)) = (∏ idx : Fin L, (p m idx.succ - 1)) →
          ∀ idx : Fin L, p n idx.succ = p m idx.succ) →
      (∀ n ∈ G, ∃ N : ℕ, 0 < N ∧ N.totient = r.totient * n.totient ∧
        largestPrimeFactor N ≠ p n 0) →
      (G.card : ℝ) ≤ B) :
    ((collisionPoints (CoreRecords.powerRawPairs S) corePairValue).card : ℝ) ≤ (R : ℝ) * B :=
by
  classical
  
  have lpf_ge : ∀ {n q : ℕ}, 0 < n → q.Prime → q ∣ n → q ≤ largestPrimeFactor n := by
    intro n q hn hq hqn
    exact (Finset.le_sup (f := id) (hq.mem_primeFactors hqn (Nat.ne_of_gt hn))).trans
      (le_max_right _ _)
  have lpf_lt : ∀ {n p : ℕ}, 1 < p → (∀ q, q.Prime → q ∣ n → q < p) →
      largestPrimeFactor n < p := by
    intro n p hp h
    unfold largestPrimeFactor
    apply max_lt hp
    exact (Finset.sup_lt_iff (show (⊥ : ℕ) < p from by show 0 < p; omega)).mpr
      (fun q hq => h q (Nat.prime_of_mem_primeFactors hq) (Nat.dvd_of_mem_primeFactors hq))
  have coprime_of_lt : ∀ {n p : ℕ}, 0 < n → p.Prime → largestPrimeFactor n < p →
      p.Coprime n := by
    intro n p hn hp h
    rw [hp.coprime_iff_not_dvd]
    intro hdvd
    exact (not_le_of_gt h) (lpf_ge hn hp hdvd)
  have top_ext : ∀ {a p : ℕ}, 0 < a → p.Prime → largestPrimeFactor a < p →
      (p * a).totient = (p - 1) * a.totient ∧ largestPrimeFactor (p * a) = p := by
    intro a p ha hp h
    refine ⟨by rw [Nat.totient_mul (coprime_of_lt ha hp h), Nat.totient_prime hp], ?_⟩
    apply le_antisymm
    · have : largestPrimeFactor (p * a) < p + 1 := by
        apply lpf_lt (by have := hp.one_lt; omega)
        intro q hq hqd
        rcases (Nat.Prime.dvd_mul hq).mp hqd with h1 | h1
        · exact Nat.lt_succ_of_le (Nat.le_of_dvd hp.pos h1)
        · have := (lpf_ge ha hq h1).trans_lt h
          omega
      omega
    · exact lpf_ge (Nat.mul_pos hp.pos ha) hp (dvd_mul_right p a)
  have totient_primes : ∀ s : Finset ℕ, (∀ p ∈ s, p.Prime) →
      (∏ p ∈ s, p).totient = ∏ p ∈ s, (p - 1) := by
    intro s
    induction s using Finset.induction with
    | empty => intro _; simp
    | @insert p s hps ih =>
      intro hs
      have hp : p.Prime := hs p (Finset.mem_insert_self _ _)
      have hs' : ∀ q ∈ s, q.Prime := fun q hq => hs q (Finset.mem_insert_of_mem hq)
      have hcop : p.Coprime (∏ q ∈ s, q) := by
        apply Nat.coprime_prod_right_iff.mpr
        intro q hq
        rw [hp.coprime_iff_not_dvd]
        intro hdvd
        have heq : p = q := (Nat.prime_dvd_prime_iff_eq hp (hs' q hq)).mp hdvd
        exact hps (heq.symm ▸ hq)
      rw [Finset.prod_insert hps, Nat.totient_mul hcop, Nat.totient_prime hp,
        ih hs', Finset.prod_insert hps]
  have totient_inj : ∀ (s : Finset (Fin L)) (f : Fin L → ℕ), (∀ i ∈ s, (f i).Prime) →
      Set.InjOn f s → (∏ i ∈ s, f i).totient = ∏ i ∈ s, (f i - 1) := by
    intro s f hp hinj
    have hprime : ∀ q ∈ s.image f, q.Prime := by
      intro q hq
      obtain ⟨i, hi, rfl⟩ := Finset.mem_image.mp hq
      exact hp i hi
    have h := totient_primes (s.image f) hprime
    rw [Finset.prod_image hinj, Finset.prod_image hinj] at h
    exact h
  
  have hrec : ∀ (Q : CoreRecords.LowerCoreRecord Y L R P) (p : ℕ), p.Prime →
      Q.lower ⟨0, Q.length_pos⟩ < p →
      Q.tail.totient * (p * ∏ idx, Q.lower idx).totient = (p - 1) * Q.numericalCore ∧
      largestPrimeFactor (p * ∏ idx, Q.lower idx) = p ∧
      0 < p * Q.integer ∧
      (p * Q.integer).totient = (p - 1) * Q.numericalCore ∧
      largestPrimeFactor (p * Q.integer) = p := by
    intro Q p hp hsep
    have hlow : ∀ idx, Q.lower idx ≤ Q.lower ⟨0, Q.length_pos⟩ := fun idx =>
      Q.order.antitone (show (⟨0, Q.length_pos⟩ : Fin L) ≤ idx from Nat.zero_le _)
    have hhigh : ∀ idx, largestPrimeFactor Q.tail < Q.lower idx := fun idx =>
      (le_max_right _ _).trans_lt (Q.last_lower.trans_le (Q.order.antitone
        (show idx ≤ ⟨L - 1, by have := Q.length_pos; omega⟩ from by
          change idx.val ≤ L - 1
          have := idx.isLt
          omega)))
    have hMpos : 0 < ∏ idx, Q.lower idx := Finset.prod_pos fun idx _ => (Q.prime idx).pos
    have hMdiv : ∀ q, q.Prime → q ∣ ∏ idx, Q.lower idx → q < p := by
      intro q hq hqd
      obtain ⟨idx, _, hidx⟩ := (Prime.dvd_finset_prod_iff hq.prime _).mp hqd
      have := (Nat.prime_dvd_prime_iff_eq hq (Q.prime idx)).mp hidx
      rw [this]
      exact (hlow idx).trans_lt hsep
    have hIdiv : ∀ q, q.Prime → q ∣ Q.integer → q < p := by
      intro q hq hqd
      unfold CoreRecords.LowerCoreRecord.integer at hqd
      rcases (Nat.Prime.dvd_mul hq).mp hqd with h | h
      · exact ((lpf_ge Q.tail_pos hq h).trans_lt (hhigh ⟨0, Q.length_pos⟩)).trans hsep
      · exact hMdiv q hq h
    have hIpos : 0 < Q.integer := Nat.mul_pos Q.tail_pos hMpos
    have hMtot : (∏ idx, Q.lower idx).totient = ∏ idx, (Q.lower idx - 1) :=
      totient_inj Finset.univ Q.lower (fun idx _ => Q.prime idx) Q.order.injective.injOn
    have hcopTM : Nat.Coprime Q.tail (∏ idx, Q.lower idx) := by
      apply Nat.coprime_prod_right_iff.mpr
      intro idx _
      exact (coprime_of_lt Q.tail_pos (Q.prime idx) (hhigh idx)).symm
    have hItot : Q.integer.totient = Q.numericalCore := by
      unfold CoreRecords.LowerCoreRecord.integer CoreRecords.LowerCoreRecord.numericalCore
      rw [Nat.totient_mul hcopTM, hMtot]
    have hpM := top_ext hMpos hp (lpf_lt hp.one_lt hMdiv)
    have hpI := top_ext hIpos hp (lpf_lt hp.one_lt hIdiv)
    refine ⟨?_, hpM.2, Nat.mul_pos hp.pos hIpos, ?_, hpI.2⟩
    · rw [hpM.1, hMtot]
      unfold CoreRecords.LowerCoreRecord.numericalCore
      ring
    · rw [hpI.1, hItot]
  
  have hreindex : ∀ (f : ℕ → ℝ) (n : ℕ),
      (∑ idx : Fin n, f (idx.val + 1)) = ∑ idx ∈ Finset.Icc 1 n, f idx := by
    intro f n
    induction n with
    | zero => simp
    | succ n ih =>
      rw [Fin.sum_univ_castSucc, Finset.sum_Icc_succ_top (by omega)]
      simpa only [Fin.val_castSucc, Fin.val_last] using congrArg (fun z => z + f (n + 1)) ih
  have hfacet : ∀ (x : Fin (L + 1) → ℝ),
      FordGeometry.outerForm L (fun idx : Fin L => x idx.succ) =
        ∑ j ∈ Finset.Icc 1 L, fordWeight j * CollisionFacet.extend x j := by
    intro x
    calc FordGeometry.outerForm L (fun idx : Fin L => x idx.succ)
        = ∑ idx : Fin L, fordWeight (idx.val + 1) * CollisionFacet.extend x (idx.val + 1) := by
          show ∑ idx : Fin L, fordWeight (idx.val + 1) * x idx.succ = _
          apply Finset.sum_congr rfl
          intro idx _
          simp only [CollisionFacet.extend, dif_pos (Nat.add_lt_add_right idx.isLt 1)]
          rfl
      _ = _ := hreindex (fun j => fordWeight j * CollisionFacet.extend x j) L
  
  have htuple : ∀ (Q : CoreRecords.LowerCoreRecord Y L R P) (p : ℕ), p.Prime →
      Q.lower ⟨0, Q.length_pos⟩ < p → Y ^ (9 / 10 : ℝ) < (p : ℝ) →
      ((Q.tail.totient * (p * ∏ idx, Q.lower idx).totient : ℕ) : ℝ) ≤ Y →
      Rigidity.Tuple Y P (6 / 5) (4 / 5) Q.tail (p * ∏ idx, Q.lower idx)
        (Fin.cons p Q.lower : Fin (L + 1) → ℕ) := by
    intro Q p hp hsep htop' hsize
    have hlast : (Fin.cons p Q.lower : Fin (L + 1) → ℕ) (Fin.last L) =
        Q.lower ⟨L - 1, by have := Q.length_pos; omega⟩ := by
      have he : Fin.last L = (⟨L - 1, by have := Q.length_pos; omega⟩ : Fin L).succ := by
        apply Fin.ext
        simp only [Fin.val_last, Fin.val_succ]
        have := Q.length_pos
        omega
      rw [he, Fin.cons_succ]
    refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, hsize, ?_⟩
    · simp only [Fin.prod_univ_succ, Fin.cons_zero, Fin.cons_succ]
    · intro idx
      cases idx using Fin.cases with
      | zero => simpa using hp
      | succ j => simpa using Q.prime j
    · intro idx j hij
      cases idx using Fin.cases with
      | zero =>
        cases j using Fin.cases with
        | zero => exact (lt_irrefl _ hij).elim
        | succ j =>
          simp only [Fin.cons_zero, Fin.cons_succ]
          exact (Q.order.antitone
            (show (⟨0, Q.length_pos⟩ : Fin L) ≤ j from Nat.zero_le _)).trans_lt hsep
      | succ idx =>
        cases j using Fin.cases with
        | zero =>
          have h : idx.val + 1 < 0 := hij
          omega
        | succ j =>
          simp only [Fin.cons_succ]
          exact Q.order (Fin.succ_lt_succ_iff.mp hij)
    · rw [hlast]; exact Q.last_lower
    · rw [hlast]; exact Q.last_upper
    · intro idx hi hij
      cases idx using Fin.cases with
      | zero => simp at hi
      | succ idx =>
        have hj : idx.val + 1 < L := by simp only [Fin.val_succ] at hij; omega
        have he : (⟨idx.succ.val + 1, hij⟩ : Fin (L + 1)) = (⟨idx.val + 1, hj⟩ : Fin L).succ :=
          Fin.ext (by simp)
        rw [he, Fin.cons_succ, Fin.cons_succ]
        exact Q.gaps idx ⟨idx.val + 1, hj⟩ rfl
    · intro idx hi
      cases idx using Fin.cases with
      | zero => simp at hi
      | succ idx => simpa only [Fin.cons_succ] using Q.upper idx
    · simpa only [Fin.cons_zero] using htop'
    · rw [← hfacet]
      exact Q.facet
  
  have hF : ∀ a ∈ CoreRecords.powerRawPairs S, a.1 ∈ S.cores ∧ a.2.Prime ∧
      Y ^ (99 / 100 : ℝ) < (corePairValue a : ℝ) ∧ (corePairValue a : ℝ) ≤ Y := by
    intro a ha
    simp only [CoreRecords.powerRawPairs, corePairs, Finset.mem_filter, Finset.product_eq_sprod,
      Finset.mem_product] at ha
    exact ⟨ha.1.1, ha.2.1, ha.2.2.1, ha.2.2.2⟩
  obtain ⟨lowerOf, hlowerOf⟩ : ∃ f : ℕ → Fin L → ℕ,
      ∀ b (hb : b ∈ S.cores), f b = (S.record ⟨b, hb⟩).lower :=
    ⟨fun b => if hb : b ∈ S.cores then (S.record ⟨b, hb⟩).lower else fun _ => 1,
      fun b hb => dif_pos hb⟩
  obtain ⟨tailOf, htailOf⟩ : ∃ f : ℕ → ℕ,
      ∀ b (hb : b ∈ S.cores), f b = (S.record ⟨b, hb⟩).tail :=
    ⟨fun b => if hb : b ∈ S.cores then (S.record ⟨b, hb⟩).tail else 0,
      fun b hb => dif_pos hb⟩
  have hval : ∀ a : ℕ × ℕ, ∀ hb : a.1 ∈ S.cores,
      corePairValue a = (a.2 - 1) * (S.record ⟨a.1, hb⟩).numericalCore := by
    intro a hb
    rw [S.core_eq ⟨a.1, hb⟩]
    rfl
  have hA : ∀ a ∈ CoreRecords.powerRawPairs S,
      (tailOf a.1).totient * (a.2 * ∏ idx, lowerOf a.1 idx).totient = corePairValue a ∧
      largestPrimeFactor (a.2 * ∏ idx, lowerOf a.1 idx) = a.2 := by
    intro a ha
    obtain ⟨hb, hp, -, -⟩ := hF a ha
    have h := hrec (S.record ⟨a.1, hb⟩) a.2 hp (htop a ha hb).2
    rw [htailOf a.1 hb, hlowerOf a.1 hb, hval a hb]
    exact ⟨h.1, h.2.1⟩
  have hNex : ∀ a ∈ CoreRecords.powerRawPairs S, ∃ N : ℕ, 0 < N ∧
      N.totient = corePairValue a ∧ largestPrimeFactor N = a.2 := by
    intro a ha
    obtain ⟨hb, hp, -, -⟩ := hF a ha
    have h := hrec (S.record ⟨a.1, hb⟩) a.2 hp (htop a ha hb).2
    exact ⟨_, h.2.2.1, by rw [h.2.2.2.1, hval a hb], h.2.2.2.2⟩
  have hT : ∀ a ∈ CoreRecords.powerRawPairs S,
      Rigidity.Tuple Y P (6 / 5) (4 / 5) (tailOf a.1) (a.2 * ∏ idx, lowerOf a.1 idx)
        (Fin.cons a.2 (lowerOf a.1) : Fin (L + 1) → ℕ) := by
    intro a ha
    obtain ⟨hb, hp, -, hle⟩ := hF a ha
    have h := hrec (S.record ⟨a.1, hb⟩) a.2 hp (htop a ha hb).2
    rw [htailOf a.1 hb, hlowerOf a.1 hb]
    apply htuple _ a.2 hp (htop a ha hb).2 (htop a ha hb).1
    rw [h.1, ← hval a hb]
    exact hle
  have hpair : ∀ a ∈ CoreRecords.powerRawPairs S, ∀ a' : ℕ × ℕ, a.2 = a'.2 →
      corePairValue a = corePairValue a' → a = a' := by
    intro a ha a' h2 hv
    have hp := (hF a ha).2.1
    have hne : a.2 - 1 ≠ 0 := by have := hp.one_lt; omega
    unfold corePairValue at hv
    rw [← h2] at hv
    exact Prod.ext (mul_left_cancel₀ hne hv) h2
  have hcore : ∀ a ∈ CoreRecords.powerRawPairs S, ∀ a' ∈ CoreRecords.powerRawPairs S,
      tailOf a.1 = tailOf a'.1 →
      ∏ idx, (lowerOf a.1 idx - 1) = ∏ idx, (lowerOf a'.1 idx - 1) → a.1 = a'.1 := by
    intro a ha a' ha' ht hl
    have hb := (hF a ha).1
    have hb' := (hF a' ha').1
    have e1 := S.core_eq ⟨a.1, hb⟩
    have e2 := S.core_eq ⟨a'.1, hb'⟩
    unfold CoreRecords.LowerCoreRecord.numericalCore at e1 e2
    rw [htailOf a.1 hb, htailOf a'.1 hb'] at ht
    rw [hlowerOf a.1 hb, hlowerOf a'.1 hb'] at hl
    calc a.1 = _ := e1.symm
      _ = _ := by rw [ht, hl]
      _ = a'.1 := e2
  have hCmem : ∀ a, a ∈ collisionPoints (CoreRecords.powerRawPairs S) corePairValue ↔
      a ∈ CoreRecords.powerRawPairs S ∧ ∃ b ∈ CoreRecords.powerRawPairs S, b ≠ a ∧
        corePairValue b = corePairValue a := by
    intro a
    simp only [collisionPoints, Finset.mem_filter]
  have hmaps : ∀ a ∈ collisionPoints (CoreRecords.powerRawPairs S) corePairValue,
      tailOf a.1 ∈ Finset.Icc 1 R := by
    intro a ha
    have haF := ((hCmem a).mp ha).1
    have hb := (hF a haF).1
    rw [htailOf a.1 hb]
    exact Finset.mem_Icc.mpr ⟨(S.record _).tail_pos, (S.record _).tail_le⟩
  have hfib : ∀ r ∈ Finset.Icc 1 R,
      (((collisionPoints (CoreRecords.powerRawPairs S) corePairValue).filter
        (fun a => tailOf a.1 = r)).card : ℝ) ≤ B := by
    intro r hr
    have hCmem' : ∀ a ∈ (collisionPoints (CoreRecords.powerRawPairs S) corePairValue).filter
        (fun a => tailOf a.1 = r),
        a ∈ collisionPoints (CoreRecords.powerRawPairs S) corePairValue ∧
        a ∈ CoreRecords.powerRawPairs S ∧ tailOf a.1 = r := by
      intro a ha
      rw [Finset.mem_filter] at ha
      exact ⟨ha.1, ((hCmem a).mp ha.1).1, ha.2⟩
    have hinj : Set.InjOn (fun a : ℕ × ℕ => a.2 * ∏ idx, lowerOf a.1 idx)
        (((collisionPoints (CoreRecords.powerRawPairs S) corePairValue).filter
          (fun a => tailOf a.1 = r) : Finset (ℕ × ℕ)) : Set (ℕ × ℕ)) := by
      intro a ha a' ha' he
      simp only [Finset.mem_coe] at ha ha'
      obtain ⟨-, haF, hat⟩ := hCmem' a ha
      obtain ⟨-, haF', hat'⟩ := hCmem' a' ha'
      have he' : a.2 * ∏ idx, lowerOf a.1 idx = a'.2 * ∏ idx, lowerOf a'.1 idx := he
      have h2 : a.2 = a'.2 := by rw [← (hA a haF).2, ← (hA a' haF').2, he']
      apply hpair a haF a' h2
      rw [← (hA a haF).1, ← (hA a' haF').1, hat, hat', he']
    obtain ⟨q, hq⟩ : ∃ q : ℕ → Fin (L + 1) → ℕ,
        ∀ a ∈ (collisionPoints (CoreRecords.powerRawPairs S) corePairValue).filter
          (fun a => tailOf a.1 = r),
          q (a.2 * ∏ idx, lowerOf a.1 idx) = (Fin.cons a.2 (lowerOf a.1) : Fin (L + 1) → ℕ) := by
      refine ⟨fun n => if h : ∃ a ∈ (collisionPoints (CoreRecords.powerRawPairs S)
          corePairValue).filter (fun a => tailOf a.1 = r),
          a.2 * ∏ idx, lowerOf a.1 idx = n then
          (Fin.cons (Classical.choose h).2 (lowerOf (Classical.choose h).1) : Fin (L + 1) → ℕ)
        else fun _ => 1, ?_⟩
      intro a ha
      have h : ∃ a' ∈ (collisionPoints (CoreRecords.powerRawPairs S) corePairValue).filter
          (fun a => tailOf a.1 = r),
          a'.2 * ∏ idx, lowerOf a'.1 idx = a.2 * ∏ idx, lowerOf a.1 idx := ⟨a, ha, rfl⟩
      simp only [dif_pos h]
      have hs := Classical.choose_spec h
      have : Classical.choose h = a :=
        hinj (Finset.mem_coe.mpr hs.1) (Finset.mem_coe.mpr ha) hs.2
      rw [this]
    have hcard := Finset.card_image_of_injOn hinj
    rw [← hcard]
    apply hcount r hr _ q
    · intro n hn
      obtain ⟨a, ha, hna⟩ := Finset.mem_image.mp hn
      subst hna
      obtain ⟨-, haF, hat⟩ := hCmem' a ha
      rw [hq a ha, ← hat]
      exact hT a haF
    · intro n hn m hm hpr idx
      obtain ⟨a, ha, hna⟩ := Finset.mem_image.mp hn
      obtain ⟨a', ha', hma⟩ := Finset.mem_image.mp hm
      subst hna hma
      rw [hq a ha, hq a' ha'] at hpr ⊢
      simp only [Fin.cons_succ] at hpr ⊢
      obtain ⟨-, haF, hat⟩ := hCmem' a ha
      obtain ⟨-, haF', hat'⟩ := hCmem' a' ha'
      rw [hcore a haF a' haF' (hat.trans hat'.symm) hpr]
    · intro n hn
      obtain ⟨a, ha, hna⟩ := Finset.mem_image.mp hn
      subst hna
      obtain ⟨haColl, haF, hat⟩ := hCmem' a ha
      obtain ⟨b, hbF, hba, hbv⟩ := ((hCmem a).mp haColl).2
      obtain ⟨N, hN0, hNt, hNl⟩ := hNex b hbF
      refine ⟨N, hN0, ?_, ?_⟩
      · rw [hNt, hbv, ← (hA a haF).1, hat]
      · rw [hq a ha, hNl, Fin.cons_zero]
        intro h
        exact hba (hpair b hbF a h hbv)
  have hsum := Finset.card_eq_sum_card_fiberwise (f := fun a : ℕ × ℕ => tailOf a.1)
    (s := collisionPoints (CoreRecords.powerRawPairs S) corePairValue)
    (t := Finset.Icc 1 R) (fun a ha => hmaps a ha)
  calc ((collisionPoints (CoreRecords.powerRawPairs S) corePairValue).card : ℝ)
      = ∑ r ∈ Finset.Icc 1 R, (((collisionPoints (CoreRecords.powerRawPairs S)
          corePairValue).filter (fun a => tailOf a.1 = r)).card : ℝ) := by
        rw [hsum]
        push_cast
        rfl
    _ ≤ ∑ r ∈ Finset.Icc 1 R, B := Finset.sum_le_sum hfib
