    have hac := ford_adjacent_weight_ratio FordAnalysis.rho hρ hc1 hPA hPB hPC L p hp.1 hp.2
    apply hviol (FordOrder.adjCoeff L p) p _ _ hac.1
    · simp [FordOrder.adjCoeff]
    · exact hac.2
