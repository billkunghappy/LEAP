    rw [hgap0]
    linarith
  let p0 : Fin L := ⟨0, by omega⟩
  have hyUnit : ∀ k : Fin L, (x + e) k ≤ 1 := by
    intro k
    have hle : p0 ≤ k := by
      show (0 : ℕ) ≤ k.val
      omega
    exact (hyAnti hle).trans ((hyTop p0 rfl).trans (hF2 0))
  
  have hyOuter : FordGeometry.outerForm L (x + e) ≤ FordInner.targetParameter L M 0 := by
    have heO : FordGeometry.outerForm L e ≤ (∑ j : Fin L, fordWeight (j.val + 1)) * τ :=
      hF4 (fun j : Fin L => fordWeight (j.val + 1)) (fun j => (hfw _ (by omega)).1)
    have hxO := hP.2.2.2.1
    have hR := mul_le_mul_of_nonneg_right hout hτ
    rw [map_add, hgap0]
    linarith
  
  have hyTail : ∀ idx : Fin L, idx.val + 1 < L →
      FordGeometry.tailForm idx (x + e) ≤
        FordInner.targetParameter L M (idx.val + 1) * (x + e) idx := by
    intro idx hi
    have hrowx := hP.2.2.2.2 idx hi
    have hξi := hξ (idx.val + 1)
    have hxi := mul_le_mul_of_nonneg_left (hxe idx) hξi.1.le
    have hzτ := mul_le_mul_of_nonneg_right hξi.2 hτ
    have heT : FordGeometry.tailForm idx e ≤ (∑ j : Fin L, FordGeometry.tailWeight idx j) * τ :=
      hF4 (FordGeometry.tailWeight idx) (htw0 idx)
