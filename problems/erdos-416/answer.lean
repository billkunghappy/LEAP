            ≤ (FordScale.coreDimension M t : ℝ) * (Real.exp t / t) :=
              mul_le_mul_of_nonneg_left hexp hL0
          _ ≤ (4 * Real.log t) * (Real.exp t / t) :=
              mul_le_mul_of_nonneg_right hdim (by positivity)
          _ = (4 * Real.log t / t) * Real.exp t := by ring
  
  have hLL : Tendsto logLog atTop atTop := Real.tendsto_log_atTop.comp Real.tendsto_log_atTop
  filter_upwards [hLL.eventually s2, eventually_gt_atTop (1 : ℝ)] with y hB hy
  obtain ⟨ht, hsmall, hmain⟩ := hB
  intro p A n hn
  obtain ⟨hn0, hlog⟩ := s1 _ _ p (A / logLog y) (logLog y) n ht hn
  have h3 := hlog.trans hmain
  refine ⟨hn0, ?_, h3⟩
  have hlogy : 0 < Real.log y := Real.log_pos hy
  have hly : Real.exp (logLog y) = Real.log y := Real.exp_log hlogy
  have h2 : Real.log (n : ℝ) ≤ (1 / 40) * Real.log y := by
    refine h3.trans ?_
    rw [hly]
