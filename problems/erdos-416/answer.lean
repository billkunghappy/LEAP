      (2 * c / Real.log 2) * (1 / Real.log (Real.log u) -
        1 / Real.log (Real.log u + (n : ℝ) * Real.log 2)) := by
    intro n
    induction n with
    | zero =>
      have hempty : F.filter (fun m : ℕ => (m : ℝ) ≤ u * 2 ^ 0) = ∅ := by
        apply Finset.filter_false_of_mem
        intro m hm
        simp only [pow_zero, mul_one, not_le]
        exact hF m hm
