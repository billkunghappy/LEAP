  have hLN : FordScale.coreDimension M t ≤ FordScale.optimalDimension t := Nat.sub_le _ _
  have hsmall : 2 ≤ FordScale.coreDimension M t →
      1 / t ≤ 10 * FordAnalysis.rho ^ (FordScale.coreDimension M t) /
        ((FordScale.coreDimension M t : ℕ) : ℝ) := fun h2 =>
    pc_prefix_mesh_bound hRHO M t ht _ (by omega) le_rfl
  have h1 := thickened_polytope_diagonal_volume_le (FordScale.coreDimension M t)
    (FordGeometry.expandedParameter (FordScale.optimalDimension t)) (1 / t) hξ hτ
  have h2 := expandedParameter_distortion_le_two (FordScale.optimalDimension t)
    (FordScale.coreDimension M t) hLN
  have h3 := pc_thickened_unit_polytope_model_bound hREN (FordScale.coreDimension M t) (1 / t)
    hτ hτ1 hsmall
