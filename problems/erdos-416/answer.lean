    have hmi := (hm idx).2
    rw [map_add, hF1 _ hi]
    show FordGeometry.tailForm idx x + FordGeometry.tailForm idx e ≤
      (FordInner.tightParameter L M (idx.val + 1) +
        FordInner.extraLoss (L - (idx.val + 1))) * (x idx + e idx)
    linarith
  
  have hcap : A * τ ≤ (x + e) p := by
    have hcut := mul_le_mul_of_nonneg_right hAB hτ
    have hep := hlo p
    show A * τ ≤ x p + e p
    linarith
  exact ⟨⟨⟨fun k => (hm k).1, hyUnit, hyAnti, hyOuter, hyTail⟩, hyGap, hcap⟩, hyTop⟩

theorem core_outer_margin_eventually (hρ : 0 < FordAnalysis.rho ∧ FordAnalysis.rho < 1) (M : ℕ) :
    ∀ᶠ t : ℝ in atTop, 2 ≤ FordScale.coreDimension M t ∧
      (1 / t) * FordInner.innerRadius (FordScale.coreDimension M t) ≤
        FordInner.extraLoss (FordScale.coreDimension M t) :=
by
  have hlog : Real.log FordAnalysis.rho < 0 := Real.log_neg hρ.1 hρ.2
  have hCdef : FordAnalysis.C = (2 * |Real.log FordAnalysis.rho|)⁻¹ := rfl
  have hCpos : 0 < FordAnalysis.C := by
    rw [hCdef, abs_of_neg hlog]
    apply inv_pos.mpr
    linarith
  have hkey : 2 * FordAnalysis.C * Real.log FordAnalysis.rho = -1 := by
    rw [hCdef, abs_of_neg hlog]
    have hne : Real.log FordAnalysis.rho ≠ 0 := hlog.ne
    field_simp
  have hmass : 0 ≤ FordInner.radiusMass := by
    unfold FordInner.radiusMass
    apply tsum_nonneg
    intro d
    unfold FordInner.innerRadius
    have := hρ.1
    positivity
  have hε : 0 < FordInner.innerEpsilon := by
    unfold FordInner.innerEpsilon
    positivity
  have hlogarg : Tendsto (fun u : ℝ => u - Real.log u) atTop atTop := by
    have hlo : ∀ᶠ u : ℝ in atTop, u / 2 ≤ u - Real.log u := by
      filter_upwards [Real.isLittleO_log_id_atTop.def (by norm_num : (0 : ℝ) < 1 / 2),
        eventually_ge_atTop (1 : ℝ)] with u hu hu1
      simp only [Real.norm_eq_abs, id_eq, abs_of_nonneg (by linarith : 0 ≤ u)] at hu
      have hl := le_abs_self (Real.log u)
      linarith
    exact tendsto_atTop_mono' atTop hlo (tendsto_id.atTop_div_const (by norm_num : (0 : ℝ) < 2))
  have hopt : Tendsto FordScale.optimalDimension atTop atTop := by
    have h := (hlogarg.comp Real.tendsto_log_atTop).const_mul_atTop
      (mul_pos (by norm_num : (0 : ℝ) < 2) hCpos)
    exact tendsto_nat_floor_atTop.comp h
  have hcore : Tendsto (FordScale.coreDimension M) atTop atTop :=
    (tendsto_sub_atTop_nat M).comp hopt
  filter_upwards [hcore.eventually (eventually_ge_atTop 2),
    Real.tendsto_log_atTop.eventually (eventually_ge_atTop (1 / FordInner.innerEpsilon)),
    eventually_gt_atTop (1 : ℝ)] with t hL2 hlogt ht1
  refine ⟨hL2, ?_⟩
  have ht0 : 0 < t := by linarith
  have hu : 0 < Real.log t := Real.log_pos ht1
  have hlu : Real.log (Real.log t) ≤ Real.log t - 1 := Real.log_le_sub_one_of_pos hu
  have harg : 0 ≤ 2 * FordAnalysis.C * (Real.log t - Real.log (Real.log t)) := by
    apply mul_nonneg (by positivity)
    linarith
  have hLle : (FordScale.coreDimension M t : ℝ) ≤
      2 * FordAnalysis.C * (Real.log t - Real.log (Real.log t)) := by
    have h1 : (FordScale.coreDimension M t : ℝ) ≤ (FordScale.optimalDimension t : ℝ) := by
      exact_mod_cast Nat.sub_le _ _
    exact h1.trans (Nat.floor_le harg)
  have hmul := mul_le_mul_of_nonpos_right hLle hlog.le
  have hleft : 2 * FordAnalysis.C * (Real.log t - Real.log (Real.log t)) *
      Real.log FordAnalysis.rho = Real.log (Real.log t) - Real.log t := by
    have h : 2 * FordAnalysis.C * (Real.log t - Real.log (Real.log t)) *
        Real.log FordAnalysis.rho = (2 * FordAnalysis.C * Real.log FordAnalysis.rho) *
          (Real.log t - Real.log (Real.log t)) := by ring
    rw [h, hkey]
    ring
  rw [hleft] at hmul
  have hexp := Real.exp_le_exp.mpr hmul
  have hE1 : Real.exp (Real.log (Real.log t) - Real.log t) = Real.log t / t := by
    rw [Real.exp_sub, Real.exp_log hu, Real.exp_log ht0]
  have hE2 : Real.exp ((FordScale.coreDimension M t : ℝ) * Real.log FordAnalysis.rho) =
      FordAnalysis.rho ^ (FordScale.coreDimension M t) := by
    rw [Real.exp_nat_mul, Real.exp_log hρ.1]
  rw [hE1, hE2] at hexp
  have h1 : 1 ≤ Real.log t * FordInner.innerEpsilon := (div_le_iff₀ hε).mp hlogt
  have h5 : 1 / t ≤ FordInner.innerEpsilon * FordAnalysis.rho ^ (FordScale.coreDimension M t) := by
    calc 1 / t ≤ (Real.log t * FordInner.innerEpsilon) / t :=
          div_le_div_of_nonneg_right h1 ht0.le
      _ = FordInner.innerEpsilon * (Real.log t / t) := by ring
      _ ≤ _ := mul_le_mul_of_nonneg_left hexp hε.le
  have hR : 0 ≤ FordInner.innerRadius (FordScale.coreDimension M t) := by
    unfold FordInner.innerRadius
    positivity
  calc (1 / t) * FordInner.innerRadius (FordScale.coreDimension M t) ≤
        (FordInner.innerEpsilon * FordAnalysis.rho ^ (FordScale.coreDimension M t)) *
          FordInner.innerRadius (FordScale.coreDimension M t) :=
        mul_le_mul_of_nonneg_right h5 hR
    _ = FordInner.extraLoss (FordScale.coreDimension M t) := by
        unfold FordInner.extraLoss
        ring

theorem core_seed_erosion_cap_lower (hRHO : 0 < FordAnalysis.rho ∧ FordAnalysis.rho < 3 / 4 ∧ FordAnalysis.F FordAnalysis.rho = 1)
    (hREN : (217 / 400 : ℝ) < FordAnalysis.rho ∧ FordAnalysis.rho < 2713 / 5000 ∧
      ∀ n : ℕ, 0 < FordAnalysis.g n ∧ 0 < FordAnalysis.gStar n ∧
        (1 ≤ n → FordAnalysis.g n * FordAnalysis.rho ^ n < 17 / 50) ∧
        (2 ≤ n → (31 / 100 : ℝ) < FordAnalysis.g n * FordAnalysis.rho ^ n) ∧
        (2 ≤ n → FordAnalysis.gStar n * FordAnalysis.rho ^ n < 1 / 2) ∧
        (1 / 4 : ℝ) ≤ FordAnalysis.gStar n * FordAnalysis.rho ^ n) :
    ∀ A : ℝ, 0 ≤ A → ∃ β : ℝ, 0 ≤ β ∧
      ∀ᶠ M : ℕ in atTop, ∀ᶠ t : ℝ in atTop,
        ∀ p : Fin (FordScale.coreDimension M t), p.val + 1 = FordScale.coreDimension M t →
          Real.exp (-1) * MeasureTheory.volume.real
              (FordGeometry.polytope (FordScale.coreDimension M t) (fun _ => 1) ∩ {x | β / t ≤ x p}) ≤
            MeasureTheory.volume.real (FordReciprocal.cubeErosion
              (FordInner.innerSeed (FordInner.targetParameter (FordScale.coreDimension M t) M) p (A / t))
              (1 / t)) :=
by
  have hρ : 0 < FordAnalysis.rho ∧ FordAnalysis.rho < 1 := ⟨hRHO.1, hRHO.2.1.trans (by norm_num)⟩
  have hG : ∀ n : ℕ, 0 < FordAnalysis.g n ∧ 0 < FordAnalysis.gStar n :=
    fun n => ⟨(hREN.2.2 n).1, (hREN.2.2 n).2.1⟩
  have hgs : ∀ n : ℕ, (1 / 4 : ℝ) ≤ FordAnalysis.gStar n * FordAnalysis.rho ^ n :=
    fun n => (hREN.2.2 n).2.2.2.2.2
  have hgrow := unordered_terminal_coordinate_lower hG
  have hmass : 0 ≤ FordInner.radiusMass := by
    unfold FordInner.radiusMass
    apply tsum_nonneg
    intro d
    unfold FordInner.innerRadius
    have := hρ.1
    positivity
  have hε : 0 < FordInner.innerEpsilon := by
    unfold FordInner.innerEpsilon
    positivity
  intro A hA
  have h8e : 0 ≤ 8 / FordInner.innerEpsilon := by positivity
  have hB8 : 8 ≤ A + 9 + 8 / FordInner.innerEpsilon := by linarith
  have hεB : 8 ≤ FordInner.innerEpsilon * (A + 9 + 8 / FordInner.innerEpsilon) := by
    have h1 : FordInner.innerEpsilon * (8 / FordInner.innerEpsilon) = 8 := by
      field_simp
    have h2 : FordInner.innerEpsilon * (A + 9 + 8 / FordInner.innerEpsilon) =
        FordInner.innerEpsilon * A + 9 * FordInner.innerEpsilon +
          FordInner.innerEpsilon * (8 / FordInner.innerEpsilon) := by ring
    rw [h2, h1]
    have : 0 ≤ FordInner.innerEpsilon * A := mul_nonneg hε.le hA
    linarith
  have hAB : A + 1 ≤ A + 9 + 8 / FordInner.innerEpsilon := by linarith
  have hexp : 0 < Real.exp (-1) := Real.exp_pos _
  refine ⟨(A + 9 + 8 / FordInner.innerEpsilon) / Real.exp (-1),
    div_nonneg (by linarith) hexp.le, ?_⟩
  filter_upwards [eventually_ge_atTop (2 : ℕ)] with M hM
  have key : ∀ (L : ℕ) (t : ℝ), 0 < t → 2 ≤ L →
      (1 / t) * FordInner.innerRadius L ≤ FordInner.extraLoss L →
      ∀ p : Fin L, p.val + 1 = L →
        Real.exp (-1) * MeasureTheory.volume.real (FordGeometry.polytope L (fun _ => 1) ∩
            {x | (A + 9 + 8 / FordInner.innerEpsilon) / Real.exp (-1) / t ≤ x p}) ≤
          MeasureTheory.volume.real (FordReciprocal.cubeErosion
            (FordInner.innerSeed (FordInner.targetParameter L M) p (A / t)) (1 / t)) := by
    intro L t ht hL2 hmarg p hp
    obtain ⟨hξ, hH⟩ := tightParameter_bounds_H_lower hρ hM L
    have hτ : 0 ≤ 1 / t := by positivity
    have hsub := tight_innerSeed_subset_erosion hρ hgs hgrow hL2 hξ p hp hτ hB8 hεB hAB hmarg
    rw [mul_one_div, mul_one_div] at hsub
    have h2 := diagonal_contraction_innerSeed_volume (fun j => hξ j) p hp
      ((A + 9 + 8 / FordInner.innerEpsilon) / t)
    have hHS : (∏ j ∈ Finset.range L, FordInner.tightParameter L M j ^ (L - j)) ≤
        ∏ j ∈ Finset.range L, FordInner.tightParameter L M j := by
      apply Finset.prod_le_prod
      · intro j _
        exact pow_nonneg (hξ j).1.le _
      · intro j hj
        have hj' := Finset.mem_range.mp hj
        exact pow_le_of_le_one (hξ j).1.le (hξ j).2 (by omega)
    have hSe : Real.exp (-1) ≤ ∏ j ∈ Finset.range L, FordInner.tightParameter L M j :=
      hH.trans hHS
    have hBt : 0 ≤ (A + 9 + 8 / FordInner.innerEpsilon) / t := by
      apply div_nonneg _ ht.le
      linarith
    have hcap : (A + 9 + 8 / FordInner.innerEpsilon) / t /
          (∏ j ∈ Finset.range L, FordInner.tightParameter L M j) ≤
        (A + 9 + 8 / FordInner.innerEpsilon) / Real.exp (-1) / t := by
      rw [div_right_comm (A + 9 + 8 / FordInner.innerEpsilon) (Real.exp (-1)) t]
      exact div_le_div_of_nonneg_left hBt hexp hSe
    have hsub1 : FordGeometry.polytope L (fun _ => 1) ∩
          {x | (A + 9 + 8 / FordInner.innerEpsilon) / Real.exp (-1) / t ≤ x p} ⊆
        FordGeometry.polytope L (fun _ => 1) ∩
          {y | (A + 9 + 8 / FordInner.innerEpsilon) / t /
            (∏ j ∈ Finset.range L, FordInner.tightParameter L M j) ≤ y p} := by
      intro x hx
      exact ⟨hx.1, hcap.trans hx.2⟩
    have hIcc1 : FordGeometry.polytope L (fun _ => 1) ∩
          {y | (A + 9 + 8 / FordInner.innerEpsilon) / t /
            (∏ j ∈ Finset.range L, FordInner.tightParameter L M j) ≤ y p} ⊆
        Set.Icc (fun _ => (0 : ℝ)) (fun _ => 1) :=
      fun x hx => ⟨fun i => hx.1.1 i, fun i => hx.1.2.1 i⟩
    have hfin1 : MeasureTheory.volume (FordGeometry.polytope L (fun _ => 1) ∩
          {y | (A + 9 + 8 / FordInner.innerEpsilon) / t /
            (∏ j ∈ Finset.range L, FordInner.tightParameter L M j) ≤ y p}) ≠ ⊤ :=
      MeasureTheory.measure_ne_top_of_subset hIcc1 isCompact_Icc.measure_lt_top.ne
    have hmono1 := MeasureTheory.measureReal_mono hsub1 hfin1
    have hIcc2 : FordReciprocal.cubeErosion
          (FordInner.innerSeed (FordInner.targetParameter L M) p (A / t)) (1 / t) ⊆
        Set.Icc (fun _ => (0 : ℝ)) (fun _ => 1) := by
      intro x hx
      have h0mem : (0 : Fin L → ℝ) ∈ Set.Icc (fun _ : Fin L => -(1 / t)) (fun _ => 1 / t) := by
        constructor
        · intro i
          simp only [Pi.zero_apply]
          linarith
        · intro i
          simp only [Pi.zero_apply]
          linarith
      have hx0 := hx 0 h0mem
      rw [add_zero] at hx0
      exact ⟨fun i => hx0.1.1.1 i, fun i => hx0.1.1.2.1 i⟩
    have hfin2 : MeasureTheory.volume (FordReciprocal.cubeErosion
          (FordInner.innerSeed (FordInner.targetParameter L M) p (A / t)) (1 / t)) ≠ ⊤ :=
      MeasureTheory.measure_ne_top_of_subset hIcc2 isCompact_Icc.measure_lt_top.ne
    have hmono2 := MeasureTheory.measureReal_mono hsub hfin2
    calc
      _ ≤ Real.exp (-1) * MeasureTheory.volume.real (FordGeometry.polytope L (fun _ => 1) ∩
            {y | (A + 9 + 8 / FordInner.innerEpsilon) / t /
              (∏ j ∈ Finset.range L, FordInner.tightParameter L M j) ≤ y p}) :=
          mul_le_mul_of_nonneg_left hmono1 hexp.le
      _ ≤ (∏ j ∈ Finset.range L, FordInner.tightParameter L M j ^ (L - j)) *
            MeasureTheory.volume.real (FordGeometry.polytope L (fun _ => 1) ∩
            {y | (A + 9 + 8 / FordInner.innerEpsilon) / t /
              (∏ j ∈ Finset.range L, FordInner.tightParameter L M j) ≤ y p}) :=
          mul_le_mul_of_nonneg_right hH MeasureTheory.measureReal_nonneg
      _ ≤ _ := h2
      _ ≤ _ := hmono2
  filter_upwards [core_outer_margin_eventually hρ M, eventually_gt_atTop (0 : ℝ)] with t hmar ht
  intro p hp
  exact key _ t ht hmar.1 hmar.2 p hp

theorem ordered_core_cap_half (hRHO : 0 < FordAnalysis.rho ∧ FordAnalysis.rho < 3 / 4 ∧ FordAnalysis.F FordAnalysis.rho = 1)
    (hREN : (217 / 400 : ℝ) < FordAnalysis.rho ∧ FordAnalysis.rho < 2713 / 5000 ∧
      ∀ n : ℕ, 0 < FordAnalysis.g n ∧ 0 < FordAnalysis.gStar n ∧
        (1 ≤ n → FordAnalysis.g n * FordAnalysis.rho ^ n < 17 / 50) ∧
        (2 ≤ n → (31 / 100 : ℝ) < FordAnalysis.g n * FordAnalysis.rho ^ n) ∧
        (2 ≤ n → FordAnalysis.gStar n * FordAnalysis.rho ^ n < 1 / 2) ∧
        (1 / 4 : ℝ) ≤ FordAnalysis.gStar n * FordAnalysis.rho ^ n) :
    ∀ β : ℝ, 0 ≤ β →
      ∀ᶠ M : ℕ in atTop, ∀ᶠ t : ℝ in atTop,
        ∀ p : Fin (FordScale.coreDimension M t), p.val + 1 = FordScale.coreDimension M t →
          FordGeometry.T (FordScale.coreDimension M t) / 2 ≤
            MeasureTheory.volume.real
              (FordGeometry.polytope (FordScale.coreDimension M t) (fun _ => 1) ∩ {x | β / t ≤ x p}) :=
by
  obtain ⟨hρ0, hρ34, hF⟩ := hRHO
  have hρ1 : FordAnalysis.rho < 1 := by linarith
  
  have hw : ∀ k : ℕ, 1 ≤ k → 0 ≤ fordWeight k := by
    intro k hk
    unfold fordWeight
    have ha : (1 : ℝ) ≤ (k : ℝ) := by exact_mod_cast hk
    generalize (k : ℝ) = a at ha ⊢
    have ha0 : 0 < a := by linarith
    have h1 : 1 - (a + 1)⁻¹ ≤ Real.log (a + 1) := Real.one_sub_inv_le_log_of_pos (by linarith)
    have h2 : 1 - ((a + 1) / a)⁻¹ ≤ Real.log ((a + 1) / a) :=
      Real.one_sub_inv_le_log_of_pos (by positivity)
    rw [Real.log_div (by linarith) ha0.ne', inv_div] at h2
    have h3 : 1 - (a + 1)⁻¹ = a / (a + 1) := by field_simp; ring
    have h4 : 1 - a / (a + 1) = 1 / (a + 1) := by field_simp; ring
    have h5 : a * (1 / (a + 1)) ≤ a * (Real.log (a + 1) - Real.log a) :=
      mul_le_mul_of_nonneg_left (by linarith) ha0.le
    have h6 : a * (1 / (a + 1)) = a / (a + 1) := by ring
    have h8 : 0 ≤ (a - 1) / (a + 1) := div_nonneg (by linarith) (by linarith)
    have h7 : a / (a + 1) + a / (a + 1) - 1 = (a - 1) / (a + 1) := by field_simp; ring
    nlinarith
  
  have hf0 : ∀ n : ℕ, 0 ≤ FordAnalysis.coeff n * FordAnalysis.rho ^ n := by
    intro n
    unfold FordAnalysis.coeff
    split_ifs with h
    · simp
    · exact mul_nonneg (hw n (Nat.one_le_iff_ne_zero.mpr h)) (pow_nonneg hρ0.le n)
  have hsumm : Summable (fun n : ℕ => FordAnalysis.coeff n * FordAnalysis.rho ^ n) := by
    by_contra hns
    have h0 := tsum_eq_zero_of_not_summable hns
    unfold FordAnalysis.F at hF
    rw [h0] at hF
    norm_num at hF
  have hpart : ∀ s : Finset ℕ, ∑ n ∈ s, FordAnalysis.coeff n * FordAnalysis.rho ^ n ≤ 1 := by
    intro s
    have h := Summable.sum_le_tsum s (fun i _ => hf0 i) hsumm
    unfold FordAnalysis.F at hF
    linarith
  
  have hmem : ∀ L : ℕ, (fun idx : Fin L => FordAnalysis.rho ^ (idx.val + 1)) ∈
      FordGeometry.polytope L (fun _ => 1) := by
    intro L
    simp only [FordGeometry.polytope, Set.mem_setOf_eq]
    refine ⟨fun i => pow_nonneg hρ0.le _, fun i => pow_le_one₀ hρ0.le hρ1.le, ?_, ?_, ?_⟩
    · intro i j hij
      have h' : i.val ≤ j.val := hij
      exact pow_le_pow_of_le_one hρ0.le hρ1.le (by omega)
    · show ∑ idx : Fin L, fordWeight (idx.val + 1) * FordAnalysis.rho ^ (idx.val + 1) ≤ 1
      have e1 : ∀ idx : Fin L, fordWeight (idx.val + 1) * FordAnalysis.rho ^ (idx.val + 1) =
          FordAnalysis.coeff (idx.val + 1) * FordAnalysis.rho ^ (idx.val + 1) := by
        intro idx
        unfold FordAnalysis.coeff
        rw [if_neg (Nat.succ_ne_zero _)]
      rw [Finset.sum_congr rfl (fun idx _ => e1 idx)]
      have e2 : ∑ idx : Fin L, FordAnalysis.coeff (idx.val + 1) * FordAnalysis.rho ^ (idx.val + 1) =
          ∑ n ∈ Finset.range L, FordAnalysis.coeff (n + 1) * FordAnalysis.rho ^ (n + 1) :=
        Fin.sum_univ_eq_sum_range (fun n => FordAnalysis.coeff (n + 1) * FordAnalysis.rho ^ (n + 1)) L
      rw [e2]
      have h := hpart (Finset.range (L + 1))
      rw [Finset.sum_range_succ'] at h
      have := hf0 0
      linarith
    · intro idx hidx
      show ∑ j : Fin L, FordGeometry.tailWeight idx j * FordAnalysis.rho ^ (j.val + 1) ≤
        1 * FordAnalysis.rho ^ (idx.val + 1)
      by_cases hL2 : idx.val + 2 < L
      · have hterm : ∀ j : Fin L, FordGeometry.tailWeight idx j * FordAnalysis.rho ^ (j.val + 1) =
            FordAnalysis.rho ^ (idx.val + 1) *
              (if idx.val < j.val then FordAnalysis.coeff (j.val - idx.val) *
                FordAnalysis.rho ^ (j.val - idx.val) else 0) := by
          intro j
          unfold FordGeometry.tailWeight
          by_cases hij : idx.val < j.val
          · rw [if_pos hij, if_pos hL2, if_pos hij]
            have hc : FordAnalysis.coeff (j.val - idx.val) = fordWeight (j.val - idx.val) := by
              unfold FordAnalysis.coeff
              rw [if_neg (by omega)]
            have hp : FordAnalysis.rho ^ (j.val + 1) =
                FordAnalysis.rho ^ (idx.val + 1) * FordAnalysis.rho ^ (j.val - idx.val) := by
              rw [← pow_add]
              congr 1
              omega
            rw [hc, hp]
            ring
          · rw [if_neg hij, if_neg hij]
            ring
        rw [Finset.sum_congr rfl (fun j _ => hterm j), ← Finset.mul_sum]
        have e2 : ∑ j : Fin L, (if idx.val < j.val then FordAnalysis.coeff (j.val - idx.val) *
              FordAnalysis.rho ^ (j.val - idx.val) else 0) =
            ∑ j ∈ (Finset.range L).filter (fun j => idx.val < j),
              FordAnalysis.coeff (j - idx.val) * FordAnalysis.rho ^ (j - idx.val) := by
          rw [Finset.sum_filter]
          exact Fin.sum_univ_eq_sum_range (fun j => if idx.val < j then
            FordAnalysis.coeff (j - idx.val) * FordAnalysis.rho ^ (j - idx.val) else 0) L
        rw [e2]
        have hinj : Set.InjOn (fun j => j - idx.val)
            (((Finset.range L).filter (fun j => idx.val < j) : Finset ℕ) : Set ℕ) := by
          intro a ha b hb hab
          simp only [Finset.coe_filter, Finset.mem_range, Set.mem_setOf_eq] at ha hb
          simp only at hab
          omega
        have e3 : ∑ j ∈ (Finset.range L).filter (fun j => idx.val < j),
              FordAnalysis.coeff (j - idx.val) * FordAnalysis.rho ^ (j - idx.val) =
            ∑ n ∈ ((Finset.range L).filter (fun j => idx.val < j)).image (fun j => j - idx.val),
              FordAnalysis.coeff n * FordAnalysis.rho ^ n :=
          (Finset.sum_image (f := fun n => FordAnalysis.coeff n * FordAnalysis.rho ^ n) hinj).symm
        rw [e3]
        have h := hpart (((Finset.range L).filter (fun j => idx.val < j)).image (fun j => j - idx.val))
        have hpos : 0 ≤ FordAnalysis.rho ^ (idx.val + 1) := pow_nonneg hρ0.le _
        nlinarith [mul_le_mul_of_nonneg_left h hpos]
      · have hj : idx.val + 1 < L := hidx
        rw [Finset.sum_eq_single ⟨idx.val + 1, hj⟩]
        · unfold FordGeometry.tailWeight
          rw [if_pos (show idx.val < idx.val + 1 by omega), if_neg hL2, one_mul, one_mul]
          exact pow_le_pow_of_le_one hρ0.le hρ1.le (show idx.val + 1 ≤ idx.val + 1 + 1 by omega)
        · intro b _ hb
          unfold FordGeometry.tailWeight
          have hbL := b.isLt
          have hnb : ¬ idx.val < b.val := by
            intro h
            apply hb
            exact Fin.ext (show b.val = idx.val + 1 by omega)
          rw [if_neg hnb, zero_mul]
        · intro h
          exact absurd (Finset.mem_univ _) h
  
  have hconv : ∀ L : ℕ, Convex ℝ (FordGeometry.polytope L (fun _ => (1 : ℝ))) := by
    intro L x hx y hy a b ha hb hab
    obtain ⟨hx0, hx1, hxa, hxo, hxt⟩ := hx
    obtain ⟨hy0, hy1, hya, hyo, hyt⟩ := hy
    have hxo' : FordGeometry.outerForm L x ≤ 1 := hxo
    have hyo' : FordGeometry.outerForm L y ≤ 1 := hyo
    simp only [FordGeometry.polytope, Set.mem_setOf_eq]
    refine ⟨?_, ?_, ?_, ?_, ?_⟩
    · intro i
      simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul]
      exact add_nonneg (mul_nonneg ha (hx0 i)) (mul_nonneg hb (hy0 i))
    · intro i
      simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul]
      nlinarith [mul_le_mul_of_nonneg_left (hx1 i) ha, mul_le_mul_of_nonneg_left (hy1 i) hb]
    · intro i j hij
      simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul]
      nlinarith [mul_le_mul_of_nonneg_left (hxa hij) ha, mul_le_mul_of_nonneg_left (hya hij) hb]
    · rw [map_add, map_smul, map_smul, smul_eq_mul, smul_eq_mul]
      nlinarith [mul_le_mul_of_nonneg_left hxo' ha, mul_le_mul_of_nonneg_left hyo' hb]
    · intro idx hidx
      have h1 : FordGeometry.tailForm idx x ≤ 1 * x idx := hxt idx hidx
      have h2 : FordGeometry.tailForm idx y ≤ 1 * y idx := hyt idx hidx
      rw [map_add, map_smul, map_smul, smul_eq_mul, smul_eq_mul]
      simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul]
      nlinarith [mul_le_mul_of_nonneg_left h1 ha, mul_le_mul_of_nonneg_left h2 hb]
  
  have hcap : ∀ (L : ℕ) (K : Set (Fin L → ℝ)), Convex ℝ K →
      K ⊆ Set.Icc (fun _ => (0 : ℝ)) (fun _ => 1) →
      ∀ z ∈ K, ∀ (p : Fin L) (ε : ℝ), 0 ≤ ε → ε ≤ z p → 0 < z p →
      (1 - ε / z p) ^ L * MeasureTheory.volume.real K ≤
        MeasureTheory.volume.real (K ∩ {x | ε ≤ x p}) := by
    intro L K hK hKsub z hz p ε hε0 hεz hzp
    have hq0 : 0 ≤ ε / z p := div_nonneg hε0 hzp.le
    have hq1 : ε / z p ≤ 1 := (div_le_one hzp).mpr hεz
    have hr0 : 0 ≤ 1 - ε / z p := by linarith
    have hr1 : 1 - ε / z p ≤ 1 := by linarith
    have himg : (AffineMap.homothety z (1 - ε / z p)) '' K ⊆ K ∩ {x | ε ≤ x p} := by
      rintro _ ⟨x, hx, rfl⟩
      rw [AffineMap.homothety_apply, vsub_eq_sub, vadd_eq_add]
      refine ⟨?_, ?_⟩
      · have hm := Convex.add_smul_sub_mem hK hz hx ⟨hr0, hr1⟩
        rw [add_comm] at hm
        exact hm
      · show ε ≤ ((1 - ε / z p) • (x - z) + z) p
        simp only [Pi.add_apply, Pi.smul_apply, Pi.sub_apply, smul_eq_mul]
        have hxp : 0 ≤ x p := (hKsub hx).1 p
        have hez : ε / z p * z p = ε := div_mul_cancel₀ ε hzp.ne'
        nlinarith [mul_nonneg hr0 hxp]
    have hvol : MeasureTheory.volume ((AffineMap.homothety z (1 - ε / z p)) '' K) =
        ENNReal.ofReal |(1 - ε / z p) ^ L| * MeasureTheory.volume K := by
      rw [MeasureTheory.Measure.addHaar_image_homothety, Module.finrank_fin_fun]
    have hfin : MeasureTheory.volume (K ∩ {x | ε ≤ x p}) ≠ ⊤ :=
      ne_top_of_le_ne_top
        (measure_Icc_lt_top (μ := MeasureTheory.volume) (a := fun _ : Fin L => (0 : ℝ))
          (b := fun _ => 1)).ne
        (MeasureTheory.measure_mono (fun x hx => hKsub hx.1))
    have hmono := MeasureTheory.measureReal_mono himg hfin
    have hreal : MeasureTheory.volume.real ((AffineMap.homothety z (1 - ε / z p)) '' K) =
        (1 - ε / z p) ^ L * MeasureTheory.volume.real K := by
      rw [MeasureTheory.measureReal_def, MeasureTheory.measureReal_def, hvol, ENNReal.toReal_mul,
        ENNReal.toReal_ofReal (abs_nonneg _), abs_of_nonneg (pow_nonneg hr0 L)]
    rw [hreal] at hmono
    exact hmono
  
  have hscale : ∀ (β : ℝ), 0 ≤ β → ∀ (M : ℕ) (t : ℝ), Real.exp 1 ≤ t →
      1 ≤ FordScale.coreDimension M t →
      4 * FordAnalysis.C * β * FordAnalysis.rho ^ M ≤ 1 →
      2 * (FordScale.coreDimension M t : ℝ) * (β / t) ≤
        FordAnalysis.rho ^ (FordScale.coreDimension M t) := by
    intro β hβ M t ht hL hM
    have hlogρ : Real.log FordAnalysis.rho < 0 := Real.log_neg hρ0 hρ1
    have hCdef : FordAnalysis.C = (2 * (-Real.log FordAnalysis.rho))⁻¹ := by
      show (2 * |Real.log FordAnalysis.rho|)⁻¹ = _
      rw [abs_of_neg hlogρ]
    have hC0 : 0 < FordAnalysis.C := by
      rw [hCdef]
      apply inv_pos.mpr
      linarith
    have hClam : 2 * FordAnalysis.C * (-Real.log FordAnalysis.rho) = 1 := by
      have hne : 2 * (-Real.log FordAnalysis.rho) ≠ 0 := by linarith
      rw [hCdef, mul_comm 2 _, mul_assoc, inv_mul_cancel₀ hne]
    have ht0 : 0 < t := lt_of_lt_of_le (Real.exp_pos 1) ht
    have hlogt : 1 ≤ Real.log t := by
      have h := Real.log_le_log (Real.exp_pos 1) ht
      rwa [Real.log_exp] at h
    have hℓ0 : 0 ≤ Real.log (Real.log t) := Real.log_nonneg hlogt
    have hℓ1 : Real.log (Real.log t) ≤ Real.log t - 1 := Real.log_le_sub_one_of_pos (by linarith)
    have ha0 : 0 ≤ 2 * FordAnalysis.C * (Real.log t - Real.log (Real.log t)) :=
      mul_nonneg (by linarith) (by linarith)
    have hopt : FordScale.optimalDimension t = FordScale.coreDimension M t + M := by
      have h : FordScale.coreDimension M t = FordScale.optimalDimension t - M := rfl
      omega
    have hLM : ((FordScale.coreDimension M t : ℕ) : ℝ) + (M : ℝ) ≤
        2 * FordAnalysis.C * (Real.log t - Real.log (Real.log t)) := by
      have h1 : ((FordScale.optimalDimension t : ℕ) : ℝ) ≤
          2 * FordAnalysis.C * (Real.log t - Real.log (Real.log t)) := Nat.floor_le ha0
      rw [hopt] at h1
      push_cast at h1
      exact h1
    have hpow : Real.log t / t ≤
        FordAnalysis.rho ^ (FordScale.coreDimension M t + M) := by
      rw [← Real.exp_log (pow_pos hρ0 (FordScale.coreDimension M t + M)), Real.log_pow]
      have hle : -(Real.log t - Real.log (Real.log t)) ≤
          ((FordScale.coreDimension M t + M : ℕ) : ℝ) * Real.log FordAnalysis.rho := by
        push_cast
        have h1 := mul_le_mul_of_nonneg_right hLM (by linarith : (0 : ℝ) ≤ -Real.log FordAnalysis.rho)
        have h2 : 2 * FordAnalysis.C * (Real.log t - Real.log (Real.log t)) *
            (-Real.log FordAnalysis.rho) = Real.log t - Real.log (Real.log t) := by
          linear_combination (Real.log t - Real.log (Real.log t)) * hClam
        nlinarith
      calc Real.log t / t = Real.exp (-(Real.log t - Real.log (Real.log t))) := by
            rw [neg_sub, Real.exp_sub, Real.exp_log (by linarith), Real.exp_log ht0]
        _ ≤ _ := Real.exp_le_exp.mpr hle
    have hρM : 0 < FordAnalysis.rho ^ M := pow_pos hρ0 M
    have hsplit : FordAnalysis.rho ^ (FordScale.coreDimension M t + M) =
        FordAnalysis.rho ^ (FordScale.coreDimension M t) * FordAnalysis.rho ^ M := pow_add _ _ _
    have h1 : Real.log t ≤ t * (FordAnalysis.rho ^ (FordScale.coreDimension M t) *
        FordAnalysis.rho ^ M) := by
      rw [← hsplit]
      rw [div_le_iff₀ ht0] at hpow
      linarith
    have h2 : 4 * FordAnalysis.C * β * Real.log t * FordAnalysis.rho ^ M ≤ Real.log t := by
      have h := mul_le_mul_of_nonneg_right hM (by linarith : (0 : ℝ) ≤ Real.log t)
      linarith
    have h3 : 4 * FordAnalysis.C * β * Real.log t ≤
        t * FordAnalysis.rho ^ (FordScale.coreDimension M t) := by
      by_contra hcon
      push_neg at hcon
      have h := mul_lt_mul_of_pos_right hcon hρM
      linarith
    have hLle : ((FordScale.coreDimension M t : ℕ) : ℝ) ≤ 2 * FordAnalysis.C * Real.log t := by
      have h : 2 * FordAnalysis.C * (Real.log t - Real.log (Real.log t)) ≤
          2 * FordAnalysis.C * Real.log t := by nlinarith
      have hM0 : (0 : ℝ) ≤ M := Nat.cast_nonneg M
      linarith
    have h4 : 2 * ((FordScale.coreDimension M t : ℕ) : ℝ) * β ≤
        t * FordAnalysis.rho ^ (FordScale.coreDimension M t) := by
      have h := mul_le_mul_of_nonneg_right hLle hβ
      linarith
    rw [mul_div_assoc', div_le_iff₀ ht0]
    linarith
  
  have hmain : ∀ (L : ℕ) (p : Fin L), p.val + 1 = L → ∀ (ε : ℝ), 0 ≤ ε →
      2 * (L : ℝ) * ε ≤ FordAnalysis.rho ^ L →
      FordGeometry.T L / 2 ≤
        MeasureTheory.volume.real (FordGeometry.polytope L (fun _ => 1) ∩ {x | ε ≤ x p}) := by
    intro L p hp ε hε0 hs
    have hL1 : 1 ≤ L := by omega
    have hρL : 0 < FordAnalysis.rho ^ L := pow_pos hρ0 L
    have hLr : (1 : ℝ) ≤ L := by exact_mod_cast hL1
    have hεle : ε ≤ FordAnalysis.rho ^ L := by nlinarith
    have hz := hmem L
    have hzp : FordAnalysis.rho ^ (p.val + 1) = FordAnalysis.rho ^ L := by
      rw [hp]
    have hKsub : FordGeometry.polytope L (fun _ => (1 : ℝ)) ⊆
        Set.Icc (fun _ => (0 : ℝ)) (fun _ => 1) :=
      fun x hx => ⟨fun i => hx.1 i, fun i => hx.2.1 i⟩
    have hc := hcap L _ (hconv L) hKsub _ hz p ε hε0 (by rw [hzp]; exact hεle)
      (by rw [hzp]; exact hρL)
    rw [hzp] at hc
    have hq0 : 0 ≤ ε / FordAnalysis.rho ^ L := div_nonneg hε0 hρL.le
    have hLq : (L : ℝ) * (ε / FordAnalysis.rho ^ L) ≤ 1 / 2 := by
      rw [← mul_div_assoc, div_le_iff₀ hρL]
      linarith
    have hq1 : ε / FordAnalysis.rho ^ L ≤ 1 / 2 := by nlinarith
    have hbern := one_add_mul_le_pow (show (-2 : ℝ) ≤ -(ε / FordAnalysis.rho ^ L) by linarith) L
    have hT0 : 0 ≤ MeasureTheory.volume.real (FordGeometry.polytope L (fun _ => (1 : ℝ))) :=
      MeasureTheory.measureReal_nonneg
    have hhalf : (1 : ℝ) / 2 ≤ (1 - ε / FordAnalysis.rho ^ L) ^ L := by
      have he : (1 + -(ε / FordAnalysis.rho ^ L)) = 1 - ε / FordAnalysis.rho ^ L := by ring
      rw [he] at hbern
      linarith
    unfold FordGeometry.T
    nlinarith [mul_le_mul_of_nonneg_right hhalf hT0]
  
  intro β hβ
  have hev : ∀ᶠ M : ℕ in atTop, 4 * FordAnalysis.C * β * FordAnalysis.rho ^ M ≤ 1 := by
    have h := (tendsto_pow_atTop_nhds_zero_of_lt_one hρ0.le hρ1).const_mul (4 * FordAnalysis.C * β)
    rw [mul_zero] at h
    exact h.eventually (ge_mem_nhds zero_lt_one)
  filter_upwards [hev] with M hM
  filter_upwards [eventually_ge_atTop (Real.exp 1)] with t ht
  intro p hp
  have hL1 : 1 ≤ FordScale.coreDimension M t := by omega
  have ht0 : 0 < t := lt_of_lt_of_le (Real.exp_pos 1) ht
  exact hmain _ p hp (β / t) (div_nonneg hβ ht0.le) (hscale β hβ M t ht hL1 hM)

theorem core_tupleIntegers_size_bounds (hRHO : 0 < FordAnalysis.rho ∧ FordAnalysis.rho < 3 / 4 ∧ FordAnalysis.F FordAnalysis.rho = 1)
    (M : ℕ) : ∀ᶠ y : ℝ in atTop,
      ∀ (p : Fin (FordScale.coreDimension M (logLog y))) (A : ℝ) (n : ℕ),
        n ∈ FordReciprocal.tupleIntegers (FordScale.coreDimension M (logLog y)) (logLog y)
          (FordInner.innerSeed (FordInner.targetParameter (FordScale.coreDimension M (logLog y)) M) p
            (A / logLog y)) →
        0 < n ∧ (n : ℝ) ≤ y ^ (1 / 40 : ℝ) ∧
          Real.log (n : ℝ) ≤ (4 * Real.log (logLog y) / logLog y) * Real.exp (logLog y) :=
by
  
  have s1 : ∀ (L : ℕ) (ξ : ℕ → ℝ) (p : Fin L) (α t : ℝ) (n : ℕ), 0 < t →
      n ∈ FordReciprocal.tupleIntegers L t (FordInner.innerSeed ξ p α) →
      0 < n ∧ Real.log (n : ℝ) ≤ (L : ℝ) * Real.exp (t * ξ 0) := by
    intro L ξ p α t n ht hn
    unfold FordReciprocal.tupleIntegers at hn
    obtain ⟨hIcc, q, hprod, hq, _hanti, hx⟩ := Finset.mem_filter.mp hn
    have hn0 : 0 < n := (Finset.mem_Icc.mp hIcc).1
    refine ⟨hn0, ?_⟩
    have p0lt : 0 < L := lt_of_le_of_lt (Nat.zero_le _) p.isLt
    let p0 : Fin L := ⟨0, p0lt⟩
    have hantiX : Antitone (FordReciprocal.tuplePoint t q) := hx.1.1.2.2.1
    have htop : FordReciprocal.tuplePoint t q p0 ≤ ξ 0 := hx.2 p0 rfl
    have hentry : ∀ idx, Real.log (q idx : ℝ) ≤ Real.exp (t * ξ 0) := by
      intro idx
      have hle : p0 ≤ idx := Fin.le_iff_val_le_val.mpr (Nat.zero_le _)
      have h1 : FordReciprocal.tuplePoint t q idx ≤ ξ 0 := (hantiX hle).trans htop
      have h2 : max 0 (logLog (q idx : ℝ)) ≤ ξ 0 * t := by
        have h1' : max 0 (logLog (q idx : ℝ)) / t ≤ ξ 0 := h1
        exact (div_le_iff₀ ht).mp h1'
      have h3 : Real.log (Real.log (q idx : ℝ)) ≤ ξ 0 * t := (le_max_right _ _).trans h2
      rcases hq idx with hp | h1'
      · have hq1 : (1 : ℝ) < (q idx : ℝ) := by exact_mod_cast hp.one_lt
        have hlpos : 0 < Real.log (q idx : ℝ) := Real.log_pos hq1
        have h4 := (Real.log_le_iff_le_exp hlpos).mp h3
        rw [mul_comm]
        exact h4
      · rw [h1', Nat.cast_one, Real.log_one]
        exact (Real.exp_pos _).le
    have hcast : (n : ℝ) = ∏ idx, (q idx : ℝ) := by rw [← hprod, Nat.cast_prod]
    have hne : ∀ idx ∈ (Finset.univ : Finset (Fin L)), (q idx : ℝ) ≠ 0 := by
      intro idx _
      rcases hq idx with hp | h1'
      · exact_mod_cast hp.ne_zero
      · rw [h1']
        norm_num
    rw [hcast, Real.log_prod hne]
    calc ∑ idx, Real.log (q idx : ℝ) ≤ ∑ _idx : Fin L, Real.exp (t * ξ 0) :=
          Finset.sum_le_sum (fun idx _ => hentry idx)
      _ = (L : ℝ) * Real.exp (t * ξ 0) := by simp
  
  have hRHO' := hRHO
  have s2 : ∀ᶠ t : ℝ in atTop, 0 < t ∧ 4 * Real.log t / t ≤ 1 / 40 ∧
      (FordScale.coreDimension M t : ℝ) *
          Real.exp (t * FordInner.targetParameter (FordScale.coreDimension M t) M 0) ≤
        (4 * Real.log t / t) * Real.exp t := by
    have F3 : ∀ᶠ t : ℝ in atTop, 1250 * Real.log t ^ 4 ≤ t := by
      have h := ((Real.isLittleO_pow_log_id_atTop (n := 4)).const_mul_left 1250).bound one_pos
      filter_upwards [h, eventually_ge_atTop (0 : ℝ)] with t ht ht0
      simp only [Real.norm_eq_abs, id_eq, one_mul, abs_of_nonneg ht0] at ht
      exact (le_abs_self _).trans ht
    filter_upwards [eventually_ge_atTop (Real.exp 1),
      Real.tendsto_log_atTop.eventually_ge_atTop (M : ℝ), F3] with t h1 h2 h3
    have ht : 0 < t := lt_of_lt_of_le (Real.exp_pos 1) h1
    have hl1 : 1 ≤ Real.log t := by
      have := Real.log_le_log (Real.exp_pos 1) h1
      rwa [Real.log_exp] at this
    have hl0 : 0 ≤ Real.log t := by linarith
    have hl4 : Real.log t ≤ Real.log t ^ 4 := by
      have : 1 ≤ Real.log t ^ 3 := one_le_pow₀ hl1
      nlinarith
    refine ⟨ht, ?_, ?_⟩
    · rw [div_le_iff₀ ht]
      nlinarith
    · have hdim : (FordScale.coreDimension M t : ℝ) ≤ 4 * Real.log t := by
        have hρ0 := hRHO'.1
        have hρ1 := hRHO'.2.1
        have hlog34 : Real.log (3 / 4) < -1 / 4 := by
          rw [Real.log_lt_iff_lt_exp (by norm_num)]
          have := Real.add_one_lt_exp (x := (-1 / 4 : ℝ)) (by norm_num)
          linarith
        have hlρ : Real.log FordAnalysis.rho < Real.log (3 / 4) := Real.log_lt_log hρ0 hρ1
        have habs : |Real.log FordAnalysis.rho| = -Real.log FordAnalysis.rho :=
          abs_of_neg (by linarith)
        have hapos : 0 < 2 * |Real.log FordAnalysis.rho| := by rw [habs]; linarith
        have hCdef : FordAnalysis.C = (2 * |Real.log FordAnalysis.rho|)⁻¹ := rfl
        have hCpos : 0 < FordAnalysis.C := by rw [hCdef]; exact inv_pos.mpr hapos
        have hCmul : FordAnalysis.C * (2 * |Real.log FordAnalysis.rho|) = 1 := by
          rw [hCdef]; exact inv_mul_cancel₀ hapos.ne'
        have hClt : FordAnalysis.C < 2 := by
          rw [habs] at hCmul
          nlinarith
        have hloglogt : 0 ≤ Real.log (Real.log t) := Real.log_nonneg hl1
        have hsub : (FordScale.coreDimension M t : ℝ) ≤ (FordScale.optimalDimension t : ℝ) := by
          exact_mod_cast Nat.sub_le _ _
        refine hsub.trans ?_
        have hbound : 2 * FordAnalysis.C * (Real.log t - Real.log (Real.log t)) ≤
            4 * Real.log t := by
          nlinarith
        unfold FordScale.optimalDimension
        by_cases hu : 0 ≤ 2 * FordAnalysis.C * (Real.log t - Real.log (Real.log t))
        · exact (Nat.floor_le hu).trans hbound
        · rw [Nat.floor_of_nonpos (le_of_not_ge hu)]
          simp only [Nat.cast_zero]
          linarith
      rcases Nat.eq_zero_or_pos (FordScale.coreDimension M t) with hL | hL
      · rw [hL, Nat.cast_zero, zero_mul]
        positivity
      · have hT : FordInner.targetParameter (FordScale.coreDimension M t) M 0 =
            1 - 1 / (10 * ((M : ℝ) + (FordScale.coreDimension M t : ℝ)) ^ 3) := by
          simp only [FordInner.targetParameter, FordInner.baseLoss, if_pos hL, Nat.sub_zero,
            Nat.cast_add]
        rw [hT]
        have hLR : (1 : ℝ) ≤ (FordScale.coreDimension M t : ℝ) := by exact_mod_cast hL
        have hL0 : (0 : ℝ) ≤ (FordScale.coreDimension M t : ℝ) := by linarith
        have hM0 : (0 : ℝ) ≤ (M : ℝ) := Nat.cast_nonneg M
        have hD1 : 1 ≤ (M : ℝ) + (FordScale.coreDimension M t : ℝ) := by linarith
        have hD5 : (M : ℝ) + (FordScale.coreDimension M t : ℝ) ≤ 5 * Real.log t := by linarith
        have hD3 : ((M : ℝ) + (FordScale.coreDimension M t : ℝ)) ^ 3 ≤ (5 * Real.log t) ^ 3 :=
          pow_le_pow_left₀ (by linarith) hD5 3
        have hpos : 0 < 10 * ((M : ℝ) + (FordScale.coreDimension M t : ℝ)) ^ 3 := by positivity
        have hδ : Real.log t ≤ t / (10 * ((M : ℝ) + (FordScale.coreDimension M t : ℝ)) ^ 3) := by
          rw [le_div_iff₀ hpos]
          have hm : Real.log t * (10 * ((M : ℝ) + (FordScale.coreDimension M t : ℝ)) ^ 3) ≤
              Real.log t * (10 * (5 * Real.log t) ^ 3) :=
            mul_le_mul_of_nonneg_left (by linarith) hl0
          nlinarith
        have heq : t * (1 - 1 / (10 * ((M : ℝ) + (FordScale.coreDimension M t : ℝ)) ^ 3)) =
            t - t / (10 * ((M : ℝ) + (FordScale.coreDimension M t : ℝ)) ^ 3) := by ring
        have hexp : Real.exp (t * (1 - 1 / (10 * ((M : ℝ) +
            (FordScale.coreDimension M t : ℝ)) ^ 3))) ≤ Real.exp t / t := by
          calc Real.exp (t * (1 - 1 / (10 * ((M : ℝ) +
                (FordScale.coreDimension M t : ℝ)) ^ 3))) ≤ Real.exp (t - Real.log t) := by
