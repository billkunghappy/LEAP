      (∀ idx, (p idx).Prime) → (∀ idx, 3 ≤ p idx) → StrictAnti p →
      ((∏ idx, p idx).totient : ℝ) ≤ Z →
      (∀ idx j : Fin (L + 1), j.val = idx.val + 1 →
        (1 + (logLog Z) ^ (-1 / 100 : ℝ)) * logLog (p j) ≤ logLog (p idx)) →
      (p 0 : ℝ) ≤ Z ^ (9 / 10 : ℝ) → ((∏ idx, p idx : ℕ) : ℝ) ≤ Z ^ (19 / 20 : ℝ) :=
by
  have hLL : Tendsto logLog atTop atTop :=
    Real.tendsto_log_atTop.comp Real.tendsto_log_atTop
  
  have chain : ∀ (T δ : ℝ) (L : ℕ) (p : Fin (L + 1) → ℕ), 0 < δ → (∀ idx, 3 ≤ p idx) →
      StrictAnti p →
      (∀ idx j : Fin (L + 1), j.val = idx.val + 1 → (1 + δ) * logLog (p j) ≤ logLog (p idx)) →
      logLog (p 0) ≤ T →
      Real.log ((∏ idx, p idx : ℕ) : ℝ) ≤ Real.log (p 0) + (L : ℝ) * Real.exp (T / (1 + δ)) := by
    intro T δ L p hδ h3 ho hg hT
    have hpos : ∀ idx, (1 : ℝ) < p idx := fun idx => by
      have := h3 idx
      exact_mod_cast (by omega : 1 < p idx)
    have hlogpos : ∀ idx, 0 < Real.log (p idx) := fun idx => Real.log_pos (hpos idx)
    rw [Nat.cast_prod, Real.log_prod (fun idx _ => (by linarith [hpos idx] : (0 : ℝ) < p idx).ne')]
    rw [Fin.sum_univ_succ]
    have hterm : ∀ i : Fin L, Real.log (p i.succ) ≤ Real.exp (T / (1 + δ)) := by
      intro i
      have hgap := hg (Fin.castSucc i) (Fin.succ i) (by simp)
      have hanti : p (Fin.castSucc i) ≤ p 0 := ho.antitone (Fin.zero_le _)
      have hll : logLog (p (Fin.castSucc i)) ≤ logLog (p 0) := by
        unfold logLog
        apply Real.log_le_log (hlogpos _)
        apply Real.log_le_log (by linarith [hpos (Fin.castSucc i)])
        exact_mod_cast hanti
      have h1 : logLog (p i.succ) ≤ T / (1 + δ) := by
        rw [le_div_iff₀ (by linarith)]
        linarith [mul_comm (1 + δ) (logLog (p i.succ))]
      have h2 : Real.log (p i.succ) = Real.exp (logLog (p i.succ)) := by
        unfold logLog
        rw [Real.exp_log (hlogpos _)]
      rw [h2]
      exact Real.exp_le_exp.mpr h1
    have hsum := Finset.sum_le_sum (fun i (_ : i ∈ Finset.univ) => hterm i)
    simp only [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul] at hsum
    linarith
  
  have key : ∀ T : ℝ, 1 ≤ T → 320 * A ≤ T ^ (99 / 100 : ℝ) →
      20 * (A * Real.log T) * Real.exp (T / (1 + T ^ (-1 / 100 : ℝ))) ≤ Real.exp T := by
    intro T hT hu
    have hT0 : 0 < T := by linarith
    have hδ0 : 0 < T ^ (-1 / 100 : ℝ) := Real.rpow_pos_of_pos hT0 _
    have hδ1 : T ^ (-1 / 100 : ℝ) ≤ 1 := Real.rpow_le_one_of_one_le_of_nonpos hT (by norm_num)
    have hu0 : 0 ≤ T ^ (99 / 100 : ℝ) := Real.rpow_nonneg hT0.le _
