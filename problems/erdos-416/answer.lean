        Q.biUnion (fun q => (Finset.Icc 1 N).filter (fun n => q ^ 2 ∣ n ∨ q ^ 2 ∣ n.totient)) := by
      intro n hn
      obtain ⟨hnN, q, hq, hHq, hsq⟩ := Finset.mem_filter.mp hn
      have hnpos : 0 < n := (Finset.mem_Icc.mp hnN).1
      have hqle : q ≤ N := by
        have hsqn : q ^ 2 ≤ n := by
          rcases hsq with hs | hs
          · exact Nat.le_of_dvd hnpos hs
          · exact (Nat.le_of_dvd (Nat.totient_pos.mpr hnpos) hs).trans (Nat.totient_le n)
        exact (Nat.le_self_pow two_ne_zero q).trans (hsqn.trans (Finset.mem_Icc.mp hnN).2)
      have hfl : ⌊H⌋₊ < q := (Nat.floor_lt hH.le).mpr hHq
      exact Finset.mem_biUnion.mpr ⟨q,
        Finset.mem_filter.mpr ⟨Finset.mem_Ioo.mpr ⟨hfl, by omega⟩, hq⟩,
        Finset.mem_filter.mpr ⟨hnN, hsq⟩⟩
    have hsum : (((Finset.Icc 1 N).filter (fun n => ∃ q : ℕ, q.Prime ∧ H < (q : ℝ) ∧
        (q ^ 2 ∣ n ∨ q ^ 2 ∣ n.totient))).card : ℝ) ≤
        ∑ q ∈ Q, (((Finset.Icc 1 N).filter (fun n => q ^ 2 ∣ n ∨ q ^ 2 ∣ n.totient)).card : ℝ) := by
      exact_mod_cast (Finset.card_le_card hcover).trans Finset.card_biUnion_le
    have htail : (∑ q ∈ Q, (1 : ℝ) / (q : ℝ) ^ 2) ≤ 2 / H := by
      calc (∑ q ∈ Q, (1 : ℝ) / (q : ℝ) ^ 2)
          ≤ ∑ i ∈ Finset.Ioo ⌊H⌋₊ (N + 1), ((i : ℝ) ^ 2)⁻¹ := by
            simp only [one_div]
            exact Finset.sum_le_sum_of_subset_of_nonneg (Finset.filter_subset _ _)
              (fun i _ _ => by positivity)
        _ ≤ 2 / ((⌊H⌋₊ : ℝ) + 1) := sum_Ioo_inv_sq_le _ _
        _ ≤ 2 / H := div_le_div_of_nonneg_left (by norm_num) hH (Nat.lt_floor_add_one H).le
    calc
      _ ≤ _ := hsum
      _ ≤ ∑ q ∈ Q, 3 * N * (1 + Real.log N) ^ 2 / (q : ℝ) ^ 2 := by
        apply Finset.sum_le_sum
        intro q hq
        exact hbad N q (Finset.mem_filter.mp hq).2
      _ = (3 * N * (1 + Real.log N) ^ 2) * (∑ q ∈ Q, (1 : ℝ) / (q : ℝ) ^ 2) := by
        rw [Finset.mul_sum]
        apply Finset.sum_congr rfl
        intro q _
        ring
      _ ≤ (3 * N * (1 + Real.log N) ^ 2) * (2 / H) :=
        mul_le_mul_of_nonneg_left htail (by positivity)
      _ = _ := by ring
  
  have hlim : Tendsto (fun Y : ℝ => Real.log (Real.log Y) ^ 3 / (1 * Real.log Y + 0))
      atTop (𝓝 0) :=
    (Real.tendsto_pow_log_div_mul_add_atTop 1 0 3 one_ne_zero).comp Real.tendsto_log_atTop
  have hsmall := hlim.eventually_lt_const (show (0 : ℝ) < 1 / (96 * c) by positivity)
  filter_upwards [hsmall, eventually_ge_atTop c, eventually_gt_atTop (1 : ℝ),
    Real.tendsto_log_atTop.eventually_gt_atTop 1] with Y h96 hYc hY1 hl1
  have hTdef : logLog Y = Real.log (Real.log Y) := rfl
  set ℓ := Real.log Y with hℓ
  set T := logLog Y with hT
  have hℓ0 : 0 < ℓ := by linarith
  have hT0 : 0 < T := by rw [hTdef]; exact Real.log_pos hl1
  have hTℓ : T ≤ ℓ := by
    rw [hTdef]
    have := Real.log_le_sub_one_of_pos hℓ0
    linarith
  have hℓY : ℓ ≤ Y := by
    have := Real.log_le_sub_one_of_pos (show (0 : ℝ) < Y by linarith)
    linarith
  have hY0 : 0 < Y := by linarith
  have h96' : 96 * c * T ^ 3 ≤ ℓ := by
    rw [one_mul, add_zero, div_lt_iff₀ hℓ0] at h96
    rw [hTdef]
    have hk : 96 * c * (1 / (96 * c) * ℓ) = ℓ := by field_simp
    nlinarith
  have hH : 0 < ℓ ^ 4 := by positivity
  refine (hlarge _ _ hH).trans ?_
  set N := ⌊c * Y * T⌋₊ with hNdef
  have hNle : (N : ℝ) ≤ c * Y * T := Nat.floor_le (by positivity)
  rcases Nat.eq_zero_or_pos N with hN0 | hNpos
  · rw [hN0]
    simp only [Nat.cast_zero, mul_zero, zero_mul, zero_div]
    positivity
  have hNR : (1 : ℝ) ≤ N := by exact_mod_cast hNpos
  have hNY : (N : ℝ) ≤ Y ^ 3 := by
    calc (N : ℝ) ≤ c * Y * T := hNle
      _ ≤ Y * Y * Y := by
        apply mul_le_mul (mul_le_mul_of_nonneg_right hYc hY0.le) (hTℓ.trans hℓY) hT0.le
        positivity
      _ = Y ^ 3 := by ring
  have hlogN : Real.log N ≤ 3 * ℓ := by
    have := Real.log_le_log (by linarith) hNY
    rw [Real.log_pow] at this
    push_cast at this
    linarith
  have hlogN0 : 0 ≤ Real.log N := Real.log_natCast_nonneg N
  have hL2 : (1 + Real.log N) ^ 2 ≤ 16 * ℓ ^ 2 := by nlinarith
  have h1 : 6 * (N : ℝ) * (1 + Real.log N) ^ 2 ≤ 96 * c * Y * T * ℓ ^ 2 := by
    have := mul_le_mul hNle hL2 (sq_nonneg _) (by positivity)
    nlinarith
  rw [div_le_div_iff₀ hH (by positivity)]
  calc 6 * (N : ℝ) * (1 + Real.log N) ^ 2 * (ℓ * T ^ 2)
      ≤ 96 * c * Y * T * ℓ ^ 2 * (ℓ * T ^ 2) := mul_le_mul_of_nonneg_right h1 (by positivity)
    _ = (Y * ℓ ^ 3) * (96 * c * T ^ 3) := by ring
    _ ≤ (Y * ℓ ^ 3) * ℓ := mul_le_mul_of_nonneg_left h96' (by positivity)
    _ = Y * ℓ ^ 4 := by ring

theorem nonnormal_totients_finite_bound : ∃ K : ℝ, 0 < K ∧ ∀ (S x A C : ℝ), Real.exp 1 ≤ S → 16 ≤ x → 1 ≤ A → 0 ≤ C →
      (∀ u : ℝ, 2 ≤ u → u ≤ x → ((totientsUpTo u).card : ℝ) ≤ A * u / Real.log u) →
      (∀ z : ℝ, 3 ≤ z → z ≤ 2 * x →
        (((Finset.Iic ⌊z⌋₊).filter (fun p => p.Prime ∧ ¬ SNormal S p)).card : ℝ) ≤
          C * z / Real.log z * (1 + Real.log (Real.log z)) ^ 5 *
            Real.exp (-Real.log (Real.log S) / 6)) →
      (((totientsUpTo x).filter (fun m => ∃ n : ℕ, 0 < n ∧ n.totient = m ∧
          ∃ q : ℕ, q.Prime ∧ q ∣ n ∧ ¬ SNormal S q)).card : ℝ) ≤
        K * C * A * x / Real.log x * (1 + Real.log (Real.log x)) ^ 6 *
          Real.exp (-Real.log (Real.log S) / 6) :=
by
  obtain ⟨K₁, hK₁, hR⟩ := reciprocal_sum_of_density
  
  have s1 : ∀ (S x : ℝ), 1 ≤ x →
      (((totientsUpTo x).filter (fun m => ∃ n : ℕ, 0 < n ∧ n.totient = m ∧
          ∃ q : ℕ, q.Prime ∧ q ∣ n ∧ ¬ SNormal S q)).card : ℝ) ≤
        2 * (((((Finset.Iic ⌊2 * x⌋₊).filter (fun p => p.Prime ∧ ¬ SNormal S p)) ×ˢ
          totientsUpTo x).filter (fun pt : ℕ × ℕ => (((pt.1 - 1) * pt.2 : ℕ) : ℝ) ≤ x)).card : ℝ) := by
    intro S x hx
    set B := (totientsUpTo x).filter (fun m => ∃ n : ℕ, 0 < n ∧ n.totient = m ∧
          ∃ q : ℕ, q.Prime ∧ q ∣ n ∧ ¬ SNormal S q) with hB
    set P := ((((Finset.Iic ⌊2 * x⌋₊).filter (fun p => p.Prime ∧ ¬ SNormal S p)) ×ˢ totientsUpTo x).filter
          (fun pt : ℕ × ℕ => (((pt.1 - 1) * pt.2 : ℕ) : ℝ) ≤ x)) with hP
    have hx0 : (0:ℝ) ≤ x := by linarith
    have hsub : B ⊆ P.image (fun pt : ℕ × ℕ => (pt.1 - 1) * pt.2) ∪
        P.image (fun pt : ℕ × ℕ => pt.1 * pt.2) := by
      intro m hm
      rw [hB, Finset.mem_filter] at hm
      obtain ⟨hmT, n, hn, hnm, q, hq, hqn, hqS⟩ := hm
      have hmT' := hmT
      simp only [totientsUpTo, Finset.mem_filter, Finset.mem_Icc] at hmT'
      obtain ⟨⟨hm1, hmx⟩, _⟩ := hmT'
      have hmxr : (m : ℝ) ≤ x := (Nat.le_floor_iff hx0).mp hmx
      obtain ⟨n', hnq⟩ := hqn
      have hn'pos : 0 < n' := by
        rcases Nat.eq_zero_or_pos n' with h | h
        · rw [h, mul_zero] at hnq; omega
        · exact h
      have ht1 : 1 ≤ n'.totient := Nat.totient_pos.mpr hn'pos
      have hq2 := hq.two_le
      have hkey : m = (q - 1) * n'.totient ∨ m = q * n'.totient := by
        by_cases hd : q ∣ n'
        · right
          rw [← hnm, hnq, Nat.totient_mul_of_prime_of_dvd hq hd]
        · left
          have hcop : Nat.Coprime q n' := (Nat.Prime.coprime_iff_not_dvd hq).mpr hd
          rw [← hnm, hnq, Nat.totient_mul hcop, Nat.totient_prime hq]
      have hle : (q - 1) * n'.totient ≤ m := by
        rcases hkey with h | h
        · omega
        · rw [h]; exact Nat.mul_le_mul_right _ (Nat.sub_le q 1)
      have htm : n'.totient ≤ m := le_trans (Nat.le_mul_of_pos_left _ (by omega)) hle
      have hqm : q - 1 ≤ m := le_trans (Nat.le_mul_of_pos_right _ ht1) hle
      have hmem : (q, n'.totient) ∈ P := by
        rw [hP, Finset.mem_filter, Finset.mem_product]
        refine ⟨⟨?_, ?_⟩, ?_⟩
        · rw [Finset.mem_filter, Finset.mem_Iic]
          refine ⟨?_, hq, hqS⟩
          apply Nat.le_floor
          have : (q : ℝ) ≤ m + 1 := by exact_mod_cast (by omega : q ≤ m + 1)
          push_cast
          linarith
        · simp only [totientsUpTo, Finset.mem_filter, Finset.mem_Icc]
          exact ⟨⟨ht1, le_trans htm hmx⟩, n', rfl⟩
        · show (((q - 1) * n'.totient : ℕ) : ℝ) ≤ x
          exact (Nat.cast_le.mpr hle).trans hmxr
      rw [Finset.mem_union]
      rcases hkey with h | h
      · left; exact Finset.mem_image.mpr ⟨(q, n'.totient), hmem, h.symm⟩
      · right; exact Finset.mem_image.mpr ⟨(q, n'.totient), hmem, h.symm⟩
    have h1 := Finset.card_le_card hsub
    have h2 := Finset.card_union_le (P.image (fun pt : ℕ × ℕ => (pt.1 - 1) * pt.2))
      (P.image (fun pt : ℕ × ℕ => pt.1 * pt.2))
    have h3 := Finset.card_image_le (s := P) (f := fun pt : ℕ × ℕ => (pt.1 - 1) * pt.2)
    have h4 := Finset.card_image_le (s := P) (f := fun pt : ℕ × ℕ => pt.1 * pt.2)
    have hnat : B.card ≤ 2 * P.card := by omega
    exact_mod_cast hnat
  
  have s2 : ∀ (x A : ℝ) (Q : Finset ℕ), 16 ≤ x → 0 ≤ A → (∀ p ∈ Q, 2 ≤ p) →
      (∀ u : ℝ, 2 ≤ u → u ≤ x → ((totientsUpTo u).card : ℝ) ≤ A * u / Real.log u) →
      ((((Q ×ˢ totientsUpTo x).filter (fun pt : ℕ × ℕ => (((pt.1 - 1) * pt.2 : ℕ) : ℝ) ≤ x)).filter
          (fun pt : ℕ × ℕ => (pt.1 : ℝ) ≤ Real.sqrt x)).card : ℝ) ≤
        4 * A * x / Real.log x * ∑ p ∈ Q.filter (fun p : ℕ => (p : ℝ) ≤ Real.sqrt x), (1 : ℝ) / p := by
    intro x A Q hx hA hQ henv
    set P₁ := ((Q ×ˢ totientsUpTo x).filter (fun pt : ℕ × ℕ => (((pt.1 - 1) * pt.2 : ℕ) : ℝ) ≤ x)).filter
          (fun pt : ℕ × ℕ => (pt.1 : ℝ) ≤ Real.sqrt x) with hP₁
    set Q₁ := Q.filter (fun p : ℕ => (p : ℝ) ≤ Real.sqrt x) with hQ₁
    have hx0 : 0 < x := by linarith
    have hlogx : 0 < Real.log x := Real.log_pos (by linarith)
    have hs16 : Real.sqrt 16 = 4 := by
      rw [show (16:ℝ) = 4 ^ 2 by norm_num, Real.sqrt_sq (by norm_num)]
    have hr4 : 4 ≤ Real.sqrt x := by
      rw [← hs16]; exact Real.sqrt_le_sqrt hx
    have hrr : Real.sqrt x * Real.sqrt x = x := Real.mul_self_sqrt hx0.le
    have hmaps : ∀ pt ∈ P₁, pt.1 ∈ Q₁ := by
      intro pt hpt
      rw [hP₁, Finset.mem_filter, Finset.mem_filter, Finset.mem_product] at hpt
      rw [hQ₁, Finset.mem_filter]
      exact ⟨hpt.1.1.1, hpt.2⟩
    have hcard : P₁.card = ∑ p ∈ Q₁, (P₁.filter (fun pt => pt.1 = p)).card :=
      Finset.card_eq_sum_card_fiberwise hmaps
    have hfib : ∀ p ∈ Q₁, ((P₁.filter (fun pt => pt.1 = p)).card : ℝ) ≤
        4 * A * x / Real.log x * (1 / (p : ℝ)) := by
      intro p hp
      obtain ⟨hpQ, hpr⟩ := Finset.mem_filter.mp hp
      have hp2 := hQ p hpQ
      have hp2r : (2:ℝ) ≤ p := by exact_mod_cast hp2
      have hdcast : ((p - 1 : ℕ) : ℝ) = (p : ℝ) - 1 := by
        rw [Nat.cast_sub (by omega)]; simp
      have hd1 : (1:ℝ) ≤ (p : ℝ) - 1 := by linarith
      set u := x / ((p : ℝ) - 1) with hu
      have hsub : (P₁.filter (fun pt => pt.1 = p)).card ≤ (totientsUpTo u).card := by
        apply Finset.card_le_card_of_injOn (fun pt => pt.2)
        · rintro ⟨a, b⟩ hab
          simp only [Finset.mem_coe, hP₁, Finset.mem_filter, Finset.mem_product] at hab
          obtain ⟨⟨⟨⟨_, hbT⟩, hcond⟩, _⟩, hap⟩ := hab
          subst hap
          simp only [totientsUpTo, Finset.mem_filter, Finset.mem_Icc, Finset.mem_coe] at hbT ⊢
          obtain ⟨⟨hb1, _⟩, hbm⟩ := hbT
          refine ⟨⟨hb1, ?_⟩, hbm⟩
          apply Nat.le_floor
          rw [Nat.cast_mul, hdcast] at hcond
          rw [hu, le_div_iff₀ (by linarith)]
          linarith
        · rintro ⟨a, b⟩ hab ⟨a', b'⟩ hab' heq
          simp only [Finset.mem_coe, Finset.mem_filter] at hab hab'
          simp only at heq hab hab'
          rw [hab.2, hab'.2, heq]
      have hux : u ≤ x := div_le_self hx0.le hd1
      have hur : Real.sqrt x ≤ u := by
        rw [hu, le_div_iff₀ (by linarith)]
        nlinarith [Real.sqrt_nonneg x]
      have hu2 : 2 ≤ u := by linarith
      have hu0 : 0 < u := by linarith
      have hlogu : Real.log x / 2 ≤ Real.log u := by
        rw [← Real.log_sqrt hx0.le]; exact Real.log_le_log (by linarith) hur
      have henvu := henv u hu2 hux
      have hstep1 : A * u / Real.log u ≤ A * u / (Real.log x / 2) :=
        div_le_div_of_nonneg_left (by positivity) (by positivity) hlogu
      have hup : u ≤ 2 * x / p := by
        rw [hu, div_le_div_iff₀ (by linarith) (by linarith)]
        nlinarith
      calc ((P₁.filter (fun pt => pt.1 = p)).card : ℝ) ≤ (totientsUpTo u).card := by
            exact_mod_cast hsub
        _ ≤ A * u / Real.log u := henvu
        _ ≤ A * u / (Real.log x / 2) := hstep1
        _ ≤ A * (2 * x / p) / (Real.log x / 2) := by gcongr
        _ = 4 * A * x / Real.log x * (1 / (p : ℝ)) := by field_simp; ring
    rw [hcard, Nat.cast_sum, Finset.mul_sum]
    exact Finset.sum_le_sum hfib
  
  have s3 : ∀ (x D : ℝ) (Q : Finset ℕ), 16 ≤ x → 0 ≤ D →
      (∀ u : ℝ, 2 ≤ u → u ≤ 2 * x →
        ((Q.filter (fun q : ℕ => (q : ℝ) ≤ u)).card : ℝ) ≤ D * u / Real.log u) →
      ((((Q ×ˢ totientsUpTo x).filter (fun pt : ℕ × ℕ => (((pt.1 - 1) * pt.2 : ℕ) : ℝ) ≤ x)).filter
          (fun pt : ℕ × ℕ => ¬ (pt.1 : ℝ) ≤ Real.sqrt x)).card : ℝ) ≤
        8 * D * x / Real.log x * ∑ t ∈ totientsUpTo (2 * Real.sqrt x), (1 : ℝ) / t := by
    intro x D Q hx hD hdens
    set P₂ := ((Q ×ˢ totientsUpTo x).filter (fun pt : ℕ × ℕ => (((pt.1 - 1) * pt.2 : ℕ) : ℝ) ≤ x)).filter
          (fun pt : ℕ × ℕ => ¬ (pt.1 : ℝ) ≤ Real.sqrt x) with hP₂
    have hx0 : 0 < x := by linarith
    have hlogx : 0 < Real.log x := Real.log_pos (by linarith)
    have hs16 : Real.sqrt 16 = 4 := by
      rw [show (16:ℝ) = 4 ^ 2 by norm_num, Real.sqrt_sq (by norm_num)]
    have hr4 : 4 ≤ Real.sqrt x := by
      rw [← hs16]; exact Real.sqrt_le_sqrt hx
    have hrr : Real.sqrt x * Real.sqrt x = x := Real.mul_self_sqrt hx0.le
    set r := Real.sqrt x with hr
    have hcastc : ∀ a b : ℕ, r < (a : ℝ) →
        (((a - 1) * b : ℕ) : ℝ) = ((a : ℝ) - 1) * b := by
      intro a b har
      have ha1 : 1 ≤ a := by
        have : (1:ℝ) ≤ a := by linarith
        exact_mod_cast this
      rw [Nat.cast_mul, Nat.cast_sub ha1]; simp
    have hmaps : ∀ pt ∈ P₂, pt.2 ∈ totientsUpTo (2 * r) := by
      rintro ⟨a, b⟩ hpt
      rw [hP₂, Finset.mem_filter, Finset.mem_filter, Finset.mem_product] at hpt
      obtain ⟨⟨⟨_, hbT⟩, hcond⟩, har⟩ := hpt
      simp only at har hcond hbT ⊢
      push_neg at har
      rw [hcastc a b har] at hcond
      simp only [totientsUpTo, Finset.mem_filter, Finset.mem_Icc] at hbT ⊢
      obtain ⟨⟨hb1, _⟩, hbm⟩ := hbT
      refine ⟨⟨hb1, ?_⟩, hbm⟩
      apply Nat.le_floor
      have hb0 : (0:ℝ) ≤ b := Nat.cast_nonneg b
      by_contra hcon
      push_neg at hcon
      have h1 : r / 2 * (b : ℝ) ≤ ((a : ℝ) - 1) * b :=
        mul_le_mul_of_nonneg_right (by linarith) hb0
      have h2 : r / 2 * (2 * r) < r / 2 * (b : ℝ) :=
        mul_lt_mul_of_pos_left hcon (by linarith)
      nlinarith
    have hcard : P₂.card = ∑ t ∈ totientsUpTo (2 * r), (P₂.filter (fun pt => pt.2 = t)).card :=
      Finset.card_eq_sum_card_fiberwise hmaps
    have hlog4 : Real.log x / 4 ≤ Real.log (r / 2) := by
      have hlx : Real.log x = 2 * Real.log r := by
        rw [← hrr, Real.log_mul (by linarith) (by linarith)]; ring
      have hl2 : Real.log (r / 2) = Real.log r - Real.log 2 := Real.log_div (by linarith) (by norm_num)
      have hl4 : Real.log 4 ≤ Real.log r := Real.log_le_log (by norm_num) hr4
      have hl4' : Real.log 4 = 2 * Real.log 2 := by
        rw [show (4:ℝ) = 2 * 2 by norm_num, Real.log_mul (by norm_num) (by norm_num)]; ring
      rw [hlx, hl2]; linarith
    have hfib : ∀ t ∈ totientsUpTo (2 * r), ((P₂.filter (fun pt => pt.2 = t)).card : ℝ) ≤
        8 * D * x / Real.log x * (1 / (t : ℝ)) := by
      intro t ht
      have ht' := ht
      simp only [totientsUpTo, Finset.mem_filter, Finset.mem_Icc] at ht'
      obtain ⟨⟨ht1, ht2r⟩, _⟩ := ht'
      have ht1r : (1:ℝ) ≤ t := by exact_mod_cast ht1
      have ht2r' : (t : ℝ) ≤ 2 * r := (Nat.le_floor_iff (by linarith)).mp ht2r
      have ht0 : (0:ℝ) < t := by linarith
      set u := x / t + 1 with hu
      have hsub : (P₂.filter (fun pt => pt.2 = t)).card ≤
          (Q.filter (fun q : ℕ => (q : ℝ) ≤ u)).card := by
        apply Finset.card_le_card_of_injOn (fun pt => pt.1)
        · rintro ⟨a, b⟩ hab
          simp only [Finset.mem_coe, hP₂, Finset.mem_filter, Finset.mem_product] at hab
          obtain ⟨⟨⟨⟨haQ, _⟩, hcond⟩, har⟩, hbt⟩ := hab
          subst hbt
          push_neg at har
          rw [hcastc a b har] at hcond
          simp only [Finset.mem_coe, Finset.mem_filter]
          refine ⟨haQ, ?_⟩
          have : (a : ℝ) - 1 ≤ x / b := by
            rw [le_div_iff₀ ht0]; linarith
          rw [hu]; linarith
        · rintro ⟨a, b⟩ hab ⟨a', b'⟩ hab' heq
          simp only [Finset.mem_coe, Finset.mem_filter] at hab hab'
          simp only at heq hab hab'
          rw [hab.2, hab'.2, heq]
      have hxt_lo : r / 2 ≤ x / t := by
        rw [le_div_iff₀ ht0]; nlinarith
      have hxt_hi : x / t ≤ x := div_le_self hx0.le ht1r
      have hu2 : 2 ≤ u := by rw [hu]; linarith
      have hu2x : u ≤ 2 * x := by rw [hu]; linarith
      have hu0 : 0 < u := by linarith
      have hulog : Real.log x / 4 ≤ Real.log u :=
        hlog4.trans (Real.log_le_log (by linarith) (by rw [hu]; linarith))
      have hlogu0 : 0 < Real.log x / 4 := by positivity
