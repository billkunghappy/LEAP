  have huone : 1 ≤ u := le_trans he1 hu1
  have hL : Real.exp 1 ≤ Real.log u := (Real.le_log_iff_exp_le hu0).mpr hu
  have hδ : (2 : ℝ) / 3 < Real.log 2 := by have := Real.log_two_gt_d9; linarith
  have hδ0 : 0 < Real.log 2 := by linarith
  
