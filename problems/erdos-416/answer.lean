      MeasureTheory.measureReal_mono hlow
        ((MeasureTheory.measure_mono Set.inter_subset_left).trans_lt hKfin.lt_top).ne
    have h1r : 1 - r ≤ B - a := by
      have : 1 - r = (B - a) / B := by
        rw [hrdef]; field_simp
      rw [this]
      exact div_le_self (by linarith) hB1
    have hL0 : (0 : ℝ) ≤ L := Nat.cast_nonneg L
    have hcoef : (L : ℝ) * (1 - r) ≤ 2 * L * (δ + ξ 0 - 1 + W * τ) := by
      have := mul_le_mul_of_nonneg_left h1r hL0
      nlinarith
    have hA := mul_le_mul_of_nonneg_right hbern hKnn
    have hB' := mul_le_mul_of_nonneg_right hcoef hKnn
    nlinarith

theorem expanded_core_thickened_volume_le_T (hPNT : Tendsto (fun x : ℝ => (Nat.primeCounting ⌊x⌋₊ : ℝ) / (x / Real.log x)) atTop (𝓝 1))
