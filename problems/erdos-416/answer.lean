  exact (hs4 n u hu hux').trans (mono _ _ u hu hn2)

theorem envelope_five_log_omega_small (hMERT : ∃ C : ℝ, ∀ x : ℝ, 2 ≤ x →
      |(∑ p ∈ (Finset.Iic ⌊x⌋₊).filter Nat.Prime, (1 : ℝ) / p) - Real.log (Real.log x)| ≤ C) :
    ∀ᶠ x : ℝ in atTop, ((fiveLogOmegaTotients x).card : ℝ) ≤ x / Real.log x :=
by
  obtain ⟨K, hK, htail⟩ := cardFactors_totient_tail hMERT weighted_totient_euler_bound
  
  have hlam : (744 / 1331 : ℝ) ≤ Real.log (7 / 4) := by
    have h := Real.sum_range_le_log_div (x := (3 / 11 : ℝ)) (by norm_num) (by norm_num) 2
    have e : ((1 : ℝ) + 3 / 11) / (1 - 3 / 11) = 7 / 4 := by norm_num
    rw [e] at h
    simp only [Finset.sum_range_succ, Finset.sum_range_zero] at h
    norm_num at h
    linarith
  set lam := Real.log (7 / 4) with hlamdef
  have hc : 0 < 5 * lam - 11 / 4 := by linarith
  set M : ℝ := Real.log (2 * K) + 5 * lam * Real.log 2 with hMdef
  have hLL : Tendsto (fun x : ℝ => Real.log (Real.log x)) atTop atTop :=
    Real.tendsto_log_atTop.comp Real.tendsto_log_atTop
  filter_upwards [hLL.eventually_ge_atTop (M / (5 * lam - 11 / 4)),
    eventually_ge_atTop (4096 : ℝ)] with x hT hx
  have hx0 : 0 < x := by linarith
  have hL : 0 < Real.log x := Real.log_pos (by linarith)
  set L := Real.log x with hLdef
  set T := Real.log L with hTdef
  have hcT : M ≤ (5 * lam - 11 / 4) * T := by
    have := (div_le_iff₀ hc).mp hT
    linarith
  set a : ℝ := 5 * (T - Real.log 2) with hadef
  
  have hQ : K * L ^ (7 / 4 : ℝ) / (7 / 4 : ℝ) ^ a ≤ 1 / (2 * L) := by
    have e1 : K * L ^ (7 / 4 : ℝ) / (7 / 4 : ℝ) ^ a =
        Real.exp (Real.log K + T * (7 / 4) - lam * a) := by
      rw [Real.rpow_def_of_pos hL, Real.rpow_def_of_pos (by norm_num : (0 : ℝ) < 7 / 4),
        Real.exp_sub, Real.exp_add, Real.exp_log hK]
    have e2 : 1 / (2 * L) = Real.exp (-(Real.log 2 + T)) := by
      rw [Real.exp_neg, Real.exp_add, Real.exp_log (by norm_num : (0 : ℝ) < 2), hTdef,
        Real.exp_log hL, one_div]
    rw [e1, e2, Real.exp_le_exp]
    have hM' : Real.log (2 * K) = Real.log 2 + Real.log K :=
      Real.log_mul (by norm_num) hK.ne'
    have e3 : (Real.log K + T * (7 / 4) - lam * a) - (-(Real.log 2 + T)) =
        M - (5 * lam - 11 / 4) * T := by
      rw [hMdef, hM', hadef]; ring
    linarith
  have hxQ : x * (K * L ^ (7 / 4 : ℝ) / (7 / 4 : ℝ) ^ a) ≤ x / (2 * L) := by
    have := mul_le_mul_of_nonneg_left hQ hx0.le
    calc x * (K * L ^ (7 / 4 : ℝ) / (7 / 4 : ℝ) ^ a) ≤ x * (1 / (2 * L)) := this
      _ = x / (2 * L) := by ring
  
  have hsq0 : 0 ≤ Real.sqrt x := Real.sqrt_nonneg x
  have hsqx : Real.sqrt x * Real.sqrt x = x := Real.mul_self_sqrt hx0.le
  have hsq64 : (64 : ℝ) ≤ Real.sqrt x := by
    have h1 : Real.sqrt 4096 = 64 := by
      rw [show (4096 : ℝ) = 64 ^ 2 by norm_num, Real.sqrt_sq (by norm_num)]
    rw [← h1]; exact Real.sqrt_le_sqrt hx
  set s := Real.sqrt (Real.sqrt x) with hsdef
  have hss : s * s = Real.sqrt x := Real.mul_self_sqrt hsq0
  have hs8 : (8 : ℝ) ≤ s := by
    have h1 : Real.sqrt 64 = 8 := by
      rw [show (64 : ℝ) = 8 ^ 2 by norm_num, Real.sqrt_sq (by norm_num)]
    rw [← h1]; exact Real.sqrt_le_sqrt hsq64
  have hs0 : 0 < s := by linarith
  have hlogs : Real.log s = L / 4 := by
    rw [hsdef, Real.log_sqrt hsq0, Real.log_sqrt hx0.le]; ring
  have hls : Real.log s ≤ s - 1 := Real.log_le_sub_one_of_pos hs0
  have h2L : 2 * L ≤ Real.sqrt x := by nlinarith
  have hsqrt_bound : Real.sqrt x ≤ x / (2 * L) := by
    rw [le_div_iff₀ (by positivity)]
    nlinarith
  
  set E := fiveLogOmegaTotients x with hEdef
  have hmem : ∀ n ∈ E, 1 ≤ n ∧ (n : ℝ) ≤ x ∧
      5 * logLog (n : ℝ) < (ArithmeticFunction.cardFactors n : ℝ) := by
    intro n hn
    simp only [hEdef, fiveLogOmegaTotients, totientsUpTo, Finset.mem_filter,
      Finset.mem_Icc] at hn
    obtain ⟨⟨⟨h1, h2⟩, _⟩, _, h5⟩ := hn
    exact ⟨h1, (Nat.le_floor_iff hx0.le).mp h2, h5⟩
  set Es := E.filter (fun n : ℕ => (n : ℝ) ≤ Real.sqrt x) with hEsdef
  set Eb := E.filter (fun n : ℕ => ¬ (n : ℝ) ≤ Real.sqrt x) with hEbdef
  have hsplit : Es.card + Eb.card = E.card :=
    Finset.filter_card_add_filter_neg_card_eq_card _
  have hEs : (Es.card : ℝ) ≤ Real.sqrt x := by
    have hsub : Es ⊆ Finset.Icc 1 ⌊Real.sqrt x⌋₊ := by
      intro n hn
      rw [hEsdef, Finset.mem_filter] at hn
      obtain ⟨h1, _, _⟩ := hmem n hn.1
      rw [Finset.mem_Icc]
      exact ⟨h1, Nat.le_floor hn.2⟩
    have hc1 := Finset.card_le_card hsub
    rw [Nat.card_Icc] at hc1
    have hc2 : Es.card ≤ ⌊Real.sqrt x⌋₊ := by omega
    calc (Es.card : ℝ) ≤ (⌊Real.sqrt x⌋₊ : ℝ) := by exact_mod_cast hc2
      _ ≤ Real.sqrt x := Nat.floor_le hsq0
  have hF : ∀ n ∈ Eb, 0 < n ∧ ∀ p ∈ n.primeFactors, (p : ℝ) ≤ x := by
    intro n hn
    rw [hEbdef, Finset.mem_filter] at hn
    obtain ⟨h1, h2, _⟩ := hmem n hn.1
    refine ⟨h1, fun p hp => ?_⟩
    have hpn := Nat.le_of_dvd h1 (Nat.dvd_of_mem_primeFactors hp)
    calc (p : ℝ) ≤ n := by exact_mod_cast hpn
      _ ≤ x := h2
  have hsqpos : 0 < Real.sqrt x := by linarith
  have hlogsq : Real.log (Real.sqrt x) = L / 2 := Real.log_sqrt hx0.le
  have ha : ∀ n ∈ Eb, a ≤ (ArithmeticFunction.cardFactors n : ℝ) := by
    intro n hn
    rw [hEbdef, Finset.mem_filter] at hn
    obtain ⟨_, _, h5⟩ := hmem n hn.1
    have hlt : Real.sqrt x < (n : ℝ) := not_le.mp hn.2
    have hlogn : L / 2 ≤ Real.log n := by
      rw [← hlogsq]; exact Real.log_le_log hsqpos hlt.le
    have hll : Real.log (L / 2) ≤ Real.log (Real.log n) :=
      Real.log_le_log (by positivity) hlogn
    have hdiv : Real.log (L / 2) = T - Real.log 2 := by
      rw [Real.log_div hL.ne' (by norm_num)]
    have h5' : 5 * Real.log (Real.log n) < (ArithmeticFunction.cardFactors n : ℝ) := h5
    rw [hadef]
    linarith
  have hsum := htail x (7 / 4) a Eb (by linarith) (by norm_num) (by norm_num) hF ha
  have hlow : ∀ n ∈ Eb, 1 / x ≤ (1 : ℝ) / (n.totient : ℝ) := by
    intro n hn
    obtain ⟨h1, _⟩ := hF n hn
    rw [hEbdef, Finset.mem_filter] at hn
    obtain ⟨_, h2, _⟩ := hmem n hn.1
    have ht0 : 0 < n.totient := Nat.totient_pos.mpr h1
    have htle : n.totient ≤ n := Nat.totient_le n
    have ht0' : (0 : ℝ) < (n.totient : ℝ) := by exact_mod_cast ht0
    have htle' : (n.totient : ℝ) ≤ x := le_trans (by exact_mod_cast htle) h2
    exact one_div_le_one_div_of_le ht0' htle'
