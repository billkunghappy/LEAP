    have hlC : 0 ≤ Real.log C₀ := Real.log_nonneg hC₀
    have hlD : 0 ≤ Real.log D := Real.log_nonneg hD
    refine ⟨Real.log C₀ + 11 * Real.log D + 132 * Real.log (10 / 9 : ℝ) + 1, by linarith, ?_⟩
