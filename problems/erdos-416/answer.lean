      linarith
    have h1 : (L : ℝ) ≤ (1 / 2) * T ^ (7 / 16 : ℝ) := by
      calc (L : ℝ) ≤ A * Real.log T := hL
        _ ≤ A * (1 / (2 * (A + 1)) * T ^ (7 / 16 : ℝ)) := mul_le_mul_of_nonneg_left hTb hA
        _ = (A * (1 / (2 * (A + 1)))) * T ^ (7 / 16 : ℝ) := by ring
        _ ≤ (1 / 2) * T ^ (7 / 16 : ℝ) := mul_le_mul_of_nonneg_right hAc hu0
    have h2 : (L : ℝ) * Real.log ((L : ℝ) + 1) ≤ (1 / 4) * (T ^ (-1 / 8 : ℝ) * T) := by
      rw [← huu]
      calc (L : ℝ) * Real.log ((L : ℝ) + 1) ≤ L * L := mul_le_mul_of_nonneg_left hlogL hL0
        _ ≤ ((1 / 2) * T ^ (7 / 16 : ℝ)) * ((1 / 2) * T ^ (7 / 16 : ℝ)) :=
          mul_le_mul h1 h1 hL0 (by positivity)
        _ = _ := by ring
    have hs0 : 0 < T ^ (-1 / 8 : ℝ) := Real.rpow_pos_of_pos hT0 _
    calc (1 / T) * L * Real.log ((L : ℝ) + 1) = (L * Real.log ((L : ℝ) + 1)) / T := by ring
      _ ≤ ((1 / 4) * (T ^ (-1 / 8 : ℝ) * T)) / T := div_le_div_of_nonneg_right h2 hT0.le
