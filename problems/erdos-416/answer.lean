      have hYeq : Real.log u + (n : ℝ) * Real.log 2 + Real.log 2 =
          Real.log u + ((n : ℝ) + 1) * Real.log 2 := by ring
      rw [hYeq] at hst
      have hmul := mul_le_mul_of_nonneg_left hst (by positivity : (0 : ℝ) ≤ 2 * c / Real.log 2)
      have e2 : 2 * c / Real.log 2 * (Real.log 2 / ((Real.log u + ((n : ℝ) + 1) * Real.log 2) *
          Real.log (Real.log u + ((n : ℝ) + 1) * Real.log 2) ^ 2)) =
          2 * c / ((Real.log u + ((n : ℝ) + 1) * Real.log 2) *
            Real.log (Real.log u + ((n : ℝ) + 1) * Real.log 2) ^ 2) := by
        field_simp
      rw [← hsplit]
      push_cast
      rw [mul_sub] at hmul ih ⊢
      linarith
  
  obtain ⟨n₀, hn₀⟩ : ∃ n₀ : ℕ, ∀ m ∈ F, (m : ℝ) ≤ u * 2 ^ n₀ := by
    refine ⟨F.sup id, fun m hm => ?_⟩
