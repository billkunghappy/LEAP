      rw [hu3] at this
      linarith
    rw [show (-1 / 3 : ℝ) = -(1 / 3) by norm_num, Real.rpow_neg hT0.le, inv_eq_one_div,
      div_le_div_iff₀ hu0 (by norm_num)]
    linarith
  
  have hWη : Real.log T ^ 6 / Real.sqrt T ≤ m / (30 * a) := by
    rw [← hrpow] at h3
    rw [div_le_iff₀ hr0]
    exact h3
  have h30 : 30 * a * (Real.log T ^ 6 / Real.sqrt T) ≤ m := by
    have := mul_le_mul_of_nonneg_left hWη (by positivity : (0 : ℝ) ≤ 30 * a)
    have he : 30 * a * (m / (30 * a)) = m := by field_simp
    linarith
  have h25 : 25 * a * (Real.log T ^ 6 / Real.sqrt T) ≤ T ^ (-2 / 5 : ℝ) := by
    have hk : 25 * a * Real.log T ^ 6 ≤ T ^ (1 / 10 : ℝ) := by
      have := mul_le_mul_of_nonneg_left h2 (by positivity : (0 : ℝ) ≤ 25 * a)
