      norm_num
    have hu4 : 4 ≤ T ^ (1 / 3 : ℝ) := by
      by_contra hcon
      push_neg at hcon
      have : (T ^ (1 / 3 : ℝ)) ^ 3 < 4 ^ 3 := by
