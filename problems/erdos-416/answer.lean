          _ ≤ c * (X * y ^ (1 / 40 : ℝ)) := mul_le_mul_of_nonneg_left hX1 hc0
          _ = (c * X) * y ^ (1 / 40 : ℝ) := by ring
      exact le_of_mul_le_mul_right h1 he0
    have hcXX : c * X ≤ X := by nlinarith
    have hXx : x₀ ≤ X := by linarith
    have hZx : x₀ ≤ c * X + 1 := by linarith
    have hX1' : 1 < X := by linarith
    have hZ1 : 1 < c * X + 1 := by linarith
    have hZ2 : c * X + 1 ≤ 2 * (c * X) := by linarith
    obtain ⟨hXa, -, -⟩ := hx₀ X hXx
    obtain ⟨-, hZb, -⟩ := hx₀ (c * X + 1) hZx
    have hlogX : 0 < Real.log X := Real.log_pos hX1'
    have hlogZ : 0 < Real.log (c * X + 1) := Real.log_pos hZ1
    have hXl : 0 < X / Real.log X := div_pos hX0 hlogX
    have hZl : 0 < (c * X + 1) / Real.log (c * X + 1) := div_pos (by linarith) hlogZ
    have hπX : (9 / 10) * (X / Real.log X) ≤ (Nat.primeCounting ⌊X⌋₊ : ℝ) := by
      have := (lt_div_iff₀ hXl).mp hXa
      linarith
    have hπZ : (Nat.primeCounting ⌊c * X + 1⌋₊ : ℝ) ≤
        (11 / 10) * ((c * X + 1) / Real.log (c * X + 1)) := by
      have := (div_lt_iff₀ hZl).mp hZb
      linarith
    have hlogXy : Real.log X ≤ Real.log y := Real.log_le_log hX0 hX2
    have hXdiv : X / Real.log y ≤ X / Real.log X :=
      div_le_div_of_nonneg_left hX0.le hlogX hlogXy
    have hlogW : Real.log (y ^ (1 / 2 : ℝ)) = (1 / 2) * Real.log y := Real.log_rpow hy0 _
    have hlogWZ : Real.log (y ^ (1 / 2 : ℝ)) ≤ Real.log (c * X + 1) :=
      Real.log_le_log (by linarith) (by linarith)
    have hZdiv : (c * X + 1) / Real.log (c * X + 1) ≤ (2 * (c * X)) / ((1 / 2) * Real.log y) := by
      rw [div_le_div_iff₀ hlogZ (by positivity)]
      calc (c * X + 1) * ((1 / 2) * Real.log y) ≤ (2 * (c * X)) * ((1 / 2) * Real.log y) :=
            mul_le_mul_of_nonneg_right hZ2 (by positivity)
        _ ≤ (2 * (c * X)) * Real.log (c * X + 1) :=
            mul_le_mul_of_nonneg_left (by rw [← hlogW]; exact hlogWZ) (by linarith)
    have hQ : 0 < X / Real.log y := div_pos hX0 hlogy
    have hZeq : (2 * (c * X)) / ((1 / 2) * Real.log y) = 4 * c * (X / Real.log y) := by
      field_simp
      ring
    have hπZ' : (Nat.primeCounting ⌊c * X + 1⌋₊ : ℝ) ≤ (2 / 5) * (X / Real.log y) := by
      have h1 : (Nat.primeCounting ⌊c * X + 1⌋₊ : ℝ) ≤ (11 / 10) * (4 * c * (X / Real.log y)) := by
        rw [← hZeq]
        linarith
      nlinarith
    have hsub : (Finset.Iic ⌊X⌋₊).filter Nat.Prime ⊆
        (Finset.Iic ⌊X⌋₊).filter (fun p : ℕ => p.Prime ∧ c * X + 1 < (p : ℝ)) ∪
          (Finset.Iic ⌊c * X + 1⌋₊).filter Nat.Prime := by
      intro p hp
      rw [Finset.mem_filter, Finset.mem_Iic] at hp
      rw [Finset.mem_union, Finset.mem_filter, Finset.mem_filter, Finset.mem_Iic, Finset.mem_Iic]
      by_cases h : c * X + 1 < (p : ℝ)
      · exact Or.inl ⟨hp.1, hp.2, h⟩
      · exact Or.inr ⟨Nat.le_floor (not_lt.mp h), hp.2⟩
    have hcard := (Finset.card_le_card hsub).trans (Finset.card_union_le _ _)
    have hcardR : ((((Finset.Iic ⌊X⌋₊).filter Nat.Prime).card : ℕ) : ℝ) ≤
        ((((Finset.Iic ⌊X⌋₊).filter (fun p : ℕ => p.Prime ∧ c * X + 1 < (p : ℝ))).card : ℕ) : ℝ) +
          ((((Finset.Iic ⌊c * X + 1⌋₊).filter Nat.Prime).card : ℕ) : ℝ) := by
      exact_mod_cast hcard
    rw [← hpc, ← hpc] at hcardR
    have hhalf : X / (2 * Real.log y) = (1 / 2) * (X / Real.log y) := by
      field_simp
    rw [hhalf]
    linarith
  
  have hsub4 : ∀ y : ℝ, 0 ≤ y → ∀ n : ℕ, 0 < n →
      (Finset.Iic ⌊y / (n.totient : ℝ)⌋₊).filter
          (fun p : ℕ => p.Prime ∧ coreLowerFraction y * (y / (n.totient : ℝ)) + 1 < (p : ℝ)) ⊆
        FordLower.lowerPrimeChoices y n := by
    intro y hy n hn p hp
    rw [Finset.mem_filter, Finset.mem_Iic] at hp
    obtain ⟨hpX, hpp, hlt⟩ := hp
    have hm1 : (1 : ℝ) ≤ n.totient := by exact_mod_cast Nat.totient_pos.mpr hn
    have hm0 : (0 : ℝ) < n.totient := by linarith
    have hX0 : 0 ≤ y / (n.totient : ℝ) := div_nonneg hy hm0.le
    have hpX' : (p : ℝ) ≤ y / n.totient := (Nat.le_floor_iff hX0).mp hpX
    have hXy : y / (n.totient : ℝ) ≤ y := div_le_self hy hm1
    have hcast : ((corePairValue (n.totient, p) : ℕ) : ℝ) = ((p : ℝ) - 1) * n.totient := by
      show (((p - 1) * n.totient : ℕ) : ℝ) = _
      rw [Nat.cast_mul, Nat.cast_sub hpp.one_lt.le, Nat.cast_one]
    have hmul : y / (n.totient : ℝ) * n.totient = y := div_mul_cancel₀ y hm0.ne'
    have hple : p ≤ ⌊y⌋₊ := Nat.le_floor (hpX'.trans hXy)
    unfold FordLower.lowerPrimeChoices corePairs
    rw [Finset.mem_image]
    refine ⟨(n.totient, p), ?_, rfl⟩
    refine Finset.mem_filter.mpr ⟨Finset.mem_product.mpr ⟨Finset.mem_singleton_self _,
      Finset.mem_range.mpr (by show p < ⌊y⌋₊ + 2; omega)⟩, hpp, ?_, ?_⟩
    · rw [hcast]
      have h1 : coreLowerFraction y * (y / n.totient) < (p : ℝ) - 1 := by linarith
      calc coreLowerFraction y * y = coreLowerFraction y * (y / n.totient) * n.totient := by
            rw [mul_assoc, hmul]
        _ < ((p : ℝ) - 1) * n.totient := mul_lt_mul_of_pos_right h1 hm0
    · rw [hcast]
