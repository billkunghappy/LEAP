theorem reciprocal_tail_of_loglog_density : ∃ K : ℝ, 0 < K ∧ ∀ (F : Finset ℕ) (u c : ℝ), Real.exp (Real.exp 1) ≤ u → 0 ≤ c →
      (∀ m ∈ F, u < (m : ℝ)) →
      (∀ t : ℝ, u ≤ t → ((F.filter (fun m : ℕ => (m : ℝ) ≤ t)).card : ℝ) ≤
        c * (t / (Real.log t * logLog t ^ 2))) →
      (∑ m ∈ F, (1 : ℝ) / m) ≤ K * c :=
by
  
  have step : ∀ y δ : ℝ, Real.exp 1 ≤ y → 0 < δ →
      δ / ((y + δ) * Real.log (y + δ) ^ 2) ≤ 1 / Real.log y - 1 / Real.log (y + δ) := by
    intro y δ hy hδ
    have hy0 : 0 < y := lt_of_lt_of_le (Real.exp_pos 1) hy
    have hyd : 0 < y + δ := by linarith
    have ha : 1 ≤ Real.log y := by
      have := Real.log_le_log (Real.exp_pos 1) hy
      rwa [Real.log_exp] at this
    have hab : Real.log y ≤ Real.log (y + δ) := Real.log_le_log hy0 (by linarith)
    have hgap : δ ≤ (Real.log (y + δ) - Real.log y) * (y + δ) := by
      have hx : 0 < y / (y + δ) := div_pos hy0 hyd
      have h1 := Real.log_le_sub_one_of_pos hx
      rw [Real.log_div hy0.ne' hyd.ne'] at h1
      have h2 : y / (y + δ) - 1 = -(δ / (y + δ)) := by field_simp; ring
