  have hn : (0 : ℝ) < ((∏ idx, p idx : ℕ) : ℝ) := by
    have : 0 < ∏ idx, p idx := Finset.prod_pos (fun idx _ => by have := h3 idx; omega)
    exact_mod_cast this
  rw [Real.le_rpow_iff_log_le hn hZ0]
  linarith

theorem actual_suffix_count_eventually (hPNT : Tendsto (fun x : ℝ => (Nat.primeCounting ⌊x⌋₊ : ℝ) / (x / Real.log x)) atTop (𝓝 1))
