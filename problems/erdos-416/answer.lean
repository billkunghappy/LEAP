theorem rph_box_prefix_structure {L : ℕ} {x w : Fin (L + 1) → ℝ} {b e e₀ ε h g θ : ℝ}
    (hb : 0 < b) (hε : 0 < ε) (hh : 0 < h) (hg : 0 ≤ g) (hx : Antitone x)
    (hwx : ∀ i, w i ≤ x i) (happ : ∀ i, b ≤ x i → x i - e ≤ w i)
    (hcon : ∀ i j : Fin (L + 1), 0 < i.val → i < j → g * x i ≤ x i - x j)
    (hθ : ∀ i : Fin (L + 1), 0 < i.val → x i ≤ θ)
    (hhead : b < w 0) (hhead1 : w 0 ≤ 1) (hheadapp : 1 - e₀ ≤ w 0)
    (hlast : w (Fin.last L) ≤ b)
    (hlower : 10 * h + ε + e ≤ g * b) (hheadgap : 10 * h + ε + e₀ ≤ 1 - θ)
    (htm : 4 * h ≤ b) :
    ∃ J : Fin (L + 1), J.val < L ∧
      (∀ i, i ≤ J ↔ b < w i) ∧
      (∀ i j, i ≤ J → i < j → 10 * h + ε ≤ w i - w j) ∧
      (∀ i, i ≤ J → w i ≤ CollisionBox.rounded ε w i ∧
        (0 < i.val → CollisionBox.rounded ε w i < w i + ε)) ∧
      (∀ i, i ≤ J → 0 < i.val → CollisionBox.rounded ε w i ≤ θ + ε) ∧
      (∀ i j, i < j → j ≤ J →
        10 * h ≤ CollisionBox.rounded ε w i - CollisionBox.rounded ε w j) ∧
      b / 2 ≤ CollisionBox.tailCoordinate ε h b w J ∧
      CollisionBox.tailCoordinate ε h b w J ≤ b ∧
      2 * h ≤ CollisionBox.rounded ε w J - CollisionBox.tailCoordinate ε h b w J ∧
      (∀ j, J < j → w j ≤ CollisionBox.tailCoordinate ε h b w J) :=
by
  classical
  
  have G : ∀ i j : Fin (L + 1), (i.val = 0 ∨ b ≤ x i) → i < j → 10 * h + ε ≤ w i - w j := by
    intro i j hi hij
    have hij' : i.val < j.val := hij
    by_cases h0 : i.val = 0
    · have hi0 : i = 0 := Fin.ext h0
      subst hi0
      have hj : 0 < j.val := by omega
      have h1 := hθ j hj
      have h2 := hwx j
      linarith
    · have hpos : 0 < i.val := Nat.pos_of_ne_zero h0
      have hbx : b ≤ x i := hi.resolve_left h0
      have h1 := hcon i j hpos hij
      have h2 := happ i hbx
      have h3 := hwx j
      have h4 := mul_le_mul_of_nonneg_left hbx hg
      linarith
  
  have R : ∀ i : Fin (L + 1), 0 ≤ w i → w i ≤ CollisionBox.rounded ε w i ∧
      (0 < i.val → CollisionBox.rounded ε w i < w i + ε) := by
    intro i hi
    by_cases h0 : i.val = 0
    · have hr : CollisionBox.rounded ε w i = 1 := by
        simp [CollisionBox.rounded, h0]
      have hi0 : i = 0 := Fin.ext h0
      refine ⟨?_, fun hp => absurd hp (by omega)⟩
      rw [hr, hi0]
      exact hhead1
    · have hr : CollisionBox.rounded ε w i = ε * (⌈w i / ε⌉₊ : ℝ) := by
        simp [CollisionBox.rounded, CollisionBox.roundUp, h0]
      rw [hr]
      have ha : 0 ≤ w i / ε := div_nonneg hi hε.le
      have hc1 := Nat.le_ceil (w i / ε)
      have hc2 := Nat.ceil_lt_add_one ha
      have heq : ε * (w i / ε) = w i := mul_div_cancel₀ (w i) hε.ne'
      have heq2 : ε * (w i / ε + 1) = w i + ε := by rw [mul_add, heq, mul_one]
      constructor
      · have := mul_le_mul_of_nonneg_left hc1 hε.le
        linarith
      · intro _
        have := mul_lt_mul_of_pos_left hc2 hε
        linarith
  
  obtain ⟨J, hJmem, hJmax⟩ := Finset.exists_max_image
    (Finset.univ.filter (fun i : Fin (L + 1) => b < w i)) (fun i => i)
    ⟨0, Finset.mem_filter.mpr ⟨Finset.mem_univ _, hhead⟩⟩
  have hJ : b < w J := (Finset.mem_filter.mp hJmem).2
  have hlastJ : ∀ j, J < j → w j ≤ b := by
    intro j hj
    by_contra hc
    push_neg at hc
    have := hJmax j (Finset.mem_filter.mpr ⟨Finset.mem_univ _, hc⟩)
    exact absurd hj (not_lt.mpr this)
  have hJL : J.val < L := by
    by_contra hc
    have hJeq : J = Fin.last L := Fin.ext (by rw [Fin.val_last]; have := J.isLt; omega)
    rw [hJeq] at hJ
    linarith
  have Hh : ∀ i, b < w i → (i.val = 0 ∨ b ≤ x i) :=
    fun i hbw => Or.inr (hbw.le.trans (hwx i))
  have C1 : ∀ i, i ≤ J ↔ b < w i := by
    intro i
    constructor
    · intro hiJ
      rcases eq_or_lt_of_le hiJ with hEq | hlt
      · rw [hEq]; exact hJ
      · have hxi : x J ≤ x i := hx hiJ
        have hwJ := hwx J
        have := G i J (Or.inr (by linarith)) hlt
        linarith
    · intro hbw
      by_contra hc
      have := hlastJ i (not_le.mp hc)
      linarith
  have C2 : ∀ i j, i ≤ J → i < j → 10 * h + ε ≤ w i - w j :=
    fun i j hiJ hij => G i j (Hh i ((C1 i).mp hiJ)) hij
  have C3 : ∀ i, i ≤ J → w i ≤ CollisionBox.rounded ε w i ∧
      (0 < i.val → CollisionBox.rounded ε w i < w i + ε) := by
    intro i hiJ
    have := (C1 i).mp hiJ
    exact R i (by linarith)
  have C4 : ∀ i, i ≤ J → 0 < i.val → CollisionBox.rounded ε w i ≤ θ + ε := by
    intro i hiJ hi
    have h1 := (C3 i hiJ).2 hi
    have h2 := hwx i
    have h3 := hθ i hi
    linarith
  have C5 : ∀ i j, i < j → j ≤ J →
      10 * h ≤ CollisionBox.rounded ε w i - CollisionBox.rounded ε w j := by
    intro i j hij hjJ
    have hiJ := hij.le.trans hjJ
    have h1 := (C3 i hiJ).1
    have h2 := C2 i j hiJ hij
    have hj : 0 < j.val := by
      have : i.val < j.val := hij
      omega
    have h3 := (C3 j hjJ).2 hj
    linarith
  have hrJ := (C3 J le_rfl).1
  have hz : CollisionBox.tailCoordinate ε h b w J =
      min b (CollisionBox.rounded ε w J - 2 * h) := rfl
  refine ⟨J, hJL, C1, C2, C3, C4, C5, ?_, ?_, ?_, ?_⟩
  · rw [hz]; exact le_min (by linarith) (by linarith)
  · rw [hz]; exact min_le_left _ _
  · rw [hz]
    have := min_le_right b (CollisionBox.rounded ε w J - 2 * h)
    linarith
  · intro j hj
    rw [hz]
    refine le_min (hlastJ j hj) ?_
    have := G J j (Hh J hJ) hj
    linarith

theorem rph_shifted_interval_balance {m n d e : ℕ} (p : Fin m → ℕ) (q : Fin n → ℕ)
    (hp : ∀ i, (p i).Prime) (hq : ∀ j, (q j).Prime) (hd : d ≠ 0) (he : e ≠ 0)
    (hprod : d * (∏ i, (p i - 1)) = e * (∏ j, (q j - 1)))
    {S : ℝ} (hdS : (largestPrimeFactor d : ℝ) ≤ S) (heS : (largestPrimeFactor e : ℝ) ≤ S)
    {u v : ℝ} (hSu : S ≤ u) :
    (∑ i, omegaInterval (p i - 1) u v) = ∑ j, omegaInterval (q j - 1) u v :=
by
  classical
  have hmul : ∀ a b : ℕ, a ≠ 0 → b ≠ 0 →
      omegaInterval (a * b) u v = omegaInterval a u v + omegaInterval b u v := by
    intro a b ha hb
    unfold omegaInterval
    rw [(Nat.perm_primeFactorsList_mul ha hb).countP_eq, List.countP_append]
  have hprodS : ∀ {ι : Type} (s : Finset ι) (f : ι → ℕ), (∀ i ∈ s, f i ≠ 0) →
      omegaInterval (∏ i ∈ s, f i) u v = ∑ i ∈ s, omegaInterval (f i) u v := by
    intro ι s f hf
    induction s using Finset.induction_on with
    | empty =>
      simp [omegaInterval]
    | insert a s ha ih =>
      rw [Finset.prod_insert ha, Finset.sum_insert ha]
      have h1 : f a ≠ 0 := hf a (Finset.mem_insert_self a s)
      have hs : ∀ i ∈ s, f i ≠ 0 := fun i hi => hf i (Finset.mem_insert_of_mem hi)
      have h2 : ∏ i ∈ s, f i ≠ 0 := Finset.prod_ne_zero_iff.mpr hs
      rw [hmul _ _ h1 h2, ih hs]
  have hzero : ∀ k : ℕ, (largestPrimeFactor k : ℝ) ≤ u → omegaInterval k u v = 0 := by
    intro k hk
    unfold omegaInterval
    rw [List.countP_eq_zero]
    intro r hr
    have hr' : r ∈ k.primeFactors := Nat.mem_primeFactors_iff_mem_primeFactorsList.mpr hr
    have h1 : r ≤ k.primeFactors.sup id := Finset.le_sup (f := id) hr'
    have h2 : r ≤ largestPrimeFactor k := by
      unfold largestPrimeFactor
      exact le_trans h1 (le_max_right _ _)
    have h3 : (r : ℝ) ≤ u := le_trans (by exact_mod_cast h2) hk
    simp only [decide_eq_true_eq, not_and, not_le]
    intro h
    exact absurd h (not_lt.mpr h3)
  have hpne : ∀ i, p i - 1 ≠ 0 := fun i => Nat.sub_ne_zero_of_lt (hp i).one_lt
  have hqne : ∀ j, q j - 1 ≠ 0 := fun j => Nat.sub_ne_zero_of_lt (hq j).one_lt
  have hP : ∏ i, (p i - 1) ≠ 0 := Finset.prod_ne_zero_iff.mpr (fun i _ => hpne i)
  have hQ : ∏ j, (q j - 1) ≠ 0 := Finset.prod_ne_zero_iff.mpr (fun j _ => hqne j)
  have hc := congrArg (fun t => omegaInterval t u v) hprod
  simp only at hc
  rw [hmul _ _ hd hP, hmul _ _ he hQ, hzero d (hdS.trans hSu), hzero e (heS.trans hSu),
    hprodS _ _ (fun i _ => hpne i), hprodS _ _ (fun j _ => hqne j)] at hc
  simpa using hc

theorem rph_high_index_match {L K : ℕ} {Y b h ε : ℝ} {p : Fin (L + 1) → ℕ} {q : Fin K → ℕ}
    (hY : Real.exp 1 < Y) (hT1 : 1 < logLog Y)
    (hp : ∀ i, SNormal (normalityScale (logLog Y)) (p i)) (hp17 : ∀ i, 17 ≤ p i)
    (hpY : ∀ i, ((p i - 1 : ℕ) : ℝ) ≤ Y)
    (hq : ∀ j, SNormal (normalityScale (logLog Y)) (q j))
    (hqsort : StrictAnti (fun j => largestPrimeFactor (q j - 1)))
    (hqlarge : ∀ j, normalityScale (logLog Y) < (largestPrimeFactor (q j - 1) : ℝ))
    (hqY : ∀ j, ((q j - 1 : ℕ) : ℝ) ≤ Y)
    (hbal : ∀ u v : ℝ, normalityScale (logLog Y) ≤ u → u < v →
      (∑ i, omegaInterval (p i - 1) u v) = ∑ j, omegaInterval (q j - 1) u v)
    (hε : 0 < ε) (hh : 0 < h)
    (hbudget : (4 * (L : ℝ) + 4) * normalityDelta (logLog Y) + ε ≤ h)
    (htm : 4 * h ≤ b)
    (hnorm : Real.log (logLog Y) ^ 10 ≤ b * logLog Y / 2)
    (idx : Fin (L + 1))
    (hbefore : ∀ j, j ≤ idx → CollisionBox.shiftedCoordinate (logLog Y) (p idx) ≤
      CollisionBox.shiftedCoordinate (logLog Y) (p j))
    (hafter : ∀ j, idx ≤ j → CollisionBox.shiftedCoordinate (logLog Y) (p j) ≤
      CollisionBox.shiftedCoordinate (logLog Y) (p idx))
    (hhigh : b < CollisionBox.shiftedCoordinate (logLog Y) (p idx)) :
    ∃ j : Fin K, j.val = idx.val ∧
      |CollisionBox.shiftedCoordinate (logLog Y) (p idx) -
        CollisionBox.shiftedCoordinate (logLog Y) (q j)| ≤
          (2 * idx.val + 1 : ℝ) * normalityDelta (logLog Y) :=
by
  classical
  
  have logLog_mono : ∀ {x y : ℝ}, 1 < x → x ≤ y → logLog x ≤ logLog y := fun hx hxy =>
    Real.log_le_log (Real.log_pos hx) (Real.log_le_log (by linarith) hxy)
  have logLog_strict : ∀ {x y : ℝ}, 1 < x → x < y → logLog x < logLog y := fun hx hxy =>
    Real.log_lt_log (Real.log_pos hx) (Real.log_lt_log (by linarith) hxy)
  have lpf_le : ∀ {n : ℕ}, 0 < n → largestPrimeFactor n ≤ n := by
    intro n hn
    apply max_le hn
    apply Finset.sup_le
    intro r hr
    exact Nat.le_of_dvd hn (Nat.dvd_of_mem_primeFactors hr)
  have lpf_one_lt : ∀ {n : ℕ}, 1 < n → 1 < largestPrimeFactor n := by
    intro n hn
    have hprime := Nat.minFac_prime (show n ≠ 1 by omega)
    have hmem : n.minFac ∈ n.primeFactors :=
      Nat.mem_primeFactors.mpr ⟨hprime, Nat.minFac_dvd n, by omega⟩
    have h2 := hprime.two_le
    have hle : n.minFac ≤ n.primeFactors.sup id := Finset.le_sup (f := id) hmem
    show 1 < max 1 (n.primeFactors.sup id)
    exact lt_of_lt_of_le (show 1 < n.minFac by omega) (le_trans hle (le_max_right 1 _))
  have mem_le_lpf : ∀ {n z : ℕ}, z ∈ n.primeFactorsList → z ≤ largestPrimeFactor n := by
    intro n z hz
    have hmem : z ∈ n.primeFactors := Nat.mem_primeFactors_iff_mem_primeFactorsList.mpr hz
    exact le_trans (Finset.le_sup (f := id) hmem) (le_max_right 1 _)
  have omega_zero : ∀ (n : ℕ) {u v : ℝ}, (largestPrimeFactor n : ℝ) ≤ u →
      omegaInterval n u v = 0 := by
    intro n u v hn
    unfold omegaInterval
    rw [List.countP_eq_zero]
    intro z hz
    have hle : (z : ℝ) ≤ largestPrimeFactor n := by exact_mod_cast mem_le_lpf hz
    simp only [decide_eq_true_eq]
    rintro ⟨h1, -⟩
    linarith
  have omega_trunc : ∀ (n : ℕ) (u : ℝ) {v : ℝ}, (n : ℝ) ≤ v →
      omegaInterval n u v = omegaInterval n u n := by
    intro n u v hn
    unfold omegaInterval
    apply List.countP_congr
    intro z hz
    simp only [decide_eq_true_eq]
    have hzn : (z : ℝ) ≤ n := by exact_mod_cast Nat.le_of_mem_primeFactorsList hz
    exact ⟨fun h => ⟨h.1, hzn⟩, fun h => ⟨h.1, h.2.trans hn⟩⟩
  
  have hT0 : 0 < logLog Y := by linarith
  have hPT_all : ∀ x : ℝ, 1 < x → x ≤ Y → logLog x ≤ logLog Y := fun x hx hxY =>
    logLog_mono hx hxY
  generalize hTY : logLog Y = T at *
  have hlogT : 0 ≤ Real.log T := Real.log_nonneg hT1.le
  have hSe : Real.exp 1 ≤ normalityScale T := by
    unfold normalityScale
    exact Real.exp_le_exp.mpr (Real.one_le_exp (by positivity))
  have hS1 : (1 : ℝ) < normalityScale T :=
    lt_of_lt_of_le (Real.one_lt_exp_iff.mpr (by norm_num : (0 : ℝ) < 1)) hSe
  have hLS : logLog (normalityScale T) = Real.log T ^ 10 := by
    simp only [logLog, normalityScale, Real.log_exp]
  have hLS0 : 0 ≤ logLog (normalityScale T) := by rw [hLS]; positivity
  have hδ0 : 0 ≤ normalityDelta T :=
    div_nonneg (mul_nonneg (by norm_num) (pow_nonneg hlogT 5)) (Real.sqrt_nonneg T)
  have hEδ : Real.sqrt (logLog (normalityScale T) * T) ≤ normalityDelta T * T := by
    have hsqrt : 0 < Real.sqrt T := Real.sqrt_pos.mpr hT0
    have hnn : 0 ≤ Real.log T ^ 5 * Real.sqrt T := mul_nonneg (pow_nonneg hlogT 5) hsqrt.le
    have heq : normalityDelta T * T = 2 * (Real.log T ^ 5 * Real.sqrt T) := by
      unfold normalityDelta
      apply (mul_right_cancel₀ hsqrt.ne')
      rw [div_mul_eq_mul_div, div_mul_cancel₀ _ hsqrt.ne']
      nlinarith [Real.sq_sqrt hT0.le]
    have hex : Real.sqrt (logLog (normalityScale T) * T) = Real.log T ^ 5 * Real.sqrt T := by
      rw [hLS, show Real.log T ^ 10 = (Real.log T ^ 5) ^ 2 by ring, Real.sqrt_mul (sq_nonneg _),
        Real.sqrt_sq (pow_nonneg hlogT 5)]
    rw [hex, heq]
    linarith
  generalize hSdef : normalityScale T = S at *
  obtain ⟨E, hEdef⟩ : ∃ E, Real.sqrt (logLog S * T) = E := ⟨_, rfl⟩
  rw [hEdef] at hEδ
  have hE0 : 0 ≤ E := by rw [← hEdef]; exact Real.sqrt_nonneg _
  generalize hδdef : normalityDelta T = δ at *
  
  have interval_bounds : ∀ {r : ℕ}, SNormal S r → ∀ {u v : ℝ}, S ≤ u → u < v → logLog v ≤ T →
      v ≤ ((r - 1 : ℕ) : ℝ) →
      logLog v - logLog u - E ≤ (omegaInterval (r - 1) u v : ℝ) ∧
        (omegaInterval (r - 1) u v : ℝ) ≤ logLog v - logLog u + E := by
    intro r hr u v hSu huv hvT hvr
    have hnormal := hr.2.2 u v hSu huv hvr
    have herror : Real.sqrt (logLog S * logLog v) ≤ E := by
      rw [← hEdef]
      exact Real.sqrt_le_sqrt (mul_le_mul_of_nonneg_left hvT hLS0)
    have habs : |(omegaInterval (r - 1) u v : ℝ) - (logLog v - logLog u)| ≤ E :=
      hnormal.le.trans herror
    obtain ⟨h1, h2⟩ := abs_le.mp habs
    constructor <;> linarith
  have interval_upper : ∀ {r : ℕ}, SNormal S r → ∀ {u v : ℝ}, S ≤ u → u < v → logLog v ≤ T →
      (omegaInterval (r - 1) u v : ℝ) ≤ logLog v - logLog u + E := by
    intro r hr u v hSu huv hvT
    have huone : 1 < u := hS1.trans_le hSu
    have hloguv : logLog u ≤ logLog v := logLog_mono huone huv.le
    by_cases hru : ((r - 1 : ℕ) : ℝ) ≤ u
    · have hzero : omegaInterval (r - 1) u v = 0 := by
        unfold omegaInterval
        rw [List.countP_eq_zero]
        intro z hz
        have hzr : (z : ℝ) ≤ ((r - 1 : ℕ) : ℝ) := by
          exact_mod_cast Nat.le_of_mem_primeFactorsList hz
        simp only [decide_eq_true_eq]
        rintro ⟨h1, -⟩
        linarith
      rw [hzero, Nat.cast_zero]
      linarith
    · have hur : u < ((r - 1 : ℕ) : ℝ) := lt_of_not_ge hru
      by_cases hvr : v ≤ ((r - 1 : ℕ) : ℝ)
      · exact (interval_bounds hr hSu huv hvT hvr).2
      · have hrv : ((r - 1 : ℕ) : ℝ) ≤ v := le_of_not_ge hvr
        have hlogrv : logLog ((r - 1 : ℕ) : ℝ) ≤ logLog v := logLog_mono (huone.trans hur) hrv
        rw [omega_trunc (r - 1) u hrv]
        have := (interval_bounds hr hSu hur (hlogrv.trans hvT) le_rfl).2
        linarith
  
  have sum_lower : ∀ {m : ℕ} (a : Fin m → ℕ), (∀ k, SNormal S (a k)) → ∀ i : Fin m,
      (∀ k, k ≤ i → largestPrimeFactor (a i - 1) ≤ largestPrimeFactor (a k - 1)) →
      ∀ {u v : ℝ}, v ≤ (largestPrimeFactor (a i - 1) : ℝ) → S ≤ u → u < v → logLog v ≤ T →
      ((i.val : ℝ) + 1) * (logLog v - logLog u - E) ≤
        ∑ k, (omegaInterval (a k - 1) u v : ℝ) := by
    intro m a ha i hrank u v hcut hSu huv hvT
    have hpoint : ∀ k ∈ Finset.Iic i,
        logLog v - logLog u - E ≤ (omegaInterval (a k - 1) u v : ℝ) := by
      intro k hk
      have hPk : (largestPrimeFactor (a i - 1) : ℝ) ≤ largestPrimeFactor (a k - 1) := by
        exact_mod_cast hrank k (Finset.mem_Iic.mp hk)
      have hpos : 0 < a k - 1 := by have := (ha k).1.one_lt; omega
      have hPb : (largestPrimeFactor (a k - 1) : ℝ) ≤ ((a k - 1 : ℕ) : ℝ) := by
        exact_mod_cast lpf_le hpos
      exact (interval_bounds (ha k) hSu huv hvT (hcut.trans (hPk.trans hPb))).1
    calc ((i.val : ℝ) + 1) * (logLog v - logLog u - E)
        = ∑ _k ∈ Finset.Iic i, (logLog v - logLog u - E) := by
          rw [Finset.sum_const, Fin.card_Iic, nsmul_eq_mul]; push_cast; ring
      _ ≤ ∑ k ∈ Finset.Iic i, (omegaInterval (a k - 1) u v : ℝ) := Finset.sum_le_sum hpoint
      _ ≤ ∑ k, (omegaInterval (a k - 1) u v : ℝ) :=
          Finset.sum_le_sum_of_subset_of_nonneg (Finset.subset_univ _)
            (fun k _ _ => Nat.cast_nonneg _)
  have sum_upper_tail : ∀ {m : ℕ} (a : Fin m → ℕ), (∀ k, SNormal S (a k)) → ∀ i : Fin m,
      (∀ k, i ≤ k → largestPrimeFactor (a k - 1) ≤ largestPrimeFactor (a i - 1)) →
      ∀ {u v : ℝ}, (largestPrimeFactor (a i - 1) : ℝ) ≤ u → S ≤ u → u < v → logLog v ≤ T →
      ∑ k, (omegaInterval (a k - 1) u v : ℝ) ≤ (i.val : ℝ) * (logLog v - logLog u + E) := by
    intro m a ha i hrank u v hcut hSu huv hvT
    have hrestrict : (∑ k ∈ Finset.Iio i, (omegaInterval (a k - 1) u v : ℝ)) =
        ∑ k, (omegaInterval (a k - 1) u v : ℝ) := by
      apply Finset.sum_subset (Finset.subset_univ _)
      intro k _ hk
      have hik : i ≤ k := not_lt.mp (by simpa only [Finset.mem_Iio] using hk)
      have hle1 : (largestPrimeFactor (a k - 1) : ℝ) ≤ (largestPrimeFactor (a i - 1) : ℝ) := by
        exact_mod_cast hrank k hik
      rw [omega_zero (a k - 1) (hle1.trans hcut), Nat.cast_zero]
    rw [← hrestrict]
    calc (∑ k ∈ Finset.Iio i, (omegaInterval (a k - 1) u v : ℝ))
        ≤ ∑ _k ∈ Finset.Iio i, (logLog v - logLog u + E) :=
          Finset.sum_le_sum fun k _ => interval_upper (ha k) hSu huv hvT
      _ = (i.val : ℝ) * (logLog v - logLog u + E) := by
          rw [Finset.sum_const, Fin.card_Iio, nsmul_eq_mul]
  have sum_upper : ∀ {n : ℕ} (c : Fin n → ℕ), (∀ k, SNormal S (c k)) →
      ∀ {u v : ℝ}, S ≤ u → u < v → logLog v ≤ T →
      ∑ k, (omegaInterval (c k - 1) u v : ℝ) ≤ (n : ℝ) * (logLog v - logLog u + E) := by
    intro n c hc u v hSu huv hvT
    calc ∑ k, (omegaInterval (c k - 1) u v : ℝ) ≤ ∑ _k : Fin n, (logLog v - logLog u + E) :=
          Finset.sum_le_sum fun k _ => interval_upper (hc k) hSu huv hvT
      _ = (n : ℝ) * (logLog v - logLog u + E) := by
          rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
  
  have one_sided : ∀ {m n : ℕ} (a : Fin m → ℕ) (c : Fin n → ℕ), (∀ k, SNormal S (a k)) →
      (∀ k, SNormal S (c k)) → ∀ (i : Fin m) (j : Fin n), i.val = j.val →
      (∀ k, i ≤ k → largestPrimeFactor (a k - 1) ≤ largestPrimeFactor (a i - 1)) →
      (∀ k, k ≤ j → largestPrimeFactor (c j - 1) ≤ largestPrimeFactor (c k - 1)) →
      S ≤ (largestPrimeFactor (a i - 1) : ℝ) → S ≤ (largestPrimeFactor (c j - 1) : ℝ) →
      logLog (largestPrimeFactor (c j - 1) : ℝ) ≤ T →
      (∀ u v : ℝ, S ≤ u → u < v →
        (∑ k, omegaInterval (a k - 1) u v) = ∑ k, omegaInterval (c k - 1) u v) →
      logLog (largestPrimeFactor (c j - 1) : ℝ) - logLog (largestPrimeFactor (a i - 1) : ℝ) ≤
        (2 * (i.val : ℝ) + 1) * E := by
    intro m n a c ha hc i j hij hrA hrC hPi hQj hQT hbalance
    by_cases hQP : (largestPrimeFactor (c j - 1) : ℝ) ≤ largestPrimeFactor (a i - 1)
    · have hlogs := logLog_mono (hS1.trans_le hQj) hQP
      have herr : 0 ≤ (2 * (i.val : ℝ) + 1) * E := mul_nonneg (by positivity) hE0
      linarith
    · have hPQ := lt_of_not_ge hQP
      have hupper := sum_upper_tail a ha i hrA le_rfl hPi hPQ hQT
      have hlower := sum_lower c hc j hrC le_rfl hPi hPQ hQT
      have hmass : (∑ k, (omegaInterval (a k - 1) (largestPrimeFactor (a i - 1) : ℝ)
            (largestPrimeFactor (c j - 1) : ℝ) : ℝ)) =
          ∑ k, (omegaInterval (c k - 1) (largestPrimeFactor (a i - 1) : ℝ)
            (largestPrimeFactor (c j - 1) : ℝ) : ℝ) := by
        exact_mod_cast hbalance _ _ hPi hPQ
      rw [hmass] at hupper
      have hij' : (j.val : ℝ) = (i.val : ℝ) := by exact_mod_cast hij.symm
      rw [hij'] at hlower
      nlinarith
  
  have hP1 : ∀ r, (1 : ℝ) < (largestPrimeFactor (p r - 1) : ℝ) := by
    intro r
    exact_mod_cast lpf_one_lt (show 1 < p r - 1 by have := hp17 r; omega)
  have hPY : ∀ r, (largestPrimeFactor (p r - 1) : ℝ) ≤ Y := by
    intro r
    have h1 : (largestPrimeFactor (p r - 1) : ℝ) ≤ ((p r - 1 : ℕ) : ℝ) := by
      exact_mod_cast lpf_le (show 0 < p r - 1 by have := hp17 r; omega)
    exact h1.trans (hpY r)
  have hQY : ∀ k, (largestPrimeFactor (q k - 1) : ℝ) ≤ Y := by
    intro k
    have h1 : (largestPrimeFactor (q k - 1) : ℝ) ≤ ((q k - 1 : ℕ) : ℝ) := by
      exact_mod_cast lpf_le (show 0 < q k - 1 by have := (hq k).1.one_lt; omega)
    exact h1.trans (hqY k)
  have hPT : logLog (largestPrimeFactor (p idx - 1) : ℝ) ≤ T := hPT_all _ (hP1 idx) (hPY idx)
  have hQT : ∀ k, logLog (largestPrimeFactor (q k - 1) : ℝ) ≤ T := fun k =>
    hPT_all _ (hS1.trans (hqlarge k)) (hQY k)
  
  have rank_of_shift : ∀ {a c : ℕ}, 17 ≤ c →
      CollisionBox.shiftedCoordinate T a ≤ CollisionBox.shiftedCoordinate T c →
      largestPrimeFactor (a - 1) ≤ largestPrimeFactor (c - 1) := by
    intro a c hc hsh
    by_contra hn
    have hlt : (largestPrimeFactor (c - 1) : ℝ) < largestPrimeFactor (a - 1) := by
      exact_mod_cast lt_of_not_ge hn
    have h1 : (1 : ℝ) < largestPrimeFactor (c - 1) := by
      exact_mod_cast lpf_one_lt (show 1 < c - 1 by omega)
    have hLL := logLog_strict h1 hlt
    unfold CollisionBox.shiftedCoordinate at hsh
    have := (div_lt_div_iff_of_pos_right hT0).mpr hLL
    linarith
  have hrankBefore : ∀ k, k ≤ idx →
      largestPrimeFactor (p idx - 1) ≤ largestPrimeFactor (p k - 1) :=
    fun k hk => rank_of_shift (hp17 k) (hbefore k hk)
  have hrankAfter : ∀ k, idx ≤ k →
      largestPrimeFactor (p k - 1) ≤ largestPrimeFactor (p idx - 1) :=
    fun k hk => rank_of_shift (hp17 idx) (hafter k hk)
  
  have hile : (idx.val : ℝ) ≤ L := by exact_mod_cast (show idx.val ≤ L by omega)
  have hmul := mul_le_mul_of_nonneg_right hile hδ0
  have hcoef : (2 * (idx.val : ℝ) + 1) * δ ≤ h / 2 := by nlinarith
  have hbound : (2 * (idx.val : ℝ) + 1) * E ≤ h * T / 2 := by
    calc (2 * (idx.val : ℝ) + 1) * E ≤ (2 * (idx.val : ℝ) + 1) * (δ * T) :=
          mul_le_mul_of_nonneg_left hEδ (by positivity)
      _ = ((2 * (idx.val : ℝ) + 1) * δ) * T := by ring
      _ ≤ (h / 2) * T := mul_le_mul_of_nonneg_right hcoef hT0.le
      _ = h * T / 2 := by ring
  have hnormal : logLog S ≤ b * T / 2 := by rw [hLS]; exact hnorm
  have hhighT : b * T < logLog (largestPrimeFactor (p idx - 1) : ℝ) := by
    have hh' := hhigh
    unfold CollisionBox.shiftedCoordinate at hh'
    exact (lt_div_iff₀ hT0).mp hh'
  have htailT := mul_le_mul_of_nonneg_right htm hT0.le
  have hhT : 0 < h * T := mul_pos hh hT0
  have hgap : (2 * (idx.val : ℝ) + 1) * E <
      logLog (largestPrimeFactor (p idx - 1) : ℝ) - logLog S := by
    nlinarith
  have hPS : S < (largestPrimeFactor (p idx - 1) : ℝ) := by
    by_contra hn
    have hLL := logLog_mono (hP1 idx) (le_of_not_gt hn)
    have hnn : 0 ≤ (2 * (idx.val : ℝ) + 1) * E := mul_nonneg (by positivity) hE0
    linarith
  
  have hexists : idx.val < K := by
    by_contra hn
    have hnle : (K : ℝ) ≤ idx.val := by exact_mod_cast Nat.le_of_not_gt hn
    have hC : 0 ≤ logLog (largestPrimeFactor (p idx - 1) : ℝ) - logLog S + E := by
      have := logLog_mono hS1 hPS.le
      linarith
    have hlower := sum_lower p hp idx hrankBefore le_rfl le_rfl hPS hPT
    have hupper := (sum_upper q hq le_rfl hPS hPT).trans (mul_le_mul_of_nonneg_right hnle hC)
    have hmass : (∑ k, (omegaInterval (p k - 1) S (largestPrimeFactor (p idx - 1) : ℝ) : ℝ)) =
        ∑ k, (omegaInterval (q k - 1) S (largestPrimeFactor (p idx - 1) : ℝ) : ℝ) := by
      exact_mod_cast hbal _ _ le_rfl hPS
    rw [hmass] at hlower
    nlinarith
  
  let j : Fin K := ⟨idx.val, hexists⟩
  have hqAfter : ∀ k, j ≤ k → largestPrimeFactor (q k - 1) ≤ largestPrimeFactor (q j - 1) :=
    fun k hk => hqsort.antitone hk
  have hqBefore : ∀ k, k ≤ j → largestPrimeFactor (q j - 1) ≤ largestPrimeFactor (q k - 1) :=
    fun k hk => hqsort.antitone hk
  have hleft := one_sided p q hp hq idx j rfl hrankAfter hqBefore hPS.le (hqlarge j).le
    (hQT j) hbal
  have hright : logLog (largestPrimeFactor (p idx - 1) : ℝ) -
      logLog (largestPrimeFactor (q j - 1) : ℝ) ≤ (2 * (idx.val : ℝ) + 1) * E :=
    one_sided q p hq hp j idx rfl hqAfter hrankBefore (hqlarge j).le hPS.le hPT
      (fun u v hu huv => (hbal u v hu huv).symm)
  refine ⟨j, rfl, ?_⟩
  have habs : |logLog (largestPrimeFactor (p idx - 1) : ℝ) -
      logLog (largestPrimeFactor (q j - 1) : ℝ)| ≤ (2 * (idx.val : ℝ) + 1) * E :=
    abs_le.mpr ⟨by linarith, hright⟩
  have hscale := mul_le_mul_of_nonneg_left hEδ
    (show (0 : ℝ) ≤ 2 * (idx.val : ℝ) + 1 by positivity)
  show |logLog (largestPrimeFactor (p idx - 1) : ℝ) / T -
    logLog (largestPrimeFactor (q j - 1) : ℝ) / T| ≤ (2 * (idx.val : ℝ) + 1) * δ
  rw [← sub_div, abs_div, abs_of_pos hT0, div_le_iff₀ hT0]
  nlinarith

theorem rph_tail_package {L K s : ℕ} {Y b ε zstar : ℝ} {p : Fin (L + 1) → ℕ} {q : Fin K → ℕ}
    (J : Fin (L + 1)) (hJL : J.val < L)
    (hY : Real.exp 1 < Y) (hT1 : 1 < logLog Y)
    (hp : ∀ i, SNormal (normalityScale (logLog Y)) (p i)) (hp17 : ∀ i, 17 ≤ p i)
    (hq : ∀ j, SNormal (normalityScale (logLog Y)) (q j))
    (hqsort : StrictAnti (fun j => largestPrimeFactor (q j - 1)))
    (hs : 0 < s) (hsS : (largestPrimeFactor s : ℝ) ≤ normalityScale (logLog Y))
    (hbal : ∀ u v : ℝ, normalityScale (logLog Y) ≤ u → u < v →
      (∑ i, omegaInterval (p i - 1) u v) = ∑ j, omegaInterval (q j - 1) u v)
    (hε : 0 < ε)
    (hfirst : b + ε + (6 * (L : ℝ) + 5) * normalityDelta (logLog Y) < 1)
    (hnorm : Real.log (logLog Y) ^ 10 ≤ b * logLog Y / 2)
    (hzlo : b / 2 ≤ zstar) (hzhi : zstar ≤ b)
    (htailw : ∀ r : Fin (L + 1), J < r →
      CollisionBox.shiftedCoordinate (logLog Y) (p r) ≤ zstar) :
    (∀ i : Fin (L + 1), J < i → ∀ z ∈ (p i - 1).primeFactorsList, (z : ℝ) ≤
        CollisionBox.cutoff Y (zstar + (2 * (L : ℝ) + 3) * normalityDelta (logLog Y))) ∧
    (∀ j : Fin K, J.val + 1 ≤ j.val → (largestPrimeFactor (q j - 1) : ℝ) <
        CollisionBox.cutoff Y (zstar + (2 * (L : ℝ) + 3) * normalityDelta (logLog Y))) ∧
    (∀ z ∈ (s * ∏ j ∈ Finset.univ.filter (fun j : Fin K => J.val + 1 ≤ j.val),
        (q j - 1)).primeFactorsList,
        (z : ℝ) ≤ CollisionBox.cutoff Y (zstar + (2 * (L : ℝ) + 3) * normalityDelta (logLog Y))) :=
by
  classical
  set T := logLog Y with hTdef
  set δ := normalityDelta T with hδdef
  set S := normalityScale T with hSdef
  set u := CollisionBox.cutoff Y zstar with hudef
  set v := CollisionBox.cutoff Y (zstar + (2 * (L : ℝ) + 3) * δ) with hvdef
  
  have hT0 : 0 < T := by linarith
  have hlogT : 0 < Real.log T := Real.log_pos hT1
  have hsqrtT : 0 < Real.sqrt T := Real.sqrt_pos.mpr hT0
  have hδ : 0 < δ := by
    rw [hδdef, normalityDelta]; positivity
  have hY0 : 0 < Y := lt_trans (Real.exp_pos 1) hY
  have hlogY : 1 < Real.log Y := (Real.lt_log_iff_exp_lt hY0).mpr hY
  have hTY : Real.log (Real.log Y) = T := rfl
  
  have hLLcut : ∀ a : ℝ, Real.log (Real.log (CollisionBox.cutoff Y a)) = a * T := by
    intro a
    rw [CollisionBox.cutoff, Real.log_exp, Real.log_rpow (by linarith), hTY]
  have hcutle : ∀ a x : ℝ, 1 < x → Real.log (Real.log x) ≤ a * T →
      x ≤ CollisionBox.cutoff Y a := by
    intro a x hx1 hx
    have hx0 : 0 < x := by linarith
    have hlx : 0 < Real.log x := Real.log_pos hx1
    have hpos : 0 < Real.log (CollisionBox.cutoff Y a) := by
      rw [CollisionBox.cutoff, Real.log_exp]; exact Real.rpow_pos_of_pos (by linarith) _
    rw [← hLLcut a] at hx
    have h1 := (Real.log_le_log_iff hlx hpos).mp hx
    exact (Real.log_le_log_iff hx0 (Real.exp_pos _)).mp h1
  have hLLS : Real.log (Real.log S) = Real.log T ^ 10 := by
    rw [hSdef, normalityScale, Real.log_exp, Real.log_exp]
  have hLLS0 : 0 ≤ Real.log (Real.log S) := by rw [hLLS]; positivity
  have hS1 : 1 < S := by
    rw [hSdef, normalityScale]; exact Real.one_lt_exp_iff.mpr (Real.exp_pos _)
  have hSu : S ≤ u := by
    rw [hSdef, hudef, normalityScale, CollisionBox.cutoff, Real.rpow_def_of_pos (by linarith), hTY]
    apply Real.exp_le_exp.mpr
    apply Real.exp_le_exp.mpr
    have := mul_le_mul_of_nonneg_right hzlo hT0.le
    linarith
  have huv : u < v := by
    rw [hudef, hvdef]
    apply Real.exp_lt_exp.mpr
    apply Real.rpow_lt_rpow_of_exponent_lt hlogY
    have : 0 < (2 * (L : ℝ) + 3) * δ := by positivity
    linarith
  have hu1 : 1 < u := lt_of_lt_of_le hS1 hSu
  have hLLu : Real.log (Real.log u) = zstar * T := by rw [hudef]; exact hLLcut zstar
  have hLLv : Real.log (Real.log v) = (zstar + (2 * (L : ℝ) + 3) * δ) * T := by
    rw [hvdef]; exact hLLcut _
  have hLLuv : Real.log (Real.log u) < Real.log (Real.log v) := by
    rw [hLLu, hLLv]
    have : 0 < (2 * (L : ℝ) + 3) * δ * T := by positivity
    nlinarith
  have hLLvT : Real.log (Real.log v) ≤ T := by
    rw [hLLv]
    have hL0 : (0 : ℝ) ≤ L := Nat.cast_nonneg L
    have h1 : (2 * (L : ℝ) + 3) * δ ≤ (6 * (L : ℝ) + 5) * δ :=
      mul_le_mul_of_nonneg_right (by linarith) hδ.le
    have h2 : zstar + (2 * (L : ℝ) + 3) * δ ≤ 1 := by linarith
    have := mul_le_mul_of_nonneg_right h2 hT0.le
    linarith
  
  have hδT : δ * T / 2 = Real.log T ^ 5 * Real.sqrt T := by
    have hs : Real.sqrt T * Real.sqrt T = T := Real.mul_self_sqrt hT0.le
    have hne : Real.sqrt T ≠ 0 := hsqrtT.ne'
    calc δ * T / 2 = 2 * Real.log T ^ 5 / Real.sqrt T * (Real.sqrt T * Real.sqrt T) / 2 := by
          rw [hs, hδdef, normalityDelta]
      _ = Real.log T ^ 5 * Real.sqrt T := by field_simp
  have hEgen : ∀ x : ℝ, x ≤ T → Real.sqrt (Real.log (Real.log S) * x) ≤ δ * T / 2 := by
    intro x hx
    rw [hδT, hLLS]
    have hpos : 0 ≤ Real.log T ^ 5 * Real.sqrt T := by positivity
    rw [show Real.log T ^ 5 * Real.sqrt T = Real.sqrt ((Real.log T ^ 5 * Real.sqrt T) ^ 2) from
      (Real.sqrt_sq hpos).symm]
    apply Real.sqrt_le_sqrt
    rw [mul_pow, Real.sq_sqrt hT0.le]
    have h10 : 0 ≤ Real.log T ^ 10 := by positivity
    have := mul_le_mul_of_nonneg_left hx h10
    nlinarith
  have hE : Real.sqrt (Real.log (Real.log S) * Real.log (Real.log v)) ≤ δ * T / 2 :=
    hEgen _ hLLvT
  
  have hlpf_mem : ∀ z m : ℕ, z ∈ m.primeFactorsList → z ≤ largestPrimeFactor m := by
    intro z m hz
    have hz' : z ∈ m.primeFactors := Nat.mem_primeFactors_iff_mem_primeFactorsList.mpr hz
    exact le_trans (Finset.le_sup (f := id) hz') (le_max_right _ _)
  have hlpf_dvd : ∀ z m : ℕ, z.Prime → z ∣ m → m ≠ 0 → z ≤ largestPrimeFactor m := by
    intro z m hz hd hm
    have hz' : z ∈ m.primeFactors := Nat.mem_primeFactors.mpr ⟨hz, hd, hm⟩
    exact le_trans (Finset.le_sup (f := id) hz') (le_max_right _ _)
  have hlpf_le : ∀ m : ℕ, 1 ≤ m → largestPrimeFactor m ≤ m := by
    intro m hm
    unfold largestPrimeFactor
    apply max_le hm
    apply Finset.sup_le
    intro z hz
    exact Nat.le_of_dvd (by omega) (Nat.dvd_of_mem_primeFactors hz)
  have hlpf_two : ∀ m : ℕ, 2 ≤ m → 2 ≤ largestPrimeFactor m := by
    intro m hm
    have hp' := Nat.minFac_prime (show m ≠ 1 by omega)
    exact le_trans hp'.two_le (hlpf_dvd _ _ hp' (Nat.minFac_dvd m) (by omega))
  
  have hupper : ∀ r : ℕ, SNormal S r → (omegaInterval (r - 1) u v : ℝ) ≤
      (Real.log (Real.log v) - Real.log (Real.log u)) +
        Real.sqrt (Real.log (Real.log S) * Real.log (Real.log v)) := by
    intro r hr
    rcases le_or_gt ((r - 1 : ℕ) : ℝ) u with hA | hA
    · have h0 : omegaInterval (r - 1) u v = 0 := by
        unfold omegaInterval
        rw [List.countP_eq_zero]
        intro z hz h
        have hzle : z ≤ r - 1 := Nat.le_of_mem_primeFactorsList hz
        have hzu : (z : ℝ) ≤ u := le_trans (by exact_mod_cast hzle) hA
        simp only [decide_eq_true_eq] at h
        linarith [h.1]
      rw [h0]
      have := Real.sqrt_nonneg (Real.log (Real.log S) * Real.log (Real.log v))
      push_cast
      linarith
    · rcases le_or_gt v ((r - 1 : ℕ) : ℝ) with hB | hB
      · have := hr.2.2 u v hSu huv hB
        rw [abs_sub_lt_iff] at this
        linarith [this.1]
      · have heq : omegaInterval (r - 1) u v = omegaInterval (r - 1) u ((r - 1 : ℕ) : ℝ) := by
          unfold omegaInterval
          apply List.countP_congr
          intro z hz
          have hzle : (z : ℝ) ≤ ((r - 1 : ℕ) : ℝ) := by
            exact_mod_cast Nat.le_of_mem_primeFactorsList hz
          simp only [decide_eq_true_eq]
          constructor
          · rintro ⟨h1, _⟩; exact ⟨h1, hzle⟩
          · rintro ⟨h1, _⟩; exact ⟨h1, by linarith⟩
        have := hr.2.2 u ((r - 1 : ℕ) : ℝ) hSu hA le_rfl
        rw [abs_sub_lt_iff] at this
        have hn1 : 1 < ((r - 1 : ℕ) : ℝ) := by linarith
        have hLLn : Real.log (Real.log ((r - 1 : ℕ) : ℝ)) ≤ Real.log (Real.log v) :=
          Real.log_le_log (Real.log_pos hn1) (Real.log_le_log (by linarith) hB.le)
        have hsq : Real.sqrt (Real.log (Real.log S) * Real.log (Real.log ((r - 1 : ℕ) : ℝ))) ≤
            Real.sqrt (Real.log (Real.log S) * Real.log (Real.log v)) :=
          Real.sqrt_le_sqrt (mul_le_mul_of_nonneg_left hLLn hLLS0)
        rw [heq]
        linarith [this.1]
  have hlower : ∀ r : ℕ, SNormal S r → v ≤ (largestPrimeFactor (r - 1) : ℝ) →
      (Real.log (Real.log v) - Real.log (Real.log u)) -
        Real.sqrt (Real.log (Real.log S) * Real.log (Real.log v)) ≤
          (omegaInterval (r - 1) u v : ℝ) := by
    intro r hr hv
    have hr2 := hr.1.two_le
    have hle : (largestPrimeFactor (r - 1) : ℝ) ≤ ((r - 1 : ℕ) : ℝ) := by
      exact_mod_cast hlpf_le (r - 1) (by omega)
    have := hr.2.2 u v hSu huv (le_trans hv hle)
    rw [abs_sub_lt_iff] at this
    linarith [this.2]
  
  have htailu : ∀ r : Fin (L + 1), J < r → ∀ z ∈ (p r - 1).primeFactorsList, (z : ℝ) ≤ u := by
    intro r hr z hz
    have h17 := hp17 r
    have hP2 : 1 < largestPrimeFactor (p r - 1) := hlpf_two _ (by omega)
    have hP1 : (1 : ℝ) < (largestPrimeFactor (p r - 1) : ℝ) := by exact_mod_cast hP2
    have hw := htailw r hr
    unfold CollisionBox.shiftedCoordinate at hw
    rw [div_le_iff₀ hT0] at hw
    have hPu : (largestPrimeFactor (p r - 1) : ℝ) ≤ u := hcutle zstar _ hP1 hw
    have hzP : (z : ℝ) ≤ (largestPrimeFactor (p r - 1) : ℝ) := by
      exact_mod_cast hlpf_mem _ _ hz
    linarith
  have hzero : ∀ i : Fin (L + 1), J < i → omegaInterval (p i - 1) u v = 0 := by
    intro i hi
    unfold omegaInterval
    rw [List.countP_eq_zero]
    intro z hz h
    have := htailu i hi z hz
    simp only [decide_eq_true_eq] at h
    linarith [h.1]
  
  have hO3 : ∀ j : Fin K, J.val + 1 ≤ j.val → (largestPrimeFactor (q j - 1) : ℝ) < v := by
    intro j hj
    have hJK : J.val + 1 < K := lt_of_le_of_lt hj j.isLt
    have hmain : (largestPrimeFactor (q ⟨J.val + 1, hJK⟩ - 1) : ℝ) < v := by
      by_contra hcon
      push_neg at hcon
      have hsum := hbal u v hSu huv
      have hsumR : (∑ i, (omegaInterval (p i - 1) u v : ℝ)) =
          ∑ j, (omegaInterval (q j - 1) u v : ℝ) := by
        exact_mod_cast hsum
      have hAc : (Finset.univ.filter (fun i : Fin (L + 1) => i.val ≤ J.val)).card = J.val + 1 := by
        have : Finset.univ.filter (fun i : Fin (L + 1) => i.val ≤ J.val) = Finset.Iic J := by
          ext i
          simp only [Finset.mem_filter, Finset.mem_univ, true_and, Finset.mem_Iic, Fin.le_def]
        rw [this, Fin.card_Iic]
      have hBc : (Finset.univ.filter (fun j : Fin K => j.val ≤ J.val + 1)).card = J.val + 2 := by
        have : Finset.univ.filter (fun j : Fin K => j.val ≤ J.val + 1) =
            Finset.Iic (⟨J.val + 1, hJK⟩ : Fin K) := by
          ext i
          simp only [Finset.mem_filter, Finset.mem_univ, true_and, Finset.mem_Iic, Fin.le_def]
        rw [this, Fin.card_Iic]
      have hleft : (∑ i, (omegaInterval (p i - 1) u v : ℝ)) ≤
          ((J.val : ℝ) + 1) * ((Real.log (Real.log v) - Real.log (Real.log u)) +
            Real.sqrt (Real.log (Real.log S) * Real.log (Real.log v))) := by
        have hsub : ∑ i ∈ Finset.univ.filter (fun i : Fin (L + 1) => i.val ≤ J.val),
            (omegaInterval (p i - 1) u v : ℝ) = ∑ i, (omegaInterval (p i - 1) u v : ℝ) :=
          Finset.sum_subset (Finset.subset_univ _) (by
            intro i _ hi
            simp only [Finset.mem_filter, Finset.mem_univ, true_and, not_le] at hi
            simp [hzero i (Fin.lt_def.mpr hi)])
        rw [← hsub]
        have h1 := Finset.sum_le_card_nsmul
          (Finset.univ.filter (fun i : Fin (L + 1) => i.val ≤ J.val))
          (fun i => (omegaInterval (p i - 1) u v : ℝ))
          ((Real.log (Real.log v) - Real.log (Real.log u)) +
            Real.sqrt (Real.log (Real.log S) * Real.log (Real.log v)))
          (by intro i _; exact hupper (p i) (hp i))
        rw [hAc, nsmul_eq_mul] at h1
        push_cast at h1
        exact h1
      have hright : ((J.val : ℝ) + 2) * ((Real.log (Real.log v) - Real.log (Real.log u)) -
            Real.sqrt (Real.log (Real.log S) * Real.log (Real.log v))) ≤
          ∑ j, (omegaInterval (q j - 1) u v : ℝ) := by
        have h1 := Finset.card_nsmul_le_sum
          (Finset.univ.filter (fun j : Fin K => j.val ≤ J.val + 1))
          (fun j => (omegaInterval (q j - 1) u v : ℝ))
          ((Real.log (Real.log v) - Real.log (Real.log u)) -
            Real.sqrt (Real.log (Real.log S) * Real.log (Real.log v)))
          (by
            intro j' hj'
            simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hj'
            have hle : j' ≤ (⟨J.val + 1, hJK⟩ : Fin K) := Fin.le_def.mpr hj'
            have hanti := hqsort.antitone hle
            have hQ : v ≤ (largestPrimeFactor (q j' - 1) : ℝ) :=
              le_trans hcon (by exact_mod_cast hanti)
            exact hlower (q j') (hq j') hQ)
        rw [hBc, nsmul_eq_mul] at h1
        push_cast at h1
        have h2 : ∑ j ∈ Finset.univ.filter (fun j : Fin K => j.val ≤ J.val + 1),
            (omegaInterval (q j - 1) u v : ℝ) ≤ ∑ j, (omegaInterval (q j - 1) u v : ℝ) :=
          Finset.sum_le_sum_of_subset_of_nonneg (Finset.filter_subset _ _)
            (fun _ _ _ => Nat.cast_nonneg _)
        linarith
      have hDE : Real.log (Real.log v) - Real.log (Real.log u) ≤ (2 * (J.val : ℝ) + 3) *
          Real.sqrt (Real.log (Real.log S) * Real.log (Real.log v)) := by
        nlinarith
      have hDval : Real.log (Real.log v) - Real.log (Real.log u) =
          (2 * (L : ℝ) + 3) * δ * T := by
        rw [hLLu, hLLv]; ring
      have hJL' : (J.val : ℝ) + 1 ≤ L := by
        have : J.val + 1 ≤ L := hJL
        exact_mod_cast this
      have hδT0 : 0 < δ * T := mul_pos hδ hT0
      have h3 := mul_le_mul_of_nonneg_left hE (by positivity : (0:ℝ) ≤ 2 * (J.val : ℝ) + 3)
      have h4 := mul_le_mul_of_nonneg_right hJL' hδT0.le
      have h5 := mul_nonneg (Nat.cast_nonneg (α := ℝ) J.val) hδT0.le
      nlinarith
    have hle : (⟨J.val + 1, hJK⟩ : Fin K) ≤ j := Fin.le_def.mpr hj
    have hanti := hqsort.antitone hle
    have : (largestPrimeFactor (q j - 1) : ℝ) ≤ (largestPrimeFactor (q ⟨J.val + 1, hJK⟩ - 1) : ℝ) := by
      exact_mod_cast hanti
    linarith
  
  have hO4 : ∀ z ∈ (s * ∏ j ∈ Finset.univ.filter (fun j : Fin K => J.val + 1 ≤ j.val),
      (q j - 1)).primeFactorsList, (z : ℝ) ≤ v := by
    intro z hz
    have hzp := Nat.prime_of_mem_primeFactorsList hz
    have hzd := Nat.dvd_of_mem_primeFactorsList hz
    rcases (Nat.Prime.prime hzp).dvd_mul.mp hzd with h | h
    · have h1 : z ≤ largestPrimeFactor s := hlpf_dvd z s hzp h hs.ne'
      have h2 : (z : ℝ) ≤ (largestPrimeFactor s : ℝ) := by exact_mod_cast h1
      linarith
    · obtain ⟨j, hj, hzj⟩ := (Prime.dvd_finset_prod_iff (Nat.Prime.prime hzp) _).mp h
      simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hj
      have hq2 := (hq j).1.two_le
      have h1 : z ≤ largestPrimeFactor (q j - 1) := hlpf_dvd z _ hzp hzj (by omega)
      have h2 : (z : ℝ) ≤ (largestPrimeFactor (q j - 1) : ℝ) := by exact_mod_cast h1
      have h3 := hO3 j hj
      linarith
  exact ⟨fun i hi z hz => le_trans (htailu i hi z hz) huv.le, hO3, hO4⟩

theorem rph_selected_sieve_cutoffs {L : ℕ} {Y ε h b θ zstar : ℝ} {w : Fin (L + 1) → ℝ}
    (J : Fin (L + 1)) (C : Finset (Fin (J.val + 1)))
    (hY : Real.exp 1 < Y) (hT : 0 < logLog Y)
    (hk : 1 ≤ (CollisionClass.remaining C).card)
    (hmono : StrictMono (CollisionClass.index C))
    (hge : ∀ i, i.val ≤ (CollisionClass.index C i).val)
    (hfirst : ∀ i, i.val = 0 → (CollisionClass.index C i).val = 0)
    (hint : ∀ i : Fin (L + 1), i ≤ J → 0 < i.val → CollisionBox.rounded ε w i ≤ θ + ε)
    (hsep : ∀ i j : Fin (L + 1), i < j → j ≤ J →
      10 * h ≤ CollisionBox.rounded ε w i - CollisionBox.rounded ε w j)
    (htg : 2 * h ≤ CollisionBox.rounded ε w J - zstar)
    (hzlo : b / 2 ≤ zstar) (hzhi : zstar ≤ b)
    (hδ : 0 ≤ normalityDelta (logLog Y)) (hε : 0 < ε) (hh : 0 < h)
    (hbudget : (4 * (L : ℝ) + 4) * normalityDelta (logLog Y) + ε ≤ h)
    (hfi : θ + 2 * ε + (6 * (L : ℝ) + 3) * normalityDelta (logLog Y) < 1)
    (hft : b + ε + (6 * (L : ℝ) + 5) * normalityDelta (logLog Y) < 1)
    (hsi : θ + ε + (2 * (L : ℝ) + 1) * normalityDelta (logLog Y) +
      Real.log (10 * logLog Y) / logLog Y ≤ 1)
    (hst : b + (2 * (L : ℝ) + 3) * normalityDelta (logLog Y) +
      Real.log (10 * logLog Y) / logLog Y ≤ 1)
    (hnorm : Real.log (logLog Y) ^ 10 ≤ b * logLog Y / 2) :
    CollisionCutoff.SieveCutoffs (CollisionClass.remaining C).card Y (normalityDelta (logLog Y))
      (CollisionCutoff.upper Y L (normalityDelta (logLog Y))
        (CollisionCutoff.selectedZeta J C ε w) zstar)
      (CollisionCutoff.lower Y L (normalityDelta (logLog Y)) ε
        (CollisionCutoff.selectedZeta J C ε w) zstar) :=
by
  classical
  set δ := normalityDelta (logLog Y) with hδdef
  
  have hsel_val : ∀ i, (CollisionCutoff.selectedIndex J C i).val = (CollisionClass.index C i).val :=
    fun i => rfl
  have hsel_le : ∀ i, CollisionCutoff.selectedIndex J C i ≤ J := by
    intro i
    rw [Fin.le_def, hsel_val]
    have := (CollisionClass.index C i).isLt
    omega
  have hsel_mono : ∀ i j, i < j →
      CollisionCutoff.selectedIndex J C i < CollisionCutoff.selectedIndex J C j := by
    intro i j hij
    rw [Fin.lt_def, hsel_val, hsel_val]
    exact Fin.lt_def.mp (hmono hij)
  have hz1 : ∀ i : Fin (CollisionClass.remaining C).card, 0 < i.val →
      CollisionCutoff.selectedZeta J C ε w i ≤ θ + ε := by
    intro i hi
    exact hint _ (hsel_le i) (by rw [hsel_val]; have := hge i; omega)
  have hz2 : ∀ i j : Fin (CollisionClass.remaining C).card, i < j →
      CollisionCutoff.selectedZeta J C ε w j + 10 * h ≤ CollisionCutoff.selectedZeta J C ε w i := by
    intro i j hij
    have := hsep _ _ (hsel_mono i j hij) (hsel_le j)
    unfold CollisionCutoff.selectedZeta
    linarith
  have hz3 : ∀ i : Fin (CollisionClass.remaining C).card,
      zstar + 2 * h ≤ CollisionCutoff.selectedZeta J C ε w i := by
    intro i
    unfold CollisionCutoff.selectedZeta
    rcases lt_or_eq_of_le (hsel_le i) with hlt | heq
    · have := hsep _ _ hlt le_rfl
      linarith
    · rw [heq]
      linarith
  
  have nuprof : ∀ (k : ℕ) (z : Fin k → ℝ), 1 ≤ k →
      (∀ i : Fin k, 0 < i.val → z i ≤ θ + ε) →
      (∀ i j : Fin k, i < j → z j + 10 * h ≤ z i) →
      (∀ i : Fin k, zstar + 2 * h ≤ z i) →
      Antitone (CollisionCutoff.nu L δ z zstar) ∧
      CollisionCutoff.nu L δ z zstar 0 = 1 ∧
      (∀ n, n < k → CollisionCutoff.nu L δ z zstar (n + 1) < CollisionCutoff.mu L δ ε z zstar n ∧
         CollisionCutoff.mu L δ ε z zstar n ≤ CollisionCutoff.nu L δ z zstar n) ∧
      (∀ n, 2 ≤ n → n ≤ k →
        δ ≤ CollisionCutoff.nu L δ z zstar (n - 1) - CollisionCutoff.nu L δ z zstar n) ∧
      CollisionCutoff.nu L δ z zstar k = zstar + (2 * (L : ℝ) + 3) * δ ∧
      CollisionCutoff.nu L δ z zstar 1 + Real.log (10 * logLog Y) / logLog Y ≤ 1 := by
    intro k z hk hz1 hz2 hz3
    have hL : (0 : ℝ) ≤ L := Nat.cast_nonneg L
    have hLδ : 0 ≤ (L : ℝ) * δ := mul_nonneg hL hδ
    have E0 : CollisionCutoff.nu L δ z zstar 0 = 1 := by
      unfold CollisionCutoff.nu
      simp
    have Ei : ∀ n (hn : 0 < n) (hnk : n < k),
        CollisionCutoff.nu L δ z zstar n = z ⟨n, hnk⟩ + (2 * (L : ℝ) + 1) * δ := by
      intro n hn hnk
      unfold CollisionCutoff.nu
      rw [if_neg (by omega), dif_pos hnk]
    have Et : ∀ n, k ≤ n → CollisionCutoff.nu L δ z zstar n = zstar + (2 * (L : ℝ) + 3) * δ := by
      intro n hn
      unfold CollisionCutoff.nu
      rw [if_neg (by omega), dif_neg (by omega)]
    have SG : ∀ n, n < k → (4 * (L : ℝ) + 2) * δ + ε <
        CollisionCutoff.nu L δ z zstar n - CollisionCutoff.nu L δ z zstar (n + 1) := by
      intro n hn
      rcases Nat.eq_zero_or_pos n with h0 | hpos
      · subst h0
        rw [E0]
        by_cases hk1 : 1 < k
        · rw [Ei 1 one_pos hk1]
          have := hz1 ⟨1, hk1⟩ one_pos
          linarith
        · rw [Et 1 (by omega)]
          linarith
      · by_cases hn1 : n + 1 < k
        · rw [Ei n hpos hn, Ei (n + 1) (by omega) hn1]
          have := hz2 ⟨n, hn⟩ ⟨n + 1, hn1⟩ (by rw [Fin.lt_def]; simp)
          linarith
        · rw [Ei n hpos hn, Et (n + 1) (by omega)]
          have := hz3 ⟨n, hn⟩
          linarith
    refine ⟨?_, E0, ?_, ?_, Et k le_rfl, ?_⟩
    · apply antitone_nat_of_succ_le
      intro n
      by_cases hn : n < k
      · have := SG n hn
        linarith
      · rw [Et n (by omega), Et (n + 1) (by omega)]
    · intro n hn
      have := SG n hn
      unfold CollisionCutoff.mu
      constructor <;> linarith
    · intro n h2 hnk
      have := SG (n - 1) (by omega)
      rw [Nat.sub_add_cancel (by omega : 1 ≤ n)] at this
      linarith
    · by_cases hk1 : 1 < k
      · rw [Ei 1 one_pos hk1]
        have := hz1 ⟨1, hk1⟩ one_pos
        linarith
      · rw [Et 1 (by omega)]
        linarith
  
  have hY0 : 0 < Y := lt_trans (Real.exp_pos 1) hY
  have hlogY : 1 < Real.log Y := by
    have := Real.log_lt_log (Real.exp_pos 1) hY
    rwa [Real.log_exp] at this
  have hlogY0 : 0 < Real.log Y := by linarith
  have hexpT : Real.exp (logLog Y) = Real.log Y := by
    unfold logLog
    exact Real.exp_log hlogY0
  have hcut1 : CollisionBox.cutoff Y 1 = Y := by
    unfold CollisionBox.cutoff
    rw [Real.rpow_one, Real.exp_log hY0]
  have hcutsm : StrictMono (CollisionBox.cutoff Y) := by
    intro a a' haa
    unfold CollisionBox.cutoff
    exact Real.exp_lt_exp.mpr (Real.rpow_lt_rpow_of_exponent_lt hlogY haa)
  have hcutll : ∀ a, logLog (CollisionBox.cutoff Y a) = a * logLog Y := by
    intro a
    unfold CollisionBox.cutoff logLog
    rw [Real.log_exp, Real.log_rpow hlogY0]
  have hcutee : ∀ a, CollisionBox.cutoff Y a = Real.exp (Real.exp (logLog Y * a)) := by
    intro a
    unfold CollisionBox.cutoff logLog
    rw [Real.rpow_def_of_pos hlogY0]
  
  obtain ⟨hanti, hν0, hil, hgap, hνk, hν1⟩ :=
    nuprof _ (CollisionCutoff.selectedZeta J C ε w) hk hz1 hz2 hz3
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro a c hac
    exact hcutsm.monotone (hanti hac)
  · unfold CollisionCutoff.upper
    rw [hν0, hcut1]
  · intro n hn
    exact ⟨hcutsm (hil n hn).1, hcutsm.monotone (hil n hn).2⟩
  · intro n h2 hnk
    unfold CollisionCutoff.upper
    rw [hcutll, hcutll, mul_div_cancel_right₀ _ hT.ne', mul_div_cancel_right₀ _ hT.ne']
    exact hgap n h2 hnk
  · unfold CollisionCutoff.upper
    rw [hνk, hcutee]
    unfold normalityScale
    apply Real.exp_le_exp.mpr
    apply Real.exp_le_exp.mpr
    have hexp : logLog Y * (zstar + (2 * (L : ℝ) + 3) * δ) =
        zstar * logLog Y + (2 * (L : ℝ) + 3) * δ * logLog Y := by ring
    rw [hexp]
    have h1 := mul_le_mul_of_nonneg_right hzlo hT.le
    have h2 := mul_nonneg (mul_nonneg (by positivity : (0 : ℝ) ≤ 2 * (L : ℝ) + 3) hδ) hT.le
    linarith
  · unfold CollisionCutoff.upper
    rw [hcutee, Real.rpow_def_of_pos hY0]
    apply Real.exp_le_exp.mpr
    have hmul := mul_le_mul_of_nonneg_left hν1 hT.le
    have hr : logLog Y * (Real.log (10 * logLog Y) / logLog Y) = Real.log (10 * logLog Y) := by
      field_simp
    have hle : logLog Y * CollisionCutoff.nu L δ (CollisionCutoff.selectedZeta J C ε w) zstar 1 ≤
        logLog Y - Real.log (10 * logLog Y) := by
      rw [mul_add, hr, mul_one] at hmul
      linarith
    calc Real.exp (logLog Y * CollisionCutoff.nu L δ (CollisionCutoff.selectedZeta J C ε w) zstar 1)
        ≤ Real.exp (logLog Y - Real.log (10 * logLog Y)) := Real.exp_le_exp.mpr hle
      _ = Real.log Y * (1 / (10 * logLog Y)) := by
        rw [Real.exp_sub, Real.exp_log (by linarith), hexpT]
        field_simp

theorem rph_paired_interval_bounds {L K : ℕ} {Y ε e₀ zstar : ℝ} {p : Fin (L + 1) → ℕ} {q : Fin K → ℕ}
    (J : Fin (L + 1)) (ha : J.val + 1 ≤ K) (C : Finset (Fin (J.val + 1)))
    (hY : Real.exp 1 < Y) (hT : 0 < logLog Y)
    (hge : ∀ i, i.val ≤ (CollisionClass.index C i).val)
    (hfirst : ∀ i, i.val = 0 → (CollisionClass.index C i).val = 0)
    (hp17 : ∀ i, 17 ≤ p i)
    (hqS : ∀ j, 1 < (largestPrimeFactor (q j - 1) : ℝ))
    (hqY : ∀ j, ((q j - 1 : ℕ) : ℝ) ≤ Y)
    (hround : ∀ i : Fin (L + 1), i ≤ J →
      CollisionBox.shiftedCoordinate (logLog Y) (p i) ≤
        CollisionBox.rounded ε (fun r => CollisionBox.shiftedCoordinate (logLog Y) (p r)) i ∧
      (0 < i.val →
        CollisionBox.rounded ε (fun r => CollisionBox.shiftedCoordinate (logLog Y) (p r)) i <
          CollisionBox.shiftedCoordinate (logLog Y) (p i) + ε))
    (hw0 : CollisionBox.shiftedCoordinate (logLog Y) (p 0) ≤ 1)
    (hw0' : 1 - e₀ ≤ CollisionBox.shiftedCoordinate (logLog Y) (p 0))
    (he₀ : e₀ ≤ normalityDelta (logLog Y))
    (hδ : 0 ≤ normalityDelta (logLog Y)) (hε : 0 < ε)
    (hmatch : ∀ i : Fin (J.val + 1),
      |CollisionBox.shiftedCoordinate (logLog Y) (p (CollisionMatching.prefixIndex J i)) -
        CollisionBox.shiftedCoordinate (logLog Y) (q (Fin.castLE ha i))| ≤
          (2 * i.val + 1 : ℝ) * normalityDelta (logLog Y)) :
    let w := fun r => CollisionBox.shiftedCoordinate (logLog Y) (p r)
    let z := CollisionCutoff.selectedZeta J C ε w
    let v := CollisionCutoff.upper Y L (normalityDelta (logLog Y)) z zstar
    let W := CollisionCutoff.lower Y L (normalityDelta (logLog Y)) ε z zstar
    ∀ idx : Fin (CollisionClass.remaining C).card,
      (W idx.val ≤ (largestPrimeFactor (p (CollisionCutoff.selectedIndex J C idx) - 1) : ℝ) ∧
        (largestPrimeFactor (p (CollisionCutoff.selectedIndex J C idx) - 1) : ℝ) ≤ v idx.val) ∧
      (W idx.val ≤ (largestPrimeFactor (q (Fin.castLE ha (CollisionClass.index C idx)) - 1) : ℝ) ∧
        (largestPrimeFactor (q (Fin.castLE ha (CollisionClass.index C idx)) - 1) : ℝ) ≤ v idx.val) :=
by
  intro w z v W idx
  have hY0 : 0 < Y := (Real.exp_pos 1).trans hY
  have hlY : 1 < Real.log Y := (Real.lt_log_iff_exp_lt hY0).mpr hY
  have hl0 : 0 < Real.log Y := by linarith
  have hcut : ∀ a : ℝ, CollisionBox.cutoff Y a = Real.exp (Real.exp (logLog Y * a)) := by
    intro a
    unfold CollisionBox.cutoff
    rw [Real.rpow_def_of_pos hl0 a]
    rfl
  have hmono : ∀ x y : ℝ, Real.exp (Real.exp x) ≤ Real.exp (Real.exp y) ↔ x ≤ y := by
    intro x y
    rw [Real.exp_le_exp, Real.exp_le_exp]
  have hcmp : ∀ (a : ℝ) (r : ℕ), 1 < (r : ℝ) →
      (CollisionBox.cutoff Y a ≤ (r : ℝ) ↔ a ≤ logLog (r : ℝ) / logLog Y) ∧
      ((r : ℝ) ≤ CollisionBox.cutoff Y a ↔ logLog (r : ℝ) / logLog Y ≤ a) := by
    intro a r hr
    have hr0 : (0 : ℝ) < r := by linarith
    have hlr : 0 < Real.log r := Real.log_pos hr
    have e1 : (r : ℝ) = Real.exp (Real.exp (logLog (r : ℝ))) := by
      unfold logLog
      rw [Real.exp_log hlr, Real.exp_log hr0]
    rw [hcut a]
    constructor
    · rw [le_div_iff₀ hT, mul_comm a (logLog Y), ← hmono (logLog Y * a) (logLog (r : ℝ)), ← e1]
    · rw [div_le_iff₀ hT, mul_comm a (logLog Y), ← hmono (logLog (r : ℝ)) (logLog Y * a), ← e1]
  have hcut1 : CollisionBox.cutoff Y 1 = Y := by
    unfold CollisionBox.cutoff
    rw [Real.rpow_one, Real.exp_log hY0]
  have hP1 : ∀ m : ℕ, 17 ≤ m → 1 < (largestPrimeFactor (m - 1) : ℝ) := by
    intro m hm
    have hn1 : m - 1 ≠ 1 := by omega
    have hn0 : m - 1 ≠ 0 := by omega
    obtain ⟨r, hr, hrd⟩ := Nat.exists_prime_and_dvd hn1
    have hmem : r ∈ (m - 1).primeFactors := Nat.mem_primeFactors.mpr ⟨hr, hrd, hn0⟩
    have h1 : r ≤ (m - 1).primeFactors.sup id := Finset.le_sup (f := id) hmem
    have h2 : 2 ≤ largestPrimeFactor (m - 1) := by
      unfold largestPrimeFactor
      exact le_trans hr.two_le (le_trans h1 (le_max_right _ _))
    have h3 : 1 < largestPrimeFactor (m - 1) := by omega
    exact_mod_cast h3
  have hPle : ∀ n : ℕ, 1 < (largestPrimeFactor n : ℝ) → (largestPrimeFactor n : ℝ) ≤ n := by
    intro n h
    have h' : 1 < largestPrimeFactor n := by exact_mod_cast h
    rcases Nat.eq_zero_or_pos n with hn | hn
    · subst hn
      simp [largestPrimeFactor] at h'
    · have : largestPrimeFactor n ≤ n := by
        unfold largestPrimeFactor
        exact max_le hn (Finset.sup_le fun r hr => Nat.le_of_mem_primeFactors hr)
      exact_mod_cast this
  have hqle : ∀ j, CollisionBox.shiftedCoordinate (logLog Y) (q j) ≤ 1 := by
    intro j
    have h1 := hPle _ (hqS j)
    have h2 : (largestPrimeFactor (q j - 1) : ℝ) ≤ CollisionBox.cutoff Y 1 := by
      rw [hcut1]
      exact h1.trans (hqY j)
    exact (hcmp 1 _ (hqS j)).2.mp h2
  have hsc : (CollisionCutoff.selectedIndex J C idx).val = (CollisionClass.index C idx).val := rfl
  have hm : |CollisionBox.shiftedCoordinate (logLog Y) (p (CollisionCutoff.selectedIndex J C idx)) -
      CollisionBox.shiftedCoordinate (logLog Y) (q (Fin.castLE ha (CollisionClass.index C idx)))| ≤
      (2 * ((CollisionClass.index C idx).val : ℝ) + 1) * normalityDelta (logLog Y) :=
    hmatch (CollisionClass.index C idx)
  have hLδ : 0 ≤ (L : ℝ) * normalityDelta (logLog Y) := mul_nonneg (Nat.cast_nonneg L) hδ
  have hcJ := (CollisionClass.index C idx).isLt
  have hJL := J.isLt
  have hwin : CollisionCutoff.mu L (normalityDelta (logLog Y)) ε z zstar idx.val ≤
        CollisionBox.shiftedCoordinate (logLog Y) (p (CollisionCutoff.selectedIndex J C idx)) ∧
      CollisionBox.shiftedCoordinate (logLog Y) (p (CollisionCutoff.selectedIndex J C idx)) ≤
        CollisionCutoff.nu L (normalityDelta (logLog Y)) z zstar idx.val ∧
      CollisionCutoff.mu L (normalityDelta (logLog Y)) ε z zstar idx.val ≤
        CollisionBox.shiftedCoordinate (logLog Y) (q (Fin.castLE ha (CollisionClass.index C idx))) ∧
      CollisionBox.shiftedCoordinate (logLog Y) (q (Fin.castLE ha (CollisionClass.index C idx))) ≤
        CollisionCutoff.nu L (normalityDelta (logLog Y)) z zstar idx.val := by
    have hmu : CollisionCutoff.mu L (normalityDelta (logLog Y)) ε z zstar idx.val =
        CollisionCutoff.nu L (normalityDelta (logLog Y)) z zstar idx.val -
          (4 * (L : ℝ) + 2) * normalityDelta (logLog Y) - ε := rfl
    rw [hmu]
    have hq1 := hqle (Fin.castLE ha (CollisionClass.index C idx))
    rcases Nat.eq_zero_or_pos idx.val with hi0 | hipos
    · have hc0 := hfirst idx hi0
      have hs0 : CollisionCutoff.selectedIndex J C idx = 0 := Fin.ext (by simp [hsc, hc0])
      have hN : CollisionCutoff.nu L (normalityDelta (logLog Y)) z zstar idx.val = 1 := by
        unfold CollisionCutoff.nu
        rw [if_pos hi0]
      rw [hN]
      rw [hc0, hs0] at hm
      rw [hs0]
      have habs := abs_le.mp hm
      simp only [Nat.cast_zero, mul_zero, zero_add, one_mul] at habs
      obtain ⟨hA, hB⟩ := habs
      exact ⟨by linarith, hw0, by linarith, hq1⟩
    · have hc := hge idx
      have hs0 : 0 < (CollisionCutoff.selectedIndex J C idx).val := by rw [hsc]; omega
      have hsJ : CollisionCutoff.selectedIndex J C idx ≤ J := by
        rw [Fin.le_def, hsc]; omega
      obtain ⟨hlo, hhi⟩ := hround _ hsJ
      have hhi' := hhi hs0
      have hN : CollisionCutoff.nu L (normalityDelta (logLog Y)) z zstar idx.val =
          CollisionBox.rounded ε (fun r => CollisionBox.shiftedCoordinate (logLog Y) (p r))
            (CollisionCutoff.selectedIndex J C idx) +
              (2 * (L : ℝ) + 1) * normalityDelta (logLog Y) := by
        unfold CollisionCutoff.nu
        rw [if_neg (by omega), dif_pos idx.isLt]
        rfl
      rw [hN]
      have hcL : ((CollisionClass.index C idx).val : ℝ) ≤ L := by
        exact_mod_cast (by omega : (CollisionClass.index C idx).val ≤ L)
      have hcoef : (2 * ((CollisionClass.index C idx).val : ℝ) + 1) * normalityDelta (logLog Y) ≤
          (2 * (L : ℝ) + 1) * normalityDelta (logLog Y) :=
        mul_le_mul_of_nonneg_right (by linarith) hδ
      obtain ⟨hA, hB⟩ := abs_le.mp (hm.trans hcoef)
      exact ⟨by linarith, by linarith, by linarith, by linarith⟩
  obtain ⟨h1, h2, h3, h4⟩ := hwin
  have hps := hP1 _ (hp17 (CollisionCutoff.selectedIndex J C idx))
  have hqs := hqS (Fin.castLE ha (CollisionClass.index C idx))
  exact ⟨⟨(hcmp _ _ hps).1.mpr h1, (hcmp _ _ hps).2.mpr h2⟩,
    ⟨(hcmp _ _ hqs).1.mpr h3, (hcmp _ _ hqs).2.mpr h4⟩⟩

theorem rph_remaining_index_facts {a : ℕ} (C : Finset (Fin (a + 1)))
    (hzero : ∀ j : Fin (a + 1), j.val = 0 → j ∉ C) :
    1 ≤ (CollisionClass.remaining C).card ∧
    StrictMono (CollisionClass.index C) ∧
    (∀ i, i.val ≤ (CollisionClass.index C i).val) ∧
    (∀ i, i.val = 0 → (CollisionClass.index C i).val = 0) :=
by
  have h0mem : (0 : Fin (a + 1)) ∈ CollisionClass.remaining C := by
    unfold CollisionClass.remaining
    exact Finset.mem_sdiff.mpr ⟨Finset.mem_univ _, hzero 0 rfl⟩
  have hmono : StrictMono (CollisionClass.index C) := by
    intro i j hij
    unfold CollisionClass.index
    exact ((CollisionClass.remaining C).orderIsoOfFin rfl).strictMono hij
  refine ⟨Finset.card_pos.mpr ⟨0, h0mem⟩, hmono, ?_, ?_⟩
  · have key : ∀ n (hn : n < (CollisionClass.remaining C).card),
        n ≤ (CollisionClass.index C ⟨n, hn⟩).val := by
      intro n
      induction n with
      | zero => intro _; exact Nat.zero_le _
      | succ n ih =>
        intro hn
        have h1 := ih (by omega)
        have h2 : CollisionClass.index C ⟨n, by omega⟩ < CollisionClass.index C ⟨n + 1, hn⟩ :=
          hmono (Fin.mk_lt_mk.mpr (Nat.lt_succ_self n))
        rw [Fin.lt_def] at h2
        omega
    intro i
    exact key i.val i.isLt
  · intro i hi
    obtain ⟨i', hi'⟩ :=
      ((CollisionClass.remaining C).orderIsoOfFin rfl).surjective ⟨0, h0mem⟩
    have hidx : (CollisionClass.index C i').val = 0 := by
      unfold CollisionClass.index
      rw [hi']
      rfl
    by_contra hne
    have hlt : CollisionClass.index C i' < CollisionClass.index C i := by
      rw [Fin.lt_def]
      omega
    have h3 := hmono.lt_iff_lt.mp hlt
    rw [Fin.lt_def] at h3
    omega

theorem rph_matched_prefix_of_boxes {L N d K s : ℕ} {Y e e₀ g θ : ℝ} {x : Fin (L + 1) → ℝ}
    {p : Fin (L + 1) → ℕ} {q : Fin K → ℕ}
    (hY : Real.exp 1 < Y) (hT1 : 1 < logLog Y) (hN : 0 < N)
    (hQ : K = (N.primeFactors.filter fun r =>
          normalityScale (logLog Y) < (largestPrimeFactor (r - 1) : ℝ)).card ∧
      s = (∏ r ∈ N.primeFactors with (largestPrimeFactor (r - 1) : ℝ) ≤ normalityScale (logLog Y),
        r ^ (N.factorization r - 1) * (r - 1)) ∧
      (∀ idx, SNormal (normalityScale (logLog Y)) (q idx)) ∧ Function.Injective q ∧
      StrictAnti (fun idx => largestPrimeFactor (q idx - 1)) ∧
      (∀ idx, normalityScale (logLog Y) < (largestPrimeFactor (q idx - 1) : ℝ)) ∧
      (∀ idx, N.factorization (q idx) = 1) ∧
      N.totient = s * (∏ idx, (q idx - 1)) ∧ 0 < s ∧
      (largestPrimeFactor s : ℝ) ≤ normalityScale (logLog Y))
    (hB : 0 < (logLog Y) ^ (-1 / 3 : ℝ) ∧ 0 < 1 / logLog Y ∧ 0 < (logLog Y) ^ (-2 / 5 : ℝ) ∧
      0 ≤ g ∧ Antitone x ∧
      (∀ idx, CollisionBox.shiftedCoordinate (logLog Y) (p idx) ≤ x idx) ∧
      (∀ idx, (logLog Y) ^ (-1 / 3 : ℝ) ≤ x idx →
        x idx - e ≤ CollisionBox.shiftedCoordinate (logLog Y) (p idx)) ∧
      (∀ idx j : Fin (L + 1), 0 < idx.val → idx < j → g * x idx ≤ x idx - x j) ∧
      (∀ idx : Fin (L + 1), 0 < idx.val → x idx ≤ θ) ∧
      (logLog Y) ^ (-1 / 3 : ℝ) < CollisionBox.shiftedCoordinate (logLog Y) (p 0) ∧
      CollisionBox.shiftedCoordinate (logLog Y) (p 0) ≤ 1 ∧
      1 - e₀ ≤ CollisionBox.shiftedCoordinate (logLog Y) (p 0) ∧
      CollisionBox.shiftedCoordinate (logLog Y) (p (Fin.last L)) ≤ (logLog Y) ^ (-1 / 3 : ℝ) ∧
      10 * (logLog Y) ^ (-2 / 5 : ℝ) + 1 / logLog Y + e ≤ g * (logLog Y) ^ (-1 / 3 : ℝ) ∧
      10 * (logLog Y) ^ (-2 / 5 : ℝ) + 1 / logLog Y + e₀ ≤ 1 - θ ∧
      4 * (logLog Y) ^ (-2 / 5 : ℝ) ≤ (logLog Y) ^ (-1 / 3 : ℝ))
    (hm : 0 < logLog Y ∧ 0 ≤ normalityDelta (logLog Y) ∧ 0 < 1 / logLog Y ∧
      0 < logLog Y ^ (-2 / 5 : ℝ) ∧
      (4 * (L : ℝ) + 4) * normalityDelta (logLog Y) + 1 / logLog Y ≤ logLog Y ^ (-2 / 5 : ℝ) ∧
      θ + 2 * (1 / logLog Y) + (6 * (L : ℝ) + 3) * normalityDelta (logLog Y) < 1 ∧
      logLog Y ^ (-1 / 3 : ℝ) + 1 / logLog Y + (6 * (L : ℝ) + 5) * normalityDelta (logLog Y) < 1 ∧
      θ + 1 / logLog Y + (2 * (L : ℝ) + 1) * normalityDelta (logLog Y) +
        Real.log (10 * logLog Y) / logLog Y ≤ 1 ∧
      logLog Y ^ (-1 / 3 : ℝ) + (2 * (L : ℝ) + 3) * normalityDelta (logLog Y) +
        Real.log (10 * logLog Y) / logLog Y ≤ 1 ∧
      Real.log (logLog Y) ^ 10 ≤ logLog Y ^ (-1 / 3 : ℝ) * logLog Y / 2)
    (he₀ : e₀ ≤ normalityDelta (logLog Y))
    (hp : ∀ idx, SNormal (normalityScale (logLog Y)) (p idx)) (hp17 : ∀ idx, 17 ≤ p idx)
    (hd : 0 < d) (hdS : (largestPrimeFactor d : ℝ) ≤ normalityScale (logLog Y))
    (hphi : N.totient = d * ∏ idx, (p idx - 1)) (hsize : (N.totient : ℝ) ≤ Y) :
    ∃ J : Fin (L + 1), J.val < L ∧ ∃ ha : J.val + 1 ≤ K,
      (∀ idx : Fin (J.val + 1),
        |CollisionBox.shiftedCoordinate (logLog Y) (p (CollisionMatching.prefixIndex J idx)) -
          CollisionBox.shiftedCoordinate (logLog Y) (q (Fin.castLE ha idx))| ≤
            (2 * idx.val + 1 : ℝ) * normalityDelta (logLog Y)) ∧
      (∀ idx : Fin (L + 1), J < idx → ∀ z ∈ (p idx - 1).primeFactorsList, (z : ℝ) ≤
        CollisionBox.cutoff Y (CollisionBox.tailCoordinate (1 / logLog Y) ((logLog Y) ^ (-2 / 5 : ℝ))
          ((logLog Y) ^ (-1 / 3 : ℝ)) (fun i => CollisionBox.shiftedCoordinate (logLog Y) (p i)) J +
          (2 * (L : ℝ) + 3) * normalityDelta (logLog Y))) ∧
      (∀ j : Fin K, J.val + 1 ≤ j.val → (largestPrimeFactor (q j - 1) : ℝ) <
        CollisionBox.cutoff Y (CollisionBox.tailCoordinate (1 / logLog Y) ((logLog Y) ^ (-2 / 5 : ℝ))
          ((logLog Y) ^ (-1 / 3 : ℝ)) (fun i => CollisionBox.shiftedCoordinate (logLog Y) (p i)) J +
          (2 * (L : ℝ) + 3) * normalityDelta (logLog Y))) ∧
      (∀ z ∈ (s * ∏ j ∈ Finset.univ.filter (fun j : Fin K => J.val + 1 ≤ j.val),
          (q j - 1)).primeFactorsList, (z : ℝ) ≤
        CollisionBox.cutoff Y (CollisionBox.tailCoordinate (1 / logLog Y) ((logLog Y) ^ (-2 / 5 : ℝ))
          ((logLog Y) ^ (-1 / 3 : ℝ)) (fun i => CollisionBox.shiftedCoordinate (logLog Y) (p i)) J +
          (2 * (L : ℝ) + 3) * normalityDelta (logLog Y))) ∧
      (∀ C : Finset (Fin (J.val + 1)), (∀ j : Fin (J.val + 1), j.val = 0 → j ∉ C) →
        let k := (CollisionClass.remaining C).card
        let w := fun i => CollisionBox.shiftedCoordinate (logLog Y) (p i)
        let z := CollisionCutoff.selectedZeta J C (1 / logLog Y) w
        let zstar := CollisionBox.tailCoordinate (1 / logLog Y) ((logLog Y) ^ (-2 / 5 : ℝ))
          ((logLog Y) ^ (-1 / 3 : ℝ)) w J
        let v := CollisionCutoff.upper Y L (normalityDelta (logLog Y)) z zstar
        let W := CollisionCutoff.lower Y L (normalityDelta (logLog Y)) (1 / logLog Y) z zstar
        1 ≤ k ∧ CollisionCutoff.SieveCutoffs k Y (normalityDelta (logLog Y)) v W ∧
          ∀ idx : Fin k,
            (W idx.val ≤ (largestPrimeFactor (p (CollisionCutoff.selectedIndex J C idx) - 1) : ℝ) ∧
              (largestPrimeFactor (p (CollisionCutoff.selectedIndex J C idx) - 1) : ℝ) ≤ v idx.val) ∧
            (W idx.val ≤ (largestPrimeFactor (q (Fin.castLE ha (CollisionClass.index C idx)) - 1) : ℝ) ∧
              (largestPrimeFactor (q (Fin.castLE ha (CollisionClass.index C idx)) - 1) : ℝ) ≤
                v idx.val)) :=
by
  obtain ⟨hb0, hε0, hh0, hg, hxanti, hwx, happ, hcon, hθ, hhead, hhead1, hheadapp, hlast,
    hlower, hheadgap, htm⟩ := hB
  obtain ⟨hT0, hδ0, -, -, hbudget, hfi, hft, hsi, hst, hnorm⟩ := hm
  obtain ⟨-, -, hqN, -, hqsort, hqlarge, -, hQeq, hs, hsS⟩ := hQ
  have hphipos : 0 < N.totient := Nat.totient_pos.mpr hN
  have hpY : ∀ i, ((p i - 1 : ℕ) : ℝ) ≤ Y := by
    intro i
    have hdvd : p i - 1 ∣ N.totient := by
      rw [hphi]
      exact Dvd.dvd.mul_left (Finset.dvd_prod_of_mem _ (Finset.mem_univ i)) d
    exact le_trans (Nat.cast_le.mpr (Nat.le_of_dvd hphipos hdvd)) hsize
  have hqY : ∀ j, ((q j - 1 : ℕ) : ℝ) ≤ Y := by
    intro j
    have hdvd : q j - 1 ∣ N.totient := by
      rw [hQeq]
      exact Dvd.dvd.mul_left (Finset.dvd_prod_of_mem _ (Finset.mem_univ j)) s
    exact le_trans (Nat.cast_le.mpr (Nat.le_of_dvd hphipos hdvd)) hsize
  have hS1 : (1 : ℝ) ≤ normalityScale (logLog Y) := by
    unfold normalityScale
    exact Real.one_le_exp (Real.exp_pos _).le
  have hqS : ∀ j, (1 : ℝ) < (largestPrimeFactor (q j - 1) : ℝ) :=
    fun j => lt_of_le_of_lt hS1 (hqlarge j)
  have hbal : ∀ u v : ℝ, normalityScale (logLog Y) ≤ u → u < v →
      (∑ i, omegaInterval (p i - 1) u v) = ∑ j, omegaInterval (q j - 1) u v :=
    fun u v hu _ => rph_shifted_interval_balance p q (fun i => (hp i).1) (fun j => (hqN j).1)
      hd.ne' hs.ne' (hphi.symm.trans hQeq) hdS hsS hu
  obtain ⟨J, hJL, hpre, hgap, hround, hint, hsep, hzlo, hzhi, htg, htailw⟩ :=
    rph_box_prefix_structure (x := x)
      (w := fun i => CollisionBox.shiftedCoordinate (logLog Y) (p i))
      hb0 hε0 hh0 hg hxanti hwx happ hcon hθ hhead hhead1 hheadapp hlast hlower hheadgap htm
  have hmatch_at : ∀ i0 : Fin (L + 1), i0 ≤ J → ∃ j : Fin K, j.val = i0.val ∧
      |CollisionBox.shiftedCoordinate (logLog Y) (p i0) -
        CollisionBox.shiftedCoordinate (logLog Y) (q j)| ≤
          (2 * i0.val + 1 : ℝ) * normalityDelta (logLog Y) := by
    intro i0 hi0
    have hbefore : ∀ j, j ≤ i0 → CollisionBox.shiftedCoordinate (logLog Y) (p i0) ≤
        CollisionBox.shiftedCoordinate (logLog Y) (p j) := by
      intro j hj
      rcases eq_or_lt_of_le hj with h | h
      · rw [h]
      · have := hgap j i0 (le_trans hj hi0) h
        simp only at this
        linarith
    have hafter : ∀ j, i0 ≤ j → CollisionBox.shiftedCoordinate (logLog Y) (p j) ≤
        CollisionBox.shiftedCoordinate (logLog Y) (p i0) := by
      intro j hj
      rcases eq_or_lt_of_le hj with h | h
      · rw [h]
      · have := hgap i0 j hi0 h
        simp only at this
        linarith
    exact rph_high_index_match hY hT1 hp hp17 hpY hqN hqsort hqlarge hqY hbal hε0 hh0 hbudget
      htm hnorm i0 hbefore hafter ((hpre i0).mp hi0)
  obtain ⟨jJ, hjJ, -⟩ := hmatch_at J le_rfl
  have ha : J.val + 1 ≤ K := by
    have := jJ.isLt
    omega
  have hO1 : ∀ idx : Fin (J.val + 1),
      |CollisionBox.shiftedCoordinate (logLog Y) (p (CollisionMatching.prefixIndex J idx)) -
        CollisionBox.shiftedCoordinate (logLog Y) (q (Fin.castLE ha idx))| ≤
          (2 * idx.val + 1 : ℝ) * normalityDelta (logLog Y) := by
    intro i
    have hle : CollisionMatching.prefixIndex J i ≤ J := by
      rw [Fin.le_def]
      show i.val ≤ J.val
      have := i.isLt
      omega
    obtain ⟨j, hj, hbd⟩ := hmatch_at _ hle
    have hjeq : j = Fin.castLE ha i := Fin.ext hj
    rw [← hjeq]
    exact hbd
  obtain ⟨hO2, hO3, hO4⟩ := rph_tail_package (b := (logLog Y) ^ (-1 / 3 : ℝ))
    (ε := 1 / logLog Y) J hJL hY hT1 hp hp17 hqN hqsort hs hsS hbal hε0 hft hnorm hzlo hzhi
    htailw
  refine ⟨J, hJL, ha, hO1, hO2, hO3, hO4, ?_⟩
  intro C hzero
  obtain ⟨hk, hmono, hge, hfirst⟩ := rph_remaining_index_facts C hzero
  intro k w z zstar v W
  exact ⟨hk,
    rph_selected_sieve_cutoffs (zstar := zstar) J C hY hT0 hk hmono hge hfirst hint hsep htg
      hzlo hzhi hδ0 hε0 hh0 hbudget hfi hft hsi hst hnorm,
    rph_paired_interval_bounds (zstar := zstar) J ha C hY hT0 hge hfirst hp17 hqS hqY hround
      hhead1 hheadapp he₀ hδ0 hε0 hO1⟩

theorem rph_record_of_matched {L N d K s : ℕ} {Y : ℝ} {p : Fin (L + 1) → ℕ} {q : Fin K → ℕ}
    (hQ : K = (N.primeFactors.filter fun r =>
          normalityScale (logLog Y) < (largestPrimeFactor (r - 1) : ℝ)).card ∧
      s = (∏ r ∈ N.primeFactors with (largestPrimeFactor (r - 1) : ℝ) ≤ normalityScale (logLog Y),
        r ^ (N.factorization r - 1) * (r - 1)) ∧
      (∀ idx, SNormal (normalityScale (logLog Y)) (q idx)) ∧ Function.Injective q ∧
      StrictAnti (fun idx => largestPrimeFactor (q idx - 1)) ∧
      (∀ idx, normalityScale (logLog Y) < (largestPrimeFactor (q idx - 1) : ℝ)) ∧
      (∀ idx, N.factorization (q idx) = 1) ∧
      N.totient = s * (∏ idx, (q idx - 1)) ∧ 0 < s ∧
      (largestPrimeFactor s : ℝ) ≤ normalityScale (logLog Y))
    (J : Fin (L + 1)) (ha : J.val + 1 ≤ K)
    (hm : (∀ idx : Fin (J.val + 1),
        |CollisionBox.shiftedCoordinate (logLog Y) (p (CollisionMatching.prefixIndex J idx)) -
          CollisionBox.shiftedCoordinate (logLog Y) (q (Fin.castLE ha idx))| ≤
            (2 * idx.val + 1 : ℝ) * normalityDelta (logLog Y)) ∧
      (∀ idx : Fin (L + 1), J < idx → ∀ z ∈ (p idx - 1).primeFactorsList, (z : ℝ) ≤
        CollisionBox.cutoff Y (CollisionBox.tailCoordinate (1 / logLog Y) ((logLog Y) ^ (-2 / 5 : ℝ))
          ((logLog Y) ^ (-1 / 3 : ℝ)) (fun i => CollisionBox.shiftedCoordinate (logLog Y) (p i)) J +
          (2 * (L : ℝ) + 3) * normalityDelta (logLog Y))) ∧
      (∀ j : Fin K, J.val + 1 ≤ j.val → (largestPrimeFactor (q j - 1) : ℝ) <
        CollisionBox.cutoff Y (CollisionBox.tailCoordinate (1 / logLog Y) ((logLog Y) ^ (-2 / 5 : ℝ))
          ((logLog Y) ^ (-1 / 3 : ℝ)) (fun i => CollisionBox.shiftedCoordinate (logLog Y) (p i)) J +
          (2 * (L : ℝ) + 3) * normalityDelta (logLog Y))) ∧
      (∀ z ∈ (s * ∏ j ∈ Finset.univ.filter (fun j : Fin K => J.val + 1 ≤ j.val),
          (q j - 1)).primeFactorsList, (z : ℝ) ≤
        CollisionBox.cutoff Y (CollisionBox.tailCoordinate (1 / logLog Y) ((logLog Y) ^ (-2 / 5 : ℝ))
          ((logLog Y) ^ (-1 / 3 : ℝ)) (fun i => CollisionBox.shiftedCoordinate (logLog Y) (p i)) J +
          (2 * (L : ℝ) + 3) * normalityDelta (logLog Y))) ∧
      (∀ C : Finset (Fin (J.val + 1)), (∀ j : Fin (J.val + 1), j.val = 0 → j ∉ C) →
        let k := (CollisionClass.remaining C).card
        let w := fun i => CollisionBox.shiftedCoordinate (logLog Y) (p i)
        let z := CollisionCutoff.selectedZeta J C (1 / logLog Y) w
        let zstar := CollisionBox.tailCoordinate (1 / logLog Y) ((logLog Y) ^ (-2 / 5 : ℝ))
          ((logLog Y) ^ (-1 / 3 : ℝ)) w J
        let v := CollisionCutoff.upper Y L (normalityDelta (logLog Y)) z zstar
        let W := CollisionCutoff.lower Y L (normalityDelta (logLog Y)) (1 / logLog Y) z zstar
        1 ≤ k ∧ CollisionCutoff.SieveCutoffs k Y (normalityDelta (logLog Y)) v W ∧
          ∀ idx : Fin k,
            (W idx.val ≤ (largestPrimeFactor (p (CollisionCutoff.selectedIndex J C idx) - 1) : ℝ) ∧
              (largestPrimeFactor (p (CollisionCutoff.selectedIndex J C idx) - 1) : ℝ) ≤ v idx.val) ∧
            (W idx.val ≤ (largestPrimeFactor (q (Fin.castLE ha (CollisionClass.index C idx)) - 1) : ℝ) ∧
              (largestPrimeFactor (q (Fin.castLE ha (CollisionClass.index C idx)) - 1) : ℝ) ≤
                v idx.val)))
    (hJL : J.val < L) (hN : 0 < N)
    (hp : ∀ idx, SNormal (normalityScale (logLog Y)) (p idx)) (hinj : Function.Injective p)
    (hp17 : ∀ idx, 17 ≤ p idx) (horder : Antitone p)
    (hphi : N.totient = d * ∏ idx, (p idx - 1)) (hsize : (N.totient : ℝ) ≤ Y)
    (hsquare : NoLargePrimeSquare N.totient (normalityScale (logLog Y)))
    (htop : Y ^ (9 / 10 : ℝ) < (p 0 : ℝ)) (hsizetop : N ≤ (p 0) ^ 2)
    (hneq : largestPrimeFactor N ≠ p 0)
    (hfacet : (∑ idx ∈ Finset.Icc 1 L, fordWeight idx *
      CollisionFacet.extend (fun j => CollisionBox.primeCoordinate (logLog Y) (p j)) idx) ≤
        1 - (logLog Y) ^ (-1 / 8 : ℝ)) :
    ∃ r : CollisionSum.Record Y L d, r.integer = ∏ idx, p idx :=
by
  classical
  obtain ⟨_hK, _hs, hqn, _hqinj, _hqanti, _hqlarge, hqonce, hqphi, hspos, _hssmooth⟩ := hQ
  obtain ⟨_hpre, hleft, _hright, hres, hpaired⟩ := hm
  
  have hp0ndvd : ¬ p 0 ∣ N := by
    intro hpN
    have hp0 : (p 0).Prime := (hp 0).1
    have hmem : p 0 ∈ N.primeFactors := Nat.mem_primeFactors.mpr ⟨hp0, hpN, hN.ne'⟩
    obtain ⟨r, hr, hsup⟩ := Finset.exists_mem_eq_sup N.primeFactors ⟨p 0, hmem⟩ id
    have hle : p 0 ≤ r := by
      have := Finset.le_sup (f := id) hmem
      rw [hsup] at this
      exact this
    have hrp : r.Prime := Nat.prime_of_mem_primeFactors hr
    have hrN : r ∣ N := Nat.dvd_of_mem_primeFactors hr
    have hlpf : largestPrimeFactor N = r := by
      unfold largestPrimeFactor
      rw [hsup]
      have := hrp.two_le
      exact max_eq_right (by simp only [id]; omega)
    have hne : r ≠ p 0 := fun h => hneq (hlpf.trans h)
    have hlt : p 0 < r := lt_of_le_of_ne hle (Ne.symm hne)
    have hcop : Nat.Coprime (p 0) r := (Nat.coprime_primes hp0 hrp).mpr (ne_of_lt hlt)
    have hdvd : p 0 * r ∣ N := hcop.mul_dvd_of_dvd_of_dvd hpN hrN
    have hle2 : p 0 * r ≤ N := Nat.le_of_dvd hN hdvd
    have hpos : 0 < p 0 := hp0.pos
    have hmul : p 0 * p 0 < p 0 * r := Nat.mul_lt_mul_of_pos_left hlt hpos
    have hsq : p 0 ^ 2 = p 0 * p 0 := sq (p 0)
    omega
  let right : Fin (J.val + 1) → ℕ := fun idx => q (Fin.castLE ha idx)
  let res : ℕ := s * ∏ j ∈ Finset.univ.filter (fun j : Fin K => J.val + 1 ≤ j.val), (q j - 1)
  let C : Finset (Fin (J.val + 1)) :=
    commonIndices Finset.univ (CollisionRecord.leftPrimes J p) right
  have hzero : ∀ idx : Fin (J.val + 1), idx.val = 0 → idx ∉ C := by
    intro idx hi hmem
    have heq : p (CollisionMatching.prefixIndex J idx) = q (Fin.castLE ha idx) :=
      (Finset.mem_filter.mp hmem).2
    have h0 : CollisionMatching.prefixIndex J idx = 0 :=
      Fin.ext (by simp [CollisionMatching.prefixIndex, hi])
    rw [h0] at heq
    have hqdvd : q (Fin.castLE ha idx) ∣ N := by
      have := hqonce (Fin.castLE ha idx)
      exact ((hqn _).1.dvd_iff_one_le_factorization hN.ne').mpr (by omega)
    exact hp0ndvd (heq ▸ hqdvd)
  obtain ⟨hk, hv, hpair⟩ := hpaired C hzero
  have htailEq : CollisionBox.cutoff Y (CollisionBox.tailCoordinate (1 / logLog Y)
      ((logLog Y) ^ (-2 / 5 : ℝ)) ((logLog Y) ^ (-1 / 3 : ℝ))
      (fun i => CollisionBox.shiftedCoordinate (logLog Y) (p i)) J +
        (2 * (L : ℝ) + 3) * normalityDelta (logLog Y)) =
      CollisionSum.upper Y p J C (CollisionClass.remaining C).card := by
    have hk' : (CollisionClass.remaining C).card ≠ 0 := by omega
    simp only [CollisionSum.upper, CollisionRecord.upper, CollisionCutoff.upper,
      CollisionCutoff.nu, hk', if_false, lt_irrefl, dite_false]
  
  have hsplitP : ∀ f : Fin (L + 1) → ℕ,
      (∏ idx : Fin (J.val + 1), f (CollisionMatching.prefixIndex J idx)) *
        (∏ idx : Fin (L - J.val), f (CollisionRecord.tailIndex J idx)) = ∏ idx, f idx := by
    intro f
    have hlen : (J.val + 1) + (L - J.val) = L + 1 := by have := J.isLt; omega
    have hprod := Fin.prod_congr' f hlen
    rw [Fin.prod_univ_add] at hprod
    exact hprod
  
  have hsplitQ : (∏ idx : Fin (J.val + 1), (q (Fin.castLE ha idx) - 1)) *
      (∏ j ∈ Finset.univ.filter (fun j : Fin K => J.val + 1 ≤ j.val), (q j - 1)) =
        ∏ j, (q j - 1) := by
    have hpre : ∏ idx : Fin (J.val + 1), (q (Fin.castLE ha idx) - 1) =
        ∏ j ∈ Finset.univ.filter (fun j : Fin K => j.val < J.val + 1), (q j - 1) := by
      apply Finset.prod_bij (fun idx _ => Fin.castLE ha idx)
      · intro idx _
        simp only [Finset.mem_filter, Finset.mem_univ, true_and, Fin.coe_castLE]
        exact idx.isLt
      · intro a _ b _ h
        exact Fin.ext (by simpa using congrArg Fin.val h)
      · intro j hj
        exact ⟨⟨j.val, (Finset.mem_filter.mp hj).2⟩, Finset.mem_univ _, Fin.ext rfl⟩
      · intro idx _
        rfl
    rw [hpre]
    have h := Finset.prod_filter_mul_prod_filter_not Finset.univ
      (fun j : Fin K => j.val < J.val + 1) (fun j => q j - 1)
    simpa only [not_lt] using h
  have hL : d * ((∏ idx, (CollisionRecord.leftPrimes J p idx - 1)) *
      (∏ j, (CollisionRecord.tailPrimes J p j - 1))) = N.totient := by
    rw [hphi]
    congr 1
    exact hsplitP (fun i => p i - 1)
  have hR : (∏ idx, (right idx - 1)) * res = N.totient := by
    rw [hqphi, ← hsplitQ]
    simp only [right, res]
    ring
  have hcond : CollisionClass.Conditions C d (CollisionRecord.commonProduct J p C) (∏ idx, p idx)
      (normalityScale (logLog Y)) Y (CollisionSum.upper Y p J C) (CollisionSum.lower Y p J C)
      (CollisionRecord.leftPrimes J p) right (CollisionRecord.tailPrimes J p) res := by
    refine
      { normal_left := fun idx => hp _
        normal_right := fun idx => hqn _
        normal_tail := fun idx => hp _
        left_injective := ?_
        residual_pos := ?_
        common := rfl
        common_product := rfl
        integer := hsplitP p
        equation := hL.trans hR.symm
        size := ?_
        square_exclusion := ?_
        largest_left := fun idx => (hpair idx).1
        largest_right := fun idx => (hpair idx).2
        tail_support := ?_
        residual_support := ?_
        top := ?_ }
    · intro a b hab
      have h := congrArg (fun x : Fin (L + 1) => x.val) (hinj hab)
      exact Fin.ext h
    · exact Nat.mul_pos hspos (Finset.prod_pos fun j _ => by have := (hqn j).1.two_le; omega)
    · rw [hL]
      exact hsize
    · rw [hL]
      exact fun r hr hlt => hsquare r hr (lt_of_le_of_lt hv.normality hlt)
    · intro idx z hz
      have hlt : J < CollisionRecord.tailIndex J idx := by
        rw [Fin.lt_iff_val_lt_val]
        show J.val < J.val + 1 + idx.val
        omega
      exact (hleft (CollisionRecord.tailIndex J idx) hlt z hz).trans_eq htailEq
    · intro z hz
      exact (hres z hz).trans_eq htailEq
    · intro idx hi
      have h0 : CollisionMatching.prefixIndex J idx = 0 :=
        Fin.ext (by simp [CollisionMatching.prefixIndex, hi])
      show Y ^ (9 / 10 : ℝ) < (p (CollisionMatching.prefixIndex J idx) : ℝ)
      rw [h0]
      exact htop
  exact ⟨⟨∏ idx, p idx, p, J, C, right, res, hJL, hzero, hv, hcond, hp17, horder, hfacet⟩, rfl⟩

theorem retained_pair_has_record (A P κ θ : ℝ) (hκ : 1 < κ) (hθ : θ < 1)
    (hsize : ∃ D : ℝ, 0 < D ∧ ∀ᶠ Y : ℝ in atTop, ∀ n : ℕ, 0 < n → (n.totient : ℝ) ≤ Y →
      (n : ℝ) ≤ D * Y * logLog Y) :
    ∀ᶠ Y : ℝ in atTop, ∀ (L d n : ℕ) (p : Fin (L + 1) → ℕ) (N : ℕ),
      (L : ℝ) ≤ A * Real.log (logLog Y) → 0 < d →
      (largestPrimeFactor d : ℝ) ≤ normalityScale (logLog Y) →
      CollisionSum.RetainedPair Y P κ θ d n p N →
      ∃ r : CollisionSum.Record Y L d, r.integer = n :=
by
  have hT : Tendsto logLog atTop atTop := Real.tendsto_log_atTop.comp Real.tendsto_log_atTop
  
  have c1 : ∀ᶠ Y : ℝ in atTop, Real.log Y ^ 4 < normalityScale (logLog Y) := by
    have hU : Tendsto (fun Y => Real.log (logLog Y)) atTop atTop := Real.tendsto_log_atTop.comp hT
    filter_upwards [hU.eventually_ge_atTop 4, hT.eventually_gt_atTop 0,
      eventually_gt_atTop (1 : ℝ)] with Y hU4 hT0 hY1
    have hlogY : 0 < Real.log Y := Real.log_pos hY1
    have hlog4 : Real.log 4 ≤ 3 := by
      have := Real.log_le_sub_one_of_pos (by norm_num : (0 : ℝ) < 4)
      linarith
    have hU2 : Real.log (logLog Y) ^ 2 ≤ Real.log (logLog Y) ^ 10 :=
      pow_le_pow_right₀ (by linarith) (by norm_num)
    have hkey : Real.log 4 + Real.log (logLog Y) < Real.log (logLog Y) ^ 10 := by nlinarith
    have h4T : 4 * logLog Y = Real.exp (Real.log 4 + Real.log (logLog Y)) := by
      rw [Real.exp_add, Real.exp_log (by norm_num), Real.exp_log hT0]
    have hlt : Real.log (Real.log Y ^ 4) < Real.log (normalityScale (logLog Y)) := by
      rw [Real.log_pow, normalityScale, Real.log_exp]
      have h4 : ((4 : ℕ) : ℝ) * Real.log (Real.log Y) = 4 * logLog Y := by
        simp [logLog]
      rw [h4, h4T]
      exact Real.exp_lt_exp.mpr hkey
    exact (Real.log_lt_log_iff (by positivity) (Real.exp_pos _)).mp hlt
  
  have c6 : ∀ᶠ T : ℝ in atTop, Real.log (6 * T) / T ≤ normalityDelta T := by
    filter_upwards [eventually_ge_atTop (Real.exp 5)] with T hT5
    have hTpos : 0 < T := lt_of_lt_of_le (Real.exp_pos _) hT5
    have hl5 : 5 ≤ Real.log T := by
      have := Real.log_le_log (Real.exp_pos 5) hT5
      rwa [Real.log_exp] at this
    have hT1 : 1 ≤ T := le_trans (by have := Real.add_one_le_exp (5 : ℝ); linarith) hT5
    have hlog6 : Real.log 6 ≤ 5 := by
      have := Real.log_le_sub_one_of_pos (by norm_num : (0 : ℝ) < 6)
      linarith
    have hs1 : 1 ≤ Real.sqrt T := Real.one_le_sqrt.mpr hT1
    have hsq : Real.sqrt T * Real.sqrt T = T := Real.mul_self_sqrt hTpos.le
    have hspos : 0 < Real.sqrt T := by linarith
    have hl4 : 1 ≤ Real.log T ^ 4 := one_le_pow₀ (by linarith)
    have h5 : Real.log T ^ 5 = Real.log T * Real.log T ^ 4 := by ring
    have h1 : Real.log T ≤ Real.log T ^ 5 := by
      rw [h5]; exact le_mul_of_one_le_right (by linarith) hl4
    have h2 : Real.log T ^ 5 ≤ Real.log T ^ 5 * Real.sqrt T :=
      le_mul_of_one_le_right (by positivity) hs1
    have hmain : Real.log 6 + Real.log T ≤ 2 * Real.log T ^ 5 * Real.sqrt T := by
      nlinarith
    unfold normalityDelta
    rw [Real.log_mul (by norm_num) hTpos.ne', div_le_div_iff₀ hTpos hspos]
    calc (Real.log 6 + Real.log T) * Real.sqrt T
        ≤ 2 * Real.log T ^ 5 * Real.sqrt T * Real.sqrt T :=
          mul_le_mul_of_nonneg_right hmain hspos.le
      _ = 2 * Real.log T ^ 5 * T := by rw [mul_assoc _ (Real.sqrt T), hsq]
  
  have c2 : ∀ᶠ Y : ℝ in atTop, ∀ N p : ℕ, 0 < N → (N.totient : ℝ) ≤ Y →
      Y ^ (9 / 10 : ℝ) < (p : ℝ) → N ≤ p ^ 2 := by
    obtain ⟨D, hD, hpre⟩ := hsize
    have hlo := (isLittleO_log_rpow_atTop (by norm_num : (0 : ℝ) < 4 / 5)).bound
      (by positivity : (0 : ℝ) < 1 / D)
    filter_upwards [hpre, hlo, eventually_gt_atTop (1 : ℝ)] with Y hpre hbound hY
    have hYpos : 0 < Y := by linarith
    have hlogpos : 0 < Real.log Y := Real.log_pos hY
    rw [Real.norm_eq_abs, Real.norm_eq_abs, abs_of_pos hlogpos,
      abs_of_nonneg (Real.rpow_nonneg hYpos.le _)] at hbound
    have hDl : D * Real.log Y ≤ Y ^ (4 / 5 : ℝ) := by
      have := mul_le_mul_of_nonneg_left hbound hD.le
      rw [← mul_assoc, mul_one_div_cancel hD.ne', one_mul] at this
      exact this
    have hpow1 : Y ^ (9 / 5 : ℝ) = Y * Y ^ (4 / 5 : ℝ) := by
      rw [show (9 / 5 : ℝ) = 1 + 4 / 5 by norm_num, Real.rpow_add hYpos, Real.rpow_one]
    have hpow2 : (Y ^ (9 / 10 : ℝ)) ^ 2 = Y ^ (9 / 5 : ℝ) := by
      rw [← Real.rpow_natCast, ← Real.rpow_mul hYpos.le]
      norm_num
    intro N p hN hsz htop
    have hll : logLog Y ≤ Real.log Y := by
      unfold logLog
      exact Real.log_le_self hlogpos.le
    have hreal : (N : ℝ) ≤ (p : ℝ) ^ 2 := by
      calc (N : ℝ) ≤ D * Y * logLog Y := hpre N hN hsz
        _ ≤ D * Y * Real.log Y := mul_le_mul_of_nonneg_left hll (by positivity)
        _ = Y * (D * Real.log Y) := by ring
        _ ≤ Y * Y ^ (4 / 5 : ℝ) := mul_le_mul_of_nonneg_left hDl hYpos.le
        _ = (Y ^ (9 / 10 : ℝ)) ^ 2 := by rw [hpow2, hpow1]
        _ ≤ (p : ℝ) ^ 2 := pow_le_pow_left₀ (Real.rpow_nonneg hYpos.le _) htop.le 2
    exact_mod_cast hreal
  
  filter_upwards [hT.eventually (rph_prime_data_eventually 1 P κ θ hκ hθ),
    hT.eventually (rph_margins_eventually A θ hθ), hT.eventually c6,
    hT.eventually_ge_atTop 2, eventually_gt_atTop (Real.exp 1), c2, c1]
    with Y hpdata hmargin he₀ hT2 hY htopsize hcutoff
  intro L d n p N hL hd hdS hR
  have hYone : 1 < Y := lt_trans (Real.one_lt_exp_iff.mpr one_pos) hY
  have hYpos : 0 < Y := by linarith
  have hYY : Real.exp (Real.exp (logLog Y)) = Y := by
    unfold logLog
    rw [Real.exp_log (Real.log_pos hYone), Real.exp_log hYpos]
  have hS : 1 ≤ normalityScale (logLog Y) := by
    unfold normalityScale
    exact Real.one_le_exp (Real.exp_pos _).le
  have hcut : Real.log Y ^ 4 ≤ normalityScale (logLog Y) := hcutoff.le
  have hsqN : NoLargePrimeSquare N (normalityScale (logLog Y)) :=
    fun q hq h => hR.square_witness q hq (lt_of_le_of_lt hcut h)
  have hsqPhi : NoLargePrimeSquare N.totient (normalityScale (logLog Y)) :=
    fun q hq h => hR.square_totient q hq (lt_of_le_of_lt hcut h)
  obtain ⟨K, s, q, hQ⟩ := rph_exists_normalPreimageList hR.witness_pos hS hR.normal_right hsqN hsqPhi
  have hphipos : 0 < N.totient := Nat.totient_pos.mpr hR.witness_pos
  have hshift : ∀ idx, ((p idx - 1 : ℕ) : ℝ) ≤ Y := by
    intro idx
    have hdvd : p idx - 1 ∣ N.totient := by
      rw [hR.equation]
      exact Dvd.dvd.mul_left (Finset.dvd_prod_of_mem _ (Finset.mem_univ idx)) d
    exact le_trans (Nat.cast_le.mpr (Nat.le_of_dvd hphipos hdvd)) hR.size
  have hpsize : ∀ idx, (p idx : ℝ) ≤ 1 * Real.exp (Real.exp (logLog Y)) * logLog Y := by
    intro idx
    rw [hYY, one_mul]
    have hi := hshift idx
    rw [Nat.cast_sub (show 1 ≤ p idx by have := hR.prime_min idx; omega), Nat.cast_one] at hi
    have hm := mul_le_mul_of_nonneg_left hT2 hYpos.le
    nlinarith
  have B := hpdata L p hR.normal_left hR.prime_min hpsize hR.order.antitone hR.gaps
    (by simpa only [hYY] using hR.lower_upper) hR.last_upper (by simpa only [hYY] using hR.top)
    (by simpa only [hYY] using hshift 0)
  have m := hmargin L hL
  obtain ⟨J, hJL, ha, hm⟩ := rph_matched_prefix_of_boxes
    (x := fun idx => CollisionBox.primeCoordinate (logLog Y) (p idx)) hY (by linarith)
    hR.witness_pos hQ B m he₀ hR.normal_left hR.prime_min hd hdS hR.equation hR.size
  obtain ⟨r, hr⟩ := rph_record_of_matched hQ J ha hm hJL hR.witness_pos hR.normal_left
    hR.order.injective hR.prime_min hR.order.antitone hR.equation hR.size hsqPhi hR.top
    (htopsize N (p 0) hR.witness_pos hR.size hR.top) hR.largest_ne hR.facet
  exact ⟨r, hr.trans hR.integer⟩

theorem retained_class_state_family {a l d M k : ℕ} {Y : ℝ} {v W : ℕ → ℝ}
    (C : Finset (Fin a)) (F : Finset ℕ)
    (p q : ℕ → Fin a → ℕ) (t : ℕ → Fin l → ℕ) (e : ℕ → ℕ)
    (hkdef : (CollisionClass.remaining C).card = k)
    (hk : 1 ≤ k)
    (hzero : ∀ j : Fin a, j.val = 0 → j ∉ C)
    (hSv : normalityScale (logLog Y) ≤ v k)
    (hF : ∀ n ∈ F, CollisionClass.Conditions C d M n (normalityScale (logLog Y)) Y v W
      (p n) (q n) (t n) (e n)) :
    ∃ G : Finset ((Fin (k + l) → ℕ) × (Fin (k + 1) → ℕ)),
      G.card = F.card ∧
      ∀ s ∈ G,
        ((∀ a : Fin (k + l), 0 < s.1 a) ∧ (∀ b : Fin (k + 1), 0 < s.2 b)) ∧
        d * (∏ a, s.1 a) = (∏ b, s.2 b) ∧
