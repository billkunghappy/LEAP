          rw [Finset.mul_sum, Finset.mul_sum]
          apply Finset.sum_le_sum
          intro j hj
          rw [Finset.mem_Ico] at hj
          have hqj := ih j hj.1 (by omega)
          have h := hrat (N - j) N (by omega)
          rw [show N - j + 1 = N + 1 - j by omega] at h
          nlinarith
        have hi0 := hrat 0 N (Nat.zero_le _)
        rw [hd0, mul_one, zero_add] at hi0
        have hdN := hdpos N
        have hkey : 0 ≤ d N * q (N + 1) := by
          rw [hrN1]
          have e : ∑ j ∈ Finset.Ico 1 N, q j * d (N - j) = d N - q N := by linarith
          rw [e] at hsum
          nlinarith [mul_nonneg hqN (sub_nonneg.mpr hi0)]
        by_contra hneg
        push_neg at hneg
        nlinarith [mul_pos hdN (neg_pos.mpr hneg)]
    intro n hn
    refine ⟨hP n n hn le_rfl, ?_⟩
    rw [hrec n hn]
    have : 0 ≤ ∑ j ∈ Finset.Ico 1 n, q j * d (n - j) := by
      apply Finset.sum_nonneg
      intro j hj
      rw [Finset.mem_Ico] at hj
      exact mul_nonneg (hP n j hj.1 (by omega)) (hdpos _).le
    linarith
  
  have renewal_convolution_identities : ∀ (ρ : ℝ) (c g β τ d q : ℕ → ℝ), ρ ≠ 0 → c 0 = 0 → g 0 = 1 → (∀ n : ℕ, g (n + 1) = ∑ i ∈ Finset.range (n + 1), c (i + 1) * g (n - i)) → β 0 = 1 → (∀ k : ℕ, β (k + 1) = β k / ρ - c (k + 1)) → (∀ j : ℕ, τ j = if j = 0 then 1 else g j - g (j - 1) / ρ) → (∀ k : ℕ, d k = if k = 0 then 1 else β k - β (k - 1)) → (∀ n : ℕ, q n = -∑ j ∈ Finset.range (n + 1), τ j) → (∀ n : ℕ, ∑ k ∈ Finset.range (n + 1), β k * τ (n - k) = if n = 0 then 1 else 0) ∧ (∀ n : ℕ, 1 ≤ n → q n = d n - ∑ j ∈ Finset.Ico 1 n, q j * d (n - j)) := by
