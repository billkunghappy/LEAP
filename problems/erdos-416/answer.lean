    have h2 : (⌈10 * Real.log ℓ⌉₊ : ℝ) < 10 * Real.log ℓ + 1 := Nat.ceil_lt_add_one (by linarith)
    refine ⟨⌈10 * Real.log ℓ⌉₊, ?_, ?_⟩
    · rw [← Real.log_le_log_iff hℓ0 (by positivity), Real.log_pow]
