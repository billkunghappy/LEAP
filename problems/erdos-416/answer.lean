        have := Finset.sum_le_card_nsmul ((F.filter (fun m : ℕ => (m : ℝ) ≤ u * 2 ^ (n + 1))).filter
          (fun m : ℕ => ¬ (m : ℝ) ≤ u * 2 ^ n)) (fun m : ℕ => (1 : ℝ) / m) (1 / (u * 2 ^ n)) (by
            intro m hm
