          (((∑ x ∈ P.filter (fun x => x ≤ p), a x) + (r : ℝ) * ε) ^ r / (r.factorial : ℝ)) := by
        rw [← Finset.sum_fiberwise_of_maps_to (g := fun q : Fin (r + 1) → ℕ => q 0) (t := P)
          (fun q hq => (hQ q hq).2 0)]
        apply Finset.sum_le_sum
        intro p hp
        have hfib : ∑ q ∈ Q.filter (fun q => q 0 = p), ∏ i, a (q i) =
            a p * ∑ q' ∈ (Q.filter (fun q => q 0 = p)).image Fin.tail, ∏ i, a (q' i) := by
          rw [Finset.sum_image, Finset.mul_sum]
          · apply Finset.sum_congr rfl
            intro q hq
            rw [Fin.prod_univ_succ, (Finset.mem_filter.mp hq).2]
            rfl
          · intro q₁ hq₁ q₂ hq₂ h
            have h1 := (Finset.mem_filter.mp (Finset.mem_coe.mp hq₁)).2
            have h2 := (Finset.mem_filter.mp (Finset.mem_coe.mp hq₂)).2
            funext i
            refine Fin.cases ?_ ?_ i
            · rw [h1, h2]
            · intro j
              exact congrFun h j
        refine le_trans (le_of_eq hfib) ?_
        apply mul_le_mul_of_nonneg_left _ (hP p hp).1
        apply ih (P.filter (fun x => x ≤ p)) (fun x hx => hP x (Finset.mem_filter.mp hx).1)
        intro q' hq'
        obtain ⟨q, hq, rfl⟩ := Finset.mem_image.mp hq'
        obtain ⟨hqQ, hq0⟩ := Finset.mem_filter.mp hq
        refine ⟨(hQ q hqQ).1.comp_monotone Fin.strictMono_succ.monotone, fun i => ?_⟩
        refine Finset.mem_filter.mpr ⟨(hQ q hqQ).2 i.succ, ?_⟩
        rw [← hq0]
        exact (hQ q hqQ).1 (Fin.zero_le _)
      set X := ∑ p ∈ P, a p * ((∑ x ∈ P.filter (fun x => x ≤ p), a x) + (r : ℝ) * ε) ^ r
        with hXdef
      have hX : ∑ p ∈ P, a p *
          (((∑ x ∈ P.filter (fun x => x ≤ p), a x) + (r : ℝ) * ε) ^ r / (r.factorial : ℝ)) =
          X / (r.factorial : ℝ) := by
        rw [hXdef, Finset.sum_div]
        apply Finset.sum_congr rfl
        intro p _
        ring
      have h3 := hs3 r P hP
      have hfpos : (0 : ℝ) < (r.factorial : ℝ) := by exact_mod_cast Nat.factorial_pos r
      have hf : (((r + 1).factorial : ℕ) : ℝ) = ((r : ℝ) + 1) * (r.factorial : ℝ) := by
        rw [Nat.factorial_succ]
        push_cast
        ring
      rw [hf]
      push_cast
      calc (∑ q ∈ Q, ∏ i, a (q i)) ≤ _ := step1
        _ = X / (r.factorial : ℝ) := hX
        _ ≤ _ := by
          rw [div_le_div_iff₀ hfpos (by positivity)]
          have := mul_le_mul_of_nonneg_right h3 hfpos.le
          nlinarith [this]
  exact main r P ha Q hQ

theorem tuple_bound_numeric (s ε : ℝ) (hs : 0 ≤ s) (hε : 0 ≤ ε) (r : ℕ) :
    (ε ≤ 1 / 6 → (s + (r : ℝ) * ε) ^ r / (r.factorial : ℝ) ≤ Real.exp (2 * s) + 1) ∧
      (s ≤ 6 / 5 → ε ≤ 1 / 100 →
        (s + (r : ℝ) * ε) ^ r / (r.factorial : ℝ) ≤ max 1 (s + ε)) :=
by
  have hx : 0 ≤ s + (r : ℝ) * ε := by positivity
  have hF : (0 : ℝ) < (r.factorial : ℝ) := by exact_mod_cast Nat.factorial_pos r
  have hl2 := Real.log_two_gt_d9
  have key : ∀ lam : ℝ, 0 ≤ lam → lam ^ r * ((s + (r : ℝ) * ε) ^ r / (r.factorial : ℝ)) ≤
      Real.exp (lam * (s + (r : ℝ) * ε)) := by
    intro lam hlam
    have h := Real.pow_div_factorial_le_exp (lam * (s + (r : ℝ) * ε)) (by positivity) r
    rwa [mul_pow, mul_div_assoc] at h
  constructor
  · intro hε6
    have h := key 2 (by norm_num)
    have he : Real.exp (2 * (s + (r : ℝ) * ε)) = Real.exp (2 * s) * Real.exp (2 * ε) ^ r := by
      rw [← Real.exp_nat_mul, ← Real.exp_add]; ring_nf
    have h2 : Real.exp (2 * ε) ≤ 2 := by
      calc Real.exp (2 * ε) ≤ Real.exp (Real.log 2) := Real.exp_le_exp.mpr (by linarith)
        _ = 2 := Real.exp_log (by norm_num)
    have h2r : Real.exp (2 * ε) ^ r ≤ 2 ^ r := pow_le_pow_left₀ (Real.exp_pos _).le h2 r
    have hpos : (0:ℝ) < 2 ^ r := by positivity
    have hmul : (2:ℝ) ^ r * ((s + (r : ℝ) * ε) ^ r / (r.factorial : ℝ)) ≤
        2 ^ r * Real.exp (2 * s) := by
      rw [he] at h
      calc _ ≤ _ := h
        _ ≤ Real.exp (2 * s) * 2 ^ r := mul_le_mul_of_nonneg_left h2r (Real.exp_pos _).le
        _ = _ := by ring
    have := le_of_mul_le_mul_left hmul hpos
    linarith [Real.exp_pos (2 * s)]
  · intro hs6 hε1
    rcases Nat.lt_or_ge r 4 with hr | hr
    · interval_cases r
      · simp
      · have : (s + ((1 : ℕ) : ℝ) * ε) ^ 1 / ((Nat.factorial 1 : ℕ) : ℝ) = s + ε := by
          norm_num [Nat.factorial]
        rw [this]; exact le_max_right _ _
      · refine le_trans ?_ (le_max_left _ _)
        rw [div_le_one hF]
        norm_num [Nat.factorial]
        nlinarith
      · refine le_trans ?_ (le_max_left _ _)
        rw [div_le_one hF]
        norm_num [Nat.factorial]
        have h0 : 0 ≤ s + 3 * ε := by positivity
        have h1 : s + 3 * ε ≤ 123 / 100 := by linarith
        have h3 : (s + 3 * ε) ^ 3 ≤ (123 / 100 : ℝ) ^ 3 := pow_le_pow_left₀ h0 h1 3
        norm_num at h3
        linarith
    · refine le_trans ?_ (le_max_left _ _)
      have h := key 4 (by norm_num)
      have hrR : (4 : ℝ) ≤ (r : ℝ) := by exact_mod_cast hr
      have hr0 : (0 : ℝ) ≤ (r : ℝ) := Nat.cast_nonneg r
      have hA : (r : ℝ) * ε ≤ (r : ℝ) * (1 / 100) := mul_le_mul_of_nonneg_left hε1 hr0
      have hB : (r : ℝ) * 0.6931471803 ≤ (r : ℝ) * Real.log 2 :=
        mul_le_mul_of_nonneg_left hl2.le hr0
      have hlin : 4 * (s + (r : ℝ) * ε) ≤ (r : ℝ) * (2 * Real.log 2) := by
        norm_num at hB
        nlinarith
      have hexp : Real.exp (4 * (s + (r : ℝ) * ε)) ≤ 4 ^ r := by
        calc Real.exp (4 * (s + (r : ℝ) * ε)) ≤ Real.exp ((r : ℝ) * (2 * Real.log 2)) :=
              Real.exp_le_exp.mpr hlin
          _ = Real.exp (2 * Real.log 2) ^ r := Real.exp_nat_mul _ _
          _ = 4 ^ r := by
            rw [show (2:ℝ) * Real.log 2 = Real.log 2 + Real.log 2 by ring, Real.exp_add,
              Real.exp_log (by norm_num)]
            norm_num
      have hpos : (0:ℝ) < 4 ^ r := by positivity
      have hmul : (4:ℝ) ^ r * ((s + (r : ℝ) * ε) ^ r / (r.factorial : ℝ)) ≤ 4 ^ r * 1 := by
        rw [mul_one]; exact h.trans hexp
      exact le_of_mul_le_mul_left hmul hpos

