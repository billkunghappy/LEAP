        intro p hp
        apply one_div_le_one_div_of_le
        · exact_mod_cast Nat.mul_pos hk (hjpos p hp)
        · exact_mod_cast ((Nat.le_add_right (k * j p) 1).trans_eq (hj p hp).symm)
