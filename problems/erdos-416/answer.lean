          w.totient = n.totient ∧ ¬ n ∣ w ∧ largestPrimeFactor w ≠ largestPrimeFactor n ∧
          (∀ q : ℕ, q.Prime → q ∣ n → SNormal (normalityScale (logLog Y)) q) ∧
          (∀ q : ℕ, q.Prime → q ∣ w → SNormal (normalityScale (logLog Y)) q) ∧
          NoLargePrimeSquare w (Real.log Y ^ 4) ∧
          NoLargePrimeSquare w.totient (Real.log Y ^ 4)) →
        Y ^ (9 / 10 : ℝ) < (p 0 : ℝ) →
