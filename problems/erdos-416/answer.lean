      rw [h4.2.2.2.2 p hp.1 hp.2 x]
      linarith [hx.2]
  
  have hcover := ford_unordered_cover L hL
  have hVnn : 0 ≤ MeasureTheory.volume.real (FordOrder.unordered L) := MeasureTheory.measureReal_nonneg
  have h45 : (4 / 5 : ℝ) ^ (L - 2) ≤ (4 / 5 : ℝ) ^ 14 :=
    pow_le_pow_of_le_one (by norm_num) (by norm_num) (by omega)
  have h45' : (4 / 5 : ℝ) ^ 14 < 1 / 22 := by norm_num
  have e1 : (4 / 5 : ℝ) ^ (L - 2) * MeasureTheory.volume.real (FordOrder.unordered L) ≤
