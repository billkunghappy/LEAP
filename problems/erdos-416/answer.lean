      have hc : ContinuousAt (fun σ : ℝ => ((x ^ (1 - σ) : ℝ) : ℂ)) 1 := by
        refine Complex.continuous_ofReal.continuousAt.comp ?_
        exact (Real.continuousAt_const_rpow hx0.ne').comp (continuousAt_const.sub continuousAt_id)
      have := hc.tendsto.mono_left (nhdsWithin_le_nhds (s := Set.Ioi (1 : ℝ)))
      simpa using this
    have h2π : (2 * Real.pi) ≠ 0 := by positivity
    have hρi : MeasureTheory.Integrable (fun u : ℝ => (1 + (u / (2 * Real.pi)) ^ 2)⁻¹) :=
      integrable_inv_one_add_sq.comp_div h2π
    have hint : Tendsto (fun σ : ℝ =>
        ∫ u in Set.Ici (-Real.log x), ((Real.exp (-u * (σ - 1)) : ℝ) : ℂ) *
          Φ (u / (2 * Real.pi)))
        (nhdsWithin 1 (Set.Ioi 1))
        (nhds (∫ u in Set.Ici (-Real.log x), Φ (u / (2 * Real.pi)))) := by
      refine MeasureTheory.tendsto_integral_filter_of_dominated_convergence
        (fun u => x * (M * (1 + (u / (2 * Real.pi)) ^ 2)⁻¹)) ?_ ?_ ?_ ?_
      · exact Eventually.of_forall fun σ => (Continuous.aestronglyMeasurable (by fun_prop))
      · filter_upwards [Ioo_mem_nhdsGT (by norm_num : (1 : ℝ) < 2)] with σ hσ
        rw [MeasureTheory.ae_restrict_iff' measurableSet_Ici]
        refine MeasureTheory.ae_of_all _ fun u hu => ?_
        have hu' : -Real.log x ≤ u := hu
        have hlog : 0 ≤ Real.log x := Real.log_nonneg hx
        have hexp : Real.exp (-u * (σ - 1)) ≤ x := by
          calc Real.exp (-u * (σ - 1)) ≤ Real.exp (Real.log x) := by
                apply Real.exp_le_exp.mpr
                nlinarith [hσ.1, hσ.2]
            _ = x := Real.exp_log hx0
        rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos (Real.exp_pos _)]
        exact mul_le_mul hexp (hΦ _) (norm_nonneg _) hx0.le
      · exact (hρi.const_mul M).const_mul x |>.integrableOn
      · refine MeasureTheory.ae_of_all _ fun u => ?_
        have hc : ContinuousAt (fun σ : ℝ => ((Real.exp (-u * (σ - 1)) : ℝ) : ℂ) *
            Φ (u / (2 * Real.pi))) 1 := by fun_prop
        have := hc.tendsto.mono_left (nhdsWithin_le_nhds (s := Set.Ioi (1 : ℝ)))
        simpa using this
    have hall := hser.sub ((hpow.const_mul (A : ℂ)).mul hint)
    simpa using hall
  
  have hcomp : ∀ ψ : ℝ → ℂ, ContDiff ℝ 2 ψ → HasCompactSupport ψ → MeasureTheory.Integrable ψ →
      MeasureTheory.Integrable (deriv ψ) → MeasureTheory.Integrable (iteratedDeriv 2 ψ) →
      Filter.Tendsto (fun x : ℝ =>
        (∑' n : ℕ, (f n : ℂ) / (n : ℂ) *
            FourierTransform.fourier ψ (1 / (2 * Real.pi) * Real.log ((n : ℝ) / x))) -
          (A : ℂ) * ∫ u in Set.Ici (-Real.log x),
            FourierTransform.fourier ψ (u / (2 * Real.pi)))
        Filter.atTop (nhds 0) := by
    intro ψ hψ hψs hψi hψd hψdd
    obtain ⟨hFc, hFd⟩ := fourier_W21_decay ψ hψ hψi hψd hψdd
    have heq : ∀ x : ℝ, 1 ≤ x →
        (∑' n : ℕ, (f n : ℂ) / (n : ℂ) *
            FourierTransform.fourier ψ (1 / (2 * Real.pi) * Real.log ((n : ℝ) / x))) -
          (A : ℂ) * ∫ u in Set.Ici (-Real.log x),
            FourierTransform.fourier ψ (u / (2 * Real.pi)) =
        ∫ t : ℝ, G (1 + (t : ℂ) * Complex.I) * ψ t * (x : ℂ) ^ ((t : ℂ) * Complex.I) := by
      intro x hx
      have hL := sigma_limit_left x _ hx (FourierTransform.fourier ψ) hFc hFd (hK x hx).1
      have hR := sigma_limit_right ψ hψ.continuous hψs x (by linarith)
      exact tendsto_nhds_unique_of_eventuallyEq hL hR
        (eventually_nhdsWithin_of_forall fun σ hσ =>
          fourier_identity_sigma_gt_one f A G hf hG' ψ hψ.continuous hψi x (by linarith) σ hσ)
    have hRL := riemann_lebesgue_cpow (fun t : ℝ => G (1 + (t : ℂ) * Complex.I) * ψ t)
    refine hRL.congr' ?_
    filter_upwards [eventually_ge_atTop (1 : ℝ)] with x hx
    exact (heq x hx).symm
  
  rw [Metric.tendsto_nhds]
  intro ε hε
  obtain ⟨⟨hgc, hgi, hgd, hgdd⟩, htrunc⟩ := schwartz_W21_truncation g
  have hε' : 0 < ε / (2 * (K + |A| * (2 * Real.pi ^ 2) + 1)) := by positivity
  obtain ⟨ψ, hψ, hψs, hψi, hψd, hψdd, hD⟩ := htrunc _ hε'
  obtain ⟨hFgc, hFgd⟩ := fourier_W21_decay (g : ℝ → ℂ) hgc hgi hgd hgdd
  obtain ⟨hFψc, hFψd⟩ := fourier_W21_decay ψ hψ hψi hψd hψdd
  have hdiff := fourier_W21_diff_decay (g : ℝ → ℂ) ψ hgc hgi hgd hgdd hψ hψi hψd hψdd
  have hD0 : 0 ≤ (∫ t, ‖(g : ℝ → ℂ) t - ψ t‖) +
      (4 * Real.pi ^ 2)⁻¹ * ∫ t, ‖iteratedDeriv 2 (g : ℝ → ℂ) t - iteratedDeriv 2 ψ t‖ :=
    add_nonneg (MeasureTheory.integral_nonneg fun _ => norm_nonneg _)
      (mul_nonneg (by positivity) (MeasureTheory.integral_nonneg fun _ => norm_nonneg _))
  have hεeq : ε / (2 * (K + |A| * (2 * Real.pi ^ 2) + 1)) * (K + |A| * (2 * Real.pi ^ 2)) +
      ε / (2 * (K + |A| * (2 * Real.pi ^ 2) + 1)) = ε / 2 := by
    field_simp
  have hA2 := Metric.tendsto_nhds.mp (hcomp ψ hψ hψs hψi hψd hψdd) (ε / 2) (half_pos hε)
  filter_upwards [hA2, eventually_ge_atTop (1 : ℝ)] with x hx1 hx
  have hb := decay_functional_diff_bound x K _ _ _ (FourierTransform.fourier (g : ℝ → ℂ))
    (FourierTransform.fourier ψ) hFgc hFψc hFgd hFψd hdiff (hK x hx).1 (hK x hx).2
  rw [dist_zero_right] at hx1 ⊢
  have hDM := mul_le_mul_of_nonneg_right hD.le hM0
  set Tg := (∑' n : ℕ, (f n : ℂ) / (n : ℂ) *
          FourierTransform.fourier (g : ℝ → ℂ) (1 / (2 * Real.pi) * Real.log ((n : ℝ) / x))) -
        (A : ℂ) * ∫ u in Set.Ici (-Real.log x),
          FourierTransform.fourier (g : ℝ → ℂ) (u / (2 * Real.pi)) with hTg
  set Tψ := (∑' n : ℕ, (f n : ℂ) / (n : ℂ) *
          FourierTransform.fourier ψ (1 / (2 * Real.pi) * Real.log ((n : ℝ) / x))) -
        (A : ℂ) * ∫ u in Set.Ici (-Real.log x),
          FourierTransform.fourier ψ (u / (2 * Real.pi)) with hTψ
  have htri : ‖Tg‖ ≤ ‖Tg - Tψ‖ + ‖Tψ‖ := by
    have := norm_add_le (Tg - Tψ) Tψ
    rwa [sub_add_cancel] at this
  linarith

theorem smooth_limit_of_schwartz_limit (f : ℕ → ℝ) (A : ℝ)
    (hS : ∀ g : SchwartzMap ℝ ℂ, Filter.Tendsto (fun x : ℝ =>
      (∑' n : ℕ, (f n : ℂ) / (n : ℂ) *
          FourierTransform.fourier (g : ℝ → ℂ) (1 / (2 * Real.pi) * Real.log ((n : ℝ) / x))) -
        (A : ℂ) * ∫ u in Set.Ici (-Real.log x),
          FourierTransform.fourier (g : ℝ → ℂ) (u / (2 * Real.pi)))
      Filter.atTop (nhds 0))
    (Ψ : ℝ → ℝ) (hsmooth : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) Ψ) (hsupp : HasCompactSupport Ψ)
    (hplus : tsupport Ψ ⊆ Set.Ioi 0) :
    Filter.Tendsto (fun x : ℝ => (∑' n : ℕ, f n * Ψ (n / x)) / x) Filter.atTop
      (nhds (A * ∫ y in Set.Ioi 0, Ψ y)) :=
by
  have h0notin : (0 : ℝ) ∉ tsupport Ψ := fun h => lt_irrefl (0 : ℝ) (hplus h)
  have hΨ0 : Ψ 0 = 0 := image_eq_zero_of_notMem_tsupport h0notin
  have hcont : Continuous Ψ := hsmooth.continuous
  have h2pi : (2 * Real.pi) ≠ 0 := Real.two_pi_pos.ne'
  
  have hce : HasCompactSupport (fun u : ℝ => Ψ (Real.exp u)) := by
    have hK : IsCompact (tsupport Ψ) := hsupp
    have hK' : IsCompact (Real.log '' tsupport Ψ) :=
      hK.image_of_continuousOn (Real.continuousOn_log.mono (fun y hy => by
        have : 0 < y := hplus hy
        simpa using this.ne'))
    refine HasCompactSupport.intro hK' ?_
    intro u hu
    apply image_eq_zero_of_notMem_tsupport
    intro hmem
    exact hu ⟨Real.exp u, hmem, Real.log_exp u⟩
  
  set ph : ℝ → ℝ := fun w => Real.exp (2 * Real.pi * w) * Ψ (Real.exp (2 * Real.pi * w)) with hph
  have he : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) (fun w : ℝ => Real.exp (2 * Real.pi * w)) :=
    (contDiff_const.mul contDiff_id).exp
  have hphs : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) ph := he.mul (hsmooth.comp he)
  have hphc : HasCompactSupport ph := by
    have h1 : HasCompactSupport (fun w : ℝ => Ψ (Real.exp ((2 * Real.pi) • w))) :=
      hce.comp_smul h2pi
    simp only [smul_eq_mul] at h1
    exact h1.mul_left
  let h : ℝ → ℂ := fun w => ((ph w : ℝ) : ℂ)
  have hhs : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) h := Complex.ofRealCLM.contDiff.comp hphs
  have hhc : HasCompactSupport h := hphc.comp_left (g := Complex.ofReal) (by simp)
  let H : SchwartzMap ℝ ℂ := hhc.toSchwartzMap hhs
  let g : SchwartzMap ℝ ℂ := FourierTransformInv.fourierInv H
  have hg : ∀ w, FourierTransform.fourier (g : ℝ → ℂ) w = ((ph w : ℝ) : ℂ) := by
    intro w
    have h1 : FourierTransform.fourier g = H := FourierTransform.fourier_fourierInv_eq H
    rw [← SchwartzMap.fourier_coe, h1]
    exact HasCompactSupport.toSchwartzMap_toFun hhc hhs w
  
  have hs3 : ∀ x : ℝ, 0 < x → ∫ u in Set.Ici (-Real.log x), Real.exp u * Ψ (Real.exp u) =
      ∫ y in Set.Ioi x⁻¹, Ψ y := by
    intro x hx
    rw [MeasureTheory.integral_Ici_eq_integral_Ioi]
    have l1 : ContinuousOn Real.exp (Set.Ici (-Real.log x)) := Real.continuous_exp.continuousOn
    have l3 : ∀ t ∈ Set.Ioi (-Real.log x),
        HasDerivWithinAt Real.exp (Real.exp t) (Set.Ioi t) t :=
      fun t _ => (Real.hasDerivAt_exp t).hasDerivWithinAt
    have l4 : ContinuousOn Ψ (Real.exp '' Set.Ioi (-Real.log x)) := hcont.continuousOn
    have l5 : MeasureTheory.IntegrableOn Ψ (Real.exp '' Set.Ici (-Real.log x)) :=
      (hcont.integrable_of_hasCompactSupport hsupp).integrableOn
    have l6 : MeasureTheory.IntegrableOn (fun u => Real.exp u • (Ψ ∘ Real.exp) u)
        (Set.Ici (-Real.log x)) := by
      refine (Continuous.integrable_of_hasCompactSupport ?_ ?_).integrableOn
      · exact Real.continuous_exp.smul (hcont.comp Real.continuous_exp)
      · change HasCompactSupport (fun u => Real.exp u * Ψ (Real.exp u))
        exact hce.mul_left (f := Real.exp)
    have := MeasureTheory.integral_comp_smul_deriv_Ioi l1 Real.tendsto_exp_atTop l3 l4 l5 l6
    simpa [Real.exp_neg, Real.exp_log hx] using this
  
  have hI : ∀ᶠ x : ℝ in atTop, ∫ y in Set.Ioi x⁻¹, Ψ y = ∫ y in Set.Ioi 0, Ψ y := by
    have h0 : Ψ =ᶠ[𝓝 0] 0 := notMem_tsupport_iff_eventuallyEq.mp h0notin
    obtain ⟨ε, hε, hball⟩ := Metric.eventually_nhds_iff.mp h0
    filter_upwards [eventually_gt_atTop ε⁻¹] with x hx
    have hεinv : 0 < ε⁻¹ := inv_pos.mpr hε
    have hx0 : 0 < x := hεinv.trans hx
    have hxinv : x⁻¹ < ε := by rw [inv_lt_comm₀ hx0 hε]; exact hx
    symm
    apply MeasureTheory.setIntegral_eq_of_subset_of_forall_diff_eq_zero measurableSet_Ioi
    · exact Set.Ioi_subset_Ioi (inv_pos.mpr hx0).le
    · intro y hy
      obtain ⟨hy1, hy2⟩ := hy
      simp only [Set.mem_Ioi, not_lt] at hy1 hy2
      apply hball
      rw [Real.dist_eq, sub_zero, abs_of_pos hy1]
      linarith
  
  have hterm : ∀ x : ℝ, 0 < x → ∀ n : ℕ,
      (f n : ℂ) / (n : ℂ) *
          FourierTransform.fourier (g : ℝ → ℂ) (1 / (2 * Real.pi) * Real.log ((n : ℝ) / x)) =
        ((f n * Ψ (n / x) / x : ℝ) : ℂ) := by
    intro x hx n
    rw [hg]
    have hlog : 2 * Real.pi * (1 / (2 * Real.pi) * Real.log ((n : ℝ) / x)) =
        Real.log ((n : ℝ) / x) := by
      field_simp
    simp only [hph, hlog]
    rcases Nat.eq_zero_or_pos n with hn | hn
    · subst hn
      simp [hΨ0]
    · have hnx : 0 < (n : ℝ) / x := by positivity
      rw [Real.exp_log hnx]
      have hn' : (n : ℂ) ≠ 0 := by exact_mod_cast hn.ne'
      have hx' : (x : ℂ) ≠ 0 := by exact_mod_cast hx.ne'
      push_cast
      field_simp
  have hseries : ∀ x : ℝ, 0 < x →
      (∑' n : ℕ, (f n : ℂ) / (n : ℂ) *
          FourierTransform.fourier (g : ℝ → ℂ) (1 / (2 * Real.pi) * Real.log ((n : ℝ) / x))) =
        (((∑' n : ℕ, f n * Ψ (n / x)) / x : ℝ) : ℂ) := by
    intro x hx
    rw [tsum_congr (hterm x hx), ← Complex.ofReal_tsum, tsum_div_const]
  have hintegral : ∀ x : ℝ, 0 < x →
      (∫ u in Set.Ici (-Real.log x), FourierTransform.fourier (g : ℝ → ℂ) (u / (2 * Real.pi))) =
        ((∫ y in Set.Ioi x⁻¹, Ψ y : ℝ) : ℂ) := by
    intro x hx
    have hpt : ∀ u : ℝ, FourierTransform.fourier (g : ℝ → ℂ) (u / (2 * Real.pi)) =
        ((Real.exp u * Ψ (Real.exp u) : ℝ) : ℂ) := by
      intro u
      rw [hg]
      have : 2 * Real.pi * (u / (2 * Real.pi)) = u := by field_simp
      simp only [hph, this]
    simp_rw [hpt]
    rw [← hs3 x hx]
    exact integral_complex_ofReal
  
  have hC : Filter.Tendsto (fun x : ℝ =>
      ((((∑' n : ℕ, f n * Ψ (n / x)) / x) - A * ∫ y in Set.Ioi 0, Ψ y : ℝ) : ℂ))
      Filter.atTop (nhds 0) := by
    refine (hS g).congr' ?_
    filter_upwards [eventually_gt_atTop 0, hI] with x hx hIx
    rw [hseries x hx, hintegral x hx, hIx]
    push_cast
    ring
  have hR := (Complex.continuous_re.tendsto 0).comp hC
  simp only [Function.comp_def, Complex.ofReal_re, Complex.zero_re] at hR
  exact tendsto_sub_nhds_zero_iff.mp hR

theorem cumsum_limit_of_smooth_limits (f : ℕ → ℝ) (A : ℝ) (hpos : ∀ n, 0 ≤ f n)
    (hcheby : ∃ C : ℝ, ∀ N : ℕ, ∑ n ∈ Finset.range N, |f n| ≤ C * N)
    (hsmooth : ∀ Ψ : ℝ → ℝ, ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) Ψ → HasCompactSupport Ψ →
      tsupport Ψ ⊆ Set.Ioi 0 →
      Filter.Tendsto (fun x : ℝ => (∑' n : ℕ, f n * Ψ (n / x)) / x) Filter.atTop
        (nhds (A * ∫ y in Set.Ioi 0, Ψ y))) :
    Filter.Tendsto (fun N : ℕ => (∑ n ∈ Finset.range N, f n) / (N : ℝ)) Filter.atTop (nhds A) :=
by
  
  have s1 : ∀ (a b δ : ℝ), a < b → 0 < δ →
      ∃ Ψ : ℝ → ℝ, ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) Ψ ∧ HasCompactSupport Ψ ∧ Continuous Ψ ∧
        (∀ y, 0 ≤ Ψ y) ∧ (∀ y, Ψ y ≤ 1) ∧ (∀ y ∈ Set.Icc a b, Ψ y = 1) ∧
        (∀ y, Ψ y ≠ 0 → a - δ < y ∧ y < b + δ) ∧ tsupport Ψ ⊆ Set.Icc (a - δ) (b + δ) := by
    intro a b δ hab hδ
    let bmp : ContDiffBump ((a + b) / 2) :=
      ⟨(b - a) / 2, (b - a) / 2 + δ, by linarith, by linarith⟩
    have hrIn : bmp.rIn = (b - a) / 2 := rfl
    have hrOut : bmp.rOut = (b - a) / 2 + δ := rfl
    refine ⟨bmp, bmp.contDiff, bmp.hasCompactSupport, bmp.continuous, fun y => bmp.nonneg,
      fun y => bmp.le_one, ?_, ?_, ?_⟩
    · intro y hy
      apply bmp.one_of_mem_closedBall
      rw [Real.closedBall_eq_Icc, hrIn]
      constructor <;> linarith [hy.1, hy.2]
    · intro y hy
      have hmem : y ∈ Function.support bmp := hy
      rw [bmp.support_eq, Real.ball_eq_Ioo, hrOut] at hmem
      constructor <;> linarith [hmem.1, hmem.2]
    · rw [bmp.tsupport_eq, Real.closedBall_eq_Icc, hrOut]
      intro y hy
      constructor <;> linarith [hy.1, hy.2]
  
  have s2 : ∀ (Ψ : ℝ → ℝ) (a b δ : ℝ), Continuous Ψ → a ≤ b → 0 ≤ δ → 0 < a - δ →
      (∀ y, 0 ≤ Ψ y) → (∀ y, Ψ y ≤ 1) → (∀ y ∈ Set.Icc a b, Ψ y = 1) →
      (∀ y, Ψ y ≠ 0 → a - δ < y ∧ y < b + δ) →
      b - a ≤ ∫ y in Set.Ioi 0, Ψ y ∧ ∫ y in Set.Ioi 0, Ψ y ≤ b - a + 2 * δ := by
    intro Ψ a b δ hcont hab hδ hpos' h0 h1 hone hsupp
    have hJ : Set.Icc (a - δ) (b + δ) ⊆ Set.Ioi 0 := fun x hx => lt_of_lt_of_le hpos' hx.1
    have heq : ∫ y in Set.Ioi 0, Ψ y = ∫ y in Set.Icc (a - δ) (b + δ), Ψ y := by
      apply MeasureTheory.setIntegral_eq_of_subset_of_forall_diff_eq_zero measurableSet_Ioi hJ
      intro x hx
      by_contra hne
      have := hsupp x hne
      exact hx.2 ⟨this.1.le, this.2.le⟩
    have hint : MeasureTheory.IntegrableOn Ψ (Set.Icc (a - δ) (b + δ)) := hcont.integrableOn_Icc
    rw [heq]
    constructor
    · have h1' : ∫ y in Set.Icc a b, Ψ y = b - a := by
        rw [MeasureTheory.setIntegral_congr_fun measurableSet_Icc hone]
        simp [Real.volume_real_Icc_of_le hab]
      rw [← h1']
      apply MeasureTheory.setIntegral_mono_set hint
      · exact Filter.Eventually.of_forall h0
      · exact (Set.Icc_subset_Icc (by linarith) (by linarith)).eventuallyLE
    · calc ∫ y in Set.Icc (a - δ) (b + δ), Ψ y ≤ ∫ y in Set.Icc (a - δ) (b + δ), (1 : ℝ) :=
            MeasureTheory.setIntegral_mono_on hint continuous_const.integrableOn_Icc
              measurableSet_Icc (fun y _ => h1 y)
        _ = b - a + 2 * δ := by
            simp [Real.volume_real_Icc_of_le (by linarith : a - δ ≤ b + δ)]
            ring
  
  have s3 : ∀ (Ψ : ℝ → ℝ), (∀ y, 2 ≤ y → Ψ y = 0) → ∀ N : ℕ, 0 < N →
      ∑' n : ℕ, f n * Ψ ((n : ℝ) / (N : ℝ)) =
        ∑ n ∈ Finset.range (2 * N), f n * Ψ ((n : ℝ) / (N : ℝ)) := by
    intro Ψ hΨ N hN
    apply tsum_eq_sum
    intro n hn
    rw [Finset.mem_range, not_lt] at hn
    have hN' : (0 : ℝ) < N := by exact_mod_cast hN
    have h2 : (2 : ℝ) ≤ n / N := by
      rw [le_div_iff₀ hN']
      exact_mod_cast hn
    rw [hΨ _ h2, mul_zero]
  
  have s4 : ∀ (C : ℝ), (∀ N : ℕ, ∑ n ∈ Finset.range N, |f n| ≤ C * N) →
      ∀ (Ψ : ℝ → ℝ), (∀ y, 0 ≤ Ψ y) → ∀ ε : ℝ, 0 < ε → (∀ y, ε ≤ y → y ≤ 1 → Ψ y = 1) →
      ∀ N : ℕ, 0 < N →
      ∑ n ∈ Finset.range N, f n ≤
        C * (ε * N + 1) + ∑ n ∈ Finset.range (2 * N), f n * Ψ ((n : ℝ) / (N : ℝ)) := by
    intro C hC Ψ hΨ0 ε hε hΨ1 N hN
    have hN' : (0 : ℝ) < N := by exact_mod_cast hN
    have hC0 : 0 ≤ C := by
      have := hC 1
      simp at this
      linarith [abs_nonneg (f 0)]
    set K := ⌊ε * N⌋₊ + 1 with hK
    have hpt : ∀ n ∈ Finset.range N,
        f n ≤ (if n < K then f n else 0) + f n * Ψ ((n : ℝ) / (N : ℝ)) := by
      intro n hn
      rw [Finset.mem_range] at hn
      split_ifs with h
      · linarith [mul_nonneg (hpos n) (hΨ0 ((n : ℝ) / N))]
      · push_neg at h
        have h1 : ε * N < n := by
          have := Nat.lt_floor_add_one (ε * N)
          have h2 : ((⌊ε * N⌋₊ + 1 : ℕ) : ℝ) ≤ n := by exact_mod_cast h
          push_cast at h2
          linarith
        have h2 : ε ≤ (n : ℝ) / N := by rw [le_div_iff₀ hN']; linarith
        have h3 : (n : ℝ) / N ≤ 1 := by rw [div_le_one hN']; exact_mod_cast hn.le
        rw [hΨ1 _ h2 h3]
        simp
    have hsum1 : ∑ n ∈ Finset.range N, (if n < K then f n else 0) ≤ C * (ε * N + 1) := by
      calc ∑ n ∈ Finset.range N, (if n < K then f n else 0)
            ≤ ∑ n ∈ Finset.range K, f n := by
              rw [← Finset.sum_filter]
              apply Finset.sum_le_sum_of_subset_of_nonneg
              · intro n hn
                simp only [Finset.mem_filter, Finset.mem_range] at hn ⊢
                exact hn.2
              · intro n _ _
                exact hpos n
        _ = ∑ n ∈ Finset.range K, |f n| :=
              Finset.sum_congr rfl (fun n _ => (abs_of_nonneg (hpos n)).symm)
        _ ≤ C * K := hC K
        _ ≤ C * (ε * N + 1) := by
              apply mul_le_mul_of_nonneg_left _ hC0
              rw [hK]
              push_cast
              linarith [Nat.floor_le (by positivity : 0 ≤ ε * N)]
    have hsum2 : ∑ n ∈ Finset.range N, f n * Ψ ((n : ℝ) / (N : ℝ)) ≤
        ∑ n ∈ Finset.range (2 * N), f n * Ψ ((n : ℝ) / (N : ℝ)) := by
      apply Finset.sum_le_sum_of_subset_of_nonneg
      · intro n hn
        simp only [Finset.mem_range] at hn ⊢
        omega
      · intro n _ _
        exact mul_nonneg (hpos n) (hΨ0 _)
    calc ∑ n ∈ Finset.range N, f n
          ≤ ∑ n ∈ Finset.range N,
              ((if n < K then f n else 0) + f n * Ψ ((n : ℝ) / (N : ℝ))) := Finset.sum_le_sum hpt
      _ = ∑ n ∈ Finset.range N, (if n < K then f n else 0) +
            ∑ n ∈ Finset.range N, f n * Ψ ((n : ℝ) / (N : ℝ)) := Finset.sum_add_distrib
      _ ≤ _ := add_le_add hsum1 hsum2
  
  have s5 : ∀ (Ψ : ℝ → ℝ), (∀ y, Ψ y ≤ 1) → (∀ y, 1 ≤ y → Ψ y = 0) → ∀ N : ℕ, 0 < N →
      ∑ n ∈ Finset.range (2 * N), f n * Ψ ((n : ℝ) / (N : ℝ)) ≤ ∑ n ∈ Finset.range N, f n := by
    intro Ψ hΨ1 hΨz N hN
    have hN' : (0 : ℝ) < N := by exact_mod_cast hN
    rw [two_mul, Finset.sum_range_add]
    have hz : ∑ k ∈ Finset.range N, f (N + k) * Ψ (((N + k : ℕ) : ℝ) / (N : ℝ)) = 0 := by
      apply Finset.sum_eq_zero
      intro k _
      have h1 : (1 : ℝ) ≤ ((N + k : ℕ) : ℝ) / N := by
        rw [le_div_iff₀ hN']
        push_cast
        linarith [(Nat.cast_nonneg k : (0 : ℝ) ≤ k)]
      rw [hΨz _ h1, mul_zero]
    rw [hz, add_zero]
    apply Finset.sum_le_sum
    intro n _
    exact mul_le_of_le_one_right (hpos n) (hΨ1 _)
  
  have s6 : ∀ (a : ℕ → ℝ) (A K : ℝ), 0 ≤ K →
      (∀ ε : ℝ, 0 < ε → ε < 1 / 4 → ∃ (g u : ℕ → ℝ) (Lg Lu : ℝ),
        Filter.Tendsto g Filter.atTop (nhds Lg) ∧ Filter.Tendsto u Filter.atTop (nhds Lu) ∧
        |Lg - A| ≤ K * ε ∧ |Lu - A| ≤ K * ε ∧
        ∀ᶠ N in Filter.atTop, g N ≤ a N ∧ a N ≤ u N + K * ε) →
      Filter.Tendsto a Filter.atTop (nhds A) := by
    intro a A K hK h
    have hchoose : ∀ d : ℝ, 0 < d → ∃ ε : ℝ, 0 < ε ∧ ε < 1 / 4 ∧ K * ε < d / 2 := by
      intro d hd
      refine ⟨min (1 / 8) (d / (2 * (K + 1))), lt_min (by norm_num) (by positivity),
        lt_of_le_of_lt (min_le_left _ _) (by norm_num), ?_⟩
      have hle : min (1 / 8) (d / (2 * (K + 1))) ≤ d / (2 * (K + 1)) := min_le_right _ _
      have hK1 : K + 1 ≠ 0 := by linarith
      calc K * min (1 / 8) (d / (2 * (K + 1))) ≤ K * (d / (2 * (K + 1))) :=
            mul_le_mul_of_nonneg_left hle hK
        _ < (K + 1) * (d / (2 * (K + 1))) :=
            mul_lt_mul_of_pos_right (by linarith) (by positivity)
        _ = d / 2 := by field_simp
    rw [tendsto_order]
    constructor
    · intro a' ha'
      obtain ⟨ε, hε0, hε1, hKε⟩ := hchoose (A - a') (by linarith)
      obtain ⟨g, u, Lg, Lu, hg, hu, hLg, hLu, hev⟩ := h ε hε0 hε1
      have hLg' : a' < Lg := by
        have := (abs_le.1 hLg).1
        linarith
      filter_upwards [(tendsto_order.1 hg).1 a' hLg', hev] with N h1 h2
      linarith [h2.1]
    · intro b' hb'
      obtain ⟨ε, hε0, hε1, hKε⟩ := hchoose (b' - A) (by linarith)
      obtain ⟨g, u, Lg, Lu, hg, hu, hLg, hLu, hev⟩ := h ε hε0 hε1
      have hLu' : Lu < b' - K * ε := by
        have := (abs_le.1 hLu).2
        linarith
      filter_upwards [(tendsto_order.1 hu).2 (b' - K * ε) hLu', hev] with N h1 h2
      linarith [h2.2]
  
  obtain ⟨C, hC⟩ := hcheby
  have hC0 : 0 ≤ C := by
    have := hC 1
    simp at this
    linarith [abs_nonneg (f 0)]
  apply s6 _ A (2 * |A| + C) (by positivity)
  intro ε hε hε4
  obtain ⟨Ψp, hPs, hPc, hPcont, hP0, hP1, hPone, hPsupp, hPts⟩ :=
    s1 ε 1 (ε / 2) (by linarith) (by linarith)
  obtain ⟨Ψm, hMs, hMc, hMcont, hM0, hM1, hMone, hMsupp, hMts⟩ :=
    s1 (3 * ε / 2) (1 - ε / 2) (ε / 2) (by linarith) (by linarith)
  have hPt : tsupport Ψp ⊆ Set.Ioi 0 := by
    intro y hy
    have := hPts hy
    simp only [Set.mem_Icc] at this
    show 0 < y
    linarith [this.1]
  have hMt : tsupport Ψm ⊆ Set.Ioi 0 := by
    intro y hy
    have := hMts hy
    simp only [Set.mem_Icc] at this
    show 0 < y
    linarith [this.1]
  have hPz : ∀ y, 2 ≤ y → Ψp y = 0 := by
    intro y hy
    by_contra hne
    have := hPsupp y hne
    linarith [this.2]
  have hMz1 : ∀ y, 1 ≤ y → Ψm y = 0 := by
    intro y hy
    by_contra hne
    have := hMsupp y hne
    linarith [this.2]
  have hMz : ∀ y, 2 ≤ y → Ψm y = 0 := fun y hy => hMz1 y (by linarith)
  obtain ⟨hIP1, hIP2⟩ := s2 Ψp ε 1 (ε / 2) hPcont (by linarith) (by linarith) (by linarith)
    hP0 hP1 hPone hPsupp
  obtain ⟨hIM1, hIM2⟩ := s2 Ψm (3 * ε / 2) (1 - ε / 2) (ε / 2) hMcont (by linarith)
    (by linarith) (by linarith) hM0 hM1 hMone hMsupp
  have hlimP := (hsmooth Ψp hPs hPc hPt).comp tendsto_natCast_atTop_atTop
  have hlimM := (hsmooth Ψm hMs hMc hMt).comp tendsto_natCast_atTop_atTop
  have hAε : 0 ≤ |A| * ε := mul_nonneg (abs_nonneg A) hε.le
  have hCε : 0 ≤ C * ε := mul_nonneg hC0 hε.le
  refine ⟨fun N : ℕ => (∑' n : ℕ, f n * Ψm ((n : ℝ) / (N : ℝ))) / N,
    fun N : ℕ => C / N + (∑' n : ℕ, f n * Ψp ((n : ℝ) / (N : ℝ))) / N,
    A * ∫ y in Set.Ioi 0, Ψm y, 0 + A * ∫ y in Set.Ioi 0, Ψp y, hlimM,
    (tendsto_const_div_atTop_nhds_zero_nat C).add hlimP, ?_, ?_, ?_⟩
  · have hI : |(∫ y in Set.Ioi 0, Ψm y) - 1| ≤ 2 * ε := abs_le.2 ⟨by linarith, by linarith⟩
    rw [show A * (∫ y in Set.Ioi 0, Ψm y) - A = A * ((∫ y in Set.Ioi 0, Ψm y) - 1) by ring,
      abs_mul]
    calc |A| * |(∫ y in Set.Ioi 0, Ψm y) - 1| ≤ |A| * (2 * ε) :=
          mul_le_mul_of_nonneg_left hI (abs_nonneg A)
      _ ≤ (2 * |A| + C) * ε := by linarith
  · have hI : |(∫ y in Set.Ioi 0, Ψp y) - 1| ≤ 2 * ε := abs_le.2 ⟨by linarith, by linarith⟩
    rw [show 0 + A * (∫ y in Set.Ioi 0, Ψp y) - A = A * ((∫ y in Set.Ioi 0, Ψp y) - 1) by ring,
      abs_mul]
    calc |A| * |(∫ y in Set.Ioi 0, Ψp y) - 1| ≤ |A| * (2 * ε) :=
          mul_le_mul_of_nonneg_left hI (abs_nonneg A)
      _ ≤ (2 * |A| + C) * ε := by linarith
  · filter_upwards [Filter.eventually_gt_atTop 0] with N hN
    have hN' : (0 : ℝ) < N := by exact_mod_cast hN
    constructor
    · show (∑' n : ℕ, f n * Ψm ((n : ℝ) / (N : ℝ))) / N ≤ (∑ n ∈ Finset.range N, f n) / (N : ℝ)
      rw [s3 Ψm hMz N hN]
      exact div_le_div_of_nonneg_right (s5 Ψm hM1 hMz1 N hN) hN'.le
    · show (∑ n ∈ Finset.range N, f n) / (N : ℝ) ≤
        C / N + (∑' n : ℕ, f n * Ψp ((n : ℝ) / (N : ℝ))) / N + (2 * |A| + C) * ε
      have h := s4 C hC Ψp hP0 ε hε (fun y h1 h2 => hPone y ⟨h1, h2⟩) N hN
      rw [← s3 Ψp hPz N hN] at h
      have hdiv := div_le_div_of_nonneg_right h hN'.le
      have hid : (C * (ε * N + 1) + ∑' n : ℕ, f n * Ψp ((n : ℝ) / (N : ℝ))) / N =
          C * ε + (C / N + (∑' n : ℕ, f n * Ψp ((n : ℝ) / (N : ℝ))) / N) := by
        field_simp
        ring
      rw [hid] at hdiv
      linarith

theorem prime_counting_ratio : Tendsto (fun x : ℝ => (Nat.primeCounting ⌊x⌋₊ : ℝ) / (x / Real.log x)) atTop (𝓝 1) :=
by
  
  have hsum : ∀ σ : ℝ, 1 < σ →
      LSeriesSummable (fun n => ((ArithmeticFunction.vonMangoldt n : ℝ) : ℂ)) σ := by
    intro σ hσ
    exact ArithmeticFunction.LSeriesSummable_vonMangoldt (by simpa using hσ)
  have hcheb : ∃ C : ℝ, ∀ N : ℕ,
      ∑ n ∈ Finset.range N, |ArithmeticFunction.vonMangoldt n| ≤ C * N := by
    refine ⟨Real.log 4 + 4, fun N => ?_⟩
    have h0 : ∑ n ∈ Finset.range N, |ArithmeticFunction.vonMangoldt n| =
        ∑ n ∈ Finset.range N, ArithmeticFunction.vonMangoldt n :=
      Finset.sum_congr rfl (fun n _ => abs_of_nonneg ArithmeticFunction.vonMangoldt_nonneg)
    have h1 : ∑ n ∈ Finset.range N, ArithmeticFunction.vonMangoldt n ≤
        ∑ n ∈ Finset.Icc 0 N, ArithmeticFunction.vonMangoldt n := by
      apply Finset.sum_le_sum_of_subset_of_nonneg
      · intro n hn
        simp only [Finset.mem_range] at hn
        simp only [Finset.mem_Icc]
        omega
      · intro _ _ _
        exact ArithmeticFunction.vonMangoldt_nonneg
    have h2 := Chebyshev.psi_le_const_mul_self (x := (N : ℝ)) (Nat.cast_nonneg N)
    rw [Chebyshev.psi_eq_sum_Icc, Nat.floor_natCast] at h2
    linarith
  have hGc : ContinuousOn (ArithmeticFunction.vonMangoldt.LFunctionResidueClassAux (q := 1) 1)
      {s | 1 ≤ s.re} :=
    ArithmeticFunction.vonMangoldt.continuousOn_LFunctionResidueClassAux 1
  have hGe : Set.EqOn (ArithmeticFunction.vonMangoldt.LFunctionResidueClassAux (q := 1) 1)
      (fun s => LSeries (fun n => ((ArithmeticFunction.vonMangoldt n : ℝ) : ℂ)) s -
        ((1 : ℝ) : ℂ) / (s - 1)) {s | 1 < s.re} := by
    intro s hs
    have h := ArithmeticFunction.vonMangoldt.eqOn_LFunctionResidueClassAux (q := 1) (a := 1)
      isUnit_one hs
    simp only [Nat.totient_one, Nat.cast_one, inv_one] at h
    rw [h]
    simp only [Complex.ofReal_one]
    congr 1
    apply LSeries_congr
    intro n _
    simp [ArithmeticFunction.vonMangoldt.residueClass, Set.indicator,
      Subsingleton.elim (n : ZMod 1) 1]
  
  have hS := fun g => wiener_ikehara_schwartz_limit (fun n => ArithmeticFunction.vonMangoldt n) 1
    (ArithmeticFunction.vonMangoldt.LFunctionResidueClassAux (q := 1) 1) hsum hcheb hGc hGe g
  have hsm := fun Ψ h1 h2 h3 =>
    smooth_limit_of_schwartz_limit (fun n => ArithmeticFunction.vonMangoldt n) 1 hS Ψ h1 h2 h3
  have h : Filter.Tendsto
      (fun N : ℕ => (∑ n ∈ Finset.range N, ArithmeticFunction.vonMangoldt n) / (N : ℝ))
      Filter.atTop (nhds 1) :=
    cumsum_limit_of_smooth_limits (fun n => ArithmeticFunction.vonMangoldt n) 1
      (fun n => ArithmeticFunction.vonMangoldt_nonneg) hcheb hsm
  
  have hψ : Tendsto (fun x : ℝ => Chebyshev.psi x / x) atTop (𝓝 1) := by
    have hu : Tendsto (fun x : ℝ => ⌊x⌋₊ + 1) atTop atTop :=
      (tendsto_add_atTop_nat 1).comp tendsto_nat_floor_atTop
    have h1 : Tendsto (fun x : ℝ => Chebyshev.psi x / ((⌊x⌋₊ + 1 : ℕ) : ℝ)) atTop (𝓝 1) := by
      refine (h.comp hu).congr' (Eventually.of_forall fun x => ?_)
      simp only [Function.comp]
      rw [Chebyshev.psi_eq_sum_Icc]
      congr 1
      apply Finset.sum_congr _ (fun _ _ => rfl)
      ext n
      simp only [Finset.mem_range, Finset.mem_Icc]
      omega
    have h2 : Tendsto (fun x : ℝ => ((⌊x⌋₊ + 1 : ℕ) : ℝ) / x) atTop (𝓝 1) := by
      have hup : Tendsto (fun x : ℝ => 1 + x⁻¹) atTop (𝓝 1) := by
        simpa using (tendsto_const_nhds (x := (1 : ℝ))).add tendsto_inv_atTop_zero
      refine tendsto_of_tendsto_of_tendsto_of_le_of_le' tendsto_const_nhds hup ?_ ?_
      · filter_upwards [eventually_gt_atTop (0 : ℝ)] with x hx
        rw [le_div_iff₀ hx, one_mul]
        push_cast
        linarith [Nat.lt_floor_add_one x]
      · filter_upwards [eventually_gt_atTop (0 : ℝ)] with x hx
        rw [div_le_iff₀ hx, add_mul, one_mul, inv_mul_cancel₀ hx.ne']
        push_cast
        linarith [Nat.floor_le hx.le]
    have h3 := h1.mul h2
    rw [mul_one] at h3
    refine h3.congr' ?_
    filter_upwards [eventually_gt_atTop (0 : ℝ)] with x hx
    have hne : ((⌊x⌋₊ + 1 : ℕ) : ℝ) ≠ 0 := by positivity
    field_simp
  have hθ : Tendsto (fun x : ℝ => Chebyshev.theta x / x) atTop (𝓝 1) := by
    have hd : Tendsto (fun x : ℝ => (Chebyshev.psi x - Chebyshev.theta x) / x) atTop (𝓝 0) := by
      have hlo : Tendsto (fun x : ℝ => Real.log x / x ^ (1 / 2 : ℝ)) atTop (𝓝 0) :=
        (isLittleO_log_rpow_atTop (by norm_num : (0 : ℝ) < 1 / 2)).tendsto_div_nhds_zero
      have hlo2 : Tendsto (fun x : ℝ => 2 * (Real.log x / x ^ (1 / 2 : ℝ))) atTop (𝓝 0) := by
        simpa using hlo.const_mul 2
      rw [tendsto_zero_iff_norm_tendsto_zero]
      refine squeeze_zero' (Eventually.of_forall fun x => norm_nonneg _) ?_ hlo2
      filter_upwards [eventually_ge_atTop (1 : ℝ)] with x hx
      have hx0 : 0 < x := by linarith
      rw [Real.norm_eq_abs, abs_div, abs_of_pos hx0, div_le_iff₀ hx0]
      have hb := Chebyshev.abs_psi_sub_theta_le_sqrt_mul_log hx
      rw [← Real.sqrt_eq_rpow]
      have hsq : 0 < √x := Real.sqrt_pos.mpr hx0
      have hxx : √x * √x = x := Real.mul_self_sqrt hx0.le
      have hk : Real.log x / √x * x = Real.log x * √x := by
        rw [div_mul_eq_mul_div, div_eq_iff hsq.ne', mul_assoc, hxx]
      calc |Chebyshev.psi x - Chebyshev.theta x| ≤ 2 * √x * Real.log x := hb
        _ = 2 * (Real.log x / √x * x) := by rw [hk]; ring
        _ = 2 * (Real.log x / √x) * x := by ring
    have h4 := hψ.sub hd
    rw [sub_zero] at h4
    refine h4.congr' (Eventually.of_forall fun x => ?_)
    ring
  have hE : Tendsto (fun x : ℝ => ((Nat.primeCounting ⌊x⌋₊ : ℝ) - Chebyshev.theta x / Real.log x) *
      (Real.log x / x)) atTop (𝓝 0) := by
    have hB := Chebyshev.primeCounting_sub_theta_div_log_isBigO
    have hB2 := hB.mul (Asymptotics.isBigO_refl (fun x : ℝ => Real.log x / x) atTop)
    refine hB2.trans_tendsto ?_
    have hinv : Tendsto (fun x : ℝ => (Real.log x)⁻¹) atTop (𝓝 0) :=
      Real.tendsto_log_atTop.inv_tendsto_atTop
    refine hinv.congr' ?_
    filter_upwards [eventually_gt_atTop (1 : ℝ)] with x hx
    have hl : 0 < Real.log x := Real.log_pos hx
    have hx0 : 0 < x := by linarith
    field_simp
  have h5 := hθ.add hE
  rw [add_zero] at h5
  refine h5.congr' ?_
  filter_upwards [eventually_gt_atTop (1 : ℝ)] with x hx
  have hl : 0 < Real.log x := Real.log_pos hx
  have hx0 : 0 < x := by linarith
  field_simp
  ring

theorem sum_vonMangoldt_div_sub_log_bound : ∀ x : ℝ, 1 ≤ x →
    |(∑ n ∈ Finset.Icc 0 ⌊x⌋₊, ArithmeticFunction.vonMangoldt n / (n : ℝ)) - Real.log x| ≤ Real.log 4 + 4 :=
by
  intro x hx
  have hx0 : 0 < x := by linarith
  have hN1 : 1 ≤ ⌊x⌋₊ := Nat.le_floor (by simpa using hx)
  have hNx : (⌊x⌋₊ : ℝ) ≤ x := Nat.floor_le hx0.le
  have hxN : x < (⌊x⌋₊ : ℝ) + 1 := Nat.lt_floor_add_one x
  have hNpos : (0 : ℝ) < (⌊x⌋₊ : ℝ) := by exact_mod_cast hN1
  
  have hs1 : (∑ n ∈ Finset.Icc 0 ⌊x⌋₊, ArithmeticFunction.vonMangoldt n / (n : ℝ)) =
      ∑ n ∈ Finset.Ioc 0 ⌊x⌋₊, ArithmeticFunction.vonMangoldt n / (n : ℝ) := by
    rw [← Finset.add_sum_Ioc_eq_sum_Icc (Nat.zero_le _)]
    simp
  
  have hs2 : (∑ n ∈ Finset.Ioc 0 ⌊x⌋₊, Real.log (n : ℝ)) =
      ∑ d ∈ Finset.Ioc 0 ⌊x⌋₊, ArithmeticFunction.vonMangoldt d * (⌊x / (d : ℝ)⌋₊ : ℝ) := by
    have h : ∀ n : ℕ, Real.log (n : ℝ) =
        (ArithmeticFunction.vonMangoldt * (ArithmeticFunction.zeta : ArithmeticFunction ℝ)) n := by
      intro n
      rw [ArithmeticFunction.vonMangoldt_mul_zeta, ArithmeticFunction.log_apply]
    simp_rw [h, ArithmeticFunction.sum_Ioc_mul_zeta_eq_sum, Nat.floor_div_natCast]
  
  have hs3 : (∑ n ∈ Finset.Ioc 0 ⌊x⌋₊, Real.log (n : ℝ)) ≤ x * Real.log x := by
    calc _ ≤ ∑ n ∈ Finset.Ioc 0 ⌊x⌋₊, Real.log x := by
          refine Finset.sum_le_sum fun n hn => ?_
          rw [Finset.mem_Ioc] at hn
          exact Real.log_le_log (by exact_mod_cast hn.1) ((Nat.le_floor_iff hx0.le).mp hn.2)
      _ = (⌊x⌋₊ : ℝ) * Real.log x := by simp
      _ ≤ x * Real.log x := mul_le_mul_of_nonneg_right hNx (Real.log_nonneg hx)
  
  have hfact : (∑ n ∈ Finset.Ioc 0 ⌊x⌋₊, Real.log (n : ℝ)) =
      Real.log ((⌊x⌋₊).factorial : ℝ) := by
    have hI : Finset.Ioc 0 ⌊x⌋₊ = Finset.Ico 1 (⌊x⌋₊ + 1) := by
      ext n
      simp only [Finset.mem_Ioc, Finset.mem_Ico]
      omega
    rw [hI, ← Finset.prod_Ico_id_eq_factorial, Nat.cast_prod, Real.log_prod]
    intro n hn
    rw [Finset.mem_Ico] at hn
    have : (0 : ℝ) < n := by exact_mod_cast (by omega : 0 < n)
    exact this.ne'
  have hfb : (⌊x⌋₊ : ℝ) * Real.log ⌊x⌋₊ - ⌊x⌋₊ ≤ Real.log ((⌊x⌋₊).factorial : ℝ) := by
    have h1 := Real.pow_div_factorial_le_exp (⌊x⌋₊ : ℝ) hNpos.le ⌊x⌋₊
    have hfpos : (0 : ℝ) < ((⌊x⌋₊).factorial : ℝ) := by exact_mod_cast Nat.factorial_pos _
    have hpow : (0 : ℝ) < (⌊x⌋₊ : ℝ) ^ ⌊x⌋₊ := pow_pos hNpos _
    have h2 := Real.log_le_log (div_pos hpow hfpos) h1
    rw [Real.log_exp, Real.log_div hpow.ne' hfpos.ne', Real.log_pow] at h2
    linarith
  have hc : x * Real.log x - 2 * x ≤ (⌊x⌋₊ : ℝ) * Real.log ⌊x⌋₊ - ⌊x⌋₊ := by
    have hl1 : Real.log x ≤ x - 1 := Real.log_le_sub_one_of_pos hx0
    have hl2 : Real.log (x / ⌊x⌋₊) ≤ x / ⌊x⌋₊ - 1 :=
      Real.log_le_sub_one_of_pos (div_pos hx0 hNpos)
    rw [Real.log_div hx0.ne' hNpos.ne'] at hl2
    have h3 : (x - ⌊x⌋₊) * Real.log x ≤ 1 * Real.log x :=
      mul_le_mul_of_nonneg_right (by linarith) (Real.log_nonneg hx)
    have h4 : (⌊x⌋₊ : ℝ) * (Real.log x - Real.log ⌊x⌋₊) ≤ ⌊x⌋₊ * (x / ⌊x⌋₊ - 1) :=
      mul_le_mul_of_nonneg_left hl2 hNpos.le
    have h5 : (⌊x⌋₊ : ℝ) * (x / ⌊x⌋₊ - 1) = x - ⌊x⌋₊ := by
      field_simp
    nlinarith
  have hs4 : x * Real.log x - 2 * x ≤ ∑ n ∈ Finset.Ioc 0 ⌊x⌋₊, Real.log (n : ℝ) := by
    rw [hfact]; linarith
  
  have hmul : x * (∑ d ∈ Finset.Ioc 0 ⌊x⌋₊, ArithmeticFunction.vonMangoldt d / (d : ℝ)) =
      ∑ d ∈ Finset.Ioc 0 ⌊x⌋₊, ArithmeticFunction.vonMangoldt d * (x / d) := by
    rw [Finset.mul_sum]
    exact Finset.sum_congr rfl fun d _ => by ring
  have hlow : ∑ d ∈ Finset.Ioc 0 ⌊x⌋₊, ArithmeticFunction.vonMangoldt d * (⌊x / (d : ℝ)⌋₊ : ℝ) ≤
      ∑ d ∈ Finset.Ioc 0 ⌊x⌋₊, ArithmeticFunction.vonMangoldt d * (x / d) :=
    Finset.sum_le_sum fun d _ => mul_le_mul_of_nonneg_left
      (Nat.floor_le (div_nonneg hx0.le (Nat.cast_nonneg _))) ArithmeticFunction.vonMangoldt_nonneg
  have hup : ∑ d ∈ Finset.Ioc 0 ⌊x⌋₊, ArithmeticFunction.vonMangoldt d * (x / d) ≤
      ∑ d ∈ Finset.Ioc 0 ⌊x⌋₊, ArithmeticFunction.vonMangoldt d * (⌊x / (d : ℝ)⌋₊ : ℝ) +
        ∑ d ∈ Finset.Ioc 0 ⌊x⌋₊, ArithmeticFunction.vonMangoldt d := by
    rw [← Finset.sum_add_distrib]
    refine Finset.sum_le_sum fun d _ => ?_
    have h1 := Nat.lt_floor_add_one (x / d)
    have h0 : 0 ≤ ArithmeticFunction.vonMangoldt d := ArithmeticFunction.vonMangoldt_nonneg
    nlinarith
  have hpsi : ∑ d ∈ Finset.Ioc 0 ⌊x⌋₊, ArithmeticFunction.vonMangoldt d ≤ (Real.log 4 + 4) * x := by
    have := Chebyshev.psi_le_const_mul_self hx0.le
    rwa [Chebyshev.psi.eq_1] at this
  have hlog4 : 0 < Real.log 4 := Real.log_pos (by norm_num)
  rw [hs1]
  set S := ∑ d ∈ Finset.Ioc 0 ⌊x⌋₊, ArithmeticFunction.vonMangoldt d / (d : ℝ) with hS
  have hlo : x * (Real.log x - 2) ≤ x * S := by nlinarith
  have hhi : x * S ≤ x * (Real.log x + Real.log 4 + 4) := by nlinarith
  have e1 := le_of_mul_le_mul_left hlo hx0
  have e2 := le_of_mul_le_mul_left hhi hx0
  rw [abs_le]
  constructor <;> linarith

theorem abel_log_partial_sums_to_loglog (c : ℕ → ℝ) (C : ℝ) (hc0 : c 0 = 0) (hc1 : c 1 = 0)
    (hA : ∀ t : ℝ, 2 ≤ t → |(∑ n ∈ Finset.Icc 0 ⌊t⌋₊, c n) - Real.log t| ≤ C) :
    ∃ K : ℝ, ∀ x : ℝ, 2 ≤ x →
      |(∑ n ∈ Finset.Icc 0 ⌊x⌋₊, c n / Real.log n) - Real.log (Real.log x)| ≤ K :=
by
  have hC : 0 ≤ C := le_trans (abs_nonneg _) (hA 2 le_rfl)
  have hl2 : 0 < Real.log 2 := Real.log_pos (by norm_num)
  have hl2' : Real.log 2 < 1 := by have := Real.log_two_lt_d9; linarith
  have hAn : ∀ n : ℕ, 2 ≤ n →
      |(∑ m ∈ Finset.Icc 0 n, c m) - Real.log n| ≤ C := by
    intro n hn
    have h := hA (n : ℝ) (by exact_mod_cast hn)
    rwa [Nat.floor_natCast] at h
  have hlogpos : ∀ N : ℕ, 2 ≤ N → 0 < Real.log N := by
    intro N hN
    apply Real.log_pos
    exact_mod_cast (show 1 < N by omega)
  let G : ℕ → ℝ := fun N => (∑ n ∈ Finset.Icc 0 N, c n / Real.log n)
      - (∑ m ∈ Finset.Icc 0 N, c m) / Real.log N - Real.log (Real.log N)
  have key : ∀ N : ℕ, 2 ≤ N →
      |G N - G 2| ≤ (1 + C) * (1 / Real.log 2 - 1 / Real.log N) := by
    intro N hN
    induction N, hN using Nat.le_induction with
    | base => simp
    | succ N hN ih =>
      have ha : 0 < Real.log N := hlogpos N hN
      have hNpos : (0 : ℝ) < N := by exact_mod_cast (show 0 < N by omega)
      have hN2r : (2 : ℝ) ≤ N := by exact_mod_cast hN
      have hab : Real.log N ≤ Real.log ((N : ℝ) + 1) :=
        Real.log_le_log hNpos (by linarith)
      have hb : 0 < Real.log ((N : ℝ) + 1) := lt_of_lt_of_le ha hab
      have hba1 : Real.log ((N : ℝ) + 1) - Real.log N ≤ 1 := by
        have h1 : Real.log ((N : ℝ) + 1) ≤ Real.log (2 * N) :=
          Real.log_le_log (by linarith) (by linarith)
        rw [Real.log_mul (by norm_num) hNpos.ne'] at h1
        linarith
      have hGs : G (N + 1) = G N + (∑ m ∈ Finset.Icc 0 N, c m) *
          (1 / Real.log N - 1 / Real.log ((N : ℝ) + 1)) -
          (Real.log (Real.log ((N : ℝ) + 1)) - Real.log (Real.log N)) := by
        simp only [G]
        rw [Finset.sum_Icc_succ_top (Nat.zero_le _), Finset.sum_Icc_succ_top (Nat.zero_le _)]
        push_cast
        ring
      have hcast : ((N + 1 : ℕ) : ℝ) = (N : ℝ) + 1 := by push_cast; ring
      rw [hGs, hcast]
      have hE := abs_le.mp (hAn N hN)
      set X := ∑ m ∈ Finset.Icc 0 N, c m with hX
      set a := Real.log N with ha_def
      set b := Real.log ((N : ℝ) + 1) with hb_def
      have hu : a * (1 / a) = 1 := mul_one_div_cancel ha.ne'
      have hv : b * (1 / b) = 1 := mul_one_div_cancel hb.ne'
      have huv : 1 / b ≤ 1 / a := one_div_le_one_div_of_le ha hab
      have huv' : 0 ≤ 1 / a - 1 / b := by linarith
      have hlogdiv : Real.log (b / a) = Real.log b - Real.log a :=
        Real.log_div hb.ne' ha.ne'
      have hlow : 1 - (b / a)⁻¹ ≤ Real.log (b / a) :=
        Real.one_sub_inv_le_log_of_pos (div_pos hb ha)
      have hupp : Real.log (b / a) ≤ b / a - 1 := Real.log_le_sub_one_of_pos (div_pos hb ha)
      rw [inv_div] at hlow
      rw [hlogdiv] at hupp hlow
      have e1 : b / a = b * (1 / a) := by ring
      have e2 : a / b = a * (1 / b) := by ring
      rw [e1] at hupp
      rw [e2] at hlow
      have p1 : (X - a) * (1 / a - 1 / b) ≤ C * (1 / a - 1 / b) :=
        mul_le_mul_of_nonneg_right hE.2 huv'
      have p2 : -C * (1 / a - 1 / b) ≤ (X - a) * (1 / a - 1 / b) :=
        mul_le_mul_of_nonneg_right hE.1 huv'
      have p3 : (b - a) * (1 / a - 1 / b) ≤ 1 * (1 / a - 1 / b) :=
        mul_le_mul_of_nonneg_right hba1 huv'
      have hih := abs_le.mp ih
      rw [abs_le]
      constructor <;> nlinarith
  refine ⟨|G 2| + (1 + C) / Real.log 2 + 1 + C / Real.log 2 + 1, fun x hx => ?_⟩
  have hx0 : 0 < x := by linarith
  have hN2 : 2 ≤ ⌊x⌋₊ := Nat.le_floor (by norm_num; linarith)
  have hNx : (⌊x⌋₊ : ℝ) ≤ x := Nat.floor_le hx0.le
  have hxN : x < ⌊x⌋₊ + 1 := Nat.lt_floor_add_one x
  set N := ⌊x⌋₊ with hN_def
  have hNpos : (0 : ℝ) < N := by exact_mod_cast (show 0 < N by omega)
  have hN2r : (2 : ℝ) ≤ N := by exact_mod_cast hN2
  have ha := hlogpos N hN2
  have hk := abs_le.mp (key N hN2)
  have hE := abs_le.mp (hAn N hN2)
  have hGN : G N = (∑ n ∈ Finset.Icc 0 N, c n / Real.log n) -
      (∑ m ∈ Finset.Icc 0 N, c m) / Real.log N - Real.log (Real.log N) := rfl
  have hl2N : Real.log 2 ≤ Real.log N := Real.log_le_log (by norm_num) hN2r
  have hlx : Real.log N ≤ Real.log x := Real.log_le_log hNpos hNx
  have hlx2 : Real.log x ≤ 2 * Real.log N := by
    have h1 : Real.log x ≤ Real.log ((N : ℝ) ^ 2) := Real.log_le_log hx0 (by nlinarith)
    rw [Real.log_pow] at h1
    push_cast at h1
    linarith
  have hll1 : Real.log (Real.log N) ≤ Real.log (Real.log x) := Real.log_le_log ha hlx
  have hll2 : Real.log (Real.log x) - Real.log (Real.log N) ≤ 1 := by
    have hlxpos : 0 < Real.log x := lt_of_lt_of_le ha hlx
    rw [← Real.log_div hlxpos.ne' ha.ne']
    have h1 := Real.log_le_sub_one_of_pos (div_pos hlxpos ha)
    have h2 : Real.log x / Real.log N ≤ 2 := by rw [div_le_iff₀ ha]; linarith
    linarith
  set X := ∑ m ∈ Finset.Icc 0 N, c m with hX
  set S := ∑ n ∈ Finset.Icc 0 N, c n / Real.log n with hS
  set a := Real.log N with ha_def
  have hu : a * (1 / a) = 1 := mul_one_div_cancel ha.ne'
  have huv : 1 / a ≤ 1 / Real.log 2 := one_div_le_one_div_of_le hl2 hl2N
  have hu0 : 0 ≤ 1 / a := by positivity
  have hdiv : X / a = X * (1 / a) := by ring
  have p1 : (X - a) * (1 / a) ≤ C * (1 / a) := mul_le_mul_of_nonneg_right hE.2 hu0
  have p2 : -C * (1 / a) ≤ (X - a) * (1 / a) := mul_le_mul_of_nonneg_right hE.1 hu0
  have p3 : C * (1 / a) ≤ C * (1 / Real.log 2) := mul_le_mul_of_nonneg_left huv hC
  have p4 : 0 ≤ (1 + C) * (1 / a) := by positivity
  have q1 : (1 + C) / Real.log 2 = (1 + C) * (1 / Real.log 2) := by ring
  have q2 : C / Real.log 2 = C * (1 / Real.log 2) := by ring
  have r1 := le_abs_self (G 2)
  have r2 := neg_abs_le (G 2)
  rw [hGN, hdiv] at hk
  rw [abs_le]
  constructor <;> nlinarith

theorem vonMangoldt_div_log_sum_sub_prime_recip (N : ℕ) :
    0 ≤ (∑ n ∈ Finset.Icc 0 N, ArithmeticFunction.vonMangoldt n / (n : ℝ) / Real.log n) -
          ∑ p ∈ (Finset.Iic N).filter Nat.Prime, (1 : ℝ) / p ∧
    (∑ n ∈ Finset.Icc 0 N, ArithmeticFunction.vonMangoldt n / (n : ℝ) / Real.log n) -
          ∑ p ∈ (Finset.Iic N).filter Nat.Prime, (1 : ℝ) / p ≤ 1 :=
by
  set T : ℕ → ℝ := fun n => ArithmeticFunction.vonMangoldt n / (n : ℝ) / Real.log n -
      (if Nat.Prime n then (1 : ℝ) / n else 0) with hTdef
  have hsplit : (∑ n ∈ Finset.Icc 0 N, ArithmeticFunction.vonMangoldt n / (n : ℝ) / Real.log n) -
      ∑ p ∈ (Finset.Iic N).filter Nat.Prime, (1 : ℝ) / p = ∑ n ∈ Finset.Icc 0 N, T n := by
    have hIic : Finset.Iic N = Finset.Icc 0 N := by ext n; simp
    rw [hIic, Finset.sum_filter, ← Finset.sum_sub_distrib]
  
  have hT : ∀ n : ℕ, 0 ≤ T n ∧ (T n = 0 ∨ ∃ m k : ℕ, 2 ≤ m ∧ 2 ≤ k ∧ n = m ^ k ∧
      T n ≤ 1 / (2 * (m : ℝ) ^ k)) := by
    intro n
    by_cases hp : n.Prime
    · have h2 : (1 : ℝ) < n := by exact_mod_cast hp.one_lt
      have hlog : 0 < Real.log n := Real.log_pos h2
      have hn0 : (n : ℝ) ≠ 0 := by positivity
      have hlog0 : Real.log n ≠ 0 := hlog.ne'
      have h0 : T n = 0 := by
        simp only [hTdef, if_pos hp, ArithmeticFunction.vonMangoldt_apply_prime hp]
        field_simp
        ring
      exact ⟨h0.ge, Or.inl h0⟩
    · by_cases hpp : IsPrimePow n
      · obtain ⟨p, k, hpk, hk, rfl⟩ := (isPrimePow_nat_iff _).mp hpp
        have hk2 : 2 ≤ k := by
          rcases Nat.lt_or_ge k 2 with h | h
          · exfalso
            have hk1 : k = 1 := by omega
            subst hk1
            exact hp (by simpa using hpk)
          · exact h
        have hp1 : (1 : ℝ) < p := by exact_mod_cast hpk.one_lt
        have hlogp : 0 < Real.log p := Real.log_pos hp1
        have hlogp0 : Real.log p ≠ 0 := hlogp.ne'
        have hpos : (0 : ℝ) < (p : ℝ) ^ k := by positivity
        have hpos0 : (p : ℝ) ^ k ≠ 0 := hpos.ne'
        have hkpos : (0 : ℝ) < k := by exact_mod_cast hk
        have hk0 : (k : ℝ) ≠ 0 := hkpos.ne'
        have hval : T (p ^ k) = 1 / (k * (p : ℝ) ^ k) := by
          simp only [hTdef, if_neg hp, ArithmeticFunction.vonMangoldt_apply_pow (by omega : k ≠ 0),
            ArithmeticFunction.vonMangoldt_apply_prime hpk, Nat.cast_pow, Real.log_pow, sub_zero]
          field_simp
        refine ⟨by rw [hval]; positivity, Or.inr ⟨p, k, hpk.two_le, hk2, rfl, ?_⟩⟩
        rw [hval]
        apply one_div_le_one_div_of_le (by positivity)
        have : (2 : ℝ) ≤ k := by exact_mod_cast hk2
        nlinarith
      · have h0 : T n = 0 := by
          simp only [hTdef, if_neg hp, ArithmeticFunction.vonMangoldt_eq_zero_iff.mpr hpp]
          simp
        exact ⟨h0.ge, Or.inl h0⟩
  
  have hG : ∀ n ∈ Finset.Icc 0 N, T n ≤ ∑ m ∈ Finset.Icc 2 N, ∑ k ∈ Finset.Icc 2 N,
      (if n = m ^ k then 1 / (2 * (m : ℝ) ^ k) else 0) := by
    intro n hn
    have hnN : n ≤ N := (Finset.mem_Icc.mp hn).2
    have hnonneg : ∀ m k : ℕ, 0 ≤ (if n = m ^ k then 1 / (2 * (m : ℝ) ^ k) else 0) := by
      intro m k
      split_ifs <;> positivity
    rcases (hT n).2 with h0 | ⟨m, k, hm, hk, rfl, hle⟩
    · rw [h0]
      exact Finset.sum_nonneg fun m _ => Finset.sum_nonneg fun k _ => hnonneg m k
    · have hmN : m ∈ Finset.Icc 2 N := by
        refine Finset.mem_Icc.mpr ⟨hm, le_trans ?_ hnN⟩
        exact Nat.le_self_pow (by omega) m
      have hkN : k ∈ Finset.Icc 2 N := by
        refine Finset.mem_Icc.mpr ⟨hk, le_trans ?_ hnN⟩
        calc k ≤ 2 ^ k := (Nat.lt_two_pow_self).le
          _ ≤ m ^ k := Nat.pow_le_pow_left hm k
      calc T (m ^ k) ≤ 1 / (2 * (m : ℝ) ^ k) := hle
        _ = (if m ^ k = m ^ k then 1 / (2 * (m : ℝ) ^ k) else 0) := by rw [if_pos rfl]
        _ ≤ ∑ k' ∈ Finset.Icc 2 N, (if m ^ k = m ^ k' then 1 / (2 * (m : ℝ) ^ k') else 0) :=
            Finset.single_le_sum
              (f := fun k' => if m ^ k = m ^ k' then 1 / (2 * (m : ℝ) ^ k') else 0)
              (fun k' _ => hnonneg m k') hkN
        _ ≤ ∑ m' ∈ Finset.Icc 2 N, ∑ k' ∈ Finset.Icc 2 N,
              (if m ^ k = m' ^ k' then 1 / (2 * (m' : ℝ) ^ k') else 0) :=
            Finset.single_le_sum
              (f := fun m' => ∑ k' ∈ Finset.Icc 2 N,
                (if m ^ k = m' ^ k' then 1 / (2 * (m' : ℝ) ^ k') else 0))
              (fun m' _ => Finset.sum_nonneg fun k' _ => hnonneg m' k') hmN
  
  have hswap : ∑ n ∈ Finset.Icc 0 N, ∑ m ∈ Finset.Icc 2 N, ∑ k ∈ Finset.Icc 2 N,
      (if n = m ^ k then 1 / (2 * (m : ℝ) ^ k) else 0)
      ≤ ∑ m ∈ Finset.Icc 2 N, ∑ k ∈ Finset.Icc 2 N, (1 / 2) * ((m : ℝ)⁻¹) ^ k := by
    rw [Finset.sum_comm]
    apply Finset.sum_le_sum
    intro m _
    rw [Finset.sum_comm]
    apply Finset.sum_le_sum
    intro k _
    rw [Finset.sum_ite_eq']
    have he : (1 / 2 : ℝ) * ((m : ℝ)⁻¹) ^ k = 1 / (2 * (m : ℝ) ^ k) := by
      rw [inv_pow]; ring
    rw [he]
    split_ifs
    · exact le_rfl
    · positivity
  
  have hgeom : ∀ m ∈ Finset.Icc 2 N, ∑ k ∈ Finset.Icc 2 N, (1 / 2) * ((m : ℝ)⁻¹) ^ k ≤
      (1 / 2) * (1 / ((m : ℝ) * ((m : ℝ) - 1))) := by
    intro m hm
    have hm2 : (2 : ℝ) ≤ m := by exact_mod_cast (Finset.mem_Icc.mp hm).1
    have hx0 : 0 ≤ (m : ℝ)⁻¹ := by positivity
    have hx1 : (m : ℝ)⁻¹ < 1 := inv_lt_one_of_one_lt₀ (by linarith)
    have hIco : Finset.Icc 2 N = Finset.Ico 2 (N + 1) := by
      ext k; simp only [Finset.mem_Icc, Finset.mem_Ico]; omega
    have h2 := geom_sum_Ico_le_of_lt_one (m := 2) (n := N + 1) hx0 hx1
    have hm0 : (m : ℝ) ≠ 0 := by positivity
    have hm1 : (m : ℝ) - 1 ≠ 0 := by
      have : (0 : ℝ) < (m : ℝ) - 1 := by linarith
      exact this.ne'
    have h3 : ((m : ℝ)⁻¹) ^ 2 / (1 - (m : ℝ)⁻¹) = 1 / ((m : ℝ) * ((m : ℝ) - 1)) := by
      field_simp
    rw [← Finset.mul_sum, hIco]
    rw [h3] at h2
    linarith
  
  have htele : ∀ M : ℕ, ∑ m ∈ Finset.Icc 2 (M + 1), 1 / ((m : ℝ) * ((m : ℝ) - 1)) =
      1 - 1 / ((M : ℝ) + 1) := by
    intro M
    induction M with
    | zero =>
      rw [Finset.Icc_eq_empty (by norm_num)]
      simp
    | succ M ih =>
      rw [Finset.sum_Icc_succ_top (by omega), ih]
      push_cast
      have h1 : (M : ℝ) + 1 ≠ 0 := by positivity
      have h2 : (M : ℝ) + 1 + 1 ≠ 0 := by positivity
      field_simp
      ring
  have hS : ∑ m ∈ Finset.Icc 2 N, 1 / ((m : ℝ) * ((m : ℝ) - 1)) ≤ 1 := by
    rcases N with _ | M
    · rw [Finset.Icc_eq_empty (by norm_num)]
      simp
    · rw [htele M]
      have : (0 : ℝ) ≤ 1 / ((M : ℝ) + 1) := by positivity
      linarith
  rw [hsplit]
  refine ⟨Finset.sum_nonneg fun n _ => (hT n).1, ?_⟩
  calc ∑ n ∈ Finset.Icc 0 N, T n
      ≤ ∑ n ∈ Finset.Icc 0 N, ∑ m ∈ Finset.Icc 2 N, ∑ k ∈ Finset.Icc 2 N,
          (if n = m ^ k then 1 / (2 * (m : ℝ) ^ k) else 0) := Finset.sum_le_sum hG
    _ ≤ ∑ m ∈ Finset.Icc 2 N, ∑ k ∈ Finset.Icc 2 N, (1 / 2) * ((m : ℝ)⁻¹) ^ k := hswap
    _ ≤ ∑ m ∈ Finset.Icc 2 N, (1 / 2) * (1 / ((m : ℝ) * ((m : ℝ) - 1))) :=
        Finset.sum_le_sum hgeom
    _ = (1 / 2) * ∑ m ∈ Finset.Icc 2 N, 1 / ((m : ℝ) * ((m : ℝ) - 1)) := by
        rw [Finset.mul_sum]
    _ ≤ 1 := by linarith

theorem prime_reciprocal_mertens : ∃ C : ℝ, ∀ x : ℝ, 2 ≤ x →
      |(∑ p ∈ (Finset.Iic ⌊x⌋₊).filter Nat.Prime, (1 : ℝ) / p) - Real.log (Real.log x)| ≤ C :=
by
  obtain ⟨K, hK⟩ := abel_log_partial_sums_to_loglog
    (fun n => ArithmeticFunction.vonMangoldt n / (n : ℝ)) (Real.log 4 + 4)
    (by simp) (by simp) (fun t ht => sum_vonMangoldt_div_sub_log_bound t (by linarith))
  refine ⟨K + 1, fun x hx => ?_⟩
  have h1 := hK x hx
  obtain ⟨h2, h3⟩ := vonMangoldt_div_log_sum_sub_prime_recip ⌊x⌋₊
  simp only at h1
  rw [abs_le] at h1 ⊢
  obtain ⟨h1a, h1b⟩ := h1
  constructor <;> linarith

theorem vonMangoldt_div_sum_sub_log_abs_le : ∀ x : ℝ, 1 ≤ x → |(∑ d ∈ Finset.Ioc 0 ⌊x⌋₊, ArithmeticFunction.vonMangoldt d / (d : ℝ)) - Real.log x| ≤ Real.log 4 + 4 :=
by
  intro x hx
  have hx0 : 0 < x := by linarith
  have hN1 : 1 ≤ ⌊x⌋₊ := Nat.le_floor (by simpa using hx)
  have hNx : (⌊x⌋₊ : ℝ) ≤ x := Nat.floor_le hx0.le
