theorem thickened_outer_shell_volume_bound (L : ℕ) (ξ : ℕ → ℝ) (δ τ : ℝ)
    (hL : 1 ≤ L) (hξ : 1 ≤ ξ 0) (hδ : 0 ≤ δ) (hτ : 0 ≤ τ) :
    MeasureTheory.volume.real ((FordGeometry.polytope L ξ ∩ {x | 1 - δ < FordGeometry.outerForm L x}) +
        Set.Icc (fun _ : Fin L => -τ) (fun _ => τ)) ≤
      2 * L * (δ + ξ 0 - 1 + (((L : ℝ) + 1) * Real.log ((L : ℝ) + 1) - L) * τ) *
        MeasureTheory.volume.real (FordGeometry.polytope L ξ + Set.Icc (fun _ : Fin L => -τ) (fun _ => τ)) :=
by
  classical
  
  have hw : ∀ n : ℕ, 1 ≤ n → 0 ≤ fordWeight n := by
    intro n hn
    unfold fordWeight
    have hm : (1 : ℝ) ≤ (n : ℝ) := by exact_mod_cast hn
    have hm0 : (0 : ℝ) < (n : ℝ) := by linarith
    have hm1 : (0 : ℝ) < (n : ℝ) + 1 := by linarith
    have hlog2 : Real.log 2 ≤ Real.log ((n : ℝ) + 1) :=
      Real.log_le_log (by norm_num) (by linarith)
    have h2 := Real.log_two_gt_d9
    have hdiv := Real.log_le_sub_one_of_pos (show 0 < (n : ℝ) / ((n : ℝ) + 1) by positivity)
    rw [Real.log_div hm0.ne' hm1.ne'] at hdiv
    have hfrac : (n : ℝ) / ((n : ℝ) + 1) - 1 = -(1 / ((n : ℝ) + 1)) := by
      rw [div_sub_one hm1.ne']
      ring
    have h3 : 1 / ((n : ℝ) + 1) ≤ Real.log ((n : ℝ) + 1) - Real.log (n : ℝ) := by linarith
    have h4 := mul_le_mul_of_nonneg_left h3 hm0.le
    have h5 : 1 / 2 ≤ (n : ℝ) * (1 / ((n : ℝ) + 1)) := by
      rw [mul_one_div, div_le_div_iff₀ (by norm_num) hm1]
      linarith
    nlinarith
  
  have htel : ∀ n : ℕ, (∑ i ∈ Finset.range n, fordWeight (i + 1)) =
      ((n : ℝ) + 1) * Real.log ((n : ℝ) + 1) - n := by
    intro n
    induction n with
    | zero => simp
    | succ n ih =>
      rw [Finset.sum_range_succ, ih]
      unfold fordWeight
      push_cast
      ring
  set W : ℝ := ((L : ℝ) + 1) * Real.log ((L : ℝ) + 1) - L with hWdef
  have hsumW : (∑ i : Fin L, fordWeight (i.val + 1)) = W := by
    rw [Fin.sum_univ_eq_sum_range (fun i => fordWeight (i + 1)) L, htel]
  set C : Set (Fin L → ℝ) := Set.Icc (fun _ : Fin L => -τ) (fun _ => τ) with hC
  set P : Set (Fin L → ℝ) := FordGeometry.polytope L ξ with hP
  set K : Set (Fin L → ℝ) := P + C with hK
  
  have hfe : ∀ e ∈ C, |FordGeometry.outerForm L e| ≤ W * τ := by
    intro e he
    have hfe' : FordGeometry.outerForm L e = ∑ i : Fin L, fordWeight (i.val + 1) * e i := rfl
    rw [hfe']
    calc |∑ i : Fin L, fordWeight (i.val + 1) * e i|
        ≤ ∑ i : Fin L, |fordWeight (i.val + 1) * e i| := Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ i : Fin L, fordWeight (i.val + 1) * τ := by
        apply Finset.sum_le_sum
        intro i _
        have h1 : -τ ≤ e i := he.1 i
        have h2 : e i ≤ τ := he.2 i
        rw [abs_mul, abs_of_nonneg (hw _ (by omega))]
        exact mul_le_mul_of_nonneg_left (abs_le.mpr ⟨h1, h2⟩) (hw _ (by omega))
      _ = W * τ := by rw [← Finset.sum_mul, hsumW]
  have h0C : (0 : Fin L → ℝ) ∈ C :=
    ⟨fun i => by show -τ ≤ 0; linarith, fun i => by show (0 : ℝ) ≤ τ; exact hτ⟩
  have hWτ : 0 ≤ W * τ := (abs_nonneg _).trans (hfe 0 h0C)
  
  have hP1sub : P ⊆ Set.Icc (fun _ : Fin L => (0 : ℝ)) (fun _ => 1) :=
    fun x hx => ⟨fun i => hx.1 i, fun i => hx.2.1 i⟩
  have hKb : Bornology.IsBounded K :=
    ((Metric.isBounded_Icc _ _).subset hP1sub).add (Metric.isBounded_Icc _ _)
  have hKfin : MeasureTheory.volume K ≠ ⊤ := hKb.measure_lt_top.ne
  have hSK : (P ∩ {x | 1 - δ < FordGeometry.outerForm L x}) + C ⊆ K :=
    Set.add_subset_add Set.inter_subset_left subset_rfl
  have hKnn : 0 ≤ MeasureTheory.volume.real K := MeasureTheory.measureReal_nonneg
  have hL' : (1 : ℝ) ≤ L := by exact_mod_cast hL
  by_cases ha : 1 - δ - W * τ ≤ 0
  · 
    have hcoef : 1 ≤ 2 * L * (δ + ξ 0 - 1 + W * τ) := by nlinarith
    calc MeasureTheory.volume.real ((P ∩ {x | 1 - δ < FordGeometry.outerForm L x}) + C)
        ≤ MeasureTheory.volume.real K := MeasureTheory.measureReal_mono hSK hKfin
      _ ≤ _ := le_mul_of_one_le_left hKnn hcoef
  · push_neg at ha
    set a : ℝ := 1 - δ - W * τ with hadef
    set B : ℝ := ξ 0 + W * τ with hBdef
    have hB1 : 1 ≤ B := by linarith
    have hB0 : 0 < B := by linarith
    have haB : a ≤ B := by linarith
    set r : ℝ := a / B with hrdef
    have hr0 : 0 ≤ r := div_nonneg ha.le hB0.le
    have hr1 : r ≤ 1 := (div_le_one hB0).mpr haB
    have hrB : r * B = a := div_mul_cancel₀ a hB0.ne'
    
    have hsmul : r • K ⊆ K := by
      intro z hz
      obtain ⟨y, hy, rfl⟩ := Set.mem_smul_set.mp hz
      obtain ⟨x, hx, e, he, rfl⟩ := Set.mem_add.mp hy
      rw [smul_add]
      refine Set.add_mem_add ?_ ?_
      · obtain ⟨h0, h1, hanti, houter, htail⟩ := hx
        refine ⟨fun i => ?_, fun i => ?_, ?_, ?_, ?_⟩
        · show 0 ≤ r * x i
          exact mul_nonneg hr0 (h0 i)
        · show r * x i ≤ 1
          have := h0 i
          have := h1 i
          nlinarith
        · intro i j hij
          show r * x j ≤ r * x i
          exact mul_le_mul_of_nonneg_left (hanti hij) hr0
        · rw [map_smul, smul_eq_mul]
          have h3 := mul_le_mul_of_nonneg_left houter hr0
          nlinarith
        · intro idx hidx
          rw [map_smul, smul_eq_mul]
          show r * _ ≤ ξ (idx.val + 1) * (r * x idx)
          have h3 := mul_le_mul_of_nonneg_left (htail idx hidx) hr0
          calc _ ≤ r * (ξ (idx.val + 1) * x idx) := h3
            _ = ξ (idx.val + 1) * (r * x idx) := by ring
      · refine ⟨fun i => ?_, fun i => ?_⟩
        · have h1 : -τ ≤ e i := he.1 i
          have h2 : e i ≤ τ := he.2 i
          show -τ ≤ r * e i
          nlinarith
        · have h1 : -τ ≤ e i := he.1 i
          have h2 : e i ≤ τ := he.2 i
          show r * e i ≤ τ
          nlinarith
    
    have hup : ∀ y ∈ K, FordGeometry.outerForm L y ≤ B := by
      intro y hy
      obtain ⟨x, hx, e, he, rfl⟩ := Set.mem_add.mp hy
      rw [map_add]
      have h1 : FordGeometry.outerForm L x ≤ ξ 0 := hx.2.2.2.1
      have h2 := (le_abs_self _).trans (hfe e he)
      linarith
    set T : Set (Fin L → ℝ) := {y | a < FordGeometry.outerForm L y} with hTdef
    have hlow : (P ∩ {x | 1 - δ < FordGeometry.outerForm L x}) + C ⊆ K ∩ T := by
      intro y hy
      refine ⟨hSK hy, ?_⟩
      obtain ⟨x, hx, e, he, rfl⟩ := Set.mem_add.mp hy
      show a < FordGeometry.outerForm L (x + e)
      rw [map_add]
      have h1 : 1 - δ < FordGeometry.outerForm L x := hx.2
      have h2 := (neg_abs_le (FordGeometry.outerForm L e))
      have h3 := hfe e he
      linarith
    have hTm : MeasurableSet T :=
      measurableSet_lt measurable_const
        (LinearMap.continuous_of_finiteDimensional (FordGeometry.outerForm L)).measurable
    have hsplit := MeasureTheory.measureReal_inter_add_diff (μ := MeasureTheory.volume) (s := K)
      hTm hKfin
    have hsub : r • K ⊆ K \ T := by
      intro z hz
      refine ⟨hsmul hz, ?_⟩
      obtain ⟨y, hy, rfl⟩ := Set.mem_smul_set.mp hz
      show ¬ a < FordGeometry.outerForm L (r • y)
      rw [map_smul, smul_eq_mul]
      have h1 := mul_le_mul_of_nonneg_left (hup y hy) hr0
      linarith
    have hdifffin : MeasureTheory.volume (K \ T) ≠ ⊤ :=
      ((MeasureTheory.measure_mono Set.diff_subset).trans_lt hKfin.lt_top).ne
    have hvolsmul : MeasureTheory.volume.real (r • K) = r ^ L * MeasureTheory.volume.real K := by
      rw [MeasureTheory.measureReal_def, MeasureTheory.Measure.addHaar_smul_of_nonneg _ hr0 K,
        Module.finrank_fin_fun, ENNReal.toReal_mul, ENNReal.toReal_ofReal (pow_nonneg hr0 _),
        MeasureTheory.measureReal_def]
    have hm1 : MeasureTheory.volume.real (r • K) ≤ MeasureTheory.volume.real (K \ T) :=
      MeasureTheory.measureReal_mono hsub hdifffin
    have hbern : 1 - r ^ L ≤ L * (1 - r) := by
      have h := one_add_mul_le_pow (a := r - 1) (by linarith) L
      rw [show 1 + (r - 1) = r by ring] at h
      linarith
    have hST : MeasureTheory.volume.real ((P ∩ {x | 1 - δ < FordGeometry.outerForm L x}) + C) ≤
