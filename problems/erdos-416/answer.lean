theorem small_weight_antitone_sum_le (P : Finset ℕ) (a : ℕ → ℝ) (ε : ℝ) (hε : 0 ≤ ε)
    (ha : ∀ p ∈ P, 0 ≤ a p ∧ a p ≤ ε) (r : ℕ) (Q : Finset (Fin r → ℕ))
    (hQ : ∀ q ∈ Q, Antitone q ∧ ∀ i, q i ∈ P) :
    (∑ q ∈ Q, ∏ i, a (q i)) ≤ ((∑ p ∈ P, a p) + (r : ℝ) * ε) ^ r / (r.factorial : ℝ) :=
by
  classical
  
  have hs3 : ∀ (r : ℕ) (P : Finset ℕ), (∀ p ∈ P, 0 ≤ a p ∧ a p ≤ ε) →
      ((r : ℝ) + 1) * (∑ p ∈ P, a p * ((∑ x ∈ P.filter (fun x => x ≤ p), a x) + (r : ℝ) * ε) ^ r)
        ≤ ((∑ p ∈ P, a p) + ((r : ℝ) + 1) * ε) ^ (r + 1) := by
    intro r P
    induction P using Finset.induction_on_max with
    | h0 =>
      intro _
      simp only [Finset.sum_empty, mul_zero, zero_add]
      positivity
    | step m s hlt ih =>
      intro hP
      have hms : m ∉ s := fun h => lt_irrefl m (hlt m h)
      have hPs : ∀ p ∈ s, 0 ≤ a p ∧ a p ≤ ε := fun p hp => hP p (Finset.mem_insert_of_mem hp)
      have hm := hP m (Finset.mem_insert_self m s)
      have ih' := ih hPs
      have hS0 : 0 ≤ ∑ p ∈ s, a p := Finset.sum_nonneg (fun p hp => (hPs p hp).1)
      have hfm : (insert m s).filter (fun x => x ≤ m) = insert m s := by
        apply Finset.filter_true_of_mem
        intro x hx
        rcases Finset.mem_insert.mp hx with h | h
        · exact h.le
        · exact (hlt x h).le
      have hfp : ∀ p ∈ s, (insert m s).filter (fun x => x ≤ p) = s.filter (fun x => x ≤ p) := by
        intro p hp
        rw [Finset.filter_insert, if_neg (not_le.mpr (hlt p hp))]
      have e1 : ∑ p ∈ insert m s, a p = a m + ∑ p ∈ s, a p := Finset.sum_insert hms
      have e2 : ∑ p ∈ insert m s,
          a p * ((∑ x ∈ (insert m s).filter (fun x => x ≤ p), a x) + (r : ℝ) * ε) ^ r =
          a m * ((a m + ∑ p ∈ s, a p) + (r : ℝ) * ε) ^ r +
            ∑ p ∈ s, a p * ((∑ x ∈ s.filter (fun x => x ≤ p), a x) + (r : ℝ) * ε) ^ r := by
        rw [Finset.sum_insert hms, hfm, e1]
        congr 1
        apply Finset.sum_congr rfl
        intro p hp
        rw [hfp p hp]
      rw [e1, e2]
      set X := ∑ p ∈ s, a p * ((∑ x ∈ s.filter (fun x => x ≤ p), a x) + (r : ℝ) * ε) ^ r with hX
      set S := ∑ p ∈ s, a p with hS
      have hr0 : (0 : ℝ) ≤ r := Nat.cast_nonneg r
      have hy0 : 0 ≤ S + ((r : ℝ) + 1) * ε := by positivity
      have hbase0 : 0 ≤ a m + S + (r : ℝ) * ε := by
        have := mul_nonneg hr0 hε
        linarith [hm.1]
      have hbase : a m + S + (r : ℝ) * ε ≤ S + ((r : ℝ) + 1) * ε := by linarith [hm.2]
      have hpow := pow_le_pow_left₀ hbase0 hbase r
      have hB := pow_add_mul_le_add_pow (a := S + ((r : ℝ) + 1) * ε) (b := a m) hy0
        (by linarith [hm.1]) (r + 1)
      rw [Nat.add_sub_cancel] at hB
      push_cast at hB
      have hprod : ((r : ℝ) + 1) * (a m * (a m + S + (r : ℝ) * ε) ^ r) ≤
          ((r : ℝ) + 1) * (a m * (S + ((r : ℝ) + 1) * ε) ^ r) :=
        mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left hpow hm.1) (by positivity)
      have heq : a m + S + ((r : ℝ) + 1) * ε = S + ((r : ℝ) + 1) * ε + a m := by ring
      rw [heq]
      nlinarith [hB, hprod, ih']
  
  have main : ∀ (r : ℕ) (P : Finset ℕ), (∀ p ∈ P, 0 ≤ a p ∧ a p ≤ ε) →
      ∀ Q : Finset (Fin r → ℕ), (∀ q ∈ Q, Antitone q ∧ ∀ i, q i ∈ P) →
      (∑ q ∈ Q, ∏ i, a (q i)) ≤ ((∑ p ∈ P, a p) + (r : ℝ) * ε) ^ r / (r.factorial : ℝ) := by
    intro r
    induction r with
    | zero =>
      intro P hP Q hQ
      simp only [Finset.univ_eq_empty, Finset.prod_empty, Finset.sum_const, nsmul_eq_mul, mul_one,
        pow_zero, Nat.factorial_zero, Nat.cast_one, div_one]
      exact_mod_cast Finset.card_le_one_of_subsingleton Q
    | succ r ih =>
      intro P hP Q hQ
