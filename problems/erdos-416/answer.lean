theorem normal_preimage_interval_lower : ∀ (N : ℕ), 0 < N → ∀ (x : ℝ) (k : ℕ) (w : ℕ → ℝ) (P : Fin k → Finset ℕ), 1 < x → 20 ≤ logLog x → Real.exp 1 ≤ w 0 → 4 ≤ w 0 → Real.exp (logLog x ^ 36) ≤ w 0 → (∀ idx j, idx ≤ j → j ≤ k → w idx ≤ w j) → w k ≤ x ^ (1 / (20 * logLog x)) → (∀ idx, ∀ p ∈ P idx, SNormal (w 0) p ∧ p ∣ N ∧ w (idx.val + 1) ≤ (p : ℝ)) → ∀ idx : Fin k, ((P idx).card : ℝ) * (logLog (w (idx.val + 1)) - logLog (w idx.val) - 2 * Real.sqrt (logLog (w 0) * logLog (w (idx.val + 1)))) ≤ (omegaInterval N.totient (w idx.val) (w (idx.val + 1)) : ℝ) :=
by
  intro N hN x k w P hx hT hS hS4 hscale hw hcut hP idx
  classical
  
  have hmul : ∀ (m n : ℕ) (u v : ℝ), m ≠ 0 → n ≠ 0 →
      omegaInterval (m * n) u v = omegaInterval m u v + omegaInterval n u v := by
    intro m n u v hm hn
    unfold omegaInterval
    rw [(Nat.perm_primeFactorsList_mul hm hn).countP_eq, List.countP_append]
  have hprod : ∀ (s : Finset ℕ) (u v : ℝ), (∀ p ∈ s, p.Prime) →
      omegaInterval (∏ p ∈ s, (p - 1)) u v = ∑ p ∈ s, omegaInterval (p - 1) u v := by
    intro s u v
    induction s using Finset.induction_on with
    | empty => intro _; simp [omegaInterval]
    | insert a s ha ih =>
      intro hs
      rw [Finset.prod_insert ha, Finset.sum_insert ha]
      have ha2 := (hs a (Finset.mem_insert_self a s)).two_le
      have hs' : ∀ p ∈ s, p.Prime := fun p hp => hs p (Finset.mem_insert_of_mem hp)
      rw [hmul _ _ u v (by omega) (Finset.prod_ne_zero_iff.mpr (fun p hp => by
        have := (hs' p hp).two_le; omega)), ih hs']
  have htot : ∀ (s : Finset ℕ), (∀ p ∈ s, p.Prime) →
      (∏ p ∈ s, p).totient = ∏ p ∈ s, (p - 1) := by
    intro s
    induction s using Finset.induction_on with
    | empty => intro _; simp
    | insert a s ha ih =>
      intro hs
      have hpa := hs a (Finset.mem_insert_self a s)
      have hs' : ∀ p ∈ s, p.Prime := fun p hp => hs p (Finset.mem_insert_of_mem hp)
      have hcop : a.Coprime (∏ p ∈ s, p) := by
        rw [Nat.coprime_prod_right_iff]
        intro q hq
        rw [Nat.Prime.coprime_iff_not_dvd hpa]
        intro hdvd
        rw [Nat.prime_dvd_prime_iff_eq hpa (hs' q hq)] at hdvd
        exact ha (hdvd ▸ hq)
      rw [Finset.prod_insert ha, Finset.prod_insert ha, Nat.totient_mul hcop,
        Nat.totient_prime hpa, ih hs']
  have hmono : ∀ (m n : ℕ) (u v : ℝ), 0 < n → m ∣ n →
      omegaInterval m u v ≤ omegaInterval n u v := by
    intro m n u v hn hmn
    obtain ⟨c, rfl⟩ := hmn
    have hm : m ≠ 0 := by rintro rfl; simp at hn
    have hc : c ≠ 0 := by rintro rfl; simp at hn
    rw [hmul m c u v hm hc]
    omega
  have hs1 : ∀ (Q : Finset ℕ), (∀ p ∈ Q, p.Prime ∧ p ∣ N) → ∀ (u v : ℝ),
      (∑ p ∈ Q, omegaInterval (p - 1) u v) ≤ omegaInterval N.totient u v := by
    intro Q hQ u v
    have hpr : ∀ p ∈ Q, p.Prime := fun p hp => (hQ p hp).1
    have hdvd : (∏ p ∈ Q, p) ∣ N :=
      Finset.prod_primes_dvd N (fun p hp => Nat.prime_iff.mp (hQ p hp).1) (fun p hp => (hQ p hp).2)
    have hdvd2 : (∏ p ∈ Q, (p - 1)) ∣ N.totient := by
      rw [← htot Q hpr]; exact Nat.totient_dvd_of_dvd hdvd
    rw [← hprod Q u v hpr]
    exact hmono _ _ u v (Nat.totient_pos.mpr hN) hdvd2
  
  have hLLmono : ∀ a b : ℝ, 1 < a → a ≤ b → logLog a ≤ logLog b := by
    intro a b ha hab
    unfold logLog
    exact Real.log_le_log (Real.log_pos ha) (Real.log_le_log (by linarith) hab)
  have hl2 : 0 < Real.log 2 := Real.log_pos one_lt_two
  have hhalf : ∀ v : ℝ, 4 ≤ v → logLog v - logLog (v / 2) ≤ Real.log 2 := by
    intro v hv
    unfold logLog
    have hl4 : Real.log 4 = 2 * Real.log 2 := by
      rw [show (4:ℝ) = 2 ^ 2 by norm_num, Real.log_pow]; norm_num
    have hlv : 2 * Real.log 2 ≤ Real.log v := by
      rw [← hl4]; exact Real.log_le_log (by norm_num) hv
    have hlv2 : Real.log (v / 2) = Real.log v - Real.log 2 :=
      Real.log_div (ne_of_gt (by linarith)) (by norm_num)
    have hpos : 0 < Real.log v / 2 := by linarith
    have hle : Real.log v / 2 ≤ Real.log (v / 2) := by rw [hlv2]; linarith
    have h1 := Real.log_le_log hpos hle
    rw [Real.log_div (ne_of_gt (by linarith)) (by norm_num)] at h1
    linarith
  have hs2 : ∀ (S u v : ℝ) (p : ℕ), 4 ≤ S → Real.log 2 ≤ logLog S → S ≤ u → u ≤ v →
      v ≤ (p : ℝ) → SNormal S p →
      logLog v - logLog u - 2 * Real.sqrt (logLog S * logLog v) ≤
        (omegaInterval (p - 1) u v : ℝ) := by
    intro S u v p hS4' hL2 hSu huv hvp hSN
    have hL0 : 0 ≤ logLog S := by linarith
    have hLv : logLog S ≤ logLog v := hLLmono S v (by linarith) (by linarith)
    have hρ : logLog S ≤ Real.sqrt (logLog S * logLog v) := by
      apply Real.le_sqrt_of_sq_le
      nlinarith
    have hhv := hhalf v (by linarith)
    have hω0 : (0:ℝ) ≤ (omegaInterval (p - 1) u v : ℝ) := Nat.cast_nonneg _
    by_cases hcase : v / 2 ≤ u
    · have := hLLmono (v / 2) u (by linarith) hcase
      linarith
    · push_neg at hcase
      have hp2 := hSN.1.two_le
      have hcast : ((p - 1 : ℕ) : ℝ) = (p : ℝ) - 1 := by
        rw [Nat.cast_sub (by omega), Nat.cast_one]
      have hp2r : (2:ℝ) ≤ p := by exact_mod_cast hp2
      have hv' : v / 2 ≤ ((p - 1 : ℕ) : ℝ) := by rw [hcast]; linarith
      have key := hSN.2.2 u (v / 2) hSu hcase hv'
      have key' : -Real.sqrt (logLog S * logLog (v / 2)) <
          (omegaInterval (p - 1) u (v / 2) : ℝ) - (logLog (v / 2) - logLog u) := by
        have := (abs_lt.mp key).1
        unfold logLog; linarith
      have hsq : Real.sqrt (logLog S * logLog (v / 2)) ≤ Real.sqrt (logLog S * logLog v) := by
        apply Real.sqrt_le_sqrt
        exact mul_le_mul_of_nonneg_left (hLLmono (v / 2) v (by linarith) (by linarith)) hL0
      have hmon : omegaInterval (p - 1) u (v / 2) ≤ omegaInterval (p - 1) u v := by
        unfold omegaInterval
        apply List.countP_mono_left
        intro q _ hq
        simp only [decide_eq_true_eq] at hq ⊢
        exact ⟨hq.1, by linarith [hq.2]⟩
      have hmonR : (omegaInterval (p - 1) u (v / 2) : ℝ) ≤ (omegaInterval (p - 1) u v : ℝ) := by
        exact_mod_cast hmon
      linarith
  
  have hSu : w 0 ≤ w idx.val := hw 0 idx.val (Nat.zero_le _) idx.isLt.le
  have huv : w idx.val ≤ w (idx.val + 1) := hw idx.val (idx.val + 1) (Nat.le_succ _) idx.isLt
  have hL2 : Real.log 2 ≤ logLog (w 0) := by
    have h1 : logLog x ^ 36 ≤ Real.log (w 0) := by
      have := Real.log_le_log (Real.exp_pos _) hscale
      rwa [Real.log_exp] at this
    have h2 : (2:ℝ) ≤ logLog x ^ 36 := by
      have : (20:ℝ) ^ 36 ≤ logLog x ^ 36 := pow_le_pow_left₀ (by norm_num) hT 36
      have h20 : (2:ℝ) ≤ 20 ^ 36 := by norm_num
      linarith
    unfold logLog
    exact Real.log_le_log two_pos (by linarith)
  have hper : ∀ p ∈ P idx, (logLog (w (idx.val + 1)) - logLog (w idx.val) -
      2 * Real.sqrt (logLog (w 0) * logLog (w (idx.val + 1)))) ≤
        (omegaInterval (p - 1) (w idx.val) (w (idx.val + 1)) : ℝ) :=
    fun p hp => hs2 (w 0) _ _ p hS4 hL2 hSu huv (hP idx p hp).2.2 (hP idx p hp).1
  have hsum := Finset.sum_le_sum hper
  rw [Finset.sum_const, nsmul_eq_mul] at hsum
  have h1 := hs1 (P idx) (fun p hp => ⟨(hP idx p hp).1.1, (hP idx p hp).2.1⟩)
    (w idx.val) (w (idx.val + 1))
  have h1R : ((∑ p ∈ P idx, omegaInterval (p - 1) (w idx.val) (w (idx.val + 1)) : ℕ) : ℝ) ≤
      (omegaInterval N.totient (w idx.val) (w (idx.val + 1)) : ℝ) := by
    exact_mod_cast h1
  push_cast at h1R
  linarith

theorem facet_grid_prefix_witness : ∀ (k : ℕ) (c : Fin k → ℝ) (T h S F ω σ : ℝ), 0 < T → 0 < h → 0 < ω → 0 ≤ σ → Real.exp 1 < S → S ≤ F → logLog F ≤ T + 1 → (∀ i, 0 ≤ c i ∧ c i ≤ 2) → (∀ i i' : Fin k, i ≤ i' → c i' ≤ c i) → (∀ i, c i * T ≤ T + 1) → 1 + ω ≤ ∑ i : Fin k, fordWeight (i.val + 1) * c i → (∑ i : Fin k, fordWeight (i.val + 1)) * (h * T + logLog S + T + 1 - logLog F) ≤ (ω - σ) * T → ∃ (j : ℕ) (hjk : j ≤ k) (u : Fin k → Fin (⌊2 / h⌋₊ + 1)), 0 < j ∧ (∀ i i' : Fin k, i ≤ i' → ((u i' : ℕ) : ℝ) ≤ ((u i : ℕ) : ℝ)) ∧ (∀ i : Fin j, 0 < h * ((u (Fin.castLE hjk i) : ℕ) : ℝ) ∧ h * ((u (Fin.castLE hjk i) : ℕ) : ℝ) ≤ c (Fin.castLE hjk i) ∧ S ≤ Real.exp (Real.exp (h * ((u (Fin.castLE hjk i) : ℕ) : ℝ) * T))) ∧ (1 + σ) * T ≤ ∑ i : Fin j, fordWeight (i.val + 1) * logLog (min F (Real.exp (Real.exp (h * ((u (Fin.castLE hjk i) : ℕ) : ℝ) * T)))) :=
by
  intro k c T h S F ω σ hT hh hω hσ hS hSF hFlog hc hcanti hcT hfacet hloss
  classical
  
  have hfw : ∀ n : ℕ, 1 ≤ n → 0 ≤ fordWeight n := by
    intro n hn
    have hi1 : (1 : ℝ) ≤ n := by exact_mod_cast hn
    have hi0 : (0 : ℝ) < n := by linarith
    have hip : (0 : ℝ) < (n : ℝ) + 1 := by positivity
    have hlow := Real.one_sub_inv_le_log_of_pos (div_pos hip hi0)
    rw [Real.log_div hip.ne' hi0.ne', inv_div] at hlow
    have hl := mul_le_mul_of_nonneg_left hlow hip.le
    have hid₁ : ((n : ℝ) + 1) * (1 - (n : ℝ) / ((n : ℝ) + 1)) = 1 := by
      field_simp
      ring
    rw [hid₁] at hl
    unfold fordWeight
    nlinarith [Real.log_nonneg hi1]
  set a : Fin k → ℝ := fun i => fordWeight (i.val + 1) with ha_def
  have ha : ∀ i, 0 ≤ a i := fun i => hfw _ (by omega)
  set A : ℝ := ∑ i : Fin k, a i with hA_def
  have hA : 0 ≤ A := Finset.sum_nonneg (fun i _ => ha i)
  
  have he1 : 1 < Real.exp 1 := Real.one_lt_exp_iff.mpr one_pos
  have hS1 : 1 < S := lt_trans he1 hS
  have hF1 : 1 < F := lt_of_lt_of_le hS1 hSF
  have hlogS : 1 < Real.log S := by
    have := Real.log_lt_log (Real.exp_pos 1) hS
    rwa [Real.log_exp] at this
  have hR : 0 < logLog S := Real.log_pos hlogS
  have hRT : 0 < logLog S / T := div_pos hR hT
  
  set s : ℝ := ∑ i : Fin k, a i * c i with hs_def
  have hs : 0 < s := lt_of_lt_of_le (by linarith) hfacet
  set κ : ℝ := (1 + ω) / s with hκ_def
  have hκ : 0 < κ := div_pos (by linarith) hs
  have hκ1 : κ ≤ 1 := (div_le_one hs).mpr hfacet
  set y : Fin k → ℝ := fun i => κ * c i with hy_def
  have hy0 : ∀ i, 0 ≤ y i := fun i => mul_nonneg hκ.le (hc i).1
  have hyc : ∀ i, y i ≤ c i := fun i => by
    have := (hc i).1
    show κ * c i ≤ c i
    nlinarith
  have hy2 : ∀ i, y i ≤ 2 := fun i => (hyc i).trans (hc i).2
  have hyanti : ∀ i i' : Fin k, i ≤ i' → y i' ≤ y i := fun i i' hii' =>
    mul_le_mul_of_nonneg_left (hcanti i i' hii') hκ.le
  have hysum : ∑ i : Fin k, a i * y i = 1 + ω := by
    calc ∑ i : Fin k, a i * y i = κ * s := by
          rw [hs_def, Finset.mul_sum]
          apply Finset.sum_congr rfl
          intro i _
          simp only [hy_def]
          ring
      _ = 1 + ω := div_mul_cancel₀ (1 + ω) hs.ne'
  let u : Fin k → Fin (⌊2 / h⌋₊ + 1) := fun i =>
    ⟨⌊y i / h⌋₊, Nat.lt_succ_of_le (Nat.floor_mono (div_le_div_of_nonneg_right (hy2 i) hh.le))⟩
  have hu_val : ∀ i, ((u i : ℕ) : ℝ) = ((⌊y i / h⌋₊ : ℕ) : ℝ) := fun i => rfl
  have hfl : ∀ i, h * ((u i : ℕ) : ℝ) ≤ y i ∧ y i - h ≤ h * ((u i : ℕ) : ℝ) := by
    intro i
    rw [hu_val]
    have hf := Nat.floor_le (div_nonneg (hy0 i) hh.le)
    have hg := Nat.lt_floor_add_one (y i / h)
    have hmul := mul_le_mul_of_nonneg_left hf hh.le
    have hmul' := mul_lt_mul_of_pos_left hg hh
    have hcc : h * (y i / h) = y i := by field_simp
    rw [hcc] at hmul hmul'
    exact ⟨hmul, by nlinarith⟩
  have hu_anti : ∀ i i' : Fin k, i ≤ i' → ((u i' : ℕ) : ℝ) ≤ ((u i : ℕ) : ℝ) := by
    intro i i' hii'
    rw [hu_val, hu_val]
    exact Nat.cast_le.mpr (Nat.floor_mono (div_le_div_of_nonneg_right (hyanti i i' hii') hh.le))
  set θ : Fin k → ℝ := fun i => h * ((u i : ℕ) : ℝ) with hθ_def
  have hθc : ∀ i, θ i ≤ c i := fun i => (hfl i).1.trans (hyc i)
  have hθanti : ∀ i i' : Fin k, i ≤ i' → θ i' ≤ θ i := fun i i' hii' =>
    mul_le_mul_of_nonneg_left (hu_anti i i' hii') hh.le
  have hsum : 1 + ω - h * A ≤ ∑ i : Fin k, a i * θ i := by
    calc 1 + ω - h * A = ∑ i : Fin k, a i * (y i - h) := by
          rw [← hysum, hA_def, Finset.mul_sum, ← Finset.sum_sub_distrib]
          apply Finset.sum_congr rfl
          intro i _
          ring
      _ ≤ ∑ i : Fin k, a i * θ i :=
          Finset.sum_le_sum fun i _ => mul_le_mul_of_nonneg_left (hfl i).2 (ha i)
  
  obtain ⟨j, hjk, hprefix⟩ : ∃ j : ℕ, j ≤ k ∧ ∀ i : Fin k, logLog S / T ≤ θ i ↔ i.val < j := by
    let P : ℕ → Prop := fun j => j = k ∨ ∃ hj : j < k, θ ⟨j, hj⟩ < logLog S / T
    have hex : ∃ j, P j := ⟨k, Or.inl rfl⟩
    refine ⟨Nat.find hex, Nat.find_min' hex (Or.inl rfl), ?_⟩
    intro i
    constructor
    · intro hi
      by_contra hij
      have hji : Nat.find hex ≤ i.val := by omega
      rcases Nat.find_spec hex with hj | ⟨hj, hlow⟩
      · have := i.isLt
        omega
      · have hiθ : θ i ≤ θ ⟨Nat.find hex, hj⟩ :=
          hθanti _ _ (Fin.le_iff_val_le_val.mpr hji)
        linarith
    · intro hij
      have hnot : ¬P i.val := Nat.find_min hex hij
      by_contra hlow
      exact hnot (Or.inr ⟨i.isLt, lt_of_not_ge hlow⟩)
  
  have hcap : ∀ z : ℝ, logLog (min F (Real.exp (Real.exp z))) = min (logLog F) z := by
    intro z
    have hez : logLog (Real.exp (Real.exp z)) = z := by
      simp only [logLog, Real.log_exp]
    have he1z : 1 < Real.exp (Real.exp z) := Real.one_lt_exp_iff.mpr (Real.exp_pos _)
    rcases le_total F (Real.exp (Real.exp z)) with hle | hle
    · rw [min_eq_left hle]
      have hmono : logLog F ≤ logLog (Real.exp (Real.exp z)) :=
        Real.log_le_log (Real.log_pos hF1) (Real.log_le_log (by linarith) hle)
      rw [hez] at hmono
      rw [min_eq_left hmono]
    · rw [min_eq_right hle]
      have hmono : logLog (Real.exp (Real.exp z)) ≤ logLog F :=
        Real.log_le_log (Real.log_pos he1z) (Real.log_le_log (by linarith) hle)
      rw [hez] at hmono ⊢
      rw [min_eq_right hmono]
  have hθX : ∀ i, θ i * T ≤ T + 1 := fun i =>
    (mul_le_mul_of_nonneg_right (hθc i) hT.le).trans (hcT i)
  set RHS : ℝ := ∑ i : Fin j, fordWeight (i.val + 1) * logLog (min F (Real.exp (Real.exp (h * ((u (Fin.castLE hjk i) : ℕ) : ℝ) * T)))) with hRHS_def
  have hreindex : RHS = ∑ i : Fin k,
      if i.val < j then a i * min (logLog F) (θ i * T) else 0 := by
    rw [hRHS_def]
    calc _ = ∑ i : Fin j, (fun i : Fin k => a i * min (logLog F) (θ i * T)) (Fin.castLE hjk i) := by
          apply Finset.sum_congr rfl
          intro i _
          simp only [hθ_def, ha_def, hcap]
          rfl
      _ = ∑ i ∈ Finset.univ.filter (fun i : Fin k => i.val < j),
            a i * min (logLog F) (θ i * T) := by
          apply Finset.sum_bij (fun i (_ : i ∈ Finset.univ) => Fin.castLE hjk i)
          · intro i _
            exact Finset.mem_filter.mpr ⟨Finset.mem_univ _, i.isLt⟩
          · intro i _ l _ hil
            exact Fin.ext (congrArg (fun z : Fin k => z.val) hil)
          · intro i hi
            refine ⟨⟨i.val, (Finset.mem_filter.mp hi).2⟩, Finset.mem_univ _, ?_⟩
            exact Fin.ext rfl
          · intro i _
            rfl
      _ = _ := Finset.sum_filter _ _
  have hret : (∑ i : Fin k, a i * θ i) * T - (logLog S + (T + 1) - logLog F) * A ≤ RHS := by
    rw [hreindex, Finset.sum_mul, hA_def, Finset.mul_sum, ← Finset.sum_sub_distrib]
    apply Finset.sum_le_sum
    intro i _
    have hai := ha i
    have hXL : 0 ≤ T + 1 - logLog F := by linarith
    split_ifs with hi
    · have hmin : θ i * T - (T + 1 - logLog F) ≤ min (logLog F) (θ i * T) :=
        le_min (by linarith [hθX i]) (by linarith)
      have h1 := mul_le_mul_of_nonneg_left hmin hai
      nlinarith [mul_nonneg hR.le hai]
    · have hlow : θ i < logLog S / T := lt_of_not_ge (fun hh' => hi ((hprefix i).mp hh'))
      have hlowT : θ i * T < logLog S := by
        have := (lt_div_iff₀ hT).mp hlow
        linarith
      nlinarith [mul_le_mul_of_nonneg_left hlowT.le hai, mul_nonneg hXL hai]
  
  have hsumT := mul_le_mul_of_nonneg_right hsum hT.le
  have hfinal : (1 + σ) * T ≤ RHS := by
    nlinarith [hret, hsumT, hloss]
  
  have hj0 : 0 < j := by
    rcases Nat.eq_zero_or_pos j with hj | hj
    · exfalso
      subst hj
      have hR0 : RHS = 0 := by
        rw [hRHS_def]
        simp
      have : 0 < (1 + σ) * T := mul_pos (by linarith) hT
      linarith
    · exact hj
  
  refine ⟨j, hjk, u, hj0, hu_anti, fun i => ?_, hfinal⟩
  have hcut : logLog S / T ≤ θ (Fin.castLE hjk i) := (hprefix _).mpr i.isLt
  refine ⟨hRT.trans_le hcut, hθc _, ?_⟩
  have hRle : logLog S ≤ θ (Fin.castLE hjk i) * T := (div_le_iff₀ hT).mp hcut
  have hSeq : Real.exp (Real.exp (logLog S)) = S := by
    unfold logLog
    rw [Real.exp_log (by linarith), Real.exp_log (by linarith)]
  calc S = Real.exp (Real.exp (logLog S)) := hSeq.symm
    _ ≤ Real.exp (Real.exp (θ (Fin.castLE hjk i) * T)) :=
        Real.exp_le_exp.mpr (Real.exp_le_exp.mpr hRle)

theorem ordinary_prime_prefix_distinct : ∀ (N j : ℕ) (S : ℝ), 0 < N → 2 ≤ S → NoLargePrimeSquare N (S / 2) → S ≤ (FordBadFacet.ordinaryPrimeAt N j : ℝ) → Function.Injective (fun a : Fin (j + 1) => FordBadFacet.ordinaryPrimeAt N a.val) ∧ (∀ a b : ℕ, a ≤ b → FordBadFacet.ordinaryPrimeAt N b ≤ FordBadFacet.ordinaryPrimeAt N a) ∧ ∀ a : ℕ, a ≤ j → (FordBadFacet.ordinaryPrimeAt N a).Prime ∧ FordBadFacet.ordinaryPrimeAt N a ∣ N :=
by
  intro N j S hN hS hNLS hSj
  have hone : ∀ idx : ℕ, 1 ≤ FordBadFacet.ordinaryPrimeAt N idx := by
    intro idx
    show 1 ≤ (N.primeFactorsList.reverse).getD idx 1
    by_cases hi : idx < (N.primeFactorsList.reverse).length
    · rw [List.getD_eq_getElem _ 1 hi]
      have hm : (N.primeFactorsList.reverse)[idx] ∈ N.primeFactorsList :=
        List.mem_reverse.mp (List.getElem_mem hi)
      exact (Nat.prime_of_mem_primeFactorsList hm).one_le
    · rw [List.getD_eq_default _ _ (by omega)]
  have hantiP : Antitone (FordBadFacet.ordinaryPrimeAt N) := by
    intro i j' hij
    have hs : (N.primeFactorsList.reverse).SortedGE := (Nat.primeFactorsList_sorted N).reverse
    by_cases hj : j' < (N.primeFactorsList.reverse).length
    · have hi : i < (N.primeFactorsList.reverse).length := lt_of_le_of_lt hij hj
      show (N.primeFactorsList.reverse).getD j' 1 ≤ (N.primeFactorsList.reverse).getD i 1
      rw [List.getD_eq_getElem _ 1 hi, List.getD_eq_getElem _ 1 hj]
      exact hs.antitone_get hij
    · have h1 : FordBadFacet.ordinaryPrimeAt N j' = 1 := by
        show (N.primeFactorsList.reverse).getD j' 1 = 1
        exact List.getD_eq_default _ _ (by omega)
      rw [h1]; exact hone i
  have hlen : j < (N.primeFactorsList.reverse).length := by
    by_contra hcon
    have h1 : FordBadFacet.ordinaryPrimeAt N j = 1 := by
      show (N.primeFactorsList.reverse).getD j 1 = 1
      exact List.getD_eq_default _ _ (by omega)
    rw [h1, Nat.cast_one] at hSj
    linarith
  have hge : ∀ a, a ≤ j → S ≤ (FordBadFacet.ordinaryPrimeAt N a : ℝ) := by
    intro a ha
    exact hSj.trans (by exact_mod_cast hantiP ha)
  have hmemL : ∀ a, a < (N.primeFactorsList.reverse).length →
      FordBadFacet.ordinaryPrimeAt N a ∈ N.primeFactorsList := by
    intro a ha
    show (N.primeFactorsList.reverse).getD a 1 ∈ N.primeFactorsList
    rw [List.getD_eq_getElem _ 1 ha]
    exact List.mem_reverse.mp (List.getElem_mem ha)
  have hC : ∀ a, a ≤ j → (FordBadFacet.ordinaryPrimeAt N a).Prime ∧
      FordBadFacet.ordinaryPrimeAt N a ∣ N := by
    intro a ha
    have hm := hmemL a (by omega)
    exact ⟨Nat.prime_of_mem_primeFactorsList hm, Nat.dvd_of_mem_primeFactorsList hm⟩
  have hsq : ∀ a b, a < b → b < (N.primeFactorsList.reverse).length →
      FordBadFacet.ordinaryPrimeAt N a = FordBadFacet.ordinaryPrimeAt N b →
      FordBadFacet.ordinaryPrimeAt N a ^ 2 ∣ N := by
    intro a b hab hb heq
    have ha : a < (N.primeFactorsList.reverse).length := by omega
    have hqa : FordBadFacet.ordinaryPrimeAt N a = (N.primeFactorsList.reverse)[a] :=
      List.getD_eq_getElem _ 1 ha
    have hqb : FordBadFacet.ordinaryPrimeAt N b = (N.primeFactorsList.reverse)[b] :=
      List.getD_eq_getElem _ 1 hb
    have hm1 : FordBadFacet.ordinaryPrimeAt N a ∈ (N.primeFactorsList.reverse).take (a + 1) := by
      rw [hqa]
      have hlt : a < ((N.primeFactorsList.reverse).take (a + 1)).length := by
        rw [List.length_take]; omega
      refine List.mem_iff_getElem.mpr ⟨a, hlt, ?_⟩
      rw [List.getElem_take]
    have hm2 : FordBadFacet.ordinaryPrimeAt N a ∈ (N.primeFactorsList.reverse).drop (a + 1) := by
      rw [heq, hqb]
      have hlt : b - (a + 1) < ((N.primeFactorsList.reverse).drop (a + 1)).length := by
        rw [List.length_drop]; omega
      refine List.mem_iff_getElem.mpr ⟨b - (a + 1), hlt, ?_⟩
      have e : a + 1 + (b - (a + 1)) = b := by omega
      rw [List.getElem_drop]
      simp only [e]
    have hcount : 2 ≤ (N.primeFactorsList.reverse).count (FordBadFacet.ordinaryPrimeAt N a) := by
      rw [← List.take_append_drop (a + 1) (N.primeFactorsList.reverse), List.count_append]
      have c1 := List.count_pos_iff.mpr hm1
      have c2 := List.count_pos_iff.mpr hm2
      omega
    rw [List.count_reverse, Nat.primeFactorsList_count_eq] at hcount
    have hpp : (FordBadFacet.ordinaryPrimeAt N a).Prime :=
      Nat.prime_of_mem_primeFactorsList (hmemL a ha)
    exact (Nat.Prime.pow_dvd_iff_le_factorization hpp hN.ne').mpr hcount
  refine ⟨?_, fun a b hab => hantiP hab, hC⟩
  intro a b hab
  simp only at hab
  apply Fin.ext
  by_contra hne
  have haj : a.val ≤ j := Nat.lt_succ_iff.mp a.isLt
  have hbj : b.val ≤ j := Nat.lt_succ_iff.mp b.isLt
  rcases Nat.lt_or_gt_of_ne hne with h | h
  · have hsq' := hsq a.val b.val h (by omega) hab
    have hpr := (hC a.val haj).1
    have hg := hge a.val haj
    exact hNLS _ hpr (by linarith) hsq'
  · have hsq' := hsq b.val a.val h (by omega) hab.symm
    have hpr := (hC b.val hbj).1
    have hg := hge b.val hbj
    exact hNLS _ hpr (by linarith) hsq'

theorem ordinary_coordinate_bounds : ∀ (N : ℕ) (x : ℝ), 0 < N → 2 ≤ x → 1 ≤ logLog x → (N.totient : ℝ) ≤ x → (∀ i : ℕ, 0 ≤ FordBadFacet.ordinaryPrimeCoordinate (logLog x) N i ∧ FordBadFacet.ordinaryPrimeCoordinate (logLog x) N i ≤ 2 ∧ FordBadFacet.ordinaryPrimeCoordinate (logLog x) N i * logLog x ≤ logLog x + 1) ∧ (∀ i i' : ℕ, i ≤ i' → FordBadFacet.ordinaryPrimeCoordinate (logLog x) N i' ≤ FordBadFacet.ordinaryPrimeCoordinate (logLog x) N i) ∧ (∀ (i : ℕ) (θ : ℝ), 0 < θ → θ ≤ FordBadFacet.ordinaryPrimeCoordinate (logLog x) N i → Real.exp (Real.exp (θ * logLog x)) ≤ (FordBadFacet.ordinaryPrimeAt N i : ℝ)) :=
by
  intro N x hN hx hT hphi
  classical
  have hT0 : 0 < logLog x := by linarith
  have hx0 : 0 < x := by linarith
  have hlogx : 0 < Real.log x := Real.log_pos (by linarith)
  have hT' : 1 ≤ Real.log (Real.log x) := hT
  
  have hplm : ∀ a b : ℝ, 1 ≤ a → a ≤ b →
      FordBadFacet.positiveLogLog a ≤ FordBadFacet.positiveLogLog b := by
    intro a b ha hab
    unfold FordBadFacet.positiveLogLog logLog
    rcases eq_or_lt_of_le ha with h | h
    · rw [← h]
      simp only [Real.log_one, Real.log_zero, max_self]
      exact le_max_left _ _
    · apply max_le_max_left
      have hla : 0 < Real.log a := Real.log_pos h
      exact Real.log_le_log hla (Real.log_le_log (by linarith) hab)
  
  have hone : ∀ idx : ℕ, 1 ≤ FordBadFacet.ordinaryPrimeAt N idx := by
    intro idx
