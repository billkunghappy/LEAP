theorem primeProducts_count_lower_uniform (hPNT : Tendsto (fun x : ℝ => (Nat.primeCounting ⌊x⌋₊ : ℝ) / (x / Real.log x)) atTop (𝓝 1)) :
    ∀ᶠ y : ℝ in atTop, ∀ F : Finset ℕ, (∀ n ∈ F, 0 < n) →
      (∀ n ∈ F, (n : ℝ) ≤ y ^ (1 / 40 : ℝ)) →
      (∀ n ∈ F, Real.log (n : ℝ) ≤ (4 * Real.log (logLog y) / logLog y) * Real.exp (logLog y)) →
      (y / (2 * Real.log y)) * (∑ n ∈ F, invTotient n) ≤ ((FordLower.primeProducts F y).card : ℝ) :=
by
  classical
  have hLL : Tendsto logLog atTop atTop := Real.tendsto_log_atTop.comp Real.tendsto_log_atTop
  
  have hpc : ∀ k : ℕ, (Nat.primeCounting k : ℝ) = (((Finset.Iic k).filter Nat.Prime).card : ℝ) := by
    intro k
    rw [Nat.primeCounting.eq_1, ← Nat.primesBelow_card_eq_primeCounting', Nat.primesBelow.eq_1,
      Nat.range_succ_eq_Iic]
  
  obtain ⟨x₀, hx₀⟩ := Filter.eventually_atTop.mp
    ((hPNT.eventually (lt_mem_nhds (by norm_num : (9 / 10 : ℝ) < 1))).and
      ((hPNT.eventually (gt_mem_nhds (by norm_num : (1 : ℝ) < 11 / 10))).and
        (eventually_gt_atTop (1 : ℝ))))
  have hwin : ∀ y c X : ℝ, 1 < y → x₀ ≤ y ^ (1 / 2 : ℝ) → 0 ≤ c → c ≤ 1 / 11 →
