    ∀ n : ℕ, |FordAnalysis.g n * FordAnalysis.rho ^ n -
      1 / (FordAnalysis.rho * deriv FordAnalysis.F FordAnalysis.rho)| ≤ 5 * FordAnalysis.rho ^ n :=
by
  
  have ford_coeff_bounds : ∀ n : ℕ, 0 ≤ FordAnalysis.coeff n ∧ FordAnalysis.coeff n ≤ (n : ℝ) := by
    clear hlam hRHO hρ
    intro n
