    have hgap := hx.1.2.1 idx j hij
    have hξi := hξ (idx.val + 1)
    have hxi := mul_le_mul_of_nonneg_left (hxe idx) hξi.1.le
    have hzτ := mul_le_mul_of_nonneg_right hξi.2 hτ
    have hRτ := mul_le_mul_of_nonneg_left (hR2 (L - (idx.val + 1))) hτ
    have hmi := (hm idx).2
    have hej := hhi j
    rw [hF1 _ hi]
    show x j + e j ≤ (FordInner.tightParameter L M (idx.val + 1) +
      FordInner.extraLoss (L - (idx.val + 1))) * (x idx + e idx)
    linarith
  
  have hyAnti : Antitone (x + e) := antiAdj (x + e) (fun idx j hij =>
    (hyGap idx j hij).trans (mul_le_of_le_one_left (hm idx).1 (hF2 _)))
  
  have hgap0 : FordInner.targetParameter L M 0 =
      FordInner.tightParameter L M 0 + FordInner.extraLoss L := by
    have h := hF1 0 (by omega)
    rw [Nat.sub_zero] at h
    exact h
  have hτδ : τ ≤ FordInner.extraLoss L := by
    have h := mul_le_mul_of_nonneg_left (hR2 L) hτ
    linarith
  have hyTop : ∀ k : Fin L, k.val = 0 → (x + e) k ≤ FordInner.targetParameter L M 0 := by
    intro k hk
    have h1 := hx.2 k hk
    have h2 := hhi k
