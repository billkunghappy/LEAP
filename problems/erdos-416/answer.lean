    mul_le_mul_of_nonneg_right hsumle hVnn
  have hVbound : MeasureTheory.volume.real (FordOrder.unordered L) ≤
      FordGeometry.T L + (1 / 22) * MeasureTheory.volume.real (FordOrder.unordered L) +
        (10 / 11) * MeasureTheory.volume.real (FordOrder.unordered L) := by
    refine (MeasureTheory.measureReal_mono hcover.2 ?_).trans ?_
    · exact ne_top_of_le_ne_top hUfin (MeasureTheory.measure_mono
        (Set.union_subset (Set.union_subset hcover.1 (fun x hx => hx.1))
          (Set.iUnion₂_subset (fun p _ x hx => hx.1))))
    · refine (MeasureTheory.measureReal_union_le _ _).trans ?_
      refine add_le_add ((MeasureTheory.measureReal_union_le _ _).trans ?_)
        ((MeasureTheory.measureReal_biUnion_finset_le _ _).trans ?_)
      · exact add_le_add le_rfl (htop.trans e1)
      · refine (Finset.sum_le_sum hadj).trans ?_
        rw [← Finset.sum_mul]
        exact e2
  rw [hmV]
  linarith

theorem core_scaled_prefix_bound (hPNT : Tendsto (fun x : ℝ => (Nat.primeCounting ⌊x⌋₊ : ℝ) / (x / Real.log x)) atTop (𝓝 1))
    (hMERT : ∃ C : ℝ, ∀ x : ℝ, 2 ≤ x →
      |(∑ p ∈ (Finset.Iic ⌊x⌋₊).filter Nat.Prime, (1 : ℝ) / p) - Real.log (Real.log x)| ≤ C)
    (hEULER : Asymptotics.IsEquivalent atTop
      (fun x : ℝ => ∏ p ∈ (Finset.Iic ⌊x⌋₊).filter Nat.Prime, (1 - (1 : ℝ) / p))
      (fun x => Real.exp (-Real.eulerMascheroniConstant) / Real.log x))
    (hRHO : 0 < FordAnalysis.rho ∧ FordAnalysis.rho < 3 / 4 ∧ FordAnalysis.F FordAnalysis.rho = 1)
    (M : ℕ) {t : ℝ} (ht : Real.exp 1 ≤ t)
    (hadd : FordScale.coreDimension M t + M = FordScale.optimalDimension t) {K : ℕ}
    (hK : K ≤ FordScale.coreDimension M t) :
    t ^ K * FordGeometry.modelVolume K ≤
      (4 * FordAnalysis.rho ^ M) ^ (FordScale.coreDimension M t - K) *
        (t ^ (FordScale.coreDimension M t) * FordGeometry.modelVolume (FordScale.coreDimension M t)) :=
by
  obtain ⟨hρ0, hρ34, hF⟩ := hRHO
  have hρ1 : FordAnalysis.rho < 1 := hρ34.trans (by norm_num)
  set ρ := FordAnalysis.rho with hρdef
  
  have hc0 : FordAnalysis.coeff 0 = 0 := by simp [FordAnalysis.coeff]
  have hc1eq : FordAnalysis.coeff 1 = 2 * Real.log 2 - 1 := by
    simp only [FordAnalysis.coeff, fordWeight, one_ne_zero, if_false, Nat.cast_one,
      Real.log_one, mul_zero, sub_zero]
    norm_num
  have hc1pos : 0 < FordAnalysis.coeff 1 := by
    rw [hc1eq]; have := Real.log_two_gt_d9; linarith
  have hc1lt : FordAnalysis.coeff 1 < 1 := by
    rw [hc1eq]; have := Real.log_two_lt_d9; linarith
  have hmono : ∀ k : ℕ, FordAnalysis.coeff k ≤ FordAnalysis.coeff (k + 1) := by
    intro k
    rcases Nat.eq_zero_or_pos k with hk | hk
    · subst hk; rw [hc0]; exact hc1pos.le
    · have hk1 : k ≠ 0 := by omega
      simp only [FordAnalysis.coeff, hk1, Nat.succ_ne_zero, if_false, fordWeight]
      push_cast
      set x : ℝ := (k : ℝ) with hx
      have hx1 : (1 : ℝ) ≤ x := by rw [hx]; exact_mod_cast hk
      have hx0 : (0 : ℝ) < x := by linarith
      have h1 : Real.log ((x + 1) / (x + 1 + 1)) ≤ (x + 1) / (x + 1 + 1) - 1 :=
        Real.log_le_sub_one_of_pos (by positivity)
      rw [Real.log_div (by positivity) (by positivity)] at h1
      have h1' : (x + 1 + 1) * (Real.log (x + 1) - Real.log (x + 1 + 1)) ≤ -1 := by
        have := mul_le_mul_of_nonneg_left h1 (by positivity : (0 : ℝ) ≤ x + 1 + 1)
        have he : (x + 1 + 1) * ((x + 1) / (x + 1 + 1) - 1) = -1 := by
          field_simp; ring
        linarith
      have h2 : Real.log ((x + 1) / x) ≤ (x + 1) / x - 1 :=
        Real.log_le_sub_one_of_pos (by positivity)
      rw [Real.log_div (by positivity) (by positivity)] at h2
      have h2' : x * (Real.log (x + 1) - Real.log x) ≤ 1 := by
        have := mul_le_mul_of_nonneg_left h2 hx0.le
        have he : x * ((x + 1) / x - 1) = 1 := by
          field_simp; ring
        linarith
      nlinarith [h1', h2']
  have hnn : ∀ k : ℕ, 0 ≤ FordAnalysis.coeff k := by
    intro k
    induction k with
    | zero => rw [hc0]
    | succ k ih => exact ih.trans (hmono k)
  
  have hg0 : FordAnalysis.g 0 = 1 := by rw [FordAnalysis.g]
  have hgs : ∀ n, FordAnalysis.g (n + 1) = ∑ idx ∈ Finset.range (n + 1),
      FordAnalysis.coeff (idx + 1) * FordAnalysis.g (n - idx) := fun n => by rw [FordAnalysis.g]
  have hgS0 : FordAnalysis.gStar 0 = 1 := by rw [FordAnalysis.gStar]
  have hgSs : ∀ n, FordAnalysis.gStar (n + 1) =
      FordAnalysis.g (n + 1) + (1 - FordAnalysis.coeff 1) * FordAnalysis.g n :=
    fun n => by rw [FordAnalysis.gStar]
  have hgpos : ∀ n, 0 < FordAnalysis.g n := by
    intro n
    induction n using Nat.strong_induction_on with
    | _ n ih =>
      cases n with
      | zero => rw [hg0]; norm_num
      | succ m =>
        rw [hgs m]
        have hterm : ∀ i ∈ Finset.range (m + 1),
            0 ≤ FordAnalysis.coeff (i + 1) * FordAnalysis.g (m - i) := fun i hi =>
          mul_nonneg (hnn _) (ih _ (by omega)).le
        have h0 : 0 < FordAnalysis.coeff (0 + 1) * FordAnalysis.g (m - 0) :=
          mul_pos (by simpa using hc1pos) (ih _ (by omega))
        exact lt_of_lt_of_le h0 (Finset.single_le_sum (f := fun i =>
          FordAnalysis.coeff (i + 1) * FordAnalysis.g (m - i)) hterm
          (Finset.mem_range.mpr (Nat.succ_pos m)))
  have hgSpos : ∀ n, 0 < FordAnalysis.gStar n := by
    intro n
    cases n with
    | zero => rw [hgS0]; norm_num
    | succ m =>
      rw [hgSs m]
      have := hgpos (m + 1)
      have := hgpos m
      have : 0 < 1 - FordAnalysis.coeff 1 := by linarith
      positivity
  have hgle : ∀ n, FordAnalysis.g n ≤ FordAnalysis.gStar n := by
    intro n
    cases n with
    | zero => rw [hg0, hgS0]
    | succ m =>
      rw [hgSs m]
      have := hgpos m
      have : 0 < 1 - FordAnalysis.coeff 1 := by linarith
      nlinarith
  have hmVpos : ∀ n, 0 < FordGeometry.modelVolume n := by
    intro n
    unfold FordGeometry.modelVolume FordAnalysis.renewalDenominator
    apply one_div_pos.mpr
    exact mul_pos (Nat.cast_pos.mpr (Nat.factorial_pos n))
      (mul_pos (Finset.prod_pos fun i _ => hgpos i) (hgSpos n))
  have hmVstep : ∀ n, FordGeometry.modelVolume n ≤
      ((n : ℝ) + 1) * FordAnalysis.gStar (n + 1) * FordGeometry.modelVolume (n + 1) := by
    intro n
    unfold FordGeometry.modelVolume FordAnalysis.renewalDenominator
    rw [Finset.prod_range_succ, Nat.factorial_succ]
    push_cast
    have hP : 0 < ∏ i ∈ Finset.range n, FordAnalysis.g i := Finset.prod_pos fun i _ => hgpos i
    have hF0 : (0 : ℝ) < (n ! : ℝ) := Nat.cast_pos.mpr (Nat.factorial_pos n)
    have hgn := hgpos n
    have hgsn := hgSpos n
    have hgs1 := hgSpos (n + 1)
    have hn1 : (0 : ℝ) < (n : ℝ) + 1 := by positivity
    have e : ((n : ℝ) + 1) * FordAnalysis.gStar (n + 1) *
        (1 / (((n : ℝ) + 1) * (n ! : ℝ) * ((∏ i ∈ Finset.range n, FordAnalysis.g i) *
          FordAnalysis.g n * FordAnalysis.gStar (n + 1)))) =
        1 / ((n ! : ℝ) * ((∏ i ∈ Finset.range n, FordAnalysis.g i) * FordAnalysis.g n)) := by
      field_simp
    rw [e]
    apply one_div_le_one_div_of_le (by positivity)
    apply mul_le_mul_of_nonneg_left _ hF0.le
    exact mul_le_mul_of_nonneg_left (hgle n) hP.le
  
  set a : ℕ → ℝ := fun k => FordAnalysis.coeff k * ρ ^ k with ha_def
  have ha : ∀ k, 0 ≤ a k := fun k => mul_nonneg (hnn k) (pow_nonneg hρ0.le k)
  have ha0 : a 0 = 0 := by simp [ha_def, hc0]
  have hFa : ∑' k, a k = 1 := hF
  have hsum : Summable a := by
    by_contra hns
    rw [tsum_eq_zero_of_not_summable hns] at hFa
    norm_num at hFa
  set T : ℕ → ℝ := fun m => ∑' j, a (j + m) with hT_def
  have hT : ∀ m, (∑ i ∈ Finset.range m, a i) + T m = 1 := by
    intro m
    rw [hT_def]
    simp only
    rw [hsum.sum_add_tsum_nat_add m, hFa]
  have hratio : ∀ m, ρ * T m ≤ T (m + 1) := by
    intro m
    simp only [hT_def]
    rw [← tsum_mul_left]
    apply Summable.tsum_le_tsum
    · intro j
      simp only [ha_def]
      calc ρ * (FordAnalysis.coeff (j + m) * ρ ^ (j + m))
          = FordAnalysis.coeff (j + m) * ρ ^ (j + (m + 1)) := by ring
        _ ≤ FordAnalysis.coeff (j + (m + 1)) * ρ ^ (j + (m + 1)) :=
          mul_le_mul_of_nonneg_right (hmono (j + m)) (pow_nonneg hρ0.le _)
    · exact ((summable_nat_add_iff m).mpr hsum).mul_left ρ
    · exact (summable_nat_add_iff (m + 1)).mpr hsum
  have hrec : ∀ n, FordAnalysis.g (n + 1) * ρ ^ (n + 1) =
      ∑ i ∈ Finset.range (n + 1), a (i + 1) * (FordAnalysis.g (n - i) * ρ ^ (n - i)) := by
    intro n
    rw [hgs n, Finset.sum_mul]
    apply Finset.sum_congr rfl
    intro i hi
    have hi' := Finset.mem_range.mp hi
    have hp : ρ ^ (n + 1) = ρ ^ (i + 1) * ρ ^ (n - i) := by
      rw [← pow_add]; congr 1; omega
    rw [hp]
    simp only [ha_def]
    ring
  have hh : ∀ n, 1 ≤ n → FordAnalysis.g n * ρ ^ n ≤ 1 - ρ := by
    intro n
    induction n using Nat.strong_induction_on with
    | _ n ih =>
      intro hn
      obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
      rw [hrec m, Finset.sum_range_succ, Nat.sub_self, hg0, pow_zero, mul_one]
      have hbound : (∑ i ∈ Finset.range m, a (i + 1) * (FordAnalysis.g (m - i) * ρ ^ (m - i))) ≤
          ∑ i ∈ Finset.range m, a (i + 1) * (1 - ρ) := by
        apply Finset.sum_le_sum
        intro i hi
        have hi' := Finset.mem_range.mp hi
        exact mul_le_mul_of_nonneg_left (ih (m - i) (by omega) (by omega)) (ha _)
      rw [← Finset.sum_mul] at hbound
      set S := ∑ i ∈ Finset.range m, a (i + 1) with hS
      have hS1 : (∑ i ∈ Finset.range (m + 1), a i) = S := by
        rw [Finset.sum_range_succ', ha0, add_zero]
      have hT1 := hT (m + 1)
      rw [hS1] at hT1
      have hT2 := hT (m + 2)
      rw [Finset.sum_range_succ, hS1] at hT2
      have hr := hratio (m + 1)
      have hTS : T (m + 1) = 1 - S := by linarith
      rw [hTS] at hr
      nlinarith
  
  have hgS : ∀ n, FordAnalysis.gStar (n + 1) * ρ ^ (n + 1) ≤ 1 := by
    intro n
    cases n with
    | zero =>
      have hg1 : FordAnalysis.g 1 = FordAnalysis.coeff 1 := by
        rw [hgs 0]; simp [hg0]
      rw [hgSs 0, hg1, hg0]
      simp only [zero_add, pow_one]
      nlinarith
    | succ m =>
      rw [hgSs (m + 1)]
      have hA := hh (m + 2) (by omega)
      have hB := hh (m + 1) (by omega)
      have hcoef : 0 ≤ (1 - FordAnalysis.coeff 1) * ρ := mul_nonneg (by linarith) hρ0.le
      have hB' := mul_le_mul_of_nonneg_left hB hcoef
      have heq : (FordAnalysis.g (m + 1 + 1) + (1 - FordAnalysis.coeff 1) * FordAnalysis.g (m + 1)) *
          ρ ^ (m + 1 + 1) = FordAnalysis.g (m + 2) * ρ ^ (m + 2) +
            (1 - FordAnalysis.coeff 1) * ρ * (FordAnalysis.g (m + 1) * ρ ^ (m + 1)) := by
        ring
      rw [heq]
      have : 0 ≤ FordAnalysis.coeff 1 * ρ * (1 - ρ) :=
        mul_nonneg (mul_nonneg hc1pos.le hρ0.le) (by linarith)
      nlinarith
  
  have ht0 : 0 < t := lt_of_lt_of_le (Real.exp_pos 1) ht
  set L := FordScale.coreDimension M t with hL
  set r : ℝ := (L : ℝ) / (t * ρ ^ L) with hr_def
  have htρ : 0 < t * ρ ^ L := mul_pos ht0 (pow_pos hρ0 L)
  have hr0 : 0 ≤ r := div_nonneg (Nat.cast_nonneg L) htρ.le
  
  have hstep : ∀ n, n < L → t ^ n * FordGeometry.modelVolume n ≤
      r * (t ^ (n + 1) * FordGeometry.modelVolume (n + 1)) := by
    intro n hn
    have hnL : n + 1 ≤ L := hn
    have hcoef : ((n : ℝ) + 1) * FordAnalysis.gStar (n + 1) ≤ (L : ℝ) / ρ ^ L := by
      rw [le_div_iff₀ (pow_pos hρ0 L)]
      have h1 : FordAnalysis.gStar (n + 1) * ρ ^ L ≤ FordAnalysis.gStar (n + 1) * ρ ^ (n + 1) :=
        mul_le_mul_of_nonneg_left (pow_le_pow_of_le_one hρ0.le hρ1.le hnL) (hgSpos _).le
      have h2 := hgS n
      have h3 : ((n : ℝ) + 1) ≤ (L : ℝ) := by exact_mod_cast hnL
      have h4 : 0 ≤ FordAnalysis.gStar (n + 1) * ρ ^ L :=
        mul_nonneg (hgSpos _).le (pow_nonneg hρ0.le _)
      calc ((n : ℝ) + 1) * FordAnalysis.gStar (n + 1) * ρ ^ L
          = ((n : ℝ) + 1) * (FordAnalysis.gStar (n + 1) * ρ ^ L) := by ring
        _ ≤ ((n : ℝ) + 1) * 1 := mul_le_mul_of_nonneg_left (h1.trans h2) (by positivity)
        _ ≤ L := by linarith
    have hmv := (hmVstep n).trans
      (mul_le_mul_of_nonneg_right hcoef (hmVpos (n + 1)).le)
    have e : r * (t ^ (n + 1) * FordGeometry.modelVolume (n + 1)) =
        t ^ n * ((L : ℝ) / ρ ^ L * FordGeometry.modelVolume (n + 1)) := by
      rw [hr_def, pow_succ]
      field_simp
    rw [e]
    exact mul_le_mul_of_nonneg_left hmv (pow_nonneg ht0.le n)
  
  have hrate : r ≤ 4 * ρ ^ M := by
    have hu1 : 1 ≤ Real.log t := by
      have := Real.log_le_log (Real.exp_pos 1) ht
      rwa [Real.log_exp] at this
    set u := Real.log t with hu
    have hu0 : 0 < u := by linarith
    have hlu0 : 0 ≤ Real.log u := Real.log_nonneg hu1
    have hlu1 : Real.log u ≤ u - 1 := Real.log_le_sub_one_of_pos hu0
    have hlogρ : Real.log ρ < 0 := Real.log_neg hρ0 hρ1
    have hlog34 : Real.log (3 / 4) < -1 / 4 := by
      rw [Real.log_lt_iff_lt_exp (by norm_num)]
      have := Real.add_one_lt_exp (x := (-1 / 4 : ℝ)) (by norm_num)
      linarith
    have hlρ : Real.log ρ < Real.log (3 / 4) := Real.log_lt_log hρ0 hρ34
    have hCdef : FordAnalysis.C = (2 * |Real.log ρ|)⁻¹ := rfl
    rw [abs_of_neg hlogρ] at hCdef
    have hapos : 0 < 2 * -Real.log ρ := by linarith
    have hCpos : 0 < FordAnalysis.C := by rw [hCdef]; exact inv_pos.mpr hapos
    have hCmul : FordAnalysis.C * (2 * -Real.log ρ) = 1 := by
      rw [hCdef]; exact inv_mul_cancel₀ hapos.ne'
    have hClt : FordAnalysis.C < 2 := by nlinarith
    have harg : 0 ≤ 2 * FordAnalysis.C * (u - Real.log u) := by
      have : 0 ≤ u - Real.log u := by linarith
      positivity
    have hopt : ((FordScale.optimalDimension t : ℕ) : ℝ) ≤ 2 * FordAnalysis.C * (u - Real.log u) := by
      unfold FordScale.optimalDimension
      exact Nat.floor_le harg
    have hLM : (L : ℝ) + M ≤ 2 * FordAnalysis.C * (u - Real.log u) := by
      have : ((L + M : ℕ) : ℝ) = ((FordScale.optimalDimension t : ℕ) : ℝ) := by
        rw [hadd]
      push_cast at this
      linarith
    have hmul : 2 * FordAnalysis.C * (u - Real.log u) * Real.log ρ ≤ ((L : ℝ) + M) * Real.log ρ :=
      mul_le_mul_of_nonpos_right hLM hlogρ.le
    have hid : 2 * FordAnalysis.C * (u - Real.log u) * Real.log ρ = Real.log u - u := by
      have : 2 * FordAnalysis.C * Real.log ρ = -1 := by linarith
      calc 2 * FordAnalysis.C * (u - Real.log u) * Real.log ρ
          = (2 * FordAnalysis.C * Real.log ρ) * (u - Real.log u) := by ring
        _ = Real.log u - u := by rw [this]; ring
    rw [hid] at hmul
    have hpow : ρ ^ (L + M) = Real.exp (((L : ℝ) + M) * Real.log ρ) := by
      rw [← Real.exp_log hρ0]
      rw [← Real.exp_nat_mul, Real.log_exp]
      push_cast
      ring_nf
    have hexp : u / t ≤ ρ ^ (L + M) := by
      rw [hpow]
      calc u / t = Real.exp (Real.log u - u) := by
            rw [Real.exp_sub, Real.exp_log hu0, hu, Real.exp_log ht0]
        _ ≤ _ := Real.exp_le_exp.mpr hmul
    have hu_le : u ≤ t * ρ ^ L * ρ ^ M := by
      rw [div_le_iff₀ ht0] at hexp
      rw [pow_add] at hexp
      linarith
    have hL4 : (L : ℝ) ≤ 4 * u := by
      have hM0 : (0 : ℝ) ≤ M := Nat.cast_nonneg M
      nlinarith
    rw [hr_def, div_le_iff₀ htρ]
    have hρM : 0 ≤ ρ ^ M := pow_nonneg hρ0.le M
    nlinarith
  
  have hiter : ∀ (f : ℕ → ℝ) (q : ℝ), 0 ≤ q → ∀ N k : ℕ, k ≤ N →
      (∀ i, k ≤ i → i < N → f i ≤ q * f (i + 1)) → f k ≤ q ^ (N - k) * f N := by
    intro f q hq N
    induction N with
    | zero =>
      intro k hk _
      have : k = 0 := by omega
      subst this; simp
    | succ N ih =>
      intro k hk hs
      by_cases hkN : k ≤ N
      · have h1 := ih k hkN (fun i hi1 hi2 => hs i hi1 (by omega))
        have h2 := hs N hkN (by omega)
        have h3 : q ^ (N - k) * f N ≤ q ^ (N - k) * (q * f (N + 1)) :=
          mul_le_mul_of_nonneg_left h2 (pow_nonneg hq _)
        have he : N + 1 - k = (N - k) + 1 := by omega
        rw [he, pow_succ]
        linarith [h1, h3, show q ^ (N - k) * (q * f (N + 1)) = q ^ (N - k) * q * f (N + 1) by ring]
      · have : k = N + 1 := by omega
        subst this; simp
  have hmain := hiter (fun i => t ^ i * FordGeometry.modelVolume i) r hr0 L K hK
    (fun i _ hi => hstep i hi)
  simp only at hmain
  refine hmain.trans ?_
  apply mul_le_mul_of_nonneg_right _ (mul_nonneg (pow_nonneg ht0.le _) (hmVpos _).le)
  exact pow_le_pow_left₀ hr0 hrate _

theorem zero_prefix_class_count_eventually (hPNT : Tendsto (fun x : ℝ => (Nat.primeCounting ⌊x⌋₊ : ℝ) / (x / Real.log x)) atTop (𝓝 1))
    (hMERT : ∃ C : ℝ, ∀ x : ℝ, 2 ≤ x →
      |(∑ p ∈ (Finset.Iic ⌊x⌋₊).filter Nat.Prime, (1 : ℝ) / p) - Real.log (Real.log x)| ≤ C)
    (hEULER : Asymptotics.IsEquivalent atTop
      (fun x : ℝ => ∏ p ∈ (Finset.Iic ⌊x⌋₊).filter Nat.Prime, (1 - (1 : ℝ) / p))
      (fun x => Real.exp (-Real.eulerMascheroniConstant) / Real.log x))
    (hRHO : 0 < FordAnalysis.rho ∧ FordAnalysis.rho < 3 / 4 ∧ FordAnalysis.F FordAnalysis.rho = 1)
    (hSUFFIX : ∀ᶠ Z : ℝ in atTop,
      ∀ (M : ℕ) (A y : ℝ) (a : Fin (FordScale.coreDimension M (logLog y)))
        (F : Finset ℕ) (q : ℕ → Fin (FordScale.coreDimension M (logLog y) + 1) → ℕ),
        2 ≤ M → 4 ≤ A → 1 < y → 0 < logLog y →
        (M : ℝ) ≤ 10 * Real.log (logLog Z) →
        (∀ n ∈ F, ∃ R : FordLower.PrimeProductRecord M A y a n, R.fullTuple = q n) →
        ∀ j : ℕ, ((FordLower.suffixesUpTo F q j Z).card : ℝ) ≤
          5 * (Z / (Real.log Z * (logLog Z) ^ 2)))
    (M : ℕ) : ∀ᶠ y : ℝ in atTop,
      ∀ (A : ℝ) (a : Fin (FordScale.coreDimension M (logLog y))) (F : Finset ℕ)
        (q : ℕ → Fin (FordScale.coreDimension M (logLog y) + 1) → ℕ),
        2 ≤ M → 4 ≤ A →
        (∀ n ∈ F, ∃ R : FordLower.PrimeProductRecord M A y a n, R.fullTuple = q n) →
        ((FordLower.prefixCollisionClass F q 0).card : ℝ) ≤ 5 * (y / (Real.log y * (logLog y) ^ 2)) :=
by
  have hLL : Tendsto logLog atTop atTop :=
    Real.tendsto_log_atTop.comp Real.tendsto_log_atTop
  have hLLL : Tendsto (fun y => Real.log (logLog y)) atTop atTop :=
    Real.tendsto_log_atTop.comp hLL
  filter_upwards [hSUFFIX, eventually_gt_atTop (1 : ℝ), hLL.eventually_gt_atTop 0,
    hLLL.eventually_ge_atTop ((M : ℝ) / 10)] with y hcount hy ht hMsize
  intro A a F q hM hA hrecords
  have hMsize' : (M : ℝ) ≤ 10 * Real.log (logLog y) := by
    change (M : ℝ) / 10 ≤ Real.log (logLog y) at hMsize
    linarith
  have hprod : ∀ n ∈ F, FordLower.suffixProduct (q n) 0 = n := by
    intro n hn
    obtain ⟨R, hR⟩ := hrecords n hn
    unfold FordLower.suffixProduct
    rw [Finset.filter_true_of_mem (fun idx _ => Nat.zero_le _), ← hR, Fin.prod_univ_succ]
    simp only [FordLower.PrimeProductRecord.fullTuple, Fin.cons_zero, Fin.cons_succ]
    exact R.integer.symm
  have hclassF : ∀ n ∈ FordLower.prefixCollisionClass F q 0, n ∈ F := fun n hn =>
    (Finset.mem_filter.mp (Finset.mem_filter.mp hn).1).1
  have hset : FordLower.suffixesUpTo F q 0 y = FordLower.prefixCollisionClass F q 0 := by
    ext s
    unfold FordLower.suffixesUpTo FordLower.suffixCollisionFamily
    rw [Finset.mem_filter, Finset.mem_image]
    constructor
    · rintro ⟨⟨n, hn, hns⟩, _⟩
      rw [hprod n (hclassF n hn)] at hns
      exact hns ▸ hn
    · intro hs
      obtain ⟨R, _⟩ := hrecords s (hclassF s hs)
      exact ⟨⟨s, hs, hprod s (hclassF s hs)⟩, R.totient_range.2⟩
  rw [← hset]
  exact hcount M A y a F q hM hA hy ht hMsize' hrecords 0

theorem ford_modelVolume_pos (K : ℕ) : 0 < FordGeometry.modelVolume K :=
by
  have hl2 := Real.log_two_gt_d9
  have hl2' := Real.log_two_lt_d9
  norm_num at hl2 hl2'
  have hcoeff : ∀ m : ℕ, 1 ≤ m → 0 < FordAnalysis.coeff m := by
    intro m hm
    have hm0 : m ≠ 0 := by omega
    simp only [FordAnalysis.coeff, hm0, if_false, fordWeight]
    have hmR : (1 : ℝ) ≤ m := by exact_mod_cast hm
    have hpos : (0 : ℝ) < m := by linarith
    have hpos1 : (0 : ℝ) < (m : ℝ) + 1 := by linarith
    have hlog2 : Real.log 2 ≤ Real.log ((m : ℝ) + 1) :=
      Real.log_le_log (by norm_num) (by linarith)
    have hdiv : Real.log ((m : ℝ) / ((m : ℝ) + 1)) ≤ (m : ℝ) / ((m : ℝ) + 1) - 1 :=
      Real.log_le_sub_one_of_pos (div_pos hpos hpos1)
    rw [Real.log_div hpos.ne' hpos1.ne'] at hdiv
    have hfrac : (m : ℝ) / ((m : ℝ) + 1) - 1 = -1 / ((m : ℝ) + 1) := by
      field_simp; ring
    rw [hfrac] at hdiv
    have hinv : 1 / ((m : ℝ) + 1) ≤ 1 / 2 := by
      rw [div_le_div_iff₀ hpos1 (by norm_num)]; linarith
    have key : (m : ℝ) * (Real.log m - Real.log ((m : ℝ) + 1)) ≤
        (m : ℝ) * (-1 / ((m : ℝ) + 1)) :=
      mul_le_mul_of_nonneg_left hdiv hpos.le
    have e : (m : ℝ) * (-1 / ((m : ℝ) + 1)) = -1 + 1 / ((m : ℝ) + 1) := by
      field_simp; ring
    rw [e] at key
    nlinarith
  have hc1 : FordAnalysis.coeff 1 ≤ 1 := by
    simp only [FordAnalysis.coeff, one_ne_zero, if_false, fordWeight]
    norm_num
    linarith
  have hg : ∀ n, 0 < FordAnalysis.g n := by
    intro n
    induction n using Nat.strong_induction_on with
    | _ n ih =>
      cases n with
      | zero => rw [FordAnalysis.g]; norm_num
      | succ n =>
        rw [FordAnalysis.g]
        apply Finset.sum_pos
        · intro idx hidx
          have := Finset.mem_range.mp hidx
          exact mul_pos (hcoeff _ (by omega)) (ih _ (by omega))
        · exact Finset.nonempty_range_succ
  have hgs : ∀ n, 0 < FordAnalysis.gStar n := by
    intro n
    cases n with
    | zero => simp [FordAnalysis.gStar]
    | succ n =>
      simp only [FordAnalysis.gStar]
      have h1 := hg (n + 1)
      have h2 := mul_nonneg (sub_nonneg.mpr hc1) (hg n).le
      linarith
  unfold FordGeometry.modelVolume FordAnalysis.renewalDenominator
  apply one_div_pos.mpr
  exact mul_pos (Nat.cast_pos.mpr (Nat.factorial_pos K))
    (mul_pos (Finset.prod_pos fun n _ => hg n) (hgs K))

theorem ford_core_order_lower_bound (hPNT : Tendsto (fun x : ℝ => (Nat.primeCounting ⌊x⌋₊ : ℝ) / (x / Real.log x)) atTop (𝓝 1))
    (hMERT : ∃ C : ℝ, ∀ x : ℝ, 2 ≤ x →
      |(∑ p ∈ (Finset.Iic ⌊x⌋₊).filter Nat.Prime, (1 : ℝ) / p) - Real.log (Real.log x)| ≤ C)
    (hEULER : Asymptotics.IsEquivalent atTop
      (fun x : ℝ => ∏ p ∈ (Finset.Iic ⌊x⌋₊).filter Nat.Prime, (1 - (1 : ℝ) / p))
      (fun x => Real.exp (-Real.eulerMascheroniConstant) / Real.log x))
    (hRHO : 0 < FordAnalysis.rho ∧ FordAnalysis.rho < 3 / 4 ∧ FordAnalysis.F FordAnalysis.rho = 1) :
    ∃ c : ℝ, 0 < c ∧ ∀ᶠ M : ℕ in atTop, ∀ᶠ y : ℝ in atTop,
      c * (y / Real.log y) * (logLog y) ^ (FordScale.coreDimension M (logLog y)) *
        FordGeometry.T (FordScale.coreDimension M (logLog y)) ≤ V y :=
by
  have hρ0 : 0 < FordAnalysis.rho := hRHO.1
  have hρ1 : FordAnalysis.rho < 1 := hRHO.2.1.trans (by norm_num)
  have hLL : Tendsto logLog atTop atTop :=
    Real.tendsto_log_atTop.comp Real.tendsto_log_atTop
  
  have hPDnn : ∀ M : ℕ, 0 ≤ FordGeometry.prefixDecay M := by
    intro M
    unfold FordGeometry.prefixDecay
    positivity
  have hlogρ : Real.log FordAnalysis.rho + 1 / 9 < 0 := by
    have hlog34 : Real.log (3 / 4) < -1 / 4 := by
      rw [Real.log_lt_iff_lt_exp (by norm_num)]
      have := Real.add_one_lt_exp (x := (-1 / 4 : ℝ)) (by norm_num)
      linarith
    have hlρ : Real.log FordAnalysis.rho < Real.log (3 / 4) := Real.log_lt_log hρ0 hRHO.2.1
    linarith
  have hPDt : Tendsto FordGeometry.prefixDecay atTop (𝓝 0) := by
    have h := Real.tendsto_exp_atBot.comp
      ((tendsto_natCast_atTop_atTop (R := ℝ)).atTop_mul_const_of_neg hlogρ)
    have heq : ∀ M : ℕ, FordGeometry.prefixDecay M =
        4 * Real.exp ((M : ℝ) * (Real.log FordAnalysis.rho + 1 / 9)) := by
      intro M
      unfold FordGeometry.prefixDecay
      rw [mul_add, Real.exp_add, Real.exp_nat_mul, Real.exp_log hρ0]
      rw [show (M : ℝ) * (1 / 9) = (M : ℝ) / 9 by ring]
      ring
    have h2 := h.const_mul 4
    rw [mul_zero] at h2
    refine h2.congr' (Eventually.of_forall fun M => ?_)
    simp only [Function.comp_apply]
    exact (heq M).symm
  have hPDpow : ∀ M h : ℕ, (4 * FordAnalysis.rho ^ M) ^ h * Real.exp ((h : ℝ) * (M : ℝ) / 9) =
      (FordGeometry.prefixDecay M) ^ h := by
    intro M h
    unfold FordGeometry.prefixDecay
    rw [show (h : ℝ) * (M : ℝ) / 9 = (h : ℝ) * ((M : ℝ) / 9) by ring, Real.exp_nat_mul]
    exact (mul_pow _ _ _).symm
  
  have hCpos : 0 < FordAnalysis.C := by
    have hneg := Real.log_neg hρ0 hρ1
    have hCdef : FordAnalysis.C = (2 * |Real.log FordAnalysis.rho|)⁻¹ := rfl
    rw [hCdef, abs_of_neg hneg]
    apply inv_pos.mpr
    linarith
  have hlogarg : Tendsto (fun u : ℝ => u - Real.log u) atTop atTop := by
    have hlo : ∀ᶠ u : ℝ in atTop, u / 2 ≤ u - Real.log u := by
      filter_upwards [Real.isLittleO_log_id_atTop.def (by norm_num : (0 : ℝ) < 1 / 2),
        eventually_ge_atTop (1 : ℝ)] with u hu hu1
      simp only [Real.norm_eq_abs, id_eq, abs_of_nonneg (by linarith : 0 ≤ u)] at hu
      have hl := le_abs_self (Real.log u)
      linarith
    exact tendsto_atTop_mono' atTop hlo (tendsto_id.atTop_div_const (by norm_num : (0 : ℝ) < 2))
  have hopt : Tendsto FordScale.optimalDimension atTop atTop := by
    have h := (hlogarg.comp Real.tendsto_log_atTop).const_mul_atTop
      (mul_pos (by norm_num : (0 : ℝ) < 2) hCpos)
    exact tendsto_nat_floor_atTop.comp h
  have hcore : ∀ M : ℕ, Tendsto (FordScale.coreDimension M) atTop atTop :=
    fun M => (tendsto_sub_atTop_nat M).comp hopt
  have hadd : ∀ M : ℕ, ∀ᶠ t : ℝ in atTop,
      FordScale.coreDimension M t + M = FordScale.optimalDimension t := by
    intro M
    filter_upwards [hopt.eventually (eventually_ge_atTop M)] with t ht
    exact Nat.sub_add_cancel ht
  
  have hmV0 : FordGeometry.modelVolume 0 = 1 := by
    simp [FordGeometry.modelVolume, FordAnalysis.renewalDenominator, FordAnalysis.gStar]
  have hmass1 : ∀ M : ℕ, ∀ t : ℝ, Real.exp 1 ≤ t →
      FordScale.coreDimension M t + M = FordScale.optimalDimension t →
      FordGeometry.prefixDecay M ≤ 1 →
      1 ≤ t ^ (FordScale.coreDimension M t) *
        FordGeometry.modelVolume (FordScale.coreDimension M t) := by
    intro M t ht hadd' hM
    have hr0 : 0 ≤ 4 * FordAnalysis.rho ^ M := by positivity
    have hr : 4 * FordAnalysis.rho ^ M ≤ 1 := by
      have he : 1 ≤ Real.exp ((M : ℝ) / 9) := Real.one_le_exp (by positivity)
      have h1 : 4 * FordAnalysis.rho ^ M ≤ FordGeometry.prefixDecay M := by
        unfold FordGeometry.prefixDecay
        exact le_mul_of_one_le_right hr0 he
      exact h1.trans hM
    have h := core_scaled_prefix_bound hPNT hMERT hEULER hRHO M ht hadd' (K := 0) (Nat.zero_le _)
    simp only [pow_zero, hmV0, mul_one, Nat.sub_zero] at h
    have ht0 : 0 < t := lt_of_lt_of_le (Real.exp_pos 1) ht
    apply h.trans
    exact mul_le_of_le_one_left
      (mul_nonneg (pow_nonneg ht0.le _) (ford_modelVolume_pos _).le) (pow_le_one₀ hr0 hr)
  have hvol : ∀ M : ℕ, ∀ᶠ t : ℝ in atTop, FordGeometry.prefixDecay M ≤ 1 →
      FordGeometry.modelVolume (FordScale.coreDimension M t) ≤
          22 * FordGeometry.T (FordScale.coreDimension M t) ∧
        1 / 22 ≤ t ^ (FordScale.coreDimension M t) * FordGeometry.T (FordScale.coreDimension M t) := by
    intro M
    filter_upwards [(hcore M).eventually (modelVolume_eventually_le_T hPNT hMERT hEULER hRHO),
      hadd M, eventually_ge_atTop (Real.exp 1)] with t hT hadd' ht
    intro hM
    refine ⟨hT, ?_⟩
    have ht0 : 0 < t := lt_of_lt_of_le (Real.exp_pos 1) ht
    have h := mul_le_mul_of_nonneg_left hT (pow_nonneg ht0.le (FordScale.coreDimension M t))
    have hge := hmass1 M t ht hadd' hM
    nlinarith
  
  have hgeo : ∀ r : ℝ, 0 ≤ r → r ≤ 1 / 2 → ∀ L : ℕ,
      (∑ idx ∈ Finset.range L, r ^ (idx + 1)) ≤ 2 * r := by
    intro r hr hr2 L
    induction L with
    | zero => simp; positivity
    | succ L ih =>
      rw [Finset.sum_range_succ']
      have heq : (∑ idx ∈ Finset.range L, r ^ (idx + 1 + 1)) =
          r * (∑ idx ∈ Finset.range L, r ^ (idx + 1)) := by
        rw [Finset.mul_sum]
        apply Finset.sum_congr rfl
        intro idx _
        rw [pow_succ]
        ring
      rw [heq, zero_add, pow_one]
      nlinarith [mul_le_mul_of_nonneg_left ih hr]
  have hrgeo : ∀ r : ℝ, 0 ≤ r → r ≤ 1 / 2 → ∀ L : ℕ,
      (∑ K ∈ Finset.range L, r ^ (L - K)) ≤ 2 * r := by
    intro r hr hr2 L
    have heq : (∑ K ∈ Finset.range L, r ^ (L - K)) = ∑ idx ∈ Finset.range L, r ^ (idx + 1) := by
      rw [← Finset.sum_range_reflect (fun idx => r ^ (idx + 1)) L]
      apply Finset.sum_congr rfl
      intro idx hi
      congr 1
      have hi' := Finset.mem_range.mp hi
      omega
    rw [heq]
    exact hgeo r hr hr2 L
  have hwps : ∀ M : ℕ, ∀ t : ℝ, Real.exp 1 ≤ t →
      FordScale.coreDimension M t + M = FordScale.optimalDimension t →
      FordGeometry.prefixDecay M ≤ 1 / 2 →
      (∑ K ∈ Finset.range (FordScale.coreDimension M t),
        (t ^ K * FordGeometry.modelVolume K) *
          Real.exp (((FordScale.coreDimension M t - K : ℕ) : ℝ) * (M : ℝ) / 9)) ≤
        2 * FordGeometry.prefixDecay M *
          (t ^ (FordScale.coreDimension M t) * FordGeometry.modelVolume (FordScale.coreDimension M t)) := by
    intro M t ht hadd' hM
    have ht0 : 0 < t := lt_of_lt_of_le (Real.exp_pos 1) ht
    have hbase : 0 ≤ t ^ (FordScale.coreDimension M t) *
        FordGeometry.modelVolume (FordScale.coreDimension M t) :=
      mul_nonneg (pow_nonneg ht0.le _) (ford_modelVolume_pos _).le
    calc
      _ ≤ ∑ K ∈ Finset.range (FordScale.coreDimension M t),
          (FordGeometry.prefixDecay M) ^ (FordScale.coreDimension M t - K) *
            (t ^ (FordScale.coreDimension M t) *
              FordGeometry.modelVolume (FordScale.coreDimension M t)) := by
        apply Finset.sum_le_sum
        intro K hK
        have h := mul_le_mul_of_nonneg_right
          (core_scaled_prefix_bound hPNT hMERT hEULER hRHO M ht hadd'
            (Nat.le_of_lt (Finset.mem_range.mp hK)))
          (Real.exp_pos (((FordScale.coreDimension M t - K : ℕ) : ℝ) * (M : ℝ) / 9)).le
        apply h.trans_eq
        rw [mul_right_comm, hPDpow]
      _ = (∑ K ∈ Finset.range (FordScale.coreDimension M t),
            (FordGeometry.prefixDecay M) ^ (FordScale.coreDimension M t - K)) *
          (t ^ (FordScale.coreDimension M t) *
            FordGeometry.modelVolume (FordScale.coreDimension M t)) := (Finset.sum_mul _ _ _).symm
      _ ≤ _ := mul_le_mul_of_nonneg_right
        (hrgeo _ (hPDnn M) hM _) hbase
  
  obtain ⟨C₅, hC₅, hprefix⟩ := exists_maximal_prefix_class_bound hPNT hMERT hEULER hRHO
  have hSUFFIX := actual_suffix_count_eventually hPNT hMERT hEULER hRHO
  have hloss : ∀ᶠ M : ℕ in atTop,
      ∀ (A y : ℝ) (a : Fin (FordScale.coreDimension M (logLog y)))
        (F : Finset ℕ) (q : ℕ → Fin (FordScale.coreDimension M (logLog y) + 1) → ℕ),
        4 ≤ A → 1 < y → Real.exp 1 ≤ logLog y →
        FordScale.coreDimension M (logLog y) + M = FordScale.optimalDimension (logLog y) →
        (∀ n ∈ F, ∃ R : FordLower.PrimeProductRecord M A y a n, R.fullTuple = q n) →
        (∑ K ∈ Finset.range (FordScale.coreDimension M (logLog y)),
          ((FordLower.prefixCollisionClass F q (K + 1)).card : ℝ)) ≤
          (22 * C₅) * FordGeometry.prefixDecay M * (y / Real.log y) *
            ((logLog y) ^ (FordScale.coreDimension M (logLog y)) *
              FordGeometry.modelVolume (FordScale.coreDimension M (logLog y))) := by
    filter_upwards [actual_suffix_reciprocal_mass_eventually hPNT hMERT hEULER hRHO hSUFFIX,
      hPDt.eventually_lt_const (by norm_num : (0 : ℝ) < 1 / 2)] with M hmass hdecay
    intro A y a F q hA hy ht hadd' hrecords
    have ht0 : 0 < logLog y := lt_of_lt_of_le (Real.exp_pos 1) ht
    have hy0 : 0 < y := by linarith
    have hlog : 0 < Real.log y := Real.log_pos hy
    have hterm : ∀ K ∈ Finset.range (FordScale.coreDimension M (logLog y)),
        ((FordLower.prefixCollisionClass F q (K + 1)).card : ℝ) ≤
          (11 * C₅) * (y / Real.log y) *
            (((logLog y) ^ K * FordGeometry.modelVolume K) *
              Real.exp (((FordScale.coreDimension M (logLog y) - K : ℕ) : ℝ) * (M : ℝ) / 9)) := by
      intro K hK
      have hKL := Finset.mem_range.mp hK
      have hp := hprefix M A y a F q hy ht hrecords K hKL.le
      have hm := hmass A y a F q hA hy ht0 hrecords (K + 1) (by omega)
      rw [Nat.add_sub_add_right] at hm
      apply hp.trans
      calc
        _ ≤ C₅ * (y / Real.log y) * ((logLog y) ^ K * FordGeometry.modelVolume K) *
            (11 * Real.exp (((FordScale.coreDimension M (logLog y) - K : ℕ) : ℝ) * (M : ℝ) / 9)) :=
          mul_le_mul_of_nonneg_left hm (mul_nonneg (mul_nonneg hC₅.le (div_nonneg hy0.le hlog.le))
            (mul_nonneg (pow_nonneg ht0.le K) (ford_modelVolume_pos K).le))
        _ = _ := by ring
    calc
      _ ≤ ∑ K ∈ Finset.range (FordScale.coreDimension M (logLog y)),
          (11 * C₅) * (y / Real.log y) *
            (((logLog y) ^ K * FordGeometry.modelVolume K) *
              Real.exp (((FordScale.coreDimension M (logLog y) - K : ℕ) : ℝ) * (M : ℝ) / 9)) :=
        Finset.sum_le_sum hterm
      _ = (11 * C₅) * (y / Real.log y) *
          (∑ K ∈ Finset.range (FordScale.coreDimension M (logLog y)),
            ((logLog y) ^ K * FordGeometry.modelVolume K) *
              Real.exp (((FordScale.coreDimension M (logLog y) - K : ℕ) : ℝ) * (M : ℝ) / 9)) :=
        (Finset.mul_sum _ _ _).symm
      _ ≤ (11 * C₅) * (y / Real.log y) * (2 * FordGeometry.prefixDecay M *
          ((logLog y) ^ (FordScale.coreDimension M (logLog y)) *
            FordGeometry.modelVolume (FordScale.coreDimension M (logLog y)))) :=
        mul_le_mul_of_nonneg_left (hwps M (logLog y) ht hadd' hdecay.le)
          (mul_nonneg (by positivity) (div_nonneg hy0.le hlog.le))
      _ = _ := by ring
  
  obtain ⟨c, hc, hs1⟩ := exists_core_primeProducts_count_lower hPNT hMERT hEULER hRHO
  have hC' : 0 < 22 * C₅ := by positivity
  refine ⟨c / 2, half_pos hc, ?_⟩
  filter_upwards [hs1 4 (by norm_num), hloss,
    hPDt.eventually_lt_const (by positivity : (0 : ℝ) < c / (88 * (22 * C₅))),
    hPDt.eventually_lt_const (by norm_num : (0 : ℝ) < 1),
    eventually_ge_atTop 2] with M hmain hlarge hdecay hMrate hM
  filter_upwards [hmain, core_prefix_families hPNT hMERT hEULER hRHO M,
    zero_prefix_class_count_eventually hPNT hMERT hEULER hRHO hSUFFIX M,
    hLL.eventually (hvol M), hLL.eventually (hadd M),
    hLL.eventually ((hcore M).eventually (eventually_ge_atTop 2)),
    hLL.eventually_ge_atTop (Real.exp 1), hLL.eventually_ge_atTop (1 + 440 / c),
    eventually_gt_atTop (1 : ℝ)] with y hmainy hfam hzero hvoly hadd' hL2 ht htlarge hy
  have ht0 : 0 < logLog y := lt_of_lt_of_le (Real.exp_pos 1) ht
  have hy0 : 0 < y := by linarith
  have hlog : 0 < Real.log y := Real.log_pos hy
  have hY : 0 ≤ y / Real.log y := (div_pos hy0 hlog).le
  obtain ⟨hmodel, hordered⟩ := hvoly hMrate.le
  have hL2' : 2 ≤ FordScale.coreDimension M (logLog y) := hL2
  let a : Fin (FordScale.coreDimension M (logLog y)) :=
    ⟨FordScale.coreDimension M (logLog y) - 1, by omega⟩
  have ha : a.val + 1 = FordScale.coreDimension M (logLog y) := by
    show FordScale.coreDimension M (logLog y) - 1 + 1 = FordScale.coreDimension M (logLog y)
    omega
  have hcB := hmainy a ha
  obtain ⟨q, hrecords, hineq⟩ := hfam a ha 4 (by norm_num)
  have hz := hzero 4 a _ q hM (by norm_num) hrecords
  have hnz := hlarge 4 y a _ q (by norm_num) hy ht hadd' hrecords
  have hfactor : 22 * C₅ * FordGeometry.prefixDecay M * 22 ≤ c / 4 := by
    have h := (lt_div_iff₀ (by positivity : (0 : ℝ) < 88 * (22 * C₅))).mp hdecay
    nlinarith
  have hbase : 0 ≤ (logLog y) ^ (FordScale.coreDimension M (logLog y)) *
      FordGeometry.T (FordScale.coreDimension M (logLog y)) := le_trans (by norm_num) hordered
  have hnonzero : (∑ K ∈ Finset.range (FordScale.coreDimension M (logLog y)),
      ((FordLower.prefixCollisionClass (FordLower.primeProducts (FordReciprocal.tupleIntegers
        (FordScale.coreDimension M (logLog y)) (logLog y)
        (FordInner.innerSeed (FordInner.targetParameter (FordScale.coreDimension M (logLog y)) M)
          a (4 / logLog y))) y) q (K + 1)).card : ℝ)) ≤
      (c / 4) * (y / Real.log y) * ((logLog y) ^ (FordScale.coreDimension M (logLog y)) *
        FordGeometry.T (FordScale.coreDimension M (logLog y))) := by
    apply hnz.trans
    calc
      _ ≤ 22 * C₅ * FordGeometry.prefixDecay M * (y / Real.log y) *
          ((logLog y) ^ (FordScale.coreDimension M (logLog y)) *
            (22 * FordGeometry.T (FordScale.coreDimension M (logLog y)))) :=
        mul_le_mul_of_nonneg_left
          (mul_le_mul_of_nonneg_left hmodel (pow_nonneg ht0.le _))
          (mul_nonneg (mul_nonneg hC'.le (hPDnn M)) hY)
      _ = (22 * C₅ * FordGeometry.prefixDecay M * 22) * (y / Real.log y) *
          ((logLog y) ^ (FordScale.coreDimension M (logLog y)) *
            FordGeometry.T (FordScale.coreDimension M (logLog y))) := by ring
      _ ≤ _ := mul_le_mul_of_nonneg_right
        (mul_le_mul_of_nonneg_right hfactor hY) hbase
  have ht1 : 1 ≤ logLog y := by linarith [div_pos (by norm_num : (0 : ℝ) < 440) hc]
  have hct : 440 ≤ c * logLog y := by
    have h : 440 / c ≤ logLog y := by linarith
    simpa only [mul_comm] using (div_le_iff₀ hc).mp h
  have hct2 : 440 ≤ c * (logLog y) ^ 2 := by
    have hs : logLog y ≤ (logLog y) ^ 2 := by nlinarith
    exact hct.trans (mul_le_mul_of_nonneg_left hs hc.le)
  have hsmall : 5 / (logLog y) ^ 2 ≤ c / 88 := by
    apply (div_le_iff₀ (by positivity)).mpr
    nlinarith
  have hzquarter : ((FordLower.prefixCollisionClass (FordLower.primeProducts
