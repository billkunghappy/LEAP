  have hrpow : Real.sqrt T = T ^ (1 / 2 : ℝ) := Real.sqrt_eq_rpow T
  have hδ : normalityDelta T = 2 * Real.log T ^ 5 / Real.sqrt T := rfl
  have hW0 : 0 ≤ Real.log T ^ 6 / Real.sqrt T := by positivity
  have hδ0 : 0 ≤ normalityDelta T := by rw [hδ]; positivity
  have hLa : (L : ℝ) ≤ a * Real.log T := le_trans hL (mul_le_mul_of_nonneg_right hAa hℓ0)
  have hL0 : (0 : ℝ) ≤ L := Nat.cast_nonneg L
  have hinv : 1 / T ≤ Real.log T ^ 6 / Real.sqrt T := by
    have h1 : 1 / T ≤ 1 / Real.sqrt T := one_div_le_one_div_of_le hr0 hrT
    have h2 : 1 / Real.sqrt T ≤ Real.log T ^ 6 / Real.sqrt T :=
      div_le_div_of_nonneg_right (one_le_pow₀ hℓ1) hr0.le
    linarith
  have hlog : Real.log (10 * T) / T ≤ 2 * (Real.log T ^ 6 / Real.sqrt T) := by
    have hsplit : Real.log (10 * T) = Real.log 10 + Real.log T :=
      Real.log_mul (by norm_num) hT0.ne'
    have h10 : Real.log 10 ≤ Real.log T := Real.log_le_log (by norm_num) (by linarith)
    have hℓ6 : Real.log T ≤ Real.log T ^ 6 := by
