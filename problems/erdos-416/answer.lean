  have kaluza_nonneg : ∀ (d q : ℕ → ℝ), d 0 = 1 → (∀ k : ℕ, 0 < d k) → (∀ i n : ℕ, i ≤ n → d (i + 1) * d n ≤ d (n + 1) * d i) → (∀ n : ℕ, 1 ≤ n → q n = d n - ∑ j ∈ Finset.Ico 1 n, q j * d (n - j)) → ∀ n : ℕ, 1 ≤ n → 0 ≤ q n ∧ q n ≤ d n := by
