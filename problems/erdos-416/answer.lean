  filter_upwards [hs1, (tendsto_rpow_atTop (by norm_num : (0 : ℝ) < 1 / 2)).eventually_ge_atTop x₀]
    with y hy hx0
  obtain ⟨hy1, hc0, hc1, hgap⟩ := hy
  intro F hF hs _hlog
  have hy0 : 0 < y := by linarith
  have hgap' : y ^ (1 / 40 : ℝ) * y ^ (1 / 40 : ℝ) ≤ coreLowerFraction y * y := by
    have h1 : y ^ (1 / 40 : ℝ) ≤ y ^ (1 / 2 : ℝ) :=
      Real.rpow_le_rpow_of_exponent_le hy1.le (by norm_num)
    exact (mul_le_mul_of_nonneg_right h1 (Real.rpow_pos_of_pos hy0 _).le).trans hgap
  rw [hcard3 y F hy0 hgap' hF hs, Nat.cast_sum, Finset.mul_sum]
  apply Finset.sum_le_sum
  intro n hn
  have hn0 := hF n hn
  have hm1 : (1 : ℝ) ≤ n.totient := by exact_mod_cast Nat.totient_pos.mpr hn0
  have hm0 : (0 : ℝ) < n.totient := by linarith
  have hmn : (n.totient : ℝ) ≤ y ^ (1 / 40 : ℝ) :=
    (Nat.cast_le.mpr (Nat.totient_le n)).trans (hs n hn)
  have hX1 : y ≤ (y / (n.totient : ℝ)) * y ^ (1 / 40 : ℝ) := by
    calc y = (y / (n.totient : ℝ)) * n.totient := (div_mul_cancel₀ y hm0.ne').symm
      _ ≤ (y / (n.totient : ℝ)) * y ^ (1 / 40 : ℝ) :=
          mul_le_mul_of_nonneg_left hmn (div_nonneg hy0.le hm0.le)
  have hX2 : y / (n.totient : ℝ) ≤ y := div_le_self hy0.le hm1
  have h := hwin y (coreLowerFraction y) (y / (n.totient : ℝ)) hy1 hx0 hc0 hc1 hgap hX1 hX2
  have hsub := Finset.card_le_card (hsub4 y hy0.le n hn0)
  have hsubR : ((((Finset.Iic ⌊y / (n.totient : ℝ)⌋₊).filter
      (fun p : ℕ => p.Prime ∧ coreLowerFraction y * (y / (n.totient : ℝ)) + 1 < (p : ℝ))).card : ℕ) : ℝ) ≤
      (((FordLower.lowerPrimeChoices y n).card : ℕ) : ℝ) := by exact_mod_cast hsub
  have heq : y / (2 * Real.log y) * invTotient n = (y / (n.totient : ℝ)) / (2 * Real.log y) := by
    unfold invTotient
    ring
  rw [heq]
  exact h.trans hsubR

theorem exists_core_primeProducts_count_lower (hPNT : Tendsto (fun x : ℝ => (Nat.primeCounting ⌊x⌋₊ : ℝ) / (x / Real.log x)) atTop (𝓝 1))
    (hMERT : ∃ C : ℝ, ∀ x : ℝ, 2 ≤ x →
      |(∑ p ∈ (Finset.Iic ⌊x⌋₊).filter Nat.Prime, (1 : ℝ) / p) - Real.log (Real.log x)| ≤ C)
    (hEULER : Asymptotics.IsEquivalent atTop
      (fun x : ℝ => ∏ p ∈ (Finset.Iic ⌊x⌋₊).filter Nat.Prime, (1 - (1 : ℝ) / p))
      (fun x => Real.exp (-Real.eulerMascheroniConstant) / Real.log x))
    (hRHO : 0 < FordAnalysis.rho ∧ FordAnalysis.rho < 3 / 4 ∧ FordAnalysis.F FordAnalysis.rho = 1) :
    ∃ c : ℝ, 0 < c ∧ ∀ A : ℝ, 0 ≤ A →
      ∀ᶠ M : ℕ in atTop, ∀ᶠ y : ℝ in atTop,
        ∀ p : Fin (FordScale.coreDimension M (logLog y)),
          p.val + 1 = FordScale.coreDimension M (logLog y) →
          c * (y / Real.log y) * (logLog y) ^ (FordScale.coreDimension M (logLog y)) *
              FordGeometry.T (FordScale.coreDimension M (logLog y)) ≤
            ((FordLower.primeProducts (FordReciprocal.tupleIntegers
              (FordScale.coreDimension M (logLog y)) (logLog y)
              (FordInner.innerSeed (FordInner.targetParameter (FordScale.coreDimension M (logLog y)) M)
                p (A / logLog y))) y).card : ℝ) :=
by
  obtain ⟨c₁, hc₁, hmass⟩ := tupleIntegers_reciprocal_mass_lower prime_reciprocal_log_error
  have hREN := ford_renewal_scaled_bounds hRHO
  have hLL : Tendsto logLog atTop atTop :=
    Real.tendsto_log_atTop.comp Real.tendsto_log_atTop
  refine ⟨c₁ * Real.exp (-1) / 4, by positivity, ?_⟩
  intro A hA
  obtain ⟨β, hβ, hD2⟩ := core_seed_erosion_cap_lower hRHO hREN A hA
  have hD1 := ordered_core_cap_half hRHO hREN β hβ
  filter_upwards [hD2, hD1] with M hD2M hD1M
  filter_upwards [hLL.eventually hD2M, hLL.eventually hD1M, core_tupleIntegers_size_bounds hRHO M,
    primeProducts_count_lower_uniform hPNT, hLL.eventually_gt_atTop 0,
    eventually_gt_atTop (1 : ℝ)] with y h2 h1 hsz hcnt ht hy
  intro p hp
  have hE : FordInner.innerSeed (FordInner.targetParameter (FordScale.coreDimension M (logLog y)) M)
      p (A / logLog y) ⊆ Set.Icc (fun _ => (0 : ℝ)) (fun _ => 1) :=
    fun x hx => ⟨fun i => hx.1.1.1 i, fun i => hx.1.1.2.1 i⟩
  have hanti : ∀ x ∈ FordInner.innerSeed
      (FordInner.targetParameter (FordScale.coreDimension M (logLog y)) M) p (A / logLog y),
      Antitone x := fun x hx => hx.1.1.2.2.1
  have hvol := (mul_le_mul_of_nonneg_left (h1 p hp) (Real.exp_pos (-1)).le).trans (h2 p hp)
  have hm := hmass _ (logLog y) _ ht hE hanti
  have hcount := hcnt _ (fun n hn => (hsz p A n hn).1) (fun n hn => (hsz p A n hn).2.1)
    (fun n hn => (hsz p A n hn).2.2)
  have hlog : 0 < Real.log y := Real.log_pos hy
  have hfac : 0 ≤ y / (2 * Real.log y) := by positivity
  have hct : 0 ≤ c₁ * (logLog y) ^ (FordScale.coreDimension M (logLog y)) :=
    mul_nonneg hc₁.le (pow_nonneg ht.le _)
  have hchain := mul_le_mul_of_nonneg_left hvol hct
  calc
    c₁ * Real.exp (-1) / 4 * (y / Real.log y) * (logLog y) ^ (FordScale.coreDimension M (logLog y)) *
        FordGeometry.T (FordScale.coreDimension M (logLog y))
        = (y / (2 * Real.log y)) *
          ((c₁ * (logLog y) ^ (FordScale.coreDimension M (logLog y))) *
            (Real.exp (-1) * (FordGeometry.T (FordScale.coreDimension M (logLog y)) / 2))) := by
      ring
    _ ≤ (y / (2 * Real.log y)) * (∑ n ∈ FordReciprocal.tupleIntegers
          (FordScale.coreDimension M (logLog y)) (logLog y)
          (FordInner.innerSeed (FordInner.targetParameter (FordScale.coreDimension M (logLog y)) M)
            p (A / logLog y)), invTotient n) := by
      apply mul_le_mul_of_nonneg_left _ hfac
      refine hchain.trans ?_
      refine le_of_eq_of_le ?_ hm
      ring
    _ ≤ _ := hcount

theorem core_prefix_families (hPNT : Tendsto (fun x : ℝ => (Nat.primeCounting ⌊x⌋₊ : ℝ) / (x / Real.log x)) atTop (𝓝 1))
    (hMERT : ∃ C : ℝ, ∀ x : ℝ, 2 ≤ x →
      |(∑ p ∈ (Finset.Iic ⌊x⌋₊).filter Nat.Prime, (1 : ℝ) / p) - Real.log (Real.log x)| ≤ C)
    (hEULER : Asymptotics.IsEquivalent atTop
      (fun x : ℝ => ∏ p ∈ (Finset.Iic ⌊x⌋₊).filter Nat.Prime, (1 - (1 : ℝ) / p))
      (fun x => Real.exp (-Real.eulerMascheroniConstant) / Real.log x))
    (hRHO : 0 < FordAnalysis.rho ∧ FordAnalysis.rho < 3 / 4 ∧ FordAnalysis.F FordAnalysis.rho = 1)
    (M : ℕ) : ∀ᶠ y : ℝ in atTop,
      ∀ (a : Fin (FordScale.coreDimension M (logLog y))),
        a.val + 1 = FordScale.coreDimension M (logLog y) →
        ∀ A : ℝ, 0 < A →
          ∃ q : ℕ → Fin (FordScale.coreDimension M (logLog y) + 1) → ℕ,
            (∀ n ∈ FordLower.primeProducts (FordReciprocal.tupleIntegers
                (FordScale.coreDimension M (logLog y)) (logLog y)
                (FordInner.innerSeed (FordInner.targetParameter (FordScale.coreDimension M (logLog y)) M)
                  a (A / logLog y))) y,
              ∃ R : FordLower.PrimeProductRecord M A y a n, R.fullTuple = q n) ∧
            (((FordLower.primeProducts (FordReciprocal.tupleIntegers
                (FordScale.coreDimension M (logLog y)) (logLog y)
                (FordInner.innerSeed (FordInner.targetParameter (FordScale.coreDimension M (logLog y)) M)
                  a (A / logLog y))) y).card : ℝ) ≤
              V y + ∑ j ∈ Finset.range (FordScale.coreDimension M (logLog y) + 1),
                ((FordLower.prefixCollisionClass (FordLower.primeProducts (FordReciprocal.tupleIntegers
                  (FordScale.coreDimension M (logLog y)) (logLog y)
                  (FordInner.innerSeed (FordInner.targetParameter (FordScale.coreDimension M (logLog y)) M)
                    a (A / logLog y))) y) q j).card : ℝ)) :=
have pf_tupleIntegers_rpow_small : ∀
    (hRHO : 0 < FordAnalysis.rho ∧ FordAnalysis.rho < 3 / 4 ∧ FordAnalysis.F FordAnalysis.rho = 1)
    (M : ℕ), ∀ᶠ y : ℝ in atTop,
      ∀ (a : Fin (FordScale.coreDimension M (logLog y))) (A : ℝ) (n : ℕ),
        n ∈ FordReciprocal.tupleIntegers (FordScale.coreDimension M (logLog y)) (logLog y)
          (FordInner.innerSeed (FordInner.targetParameter (FordScale.coreDimension M (logLog y)) M)
            a (A / logLog y)) →
        (n : ℝ) ≤ y ^ (1 / 40 : ℝ) := by
  intro hRHO M
  have hLL : Tendsto logLog atTop atTop := Real.tendsto_log_atTop.comp Real.tendsto_log_atTop
  have hρ0 := hRHO.1
  have hlog34 : Real.log (3 / 4) < -1 / 4 := by
    rw [Real.log_lt_iff_lt_exp (by norm_num)]
    have := Real.add_one_lt_exp (x := (-1 / 4 : ℝ)) (by norm_num)
    linarith
  have hlρ : Real.log FordAnalysis.rho < Real.log (3 / 4) := Real.log_lt_log hρ0 hRHO.2.1
  have habs : |Real.log FordAnalysis.rho| = -Real.log FordAnalysis.rho :=
    abs_of_neg (by linarith)
  have hapos : 0 < 2 * |Real.log FordAnalysis.rho| := by rw [habs]; linarith
  have hCdef : FordAnalysis.C = (2 * |Real.log FordAnalysis.rho|)⁻¹ := rfl
  have hCpos : 0 < FordAnalysis.C := by rw [hCdef]; exact inv_pos.mpr hapos
  have hCmul : FordAnalysis.C * (2 * |Real.log FordAnalysis.rho|) = 1 := by
    rw [hCdef]; exact inv_mul_cancel₀ hapos.ne'
  have hClt : FordAnalysis.C < 2 := by
    rw [habs] at hCmul
    nlinarith
  have hdim : ∀ t : ℝ, Real.exp 1 ≤ t → (FordScale.optimalDimension t : ℝ) ≤ 4 * Real.log t := by
    intro t ht
    have hlogt : 1 ≤ Real.log t := by
      have := Real.log_le_log (Real.exp_pos 1) ht
      rwa [Real.log_exp] at this
    have hloglogt : 0 ≤ Real.log (Real.log t) := Real.log_nonneg hlogt
    have hbound : 2 * FordAnalysis.C * (Real.log t - Real.log (Real.log t)) ≤
        4 * Real.log t := by nlinarith
    unfold FordScale.optimalDimension
    by_cases hu : 0 ≤ 2 * FordAnalysis.C * (Real.log t - Real.log (Real.log t))
    · exact (Nat.floor_le hu).trans hbound
    · rw [Nat.floor_of_nonpos (le_of_not_ge hu)]
      simp only [Nat.cast_zero]
      linarith
  have hpoly : ∀ (k : ℕ) (K : ℝ), ∀ᶠ t : ℝ in atTop, K * Real.log t ^ k ≤ t := by
    intro k K
    have h := (Real.isLittleO_pow_log_id_atTop (n := k)).const_mul_left K
    filter_upwards [h.bound (by norm_num : (0 : ℝ) < 1), eventually_ge_atTop (0 : ℝ)] with t hb ht
    simp only [Real.norm_eq_abs, one_mul, id_eq] at hb
    rw [abs_of_nonneg ht] at hb
    exact (le_abs_self _).trans hb
  filter_upwards [eventually_gt_atTop (1 : ℝ), hLL.eventually_ge_atTop (Real.exp 1),
    hLL.eventually (hpoly 4 640), hLL.eventually (hpoly 1 160)] with y hy ht h640 h160
  intro a A n hn
  simp only [pow_one] at h160
  have htpos : 0 < logLog y := lt_of_lt_of_le (Real.exp_pos 1) ht
  have hL : 0 < FordScale.coreDimension M (logLog y) := Fin.pos a
  have hopt1 : 1 ≤ FordScale.optimalDimension (logLog y) := by
    unfold FordScale.coreDimension at hL
    omega
  have hLM : M + FordScale.coreDimension M (logLog y) = FordScale.optimalDimension (logLog y) := by
    unfold FordScale.coreDimension at hL ⊢
    omega
  have hxi : FordInner.targetParameter (FordScale.coreDimension M (logLog y)) M 0 =
      1 - FordLower.topLoss (logLog y) := by
    simp only [FordInner.targetParameter, if_pos hL, FordLower.topLoss, FordInner.baseLoss,
      Nat.sub_zero, hLM]
  have hloglog : 0 ≤ Real.log (logLog y) :=
    Real.log_nonneg ((Real.one_le_exp (by norm_num)).trans ht)
  have hδ : Real.log (logLog y) ≤ FordLower.topLoss (logLog y) * logLog y := by
    have hd := hdim _ ht
    have hcube := pow_le_pow_left₀ (Nat.cast_nonneg (FordScale.optimalDimension (logLog y))) hd 3
    have hbound : 10 * (FordScale.optimalDimension (logLog y) : ℝ) ^ 3 * Real.log (logLog y) ≤
        640 * Real.log (logLog y) ^ 4 := by
      calc _ ≤ 10 * (4 * Real.log (logLog y)) ^ 3 * Real.log (logLog y) :=
            mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hcube (by norm_num)) hloglog
        _ = _ := by ring
    have hNreal : (0 : ℝ) < FordScale.optimalDimension (logLog y) := by exact_mod_cast hopt1
    have hden : 0 < 10 * (FordScale.optimalDimension (logLog y) : ℝ) ^ 3 := by positivity
    unfold FordLower.topLoss
    rw [div_mul_eq_mul_div, one_mul]
    exact (le_div_iff₀ hden).mpr (by nlinarith [hbound.trans h640])
  simp only [FordReciprocal.tupleIntegers, Finset.mem_filter, Finset.mem_Icc] at hn
  obtain ⟨⟨hn1, _⟩, q, hprod, hq, _, hpoint⟩ := hn
  have hi : ∀ i, FordReciprocal.tuplePoint (logLog y) q i ≤ 1 - FordLower.topLoss (logLog y) := by
    intro i
    let p0 : Fin (FordScale.coreDimension M (logLog y)) := ⟨0, hL⟩
    rw [← hxi]
    exact (hpoint.1.1.2.2.1 (show p0 ≤ i from Nat.zero_le _)).trans (hpoint.2 p0 rfl)
  have hfac : ∀ i, Real.log (q i : ℝ) ≤
      Real.exp ((1 - FordLower.topLoss (logLog y)) * logLog y) := by
    intro i
    rcases hq i with hp | h1
    · have hq1 : (1 : ℝ) < q i := by exact_mod_cast hp.one_lt
      have hm : max 0 (logLog (q i)) ≤ (1 - FordLower.topLoss (logLog y)) * logLog y :=
        (div_le_iff₀ htpos).mp (hi i)
      have hll : Real.log (Real.log (q i)) ≤ (1 - FordLower.topLoss (logLog y)) * logLog y :=
        (le_max_right _ _).trans hm
      exact (Real.log_le_iff_le_exp (Real.log_pos hq1)).mp hll
    · rw [h1, Nat.cast_one, Real.log_one]
      exact (Real.exp_pos _).le
  have hne : ∀ i, (q i : ℝ) ≠ 0 := by
    intro i
    apply Nat.cast_ne_zero.mpr
    rcases hq i with h | h
    · exact h.ne_zero
    · omega
  have hlogn : Real.log (n : ℝ) ≤ (FordScale.coreDimension M (logLog y) : ℝ) *
      Real.exp ((1 - FordLower.topLoss (logLog y)) * logLog y) := by
    rw [← hprod, Nat.cast_prod, Real.log_prod (fun i _ => hne i)]
    calc _ ≤ ∑ _i : Fin (FordScale.coreDimension M (logLog y)),
          Real.exp ((1 - FordLower.topLoss (logLog y)) * logLog y) :=
          Finset.sum_le_sum (fun i _ => hfac i)
      _ = _ := by simp
  have hexp : Real.exp ((1 - FordLower.topLoss (logLog y)) * logLog y) ≤
      Real.exp (logLog y) / logLog y := by
    calc _ ≤ Real.exp (logLog y - Real.log (logLog y)) := Real.exp_le_exp.mpr (by nlinarith)
      _ = _ := by rw [Real.exp_sub, Real.exp_log htpos]
  have hel : Real.exp (logLog y) = Real.log y := Real.exp_log (Real.log_pos hy)
  have hlogy : 0 < Real.log y := Real.log_pos hy
  have hLle : (FordScale.coreDimension M (logLog y) : ℝ) ≤ 4 * Real.log (logLog y) :=
    (Nat.cast_le.mpr (Nat.sub_le _ _)).trans (hdim _ ht)
  have hfinal : Real.log (n : ℝ) ≤ (1 / 40) * Real.log y := by
    calc Real.log (n : ℝ) ≤ (FordScale.coreDimension M (logLog y) : ℝ) *
          Real.exp ((1 - FordLower.topLoss (logLog y)) * logLog y) := hlogn
      _ ≤ (4 * Real.log (logLog y)) * (Real.log y / logLog y) :=
          mul_le_mul hLle (hexp.trans_eq (by rw [hel])) (Real.exp_pos _).le (by positivity)
      _ = (4 * Real.log (logLog y) / logLog y) * Real.log y := by ring
      _ ≤ (1 / 40) * Real.log y := by
          apply mul_le_mul_of_nonneg_right _ hlogy.le
          rw [div_le_iff₀ htpos]
          linarith
  have hnpos : (0 : ℝ) < n := by exact_mod_cast hn1
  calc (n : ℝ) ≤ Real.exp ((1 / 40) * Real.log y) := (Real.log_le_iff_le_exp hnpos).mp hfinal
    _ = y ^ (1 / 40 : ℝ) := by
      rw [Real.rpow_def_of_pos (by linarith)]
      congr 1
      ring

have pf_lowerPrimeChoices_large : ∀ᶠ y : ℝ in atTop,
    ∀ n : ℕ, 0 < n → (n : ℝ) ≤ y ^ (1 / 40 : ℝ) →
      ∀ p ∈ FordLower.lowerPrimeChoices y n, y ^ (19 / 20 : ℝ) < (p : ℝ) ∧ n < p := by
  have hLL : Tendsto logLog atTop atTop := Real.tendsto_log_atTop.comp Real.tendsto_log_atTop
  filter_upwards [(isLittleO_log_rpow_atTop (by norm_num : (0 : ℝ) < 1 / 40)).bound
      (by norm_num : (0 : ℝ) < 1),
    hLL.eventually_ge_atTop 1, eventually_gt_atTop (1 : ℝ)] with y hb ht hy
  have hy0 : 0 < y := by linarith
  have hlog : 0 ≤ Real.log y := (Real.log_pos hy).le
  simp only [Real.norm_eq_abs, one_mul, abs_of_nonneg hlog,
    abs_of_nonneg (Real.rpow_nonneg hy0.le (1 / 40 : ℝ))] at hb
  have ht0 : 0 < logLog y := by linarith
  have hsqrt : Real.sqrt (logLog y) ≤ logLog y := by
    have hs := Real.sq_sqrt ht0.le
    have hn := Real.sqrt_nonneg (logLog y)
    nlinarith
  have hs : Real.sqrt (logLog y) ≤ y ^ (1 / 40 : ℝ) :=
    hsqrt.trans ((Real.log_le_self hlog).trans hb)
  have hcLF : y ^ (-(1 / 40) : ℝ) ≤ coreLowerFraction y := by
    calc y ^ (-(1 / 40) : ℝ) = 1 / (y ^ (1 / 40 : ℝ)) := by rw [Real.rpow_neg hy0.le, inv_eq_one_div]
      _ ≤ 1 / Real.sqrt (logLog y) :=
        div_le_div_of_nonneg_left (by norm_num) (Real.sqrt_pos.mpr ht0) hs
      _ = coreLowerFraction y := rfl
  intro n hn hsize p hp
  have hφ : (0 : ℝ) < n.totient := by exact_mod_cast Nat.totient_pos.mpr hn
  have hφsize : (n.totient : ℝ) ≤ y ^ (1 / 40 : ℝ) :=
    (Nat.cast_le.mpr (Nat.totient_le n)).trans hsize
  obtain ⟨⟨b, P'⟩, hbp, hbpP⟩ := Finset.mem_image.mp hp
  simp only [corePairs, Finset.mem_filter, Finset.product_eq_sprod, Finset.mem_product,
    Finset.mem_singleton] at hbp
  obtain ⟨⟨hb, _⟩, hpr, hlo, _⟩ := hbp
  have hPe : P' = p := hbpP
  rw [hPe, hb] at hlo
  rw [hPe] at hpr
  simp only [corePairValue] at hlo
  rw [Nat.cast_mul, Nat.cast_sub hpr.one_lt.le, Nat.cast_one] at hlo
  have e1 : y ^ (-(1 / 40) : ℝ) * y = y ^ (39 / 40 : ℝ) := by
    rw [← Real.rpow_add_one hy0.ne']
    norm_num
  have e2 : y ^ (19 / 20 : ℝ) * y ^ (1 / 40 : ℝ) = y ^ (39 / 40 : ℝ) := by
    rw [← Real.rpow_add hy0]
    norm_num
  have h1 : y ^ (19 / 20 : ℝ) * (n.totient : ℝ) < ((p : ℝ) - 1) * n.totient := by
    calc y ^ (19 / 20 : ℝ) * (n.totient : ℝ) ≤ y ^ (19 / 20 : ℝ) * y ^ (1 / 40 : ℝ) :=
          mul_le_mul_of_nonneg_left hφsize (Real.rpow_nonneg hy0.le _)
      _ = y ^ (-(1 / 40) : ℝ) * y := by rw [e1, e2]
      _ ≤ coreLowerFraction y * y := mul_le_mul_of_nonneg_right hcLF hy0.le
      _ < _ := hlo
  have h2 : y ^ (19 / 20 : ℝ) < (p : ℝ) - 1 := lt_of_mul_lt_mul_right h1 hφ.le
  have hlarge : y ^ (19 / 20 : ℝ) < (p : ℝ) := by linarith
  have hnp : (n : ℝ) < p := hsize.trans_lt
    ((Real.rpow_le_rpow_of_exponent_le hy.le (by norm_num : (1 / 40 : ℝ) ≤ 19 / 20)).trans_lt hlarge)
  exact ⟨hlarge, by exact_mod_cast hnp⟩

have pf_top_log_gap : ∀
    (hRHO : 0 < FordAnalysis.rho ∧ FordAnalysis.rho < 3 / 4 ∧ FordAnalysis.F FordAnalysis.rho = 1)
    (M : ℕ), ∀ᶠ y : ℝ in atTop,
      ∀ (a : Fin (FordScale.coreDimension M (logLog y))) (A : ℝ)
        (q : Fin (FordScale.coreDimension M (logLog y)) → ℕ) (P : ℕ),
        FordReciprocal.tuplePoint (logLog y) q ∈
          FordInner.innerSeed (FordInner.targetParameter (FordScale.coreDimension M (logLog y)) M)
            a (A / logLog y) →
        y ^ (19 / 20 : ℝ) < (P : ℝ) →
        ∀ idx : Fin (FordScale.coreDimension M (logLog y)), idx.val = 0 →
          (1 + FordLower.topLoss (logLog y)) * logLog (q idx) ≤ logLog (P : ℝ) := by
  intro hRHO M
  have hLL : Tendsto logLog atTop atTop := Real.tendsto_log_atTop.comp Real.tendsto_log_atTop
  have hρ0 := hRHO.1
  have hlog34 : Real.log (3 / 4) < -1 / 4 := by
    rw [Real.log_lt_iff_lt_exp (by norm_num)]
    have := Real.add_one_lt_exp (x := (-1 / 4 : ℝ)) (by norm_num)
    linarith
  have hlρ : Real.log FordAnalysis.rho < Real.log (3 / 4) := Real.log_lt_log hρ0 hRHO.2.1
  have habs : |Real.log FordAnalysis.rho| = -Real.log FordAnalysis.rho :=
    abs_of_neg (by linarith)
  have hapos : 0 < 2 * |Real.log FordAnalysis.rho| := by rw [habs]; linarith
  have hCdef : FordAnalysis.C = (2 * |Real.log FordAnalysis.rho|)⁻¹ := rfl
  have hCpos : 0 < FordAnalysis.C := by rw [hCdef]; exact inv_pos.mpr hapos
  have hCmul : FordAnalysis.C * (2 * |Real.log FordAnalysis.rho|) = 1 := by
    rw [hCdef]; exact inv_mul_cancel₀ hapos.ne'
  have hClt : FordAnalysis.C < 2 := by
    rw [habs] at hCmul
    nlinarith
  have hdim : ∀ t : ℝ, Real.exp 1 ≤ t → (FordScale.optimalDimension t : ℝ) ≤ 4 * Real.log t := by
    intro t ht
    have hlogt : 1 ≤ Real.log t := by
      have := Real.log_le_log (Real.exp_pos 1) ht
      rwa [Real.log_exp] at this
    have hloglogt : 0 ≤ Real.log (Real.log t) := Real.log_nonneg hlogt
    have hbound : 2 * FordAnalysis.C * (Real.log t - Real.log (Real.log t)) ≤
        4 * Real.log t := by nlinarith
    unfold FordScale.optimalDimension
    by_cases hu : 0 ≤ 2 * FordAnalysis.C * (Real.log t - Real.log (Real.log t))
    · exact (Nat.floor_le hu).trans hbound
    · rw [Nat.floor_of_nonpos (le_of_not_ge hu)]
      simp only [Nat.cast_zero]
      linarith
  have hpoly : ∀ (k : ℕ) (K : ℝ), ∀ᶠ t : ℝ in atTop, K * Real.log t ^ k ≤ t := by
    intro k K
    have h := (Real.isLittleO_pow_log_id_atTop (n := k)).const_mul_left K
    filter_upwards [h.bound (by norm_num : (0 : ℝ) < 1), eventually_ge_atTop (0 : ℝ)] with t hb ht
    simp only [Real.norm_eq_abs, one_mul, id_eq] at hb
    rw [abs_of_nonneg ht] at hb
    exact (le_abs_self _).trans hb
  filter_upwards [eventually_gt_atTop (1 : ℝ), hLL.eventually_ge_atTop (Real.exp 1),
    hLL.eventually (hpoly 6 409600)] with y hy ht h6
  intro a A q P hx hP idx hi
  have htpos : 0 < logLog y := lt_of_lt_of_le (Real.exp_pos 1) ht
  have hL : 0 < FordScale.coreDimension M (logLog y) := Fin.pos a
  have hopt1 : 1 ≤ FordScale.optimalDimension (logLog y) := by
    unfold FordScale.coreDimension at hL
    omega
  have hLM : M + FordScale.coreDimension M (logLog y) = FordScale.optimalDimension (logLog y) := by
    unfold FordScale.coreDimension at hL ⊢
    omega
  have hxi : FordInner.targetParameter (FordScale.coreDimension M (logLog y)) M 0 =
      1 - FordLower.topLoss (logLog y) := by
    simp only [FordInner.targetParameter, if_pos hL, FordLower.topLoss, FordInner.baseLoss,
      Nat.sub_zero, hLM]
  have hmargin : 1 ≤ FordLower.topLoss (logLog y) ^ 2 * logLog y := by
    have hd := hdim _ ht
    have hsix := pow_le_pow_left₀ (Nat.cast_nonneg (FordScale.optimalDimension (logLog y))) hd 6
    have hbound : 100 * (FordScale.optimalDimension (logLog y) : ℝ) ^ 6 ≤
        409600 * Real.log (logLog y) ^ 6 := by
      calc _ ≤ 100 * (4 * Real.log (logLog y)) ^ 6 := mul_le_mul_of_nonneg_left hsix (by norm_num)
        _ = _ := by ring
    have hNreal : (0 : ℝ) < FordScale.optimalDimension (logLog y) := by exact_mod_cast hopt1
    have hden : 0 < 100 * (FordScale.optimalDimension (logLog y) : ℝ) ^ 6 := by positivity
    have heq : FordLower.topLoss (logLog y) ^ 2 * logLog y =
        logLog y / (100 * (FordScale.optimalDimension (logLog y) : ℝ) ^ 6) := by
      unfold FordLower.topLoss
      rw [div_pow, one_pow, mul_pow]
      field_simp
      ring
    rw [heq, le_div_iff₀ hden, one_mul]
    linarith
  have hm : max 0 (logLog (q idx)) ≤
      FordInner.targetParameter (FordScale.coreDimension M (logLog y)) M 0 * logLog y :=
    (div_le_iff₀ htpos).mp (hx.2 idx hi)
  have hq : logLog (q idx) ≤ (1 - FordLower.topLoss (logLog y)) * logLog y := by
    rw [← hxi]
    exact (le_max_right _ _).trans hm
  have hδ : 0 ≤ FordLower.topLoss (logLog y) := by
    unfold FordLower.topLoss
    positivity
  have hPlow : logLog y - 1 ≤ logLog (P : ℝ) := by
    have hy0 : 0 < y := by linarith
    have hpow : 1 < y ^ (19 / 20 : ℝ) := by
      rw [Real.rpow_def_of_pos hy0]
      exact Real.one_lt_exp_iff.mpr (mul_pos (Real.log_pos hy) (by norm_num))
    have hr : -1 ≤ Real.log (19 / 20 : ℝ) := by
      have h := Real.one_sub_inv_le_log_of_pos (by norm_num : (0 : ℝ) < 19 / 20)
      norm_num at h
      linarith
    have heq : logLog (y ^ (19 / 20 : ℝ)) = logLog y + Real.log (19 / 20 : ℝ) := by
      unfold logLog
      rw [Real.rpow_def_of_pos hy0, Real.log_exp,
        Real.log_mul (Real.log_pos hy).ne' (by norm_num)]
    have hmono : logLog (y ^ (19 / 20 : ℝ)) ≤ logLog (P : ℝ) := by
      unfold logLog
      exact Real.log_le_log (Real.log_pos hpow) (Real.log_le_log (by linarith) hP.le)
    linarith
  calc _ ≤ (1 + FordLower.topLoss (logLog y)) * ((1 - FordLower.topLoss (logLog y)) * logLog y) :=
        mul_le_mul_of_nonneg_left hq (by linarith)
    _ = logLog y - FordLower.topLoss (logLog y) ^ 2 * logLog y := by ring
    _ ≤ logLog y - 1 := by linarith
    _ ≤ _ := hPlow

have pf_innerSeed_tuple_structure : ∀ {L M : ℕ} {t A : ℝ} (ht : 0 < t) (hA : 0 < A)
    {q : Fin L → ℕ} (hq : ∀ idx, (q idx).Prime ∨ q idx = 1) (p : Fin L) (hp : p.val + 1 = L)
    (hx : FordReciprocal.tuplePoint t q ∈ FordInner.innerSeed (FordInner.targetParameter L M) p (A / t)),
    (∀ idx, (q idx).Prime) ∧ StrictAnti q ∧ (∀ idx, Real.exp (Real.exp A) ≤ (q idx : ℝ)) ∧
      (∀ idx j : Fin L, j.val = idx.val + 1 →
        (1 + FordInner.baseLoss M (L - (idx.val + 1))) * logLog (q j) ≤ logLog (q idx)) := by
  intro L M t A ht hA q hq p hp hx
  have hlow : ∀ idx : Fin L, A ≤ logLog (q idx) := by
    intro idx
    have hip : idx ≤ p := by change idx.val ≤ p.val; have := idx.isLt; omega
    have hAi : A / t ≤ FordReciprocal.tuplePoint t q idx := hx.1.2.2.trans (hx.1.1.2.2.1 hip)
    have hm : A ≤ max 0 (logLog (q idx)) := (div_le_div_iff_of_pos_right ht).mp hAi
    by_cases hlog : 0 ≤ logLog (q idx)
    · simpa only [max_eq_right hlog] using hm
    · have hbad : A ≤ 0 := by simpa only [max_eq_left (le_of_not_ge hlog)] using hm
      linarith
  have hprime : ∀ idx, (q idx).Prime := by
    intro idx
    rcases hq idx with hi | hi
    · exact hi
    · have hlog := hlow idx
      simp only [hi, Nat.cast_one, logLog, Real.log_one, Real.log_zero] at hlog
      linarith
  have heq : ∀ idx, FordReciprocal.tuplePoint t q idx = logLog (q idx) / t := by
    intro idx
    have hlog : 0 ≤ logLog (q idx) := hA.le.trans (hlow idx)
    simp only [FordReciprocal.tuplePoint, max_eq_right hlog]
  have hbase : ∀ d, 0 ≤ FordInner.baseLoss M d := by
    intro d
    unfold FordInner.baseLoss
    positivity
  have hlt1 : ∀ j, j < L → FordInner.targetParameter L M j < 1 := by
    intro j hj
    have hN : (0 : ℝ) < ((M + (L - j) : ℕ) : ℝ) := by
      exact_mod_cast (show 0 < M + (L - j) by omega)
    have hδ : 0 < FordInner.baseLoss M (L - j) := by
      unfold FordInner.baseLoss
      positivity
    simp only [FordInner.targetParameter, if_pos hj]
    linarith
  have hpos : ∀ idx, 0 < FordReciprocal.tuplePoint t q idx := by
    intro idx
    rw [heq idx]
    exact div_pos (hA.trans_le (hlow idx)) ht
  have hsa : ∀ {K : ℕ} {x : Fin K → ℝ},
      (∀ idx j : Fin K, j.val = idx.val + 1 → x j < x idx) → StrictAnti x := by
    intro K x h
    cases K with
    | zero => intro idx; exact Fin.elim0 idx
    | succ k => exact Fin.strictAnti_iff_succ_lt.mpr (fun idx => h idx.castSucc idx.succ rfl)
  have hs : StrictAnti (FordReciprocal.tuplePoint t q) := by
    apply hsa
    intro idx j hij
    have hj : idx.val + 1 < L := by have := j.isLt; omega
    have hgap := hx.1.2.1 idx j hij
    have hxi := hlt1 _ hj
    nlinarith [hpos idx]
  have hanti : StrictAnti q := by
    intro idx j hij
    by_contra hnot
    have hqi : (1 : ℝ) < q idx := by exact_mod_cast (hprime idx).one_lt
    have hqij : q idx ≤ q j := by omega
    have hmono : logLog (q idx) ≤ logLog (q j) := by
      unfold logLog
      have h1 : (0 : ℝ) < q idx := by linarith
      have hc : (q idx : ℝ) ≤ q j := by exact_mod_cast hqij
      exact Real.log_le_log (Real.log_pos hqi) (Real.log_le_log h1 hc)
    have h2 := hs hij
    rw [heq, heq] at h2
    have h3 := (div_lt_div_iff_of_pos_right ht).mp h2
    linarith
  have hentry : ∀ idx, Real.exp (Real.exp A) ≤ (q idx : ℝ) := by
    intro idx
    have hq1 : (1 : ℝ) < q idx := by exact_mod_cast (hprime idx).one_lt
    have hlog := Real.exp_le_exp.mpr (hlow idx)
    simp only [logLog, Real.exp_log (Real.log_pos hq1)] at hlog
    have h := Real.exp_le_exp.mpr hlog
    simpa only [Real.exp_log (by linarith : (0 : ℝ) < q idx)] using h
  have hgaps : ∀ idx j : Fin L, j.val = idx.val + 1 →
      (1 + FordInner.baseLoss M (L - (idx.val + 1))) * logLog (q j) ≤ logLog (q idx) := by
    intro idx j hij
    have hj : idx.val + 1 < L := by have := j.isLt; omega
    have hg := hx.1.2.1 idx j hij
    rw [heq idx, heq j] at hg
    have hg' : logLog (q j) ≤
        (1 - FordInner.baseLoss M (L - (idx.val + 1))) * logLog (q idx) := by
      apply (div_le_div_iff_of_pos_right ht).mp
      simpa only [FordInner.targetParameter, if_pos hj, mul_div_assoc] using hg
    have hδ := hbase (L - (idx.val + 1))
    calc _ ≤ (1 + FordInner.baseLoss M (L - (idx.val + 1))) *
          ((1 - FordInner.baseLoss M (L - (idx.val + 1))) * logLog (q idx)) :=
          mul_le_mul_of_nonneg_left hg' (by linarith)
      _ = (1 - FordInner.baseLoss M (L - (idx.val + 1)) ^ 2) * logLog (q idx) := by ring
      _ ≤ _ := mul_le_of_le_one_left (hA.le.trans (hlow idx))
          (by nlinarith [sq_nonneg (FordInner.baseLoss M (L - (idx.val + 1)))])
  exact ⟨hprime, hanti, hentry, hgaps⟩

have pf_record_of_mem : ∀ (M : ℕ) (A y : ℝ) (a : Fin (FordScale.coreDimension M (logLog y)))
    (ha : a.val + 1 = FordScale.coreDimension M (logLog y)) (hA : 0 < A) (ht : 0 < logLog y)
    (hsmall : ∀ n ∈ FordReciprocal.tupleIntegers (FordScale.coreDimension M (logLog y)) (logLog y)
        (FordInner.innerSeed (FordInner.targetParameter (FordScale.coreDimension M (logLog y)) M)
          a (A / logLog y)), (n : ℝ) ≤ y ^ (1 / 40 : ℝ))
    (hlarge : ∀ n : ℕ, 0 < n → (n : ℝ) ≤ y ^ (1 / 40 : ℝ) →
        ∀ p ∈ FordLower.lowerPrimeChoices y n, y ^ (19 / 20 : ℝ) < (p : ℝ) ∧ n < p)
    (hgap : ∀ (q : Fin (FordScale.coreDimension M (logLog y)) → ℕ) (P : ℕ),
        FordReciprocal.tuplePoint (logLog y) q ∈
          FordInner.innerSeed (FordInner.targetParameter (FordScale.coreDimension M (logLog y)) M)
            a (A / logLog y) →
        y ^ (19 / 20 : ℝ) < (P : ℝ) →
        ∀ idx : Fin (FordScale.coreDimension M (logLog y)), idx.val = 0 →
          (1 + FordLower.topLoss (logLog y)) * logLog (q idx) ≤ logLog (P : ℝ))
    (hstruct : ∀ q : Fin (FordScale.coreDimension M (logLog y)) → ℕ,
        (∀ idx, (q idx).Prime ∨ q idx = 1) →
        FordReciprocal.tuplePoint (logLog y) q ∈
          FordInner.innerSeed (FordInner.targetParameter (FordScale.coreDimension M (logLog y)) M)
            a (A / logLog y) →
        (∀ idx, (q idx).Prime) ∧ StrictAnti q ∧ (∀ idx, Real.exp (Real.exp A) ≤ (q idx : ℝ)) ∧
          (∀ idx j : Fin (FordScale.coreDimension M (logLog y)), j.val = idx.val + 1 →
            (1 + FordInner.baseLoss M (FordScale.coreDimension M (logLog y) - (idx.val + 1))) *
              logLog (q j) ≤ logLog (q idx)))
    (N : ℕ)
    (hN : N ∈ FordLower.primeProducts (FordReciprocal.tupleIntegers
        (FordScale.coreDimension M (logLog y)) (logLog y)
        (FordInner.innerSeed (FordInner.targetParameter (FordScale.coreDimension M (logLog y)) M)
          a (A / logLog y))) y),
    Nonempty (FordLower.PrimeProductRecord M A y a N) := by
  intro M A y a ha hA ht hsmall hlarge hgap hstruct N hN
  obtain ⟨⟨n, P⟩, hnP, hNeq⟩ := Finset.mem_image.mp hN
  obtain ⟨hn, hP⟩ := Finset.mem_sigma.mp hnP
  have hNeq' : P * n = N := hNeq
  have hn' := hn
  simp only [FordReciprocal.tupleIntegers, Finset.mem_filter, Finset.mem_Icc] at hn'
  obtain ⟨⟨hn1, _⟩, q, hprod, hq, _, hpoint⟩ := hn'
  have hn0 : 0 < n := hn1
  have hleading := hlarge n hn0 (hsmall n hn) P hP
  have hPfacts : P.Prime ∧ coreLowerFraction y * y < (corePairValue (n.totient, P) : ℝ) ∧
      (corePairValue (n.totient, P) : ℝ) ≤ y := by
    obtain ⟨⟨b, P'⟩, hbp, hbpP⟩ := Finset.mem_image.mp hP
    simp only [corePairs, Finset.mem_filter, Finset.product_eq_sprod, Finset.mem_product,
      Finset.mem_singleton] at hbp
    obtain ⟨⟨hb, _⟩, hpr, hlo, hhi⟩ := hbp
    have hPe : P' = P := hbpP
    rw [hPe, hb] at hlo hhi
    rw [hPe] at hpr
    exact ⟨hpr, hlo, hhi⟩
  have hcop : Nat.Coprime P n :=
    (Nat.Prime.coprime_iff_not_dvd hPfacts.1).mpr (Nat.not_dvd_of_pos_of_lt hn0 hleading.2)
  have hφ : N.totient = corePairValue (n.totient, P) := by
    rw [← hNeq', Nat.totient_mul hcop, Nat.totient_prime hPfacts.1]
    rfl
  have hsep : ∀ idx, q idx < P := by
    intro idx
    have hdvd : q idx ∣ n := hprod ▸ Finset.dvd_prod_of_mem q (Finset.mem_univ idx)
    exact (Nat.le_of_dvd hn0 hdvd).trans_lt hleading.2
  obtain ⟨hpr, hanti, hmin, hgaps⟩ := hstruct q hq hpoint
  exact ⟨{
    leading := P
    lower := q
    terminal := ha
    leading_prime := hPfacts.1
    lower_prime := hpr
    lower_order := hanti
    point := hpoint
    integer := by rw [hprod]; exact hNeq'.symm
    leading_size := hleading.1
    lower_separated := hsep
    lower_minimum := hmin
    lower_gaps := hgaps
    leading_gap := hgap q P hpoint hleading.1
    totient_range := by rw [hφ]; exact ⟨hPfacts.2.1, hPfacts.2.2⟩ }⟩

have pf_card_le_V_add_collisions : ∀ (F : Finset ℕ) (y : ℝ)
    (hF : ∀ n ∈ F, 0 < n ∧ (n.totient : ℝ) ≤ y),
    (F.card : ℝ) ≤ V y + ((collisionPoints F Nat.totient).card : ℝ) := by
  intro F y hF
  have hCsub : collisionPoints F Nat.totient ⊆ F := by
    intro x hx
    simp only [collisionPoints, Finset.mem_filter] at hx
    exact hx.1
  have hmaps : ∀ n ∈ F \ collisionPoints F Nat.totient, n.totient ∈ totientsUpTo y := by
    intro n hn
    have hnF := (Finset.mem_sdiff.mp hn).1
    obtain ⟨hpos, hle⟩ := hF n hnF
    simp only [totientsUpTo, Finset.mem_filter, Finset.mem_Icc]
    exact ⟨⟨Nat.totient_pos.mpr hpos, Nat.le_floor hle⟩, n, rfl⟩
  have hinj : Set.InjOn Nat.totient ((F \ collisionPoints F Nat.totient : Finset ℕ) : Set ℕ) := by
    intro a ha b hb hab
    by_contra hne
    have ha' := Finset.mem_sdiff.mp (Finset.mem_coe.mp ha)
    have hb' := Finset.mem_sdiff.mp (Finset.mem_coe.mp hb)
    apply ha'.2
    simp only [collisionPoints, Finset.mem_filter]
    exact ⟨ha'.1, b, hb'.1, fun h => hne h.symm, hab.symm⟩
  have h1 : (F \ collisionPoints F Nat.totient).card ≤ (totientsUpTo y).card :=
    Finset.card_le_card_of_injOn Nat.totient (fun n hn => hmaps n hn) hinj
  have h2 : (F \ collisionPoints F Nat.totient).card + (collisionPoints F Nat.totient).card =
      F.card := Finset.card_sdiff_add_card_eq_card hCsub
  have hV : V y = ((totientsUpTo y).card : ℝ) := rfl
  rw [hV]
  have h3 : F.card ≤ (totientsUpTo y).card + (collisionPoints F Nat.totient).card := by omega
  exact_mod_cast h3

have pf_collisions_le_prefix_classes : ∀ {k : ℕ} (F : Finset ℕ) (q : ℕ → Fin k → ℕ)
    (hprime : ∀ n ∈ F, ∀ idx, (q n idx).Prime)
    (hprod : ∀ n ∈ F, (∏ idx, q n idx) = n),
    ((collisionPoints F Nat.totient).card : ℝ) ≤
      ∑ j ∈ Finset.range k, ((FordLower.prefixCollisionClass F q j).card : ℝ) := by
  intro k F q hprime hprod
  have hOmega : ∀ (f : Fin k → ℕ), (∀ i, (f i).Prime) → ∀ (s : Finset (Fin k)),
      ArithmeticFunction.cardFactors (∏ i ∈ s, f i) = s.card := by
    intro f hf s
    refine Finset.induction_on s ?_ ?_
    · simp
    · intro a s ha ih
      rw [Finset.prod_insert ha, ArithmeticFunction.cardFactors_mul (hf a).ne_zero
        (Finset.prod_ne_zero_iff.mpr (fun i _ => (hf i).ne_zero)),
        ArithmeticFunction.cardFactors_apply_prime (hf a), ih, Finset.card_insert_of_notMem ha]
      ring
  have hΩ : ∀ n ∈ F, ArithmeticFunction.cardFactors n = k := by
    intro n hn
    have h := hOmega (q n) (hprime n hn) Finset.univ
    rw [hprod n hn, Finset.card_univ, Fintype.card_fin] at h
    exact h
  have hpos : ∀ n ∈ F, 0 < n := by
    intro n hn
    rw [← hprod n hn]
    exact Finset.prod_pos (fun i _ => (hprime n hn i).pos)
  have hnodvd : ∀ n ∈ F, ∀ m ∈ F, n ∣ m → n = m := by
    intro n hn m hm hd
    obtain ⟨c, hc⟩ := hd
    have hm0 := hpos m hm
    have hn0 : n ≠ 0 := (hpos n hn).ne'
    have hc0 : c ≠ 0 := by
      rintro rfl
      rw [mul_zero] at hc
      omega
    have h := ArithmeticFunction.cardFactors_mul hn0 hc0
    rw [← hc, hΩ m hm, hΩ n hn] at h
    have hc1 : ArithmeticFunction.cardFactors c = 0 := by omega
    rcases ArithmeticFunction.cardFactors_eq_zero_iff_eq_zero_or_one.mp hc1 with h0 | h1
    · exact absurd h0 hc0
    · rw [hc, h1, mul_one]
  have hsub : collisionPoints F Nat.totient ⊆ FordLower.externalTotientCollisions F := by
    intro n hn
    simp only [collisionPoints, Finset.mem_filter] at hn
    obtain ⟨hnF, m, hmF, hne, hφ⟩ := hn
    refine Finset.mem_filter.mpr ⟨hnF, m, ?_⟩
    show 0 < m ∧ m.totient = n.totient ∧ ¬ n ∣ m
    exact ⟨hpos m hmF, hφ, fun hd => hne (hnodvd n hnF m hmF hd).symm⟩
  have hdepth : ∀ n ∈ FordLower.externalTotientCollisions F,
      FordLower.prefixDepth (q n) n < k := by
    intro n hn
    obtain ⟨hnF, m, hm⟩ := Finset.mem_filter.mp hn
    have hm' : 0 < m ∧ m.totient = n.totient ∧ ¬ n ∣ m := hm
    have h0 : 0 ∈ FordLower.prefixDepths (q n) n := by
      simp only [FordLower.prefixDepths, Finset.mem_filter, Finset.mem_range]
      refine ⟨Nat.succ_pos _, m, hm, ?_⟩
      refine ⟨m, hm'.1, ?_, fun idx h => absurd h (Nat.not_lt_zero _)⟩
      simp [FordLower.prefixProduct]
    have hne : (FordLower.prefixDepths (q n) n).Nonempty := ⟨0, h0⟩
    have hmem : FordLower.prefixDepth (q n) n ∈ FordLower.prefixDepths (q n) n := by
      rw [FordLower.prefixDepth, dif_pos hne]
      exact Finset.max'_mem _ _
    simp only [FordLower.prefixDepths, Finset.mem_filter, Finset.mem_range] at hmem
    obtain ⟨hlt, m₂, hm₂, w, hw, hm₂eq, _⟩ := hmem
    have hm₂' : 0 < m₂ ∧ m₂.totient = n.totient ∧ ¬ n ∣ m₂ := hm₂
    rcases Nat.lt_succ_iff_lt_or_eq.mp hlt with h | h
    · exact h
    · exfalso
      rw [h] at hm₂eq
      have hpp : FordLower.prefixProduct (q n) k = n := by
        rw [FordLower.prefixProduct, Finset.filter_true_of_mem (fun idx _ => idx.isLt)]
        exact hprod n hnF
      apply hm₂'.2.2
      rw [hm₂eq, hpp]
      exact Dvd.intro w rfl
  have hcard := Finset.card_eq_sum_card_fiberwise (f := fun n => FordLower.prefixDepth (q n) n)
    (s := FordLower.externalTotientCollisions F) (t := Finset.range k)
    (fun n hn => Finset.mem_range.mpr (hdepth n hn))
  calc ((collisionPoints F Nat.totient).card : ℝ)
      ≤ ((FordLower.externalTotientCollisions F).card : ℝ) := by
        exact_mod_cast Finset.card_le_card hsub
    _ = ∑ j ∈ Finset.range k, ((FordLower.prefixCollisionClass F q j).card : ℝ) := by
        rw [hcard, Nat.cast_sum]
        rfl
by
  have hLL : Tendsto logLog atTop atTop :=
    Real.tendsto_log_atTop.comp Real.tendsto_log_atTop
  filter_upwards [pf_tupleIntegers_rpow_small hRHO M, pf_lowerPrimeChoices_large,
    pf_top_log_gap hRHO M, hLL.eventually_gt_atTop 0] with y hsmall hlarge hgap ht
  intro a ha A hA
  have hR : ∀ N ∈ FordLower.primeProducts (FordReciprocal.tupleIntegers
      (FordScale.coreDimension M (logLog y)) (logLog y)
      (FordInner.innerSeed (FordInner.targetParameter (FordScale.coreDimension M (logLog y)) M)
        a (A / logLog y))) y, Nonempty (FordLower.PrimeProductRecord M A y a N) :=
    fun N hN => pf_record_of_mem M A y a ha hA ht (hsmall a A) hlarge (hgap a A)
      (fun q hq hx => pf_innerSeed_tuple_structure ht hA hq a ha hx) N hN
  let q : ℕ → Fin (FordScale.coreDimension M (logLog y) + 1) → ℕ := fun N =>
    if hN : N ∈ FordLower.primeProducts (FordReciprocal.tupleIntegers
      (FordScale.coreDimension M (logLog y)) (logLog y)
      (FordInner.innerSeed (FordInner.targetParameter (FordScale.coreDimension M (logLog y)) M)
        a (A / logLog y))) y then (Classical.choice (hR N hN)).fullTuple else fun _ => 2
  have hq : ∀ N ∈ FordLower.primeProducts (FordReciprocal.tupleIntegers
      (FordScale.coreDimension M (logLog y)) (logLog y)
      (FordInner.innerSeed (FordInner.targetParameter (FordScale.coreDimension M (logLog y)) M)
        a (A / logLog y))) y, ∃ R : FordLower.PrimeProductRecord M A y a N, R.fullTuple = q N := by
    intro N hN
    exact ⟨Classical.choice (hR N hN), by simp only [q, dif_pos hN]⟩
  have hfacts : ∀ N ∈ FordLower.primeProducts (FordReciprocal.tupleIntegers
      (FordScale.coreDimension M (logLog y)) (logLog y)
      (FordInner.innerSeed (FordInner.targetParameter (FordScale.coreDimension M (logLog y)) M)
        a (A / logLog y))) y,
      (∀ idx, (q N idx).Prime) ∧ (∏ idx, q N idx) = N ∧ 0 < N ∧ (N.totient : ℝ) ≤ y := by
    intro N hN
    obtain ⟨R, hRq⟩ := hq N hN
    rw [← hRq]
    have hpr : ∀ idx, (R.fullTuple idx).Prime := by
      intro idx
      refine Fin.cases ?_ (fun j => ?_) idx
      · simp only [FordLower.PrimeProductRecord.fullTuple, Fin.cons_zero]
        exact R.leading_prime
      · simp only [FordLower.PrimeProductRecord.fullTuple, Fin.cons_succ]
        exact R.lower_prime j
    have hprod : (∏ idx, R.fullTuple idx) = N := by
      simp only [FordLower.PrimeProductRecord.fullTuple, Fin.prod_univ_succ, Fin.cons_zero,
        Fin.cons_succ]
      exact R.integer.symm
    refine ⟨hpr, hprod, ?_, R.totient_range.2⟩
    rw [← hprod]
    exact Finset.prod_pos (fun idx _ => (hpr idx).pos)
  have h6 := pf_card_le_V_add_collisions _ y
    (fun N hN => ⟨(hfacts N hN).2.2.1, (hfacts N hN).2.2.2⟩)
  have h7 := pf_collisions_le_prefix_classes
    (k := FordScale.coreDimension M (logLog y) + 1) _ q
    (fun N hN => (hfacts N hN).1) (fun N hN => (hfacts N hN).2.1)
  exact ⟨q, hq, h6.trans (by linarith)⟩

theorem suffix_family_properties {k : ℕ} (F : Finset ℕ) (p : ℕ → Fin k → ℕ)
    (hp : ∀ n ∈ F, ∀ idx, (p n idx).Prime) (ho : ∀ n ∈ F, StrictAnti (p n))
    (hprod : ∀ n ∈ F, (∏ idx, p n idx) = n) (j : ℕ) {s : ℕ}
    (hs : s ∈ FordLower.suffixCollisionFamily F p j) :
    j < k ∧ 0 < s ∧ Squarefree s ∧ ArithmeticFunction.cardFactors s = k - j ∧
      (FordLower.nontrivialPreimages s).Nonempty ∧
      ∀ w ∈ FordLower.nontrivialPreimages s, largestPrimeFactor w ≠ largestPrimeFactor s :=
by
  classical
  
  have lpf_dvd : ∀ w : ℕ, largestPrimeFactor w ∣ w := by
    intro w
    unfold largestPrimeFactor
    rcases w.primeFactors.eq_empty_or_nonempty with h | h
    · rw [h, Finset.sup_empty]; simp
    · obtain ⟨r, hr, hsup⟩ := Finset.exists_mem_eq_sup _ h id
      simp only [hsup, id_eq]
      have h2 := (Nat.prime_of_mem_primeFactors hr).two_le
      rw [max_eq_right (by omega)]
      exact Nat.dvd_of_mem_primeFactors hr
  have le_lpf : ∀ w r : ℕ, w ≠ 0 → r.Prime → r ∣ w → r ≤ largestPrimeFactor w := by
    intro w r hw hr hd
    unfold largestPrimeFactor
    have hmem : r ∈ w.primeFactors := Nat.mem_primeFactors.mpr ⟨hr, hd, hw⟩
    exact le_trans (Finset.le_sup (f := id) hmem) (le_max_right _ _)
  have lpf_le : ∀ w b : ℕ, 1 ≤ b → (∀ r, r.Prime → r ∣ w → r ≤ b) →
      largestPrimeFactor w ≤ b := by
    intro w b hb h
    unfold largestPrimeFactor
    apply max_le hb
    apply Finset.sup_le
    intro r hr
    exact h r (Nat.prime_of_mem_primeFactors hr) (Nat.dvd_of_mem_primeFactors hr)
  have cop_of_lt : ∀ w r : ℕ, 0 < w → r.Prime → largestPrimeFactor w < r → Nat.Coprime r w := by
    intro w r hw hr hlt
    apply (Nat.Prime.coprime_iff_not_dvd hr).mpr
    intro hd
    have := le_lpf w r hw.ne' hr hd
    omega
  have split : ∀ q w : ℕ, q.Prime → 0 < w → largestPrimeFactor w = q → ¬ q ∣ w.totient →
      ∃ a : ℕ, 0 < a ∧ w = q * a ∧ largestPrimeFactor a < q := by
    intro q w hq hw htop hφ
    have hqw : q ∣ w := htop ▸ lpf_dvd w
    obtain ⟨a, ha⟩ := hqw
    have ha0 : 0 < a := by
      rcases Nat.eq_zero_or_pos a with h | h
      · rw [h, mul_zero] at ha; omega
      · exact h
    have hqa : ¬ q ∣ a := by
      intro hd
      apply hφ
      rw [ha, Nat.totient_mul_of_prime_of_dvd hq hd]
      exact dvd_mul_right q a.totient
    have hle : largestPrimeFactor a ≤ q := by
      apply lpf_le a q hq.one_le
      intro r hr hd
      rw [← htop]
      exact le_lpf w r hw.ne' hr (by rw [ha]; exact dvd_mul_of_dvd_right hd q)
    have hne : largestPrimeFactor a ≠ q := by
      intro heq
      exact hqa (heq ▸ lpf_dvd a)
    exact ⟨a, ha0, ha, lt_of_le_of_ne hle hne⟩
  
  unfold FordLower.suffixCollisionFamily at hs
  obtain ⟨n, hn, rfl⟩ := Finset.mem_image.mp hs
  simp only [FordLower.prefixCollisionClass, FordLower.externalTotientCollisions,
    Finset.mem_filter] at hn
  obtain ⟨⟨hnF, hnw⟩, hdepth⟩ := hn
  have hq := hp n hnF
  have hoq := ho n hnF
  have hprodq := hprod n hnF
  set q := p n with hqdef
  have hinj : Function.Injective q := hoq.injective
  
  have hPpos : ∀ i, 0 < FordLower.prefixProduct q i :=
    fun i => Finset.prod_pos (fun idx _ => (hq idx).pos)
  have hPS : ∀ i, FordLower.prefixProduct q i * FordLower.suffixProduct q i = n := by
    intro i
    rw [← hprodq]
    simpa only [FordLower.prefixProduct, FordLower.suffixProduct, not_lt] using
      Finset.prod_filter_mul_prod_filter_not Finset.univ (fun idx : Fin k => idx.val < i) q
  have hP0 : FordLower.prefixProduct q 0 = 1 := by simp [FordLower.prefixProduct]
  have hPk : FordLower.prefixProduct q k = n := by
    rw [← hprodq]; simp [FordLower.prefixProduct]
  have hPsucc : ∀ i (hi : i < k), FordLower.prefixProduct q (i + 1) =
      FordLower.prefixProduct q i * q ⟨i, hi⟩ := by
    intro i hi
    have hset : Finset.univ.filter (fun idx : Fin k => idx.val < i + 1) =
        insert ⟨i, hi⟩ (Finset.univ.filter (fun idx : Fin k => idx.val < i)) := by
      ext idx
      simp only [Finset.mem_filter, Finset.mem_univ, true_and, Finset.mem_insert, Fin.ext_iff]
      omega
    unfold FordLower.prefixProduct
    rw [hset, Finset.prod_insert (by simp)]
    exact mul_comm _ _
  
  have hD0 : 0 ∈ FordLower.prefixDepths q n := by
    obtain ⟨m, hm⟩ := hnw
    have hm' : 0 < m ∧ m.totient = n.totient ∧ ¬ n ∣ m := hm
    simp only [FordLower.prefixDepths, Finset.mem_filter, Finset.mem_range]
    refine ⟨by omega, m, hm, m, hm'.1, by rw [hP0, one_mul], fun idx hi => absurd hi (Nat.not_lt_zero _)⟩
  have hDne : (FordLower.prefixDepths q n).Nonempty := ⟨0, hD0⟩
  have hdep : FordLower.prefixDepth q n = (FordLower.prefixDepths q n).max' hDne := by
    rw [FordLower.prefixDepth, dif_pos hDne]
  have hjmem : j ∈ FordLower.prefixDepths q n := by
    rw [← hdepth, hdep]; exact Finset.max'_mem _ _
  have hjmax : ∀ i ∈ FordLower.prefixDepths q n, i ≤ j := by
    intro i hi; rw [← hdepth, hdep]; exact Finset.le_max' _ _ hi
  simp only [FordLower.prefixDepths, Finset.mem_filter, Finset.mem_range] at hjmem hjmax
  obtain ⟨hjle, m, hm, w, hw, hmw, hsep⟩ := hjmem
  have hm' : 0 < m ∧ m.totient = n.totient ∧ ¬ n ∣ m := hm
  have hj : j < k := by
    by_contra hcon
    have hjk : j = k := by omega
    rw [hjk, hPk] at hmw
    exact hm'.2.2 ⟨w, hmw⟩
  
  have hind : ∀ T : Finset (Fin k), Squarefree (∏ idx ∈ T, q idx) ∧
      (∏ idx ∈ T, q idx).totient = ∏ idx ∈ T, (q idx - 1) ∧
      ArithmeticFunction.cardFactors (∏ idx ∈ T, q idx) = T.card := by
    intro T
    refine Finset.induction_on T ?_ ?_
    · simp
    · intro a T haT ih
      obtain ⟨ih1, ih2, ih3⟩ := ih
      have hcop : Nat.Coprime (q a) (∏ idx ∈ T, q idx) := by
        apply Nat.Coprime.prod_right
        intro i hi
        apply (Nat.coprime_primes (hq a) (hq i)).mpr
        intro h
        exact haT (hinj h ▸ hi)
      have hne : (∏ idx ∈ T, q idx) ≠ 0 := (Finset.prod_pos (fun idx _ => (hq idx).pos)).ne'
      rw [Finset.prod_insert haT, Finset.prod_insert haT, Finset.card_insert_of_notMem haT]
      refine ⟨?_, ?_, ?_⟩
      · exact Nat.squarefree_mul_iff.mpr ⟨hcop, (hq a).squarefree, ih1⟩
      · rw [Nat.totient_mul hcop, Nat.totient_prime (hq a), ih2]
      · rw [ArithmeticFunction.cardFactors_mul (hq a).ne_zero hne,
          ArithmeticFunction.cardFactors_apply_prime (hq a), ih3]
        ring
  set S := Finset.univ.filter (fun idx : Fin k => j ≤ idx.val) with hSdef
  have hsdef : FordLower.suffixProduct q j = ∏ idx ∈ S, q idx := rfl
  have hScard : S.card = k - j := by
    have hSI : S = Finset.Ici (⟨j, hj⟩ : Fin k) := by
      ext idx; simp [hSdef, Fin.le_def]
    rw [hSI, Fin.card_Ici]
  have hmemS : ∀ idx, idx ∈ S → (⟨j, hj⟩ : Fin k) ≤ idx := by
    intro idx hi
    simp only [hSdef, Finset.mem_filter, Finset.mem_univ, true_and] at hi
    exact Fin.le_def.mpr hi
  have hspos : 0 < FordLower.suffixProduct q j := Finset.prod_pos (fun idx _ => (hq idx).pos)
  have htops : largestPrimeFactor (FordLower.suffixProduct q j) = q ⟨j, hj⟩ := by
    apply le_antisymm
    · apply lpf_le _ _ (hq _).one_le
      intro r hr hd
      rw [hsdef] at hd
      obtain ⟨idx, hi, hri⟩ := (Nat.prime_iff.mp hr).exists_mem_finset_dvd hd
      rw [(Nat.prime_dvd_prime_iff_eq hr (hq idx)).mp hri]
      exact hoq.antitone (hmemS idx hi)
    · apply le_lpf _ _ hspos.ne' (hq _)
      rw [hsdef]
      apply Finset.dvd_prod_of_mem
      simp [hSdef]
  have hndvd : ¬ q ⟨j, hj⟩ ∣ (FordLower.suffixProduct q j).totient := by
    rw [hsdef, (hind S).2.1]
    intro hd
    obtain ⟨idx, hi, hpi⟩ := (Nat.prime_iff.mp (hq ⟨j, hj⟩)).exists_mem_finset_dvd hd
    have hle := hoq.antitone (hmemS idx hi)
    have h2 := (hq idx).two_le
    have := Nat.le_of_dvd (by omega) hpi
    omega
  have hcopP : ∀ w, 0 < w → (∀ idx : Fin k, idx.val < j → largestPrimeFactor w < q idx) →
      Nat.Coprime (FordLower.prefixProduct q j) w := by
    intro w hw hsep
    unfold FordLower.prefixProduct
    apply Nat.Coprime.prod_left
    intro idx hi
    simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hi
    exact cop_of_lt w (q idx) hw (hq idx) (hsep idx hi)
  have hsepj : ∀ w, largestPrimeFactor w = q ⟨j, hj⟩ →
      ∀ idx : Fin k, idx.val < j → largestPrimeFactor w < q idx := by
    intro w hw idx hi
    rw [hw]
    exact hoq (show idx < (⟨j, hj⟩ : Fin k) from hi)
  have hcops := hcopP _ hspos (hsepj _ htops)
  have hφn : n.totient =
      (FordLower.prefixProduct q j).totient * (FordLower.suffixProduct q j).totient := by
    rw [← Nat.totient_mul hcops, hPS j]
  
  have hne : (FordLower.nontrivialPreimages (FordLower.suffixProduct q j)).Nonempty := by
    have hcopw := hcopP w hw hsep
    have h1 : (FordLower.prefixProduct q j).totient * w.totient =
        (FordLower.prefixProduct q j).totient * (FordLower.suffixProduct q j).totient := by
      rw [← Nat.totient_mul hcopw, ← hmw, hm'.2.1, hφn]
    have hwφ := Nat.eq_of_mul_eq_mul_left (Nat.totient_pos.mpr (hPpos j)) h1
    refine ⟨w, show 0 < w ∧ _ ∧ _ from ⟨hw, hwφ, ?_⟩⟩
    intro hd
    apply hm'.2.2
    rw [← hPS j, hmw]
    exact mul_dvd_mul_left _ hd
  
  have hraise : ∀ w' ∈ FordLower.nontrivialPreimages (FordLower.suffixProduct q j),
      largestPrimeFactor w' ≠ largestPrimeFactor (FordLower.suffixProduct q j) := by
    intro w' hw' heqtop
    have hw'' : 0 < w' ∧ w'.totient = (FordLower.suffixProduct q j).totient ∧
        ¬ FordLower.suffixProduct q j ∣ w' := hw'
    obtain ⟨hw0, hwφ, hwn⟩ := hw''
    have htop : largestPrimeFactor w' = q ⟨j, hj⟩ := heqtop.trans htops
    have hnot : ¬ q ⟨j, hj⟩ ∣ w'.totient := by rw [hwφ]; exact hndvd
    obtain ⟨a, ha0, hwa, hatop⟩ := split _ _ (hq _) hw0 htop hnot
    have hcopw := hcopP w' hw0 (hsepj w' htop)
    have hmem' : FordLower.prefixProduct q j * w' ∈ FordLower.nontrivialPreimages n := by
      show 0 < _ ∧ _ ∧ _
      refine ⟨Nat.mul_pos (hPpos j) hw0, ?_, ?_⟩
      · rw [Nat.totient_mul hcopw, hwφ, hφn]
      · intro hd
        apply hwn
        rw [← hPS j] at hd
        exact (mul_dvd_mul_iff_left (hPpos j).ne').mp hd
    have hagree : FordLower.PrefixAgreement q (j + 1) (FordLower.prefixProduct q j * w') := by
      refine ⟨a, ha0, ?_, ?_⟩
      · rw [hPsucc j hj, hwa, mul_assoc]
      · intro idx hi
        have hji : idx ≤ (⟨j, hj⟩ : Fin k) := Fin.le_def.mpr (show idx.val ≤ j by omega)
        exact hatop.trans_le (hoq.antitone hji)
    have := hjmax (j + 1) ⟨by omega, _, hmem', hagree⟩
    omega
  exact ⟨hj, hspos, by rw [hsdef]; exact (hind S).1,
    by rw [hsdef, (hind S).2.2, hScard], hne, hraise⟩

theorem record_suffix_factor_count_eventually (hPNT : Tendsto (fun x : ℝ => (Nat.primeCounting ⌊x⌋₊ : ℝ) / (x / Real.log x)) atTop (𝓝 1))
    (hMERT : ∃ C : ℝ, ∀ x : ℝ, 2 ≤ x →
      |(∑ p ∈ (Finset.Iic ⌊x⌋₊).filter Nat.Prime, (1 : ℝ) / p) - Real.log (Real.log x)| ≤ C)
    (hEULER : Asymptotics.IsEquivalent atTop
      (fun x : ℝ => ∏ p ∈ (Finset.Iic ⌊x⌋₊).filter Nat.Prime, (1 - (1 : ℝ) / p))
      (fun x => Real.exp (-Real.eulerMascheroniConstant) / Real.log x))
    (hRHO : 0 < FordAnalysis.rho ∧ FordAnalysis.rho < 3 / 4 ∧ FordAnalysis.F FordAnalysis.rho = 1) :
    ∀ᶠ Z : ℝ in atTop,
      ∀ (M : ℕ) (A y : ℝ) (a : Fin (FordScale.coreDimension M (logLog y))) (N : ℕ)
        (R : FordLower.PrimeProductRecord M A y a N), 1 ≤ A → 0 < logLog y →
          ∀ j : ℕ, j < FordScale.coreDimension M (logLog y) + 1 →
            ((FordLower.suffixProduct R.fullTuple j).totient : ℝ) ≤ Z →
            (ArithmeticFunction.cardFactors (FordLower.suffixProduct R.fullTuple j) : ℝ) ≤
              5 * Real.log (logLog Z) :=
by
  have hren := ford_renewal_scaled_bounds hRHO
  have hρ0 : 0 < FordAnalysis.rho := hRHO.1
  
  have hco : ∀ m : ℕ, 0 ≤ FordAnalysis.coeff m := by
    intro m
    unfold FordAnalysis.coeff
    split_ifs with hm
    · exact le_refl 0
    · unfold fordWeight
      have hn : (1 : ℝ) ≤ (m : ℝ) := by exact_mod_cast Nat.one_le_iff_ne_zero.mpr hm
      have hn0 : (0 : ℝ) < (m : ℝ) := by linarith
      have hn1 : (0 : ℝ) < (m : ℝ) + 1 := by linarith
      have hl := Real.log_le_sub_one_of_pos (div_pos hn0 hn1)
      rw [Real.log_div hn0.ne' hn1.ne'] at hl
      have hkey : ((m : ℝ) + 1) * ((m : ℝ) / ((m : ℝ) + 1)) = (m : ℝ) := by
        field_simp
      have h1 : 1 ≤ ((m : ℝ) + 1) * (Real.log ((m : ℝ) + 1) - Real.log (m : ℝ)) := by
        nlinarith [mul_le_mul_of_nonneg_left hl hn1.le]
      have h2 : 0 ≤ Real.log (m : ℝ) := Real.log_nonneg hn
      nlinarith
  
  have hg0 : FordAnalysis.g 0 = 1 := by rw [FordAnalysis.g]
  have hgs : ∀ n : ℕ, FordAnalysis.g (n + 1) =
      ∑ idx ∈ Finset.range (n + 1), FordAnalysis.coeff (idx + 1) * FordAnalysis.g (n - idx) := by
    intro n; rw [FordAnalysis.g]
  have hgS0 : FordAnalysis.gStar 0 = 1 := by rw [FordAnalysis.gStar]
  have hgSs : ∀ n : ℕ, FordAnalysis.gStar (n + 1) =
      FordAnalysis.g (n + 1) + (1 - FordAnalysis.coeff 1) * FordAnalysis.g n := by
    intro n; rw [FordAnalysis.gStar]
  have hgS1 : FordAnalysis.gStar 1 = 1 := by
    have h1 := hgSs 0
    have h2 := hgs 0
    simp only [zero_add, Finset.range_one, Finset.sum_singleton, Nat.sub_zero, hg0] at h1 h2
    rw [h1, h2]; ring
  have hgrec : ∀ d : ℕ, 2 ≤ d → FordAnalysis.gStar d ≤
      ∑ m ∈ Finset.range d, FordAnalysis.coeff (m + 1) * FordAnalysis.gStar (d - 1 - m) := by
    intro d hd
    obtain ⟨n, rfl⟩ : ∃ n, d = n + 2 := ⟨d - 2, by omega⟩
    have hterm : ∀ m ∈ Finset.range (n + 1),
        FordAnalysis.coeff (m + 1) * FordAnalysis.gStar (n + 2 - 1 - m) =
          FordAnalysis.coeff (m + 1) * FordAnalysis.g (n + 1 - m) +
            (1 - FordAnalysis.coeff 1) * (FordAnalysis.coeff (m + 1) * FordAnalysis.g (n - m)) := by
      intro m hm
      have hm' := Finset.mem_range.mp hm
      have e1 : n + 2 - 1 - m = (n - m) + 1 := by omega
      have e2 : n + 1 - m = (n - m) + 1 := by omega
      rw [e1, e2, hgSs]
      ring
    rw [Finset.sum_range_succ, Finset.sum_congr rfl hterm, Finset.sum_add_distrib, ← Finset.mul_sum,
      ← hgs n]
    have e3 : n + 2 - 1 - (n + 1) = 0 := by omega
    rw [e3, hgS0]
    have hG2 := hgs (n + 1)
    rw [Finset.sum_range_succ, Nat.sub_self, hg0] at hG2
    rw [show n + 2 = (n + 1) + 1 from rfl, hgSs (n + 1), hG2]
    linarith
  
  have hgrowth : ∀ (L : ℕ) (x : Fin L → ℝ), (∀ idx, 0 ≤ x idx) →
      (∀ idx : Fin L, idx.val + 1 < L → FordGeometry.tailForm idx x ≤ x idx) →
      ∀ (p : Fin L), p.val + 1 = L → ∀ idx : Fin L,
        FordAnalysis.gStar (p.val - idx.val) * x p ≤ x idx := by
    intro L x hx0 htail p hp
    suffices H : ∀ d : ℕ, ∀ i : Fin L, p.val - i.val = d → FordAnalysis.gStar d * x p ≤ x i by
      intro idx; exact H _ idx rfl
    intro d
    induction d using Nat.strong_induction_on with
    | _ d ih =>
    intro i hi
    have hiL := i.isLt
    rcases (show d = 0 ∨ d = 1 ∨ 2 ≤ d by omega) with h0 | h1 | h2
    · subst h0
      have hip : i = p := Fin.ext (by omega)
      subst hip
      rw [hgS0, one_mul]
    · subst h1
      have hi1 : i.val + 1 < L := by omega
      have hform : FordGeometry.tailForm i x = x p := by
        show ∑ j, FordGeometry.tailWeight i j * x j = x p
        rw [Finset.sum_eq_single p]
        · have hlt : i.val < p.val := by omega
          have hnot : ¬ (i.val + 2 < L) := by omega
          simp only [FordGeometry.tailWeight, if_pos hlt, if_neg hnot, one_mul]
        · intro j _ hj
          have hnj : ¬ i.val < j.val := by
            intro h
            apply hj
            have := j.isLt
            exact Fin.ext (by omega)
          simp only [FordGeometry.tailWeight, if_neg hnj, zero_mul]
        · intro h; exact absurd (Finset.mem_univ p) h
      rw [hgS1, one_mul, ← hform]
      exact htail i hi1
    · have hi2 : i.val + 2 < L := by omega
      have hi1 : i.val + 1 < L := by omega
      let xe : ℕ → ℝ := fun n => if h : n < L then x ⟨n, h⟩ else 0
      let f : ℕ → ℝ := fun n => (if i.val < n then FordAnalysis.coeff (n - i.val) else 0) * xe n
      have hform : FordGeometry.tailForm i x =
          ∑ m ∈ Finset.range d, FordAnalysis.coeff (m + 1) * xe (i.val + 1 + m) := by
        have h1 : FordGeometry.tailForm i x = ∑ j : Fin L, f j := by
          show ∑ j, FordGeometry.tailWeight i j * x j = _
          apply Finset.sum_congr rfl
          intro j _
          have hj : (if h : (j : ℕ) < L then x ⟨j, h⟩ else 0) = x j := by rw [dif_pos j.isLt]
          show FordGeometry.tailWeight i j * x j =
            (if i.val < (j : ℕ) then FordAnalysis.coeff ((j : ℕ) - i.val) else 0) *
              (if h : (j : ℕ) < L then x ⟨j, h⟩ else 0)
          rw [hj]
          unfold FordGeometry.tailWeight
          by_cases hij : i.val < j.val
          · have hne : j.val - i.val ≠ 0 := by omega
            rw [if_pos hij, if_pos hij, if_pos hi2, FordAnalysis.coeff, if_neg hne]
          · rw [if_neg hij, if_neg hij]
        have hLd : Finset.range L = Finset.range ((i.val + 1) + d) := by
          congr 1; omega
        rw [h1, Fin.sum_univ_eq_sum_range f L, hLd, Finset.sum_range_add]
        have hz : ∑ n ∈ Finset.range (i.val + 1), f n = 0 := by
          apply Finset.sum_eq_zero
          intro n hn
          have hn' := Finset.mem_range.mp hn
          have hnot : ¬ i.val < n := by omega
          show (if i.val < n then FordAnalysis.coeff (n - i.val) else 0) * xe n = 0
          rw [if_neg hnot, zero_mul]
        rw [hz, zero_add]
        apply Finset.sum_congr rfl
        intro m _
        have hlt : i.val < i.val + 1 + m := by omega
        have he : i.val + 1 + m - i.val = m + 1 := by omega
        show (if i.val < i.val + 1 + m then FordAnalysis.coeff (i.val + 1 + m - i.val) else 0) *
          xe (i.val + 1 + m) = _
        rw [if_pos hlt, he]
      have hsum : (∑ m ∈ Finset.range d,
            FordAnalysis.coeff (m + 1) * FordAnalysis.gStar (d - 1 - m)) * x p ≤
          ∑ m ∈ Finset.range d, FordAnalysis.coeff (m + 1) * xe (i.val + 1 + m) := by
        rw [Finset.sum_mul]
        apply Finset.sum_le_sum
        intro m hm
        have hm' := Finset.mem_range.mp hm
        have hlt : i.val + 1 + m < L := by omega
        have hxe : xe (i.val + 1 + m) = x ⟨i.val + 1 + m, hlt⟩ := dif_pos hlt
        rw [hxe, mul_assoc]
        apply mul_le_mul_of_nonneg_left _ (hco (m + 1))
        exact ih (d - 1 - m) (by omega) ⟨i.val + 1 + m, hlt⟩
          (by show p.val - (i.val + 1 + m) = d - 1 - m; omega)
      calc FordAnalysis.gStar d * x p
          ≤ (∑ m ∈ Finset.range d,
              FordAnalysis.coeff (m + 1) * FordAnalysis.gStar (d - 1 - m)) * x p :=
            mul_le_mul_of_nonneg_right (hgrec d h2) (hx0 p)
        _ ≤ _ := hsum
        _ = FordGeometry.tailForm i x := hform.symm
        _ ≤ x i := htail i hi1
  
  have hcardS : ∀ (k : ℕ) (p : Fin k → ℕ), (∀ idx, (p idx).Prime) → ∀ S : Finset (Fin k),
      ArithmeticFunction.cardFactors (∏ idx ∈ S, p idx) = S.card := by
    intro k p hp S
    refine Finset.induction_on S (by simp) ?_
    intro a s ha ih
    rw [Finset.prod_insert ha, ArithmeticFunction.cardFactors_mul (hp a).ne_zero
      (Finset.prod_ne_zero_iff.mpr (fun i _ => (hp i).ne_zero)),
      ArithmeticFunction.cardFactors_apply_prime (hp a), ih, Finset.card_insert_of_notMem ha]
    ring
  
  have hLL : Tendsto logLog atTop atTop := Real.tendsto_log_atTop.comp Real.tendsto_log_atTop
  have hLLL : Tendsto (fun Z => Real.log (logLog Z)) atTop atTop :=
    Real.tendsto_log_atTop.comp hLL
  have hlog34 : Real.log (3 / 4) < -1 / 4 := by
    rw [Real.log_lt_iff_lt_exp (by norm_num)]
    have := Real.add_one_lt_exp (x := (-1 / 4 : ℝ)) (by norm_num)
    linarith
  have hlρ : Real.log FordAnalysis.rho < -1 / 4 :=
    (Real.log_lt_log hρ0 hRHO.2.1).trans hlog34
  have hlog4 : Real.log 4 ≤ 3 := by
    have := Real.log_le_sub_one_of_pos (x := (4 : ℝ)) (by norm_num)
    linarith
  filter_upwards [hLL.eventually_ge_atTop 1, hLLL.eventually_ge_atTop 20] with Z hZ1 hZℓ
  intro M A y a N R hA ht j hj hsize
  have hℓ : (20 : ℝ) ≤ Real.log (logLog Z) := hZℓ
  have hT0 : 0 < logLog Z := by linarith
  
  have hprime : ∀ idx, (R.fullTuple idx).Prime := by
    intro idx
    refine Fin.cases ?_ (fun i => ?_) idx
    · simpa [FordLower.PrimeProductRecord.fullTuple] using R.leading_prime
    · simpa [FordLower.PrimeProductRecord.fullTuple] using R.lower_prime i
  have hanti : StrictAnti R.fullTuple := by
    intro i k hik
    induction k using Fin.cases with
    | zero => exact absurd hik (Fin.not_lt_zero _)
    | succ k' =>
      induction i using Fin.cases with
      | zero => simpa [FordLower.PrimeProductRecord.fullTuple] using R.lower_separated k'
      | succ i' =>
        simp only [FordLower.PrimeProductRecord.fullTuple, Fin.cons_succ]
        exact R.lower_order (Fin.succ_lt_succ_iff.mp hik)
  
  have hΩ : ArithmeticFunction.cardFactors (FordLower.suffixProduct R.fullTuple j) =
      FordScale.coreDimension M (logLog y) + 1 - j := by
    unfold FordLower.suffixProduct
    rw [hcardS _ _ hprime]
    have hS : (Finset.univ.filter
        (fun idx : Fin (FordScale.coreDimension M (logLog y) + 1) => j ≤ idx.val)) =
        Finset.Ici ⟨j, hj⟩ := by
      ext idx; simp [Fin.le_def]
    rw [hS, Fin.card_Ici]
  rw [hΩ]
  rcases Nat.lt_or_ge j (FordScale.coreDimension M (logLog y)) with hjL | hjL
  · 
    obtain ⟨n, hn⟩ : ∃ n, n = a.val - j := ⟨_, rfl⟩
    have hnat : FordScale.coreDimension M (logLog y) + 1 - j = n + 2 := by
      have := R.terminal; omega
    
    have hPeq : R.fullTuple ⟨j + 1, by omega⟩ = R.lower ⟨j, hjL⟩ := by
      exact Fin.cons_succ (α := fun _ => ℕ) R.leading R.lower ⟨j, hjL⟩
    have hQP : R.fullTuple ⟨j + 1, by omega⟩ < R.fullTuple ⟨j, by omega⟩ :=
      hanti (Fin.mk_lt_mk.mpr (by omega))
    have hPp := hprime ⟨j + 1, by omega⟩
    have hQp := hprime ⟨j, by omega⟩
    have hdvd : R.fullTuple ⟨j, by omega⟩ * R.fullTuple ⟨j + 1, by omega⟩ ∣
        FordLower.suffixProduct R.fullTuple j := by
      have hne : (⟨j, by omega⟩ : Fin (FordScale.coreDimension M (logLog y) + 1)) ≠
          ⟨j + 1, by omega⟩ := by
        intro h; have := congrArg Fin.val h; simp at this
      have hsub : ({⟨j, by omega⟩, ⟨j + 1, by omega⟩} :
          Finset (Fin (FordScale.coreDimension M (logLog y) + 1))) ⊆
          Finset.univ.filter (fun idx => j ≤ idx.val) := by
        intro idx hidx
        simp only [Finset.mem_insert, Finset.mem_singleton] at hidx
        simp only [Finset.mem_filter, Finset.mem_univ, true_and]
        rcases hidx with rfl | rfl
        · exact le_refl j
        · show j ≤ j + 1; omega
      have := Finset.prod_dvd_prod_of_subset _ _ R.fullTuple hsub
      rwa [Finset.prod_pair hne] at this
    have hspos : 0 < FordLower.suffixProduct R.fullTuple j :=
      Finset.prod_pos (fun i _ => (hprime i).pos)
    have hcop : Nat.Coprime (R.fullTuple ⟨j, by omega⟩) (R.fullTuple ⟨j + 1, by omega⟩) :=
      (Nat.coprime_primes hQp hPp).mpr hQP.ne'
    have htdvd := Nat.totient_dvd_of_dvd hdvd
    rw [Nat.totient_mul hcop, Nat.totient_prime hQp, Nat.totient_prime hPp] at htdvd
    have htle := Nat.le_of_dvd (Nat.totient_pos.mpr hspos) htdvd
    have hP2 := hPp.two_le
    have hQ3 : 2 ≤ R.fullTuple ⟨j, by omega⟩ - 1 := by omega
    have hmul := Nat.mul_le_mul_right (R.fullTuple ⟨j + 1, by omega⟩ - 1) hQ3
    have hPle : R.fullTuple ⟨j + 1, by omega⟩ ≤
        (FordLower.suffixProduct R.fullTuple j).totient := by omega
    rw [hPeq] at hPle hP2
    have hqZ : (R.lower ⟨j, hjL⟩ : ℝ) ≤ Z :=
      le_trans (by exact_mod_cast hPle) hsize
    have hqR : (1 : ℝ) < (R.lower ⟨j, hjL⟩ : ℝ) := by
      have : (2 : ℝ) ≤ (R.lower ⟨j, hjL⟩ : ℝ) := by exact_mod_cast hP2
      linarith
    have hlq : 0 < Real.log (R.lower ⟨j, hjL⟩ : ℝ) := Real.log_pos hqR
    have hll : logLog (R.lower ⟨j, hjL⟩ : ℝ) ≤ logLog Z := by
      unfold logLog
      exact Real.log_le_log hlq (Real.log_le_log (by linarith) hqZ)
    have huT : max 0 (logLog (R.lower ⟨j, hjL⟩ : ℝ)) ≤ logLog Z := max_le hT0.le hll
    
    have hpt := R.point
    obtain ⟨⟨hpoly, -, hcap⟩, -⟩ := hpt
    obtain ⟨hx0, -, -, -, htail0⟩ := hpoly
    have hξ : ∀ k, FordInner.targetParameter (FordScale.coreDimension M (logLog y)) M k ≤ 1 := by
      intro k
      unfold FordInner.targetParameter FordInner.baseLoss
      split_ifs
      · have : (0 : ℝ) ≤ 1 / (10 * (((M + (FordScale.coreDimension M (logLog y) - k) : ℕ) : ℝ)) ^ 3) := by
          positivity
        linarith
      · simp
    have htail : ∀ idx : Fin (FordScale.coreDimension M (logLog y)),
        idx.val + 1 < FordScale.coreDimension M (logLog y) →
        FordGeometry.tailForm idx (FordReciprocal.tuplePoint (logLog y) R.lower) ≤
          FordReciprocal.tuplePoint (logLog y) R.lower idx :=
      fun idx h => (htail0 idx h).trans (mul_le_of_le_one_left (hx0 idx) (hξ _))
    have hg : FordAnalysis.gStar n * FordReciprocal.tuplePoint (logLog y) R.lower a ≤
        FordReciprocal.tuplePoint (logLog y) R.lower ⟨j, hjL⟩ := by
      rw [hn]; exact hgrowth _ _ hx0 htail a R.terminal ⟨j, hjL⟩
    have hG : 0 < FordAnalysis.gStar n := (hren.2.2 n).2.1
    have hb : (1 / 4 : ℝ) ≤ FordAnalysis.gStar n * FordAnalysis.rho ^ n :=
      (hren.2.2 n).2.2.2.2.2
    have hxa : A / logLog y ≤ FordReciprocal.tuplePoint (logLog y) R.lower a := hcap
    have hxj : FordReciprocal.tuplePoint (logLog y) R.lower ⟨j, hjL⟩ =
        max 0 (logLog (R.lower ⟨j, hjL⟩ : ℝ)) / logLog y := rfl
    have h1 : FordAnalysis.gStar n * (A / logLog y) ≤
        max 0 (logLog (R.lower ⟨j, hjL⟩ : ℝ)) / logLog y := by
      rw [← hxj]; exact (mul_le_mul_of_nonneg_left hxa hG.le).trans hg
    have hu : FordAnalysis.gStar n * A ≤ max 0 (logLog (R.lower ⟨j, hjL⟩ : ℝ)) := by
      have h2 := mul_le_mul_of_nonneg_right h1 ht.le
      have e1 : FordAnalysis.gStar n * (A / logLog y) * logLog y = FordAnalysis.gStar n * A := by
        field_simp
      have e2 : max 0 (logLog (R.lower ⟨j, hjL⟩ : ℝ)) / logLog y * logLog y =
          max 0 (logLog (R.lower ⟨j, hjL⟩ : ℝ)) := by
        field_simp
      rw [e1, e2] at h2
      exact h2
    have hGT : FordAnalysis.gStar n ≤ logLog Z := by
      nlinarith [mul_le_mul_of_nonneg_left hA hG.le]
    have hρn : 0 < FordAnalysis.rho ^ n := pow_pos hρ0 n
    have h4 : 1 ≤ 4 * FordAnalysis.rho ^ n * logLog Z := by
      nlinarith [mul_le_mul_of_nonneg_right hGT hρn.le]
    have hlogineq : 0 ≤ Real.log 4 + (n : ℝ) * Real.log FordAnalysis.rho + Real.log (logLog Z) := by
      have := Real.log_le_log one_pos h4
      rw [Real.log_one, Real.log_mul (mul_pos (by norm_num) hρn).ne' hT0.ne',
        Real.log_mul (by norm_num) hρn.ne', Real.log_pow] at this
      linarith
    have hn0 : (0 : ℝ) ≤ n := Nat.cast_nonneg n
    have hnb : (n : ℝ) ≤ 4 * Real.log (logLog Z) + 12 := by
      nlinarith [mul_le_mul_of_nonneg_left hlρ.le hn0]
    rw [hnat]
    push_cast
    linarith
  · 
    have h1 : FordScale.coreDimension M (logLog y) + 1 - j ≤ 1 := by omega
    have : ((FordScale.coreDimension M (logLog y) + 1 - j : ℕ) : ℝ) ≤ 1 := by exact_mod_cast h1
    linarith

theorem suffix_pruning_finite_explicit {Z B c : ℝ} (hZ : 0 ≤ Z)
    (hsize : ∀ n : ℕ, 0 < n → (n.totient : ℝ) ≤ Z → (n : ℝ) ≤ c * Z * logLog Z)
    (F : Finset ℕ) (k : ℕ)
    (hF : ∀ n ∈ F, 0 < n ∧ Squarefree n ∧ ArithmeticFunction.cardFactors n = k ∧
      (FordLower.nontrivialPreimages n).Nonempty ∧
      ∀ w ∈ FordLower.nontrivialPreimages n, largestPrimeFactor w ≠ largestPrimeFactor n)
    (hZF : ∀ n ∈ F, (n.totient : ℝ) ≤ Z ∧
      (ArithmeticFunction.cardFactors n : ℝ) ≤ B * Real.log (logLog Z)) :
    ∃ (G : Finset ℕ) (w : ℕ → ℕ), G ⊆ F ∧ Set.InjOn w (G : Set ℕ) ∧
      (∀ n ∈ G, 0 < n ∧ Squarefree n ∧ (n.totient : ℝ) ≤ Z ∧ 0 < w n ∧
        (w n).totient = n.totient ∧ ¬ n ∣ w n ∧ largestPrimeFactor (w n) ≠ largestPrimeFactor n ∧
        (∀ q : ℕ, q.Prime → q ∣ n → SNormal (normalityScale (logLog Z)) q) ∧
        (∀ q : ℕ, q.Prime → q ∣ w n → SNormal (normalityScale (logLog Z)) q) ∧
        NoLargePrimeSquare (w n) (Real.log Z ^ 4) ∧
        NoLargePrimeSquare (w n).totient (Real.log Z ^ 4)) ∧
      (F.card : ℝ) ≤
        (((Finset.Icc 1 ⌊c * Z * logLog Z⌋₊).filter (fun n => Squarefree n ∧
            ArithmeticFunction.cardFactors n ≤ ⌊B * Real.log (logLog Z)⌋₊ + 1 ∧
            ∃ q : ℕ, q.Prime ∧ q ∣ n ∧ ¬ SNormal (normalityScale (logLog Z)) q)).card : ℝ) +
        (((Finset.Icc 1 ⌊c * Z * logLog Z⌋₊).filter (fun n => ∃ q : ℕ, q.Prime ∧
            Real.log Z ^ 4 < (q : ℝ) ∧ (q ^ 2 ∣ n ∨ q ^ 2 ∣ n.totient))).card : ℝ) +
        (((totientsUpTo Z).filter (fun m => ∃ n : ℕ, 0 < n ∧ n.totient = m ∧
            ∃ q : ℕ, q.Prime ∧ q ∣ n ∧ ¬ SNormal (normalityScale (logLog Z)) q)).card : ℝ) +
        (G.card : ℝ) :=
by
  classical
  
  have hs1 : ∀ {n m : ℕ}, 0 < m →
      ArithmeticFunction.cardFactors n = ArithmeticFunction.cardFactors m → n ∣ m → n = m := by
    intro n m hm hc hd
    obtain ⟨d, rfl⟩ := hd
    have hn0 : n ≠ 0 := by rintro rfl; simp at hm
    have hd0 : d ≠ 0 := by rintro rfl; simp at hm
    rw [ArithmeticFunction.cardFactors_mul hn0 hd0] at hc
    have hd1 : ArithmeticFunction.cardFactors d = 0 := by omega
    rw [ArithmeticFunction.cardFactors_eq_zero_iff_eq_zero_or_one] at hd1
    rcases hd1 with h | h
    · exact absurd h hd0
    · rw [h, mul_one]
  have hNTP : ∀ n m : ℕ, m ∈ FordLower.nontrivialPreimages n ↔
      (0 < m ∧ m.totient = n.totient ∧ ¬ n ∣ m) := fun n m => Iff.rfl
  
  let E₀ := F.filter (fun n => ∃ q : ℕ, q.Prime ∧ q ∣ n ∧ ¬ SNormal (normalityScale (logLog Z)) q)
  let F₁ := F \ E₀
  have hF₁ : ∀ n ∈ F₁, n ∈ F ∧
      ∀ q : ℕ, q.Prime → q ∣ n → SNormal (normalityScale (logLog Z)) q := by
    intro n hn
    rw [Finset.mem_sdiff] at hn
    refine ⟨hn.1, fun q hq hqn => ?_⟩
    by_contra hbad
    exact hn.2 (Finset.mem_filter.mpr ⟨hn.1, q, hq, hqn, hbad⟩)
  
  have hcyc : ∀ v : ℕ, ∃ σ : Equiv.Perm ℕ,
      σ.IsCycleOn ((F₁.filter (fun m => m.totient = v) : Finset ℕ) : Set ℕ) := by
    intro v
    refine ⟨((F₁.filter (fun m => m.totient = v)).toList).formPerm, ?_⟩
    have h := (Finset.nodup_toList (F₁.filter (fun m => m.totient = v))).isCycleOn_formPerm
    have hset : {a | a ∈ (F₁.filter (fun m => m.totient = v)).toList} =
        ((F₁.filter (fun m => m.totient = v) : Finset ℕ) : Set ℕ) := by
      ext a
      simp only [Set.mem_setOf_eq, Finset.mem_toList, Finset.mem_coe]
    rw [hset] at h
    exact h
  choose σ hσ using hcyc
  let pm : ℕ → ℕ := fun n => σ n.totient n
  have hmemT : ∀ n ∈ F₁,
      n ∈ ((F₁.filter (fun m => m.totient = n.totient) : Finset ℕ) : Set ℕ) := by
    intro n hn
    rw [Finset.mem_coe, Finset.mem_filter]
    exact ⟨hn, rfl⟩
  have hpmmem : ∀ n ∈ F₁, pm n ∈ F₁ ∧ (pm n).totient = n.totient := by
    intro n hn
    have h := (hσ n.totient).apply_mem_iff.mpr (hmemT n hn)
    rw [Finset.mem_coe, Finset.mem_filter] at h
    exact h
  have hpmne : ∀ n ∈ F₁, (∃ m ∈ F₁, m.totient = n.totient ∧ m ≠ n) → pm n ≠ n := by
    rintro n hn ⟨m, hm, hmt, hmn⟩
    show σ n.totient n ≠ n
    apply (hσ n.totient).apply_ne
    · refine ⟨n, hmemT n hn, m, ?_, hmn.symm⟩
      rw [Finset.mem_coe, Finset.mem_filter]
      exact ⟨hm, hmt⟩
    · exact hmemT n hn
  have hpminj : ∀ n ∈ F₁, ∀ n' ∈ F₁, pm n = pm n' → n = n' := by
    intro n hn n' hn' h
    have ht : n.totient = n'.totient := by
      rw [← (hpmmem n hn).2, ← (hpmmem n' hn').2, h]
    have h' : σ n.totient n = σ n'.totient n' := h
    rw [← ht] at h'
    exact (σ n.totient).injective h'
  
  have hNex : ∀ n, ∃ N : ℕ, n ∈ F → N ∈ FordLower.nontrivialPreimages n := by
    intro n
    by_cases hn : n ∈ F
    · obtain ⟨N, hN⟩ := (hF n hn).2.2.2.1
      exact ⟨N, fun _ => hN⟩
    · exact ⟨0, fun h => absurd h hn⟩
  choose N hN using hNex
  let w : ℕ → ℕ := fun n =>
    if (∃ m ∈ F₁, m.totient = n.totient ∧ m ≠ n) then pm n else N n
  have hw : ∀ n ∈ F₁, 0 < w n ∧ (w n).totient = n.totient ∧ ¬ n ∣ w n ∧
      largestPrimeFactor (w n) ≠ largestPrimeFactor n ∧
      ((∃ m ∈ F₁, m.totient = n.totient ∧ m ≠ n) → w n ∈ F₁) := by
    intro n hn
    have hnF := (hF₁ n hn).1
    by_cases hp : ∃ m ∈ F₁, m.totient = n.totient ∧ m ≠ n
    · have hwn : w n = pm n := if_pos hp
      rw [hwn]
      obtain ⟨hpmF, hpmt⟩ := hpmmem n hn
      have hpmF' := (hF₁ _ hpmF).1
      have hpos : 0 < pm n := (hF _ hpmF').1
      have hndvd : ¬ n ∣ pm n := by
        intro hd
        exact hpmne n hn hp
          (hs1 hpos (by rw [(hF n hnF).2.2.1, (hF _ hpmF').2.2.1]) hd).symm
      have hmemN : pm n ∈ FordLower.nontrivialPreimages n := (hNTP n (pm n)).mpr ⟨hpos, hpmt, hndvd⟩
      exact ⟨hpos, hpmt, hndvd, (hF n hnF).2.2.2.2 _ hmemN, fun _ => hpmF⟩
    · have hwn : w n = N n := if_neg hp
      rw [hwn]
      obtain ⟨h1, h2, h3⟩ := (hNTP n (N n)).mp (hN n hnF)
      exact ⟨h1, h2, h3, (hF n hnF).2.2.2.2 _ (hN n hnF), fun h => absurd h hp⟩
  have hwinj : Set.InjOn w (F₁ : Set ℕ) := by
    intro n hn n' hn' h
    have hn : n ∈ F₁ := hn
    have hn' : n' ∈ F₁ := hn'
    have ht : n.totient = n'.totient := by
      rw [← (hw n hn).2.1, ← (hw n' hn').2.1, h]
    by_contra hne
    have hp : ∃ m ∈ F₁, m.totient = n.totient ∧ m ≠ n := ⟨n', hn', ht.symm, Ne.symm hne⟩
    have hp' : ∃ m ∈ F₁, m.totient = n'.totient ∧ m ≠ n' := ⟨n, hn, ht, hne⟩
    have e1 : w n = pm n := if_pos hp
    have e2 : w n' = pm n' := if_pos hp'
