    intro q
    rw [hQdef, Finset.mem_filter, Finset.mem_Iic]
  have hQprime : ∀ q ∈ Q, q.Prime := fun q hq => ((hQmem q).mp hq).2.1
  have hQdata : ∀ q ∈ Q, 2 ≤ q ∧ (q : ℝ) ≤ z := by
    intro q hq
