      rw [h4.2.2.2.1 hL x]
      have h1 : FordGeometry.outerForm L x ≤ 1 := hx.1.1
      linarith [hx.2]
  
  have hadj : ∀ p ∈ (Finset.univ.filter (fun p : Fin L => 1 ≤ p.val ∧ p.val + 1 < L)),
