  intro F u c hu hc hF hdens
  have he1 : 1 ≤ Real.exp 1 := Real.one_le_exp (by norm_num)
  have he2 : (2 : ℝ) ≤ Real.exp 1 := by
    have := Real.add_one_le_exp (1 : ℝ); linarith
