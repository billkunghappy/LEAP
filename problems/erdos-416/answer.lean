      have hT5 : T ^ 5 ≤ L ^ 5 := pow_le_pow_left₀ hT0.le hTL 5
      calc c * Y * T * (L * T ^ 2 * 2) ^ 2 = (4 * c * Y * L ^ 2) * T ^ 5 := by ring
        _ ≤ (4 * c * Y * L ^ 2) * L ^ 5 := mul_le_mul_of_nonneg_left hT5 (by positivity)
        _ = Y * (4 * c * L ^ 7) := by ring
        _ ≤ Y * Y := mul_le_mul_of_nonneg_left h7' hY0.le
        _ = Y ^ 2 := by ring
    have hi : Real.sqrt (c * Y * T) ≤ g / 2 := by
      calc Real.sqrt (c * Y * T) ≤ Real.sqrt ((g / 2) ^ 2) := Real.sqrt_le_sqrt hsq
