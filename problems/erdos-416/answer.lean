    intro x u hu hux
    have hcard : (totientsUpTo u).card ≤ ⌊u⌋₊ := by
      unfold totientsUpTo
      calc _ ≤ (Finset.Icc 1 ⌊u⌋₊).card := Finset.card_filter_le _ _
        _ = ⌊u⌋₊ := by simp
    have hTu : ((totientsUpTo u).card : ℝ) ≤ u :=
      (Nat.cast_le.mpr hcard).trans (Nat.floor_le (by linarith))
    have hu0 : 0 < u := by linarith
    have hlogu : 0 < Real.log u := Real.log_pos (by linarith)
    have hlog : Real.log u ≤ Real.log x := Real.log_le_log hu0 hux
    rw [le_div_iff₀ hlogu]
    have h1 : u * Real.log u ≤ u * max 1 (Real.log x) :=
      mul_le_mul_of_nonneg_left (hlog.trans (le_max_right _ _)) hu0.le
    have h2 : ((totientsUpTo u).card : ℝ) * Real.log u ≤ u * Real.log u :=
