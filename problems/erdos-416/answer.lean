      unfold logLog; rw [Real.log_exp, Real.log_exp]
    have hx : X₀ ≤ Real.exp (Real.exp τ) := by
      rw [← hexpt₀]; gcongr
    have hY : ∀ u : ℝ, 2 ≤ u → u ≤ envelopeTailEndpoint (logLog (Real.exp (Real.exp τ))) →
