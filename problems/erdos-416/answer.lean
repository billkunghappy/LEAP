      have hA' : (2 * A + 3) * u ^ 2 ≤ |2 * A + 3| * u ^ 2 :=
        mul_le_mul_of_nonneg_right (le_abs_self _) (sq_nonneg u)
      have hu2 : 1 ≤ u ^ 2 := by nlinarith
      have hbig : 6 * (M + Lam) * u ^ 2 ≤ u ^ 8 * u ^ 2 :=
        mul_le_mul_of_nonneg_right (by linarith) (sq_nonneg u)
      have h10u : 10 * u ≤ 10 * u ^ 2 := by nlinarith
      have hMu : M * u ^ 2 = 10 * u ^ 2 + |2 * A + 3| * u ^ 2 := by rw [hM]; ring
      have hLu := mul_le_mul_of_nonneg_left hu2 hLam0
      rw [h10]
      nlinarith
    have hTexp : T ^ 10 = Real.exp (10 * u) := by
      rw [show (10 : ℝ) * u = ((10 : ℕ) : ℝ) * u by norm_num, Real.exp_nat_mul, hu,
        Real.exp_log hT0]
    have hii0 : K * (T ^ 10 * Real.exp ((2 * A + 3) * u ^ 2 - u ^ 10 / 6)) ≤ 1 / 2 := by
      rw [hTexp, ← Real.exp_add]
      have h1 : Real.exp (10 * u + ((2 * A + 3) * u ^ 2 - u ^ 10 / 6)) ≤ Real.exp (-Lam) :=
        Real.exp_le_exp.mpr hexp
      have h2 : Real.exp (-Lam) = 1 / (2 * K + 1) := by
        rw [Real.exp_neg, hLam, Real.exp_log (by linarith), one_div]
      rw [h2] at h1
      have h3 := mul_le_mul_of_nonneg_left h1 hK
      have h4 : K * (1 / (2 * K + 1)) ≤ 1 / 2 := by
        rw [mul_one_div, div_le_div_iff₀ (by linarith) (by norm_num)]
        linarith
      linarith
    have hii : K * Y / L * T ^ 8 * Real.exp ((2 * A + 3) * u ^ 2 - u ^ 10 / 6) ≤ g / 2 := by
      have hLne : L ≠ 0 := hL0.ne'
      have hTne : T ≠ 0 := hT0.ne'
      have heq : K * Y / L * T ^ 8 * Real.exp ((2 * A + 3) * u ^ 2 - u ^ 10 / 6) =
          g * (K * (T ^ 10 * Real.exp ((2 * A + 3) * u ^ 2 - u ^ 10 / 6))) := by
        rw [hg]; field_simp
      rw [heq]
      have := mul_le_mul_of_nonneg_left hii0 hg0.le
      linarith
    linarith
  filter_upwards [hLL.eventually hW_ev,
    hfin_ev, hpar_ev, hLL.eventually_ge_atTop (Real.exp 1),
    eventually_gt_atTop (1 : ℝ)] with Y hW hfin hpar hTe hY1
  obtain ⟨hu1, hcT, hlogY, hz4, hzee, hYz, hLLz⟩ := hpar
  set T := logLog Y with hT
  set u := Real.log T with hu
  set z := c * Y * T with hz
  set S := normalityScale T with hS
  set k := ⌊A * u⌋₊ + 1 with hk
  have hY0 : 0 < Y := by linarith
  have hT1 : 1 ≤ T := by linarith
  have hT0 : 0 < T := by linarith
  have hz0 : 0 < z := by rw [hz]; positivity
  have hlogYz : Real.log Y ≤ Real.log z := Real.log_le_log hY0 hYz
  have hlogz : 0 < Real.log z := by linarith
  have hez : Real.exp 1 ≤ z := le_trans (Real.exp_le_exp.mpr (by linarith)) hzee
  have hlz : Real.exp 1 ≤ Real.log z := by
    have := Real.log_le_log (Real.exp_pos _) hzee
    rwa [Real.log_exp] at this
  have hllz0 : 0 ≤ Real.log (Real.log z) := Real.log_nonneg (by linarith)
  have hllz3 : 1 + Real.log (Real.log z) ≤ 3 * T := by linarith
  
  have hLLS : Real.log (Real.log S) = u ^ 10 := by
    rw [hS, normalityScale, Real.log_exp, Real.log_exp]
  have hSe : Real.exp 1 ≤ S := by
    rw [hS, normalityScale]
    exact Real.exp_le_exp.mpr (Real.one_le_exp (by positivity))
  have hS2 : SNormal S 2 := by
    refine ⟨Nat.prime_two, ?_, ?_⟩
    · have h0 : omegaInterval (2 - 1) 1 S = 0 := by
        simp [omegaInterval]
      rw [h0, hLLS]
      simp only [Nat.cast_zero]
      positivity
    · intro u' v' hu' huv hv
      exfalso
      norm_num at hv
      linarith
  
  obtain ⟨Q, hQdef⟩ : ∃ Q : Finset ℕ,
      Q = (Finset.Iic ⌊z⌋₊).filter (fun p => p.Prime ∧ ¬ SNormal S p) := ⟨_, rfl⟩
  obtain ⟨D, hDdef⟩ : ∃ D : ℝ, D = Cd * (1 + Real.log (Real.log z)) ^ 5 *
      Real.exp (-Real.log (Real.log S) / 6) := ⟨_, rfl⟩
  have hD0 : 0 ≤ D := by
    rw [hDdef]
    have : 0 ≤ 1 + Real.log (Real.log z) := by linarith
    positivity
