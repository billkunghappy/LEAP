    nlinarith
  have hfull : F.filter (fun m : ℕ => (m : ℝ) ≤ u * 2 ^ n₀) = F :=
    Finset.filter_true_of_mem hn₀
  have hk := key n₀
  rw [hfull] at hk
  have hLL : 1 ≤ Real.log (Real.log u) := by
