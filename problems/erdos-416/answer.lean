    set b := Real.log (y + δ) with hb_def
    have ha0 : 0 < a := by linarith
    have hb0 : 0 < b := by linarith
    rw [div_sub_div _ _ ha0.ne' hb0.ne', div_le_div_iff₀ (by positivity) (by positivity)]
    have hab2 : a * b ≤ b ^ 2 := by nlinarith
    have hba : 0 ≤ (b - a) * (y + δ) := by nlinarith
    nlinarith [mul_le_mul_of_nonneg_right hgap (by positivity : (0:ℝ) ≤ a * b),
      mul_le_mul_of_nonneg_left hab2 hba]
