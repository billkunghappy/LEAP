theorem coprime_sieve_count_of_ingredients (hSEL : ∀ s : SelbergSieve, BoundingSieve.siftedSum (s := s.toBoundingSieve) ≤ s.totalMass / (∑ l ∈ s.prodPrimes.divisors, if (l : ℝ) ^ 2 ≤ s.level then s.nu l * ∏ p ∈ l.primeFactors, 1 / (1 - s.nu p) else 0) + ∑ d ∈ s.prodPrimes.divisors, if (d : ℝ) ≤ s.level then (3 : ℝ) ^ ArithmeticFunction.cardDistinctFactors d * |BoundingSieve.rem (s := s.toBoundingSieve) d| else 0) (hMULT : ∀ (g : ℕ → ℝ) (P : ℕ) (y : ℝ), 1 ≤ y → Squarefree P → (∀ p : ℕ, p.Prime → (p : ℝ) ≤ y → p ∣ P) → (∀ p : ℕ, p.Prime → 0 ≤ g p ∧ g p < 1) → (∑ m ∈ Finset.Icc 1 ⌊Real.sqrt y⌋₊, ∏ p ∈ m.primeFactors, g p ^ m.factorization p) ≤ ∑ l ∈ P.divisors, if (l : ℝ) ^ 2 ≤ y then ∏ p ∈ l.primeFactors, g p / (1 - g p) else 0) (hCOP : ∀ (b M : ℕ), 0 < b → (b.totient : ℝ) / b * (∑ k ∈ Finset.Icc 1 M, (k : ℝ)⁻¹) ≤ ∑ k ∈ (Finset.Icc 1 M).filter (fun k => k.Coprime b), (k : ℝ)⁻¹) (hOMEGA : ∀ (P k : ℕ) (x : ℝ), 1 ≤ x → Squarefree P → (∑ d ∈ P.divisors, if (d : ℝ) ≤ x then (k : ℝ) ^ ArithmeticFunction.cardDistinctFactors d else 0) ≤ x * (1 + Real.log x) ^ k) : ∀ (b N : ℕ) (L : ℝ), 0 < b → 1 < L → (((Finset.Icc 1 N).filter (fun n => ∀ p : ℕ, p.Prime → (p : ℝ) ≤ L → ¬ p ∣ b → ¬ p ∣ n)).card : ℝ) ≤ 2 * ((b : ℝ) / b.totient) * N / Real.log L + L * (1 + Real.log L) ^ 3 :=
