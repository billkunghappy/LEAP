  filter_upwards [eventually_ge_atTop 16] with L hL16
  have hL : 2 ≤ L := by omega
  have h4 := ford_slack_coordinates L
  have hW := simplex_cut_volume.1 L (FordOrder.weight L) 1 (hw L) zero_le_one
  
  have hU : FordOrder.unordered L = (fun x : Fin L → ℝ => FordOrder.slack x) ⁻¹'
