          rw [hset, ih (t - s) (sub_nonneg.mpr hs.2)]
        · rw [Set.indicator_of_notMem hs]
          have hset : Prod.mk s ⁻¹' (e ⁻¹' {x : Fin (n + 1) → ℝ | (∀ i, 0 ≤ x i) ∧ ∑ i, x i ≤ t}) =
              ∅ := by
            apply Set.eq_empty_iff_forall_notMem.mpr
            intro x hx
            have hx' := (hcons s x).mp (by simpa only [Set.mem_preimage, he_apply] using hx)
            apply hs
            refine ⟨hx'.1, ?_⟩
            have hsum := Finset.sum_nonneg (fun idx (_ : idx ∈ Finset.univ) => hx'.2.1 idx)
            have hbound := hx'.2.2
            linarith
          rw [hset, MeasureTheory.measure_empty]
      have hc : Continuous (fun s : ℝ => (t - s) ^ n / (n.factorial : ℝ)) := by fun_prop
      have hi : MeasureTheory.IntegrableOn (fun s : ℝ => (t - s) ^ n / (n.factorial : ℝ))
          (Set.Icc 0 t) := hc.integrableOn_Icc
      have hn : 0 ≤ᵐ[MeasureTheory.volume.restrict (Set.Icc 0 t)]
          (fun s : ℝ => (t - s) ^ n / (n.factorial : ℝ)) := by
        filter_upwards [MeasureTheory.ae_restrict_mem measurableSet_Icc] with s hs
        exact div_nonneg (pow_nonneg (sub_nonneg.mpr hs.2) _) (by positivity)
      have hint : (∫ s in Set.Icc 0 t, (t - s) ^ n / (n.factorial : ℝ)) =
          t ^ (n + 1) / ((n + 1).factorial : ℝ) := by
        rw [MeasureTheory.integral_Icc_eq_integral_Ioc, ← intervalIntegral.integral_of_le ht,
          intervalIntegral.integral_div,
          intervalIntegral.integral_comp_sub_left (fun x : ℝ => x ^ n) t]
        simp only [sub_self, sub_zero, integral_pow, zero_pow (by omega : n + 1 ≠ 0),
          sub_zero, Nat.factorial_succ, Nat.cast_mul, Nat.cast_add, Nat.cast_one]
        rw [div_div]
      calc
        MeasureTheory.volume {x : Fin (n + 1) → ℝ | (∀ i, 0 ≤ x i) ∧ ∑ i, x i ≤ t} =
            MeasureTheory.volume (e ⁻¹' {x : Fin (n + 1) → ℝ | (∀ i, 0 ≤ x i) ∧ ∑ i, x i ≤ t}) :=
          (he.measure_preimage (hmeasΔ _ _).nullMeasurableSet).symm
        _ = ∫⁻ s : ℝ, MeasureTheory.volume
            (Prod.mk s ⁻¹' (e ⁻¹' {x : Fin (n + 1) → ℝ | (∀ i, 0 ≤ x i) ∧ ∑ i, x i ≤ t})) := by
          rw [MeasureTheory.Measure.volume_eq_prod, MeasureTheory.Measure.prod_apply hm]
        _ = ∫⁻ s in Set.Icc 0 t, ENNReal.ofReal ((t - s) ^ n / n.factorial) := by
          simp_rw [hslice]
          exact MeasureTheory.lintegral_indicator measurableSet_Icc _
        _ = ENNReal.ofReal (∫ s in Set.Icc 0 t, (t - s) ^ n / (n.factorial : ℝ)) :=
          (MeasureTheory.ofReal_integral_eq_lintegral_ofReal hi hn).symm
        _ = _ := by rw [hint]
  have hW : ∀ (n : ℕ) (b : Fin n → ℝ), (∀ i, 0 < b i) → ∀ t : ℝ, 0 ≤ t →
      MeasureTheory.volume {x : Fin n → ℝ | (∀ i, 0 ≤ x i) ∧ ∑ i, b i * x i ≤ t} =
        ENNReal.ofReal (t ^ n / ((n.factorial : ℝ) * ∏ i, b i)) := by
    intro n b hb t ht
    have hp : 0 < ∏ i, b i := Finset.prod_pos (fun i _ => hb i)
    have hR : ∀ x i, Matrix.toLin' (Matrix.diagonal (fun i => (b i)⁻¹)) x i = (b i)⁻¹ * x i := by
      intro x i
      simp [Matrix.toLin'_apply, Matrix.mulVec_diagonal]
    have hdet : LinearMap.det (Matrix.toLin' (Matrix.diagonal (fun i => (b i)⁻¹))) =
        (∏ i, b i)⁻¹ := by
      rw [LinearMap.det_toLin', Matrix.det_diagonal, Finset.prod_inv_distrib]
    have himg : Matrix.toLin' (Matrix.diagonal (fun i => (b i)⁻¹)) ''
        {x : Fin n → ℝ | (∀ i, 0 ≤ x i) ∧ ∑ i, x i ≤ t} =
          {x | (∀ i, 0 ≤ x i) ∧ ∑ i, b i * x i ≤ t} := by
      ext y
      constructor
      · rintro ⟨x, hx, rfl⟩
        refine ⟨fun i => ?_, ?_⟩
        · rw [hR]
          exact mul_nonneg (inv_pos.mpr (hb i)).le (hx.1 i)
        · simpa only [hR, ← mul_assoc, mul_inv_cancel₀ (hb _).ne', one_mul] using hx.2
      · intro hy
        refine ⟨fun i => b i * y i, ⟨fun i => mul_nonneg (hb i).le (hy.1 i), hy.2⟩, ?_⟩
        ext i
        rw [hR]
        field_simp [(hb i).ne']
    rw [← himg, MeasureTheory.Measure.addHaar_image_linearMap, hdet, hΔ n t ht,
      ← ENNReal.ofReal_mul (abs_nonneg _), abs_of_pos (inv_pos.mpr hp)]
    congr 1
    rw [inv_mul_eq_div, div_div]
  
  obtain ⟨A, hA⟩ : ∃ A : Matrix (Fin K) (Fin K) ℝ,
      A = fun i j => (if i = j then 1 else 0) - FordGeometry.tailWeight i j := ⟨_, rfl⟩
  have hAapply : ∀ (z : Fin K → ℝ) (i : Fin K),
      Matrix.toLin' A z i = z i - ∑ j, FordGeometry.tailWeight i j * z j := by
    intro z i
    rw [Matrix.toLin'_apply, hA]
    simp [Matrix.mulVec, dotProduct, sub_mul, ite_mul, Finset.sum_sub_distrib]
  have hdetA : LinearMap.det (Matrix.toLin' A) = 1 := by
    rw [LinearMap.det_toLin', Matrix.det_of_upperTriangular]
    · apply Finset.prod_eq_one
      intro i _
      rw [hA]
      simp [htw0 i i le_rfl]
    · intro i j hij
      simp only [id] at hij
      rw [hA]
      have hji : j.val ≤ i.val := le_of_lt hij
      simp [htw0 i j hji, ne_of_gt hij]
  obtain ⟨c, hc⟩ : ∃ c : Fin K → ℝ,
      c = fun i => τ * (1 + ∑ j, FordGeometry.tailWeight i j) := ⟨_, rfl⟩
  have hvolΦ : ∀ s : Set (Fin K → ℝ),
      MeasureTheory.volume ((fun z => Matrix.toLin' A z + c) '' s) = MeasureTheory.volume s := by
    intro s
    have h1 : (fun z => Matrix.toLin' A z + c) '' s =
        (fun y => y + c) '' (Matrix.toLin' A '' s) := by
      rw [Set.image_image]
    rw [h1, Set.image_add_right, MeasureTheory.measure_preimage_add_right,
      MeasureTheory.Measure.addHaar_image_linearMap, hdetA, abs_one, ENNReal.ofReal_one, one_mul]
  
  have hkey : ∀ z : Fin K → ℝ,
      ∑ i, w i * (z i - ∑ j, FordGeometry.tailWeight i j * z j) =
        ∑ j, fordWeight (j.val + 1) * z j := by
    intro z
    have h1 : ∀ j : Fin K, fordWeight (j.val + 1) * z j =
        w j * z j - ∑ i, w i * FordGeometry.tailWeight i j * z j := by
      intro j
      rw [← hcol j, sub_mul, Finset.sum_mul]
    simp_rw [h1, mul_sub, Finset.mul_sum, Finset.sum_sub_distrib]
    congr 1
    rw [Finset.sum_comm]
    simp only [mul_assoc]
  have hT : ∑ i, w i * (1 + ∑ j, FordGeometry.tailWeight i j) =
      2 * ∑ i, w i - ∑ j : Fin K, fordWeight (j.val + 1) := by
    have h1 := hkey (fun _ => 1)
    simp only [mul_one] at h1
    have h2 : ∑ i, w i * (1 + ∑ j, FordGeometry.tailWeight i j) +
        ∑ i, w i * (1 - ∑ j, FordGeometry.tailWeight i j) = 2 * ∑ i, w i := by
      rw [← Finset.sum_add_distrib, Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro i _
      ring
    linarith
  have hincl : (fun z => Matrix.toLin' A z + c) ''
      (FordGeometry.polytope K (fun _ => 1) + Set.Icc (fun _ : Fin K => -τ) (fun _ => τ)) ⊆
        {y | (∀ i, 0 ≤ y i) ∧ ∑ i, w i * y i ≤ 1 + 2 * τ * ∑ i, w i} := by
    rintro y ⟨z, ⟨x, hx, e, he, rfl⟩, rfl⟩
    have hei : ∀ i, -τ ≤ e i ∧ e i ≤ τ := fun i => ⟨he.1 i, he.2 i⟩
    have hbnd : ∀ a : Fin K → ℝ, (∀ j, 0 ≤ a j) →
        ∑ j, a j * e j ≤ (∑ j, a j) * τ ∧ -((∑ j, a j) * τ) ≤ ∑ j, a j * e j := by
      intro a ha
      rw [Finset.sum_mul, ← Finset.sum_neg_distrib]
      exact ⟨Finset.sum_le_sum fun j _ => mul_le_mul_of_nonneg_left (hei j).2 (ha j),
        Finset.sum_le_sum fun j _ => by nlinarith [(hei j).1, ha j]⟩
    have htfx : ∀ i : Fin K, ∑ j, FordGeometry.tailWeight i j * x j ≤ x i := by
      intro i
      by_cases hi : i.val + 1 < K
      · have h := hx.2.2.2.2 i hi
        have h' : FordGeometry.tailForm i x = ∑ j, FordGeometry.tailWeight i j * x j := rfl
        rw [h'] at h
        linarith
      · rw [Finset.sum_eq_zero (fun j _ => by
          rw [htw0 i j (by have := j.isLt; omega), zero_mul])]
        exact hx.1 i
    have hΦ : ∀ i, (Matrix.toLin' A (x + e) + c) i =
        (x i - ∑ j, FordGeometry.tailWeight i j * x j) +
          (e i - ∑ j, FordGeometry.tailWeight i j * e j) +
            τ * (1 + ∑ j, FordGeometry.tailWeight i j) := by
      intro i
      rw [Pi.add_apply, hAapply, hc]
      simp only [Pi.add_apply, mul_add, Finset.sum_add_distrib]
      ring
    refine ⟨fun i => ?_, ?_⟩
    · show 0 ≤ (Matrix.toLin' A (x + e) + c) i
      rw [hΦ]
      have h1 := htfx i
      have h2 := (hbnd _ (htwnn i)).1
      have h3 := (hei i).1
      nlinarith
    · show ∑ i, w i * (Matrix.toLin' A (x + e) + c) i ≤ 1 + 2 * τ * ∑ i, w i
      have e1 : ∑ i, w i * (Matrix.toLin' A (x + e) + c) i =
          ∑ i, (w i * (x i - ∑ j, FordGeometry.tailWeight i j * x j) +
            w i * (e i - ∑ j, FordGeometry.tailWeight i j * e j) +
              τ * (w i * (1 + ∑ j, FordGeometry.tailWeight i j))) :=
        Finset.sum_congr rfl (fun i _ => by rw [hΦ]; ring)
      rw [e1, Finset.sum_add_distrib, Finset.sum_add_distrib, ← Finset.mul_sum, hkey x, hkey e, hT]
      have ho : FordGeometry.outerForm K x = ∑ j, fordWeight (j.val + 1) * x j := rfl
      have hox := hx.2.2.2.1
      rw [ho] at hox
      have hoe := (hbnd (fun j => fordWeight (j.val + 1)) (fun j => hfw _ (by omega))).1
      simp only at hox hoe
      linarith
  
  have hS0 : 0 ≤ ∑ i, w i := Finset.sum_nonneg (fun i _ => (hwpos i).le)
  have hwρ : ∀ j : Fin K, w j * FordAnalysis.rho ^ (j.val + 1) ≤ 1 := by
    intro j
    rw [hw]
    dsimp only
    split_ifs with hj
    · linarith [(hgb (j.val + 1)).2.2.1 (by omega)]
    · have hlast : j.val + 1 = K := by have := j.isLt; omega
      rw [hlast]
      linarith [(hgb K).2.2.2.2.1 hK]
  have hSρ : (∑ i, w i) * FordAnalysis.rho ^ K ≤ 4 := by
    have hgeom : ∑ i ∈ Finset.range K, FordAnalysis.rho ^ i ≤ 4 := by
      have h := geom_sum_mul FordAnalysis.rho K
      have hpos : 0 ≤ FordAnalysis.rho ^ K := by positivity
      have hsnn : 0 ≤ ∑ i ∈ Finset.range K, FordAnalysis.rho ^ i :=
        Finset.sum_nonneg (fun i _ => by positivity)
      nlinarith [mul_nonneg hsnn (by linarith : (0 : ℝ) ≤ 3 / 4 - FordAnalysis.rho)]
    calc (∑ i, w i) * FordAnalysis.rho ^ K =
          ∑ j : Fin K, (w j * FordAnalysis.rho ^ (j.val + 1)) * FordAnalysis.rho ^ (K - 1 - j.val) := by
          rw [Finset.sum_mul]
          apply Finset.sum_congr rfl
          intro j _
          rw [mul_assoc, ← pow_add, show j.val + 1 + (K - 1 - j.val) = K by have := j.isLt; omega]
      _ ≤ ∑ j : Fin K, FordAnalysis.rho ^ (K - 1 - j.val) := by
          apply Finset.sum_le_sum
          intro j _
          have h := hwρ j
          have hp : 0 ≤ FordAnalysis.rho ^ (K - 1 - j.val) := by positivity
          nlinarith
      _ = ∑ j ∈ Finset.range K, FordAnalysis.rho ^ (K - 1 - j) :=
          Fin.sum_univ_eq_sum_range (fun j => FordAnalysis.rho ^ (K - 1 - j)) K
      _ = ∑ j ∈ Finset.range K, FordAnalysis.rho ^ j :=
          Finset.sum_range_reflect (fun j => FordAnalysis.rho ^ j) K
      _ ≤ 4 := hgeom
  have hpow : (1 + 2 * τ * ∑ i, w i) ^ K ≤ Real.exp 80 := by
    have hKpos : (0 : ℝ) < K := by exact_mod_cast (show 0 < K by omega)
    have hτK := (le_div_iff₀ hKpos).mp (hsmall hK)
    have hprod' := mul_le_mul_of_nonneg_right hτK hS0
    have hexp : (K : ℝ) * (2 * τ * ∑ i, w i) ≤ 80 := by nlinarith
    calc (1 + 2 * τ * ∑ i, w i) ^ K ≤ (Real.exp (2 * τ * ∑ i, w i)) ^ K :=
          pow_le_pow_left₀ (by positivity)
            (by linarith [Real.add_one_le_exp (2 * τ * ∑ i, w i)]) K
      _ = Real.exp ((K : ℝ) * (2 * τ * ∑ i, w i)) := by rw [Real.exp_nat_mul]
      _ ≤ Real.exp 80 := Real.exp_le_exp.mpr hexp
  
  have hs : 0 ≤ 1 + 2 * τ * ∑ i, w i := by positivity
  have hWv := hW K w hwpos _ hs
  have hle := ((hvolΦ (FordGeometry.polytope K (fun _ => 1) +
      Set.Icc (fun _ : Fin K => -τ) (fun _ => τ))).symm.le).trans
    ((MeasureTheory.measure_mono hincl).trans hWv.le)
  have hden : 0 < (K.factorial : ℝ) * ∏ i, w i :=
    mul_pos (by positivity) (Finset.prod_pos (fun i _ => hwpos i))
  have hreal := ENNReal.toReal_le_of_le_ofReal (div_nonneg (pow_nonneg hs _) hden.le) hle
  rw [hprod] at hreal
  have hmVeq : (1 + 2 * τ * ∑ i, w i) ^ K /
      ((K.factorial : ℝ) * FordAnalysis.renewalDenominator K) =
        (1 + 2 * τ * ∑ i, w i) ^ K * FordGeometry.modelVolume K := by
    rw [FordGeometry.modelVolume, mul_one_div]
  rw [hmVeq] at hreal
  rw [MeasureTheory.measureReal_def]
  calc _ ≤ (1 + 2 * τ * ∑ i, w i) ^ K * FordGeometry.modelVolume K := hreal
    _ ≤ Real.exp 80 * FordGeometry.modelVolume K :=
        mul_le_mul_of_nonneg_right hpow hmVpos.le
    _ ≤ (3 + Real.exp 80) * FordGeometry.modelVolume K :=
        mul_le_mul_of_nonneg_right (by linarith) hmVpos.le

theorem pc_prefix_mesh_bound (hRHO : 0 < FordAnalysis.rho ∧ FordAnalysis.rho < 3 / 4 ∧ FordAnalysis.F FordAnalysis.rho = 1)
    (M : ℕ) (t : ℝ) (ht : Real.exp 1 ≤ t) (K : ℕ) (hK : 1 ≤ K)
    (hKL : K ≤ FordScale.coreDimension M t) :
    1 / t ≤ 10 * FordAnalysis.rho ^ K / (K : ℝ) :=
by
  have hρ0 : 0 < FordAnalysis.rho := hRHO.1
  have ht0 : 0 < t := lt_of_lt_of_le (Real.exp_pos 1) ht
  have hlogt : 1 ≤ Real.log t := by
    have := Real.log_le_log (Real.exp_pos 1) ht
    rwa [Real.log_exp] at this
  have hℓ0 : 0 < Real.log t := by linarith
  have hll0 : 0 ≤ Real.log (Real.log t) := Real.log_nonneg hlogt
  have hllle : Real.log (Real.log t) ≤ Real.log t - 1 := Real.log_le_sub_one_of_pos hℓ0
  have hlog34 : Real.log (3 / 4) < -1 / 4 := by
    rw [Real.log_lt_iff_lt_exp (by norm_num)]
    have := Real.add_one_lt_exp (x := (-1 / 4 : ℝ)) (by norm_num)
    linarith
  have hlρ : Real.log FordAnalysis.rho < Real.log (3 / 4) := Real.log_lt_log hρ0 hRHO.2.1
  have ha4 : 1 / 4 < -Real.log FordAnalysis.rho := by linarith
  have habs : |Real.log FordAnalysis.rho| = -Real.log FordAnalysis.rho := abs_of_neg (by linarith)
  have hCdef : FordAnalysis.C = (2 * |Real.log FordAnalysis.rho|)⁻¹ := rfl
  have hapos : 0 < 2 * -Real.log FordAnalysis.rho := by linarith
  have hane : -Real.log FordAnalysis.rho ≠ 0 := by linarith
  have hCa : 2 * FordAnalysis.C * -Real.log FordAnalysis.rho = 1 := by
    rw [hCdef, habs, mul_inv, ← mul_assoc, mul_inv_cancel₀ two_ne_zero, one_mul,
      inv_mul_cancel₀ hane]
  have hCpos : 0 < FordAnalysis.C := by rw [hCdef, habs]; exact inv_pos.mpr hapos
  have hKr : (1 : ℝ) ≤ K := by exact_mod_cast hK
  have hK0 : (0 : ℝ) < K := by linarith
  have hKopt : (K : ℝ) ≤ (FordScale.optimalDimension t : ℝ) := by
    have : K ≤ FordScale.optimalDimension t := hKL.trans (Nat.sub_le _ _)
    exact_mod_cast this
  have hx : 0 ≤ 2 * FordAnalysis.C * (Real.log t - Real.log (Real.log t)) := by
    have : 0 ≤ Real.log t - Real.log (Real.log t) := by linarith
    positivity
  have hfl : (FordScale.optimalDimension t : ℝ) ≤
      2 * FordAnalysis.C * (Real.log t - Real.log (Real.log t)) := by
    unfold FordScale.optimalDimension
    exact Nat.floor_le hx
  have hKa : (K : ℝ) * -Real.log FordAnalysis.rho ≤ Real.log t - Real.log (Real.log t) := by
    have h1 := mul_le_mul_of_nonneg_right (hKopt.trans hfl)
      (by linarith : (0 : ℝ) ≤ -Real.log FordAnalysis.rho)
    calc (K : ℝ) * -Real.log FordAnalysis.rho
        ≤ 2 * FordAnalysis.C * (Real.log t - Real.log (Real.log t)) *
            -Real.log FordAnalysis.rho := h1
      _ = (2 * FordAnalysis.C * -Real.log FordAnalysis.rho) *
            (Real.log t - Real.log (Real.log t)) := by ring
      _ = Real.log t - Real.log (Real.log t) := by rw [hCa, one_mul]
  have hpow : FordAnalysis.rho ^ K = Real.exp ((K : ℝ) * Real.log FordAnalysis.rho) := by
    rw [Real.exp_nat_mul, Real.exp_log hρ0]
  have hexp : Real.log t / t ≤ FordAnalysis.rho ^ K := by
    rw [hpow]
    have heq : Real.log t / t = Real.exp (Real.log (Real.log t) - Real.log t) := by
      rw [Real.exp_sub, Real.exp_log hℓ0, Real.exp_log ht0]
    rw [heq]
    apply Real.exp_le_exp.mpr
    linarith
  have hρt : Real.log t ≤ FordAnalysis.rho ^ K * t := (div_le_iff₀ ht0).mp hexp
  have hK4 : (K : ℝ) ≤ 4 * Real.log t := by
    have := mul_le_mul_of_nonneg_left ha4.le hK0.le
    linarith
  rw [div_le_div_iff₀ ht0 hK0]
  have hρK : 0 ≤ FordAnalysis.rho ^ K * t := by positivity
  nlinarith

theorem pc_record_prefix_suffix_data {M : ℕ} {A y : ℝ}
    {a : Fin (FordScale.coreDimension M (logLog y))} {N : ℕ}
    (R : FordLower.PrimeProductRecord M A y a N) (K : ℕ)
    (hK : K ≤ FordScale.coreDimension M (logLog y)) (hy : 1 < y) (ht : 0 < logLog y) :
    N = R.fullTuple 0 * FordLower.prefixProduct (Fin.tail R.fullTuple) K *
        FordLower.suffixProduct R.fullTuple (K + 1) ∧
    (R.fullTuple 0).Prime ∧
    FordLower.prefixProduct (Fin.tail R.fullTuple) K ∈
      FordReciprocal.tupleIntegers K (logLog y) (FordGeometry.polytope K (fun _ => 1)) ∧
    0 < FordLower.prefixProduct (Fin.tail R.fullTuple) K ∧
    0 < FordLower.suffixProduct R.fullTuple (K + 1) ∧
    (19 / 20 : ℝ) * Real.log y ≤ Real.log (R.fullTuple 0 : ℝ) ∧
    ((R.fullTuple 0 : ℝ) - 1) * ((FordLower.prefixProduct (Fin.tail R.fullTuple) K).totient : ℝ) *
      ((FordLower.suffixProduct R.fullTuple (K + 1)).totient : ℝ) ≤ y :=
by
  classical
  
  have hw : ∀ n : ℕ, 1 ≤ n → 0 ≤ fordWeight n := by
    intro idx hi
    have hi1 : (1 : ℝ) ≤ idx := by exact_mod_cast hi
    have hi0 : (0 : ℝ) < idx := by linarith
    have hip : (0 : ℝ) < (idx : ℝ) + 1 := by positivity
    have hlow := Real.one_sub_inv_le_log_of_pos (div_pos hip hi0)
    rw [Real.log_div hip.ne' hi0.ne', inv_div] at hlow
    have hl := mul_le_mul_of_nonneg_left hlow hip.le
    have hid₁ : ((idx : ℝ) + 1) * (1 - (idx : ℝ) / ((idx : ℝ) + 1)) = 1 := by
      field_simp
      ring
    rw [hid₁] at hl
    unfold fordWeight
    nlinarith [Real.log_nonneg hi1]
  
  have hsum : ∀ {K L : ℕ} (hKL : K ≤ L) (f : Fin L → ℝ), (∀ i, 0 ≤ f i) →
      (∑ i : Fin K, f (Fin.castLE hKL i)) ≤ ∑ i : Fin L, f i := by
    intro K L hKL f hf
    let e : Fin K ↪ Fin L := ⟨Fin.castLE hKL, Fin.castLE_injective hKL⟩
    calc _ = ∑ i ∈ (Finset.univ : Finset (Fin K)).map e, f i := by simp [e]
      _ ≤ _ := Finset.sum_le_sum_of_subset_of_nonneg (Finset.subset_univ _)
          (fun i _ _ => hf i)
  
  have htailsum : ∀ {L : ℕ} (i : Fin L) (x : Fin L → ℝ), i.val + 2 < L →
      FordGeometry.tailForm i x =
        ∑ j : Fin L, if i.val < j.val then fordWeight (j.val - i.val) * x j else 0 := by
    intro L i x hi
    change (∑ j : Fin L, FordGeometry.tailWeight i j * x j) = _
    refine Finset.sum_congr rfl (fun j _ => ?_)
    by_cases h : i.val < j.val <;> simp [FordGeometry.tailWeight, h, hi]
  
  have htaillast : ∀ {L : ℕ} (i j : Fin L), i.val + 2 = L → j.val = i.val + 1 →
      ∀ x : Fin L → ℝ, FordGeometry.tailForm i x = x j := by
    intro L i j hi hj x
    change (∑ k : Fin L, FordGeometry.tailWeight i k * x k) = x j
    rw [Finset.sum_eq_single j]
    · simp [FordGeometry.tailWeight, show i.val < j.val by omega,
        show ¬ i.val + 2 < L by omega]
    · intro k _ hkj
      have hne : k.val ≠ j.val := fun h => hkj (Fin.ext h)
      have hk := k.isLt
      have hnk : ¬ i.val < k.val := by omega
      simp [FordGeometry.tailWeight, hnk]
    · simp
  
  have htrunc : ∀ {K L : ℕ} (hKL : K ≤ L) {ξ : ℕ → ℝ}, (∀ j, ξ j ≤ 1) →
      ∀ {x : Fin L → ℝ}, x ∈ FordGeometry.polytope L ξ →
      (fun i : Fin K => x (Fin.castLE hKL i)) ∈ FordGeometry.polytope K (fun _ => 1) := by
    intro K L hKL ξ hξ x hx
    obtain ⟨h0, h1, hmono, hout, htail⟩ := hx
    refine ⟨fun i => h0 _, fun i => h1 _, ?_, ?_, ?_⟩
    · intro i j hij
      exact hmono (show Fin.castLE hKL i ≤ Fin.castLE hKL j from hij)
    · change (∑ i : Fin K, fordWeight (i.val + 1) * x (Fin.castLE hKL i)) ≤ 1
      have hL : (∑ i : Fin L, fordWeight (i.val + 1) * x i) ≤ ξ 0 := hout
      have hs := hsum hKL (fun i => fordWeight (i.val + 1) * x i)
        (fun i => mul_nonneg (hw _ (by omega)) (h0 i))
      exact (hs.trans hL).trans (hξ 0)
    · intro i hi
      change FordGeometry.tailForm i (fun i : Fin K => x (Fin.castLE hKL i)) ≤
        1 * x (Fin.castLE hKL i)
      by_cases hrow : i.val + 2 < K
      · have hrowL : (Fin.castLE hKL i).val + 2 < L := by
          simp only [Fin.coe_castLE]; omega
        have hiL : (Fin.castLE hKL i).val + 1 < L := by omega
        have h := htail (Fin.castLE hKL i) hiL
        rw [htailsum _ _ hrowL] at h
        rw [htailsum _ _ hrow, one_mul]
        have hs := hsum hKL (fun j => if (Fin.castLE hKL i).val < j.val then
            fordWeight (j.val - (Fin.castLE hKL i).val) * x j else 0)
          (fun j => by
            dsimp only
            split_ifs with hij
            · exact mul_nonneg (hw _ (by omega)) (h0 j)
            · exact le_refl 0)
        have hx1 : ξ ((Fin.castLE hKL i).val + 1) * x (Fin.castLE hKL i) ≤
            x (Fin.castLE hKL i) := by
          have := mul_le_mul_of_nonneg_right (hξ ((Fin.castLE hKL i).val + 1))
            (h0 (Fin.castLE hKL i))
          linarith
        exact le_trans hs (h.trans hx1)
      · have hlast : i.val + 2 = K := by omega
        let j : Fin K := ⟨i.val + 1, hi⟩
        rw [htaillast i j hlast rfl, one_mul]
        exact hmono (show Fin.castLE hKL i ≤ Fin.castLE hKL j from
          (by change i.val ≤ i.val + 1; omega))
  
  have hmem : ∀ {K : ℕ} {t : ℝ}, 0 < t → ∀ {E : Set (Fin K → ℝ)},
      E ⊆ Set.Icc (fun _ => 0) (fun _ => 1) →
      ∀ q : Fin K → ℕ, (∀ i, (q i).Prime) → Antitone q → FordReciprocal.tuplePoint t q ∈ E →
      (∏ i, q i) ∈ FordReciprocal.tupleIntegers K t E := by
    intro K t ht E hE q hq hanti hpt
    have hent : ∀ i, q i ≤ ⌊Real.exp (Real.exp t)⌋₊ := by
      intro i
      have hp1 : (1 : ℝ) < q i := by exact_mod_cast (hq i).one_lt
      have hp0 : (0 : ℝ) < q i := by linarith
      have hlog0 := Real.log_pos hp1
      have hi : max 0 (logLog (q i)) / t ≤ 1 := (hE hpt).2 i
      have hi' := (div_le_iff₀ ht).mp hi
      have hlog : logLog (q i) ≤ t := by
        have hmax := le_max_right (0 : ℝ) (logLog (q i))
        linarith
      exact Nat.le_floor ((Real.log_le_iff_le_exp hp0).mp
        ((Real.log_le_iff_le_exp hlog0).mp hlog))
    have hle : (∏ i, q i) ≤ ⌊Real.exp (Real.exp t)⌋₊ ^ K := by
      have h := Finset.prod_le_prod (s := (Finset.univ : Finset (Fin K)))
        (fun i _ => Nat.zero_le (q i)) (fun i _ => hent i)
      simpa only [Finset.prod_const, Finset.card_univ, Fintype.card_fin] using h
    have hpos : 0 < ∏ i, q i := Finset.prod_pos (fun i _ => (hq i).pos)
    exact Finset.mem_filter.mpr ⟨Finset.mem_Icc.mpr ⟨by omega, hle⟩, q, rfl,
      fun i => Or.inl (hq i), hanti, hpt⟩
  
  have hcons : FordLower.suffixProduct R.fullTuple (K + 1) =
      FordLower.suffixProduct R.lower K := by
    show FordLower.suffixProduct (Fin.cons R.leading R.lower :
      Fin (FordScale.coreDimension M (logLog y) + 1) → ℕ) (K + 1) = _
    simp only [FordLower.suffixProduct, Finset.prod_filter, Fin.prod_univ_succ, Fin.val_zero,
      Nat.add_one_le_iff, Nat.not_lt_zero, ↓reduceIte, Fin.val_succ,
      Nat.lt_add_one_iff, Fin.cons_succ, one_mul]
  have hpm : FordLower.prefixProduct R.lower K * FordLower.suffixProduct R.lower K =
      ∏ i, R.lower i := by
    unfold FordLower.prefixProduct FordLower.suffixProduct
    have := Finset.prod_filter_mul_prod_filter_not Finset.univ
      (fun i : Fin (FordScale.coreDimension M (logLog y)) => i.val < K) R.lower
    simpa only [not_lt] using this
  
  have hpre : FordLower.prefixProduct R.lower K = ∏ i : Fin K, R.lower (Fin.castLE hK i) := by
    symm
    apply Finset.prod_bij (fun i _ => Fin.castLE hK i)
    · intro i _
      exact Finset.mem_filter.mpr ⟨Finset.mem_univ _, i.isLt⟩
    · intro i _ j _ hij
      exact Fin.castLE_injective hK hij
    · intro j hj
      refine ⟨⟨j.val, (Finset.mem_filter.mp hj).2⟩, Finset.mem_univ _, ?_⟩
      exact Fin.ext rfl
    · intro i _
      rfl
  have hz : R.fullTuple 0 = R.leading := rfl
  have htl : Fin.tail R.fullTuple = R.lower := rfl
  rw [hz, htl, hcons]
  
  have c1 : N = R.leading * FordLower.prefixProduct R.lower K *
      FordLower.suffixProduct R.lower K := by
    rw [mul_assoc, hpm]; exact R.integer
  
  have hξ : ∀ j, FordInner.targetParameter (FordScale.coreDimension M (logLog y)) M j ≤ 1 := by
    intro j
    unfold FordInner.targetParameter
    split_ifs
    · have : 0 ≤ FordInner.baseLoss M (FordScale.coreDimension M (logLog y) - j) := by
        unfold FordInner.baseLoss; positivity
      linarith
    · norm_num
  have hE : FordGeometry.polytope K (fun _ => 1) ⊆ Set.Icc (fun _ => 0) (fun _ => 1) :=
    fun x hx => ⟨fun i => hx.1 i, fun i => hx.2.1 i⟩
  have c3 : FordLower.prefixProduct R.lower K ∈
      FordReciprocal.tupleIntegers K (logLog y) (FordGeometry.polytope K (fun _ => 1)) := by
    rw [hpre]
    exact hmem ht hE (fun i => R.lower (Fin.castLE hK i)) (fun i => R.lower_prime _)
      (fun i j hij => R.lower_order.antitone (show Fin.castLE hK i ≤ Fin.castLE hK j from hij))
      (htrunc hK hξ R.point.1.1)
  
  have c4 : 0 < FordLower.prefixProduct R.lower K := by
    unfold FordLower.prefixProduct
    exact Finset.prod_pos (fun i _ => (R.lower_prime i).pos)
  have c5 : 0 < FordLower.suffixProduct R.lower K := by
    unfold FordLower.suffixProduct
    exact Finset.prod_pos (fun i _ => (R.lower_prime i).pos)
  
  have hy0 : 0 < y := by linarith
  have c6 : (19 / 20 : ℝ) * Real.log y ≤ Real.log (R.leading : ℝ) := by
    have h := Real.log_lt_log (Real.rpow_pos_of_pos hy0 _) R.leading_size
    rw [Real.log_rpow hy0] at h
    exact h.le
  
  have c7 : ((R.leading : ℝ) - 1) * ((FordLower.prefixProduct R.lower K).totient : ℝ) *
      ((FordLower.suffixProduct R.lower K).totient : ℝ) ≤ y := by
    have hP1 : 1 ≤ R.leading := R.leading_prime.one_lt.le
    have h1 := Nat.totient_super_multiplicative R.leading (FordLower.prefixProduct R.lower K)
    have h2 := Nat.totient_super_multiplicative
      (R.leading * FordLower.prefixProduct R.lower K) (FordLower.suffixProduct R.lower K)
    have hnat : R.leading.totient * (FordLower.prefixProduct R.lower K).totient *
        (FordLower.suffixProduct R.lower K).totient ≤ N.totient :=
      le_of_le_of_eq ((Nat.mul_le_mul_right _ h1).trans h2) (congrArg Nat.totient c1.symm)
    rw [Nat.totient_prime R.leading_prime] at hnat
    have hR : (((R.leading - 1) * (FordLower.prefixProduct R.lower K).totient *
        (FordLower.suffixProduct R.lower K).totient : ℕ) : ℝ) ≤ (N.totient : ℝ) := by
      exact_mod_cast hnat
    push_cast [Nat.cast_sub hP1] at hR
    linarith [R.totient_range.2]
  exact ⟨c1, R.leading_prime, c3, c4, c5, c6, c7⟩

theorem exists_maximal_prefix_class_bound (hPNT : Tendsto (fun x : ℝ => (Nat.primeCounting ⌊x⌋₊ : ℝ) / (x / Real.log x)) atTop (𝓝 1))
    (hMERT : ∃ C : ℝ, ∀ x : ℝ, 2 ≤ x →
      |(∑ p ∈ (Finset.Iic ⌊x⌋₊).filter Nat.Prime, (1 : ℝ) / p) - Real.log (Real.log x)| ≤ C)
    (hEULER : Asymptotics.IsEquivalent atTop
      (fun x : ℝ => ∏ p ∈ (Finset.Iic ⌊x⌋₊).filter Nat.Prime, (1 - (1 : ℝ) / p))
      (fun x => Real.exp (-Real.eulerMascheroniConstant) / Real.log x))
    (hRHO : 0 < FordAnalysis.rho ∧ FordAnalysis.rho < 3 / 4 ∧ FordAnalysis.F FordAnalysis.rho = 1) :
    ∃ C : ℝ, 0 < C ∧ ∀ (M : ℕ) (A y : ℝ)
      (a : Fin (FordScale.coreDimension M (logLog y))) (F : Finset ℕ)
      (q : ℕ → Fin (FordScale.coreDimension M (logLog y) + 1) → ℕ),
      1 < y → Real.exp 1 ≤ logLog y →
      (∀ n ∈ F, ∃ R : FordLower.PrimeProductRecord M A y a n, R.fullTuple = q n) →
      ∀ K : ℕ, K ≤ FordScale.coreDimension M (logLog y) →
        ((FordLower.prefixCollisionClass F q (K + 1)).card : ℝ) ≤
          C * (y / Real.log y) * ((logLog y) ^ K * FordGeometry.modelVolume K) *
            ∑ s ∈ FordLower.suffixCollisionFamily F q (K + 1), ((s.totient : ℝ))⁻¹ :=
by
  obtain ⟨C₃, hC₃, h3⟩ := pc_two_factor_prime_count_bound hPNT
  obtain ⟨C₄, hC₄, h4⟩ := pc_tupleIntegers_reciprocal_mass_upper prime_reciprocal_log_error
  have hREN := ford_renewal_scaled_bounds hRHO
  have hB : 0 < C₄ * (3 + Real.exp 80) := mul_pos hC₄ (by positivity)
  
  have hs8 : ∀ (M : ℕ) (t : ℝ), Real.exp 1 ≤ t → ∀ K : ℕ, K ≤ FordScale.coreDimension M t →
      (∑ n ∈ FordReciprocal.tupleIntegers K t (FordGeometry.polytope K (fun _ => 1)),
        ((n.totient : ℝ))⁻¹) ≤ (C₄ * (3 + Real.exp 80)) * t ^ K * FordGeometry.modelVolume K := by
    intro M t ht K hK
    have ht0 : 0 < t := (Real.exp_pos 1).trans_le ht
    have ht1 : 1 ≤ t := (Real.one_le_exp zero_le_one).trans ht
    have hτ0 : 0 ≤ 1 / t := one_div_nonneg.mpr ht0.le
    have hτ1 : 1 / t ≤ 1 := (div_le_one ht0).mpr ht1
    have hsmall : 2 ≤ K → 1 / t ≤ 10 * FordAnalysis.rho ^ K / (K : ℝ) :=
      fun h2 => pc_prefix_mesh_bound hRHO M t ht K (by omega) hK
    have hE : FordGeometry.polytope K (fun _ => 1) ⊆ Set.Icc (fun _ => 0) (fun _ => 1) :=
      fun x hx => ⟨fun i => hx.1 i, fun i => hx.2.1 i⟩
    have hm := h4 K t _ ht0 hE
    have hv := pc_thickened_unit_polytope_model_bound hREN K (1 / t) hτ0 hτ1 hsmall
    calc _ ≤ C₄ * t ^ K * MeasureTheory.volume.real (FordGeometry.polytope K (fun _ => 1) +
              Set.Icc (fun _ : Fin K => -(1 / t)) (fun _ => 1 / t)) := hm
      _ ≤ C₄ * t ^ K * ((3 + Real.exp 80) * FordGeometry.modelVolume K) :=
          mul_le_mul_of_nonneg_left hv (mul_nonneg hC₄.le (pow_nonneg ht0.le K))
      _ = (C₄ * (3 + Real.exp 80)) * t ^ K * FordGeometry.modelVolume K := by ring
  
  refine ⟨C₃ * (C₄ * (3 + Real.exp 80)) * (20 / 19), mul_pos (mul_pos hC₃ hB) (by norm_num), ?_⟩
  intro M A y a F q hy ht hrec K hK
  have ht0 : 0 < logLog y := (Real.exp_pos 1).trans_le ht
  have hy0 : 0 < y := by linarith
  have hlog : 0 < Real.log y := Real.log_pos hy
  have ha : 0 < (19 / 20 : ℝ) * Real.log y := mul_pos (by norm_num) hlog
  have hsub : ∀ n ∈ FordLower.prefixCollisionClass F q (K + 1), n ∈ F := by
    intro n hn
    simp only [FordLower.prefixCollisionClass, FordLower.externalTotientCollisions,
      Finset.mem_filter] at hn
    exact hn.1.1
  have hc := h3 (FordLower.prefixCollisionClass F q (K + 1))
    (FordReciprocal.tupleIntegers K (logLog y) (FordGeometry.polytope K (fun _ => 1)))
    (FordLower.suffixCollisionFamily F q (K + 1))
    (fun n => q n 0) (fun n => FordLower.prefixProduct (Fin.tail (q n)) K)
    (fun n => FordLower.suffixProduct (q n) (K + 1)) y ((19 / 20 : ℝ) * Real.log y) hy0 ha
    (by
      intro n hn
      obtain ⟨R, hR⟩ := hrec n (hsub n hn)
      have hWn : FordLower.suffixProduct (q n) (K + 1) ∈
          FordLower.suffixCollisionFamily F q (K + 1) := by
        unfold FordLower.suffixCollisionFamily
        exact Finset.mem_image.mpr ⟨n, hn, rfl⟩
      obtain ⟨h1, h2, h3', h4', h5, h6, h7⟩ := pc_record_prefix_suffix_data R K hK hy ht0
      rw [hR] at h1 h2 h3' h4' h5 h6 h7
      exact ⟨h3', hWn, h4', h5, h1, h2, h6, h7⟩)
  have hU := hs8 M (logLog y) ht K hK
  have hSW : 0 ≤ ∑ s ∈ FordLower.suffixCollisionFamily F q (K + 1), ((s.totient : ℝ))⁻¹ :=
    Finset.sum_nonneg (fun s _ => inv_nonneg.mpr (Nat.cast_nonneg _))
  have hcoef : 0 ≤ C₃ * y / ((19 / 20 : ℝ) * Real.log y) :=
    div_nonneg (mul_nonneg hC₃.le hy0.le) ha.le
  calc ((FordLower.prefixCollisionClass F q (K + 1)).card : ℝ)
      ≤ C₃ * y / ((19 / 20 : ℝ) * Real.log y) *
          (∑ b ∈ FordReciprocal.tupleIntegers K (logLog y) (FordGeometry.polytope K (fun _ => 1)),
            ((b.totient : ℝ))⁻¹) *
          (∑ s ∈ FordLower.suffixCollisionFamily F q (K + 1), ((s.totient : ℝ))⁻¹) := hc
    _ ≤ C₃ * y / ((19 / 20 : ℝ) * Real.log y) *
          ((C₄ * (3 + Real.exp 80)) * (logLog y) ^ K * FordGeometry.modelVolume K) *
          (∑ s ∈ FordLower.suffixCollisionFamily F q (K + 1), ((s.totient : ℝ))⁻¹) :=
        mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hU hcoef) hSW
    _ = C₃ * (C₄ * (3 + Real.exp 80)) * (20 / 19) * (y / Real.log y) *
          ((logLog y) ^ K * FordGeometry.modelVolume K) *
          ∑ s ∈ FordLower.suffixCollisionFamily F q (K + 1), ((s.totient : ℝ))⁻¹ := by
        field_simp

theorem ford_renewal_numerics (hRHO : 0 < FordAnalysis.rho ∧ FordAnalysis.rho < 3 / 4 ∧ FordAnalysis.F FordAnalysis.rho = 1) :
    ((217 / 400 : ℝ) < FordAnalysis.rho ∧ FordAnalysis.rho < 2713 / 5000) ∧
    ((161 / 500 : ℝ) < 1 / (FordAnalysis.rho * deriv FordAnalysis.F FordAnalysis.rho) ∧
      1 / (FordAnalysis.rho * deriv FordAnalysis.F FordAnalysis.rho) < 1 / 3) ∧
    (∀ n : ℕ, 1 ≤ n → n < 20 →
      FordAnalysis.g n * FordAnalysis.rho ^ n < 17 / 50 ∧
      (2 ≤ n → (31 / 100 : ℝ) < FordAnalysis.g n * FordAnalysis.rho ^ n ∧
        (147 / 1000 : ℝ) < (FordAnalysis.g n - FordAnalysis.g (n - 1)) * FordAnalysis.rho ^ n)) :=
by
  obtain ⟨hρ0, hρ34, hF⟩ := hRHO
  have hρ1 : FordAnalysis.rho < 1 := by linarith
  have hlog := log_prime_bounds
  
  
  have coeff_log_sandwich : ∀ k : ℕ, 1 ≤ k → Real.log (k : ℝ) ≤ FordAnalysis.coeff k ∧
      FordAnalysis.coeff k ≤ Real.log ((k : ℝ) + 1) := by
    intro k hk
    have hk1 : (1 : ℝ) ≤ k := by exact_mod_cast hk
    have hkpos : (0 : ℝ) < k := by linarith
    have hk0 : (k : ℝ) ≠ 0 := hkpos.ne'
    have hk10 : (k : ℝ) + 1 ≠ 0 := by positivity
    have hceq : FordAnalysis.coeff k =
        ((k : ℝ) + 1) * Real.log ((k : ℝ) + 1) - k * Real.log k - 1 := by
      simp only [FordAnalysis.coeff, fordWeight, if_neg (by omega : k ≠ 0)]
    have hx : Real.log (((k : ℝ) + 1) / k) = Real.log ((k : ℝ) + 1) - Real.log k :=
      Real.log_div hk10 hk0
    have hup : Real.log (((k : ℝ) + 1) / k) ≤ ((k : ℝ) + 1) / k - 1 :=
      Real.log_le_sub_one_of_pos (by positivity)
    have hlo : 1 - (((k : ℝ) + 1) / k)⁻¹ ≤ Real.log (((k : ℝ) + 1) / k) :=
      Real.one_sub_inv_le_log_of_pos (by positivity)
    have e1 : ((k : ℝ) + 1) / k - 1 = 1 / k := by field_simp; ring
    have e2 : 1 - (((k : ℝ) + 1) / k)⁻¹ = 1 / ((k : ℝ) + 1) := by field_simp; ring
    rw [hx, e1] at hup
    rw [hx, e2] at hlo
    have h1 : (k : ℝ) * (Real.log ((k : ℝ) + 1) - Real.log k) ≤ 1 := by
      have := mul_le_mul_of_nonneg_left hup hkpos.le
      rwa [mul_one_div_cancel hk0] at this
    have h2 : 1 ≤ ((k : ℝ) + 1) * (Real.log ((k : ℝ) + 1) - Real.log k) := by
      have := mul_le_mul_of_nonneg_left hlo (by positivity : (0 : ℝ) ≤ (k : ℝ) + 1)
      rwa [mul_one_div_cancel hk10] at this
    rw [hceq]
    constructor <;> nlinarith
  have hc : ∀ k : ℕ, 0 ≤ FordAnalysis.coeff k ∧ FordAnalysis.coeff k ≤ (k : ℝ) := by
    intro k
    rcases Nat.eq_zero_or_pos k with rfl | hk
    · simp [FordAnalysis.coeff]
    · obtain ⟨h1, h2⟩ := coeff_log_sandwich k hk
      have hk1 : (1 : ℝ) ≤ k := by exact_mod_cast hk
      have hl0 : 0 ≤ Real.log (k : ℝ) := Real.log_nonneg hk1
      have hl1 : Real.log ((k : ℝ) + 1) ≤ (k : ℝ) + 1 - 1 :=
        Real.log_le_sub_one_of_pos (by positivity)
      constructor <;> linarith
  
  
  have hsumm : ∀ z : ℝ, 0 ≤ z → z < 1 →
      Summable (fun k : ℕ => FordAnalysis.coeff k * z ^ k) := by
    intro z hz0 hz1
    have hg : Summable (fun k : ℕ => (k : ℝ) ^ 1 * z ^ k) :=
      summable_pow_mul_geometric_of_norm_lt_one 1
        (by rw [Real.norm_eq_abs, abs_of_nonneg hz0]; exact hz1)
    refine Summable.of_nonneg_of_le (fun k => mul_nonneg (hc k).1 (pow_nonneg hz0 k))
      (fun k => ?_) hg
    rw [pow_one]
    exact mul_le_mul_of_nonneg_right (hc k).2 (pow_nonneg hz0 k)
  have hmono : ∀ x y : ℝ, 0 ≤ x → x ≤ y → y < 1 → FordAnalysis.F x ≤ FordAnalysis.F y := by
    intro x y hx hxy hy
    exact Summable.tsum_le_tsum
      (fun n => mul_le_mul_of_nonneg_left (pow_le_pow_left₀ hx hxy n) (hc n).1)
      (hsumm x hx (lt_of_le_of_lt hxy hy)) (hsumm y (hx.trans hxy) hy)
  have hpre : ∀ z : ℝ, 0 ≤ z → z < 1 → ∀ N : ℕ,
      ∑ n ∈ Finset.range N, FordAnalysis.coeff n * z ^ n ≤ FordAnalysis.F z := by
    intro z hz0 hz1 N
    exact Summable.sum_le_tsum (Finset.range N)
      (fun i _ => mul_nonneg (hc i).1 (pow_nonneg hz0 i)) (hsumm z hz0 hz1)
  have htail : ∀ z : ℝ, 0 ≤ z → z < 1 → ∀ N : ℕ, FordAnalysis.F z ≤
      ∑ n ∈ Finset.range N, FordAnalysis.coeff n * z ^ n +
        z ^ N * ((N : ℝ) / (1 - z) + z / (1 - z) ^ 2) := by
    intro z hz0 hz1 N
    have hs := hsumm z hz0 hz1
    have hsplit := hs.sum_add_tsum_nat_add N
    have htl : Summable (fun i : ℕ => FordAnalysis.coeff (i + N) * z ^ (i + N)) :=
      (summable_nat_add_iff N).mpr hs
    have hz : ‖z‖ < 1 := by rw [Real.norm_eq_abs, abs_of_nonneg hz0]; exact hz1
    have h1 : HasSum (fun i : ℕ => (i : ℝ) * z ^ i) (z / (1 - z) ^ 2) :=
      hasSum_coe_mul_geometric_of_norm_lt_one hz
    have h2 : HasSum (fun i : ℕ => z ^ i) (1 - z)⁻¹ := hasSum_geometric_of_lt_one hz0 hz1
    have h3 : HasSum (fun i : ℕ => z ^ N * ((i : ℝ) * z ^ i) + ((N : ℝ) * z ^ N) * z ^ i)
        (z ^ N * (z / (1 - z) ^ 2) + ((N : ℝ) * z ^ N) * (1 - z)⁻¹) :=
      (h1.mul_left (z ^ N)).add (h2.mul_left ((N : ℝ) * z ^ N))
    have hle : ∑' i : ℕ, FordAnalysis.coeff (i + N) * z ^ (i + N) ≤
        z ^ N * (z / (1 - z) ^ 2) + ((N : ℝ) * z ^ N) * (1 - z)⁻¹ := by
      refine hasSum_le (fun i => ?_) htl.hasSum h3
      have hci := (hc (i + N)).2
      push_cast at hci
      have : z ^ N * ((i : ℝ) * z ^ i) + ((N : ℝ) * z ^ N) * z ^ i =
          ((i : ℝ) + N) * z ^ (i + N) := by
        rw [pow_add]; ring
      rw [this]
      exact mul_le_mul_of_nonneg_right hci (pow_nonneg hz0 _)
