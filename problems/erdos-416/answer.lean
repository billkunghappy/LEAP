theorem totient_ratio_le_logLog_of_size (hsize : ∃ D : ℝ, 0 < D ∧ ∀ᶠ Y : ℝ in atTop, ∀ n : ℕ, 0 < n → (n.totient : ℝ) ≤ Y →
      (n : ℝ) ≤ D * Y * logLog Y) :
    ∃ K : ℝ, 0 < K ∧ ∀ᶠ Y : ℝ in atTop, ∀ b : ℕ, 0 < b → (b : ℝ) ≤ Y →
      (b : ℝ) / b.totient ≤ K * logLog Y :=
by
  obtain ⟨D, hD, hsize⟩ := hsize
  obtain ⟨Y₀, hY₀⟩ := Filter.eventually_atTop.mp hsize
  have hY1 := hY₀ (max Y₀ 16) (le_max_left _ _)
  obtain ⟨K, hKdef⟩ : ∃ K : ℝ, K = D + |D * max Y₀ 16 * logLog (max Y₀ 16)| + 1 := ⟨_, rfl⟩
  have hDK : D ≤ K := by
    have := abs_nonneg (D * max Y₀ 16 * logLog (max Y₀ 16)); linarith
  have hBK : |D * max Y₀ 16 * logLog (max Y₀ 16)| ≤ K := by linarith
  have hK : 0 < K := by linarith
  refine ⟨K, hK, ?_⟩
  have hLL : Tendsto logLog atTop atTop :=
    Real.tendsto_log_atTop.comp Real.tendsto_log_atTop
  filter_upwards [hLL.eventually_ge_atTop 1] with Y hY b hb hbY
  have hφ1 : (1:ℝ) ≤ b.totient := by exact_mod_cast Nat.totient_pos.mpr hb
  have hφpos : (0:ℝ) < b.totient := by linarith
  have hφb : (b.totient : ℝ) ≤ b := by exact_mod_cast Nat.totient_le b
  have hφY : (b.totient : ℝ) ≤ Y := hφb.trans hbY
  have hLLnn : 0 ≤ logLog Y := by linarith
  by_cases hcase : max Y₀ 16 ≤ (b.totient : ℝ)
  · have h := hY₀ (b.totient : ℝ) ((le_max_left _ _).trans hcase) b hb le_rfl
    have h16 : (16:ℝ) ≤ b.totient := (le_max_right _ _).trans hcase
    have hlogφ : 0 < Real.log (b.totient : ℝ) := Real.log_pos (by linarith)
    have hll : logLog (b.totient : ℝ) ≤ logLog Y := by
      unfold logLog
      exact Real.log_le_log hlogφ (Real.log_le_log hφpos hφY)
    have h2 : (b:ℝ) ≤ K * logLog Y * b.totient := by
      calc (b:ℝ) ≤ D * b.totient * logLog b.totient := h
        _ ≤ D * b.totient * logLog Y :=
          mul_le_mul_of_nonneg_left hll (mul_nonneg hD.le hφpos.le)
        _ = D * logLog Y * b.totient := by ring
        _ ≤ K * logLog Y * b.totient :=
          mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right hDK hLLnn) hφpos.le
    rw [div_le_iff₀ hφpos]
    exact h2
  · push_neg at hcase
    have h := hY1 b hb hcase.le
    have hbB : (b:ℝ) ≤ |D * max Y₀ 16 * logLog (max Y₀ 16)| := h.trans (le_abs_self _)
    have hb0 : (0:ℝ) ≤ b := Nat.cast_nonneg b
    have hdiv : (b:ℝ) / b.totient ≤ b := by
      rw [div_le_iff₀ hφpos]
      nlinarith
    calc (b:ℝ) / b.totient ≤ b := hdiv
      _ ≤ |D * max Y₀ 16 * logLog (max Y₀ 16)| := hbB
      _ ≤ K := hBK
      _ ≤ K * logLog Y := le_mul_of_one_le_right hK.le hY

theorem threeForm_sieve_error_absorb : ∃ E : ℝ, 0 < E ∧ ∀ x : ℝ, 2 ≤ x →
    Real.sqrt x * (1 + Real.log (Real.sqrt x)) ^ 9 + Real.sqrt x + 1 ≤ E * x / Real.log x ^ 3 :=
by
  refine ⟨24 * 12 ^ 12, by norm_num, ?_⟩
  intro x hx
  have hx0 : (0 : ℝ) ≤ x := by linarith
  have hs0 : 0 ≤ Real.sqrt x := Real.sqrt_nonneg x
  have hsx : Real.sqrt x ^ 2 = x := Real.sq_sqrt hx0
  have hs1 : 1 < Real.sqrt x := by nlinarith
  have hl0 : 0 < Real.log (Real.sqrt x) := Real.log_pos hs1
  have hlogx : Real.log x = 2 * Real.log (Real.sqrt x) := by
    have h : Real.log (Real.sqrt x ^ 2) = (2 : ℕ) * Real.log (Real.sqrt x) := Real.log_pow _ _
    rw [hsx] at h
    rw [h]; push_cast; ring
  set s := Real.sqrt x with hs
  set l := Real.log s with hl
  have hkey : (1 + l) ^ 12 ≤ 12 ^ 12 * s := by
    have h1 : l / 12 + 1 ≤ Real.exp (l / 12) := Real.add_one_le_exp (l / 12)
    have h2 : (l / 12 + 1) ^ 12 ≤ Real.exp (l / 12) ^ 12 :=
      pow_le_pow_left₀ (by positivity) h1 12
    have h3 : Real.exp (l / 12) ^ 12 = s := by
      rw [← Real.exp_nat_mul]
      push_cast
      rw [show (12 : ℝ) * (l / 12) = l by ring]
      exact Real.exp_log (by linarith)
    calc (1 + l) ^ 12 ≤ (12 + l) ^ 12 := pow_le_pow_left₀ (by linarith) (by linarith) 12
      _ = 12 ^ 12 * (l / 12 + 1) ^ 12 := by ring
      _ ≤ 12 ^ 12 * Real.exp (l / 12) ^ 12 :=
          mul_le_mul_of_nonneg_left h2 (by positivity)
      _ = 12 ^ 12 * s := by rw [h3]
  have hA : 1 ≤ (1 + l) ^ 9 := one_le_pow₀ (by linarith)
  have hL : s * (1 + l) ^ 9 + s + 1 ≤ 3 * s * (1 + l) ^ 9 := by nlinarith
  have hcube : l ^ 3 ≤ (1 + l) ^ 3 := pow_le_pow_left₀ hl0.le (by linarith) 3
  have hR : 24 * 12 ^ 12 * x / Real.log x ^ 3 = 24 * 12 ^ 12 * s ^ 2 / (2 * l) ^ 3 := by
    rw [hlogx, hsx]
  rw [hR, le_div_iff₀ (by positivity : (0:ℝ) < (2 * l) ^ 3)]
  have hpos9 : 0 ≤ 3 * s * (1 + l) ^ 9 := by positivity
  calc (s * (1 + l) ^ 9 + s + 1) * (2 * l) ^ 3
      ≤ (3 * s * (1 + l) ^ 9) * (8 * l ^ 3) := by
        rw [show (2 * l) ^ 3 = 8 * l ^ 3 by ring]
        exact mul_le_mul_of_nonneg_right hL (by positivity)
    _ ≤ (3 * s * (1 + l) ^ 9) * (8 * (1 + l) ^ 3) :=
        mul_le_mul_of_nonneg_left (by linarith) hpos9
    _ = 24 * s * (1 + l) ^ 12 := by ring
    _ ≤ 24 * s * (12 ^ 12 * s) := mul_le_mul_of_nonneg_left hkey (by positivity)
    _ = 24 * 12 ^ 12 * s ^ 2 := by ring

theorem threeForm_prime_count_of_sifted_bound (hsift : ∀ (a b N : ℕ) (L : ℝ), 0 < a → a < b → 1 < L →
      (((Finset.range N).filter (fun n => ∀ p : ℕ, p.Prime → (p : ℝ) ≤ L →
          ¬ p ∣ 6 * a * b * (b - a) → ¬ p ∣ n * (a * n + 1) * (b * n + 1))).card : ℝ) ≤
        216 * (((6 * a * b * (b - a) : ℕ) : ℝ) / (6 * a * b * (b - a)).totient) ^ 3 * N /
            Real.log L ^ 3 + L * (1 + Real.log L) ^ 9)
    (herr : ∃ E : ℝ, 0 < E ∧ ∀ x : ℝ, 2 ≤ x →
      Real.sqrt x * (1 + Real.log (Real.sqrt x)) ^ 9 + Real.sqrt x + 1 ≤ E * x / Real.log x ^ 3) :
    ∃ C : ℝ, 0 < C ∧ ∀ (a b : ℕ) (x : ℝ) (Q : Finset ℕ), 0 < a → a < b → 2 ≤ x →
      (∀ q ∈ Q, q.Prime ∧ (a * q + 1).Prime ∧ (b * q + 1).Prime ∧ (q : ℝ) ≤ x) →
      (Q.card : ℝ) ≤ C * (((6 * a * b * (b - a) : ℕ) : ℝ) / (6 * a * b * (b - a)).totient) ^ 3 *
        x / Real.log x ^ 3 :=
by
  obtain ⟨E, hE, hEb⟩ := herr
  refine ⟨3456 + E, by linarith, ?_⟩
  intro a b x Q ha hab hx hQ
  have hx0 : 0 < x := by linarith
  have hx1 : 1 < x := by linarith
  have hℓ0 : 0 < Real.log x := Real.log_pos hx1
  have hℓ3 : 0 < Real.log x ^ 3 := by positivity
  have hba : 0 < b - a := Nat.sub_pos_of_lt hab
  have hb0 : 0 < b := lt_trans ha hab
  have hDpos : 0 < 6 * a * b * (b - a) := by positivity
  have hφ : (0:ℝ) < (6 * a * b * (b - a)).totient := by
    exact_mod_cast Nat.totient_pos.mpr hDpos
  have hφD : ((6 * a * b * (b - a)).totient : ℝ) ≤ ((6 * a * b * (b - a) : ℕ) : ℝ) := by
    exact_mod_cast Nat.totient_le _
  obtain ⟨r, hr⟩ : ∃ r : ℝ,
      r = ((6 * a * b * (b - a) : ℕ) : ℝ) / (6 * a * b * (b - a)).totient := ⟨_, rfl⟩
  have hr1 : 1 ≤ r := by rw [hr, le_div_iff₀ hφ]; linarith
  have hR3 : 1 ≤ r ^ 3 := one_le_pow₀ hr1
  have hsq0 : 0 ≤ Real.sqrt x := Real.sqrt_nonneg x
  have hL1 : 1 < Real.sqrt x := by
    rw [show (1:ℝ) = Real.sqrt 1 from Real.sqrt_one.symm]
    exact Real.sqrt_lt_sqrt (by norm_num) hx1
  have hlogL : Real.log (Real.sqrt x) = Real.log x / 2 := Real.log_sqrt hx0.le
  obtain ⟨N, hN⟩ : ∃ N : ℕ, N = ⌊x⌋₊ + 1 := ⟨_, rfl⟩
  have hNx : (N : ℝ) ≤ 2 * x := by
    rw [hN]; push_cast; linarith [Nat.floor_le hx0.le]
  have hS := hsift a b N (Real.sqrt x) ha hab hL1
  rw [← hr, hlogL] at hS
  have hEx := hEb x hx
  rw [hlogL, le_div_iff₀ hℓ3] at hEx
  set S := (Finset.range N).filter (fun n => ∀ p : ℕ, p.Prime → (p : ℝ) ≤ Real.sqrt x →
      ¬ p ∣ 6 * a * b * (b - a) → ¬ p ∣ n * (a * n + 1) * (b * n + 1)) with hS_def
  have hsub : Q ⊆ Q.filter (fun q : ℕ => (q : ℝ) ≤ Real.sqrt x) ∪ S := by
    intro q hq
    obtain ⟨hqp, haqp, hbqp, hqx⟩ := hQ q hq
    by_cases hqL : (q : ℝ) ≤ Real.sqrt x
    · exact Finset.mem_union_left _ (Finset.mem_filter.mpr ⟨hq, hqL⟩)
    · apply Finset.mem_union_right
      push_neg at hqL
      rw [hS_def, Finset.mem_filter, Finset.mem_range]
      refine ⟨?_, ?_⟩
      · have : q ≤ ⌊x⌋₊ := Nat.le_floor hqx
        omega
      · intro p hp hpL _ hdvd
        have hq0 : (0:ℝ) ≤ q := by positivity
        rcases (Nat.Prime.dvd_mul hp).mp hdvd with h | h
        · rcases (Nat.Prime.dvd_mul hp).mp h with h' | h'
          · have hpq := (Nat.prime_dvd_prime_iff_eq hp hqp).mp h'
            rw [hpq] at hpL
            linarith
          · have hpq := (Nat.prime_dvd_prime_iff_eq hp haqp).mp h'
            have hq_lt : (q : ℝ) < p := by
              rw [hpq]; push_cast
              have : (1:ℝ) ≤ a := by exact_mod_cast ha
              nlinarith
            linarith
        · have hpq := (Nat.prime_dvd_prime_iff_eq hp hbqp).mp h
          have hq_lt : (q : ℝ) < p := by
            rw [hpq]; push_cast
            have : (1:ℝ) ≤ b := by exact_mod_cast hb0
            nlinarith
          linarith
  have hA : (Q.filter (fun q : ℕ => (q : ℝ) ≤ Real.sqrt x)).card ≤ ⌊Real.sqrt x⌋₊ := by
    calc (Q.filter (fun q : ℕ => (q : ℝ) ≤ Real.sqrt x)).card
        ≤ (Finset.Icc 1 ⌊Real.sqrt x⌋₊).card := by
          apply Finset.card_le_card
          intro q hq
          rw [Finset.mem_filter] at hq
          rw [Finset.mem_Icc]
          exact ⟨(hQ q hq.1).1.one_lt.le, Nat.le_floor hq.2⟩
      _ = ⌊Real.sqrt x⌋₊ := by simp
  have hcard : (Q.card : ℝ) ≤ Real.sqrt x + S.card := by
    have h1 : Q.card ≤ ⌊Real.sqrt x⌋₊ + S.card :=
      (Finset.card_le_card hsub).trans ((Finset.card_union_le _ _).trans (by omega))
