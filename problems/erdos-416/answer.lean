        (logLog (v (j + 1)) - logLog (v (j + 2)) +
          Real.sqrt (logLog (normalityScale (logLog Y)) * logLog Y))))
    hk hanti hA0 (fun j _ => hBnn j) hfirst
    (fun j hj σ hσ => hMY k l d R v W F cut hcut hk hl hSv hanti hv0 hW hgap hR hcut1 hd hdv hF
      j (by omega) σ hσ)
  have hterm := hTmY k l d R v W F cut hcut hk hl hSv hanti hv0 hW hgap hR hcut1 hd hdv hF
  have hfin := hT Y k l d R v W hY1 hT1 hk hSv hanti hW hR hd
  refine hiter.trans (le_trans ?_ hfin)
  exact mul_le_mul_of_nonneg_left hterm
    (mul_nonneg hA0 (Finset.prod_nonneg (fun j _ => hBnn j)))

theorem retained_cutoff_exponent_eventually {A : ℝ} (hA : 0 ≤ A) :
    ∀ᶠ Y : ℝ in atTop, ∀ (L : ℕ) (p : Fin (L + 1) → ℕ)
