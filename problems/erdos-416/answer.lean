    fun x hx => hX₁ x ((le_max_left _ _).trans hx)
  have hC₀ : 1 ≤ max 1 (Real.log X₀) := le_max_left _ _
  set C₀ := max 1 (Real.log X₀) with hC₀def
  have hbase₀ : ∀ u : ℝ, 2 ≤ u → u ≤ X₀ → ((totientsUpTo u).card : ℝ) ≤ C₀ * u / Real.log u :=
    fun u hu hux => s1 X₀ u hu hux
  have hX₀pos : 0 < X₀ := lt_of_lt_of_le (Real.exp_pos _) hX₀e
  have hlX₀ : Real.exp 1 ≤ Real.log X₀ := by
    have := Real.log_le_log (Real.exp_pos _) hX₀e
    rwa [Real.log_exp] at this
  have hlX₀pos : 0 < Real.log X₀ := lt_of_lt_of_le (Real.exp_pos _) hlX₀
  have ht₀ : 1 ≤ logLog X₀ := by
    have := Real.log_le_log (Real.exp_pos _) hlX₀
    rw [Real.log_exp] at this
    exact this
  have hexpt₀ : Real.exp (Real.exp (logLog X₀)) = X₀ := by
    unfold logLog
    rw [Real.exp_log hlX₀pos, Real.exp_log hX₀pos]
  
  have s3 : ∀ (x A' : ℝ), X₀ ≤ x → 1 ≤ A' →
      (∀ u : ℝ, 2 ≤ u → u ≤ envelopeTailEndpoint (logLog x) →
        ((totientsUpTo u).card : ℝ) ≤ A' * u / Real.log u) →
      ∀ A : ℝ, 1 ≤ A →
      (∀ u : ℝ, 2 ≤ u → u ≤ x → ((totientsUpTo u).card : ℝ) ≤ A * u / Real.log u) →
      ∀ u : ℝ, 2 ≤ u → u ≤ x → ((totientsUpTo u).card : ℝ) ≤
        max C₀ (A / 4 + K * logLog x ^ 2 * A') * u / Real.log u := by
    intro x A' hx hA' hY A hA hAx u hu hux
    have hlogu : 0 < Real.log u := Real.log_pos (by linarith)
