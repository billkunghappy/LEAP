    Finset.sum_nonneg (fun _ _ => by positivity)
  have h4' : ∑ t ∈ totientsUpTo (envelopeTailEndpoint (logLog x)), (1 : ℝ) / t ≤
      K₈ * A * (2 * logLog x) := by
    calc _ ≤ K₈ * A * (1 + logLog (envelopeTailEndpoint (logLog x))) := h4
      _ ≤ K₈ * A * (2 * logLog x) := by
        apply mul_le_mul_of_nonneg_left _ (by positivity)
        rw [hLLY]; linarith
  have hKT : 0 ≤ K₇ * logLog x := mul_nonneg hK₇.le hT0
  have h5 := h2.trans (mul_le_mul h3 h4' hsumTY hKT)
  have hc0 : 0 ≤ 2 * C * x / (Real.log x / 6) := by positivity
  calc ((envelopeRetainedTotients x).card : ℝ)
      ≤ 2 * C * x / (Real.log x / 6) * ∑ b ∈ totientsUpTo (envelopeTailEndpoint (logLog x)) ∪
      (((Finset.Iic ⌊2 * x⌋₊).filter Nat.Prime) ×ˢ totientsUpTo (envelopeTailEndpoint (logLog x))).image
        (fun qt : ℕ × ℕ => (qt.1 - 1) * qt.2), (1 : ℝ) / b := h1
    _ ≤ 2 * C * x / (Real.log x / 6) * (K₇ * logLog x * (K₈ * A * (2 * logLog x))) :=
      mul_le_mul_of_nonneg_left h5 hc0
    _ = 24 * C * K₇ * K₈ * x / Real.log x * logLog x ^ 2 * A := by
      field_simp
      ring

theorem envelope_growth_cover : ∀ᶠ x : ℝ in atTop, totientsUpTo x ⊆
      totientsUpTo (Real.sqrt x) ∪ fiveLogOmegaTotients x ∪
      ((totientsUpTo x).filter (fun m => ∃ n : ℕ, 0 < n ∧ n.totient = m ∧
        ∃ q : ℕ, q.Prime ∧ q ∣ n ∧ ¬ SNormal (envelopeNormalityScale (logLog x)) q)) ∪
      envelopeThreeLargeNormalTotients x ∪ largeSquareTotients x ∪ envelopeRetainedTotients x :=
by
  have hT : Tendsto logLog atTop atTop :=
    Real.tendsto_log_atTop.comp Real.tendsto_log_atTop
  have h : (fun T : ℝ => 4 * T) =o[atTop] (fun T => Real.exp ((4 / 5 : ℝ) * T)) := by
    have := (isLittleO_pow_exp_pos_mul_atTop 1 (by norm_num : (0 : ℝ) < 4 / 5)).const_mul_left 4
    simpa only [pow_one] using this
  have hcut : ∀ᶠ x : ℝ in atTop, Real.log x ^ 4 ≤ envelopeLargePrimeCutoff (logLog x) := by
    filter_upwards [hT.eventually (h.def (by norm_num : (0 : ℝ) < 1)), hT.eventually_ge_atTop 0,
      eventually_gt_atTop (1 : ℝ)] with x hsmall hT0 hx
    rw [Real.norm_eq_abs, Real.norm_eq_abs, abs_of_nonneg (by linarith),
      abs_of_pos (Real.exp_pos _), one_mul] at hsmall
    have hlog : 0 < Real.log x := Real.log_pos hx
    have hpow : Real.log x ^ 4 = Real.exp (4 * logLog x) := by
      rw [show (4 : ℝ) * logLog x = ((4 : ℕ) : ℝ) * logLog x by norm_num, Real.exp_nat_mul]
      unfold logLog
      rw [Real.exp_log hlog]
    rw [hpow]
    unfold envelopeLargePrimeCutoff
    exact Real.exp_le_exp.mpr hsmall
  filter_upwards [eventually_ge_atTop (9 : ℝ), hcut] with x hx hcut
  have hx0 : (0 : ℝ) ≤ x := by linarith
  intro m hm
  simp only [Finset.mem_union]
  by_cases hA : m ∈ totientsUpTo (Real.sqrt x)
  · tauto
  by_cases hB : m ∈ fiveLogOmegaTotients x
  · tauto
  by_cases hC : m ∈ ((totientsUpTo x).filter (fun m => ∃ n : ℕ, 0 < n ∧ n.totient = m ∧
        ∃ q : ℕ, q.Prime ∧ q ∣ n ∧ ¬ SNormal (envelopeNormalityScale (logLog x)) q))
  · tauto
  by_cases hD : m ∈ envelopeThreeLargeNormalTotients x
  · tauto
  by_cases hE : m ∈ largeSquareTotients x
  · tauto
  right
  have hm' := hm
  unfold totientsUpTo at hm'
  rw [Finset.mem_filter, Finset.mem_Icc] at hm'
  obtain ⟨⟨hm1, hmfl⟩, hex⟩ := hm'
  have hmx : (m : ℝ) ≤ x := (Nat.le_floor_iff hx0).mp hmfl
  have hlarge : Real.sqrt x ≤ (m : ℝ) := by
    by_contra hlt
    push_neg at hlt
    apply hA
    unfold totientsUpTo
    rw [Finset.mem_filter, Finset.mem_Icc]
    exact ⟨⟨hm1, (Nat.le_floor_iff (Real.sqrt_nonneg x)).mpr hlt.le⟩, hex⟩
  have hs : (3 : ℝ) ≤ Real.sqrt x := Real.le_sqrt_of_sq_le (by norm_num; linarith)
  have hm3R : (3 : ℝ) ≤ m := hs.trans hlarge
  have hm3 : 3 ≤ m := by exact_mod_cast hm3R
  have hΩm : (ArithmeticFunction.cardFactors m : ℝ) ≤ 5 * logLog (m : ℝ) := by
    by_contra hc
    push_neg at hc
    exact hB (Finset.mem_filter.mpr ⟨hm, hm3, hc⟩)
  have hmpos : (1 : ℝ) < m := by linarith
  have hll : logLog (m : ℝ) ≤ logLog x := by
    unfold logLog
    have hl1 : Real.log m ≤ Real.log x := Real.log_le_log (by linarith) hmx
    exact Real.log_le_log (Real.log_pos hmpos) hl1
  have hΩx : (ArithmeticFunction.cardFactors m : ℝ) ≤ 5 * logLog x := by linarith
  obtain ⟨n, hφ⟩ := hex
  have hn : 0 < n := by
    rcases Nat.eq_zero_or_pos n with h0 | h0
    · subst h0
      rw [Nat.totient_zero] at hφ
      omega
    · exact h0
  have hsq : NoLargePrimeSquare n (envelopeLargePrimeCutoff (logLog x)) := by
    intro q hq hqH hqd
    exact hE (Finset.mem_filter.mpr ⟨hm, n, hn, hφ, q, hq, lt_of_le_of_lt hcut hqH, Or.inl hqd⟩)
  have hnorm : ∀ p ∈ n.primeFactors, SNormal (envelopeNormalityScale (logLog x)) p := by
    intro p hp
    by_contra hbad
    obtain ⟨hpprime, hpn, _⟩ := Nat.mem_primeFactors.mp hp
    exact hC (Finset.mem_filter.mpr ⟨hm, n, hn, hφ, p, hpprime, hpn, hbad⟩)
  have hcard : (n.primeFactors.filter
      (fun p : ℕ => envelopeLargePrimeCutoff (logLog x) < (p : ℝ))).card ≤ 2 := by
    by_contra hc
    have h3 : 3 ≤ (n.primeFactors.filter
        (fun p : ℕ => envelopeLargePrimeCutoff (logLog x) < (p : ℝ))).card := by omega
    obtain ⟨P, hPsub, hPcard⟩ := Finset.exists_subset_card_eq h3
    apply hD
    refine Finset.mem_filter.mpr ⟨hm, hlarge, hΩx, n, hn, hφ, P, hPcard, fun p hp => ?_⟩
    obtain ⟨hpf, hpH⟩ := Finset.mem_filter.mp (hPsub hp)
    exact ⟨hnorm p hpf, (Nat.mem_primeFactors.mp hpf).2.1, hpH⟩
  exact Finset.mem_filter.mpr ⟨hm, hlarge, hΩx, n, hn, hφ, hsq, hcard⟩

theorem envelope_nonnormal_absorbed (hPNT : Tendsto (fun x : ℝ => (Nat.primeCounting ⌊x⌋₊ : ℝ) / (x / Real.log x)) atTop (𝓝 1))
    (hMERT : ∃ C : ℝ, ∀ x : ℝ, 2 ≤ x →
      |(∑ p ∈ (Finset.Iic ⌊x⌋₊).filter Nat.Prime, (1 : ℝ) / p) - Real.log (Real.log x)| ≤ C)
    (hEULER : Asymptotics.IsEquivalent atTop
      (fun x : ℝ => ∏ p ∈ (Finset.Iic ⌊x⌋₊).filter Nat.Prime, (1 - (1 : ℝ) / p))
      (fun x => Real.exp (-Real.eulerMascheroniConstant) / Real.log x)) :
    ∀ᶠ x : ℝ in atTop, ∀ A : ℝ, 1 ≤ A →
      (∀ u : ℝ, 2 ≤ u → u ≤ x → ((totientsUpTo u).card : ℝ) ≤ A * u / Real.log u) →
      (((totientsUpTo x).filter (fun m => ∃ n : ℕ, 0 < n ∧ n.totient = m ∧
          ∃ q : ℕ, q.Prime ∧ q ∣ n ∧ ¬ SNormal (envelopeNormalityScale (logLog x)) q)).card : ℝ) ≤
        (1 / 4 : ℝ) * A * x / Real.log x :=
by
  obtain ⟨C₀, hC₀, hdens⟩ := nonnormal_prime_density_estimate hPNT hMERT hEULER
  obtain ⟨K, hK, hfin⟩ := nonnormal_totients_finite_bound
  have hLL : Tendsto logLog atTop atTop :=
    Real.tendsto_log_atTop.comp Real.tendsto_log_atTop
  have hM : 0 < K * C₀ := mul_pos hK hC₀
  have habs : ∀ T : ℝ, 256 * (K * C₀) + 1 ≤ T →
      K * C₀ * (1 + T) ^ 6 * Real.exp (-(100 * Real.log T) / 6) ≤ 1 / 4 := by
    intro T hT
    have hT0 : 0 < T := by linarith
    have hlogM : Real.log (256 * (K * C₀) + 1) ≤ Real.log T :=
      Real.log_le_log (by linarith) hT
    have hlogM0 : 0 ≤ Real.log (256 * (K * C₀) + 1) := Real.log_nonneg (by linarith)
    have hL0 : 0 ≤ Real.log T := le_trans hlogM0 hlogM
    have hpow : (1 + T) ^ 6 ≤ 64 * T ^ 6 := by
      have h2 : (1 + T) ^ 6 ≤ (2 * T) ^ 6 := pow_le_pow_left₀ (by linarith) (by linarith) 6
      calc (1 + T) ^ 6 ≤ (2 * T) ^ 6 := h2
        _ = 64 * T ^ 6 := by ring
    have h6 : Real.exp (6 * Real.log T) = T ^ 6 := by
      rw [show (6 : ℝ) * Real.log T = ((6 : ℕ) : ℝ) * Real.log T by norm_num,
        Real.exp_nat_mul, Real.exp_log hT0]
    have hexpo : 6 * Real.log T + (-(100 * Real.log T) / 6) ≤
        -Real.log (256 * (K * C₀) + 1) := by linarith
    have hE : Real.exp (6 * Real.log T + (-(100 * Real.log T) / 6)) ≤
        (256 * (K * C₀) + 1)⁻¹ := by
      have := Real.exp_le_exp.mpr hexpo
      rwa [Real.exp_neg, Real.exp_log (by linarith)] at this
    have hexpnn : 0 ≤ Real.exp (-(100 * Real.log T) / 6) := (Real.exp_pos _).le
    calc K * C₀ * (1 + T) ^ 6 * Real.exp (-(100 * Real.log T) / 6)
        ≤ K * C₀ * (64 * T ^ 6) * Real.exp (-(100 * Real.log T) / 6) := by gcongr
      _ = 64 * (K * C₀) * (Real.exp (6 * Real.log T) * Real.exp (-(100 * Real.log T) / 6)) := by
          rw [h6]; ring
      _ = 64 * (K * C₀) * Real.exp (6 * Real.log T + (-(100 * Real.log T) / 6)) := by
          rw [← Real.exp_add]
      _ ≤ 64 * (K * C₀) * (256 * (K * C₀) + 1)⁻¹ := by gcongr
      _ ≤ 1 / 4 := by
          rw [← div_eq_mul_inv, div_le_iff₀ (by linarith)]
          linarith
  filter_upwards [hLL.eventually_ge_atTop (256 * (K * C₀) + 1),
    eventually_ge_atTop (16 : ℝ)] with x hT hx16
  intro A hA henv
  have hx0 : 0 < x := by linarith
  have hlogx : 0 < Real.log x := Real.log_pos (by linarith)
  have hT1 : 1 ≤ logLog x := by linarith
  have hS : Real.exp 1 ≤ envelopeNormalityScale (logLog x) := by
    unfold envelopeNormalityScale
    apply Real.exp_le_exp.mpr
    apply Real.one_le_exp
    have := Real.log_nonneg hT1
    linarith
  have hLLS : Real.log (Real.log (envelopeNormalityScale (logLog x))) =
      100 * Real.log (logLog x) := by
    unfold envelopeNormalityScale
    rw [Real.log_exp, Real.log_exp]
  have h := hfin (envelopeNormalityScale (logLog x)) x A C₀ hS hx16 hA hC₀.le henv
    (fun z hz3 _ => hdens _ z hS hz3)
  refine h.trans ?_
  rw [hLLS]
  have hLLx : Real.log (Real.log x) = logLog x := rfl
  rw [hLLx]
  have hab := habs (logLog x) hT
  have hq : 0 ≤ A * x / Real.log x := by
    apply div_nonneg _ hlogx.le
    nlinarith
  calc K * C₀ * A * x / Real.log x * (1 + logLog x) ^ 6 *
        Real.exp (-(100 * Real.log (logLog x)) / 6)
      = (A * x / Real.log x) *
          (K * C₀ * (1 + logLog x) ^ 6 * Real.exp (-(100 * Real.log (logLog x)) / 6)) := by
        ring
    _ ≤ (A * x / Real.log x) * (1 / 4) := mul_le_mul_of_nonneg_left hab hq
    _ = (1 / 4 : ℝ) * A * x / Real.log x := by ring

theorem totient_envelope_growth (hPNT : Tendsto (fun x : ℝ => (Nat.primeCounting ⌊x⌋₊ : ℝ) / (x / Real.log x)) atTop (𝓝 1))
    (hMERT : ∃ C : ℝ, ∀ x : ℝ, 2 ≤ x →
      |(∑ p ∈ (Finset.Iic ⌊x⌋₊).filter Nat.Prime, (1 : ℝ) / p) - Real.log (Real.log x)| ≤ C)
    (hEULER : Asymptotics.IsEquivalent atTop
      (fun x : ℝ => ∏ p ∈ (Finset.Iic ⌊x⌋₊).filter Nat.Prime, (1 - (1 : ℝ) / p))
      (fun x => Real.exp (-Real.eulerMascheroniConstant) / Real.log x)) :
    ∃ B : ℝ, 0 < B ∧ ∀ᶠ x : ℝ in atTop, ∀ u : ℝ, 2 ≤ u → u ≤ x →
      ((totientsUpTo u).card : ℝ) ≤ Real.exp (B * Real.log (logLog x) ^ 2) * u / Real.log u :=
by
  obtain ⟨K₅, hK₅, hret⟩ := envelope_retained_totients_bound hPNT hMERT
  obtain ⟨D, hD, hsize⟩ := inverse_totient_size_bound hPNT hMERT hEULER
  
  have hbig : ∀ x : ℝ, Real.exp (Real.exp 1) ≤ x →
      0 < x ∧ Real.exp 1 ≤ Real.log x ∧ 1 ≤ logLog x := by
    intro x hx
    have hx0 : 0 < x := lt_of_lt_of_le (Real.exp_pos _) hx
    have hL : Real.exp 1 ≤ Real.log x := by
      have := Real.log_le_log (Real.exp_pos _) hx
      rwa [Real.log_exp] at this
    refine ⟨hx0, hL, ?_⟩
    have := Real.log_le_log (Real.exp_pos _) hL
    rw [Real.log_exp] at this
    exact this
  
  have hLS : ∀ᶠ x : ℝ in atTop, ((largeSquareTotients x).card : ℝ) ≤ x / Real.log x := by
    filter_upwards [hsize, large_prime_square_count hD,
      eventually_ge_atTop (Real.exp (Real.exp 1))] with x hs hl hx
    obtain ⟨hx0, hLx, hT⟩ := hbig x hx
    have hlog0 : 0 < Real.log x := lt_of_lt_of_le (Real.exp_pos _) hLx
    have key : ∀ m ∈ largeSquareTotients x, ∃ n : ℕ, 0 < n ∧ n.totient = m ∧
        ∃ q : ℕ, q.Prime ∧ Real.log x ^ 4 < (q : ℝ) ∧ (q ^ 2 ∣ n ∨ q ^ 2 ∣ n.totient) :=
      fun m hm => (Finset.mem_filter.mp hm).2
    let f : ℕ → ℕ := fun m => Classical.epsilon (fun n : ℕ => 0 < n ∧ n.totient = m ∧
        ∃ q : ℕ, q.Prime ∧ Real.log x ^ 4 < (q : ℝ) ∧ (q ^ 2 ∣ n ∨ q ^ 2 ∣ n.totient))
    have hf : ∀ m ∈ largeSquareTotients x, 0 < f m ∧ (f m).totient = m ∧
        ∃ q : ℕ, q.Prime ∧ Real.log x ^ 4 < (q : ℝ) ∧ (q ^ 2 ∣ f m ∨ q ^ 2 ∣ (f m).totient) :=
      fun m hm => Classical.epsilon_spec (key m hm)
    have hcard : (largeSquareTotients x).card ≤
        ((Finset.Icc 1 ⌊D * x * logLog x⌋₊).filter (fun n => ∃ q : ℕ, q.Prime ∧
          Real.log x ^ 4 < (q : ℝ) ∧ (q ^ 2 ∣ n ∨ q ^ 2 ∣ n.totient))).card := by
      refine Finset.card_le_card_of_injOn f ?_ ?_
      · intro m hm
        have hm' : m ∈ largeSquareTotients x := hm
        obtain ⟨hpos, htot, hq⟩ := hf m hm'
        have hmx : m ∈ totientsUpTo x := (Finset.mem_filter.mp hm').1
        have hmle : m ≤ ⌊x⌋₊ := (Finset.mem_Icc.mp (Finset.mem_filter.mp hmx).1).2
        have hmr : (m : ℝ) ≤ x := (Nat.le_floor_iff hx0.le).mp hmle
        have hnle : ((f m : ℕ) : ℝ) ≤ D * x * logLog x :=
          hs (f m) hpos (by rw [htot]; exact hmr)
        rw [Finset.coe_filter, Set.mem_setOf_eq, Finset.mem_Icc]
        refine ⟨⟨hpos, ?_⟩, hq⟩
        exact Nat.le_floor hnle
      · intro m hm m' hm' heq
        have h1 := (hf m hm).2.1
        have h2 := (hf m' hm').2.1
        rw [← h1, ← h2]
        exact congrArg Nat.totient heq
    have hT2 : 1 ≤ logLog x ^ 2 := one_le_pow₀ hT
    calc ((largeSquareTotients x).card : ℝ)
        ≤ (((Finset.Icc 1 ⌊D * x * logLog x⌋₊).filter (fun n => ∃ q : ℕ, q.Prime ∧
          Real.log x ^ 4 < (q : ℝ) ∧ (q ^ 2 ∣ n ∨ q ^ 2 ∣ n.totient))).card : ℝ) := by
          exact_mod_cast hcard
      _ ≤ x / (Real.log x * (logLog x) ^ 2) := hl
      _ ≤ x / Real.log x := by
          apply div_le_div_of_nonneg_left hx0.le hlog0
          nlinarith
  apply envelope_bootstrap (K₅ + 5) (by linarith)
  filter_upwards [envelope_growth_cover, envelope_five_log_omega_small hMERT,
    envelope_three_large_normal_small hPNT hMERT, hret, envelope_nonnormal_absorbed hPNT hMERT hEULER,
    hLS, eventually_ge_atTop (Real.exp (Real.exp 1))] with x hcov h1 h3 h5 h2 h4 hx
  intro A A' hA hA' henvx henvY
  obtain ⟨hx0, hLx, hT⟩ := hbig x hx
  have hlog0 : 0 < Real.log x := lt_of_lt_of_le (Real.exp_pos _) hLx
  set A0 := totientsUpTo (Real.sqrt x) with hA0
  set E1 := fiveLogOmegaTotients x with hE1
  set E2 := (totientsUpTo x).filter (fun m => ∃ n : ℕ, 0 < n ∧ n.totient = m ∧
        ∃ q : ℕ, q.Prime ∧ q ∣ n ∧ ¬ SNormal (envelopeNormalityScale (logLog x)) q) with hE2
  set E3 := envelopeThreeLargeNormalTotients x with hE3
  set E4 := largeSquareTotients x with hE4
  set E5 := envelopeRetainedTotients x with hE5
  have hc : (totientsUpTo x).card ≤
      A0.card + E1.card + E2.card + E3.card + E4.card + E5.card := by
    have c0 := Finset.card_le_card hcov
    have u1 := Finset.card_union_le (A0 ∪ E1 ∪ E2 ∪ E3 ∪ E4) E5
    have u2 := Finset.card_union_le (A0 ∪ E1 ∪ E2 ∪ E3) E4
    have u3 := Finset.card_union_le (A0 ∪ E1 ∪ E2) E3
    have u4 := Finset.card_union_le (A0 ∪ E1) E2
    have u5 := Finset.card_union_le A0 E1
    omega
  have hcR : ((totientsUpTo x).card : ℝ) ≤
      (A0.card : ℝ) + E1.card + E2.card + E3.card + E4.card + E5.card := by
    exact_mod_cast hc
  
  have hsq0 : 0 ≤ Real.sqrt x := Real.sqrt_nonneg x
  have hA0le : (A0.card : ℝ) ≤ Real.sqrt x := by
    have hsub : A0 ⊆ Finset.Icc 1 ⌊Real.sqrt x⌋₊ := Finset.filter_subset _ _
    have hc1 := Finset.card_le_card hsub
    rw [Nat.card_Icc] at hc1
    have hc2 : A0.card ≤ ⌊Real.sqrt x⌋₊ := by omega
    calc (A0.card : ℝ) ≤ (⌊Real.sqrt x⌋₊ : ℝ) := by exact_mod_cast hc2
      _ ≤ Real.sqrt x := Nat.floor_le hsq0
  have hsqpos : 0 < Real.sqrt x := Real.sqrt_pos.mpr hx0
  have hlogsq : Real.log x ≤ 2 * Real.sqrt x := by
    have h1 : Real.log (Real.sqrt x) = Real.log x / 2 := Real.log_sqrt hx0.le
    have h2 := Real.log_le_sub_one_of_pos hsqpos
    linarith
  have hsqx : Real.sqrt x * Real.sqrt x = x := Real.mul_self_sqrt hx0.le
  have hA0q : Real.sqrt x ≤ 2 * (x / Real.log x) := by
    rw [mul_div_assoc', le_div_iff₀ hlog0]
    nlinarith
  
  set q := x / Real.log x with hq
  have hq0 : 0 ≤ q := div_nonneg hx0.le hlog0.le
  have hT2 : 1 ≤ logLog x ^ 2 := one_le_pow₀ hT
  have hTA : 1 ≤ logLog x ^ 2 * A' := by nlinarith
  have e2 : (1 / 4 : ℝ) * A * x / Real.log x = (1 / 4 : ℝ) * A * q := by rw [hq]; ring
  have e5 : K₅ * x / Real.log x * logLog x ^ 2 * A' = K₅ * q * (logLog x ^ 2 * A') := by
    rw [hq]; ring
  have e6 : (K₅ + 5) * x / Real.log x * logLog x ^ 2 * A' = (K₅ + 5) * q * (logLog x ^ 2 * A') := by
    rw [hq]; ring
  have hE2b := h2 A hA henvx
  have hE5b := h5 A' hA' henvY
  rw [e2] at hE2b ⊢
  rw [e5] at hE5b
  rw [e6]
  have hqq : q ≤ q * (logLog x ^ 2 * A') := by nlinarith
  nlinarith

theorem nonnormal_totients_count (hPNT : Tendsto (fun x : ℝ => (Nat.primeCounting ⌊x⌋₊ : ℝ) / (x / Real.log x)) atTop (𝓝 1))
    (hMERT : ∃ C : ℝ, ∀ x : ℝ, 2 ≤ x →
      |(∑ p ∈ (Finset.Iic ⌊x⌋₊).filter Nat.Prime, (1 : ℝ) / p) - Real.log (Real.log x)| ≤ C)
    (hEULER : Asymptotics.IsEquivalent atTop
      (fun x : ℝ => ∏ p ∈ (Finset.Iic ⌊x⌋₊).filter Nat.Prime, (1 - (1 : ℝ) / p))
      (fun x => Real.exp (-Real.eulerMascheroniConstant) / Real.log x)) :
    ∀ᶠ Y : ℝ in atTop, (((totientsUpTo Y).filter (fun m => ∃ n : ℕ, 0 < n ∧ n.totient = m ∧
      ∃ q : ℕ, q.Prime ∧ q ∣ n ∧ ¬ SNormal (normalityScale (logLog Y)) q)).card : ℝ) ≤
        Y / (Real.log Y * (logLog Y) ^ 2) :=
by
  obtain ⟨C₀, hC₀, hdens⟩ := nonnormal_prime_density_estimate hPNT hMERT hEULER
  obtain ⟨K, hK, hfin⟩ := nonnormal_totients_finite_bound
  obtain ⟨B, hB, henv⟩ := totient_envelope_growth hPNT hMERT hEULER
  have hLL : Tendsto logLog atTop atTop :=
    Real.tendsto_log_atTop.comp Real.tendsto_log_atTop
  
  have hs4 : ∀ᶠ T : ℝ in atTop, K * C₀ * (1 + T) ^ 6 * T ^ 2 *
      Real.exp (B * Real.log T ^ 2 - Real.log T ^ 10 / 6) ≤ 1 := by
    set M : ℝ := K * C₀ with hMdef
    have hM : 0 < M := mul_pos hK hC₀
    filter_upwards [eventually_ge_atTop
      (Real.exp (max 1 (max (12 * (8 + B)) (12 * Real.log (64 * (M + 1))))))] with T hT
    set L := Real.log T with hLdef
    have hT0 : 0 < T := lt_of_lt_of_le (Real.exp_pos _) hT
    have hLge : max 1 (max (12 * (8 + B)) (12 * Real.log (64 * (M + 1)))) ≤ L := by
      have := Real.log_le_log (Real.exp_pos _) hT
      rwa [Real.log_exp] at this
    have hL1 : 1 ≤ L := le_trans (le_max_left _ _) hLge
    have hLB : 12 * (8 + B) ≤ L := le_trans (le_trans (le_max_left _ _) (le_max_right _ _)) hLge
    have hLM : 12 * Real.log (64 * (M + 1)) ≤ L :=
      le_trans (le_trans (le_max_right _ _) (le_max_right _ _)) hLge
    have hTL : Real.exp L = T := Real.exp_log hT0
    have hT1 : 1 ≤ T := by rw [← hTL]; exact Real.one_le_exp (by linarith)
    have h8 : T ^ 8 = Real.exp (8 * L) := by
      rw [← hTL, ← Real.exp_nat_mul]; norm_num
    have hpow : (1 + T) ^ 6 ≤ 64 * T ^ 6 := by
      have h2 : (1 + T) ^ 6 ≤ (2 * T) ^ 6 :=
        pow_le_pow_left₀ (by linarith) (by linarith) 6
      calc (1 + T) ^ 6 ≤ (2 * T) ^ 6 := h2
        _ = 64 * T ^ 6 := by ring
    have hL8 : L ≤ L ^ 8 := le_self_pow₀ hL1 (by norm_num)
    have hL10 : L ≤ L ^ 10 := le_self_pow₀ hL1 (by norm_num)
    have hLsq : L ≤ L ^ 2 := le_self_pow₀ hL1 (by norm_num)
    have hL10eq : L ^ 10 = L ^ 8 * L ^ 2 := by ring
    have hL2nn : 0 ≤ L ^ 2 := by positivity
    have hkey1 : 12 * (8 + B) * L ^ 2 ≤ L ^ 10 := by
      rw [hL10eq]
      exact mul_le_mul_of_nonneg_right (le_trans hLB hL8) hL2nn
    have hexpo : 8 * L + (B * L ^ 2 - L ^ 10 / 6) ≤ -Real.log (64 * (M + 1)) := by
      nlinarith
    have hE : Real.exp (8 * L + (B * L ^ 2 - L ^ 10 / 6)) ≤ (64 * (M + 1))⁻¹ := by
      have := Real.exp_le_exp.mpr hexpo
      rwa [Real.exp_neg, Real.exp_log (by positivity)] at this
    have hexpnn : 0 ≤ Real.exp (B * L ^ 2 - L ^ 10 / 6) := (Real.exp_pos _).le
    calc M * (1 + T) ^ 6 * T ^ 2 * Real.exp (B * L ^ 2 - L ^ 10 / 6)
        ≤ M * (64 * T ^ 6) * T ^ 2 * Real.exp (B * L ^ 2 - L ^ 10 / 6) := by gcongr
      _ = 64 * M * (T ^ 8 * Real.exp (B * L ^ 2 - L ^ 10 / 6)) := by ring
      _ = 64 * M * Real.exp (8 * L + (B * L ^ 2 - L ^ 10 / 6)) := by
        rw [h8, ← Real.exp_add]
      _ ≤ 64 * M * (64 * (M + 1))⁻¹ := by gcongr
      _ = M / (M + 1) := by field_simp
      _ ≤ 1 := by rw [div_le_one (by linarith)]; linarith
  filter_upwards [henv, hLL.eventually hs4, eventually_ge_atTop (16 : ℝ),
    hLL.eventually_ge_atTop 1] with Y henvY hsav hY16 hT1
  have hY0 : 0 < Y := by linarith
  have hlogY : 0 < Real.log Y := Real.log_pos (by linarith)
  have hT0 : 0 < logLog Y := by linarith
  have hA : 1 ≤ Real.exp (B * Real.log (logLog Y) ^ 2) :=
    Real.one_le_exp (by positivity)
  have hSe : Real.exp 1 ≤ normalityScale (logLog Y) := by
    unfold normalityScale
    exact Real.exp_le_exp.mpr (Real.one_le_exp (by positivity))
  have hLLS : Real.log (Real.log (normalityScale (logLog Y))) = Real.log (logLog Y) ^ 10 := by
    unfold normalityScale
    rw [Real.log_exp, Real.log_exp]
  have hLLY : Real.log (Real.log Y) = logLog Y := rfl
  have h := hfin (normalityScale (logLog Y)) Y (Real.exp (B * Real.log (logLog Y) ^ 2)) C₀
    hSe hY16 hA hC₀.le henvY (fun z hz3 _ => hdens (normalityScale (logLog Y)) z hSe hz3)
  refine h.trans ?_
  rw [hLLS, hLLY]
  have hexp : Real.exp (B * Real.log (logLog Y) ^ 2 - Real.log (logLog Y) ^ 10 / 6) =
      Real.exp (B * Real.log (logLog Y) ^ 2) * Real.exp (-Real.log (logLog Y) ^ 10 / 6) := by
    rw [← Real.exp_add]; ring_nf
  have hg : 0 ≤ Y / (Real.log Y * (logLog Y) ^ 2) := by positivity
  calc K * C₀ * Real.exp (B * Real.log (logLog Y) ^ 2) * Y / Real.log Y * (1 + logLog Y) ^ 6 *
        Real.exp (-Real.log (logLog Y) ^ 10 / 6)
      = Y / (Real.log Y * (logLog Y) ^ 2) * (K * C₀ * (1 + logLog Y) ^ 6 * (logLog Y) ^ 2 *
          Real.exp (B * Real.log (logLog Y) ^ 2 - Real.log (logLog Y) ^ 10 / 6)) := by
        rw [hexp]; field_simp
    _ ≤ Y / (Real.log Y * (logLog Y) ^ 2) * 1 := mul_le_mul_of_nonneg_left hsav hg
    _ = Y / (Real.log Y * (logLog Y) ^ 2) := mul_one _

theorem rph_exists_normalPreimageList {n : ℕ} {S : ℝ} (hn : 0 < n) (hS : 1 ≤ S)
    (hnormal : ∀ p ∈ n.primeFactors, SNormal S p)
    (hsquareN : NoLargePrimeSquare n S)
    (hsquarePhi : NoLargePrimeSquare n.totient S) :
    ∃ (K s : ℕ) (q : Fin K → ℕ),
      K = (n.primeFactors.filter fun r => S < (largestPrimeFactor (r - 1) : ℝ)).card ∧
      s = (∏ r ∈ n.primeFactors with (largestPrimeFactor (r - 1) : ℝ) ≤ S,
        r ^ (n.factorization r - 1) * (r - 1)) ∧
      (∀ idx, SNormal S (q idx)) ∧ Function.Injective q ∧
      StrictAnti (fun idx => largestPrimeFactor (q idx - 1)) ∧
      (∀ idx, S < (largestPrimeFactor (q idx - 1) : ℝ)) ∧
      (∀ idx, n.factorization (q idx) = 1) ∧
      n.totient = s * (∏ idx, (q idx - 1)) ∧ 0 < s ∧ (largestPrimeFactor s : ℝ) ≤ S :=
by
  classical
  
  have hlpf_le : ∀ {m : ℕ}, 0 < m → largestPrimeFactor m ≤ m := by
    intro m hm
    exact max_le hm (Finset.sup_le fun z hz => Nat.le_of_mem_primeFactors hz)
  have hlpf_one : largestPrimeFactor 1 = 1 := by simp [largestPrimeFactor]
  have hlpf_mem : ∀ {m : ℕ}, 1 < largestPrimeFactor m →
      largestPrimeFactor m ∈ m.primeFactors := by
    intro m h
    have hs : m.primeFactors.Nonempty := by
      apply Finset.nonempty_iff_ne_empty.mpr
      intro hs
      simp [largestPrimeFactor, hs] at h
    obtain ⟨p, hp, hsup⟩ := Finset.exists_mem_eq_sup m.primeFactors hs id
    have hprime := Nat.prime_of_mem_primeFactors hp
    simpa only [largestPrimeFactor, hsup, id_eq, max_eq_right hprime.one_le] using hp
  have hlpf_dvd : ∀ m : ℕ, largestPrimeFactor m ∣ m := by
    intro m
    by_cases h : largestPrimeFactor m = 1
    · rw [h]; exact one_dvd m
    · have hlarge : 1 < largestPrimeFactor m := by
        have : 1 ≤ largestPrimeFactor m := le_max_left _ _
        omega
      exact Nat.dvd_of_mem_primeFactors (hlpf_mem hlarge)
  have hlpf_mul : ∀ {a b : ℕ}, 0 < a → 0 < b →
      largestPrimeFactor (a * b) = max (largestPrimeFactor a) (largestPrimeFactor b) := by
    intro a b ha hb
    simp [largestPrimeFactor, Nat.primeFactors_mul (Nat.ne_of_gt ha) (Nat.ne_of_gt hb),
      Finset.sup_union, max_assoc, max_left_comm, max_comm]
  have hlpf_prime : ∀ {p : ℕ}, p.Prime → largestPrimeFactor p = p := by
    intro p hp
    simp [largestPrimeFactor, hp.primeFactors, hp.one_le]
  have hlpf_pow : ∀ {m : ℕ}, 0 < m → ∀ k : ℕ,
      largestPrimeFactor (m ^ k) ≤ largestPrimeFactor m := by
    intro m hm k
    induction k with
    | zero => simpa only [pow_zero, hlpf_one] using (le_max_left 1 _ : 1 ≤ largestPrimeFactor m)
    | succ k ih =>
      rw [pow_succ, hlpf_mul (Nat.pow_pos hm) hm]
      exact max_le ih le_rfl
  have hlpf_prod : ∀ (s : Finset ℕ) (f : ℕ → ℕ), (∀ i ∈ s, 0 < f i) →
      (∀ i ∈ s, (largestPrimeFactor (f i) : ℝ) ≤ S) →
      (largestPrimeFactor (∏ i ∈ s, f i) : ℝ) ≤ S := by
    intro s f
    induction s using Finset.induction with
    | empty => intro _ _; simpa [hlpf_one] using hS
    | @insert i s hi ih =>
      intro hf hbound
      have hs : ∀ j ∈ s, 0 < f j := fun j hj => hf j (Finset.mem_insert_of_mem hj)
      rw [Finset.prod_insert hi,
        hlpf_mul (hf i (Finset.mem_insert_self _ _)) (Finset.prod_pos hs), Nat.cast_max]
      exact max_le (hbound i (Finset.mem_insert_self _ _))
        (ih hs (fun j hj => hbound j (Finset.mem_insert_of_mem hj)))
  
  have hfac_one : ∀ {p : ℕ}, p.Prime → p ∣ n → S < (p : ℝ) → n.factorization p = 1 := by
    intro p hp hpn hSp
    have hlower := (hp.dvd_iff_one_le_factorization hn.ne').mp hpn
    have hupper : ¬2 ≤ n.factorization p := by
      intro h
      exact hsquareN p hp hSp ((hp.pow_dvd_iff_le_factorization hn.ne').mpr h)
    omega
  obtain ⟨T, hT⟩ : ∃ T : Finset ℕ,
      T = n.primeFactors.filter fun r => S < (largestPrimeFactor (r - 1) : ℝ) := ⟨_, rfl⟩
  have hTmem : ∀ {p : ℕ}, p ∈ T ↔ p ∈ n.primeFactors ∧ S < (largestPrimeFactor (p - 1) : ℝ) := by
    intro p
    rw [hT, Finset.mem_filter]
  have hT_gt : ∀ {p : ℕ}, p ∈ T → S < (p : ℝ) := by
    intro p hp
    obtain ⟨hpn, hSp⟩ := hTmem.mp hp
    have hprime := Nat.prime_of_mem_primeFactors hpn
    have hpos : 0 < p - 1 := by have := hprime.one_lt; omega
    have hle : (largestPrimeFactor (p - 1) : ℝ) ≤ p := by
      exact_mod_cast (hlpf_le hpos).trans (Nat.sub_le p 1)
    exact hSp.trans_le hle
  have hT_fac : ∀ {p : ℕ}, p ∈ T → n.factorization p = 1 := by
    intro p hp
    have hpn := (hTmem.mp hp).1
    exact hfac_one (Nat.prime_of_mem_primeFactors hpn) (Nat.dvd_of_mem_primeFactors hpn)
      (hT_gt hp)
  
  have hinj : Set.InjOn (fun p => largestPrimeFactor (p - 1)) ↑T := by
    intro p hp q hq hPQ
    change largestPrimeFactor (p - 1) = largestPrimeFactor (q - 1) at hPQ
    by_contra hpq
    obtain ⟨hpn, hSP⟩ := hTmem.mp (Finset.mem_coe.mp hp)
    obtain ⟨hqn, _⟩ := hTmem.mp (Finset.mem_coe.mp hq)
    have hprimeP := Nat.prime_of_mem_primeFactors hpn
    have hprimeQ := Nat.prime_of_mem_primeFactors hqn
    have hcop : p.Coprime q := by
      apply hprimeP.coprime_iff_not_dvd.mpr
      intro hdvd
      exact hpq ((Nat.prime_dvd_prime_iff_eq hprimeP hprimeQ).mp hdvd)
    have hpqN : p * q ∣ n :=
      hcop.mul_dvd_of_dvd_of_dvd (Nat.dvd_of_mem_primeFactors hpn)
        (Nat.dvd_of_mem_primeFactors hqn)
    have hphi := Nat.totient_dvd_of_dvd hpqN
    rw [Nat.totient_mul hcop, Nat.totient_prime hprimeP, Nat.totient_prime hprimeQ] at hphi
    have hlarge : 1 < largestPrimeFactor (p - 1) := by
      exact_mod_cast hS.trans_lt hSP
    have hQp := hlpf_dvd (p - 1)
    have hQq : largestPrimeFactor (p - 1) ∣ q - 1 := by
      rw [hPQ]
      exact hlpf_dvd (q - 1)
    apply hsquarePhi (largestPrimeFactor (p - 1))
      (Nat.prime_of_mem_primeFactors (hlpf_mem hlarge)) hSP
    simpa only [pow_two] using (mul_dvd_mul hQp hQq).trans hphi
  
  have hsplit : n.totient = (∏ p ∈ T, (p - 1)) *
      ∏ r ∈ n.primeFactors with (largestPrimeFactor (r - 1) : ℝ) ≤ S,
        r ^ (n.factorization r - 1) * (r - 1) := by
    have hphi := Nat.totient_eq_prod_factorization hn.ne'
    change n.totient = ∏ p ∈ n.primeFactors, p ^ (n.factorization p - 1) * (p - 1) at hphi
    rw [← Finset.prod_filter_mul_prod_filter_not n.primeFactors
      (fun p => S < (largestPrimeFactor (p - 1) : ℝ)), ← hT] at hphi
    have hlarge : (∏ p ∈ T, p ^ (n.factorization p - 1) * (p - 1)) =
        ∏ p ∈ T, (p - 1) := by
      apply Finset.prod_congr rfl
      intro p hp
      rw [hT_fac hp]
      simp
    rw [hlarge] at hphi
    simpa only [not_lt] using hphi
  
  have hpos : 0 < ∏ r ∈ n.primeFactors with (largestPrimeFactor (r - 1) : ℝ) ≤ S,
      r ^ (n.factorization r - 1) * (r - 1) := by
    apply Finset.prod_pos
    intro p hp
    have hprime := Nat.prime_of_mem_primeFactors (Finset.mem_filter.mp hp).1
    exact Nat.mul_pos (Nat.pow_pos hprime.pos) (by have := hprime.one_lt; omega)
  have hsmooth : (largestPrimeFactor (∏ r ∈ n.primeFactors with
      (largestPrimeFactor (r - 1) : ℝ) ≤ S, r ^ (n.factorization r - 1) * (r - 1)) : ℝ) ≤ S := by
    apply hlpf_prod _ (fun r => r ^ (n.factorization r - 1) * (r - 1))
    · intro p hp
      have hprime := Nat.prime_of_mem_primeFactors (Finset.mem_filter.mp hp).1
      exact Nat.mul_pos (Nat.pow_pos hprime.pos) (by have := hprime.one_lt; omega)
    · intro p hp
      obtain ⟨hpn, hsmall⟩ := Finset.mem_filter.mp hp
      have hprime := Nat.prime_of_mem_primeFactors hpn
      by_cases hpS : (p : ℝ) ≤ S
      · have hpos : 0 < p - 1 := by have := hprime.one_lt; omega
        show (largestPrimeFactor (p ^ (n.factorization p - 1) * (p - 1)) : ℝ) ≤ S
        rw [hlpf_mul (Nat.pow_pos hprime.pos) hpos, Nat.cast_max]
        apply max_le _ hsmall
        have hpow : largestPrimeFactor (p ^ (n.factorization p - 1)) ≤ p := by
          simpa only [hlpf_prime hprime] using hlpf_pow hprime.pos (n.factorization p - 1)
        have hpowReal : (largestPrimeFactor (p ^ (n.factorization p - 1)) : ℝ) ≤ p := by
          exact_mod_cast hpow
        exact hpowReal.trans hpS
      · have hfac := hfac_one hprime (Nat.dvd_of_mem_primeFactors hpn) (lt_of_not_ge hpS)
        show (largestPrimeFactor (p ^ (n.factorization p - 1) * (p - 1)) : ℝ) ≤ S
        simpa only [hfac, Nat.sub_self, pow_zero, one_mul] using hsmall
  
  have henum : ∀ (s : Finset ℕ) (f : ℕ → ℕ), Set.InjOn f ↑s →
      ∃ e : Fin s.card ≃ s, StrictAnti (fun idx => f (e idx)) := by
    intro s f hf
    let fS : s → (s.image f) := fun a =>
      ⟨f a, Finset.mem_image.mpr ⟨a, a.property, rfl⟩⟩
    have hfS : Function.Bijective fS := by
      constructor
      · intro a b hab
        apply Subtype.ext
        exact hf a.property b.property (congrArg Subtype.val hab)
      · rintro ⟨b, hb⟩
        obtain ⟨a, ha, hab⟩ := Finset.mem_image.mp hb
        exact ⟨⟨a, ha⟩, Subtype.ext hab⟩
    let e := Equiv.ofBijective fS hfS
    let o := (s.image f).orderIsoOfFin (Finset.card_image_of_injOn hf)
    let enumeration : Fin s.card ≃ s := (Fin.revPerm.trans o.toEquiv).trans e.symm
    have hvalue (idx : Fin s.card) : f (enumeration idx) = (o idx.rev).val := by
      change (e (e.symm (o idx.rev))).val = (o idx.rev).val
      exact congrArg Subtype.val (e.apply_symm_apply (o idx.rev))
    refine ⟨enumeration, ?_⟩
    intro idx j hij
    change f (enumeration j) < f (enumeration idx)
    rw [hvalue, hvalue]
    exact o.strictMono (Fin.rev_lt_rev.mpr hij)
  
  obtain ⟨e, he⟩ := henum T (fun p => largestPrimeFactor (p - 1)) hinj
  let q : Fin T.card → ℕ := fun idx => (e idx).val
  have hmem : ∀ idx, q idx ∈ T := fun idx => (e idx).property
  have hprodq : (∏ idx, (q idx - 1)) = ∏ p ∈ T, (p - 1) := by
    calc (∏ idx, (q idx - 1)) = ∏ p : T, ((p : ℕ) - 1) :=
          Fintype.prod_equiv e _ _ (fun _ => rfl)
      _ = _ := by
          rw [Finset.univ_eq_attach]
          exact Finset.prod_attach T (fun p => p - 1)
  rw [← hT]
  refine ⟨T.card, _, q, rfl, rfl, ?_, ?_, he, ?_, ?_, ?_, hpos, hsmooth⟩
  · intro idx
    exact hnormal (q idx) (hTmem.mp (hmem idx)).1
  · intro idx j hij
    exact e.injective (Subtype.ext hij)
  · intro idx
    exact (hTmem.mp (hmem idx)).2
  · intro idx
    exact hT_fac (hmem idx)
  · rw [hsplit, hprodq]
    exact mul_comm _ _

theorem rph_prime_data_eventually (c P κ θ : ℝ) (hκ : 1 < κ) (hθ : θ < 1) :
    ∀ᶠ T : ℝ in atTop, ∀ L : ℕ, ∀ p : Fin (L + 1) → ℕ,
      (∀ idx, SNormal (normalityScale T) (p idx)) →
      (∀ idx, 17 ≤ p idx) →
      (∀ idx, (p idx : ℝ) ≤ c * Real.exp (Real.exp T) * T) →
      Antitone p →
      (∀ idx : Fin (L + 1), 0 < idx.val → ∀ hi : idx.val + 1 < L + 1,
        κ * logLog (p ⟨idx.val + 1, hi⟩) ≤ logLog (p idx)) →
      (∀ idx, 0 < idx.val → (p idx : ℝ) ≤ CollisionBox.cutoff (Real.exp (Real.exp T)) θ) →
      (p (Fin.last L) : ℝ) ≤ P →
      (Real.exp (Real.exp T)) ^ (9 / 10 : ℝ) < (p 0 : ℝ) →
      ((p 0 - 1 : ℕ) : ℝ) ≤ Real.exp (Real.exp T) →
      0 < T ^ (-1 / 3 : ℝ) ∧ 0 < 1 / T ∧ 0 < T ^ (-2 / 5 : ℝ) ∧ 0 ≤ 1 - 1 / κ ∧
      Antitone (fun idx => CollisionBox.primeCoordinate T (p idx)) ∧
      (∀ idx, CollisionBox.shiftedCoordinate T (p idx) ≤ CollisionBox.primeCoordinate T (p idx)) ∧
      (∀ idx, T ^ (-1 / 3 : ℝ) ≤ CollisionBox.primeCoordinate T (p idx) →
        CollisionBox.primeCoordinate T (p idx) - Real.log (5 * T) / T ≤
          CollisionBox.shiftedCoordinate T (p idx)) ∧
      (∀ idx j : Fin (L + 1), 0 < idx.val → idx < j →
        (1 - 1 / κ) * CollisionBox.primeCoordinate T (p idx) ≤
          CollisionBox.primeCoordinate T (p idx) - CollisionBox.primeCoordinate T (p j)) ∧
      (∀ idx : Fin (L + 1), 0 < idx.val → CollisionBox.primeCoordinate T (p idx) ≤ θ) ∧
      T ^ (-1 / 3 : ℝ) < CollisionBox.shiftedCoordinate T (p 0) ∧
      CollisionBox.shiftedCoordinate T (p 0) ≤ 1 ∧
      1 - Real.log (6 * T) / T ≤ CollisionBox.shiftedCoordinate T (p 0) ∧
      CollisionBox.shiftedCoordinate T (p (Fin.last L)) ≤ T ^ (-1 / 3 : ℝ) ∧
      10 * T ^ (-2 / 5 : ℝ) + 1 / T + Real.log (5 * T) / T ≤ (1 - 1 / κ) * T ^ (-1 / 3 : ℝ) ∧
      10 * T ^ (-2 / 5 : ℝ) + 1 / T + Real.log (6 * T) / T ≤ 1 - θ ∧
      4 * T ^ (-2 / 5 : ℝ) ≤ T ^ (-1 / 3 : ℝ) :=
by
  
  have hLPR : ∀ (k : ℕ) (a b : ℝ), a < b →
      (fun T : ℝ => Real.log T ^ k * T ^ a) =o[atTop] (fun T => T ^ b) := by
    intro k a b hab
    have h := (isLittleO_log_rpow_rpow_atTop (k : ℝ) (sub_pos.mpr hab)).mul_isBigO
      (Asymptotics.isBigO_refl (fun T : ℝ => T ^ a) atTop)
    refine h.congr' (Eventually.of_forall fun T => ?_) ?_
    · simp only [Real.rpow_natCast]
    · filter_upwards [eventually_gt_atTop (0 : ℝ)] with T hT
      rw [← Real.rpow_add hT]
      congr 1
      ring
  have hErr : ∀ (c' a : ℝ), 0 < c' → -1 < a →
      (fun T : ℝ => Real.log (c' * T) / T) =o[atTop] (fun T : ℝ => T ^ a) := by
    intro c' a hc ha
    have h := ((hLPR 0 (-1) a ha).const_mul_left (Real.log c')).add (hLPR 1 (-1) a ha)
    refine h.congr' ?_ (Eventually.of_forall fun _ => rfl)
    filter_upwards [eventually_gt_atTop (0 : ℝ)] with T hT
    simp only [pow_zero, one_mul, pow_one, Real.rpow_neg_one, Real.log_mul hc.ne' hT.ne']
    ring
  have hLoss : ∀ (c' a : ℝ), 0 < c' → (-2 / 5 : ℝ) < a →
      (fun T : ℝ => 10 * T ^ (-2 / 5 : ℝ) + 1 / T + Real.log (c' * T) / T) =o[atTop]
        (fun T : ℝ => T ^ a) := by
    intro c' a hc ha
    have h₁ := (hLPR 0 (-2 / 5) a ha).const_mul_left (10 : ℝ)
    have h₂ := hLPR 0 (-1) a (by linarith)
    simpa only [pow_zero, one_mul, Real.rpow_neg_one, one_div] using
      (h₁.add h₂).add (hErr c' a hc (by linarith))
  
  have hκpos : 0 < κ := by linarith
  have hg : 0 < 1 - 1 / κ := by
