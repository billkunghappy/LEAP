    exact h1.trans (le_max_right _ _)
  have hF' : ∀ s ∈ F, ((∀ a : Fin (k + l), 0 < s.1 a) ∧ (∀ b : Fin (k + 1), 0 < s.2 b)) ∧
      d * (∏ a, s.1 a) = (∏ b, s.2 b) ∧
      (∀ a : Fin (k + l), a.val ≠ 0 → ∀ r ∈ (s.1 a).primeFactorsList, (r : ℝ) ≤ v 1) ∧
