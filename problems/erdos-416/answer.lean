theorem modelVolume_eventually_le_T (hPNT : Tendsto (fun x : ℝ => (Nat.primeCounting ⌊x⌋₊ : ℝ) / (x / Real.log x)) atTop (𝓝 1))
    (hMERT : ∃ C : ℝ, ∀ x : ℝ, 2 ≤ x →
      |(∑ p ∈ (Finset.Iic ⌊x⌋₊).filter Nat.Prime, (1 : ℝ) / p) - Real.log (Real.log x)| ≤ C)
    (hEULER : Asymptotics.IsEquivalent atTop
      (fun x : ℝ => ∏ p ∈ (Finset.Iic ⌊x⌋₊).filter Nat.Prime, (1 - (1 : ℝ) / p))
      (fun x => Real.exp (-Real.eulerMascheroniConstant) / Real.log x))
    (hRHO : 0 < FordAnalysis.rho ∧ FordAnalysis.rho < 3 / 4 ∧ FordAnalysis.F FordAnalysis.rho = 1) :
    ∀ᶠ L : ℕ in atTop, FordGeometry.modelVolume L ≤ 22 * FordGeometry.T L :=
by
  
  have hc1eq : FordAnalysis.coeff 1 = 2 * Real.log 2 - 1 := by
    simp only [FordAnalysis.coeff, fordWeight, one_ne_zero, if_false, Nat.cast_one, Real.log_one]
    norm_num
  have hc1 : (38629 / 100000 : ℝ) < FordAnalysis.coeff 1 ∧ FordAnalysis.coeff 1 < 1 / 2 := by
    rw [hc1eq]
    constructor <;> linarith [Real.log_two_gt_d9, Real.log_two_lt_d9]
  have hc1pos : 0 < 1 - FordAnalysis.coeff 1 := by linarith [hc1.2]
  
  obtain ⟨hρ, ⟨hlamlo, hlamhi⟩, hsmall⟩ := ford_renewal_numerics hRHO
  have herr := ford_renewal_error hRHO hρ hlamhi
  have hρ0 : 0 < FordAnalysis.rho := hRHO.1
  have hρ1 : FordAnalysis.rho < 1 := by linarith [hρ.2]
  have hq : (2713 / 5000 : ℝ) ^ 20 < 1 / 100000 := by norm_num
  have hpow20 : ∀ n : ℕ, 20 ≤ n → FordAnalysis.rho ^ n ≤ (2713 / 5000 : ℝ) ^ 20 := by
    intro n hn
    calc FordAnalysis.rho ^ n ≤ FordAnalysis.rho ^ 20 := pow_le_pow_of_le_one hρ0.le hρ1.le hn
      _ ≤ (2713 / 5000 : ℝ) ^ 20 := pow_le_pow_left₀ hρ0.le hρ.2.le 20
  have hPA : ∀ n : ℕ, 1 ≤ n → FordAnalysis.g n * FordAnalysis.rho ^ n < 17 / 50 := by
    intro n hn
    by_cases h20 : n < 20
    · exact (hsmall n hn h20).1
    · have h := abs_le.mp (herr n)
      have hp := hpow20 n (by omega)
      linarith [h.2]
  have hPB : ∀ n : ℕ, 2 ≤ n → (31 / 100 : ℝ) < FordAnalysis.g n * FordAnalysis.rho ^ n := by
    intro n hn
    by_cases h20 : n < 20
    · exact ((hsmall n (by omega) h20).2 hn).1
    · have h := abs_le.mp (herr n)
      have hp := hpow20 n (by omega)
      linarith [h.1]
  have hPC : ∀ n : ℕ, 2 ≤ n → (147 / 1000 : ℝ) <
      (FordAnalysis.g n - FordAnalysis.g (n - 1)) * FordAnalysis.rho ^ n := by
    intro n hn
    by_cases h20 : n < 20
    · exact ((hsmall n (by omega) h20).2 hn).2
    · obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
      have h1 := abs_le.mp (herr (m + 1))
      have h2 := abs_le.mp (herr m)
      have hp1 := hpow20 (m + 1) (by omega)
      rw [show m + 1 - 1 = m by omega]
      have hpm : FordAnalysis.rho ^ (m + 1) = FordAnalysis.rho ^ m * FordAnalysis.rho := pow_succ _ _
      have hm1 : FordAnalysis.rho * (FordAnalysis.g m * FordAnalysis.rho ^ m) ≤
          FordAnalysis.rho * (1 / (FordAnalysis.rho * deriv FordAnalysis.F FordAnalysis.rho) +
            5 * FordAnalysis.rho ^ m) := mul_le_mul_of_nonneg_left (by linarith [h2.2]) hρ0.le
      have hm2 : 0 < (1 / (FordAnalysis.rho * deriv FordAnalysis.F FordAnalysis.rho) - 161 / 500) *
