  have key : (216 * r ^ 3 * (N : ℝ) / (Real.log x / 2) ^ 3 +
      Real.sqrt x * (1 + Real.log x / 2) ^ 9) * Real.log x ^ 3 =
      1728 * r ^ 3 * N + Real.sqrt x * (1 + Real.log x / 2) ^ 9 * Real.log x ^ 3 := by
    field_simp; ring
  have hS3 : (S.card : ℝ) * Real.log x ^ 3 ≤
