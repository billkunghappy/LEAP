    have h1 : 1 ≤ a * Real.log T := one_le_mul_of_one_le_of_one_le ha1 hℓ1
    have h2 : 6 * (L : ℝ) + 6 ≤ 12 * a * Real.log T := by linarith
    calc (6 * (L : ℝ) + 6) * normalityDelta T ≤ (12 * a * Real.log T) * normalityDelta T :=
          mul_le_mul_of_nonneg_right h2 hδ0
      _ = 24 * a * (Real.log T ^ 6 / Real.sqrt T) := by
          rw [hδ]; field_simp; ring
  have hb : T ^ (-1 / 3 : ℝ) ≤ 1 / 4 := by
    have hu0 : 0 < T ^ (1 / 3 : ℝ) := Real.rpow_pos_of_pos hT0 _
    have hu3 : (T ^ (1 / 3 : ℝ)) ^ 3 = T := by
