    rw [hll] at hfix
    intro u hu hux
    have e : 4 / 3 * K * τ ^ 2 * A' = 4 / 3 * (K * τ ^ 2 * A') := by ring
    rw [e]
    exact hfix u hu hux
  have hs4 := s4 C₀ (4 / 3 * K) (logLog X₀) hC₀ ht₀ (by rw [hexpt₀]; exact hbase₀) hH
  have hD1 : 1 ≤ max 1 (4 / 3 * K) * logLog X₀ ^ 2 := by
    have h1 : 1 ≤ logLog X₀ ^ 2 := one_le_pow₀ ht₀
    have h2 : 1 ≤ max 1 (4 / 3 * K) := le_max_left _ _
    nlinarith
  obtain ⟨B, hB, hB'⟩ := s5 C₀ (max 1 (4 / 3 * K) * logLog X₀ ^ 2) hC₀ hD1
  refine ⟨B, hB, ?_⟩
  filter_upwards [eventually_ge_atTop (Real.exp (Real.exp (Real.exp 1)))] with x hx
