theorem ford_polytope_initial_segment {K D : ℕ} (hKD : K ≤ D) {ξ : ℕ → ℝ} (hξ : ∀ j, 1 ≤ ξ j)
    {x : Fin D → ℝ} (hx : x ∈ FordGeometry.polytope D ξ) :
    (fun idx : Fin K => x (Fin.castLE hKD idx)) ∈ FordGeometry.polytope K ξ ∧
      FordGeometry.outerForm K (fun idx : Fin K => x (Fin.castLE hKD idx)) ≤
        FordGeometry.outerForm D x :=
by
  classical
  obtain ⟨hx0, hx1, hxanti, hxouter, hxtail⟩ := hx
  have hw : ∀ k : ℕ, 1 ≤ k → 0 ≤ fordWeight k := by
    intro k hk
    have hn : (1 : ℝ) ≤ (k : ℝ) := by exact_mod_cast hk
    unfold fordWeight
    generalize (k : ℝ) = n at hn ⊢
    have hnpos : 0 < n := by linarith
    have hn1 : 0 < n + 1 := by linarith
    have h1 := Real.one_sub_inv_le_log_of_pos (x := (n + 1) / n) (by positivity)
    have h2 := Real.one_sub_inv_le_log_of_pos (x := n + 1) hn1
    rw [Real.log_div hn1.ne' hnpos.ne', inv_div] at h1
    have e1 : 1 - n / (n + 1) = 1 / (n + 1) := by field_simp <;> ring
    have e2 : 1 - (n + 1)⁻¹ = n / (n + 1) := by field_simp <;> ring
    rw [e1, div_le_iff₀ hn1] at h1
    rw [e2, div_le_iff₀ hn1] at h2
    have h3 := mul_le_mul_of_nonneg_left h1 hnpos.le
    have h4 : 0 ≤ (n + 1) * ((n + 1) * Real.log (n + 1) - n * Real.log n - 1) := by
      nlinarith
    exact (mul_nonneg_iff_of_pos_left hn1).mp h4
  have hsub : ∀ f : Fin D → ℝ, (∀ j, 0 ≤ f j) →
      ∑ i : Fin K, f (Fin.castLE hKD i) ≤ ∑ j : Fin D, f j := by
    intro f hf
    have e : ∑ i : Fin K, f (Fin.castLE hKD i) =
        ∑ j ∈ Finset.univ.map (Fin.castLEEmb hKD), f j := by
      rw [Finset.sum_map]; rfl
    rw [e]
    exact Finset.sum_le_sum_of_subset_of_nonneg (Finset.subset_univ _) (fun j _ _ => hf j)
  have houter : FordGeometry.outerForm K (fun idx : Fin K => x (Fin.castLE hKD idx)) ≤
      FordGeometry.outerForm D x := by
    show ∑ i : Fin K, fordWeight (i.val + 1) * x (Fin.castLE hKD i) ≤
      ∑ j : Fin D, fordWeight (j.val + 1) * x j
    exact hsub (fun j => fordWeight (j.val + 1) * x j)
      (fun j => mul_nonneg (hw _ (by omega)) (hx0 j))
  refine ⟨⟨fun i => hx0 _, fun i => hx1 _, ?_, houter.trans hxouter, ?_⟩, houter⟩
  · intro i j hij
    apply hxanti
    rw [Fin.le_iff_val_le_val] at hij ⊢
    simpa using hij
  · intro idx hidx
    show ∑ j : Fin K, FordGeometry.tailWeight idx j * x (Fin.castLE hKD j) ≤
      ξ (idx.val + 1) * x (Fin.castLE hKD idx)
    by_cases hA : idx.val + 2 < K
    · have hA' : idx.val + 2 < D := by omega
      have hD := hxtail (Fin.castLE hKD idx) (by simp; omega)
      change ∑ j : Fin D, FordGeometry.tailWeight (Fin.castLE hKD idx) j * x j ≤
        ξ ((Fin.castLE hKD idx).val + 1) * x (Fin.castLE hKD idx) at hD
      have hnn : ∀ j : Fin D, 0 ≤ FordGeometry.tailWeight (Fin.castLE hKD idx) j * x j := by
        intro j
        unfold FordGeometry.tailWeight
        split_ifs with h1 h2
        · exact mul_nonneg (hw _ (by omega)) (hx0 j)
        · simp [hx0 j]
        · simp
      have hS := hsub (fun j => FordGeometry.tailWeight (Fin.castLE hKD idx) j * x j) hnn
      have heq : ∑ j : Fin K, FordGeometry.tailWeight idx j * x (Fin.castLE hKD j) =
          ∑ i : Fin K, (fun j => FordGeometry.tailWeight (Fin.castLE hKD idx) j * x j)
            (Fin.castLE hKD i) := by
        apply Finset.sum_congr rfl
        intro j _
        simp [FordGeometry.tailWeight, hA, hA']
      rw [heq]
      exact hS.trans hD
    · obtain ⟨last, hlv⟩ : ∃ l : Fin K, l.val = idx.val + 1 := ⟨⟨idx.val + 1, hidx⟩, rfl⟩
      rw [Finset.sum_eq_single last]
      · have hw1 : FordGeometry.tailWeight idx last = 1 := by
          unfold FordGeometry.tailWeight
          rw [if_pos (by omega), if_neg hA]
        rw [hw1, one_mul]
        have h1 : x (Fin.castLE hKD last) ≤ x (Fin.castLE hKD idx) := by
          apply hxanti
          rw [Fin.le_iff_val_le_val]
          simp only [Fin.coe_castLE]
          omega
        exact h1.trans (le_mul_of_one_le_left (hx0 _) (hξ _))
      · intro j _ hj
        have hz : FordGeometry.tailWeight idx j = 0 := by
          unfold FordGeometry.tailWeight
          rw [if_neg]
          intro hlt
          apply hj
          have := j.isLt
          exact Fin.ext (by omega)
        rw [hz, zero_mul]
      · intro h
        exact absurd (Finset.mem_univ _) h

theorem ordinary_totient_core_factorization {N L : ℕ} (hN : 0 < N)
    (htop : FordBadFacet.ordinaryPrimeAt N 1 < FordBadFacet.ordinaryPrimeAt N 0)
    (hprime : ∀ idx : Fin L, (FordBadFacet.ordinaryPrimeAt N (idx.val + 1)).Prime)
    (horder : ∀ j : ℕ, 1 ≤ j → j ≤ L →
      FordBadFacet.ordinaryPrimeAt N (j + 1) < FordBadFacet.ordinaryPrimeAt N j) :
    (FordBadFacet.ordinaryPrimeAt N 0).Prime ∧
    N.totient = (FordBadFacet.ordinaryPrimeAt N 0 - 1) *
      ((FordBadFacet.ordinarySuffix N (L + 1)).totient *
        ∏ idx : Fin L, (FordBadFacet.ordinaryPrimeAt N (idx.val + 1) - 1)) :=
by
  have claimA : ∀ (k : ℕ) (r : List ℕ), List.Pairwise (fun a b => b ≤ a) r →
      (∀ x ∈ r, x.Prime) → (∀ i < k, r.getD (i + 1) 1 < r.getD i 1) →
      (r.prod).totient = ((r.drop k).prod).totient * ∏ i : Fin k, (r.getD i.val 1 - 1) := by
    intro k
    induction k with
    | zero => intro r _ _ _; simp
    | succ k ih =>
      intro r hs hp hlt
      cases r with
      | nil =>
        have h := hlt 0 (Nat.succ_pos k)
        simp at h
      | cons a t =>
        have h0 := hlt 0 (Nat.succ_pos k)
        have hst := (List.pairwise_cons.mp hs).2
        have ha : a.Prime := hp a (List.mem_cons_self ..)
        have htp : ∀ x ∈ t, x.Prime := fun x hx => hp x (List.mem_cons_of_mem _ hx)
        have hnot : a ∉ t := by
          intro hmem
          cases t with
          | nil => simp at hmem
          | cons b t' =>
            have hba : b < a := by simpa using h0
            have hle := (List.pairwise_cons.mp hst).1
            rcases List.mem_cons.mp hmem with h | h
            · omega
            · have := hle a h
              omega
        have hcop : Nat.Coprime a t.prod := by
          rw [Nat.coprime_list_prod_right_iff]
          intro c hc
          exact (Nat.coprime_primes ha (htp c hc)).mpr (fun h => hnot (h ▸ hc))
        have hih := ih t hst htp (fun i hi => by
          have h' := hlt (i + 1) (by omega)
          simpa using h')
        rw [List.prod_cons, Nat.totient_mul hcop, Nat.totient_prime ha, hih, List.drop_succ_cons,
          Fin.prod_univ_succ]
        simp only [Fin.val_zero, Fin.val_succ, List.getD_cons_zero, List.getD_cons_succ]
        ring
  have hprimeAll : ∀ x ∈ N.primeFactorsList.reverse, x.Prime := by
    intro x hx
    rw [List.mem_reverse] at hx
    exact Nat.prime_of_mem_primeFactorsList hx
  have hsorted : List.Pairwise (fun a b => b ≤ a) N.primeFactorsList.reverse := by
    have h1 : List.Pairwise (· ≤ ·) N.primeFactorsList := (Nat.primeFactorsList_sorted N).pairwise
    exact List.pairwise_reverse.mpr h1
  have hprod : N.primeFactorsList.reverse.prod = N := by
    rw [List.prod_reverse, Nat.prod_primeFactorsList hN.ne']
  have hstrict : ∀ i < L + 1,
      N.primeFactorsList.reverse.getD (i + 1) 1 < N.primeFactorsList.reverse.getD i 1 := by
    intro i hi
    rcases i with _ | j
    · exact htop
    · exact horder (j + 1) (by omega) (by omega)
  have hq0 : (FordBadFacet.ordinaryPrimeAt N 0).Prime := by
    have hne : N.primeFactorsList.reverse ≠ [] := by
      intro h
      have h1 : FordBadFacet.ordinaryPrimeAt N 0 = 1 := by
        simp [FordBadFacet.ordinaryPrimeAt, FordBadFacet.ordinaryPrimeList, h]
      have h2 : FordBadFacet.ordinaryPrimeAt N 1 = 1 := by
        simp [FordBadFacet.ordinaryPrimeAt, FordBadFacet.ordinaryPrimeList, h]
      omega
    obtain ⟨p, rest, hl⟩ := List.exists_cons_of_ne_nil hne
    have hP0 : FordBadFacet.ordinaryPrimeAt N 0 = p := by
      simp [FordBadFacet.ordinaryPrimeAt, FordBadFacet.ordinaryPrimeList, hl]
    rw [hP0]
    exact hprimeAll p (by rw [hl]; exact List.mem_cons_self ..)
  refine ⟨hq0, ?_⟩
  have hA := claimA (L + 1) _ hsorted hprimeAll hstrict
  rw [hprod, Fin.prod_univ_succ] at hA
  show N.totient = (N.primeFactorsList.reverse.getD 0 1 - 1) *
      (((N.primeFactorsList.reverse.drop (L + 1)).prod).totient *
        ∏ idx : Fin L, (N.primeFactorsList.reverse.getD (idx.val + 1) 1 - 1))
  rw [hA]
  simp only [Fin.val_zero, Fin.val_succ]
  ring

theorem ordinary_prime_list_suffix_facts : (∀ N i j : ℕ, i ≤ j → FordBadFacet.ordinaryPrimeAt N j ≤ FordBadFacet.ordinaryPrimeAt N i) ∧
    (∀ N j : ℕ, 0 < FordBadFacet.ordinarySuffix N j) ∧
    (∀ N j : ℕ, largestPrimeFactor (FordBadFacet.ordinarySuffix N j) ≤ FordBadFacet.ordinaryPrimeAt N j) ∧
    (∀ N j k : ℕ, FordBadFacet.ordinarySuffix (FordBadFacet.ordinarySuffix N j) k =
      FordBadFacet.ordinarySuffix N (j + k)) :=
by
  
  have key : ∀ N j : ℕ, (FordBadFacet.ordinarySuffix N j).primeFactorsList =
      ((N.primeFactorsList.reverse).drop j).reverse := by
    intro N j
    have hsub : ((N.primeFactorsList.reverse).drop j).reverse.Sublist N.primeFactorsList := by
      have := (List.drop_sublist j N.primeFactorsList.reverse).reverse
      rwa [List.reverse_reverse] at this
    have hprimes : ∀ p ∈ ((N.primeFactorsList.reverse).drop j).reverse, p.Prime :=
      fun p hp => Nat.prime_of_mem_primeFactorsList (hsub.subset hp)
    have hprod : ((N.primeFactorsList.reverse).drop j).reverse.prod =
        FordBadFacet.ordinarySuffix N j := by
      rw [List.prod_reverse]
    have hperm := Nat.primeFactorsList_unique hprod hprimes
    have hs1 := ((Nat.primeFactorsList_sorted N).pairwise.sublist hsub).sortedLE
    exact (hperm.eq_of_sortedLE hs1 (Nat.primeFactorsList_sorted _)).symm
  
  have s1 : ∀ N j i : ℕ, FordBadFacet.ordinaryPrimeAt (FordBadFacet.ordinarySuffix N j) i =
      FordBadFacet.ordinaryPrimeAt N (j + i) := by
    intro N j i
    show (FordBadFacet.ordinarySuffix N j).primeFactorsList.reverse.getD i 1 =
      N.primeFactorsList.reverse.getD (j + i) 1
    rw [key, List.reverse_reverse, List.getD_eq_getElem?_getD, List.getD_eq_getElem?_getD,
      List.getElem?_drop]
  
  have s2 : ∀ M r : ℕ, r ∈ M.primeFactors → r ≤ FordBadFacet.ordinaryPrimeAt M 0 := by
    intro M r hr
    have hmem : r ∈ M.primeFactorsList.reverse :=
      List.mem_reverse.mpr (Nat.mem_primeFactors_iff_mem_primeFactorsList.mp hr)
    have hsorted : M.primeFactorsList.reverse.Pairwise (fun a b => b ≤ a) :=
      List.pairwise_reverse.mpr (Nat.primeFactorsList_sorted M).pairwise
    unfold FordBadFacet.ordinaryPrimeAt FordBadFacet.ordinaryPrimeList
    generalize M.primeFactorsList.reverse = l at hmem hsorted ⊢
    cases l with
    | nil => simp at hmem
    | cons a t =>
      simp only [List.getD_cons_zero]
      rcases List.mem_cons.mp hmem with h | h
      · omega
      · exact (List.pairwise_cons.mp hsorted).1 r h
  
  have s0c : ∀ N i : ℕ, 1 ≤ FordBadFacet.ordinaryPrimeAt N i := by
    intro N i
    show 1 ≤ N.primeFactorsList.reverse.getD i 1
    rcases lt_or_ge i N.primeFactorsList.reverse.length with h | h
    · rw [List.getD_eq_getElem _ _ h]
      exact (Nat.prime_of_mem_primeFactorsList
        (List.mem_reverse.mp (List.getElem_mem h))).one_lt.le
    · rw [List.getD_eq_default _ _ h]
  
  have s4 : ∀ M i : ℕ, FordBadFacet.ordinaryPrimeAt M i ≤ FordBadFacet.ordinaryPrimeAt M 0 := by
    intro M i
    rcases lt_or_ge i M.primeFactorsList.reverse.length with h | h
    · have he : FordBadFacet.ordinaryPrimeAt M i = M.primeFactorsList.reverse[i] :=
        List.getD_eq_getElem _ _ h
      rw [he]
      apply s2
      exact Nat.mem_primeFactors_iff_mem_primeFactorsList.mpr
        (List.mem_reverse.mp (List.getElem_mem h))
    · have he : FordBadFacet.ordinaryPrimeAt M i = 1 := List.getD_eq_default _ _ h
      rw [he]
      exact s0c M 0
  refine ⟨?_, ?_, ?_, ?_⟩
  · intro N i j hij
    obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le hij
    have h1 := s1 N i d
    have h2 := s1 N i 0
    rw [Nat.add_zero] at h2
    rw [← h1, ← h2]
    exact s4 _ _
  · intro N j
    show 0 < ((N.primeFactorsList.reverse).drop j).prod
    apply List.prod_pos
    intro a ha
    exact (Nat.prime_of_mem_primeFactorsList
      (List.mem_reverse.mp (List.mem_of_mem_drop ha))).pos
  · intro N j
    unfold largestPrimeFactor
    apply max_le (s0c N j)
    apply Finset.sup_le
    intro r hr
    have := s2 _ r hr
    rw [s1, Nat.add_zero] at this
    exact this
  · intro N j k
    show ((FordBadFacet.ordinarySuffix N j).primeFactorsList.reverse.drop k).prod =
      ((N.primeFactorsList.reverse).drop (j + k)).prod
    rw [key, List.reverse_reverse, List.drop_drop]

theorem coreCoverage_outside_exceptions_covered (hPNT : Tendsto (fun x : ℝ => (Nat.primeCounting ⌊x⌋₊ : ℝ) / (x / Real.log x)) atTop (𝓝 1))
    (hMERT : ∃ C : ℝ, ∀ x : ℝ, 2 ≤ x →
      |(∑ p ∈ (Finset.Iic ⌊x⌋₊).filter Nat.Prime, (1 : ℝ) / p) - Real.log (Real.log x)| ≤ C)
    (hEULER : Asymptotics.IsEquivalent atTop
      (fun x : ℝ => ∏ p ∈ (Finset.Iic ⌊x⌋₊).filter Nat.Prime, (1 - (1 : ℝ) / p))
      (fun x => Real.exp (-Real.eulerMascheroniConstant) / Real.log x))
    (hRHO : 0 < FordAnalysis.rho ∧ FordAnalysis.rho < 3 / 4 ∧ FordAnalysis.F FordAnalysis.rho = 1)
    (H : ℕ) :
    ∀ᶠ M : ℕ in atTop, H + 2 ≤ M ∧ ∃ P : ℝ, 1 < P ∧
      ∀ᶠ y : ℝ in atTop, ∀ (P_D P_L : ℝ) (R : ℕ), P ≤ P_L →
        ∀ m ∈ totientsUpTo y, y ^ (99 / 100 : ℝ) < (m : ℝ) →
          m ∉ FordBadFacet.coreCoverageExceptions y H M P_D P_L R →
            m ∈ (CoreRecords.powerRawPairs (CoreRecords.CoreSelection.fullSelection y
              (FordScale.coreDimension M (logLog y)) R P)).image corePairValue :=
by
  have hLL : Tendsto logLog atTop atTop :=
    Real.tendsto_log_atTop.comp Real.tendsto_log_atTop
  obtain ⟨hanti, hsufpos, hsuflpf, hsufcomp⟩ := ordinary_prime_list_suffix_facts
  filter_upwards [coreCoverage_retained_profiles hRHO H] with M hMprop
  obtain ⟨hHM, P, hP, hprofT⟩ := hMprop
  refine ⟨hHM, P, hP, ?_⟩
  filter_upwards [hLL.eventually hprofT, coreCoverage_top_prime_gap,
    eventually_gt_atTop (1 : ℝ)] with y hprofy htop hy
  obtain ⟨hL1, hprof⟩ := hprofy
  intro P_D P_L R hPL m hm hlo hmE
  have hy0 : (0 : ℝ) ≤ y := by linarith
  
  unfold FordBadFacet.coreCoverageExceptions at hmE
  simp only [Finset.mem_union, not_or] at hmE
  obtain ⟨⟨⟨⟨⟨h1, h2⟩, h3⟩, h4⟩, h5⟩, h6⟩ := hmE
  unfold FordBadFacet.firstFailedExceptionalValues at h1
  simp only [Finset.mem_union, not_or] at h1
  obtain ⟨⟨⟨⟨hsq0, hbad2⟩, hfive⟩, hsq⟩, _⟩ := h1
  have hm' := hm
  unfold totientsUpTo at hm'
  rw [Finset.mem_filter, Finset.mem_Icc] at hm'
  obtain ⟨⟨hm1, hmfl⟩, N, hNm⟩ := hm'
  have hN : 0 < N := by
    rcases Nat.eq_zero_or_pos N with h | h
    · subst h
      rw [Nat.totient_zero] at hNm
      omega
    · exact h
  have hmy : (m : ℝ) ≤ y := (Nat.le_floor_iff hy0).mp hmfl
  have hsqrt : Real.sqrt y ≤ (m : ℝ) := by
    by_contra hcon
    push_neg at hcon
    apply hsq0
    unfold totientsUpTo
    rw [Finset.mem_filter, Finset.mem_Icc]
    exact ⟨⟨hm1, Nat.le_floor hcon.le⟩, N, hNm⟩
  
  have hpoly : (fun idx : Fin (FordScale.coreDimension H (logLog y)) =>
      FordBadFacet.ordinaryPrimeCoordinate (logLog y) N (idx.val + 1)) ∈
      FordGeometry.polytope (FordScale.coreDimension H (logLog y))
        (FordGeometry.expandedParameter (FordScale.optimalDimension (logLog y))) := by
    by_contra hc
    exact h2 (Finset.mem_filter.mpr ⟨hm, N, hN, hNm, hc⟩)
  have hterm : (FordBadFacet.ordinaryPrimeAt N (FordScale.coreDimension H (logLog y)) : ℝ) < P_D := by
    by_contra hc
    push_neg at hc
    exact h3 (Finset.mem_filter.mpr ⟨hm, N, hN, hNm, hpoly, hc⟩)
  have hsmD := ordinary_residual_smooth_of_terminal_le N
    (FordScale.coreDimension H (logLog y)) P_D hterm.le
  have hconc : (fun idx : Fin (FordScale.coreDimension H (logLog y)) =>
      FordBadFacet.ordinaryPrimeCoordinate (logLog y) N (idx.val + 1)) ∉
      FordGeometry.parameterConcentrationUnion (FordScale.coreDimension H (logLog y))
        (FordGeometry.expandedParameter (FordScale.optimalDimension (logLog y))) (M - H - 1)
        (1 / 20) := by
    intro hc
    exact h4 (Finset.mem_filter.mpr ⟨hm, hsqrt, hbad2, hfive, hsq, N, hN, hNm, hc, hsmD⟩)
  have hshell : (fun idx : Fin (FordScale.coreDimension H (logLog y)) =>
      FordBadFacet.ordinaryPrimeCoordinate (logLog y) N (idx.val + 1)) ∉
      FordReciprocal.coreOuterShell H (logLog y) := by
    intro hc
    exact h5 (Finset.mem_filter.mpr ⟨hm, hsqrt, hbad2, hfive, hsq, N, hN, hNm, hc, hsmD⟩)
  obtain ⟨hent, hgap, hPq⟩ := hprof N hpoly hconc
  
  have hLD : FordScale.coreDimension M (logLog y) ≤ FordScale.coreDimension H (logLog y) := by
    unfold FordScale.coreDimension
    omega
  have hξ : ∀ j, 1 ≤ FordGeometry.expandedParameter (FordScale.optimalDimension (logLog y)) j := by
    intro j
    unfold FordGeometry.expandedParameter
    exact le_add_of_nonneg_right (by positivity)
  obtain ⟨hpolyL₀, houterLe⟩ := ford_polytope_initial_segment hLD hξ hpoly
  have hpolyL : (fun idx : Fin (FordScale.coreDimension M (logLog y)) =>
      FordBadFacet.ordinaryPrimeCoordinate (logLog y) N (idx.val + 1)) ∈
      FordGeometry.polytope (FordScale.coreDimension M (logLog y))
        (FordGeometry.expandedParameter (FordScale.optimalDimension (logLog y))) := hpolyL₀
  have houterD : FordGeometry.outerForm (FordScale.coreDimension H (logLog y))
      (fun idx : Fin (FordScale.coreDimension H (logLog y)) =>
        FordBadFacet.ordinaryPrimeCoordinate (logLog y) N (idx.val + 1)) ≤
      1 - (logLog y) ^ (-1 / 8 : ℝ) := by
    by_contra hc
    push_neg at hc
    exact hshell (Set.mem_inter hpoly hc)
  have hcoord : ∀ idx : Fin (FordScale.coreDimension M (logLog y)),
      CollisionBox.primeCoordinate (logLog y) (FordBadFacet.ordinaryPrimeAt N (idx.val + 1)) =
        FordBadFacet.ordinaryPrimeCoordinate (logLog y) N (idx.val + 1) := by
    intro idx
    have h17 := (hent (idx.val + 1) (by omega) (by omega)).2.1
    show CollisionBox.primeCoordinate (logLog y) (FordBadFacet.ordinaryPrimeAt N (idx.val + 1)) =
      FordBadFacet.fordPrimeCoordinate (logLog y) (FordBadFacet.ordinaryPrimeAt N (idx.val + 1))
    generalize FordBadFacet.ordinaryPrimeAt N (idx.val + 1) = q at h17 ⊢
    have hq : (17 : ℝ) < (q : ℝ) := by exact_mod_cast h17
    have he : Real.exp 1 < (q : ℝ) := by
      have := Real.exp_one_lt_d9
      linarith
    have hlogq : 1 < Real.log q := by
      have := Real.log_lt_log (Real.exp_pos 1) he
      rwa [Real.log_exp] at this
    have hll : 0 < logLog (q : ℝ) := Real.log_pos hlogq
    unfold CollisionBox.primeCoordinate FordBadFacet.fordPrimeCoordinate
      FordBadFacet.positiveLogLog
    rw [max_eq_right hll.le]
  have hfacet : FordGeometry.outerForm (FordScale.coreDimension M (logLog y))
      (fun idx : Fin (FordScale.coreDimension M (logLog y)) =>
        CollisionBox.primeCoordinate (logLog y) (FordBadFacet.ordinaryPrimeAt N (idx.val + 1))) ≤
      1 - (logLog y) ^ (-1 / 8 : ℝ) := by
    rw [show (fun idx : Fin (FordScale.coreDimension M (logLog y)) =>
        CollisionBox.primeCoordinate (logLog y) (FordBadFacet.ordinaryPrimeAt N (idx.val + 1))) =
        (fun idx : Fin (FordScale.coreDimension M (logLog y)) =>
        FordBadFacet.ordinaryPrimeCoordinate (logLog y) N (idx.val + 1)) from funext hcoord]
    exact le_trans houterLe houterD
  have hqL : (FordBadFacet.ordinaryPrimeAt N (FordScale.coreDimension M (logLog y)) : ℝ) ≤ P_L :=
    hPq.trans hPL
  have hsmL := ordinary_residual_smooth_of_terminal_le N
    (FordScale.coreDimension M (logLog y)) P_L hqL
  have hres : ((FordBadFacet.ordinarySuffix (FordBadFacet.ordinarySuffix N 1)
      (FordScale.coreDimension M (logLog y)) : ℕ) : ℝ) < (R : ℝ) := by
    by_contra hc
    push_neg at hc
    exact h6 (Finset.mem_filter.mpr ⟨hm, N, hN, hNm, hpolyL, hc, hsmL⟩)
  have htail : FordBadFacet.ordinarySuffix N (FordScale.coreDimension M (logLog y) + 1) ≤ R := by
    have heq : FordBadFacet.ordinarySuffix N (FordScale.coreDimension M (logLog y) + 1) =
        FordBadFacet.ordinarySuffix (FordBadFacet.ordinarySuffix N 1)
          (FordScale.coreDimension M (logLog y)) := by
      rw [hsufcomp, Nat.add_comm]
    rw [heq]
    exact_mod_cast hres.le
  
  obtain ⟨hq0, hgap0⟩ := htop m N hm hsqrt hN hNm hbad2 hfive hsq
  have hprimeL : ∀ idx : Fin (FordScale.coreDimension M (logLog y)),
      (FordBadFacet.ordinaryPrimeAt N (idx.val + 1)).Prime :=
    fun idx => (hent (idx.val + 1) (by omega) (by omega)).1
  have horderL : ∀ j : ℕ, 1 ≤ j → j ≤ FordScale.coreDimension M (logLog y) →
      FordBadFacet.ordinaryPrimeAt N (j + 1) < FordBadFacet.ordinaryPrimeAt N j :=
    fun j hj1 hj2 => (hgap j hj1 hj2).2
  obtain ⟨_, hphi⟩ := ordinary_totient_core_factorization hN hgap0 hprimeL horderL
  
  have hLpos : 0 < FordScale.coreDimension M (logLog y) := hL1
  have horderS : StrictAnti (fun idx : Fin (FordScale.coreDimension M (logLog y)) =>
      FordBadFacet.ordinaryPrimeAt N (idx.val + 1)) := by
    intro i j hij
    have hij' : i.val < j.val := hij
    have hjL := j.isLt
    show FordBadFacet.ordinaryPrimeAt N (j.val + 1) < FordBadFacet.ordinaryPrimeAt N (i.val + 1)
    have k1 := hanti N (i.val + 1 + 1) (j.val + 1) (by omega)
    have k2 := (hgap (i.val + 1) (by omega) (by omega)).2
    exact lt_of_le_of_lt k1 k2
  have hlast_lower : max 17 (largestPrimeFactor
      (FordBadFacet.ordinarySuffix N (FordScale.coreDimension M (logLog y) + 1))) <
      FordBadFacet.ordinaryPrimeAt N (FordScale.coreDimension M (logLog y) - 1 + 1) := by
    rw [Nat.sub_add_cancel (by omega : 1 ≤ FordScale.coreDimension M (logLog y))]
    have k17 := (hent (FordScale.coreDimension M (logLog y)) (by omega) (by omega)).2.1
    have klpf := hsuflpf N (FordScale.coreDimension M (logLog y) + 1)
    have kord := (hgap (FordScale.coreDimension M (logLog y)) (by omega) le_rfl).2
    exact max_lt k17 (lt_of_le_of_lt klpf kord)
  have hlast_upper : (FordBadFacet.ordinaryPrimeAt N
      (FordScale.coreDimension M (logLog y) - 1 + 1) : ℝ) ≤ P := by
    rw [Nat.sub_add_cancel (by omega : 1 ≤ FordScale.coreDimension M (logLog y))]
    exact hPq
  have hgaps : ∀ i j : Fin (FordScale.coreDimension M (logLog y)), j.val = i.val + 1 →
      (6 / 5 : ℝ) * logLog (FordBadFacet.ordinaryPrimeAt N (j.val + 1) : ℝ) ≤
        logLog (FordBadFacet.ordinaryPrimeAt N (i.val + 1) : ℝ) := by
    intro i j hj
    have hjL := j.isLt
    rw [hj]
    exact (hgap (i.val + 1) (by omega) (by omega)).1
  have hupper : ∀ idx : Fin (FordScale.coreDimension M (logLog y)),
      (FordBadFacet.ordinaryPrimeAt N (idx.val + 1) : ℝ) ≤ CollisionBox.cutoff y (4 / 5) := by
    intro idx
    obtain ⟨_, h17, hll⟩ := hent (idx.val + 1) (by omega) (by omega)
    generalize FordBadFacet.ordinaryPrimeAt N (idx.val + 1) = q at h17 hll ⊢
    have hq : (17 : ℝ) < (q : ℝ) := by exact_mod_cast h17
    have hq0' : (0 : ℝ) < (q : ℝ) := by linarith
    have hlogq : 0 < Real.log (q : ℝ) := Real.log_pos (by linarith)
    have hlogy : 0 < Real.log y := Real.log_pos hy
    unfold CollisionBox.cutoff
    rw [← Real.exp_log hq0']
    apply Real.exp_le_exp.mpr
    rw [← Real.exp_log hlogq, Real.rpow_def_of_pos hlogy]
    apply Real.exp_le_exp.mpr
    unfold logLog at hll
    linarith
  let Q : CoreRecords.LowerCoreRecord y (FordScale.coreDimension M (logLog y)) R P :=
    { length_pos := hLpos
      tail := FordBadFacet.ordinarySuffix N (FordScale.coreDimension M (logLog y) + 1)
      tail_pos := hsufpos N _
      tail_le := htail
      lower := fun idx => FordBadFacet.ordinaryPrimeAt N (idx.val + 1)
      prime := hprimeL
      order := horderS
      last_lower := hlast_lower
      last_upper := hlast_upper
      gaps := hgaps
      upper := hupper
      facet := hfacet }
  
  have hcore_mem : Q.numericalCore ∈
      (CoreRecords.CoreSelection.fullSelection y (FordScale.coreDimension M (logLog y)) R P).cores :=
    Finset.mem_image_of_mem _ (Finset.mem_univ Q)
  have hval : corePairValue (Q.numericalCore, FordBadFacet.ordinaryPrimeAt N 0) = m := by
    show (FordBadFacet.ordinaryPrimeAt N 0 - 1) *
      ((FordBadFacet.ordinarySuffix N (FordScale.coreDimension M (logLog y) + 1)).totient *
        ∏ idx : Fin (FordScale.coreDimension M (logLog y)),
          (FordBadFacet.ordinaryPrimeAt N (idx.val + 1) - 1)) = m
    rw [← hphi, hNm]
  have hbpos : 0 < (FordBadFacet.ordinarySuffix N (FordScale.coreDimension M (logLog y) + 1)).totient *
      ∏ idx : Fin (FordScale.coreDimension M (logLog y)),
        (FordBadFacet.ordinaryPrimeAt N (idx.val + 1) - 1) := by
    apply Nat.mul_pos (Nat.totient_pos.mpr (hsufpos N _))
    apply Finset.prod_pos
    intro idx _
    have := (hprimeL idx).two_le
    omega
  have hrange : FordBadFacet.ordinaryPrimeAt N 0 < ⌊y⌋₊ + 2 := by
    have k1 : FordBadFacet.ordinaryPrimeAt N 0 - 1 ≤ m := by
      rw [← hNm, hphi]
      exact Nat.le_mul_of_pos_right _ hbpos
    omega
  refine Finset.mem_image.mpr ⟨(Q.numericalCore, FordBadFacet.ordinaryPrimeAt N 0), ?_, hval⟩
  show (Q.numericalCore, FordBadFacet.ordinaryPrimeAt N 0) ∈
