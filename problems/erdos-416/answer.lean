  rw [← hr, le_div_iff₀ hℓ3]
  linarith [hc3, hS3, hrN, hExr, hEx]

theorem retained_threeForm_prime_count (hPNT : Tendsto (fun x : ℝ => (Nat.primeCounting ⌊x⌋₊ : ℝ) / (x / Real.log x)) atTop (𝓝 1))
    (hMERT : ∃ C : ℝ, ∀ x : ℝ, 2 ≤ x →
      |(∑ p ∈ (Finset.Iic ⌊x⌋₊).filter Nat.Prime, (1 : ℝ) / p) - Real.log (Real.log x)| ≤ C)
    (hEULER : Asymptotics.IsEquivalent atTop
      (fun x : ℝ => ∏ p ∈ (Finset.Iic ⌊x⌋₊).filter Nat.Prime, (1 - (1 : ℝ) / p))
      (fun x => Real.exp (-Real.eulerMascheroniConstant) / Real.log x)) :
    ∃ C : ℝ, 0 < C ∧ ∀ᶠ Y : ℝ in atTop, ∀ (a b : ℕ) (x : ℝ) (Q : Finset ℕ),
      0 < a → a < b → (b : ℝ) ≤ Y → 2 ≤ x →
      (∀ q ∈ Q, q.Prime ∧ (a * q + 1).Prime ∧ (b * q + 1).Prime ∧ (q : ℝ) ≤ x) →
      (Q.card : ℝ) ≤ C * logLog Y ^ 3 * x / Real.log x ^ 3 :=
by
  obtain ⟨K, hK, hcount⟩ := threeForm_prime_count_of_sifted_bound
    (threeForm_sifted_count_of_ingredients selberg_sieve_simple_bound
      selberg_sum_ge_multiplicative_sum coprime_harmonic_lower_bound
      (threeForm_density_sum_lower_bound threeFold_factorization_count_le)
      sum_pow_omega_divisors_le threeForm_count_error)
    threeForm_sieve_error_absorb
  obtain ⟨Cr, hCr, hratio⟩ :=
    totient_ratio_le_logLog_of_size (inverse_totient_size_bound hPNT hMERT hEULER)
  have hratio4 := (tendsto_pow_atTop (by norm_num : (4 : ℕ) ≠ 0)).eventually hratio
  have hLL : Tendsto logLog atTop atTop :=
    Real.tendsto_log_atTop.comp Real.tendsto_log_atTop
  refine ⟨K * (2 * Cr) ^ 3, by positivity, ?_⟩
  filter_upwards [hratio4, hLL.eventually_ge_atTop (Real.log 4),
    eventually_ge_atTop (6 : ℝ)] with Y hY hLY hY6
  intro a b x Q ha hab hbY hx hQ
  have hba : 0 < b - a := Nat.sub_pos_of_lt hab
  have hb0 : 0 < b := lt_trans ha hab
  have hDpos : 0 < 6 * a * b * (b - a) := by positivity
  have hDY : (((6 * a * b * (b - a) : ℕ)) : ℝ) ≤ Y ^ 4 := by
    push_cast [Nat.cast_sub hab.le]
    have hab' : (a : ℝ) < b := by exact_mod_cast hab
    have ha0 : (0 : ℝ) ≤ a := Nat.cast_nonneg a
    have h1 : (a : ℝ) ≤ Y := by linarith
    have h2 : (b : ℝ) - a ≤ Y := by linarith
    have h3 : 0 ≤ (b : ℝ) - a := by linarith
    have hb0' : (0 : ℝ) ≤ b := by linarith
    have hY0 : (0 : ℝ) ≤ Y := by linarith
    calc 6 * (a : ℝ) * b * (b - a) ≤ 6 * Y * Y * Y := by gcongr
      _ ≤ Y * Y * Y * Y := by
        have : 0 ≤ Y * Y * Y := by positivity
        nlinarith
      _ = Y ^ 4 := by ring
  have hρ := hY (6 * a * b * (b - a)) hDpos hDY
  have hlogY : 0 < Real.log Y := Real.log_pos (by linarith)
  have hLL4 : logLog (Y ^ 4) ≤ 2 * logLog Y := by
    have h4 : logLog (Y ^ 4) = Real.log 4 + logLog Y := by
      unfold logLog
      rw [Real.log_pow, Real.log_mul (by norm_num) hlogY.ne']
      norm_num
    rw [h4]
    linarith
  have hρ0 : (0 : ℝ) ≤ (((6 * a * b * (b - a) : ℕ)) : ℝ) / (6 * a * b * (b - a)).totient := by
    positivity
  have hρ2 : (((6 * a * b * (b - a) : ℕ)) : ℝ) / (6 * a * b * (b - a)).totient ≤
      2 * Cr * logLog Y := by
    have := mul_le_mul_of_nonneg_left hLL4 hCr.le
