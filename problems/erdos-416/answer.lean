      (1 / T) * L * Real.log ((L : ℝ) + 1) ≤ (1 / 2 : ℝ) * T ^ (-1 / 8 : ℝ) := by
    have hc : (0 : ℝ) < 1 / (2 * (A + 1)) := by positivity
    filter_upwards [(isLittleO_log_rpow_atTop (by norm_num : (0 : ℝ) < 7 / 16)).bound hc,
