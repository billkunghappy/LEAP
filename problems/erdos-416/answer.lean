    rw [hkey, le_div_iff₀ hAp, one_mul]
    linarith
  
  have htopc := ford_top_weight_ratio FordAnalysis.rho hρ hc1 hPA hPB hPC L hL
  have htop : MeasureTheory.volume.real
      {x | x ∈ FordOrder.unordered L ∧ 1 ≤ x ⟨0, lt_of_lt_of_le (by norm_num) hL⟩} ≤
