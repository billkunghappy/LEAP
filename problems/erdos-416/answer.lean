by
  
  have hsum2 : ∀ (s : Finset ℕ) (f : ℕ → ℕ), 2 ≤ ∑ i ∈ s, f i →
      (∃ i ∈ s, 2 ≤ f i) ∨ (∃ i ∈ s, ∃ j ∈ s, i ≠ j ∧ 0 < f i ∧ 0 < f j) := by
    intro s f hs
    by_cases hbig : ∃ i ∈ s, 2 ≤ f i
    · exact Or.inl hbig
    right
    push_neg at hbig
    obtain ⟨i, hi, hfi⟩ := Finset.sum_pos_iff.mp (show 0 < ∑ i ∈ s, f i by omega)
    by_cases hj : ∃ j ∈ s, j ≠ i ∧ 0 < f j
