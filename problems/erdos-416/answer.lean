theorem vonMangoldt_div_log_sum_rate : ∀ B : ℝ, (∀ x : ℝ, 1 ≤ x → |(∑ d ∈ Finset.Ioc 0 ⌊x⌋₊, ArithmeticFunction.vonMangoldt d / (d : ℝ)) - Real.log x| ≤ B) → ∃ C K : ℝ, ∀ x : ℝ, 2 ≤ x → |(∑ d ∈ Finset.Ioc 0 ⌊x⌋₊, ArithmeticFunction.vonMangoldt d / ((d : ℝ) * Real.log d)) - Real.log (Real.log x) - C| ≤ K / Real.log x :=
