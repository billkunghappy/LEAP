    · funext b
      exact hidem _ _ _ hu
  
  have hPpos : ∀ (u : ℝ) s, 0 < ((∏ a, (cut u s).1 a : ℕ) : ℝ) := by
    intro u s
    rw [hcut u s]
    exact Nat.cast_pos.mpr (Finset.prod_pos fun a _ => hpos _ _)
  
  have hgstep : ∀ (S T : Finset ((Fin m → ℕ) × (Fin n → ℕ)))
      (g : (Fin m → ℕ) × (Fin n → ℕ) → (Fin m → ℕ) × (Fin n → ℕ)) (Bj : ℝ),
      (∀ w ∈ S, g w ∈ T) → (∀ σ ∈ T, 0 < ((∏ a, σ.1 a : ℕ) : ℝ)) →
      (∀ σ ∈ T, (∑ w ∈ S.filter (fun w => g w = σ),
        ((∏ a, σ.1 a : ℕ) : ℝ) / ((∏ a, w.1 a : ℕ) : ℝ)) ≤ Bj) →
      (∑ w ∈ S, (1 : ℝ) / ((d : ℝ) * ((∏ a, w.1 a : ℕ) : ℝ))) ≤
        Bj * ∑ σ ∈ T, (1 : ℝ) / ((d : ℝ) * ((∏ a, σ.1 a : ℕ) : ℝ)) := by
    intro S T g Bj hmaps hP hfib
    rw [← Finset.sum_fiberwise_of_maps_to hmaps
      (fun w => (1 : ℝ) / ((d : ℝ) * ((∏ a, w.1 a : ℕ) : ℝ))), Finset.mul_sum]
    apply Finset.sum_le_sum
    intro σ hσ
    have hPs := hP σ hσ
    have hid : ∀ w ∈ S.filter (fun w => g w = σ),
        (1 : ℝ) / ((d : ℝ) * ((∏ a, w.1 a : ℕ) : ℝ)) =
          (1 / ((d : ℝ) * ((∏ a, σ.1 a : ℕ) : ℝ))) *
            (((∏ a, σ.1 a : ℕ) : ℝ) / ((∏ a, w.1 a : ℕ) : ℝ)) := by
      intro w _
      generalize ((∏ a, σ.1 a : ℕ) : ℝ) = x at hPs ⊢
      generalize ((∏ a, w.1 a : ℕ) : ℝ) = y
      rw [div_mul_div_comm, one_mul, show (d : ℝ) * x * y = x * ((d : ℝ) * y) by ring,
        div_mul_cancel_left₀ hPs.ne', one_div]
    rw [Finset.sum_congr rfl hid, ← Finset.mul_sum, mul_comm Bj]
    exact mul_le_mul_of_nonneg_left (hfib σ hσ)
      (div_nonneg zero_le_one (mul_nonneg (Nat.cast_nonneg d) hPs.le))
  
  have hbase : (F.card : ℝ) ≤
      A * ∑ σ ∈ F.image (cut (v 1)), (1 : ℝ) / ((d : ℝ) * ((∏ a, σ.1 a : ℕ) : ℝ)) := by
    rw [Finset.card_eq_sum_card_image (cut (v 1)) F, Nat.cast_sum, Finset.mul_sum]
    apply Finset.sum_le_sum
    intro σ hσ
    rw [mul_one_div]
    exact hfirst σ hσ
  
  have hind : ∀ i : ℕ, i + 1 ≤ k → (F.card : ℝ) ≤ A * (∏ j ∈ Finset.range i, B j) *
      ∑ σ ∈ F.image (cut (v (i + 1))), (1 : ℝ) / ((d : ℝ) * ((∏ a, σ.1 a : ℕ) : ℝ)) := by
    intro i
    induction i with
    | zero =>
      intro _
      rw [Finset.prod_range_zero, mul_one]
      exact hbase
    | succ i ih =>
      intro hi
      show (F.card : ℝ) ≤ A * (∏ j ∈ Finset.range (i + 1), B j) *
        ∑ σ ∈ F.image (cut (v (i + 2))), (1 : ℝ) / ((d : ℝ) * ((∏ a, σ.1 a : ℕ) : ℝ))
      have h1 := ih (by omega)
      have hvle : v (i + 2) ≤ v (i + 1) := hanti (by omega)
      have hmaps : ∀ w ∈ F.image (cut (v (i + 1))),
          cut (v (i + 2)) w ∈ F.image (cut (v (i + 2))) := by
        intro w hw
        obtain ⟨s, hs, rfl⟩ := Finset.mem_image.mp hw
        rw [hcomp _ _ hvle s]
        exact Finset.mem_image_of_mem _ hs
      have hPT : ∀ σ ∈ F.image (cut (v (i + 2))), 0 < ((∏ a, σ.1 a : ℕ) : ℝ) := by
        intro σ hσ
        obtain ⟨s, _, rfl⟩ := Finset.mem_image.mp hσ
        exact hPpos _ s
      have h2 := hgstep _ _ _ (B i) hmaps hPT (hstep i (by omega))
      have hnn : 0 ≤ A * ∏ j ∈ Finset.range i, B j :=
        mul_nonneg hA (Finset.prod_nonneg fun j hj => hB j (by
          rw [Finset.mem_range] at hj; omega))
      calc (F.card : ℝ) ≤ _ := h1
        _ ≤ A * (∏ j ∈ Finset.range i, B j) *
            (B i * ∑ σ ∈ F.image (cut (v (i + 2))),
              (1 : ℝ) / ((d : ℝ) * ((∏ a, σ.1 a : ℕ) : ℝ))) :=
          mul_le_mul_of_nonneg_left h2 hnn
        _ = _ := by rw [Finset.prod_range_succ]; ring
  have hfin := hind (k - 1) (by omega)
  rw [Nat.sub_add_cancel hk] at hfin
  exact hfin

theorem retained_initial_fibre_high_part {m n : ℕ}
    (cut : ℝ → (Fin m → ℕ) × (Fin n → ℕ) → (Fin m → ℕ) × (Fin n → ℕ))
    (hcut : ∀ (u : ℝ) (s : (Fin m → ℕ) × (Fin n → ℕ)), cut u s =
      (fun a => ((s.1 a).primeFactorsList.filter (fun p : ℕ => decide ((p : ℝ) ≤ u))).prod,
       fun b => ((s.2 b).primeFactorsList.filter (fun p : ℕ => decide ((p : ℝ) ≤ u))).prod))
    (F : Finset ((Fin m → ℕ) × (Fin n → ℕ))) (d : ℕ) (u : ℝ)
    (hd : 0 < d) (hdu : ∀ p ∈ d.primeFactorsList, (p : ℝ) ≤ u)
    (hF : ∀ s ∈ F, ((∀ a : Fin m, 0 < s.1 a) ∧ (∀ b : Fin n, 0 < s.2 b)) ∧
      d * (∏ a, s.1 a) = (∏ b, s.2 b) ∧
      (∀ a : Fin m, a.val ≠ 0 → ∀ r ∈ (s.1 a).primeFactorsList, (r : ℝ) ≤ u) ∧
      (∀ b : Fin n, b.val ≠ 0 → ∀ r ∈ (s.2 b).primeFactorsList, (r : ℝ) ≤ u))
    (σ : (Fin m → ℕ) × (Fin n → ℕ)) :
    Set.InjOn (fun s : (Fin m → ℕ) × (Fin n → ℕ) =>
        ((∏ a, s.1 a).primeFactorsList.filter (fun p : ℕ => decide (u < (p : ℝ)))).prod)
      ↑(F.filter (fun s => cut u s = σ)) ∧
    ∀ s ∈ F.filter (fun s => cut u s = σ),
      (∏ a, s.1 a) = (∏ a, σ.1 a) *
        ((∏ a, s.1 a).primeFactorsList.filter (fun p : ℕ => decide (u < (p : ℝ)))).prod ∧
      (∀ a : Fin m, a.val = 0 →
        s.1 a = σ.1 a *
          ((∏ a', s.1 a').primeFactorsList.filter (fun p : ℕ => decide (u < (p : ℝ)))).prod ∧
        ((s.1 a).primeFactorsList.filter (fun p : ℕ => decide (u < (p : ℝ)))).prod =
          ((∏ a', s.1 a').primeFactorsList.filter (fun p : ℕ => decide (u < (p : ℝ)))).prod) ∧
      (∀ b : Fin n, b.val = 0 →
        s.2 b = σ.2 b *
          ((∏ a', s.1 a').primeFactorsList.filter (fun p : ℕ => decide (u < (p : ℝ)))).prod) :=
by
  
  have hsr : ∀ x : ℕ, x ≠ 0 →
      (x.primeFactorsList.filter (fun p : ℕ => decide ((p : ℝ) ≤ u))).prod *
        (x.primeFactorsList.filter (fun p : ℕ => decide (u < (p : ℝ)))).prod = x := by
    intro x hx
    have h1 := List.filter_append_perm (fun p : ℕ => decide ((p : ℝ) ≤ u)) x.primeFactorsList
    have h2 : x.primeFactorsList.filter (fun p : ℕ => !decide ((p : ℝ) ≤ u)) =
        x.primeFactorsList.filter (fun p : ℕ => decide (u < (p : ℝ))) := by
      apply List.filter_congr
      intro p _
      by_cases h : (p : ℝ) ≤ u
      · simp [h, not_lt.mpr h]
      · simp [h, lt_of_not_ge h]
    rw [h2] at h1
    rw [← List.prod_append, h1.prod_eq, Nat.prod_primeFactorsList hx]
  
  have hrm : ∀ x y : ℕ, x ≠ 0 → y ≠ 0 →
      ((x * y).primeFactorsList.filter (fun p : ℕ => decide (u < (p : ℝ)))).prod =
        (x.primeFactorsList.filter (fun p : ℕ => decide (u < (p : ℝ)))).prod *
          (y.primeFactorsList.filter (fun p : ℕ => decide (u < (p : ℝ)))).prod := by
    intro x y hx hy
    rw [((Nat.perm_primeFactorsList_mul hx hy).filter _).prod_eq, List.filter_append,
      List.prod_append]
  
  have hrp : ∀ (k : ℕ) (f : Fin k → ℕ) (S : Finset (Fin k)), (∀ i, f i ≠ 0) →
      ((∏ i ∈ S, f i).primeFactorsList.filter (fun p : ℕ => decide (u < (p : ℝ)))).prod =
        ∏ i ∈ S, ((f i).primeFactorsList.filter (fun p : ℕ => decide (u < (p : ℝ)))).prod := by
    intro k f S hf
    refine Finset.induction_on S (by simp) ?_
    intro j S hj ih
    rw [Finset.prod_insert hj, Finset.prod_insert hj,
      hrm _ _ (hf j) (Finset.prod_ne_zero_iff.mpr (fun i _ => hf i)), ih]
  
  have hsm : ∀ x : ℕ, x ≠ 0 → (∀ r ∈ x.primeFactorsList, (r : ℝ) ≤ u) →
      (x.primeFactorsList.filter (fun p : ℕ => decide ((p : ℝ) ≤ u))).prod = x ∧
        (x.primeFactorsList.filter (fun p : ℕ => decide (u < (p : ℝ)))).prod = 1 := by
    intro x hx hxu
    constructor
    · rw [List.filter_eq_self.mpr (fun r hr => by simpa using hxu r hr),
        Nat.prod_primeFactorsList hx]
    · rw [List.filter_eq_nil_iff.mpr (fun r hr => by simpa using hxu r hr), List.prod_nil]
  
  have hcoord : ∀ s ∈ F.filter (fun s => cut u s = σ),
      (∀ a, σ.1 a = ((s.1 a).primeFactorsList.filter (fun p : ℕ => decide ((p : ℝ) ≤ u))).prod) ∧
      (∀ b, σ.2 b = ((s.2 b).primeFactorsList.filter (fun p : ℕ => decide ((p : ℝ) ≤ u))).prod) := by
    intro s hs
    rw [Finset.mem_filter] at hs
    rw [← hs.2, hcut]
    exact ⟨fun a => rfl, fun b => rfl⟩
  have hfib : ∀ s ∈ F.filter (fun s => cut u s = σ),
      (∏ a, s.1 a) = (∏ a, σ.1 a) *
        ((∏ a, s.1 a).primeFactorsList.filter (fun p : ℕ => decide (u < (p : ℝ)))).prod ∧
      (∀ a : Fin m, a.val = 0 →
        s.1 a = σ.1 a *
          ((∏ a', s.1 a').primeFactorsList.filter (fun p : ℕ => decide (u < (p : ℝ)))).prod ∧
        ((s.1 a).primeFactorsList.filter (fun p : ℕ => decide (u < (p : ℝ)))).prod =
          ((∏ a', s.1 a').primeFactorsList.filter (fun p : ℕ => decide (u < (p : ℝ)))).prod) ∧
      (∀ b : Fin n, b.val = 0 →
        s.2 b = σ.2 b *
          ((∏ a', s.1 a').primeFactorsList.filter (fun p : ℕ => decide (u < (p : ℝ)))).prod) := by
    intro s hs
    obtain ⟨hσ1, hσ2⟩ := hcoord s hs
    obtain ⟨⟨hp1, hp2⟩, hbal, hs1, hs2⟩ := hF s (Finset.mem_filter.mp hs).1
    have hA := hrp m s.1 Finset.univ (fun a => (hp1 a).ne')
    have hro1 : ∀ a : Fin m, a.val = 0 →
        ((s.1 a).primeFactorsList.filter (fun p : ℕ => decide (u < (p : ℝ)))).prod =
          ((∏ a', s.1 a').primeFactorsList.filter (fun p : ℕ => decide (u < (p : ℝ)))).prod := by
      intro a ha
      rw [hA, Finset.prod_eq_single a]
      · intro a' _ hne
        exact (hsm _ (hp1 a').ne' (hs1 a' (fun h => hne (Fin.ext (h.trans ha.symm))))).2
      · intro h; exact absurd (Finset.mem_univ a) h
    have hro2 : ∀ b : Fin n, b.val = 0 →
        ((s.2 b).primeFactorsList.filter (fun p : ℕ => decide (u < (p : ℝ)))).prod =
          ((∏ a', s.1 a').primeFactorsList.filter (fun p : ℕ => decide (u < (p : ℝ)))).prod := by
      intro b hb
      have e1 : ((s.2 b).primeFactorsList.filter (fun p : ℕ => decide (u < (p : ℝ)))).prod =
          ∏ b', ((s.2 b').primeFactorsList.filter (fun p : ℕ => decide (u < (p : ℝ)))).prod := by
        rw [Finset.prod_eq_single b]
        · intro b' _ hne
          exact (hsm _ (hp2 b').ne' (hs2 b' (fun h => hne (Fin.ext (h.trans hb.symm))))).2
        · intro h; exact absurd (Finset.mem_univ b) h
      rw [e1, ← hrp n s.2 Finset.univ (fun b => (hp2 b).ne'), ← hbal,
        hrm _ _ hd.ne' (Finset.prod_pos (fun a _ => hp1 a)).ne', (hsm d hd.ne' hdu).2, one_mul]
    refine ⟨?_, ?_, ?_⟩
    · rw [hA, ← Finset.prod_mul_distrib]
      refine Finset.prod_congr rfl (fun a _ => ?_)
      rw [hσ1 a, hsr _ (hp1 a).ne']
    · intro a ha
      refine ⟨?_, hro1 a ha⟩
      rw [← hro1 a ha, hσ1 a, hsr _ (hp1 a).ne']
    · intro b hb
      rw [← hro2 b hb, hσ2 b, hsr _ (hp2 b).ne']
  refine ⟨?_, hfib⟩
  intro s hs t ht hst
  have hs' := Finset.mem_coe.mp hs
  have ht' := Finset.mem_coe.mp ht
  dsimp only at hst
  obtain ⟨hs1σ, hs2σ⟩ := hcoord s hs'
  obtain ⟨ht1σ, ht2σ⟩ := hcoord t ht'
  obtain ⟨⟨hsp1, hsp2⟩, -, hsm1, hsm2⟩ := hF s (Finset.mem_filter.mp hs').1
  obtain ⟨⟨htp1, htp2⟩, -, htm1, htm2⟩ := hF t (Finset.mem_filter.mp ht').1
  obtain ⟨-, hsA, hsB⟩ := hfib s hs'
  obtain ⟨-, htA, htB⟩ := hfib t ht'
  refine Prod.ext (funext fun a => ?_) (funext fun b => ?_)
  · by_cases ha : a.val = 0
    · rw [(hsA a ha).1, (htA a ha).1, hst]
    · exact ((hsm _ (hsp1 a).ne' (hsm1 a ha)).1.symm.trans (hs1σ a).symm).trans
        ((ht1σ a).trans (hsm _ (htp1 a).ne' (htm1 a ha)).1)
  · by_cases hb : b.val = 0
    · rw [hsB b hb, htB b hb, hst]
    · exact ((hsm _ (hsp2 b).ne' (hsm2 b hb)).1.symm.trans (hs2σ b).symm).trans
        ((ht2σ b).trans (hsm _ (htp2 b).ne' (htm2 b hb)).1)

theorem retained_snormal_omega_initial_le (n : ℕ) (S w T : ℝ)
    (hn : SNormal S (n + 1)) (hS : Real.exp 1 ≤ S) (hSw : S ≤ w) (hwT : logLog w ≤ T) :
    (omegaInterval n 1 w : ℝ) ≤ 3 * T :=
by
  obtain ⟨_, h2, h3⟩ := hn
  simp only [Nat.add_sub_cancel] at h2 h3
  
  have hsplit : ∀ (a b c : ℝ),
      omegaInterval n a c ≤ omegaInterval n a b + omegaInterval n b c := by
    intro a b c
    unfold omegaInterval
    induction n.primeFactorsList with
    | nil => simp
    | cons x l ih =>
      simp only [List.countP_cons]
      by_cases h1 : a < (x : ℝ) ∧ (x : ℝ) ≤ c
      · by_cases h2' : a < (x : ℝ) ∧ (x : ℝ) ≤ b
        · rw [if_pos (decide_eq_true h1), if_pos (decide_eq_true h2')]
          split_ifs <;> omega
        · have h3' : b < (x : ℝ) ∧ (x : ℝ) ≤ c := by
            refine ⟨?_, h1.2⟩
            by_contra hc
            exact h2' ⟨h1.1, not_lt.mp hc⟩
          rw [if_pos (decide_eq_true h1), if_neg (by simpa using h2'),
            if_pos (decide_eq_true h3')]
          omega
      · rw [if_neg (by simpa using h1)]
        split_ifs <;> omega
  
  have htrunc : ∀ u v : ℝ, omegaInterval n u v ≤ omegaInterval n u (min v (n : ℝ)) := by
    intro u v
    unfold omegaInterval
    apply List.countP_mono_left
    intro x hx hxP
    simp only [decide_eq_true_eq] at hxP ⊢
    have hxn : (x : ℝ) ≤ n := by exact_mod_cast Nat.le_of_mem_primeFactorsList hx
    exact ⟨hxP.1, le_min hxP.2 hxn⟩
  
  have hzero : ∀ u v : ℝ, v ≤ u → omegaInterval n u v = 0 := by
    intro u v huv
    unfold omegaInterval
    rw [List.countP_eq_zero]
    intro x _ hx
    simp only [decide_eq_true_eq] at hx
    linarith [hx.1, hx.2]
  
  have hS0 : 0 < S := lt_of_lt_of_le (Real.exp_pos 1) hS
  have hlogS : 1 ≤ Real.log S := by
    rw [← Real.log_exp 1]
    exact Real.log_le_log (Real.exp_pos 1) hS
  have ha0 : 0 ≤ Real.log (Real.log S) := Real.log_nonneg hlogS
  have hmono : ∀ x y : ℝ, S ≤ x → x ≤ y → Real.log (Real.log x) ≤ Real.log (Real.log y) := by
    intro x y hx hxy
    have hx0 : 0 < x := lt_of_lt_of_le hS0 hx
    have hlx : Real.log S ≤ Real.log x := Real.log_le_log hS0 hx
    exact Real.log_le_log (by linarith) (Real.log_le_log hx0 hxy)
  have hLw : Real.log (Real.log w) ≤ T := hwT
  have hlw := hmono S w le_rfl hSw
  set v := min w (n : ℝ) with hv
  have hcast : (omegaInterval n 1 w : ℝ) ≤
      (omegaInterval n 1 S : ℝ) + (omegaInterval n S v : ℝ) := by
    exact_mod_cast (hsplit 1 S w).trans (Nat.add_le_add_left (htrunc S w) _)
  rcases le_or_gt v S with hvS | hvS
  · rw [hzero S v hvS] at hcast
    push_cast at hcast
    linarith
  · have hvw : v ≤ w := min_le_left _ _
    have hvn : v ≤ (n : ℝ) := min_le_right _ _
    have h := h3 S v le_rfl hvS hvn
    have hb := hmono S v le_rfl hvS.le
    have hbw := hmono v w hvS.le hvw
    have hb0 : 0 ≤ Real.log (Real.log v) := le_trans ha0 hb
    have hsq : Real.sqrt (Real.log (Real.log S) * Real.log (Real.log v)) ≤
        Real.log (Real.log v) := by
      calc Real.sqrt (Real.log (Real.log S) * Real.log (Real.log v))
          ≤ Real.sqrt (Real.log (Real.log v) * Real.log (Real.log v)) :=
            Real.sqrt_le_sqrt (mul_le_mul_of_nonneg_right hb hb0)
        _ = Real.log (Real.log v) := Real.sqrt_mul_self hb0
    have hω := (abs_lt.mp h).2
    linarith

theorem retained_high_part_large_of_omega (n : ℕ) (v Y : ℝ)
    (hY : 1024 ≤ Y) (hv : Real.exp 1 ≤ v)
    (hcut : v ≤ Y ^ (1 / (10 * logLog Y)))
    (htop : Y ^ (9 / 10 : ℝ) < (((n + 1 : ℕ)) : ℝ))
    (hω : (omegaInterval n 1 v : ℝ) ≤ 3 * logLog Y) :
    Real.sqrt Y ≤ (((n.primeFactorsList.filter (fun q : ℕ => decide (v < (q : ℝ)))).prod : ℕ) : ℝ) :=
by
  have hY0 : (0:ℝ) < Y := by linarith
  have he2 : (2:ℝ) ≤ Real.exp 1 := by
    have := Real.add_one_le_exp (1:ℝ); linarith
  have hv1 : (1:ℝ) ≤ v := by linarith
  have h9 : (1:ℝ) ≤ Y ^ (9/10 : ℝ) := Real.one_le_rpow (by linarith) (by norm_num)
  have hn0 : n ≠ 0 := by
    rintro rfl
    norm_num at htop
    linarith
  set l := n.primeFactorsList with hl
  set p : ℕ → Bool := fun q : ℕ => decide (v < (q : ℝ)) with hp
  have hsplit : (l.filter p).prod * (l.filter (fun x => !p x)).prod = n := by
    rw [← List.prod_append, (List.filter_append_perm p l).prod_eq, hl,
      Nat.prod_primeFactorsList hn0]
  have hlen : omegaInterval n 1 v = (l.filter (fun x => !p x)).length := by
    unfold omegaInterval
    rw [List.countP_eq_length_filter]
    congr 1
    apply List.filter_congr
    intro x hx
    have hx1 : (1:ℝ) < x := by exact_mod_cast (Nat.prime_of_mem_primeFactorsList hx).one_lt
    simp only [hp, hx1, true_and]
    rcases lt_or_ge v (x:ℝ) with h | h
    · simp [h, not_le.mpr h]
    · simp [h, not_lt.mpr h]
  have hbound : ∀ L : List ℕ, (∀ x ∈ L, (x:ℝ) ≤ v) → ((L.prod : ℕ) : ℝ) ≤ v ^ L.length := by
    intro L
    induction L with
    | nil => intro _; simp
    | cons x L ih =>
      intro h
      rw [List.prod_cons, Nat.cast_mul, List.length_cons, pow_succ']
      exact mul_le_mul (h x (by simp)) (ih (fun y hy => h y (by simp [hy])))
        (Nat.cast_nonneg _) (by linarith)
  have hLo : (((l.filter (fun x => !p x)).prod : ℕ) : ℝ) ≤ v ^ omegaInterval n 1 v := by
    rw [hlen]
    apply hbound
    intro x hx
    have := (List.mem_filter.mp hx).2
    simp [hp] at this
    exact this
  have hT : 0 < logLog Y := by
    unfold logLog
    apply Real.log_pos
    rw [Real.lt_log_iff_exp_lt hY0]
    have := Real.exp_one_lt_d9
    linarith
  have hpow : v ^ omegaInterval n 1 v ≤ Y ^ (3/10 : ℝ) := by
    rw [← Real.rpow_natCast]
    calc v ^ ((omegaInterval n 1 v : ℕ) : ℝ) ≤ v ^ (3 * logLog Y) :=
          Real.rpow_le_rpow_of_exponent_le hv1 hω
      _ ≤ (Y ^ (1 / (10 * logLog Y))) ^ (3 * logLog Y) :=
          Real.rpow_le_rpow (by linarith) hcut (by positivity)
      _ = Y ^ (1 / (10 * logLog Y) * (3 * logLog Y)) := (Real.rpow_mul hY0.le _ _).symm
      _ = Y ^ (3/10 : ℝ) := by
          congr 1
          field_simp
  have hgap : Y ^ (3/10 : ℝ) * Real.sqrt Y + 1 ≤ Y ^ (9/10 : ℝ) := by
    rw [Real.sqrt_eq_rpow, ← Real.rpow_add hY0]
    have h1 : Y ^ (9/10 : ℝ) = Y ^ (3/10 + 1/2 : ℝ) * Y ^ (1/10 : ℝ) := by
      rw [← Real.rpow_add hY0]; norm_num
    have h2 : (2:ℝ) ≤ Y ^ (1/10 : ℝ) := by
      have h1024 : (1024:ℝ) ^ (1/10 : ℝ) = 2 := by
        rw [show (1024:ℝ) = 2 ^ (10:ℝ) by
              rw [show (10:ℝ) = ((10:ℕ):ℝ) by norm_num, Real.rpow_natCast]; norm_num,
          ← Real.rpow_mul (by norm_num)]
        norm_num
      rw [← h1024]
      exact Real.rpow_le_rpow (by norm_num) hY (by norm_num)
    have h3 : (1:ℝ) ≤ Y ^ (3/10 + 1/2 : ℝ) := Real.one_le_rpow (by linarith) (by norm_num)
    rw [h1]
    nlinarith
  by_contra hlt
  push_neg at hlt
  have hn : (n:ℝ) = (((l.filter (fun x => !p x)).prod : ℕ) : ℝ) * (((l.filter p).prod : ℕ) : ℝ) := by
    rw [← Nat.cast_mul, mul_comm, hsplit]
  have hle : (n:ℝ) ≤ Y ^ (3/10 : ℝ) * Real.sqrt Y := by
    rw [hn]
    calc (((l.filter (fun x => !p x)).prod : ℕ) : ℝ) * (((l.filter p).prod : ℕ) : ℝ)
        ≤ Y ^ (3/10 : ℝ) * (((l.filter p).prod : ℕ) : ℝ) :=
          mul_le_mul_of_nonneg_right (hLo.trans hpow) (Nat.cast_nonneg _)
      _ ≤ Y ^ (3/10 : ℝ) * Real.sqrt Y :=
          mul_le_mul_of_nonneg_left hlt.le (Real.rpow_nonneg hY0.le _)
  push_cast at htop
  linarith

theorem threeForm_count_error : ∀ (a b N d : ℕ), a < b → Squarefree d →
    Nat.Coprime d (6 * a * b * (b - a)) →
    |(((Finset.range N).filter (fun n => d ∣ n * (a * n + 1) * (b * n + 1))).card : ℝ) -
        (∏ p ∈ d.primeFactors, (3 : ℝ) / p) * N| ≤
      (3 : ℝ) ^ ArithmeticFunction.cardDistinctFactors d :=
by
  intro a b N d hab hd hcop
  have hd0 : 0 < d := Nat.pos_of_ne_zero hd.ne_zero
  
  have hdiv : ∀ (k x : ℕ), k ∣ x * (a * x + 1) * (b * x + 1) ↔
      (x : ZMod k) * ((a : ZMod k) * (x : ZMod k) + 1) * ((b : ZMod k) * (x : ZMod k) + 1) = 0 := by
    intro k x
    rw [← ZMod.natCast_eq_zero_iff]
    simp only [Nat.cast_mul, Nat.cast_add, Nat.cast_one]
  
  have hzmod : ∀ (k : ℕ) [NeZero k],
      ((Finset.range k).filter (fun x => k ∣ x * (a * x + 1) * (b * x + 1))).card =
        ((Finset.univ : Finset (ZMod k)).filter
          (fun t => t * ((a : ZMod k) * t + 1) * ((b : ZMod k) * t + 1) = 0)).card := by
    intro k _
    have heq : ((Finset.univ : Finset (ZMod k)).filter
        (fun t => t * ((a : ZMod k) * t + 1) * ((b : ZMod k) * t + 1) = 0)).image ZMod.val =
        (Finset.range k).filter (fun x => k ∣ x * (a * x + 1) * (b * x + 1)) := by
      ext n
      constructor
      · intro hn
        obtain ⟨t, ht, rfl⟩ := Finset.mem_image.mp hn
        apply Finset.mem_filter.mpr
        refine ⟨Finset.mem_range.mpr (ZMod.val_lt t), ?_⟩
        apply (hdiv k t.val).mpr
        simpa only [ZMod.natCast_zmod_val] using (Finset.mem_filter.mp ht).2
      · intro hn
        obtain ⟨hnlt, hn⟩ := Finset.mem_filter.mp hn
        refine Finset.mem_image.mpr ⟨(n : ZMod k), ?_, ?_⟩
        · exact Finset.mem_filter.mpr ⟨Finset.mem_univ _, (hdiv k n).mp hn⟩
        · exact ZMod.val_natCast_of_lt (Finset.mem_range.mp hnlt)
    rw [← heq, Finset.card_image_of_injective _ (ZMod.val_injective k)]
  
  have hprime : ∀ p : ℕ, p.Prime → ¬ p ∣ a → ¬ p ∣ b → ¬ p ∣ (b - a) →
      ((Finset.range p).filter (fun x => p ∣ x * (a * x + 1) * (b * x + 1))).card = 3 := by
    intro p hp hpa hpb hpba
    haveI : Fact p.Prime := ⟨hp⟩
    rw [hzmod p]
    have hA : (a : ZMod p) ≠ 0 := fun h => hpa ((ZMod.natCast_eq_zero_iff a p).mp h)
    have hB : (b : ZMod p) ≠ 0 := fun h => hpb ((ZMod.natCast_eq_zero_iff b p).mp h)
    have hAB : (a : ZMod p) ≠ (b : ZMod p) := by
      intro h
      apply hpba
      rw [← ZMod.natCast_eq_zero_iff, Nat.cast_sub hab.le, h, sub_self]
    have key : ∀ (X t : ZMod p), X ≠ 0 → (X * t + 1 = 0 ↔ t = -X⁻¹) := by
      intro X t hX
      constructor
      · intro h
        apply mul_left_cancel₀ hX
        calc X * t = -1 := eq_neg_of_add_eq_zero_left h
          _ = X * -X⁻¹ := by simp [hX]
      · rintro rfl
        simp [hX]
    have hset : (Finset.univ : Finset (ZMod p)).filter
        (fun t => t * ((a : ZMod p) * t + 1) * ((b : ZMod p) * t + 1) = 0) =
          {0, -(a : ZMod p)⁻¹, -(b : ZMod p)⁻¹} := by
      ext t
      simp only [Finset.mem_filter, Finset.mem_univ, true_and, Finset.mem_insert,
        Finset.mem_singleton, mul_eq_zero]
      rw [key _ t hA, key _ t hB, or_assoc]
    have h0A : (0 : ZMod p) ≠ -(a : ZMod p)⁻¹ :=
      fun h => inv_ne_zero hA (neg_eq_zero.mp h.symm)
    have h0B : (0 : ZMod p) ≠ -(b : ZMod p)⁻¹ :=
      fun h => inv_ne_zero hB (neg_eq_zero.mp h.symm)
    have hAB' : -(a : ZMod p)⁻¹ ≠ -(b : ZMod p)⁻¹ := by
      intro h
      exact hAB (inv_inj.mp (neg_inj.mp h))
    have hnot : (0 : ZMod p) ∉ ({-(a : ZMod p)⁻¹, -(b : ZMod p)⁻¹} : Finset (ZMod p)) := by
      simp only [Finset.mem_insert, Finset.mem_singleton, not_or]
      exact ⟨h0A, h0B⟩
    rw [hset, Finset.card_insert_of_notMem hnot, Finset.card_pair hAB']
  
  have hcardk : ∀ (k : ℕ) [NeZero k],
      Nat.card {t : ZMod k // t * ((a : ZMod k) * t + 1) * ((b : ZMod k) * t + 1) = 0} =
        ((Finset.range k).filter (fun x => k ∣ x * (a * x + 1) * (b * x + 1))).card := by
    intro k _
    rw [Nat.card_eq_fintype_card, Fintype.card_subtype, hzmod]
  have hmul : ∀ m n : ℕ, 0 < m → 0 < n → m.Coprime n →
      ((Finset.range (m * n)).filter (fun x => m * n ∣ x * (a * x + 1) * (b * x + 1))).card =
        ((Finset.range m).filter (fun x => m ∣ x * (a * x + 1) * (b * x + 1))).card *
          ((Finset.range n).filter (fun x => n ∣ x * (a * x + 1) * (b * x + 1))).card := by
    intro m n hm hn hcop
    haveI : NeZero m := ⟨hm.ne'⟩
    haveI : NeZero n := ⟨hn.ne'⟩
    haveI : NeZero (m * n) := ⟨(Nat.mul_pos hm hn).ne'⟩
    let e := ZMod.chineseRemainder hcop
    have hmap : ∀ t : ZMod (m * n),
        t * ((a : ZMod (m * n)) * t + 1) * ((b : ZMod (m * n)) * t + 1) = 0 ↔
        (e t).1 * ((a : ZMod m) * (e t).1 + 1) * ((b : ZMod m) * (e t).1 + 1) = 0 ∧
        (e t).2 * ((a : ZMod n) * (e t).2 + 1) * ((b : ZMod n) * (e t).2 + 1) = 0 := by
      intro t
      constructor
      · intro ht
        have h := congrArg e ht
        simp only [map_mul, map_add, map_natCast, map_one, map_zero] at h
        exact ⟨congrArg (fun x : ZMod m × ZMod n => x.1) h,
          congrArg (fun x : ZMod m × ZMod n => x.2) h⟩
      · rintro ⟨h1, h2⟩
        apply e.injective
        simp only [map_mul, map_add, map_natCast, map_one, map_zero]
        exact Prod.ext h1 h2
    let E : {t : ZMod (m * n) // t * ((a : ZMod (m * n)) * t + 1) * ((b : ZMod (m * n)) * t + 1) = 0} ≃
        {t : ZMod m // t * ((a : ZMod m) * t + 1) * ((b : ZMod m) * t + 1) = 0} ×
        {t : ZMod n // t * ((a : ZMod n) * t + 1) * ((b : ZMod n) * t + 1) = 0} :=
      (e.toEquiv.subtypeEquiv hmap).trans
        (Equiv.subtypeProdEquivProd
          (p := fun t : ZMod m => t * ((a : ZMod m) * t + 1) * ((b : ZMod m) * t + 1) = 0)
          (q := fun t : ZMod n => t * ((a : ZMod n) * t + 1) * ((b : ZMod n) * t + 1) = 0))
    rw [← hcardk (m * n), ← hcardk m, ← hcardk n, ← Nat.card_prod]
    exact Nat.card_congr E
  
  let ρ : ArithmeticFunction ℕ :=
    ⟨fun k => ((Finset.range k).filter (fun x => k ∣ x * (a * x + 1) * (b * x + 1))).card, by simp⟩
  have hρ : ∀ k, ρ k = ((Finset.range k).filter (fun x => k ∣ x * (a * x + 1) * (b * x + 1))).card :=
    fun k => rfl
  have hρmult : ρ.IsMultiplicative := by
    refine ⟨?_, ?_⟩
    · rw [hρ]
      simp
    · intro m n hcop
      rw [hρ, hρ, hρ]
      rcases Nat.eq_zero_or_pos m with rfl | hm
      · simp
      rcases Nat.eq_zero_or_pos n with rfl | hn
      · simp
      exact hmul m n hm hn hcop
  have hρd : ((Finset.range d).filter (fun x => d ∣ x * (a * x + 1) * (b * x + 1))).card =
      ∏ p ∈ d.primeFactors, (3 : ℕ) := by
    rw [← hρ d, ← hρmult.prod_primeFactors hd]
    refine Finset.prod_congr rfl (fun p hp => ?_)
    have hpp := Nat.prime_of_mem_primeFactors hp
    have hpd := Nat.dvd_of_mem_primeFactors hp
    have hnd : ¬ p ∣ 6 * a * b * (b - a) :=
      (Nat.Prime.coprime_iff_not_dvd hpp).mp (Nat.Coprime.coprime_dvd_left hpd hcop)
    refine hprime p hpp ?_ ?_ ?_
    · intro h
      exact hnd (((h.mul_left 6).mul_right b).mul_right (b - a))
    · intro h
      exact hnd ((h.mul_left (6 * a)).mul_right (b - a))
    · intro h
      exact hnd (h.mul_left (6 * a * b))
  have hdc : (d : ℝ) = ∏ p ∈ d.primeFactors, (p : ℝ) := by
    rw [← Nat.cast_prod, Nat.prod_primeFactors_of_squarefree hd]
  have hcoef : (((Finset.range d).filter (fun x => d ∣ x * (a * x + 1) * (b * x + 1))).card : ℝ) / d =
      ∏ p ∈ d.primeFactors, (3 : ℝ) / p := by
    rw [Finset.prod_div_distrib, hρd, hdc]
    push_cast
    rfl
  have hle : (((Finset.range d).filter (fun x => d ∣ x * (a * x + 1) * (b * x + 1))).card : ℝ) ≤
      (3 : ℝ) ^ ArithmeticFunction.cardDistinctFactors d := by
    have h1 : ((Finset.range d).filter (fun x => d ∣ x * (a * x + 1) * (b * x + 1))).card ≤
        3 ^ ArithmeticFunction.cardDistinctFactors d := by
      rw [hρd]
      have hcard : d.primeFactors.card = ArithmeticFunction.cardDistinctFactors d := by
        rw [ArithmeticFunction.cardDistinctFactors_apply, ← Nat.toFinset_factors,
          List.card_toFinset]
      rw [← hcard, Finset.prod_const]
    exact_mod_cast h1
  
  have hcount_err : ∀ (P : ℕ → Prop) [DecidablePred P], Function.Periodic P d → ∀ M : ℕ,
      |(Nat.count P M : ℝ) - (Nat.count P d : ℝ) / d * M| ≤ Nat.count P d := by
    intro P _ hP M
    have hmulc : ∀ k : ℕ, Nat.count P (k * d) = k * Nat.count P d := by
      intro k
      induction k with
      | zero => simp
      | succ k ih =>
        have hshift : (fun n => P (n + k * d)) = P := funext (hP.nat_mul k)
        simp only [Nat.succ_mul, Nat.add_comm (k * d) d, Nat.count_add', hshift, ih]
        omega
    have hdm : Nat.count P M = (M / d) * Nat.count P d + Nat.count P (M % d) := by
      have hshift : (fun n => P (n + (M / d) * d)) = P := funext (hP.nat_mul (M / d))
      calc
        _ = Nat.count P (M % d + (M / d) * d) := by rw [Nat.mod_add_div']
        _ = _ := by simp only [Nat.count_add', hshift, hmulc]; omega
    have hdR : (0 : ℝ) < d := by exact_mod_cast hd0
    have hrem : (M % d : ℕ) ≤ d := (Nat.mod_lt M hd0).le
    have hremR : ((M % d : ℕ) : ℝ) ≤ d := by exact_mod_cast hrem
    have hcount : (Nat.count P (M % d) : ℝ) ≤ Nat.count P d := by
      exact_mod_cast Nat.count_monotone P hrem
    have hterm : 0 ≤ (Nat.count P d : ℝ) / d * (M % d : ℕ) := by positivity
    have htermle : (Nat.count P d : ℝ) / d * (M % d : ℕ) ≤ Nat.count P d := by
      calc
        _ ≤ (Nat.count P d : ℝ) / d * d :=
          mul_le_mul_of_nonneg_left hremR (by positivity)
        _ = _ := div_mul_cancel₀ _ hdR.ne'
    have hN : (M : ℝ) = (M / d : ℕ) * (d : ℝ) + (M % d : ℕ) := by
      exact_mod_cast (by simpa only [Nat.mul_comm] using (Nat.div_add_mod M d).symm)
    have hdec : (Nat.count P M : ℝ) =
        (M / d : ℕ) * (Nat.count P d : ℝ) + (Nat.count P (M % d) : ℝ) := by
      exact_mod_cast hdm
    have heq : (Nat.count P M : ℝ) - (Nat.count P d : ℝ) / d * M =
        (Nat.count P (M % d) : ℝ) - (Nat.count P d : ℝ) / d * (M % d : ℕ) := by
      rw [hdec, hN]
      field_simp
      ring
    rw [heq, abs_le]
    constructor <;> linarith [Nat.cast_nonneg (Nat.count P (M % d)) (α := ℝ)]
  have hper : Function.Periodic (fun n => d ∣ n * (a * n + 1) * (b * n + 1)) d := by
    intro n
    apply propext
    show d ∣ (n + d) * (a * (n + d) + 1) * (b * (n + d) + 1) ↔ d ∣ n * (a * n + 1) * (b * n + 1)
    have h : (n + d) * (a * (n + d) + 1) * (b * (n + d) + 1) =
        d * (a * b * (3 * n ^ 2 + 3 * n * d + d ^ 2) + (a + b) * (2 * n + d) + 1) +
          n * (a * n + 1) * (b * n + 1) := by
      ring
    rw [h]
    exact Nat.dvd_add_right (dvd_mul_right d _)
  have herr := hcount_err (fun n => d ∣ n * (a * n + 1) * (b * n + 1)) hper N
  simp only [Nat.count_eq_card_filter_range] at herr
  rw [hcoef] at herr
  exact herr.trans hle

theorem threeFold_factorization_count_le : ∀ m : ℕ, 0 < m →
    ((m.divisors ×ˢ m.divisors ×ˢ m.divisors).filter
      (fun t : ℕ × ℕ × ℕ => t.1 * t.2.1 * t.2.2 = m)).card ≤ 3 ^ ArithmeticFunction.cardFactors m :=
by
  have step : ∀ p n : ℕ, p.Prime → 0 < n →
      (((p * n).divisors ×ˢ (p * n).divisors ×ˢ (p * n).divisors).filter
        (fun t : ℕ × ℕ × ℕ => t.1 * t.2.1 * t.2.2 = p * n)).card ≤
      3 * ((n.divisors ×ˢ n.divisors ×ˢ n.divisors).filter
        (fun t : ℕ × ℕ × ℕ => t.1 * t.2.1 * t.2.2 = n)).card := by
    intro p n hp hn
    set T := ((n.divisors ×ˢ n.divisors ×ˢ n.divisors).filter
        (fun t : ℕ × ℕ × ℕ => t.1 * t.2.1 * t.2.2 = n)) with hT
    have hp0 : 0 < p := hp.pos
    have hn0 : n ≠ 0 := hn.ne'
    have hmemT : ∀ a b c : ℕ, a * b * c = n → (a, b, c) ∈ T := by
      intro a b c h
      rw [hT, Finset.mem_filter]
      refine ⟨?_, h⟩
      simp only [Finset.mem_product, Nat.mem_divisors]
      exact ⟨⟨⟨b * c, by rw [← h]; ring⟩, hn0⟩, ⟨⟨a * c, by rw [← h]; ring⟩, hn0⟩,
        ⟨⟨a * b, by rw [← h]; ring⟩, hn0⟩⟩
    have hsub : ((p * n).divisors ×ˢ (p * n).divisors ×ˢ (p * n).divisors).filter
        (fun t : ℕ × ℕ × ℕ => t.1 * t.2.1 * t.2.2 = p * n) ⊆
        T.image (fun t : ℕ × ℕ × ℕ => (p * t.1, t.2.1, t.2.2)) ∪
          T.image (fun t : ℕ × ℕ × ℕ => (t.1, p * t.2.1, t.2.2)) ∪
          T.image (fun t : ℕ × ℕ × ℕ => (t.1, t.2.1, p * t.2.2)) := by
      rintro ⟨a, b, c⟩ h
      rw [Finset.mem_filter] at h
      have habc : a * b * c = p * n := h.2
      have hdvd : p ∣ a * b * c := ⟨n, habc⟩
      simp only [Finset.mem_union, Finset.mem_image]
      rcases (hp.dvd_mul.mp hdvd) with h1 | h3
      · rcases (hp.dvd_mul.mp h1) with ⟨a', rfl⟩ | ⟨b', rfl⟩
        · have : a' * b * c = n := by
            apply Nat.eq_of_mul_eq_mul_left hp0
            rw [← habc]; ring
          left; left
          exact ⟨(a', b, c), hmemT _ _ _ this, rfl⟩
        · have : a * b' * c = n := by
            apply Nat.eq_of_mul_eq_mul_left hp0
            rw [← habc]; ring
          left; right
          exact ⟨(a, b', c), hmemT _ _ _ this, rfl⟩
      · obtain ⟨c', rfl⟩ := h3
        have : a * b * c' = n := by
          apply Nat.eq_of_mul_eq_mul_left hp0
          rw [← habc]; ring
        right
        exact ⟨(a, b, c'), hmemT _ _ _ this, rfl⟩
    have i1 := Finset.card_image_le (s := T) (f := fun t : ℕ × ℕ × ℕ => (p * t.1, t.2.1, t.2.2))
    have i2 := Finset.card_image_le (s := T) (f := fun t : ℕ × ℕ × ℕ => (t.1, p * t.2.1, t.2.2))
    have i3 := Finset.card_image_le (s := T) (f := fun t : ℕ × ℕ × ℕ => (t.1, t.2.1, p * t.2.2))
    have u1 := Finset.card_union_le (T.image (fun t : ℕ × ℕ × ℕ => (p * t.1, t.2.1, t.2.2)))
      (T.image (fun t : ℕ × ℕ × ℕ => (t.1, p * t.2.1, t.2.2)))
    have u2 := Finset.card_union_le (T.image (fun t : ℕ × ℕ × ℕ => (p * t.1, t.2.1, t.2.2)) ∪
      T.image (fun t : ℕ × ℕ × ℕ => (t.1, p * t.2.1, t.2.2)))
      (T.image (fun t : ℕ × ℕ × ℕ => (t.1, t.2.1, p * t.2.2)))
    have hc := Finset.card_le_card hsub
    omega
  intro m
  induction m using Nat.strong_induction_on with
  | _ m ih =>
    intro hm
    by_cases h1 : m = 1
    · subst h1
      rw [Nat.divisors_one, ArithmeticFunction.cardFactors_one, pow_zero]
      exact (Finset.card_filter_le _ _).trans (by simp)
    · have hp := Nat.minFac_prime h1
      obtain ⟨n, hn⟩ := Nat.minFac_dvd m
      generalize m.minFac = p at hp hn
      have hnpos : 0 < n := by
        rcases Nat.eq_zero_or_pos n with h | h
        · subst h; simp at hn; omega
        · exact h
      have hnlt : n < m := by
        rw [hn]
        have := hp.two_le
        nlinarith
      have ihn := ih n hnlt hnpos
      subst hn
      have hΩ : ArithmeticFunction.cardFactors (p * n) = ArithmeticFunction.cardFactors n + 1 := by
        rw [ArithmeticFunction.cardFactors_mul hp.ne_zero hnpos.ne',
          ArithmeticFunction.cardFactors_apply_prime hp]
        ring
      rw [hΩ, pow_succ]
      calc _ ≤ 3 * _ := step p n hp hnpos
        _ ≤ 3 * 3 ^ ArithmeticFunction.cardFactors n := Nat.mul_le_mul_left 3 ihn
        _ = _ := by ring

theorem threeForm_density_sum_lower_bound (hT3 : ∀ m : ℕ, 0 < m →
      ((m.divisors ×ˢ m.divisors ×ˢ m.divisors).filter
        (fun t : ℕ × ℕ × ℕ => t.1 * t.2.1 * t.2.2 = m)).card ≤ 3 ^ ArithmeticFunction.cardFactors m) :
    ∀ (D M : ℕ),
      (∑ k ∈ (Finset.Icc 1 M).filter (fun k => k.Coprime D), (k : ℝ)⁻¹) ^ 3 ≤
        ∑ m ∈ Finset.Icc 1 (M ^ 3),
          ∏ p ∈ m.primeFactors, ((if p ∣ D then 0 else 3 : ℝ) / p) ^ m.factorization p :=
by
  intro D M
  
  have s1 : ∀ m : ℕ, 0 < m → m.Coprime D →
      ∏ p ∈ m.primeFactors, ((if p ∣ D then 0 else 3 : ℝ) / p) ^ m.factorization p =
        (3 : ℝ) ^ ArithmeticFunction.cardFactors m / m := by
    intro m hm hcop
    have hden : (∏ p ∈ m.primeFactors, (p : ℝ) ^ m.factorization p) = m := by
      have h := Nat.factorization_prod_pow_eq_self hm.ne'
      rw [Finsupp.prod, Nat.support_factorization] at h
      exact_mod_cast h
    have hnum : (∏ p ∈ m.primeFactors, (3 : ℝ) ^ m.factorization p) =
        (3 : ℝ) ^ ArithmeticFunction.cardFactors m := by
      rw [Finset.prod_pow_eq_pow_sum, ArithmeticFunction.cardFactors_eq_sum_factorization,
        Finsupp.sum, Nat.support_factorization]
    calc _ = ∏ p ∈ m.primeFactors,
          ((3 : ℝ) ^ m.factorization p / (p : ℝ) ^ m.factorization p) := by
          apply Finset.prod_congr rfl
          intro p hp
          have hpp := Nat.prime_of_mem_primeFactors hp
          have hpm := Nat.dvd_of_mem_primeFactors hp
          have hpD : ¬ p ∣ D := fun hpD => hpp.not_dvd_one (hcop ▸ Nat.dvd_gcd hpm hpD)
          rw [if_neg hpD, div_pow]
      _ = _ := by rw [Finset.prod_div_distrib, hden, hnum]
  
  let B := (Finset.Icc 1 M).filter (fun k => k.Coprime D)
  let C := (Finset.Icc 1 (M ^ 3)).filter (fun m => m.Coprime D)
  let S : ℕ → Finset (ℕ × ℕ × ℕ) := fun m =>
    (m.divisors ×ˢ m.divisors ×ˢ m.divisors).filter (fun t : ℕ × ℕ × ℕ => t.1 * t.2.1 * t.2.2 = m)
  let P := B ×ˢ B ×ˢ B
  let Q : Finset (Σ _ : ℕ, ℕ × ℕ × ℕ) := C.sigma S
  let f : ℕ × ℕ × ℕ → (Σ _ : ℕ, ℕ × ℕ × ℕ) := fun v => ⟨v.1 * v.2.1 * v.2.2, v⟩
  have hB : ∀ k ∈ B, 0 < k ∧ k ≤ M ∧ k.Coprime D := by
    intro k hk
    obtain ⟨hk1, hc⟩ := Finset.mem_filter.mp hk
    exact ⟨(Finset.mem_Icc.mp hk1).1, (Finset.mem_Icc.mp hk1).2, hc⟩
  have hsub : P.image f ⊆ Q := by
    intro x hx
    obtain ⟨v, hv, rfl⟩ := Finset.mem_image.mp hx
    obtain ⟨ha, hbc⟩ := Finset.mem_product.mp hv
    obtain ⟨hb, hc⟩ := Finset.mem_product.mp hbc
    obtain ⟨ha1, ha2, ha3⟩ := hB _ ha
    obtain ⟨hb1, hb2, hb3⟩ := hB _ hb
    obtain ⟨hc1, hc2, hc3⟩ := hB _ hc
    have hpos : 0 < v.1 * v.2.1 * v.2.2 := Nat.mul_pos (Nat.mul_pos ha1 hb1) hc1
    apply Finset.mem_sigma.mpr
    refine ⟨Finset.mem_filter.mpr ⟨Finset.mem_Icc.mpr ⟨hpos, ?_⟩,
      Nat.Coprime.mul (Nat.Coprime.mul ha3 hb3) hc3⟩, ?_⟩
    · calc v.1 * v.2.1 * v.2.2 ≤ M * M * M := Nat.mul_le_mul (Nat.mul_le_mul ha2 hb2) hc2
        _ = M ^ 3 := by ring
    · refine Finset.mem_filter.mpr ⟨?_, rfl⟩
      exact Finset.mem_product.mpr
        ⟨Nat.mem_divisors.mpr ⟨dvd_mul_of_dvd_left (dvd_mul_right _ _) _, hpos.ne'⟩,
          Finset.mem_product.mpr
            ⟨Nat.mem_divisors.mpr ⟨dvd_mul_of_dvd_left (dvd_mul_left _ _) _, hpos.ne'⟩,
              Nat.mem_divisors.mpr ⟨dvd_mul_left _ _, hpos.ne'⟩⟩⟩
  have hinj : Set.InjOn f (P : Set (ℕ × ℕ × ℕ)) := by
    intro v _ w _ heq
    exact congrArg (fun x : Σ _ : ℕ, ℕ × ℕ × ℕ => x.2) heq
  have hexp : (∑ k ∈ B, (k : ℝ)⁻¹) ^ 3 = ∑ v ∈ P, ((v.1 * v.2.1 * v.2.2 : ℕ) : ℝ)⁻¹ := by
    rw [pow_three, Finset.sum_mul_sum, Finset.sum_mul_sum]
    simp only [P, Finset.sum_product]
    apply Finset.sum_congr rfl
    intro a _
    apply Finset.sum_congr rfl
    intro b _
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro c _
    push_cast
    rw [mul_inv, mul_inv]
    ring
  have hmid : (∑ k ∈ B, (k : ℝ)⁻¹) ^ 3 ≤ ∑ m ∈ C, ((S m).card : ℝ) / m := by
    calc _ = ∑ v ∈ P, ((v.1 * v.2.1 * v.2.2 : ℕ) : ℝ)⁻¹ := hexp
      _ = ∑ x ∈ P.image f, (x.1 : ℝ)⁻¹ :=
        (Finset.sum_image (f := fun x : Σ _ : ℕ, ℕ × ℕ × ℕ => (x.1 : ℝ)⁻¹) hinj).symm
      _ ≤ ∑ x ∈ Q, (x.1 : ℝ)⁻¹ := by
        apply Finset.sum_le_sum_of_subset_of_nonneg hsub
        intro x _ _
        positivity
      _ = ∑ m ∈ C, ∑ t ∈ S m, (m : ℝ)⁻¹ :=
        Finset.sum_sigma _ _ (fun x : Σ _ : ℕ, ℕ × ℕ × ℕ => (x.1 : ℝ)⁻¹)
      _ = _ := by simp only [Finset.sum_const, nsmul_eq_mul, div_eq_mul_inv]
  
  calc _ ≤ ∑ m ∈ C, ((S m).card : ℝ) / m := hmid
    _ ≤ ∑ m ∈ C, (3 : ℝ) ^ ArithmeticFunction.cardFactors m / m := by
      apply Finset.sum_le_sum
      intro m hm
      have hm0 : 0 < m := (Finset.mem_Icc.mp (Finset.mem_filter.mp hm).1).1
      have h := hT3 m hm0
      have h' : ((S m).card : ℝ) ≤ (3 : ℝ) ^ ArithmeticFunction.cardFactors m := by
        exact_mod_cast h
      exact div_le_div_of_nonneg_right h' (Nat.cast_nonneg m)
    _ = ∑ m ∈ C, ∏ p ∈ m.primeFactors,
          ((if p ∣ D then 0 else 3 : ℝ) / p) ^ m.factorization p := by
      apply Finset.sum_congr rfl
      intro m hm
      obtain ⟨hm1, hc⟩ := Finset.mem_filter.mp hm
      exact (s1 m (Finset.mem_Icc.mp hm1).1 hc).symm
    _ ≤ _ := by
      apply Finset.sum_le_sum_of_subset_of_nonneg (Finset.filter_subset _ _)
      intro m _ _
      apply Finset.prod_nonneg
      intro p _
      apply pow_nonneg
      apply div_nonneg _ (Nat.cast_nonneg p)
      split_ifs <;> norm_num

theorem threeForm_sifted_count_of_ingredients : (∀ s : SelbergSieve,
      BoundingSieve.siftedSum (s := s.toBoundingSieve) ≤
        s.totalMass / (∑ l ∈ s.prodPrimes.divisors,
            if (l : ℝ) ^ 2 ≤ s.level then s.nu l * ∏ p ∈ l.primeFactors, 1 / (1 - s.nu p) else 0) +
          ∑ d ∈ s.prodPrimes.divisors,
            if (d : ℝ) ≤ s.level then
              (3 : ℝ) ^ ArithmeticFunction.cardDistinctFactors d *
                |BoundingSieve.rem (s := s.toBoundingSieve) d|
            else 0) →
    (∀ (g : ℕ → ℝ) (P : ℕ) (y : ℝ), 1 ≤ y → Squarefree P →
      (∀ p : ℕ, p.Prime → (p : ℝ) ≤ y → p ∣ P) →
      (∀ p : ℕ, p.Prime → 0 ≤ g p ∧ g p < 1) →
      (∑ m ∈ Finset.Icc 1 ⌊Real.sqrt y⌋₊, ∏ p ∈ m.primeFactors, g p ^ m.factorization p) ≤
        ∑ l ∈ P.divisors, if (l : ℝ) ^ 2 ≤ y then ∏ p ∈ l.primeFactors, g p / (1 - g p) else 0) →
    (∀ (b M : ℕ), 0 < b →
      (b.totient : ℝ) / b * (∑ k ∈ Finset.Icc 1 M, (k : ℝ)⁻¹) ≤
        ∑ k ∈ (Finset.Icc 1 M).filter (fun k => k.Coprime b), (k : ℝ)⁻¹) →
    (∀ (D M : ℕ),
      (∑ k ∈ (Finset.Icc 1 M).filter (fun k => k.Coprime D), (k : ℝ)⁻¹) ^ 3 ≤
        ∑ m ∈ Finset.Icc 1 (M ^ 3),
          ∏ p ∈ m.primeFactors, ((if p ∣ D then 0 else 3 : ℝ) / p) ^ m.factorization p) →
    (∀ (P k : ℕ) (x : ℝ), 1 ≤ x → Squarefree P →
      (∑ d ∈ P.divisors, if (d : ℝ) ≤ x then (k : ℝ) ^ ArithmeticFunction.cardDistinctFactors d else 0) ≤
        x * (1 + Real.log x) ^ k) →
    (∀ (a b N d : ℕ), a < b → Squarefree d →
      Nat.Coprime d (6 * a * b * (b - a)) →
      |(((Finset.range N).filter (fun n => d ∣ n * (a * n + 1) * (b * n + 1))).card : ℝ) -
          (∏ p ∈ d.primeFactors, (3 : ℝ) / p) * N| ≤
        (3 : ℝ) ^ ArithmeticFunction.cardDistinctFactors d) →
    ∀ (a b N : ℕ) (L : ℝ), 0 < a → a < b → 1 < L →
      (((Finset.range N).filter (fun n => ∀ p : ℕ, p.Prime → (p : ℝ) ≤ L →
          ¬ p ∣ 6 * a * b * (b - a) → ¬ p ∣ n * (a * n + 1) * (b * n + 1))).card : ℝ) ≤
        216 * (((6 * a * b * (b - a) : ℕ) : ℝ) / (6 * a * b * (b - a)).totient) ^ 3 * N /
            Real.log L ^ 3 + L * (1 + Real.log L) ^ 9 :=
by
  intro hS hMULT hCOP hDENS hΩ hREM a b N L ha hab hL
  have hL0 : (0 : ℝ) ≤ L := by linarith
  have hL1' : (1 : ℝ) ≤ L := hL.le
  have hlog0 : 0 < Real.log L := Real.log_pos hL
  have hb0 : 0 < b := lt_trans ha hab
  have hba : 0 < b - a := Nat.sub_pos_of_lt hab
  set D : ℕ := 6 * a * b * (b - a) with hD
  have hDpos : 0 < D := by
    rw [hD]
    exact Nat.mul_pos (Nat.mul_pos (Nat.mul_pos (by norm_num) ha) hb0) hba
  have h6D : 6 ∣ D := by
    rw [hD]
    exact Dvd.dvd.mul_right (Dvd.dvd.mul_right (dvd_mul_right 6 a) b) (b - a)
  have h4 : ∀ p : ℕ, p.Prime → ¬ p ∣ D → 4 ≤ p := by
    intro p hp hpD
    by_contra hlt
    push_neg at hlt
    have h2 := hp.two_le
    interval_cases p
    · exact hpD ((by norm_num : 2 ∣ 6).trans h6D)
    · exact hpD ((by norm_num : 3 ∣ 6).trans h6D)
  have hDR : (0 : ℝ) < D := by exact_mod_cast hDpos
  have hφR : (0 : ℝ) < D.totient := by exact_mod_cast Nat.totient_pos.mpr hDpos
  have hcoef : 0 ≤ (D.totient : ℝ) / D := by positivity
  have hq : 0 < (D.totient : ℝ) / D := div_pos hφR hDR
  
  obtain ⟨Sb, hSb⟩ : ∃ Sb : Finset ℕ,
      Sb = (Finset.range (⌊L⌋₊ + 1)).filter (fun p => p.Prime ∧ ¬ p ∣ D) := ⟨_, rfl⟩
  have hmemSb : ∀ p, p ∈ Sb ↔ p ≤ ⌊L⌋₊ ∧ p.Prime ∧ ¬ p ∣ D := by
    intro p
    rw [hSb, Finset.mem_filter, Finset.mem_range]
    constructor
    · rintro ⟨h1, h2, h3⟩
      exact ⟨by omega, h2, h3⟩
    · rintro ⟨h1, h2, h3⟩
      exact ⟨by omega, h2, h3⟩
  obtain ⟨Q, hQ⟩ : ∃ Q : ℕ, Q = ∏ p ∈ Sb, p := ⟨_, rfl⟩
  have hsqprod : ∀ T : Finset ℕ, (∀ q ∈ T, q.Prime) → Squarefree (∏ q ∈ T, q) := by
    intro T
    refine Finset.induction_on T ?_ ?_
    · intro _
      simp
    · intro a T ha ih hT
      rw [Finset.prod_insert ha, Nat.squarefree_mul_iff]
      have haP : a.Prime := hT a (Finset.mem_insert_self a T)
      refine ⟨?_, haP.prime.squarefree, ih (fun q hq => hT q (Finset.mem_insert_of_mem hq))⟩
      apply Nat.Coprime.prod_right
      intro q hq
      have hqP : q.Prime := hT q (Finset.mem_insert_of_mem hq)
      exact (Nat.coprime_primes haP hqP).mpr (fun h => ha (h ▸ hq))
  have hprim_dvd : ∀ p : ℕ, p.Prime → (p ∣ primorial ⌊L⌋₊ ↔ (p : ℝ) ≤ L) := by
    intro p hp
    rw [← Nat.le_floor_iff hL0]
    unfold primorial
    constructor
    · intro h
      obtain ⟨q, hq, hpq⟩ := (Prime.dvd_finset_prod_iff hp.prime _).mp h
      rw [Finset.mem_filter, Finset.mem_range] at hq
      have := (Nat.prime_dvd_prime_iff_eq hp hq.2).mp hpq
      omega
    · intro h
      exact Finset.dvd_prod_of_mem _
        (Finset.mem_filter.mpr ⟨Finset.mem_range.mpr (by omega), hp⟩)
  have hQ_dvd : ∀ p : ℕ, p.Prime → (p ∣ Q ↔ (p : ℝ) ≤ L ∧ ¬ p ∣ D) := by
    intro p hp
    rw [← Nat.le_floor_iff hL0]
    constructor
    · intro h
      rw [hQ] at h
      obtain ⟨q, hq, hpq⟩ := (Prime.dvd_finset_prod_iff hp.prime _).mp h
      rw [hmemSb] at hq
      have := (Nat.prime_dvd_prime_iff_eq hp hq.2.1).mp hpq
      subst this
      exact ⟨hq.1, hq.2.2⟩
    · rintro ⟨h1, h2⟩
      rw [hQ]
      exact Finset.dvd_prod_of_mem _ ((hmemSb p).mpr ⟨h1, hp, h2⟩)
  have hQsq : Squarefree Q := by
    rw [hQ]
    exact hsqprod _ (fun q hq => ((hmemSb q).mp hq).2.1)
  have hPsq : Squarefree (primorial ⌊L⌋₊) := by
    unfold primorial
    exact hsqprod _ (fun q hq => (Finset.mem_filter.mp hq).2)
  have hPy : ∀ p : ℕ, p.Prime → (p : ℝ) ≤ L → p ∣ primorial ⌊L⌋₊ :=
    fun p hp hpL => (hprim_dvd p hp).mpr hpL
  
  set g₀ : ℕ → ℝ := fun p => 3 / (p : ℝ) with hg₀
  set g' : ℕ → ℝ := fun p => (if p ∣ D then 0 else 3 : ℝ) / p with hg'
  have hg₀Q : ∀ p : ℕ, p.Prime → p ∣ Q → 0 < g₀ p ∧ g₀ p < 1 := by
    intro p hp hpQ
    have hpD := ((hQ_dvd p hp).mp hpQ).2
    have hp4 : (4 : ℝ) ≤ p := by exact_mod_cast h4 p hp hpD
    simp only [hg₀]
    refine ⟨by positivity, ?_⟩
    rw [div_lt_one (by linarith)]
    linarith
  have hg'p : ∀ p : ℕ, p.Prime → 0 ≤ g' p ∧ g' p < 1 := by
    intro p hp
    simp only [hg']
    by_cases hpD : p ∣ D
    · rw [if_pos hpD, zero_div]
      exact ⟨le_rfl, one_pos⟩
    · rw [if_neg hpD]
      have hp4 : (4 : ℝ) ≤ p := by exact_mod_cast h4 p hp hpD
      refine ⟨by positivity, ?_⟩
      rw [div_lt_one (by linarith)]
      linarith
  have hnup : ∀ p : ℕ, p.Prime → ArithmeticFunction.prodPrimeFactors g₀ p = g₀ p := by
    intro p hp
    rw [ArithmeticFunction.prodPrimeFactors_apply hp.ne_zero, hp.primeFactors,
      Finset.prod_singleton]
  
  obtain ⟨s, hsupp, hprod, hw, htot, hnu, hlev⟩ : ∃ s : SelbergSieve,
      s.support = (Finset.range N).image (fun n => n * (a * n + 1) * (b * n + 1)) ∧
      s.prodPrimes = Q ∧ s.weights = (fun _ => (1 : ℝ)) ∧
      s.totalMass = (N : ℝ) ∧ s.nu = ArithmeticFunction.prodPrimeFactors g₀ ∧ s.level = L :=
    ⟨{ support := (Finset.range N).image (fun n => n * (a * n + 1) * (b * n + 1))
       prodPrimes := Q
       prodPrimes_squarefree := hQsq
       weights := fun _ => 1
       weights_nonneg := fun _ => zero_le_one
       totalMass := N
       nu := ArithmeticFunction.prodPrimeFactors g₀
       nu_mult := ArithmeticFunction.IsMultiplicative.prodPrimeFactors g₀
       nu_pos_of_prime := fun p hp hpQ => by rw [hnup p hp]; exact (hg₀Q p hp hpQ).1
       nu_lt_one_of_prime := fun p hp hpQ => by rw [hnup p hp]; exact (hg₀Q p hp hpQ).2
       level := L
       one_le_level := hL1' }, rfl, rfl, rfl, rfl, rfl, rfl⟩
  have hinj : Set.InjOn (fun n : ℕ => n * (a * n + 1) * (b * n + 1)) ↑(Finset.range N) := by
    have hmono : StrictMono (fun n : ℕ => n * (a * n + 1) * (b * n + 1)) := by
      intro m n hmn
      show m * (a * m + 1) * (b * m + 1) < n * (a * n + 1) * (b * n + 1)
      have h1 : m * (a * m + 1) < n * (a * n + 1) :=
        calc
          _ < n * (a * m + 1) := Nat.mul_lt_mul_of_pos_right hmn (by omega)
          _ ≤ _ := Nat.mul_le_mul_left n (Nat.add_le_add_right (Nat.mul_le_mul_left a hmn.le) 1)
      calc
        _ < n * (a * n + 1) * (b * m + 1) := Nat.mul_lt_mul_of_pos_right h1 (by omega)
        _ ≤ _ := Nat.mul_le_mul_left _ (Nat.add_le_add_right (Nat.mul_le_mul_left b hmn.le) 1)
    exact fun x _ y _ h => hmono.injective h
  
  have hsift : BoundingSieve.siftedSum (s := s.toBoundingSieve) =
      (((Finset.range N).filter (fun n => ∀ p : ℕ, p.Prime → (p : ℝ) ≤ L →
          ¬ p ∣ D → ¬ p ∣ n * (a * n + 1) * (b * n + 1))).card : ℝ) := by
    rw [BoundingSieve.siftedSum, hsupp, hprod, hw, Finset.sum_image hinj, Finset.sum_boole]
    congr 2
    apply Finset.filter_congr
    intro n _
    constructor
    · intro h p hp hpL hpD hpn
      have := Nat.Coprime.coprime_dvd_left ((hQ_dvd p hp).mpr ⟨hpL, hpD⟩) h
      exact (Nat.Prime.coprime_iff_not_dvd hp).mp this hpn
    · intro h
      apply Nat.coprime_of_dvd
      intro k hk hkQ hkn
      obtain ⟨h1, h2⟩ := (hQ_dvd k hk).mp hkQ
      exact h k hk h1 h2 hkn
  
  have hrem : ∀ d ∈ Q.divisors, |BoundingSieve.rem (s := s.toBoundingSieve) d| ≤
      (3 : ℝ) ^ ArithmeticFunction.cardDistinctFactors d := by
    intro d hd
    have hdQ : d ∣ Q := Nat.dvd_of_mem_divisors hd
    have hdsq : Squarefree d := Squarefree.squarefree_of_dvd hdQ hQsq
    have hcopD : Nat.Coprime d D :=
      Nat.coprime_of_dvd (fun k hk hkd hkD => ((hQ_dvd k hk).mp (hkd.trans hdQ)).2 hkD)
    have hmult : BoundingSieve.multSum (s := s.toBoundingSieve) d =
        (((Finset.range N).filter (fun n => d ∣ n * (a * n + 1) * (b * n + 1))).card : ℝ) := by
      rw [BoundingSieve.multSum, hsupp, hw, Finset.sum_image hinj, Finset.sum_boole]
    rw [BoundingSieve.rem, hmult, hnu, htot,
      ArithmeticFunction.prodPrimeFactors_apply hdsq.ne_zero]
    exact hREM a b N d hab hdsq hcopD
  
  have herr : (∑ d ∈ Q.divisors,
      if (d : ℝ) ≤ L then
        (3 : ℝ) ^ ArithmeticFunction.cardDistinctFactors d *
          |BoundingSieve.rem (s := s.toBoundingSieve) d|
      else 0) ≤ L * (1 + Real.log L) ^ 9 := by
    calc
      _ ≤ ∑ d ∈ Q.divisors, if (d : ℝ) ≤ L then
          ((9 : ℕ) : ℝ) ^ ArithmeticFunction.cardDistinctFactors d else 0 := by
        apply Finset.sum_le_sum
        intro d hd
        split_ifs with hdy
        · calc
            _ ≤ (3 : ℝ) ^ ArithmeticFunction.cardDistinctFactors d *
                (3 : ℝ) ^ ArithmeticFunction.cardDistinctFactors d :=
              mul_le_mul_of_nonneg_left (hrem d hd) (by positivity)
            _ = _ := by rw [← mul_pow]; norm_num
        · rfl
      _ ≤ _ := hΩ Q 9 L hL1' hQsq
  
  have hGeq : (∑ l ∈ Q.divisors,
      if (l : ℝ) ^ 2 ≤ L then ArithmeticFunction.prodPrimeFactors g₀ l *
        ∏ p ∈ l.primeFactors, 1 / (1 - ArithmeticFunction.prodPrimeFactors g₀ p) else 0) =
      ∑ l ∈ Q.divisors,
        if (l : ℝ) ^ 2 ≤ L then ∏ p ∈ l.primeFactors, g₀ p / (1 - g₀ p) else 0 := by
    apply Finset.sum_congr rfl
    intro l hl
    have hl0 : l ≠ 0 := Nat.ne_of_gt (Nat.pos_of_mem_divisors hl)
    split_ifs
    · rw [ArithmeticFunction.prodPrimeFactors_apply hl0, ← Finset.prod_mul_distrib]
      apply Finset.prod_congr rfl
      intro p hp
      rw [hnup p (Nat.prime_of_mem_primeFactors hp), mul_one_div]
    · rfl
  
  have hs3 : (∑ l ∈ (primorial ⌊L⌋₊).divisors,
      if (l : ℝ) ^ 2 ≤ L then ∏ p ∈ l.primeFactors, g' p / (1 - g' p) else 0) =
      ∑ l ∈ Q.divisors, if (l : ℝ) ^ 2 ≤ L then ∏ p ∈ l.primeFactors, g₀ p / (1 - g₀ p) else 0 := by
    have hQP : Q ∣ primorial ⌊L⌋₊ := by
      rw [hQ]
      unfold primorial
      apply Finset.prod_dvd_prod_of_subset
      intro p hp
      rw [hmemSb] at hp
      rw [Finset.mem_filter, Finset.mem_range]
      exact ⟨by omega, hp.2.1⟩
    have hP0 : primorial ⌊L⌋₊ ≠ 0 := hPsq.ne_zero
    have hQ0 : Q ≠ 0 := hQsq.ne_zero
    refine (Finset.sum_subset (Nat.divisors_subset_of_dvd hP0 hQP) ?_).symm.trans ?_
    · intro l hlP hlQ
      have hldvd := Nat.dvd_of_mem_divisors hlP
      have hlsq : Squarefree l := Squarefree.squarefree_of_dvd hldvd hPsq
