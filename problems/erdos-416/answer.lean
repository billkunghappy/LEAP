  obtain ⟨hinj, hfib⟩ := retained_initial_fibre_high_part cut hcut F d (v 1) hd hdu hF' σ
  
  have hRHS : 0 ≤ (216 * K * Rr * Y * logLog Y ^ 6 / (R * Real.log Y ^ 2 * Real.log (v 1))) /
