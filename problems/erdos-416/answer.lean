    have hx : (1:ℝ) ≤ n := by exact_mod_cast hn
    have hx0 : (0:ℝ) < n := by linarith
    have hx1 : (0:ℝ) < (n:ℝ) + 1 := by linarith
    have h1 := Real.log_le_sub_one_of_pos (show 0 < ((n:ℝ)+1)/n by positivity)
    have h2 := Real.one_sub_inv_le_log_of_pos (show 0 < ((n:ℝ)+1)/n by positivity)
    rw [Real.log_div hx1.ne' hx0.ne'] at h1 h2
    have h3 := Real.log_le_sub_one_of_pos hx1
    have h4 := Real.one_sub_inv_le_log_of_pos hx1
