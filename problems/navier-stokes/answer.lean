  obtain ⟨Mq, hMqdef⟩ : ∃ Mq : ℝ × ℝ →L[ℝ] ℝ × ℝ,
      Mq = (qC h ξ ^ (1/2 - h) • ContinuousLinearMap.id ℝ ℝ).prodMap
        (qC h ξ • ContinuousLinearMap.id ℝ ℝ) := ⟨_, rfl⟩
  obtain ⟨T, hTdef⟩ : ∃ T : Cyl →L[ℝ] ℝ × ℝ, T = Mq.comp Pm := ⟨_, rfl⟩
  obtain ⟨w0, hw0def⟩ : ∃ w0 : ℝ × ℝ, w0 = (ξ.2.1, 1 - ξ.2.2.1) := ⟨_, rfl⟩
  have hW : IsOpen (Set.univ ×ˢ Set.Ioi (0:ℝ) : Set (ℝ × ℝ)) := isOpen_univ.prod isOpen_Ioi
  have hw0 : w0 ∈ (Set.univ ×ˢ Set.Ioi (0:ℝ) : Set (ℝ × ℝ)) := by
    rw [hw0def]; exact ⟨Set.mem_univ _, show (0:ℝ) < 1 - ξ.2.2.1 by linarith⟩
  have hid : ∀ v : Cyl, qC h (ξ + Lnorm h ξ v) = simScale h (w0 + T v).1 (w0 + T v).2 := by
    intro v
    have e1 : (Lnorm h ξ v).2.1 = qC h ξ ^ (1/2 - h) * v.2.1 := by
      simp [Lnorm, ContinuousLinearMap.coe_prodMap']
    have e2 : (Lnorm h ξ v).2.2.1 = qC h ξ * v.2.2.1 := by
      simp [Lnorm, ContinuousLinearMap.coe_prodMap']
    have e3 : T v = (qC h ξ ^ (1/2 - h) * v.2.1, qC h ξ * (-v.2.2.1)) := by
      rw [hTdef, ContinuousLinearMap.comp_apply, hPapp v, hMqdef]
      simp [ContinuousLinearMap.coe_prodMap']
    rw [e3, hw0def]
    show simScale h (ξ.2.1 + (Lnorm h ξ v).2.1) (1 - (ξ.2.2.1 + (Lnorm h ξ v).2.2.1)) =
      simScale h (ξ.2.1 + qC h ξ ^ (1/2 - h) * v.2.1) ((1 - ξ.2.2.1) + qC h ξ * (-v.2.2.1))
    rw [e1, e2]
    congr 1
    ring
  obtain ⟨O, hOdef⟩ : ∃ O : Set Cyl, O = {v : Cyl | (ξ + Lnorm h ξ v).2.2.1 < 1} := ⟨_, rfl⟩
  have hOmem : ∀ v, v ∈ O ↔ (ξ + Lnorm h ξ v).2.2.1 < 1 := by
    intro v; rw [hOdef]; rfl
  have hcontO : Continuous (fun v : Cyl => (ξ + Lnorm h ξ v).2.2.1) :=
    ((continuous_const.add (Lnorm h ξ).continuous).snd.snd.fst)
  have hO : IsOpen O := by rw [hOdef]; exact isOpen_lt hcontO continuous_const
  have h0O : (0 : Cyl) ∈ O := by
    rw [hOmem, map_zero, add_zero]; exact hξ
  obtain ⟨ψ, hψdef⟩ : ∃ ψ : Cyl → ℝ, ψ = fun v => qC h (ξ + Lnorm h ξ v) / qC h ξ :=
    ⟨_, rfl⟩
  have hψ : ContDiffOn ℝ ∞ ψ O := by
    rw [hψdef]
    exact (hqC.comp (contDiff_const.add (Lnorm h ξ).contDiff).contDiffOn
      (fun v hv => (hOmem v).1 hv)).div_const _
  have hψpos : ∀ v ∈ O, 0 < ψ v := by
    intro v hv; rw [hψdef]; exact div_pos (hqpos _ ((hOmem v).1 hv)) hq0
  have hψ0 : ψ 0 = 1 := by
    rw [hψdef]
    show qC h (ξ + Lnorm h ξ 0) / qC h ξ = 1
    rw [map_zero, add_zero]; exact div_self hq0.ne'
  have hψeq : ψ = (qC h ξ)⁻¹ • (fun z : Cyl => simScale h (w0 + T z).1 (w0 + T z).2) := by
    rw [hψdef]; funext v
    show qC h (ξ + Lnorm h ξ v) / qC h ξ =
      (qC h ξ)⁻¹ * simScale h (w0 + T v).1 (w0 + T v).2
    rw [hid v, div_eq_inv_mul]
  have hΦ : ContDiffAt ℝ ∞ (fun z : Cyl => simScale h (w0 + T z).1 (w0 + T z).2) 0 := by
    have h1 : ContDiffAt ℝ ∞ (fun w : ℝ × ℝ => simScale h w.1 w.2) (w0 + T 0) := by
      rw [map_zero, add_zero]; exact hS.2.2.2.1.contDiffAt (hW.mem_nhds hw0)
    exact ContDiffAt.comp (g := fun w : ℝ × ℝ => simScale h w.1 w.2) (f := fun z : Cyl => w0 + T z)
      (0 : Cyl) h1 (contDiff_const.add T.contDiff).contDiffAt
  have hDψ : ∀ i : ℕ, 1 ≤ i → i ≤ j → ‖iteratedFDerivWithin ℝ i ψ O 0‖ ≤ D ^ i := by
    intro i hi1 hij
    have hcomp : (iteratedFDeriv ℝ i (fun w : ℝ × ℝ => simScale h w.1 w.2) w0).compContinuousLinearMap
        (fun _ => Mq.comp Pm) =
        ((iteratedFDeriv ℝ i (fun w : ℝ × ℝ => simScale h w.1 w.2) w0).compContinuousLinearMap
          (fun _ => Mq)).compContinuousLinearMap (fun _ => Pm) := by
      ext m; rfl
    have hCi : ‖(iteratedFDeriv ℝ i (fun w : ℝ × ℝ => simScale h w.1 w.2) w0).compContinuousLinearMap
        (fun _ => Mq)‖ ≤ C i * qC h ξ := by
      rw [hMqdef, hw0def]; exact hC i ξ.2.1 (1 - ξ.2.2.1) (by linarith) hq1
    have hprod : ∏ k : Fin i, ‖Pm‖ ≤ 1 := by
      rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin]
      exact pow_le_one₀ (norm_nonneg _) hP1
    have hb1 := ContinuousMultilinearMap.norm_compContinuousLinearMap_le
      ((iteratedFDeriv ℝ i (fun w : ℝ × ℝ => simScale h w.1 w.2) w0).compContinuousLinearMap
        (fun _ => Mq)) (fun _ : Fin i => Pm)
    have hb2 := hb1.trans ((mul_le_of_le_one_right (norm_nonneg _) hprod).trans hCi)
    have hCiD : C i ≤ D := by
      have h2 : |C i| ≤ ∑ k ∈ Finset.range (j + 1), |C k| :=
        Finset.single_le_sum (f := fun k => |C k|) (fun k _ => abs_nonneg _)
          (Finset.mem_range.mpr (Nat.lt_succ_of_le hij))
      have h3 := le_abs_self (C i)
      rw [hDdef]; linarith
    rw [iteratedFDerivWithin_of_isOpen i hO h0O, hψeq,
      iteratedFDeriv_const_smul_apply (hΦ.of_le (by exact_mod_cast le_top)),
      key (fun w : ℝ × ℝ => simScale h w.1 w.2) (Set.univ ×ˢ Set.Ioi 0) w0 T hW hS.2.2.2.1 hw0 i,
      norm_smul, hTdef, hcomp, Real.norm_of_nonneg (inv_nonneg.mpr hq0.le)]
    calc (qC h ξ)⁻¹ * ‖((iteratedFDeriv ℝ i (fun w : ℝ × ℝ => simScale h w.1 w.2) w0).compContinuousLinearMap
          (fun _ => Mq)).compContinuousLinearMap (fun _ => Pm)‖
        ≤ (qC h ξ)⁻¹ * (C i * qC h ξ) :=
          mul_le_mul_of_nonneg_left hb2 (inv_nonneg.mpr hq0.le)
      _ = C i := by rw [mul_comm (C i), ← mul_assoc, inv_mul_cancel₀ hq0.ne', one_mul]
      _ ≤ D := hCiD
      _ ≤ D ^ i := le_self_pow₀ hD1 (by omega)
  have hg : ContDiffOn ℝ ∞ (fun x : ℝ => x ^ c) (Set.Ioi 0) :=
    (contDiffOn_id (s := Set.Ioi (0:ℝ))).rpow_const_of_ne (fun x hx => ne_of_gt hx)
  have hψmaps : Set.MapsTo ψ O (Set.Ioi 0) := fun v hv => hψpos v hv
  have hCg : ∀ i ≤ j, ‖iteratedFDerivWithin ℝ i (fun x : ℝ => x ^ c) (Set.Ioi 0) (ψ 0)‖ ≤ A := by
    intro i hi
    rw [hψ0, iteratedFDerivWithin_of_isOpen i isOpen_Ioi (Set.mem_Ioi.mpr (zero_lt_one' ℝ)),
      norm_iteratedFDeriv_eq_norm_iteratedDeriv, iteratedDeriv_eq_iterate,
      Real.iter_deriv_rpow_const, Real.one_rpow, mul_one, Real.norm_eq_abs, hAdef]
    exact Finset.single_le_sum (f := fun i => |Polynomial.eval c (descPochhammer ℝ i)|)
      (fun i _ => abs_nonneg _) (Finset.mem_range.mpr (Nat.lt_succ_of_le hi))
  have hFdB := norm_iteratedFDerivWithin_comp_le hg hψ (by exact_mod_cast le_top)
    isOpen_Ioi.uniqueDiffOn hO.uniqueDiffOn hψmaps h0O (C := A) (D := D) hCg hDψ
  obtain ⟨gl, hgldef⟩ : ∃ gl : ℝ →L[ℝ] ℝ, gl = a • ContinuousLinearMap.id ℝ ℝ := ⟨_, rfl⟩
  have hgl : ‖gl‖ ≤ a := ContinuousLinearMap.opNorm_le_bound _ ha0 (fun x => le_of_eq (by
    rw [hgldef, ContinuousLinearMap.smul_apply, ContinuousLinearMap.id_apply, norm_smul,
      Real.norm_of_nonneg ha0]))
  have hEq : Set.EqOn (fun z => F (ξ + Lnorm h ξ z)) (⇑gl ∘ ((fun x : ℝ => x ^ c) ∘ ψ)) O := by
    intro z hz
    have hψz := hψpos z hz
    have e : qC h (ξ + Lnorm h ξ z) = qC h ξ * ψ z := by
      rw [hψdef]
      show _ = qC h ξ * (qC h (ξ + Lnorm h ξ z) / qC h ξ)
      field_simp
    show F (ξ + Lnorm h ξ z) = gl (ψ z ^ c)
    rw [hFdef, hgldef, ContinuousLinearMap.smul_apply, ContinuousLinearMap.id_apply, smul_eq_mul]
    show qC h (ξ + Lnorm h ξ z) ^ c = a * ψ z ^ c
    rw [e, Real.mul_rpow hq0.le hψz.le, ← hadef]
  have hgψ : ContDiffOn ℝ ∞ ((fun x : ℝ => x ^ c) ∘ ψ) O := hg.comp hψ hψmaps
  have hNB : NB h F j ξ = ‖iteratedFDeriv ℝ j (fun z => F (ξ + Lnorm h ξ z)) 0‖ := by
    unfold NB
    rw [key F {η : Cyl | η.2.2.1 < 1} ξ (Lnorm h ξ) hU hFU hξ j]
  calc NB h F j ξ = ‖iteratedFDeriv ℝ j (fun z => F (ξ + Lnorm h ξ z)) 0‖ := hNB
    _ = ‖iteratedFDerivWithin ℝ j (fun z => F (ξ + Lnorm h ξ z)) O 0‖ := by
        rw [iteratedFDerivWithin_of_isOpen j hO h0O]
    _ = ‖iteratedFDerivWithin ℝ j (⇑gl ∘ ((fun x : ℝ => x ^ c) ∘ ψ)) O 0‖ := by
        rw [iteratedFDerivWithin_congr hEq h0O j]
    _ = ‖gl.compContinuousMultilinearMap
          (iteratedFDerivWithin ℝ j ((fun x : ℝ => x ^ c) ∘ ψ) O 0)‖ := by
        rw [ContinuousLinearMap.iteratedFDerivWithin_comp_left gl (hgψ.contDiffWithinAt h0O)
          hO.uniqueDiffOn h0O (i := j) (by exact_mod_cast le_top)]
    _ ≤ ‖gl‖ * ‖iteratedFDerivWithin ℝ j ((fun x : ℝ => x ^ c) ∘ ψ) O 0‖ :=
        ContinuousLinearMap.norm_compContinuousMultilinearMap_le _ _
    _ ≤ a * ((j.factorial : ℝ) * A * D ^ j) := mul_le_mul hgl hFdB (norm_nonneg _) ha0
    _ = (j.factorial : ℝ) * A * D ^ j * a := by ring

theorem pq5_ndot_class : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 →
  (∀ (γ : Lab), ∀ ξ ∈ DomC B.h (qsOf l0), dotProduct (nPhi5 B G γ ξ) (W0c4 B G γ ξ) = 0) →
  InWg5 B G (qsOf l0) 1 (primState5 B G).Aw →
  InWg5 B G (qsOf l0) (1 - kapS) (velW5 B G (primState5 B G).Aw - W0h4 B G) →
  InWg5 B G (qsOf l0) (1 - kapS) (fun γ m ξ => dotProduct
      (fun i => (((qC B.h ξ / Qb γ.1) ^ (1/2:ℝ) * nPhi5 B G γ ξ i : ℝ) : ℂ))
      ((velW5 B G (primState5 B G).Aw - W0h4 B G) γ m ξ)) ∧
  InWg5 B G (qsOf l0) 1 (fun γ m ξ => dotProduct
      (fun i => ((B.h * qC B.h ξ ^ (1/2:ℝ) * dZ (fun η => Real.log (qC B.h η)) ξ * nPhi5 B G γ ξ i : ℝ) : ℂ))
      (rotC ((primState5 B G).Aw γ m ξ))) ∧
  ∀ (γ : Lab) (m : ℤ), ∀ ξ ∈ DomC B.h (qsOf l0),
    dotProduct (fun i => (nPhi5 B G γ ξ i : ℂ)) (wmoAmp5 B G (primState5 B G).Aw γ m ξ) =
      dotProduct (fun i => (((qC B.h ξ / Qb γ.1) ^ (1/2:ℝ) * nPhi5 B G γ ξ i : ℝ) : ℂ))
        ((velW5 B G (primState5 B G).Aw - W0h4 B G) γ m ξ) +
      dotProduct (fun i => ((B.h * qC B.h ξ ^ (1/2:ℝ) * dZ (fun η => Real.log (qC B.h η)) ξ * nPhi5 B G γ ξ i : ℝ) : ℂ))
        (rotC ((primState5 B G).Aw γ m ξ)) :=
by
  intro B G hok hG
  obtain ⟨hh0, hh1, -, -, -, -, -, hqB0, -, -, -, -, -⟩ := hok.2.1
  obtain ⟨lp, hp⟩ := pulse_support_good_v5 B G hok hG
  obtain ⟨lg, hg⟩ := good_nphi5_nb_v5 B G hok hG
  obtain ⟨lb, hb⟩ := band_coarse_gap_v5 B.h hh0 hh1
  obtain ⟨n0, hn0⟩ := exists_pow_lt_of_lt_one hqB0 (by norm_num : (1/2:ℝ) < 1)
  choose Cn hCn using hg
  refine ⟨lp + lg + lb + n0, fun l0 hl0 htr hAw hD => ?_⟩
  have hQb : qsOf l0 = (1/2:ℝ) ^ l0 := by
    show (2:ℝ) ^ (-(l0:ℝ)) = _
    rw [Real.rpow_neg (by norm_num), Real.rpow_natCast, one_div, inv_pow]
  have hq1 : qsOf l0 ≤ 1 := by
    rw [hQb]; exact pow_le_one₀ (by norm_num) (by norm_num)
  have hqsB : qsOf l0 ≤ B.qB := by
    rw [hQb]
    exact le_trans (pow_le_pow_of_le_one (by norm_num) (by norm_num) (by omega : n0 ≤ l0)) hn0.le
  have hDO : IsOpen (DomC B.h (qsOf l0)) := (domc_open_calculus B (qsOf l0) hok).1
  have hDq : ∀ ξ ∈ DomC B.h (qsOf l0), 0 < qC B.h ξ := (domc_open_calculus B (qsOf l0) hok).2.2.1

  have key : ∀ (α : ℝ) (ρ : Lab → Cyl → ℝ) (a : WC), InWg5 B G (qsOf l0) α a →
      (∀ (γ : Lab), ∀ ξ ∈ DomC B.h (qsOf l0), ContDiffAt ℝ ∞ (ρ γ) ξ) →
      (∀ (γ : Lab) (ξ : Cyl) (c : ℝ × ℝ), ρ γ (shY ξ c) = ρ γ ξ) →
      (∀ k : ℕ, ∃ C : ℝ, ∀ (γ : Lab), ∀ ξ ∈ DomC B.h (qsOf l0), 1/4 < qC B.h ξ / Qb γ.1 →
        qC B.h ξ / Qb γ.1 < 4 → NB B.h (ρ γ) k ξ ≤ C) →
      InWg5 B G (qsOf l0) α
        (fun γ m ξ => dotProduct (fun i => ((ρ γ ξ * nPhi5 B G γ ξ i : ℝ) : ℂ)) (a γ m ξ)) := by
    intro α ρ a ha hρs hρY hρB
    have hsm : ∀ (γ : Lab) (m : ℤ), ∀ ξ ∈ DomC B.h (qsOf l0), ξ ∈ tsupport (a γ m) →
        ContDiffAt ℝ ∞ ((fun (γ : Lab) (_ : ℤ) (ξ : Cyl) (i : Fin 3) =>
          ((ρ γ ξ * nPhi5 B G γ ξ i : ℝ) : ℂ)) γ m) ξ := by
      intro γ m ξ hξ hts
      obtain ⟨-, -, -, -, -, -, -, hxi, het⟩ := hp l0 (by omega) α a ha γ m ξ hξ hts
      have hξ' : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qsOf l0 := hξ
      have hξB : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < B.qB :=
        ⟨hξ'.1, hξ'.2.1, lt_of_lt_of_le hξ'.2.2 hqsB⟩
      obtain ⟨U, hUo, hξU, -, hnU, -, -⟩ := good_coeff_smooth_v5 B G γ ξ hok hξB hxi het
      rw [contDiffAt_pi]
      intro i
      have h1 : ContDiffAt ℝ ∞ (fun η => ρ γ η * nPhi5 B G γ η i) ξ :=
        (hρs γ ξ hξ).mul ((hnU i).contDiffAt (hUo.mem_nhds hξU))
      have h2 := (Complex.ofRealCLM.contDiff (n := ∞)).contDiffAt.comp ξ h1
      exact h2
    have hdk : ∀ (γ : Lab) (m : ℤ), ∀ ξ ∈ DomC B.h (qsOf l0), a γ m ξ ≠ 0 → ∀ c : ℝ × ℝ,
        IsDeck B.h (qC B.h ξ) c →
        (fun (γ : Lab) (_ : ℤ) (ξ : Cyl) (i : Fin 3) => ((ρ γ ξ * nPhi5 B G γ ξ i : ℝ) : ℂ)) γ m (shY ξ c) =
        (fun (γ : Lab) (_ : ℤ) (ξ : Cyl) (i : Fin 3) => ((ρ γ ξ * nPhi5 B G γ ξ i : ℝ) : ℂ)) γ m ξ := by
      intro γ m ξ hξ hne c hc
      have hts : ξ ∈ tsupport (a γ m) := subset_tsupport _ hne
      obtain ⟨-, -, -, hb1, hb2, -⟩ := hp l0 (by omega) α a ha γ m ξ hξ hts
      have hξ' : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qsOf l0 := hξ
      have hcb := (hb γ.1 l0 (qC B.h ξ) (by omega) (hDq ξ hξ) hξ'.2.2 hb1 hb2).1
      have hn := nPhi5_deck_v5 B G γ (coarseIdx B.h (qC B.h ξ)) c hcb hc ξ
      funext i
      simp only [hρY γ ξ c, hn]
    have hnb : ∀ k : ℕ, ∃ C b : ℝ, ∀ (γ : Lab) (m : ℤ), ∀ ξ ∈ DomC B.h (qsOf l0), ξ ∈ tsupport (a γ m) →
        B.Xa < XC B.h ξ → XC B.h ξ < B.Xb →
        NB B.h ((fun (γ : Lab) (_ : ℤ) (ξ : Cyl) (i : Fin 3) => ((ρ γ ξ * nPhi5 B G γ ξ i : ℝ) : ℂ)) γ m) k ξ
          ≤ C * qC B.h ξ ^ (B.h * 0) * SC B.h ξ ^ b := by
      intro k
      choose Cr hCr using hρB
      refine ⟨3 * (2 ^ k * (∑ j ∈ Finset.range (k+1), |Cr j|) * (∑ j ∈ Finset.range (k+1), |Cn j|)), 1, ?_⟩
      intro γ m ξ hξ hts _ _
      obtain ⟨-, hact, hlγ, hb1, hb2, hX1', hX2', hxi, het⟩ := hp l0 (by omega) α a ha γ m ξ hξ hts
      have hξ' : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qsOf l0 := hξ
      have hξB : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < B.qB :=
        ⟨hξ'.1, hξ'.2.1, lt_of_lt_of_le hξ'.2.2 hqsB⟩
      obtain ⟨U, hUo, hξU, -, hnU, -, -⟩ := good_coeff_smooth_v5 B G γ ξ hok hξB hxi het
      have hSC0 : 0 ≤ SC B.h ξ := by unfold SC; positivity
      have hr : ∀ j, j ≤ k → NB B.h (ρ γ) j ξ ≤ ∑ j ∈ Finset.range (k+1), |Cr j| := by
        intro j hj
        refine le_trans (hCr j γ ξ hξ hb1 hb2) (le_trans (le_abs_self _) ?_)
        exact Finset.single_le_sum (f := fun j => |Cr j|) (fun j _ => abs_nonneg _)
          (Finset.mem_range.mpr (by omega))
      have hn : ∀ i : Fin 3, ∀ j, j ≤ k → NB B.h (fun η => nPhi5 B G γ η i) j ξ ≤
          (∑ j ∈ Finset.range (k+1), |Cn j|) * SC B.h ξ := by
        intro i j hj
        refine le_trans (hCn j l0 (by omega) γ hact hlγ ξ hξ hb1 hb2 hX1' hX2' hxi het i) ?_
        apply mul_le_mul_of_nonneg_right _ hSC0
        refine le_trans (le_abs_self _) ?_
        exact Finset.single_le_sum (f := fun j => |Cn j|) (fun j _ => abs_nonneg _)
          (Finset.mem_range.mpr (by omega))
      have hprod : ∀ i : Fin 3, NB B.h (fun η => ρ γ η * nPhi5 B G γ η i) k ξ ≤
          2 ^ k * (∑ j ∈ Finset.range (k+1), |Cr j|) * ((∑ j ∈ Finset.range (k+1), |Cn j|) * SC B.h ξ) :=
        fun i => nb_real_mul_le_v5 B.h ξ (ρ γ) (fun η => nPhi5 B G γ η i) k _ _ (hρs γ ξ hξ)
          ((hnU i).contDiffAt (hUo.mem_nhds hξU)) hr (hn i)
      have hU' : IsOpen (U ∩ DomC B.h (qsOf l0)) := hUo.inter hDO
      have hvec := nb_vec_complex_v5 B.h (U ∩ DomC B.h (qsOf l0)) ξ 1
        (fun i η => ρ γ η * nPhi5 B G γ η i)
        (fun η i => ((ρ γ η * nPhi5 B G γ η i : ℝ) : ℂ)) hU' ⟨hξU, hξ⟩
        (fun i η hη => ((hρs γ η hη.2).contDiffWithinAt).mul ((hnU i).mono Set.inter_subset_left η hη))
        (fun η _ => by funext i; simp only [one_mul]) k
      rw [norm_one, one_mul, Fin.sum_univ_three] at hvec
      have e1 : qC B.h ξ ^ (B.h * 0) = 1 := by rw [mul_zero, Real.rpow_zero]
      rw [e1, Real.rpow_one, mul_one]
      calc NB B.h (fun η i => ((ρ γ η * nPhi5 B G γ η i : ℝ) : ℂ)) k ξ ≤ _ := hvec
        _ ≤ 2 ^ k * (∑ j ∈ Finset.range (k+1), |Cr j|) * ((∑ j ∈ Finset.range (k+1), |Cn j|) * SC B.h ξ)
            + 2 ^ k * (∑ j ∈ Finset.range (k+1), |Cr j|) * ((∑ j ∈ Finset.range (k+1), |Cn j|) * SC B.h ξ)
            + 2 ^ k * (∑ j ∈ Finset.range (k+1), |Cr j|) * ((∑ j ∈ Finset.range (k+1), |Cn j|) * SC B.h ξ) :=
          add_le_add (add_le_add (hprod 0) (hprod 1)) (hprod 2)
        _ = _ := by ring
    have hmain := inWg5_dot_mult B G l0 hok α 0 a
      (fun (γ : Lab) (_ : ℤ) (ξ : Cyl) (i : Fin 3) => ((ρ γ ξ * nPhi5 B G γ ξ i : ℝ) : ℂ)) ha hsm hdk hnb
    rw [add_zero] at hmain
    exact hmain

  have hP1 := key (1 - kapS) (fun γ ξ => (qC B.h ξ / Qb γ.1) ^ (1/2:ℝ)) _ hD
    (fun γ ξ hξ => (rhoQ_rpow_nb_v5 B hok (1/2)).1 γ ξ hξ.2.1)
    (fun γ ξ c => rfl)
    (fun k => by
      obtain ⟨C, hC⟩ := (rhoQ_rpow_nb_v5 B hok (1/2)).2 k
      exact ⟨C, fun γ ξ hξ hb1 hb2 => hC γ ξ hξ.2.1 (hξ.2.2.le.trans hq1) hb1 hb2⟩)

  have hR : InWg5 B G (qsOf l0) 1 (fun γ m ξ => rotC ((primState5 B G).Aw γ m ξ)) := by
    have e : (fun γ m ξ => rotC ((primState5 B G).Aw γ m ξ)) =
        (fun γ m ξ => crossC ((fun (_ : Lab) (_ : ℤ) (_ : Cyl) => (![0, 0, -1] : Fin 3 → ℂ)) γ m ξ)
          ((primState5 B G).Aw γ m ξ)) := by
      funext γ m ξ i
      fin_cases i <;> simp [crossC, rotC]
    have h := inWg5_cross_mult B G l0 hok 1 0 (primState5 B G).Aw
      (fun (_ : Lab) (_ : ℤ) (_ : Cyl) => (![0, 0, -1] : Fin 3 → ℂ)) hAw
      (fun _ _ _ _ _ => contDiffAt_const) (fun _ _ _ _ _ _ _ => rfl) (fun k => ⟨1, 0, fun γ m ξ _ _ _ _ => by
        simp only [mul_zero, Real.rpow_zero, mul_one]
        show ‖(iteratedFDeriv ℝ k (fun _ : Cyl => (![0, 0, -1] : Fin 3 → ℂ)) ξ).compContinuousLinearMap
          (fun _ => Lnorm B.h ξ)‖ ≤ 1
        refine le_trans (ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _) ?_
        rcases Nat.eq_zero_or_pos k with hk | hk
        · subst hk
          rw [norm_iteratedFDeriv_zero, Fin.prod_univ_zero, mul_one]
          refine (pi_norm_le_iff_of_nonneg zero_le_one).mpr (fun i => ?_)
          fin_cases i <;> simp
        · rw [iteratedFDeriv_const_of_ne (by omega : k ≠ 0)]
          simp⟩)
    rw [add_zero] at h
    rw [e]
    exact h

  obtain ⟨hMs, hMb⟩ := wmo_amp_multipliers_v5 B hok (qsOf l0) hq1
  have hdZ : ∀ (ξ : Cyl) (c : ℝ × ℝ), dZ (fun η => Real.log (qC B.h η)) (shY ξ c) =
      dZ (fun η => Real.log (qC B.h η)) ξ := by
    intro ξ c
    have e1 : shY ξ c = ξ + ((0:ℝ), (0:ℝ), (0:ℝ), c) := by
      rcases ξ with ⟨a1, a2, a3, a4⟩
      simp [shY]
    have e2 : (fun x : Cyl => Real.log (qC B.h (x + ((0:ℝ), (0:ℝ), (0:ℝ), c)))) =
        fun η => Real.log (qC B.h η) := by
      funext x
      simp [qC]
    unfold dZ
    rw [e1, ← fderiv_comp_add_right]
    exact congrArg (fun g => fderiv ℝ g ξ (0, 1, 0, 0)) e2
  have hP2 := key 1 (fun _ ξ => B.h * qC B.h ξ ^ (1/2:ℝ) * dZ (fun η => Real.log (qC B.h η)) ξ) _ hR
    (fun γ ξ hξ => (hMs ξ hξ).2)
    (fun γ ξ c => by
      show B.h * qC B.h (shY ξ c) ^ (1/2:ℝ) * dZ (fun η => Real.log (qC B.h η)) (shY ξ c) = _
      rw [hdZ ξ c]
      rfl)
    (fun k => by
      obtain ⟨C, hC⟩ := hMb k
      exact ⟨C, fun γ ξ hξ _ _ => (hC ξ hξ).2⟩)
  refine ⟨hP1, hP2, fun γ m ξ hξ => ?_⟩

  have ht := htr γ ξ hξ
  simp only [dotProduct, Fin.sum_univ_three] at ht ⊢
  have htC : ((nPhi5 B G γ ξ 0 : ℝ) : ℂ) * ((W0c4 B G γ ξ 0 : ℝ) : ℂ) +
      ((nPhi5 B G γ ξ 1 : ℝ) : ℂ) * ((W0c4 B G γ ξ 1 : ℝ) : ℂ) +
      ((nPhi5 B G γ ξ 2 : ℝ) : ℂ) * ((W0c4 B G γ ξ 2 : ℝ) : ℂ) = 0 := by
    have h := congrArg (fun x : ℝ => (x : ℂ)) ht
    simp only [Complex.ofReal_add, Complex.ofReal_mul, Complex.ofReal_zero] at h
    exact h
  simp only [wmoAmp5, Pi.sub_apply, W0h4]
  generalize (qC B.h ξ / Qb γ.1) ^ (1/2:ℝ) = r1
  generalize B.h * qC B.h ξ ^ (1/2:ℝ) * dZ (fun η => Real.log (qC B.h η)) ξ = μ
  by_cases hm : m = 1 ∨ m = -1
  · simp only [hm, if_true, Complex.ofReal_mul]
    linear_combination (r1 : ℂ) * htC
  · simp only [hm, if_false, Pi.zero_apply, sub_zero, Complex.ofReal_mul]
    ring

theorem pq5_quad_class : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → (∀ q : ℝ, 0 < q → q < (2:ℝ) ^ (-(10:ℝ)) → Lgc ^ (coarseIdx B.h q) * q ^ (drx B.h / 2) ≤ q ^ (-(B.h * kapS))) → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 → InWg5 B G (qsOf l0) (1/2) (W0h4 B G) → (∀ (γ : Lab), ∀ ξ ∈ DomC B.h (qsOf l0), dotProduct (nPhi5 B G γ ξ) (W0c4 B G γ ξ) = 0) → InWg5 B G (qsOf l0) 1 (primState5 B G).Aw → InWg5 B G (qsOf l0) (1/2) (velW5 B G (primState5 B G).Aw) → InWg5 B G (qsOf l0) (1 - kapS) (velW5 B G (primState5 B G).Aw - W0h4 B G) → InWg5 B G (qsOf l0) (1 - kapS) (pq5Osc (pq5QOf B G (pq5Vw B G))) :=
by
  intro B G hok hG _hcoarse
  obtain ⟨hh0, -, hXa, -, -, -, -, hqB0, -, -, -, -, -⟩ := hok.2.1
  obtain ⟨n0, hn0⟩ := exists_pow_lt_of_lt_one hqB0 (by norm_num : (1/2:ℝ) < 1)
  obtain ⟨lP, hP⟩ := pq5_prod_class B G hok hG
  obtain ⟨lR, hR⟩ := pq5_dR_class B G hok hG
  obtain ⟨lZ, hZ⟩ := pq5_dZ_class B G hok hG
  obtain ⟨lM, hM⟩ := pq5_mult_class B G hok hG
  obtain ⟨lN, hN⟩ := pq5_ndot_class B G hok hG
  obtain ⟨lA, hA⟩ := wmo_amp_class_v5 B G hok hG
  have hPF := pq5_phase_free B G hok hG
  refine ⟨n0 + lP + lR + lZ + lM + lN + lA, fun l0 hl0 _hW0 htr hAw hvel hdiff => ?_⟩
  have hk : kapS = 1 / 100000 := rfl
  have hQb : qsOf l0 = (1/2:ℝ) ^ l0 := by
    show (2:ℝ) ^ (-(l0:ℝ)) = _
    rw [Real.rpow_neg (by norm_num), Real.rpow_natCast, one_div, inv_pow]
  have hq1 : qsOf l0 ≤ 1 := by
    rw [hQb]; exact pow_le_one₀ (by norm_num) (by norm_num)
  have hqsB : qsOf l0 ≤ B.qB := by
    rw [hQb]
    exact le_trans (pow_le_pow_of_le_one (by norm_num) (by norm_num) (by omega : n0 ≤ l0)) hn0.le

  have hpos : ∀ z t : ℝ, t < 1 → 0 < simScale B.h z (1 - t) := fun z t ht =>
    (hok.1.1 z (1 - t) (by linarith)).1
  have key0 : ∀ (C q a a' : ℝ), 0 < q → q ≤ 1 → a' ≤ a →
      C * q ^ (B.h * a) ≤ |C| * q ^ (B.h * a') := by
    intro C q a a' hq0 hq1' haa
    calc C * q ^ (B.h * a) ≤ |C| * q ^ (B.h * a) :=
          mul_le_mul_of_nonneg_right (le_abs_self C) (Real.rpow_nonneg hq0.le _)
      _ ≤ |C| * q ^ (B.h * a') :=
          mul_le_mul_of_nonneg_left (Real.rpow_le_rpow_of_exponent_ge hq0 hq1'
            (mul_le_mul_of_nonneg_left haa hh0.le)) (abs_nonneg C)
  have hED : ∀ X : ℝ, B.Xa < X → X < B.Xb → 0 < edgeDist B.Xa B.Xb X := by
    intro X h1 h2
    have hX0 : 0 < X := lt_trans hXa h1
    unfold edgeDist
    exact lt_min one_pos (lt_min (Real.log_pos ((one_lt_div hXa).mpr h1))
      (Real.log_pos ((one_lt_div hX0).mpr h2)))
  have hSC : ∀ (ξ : Cyl) (b : ℝ), 0 ≤ SC B.h ξ ^ b := by
    intro ξ b
    exact Real.rpow_nonneg (by unfold SC; positivity) b
  have hMono : ∀ (a : WC) (α α' : ℝ),
      α' ≤ α → InWg5 B G (qsOf l0) α a → InWg5 B G (qsOf l0) α' a := by
    intro a α α' hαα ha
    obtain ⟨c1, c2, c3, c4, c5⟩ := ha
    refine ⟨c1, c2, c3, c4, fun k => ?_⟩
    obtain ⟨C, b, d, hC⟩ := c5 k
    refine ⟨|C|, b, d, fun γ m ξ hξ hX1 hX2 => ?_⟩
    have hξ' : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qsOf l0 := hξ
    have hq0 : 0 < qC B.h ξ := hpos ξ.2.1 ξ.2.2.1 hξ'.2.1
    have hq1' : qC B.h ξ ≤ 1 := le_trans hξ'.2.2.le hq1
    refine le_trans (hC γ m ξ hξ hX1 hX2) ?_
    apply mul_le_mul_of_nonneg_right _ (by unfold Penv5; exact (Real.exp_pos _).le)
    apply mul_le_mul_of_nonneg_right _ (Real.rpow_pos_of_pos (hED _ hX1 hX2) _).le
    apply mul_le_mul_of_nonneg_right _ (Real.sqrt_nonneg _)
    exact mul_le_mul_of_nonneg_right (key0 C _ α α' hq0 hq1' hαα) (hSC ξ b)

  have hAddC := (@pq5_add_congr_class B G (qsOf l0) hok hq1 ℂ _ _)
  have hAddV := (@pq5_add_congr_class B G (qsOf l0) hok hq1 (Fin 3 → ℂ) _ _)

  obtain ⟨hAC, -⟩ := hA l0 (by omega)
  have hW : InWg5 B G (qsOf l0) (1/2) (wmoAmp5 B G (primState5 B G).Aw) :=
    hAC _ (1/2) (by rw [show (1/2:ℝ) + 1/2 = 1 by norm_num]; exact hAw) hvel

  obtain ⟨Ut, hUtc, hUte⟩ : ∃ Ut : Fin 3 → Lab → ℤ → Cyl → ℂ,
      (∀ j, InWg5 B G (qsOf l0) (1/2) (Ut j)) ∧
      ∀ j γ m ξ, Ut j γ m ξ = wmoAmp5 B G (primState5 B G).Aw γ m ξ j +
        starRingEnd ℂ (wmoAmp5 B G (primState5 B G).Aw γ (-m) ξ j) := by
    refine ⟨fun j γ m ξ => wmoAmp5 B G (primState5 B G).Aw γ m ξ j +
        starRingEnd ℂ (wmoAmp5 B G (primState5 B G).Aw γ (-m) ξ j), fun j => ?_, fun _ _ _ _ => rfl⟩
    have h1 := (pq5_comp_conj_class B G (qsOf l0) (1/2) hok).1 _ j hW
    have h2 := (pq5_comp_conj_class B G (qsOf l0) (1/2) hok).2 _ h1
    have h3 := hAddC.1 _ _ _ _ h1 h2
    rw [min_self] at h3
    exact h3

  obtain ⟨hN1, hN2, hid⟩ := hN l0 (by omega) htr hAw hdiff
  obtain ⟨Dt, hDtc, hDte⟩ : ∃ Dt : Lab → ℤ → Cyl → ℂ, InWg5 B G (qsOf l0) (1 - kapS) Dt ∧
      ∀ γ m, ∀ ξ ∈ DomC B.h (qsOf l0), Dt γ m ξ =
        dotProduct (wmoAmp5 B G (primState5 B G).Aw γ m ξ) (fun j => (nPhi5 B G γ ξ j : ℂ)) +
        dotProduct (fun i => starRingEnd ℂ (wmoAmp5 B G (primState5 B G).Aw γ (-m) ξ i))
          (fun j => (nPhi5 B G γ ξ j : ℂ)) := by
    have hDd := hAddC.1 _ _ _ _ hN1 hN2
    rw [min_eq_left (by rw [hk]; norm_num : (1 - kapS : ℝ) ≤ 1)] at hDd
    have hDc := (pq5_comp_conj_class B G (qsOf l0) (1 - kapS) hok).2 _ hDd
    have hDt := hAddC.1 _ _ _ _ hDd hDc
    rw [min_self] at hDt
    refine ⟨_, hDt, ?_⟩
    intro γ m ξ hξ
    beta_reduce
    rw [← hid γ m ξ hξ, ← hid γ (-m) ξ hξ]
    simp only [dotProduct, Fin.sum_univ_three, map_add, map_mul, Complex.conj_ofReal]
    ring

  obtain ⟨hJ1, hW2, hW3⟩ := hM l0 (by omega) (1/2) _ hW
  have hRc := hR l0 (by omega) (1/2) _ hW
  have hZc := hZ l0 (by omega) (1/2) _ hW
  have hZp := hAddV.1 _ _ _ _ hZc hW2

  have h0H : (0 : ℤ) ∉ ({2, -2} : Finset ℤ) := by decide
  have hF1 := hP l0 (by omega) _ _ (1/2 : ℂ) (Ut 0) _ ({2, -2} : Finset ℤ) (fun M => M / 2) (fun M => M / 2)
    h0H (hUtc 0) hRc
  have hF2 := hP l0 (by omega) _ _ (1/2 : ℂ) (Ut 2) _ ({2, -2} : Finset ℤ) (fun M => M / 2) (fun M => M / 2)
    h0H (hUtc 2) hZp
  have hF3 := hP l0 (by omega) _ _ (1/2 : ℂ) (Ut 1) _ ({2, -2} : Finset ℤ) (fun M => M / 2) (fun M => M / 2)
    h0H (hUtc 1) hJ1
  have hF5 := hP l0 (by omega) _ _ (1/2 : ℂ) Dt _ ({2, -2} : Finset ℤ) (fun M => M / 2) (fun M => M / 2)
    h0H hDtc hW3

  have hS := hAddV.1 _ _ _ _ (hAddV.1 _ _ _ _ (hAddV.1 _ _ _ _ hF1 hF2) hF3) hF5

  have hT := hAddV.2 _ _ (pq5Osc (pq5QOf B G (pq5Vw B G))) hS ?_ ?_
  · refine hMono _ _ _ ?_ hT
    simp only [le_min_iff]
    rw [hk]
    norm_num
  · refine ⟨{2, -2}, h0H, fun γ M hM => ?_⟩
    funext ξ
    simp only [Finset.mem_insert, Finset.mem_singleton, not_or] at hM
    exact hPF.1 γ M ξ hM.1 hM.2
  · intro γ M ξ hξ
    beta_reduce
    by_cases hMH : M ∈ ({2, -2} : Finset ℤ)
    · have h22 : M = 2 ∨ M = -2 := by simpa using hMH
      obtain ⟨s, hs, rfl⟩ : ∃ s : ℤ, (s = 1 ∨ s = -1) ∧ M = 2 * s := by
        rcases h22 with h | h
        · exact ⟨1, Or.inl rfl, by rw [h]; norm_num⟩
        · exact ⟨-1, Or.inr rfl, by rw [h]; norm_num⟩
      have hs2 : 2 * s / 2 = s := by omega
      rw [if_pos hMH, if_pos hMH, if_pos hMH, if_pos hMH, hs2, hPF.2 l0 hqsB hW γ s hs ξ hξ]
      funext i
      simp only [pq5T, Pi.smul_apply, Pi.add_apply, smul_eq_mul, hUte, hDte γ s ξ hξ]
      ring
    · have hMH' := hMH
      simp only [Finset.mem_insert, Finset.mem_singleton, not_or] at hMH'
      rw [if_neg hMH, if_neg hMH, if_neg hMH, if_neg hMH, hPF.1 γ M ξ hMH'.1 hMH'.2]
      simp

theorem pwr5_quadratic_harmonics : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 →
    InWg5 B G (qsOf l0) (1/2) (W0h4 B G) →
    (∀ (γ : Lab), ∀ ξ ∈ DomC B.h (qsOf l0), dotProduct (nPhi5 B G γ ξ) (W0c4 B G γ ξ) = 0) →
    InWg5 B G (qsOf l0) 1 (primState5 B G).Aw →
    InWg5 B G (qsOf l0) (1/2) (velW5 B G (primState5 B G).Aw) →
    InWg5 B G (qsOf l0) (1 - kapS) (velW5 B G (primState5 B G).Aw - W0h4 B G) →
    ∃ g : WC, InWg5 B G (qsOf l0) (1 - kapS) g ∧
      ∀ x t Y, corrOn B l0 x t →
        pwrQ B G l0 x t Y - thAvgVec (pwrQ B G l0) x t Y =
          (qC B.h (ptOf x t Y) ^ (-(2 * Aex B.h + 1/2))) • cyl2cart x (waveV5 B G g (thetaOf x) (ptOf x t Y)) :=
by
  intro B G hok hG

  have hcoarse : ∀ q : ℝ, 0 < q → q < (2:ℝ) ^ (-(10:ℝ)) →
      Lgc ^ (coarseIdx B.h q) * q ^ (drx B.h / 2) ≤ q ^ (-(B.h * kapS)) := by
    intro q hq0 hq
    have hh : 0 < B.h := hok.2.1.1
    have hs0 : 0 ≤ Real.sqrt 2 := Real.sqrt_nonneg 2
    have hs2 : Real.sqrt 2 ^ 2 = 2 := Real.sq_sqrt (by norm_num)
    have hslt : Real.sqrt 2 < 2 := by nlinarith
    have hL1 : 1 < Lgc := by unfold Lgc; linarith
    have hT1 : 1 < Tgc := by unfold Tgc; linarith
    have hlL : 0 < Real.log Lgc := Real.log_pos hL1
    have hlT : 0 < Real.log Tgc := Real.log_pos hT1
    have hl2 : 0 < Real.log 2 := Real.log_pos (by norm_num)
    have hlq : Real.log q < -10 * Real.log 2 := by
      have h := Real.log_lt_log hq0 hq
      rw [Real.log_rpow (by norm_num : (0:ℝ) < 2)] at h
      linarith
    have ha : Real.logb 2 (1 / q) * Real.log 2 = -Real.log q := by
      rw [Real.logb, one_div, Real.log_inv]
      field_simp
    have ha10 : 10 < Real.logb 2 (1 / q) := by
      by_contra hcon
      push_neg at hcon
      have := mul_le_mul_of_nonneg_right hcon hl2.le
      linarith
    obtain ⟨n, hn⟩ : ∃ n : ℕ, bandOf q = n := ⟨_, rfl⟩
    have hn1 : (n : ℝ) < Real.logb 2 (1 / q) + 1 := by
      rw [← hn]; exact Nat.ceil_lt_add_one (by linarith)
    have hn11 : 11 ≤ n := by
      have h1 : Real.logb 2 (1 / q) ≤ (n : ℝ) := by
        rw [← hn]; exact Nat.le_ceil _
      have h2 : (10 : ℝ) < n := by linarith
      have h3 : 10 < n := by exact_mod_cast h2
      omega
    obtain ⟨L', hL'⟩ : ∃ L' : ℝ, L' = ((n - 4 : ℕ) : ℝ) := ⟨_, rfl⟩
    have hLc : L' = (n : ℝ) - 4 := by
      rw [hL', Nat.cast_sub (by omega)]; norm_num
    have hL'7 : 7 ≤ L' := by
      have : (11:ℝ) ≤ n := by exact_mod_cast hn11
      linarith
    have hL'log : L' * Real.log 2 ≤ -Real.log q := by
      have h := mul_lt_mul_of_pos_right hn1 hl2
      rw [hLc]
      nlinarith
    have hX0 : 0 < (2:ℝ) ^ ((1 + B.h) * L') := Real.rpow_pos_of_pos (by norm_num) _
    have hlogX : Real.log ((2:ℝ) ^ ((1 + B.h) * L') / L' ^ 2) ≤ (1 + B.h) * L' * Real.log 2 := by
      rw [Real.log_div hX0.ne' (pow_pos (by linarith) 2).ne', Real.log_rpow (by norm_num), Real.log_pow]
      have : 0 ≤ Real.log L' := Real.log_nonneg (by linarith)
      push_cast
      nlinarith
    have hcdef : coarseIdx B.h q = ⌊Real.logb Tgc ((2:ℝ) ^ ((1 + B.h) * L') / L' ^ 2)⌋ := by
      unfold coarseIdx bandIdx
      rw [hn, hL']
    have hc : ((coarseIdx B.h q : ℤ) : ℝ) ≤
        Real.log ((2:ℝ) ^ ((1 + B.h) * L') / L' ^ 2) / Real.log Tgc := by
      rw [hcdef]
      exact Int.floor_le _
    have key : Real.log Lgc * ((coarseIdx B.h q : ℤ) : ℝ) ≤
        Real.log Lgc * ((1 + B.h) * (-Real.log q) / Real.log Tgc) := by
      apply mul_le_mul_of_nonneg_left _ hlL.le
      refine hc.trans (div_le_div_of_nonneg_right ?_ hlT.le)
      calc _ ≤ (1 + B.h) * L' * Real.log 2 := hlogX
        _ = (1 + B.h) * (L' * Real.log 2) := by ring
        _ ≤ (1 + B.h) * (-Real.log q) := mul_le_mul_of_nonneg_left hL'log (by linarith)
    rw [← Real.rpow_intCast, Real.rpow_def_of_pos (show (0:ℝ) < Lgc by linarith),
      Real.rpow_def_of_pos hq0, Real.rpow_def_of_pos hq0, ← Real.exp_add]
    apply Real.exp_le_exp.mpr
    have e : Real.log Lgc * ((coarseIdx B.h q : ℤ) : ℝ) + Real.log q * (drx B.h / 2)
        - Real.log q * -(B.h * kapS) =
        Real.log Lgc * ((coarseIdx B.h q : ℤ) : ℝ)
        - Real.log Lgc * ((1 + B.h) * (-Real.log q) / Real.log Tgc) := by
      unfold drx; field_simp; ring
    linarith
  obtain ⟨a1, h1⟩ := pq5_vel_rep B G hok hG
  obtain ⟨a2, h2⟩ := pq5_transport_rep B G hok hG
  obtain ⟨a4, h4⟩ := pq5_label_disjoint B G hok hG
  obtain ⟨a5, h5⟩ := pq5_quad_class B G hok hG hcoarse
  refine ⟨a1 + a2 + a4 + a5, fun l0 hl0 hW0 htr hAw hvel hdiff => ?_⟩
  obtain ⟨hVs, hVm, hVsupp, hrep⟩ := h1 l0 (by omega) hAw hvel
  have hdisj := h4 l0 (by omega) (pq5Vw B G) (fun γ m => (hVs γ m).continuousOn) hVsupp
  obtain ⟨hT, hQ⟩ := h2 l0 (by omega) (pq5Vw B G) hVs hVm hVsupp hdisj hrep
  have hcls := h5 l0 (by omega) hW0 htr hAw hvel hdiff

  have hMs : ∀ (γ : Lab) (M : ℤ) (ξ : Cyl), M ≠ 2 → M ≠ -2 → M ≠ 0 →
      pq5QOf B G (pq5Vw B G) γ M ξ = 0 := by
    intro γ M ξ h2 hm2 h0
    unfold pq5QOf
    rw [Finset.sum_eq_zero, smul_zero]
    intro m hm
    rw [Finset.sum_eq_zero]
    intro m' hm'
    simp only [Finset.mem_insert, Finset.mem_singleton] at hm hm'
    rw [if_neg (show ¬ (m + m' = M) by omega), if_neg (show ¬ (m' - m = M) by omega), add_zero]
  generalize pq5QOf B G (pq5Vw B G) = Q at hT hQ hcls hMs

  have hsum : ∀ (F : Lab → ℤ → ℂ) (Γ : Finset Lab) (H : Finset ℤ),
      (∀ γ m, (γ ∉ Γ ∨ m ∉ H) → F γ m = 0) →
      ∑ᶠ γ : Lab, ∑ᶠ m : ℤ, F γ m = ∑ γ ∈ Γ, ∑ m ∈ H, F γ m := by
    intro F Γ H hF
    have hin : ∀ γ, ∑ᶠ m : ℤ, F γ m = ∑ m ∈ H, F γ m := by
      intro γ
      apply finsum_eq_sum_of_support_subset
      intro m hm
      rw [Function.mem_support] at hm
      by_contra h
      exact hm (hF γ m (Or.inr (by simpa using h)))
    simp_rw [hin]
    apply finsum_eq_sum_of_support_subset
    intro γ hγ
    rw [Function.mem_support] at hγ
    by_contra h
    exact hγ (Finset.sum_eq_zero (fun m _ => hF γ m (Or.inl (by simpa using h))))
  have hrot : ∀ r θ z : ℝ, 0 < r → rad (rotPt r θ z) = r ∧ rotPt r θ z 2 = z := by
    intro r θ z hr
    constructor
    · have h : (rotPt r θ z) 0 ^ 2 + (rotPt r θ z) 1 ^ 2 = r ^ 2 := by
        simp [rotPt]
        rw [mul_pow, mul_pow, ← mul_add, Real.cos_sq_add_sin_sq, mul_one]
      unfold rad
      rw [h, Real.sqrt_sq hr.le]
    · simp [rotPt]
  have hframe : ∀ (y : ℝ³), 0 < rad y → ∀ (v : Fin 3 → ℝ) (a : Fin 3),
      inner ℝ (cyl2cart y v) (![eR y, eTh y, eZ] a) = v a := by
    intro y hy v a
    have hr2 : rad y ^ 2 = y 0 ^ 2 + y 1 ^ 2 := Real.sq_sqrt (by positivity)
    have hne : rad y ≠ 0 := hy.ne'
    have hs : (rad y)⁻¹ ^ 2 * (y 0 ^ 2 + y 1 ^ 2) = 1 := by
      rw [← hr2]; field_simp
    fin_cases a <;>
      simp [cyl2cart, eR, eTh, eZ, radVec, azVec, PiLp.inner_apply, Fin.sum_univ_three] <;>
      first
      | linear_combination (v 0) * hs
      | linear_combination (v 1) * hs
  have hthA : ∀ (c z : ℝ) (f : ℝ → ℝ), Continuous f → thA f = 0 →
      thA (fun θ => c * (z + f θ)) = c * z := by
    intro c z f hf h0
    have hpi : (2 * Real.pi) ≠ 0 := by positivity
    have hI : ∫ θ in (0:ℝ)..(2 * Real.pi), f θ = 0 := by
      unfold thA at h0
      rcases mul_eq_zero.mp h0 with h | h
      · exact absurd h (inv_ne_zero hpi)
      · exact h
    unfold thA
    rw [intervalIntegral.integral_const_mul, intervalIntegral.integral_add
      (continuous_const.intervalIntegrable _ _) (hf.intervalIntegrable _ _),
      intervalIntegral.integral_const, hI, smul_eq_mul, sub_zero, add_zero]
    calc (2 * Real.pi)⁻¹ * (c * (2 * Real.pi * z)) = c * z * ((2 * Real.pi)⁻¹ * (2 * Real.pi)) := by
          ring
      _ = c * z := by rw [inv_mul_cancel₀ hpi, mul_one]
  refine ⟨pq5Osc Q, hcls, ?_⟩
  intro x t Y hxt
  have hxt' : 0 < rad x ∧ t < 1 ∧ simScale B.h (x 2) (1 - t) < qsOf l0 := hxt
  have hξ : ptOf x t Y ∈ DomC B.h (qsOf l0) := hxt
  have hrx : 0 < rad x := hxt'.1
  obtain ⟨T, hTz⟩ := hT _ hξ
  have hQH : ∀ γ m, (γ ∉ T ∨ m ∉ ({0, 2, -2} : Finset ℤ)) → Q γ m (ptOf x t Y) = 0 := by
    intro γ m h
    rcases h with h | h
    · exact hTz γ m h
    · simp only [Finset.mem_insert, Finset.mem_singleton, not_or] at h
      exact hMs γ m _ h.2.1 h.2.2 h.1
  have hOH : ∀ γ m, (γ ∉ T ∨ m ∉ ({0, 2, -2} : Finset ℤ)) → pq5Osc Q γ m (ptOf x t Y) = 0 := by
    intro γ m h
    unfold pq5Osc
    split_ifs
    · rfl
    · exact hQH γ m h

  have hsplit : ∀ θ', waveV5 B G Q θ' (ptOf x t Y) =
      (fun i => (∑ γ ∈ T, Q γ 0 (ptOf x t Y) i).re) + waveV5 B G (pq5Osc Q) θ' (ptOf x t Y) := by
    intro θ'
    funext i
    have e1 : ∑ᶠ γ : Lab, ∑ᶠ m : ℤ, Q γ m (ptOf x t Y) i * ephase5 B G γ m θ' (ptOf x t Y) =
        ∑ γ ∈ T, ∑ m ∈ ({0, 2, -2} : Finset ℤ), Q γ m (ptOf x t Y) i * ephase5 B G γ m θ' (ptOf x t Y) :=
      hsum _ T _ (fun γ m h => by simp only [hQH γ m h, Pi.zero_apply, zero_mul])
    have e2 : ∑ᶠ γ : Lab, ∑ᶠ m : ℤ, pq5Osc Q γ m (ptOf x t Y) i * ephase5 B G γ m θ' (ptOf x t Y) =
        ∑ γ ∈ T, ∑ m ∈ ({0, 2, -2} : Finset ℤ),
          pq5Osc Q γ m (ptOf x t Y) i * ephase5 B G γ m θ' (ptOf x t Y) :=
      hsum _ T _ (fun γ m h => by simp only [hOH γ m h, Pi.zero_apply, zero_mul])
    show (∑ᶠ γ : Lab, ∑ᶠ m : ℤ, Q γ m (ptOf x t Y) i * ephase5 B G γ m θ' (ptOf x t Y)).re =
      (∑ γ ∈ T, Q γ 0 (ptOf x t Y) i).re +
        (∑ᶠ γ : Lab, ∑ᶠ m : ℤ, pq5Osc Q γ m (ptOf x t Y) i * ephase5 B G γ m θ' (ptOf x t Y)).re
    rw [e1, e2, ← Complex.add_re, ← Finset.sum_add_distrib]
    congr 1
    refine Finset.sum_congr rfl (fun γ _ => ?_)
    have h0H : (0:ℤ) ∈ ({0, 2, -2} : Finset ℤ) := Finset.mem_insert_self _ _
    have hind : Q γ 0 (ptOf x t Y) i = ∑ m ∈ ({0, 2, -2} : Finset ℤ),
        (if m = 0 then Q γ m (ptOf x t Y) i else 0) := by
      rw [Finset.sum_ite_eq', if_pos h0H]
    rw [hind, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl (fun m _ => ?_)
    by_cases hm : m = 0
    · subst hm
      simp [pq5Osc, ephase5]
    · simp [pq5Osc, hm]

  have hmean : thAvgVec (pwrQ B G l0) x t Y = cyl2cart x (fun a =>
      qC B.h (ptOf x t Y) ^ (-(2 * Aex B.h + 1/2)) * (∑ γ ∈ T, Q γ 0 (ptOf x t Y) a).re) := by
    unfold thAvgVec
    congr 1
    funext a
    have hfun : (fun θ => inner ℝ (pwrQ B G l0 (rotPt (rad x) θ (x 2)) t Y) (frameAt θ (ptOf x t Y) a)) =
        fun θ => qC B.h (ptOf x t Y) ^ (-(2 * Aex B.h + 1/2)) *
          ((∑ γ ∈ T, Q γ 0 (ptOf x t Y) a).re +
            waveS5 B G (fun γ m η => pq5Osc Q γ m η a) (thetaOf (rotPt (rad x) θ (x 2))) (ptOf x t Y)) := by
      funext θ
      obtain ⟨hr, hzz⟩ := hrot (rad x) θ (x 2) hrx
      have hc : corrOn B l0 (rotPt (rad x) θ (x 2)) t := by
        show 0 < rad (rotPt (rad x) θ (x 2)) ∧ t < 1 ∧
          simScale B.h ((rotPt (rad x) θ (x 2)) 2) (1 - t) < qsOf l0
        rw [hr, hzz]
        exact hxt'
      have hp : ptOf (rotPt (rad x) θ (x 2)) t Y = ptOf x t Y := by
        show (rad (rotPt (rad x) θ (x 2)), (rotPt (rad x) θ (x 2)) 2, t, Y) = (rad x, x 2, t, Y)
        rw [hr, hzz]
      rw [hQ _ t Y hc, hp, real_inner_smul_left]
      have hf : frameAt θ (ptOf x t Y) a =
          ![eR (rotPt (rad x) θ (x 2)), eTh (rotPt (rad x) θ (x 2)), eZ] a := rfl
      rw [hf, hframe _ (by rw [hr]; exact hrx), hsplit]
      rfl
    have hm1 : ∀ γ m, m ∉ ({2, -2} : Finset ℤ) → pq5Osc Q γ m (ptOf x t Y) a = 0 := by
      intro γ m hm
      simp only [Finset.mem_insert, Finset.mem_singleton, not_or] at hm
      unfold pq5Osc
      split_ifs with h0
      · rfl
      · exact congrFun (hMs γ m _ hm.1 hm.2 h0) a
    have hm2 : ∀ γ m, γ ∉ T → pq5Osc Q γ m (ptOf x t Y) a = 0 := by
      intro γ m hγ
      exact congrFun (hOH γ m (Or.inl hγ)) a
    obtain ⟨hcont, hz⟩ := waveS5_circle_mean_zero B G (fun γ m η => pq5Osc Q γ m η a) (ptOf x t Y)
      (rad x) (x 2) ({2, -2} : Finset ℤ) T hrx (by simp) hm1 hm2
    rw [hfun]
    exact hthA _ _ _ hcont hz
  rw [hmean, hQ x t Y hxt, hsplit]
  simp only [cyl2cart, Pi.add_apply, add_smul, smul_add, smul_smul]
  abel

theorem prim_wave_residual_v5 : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ l0 : ℕ,
    l1 ≤ l0 → InWg5 B G (qsOf l0) (1/2) (W0h4 B G) →
    (∀ (γ : Lab), ∀ ξ ∈ DomC B.h (qsOf l0), dotProduct (nPhi5 B G γ ξ) (W0c4 B G γ ξ) = 0) →
    InWg5 B G (qsOf l0) 1 (primState5 B G).Aw → InWg5 B G (qsOf l0) 1 (primState5 B G).pw →
    InWg5 B G (qsOf l0) (1/2) (velW5 B G (primState5 B G).Aw) →
    InWg5 B G (qsOf l0) (1 - kapS) (velW5 B G (primState5 B G).Aw - W0h4 B G) →
    (∀ (a : Fin 3), ∀ ξ ∈ DomC B.h (qsOf l0), mcor5 B G l0 (primState5 B G) a ξ = 0) →
    ∃ (f : WC) (Fl : Ext ℝ³), InWg5 B G (qsOf l0) (1 - 3 * kapS) f ∧ FlatX B (qsOf l0) Fl ∧
      ∀ x t Y, corrOn B l0 x t →
        resX B.h (uX5 B G l0 (primState5 B G)) (PX5 B G l0 (primState5 B G)) x t Y -
          thAvgVec (resX B.h (uX5 B G l0 (primState5 B G)) (PX5 B G l0 (primState5 B G))) x t Y =
        (qC B.h (ptOf x t Y) ^ (-(2 * Aex B.h + 1/2))) • cyl2cart x (waveV5 B G f (thetaOf x) (ptOf x t Y))
          + Fl x t Y :=
by
  intro B G hok hG
  obtain ⟨a1, h1⟩ := pwr5_split_identity B G hok hG
  obtain ⟨a2, h2⟩ := pwr5_base_flat B hok
  obtain ⟨a3, h3⟩ := pwr5_linear_harmonics B G hok hG
  obtain ⟨a4, h4⟩ := pwr5_quadratic_harmonics B G hok hG
  refine ⟨a1 + a2 + a3 + a4, fun l0 hl0 hW0 htr hAw hpw hvel hdiff hm0 => ?_⟩
  have hk : kapS = 1 / 100000 := rfl
  have hS : SimScaleProps B.h := hok.1
  have hXa : 0 < B.Xa := hok.2.1.2.2.1
  have hq1 : qsOf l0 ≤ 1 := by
    show (2:ℝ) ^ (-(l0:ℝ)) ≤ 1
    exact Real.rpow_le_one_of_one_le_of_nonpos (by norm_num) (by simp)
  have hid := h1 l0 (by omega) hAw hpw hm0
  obtain ⟨hFB, hFBs⟩ := h2 l0 (by omega)
  obtain ⟨g1, Fl1, hg1, hFl1, e1⟩ := h3 l0 (by omega) hW0 htr hAw hpw hvel hdiff
  obtain ⟨g2, hg2, e2⟩ := h4 l0 (by omega) hW0 htr hAw hvel hdiff
  obtain ⟨hcls, hadd⟩ := pwr5_waveV_add B G hok (qsOf l0) hq1 g1 g2 _ _ hg1 hg2
  have hmin : min (1 - 3 * kapS) (1 - kapS) = 1 - 3 * kapS := min_eq_left (by rw [hk]; norm_num)
  rw [hmin] at hcls

  have hcont : ContinuousOn (fun z : ℝ³ × ℝ => simScale B.h (z.1 2) (1 - z.2)) {z | z.2 < 1} := by
    have h4c := hS.2.2.2.1.continuousOn
    have hm : MapsTo (fun z : ℝ³ × ℝ => (z.1 2, 1 - z.2)) {z | z.2 < 1} (univ ×ˢ Ioi 0) := by
      intro z hz
      have hz' : z.2 < 1 := hz
      exact ⟨mem_univ _, show (0:ℝ) < 1 - z.2 by linarith⟩
    exact h4c.comp (f := fun z : ℝ³ × ℝ => (z.1 2, 1 - z.2)) (Continuous.continuousOn (by fun_prop)) hm
  have hradc : Continuous (fun z : ℝ³ × ℝ => rad z.1) := by
    unfold rad
    fun_prop
  have hsimO : IsOpen (simDomain B.h (qsOf l0)) := by
    have e : simDomain B.h (qsOf l0) = {z : ℝ³ × ℝ | z.2 < 1} ∩
        (fun z : ℝ³ × ℝ => simScale B.h (z.1 2) (1 - z.2)) ⁻¹' Iio (qsOf l0) := by
      ext z
      exact Iff.rfl
    rw [e]
    exact hcont.isOpen_inter_preimage (isOpen_lt continuous_snd continuous_const) isOpen_Iio
  have hCO : IsOpen {z : ℝ³ × ℝ | corrOn B l0 z.1 z.2} := by
    have e : {z : ℝ³ × ℝ | corrOn B l0 z.1 z.2} = {z : ℝ³ × ℝ | 0 < rad z.1} ∩ simDomain B.h (qsOf l0) := by
      ext z
      exact Iff.rfl
    rw [e]
    exact (isOpen_lt continuous_const hradc).inter hsimO
  have hφ : ContinuousOn (fun z : ℝ³ × ℝ => 2 * B.Xa * simScale B.h (z.1 2) (1 - z.2) - rad z.1 ^ 2)
      (simDomain B.h (qsOf l0)) :=
    (continuousOn_const.mul (hcont.mono (fun z hz => hz.1))).sub (hradc.pow 2).continuousOn
  have hUo := hφ.isOpen_inter_preimage hsimO (isOpen_Ioi (a := (0:ℝ)))
  refine ⟨g1 + g2, fun x t Y => pwrFB B x t Y + Fl1 x t Y, hcls, ?_, ?_⟩
  ·
    intro m N
    obtain ⟨C1, hC1⟩ := hFB m N
    obtain ⟨C2, hC2⟩ := hFl1.1 m N
    refine ⟨C1 + |C2|, fun Y₀ x t hxt => ?_⟩
    have hxt' : t < 1 ∧ simScale B.h (x 2) (1 - t) < qsOf l0 := hxt
    have hq0 : 0 < simScale B.h (x 2) (1 - t) := (hS.1 (x 2) (1 - t) (by linarith [hxt'.1])).1
    have hqN : 0 ≤ simScale B.h (x 2) (1 - t) ^ (N:ℝ) := Real.rpow_nonneg hq0.le _
    have b1 := hC1 Y₀ x t hxt
    have b2 := hC2 Y₀ x t hxt
    have hb2 : C2 * simScale B.h (x 2) (1 - t) ^ (N:ℝ) ≤ |C2| * simScale B.h (x 2) (1 - t) ^ (N:ℝ) :=
      mul_le_mul_of_nonneg_right (le_abs_self _) hqN
    have hb2' : 0 ≤ |C2| * simScale B.h (x 2) (1 - t) ^ (N:ℝ) := mul_nonneg (abs_nonneg _) hqN
    have hev : (↿(evOff B.h (fun x t Y => pwrFB B x t Y + Fl1 x t Y) Y₀)) =
        (↿(evOff B.h (pwrFB B) Y₀)) + (↿(evOff B.h Fl1 Y₀)) := rfl
    have hr0 : 0 ≤ rad x := Real.sqrt_nonneg _
    rcases hr0.lt_or_eq with hr | hr
    · have hmem : (x, t) ∈ {z : ℝ³ × ℝ | corrOn B l0 z.1 z.2} :=
        show 0 < rad x ∧ t < 1 ∧ simScale B.h (x 2) (1 - t) < qsOf l0 from ⟨hr, hxt'.1, hxt'.2⟩
      have hd1 : ContDiffAt ℝ ∞ (↿(evOff B.h (pwrFB B) Y₀)) (x, t) :=
        (hFBs Y₀).contDiffAt (hCO.mem_nhds hmem)
      have hd2 : ContDiffAt ℝ ∞ (↿(evOff B.h Fl1 Y₀)) (x, t) :=
        (hFl1.2.1 Y₀).contDiffAt (hsimO.mem_nhds hxt)
      rw [hev, iteratedFDeriv_add_apply (hd1.of_le (by exact_mod_cast le_top))
        (hd2.of_le (by exact_mod_cast le_top))]
      calc _ ≤ _ := norm_add_le _ _
        _ ≤ C1 * simScale B.h (x 2) (1 - t) ^ (N:ℝ) + C2 * simScale B.h (x 2) (1 - t) ^ (N:ℝ) :=
          add_le_add b1 b2
        _ ≤ _ := by linarith
    · have hmemU : (x, t) ∈ simDomain B.h (qsOf l0) ∩
          (fun z : ℝ³ × ℝ => 2 * B.Xa * simScale B.h (z.1 2) (1 - z.2) - rad z.1 ^ 2) ⁻¹' Ioi 0 := by
        refine ⟨hxt, ?_⟩
        show (0:ℝ) < 2 * B.Xa * simScale B.h (x 2) (1 - t) - rad x ^ 2
        rw [← hr]
        have hp := mul_pos (mul_pos (two_pos : (0:ℝ) < 2) hXa) hq0
        simpa using hp
      have hev2 : (↿(evOff B.h (fun x t Y => pwrFB B x t Y + Fl1 x t Y) Y₀)) =ᶠ[nhds (x, t)]
          (↿(evOff B.h (pwrFB B) Y₀)) := by
        filter_upwards [hUo.mem_nhds hmemU] with z hz
        have hz2 : (0:ℝ) < 2 * B.Xa * simScale B.h (z.1 2) (1 - z.2) - rad z.1 ^ 2 := hz.2
        have h0 : Fl1 z.1 z.2 (Yph B.h (rad z.1) z.2 + Y₀) = 0 :=
          hFl1.2.2 z.1 z.2 _ hz.1 (by linarith)
        show pwrFB B z.1 z.2 (Yph B.h (rad z.1) z.2 + Y₀) + Fl1 z.1 z.2 (Yph B.h (rad z.1) z.2 + Y₀) =
          pwrFB B z.1 z.2 (Yph B.h (rad z.1) z.2 + Y₀)
        rw [h0, add_zero]
      rw [(hev2.iteratedFDeriv ℝ m).eq_of_nhds]
      linarith
  ·
    intro x t Y hxt
    rw [hid x t Y hxt, e1 x t Y hxt, e2 x t Y hxt]
    have hdom : ptOf x t Y ∈ DomC B.h (qsOf l0) := hxt
    rw [hadd (thetaOf x) (ptOf x t Y) hdom]
    have hc : ∀ (u v : Fin 3 → ℝ), cyl2cart x (u + v) = cyl2cart x u + cyl2cart x v := by
      intro u v
      simp only [cyl2cart, Pi.add_apply, add_smul]
      abel
    rw [hc, smul_add]
    beta_reduce
    generalize pwrFB B x t Y = A1
    generalize Fl1 x t Y = A2
    generalize qC B.h (ptOf x t Y) ^ (-(2 * Aex B.h + 1/2)) • cyl2cart x (waveV5 B G g1 (thetaOf x) (ptOf x t Y)) = A3
    generalize qC B.h (ptOf x t Y) ^ (-(2 * Aex B.h + 1/2)) • cyl2cart x (waveV5 B G g2 (thetaOf x) (ptOf x t Y)) = A4
    abel

theorem theta_diag_average5 : ∀ (B : BG) (G : CorrGeom), GeomPrim5 B G →
    ∀ (c c' : Lab → Cyl → (Fin 3 → ℝ)) (η : Cyl) (F : Finset Lab) (b : Fin 3), η ∈ DomC B.h B.qB →
    (∀ γ : Lab, etaL B.h γ η ≠ 0 → γ ∈ F) →
    (∀ γ : Lab, c γ η ≠ 0 → G.lmin ≤ γ.1 ∧ inRect B.h γ (G.ctr γ) (2 * G.r0) η.2.2.2 ∧ etaL B.h γ η ≠ 0) →
    (∀ γ : Lab, c' γ η ≠ 0 → G.lmin ≤ γ.1 ∧ inRect B.h γ (G.ctr γ) (2 * G.r0) η.2.2.2 ∧ etaL B.h γ η ≠ 0) →
    thA (fun θ => covT5 B G c c' 0 b θ η + covT5 B G c' c 0 b θ η) =
      ∑ γ ∈ F, 2 * (qC B.h η ^ (-B.h) * Qb γ.1 ^ (-(1/2:ℝ))) ^ 2 *
        (c γ η 0 * c' γ η b + c' γ η 0 * c γ η b) :=
by
  intro B G hG c c' η F b hη hF hc hc'

  have hcos : ∀ (p : ℤ) (φ : ℝ), p ≠ 0 →
      ∫ θ in (0:ℝ)..(2 * Real.pi), Real.cos ((p : ℝ) * θ + φ) ^ 2 = Real.pi := by
    intro p φ hp
    have hP : (p : ℝ) ≠ 0 := Int.cast_ne_zero.mpr hp
    have h1 := intervalIntegral.integral_comp_mul_add (a := 0) (b := 2 * Real.pi)
      (fun x => Real.cos x ^ 2) hP φ
    rw [h1, integral_cos_sq]
    have e : (p:ℝ) * (2 * Real.pi) + φ = φ + (p:ℝ) * (2 * Real.pi) := by ring
    rw [e, Real.cos_add_int_mul_two_pi, Real.sin_add_int_mul_two_pi, mul_zero, zero_add, smul_eq_mul]
    have e2 : Real.cos φ * Real.sin φ - Real.cos φ * Real.sin φ + (φ + (p:ℝ) * (2 * Real.pi)) - φ =
        (p:ℝ) * (2 * Real.pi) := by ring
    rw [e2]
    field_simp

  have hp0 : ∀ γ, pint5 B G γ ≠ 0 := by
    intro γ
    unfold pint5
    split_ifs with h
    · exact one_ne_zero
    · exact h

  have hsupp : ∀ (d : Lab → Cyl → (Fin 3 → ℝ)) (e : Fin 3) (θ : ℝ) (γ : Lab),
      tPart5 B G d γ θ η e ≠ 0 → d γ η ≠ 0 := by
    intro d e θ γ h hz
    apply h
    simp [tPart5, hz]

  have hdiag : ∀ (d d' : Lab → Cyl → (Fin 3 → ℝ)),
      (∀ γ : Lab, d γ η ≠ 0 → G.lmin ≤ γ.1 ∧ inRect B.h γ (G.ctr γ) (2 * G.r0) η.2.2.2 ∧ etaL B.h γ η ≠ 0) →
      (∀ γ : Lab, d' γ η ≠ 0 → G.lmin ≤ γ.1 ∧ inRect B.h γ (G.ctr γ) (2 * G.r0) η.2.2.2 ∧ etaL B.h γ η ≠ 0) →
      ∀ (e e' : Fin 3) (θ : ℝ),
      covT5 B G d d' e e' θ η = ∑ γ ∈ F, tPart5 B G d γ θ η e * tPart5 B G d' γ θ η e' := by
    intro d d' hd hd' e e' θ
    unfold covT5
    rw [finsum_eq_sum_of_support_subset (s := F) _
        (fun γ hγ => Finset.mem_coe.mpr (hF γ (hd γ (hsupp d e θ γ hγ)).2.2)),
      finsum_eq_sum_of_support_subset (s := F) _
        (fun γ hγ => Finset.mem_coe.mpr (hF γ (hd' γ (hsupp d' e' θ γ hγ)).2.2)),
      Finset.sum_mul_sum]
    apply Finset.sum_congr rfl
    intro γ hγ
    apply Finset.sum_eq_single γ
    · intro γ' _ hne
      by_contra hprod
      obtain ⟨h1, h2⟩ := mul_ne_zero_iff.mp hprod
      obtain ⟨l1, r1, e1⟩ := hd γ (hsupp d e θ γ h1)
      obtain ⟨l2, r2, e2⟩ := hd' γ' (hsupp d' e' θ γ' h2)
      have hdisj := hG.2.1 γ γ' (Ne.symm hne) l1 l2 ⟨η, hη, e1, e2⟩
      have m1 : η.2.2.2 ∈ rectAbs B G γ (2 * G.r0) := r1
      have m2 : η.2.2.2 ∈ rectAbs B G γ' (2 * G.r0) := r2
      exact Set.disjoint_left.mp hdisj (subset_closure m1) (subset_closure m2)
    · intro h
      exact absurd hγ h

  have hpt : ∀ θ : ℝ, covT5 B G c c' 0 b θ η + covT5 B G c' c 0 b θ η =
      ∑ γ ∈ F, (4 * (qC B.h η ^ (-B.h) * Qb γ.1 ^ (-(1/2:ℝ))) ^ 2 *
        (c γ η 0 * c' γ η b + c' γ η 0 * c γ η b)) *
        Real.cos ((pint5 B G γ : ℝ) * θ + (kb B.h γ.1 : ℝ) * phiL5 B G γ η) ^ 2 := by
    intro θ
    rw [hdiag c c' hc hc' 0 b θ, hdiag c' c hc' hc 0 b θ, ← Finset.sum_add_distrib]
    apply Finset.sum_congr rfl
    intro γ _
    simp only [tPart5]
    ring
  have hfun : (fun θ : ℝ => covT5 B G c c' 0 b θ η + covT5 B G c' c 0 b θ η) =
      fun θ : ℝ => ∑ γ ∈ F, (4 * (qC B.h η ^ (-B.h) * Qb γ.1 ^ (-(1/2:ℝ))) ^ 2 *
        (c γ η 0 * c' γ η b + c' γ η 0 * c γ η b)) *
        Real.cos ((pint5 B G γ : ℝ) * θ + (kb B.h γ.1 : ℝ) * phiL5 B G γ η) ^ 2 := funext hpt
  unfold thA
  rw [hfun, intervalIntegral.integral_finsetSum
      (fun γ _ => Continuous.intervalIntegrable (by fun_prop) _ _), Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro γ _
  rw [intervalIntegral.integral_const_mul, hcos _ _ (hp0 γ)]
  have hpi : Real.pi ≠ 0 := Real.pi_ne_zero
  field_simp
  ring

theorem torus_jpow_average : ∀ (Φ : ℝ × ℝ → ℝ) (n : ℕ) (c : ℝ × ℝ), Continuous Φ →
    (∀ w : ℝ × ℝ, (1/4 ≤ |w.1| ∨ 1/4 ≤ |w.2|) → Φ w = 0) →
    MeasureTheory.IntegrableOn (fun Y : ℝ × ℝ => Φ (frac0 (Jpow (n : ℤ) Y - c)))
      (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1) ∧
    ∫ Y in (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1), Φ (frac0 (Jpow (n : ℤ) Y - c)) = ∫ w : ℝ × ℝ, Φ w :=
by
  intro Φ n c hΦ hv

  have tL1 : (∀ Y : ℝ × ℝ, Jpow 0 Y = Y) ∧ ∀ (n : ℤ) (Y : ℝ × ℝ),
      Jpow (n + 1) Y = (3 * (Jpow n Y).1 + (Jpow n Y).2, (Jpow n Y).1 + 5 * (Jpow n Y).2) := by
    have hs : Real.sqrt 2 ^ 2 = 2 := Real.sq_sqrt (by norm_num)
    have hs0 := Real.sqrt_nonneg 2
    have hs4 : Real.sqrt 2 < 4 := by nlinarith
    have hc : bgc ^ 2 = 1 - 2 * bgc := by unfold bgc; linear_combination hs
    have hD : (1 + bgc ^ 2) ≠ 0 := by positivity
    have hL : Lgc ≠ 0 := (by unfold Lgc; linarith : (0:ℝ) < Lgc).ne'
    have hT : Tgc ≠ 0 := (by unfold Tgc; linarith : (0:ℝ) < Tgc).ne'
    have hLc : Lgc = 3 - bgc := by unfold Lgc bgc; ring
    have hTc : Tgc = bgc + 5 := by unfold Tgc bgc; ring
    constructor
    · intro Y
      unfold Jpow
      simp only [zpow_zero, one_mul, vrv, vtv]
      ext
      · simp only [Prod.fst_add, Prod.smul_fst, smul_eq_mul]
        field_simp
        ring
      · simp only [Prod.snd_add, Prod.smul_snd, smul_eq_mul]
        field_simp
        ring
    · intro n Y
      unfold Jpow
      rw [zpow_add_one₀ hL, zpow_add_one₀ hT]
      generalize Lgc ^ n = p
      generalize Tgc ^ n = q
      generalize (Y.1 - bgc * Y.2) / (1 + bgc ^ 2) = a
      generalize (bgc * Y.1 + Y.2) / (1 + bgc ^ 2) = b
      rw [hLc, hTc]
      simp only [vrv, vtv, Prod.smul_mk, Prod.mk_add_mk, smul_eq_mul, Prod.mk.injEq]
      constructor
      · linear_combination (q * b) * hc
      · linear_combination (p * a) * hc

  have tL3 : ∀ G : ℝ × ℝ → ℝ, ∫ Y in (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1), G (Y.2, Y.1) =
      ∫ Y in (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1), G Y := by
    intro G
    have h : (MeasureTheory.volume : MeasureTheory.Measure (ℝ × ℝ)).restrict
        (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1) =
        (MeasureTheory.volume.restrict (Set.Icc (0:ℝ) 1)).prod
          (MeasureTheory.volume.restrict (Set.Icc (0:ℝ) 1)) := by
      rw [MeasureTheory.Measure.volume_eq_prod, MeasureTheory.Measure.prod_restrict]
    rw [h]
    exact MeasureTheory.integral_prod_swap G

  have tL2 : ∀ (G : ℝ × ℝ → ℝ) (m k : ℤ) (a : ℝ), Continuous G →
      (∀ w : ℝ × ℝ, G (w.1, w.2 + 1) = G w) →
      m ≠ 0 → ∀ F : ℝ × ℝ → ℝ, (∀ Y : ℝ × ℝ, F Y = G (Y.1, (m:ℝ) * Y.2 + (k:ℝ) * Y.1 + a)) →
      ∫ Y in (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1), F Y =
        ∫ Y in (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1), G Y := by
    intro G m k a hG hp hm F hF
    simp_rw [hF]
    have hK : IsCompact (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1) := isCompact_Icc.prod isCompact_Icc
    have hc1 : Continuous (fun Y : ℝ × ℝ => G (Y.1, (m : ℝ) * Y.2 + (k : ℝ) * Y.1 + a)) := by
      fun_prop
    have hi1 := hc1.continuousOn.integrableOn_compact (μ := MeasureTheory.volume) hK
    have hi2 := hG.continuousOn.integrableOn_compact (μ := MeasureTheory.volume) hK
    rw [MeasureTheory.Measure.volume_eq_prod] at hi1 hi2 ⊢
    rw [MeasureTheory.setIntegral_prod _ hi1, MeasureTheory.setIntegral_prod _ hi2]
    refine MeasureTheory.setIntegral_congr_fun measurableSet_Icc (fun x _ => ?_)
    simp only
    simp_rw [add_assoc]
    have hM : (m:ℝ) ≠ 0 := Int.cast_ne_zero.mpr hm
    have hgc : Continuous (fun y => G (x, y)) := by fun_prop
    have hgp : Function.Periodic (fun y => G (x, y)) 1 := fun y => hp (x, y)
    have h1 := intervalIntegral.integral_comp_mul_add (a := 0) (b := 1) (fun y => G (x, y)) hM
      ((k:ℝ) * x + a)
    have h2 := hgp.intervalIntegral_add_zsmul_eq m ((k:ℝ) * x + a)
      (fun t1 t2 => hgc.intervalIntegrable t1 t2)
    have h3 := hgp.intervalIntegral_add_eq ((k:ℝ) * x + a) 0
    simp only [mul_zero, zero_add, mul_one, zsmul_eq_mul, smul_eq_mul] at h1 h2 h3
    rw [MeasureTheory.integral_Icc_eq_integral_Ioc, ← intervalIntegral.integral_of_le zero_le_one,
      MeasureTheory.integral_Icc_eq_integral_Ioc, ← intervalIntegral.integral_of_le zero_le_one]
    rw [h1, add_comm (m:ℝ) ((k:ℝ) * x + a), h2, h3, ← mul_assoc, inv_mul_cancel₀ hM, one_mul]

  have tL4 : Continuous (fun w : ℝ × ℝ => Φ (frac0 w)) ∧
      (∀ w : ℝ × ℝ, Φ (frac0 (w.1 + 1, w.2)) = Φ (frac0 w) ∧
        Φ (frac0 (w.1, w.2 + 1)) = Φ (frac0 w)) ∧
      (∀ w : ℝ × ℝ, |w.1| ≤ 1/2 → |w.2| ≤ 1/2 → Φ (frac0 w) = Φ w) := by
    have K : ∀ x0 : ℝ, ∃ n : ℤ, ∃ U : Set ℝ, IsOpen U ∧ x0 ∈ U ∧ ∀ x ∈ U,
        (x - ((round x : ℤ) : ℝ) = x - n) ∨ (1/4 ≤ |x - ((round x : ℤ) : ℝ)| ∧ 1/4 ≤ |x - n|) := by
      intro x0
      refine ⟨round x0, ?_⟩
      by_cases h : |x0 - ((round x0 : ℤ) : ℝ)| < 1/2
      · refine ⟨Set.Ioo (((round x0 : ℤ) : ℝ) - 1/2) (((round x0 : ℤ) : ℝ) + 1/2), isOpen_Ioo, ?_, ?_⟩
        · rw [abs_lt] at h
          constructor <;> linarith
        · intro x hx
          left
          have : round x = round x0 := by
            rw [round_eq, Int.floor_eq_iff]
            constructor <;> linarith [hx.1, hx.2]
          rw [this]
      · push_neg at h
        refine ⟨Set.Ioo (x0 - 1/4) (x0 + 1/4), isOpen_Ioo, ⟨by linarith, by linarith⟩, ?_⟩
        intro x hx
        right
        have hk : ∀ k : ℤ, 1/4 ≤ |x - (k:ℝ)| := by
          intro k
          have h1 := round_le x0 k
          have h2 : |x - x0| < 1/4 := by
            rw [abs_lt]; constructor <;> linarith [hx.1, hx.2]
          have h3 := abs_sub_abs_le_abs_sub (x0 - k) (x - k)
          have h4 : (x0 - k) - (x - k) = -(x - x0) := by ring
          rw [h4, abs_neg] at h3
          linarith
        exact ⟨hk _, hk _⟩
    have hcont : Continuous (fun w : ℝ × ℝ => Φ (frac0 w)) := by
      rw [continuous_iff_continuousAt]
      intro w0
      obtain ⟨n, U, hU, hxU, hUp⟩ := K w0.1
      obtain ⟨m, V, hV, hyV, hVp⟩ := K w0.2
      have hev : (fun w : ℝ × ℝ => Φ (w.1 - n, w.2 - m)) =ᶠ[nhds w0] (fun w => Φ (frac0 w)) := by
        filter_upwards [(hU.prod hV).mem_nhds ⟨hxU, hyV⟩] with w hw
        obtain ⟨hw1, hw2⟩ := hw
        simp only [frac0]
        rcases hUp w.1 hw1 with h1 | h1
        · rcases hVp w.2 hw2 with h2 | h2
          · rw [h1, h2]
          · rw [hv (w.1 - n, w.2 - m) (Or.inr h2.2),
              hv (w.1 - ((round w.1 : ℤ) : ℝ), w.2 - ((round w.2 : ℤ) : ℝ)) (Or.inr h2.1)]
        · rw [hv (w.1 - n, w.2 - m) (Or.inl h1.2),
            hv (w.1 - ((round w.1 : ℤ) : ℝ), w.2 - ((round w.2 : ℤ) : ℝ)) (Or.inl h1.1)]
      exact ContinuousAt.congr
        ((by fun_prop : Continuous fun w : ℝ × ℝ => Φ (w.1 - n, w.2 - m)).continuousAt) hev
    have hper : ∀ w : ℝ × ℝ, Φ (frac0 (w.1 + 1, w.2)) = Φ (frac0 w) ∧
        Φ (frac0 (w.1, w.2 + 1)) = Φ (frac0 w) := by
      intro w
      refine ⟨congrArg Φ (Prod.ext ?_ ?_), congrArg Φ (Prod.ext ?_ ?_)⟩ <;>
        simp only [frac0, round_add_one, Int.cast_add, Int.cast_one] <;> ring
    have h1d : ∀ x : ℝ, |x| ≤ 1/2 → (x - ((round x : ℤ) : ℝ) = x) ∨
        (1/4 ≤ |x - ((round x : ℤ) : ℝ)| ∧ 1/4 ≤ |x|) := by
      intro x hx
      rw [abs_le] at hx
      by_cases hs : |x| < 1/4
      · left
        have : round x = 0 := by
          rw [round_eq_zero_iff]
          rw [abs_lt] at hs
          constructor <;> linarith
        rw [this]; simp
      · right
        push_neg at hs
        refine ⟨?_, hs⟩
        have a1 := sub_half_lt_round x
        have a2 := round_le_add_half x
        have b1 : (-1:ℝ) < ((round x : ℤ) : ℝ) := by linarith
        have b2 : ((round x : ℤ) : ℝ) ≤ 1 := by linarith
        have c1 : (-1:ℤ) < round x := by exact_mod_cast b1
        have c2 : round x ≤ 1 := by exact_mod_cast b2
        rcases (show round x = 0 ∨ round x = 1 by omega) with h | h
        · rw [h]; simpa using hs
        · have hx2 : x = 1/2 := by
            rw [h] at a2; push_cast at a2; linarith
          rw [h, hx2, le_abs]
          right
          norm_num
    have hbox : ∀ w : ℝ × ℝ, |w.1| ≤ 1/2 → |w.2| ≤ 1/2 → Φ (frac0 w) = Φ w := by
      intro w h1 h2
      simp only [frac0]
      rcases h1d w.1 h1 with a | a
      · rcases h1d w.2 h2 with b | b
        · rw [a, b]
        · rw [hv (w.1 - ((round w.1 : ℤ) : ℝ), w.2 - ((round w.2 : ℤ) : ℝ)) (Or.inr b.1),
            hv w (Or.inr b.2)]
      · rw [hv (w.1 - ((round w.1 : ℤ) : ℝ), w.2 - ((round w.2 : ℤ) : ℝ)) (Or.inl a.1),
          hv w (Or.inl a.2)]
    exact ⟨hcont, hper, hbox⟩
  obtain ⟨L1a, L1b⟩ := tL1
  obtain ⟨hΨc, hΨp, hΨb⟩ := tL4
  have hSm : MeasurableSet (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1) :=
    measurableSet_Icc.prod measurableSet_Icc
  have gcong : ∀ (G : ℝ × ℝ → ℝ) (a b c d : ℝ), a = c → b = d → G (a, b) = G (c, d) := by
    intro G a b c d h1 h2; rw [h1, h2]

  have shift : ∀ G : ℝ × ℝ → ℝ, (∀ w : ℝ × ℝ, G (w.1 + 1, w.2) = G w) →
      (∀ w : ℝ × ℝ, G (w.1, w.2 + 1) = G w) → ∀ (p q : ℕ) (a b : ℝ),
        G (a + p, b + q) = G (a, b) := by
    intro G h1 h2 p q
    induction p with
    | zero =>
      induction q with
      | zero => intro a b; simp
      | succ q ih =>
        intro a b
        rw [← ih a b, ← h2 (a + ((0:ℕ):ℝ), b + q)]
        exact gcong G _ _ _ _ rfl (by push_cast; ring)
    | succ p ih =>
      intro a b
      rw [← ih a b, ← h1 (a + p, b + q)]
      exact gcong G _ _ _ _ (by push_cast; ring) rfl

  have jmat : ∀ G : ℝ × ℝ → ℝ, Continuous G → (∀ w : ℝ × ℝ, G (w.1 + 1, w.2) = G w) →
      (∀ w : ℝ × ℝ, G (w.1, w.2 + 1) = G w) →
      ∫ Y in (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1), G (3 * Y.1 + Y.2, Y.1 + 5 * Y.2) =
        ∫ Y in (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1), G Y := by
    intro G hG h1 h2
    have s31 : ∀ a b : ℝ, G (a + 3, b + 1) = G (a, b) := by
      intro a b; have := shift G h1 h2 3 1 a b; push_cast at this; exact this
    have s10 : ∀ a b : ℝ, G (a + 1, b) = G (a, b) := fun a b => h1 (a, b)
    calc ∫ Y in (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1), G (3 * Y.1 + Y.2, Y.1 + 5 * Y.2)
        = ∫ Y in (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1),
            G (3 * (Y.1 + 5 * Y.2) - 14 * Y.2, Y.1 + 5 * Y.2) := by
          refine MeasureTheory.setIntegral_congr_fun hSm (fun Y _ => ?_)
          exact gcong G _ _ _ _ (by ring) (by ring)
      _ = ∫ Y in (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1),
            G (3 * (Y.2 + 5 * Y.1) - 14 * Y.1, Y.2 + 5 * Y.1) :=
          tL3 (fun Y => G (3 * (Y.2 + 5 * Y.1) - 14 * Y.1, Y.2 + 5 * Y.1))
      _ = ∫ Y in (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1), G (3 * Y.2 - 14 * Y.1, Y.2) := by
          refine tL2 (fun Y => G (3 * Y.2 - 14 * Y.1, Y.2)) 1 5 0 (by fun_prop) ?_ one_ne_zero _ ?_
          · intro w
            dsimp only
            rw [← s31 (3 * w.2 - 14 * w.1) w.2]
            exact gcong G _ _ _ _ (by ring) rfl
          · intro Y
            dsimp only
            exact gcong G _ _ _ _ (by push_cast; ring) (by push_cast; ring)
      _ = ∫ Y in (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1), G (3 * Y.1 - 14 * Y.2, Y.1) :=
          tL3 (fun Y => G (3 * Y.1 - 14 * Y.2, Y.1))
      _ = ∫ Y in (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1), G (Y.2, Y.1) := by
          refine tL2 (fun Y => G (Y.2, Y.1)) (-14) 3 0 (by fun_prop) ?_ (by norm_num) _ ?_
          · intro w
            dsimp only
            exact s10 w.2 w.1
          · intro Y
            dsimp only
            exact gcong G _ _ _ _ (by push_cast; ring) rfl
      _ = ∫ Y in (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1), G Y := tL3 G

  have trans : ∀ G : ℝ × ℝ → ℝ, Continuous G → (∀ w : ℝ × ℝ, G (w.1 + 1, w.2) = G w) →
      (∀ w : ℝ × ℝ, G (w.1, w.2 + 1) = G w) → ∀ a : ℝ × ℝ,
      ∫ Y in (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1), G (Y.1 + a.1, Y.2 + a.2) =
        ∫ Y in (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1), G Y := by
    intro G hG h1 h2 a
    calc ∫ Y in (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1), G (Y.1 + a.1, Y.2 + a.2)
        = ∫ Y in (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1), G (Y.1 + a.1, Y.2) := by
          refine tL2 (fun Y => G (Y.1 + a.1, Y.2)) 1 0 a.2 (by fun_prop) ?_ one_ne_zero _ ?_
          · intro w
            dsimp only
            exact h2 (w.1 + a.1, w.2)
          · intro Y
            dsimp only
            exact gcong G _ _ _ _ rfl (by push_cast; ring)
      _ = ∫ Y in (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1), G (Y.2 + a.1, Y.1) :=
          (tL3 (fun Y => G (Y.1 + a.1, Y.2))).symm
      _ = ∫ Y in (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1), G (Y.2, Y.1) := by
          refine tL2 (fun Y => G (Y.2, Y.1)) 1 0 a.1 (by fun_prop) ?_ one_ne_zero _ ?_
          · intro w
            dsimp only
            exact h1 (w.2, w.1)
          · intro Y
            dsimp only
            exact gcong G _ _ _ _ (by push_cast; ring) rfl
      _ = ∫ Y in (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1), G Y := tL3 G

  have iter : ∀ m : ℕ, ∀ G : ℝ × ℝ → ℝ, Continuous G → (∀ w : ℝ × ℝ, G (w.1 + 1, w.2) = G w) →
      (∀ w : ℝ × ℝ, G (w.1, w.2 + 1) = G w) →
      ∫ Y in (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1), G (Jpow (m : ℤ) Y) =
        ∫ Y in (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1), G Y := by
    intro m
    induction m with
    | zero =>
      intro G _ _ _
      have e : ∀ Y, Jpow ((0:ℕ):ℤ) Y = Y := fun Y => by rw [Nat.cast_zero]; exact L1a Y
      simp only [e]
    | succ m ih =>
      intro G hG h1 h2
      have e : ∀ Y, Jpow ((m + 1 : ℕ) : ℤ) Y =
          (3 * (Jpow m Y).1 + (Jpow m Y).2, (Jpow m Y).1 + 5 * (Jpow m Y).2) := fun Y => by
        rw [Nat.cast_succ]; exact L1b m Y
      simp only [e]
      have s31 : ∀ a b : ℝ, G (a + 3, b + 1) = G (a, b) := by
        intro a b; have := shift G h1 h2 3 1 a b; push_cast at this; exact this
      have s15 : ∀ a b : ℝ, G (a + 1, b + 5) = G (a, b) := by
        intro a b; have := shift G h1 h2 1 5 a b; push_cast at this; exact this
      have hG'c : Continuous (fun w : ℝ × ℝ => G (3 * w.1 + w.2, w.1 + 5 * w.2)) := by fun_prop
      have hG'1 : ∀ w : ℝ × ℝ,
          (fun w : ℝ × ℝ => G (3 * w.1 + w.2, w.1 + 5 * w.2)) (w.1 + 1, w.2) =
          (fun w : ℝ × ℝ => G (3 * w.1 + w.2, w.1 + 5 * w.2)) w := by
        intro w
        dsimp only
        rw [← s31 (3 * w.1 + w.2) (w.1 + 5 * w.2)]
        exact gcong G _ _ _ _ (by ring) (by ring)
      have hG'2 : ∀ w : ℝ × ℝ,
          (fun w : ℝ × ℝ => G (3 * w.1 + w.2, w.1 + 5 * w.2)) (w.1, w.2 + 1) =
          (fun w : ℝ × ℝ => G (3 * w.1 + w.2, w.1 + 5 * w.2)) w := by
        intro w
        dsimp only
        rw [← s15 (3 * w.1 + w.2) (w.1 + 5 * w.2)]
        exact gcong G _ _ _ _ (by ring) (by ring)
      exact (ih _ hG'c hG'1 hG'2).trans (jmat G hG h1 h2)

  have hJc : Continuous (Jpow (n : ℤ)) := by
    unfold Jpow
    fun_prop
  have hFc : Continuous (fun Y : ℝ × ℝ => Φ (frac0 (Jpow (n : ℤ) Y - c))) :=
    hΨc.comp (hJc.sub continuous_const)
  refine ⟨hFc.continuousOn.integrableOn_compact (isCompact_Icc.prod isCompact_Icc), ?_⟩
  have hGtc : Continuous (fun Y : ℝ × ℝ => Φ (frac0 (Y - c))) :=
    hΨc.comp (continuous_id.sub continuous_const)
  have hGt1 : ∀ w : ℝ × ℝ, Φ (frac0 ((w.1 + 1, w.2) - c)) = Φ (frac0 (w - c)) := by
    intro w
    have e : ((w.1 + 1, w.2) - c : ℝ × ℝ) = ((w - c).1 + 1, (w - c).2) := by
      refine Prod.ext ?_ ?_
      · simp only [Prod.fst_sub]; ring
      · simp only [Prod.snd_sub]
    rw [e]; exact (hΨp (w - c)).1
  have hGt2 : ∀ w : ℝ × ℝ, Φ (frac0 ((w.1, w.2 + 1) - c)) = Φ (frac0 (w - c)) := by
    intro w
    have e : ((w.1, w.2 + 1) - c : ℝ × ℝ) = ((w - c).1, (w - c).2 + 1) := by
      refine Prod.ext ?_ ?_
      · simp only [Prod.fst_sub]
      · simp only [Prod.snd_sub]; ring
    rw [e]; exact (hΨp (w - c)).2
  have step1 := iter n (fun Y => Φ (frac0 (Y - c))) hGtc hGt1 hGt2
  have step2 := trans (fun Y => Φ (frac0 (Y - c))) hGtc hGt1 hGt2 (c.1 - 1/2, c.2 - 1/2)
  have step3 : ∫ Y in (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1),
      Φ (frac0 ((Y.1 + (c.1 - 1/2), Y.2 + (c.2 - 1/2)) - c)) =
      ∫ Y in (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1), Φ (Y - ((1:ℝ)/2, (1:ℝ)/2)) := by
    refine MeasureTheory.setIntegral_congr_fun hSm (fun Y hY => ?_)
    have e : ((Y.1 + (c.1 - 1/2), Y.2 + (c.2 - 1/2)) - c : ℝ × ℝ) =
        Y - ((1:ℝ)/2, (1:ℝ)/2) := by
      refine Prod.ext ?_ ?_
      · simp only [Prod.fst_sub]; ring
      · simp only [Prod.snd_sub]; ring
    show Φ (frac0 ((Y.1 + (c.1 - 1/2), Y.2 + (c.2 - 1/2)) - c)) = Φ (Y - ((1:ℝ)/2, (1:ℝ)/2))
    rw [e]
    obtain ⟨⟨a1, a2⟩, ⟨b1, b2⟩⟩ := hY
    refine hΨb _ ?_ ?_
    · simp only [Prod.fst_sub]; rw [abs_le]; constructor <;> linarith
    · simp only [Prod.snd_sub]; rw [abs_le]; constructor <;> linarith
  have step4 : ∫ Y in (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1), Φ (Y - ((1:ℝ)/2, (1:ℝ)/2)) =
      ∫ Y : ℝ × ℝ, Φ (Y - ((1:ℝ)/2, (1:ℝ)/2)) := by
    refine MeasureTheory.setIntegral_eq_integral_of_forall_compl_eq_zero (fun Y hY => ?_)
    apply hv
    by_contra hc
    push_neg at hc
    obtain ⟨h1, h2⟩ := hc
    simp only [Prod.fst_sub, Prod.snd_sub] at h1 h2
    rw [abs_lt] at h1 h2
    exact hY ⟨⟨by linarith [h1.1], by linarith [h1.2]⟩, ⟨by linarith [h2.1], by linarith [h2.2]⟩⟩
  have step5 := MeasureTheory.integral_sub_right_eq_self (μ := MeasureTheory.volume)
    (fun w : ℝ × ℝ => Φ w) ((1:ℝ)/2, (1:ℝ)/2)
  calc ∫ Y in (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1), Φ (frac0 (Jpow (n : ℤ) Y - c))
      = ∫ Y in (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1), Φ (frac0 (Y - c)) := step1
    _ = ∫ Y in (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1),
          Φ (frac0 ((Y.1 + (c.1 - 1/2), Y.2 + (c.2 - 1/2)) - c)) := step2.symm
    _ = _ := step3
    _ = _ := step4
    _ = _ := step5

theorem lam_coords_integral : ∀ (f g : ℝ → ℝ) (R : ℝ), Continuous f → Continuous g →
    (∀ u : ℝ, R ≤ |u| → f u = 0 ∧ g u = 0) →
    ∫ w : ℝ × ℝ, f (lamR w) * g (lamT w) = (1 + bgc ^ 2) * ((∫ u : ℝ, f u) * ∫ s : ℝ, g s) :=
by
  intro f g R hf hg _
  have hk0 : 0 < 1 + bgc ^ 2 := by positivity
  have hkne : (1 + bgc ^ 2) ≠ 0 := hk0.ne'
  let L : ℝ × ℝ →ₗ[ℝ] ℝ × ℝ :=
    Matrix.toLin (Module.Basis.finTwoProd ℝ) (Module.Basis.finTwoProd ℝ)
      !![1 / (1 + bgc ^ 2), -bgc / (1 + bgc ^ 2); bgc / (1 + bgc ^ 2), 1 / (1 + bgc ^ 2)]
  have hL : ∀ w, L w = (lamR w, lamT w) := by
    intro w
    simp only [L, Matrix.toLin_finTwoProd_apply]
    unfold lamR lamT
    ext
    · simp only
      field_simp
      ring
    · simp only
      field_simp
  have hdet : LinearMap.det L = 1 / (1 + bgc ^ 2) := by
    simp only [L, LinearMap.det_toLin, Matrix.det_fin_two_of]
    field_simp
    ring
  have hdet0 : LinearMap.det L ≠ 0 := by rw [hdet]; positivity
  have hmap := MeasureTheory.Measure.map_linearMap_addHaar_eq_smul_addHaar
    (MeasureTheory.volume : MeasureTheory.Measure (ℝ × ℝ)) hdet0
  rw [hdet, one_div, inv_inv, abs_of_pos hk0] at hmap
  have hLc : Continuous L := LinearMap.continuous_of_finiteDimensional L
  have hFc : Continuous (fun z : ℝ × ℝ => f z.1 * g z.2) :=
    (hf.comp continuous_fst).mul (hg.comp continuous_snd)
  have h1 : ∫ w : ℝ × ℝ, f (lamR w) * g (lamT w) =
      ∫ w : ℝ × ℝ, (fun z : ℝ × ℝ => f z.1 * g z.2) (L w) := by
    congr 1
    funext w
    rw [hL w]
  rw [h1, ← MeasureTheory.integral_map hLc.aemeasurable hFc.aestronglyMeasurable, hmap,
    MeasureTheory.integral_smul_measure, ENNReal.toReal_ofReal hk0.le, smul_eq_mul]
  rw [MeasureTheory.Measure.volume_eq_prod, MeasureTheory.integral_prod_mul]

theorem rect_profile_facts5 : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G →
    ∀ (γ : Lab) (ξ : Cyl) (b : Fin 3), (b = 1 ∨ b = 2) → G.lmin ≤ γ.1 → ξ ∈ DomC B.h B.qB →
    0 ≤ bandIdx B.h γ.1 ∧
    Continuous (sc5ProfF G.r0) ∧ Continuous (sc5ProfG B G γ (ξ.1, ξ.2.1, ξ.2.2.1) b) ∧
    (∀ u : ℝ, 1 ≤ |u| → sc5ProfF G.r0 u = 0 ∧ sc5ProfG B G γ (ξ.1, ξ.2.1, ξ.2.2.1) b u = 0) ∧
    (∀ w : ℝ × ℝ, (1/4 ≤ |w.1| ∨ 1/4 ≤ |w.2|) →
      sc5ProfF G.r0 (lamR w) * sc5ProfG B G γ (ξ.1, ξ.2.1, ξ.2.2.1) b (lamT w) = 0) ∧
    (∀ Y : ℝ × ℝ, ¬ inRect B.h γ (G.ctr γ) (2 * G.r0) Y →
      sc5ProfF G.r0 (lamR (rectW B.h γ (G.ctr γ) Y)) *
        sc5ProfG B G γ (ξ.1, ξ.2.1, ξ.2.2.1) b (lamT (rectW B.h γ (G.ctr γ) Y)) = 0) ∧
    (1 + bgc ^ 2) * ((∫ u : ℝ, sc5ProfF G.r0 u) * ∫ u : ℝ, sc5ProfG B G γ (ξ.1, ξ.2.1, ξ.2.2.1) b u) =
      2 * (if b = 1 then (Hcol B G γ (ξ.1, ξ.2.1, ξ.2.2.1)).1 else (Hcol B G γ (ξ.1, ξ.2.1, ξ.2.2.1)).2) :=
by
  intro B G hB hG γ ξ b hb hl hξ
  obtain ⟨⟨hr0, hr0le, -, -, hlmin⟩, -, -, -, -, -, hGc⟩ := hG
  have hh : 0 < B.h := hB.2.1.1
  have hTgc1 : 1 < Tgc := by unfold Tgc; have := Real.sqrt_nonneg 2; linarith
  have hci : 0 < cib B.h γ.1 := by unfold cib Tgc Qb; positivity
  have hLs : 0 < Lsb B.h G.r0 γ.1 := by unfold Lsb; exact div_pos (by linarith) hci
  have hbgc0 : 0 < bgc := by unfold bgc; linarith [Real.one_lt_sqrt_two]
  have hbgc1 : bgc < 1 := by
    unfold bgc
    have h2 := Real.sq_sqrt (show (0:ℝ) ≤ 2 by norm_num)
    nlinarith [Real.sqrt_nonneg 2]

  have hchig : ∀ u : ℝ, G.r0 / 4 ≤ |u| → chig G.r0 u = 0 := by
    intro u hu
    unfold chig bumpR
    apply Real.smoothTransition.zero_of_nonpos
    have h1 : 1 ≤ |4 * u / G.r0| := by
      rw [abs_div, abs_mul, abs_of_pos (by norm_num : (0:ℝ) < 4), abs_of_pos hr0, le_div_iff₀ hr0]
      linarith
    have h2 : 1 ≤ (4 * u / G.r0) ^ 2 := by
      rw [← sq_abs]; nlinarith
    linarith
  have hpsi0 : ∀ L v : ℝ, 0 < L → L / 3 ≤ |v - L / 2| → psiT L v = 0 := by
    intro L v hL hv
    unfold psiT
    apply Real.smoothTransition.zero_of_nonpos
    apply div_nonpos_of_nonpos_of_nonneg <;> linarith
  have hpsiS : ∀ L v : ℝ, 0 < L → psiT L v ≠ 0 → 0 < v ∧ v ≤ L := by
    intro L v hL hne
    by_contra hc
    apply hne
    apply hpsi0 L v hL
    rcases not_and_or.mp hc with h | h
    · rw [abs_of_nonpos (by linarith)]; linarith
    · rw [abs_of_nonneg (by linarith)]; linarith
  have hpsiu : ∀ u : ℝ, 2 * G.r0 / 3 ≤ |u| →
      psiT (Lsb B.h G.r0 γ.1) ((u + G.r0) / cib B.h γ.1) = 0 := by
    intro u hu
    apply hpsi0 _ _ hLs
    have e : (u + G.r0) / cib B.h γ.1 - Lsb B.h G.r0 γ.1 / 2 = u / cib B.h γ.1 := by
      unfold Lsb; ring
    have e2 : Lsb B.h G.r0 γ.1 / 3 = (2 * G.r0 / 3) / cib B.h γ.1 := by
      unfold Lsb; ring
    rw [e, e2, abs_div, abs_of_pos hci]
    gcongr
  have hFz : ∀ u : ℝ, G.r0 / 4 ≤ |u| → sc5ProfF G.r0 u = 0 := by
    intro u hu; unfold sc5ProfF; rw [hchig u hu]; ring
  have hGz : ∀ u : ℝ, 2 * G.r0 / 3 ≤ |u| → sc5ProfG B G γ (ξ.1, ξ.2.1, ξ.2.2.1) b u = 0 := by
    intro u hu; unfold sc5ProfG; rw [hpsiu u hu]; ring

  have hT : Continuous (G.tH γ (ξ.1, ξ.2.1, ξ.2.2.1)) := by
    have hc := (hGc γ).continuousOn
    exact hc.comp_continuous
      (Continuous.prodMk continuous_const continuous_id :
        Continuous fun v : ℝ => (((ξ.1, ξ.2.1, ξ.2.2.1) : ℝ × ℝ × ℝ), v))
      (fun v => ⟨hξ.1, hξ.2.1, hξ.2.2⟩)
  have hTc : ∀ i : Fin 3, Continuous fun v => G.tH γ (ξ.1, ξ.2.1, ξ.2.2.1) v i :=
    fun i => (continuous_apply i).comp hT
  have hst := Real.smoothTransition.continuous
  have hpsic : ∀ L : ℝ, Continuous (psiT L) := by
    intro L; unfold psiT
    exact hst.comp ((continuous_const.sub ((continuous_id.sub continuous_const).abs)).div_const _)
  have hFc : Continuous (sc5ProfF G.r0) := by
    unfold sc5ProfF chig bumpR
    exact (hst.comp (continuous_const.sub
      (((continuous_const.mul continuous_id).div_const _).pow 2))).pow 2
  have haff : Continuous fun u : ℝ => (u + G.r0) / cib B.h γ.1 :=
    (continuous_id.add continuous_const).div_const _
  have hGc' : Continuous (sc5ProfG B G γ (ξ.1, ξ.2.1, ξ.2.2.1) b) := by
    unfold sc5ProfG
    exact (((hpsic _).comp haff).pow 2).mul (((hTc 0).comp haff).mul ((hTc b).comp haff))

  have hl4 : 4 ≤ γ.1 := by omega
  have hnat : ∀ n : ℕ, 4 ≤ n → n ^ 2 ≤ 2 ^ n := by
    intro n hn
    induction n, hn using Nat.le_induction with
    | base => norm_num
    | succ k hk ih =>
      rw [pow_succ 2 k]
      nlinarith [Nat.mul_le_mul hk hk]
  have C1 : 0 ≤ bandIdx B.h γ.1 := by
    unfold bandIdx
    apply Int.floor_nonneg.mpr
    apply Real.logb_nonneg hTgc1
    have hl0 : (0:ℝ) < (γ.1:ℝ) := by exact_mod_cast (show 0 < γ.1 by omega)
    rw [one_le_div (pow_pos hl0 2)]
    have h1 : ((γ.1:ℝ)) ^ 2 ≤ (2:ℝ) ^ γ.1 := by exact_mod_cast hnat γ.1 hl4
    have h2 : (2:ℝ) ^ γ.1 = (2:ℝ) ^ ((γ.1:ℕ):ℝ) := (Real.rpow_natCast 2 γ.1).symm
    have h3 : (2:ℝ) ^ ((γ.1:ℕ):ℝ) ≤ (2:ℝ) ^ ((1 + B.h) * (γ.1:ℝ)) :=
      Real.rpow_le_rpow_of_exponent_le (by norm_num) (by nlinarith [mul_nonneg hh.le hl0.le])
    linarith

  have C5 : ∀ w : ℝ × ℝ, (1/4 ≤ |w.1| ∨ 1/4 ≤ |w.2|) →
      sc5ProfF G.r0 (lamR w) * sc5ProfG B G γ (ξ.1, ξ.2.1, ξ.2.2.1) b (lamT w) = 0 := by
    intro w hw
    by_cases hA : G.r0 / 4 ≤ |lamR w|
    · rw [hFz _ hA, zero_mul]
    by_cases hB2 : 2 * G.r0 / 3 ≤ |lamT w|
    · rw [hGz _ hB2, mul_zero]
    exfalso
    push_neg at hA hB2
    have hd : (1 + bgc ^ 2) ≠ 0 := by positivity
    have e1 : w.1 = lamR w + bgc * lamT w := by unfold lamR lamT; field_simp; ring
    have e2 : w.2 = -bgc * lamR w + lamT w := by unfold lamR lamT; field_simp; ring
    have k1 : |w.1| < 1/4 := by
      rw [e1]
      have := abs_add_le (lamR w) (bgc * lamT w)
      rw [abs_mul, abs_of_pos hbgc0] at this
      nlinarith [mul_le_mul_of_nonneg_right hbgc1.le (abs_nonneg (lamT w))]
    have k2 : |w.2| < 1/4 := by
      rw [e2]
      have := abs_add_le (-bgc * lamR w) (lamT w)
      rw [abs_mul, abs_neg, abs_of_pos hbgc0] at this
      nlinarith [mul_le_mul_of_nonneg_right hbgc1.le (abs_nonneg (lamR w))]
    rcases hw with h | h <;> linarith

  have C6 : ∀ Y : ℝ × ℝ, ¬ inRect B.h γ (G.ctr γ) (2 * G.r0) Y →
      sc5ProfF G.r0 (lamR (rectW B.h γ (G.ctr γ) Y)) *
        sc5ProfG B G γ (ξ.1, ξ.2.1, ξ.2.2.1) b (lamT (rectW B.h γ (G.ctr γ) Y)) = 0 := by
    intro Y hY
    unfold inRect xiG etG at hY
    rcases not_and_or.mp hY with h | h
    · rw [hFz _ (by linarith [not_le.mp h]), zero_mul]
    · rw [hGz _ (by linarith [not_le.mp h]), mul_zero]

  have hIF : ∫ u, sc5ProfF G.r0 u = ∫ u in (-G.r0)..G.r0, chig G.r0 u ^ 2 := by
    symm
    apply intervalIntegral.integral_eq_integral_of_support_subset
    rw [Function.support_subset_iff']
    intro u hu
    have hu' : G.r0 / 4 ≤ |u| := by
      simp only [Set.mem_Ioc, not_and_or, not_lt, not_le] at hu
      rcases hu with h | h
      · rw [abs_of_nonpos (by linarith)]; linarith
      · rw [abs_of_nonneg (by linarith)]; linarith
    show chig G.r0 u ^ 2 = 0
    rw [hchig u hu']; ring
  have hKint : ∫ v, psiT (Lsb B.h G.r0 γ.1) v ^ 2 *
      (G.tH γ (ξ.1, ξ.2.1, ξ.2.2.1) v 0 * G.tH γ (ξ.1, ξ.2.1, ξ.2.2.1) v b) =
      ∫ v in (0:ℝ)..(Lsb B.h G.r0 γ.1), psiT (Lsb B.h G.r0 γ.1) v ^ 2 *
      (G.tH γ (ξ.1, ξ.2.1, ξ.2.2.1) v 0 * G.tH γ (ξ.1, ξ.2.1, ξ.2.2.1) v b) := by
    symm
    apply intervalIntegral.integral_eq_integral_of_support_subset
    rw [Function.support_subset_iff']
    intro v hv
    show psiT _ v ^ 2 * _ = 0
    by_contra hne
    apply hv
    apply hpsiS _ v hLs
    intro h0; apply hne; rw [h0]; ring
  have hsub : ∫ u, sc5ProfG B G γ (ξ.1, ξ.2.1, ξ.2.2.1) b u = cib B.h γ.1 *
      ∫ v, psiT (Lsb B.h G.r0 γ.1) v ^ 2 *
      (G.tH γ (ξ.1, ξ.2.1, ξ.2.2.1) v 0 * G.tH γ (ξ.1, ξ.2.1, ξ.2.2.1) v b) := by
    have gen : ∀ k : ℝ → ℝ, ∫ u, k ((u + G.r0) / cib B.h γ.1) = cib B.h γ.1 * ∫ v, k v := by
      intro k
      have e1 : ∫ u, k ((u + G.r0) / cib B.h γ.1) = ∫ u, k (u / cib B.h γ.1) :=
        MeasureTheory.integral_add_right_eq_self (fun x => k (x / cib B.h γ.1)) G.r0
      rw [e1, MeasureTheory.Measure.integral_comp_div k (cib B.h γ.1), abs_of_pos hci, smul_eq_mul]
    exact gen (fun v => psiT (Lsb B.h G.r0 γ.1) v ^ 2 *
      (G.tH γ (ξ.1, ξ.2.1, ξ.2.2.1) v 0 * G.tH γ (ξ.1, ξ.2.1, ξ.2.2.1) v b))
  have hpair : ∀ (p q r : ℝ → ℝ) (a c : ℝ), Continuous p → Continuous q → Continuous r →
      (∫ v in a..c, p v • (q v, r v)).1 = ∫ v in a..c, p v * q v ∧
      (∫ v in a..c, p v • (q v, r v)).2 = ∫ v in a..c, p v * r v := by
    intro p q r a c hp hq hr
    have hf : Continuous fun v => p v • (q v, r v) := hp.smul (hq.prodMk hr)
    have hI := hf.intervalIntegrable (μ := MeasureTheory.volume) a c
    constructor
    · have := (ContinuousLinearMap.fst ℝ ℝ ℝ).intervalIntegral_comp_comm hI
      first | exact this.symm | simpa using this.symm
    · have := (ContinuousLinearMap.snd ℝ ℝ ℝ).intervalIntegral_comp_comm hI
      first | exact this.symm | simpa using this.symm
  have hH := hpair (fun v => psiT (Lsb B.h G.r0 γ.1) v ^ 2 * G.tH γ (ξ.1, ξ.2.1, ξ.2.2.1) v 0)
    (fun v => G.tH γ (ξ.1, ξ.2.1, ξ.2.2.1) v 1) (fun v => G.tH γ (ξ.1, ξ.2.1, ξ.2.2.1) v 2)
    0 (Lsb B.h G.r0 γ.1) (((hpsic _).pow 2).mul (hTc 0)) (hTc 1) (hTc 2)
  have hH1 : (Hcol B G γ (ξ.1, ξ.2.1, ξ.2.2.1)).1 =
      ((1 + bgc ^ 2) / 2 * (∫ u in (-G.r0)..G.r0, chig G.r0 u ^ 2) * cib B.h γ.1) *
        ∫ v in (0:ℝ)..(Lsb B.h G.r0 γ.1), psiT (Lsb B.h G.r0 γ.1) v ^ 2 *
          G.tH γ (ξ.1, ξ.2.1, ξ.2.2.1) v 0 * G.tH γ (ξ.1, ξ.2.1, ξ.2.2.1) v 1 := by
    unfold Hcol
    rw [Prod.smul_fst, smul_eq_mul, hH.1]
  have hH2 : (Hcol B G γ (ξ.1, ξ.2.1, ξ.2.2.1)).2 =
