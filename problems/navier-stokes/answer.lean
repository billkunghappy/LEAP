    have hPgap : p1 - b / a * p2 - μ / 2 ≤ p1 + (ts q + s q * Dn q u) * p2 := by
      have e : (ts q + s q * Dn q u) * p2 = -(b / a) * p2 + s q * Dn q u * p2 := by
        rw [htsq]; ring
      have := mul_le_mul_of_nonneg_left hcD (show 0 ≤ μ / 2 by positivity)
      rw [e, hkey]; nlinarith
    have hv_eq : a * (1 + ts q ^ 2 + s q ^ 2) = vs q + a * s q ^ 2 := by
      rw [hvsq, htsq]; ring
    have hmarg := marg μ τ δL a b p1 p2 (ts q + s q * Dn q u) (a * (1 + ts q ^ 2 + s q ^ 2))
      (Fa (q, φ)) (Fb (q, φ)) hμ hδL hm1 hm2 hTτ hPgap
    by_cases hcase : 2 + δL / 4 ≤ vs q
    · have hs0' : s q = 0 := by rw [hsq, hζ0 q hcase, zero_mul]
      have hv' : a * (1 + ts q ^ 2 + s q ^ 2) = vs q := by rw [hv_eq, hs0']; ring
      have := hmarg (by rw [hv']; linarith)
